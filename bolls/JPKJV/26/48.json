[{"verse":1,"text":"イスラエルの部族,ぶぞくの名,なは次,つぎのとおりである。北,きたの果,はてからヘテロンの道,みちを経,へて、ハマテの入口,いりぐちに至,いたり、ハマテに相対,あいたいするダマスコの北,きたの境,さかいにあるハザル・エノンに及,および、東,ひがしの方,ほうから西,にしの方,ほうへのびる地方,ちほう、これがダンの分,ぶんである。","tok":[["イスラエル"],["の"],["部族","ぶぞく"],["の"],["名","な"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["北","きた"],["の"],["果て","はて"],["から"],["ヘテロン"],["の"],["道","みち"],["を"],["経て","へて"],["、"],["ハマテ"],["の"],["入口","いりぐち"],["に"],["至","いたり"],["、"],["ハマテ"],["に"],["相対","あ"],["いたい"],["する"],["ダマスコ"],["の"],["北","きた"],["の"],["境","さかい"],["に"],["ある"],["ハザル"],["・"],["エノン"],["に"],["及","および"],["、"],["東","ひがし"],["の"],["方","ほう"],["から"],["西","にし"],["の"],["方","ほう"],["へ"],["のびる"],["地方","ちほう"],["、"],["これ"],["が"],["ダン"],["の"],["分","ぶん"],["で"],["ある"],["。"]]},{"verse":2,"text":"ダンの領地,りょうちに沿,そって、東,ひがしの方,ほうから西,にしの方,ほうへのびる地方,ちほう、これがアセルの分,ぶんである。","tok":[["ダン"],["の"],["領地","りょうち"],["に"],["沿って","そって"],["、"],["東","ひがし"],["の"],["方","ほう"],["から"],["西","にし"],["の"],["方","ほう"],["へ"],["のびる"],["地方","ちほう"],["、"],["これ"],["が"],["アセル"],["の"],["分","ぶん"],["で"],["ある"],["。"]]},{"verse":3,"text":"アセルの領地,りょうちに沿,そって、東,ひがしの方,ほうから西,にしの方,ほうへのびる地方,ちほう、これがナフタリの分,ぶんである。","tok":[["アセル"],["の"],["領地","りょうち"],["に"],["沿って","そって"],["、"],["東","ひがし"],["の"],["方","ほう"],["から"],["西","にし"],["の"],["方","ほう"],["へ"],["のびる"],["地方","ちほう"],["、"],["これ"],["が"],["ナフタリ"],["の"],["分","ぶん"],["で"],["ある"],["。"]]},{"verse":4,"text":"ナフタリの領地,りょうちに沿,そって、東,ひがしの方,ほうから西,にしの方,ほうへのびる地方,ちほう、これがマナセの分,ぶんである。","tok":[["ナフタリ"],["の"],["領地","りょうち"],["に"],["沿って","そって"],["、"],["東","ひがし"],["の"],["方","ほう"],["から"],["西","にし"],["の"],["方","ほう"],["へ"],["のびる"],["地方","ちほう"],["、"],["これ"],["が"],["マナセ"],["の"],["分","ぶん"],["で"],["ある"],["。"]]},{"verse":5,"text":"マナセの領地,りょうちに沿,そって、東,ひがしの方,ほうから西,にしの方,ほうへのびる地方,ちほう、これがエフライムの分,ぶんである。","tok":[["マナセ"],["の"],["領地","りょうち"],["に"],["沿って","そって"],["、"],["東","ひがし"],["の"],["方","ほう"],["から"],["西","にし"],["の"],["方","ほう"],["へ"],["のびる"],["地方","ちほう"],["、"],["これ"],["が"],["エフライム"],["の"],["分","ぶん"],["で"],["ある"],["。"]]},{"verse":6,"text":"エフライムの領地,りょうちに沿,そって、東,ひがしの方,ほうから西,にしの方,ほうへのびる地方,ちほう、これがルベンの分,ぶんである。","tok":[["エフライム"],["の"],["領地","りょうち"],["に"],["沿って","そって"],["、"],["東","ひがし"],["の"],["方","ほう"],["から"],["西","にし"],["の"],["方","ほう"],["へ"],["のびる"],["地方","ちほう"],["、"],["これ"],["が"],["ルベン"],["の"],["分","ぶん"],["で"],["ある"],["。"]]},{"verse":7,"text":"ルベンの領地,りょうちに沿,そって、東,ひがしの方,ほうから西,にしの方,ほうへのびる地方,ちほう、これがユダの分,ぶんである。","tok":[["ルベン"],["の"],["領地","りょうち"],["に"],["沿って","そって"],["、"],["東","ひがし"],["の"],["方","ほう"],["から"],["西","にし"],["の"],["方","ほう"],["へ"],["のびる"],["地方","ちほう"],["、"],["これ"],["が"],["ユダ"],["の"],["分","ぶん"],["で"],["ある"],["。"]]},{"verse":8,"text":"ユダの領地,りょうちに沿,そって、東,ひがしの方,ほうから西,にしの方,ほうへのびる地方,ちほうは、あなたがたのささげる献納,けんのう地,ちとせよ。その幅,はばは二万五千キュビト、その東,ひがしの方,ほうから西,にしの方,ほうへのびる長,ながさは、部族,ぶぞくの一つの分,ぶんに同,おなじで、聖所,せいじょはその中,なかにある。","tok":[["ユダ"],["の"],["領地","りょうち"],["に"],["沿って","そって"],["、"],["東","ひがし"],["の"],["方","ほう"],["から"],["西","にし"],["の"],["方","ほう"],["へ"],["のびる"],["地方","ちほう"],["は"],["、"],["あなた"],["がた"],["の"],["ささげる"],["献納","けんのう"],["地","ち"],["と"],["せよ"],["。"],["その"],["幅","はば"],["は"],["二万五千","にまんごせん"],["キュビト"],["、"],["その"],["東","ひがし"],["の"],["方","ほう"],["から"],["西","にし"],["の"],["方","ほう"],["へ"],["のびる"],["長さ","ながさ"],["は"],["、"],["部族","ぶぞく"],["の"],["一","ひと"],["つ"],["の"],["分","ぶん"],["に"],["同じ","おなじ"],["で"],["、"],["聖","せい"],["所","しょ"],["は"],["その"],["中","なか"],["に"],["ある"],["。"]]},{"verse":9,"text":"すなわちあなたがたの主,しゅにささげる献納,けんのう地,ちは長,ながさ二万五千キュビト、幅,はば二万キュビトとである。","tok":[["すなわち"],["あなた"],["がた"],["の"],["主","しゅ"],["に"],["ささげる"],["献納","けんのう"],["地","ち"],["は"],["長さ","ながさ"],["二万五千","にまんごせん"],["キュビト"],["、"],["幅","はば"],["二万","にまん"],["キュビト"],["と"],["で"],["ある"],["。"]]},{"verse":10,"text":"これが祭司,さいしへの聖,せいなる献納,けんのう地,ちである。すなわち祭司,さいしの分,ぶんは、北,きたは二万五千キュビト、西,にしは幅,はば一万キュビト、東,ひがしは幅,はば一万キュビト、南,みなみは長,ながさ二万五千キュビトである。主,しゅの聖所,せいじょはその中,なかにある。","tok":[["これ"],["が"],["祭司","さいし"],["へ"],["の"],["聖","せい"],["なる"],["献納","けんのう"],["地","ち"],["で"],["ある"],["。"],["すなわち"],["祭司","さいし"],["の"],["分","ぶん"],["は"],["、"],["北","きた"],["は"],["二万五千","にまんごせん"],["キュビト"],["、"],["西","にし"],["は"],["幅","はば"],["一万","いちまん"],["キュビト"],["、"],["東","ひがし"],["は"],["幅","はば"],["一万","いちまん"],["キュビト"],["、"],["南","みなみ"],["は"],["長さ","ながさ"],["二万五千","にまんごせん"],["キュビト"],["で"],["ある"],["。"],["主","しゅ"],["の"],["聖","せい"],["所","しょ"],["は"],["その"],["中","なか"],["に"],["ある"],["。"]]},{"verse":11,"text":"これはイスラエルの人々,ひとびとが迷,まよい出,でた時,とき、レビびとが迷,まよったように迷,まよったことはなく、わが務,つとめを守,まもり通,とおしたザドクの子孫,しそんのうちから、聖別,せいべつされた祭司,さいしに属,ぞくする。","tok":[["これ"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["が"],["迷い出た","まよいでた"],["時","とき"],["、"],["レビ"],["びと"],["が"],["迷った","まよった"],["よう"],["に"],["迷った","まよった"],["こと"],["は"],["なく"],["、"],["わが"],["務め","つとめ"],["を"],["守り","まもり"],["通した","とおした"],["ザドク"],["の"],["子孫","しそん"],["の"],["うち"],["から"],["、"],["聖別","せいべつ"],["された"],["祭司","さいし"],["に"],["属する","ぞくする"],["。"]]},{"verse":12,"text":"このようにレビびとの境,さかいに沿,そって、いと聖,せいなる地,ち、すなわち聖,せいなる献納,けんのう地,ちが、特別,とくべつな分,ぶんとして彼,かれらに帰,き属,ぞくする。","tok":[["この"],["よう"],["に"],["レビ"],["びと"],["の"],["境","さかい"],["に"],["沿って","そって"],["、"],["いと"],["聖","せい"],["なる"],["地","ち"],["、"],["すなわち"],["聖","せい"],["なる"],["献納","けんのう"],["地","ち"],["が"],["、"],["特別","とくべつ"],["な"],["分","ぶん"],["として"],["彼","かれ"],["ら"],["に"],["帰属","きぞく"],["する"],["。"]]},{"verse":13,"text":"レビびとの分,ぶんは祭司,さいしの所有,しょゆう地,ちの境,さかいに沿,そって、長,ながさ二万五千キュビト、幅,はば一万キュビト、すなわち、そのすべての長,ながさ二万五千キュビト、幅,はば二万キュビトである。","tok":[["レビ"],["びと"],["の"],["分","ぶん"],["は"],["祭司","さいし"],["の"],["所有地","しょゆうち"],["の"],["境","さかい"],["に"],["沿って","そって"],["、"],["長さ","ながさ"],["二万五千","にまんごせん"],["キュビト"],["、"],["幅","はば"],["一万","いちまん"],["キュビト"],["、"],["すなわち"],["、"],["その"],["すべて"],["の"],["長さ","ながさ"],["二万五千","にまんごせん"],["キュビト"],["、"],["幅","はば"],["二万","にまん"],["キュビト"],["で"],["ある"],["。"]]},{"verse":14,"text":"彼,かれらはこれを売,うってはならない、また交換,こうかんしてはならない、またその大事,だいじな分,ぶんを手,てばなしてはならない。これは主,しゅに属,ぞくする聖,せいなる物,ものだからである。","tok":[["彼","かれ"],["ら"],["は"],["これ"],["を"],["売って","うって"],["は"],["ならない"],["、"],["また"],["交換","こうかん"],["して"],["は"],["ならない"],["、"],["また"],["その"],["大事","だいじ"],["な"],["分","ぶん"],["を"],["手ばなして","てばなして"],["は"],["ならない"],["。"],["これ"],["は"],["主","しゅ"],["に"],["属する","ぞくする"],["聖","せい"],["なる"],["物","もの"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":15,"text":"その残,のこりの地,ちすなわち幅,はば五千キュビト、長,ながさ二万五千キュビトは町,まちのため、すみかのため、また郊外,こうがいのための一般人,いっぱんじんの地所,じしょとせよ。町,まちはその中,なかに置,おけ。","tok":[["その"],["残り","のこり"],["の"],["地","ち"],["すなわち"],["幅","はば"],["五千","ごせん"],["キュビト"],["、"],["長さ","ながさ"],["二万五千","にまんごせん"],["キュビト"],["は"],["町","まち"],["の"],["ため"],["、"],["すみか"],["の"],["ため"],["、"],["また"],["郊外","こうがい"],["の"],["ため"],["の"],["一般人","いっぱんじん"],["の"],["地所","じしょ"],["と"],["せよ"],["。"],["町","まち"],["は"],["その"],["中","なか"],["に"],["置","おけ"],["。"]]},{"verse":16,"text":"一般人,いっぱんじんの地所,じしょの広,ひろさは次,つぎのとおりである。すなわち北,きたの方,ほう四千五百キュビト、南,みなみの方,ほう四千五百キュビト、東,ひがしの方,ほう四千五百キュビト、西,にしの方,ほう四千五百キュビトである。","tok":[["一般人","いっぱんじん"],["の"],["地所","じしょ"],["の"],["広さ","ひろさ"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["すなわち"],["北","きた"],["の"],["方","ほう"],["四千五百","よんせんごひゃく"],["キュビト"],["、"],["南","みなみ"],["の"],["方","ほう"],["四千五百","よんせんごひゃく"],["キュビト"],["、"],["東","ひがし"],["の"],["方","ほう"],["四千五百","よんせんごひゃく"],["キュビト"],["、"],["西","にし"],["の"],["方","ほう"],["四千五百","よんせんごひゃく"],["キュビト"],["で"],["ある"],["。"]]},{"verse":17,"text":"町,まちは郊外,こうがいを含,ふくむ。郊外,こうがいは北,きた二百五十キュビト、南,みなみ二百五十キュビト、東,ひがし二百五十キュビト、西,にし二百五十キュビトである。","tok":[["町","まち"],["は"],["郊外","こうがい"],["を"],["含","ふくむ"],["。"],["郊外","こうがい"],["は"],["北","きた"],["二百五十","にひゃくごじゅう"],["キュビト"],["、"],["南","みなみ"],["二百五十","にひゃくごじゅう"],["キュビト"],["、"],["東","ひがし"],["二百五十","にひゃくごじゅう"],["キュビト"],["、"],["西","にし"],["二百五十","にひゃくごじゅう"],["キュビト"],["で"],["ある"],["。"]]},{"verse":18,"text":"聖,せいなる献納,けんのう地,ちに沿,そっている残,のこりの地,ちの長,ながさは東,ひがしへ一万キュビト、西,にしへ一万キュビトである。これは聖,せいなる献納,けんのう地,ちに沿,そっており、その産物,さんぶつは町,まちの働,はたらき人,ひとの食物,しょくもつとなる。","tok":[["聖","せい"],["なる"],["献納","けんのう"],["地","ち"],["に"],["沿って","そって"],["いる"],["残り","のこり"],["の"],["地","ち"],["の"],["長さ","ながさ"],["は"],["東","ひがし"],["へ"],["一万","いちまん"],["キュビト"],["、"],["西","にし"],["へ"],["一万","いちまん"],["キュビト"],["で"],["ある"],["。"],["これ"],["は"],["聖","せい"],["なる"],["献納","けんのう"],["地","ち"],["に"],["沿って","そって"],["おり"],["、"],["その"],["産物","さんぶつ"],["は"],["町","まち"],["の"],["働らき人","はたらきひと"],["の"],["食物","しょくもつ"],["と"],["なる"],["。"]]},{"verse":19,"text":"町,まちの働,はたらき人,ひとは、イスラエルのすべての部族,ぶぞくから出,でて、これを耕作,こうさくするのである。","tok":[["町","まち"],["の"],["働らき人","はたらきひと"],["は"],["、"],["イスラエル"],["の"],["すべて"],["の"],["部族","ぶぞく"],["から"],["出て","でて"],["、"],["これ"],["を"],["耕作","こうさく"],["する"],["ので"],["ある"],["。"]]},{"verse":20,"text":"あなたがたがささげる献納,けんのう地,ちの全体,ぜんたいは二万五千キュビト四方,しほうである。これは町,まちの所有,しょゆう地,ちと共,ともに聖,せいなる献納,けんのう地,ちである。","tok":[["あなた"],["がた"],["が"],["ささげる"],["献納","けんのう"],["地","ち"],["の"],["全体","ぜんたい"],["は"],["二万五千","にまんごせん"],["キュビト"],["四方","しほう"],["で"],["ある"],["。"],["これ"],["は"],["町","まち"],["の"],["所有地","しょゆうち"],["と"],["共","とも"],["に"],["聖","せい"],["なる"],["献納","けんのう"],["地","ち"],["で"],["ある"],["。"]]},{"verse":21,"text":"聖,せいなる献納,けんのう地,ちと町,まちの所有,しょゆう地,ちとの、こなたかなたの残,のこりの地,ちは、君,きみたる者,ものに属,ぞくする。これは聖,せいなる献納,けんのう地,ちの二万五千キュビトに面,めんして東,ひがしの境,さかいに至,いたり、西,にしはその二万五千キュビトに面,めんして西,にしの境,さかいに至,いたり、部族,ぶぞくの分,ぶんに沿,そうもので、君,きみたる者,ものに属,ぞくする。聖,せいなる献納,けんのう地,ちと、宮,みやの聖所,せいじょとは、その中,なかにある。","tok":[["聖","せい"],["なる"],["献納","けんのう"],["地","ち"],["と"],["町","まち"],["の"],["所有地","しょゆうち"],["と"],["の"],["、"],["こなた"],["かなた"],["の"],["残り","のこり"],["の"],["地","ち"],["は"],["、"],["君","きみ"],["たる"],["者","もの"],["に"],["属する","ぞくする"],["。"],["これ"],["は"],["聖","せい"],["なる"],["献納","けんのう"],["地","ち"],["の"],["二万五千","にまんごせん"],["キュビト"],["に"],["面して","めんして"],["東","ひがし"],["の"],["境","さかい"],["に"],["至","いたり"],["、"],["西","にし"],["は"],["その"],["二万五千","にまんごせん"],["キュビト"],["に"],["面して","めんして"],["西","にし"],["の"],["境","さかい"],["に"],["至","いたり"],["、"],["部族","ぶぞく"],["の"],["分","ぶん"],["に"],["沿う","そう"],["もの"],["で"],["、"],["君","きみ"],["たる"],["者","もの"],["に"],["属する","ぞくする"],["。"],["聖","せい"],["なる"],["献納","けんのう"],["地","ち"],["と"],["、"],["宮","みや"],["の"],["聖","せい"],["所","しょ"],["は"],["、"],["その"],["中","なか"],["に"],["ある"],["。"]]},{"verse":22,"text":"町,まちの所有,しょゆう地,ちは、君,きみたる者,ものに属,ぞくする部分,ぶぶんの中,なかにあり、そして君,きみたる者,ものの分,ぶんは、ユダの領地,りょうちと、ベニヤミンの領地,りょうちとの間,あいだにある。","tok":[["町","まち"],["の"],["所有地","しょゆうち"],["は"],["、"],["君","きみ"],["たる"],["者","もの"],["に"],["属する","ぞくする"],["部分","ぶぶん"],["の"],["中","なか"],["に"],["あり"],["、"],["そして"],["君","きみ"],["たる"],["者","もの"],["の"],["分","ぶん"],["は"],["、"],["ユダ"],["の"],["領地","りょうち"],["と"],["、"],["ベニヤミン"],["の"],["領地","りょうち"],["と"],["の"],["間","あいだ"],["に"],["ある"],["。"]]},{"verse":23,"text":"なお残,のこりの部族,ぶぞくでは東,ひがしの方,ほうから西,にしの方,ほうに至,いたる地方,ちほう、これがベニヤミンの分,ぶんである。","tok":[["なお"],["残り","のこり"],["の"],["部族","ぶぞく"],["で"],["は"],["東","ひがし"],["の"],["方","ほう"],["から"],["西","にし"],["の"],["方","ほう"],["に"],["至る","いたる"],["地方","ちほう"],["、"],["これ"],["が"],["ベニヤミン"],["の"],["分","ぶん"],["で"],["ある"],["。"]]},{"verse":24,"text":"ベニヤミンの領地,りょうちに沿,そって、東,ひがしの方,ほうから西,にしの方,ほうに至,いたる地方,ちほう、これがシメオンの分,ぶんである。","tok":[["ベニヤミン"],["の"],["領地","りょうち"],["に"],["沿って","そって"],["、"],["東","ひがし"],["の"],["方","ほう"],["から"],["西","にし"],["の"],["方","ほう"],["に"],["至る","いたる"],["地方","ちほう"],["、"],["これ"],["が"],["シメオン"],["の"],["分","ぶん"],["で"],["ある"],["。"]]},{"verse":25,"text":"シメオンの領地,りょうちに沿,そって、東,ひがしの方,ほうから西,にしの方,ほうに至,いたる地方,ちほう、これがイッサカルの分,ぶんである。","tok":[["シメオン"],["の"],["領地","りょうち"],["に"],["沿って","そって"],["、"],["東","ひがし"],["の"],["方","ほう"],["から"],["西","にし"],["の"],["方","ほう"],["に"],["至る","いたる"],["地方","ちほう"],["、"],["これ"],["が"],["イッサカル"],["の"],["分","ぶん"],["で"],["ある"],["。"]]},{"verse":26,"text":"イッサカルの領地,りょうちに沿,そって、東,ひがしの方,ほうから西,にしの方,ほうに至,いたる地方,ちほう、これがゼブルンの分,ぶんである。","tok":[["イッサカル"],["の"],["領地","りょうち"],["に"],["沿って","そって"],["、"],["東","ひがし"],["の"],["方","ほう"],["から"],["西","にし"],["の"],["方","ほう"],["に"],["至る","いたる"],["地方","ちほう"],["、"],["これ"],["が"],["ゼブルン"],["の"],["分","ぶん"],["で"],["ある"],["。"]]},{"verse":27,"text":"ゼブルンの領地,りょうちに沿,そって、東,ひがしの方,ほうから西,にしの方,ほうに至,いたる地方,ちほう、これがガドの分,ぶんである。","tok":[["ゼブルン"],["の"],["領地","りょうち"],["に"],["沿って","そって"],["、"],["東","ひがし"],["の"],["方","ほう"],["から"],["西","にし"],["の"],["方","ほう"],["に"],["至る","いたる"],["地方","ちほう"],["、"],["これ"],["が"],["ガド"],["の"],["分","ぶん"],["で"],["ある"],["。"]]},{"verse":28,"text":"南,みなみの方,ほうはガドの領地,りょうちに沿,そって、タマルからメリボテ・カデシの水,みずに至,いたり、そこからエジプトの川,かわに沿,そって大海,たいかいに至,いたる。","tok":[["南","みなみ"],["の"],["方","ほう"],["は"],["ガド"],["の"],["領地","りょうち"],["に"],["沿って","そって"],["、"],["タマル"],["から"],["メリボテ"],["・"],["カデシ"],["の"],["水","みず"],["に"],["至","いたり"],["、"],["そこ"],["から"],["エジプト"],["の"],["川","かわ"],["に"],["沿って","そって"],["大海","たいかい"],["に"],["至る","いたる"],["。"]]},{"verse":29,"text":"これはあなたがたが、くじをもってイスラエルの部族,ぶぞくのうちに分,わけて、嗣,し業,ぎょうとすべき地,ちである。これが彼,かれらの分,ぶんであると、主,しゅなる神,かみは言,いわれる。","tok":[["これ"],["は"],["あなた"],["が"],["た"],["が"],["、"],["くじ"],["を"],["もって"],["イスラエル"],["の"],["部族","ぶぞく"],["の"],["うち"],["に"],["分けて","わけて"],["、"],["嗣業","しぎょう"],["と"],["すべき"],["地","ち"],["で"],["ある"],["。"],["これ"],["が"],["彼","かれ"],["ら"],["の"],["分","ぶん"],["で"],["ある"],["と"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"]]},{"verse":30,"text":"町,まちの出口,でぐちは次,つぎのとおりである。北,きたの方,ほうの長,ながさは四千五百キュビトである。","tok":[["町","まち"],["の"],["出口","でぐち"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["北","きた"],["の"],["方","ほう"],["の"],["長さ","ながさ"],["は"],["四千五百","よんせんごひゃく"],["キュビト"],["で"],["ある"],["。"]]},{"verse":31,"text":"町,まちの門,もんはイスラエルの部族,ぶぞくの名,なにしたがい、三つの門,もんになっている。すなわちルベンの門,もん、ユダの門,もん、レビの門,もんである。","tok":[["町","まち"],["の"],["門","もん"],["は"],["イスラエル"],["の"],["部族","ぶぞく"],["の"],["名","な"],["に"],["したがい"],["、"],["三","みっ"],["つ"],["の"],["門","もん"],["に"],["なって"],["いる"],["。"],["すなわち"],["ルベン"],["の"],["門","もん"],["、"],["ユダ"],["の"],["門","もん"],["、"],["レビ"],["の"],["門","もん"],["で"],["ある"],["。"]]},{"verse":32,"text":"東,ひがしの方,ほうは四千五百キュビトであって、三つの門,もんがある。すなわちヨセフの門,もん、ベニヤミンの門,もん、ダンの門,もんである。","tok":[["東","ひがし"],["の"],["方","ほう"],["は"],["四千五百","よんせんごひゃく"],["キュビト"],["で"],["あって"],["、"],["三","みっ"],["つ"],["の"],["門","もん"],["が"],["ある"],["。"],["すなわち"],["ヨセフ"],["の"],["門","もん"],["、"],["ベニヤミン"],["の"],["門","もん"],["、"],["ダン"],["の"],["門","もん"],["で"],["ある"],["。"]]},{"verse":33,"text":"南,みなみの方,ほうは四千五百キュビトであって、三つの門,もんがある。すなわちシメオンの門,もん、イッサカルの門,もん、ゼブルンの門,もんである。","tok":[["南","みなみ"],["の"],["方","ほう"],["は"],["四千五百","よんせんごひゃく"],["キュビト"],["で"],["あって"],["、"],["三","みっ"],["つ"],["の"],["門","もん"],["が"],["ある"],["。"],["すなわち"],["シメオン"],["の"],["門","もん"],["、"],["イッサカル"],["の"],["門","もん"],["、"],["ゼブルン"],["の"],["門","もん"],["で"],["ある"],["。"]]},{"verse":34,"text":"西,にしの方,ほうは四千五百キュビトであって、三つの門,もんがある。すなわちガドの門,もん、アセルの門,もん、ナフタリの門,もんである。","tok":[["西","にし"],["の"],["方","ほう"],["は"],["四千五百","よんせんごひゃく"],["キュビト"],["で"],["あって"],["、"],["三","みっ"],["つ"],["の"],["門","もん"],["が"],["ある"],["。"],["すなわち"],["ガド"],["の"],["門","もん"],["、"],["アセル"],["の"],["門","もん"],["、"],["ナフタリ"],["の"],["門","もん"],["で"],["ある"],["。"]]},{"verse":35,"text":"町,まちの周囲,しゅういは一万八千キュビトあり、この日,ひから後,のち、この町,まちの名,なは『主,しゅそこにいます』と呼,よばれる」。","tok":[["町","まち"],["の"],["周囲","しゅうい"],["は"],["一万八千","いちまんはちせん"],["キュビト"],["あり"],["、"],["この"],["日","ひ"],["から"],["後","の"],["ち"],["、"],["この"],["町","まち"],["の"],["名","な"],["は"],["『"],["主に","しゅそこに"],["います"],["』"],["と"],["呼ばれる","よばれる"],["」"],["。"]]}]
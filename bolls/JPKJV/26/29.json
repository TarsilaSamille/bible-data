[{"verse":1,"text":"第,だい十年,ねんの十月,がつ十二日,にちに、主,しゅの言葉,ことばがわたしに臨,のぞんだ、","tok":[["第","だい"],["十","じゅう"],["年","ねん"],["の"],["十","じゅう"],["月","がつ"],["つ"],["十二","じゅうに"],["日","にち"],["に"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":2,"text":"「人,ひとの子,こよ、あなたの顔,かおをエジプトの王,おうパロに向,むけ、彼,かれとエジプト全国,ぜんこくに対,たいして預言,よげんし、","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["あなた"],["の"],["顔","かお"],["を"],["エジプト"],["の"],["王","おう"],["パロ"],["に"],["向け","むけ"],["、"],["彼","かれ"],["と"],["エジプト"],["全国","ぜんこく"],["に対して","にたいして"],["預言","よげん"],["し"],["、"]]},{"verse":3,"text":"語,かたって言,いえ。主,しゅなる神,かみはこう言,いわれる、エジプトの王,おうパロよ、見,みよ、わたしはあなたの敵,てきとなる。あなたはその川,かわの中,なかに伏,ふす大,おおいなる龍,りゅうで、『ナイル川,がわはわたしのもの、わたしがこれを造,つくった』と言,いう。","tok":[["語","かた"],["って"],["言え","いえ"],["。"],["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["エジプト"],["の"],["王","おう"],["パロ"],["よ"],["、"],["見よ","みよ"],["、"],["わたし"],["は"],["あなた"],["の"],["敵","てき"],["と"],["なる"],["。"],["あなた"],["は"],["その"],["川","かわ"],["の"],["中","なか"],["に"],["伏す","ふす"],["大いなる","おおいなる"],["龍","りゅう"],["で"],["、"],["『"],["ナイル"],["川","がわ"],["は"],["わたし"],["の"],["もの"],["、"],["わたし"],["が"],["これ"],["を"],["造った","つくった"],["』"],["と"],["言う","いう"],["。"]]},{"verse":4,"text":"わたしは、かぎをあなたのあごにかけ、あなたの川,かわの魚,うおを、あなたのうろこにつかせ、あなたと、あなたのうろこについているもろもろの魚,うおを、あなたの川,かわから引,ひきあげ、","tok":[["わたし"],["は"],["、"],["かぎ"],["を"],["あなた"],["の"],["あご"],["に"],["かけ"],["、"],["あなた"],["の"],["川","かわ"],["の"],["魚","うお"],["を"],["、"],["あなた"],["の"],["うろこ"],["に"],["つかせ"],["、"],["あなた"],["と"],["、"],["あなた"],["の"],["うろこ"],["について"],["いる"],["もろもろ"],["の"],["魚","うお"],["を"],["、"],["あなた"],["の"],["川","かわ"],["から"],["引","ひき"],["あげ"],["、"]]},{"verse":5,"text":"あなたとあなたの川,かわのもろもろの魚,うおを、荒野,あらのに投,なげ捨,すてる。あなたは野,のの面,めんに倒,たおれ、あなたを取,とり集,あつめる者,ものも、葬,ほうむる者,ものもない。わたしはあなたを地,ちの獣,けものと空,そらの鳥,とりのえじきとして与,あたえる。","tok":[["あなた"],["と"],["あなた"],["の"],["川","かわ"],["の"],["もろもろ"],["の"],["魚","うお"],["を"],["、"],["荒野","あら"],["のに"],["投捨てる","なげすてる"],["。"],["あなた"],["は"],["野","の"],["の"],["面","めん"],["に"],["倒れ","たおれ"],["、"],["あなた"],["を"],["取集める","とりあつめる"],["者","もの"],["も"],["、"],["葬むる","ほうむる"],["者","もの"],["も"],["ない"],["。"],["わたし"],["は"],["あなた"],["を"],["地","ち"],["の"],["獣","けもの"],["と"],["空","そら"],["の"],["鳥","とり"],["の"],["えじき"],["として"],["与える","あたえる"],["。"]]},{"verse":6,"text":"そしてエジプトのすべての住民,じゅうみんはわたしが主,しゅであることを知,しる。あなたはイスラエルの家,いえに対,たいして葦,あしのつえであった。","tok":[["そして"],["エジプト"],["の"],["すべて"],["の"],["住民","じゅうみん"],["は"],["わたし"],["が"],["主","しゅ"],["で"],["ある"],["こと"],["を"],["知る","しる"],["。"],["あなた"],["は"],["イスラエル"],["の"],["家","いえ"],["に対して","にたいして"],["葦","あし"],["の"],["つえ"],["で"],["あった"],["。"]]},{"verse":7,"text":"彼,かれらがあなたを手,てにとる時,とき、あなたは折,おれ、彼,かれらの肩,かたはことごとく裂,さける。彼,かれらがまたあなたに寄,よりかかる時,とき、あなたは破,やぶれ、彼,かれらの腰,こしをことごとく震,ふるえさせる。","tok":[["彼","かれ"],["ら"],["が"],["あなた"],["を"],["手","て"],["に"],["とる"],["時","とき"],["、"],["あなた"],["は"],["折れ","おれ"],["、"],["彼","かれ"],["ら"],["の"],["肩","かた"],["は"],["ことごとく"],["裂ける","さける"],["。"],["彼","かれ"],["ら"],["が"],["また"],["あなた"],["に"],["寄りかかる","よりかかる"],["時","とき"],["、"],["あなた"],["は"],["破れ","やぶれ"],["、"],["彼","かれ"],["ら"],["の"],["腰","こし"],["を"],["ことごとく"],["震えさせる","ふるえさせる"],["。"]]},{"verse":8,"text":"それゆえ、主,しゅなる神,かみはこう言,いわれる、見,みよ、わたしはつるぎをあなたに持,もってきて、人,ひとと獣,けものとをあなたのうちから断,たつ。","tok":[["それ"],["ゆえ"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["見よ","みよ"],["、"],["わたし"],["は"],["つるぎ"],["を"],["あなた"],["に"],["持って","もって"],["きて"],["、"],["人","ひと"],["と"],["獣","けもの"],["と"],["を"],["あなた"],["の"],["うち"],["から"],["断つ","たつ"],["。"]]},{"verse":9,"text":"エジプトの地,ちは荒,あれて、むなしくなる。そして彼,かれはわたしが主,しゅであることを知,しる。あなたは『ナイル川,がわはわたしのもの、わたしがこれを造,つくった』と言,いっているゆえに、","tok":[["エジプト"],["の"],["地","ち"],["は"],["荒て","あれて"],["、"],["むなしく"],["なる"],["。"],["そして"],["彼","かれ"],["は"],["わたし"],["が"],["主","しゅ"],["で"],["ある"],["こと"],["を"],["知る","しる"],["。"],["あなた"],["は"],["『"],["ナイル"],["川","がわ"],["は"],["わたし"],["の"],["もの"],["、"],["わたし"],["が"],["これ"],["を"],["造った","つくった"],["』"],["と"],["言って","いって"],["いる"],["ゆえ"],["に"],["、"]]},{"verse":10,"text":"見,みよ、わたしはあなたとあなたの川,かわ々の敵,てきとなって、エジプトの地,ちをミグドルからスエネまで、エチオピヤの境,さかいに至,いたるまで、ことごとく荒,あらし、むなしくする。","tok":[["見よ","みよ"],["、"],["わたし"],["は"],["あなた"],["と"],["あなた"],["の"],["川","かわ"],["々"],["の"],["敵","てき"],["と"],["なって"],["、"],["エジプト"],["の"],["地","ち"],["を"],["ミグドル"],["から"],["スエネ"],["まで"],["、"],["エチオピヤ"],["の"],["境","さかい"],["に"],["至る","いたる"],["まで"],["、"],["ことごとく"],["荒し","あらし"],["、"],["むなしく"],["する"],["。"]]},{"verse":11,"text":"人,ひとの足,あしはこれを渡,わたらず、獣,けものの足,あしもこれを渡,わたらない。四十年,ねんの間,あいだ、ここに住,すむ者,ものはない。","tok":[["人","ひと"],["の"],["足","あし"],["は"],["これ"],["を"],["渡らず","わたらず"],["、"],["獣","けもの"],["の"],["足","あし"],["も"],["これ"],["を"],["渡らない","わたらない"],["。"],["四十","よんじゅう"],["年","ねん"],["の"],["間","あいだ"],["、"],["ここ"],["に"],["住む","すむ"],["者","もの"],["は"],["ない"],["。"]]},{"verse":12,"text":"わたしはエジプトの地,ちを荒,あらして、荒,あれた国々,くにぐにの中,なかに置,おき、その町々,まちまちは荒,あれて、四十年,ねんのあいだ荒,あれた町々,まちまちの中,なかにある。わたしはエジプトびとを、もろもろの国民,こくみんの中,なかに散,ちらし、もろもろの国,くにの中,なかに散,ちらす。","tok":[["わたし"],["は"],["エジプト"],["の"],["地","ち"],["を"],["荒して","あらして"],["、"],["荒た","あれた"],["国々","くにぐに"],["の"],["中","なか"],["に"],["置き","おき"],["、"],["その"],["町々","まちまち"],["は"],["荒て","あれて"],["、"],["四十","よんじゅう"],["年","ねん"],["の"],["あいだ"],["荒れた","あれた"],["町々","まちまち"],["の"],["中","なか"],["に"],["ある"],["。"],["わたし"],["は"],["エジプト"],["びと"],["を"],["、"],["もろもろ"],["の"],["国民","こくみん"],["の"],["中","なか"],["に"],["散らし","ちらし"],["、"],["もろもろ"],["の"],["国","くに"],["の"],["中","なか"],["に"],["散らす","ちらす"],["。"]]},{"verse":13,"text":"主,しゅなる神,かみはこう言,いわれる、四十年,ねんの後,のち、わたしはエジプトびとを、その散,ちらされたもろもろの民,たみの中,なかから集,あつめる。","tok":[["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["四十","よんじゅう"],["年","ねん"],["の"],["後","の"],["ち"],["、"],["わたし"],["は"],["エジプト"],["びと"],["を"],["、"],["その"],["散らされた","ちらされた"],["もろもろ"],["の"],["民","たみ"],["の"],["中","なか"],["から"],["集める","あつめる"],["。"]]},{"verse":14,"text":"すなわちエジプトの運命,うんめいをもとに返,かえし、彼,かれらをその生,うまれた地,ちであるパテロスの地,ちに帰,かえらせる。その所,ところで彼,かれらは卑,いやしい国,くにとなる。","tok":[["すなわち"],["エジプト"],["の"],["運命","うんめい"],["を"],["もと"],["に"],["返","かえし"],["、"],["彼","かれ"],["ら"],["を"],["その"],["生まれた","うまれた"],["地","ち"],["で"],["ある"],["パテロス"],["の"],["地","ち"],["に"],["帰えらせる","かえらせる"],["。"],["その"],["所","ところ"],["で"],["彼","かれ"],["ら"],["は"],["卑しい","いやしい"],["国","くに"],["と"],["なる"],["。"]]},{"verse":15,"text":"これはもろもろの国,くによりも卑,いやしくなり、再,ふたたびもろもろの国民,こくみんの上,うえに出,でることができない。わたしは彼,かれらを小,ちいさくするゆえ、再,ふたたびもろもろの国民,こくみんを治,おさめることはない。","tok":[["これ"],["は"],["もろもろ"],["の"],["国","くに"],["より"],["も"],["卑しく","いやしく"],["なり"],["、"],["再び","ふたたび"],["もろもろ"],["の"],["国民","こくみん"],["の"],["上","うえ"],["に"],["出る","でる"],["こと"],["が"],["できない"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["小さく","ちいさく"],["する"],["ゆえ"],["、"],["再び","ふたたび"],["もろもろ"],["の"],["国民","こくみん"],["を"],["治める","おさめる"],["こと"],["は"],["ない"],["。"]]},{"verse":16,"text":"これはイスラエルが助,たすけを求,もとめる時,とき、その罪,つみを思,おもい出,だして、再,ふたたびイスラエルの家,いえの頼,たのみとはならない。こうして彼,かれらは、わたしが主,しゅなる神,かみであることを知,しる」。","tok":[["これ"],["は"],["イスラエル"],["が"],["助け","たすけ"],["を"],["求める","もとめる"],["時","とき"],["、"],["その"],["罪","つみ"],["を"],["思い出して","おもいだして"],["、"],["再び","ふたたび"],["イスラエル"],["の"],["家","いえ"],["の"],["頼み","たのみ"],["と"],["は"],["ならない"],["。"],["こう"],["して"],["彼","かれ"],["ら"],["は"],["、"],["わたし"],["が"],["主","しゅ"],["なる"],["神","かみ"],["で"],["ある"],["こと"],["を"],["知る","しる"],["」"],["。"]]},{"verse":17,"text":"第,だい二十七年,ねんの一月,がつ一日,にちに、主,しゅの言葉,ことばがわたしに臨,のぞんだ、","tok":[["第","だい"],["二十七","にじゅうなな"],["年","ねん"],["の"],["一","いち"],["月","がつ"],["つ"],["一","いち"],["日","にち"],["に"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":18,"text":"「人,ひとの子,こよ、バビロンの王,おうネブカデレザルは、その軍勢,ぐんぜいをツロに対,たいして大,おおいに働,はたらかせた。頭,あたまは皆,みなはげ、肩,かたはみな破,やぶれた。しかし彼,かれもその軍勢,ぐんぜいも、ツロに対,たいしてなしたその働,はたらきのために、なんの報,むくいをも得,えなかった。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["バビロン"],["の"],["王","おう"],["ネブカデレザル"],["は"],["、"],["その"],["軍勢","ぐんぜい"],["を"],["ツロ"],["に対して","にたいして"],["大いに","おおいに"],["働かせた","はたらかせた"],["。"],["頭","あたま"],["は"],["皆","みな"],["はげ"],["、"],["肩","かた"],["は"],["みな"],["破れた","やぶれた"],["。"],["しかし"],["彼","かれ"],["も"],["その"],["軍勢","ぐんぜい"],["も"],["、"],["ツロ"],["に対して","にたいして"],["なした"],["その"],["働らき","はたらき"],["の"],["ため"],["に"],["、"],["なん"],["の"],["報い","むくい"],["を"],["も"],["得なかった","えなかった"],["。"]]},{"verse":19,"text":"それゆえ、主,しゅなる神,かみはこう言,いわれる、見,みよ、わたしはバビロンの王,おうネブカデレザルに、エジプトの地,ちを与,あたえる。彼,かれはその財宝,ざいほうを取,とり、物,ものをかすめ、物,ものを奪,うばい、それをその軍勢,ぐんぜいに与,あたえて報,むくいとする。","tok":[["それ"],["ゆえ"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["見よ","みよ"],["、"],["わたし"],["は"],["バビロン"],["の"],["王","おう"],["ネブカデレザル"],["に"],["、"],["エジプト"],["の"],["地","ち"],["を"],["与える","あたえる"],["。"],["彼","かれ"],["は"],["その"],["財宝","ざいほう"],["を"],["取","とり"],["、"],["物","もの"],["を"],["かすめ"],["、"],["物","もの"],["を"],["奪い","うばい"],["、"],["それ"],["を"],["その"],["軍勢","ぐんぜい"],["に"],["与","あたえ"],["て"],["報い","むくい"],["と"],["する"],["。"]]},{"verse":20,"text":"彼,かれの働,はたらいた報酬,ほうしゅうとして、わたしはエジプトの地,ちを彼,かれに与,あたえる。彼,かれらはわたしのために、これをしたからであると、主,しゅなる神,かみは言,いわれる。","tok":[["彼","かれ"],["の"],["働いた","はたらいた"],["報酬","ほうしゅう"],["として"],["、"],["わたし"],["は"],["エジプト"],["の"],["地","ち"],["を"],["彼","かれ"],["に"],["与える","あたえる"],["。"],["彼","かれ"],["ら"],["は"],["わたし"],["の"],["ため"],["に"],["、"],["これ"],["を"],["した"],["から"],["で"],["ある"],["と"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"]]},{"verse":21,"text":"その日,ひ、わたしはイスラエルの家,いえに、一つの角,つのを生,しょうじさせ、あなたの口,くちを彼,かれらのうちに開,ひらかせる。そして彼,かれらはわたしが主,しゅであることを知,しる」。","tok":[["その"],["日","ひ"],["、"],["わたし"],["は"],["イスラエル"],["の"],["家","いえ"],["に"],["、"],["一","ひと"],["つ"],["の"],["角","つ"],["の"],["を"],["生じさせ","しょうじさせ"],["、"],["あなた"],["の"],["口","くち"],["を"],["彼","かれ"],["ら"],["の"],["うち"],["に"],["開らかせる","ひらかせる"],["。"],["そして"],["彼","かれ"],["ら"],["は"],["わたし"],["が"],["主","しゅ"],["で"],["ある"],["こと"],["を"],["知る","しる"],["」"],["。"]]}]
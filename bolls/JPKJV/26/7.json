[{"verse":1,"text":"主,しゅの言葉,ことばがまたわたしに臨,のぞんだ、","tok":[["主","しゅ"],["の"],["言葉","ことば"],["が"],["また"],["わたし"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":2,"text":"「人,ひとの子,こよ、イスラエルの地,ちの終,おわりについて主,しゅはこう言,いわれる、この国,くにの四方,しほうの境,さかいに終,おわりが来,きた。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["イスラエル"],["の"],["地","ち"],["の"],["終わり","おわり"],["について"],["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["この"],["国","くに"],["の"],["四方","しほう"],["の"],["境","さかい"],["に"],["終","おわり"],["が"],["来た","きた"],["。"]]},{"verse":3,"text":"いま、あなたの終,おわりが来,きた。わたしはわが怒,いかりをあなたに漏,もらし、あなたの行,おこないに従,したがって、あなたをさばき、あなたのもろもろの憎,にくむべき物,もののためにあなたを罰,ばっする。","tok":[["いま"],["、"],["あなた"],["の"],["終","おわり"],["が"],["来た","きた"],["。"],["わたし"],["は"],["わが"],["怒り","いかり"],["を"],["あなた"],["に"],["漏らし","もらし"],["、"],["あなた"],["の"],["行ない","おこない"],["に"],["従って","したがって"],["、"],["あなた"],["を"],["さばき"],["、"],["あなた"],["の"],["もろもろ"],["の"],["憎むべき","にくむべき"],["物","もの"],["の"],["ため"],["に"],["あなた"],["を"],["罰する","ばっする"],["。"]]},{"verse":4,"text":"わたしの目,めはあなたを惜,おしみ見,みず、またあなたをあわれまない。わたしはあなたの行,おこないのためにあなたを罰,ばっする。あなたの憎,にくむべき事,ことがあなたのうちにある。これによって、あなたがたはわたしが主,しゅであることを知,しるようになる。","tok":[["わたし"],["の"],["目","め"],["は"],["あなた"],["を"],["惜み","おしみ"],["見ず","みず"],["、"],["また"],["あなた"],["を"],["あわれまない"],["。"],["わたし"],["は"],["あなた"],["の"],["行ない","おこない"],["の"],["ため"],["に"],["あなた"],["を"],["罰する","ばっする"],["。"],["あなた"],["の"],["憎むべき","にくむべき"],["事","こと"],["が"],["あなた"],["の"],["うち"],["に"],["ある"],["。"],["これ"],["によって"],["、"],["あなた"],["がた"],["は"],["わたし"],["が"],["主","しゅ"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"]]},{"verse":5,"text":"主,しゅなる神,かみはこう言,いわれる、災,わざわいが引,ひき続,つづいて起,おこる。見,みよ、災,わざわいが来,くる。","tok":[["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["災","わざわい"],["が"],["引続いて","ひきつづいて"],["起こる","おこる"],["。"],["見よ","みよ"],["、"],["災","わざわい"],["が"],["来る","くる"],["。"]]},{"verse":6,"text":"終,おわりが来,くる。その終,おわりが来,くる。それが起,たって、あなたに臨,のぞむ。見,みよ、それが来,くる。","tok":[["終","おわり"],["が"],["来る","くる"],["。"],["その"],["終","おわり"],["が"],["来る","くる"],["。"],["それ"],["が"],["起って","たって"],["、"],["あなた"],["に"],["臨む","のぞむ"],["。"],["見よ","みよ"],["、"],["それ"],["が"],["来る","くる"],["。"]]},{"verse":7,"text":"この地,ちに住,すむ者,ものよ、あなたの最後,さいごの運命,うんめいがあなたに来,きた。時,ときは来,きた。日,ひが近,ちかづいた。混乱,こんらんの日,ひで、山々,やまやまに聞,きこえる喜,よろこびの日,ひではない。","tok":[["この"],["地","ち"],["に"],["住む","すむ"],["者","もの"],["よ"],["、"],["あなた"],["の"],["最後","さいご"],["の"],["運命","うんめい"],["が"],["あなた"],["に"],["来た","きた"],["。"],["時","とき"],["は"],["来た","きた"],["。"],["日","ひ"],["が"],["近づいた","ちかづいた"],["。"],["混乱","こんらん"],["の"],["日","ひ"],["で"],["、"],["山々","やまやま"],["に"],["聞こえる","きこえる"],["喜こび","よろこび"],["の"],["日","ひ"],["で"],["は"],["ない"],["。"]]},{"verse":8,"text":"今,いまわたしは、すみやかにわたしの憤,いきどおりをあなたの上,うえに注,そそぎ、わたしの怒,いかりをあなたに漏,もらし尽,つくし、あなたの行,おこないに従,したがってあなたをさばき、あなたのもろもろの憎,にくむべき事,ことのためにあなたを罰,ばっする。","tok":[["今","いま"],["わたし"],["は"],["、"],["すみやか"],["に"],["わたし"],["の"],["憤り","いきどおり"],["を"],["あなた"],["の"],["上","うえ"],["に"],["注ぎ","そそぎ"],["、"],["わたし"],["の"],["怒り","いかり"],["を"],["あなた"],["に"],["漏らし","もらし"],["尽くし","つくし"],["、"],["あなた"],["の"],["行ない","おこない"],["に"],["従って","したがって"],["あなた"],["を"],["さばき"],["、"],["あなた"],["の"],["もろもろ"],["の"],["憎むべき","にくむべき"],["事","こと"],["の"],["ため"],["に"],["あなた"],["を"],["罰する","ばっする"],["。"]]},{"verse":9,"text":"わたしの目,めはあなたを惜,おしみ見,みず、またあなたをあわれまない。わたしはあなたの行,おこないのためにあなたを罰,ばっする。あなたの憎,にくむべき事,ことがあなたのうちにある。これによって、あなたがたは、主,しゅであるわたしがあなたを撃,うつことを知,しるようになる。","tok":[["わたし"],["の"],["目","め"],["は"],["あなた"],["を"],["惜み","おしみ"],["見ず","みず"],["、"],["また"],["あなた"],["を"],["あわれまない"],["。"],["わたし"],["は"],["あなた"],["の"],["行ない","おこない"],["の"],["ため"],["に"],["あなた"],["を"],["罰する","ばっする"],["。"],["あなた"],["の"],["憎むべき","にくむべき"],["事","こと"],["が"],["あなた"],["の"],["うち"],["に"],["ある"],["。"],["これ"],["によって"],["、"],["あなた"],["がた"],["は"],["、"],["主","しゅ"],["で"],["ある"],["わたし"],["が"],["あなた"],["を"],["撃つ","うつ"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"]]},{"verse":10,"text":"見,みよ、その日,ひを。また見,みよ、かの日,ひが来,きた。あなたの最後,さいごの運命,うんめいが来,きた。不義,ふぎは花,はな咲,さき、高,たかぶりは芽,めを出,だした。","tok":[["見よ","みよ"],["、"],["その"],["日","ひ"],["を"],["。"],["また"],["見よ","みよ"],["、"],["かの"],["日","ひ"],["が"],["来た","きた"],["。"],["あなた"],["の"],["最後","さいご"],["の"],["運命","うんめい"],["が"],["来た","きた"],["。"],["不義","ふぎ"],["は"],["花咲き","はなさき"],["、"],["高か","たか"],["ぶり"],["は"],["芽","め"],["を"],["出した","だした"],["。"]]},{"verse":11,"text":"暴虐,ぼうぎゃくはつのって悪,あくのつえとなった。彼,かれらもその群衆,ぐんしゅうも、その富,とみも消,きえ、また彼,かれらの名声,めいせいも消,きえて何,なにも残,のこらなくなる。","tok":[["暴虐","ぼうぎゃく"],["は"],["つのって"],["悪","あく"],["の"],["つえ"],["と"],["なった"],["。"],["彼","かれ"],["ら"],["も"],["その"],["群衆","ぐんしゅう"],["も"],["、"],["その"],["富","とみ"],["も"],["消え","きえ"],["、"],["また"],["彼","かれ"],["ら"],["の"],["名声","めいせい"],["も"],["消えて","きえて"],["何に","なに"],["も"],["残らなく","のこらなく"],["なる"],["。"]]},{"verse":12,"text":"時,ときは来,きた。日,ひは近,ちかづいた。買,かう者,ものは喜,よろこぶな。売,うる者,ものは悲,かなしむな。怒,いかりがすべての群衆,ぐんしゅうの上,うえに臨,のぞむからだ。","tok":[["時","とき"],["は"],["来た","きた"],["。"],["日","ひ"],["は"],["近づいた","ちかづいた"],["。"],["買う","かう"],["者","もの"],["は"],["喜こぶ","よろこぶ"],["な"],["。"],["売る","うる"],["者","もの"],["は"],["悲しむ","かなしむ"],["な"],["。"],["怒り","いかり"],["が"],["すべて"],["の"],["群衆","ぐんしゅう"],["の"],["上","うえ"],["に"],["臨む","のぞむ"],["から"],["だ"],["。"]]},{"verse":13,"text":"売,うる者,ものはたとい生,いきていても、その売,うったものに帰,かえることはない。怒,いかりがそのすべての民衆,みんしゅうの上,うえにあるからだ。それはもとに帰,かえらない。その不義,ふぎのために、だれも命,いのちを全,まっとうすることはできない。","tok":[["売る","うる"],["者","もの"],["は"],["たとい"],["生きて","いきて"],["いて"],["も"],["、"],["その"],["売った","うった"],["もの"],["に"],["帰える","かえる"],["こと"],["は"],["ない"],["。"],["怒り","いかり"],["が"],["その"],["すべて"],["の"],["民衆","みんしゅう"],["の"],["上","うえ"],["に"],["ある"],["から"],["だ"],["。"],["それ"],["は"],["もと"],["に"],["帰えらない","かえらない"],["。"],["その"],["不義","ふぎ"],["の"],["ため"],["に"],["、"],["だれ"],["も"],["命","いのち"],["を"],["全う","まっとう"],["する"],["こと"],["は"],["できない"],["。"]]},{"verse":14,"text":"人々,ひとびとがラッパを吹,ふいて備,そなえをしても戦,たたかいに出,でる者,ものはない。それはわたしの怒,いかりがそのすべての群衆,ぐんしゅうの上,うえにあるからだ。","tok":[["人々","ひとびと"],["が"],["ラッパ"],["を"],["吹いて","ふいて"],["備","そなえ"],["を"],["して"],["も"],["戦い","たたかい"],["に"],["出る","でる"],["者","もの"],["は"],["ない"],["。"],["それ"],["は"],["わたし"],["の"],["怒り","いかり"],["が"],["その"],["すべて"],["の"],["群衆","ぐんしゅう"],["の"],["上","うえ"],["に"],["ある"],["から"],["だ"],["。"]]},{"verse":15,"text":"外,そとにはつるぎがあり、内,うちには疫病,えきびょうとききんがある。畑,はたけにいる者,ものはつるぎに死,しに、町,まちにいる者,ものはききんと疫病,えきびょうに滅,ほろぼされる。","tok":[["外","そと"],["に"],["は"],["つるぎ"],["が"],["あり"],["、"],["内","うち"],["に"],["は"],["疫病","えきびょう"],["と"],["ききん"],["が"],["ある"],["。"],["畑","はたけ"],["に"],["いる"],["者","もの"],["は"],["つるぎ"],["に"],["死に","しに"],["、"],["町","まち"],["に"],["いる"],["者","もの"],["は"],["ききん"],["と"],["疫病","えきびょう"],["に"],["滅ぼされる","ほろぼされる"],["。"]]},{"verse":16,"text":"そのうちの、のがれる者,ものは谷間,たにまのはとのように山々,やまやまに行,いって、おのおの皆,みなその罪,つみのために悲,かなしむ。","tok":[["その"],["うち"],["の"],["、"],["のがれる"],["者","もの"],["は"],["谷間","たにま"],["の"],["はと"],["の"],["よう"],["に"],["山々","やまやま"],["に"],["行って","いって"],["、"],["おのおの"],["皆","みな"],["その"],["罪","つみ"],["の"],["ため"],["に"],["悲しむ","かなしむ"],["。"]]},{"verse":17,"text":"両手,りょうてとも弱,よわくなり、両,りょうひざとも水,みずのように弱,よわくなる。","tok":[["両手","りょうて"],["と"],["も"],["弱く","よわく"],["なり"],["、"],["両ひざ","りょうひざ"],["とも"],["水","みず"],["の"],["よう"],["に"],["弱く","よわく"],["なる"],["。"]]},{"verse":18,"text":"彼,かれらは荒布,あらぬのを身,みにまとい、恐,おそれが彼,かれらをおおい、すべての顔,かおには恥,はじがあらわれ、すべての頭,あたまは髪,かみをそり落,おとす。","tok":[["彼","かれ"],["ら"],["は"],["荒布","あらぬ"],["の"],["を"],["身","み"],["に"],["まとい"],["、"],["恐","おそれ"],["が"],["彼","かれ"],["ら"],["を"],["おおい"],["、"],["すべて"],["の"],["顔","かお"],["に"],["は"],["恥","はじ"],["が"],["あらわれ"],["、"],["すべて"],["の"],["頭","あたま"],["は"],["髪","かみ"],["を"],["そり落とす","そりおとす"],["。"]]},{"verse":19,"text":"彼,かれらはその銀,ぎんをちまたに捨,すて、その金,きんはあくたのようになる。主,しゅの怒,いかりの日,ひには金銀,きんぎんも彼,かれらを救,すくうことはできない。それらは彼,かれらの飢,うえを満足,まんぞくさせることができない、またその腹,はらを満,みたすことができない。それは彼,かれらの不義,ふぎのつまずきであったからだ。","tok":[["彼","かれ"],["ら"],["は"],["その"],["銀","ぎん"],["を"],["ちまた"],["に"],["捨て","すて"],["、"],["その"],["金","きん"],["は"],["あくた"],["の"],["よう"],["に"],["なる"],["。"],["主","しゅ"],["の"],["怒り","いかり"],["の"],["日","ひ"],["に"],["は"],["金銀","きんぎん"],["も"],["彼","かれ"],["ら"],["を"],["救う","すくう"],["こと"],["は"],["できない"],["。"],["それ"],["ら"],["は"],["彼","かれ"],["ら"],["の"],["飢","うえ"],["を"],["満足","まんぞく"],["させる"],["こと"],["が"],["できない"],["、"],["また"],["その"],["腹","はら"],["を"],["満たす","みたす"],["こと"],["が"],["できない"],["。"],["それ"],["は"],["彼","かれ"],["ら"],["の"],["不義","ふぎ"],["の"],["つまずき"],["で"],["あった"],["から"],["だ"],["。"]]},{"verse":20,"text":"彼,かれらはその美,うつくしい飾,かざり物,ものを高,たかぶりのために用,もちい、またこれをもってその憎,にくむべき偶像,ぐうぞうと忌,いむべき物,ものを造,つくった。それゆえわたしはこれを彼,かれらに対,たいして汚,けがれたものとする。","tok":[["彼","かれ"],["ら"],["は"],["その"],["美しい","うつくしい"],["飾","かざり"],["物","もの"],["を"],["高か","たか"],["ぶり"],["の"],["ため"],["に"],["用い","もちい"],["、"],["また"],["これ"],["を"],["もって"],["その"],["憎むべき","にくむべき"],["偶像","ぐうぞう"],["と"],["忌むべき","いむべき"],["物","もの"],["を"],["造った","つくった"],["。"],["それ"],["ゆえ"],["わたし"],["は"],["これ"],["を"],["彼","かれ"],["ら"],["に対して","にたいして"],["汚","けがれたも"],["の"],["と"],["する"],["。"]]},{"verse":21,"text":"わたしはこれを外国,がいこく人,じんの手,てに渡,わたして奪,うばわせ、地,ちの悪人,あくにんに渡,わたしてかすめさせる。彼,かれらはこれを汚,けがす。","tok":[["わたし"],["は"],["これ"],["を"],["外国人","がいこくじん"],["の"],["手","て"],["に"],["渡","わたし"],["て"],["奪わせ","うばわせ"],["、"],["地","ち"],["の"],["悪人","あくにん"],["に"],["渡","わたし"],["て"],["かすめさせる"],["。"],["彼","かれ"],["ら"],["は"],["これ"],["を"],["汚","け"],["がす"],["。"]]},{"verse":22,"text":"わたしは彼,かれらから顔,かおをそむけて、彼,かれらにわたしの聖所,せいじょを汚,けがさせる。強盗,ごうとうがこれにはいって汚,けがし、","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["から"],["顔","かお"],["を"],["そむけて"],["、"],["彼","かれ"],["ら"],["に"],["わたし"],["の"],["聖","せい"],["所","しょ"],["を"],["汚","け"],["が"],["させる"],["。"],["強盗","ごうとう"],["が"],["これ"],["に"],["はいって"],["汚","け"],["がし"],["、"]]},{"verse":23,"text":"また荒,あれ地,ちとする。この地,ちは流血,りゅうけつのとがに満,みち、この町,まちは暴虐,ぼうぎゃくに満,みちているゆえ、","tok":[["また"],["荒れ地","あれち"],["と"],["する"],["。"],["この"],["地","ち"],["は"],["流血","りゅうけつ"],["の"],["とが"],["に"],["満ち","みち"],["、"],["この"],["町","まち"],["は"],["暴虐","ぼうぎゃく"],["に"],["満ちて","みちて"],["いる"],["ゆえ"],["、"]]},{"verse":24,"text":"わたしは国々,くにぐにのうちの悪,わるい者,ものどもを招,まねいて、彼,かれらの家,いえをかすめさせる。わたしは強,つよい者,ものの高,たかぶりをやめさせる。また彼,かれらの聖所,せいじょは汚,けがされる。","tok":[["わたし"],["は"],["国々","くにぐに"],["の"],["うち"],["の"],["悪い","わるい"],["者","もの"],["ども"],["を"],["招いて","まねいて"],["、"],["彼","かれ"],["ら"],["の"],["家","いえ"],["を"],["かすめさせる"],["。"],["わたし"],["は"],["強い","つよい"],["者","もの"],["の"],["高ぶり","たかぶり"],["を"],["やめさせる"],["。"],["また"],["彼","かれ"],["ら"],["の"],["聖","せい"],["所","しょ"],["は"],["汚","け"],["が"],["される"],["。"]]},{"verse":25,"text":"滅,ほろびが来,くるとき、彼,かれらは平安,へいあんを求,もとめても得,えられない。","tok":[["滅び","ほろび"],["が"],["来る","くる"],["とき"],["、"],["彼","かれ"],["ら"],["は"],["平安","へいあん"],["を"],["求めて","もとめて"],["も"],["得られない","えられない"],["。"]]},{"verse":26,"text":"災,わざわいに災,わざわいが重,かさなりきたり、知,しらせに知,しらせが相,あいつぐ。その時,とき、彼,かれらは預言者,よげんしゃに幻,まぼろしを求,もとめる。しかし律法,りっぽうは祭司,さいしのうちに絶,たえ、計,はかりごとは長老,ちょうろうのうちに絶,たえる。","tok":[["災","わざわい"],["に"],["災","わざわい"],["が"],["重なり","かさなり"],["き"],["たり"],["、"],["知らせ","しらせ"],["に"],["知らせ","しらせ"],["が"],["相","あい"],["つぐ"],["。"],["その"],["時","とき"],["、"],["彼","かれ"],["ら"],["は"],["預言者","よげんしゃ"],["に"],["幻","まぼろし"],["を"],["求める","もとめる"],["。"],["しかし"],["律法","りっぽう"],["は"],["祭司","さいし"],["の"],["うち"],["に"],["絶え","たえ"],["、"],["計り","はかり"],["ごと"],["は"],["長老","ちょうろう"],["の"],["うち"],["に"],["絶える","たえる"],["。"]]},{"verse":27,"text":"王,おうは悲,かなしみ、つかさは望,のぞみを失,うしない、その地,ちの民,たみの手,てはおののきによってこわばる。わたしは彼,かれらの行,おこないに従,したがって彼,かれらをあつかい、そのさばきに従,したがって彼,かれらをさばく。そして彼,かれらはわたしが主,しゅであることを知,しるようになる」。","tok":[["王","おう"],["は"],["悲しみ","かなしみ"],["、"],["つかさ"],["は"],["望み","のぞみ"],["を"],["失ない","うしない"],["、"],["その"],["地","ち"],["の"],["民","たみ"],["の"],["手","て"],["は"],["おののき"],["によって"],["こわばる"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["行ない","おこない"],["に"],["従って","したがって"],["彼","かれ"],["ら"],["を"],["あつかい"],["、"],["その"],["さばき"],["に"],["従って","したがって"],["彼","かれ"],["ら"],["を"],["さばく"],["。"],["そして"],["彼","かれ"],["ら"],["は"],["わたし"],["が"],["主","しゅ"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["」"],["。"]]}]
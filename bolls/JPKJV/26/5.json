[{"verse":1,"text":"人,ひとの子,こよ、鋭,するどいつるぎを取,とり、それを理髪,りはつ師,しのかみそりとして、あなたの頭,あたまと、ひげとをそり、はかりで量,はかって、その毛,けを分,わけなさい。","tok":[["人","ひと"],["の"],["子","こ"],["よ"],["、"],["鋭い","するどい"],["つるぎ"],["を"],["取","とり"],["、"],["それ"],["を"],["理髪師","りはつし"],["の"],["かみそり"],["として"],["、"],["あなた"],["の"],["頭","あたま"],["と"],["、"],["ひげ"],["と"],["を"],["そり"],["、"],["はかり"],["で"],["量って","はかって"],["、"],["その"],["毛","け"],["を"],["分け","わけ"],["なさい"],["。"]]},{"verse":2,"text":"その三分,ぶんの一は包囲,ほういの期間,きかんの終,おわる時,とき、町,まちの中,なかで火,ひで焼,やき、また三分,ぶんの一を取,とり、つるぎで町,まちのまわりでこれを打,うち、さらに三分,ぶんの一を風,かぜに散,ちらしなさい。わたしはつるぎを抜,ぬいて、彼,かれらのあとを追,おう。","tok":[["その"],["三分","ぶん"],["の"],["一","いち"],["は"],["包囲","ほうい"],["の"],["期間","きかん"],["の"],["終わる","おわる"],["時","とき"],["、"],["町","まち"],["の"],["中","なか"],["で"],["火","ひ"],["で"],["焼き","やき"],["、"],["また"],["三分","ぶん"],["の"],["一","いち"],["を"],["取","とり"],["、"],["つるぎ"],["で"],["町","まち"],["の"],["まわり"],["で"],["これ"],["を"],["打ち","うち"],["、"],["さらに"],["三分","ぶん"],["の"],["一","いち"],["を"],["風","かぜ"],["に"],["散らし","ちらし"],["なさい"],["。"],["わたし"],["は"],["つるぎ"],["を"],["抜いて","ぬいて"],["、"],["彼","かれ"],["ら"],["の"],["あと"],["を"],["追う","おう"],["。"]]},{"verse":3,"text":"あなたはその毛,けを少,すこし取,とって、衣,ころものすそに包,つつみ、","tok":[["あなた"],["は"],["その"],["毛","け"],["を"],["少し","すこし"],["取って","とって"],["、"],["衣","ころも"],["の"],["すそ"],["に"],["包","つつみ"],["、"]]},{"verse":4,"text":"またそのうちから少,すこしを取,とって火,ひの中,なかに投,なげ入,いれ、火,ひでこれを焼,やきなさい。火,ひはその中,なかから出,でて、イスラエルの全家,ぜんかに及,およぶ。","tok":[["また"],["その"],["うち"],["から"],["少し","すこし"],["を"],["取って","とって"],["火","ひ"],["の"],["中","なか"],["に"],["投入れ","なげいれ"],["、"],["火","ひ"],["で"],["これ"],["を"],["焼き","やき"],["なさい"],["。"],["火","ひ"],["は"],["その"],["中","なか"],["から"],["出て","でて"],["、"],["イスラエル"],["の"],["全","ぜん"],["家","いえ"],["に"],["及ぶ","およぶ"],["。"]]},{"verse":5,"text":"主,しゅなる神,かみはこう言,いわれる、わたしはこのエルサレムを万国,ばんこくの中,なかに置,おき、国々,くにぐにをそのまわりに置,おいた。","tok":[["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["わたし"],["は"],["この"],["エルサレム"],["を"],["万国","ばんこく"],["の"],["中","なか"],["に"],["置き","おき"],["、"],["国々","くにぐに"],["を"],["その"],["まわり"],["に"],["置いた","おいた"],["。"]]},{"verse":6,"text":"エルサレムは他,たの国々,くにぐによりも悪,あしく、わたしのおきてにそむき、そのまわりの国々,くにぐによりもわたしの定,さだめにそむいた。すなわち彼,かれらはわたしのおきてを捨,すて、わたしの定,さだめに歩,あゆまなかった。","tok":[["エルサレム"],["は"],["他","た"],["の"],["国々","くにぐに"],["より"],["も"],["悪しく","あしく"],["、"],["わたし"],["の"],["おきて"],["に"],["そむき"],["、"],["その"],["まわり"],["の"],["国々","くにぐに"],["より"],["も"],["わたし"],["の"],["定め","さだめ"],["に"],["そむいた"],["。"],["すなわち"],["彼","かれ"],["ら"],["は"],["わたし"],["の"],["おきて"],["を"],["捨て","すて"],["、"],["わたし"],["の"],["定め","さだめ"],["に"],["歩まなかった","あゆまなかった"],["。"]]},{"verse":7,"text":"それゆえ主,しゅはこう言,いわれる、あなたがたはそのまわりにいる異邦人,いほうじんよりも狂暴,きょうぼうであって、わたしの定,さだめに歩,あゆまず、わたしのおきてを行,おこなわず、むしろ、あなたがたの回,まわりにいる異邦人,いほうじんのおきてを守,まもっていた。","tok":[["それ"],["ゆえ"],["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["あなた"],["がた"],["は"],["その"],["まわり"],["に"],["いる"],["異邦人","いほうじん"],["より"],["も"],["狂暴","きょうぼう"],["で"],["あって"],["、"],["わたし"],["の"],["定め","さだめ"],["に"],["歩まず","あゆまず"],["、"],["わたし"],["の"],["おきて"],["を"],["行なわず","おこなわず"],["、"],["むしろ"],["、"],["あなた"],["がた"],["の"],["回わり","まわり"],["に"],["いる"],["異邦人","いほうじん"],["の"],["おきて"],["を"],["守って","まもって"],["いた"],["。"]]},{"verse":8,"text":"それゆえ主,しゅなる神,かみはこう言,いわれる、見,みよ、わたしはあなたを攻,せめ、異邦人,いほうじんの目,めの前,まえで、あなたの中,なかにさばきを行,おこなう。","tok":[["それ"],["ゆえ"],["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["見よ","みよ"],["、"],["わたし"],["は"],["あなた"],["を"],["攻め","せめ"],["、"],["異邦人","いほうじん"],["の"],["目","め"],["の"],["前","まえ"],["で"],["、"],["あなた"],["の"],["中","なか"],["に"],["さばき"],["を"],["行なう","おこなう"],["。"]]},{"verse":9,"text":"あなたのもろもろの憎,にくむべき事,ことのために、わたしがまだした事,ことのないような事,こと、またこの後,のちふたたびしないような事,ことをあなたに対,たいしてする。","tok":[["あなた"],["の"],["もろもろ"],["の"],["憎むべき","にくむべき"],["事","こと"],["の"],["ため"],["に"],["、"],["わたし"],["が"],["まだ"],["した"],["事","こと"],["の"],["ない"],["よう"],["な"],["事","こと"],["、"],["また"],["この"],["後","の"],["ち"],["ふたたび"],["しない"],["よう"],["な"],["事","こと"],["を"],["あなた"],["に対して","にたいして"],["する"],["。"]]},{"verse":10,"text":"それゆえ、あなたのうちで父,ちちはその子,こを食,くい、子,こはその父,ちちを食,くう。わたしはあなたに対,たいしてさばきを行,おこない、あなたのうちの残,のこりの者,ものをことごとく四方,しほうの風,かぜに散,ちらす。","tok":[["それ"],["ゆえ"],["、"],["あなた"],["の"],["うち"],["で"],["父","ちち"],["は"],["その"],["子","こ"],["を"],["食い","くい"],["、"],["子","こ"],["は"],["その"],["父","ちち"],["を"],["食う","くう"],["。"],["わたし"],["は"],["あなた"],["に対して","にたいして"],["さばき"],["を"],["行ない","おこない"],["、"],["あなた"],["の"],["うち"],["の"],["残り","のこり"],["の"],["者","もの"],["を"],["ことごとく"],["四方","しほう"],["の"],["風","かぜ"],["に"],["散らす","ちらす"],["。"]]},{"verse":11,"text":"それゆえ、主,しゅなる神,かみは言,いわれる、わたしは生,いきている。あなたはその忌,いむべき物,ものと、その憎,にくむべき事,こととをもって、わたしの聖所,せいじょを汚,けがしたので、わたしは必,かならずあなたの数,かずを減,へらす。わたしの目,めはあなたを惜,おしみ見,みず、またわたしはあなたをあわれまない。","tok":[["それ"],["ゆえ"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["、"],["わたし"],["は"],["生きて","いきて"],["いる"],["。"],["あなた"],["は"],["その"],["忌むべき","いむべき"],["物","もの"],["と"],["、"],["その"],["憎むべき","にくむべき"],["事","こと"],["と"],["を"],["もって"],["、"],["わたし"],["の"],["聖","せい"],["所","しょ"],["を"],["汚","け"],["がした"],["ので"],["、"],["わたし"],["は"],["必","かならず"],["あなた"],["の"],["数","かず"],["を"],["減らす","へらす"],["。"],["わたし"],["の"],["目","め"],["は"],["あなた"],["を"],["惜み","おしみ"],["見ず","みず"],["、"],["また"],["わたし"],["は"],["あなた"],["を"],["あわれまない"],["。"]]},{"verse":12,"text":"あなたの三分,ぶんの一はあなたの中,なかで疫病,えきびょうで死,しに、ききんで滅,ほろび、三分,ぶんの一はあなたのまわりでつるぎに倒,たおれ、三分,ぶんの一は四方,しほうの風,かぜに散,ちらされる。わたしはつるぎを抜,ぬいてそのあとを追,おう。","tok":[["あなた"],["の"],["三分","ぶん"],["の"],["一","いち"],["は"],["あなた"],["の"],["中","なか"],["で"],["疫病","え"],["き"],["びょう"],["で"],["死に","しに"],["、"],["ききん"],["で"],["滅び","ほろび"],["、"],["三分","ぶん"],["の"],["一","いち"],["は"],["あなた"],["の"],["まわり"],["で"],["つるぎ"],["に"],["倒れ","たおれ"],["、"],["三分","ぶん"],["の"],["一","いち"],["は"],["四方","しほう"],["の"],["風","かぜ"],["に"],["散らされる","ちらされる"],["。"],["わたし"],["は"],["つるぎ"],["を"],["抜いて","ぬいて"],["その"],["あと"],["を"],["追う","おう"],["。"]]},{"verse":13,"text":"こうしてわたしは怒,いかりを漏,もらし尽,つくし、憤,いきどおりを彼,かれらの上,うえに漏,もらして、満足,まんぞくする。こうして、わたしの憤,いきどおりを彼,かれらの上,うえに漏,もらし尽,つくした時,とき、彼,かれらは主,しゅであるわたしが熱心,ねっしんに語,かたったことを知,しるであろう。","tok":[["こう"],["して"],["わたし"],["は"],["怒り","いかり"],["を"],["漏らし","もらし"],["尽くし","つくし"],["、"],["憤り","いきどおり"],["を"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["漏らして","もらして"],["、"],["満足","まんぞく"],["する"],["。"],["こう"],["して"],["、"],["わたし"],["の"],["憤り","いきどおり"],["を"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["漏らし","もらし"],["尽くした","つくした"],["時","とき"],["、"],["彼","かれ"],["ら"],["は"],["主","しゅ"],["で"],["ある"],["わたし"],["が"],["熱心","ねっしん"],["に"],["語った","かたった"],["こと"],["を"],["知るで","しるで"],["あろう"],["。"]]},{"verse":14,"text":"わたしはまわりにある国々,くにぐにの中,なかと、すべてそばを通,とおる者,ものの目,めの前,まえであなたを滅亡,めつぼうとあざけりに渡,わたす。","tok":[["わたし"],["は"],["まわり"],["に"],["ある"],["国々","くにぐに"],["の"],["中","なか"],["と"],["、"],["すべて"],["そば"],["を"],["通る","とおる"],["者","もの"],["の"],["目","め"],["の"],["前","まえ"],["で"],["あなた"],["を"],["滅亡","めつぼう"],["と"],["あざけり"],["に"],["渡す","わたす"],["。"]]},{"verse":15,"text":"わたしが怒,いかりと、憤,いきどおりと、重,おもい懲罰,ちょうばつとをもって、あなたに対,たいしてさばきを行,おこなう時,とき、あなたはそのまわりにある国々,くにぐにのあざけりとなり、そしりとなり、戒,いましめとなり、驚,おどろきとなる。これは主,しゅであるわたしが語,かたるのである。","tok":[["わたし"],["が"],["怒り","いかり"],["と"],["、"],["憤り","いきどおり"],["と"],["、"],["重い","おもい"],["懲罰","ちょうばつ"],["と"],["を"],["もって"],["、"],["あなた"],["に対して","にたいして"],["さばき"],["を"],["行なう","おこなう"],["時","とき"],["、"],["あなた"],["は"],["その"],["まわり"],["に"],["ある"],["国々","くにぐに"],["の"],["あざけり"],["と"],["なり"],["、"],["そしり"],["と"],["なり"],["、"],["戒しめ","いましめ"],["と"],["なり"],["、"],["驚","おどろき"],["と"],["なる"],["。"],["これ"],["は"],["主","しゅ"],["で"],["ある"],["わたし"],["が"],["語る","かたる"],["ので"],["ある"],["。"]]},{"verse":16,"text":"すなわち、わたしがあなたを滅,ほろぼすききんの矢,や、滅亡,めつぼうの矢,やをあなたに放,はなつ時,とき、わたしはあなたを滅,ほろぼすために放,はなつのだ。わたしはあなたの上,うえにききんを増,まし加,くわえ、あなたがつえとするパンを打,うち砕,くだく。","tok":[["すなわち"],["、"],["わたし"],["が"],["あなた"],["を"],["滅ぼす","ほろぼす"],["ききん"],["の"],["矢","や"],["、"],["滅亡","めつぼう"],["の"],["矢","や"],["を"],["あなた"],["に"],["放つ","はなつ"],["時","とき"],["、"],["わたし"],["は"],["あなた"],["を"],["滅ぼす","ほろぼす"],["ため"],["に"],["放つ","はなつ"],["の"],["だ"],["。"],["わたし"],["は"],["あなた"],["の"],["上","うえ"],["に"],["ききん"],["を"],["増し加え","ましくわえ"],["、"],["あなた"],["が"],["つえ"],["と"],["する"],["パン"],["を"],["打ち砕く","うちくだく"],["。"]]},{"verse":17,"text":"わたしはあなたにききんと野獣,やじゅうを送,おくって、あなたの子,こを奪,うばい取,とり、また疫病,えきびょうと流血,りゅうけつにあなたの中,なかを通,とおらせ、またつるぎをあなたに送,おくる。主,しゅであるわたしがこれを言,いう」。","tok":[["わたし"],["は"],["あなた"],["に"],["ききん"],["と"],["野獣","やじゅう"],["を"],["送って","おくって"],["、"],["あなた"],["の"],["子","こ"],["を"],["奪い","うばい"],["取","とり"],["、"],["また"],["疫病","えきびょう"],["と"],["流血","りゅうけつ"],["に"],["あなた"],["の"],["中","なか"],["を"],["通らせ","とおらせ"],["、"],["また"],["つるぎ"],["を"],["あなた"],["に"],["送る","おくる"],["。"],["主","しゅ"],["で"],["ある"],["わたし"],["が"],["これ"],["を"],["言う","いう"],["」"],["。"]]}]
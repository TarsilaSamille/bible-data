[{"verse":1,"text":"第,だい三十年,ねん四月,がつ五日,かに、わたしがケバル川,がわのほとりで、捕囚,ほしゅうの人々,ひとびとのうちにいた時,とき、天,てんが開,ひらけて、神,かみの幻,まぼろしを見,みた。","tok":[["第","だい"],["三十","さんじゅう"],["年","ねん"],["四","し"],["月","がつ"],["つ"],["五日","か"],["に"],["、"],["わたし"],["が"],["ケバル"],["川","がわ"],["の"],["ほとり"],["で"],["、"],["捕囚","ほしゅう"],["の"],["人々","ひとびと"],["の"],["うち"],["に"],["いた"],["時","とき"],["、"],["天","てん"],["が"],["開て","ひらけて"],["、"],["神","かみ"],["の"],["幻","まぼろし"],["を"],["見た","みた"],["。"]]},{"verse":2,"text":"これはエホヤキン王,おうの捕,とらえ移,うつされた第,だい五年,ねんであって、その月,つきの五日,かに、","tok":[["これ"],["は"],["エホヤキン"],["王","おう"],["の"],["捕らえ","とらえ"],["移された","うつされた"],["第","だい"],["五","ご"],["年","ねん"],["で"],["あって"],["、"],["その"],["月","つき"],["の"],["五日","か"],["に"],["、"]]},{"verse":3,"text":"主,しゅの言葉,ことばがケバル川,がわのほとり、カルデヤびとの地,ちでブジの子,こ祭司,さいしエゼキエルに臨,のぞみ、主,しゅの手,てがその所,ところで彼,かれの上,うえにあった。","tok":[["主","しゅ"],["の"],["言葉","ことば"],["が"],["ケバル"],["川","がわ"],["の"],["ほとり"],["、"],["カルデヤ"],["びと"],["の"],["地","ち"],["で"],["ブジ"],["の"],["子","こ"],["祭司","さいし"],["エゼキエル"],["に"],["臨み","のぞみ"],["、"],["主","しゅ"],["の"],["手","て"],["が"],["その"],["所","ところ"],["で"],["彼","かれ"],["の"],["上","うえ"],["に"],["あった"],["。"]]},{"verse":4,"text":"わたしが見,みていると、見,みよ、激,はげしい風,かぜと大,おおいなる雲,くもが北,きたから来,きて、その周囲,しゅういに輝,かがやきがあり、たえず火,ひを吹,ふき出,だしていた。その火,ひの中,なかに青銅,せいどうのように輝,かがやくものがあった。","tok":[["わたし"],["が"],["見て","みて"],["いる"],["と"],["、"],["見よ","みよ"],["、"],["激しい","はげしい"],["風","かぜ"],["と"],["大いなる","おおいなる"],["雲","くも"],["が"],["北","きた"],["から"],["来て","きて"],["、"],["その"],["周囲","しゅうい"],["に"],["輝やき","かがやき"],["が"],["あり"],["、"],["たえず"],["火","ひ"],["を"],["吹出して","ふきだして"],["いた"],["。"],["その"],["火","ひ"],["の"],["中","なか"],["に"],["青銅","せいどう"],["の"],["よう"],["に"],["輝やく","かがやく"],["もの"],["が"],["あった"],["。"]]},{"verse":5,"text":"またその中,なかから四つの生,いきものの形,かたちが出,でてきた。その様子,ようすはこうである。彼,かれらは人,ひとの姿,すがたをもっていた。","tok":[["また"],["その"],["中","なか"],["から"],["四","よん"],["つ"],["の"],["生きもの","いきもの"],["の"],["形","かたち"],["が"],["出て","でて"],["きた"],["。"],["その"],["様子","ようす"],["は"],["こう"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["人","ひと"],["の"],["姿","すがた"],["を"],["もって"],["いた"],["。"]]},{"verse":6,"text":"おのおの四つの顔,かおをもち、またそのおのおのに四つの翼,つばさがあった。","tok":[["おのおの"],["四","よん"],["つ"],["の"],["顔","かお"],["を"],["もち"],["、"],["また"],["その"],["おのおの"],["に"],["四","よん"],["つ"],["の"],["翼","つばさ"],["が"],["あった"],["。"]]},{"verse":7,"text":"その足,あしはまっすぐで、足,あしのうらは子,こ牛,うしの足,あしのうらのようであり、みがいた青銅,せいどうのように光,ひかっていた。","tok":[["その"],["足","あし"],["は"],["まっすぐ"],["で"],["、"],["足","あし"],["の"],["うら"],["は"],["子牛","こうし"],["の"],["足","あし"],["の"],["うら"],["の"],["よう"],["で"],["あり"],["、"],["みがいた"],["青銅","せいどう"],["の"],["よう"],["に"],["光って","ひかって"],["いた"],["。"]]},{"verse":8,"text":"その四方,しほうに、そのおのおのの翼,つばさの下,したに人,ひとの手,てがあった。この四つの者,ものはみな顔,かおと翼,つばさをもち、","tok":[["その"],["四方","しほう"],["に"],["、"],["その"],["おのおの"],["の"],["翼","つばさ"],["の"],["下","した"],["に"],["人","ひと"],["の"],["手","て"],["が"],["あった"],["。"],["この"],["四","よん"],["つ"],["の"],["者","もの"],["は"],["みな"],["顔","かお"],["と"],["翼","つばさ"],["を"],["もち"],["、"]]},{"verse":9,"text":"翼,つばさは互,たがいに連,つらなり、行,ゆく時,ときは回,まわらずに、おのおの顔,かおの向,むかうところにまっすぐに進,すすんだ。","tok":[["翼","つばさ"],["は"],["互","たがい"],["に"],["連なり","つらなり"],["、"],["行く","ゆく"],["時","とき"],["は"],["回わらず","まわらず"],["に"],["、"],["おのおの"],["顔","かお"],["の"],["向かう","むかう"],["ところ"],["に"],["まっすぐ"],["に"],["進んだ","すすんだ"],["。"]]},{"verse":10,"text":"顔,かおの形,かたちは、おのおのその前方,ぜんぽうに人,ひとの顔,かおをもっていた。四つの者,ものは右,みぎの方,ほうに、ししの顔,かおをもち、四つの者,ものは左,ひだりの方,ほうに牛,うしの顔,かおをもち、また四つの者,ものは後,うしろの方,ほうに、わしの顔,かおをもっていた。","tok":[["顔","かお"],["の"],["形","かたち"],["は"],["、"],["おのおの"],["その"],["前方","ぜんぽう"],["に"],["人","ひと"],["の"],["顔","かお"],["を"],["もって"],["いた"],["。"],["四","よん"],["つ"],["の"],["者","もの"],["は"],["右","みぎ"],["の"],["方","ほう"],["に"],["、"],["しし"],["の"],["顔","かお"],["を"],["もち"],["、"],["四","よん"],["つ"],["の"],["者","もの"],["は"],["左","ひだり"],["の"],["方","ほう"],["に"],["牛","うし"],["の"],["顔","かお"],["を"],["もち"],["、"],["また"],["四","よん"],["つ"],["の"],["者","もの"],["は"],["後ろ","うしろ"],["の"],["方","ほう"],["に"],["、"],["わし"],["の"],["顔","かお"],["を"],["もって"],["いた"],["。"]]},{"verse":11,"text":"彼,かれらの顔,かおはこのようであった。その翼,つばさは高,たかく伸,のばされ、その二つは互,たがいに連,つらなり、他,たの二つをもってからだをおおっていた。","tok":[["彼","かれ"],["ら"],["の"],["顔","かお"],["は"],["この"],["よう"],["で"],["あった"],["。"],["その"],["翼","つばさ"],["は"],["高かく","たかく"],["伸ばされ","のばされ"],["、"],["その"],["二","ふた"],["つ"],["は"],["互","たがい"],["に"],["連なり","つらなり"],["、"],["他","た"],["の"],["二","ふた"],["つ"],["を"],["もって"],["からだ"],["を"],["おおって"],["いた"],["。"]]},{"verse":12,"text":"彼,かれらはおのおのその顔,かおの向,むかうところへまっすぐに行,いき、霊,れいの行,ゆくところへ彼,かれらも行,ゆき、その行,ゆく時,ときは回,まわらない。","tok":[["彼","かれ"],["ら"],["は"],["おのおの"],["その"],["顔","かお"],["の"],["向かう","むかう"],["ところ"],["へ"],["まっすぐ"],["に"],["行き","いき"],["、"],["霊","れい"],["の"],["行へ","ゆくところへ"],["彼","かれ"],["ら"],["も"],["行き","ゆき"],["、"],["その"],["行く","ゆく"],["時","とき"],["は"],["回わらない","まわらない"],["。"]]},{"verse":13,"text":"この生,いきもののうちには燃,もえる炭,すみの火,ひのようなものがあり、たいまつのように、生,いきものの中,なかを行,ゆき来,きしている。火,ひは輝,かがやいて、その火,ひから、いなずまが出,でていた。","tok":[["この"],["生きもの","いきもの"],["の"],["うち"],["に"],["は"],["燃える","もえる"],["炭","すみ"],["の"],["火","ひ"],["の"],["よう"],["な"],["もの"],["が"],["あり"],["、"],["たいまつ"],["の"],["よう"],["に"],["、"],["生きもの","いきもの"],["の"],["中","なか"],["を"],["行き来","ゆきき"],["して"],["いる"],["。"],["火","ひ"],["は"],["輝やいて","かがやいて"],["、"],["その"],["火","ひ"],["から"],["、"],["いなずま"],["が"],["出て","でて"],["いた"],["。"]]},{"verse":14,"text":"生,いきものは、いなずまのひらめきのように速,はやく行,ゆき来,きしていた。","tok":[["生きもの","いきもの"],["は"],["、"],["いなずま"],["の"],["ひらめき"],["の"],["よう"],["に"],["速く","はやく"],["行き来","ゆきき"],["して"],["いた"],["。"]]},{"verse":15,"text":"わたしが生,いきものを見,みていると、生,いきもののかたわら、地,ちの上,うえに輪,わがあった。四つの生,いきものおのおのに、一つずつの輪,わである。","tok":[["わたし"],["が"],["生きもの","いきもの"],["を"],["見て","みて"],["いる"],["と"],["、"],["生きもの","いきもの"],["の"],["かたわら"],["、"],["地","ち"],["の"],["上","うえ"],["に"],["輪","わ"],["が"],["あった"],["。"],["四","よん"],["つ"],["の"],["生きもの","いきもの"],["おのおの"],["に"],["、"],["一","ひと"],["つ"],["ずつ"],["の"],["輪","わ"],["で"],["ある"],["。"]]},{"verse":16,"text":"もろもろの輪,わの形,かたちと作,つくりは、光,ひかる貴,きかんらん石,いしのようである。四つのものは同,おなじ形,かたちで、その作,つくりは、あたかも、輪,わの中,なかに輪,わがあるようである。","tok":[["もろもろ"],["の"],["輪","わ"],["の"],["形","かたち"],["と"],["作り","つくり"],["は"],["、"],["光る","ひかる"],["貴","き"],["かんらん"],["石","いし"],["の"],["よう"],["で"],["ある"],["。"],["四","よん"],["つ"],["の"],["もの"],["は"],["同じ","おなじ"],["形","かたち"],["で"],["、"],["その"],["作り","つくり"],["は"],["、"],["あたかも"],["、"],["輪","わ"],["の"],["中","なか"],["に"],["輪","わ"],["が"],["ある"],["よう"],["で"],["ある"],["。"]]},{"verse":17,"text":"その行,ゆく時,とき、彼,かれらは四方,しほうのいずれかに行,いき、行,ゆく時,ときは回,まわらない。","tok":[["その"],["行く","ゆく"],["時","とき"],["、"],["彼","かれ"],["ら"],["は"],["四方","しほう"],["の"],["いずれ"],["か"],["に"],["行き","いき"],["、"],["行く","ゆく"],["時","とき"],["は"],["回わらない","まわらない"],["。"]]},{"verse":18,"text":"四つの輪,わには輪,わ縁,ぶちと輻,やとがあり、その輪,わ縁,ぶちの周囲,しゅういは目,めをもって満,みたされていた。","tok":[["四","よん"],["つ"],["の"],["輪","わ"],["に"],["は"],["輪縁","わぶち"],["と"],["輻","や"],["と"],["が"],["あり"],["、"],["その"],["輪縁","わぶち"],["の"],["周囲","しゅうい"],["は"],["目","め"],["を"],["もって"],["満たされて","みたされて"],["いた"],["。"]]},{"verse":19,"text":"生,いきものが行,ゆく時,ときには、輪,わもそのかたわらに行,いき、生,いきものが地,ちからあがる時,ときは、輪,わもあがる。","tok":[["生きもの","いきもの"],["が"],["行く","ゆく"],["時","とき"],["に"],["は"],["、"],["輪","わ"],["も"],["その"],["かたわら"],["に"],["行き","いき"],["、"],["生きもの","いきもの"],["が"],["地","ち"],["から"],["あがる"],["時","とき"],["は"],["、"],["輪","わ"],["も"],["あがる"],["。"]]},{"verse":20,"text":"霊,れいの行,ゆく所,ところには彼,かれらも行,いき、輪,わは彼,かれらに伴,ともなってあがる。生,いきものの霊,れいが輪,わの中,なかにあるからである。","tok":[["霊","れい"],["の"],["行く","ゆく"],["所","ところ"],["に"],["は"],["彼","かれ"],["ら"],["も"],["行き","いき"],["、"],["輪","わ"],["は"],["彼","かれ"],["ら"],["に"],["伴なって","ともなって"],["あがる"],["。"],["生きもの","いきもの"],["の"],["霊","れい"],["が"],["輪","わ"],["の"],["中","なか"],["に"],["ある"],["から"],["で"],["ある"],["。"]]},{"verse":21,"text":"彼,かれらが行,ゆく時,ときは、これらも行,いき、彼,かれらがとどまる時,ときは、これらもとどまり、彼,かれらが地,ちからあがる時,ときは、輪,わもまたこれらと共,ともにあがる。生,いきものの霊,れいが輪,わの中,なかにあるからである。","tok":[["彼","かれ"],["ら"],["が"],["行く","ゆく"],["時","とき"],["は"],["、"],["これ"],["ら"],["も"],["行き","いき"],["、"],["彼","かれ"],["ら"],["が"],["とどまる"],["時","とき"],["は"],["、"],["これ"],["ら"],["も"],["とどまり"],["、"],["彼","かれ"],["ら"],["が"],["地","ち"],["から"],["あがる"],["時","とき"],["は"],["、"],["輪","わ"],["も"],["また"],["これ"],["ら"],["と"],["共","とも"],["に"],["あがる"],["。"],["生きもの","いきもの"],["の"],["霊","れい"],["が"],["輪","わ"],["の"],["中","なか"],["に"],["ある"],["から"],["で"],["ある"],["。"]]},{"verse":22,"text":"生,いきものの頭,あたまの上,うえに水晶,すいしょうのように輝,かがやく大空,おおぞらの形,かたちがあって、彼,かれらの頭,あたまの上,うえに広,ひろがっている。、","tok":[["生きもの","いきもの"],["の"],["頭","あたま"],["の"],["上","うえ"],["に"],["水晶","すいしょう"],["の"],["よう"],["に"],["輝やく","かがやく"],["大空","おおぞら"],["の"],["形","かたち"],["が"],["あって"],["、"],["彼","かれ"],["ら"],["の"],["頭","あたま"],["の"],["上","うえ"],["に"],["広がって","ひろがって"],["いる"],["。"],["、"]]},{"verse":23,"text":"大空,おおぞらの下,したにはまっすぐに伸,のばした翼,つばさがあり、たがいに相連,あいつらなり、生,いきものはおのおの二つの翼,つばさをもって、からだをおおっている。","tok":[["大空","おおぞら"],["の"],["下","した"],["に"],["は"],["まっすぐ"],["に"],["伸ばした","のばした"],["翼","つばさ"],["が"],["あり"],["、"],["たがい"],["に"],["相","あい"],["連なり","つらなり"],["、"],["生きもの","いきもの"],["は"],["おのおの"],["二","ふた"],["つ"],["の"],["翼","つばさ"],["を"],["もって"],["、"],["からだ"],["を"],["おおって"],["いる"],["。"]]},{"verse":24,"text":"その行,ゆく時,とき、わたしは大水,おおみずの声,こえ、全能者,ぜんのうしゃの声,こえのような翼,つばさの声,こえを聞,きいた。その声,こえの響,ひびきは大軍,たいぐんの声,こえのようで、そのとどまる時,ときは翼,つばさをたれる。","tok":[["その"],["行く","ゆく"],["時","とき"],["、"],["わたし"],["は"],["大水","おおみず"],["の"],["声","こえ"],["、"],["全能者","ぜんのうしゃ"],["の"],["声","こえ"],["の"],["よう"],["な"],["翼","つばさ"],["の"],["声","こえ"],["を"],["聞いた","きいた"],["。"],["その"],["声","こえ"],["の"],["響","ひびき"],["は"],["大軍","たいぐん"],["の"],["声","こえ"],["の"],["よう"],["で"],["、"],["その"],["とどまる"],["時","とき"],["は"],["翼","つばさ"],["を"],["たれる"],["。"]]},{"verse":25,"text":"また彼,かれらの頭,あたまの上,うえの大空,おおぞらから声,こえがあった。彼,かれらが立,たちとどまる時,ときは翼,つばさをおろした。","tok":[["また"],["彼","かれ"],["ら"],["の"],["頭","あたま"],["の"],["上","うえ"],["の"],["大空","おおぞら"],["から"],["声","こえ"],["が"],["あった"],["。"],["彼","かれ"],["ら"],["が"],["立ち","たち"],["とどまる"],["時","とき"],["は"],["翼","つばさ"],["を"],["おろした"],["。"]]},{"verse":26,"text":"彼,かれらの頭,あたまの上,うえの大空,おおぞらの上,うえに、サファイヤのような位,くらいの形,かたちがあった。またその位,くらいの形,かたちの上,うえに、人,ひとの姿,すがたのような形,かたちがあった。","tok":[["彼","かれ"],["ら"],["の"],["頭","あたま"],["の"],["上","うえ"],["の"],["大空","おおぞら"],["の"],["上","うえ"],["に"],["、"],["サファイヤ"],["の"],["よう"],["な"],["位","くらい"],["の"],["形","かたち"],["が"],["あった"],["。"],["また"],["その"],["位","くらい"],["の"],["形","かたち"],["の"],["上","うえ"],["に"],["、"],["人","ひと"],["の"],["姿","すがた"],["の"],["よう"],["な"],["形","かたち"],["が"],["あった"],["。"]]},{"verse":27,"text":"そしてその腰,こしとみえる所,ところの上,うえの方,ほうに、火,ひの形,かたちのような光,ひかる青銅,せいどうの色,いろのものが、これを囲,かこんでいるのを見,みた。わたしはその腰,こしとみえる所,ところの下,したの方,ほうに、火,ひのようなものを見,みた。そして彼,かれのまわりに輝,かがやきがあった。","tok":[["そして"],["その"],["腰","こし"],["と"],["みえる"],["所","ところ"],["の"],["上","うえ"],["の"],["方","ほう"],["に"],["、"],["火","ひ"],["の"],["形","かたち"],["の"],["よう"],["な"],["光る","ひかる"],["青銅","せいどう"],["の"],["色","いろ"],["の"],["もの"],["が"],["、"],["これ"],["を"],["囲んで","かこんで"],["いる"],["の"],["を"],["見た","みた"],["。"],["わたし"],["は"],["その"],["腰","こし"],["と"],["みえる"],["所","ところ"],["の"],["下","した"],["の"],["方","ほう"],["に"],["、"],["火","ひ"],["の"],["よう"],["な"],["もの"],["を"],["見た","みた"],["。"],["そして"],["彼","かれ"],["の"],["まわり"],["に"],["輝やき","かがやき"],["が"],["あった"],["。"]]},{"verse":28,"text":"そのまわりにある輝,かがやきのさまは、雨,あめの日,ひに雲,くもに起,おこるにじのようであった。主,しゅの栄光,えいこうの形,かたちのさまは、このようであった。わたしはこれを見,みて、わたしの顔,かおをふせたとき、語,かたる者,ものの声,こえを聞,きいた。","tok":[["その"],["まわり"],["に"],["ある"],["輝やき","かがやき"],["の"],["さま"],["は"],["、"],["雨","あめ"],["の"],["日","ひ"],["に"],["雲","くも"],["に"],["起こる","おこる"],["にじ"],["の"],["よう"],["で"],["あった"],["。"],["主","しゅ"],["の"],["栄光","えいこう"],["の"],["形","かたち"],["の"],["さま"],["は"],["、"],["この"],["よう"],["で"],["あった"],["。"],["わたし"],["は"],["これ"],["を"],["見て","みて"],["、"],["わたし"],["の"],["顔","かお"],["を"],["ふせた"],["とき"],["、"],["語る","かたる"],["者","もの"],["の"],["声","こえ"],["を"],["聞いた","きいた"],["。"]]}]
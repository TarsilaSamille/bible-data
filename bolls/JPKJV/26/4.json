[{"verse":1,"text":"人,ひとの子,こよ、一枚,まいのかわらを取,とって、あなたの前,まえに置,おき、その上,うえにエルサレムの町,まちを描,えがきなさい。","tok":[["人","ひと"],["の"],["子","こ"],["よ"],["、"],["一枚","まい"],["の"],["かわら"],["を"],["取って","とって"],["、"],["あなた"],["の"],["前","まえ"],["に"],["置き","おき"],["、"],["その"],["上","うえ"],["に"],["エルサレム"],["の"],["町","まち"],["を"],["描き","えがき"],["なさい"],["。"]]},{"verse":2,"text":"そしてこれを取,とり囲,かこみ、これにむかって雲梯,うんていを設,もうけ、塁,るいを築,きずき、陣,じんを張,はり、その回,まわりに城,しろくずしを備,そなえてこれを攻,せめなさい。","tok":[["そして"],["これ"],["を"],["取囲み","とりかこみ"],["、"],["これ"],["に"],["むかって"],["雲梯","うんてい"],["を"],["設け","もうけ"],["、"],["塁","るい"],["を"],["築き","きずき"],["、"],["陣","じん"],["を"],["張り","はり"],["、"],["その"],["回わり","まわり"],["に"],["城","しろ"],["くずし"],["を"],["備","そなえ"],["て"],["これ"],["を"],["攻め","せめ"],["なさい"],["。"]]},{"verse":3,"text":"また鉄,てつの板,いたをとり、それをあなたと町,まちの間,あいだに置,おいて鉄,てつの壁,かべとなし、あなたの顔,かおをこれに向,むけなさい。町,まちをこのように囲,かこんで、その包囲,ほういを押,おし進,すすめなさい。これがイスラエルの家,いえのしるしである。","tok":[["また"],["鉄","てつ"],["の"],["板","いた"],["を"],["とり"],["、"],["それ"],["を"],["あなた"],["と"],["町","まち"],["の"],["間","あいだ"],["に"],["置いて","おいて"],["鉄","てつ"],["の"],["壁","かべ"],["と"],["なし"],["、"],["あなた"],["の"],["顔","かお"],["を"],["これ"],["に"],["向け","むけ"],["なさい"],["。"],["町","まち"],["を"],["この"],["よう"],["に"],["囲んで","かこんで"],["、"],["その"],["包囲","ほうい"],["を"],["押","おし"],["進め","すすめ"],["なさい"],["。"],["これ"],["が"],["イスラエル"],["の"],["家","いえ"],["の"],["しるし"],["で"],["ある"],["。"]]},{"verse":4,"text":"あなたはまた自分,じぶんの左,ひだり脇,わきを下,したにして寝,ねなさい。わたしはあなたの上,うえにイスラエルの家,いえの罰,ばつを置,おく。あなたはこのようにして寝,ねている日,ひの間,あいだ、彼,かれらの罰,ばつを負,おわなければならない。","tok":[["あなた"],["は"],["また"],["自分","じぶん"],["の"],["左脇","ひだりわき"],["を"],["下","した"],["に"],["して"],["寝","ね"],["なさい"],["。"],["わたし"],["は"],["あなた"],["の"],["上","うえ"],["に"],["イスラエル"],["の"],["家","いえ"],["の"],["罰","ばつ"],["を"],["置く","おく"],["。"],["あなた"],["は"],["この"],["よう"],["に"],["して"],["寝て","ねて"],["いる"],["日","ひ"],["の"],["間","あいだ"],["、"],["彼","かれ"],["ら"],["の"],["罰","ばつ"],["を"],["負わなければ","おわなければ"],["ならない"],["。"]]},{"verse":5,"text":"わたしは彼,かれらの罰,ばつの年数,ねんすうに等,ひとしいその日,ひ数,かず、すなわち三百九十日,にちをあなたのために定,さだめる。その間,かんあなたはイスラエルの家,いえの罰,ばつを負,おわなければならない。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["の"],["罰","ばつ"],["の"],["年数","ねんすう"],["に"],["等い","ひとしい"],["その"],["日数","ひか"],["ず"],["、"],["すなわち"],["三百九十","さんひゃくきゅうとう"],["日","か"],["を"],["あなた"],["の"],["ため"],["に"],["定める","さだめる"],["。"],["その"],["間","かんあなた"],["は"],["イスラエル"],["の"],["家","いえ"],["の"],["罰","ばつ"],["を"],["負わなければ","おわなければ"],["ならない"],["。"]]},{"verse":6,"text":"あなたはその期間,きかんを終,おわったなら、また右,みぎ脇,わきを下,したにして寝,ねて、ユダの家,いえの罰,ばつを負,おわなければならない。わたしは一日,にちを一年,ねんとして四十日,にちをあなたのために定,さだめる。","tok":[["あなた"],["は"],["その"],["期間","きかん"],["を"],["終わったなら","おわったなら"],["、"],["また"],["右脇","みぎわき"],["を"],["下","した"],["に"],["して"],["寝て","ねて"],["、"],["ユダ"],["の"],["家","いえ"],["の"],["罰","ばつ"],["を"],["負わなければ","おわなければ"],["ならない"],["。"],["わたし"],["は"],["一","いち"],["日","にち"],["を"],["一","いち"],["年","ねん"],["として"],["四十日","にち"],["を"],["あなた"],["の"],["ため"],["に"],["定める","さだめる"],["。"]]},{"verse":7,"text":"あなたは自分,じぶんの顔,かおをエルサレムの包囲,ほういの方,ほうに向,むけ、腕,うでをあらわし、町,まちに向,むかって預言,よげんしなければならない。","tok":[["あなた"],["は"],["自分","じぶん"],["の"],["顔","かお"],["を"],["エルサレム"],["の"],["包囲","ほうい"],["の"],["方","ほう"],["に"],["向け","むけ"],["、"],["腕","うで"],["を"],["あらわし"],["、"],["町","まち"],["に"],["向かって","むかって"],["預言","よげん"],["しなければ"],["ならない"],["。"]]},{"verse":8,"text":"見,みよ、わたしはあなたに、なわをかけて、あなたの包囲,ほういの期間,きかんの終,おわるまで、左右,さゆうに動,うごくことができないようにする。","tok":[["見よ","みよ"],["、"],["わたし"],["は"],["あなた"],["に"],["、"],["なわ"],["を"],["かけて"],["、"],["あなた"],["の"],["包囲","ほうい"],["の"],["期間","きかん"],["の"],["終わる","おわる"],["まで"],["、"],["左右","さゆう"],["に"],["動く","うごく"],["こと"],["が"],["できない"],["よう"],["に"],["する"],["。"]]},{"verse":9,"text":"あなたはまた小麦,こむぎ、大麦,おおむぎ、豆,まめ、レンズ豆,まめ、あわ、はだか麦,むぎを取,とって、一つの器,うつわに入,いれ、これでパンを造,つくり、あなたが横,よこになって寝,ねる日,ひの数,かず、すなわち三百九十日,にちの間,あいだこれを食,たべなければならない。","tok":[["あなた"],["は"],["また"],["小麦","こむぎ"],["、"],["大麦","おおむぎ"],["、"],["豆","まめ"],["、"],["レンズ"],["豆","まめ"],["、"],["あわ"],["、"],["はだか麦","はだかむぎ"],["を"],["取って","とって"],["、"],["一","ひと"],["つ"],["の"],["器","うつわ"],["に"],["入れ","いれ"],["、"],["これ"],["で"],["パン"],["を"],["造","つくり"],["、"],["あなた"],["が"],["横","よこ"],["に"],["なって"],["寝る","ねる"],["日","ひ"],["の"],["数","かず"],["、"],["すなわち"],["三百九十","さんひゃくきゅうとう"],["日","か"],["の"],["間","あいだ"],["これ"],["を"],["食べなければ","たべなければ"],["ならない"],["。"]]},{"verse":10,"text":"あなたが食,たべる食物,しょくもつは量,はかって一日,にちに二十シケルである。あなたは一日,にちに一度,どこれを食,たべなければならない。","tok":[["あなた"],["が"],["食べる","たべる"],["食物","しょくもつ"],["は"],["量って","はかって"],["一","いち"],["日","にち"],["に"],["二十","にじゅう"],["シケル"],["で"],["ある"],["。"],["あなた"],["は"],["一","いち"],["日","にち"],["に"],["一度","どこれ"],["を"],["食べなければ","たべなければ"],["ならない"],["。"]]},{"verse":11,"text":"また水,みずを量,はかって一ヒンの六分,ぶんの一を一日,にちに一度,ど飲,のまなければならない。","tok":[["また"],["水","みず"],["を"],["量って","はかって"],["一","いち"],["ヒン"],["の"],["六分","ぶん"],["の"],["一","いち"],["を"],["一","いち"],["日","にち"],["に"],["一度","ど"],["飲まなければ","のまなければ"],["ならない"],["。"]]},{"verse":12,"text":"あなたは大麦,おおむぎの菓子,かしのようにしてこれを食,たべなさい。すなわち彼,かれらの目,めの前,まえでこれを人,ひとの糞,ふんで焼,やかなければならない」。","tok":[["あなた"],["は"],["大麦","おおむぎ"],["の"],["菓子","かし"],["の"],["よう"],["に"],["して"],["これ"],["を"],["食べ","たべ"],["なさい"],["。"],["すなわち"],["彼","かれ"],["ら"],["の"],["目","め"],["の"],["前","まえ"],["で"],["これ"],["を"],["人","ひと"],["の"],["糞","ふん"],["で"],["焼かなければ","やかなければ"],["ならない"],["」"],["。"]]},{"verse":13,"text":"そして主,しゅは言,いわれた、「このようにイスラエルの民,たみはわたしが追,おいやろうとする国々,くにぐにの中,なかで汚,けがれたパンを食,たべなければならない」。","tok":[["そして"],["主","しゅ"],["は"],["言われた","いわれた"],["、"],["「"],["この"],["よう"],["に"],["イスラエル"],["の"],["民","たみ"],["は"],["わたし"],["が"],["追いやろう","おいやろう"],["と"],["する"],["国々","くにぐに"],["の"],["中","なか"],["で"],["汚","け"],["がれ"],["た"],["パン"],["を"],["食べなければ","たべなければ"],["ならない"],["」"],["。"]]},{"verse":14,"text":"そこでわたしは言,いった、「ああ、主,しゅなる神,かみよ、わたしは自分,じぶんを汚,けがしたことはありません。わたしは幼,おさない時,ときから今日,こんにちまで、自然,しぜんに死,しんだものや、野獣,やじゅうに裂,さき殺,ころされたものを食,たべたことはありません。また汚,けがれた肉,にくがわたしの口,くちにはいったことはありません」。","tok":[["そこ"],["で"],["わたし"],["は"],["言った","いった"],["、"],["「"],["ああ"],["、"],["主","しゅ"],["なる"],["神","かみ"],["よ"],["、"],["わたし"],["は"],["自分","じぶん"],["を"],["汚","け"],["がした"],["こと"],["は"],["ありません"],["。"],["わたし"],["は"],["幼ない","おさない"],["時","とき"],["から"],["今日","こん"],["に"],["ち"],["まで"],["、"],["自然","しぜん"],["に"],["死んだ","しんだ"],["もの"],["や"],["、"],["野獣","やじゅう"],["に"],["裂き","さき"],["殺された","ころされた"],["もの"],["を"],["食べた","たべた"],["こと"],["は"],["ありません"],["。"],["また"],["汚","け"],["がれ"],["た"],["肉","にく"],["が"],["わたし"],["の"],["口","くち"],["に"],["はいった"],["こと"],["は"],["ありません"],["」"],["。"]]},{"verse":15,"text":"すると彼,かれはわたしに言,いわれた、「見,みよ、わたしは牛,うしの糞,ふんをもって人,ひとの糞,ふんに換,かえることをあなたにゆるす。あなたはそれで自分,じぶんのパンを整,ととのえなさい」。","tok":[["する"],["と"],["彼","かれ"],["は"],["わたし"],["に"],["言われた","いわれた"],["、"],["「"],["見よ","みよ"],["、"],["わたし"],["は"],["牛","うし"],["の"],["糞","ふん"],["を"],["もって"],["人","ひと"],["の"],["糞","ふん"],["に"],["換","かえ"],["る"],["こと"],["を"],["あなた"],["に"],["ゆるす"],["。"],["あなた"],["は"],["それ"],["で"],["自分","じぶん"],["の"],["パン"],["を"],["整え","ととのえ"],["なさい"],["」"],["。"]]},{"verse":16,"text":"またわたしに言,いわれた、「人,ひとの子,こよ、見,みよ、わたしはエルサレムで人,ひとのつえとするパンを打,うち砕,くだく。彼,かれらはパンを量,はかって、恐,おそれながら食,たべ、また水,みずを量,はかって驚,おどろきながら飲,のむ。","tok":[["また"],["わたし"],["に"],["言われた","いわれた"],["、"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["見よ","みよ"],["、"],["わたし"],["は"],["エルサレム"],["で"],["人","ひと"],["の"],["つえ"],["と"],["する"],["パン"],["を"],["打ち砕く","うちくだく"],["。"],["彼","かれ"],["ら"],["は"],["パン"],["を"],["量って","はかって"],["、"],["恐れ","おそれ"],["ながら"],["食べ","たべ"],["、"],["また"],["水","みず"],["を"],["量って","はかって"],["驚","おどろき"],["ながら"],["飲む","のむ"],["。"]]},{"verse":17,"text":"これは彼,かれらをパンと水,みずとに乏,とぼしくし、互,たがいに驚,おどろいて顔,かおを見合,みあわせ、その罰,ばつのために衰,おとろえさせるためである。","tok":[["これ"],["は"],["彼","かれ"],["ら"],["を"],["パン"],["と"],["水","みず"],["と"],["に"],["乏く","とぼしく"],["し"],["、"],["互","たがい"],["に"],["驚ろいて","おどろいて"],["顔","かお"],["を"],["見合わせ","みあわせ"],["、"],["その"],["罰","ばつ"],["の"],["ため"],["に"],["衰えさせる","おとろえさせる"],["ため"],["で"],["ある"],["。"]]}]
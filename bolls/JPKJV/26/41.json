[{"verse":1,"text":"彼,かれがわたしを拝殿,はいでんに連,つれて行,いって、脇,わき柱,ばしらを測,はかると、こなたの幅,はばも六キュビト、かなたの幅,はばも六キュビトあった。","tok":[["彼","かれ"],["が"],["わたし"],["を"],["拝殿","はいでん"],["に"],["連れて","つれて"],["行って","いって"],["、"],["脇柱","わきばしら"],["を"],["測る","はかる"],["と"],["、"],["こなた"],["の"],["幅","はば"],["も"],["六","ろく"],["キュビト"],["、"],["かなた"],["の"],["幅","はば"],["も"],["六","ろく"],["キュビト"],["あった"],["。"]]},{"verse":2,"text":"その戸,との幅,はばは十キュビト、戸,とのわきの壁,かべは、こなたも五キュビト、かなたも五キュビトあった。彼,かれはまた拝殿,はいでんの長,ながさを測,はかると四十キュビト、その幅,はばは二十キュビトあった。","tok":[["その"],["戸","と"],["の"],["幅","はば"],["は"],["十","じゅう"],["キュビト"],["、"],["戸","と"],["の"],["わき"],["の"],["壁","かべ"],["は"],["、"],["こなた"],["も"],["五","ご"],["キュビト"],["、"],["かなた"],["も"],["五","ご"],["キュビト"],["あった"],["。"],["彼","かれ"],["は"],["また"],["拝殿","はいでん"],["の"],["長さ","ながさ"],["を"],["測る","はかる"],["と"],["四十","よんじゅう"],["キュビト"],["、"],["その"],["幅","はば"],["は"],["二十","にじゅう"],["キュビト"],["あった"],["。"]]},{"verse":3,"text":"彼,かれがまた内,うちにはいって、戸,との脇,わき柱,ばしらを測,はかると、それは二キュビトあり、戸,との幅,はばは六キュビト、戸,とのわきの壁,かべは七キュビトあった。","tok":[["彼","かれ"],["が"],["また"],["内","うち"],["に"],["はいって"],["、"],["戸","と"],["の"],["脇柱","わきばしら"],["を"],["測る","はかる"],["と"],["、"],["それ"],["は"],["二","に"],["キュビト"],["あり"],["、"],["戸","と"],["の"],["幅","はば"],["は"],["六","ろく"],["キュビト"],["、"],["戸","と"],["の"],["わき"],["の"],["壁","かべ"],["は"],["七","なな"],["キュビト"],["あった"],["。"]]},{"verse":4,"text":"彼,かれはまた拝殿,はいでんの奥,おくの室,しつの長,ながさを測,はかると二十キュビト、幅,はばも二十キュビトあった。そして彼,かれはわたしに、これは至聖所,しせいじょであると言,いった。","tok":[["彼","かれ"],["は"],["また"],["拝殿","はいでん"],["の"],["奥","おく"],["の"],["室","しつ"],["の"],["長さ","ながさ"],["を"],["測る","はかる"],["と"],["二十","にじゅう"],["キュビト"],["、"],["幅","はば"],["も"],["二十","にじゅう"],["キュビト"],["あった"],["。"],["そして"],["彼","かれ"],["は"],["わたし"],["に"],["、"],["これ"],["は"],["至聖所","しせいじょである"],["と"],["言った","いった"],["。"]]},{"verse":5,"text":"彼,かれが宮,みやの壁,かべを測,はかると、その厚,あつさは六キュビトあり、宮,みやの周囲,しゅういの脇間,わきまの広,ひろさは、四方,しほうおのおの四キュビトあり、","tok":[["彼","かれ"],["が"],["宮","みや"],["の"],["壁","かべ"],["を"],["測る","はかる"],["と"],["、"],["その"],["厚","あつ"],["さ"],["は"],["六","ろく"],["キュビト"],["あり"],["、"],["宮","みや"],["の"],["周囲","しゅうい"],["の"],["脇間","わきま"],["の"],["広さ","ひろさ"],["は"],["、"],["四方","しほう"],["おのおの"],["四","よん"],["キュビト"],["あり"],["、"]]},{"verse":6,"text":"脇間,わきまは、室,しつの上,うえに室,しつがあって三階,かいになり、各階,かくかいに三十の室,しつがある。宮,みやの周囲,しゅういの壁,かべには、脇間,わきまをささえる突起,とっきがあった。これは脇間,わきまが、宮,みやの壁,かべそのものによってささえられないためである。","tok":[["脇間","わきま"],["は"],["、"],["室","しつ"],["の"],["上","うえ"],["に"],["室","しつ"],["が"],["あって"],["三","さん"],["階","かい"],["に"],["なり"],["、"],["各階","かくかい"],["に"],["三十","さんじゅう"],["の"],["室","しつ"],["が"],["ある"],["。"],["宮","みや"],["の"],["周囲","しゅうい"],["の"],["壁","かべ"],["に"],["は"],["、"],["脇間","わきま"],["を"],["ささえる"],["突起","とっき"],["が"],["あった"],["。"],["これ"],["は"],["脇間","わ"],["き"],["ま"],["が"],["、"],["宮","みや"],["の"],["壁","かべ"],["その"],["もの"],["によって"],["ささえられない"],["ため"],["で"],["ある"],["。"]]},{"verse":7,"text":"脇間,わきまは、宮,みやの周囲,しゅういの各階,かくかいにある突起,とっきにつれて、階,かいを重,かさねて上,うえにいくにしたがって広,ひろくなり、宮,みやの外部,がいぶの階段,かいだんが上,うえに通,つうじ、一階,かいから三階,かいへは、二階,かいをとおって上,のぼるのである。","tok":[["脇間","わきま"],["は"],["、"],["宮","みや"],["の"],["周囲","しゅうい"],["の"],["各階","かくかい"],["に"],["ある"],["突起","とっき"],["に"],["つれて"],["、"],["階","かい"],["を"],["重ねて","かさねて"],["上","うえ"],["に"],["いく"],["に"],["したがって"],["広く","ひろく"],["なり"],["、"],["宮","みや"],["の"],["外部","がいぶ"],["の"],["階段","かいだん"],["が"],["上","うえ"],["に"],["通じ","つうじ"],["、"],["一","いち"],["階","かい"],["ら"],["三","さん"],["階","かい"],["は"],["、"],["二","に"],["階","かい"],["を"],["とおって"],["上る","のぼる"],["ので"],["ある"],["。"]]},{"verse":8,"text":"わたしはまた宮,みやの周囲,しゅういに高,たかい所,ところのあるのを見,みた。脇間,わきまの基,もといを測,はかると、六キュビトの一さおあった。","tok":[["わたし"],["は"],["また"],["宮","みや"],["の"],["周囲","しゅうい"],["に"],["高かい","たかい"],["所","ところ"],["の"],["ある"],["の"],["を"],["見た","みた"],["。"],["脇間","わきま"],["の"],["基い","もとい"],["を"],["測る","はかる"],["と"],["、"],["六","ろく"],["キュビト"],["の"],["一","いち"],["さお"],["あった"],["。"]]},{"verse":9,"text":"脇間,わきまの外,そとの壁,かべの厚,あつさは五キュビト、あき地,ちになっている高,たかい所,ところは五キュビトあった。宮,みやの高,たかい所,ところと、","tok":[["脇間","わきま"],["の"],["外","そと"],["の"],["壁","かべ"],["の"],["厚","あつ"],["さ"],["は"],["五","ご"],["キュビト"],["、"],["あき地","あきち"],["に"],["なって"],["いる"],["高かい","たかい"],["所","ところ"],["は"],["五","ご"],["キュビト"],["あった"],["。"],["宮","みや"],["の"],["高い","たかい"],["所","ところ"],["と"],["、"]]},{"verse":10,"text":"庭,にわの室,しつの間,あいだには、宮,みやの周囲,しゅういに、広,ひろさ二十キュビトの所,ところがあった。","tok":[["庭","にわ"],["の"],["室","しつ"],["の"],["間","あいだ"],["に"],["は"],["、"],["宮","みや"],["の"],["周囲","しゅうい"],["に"],["、"],["広さ","ひろさ"],["二十","にじゅう"],["キュビト"],["の"],["所","ところ"],["が"],["あった"],["。"]]},{"verse":11,"text":"脇間,わきまの戸,とは、あき地,ちになっている高,たかい所,ところに向,むかって開,ひらけ、一つの戸,とは北,きたに向,むかい、一つの戸,とは南,みなみに向,むかっていた。そのあき地,ちになっている所,ところの幅,はばは、周囲,しゅうい五キュビトであった。","tok":[["脇間","わきま"],["の"],["戸","と"],["は"],["、"],["あき地","あきち"],["に"],["なって"],["いる"],["高かい","たかい"],["所","ところ"],["に"],["向かって","むかって"],["開らけ","ひらけ"],["、"],["一","ひと"],["つ"],["の"],["戸","と"],["は"],["北","きた"],["に"],["向","むかい"],["、"],["一","ひと"],["つ"],["の"],["戸","と"],["は"],["南","みなみ"],["に"],["向かって","むかって"],["いた"],["。"],["その"],["あき地","あきち"],["に"],["なって"],["いる"],["所","ところ"],["の"],["幅","はば"],["は"],["、"],["周囲","しゅうい"],["五","ご"],["キュビト"],["で"],["あった"],["。"]]},{"verse":12,"text":"西,にしの方,ほうの宮,みやの庭,にわに面,めんした建物,たてものは、幅,はば七十キュビト、その建物,たてものの周囲,しゅういの壁,かべの厚,あつさは五キュビト、長,ながさは九十キュビトであった。","tok":[["西","にし"],["の"],["方","ほう"],["の"],["宮","みや"],["の"],["庭","にわ"],["に"],["面した","めんした"],["建物","たてもの"],["は"],["、"],["幅","はば"],["七十","ななじゅう"],["キュビト"],["、"],["その"],["建物","たてもの"],["の"],["周囲","しゅうい"],["の"],["壁","かべ"],["の"],["厚","あつ"],["さ"],["は"],["五","ご"],["キュビト"],["、"],["長さ","ながさ"],["は"],["九十","きゅうじゅう"],["キュビト"],["で"],["あった"],["。"]]},{"verse":13,"text":"彼,かれが宮,みやを測,はかると、その長,ながさは百キュビトあり、その庭,にわと建物,たてものと、その壁,かべは長,ながさ百キュビト、","tok":[["彼","かれ"],["が"],["宮","みや"],["を"],["測る","はかる"],["と"],["、"],["その"],["長さ","ながさ"],["は"],["百","ひゃく"],["キュビト"],["あり"],["、"],["その"],["庭","にわ"],["と"],["建物","たてもの"],["と"],["、"],["その"],["壁","かべ"],["は"],["長さ","ながさ"],["百","ひゃく"],["キュビト"],["、"]]},{"verse":14,"text":"また宮,みやの東,ひがしに面,めんした所,ところと庭,にわとの幅,はばは百キュビトであった。","tok":[["また"],["宮","みや"],["の"],["東","ひがし"],["に"],["面した","めんした"],["所","ところ"],["と"],["庭","にわ"],["と"],["の"],["幅","はば"],["は"],["百","ひゃく"],["キュビト"],["で"],["あった"],["。"]]},{"verse":15,"text":"彼,かれが西,にしの方,ほうの庭,にわに面,めんした建物,たてものと、その壁,かべの長,ながさを測,はかると、かなた、こなたともに百キュビトであった。宮,みやの拝殿,はいでんと、内部,ないぶの室,しつと、外,そとの廊,ろうとには、羽目板,はめいたがあった。","tok":[["彼","かれ"],["が"],["西","にし"],["の"],["方","ほう"],["の"],["庭","にわ"],["に"],["面した","めんした"],["建物","たてもの"],["と"],["、"],["その"],["壁","かべ"],["の"],["長さ","ながさ"],["を"],["測る","はかる"],["と"],["、"],["かなた"],["、"],["こなた"],["とも"],["に"],["百","ひゃく"],["キュビト"],["で"],["あった"],["。"],["宮","みや"],["の"],["拝殿","はいでん"],["と"],["、"],["内部","ないぶ"],["の"],["室","しつ"],["と"],["、"],["外","そと"],["の"],["廊","ろう"],["と"],["に"],["は"],["、"],["羽目板","はめいた"],["が"],["あった"],["。"]]},{"verse":16,"text":"これらの三つのものの周囲,しゅういには、すべて引込,ひっこみ枠,わくの窓,まどがあり、宮,みやの敷居,しきいに面,めんして、宮,みやの周囲,しゅういは、床,ゆかから窓,まどまで、羽目板,はめいたであって、窓,まどには、おおいがあった。","tok":[["これ"],["ら"],["の"],["三","みっ"],["つ"],["の"],["もの"],["の"],["周囲","しゅうい"],["に"],["は"],["、"],["すべて"],["引込み","ひっこみ"],["枠","わく"],["の"],["窓","まど"],["が"],["あり"],["、"],["宮","みや"],["の"],["敷居","しきい"],["に"],["面して","めんして"],["、"],["宮","みや"],["の"],["周囲","しゅうい"],["は"],["、"],["床","ゆか"],["から"],["窓","まど"],["まで"],["、"],["羽目板","はめいた"],["で"],["あって"],["、"],["窓","まど"],["に"],["は"],["、"],["おおい"],["が"],["あった"],["。"]]},{"verse":17,"text":"戸,との上,うわの空,そら所,ところ、内室,ないしつ、外,そと室,しつともに、羽目板,はめいたであった。内室,ないしつおよび拝殿,はいでんの周囲,しゅういのすべての壁,かべには、同,おなじように彫刻,ちょうこくしてあった。","tok":[["戸","と"],["の"],["上","うわ"],["の"],["空所","そらところ"],["、"],["内室","ないしつ"],["、"],["外室","そとしつと"],["も"],["に"],["、"],["羽目板","はめいた"],["で"],["あった"],["。"],["内室","ないしつ"],["および"],["拝殿","はいでん"],["の"],["周囲","しゅうい"],["の"],["すべて"],["の"],["壁","かべ"],["に"],["は"],["、"],["同じ","おなじ"],["よう"],["に"],["彫刻","ちょうこく"],["して"],["あった"],["。"]]},{"verse":18,"text":"すなわちケルビムと、しゅろとが彫刻,ちょうこくしてあった。ケルブとケルブとの間,あいだに、しゅろがあり、おのおののケルブには、二つの顔,かおがあり、","tok":[["すなわち"],["ケルビム"],["と"],["、"],["しゅろ"],["と"],["が"],["彫刻","ちょうこく"],["して"],["あった"],["。"],["ケルブ"],["と"],["ケルブ"],["と"],["の"],["間","あいだ"],["に"],["、"],["しゅろ"],["が"],["あり"],["、"],["おのおの"],["の"],["ケルブ"],["に"],["は"],["、"],["二","ふた"],["つ"],["の"],["顔","かお"],["が"],["あり"],["、"]]},{"verse":19,"text":"こなたには、しゅろに向,むかって、人,ひとの顔,かおがあり、かなたには、しゅろに向,むかって、若,わかじしの顔,かおがあり、宮,みやの周囲,しゅういは、すべてこのように彫刻,ちょうこくしてあった。","tok":[["こなた"],["に"],["は"],["、"],["しゅろ"],["に"],["向かって","むかって"],["、"],["人","ひと"],["の"],["顔","かお"],["が"],["あり"],["、"],["かなた"],["に"],["は"],["、"],["しゅろ"],["に"],["向かって","むかって"],["、"],["若","わか"],["じし"],["の"],["顔","かお"],["が"],["あり"],["、"],["宮","みや"],["の"],["周囲","しゅうい"],["は"],["、"],["すべて"],["この"],["よう"],["に"],["彫刻","ちょうこく"],["して"],["あった"],["。"]]},{"verse":20,"text":"床,ゆかから戸,との上,うえまで、ケルビムと、しゅろとが、壁,かべに彫刻,ちょうこくしてあった。","tok":[["床","ゆか"],["から"],["戸","と"],["の"],["上","うえ"],["まで"],["、"],["ケルビム"],["と"],["、"],["しゅろ"],["と"],["が"],["、"],["壁","かべ"],["に"],["彫刻","ちょうこく"],["して"],["あった"],["。"]]},{"verse":21,"text":"拝殿,はいでんの柱,ばしらは四角,かくであった。聖所,せいじょの前,まえには、木,きの祭壇,さいだんに似,にたものがあった。","tok":[["拝殿","はいでん"],["の"],["柱","ばしら"],["は"],["四角くで","かくで"],["あった"],["。"],["聖","せい"],["所","しょ"],["の"],["前","まえ"],["に"],["は"],["、"],["木","き"],["の"],["祭壇","さいだん"],["に"],["似た","にた"],["もの"],["が"],["あった"],["。"]]},{"verse":22,"text":"その高,たかさは三キュビト、長,ながさは二キュビト、幅,はばは二キュビトで、すみと、台,だいと、壁,かべとは、ともに木,きである。彼,かれはわたしに言,いった、「これは主,しゅの前,まえにある机,つくえである」","tok":[["その"],["高さ","たかさ"],["は"],["三","さん"],["キュビト"],["、"],["長さ","ながさ"],["は"],["二","に"],["キュビト"],["、"],["幅","はば"],["は"],["二","に"],["キュビト"],["で"],["、"],["すみ"],["と"],["、"],["台","だい"],["と"],["、"],["壁","かべ"],["と"],["は"],["、"],["とも"],["に"],["木","き"],["で"],["ある"],["。"],["彼","かれ"],["は"],["わたし"],["に"],["言った","いった"],["、"],["「"],["これ"],["は"],["主","しゅ"],["の"],["前","まえ"],["に"],["ある"],["机","つくえ"],["で"],["ある"],["」"]]},{"verse":23,"text":"拝殿,はいでんと聖所,せいじょとには、二つの戸,とがあり、","tok":[["拝殿","はいでん"],["と"],["聖","せい"],["所","しょ"],["に"],["は"],["、"],["二","ふた"],["つ"],["の"],["戸","と"],["が"],["あり"],["、"]]},{"verse":24,"text":"その戸,とには、二つのとびらがあった。すなわち二つの開,ひらき戸,どである。","tok":[["その"],["戸","と"],["に"],["は"],["、"],["二","ふた"],["つ"],["の"],["とびら"],["が"],["あった"],["。"],["すなわち"],["二","ふた"],["つ"],["の"],["開らき","ひらき"],["戸","ど"],["で"],["ある"],["。"]]},{"verse":25,"text":"拝殿,はいでんの戸,とには、おのおのにケルビムと、しゅろとが、彫刻,ちょうこくしてあって、それは壁,かべに彫刻,ちょうこくしたものと同,おなじである。また外,そとの廊,ろうに面,めんして、木,きの天蓋,てんがいがあり、","tok":[["拝殿","はいでん"],["の"],["戸","と"],["に"],["は"],["、"],["おのおの"],["に"],["ケルビム"],["と"],["、"],["しゅろ"],["と"],["が"],["、"],["彫刻","ちょうこく"],["して"],["あって"],["、"],["それ"],["は"],["壁","かべ"],["に"],["彫刻","ちょうこく"],["した"],["もの"],["と"],["同じ","おなじ"],["で"],["ある"],["。"],["また"],["外","そと"],["の"],["廊","ろう"],["に"],["面して","めんして"],["、"],["木","き"],["の"],["天蓋","てんがい"],["が"],["あり"],["、"]]},{"verse":26,"text":"廊,ろうの壁,かべには、こなたかなたに引込,ひっこみ窓,まどと、しゅろとがあった。","tok":[["廊","ろう"],["の"],["壁","かべ"],["に"],["は"],["、"],["こなた"],["かなた"],["に"],["引込み","ひっこみ"],["窓","まど"],["と"],["、"],["しゅろ"],["と"],["が"],["あった"],["。"]]}]
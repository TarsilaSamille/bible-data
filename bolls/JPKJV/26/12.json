[{"verse":1,"text":"主,しゅの言葉,ことばがわたしに臨,のぞんだ、","tok":[["主","しゅ"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":2,"text":"「人,ひとの子,こよ、あなたは反逆,はんぎゃくの家,いえの中,なかにいる。彼,かれらは見,みる目,めがあるが見,みず、聞,きく耳,みみがあるが聞,きかず、彼,かれらは反逆,はんぎゃくの家,いえである。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["あなた"],["は"],["反逆","はんぎゃく"],["の"],["家","いえ"],["の"],["中","なか"],["に"],["いる"],["。"],["彼","かれ"],["ら"],["は"],["見る","みる"],["目","め"],["が"],["ある"],["が"],["見ず","みず"],["、"],["聞く","きく"],["耳","みみ"],["が"],["ある"],["が"],["聞かず","きかず"],["、"],["彼","かれ"],["ら"],["は"],["反逆","はんぎゃく"],["の"],["家","いえ"],["で"],["ある"],["。"]]},{"verse":3,"text":"それゆえ、人,ひとの子,こよ、捕囚,ほしゅうの荷物,にもつを整,ととのえ、彼,かれらの目,めの前,まえで昼,ひるのうちに移,うつれ、彼,かれらの目,めの前,まえであなたの所,ところから他,たの所,ところに移,うつれ。彼,かれらは反逆,はんぎゃくの家,いえであるが、あるいは彼,かれらは顧,かえりみるところがあろう。","tok":[["それ"],["ゆえ"],["、"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["捕囚","ほしゅう"],["の"],["荷物","にもつ"],["を"],["整え","ととのえ"],["、"],["彼","かれ"],["ら"],["の"],["目","め"],["の"],["前","まえ"],["で"],["昼","ひる"],["の"],["うち"],["に"],["移れ","うつれ"],["、"],["彼","かれ"],["ら"],["の"],["目","め"],["の"],["前","まえ"],["で"],["あなた"],["の"],["所","ところ"],["から"],["他","た"],["の"],["所","ところ"],["に"],["移れ","うつれ"],["。"],["彼","かれ"],["ら"],["は"],["反逆","はんぎゃく"],["の"],["家","いえ"],["で"],["ある"],["が"],["、"],["あるいは"],["彼","かれ"],["ら"],["は"],["顧りみる","かえりみる"],["ところ"],["が"],["あろう"],["。"]]},{"verse":4,"text":"あなたは、捕囚,ほしゅうの荷物,にもつのようなあなたの荷物,にもつを、彼,かれらの目,めの前,まえで昼,ひるのうちに持,もち出,だせ。そして捕囚,ほしゅうに行,ゆくべき人々,ひとびとのように、彼,かれらの目,めの前,まえで夕,ゆうべのうちに出,でて行,いけ。","tok":[["あなた"],["は"],["、"],["捕囚","ほしゅう"],["の"],["荷物","にもつ"],["の"],["よう"],["な"],["あなた"],["の"],["荷物","にもつ"],["を"],["、"],["彼","かれ"],["ら"],["の"],["目","め"],["の"],["前","まえ"],["で"],["昼","ひる"],["の"],["うち"],["に"],["持出せ","もちだせ"],["。"],["そして"],["捕囚","ほしゅう"],["に"],["行くべき","ゆくべき"],["人々","ひとびと"],["の"],["よう"],["に"],["、"],["彼","かれ"],["ら"],["の"],["目","め"],["の"],["前","まえ"],["で"],["夕べ","ゆうべ"],["の"],["うち"],["に"],["出て","でて"],["行け","いけ"],["。"]]},{"verse":5,"text":"すなわち彼,かれらの目,めの前,まえで壁,かべに穴,あなをあけ、そこから出,でて行,いけ。","tok":[["すなわち"],["彼","かれ"],["ら"],["の"],["目","め"],["の"],["前","まえ"],["で"],["壁","かべ"],["に"],["穴","あな"],["を"],["あけ"],["、"],["そこ"],["から"],["出て","でて"],["行け","いけ"],["。"]]},{"verse":6,"text":"あなたは彼,かれらの目,めの前,まえでその荷物,にもつを肩,かたに負,おい、やみのうちにそれを運,はこび出,だせ。あなたの顔,かおをおおって地,ちを見,みるな。わたしはあなたをしるしとなして、イスラエルの家,いえに示,しめすのだ」。","tok":[["あなた"],["は"],["彼","かれ"],["ら"],["の"],["目","め"],["の"],["前","まえ"],["で"],["その"],["荷物","にもつ"],["を"],["肩","かた"],["に"],["負い","おい"],["、"],["やみ"],["の"],["うち"],["に"],["それ"],["を"],["運こび","はこび"],["出せ","だせ"],["。"],["あなた"],["の"],["顔","かお"],["を"],["おおって"],["地","ち"],["を"],["見る","みる"],["な"],["。"],["わたし"],["は"],["あなた"],["を"],["しるし"],["と"],["なして"],["、"],["イスラエル"],["の"],["家","いえ"],["に"],["示めす","しめす"],["の"],["だ"],["」"],["。"]]},{"verse":7,"text":"そこでわたしは命,めいじられたようにし、捕囚,ほしゅうの荷物,にもつのような荷物,にもつを昼,ひるのうちに持,もち出,だし、夕,ゆうべにはわたしの手,てで壁,かべに穴,あなをあけ、やみのうちに彼,かれらの目,めの前,まえで、これを肩,かたに負,おって運,はこび出,だした。","tok":[["そこ"],["で"],["わたし"],["は"],["命じられた","めいじられた"],["よう"],["に"],["し"],["、"],["捕囚","ほしゅう"],["の"],["荷物","にもつ"],["の"],["よう"],["な"],["荷物","にもつ"],["を"],["昼","ひる"],["の"],["うち"],["に"],["持出し","もちだし"],["、"],["夕べ","ゆうべ"],["に"],["は"],["わたし"],["の"],["手","て"],["で"],["壁","かべ"],["に"],["穴","あな"],["を"],["あけ"],["、"],["やみ"],["の"],["うち"],["に"],["彼","かれ"],["ら"],["の"],["目","め"],["の"],["前","まえ"],["で"],["、"],["これ"],["を"],["肩","かた"],["に"],["負って","おって"],["運こび","はこび"],["出した","だした"],["。"]]},{"verse":8,"text":"次,つぎの朝,あさ、主,しゅの言葉,ことばがわたしに臨,のぞんだ、","tok":[["次","つぎ"],["の"],["朝","あさ"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":9,"text":"「人,ひとの子,こよ、反逆,はんぎゃくの家,いえであるイスラエルの家,いえは、あなたに向,むかって、『何,なにをしているのか』と言,いわなかったか。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["反逆","はんぎゃく"],["の"],["家","いえ"],["で"],["ある"],["イスラエル"],["の"],["家","いえ"],["は"],["、"],["あなた"],["に"],["向かって","むかって"],["、"],["『"],["何に","なに"],["を"],["して"],["いる"],["の"],["か"],["』"],["と"],["言わなかった","いわなかった"],["か"],["。"]]},{"verse":10,"text":"あなたは彼,かれらに言,いいなさい、『主,しゅなる神,かみはこう言,いわれる、この託宣,たくせんはエルサレムの君,きみ、およびその中,なかにあるイスラエルの全家,ぜんかにかかわるものである』と。","tok":[["あなた"],["は"],["彼","かれ"],["ら"],["に"],["言い","いい"],["なさい"],["、"],["『"],["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["この"],["託宣","たくせん"],["は"],["エルサレム"],["の"],["君","きみ"],["、"],["および"],["その"],["中","なか"],["に"],["ある"],["イスラエル"],["の"],["全","ぜん"],["家","いえ"],["に"],["かかわる"],["もの"],["で"],["ある"],["』"],["と"],["。"]]},{"verse":11,"text":"また言,いいなさい、『わたしはあなたがたのしるしである。わたしがしたとおりに彼,かれらもされる。彼,かれらはとりこにされて移,うつされる』と。","tok":[["また"],["言い","いい"],["なさい"],["、"],["『"],["わたし"],["は"],["あなた"],["がた"],["の"],["しるし"],["で"],["ある"],["。"],["わたし"],["が"],["した"],["とおり"],["に"],["彼","かれ"],["ら"],["も"],["される"],["。"],["彼","かれ"],["ら"],["は"],["とりこ"],["に"],["されて"],["移される","うつされる"],["』"],["と"],["。"]]},{"verse":12,"text":"彼,かれらのうちの君,きみは、やみのうちにその荷物,にもつを肩,かたに載,のせて出,でて行,いく。彼,かれは壁,かべに穴,あなをあけて、そこから出,でて行,いく。彼,かれは顔,かおをおおって、自分,じぶんの目,めでこの地,ちを見,みない。","tok":[["彼","かれ"],["ら"],["の"],["うち"],["の"],["君","きみ"],["は"],["、"],["やみ"],["の"],["うち"],["に"],["その"],["荷物","にもつ"],["を"],["肩","かた"],["に"],["載せて","のせて"],["出て","でて"],["行く","いく"],["。"],["彼","かれ"],["は"],["壁","かべ"],["に"],["穴","あな"],["を"],["あけて"],["、"],["そこ"],["から"],["出て","でて"],["行く","いく"],["。"],["彼","かれ"],["は"],["顔","かお"],["を"],["おおって"],["、"],["自分","じぶん"],["の"],["目","め"],["で"],["この"],["地","ち"],["を"],["見ない","みない"],["。"]]},{"verse":13,"text":"わたしはわたしの網,あみを彼,かれの上,うえに打,うちかける。彼,かれはわたしのわなにかかる。わたしは彼,かれをカルデヤびとの地,ちのバビロンに引,ひいて行,いく。しかし彼,かれはそれを見,みないで、そこで死,しぬであろう。","tok":[["わたし"],["は"],["わたし"],["の"],["網","あみ"],["を"],["彼","かれ"],["の"],["上","うえ"],["に"],["打ち","うち"],["かける"],["。"],["彼","かれ"],["は"],["わたし"],["の"],["わな"],["に"],["かかる"],["。"],["わたし"],["は"],["彼","かれ"],["を"],["カルデヤ"],["びと"],["の"],["地","ち"],["の"],["バビロン"],["に"],["引いて","ひいて"],["行く","いく"],["。"],["しかし"],["彼","かれ"],["は"],["それ"],["を"],["見ないで","みないで"],["、"],["そこ"],["で"],["死ぬで","しぬで"],["あろう"],["。"]]},{"verse":14,"text":"またすべて彼,かれの周囲,しゅういにいて彼,かれを助,たすける者,ものおよび彼,かれの軍隊,ぐんたいを、わたしは四方,しほうに散,ちらし、つるぎを抜,ぬいてそのあとを追,おう。","tok":[["また"],["すべて"],["彼","かれ"],["の"],["周囲","しゅうい"],["に"],["いて"],["彼","かれ"],["を"],["助ける","たすける"],["者","もの"],["および"],["彼","かれ"],["の"],["軍隊","ぐんたい"],["を"],["、"],["わたし"],["は"],["四方","しほう"],["に"],["散らし","ちらし"],["、"],["つるぎ"],["を"],["抜いて","ぬいて"],["その"],["あと"],["を"],["追う","おう"],["。"]]},{"verse":15,"text":"わたしが彼,かれらを諸,しょ国民,こくみんの中,なかに散,ちらし、国々,くにぐににまき散,ちらすとき、彼,かれらはわたしが主,しゅであることを知,しる。","tok":[["わたし"],["が"],["彼","かれ"],["ら"],["を"],["諸","しょ"],["国民","こくみん"],["の"],["中","なか"],["に"],["散らし","ちらし"],["、"],["国々","くにぐに"],["に"],["まき散らす","まきちらす"],["とき"],["、"],["彼","かれ"],["ら"],["は"],["わたし"],["が"],["主","しゅ"],["で"],["ある"],["こと"],["を"],["知る","しる"],["。"]]},{"verse":16,"text":"ただし、わたしは彼,かれらのうちに、わずかの者,ものを残,のこして、つるぎと、ききんと、疫病,えきびょうを免,まぬかれさせ、彼,かれらがおこなったもろもろの憎,にくむべきことを、彼,かれらが行,ゆく国,くにびとの中,なかに告白,こくはくさせよう。そして彼,かれらはわたしが主,しゅであることを知,しるようになる」。","tok":[["ただし"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["うち"],["に"],["、"],["わずか"],["の"],["者","もの"],["を"],["残して","のこして"],["、"],["つるぎ"],["と"],["、"],["ききん"],["と"],["、"],["疫病","えきびょう"],["を"],["免かれさせ","まぬかれさせ"],["、"],["彼","かれ"],["ら"],["が"],["おこなった"],["もろもろ"],["の"],["憎むべき","にくむべき"],["こと"],["を"],["、"],["彼","かれ"],["ら"],["が"],["行く","ゆく"],["国びと","くにびと"],["の"],["中","なか"],["に"],["告白","こくはく"],["させよう"],["。"],["そして"],["彼","かれ"],["ら"],["は"],["わたし"],["が"],["主","しゅ"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["」"],["。"]]},{"verse":17,"text":"主,しゅの言葉,ことばがまたわたしに臨,のぞんだ、","tok":[["主","しゅ"],["の"],["言葉","ことば"],["が"],["また"],["わたし"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":18,"text":"「人,ひとの子,こよ、震,ふるえてあなたのパンを食,たべ、おののきと恐,おそれとをもって水,みずを飲,のめ。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["震えて","ふるえて"],["あなた"],["の"],["パン"],["を"],["食べ","たべ"],["、"],["おののき"],["と"],["恐","おそれ"],["と"],["を"],["もって"],["水","みず"],["を"],["飲め","のめ"],["。"]]},{"verse":19,"text":"そしてこの地,ちの民,たみについて言,いえ、主,しゅなる神,かみはイスラエルの地,ちのエルサレムの民,たみについてこう言,いわれる、彼,かれらは恐,おそれをもってそのパンを食,たべ、驚,おどろきをもってその水,みずを飲,のむようになる。これはその地,ちが、すべてその中,なかに住,すむ者,ものの暴虐,ぼうぎゃくのために衰,おとろえ、荒,あれ地,ちとなるからである。","tok":[["そして"],["この"],["地","ち"],["の"],["民","たみ"],["について"],["言え","いえ"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["イスラエル"],["の"],["地","ち"],["の"],["エルサレム"],["の"],["民","たみ"],["について"],["こう"],["言われる","いわれる"],["、"],["彼","かれ"],["ら"],["は"],["恐","おそれ"],["を"],["もって"],["その"],["パン"],["を"],["食べ","たべ"],["、"],["驚","おどろき"],["を"],["もって"],["その"],["水","みず"],["を"],["飲む","のむ"],["よう"],["に"],["なる"],["。"],["これ"],["は"],["その"],["地","ち"],["が"],["、"],["すべて"],["その"],["中","なか"],["に"],["住む","すむ"],["者","もの"],["の"],["暴虐","ぼうぎゃく"],["の"],["ため"],["に"],["衰え","おとろえ"],["、"],["荒れ地","あれち"],["と"],["なる"],["から"],["で"],["ある"],["。"]]},{"verse":20,"text":"人,ひとの住,すんでいた町々,まちまちは荒,あれはて、地,ちは荒塚,あらつかとなる。そしてあなたがたは、わたしが主,しゅであることを知,しるようになる」。","tok":[["人","ひと"],["の"],["住んで","すんで"],["いた"],["町々","まちまち"],["は"],["荒れはて","あれはて"],["、"],["地","ち"],["は"],["荒塚","あらつか"],["と"],["なる"],["。"],["そして"],["あなた"],["がた"],["は"],["、"],["わたし"],["が"],["主","しゅ"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["」"],["。"]]},{"verse":21,"text":"主,しゅの言葉,ことばがわたしに臨,のぞんだ、","tok":[["主","しゅ"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":22,"text":"「人,ひとの子,こよ、イスラエルの地,ちについて、あなたがたが『日,ひは延,のび、すべての幻,まぼろしはむなしくなった』という、このことわざはなんであるか。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["イスラエル"],["の"],["地","ち"],["について"],["、"],["あなた"],["がた"],["が"],["『"],["日","ひ"],["は"],["延び","のび"],["、"],["すべて"],["の"],["幻","まぼろし"],["は"],["むなしく"],["なった"],["』"],["と"],["いう"],["、"],["この"],["ことわざ"],["は"],["なん"],["で"],["ある"],["か"],["。"]]},{"verse":23,"text":"それゆえ、彼,かれらに言,いえ、『主,しゅなる神,かみはこう言,いわれる、わたしはこのことわざをやめさせ、彼,かれらが再,ふたたびイスラエルで、これをことわざとしないようにする』と。しかし、あなたは彼,かれらに言,いえ、『日,ひとすべての幻,まぼろしの実,み現,げんとは近,ちかづいた』と。","tok":[["それ"],["ゆえ"],["、"],["彼","かれ"],["ら"],["に"],["言え","いえ"],["、"],["『"],["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["わたし"],["は"],["この"],["ことわざ"],["を"],["やめさせ"],["、"],["彼","かれ"],["ら"],["が"],["再び","ふたたび"],["イスラエル"],["で"],["、"],["これ"],["を"],["ことわざ"],["と"],["しない"],["よう"],["に"],["する"],["』"],["と"],["。"],["しかし"],["、"],["あなた"],["は"],["彼","かれ"],["ら"],["に"],["言え","いえ"],["、"],["『"],["日","ひ"],["と"],["すべて"],["の"],["幻","まぼろし"],["の"],["実現","みげん"],["と"],["は"],["近づいた","ちかづいた"],["』"],["と"],["。"]]},{"verse":24,"text":"イスラエルの家,いえのうちには、もはやむなしい幻,まぼろしも、偽,いつわりの占,うらないもなくなる。","tok":[["イスラエル"],["の"],["家","いえ"],["の"],["うち"],["に"],["は"],["、"],["もはや"],["むなしい"],["幻","まぼろし"],["も"],["、"],["偽わり","いつわり"],["の"],["占","うらない"],["も"],["なくなる"],["。"]]},{"verse":25,"text":"しかし主,しゅなるわたしは、わが語,かたるべきことを語,かたり、それは必,かならず成就,じょうじゅする。決,けっして延,のびることはない。ああ、反逆,はんぎゃくの家,いえよ、あなたの日,ひにわたしはこれを語,かたり、これを成就,じょうじゅすると、主,しゅなる神,かみは言,いわれる」。","tok":[["しかし"],["主","しゅ"],["なる"],["わたし"],["は"],["、"],["わが"],["語るべき","かたるべき"],["こと"],["を"],["語り","かたり"],["、"],["それ"],["は"],["必","かならず"],["成就","じょうじゅ"],["する"],["。"],["決っして","けっして"],["延びる","のびる"],["こと"],["は"],["ない"],["。"],["ああ"],["、"],["反逆","はんぎゃく"],["の"],["家","いえ"],["よ"],["、"],["あなた"],["の"],["日","ひ"],["に"],["わたし"],["は"],["これ"],["を"],["語り","かたり"],["、"],["これ"],["を"],["成就","じょうじゅ"],["する"],["と"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["」"],["。"]]},{"verse":26,"text":"主,しゅの言葉,ことばがまたわたしに臨,のぞんだ、","tok":[["主","しゅ"],["の"],["言葉","ことば"],["が"],["また"],["わたし"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":27,"text":"「人,ひとの子,こよ、見,みよ、イスラエルの家,いえは言,いう、『彼,かれの見,みる幻,まぼろしは、なお多,おおくの日,ひの後,のちの事,ことである。彼,かれが預言,よげんすることは遠,とおい後,のちの時,ときのことである』と。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["見よ","みよ"],["、"],["イスラエル"],["の"],["家","いえ"],["は"],["言う","いう"],["、"],["『"],["彼","かれ"],["の"],["見る","みる"],["幻","まぼろし"],["は"],["、"],["なお"],["多く","おおく"],["の"],["日","ひ"],["の"],["後","のち"],["の"],["事","こと"],["で"],["ある"],["。"],["彼","かれ"],["が"],["預言","よげん"],["する"],["こと"],["は"],["遠い","とおい"],["後","のち"],["の"],["時","とき"],["の"],["こと"],["で"],["ある"],["』"],["と"],["。"]]},{"verse":28,"text":"それゆえ、彼,かれらに言,いえ、主,しゅなる神,かみはこう言,いわれる、わたしの言葉,ことばはもはや延,のびない。わたしの語,かたる言葉,ことばは成就,じょうじゅすると、主,しゅなる神,かみは言,いわれる」。","tok":[["それ"],["ゆえ"],["、"],["彼","かれ"],["ら"],["に"],["言え","いえ"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["わたし"],["の"],["言葉","ことば"],["は"],["もはや"],["延びない","のびない"],["。"],["わたし"],["の"],["語る","かたる"],["言葉","ことば"],["は"],["成就","じょうじゅ"],["する"],["と"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["」"],["。"]]}]
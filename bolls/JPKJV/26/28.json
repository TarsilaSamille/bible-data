[{"verse":1,"text":"主,しゅの言葉,ことばがわたしに臨,のぞんだ、","tok":[["主","しゅ"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":2,"text":"「人,ひとの子,こよ、ツロの君,きみに言,いえ、主,しゅなる神,かみはこう言,いわれる、あなたは心,こころに高,たかぶって言,いう、『わたしは神,かみである、神々,かみがみの座,ざにすわって、海,うみの中,なかにいる』と。しかし、あなたは自分,じぶんを神,かみのように賢,かしこいと思,おもっても、人,ひとであって、神,かみではない。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["ツロ"],["の"],["君","きみ"],["に"],["言え","いえ"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["あなた"],["は"],["心","こころ"],["に"],["高か","たか"],["ぶっ"],["て"],["言う","いう"],["、"],["『"],["わたし"],["は"],["神","かみ"],["で"],["ある"],["、"],["神々","かみがみ"],["の"],["座","ざ"],["に"],["すわって"],["、"],["海","うみ"],["の"],["中","なか"],["に"],["いる"],["』"],["と"],["。"],["しかし"],["、"],["あなた"],["は"],["自分","じぶん"],["を"],["神","かみ"],["の"],["よう"],["に"],["賢しこい","かしこい"],["と"],["思って","おもって"],["も"],["、"],["人","ひと"],["で"],["あって"],["、"],["神","かみ"],["で"],["は"],["ない"],["。"]]},{"verse":3,"text":"見,みよ、あなたはダニエルよりも賢,かしこく、すべての秘密,ひみつもあなたには隠,かくれていない。","tok":[["見よ","みよ"],["、"],["あなた"],["は"],["ダニエル"],["より"],["も"],["賢しこく","かしこく"],["、"],["すべて"],["の"],["秘密","ひみつ"],["も"],["あなた"],["に"],["は"],["隠れて","かくれて"],["いない"],["。"]]},{"verse":4,"text":"あなたは知恵,ちえと悟,さとりとによって富,とみを得,え、金銀,きんぎんを倉,くらにたくわえた。","tok":[["あなた"],["は"],["知恵","ちえ"],["と"],["悟り","さとり"],["と"],["によって"],["富","とみ"],["を"],["得","え"],["、"],["金銀","きんぎん"],["を"],["倉","くら"],["に"],["たくわえた"],["。"]]},{"verse":5,"text":"あなたは大,おおいなる貿易,ぼうえきの知恵,ちえによってあなたの富,とみを増,まし、その富,とみによってあなたの心,こころは高,たかぶった。","tok":[["あなた"],["は"],["大いなる","おおいなる"],["貿易","ぼうえき"],["の"],["知恵","ちえ"],["によって"],["あなた"],["の"],["富","とみ"],["を"],["増し","まし"],["、"],["その"],["富","とみ"],["によって"],["あなた"],["の"],["心","こころ"],["は"],["高か","たか"],["ぶっ"],["た"],["。"]]},{"verse":6,"text":"それゆえ、主,しゅなる神,かみはこう言,いわれる、あなたは自分,じぶんを神,かみのように賢,かしこいと思,おもっているゆえ、","tok":[["それ"],["ゆえ"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["あなた"],["は"],["自分","じぶん"],["を"],["神","かみ"],["の"],["よう"],["に"],["賢しこい","かしこい"],["と"],["思って","おもって"],["いる"],["ゆえ"],["、"]]},{"verse":7,"text":"見,みよ、わたしは、もろもろの国民,こくみんの最,もっとも恐,おそれている異邦人,いほうじんをあなたに攻,せめこさせる。彼,かれらはつるぎを抜,ぬいて、あなたが知恵,ちえをもって得,えた麗,うるわしいものに向,むかい、あなたの輝,かがやきを汚,けがし、","tok":[["見よ","みよ"],["、"],["わたし"],["は"],["、"],["もろもろ"],["の"],["国民","こくみん"],["の"],["最も","もっとも"],["恐れて","おそれて"],["いる"],["異邦人","いほうじん"],["を"],["あなた"],["に"],["攻め","せめ"],["こさせる"],["。"],["彼","かれ"],["ら"],["は"],["つるぎ"],["を"],["抜いて","ぬいて"],["、"],["あなた"],["が"],["知恵","ちえ"],["を"],["もって"],["得た","えた"],["麗わしい","うるわしい"],["もの"],["に"],["向","むかい"],["、"],["あなた"],["の"],["輝やき","かがやき"],["を"],["汚","け"],["がし"],["、"]]},{"verse":8,"text":"あなたを穴,あなに投,なげ入,いれる。あなたは海,うみの中,なかで殺,ころされた者,もののような死,しを遂,とげる。","tok":[["あなた"],["を"],["穴","あな"],["に"],["投入れる","なげいれる"],["。"],["あなた"],["は"],["海","うみ"],["の"],["中","なか"],["で"],["殺ろされた","ころされた"],["者","もの"],["の"],["よう"],["な"],["死","し"],["を"],["遂げる","とげる"],["。"]]},{"verse":9,"text":"それでもなおあなたは、『自分,じぶんは神,かみである』と、あなたを殺,ころす人々,ひとびとの前,まえで言,いうことができるか。あなたは自分,じぶんを傷,きずつける者,ものの手,てにかかっては、人,ひとであって、神,かみではないではないか。","tok":[["それ"],["で"],["も"],["なお"],["あなた"],["は"],["、"],["『"],["自分","じぶん"],["は"],["神","かみ"],["で"],["ある"],["』"],["と"],["、"],["あなた"],["を"],["殺ろす","ころす"],["人々","ひとびと"],["の"],["前","まえ"],["で"],["言う","いう"],["こと"],["が"],["できる"],["か"],["。"],["あなた"],["は"],["自分","じぶん"],["を"],["傷つける","きずつける"],["者","もの"],["の"],["手","て"],["に"],["かかって"],["は"],["、"],["人","ひと"],["で"],["あって"],["、"],["神","かみ"],["で"],["は"],["ないで"],["は"],["ない"],["か"],["。"]]},{"verse":10,"text":"あなたは異邦人,いほうじんの手,てによって割礼,かつれいを受,うけない者,ものの死,しを遂,とげる。これはわたしが言,いうのであると、主,しゅなる神,かみは言,いわれる」。","tok":[["あなた"],["は"],["異邦人","いほうじん"],["の"],["手","て"],["によって"],["割礼","かつれい"],["を"],["受ない","うけない"],["者","もの"],["の"],["死","し"],["を"],["遂げる","とげる"],["。"],["これ"],["は"],["わたし"],["が"],["言う","いう"],["ので"],["ある"],["と"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["」"],["。"]]},{"verse":11,"text":"また主,しゅの言葉,ことばがわたしに臨,のぞんだ、","tok":[["また"],["主","しゅ"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":12,"text":"「人,ひとの子,こよ、ツロの王,おうのために悲,かなしみの歌,うたをのべて、これに言,いえ。主,しゅなる神,かみはこう言,いわれる、あなたは知恵,ちえに満,みち、美,びのきわみである完全,かんぜんな印,しるしである。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["ツロ"],["の"],["王","おう"],["の"],["ため"],["に"],["悲しみ","かなしみ"],["の"],["歌","うた"],["を"],["のべて"],["、"],["これ"],["に"],["言え","いえ"],["。"],["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["あなた"],["は"],["知恵","ちえ"],["に"],["満ち","みち"],["、"],["美","び"],["の"],["きわみ"],["で"],["ある"],["完全","かんぜん"],["な"],["印","しるし"],["で"],["ある"],["。"]]},{"verse":13,"text":"あなたは神,かみの園,そのエデンにあって、もろもろの宝石,ほうせきが、あなたをおおっていた。すなわち赤,あかめのう、黄玉,おうぎょく、青玉,せいぎょく、貴,きかんらん石,いし、緑柱石,りょくちゅうせき、縞,しまめのう、サファイヤ、ざくろ石,いし、エメラルド。そしてあなたの象眼,ぞうがんも彫刻,ちょうこくも金,きんでなされた。これらはあなたの造,つくられた日,ひに、あなたのために備,そなえられた。","tok":[["あなた"],["は"],["神","かみ"],["の"],["園","その"],["エデン"],["に"],["あって"],["、"],["もろもろ"],["の"],["宝石","ほうせき"],["が"],["、"],["あなた"],["を"],["おおって"],["いた"],["。"],["すなわち"],["赤め","あかめ"],["のう"],["、"],["黄玉","おうぎょく"],["、"],["青玉","せいぎょく"],["、"],["貴","き"],["かんらん"],["石","いし"],["、"],["緑柱石","りょくちゅうせき"],["、"],["縞","しま"],["めのう"],["、"],["サファイヤ"],["、"],["ざくろ石","ざくろいし"],["、"],["エメラルド"],["。"],["そして"],["あなた"],["の"],["象眼","ぞうがん"],["も"],["彫刻","ちょうこく"],["も"],["金","きん"],["で"],["なされた"],["。"],["これ"],["ら"],["は"],["あなた"],["の"],["造られた","つくられた"],["日","ひ"],["に"],["、"],["あなた"],["の"],["ため"],["に"],["備","そなえ"],["られた"],["。"]]},{"verse":14,"text":"わたしはあなたを油,あぶらそそがれた守護,しゅごのケルブと一緒,いっしょに置,おいた。あなたは神,かみの聖,せいなる山,やまにいて、火,ひの石,いしの間,あいだを歩,あるいた。","tok":[["わたし"],["は"],["あなた"],["を"],["油","あぶら"],["そそがれた"],["守護","しゅご"],["の"],["ケルブ"],["と"],["一緒","いっしょ"],["に"],["置いた","おいた"],["。"],["あなた"],["は"],["神","かみ"],["の"],["聖","せい"],["なる"],["山","やま"],["に"],["いて"],["、"],["火","ひ"],["の"],["石","いし"],["の"],["間","あいだ"],["を"],["歩いた","あるいた"],["。"]]},{"verse":15,"text":"あなたは造,つくられた日,ひから、あなたの中,なかに悪,あくが見,みいだされた日,ひまではそのおこないが完全,かんぜんであった。","tok":[["あなた"],["は"],["造られた","つくられた"],["日","ひ"],["から"],["、"],["あなた"],["の"],["中","なか"],["に"],["悪","あく"],["が"],["見いだされた","みいだされた"],["日","ひ"],["まで"],["は"],["その"],["おこない"],["が"],["完全","かんぜん"],["で"],["あった"],["。"]]},{"verse":16,"text":"あなたの商売,しょうばいが盛,さかんになると、あなたの中,なかに暴虐,ぼうぎゃくが満,みちて、あなたは罪,つみを犯,おかした。それゆえ、わたしはあなたを神,かみの山,やまから汚,けがれたものとして投,なげ出,だし、守護,しゅごのケルブはあなたを火,ひの石,いしの間,あいだから追,おい出,だした。","tok":[["あなた"],["の"],["商売","しょうばい"],["が"],["盛","さかん"],["に"],["なる"],["と"],["、"],["あなた"],["の"],["中","なか"],["に"],["暴虐","ぼうぎゃく"],["が"],["満ちて","みちて"],["、"],["あなた"],["は"],["罪","つみ"],["を"],["犯した","おかした"],["。"],["それ"],["ゆえ"],["、"],["わたし"],["は"],["あなた"],["を"],["神","かみ"],["の"],["山","やま"],["から"],["汚","けがれたも"],["の"],["として"],["投出し","なげだし"],["、"],["守護","しゅご"],["の"],["ケルブ"],["は"],["あなた"],["を"],["火","ひ"],["の"],["石","いし"],["の"],["間","あいだ"],["から"],["追い出した","おいだした"],["。"]]},{"verse":17,"text":"あなたは自分,じぶんの美,うつくしさのために心,こころ高,たかぶり、その輝,かがやきのために自分,じぶんの知恵,ちえを汚,けがしたゆえに、わたしはあなたを地,ちに投,なげうち、王,おうたちの前,まえに置,おいて見,みせ物,ものとした。","tok":[["あなた"],["は"],["自分","じぶん"],["の"],["美し","うつくし"],["さ"],["の"],["ため"],["に"],["心","こころ"],["高か","たか"],["ぶり"],["、"],["その"],["輝やき","かがやき"],["の"],["ため"],["に"],["自分","じぶん"],["の"],["知恵","ちえ"],["を"],["汚","け"],["がした"],["ゆえ"],["に"],["、"],["わたし"],["は"],["あなた"],["を"],["地","ち"],["に"],["投","なげ"],["うち"],["、"],["王","おう"],["たち"],["の"],["前","まえ"],["に"],["置いて","おいて"],["見せ物","みせもの"],["と"],["した"],["。"]]},{"verse":18,"text":"あなたは不正,ふせいな交易,こうえきをして犯,おかした多,おおくの罪,つみによってあなたの聖所,せいじょを汚,けがしたゆえ、わたしはあなたの中,なかから火,ひを出,だしてあなたを焼,やき、あなたを見,みるすべての者,ものの前,まえであなたを地,ちの上,うえの灰,はいとした。","tok":[["あなた"],["は"],["不正","ふせい"],["な"],["交易","こうえき"],["を"],["して"],["犯した","おかした"],["多く","おおく"],["の"],["罪","つみ"],["によって"],["あなた"],["の"],["聖","せい"],["所","しょ"],["を"],["汚","け"],["がした"],["ゆえ"],["、"],["わたし"],["は"],["あなた"],["の"],["中","なか"],["から"],["火","ひ"],["を"],["出して","だして"],["あなた"],["を"],["焼き","やき"],["、"],["あなた"],["を"],["見る","みる"],["すべて"],["の"],["者","もの"],["の"],["前","まえ"],["で"],["あなた"],["を"],["地","ち"],["の"],["上","うえ"],["の"],["灰","はい"],["と"],["した"],["。"]]},{"verse":19,"text":"もろもろの民,たみのうちであなたを知,しる者,ものは皆,みなあなたについて驚,おどろく。あなたは恐,おそるべき終,おわりを遂,とげ、永遠,えいえんにうせはてる」。","tok":[["もろもろ"],["の"],["民","たみ"],["の"],["うち"],["で"],["あなた"],["を"],["知る","しる"],["者","もの"],["は"],["皆","みな"],["あなた"],["について"],["驚ろく","おどろく"],["。"],["あなた"],["は"],["恐るべき","おそるべき"],["終","おわり"],["を"],["遂げ","とげ"],["、"],["永遠","えいえん"],["に"],["うせ"],["はてる"],["」"],["。"]]},{"verse":20,"text":"主,しゅの言葉,ことばがわたしに臨,のぞんだ、","tok":[["主","しゅ"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":21,"text":"「人,ひとの子,こよ、あなたの顔,かおをシドンに向,むけ、これに向,むかって預言,よげんして、","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["あなた"],["の"],["顔","かお"],["を"],["シドン"],["に"],["向け","むけ"],["、"],["これ"],["に"],["向かって","むかって"],["預言","よげん"],["して"],["、"]]},{"verse":22,"text":"言,いえ。主,しゅなる神,かみはこう言,いわれる、シドンよ、見,みよ、わたしはあなたの敵,てきとなる、わたしはあなたのうちで栄,さかえをあらわす。わたしがシドンのうちにさばきをおこない、そのうちにわたしの聖,せいなることをあらわす時,とき、彼,かれらはわたしが主,しゅであることを知,しる。","tok":[["言え","いえ"],["。"],["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["シドン"],["よ"],["、"],["見よ","みよ"],["、"],["わたし"],["は"],["あなた"],["の"],["敵","てき"],["と"],["なる"],["、"],["わたし"],["は"],["あなた"],["の"],["うち"],["で"],["栄","さかえ"],["を"],["あらわす"],["。"],["わたし"],["が"],["シドン"],["の"],["うち"],["に"],["さばき"],["を"],["おこない"],["、"],["その"],["うち"],["に"],["わたし"],["の"],["聖","せい"],["なる"],["こと"],["を"],["あらわす"],["時","とき"],["、"],["彼","かれ"],["ら"],["は"],["わたし"],["が"],["主","しゅ"],["で"],["ある"],["こと"],["を"],["知る","しる"],["。"]]},{"verse":23,"text":"わたしは疫病,えきびょうをこれに送,おくり、そのちまたに流血,りゅうけつを送,おくる。その四方,しほうからこれに臨,のぞむつるぎによって殺,ころされる者,ものがその中,なかに倒,たおれる時,とき、彼,かれらはわたしが主,しゅであることを知,しる。","tok":[["わたし"],["は"],["疫病","えきびょう"],["を"],["これ"],["に"],["送り","おくり"],["、"],["その"],["ちまた"],["に"],["流血","りゅうけつ"],["を"],["送る","おくる"],["。"],["その"],["四方","しほう"],["から"],["これ"],["に"],["臨む","のぞむ"],["つるぎ"],["によって"],["殺ろされる","ころされる"],["者","もの"],["が"],["その"],["中","なか"],["に"],["倒れる","たおれる"],["時","とき"],["、"],["彼","かれ"],["ら"],["は"],["わたし"],["が"],["主","しゅ"],["で"],["ある"],["こと"],["を"],["知る","しる"],["。"]]},{"verse":24,"text":"イスラエルの家,いえには、もはや刺,さすいばらはなく、これを卑,いやしめたその周囲,しゅういの人々,ひとびとのうちには、苦,くるしめるとげもなくなる。こうして彼,かれらはわたしが主,しゅであることを知,しるようになる。","tok":[["イスラエル"],["の"],["家","いえ"],["に"],["は"],["、"],["もはや"],["刺す","さす"],["いばら"],["は"],["なく"],["、"],["これ"],["を"],["卑しめた","いやしめた"],["その"],["周囲","しゅうい"],["の"],["人々","ひとびと"],["の"],["うち"],["に"],["は"],["、"],["苦しめる","くるしめる"],["とげ"],["も"],["なくなる"],["。"],["こう"],["して"],["彼","かれ"],["ら"],["は"],["わたし"],["が"],["主","しゅ"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"]]},{"verse":25,"text":"主,しゅなる神,かみはこう言,いわれる、わたしがイスラエルの家,いえの者,ものを、その散,ちらされたもろもろの民,たみの中,なかから集,あつめ、もろもろの国民,こくみんの目,めの前,まえで、彼,かれらにわたしの聖,せいなることをあらわす時,とき、彼,かれらはわたしが、わがしもべヤコブに与,あたえた地,ちに住,すむようになる。","tok":[["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["わたし"],["が"],["イスラエル"],["の"],["家","いえ"],["の"],["者","もの"],["を"],["、"],["その"],["散らされた","ちらされた"],["もろもろ"],["の"],["民","たみ"],["の"],["中","なか"],["から"],["集め","あつめ"],["、"],["もろもろ"],["の"],["国民","こくみん"],["の"],["目","め"],["の"],["前","まえ"],["で"],["、"],["彼","かれ"],["ら"],["に"],["わたし"],["の"],["聖","せい"],["なる"],["こと"],["を"],["あらわす"],["時","とき"],["、"],["彼","かれ"],["ら"],["は"],["わたし"],["が"],["、"],["わが"],["しもべ"],["ヤコブ"],["に"],["与","あたえ"],["た"],["地","ち"],["に"],["住む","すむ"],["よう"],["に"],["なる"],["。"]]},{"verse":26,"text":"彼,かれらはそこに安,やすらかに住,すみ、家,いえを建,たて、またぶどう畑,はたけを作,つくる。かつて彼,かれらを卑,いやしめたすべての隣,となり人,びとたちに対,たいして、わたしがさばきを行,おこなう時,とき、彼,かれらは安,やすらかに住,すむ。こうして彼,かれらは、わたしが彼,かれらの神,かみ、主,しゅであることを知,しる」。","tok":[["彼","かれ"],["ら"],["は"],["そこ"],["に"],["安らか","やすらか"],["に"],["住み","すみ"],["、"],["家","いえ"],["を"],["建て","たて"],["、"],["また"],["ぶどう"],["畑","はたけ"],["を"],["作る","つくる"],["。"],["かつて"],["彼","かれ"],["ら"],["を"],["卑しめた","いやしめた"],["すべて"],["の"],["隣人","となりびとたち"],["に対して","にたいして"],["、"],["わたし"],["が"],["さばき"],["を"],["行なう","おこなう"],["時","とき"],["、"],["彼","かれ"],["ら"],["は"],["安らか","やすらか"],["に"],["住む","すむ"],["。"],["こう"],["して"],["彼","かれ"],["ら"],["は"],["、"],["わたし"],["が"],["彼","かれ"],["ら"],["の"],["神","かみ"],["、"],["主","しゅ"],["で"],["ある"],["こと"],["を"],["知る","しる"],["」"],["。"]]}]
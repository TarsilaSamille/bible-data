[{"verse":1,"text":"第,だい十二年,ねんの十二月,がつ一日,にちに、主,しゅの言葉,ことばがわたしに臨,のぞんだ、","tok":[["第","だい"],["十二","じゅうに"],["年","ねん"],["の"],["十二","じゅうに"],["月","がつ"],["つ"],["一","いち"],["日","にち"],["に"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":2,"text":"「人,ひとの子,こよ、エジプトの王,おうパロのために、悲,かなしみの歌,うたをのべて、これに言,いえ、あなたは自分,じぶんをもろもろの国民,こくみんのうちのししであると考,かんがえているが、あなたは海,うみの中,なかの龍,りゅうのような者,ものである。あなたは川,かわの中,なかに、はね起,おき、足,あしで水,みずをかきまぜ、川,かわを濁,にごす。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["エジプト"],["の"],["王","おう"],["パロ"],["の"],["ため"],["に"],["、"],["悲しみ","かなしみ"],["の"],["歌","うた"],["を"],["のべて"],["、"],["これ"],["に"],["言え","いえ"],["、"],["あなた"],["は"],["自分","じぶん"],["を"],["もろもろ"],["の"],["国民","こくみん"],["の"],["うち"],["の"],["しし"],["で"],["ある"],["と"],["考","かんがえ"],["て"],["いる"],["が"],["、"],["あなた"],["は"],["海","うみ"],["の"],["中","なか"],["の"],["龍","りゅう"],["の"],["よう"],["な"],["者","もの"],["で"],["ある"],["。"],["あなた"],["は"],["川","かわ"],["の"],["中","なか"],["に"],["、"],["はね起き","はねおき"],["、"],["足","あし"],["で"],["水","みず"],["を"],["かきまぜ"],["、"],["川","かわ"],["を"],["濁す","にごす"],["。"]]},{"verse":3,"text":"主,しゅなる神,かみはこう言,いわれる、わたしは多,おおくの民,たみの集団,しゅうだんをもって、わたしの網,あみをあなたに投,なげかけ、あなたを網,あみで引,ひきあげる。","tok":[["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["わたし"],["は"],["多く","おおく"],["の"],["民","たみ"],["の"],["集団","しゅうだん"],["を"],["もって"],["、"],["わたし"],["の"],["網","あみ"],["を"],["あなた"],["に"],["投","なげ"],["かけ"],["、"],["あなた"],["を"],["網","あみ"],["で"],["引","ひき"],["あげる"],["。"]]},{"verse":4,"text":"わたしはあなたを地,ちに投,なげ捨,すて、野,のの面,めんに投,なげうち、空,そらのすべての鳥,とりをあなたの上,うえにとまらせ、全,ぜん地,ちの獣,けものにあなたを与,あたえて飽,あかせる。","tok":[["わたし"],["は"],["あなた"],["を"],["地","ち"],["に"],["投捨て","なげすて"],["、"],["野","の"],["の"],["面","めん"],["に"],["投","なげ"],["うち"],["、"],["空","そら"],["の"],["すべて"],["の"],["鳥","とり"],["を"],["あなた"],["の"],["上","うえ"],["に"],["とまらせ"],["、"],["全地","ぜんち"],["の"],["獣","けもの"],["に"],["あなた"],["を"],["与","あたえ"],["て"],["飽かせる","あかせる"],["。"]]},{"verse":5,"text":"わたしはあなたの肉,にくを山々,やまやまに捨,すて、あなたの死体,したいで谷,たにを満,みたす。","tok":[["わたし"],["は"],["あなた"],["の"],["肉","にく"],["を"],["山々","やまやま"],["に"],["捨て","すて"],["、"],["あなた"],["の"],["死体","したい"],["で"],["谷","たに"],["を"],["満たす","みたす"],["。"]]},{"verse":6,"text":"わたしはあなたの流,ながれる血,ちで、地,ちを潤,うるおし、山々,やまやまにまで及,およぼす。谷川,たにがわはあなたの死体,したいで満,みちる。","tok":[["わたし"],["は"],["あなた"],["の"],["流れる","ながれる"],["血","ち"],["で"],["、"],["地","ち"],["を"],["潤おし","うるおし"],["、"],["山々","やまやま"],["に"],["まで"],["及ぼす","およぼす"],["。"],["谷川","たにがわ"],["は"],["あなた"],["の"],["死体","したい"],["で"],["満ちる","みちる"],["。"]]},{"verse":7,"text":"わたしはあなたを滅,ほろぼす時,とき、空,そらをおおい、星,ほしを暗,くらくし、雲,くもで日,ひをおおい、月,つきに光,ひかりを放,はなたせない。","tok":[["わたし"],["は"],["あなた"],["を"],["滅ぼす","ほろぼす"],["時","とき"],["、"],["空","そら"],["を"],["おおい"],["、"],["星","ほし"],["を"],["暗く","くらく"],["し"],["、"],["雲","くも"],["で"],["日","ひ"],["を"],["おおい"],["、"],["月","つき"],["に"],["光","ひかり"],["を"],["放たせない","はなたせない"],["。"]]},{"verse":8,"text":"わたしは空,そらの輝,かがやく光,ひかりを、ことごとくあなたの上,うえに暗,くらくし、あなたの国,くにをやみとすると主,しゅなる神,かみは言,いう。","tok":[["わたし"],["は"],["空","そら"],["の"],["輝やく","かがやく"],["光","ひかり"],["を"],["、"],["ことごとく"],["あなた"],["の"],["上","うえ"],["に"],["暗く","くらく"],["し"],["、"],["あなた"],["の"],["国","くに"],["を"],["やみ"],["と"],["する"],["と"],["主","しゅ"],["なる"],["神","かみ"],["は"],["言う","いう"],["。"]]},{"verse":9,"text":"わたしはもろもろの国民,こくみん、あなたの知,しらない国々,くにぐにの中,なかに、あなたを捕,とらえ移,うつす時,とき、多,おおくの民,たみの心,こころを痛,いたませる。","tok":[["わたし"],["は"],["もろもろ"],["の"],["国民","こくみん"],["、"],["あなた"],["の"],["知らない","しらない"],["国々","くにぐに"],["の"],["中","なか"],["に"],["、"],["あなた"],["を"],["捕らえ","とらえ"],["移す","うつす"],["時","とき"],["、"],["多く","おおく"],["の"],["民","たみ"],["の"],["心","こころ"],["を"],["痛ませる","いたませる"],["。"]]},{"verse":10,"text":"わたしはあなたについて、多,おおくの民,たみを驚,おどろかせる。その王,おうたちは、わたしがわたしのつるぎを、彼,かれらの前,まえに振,ふるう時,とき、あなたの事,ことでおののく。あなたの倒,たおれる日,ひには、彼,かれらはおのおの自分,じぶんの命,いのちを思,おもって、絶,たえず打,うち震,ふるえる。","tok":[["わたし"],["は"],["あなた"],["について"],["、"],["多く","おおく"],["の"],["民","たみ"],["を"],["驚ろかせる","おどろかせる"],["。"],["その"],["王","おう"],["たち"],["は"],["、"],["わたし"],["が"],["わたし"],["の"],["つるぎ"],["を"],["、"],["彼","かれ"],["ら"],["の"],["前","まえ"],["に"],["振るう","ふるう"],["時","とき"],["、"],["あなた"],["の"],["事","こと"],["で"],["おののく"],["。"],["あなた"],["の"],["倒れる","たおれる"],["日","ひ"],["に"],["は"],["、"],["彼","かれ"],["ら"],["は"],["おのおの"],["自分","じぶん"],["の"],["命","いのち"],["を"],["思って","おもって"],["、"],["絶えず","たえず"],["打ち震える","うちふるえる"],["。"]]},{"verse":11,"text":"主,しゅなる神,かみはこう言,いわれる、バビロンの王,おうのつるぎはあなたに臨,のぞむ。","tok":[["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["バビロン"],["の"],["王","おう"],["の"],["つるぎ"],["は"],["あなた"],["に"],["臨む","のぞむ"],["。"]]},{"verse":12,"text":"わたしはあなたの民衆,みんしゅうを勇士,ゆうしのつるぎに倒,たおれさせる。彼,かれらは皆,みな、もろもろの国民,こくみんの中,なかで、最,もっとも恐,おそれられている者,ものたちである。彼,かれらはエジプトの誇,ほこりを断,たつ、エジプトの民衆,みんしゅうは皆,みな滅,ほろぼされる。","tok":[["わたし"],["は"],["あなた"],["の"],["民衆","みんしゅう"],["を"],["勇士","ゆうし"],["の"],["つるぎ"],["に"],["倒れさせる","たおれさせる"],["。"],["彼","かれ"],["ら"],["は"],["皆","みな"],["、"],["もろもろ"],["の"],["国民","こくみん"],["の"],["中","なか"],["で"],["、"],["最も","もっとも"],["恐られて","おそれられて"],["いる"],["者","もの"],["たち"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["エジプト"],["の"],["誇","ほこり"],["を"],["断つ","たつ"],["、"],["エジプト"],["の"],["民衆","みんしゅう"],["は"],["皆","みな"],["滅ぼされる","ほろぼされる"],["。"]]},{"verse":13,"text":"わたしはその家畜,かちくをことごとく、多,おおくの水,みずのかたわらから滅,ほろぼす。人,ひとの足,あしは再,ふたたびこれを濁,にごさず、家畜,かちくのひずめもこれを乱,みださない。","tok":[["わたし"],["は"],["その"],["家畜","かちく"],["を"],["ことごとく"],["、"],["多く","おおく"],["の"],["水","みず"],["の"],["かたわら"],["から"],["滅ぼす","ほろぼす"],["。"],["人","ひと"],["の"],["足","あし"],["は"],["再び","ふたたび"],["これ"],["を"],["濁さず","にごさず"],["、"],["家畜","かちく"],["の"],["ひずめ"],["も"],["これ"],["を"],["乱さない","みださない"],["。"]]},{"verse":14,"text":"その時,ときわたしはその水,みずを清,きよくし、その川,かわ々を油,あぶらのように流,ながれさせると、主,しゅなる神,かみは言,いう。","tok":[["その"],["時","とき"],["わたし"],["は"],["その"],["水","みず"],["を"],["清く","きよく"],["し"],["、"],["その"],["川","かわ"],["々"],["を"],["油","あぶら"],["の"],["よう"],["に"],["流れさせる","ながれさせる"],["と"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["言う","いう"],["。"]]},{"verse":15,"text":"わたしはエジプトの国,くにを荒,あらし、その国,くにに満,みちるものが、ことごとく取,とり去,さられる時,とき、わたしがその中,なかに住,すむ者,ものをことごとく撃,うつ時,とき、彼,かれらはわたしが主,しゅであることを知,しる。","tok":[["わたし"],["は"],["エジプト"],["の"],["国","くに"],["を"],["荒し","あらし"],["、"],["その"],["国","くに"],["に"],["満ちる","みちる"],["もの"],["が"],["、"],["ことごとく"],["取去られる","とりさられる"],["時","とき"],["、"],["わたし"],["が"],["その"],["中","なか"],["に"],["住む","すむ"],["者","もの"],["を"],["ことごとく"],["撃つ","うつ"],["時","とき"],["、"],["彼","かれ"],["ら"],["は"],["わたし"],["が"],["主","しゅ"],["で"],["ある"],["こと"],["を"],["知る","しる"],["。"]]},{"verse":16,"text":"これは悲,かなしみの歌,うたである。人々,ひとびとはこれを歌,うたい、もろもろの国,くにの娘,むすめたちはこれを歌,うたう。すなわちエジプトと、そのすべての民衆,みんしゅうとのために、これを歌,うたうのであると、主,しゅなる神,かみは言,いわれる」。","tok":[["これ"],["は"],["悲しみ","かなしみ"],["の"],["歌","うた"],["で"],["ある"],["。"],["人々","ひとびと"],["は"],["これ"],["を"],["歌い","うたい"],["、"],["もろもろ"],["の"],["国","くに"],["の"],["娘","むすめ"],["たち"],["は"],["これ"],["を"],["歌う","うたう"],["。"],["すなわち"],["エジプト"],["と"],["、"],["その"],["すべて"],["の"],["民衆","みんしゅう"],["と"],["の"],["ため"],["に"],["、"],["これ"],["を"],["歌う","うたう"],["ので"],["ある"],["と"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["」"],["。"]]},{"verse":17,"text":"第,だい十二年,ねんの一月,がつ十五日,にちに、主,しゅの言葉,ことばがわたしに臨,のぞんだ、","tok":[["第","だい"],["十二","じゅうに"],["年","ねん"],["の"],["一","いち"],["月","がつ"],["つ"],["十五","じゅうご"],["日","にち"],["に"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":18,"text":"「人,ひとの子,こよ、エジプトの民衆,みんしゅうのために嘆,なげき、これと大,おおいなる国々,くにぐにの娘,むすめらとを、下,したの国,くにに投,なげ下,くだし、穴,あなに下,くだった者,もののところに至,いたらせよ。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["エジプト"],["の"],["民衆","みんしゅう"],["の"],["ため"],["に"],["嘆き","なげき"],["、"],["これ"],["と"],["大いなる","おおいなる"],["国々","くにぐに"],["の"],["娘","むすめ"],["ら"],["と"],["を"],["、"],["下","した"],["の"],["国","くに"],["に"],["投下","なげく"],["だ"],["し"],["、"],["穴","あな"],["に"],["下った","くだった"],["者","もの"],["の"],["ところ"],["に"],["至らせ","いたらせ"],["よ"],["。"]]},{"verse":19,"text":"『あなたの美,びはだれにまさっているか。下,くだって、割礼,かつれいを受,うけない者,ものと共,ともに伏,ふせよ』。","tok":[["『"],["あなた"],["の"],["美","び"],["は"],["だれ"],["に"],["まさって"],["いる"],["か"],["。"],["下って","くだって"],["、"],["割礼","かつれい"],["を"],["受ない","うけない"],["者","もの"],["と"],["共","とも"],["に"],["伏せよ","ふせよ"],["』"],["。"]]},{"verse":20,"text":"彼,かれらはつるぎに殺,ころされる者,もののうちに倒,たおれる。その民衆,みんしゅうはこれと共,ともに伏,ふせる。","tok":[["彼","かれ"],["ら"],["は"],["つるぎ"],["に"],["殺ろされる","ころされる"],["者","もの"],["の"],["うち"],["に"],["倒れる","たおれる"],["。"],["その"],["民衆","みんしゅう"],["は"],["これ"],["と"],["共","とも"],["に"],["伏せる","ふせる"],["。"]]},{"verse":21,"text":"勇士,ゆうしの首領,しゅりょうはその助,たすけ手,てと共,ともに、陰府,よみの中,なかから彼,かれらに言,いう、『割礼,かつれいを受,うけない者,もの、つるぎに殺,ころされた者,ものは下,くだって伏,ふしている』と。","tok":[["勇士","ゆうし"],["の"],["首領","しゅりょう"],["は"],["その"],["助け手","たすけて"],["と"],["共","とも"],["に"],["、"],["陰府","よみ"],["の"],["中","なか"],["から"],["彼","かれ"],["ら"],["に"],["言う","いう"],["、"],["『"],["割礼","かつれい"],["を"],["受ない","うけない"],["者","もの"],["、"],["つるぎ"],["に"],["殺ろされた","ころされた"],["者","もの"],["は"],["下って","くだって"],["伏して","ふして"],["いる"],["』"],["と"],["。"]]},{"verse":22,"text":"アッスリヤとその仲間,なかまとはその所,ところにおり、その墓,はかはこれを囲,かこむ。彼,かれらはみな殺,ころされた者,もの、またつるぎに倒,たおれた者,ものである。","tok":[["アッスリヤ"],["と"],["その"],["仲間","なかま"],["と"],["は"],["その"],["所","ところ"],["に"],["おり"],["、"],["その"],["墓","はか"],["は"],["これ"],["を"],["囲む","かこむ"],["。"],["彼","かれ"],["ら"],["は"],["みな"],["殺ろされた","ころされた"],["者","もの"],["、"],["また"],["つるぎ"],["に"],["倒れた","たおれた"],["者","もの"],["で"],["ある"],["。"]]},{"verse":23,"text":"彼,かれらの墓,はかは穴,あなの奥,おくに設,もうけられ、その仲間,なかまはその墓,はかの周囲,しゅういにあり、これはみな殺,ころされた者,もの、つるぎに倒,たおれた者,もの、生,いける者,ものの地,ちに恐,おそれを起,おこした者,ものである。","tok":[["彼","かれ"],["ら"],["の"],["墓","はか"],["は"],["穴","あな"],["の"],["奥","おく"],["に"],["設けられ","もうけられ"],["、"],["その"],["仲間","なかま"],["は"],["その"],["墓","はか"],["の"],["周囲","しゅうい"],["に"],["あり"],["、"],["これ"],["は"],["みな"],["殺ろされた","ころされた"],["者","もの"],["、"],["つるぎ"],["に"],["倒れた","たおれた"],["者","もの"],["、"],["生ける","いける"],["者","もの"],["の"],["地","ち"],["に"],["恐","おそれ"],["を"],["起こした","おこした"],["者","もの"],["で"],["ある"],["。"]]},{"verse":24,"text":"その所,ところにエラムがおり、その民衆,みんしゅうは皆,みな、その墓,はかの周囲,しゅういにおる。彼,かれらはみな殺,ころされた者,もの、つるぎに倒,たおれた者,もの、割礼,かつれいを受,うけないで、下,したの国,くにに下,くだった者,もの、生,いける者,ものの地,ちに、恐,おそれを起,おこした者,もので、穴,あなに下,くだる者,ものと共,ともに、恥,はじを負,おうのである。","tok":[["その"],["所","ところ"],["に"],["エラム"],["が"],["おり"],["、"],["その"],["民衆","みんしゅう"],["は"],["皆","みな"],["、"],["その"],["墓","はか"],["の"],["周囲","しゅうい"],["に"],["おる"],["。"],["彼","かれ"],["ら"],["は"],["みな"],["殺ろされた","ころされた"],["者","もの"],["、"],["つるぎ"],["に"],["倒れた","たおれた"],["者","もの"],["、"],["割礼","かつれい"],["を"],["受ないで","うけないで"],["、"],["下","した"],["の"],["国","くに"],["に"],["下った","くだった"],["者","もの"],["、"],["生ける","いける"],["者","もの"],["の"],["地","ち"],["に"],["、"],["恐","おそれ"],["を"],["起こした","おこした"],["者","もの"],["で"],["、"],["穴","あな"],["に"],["下る","くだる"],["者","もの"],["と"],["共","とも"],["に"],["、"],["恥","はじ"],["を"],["負う","おう"],["ので"],["ある"],["。"]]},{"verse":25,"text":"彼,かれらはそのすべての民衆,みんしゅうと共,ともに、殺,ころされた者,ものの中,なかに床,とこを置,おき、その墓,はかはこれを囲,かこむ。これは皆,みな、割礼,かつれいを受,うけない者,もの、つるぎに殺,ころされた者,もの、生,いける者,ものの地,ちに恐,おそれを起,おこした者,もので、穴,あなに下,くだる者,ものと共,ともに恥,はじを負,おう。彼,かれらは殺,ころされた者,ものの中,なかに置,おかれている。","tok":[["彼","かれ"],["ら"],["は"],["その"],["すべて"],["の"],["民衆","みんしゅう"],["と"],["共","とも"],["に"],["、"],["殺ろされた","ころされた"],["者","もの"],["の"],["中","なか"],["に"],["床","とこ"],["を"],["置き","おき"],["、"],["その"],["墓","はか"],["は"],["これ"],["を"],["囲む","かこむ"],["。"],["これ"],["は"],["皆","みな"],["、"],["割礼","かつれい"],["を"],["受ない","うけない"],["者","もの"],["、"],["つるぎ"],["に"],["殺ろされた","ころされた"],["者","もの"],["、"],["生ける","いける"],["者","もの"],["の"],["地","ち"],["に"],["恐","おそれ"],["を"],["起こした","おこした"],["者","もの"],["で"],["、"],["穴","あな"],["に"],["下る","くだる"],["者","もの"],["と"],["共","とも"],["に"],["恥","はじ"],["を"],["負う","おう"],["。"],["彼","かれ"],["ら"],["は"],["殺ろされた","ころされた"],["者","もの"],["の"],["中","なか"],["に"],["置かれて","おかれて"],["いる"],["。"]]},{"verse":26,"text":"その所,ところにメセクとトバル、およびすべての民衆,みんしゅうがおる。その墓,はかはこれを囲,かこむ。彼,かれらは皆,みな、割礼,かつれいを受,うけない者,もので、つるぎで殺,ころされた者,ものである。生,いける者,ものの地,ちに恐,おそれを起,おこしたからである。","tok":[["その"],["所","ところ"],["に"],["メセク"],["と"],["トバル"],["、"],["および"],["すべて"],["の"],["民衆","みんしゅう"],["が"],["おる"],["。"],["その"],["墓","はか"],["は"],["これ"],["を"],["囲む","かこむ"],["。"],["彼","かれ"],["ら"],["は"],["皆","みな"],["、"],["割礼","かつれい"],["を"],["受ない","うけない"],["者","もの"],["で"],["、"],["つるぎ"],["で"],["殺ろされた","ころされた"],["者","もの"],["で"],["ある"],["。"],["生ける","いける"],["者","もの"],["の"],["地","ち"],["に"],["恐","おそれ"],["を"],["起こした","おこした"],["から"],["で"],["ある"],["。"]]},{"verse":27,"text":"彼,かれらは昔,むかしの倒,たおれた勇士,ゆうしと共,ともに伏,ふさない。これらの勇士,ゆうしは、武具,ぶぐを持,もって陰府,よみに下,くだり、つるぎをまくらとし、その盾,たては骨,ほねの上,うえにある。これは勇士,ゆうしの恐,おそれが、生,いける者,ものの地,ちにあったからである。","tok":[["彼","かれ"],["ら"],["は"],["昔","むかし"],["の"],["倒れた","たおれた"],["勇士","ゆうし"],["と"],["共","とも"],["に"],["伏さない","ふさない"],["。"],["これ"],["ら"],["の"],["勇士","ゆうし"],["は"],["、"],["武具","ぶぐ"],["を"],["持って","もって"],["陰府","よみ"],["に"],["下り","くだり"],["、"],["つるぎ"],["を"],["まくら"],["と"],["し"],["、"],["その"],["盾","たて"],["は"],["骨","ほね"],["の"],["上","うえ"],["に"],["ある"],["。"],["これ"],["は"],["勇士","ゆうし"],["の"],["恐","おそれ"],["が"],["、"],["生ける","いける"],["者","もの"],["の"],["地","ち"],["に"],["あった"],["から"],["で"],["ある"],["。"]]},{"verse":28,"text":"あなたは割礼,かつれいを受,うけない者,もののうちに、つるぎで殺,ころされた者,ものと共,ともに横,よこたわる。","tok":[["あなた"],["は"],["割礼","かつれい"],["を"],["受ない","うけない"],["者","もの"],["の"],["うち"],["に"],["、"],["つるぎ"],["で"],["殺ろされた","ころされた"],["者","もの"],["と"],["共","とも"],["に"],["横たわる","よこたわる"],["。"]]},{"verse":29,"text":"その所,ところにエドムとその王,おうたちと、そのすべての君,きみたちがおる。彼,かれらはその力,ちからを持,もつにもかかわらず、かのつるぎで殺,ころされた者,ものと共,ともに横,よこたえられ、割礼,かつれいを受,うけない者,ものおよび穴,あなに下,くだる者,ものと共,ともに伏,ふしている。","tok":[["その"],["所","ところ"],["に"],["エドム"],["と"],["その"],["王","おう"],["たち"],["と"],["、"],["その"],["すべて"],["の"],["君","きみ"],["たち"],["が"],["おる"],["。"],["彼","かれ"],["ら"],["は"],["その"],["力","ちから"],["を"],["持つ","もつ"],["に"],["も"],["かかわらず"],["、"],["かの"],["つるぎ"],["で"],["殺ろされた","ころされた"],["者","もの"],["と"],["共","とも"],["に"],["横たえられ","よこたえられ"],["、"],["割礼","かつれい"],["を"],["受ない","うけない"],["者","もの"],["および"],["穴","あな"],["に"],["下る","くだる"],["者","もの"],["と"],["共","とも"],["に"],["伏して","ふして"],["いる"],["。"]]},{"verse":30,"text":"その所,ところに北,きたの君,きみたち、およびシドンびとが皆,みなおる。彼,かれらは自分,じぶんの力,ちからによって恐,おそれを起,おこしたので、殺,ころされた者,ものと共,ともに恥,はじを受,うけて、下,くだって行,いった者,ものである。彼,かれらはつるぎで殺,ころされた者,ものと共,ともに、割礼,かつれいを受,うけずに伏,ふし、穴,あなに下,くだる者,ものと共,ともに恥,はじを負,おう。","tok":[["その"],["所","ところ"],["に"],["北","きた"],["の"],["君","きみ"],["たち"],["、"],["および"],["シドン"],["びと"],["が"],["皆","みな"],["おる"],["。"],["彼","かれ"],["ら"],["は"],["自分","じぶん"],["の"],["力","ちから"],["によって"],["恐","おそれ"],["を"],["起こした","おこした"],["ので"],["、"],["殺ろされた","ころされた"],["者","もの"],["と"],["共","とも"],["に"],["恥","はじ"],["を"],["受て","うけて"],["、"],["下って","くだって"],["行った","いった"],["者","もの"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["つるぎ"],["で"],["殺ろされた","ころされた"],["者","もの"],["と"],["共","とも"],["に"],["、"],["割礼","かつれい"],["を"],["受ず","うけず"],["に"],["伏し","ふし"],["、"],["穴","あな"],["に"],["下る","くだる"],["者","もの"],["と"],["共","とも"],["に"],["恥","はじ"],["を"],["負う","おう"],["。"]]},{"verse":31,"text":"パロは彼,かれらを見,みる時,とき、そのすべての民衆,みんしゅうについて慰,なぐさめられる。パロとそのすべての軍勢,ぐんぜいとは、つるぎで殺,ころされると、主,しゅなる神,かみは言,いわれる。","tok":[["パロ"],["は"],["彼","かれ"],["ら"],["を"],["見る","みる"],["時","とき"],["、"],["その"],["すべて"],["の"],["民衆","みんしゅう"],["について"],["慰さめられる","なぐさめられる"],["。"],["パロ"],["と"],["その"],["すべて"],["の"],["軍勢","ぐんぜい"],["と"],["は"],["、"],["つるぎ"],["で"],["殺ろされる","ころされる"],["と"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"]]},{"verse":32,"text":"彼,かれは生,いける者,ものの国,くにに恐,おそれを広,ひろげた。それゆえ、パロとすべての民衆,みんしゅうとは、割礼,かつれいを受,うけない者,もののうちにあって、つるぎで殺,ころされた者,ものと共,ともに伏,ふすと、主,しゅなる神,かみは言,いわれる」。","tok":[["彼","かれ"],["は"],["生ける","いける"],["者","もの"],["の"],["国","くに"],["に"],["恐","おそれ"],["を"],["広げた","ひろげた"],["。"],["それ"],["ゆえ"],["、"],["パロ"],["と"],["すべて"],["の"],["民衆","みんしゅう"],["と"],["は"],["、"],["割礼","かつれい"],["を"],["受ない","うけない"],["者","もの"],["の"],["うち"],["に"],["あって"],["、"],["つるぎ"],["で"],["殺ろされた","ころされた"],["者","もの"],["と"],["共","とも"],["に"],["伏す","ふす"],["と"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["」"],["。"]]}]
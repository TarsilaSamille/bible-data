[{"verse":1,"text":"主,しゅの言葉,ことばが再,ふたたびわたしに臨,のぞんだ、","tok":[["主","しゅ"],["の"],["言葉","ことば"],["が"],["再び","ふたたび"],["わたし"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":2,"text":"「人,ひとの子,こよ、エルサレムにその憎,にくむべき事,ことどもを示,しめして、","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["エルサレム"],["に"],["その"],["憎むべき","にくむべき"],["事","こと"],["ども"],["を"],["示めして","しめして"],["、"]]},{"verse":3,"text":"言,いえ。主,しゅなる神,かみはエルサレムにこう言,いわれる、あなたの起,おこり、あなたの生,うまれはカナンびとの地,ちである。あなたの父,ちちはアモリびと、あなたの母,はははヘテびとである。","tok":[["言え","いえ"],["。"],["主","しゅ"],["なる"],["神","かみ"],["は"],["エルサレム"],["に"],["こう"],["言われる","いわれる"],["、"],["あなた"],["の"],["起こり","おこり"],["、"],["あなた"],["の"],["生まれ","うまれ"],["は"],["カナン"],["びと"],["の"],["地","ち"],["で"],["ある"],["。"],["あなた"],["の"],["父","ちち"],["は"],["アモリ"],["び"],["と"],["、"],["あなた"],["の"],["母","はは"],["は"],["ヘテ"],["びと"],["で"],["ある"],["。"]]},{"verse":4,"text":"あなたの生,うまれについていえば、その生,うまれた日,ひに、へその緒,おは切,きられず、水,みずで洗,あらい清,きよめられず、塩,しおでこすられず、また布,ぬので包,つつまれなかった。","tok":[["あなた"],["の"],["生まれ","うまれ"],["について"],["いえば"],["、"],["その"],["生まれた","うまれた"],["日","ひ"],["に"],["、"],["へその緒","へそのお"],["は"],["切られず","きられず"],["、"],["水","みず"],["で"],["洗","あらい"],["清められず","きよめられず"],["、"],["塩","しお"],["で"],["こすられず"],["、"],["また"],["布","ぬの"],["で"],["包まれなかった","つつまれなかった"],["。"]]},{"verse":5,"text":"ひとりもあなたをあわれみ見,みる者,ものなく、情,じょうをもってこれらのことの一つをも、あなたにしてやる者,ものもなく、あなたの生,うまれた日,ひに、あなたはきらわれて、野原,のはらに捨,すてられた。","tok":[["ひとり"],["も"],["あなた"],["を"],["あわれみ"],["見る","みる"],["者","もの"],["なく"],["、"],["情","じょう"],["を"],["もって"],["これ"],["ら"],["の"],["こと"],["の"],["一","ひと"],["つ"],["を"],["も"],["、"],["あなた"],["に"],["して"],["やる"],["者","もの"],["も"],["なく"],["、"],["あなた"],["の"],["生まれた","うまれた"],["日","ひ"],["に"],["、"],["あなた"],["は"],["きらわれて"],["、"],["野原","のはら"],["に"],["捨てられた","すてられた"],["。"]]},{"verse":6,"text":"わたしはあなたのかたわらを通,とおり、あなたが血,ちの中,なかにころがりまわっているのを見,みた時,とき、わたしは血,ちの中,なかにいるあなたに言,いった、『生,いきよ、","tok":[["わたし"],["は"],["あなた"],["の"],["かたわら"],["を"],["通り","とおり"],["、"],["あなた"],["が"],["血","ち"],["の"],["中","なか"],["に"],["ころがり"],["まわって"],["いる"],["の"],["を"],["見た","みた"],["時","とき"],["、"],["わたし"],["は"],["血","ち"],["の"],["中","なか"],["に"],["いる"],["あなた"],["に"],["言った","いった"],["、"],["『"],["生きよ","いきよ"],["、"]]},{"verse":7,"text":"野,のの木,きのように育,そだて』と。すなわちあなたは成長,せいちょうして大,おおきくなり、一人前,いちにんまえの女,おんなになり、その乳,ちぶさは形,かたちが整,ととのい、髪,かみは長,ながくなったが、着物,きものがなく、裸,はだかであった。","tok":[["野","の"],["の"],["木","き"],["の"],["よう"],["に"],["育て","そだて"],["』"],["と"],["。"],["すなわち"],["あなた"],["は"],["成長","せいちょう"],["して"],["大きく","おおきく"],["なり"],["、"],["一人前","いちにんまえ"],["の"],["女","おんな"],["に"],["なり"],["、"],["その"],["乳ぶさ","ちぶさ"],["は"],["形","かたち"],["が"],["整い","ととのい"],["、"],["髪","かみ"],["は"],["長く","ながく"],["なった"],["が"],["、"],["着物","きもの"],["が"],["なく"],["、"],["裸","はだか"],["で"],["あった"],["。"]]},{"verse":8,"text":"わたしは再,ふたたびあなたのかたわらをとおって、あなたを見,みたが、見,みよ、あなたは愛,あいせられる年齢,ねんれいに達,たっしていたので、わたしは着物,きもののすそであなたをおおい、あなたの裸,はだかをかくし、そしてあなたに誓,ちかい、あなたと契約,けいやくを結,むすんだ。そしてあなたはわたしのものとなったと、主,しゅなる神,かみは言,いわれる。","tok":[["わたし"],["は"],["再び","ふたたび"],["あなた"],["の"],["かたわら"],["を"],["とおって"],["、"],["あなた"],["を"],["見た","みた"],["が"],["、"],["見よ","みよ"],["、"],["あなた"],["は"],["愛せられる","あいせられる"],["年齢","ねんれい"],["に"],["達して","たっして"],["いた"],["ので"],["、"],["わたし"],["は"],["着物","きもの"],["の"],["すそ"],["で"],["あなた"],["を"],["おおい"],["、"],["あなた"],["の"],["裸","はだか"],["を"],["かくし"],["、"],["そして"],["あなた"],["に"],["誓い","ちかい"],["、"],["あなた"],["と"],["契約","けいやく"],["を"],["結んだ","むすんだ"],["。"],["そして"],["あなた"],["は"],["わたし"],["の"],["もの"],["と"],["なった"],["と"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"]]},{"verse":9,"text":"そこでわたしは水,みずであなたを洗,あらい、あなたの血,ちを洗,あらい落,おとして油,あぶらを塗,ぬり、","tok":[["そこ"],["で"],["わたし"],["は"],["水","みず"],["で"],["あなた"],["を"],["洗","あらい"],["、"],["あなた"],["の"],["血","ち"],["を"],["洗","あらい"],["落として","おとして"],["油","あぶら"],["を"],["塗","ぬり"],["、"]]},{"verse":10,"text":"縫,ぬい取,とりした着物,きものを着,きせ、皮,かわのくつをはかせ、細,ほそ布,ぬのをかぶらせ、絹,きぬのきれであなたをおおった。","tok":[["縫","ぬい"],["取","とり"],["した"],["着物","きもの"],["を"],["着せ","きせ"],["、"],["皮","かわ"],["の"],["くつ"],["を"],["はかせ"],["、"],["細布","ほそぬの"],["を"],["かぶらせ"],["、"],["絹","きぬ"],["の"],["きれ"],["で"],["あなた"],["を"],["おおった"],["。"]]},{"verse":11,"text":"また飾,かざり物,ものであなたを飾,かざり、腕輪,うでわをあなたの手,てにはめ、鎖,くさりをあなたの首,くびにかけ、","tok":[["また"],["飾","かざり"],["物","もの"],["で"],["あなた"],["を"],["飾","かざり"],["、"],["腕輪","うでわ"],["を"],["あなた"],["の"],["手","て"],["に"],["はめ"],["、"],["鎖","くさり"],["を"],["あなた"],["の"],["首","くび"],["に"],["かけ"],["、"]]},{"verse":12,"text":"鼻,はなには鼻輪,はなわ、耳,みみには耳輪,みみわ、頭,あたまには美,うつくしい冠,かんむりを与,あたえた。","tok":[["鼻","はな"],["に"],["は"],["鼻輪","はなわ"],["、"],["耳","みみ"],["に"],["は"],["耳輪","みみわ"],["、"],["頭","あたま"],["に"],["は"],["美しい","うつくしい"],["冠","かんむり"],["を"],["与","あたえ"],["た"],["。"]]},{"verse":13,"text":"このようにあなたは金銀,きんぎんで飾,かざられ、細,ほそ布,ぬの、絹,きぬ、縫,ぬい取,とりの服,ふくをあなたの衣,ころもとし、麦粉,むぎこと、蜜,みつと、油,あぶらとを食,たべた。あなたは非常,ひじょうに美,うつくしくなって王,おうの地位,ちいに進,すすみ、","tok":[["この"],["よう"],["に"],["あなた"],["は"],["金銀","きんぎん"],["で"],["飾られ","かざられ"],["、"],["細布","ほそぬの"],["、"],["絹","きぬ"],["、"],["縫","ぬい"],["取","とり"],["の"],["服","ふく"],["を"],["あなた"],["の"],["衣","ころも"],["と"],["し"],["、"],["麦粉","むぎこ"],["と"],["、"],["蜜","みつ"],["と"],["、"],["油","あぶら"],["と"],["を"],["食べた","たべた"],["。"],["あなた"],["は"],["非常","ひじょう"],["に"],["美しく","うつくしく"],["なって"],["王","おう"],["の"],["地位","ちい"],["に"],["進み","すすみ"],["、"]]},{"verse":14,"text":"あなたの美,うつくしさのために、あなたの名声,めいせいは国々,くにぐにに広,ひろまった。これはわたしが、あなたに施,ほどこした飾,かざりによって全,まっとうされたからであると、主,しゅなる神,かみは言,いわれる。","tok":[["あなた"],["の"],["美し","うつくし"],["さ"],["の"],["ため"],["に"],["、"],["あなた"],["の"],["名声","めいせい"],["は"],["国々","くにぐに"],["に"],["広まった","ひろまった"],["。"],["これ"],["は"],["わたし"],["が"],["、"],["あなた"],["に"],["施した","ほどこした"],["飾","かざり"],["によって"],["全う","まっとう"],["された"],["から"],["で"],["ある"],["と"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"]]},{"verse":15,"text":"ところが、あなたは自分,じぶんの美,うつくしさをたのみ、自分,じぶんの名声,めいせいによって姦淫,かんいんを行,おこない、すべてかたわらを通,とおる者,ものと、ほしいままに姦淫,かんいんを行,おこなった。","tok":[["ところ"],["が"],["、"],["あなた"],["は"],["自分","じぶん"],["の"],["美し","うつくし"],["さ"],["を"],["たのみ"],["、"],["自分","じぶん"],["の"],["名声","めいせい"],["によって"],["姦淫","かんいん"],["を"],["行ない","おこない"],["、"],["すべて"],["かたわら"],["を"],["通る","とおる"],["者","もの"],["と"],["、"],["ほしいまま"],["に"],["姦淫","かんいん"],["を"],["行なった","おこなった"],["。"]]},{"verse":16,"text":"あなたは自分,じぶんの衣,ころもをとって、自分,じぶんのために、はなやかに色,いろどった聖所,せいじょを造,つくり、その上,うえで姦淫,かんいんを行,おこなっている。こんなことはかつてなかったこと、またあってはならないことである。","tok":[["あなた"],["は"],["自分","じぶん"],["の"],["衣","ころも"],["を"],["とって"],["、"],["自分","じぶん"],["の"],["ため"],["に"],["、"],["はなやか"],["に"],["色","いろ"],["どった"],["聖所","せいじょ"],["を"],["造","つくり"],["、"],["その"],["上","うえ"],["で"],["姦淫","かんいん"],["を"],["行なって","おこなって"],["いる"],["。"],["こんな"],["こと"],["は"],["かつて"],["なかった"],["こと"],["、"],["また"],["あって"],["は"],["ならない"],["こと"],["で"],["ある"],["。"]]},{"verse":17,"text":"あなたはわたしが与,あたえた金銀,きんぎんの美,うつくしい飾,かざりの品,しなをとり、自分,じぶんのために男,おとこの像,ぞうを造,つくって、これと姦淫,かんいんを行,おこなった。","tok":[["あなた"],["は"],["わたし"],["が"],["与","あたえ"],["た"],["金銀","きんぎん"],["の"],["美しい","うつくしい"],["飾","かざり"],["の"],["品","しな"],["を"],["とり"],["、"],["自分","じぶん"],["の"],["ため"],["に"],["男","おとこ"],["の"],["像","ぞう"],["を"],["造って","つくって"],["、"],["これ"],["と"],["姦淫","かんいん"],["を"],["行なった","おこなった"],["。"]]},{"verse":18,"text":"また縫,ぬい取,とりのある自分,じぶんの衣,ころもをとって彼,かれらに着,きせ、わたしの油,あぶらと香,こうとをその前,まえに供,そなえ、","tok":[["また"],["縫","ぬい"],["取","とり"],["の"],["ある"],["自分","じぶん"],["の"],["衣","ころも"],["を"],["とって"],["彼","かれ"],["ら"],["に"],["着せ","きせ"],["、"],["わたし"],["の"],["油","あぶら"],["と"],["香","こう"],["と"],["を"],["その"],["前","まえ"],["に"],["供え","そなえ"],["、"]]},{"verse":19,"text":"またわたしがあなたに与,あたえたパン、わたしがあなたを養,やしなうための麦粉,むぎこ、油,あぶらおよび蜜,みつを、こうばしきかおりとして彼,かれらの前,まえに供,そなえたと、主,しゅなる神,かみは言,いわれる。","tok":[["また"],["わたし"],["が"],["あなた"],["に"],["与","あたえ"],["た"],["パン"],["、"],["わたし"],["が"],["あなた"],["を"],["養う","やしなう"],["ため"],["の"],["麦粉","むぎこ"],["、"],["油","あぶら"],["および"],["蜜","みつ"],["を"],["、"],["こう"],["ば"],["しき"],["かおり"],["として"],["彼","かれ"],["ら"],["の"],["前","まえ"],["に"],["供えた","そなえた"],["と"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"]]},{"verse":20,"text":"あなたはまた、あなたがわたしに産,うんだむすこ、娘,むすめたちをとって、その像,ぞうに供,そなえ、彼,かれらに食,くわせた。このようなあなたの姦淫,かんいんは小,ちいさい事,ことであろうか。","tok":[["あなた"],["は"],["また"],["、"],["あなた"],["が"],["わたし"],["に"],["産んだ","うんだ"],["むすこ"],["、"],["娘","むすめ"],["たち"],["を"],["とって"],["、"],["その"],["像","ぞう"],["に"],["供え","そなえ"],["、"],["彼","かれ"],["ら"],["に"],["食わせた","くわせた"],["。"],["この"],["よう"],["な"],["あなた"],["の"],["姦淫","かんいん"],["は"],["小さい","ちいさい"],["事","こと"],["で"],["あろう"],["か"],["。"]]},{"verse":21,"text":"あなたはわたしの子,こどもを殺,ころし、火,ひの中,なかを通,とおらせて彼,かれらにささげた。","tok":[["あなた"],["は"],["わたし"],["の"],["子ども","こども"],["を"],["殺ろし","ころし"],["、"],["火","ひ"],["の"],["中","なか"],["を"],["通らせて","とおらせて"],["彼","かれ"],["ら"],["に"],["ささげた"],["。"]]},{"verse":22,"text":"あなたがそのすべての憎,にくむべきことや姦淫,かんいんを行,おこなうに当,あたって、あなたが衣,ころももなく、裸,はだかで、血,ちの中,なかにころがりまわっていた自分,じぶんの若,わかき日,ひのことを思,おもわなかった。","tok":[["あなた"],["が"],["その"],["すべて"],["の"],["憎むべき","にくむべき"],["こと"],["や"],["姦淫","かんいん"],["を"],["行なう","おこなう"],["に"],["当たって","あたって"],["、"],["あなた"],["が"],["衣","ころも"],["も"],["なく"],["、"],["裸","はだか"],["で"],["、"],["血","ち"],["の"],["中","なか"],["に"],["ころがり"],["まわって"],["いた"],["自分","じぶん"],["の"],["若き","わかき"],["日","ひ"],["の"],["こと"],["を"],["思わなかった","おもわなかった"],["。"]]},{"verse":23,"text":"あなたがもろもろの悪,あくを行,おこなった後,のち、（あなたはわざわいだ、わざわいだと、主,しゅなる神,かみは言,いわれる）","tok":[["あなた"],["が"],["もろもろ"],["の"],["悪","あく"],["を"],["行なった","おこなった"],["後","の"],["ち"],["、"],["（"],["あなた"],["は"],["わざわい"],["だ"],["、"],["わざわい"],["だ"],["と"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["）"]]},{"verse":24,"text":"あなたは自分,じぶんのために高楼,こうろうを建,たて、広場,ひろば、広場,ひろばに台,だいを造,つくり、","tok":[["あなた"],["は"],["自分","じぶん"],["の"],["ため"],["に"],["高楼","こうろう"],["を"],["建て","たて"],["、"],["広場","ひろば"],["、"],["広場","ひろば"],["に"],["台","だい"],["を"],["造","つくり"],["、"]]},{"verse":25,"text":"ちまた、ちまたのつじに台,だいを造,つくって、あなたの美,うつくしさを汚,けがし、すべてかたわらを通,とおる者,ものに身,みをまかせて、大,おおいに姦淫,かんいんを行,おこなっている。","tok":[["ちまた"],["、"],["ちまた"],["の"],["つじ"],["に"],["台","だい"],["を"],["造って","つくって"],["、"],["あなた"],["の"],["美し","うつくし"],["さ"],["を"],["汚","け"],["がし"],["、"],["すべて"],["かたわら"],["を"],["通る","とおる"],["者","もの"],["に"],["身","み"],["を"],["まかせて"],["、"],["大いに","おおいに"],["姦淫","かんいん"],["を"],["行なって","おこなって"],["いる"],["。"]]},{"verse":26,"text":"あなたはまた、かの肉欲,にくよく的,まとな隣,となりエジプトの人々,ひとびとと姦淫,かんいんを行,おこない、大,おおいに姦淫,かんいんを行,おこなって、わたしを怒,いからせた。","tok":[["あなた"],["は"],["また"],["、"],["かの"],["肉欲","にくよく"],["的","まと"],["な"],["隣","となり"],["エジプト"],["の"],["人々","ひとびと"],["と"],["姦淫","かんいん"],["を"],["行ない","おこない"],["、"],["大いに","おおいに"],["姦淫","かんいん"],["を"],["行なって","おこなって"],["、"],["わたし"],["を"],["怒らせた","いからせた"],["。"]]},{"verse":27,"text":"それゆえ、わたしはわたしの手,てをあなたの上,うえに伸,のべて、あなたの賜,たまわる分,ぶんを減,へらし、あなたの敵,てき、すなわち、あなたのみだらな行為,こういを恥,はじるペリシテびとの娘,むすめらの欲,よくのままに、あなたを渡,わたした。","tok":[["それ"],["ゆえ"],["、"],["わたし"],["は"],["わたし"],["の"],["手","て"],["を"],["あなた"],["の"],["上","うえ"],["に"],["伸べて","のべて"],["、"],["あなた"],["の"],["賜わる","たまわる"],["分","ぶん"],["を"],["減らし","へらし"],["、"],["あなた"],["の"],["敵","てき"],["、"],["すなわち"],["、"],["あなた"],["の"],["みだら"],["な"],["行為","こうい"],["を"],["恥","はじ"],["る"],["ペリシテ"],["びと"],["の"],["娘","むすめ"],["ら"],["の"],["欲","よく"],["の"],["まま"],["に"],["、"],["あなた"],["を"],["渡","わたし"],["た"],["。"]]},{"verse":28,"text":"あなたは飽,あくことがないので、またアッスリヤの人々,ひとびとと姦淫,かんいんを行,おこなったが、彼,かれらと姦淫,かんいんを行,おこなっても、なお飽,あくことがなかった。","tok":[["あなた"],["は"],["飽く","あく"],["こと"],["が"],["ない"],["ので"],["、"],["また"],["アッスリヤ"],["の"],["人々","ひとびと"],["と"],["姦淫","かんいん"],["を"],["行なった","おこなった"],["が"],["、"],["彼","かれ"],["ら"],["と"],["姦淫","かんいん"],["を"],["行なって","おこなって"],["も"],["、"],["なお"],["飽く","あく"],["こと"],["が"],["なかった"],["。"]]},{"verse":29,"text":"あなたはまたカルデヤの商業,しょうぎょう地,ちと大,おおいに姦淫,かんいんを行,おこなったが、これと姦淫,かんいんを行,おこなっても、なお飽,あくことがなかった。","tok":[["あなた"],["は"],["また"],["カルデヤ"],["の"],["商業地","しょうぎょうち"],["と"],["大いに","おおいに"],["姦淫","かんいん"],["を"],["行なった","おこなった"],["が"],["、"],["これ"],["と"],["姦淫","かんいん"],["を"],["行なって","おこなって"],["も"],["、"],["なお"],["飽く","あく"],["こと"],["が"],["なかった"],["。"]]},{"verse":30,"text":"主,しゅなる神,かみは言,いわれる、あなたの心,こころはどんなに恋,こいわずらうのか。あなたは、これらすべての事,ことを行,おこなった。これはあつかましい姦淫,かんいんのわざである。","tok":[["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["、"],["あなた"],["の"],["心","こころ"],["は"],["どんな"],["に"],["恋","こい"],["わずらう"],["の"],["か"],["。"],["あなた"],["は"],["、"],["これ"],["ら"],["すべて"],["の"],["事","こと"],["を"],["行なった","おこなった"],["。"],["これ"],["は"],["あつかましい"],["姦淫","かんいん"],["の"],["わざ"],["で"],["ある"],["。"]]},{"verse":31,"text":"あなたは、ちまた、ちまたのつじに高楼,こうろうを建,たて、広場,ひろば、広場,ひろばに台,だいを設,もうけたが、価,あたいをもらうことをあざけったので、遊女,ゆうじょのようではなかった。","tok":[["あなた"],["は"],["、"],["ちまた"],["、"],["ちまた"],["の"],["つじ"],["に"],["高楼","こうろう"],["を"],["建て","たて"],["、"],["広場","ひろば"],["、"],["広場","ひろば"],["に"],["台","だい"],["を"],["設けた","もうけた"],["が"],["、"],["価","あたい"],["を"],["もらう"],["こと"],["を"],["あざけった"],["ので"],["、"],["遊女","ゆうじょ"],["の"],["よう"],["で"],["は"],["なかった"],["。"]]},{"verse":32,"text":"自分,じぶんの夫,おっとに替,かえて他人,たにんと通,つうじる姦婦,かんぷよ。","tok":[["自分","じぶん"],["の"],["夫","おっと"],["に"],["替","かえ"],["て"],["他人","たにん"],["と"],["通じる","つうじる"],["姦婦","かんぷ"],["よ"],["。"]]},{"verse":33,"text":"人,ひとはすべての遊女,ゆうじょに物,ものを与,あたえる。しかしあなたはすべての恋人,こいびとに物,ものを与,あたえ、彼,かれらにまいないして、あなたと姦淫,かんいんするために、四方,しほうからあなたの所,ところにこさせる。","tok":[["人","ひと"],["は"],["すべて"],["の"],["遊女","ゆうじょ"],["に"],["物","もの"],["を"],["与える","あたえる"],["。"],["しかし"],["あなた"],["は"],["すべて"],["の"],["恋人","こいびと"],["に"],["物","もの"],["を"],["与","あたえ"],["、"],["彼","かれ"],["ら"],["に"],["まいない"],["して"],["、"],["あなた"],["と"],["姦淫","かんいん"],["する"],["ため"],["に"],["、"],["四方","しほう"],["から"],["あなた"],["の"],["所","ところ"],["に"],["こさせる"],["。"]]},{"verse":34,"text":"このようにあなたは姦淫,かんいんを行,おこなうに当,あたって、他,たの女,おんなと違,ちがっている。すなわち、だれもあなたに姦淫,かんいんをさせたのではない。あなたはかえって価,あたいを払,はらい、相手,あいてはあなたに払,はらわない。これがあなたの違,ちがうところである。","tok":[["この"],["よう"],["に"],["あなた"],["は"],["姦淫","かんいん"],["を"],["行なう","おこなう"],["に"],["当たって","あたって"],["、"],["他","た"],["の"],["女","おんな"],["と"],["違って","ちがって"],["いる"],["。"],["すなわち"],["、"],["だれ"],["も"],["あなた"],["に"],["姦淫","かんいん"],["を"],["させた"],["ので"],["は"],["ない"],["。"],["あなた"],["は"],["かえって"],["価","あたい"],["を"],["払","はらい"],["、"],["相手","あいて"],["は"],["あなた"],["に"],["払わない","はらわない"],["。"],["これ"],["が"],["あなた"],["の"],["違う","ちがう"],["ところ"],["で"],["ある"],["。"]]},{"verse":35,"text":"それで遊女,ゆうじょよ、主,しゅの言葉,ことばを聞,きけ。","tok":[["それ"],["で"],["遊女","ゆうじょ"],["よ"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["を"],["聞け","きけ"],["。"]]},{"verse":36,"text":"主,しゅなる神,かみはこう言,いわれる、あなたがその恋人,こいびとと姦淫,かんいんして、あなたの恥,はじる所,ところをあらわし、あなたの裸,はだかをあらわし、またすべての偶像,ぐうぞうと、あなたが彼,かれらにささげたあなたの子,こどもらの血,ちのゆえに、","tok":[["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["あなた"],["が"],["その"],["恋人","こいびと"],["と"],["姦淫","かんいん"],["して"],["、"],["あなた"],["の"],["恥","はじ"],["る"],["所","ところ"],["を"],["あらわし"],["、"],["あなた"],["の"],["裸","はだか"],["を"],["あらわし"],["、"],["また"],["すべて"],["の"],["偶像","ぐうぞう"],["と"],["、"],["あなた"],["が"],["彼","かれ"],["ら"],["に"],["ささげた"],["あなた"],["の"],["子ども","こども"],["ら"],["の"],["血","ち"],["の"],["ゆえ"],["に"],["、"]]},{"verse":37,"text":"見,みよ、わたしはあなたと遊,あそんだあなたのすべての恋人,こいびと、およびすべてあなたが恋,こいした者,ものと、すべてあなたが憎,にくんだ者,ものとを集,あつめ、四方,しほうから彼,かれらをあなたの所,ところに集,あつめて、あなたの裸,はだかを彼,かれらにあらわす。彼,かれらはあなたの裸,はだかを、ことごとく見,みる。","tok":[["見よ","みよ"],["、"],["わたし"],["は"],["あなた"],["と"],["遊んだ","あそんだ"],["あなた"],["の"],["すべて"],["の"],["恋人","こいびと"],["、"],["および"],["すべて"],["あなた"],["が"],["恋","こい"],["した"],["者","もの"],["と"],["、"],["すべて"],["あなた"],["が"],["憎んだ","にくんだ"],["者","もの"],["と"],["を"],["集め","あつめ"],["、"],["四方","しほう"],["から"],["彼","かれ"],["ら"],["を"],["あなた"],["の"],["所","ところ"],["に"],["集めて","あつめて"],["、"],["あなた"],["の"],["裸","はだか"],["を"],["彼","かれ"],["ら"],["に"],["あらわす"],["。"],["彼","かれ"],["ら"],["は"],["あなた"],["の"],["裸","はだか"],["を"],["、"],["ことごとく"],["見る","みる"],["。"]]},{"verse":38,"text":"わたしは姦淫,かんいんを行,おこなった女,おんなと、血,ちを流,ながした女,おんながさばかれるように、あなたをさばき、憤,いきどおりと、ねたみの血,ちとを、あなたに注,そそぐ。","tok":[["わたし"],["は"],["姦淫","かんいん"],["を"],["行なった","おこなった"],["女","おんな"],["と"],["、"],["血","ち"],["を"],["流した","ながした"],["女","おんな"],["が"],["さばかれる"],["よう"],["に"],["、"],["あなた"],["を"],["さばき"],["、"],["憤り","いきどおり"],["と"],["、"],["ねたみ"],["の"],["血","ち"],["と"],["を"],["、"],["あなた"],["に"],["注ぐ","そそぐ"],["。"]]},{"verse":39,"text":"わたしはあなたを恋人,こいびとの手,てに渡,わたす。彼,かれらはあなたの高楼,こうろうを倒,たおし、台,だいをこわし、あなたの衣,ころもをはぎ取,とり、あなたの美,うつくしい飾,かざりの品,しなを奪,うばい、あなたを衣服,いふくのない裸,はだか者,ものにする。","tok":[["わたし"],["は"],["あなた"],["を"],["恋人","こいびと"],["の"],["手","て"],["に"],["渡す","わたす"],["。"],["彼","かれ"],["ら"],["は"],["あなた"],["の"],["高楼","こうろう"],["を"],["倒し","たおし"],["、"],["台","だい"],["を"],["こわし"],["、"],["あなた"],["の"],["衣","ころも"],["を"],["はぎ"],["取","とり"],["、"],["あなた"],["の"],["美しい","うつくしい"],["飾","かざり"],["の"],["品","しな"],["を"],["奪い","うばい"],["、"],["あなた"],["を"],["衣服","いふく"],["の"],["ない"],["裸者","はだかもの"],["に"],["する"],["。"]]},{"verse":40,"text":"彼,かれらは民衆,みんしゅうをかり立,たててあなたを攻,せめ、石,いしであなたを撃,うち、つるぎであなたを切,きり、","tok":[["彼","かれ"],["ら"],["は"],["民衆","みんしゅう"],["を"],["かり立てて","かりたてて"],["あなた"],["を"],["攻め","せめ"],["、"],["石","いし"],["で"],["あなた"],["を"],["撃ち","うち"],["、"],["つるぎ"],["で"],["あなた"],["を"],["切り","きり"],["、"]]},{"verse":41,"text":"火,ひであなたの家,いえを焼,やき、多,おおくの女,おんなたちの前,まえで、あなたにさばきを行,おこなう。こうしてわたしはあなたに淫行,いんこうをやめさせ、重,かさねて価,あたいを払,はらわせないようにする。","tok":[["火","ひ"],["で"],["あなた"],["の"],["家","いえ"],["を"],["焼き","やき"],["、"],["多く","おおく"],["の"],["女","おんな"],["たち"],["の"],["前","まえ"],["で"],["、"],["あなた"],["に"],["さばき"],["を"],["行なう","おこなう"],["。"],["こう"],["して"],["わたし"],["は"],["あなた"],["に"],["淫行","いんこう"],["を"],["やめさせ"],["、"],["重ねて","かさねて"],["価","あたい"],["を"],["払わせない","はらわせない"],["よう"],["に"],["する"],["。"]]},{"verse":42,"text":"そしてあなたに対,たいするわが憤,いきどおりをしずめ、わがねたみをあなたから離,はなし、わたしは心,こころを安,やすんじて、再,ふたたび怒,いかることをしない。","tok":[["そして"],["あなた"],["に"],["対する","たいする"],["わが"],["憤り","いきどおり"],["を"],["しずめ"],["、"],["わが"],["ねたみ"],["を"],["あなた"],["から"],["離し","はなし"],["、"],["わたし"],["は"],["心","こころ"],["を"],["安んじて","やすんじて"],["、"],["再び","ふたたび"],["怒","いかるこ"],["と"],["を"],["しない"],["。"]]},{"verse":43,"text":"またあなたはその若,わかき日,ひの事,ことを覚,おぼえず、すべてこれらの事,ことをもって、わたしを怒,いからせたから、見,みよ、わたしもあなたの行,おこなうところをあなたのこうべに報,むくいると、主,しゅなる神,かみは言,いわれる。あなたはもろもろの憎,にくむべき事,ことに加,くわえて、このみだらな事,ことをおこなったではないか。","tok":[["また"],["あなた"],["は"],["その"],["若き","わかき"],["日","ひ"],["の"],["事","こと"],["を"],["覚えず","おぼえず"],["、"],["すべて"],["これ"],["ら"],["の"],["事","こと"],["を"],["もって"],["、"],["わたし"],["を"],["怒らせた","いからせた"],["から"],["、"],["見よ","みよ"],["、"],["わたし"],["も"],["あなた"],["の"],["行なう","おこなう"],["ところ"],["を"],["あなた"],["の"],["こうべ"],["に"],["報いる","むくいる"],["と"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"],["あなた"],["は"],["もろもろ"],["の"],["憎むべき","にくむべき"],["事","こと"],["に"],["加えて","くわえて"],["、"],["この"],["みだら"],["な"],["事","こと"],["を"],["おこなったで"],["は"],["ない"],["か"],["。"]]},{"verse":44,"text":"見,みよ、すべてことわざを用,もちいる者,ものは、あなたについて、『この母,ははにしてこの娘,むすめあり』という、ことわざを用,もちいる。","tok":[["見よ","みよ"],["、"],["すべて"],["ことわざ"],["を"],["用いる","もちいる"],["者","もの"],["は"],["、"],["あなた"],["について"],["、"],["『"],["この"],["母","はは"],["に"],["して"],["この"],["娘","むすめ"],["あり"],["』"],["と"],["いう"],["、"],["ことわざ"],["を"],["用いる","もちいる"],["。"]]},{"verse":45,"text":"あなたは、その夫,おっとと子,こどもとを捨,すてたあなたの母,ははの娘,むすめ、またその夫,おっとと子,こどもとを捨,すてた姉妹,しまいを持,もっている。あなたの母,はははヘテびと、あなたの父,ちちはアモリびと、","tok":[["あなた"],["は"],["、"],["その"],["夫","おっと"],["と"],["子ども","こども"],["と"],["を"],["捨てた","すてた"],["あなた"],["の"],["母","はは"],["の"],["娘","むすめ"],["、"],["また"],["その"],["夫","おっと"],["と"],["子ども","こども"],["と"],["を"],["捨てた","すてた"],["姉妹","しまい"],["を"],["持って","もって"],["いる"],["。"],["あなた"],["の"],["母","はは"],["は"],["ヘテ"],["び"],["と"],["、"],["あなた"],["の"],["父","ちち"],["は"],["アモリ"],["び"],["と"],["、"]]},{"verse":46,"text":"あなたの姉,あねはサマリヤ、サマリヤはその娘,むすめたちと共,ともに、あなたの北,きたに住,すみ、あなたの妹,いもうとはソドムで、その娘,むすめたちと共,ともに、あなたの南,みなみに住,すんでいる。","tok":[["あなた"],["の"],["姉","あね"],["は"],["サマリヤ"],["、"],["サマリヤ"],["は"],["その"],["娘","むすめ"],["たち"],["と"],["共","とも"],["に"],["、"],["あなた"],["の"],["北","きた"],["に"],["住み","すみ"],["、"],["あなた"],["の"],["妹","いもうと"],["は"],["ソドム"],["で"],["、"],["その"],["娘","むすめ"],["たち"],["と"],["共","とも"],["に"],["、"],["あなた"],["の"],["南","みなみ"],["に"],["住んで","すんで"],["いる"],["。"]]},{"verse":47,"text":"あなたは彼,かれらの道,みちを歩,あゆまず、彼,かれらの憎,にくむべき事,ことに従,したがっていないが、しばらくすると、あなたのおこないは、彼,かれらよりもさらに悪,わるくなる。","tok":[["あなた"],["は"],["彼","かれ"],["ら"],["の"],["道","みち"],["を"],["歩まず","あゆまず"],["、"],["彼","かれ"],["ら"],["の"],["憎むべき","にくむべき"],["事","こと"],["に"],["従って","したがって"],["いない"],["が"],["、"],["しばらく"],["する"],["と"],["、"],["あなた"],["の"],["おこない"],["は"],["、"],["彼","かれ"],["ら"],["より"],["も"],["さらに"],["悪く","わるく"],["なる"],["。"]]},{"verse":48,"text":"主,しゅなる神,かみは言,いわれる、わたしは生,いきている。あなたの妹,いもうとソドムとその娘,むすめたちは、あなたとあなたの娘,むすめたちがしたほどのことはしなかった。","tok":[["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["、"],["わたし"],["は"],["生きて","いきて"],["いる"],["。"],["あなた"],["の"],["妹","いもうと"],["ソドム"],["と"],["その"],["娘","むすめ"],["たち"],["は"],["、"],["あなた"],["と"],["あなた"],["の"],["娘","むすめ"],["たち"],["が"],["した"],["ほど"],["の"],["こと"],["は"],["しなかった"],["。"]]},{"verse":49,"text":"見,みよ、あなたの妹,いもうとソドムの罪,つみはこれである。すなわち彼女,かのじょと、その娘,むすめたちは高,たかぶり、食物,しょくもつに飽,あき、安泰,あんたいに暮,くらしていたが、彼,かれらは、乏,とぼしい者,ものと貧,まずしい者,ものを助,たすけなかった。","tok":[["見よ","みよ"],["、"],["あなた"],["の"],["妹","いもうと"],["ソドム"],["の"],["罪","つみ"],["は"],["これ"],["で"],["ある"],["。"],["すなわち"],["彼女","かのじょ"],["と"],["、"],["その"],["娘","むすめ"],["たち"],["は"],["高か","たか"],["ぶり"],["、"],["食物","しょくもつ"],["に"],["飽き","あき"],["、"],["安泰","あんたい"],["に"],["暮らして","くらして"],["いた"],["が"],["、"],["彼","かれ"],["ら"],["は"],["、"],["乏い","とぼしい"],["者","もの"],["と"],["貧しい","まずしい"],["者","もの"],["を"],["助けなかった","たすけなかった"],["。"]]},{"verse":50,"text":"彼,かれらは高,たかぶり、わたしの前,まえに憎,にくむべき事,ことをおこなったので、わたしはそれを見,みた時,とき、彼,かれらを除,のぞいた。","tok":[["彼","かれ"],["ら"],["は"],["高か","たか"],["ぶり"],["、"],["わたし"],["の"],["前","まえ"],["に"],["憎むべき","にくむべき"],["事","こと"],["を"],["おこなった"],["ので"],["、"],["わたし"],["は"],["それ"],["を"],["見た","みた"],["時","とき"],["、"],["彼","かれ"],["ら"],["を"],["除いた","のぞいた"],["。"]]},{"verse":51,"text":"サマリヤはあなたの半分,はんぶんも罪,つみを犯,おかさなかった。あなたは彼,かれらよりも多,おおく憎,にくむべき事,ことをおこない、あなたのおこなったもろもろの憎,にくむべき事,ことによって、あなたの姉妹,しまいを義,ぎと見,みせかけた。","tok":[["サマリヤ"],["は"],["あなた"],["の"],["半分","はんぶん"],["も"],["罪","つみ"],["を"],["犯さなかった","おかさなかった"],["。"],["あなた"],["は"],["彼","かれ"],["ら"],["より"],["も"],["多く","おおく"],["憎むべき","にくむべき"],["事","こと"],["を"],["おこない"],["、"],["あなた"],["の"],["おこなった"],["もろもろ"],["の"],["憎むべき","にくむべき"],["事","こと"],["によって"],["、"],["あなた"],["の"],["姉妹","しまい"],["を"],["義","ぎ"],["と"],["見せかけた","みせかけた"],["。"]]},{"verse":52,"text":"あなたはその姉妹,しまいを有利,ゆうりにさばいたことによって、あなたもまた自分,じぶんのはずかしめを負,おわなければならない。それはあなたが彼,かれらよりも、さらに憎,にくむべきことをした罪,つみによって、彼,かれらはあなたよりも義,ぎとされるからである。それであなたも恥,はじを受,うけ、はずかしめを負,おわなければならない。それはあなたがその姉妹,しまいを義,ぎと見,みせかけたからである。","tok":[["あなた"],["は"],["その"],["姉妹","しまい"],["を"],["有利","ゆうり"],["に"],["さばいた"],["こと"],["によって"],["、"],["あなた"],["も"],["また"],["自分","じぶん"],["の"],["はずかし"],["め"],["を"],["負わなければ","おわなければ"],["ならない"],["。"],["それ"],["は"],["あなた"],["が"],["彼","かれ"],["ら"],["より"],["も"],["、"],["さらに"],["憎むべき","にくむべき"],["こと"],["を"],["した"],["罪","つみ"],["によって"],["、"],["彼","かれ"],["ら"],["は"],["あなた"],["より"],["も"],["義","ぎ"],["と"],["される"],["から"],["で"],["ある"],["。"],["それ"],["で"],["あなた"],["も"],["恥","はじ"],["を"],["受け","うけ"],["、"],["はずかしめ"],["を"],["負わなければ","おわなければ"],["ならない"],["。"],["それ"],["は"],["あなた"],["が"],["その"],["姉妹","しまい"],["を"],["義","ぎ"],["と"],["見せかけた","みせかけた"],["から"],["で"],["ある"],["。"]]},{"verse":53,"text":"わたしは彼,かれらの幸福,こうふくをもとに返,かえす。すなわちソドムとその娘,むすめたちの幸福,こうふく、サマリヤとその娘,むすめたちの幸福,こうふく、また彼,かれらの中,なかにいるあなたの幸福,こうふくをもとに返,かえす。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["の"],["幸福","こうふく"],["を"],["もと"],["に"],["返えす","かえす"],["。"],["すなわち"],["ソドム"],["と"],["その"],["娘","むすめ"],["たち"],["の"],["幸福","こうふく"],["、"],["サマリヤ"],["と"],["その"],["娘","むすめ"],["たち"],["の"],["幸福","こうふく"],["、"],["また"],["彼","かれ"],["ら"],["の"],["中","なか"],["に"],["いる"],["あなた"],["の"],["幸福","こうふく"],["を"],["もと"],["に"],["返えす","かえす"],["。"]]},{"verse":54,"text":"これはあなたに自分,じぶんのはずかしめを負,おわせるため、またすべてあなたのなした事,ことを恥,はじさせるためである。こうしてあなたは彼,かれらの慰,なぐさめとなる。","tok":[["これ"],["は"],["あなた"],["に"],["自分","じぶん"],["の"],["はずかし"],["め"],["を"],["負わせる","おわせる"],["ため"],["、"],["また"],["すべて"],["あなた"],["の"],["なした"],["事","こと"],["を"],["恥","はじ"],["させる"],["ため"],["で"],["ある"],["。"],["こう"],["して"],["あなた"],["は"],["彼","かれ"],["ら"],["の"],["慰さめ","なぐさめ"],["と"],["なる"],["。"]]},{"verse":55,"text":"あなたの姉妹,しまいソドムと、その娘,むすめたちとは、そのもとの所,ところに帰,かえり、サマリヤと、その娘,むすめたちとは、そのもとの所,ところに帰,かえり、あなたと、あなたの娘,むすめたちとは、そのもとの所,ところに帰,かえる。","tok":[["あなた"],["の"],["姉妹","しまい"],["ソドム"],["と"],["、"],["その"],["娘","むすめ"],["たち"],["と"],["は"],["、"],["その"],["もと"],["の"],["所","ところ"],["に"],["帰えり","かえり"],["、"],["サマリヤ"],["と"],["、"],["その"],["娘","むすめ"],["たち"],["と"],["は"],["、"],["その"],["もと"],["の"],["所","ところ"],["に"],["帰えり","かえり"],["、"],["あなた"],["と"],["、"],["あなた"],["の"],["娘","むすめ"],["たち"],["と"],["は"],["、"],["その"],["もと"],["の"],["所","ところ"],["に"],["帰える","かえる"],["。"]]},{"verse":56,"text":"あなたの高,たかぶりの日,ひに、あなたの姉妹,しまいソドムは、あなたの口,くちに、ことわざとなったではなかったか。","tok":[["あなた"],["の"],["高ぶり","たかぶり"],["の"],["日","ひ"],["に"],["、"],["あなた"],["の"],["姉妹","しまい"],["ソドム"],["は"],["、"],["あなた"],["の"],["口","くち"],["に"],["、"],["ことわざ"],["と"],["なったで"],["は"],["なかった"],["か"],["。"]]},{"verse":57,"text":"すなわちあなたの悪,あくがあらわされた時,ときまで、そうではなかったか。しかし今,いまはあなたも彼女,かのじょと同様,どうように、エドムの娘,むすめたちと、すべてその周囲,しゅういの者,もの、および四方,しほうからあなたをあざけるペリシテの娘,むすめたちのそしりとなった。","tok":[["すなわち"],["あなた"],["の"],["悪","あく"],["が"],["あらわされた"],["時","とき"],["まで"],["、"],["そう"],["で"],["は"],["なかった"],["か"],["。"],["しかし"],["今","いま"],["は"],["あなた"],["も"],["彼女","かのじょ"],["と"],["同様","どうよう"],["に"],["、"],["エドム"],["の"],["娘","むすめ"],["たち"],["と"],["、"],["すべて"],["その"],["周囲","しゅうい"],["の"],["者","もの"],["、"],["および"],["四方","しほう"],["から"],["あなた"],["を"],["あざける"],["ペリシテ"],["の"],["娘","むすめ"],["たち"],["の"],["そしり"],["と"],["なった"],["。"]]},{"verse":58,"text":"あなたはあなたのみだらな行為,こういと、あなたの憎,にくむべき事,ことのとがとを、身,みに負,おっていると主,しゅは言,いわれる。","tok":[["あなた"],["は"],["あなた"],["の"],["みだら"],["な"],["行為","こうい"],["と"],["、"],["あなた"],["の"],["憎むべき","にくむべき"],["事","こと"],["の"],["とが"],["と"],["を"],["、"],["身","み"],["に"],["負って","おって"],["いる"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":59,"text":"主,しゅなる神,かみはこう言,いわれる、誓,ちかいを軽,かろんじ、契約,けいやくを破,やぶったあなたには、あなたがしたように、わたしもあなたにする。","tok":[["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["誓い","ちかい"],["を"],["軽んじ","かろんじ"],["、"],["契約","けいやく"],["を"],["破った","やぶった"],["あなた"],["に"],["は"],["、"],["あなた"],["が"],["した"],["よう"],["に"],["、"],["わたし"],["も"],["あなた"],["に"],["する"],["。"]]},{"verse":60,"text":"しかしわたしはあなたの若,わかき日,ひに、あなたと結,むすんだ契約,けいやくを覚,おぼえ、永遠,えいえんの契約,けいやくをあなたと立,たてる。","tok":[["しかし"],["わたし"],["は"],["あなた"],["の"],["若き","わかき"],["日","ひ"],["に"],["、"],["あなた"],["と"],["結んだ","むすんだ"],["契約","けいやく"],["を"],["覚え","おぼえ"],["、"],["永遠","えいえん"],["の"],["契約","けいやく"],["を"],["あなた"],["と"],["立る","たてる"],["。"]]},{"verse":61,"text":"わたしがあなたの姉,あねおよび妹,いもうとを受,うけ、またあなたとの契約,けいやくによらずに、娘,むすめとして彼,かれらをあなたに与,あたえる時,とき、あなたは自分,じぶんのおこないを思,おもい出,だして恥,はじる。","tok":[["わたし"],["が"],["あなた"],["の"],["姉","あね"],["および"],["妹","いもうと"],["を"],["受け","うけ"],["、"],["また"],["あなた"],["と"],["の"],["契約","けいやく"],["に"],["よらず"],["に"],["、"],["娘","むすめ"],["として"],["彼","かれ"],["ら"],["を"],["あなた"],["に"],["与える","あたえる"],["時","とき"],["、"],["あなた"],["は"],["自分","じぶん"],["の"],["おこない"],["を"],["思い出して","おもいだして"],["恥","はじ"],["る"],["。"]]},{"verse":62,"text":"わたしはあなたと契約,けいやくを立,たて、あなたはわたしが主,しゅであることを知,しるようになる。","tok":[["わたし"],["は"],["あなた"],["と"],["契約","けいやく"],["を"],["立て","たて"],["、"],["あなた"],["は"],["わたし"],["が"],["主","しゅ"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"]]},{"verse":63,"text":"こうしてすべてあなたの行,おこなったことにつき、わたしがあなたをゆるす時,とき、あなたはそれを思,おもい出,だして恥,はじ、その恥,はじのゆえに重,かさねて口,くちを開,ひらくことがないと、主,しゅなる神,かみは言,いわれる」。","tok":[["こう"],["して"],["すべて"],["あなた"],["の"],["行なった","おこなった"],["こと"],["に"],["つき"],["、"],["わたし"],["が"],["あなた"],["を"],["ゆるす"],["時","とき"],["、"],["あなた"],["は"],["それ"],["を"],["思い出して","おもいだして"],["恥","はじ"],["、"],["その"],["恥","はじ"],["の"],["ゆえ"],["に"],["重ねて","かさねて"],["口","くち"],["を"],["開らく","ひらく"],["こと"],["が"],["ない"],["と"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["」"],["。"]]}]
[{"verse":1,"text":"[20:45]主,しゅの言葉,ことばがまたわたしに臨,のぞんだ、","tok":[["["],["20"],[":"],["45"],["]"],["主","しゅ"],["の"],["言葉","ことば"],["が"],["また"],["わたし"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":2,"text":"[20:46]「人,ひとの子,こよ、顔,かおを南,みなみに向,むけ、南,みなみに向,むかって語,かたり、ネゲブの森,もりの地,ちに対,たいして預言,よげんせよ。","tok":[["["],["20"],[":"],["46"],["]"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["顔","かお"],["を"],["南","みなみ"],["に"],["向け","むけ"],["、"],["南","みなみ"],["に"],["向かって","むかって"],["語り","かたり"],["、"],["ネゲブ"],["の"],["森","もり"],["の"],["地","ち"],["に対して","にたいして"],["預言","よげん"],["せよ"],["。"]]},{"verse":3,"text":"[20:47]すなわちネゲブの森,もりに言,いえ、主,しゅの言葉,ことばを聞,きけ、主,しゅなる神,かみはこう言,いわれる、見,みよ、わたしはあなたのうちに火,ひを燃,もやす。その火,ひはあなたのうちのすべての青木,あおきと、すべての枯,かれ木,きを焼,やき滅,ほろぼし、その燃,もえる炎,ほのおは消,けされることがなく、南,みなみから北,きたまで、すべての地,ちのおもては、これがために焼,やける。","tok":[["["],["20"],[":"],["47"],["]"],["すなわち"],["ネゲブ"],["の"],["森","もり"],["に"],["言え","いえ"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["を"],["聞け","きけ"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["見よ","みよ"],["、"],["わたし"],["は"],["あなた"],["の"],["うち"],["に"],["火","ひ"],["を"],["燃やす","もやす"],["。"],["その"],["火","ひ"],["は"],["あなた"],["の"],["うち"],["の"],["すべて"],["の"],["青木","あおき"],["と"],["、"],["すべて"],["の"],["枯木","かれき"],["を"],["焼き滅ぼし","やきほろぼし"],["、"],["その"],["燃える","もえる"],["炎","ほのお"],["は"],["消される","けされる"],["こと"],["が"],["なく"],["、"],["南","みなみ"],["から"],["北","きた"],["まで"],["、"],["すべて"],["の"],["地","ち"],["の"],["おもて"],["は"],["、"],["これ"],["が"],["ため"],["に"],["焼","やけ"],["る"],["。"]]},{"verse":4,"text":"[20:48]すべて肉,にくなる者,ものは、主,しゅなるわたしがこれを焼,やいたことを見,みる。その火,ひは消,けされない」。","tok":[["["],["20"],[":"],["48"],["]"],["すべて"],["肉","にく"],["なる"],["者","もの"],["は"],["、"],["主","しゅ"],["なる"],["わたし"],["が"],["これ"],["を"],["焼いた","やいた"],["こと"],["を"],["見る","みる"],["。"],["その"],["火","ひ"],["は"],["消されない","けされない"],["」"],["。"]]},{"verse":5,"text":"[20:49]そこでわたしは言,いった、「ああ主,しゅなる神,かみよ、彼,かれらはわたしについてこう語,かたっています、『彼,かれはたとえをもって語,かたる者,ものではないか』と」。","tok":[["["],["20"],[":"],["49"],["]"],["そこ"],["で"],["わたし"],["は"],["言った","いった"],["、"],["「"],["ああ"],["主","しゅ"],["なる"],["神","かみ"],["よ"],["、"],["彼","かれ"],["ら"],["は"],["わたし"],["について"],["こう"],["語って","かたって"],["います"],["、"],["『"],["彼","かれ"],["は"],["たとえ"],["を"],["もって"],["語る","かたる"],["者","もの"],["で"],["は"],["ない"],["か"],["』"],["と"],["」"],["。"]]},{"verse":6,"text":"[1]主,しゅの言葉,ことばがわたしに臨,のぞんだ、","tok":[["["],["1"],["]"],["主","しゅ"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":7,"text":"[2]「人,ひとの子,こよ、あなたの顔,かおをエルサレムに向,むけ、あなたの言葉,ことばを聖所,せいじょに向,むけてのべ、イスラエルの地,ちに向,むかって預言,よげんし、","tok":[["["],["2"],["]"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["あなた"],["の"],["顔","かお"],["を"],["エルサレム"],["に"],["向け","むけ"],["、"],["あなた"],["の"],["言葉","ことば"],["を"],["聖","せい"],["所","しょ"],["に"],["向けて","むけて"],["のべ"],["、"],["イスラエル"],["の"],["地","ち"],["に"],["向かって","むかって"],["預言","よげん"],["し"],["、"]]},{"verse":8,"text":"[3]イスラエルの地,ちに言,いえ。主,しゅはこう言,いわれる、見,みよ、わたしはあなたを攻,せめ、わたしのつるぎをさやから抜,ぬき、あなたのうちから、正,ただしい者,ものも悪,あしき者,ものをも断,たってしまう。","tok":[["["],["3"],["]"],["イスラエル"],["の"],["地","ち"],["に"],["言え","いえ"],["。"],["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["見よ","みよ"],["、"],["わたし"],["は"],["あなた"],["を"],["攻め","せめ"],["、"],["わたし"],["の"],["つるぎ"],["を"],["さや"],["から"],["抜き","ぬき"],["、"],["あなた"],["の"],["うち"],["から"],["、"],["正い","ただしい"],["者","もの"],["も"],["悪しき","あしき"],["者","もの"],["を"],["も"],["断って","たって"],["しまう"],["。"]]},{"verse":9,"text":"[4]わたしがあなたのうちから、正,ただしい者,ものも悪,あしき者,ものをも断,たつゆえに、わたしのつるぎはさやから抜,ぬけ出,でて、南,みなみから北,きたまでのすべての肉,にくなる者,ものを攻,せめる。","tok":[["["],["4"],["]"],["わたし"],["が"],["あなた"],["の"],["うち"],["から"],["、"],["正い","ただしい"],["者","もの"],["も"],["悪しき","あしき"],["者","もの"],["を"],["も"],["断つ","たつ"],["ゆえ"],["に"],["、"],["わたし"],["の"],["つるぎ"],["は"],["さや"],["から"],["抜出て","ぬけでて"],["、"],["南","みなみ"],["から"],["北","きた"],["まで"],["の"],["すべて"],["の"],["肉","にく"],["なる"],["者","もの"],["を"],["攻める","せめる"],["。"]]},{"verse":10,"text":"[5]すべて肉,にくなる者,ものは、主,しゅなるわたしが、そのつるぎをさやから抜,ぬき放,はなったことを知,しる。このつるぎは再,ふたたびさやに納,おさめられない。","tok":[["["],["5"],["]"],["すべて"],["肉","にく"],["なる"],["者","もの"],["は"],["、"],["主","しゅ"],["なる"],["わたし"],["が"],["、"],["その"],["つるぎ"],["を"],["さや"],["から"],["抜き放った","ぬきはなった"],["こと"],["を"],["知る","しる"],["。"],["この"],["つるぎ"],["は"],["再び","ふたたび"],["さや"],["に"],["納められない","おさめられない"],["。"]]},{"verse":11,"text":"[6]それゆえ、人,ひとの子,こよ、嘆,なげけ、心,こころ砕,くだけるまでに嘆,なげき、彼,かれらの目,めの前,まえでいたく嘆,なげけ。","tok":[["["],["6"],["]"],["それ"],["ゆえ"],["、"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["嘆け","なげけ"],["、"],["心","こころ"],["砕ける","くだける"],["まで"],["に"],["嘆き","なげき"],["、"],["彼","かれ"],["ら"],["の"],["目","め"],["の"],["前","まえ"],["で"],["いたく"],["嘆け","なげけ"],["。"]]},{"verse":12,"text":"[7]人,ひとがあなたに向,むかって、『なぜ嘆,なげくのか』と言,いうなら、『この知,しらせのためである。それが来,くれば人,ひとの心,こころはみな溶,とけ、手,てはみななえ、霊,れいはみな弱,よわり、ひざはみな水,みずのようになる。見,みよ、それは来,くる、必,かならず成就,じょうじゅする』と言,いえ」と主,しゅなる神,かみは言,いわれる。","tok":[["["],["7"],["]"],["人","ひと"],["が"],["あなた"],["に"],["向かって","むかって"],["、"],["『"],["なぜ"],["嘆く","なげく"],["の"],["か"],["』"],["と"],["言","いうな"],["ら"],["、"],["『"],["この"],["知らせ","しらせ"],["の"],["ため"],["で"],["ある"],["。"],["それ"],["が"],["来れば","くれば"],["人","ひと"],["の"],["心","こころ"],["は"],["みな"],["溶け","とけ"],["、"],["手","て"],["は"],["みな"],["なえ"],["、"],["霊","れい"],["は"],["みな"],["弱り","よわり"],["、"],["ひざ"],["は"],["みな"],["水","みず"],["の"],["よう"],["に"],["なる"],["。"],["見よ","みよ"],["、"],["それ"],["は"],["来る","くる"],["、"],["必","かならず"],["成就","じょうじゅ"],["する"],["』"],["と"],["言え","いえ"],["」"],["と"],["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"]]},{"verse":13,"text":"[8]主,しゅの言葉,ことばがわたしに臨,のぞんだ、","tok":[["["],["8"],["]"],["主","しゅ"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":14,"text":"[9]「人,ひとの子,こよ、預言,よげんして言,いえ、主,しゅはこう言,いわれる、つるぎがある、とぎ、かつ、みがいたつるぎがある。","tok":[["["],["9"],["]"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["預言","よげん"],["して"],["言え","いえ"],["、"],["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["つるぎ"],["が"],["ある"],["、"],["とぎ"],["、"],["かつ"],["、"],["みがいた"],["つるぎ"],["が"],["ある"],["。"]]},{"verse":15,"text":"[10]殺,ころすためにといであり、いなずまのようにきらめくためにみがいてある。わたしたちは喜,よろこぶことができるか。わが子,こよ、あなたはつえと、すべて木,きで作,つくったものとを軽,かろんじた。","tok":[["["],["10"],["]"],["殺ろす","ころす"],["ため"],["に"],["といで"],["あり"],["、"],["いなずま"],["の"],["よう"],["に"],["きらめく"],["ため"],["に"],["みがいて"],["ある"],["。"],["わたしたち"],["は"],["喜こぶ","よろこぶ"],["こと"],["が"],["できる"],["か"],["。"],["わが"],["子","こ"],["よ"],["、"],["あなた"],["は"],["つえ"],["と"],["、"],["すべて"],["木","き"],["で"],["作った","つくった"],["もの"],["と"],["を"],["軽んじた","かろんじた"],["。"]]},{"verse":16,"text":"[11]このつるぎは手,てにとるために、とがれ、殺,ころす者,ものの手,てに渡,わたすために、とがれみがかれるのである。","tok":[["["],["11"],["]"],["この"],["つるぎ"],["は"],["手","て"],["に"],["とる"],["ため"],["に"],["、"],["とがれ"],["、"],["殺ろす","ころす"],["者","もの"],["の"],["手","て"],["に"],["渡す","わたす"],["ため"],["に"],["、"],["とがれ"],["みがかれる"],["ので"],["ある"],["。"]]},{"verse":17,"text":"[12]人,ひとの子,こよ、叫,さけび嘆,なげけ、このことはわが民,たみに臨,のぞみ、イスラエルのすべての君,きみたちに臨,のぞむからである。彼,かれらはわが民,たみと共,ともにつるぎにわたされる。それゆえ、あなたのももを打,うて。","tok":[["["],["12"],["]"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["叫","さけび"],["嘆け","なげけ"],["、"],["この"],["こと"],["は"],["わが"],["民","たみ"],["に"],["臨み","のぞみ"],["、"],["イスラエル"],["の"],["すべて"],["の"],["君","きみ"],["たち"],["に"],["臨む","のぞむ"],["から"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["わが"],["民","たみ"],["と"],["共","とも"],["に"],["つるぎ"],["に"],["わたされる"],["。"],["それ"],["ゆえ"],["、"],["あなた"],["の"],["もも"],["を"],["打て","うて"],["。"]]},{"verse":18,"text":"[13]これはためしにすることではない。もしあなたが、つえをあざけったら、どういうことになろうか」と主,しゅなる神,かみは言,いわれる。","tok":[["["],["13"],["]"],["これ"],["は"],["ためし"],["に"],["する"],["こと"],["で"],["は"],["ない"],["。"],["もし"],["あなた"],["が"],["、"],["つえ"],["を"],["あざけったら"],["、"],["どういう"],["こと"],["に"],["なろう"],["か"],["」"],["と"],["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"]]},{"verse":19,"text":"[14]「それゆえ、人,ひとの子,こよ、あなたは預言,よげんし、手,てを打,うちならせ。つるぎを二度,ども三度,ども臨,のぞませよ。これは人,ひとを殺,ころすつるぎ、大,おおいに殺,ころすつるぎであって、彼,かれらを囲,かこむものである。","tok":[["["],["14"],["]"],["「"],["それ"],["ゆえ"],["、"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["あなた"],["は"],["預言","よげん"],["し"],["、"],["手","て"],["を"],["打ちならせ","うちならせ"],["。"],["つるぎ"],["を"],["二","に"],["度","ど"],["も"],["三","さん"],["度","ど"],["も"],["臨ませ","のぞませ"],["よ"],["。"],["これ"],["は"],["人","ひと"],["を"],["殺ろす","ころす"],["つるぎ"],["、"],["大いに","おおいに"],["殺ろす","ころす"],["つるぎ"],["で"],["あって"],["、"],["彼","かれ"],["ら"],["を"],["囲む","かこむ"],["もの"],["で"],["ある"],["。"]]},{"verse":20,"text":"[15]これがために彼,かれらの心,こころは溶,とけ、多,おおくの者,ものがすべての門,もんに倒,たおれる。わたしはひらめくつるぎを彼,かれらに送,おくる。ああ、これはいなずまのようになり、人,ひとを殺,ころすためにみがかれている。","tok":[["["],["15"],["]"],["これ"],["が"],["ため"],["に"],["彼","かれ"],["ら"],["の"],["心","こころ"],["は"],["溶け","とけ"],["、"],["多く","おおく"],["の"],["者","もの"],["が"],["すべて"],["の"],["門","もん"],["に"],["倒れる","たおれる"],["。"],["わたし"],["は"],["ひらめく"],["つるぎ"],["を"],["彼","かれ"],["ら"],["に"],["送る","おくる"],["。"],["ああ"],["、"],["これ"],["は"],["いなずま"],["の"],["よう"],["に"],["なり"],["、"],["人","ひと"],["を"],["殺ろす","ころす"],["ため"],["に"],["みがかれて"],["いる"],["。"]]},{"verse":21,"text":"[16]あなたの刃,はの向,むかうところで、右,みぎに左,ひだりになぎ倒,たおせ。","tok":[["["],["16"],["]"],["あなた"],["の"],["刃","は"],["の"],["向かう","むかう"],["ところ"],["で"],["、"],["右","みぎ"],["に"],["左","ひだり"],["に"],["なぎ倒せ","なぎたおせ"],["。"]]},{"verse":22,"text":"[17]わたしもまた、わたしの手,てを打,うちならし、わたしの怒,いかりをしずめると、主,しゅなるわたしは言,いった」。","tok":[["["],["17"],["]"],["わたし"],["も"],["また"],["、"],["わたし"],["の"],["手","て"],["を"],["打ちならし","うちならし"],["、"],["わたし"],["の"],["怒り","いかり"],["を"],["しずめる"],["と"],["、"],["主","しゅ"],["なる"],["わたし"],["は"],["言った","いった"],["」"],["。"]]},{"verse":23,"text":"[18]主,しゅの言葉,ことばがまたわたしに臨,のぞんだ、","tok":[["["],["18"],["]"],["主","しゅ"],["の"],["言葉","ことば"],["が"],["また"],["わたし"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":24,"text":"[19]「人,ひとの子,こよ、バビロンの王,おうのつるぎが来,くるために、二つの道,みちを備,そなえよ。この二つの道,みちは一つの国,くにから出,でている。あなたは道,みちしるべを作,つくり、これを町,まちに向,むかう道,みちのはじめに置,おけ。","tok":[["["],["19"],["]"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["バビロン"],["の"],["王","おう"],["の"],["つるぎ"],["が"],["来る","くる"],["ため"],["に"],["、"],["二","ふた"],["つ"],["の"],["道","みち"],["を"],["備","そなえ"],["よ"],["。"],["この"],["二","ふた"],["つ"],["の"],["道","みち"],["は"],["一","ひと"],["つ"],["の"],["国","くに"],["から"],["出て","でて"],["いる"],["。"],["あなた"],["は"],["道しるべ","みちしるべ"],["を"],["作り","つくり"],["、"],["これ"],["を"],["町","まち"],["に"],["向かう","むかう"],["道","みち"],["の"],["はじめ"],["に"],["置","おけ"],["。"]]},{"verse":25,"text":"[20]あなたはまたアンモンの人々,ひとびとのラバと、ユダと、堅固,けんごな城,しろの町,まちエルサレムとにつるぎの来,くる道,みちを設,もうけよ。","tok":[["["],["20"],["]"],["あなた"],["は"],["また"],["アンモン"],["の"],["人々","ひとびと"],["の"],["ラバ"],["と"],["、"],["ユダ"],["と"],["、"],["堅固","けんご"],["な"],["城","しろ"],["の"],["町","まち"],["エルサレム"],["と"],["に"],["つるぎ"],["の"],["来る","くる"],["道","みち"],["を"],["設けよ","もうけよ"],["。"]]},{"verse":26,"text":"[21]バビロンの王,おうは道,みちの分,わかれ目,め、二つの道,みちのはじめに立,たって占,うらないをし、矢,やをふり、テラピムに問,とい、肝,きもを見,みる。","tok":[["["],["21"],["]"],["バビロン"],["の"],["王","おう"],["は"],["道","みち"],["の"],["分かれ目","わかれめ"],["、"],["二","ふた"],["つ"],["の"],["道","みち"],["の"],["はじめ"],["に"],["立って","たって"],["占","うらない"],["を"],["し"],["、"],["矢","や"],["を"],["ふり"],["、"],["テラピム"],["に"],["問","とい"],["、"],["肝","きも"],["を"],["見る","みる"],["。"]]},{"verse":27,"text":"[22]彼,かれの右,みぎにエルサレムのために占,うらないが出,でる。すなわち口,くちを開,ひらいて叫,さけび、声,こえをあげ、ときを作,つくり、門,もんに向,むかって城,しろくずしを設,もうけ、塁,るいを築,きずき、雲悌,うんていを建,たてよと言,いう。","tok":[["["],["22"],["]"],["彼","かれ"],["の"],["右","みぎ"],["に"],["エルサレム"],["の"],["ため"],["に"],["占","うらない"],["が"],["出る","でる"],["。"],["すなわち"],["口","くち"],["を"],["開らいて","ひらいて"],["叫","さけび"],["、"],["声","こえ"],["を"],["あげ"],["、"],["とき"],["を"],["作り","つくり"],["、"],["門","もん"],["に"],["向かって","むかって"],["城","しろ"],["くずし"],["を"],["設け","もうけ"],["、"],["塁","るい"],["を"],["築き","きずき"],["、"],["雲","くも"],["悌","てい"],["を"],["建てよ","たてよ"],["と"],["言う","いう"],["。"]]},{"verse":28,"text":"[23]しかしこれは彼,かれらの目,めには偽,いつわりの占,うらないと思,おもわれ、彼,かれらは堅,かたき誓,ちかいをなした。しかし彼,かれは、彼,かれらを捕,とらえることによって、罪,つみを思,おもい出,ださせる。","tok":[["["],["23"],["]"],["しかし"],["これ"],["は"],["彼","かれ"],["ら"],["の"],["目","め"],["に"],["は"],["偽わり","いつわり"],["の"],["占","うらない"],["と"],["思われ","おもわれ"],["、"],["彼","かれ"],["ら"],["は"],["堅","か"],["たき"],["誓い","ちかい"],["を"],["なした"],["。"],["しかし"],["彼","かれ"],["は"],["、"],["彼","かれ"],["ら"],["を"],["捕らえる","とらえる"],["こと"],["によって"],["、"],["罪","つみ"],["を"],["思い出させる","おもいださせる"],["。"]]},{"verse":29,"text":"[24]それゆえ、主,しゅなる神,かみはこう言,いわれる、あなたがたの罪,つみは覚,おぼえられ、その反逆,はんぎゃくは現,あらわれ、その罪,つみはすべてのわざに現,あらわれる。このようにあなたがたは、すでに覚,おぼえられているから、彼,かれらの手,てに捕,とらえられる。","tok":[["["],["24"],["]"],["それ"],["ゆえ"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["あなた"],["がた"],["の"],["罪","つみ"],["は"],["覚えられ","おぼえられ"],["、"],["その"],["反逆","はんぎゃく"],["は"],["現われ","あらわれ"],["、"],["その"],["罪","つみ"],["は"],["すべて"],["の"],["わざ"],["に"],["現われる","あらわれる"],["。"],["この"],["よう"],["に"],["あなた"],["がた"],["は"],["、"],["すでに"],["覚えられて","おぼえられて"],["いる"],["から"],["、"],["彼","かれ"],["ら"],["の"],["手","て"],["に"],["捕らえられる","とらえられる"],["。"]]},{"verse":30,"text":"[25]汚,けがれた悪人,あくにんであるイスラエルの君,きみよ、あなたの終,おわりの刑罰,けいばつの時,ときであるその日,ひが来,くる。","tok":[["["],["25"],["]"],["汚","け"],["がれ"],["た"],["悪人","あくにん"],["で"],["ある"],["イスラエル"],["の"],["君","きみ"],["よ"],["、"],["あなた"],["の"],["終","おわり"],["の"],["刑罰","けいばつ"],["の"],["時","とき"],["で"],["ある"],["その"],["日","ひ"],["が"],["来る","くる"],["。"]]},{"verse":31,"text":"[26]主,しゅなる神,かみはこう言,いわれる、かぶり物,ものを脱,ぬぎ、冠,かんむりを取,とり離,はなせ。すべてのものは、そのままには残,のこらない。卑,いやしい者,ものは高,たかくされ、高,たかい者,ものは卑,いやしくされる。","tok":[["["],["26"],["]"],["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["かぶり物","かぶりもの"],["を"],["脱ぎ","ぬぎ"],["、"],["冠","かんむり"],["を"],["取離せ","とりはなせ"],["。"],["すべて"],["の"],["もの"],["は"],["、"],["そのまま"],["に"],["は"],["残らない","のこらない"],["。"],["卑しい","いやしい"],["者","もの"],["は"],["高かく","たかく"],["され"],["、"],["高かい","たかい"],["者","もの"],["は"],["卑しく","いやしく"],["される"],["。"]]},{"verse":32,"text":"[27]ああ破滅,はめつ、破滅,はめつ、破滅,はめつ、わたしはこれをこさせる。わたしが与,あたえる権威,けんいをもつ者,ものが来,くる時,ときまで、その跡形,あとかたさえも残,のこらない。","tok":[["["],["27"],["]"],["ああ"],["破滅","はめつ"],["、"],["破滅","はめつ"],["、"],["破滅","はめつ"],["、"],["わたし"],["は"],["これ"],["を"],["こさせる"],["。"],["わたし"],["が"],["与える","あたえる"],["権威","けんい"],["を"],["もつ"],["者","もの"],["が"],["来る","くる"],["時","とき"],["まで"],["、"],["その"],["跡形","あとかた"],["さえ"],["も"],["残らない","のこらない"],["。"]]},{"verse":33,"text":"[28]人,ひとの子,こよ、預言,よげんして言,いえ。主,しゅなる神,かみはアンモンの人々,ひとびとと、そのあざけりについて、こう言,いわれる、つるぎがある。このつるぎは殺,ころすために抜,ぬかれ、いなずまのようにひかりきらめくようにとがれている。","tok":[["["],["28"],["]"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["預言","よげん"],["して"],["言え","いえ"],["。"],["主","しゅ"],["なる"],["神","かみ"],["は"],["アンモン"],["の"],["人々","ひとびと"],["と"],["、"],["その"],["あざけり"],["について"],["、"],["こう"],["言われる","いわれる"],["、"],["つるぎ"],["が"],["ある"],["。"],["この"],["つるぎ"],["は"],["殺ろす","ころす"],["ため"],["に"],["抜かれ","ぬかれ"],["、"],["いなずま"],["の"],["よう"],["に"],["ひかり"],["きらめく"],["よう"],["に"],["とがれて"],["いる"],["。"]]},{"verse":34,"text":"[29]彼,かれらがあなたに偽,いつわりの幻,まぼろしを示,しめし、偽,いつわりを占,うらなったゆえ、これは殺,ころさるべき悪,あしき者,ものの首,くびの上,うえに置,おかれる。彼,かれらの終,おわりの刑罰,けいばつの時,ときであるその日,ひがきている。","tok":[["["],["29"],["]"],["彼","かれ"],["ら"],["が"],["あなた"],["に"],["偽わり","いつわり"],["の"],["幻","まぼろし"],["を"],["示めし","しめし"],["、"],["偽り","いつわり"],["を"],["占った","うらなった"],["ゆえ"],["、"],["これ"],["は"],["殺さるべき","ころさるべき"],["悪しき","あしき"],["者","もの"],["の"],["首","くび"],["の"],["上","うえ"],["に"],["置かれる","おかれる"],["。"],["彼","かれ"],["ら"],["の"],["終","おわり"],["の"],["刑罰","けいばつ"],["の"],["時","とき"],["で"],["ある"],["その"],["日","ひ"],["が"],["きて"],["いる"],["。"]]},{"verse":35,"text":"[30]これをさやに納,おさめよ、わたしはあなたの造,つくられた所,ところ、あなたの生,うまれた地,ちであなたをさばく。","tok":[["["],["30"],["]"],["これ"],["を"],["さや"],["に"],["納","おさめ"],["よ"],["、"],["わたし"],["は"],["あなた"],["の"],["造られた","つくられた"],["所","ところ"],["、"],["あなた"],["の"],["生まれた","うまれた"],["地","ち"],["で"],["あなた"],["を"],["さばく"],["。"]]},{"verse":36,"text":"[31]わたしの怒,いかりをあなたに注,そそぎ、わたしの憤,いきどおりの火,ひをあなたに向,むけて燃,もやし、滅,ほろぼすことに巧,たくみな残忍,ざんにんな人,ひとの手,てにあなたを渡,わたす。","tok":[["["],["31"],["]"],["わたし"],["の"],["怒り","いかり"],["を"],["あなた"],["に"],["注ぎ","そそぎ"],["、"],["わたし"],["の"],["憤り","いきどおり"],["の"],["火","ひ"],["を"],["あなた"],["に"],["向けて","むけて"],["燃やし","もやし"],["、"],["滅ぼす","ほろぼす"],["こと"],["に"],["巧み","たくみ"],["な"],["残忍","ざんにん"],["な"],["人","ひと"],["の"],["手","て"],["に"],["あなた"],["を"],["渡す","わたす"],["。"]]},{"verse":37,"text":"[32]あなたは火,ひのための、たきぎとなり、あなたの血,ちは国,くにの中,なかに流,ながされ、覚,おぼえられることはない、主,しゅなるわたしが言,いう」。","tok":[["["],["32"],["]"],["あなた"],["は"],["火","ひ"],["の"],["ため"],["の"],["、"],["たきぎ"],["と"],["なり"],["、"],["あなた"],["の"],["血","ち"],["は"],["国","くに"],["の"],["中","なか"],["に"],["流され","ながされ"],["、"],["覚えられる","おぼえられる"],["こと"],["は"],["ない"],["、"],["主","しゅ"],["なる"],["わたし"],["が"],["言う","いう"],["」"],["。"]]}]
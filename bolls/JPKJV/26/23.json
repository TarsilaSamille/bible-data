[{"verse":1,"text":"主,しゅの言葉,ことばがわたしに臨,のぞんだ、","tok":[["主","しゅ"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":2,"text":"「人,ひとの子,こよ、ここにふたりの女,おんながあった。ひとりの母,ははの娘,むすめである。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["ここ"],["に"],["ふたり"],["の"],["女","おんな"],["が"],["あった"],["。"],["ひとり"],["の"],["母","はは"],["の"],["娘","むすめ"],["で"],["ある"],["。"]]},{"verse":3,"text":"彼,かれらはエジプトで淫行,いんこうをした。彼,かれらは若,わかい時,ときに淫行,いんこうをした。すなわちその所,ところで彼,かれらの胸,むねは押,おされ、その処女,しょじょの乳,ちぶさはいじられた。","tok":[["彼","かれ"],["ら"],["は"],["エジプト"],["で"],["淫行","いんこう"],["を"],["した"],["。"],["彼","かれ"],["ら"],["は"],["若い","わかい"],["時","とき"],["に"],["淫行","いんこう"],["を"],["した"],["。"],["すなわち"],["その"],["所","ところ"],["で"],["彼","かれ"],["ら"],["の"],["胸","むね"],["は"],["押され","おされ"],["、"],["その"],["処女","しょじょ"],["の"],["乳ぶさ","ちぶさ"],["は"],["いじられた"],["。"]]},{"verse":4,"text":"彼,かれらの名,なは姉,あねはアホラ、妹,いもうとはアホリバである。彼,かれらはわたしのものとなって、むすこ娘,むすめたちを産,うんだ。その本名,ほんみょうはアホラはサマリヤ、アホリバはエルサレムである。","tok":[["彼","かれ"],["ら"],["の"],["名","な"],["は"],["姉","あね"],["は"],["アホラ"],["、"],["妹","いもうと"],["は"],["アホリバ"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["わたし"],["の"],["もの"],["と"],["なって"],["、"],["むすこ"],["娘","むすめ"],["たち"],["を"],["産んだ","うんだ"],["。"],["その"],["本名","ほんみょう"],["は"],["アホラ"],["は"],["サマリヤ"],["、"],["アホリバ"],["は"],["エルサレム"],["で"],["ある"],["。"]]},{"verse":5,"text":"アホラはわたしのものである間,あいだに淫行,いんこうをなし、その恋人,こいびとなるアッスリヤびとにこがれた。","tok":[["アホラ"],["は"],["わたし"],["の"],["もの"],["で"],["ある"],["間","あいだ"],["に"],["淫行","いんこう"],["を"],["なし"],["、"],["その"],["恋人","こいびと"],["なる"],["アッスリヤ"],["びと"],["に"],["こがれた"],["。"]]},{"verse":6,"text":"すなわち紫,むらさきの衣,ころもをきた軍人,ぐんじん、長官,ちょうかん、司令,しれい官,かん、すべて好,このましい若者,わかもの、馬,うまに乗,のる者,ものたちである。","tok":[["すなわち"],["紫","むらさき"],["の"],["衣","ころも"],["を"],["きた"],["軍人","ぐんじん"],["、"],["長官","ちょうかん"],["、"],["司令官","しれいかん"],["、"],["すべて"],["好しい","このましい"],["若者","わかもの"],["、"],["馬","うま"],["に"],["乗る","のる"],["者","もの"],["たち"],["で"],["ある"],["。"]]},{"verse":7,"text":"彼女,かのじょは彼,かれらに淫行,いんこうを供,そなえた。彼,かれらはすべてアッスリヤのえり抜,ぬきの人々,ひとびとである。彼女,かのじょはまた、そのこがれたすべての者,もののもろもろの偶像,ぐうぞうをもって、おのれを汚,けがした。","tok":[["彼女","かのじょ"],["は"],["彼","かれ"],["ら"],["に"],["淫行","いんこう"],["を"],["供えた","そなえた"],["。"],["彼","かれ"],["ら"],["は"],["すべて"],["アッスリヤ"],["の"],["えり抜き","えりぬき"],["の"],["人々","ひとびと"],["で"],["ある"],["。"],["彼女","かのじょ"],["は"],["また"],["、"],["その"],["こがれた"],["すべて"],["の"],["者","もの"],["の"],["もろもろ"],["の"],["偶像","ぐうぞう"],["を"],["もって"],["、"],["おのれ"],["を"],["汚","け"],["がした"],["。"]]},{"verse":8,"text":"彼女,かのじょはエジプトの日,ひからおこなっていた、その淫行,いんこうを捨,すてなかった。それは彼女,かのじょの若,わかい時,ときに、彼,かれらが彼女,かのじょと寝,ね、その処女,しょじょの乳,ちぶさをいじり、その情欲,じょうよくを彼女,かのじょの上,うえに注,そそいだからである。","tok":[["彼女","かのじょ"],["は"],["エジプト"],["の"],["日","ひ"],["から"],["おこなって"],["いた"],["、"],["その"],["淫行","いんこう"],["を"],["捨てなかった","すてなかった"],["。"],["それ"],["は"],["彼女","かのじょ"],["の"],["若い","わかい"],["時","とき"],["に"],["、"],["彼","かれ"],["ら"],["が"],["彼女","かのじょ"],["と"],["寝","ね"],["、"],["その"],["処女","しょじょ"],["の"],["乳ぶさ","ちぶさ"],["を"],["いじり"],["、"],["その"],["情欲","じょうよく"],["を"],["彼女","かのじょ"],["の"],["上","うえ"],["に"],["注いだ","そそいだ"],["から"],["で"],["ある"],["。"]]},{"verse":9,"text":"それゆえ、わたしは彼女,かのじょをその恋人,こいびとの手,てに渡,わたし、そのこがれたアッスリヤの人々,ひとびとの手,てに渡,わたした。","tok":[["それ"],["ゆえ"],["、"],["わたし"],["は"],["彼女","かのじょ"],["を"],["その"],["恋人","こいびと"],["の"],["手","て"],["に"],["渡","わたし"],["、"],["その"],["こがれた"],["アッスリヤ"],["の"],["人々","ひとびと"],["の"],["手","て"],["に"],["渡","わたし"],["た"],["。"]]},{"verse":10,"text":"彼,かれらは彼女,かのじょの裸,はだかを現,あらわし、そのむすこ娘,むすめたちを奪,うばい、つるぎをもって彼女,かのじょを殺,ころした。こうして彼女,かのじょに対,たいするさばきが行,おこなわれたとき、彼女,かのじょは女,おんなたちの間,あいだの語,かたり草,くさとなった。","tok":[["彼","かれ"],["ら"],["は"],["彼女","かのじょ"],["の"],["裸","はだか"],["を"],["現わし","あらわし"],["、"],["その"],["むすこ"],["娘","むすめ"],["たち"],["を"],["奪い","うばい"],["、"],["つるぎ"],["を"],["もって"],["彼女","かのじょ"],["を"],["殺ろした","ころした"],["。"],["こう"],["して"],["彼女","かのじょ"],["に"],["対する","たいする"],["さばき"],["が"],["行なわれた","おこなわれた"],["とき"],["、"],["彼女","かのじょ"],["は"],["女","おんな"],["たち"],["の"],["間","あいだ"],["の"],["語り草","かたりくさ"],["と"],["なった"],["。"]]},{"verse":11,"text":"その妹,いもうとアホリバはこれを見,みて、姉,あねよりも情欲,じょうよくをほしいままにし、姉,あねの淫行,いんこうよりも多,おおく淫行,いんこうをなし、","tok":[["その"],["妹","いもうと"],["アホリバ"],["は"],["これ"],["を"],["見て","みて"],["、"],["姉","あね"],["より"],["も"],["情欲","じょうよく"],["を"],["ほしいまま"],["に"],["し"],["、"],["姉","あね"],["の"],["淫行","いんこう"],["より"],["も"],["多く","おおく"],["淫行","いんこう"],["を"],["なし"],["、"]]},{"verse":12,"text":"アッスリヤの人々,ひとびとに恋,こいこがれた。長官,ちょうかん、司令,しれい官,かん、盛装,せいそうした軍人,ぐんじん、馬,うまに乗,のる者,ものたちで、すべて好,このましい若者,わかものたちである。","tok":[["アッスリヤ"],["の"],["人々","ひとびと"],["に"],["恋","こい"],["こがれた"],["。"],["長官","ちょうかん"],["、"],["司令官","しれいかん"],["、"],["盛装","せいそう"],["した"],["軍人","ぐんじん"],["、"],["馬","うま"],["に"],["乗る","のる"],["者","もの"],["たち"],["で"],["、"],["すべて"],["好しい","このましい"],["若者","わかもの"],["たち"],["で"],["ある"],["。"]]},{"verse":13,"text":"わたしは彼女,かのじょが身,みを汚,けがしたのを見,みた。彼,かれらは共,ともに一つの道,みちをたどったが、","tok":[["わたし"],["は"],["彼女","かのじょ"],["が"],["身","み"],["を"],["汚","け"],["がした"],["の"],["を"],["見た","みた"],["。"],["彼","かれ"],["ら"],["は"],["共","とも"],["に"],["一","ひと"],["つ"],["の"],["道","みち"],["を"],["たどった"],["が"],["、"]]},{"verse":14,"text":"彼女,かのじょはさらにその淫行,いんこうを続,つづけ、壁,かべに描,えがいた人々,ひとびとを見,みた。すなわち朱,しゅで描,えがいたカルデヤびとの像,ぞうで、","tok":[["彼女","かのじょ"],["は"],["さらに"],["その"],["淫行","いんこう"],["を"],["続け","つづけ"],["、"],["壁","かべ"],["に"],["描いた","えがいた"],["人々","ひとびと"],["を"],["見た","みた"],["。"],["すなわち"],["朱","しゅ"],["で"],["描いた","えがいた"],["カルデヤ"],["びと"],["の"],["像","ぞう"],["で"],["、"]]},{"verse":15,"text":"腰,こしには帯,おびを結,むすび、頭,あたまにはたれさがったずきんをいただいていた。これらはみな官吏,かんりのような姿,すがたで、その生,うまれた国,くにカルデヤのバビロン人,ひとに似,にていた。","tok":[["腰","こし"],["に"],["は"],["帯","おび"],["を"],["結び","むすび"],["、"],["頭","あたま"],["に"],["は"],["たれさがった"],["ずきん"],["を"],["いただいて"],["いた"],["。"],["これ"],["ら"],["は"],["みな"],["官吏","かんり"],["の"],["よう"],["な"],["姿","すがた"],["で"],["、"],["その"],["生まれた","うまれた"],["国","くに"],["カルデヤ"],["の"],["バビロン"],["人","ひと"],["に"],["似て","にて"],["いた"],["。"]]},{"verse":16,"text":"彼女,かのじょはこれらを見,みて、これに恋,こいこがれ、使者,ししゃをカルデヤの彼,かれらのもとに送,おくった。","tok":[["彼女","かのじょ"],["は"],["これ"],["ら"],["を"],["見て","みて"],["、"],["これ"],["に"],["恋","こい"],["こがれ"],["、"],["使者","ししゃ"],["を"],["カルデヤ"],["の"],["彼","かれ"],["ら"],["の"],["もと"],["に"],["送った","おくった"],["。"]]},{"verse":17,"text":"そこでバビロンの人々,ひとびとは彼女,かのじょのもとに来,きて、恋,こいの床,とこにつき、情欲,じょうよくをもって彼女,かのじょを汚,けがしたが、彼女,かのじょは彼,かれらに汚,けがされるにおよんで、その心,こころは彼,かれらから離,はなれた。","tok":[["そこ"],["で"],["バビロン"],["の"],["人々","ひとびと"],["は"],["彼女","かのじょ"],["の"],["もと"],["に"],["来て","きて"],["、"],["恋","こい"],["の"],["床","とこ"],["に"],["つき"],["、"],["情欲","じょうよく"],["を"],["もって"],["彼女","かのじょ"],["を"],["汚","け"],["がした"],["が"],["、"],["彼女","かのじょ"],["は"],["彼","かれ"],["ら"],["に"],["汚","け"],["が"],["される"],["に"],["およんで"],["、"],["その"],["心","こころ"],["は"],["彼","かれ"],["ら"],["から"],["離れた","はなれた"],["。"]]},{"verse":18,"text":"彼女,かのじょがその淫行,いんこうを公然,こうぜんと続,つづけ、その裸,はだかをさらしたので、わたしの心,こころは彼女,かのじょから離,はなれた。これはあたかもわたしの心,こころが、彼女,かのじょの姉,あねから離,はなれたと同様,どうようである。","tok":[["彼女","かのじょ"],["が"],["その"],["淫行","いんこう"],["を"],["公然","こうぜん"],["と"],["続け","つづけ"],["、"],["その"],["裸","はだか"],["を"],["さらした"],["ので"],["、"],["わたし"],["の"],["心","こころ"],["は"],["彼女","かのじょ"],["から"],["離れた","はなれた"],["。"],["これ"],["は"],["あたかも"],["わたし"],["の"],["心","こころ"],["が"],["、"],["彼女","かのじょ"],["の"],["姉","あね"],["から"],["離れた","はなれた"],["と"],["同様","どうよう"],["で"],["ある"],["。"]]},{"verse":19,"text":"しかし彼女,かのじょはなおエジプトの地,ちで姦淫,かんいんをしたその若,わかき日,ひを覚,おぼえて、その淫行,いんこうを続,つづけ、","tok":[["しかし"],["彼女","かのじょ"],["は"],["なお"],["エジプト"],["の"],["地","ち"],["で"],["姦淫","かんいん"],["を"],["した"],["その"],["若き","わかき"],["日","ひ"],["を"],["覚えて","おぼえて"],["、"],["その"],["淫行","いんこう"],["を"],["続け","つづけ"],["、"]]},{"verse":20,"text":"その情夫,じょうふたちに恋,こいこがれた。その人,ひとの肉,にくは、ろばの肉,にくのごとく、その精,せいは馬,うまの精,せいのようであった。","tok":[["その"],["情夫","じょうふ"],["たち"],["に"],["恋","こい"],["こがれた"],["。"],["その"],["人","ひと"],["の"],["肉","にく"],["は"],["、"],["ろば"],["の"],["肉","にく"],["の"],["ごとく"],["、"],["その"],["精","せい"],["は"],["馬","うま"],["の"],["精","せい"],["の"],["よう"],["で"],["あった"],["。"]]},{"verse":21,"text":"このようにあなたは、かのエジプトびとが、あなたの胸,むねに手,てをつけ、あなたの若,わかい乳,ちぶさをおさえた時,ときの、若,わかい時,ときの淫行,いんこうを慕,したっている」。","tok":[["この"],["よう"],["に"],["あなた"],["は"],["、"],["かの"],["エジプト"],["びと"],["が"],["、"],["あなた"],["の"],["胸","むね"],["に"],["手","て"],["を"],["つけ"],["、"],["あなた"],["の"],["若い","わかい"],["乳ぶさ","ちぶさ"],["を"],["おさえた"],["時","とき"],["の"],["、"],["若い","わかい"],["時","とき"],["の"],["淫行","いんこう"],["を"],["慕って","したって"],["いる"],["」"],["。"]]},{"verse":22,"text":"それゆえ、アホリバよ、主,しゅなる神,かみはこう言,いわれる、「見,みよ、わたしは、あなたの心,こころがすでに離,はなれたあなたの恋人,こいびとらを起,おこして、あなたを攻,せめさせ、彼,かれらに四方,しほうから来,きてあなたを攻,せめさせる。","tok":[["それ"],["ゆえ"],["、"],["アホリバ"],["よ"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["「"],["見よ","みよ"],["、"],["わたし"],["は"],["、"],["あなた"],["の"],["心","こころ"],["が"],["すでに"],["離れた","はなれた"],["あなた"],["の"],["恋人","こいびと"],["ら"],["を"],["起こして","おこして"],["、"],["あなた"],["を"],["攻めさせ","せめさせ"],["、"],["彼","かれ"],["ら"],["に"],["四方","しほう"],["から"],["来て","きて"],["あなた"],["を"],["攻めさせる","せめさせる"],["。"]]},{"verse":23,"text":"すなわちバビロンの人々,ひとびとおよびカルデヤのすべての人々,ひとびと、ペコデ、ショア、コア、アッスリヤのすべての人々,ひとびと、好,このましい若者,わかもの、長官,ちょうかん、司令,しれい官,かん、官吏,かんり、軍人,ぐんじんなど、すべて馬,うまに乗,のる者,ものたちである。","tok":[["すなわち"],["バビロン"],["の"],["人々","ひとびと"],["および"],["カルデヤ"],["の"],["すべて"],["の"],["人々","ひとびと"],["、"],["ペコデ"],["、"],["ショア"],["、"],["コア"],["、"],["アッスリヤ"],["の"],["すべて"],["の"],["人々","ひとびと"],["、"],["好しい","このましい"],["若者","わかもの"],["、"],["長官","ちょうかん"],["、"],["司令官","しれいかん"],["、"],["官吏","かんり"],["、"],["軍人","ぐんじん"],["など"],["、"],["すべて"],["馬","うま"],["に"],["乗る","のる"],["者","もの"],["たち"],["で"],["ある"],["。"]]},{"verse":24,"text":"彼,かれらは戦車,せんしゃ、貨車,かしゃ、および多,おおくの民,たみを率,ひきいて、北,きたからあなたに攻,せめて来,くる。大盾,おおだて、小盾,こだて、かぶとを備,そなえて、四方,しほうからあなたに攻,せめかかる。わたしが彼,かれらにさばきをゆだねるゆえ、彼,かれらは、そのおきてに従,したがって、あなたをさばく。","tok":[["彼","かれ"],["ら"],["は"],["戦車","せんしゃ"],["、"],["貨車","かしゃ"],["、"],["および"],["多く","おおく"],["の"],["民","たみ"],["を"],["率いて","ひきいて"],["、"],["北","きた"],["から"],["あなた"],["に"],["攻めて","せめて"],["来る","くる"],["。"],["大","だい"],["盾","たて"],["おだて"],["、"],["小","こ"],["盾","たて"],["だて"],["、"],["かぶと"],["を"],["備","そなえ"],["て"],["、"],["四方","しほう"],["から"],["あなた"],["に"],["攻めかかる","せめかかる"],["。"],["わたし"],["が"],["彼","かれ"],["ら"],["に"],["さばき"],["を"],["ゆだねる"],["ゆえ"],["、"],["彼","かれ"],["ら"],["は"],["、"],["その"],["おきて"],["に"],["従って","したがって"],["、"],["あなた"],["を"],["さばく"],["。"]]},{"verse":25,"text":"わたしはあなたに向,むかってわたしの憤,いきどおりを起,おこすゆえ、彼,かれらは怒,いかりをもってあなたを扱,あつかい、あなたの鼻,はなと耳,みみとを切,きり落,おとし、そして残,のこりの者,ものはつるぎに倒,たおれる。彼,かれらはあなたのむすこ娘,むすめたちを奪,うばい、生,いき残,のこった者,ものを火,ひで焼,やく。","tok":[["わたし"],["は"],["あなた"],["に"],["向かって","むかって"],["わたし"],["の"],["憤り","いきどおり"],["を"],["起こす","おこす"],["ゆえ"],["、"],["彼","かれ"],["ら"],["は"],["怒り","いかり"],["を"],["もって"],["あなた"],["を"],["扱い","あつかい"],["、"],["あなた"],["の"],["鼻","はな"],["と"],["耳","みみ"],["と"],["を"],["切り落とし","きりおとし"],["、"],["そして"],["残り","のこり"],["の"],["者","もの"],["は"],["つるぎ"],["に"],["倒れる","たおれる"],["。"],["彼","かれ"],["ら"],["は"],["あなた"],["の"],["むすこ"],["娘","むすめ"],["たち"],["を"],["奪い","うばい"],["、"],["生き残った","いきのこった"],["者","もの"],["を"],["火","ひ"],["で"],["焼く","やく"],["。"]]},{"verse":26,"text":"彼,かれらはまたあなたの衣服,いふくをはぎ取,とり、あなたの美,うつくしい飾,かざりを取,とり去,さる。","tok":[["彼","かれ"],["ら"],["は"],["また"],["あなた"],["の"],["衣服","いふく"],["を"],["はぎ"],["取","とり"],["、"],["あなた"],["の"],["美しい","うつくしい"],["飾","かざり"],["を"],["取去る","とりさる"],["。"]]},{"verse":27,"text":"こうしてわたしはあなたの淫乱,いんらんと、エジプトの地,ちから持,もって来,きた淫行,いんこうとを取,とり除,のぞき、重,かさねてあなたの目,めを、エジプトびとに向,むけて上,あげさせず、彼,かれらの事,ことを思,おもわないようにする。","tok":[["こう"],["して"],["わたし"],["は"],["あなた"],["の"],["淫乱","いんらん"],["と"],["、"],["エジプト"],["の"],["地","ち"],["から"],["持って","もって"],["来た","きた"],["淫行","いんこう"],["と"],["を"],["取除き","とりのぞき"],["、"],["重ねて","かさねて"],["あなた"],["の"],["目","め"],["を"],["、"],["エジプト"],["びと"],["に"],["向けて","むけて"],["上げさせず","あげさせず"],["、"],["彼","かれ"],["ら"],["の"],["事","こと"],["を"],["思わない","おもわない"],["よう"],["に"],["する"],["。"]]},{"verse":28,"text":"主,しゅなる神,かみはこう言,いわれる、見,みよ、わたしはあなたの憎,にくむ者,ものの手,て、あなたの心,こころの離,はなれた者,ものの手,てにあなたを渡,わたす。","tok":[["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["見よ","みよ"],["、"],["わたし"],["は"],["あなた"],["の"],["憎む","にくむ"],["者","もの"],["の"],["手","て"],["、"],["あなた"],["の"],["心","こころ"],["の"],["離れた","はなれた"],["者","もの"],["の"],["手","て"],["に"],["あなた"],["を"],["渡す","わたす"],["。"]]},{"verse":29,"text":"彼,かれらは憎,にくしみをもってあなたを扱,あつかい、あなたの所得,しょとくをことごとく取,とり去,さり、あなたを赤,あかはだかにし、あなたの淫行,いんこうの裸,はだかを現,あらわす。あなたの淫乱,いんらんと淫行,いんこうとのゆえに、","tok":[["彼","かれ"],["ら"],["は"],["憎しみ","にくしみ"],["を"],["もって"],["あなた"],["を"],["扱い","あつかい"],["、"],["あなた"],["の"],["所得","しょとく"],["を"],["ことごとく"],["取去り","とりさり"],["、"],["あなた"],["を"],["赤はだか","あかはだか"],["に"],["し"],["、"],["あなた"],["の"],["淫行","いんこう"],["の"],["裸","はだか"],["を"],["現わす","あらわす"],["。"],["あなた"],["の"],["淫乱","いんらん"],["と"],["淫行","いんこう"],["と"],["の"],["ゆえ"],["に"],["、"]]},{"verse":30,"text":"すなわち、あなたが異邦人,いほうじんを慕,したって姦淫,かんいんを行,おこない、彼,かれらの偶像,ぐうぞうをもって身,みを汚,けがしたゆえに、これらのことがあなたに臨,のぞむのだ。","tok":[["すなわち"],["、"],["あなた"],["が"],["異邦人","いほうじん"],["を"],["慕って","したって"],["姦淫","かんいん"],["を"],["行ない","おこない"],["、"],["彼","かれ"],["ら"],["の"],["偶像","ぐうぞう"],["を"],["もって"],["身","み"],["を"],["汚","け"],["がした"],["ゆえ"],["に"],["、"],["これ"],["ら"],["の"],["こと"],["が"],["あなた"],["に"],["臨む","のぞむ"],["の"],["だ"],["。"]]},{"verse":31,"text":"あなたはその姉,あねの道,みちを歩,あゆんだので、わたしも彼女,かのじょの杯,さかずきをあなたにわたす。","tok":[["あなた"],["は"],["その"],["姉","あね"],["の"],["道","みち"],["を"],["歩","あゆんだ"],["ので"],["、"],["わたし"],["も"],["彼女","かのじょ"],["の"],["杯","さかずき"],["を"],["あなた"],["に"],["わたす"],["。"]]},{"verse":32,"text":"主,しゅなる神,かみはこう言,いわれる、あなたは姉,あねの深,ふかい、大,おおきな杯,さかずきを飲,のみ、笑,わらい物,ものとなり、あざけりとなる、この杯,さかずきにはそれらが多,おおくこもっている。","tok":[["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["あなた"],["は"],["姉","あね"],["の"],["深い","ふかい"],["、"],["大きな","おおきな"],["杯","さかずき"],["を"],["飲み","のみ"],["、"],["笑","わらい"],["物","もの"],["と"],["なり"],["、"],["あざけり"],["と"],["なる"],["、"],["この"],["杯","さかずき"],["に"],["は"],["それ"],["ら"],["が"],["多く","おおく"],["こもって"],["いる"],["。"]]},{"verse":33,"text":"あなたは酔,よいと憂,うれいとに満,みたされる。驚,おどろきと滅,ほろびの杯,さかずき、これがあなたの姉,あねサマリヤの杯,さかずきである。","tok":[["あなた"],["は"],["酔","よい"],["と"],["憂","うれい"],["と"],["に"],["満たされる","みたされる"],["。"],["驚","おどろき"],["と"],["滅び","ほろび"],["の"],["杯","さかずき"],["、"],["これ"],["が"],["あなた"],["の"],["姉","あね"],["サマリヤ"],["の"],["杯","さかずき"],["で"],["ある"],["。"]]},{"verse":34,"text":"あなたはこれを飲,のみこれをかたむけ、あなたの髪,かみの毛,けをひきむしり、あなたの乳,ちぶさをかきさく。わたしがこれを言,いうと、主,しゅなる神,かみは言,いわれる。","tok":[["あなた"],["は"],["これ"],["を"],["飲み","のみ"],["これ"],["を"],["かたむけ"],["、"],["あなた"],["の"],["髪の毛","かみのけ"],["を"],["ひきむしり"],["、"],["あなた"],["の"],["乳ぶさ","ちぶさ"],["を"],["かきさく"],["。"],["わたし"],["が"],["これ"],["を"],["言","いう"],["と"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"]]},{"verse":35,"text":"それゆえ、主,しゅなる神,かみはこう言,いわれる、あなたはわたしを忘,わすれ、わたしをあなたのうしろに捨,すて去,さったゆえ、あなたは自分,じぶんの淫乱,いんらんと淫行,いんこうとの罪,つみを負,おわねばならぬ」。","tok":[["それ"],["ゆえ"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["あなた"],["は"],["わたし"],["を"],["忘","わすれ"],["、"],["わたし"],["を"],["あなた"],["の"],["うしろ"],["に"],["捨て","すて"],["去た","さった"],["ゆえ"],["、"],["あなた"],["は"],["自分","じぶん"],["の"],["淫乱","いんらん"],["と"],["淫行","いんこう"],["と"],["の"],["罪","つみ"],["を"],["負わねば","おわねば"],["ならぬ"],["」"],["。"]]},{"verse":36,"text":"主,しゅはわたしに言,いわれた、「人,ひとの子,こよ、あなたはアホラとアホリバをさばくのか。それならば彼,かれらにその憎,にくむべき事,ことを告,つげよ。","tok":[["主","しゅ"],["は"],["わたし"],["に"],["言われた","いわれた"],["、"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["あなた"],["は"],["アホラ"],["と"],["アホリバ"],["を"],["さばく"],["の"],["か"],["。"],["それ"],["ならば"],["彼","かれ"],["ら"],["に"],["その"],["憎むべき","にくむべき"],["事","こと"],["を"],["告","つげ"],["よ"],["。"]]},{"verse":37,"text":"彼,かれらは姦淫,かんいんを行,おこない、血,ちが彼,かれらの手,ての上,うえにある。彼,かれらはその偶像,ぐうぞうと姦淫,かんいんを行,おこない、またわたしに産,うんだ子,こらを、食物,しょくもつのために彼,かれらにささげた。","tok":[["彼","かれ"],["ら"],["は"],["姦淫","かんいん"],["を"],["行ない","おこない"],["、"],["血","ち"],["が"],["彼","かれ"],["ら"],["の"],["手","て"],["の"],["上","うえ"],["に"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["その"],["偶像","ぐうぞう"],["と"],["姦淫","かんいん"],["を"],["行ない","おこない"],["、"],["また"],["わたし"],["に"],["産んだ","うんだ"],["子","こ"],["ら"],["を"],["、"],["食物","しょくもつ"],["の"],["ため"],["に"],["彼","かれ"],["ら"],["に"],["ささげた"],["。"]]},{"verse":38,"text":"さらに彼,かれらは、わたしに対,たいしてこのようにした。すなわち、彼,かれらは同,おなじ日,ひにわたしの聖所,せいじょを汚,けがし、わたしの安息日,あんそくにちを犯,おかした。","tok":[["さらに"],["彼","かれ"],["ら"],["は"],["、"],["わたし"],["に対して","にたいして"],["この"],["よう"],["に"],["した"],["。"],["すなわち"],["、"],["彼","かれ"],["ら"],["は"],["同じ","おなじ"],["日","ひ"],["に"],["わたし"],["の"],["聖","せい"],["所","しょ"],["を"],["汚","け"],["がし"],["、"],["わたし"],["の"],["安息日","あんそくにち"],["を"],["犯した","おかした"],["。"]]},{"verse":39,"text":"彼,かれらはその子,こらを、偶像,ぐうぞうにささげるためにほふった同,おなじ日,ひに、わたしの聖所,せいじょにきて、これを汚,けがした。見,みよ、彼,かれらがわたしの家,いえの中,なかでしたことはこれである。","tok":[["彼","かれ"],["ら"],["は"],["その"],["子","こ"],["ら"],["を"],["、"],["偶像","ぐうぞう"],["に"],["ささげる"],["ため"],["に"],["ほふった"],["同じ","おなじ"],["日","ひ"],["に"],["、"],["わたし"],["の"],["聖","せい"],["所","しょ"],["に"],["きて"],["、"],["これ"],["を"],["汚","け"],["がした"],["。"],["見よ","みよ"],["、"],["彼","かれ"],["ら"],["が"],["わたし"],["の"],["家","いえ"],["の"],["中","なか"],["でした"],["こと"],["は"],["これ"],["で"],["ある"],["。"]]},{"verse":40,"text":"さらに彼,かれらは使者,ししゃをやって、遠,とおくから来,くるように人々,ひとびとを招,まねいた。見,みよ、彼,かれらはきた。あなたは、この人々,ひとびとのために身,みを洗,あらい、目,めを描,えがき、飾,かざり物,ものを身,みにつけ、","tok":[["さらに"],["彼","かれ"],["ら"],["は"],["使者","ししゃ"],["を"],["やって"],["、"],["遠く","とおく"],["から"],["来る","くる"],["よう"],["に"],["人々","ひとびと"],["を"],["招いた","まねいた"],["。"],["見よ","みよ"],["、"],["彼","かれ"],["ら"],["は"],["きた"],["。"],["あなた"],["は"],["、"],["この"],["人々","ひとびと"],["の"],["ため"],["に"],["身","み"],["を"],["洗","あらい"],["、"],["目","め"],["を"],["描き","えがき"],["、"],["飾","かざり"],["物","もの"],["を"],["身","み"],["に"],["つけ"],["、"]]},{"verse":41,"text":"尊,たっとい床,とこに座,ざし、食卓,しょくたくをその前,まえに設,もうけ、わたしの香,こうと、わたしの油,あぶらとを、その上,うえに供,そなえた。","tok":[["尊","た"],["っと"],["い"],["床","とこ"],["に"],["座し","ざし"],["、"],["食卓","しょくたく"],["を"],["その"],["前","まえ"],["に"],["設け","もうけ"],["、"],["わたし"],["の"],["香","こう"],["と"],["、"],["わたし"],["の"],["油","あぶら"],["と"],["を"],["、"],["その"],["上","うえ"],["に"],["供えた","そなえた"],["。"]]},{"verse":42,"text":"こうして、のんきな群衆,ぐんしゅうの声,こえは彼女,かのじょと共,ともにあり、また、荒野,あらのから連,つれて来,きた通,とおりがかりの酔,よいどれも、彼,かれらと共,ともにいた。彼,かれらは女,おんなたちの手,てに腕輪,うでわをはめさせ、頭,あたまに美,うつくしい冠,かんむりをいただかせた。","tok":[["こう"],["して"],["、"],["のんき"],["な"],["群衆","ぐんしゅう"],["の"],["声","こえ"],["は"],["彼女","かのじょ"],["と"],["共","とも"],["に"],["あり"],["、"],["また"],["、"],["荒野","あら"],["の"],["から"],["連れて","つれて"],["来た","きた"],["通りがかり","とおりがかり"],["の"],["酔","よい"],["どれ"],["も"],["、"],["彼","かれ"],["ら"],["と"],["共","とも"],["に"],["いた"],["。"],["彼","かれ"],["ら"],["は"],["女","おんな"],["たち"],["の"],["手","て"],["に"],["腕輪","うでわ"],["を"],["はめさせ"],["、"],["頭","あたま"],["に"],["美しい","うつくしい"],["冠","かんむり"],["を"],["いただかせた"],["。"]]},{"verse":43,"text":"そこでわたしは言,いった、彼女,かのじょと姦淫,かんいんを行,おこなう時,とき、人々,ひとびとは姦淫,かんいんを犯,おかさないであろうか。","tok":[["そこ"],["で"],["わたし"],["は"],["言った","いった"],["、"],["彼女","かのじょ"],["と"],["姦淫","かんいん"],["を"],["行なう","おこなう"],["時","とき"],["、"],["人々","ひとびと"],["は"],["姦淫","かんいん"],["を"],["犯さないで","おかさないで"],["あろう"],["か"],["。"]]},{"verse":44,"text":"人,ひとが遊女,ゆうじょの所,ところにはいるように、彼,かれらは彼女,かのじょの所,ところにはいった。こうして彼,かれらは姦淫,かんいんを行,おこなうために、アホラおよびアホリバの所,ところにはいった。","tok":[["人","ひと"],["が"],["遊女","ゆうじょ"],["の"],["所","ところ"],["に"],["は"],["いる"],["よう"],["に"],["、"],["彼","かれ"],["ら"],["は"],["彼女","かのじょ"],["の"],["所","ところ"],["に"],["はいった"],["。"],["こう"],["して"],["彼","かれ"],["ら"],["は"],["姦淫","かんいん"],["を"],["行なう","おこなう"],["ため"],["に"],["、"],["アホラ"],["および"],["アホリバ"],["の"],["所","ところ"],["に"],["はいった"],["。"]]},{"verse":45,"text":"しかし正,ただしい人々,ひとびとは淫婦,いんぷのさばきと、血,ちを流,ながした女,おんなのさばきとをもって、彼,かれらをさばく。それは彼,かれらが淫婦,いんぷであって、その手,てに血,ちがあるからである」。","tok":[["しかし"],["正い","ただしい"],["人々","ひとびと"],["は"],["淫婦","いんぷ"],["の"],["さばき"],["と"],["、"],["血","ち"],["を"],["流した","ながした"],["女","おんな"],["の"],["さばき"],["と"],["を"],["もって"],["、"],["彼","かれ"],["ら"],["を"],["さばく"],["。"],["それ"],["は"],["彼","かれ"],["ら"],["が"],["淫婦","いんぷ"],["で"],["あって"],["、"],["その"],["手","て"],["に"],["血","ち"],["が"],["ある"],["から"],["で"],["ある"],["」"],["。"]]},{"verse":46,"text":"主,しゅなる神,かみはこう言,いわれる、「わたしは軍隊,ぐんたいを彼,かれらに向,むかって攻,せめ上,のぼらせ、彼,かれらを恐,おそれと略奪,りゃくだつとに渡,わたす。","tok":[["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["「"],["わたし"],["は"],["軍隊","ぐんたい"],["を"],["彼","かれ"],["ら"],["に"],["向かって","むかって"],["攻め上らせ","せめのぼらせ"],["、"],["彼","かれ"],["ら"],["を"],["恐","おそれ"],["と"],["略奪","りゃくだつ"],["と"],["に"],["渡す","わたす"],["。"]]},{"verse":47,"text":"軍隊,ぐんたいは彼,かれらを石,いしで打,うち、つるぎで切,きり、そのむすこ娘,むすめたちを殺,ころし、火,ひでその家,いえを焼,やく。","tok":[["軍隊","ぐんたい"],["は"],["彼","かれ"],["ら"],["を"],["石","いし"],["で"],["打ち","うち"],["、"],["つるぎ"],["で"],["切り","きり"],["、"],["その"],["むすこ"],["娘","むすめ"],["たち"],["を"],["殺ろし","ころし"],["、"],["火","ひ"],["で"],["その"],["家","いえ"],["を"],["焼く","やく"],["。"]]},{"verse":48,"text":"こうしてわたしはこの地,ちに淫乱,いんらんを絶,たやす。すべての女,おんなはみずからいましめて、あなたがたがしたような淫乱,いんらんを行,おこなわない。","tok":[["こう"],["して"],["わたし"],["は"],["この"],["地","ち"],["に"],["淫乱","いんらん"],["を"],["絶やす","たやす"],["。"],["すべて"],["の"],["女","おんな"],["は"],["みずから"],["いましめて"],["、"],["あなた"],["がた"],["が"],["した"],["よう"],["な"],["淫乱","いんらん"],["を"],["行なわない","おこなわない"],["。"]]},{"verse":49,"text":"あなたがたの淫乱,いんらんの報,むくいは、あなたがたの上,うえにくだり、あなたがたはその偶像,ぐうぞう礼拝,れいはいの罪,つみを負,おい、そしてわたしが主,しゅなる神,かみであることを知,しるようになる」。","tok":[["あなた"],["がた"],["の"],["淫乱","いんらん"],["の"],["報い","むくい"],["は"],["、"],["あなた"],["がた"],["の"],["上","うえ"],["に"],["くだり"],["、"],["あなた"],["がた"],["は"],["その"],["偶像","ぐうぞう"],["礼拝","れいはい"],["の"],["罪","つみ"],["を"],["負い","おい"],["、"],["そして"],["わたし"],["が"],["主","しゅ"],["なる"],["神","かみ"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["」"],["。"]]}]
[{"verse":1,"text":"時,ときに主,しゅの言葉,ことばがわたしに臨,のぞんだ、","tok":[["時","とき"],["に"],["主","しゅ"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":2,"text":"「人,ひとの子,こよ、イスラエルの家,いえになぞをかけ、たとえを語,かたって、","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["イスラエル"],["の"],["家","いえ"],["に"],["なぞ"],["を"],["かけ"],["、"],["たとえ"],["を"],["語って","かたって"],["、"]]},{"verse":3,"text":"言,いえ。主,しゅなる神,かみがこう言,いわれる、さまざまの色,いろの羽毛,うもうを多,おおく持,もち、大,おおきな翼,つばさと、長,ながい羽根,はねとを持,もつ大,おおわしがレバノンに来,きて、香柏,こうはくのこずえにとまり、","tok":[["言え","いえ"],["。"],["主","しゅ"],["なる"],["神","かみ"],["が"],["こう"],["言われる","いわれる"],["、"],["さまざま"],["の"],["色","いろ"],["の"],["羽毛","うもう"],["を"],["多く","おおく"],["持","もち"],["、"],["大きな","おおきな"],["翼","つばさ"],["と"],["、"],["長い","ながい"],["羽根","はね"],["と"],["を"],["持つ","もつ"],["大わし","おおわし"],["が"],["レバノン"],["に"],["来て","きて"],["、"],["香","こう"],["柏","かしわ"],["の"],["こずえ"],["に"],["とまり"],["、"]]},{"verse":4,"text":"その若,わか枝,えだの頂,いただきを摘,つみ切,きり、これを商業,しょうぎょうの地,ちに運,はこび、商人,しょうにんの町,まちに置,おいた。","tok":[["その"],["若枝","わかえだ"],["の"],["頂","いただき"],["を"],["摘み","つみ"],["切り","きり"],["、"],["これ"],["を"],["商業","しょうぎょう"],["の"],["地","ち"],["に"],["運こび","はこび"],["、"],["商人","しょうにん"],["の"],["町","まち"],["に"],["置いた","おいた"],["。"]]},{"verse":5,"text":"またその地,ちの種,たねをとって、これを肥,こえた土,つちに植,うえた。すなわち水,みずの多,おおい所,ところにもって行,いって、柳,やなぎを植,うえるようにこれを植,うえた。","tok":[["また"],["その"],["地","ち"],["の"],["種","たね"],["を"],["とって"],["、"],["これ"],["を"],["肥","こえ"],["た"],["土","つち"],["に"],["植えた","うえた"],["。"],["すなわち"],["水","みず"],["の"],["多い","おおい"],["所","ところ"],["に"],["もって"],["行って","いって"],["、"],["柳","やなぎ"],["を"],["植える","うえる"],["よう"],["に"],["これ"],["を"],["植えた","うえた"],["。"]]},{"verse":6,"text":"これが成長,せいちょうして、たけ低,ひくく、はびこるぶどうの木,きとなり、枝,えだはわしに向,むかい、根,ねはわしの下,したにあり、こうしてついにぶどうの木,きとなり、枝,えだを伸,のばし、葉,はを出,だした。","tok":[["これ"],["が"],["成長","せいちょう"],["して"],["、"],["たけ"],["低く","ひくく"],["、"],["はびこる"],["ぶどう"],["の"],["木","き"],["と"],["なり"],["、"],["枝","えだ"],["は"],["わし"],["に"],["向","むかい"],["、"],["根","ね"],["は"],["わし"],["の"],["下","した"],["に"],["あり"],["、"],["こう"],["して"],["ついに"],["ぶどう"],["の"],["木","き"],["と"],["なり"],["、"],["枝","えだ"],["を"],["伸ばし","のばし"],["、"],["葉","は"],["を"],["出した","だした"],["。"]]},{"verse":7,"text":"ここにまた大,おおきな翼,つばさと、羽毛,うもうの多,おおいほかの一羽,わの大,おおわしがあった。見,みよ、このぶどうの木,きは、潤,うるおいを得,えるために、その根,ねをわしに向,むかってまげ、その枝,えだをわしに向,むかって伸,のばした。","tok":[["ここ"],["に"],["また"],["大きな","おおきな"],["翼","つばさ"],["と"],["、"],["羽毛","うもう"],["の"],["多い","おおい"],["ほか"],["の"],["一羽","わ"],["の"],["大わし","おおわし"],["が"],["あった"],["。"],["見よ","みよ"],["、"],["この"],["ぶどう"],["の"],["木","き"],["は"],["、"],["潤い","うるおい"],["を"],["得る","える"],["ため"],["に"],["、"],["その"],["根","ね"],["を"],["わし"],["に"],["向かって","むかって"],["まげ"],["、"],["その"],["枝","えだ"],["を"],["わし"],["に"],["向かって","むかって"],["伸ばした","のばした"],["。"]]},{"verse":8,"text":"これが枝,えだを出,だし、実,みを結,むすび、みごとなぶどうの木,きとなるために、わしはこれを植,うえた苗床,なえどこから水,みずの多,おおい良,よい地,ちに移,うつし植,うえた。","tok":[["これ"],["が"],["枝","えだ"],["を"],["出し","だし"],["、"],["実","み"],["を"],["結び","むすび"],["、"],["みごと"],["な"],["ぶどう"],["の"],["木","き"],["と"],["なる"],["ため"],["に"],["、"],["わし"],["は"],["これ"],["を"],["植えた","うえた"],["苗床","なえどこ"],["から"],["水","みず"],["の"],["多い","おおい"],["良い","よい"],["地","ち"],["に"],["移し植えた","うつしうえた"],["。"]]},{"verse":9,"text":"あなたは、主,しゅなる神,かみがこう言,いわれると言,いえ、これは栄,さかえるであろうか。わしはその根,ねを抜,ぬき、その枝,えだを切,きり、その若葉,わかばを皆,みな枯,からさないであろうか。これをその根,ねからあげるには、強,つよい腕,うでや多,おおくの民,たみを必要,ひつようとしない。","tok":[["あなた"],["は"],["、"],["主","しゅ"],["なる"],["神","かみ"],["が"],["こう"],["言われる","いわれる"],["と"],["言え","いえ"],["、"],["これ"],["は"],["栄","さかえ"],["るで"],["あろう"],["か"],["。"],["わし"],["は"],["その"],["根","ね"],["を"],["抜き","ぬき"],["、"],["その"],["枝","えだ"],["を"],["切り","きり"],["、"],["その"],["若葉","わかば"],["を"],["皆","みな"],["枯らさないで","からさないで"],["あろう"],["か"],["。"],["これ"],["を"],["その"],["根","ね"],["から"],["あげる"],["に"],["は"],["、"],["強い","つよい"],["腕","うで"],["や"],["多く","おおく"],["の"],["民","たみ"],["を"],["必要","ひつよう"],["と"],["しない"],["。"]]},{"verse":10,"text":"見,みよ、それが移,うつし植,うえられたら、また栄,さかえるであろうか。東風,ひがしかぜがこれを打,うつ時,とき、それは枯,かれてしまわないであろうか。その育,そだった苗床,なえどこで枯,かれないであろうか」。","tok":[["見よ","みよ"],["、"],["それ"],["が"],["移し植えられたら","うつしうえられたら"],["、"],["また"],["栄","さかえ"],["るで"],["あろう"],["か"],["。"],["東風","ひ"],["が"],["し"],["かぜ"],["が"],["これ"],["を"],["打つ","うつ"],["時","とき"],["、"],["それ"],["は"],["枯て","かれて"],["しまわないで"],["あろう"],["か"],["。"],["その"],["育った","そだった"],["苗床","なえどこ"],["で"],["枯ないで","かれないで"],["あろう"],["か"],["」"],["。"]]},{"verse":11,"text":"主,しゅの言葉,ことばがまたわたしに臨,のぞんだ、","tok":[["主","しゅ"],["の"],["言葉","ことば"],["が"],["また"],["わたし"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":12,"text":"「反逆,はんぎゃくの家,いえに言,いえ。これらがなんであるかをあなたがたは知,しらないのか。彼,かれらに言,いえ、見,みよ、バビロンの王,おうがエルサレムにきて、その王,おうとつかさとを捕,とらえ、これをバビロンに引,ひいて行,いった。","tok":[["「"],["反逆","はんぎゃく"],["の"],["家","いえ"],["に"],["言え","いえ"],["。"],["これ"],["ら"],["が"],["なん"],["で"],["ある"],["か"],["を"],["あなた"],["がた"],["は"],["知らない","しらない"],["の"],["か"],["。"],["彼","かれ"],["ら"],["に"],["言え","いえ"],["、"],["見よ","みよ"],["、"],["バビロン"],["の"],["王","おう"],["が"],["エルサレム"],["に"],["きて"],["、"],["その"],["王","おう"],["とつか"],["さと"],["を"],["捕らえ","とらえ"],["、"],["これ"],["を"],["バビロン"],["に"],["引いて","ひいて"],["行った","いった"],["。"]]},{"verse":13,"text":"また王,おうの子孫,しそんのひとりを捕,とらえて、これと契約,けいやくを結,むすび、誓,ちかいを立,たてさせ、また国,くにのおもだった人々,ひとびとを捕,とらえて行,いった。","tok":[["また"],["王","おう"],["の"],["子孫","しそん"],["の"],["ひとり"],["を"],["捕らえて","とらえて"],["、"],["これ"],["と"],["契約","けいやく"],["を"],["結び","むすび"],["、"],["誓い","ちかい"],["を"],["立させ","たてさせ"],["、"],["また"],["国","くに"],["の"],["おも"],["だった"],["人々","ひとびと"],["を"],["捕らえて","とらえて"],["行った","いった"],["。"]]},{"verse":14,"text":"これはこの国,くにを卑,いやしくして、みずから立,たつことができないようにし、その契約,けいやくを守,まもることによって立,たたせるためである。","tok":[["これ"],["は"],["この"],["国","くに"],["を"],["卑しく","いやしく"],["して"],["、"],["みずから"],["立つ","たつ"],["こと"],["が"],["できない"],["よう"],["に"],["し"],["、"],["その"],["契約","けいやく"],["を"],["守","まもる"],["こと"],["によって"],["立たせる","たたせる"],["ため"],["で"],["ある"],["。"]]},{"verse":15,"text":"しかし彼,かれはバビロンの王,おうにそむき、使者,ししゃをエジプトに送,おくって、馬,うまと多,おおくの兵,へいとをそこから獲,えようとした。彼,かれは成功,せいこうするだろうか。このようなことをなす者,ものは、のがれることができようか。","tok":[["しかし"],["彼","かれ"],["は"],["バビロン"],["の"],["王","おう"],["に"],["そむき"],["、"],["使者","ししゃ"],["を"],["エジプト"],["に"],["送って","おくって"],["、"],["馬","うま"],["と"],["多く","おおく"],["の"],["兵","へい"],["と"],["を"],["そこ"],["から"],["獲よう","えよう"],["と"],["した"],["。"],["彼","かれ"],["は"],["成功","せいこう"],["するだろう"],["か"],["。"],["この"],["よう"],["な"],["こと"],["を"],["なす"],["者","もの"],["は"],["、"],["のがれる"],["こと"],["が"],["できよう"],["か"],["。"]]},{"verse":16,"text":"契約,けいやくを破,やぶってなおのがれることができようか。主,しゅなる神,かみは言,いわれる、わたしは生,いきている、必,かならず彼,かれは自分,じぶんを王,おうとなした王,おうの住,すむ所,ところ、彼,かれが立,たてた誓,ちかいを軽,かろんじ、その契約,けいやくを破,やぶった相手,あいての王,おうのいるバビロンで彼,かれは死,しぬ。","tok":[["契約","けいやく"],["を"],["破って","やぶって"],["なお"],["のがれる"],["こと"],["が"],["できよう"],["か"],["。"],["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["、"],["わたし"],["は"],["生きて","いきて"],["いる"],["、"],["必","かならず"],["彼","かれ"],["は"],["自分","じぶん"],["を"],["王","おう"],["と"],["なした"],["王","おう"],["の"],["住む","すむ"],["所","ところ"],["、"],["彼","かれ"],["が"],["立てた","たてた"],["誓い","ちかい"],["を"],["軽んじ","かろんじ"],["、"],["その"],["契約","けいやく"],["を"],["破った","やぶった"],["相手","あいて"],["の"],["王","おう"],["の"],["いる"],["バビロン"],["で"],["彼","かれ"],["は"],["死ぬ","しぬ"],["。"]]},{"verse":17,"text":"多,おおくの命,いのちを断,たつために塁,るいを築,きずき、雲梯,うんていを建,たてるとき、パロは決,けっして大,おおいなる軍勢,ぐんぜいと、多,おおくの人,ひととをもって、彼,かれを助,たすけて戦,たたかいをしない。","tok":[["多く","おおく"],["の"],["命","いのち"],["を"],["断つ","たつ"],["ため"],["に"],["塁","るい"],["を"],["築き","きずき"],["、"],["雲梯","うんてい"],["を"],["建てる","たてる"],["とき"],["、"],["パロ"],["は"],["決っして","けっして"],["大いなる","おおいなる"],["軍勢","ぐんぜい"],["と"],["、"],["多く","おおく"],["の"],["人","ひと"],["と"],["を"],["もって"],["、"],["彼","かれ"],["を"],["助けて","たすけて"],["戦い","たたかい"],["を"],["しない"],["。"]]},{"verse":18,"text":"彼,かれは誓,ちかいを軽,かろんじ、契約,けいやくを破,やぶり、その手,てを与,あたえて誓,ちかいながら、なおこれらの事,ことをしたゆえ、のがれることはできない。","tok":[["彼","かれ"],["は"],["誓い","ちかい"],["を"],["軽んじ","かろんじ"],["、"],["契約","けいやく"],["を"],["破り","やぶり"],["、"],["その"],["手","て"],["を"],["与","あたえ"],["て"],["誓い","ちかい"],["ながら"],["、"],["なお"],["これ"],["ら"],["の"],["事","こと"],["を"],["した"],["ゆえ"],["、"],["のがれる"],["こと"],["は"],["できない"],["。"]]},{"verse":19,"text":"それゆえ、主,しゅなる神,かみはこう言,いわれる、わたしは生,いきている、彼,かれがわたしの誓,ちかいを軽,かろんじ、わたしの契約,けいやくを破,やぶったことを、必,かならず彼,かれのこうべに報,むくいる。","tok":[["それ"],["ゆえ"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["わたし"],["は"],["生きて","いきて"],["いる"],["、"],["彼","かれ"],["が"],["わたし"],["の"],["誓い","ちかい"],["を"],["軽んじ","かろんじ"],["、"],["わたし"],["の"],["契約","けいやく"],["を"],["破った","やぶった"],["こと"],["を"],["、"],["必","かならず"],["彼","かれ"],["の"],["こうべ"],["に"],["報いる","むくいる"],["。"]]},{"verse":20,"text":"わたしはわが網,あみを彼,かれの上,うえに打,うちかけ、彼,かれをわがわなに捕,とらえて、バビロンに引,ひいて行,いき、彼,かれがわたしにむかって犯,おかした反逆,はんぎゃくのために、その所,ところで彼,かれをさばく。","tok":[["わたし"],["は"],["わが"],["網","あみ"],["を"],["彼","かれ"],["の"],["上","うえ"],["に"],["打ち","うち"],["かけ"],["、"],["彼","かれ"],["を"],["わが"],["わな"],["に"],["捕らえて","とらえて"],["、"],["バビロン"],["に"],["引いて","ひいて"],["行き","いき"],["、"],["彼","かれ"],["が"],["わたし"],["に"],["むかって"],["犯した","おかした"],["反逆","はんぎゃく"],["の"],["ため"],["に"],["、"],["その"],["所","ところ"],["で"],["彼","かれ"],["を"],["さばく"],["。"]]},{"verse":21,"text":"彼,かれのすべての軍隊,ぐんたいのえり抜,ぬきの兵士,へいしは皆,みなつるぎに倒,たおれ、生,いき残,のこった者,ものは八方,はっぽうに散,ちらされる。そしてあなたがたは主,しゅなるわたしが、これを語,かたったことを知,しるようになる」。","tok":[["彼","かれ"],["の"],["すべて"],["の"],["軍隊","ぐんたい"],["の"],["えり抜き","えりぬき"],["の"],["兵士","へいし"],["は"],["皆","みな"],["つるぎ"],["に"],["倒れ","たおれ"],["、"],["生き残った","いきのこった"],["者","もの"],["は"],["八方","はっぽう"],["に"],["散らされる","ちらされる"],["。"],["そして"],["あなた"],["がた"],["は"],["主","しゅ"],["なる"],["わたし"],["が"],["、"],["これ"],["を"],["語った","かたった"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["」"],["。"]]},{"verse":22,"text":"主,しゅなる神,かみはこう言,いわれる、「わたしはまた香柏,こうはくの高,たかいこずえから小,しょう枝,えだをとって、これを植,うえ、その若芽,わかめの頂,いただきから柔,やわらかい芽,めを摘,つみとり、これを高,たかいすぐれた山,やまに植,うえる。","tok":[["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["「"],["わたし"],["は"],["また"],["香","こう"],["柏","かしわ"],["の"],["高い","たかい"],["こずえ"],["から"],["小枝","しょうえだ"],["を"],["とって"],["、"],["これ"],["を"],["植え","うえ"],["、"],["その"],["若芽","わかめ"],["の"],["頂","いただき"],["から"],["柔らかい","やわらかい"],["芽","め"],["を"],["摘みとり","つみとり"],["、"],["これ"],["を"],["高かい","たかい"],["すぐれた"],["山","やま"],["に"],["植える","うえる"],["。"]]},{"verse":23,"text":"わたしはイスラエルの高,たかい山,やまにこれを植,うえる。これは枝,えだを出,だし、実,みを結,むすび、みごとな香柏,こうはくとなり、その下,したにもろもろの種類,しゅるいの獣,けものが住,すみ、その枝,えだの陰,かげに各種,かくしゅの鳥,とりが巣,すをつくる。","tok":[["わたし"],["は"],["イスラエル"],["の"],["高い","たかい"],["山","やま"],["に"],["これ"],["を"],["植える","うえる"],["。"],["これ"],["は"],["枝","えだ"],["を"],["出し","だし"],["、"],["実","み"],["を"],["結び","むすび"],["、"],["みごと"],["な"],["香","こう"],["柏","かしわ"],["う"],["はく"],["と"],["なり"],["、"],["その"],["下","した"],["に"],["もろもろ"],["の"],["種類","しゅるい"],["の"],["獣","けもの"],["が"],["住み","すみ"],["、"],["その"],["枝","えだ"],["の"],["陰","かげ"],["に"],["各種","かくしゅ"],["の"],["鳥","とり"],["が"],["巣","す"],["を"],["つくる"],["。"]]},{"verse":24,"text":"そして野,ののすべての木,きは、主,しゅなるわたしが高,たかい木,きを低,ひくくし、低,ひくい木,きを高,たかくし、緑,みどりの木,きを枯,からし、枯,かれ木,きを緑,みどりにすることを知,しるようになる。主,しゅであるわたしはこれを語,かたり、これをするのである」。","tok":[["そして"],["野","の"],["の"],["すべて"],["の"],["木","き"],["は"],["、"],["主","しゅ"],["なる"],["わたし"],["が"],["高かい","たかい"],["木","き"],["を"],["低く","ひくく"],["し"],["、"],["低い","ひくい"],["木","き"],["を"],["高かく","たかく"],["し"],["、"],["緑","みどり"],["の"],["木","き"],["を"],["枯らし","からし"],["、"],["枯木","かれき"],["を"],["緑","みどり"],["に"],["する"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"],["主","しゅ"],["で"],["ある"],["わたし"],["は"],["これ"],["を"],["語り","かたり"],["、"],["これ"],["を"],["する"],["ので"],["ある"],["」"],["。"]]}]
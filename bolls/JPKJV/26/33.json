[{"verse":1,"text":"主,しゅの言葉,ことばがわたしに臨,のぞんだ、","tok":[["主","しゅ"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":2,"text":"「人,ひとの子,こよ、あなたの民,たみの人々,ひとびとに語,かたって言,いえ、わたしがつるぎを一つの国,くにに臨,のぞませる時,とき、その国,くにの民,たみが彼,かれらのうちからひとりを選,えらんで、これを自分,じぶんたちの見守,みまもる者,ものとする。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["あなた"],["の"],["民","たみ"],["の"],["人々","ひとびと"],["に"],["語って","かたって"],["言え","いえ"],["、"],["わたし"],["が"],["つるぎ"],["を"],["一","ひと"],["つ"],["の"],["国","くに"],["に"],["臨ませる","のぞませる"],["時","とき"],["、"],["その"],["国","くに"],["の"],["民","たみ"],["が"],["彼","かれ"],["ら"],["の"],["うち"],["から"],["ひとり"],["を"],["選らんで","えらんで"],["、"],["これ"],["を"],["自分","じぶん"],["たち"],["の"],["見","み"],["守者","守もの"],["と"],["する"],["。"]]},{"verse":3,"text":"彼,かれは国,くににつるぎが臨,のぞむのを見,みて、ラッパを吹,ふき、民,たみを戒,いましめる。","tok":[["彼","かれ"],["は"],["国","くに"],["に"],["つるぎ"],["が"],["臨む","のぞむ"],["の"],["を"],["見て","みて"],["、"],["ラッパ"],["を"],["吹","ふき"],["、"],["民","たみ"],["を"],["戒める","いましめる"],["。"]]},{"verse":4,"text":"しかし人,ひとがラッパの音,おとを聞,きいても、みずから警戒,けいかいせず、ついにつるぎが来,きて、その人,ひとを殺,ころしたなら、その血,ちは彼,かれのこうべに帰,きする。","tok":[["しかし"],["人","ひと"],["が"],["ラッパ"],["の"],["音","おと"],["を"],["聞いて","きいて"],["も"],["、"],["みずから"],["警戒","けいかい"],["せず"],["、"],["ついに"],["つるぎ"],["が"],["来て","きて"],["、"],["その"],["人","ひと"],["を"],["殺ろしたなら","ころしたなら"],["、"],["その"],["血","ち"],["は"],["彼","かれ"],["の"],["こうべ"],["に"],["帰する","きする"],["。"]]},{"verse":5,"text":"彼,かれはラッパの音,おとを聞,きいて、みずから警戒,けいかいしなかったのであるから、その血,ちは彼,かれ自身,じしんに帰,きする。しかしその人,ひとが、みずから警戒,けいかいしたなら、その命,いのちは救,すくわれる。","tok":[["彼","かれ"],["は"],["ラッパ"],["の"],["音","おと"],["を"],["聞いて","きいて"],["、"],["みずから"],["警戒","けいかい"],["しなかった"],["ので"],["ある"],["から"],["、"],["その"],["血","ち"],["は"],["彼","かれ"],["自身","じしん"],["に"],["帰する","きする"],["。"],["しかし"],["その"],["人","ひと"],["が"],["、"],["みずから"],["警戒","けいかい"],["したなら"],["、"],["その"],["命","いのち"],["は"],["救われる","すくわれる"],["。"]]},{"verse":6,"text":"しかし見守,みまもる者,ものが、つるぎの臨,のぞむのを見,みても、ラッパを吹,ふかず、そのため民,たみが、みずから警戒,けいかいしないでいるうちに、つるぎが臨,のぞみ、彼,かれらの中,なかのひとりを失,うしなうならば、その人,ひとは、自分,じぶんの罪,つみのために殺,ころされるが、わたしはその血,ちの責任,せきにんを、見守,みまもる者,ものの手,てに求,もとめる。","tok":[["しかし"],["見","み"],["守者","守もの"],["が"],["、"],["つるぎ"],["の"],["臨む","のぞむ"],["の"],["を"],["見て","みて"],["も"],["、"],["ラッパ"],["を"],["吹かず","ふかず"],["、"],["その"],["ため民","ためた"],["み"],["が"],["、"],["みずから"],["警戒","けいかい"],["しないで"],["いる"],["うち"],["に"],["、"],["つるぎ"],["が"],["臨み","のぞみ"],["、"],["彼","かれ"],["ら"],["の"],["中","なか"],["の"],["ひとり"],["を"],["失なうならば","うしなうならば"],["、"],["その"],["人","ひと"],["は"],["、"],["自分","じぶん"],["の"],["罪","つみ"],["の"],["ため"],["に"],["殺ろされる","ころされる"],["が"],["、"],["わたし"],["は"],["その"],["血","ち"],["の"],["責任","せきにん"],["を"],["、"],["見","み"],["守者","守もの"],["の"],["手","て"],["に"],["求める","もとめる"],["。"]]},{"verse":7,"text":"それゆえ、人,ひとの子,こよ、わたしはあなたを立,たてて、イスラエルの家,いえを見守,みまもる者,ものとする。あなたはわたしの口,くちから言葉,ことばを聞,きき、わたしに代,かわって彼,かれらを戒,いましめよ。","tok":[["それ"],["ゆえ"],["、"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["わたし"],["は"],["あなた"],["を"],["立てて","たてて"],["、"],["イスラエル"],["の"],["家","いえ"],["を"],["見","み"],["守者","守もの"],["と"],["する"],["。"],["あなた"],["は"],["わたし"],["の"],["口","くち"],["から"],["言葉","ことば"],["を"],["聞","きき"],["、"],["わたし"],["に"],["代わって","かわって"],["彼","かれ"],["ら"],["を"],["戒しめ","いましめ"],["よ"],["。"]]},{"verse":8,"text":"わたしが悪人,あくにんに向,むかって、悪人,あくにんよ、あなたは必,かならず死,しぬと言,いう時,とき、あなたが悪人,あくにんを戒,いましめて、その道,みちから離,はなれさせるように語,かたらなかったら、悪人,あくにんは自分,じぶんの罪,つみによって死,しぬ。しかしわたしはその血,ちを、あなたの手,てに求,もとめる。","tok":[["わたし"],["が"],["悪人","あくにん"],["に"],["向かって","むかって"],["、"],["悪人","あくにん"],["よ"],["、"],["あなた"],["は"],["必死","かならずし"],["ぬ"],["と"],["言う","いう"],["時","とき"],["、"],["あなた"],["が"],["悪人","あくにん"],["を"],["戒しめ","いましめ"],["て"],["、"],["その"],["道","みち"],["から"],["離れさせる","はなれさせる"],["よう"],["に"],["語らなかったら","かたらなかったら"],["、"],["悪人","あくにん"],["は"],["自分","じぶん"],["の"],["罪","つみ"],["によって"],["死ぬ","しぬ"],["。"],["しかし"],["わたし"],["は"],["その"],["血","ち"],["を"],["、"],["あなた"],["の"],["手","て"],["に"],["求める","もとめる"],["。"]]},{"verse":9,"text":"しかしあなたが悪人,あくにんに、その道,みちを離,はなれるように戒,いましめても、その悪人,あくにんがその道,みちを離,はなれないなら、彼,かれは自分,じぶんの罪,つみによって死,しぬ。しかしあなたの命,いのちは救,すくわれる。","tok":[["しかし"],["あなた"],["が"],["悪人","あくにん"],["に"],["、"],["その"],["道","みち"],["を"],["離れる","はなれる"],["よう"],["に"],["戒しめ","いましめ"],["て"],["も"],["、"],["その"],["悪人","あくにん"],["が"],["その"],["道","みち"],["を"],["離れないなら","はなれないなら"],["、"],["彼","かれ"],["は"],["自分","じぶん"],["の"],["罪","つみ"],["によって"],["死ぬ","しぬ"],["。"],["しかし"],["あなた"],["の"],["命","いのち"],["は"],["救われる","すくわれる"],["。"]]},{"verse":10,"text":"それゆえ、人,ひとの子,こよ、イスラエルの家,いえに言,いえ、あなたがたはこう言,いった、『われわれのとがと、罪,つみはわれわれの上,うえにある。われわれはその中,なかにあって衰,おとろえはてる。どうして生,いきることができようか』と。","tok":[["それ"],["ゆえ"],["、"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["イスラエル"],["の"],["家","いえ"],["に"],["言え","いえ"],["、"],["あなた"],["がた"],["は"],["こう"],["言った","いった"],["、"],["『"],["われわれ"],["の"],["とが"],["と"],["、"],["罪","つみ"],["は"],["われわれ"],["の"],["上","うえ"],["に"],["ある"],["。"],["われわれ"],["は"],["その"],["中","なか"],["に"],["あって"],["衰え","おとろえ"],["はてる"],["。"],["どう"],["して"],["生きる","いきる"],["こと"],["が"],["できよう"],["か"],["』"],["と"],["。"]]},{"verse":11,"text":"あなたは彼,かれらに言,いえ、主,しゅなる神,かみは言,いわれる、わたしは生,いきている。わたしは悪人,あくにんの死,しを喜,よろこばない。むしろ悪人,あくにんが、その道,みちを離,はなれて生,いきるのを喜,よろこぶ。あなたがたは心,こころを翻,ひるがえせ、心,こころを翻,ひるがえしてその悪,あしき道,みちを離,はなれよ。イスラエルの家,いえよ、あなたはどうして死,しんでよかろうか。","tok":[["あなた"],["は"],["彼","かれ"],["ら"],["に"],["言え","いえ"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["、"],["わたし"],["は"],["生きて","いきて"],["いる"],["。"],["わたし"],["は"],["悪人","あくにん"],["の"],["死","し"],["を"],["喜こばない","よろこばない"],["。"],["むしろ"],["悪人","あくにん"],["が"],["、"],["その"],["道","みち"],["を"],["離れて","はなれて"],["生きる","いきる"],["の"],["を"],["喜こぶ","よろこぶ"],["。"],["あなた"],["がた"],["は"],["心","こころ"],["を"],["翻がえせ","ひるがえせ"],["、"],["心","こころ"],["を"],["翻がえして","ひるがえして"],["その"],["悪しき","あしき"],["道","みち"],["を"],["離れよ","はなれよ"],["。"],["イスラエル"],["の"],["家","いえ"],["よ"],["、"],["あなた"],["は"],["どう"],["して"],["死んで","しんで"],["よかろう"],["か"],["。"]]},{"verse":12,"text":"人,ひとの子,こよ、あなたの民,たみの人々,ひとびとに言,いえ、義人,ぎじんの義,ぎは、彼,かれが罪,つみを犯,おかす時,ときには、彼,かれを救,すくわない。悪人,あくにんの悪,あくは、彼,かれがその悪,あくを離,はなれる時,とき、その悪,あくのために倒,たおれることはない。義人,ぎじんは彼,かれが罪,つみを犯,おかす時,とき、その義,ぎのために生,いきることはできない。","tok":[["人","ひと"],["の"],["子","こ"],["よ"],["、"],["あなた"],["の"],["民","たみ"],["の"],["人々","ひとびと"],["に"],["言え","いえ"],["、"],["義人","ぎじん"],["の"],["義","ぎ"],["は"],["、"],["彼","かれ"],["が"],["罪","つみ"],["を"],["犯す","おかす"],["時","とき"],["に"],["は"],["、"],["彼","かれ"],["を"],["救わない","すくわない"],["。"],["悪人","あくにん"],["の"],["悪","あく"],["は"],["、"],["彼","かれ"],["が"],["その"],["悪","あく"],["を"],["離れる","はなれる"],["時","とき"],["、"],["その"],["悪","あく"],["の"],["ため"],["に"],["倒れる","たおれる"],["こと"],["は"],["ない"],["。"],["義人","ぎじん"],["は"],["彼","かれ"],["が"],["罪","つみ"],["を"],["犯す","おかす"],["時","とき"],["、"],["その"],["義","ぎ"],["の"],["ため"],["に"],["生きる","いきる"],["こと"],["は"],["できない"],["。"]]},{"verse":13,"text":"わたしが義人,ぎじんに、彼,かれは必,かならず生,いきると言,いっても、もし彼,かれが自分,じぶんの義,ぎをたのんで、罪,つみを犯,おかすなら、彼,かれのすべての義,ぎは覚,おぼえられない。彼,かれはみずから犯,おかした罪,つみのために死,しぬ。","tok":[["わたし"],["が"],["義人","ぎじん"],["に"],["、"],["彼","かれ"],["は"],["必","かならず"],["生きる","いきる"],["と"],["言って","いって"],["も"],["、"],["もし"],["彼","かれ"],["が"],["自分","じぶん"],["の"],["義","ぎ"],["を"],["たのんで"],["、"],["罪","つみ"],["を"],["犯すなら","おかすなら"],["、"],["彼","かれ"],["の"],["すべて"],["の"],["義","ぎ"],["は"],["覚えられない","おぼえられない"],["。"],["彼","かれ"],["は"],["みずから"],["犯した","おかした"],["罪","つみ"],["の"],["ため"],["に"],["死ぬ","しぬ"],["。"]]},{"verse":14,"text":"また、わたしが悪人,あくにんに『あなたは必,かならず死,しぬ』と言,いっても、もし彼,かれがその罪,つみを離,はなれ、公道,こうどうと正義,せいぎとを行,おこなうならば、","tok":[["また"],["、"],["わたし"],["が"],["悪人","あくにん"],["に"],["『"],["あなた"],["は"],["必死","かならずし"],["ぬ"],["』"],["と"],["言って","いって"],["も"],["、"],["もし"],["彼","かれ"],["が"],["その"],["罪","つみ"],["を"],["離れ","はなれ"],["、"],["公道","こうどう"],["と"],["正義","せいぎと"],["を"],["行なうならば","おこなうならば"],["、"]]},{"verse":15,"text":"すなわちその悪人,あくにんが質物,しちもつを返,かえし、奪,うばった物,ものをもどし、命,いのちの定,さだめに歩,あゆみ、悪,あくを行,おこなわないならば、彼,かれは必,かならず生,いきる。決,けっして死,しなない。","tok":[["すなわち"],["その"],["悪人","あくにん"],["が"],["質物","しちもつ"],["を"],["返","かえし"],["、"],["奪った","うばった"],["物","もの"],["を"],["もどし"],["、"],["命","いのち"],["の"],["定め","さだめ"],["に"],["歩み","あゆみ"],["、"],["悪","あく"],["を"],["行なわないならば","おこなわないならば"],["、"],["彼","かれ"],["は"],["必","かならず"],["生きる","いきる"],["。"],["決っして","けっして"],["死なない","しなない"],["。"]]},{"verse":16,"text":"彼,かれの犯,おかしたすべての罪,つみは彼,かれに対,たいして覚,おぼえられない。彼,かれは公道,こうどうと正義,せいぎとを行,おこなったのであるから、必,かならず生,いきる。","tok":[["彼","かれ"],["の"],["犯した","おかした"],["すべて"],["の"],["罪","つみ"],["は"],["彼","かれ"],["に対して","にたいして"],["覚えられない","おぼえられない"],["。"],["彼","かれ"],["は"],["公道","こうどう"],["と"],["正義","せいぎと"],["を"],["行なった","おこなった"],["ので"],["ある"],["から"],["、"],["必","かならず"],["生きる","いきる"],["。"]]},{"verse":17,"text":"あなたの民,たみの人々,ひとびとは『主,しゅの道,みちは公平,こうへいでない』と言,いう。しかし彼,かれらの道,みちこそ公平,こうへいでないのである。","tok":[["あなた"],["の"],["民","たみ"],["の"],["人々","ひとびと"],["は"],["『"],["主","しゅ"],["の"],["道","みち"],["は"],["公平","こうへい"],["で"],["ない"],["』"],["と"],["言う","いう"],["。"],["しかし"],["彼","かれ"],["ら"],["の"],["道","みち"],["こそ"],["公平","こうへい"],["で"],["ない"],["ので"],["ある"],["。"]]},{"verse":18,"text":"義人,ぎじんがその義,ぎを離,はなれて、罪,つみを犯,おかすならば、彼,かれはこれがために死,しぬ。","tok":[["義人","ぎじん"],["が"],["その"],["義","ぎ"],["を"],["離れて","はなれて"],["、"],["罪","つみ"],["を"],["犯すならば","おかすならば"],["、"],["彼","かれ"],["は"],["これ"],["が"],["ため"],["に"],["死ぬ","しぬ"],["。"]]},{"verse":19,"text":"悪人,あくにんがその悪,あくを離,はなれて、公道,こうどうと正義,せいぎとを行,おこなうならば、彼,かれはこれによって生,いきる。","tok":[["悪人","あくにん"],["が"],["その"],["悪","あく"],["を"],["離れて","はなれて"],["、"],["公道","こうどう"],["と"],["正義","せいぎと"],["を"],["行なうならば","おこなうならば"],["、"],["彼","かれ"],["は"],["これ"],["によって"],["生きる","いきる"],["。"]]},{"verse":20,"text":"それであるのに、あなたがたは『主,しゅの道,みちは公平,こうへいでない』と言,いう。イスラエルの家,いえよ、わたしは各自,かくじのおこないにしたがって、あなたがたをさばく」。","tok":[["それ"],["で"],["ある"],["のに"],["、"],["あなた"],["がた"],["は"],["『"],["主","しゅ"],["の"],["道","みち"],["は"],["公平","こうへい"],["で"],["ない"],["』"],["と"],["言う","いう"],["。"],["イスラエル"],["の"],["家","いえ"],["よ"],["、"],["わたし"],["は"],["各自","かくじ"],["の"],["おこない"],["に"],["したがって"],["、"],["あなた"],["がた"],["を"],["さばく"],["」"],["。"]]},{"verse":21,"text":"わたしたちが捕,とらえ移,うつされた後,のち、すなわち第,だい十二年,ねんの十月,がつ五日,かに、エルサレムからのがれて来,きた者,ものが、わたしのもとに来,きて言,いった、「町,まちは打,うち破,やぶられた」と。","tok":[["わたしたち"],["が"],["捕らえ","とらえ"],["移された","うつされた"],["後","の"],["ち"],["、"],["すなわち"],["第","だい"],["十二","じゅうに"],["年","ねん"],["の"],["十","じゅう"],["月","がつ"],["つ"],["五日","か"],["に"],["、"],["エルサレム"],["から"],["のがれて"],["来た","きた"],["者","もの"],["が"],["、"],["わたし"],["の"],["もと"],["に"],["来て","きて"],["言った","いった"],["、"],["「"],["町","まち"],["は"],["打ち破られた","うちやぶられた"],["」"],["と"],["。"]]},{"verse":22,"text":"その者,ものが来,きた前,まえの夜,よる、主,しゅの手,てがわたしに臨,のぞんだ。次,つぎの朝,あさ、その人,ひとがわたしのもとに来,きたころ、主,しゅはわたしの口,くちを開,ひらかれた。わたしの口,くちが開,ひらけたので、もはやわたしは沈黙,ちんもくしなかった。","tok":[["その"],["者","もの"],["が"],["来た","きた"],["前","まえ"],["の"],["夜","よる"],["、"],["主","しゅ"],["の"],["手","て"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["。"],["次","つぎ"],["の"],["朝","あさ"],["、"],["その"],["人","ひと"],["が"],["わたし"],["の"],["もと"],["に"],["来た","きた"],["ころ"],["、"],["主","しゅ"],["は"],["わたし"],["の"],["口","くち"],["を"],["開らかれた","ひらかれた"],["。"],["わたし"],["の"],["口","くち"],["が"],["開た","ひらけた"],["ので"],["、"],["もはや"],["わたし"],["は"],["沈黙","ちんもく"],["しなかった"],["。"]]},{"verse":23,"text":"主,しゅの言葉,ことばがわたしに臨,のぞんだ、","tok":[["主","しゅ"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":24,"text":"「人,ひとの子,こよ、イスラエルの地,ちの、かの荒,あれ跡,あとの住民,じゅうみんらは、語,かたり続,つづけて言,いう、『アブラハムはただひとりで、なおこの地,ちを所有,しょゆうした。しかしわたしたちの数,かずは多,おおい。この地,ちはわれわれの所有,しょゆうとして与,あたえられている』と。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["イスラエル"],["の"],["地","ち"],["の"],["、"],["かの"],["荒れ","あれ"],["跡","あと"],["の"],["住民","じゅうみん"],["ら"],["は"],["、"],["語り","かたり"],["続けて","つづけて"],["言う","いう"],["、"],["『"],["アブラハム"],["は"],["ただ"],["ひとり"],["で"],["、"],["なお"],["この"],["地","ち"],["を"],["所有","しょゆう"],["した"],["。"],["しかし"],["わたしたち"],["の"],["数","かず"],["は"],["多い","おおい"],["。"],["この"],["地","ち"],["は"],["われわれ"],["の"],["所有","しょゆう"],["として"],["与えられて","あたえられて"],["いる"],["』"],["と"],["。"]]},{"verse":25,"text":"それゆえ、あなたは彼,かれらに言,いえ、主,しゅなる神,かみはこう言,いわれる、あなたがたは肉,にくを血,ちのついたままで食,たべ、おのが偶像,ぐうぞうを仰,あおぎ、血,ちを流,ながしていて、なおこの地,ちを所有,しょゆうすることができるか。","tok":[["それ"],["ゆえ"],["、"],["あなた"],["は"],["彼","かれ"],["ら"],["に"],["言え","いえ"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["あなた"],["がた"],["は"],["肉","にく"],["を"],["血","ち"],["の"],["ついた"],["まま"],["で"],["食べ","たべ"],["、"],["お"],["の"],["が"],["偶像","ぐうぞう"],["を"],["仰ぎ","あおぎ"],["、"],["血","ち"],["を"],["流して","ながして"],["いて"],["、"],["なお"],["この"],["地","ち"],["を"],["所有","しょゆう"],["する"],["こと"],["が"],["できる"],["か"],["。"]]},{"verse":26,"text":"あなたがたはつるぎをたのみ、憎,にくむべき事,ことをおこない、おのおの隣,となり人,びとの妻,つまを汚,けがして、なおこの地,ちを所有,しょゆうすることができるか。","tok":[["あなた"],["がた"],["は"],["つるぎ"],["を"],["たのみ"],["、"],["憎むべき","にくむべき"],["事","こと"],["を"],["おこない"],["、"],["おのおの"],["隣人","となりびと"],["の"],["妻","つま"],["を"],["汚","け"],["がして"],["、"],["なお"],["この"],["地","ち"],["を"],["所有","しょゆう"],["する"],["こと"],["が"],["できる"],["か"],["。"]]},{"verse":27,"text":"あなたは彼,かれらに言,いいなさい。主,しゅなる神,かみはこう言,いわれる、わたしは生,いきている。かの荒,あれ跡,あとにいる者,ものは必,かならずつるぎに倒,たおれる。わたしは野,のの面,めんにいる者,ものを、獣,けものに与,あたえて食,くわせ、要害,ようがいとほら穴,あなとにいる者,ものは疫病,えきびょうで死,しぬ。","tok":[["あなた"],["は"],["彼","かれ"],["ら"],["に"],["言い","いい"],["なさい"],["。"],["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["わたし"],["は"],["生きて","いきて"],["いる"],["。"],["か"],["の"],["荒れ","あれ"],["跡","あと"],["に"],["いる"],["者","もの"],["は"],["必","かならず"],["つるぎ"],["に"],["倒れる","たおれる"],["。"],["わたし"],["は"],["野","の"],["の"],["面","めん"],["に"],["いる"],["者","もの"],["を"],["、"],["獣","けもの"],["に"],["与","あたえ"],["て"],["食わせ","くわせ"],["、"],["要害","ようがい"],["と"],["ほら穴","ほらあな"],["と"],["に"],["いる"],["者","もの"],["は"],["疫病","え"],["き"],["びょう"],["で"],["死ぬ","しぬ"],["。"]]},{"verse":28,"text":"わたしはこの国,くにを全,まったく荒,あらす。彼,かれの誇,ほこる力,ちからはうせ、イスラエルの山々,やまやまは荒,あれて通,とおる者,ものもなくなる。","tok":[["わたし"],["は"],["この"],["国","くに"],["を"],["全く","まったく"],["荒す","あらす"],["。"],["彼","かれ"],["の"],["誇る","ほこる"],["力","ちから"],["は"],["うせ"],["、"],["イスラエル"],["の"],["山々","やまやま"],["は"],["荒て","あれて"],["通る","とおる"],["者","もの"],["も"],["なくなる"],["。"]]},{"verse":29,"text":"彼,かれらがおこなったすべての憎,にくむべきことのために、わたしがこの国,くにを全,まったく荒,あらす時,とき、彼,かれらはわたしが主,しゅであることを悟,さとる。","tok":[["彼","かれ"],["ら"],["が"],["おこなった"],["すべて"],["の"],["憎むべき","にくむべき"],["こと"],["の"],["ため"],["に"],["、"],["わたし"],["が"],["この"],["国","くに"],["を"],["全く","まったく"],["荒す","あらす"],["時","とき"],["、"],["彼","かれ"],["ら"],["は"],["わたし"],["が"],["主","しゅ"],["で"],["ある"],["こと"],["を"],["悟","さとる"],["。"]]},{"verse":30,"text":"人,ひとの子,こよ、あなたの民,たみの人々,ひとびとは、かきのかたわら、家,いえの入口,いりぐちで、あなたの事,ことを論,ろんじ、たがいに語,かたりあって言,いう、『さあ、われわれは、どんな言葉,ことばが主,しゅから出,でるかを聞,きこう』と。","tok":[["人","ひと"],["の"],["子","こ"],["よ"],["、"],["あなた"],["の"],["民","たみ"],["の"],["人々","ひとびと"],["は"],["、"],["かき"],["の"],["かたわら"],["、"],["家","いえ"],["の"],["入口","いりぐち"],["で"],["、"],["あなた"],["の"],["事","こと"],["を"],["論じ","ろんじ"],["、"],["たがい"],["に"],["語りあって","かたりあって"],["言う","いう"],["、"],["『"],["さあ"],["、"],["われわれ"],["は"],["、"],["どんな"],["言葉","ことば"],["が"],["主ら","しゅから"],["出る","でる"],["か"],["を"],["聞こう","きこう"],["』"],["と"],["。"]]},{"verse":31,"text":"彼,かれらは民,たみが来,くるようにあなたの所,ところに来,き、わたしの民,たみのようにあなたの前,まえに座,ざして、あなたの言葉,ことばを聞,きく。しかし彼,かれらはそれを行,おこなわない。彼等,かれらは口先,くちさきでは多,おおくの愛,あいを現,あらわすが、その心,こころは利,りにおもむいている。","tok":[["彼","かれ"],["ら"],["は"],["民","た"],["み"],["が"],["来る","くる"],["よう"],["に"],["あなた"],["の"],["所","ところ"],["に"],["来","き"],["、"],["わたし"],["の"],["民","たみ"],["の"],["よう"],["に"],["あなた"],["の"],["前","まえ"],["に"],["座して","ざして"],["、"],["あなた"],["の"],["言葉","ことば"],["を"],["聞く","きく"],["。"],["しかし"],["彼","かれ"],["ら"],["は"],["それ"],["を"],["行なわない","おこなわない"],["。"],["彼","かれ"],["等","ら"],["は"],["口先","くちさき"],["で"],["は"],["多く","おおく"],["の"],["愛","あい"],["を"],["現わす","あらわす"],["が"],["、"],["その"],["心","こころ"],["は"],["利","り"],["に"],["おもむいて"],["いる"],["。"]]},{"verse":32,"text":"見,みよ、あなたは彼,かれらには、美,うつくしい声,こえで愛,あいの歌,うたをうたう者,もののように、また楽器,がっきをよく奏,そうする者,もののように思,おもわれる。彼,かれらはあなたの言葉,ことばは聞,きくが、それを行,おこなおうとはしない。","tok":[["見よ","みよ"],["、"],["あなた"],["は"],["彼","かれ"],["ら"],["に"],["は"],["、"],["美しい","うつくしい"],["声","こえ"],["で"],["愛","あい"],["の"],["歌","うた"],["を"],["うたう"],["者","もの"],["の"],["よう"],["に"],["、"],["また"],["楽器","がっき"],["を"],["よく"],["奏する","そうする"],["者","もの"],["の"],["よう"],["に"],["思われる","おもわれる"],["。"],["彼","かれ"],["ら"],["は"],["あなた"],["の"],["言葉","ことば"],["は"],["聞く","きく"],["が"],["、"],["それ"],["を"],["行なおう","おこなおう"],["と"],["は"],["しない"],["。"]]},{"verse":33,"text":"この事,ことが起,おこる時,とき――これは必,かならず起,おこる――そのとき彼,かれらの中,なかにひとりの預言者,よげんしゃがいたことを彼,かれらは悟,さとる」。","tok":[["この"],["事","こと"],["が"],["起こる","おこる"],["時","とき"],["―"],["―"],["これ"],["は"],["必","かならず"],["起こる","おこる"],["―"],["―"],["その"],["とき"],["彼","かれ"],["ら"],["の"],["中","なか"],["に"],["ひとり"],["の"],["預言者","よげんしゃ"],["が"],["いた"],["こと"],["を"],["彼","かれ"],["ら"],["は"],["悟","さとる"],["」"],["。"]]}]
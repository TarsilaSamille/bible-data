[{"verse":1,"text":"主,しゅの言葉,ことばがわたしに臨,のぞんだ、","tok":[["主","しゅ"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":2,"text":"「あなたがたがイスラエルの地,ちについて、このことわざを用,もちい、『父,ちちたちが、酢,すいぶどうを食,たべたので子供,こどもたちの歯,はがうく』というのはどんなわけか。","tok":[["「"],["あなた"],["がた"],["が"],["イスラエル"],["の"],["地","ち"],["について"],["、"],["この"],["ことわざ"],["を"],["用い","もちい"],["、"],["『"],["父","ちち"],["たち"],["が"],["、"],["酢","す"],["い"],["ぶどう"],["を"],["食べた","たべた"],["ので"],["子供","こども"],["たち"],["の"],["歯","は"],["が"],["うく"],["』"],["と"],["いう"],["の"],["は"],["どんな"],["わけ"],["か"],["。"]]},{"verse":3,"text":"主,しゅなる神,かみは言,いわれる、わたしは生,いきている、あなたがたは再,ふたたびイスラエルでこのことわざを用,もちいることはない。","tok":[["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["、"],["わたし"],["は"],["生きて","いきて"],["いる"],["、"],["あなた"],["がた"],["は"],["再び","ふたたび"],["イスラエル"],["で"],["この"],["ことわざ"],["を"],["用いる","もちいる"],["こと"],["は"],["ない"],["。"]]},{"verse":4,"text":"見,みよ、すべての魂,たましいはわたしのものである。父,ちちの魂,たましいも子,この魂,たましいもわたしのものである。罪,つみを犯,おかした魂,たましいは必,かならず死,しぬ。","tok":[["見よ","みよ"],["、"],["すべて"],["の"],["魂","たましい"],["は"],["わたし"],["の"],["もの"],["で"],["ある"],["。"],["父","ちち"],["の"],["魂","たましい"],["も"],["子","こ"],["の"],["魂","たましい"],["も"],["わたし"],["の"],["もの"],["で"],["ある"],["。"],["罪","つみ"],["を"],["犯した","おかした"],["魂","たましい"],["は"],["必死","かならずし"],["ぬ"],["。"]]},{"verse":5,"text":"人,ひとがもし正,ただしくあって、公道,こうどうと正義,せいぎとを行,おこない、","tok":[["人","ひと"],["が"],["もし"],["正く","ただしく"],["あって"],["、"],["公道","こうどう"],["と"],["正義","せいぎと"],["を"],["行ない","おこない"],["、"]]},{"verse":6,"text":"山,やまの上,うえで食事,しょくじをせず、また目,めをあげてイスラエルの家,いえの偶像,ぐうぞうを仰,あおがず、隣,となり人,びとの妻,つまを犯,おかさず、汚,けがれの時,ときにある女,おんなに近,ちかづかず、","tok":[["山","やま"],["の"],["上","うえ"],["で"],["食事","しょくじ"],["を"],["せず"],["、"],["また"],["目","め"],["を"],["あげて"],["イスラエル"],["の"],["家","いえ"],["の"],["偶像","ぐうぞう"],["を"],["仰がず","あおがず"],["、"],["隣人","となりびと"],["の"],["妻","つま"],["を"],["犯さず","おかさず"],["、"],["汚","けがれ"],["の"],["時","とき"],["に"],["ある"],["女","おんな"],["に"],["近づかず","ちかづかず"],["、"]]},{"verse":7,"text":"だれをもしえたげず、質物,しちもつを返,かえし、決,けっして奪,うばわず、食物,しょくもつを飢,うえた者,ものに与,あたえ、裸,はだかの者,ものに衣服,いふくを着,きせ、","tok":[["だれ"],["を"],["もし"],["え"],["たげず"],["、"],["質物","しちもつ"],["を"],["返","かえし"],["、"],["決っして","けっして"],["奪わず","うばわず"],["、"],["食物","しょくもつ"],["を"],["飢","うえ"],["た"],["者","もの"],["に"],["与","あたえ"],["、"],["裸","はだか"],["の"],["者","もの"],["に"],["衣服","いふく"],["を"],["着せ","きせ"],["、"]]},{"verse":8,"text":"利息,りそくや高利,こうりをとって貸,かさず、手,てをひいて悪,あくを行,おこなわず、人,ひとと人,ひととの間,あいだに真実,しんじつのさばきを行,おこない、","tok":[["利息","りそく"],["や"],["高利","こうり"],["を"],["とって"],["貸さず","かさず"],["、"],["手","て"],["を"],["ひいて"],["悪","あく"],["を"],["行なわず","おこなわず"],["、"],["人","ひと"],["と"],["人","ひと"],["と"],["の"],["間","あいだ"],["に"],["真実","しんじつ"],["の"],["さばき"],["を"],["行ない","おこない"],["、"]]},{"verse":9,"text":"わたしの定,さだめに歩,あゆみ、わたしのおきてを忠実,ちゅうじつに守,まもるならば、彼,かれは正,ただしい人,ひとである。彼,かれは必,かならず生,いきることができると、主,しゅなる神,かみは言,いわれる。","tok":[["わたし"],["の"],["定め","さだめ"],["に"],["歩み","あゆみ"],["、"],["わたし"],["の"],["おきて"],["を"],["忠実","ちゅうじつ"],["に"],["守","まもる"],["ならば"],["、"],["彼","かれ"],["は"],["正い","ただしい"],["人","ひと"],["で"],["ある"],["。"],["彼","かれ"],["は"],["必","かならず"],["生きる","いきる"],["こと"],["が"],["できる"],["と"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"]]},{"verse":10,"text":"しかし彼,かれが子,こを生,うみ、その子,こが荒,あらい者,もので、人,ひとの血,ちを流,ながし、これらの義務,ぎむの一つをも行,おこなわず、","tok":[["しかし"],["彼","かれ"],["が"],["子","こ"],["を"],["生み","うみ"],["、"],["その"],["子","こ"],["が"],["荒い","あらい"],["者","もの"],["で"],["、"],["人","ひと"],["の"],["血","ち"],["を"],["流し","ながし"],["、"],["これ"],["ら"],["の"],["義務","ぎむ"],["の"],["一","ひと"],["つ"],["を"],["も"],["行なわず","おこなわず"],["、"]]},{"verse":11,"text":"かえって山,やまの上,うえで食事,しょくじをし、隣,となり人,びとの妻,つまを犯,おかし、","tok":[["かえって"],["山","やま"],["の"],["上","うえ"],["で"],["食事","しょくじ"],["を"],["し"],["、"],["隣人","となりびと"],["の"],["妻","つま"],["を"],["犯し","おかし"],["、"]]},{"verse":12,"text":"乏,とぼしい者,ものや貧,まずしい者,ものをしえたげ、物,ものを奪,うばい、質物,しちもつを返,かえさず、目,めをあげて偶像,ぐうぞうを仰,あおぎ、憎,にくむべき事,ことをおこない、","tok":[["乏い","とぼしい"],["者","もの"],["や"],["貧しい","まずしい"],["者","もの"],["を"],["し"],["えたげ"],["、"],["物","もの"],["を"],["奪い","うばい"],["、"],["質物","しちもつ"],["を"],["返えさず","かえさず"],["、"],["目","め"],["を"],["あげて"],["偶像","ぐうぞう"],["を"],["仰ぎ","あおぎ"],["、"],["憎むべき","にくむべき"],["事","こと"],["を"],["おこない"],["、"]]},{"verse":13,"text":"利息,りそくや高利,こうりをとって貸,かすならば、その子,こは生,いきるであろうか。彼,かれは生,いきることはできない。彼,かれはこれらの憎,にくむべき事,ことをしたので、必,かならず死,しに、その血,ちは彼,かれ自身,じしんに帰,きする。","tok":[["利息","りそく"],["や"],["高利","こうり"],["を"],["とって"],["貸すならば","かすならば"],["、"],["その"],["子","こ"],["は"],["生きるで","いきるで"],["あろう"],["か"],["。"],["彼","かれ"],["は"],["生きる","いきる"],["こと"],["は"],["できない"],["。"],["彼","かれ"],["は"],["これ"],["ら"],["の"],["憎むべき","にくむべき"],["事","こと"],["を"],["した"],["ので"],["、"],["必死","かならずし"],["に"],["、"],["その"],["血","ち"],["は"],["彼","かれ"],["自身","じしん"],["に"],["帰する","きする"],["。"]]},{"verse":14,"text":"しかし彼,かれが子,こを生,うみ、その子,こが父,ちちの行,おこなったすべての罪,つみを見,みて、恐,おそれ、そのようなことを行,おこなわず、","tok":[["しかし"],["彼","かれ"],["が"],["子","こ"],["を"],["生み","うみ"],["、"],["その"],["子","こ"],["が"],["父","ちち"],["の"],["行なった","おこなった"],["すべて"],["の"],["罪","つみ"],["を"],["見て","みて"],["、"],["恐","おそれ"],["、"],["その"],["よう"],["な"],["こと"],["を"],["行なわず","おこなわず"],["、"]]},{"verse":15,"text":"山,やまの上,うえで食事,しょくじせず、目,めをあげてイスラエルの家,いえの偶像,ぐうぞうを仰,あおがず、隣,となり人,びとの妻,つまを犯,おかさず、","tok":[["山","やま"],["の"],["上","うえ"],["で"],["食事","しょくじ"],["せず"],["、"],["目","め"],["を"],["あげて"],["イスラエル"],["の"],["家","いえ"],["の"],["偶像","ぐうぞう"],["を"],["仰がず","あおがず"],["、"],["隣人","となりびと"],["の"],["妻","つま"],["を"],["犯さず","おかさず"],["、"]]},{"verse":16,"text":"だれをもしえたげず、質物,しちもつをひき留,とめず、物,ものを奪,うばわず、かえって自分,じぶんの食物,しょくもつを飢,うえた者,ものに与,あたえ、裸,はだかの者,ものに衣服,いふくを着,きせ、","tok":[["だれ"],["を"],["もし"],["え"],["たげず"],["、"],["質物","しちもつ"],["を"],["ひき"],["留","とめ"],["ず"],["、"],["物","もの"],["を"],["奪わず","うばわず"],["、"],["かえって"],["自分","じぶん"],["の"],["食物","しょくもつ"],["を"],["飢","うえ"],["た"],["者","もの"],["に"],["与","あたえ"],["、"],["裸","はだか"],["の"],["者","もの"],["に"],["衣服","いふく"],["を"],["着せ","きせ"],["、"]]},{"verse":17,"text":"その手,てをひいて悪,あくを行,おこなわず、利息,りそくや高利,こうりをとらず、わたしのおきてを行,おこない、わたしの定,さだめに歩,あゆむならば、彼,かれはその父,ちちの悪,あくのために死,しなず、必,かならず生,いきる。","tok":[["その"],["手","て"],["を"],["ひいて"],["悪","あく"],["を"],["行なわず","おこなわず"],["、"],["利息","りそく"],["や"],["高利","こうり"],["を"],["とらず"],["、"],["わたし"],["の"],["おきて"],["を"],["行ない","おこない"],["、"],["わたし"],["の"],["定め","さだめ"],["に"],["歩むならば","あゆむならば"],["、"],["彼","かれ"],["は"],["その"],["父","ちち"],["の"],["悪","あく"],["の"],["ため"],["に"],["死なず","しなず"],["、"],["必","かならず"],["生きる","いきる"],["。"]]},{"verse":18,"text":"しかしその父,ちちは人,ひとをかすめ、その兄弟,きょうだいの物,ものを奪,うばい、その民,たみの中,なかで良,よくない事,ことを行,おこなったゆえ、見,みよ、彼,かれはその悪,あくのために死,しぬ。","tok":[["しかし"],["その"],["父","ちち"],["は"],["人","ひと"],["を"],["かすめ"],["、"],["その"],["兄弟","きょうだい"],["の"],["物","もの"],["を"],["奪い","うばい"],["、"],["その"],["民","たみ"],["の"],["中","なか"],["で"],["良く","よく"],["ない"],["事","こと"],["を"],["行なった","おこなった"],["ゆえ"],["、"],["見よ","みよ"],["、"],["彼","かれ"],["は"],["その"],["悪","あく"],["の"],["ため"],["に"],["死ぬ","しぬ"],["。"]]},{"verse":19,"text":"しかしあなたがたは、『なぜ、子,こは父,ちちの悪,あくを負,おわないのか』と言,いう。子,こは公道,こうどうと正義,せいぎとを行,おこない、わたしのすべての定,さだめを守,まもっておこなったので、必,かならず生,いきるのである。","tok":[["しかし"],["あなた"],["がた"],["は"],["、"],["『"],["なぜ"],["、"],["子","こ"],["は"],["父","ちち"],["の"],["悪","あく"],["を"],["負わない","おわない"],["の"],["か"],["』"],["と"],["言う","いう"],["。"],["子","こ"],["は"],["公道","こうどう"],["と"],["正義","せいぎと"],["を"],["行ない","おこない"],["、"],["わたし"],["の"],["すべて"],["の"],["定め","さだめ"],["を"],["守って","まもって"],["おこなった"],["ので"],["、"],["必","かならず"],["生きる","いきる"],["ので"],["ある"],["。"]]},{"verse":20,"text":"罪,つみを犯,おかす魂,たましいは死,しぬ。子,こは父,ちちの悪,あくを負,おわない。父,ちちは子,この悪,あくを負,おわない。義人,ぎじんの義,ぎはその人,ひとに帰,きし、悪人,あくにんの悪,あくはその人,ひとに帰,きする。","tok":[["罪","つみ"],["を"],["犯す","おかす"],["魂","たましい"],["は"],["死ぬ","しぬ"],["。"],["子","こ"],["は"],["父","ちち"],["の"],["悪","あく"],["を"],["負わない","おわない"],["。"],["父","ちち"],["は"],["子","こ"],["の"],["悪","あく"],["を"],["負わない","おわない"],["。"],["義人","ぎじん"],["の"],["義","ぎ"],["は"],["その"],["人","ひと"],["に"],["帰し","きし"],["、"],["悪人","あくにん"],["の"],["悪","あく"],["は"],["その"],["人","ひと"],["に"],["帰する","きする"],["。"]]},{"verse":21,"text":"しかし、悪人,あくにんがもしその行,おこなったもろもろの罪,つみを離,はなれ、わたしのすべての定,さだめを守,まもり、公道,こうどうと正義,せいぎとを行,おこなうならば、彼,かれは必,かならず生,いきる。死,しぬことはない。","tok":[["しかし"],["、"],["悪人","あくにん"],["が"],["もし"],["その"],["行なった","おこなった"],["もろもろ"],["の"],["罪","つみ"],["を"],["離れ","はなれ"],["、"],["わたし"],["の"],["すべて"],["の"],["定め","さだめ"],["を"],["守り","まもり"],["、"],["公道","こうどう"],["と"],["正義","せいぎと"],["を"],["行なうならば","おこなうならば"],["、"],["彼","かれ"],["は"],["必","かならず"],["生きる","いきる"],["。"],["死ぬ","しぬ"],["こと"],["は"],["ない"],["。"]]},{"verse":22,"text":"その犯,おかしたもろもろのとがは、彼,かれに対,たいして覚,おぼえられない。彼,かれはそのなした正,ただしい事,ことのために生,いきる。","tok":[["その"],["犯した","おかした"],["もろもろ"],["の"],["とが"],["は"],["、"],["彼","かれ"],["に対して","にたいして"],["覚えられない","おぼえられない"],["。"],["彼","かれ"],["は"],["その"],["なした"],["正い","ただしい"],["事","こと"],["の"],["ため"],["に"],["生きる","いきる"],["。"]]},{"verse":23,"text":"主,しゅなる神,かみは言,いわれる、わたしは悪人,あくにんの死,しを好,このむであろうか。むしろ彼,かれがそのおこないを離,はなれて生,いきることを好,このんでいるではないか。","tok":[["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["、"],["わたし"],["は"],["悪人","あくにん"],["の"],["死","し"],["を"],["好むで","このむで"],["あろう"],["か"],["。"],["むしろ"],["彼","かれ"],["が"],["その"],["おこない"],["を"],["離れて","はなれて"],["生きる","いきる"],["こと"],["を"],["好んで","このんで"],["いるで"],["は"],["ない"],["か"],["。"]]},{"verse":24,"text":"しかし義人,ぎじんがもしその義,ぎを離,はなれて悪,あくを行,おこない、悪人,あくにんのなすもろもろの憎,にくむべき事,ことを行,おこなうならば、生,いきるであろうか。彼,かれが行,おこなったもろもろの正,ただしい事,ことは覚,おぼえられない。彼,かれはその犯,おかしたとがと、その犯,おかした罪,つみとのために死,しぬ。","tok":[["しかし"],["義人","ぎじん"],["が"],["もし"],["その"],["義","ぎ"],["を"],["離れて","はなれて"],["悪","あく"],["を"],["行ない","おこない"],["、"],["悪人","あくにん"],["の"],["なす"],["もろもろ"],["の"],["憎むべき","にくむべき"],["事","こと"],["を"],["行なうならば","おこなうならば"],["、"],["生きるで","いきるで"],["あろう"],["か"],["。"],["彼","かれ"],["が"],["行なった","おこなった"],["もろもろ"],["の"],["正い","ただしい"],["事","こと"],["は"],["覚えられない","おぼえられない"],["。"],["彼","かれ"],["は"],["その"],["犯した","おかした"],["と"],["が"],["と"],["、"],["その"],["犯した","おかした"],["罪","つみ"],["と"],["の"],["ため"],["に"],["死ぬ","しぬ"],["。"]]},{"verse":25,"text":"しかしあなたがたは、『主,しゅのおこないは正,ただしくない』と言,いう。イスラエルの家,いえよ、聞,きけ。わたしのおこないは正,ただしくないのか。正,ただしくないのは、あなたがたのおこないではないか。","tok":[["しかし"],["あなた"],["がた"],["は"],["、"],["『"],["主","しゅ"],["の"],["おこない"],["は"],["正く","ただしく"],["ない"],["』"],["と"],["言う","いう"],["。"],["イスラエル"],["の"],["家","いえ"],["よ"],["、"],["聞け","きけ"],["。"],["わたし"],["の"],["おこない"],["は"],["正く","ただしく"],["ない"],["の"],["か"],["。"],["正く","ただしく"],["ない"],["の"],["は"],["、"],["あなた"],["がた"],["の"],["おこないで"],["は"],["ない"],["か"],["。"]]},{"verse":26,"text":"義人,ぎじんがその義,ぎを離,はなれて悪,あくを行,おこない、そのために死,しぬならば、彼,かれは自分,じぶんの行,おこなった悪,あくのために死,しぬのである。","tok":[["義人","ぎじん"],["が"],["その"],["義","ぎ"],["を"],["離れて","はなれて"],["悪","あく"],["を"],["行ない","おこない"],["、"],["その"],["ため"],["に"],["死ぬならば","しぬならば"],["、"],["彼","かれ"],["は"],["自分","じぶん"],["の"],["行なった","おこなった"],["悪","あく"],["の"],["ため"],["に"],["死ぬ","しぬ"],["ので"],["ある"],["。"]]},{"verse":27,"text":"しかし悪人,あくにんがその行,おこなった悪,あくを離,はなれて、公道,こうどうと正義,せいぎとを行,おこなうならば、彼,かれは自分,じぶんの命,いのちを救,すくうことができる。","tok":[["しかし"],["悪人","あくにん"],["が"],["その"],["行なった","おこなった"],["悪","あく"],["を"],["離れて","はなれて"],["、"],["公道","こうどう"],["と"],["正義","せいぎと"],["を"],["行なうならば","おこなうならば"],["、"],["彼","かれ"],["は"],["自分","じぶん"],["の"],["命","いのち"],["を"],["救う","すくう"],["こと"],["が"],["できる"],["。"]]},{"verse":28,"text":"彼,かれは省,かえりみて、その犯,おかしたすべてのとがを離,はなれたのだから必,かならず生,いきる。死,しぬことはない。","tok":[["彼","かれ"],["は"],["省りみて","かえりみて"],["、"],["その"],["犯した","おかした"],["すべて"],["の"],["とが"],["を"],["離れた","はなれた"],["の"],["だ"],["から"],["必","かならず"],["生きる","いきる"],["。"],["死ぬ","しぬ"],["こと"],["は"],["ない"],["。"]]},{"verse":29,"text":"しかしイスラエルの家,いえは『主,しゅのおこないは正,ただしくない』と言,いう。イスラエルの家,いえよ、わたしのおこないは、はたして正,ただしくないのか。正,ただしくないのは、あなたがたのおこないではないか。","tok":[["しかし"],["イスラエル"],["の"],["家","いえ"],["は"],["『"],["主","しゅ"],["の"],["おこない"],["は"],["正く","ただしく"],["ない"],["』"],["と"],["言う","いう"],["。"],["イスラエル"],["の"],["家","いえ"],["よ"],["、"],["わたし"],["の"],["おこない"],["は"],["、"],["はたして"],["正く","ただしく"],["ない"],["の"],["か"],["。"],["正く","ただしく"],["ない"],["の"],["は"],["、"],["あなた"],["がた"],["の"],["おこないで"],["は"],["ない"],["か"],["。"]]},{"verse":30,"text":"それゆえ、イスラエルの家,いえよ、わたしはあなたがたを、おのおのそのおこないに従,したがってさばくと、主,しゅなる神,かみは言,いわれる。悔,くい改,あらためて、あなたがたのすべてのとがを離,はなれよ。さもないと悪,あくはあなたがたを滅,ほろぼす。","tok":[["それ"],["ゆえ"],["、"],["イスラエル"],["の"],["家","いえ"],["よ"],["、"],["わたし"],["は"],["あなた"],["がた"],["を"],["、"],["おのおの"],["その"],["おこない"],["に"],["従って","したがって"],["さばく"],["と"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"],["悔い","くい"],["改","あらため"],["て"],["、"],["あなた"],["がた"],["の"],["すべて"],["の"],["とが"],["を"],["離れよ","はなれよ"],["。"],["さも"],["ない"],["と"],["悪","あく"],["は"],["あなた"],["がた"],["を"],["滅ぼす","ほろぼす"],["。"]]},{"verse":31,"text":"あなたがたがわたしに対,たいしておこなったすべてのとがを捨,すて去,さり、新,あたらしい心,こころと、新,あたらしい霊,れいとを得,えよ。イスラエルの家,いえよ、あなたがたはどうして死,しんでよかろうか。","tok":[["あなた"],["がた"],["が"],["わたし"],["に対して","にたいして"],["おこなった"],["すべて"],["の"],["とが"],["を"],["捨て去り","すてさり"],["、"],["新らしい","あたらしい"],["心","こころ"],["と"],["、"],["新らしい","あたらしい"],["霊","れい"],["と"],["を"],["得","え"],["よ"],["。"],["イスラエル"],["の"],["家","いえ"],["よ"],["、"],["あなた"],["がた"],["は"],["どう"],["して"],["死んで","しんで"],["よかろう"],["か"],["。"]]},{"verse":32,"text":"わたしは何人,なにびとの死,しをも喜,よろこばないのであると、主,しゅなる神,かみは言,いわれる。それゆえ、あなたがたは翻,ひるがえって生,いきよ」。","tok":[["わたし"],["は"],["何人","な"],["に"],["びと"],["の"],["死","し"],["を"],["も"],["喜こばない","よろこばない"],["ので"],["ある"],["と"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"],["それ"],["ゆえ"],["、"],["あなた"],["がた"],["は"],["翻って","ひるがえって"],["生き","いき"],["よ"],["」"],["。"]]}]
[{"verse":1,"text":"彼,かれはわたしに言,いわれた。「人,ひとの子,こよ、あなたに与,あたえられたものを食,たべなさい。この巻物,まきものを食,たべ、行,いってイスラエルの家,いえに語,かたりなさい」。","tok":[["彼","かれ"],["は"],["わたし"],["に"],["言われた","いわれた"],["。"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["あなた"],["に"],["与えられた","あたえられた"],["もの"],["を"],["食べ","たべ"],["なさい"],["。"],["この"],["巻物","まきもの"],["を"],["食べ","たべ"],["、"],["行って","いって"],["イスラエル"],["の"],["家","いえ"],["に"],["語り","かたり"],["なさい"],["」"],["。"]]},{"verse":2,"text":"そこでわたしが口,くちを開,ひらくと、彼,かれはわたしにその巻物,まきものを食,たべさせた。","tok":[["そこ"],["で"],["わたし"],["が"],["口","くち"],["を"],["開らく","ひらく"],["と"],["、"],["彼","かれ"],["は"],["わたし"],["に"],["その"],["巻物","まきもの"],["を"],["食べさせた","たべさせた"],["。"]]},{"verse":3,"text":"そして彼,かれはわたしに言,いわれた、「人,ひとの子,こよ、わたしがあなたに与,あたえるこの巻物,まきものを食,たべ、これであなたの腹,はらを満,みたしなさい」。わたしがそれを食,たべると、それはわたしの口,くちに甘,あまいこと蜜,みつのようであった。","tok":[["そして"],["彼","かれ"],["は"],["わたし"],["に"],["言われた","いわれた"],["、"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["わたし"],["が"],["あなた"],["に"],["与える","あたえる"],["この"],["巻物","まきもの"],["を"],["食べ","たべ"],["、"],["これ"],["で"],["あなた"],["の"],["腹","はら"],["を"],["満たし","みたし"],["なさい"],["」"],["。"],["わたし"],["が"],["それ"],["を"],["食べる","たべる"],["と"],["、"],["それ"],["は"],["わたし"],["の"],["口","くち"],["に"],["甘い","あまい"],["こと"],["蜜","みつ"],["の"],["よう"],["で"],["あった"],["。"]]},{"verse":4,"text":"彼,かれはまたわたしに言,いわれた、「人,ひとの子,こよ、イスラエルの家,いえに行,いって、わたしの言葉,ことばを語,かたりなさい。","tok":[["彼","かれ"],["は"],["また"],["わたし"],["に"],["言われた","いわれた"],["、"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["イスラエル"],["の"],["家","いえ"],["に"],["行って","いって"],["、"],["わたし"],["の"],["言葉","ことば"],["を"],["語り","かたり"],["なさい"],["。"]]},{"verse":5,"text":"わたしはあなたを、異国,いこく語,ごを用,もちい、舌,したの重,おもい民,たみにつかわすのでなく、イスラエルの家,いえにつかわすのである。","tok":[["わたし"],["は"],["あなた"],["を"],["、"],["異国","いこく"],["語","ご"],["を"],["用い","もちい"],["、"],["舌","した"],["の"],["重い","おもい"],["民","たみ"],["に"],["つかわす"],["ので"],["なく"],["、"],["イスラエル"],["の"],["家","いえ"],["に"],["つかわす"],["ので"],["ある"],["。"]]},{"verse":6,"text":"すなわちあなたがその言葉,ことばを知,しらない、異国,いこく語,ごの舌,したの重,おもい多,おおくの民,たみにつかわすのではない。もしわたしがあなたをそのような民,たみにつかわしたら、彼,かれらはあなたに聞,きいたであろう。","tok":[["すなわち"],["あなた"],["が"],["その"],["言葉","ことば"],["を"],["知らない","しらない"],["、"],["異国","いこく"],["語","ご"],["の"],["舌","した"],["の"],["重い","おもい"],["多く","おおく"],["の"],["民","たみ"],["に"],["つかわす"],["ので"],["は"],["ない"],["。"],["もし"],["わたし"],["が"],["あなた"],["を"],["その"],["よう"],["な"],["民","たみ"],["に"],["つかわしたら"],["、"],["彼","かれ"],["ら"],["は"],["あなた"],["に"],["聞いたで","きいたで"],["あろう"],["。"]]},{"verse":7,"text":"しかしイスラエルの家,いえはあなたに聞,きくのを好,このまない。彼,かれらはわたしに聞,きくのを好,このまないからである。イスラエルの家,いえはすべて厚顔,こうがんでまた強情,ごうじょうである。","tok":[["しかし"],["イスラエル"],["の"],["家","いえ"],["は"],["あなた"],["に"],["聞く","きく"],["の"],["を"],["好まない","このまない"],["。"],["彼","かれ"],["ら"],["は"],["わたし"],["に"],["聞く","きく"],["の"],["を"],["好まない","このまない"],["から"],["で"],["ある"],["。"],["イスラエル"],["の"],["家","いえ"],["は"],["すべて"],["厚顔","こうがん"],["で"],["また"],["強情","ごうじょう"],["で"],["ある"],["。"]]},{"verse":8,"text":"見,みよ、わたしはあなたの顔,かおを彼,かれらの顔,かおに向,むかって堅,かたくし、あなたの額,ひたいを彼,かれらの額,ひたいに向,むかって堅,かたくした。","tok":[["見よ","みよ"],["、"],["わたし"],["は"],["あなた"],["の"],["顔","かお"],["を"],["彼","かれ"],["ら"],["の"],["顔","かお"],["に"],["向かって","むかって"],["堅く","かたく"],["し"],["、"],["あなた"],["の"],["額","ひたい"],["を"],["彼","かれ"],["ら"],["の"],["額","ひたい"],["に"],["向かって","むかって"],["堅く","かたく"],["した"],["。"]]},{"verse":9,"text":"わたしはあなたの額,ひたいを岩,いわよりも堅,かたいダイヤモンドのようにした。ゆえに彼,かれらを恐,おそれてはならない。彼,かれらの顔,かおをはばかってはならない。彼,かれらは反逆,はんぎゃくの家,いえである」。","tok":[["わたし"],["は"],["あなた"],["の"],["額","ひたい"],["を"],["岩","いわ"],["より"],["も"],["堅い","かたい"],["ダイヤモンド"],["の"],["よう"],["に"],["した"],["。"],["ゆえ"],["に"],["彼","かれ"],["ら"],["を"],["恐れて","おそれて"],["は"],["ならない"],["。"],["彼","かれ"],["ら"],["の"],["顔","かお"],["を"],["はばかって"],["は"],["ならない"],["。"],["彼","かれ"],["ら"],["は"],["反逆","はんぎゃく"],["の"],["家","いえ"],["で"],["ある"],["」"],["。"]]},{"verse":10,"text":"また彼,かれはわたしに言,いわれた、「人,ひとの子,こよ、わたしがあなたに語,かたるすべての言葉,ことばをあなたの心,こころにおさめ、あなたの耳,みみに聞,ききなさい。","tok":[["また"],["彼","かれ"],["は"],["わたし"],["に"],["言われた","いわれた"],["、"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["わたし"],["が"],["あなた"],["に"],["語る","かたる"],["すべて"],["の"],["言葉","ことば"],["を"],["あなた"],["の"],["心","こころ"],["に"],["おさめ"],["、"],["あなた"],["の"],["耳","みみ"],["に"],["聞","きき"],["なさい"],["。"]]},{"verse":11,"text":"そして捕囚,ほしゅうの人々,ひとびと、あなたの民,たみの人々,ひとびとの所,ところへ行,いって、彼,かれらが聞,きいても、彼,かれらが拒,こばんでも、『主,しゅなる神,かみはこう言,いわれる』と彼,かれらに言,いいなさい」。","tok":[["そして"],["捕囚","ほしゅう"],["の"],["人々","ひとびと"],["、"],["あなた"],["の"],["民","たみ"],["の"],["人々","ひとびと"],["の"],["所","ところ"],["へ"],["行って","いって"],["、"],["彼","かれ"],["ら"],["が"],["聞いて","きいて"],["も"],["、"],["彼","かれ"],["ら"],["が"],["拒","こばん"],["で"],["も"],["、"],["『"],["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["』"],["と"],["彼","かれ"],["ら"],["に"],["言い","いい"],["なさい"],["」"],["。"]]},{"verse":12,"text":"時,ときに霊,れいがわたしをもたげた。そして主,しゅの栄光,えいこうがその所,ところからのぼった時,とき、わたしの後,うしろに大,おおいなる地震,じしんの響,ひびきを聞,きいた。","tok":[["時","とき"],["に"],["霊","れい"],["が"],["わたし"],["を"],["もたげた"],["。"],["そして"],["主","しゅ"],["の"],["栄光","えいこう"],["が"],["その"],["所","ところ"],["から"],["のぼった"],["時","とき"],["、"],["わたし"],["の"],["後ろ","うしろ"],["に"],["大いなる","おおいなる"],["地震","じしん"],["の"],["響","ひびき"],["を"],["聞いた","きいた"],["。"]]},{"verse":13,"text":"それは互,たがいに相触,あいふれる生,いきものの翼,つばさの音,おとと、そのかたわらの輪,わの音,おとで、大,おおいなる地震,じしんのように響,ひびいた。","tok":[["それ"],["は"],["互","たがい"],["に"],["相","あい"],["触れる","ふれる"],["生きもの","いきもの"],["の"],["翼","つばさ"],["の"],["音","おと"],["と"],["、"],["その"],["かたわら"],["の"],["輪","わ"],["の"],["音","おと"],["で"],["、"],["大いなる","おおいなる"],["地震","じしん"],["の"],["よう"],["に"],["響いた","ひびいた"],["。"]]},{"verse":14,"text":"霊,れいはわたしをもたげ、わたしを取,とり去,さったので、わたしは心,こころを熱,あつくし、苦々,にがにがしい思,おもいで出,でて行,いった。主,しゅの手,てが強,つよくわたしの上,うえにあった。","tok":[["霊","れい"],["は"],["わたし"],["を"],["もたげ"],["、"],["わたし"],["を"],["取","とり"],["去た","さった"],["ので"],["、"],["わたし"],["は"],["心","こころ"],["を"],["熱く","あつく"],["し"],["、"],["苦々しい","にがにがしい"],["思い","おもい"],["で"],["出て","でて"],["行った","いった"],["。"],["主","しゅ"],["の"],["手","て"],["が"],["強く","つよく"],["わたし"],["の"],["上","うえ"],["に"],["あった"],["。"]]},{"verse":15,"text":"そしてわたしはケバル川,がわのほとりのテルアビブにいる捕囚,ほしゅうの人々,ひとびとのもとへ行,いき、七日,なぬかの間,あいだ、驚,おどろきあきれて彼,かれらの中,なかに座,ざした。","tok":[["そして"],["わたし"],["は"],["ケバル"],["川","がわ"],["の"],["ほとり"],["の"],["テルアビブ"],["に"],["いる"],["捕囚","ほしゅう"],["の"],["人々","ひとびと"],["の"],["もと"],["へ"],["行き","いき"],["、"],["七日","なぬか"],["の"],["間","あいだ"],["、"],["驚","おどろき"],["あきれて"],["彼","かれ"],["ら"],["の"],["中","なか"],["に"],["座した","ざした"],["。"]]},{"verse":16,"text":"七日,なぬか過,すぎて後,のち、主,しゅの言葉,ことばがわたしに臨,のぞんだ、","tok":[["七","なな"],["日","にち"],["ぬか"],["過て","すぎて"],["後","の"],["ち"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":17,"text":"「人,ひとの子,こよ、わたしはあなたをイスラエルの家,いえのために見守,みまもる者,ものとした。あなたはわたしの口,くちから言葉,ことばを聞,きくたびに、わたしに代,かわって彼,かれらを戒,いましめなさい。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["わたし"],["は"],["あなた"],["を"],["イスラエル"],["の"],["家","いえ"],["の"],["ため"],["に"],["見","み"],["守者","守もの"],["と"],["した"],["。"],["あなた"],["は"],["わたし"],["の"],["口","くち"],["から"],["言葉","ことば"],["を"],["聞く","きく"],["たび"],["に"],["、"],["わたし"],["に"],["代わって","かわって"],["彼","かれ"],["ら"],["を"],["戒しめ","いましめ"],["なさい"],["。"]]},{"verse":18,"text":"わたしが悪人,あくにんに『あなたは必,かならず死,しぬ』と言,いうとき、あなたは彼,かれの命,いのちを救,すくうために彼,かれを戒,いましめず、また悪人,あくにんを戒,いましめて、その悪,わるい道,みちから離,はなれるように語,かたらないなら、その悪人,あくにんは自分,じぶんの悪,あくのために死,しぬ。しかしその血,ちをわたしはあなたの手,てから求,もとめる。","tok":[["わたし"],["が"],["悪人","あくにん"],["に"],["『"],["あなた"],["は"],["必死","かならずし"],["ぬ"],["』"],["と"],["言う","いう"],["とき"],["、"],["あなた"],["は"],["彼","かれ"],["の"],["命","いのち"],["を"],["救う","すくう"],["ため"],["に"],["彼","かれ"],["を"],["戒しめ","いましめ"],["ず"],["、"],["また"],["悪人","あくにん"],["を"],["戒しめ","いましめ"],["て"],["、"],["その"],["悪い","わるい"],["道","みち"],["から"],["離れる","はなれる"],["よう"],["に"],["語らないなら","かたらないなら"],["、"],["その"],["悪人","あくにん"],["は"],["自分","じぶん"],["の"],["悪","あく"],["の"],["ため"],["に"],["死ぬ","しぬ"],["。"],["しかし"],["その"],["血","ち"],["を"],["わたし"],["は"],["あなた"],["の"],["手","て"],["から"],["求める","もとめる"],["。"]]},{"verse":19,"text":"しかし、もしあなたが悪人,あくにんを戒,いましめても、彼,かれがその悪,あくをも、またその悪,わるい道,みちをも離,はなれないなら、彼,かれはその悪,あくのために死,しぬ。しかしあなたは自分,じぶんの命,いのちを救,すくう。","tok":[["しかし"],["、"],["もし"],["あなた"],["が"],["悪人","あくにん"],["を"],["戒しめ","いましめ"],["て"],["も"],["、"],["彼","かれ"],["が"],["その"],["悪","あく"],["を"],["も"],["、"],["また"],["その"],["悪い","わるい"],["道","みち"],["を"],["も"],["離れないなら","はなれないなら"],["、"],["彼","かれ"],["は"],["その"],["悪","あく"],["の"],["ため"],["に"],["死ぬ","しぬ"],["。"],["しかし"],["あなた"],["は"],["自分","じぶん"],["の"],["命","いのち"],["を"],["救う","すくう"],["。"]]},{"verse":20,"text":"また義人,ぎじんがその義,ぎにそむき、不義,ふぎを行,おこなうなら、わたしは彼,かれの前,まえに、つまずきを置,おき、彼,かれは死,しぬ。あなたが彼,かれを戒,いましめなかったゆえ、彼,かれはその罪,つみのために死,しに、その行,おこなった義,ぎは覚,おぼえられない。しかしその血,ちをわたしはあなたの手,てから求,もとめる。","tok":[["また"],["義人","ぎじん"],["が"],["その"],["義","ぎ"],["に"],["そむき"],["、"],["不義","ふぎ"],["を"],["行なうなら","おこなうなら"],["、"],["わたし"],["は"],["彼","かれ"],["の"],["前","まえ"],["に"],["、"],["つまずき"],["を"],["置き","おき"],["、"],["彼","かれ"],["は"],["死ぬ","しぬ"],["。"],["あなた"],["が"],["彼","かれ"],["を"],["戒しめ","いましめ"],["なかった"],["ゆえ"],["、"],["彼","かれ"],["は"],["その"],["罪","つみ"],["の"],["ため"],["に"],["死に","しに"],["、"],["その"],["行なった","おこなった"],["義","ぎ"],["は"],["覚えられない","おぼえられない"],["。"],["しかし"],["その"],["血","ち"],["を"],["わたし"],["は"],["あなた"],["の"],["手","て"],["から"],["求める","もとめる"],["。"]]},{"verse":21,"text":"けれども、もしあなたが義人,ぎじんを戒,いましめて、罪,つみを犯,おかさないように語,かたり、そして彼,かれが罪,つみを犯,おかさないなら、彼,かれは戒,いましめを受,うけいれたゆえに、その命,いのちを保,たもち、あなたは自分,じぶんの命,いのちを救,すくう」。","tok":[["けれど"],["も"],["、"],["もし"],["あなた"],["が"],["義人","ぎじん"],["を"],["戒しめ","いましめ"],["て"],["、"],["罪","つみ"],["を"],["犯さない","おかさない"],["よう"],["に"],["語り","かたり"],["、"],["そして"],["彼","かれ"],["が"],["罪","つみ"],["を"],["犯さないなら","おかさないなら"],["、"],["彼","かれ"],["は"],["戒しめ","いましめ"],["を"],["受","うけ"],["いれた"],["ゆえ"],["に"],["、"],["その"],["命","いのち"],["を"],["保ち","たもち"],["、"],["あなた"],["は"],["自分","じぶん"],["の"],["命","いのち"],["を"],["救う","すくう"],["」"],["。"]]},{"verse":22,"text":"その所,ところで主,しゅの手,てがわたしの上,うえに臨,のぞみ、彼,かれはわたしに言,いわれた、「立,たって、平野,へいやに出,でて行,いきなさい。その所,ところでわたしはあなたに語,かたろう」。","tok":[["その"],["所","ところ"],["で"],["主","しゅ"],["の"],["手","て"],["が"],["わたし"],["の"],["上","うえ"],["に"],["臨み","のぞみ"],["、"],["彼","かれ"],["は"],["わたし"],["に"],["言われた","いわれた"],["、"],["「"],["立って","たって"],["、"],["平野","へいや"],["に"],["出て","でて"],["行き","いき"],["なさい"],["。"],["その"],["所","ところ"],["で"],["わたし"],["は"],["あなた"],["に"],["語ろう","かたろう"],["」"],["。"]]},{"verse":23,"text":"そこで、わたしは立,たって平野,へいやに出,でて行,いった。見,みよ、主,しゅの栄光,えいこうが、かつてわたしがケバル川,がわのほとりで見,みた栄光,えいこうのように、その所,ところに立,たち現,あらわれたので、わたしはひれ伏,ふした。","tok":[["そこ"],["で"],["、"],["わたし"],["は"],["立って","たって"],["平野","へいや"],["に"],["出て","でて"],["行った","いった"],["。"],["見よ","みよ"],["、"],["主","しゅ"],["の"],["栄光","えいこう"],["が"],["、"],["かつて"],["わたし"],["が"],["ケバル"],["川","がわ"],["の"],["ほとり"],["で"],["見た","みた"],["栄光","えいこう"],["の"],["よう"],["に"],["、"],["その"],["所","ところ"],["に"],["立ち現われた","たちあらわれた"],["ので"],["、"],["わたし"],["は"],["ひれ伏した","ひれふした"],["。"]]},{"verse":24,"text":"しかし霊,れいがわたしのうちにはいって、わたしを立,たちあがらせ、わたしに語,かたって言,いった、「行,いって、あなたの家,いえにこもっていなさい。","tok":[["しかし"],["霊","れい"],["が"],["わたし"],["の"],["うち"],["に"],["はいって"],["、"],["わたし"],["を"],["立ちあがらせ","たちあがらせ"],["、"],["わたし"],["に"],["語って","かたって"],["言った","いった"],["、"],["「"],["行って","いって"],["、"],["あなた"],["の"],["家","いえ"],["に"],["こもって"],["い"],["なさい"],["。"]]},{"verse":25,"text":"人,ひとの子,こよ、見,みよ、彼,かれらはあなたの上,うえになわをかけ、それであなたを縛,しばり、あなたを民,たみの中,なかに行,いかせないようにする。","tok":[["人","ひと"],["の"],["子","こ"],["よ"],["、"],["見よ","みよ"],["、"],["彼","かれ"],["ら"],["は"],["あなた"],["の"],["上","うえ"],["に"],["なわ"],["を"],["かけ"],["、"],["それ"],["で"],["あなた"],["を"],["縛り","しばり"],["、"],["あなた"],["を"],["民","たみ"],["の"],["中","なか"],["に"],["行かせない","いかせない"],["よう"],["に"],["する"],["。"]]},{"verse":26,"text":"わたしはあなたの舌,したを上,うえあごにつかせ、あなたをおしにして、彼,かれらを戒,いましめることができないようにする。彼,かれらは反逆,はんぎゃくの家,いえだからである。","tok":[["わたし"],["は"],["あなた"],["の"],["舌","した"],["を"],["上あご","うえあご"],["に"],["つかせ"],["、"],["あなた"],["を"],["おし"],["に"],["して"],["、"],["彼","かれ"],["ら"],["を"],["戒しめ","いましめ"],["る"],["こと"],["が"],["できない"],["よう"],["に"],["する"],["。"],["彼","かれ"],["ら"],["は"],["反逆","はんぎゃく"],["の"],["家","いえ"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":27,"text":"しかし、わたしがあなたと語,かたるときは、あなたの口,くちを開,ひらく。あなたは彼,かれらに『主,しゅなる神,かみはこう言,いわれる』と言,いわなければならない。聞,きく者,ものは聞,きくがよい、拒,こばむ者,ものは拒,こばむがよい。彼,かれらは反逆,はんぎゃくの家,いえだからである。","tok":[["しかし"],["、"],["わたし"],["が"],["あなた"],["と"],["語る","かたる"],["とき"],["は"],["、"],["あなた"],["の"],["口","くち"],["を"],["開らく","ひらく"],["。"],["あなた"],["は"],["彼","かれ"],["ら"],["に"],["『"],["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["』"],["と"],["言わなければ","いわなければ"],["ならない"],["。"],["聞く","きく"],["者","もの"],["は"],["聞く","きく"],["がよい"],["、"],["拒む","こばむ"],["者","もの"],["は"],["拒む","こばむ"],["が"],["よい"],["。"],["彼","かれ"],["ら"],["は"],["反逆","はんぎゃく"],["の"],["家","いえ"],["だ"],["から"],["で"],["ある"],["。"]]}]
[{"verse":1,"text":"ここにイスラエルの長老,ちょうろうのうちのある人々,ひとびとが、わたしの所,ところに来,きて、わたしの前,まえに座,ざした。","tok":[["ここ"],["に"],["イスラエル"],["の"],["長老","ちょうろう"],["の"],["うち"],["の"],["ある"],["人々","ひとびと"],["が"],["、"],["わたし"],["の"],["所","ところ"],["に"],["来て","きて"],["、"],["わたし"],["の"],["前","まえ"],["に"],["座した","ざした"],["。"]]},{"verse":2,"text":"時,ときに主,しゅの言葉,ことばが、わたしに臨,のぞんだ、","tok":[["時","とき"],["に"],["主","しゅ"],["の"],["言葉","ことば"],["が"],["、"],["わたし"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":3,"text":"「人,ひとの子,こよ、これらの人々,ひとびとは、その偶像,ぐうぞうを心,こころの中,なかに持,もち、罪,つみに落,おとしいれるところのつまずきを、その顔,かおの前,まえに置,おいている。わたしはどうして彼,かれらの願,ねがいをいれることができようか。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["これ"],["ら"],["の"],["人々","ひとびと"],["は"],["、"],["その"],["偶像","ぐうぞう"],["を"],["心","こころ"],["の"],["中","なか"],["に"],["持","もち"],["、"],["罪","つみ"],["に"],["落としいれる","おとしいれる"],["ところ"],["の"],["つまずき"],["を"],["、"],["その"],["顔","かお"],["の"],["前","まえ"],["に"],["置いて","おいて"],["いる"],["。"],["わたし"],["は"],["どう"],["して"],["彼","かれ"],["ら"],["の"],["願い","ねがい"],["を"],["いれる"],["こと"],["が"],["できよう"],["か"],["。"]]},{"verse":4,"text":"それゆえ彼,かれらに告,つげて言,いえ、主,しゅなる神,かみは、こう言,いわれる、イスラエルの家,いえの人々,ひとびとで、その偶像,ぐうぞうを心,こころの中,なかに持,もち、その顔,かおの前,まえに罪,つみに落,おとしいれるところのつまずくものを置,おきながら、預言者,よげんしゃのもとに来,くる者,ものには、その多,おおくの偶像,ぐうぞうのゆえに、主,しゅなるわたしは、みずからこれに答,こたえをする。","tok":[["それ"],["ゆえ"],["彼","かれ"],["ら"],["に"],["告","つげ"],["て"],["言え","いえ"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["、"],["こう"],["言われる","いわれる"],["、"],["イスラエル"],["の"],["家","いえ"],["の"],["人々","ひとびと"],["で"],["、"],["その"],["偶像","ぐうぞう"],["を"],["心","こころ"],["の"],["中","なか"],["に"],["持","もち"],["、"],["その"],["顔","かお"],["の"],["前","まえ"],["に"],["罪","つみ"],["に"],["落としいれる","おとしいれる"],["ところ"],["の"],["つまずく"],["もの"],["を"],["置き","おき"],["ながら"],["、"],["預言者","よげんしゃ"],["の"],["もと"],["に"],["来る","くる"],["者","もの"],["に"],["は"],["、"],["その"],["多く","おおく"],["の"],["偶像","ぐうぞう"],["の"],["ゆえ"],["に"],["、"],["主","しゅ"],["なる"],["わたし"],["は"],["、"],["みずから"],["これ"],["に"],["答","こたえ"],["を"],["する"],["。"]]},{"verse":5,"text":"これはその偶像,ぐうぞうのために、すべてわたしを離,はなれたイスラエルの家,いえの心,こころを、わたしが捕,とらえるためである。","tok":[["これ"],["は"],["その"],["偶像","ぐうぞう"],["の"],["ため"],["に"],["、"],["すべて"],["わたし"],["を"],["離れた","はなれた"],["イスラエル"],["の"],["家","いえ"],["の"],["心","こころ"],["を"],["、"],["わたし"],["が"],["捕らえる","とらえる"],["ため"],["で"],["ある"],["。"]]},{"verse":6,"text":"それゆえイスラエルの家,いえに言,いえ、主,しゅなる神,かみはこう言,いわれる、あなたがたは悔,くいて、あなたがたの偶像,ぐうぞうを捨,すてよ。あなたがたの顔,かおを、そのすべての憎,にくむべきものからそむけよ。","tok":[["それ"],["ゆえ"],["イスラエル"],["の"],["家","いえ"],["に"],["言え","いえ"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["あなた"],["がた"],["は"],["悔いて","くいて"],["、"],["あなた"],["がた"],["の"],["偶像","ぐうぞう"],["を"],["捨てよ","すてよ"],["。"],["あなた"],["がた"],["の"],["顔","かお"],["を"],["、"],["その"],["すべて"],["の"],["憎むべき","にくむべき"],["もの"],["から"],["そむけよ"],["。"]]},{"verse":7,"text":"イスラエルの家,いえの者,ものおよびイスラエルに宿,やどる外国,がいこく人,じんのだれでも、わたしから離,はなれ、その心,こころに偶像,ぐうぞうを持,もち、その顔,かおの前,まえに罪,つみに落,おとしいれるところのつまずきを置,おきながら、預言者,よげんしゃに来,きて、心,こころのままにわたしに求,もとめるときは、主,しゅであるわたしは、みずからこれに答,こたえをする。","tok":[["イスラエル"],["の"],["家","いえ"],["の"],["者","もの"],["および"],["イスラエル"],["に"],["宿る","やどる"],["外国人","がいこくじん"],["の"],["だれ"],["で"],["も"],["、"],["わたし"],["から"],["離れ","はなれ"],["、"],["その"],["心","こころ"],["に"],["偶像","ぐうぞう"],["を"],["持","もち"],["、"],["その"],["顔","かお"],["の"],["前","まえ"],["に"],["罪","つみ"],["に"],["落としいれる","おとしいれる"],["ところ"],["の"],["つまずき"],["を"],["置き","おき"],["ながら"],["、"],["預言者","よげんしゃ"],["に"],["来て","きて"],["、"],["心","こころ"],["の"],["まま"],["に"],["わたし"],["に"],["求める","もとめる"],["とき"],["は"],["、"],["主","しゅ"],["で"],["ある"],["わたし"],["は"],["、"],["みずから"],["これ"],["に"],["答","こたえ"],["を"],["する"],["。"]]},{"verse":8,"text":"わたしはわたしの顔,かおを、その人,ひとに向,むけ、彼,かれを、しるし、およびことわざとなし、これをわが民,たみのうちから断,たち滅,ほろぼす。その時,とき、あなたがたはわたしが主,しゅであることを知,しるようになる。","tok":[["わたし"],["は"],["わたし"],["の"],["顔","かお"],["を"],["、"],["その"],["人","ひと"],["に"],["向け","むけ"],["、"],["彼","かれ"],["を"],["、"],["しるし"],["、"],["および"],["ことわざ"],["と"],["なし"],["、"],["これ"],["を"],["わが"],["民","たみ"],["の"],["うち"],["から"],["断ち","たち"],["滅ぼす","ほろぼす"],["。"],["その"],["時","とき"],["、"],["あなた"],["がた"],["は"],["わたし"],["が"],["主","しゅ"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"]]},{"verse":9,"text":"もし預言者,よげんしゃが欺,あざむかれて言葉,ことばを出,だすことがあれば、それは主,しゅであるわたしが、その預言者,よげんしゃを欺,あざむいたのである。わたしは手,てを彼,かれの上,うえに伸,のべ、わが民,たみイスラエルのうちから彼,かれを滅,ほろぼす。","tok":[["もし"],["預言者","よげんしゃ"],["が"],["欺かれて","あざむかれて"],["言葉","ことば"],["を"],["出す","だす"],["こと"],["が"],["あれば"],["、"],["それ"],["は"],["主","しゅ"],["で"],["ある"],["わたし"],["が"],["、"],["その"],["預言者","よげんしゃ"],["を"],["欺いた","あざむいた"],["ので"],["ある"],["。"],["わたし"],["は"],["手","て"],["を"],["彼","かれ"],["の"],["上","うえ"],["に"],["伸べ","のべ"],["、"],["わが"],["民","た"],["みイスラエル"],["の"],["うち"],["から"],["彼","かれ"],["を"],["滅ぼす","ほろぼす"],["。"]]},{"verse":10,"text":"彼,かれらはその罰,ばつを負,おう。その預言者,よげんしゃの罰,ばつは、問,とい求,もとめる者,ものの罰,ばつと同様,どうようである。","tok":[["彼","かれ"],["ら"],["は"],["その"],["罰","ばつ"],["を"],["負う","おう"],["。"],["その"],["預言者","よげんしゃ"],["の"],["罰","ばつ"],["は"],["、"],["問","とい"],["求める","もとめる"],["者","もの"],["の"],["罰","ばつ"],["と"],["同様","どうよう"],["で"],["ある"],["。"]]},{"verse":11,"text":"これはイスラエルの家,いえが、重,かさねてわたしを離,はなれて迷,まよわず、重,かさねてそのもろもろのとがによって、おのれを汚,けがさないため、また彼,かれらがわが民,たみとなり、わたしが彼,かれらの神,かみとなるためであると、主,しゅなる神,かみは言,いわれる」。","tok":[["これ"],["は"],["イスラエル"],["の"],["家","いえ"],["が"],["、"],["重ねて","かさねて"],["わたし"],["を"],["離れて","はなれて"],["迷わず","まよわず"],["、"],["重ねて","かさねて"],["その"],["もろもろ"],["の"],["とが"],["によって"],["、"],["おのれ"],["を"],["汚","け"],["がさ"],["ない"],["ため"],["、"],["また"],["彼","かれ"],["ら"],["が"],["わが"],["民","たみ"],["と"],["なり"],["、"],["わたし"],["が"],["彼","かれ"],["ら"],["の"],["神","かみ"],["と"],["なる"],["ため"],["で"],["ある"],["と"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["」"],["。"]]},{"verse":12,"text":"主,しゅの言葉,ことばが、またわたしに臨,のぞんだ、","tok":[["主","しゅ"],["の"],["言葉","ことば"],["が"],["、"],["また"],["わたし"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":13,"text":"「人,ひとの子,こよ、もし国,くにがわたしに、もとりそむいて罪,つみを犯,おかし、わたしがその上,うえに手,てを伸,のべて、そのつえとたのむパンを砕,くだき、これにききんを送,おくり、人,ひとと獣,けものとをそのうちから断,たつ時,とき、","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["もし"],["国","くに"],["が"],["わたし"],["に"],["、"],["もとり"],["そむいて"],["罪","つみ"],["を"],["犯し","おかし"],["、"],["わたし"],["が"],["その"],["上","うえ"],["に"],["手","て"],["を"],["伸べて","のべて"],["、"],["その"],["つえ"],["と"],["たのむ"],["パン"],["を"],["砕き","くだき"],["、"],["これ"],["に"],["ききん"],["を"],["送り","おくり"],["、"],["人","ひと"],["と"],["獣","けもの"],["と"],["を"],["その"],["うち"],["から"],["断つ","たつ"],["時","とき"],["、"]]},{"verse":14,"text":"たといそこにノア、ダニエル、ヨブの三人,にんがいても、彼,かれらはその義,ぎによって、ただ自分,じぶんの命,いのちを救,すくいうるのみであると、主,しゅなる神,かみは言,いわれる。","tok":[["たとい"],["そこ"],["に"],["ノア"],["、"],["ダニエル"],["、"],["ヨブ"],["の"],["三人","にん"],["が"],["いて"],["も"],["、"],["彼","かれ"],["ら"],["は"],["その"],["義","ぎ"],["によって"],["、"],["ただ"],["自分","じぶん"],["の"],["命","いのち"],["を"],["救い","すくい"],["うる"],["のみ"],["で"],["ある"],["と"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"]]},{"verse":15,"text":"もしわたしが野,のの獣,けものにこの地,ちを通,とおらせ、これを荒,あらさせ、これを荒,あれ地,ちとなし、その獣,けもののためにそこを通,とおる者,ものがないようにしたなら、","tok":[["もし"],["わたし"],["が"],["野","の"],["の"],["獣","けもの"],["に"],["この"],["地","ち"],["を"],["通らせ","とおらせ"],["、"],["これ"],["を"],["荒させ","あらさせ"],["、"],["これ"],["を"],["荒れ地","あれち"],["と"],["なし"],["、"],["その"],["獣","けもの"],["の"],["ため"],["に"],["そこ"],["を"],["通る","とおる"],["者","もの"],["が"],["ない"],["よう"],["に"],["したなら"],["、"]]},{"verse":16,"text":"主,しゅなる神,かみは言,いわれる、わたしは生,いきている、たといこれら三人,にんの者,ものがその中,なかにいても、そのむすこ娘,むすめを救,すくうことはできない。ただ自分,じぶん自身,じしんを救,すくいうるのみで、その地,ちは荒,あれ地,ちとなる。","tok":[["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["、"],["わたし"],["は"],["生きて","いきて"],["いる"],["、"],["たとい"],["これ"],["ら"],["三人","にん"],["の"],["者","もの"],["が"],["その"],["中","なか"],["に"],["いて"],["も"],["、"],["その"],["むすこ"],["娘","むすめ"],["を"],["救う","すくう"],["こと"],["は"],["できない"],["。"],["ただ"],["自分","じぶん"],["自身","じしん"],["を"],["救い","すくい"],["うる"],["のみ"],["で"],["、"],["その"],["地","ち"],["は"],["荒れ地","あれち"],["と"],["なる"],["。"]]},{"verse":17,"text":"あるいは、わたしがもし、つるぎをその地,ちに臨,のぞませ、つるぎよ、この地,ちを行,ゆきめぐれと言,いって、人,ひとと獣,けものとをそこから断,たつならば、","tok":[["あるいは"],["、"],["わたし"],["が"],["もし"],["、"],["つるぎ"],["を"],["その"],["地","ち"],["に"],["臨ませ","のぞませ"],["、"],["つるぎ"],["よ"],["、"],["この"],["地","ち"],["を"],["行","ゆきめぐれ"],["と"],["言って","いって"],["、"],["人","ひと"],["と"],["獣","けもの"],["と"],["を"],["そこ"],["から"],["断つならば","たつならば"],["、"]]},{"verse":18,"text":"主,しゅなる神,かみは言,いわれる、わたしは生,いきている、たといこれら三人,にんの者,ものがその中,なかにいても、そのむすこ娘,むすめを救,すくうことはできない。ただ自分,じぶん自身,じしんを救,すくいうるのみである。","tok":[["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["、"],["わたし"],["は"],["生きて","いきて"],["いる"],["、"],["たとい"],["これ"],["ら"],["三人","にん"],["の"],["者","もの"],["が"],["その"],["中","なか"],["に"],["いて"],["も"],["、"],["その"],["むすこ"],["娘","むすめ"],["を"],["救う","すくう"],["こと"],["は"],["できない"],["。"],["ただ"],["自分","じぶん"],["自身","じしん"],["を"],["救い","すくい"],["うる"],["のみ"],["で"],["ある"],["。"]]},{"verse":19,"text":"あるいは、わたしがもし、この地,ちに疫病,えきびょうを送,おくり、血,ちをもってわが憤,いきどおりをその上,うえに注,そそぎ、人,ひとと獣,けものとをそこから断,たつならば、","tok":[["あるいは"],["、"],["わたし"],["が"],["もし"],["、"],["この"],["地","ち"],["に"],["疫病","えきびょう"],["を"],["送り","おくり"],["、"],["血","ち"],["を"],["もって"],["わが"],["憤り","いきどおり"],["を"],["その"],["上","うえ"],["に"],["注ぎ","そそぎ"],["、"],["人","ひと"],["と"],["獣","けもの"],["と"],["を"],["そこ"],["から"],["断つならば","たつならば"],["、"]]},{"verse":20,"text":"主,しゅなる神,かみは言,いわれる、わたしは生,いきている、たといノア、ダニエル、ヨブがそこにいても、彼,かれらはそのむすこ娘,むすめを救,すくうことができない。ただその義,ぎによって自分,じぶんの命,いのちを救,すくいうるのみである。","tok":[["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["、"],["わたし"],["は"],["生きて","いきて"],["いる"],["、"],["たとい"],["ノア"],["、"],["ダニエル"],["、"],["ヨブ"],["が"],["そこ"],["に"],["いて"],["も"],["、"],["彼","かれ"],["ら"],["は"],["その"],["むすこ"],["娘","むすめ"],["を"],["救う","すくう"],["こと"],["が"],["できない"],["。"],["ただ"],["その"],["義","ぎ"],["によって"],["自分","じぶん"],["の"],["命","いのち"],["を"],["救い","すくい"],["うる"],["のみ"],["で"],["ある"],["。"]]},{"verse":21,"text":"主,しゅなる神,かみはこう言,いわれる、わたしが人,ひとと獣,けものとを地,ちから断,たつために、つるぎと、ききんと、悪,あしき獣,けものと、疫病,えきびょうとの四つのきびしい罰,ばつをエルサレムに送,おくる時,ときはどうであろうか。","tok":[["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["わたし"],["が"],["人","ひと"],["と"],["獣","けもの"],["と"],["を"],["地","ち"],["から"],["断つ","たつ"],["ため"],["に"],["、"],["つるぎ"],["と"],["、"],["ききん"],["と"],["、"],["悪しき","あしき"],["獣","けもの"],["と"],["、"],["疫病","えきびょうと"],["の"],["四","よん"],["つ"],["の"],["きびしい"],["罰","ばつ"],["を"],["エルサレム"],["に"],["送る","おくる"],["時","とき"],["は"],["どう"],["で"],["あろう"],["か"],["。"]]},{"verse":22,"text":"しかし、もしそれがあなたがたに来,くるとき、むすこ娘,むすめたちを助,たすけ出,だす者,ものが、その中,なかに残,のこっていて、あなたがたがその行,おこないと、わざとを見,みるならば、わたしがエルサレムの上,うえに与,あたえたすべての災,わざわいについて慰,なぐさめられるであろう。","tok":[["しかし"],["、"],["もし"],["それ"],["が"],["あなた"],["がた"],["に"],["来る","くる"],["とき"],["、"],["むすこ"],["娘","むすめ"],["たち"],["を"],["助け出す","たすけだす"],["者","もの"],["が"],["、"],["その"],["中","なか"],["に"],["残って","のこって"],["いて"],["、"],["あなた"],["がた"],["が"],["その"],["行ない","おこない"],["と"],["、"],["わざと"],["を"],["見るならば","みるならば"],["、"],["わたし"],["が"],["エルサレム"],["の"],["上","うえ"],["に"],["与","あたえ"],["た"],["すべて"],["の"],["災","わざわい"],["について"],["慰さめられるで","なぐさめられるで"],["あろう"],["。"]]},{"verse":23,"text":"すなわち、あなたがたが、その行,おこないと、わざとを見,みる時,とき、彼,かれらはあなたがたを慰,なぐさめ、あなたがたはわたしがこれに行,おこなった事,ことは、すべてゆえなくしたのではないことを知,しるようになると、主,しゅなる神,かみは言,いわれる」。","tok":[["すなわち"],["、"],["あなた"],["が"],["た"],["が"],["、"],["その"],["行ない","おこない"],["と"],["、"],["わざと"],["を"],["見る","みる"],["時","とき"],["、"],["彼","かれ"],["ら"],["は"],["あなた"],["がた"],["を"],["慰さめ","なぐさめ"],["、"],["あなた"],["がた"],["は"],["わたし"],["が"],["これ"],["に"],["行なった","おこなった"],["事","こと"],["は"],["、"],["すべて"],["ゆえ"],["なくした"],["ので"],["は"],["ない"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["と"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["」"],["。"]]}]
[{"verse":1,"text":"主,しゅの言葉,ことばがわたしに臨,のぞんだ、","tok":[["主","しゅ"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":2,"text":"「人,ひとの子,こよ、イスラエルの預言者,よげんしゃたちに向,むかって預言,よげんせよ。すなわち自分,じぶんの心,こころのままに預言,よげんする人々,ひとびとに向,むかって、預言,よげんして言,いえ、『あなたがたは主,しゅの言葉,ことばを聞,きけ』。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["イスラエル"],["の"],["預言者","よげんしゃ"],["たち"],["に"],["向かって","むかって"],["預言","よげん"],["せよ"],["。"],["すなわち"],["自分","じぶん"],["の"],["心","こころ"],["の"],["まま"],["に"],["預言","よげん"],["する"],["人々","ひとびと"],["に"],["向かって","むかって"],["、"],["預言","よげん"],["して"],["言え","いえ"],["、"],["『"],["あなた"],["がた"],["は"],["主","しゅ"],["の"],["言葉","ことば"],["を"],["聞け","きけ"],["』"],["。"]]},{"verse":3,"text":"主,しゅなる神,かみはこう言,いわれる、なにも見,みないで、自分,じぶんの霊,れいに従,したがう愚,おろかな預言者,よげんしゃたちはわざわいだ。","tok":[["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["なに"],["も"],["見ないで","みないで"],["、"],["自分","じぶん"],["の"],["霊","れい"],["に"],["従う","したがう"],["愚か","おろか"],["な"],["預言者","よげんしゃ"],["たち"],["は"],["わざわい"],["だ"],["。"]]},{"verse":4,"text":"イスラエルよ、あなたの預言者,よげんしゃたちは、荒,あれ跡,あとにいるきつねのようだ。","tok":[["イスラエル"],["よ"],["、"],["あなた"],["の"],["預言者","よげんしゃ"],["たち"],["は"],["、"],["荒れ","あれ"],["跡","あと"],["に"],["いる"],["きつね"],["の"],["よう"],["だ"],["。"]]},{"verse":5,"text":"あなたがたは主,しゅの日,ひに戦,たたかいに立,たつため、破,やぶれ口,くちにのぼらず、またイスラエルの家,いえのために石,いしがきを築,きずこうともしない。","tok":[["あなた"],["がた"],["は"],["主","しゅ"],["の"],["日","ひ"],["に"],["戦い","たたかい"],["に"],["立つ","たつ"],["ため"],["、"],["破れ","やぶれ"],["口","くち"],["に"],["のぼらず"],["、"],["また"],["イスラエル"],["の"],["家","いえ"],["の"],["ため"],["に"],["石がき","いしがき"],["を"],["築こう","きずこう"],["と"],["も"],["しない"],["。"]]},{"verse":6,"text":"彼,かれらは虚偽,きょぎを言,いい、偽,いつわりを占,うらなった。彼,かれらは主,しゅが彼,かれらをつかわさないのに『主,しゅが言,いわれる』と言,いい、なおその言葉,ことばの成就,じょうじゅすることを期待,きたいする。","tok":[["彼","かれ"],["ら"],["は"],["虚偽","きょぎ"],["を"],["言い","いい"],["、"],["偽り","いつわり"],["を"],["占った","うらなった"],["。"],["彼","かれ"],["ら"],["は"],["主","しゅ"],["が"],["彼","かれ"],["ら"],["を"],["つかわさない"],["のに"],["『"],["主","しゅ"],["が"],["言われる","いわれる"],["』"],["と"],["言い","いい"],["、"],["なお"],["その"],["言葉","ことば"],["の"],["成就","じょうじゅ"],["する"],["こと"],["を"],["期待","きたい"],["する"],["。"]]},{"verse":7,"text":"あなたがたはむなしい幻,まぼろしを見,み、偽,いつわりの占,うらないを語,かたり、わたしが言,いわないのに『主,しゅが言,いわれる』と言,いったではないか」。","tok":[["あなた"],["がた"],["は"],["むなしい"],["幻","まぼろし"],["を"],["見","み"],["、"],["偽わり","いつわり"],["の"],["占","うらない"],["を"],["語り","かたり"],["、"],["わたし"],["が"],["言わない","いわない"],["のに"],["『"],["主","しゅ"],["が"],["言われる","いわれる"],["』"],["と"],["言ったで","いったで"],["は"],["ない"],["か"],["」"],["。"]]},{"verse":8,"text":"それゆえ、主,しゅなる神,かみはこう言,いわれる、「あなたがたはむなしいことを語,かたり、偽,いつわりの物,ものを見,みるゆえ、わたしはあなたがたを罰,ばっすると主,しゅなる神,かみは言,いわれる。","tok":[["それ"],["ゆえ"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["「"],["あなた"],["がた"],["は"],["むなしい"],["こと"],["を"],["語り","かたり"],["、"],["偽わり","いつわり"],["の"],["物","もの"],["を"],["見る","みる"],["ゆえ"],["、"],["わたし"],["は"],["あなた"],["がた"],["を"],["罰する","ばっする"],["と"],["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"]]},{"verse":9,"text":"わたしの手,ては、むなしい幻,まぼろしを見,み、偽,いつわりの占,うらないを言,いう預言者,よげんしゃに敵対,てきたいする。彼,かれらはわが民,たみの会,かいに臨,のぞまず、イスラエルの家,いえの籍,せきにしるされず、イスラエルの地,ちに、はいることができない。そしてあなたがたはわたしが主,しゅなる神,かみであることを知,しるようになる。","tok":[["わたし"],["の"],["手","て"],["は"],["、"],["むなしい"],["幻","まぼろし"],["を"],["見","み"],["、"],["偽わり","いつわり"],["の"],["占","うらない"],["を"],["言う","いう"],["預言者","よげんしゃ"],["に"],["敵対","てきたい"],["する"],["。"],["彼","かれ"],["ら"],["は"],["わが"],["民","たみ"],["の"],["会","かい"],["に"],["臨まず","のぞまず"],["、"],["イスラエル"],["の"],["家","いえ"],["の"],["籍","せき"],["に"],["しるされず"],["、"],["イスラエル"],["の"],["地","ち"],["に"],["、"],["はいる"],["こと"],["が"],["できない"],["。"],["そして"],["あなた"],["がた"],["は"],["わたし"],["が"],["主","しゅ"],["なる"],["神","かみ"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"]]},{"verse":10,"text":"彼,かれらはわが民,たみを惑,まどわし、平和,へいわがないのに『平和,へいわ』と言,いい、また民,たみが塀,へいを築,きずく時,とき、これらの預言者,よげんしゃたちは水,みずしっくいをもってこれを塗,ぬる。","tok":[["彼","かれ"],["ら"],["は"],["わが"],["民","たみ"],["を"],["惑わし","まどわし"],["、"],["平和","へいわ"],["が"],["ない"],["のに"],["『"],["平和","へいわ"],["』"],["と"],["言い","いい"],["、"],["また"],["民","た"],["み"],["が"],["塀","へい"],["を"],["築く","きずく"],["時","とき"],["、"],["これ"],["ら"],["の"],["預言者","よげんしゃ"],["たち"],["は"],["水","みず"],["しっくい"],["を"],["もって"],["これ"],["を"],["塗る","ぬる"],["。"]]},{"verse":11,"text":"それゆえ、水,みずしっくいを塗,ぬる者,ものどもに『これはかならずくずれる』と言,いえ。これに大雨,おおあめが注,そそぎ、ひょうが降,ふり、あらしが吹,ふく。","tok":[["それ"],["ゆえ"],["、"],["水","みず"],["しっくい"],["を"],["塗る","ぬる"],["者","もの"],["ども"],["に"],["『"],["これ"],["は"],["かならず"],["くずれる"],["』"],["と"],["言え","いえ"],["。"],["これ"],["に"],["大雨","おおあめ"],["が"],["注ぎ","そそぎ"],["、"],["ひょう"],["が"],["降り","ふり"],["、"],["あらし"],["が"],["吹く","ふく"],["。"]]},{"verse":12,"text":"そして塀,へいがくずれる時,とき、人々,ひとびとはあなたがたに向,むかって、『あなたがたが塗,ぬった水,みずしっくいはどこにあるか』と言,いわないであろうか。","tok":[["そして"],["塀","へい"],["が"],["くずれる"],["時","とき"],["、"],["人々","ひとびと"],["は"],["あなた"],["がた"],["に"],["向かって","むかって"],["、"],["『"],["あなた"],["がた"],["が"],["塗った","ぬった"],["水","みず"],["しっくい"],["は"],["どこ"],["に"],["ある"],["か"],["』"],["と"],["言わないで","いわないで"],["あろう"],["か"],["。"]]},{"verse":13,"text":"それゆえ、主,しゅなる神,かみはこう言,いわれる、わたしはわが憤,いきどおりをもって大風,おおかぜを起,おこし、わが怒,いかりをもって大雨,おおあめを注,そそがせ、憤,いきどおりをもってひょうを降,ふらせて、これを滅,ほろぼす。","tok":[["それ"],["ゆえ"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["わたし"],["は"],["わが"],["憤り","いきどおり"],["を"],["もって"],["大風","おおかぜ"],["を"],["起こし","おこし"],["、"],["わが"],["怒り","いかり"],["を"],["もって"],["大雨","おおあめ"],["を"],["注がせ","そそがせ"],["、"],["憤り","いきどおり"],["を"],["もって"],["ひょう"],["を"],["降らせて","ふらせて"],["、"],["これ"],["を"],["滅ぼす","ほろぼす"],["。"]]},{"verse":14,"text":"またわたしはあなたがたが水,みずしっくいをもって塗,ぬった塀,へいをこわして、これを地,ちに倒,たおし、その基,もといをあらわす。これが倒,たおれる時,とき、あなたがたはその中,なかに滅,ほろびる。そしてあなたがたは、わたしが主,しゅであることを知,しるようになる。","tok":[["また"],["わたし"],["は"],["あなた"],["がた"],["が"],["水","みず"],["しっくい"],["を"],["もって"],["塗った","ぬった"],["塀","へい"],["を"],["こわして"],["、"],["これ"],["を"],["地","ち"],["に"],["倒し","たおし"],["、"],["その"],["基い","もとい"],["を"],["あらわす"],["。"],["これ"],["が"],["倒れる","たおれる"],["時","とき"],["、"],["あなた"],["がた"],["は"],["その"],["中","なか"],["に"],["滅びる","ほろびる"],["。"],["そして"],["あなた"],["がた"],["は"],["、"],["わたし"],["が"],["主","しゅ"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"]]},{"verse":15,"text":"こうしてわたしが、その塀,へいと、これを水,みずしっくいで塗,ぬった者,ものとの上,うえに、わたしの憤,いきどおりを漏,もらし尽,つくして、あなたがたに言,いう、塀,へいはなくなり、これを塗,ぬった者,ものもなくなる。","tok":[["こう"],["して"],["わたし"],["が"],["、"],["その"],["塀","へい"],["と"],["、"],["これ"],["を"],["水","みず"],["しっくい"],["で"],["塗った","ぬった"],["者","もの"],["と"],["の"],["上","うえ"],["に"],["、"],["わたし"],["の"],["憤り","いきどおり"],["を"],["漏らし","もらし"],["尽くして","つくして"],["、"],["あなた"],["がた"],["に"],["言う","いう"],["、"],["塀","へい"],["は"],["なくなり"],["、"],["これ"],["を"],["塗った","ぬった"],["者","もの"],["も"],["なくなる"],["。"]]},{"verse":16,"text":"これがすなわち平和,へいわがないのに平和,へいわの幻,まぼろしを見,み、エルサレムについて預言,よげんしたイスラエルの預言者,よげんしゃであると、主,しゅなる神,かみは言,いわれる。","tok":[["これ"],["が"],["すなわち"],["平和","へいわ"],["が"],["ない"],["のに"],["平和","へいわ"],["の"],["幻","まぼろし"],["を"],["見","み"],["、"],["エルサレム"],["について"],["預言","よげん"],["した"],["イスラエル"],["の"],["預言者","よげんしゃ"],["で"],["ある"],["と"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"]]},{"verse":17,"text":"人,ひとの子,こよ、心,こころのままに預言,よげんするあなたの民,たみの娘,むすめたちに対,たいして、あなたの顔,かおを向,むけ、彼,かれらに向,むかって預言,よげんして、","tok":[["人","ひと"],["の"],["子","こ"],["よ"],["、"],["心","こころ"],["の"],["まま"],["に"],["預言","よげん"],["する"],["あなた"],["の"],["民","たみ"],["の"],["娘","むすめ"],["たち"],["に対して","にたいして"],["、"],["あなた"],["の"],["顔","かお"],["を"],["向け","むけ"],["、"],["彼","かれ"],["ら"],["に"],["向かって","むかって"],["預言","よげん"],["して"],["、"]]},{"verse":18,"text":"言,いえ、主,しゅなる神,かみはこう言,いわれる、手,ての節々,ふしぶしに占,うらないひもを縫,ぬいつけ、もろもろの大,おおきさの人,ひとの頭,あたまに、かぶり物,ものを作,つくりかぶせて、魂,たましいをかり取,とろうとする女,おんなはわざわいだ。あなたがたは、わが民,たみの魂,たましいをかり取,とって、あなたがたの利益,りえきのために、他,たの魂,たましいを生,いかしおこうとするのか。","tok":[["言え","いえ"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["手","て"],["の"],["節々","ふしぶし"],["に"],["占","うらない"],["ひも"],["を"],["縫","ぬい"],["つけ"],["、"],["もろもろ"],["の"],["大きさ","おおきさ"],["の"],["人","ひと"],["の"],["頭","あたま"],["に"],["、"],["かぶり物","かぶりもの"],["を"],["作り","つくり"],["かぶせて"],["、"],["魂","たましい"],["を"],["かり取ろう","かりとろう"],["と"],["する"],["女","おんな"],["は"],["わざわい"],["だ"],["。"],["あなた"],["がた"],["は"],["、"],["わが"],["民","たみ"],["の"],["魂","たましい"],["を"],["かり取って","かりとって"],["、"],["あなた"],["がた"],["の"],["利益","りえき"],["の"],["ため"],["に"],["、"],["他","た"],["の"],["魂","たましい"],["を"],["生かし","いかし"],["おこう"],["と"],["する"],["の"],["か"],["。"]]},{"verse":19,"text":"あなたがたは少,すこしばかりの大麦,おおむぎのため、少,すこしばかりのパンのために、わが民,たみのうちに、わたしを汚,けがし、かの偽,いつわりを聞,ききいれるわが民,たみに偽,いつわりを述,のべて、死,しんではならない者,ものを死,しなせ、生,いきていてはならない者,ものを生,いかす。","tok":[["あなた"],["がた"],["は"],["少し","すこし"],["ばかり"],["の"],["大麦","おおむぎ"],["の"],["ため"],["、"],["少し","すこし"],["ばかり"],["の"],["パン"],["の"],["ため"],["に"],["、"],["わが"],["民","たみ"],["の"],["うち"],["に"],["、"],["わたし"],["を"],["汚","け"],["がし"],["、"],["かの"],["偽り","いつわり"],["を"],["聞きいれる","ききいれる"],["わが"],["民","たみ"],["に"],["偽り","いつわり"],["を"],["述べて","のべて"],["、"],["死","しん"],["で"],["は"],["ならない"],["者","もの"],["を"],["死なせ","しなせ"],["、"],["生きて","いきて"],["いて"],["は"],["ならない"],["者","もの"],["を"],["生かす","いかす"],["。"]]},{"verse":20,"text":"それゆえ、主,しゅなる神,かみはこう言,いわれる、見,みよ、わたしはあなたがたが用,もちいて、魂,たましいをかり取,とるところの占,うらないひもを奪,うばい、あなたがたの腕,うでから占,うらないひもを裂,さき取,とって、あなたがたがかり取,とるところの魂,たましいを、鳥,とりのように放,はなちやる。","tok":[["それ"],["ゆえ"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["見よ","みよ"],["、"],["わたし"],["は"],["あなた"],["がた"],["が"],["用いて","もちいて"],["、"],["魂","たましい"],["を"],["かり取る","かりとる"],["ところ"],["の"],["占","うらない"],["ひも"],["を"],["奪い","うばい"],["、"],["あなた"],["がた"],["の"],["腕","うで"],["から"],["占","うらない"],["ひも"],["を"],["裂き取って","さきとって"],["、"],["あなた"],["がた"],["が"],["かり取る","かりとる"],["ところ"],["の"],["魂","たましい"],["を"],["、"],["鳥","とり"],["の"],["よう"],["に"],["放ち","はなち"],["やる"],["。"]]},{"verse":21,"text":"わたしはまたあなたがたの、かぶり物,ものを裂,さき、わが民,たみをあなたがたの手,てから救,すくう。彼,かれらは再,ふたたびあなたがたの獲物,えものとはならない。そしてあなたがたはわたしが主,しゅであることを知,しるようになる。","tok":[["わたし"],["は"],["また"],["あなた"],["がた"],["の"],["、"],["かぶり物","かぶりもの"],["を"],["裂き","さき"],["、"],["わが"],["民","たみ"],["を"],["あなた"],["がた"],["の"],["手","て"],["から"],["救う","すくう"],["。"],["彼","かれ"],["ら"],["は"],["再び","ふたたび"],["あなた"],["がた"],["の"],["獲物","えもの"],["と"],["は"],["ならない"],["。"],["そして"],["あなた"],["がた"],["は"],["わたし"],["が"],["主","しゅ"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"]]},{"verse":22,"text":"あなたがたは偽,いつわりをもって正,ただしい者,ものの心,こころを悩,なやました。わたしはこれを悩,なやまさなかった。またあなたがたは悪人,あくにんが、その命,いのちを救,すくうために、その悪,あしき道,みちから離,はなれようとする時,とき、それをしないように勧,すすめる。","tok":[["あなた"],["がた"],["は"],["偽り","いつわり"],["を"],["もって"],["正い","ただしい"],["者","もの"],["の"],["心","こころ"],["を"],["悩した","なやました"],["。"],["わたし"],["は"],["これ"],["を"],["悩さなかった","なやまさなかった"],["。"],["また"],["あなた"],["がた"],["は"],["悪人","あくにん"],["が"],["、"],["その"],["命","いのち"],["を"],["救う","すくう"],["ため"],["に"],["、"],["その"],["悪しき","あしき"],["道","みち"],["から"],["離れよう","はなれよう"],["と"],["する"],["時","とき"],["、"],["それ"],["を"],["しない"],["よう"],["に"],["勧める","すすめる"],["。"]]},{"verse":23,"text":"それゆえ、あなたがたは重,かさねてむなしい幻,まぼろしを見,みることができず、占,うらないをすることができないようになる。わたしはわが民,たみを、あなたがたの手,てから救,すくい出,だす。そのとき、あなたがたはわたしが主,しゅであることを知,しるようになる」。","tok":[["それ"],["ゆえ"],["、"],["あなた"],["がた"],["は"],["重ねて","かさねて"],["むなしい"],["幻","まぼろし"],["を"],["見る","みる"],["こと"],["が"],["できず"],["、"],["占","うらない"],["を"],["する"],["こと"],["が"],["できない"],["よう"],["に"],["なる"],["。"],["わたし"],["は"],["わが"],["民","たみ"],["を"],["、"],["あなた"],["がた"],["の"],["手","て"],["から"],["救い出す","すくいだす"],["。"],["その"],["とき"],["、"],["あなた"],["がた"],["は"],["わたし"],["が"],["主","しゅ"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["」"],["。"]]}]
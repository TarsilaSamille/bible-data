[{"verse":1,"text":"また主,しゅの言葉,ことばがわたしに臨,のぞんで言,いった、","tok":[["また"],["主","しゅ"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んで","のぞんで"],["言った","いった"],["、"]]},{"verse":2,"text":"「人,ひとの子,こよ、あなたはさばくのか。血,ちを流,ながすこの町,まちをさばくのか。それならこの町,まちにそのもろもろの憎,にくむべき事,ことを示,しめして、","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["あなた"],["は"],["さばく"],["の"],["か"],["。"],["血","ち"],["を"],["流す","ながす"],["この"],["町","まち"],["を"],["さばく"],["の"],["か"],["。"],["それ"],["なら"],["この"],["町","まち"],["に"],["その"],["もろもろ"],["の"],["憎むべき","にくむべき"],["事","こと"],["を"],["示めして","しめして"],["、"]]},{"verse":3,"text":"言,いえ。主,しゅなる神,かみはこう言,いわれる、自分,じぶんのうちに血,ちを流,ながして、その刑罰,けいばつの時,ときをまねき、偶像,ぐうぞうを造,つくってその身,みを汚,けがす町,まちよ、","tok":[["言え","いえ"],["。"],["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["自分","じぶん"],["の"],["うち"],["に"],["血","ち"],["を"],["流して","ながして"],["、"],["その"],["刑罰","けいばつ"],["の"],["時","とき"],["を"],["まねき"],["、"],["偶像","ぐうぞう"],["を"],["造って","つくって"],["その"],["身","み"],["を"],["汚","け"],["がす"],["町","まち"],["よ"],["、"]]},{"verse":4,"text":"あなたはその流,ながした血,ちによって罪,つみを得,え、その造,つくった偶像,ぐうぞうによって汚,けがれ、あなたの日,ひを近,ちかづかせ、あなたの年,ねんの定,さだめの時,ときはきた。それゆえわたしはあなたをもろもろの国民,こくみんのあざけりとなし、万国,ばんこくの物笑,ものわらいとする。","tok":[["あなた"],["は"],["その"],["流した","ながした"],["血","ち"],["によって"],["罪","つみ"],["を"],["得","え"],["、"],["その"],["造った","つくった"],["偶像","ぐうぞう"],["によって"],["汚","け"],["がれ"],["、"],["あなた"],["の"],["日","ひ"],["を"],["近づかせ","ちかづかせ"],["、"],["あなた"],["の"],["年","ねん"],["の"],["定め","さだめ"],["の"],["時","とき"],["は"],["きた"],["。"],["それ"],["ゆえ"],["わたし"],["は"],["あなた"],["を"],["もろもろ"],["の"],["国民","こくみん"],["の"],["あざけり"],["と"],["なし"],["、"],["万国","ばんこく"],["の"],["物","もの"],["笑","わらい"],["と"],["する"],["。"]]},{"verse":5,"text":"あなたに近,ちかい者,ものも、遠,とおい者,ものも、汚,けがれと、混乱,こんらんに満,みちているあなたをあざける。","tok":[["あなた"],["に"],["近い","ちかい"],["者","もの"],["も"],["、"],["遠い","とおい"],["者","もの"],["も"],["、"],["汚","けがれ"],["と"],["、"],["混乱","こんらん"],["に"],["満ちて","みちて"],["いる"],["あなた"],["を"],["あざける"],["。"]]},{"verse":6,"text":"見,みよ、あなたのうちのイスラエルの君,きみたちは、おのおのその力,ちからにしたがって、血,ちを流,ながそうとしている。","tok":[["見よ","みよ"],["、"],["あなた"],["の"],["うち"],["の"],["イスラエル"],["の"],["君","きみ"],["たち"],["は"],["、"],["おのおの"],["その"],["力","ちから"],["に"],["したがって"],["、"],["血","ち"],["を"],["流そう","ながそう"],["として"],["いる"],["。"]]},{"verse":7,"text":"父母,ふぼはあなたのうちで卑,いやしめられ、寄留者,きりゅうしゃはあなたのうちで虐待,ぎゃくたいをうけ、みなしごと、やもめとはあなたのうちで悩,なやまされている。","tok":[["父母","ふぼ"],["は"],["あなた"],["の"],["うち"],["で"],["卑しめられ","いやしめられ"],["、"],["寄留者","きりゅうしゃ"],["は"],["あなた"],["の"],["うち"],["で"],["虐待","ぎゃくたい"],["を"],["うけ"],["、"],["みなしご"],["と"],["、"],["やもめ"],["と"],["は"],["あなた"],["の"],["うち"],["で"],["悩されて","なやまされて"],["いる"],["。"]]},{"verse":8,"text":"あなたはわたしの聖,せいなるものを卑,いやしめ、わたしの安息日,あんそくにちを汚,けがした。","tok":[["あなた"],["は"],["わたし"],["の"],["聖","せい"],["なる"],["もの"],["を"],["卑しめ","いやしめ"],["、"],["わたし"],["の"],["安息日","あんそくにち"],["を"],["汚","け"],["がした"],["。"]]},{"verse":9,"text":"人,ひとをののしって血,ちを流,ながそうとする者,ものは、あなたのうちにおり、人々,ひとびとはあなたのうちで、山,やまの上,うえで食事,しょくじをし、あなたのうちで、みだらなおこないをし、","tok":[["人","ひと"],["を"],["ののしって"],["血","ち"],["を"],["流そう","ながそう"],["と"],["する"],["者","もの"],["は"],["、"],["あなた"],["の"],["うち"],["に"],["おり"],["、"],["人々","ひとびと"],["は"],["あなた"],["の"],["うち"],["で"],["、"],["山","やま"],["の"],["上","うえ"],["で"],["食事","しょくじ"],["を"],["し"],["、"],["あなた"],["の"],["うち"],["で"],["、"],["みだら"],["な"],["おこない"],["を"],["し"],["、"]]},{"verse":10,"text":"あなたのうちで、父,ちちの裸,はだかを現,あらわし、あなたのうちで、汚,けがれのうちにある女,おんなを犯,おかす。","tok":[["あなた"],["の"],["うち"],["で"],["、"],["父","ちち"],["の"],["裸","はだか"],["を"],["現わし","あらわし"],["、"],["あなた"],["の"],["うち"],["で"],["、"],["汚","けがれ"],["の"],["うち"],["に"],["ある"],["女","おんな"],["を"],["犯す","おかす"],["。"]]},{"verse":11,"text":"またあなたのうちに、その隣,となりの妻,つまと憎,にくむべき事,ことを行,おこなう者,ものがあり、淫行,いんこうをもって、その嫁,よめを汚,けがす者,ものがあり、自分,じぶんの父,ちちの娘,むすめである自分,じぶんの姉妹,しまいを犯,おかす者,ものがあり、","tok":[["また"],["あなた"],["の"],["うち"],["に"],["、"],["その"],["隣","となり"],["の"],["妻","つま"],["と"],["憎むべき","にくむべき"],["事","こと"],["を"],["行なう","おこなう"],["者","もの"],["が"],["あり"],["、"],["淫行","いんこう"],["を"],["もって"],["、"],["その"],["嫁","よめ"],["を"],["汚","け"],["がす"],["者","もの"],["が"],["あり"],["、"],["自分","じぶん"],["の"],["父","ちち"],["の"],["娘","むすめ"],["で"],["ある"],["自分","じぶん"],["の"],["姉妹","しまい"],["を"],["犯す","おかす"],["者","もの"],["が"],["あり"],["、"]]},{"verse":12,"text":"また血,ちを流,ながそうとして、あなたのうちで、まいないを取,とる者,ものがある。あなたは利息,りそくと高利,こうりとを取,とり、しえたげによって、あなたの隣,となり人,びとのものをかすめ、そしてわたしを忘,わすれてしまったと、主,しゅなる神,かみは言,いわれる。","tok":[["また"],["血","ち"],["を"],["流そう","ながそう"],["として"],["、"],["あなた"],["の"],["うち"],["で"],["、"],["まいない"],["を"],["取る","とる"],["者","もの"],["が"],["ある"],["。"],["あなた"],["は"],["利息","りそく"],["と"],["高利","こうり"],["と"],["を"],["取","とり"],["、"],["し"],["えたげ"],["によって"],["、"],["あなた"],["の"],["隣人","となりびと"],["の"],["もの"],["を"],["かすめ"],["、"],["そして"],["わたし"],["を"],["忘て","わすれて"],["しまった"],["と"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"]]},{"verse":13,"text":"それゆえ見,みよ、あなたが得,えた不正,ふせいの利,りの事,こと、およびあなたのうちにある流血,りゅうけつの事,ことに対,たいして、わたしは手,てを打,うちならす。","tok":[["それ"],["ゆえ"],["見よ","みよ"],["、"],["あなた"],["が"],["得た","えた"],["不正","ふせい"],["の"],["利","り"],["の"],["事","こと"],["、"],["および"],["あなた"],["の"],["うち"],["に"],["ある"],["流血","りゅうけつ"],["の"],["事","こと"],["に対して","にたいして"],["、"],["わたし"],["は"],["手","て"],["を"],["打ちならす","うちならす"],["。"]]},{"verse":14,"text":"わたしがあなたを攻,せめる日,ひには、あなたの勇気,ゆうきは、これに耐,たえ得,えようか。またあなたの手,ては強,つよくあり得,えようか。主,しゅなるわたしはこれを宣言,せんげんし、これをなす。","tok":[["わたし"],["が"],["あなた"],["を"],["攻める","せめる"],["日","ひ"],["に"],["は"],["、"],["あなた"],["の"],["勇気","ゆうき"],["は"],["、"],["これ"],["に"],["耐え","たえ"],["得よう","えよう"],["か"],["。"],["また"],["あなた"],["の"],["手","て"],["は"],["強く","つよく"],["あり"],["得よう","えよう"],["か"],["。"],["主","しゅ"],["なる"],["わたし"],["は"],["これ"],["を"],["宣言","せんげん"],["し"],["、"],["これ"],["を"],["なす"],["。"]]},{"verse":15,"text":"わたしはあなたを、もろもろの国民,こくみんのうちに散,ちらし、国々,くにぐにの間,あいだにまき、そしてあなたから汚,けがれを除,のぞく。","tok":[["わたし"],["は"],["あなた"],["を"],["、"],["もろもろ"],["の"],["国民","こくみん"],["の"],["うち"],["に"],["散らし","ちらし"],["、"],["国々","くにぐに"],["の"],["間","あいだ"],["に"],["まき"],["、"],["そして"],["あなた"],["から"],["汚","けがれ"],["を"],["除く","のぞく"],["。"]]},{"verse":16,"text":"わたしはあなたによって、もろもろの国民,こくみんの前,まえに汚,けがされる。そしてあなたはわたしが主,しゅであることを知,しる」。","tok":[["わたし"],["は"],["あなた"],["によって"],["、"],["もろもろ"],["の"],["国民","こくみん"],["の"],["前","まえ"],["に"],["汚","け"],["が"],["される"],["。"],["そして"],["あなた"],["は"],["わたし"],["が"],["主","しゅ"],["で"],["ある"],["こと"],["を"],["知る","しる"],["」"],["。"]]},{"verse":17,"text":"主,しゅの言葉,ことばがまたわたしに臨,のぞんだ、","tok":[["主","しゅ"],["の"],["言葉","ことば"],["が"],["また"],["わたし"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":18,"text":"「人,ひとの子,こよ、イスラエルの家,いえはわたしに対,たいして、かなかすとなった。彼,かれらはすべて炉,ろの中,なかの銀,ぎん、青銅,せいどう、すず、鉄,てつ、鉛,なまりのかなかすとなった。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["イスラエル"],["の"],["家","いえ"],["は"],["わたし"],["に対して","にたいして"],["、"],["か"],["なかす"],["と"],["なった"],["。"],["彼","かれ"],["ら"],["は"],["すべて"],["炉","ろ"],["の"],["中","なか"],["の"],["銀","ぎん"],["、"],["青銅","せいどう"],["、"],["すず"],["、"],["鉄","てつ"],["、"],["鉛","なまり"],["の"],["かな"],["かす"],["と"],["なった"],["。"]]},{"verse":19,"text":"それゆえ、主,しゅなる神,かみはこう言,いわれる、あなたがたは皆,みなかなかすとなったゆえ、見,みよ、わたしはあなたがたをエルサレムの中,なかに集,あつめる。","tok":[["それ"],["ゆえ"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["あなた"],["がた"],["は"],["皆","みな"],["か"],["なかす"],["と"],["なった"],["ゆえ"],["、"],["見よ","みよ"],["、"],["わたし"],["は"],["あなた"],["がた"],["を"],["エルサレム"],["の"],["中","なか"],["に"],["集める","あつめる"],["。"]]},{"verse":20,"text":"人,ひとが銀,ぎん、青銅,せいどう、鉄,てつ、鉛,なまり、すずなどを炉,ろの中,なかに集,あつめ、これに火,ひを吹,ふきかけて溶,とかすように、わたしは怒,いかりと憤,いきどおりとをもって、あなたがたを集,あつめ入,いれて溶,とかす。","tok":[["人","ひと"],["が"],["銀","ぎん"],["、"],["青銅","せいどう"],["、"],["鉄","てつ"],["、"],["鉛","なまり"],["、"],["すず"],["など"],["を"],["炉","ろ"],["の"],["中","なか"],["に"],["集め","あつめ"],["、"],["これ"],["に"],["火","ひ"],["を"],["吹","ふき"],["かけて"],["溶かす","とかす"],["よう"],["に"],["、"],["わたし"],["は"],["怒り","いかり"],["と"],["憤り","いきどおり"],["と"],["を"],["もって"],["、"],["あなた"],["がた"],["を"],["集め","あつめ"],["入れて","いれて"],["溶かす","とかす"],["。"]]},{"verse":21,"text":"すなわち、わたしはあなたがたを集,あつめ、わたしの怒,いかりの火,ひを、あなたがたに吹,ふきかける。あなたがたはその中,なかで溶,とける。","tok":[["すなわち"],["、"],["わたし"],["は"],["あなた"],["がた"],["を"],["集め","あつめ"],["、"],["わたし"],["の"],["怒り","いかり"],["の"],["火","ひ"],["を"],["、"],["あなた"],["がた"],["に"],["吹きかける","ふきかける"],["。"],["あなた"],["がた"],["は"],["その"],["中","なか"],["で"],["溶ける","とける"],["。"]]},{"verse":22,"text":"銀,ぎんが炉,ろの中,なかで溶,とけるように、あなたがたもその中,なかで溶,とける。そしてあなたがたは主,しゅなるわたしが、あなたがたの上,うえに、わたしの怒,いかりを注,そそいだことを知,しるようになる」。","tok":[["銀","ぎん"],["が"],["炉","ろ"],["の"],["中","なか"],["で"],["溶ける","とける"],["よう"],["に"],["、"],["あなた"],["がた"],["も"],["その"],["中","なか"],["で"],["溶ける","とける"],["。"],["そして"],["あなた"],["がた"],["は"],["主","しゅ"],["なる"],["わたし"],["が"],["、"],["あなた"],["がた"],["の"],["上","うえ"],["に"],["、"],["わたし"],["の"],["怒り","いかり"],["を"],["注いだ","そそいだ"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["」"],["。"]]},{"verse":23,"text":"主,しゅの言葉,ことばがまたわたしに臨,のぞんだ、","tok":[["主","しゅ"],["の"],["言葉","ことば"],["が"],["また"],["わたし"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":24,"text":"「人,ひとの子,こよ、これに言,いえ、あなたは怒,いかりの日,ひに清,きよめられず、また雨,あめの降,ふらない地,ちである。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["これ"],["に"],["言え","いえ"],["、"],["あなた"],["は"],["怒り","いかり"],["の"],["日","ひ"],["に"],["清められず","きよめられず"],["、"],["また"],["雨","あめ"],["の"],["降らない","ふらない"],["地","ち"],["で"],["ある"],["。"]]},{"verse":25,"text":"その中,なかの君,きみたちは、獲物,えものを裂,さくほえるししのような者,もので、彼,かれらは人々,ひとびとを滅,ほろぼし、宝,たからと尊,たっとい物,ものとを取,とり、そのうちに、やもめの数,かずをふやす。","tok":[["その"],["中","なか"],["の"],["君","きみ"],["たち"],["は"],["、"],["獲物","えもの"],["を"],["裂く","さく"],["ほえる"],["しし"],["の"],["よう"],["な"],["者","もの"],["で"],["、"],["彼","かれ"],["ら"],["は"],["人々","ひとびと"],["を"],["滅ぼし","ほろぼし"],["、"],["宝","たから"],["と"],["尊","た"],["っと"],["い"],["物","もの"],["と"],["を"],["取","とり"],["、"],["その"],["うち"],["に"],["、"],["やもめ"],["の"],["数","かず"],["を"],["ふやす"],["。"]]},{"verse":26,"text":"その祭司,さいしたちはわが律法,りっぽうを犯,おかし、聖,せいなる物,ものを汚,けがした。彼,かれらは聖,せいなる物,ものと汚,けがれた物,ものとを区別,くべつせず、清,きよくない物,ものと清,きよい物,ものとの違,ちがいを教,おしえず、わが安息日,あんそくにちを無視,むしし、こうしてわたしは彼,かれらの間,あいだに汚,けがされている。","tok":[["その"],["祭司","さいし"],["たち"],["は"],["わが"],["律法","りっぽう"],["を"],["犯し","おかし"],["、"],["聖","せい"],["なる"],["物","もの"],["を"],["汚","け"],["がした"],["。"],["彼","かれ"],["ら"],["は"],["聖","せい"],["なる"],["物","もの"],["と"],["汚","け"],["がれ"],["た"],["物","もの"],["と"],["を"],["区別","くべつ"],["せず"],["、"],["清く","きよく"],["ない"],["物","もの"],["と"],["清い","きよい"],["物","もの"],["と"],["の"],["違い","ちがい"],["を"],["教えず","おしえず"],["、"],["わが"],["安息日","あんそくにち"],["を"],["無視","むし"],["し"],["、"],["こう"],["して"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["間","あいだ"],["に"],["汚","け"],["が"],["されて"],["いる"],["。"]]},{"verse":27,"text":"その中,なかにいる君,きみたちは、獲物,えものを裂,さくおおかみのようで、血,ちを流,ながし、不正,ふせいの利,りを得,えるために人々,ひとびとを滅,ほろぼす。","tok":[["その"],["中","なか"],["に"],["いる"],["君","きみ"],["たち"],["は"],["、"],["獲物","えもの"],["を"],["裂く","さく"],["おおかみ"],["の"],["よう"],["で"],["、"],["血","ち"],["を"],["流し","ながし"],["、"],["不正","ふせい"],["の"],["利","り"],["を"],["得る","える"],["ため"],["に"],["人々","ひとびと"],["を"],["滅ぼす","ほろぼす"],["。"]]},{"verse":28,"text":"その預言者,よげんしゃたちは、水,みずしっくいでこれを塗,ぬり、偽,いつわりの幻,まぼろしを見,み、彼,かれらに偽,いつわりを占,うらない、主,しゅが語,かたらないのに『主,しゅなる神,かみはこう言,いわれる』と言,いう。","tok":[["その"],["預言者","よげんしゃ"],["たち"],["は"],["、"],["水","みず"],["しっくい"],["で"],["これ"],["を"],["塗","ぬり"],["、"],["偽わり","いつわり"],["の"],["幻","まぼろし"],["を"],["見","み"],["、"],["彼","かれ"],["ら"],["に"],["偽り","いつわり"],["を"],["占","うらない"],["、"],["主","しゅ"],["が"],["語らない","かたらない"],["のに"],["『"],["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["』"],["と"],["言う","いう"],["。"]]},{"verse":29,"text":"国,くにの民,たみはしえたげを行,おこない、奪,うばうことをなし、乏,とぼしい者,ものと貧,まずしい者,ものとをかすめ、不法,ふほうに他国,たこく人,じんをしえたぐ。","tok":[["国","くに"],["の"],["民","たみ"],["は"],["し"],["えたげ"],["を"],["行ない","おこない"],["、"],["奪う","うばう"],["こと"],["を"],["なし"],["、"],["乏い","とぼしい"],["者","もの"],["と"],["貧しい","まずしい"],["者","もの"],["と"],["を"],["かすめ"],["、"],["不法","ふほう"],["に"],["他国人","たこくじん"],["を"],["し"],["えた"],["ぐ"],["。"]]},{"verse":30,"text":"わたしは、国,くにのために石,いしがきを築,きずき、わたしの前,まえにあって、破,やぶれ口,くちに立,たち、わたしにこれを滅,ほろぼさせないようにする者,ものを、彼,かれらのうちに尋,たずねたが得,えられなかった。","tok":[["わたし"],["は"],["、"],["国","くに"],["の"],["ため"],["に"],["石がき","いしがき"],["を"],["築き","きずき"],["、"],["わたし"],["の"],["前","まえ"],["に"],["あって"],["、"],["破れ","やぶれ"],["口","くち"],["に"],["立ち","たち"],["、"],["わたし"],["に"],["これ"],["を"],["滅ぼさせない","ほろぼさせない"],["よう"],["に"],["する"],["者","もの"],["を"],["、"],["彼","かれ"],["ら"],["の"],["うち"],["に"],["尋ねた","たずねた"],["が"],["得られなかった","えられなかった"],["。"]]},{"verse":31,"text":"それゆえ、わたしはわが怒,いかりを彼,かれらの上,うえに注,そそぎ、わが憤,いきどおりの火,ひをもって彼,かれらを滅,ほろぼし、彼,かれらのおこないを、そのこうべに報,むくいたと、主,しゅなる神,かみは言,いわれる」。","tok":[["それ"],["ゆえ"],["、"],["わたし"],["は"],["わが"],["怒り","いかり"],["を"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["注ぎ","そそぎ"],["、"],["わが"],["憤り","いきどおり"],["の"],["火","ひ"],["を"],["もって"],["彼","かれ"],["ら"],["を"],["滅ぼし","ほろぼし"],["、"],["彼","かれ"],["ら"],["の"],["おこない"],["を"],["、"],["その"],["こうべ"],["に"],["報いた","むくいた"],["と"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["」"],["。"]]}]
[{"verse":1,"text":"主,しゅの言葉,ことばがわたしに臨,のぞんだ、","tok":[["主","しゅ"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":2,"text":"「人,ひとの子,こよ、メセクとトバルの大君,おおぎみであるマゴグの地,ちのゴグに、あなたの顔,かおを向,むけ、これに対,たいして預言,よげんして、","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["メセク"],["と"],["トバル"],["の"],["大君","お"],["おぎみ"],["で"],["ある"],["マゴグ"],["の"],["地","ち"],["の"],["ゴグ"],["に"],["、"],["あなた"],["の"],["顔","かお"],["を"],["向け","むけ"],["、"],["これ"],["に対して","にたいして"],["預言","よげん"],["して"],["、"]]},{"verse":3,"text":"言,いえ。主,しゅなる神,かみはこう言,いわれる、メセクとトバルの大君,おおぎみであるゴグよ、見,みよ、わたしはあなたの敵,てきとなる。","tok":[["言え","いえ"],["。"],["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["メセク"],["と"],["トバル"],["の"],["大君","お"],["おぎみ"],["で"],["ある"],["ゴグ"],["よ"],["、"],["見よ","みよ"],["、"],["わたし"],["は"],["あなた"],["の"],["敵","てき"],["と"],["なる"],["。"]]},{"verse":4,"text":"わたしはあなたを引,ひきもどし、あなたのあごにかぎをかけて、あなたと、あなたのすべての軍勢,ぐんぜいと、馬,うまと、騎兵,きへいとを引,ひき出,だす。彼,かれらはみな武具,ぶぐをつけ、大盾,おおだて、小盾,こだてを持,もち、すべてつるぎをとる者,もので大軍,たいぐんである。","tok":[["わたし"],["は"],["あなた"],["を"],["引","ひき"],["もどし"],["、"],["あなた"],["の"],["あご"],["に"],["かぎ"],["を"],["かけて"],["、"],["あなた"],["と"],["、"],["あなた"],["の"],["すべて"],["の"],["軍勢","ぐんぜい"],["と"],["、"],["馬","うま"],["と"],["、"],["騎兵","きへい"],["と"],["を"],["引出す","ひきだす"],["。"],["彼","かれ"],["ら"],["は"],["みな"],["武具","ぶぐ"],["を"],["つけ"],["、"],["大","だい"],["盾","たて"],["おだて"],["、"],["小","こ"],["盾","たて"],["を"],["持","もち"],["、"],["すべて"],["つるぎ"],["を"],["とる"],["者","もの"],["で"],["大軍","たいぐん"],["で"],["ある"],["。"]]},{"verse":5,"text":"ペルシャ、エチオピヤ、プテは彼,かれらと共,ともにおり、みな盾,たてとかぶとを持,もつ。","tok":[["ペルシャ"],["、"],["エチオピヤ"],["、"],["プテ"],["は"],["彼","かれ"],["ら"],["と"],["共","とも"],["に"],["おり"],["、"],["みな"],["盾","たて"],["と"],["かぶと"],["を"],["持つ","もつ"],["。"]]},{"verse":6,"text":"ゴメルとそのすべての軍隊,ぐんたい、北,きたの果,はてのベテ・トガルマと、そのすべての軍隊,ぐんたいなど、多,おおくの民,たみもあなたと共,ともにおる。","tok":[["ゴメル"],["と"],["その"],["すべて"],["の"],["軍隊","ぐんたい"],["、"],["北","きた"],["の"],["果て","はて"],["の"],["ベテ"],["・"],["トガルマ"],["と"],["、"],["その"],["すべて"],["の"],["軍隊","ぐんたい"],["など"],["、"],["多く","おおく"],["の"],["民","たみ"],["も"],["あなた"],["と"],["共","とも"],["に"],["おる"],["。"]]},{"verse":7,"text":"あなたは備,そなえをなせ。あなたとあなたの所,ところに集,あつまった軍隊,ぐんたいは、みな備,そなえをなせ。そしてあなたは彼,かれらの保護,ほご者,しゃとなれ。","tok":[["あなた"],["は"],["備","そなえ"],["を"],["なせ"],["。"],["あなた"],["と"],["あなた"],["の"],["所","ところ"],["に"],["集まった","あつまった"],["軍隊","ぐんたい"],["は"],["、"],["みな"],["備","そなえ"],["を"],["なせ"],["。"],["そして"],["あなた"],["は"],["彼","かれ"],["ら"],["の"],["保護者","ほごしゃ"],["と"],["なれ"],["。"]]},{"verse":8,"text":"多,おおくの日,ひの後,のち、あなたは集,あつめられ、終,おわりの年,ねんにあなたは戦,たたかいから回復,かいふくされた地,ち、すなわち多,おおくの民,たみの中,なかから、人々,ひとびとが集,あつめられた地,ちに向,むかい、久,ひさしく荒,あれすたれたイスラエルの山々,やまやまに向,むかって進,すすむ。その人々,ひとびとは国々,くにぐにから導,みちびき出,だされて、みな安,やすらかに住,すんでいる。","tok":[["多く","おおく"],["の"],["日","ひ"],["の"],["後","の"],["ち"],["、"],["あなた"],["は"],["集められ","あつめられ"],["、"],["終","おわり"],["の"],["年","ねん"],["に"],["あなた"],["は"],["戦い","たたかい"],["から"],["回復","かいふく"],["された"],["地","ち"],["、"],["すなわち"],["多く","おおく"],["の"],["民","たみ"],["の"],["中","なか"],["から"],["、"],["人々","ひとびと"],["が"],["集められた","あつめられた"],["地","ち"],["に"],["向","むかい"],["、"],["久く","ひさしく"],["荒れ","あれ"],["すたれた"],["イスラエル"],["の"],["山々","やまやま"],["に"],["向かって","むかって"],["進","すすむ"],["。"],["その"],["人々","ひとびと"],["は"],["国々","くにぐに"],["から"],["導き出されて","みちびきだされて"],["、"],["みな"],["安らか","やすらか"],["に"],["住んで","すんで"],["いる"],["。"]]},{"verse":9,"text":"あなたはそのすべての軍隊,ぐんたいおよび多,おおくの民,たみを率,ひきいて上,のぼり、暴風,ぼうふうのように進,すすみ、雲,くものように地,ちをおおう。","tok":[["あなた"],["は"],["その"],["すべて"],["の"],["軍隊","ぐんたい"],["および"],["多く","おおく"],["の"],["民","たみ"],["を"],["率いて","ひきいて"],["上り","のぼり"],["、"],["暴風","ぼうふう"],["の"],["よう"],["に"],["進み","すすみ"],["、"],["雲","くも"],["の"],["よう"],["に"],["地","ち"],["を"],["おおう"],["。"]]},{"verse":10,"text":"主,しゅなる神,かみはこう言,いわれる、その日,ひに、あなたの心,こころに思,おもいが起,おこり、悪,わるい計,はかりごとを企,くわだてて、","tok":[["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["その"],["日","ひ"],["に"],["、"],["あなた"],["の"],["心","こころ"],["に"],["思い","おもい"],["が"],["起こり","おこり"],["、"],["悪い","わるい"],["計り","はかり"],["ごと"],["を"],["企だてて","くわだてて"],["、"]]},{"verse":11,"text":"言,いう、『わたしは無防備,むぼうびの村々,むらむらの地,ちに上,のぼり、穏,おだやかにして安,やすらかに住,すむ民,たみ、すべて石,いしがきもなく、貫,かんの木,きも門,もんもない地,ちに住,すむ者,ものどもを攻,せめよう』と。","tok":[["言う","いう"],["、"],["『"],["わたし"],["は"],["無防備","むぼうび"],["の"],["村々","むらむら"],["の"],["地","ち"],["に"],["上り","のぼり"],["、"],["穏","おだやか"],["に"],["して"],["安らか","やすらか"],["に"],["住む","すむ"],["民","た"],["み"],["、"],["すべて"],["石がき","いしがき"],["も"],["なく"],["、"],["貫の木","かんのき"],["も"],["門","もん"],["も"],["ない"],["地","ち"],["に"],["住む","すむ"],["者","もの"],["ども"],["を"],["攻めよう","せめよう"],["』"],["と"],["。"]]},{"verse":12,"text":"そしてあなたは物,ものを奪,うばい、物,ものをかすめ、いま人,ひとの住,すむようになっている荒,あれ跡,あとを攻,せめ、また国々,くにぐにから集,あつまってきて、地,ちの中央,ちゅうおうに住,すみ、家畜,かちくと貨,か財,ざいとを持,もつ民,たみを攻,せめようとする。","tok":[["そして"],["あなた"],["は"],["物","もの"],["を"],["奪い","うばい"],["、"],["物","もの"],["を"],["かすめ"],["、"],["いま"],["人","ひと"],["の"],["住む","すむ"],["よう"],["に"],["なって"],["いる"],["荒れ","あれ"],["跡","あと"],["を"],["攻め","せめ"],["、"],["また"],["国々","くにぐに"],["から"],["集まって","あつまって"],["きて"],["、"],["地","ち"],["の"],["中央","ちゅうおう"],["に"],["住み","すみ"],["、"],["家畜","かちく"],["と"],["貨財","かざい"],["と"],["を"],["持つ","もつ"],["民","たみ"],["を"],["攻めよう","せめよう"],["と"],["する"],["。"]]},{"verse":13,"text":"シバ、デダン、タルシシの商人,しょうにん、およびそのもろもろの村々,むらむらはあなたに言,いう、『あなたは物,ものを奪,うばうために来,きたのか。物,ものをかすめるために軍隊,ぐんたいを集,あつめたのか。あなたは金銀,きんぎんを持,もち去,さり、家畜,かちくと貨,か財,ざいとを取,とりあげ、大,おおいに物,ものを奪,うばおうとするのか』と。","tok":[["シバ"],["、"],["デダン"],["、"],["タルシシ"],["の"],["商人","しょうにん"],["、"],["および"],["その"],["もろもろ"],["の"],["村々","むらむら"],["は"],["あなた"],["に"],["言う","いう"],["、"],["『"],["あなた"],["は"],["物","もの"],["を"],["奪う","うばう"],["ため"],["に"],["来た","きた"],["の"],["か"],["。"],["物","もの"],["を"],["かすめる"],["ため"],["に"],["軍隊","ぐんたい"],["を"],["集めた","あつめた"],["の"],["か"],["。"],["あなた"],["は"],["金銀","きんぎん"],["を"],["持去り","もちさり"],["、"],["家畜","かちく"],["と"],["貨財","かざい"],["と"],["を"],["取","とり"],["あげ"],["、"],["大いに","おおいに"],["物","もの"],["を"],["奪おう","うばおう"],["と"],["する"],["の"],["か"],["』"],["と"],["。"]]},{"verse":14,"text":"それゆえ、人,ひとの子,こよ、ゴグに預言,よげんして言,いえ。主,しゅなる神,かみはこう言,いわれる、わが民,たみイスラエルの安,やすらかに住,すむその日,ひに、あなたは立,たちあがり、","tok":[["それ"],["ゆえ"],["、"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["ゴグ"],["に"],["預言","よげん"],["して"],["言え","いえ"],["。"],["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["わが"],["民","た"],["みイスラエル"],["の"],["安らか","やすらか"],["に"],["住む","すむ"],["その"],["日","ひ"],["に"],["、"],["あなた"],["は"],["立ちあがり","たちあがり"],["、"]]},{"verse":15,"text":"北,きたの果,はてのあなたの所,ところから来,くる。多,おおくの民,たみはあなたと共,ともにおり、みな馬,うまに乗,のり、その軍隊,ぐんたいは大,おおきく、その兵士,へいしは強,つよい。","tok":[["北","きた"],["の"],["果て","はて"],["の"],["あなた"],["の"],["所","ところ"],["から"],["来る","くる"],["。"],["多く","おおく"],["の"],["民","たみ"],["は"],["あなた"],["と"],["共","とも"],["に"],["おり"],["、"],["みな"],["馬","うま"],["に"],["乗","のり"],["、"],["その"],["軍隊","ぐんたい"],["は"],["大きく","おおきく"],["、"],["その"],["兵士","へいし"],["は"],["強い","つよい"],["。"]]},{"verse":16,"text":"あなたはわが民,たみイスラエルに攻,せめのぼり、雲,くものように地,ちをおおう。ゴグよ、終,おわりの日,ひにわたしはあなたを、わが国,くにに攻,せめきたらせ、あなたをとおして、わたしの聖,せいなることを諸,しょ国民,こくみんの目,めの前,まえにあらわして、彼,かれらにわたしを知,しらせる。","tok":[["あなた"],["は"],["わが"],["民","た"],["みイスラエル"],["に"],["攻めのぼり","せめのぼり"],["、"],["雲","くも"],["の"],["よう"],["に"],["地","ち"],["を"],["おおう"],["。"],["ゴグ"],["よ"],["、"],["終","おわり"],["の"],["日","ひ"],["に"],["わたし"],["は"],["あなた"],["を"],["、"],["わが"],["国","くに"],["に"],["攻め","せめ"],["きたらせ"],["、"],["あなた"],["を"],["とおして"],["、"],["わたし"],["の"],["聖","せい"],["なる"],["こと"],["を"],["諸","しょ"],["国民","こくみん"],["の"],["目","め"],["の"],["前","まえ"],["に"],["あらわして"],["、"],["彼","かれ"],["ら"],["に"],["わたし"],["を"],["知らせる","しらせる"],["。"]]},{"verse":17,"text":"主,しゅなる神,かみはこう言,いわれる、わたしが昔,むかし、わがしもべイスラエルの預言者,よげんしゃたちによって語,かたったのは、あなたのことではないか。すなわち彼,かれらは、そのころ年,とし久,ひさしく預言,よげんして、わたしはあなたを送,おくって、彼,かれらを攻,せめさせると言,いったではないか。","tok":[["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["わたし"],["が"],["昔","むかし"],["、"],["わが"],["しもべ"],["イスラエル"],["の"],["預言者","よげんしゃ"],["たち"],["によって"],["語った","かたった"],["の"],["は"],["、"],["あなた"],["の"],["こと"],["で"],["は"],["ない"],["か"],["。"],["すなわち"],["彼","かれ"],["ら"],["は"],["、"],["その"],["ころ"],["年","とし"],["久く","ひさしく"],["預言","よげん"],["して"],["、"],["わたし"],["は"],["あなた"],["を"],["送って","おくって"],["、"],["彼","かれ"],["ら"],["を"],["攻めさせる","せめさせる"],["と"],["言ったで","いったで"],["は"],["ない"],["か"],["。"]]},{"verse":18,"text":"しかし主,しゅなる神,かみは言,いわれる、その日,ひ、すなわちゴグがイスラエルの地,ちに攻,せめ入,いる日,ひに、わが怒,いかりは現,あらわれる。","tok":[["しかし"],["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["、"],["その"],["日","ひ"],["、"],["すなわち"],["ゴグ"],["が"],["イスラエル"],["の"],["地","ち"],["に"],["攻め入る","せめいる"],["日","ひ"],["に"],["、"],["わが"],["怒り","いかり"],["は"],["現われる","あらわれる"],["。"]]},{"verse":19,"text":"わたしは、わがねたみと、燃,もえたつ怒,いかりとをもって言,いう。その日,ひには必,かならずイスラエルの地,ちに、大,おおいなる震動,しんどうがあり、","tok":[["わたし"],["は"],["、"],["わが"],["ねたみ"],["と"],["、"],["燃えたつ","もえたつ"],["怒り","いかり"],["と"],["を"],["もって"],["言う","いう"],["。"],["その"],["日","ひ"],["に"],["は"],["必","かならず"],["イスラエル"],["の"],["地","ち"],["に"],["、"],["大いなる","おおいなる"],["震動","しんどう"],["が"],["あり"],["、"]]},{"verse":20,"text":"海,うみの魚,うお、空,そらの鳥,とり、野,のの獣,けもの、すべての地,ちに這,はうもの、地,ちのおもてにあるすべての人,ひとは、わが前,まえに打,うち震,ふるえる。また山々,やまやまはくずれ、がけは落,おち、すべての石,いしがきは地,ちに倒,たおれる。","tok":[["海","うみ"],["の"],["魚","う"],["お"],["、"],["空","そら"],["の"],["鳥","とり"],["、"],["野","の"],["の"],["獣","けもの"],["、"],["すべて"],["の"],["地","ち"],["に"],["這う","はう"],["もの"],["、"],["地","ち"],["の"],["おもて"],["に"],["ある"],["すべて"],["の"],["人","ひと"],["は"],["、"],["わが"],["前","まえ"],["に"],["打ち震える","うちふるえる"],["。"],["また"],["山々","やまやま"],["は"],["くずれ"],["、"],["がけ"],["は"],["落","おち"],["、"],["すべて"],["の"],["石がき","いしがき"],["は"],["地","ち"],["に"],["倒れる","たおれる"],["。"]]},{"verse":21,"text":"主,しゅなる神,かみは言,いわれる、わたしはゴグに対,たいし、すべての恐,おそれを呼,よびよせる。すべての人,ひとのつるぎは、その兄弟,きょうだいに向,むけられる。","tok":[["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["、"],["わたし"],["は"],["ゴグ"],["に"],["対し","たいし"],["、"],["すべて"],["の"],["恐","おそれ"],["を"],["呼びよせる","よびよせる"],["。"],["すべて"],["の"],["人","ひと"],["の"],["つるぎ"],["は"],["、"],["その"],["兄弟","きょうだい"],["に"],["向けられる","むけられる"],["。"]]},{"verse":22,"text":"わたしは疫病,えきびょうと流血,りゅうけつとをもって彼,かれをさばく。わたしはみなぎる雨,あめと、ひょうと、火,ひと、硫黄,いおうとを、彼,かれとその軍隊,ぐんたいおよび彼,かれと共,ともにおる多,おおくの民,たみの上,うえに降,ふらせる。","tok":[["わたし"],["は"],["疫病","えきびょう"],["と"],["流血","りゅうけつ"],["と"],["を"],["もって"],["彼","かれ"],["を"],["さばく"],["。"],["わたし"],["は"],["みなぎる"],["雨","あめ"],["と"],["、"],["ひょう"],["と"],["、"],["火","ひ"],["と"],["、"],["硫黄","いおう"],["と"],["を"],["、"],["彼","かれ"],["と"],["その"],["軍隊","ぐんたい"],["および"],["彼","かれ"],["と"],["共","とも"],["に"],["おる"],["多く","おおく"],["の"],["民","たみ"],["の"],["上","うえ"],["に"],["降らせる","ふらせる"],["。"]]},{"verse":23,"text":"そしてわたしはわたしの大,おおいなることと、わたしの聖,せいなることとを、多,おおくの国民,こくみんの目,めに示,しめす。そして彼,かれらはわたしが主,しゅであることを悟,さとる。","tok":[["そして"],["わたし"],["は"],["わたし"],["の"],["大いなる","おおいなる"],["こと"],["と"],["、"],["わたし"],["の"],["聖","せい"],["なる"],["こと"],["と"],["を"],["、"],["多く","おおく"],["の"],["国民","こくみん"],["の"],["目","め"],["に"],["示めす","しめす"],["。"],["そして"],["彼","かれ"],["ら"],["は"],["わたし"],["が"],["主","しゅ"],["で"],["ある"],["こと"],["を"],["悟","さとる"],["。"]]}]
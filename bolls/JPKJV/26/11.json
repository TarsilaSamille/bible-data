[{"verse":1,"text":"時,ときに霊,れいはわたしをあげて、東,ひがしに向,むかう主,しゅの宮,みやの東,ひがしの門,もんに連,つれて行,いった。見,みよ、その門,もんの入口,いりぐちに二十五人,にんの者,ものがいた。わたしはその中,なかにアズルの子,こヤザニヤと、ベナヤの子,こペラテヤを見,みた。共,ともに民,たみのつかさであった。","tok":[["時","とき"],["に"],["霊","れい"],["は"],["わたし"],["を"],["あげて"],["、"],["東","ひがし"],["に"],["向かう","むかう"],["主","しゅ"],["の"],["宮","みや"],["の"],["東","ひがし"],["の"],["門","もん"],["に"],["連れて","つれて"],["行った","いった"],["。"],["見よ","みよ"],["、"],["その"],["門","もん"],["の"],["入口","いりぐち"],["に"],["二十五人","にん"],["の"],["者","もの"],["が"],["いた"],["。"],["わたし"],["は"],["その"],["中","なか"],["に"],["アズル"],["の"],["子","こ"],["ヤザニヤ"],["と"],["、"],["ベナヤ"],["の"],["子","こ"],["ペラテヤ"],["を"],["見た","みた"],["。"],["共","とも"],["に"],["民","たみ"],["の"],["つかさ"],["で"],["あった"],["。"]]},{"verse":2,"text":"すると彼,かれはわたしに言,いわれた、「人,ひとの子,こよ、これらの者,ものはこの町,まちの中,なかで悪,わるい事,ことを考,かんがえ、悪,わるい計,はかりごとをめぐらす人々,ひとびとである。","tok":[["する"],["と"],["彼","かれ"],["は"],["わたし"],["に"],["言われた","いわれた"],["、"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["これ"],["ら"],["の"],["者","もの"],["は"],["この"],["町","まち"],["の"],["中","なか"],["で"],["悪い","わるい"],["事","こと"],["を"],["考","かんがえ"],["、"],["悪い","わるい"],["計り","はかり"],["ごと"],["を"],["めぐらす"],["人々","ひとびと"],["で"],["ある"],["。"]]},{"verse":3,"text":"彼,かれらは言,いう、『家,いえを建,たてる時,ときは近,ちかくはない。この町,まちはなべであり、われわれは肉,にくである』と。","tok":[["彼","かれ"],["ら"],["は"],["言う","いう"],["、"],["『"],["家","いえ"],["を"],["建てる","たてる"],["時","とき"],["は"],["近く","ちかく"],["は"],["ない"],["。"],["この"],["町","まち"],["は"],["なべ"],["で"],["あり"],["、"],["われわれ"],["は"],["肉","にく"],["で"],["ある"],["』"],["と"],["。"]]},{"verse":4,"text":"それゆえ、彼,かれらに向,むかって預言,よげんせよ。人,ひとの子,こよ、預言,よげんせよ」。","tok":[["それ"],["ゆえ"],["、"],["彼","かれ"],["ら"],["に"],["向かって","むかって"],["預言","よげん"],["せよ"],["。"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["預言","よげん"],["せよ"],["」"],["。"]]},{"verse":5,"text":"時,ときに、主,しゅの霊,れいがわたしに下,くだって、わたしに言,いわれた、「主,しゅはこう言,いわれると言,いえ、イスラエルの家,いえよ、考,かんがえてみよ。わたしはあなたがたの心,こころにある事,ことどもを知,しっている。","tok":[["時","とき"],["に"],["、"],["主","しゅ"],["の"],["霊","れい"],["が"],["わたし"],["に"],["下って","くだって"],["、"],["わたし"],["に"],["言われた","いわれた"],["、"],["「"],["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["と"],["言え","いえ"],["、"],["イスラエル"],["の"],["家","いえ"],["よ"],["、"],["考","かんがえ"],["て"],["み"],["よ"],["。"],["わたし"],["は"],["あなた"],["がた"],["の"],["心","こころ"],["に"],["ある"],["事","こと"],["ども"],["を"],["知って","しって"],["いる"],["。"]]},{"verse":6,"text":"あなたがたはこの町,まちに殺,ころされる者,ものを増,まし、殺,ころされた者,ものをもってちまたを満,みたした。","tok":[["あなた"],["がた"],["は"],["この"],["町","まち"],["に"],["殺ろされる","ころされる"],["者","もの"],["を"],["増し","まし"],["、"],["殺ろされた","ころされた"],["者","もの"],["を"],["もって"],["ちまた"],["を"],["満たした","みたした"],["。"]]},{"verse":7,"text":"それゆえ、主,しゅなる神,かみはこう言,いわれる、町,まちの中,なかにあなたがたが置,おく殺,ころされた者,ものは肉,にくである。この町,まちはなべである。しかし、あなたがたはその中,なかから取,とり出,だされる。","tok":[["それ"],["ゆえ"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["町","まち"],["の"],["中","なか"],["に"],["あなた"],["がた"],["が"],["置く","おく"],["殺された","ころされた"],["者","もの"],["は"],["肉","にく"],["で"],["ある"],["。"],["この"],["町","まち"],["は"],["なべ"],["で"],["ある"],["。"],["しかし"],["、"],["あなた"],["がた"],["は"],["その"],["中","なか"],["から"],["取出される","とりだされる"],["。"]]},{"verse":8,"text":"あなたがたはつるぎを恐,おそれた。わたしはあなたがたにつるぎを臨,のぞませると、主,しゅは言,いわれる。","tok":[["あなた"],["がた"],["は"],["つるぎ"],["を"],["恐れた","おそれた"],["。"],["わたし"],["は"],["あなた"],["がた"],["に"],["つるぎ"],["を"],["臨ませる","のぞませる"],["と"],["、"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":9,"text":"またわたしはあなたがたをその中,なかから引,ひき出,だして、他国,たこく人,じんの手,てに渡,わたし、あなたがたをさばく。","tok":[["また"],["わたし"],["は"],["あなた"],["がた"],["を"],["その"],["中","なか"],["から"],["引出して","ひきだして"],["、"],["他国人","たこくじん"],["の"],["手","て"],["に"],["渡","わたし"],["、"],["あなた"],["がた"],["を"],["さばく"],["。"]]},{"verse":10,"text":"あなたがたはつるぎに倒,たおれる。わたしはあなたがたをイスラエルの境,さかいでさばく。これによってあなたがたはわたしが主,しゅであることを知,しるようになる。","tok":[["あなた"],["がた"],["は"],["つるぎ"],["に"],["倒れる","たおれる"],["。"],["わたし"],["は"],["あなた"],["がた"],["を"],["イスラエル"],["の"],["境","さかい"],["で"],["さばく"],["。"],["これ"],["によって"],["あなた"],["がた"],["は"],["わたし"],["が"],["主","しゅ"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"]]},{"verse":11,"text":"この町,まちはあなたがたに対,たいしてなべとはならず、あなたがたはその肉,にくとはならない。わたしはイスラエルの境,さかいであなたがたをさばく。","tok":[["この"],["町","まち"],["は"],["あなた"],["がた"],["に対して","にたいして"],["なべ"],["と"],["は"],["ならず"],["、"],["あなた"],["がた"],["は"],["その"],["肉","にく"],["と"],["は"],["ならない"],["。"],["わたし"],["は"],["イスラエル"],["の"],["境","さかい"],["で"],["あなた"],["がた"],["を"],["さばく"],["。"]]},{"verse":12,"text":"これによって、あなたがたはわたしが主,しゅであることを知,しるようになる。あなたがたはわたしの定,さだめに歩,あゆまず、またわたしのおきてを行,おこなわず、かえってその周囲,しゅういの他国,たこく人,じんのおきてに従,したがって行,おこなっているからである」。","tok":[["これ"],["によって"],["、"],["あなた"],["がた"],["は"],["わたし"],["が"],["主","しゅ"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"],["あなた"],["がた"],["は"],["わたし"],["の"],["定め","さだめ"],["に"],["歩まず","あゆまず"],["、"],["また"],["わたし"],["の"],["おきて"],["を"],["行なわず","おこなわず"],["、"],["かえって"],["その"],["周囲","しゅうい"],["の"],["他国人","たこくじん"],["の"],["おきて"],["に"],["従って","したがって"],["行なって","おこなって"],["いる"],["から"],["で"],["ある"],["」"],["。"]]},{"verse":13,"text":"このようにわたしが預言,よげんしていた時,とき、ベナヤの子,こペラテヤが死,しんだので、わたしは打,うち伏,ふして、大声,おおごえで叫,さけんで言,いった、「ああ主,しゅなる神,かみよ、あなたはイスラエルの残,のこりの者,ものをことごとく滅,ほろぼそうとされるのですか」。","tok":[["この"],["よう"],["に"],["わたし"],["が"],["預言","よげん"],["して"],["いた"],["時","とき"],["、"],["ベナヤ"],["の"],["子","こ"],["ペラテヤ"],["が"],["死んだ","しんだ"],["ので"],["、"],["わたし"],["は"],["打ち伏して","うちふして"],["、"],["大声","おおごえ"],["で"],["叫けんで","さけんで"],["言った","いった"],["、"],["「"],["ああ"],["主","しゅ"],["なる"],["神","かみ"],["よ"],["、"],["あなた"],["は"],["イスラエル"],["の"],["残り","のこり"],["の"],["者","もの"],["を"],["ことごとく"],["滅ぼそう","ほろぼそう"],["と"],["される"],["の"],["です"],["か"],["」"],["。"]]},{"verse":14,"text":"時,ときに主,しゅの言葉,ことばがわたしに臨,のぞんで言,いった、","tok":[["時","とき"],["に"],["主","しゅ"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んで","のぞんで"],["言った","いった"],["、"]]},{"verse":15,"text":"「人,ひとの子,こよ、あなたの兄弟,きょうだい、あなたの友,とも、あなたの兄弟,きょうだいである捕,とらわれ人,びと、イスラエルの全家,ぜんか、エルサレムの住民,じゅうみんは言,いった、『彼,かれらが主,しゅから遠,とおく離,はなれた。この地,ちはわれわれの所有,しょゆうとして与,あたえられているのだ』と。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["あなた"],["の"],["兄弟","きょうだい"],["、"],["あなた"],["の"],["友","とも"],["、"],["あなた"],["の"],["兄弟","きょうだい"],["で"],["ある"],["捕らわれ","とらわれ"],["人","び"],["と"],["、"],["イスラエル"],["の"],["全家","ぜんか"],["、"],["エルサレム"],["の"],["住民","じゅうみん"],["は"],["言った","いった"],["、"],["『"],["彼","かれ"],["ら"],["が"],["主ら","しゅから"],["遠く","とおく"],["離れた","はなれた"],["。"],["この"],["地","ち"],["は"],["われわれ"],["の"],["所有","しょゆう"],["として"],["与えられて","あたえられて"],["いる"],["の"],["だ"],["』"],["と"],["。"]]},{"verse":16,"text":"それゆえ、言,いえ、『主,しゅなる神,かみはこう言,いわれる、たといわたしは彼,かれらを遠,とおく他国,たこく人,じんの中,なかに移,うつし、国々,くにぐにの中,なかに散,ちらしても、彼,かれらの行,いった国々,くにぐにで、わたしはしばらく彼,かれらのために聖所,せいじょとなる』と。","tok":[["それ"],["ゆえ"],["、"],["言え","いえ"],["、"],["『"],["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["たとい"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["遠く","とおく"],["他国人","たこくじん"],["の"],["中","なか"],["に"],["移し","うつし"],["、"],["国々","くにぐに"],["の"],["中","なか"],["に"],["散らして","ちらして"],["も"],["、"],["彼","かれ"],["ら"],["の"],["行った","いった"],["国々","くにぐに"],["で"],["、"],["わたし"],["は"],["しばらく"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["聖","せい"],["所","しょ"],["と"],["なる"],["』"],["と"],["。"]]},{"verse":17,"text":"それゆえ、言,いえ、『主,しゅはこう言,いわれる、わたしはあなたがたをもろもろの民,たみの中,なかから集,あつめ、その散,ちらされた国々,くにぐにから集,あつめて、イスラエルの地,ちをあなたがたに与,あたえる』と。","tok":[["それ"],["ゆえ"],["、"],["言え","いえ"],["、"],["『"],["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["わたし"],["は"],["あなた"],["がた"],["を"],["もろもろ"],["の"],["民","たみ"],["の"],["中","なか"],["から"],["集め","あつめ"],["、"],["その"],["散らされた","ちらされた"],["国々","くにぐに"],["から"],["集めて","あつめて"],["、"],["イスラエル"],["の"],["地","ち"],["を"],["あなた"],["がた"],["に"],["与える","あたえる"],["』"],["と"],["。"]]},{"verse":18,"text":"彼,かれらはその所,ところに来,くる時,とき、そのもろもろのいとうべきものと、もろもろの憎,にくむべきものとをその所,ところから取,とり除,のぞく。","tok":[["彼","かれ"],["ら"],["は"],["その"],["所","ところ"],["に"],["来る","くる"],["時","とき"],["、"],["その"],["もろもろ"],["の"],["いとうべき"],["もの"],["と"],["、"],["もろもろ"],["の"],["憎むべき","にくむべき"],["もの"],["と"],["を"],["その"],["所","ところ"],["から"],["取除く","とりのぞく"],["。"]]},{"verse":19,"text":"そしてわたしは彼,かれらに一つの心,こころを与,あたえ、彼,かれらのうちに新,あたらしい霊,れいを授,さづけ、彼,かれらの肉,にくから石,いしの心,こころを取,とり去,さって、肉,にくの心,こころを与,あたえる。","tok":[["そして"],["わたし"],["は"],["彼","かれ"],["ら"],["に"],["一","ひと"],["つ"],["の"],["心","こころ"],["を"],["与","あたえ"],["、"],["彼","かれ"],["ら"],["の"],["うち"],["に"],["新らしい","あたらしい"],["霊","れい"],["を"],["授","さ"],["づけ"],["、"],["彼","かれ"],["ら"],["の"],["肉","にく"],["から"],["石","いし"],["の"],["心","こころ"],["を"],["取","とり"],["去て","さって"],["、"],["肉","にく"],["の"],["心","こころ"],["を"],["与える","あたえる"],["。"]]},{"verse":20,"text":"これは彼,かれらがわたしの定,さだめに歩,あゆみ、わたしのおきてを守,まもって行,おこない、そして彼,かれらがわたしの民,たみとなり、わたしが彼,かれらの神,かみとなるためである。","tok":[["これ"],["は"],["彼","かれ"],["ら"],["が"],["わたし"],["の"],["定め","さだめ"],["に"],["歩み","あゆみ"],["、"],["わたし"],["の"],["おきて"],["を"],["守って","まもって"],["行ない","おこない"],["、"],["そして"],["彼","かれ"],["ら"],["が"],["わたし"],["の"],["民","たみ"],["と"],["なり"],["、"],["わたし"],["が"],["彼","かれ"],["ら"],["の"],["神","かみ"],["と"],["なる"],["ため"],["で"],["ある"],["。"]]},{"verse":21,"text":"しかしいとうべきもの、憎,にくむべきものをその心,こころに慕,したって歩,あゆむ者,ものには、彼,かれらの行,おこないに従,したがってそのこうべに報,むくいると、主,しゅなる神,かみは言,いわれる」。","tok":[["しかし"],["いとうべき"],["もの"],["、"],["憎むべき","にくむべき"],["もの"],["を"],["その"],["心","こころ"],["に"],["慕って","したって"],["歩む","あゆむ"],["者","もの"],["に"],["は"],["、"],["彼","かれ"],["ら"],["の"],["行ない","おこない"],["に"],["従って","したがって"],["その"],["こうべ"],["に"],["報いる","むくいる"],["と"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["」"],["。"]]},{"verse":22,"text":"時,ときにケルビムはその翼,つばさをあげた。輪,わがそのかたわらにあり、イスラエルの神,かみの栄光,えいこうがその上,うえにあった。","tok":[["時","とき"],["に"],["ケルビム"],["は"],["その"],["翼","つばさ"],["を"],["あげた"],["。"],["輪","わ"],["が"],["その"],["かたわら"],["に"],["あり"],["、"],["イスラエル"],["の"],["神","かみ"],["の"],["栄光","えいこう"],["が"],["その"],["上","うえ"],["に"],["あった"],["。"]]},{"verse":23,"text":"主,しゅの栄光,えいこうが町,まちの中,なかからのぼって、町,まちの東,ひがしにある山,やまの上,うえに立,たちどまった。","tok":[["主","しゅ"],["の"],["栄光","えいこう"],["が"],["町","まち"],["の"],["中","なか"],["から"],["のぼって"],["、"],["町","まち"],["の"],["東","ひがし"],["に"],["ある"],["山","やま"],["の"],["上","うえ"],["に"],["立","たち"],["ど"],["まった"],["。"]]},{"verse":24,"text":"その時,とき、霊,れいはわたしをあげ、神,かみの霊,れいによって、幻,まぼろしのうちにわたしをカルデヤの捕,とらわれ人,びとの所,ところへ携,たずさえて行,いった。そしてわたしが見,みた幻,まぼろしはわたしを離,はなれてのぼった。","tok":[["その"],["時","とき"],["、"],["霊","れい"],["は"],["わたし"],["を"],["あげ"],["、"],["神","かみ"],["の"],["霊","れい"],["によって"],["、"],["幻","まぼろし"],["の"],["うち"],["に"],["わたし"],["を"],["カルデヤ"],["の"],["捕らわれ","とらわれ"],["人","びと"],["の"],["所","ところ"],["へ"],["携えて","たずさえて"],["行った","いった"],["。"],["そして"],["わたし"],["が"],["見た","みた"],["幻","まぼろし"],["は"],["わたし"],["を"],["離れて","はなれて"],["のぼった"],["。"]]},{"verse":25,"text":"そこでわたしは主,しゅがわたしに示,しめされた事,ことをことごとくかの捕,とらわれ人,びとに告,つげた。","tok":[["そこ"],["で"],["わたし"],["は"],["主","しゅ"],["が"],["わたし"],["に"],["示めされた","しめされた"],["事","こと"],["を"],["ことごとく"],["か"],["の"],["捕らわれ","とらわれ"],["人","びと"],["に"],["告","つげ"],["た"],["。"]]}]
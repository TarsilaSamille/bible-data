[{"verse":1,"text":"人,ひとの子,こよ、イスラエルの山々,やまやまに預言,よげんして言,いえ。イスラエルの山々,やまやまよ、主,しゅの言葉,ことばを聞,きけ。","tok":[["人","ひと"],["の"],["子","こ"],["よ"],["、"],["イスラエル"],["の"],["山々","やまやま"],["に"],["預言","よげん"],["して"],["言え","いえ"],["。"],["イスラエル"],["の"],["山々","やまやま"],["よ"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["を"],["聞け","きけ"],["。"]]},{"verse":2,"text":"主,しゅなる神,かみはこう言,いわれる、敵,てきはあなたがたについて言,いう、『ああ、昔,むかしの高,たかき所,ところが、われわれのものとなった』と。","tok":[["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["敵","てき"],["は"],["あなた"],["がた"],["について"],["言う","いう"],["、"],["『"],["ああ"],["、"],["昔","むかし"],["の"],["高き","たかき"],["所","ところ"],["が"],["、"],["われわれ"],["の"],["もの"],["と"],["なった"],["』"],["と"],["。"]]},{"verse":3,"text":"それゆえ、あなたは預言,よげんして言,いえ。主,しゅなる神,かみはこう言,いわれる、彼,かれらはあなたがたを荒,あらし、四方,しほうからあなたがたを打,うち滅,ほろぼしたので、あなたがたは他,たの国民,こくみんの所有,しょゆうとなり、また民,たみの悪,わるいうわさとなった。","tok":[["それ"],["ゆえ"],["、"],["あなた"],["は"],["預言","よげん"],["して"],["言え","いえ"],["。"],["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["彼","かれ"],["ら"],["は"],["あなた"],["がた"],["を"],["荒し","あらし"],["、"],["四方","しほう"],["から"],["あなた"],["がた"],["を"],["打ち滅ぼした","うちほろぼした"],["ので"],["、"],["あなた"],["がた"],["は"],["他","た"],["の"],["国民","こくみん"],["の"],["所有","しょゆう"],["と"],["なり"],["、"],["また"],["民","たみ"],["の"],["悪い","わるい"],["うわさ"],["と"],["なった"],["。"]]},{"verse":4,"text":"それゆえ、イスラエルの山々,やまやまよ、主,しゅなる神,かみの言葉,ことばを聞,きけ。主,しゅなる神,かみは、山,やまと、丘,おかと、くぼ地,ちと、谷,たにと、滅,ほろびた荒,あれ跡,あとと、人,ひとの捨,すてた町々,まちまち、すなわちその周囲,しゅういにある諸,しょ国民,こくみんの残,のこった者,ものにかすめられ、あざけられるようになったものに、こう言,いわれる。","tok":[["それ"],["ゆえ"],["、"],["イスラエル"],["の"],["山々","やまやま"],["よ"],["、"],["主","しゅ"],["なる"],["神","かみ"],["の"],["言葉","ことば"],["を"],["聞け","きけ"],["。"],["主","しゅ"],["なる"],["神","かみ"],["は"],["、"],["山","やま"],["と"],["、"],["丘","おか"],["と"],["、"],["くぼ地","くぼち"],["と"],["、"],["谷","たに"],["と"],["、"],["滅びた","ほろびた"],["荒れ","あれ"],["跡","あと"],["と"],["、"],["人","ひと"],["の"],["捨てた","すてた"],["町々","まちまち"],["、"],["すなわち"],["その"],["周囲","しゅうい"],["に"],["ある"],["諸","しょ"],["国民","こくみん"],["の"],["残った","のこった"],["者","もの"],["に"],["かすめられ"],["、"],["あざけられる"],["よう"],["に"],["なった"],["もの"],["に"],["、"],["こう"],["言われる","いわれる"],["。"]]},{"verse":5,"text":"主,しゅなる神,かみはこう言,いわれる、わたしはねたみの炎,ほのおをもって、他,たの国民,こくみんとエドム全国,ぜんこくとに対,たいして言,いう、彼,かれらは心,こころゆくまで喜,よろこび、心,こころに誇,ほこってわが地,ちを自分,じぶんの所有,しょゆうとし、これを奪,うばい、かすめた者,ものである。","tok":[["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["わたし"],["は"],["ねたみ"],["の"],["炎","ほのお"],["を"],["もって"],["、"],["他","た"],["の"],["国民","こくみん"],["と"],["エドム"],["全国","ぜんこく"],["と"],["に対して","にたいして"],["言う","いう"],["、"],["彼","かれ"],["ら"],["は"],["心ゆく","こころゆく"],["まで"],["喜こび","よろこび"],["、"],["心","こころ"],["に"],["誇って","ほこって"],["わが"],["地","ち"],["を"],["自分","じぶん"],["の"],["所有","しょゆう"],["と"],["し"],["、"],["これ"],["を"],["奪い","うばい"],["、"],["かすめた"],["者","もの"],["で"],["ある"],["。"]]},{"verse":6,"text":"それゆえ、あなたはイスラエルの地,ちの事,ことを預言,よげんし、山,やまと、丘,おかと、くぼ地,ちと、谷,たにとに言,いえ。主,しゅなる神,かみはこう言,いわれる、見,みよ、あなたがたは諸,しょ国民,こくみんのはずかしめを受,うけたので、わたしはねたみと怒,いかりとをもって語,かたる。","tok":[["それ"],["ゆえ"],["、"],["あなた"],["は"],["イスラエル"],["の"],["地","ち"],["の"],["事","こと"],["を"],["預言","よげん"],["し"],["、"],["山","やま"],["と"],["、"],["丘","おか"],["と"],["、"],["くぼ地","くぼち"],["と"],["、"],["谷","たに"],["と"],["に"],["言え","いえ"],["。"],["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["見よ","みよ"],["、"],["あなた"],["がた"],["は"],["諸","しょ"],["国民","こくみん"],["の"],["はずかし"],["め"],["を"],["受た","うけた"],["ので"],["、"],["わたし"],["は"],["ねたみ"],["と"],["怒り","いかり"],["と"],["を"],["もって"],["語る","かたる"],["。"]]},{"verse":7,"text":"それゆえ、主,しゅなる神,かみはこう言,いわれる、わたしは誓,ちかって言,いう、あなたがたの周囲,しゅういの諸,しょ国民,こくみんは必,かならずはずかしめを受,うける。","tok":[["それ"],["ゆえ"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["わたし"],["は"],["誓って","ちかって"],["言う","いう"],["、"],["あなた"],["がた"],["の"],["周囲","しゅうい"],["の"],["諸国民","しょこくみん"],["は"],["必","かならず"],["はずかしめ"],["を"],["受る","うける"],["。"]]},{"verse":8,"text":"しかしイスラエルの山々,やまやまよ、あなたがたは枝,えだを出,だし、わが民,たみイスラエルのために実,みを結,むすぶ。この事,ことの成,なるのは近,ちかい。","tok":[["しかし"],["イスラエル"],["の"],["山々","やまやま"],["よ"],["、"],["あなた"],["がた"],["は"],["枝","えだ"],["を"],["出し","だし"],["、"],["わが"],["民","た"],["みイスラエル"],["の"],["ため"],["に"],["実","み"],["を"],["結ぶ","むすぶ"],["。"],["この"],["事","こと"],["の"],["成る","なる"],["の"],["は"],["近い","ちかい"],["。"]]},{"verse":9,"text":"見,みよ、わたしはあなたがたに臨,のぞみ、あなたがたを顧,かえりみる。あなたがたは耕,たがやされ、種,たねをまかれる。","tok":[["見よ","みよ"],["、"],["わたし"],["は"],["あなた"],["がた"],["に"],["臨み","のぞみ"],["、"],["あなた"],["がた"],["を"],["顧る","かえりみる"],["。"],["あなた"],["がた"],["は"],["耕やされ","たがやされ"],["、"],["種","たね"],["を"],["まかれる"],["。"]]},{"verse":10,"text":"わたしはあなたがたの上,うえに人,ひとをふやす。これはことごとくイスラエルの家,いえの者,ものとなり、町々,まちまちには人,ひとが住,すみ、荒,あれ跡,あとは建,たて直,なおされる。","tok":[["わたし"],["は"],["あなた"],["がた"],["の"],["上","うえ"],["に"],["人","ひと"],["を"],["ふやす"],["。"],["これ"],["は"],["ことごとく"],["イスラエル"],["の"],["家","いえ"],["の"],["者","もの"],["と"],["なり"],["、"],["町々","まちまち"],["に"],["は"],["人","ひと"],["が"],["住み","すみ"],["、"],["荒れ","あれ"],["跡","あと"],["は"],["建て直される","たてなおされる"],["。"]]},{"verse":11,"text":"わたしはあなたがたの上,うえに人,ひとと獣,けものとをふやす。彼,かれらはふえて、子,こを生,うむ。わたしはあなたがたの上,うえに、昔,むかしのように人,ひとを住,すませ、初,はじめの時,ときよりも、まさる恵,めぐみをあなたがたに施,ほどこす。その時,ときあなたがたは、わたしが主,しゅであることを悟,さとる。","tok":[["わたし"],["は"],["あなた"],["がた"],["の"],["上","うえ"],["に"],["人","ひと"],["と"],["獣","けもの"],["と"],["を"],["ふやす"],["。"],["彼","かれ"],["ら"],["は"],["ふえて"],["、"],["子","こ"],["を"],["生む","うむ"],["。"],["わたし"],["は"],["あなた"],["がた"],["の"],["上","うえ"],["に"],["、"],["昔","むかし"],["の"],["よう"],["に"],["人","ひと"],["を"],["住ませ","すませ"],["、"],["初め","はじめ"],["の"],["時","とき"],["より"],["も"],["、"],["まさる"],["恵","めぐみ"],["を"],["あなた"],["がた"],["に"],["施す","ほどこす"],["。"],["その"],["時","とき"],["あなた"],["がた"],["は"],["、"],["わたし"],["が"],["主","しゅ"],["で"],["ある"],["こと"],["を"],["悟","さとる"],["。"]]},{"verse":12,"text":"わたしはわが民,たみイスラエルの人々,ひとびとをあなたがたの上,うえに歩,あゆませる。彼,かれらはあなたがたを所有,しょゆうし、あなたがたはその嗣,し業,ぎょうとなり、あなたがたは重,かさねて彼,かれらに子,このない嘆,なげきをさせない。","tok":[["わたし"],["は"],["わが"],["民","た"],["みイスラエル"],["の"],["人々","ひとびと"],["を"],["あなた"],["がた"],["の"],["上","うえ"],["に"],["歩ませる","あゆませる"],["。"],["彼","かれ"],["ら"],["は"],["あなた"],["がた"],["を"],["所有","しょゆう"],["し"],["、"],["あなた"],["がた"],["は"],["その"],["嗣業","しぎょ"],["う"],["と"],["なり"],["、"],["あなた"],["がた"],["は"],["重ねて","かさねて"],["彼","かれ"],["ら"],["に"],["子","こ"],["の"],["ない"],["嘆き","なげき"],["を"],["させない"],["。"]]},{"verse":13,"text":"主,しゅなる神,かみはこう言,いわれる、彼,かれらはあなたがたに向,むかって、『あなたは人,ひとを食,くい、あなたの民,たみに子,このない嘆,なげきをさせる』と言,いう。","tok":[["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["彼","かれ"],["ら"],["は"],["あなた"],["がた"],["に"],["向かって","むかって"],["、"],["『"],["あなた"],["は"],["人","ひと"],["を"],["食い","くい"],["、"],["あなた"],["の"],["民","たみ"],["に"],["子","こ"],["の"],["ない"],["嘆き","なげき"],["を"],["させる"],["』"],["と"],["言う","いう"],["。"]]},{"verse":14,"text":"あなたはもはや人,ひとを食,くわない。あなたの民,たみに重,かさねて子,このない嘆,なげきをさせることはないと、主,しゅなる神,かみは言,いわれる。","tok":[["あなた"],["は"],["もはや"],["人","ひと"],["を"],["食わない","くわない"],["。"],["あなた"],["の"],["民","たみ"],["に"],["重ねて","かさねて"],["子","こ"],["の"],["ない"],["嘆き","なげき"],["を"],["させる"],["こと"],["は"],["ない"],["と"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"]]},{"verse":15,"text":"わたしは重,かさねて諸,しょ国民,こくみんのはずかしめをあなたに聞,きかせない。あなたは重,かさねて、もろもろの民,たみのはずかしめを受,うけることはなく、あなたの民,たみを重,かさねてつまずかせることはないと、主,しゅなる神,かみは言,いわれる」。","tok":[["わたし"],["は"],["重ねて","かさねて"],["諸","しょ"],["国民","こくみん"],["の"],["はずかし"],["め"],["を"],["あなた"],["に"],["聞かせない","きかせない"],["。"],["あなた"],["は"],["重ねて","かさねて"],["、"],["もろもろ"],["の"],["民","たみ"],["の"],["はずかし"],["め"],["を"],["受る","うける"],["こと"],["は"],["なく"],["、"],["あなた"],["の"],["民","たみ"],["を"],["重ねて","かさねて"],["つまずかせる"],["こと"],["は"],["ない"],["と"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["」"],["。"]]},{"verse":16,"text":"主,しゅの言葉,ことばがわたしに臨,のぞんだ、","tok":[["主","しゅ"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":17,"text":"「人,ひとの子,こよ、昔,むかし、イスラエルの家,いえが、自分,じぶんの国,くにに住,すんだとき、彼,かれらはおのれのおこないとわざとをもって、これを汚,けがした。そのおこないは、わたしの前,まえには、汚,けがれにある女,おんなの汚,けがれのようであった。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["昔","むかし"],["、"],["イスラエル"],["の"],["家","いえ"],["が"],["、"],["自分","じぶん"],["の"],["国","くに"],["に"],["住んだ","すんだ"],["とき"],["、"],["彼","かれ"],["ら"],["は"],["おのれ"],["の"],["おこない"],["と"],["わざと"],["を"],["もって"],["、"],["これ"],["を"],["汚","け"],["がした"],["。"],["その"],["おこない"],["は"],["、"],["わたし"],["の"],["前","まえ"],["に"],["は"],["、"],["汚","けがれ"],["に"],["ある"],["女","おんな"],["の"],["汚","けがれ"],["の"],["よう"],["で"],["あった"],["。"]]},{"verse":18,"text":"彼,かれらが国,くにに血,ちを流,ながし、またその偶像,ぐうぞうをもって、国,くにを汚,けがしたため、わたしはわが怒,いかりを彼,かれらの上,うえに注,そそぎ、","tok":[["彼","かれ"],["ら"],["が"],["国","くに"],["に"],["血","ち"],["を"],["流し","ながし"],["、"],["また"],["その"],["偶像","ぐうぞう"],["を"],["もって"],["、"],["国","くに"],["を"],["汚","け"],["がした"],["ため"],["、"],["わたし"],["は"],["わが"],["怒り","いかり"],["を"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["注ぎ","そそぎ"],["、"]]},{"verse":19,"text":"彼,かれらを諸,しょ国民,こくみんの中,なかに散,ちらしたので、彼,かれらは国々,くにぐにの中,なかに散,ちった。わたしは彼,かれらのおこないと、わざとにしたがって、彼,かれらをさばいた。","tok":[["彼","かれ"],["ら"],["を"],["諸","しょ"],["国民","こくみん"],["の"],["中","なか"],["に"],["散らした","ちらした"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["国々","くにぐに"],["の"],["中","なか"],["に"],["散った","ちった"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["おこない"],["と"],["、"],["わざと"],["に"],["したがって"],["、"],["彼","かれ"],["ら"],["を"],["さばいた"],["。"]]},{"verse":20,"text":"彼,かれらがその行,いくところの国々,くにぐにへ行,いったとき、わが聖,せいなる名,なを汚,けがした。これは人々,ひとびとが彼,かれらについて『これは主,しゅの民,たみであるが、その国,くにから出,でた者,ものである』と言,いったからである。","tok":[["彼","かれ"],["ら"],["が"],["その"],["行く","いく"],["ところ"],["の"],["国々","くにぐに"],["へ"],["行った","いった"],["とき"],["、"],["わが"],["聖","せい"],["なる"],["名","な"],["を"],["汚","け"],["がした"],["。"],["これ"],["は"],["人々","ひとびと"],["が"],["彼","かれ"],["ら"],["について"],["『"],["これ"],["は"],["主","しゅ"],["の"],["民","たみ"],["で"],["ある"],["が"],["、"],["その"],["国","くに"],["から"],["出た","でた"],["者","もの"],["で"],["ある"],["』"],["と"],["言った","いった"],["から"],["で"],["ある"],["。"]]},{"verse":21,"text":"しかしわたしはイスラエルの家,いえが、その行,いくところの諸,しょ国民,こくみんの中,なかで汚,けがしたわが聖,せいなる名,なを惜,おしんだ。","tok":[["しかし"],["わたし"],["は"],["イスラエル"],["の"],["家","いえ"],["が"],["、"],["その"],["行く","いく"],["ところ"],["の"],["諸国民","しょこくみん"],["の"],["中","なか"],["で"],["汚","け"],["がした"],["わが"],["聖","せい"],["なる"],["名","な"],["を"],["惜しんだ","おしんだ"],["。"]]},{"verse":22,"text":"それゆえ、あなたはイスラエルの家,いえに言,いえ。主,しゅなる神,かみはこう言,いわれる、イスラエルの家,いえよ、わたしがすることはあなたがたのためではない。それはあなたがたが行,いった諸,しょ国民,こくみんの中,なかで汚,けがした、わが聖,せいなる名,なのためである。","tok":[["それ"],["ゆえ"],["、"],["あなた"],["は"],["イスラエル"],["の"],["家","いえ"],["に"],["言え","いえ"],["。"],["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["イスラエル"],["の"],["家","いえ"],["よ"],["、"],["わたし"],["が"],["する"],["こと"],["は"],["あなた"],["がた"],["の"],["ため"],["で"],["は"],["ない"],["。"],["それ"],["は"],["あなた"],["がた"],["が"],["行った","いった"],["諸","しょ"],["国民","こくみん"],["の"],["中","なか"],["で"],["汚","け"],["がした"],["、"],["わが"],["聖","せい"],["なる"],["名","な"],["の"],["ため"],["で"],["ある"],["。"]]},{"verse":23,"text":"わたしは諸,しょ国民,こくみんの中,なかで汚,けがされたもの、すなわち、あなたがたが彼,かれらの中,なかで汚,けがした、わが大,おおいなる名,なの聖,せいなることを示,しめす。わたしがあなたがたによって、彼,かれらの目,めの前,まえに、わたしの聖,せいなることを示,しめす時,とき、諸,しょ国民,こくみんはわたしが主,しゅであることを悟,さとると、主,しゅなる神,かみは言,いわれる。","tok":[["わたし"],["は"],["諸","しょ"],["国民","こくみん"],["の"],["中","なか"],["で"],["汚","け"],["が"],["された"],["もの"],["、"],["すなわち"],["、"],["あなた"],["がた"],["が"],["彼","かれ"],["ら"],["の"],["中","なか"],["で"],["汚","け"],["がした"],["、"],["わが"],["大いなる","おおいなる"],["名","な"],["の"],["聖","せい"],["なる"],["こと"],["を"],["示めす","しめす"],["。"],["わたし"],["が"],["あなた"],["がた"],["によって"],["、"],["彼","かれ"],["ら"],["の"],["目","め"],["の"],["前","まえ"],["に"],["、"],["わたし"],["の"],["聖","せい"],["なる"],["こと"],["を"],["示めす","しめす"],["時","とき"],["、"],["諸","しょ"],["国民","こくみん"],["は"],["わたし"],["が"],["主","しゅ"],["で"],["ある"],["こと"],["を"],["悟","さとる"],["と"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"]]},{"verse":24,"text":"わたしはあなたがたを諸,しょ国民,こくみんの中,なかから導,みちびき出,だし、万国,ばんこくから集,あつめて、あなたがたの国,くにに行,いかせる。","tok":[["わたし"],["は"],["あなた"],["がた"],["を"],["諸","しょ"],["国民","こくみん"],["の"],["中","なか"],["から"],["導き出し","みちびきだし"],["、"],["万国","ばんこく"],["から"],["集めて","あつめて"],["、"],["あなた"],["がた"],["の"],["国","くに"],["に"],["行かせる","いかせる"],["。"]]},{"verse":25,"text":"わたしは清,きよい水,みずをあなたがたに注,そそいで、すべての汚,けがれから清,きよめ、またあなたがたを、すべての偶像,ぐうぞうから清,きよめる。","tok":[["わたし"],["は"],["清い","きよい"],["水","みず"],["を"],["あなた"],["がた"],["に"],["注いで","そそいで"],["、"],["すべて"],["の"],["汚","けがれか"],["ら"],["清め","きよめ"],["、"],["また"],["あなた"],["がた"],["を"],["、"],["すべて"],["の"],["偶像","ぐうぞう"],["から"],["清める","きよめる"],["。"]]},{"verse":26,"text":"わたしは新,あたらしい心,こころをあなたがたに与,あたえ、新,あたらしい霊,れいをあなたがたの内,うちに授,さづけ、あなたがたの肉,にくから、石,いしの心,こころを除,のぞいて、肉,にくの心,こころを与,あたえる。","tok":[["わたし"],["は"],["新らしい","あたらしい"],["心","こころ"],["を"],["あなた"],["がた"],["に"],["与","あたえ"],["、"],["新らしい","あたらしい"],["霊","れい"],["を"],["あなた"],["がた"],["の"],["内","うち"],["に"],["授","さ"],["づけ"],["、"],["あなた"],["がた"],["の"],["肉","にく"],["から"],["、"],["石","いし"],["の"],["心","こころ"],["を"],["除いて","のぞいて"],["、"],["肉","にく"],["の"],["心","こころ"],["を"],["与える","あたえる"],["。"]]},{"verse":27,"text":"わたしはまたわが霊,れいをあなたがたのうちに置,おいて、わが定,さだめに歩,あゆませ、わがおきてを守,まもってこれを行,おこなわせる。","tok":[["わたし"],["は"],["また"],["わが"],["霊","れい"],["を"],["あなた"],["がた"],["の"],["うち"],["に"],["置いて","おいて"],["、"],["わが"],["定め","さだめ"],["に"],["歩ませ","あゆませ"],["、"],["わが"],["おきて"],["を"],["守って","まもって"],["これ"],["を"],["行なわせる","おこなわせる"],["。"]]},{"verse":28,"text":"あなたがたは、わたしがあなたがたの先祖,せんぞに与,あたえた地,ちに住,すんで、わが民,たみとなり、わたしはあなたがたの神,かみとなる。","tok":[["あなた"],["がた"],["は"],["、"],["わたし"],["が"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["に"],["与","あたえ"],["た"],["地","ち"],["に"],["住んで","すんで"],["、"],["わが"],["民","たみ"],["と"],["なり"],["、"],["わたし"],["は"],["あなた"],["がた"],["の"],["神","かみ"],["と"],["なる"],["。"]]},{"verse":29,"text":"わたしはあなたがたをそのすべての汚,けがれから救,すくい、穀物,こくもつを呼,よびよせてこれを増,まし、ききんをあなたがたに臨,のぞませない。","tok":[["わたし"],["は"],["あなた"],["がた"],["を"],["その"],["すべて"],["の"],["汚","けがれか"],["ら"],["救い","すくい"],["、"],["穀物","こくもつ"],["を"],["呼びよせて","よびよせて"],["これ"],["を"],["増し","まし"],["、"],["ききん"],["を"],["あなた"],["がた"],["に"],["臨ませない","のぞませない"],["。"]]},{"verse":30,"text":"またわたしは木,きの実,みと、田畑,たはたの作物,さくもつとを多,おおくする。あなたがたは重,かさねて諸,しょ国民,こくみんの間,あいだに、ききんのはずかしめを受,うけることがない。","tok":[["また"],["わたし"],["は"],["木の実","きのみ"],["と"],["、"],["田畑","たはた"],["の"],["作物","さくもつ"],["と"],["を"],["多く","おおく"],["する"],["。"],["あなた"],["がた"],["は"],["重ねて","かさねて"],["諸","しょ"],["国民","こくみん"],["の"],["間","あいだ"],["に"],["、"],["ききん"],["の"],["はずかし"],["め"],["を"],["受る","うける"],["こと"],["が"],["ない"],["。"]]},{"verse":31,"text":"その時,ときあなたがたは自身,じしんの悪,あしきおこないと、良,よからぬわざとを覚,おぼえて、その罪,つみと、その憎,にくむべきこととのために、みずから恨,うらむ。","tok":[["その"],["時","とき"],["あなた"],["がた"],["は"],["自身","じしん"],["の"],["悪しき","あしき"],["おこない"],["と"],["、"],["良からぬ","よからぬ"],["わざと"],["を"],["覚えて","おぼえて"],["、"],["その"],["罪","つみ"],["と"],["、"],["その"],["憎むべき","にくむべき"],["こと"],["と"],["の"],["ため"],["に"],["、"],["みずから"],["恨む","うらむ"],["。"]]},{"verse":32,"text":"わたしがなすことはあなたがたのためではないと、主,しゅなる神,かみは言,いわれる。あなたがたはこれを知,しれ。イスラエルの家,いえよ、あなたがたは自分,じぶんのおこないを恥,はじて悔,くやむべきである。","tok":[["わたし"],["が"],["なす"],["こと"],["は"],["あなた"],["がた"],["の"],["ため"],["で"],["は"],["ない"],["と"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"],["あなた"],["がた"],["は"],["これ"],["を"],["知れ","しれ"],["。"],["イスラエル"],["の"],["家","いえ"],["よ"],["、"],["あなた"],["がた"],["は"],["自分","じぶん"],["の"],["おこない"],["を"],["恥","はじ"],["て"],["悔やむべきで","くやむべきで"],["ある"],["。"]]},{"verse":33,"text":"主,しゅなる神,かみはこう言,いわれる、わたしは、あなたがたのすべての罪,つみを清,きよめる日,ひに、町々,まちまちに人,ひとを住,すませ、その荒,あれ跡,あとを建,たて直,なおす。","tok":[["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["わたし"],["は"],["、"],["あなた"],["がた"],["の"],["すべて"],["の"],["罪","つみ"],["を"],["清める","きよめる"],["日","ひ"],["に"],["、"],["町々","まちまち"],["に"],["人","ひと"],["を"],["住ませ","すませ"],["、"],["その"],["荒れ","あれ"],["跡","あと"],["を"],["建て直す","たてなおす"],["。"]]},{"verse":34,"text":"荒,あれた地,ちは、行,いき来,きの人々,ひとびとの目,めに荒,あれ地,ちと見,みえたのに引,ひきかえて耕,たがやされる。","tok":[["荒た","あれた"],["地","ち"],["は"],["、"],["行き来","いきき"],["の"],["人々","ひとびと"],["の"],["目","め"],["に"],["荒れ地","あれち"],["と"],["見えた","みえた"],["のに"],["引か","ひきか"],["えて"],["耕やされる","たがやされる"],["。"]]},{"verse":35,"text":"そこで人々,ひとびとは言,いう、『この荒,あれた地,ちは、エデンの園,そののようになった。荒,あれ、滅,ほろび、くずれた町々,まちまちは、堅固,けんごになり、人,ひとの住,すむ所,ところとなった』と。","tok":[["そこ"],["で"],["人々","ひとびと"],["は"],["言う","いう"],["、"],["『"],["この"],["荒れた","あれた"],["地","ち"],["は"],["、"],["エデン"],["の"],["園","その"],["の"],["よう"],["に"],["なった"],["。"],["荒れ","あれ"],["、"],["滅び","ほろび"],["、"],["くずれた"],["町々","まちまち"],["は"],["、"],["堅固","けんご"],["に"],["なり"],["、"],["人","ひと"],["の"],["住む","すむ"],["所","ところ"],["と"],["なった"],["』"],["と"],["。"]]},{"verse":36,"text":"あなたがたの周囲,しゅういに残,のこった諸,しょ国民,こくみんは主,しゅなるわたしがくずれた所,ところを建,たて直,なおし、荒,あれた所,ところにものを植,うえたということを悟,さとるようになる。主,しゅなるわたしがこれを言,いい、これをなすのである。","tok":[["あなた"],["がた"],["の"],["周囲","しゅうい"],["に"],["残った","のこった"],["諸","しょ"],["国民","こくみん"],["は"],["主","しゅ"],["なる"],["わたし"],["が"],["くずれた"],["所","ところ"],["を"],["建て直し","たてなおし"],["、"],["荒た","あれた"],["所","ところ"],["に"],["もの"],["を"],["植えた","うえた"],["と"],["いう"],["こと"],["を"],["悟","さとる"],["よう"],["に"],["なる"],["。"],["主","しゅ"],["なる"],["わたし"],["が"],["これ"],["を"],["言い","いい"],["、"],["これ"],["を"],["なす"],["ので"],["ある"],["。"]]},{"verse":37,"text":"主,しゅなる神,かみはこう言,いわれる、イスラエルの家,いえは、わたしが次,つぎのことを彼,かれらのためにするように、わたしに求,もとめるべきである。すなわち人,ひとを群,むれのようにふやすこと、","tok":[["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["イスラエル"],["の"],["家","いえ"],["は"],["、"],["わたし"],["が"],["次","つぎ"],["の"],["こと"],["を"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["する"],["よう"],["に"],["、"],["わたし"],["に"],["求めるべきで","もとめるべきで"],["ある"],["。"],["すなわち"],["人","ひと"],["を"],["群れ","むれ"],["の"],["よう"],["に"],["ふやす"],["こと"],["、"]]},{"verse":38,"text":"すなわち犠牲,ぎせいのための群,むれのように、エルサレムの祝,いわい日,びの群,むれのようにすることである。こうして荒,あれた町々,まちまちは人,ひとの群,むれで満,みちる。その時,とき人々,ひとびとは、わたしが主,しゅであることを悟,さとるようになる」。","tok":[["すなわち"],["犠牲","ぎせい"],["の"],["ため"],["の"],["群れ","むれ"],["の"],["よう"],["に"],["、"],["エルサレム"],["の"],["祝い","いわい"],["日","び"],["の"],["群れ","むれ"],["の"],["よう"],["に"],["する"],["こと"],["で"],["ある"],["。"],["こう"],["して"],["荒れた","あれた"],["町々","まちまち"],["は"],["人","ひと"],["の"],["群れ","むれ"],["で"],["満ちる","みちる"],["。"],["その"],["時","とき"],["人々","ひとびと"],["は"],["、"],["わたし"],["が"],["主","しゅ"],["で"],["ある"],["こと"],["を"],["悟","さとる"],["よう"],["に"],["なる"],["」"],["。"]]}]
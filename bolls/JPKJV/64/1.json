[{"verse":1,"text":"長老,ちょうろうのわたしから、真実,しんじつに愛,あいしている親愛,しんあいなるガイオへ。","tok":[["長老","ちょうろう"],["の"],["わたし"],["から"],["、"],["真実","しんじつ"],["に"],["愛して","あいして"],["いる"],["親愛","しんあい"],["なる"],["ガイオ"],["へ"],["。"]]},{"verse":2,"text":"愛,あいする者,ものよ。あなたのたましいがいつも恵,めぐまれていると同,おなじく、あなたがすべてのことに恵,めぐまれ、またすこやかであるようにと、わたしは祈,いのっている。","tok":[["愛する","あいする"],["者","もの"],["よ"],["。"],["あなた"],["の"],["たましい"],["が"],["いつ"],["も"],["恵まれて","めぐまれて"],["いる"],["と"],["同じく","おなじく"],["、"],["あなた"],["が"],["すべて"],["の"],["こと"],["に"],["恵れ","めぐまれ"],["、"],["また"],["すこやか"],["で"],["ある"],["よう"],["に"],["と"],["、"],["わたし"],["は"],["祈って","いのって"],["いる"],["。"]]},{"verse":3,"text":"兄弟,きょうだいたちがきて、あなたが真理,しんりに生,いきていることを、あかししてくれたので、ひじょうに喜,よろこんでいる。事実,じじつ、あなたは真理,しんりのうちを歩,あるいているのである。","tok":[["兄弟","きょうだい"],["たち"],["が"],["きて"],["、"],["あなた"],["が"],["真理","しんり"],["に"],["生きて","いきて"],["いる"],["こと"],["を"],["、"],["あかし"],["して"],["くれた"],["ので"],["、"],["ひじょう"],["に"],["喜こんで","よろこんで"],["いる"],["。"],["事実","じじつ"],["、"],["あなた"],["は"],["真理","しんり"],["の"],["うち"],["を"],["歩いて","あるいて"],["いる"],["ので"],["ある"],["。"]]},{"verse":4,"text":"わたしの子供,こどもたちが真理,しんりのうちを歩,あるいていることを聞,きく以上,いじょうに、大,おおきい喜,よろこびはない。","tok":[["わたし"],["の"],["子供","こども"],["たち"],["が"],["真理","しんり"],["の"],["うち"],["を"],["歩いて","あるいて"],["いる"],["こと"],["を"],["聞く","きく"],["以上","いじょう"],["に"],["、"],["大きい","おおきい"],["喜こび","よろこび"],["は"],["ない"],["。"]]},{"verse":5,"text":"愛,あいする者,ものよ。あなたが、兄弟,きょうだいたち、しかも旅先,たびさきにある者,ものにつくしていることは、みな真実,しんじつなわざである。","tok":[["愛する","あいする"],["者","もの"],["よ"],["。"],["あなた"],["が"],["、"],["兄弟","きょうだい"],["たち"],["、"],["しかも"],["旅先","たびさき"],["に"],["ある"],["者","もの"],["に"],["つくして"],["いる"],["こと"],["は"],["、"],["みな"],["真実","しんじつ"],["な"],["わざ"],["で"],["ある"],["。"]]},{"verse":6,"text":"彼,かれらは、諸,しょ教会,きょうかいで、あなたの愛,あいについてあかしをした。それらの人々,ひとびとを、神,かみのみこころにかなうように送,おくり出,だしてくれたら、それは願,ねがわしいことである。","tok":[["彼","かれ"],["ら"],["は"],["、"],["諸教","しょ教"],["会","かい"],["で"],["、"],["あなた"],["の"],["愛","あい"],["について"],["あかし"],["を"],["した"],["。"],["それ"],["ら"],["の"],["人々","ひとびと"],["を"],["、"],["神","かみ"],["のみ"],["こころ"],["に"],["かなう"],["よう"],["に"],["送り出して","おくりだして"],["くれたら"],["、"],["それ"],["は"],["願しい","ねがわしい"],["こと"],["で"],["ある"],["。"]]},{"verse":7,"text":"彼,かれらは、御名,みなのために旅立,たびだった者,ものであって、異邦人,いほうじんからは何,なにも受,うけていない。","tok":[["彼","かれ"],["ら"],["は"],["、"],["御名","みな"],["の"],["ため"],["に"],["旅立った","たびだった"],["者","もの"],["で"],["あって"],["、"],["異邦人","いほうじん"],["から"],["は"],["何に","なに"],["も"],["受て","うけて"],["いない"],["。"]]},{"verse":8,"text":"それだから、わたしたちは、真理,しんりのための同労者,どうろうしゃとなるように、こういう人々,ひとびとを助,たすけねばならない。","tok":[["それ"],["だ"],["から"],["、"],["わたしたち"],["は"],["、"],["真理","しんり"],["の"],["ため"],["の"],["同労者","どうろうしゃ"],["と"],["なる"],["よう"],["に"],["、"],["こう"],["いう"],["人々","ひとびと"],["を"],["助けねば","たすけねば"],["ならない"],["。"]]},{"verse":9,"text":"わたしは少,すこしばかり教会,きょうかいに書,かきおくっておいたが、みんなのかしらになりたがっているデオテレペスが、わたしたちを受,うけいれてくれない。","tok":[["わたし"],["は"],["少し","すこし"],["ばかり"],["教会","きょうかい"],["に"],["書きおくって","かきおくって"],["おいた"],["が"],["、"],["みんな"],["の"],["かしら"],["に"],["なりたがって"],["いる"],["デオテレペス"],["が"],["、"],["わたしたち"],["を"],["受","うけ"],["いれて"],["くれない"],["。"]]},{"verse":10,"text":"だから、わたしがそちらへ行,いった時,とき、彼,かれのしわざを指摘,してきしようと思,おもう。彼,かれは口,くちぎたなくわたしたちをののしり、そればかりか、兄弟,きょうだいたちを受,うけいれようともせず、受,うけいれようとする人,ひとたちを妨,さまたげて、教会,きょうかいから追,おい出,だしている。","tok":[["だ"],["から"],["、"],["わたし"],["が"],["そちら"],["へ"],["行った","いった"],["時","とき"],["、"],["彼","かれ"],["の"],["しわざ"],["を"],["指摘","してき"],["しよう"],["と"],["思う","おもう"],["。"],["彼","かれ"],["は"],["口ぎたなく","くちぎたなく"],["わたしたち"],["を"],["ののしり"],["、"],["それ"],["ばかり"],["か"],["、"],["兄弟","きょうだい"],["たち"],["を"],["受","うけ"],["いれよう"],["と"],["も"],["せず"],["、"],["受","うけ"],["いれよう"],["と"],["する"],["人","ひと"],["たち"],["を"],["妨げて","さまたげて"],["、"],["教会","きょうかい"],["から"],["追い出して","おいだして"],["いる"],["。"]]},{"verse":11,"text":"愛,あいする者,ものよ。悪,あくにならわないで、善,ぜんにならいなさい。善,ぜんを行,おこなう者,ものは神,かみから出,でた者,ものであり、悪,あくを行,おこなう者,ものは神,かみを見,みたことのない者,ものである。","tok":[["愛する","あいする"],["者","もの"],["よ"],["。"],["悪","あく"],["に"],["ならわないで"],["、"],["善","ぜん"],["に"],["ならい"],["なさい"],["。"],["善","ぜん"],["を"],["行なう","おこなう"],["者","もの"],["は"],["神","かみ"],["から"],["出た","でた"],["者","もの"],["で"],["あり"],["、"],["悪","あく"],["を"],["行なう","おこなう"],["者","もの"],["は"],["神","かみ"],["を"],["見た","みた"],["こと"],["の"],["ない"],["者","もの"],["で"],["ある"],["。"]]},{"verse":12,"text":"デメテリオについては、あらゆる人,ひとも、また真理,しんりそのものも、証明,しょうめいしている。わたしたちも証明,しょうめいしている。そして、あなたが知,しっているとおり、わたしたちの証明,しょうめいは真実,しんじつである。","tok":[["デメテリオ"],["について"],["は"],["、"],["あらゆる"],["人","ひと"],["も"],["、"],["また"],["真理","しんり"],["その"],["もの"],["も"],["、"],["証明","しょうめい"],["して"],["いる"],["。"],["わたしたち"],["も"],["証明","しょうめい"],["して"],["いる"],["。"],["そして"],["、"],["あなた"],["が"],["知って","しって"],["いる"],["とおり"],["、"],["わたしたち"],["の"],["証明","しょうめい"],["は"],["真実","しんじつ"],["で"],["ある"],["。"]]},{"verse":13,"text":"あなたに書,かきおくりたいことはたくさんあるが、墨,すみと筆,ふでとで書,かくことはすまい。","tok":[["あなた"],["に"],["書きおくりたい","かきおくりたい"],["こと"],["は"],["たくさん"],["ある"],["が"],["、"],["墨","すみ"],["と"],["筆","ふで"],["と"],["で"],["書く","かく"],["こと"],["は"],["すまい"],["。"]]},{"verse":14,"text":"すぐにでもあなたに会,あって、直接,ちょくせつはなし合,あいたいものである。","tok":[["すぐ"],["に"],["で"],["も"],["あなた"],["に"],["会って","あって"],["、"],["直接","ちょくせつ"],["はなし"],["合いたい","あいたい"],["もの"],["で"],["ある"],["。"]]},{"verse":15,"text":"平安,へいあんが、あなたにあるように。友人,ゆうじんたちから、あなたによろしく。友人,ゆうじんたちひとりびとりに、よろしく。","tok":[["平安","へいあん"],["が"],["、"],["あなた"],["に"],["ある"],["よう"],["に"],["。"],["友人","ゆうじん"],["たち"],["から"],["、"],["あなた"],["に"],["よろしく"],["。"],["友人","ゆうじん"],["たち"],["ひとりびとり"],["に"],["、"],["よろしく"],["。"]]}]
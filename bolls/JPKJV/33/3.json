[{"verse":1,"text":"わたしは言,いった、ヤコブのかしらたちよ、イスラエルの家,いえのつかさたちよ、聞,きけ、公義,こうぎはあなたがたの知,しっておるべきことではないか。","tok":[["わたし"],["は"],["言った","いった"],["、"],["ヤコブ"],["の"],["かしら"],["たち"],["よ"],["、"],["イスラエル"],["の"],["家","いえ"],["の"],["つかさ"],["たち"],["よ"],["、"],["聞け","きけ"],["、"],["公義","こうぎ"],["は"],["あなた"],["がた"],["の"],["知って","しって"],["おるべき"],["こと"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":2,"text":"あなたがたは善,ぜんを憎,にくみ、悪,あくを愛,あいし、わが民,たみの身,みから皮,かわをはぎ、その骨,ほねから肉,にくをそぎ、","tok":[["あなた"],["がた"],["は"],["善","ぜん"],["を"],["憎み","にくみ"],["、"],["悪","あく"],["を"],["愛し","あいし"],["、"],["わが"],["民","たみ"],["の"],["身","み"],["から"],["皮","かわ"],["を"],["はぎ"],["、"],["その"],["骨","ほね"],["から"],["肉","にく"],["を"],["そぎ"],["、"]]},{"verse":3,"text":"またわが民,たみの肉,にくを食,くらい、その皮,かわをはぎ、その骨,ほねを砕,くだき、これを切,きりきざんで、なべに入,いれる食物,しょくもつのようにし、大,おおなべに入,いれる肉,にくのようにする。","tok":[["また"],["わが"],["民","たみ"],["の"],["肉","にく"],["を"],["食らい","くらい"],["、"],["その"],["皮","かわ"],["を"],["はぎ"],["、"],["その"],["骨","ほね"],["を"],["砕き","くだき"],["、"],["これ"],["を"],["切りきざんで","きりきざんで"],["、"],["なべ"],["に"],["入れる","いれる"],["食物","しょくもつ"],["の"],["よう"],["に"],["し"],["、"],["大なべ","おおなべ"],["に"],["入れる","いれる"],["肉","にく"],["の"],["よう"],["に"],["する"],["。"]]},{"verse":4,"text":"こうして彼,かれらが主,しゅに呼,よばわっても、主,しゅはお答,こたえにならない。かえってその時,ときには、み顔,かおを彼,かれらに隠,かくされる。彼,かれらのおこないが悪,わるいからである。","tok":[["こう"],["して"],["彼","かれ"],["ら"],["が"],["主に","しゅに"],["呼ばわって","よばわって"],["も"],["、"],["主","しゅ"],["は"],["お答","おこたえ"],["に"],["ならない"],["。"],["かえって"],["その"],["時","とき"],["に"],["は"],["、"],["み顔","みかお"],["を"],["彼","かれ"],["ら"],["に"],["隠される","かくされる"],["。"],["彼","かれ"],["ら"],["の"],["おこない"],["が"],["悪い","わるい"],["から"],["で"],["ある"],["。"]]},{"verse":5,"text":"わが民,たみを惑,まどわす預言者,よげんしゃについて主,しゅはこう言,いわれる、彼,かれらは食,たべ物,もののある時,ときには、「平安,へいあん」を叫,さけぶけれども、その口,くちに何,なにも与,あたえない者,ものにむかっては、宣戦,せんせんを布告,ふこくする。","tok":[["わが"],["民","たみ"],["を"],["惑わす","まどわす"],["預言者","よげんしゃ"],["について"],["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["彼","かれ"],["ら"],["は"],["食べ物","たべもの"],["の"],["ある"],["時","とき"],["に"],["は"],["、"],["「"],["平安","へいあん"],["」"],["を"],["叫けぶ","さけぶ"],["けれど"],["も"],["、"],["その"],["口","くち"],["に"],["何に","なに"],["も"],["与えない","あたえない"],["者","もの"],["に"],["むかって"],["は"],["、"],["宣戦","せんせん"],["を"],["布告","ふこく"],["する"],["。"]]},{"verse":6,"text":"それゆえ、あなたがたには夜,よるがあっても幻,まぼろしがなく、暗,くらやみがあっても占,うらないがない。太陽,たいようはその預言者,よげんしゃたちに没,ぼっし、昼,ひるも彼,かれらの上,うえに暗,くらくなる。","tok":[["それ"],["ゆえ"],["、"],["あなた"],["がた"],["に"],["は"],["夜","よる"],["が"],["あって"],["も"],["幻","まぼろし"],["が"],["なく"],["、"],["暗やみ","くらやみ"],["が"],["あって"],["も"],["占","うらない"],["が"],["ない"],["。"],["太陽","たいよう"],["は"],["その"],["預言者","よげんしゃ"],["たち"],["に"],["没し","ぼっし"],["、"],["昼","ひる"],["も"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["暗く","くらく"],["なる"],["。"]]},{"verse":7,"text":"先見者,せんけんしゃは恥,はじをかき、占,うらない師,しは顔,かおをあからめ、彼,かれらは皆,みなそのくちびるをおおう。神,かみの答,こたえがないからである。","tok":[["先見者","せんけんしゃ"],["は"],["恥","はじ"],["を"],["かき"],["、"],["占師","うらないし"],["は"],["顔","かお"],["を"],["あからめ"],["、"],["彼","かれ"],["ら"],["は"],["皆","みな"],["その"],["くちびる"],["を"],["おおう"],["。"],["神","かみ"],["の"],["答","こたえ"],["が"],["ない"],["から"],["で"],["ある"],["。"]]},{"verse":8,"text":"しかしわたしは主,しゅのみたまによって力,ちからに満,みち、公義,こうぎと勇気,ゆうきとに満,みたされ、ヤコブにそのとがを示,しめし、イスラエルにその罪,つみを示,しめすことができる。","tok":[["しかし"],["わたし"],["は"],["主","しゅ"],["の"],["みたま"],["によって"],["力","ちから"],["に"],["満ち","みち"],["、"],["公義","こうぎ"],["と"],["勇気","ゆうき"],["と"],["に"],["満たされ","みたされ"],["、"],["ヤコブ"],["に"],["その"],["とが"],["を"],["示めし","しめし"],["、"],["イスラエル"],["に"],["その"],["罪","つみ"],["を"],["示めす","しめす"],["こと"],["が"],["できる"],["。"]]},{"verse":9,"text":"ヤコブの家,いえのかしらたち、イスラエルの家,いえのつかさたちよ、すなわち公義,こうぎを憎,にくみ、すべての正,ただしい事,ことを曲,まげる者,ものよ、これを聞,きけ。","tok":[["ヤコブ"],["の"],["家","いえ"],["の"],["かしら"],["たち"],["、"],["イスラエル"],["の"],["家","いえ"],["の"],["つかさ"],["たち"],["よ"],["、"],["すなわち"],["公義","こうぎ"],["を"],["憎み","にくみ"],["、"],["すべて"],["の"],["正い","ただしい"],["事","こと"],["を"],["曲げる","まげる"],["者","もの"],["よ"],["、"],["これ"],["を"],["聞け","きけ"],["。"]]},{"verse":10,"text":"あなたがたは血,ちをもってシオンを建,たて、不義,ふぎをもってエルサレムを建,たてた。","tok":[["あなた"],["がた"],["は"],["血","ち"],["を"],["もって"],["シオン"],["を"],["建て","たて"],["、"],["不義","ふぎ"],["を"],["もって"],["エルサレム"],["を"],["建てた","たてた"],["。"]]},{"verse":11,"text":"そのかしらたちは、まいないをとってさばき、その祭司,さいしたちは価,あたいをとって教,おしえ、その預言者,よげんしゃたちは金,きんをとって占,うらなう。しかもなお彼,かれらは主,しゅに寄,より頼,たよんで、「主,しゅはわれわれの中,なかにおられるではないか、だから災,わざわいはわれわれに臨,のぞむことがない」と言,いう。","tok":[["その"],["かしら"],["たち"],["は"],["、"],["まいない"],["を"],["とって"],["さばき"],["、"],["その"],["祭司","さいし"],["たち"],["は"],["価","あたい"],["を"],["とって"],["教え","おしえ"],["、"],["その"],["預言者","よげんしゃ"],["たち"],["は"],["金","きん"],["を"],["とって"],["占う","うらなう"],["。"],["しかも"],["なお"],["彼","かれ"],["ら"],["は"],["主","しゅ"],["に"],["寄り","より"],["頼","た"],["よ"],["んで"],["、"],["「"],["主","しゅ"],["は"],["われわれ"],["の"],["中","なか"],["に"],["おられるで"],["は"],["ない"],["か"],["、"],["だ"],["から"],["災","わざわい"],["は"],["われわれ"],["に"],["臨む","のぞむ"],["こと"],["が"],["ない"],["」"],["と"],["言う","いう"],["。"]]},{"verse":12,"text":"それゆえ、シオンはあなたがたのゆえに田畑,たはたとなって耕,たがやされ、エルサレムは石塚,いしづかとなり、宮,みやの山,やまは木,きのおい茂,しげる高,たかい所,ところとなる。","tok":[["それ"],["ゆえ"],["、"],["シオン"],["は"],["あなた"],["がた"],["の"],["ゆえ"],["に"],["田畑","たはた"],["と"],["なって"],["耕やされ","たがやされ"],["、"],["エルサレム"],["は"],["石塚","いしづか"],["と"],["なり"],["、"],["宮","みや"],["の"],["山","やま"],["は"],["木","き"],["の"],["おい"],["茂","しげる"],["高い","たかい"],["所","ところ"],["と"],["なる"],["。"]]}]
[{"verse":1,"text":"愛,あいする者,ものたちよ。わたしは今,いまこの第,だい二の手紙,てがみをあなたがたに書,かきおくり、これらの手紙,てがみによって記憶,きおくを呼,よび起,おこし、あなたがたの純真,じゅんしんな心,こころを奮,ふるい立,たたせようとした。","tok":[["愛する","あいする"],["者","もの"],["たち"],["よ"],["。"],["わたし"],["は"],["今","いま"],["この"],["第","だい"],["二","に"],["の"],["手紙","てがみ"],["を"],["あなた"],["がた"],["に"],["書きおくり","かきおくり"],["、"],["これ"],["ら"],["の"],["手紙","てがみ"],["によって"],["記憶","きおく"],["を"],["呼び起こし","よびおこし"],["、"],["あなた"],["がた"],["の"],["純真","じゅんしん"],["な"],["心","こころ"],["を"],["奮い立たせよう","ふるいたたせよう"],["と"],["した"],["。"]]},{"verse":2,"text":"それは、聖,せいなる預言者,よげんしゃたちがあらかじめ語,かたった言葉,ことばと、あなたがたの使徒,しとたちが伝,つたえた主,しゅなる救主,すくいぬしの戒,いましめとを、思,おもい出,ださせるためである。","tok":[["それ"],["は"],["、"],["聖","せい"],["なる"],["預言者","よげんしゃ"],["たち"],["が"],["あらかじめ"],["語った","かたった"],["言葉","ことば"],["と"],["、"],["あなた"],["がた"],["の"],["使徒","しと"],["たち"],["が"],["伝えた","つたえた"],["主","しゅ"],["なる"],["救主","すくいぬし"],["の"],["戒しめ","いましめ"],["と"],["を"],["、"],["思い出させる","おもいださせる"],["ため"],["で"],["ある"],["。"]]},{"verse":3,"text":"まず次,つぎのことを知,しるべきである。終,おわりの時,ときにあざける者,ものたちが、あざけりながら出,でてきて、自分,じぶんの欲情,よくじょうのままに生活,せいかつし、","tok":[["まず"],["次","つぎ"],["の"],["こと"],["を"],["知るべきで","しるべきで"],["ある"],["。"],["終","おわり"],["の"],["時","とき"],["に"],["あざける"],["者","もの"],["たち"],["が"],["、"],["あざけり"],["ながら"],["出て","でて"],["きて"],["、"],["自分","じぶん"],["の"],["欲情","よくじょう"],["の"],["まま"],["に"],["生活","せいかつ"],["し"],["、"]]},{"verse":4,"text":"「主,しゅの来臨,らいりんの約束,やくそくはどうなったのか。先祖,せんぞたちが眠,ねむりについてから、すべてのものは天地,てんち創造,そうぞうの初,はじめからそのままであって、変,かわってはいない」と言,いうであろう。","tok":[["「"],["主","しゅ"],["の"],["来臨","らいりん"],["の"],["約束","やくそく"],["は"],["どう"],["なった"],["の"],["か"],["。"],["先祖","せんぞ"],["たち"],["が"],["眠","ねむり"],["について"],["から"],["、"],["すべて"],["の"],["もの"],["は"],["天地","てんち"],["創造","そうぞう"],["の"],["初め","はじめ"],["から"],["そのまま"],["で"],["あって"],["、"],["変わって","かわって"],["は"],["いない"],["」"],["と"],["言うで","いうで"],["あろう"],["。"]]},{"verse":5,"text":"すなわち、彼,かれらはこのことを認,みとめようとはしない。古,ふるい昔,むかしに天,てんが存在,そんざいし、地,ちは神,かみの言,ことばによって、水,みずがもとになり、また、水,みずによって成,なったのであるが、","tok":[["すなわち"],["、"],["彼","かれ"],["ら"],["は"],["この"],["こと"],["を"],["認めよう","みとめよう"],["と"],["は"],["しない"],["。"],["古い","ふるい"],["昔","むかし"],["に"],["天","てん"],["が"],["存在","そんざい"],["し"],["、"],["地","ち"],["は"],["神","かみ"],["の"],["言","ことば"],["によって"],["、"],["水","みず"],["が"],["もと"],["に"],["なり"],["、"],["また"],["、"],["水","みず"],["によって"],["成った","なった"],["ので"],["ある"],["が"],["、"]]},{"verse":6,"text":"その時,ときの世界,せかいは、御言,みことばにより水,みずでおおわれて滅,ほろんでしまった。","tok":[["その"],["時","とき"],["の"],["世界","せかい"],["は"],["、"],["御言","みこと"],["ば"],["に"],["より"],["水","みず"],["で"],["おおわれて"],["滅んで","ほろんで"],["しまった"],["。"]]},{"verse":7,"text":"しかし、今,いまの天,てんと地,ちとは、同,おなじ御言,みことばによって保存,ほぞんされ、不,ふ信仰,しんこうな人々,ひとびとがさばかれ、滅,ほろぼさるべき日,ひに火,ひで焼,やかれる時,ときまで、そのまま保,たもたれているのである。","tok":[["しかし"],["、"],["今","いま"],["の"],["天","てん"],["と"],["地","ち"],["と"],["は"],["、"],["同じ","おなじ"],["御言","みこと"],["ば"],["によって"],["保存","ほぞん"],["され"],["、"],["不","ふ"],["信仰","しんこう"],["な"],["人々","ひとびと"],["が"],["さばかれ"],["、"],["滅ぼさるべき","ほろぼさるべき"],["日","ひ"],["に"],["火","ひ"],["で"],["焼かれる","やかれる"],["時","とき"],["まで"],["、"],["そのまま"],["保たれて","たもたれて"],["いる"],["ので"],["ある"],["。"]]},{"verse":8,"text":"愛,あいする者,ものたちよ。この一事,いちじを忘,わすれてはならない。主,しゅにあっては、一日,にちは千年,ねんのようであり、千年,ねんは一日,にちのようである。","tok":[["愛する","あいする"],["者","もの"],["たち"],["よ"],["。"],["この"],["一事","いちじ"],["を"],["忘て","わすれて"],["は"],["ならない"],["。"],["主に","しゅに"],["あって"],["は"],["、"],["一","いち"],["日","にち"],["は"],["千","せん"],["年","ねん"],["の"],["よう"],["で"],["あり"],["、"],["千","せん"],["年","ねん"],["は"],["一","いち"],["日","にち"],["の"],["よう"],["で"],["ある"],["。"]]},{"verse":9,"text":"ある人々,ひとびとがおそいと思,おもっているように、主,しゅは約束,やくそくの実行,じっこうをおそくしておられるのではない。ただ、ひとりも滅,ほろびることがなく、すべての者,ものが悔改,くいあらために至,いたることを望,のぞみ、あなたがたに対,たいしてながく忍耐,にんたいしておられるのである。","tok":[["ある"],["人々","ひとびと"],["が"],["おそい"],["と"],["思って","おもって"],["いる"],["よう"],["に"],["、"],["主","しゅ"],["は"],["約束","やくそく"],["の"],["実行","じっこう"],["を"],["おそく"],["して"],["おられる"],["ので"],["は"],["ない"],["。"],["ただ"],["、"],["ひとり"],["も"],["滅びる","ほろびる"],["こと"],["が"],["なく"],["、"],["すべて"],["の"],["者","もの"],["が"],["悔改め","くいあらため"],["に"],["至る","いたる"],["こと"],["を"],["望み","のぞみ"],["、"],["あなた"],["がた"],["に対して","にたいして"],["ながく"],["忍耐","にんたい"],["して"],["おられる"],["ので"],["ある"],["。"]]},{"verse":10,"text":"しかし、主,しゅの日,ひは盗人,ぬすびとのように襲,おそって来,くる。その日,ひには、天,てんは大音響,だいおんきょうをたてて消,きえ去,さり、天体,てんたいは焼,やけてくずれ、地,ちとその上,うえに造,つくり出,だされたものも、みな焼,やきつくされるであろう。","tok":[["しかし"],["、"],["主","しゅ"],["の"],["日","ひ"],["は"],["盗人","ぬすびと"],["の"],["よう"],["に"],["襲って","おそって"],["来る","くる"],["。"],["その"],["日","ひ"],["に"],["は"],["、"],["天","てん"],["は"],["大","だい"],["音響","おんきょう"],["を"],["たてて"],["消え去り","きえさり"],["、"],["天体","てんたい"],["は"],["焼","やけ"],["て"],["くずれ"],["、"],["地","ち"],["と"],["その"],["上","うえ"],["に"],["造","つくり"],["出された","だされた"],["もの"],["も"],["、"],["みな"],["焼き","やき"],["つくされるで"],["あろう"],["。"]]},{"verse":11,"text":"このように、これらはみなくずれ落,おちていくものであるから、神,かみの日,ひの到来,とうらいを熱心,ねっしんに待,まち望,のぞんでいるあなたがたは、","tok":[["この"],["よう"],["に"],["、"],["これ"],["ら"],["は"],["みな"],["くずれ"],["落","おち"],["て"],["いく"],["もの"],["で"],["ある"],["から"],["、"],["神","かみ"],["の"],["日","ひ"],["の"],["到来","とうらい"],["を"],["熱心","ねっしん"],["に"],["待望んで","まちのぞんで"],["いる"],["あなた"],["がた"],["は"],["、"]]},{"verse":12,"text":"極力,きょくりょく、きよく信心,しんじん深,ぶかい行,おこないをしていなければならない。その日,ひには、天,てんは燃,もえくずれ、天体,てんたいは焼,やけうせてしまう。","tok":[["極力","きょくりょく"],["、"],["きよく"],["信心","しんじん"],["深い","ぶかい"],["行ない","おこない"],["を"],["して"],["いなければ"],["ならない"],["。"],["その"],["日","ひ"],["に"],["は"],["、"],["天","てん"],["は"],["燃え","もえ"],["くずれ"],["、"],["天体","てんたい"],["は"],["焼","やけ"],["うせて"],["しまう"],["。"]]},{"verse":13,"text":"しかし、わたしたちは、神,かみの約束,やくそくに従,したがって、義,ぎの住,すむ新,あたらしい天,てんと新,あたらしい地,ちとを待,まち望,のぞんでいる。","tok":[["しかし"],["、"],["わたしたち"],["は"],["、"],["神","かみ"],["の"],["約束","やくそく"],["に"],["従って","したがって"],["、"],["義","ぎ"],["の"],["住む","すむ"],["新らしい","あたらしい"],["天","てん"],["と"],["新らしい","あたらしい"],["地","ち"],["と"],["を"],["待ち望んで","まちのぞんで"],["いる"],["。"]]},{"verse":14,"text":"愛,あいする者,ものたちよ。それだから、この日,ひを待,まっているあなたがたは、しみもなくきずもなく、安,やすらかな心,こころで、神,かみのみまえに出,でられるように励,はげみなさい。","tok":[["愛する","あいする"],["者","もの"],["たち"],["よ"],["。"],["それ"],["だ"],["から"],["、"],["この"],["日","ひ"],["を"],["待って","まって"],["いる"],["あなた"],["がた"],["は"],["、"],["しみ"],["も"],["なく"],["きず"],["も"],["なく"],["、"],["安らか","やすらか"],["な"],["心","こころ"],["で"],["、"],["神","かみ"],["のみ"],["まえ"],["に"],["出られる","でられる"],["よう"],["に"],["励み","はげみ"],["なさい"],["。"]]},{"verse":15,"text":"また、わたしたちの主,しゅの寛容,かんようは救,すくいのためであると思,おもいなさい。このことは、わたしたちの愛,あいする兄弟,きょうだいパウロが、彼,かれに与,あたえられた知恵,ちえによって、あなたがたに書,かきおくったとおりである。","tok":[["また"],["、"],["わたしたち"],["の"],["主","しゅ"],["の"],["寛容","かんよう"],["は"],["救い","すくい"],["の"],["ため"],["で"],["ある"],["と"],["思い","おもい"],["なさい"],["。"],["この"],["こと"],["は"],["、"],["わたしたち"],["の"],["愛する","あいする"],["兄弟","きょうだい"],["パウロ"],["が"],["、"],["彼","かれ"],["に"],["与えられた","あたえられた"],["知恵","ちえ"],["によって"],["、"],["あなた"],["がた"],["に"],["書きおくった","かきおくった"],["とおり"],["で"],["ある"],["。"]]},{"verse":16,"text":"彼,かれは、どの手紙,てがみにもこれらのことを述,のべている。その手紙,てがみの中,なかには、ところどころ、わかりにくい箇所,かしょもあって、無学,むがくで心,こころの定,さだまらない者,ものたちは、ほかの聖書,せいしょについてもしているように、無理,むりな解釈,かいしゃくをほどこして、自分,じぶんの滅亡,めつぼうを招,まねいている。","tok":[["彼","かれ"],["は"],["、"],["どの"],["手紙","てがみ"],["に"],["も"],["これ"],["ら"],["の"],["こと"],["を"],["述べて","のべて"],["いる"],["。"],["その"],["手紙","てがみ"],["の"],["中","なか"],["に"],["は"],["、"],["ところどころ"],["、"],["わかり"],["にくい"],["箇所","かしょ"],["も"],["あって"],["、"],["無学","むがく"],["で"],["心","こころ"],["の"],["定まらない","さだまらない"],["者","もの"],["たち"],["は"],["、"],["ほか"],["の"],["聖書","せいしょ"],["について"],["も"],["して"],["いる"],["よう"],["に"],["、"],["無理","むり"],["な"],["解釈","かいしゃく"],["を"],["ほどこして"],["、"],["自分","じぶん"],["の"],["滅亡","めつぼう"],["を"],["招いて","まねいて"],["いる"],["。"]]},{"verse":17,"text":"愛,あいする者,ものたちよ。それだから、あなたがたはかねてから心,こころがけているように、非道,ひどうの者,ものの惑,まどわしに誘,さそい込,こまれて、あなたがた自身,じしんの確信,かくしんを失,うしなうことのないように心,こころがけなさい。","tok":[["愛する","あいする"],["者","もの"],["たち"],["よ"],["。"],["それ"],["だ"],["から"],["、"],["あなた"],["がた"],["は"],["かねて"],["から"],["心がけて","こころがけて"],["いる"],["よう"],["に"],["、"],["非道","ひどう"],["の"],["者","もの"],["の"],["惑わし","まどわし"],["に"],["誘い込まれて","さそいこまれて"],["、"],["あなた"],["がた"],["自身","じしん"],["の"],["確信","かくしん"],["を"],["失なう","うしなう"],["こと"],["の"],["ない"],["よう"],["に"],["心がけ","こころがけ"],["なさい"],["。"]]},{"verse":18,"text":"そして、わたしたちの主,しゅまた救主,すくいぬしイエス・キリストの恵,めぐみと知識,ちしきとにおいて、ますます豊,ゆたかになりなさい。栄光,えいこうが、今,いまも、また永遠,えいえんの日,ひに至,いたるまでも、主,しゅにあるように、アァメン。","tok":[["そして"],["、"],["わたしたち"],["の"],["主","しゅ"],["また"],["救主","す"],["くい"],["ぬし"],["イエス"],["・"],["キリスト"],["の"],["恵","めぐみ"],["と"],["知識","ちしき"],["と"],["に"],["おいて"],["、"],["ますます"],["豊","ゆたか"],["に"],["なり"],["なさい"],["。"],["栄光","えいこう"],["が"],["、"],["今","いま"],["も"],["、"],["また"],["永遠","えいえん"],["の"],["日","ひ"],["に"],["至る","いたる"],["まで"],["も"],["、"],["主に","しゅに"],["ある"],["よう"],["に"],["、"],["アァメン"],["。"]]}]
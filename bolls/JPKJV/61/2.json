[{"verse":1,"text":"しかし、民,たみの間,あいだに、にせ預言者,よげんしゃが起,おこったことがあるが、それと同,おなじく、あなたがたの間,あいだにも、にせ教師,きょうしが現,あらわれるであろう。彼,かれらは、滅,ほろびに至,いたらせる異端,いたんをひそかに持,もち込,こみ、自分,じぶんたちをあがなって下,くださった主,しゅを否定,ひていして、すみやかな滅亡,めつぼうを自分,じぶんの身,みに招,まねいている。","tok":[["しかし"],["、"],["民","たみ"],["の"],["間","あいだ"],["に"],["、"],["にせ"],["預言者","よげんしゃ"],["が"],["起こった","おこった"],["こと"],["が"],["ある"],["が"],["、"],["それ"],["と"],["同じく","おなじく"],["、"],["あなた"],["がた"],["の"],["間","あいだ"],["に"],["も"],["、"],["にせ"],["教師","きょうし"],["が"],["現われるで","あらわれるで"],["あろう"],["。"],["彼","かれ"],["ら"],["は"],["、"],["滅び","ほろび"],["に"],["至らせる","いたらせる"],["異端","いたん"],["を"],["ひそか"],["に"],["持込み","もちこみ"],["、"],["自分","じぶん"],["たち"],["を"],["あがなって"],["下さった","くださった"],["主","しゅ"],["を"],["否定","ひてい"],["して"],["、"],["すみやか"],["な"],["滅亡","めつぼう"],["を"],["自分","じぶん"],["の"],["身","み"],["に"],["招いて","まねいて"],["いる"],["。"]]},{"verse":2,"text":"また、大,おおぜいの人,ひとが彼,かれらの放縦,ほうしょうを見習,みならい、そのために、真理,しんりの道,みちがそしりを受,うけるに至,いたるのである。","tok":[["また"],["、"],["大ぜい","おおぜい"],["の"],["人","ひと"],["が"],["彼","かれ"],["ら"],["の"],["放縦","ほうしょう"],["を"],["見習","みならい"],["、"],["その"],["ため"],["に"],["、"],["真理","しんり"],["の"],["道","みち"],["が"],["そ"],["しり"],["を"],["受る","うける"],["に"],["至る","いたる"],["ので"],["ある"],["。"]]},{"verse":3,"text":"彼,かれらは、貪欲,どんよくのために、甘言,かんげんをもってあなたがたをあざむき、利,りをむさぼるであろう。彼,かれらに対,たいするさばきは昔,むかしから猶予,ゆうよなく行,おこなわれ、彼,かれらの滅亡,めつぼうも滞ることはない。","tok":[["彼","かれ"],["ら"],["は"],["、"],["貪欲","どんよく"],["の"],["ため"],["に"],["、"],["甘言","かんげん"],["を"],["もって"],["あなた"],["がた"],["を"],["あざむき"],["、"],["利","り"],["を"],["むさぼるで"],["あろう"],["。"],["彼","かれ"],["ら"],["に"],["対する","たいする"],["さばき"],["は"],["昔","むかし"],["から"],["猶予","ゆうよ"],["なく"],["行なわれ","おこなわれ"],["、"],["彼","かれ"],["ら"],["の"],["滅亡","めつぼう"],["も"],["滞る","とどこおる"],["こと"],["は"],["ない"],["。"]]},{"verse":4,"text":"神,かみは、罪,つみを犯,おかした御使,みつかいたちを許,ゆるしておかないで、彼,かれらを下界,げかいにおとしいれ、さばきの時,ときまで暗,くらやみの穴,あなに閉,とじ込,こめておかれた。","tok":[["神","かみ"],["は"],["、"],["罪","つみ"],["を"],["犯した","おかした"],["御使","みつかいたち"],["を"],["許して","ゆるして"],["おかないで"],["、"],["彼","かれ"],["ら"],["を"],["下界","げかい"],["に"],["おとしいれ"],["、"],["さばき"],["の"],["時","とき"],["まで"],["暗やみ","くらやみ"],["の"],["穴","あな"],["に"],["閉じ込めて","とじこめて"],["おかれた"],["。"]]},{"verse":5,"text":"また、古,ふるい世界,せかいをそのままにしておかないで、その不,ふ信仰,しんこうな世界,せかいに洪水,こうずいをきたらせ、ただ、義,ぎの宣伝者,せんでんしゃノアたち八人,にんの者,ものだけを保護,ほごされた。","tok":[["また"],["、"],["古い","ふるい"],["世界","せかい"],["を"],["そのまま"],["に"],["して"],["おかないで"],["、"],["その"],["不","ふ"],["信仰","しんこう"],["な"],["世界","せかい"],["に"],["洪水","こうずい"],["を"],["きたらせ"],["、"],["ただ"],["、"],["義","ぎ"],["の"],["宣伝者","せんでんしゃ"],["ノア"],["たち"],["八人","にん"],["の"],["者","もの"],["だけ"],["を"],["保護","ほご"],["された"],["。"]]},{"verse":6,"text":"また、ソドムとゴモラの町々,まちまちを灰,はいに帰,きせしめて破滅,はめつに処,しょし、不,ふ信仰,しんこうに走,はしろうとする人々,ひとびとの見,みせしめとし、","tok":[["また"],["、"],["ソドム"],["と"],["ゴモラ"],["の"],["町々","まちまち"],["を"],["灰","はい"],["に"],["帰せしめて","きせしめて"],["破滅","はめつ"],["に"],["処し","しょし"],["、"],["不","ふ"],["信仰","しんこう"],["に"],["走ろう","はしろう"],["と"],["する"],["人々","ひとびと"],["の"],["見せしめ","みせしめ"],["と"],["し"],["、"]]},{"verse":7,"text":"ただ、非道,ひどうの者,ものどもの放縦,ほうじゅうな行,おこないによってなやまされていた義人,ぎじんロトだけを救,すくい出,だされた。","tok":[["ただ"],["、"],["非道","ひどう"],["の"],["者","もの"],["ども"],["の"],["放縦","ほ"],["う"],["じゅう"],["な"],["行ない","おこない"],["によって"],["なやまされて"],["いた"],["義人","ぎじん"],["ロト"],["だけ"],["を"],["救い出された","すくいだされた"],["。"]]},{"verse":8,"text":"（この義人,ぎじんは、彼,かれらの間,あいだに住,すみ、彼,かれらの不法,ふほうの行,おこないを日々,ひび見聞,みききして、その正,ただしい心,こころを痛,いためていたのである。）","tok":[["（"],["この"],["義人","ぎじん"],["は"],["、"],["彼","かれ"],["ら"],["の"],["間","あいだ"],["に"],["住み","すみ"],["、"],["彼","かれ"],["ら"],["の"],["不法","ふほう"],["の"],["行ない","おこない"],["を"],["日々","ひび"],["見聞き","みきき"],["して"],["、"],["その"],["正い","ただしい"],["心","こころ"],["を"],["痛めて","いためて"],["いた"],["ので"],["ある"],["。"],["）"]]},{"verse":9,"text":"こういうわけで、主,しゅは、信心,しんじん深,ぶかい者,ものを試錬,しれんの中,なかから救,すくい出,だし、また、不義,ふぎな者,ものども、","tok":[["こう"],["いう"],["わけ"],["で"],["、"],["主","しゅ"],["は"],["、"],["信心","しんじん"],["深い","ぶかい"],["者","もの"],["を"],["試錬","しれん"],["の"],["中","なか"],["から"],["救い出し","すくいだし"],["、"],["また"],["、"],["不義","ふぎ"],["な"],["者","もの"],["ども"],["、"]]},{"verse":10,"text":"特,とくに、汚,けがれた情欲,じょうよくにおぼれ肉,にくにしたがって歩,あゆみ、また、権威,けんいある者,ものを軽,かろんじる人々,ひとびとを罰,ばっして、さばきの日,ひまで閉,とじ込,こめておくべきことを、よくご存,ぞんじなのである。こういう人々,ひとびとは、大胆,だいたん不,ふ敵,てきなわがまま者,ものであって、栄光,えいこうある者,ものたちをそしってはばかるところがない。","tok":[["特に","とくに"],["、"],["汚","け"],["がれ"],["た"],["情欲","じょうよく"],["に"],["おぼれ"],["肉","にく"],["に"],["したがって"],["歩","あゆみ"],["、"],["また"],["、"],["権威","けんい"],["ある"],["者","もの"],["を"],["軽んじる","かろんじる"],["人々","ひとびと"],["を"],["罰して","ばっして"],["、"],["さばき"],["の"],["日","ひ"],["まで"],["閉じ込めて","とじこめて"],["おくべき"],["こと"],["を"],["、"],["よく"],["ご存じ","ごぞんじ"],["な"],["ので"],["ある"],["。"],["こう"],["いう"],["人々","ひとびと"],["は"],["、"],["大胆","だいたん"],["不敵","ふてき"],["な"],["わがまま"],["者","もの"],["で"],["あって"],["、"],["栄光","えいこう"],["ある"],["者","もの"],["たち"],["を"],["そしって"],["はばかる"],["ところ"],["が"],["ない"],["。"]]},{"verse":11,"text":"しかし、御使,みつかいたちは、勢,いきおいにおいても力,ちからにおいても、彼,かれらにまさっているにかかわらず、彼,かれらを主,しゅのみまえに訴,うったえそしることはしない。","tok":[["しかし"],["、"],["御使","みつかいたち"],["は"],["、"],["勢い","いきおい"],["に"],["おいて"],["も"],["力","ちから"],["に"],["おいて"],["も"],["、"],["彼","かれ"],["ら"],["に"],["まさって"],["いる"],["に"],["かかわらず"],["、"],["彼","かれ"],["ら"],["を"],["主","しゅ"],["のみ"],["まえ"],["に"],["訴","うったえ"],["そしる"],["こと"],["は"],["しない"],["。"]]},{"verse":12,"text":"これらの者,ものは、捕,とらえられ、ほふられるために生,うまれてきた、分別,ふんべつのない動物,どうぶつのようなもので、自分,じぶんが知,しりもしないことをそしり、その不義,ふぎの報,むくいとして罰,ばつを受,うけ、必,かならず滅,ほろぼされてしまうのである。","tok":[["これ"],["ら"],["の"],["者","もの"],["は"],["、"],["捕らえられ","とらえられ"],["、"],["ほふられる"],["ため"],["に"],["生まれて","うまれて"],["きた"],["、"],["分別","ふんべつ"],["の"],["ない"],["動物","どうぶつ"],["の"],["よう"],["な"],["もの"],["で"],["、"],["自分","じぶん"],["が"],["知り","しり"],["も"],["しない"],["こと"],["を"],["そしり"],["、"],["その"],["不義","ふぎ"],["の"],["報い","むくい"],["として"],["罰","ばつ"],["を"],["受け","うけ"],["、"],["必","かならず"],["滅ぼされて","ほろぼされて"],["しまう"],["ので"],["ある"],["。"]]},{"verse":13,"text":"彼,かれらは、真昼,まひるでさえ酒食,しゅしょくを楽,たのしみ、あなたがたと宴会,えんかいに同席,どうせきして、だましごとにふけっている。彼,かれらは、しみであり、きずである。","tok":[["彼","かれ"],["ら"],["は"],["、"],["真昼","まひる"],["で"],["さえ"],["酒食","しゅしょく"],["を"],["楽み","たのしみ"],["、"],["あなた"],["がた"],["と"],["宴会","えんかい"],["に"],["同席","どうせき"],["して"],["、"],["だまし"],["ごと"],["に"],["ふけって"],["いる"],["。"],["彼","かれ"],["ら"],["は"],["、"],["しみ"],["で"],["あり"],["、"],["きず"],["で"],["ある"],["。"]]},{"verse":14,"text":"その目,めは淫行,いんこうを追,おい、罪,つみを犯,おかして飽,あくことを知,しらない。彼,かれらは心,こころの定,さだまらない者,ものを誘惑,ゆうわくし、その心,こころは貪欲,どんよくに慣,なれ、のろいの子,ことなっている。","tok":[["その"],["目","め"],["は"],["淫行","いんこう"],["を"],["追い","おい"],["、"],["罪","つみ"],["を"],["犯して","おかして"],["飽く","あく"],["こと"],["を"],["知らない","しらない"],["。"],["彼","かれ"],["ら"],["は"],["心","こころ"],["の"],["定まらない","さだまらない"],["者","もの"],["を"],["誘惑","ゆうわく"],["し"],["、"],["その"],["心","こころ"],["は"],["貪欲","どんよく"],["に"],["慣れ","なれ"],["、"],["のろい"],["の"],["子","こ"],["と"],["なって"],["いる"],["。"]]},{"verse":15,"text":"彼,かれらは正,ただしい道,みちからはずれて迷,まよいに陥,おちいり、ベオルの子,こバラムの道,みちに従,したがった。バラムは不,ふ義,ぎの実,みを愛,あいし、","tok":[["彼","かれ"],["ら"],["は"],["正い","ただしい"],["道","みち"],["から"],["はずれて"],["迷い","まよい"],["に"],["陥ち","おち"],["いり"],["、"],["ベオル"],["の"],["子","こ"],["バラム"],["の"],["道","みち"],["に"],["従った","したがった"],["。"],["バラム"],["は"],["不義","ふぎ"],["の"],["実","み"],["を"],["愛し","あいし"],["、"]]},{"verse":16,"text":"そのために、自分,じぶんのあやまちに対,たいするとがめを受,うけた。ものを言,いわないろばが、人間,にんげんの声,こえでものを言,いい、この預言者,よげんしゃの狂気,きょうきじみたふるまいをはばんだのである。","tok":[["その"],["ため"],["に"],["、"],["自分","じぶん"],["の"],["あやまち"],["に"],["対する","たいする"],["とがめ"],["を"],["受た","うけた"],["。"],["もの"],["を"],["言わない","いわない"],["ろば"],["が"],["、"],["人間","にんげん"],["の"],["声","こえ"],["で"],["もの"],["を"],["言い","いい"],["、"],["この"],["預言者","よげんしゃ"],["の"],["狂気","きょうき"],["じみ"],["た"],["ふるまい"],["を"],["はばんだ"],["ので"],["ある"],["。"]]},{"verse":17,"text":"この人々,ひとびとは、いわば、水,みずのない井戸,いど、突風,とっぷうに吹,ふきはらわれる霧,きりであって、彼,かれらには暗,くらやみが用意,よういされている。","tok":[["この"],["人々","ひとびと"],["は"],["、"],["いわば"],["、"],["水","みず"],["の"],["ない"],["井戸","いど"],["、"],["突風","とっぷう"],["に"],["吹","ふき"],["はらわれる"],["霧","きり"],["で"],["あって"],["、"],["彼","かれ"],["ら"],["に"],["は"],["暗やみ","くらやみ"],["が"],["用意","ようい"],["されて"],["いる"],["。"]]},{"verse":18,"text":"彼,かれらはむなしい誇,ほこりを語,かたり、迷,まよいの中,なかに生,いきている人々,ひとびとの間,あいだから、かろうじてのがれてきた者,ものたちを、肉欲,にくよくと色情,しきじょうとによって誘惑,ゆうわくし、","tok":[["彼","かれ"],["ら"],["は"],["むなしい"],["誇","ほこり"],["を"],["語り","かたり"],["、"],["迷い","まよい"],["の"],["中","なか"],["に"],["生きて","いきて"],["いる"],["人々","ひとびと"],["の"],["間","あいだ"],["から"],["、"],["かろうじて"],["のがれて"],["きた"],["者","もの"],["たち"],["を"],["、"],["肉欲","にくよく"],["と"],["色情","しきじょう"],["と"],["によって"],["誘惑","ゆうわく"],["し"],["、"]]},{"verse":19,"text":"この人々,ひとびとに自由,じゆうを与,あたえると約束,やくそくしながら、彼,かれら自身,じしんは滅亡,めつぼうの奴隷,どれいになっている。おおよそ、人,ひとは征服者,せいふくしゃの奴隷,どれいとなるものである。","tok":[["この"],["人々","ひとびと"],["に"],["自由","じゆう"],["を"],["与える","あたえる"],["と"],["約束","やくそく"],["し"],["ながら"],["、"],["彼","かれ"],["ら"],["自身","じしん"],["は"],["滅亡","めつぼう"],["の"],["奴隷","どれい"],["に"],["なって"],["いる"],["。"],["おおよそ"],["、"],["人","ひと"],["は"],["征服者","せいふくしゃ"],["の"],["奴隷","どれい"],["と"],["なる"],["もの"],["で"],["ある"],["。"]]},{"verse":20,"text":"彼,かれらが、主,しゅまた救主,すくいぬしなるイエス・キリストを知,しることにより、この世,よの汚,けがれからのがれた後,のち、またそれに巻,まき込,こまれて征服,せいふくされるならば、彼,かれらの後,のちの状態,じょうたいは初,はじめよりも、もっと悪,わるくなる。","tok":[["彼","かれ"],["ら"],["が"],["、"],["主","しゅ"],["また"],["救主","す"],["くい"],["ぬし"],["なる"],["イエス"],["・"],["キリスト"],["を"],["知る","しる"],["こと"],["に"],["より"],["、"],["この世","このよ"],["の"],["汚","けがれか"],["ら"],["のがれた"],["後","の"],["ち"],["、"],["また"],["それ"],["に"],["巻込まれて","まきこまれて"],["征服","せいふく"],["されるならば"],["、"],["彼","かれ"],["ら"],["の"],["後","のち"],["の"],["状態","じょうたい"],["は"],["初め","はじめ"],["より"],["も"],["、"],["もっと"],["悪く","わるく"],["なる"],["。"]]},{"verse":21,"text":"義,ぎの道,みちを心得,こころえていながら、自分,じぶんに授,さづけられた聖,せいなる戒,いましめにそむくよりは、むしろ義,ぎの道,みちを知,しらなかった方,ほうがよい。","tok":[["義","ぎ"],["の"],["道","みち"],["を"],["心得て","こころえて"],["い"],["ながら"],["、"],["自分","じぶん"],["に"],["授","さ"],["づけられた"],["聖","せい"],["なる"],["戒しめ","いましめ"],["に"],["そむく"],["より"],["は"],["、"],["むしろ"],["義","ぎ"],["の"],["道","みち"],["を"],["知らなかった","しらなかった"],["方","ほう"],["が"],["よい"],["。"]]},{"verse":22,"text":"ことわざに、「犬,いぬは自分,じぶんの吐,はいた物,ものに帰,かえり、豚,ぶたは洗,あらわれても、また、どろの中,なかにころがって行,いく」とあるが、彼,かれらの身,みに起,おこったことは、そのとおりである。","tok":[["ことわざ"],["に"],["、"],["「"],["犬","いぬ"],["は"],["自分","じぶん"],["の"],["吐いた","はいた"],["物","もの"],["に"],["帰えり","かえり"],["、"],["豚","ぶた"],["は"],["洗われて","あらわれて"],["も"],["、"],["また"],["、"],["どろ"],["の"],["中","なか"],["に"],["ころがって"],["行く","いく"],["」"],["と"],["ある"],["が"],["、"],["彼","かれ"],["ら"],["の"],["身","み"],["に"],["起こった","おこった"],["こと"],["は"],["、"],["その"],["とおり"],["で"],["ある"],["。"]]}]
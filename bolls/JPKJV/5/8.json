[{"verse":1,"text":"わたしが、きょう、命,めいじるこのすべての命令,めいれいを、あなたがたは守,まもって行,おこなわなければならない。そうすればあなたがたは生,いきることができ、かつふえ増,まし、主,しゅがあなたがたの先祖,せんぞに誓,ちかわれた地,ちにはいって、それを自分,じぶんのものとすることができるであろう。","tok":[["わたし"],["が"],["、"],["きょう"],["、"],["命じる","めいじる"],["この"],["すべて"],["の"],["命令","めいれい"],["を"],["、"],["あなた"],["がた"],["は"],["守って","まもって"],["行なわなければ","おこなわなければ"],["ならない"],["。"],["そう"],["すれば"],["あなた"],["がた"],["は"],["生きる","いきる"],["こと"],["が"],["でき"],["、"],["かつ"],["ふえ"],["増し","まし"],["、"],["主","しゅ"],["が"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["に"],["誓われた","ちかわれた"],["地","ち"],["に"],["はいって"],["、"],["それ"],["を"],["自分","じぶん"],["の"],["もの"],["と"],["する"],["こと"],["が"],["できるで"],["あろう"],["。"]]},{"verse":2,"text":"あなたの神,かみ、主,しゅがこの四十年,ねんの間,あいだ、荒野,あらのであなたを導,みちびかれたそのすべての道,みちを覚,おぼえなければならない。それはあなたを苦,くるしめて、あなたを試,こころみ、あなたの心,こころのうちを知,しり、あなたがその命令,めいれいを守,まもるか、どうかを知,しるためであった。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","しゅがこ"],["の"],["四十","よんじゅう"],["年","ねん"],["の"],["間","あいだ"],["、"],["荒野","あら"],["ので"],["あなた"],["を"],["導かれた","みちびかれた"],["その"],["すべて"],["の"],["道","みち"],["を"],["覚えなければ","おぼえなければ"],["ならない"],["。"],["それ"],["は"],["あなた"],["を"],["苦しめて","くるしめて"],["、"],["あなた"],["を"],["試み","こころみ"],["、"],["あなた"],["の"],["心","こころ"],["の"],["うち"],["を"],["知り","しり"],["、"],["あなた"],["が"],["その"],["命令","めいれい"],["を"],["守","まもる"],["か"],["、"],["どう"],["か"],["を"],["知る","しる"],["ため"],["で"],["あった"],["。"]]},{"verse":3,"text":"それで主,しゅはあなたを苦,くるしめ、あなたを飢,うえさせ、あなたも知,しらず、あなたの先祖,せんぞたちも知,しらなかったマナをもって、あなたを養,やしなわれた。人,ひとはパンだけでは生,いきず、人,ひとは主,しゅの口,くちから出,でるすべてのことばによって生,いきることをあなたに知,しらせるためであった。","tok":[["それ"],["で"],["主","しゅ"],["は"],["あなた"],["を"],["苦しめ","くるしめ"],["、"],["あなた"],["を"],["飢","うえ"],["させ"],["、"],["あなた"],["も"],["知らず","しらず"],["、"],["あなた"],["の"],["先祖","せんぞ"],["たち"],["も"],["知らなかった","しらなかった"],["マナ"],["を"],["もって"],["、"],["あなた"],["を"],["養われた","やしなわれた"],["。"],["人","ひと"],["は"],["パン"],["だけ"],["で"],["は"],["生きず","いきず"],["、"],["人","ひと"],["は"],["主","しゅ"],["の"],["口","くち"],["から"],["出る","でる"],["すべて"],["の"],["ことば"],["によって"],["生きる","いきる"],["こと"],["を"],["あなた"],["に"],["知らせる","しらせる"],["ため"],["で"],["あった"],["。"]]},{"verse":4,"text":"この四十年,ねんの間,あいだ、あなたの着物,きものはすり切,きれず、あなたの足,あしは、はれなかった。","tok":[["この"],["四十","よんじゅう"],["年","ねん"],["の"],["間","あいだ"],["、"],["あなた"],["の"],["着物","きもの"],["は"],["すり切れず","すりきれず"],["、"],["あなた"],["の"],["足","あし"],["は"],["、"],["はれなかった"],["。"]]},{"verse":5,"text":"あなたはまた人,ひとがその子,こを訓練,くんれんするように、あなたの神,かみ、主,しゅもあなたを訓練,くんれんされることを心,こころにとめなければならない。","tok":[["あなた"],["は"],["また"],["人","ひと"],["が"],["その"],["子","こ"],["を"],["訓練","くんれん"],["する"],["よう"],["に"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["も"],["あなた"],["を"],["訓練","くんれん"],["される"],["こと"],["を"],["心","こころ"],["に"],["とめなければ"],["ならない"],["。"]]},{"verse":6,"text":"あなたの神,かみ、主,しゅの命令,めいれいを守,まもり、その道,みちに歩,あゆんで、彼,かれを恐,おそれなければならない。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["命令","めいれい"],["を"],["守り","まもり"],["、"],["その"],["道","みち"],["に"],["歩んで","あゆんで"],["、"],["彼","かれ"],["を"],["恐れなければ","おそれなければ"],["ならない"],["。"]]},{"verse":7,"text":"それはあなたの神,かみ、主,しゅがあなたを良,よい地,ちに導,みちびき入,いれられるからである。そこは谷,たににも山,やまにもわき出,でる水,みずの流,ながれ、泉,いずみ、および淵,ふちのある地,ち、","tok":[["それ"],["は"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["あなた"],["を"],["良い","よい"],["地","ち"],["に"],["導き入れられる","みちびきいれられる"],["から"],["で"],["ある"],["。"],["そこ"],["は"],["谷","たに"],["に"],["も"],["山","やま"],["に"],["も"],["わき出る","わきでる"],["水","みず"],["の"],["流れ","ながれ"],["、"],["泉","いずみ"],["、"],["および"],["淵","ふち"],["の"],["ある"],["地","ち"],["、"]]},{"verse":8,"text":"小麦,こむぎ、大麦,おおむぎ、ぶどう、いちじく及,およびざくろのある地,ち、油,あぶらのオリブの木,き、および蜜,みつのある地,ち、","tok":[["小麦","こむぎ"],["、"],["大麦","おおむぎ"],["、"],["ぶどう"],["、"],["いちじく"],["及","および"],["ざくろ"],["の"],["ある"],["地","ち"],["、"],["油","あぶら"],["の"],["オリブ"],["の"],["木","き"],["、"],["および"],["蜜","みつ"],["の"],["ある"],["地","ち"],["、"]]},{"verse":9,"text":"あなたが食,たべる食物,しょくもつに欠,かけることなく、なんの乏,とぼしいこともない地,ちである。その地,ちの石,いしは鉄,てつであって、その山,やまからは銅,どうを掘,ほり取,とることができる。","tok":[["あなた"],["が"],["食べる","たべる"],["食物","しょくもつ"],["に"],["欠ける","かける"],["こと"],["なく"],["、"],["なん"],["の"],["乏い","とぼしい"],["こと"],["も"],["ない"],["地","ち"],["で"],["ある"],["。"],["その"],["地","ち"],["の"],["石","いし"],["は"],["鉄","てつ"],["で"],["あって"],["、"],["その"],["山","やま"],["から"],["は"],["銅","どう"],["を"],["掘","ほり"],["取る","とる"],["こと"],["が"],["できる"],["。"]]},{"verse":10,"text":"あなたは食,たべて飽,あき、あなたの神,かみ、主,しゅがその良,よい地,ちを賜,たまわったことを感謝,かんしゃするであろう。","tok":[["あなた"],["は"],["食べて","たべて"],["飽き","あき"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅがそ"],["の"],["良い","よい"],["地","ち"],["を"],["賜わった","たまわった"],["こと"],["を"],["感謝","かんしゃ"],["するで"],["あろう"],["。"]]},{"verse":11,"text":"あなたは、きょう、わたしが命,めいじる主,しゅの命令,めいれいと、おきてと、定,さだめとを守,まもらず、あなたの神,かみ、主,しゅを忘,わすれることのないように慎,つつしまなければならない。","tok":[["あなた"],["は"],["、"],["きょう"],["、"],["わたし"],["が"],["命じる","めいじる"],["主","しゅ"],["の"],["命令","めいれい"],["と"],["、"],["おきて"],["と"],["、"],["定め","さだめ"],["と"],["を"],["守らず","まもらず"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["を"],["忘る","わすれる"],["こと"],["の"],["ない"],["よう"],["に"],["慎しまなければ","つつしまなければ"],["ならない"],["。"]]},{"verse":12,"text":"あなたは食,たべて飽,あき、麗,うるわしい家,いえを建,たてて住,すみ、","tok":[["あなた"],["は"],["食べて","たべて"],["飽き","あき"],["、"],["麗わしい","うるわしい"],["家","いえ"],["を"],["建てて","たてて"],["住み","すみ"],["、"]]},{"verse":13,"text":"また牛,うしや羊,ひつじがふえ、金銀,きんぎんが増,まし、持,もち物,ものがみな増,まし加,くわわるとき、","tok":[["また"],["牛","うし"],["や"],["羊","ひつじ"],["が"],["ふえ"],["、"],["金銀","きんぎん"],["が"],["増し","まし"],["、"],["持物","もちもの"],["が"],["みな"],["増し","まし"],["加わわる","くわわる"],["とき"],["、"]]},{"verse":14,"text":"おそらく心,こころにたかぶり、あなたの神,かみ、主,しゅを忘,わすれるであろう。主,しゅはあなたをエジプトの地,ち、奴隷,どれいの家,いえから導,みちびき出,だし、","tok":[["おそらく"],["心","こころ"],["に"],["たかぶり"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["を"],["忘れるで","わすれるで"],["あろう"],["。"],["主","しゅ"],["は"],["あなた"],["を"],["エジプト"],["の"],["地","ち"],["、"],["奴隷","どれい"],["の"],["家","いえ"],["から"],["導き出し","みちびきだし"],["、"]]},{"verse":15,"text":"あなたを導,みちびいて、あの大,おおきな恐,おそろしい荒野,あらの、すなわち火,ひのへびや、さそりがいて、水,みずのない、かわいた地,ちを通,とおり、あなたのために堅,かたい岩,いわから水,みずを出,だし、","tok":[["あなた"],["を"],["導いて","みちびいて"],["、"],["あの"],["大きな","おおきな"],["恐ろしい","おそろしい"],["荒野","あらの"],["、"],["すなわち"],["火","ひ"],["の"],["へび"],["や"],["、"],["さそり"],["が"],["いて"],["、"],["水","みず"],["の"],["ない"],["、"],["かわいた"],["地","ち"],["を"],["通り","とおり"],["、"],["あなた"],["の"],["ため"],["に"],["堅い","かたい"],["岩","いわ"],["から"],["水","みず"],["を"],["出し","だし"],["、"]]},{"verse":16,"text":"先祖,せんぞたちも知,しらなかったマナを荒野,あらのであなたに食,たべさせられた。それはあなたを苦,くるしめ、あなたを試,こころみて、ついにはあなたをさいわいにするためであった。","tok":[["先祖","せんぞ"],["たち"],["も"],["知らなかった","しらなかった"],["マナ"],["を"],["荒野","あらの"],["で"],["あなた"],["に"],["食べさせられた","たべさせられた"],["。"],["それ"],["は"],["あなた"],["を"],["苦しめ","くるしめ"],["、"],["あなた"],["を"],["試みて","こころみて"],["、"],["ついに"],["は"],["あなた"],["を"],["さいわい"],["に"],["する"],["ため"],["で"],["あった"],["。"]]},{"verse":17,"text":"あなたは心,こころのうちに『自分,じぶんの力,ちからと自分,じぶんの手,ての働,はたらきで、わたしはこの富,とみを得,えた』と言,いってはならない。","tok":[["あなた"],["は"],["心","こころ"],["の"],["うち"],["に"],["『"],["自分","じぶん"],["の"],["力","ちから"],["と"],["自分","じぶん"],["の"],["手","て"],["の"],["働らき","はたらき"],["で"],["、"],["わたし"],["は"],["この"],["富","とみ"],["を"],["得た","えた"],["』"],["と"],["言って","いって"],["は"],["ならない"],["。"]]},{"verse":18,"text":"あなたはあなたの神,かみ、主,しゅを覚,おぼえなければならない。主,しゅはあなたの先祖,せんぞたちに誓,ちかわれた契約,けいやくを今日,こんにちのように行,おこなうために、あなたに富,とみを得,える力,ちからを与,あたえられるからである。","tok":[["あなた"],["は"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["を"],["覚えなければ","おぼえなければ"],["ならない"],["。"],["主","しゅ"],["は"],["あなた"],["の"],["先祖","せんぞ"],["たち"],["に"],["誓われた","ちかわれた"],["契約","けいやく"],["を"],["今日","こんにち"],["の"],["よう"],["に"],["行なう","おこなう"],["ため"],["に"],["、"],["あなた"],["に"],["富","とみ"],["を"],["得る","える"],["力","ちから"],["を"],["与えられる","あたえられる"],["から"],["で"],["ある"],["。"]]},{"verse":19,"text":"もしあなたの神,かみ、主,しゅを忘,わすれて他,たの神々,かみがみに従,したがい、これに仕,つかえ、これを拝,おがむならば、――わたしは、きょう、あなたがたに警告,けいこくする。――あなたがたはきっと滅,ほろびるであろう。","tok":[["もし"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["を"],["忘て","わすれて"],["他","た"],["の"],["神々","かみがみ"],["に"],["従い","したがい"],["、"],["これ"],["に"],["仕え","つかえ"],["、"],["これ"],["を"],["拝むならば","おがむならば"],["、"],["―"],["―"],["わたし"],["は"],["、"],["きょう"],["、"],["あなた"],["がた"],["に"],["警告","けいこく"],["する"],["。"],["―"],["―"],["あなた"],["がた"],["は"],["きっと"],["滅びるで","ほろびるで"],["あろう"],["。"]]},{"verse":20,"text":"主,しゅがあなたがたの前,まえから滅,ほろぼし去,さられる国々,くにぐにの民,たみのように、あなたがたも滅,ほろびるであろう。あなたがたの神,かみ、主,しゅの声,こえに従,したがわないからである。","tok":[["主","しゅ"],["が"],["あなた"],["がた"],["の"],["前","まえ"],["から"],["滅ぼし去られる","ほろぼしさられる"],["国々","くにぐに"],["の"],["民","たみ"],["の"],["よう"],["に"],["、"],["あなた"],["がた"],["も"],["滅びるで","ほろびるで"],["あろう"],["。"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["声","こえ"],["に"],["従わない","したがわない"],["から"],["で"],["ある"],["。"]]}]
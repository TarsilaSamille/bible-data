[{"verse":1,"text":"イスラエルよ、聞,ききなさい。あなたは、きょう、ヨルダンを渡,わたって行,いって、あなたよりも大,おおきく、かつ強,つよい国々,くにぐにを取,とろうとしている。その町々,まちまちは大,おおきく、石,いしがきは天,てんに達,たっしている。","tok":[["イスラエル"],["よ"],["、"],["聞","きき"],["なさい"],["。"],["あなた"],["は"],["、"],["きょう"],["、"],["ヨルダン"],["を"],["渡って","わたって"],["行って","いって"],["、"],["あなた"],["より"],["も"],["大きく","おおきく"],["、"],["かつ"],["強い","つよい"],["国々","くにぐに"],["を"],["取ろう","とろう"],["として"],["いる"],["。"],["その"],["町々","まちまち"],["は"],["大きく","おおきく"],["、"],["石がき","いしがき"],["は"],["天","てん"],["に"],["達して","たっして"],["いる"],["。"]]},{"verse":2,"text":"その民,たみは、あなたの知,しっているアナクびとの子孫,しそんであって、大,おおきく、また背,せが高,たかい。あなたはまた『アナクの子孫,しそんの前,まえに、だれが立,たつことができようか』と人,ひとの言,いうのを聞,きいた。","tok":[["その"],["民","たみ"],["は"],["、"],["あなた"],["の"],["知って","しって"],["いる"],["アナク"],["びと"],["の"],["子孫","しそん"],["で"],["あって"],["、"],["大きく","おおきく"],["、"],["また"],["背","せ"],["が"],["高かい","たかい"],["。"],["あなた"],["は"],["また"],["『"],["アナク"],["の"],["子孫","しそん"],["の"],["前","まえ"],["に"],["、"],["だれ"],["が"],["立つ","たつ"],["こと"],["が"],["できよう"],["か"],["』"],["と"],["人","ひと"],["の"],["言う","いう"],["の"],["を"],["聞いた","きいた"],["。"]]},{"verse":3,"text":"それゆえ、あなたは、きょう、あなたの神,かみ、主,しゅは焼,やきつくす火,ひであって、あなたの前,まえに進,すすまれることを知,しらなければならない。主,しゅは彼,かれらを滅,ほろぼし、彼,かれらをあなたの前,まえに屈伏,くっぷくさせられるであろう。主,しゅがあなたに言,いわれたように、彼,かれらを追,おい払,はらい、すみやかに滅,ほろぼさなければならない。","tok":[["それ"],["ゆえ"],["、"],["あなた"],["は"],["、"],["きょう"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["焼き","やき"],["つくす"],["火","ひ"],["で"],["あって"],["、"],["あなた"],["の"],["前","まえ"],["に"],["進まれる","すすまれる"],["こと"],["を"],["知らなければ","しらなければ"],["ならない"],["。"],["主","しゅ"],["は"],["彼","かれ"],["ら"],["を"],["滅ぼし","ほろぼし"],["、"],["彼","かれ"],["ら"],["を"],["あなた"],["の"],["前","まえ"],["に"],["屈伏","くっぷく"],["させられるで"],["あろう"],["。"],["主","しゅ"],["が"],["あなた"],["に"],["言われた","いわれた"],["よう"],["に"],["、"],["彼","かれ"],["ら"],["を"],["追い払","おいはらい"],["、"],["すみやか"],["に"],["滅ぼさなければ","ほろぼさなければ"],["ならない"],["。"]]},{"verse":4,"text":"あなたの神,かみ、主,しゅがあなたの前,まえから彼,かれらを追,おい払,はらわれた後,のちに、あなたは心,こころのなかで『わたしが正,ただしいから主,しゅはわたしをこの地,ちに導,みちびき入,いれてこれを獲,えさせられた』と言,いってはならない。この国々,くにぐにの民,たみが悪,わるいから、主,しゅはこれをあなたの前,まえから追,おい払,はらわれるのである。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["あなた"],["の"],["前","まえ"],["から"],["彼","かれ"],["ら"],["を"],["追い払われた","おいはらわれた"],["後","のち"],["に"],["、"],["あなた"],["は"],["心","こころ"],["の"],["なか"],["で"],["『"],["わたし"],["が"],["正い","ただしい"],["から"],["主","しゅ"],["は"],["わたし"],["を"],["この"],["地","ち"],["に"],["導き入れて","みちびきいれて"],["これ"],["を"],["獲させられた","えさせられた"],["』"],["と"],["言って","いって"],["は"],["ならない"],["。"],["この"],["国々","くにぐに"],["の"],["民","たみ"],["が"],["悪い","わるい"],["から"],["、"],["主","しゅ"],["は"],["これ"],["を"],["あなた"],["の"],["前","まえ"],["から"],["追い払われる","おいはらわれる"],["ので"],["ある"],["。"]]},{"verse":5,"text":"あなたが行,いってその地,ちを獲,えるのは、あなたが正,ただしいからではなく、またあなたの心,こころがまっすぐだからでもない。この国々,くにぐにの民,たみが悪,わるいから、あなたの神,かみ、主,しゅは彼,かれらをあなたの前,まえから追,おい払,はらわれるのである。これは主,しゅがあなたの先祖,せんぞアブラハム、イサク、ヤコブに誓,ちかわれた言葉,ことばを行,おこなわれるためである。","tok":[["あなた"],["が"],["行って","いって"],["その"],["地","ち"],["を"],["獲る","える"],["の"],["は"],["、"],["あなた"],["が"],["正い","ただしい"],["から"],["で"],["は"],["なく"],["、"],["また"],["あなた"],["の"],["心","こころ"],["が"],["まっすぐ"],["だ"],["から"],["で"],["も"],["ない"],["。"],["この"],["国々","くにぐに"],["の"],["民","たみ"],["が"],["悪い","わるい"],["から"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["彼","かれ"],["ら"],["を"],["あなた"],["の"],["前","まえ"],["から"],["追い払われる","おいはらわれる"],["ので"],["ある"],["。"],["これ"],["は"],["主","しゅ"],["が"],["あなた"],["の"],["先祖","せんぞ"],["アブラハム"],["、"],["イサク"],["、"],["ヤコブ"],["に"],["誓われた","ちかわれた"],["言葉","ことば"],["を"],["行なわれる","おこなわれる"],["ため"],["で"],["ある"],["。"]]},{"verse":6,"text":"それであなたは、あなたの神,かみ、主,しゅがあなたにこの良,よい地,ちを与,あたえてこれを得,えさせられるのは、あなたが正,ただしいからではないことを知,しらなければならない。あなたは強情,ごうじょうな民,たみである。","tok":[["それ"],["で"],["あなた"],["は"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["あなた"],["に"],["この"],["良い","よい"],["地","ち"],["を"],["与","あたえ"],["て"],["これ"],["を"],["得させられる","えさせられる"],["の"],["は"],["、"],["あなた"],["が"],["正い","ただしい"],["から"],["で"],["は"],["ない"],["こと"],["を"],["知らなければ","しらなければ"],["ならない"],["。"],["あなた"],["は"],["強情","ごうじょう"],["な"],["民","たみ"],["で"],["ある"],["。"]]},{"verse":7,"text":"あなたは荒野,あらのであなたの神,かみ、主,しゅを怒,いからせたことを覚,おぼえ、それを忘,わすれてはならない。あなたがたはエジプトの地,ちを出,でた日,ひからこの所,ところに来,くるまで、いつも主,しゅにそむいた。","tok":[["あなた"],["は"],["荒野","あら"],["ので"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["を"],["怒らせた","いからせた"],["こと"],["を"],["覚え","おぼえ"],["、"],["それ"],["を"],["忘て","わすれて"],["は"],["ならない"],["。"],["あなた"],["がた"],["は"],["エジプト"],["の"],["地","ち"],["を"],["出た","でた"],["日","ひ"],["から"],["この"],["所","ところ"],["に"],["来る","くる"],["まで"],["、"],["いつも"],["主","しゅ"],["に"],["そむいた"],["。"]]},{"verse":8,"text":"またホレブにおいてさえ、あなたがたが主,しゅを怒,いからせたので、主,しゅは怒,いかってあなたがたを滅,ほろぼそうとされた。","tok":[["また"],["ホレブ"],["に"],["おいて"],["さえ"],["、"],["あなた"],["がた"],["が"],["主","しゅ"],["を"],["怒らせた","いからせた"],["ので"],["、"],["主","しゅ"],["は"],["怒","い"],["か"],["って"],["あなた"],["がた"],["を"],["滅ぼそう","ほろぼそう"],["と"],["された"],["。"]]},{"verse":9,"text":"わたしが石,いしの板,いたすなわち主,しゅがあなたがたと結,むすばれた契約,けいやくの板,いたを受,うけるために山,やまに登,のぼった時,とき、わたしは四十日,にち四十夜,や、山,やまにいて、パンも食,たべず水,みずも飲,のまなかった。","tok":[["わたし"],["が"],["石","いし"],["の"],["板","いた"],["すなわち"],["主","しゅ"],["が"],["あなた"],["がた"],["と"],["結ばれた","むすばれた"],["契約","けいやく"],["の"],["板","いた"],["を"],["受る","うける"],["ため"],["に"],["山","やま"],["に"],["登った","のぼった"],["時","とき"],["、"],["わたし"],["は"],["四十日","に"],["ち"],["四十","よんじゅう"],["夜","よる"],["、"],["山","やま"],["に"],["いて"],["、"],["パン"],["も"],["食べず","たべず"],["水","みず"],["も"],["飲まなかった","のまなかった"],["。"]]},{"verse":10,"text":"主,しゅは神,かみの指,ゆびをもって書,かきしるした石,いしの板,いた二枚,まいをわたしに授,さづけられた。その上,うえには、集会,しゅうかいの日,ひに主,しゅが山,やまで火,ひの中,なかから、あなたがたに告,つげられた言葉,ことばが、ことごとく書,かいてあった。","tok":[["主","しゅ"],["は"],["神","かみ"],["の"],["指","ゆび"],["を"],["もって"],["書きしるした","かきしるした"],["石","いし"],["の"],["板","いた"],["二枚","まい"],["を"],["わたし"],["に"],["授","さ"],["づけられた"],["。"],["その"],["上","うえ"],["に"],["は"],["、"],["集会","しゅうかい"],["の"],["日","ひ"],["に"],["主","しゅ"],["が"],["山","やま"],["で"],["火","ひ"],["の"],["中","なか"],["から"],["、"],["あなた"],["がた"],["に"],["告げられた","つげられた"],["言葉","ことば"],["が"],["、"],["ことごとく"],["書いて","かいて"],["あった"],["。"]]},{"verse":11,"text":"すなわち四十日,にち四十夜,やが終,おわった時,とき、主,しゅはわたしにその契約,けいやくの板,いたである石,いしの板,いた二枚,まいを授,さづけ、","tok":[["すなわち"],["四十日","に"],["ち"],["四十夜","や"],["が"],["終わった","おわった"],["時","とき"],["、"],["主","しゅ"],["は"],["わたし"],["に"],["その"],["契約","けいやく"],["の"],["板","いた"],["で"],["ある"],["石","いし"],["の"],["板","いた"],["二枚","まい"],["を"],["授","さ"],["づけ"],["、"]]},{"verse":12,"text":"そして主,しゅはわたしに言,いわれた、『おまえは立,たって、すみやかにこの所,ところから降,ふりなさい。おまえがエジプトから導,みちびき出,だした民,たみは悪,あくを行,おこなったからである。彼,かれらはわたしが命,めいじた道,みちを早,はやくも離,はなれて、鋳,いた像,ぞうを自分,じぶんたちのために造,つくった』。","tok":[["そして"],["主","しゅ"],["は"],["わたし"],["に"],["言われた","いわれた"],["、"],["『"],["おまえ"],["は"],["立って","たって"],["、"],["すみやか"],["に"],["この"],["所","ところ"],["から"],["降り","ふり"],["なさい"],["。"],["おまえ"],["が"],["エジプト"],["から"],["導き出した","みちびきだした"],["民","たみ"],["は"],["悪","あく"],["を"],["行なった","おこなった"],["から"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["わたし"],["が"],["命じた","めいじた"],["道","みち"],["を"],["早く","はやく"],["も"],["離れて","はなれて"],["、"],["鋳た","いた"],["像","ぞう"],["を"],["自分","じぶん"],["たち"],["の"],["ため"],["に"],["造った","つくった"],["』"],["。"]]},{"verse":13,"text":"主,しゅはまたわたしに言,いわれた、『この民,たみを見,みるのに、これは強情,ごうじょうな民,たみである。","tok":[["主","しゅ"],["は"],["また"],["わたし"],["に"],["言われた","いわれた"],["、"],["『"],["この"],["民","たみ"],["を"],["見る","みる"],["のに"],["、"],["これ"],["は"],["強情","ごうじょう"],["な"],["民","たみ"],["で"],["ある"],["。"]]},{"verse":14,"text":"わたしを止,とめるな。わたしは彼,かれらを滅,ほろぼし、彼,かれらの名,なを天,てんの下,したから消,けし去,さり、おまえを彼,かれらよりも強,つよく、かつ大,おおいなる国民,こくみんとしよう』。","tok":[["わたし"],["を"],["止める","とめる"],["な"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["滅ぼし","ほろぼし"],["、"],["彼","かれ"],["ら"],["の"],["名","な"],["を"],["天","てん"],["の"],["下","した"],["から"],["消し去り","けしさり"],["、"],["おまえ"],["を"],["彼","かれ"],["ら"],["より"],["も"],["強く","つよく"],["、"],["かつ"],["大いなる","おおいなる"],["国民","こくみん"],["と"],["しよう"],["』"],["。"]]},{"verse":15,"text":"そこでわたしは身,みをめぐらして山,やまを降,おりたが、山,やまは火,ひで焼,やけていた。契約,けいやくの板,いた二枚,まいはわたしの両手,りょうてにあった。","tok":[["そこ"],["で"],["わたし"],["は"],["身","み"],["を"],["めぐらして"],["山","やま"],["を"],["降りた","おりた"],["が"],["、"],["山","やま"],["は"],["火","ひ"],["で"],["焼","やけ"],["て"],["いた"],["。"],["契約","けいやく"],["の"],["板","いた"],["二枚","まい"],["は"],["わたし"],["の"],["両手","りょうて"],["に"],["あった"],["。"]]},{"verse":16,"text":"そしてわたしが見,みると、あなたがたは、あなたがたの神,かみ、主,しゅにむかって罪,つみを犯,おかし、自分,じぶんたちのために鋳物,いものの子,こ牛,うしを造,つくって、主,しゅが命,めいじられた道,みちを早,はやくも離,はなれたので、","tok":[["そして"],["わたし"],["が"],["見る","みる"],["と"],["、"],["あなた"],["がた"],["は"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主に","しゅに"],["むかって"],["罪","つみ"],["を"],["犯し","おかし"],["、"],["自分","じぶん"],["たち"],["の"],["ため"],["に"],["鋳物","いもの"],["の"],["子牛","こうし"],["を"],["造って","つくって"],["、"],["主","しゅ"],["が"],["命じられた","めいじられた"],["道","みち"],["を"],["早く","はやく"],["も"],["離れた","はなれた"],["ので"],["、"]]},{"verse":17,"text":"わたしはその二枚,まいの板,いたをつかんで、両手,りょうてから投,なげ出,だし、あなたがたの目,めの前,まえでこれを砕,くだいた。","tok":[["わたし"],["は"],["その"],["二枚","まい"],["の"],["板","いた"],["を"],["つかんで"],["、"],["両手","りょうて"],["から"],["投出","なげだ"],["し"],["、"],["あなた"],["がた"],["の"],["目","め"],["の"],["前","まえ"],["で"],["これ"],["を"],["砕いた","くだいた"],["。"]]},{"verse":18,"text":"そしてわたしは前,まえのように四十日,にち四十夜,や、主,しゅの前,まえにひれ伏,ふし、パンも食,たべず、水,みずも飲,のまなかった。これはあなたがたが主,しゅの目,めの前,まえに悪,あくをおこない、罪,つみを犯,おかして主,しゅを怒,いからせたすべての罪,つみによるのである。","tok":[["そして"],["わたし"],["は"],["前","まえ"],["の"],["よう"],["に"],["四十日","に"],["ち"],["四十","よんじゅう"],["夜","よる"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["ひれ伏し","ひれふし"],["、"],["パン"],["も"],["食べず","たべず"],["、"],["水","みず"],["も"],["飲まなかった","のまなかった"],["。"],["これ"],["は"],["あなた"],["がた"],["が"],["主","しゅ"],["の"],["目","め"],["の"],["前","まえ"],["に"],["悪","あく"],["を"],["おこない"],["、"],["罪","つみ"],["を"],["犯して","おかして"],["主","しゅ"],["を"],["怒らせた","いからせた"],["すべて"],["の"],["罪","つみ"],["に"],["よる"],["ので"],["ある"],["。"]]},{"verse":19,"text":"主,しゅは怒,いかりを発,はっし、憤,いきどおりを起,おこし、あなたがたを怒,いかって滅,ほろぼそうとされたので、わたしは恐,おそれたが、その時,ときもまた主,しゅはわたしの願,ねがいを聞,きかれた。","tok":[["主","しゅ"],["は"],["怒り","いかり"],["を"],["発し","はっし"],["、"],["憤り","いきどおり"],["を"],["起こし","おこし"],["、"],["あなた"],["がた"],["を"],["怒","い"],["か"],["って"],["滅ぼそう","ほろぼそう"],["と"],["された"],["ので"],["、"],["わたし"],["は"],["恐れた","おそれた"],["が"],["、"],["その"],["時","とき"],["も"],["また"],["主","しゅ"],["は"],["わたし"],["の"],["願い","ねがい"],["を"],["聞かれた","きかれた"],["。"]]},{"verse":20,"text":"主,しゅはまた、はなはだしくアロンを怒,いかって、彼,かれを滅,ほろぼそうとされたが、わたしはその時,ときもまたアロンのために祈,いのった。","tok":[["主","しゅ"],["は"],["また"],["、"],["はなはだしく"],["アロン"],["を"],["怒","い"],["か"],["って"],["、"],["彼","かれ"],["を"],["滅ぼそう","ほろぼそう"],["と"],["された"],["が"],["、"],["わたし"],["は"],["その"],["時","とき"],["も"],["また"],["アロン"],["の"],["ため"],["に"],["祈った","いのった"],["。"]]},{"verse":21,"text":"わたしはあなたがたが造,つくって罪,つみを得,えた子,こ牛,うしを取,とり、それを火,ひで焼,やき、それを撃,うち砕,くだき、よくひいて細,こまかいちりとし、そのちりを山,やまから流,ながれ下,くだる谷川,たにがわに投,なげ捨,すてた。","tok":[["わたし"],["は"],["あなた"],["がた"],["が"],["造って","つくって"],["罪","つみ"],["を"],["得た","えた"],["子牛","こうし"],["を"],["取","とり"],["、"],["それ"],["を"],["火","ひ"],["で"],["焼き","やき"],["、"],["それ"],["を"],["撃ち砕き","うちくだき"],["、"],["よく"],["ひいて"],["細かい","こまかい"],["ちり"],["と"],["し"],["、"],["その"],["ちり"],["を"],["山","やま"],["から"],["流れ下る","ながれくだる"],["谷川","たにがわ"],["に"],["投捨てた","なげすてた"],["。"]]},{"verse":22,"text":"あなたがたはタベラ、マッサおよびキブロテ・ハッタワにおいてもまた主,しゅを怒,いからせた。","tok":[["あなた"],["がた"],["は"],["タベラ"],["、"],["マッサ"],["および"],["キブロテ"],["・"],["ハッタワ"],["に"],["おいて"],["も"],["また"],["主","しゅ"],["を"],["怒らせた","いからせた"],["。"]]},{"verse":23,"text":"また主,しゅはカデシ・バルネアから、あなたがたをつかわそうとされた時,とき、『上,のぼって行,いって、わたしが与,あたえる地,ちを占領,せんりょうせよ』と言,いわれた。ところが、あなたがたはあなたがたの神,かみ、主,しゅの命令,めいれいにそむき、彼,かれを信,しんぜず、また彼,かれの声,こえに聞,きき従,したがわなかった。","tok":[["また"],["主","しゅ"],["は"],["カデシ"],["・"],["バルネア"],["から"],["、"],["あなた"],["がた"],["を"],["つかわそう"],["と"],["された"],["時","とき"],["、"],["『"],["上って","のぼって"],["行って","いって"],["、"],["わたし"],["が"],["与える","あたえる"],["地","ち"],["を"],["占領","せんりょう"],["せよ"],["』"],["と"],["言われた","いわれた"],["。"],["ところ"],["が"],["、"],["あなた"],["がた"],["は"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["命令","めいれい"],["に"],["そむき"],["、"],["彼","かれ"],["を"],["信ぜず","しんぜず"],["、"],["また"],["彼","かれ"],["の"],["声","こえ"],["に"],["聞","きき"],["従わなかった","したがわなかった"],["。"]]},{"verse":24,"text":"わたしがあなたがたを知,しったその日,ひからこのかた、あなたがたはいつも主,しゅにそむいた。","tok":[["わたし"],["が"],["あなた"],["がた"],["を"],["知った","しった"],["その"],["日","ひ"],["から"],["このかた"],["、"],["あなた"],["がた"],["は"],["いつも"],["主","しゅ"],["に"],["そむいた"],["。"]]},{"verse":25,"text":"そしてわたしは、さきにひれ伏,ふしたように、四十日,にち四十夜,や、主,しゅの前,まえにひれ伏,ふした。主,しゅがあなたがたを滅,ほろぼすと言,いわれたからである。","tok":[["そして"],["わたし"],["は"],["、"],["さき"],["に"],["ひれ伏した","ひれふした"],["よう"],["に"],["、"],["四十日","に"],["ち"],["四十","よんじゅう"],["夜","よる"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["ひれ伏した","ひれふした"],["。"],["主","しゅ"],["が"],["あなた"],["がた"],["を"],["滅ぼす","ほろぼす"],["と"],["言われた","いわれた"],["から"],["で"],["ある"],["。"]]},{"verse":26,"text":"わたしは主,しゅに祈,いのって言,いった、『主,しゅなる神,かみよ、あなたが大,おおいなる力,ちからをもってあがない、強,つよい手,てをもってエジプトから導,みちびき出,だされたあなたの民,たみ、あなたの嗣,し業,ぎょうを滅,ほろぼさないでください。","tok":[["わたし"],["は"],["主に","しゅに"],["祈って","いのって"],["言った","いった"],["、"],["『"],["主","しゅ"],["なる"],["神","かみ"],["よ"],["、"],["あなた"],["が"],["大いなる","おおいなる"],["力","ちから"],["を"],["もって"],["あがない"],["、"],["強い","つよい"],["手","て"],["を"],["もって"],["エジプト"],["から"],["導き出された","みちびきだされた"],["あなた"],["の"],["民","たみ"],["、"],["あなた"],["の"],["嗣業","しぎょう"],["を"],["滅ぼさないで","ほろぼさないで"],["ください"],["。"]]},{"verse":27,"text":"あなたのしもべアブラハム、イサク、ヤコブを覚,おぼえてください。この民,たみの強情,ごうじょうと悪,あくと罪,つみとに目,めをとめないでください。","tok":[["あなた"],["の"],["しもべ"],["アブラハム"],["、"],["イサク"],["、"],["ヤコブ"],["を"],["覚えて","おぼえて"],["ください"],["。"],["この"],["民","たみ"],["の"],["強情","ごうじょう"],["と"],["悪","あく"],["と"],["罪","つみ"],["と"],["に"],["目","め"],["を"],["とめないで"],["ください"],["。"]]},{"verse":28,"text":"あなたがわれわれを導,みちびき出,だされた国,くにの人,ひとはおそらく、「主,しゅは、約束,やくそくした地,ちに彼,かれらを導,みちびき入,いれることができず、また彼,かれらを憎,にくんだので、彼,かれらを導,みちびき出,だして荒野,あらので殺,ころしたのだ」と言,いうでしょう。","tok":[["あなた"],["が"],["われわれ"],["を"],["導き出された","みちびきだされた"],["国","くに"],["の"],["人","ひと"],["は"],["おそらく"],["、"],["「"],["主","しゅ"],["は"],["、"],["約束","やくそく"],["した"],["地","ち"],["に"],["彼","かれ"],["ら"],["を"],["導き入れる","みちびきいれる"],["こと"],["が"],["できず"],["、"],["また"],["彼","かれ"],["ら"],["を"],["憎","にくんだ"],["ので"],["、"],["彼","かれ"],["ら"],["を"],["導き出して","みちびきだして"],["荒野","あらの"],["で"],["殺ろした","ころした"],["の"],["だ"],["」"],["と"],["言うでしょう","いうでしょう"],["。"]]},{"verse":29,"text":"しかし彼,かれらは、あなたの民,たみ、あなたの嗣,し業,ぎょうであって、あなたが大,おおいなる力,ちからと伸,のばした腕,うでとをもって導,みちびき出,だされたのです』。","tok":[["しかし"],["彼","かれ"],["ら"],["は"],["、"],["あなた"],["の"],["民","たみ"],["、"],["あなた"],["の"],["嗣業","しぎょ"],["うで"],["あって"],["、"],["あなた"],["が"],["大いなる","おおいなる"],["力","ちから"],["と"],["伸ばした","のばした"],["腕","うで"],["と"],["を"],["もって"],["導き出された","みちびきだされた"],["の"],["です"],["』"],["。"]]}]
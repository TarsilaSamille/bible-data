[{"verse":1,"text":"これはヨルダンの向,むこうの荒野,あらの、パランと、トペル、ラバン、ハゼロテ、デザハブとの間,あいだの、スフの前,まえにあるアラバにおいて、モーセがイスラエルのすべての人,ひとに告,つげた言葉,ことばである。","tok":[["これ"],["は"],["ヨルダン"],["の"],["向こう","むこう"],["の"],["荒野","あら"],["の"],["、"],["パラン"],["と"],["、"],["トペル"],["、"],["ラバン"],["、"],["ハゼロテ"],["、"],["デザハブ"],["と"],["の"],["間","あいだ"],["の"],["、"],["スフ"],["の"],["前","まえ"],["に"],["ある"],["アラバ"],["に"],["おいて"],["、"],["モーセ"],["が"],["イスラエル"],["の"],["すべて"],["の"],["人","ひと"],["に"],["告","つげ"],["た"],["言葉","ことば"],["で"],["ある"],["。"]]},{"verse":2,"text":"ホレブからセイル山,やまの道,みちを経,へて、カデシ・バルネアに達,たっするには、十一日,にちの道,みちのりである。","tok":[["ホレブ"],["から"],["セイル山","せいるやま"],["の"],["道","みち"],["を"],["経て","へて"],["、"],["カデシ"],["・"],["バルネア"],["に"],["達する","たっする"],["に"],["は"],["、"],["十一","じゅういち"],["日","にち"],["の"],["道のり","みちのり"],["で"],["ある"],["。"]]},{"verse":3,"text":"第,だい四十年,ねんの十一月,がつとなり、その月,つきの一日,にちに、モーセはイスラエルの人々,ひとびとにむかって、主,しゅが彼,かれらのため彼,かれに授,さづけられた命令,めいれいを、ことごとく告,つげた。","tok":[["第","だい"],["四十","よんじゅう"],["年","ねん"],["の"],["十一","じゅういち"],["月","がつ"],["つ"],["と"],["なり"],["、"],["その"],["月","つき"],["の"],["一","いち"],["日","にち"],["に"],["、"],["モーセ"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["むかって"],["、"],["主","しゅ"],["が"],["彼","かれ"],["ら"],["の"],["ため"],["彼","かれ"],["に"],["授","さ"],["づけられた"],["命令","めいれい"],["を"],["、"],["ことごとく"],["告","つげ"],["た"],["。"]]},{"verse":4,"text":"これはモーセがヘシボンに住,すんでいたアモリびとの王,おうシホン、およびアシタロテとエデレイとに住,すんでいたバシャンの王,おうオグを殺,ころした後,のちであった。","tok":[["これ"],["は"],["モーセ"],["が"],["ヘシボン"],["に"],["住んで","すんで"],["いた"],["アモリ"],["びと"],["の"],["王","おう"],["シホン"],["、"],["および"],["アシタロテ"],["と"],["エデレイ"],["と"],["に"],["住んで","すんで"],["いた"],["バシャン"],["の"],["王","おう"],["オグ"],["を"],["殺ろした","ころした"],["後","の"],["ち"],["で"],["あった"],["。"]]},{"verse":5,"text":"すなわちモーセはヨルダンの向,むこうのモアブの地,ちで、みずから、この律法,りっぽうの説明,せつめいに当,あたった、そして言,いった、","tok":[["すなわち"],["モーセ"],["は"],["ヨルダン"],["の"],["向こう","むこう"],["の"],["モアブ"],["の"],["地","ち"],["で"],["、"],["みずから"],["、"],["この"],["律法","りっぽう"],["の"],["説明","せつめい"],["に"],["当たった","あたった"],["、"],["そして"],["言った","いった"],["、"]]},{"verse":6,"text":"「われわれの神,かみ、主,しゅはホレブにおいて、われわれに言,いわれた、『あなたがたはすでに久,ひさしく、この山,やまにとどまっていたが、","tok":[["「"],["われわれ"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["ホレブ"],["に"],["おいて"],["、"],["われわれ"],["に"],["言われた","いわれた"],["、"],["『"],["あなた"],["がた"],["は"],["すでに"],["久く","ひさしく"],["、"],["この"],["山","やま"],["に"],["とどまって"],["いた"],["が"],["、"]]},{"verse":7,"text":"身,みをめぐらして道,みちに進,すすみ、アモリびとの山地,さんちに行,いき、その近隣,きんりんのすべての所,ところ、アラバ、山地,さんち、低地,ていち、ネゲブ、海,うみべ、カナンびとの地,ち、またレバノンに行,いき、大川,おおかわユフラテにまで行,いきなさい。","tok":[["身","み"],["を"],["めぐらして"],["道","みち"],["に"],["進み","すすみ"],["、"],["アモリ"],["びと"],["の"],["山地","さんち"],["に"],["行き","いき"],["、"],["その"],["近隣","きんりん"],["の"],["すべて"],["の"],["所","ところ"],["、"],["アラバ"],["、"],["山地","さんち"],["、"],["低地","ていち"],["、"],["ネゲブ"],["、"],["海べ","うみべ"],["、"],["カナン"],["びと"],["の"],["地","ち"],["、"],["また"],["レバノン"],["に"],["行き","いき"],["、"],["大川","おおかわ"],["ユフラテ"],["に"],["まで"],["行き","いき"],["なさい"],["。"]]},{"verse":8,"text":"見,みよ、わたしはこの地,ちをあなたがたの前,まえに置,おいた。この地,ちにはいって、それを自分,じぶんのものとしなさい。これは主,しゅが、あなたがたの先祖,せんぞアブラハム、イサク、ヤコブに誓,ちかって、彼,かれらとその後,のちの子孫,しそんに与,あたえると言,いわれた所,ところである』。","tok":[["見よ","みよ"],["、"],["わたし"],["は"],["この"],["地","ち"],["を"],["あなた"],["がた"],["の"],["前","まえ"],["に"],["置いた","おいた"],["。"],["この"],["地","ち"],["に"],["はいって"],["、"],["それ"],["を"],["自分","じぶん"],["の"],["もの"],["と"],["し"],["なさい"],["。"],["これ"],["は"],["主","しゅ"],["が"],["、"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["アブラハム"],["、"],["イサク"],["、"],["ヤコブ"],["に"],["誓って","ちかって"],["、"],["彼","かれ"],["ら"],["と"],["その後","そののち"],["の"],["子孫","しそん"],["に"],["与える","あたえる"],["と"],["言われた","いわれた"],["所","ところ"],["で"],["ある"],["』"],["。"]]},{"verse":9,"text":"あの時,とき、わたしはあなたがたに言,いった、『わたしはひとりであなたがたを負,おうことができない。","tok":[["あの"],["時","とき"],["、"],["わたし"],["は"],["あなた"],["がた"],["に"],["言った","いった"],["、"],["『"],["わたし"],["は"],["ひとり"],["で"],["あなた"],["がた"],["を"],["負う","おう"],["こと"],["が"],["できない"],["。"]]},{"verse":10,"text":"あなたがたの神,かみ、主,しゅはあなたがたを多,おおくされたので、あなたがたは、きょう、空,そらの星,ほしのように多,おおい。","tok":[["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["あなた"],["がた"],["を"],["多く","おおく"],["された"],["ので"],["、"],["あなた"],["がた"],["は"],["、"],["きょう"],["、"],["空","そら"],["の"],["星","ほし"],["の"],["よう"],["に"],["多い","おおい"],["。"]]},{"verse":11,"text":"――どうぞ、あなたがたの先祖,せんぞの神,かみ、主,しゅがあなたがたを、今,いまあるより千倍,ばいも多,おおくし、またあなたがたに約束,やくそくされたように、あなたがたを恵,めぐんでくださるように。――","tok":[["―"],["―"],["どうぞ"],["、"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["あなた"],["がた"],["を"],["、"],["今","いま"],["ある"],["より"],["千","せん"],["倍","ばい"],["も"],["多く","おおく"],["し"],["、"],["また"],["あなた"],["がた"],["に"],["約束","やくそく"],["された"],["よう"],["に"],["、"],["あなた"],["がた"],["を"],["恵んで","めぐんで"],["くださる"],["よう"],["に"],["。"],["―"],["―"]]},{"verse":12,"text":"わたしひとりで、どうして、あなたがたを負,おい、あなたがたの重荷,おもにと、あなたがたの争,あらそいを処理,しょりすることができようか。","tok":[["わたし"],["ひとり"],["で"],["、"],["どう"],["して"],["、"],["あなた"],["がた"],["を"],["負い","おい"],["、"],["あなた"],["がた"],["の"],["重荷","おもに"],["と"],["、"],["あなた"],["がた"],["の"],["争い","あらそい"],["を"],["処理","しょり"],["する"],["こと"],["が"],["できよう"],["か"],["。"]]},{"verse":13,"text":"あなたがたは、おのおの部族,ぶぞくごとに、知恵,ちえがあり、知識,ちしきがあって、人,ひとに知,しられている人々,ひとびとを選,えらび出,だしなさい。わたしはその人々,ひとびとを、あなたがたのかしらとするであろう』。","tok":[["あなた"],["がた"],["は"],["、"],["おのおの"],["部族","ぶぞく"],["ごと"],["に"],["、"],["知恵","ちえ"],["が"],["あり"],["、"],["知識","ちしき"],["が"],["あって"],["、"],["人","ひと"],["に"],["知られて","しられて"],["いる"],["人々","ひとびと"],["を"],["選ら","えら"],["び"],["出し","だし"],["なさい"],["。"],["わたし"],["は"],["その"],["人々","ひとびと"],["を"],["、"],["あなた"],["がた"],["の"],["かしら"],["と"],["するで"],["あろう"],["』"],["。"]]},{"verse":14,"text":"その時,とき、あなたがたはわたしに答,こたえた、『あなたがしようと言,いわれることは良,よいことです』。","tok":[["その"],["時","とき"],["、"],["あなた"],["がた"],["は"],["わたし"],["に"],["答","こたえ"],["た"],["、"],["『"],["あなた"],["が"],["しよう"],["と"],["言われる","いわれる"],["こと"],["は"],["良い","よい"],["こと"],["です"],["』"],["。"]]},{"verse":15,"text":"そこで、わたしは、あなたがたのうちから、知恵,ちえがあり、人,ひとに知,しられている人々,ひとびとを取,とって、あなたがたのかしらとした。すなわち千人,にんの長,ちょう、百人,にんの長,ちょう、五十人,にんの長,ちょう、十人,にんの長,ちょうとし、また、あなたがたの部族,ぶぞくのつかさびととした。","tok":[["そこ"],["で"],["、"],["わたし"],["は"],["、"],["あなた"],["がた"],["の"],["うち"],["から"],["、"],["知恵","ちえ"],["が"],["あり"],["、"],["人","ひと"],["に"],["知られて","しられて"],["いる"],["人々","ひとびと"],["を"],["取って","とって"],["、"],["あなた"],["がた"],["の"],["かしら"],["と"],["した"],["。"],["すなわち"],["千人","にん"],["の"],["長う","ちょう"],["、"],["百人","にん"],["の"],["長う","ちょう"],["、"],["五","ご"],["十人","じゅうにん"],["の"],["長う","ちょう"],["、"],["十人","にん"],["の"],["長","ちょう"],["と"],["し"],["、"],["また"],["、"],["あなた"],["がた"],["の"],["部族","ぶぞく"],["の"],["つかさ"],["びと"],["と"],["した"],["。"]]},{"verse":16,"text":"また、あのとき、わたしはあなたがたのさばきびとたちに命,めいじて言,いった、『あなたがたは、兄弟,きょうだいたちの間,あいだの訴,うったえを聞,きき、人,ひととその兄弟,きょうだい、または寄留,きりゅうの他国,たこく人,じんとの間,あいだを、正,ただしくさばかなければならない。","tok":[["また"],["、"],["あの"],["とき"],["、"],["わたし"],["は"],["あなた"],["がた"],["の"],["さばき"],["びと"],["たち"],["に"],["命じて","めいじて"],["言った","いった"],["、"],["『"],["あなた"],["がた"],["は"],["、"],["兄弟","きょうだい"],["たち"],["の"],["間","あいだ"],["の"],["訴","うったえ"],["を"],["聞","きき"],["、"],["人","ひと"],["と"],["その"],["兄弟","きょうだい"],["、"],["また"],["は"],["寄留","きりゅう"],["の"],["他国人","たこくじんと"],["の"],["間","あいだ"],["を"],["、"],["正く","ただしく"],["さばかなければ"],["ならない"],["。"]]},{"verse":17,"text":"あなたがたは、さばきをする時,とき、人,ひとを片寄,かたより見,みてはならない。小,ちいさい者,ものにも大,おおいなる者,ものにも聞,きかなければならない。人,ひとの顔,かおを恐,おそれてはならない。さばきは神,かみの事,ことだからである。あなたがたで決,きめるのにむずかしい事,ことは、わたしのところに持,もってこなければならない。わたしはそれを聞,きくであろう』。","tok":[["あなた"],["がた"],["は"],["、"],["さばき"],["を"],["する"],["時","とき"],["、"],["人","ひと"],["を"],["片寄り","かたより"],["見て","みて"],["は"],["ならない"],["。"],["小さい","ちいさい"],["者","もの"],["に"],["も"],["大いなる","おおいなる"],["者","もの"],["に"],["も"],["聞かなければ","きかなければ"],["ならない"],["。"],["人","ひと"],["の"],["顔","かお"],["を"],["恐れて","おそれて"],["は"],["ならない"],["。"],["さばき"],["は"],["神","かみ"],["の"],["事","こと"],["だ"],["から"],["で"],["ある"],["。"],["あなた"],["がた"],["で"],["決める","きめる"],["のに"],["むずかしい"],["事","こと"],["は"],["、"],["わたし"],["の"],["ところ"],["に"],["持って","もって"],["こなければ"],["ならない"],["。"],["わたし"],["は"],["それ"],["を"],["聞くで","きくで"],["あろう"],["』"],["。"]]},{"verse":18,"text":"わたしはまた、あの時,とき、あなたがたがしなければならないことを、ことごとく命,めいじた。","tok":[["わたし"],["は"],["また"],["、"],["あの"],["時","とき"],["、"],["あなた"],["がた"],["が"],["しなければ"],["ならない"],["こと"],["を"],["、"],["ことごとく"],["命じた","めいじた"],["。"]]},{"verse":19,"text":"われわれの神,かみ、主,しゅが命,めいじられたように、われわれは、ホレブを出立,しゅったつして、あなたがたが見,みた、あの大,おおきな恐,おそろしい荒野,あらのを通,とおり、アモリびとの山地,さんちへ行,ゆく道,みちによって、カデシ・バルネアにきた。","tok":[["われわれ"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["命じられた","めいじられた"],["よう"],["に"],["、"],["われわれ"],["は"],["、"],["ホレブ"],["を"],["出立","しゅったつ"],["して"],["、"],["あなた"],["がた"],["が"],["見た","みた"],["、"],["あの"],["大きな","おおきな"],["恐ろしい","おそろしい"],["荒野","あらの"],["を"],["通り","とおり"],["、"],["アモリ"],["びと"],["の"],["山地","さんち"],["へ"],["行く","ゆく"],["道","みち"],["によって"],["、"],["カデシ"],["・"],["バルネア"],["に"],["きた"],["。"]]},{"verse":20,"text":"その時,ときわたしはあなたがたに言,いった、『あなたがたは、われわれの神,かみ、主,しゅがお与,あたえになるアモリびとの山地,さんちに着,ついた。","tok":[["その"],["時","とき"],["わたし"],["は"],["あなた"],["がた"],["に"],["言った","いった"],["、"],["『"],["あなた"],["がた"],["は"],["、"],["われわれ"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["お"],["与","あたえ"],["に"],["なる"],["アモリ"],["びと"],["の"],["山地","さんち"],["に"],["着いた","ついた"],["。"]]},{"verse":21,"text":"見,みよ、あなたの神,かみ、主,しゅはこの地,ちをあなたの前,まえに置,おかれた。あなたの先祖,せんぞの神,かみ、主,しゅが告,つげられたように、上,のぼって行,いって、これを自分,じぶんのものとしなさい。恐,おそれてはならない。おののいてはならない』。","tok":[["見よ","みよ"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["この"],["地","ち"],["を"],["あなた"],["の"],["前","まえ"],["に"],["置かれた","おかれた"],["。"],["あなた"],["の"],["先祖","せんぞ"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["告げられた","つげられた"],["よう"],["に"],["、"],["上って","のぼって"],["行って","いって"],["、"],["これ"],["を"],["自分","じぶん"],["の"],["もの"],["と"],["し"],["なさい"],["。"],["恐れて","おそれて"],["は"],["ならない"],["。"],["おののいて"],["は"],["ならない"],["』"],["。"]]},{"verse":22,"text":"あなたがたは皆,みなわたしに近寄,ちかよって言,いった、『われわれは人,ひとをさきにつかわして、その地,ちを探,さぐらせ、どの道,みちから上,のぼるべきか、どの町々,まちまちに入,いるべきかを、復命,ふくめいさせましょう』。","tok":[["あなた"],["がた"],["は"],["皆","みな"],["わたし"],["に"],["近寄って","ちかよって"],["言った","いった"],["、"],["『"],["われわれ"],["は"],["人","ひと"],["を"],["さき"],["に"],["つかわして"],["、"],["その"],["地","ち"],["を"],["探ぐらせ","さぐらせ"],["、"],["どの"],["道","みち"],["から"],["上るべき","のぼるべき"],["か"],["、"],["どの"],["町々","まちまち"],["に"],["入べき","いるべき"],["か"],["を"],["、"],["復命","ふくめい"],["させましょう"],["』"],["。"]]},{"verse":23,"text":"このことは良,よいと思,おもったので、わたしはあなたがたのうち、おのおのの部族,ぶぞくから、ひとりずつ十二人,にんの者,ものを選,えらんだ。","tok":[["この"],["こと"],["は"],["良い","よい"],["と"],["思った","おもった"],["ので"],["、"],["わたし"],["は"],["あなた"],["がた"],["の"],["うち"],["、"],["おのおの"],["の"],["部族","ぶぞく"],["から"],["、"],["ひとり"],["ずつ"],["十二人","にん"],["の"],["者","もの"],["を"],["選らんだ","えらんだ"],["。"]]},{"verse":24,"text":"彼,かれらは身,みをめぐらして、山地,さんちに上,のぼって行,いき、エシコルの谷,たにへ行,いってそれを探,さぐり、","tok":[["彼","かれ"],["ら"],["は"],["身","み"],["を"],["めぐらして"],["、"],["山地","さんち"],["に"],["上って","のぼって"],["行き","いき"],["、"],["エシコル"],["の"],["谷","たに"],["へ"],["行って","いって"],["それ"],["を"],["探ぐり","さぐり"],["、"]]},{"verse":25,"text":"その地,ちのくだものを手,てに取,とって、われわれのところに持,もって下,くだり、復命,ふくめいして言,いった、『われわれの神,かみ、主,しゅが賜,たまわる地,ちは良,よい地,ちです』。","tok":[["その"],["地","ち"],["の"],["くだもの"],["を"],["手","て"],["に"],["取って","とって"],["、"],["われわれ"],["の"],["ところ"],["に"],["持って","もって"],["下り","くだり"],["、"],["復命","ふくめい"],["して"],["言った","いった"],["、"],["『"],["われわれ"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["賜わる","たまわる"],["地","ち"],["は"],["良い","よい"],["地","ち"],["です"],["』"],["。"]]},{"verse":26,"text":"しかし、あなたがたは上,のぼって行,いくことを好,このまないで、あなたがたの神,かみ、主,しゅの命令,めいれいにそむいた。","tok":[["しかし"],["、"],["あなた"],["がた"],["は"],["上って","のぼって"],["行く","いく"],["こと"],["を"],["好まないで","このまないで"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["命令","めいれい"],["に"],["そむいた"],["。"]]},{"verse":27,"text":"そして天幕,てんまくでつぶやいて言,いった。『主,しゅはわれわれを憎,にくんでアモリびとの手,てに渡,わたし、滅,ほろぼそうとしてエジプトの国,くにから導,みちびき出,だされたのだ。","tok":[["そして"],["天幕","てんまく"],["で"],["つぶやいて"],["言った","いった"],["。"],["『"],["主","しゅ"],["は"],["われわれ"],["を"],["憎んで","にくんで"],["アモリ"],["びと"],["の"],["手","て"],["に"],["渡","わたし"],["、"],["滅ぼそう","ほろぼそう"],["として"],["エジプト"],["の"],["国","くに"],["から"],["導き出された","みちびきだされた"],["の"],["だ"],["。"]]},{"verse":28,"text":"われわれはどこへ上,のぼって行,いくのか。兄弟,きょうだいたちは、「その民,たみはわれわれよりも大,おおきくて、背,せも高,たかい。町々,まちまちは大,おおきく、その石,いしがきは天,てんに届,とどいている。われわれは、またアナクびとの子孫,しそんをその所,ところで見,みた」と言,いって、われわれの心,こころをくじいた』。","tok":[["われわれ"],["は"],["どこ"],["へ"],["上って","のぼって"],["行く","いく"],["の"],["か"],["。"],["兄弟","きょうだい"],["たち"],["は"],["、"],["「"],["その"],["民","たみ"],["は"],["われわれ"],["より"],["も"],["大きくて","おおきくて"],["、"],["背","せ"],["も"],["高かい","たかい"],["。"],["町々","まちまち"],["は"],["大きく","おおきく"],["、"],["その"],["石がき","いしがき"],["は"],["天","てん"],["に"],["届いて","とどいて"],["いる"],["。"],["われわれ"],["は"],["、"],["また"],["アナク"],["びと"],["の"],["子孫","しそん"],["を"],["その"],["所","ところ"],["で"],["見た","みた"],["」"],["と"],["言って","いって"],["、"],["われわれ"],["の"],["心","こころ"],["を"],["くじいた"],["』"],["。"]]},{"verse":29,"text":"その時,とき、わたしはあなたがたに言,いった、『彼,かれらをこわがってはならない。また恐,おそれてはならない。","tok":[["その"],["時","とき"],["、"],["わたし"],["は"],["あなた"],["がた"],["に"],["言った","いった"],["、"],["『"],["彼","かれ"],["ら"],["を"],["こわ"],["がっ"],["て"],["は"],["ならない"],["。"],["また"],["恐れて","おそれて"],["は"],["ならない"],["。"]]},{"verse":30,"text":"先,さきに立,たって行,いかれるあなたがたの神,かみ、主,しゅはエジプトにおいて、あなたがたの目,めの前,まえで、すべてのことを行,おこなわれたように、あなたがたのために戦,たたかわれるであろう。","tok":[["先","さき"],["に"],["立って","たって"],["行かれる","いかれる"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["エジプト"],["に"],["おいて"],["、"],["あなた"],["がた"],["の"],["目","め"],["の"],["前","まえ"],["で"],["、"],["すべて"],["の"],["こと"],["を"],["行なわれた","おこなわれた"],["よう"],["に"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["戦われるで","たたかわれるで"],["あろう"],["。"]]},{"verse":31,"text":"あなたがたはまた荒野,あらので、あなたの神,かみ、主,しゅが、人,ひとのその子,こを抱,だくように、あなたを抱,だかれるのを見,みた。あなたがたが、この所,ところに来,くるまで、その道,みちすがら、いつもそうであった』。","tok":[["あなた"],["がた"],["は"],["また"],["荒野","あらの"],["で"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["、"],["人","ひと"],["の"],["その"],["子","こ"],["を"],["抱","だくよう"],["に"],["、"],["あなた"],["を"],["抱","だかれる"],["の"],["を"],["見た","みた"],["。"],["あなた"],["が"],["た"],["が"],["、"],["この"],["所","ところ"],["に"],["来る","くる"],["まで"],["、"],["その"],["道すがら","みちすがら"],["、"],["いつも"],["そう"],["で"],["あった"],["』"],["。"]]},{"verse":32,"text":"このように言,いっても、あなたがたはなお、あなたがたの神,かみ、主,しゅを信,しんじなかった。","tok":[["この"],["よう"],["に"],["言って","いって"],["も"],["、"],["あなた"],["がた"],["は"],["なお"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["を"],["信じなかった","しんじなかった"],["。"]]},{"verse":33,"text":"主,しゅは道,みち々あなたがたの先,さきに立,たって行,いき、あなたがたが宿営,しゅくえいする場所,ばしょを捜,さがし、夜,よるは火,ひのうちにあり、昼,ひるは雲,くものうちにあって、あなたがたに行,ゆくべき道,みちを示,しめされた。","tok":[["主","しゅ"],["は"],["道々","みち々"],["あなた"],["がた"],["の"],["先","さき"],["に"],["立って","たって"],["行き","いき"],["、"],["あなた"],["がた"],["が"],["宿営","しゅくえい"],["する"],["場所","ばしょ"],["を"],["捜し","さがし"],["、"],["夜","よる"],["は"],["火","ひ"],["の"],["うち"],["に"],["あり"],["、"],["昼","ひる"],["は"],["雲","くも"],["の"],["うち"],["に"],["あって"],["、"],["あなた"],["がた"],["に"],["行くべき","ゆくべき"],["道","みち"],["を"],["示めされた","しめされた"],["。"]]},{"verse":34,"text":"主,しゅは、あなたがたの言葉,ことばを聞,きいて怒,いかり、誓,ちかって言,いわれた、","tok":[["主","しゅ"],["は"],["、"],["あなた"],["がた"],["の"],["言葉","ことば"],["を"],["聞いて","きいて"],["怒り","いかり"],["、"],["誓って","ちかって"],["言われた","いわれた"],["、"]]},{"verse":35,"text":"『この悪,わるい世代,せだいの人々,ひとびとのうちには、わたしが、あなたがたの先祖,せんぞたちに与,あたえると誓,ちかったあの良,よい地,ちを見,みる者,ものは、ひとりもないであろう。","tok":[["『"],["この"],["悪い","わるい"],["世代","せだい"],["の"],["人々","ひとびと"],["の"],["うち"],["に"],["は"],["、"],["わたし"],["が"],["、"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["たち"],["に"],["与える","あたえる"],["と"],["誓った","ちかった"],["あの"],["良い","よい"],["地","ち"],["を"],["見る","みる"],["者","もの"],["は"],["、"],["ひとり"],["も"],["ないで"],["あろう"],["。"]]},{"verse":36,"text":"ただエフンネの子,こカレブだけはそれを見,みることができるであろう。彼,かれが踏,ふんだ地,ちを、わたしは彼,かれとその子孫,しそんに与,あたえるであろう。彼,かれが全,まったく主,しゅに従,したがったからである』。","tok":[["ただ"],["エフンネ"],["の"],["子","こ"],["カレブ"],["だけ"],["は"],["それ"],["を"],["見る","みる"],["こと"],["が"],["できるで"],["あろう"],["。"],["彼","かれ"],["が"],["踏んだ","ふんだ"],["地","ち"],["を"],["、"],["わたし"],["は"],["彼","かれ"],["と"],["その"],["子孫","しそん"],["に"],["与えるで","あたえるで"],["あろう"],["。"],["彼","かれ"],["が"],["全く","まったく"],["主に","しゅに"],["従った","したがった"],["から"],["で"],["ある"],["』"],["。"]]},{"verse":37,"text":"主,しゅはまた、あなたがたのゆえに、わたしをも怒,いかって言,いわれた、『おまえもまた、そこにはいることができないであろう。","tok":[["主","しゅ"],["は"],["また"],["、"],["あなた"],["がた"],["の"],["ゆえ"],["に"],["、"],["わたし"],["を"],["も"],["怒","い"],["か"],["って"],["言われた","いわれた"],["、"],["『"],["おまえ"],["も"],["また"],["、"],["そこ"],["に"],["はいる"],["こと"],["が"],["できないで"],["あろう"],["。"]]},{"verse":38,"text":"おまえに仕,つかえているヌンの子,こヨシュアが、そこにはいるであろう。彼,かれを力,ちからづけよ。彼,かれはイスラエルにそれを獲,えさせるであろう。","tok":[["おまえ"],["に"],["仕えて","つかえて"],["いる"],["ヌン"],["の"],["子","こ"],["ヨシュア"],["が"],["、"],["そこ"],["に"],["はいるで"],["あろう"],["。"],["彼","かれ"],["を"],["力づけよ","ちからづけよ"],["。"],["彼","かれ"],["は"],["イスラエル"],["に"],["それ"],["を"],["獲させるで","えさせるで"],["あろう"],["。"]]},{"verse":39,"text":"またあなたがたが、かすめられるであろうと言,いったあなたがたのおさなごたち、およびその日,ひにまだ善悪,ぜんあくをわきまえないあなたがたの子供,こどもたちが、そこにはいるであろう。わたしはそれを彼,かれらに与,あたえる。彼,かれらはそれを所有,しょゆうとするであろう。","tok":[["また"],["あなた"],["が"],["た"],["が"],["、"],["かすめられるで"],["あろう"],["と"],["言った","いった"],["あなた"],["がた"],["の"],["おさな"],["ご"],["たち"],["、"],["および"],["その"],["日","ひ"],["に"],["まだ"],["善悪","ぜんあく"],["を"],["わきまえない"],["あなた"],["がた"],["の"],["子供","こども"],["たち"],["が"],["、"],["そこ"],["に"],["はいるで"],["あろう"],["。"],["わたし"],["は"],["それ"],["を"],["彼","かれ"],["ら"],["に"],["与える","あたえる"],["。"],["彼","かれ"],["ら"],["は"],["それ"],["を"],["所有","しょゆう"],["と"],["するで"],["あろう"],["。"]]},{"verse":40,"text":"あなたがたは身,みをめぐらし、紅海,こうかいの道,みちによって、荒野,あらのに進,すすんで行,いきなさい』。","tok":[["あなた"],["がた"],["は"],["身","み"],["を"],["めぐらし"],["、"],["紅海","こうかい"],["の"],["道","みち"],["によって"],["、"],["荒野","あら"],["のに"],["進んで","すすんで"],["行き","いき"],["なさい"],["』"],["。"]]},{"verse":41,"text":"しかし、あなたがたはわたしに答,こたえて言,いった、『われわれは主,しゅにむかって罪,つみを犯,おかしました。われわれの神,かみ、主,しゅが命,めいじられたように、われわれは上,のぼって行,いって戦,たたかいましょう』。そして、おのおの武器,ぶきを身,みに帯,おびて、かるがるしく山地,さんちへ上,のぼって行,いこうとした。","tok":[["しかし"],["、"],["あなた"],["がた"],["は"],["わたし"],["に"],["答","こたえ"],["て"],["言った","いった"],["、"],["『"],["われわれ"],["は"],["主に","しゅに"],["むかって"],["罪","つみ"],["を"],["犯しました","おかしました"],["。"],["われわれ"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["命じられた","めいじられた"],["よう"],["に"],["、"],["われわれ"],["は"],["上って","のぼって"],["行って","いって"],["戦いましょう","たたかいましょう"],["』"],["。"],["そして"],["、"],["おのおの"],["武器","ぶき"],["を"],["身","み"],["に"],["帯","おび"],["て"],["、"],["かるがるしく"],["山地","さんち"],["へ"],["上って","のぼって"],["行こう","いこう"],["と"],["した"],["。"]]},{"verse":42,"text":"その時,とき、主,しゅはわたしに言,いわれた、『彼,かれらに言,いいなさい、「あなたがたは上,のぼって行,いってはならない。また戦,たたかってはならない。わたしはあなたがたのうちにいない。おそらく、あなたがたは敵,てきに撃,うち敗,やぶられるであろう」』。","tok":[["その"],["時","とき"],["、"],["主","しゅ"],["は"],["わたし"],["に"],["言われた","いわれた"],["、"],["『"],["彼","かれ"],["ら"],["に"],["言い","いい"],["なさい"],["、"],["「"],["あなた"],["がた"],["は"],["上って","のぼって"],["行って","いって"],["は"],["ならない"],["。"],["また"],["戦って","たたかって"],["は"],["ならない"],["。"],["わたし"],["は"],["あなた"],["がた"],["の"],["うち"],["に"],["いない"],["。"],["おそらく"],["、"],["あなた"],["がた"],["は"],["敵","てき"],["に"],["撃ち","うち"],["敗られるで","やぶられるで"],["あろう"],["」"],["』"],["。"]]},{"verse":43,"text":"このようにわたしが告,つげたのに、あなたがたは聞,きかないで主,しゅの命令,めいれいにそむき、ほしいままに山地,さんちへ上,のぼって行,いったが、","tok":[["この"],["よう"],["に"],["わたし"],["が"],["告","つげ"],["た"],["のに"],["、"],["あなた"],["がた"],["は"],["聞かないで","きかないで"],["主","しゅ"],["の"],["命令","めいれい"],["に"],["そむき"],["、"],["ほしいまま"],["に"],["山地","さんち"],["へ"],["上って","のぼって"],["行った","いった"],["が"],["、"]]},{"verse":44,"text":"その山地,さんちに住,すんでいるアモリびとが、あなたがたに向,むかって出,でてきて、はちが追,おうように、あなたがたを追,おいかけ、セイルで撃,うち敗,やぶって、ホルマにまで及,およんだ。","tok":[["その"],["山地","さんち"],["に"],["住んで","すんで"],["いる"],["アモリ"],["びと"],["が"],["、"],["あなた"],["がた"],["に"],["向かって","むかって"],["出て","でて"],["きて"],["、"],["はち"],["が"],["追う","おう"],["よう"],["に"],["、"],["あなた"],["がた"],["を"],["追いかけ","おいかけ"],["、"],["セイル"],["で"],["撃ち","うち"],["敗って","やぶって"],["、"],["ホルマ"],["に"],["まで"],["及んだ","およんだ"],["。"]]},{"verse":45,"text":"あなたがたは帰,かえってきて、主,しゅの前,まえで泣,ないたが、主,しゅはあなたがたの声,こえを聞,きかず、あなたがたに耳,みみを傾,かたむけられなかった。","tok":[["あなた"],["がた"],["は"],["帰えって","かえって"],["きて"],["、"],["主","しゅ"],["の"],["前","まえ"],["で"],["泣いた","ないた"],["が"],["、"],["主","しゅ"],["は"],["あなた"],["がた"],["の"],["声","こえ"],["を"],["聞かず","きかず"],["、"],["あなた"],["がた"],["に"],["耳","みみ"],["を"],["傾むけられなかった","かたむけられなかった"],["。"]]},{"verse":46,"text":"こうしてあなたがたは、日,ひ久,ひさしくカデシにとどまった。あなたがたのそこにとどまった日数,にっすうのとおりである。","tok":[["こう"],["して"],["あなた"],["がた"],["は"],["、"],["日","ひ"],["久く","ひさしく"],["カデシ"],["に"],["とどまった"],["。"],["あなた"],["がた"],["の"],["そこ"],["に"],["とどまった"],["日数","にっすう"],["の"],["とおり"],["で"],["ある"],["。"]]}]
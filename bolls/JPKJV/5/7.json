[{"verse":1,"text":"あなたの神,かみ、主,しゅが、あなたの行,いって取,とる地,ちにあなたを導,みちびき入,いれ、多,おおくの国々,くにぐにの民,たみ、ヘテびと、ギルガシびと、アモリびと、カナンびと、ペリジびと、ヒビびと、およびエブスびと、すなわちあなたよりも数多,かずおおく、また力,ちからのある七つの民,たみを、あなたの前,まえから追,おいはらわれる時,とき、","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["、"],["あなた"],["の"],["行って","いって"],["取る","とる"],["地","ち"],["に"],["あなた"],["を"],["導き入れ","みちびきいれ"],["、"],["多く","おおく"],["の"],["国々","くにぐに"],["の"],["民","たみ"],["、"],["ヘテ"],["び"],["と"],["、"],["ギルガシ"],["び"],["と"],["、"],["アモリ"],["び"],["と"],["、"],["カナン"],["び"],["と"],["、"],["ペリジ"],["び"],["と"],["、"],["ヒビ"],["び"],["と"],["、"],["および"],["エブス"],["び"],["と"],["、"],["すなわち"],["あなた"],["より"],["も"],["数多く","かずおおく"],["、"],["また"],["力","ちから"],["の"],["ある"],["七","なな"],["つ"],["の"],["民","たみ"],["を"],["、"],["あなた"],["の"],["前","まえ"],["から"],["追いはらわれる","おいはらわれる"],["時","とき"],["、"]]},{"verse":2,"text":"すなわちあなたの神,かみ、主,しゅが彼,かれらをあなたに渡,わたして、これを撃,うたせられる時,ときは、あなたは彼,かれらを全,まったく滅,ほろぼさなければならない。彼,かれらとなんの契約,けいやくをもしてはならない。彼,かれらに何,なにのあわれみをも示,しめしてはならない。","tok":[["すなわち"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["彼","かれ"],["ら"],["を"],["あなた"],["に"],["渡","わたし"],["て"],["、"],["これ"],["を"],["撃たせられる","うたせられる"],["時","とき"],["は"],["、"],["あなた"],["は"],["彼","かれ"],["ら"],["を"],["全く","まったく"],["滅ぼさなければ","ほろぼさなければ"],["ならない"],["。"],["彼","かれ"],["ら"],["と"],["なん"],["の"],["契約","けいやく"],["を"],["も"],["して"],["は"],["ならない"],["。"],["彼","かれ"],["ら"],["に"],["何に","なに"],["の"],["あわれみ"],["を"],["も"],["示めして","しめして"],["は"],["ならない"],["。"]]},{"verse":3,"text":"また彼,かれらと婚姻,こんいんをしてはならない。あなたの娘,むすめを彼,かれのむすこに与,あたえてはならない。かれの娘,むすめをあなたのむすこにめとってはならない。","tok":[["また"],["彼","かれ"],["ら"],["と"],["婚姻","こんいん"],["を"],["して"],["は"],["ならない"],["。"],["あなた"],["の"],["娘","むすめ"],["を"],["彼","かれ"],["の"],["むすこ"],["に"],["与","あたえ"],["ては"],["ならない"],["。"],["かれ"],["の"],["娘","むすめ"],["を"],["あなた"],["の"],["むすこ"],["に"],["めとって"],["は"],["ならない"],["。"]]},{"verse":4,"text":"それは彼,かれらがあなたのむすこを惑,まどわしてわたしに従,したがわせず、ほかの神々,かみがみに仕,つかえさせ、そのため主,しゅはあなたがたにむかって怒,いかりを発,はっし、すみやかにあなたがたを滅,ほろぼされることとなるからである。","tok":[["それ"],["は"],["彼","かれ"],["ら"],["が"],["あなた"],["の"],["むすこ"],["を"],["惑わして","まどわして"],["わたし"],["に"],["従わせず","したがわせず"],["、"],["ほか"],["の"],["神々","かみがみ"],["に"],["仕えさせ","つかえさせ"],["、"],["その"],["ため"],["主","しゅ"],["は"],["あなた"],["がた"],["に"],["むかって"],["怒り","いかり"],["を"],["発し","はっし"],["、"],["すみやか"],["に"],["あなた"],["がた"],["を"],["滅ぼされる","ほろぼされる"],["こと"],["と"],["なる"],["から"],["で"],["ある"],["。"]]},{"verse":5,"text":"むしろ、あなたがたはこのように彼,かれらに行,おこなわなければならない。すなわち彼,かれらの祭壇,さいだんをこぼち、その石,いしの柱,はしらを撃,うち砕,くだき、そのアシラ像,ぞうを切,きり倒,たおし、その刻,きざんだ像,ぞうを火,ひで焼,やかなければならない。","tok":[["むしろ"],["、"],["あなた"],["がた"],["は"],["この"],["よう"],["に"],["彼","かれ"],["ら"],["に"],["行なわなければ","おこなわなければ"],["ならない"],["。"],["すなわち"],["彼","かれ"],["ら"],["の"],["祭壇","さいだん"],["を"],["こ"],["ぼ"],["ち"],["、"],["その"],["石","いし"],["の"],["柱","はしら"],["を"],["撃ち砕き","うちくだき"],["、"],["その"],["アシラ"],["像","ぞう"],["を"],["切り倒し","きりたおし"],["、"],["その"],["刻んだ","きざんだ"],["像","ぞう"],["を"],["火","ひ"],["で"],["焼かなければ","やかなければ"],["ならない"],["。"]]},{"verse":6,"text":"あなたはあなたの神,かみ、主,しゅの聖,せいなる民,たみである。あなたの神,かみ、主,しゅは地,ちのおもてのすべての民,たみのうちからあなたを選,えらんで、自分,じぶんの宝,たからの民,たみとされた。","tok":[["あなた"],["は"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["聖","せい"],["なる"],["民","たみ"],["で"],["ある"],["。"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["地","ち"],["の"],["おもて"],["の"],["すべて"],["の"],["民","たみ"],["の"],["うち"],["から"],["あなた"],["を"],["選らんで","えらんで"],["、"],["自分","じぶん"],["の"],["宝","たから"],["の"],["民","たみ"],["と"],["された"],["。"]]},{"verse":7,"text":"主,しゅがあなたがたを愛,あいし、あなたがたを選,えらばれたのは、あなたがたがどの国民,こくみんよりも数,かずが多,おおかったからではない。あなたがたはよろずの民,たみのうち、もっとも数,かずの少,すくないものであった。","tok":[["主","しゅ"],["が"],["あなた"],["がた"],["を"],["愛し","あいし"],["、"],["あなた"],["がた"],["を"],["選ら","えら"],["ばれた"],["の"],["は"],["、"],["あなた"],["がた"],["が"],["どの"],["国民","こくみん"],["より"],["も"],["数","か"],["ず"],["が"],["多かった","おおかった"],["から"],["で"],["は"],["ない"],["。"],["あなた"],["がた"],["は"],["よろず"],["の"],["民","たみ"],["の"],["うち"],["、"],["もっとも"],["数","かず"],["の"],["少ない","すくない"],["もの"],["で"],["あった"],["。"]]},{"verse":8,"text":"ただ主,しゅがあなたがたを愛,あいし、またあなたがたの先祖,せんぞに誓,ちかわれた誓,ちかいを守,まもろうとして、主,しゅは強,つよい手,てをもってあなたがたを導,みちびき出,だし、奴隷,どれいの家,いえから、エジプトの王,おうパロの手,てから、あがない出,だされたのである。","tok":[["ただ"],["主","しゅ"],["が"],["あなた"],["がた"],["を"],["愛し","あいし"],["、"],["また"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["に"],["誓われた","ちかわれた"],["誓い","ちかい"],["を"],["守ろう","まもろう"],["として"],["、"],["主","しゅ"],["は"],["強い","つよい"],["手","て"],["を"],["もって"],["あなた"],["がた"],["を"],["導き出し","みちびきだし"],["、"],["奴隷","どれい"],["の"],["家","いえ"],["から"],["、"],["エジプト"],["の"],["王","おう"],["パロ"],["の"],["手","て"],["から"],["、"],["あがない"],["出された","だされた"],["ので"],["ある"],["。"]]},{"verse":9,"text":"それゆえあなたは知,しらなければならない。あなたの神,かみ、主,しゅは神,かみにましまし、真実,しんじつの神,かみにましまして、彼,かれを愛,あいし、その命令,めいれいを守,まもる者,ものには、契約,けいやくを守,まもり、恵,めぐみを施,ほどこして千,せん代,だいに及,および、","tok":[["それ"],["ゆえ"],["あなた"],["は"],["知らなければ","しらなければ"],["ならない"],["。"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["神","かみ"],["に"],["ましまし"],["、"],["真実","しんじつ"],["の"],["神","かみ"],["に"],["ましまして"],["、"],["彼","かれ"],["を"],["愛し","あいし"],["、"],["その"],["命令","めいれい"],["を"],["守者","まもるもの"],["に"],["は"],["、"],["契約","けいやく"],["を"],["守り","まもり"],["、"],["恵","めぐみ"],["を"],["施して","ほどこして"],["千代","せんだい"],["に"],["及","および"],["、"]]},{"verse":10,"text":"また彼,かれを憎,にくむ者,ものには、めいめいに報,むくいて滅,ほろぼされることを。主,しゅは自分,じぶんを憎,にくむ者,ものには猶予,ゆうよすることなく、めいめいに報,むくいられる。","tok":[["また"],["彼","かれ"],["を"],["憎む","にくむ"],["者","もの"],["に"],["は"],["、"],["めいめい"],["に"],["報いて","むくいて"],["滅ぼされる","ほろぼされる"],["こと"],["を"],["。"],["主","しゅ"],["は"],["自分","じぶん"],["を"],["憎む","にくむ"],["者","もの"],["に"],["は"],["猶予","ゆうよ"],["する"],["こと"],["なく"],["、"],["めいめい"],["に"],["報いられる","むくいられる"],["。"]]},{"verse":11,"text":"それゆえ、きょうわたしがあなたに命,めいじる命令,めいれいと、定,さだめと、おきてとを守,まもって、これを行,おこなわなければならない。","tok":[["それ"],["ゆえ"],["、"],["きょう"],["わたし"],["が"],["あなた"],["に"],["命じる","めいじる"],["命令","めいれい"],["と"],["、"],["定め","さだめ"],["と"],["、"],["おきて"],["と"],["を"],["守って","まもって"],["、"],["これ"],["を"],["行なわなければ","おこなわなければ"],["ならない"],["。"]]},{"verse":12,"text":"あなたがたがこれらのおきてを聞,きいて守,まもり行,おこなうならば、あなたの神,かみ、主,しゅはあなたの先祖,せんぞたちに誓,ちかわれた契約,けいやくを守,まもり、いつくしみを施,ほどこされるであろう。","tok":[["あなた"],["がた"],["が"],["これ"],["ら"],["の"],["おきて"],["を"],["聞いて","きいて"],["守り","まもり"],["行なうならば","おこなうならば"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["あなた"],["の"],["先祖","せんぞ"],["たち"],["に"],["誓われた","ちかわれた"],["契約","けいやく"],["を"],["守り","まもり"],["、"],["いつくしみ"],["を"],["施されるで","ほどこされるで"],["あろう"],["。"]]},{"verse":13,"text":"あなたを愛,あいし、あなたを祝福,しゅくふくし、あなたの数,かずを増,まし、あなたに与,あたえると先祖,せんぞたちに誓,ちかわれた地,ちで、あなたの子女,しじょを祝福,しゅくふくし、あなたの地,ちの産物,さんぶつ、穀物,こくもつ、酒,さけ、油,あぶら、また牛,うしの子,こ、羊,ひつじの子,こを増,まされるであろう。","tok":[["あなた"],["を"],["愛し","あいし"],["、"],["あなた"],["を"],["祝福","しゅくふく"],["し"],["、"],["あなた"],["の"],["数","かず"],["を"],["増し","まし"],["、"],["あなた"],["に"],["与える","あたえる"],["と"],["先祖","せんぞ"],["たち"],["に"],["誓われた","ちかわれた"],["地","ち"],["で"],["、"],["あなた"],["の"],["子女","しじょ"],["を"],["祝福","しゅくふく"],["し"],["、"],["あなた"],["の"],["地","ち"],["の"],["産物","さんぶつ"],["、"],["穀物","こくもつ"],["、"],["酒","さけ"],["、"],["油","あぶら"],["、"],["また"],["牛","うし"],["の"],["子","こ"],["、"],["羊","ひつじ"],["の"],["子","こ"],["を"],["増されるで","まされるで"],["あろう"],["。"]]},{"verse":14,"text":"あなたは万民,ばんみんにまさって祝福,しゅくふくされるであろう。あなたのうち、男,おとこも女,おんなも子,このないものはなく、またあなたの家畜,かちくにも子,このないものはないであろう。","tok":[["あなた"],["は"],["万民","ばんみん"],["に"],["まさって"],["祝福","しゅくふく"],["されるで"],["あろう"],["。"],["あなた"],["の"],["うち"],["、"],["男","おとこ"],["も"],["女","おんな"],["も"],["子","こ"],["の"],["ない"],["もの"],["は"],["なく"],["、"],["また"],["あなた"],["の"],["家畜","かちく"],["に"],["も"],["子","こ"],["の"],["ない"],["もの"],["は"],["ないで"],["あろう"],["。"]]},{"verse":15,"text":"主,しゅはまたすべての病,やまいをあなたから取,とり去,さり、あなたの知,しっている、あのエジプトの悪疫,あくえきにかからせず、ただあなたを憎,にくむすべての者,ものにそれを臨,のぞませられるであろう。","tok":[["主","しゅ"],["は"],["また"],["すべて"],["の"],["病","やまい"],["を"],["あなた"],["から"],["取去り","とりさり"],["、"],["あなた"],["の"],["知って","しって"],["いる"],["、"],["あの"],["エジプト"],["の"],["悪疫","あくえき"],["に"],["かからせず"],["、"],["ただ"],["あなた"],["を"],["憎む","にくむ"],["すべて"],["の"],["者","もの"],["に"],["それ"],["を"],["臨ませられるで","のぞませられるで"],["あろう"],["。"]]},{"verse":16,"text":"あなたの神,かみ、主,しゅがあなたに渡,わたされる国民,こくみんを滅,ほろぼしつくし、彼,かれらを見,みてあわれんではならない。また彼,かれらの神々,かみがみに仕,つかえてはならない。それがあなたのわなとなるからである。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["あなた"],["に"],["渡される","わたされる"],["国民","こくみん"],["を"],["滅ぼし","ほろぼし"],["つくし"],["、"],["彼","かれ"],["ら"],["を"],["見て","みて"],["あわれんで"],["は"],["ならない"],["。"],["また"],["彼","かれ"],["ら"],["の"],["神々","かみがみ"],["に"],["仕えて","つかえて"],["は"],["ならない"],["。"],["それ"],["が"],["あなた"],["の"],["わな"],["と"],["なる"],["から"],["で"],["ある"],["。"]]},{"verse":17,"text":"あなたは心,こころのうちで『これらの国民,こくみんはわたしよりも多,おおいから、どうしてこれを追,おい払,はらうことができようか』と言,いうのか。","tok":[["あなた"],["は"],["心","こころ"],["の"],["うち"],["で"],["『"],["これ"],["ら"],["の"],["国民","こくみん"],["は"],["わたし"],["より"],["も"],["多い","おおい"],["から"],["、"],["どう"],["して"],["これ"],["を"],["追い払う","おいはらう"],["こと"],["が"],["できよう"],["か"],["』"],["と"],["言う","いう"],["の"],["か"],["。"]]},{"verse":18,"text":"彼,かれらを恐,おそれてはならない。あなたの神,かみ、主,しゅがパロと、すべてのエジプトびととにされたことを、よく覚,おぼえなさい。","tok":[["彼","かれ"],["ら"],["を"],["恐れて","おそれて"],["は"],["ならない"],["。"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["パロ"],["と"],["、"],["すべて"],["の"],["エジプト"],["びと"],["と"],["に"],["された"],["こと"],["を"],["、"],["よく"],["覚え","おぼえ"],["なさい"],["。"]]},{"verse":19,"text":"すなわち、あなたが目,めで見,みた大,おおいなる試,こころみと、しるしと、不思議,ふしぎと、強,つよい手,てと、伸,のばした腕,うでとを覚,おぼえなさい。あなたの神,かみ、主,しゅはこれらをもって、あなたを導,みちびき出,だされたのである。またそのように、あなたの神,かみ、主,しゅはあなたが恐,おそれているすべての民,たみにされるであろう。","tok":[["すなわち"],["、"],["あなた"],["が"],["目","め"],["で"],["見た","みた"],["大いなる","おおいなる"],["試み","こころみ"],["と"],["、"],["しるし"],["と"],["、"],["不思議","ふしぎ"],["と"],["、"],["強い","つよい"],["手","て"],["と"],["、"],["伸ばした","のばした"],["腕","うで"],["と"],["を"],["覚え","おぼえ"],["なさい"],["。"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["これ"],["ら"],["を"],["もって"],["、"],["あなた"],["を"],["導き出された","みちびきだされた"],["ので"],["ある"],["。"],["また"],["その"],["よう"],["に"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["あなた"],["が"],["恐れて","おそれて"],["いる"],["すべて"],["の"],["民","たみ"],["に"],["されるで"],["あろう"],["。"]]},{"verse":20,"text":"あなたの神,かみ、主,しゅはまた、くまばちを彼,かれらのうちに送,おくって、なお残,のこっている者,ものと逃,にげ隠,かくれている者,ものを滅,ほろぼしつくされるであろう。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["また"],["、"],["くまばち"],["を"],["彼","かれ"],["ら"],["の"],["うち"],["に"],["送って","おくって"],["、"],["なお"],["残って","のこって"],["いる"],["者","もの"],["と"],["逃","にげ"],["隠れて","かくれて"],["いる"],["者","もの"],["を"],["滅ぼし","ほろぼし"],["つくされるで"],["あろう"],["。"]]},{"verse":21,"text":"あなたは彼,かれらを恐,おそれてはならない。あなたの神,かみ、主,しゅである大,おおいなる恐,おそるべき神,かみがあなたのうちにおられるからである。","tok":[["あなた"],["は"],["彼","かれ"],["ら"],["を"],["恐れて","おそれて"],["は"],["ならない"],["。"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["で"],["ある"],["大いなる","おおいなる"],["恐るべき","おそるべき"],["神","かみ"],["が"],["あなた"],["の"],["うち"],["に"],["おられる"],["から"],["で"],["ある"],["。"]]},{"verse":22,"text":"あなたの神,かみ、主,しゅはこれらの国民,こくみんを徐々,じょじょにあなたの前,まえから追,おい払,はらわれるであろう。あなたはすみやかに彼,かれらを滅,ほろぼしつくしてはならない。そうでなければ、野,のの獣,けものが増,ましてあなたを害,がいするであろう。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["これ"],["ら"],["の"],["国民","こくみん"],["を"],["徐々","じょじょ"],["に"],["あなた"],["の"],["前","まえ"],["から"],["追い払われるで","おいはらわれるで"],["あろう"],["。"],["あなた"],["は"],["すみやか"],["に"],["彼","かれ"],["ら"],["を"],["滅ぼし","ほろぼし"],["つくして"],["は"],["ならない"],["。"],["そう"],["で"],["なければ"],["、"],["野","の"],["の"],["獣","けもの"],["が"],["増して","まして"],["あなた"],["を"],["害するで","がいするで"],["あろう"],["。"]]},{"verse":23,"text":"しかし、あなたの神,かみ、主,しゅは彼,かれらをあなたに渡,わたし、大,おおいなる混乱,こんらんにおとしいれて、ついに滅,ほろぼされるであろう。","tok":[["しかし"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["彼","かれ"],["ら"],["を"],["あなた"],["に"],["渡","わたし"],["、"],["大いなる","おおいなる"],["混乱","こんらん"],["に"],["おとしいれて"],["、"],["ついに"],["滅ぼされるで","ほろぼされるで"],["あろう"],["。"]]},{"verse":24,"text":"また彼,かれらの王,おうたちをあなたの手,てに渡,わたされるであろう。あなたは彼,かれらの名,なを天,てんの下,したから消,けし去,さるであろう。あなたに立,たちむかうものはなく、あなたはついに彼,かれらを滅,ほろぼすにいたるであろう。","tok":[["また"],["彼","かれ"],["ら"],["の"],["王","おう"],["たち"],["を"],["あなた"],["の"],["手","て"],["に"],["渡されるで","わたされるで"],["あろう"],["。"],["あなた"],["は"],["彼","かれ"],["ら"],["の"],["名","な"],["を"],["天","てん"],["の"],["下","した"],["から"],["消し去るで","けしさるで"],["あろう"],["。"],["あなた"],["に"],["立ちむかう","たちむかう"],["もの"],["は"],["なく"],["、"],["あなた"],["は"],["ついに"],["彼","かれ"],["ら"],["を"],["滅ぼす","ほろぼす"],["に"],["いたるで"],["あろう"],["。"]]},{"verse":25,"text":"あなたは彼,かれらの神々,かみがみの彫像,ちょうぞうを火,ひに焼,やかなければならない。それに着,きせた銀,ぎんまたは金,きんをむさぼってはならない。これを取,とって自分,じぶんのものにしてはならない。そうでなければ、あなたはこれによって、わなにかかるであろう。これはあなたの神,かみが忌,いみきらわれるものだからである。","tok":[["あなた"],["は"],["彼","かれ"],["ら"],["の"],["神々","かみがみ"],["の"],["彫像","ちょうぞう"],["を"],["火","ひ"],["に"],["焼かなければ","やかなければ"],["ならない"],["。"],["それ"],["に"],["着せた","きせた"],["銀","ぎん"],["また"],["は"],["金","きん"],["を"],["むさぼって"],["は"],["ならない"],["。"],["これ"],["を"],["取って","とって"],["自分","じぶん"],["の"],["もの"],["に"],["して"],["は"],["ならない"],["。"],["そう"],["で"],["なければ"],["、"],["あなた"],["は"],["これ"],["によって"],["、"],["わな"],["に"],["かかるで"],["あろう"],["。"],["これ"],["は"],["あなた"],["の"],["神","かみ"],["が"],["忌","いみ"],["きらわれる"],["もの"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":26,"text":"あなたは忌,いむべきものを家,いえに持,もちこんで、それと同,おなじようにあなた自身,じしんも、のろわれたものとなってはならない。あなたはそれを全,まったく忌,いみきらわなければならない。それはのろわれたものだからである。","tok":[["あなた"],["は"],["忌むべき","いむべき"],["もの"],["を"],["家","いえ"],["に"],["持","もち"],["こん"],["で"],["、"],["それ"],["と"],["同じ","おなじ"],["よう"],["に"],["あなた"],["自身","じしん"],["も"],["、"],["のろわれた"],["もの"],["と"],["なって"],["は"],["ならない"],["。"],["あなた"],["は"],["それ"],["を"],["全く","まったく"],["忌","いみ"],["きらわなければ"],["ならない"],["。"],["それ"],["は"],["のろわれた"],["もの"],["だ"],["から"],["で"],["ある"],["。"]]}]
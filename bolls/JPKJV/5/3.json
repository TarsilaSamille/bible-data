[{"verse":1,"text":"そしてわれわれは身,みをめぐらして、バシャンの道,みちを上,のぼって行,いったが、バシャンの王,おうオグは、われわれを迎,むかえ撃,うとうとして、その民,たみをことごとく率,ひきい、出,でてきてエデレイで戦,たたかった。","tok":[["そして"],["われわれ"],["は"],["身","み"],["を"],["めぐらして"],["、"],["バシャン"],["の"],["道","みち"],["を"],["上って","のぼって"],["行った","いった"],["が"],["、"],["バシャン"],["の"],["王","おう"],["オグ"],["は"],["、"],["われわれ"],["を"],["迎撃","むかえう"],["とう"],["として"],["、"],["その"],["民","たみ"],["を"],["ことごとく"],["率い","ひきい"],["、"],["出て","でて"],["きて"],["エデレイ"],["で"],["戦った","たたかった"],["。"]]},{"verse":2,"text":"時,ときに主,しゅはわたしに言,いわれた、『彼,かれを恐,おそれてはならない。わたしは彼,かれと、そのすべての民,たみと、その地,ちをおまえの手,てに渡,わたしている。おまえはヘシボンに住,すんでいたアモリびとの王,おうシホンにしたように、彼,かれにするであろう』。","tok":[["時","とき"],["に"],["主","しゅ"],["は"],["わたし"],["に"],["言われた","いわれた"],["、"],["『"],["彼","かれ"],["を"],["恐れて","おそれて"],["は"],["ならない"],["。"],["わたし"],["は"],["彼","かれ"],["と"],["、"],["その"],["すべて"],["の"],["民","たみ"],["と"],["、"],["その"],["地","ち"],["を"],["おまえ"],["の"],["手","て"],["に"],["渡","わたし"],["て"],["いる"],["。"],["おまえ"],["は"],["ヘシボン"],["に"],["住んで","すんで"],["いた"],["アモリ"],["びと"],["の"],["王","おう"],["シホン"],["に"],["した"],["よう"],["に"],["、"],["彼","かれ"],["に"],["するで"],["あろう"],["』"],["。"]]},{"verse":3,"text":"こうしてわれわれの神,かみ、主,しゅはバシャンの王,おうオグと、そのすべての民,たみを、われわれの手,てに渡,わたされたので、われわれはこれを撃,うち殺,ころして、ひとりをも残,のこさなかった。","tok":[["こう"],["して"],["われわれ"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["バシャン"],["の"],["王","おう"],["オグ"],["と"],["、"],["その"],["すべて"],["の"],["民","たみ"],["を"],["、"],["われわれ"],["の"],["手","て"],["に"],["渡された","わたされた"],["ので"],["、"],["われわれ"],["は"],["これ"],["を"],["撃ち","うち"],["殺ろ","ころ"],["して"],["、"],["ひとり"],["を"],["も"],["残さなかった","のこさなかった"],["。"]]},{"verse":4,"text":"その時,とき、われわれは彼,かれの町々,まちまちを、ことごとく取,とった。われわれが取,とらなかった町,まちは一つもなかった。取,とった町,まちは六十。アルゴブの全,ぜん地方,ちほうであって、バシャンにおけるオグの国,くにである。","tok":[["その"],["時","とき"],["、"],["われわれ"],["は"],["彼","かれ"],["の"],["町々","まちまち"],["を"],["、"],["ことごとく"],["取った","とった"],["。"],["われわれ"],["が"],["取らなかった","とらなかった"],["町","まち"],["は"],["一","ひと"],["つ"],["も"],["なかった"],["。"],["取った","とった"],["町","まち"],["は"],["六十","ろくじゅう"],["。"],["アルゴブ"],["の"],["全","ぜん"],["地方","ちほう"],["で"],["あって"],["、"],["バシャン"],["に"],["おける"],["オグ"],["の"],["国","くに"],["で"],["ある"],["。"]]},{"verse":5,"text":"これらは皆,みな、高,たかい石,いしがきがあり、門,もんがあり、貫,かんの木,きのある堅固,けんごな町,まちであった。このほかに石,いしがきのない町,まちは、非常,ひじょうに多,おおかった。","tok":[["これ"],["ら"],["は"],["皆","みな"],["、"],["高かい","たかい"],["石がき","いしがき"],["が"],["あり"],["、"],["門","もん"],["が"],["あり"],["、"],["貫の木","かんのき"],["の"],["ある"],["堅固","けんご"],["な"],["町","まち"],["で"],["あった"],["。"],["この"],["ほか"],["に"],["石がき","いしがき"],["の"],["ない"],["町","まち"],["は"],["、"],["非常","ひじょう"],["に"],["多かった","おおかった"],["。"]]},{"verse":6,"text":"われわれはヘシボンの王,おうシホンにしたように、これらを全,まったく滅,ほろぼし、そのすべての町,まちの男,おとこ、女,おんなおよび子供,こどもをことごとく滅,ほろぼした。","tok":[["われわれ"],["は"],["ヘシボン"],["の"],["王","おう"],["シホン"],["に"],["した"],["よう"],["に"],["、"],["これ"],["ら"],["を"],["全く","まったく"],["滅ぼし","ほろぼし"],["、"],["その"],["すべて"],["の"],["町","まち"],["の"],["男","おとこ"],["、"],["女","おんな"],["および"],["子供","こども"],["を"],["ことごとく"],["滅ぼした","ほろぼした"],["。"]]},{"verse":7,"text":"ただし、そのすべての家畜,かちくと、その町々,まちまちからのぶんどり物,ものとは、われわれが獲,えて自分,じぶんの物,ものとした。","tok":[["ただし"],["、"],["その"],["すべて"],["の"],["家畜","かちく"],["と"],["、"],["その"],["町々","まちまち"],["から"],["の"],["ぶんどり"],["物","もの"],["と"],["は"],["、"],["われわれ"],["が"],["獲て","えて"],["自分","じぶん"],["の"],["物","もの"],["と"],["した"],["。"]]},{"verse":8,"text":"その時,ときわれわれはヨルダンの向,むこう側,がわにいるアモリびとのふたりの王,おうの手,てから、アルノン川,がわからヘルモン山,ざんまでの地,ちを取,とった。","tok":[["その"],["時","とき"],["われわれ"],["は"],["ヨルダン"],["の"],["向こう側","むこうがわ"],["に"],["いる"],["アモリ"],["びと"],["の"],["ふたり"],["の"],["王","おう"],["の"],["手","て"],["から"],["、"],["アルノン"],["川","がわか"],["ら"],["ヘルモン"],["山","ざん"],["まで"],["の"],["地","ち"],["を"],["取った","とった"],["。"]]},{"verse":9,"text":"（シドンびとはヘルモンをシリオンと呼,よび、アモリびとはこれをセニルと呼,よんでいる。）","tok":[["（"],["シドン"],["びと"],["は"],["ヘルモン"],["を"],["シリオン"],["と"],["呼び","よび"],["、"],["アモリ"],["び"],["と"],["は"],["これ"],["を"],["セニル"],["と"],["呼んで","よんで"],["いる"],["。"],["）"]]},{"verse":10,"text":"すなわち高原,こうげんのすべての町,まち、ギレアデの全,ぜん地,ち、バシャンの全,ぜん地,ち、サルカおよびエデレイまで、バシャンにあるオグの国,くにの町々,まちまちをことごとく取,とった。","tok":[["すなわち"],["高原","こうげん"],["の"],["すべて"],["の"],["町","まち"],["、"],["ギレアデ"],["の"],["全地","ぜんち"],["、"],["バシャン"],["の"],["全地","ぜんち"],["、"],["サルカ"],["および"],["エデレイ"],["まで"],["、"],["バシャン"],["に"],["ある"],["オグ"],["の"],["国","くに"],["の"],["町々","まちまち"],["を"],["ことごとく"],["取った","とった"],["。"]]},{"verse":11,"text":"（バシャンの王,おうオグはレパイムのただひとりの生存者,せいぞんしゃであった。彼,かれの寝台,しんだいは鉄,てつの寝台,しんだいであった。これは今,いまなおアンモンびとのラバにあるではないか。これは普通,ふつうのキュビト尺,しゃくで、長,ながさ九,きゅうキュビト、幅,はば四キュビトである。）","tok":[["（"],["バシャン"],["の"],["王","おう"],["オグ"],["は"],["レパイム"],["の"],["ただ"],["ひとり"],["の"],["生存者","せいぞんしゃ"],["で"],["あった"],["。"],["彼","かれ"],["の"],["寝台","しんだい"],["は"],["鉄","てつ"],["の"],["寝台","しんだい"],["で"],["あった"],["。"],["これ"],["は"],["今","いま"],["なお"],["アンモン"],["びと"],["の"],["ラバ"],["に"],["ある"],["で"],["は"],["ない"],["か"],["。"],["これ"],["は"],["普通","ふつう"],["の"],["キュビト"],["尺","しゃく"],["で"],["、"],["長さ","ながさ"],["九","きゅう"],["キュビト"],["、"],["幅","はば"],["四","よん"],["キュビト"],["で"],["ある"],["。"],["）"]]},{"verse":12,"text":"その時,ときわれわれは、この地,ちを獲,えた。そしてわたしはアルノン川,がわのほとりのアロエルから始,はじまる地,ちと、ギレアデの山地,さんちの半,なかばと、その町々,まちまちとは、ルベンびとと、ガドびととに与,あたえた。","tok":[["その"],["時","とき"],["われわれ"],["は"],["、"],["この"],["地","ち"],["を"],["獲た","えた"],["。"],["そして"],["わたし"],["は"],["アルノン"],["川","がわ"],["の"],["ほとり"],["の"],["アロエル"],["から"],["始まる","はじまる"],["地","ち"],["と"],["、"],["ギレアデ"],["の"],["山地","さんち"],["の"],["半ば","なかば"],["と"],["、"],["その"],["町々","まちまち"],["と"],["は"],["、"],["ルベン"],["びと"],["と"],["、"],["ガド"],["びと"],["と"],["に"],["与","あたえ"],["た"],["。"]]},{"verse":13,"text":"わたしはまたギレアデの残,のこりの地,ちと、オグの国,くにであったバシャンの全,ぜん地,ちとは、マナセの半,はん部族,ぶぞくに与,あたえた。すなわちアルゴブの全,ぜん地方,ちほうである。（そのバシャンの全,ぜん地,ちはレパイムの国,くにと唱,となえられる。","tok":[["わたし"],["は"],["また"],["ギレアデ"],["の"],["残り","のこり"],["の"],["地","ち"],["と"],["、"],["オグ"],["の"],["国","くに"],["で"],["あった"],["バシャン"],["の"],["全地","ぜんち"],["と"],["は"],["、"],["マナセ"],["の"],["半","はん"],["部族","ぶぞく"],["に"],["与","あたえ"],["た"],["。"],["すなわち"],["アルゴブ"],["の"],["全","ぜん"],["地方","ちほう"],["で"],["ある"],["。"],["（"],["その"],["バシャン"],["の"],["全地","ぜんち"],["は"],["レパイム"],["の"],["国","くに"],["と"],["唱えられる","となえられる"],["。"]]},{"verse":14,"text":"マナセの子,こヤイルは、アルゴブの全,ぜん地方,ちほうを取,とって、ゲシュルびとと、マアカびとの境,さかいにまで達,たっし、自分,じぶんの名,なにしたがって、バシャンをハボテ・ヤイルと名,なづけた。この名,なは今日,こんにちにまでおよんでいる。）","tok":[["マナセ"],["の"],["子","こ"],["ヤイル"],["は"],["、"],["アルゴブ"],["の"],["全","ぜん"],["地方","ちほう"],["を"],["取って","とって"],["、"],["ゲシュル"],["びと"],["と"],["、"],["マアカ"],["びと"],["の"],["境","さかい"],["に"],["まで"],["達し","たっし"],["、"],["自分","じぶん"],["の"],["名","な"],["に"],["したがって"],["、"],["バシャン"],["を"],["ハボテ"],["・"],["ヤイル"],["と"],["名づけた","なづけた"],["。"],["この"],["名","な"],["は"],["今日","こんにち"],["に"],["まで"],["およんで"],["いる"],["。"],["）"]]},{"verse":15,"text":"またわたしはマキルにはギレアデを与,あたえた。","tok":[["また"],["わたし"],["は"],["マキル"],["に"],["は"],["ギレアデ"],["を"],["与","あたえ"],["た"],["。"]]},{"verse":16,"text":"ルベンびとと、ガドびととには、ギレアデからアルノン川,がわまでを与,あたえ、その川,かわのまん中,なかをもって境,さかいとし、またアンモンびとの境,さかいであるヤボク川,がわにまで達,たっせしめた。","tok":[["ルベン"],["びと"],["と"],["、"],["ガド"],["びと"],["と"],["に"],["は"],["、"],["ギレアデ"],["から"],["アルノン"],["川","がわ"],["まで"],["を"],["与","あたえ"],["、"],["その"],["川","かわ"],["の"],["まん中","まんなか"],["を"],["もって"],["境","さかい"],["と"],["し"],["、"],["また"],["アンモン"],["びと"],["の"],["境","さかい"],["で"],["ある"],["ヤボク"],["川","がわ"],["に"],["まで"],["達せしめた","たっせしめた"],["。"]]},{"verse":17,"text":"またヨルダンを境,さかいとして、キンネレテからアラバの海,うみすなわち塩,しおの海,うみまで、アラバをこれに与,あたえて、東,ひがしの方,ほうピスガのふもとに達,たっせしめた。","tok":[["また"],["ヨルダン"],["を"],["境","さかい"],["として"],["、"],["キンネレテ"],["から"],["アラバ"],["の"],["海","うみ"],["すなわち"],["塩","しお"],["の"],["海","うみ"],["まで"],["、"],["アラバ"],["を"],["これ"],["に"],["与","あたえ"],["て"],["、"],["東","ひがし"],["の"],["方","ほう"],["ピスガ"],["の"],["ふもと"],["に"],["達せしめた","たっせしめた"],["。"]]},{"verse":18,"text":"その時,ときわたしはあなたがたに命,めいじて言,いった、『あなたがたの神,かみ、主,しゅはこの地,ちをあなたがたに与,あたえて、これを獲,えさせられるから、あなたがた勇士,ゆうしはみな武装,ぶそうして、兄弟,きょうだいであるイスラエルの人々,ひとびとに先立,さきだって、渡,わたって行,いかなければならない。","tok":[["その"],["時","とき"],["わたし"],["は"],["あなた"],["がた"],["に"],["命じて","めいじて"],["言った","いった"],["、"],["『"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["この"],["地","ち"],["を"],["あなた"],["がた"],["に"],["与","あたえ"],["て"],["、"],["これ"],["を"],["獲させられる","えさせられる"],["から"],["、"],["あなた"],["がた"],["勇士","ゆうし"],["は"],["みな"],["武装","ぶそう"],["して"],["、"],["兄弟","きょうだい"],["で"],["ある"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["先立って","さきだって"],["、"],["渡って","わたって"],["行かなければ","いかなければ"],["ならない"],["。"]]},{"verse":19,"text":"ただし、あなたがたの妻,つまと、子供,こどもと、家畜,かちくとは、わたしが与,あたえた町々,まちまちにとどまらなければならない。（わたしはあなたがたが多,おおくの家畜,かちくを持,もっているのを知,しっている。）","tok":[["ただし"],["、"],["あなた"],["がた"],["の"],["妻","つま"],["と"],["、"],["子供","こども"],["と"],["、"],["家畜","かちく"],["と"],["は"],["、"],["わたし"],["が"],["与","あたえ"],["た"],["町々","まちまち"],["に"],["とどまらなければ"],["ならない"],["。"],["（"],["わたし"],["は"],["あなた"],["がた"],["が"],["多く","おおく"],["の"],["家畜","かちく"],["を"],["持って","もって"],["いる"],["の"],["を"],["知って","しって"],["いる"],["。"],["）"]]},{"verse":20,"text":"主,しゅがすでにあなたがたに与,あたえられたように、あなたがたの兄弟,きょうだいにも安息,あんそくを与,あたえられて、彼,かれらもまたヨルダンの向,むこう側,がわで、あなたがたの神,かみ、主,しゅが与,あたえられる地,ちを獲,えるようになったならば、あなたがたはおのおのわたしがあなたがたに与,あたえた領地,りょうちに帰,かえることができる』。","tok":[["主","しゅ"],["が"],["すでに"],["あなた"],["がた"],["に"],["与えられた","あたえられた"],["よう"],["に"],["、"],["あなた"],["がた"],["の"],["兄弟","きょうだい"],["に"],["も"],["安息","あんそく"],["を"],["与えられて","あたえられて"],["、"],["彼","かれ"],["ら"],["も"],["また"],["ヨルダン"],["の"],["向こう側","むこうがわ"],["で"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["与えられる","あたえられる"],["地","ち"],["を"],["獲る","える"],["よう"],["に"],["なったならば"],["、"],["あなた"],["がた"],["は"],["おのおの"],["わたし"],["が"],["あなた"],["がた"],["に"],["与","あたえ"],["た"],["領地","りょうち"],["に"],["帰える","かえる"],["こと"],["が"],["できる"],["』"],["。"]]},{"verse":21,"text":"その時,ときわたしはヨシュアに命,めいじて言,いった、『あなたの目,めはあなたがたの神,かみ、主,しゅがこのふたりの王,おうに行,おこなわれたすべてのことを見,みた。主,しゅはまたあなたが渡,わたって行,いくもろもろの国,くににも、同,おなじように行,おこなわれるであろう。","tok":[["その"],["時","とき"],["わたし"],["は"],["ヨシュア"],["に"],["命じて","めいじて"],["言った","いった"],["、"],["『"],["あなた"],["の"],["目","め"],["は"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅがこ"],["の"],["ふたり"],["の"],["王","おう"],["に"],["行なわれた","おこなわれた"],["すべて"],["の"],["こと"],["を"],["見た","みた"],["。"],["主","しゅ"],["は"],["また"],["あなた"],["が"],["渡って","わたって"],["行く","いく"],["もろもろ"],["の"],["国","くに"],["に"],["も"],["、"],["同じ","おなじ"],["よう"],["に"],["行なわれるで","おこなわれるで"],["あろう"],["。"]]},{"verse":22,"text":"彼,かれらを恐,おそれてはならない。あなたがたの神,かみ、主,しゅがあなたがたのために戦,たたかわれるからである』。","tok":[["彼","かれ"],["ら"],["を"],["恐れて","おそれて"],["は"],["ならない"],["。"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["あなた"],["がた"],["の"],["ため"],["に"],["戦われる","たたかわれる"],["から"],["で"],["ある"],["』"],["。"]]},{"verse":23,"text":"その時,ときわたしは主,しゅに願,ねがって言,いった、","tok":[["その"],["時","とき"],["わたし"],["は"],["主に","しゅに"],["願って","ねがって"],["言った","いった"],["、"]]},{"verse":24,"text":"『主,しゅなる神,かみよ、あなたの大,おおいなる事,ことと、あなたの強,つよい手,てとを、たった今,いま、しもべに示,しめし始,はじめられました。天,てんにも地,ちにも、あなたのようなわざをなし、あなたのような力,ちからあるわざのできる神,かみが、ほかにありましょうか。","tok":[["『"],["主","しゅ"],["なる"],["神","かみ"],["よ"],["、"],["あなた"],["の"],["大いなる","おおいなる"],["事","こと"],["と"],["、"],["あなた"],["の"],["強い","つよい"],["手","て"],["と"],["を"],["、"],["たった"],["今","いま"],["、"],["しもべ"],["に"],["示めし","しめし"],["始められました","はじめられました"],["。"],["天","てん"],["に"],["も"],["地","ち"],["に"],["も"],["、"],["あなた"],["の"],["よう"],["な"],["わざ"],["を"],["なし"],["、"],["あなた"],["の"],["よう"],["な"],["力","ちから"],["ある"],["わざ"],["の"],["できる"],["神","かみ"],["が"],["、"],["ほか"],["に"],["ありましょう"],["か"],["。"]]},{"verse":25,"text":"どうぞ、わたしにヨルダンを渡,わたって行,いかせ、その向,むこう側,がわの良,よい地,ち、あの良,よい山地,さんち、およびレバノンを見,みることのできるようにしてください』。","tok":[["どうぞ"],["、"],["わたし"],["に"],["ヨルダン"],["を"],["渡って","わたって"],["行かせ","いかせ"],["、"],["その"],["向こう側","むこうがわ"],["の"],["良い","よい"],["地","ち"],["、"],["あの"],["良い","よい"],["山地","さんち"],["、"],["および"],["レバノン"],["を"],["見る","みる"],["こと"],["の"],["できる"],["よう"],["に"],["して"],["ください"],["』"],["。"]]},{"verse":26,"text":"しかし主,しゅはあなたがたのゆえにわたしを怒,いかり、わたしに聞,きかれなかった。そして主,しゅはわたしに言,いわれた、『おまえはもはや足,たりている。この事,ことについては、重,かさねてわたしに言,いってはならない。","tok":[["しかし"],["主","しゅ"],["は"],["あなた"],["がた"],["の"],["ゆえ"],["に"],["わたし"],["を"],["怒り","いかり"],["、"],["わたし"],["に"],["聞かれなかった","きかれなかった"],["。"],["そして"],["主","しゅ"],["は"],["わたし"],["に"],["言われた","いわれた"],["、"],["『"],["おまえ"],["は"],["もはや"],["足りて","たりて"],["いる"],["。"],["この"],["事","こと"],["について"],["は"],["、"],["重ねて","かさねて"],["わたし"],["に"],["言って","いって"],["は"],["ならない"],["。"]]},{"verse":27,"text":"おまえはピスガの頂,いただきに登,のぼり、目,めをあげて西,にし、北,きた、南,みなみ、東,ひがしを望,のぞみ見,みよ。おまえはこのヨルダンを渡,わたることができないからである。","tok":[["おまえ"],["は"],["ピスガ"],["の"],["頂","いただき"],["に"],["登り","のぼり"],["、"],["目","め"],["を"],["あげて"],["西","にし"],["、"],["北","きた"],["、"],["南","みなみ"],["、"],["東","ひがし"],["を"],["望み見","のぞみみ"],["よ"],["。"],["おまえ"],["は"],["この"],["ヨルダン"],["を"],["渡る","わたる"],["こと"],["が"],["できない"],["から"],["で"],["ある"],["。"]]},{"verse":28,"text":"しかし、おまえはヨシュアに命,めいじ、彼,かれを励,はげまし、彼,かれを強,つよくせよ。彼,かれはこの民,たみに先立,さきだって渡,わたって行,いき、彼,かれらにおまえの見,みる地,ちを継,つがせるであろう』。","tok":[["しかし"],["、"],["おまえ"],["は"],["ヨシュア"],["に"],["命じ","めいじ"],["、"],["彼","かれ"],["を"],["励まし","はげまし"],["、"],["彼","かれ"],["を"],["強く","つよく"],["せよ"],["。"],["彼","かれ"],["は"],["この"],["民","たみ"],["に"],["先立って","さきだって"],["渡って","わたって"],["行き","いき"],["、"],["彼","かれ"],["ら"],["に"],["おまえ"],["の"],["見る","みる"],["地","ち"],["を"],["継がせるで","つがせるで"],["あろう"],["』"],["。"]]},{"verse":29,"text":"こうしてわれわれはベテペオルに対,たいする谷,たににとどまっていた。","tok":[["こう"],["して"],["われわれ"],["は"],["ベテペオル"],["に"],["対する","たいする"],["谷","たに"],["に"],["とどまって"],["いた"],["。"]]}]
[{"verse":1,"text":"イスラエルよ、いま、わたしがあなたがたに教,おしえる定,さだめと、おきてとを聞,きいて、これを行,おこないなさい。そうすれば、あなたがたは生,いきることができ、あなたがたの先祖,せんぞの神,かみ、主,しゅが賜,たまわる地,ちにはいって、それを自分,じぶんのものとすることができよう。","tok":[["イスラエル"],["よ"],["、"],["いま"],["、"],["わたし"],["が"],["あなた"],["がた"],["に"],["教える","おしえる"],["定め","さだめ"],["と"],["、"],["おきて"],["と"],["を"],["聞いて","きいて"],["、"],["これ"],["を"],["行ない","おこない"],["なさい"],["。"],["そう"],["すれば"],["、"],["あなた"],["がた"],["は"],["生きる","いきる"],["こと"],["が"],["でき"],["、"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["賜わる","たまわる"],["地","ち"],["に"],["はいって"],["、"],["それ"],["を"],["自分","じぶん"],["の"],["もの"],["と"],["する"],["こと"],["が"],["できよう"],["。"]]},{"verse":2,"text":"わたしがあなたがたに命,めいじる言葉,ことばに付,つけ加,くわえてはならない。また減,へらしてはならない。わたしが命,めいじるあなたがたの神,かみ、主,しゅの命令,めいれいを守,まもることのできるためである。","tok":[["わたし"],["が"],["あなた"],["がた"],["に"],["命じる","めいじる"],["言葉","ことば"],["に"],["付け加えて","つけくわえて"],["は"],["ならない"],["。"],["また"],["減らして","へらして"],["は"],["ならない"],["。"],["わたし"],["が"],["命じる","めいじる"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["命令","めいれい"],["を"],["守","まもる"],["こと"],["の"],["できる"],["ため"],["で"],["ある"],["。"]]},{"verse":3,"text":"あなたがたの目,めは、主,しゅがバアル・ペオルで行,おこなわれたことを見,みた。ペオルのバアルに従,したがった人々,ひとびとは、あなたの神,かみ、主,しゅがことごとく、あなたのうちから滅,ほろぼしつくされたのである。","tok":[["あなた"],["がた"],["の"],["目","め"],["は"],["、"],["主","しゅ"],["が"],["バアル"],["・"],["ペオル"],["で"],["行なわれた","おこなわれた"],["こと"],["を"],["見た","みた"],["。"],["ペオル"],["の"],["バアル"],["に"],["従った","したがった"],["人々","ひとびと"],["は"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["ことごとく"],["、"],["あなた"],["の"],["うち"],["から"],["滅ぼし","ほろぼし"],["つくされた"],["ので"],["ある"],["。"]]},{"verse":4,"text":"しかし、あなたがたの神,かみ、主,しゅにつき従,したがったあなたがたは皆,みな、きょう、生,いきながらえている。","tok":[["しかし"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主に","しゅに"],["つき従った","つきしたがった"],["あなた"],["がた"],["は"],["皆","みな"],["、"],["きょう"],["、"],["生きながらえて","いきながらえて"],["いる"],["。"]]},{"verse":5,"text":"わたしはわたしの神,かみ、主,しゅが命,めいじられたとおりに、定,さだめと、おきてとを、あなたがたに教,おしえる。あなたがたがはいって、自分,じぶんのものとする地,ちにおいて、そのように行,おこなうためである。","tok":[["わたし"],["は"],["わたし"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["命じられた","めいじられた"],["とおり"],["に"],["、"],["定め","さだめ"],["と"],["、"],["おきて"],["と"],["を"],["、"],["あなた"],["がた"],["に"],["教える","おしえる"],["。"],["あなた"],["がた"],["が"],["はいって"],["、"],["自分","じぶん"],["の"],["もの"],["と"],["する"],["地","ち"],["に"],["おいて"],["、"],["その"],["よう"],["に"],["行なう","おこなう"],["ため"],["で"],["ある"],["。"]]},{"verse":6,"text":"あなたがたは、これを守,まもって行,おこなわなければならない。これは、もろもろの民,たみにあなたがたの知恵,ちえ、また知識,ちしきを示,しめす事,ことである。彼,かれらは、このもろもろの定,さだめを聞,きいて、『この大,おおいなる国民,こくみんは、まことに知恵,ちえあり、知識,ちしきある民,たみである』と言,いうであろう。","tok":[["あなた"],["がた"],["は"],["、"],["これ"],["を"],["守って","まもって"],["行なわなければ","おこなわなければ"],["ならない"],["。"],["これ"],["は"],["、"],["もろもろ"],["の"],["民","たみ"],["に"],["あなた"],["がた"],["の"],["知恵","ちえ"],["、"],["また"],["知識","ちしき"],["を"],["示めす","しめす"],["事","こと"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["、"],["この"],["もろもろ"],["の"],["定め","さだめ"],["を"],["聞いて","きいて"],["、"],["『"],["この"],["大いなる","おおいなる"],["国民","こくみん"],["は"],["、"],["まこと"],["に"],["知恵","ちえ"],["あり"],["、"],["知識","ちしき"],["ある"],["民","たみ"],["で"],["ある"],["』"],["と"],["言うで","いうで"],["あろう"],["。"]]},{"verse":7,"text":"われわれの神,かみ、主,しゅは、われわれが呼,よび求,もとめる時,とき、つねにわれわれに近,ちかくおられる。いずれの大,おおいなる国民,こくみんに、このように近,ちかくおる神,かみがあるであろうか。","tok":[["われわれ"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["、"],["われわれ"],["が"],["呼び求める","よびもとめる"],["時","とき"],["、"],["つね"],["に"],["われわれ"],["に"],["近く","ちかく"],["おられる"],["。"],["いずれ"],["の"],["大いなる","おおいなる"],["国民","こくみん"],["に"],["、"],["この"],["よう"],["に"],["近く","ちかく"],["おる"],["神","かみ"],["が"],["あるで"],["あろう"],["か"],["。"]]},{"verse":8,"text":"また、いずれの大,おおいなる国民,こくみんに、きょう、わたしがあなたがたの前,まえに立,たてるこのすべての律法,りっぽうのような正,ただしい定,さだめと、おきてとがあるであろうか。","tok":[["また"],["、"],["いずれ"],["の"],["大いなる","おおいなる"],["国民","こくみん"],["に"],["、"],["きょう"],["、"],["わたし"],["が"],["あなた"],["がた"],["の"],["前","まえ"],["に"],["立る","たてる"],["この"],["すべて"],["の"],["律法","りっぽう"],["の"],["よう"],["な"],["正い","ただしい"],["定め","さだめ"],["と"],["、"],["おきて"],["と"],["が"],["あるで"],["あろう"],["か"],["。"]]},{"verse":9,"text":"ただあなたはみずから慎,つつしみ、またあなた自身,じしんをよく守,まもりなさい。そして目,めに見,みたことを忘,わすれず、生,いきながらえている間,あいだ、それらの事,ことをあなたの心,こころから離,はなしてはならない。またそれらのことを、あなたの子孫,しそんに知,しらせなければならない。","tok":[["ただ"],["あなた"],["は"],["みずから"],["慎しみ","つつしみ"],["、"],["また"],["あなた"],["自身","じしん"],["を"],["よく"],["守り","まもり"],["なさい"],["。"],["そして"],["目","め"],["に"],["見た","みた"],["こと"],["を"],["忘ず","わすれず"],["、"],["生きながらえて","いきながらえて"],["いる"],["間","あいだ"],["、"],["それ"],["ら"],["の"],["事","こと"],["を"],["あなた"],["の"],["心","こころ"],["から"],["離して","はなして"],["は"],["ならない"],["。"],["また"],["それ"],["ら"],["の"],["こと"],["を"],["、"],["あなた"],["の"],["子孫","しそん"],["に"],["知らせなければ","しらせなければ"],["ならない"],["。"]]},{"verse":10,"text":"あなたがホレブにおいて、あなたの神,かみ、主,しゅの前,まえに立,たった日,ひに、主,しゅはわたしに言,いわれた、『民,たみをわたしのもとに集,あつめよ。わたしは彼,かれらにわたしの言葉,ことばを聞,きかせ、地上,ちじょうに生,いきながらえる間,あいだ、彼,かれらにわたしを恐,おそれることを学,まなばせ、またその子,こ供,ともを教,おしえることのできるようにさせよう』。","tok":[["あなた"],["が"],["ホレブ"],["に"],["おいて"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["立った","たった"],["日","ひ"],["に"],["、"],["主","しゅ"],["は"],["わたし"],["に"],["言われた","いわれた"],["、"],["『"],["民","たみ"],["を"],["わたし"],["の"],["もと"],["に"],["集めよ","あつめよ"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["に"],["わたし"],["の"],["言葉","ことば"],["を"],["聞かせ","きかせ"],["、"],["地上","ちじょう"],["に"],["生きながらえる","いきながらえる"],["間","あ"],["い"],["だ"],["、"],["彼","かれ"],["ら"],["に"],["わたし"],["を"],["恐れる","おそれる"],["こと"],["を"],["学ばせ","まなばせ"],["、"],["また"],["その"],["子供","ことも"],["を"],["教える","おしえる"],["こと"],["の"],["できる"],["よう"],["に"],["させよう"],["』"],["。"]]},{"verse":11,"text":"そこであなたがたは近,ちかづいて、山,やまのふもとに立,たったが、山,やまは火,ひで焼,やけて、その炎,ほのおは中天,ちゅうてんに達,たっし、暗黒,あんこくと雲,くもと濃,こい雲,くもとがあった。","tok":[["そこ"],["で"],["あなた"],["がた"],["は"],["近づいて","ちかづいて"],["、"],["山","やま"],["の"],["ふもと"],["に"],["立った","たった"],["が"],["、"],["山","やま"],["は"],["火","ひ"],["で"],["焼","やけ"],["て"],["、"],["その"],["炎","ほのお"],["は"],["中天","ちゅうてん"],["に"],["達し","たっし"],["、"],["暗黒","あんこく"],["と"],["雲","くも"],["と"],["濃い","こい"],["雲","くも"],["と"],["が"],["あった"],["。"]]},{"verse":12,"text":"時,ときに主,しゅは火,ひの中,なかから、あなたがたに語,かたられたが、あなたがたは言葉,ことばの声,こえを聞,きいたけれども、声,こえばかりで、なんの形,かたちも見,みなかった。","tok":[["時","とき"],["に"],["主","しゅ"],["は"],["火","ひ"],["の"],["中","なか"],["から"],["、"],["あなた"],["がた"],["に"],["語られた","かたられた"],["が"],["、"],["あなた"],["がた"],["は"],["言葉","ことば"],["の"],["声","こえ"],["を"],["聞いた","きいた"],["けれど"],["も"],["、"],["声","こえ"],["ばかり"],["で"],["、"],["なん"],["の"],["形","かたち"],["も"],["見なかった","みなかった"],["。"]]},{"verse":13,"text":"主,しゅはその契約,けいやくを述,のべて、それを行,おこなうように、あなたがたに命,めいじられた。それはすなわち十誡,じっかいであって、主,しゅはそれを二,に枚,まいの石,いしの板,いたに書,かきしるされた。","tok":[["主","しゅ"],["は"],["その"],["契約","けいやく"],["を"],["述べて","のべて"],["、"],["それ"],["を"],["行なう","おこなう"],["よう"],["に"],["、"],["あなた"],["がた"],["に"],["命じられた","めいじられた"],["。"],["それ"],["は"],["すなわち"],["十","じゅう"],["誡","かい"],["っ"],["かい"],["で"],["あって"],["、"],["主","しゅ"],["は"],["それ"],["を"],["二枚","にまい"],["の"],["石","いし"],["の"],["板","いた"],["に"],["書きしるされた","かきしるされた"],["。"]]},{"verse":14,"text":"その時,とき、主,しゅはわたしに命,めいじて、あなたがたに定,さだめと、おきてとを教,おしえさせられた。あなたがたが渡,わたって行,いって自分,じぶんのものとする地,ちで、行,おこなわせるためであった。","tok":[["その"],["時","とき"],["、"],["主","しゅ"],["は"],["わたし"],["に"],["命じて","めいじて"],["、"],["あなた"],["がた"],["に"],["定め","さだめ"],["と"],["、"],["おきて"],["と"],["を"],["教えさせられた","おしえさせられた"],["。"],["あなた"],["がた"],["が"],["渡って","わたって"],["行って","いって"],["自分","じぶん"],["の"],["もの"],["と"],["する"],["地","ち"],["で"],["、"],["行なわせる","おこなわせる"],["ため"],["で"],["あった"],["。"]]},{"verse":15,"text":"それゆえ、あなたがたはみずから深,ふかく慎,つつしまなければならない。ホレブで主,しゅが火,ひの中,なかからあなたがたに語,かたられた日,ひに、あなたがたはなんの形,かたちも見,みなかった。","tok":[["それ"],["ゆえ"],["、"],["あなた"],["がた"],["は"],["みずから"],["深く","ふかく"],["慎しまなければ","つつしまなければ"],["ならない"],["。"],["ホレブ"],["で"],["主","しゅ"],["が"],["火","ひ"],["の"],["中","なか"],["から"],["あなた"],["がた"],["に"],["語られた","かたられた"],["日","ひ"],["に"],["、"],["あなた"],["がた"],["は"],["なん"],["の"],["形","かたち"],["も"],["見なかった","みなかった"],["。"]]},{"verse":16,"text":"それであなたがたは道,みちを誤,あやまって、自分,じぶんのために、どんな形,かたちの刻,きざんだ像,ぞうをも造,つくってはならない。男,おとこまたは女,おんなの像,ぞうを造,つくってはならない。","tok":[["それ"],["で"],["あなた"],["がた"],["は"],["道","みち"],["を"],["誤って","あやまって"],["、"],["自分","じぶん"],["の"],["ため"],["に"],["、"],["どんな"],["形","かたち"],["の"],["刻んだ","きざんだ"],["像","ぞう"],["を"],["も"],["造って","つくって"],["は"],["ならない"],["。"],["男","おとこ"],["また"],["は"],["女","おんな"],["の"],["像","ぞう"],["を"],["造って","つくって"],["は"],["ならない"],["。"]]},{"verse":17,"text":"すなわち地,ちの上,うえにおるもろもろの獣,けものの像,ぞう、空,そらを飛,とぶもろもろの鳥,とりの像,ぞう、","tok":[["すなわち"],["地","ち"],["の"],["上","うえ"],["に"],["おる"],["もろもろ"],["の"],["獣","けもの"],["の"],["像","ぞう"],["、"],["空","そら"],["を"],["飛ぶ","とぶ"],["もろもろ"],["の"],["鳥","とり"],["の"],["像","ぞう"],["、"]]},{"verse":18,"text":"地,ちに這,はうもろもろの物,ものの像,ぞう、地,ちの下,したの水,みずの中,なかにおるもろもろの魚,うおの像,ぞうを造,つくってはならない。","tok":[["地","ち"],["に"],["這う","はう"],["もろもろ"],["の"],["物","もの"],["の"],["像","ぞう"],["、"],["地","ち"],["の"],["下","した"],["の"],["水","みず"],["の"],["中","なか"],["に"],["おる"],["もろもろ"],["の"],["魚","うお"],["の"],["像","ぞう"],["を"],["造って","つくって"],["は"],["ならない"],["。"]]},{"verse":19,"text":"あなたはまた目,めを上,あげて天,てんを望,のぞみ、日,ひ、月,つき、星,ほしすなわちすべて天,てんの万象,ばんしょうを見,み、誘惑,ゆうわくされてそれを拝,おがみ、それに仕,つかえてはならない。それらのものは、あなたの神,かみ、主,しゅが全,ぜん天下,てんかの万民,ばんみんに分,わけられたものである。","tok":[["あなた"],["は"],["また"],["目","め"],["を"],["上げて","あげて"],["天","てん"],["を"],["望み","のぞみ"],["、"],["日","ひ"],["、"],["月","つき"],["、"],["星","ほし"],["すなわち"],["すべて"],["天","てん"],["の"],["万象","ばんしょう"],["を"],["見","み"],["、"],["誘惑","ゆうわく"],["されて"],["それ"],["を"],["拝み","おがみ"],["、"],["それ"],["に"],["仕えて","つかえて"],["は"],["ならない"],["。"],["それ"],["ら"],["の"],["もの"],["は"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["全","ぜん"],["天下","てんか"],["の"],["万民","ばんみん"],["に"],["分けられた","わけられた"],["もの"],["で"],["ある"],["。"]]},{"verse":20,"text":"しかし、主,しゅはあなたがたを取,とって、鉄,てつの炉,ろすなわちエジプトから導,みちびき出,だし、自分,じぶんの所有,しょゆうの民,たみとされた。きょう、見,みるとおりである。","tok":[["しかし"],["、"],["主","しゅ"],["は"],["あなた"],["がた"],["を"],["取って","とって"],["、"],["鉄","てつ"],["の"],["炉","ろ"],["すなわち"],["エジプト"],["から"],["導き出し","みちびきだし"],["、"],["自分","じぶん"],["の"],["所有","しょゆう"],["の"],["民","たみ"],["と"],["された"],["。"],["きょう"],["、"],["見る","みる"],["とおり"],["で"],["ある"],["。"]]},{"verse":21,"text":"ところで主,しゅはあなたがたのゆえに、わたしを怒,いかり、わたしがヨルダンを渡,わたって行,いくことができないことと、あなたの神,かみ、主,しゅが嗣,し業,ぎょうとしてあなたに賜,たまわる良,よい地,ちにはいることができないこととを誓,ちかわれた。","tok":[["ところ"],["で"],["主","しゅ"],["は"],["あなた"],["がた"],["の"],["ゆえ"],["に"],["、"],["わたし"],["を"],["怒り","いかり"],["、"],["わたし"],["が"],["ヨルダン"],["を"],["渡って","わたって"],["行く","いく"],["こと"],["が"],["できない"],["こと"],["と"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["嗣業","しぎょう"],["として"],["あなた"],["に"],["賜わる","たまわる"],["良い","よい"],["地","ち"],["に"],["はいる"],["こと"],["が"],["できない"],["こと"],["と"],["を"],["誓われた","ちかわれた"],["。"]]},{"verse":22,"text":"わたしはこの地,ちで死,しぬ。ヨルダンを渡,わたって行,いくことはできない。しかしあなたがたは渡,わたって行,いって、あの良,よい地,ちを獲,えるであろう。","tok":[["わたし"],["は"],["この"],["地","ち"],["で"],["死ぬ","しぬ"],["。"],["ヨルダン"],["を"],["渡って","わたって"],["行く","いく"],["こと"],["は"],["できない"],["。"],["しかし"],["あなた"],["がた"],["は"],["渡って","わたって"],["行って","いって"],["、"],["あの"],["良い","よい"],["地","ち"],["を"],["獲るで","えるで"],["あろう"],["。"]]},{"verse":23,"text":"あなたがたは慎,つつしみ、あなたがたの神,かみ、主,しゅがあなたがたと結,むすばれた契約,けいやくを忘,わすれて、あなたの神,かみ、主,しゅが禁,きんじられたどんな形,かたちの刻,きざんだ像,ぞうをも造,つくってはならない。","tok":[["あなた"],["がた"],["は"],["慎しみ","つつしみ"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["あなた"],["がた"],["と"],["結ばれた","むすばれた"],["契約","けいやく"],["を"],["忘て","わすれて"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["禁じられた","きんじられた"],["どんな"],["形","かたち"],["の"],["刻んだ","きざんだ"],["像","ぞう"],["を"],["も"],["造って","つくって"],["は"],["ならない"],["。"]]},{"verse":24,"text":"あなたの神,かみ、主,しゅは焼,やきつくす火,ひ、ねたむ神,かみである。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["焼き","やき"],["つくす"],["火","ひ"],["、"],["ねたむ"],["神","かみ"],["で"],["ある"],["。"]]},{"verse":25,"text":"あなたがたが子,こを生,うみ、孫,まごを得,え、長,ながくその地,ちにおるうちに、道,みちを誤,あやまって、すべて何,なにかの形,かたちに刻,きざんだ像,ぞうを造,つくり、あなたの神,かみ、主,しゅの目,めの前,まえに悪,あくをなして、その憤,いきどおりを引,ひき起,おこすことがあれば、","tok":[["あなた"],["がた"],["が"],["子","こ"],["を"],["生み","うみ"],["、"],["孫","まご"],["を"],["得","え"],["、"],["長く","ながく"],["その"],["地","ち"],["に"],["おる"],["うち"],["に"],["、"],["道","みち"],["を"],["誤って","あやまって"],["、"],["すべて"],["何に","なに"],["か"],["の"],["形","かたち"],["に"],["刻んだ","きざんだ"],["像","ぞう"],["を"],["造","つくり"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["目","め"],["の"],["前","まえ"],["に"],["悪","あく"],["を"],["なして"],["、"],["その"],["憤り","いきどおり"],["を"],["引起こす","ひきおこす"],["こと"],["が"],["あれば"],["、"]]},{"verse":26,"text":"わたしは、きょう、天,てんと地,ちを呼,よんであなたがたに対,たいしてあかしとする。あなたがたはヨルダンを渡,わたって行,いって獲,える地,ちから、たちまち全滅,ぜんめつするであろう。あなたがたはその所,ところで長,ながく命,いのちを保,たもつことができず、全,まったく滅,ほろぼされるであろう。","tok":[["わたし"],["は"],["、"],["きょう"],["、"],["天","てん"],["と"],["地","ち"],["を"],["呼んで","よんで"],["あなた"],["がた"],["に対して","にたいして"],["あかし"],["と"],["する"],["。"],["あなた"],["がた"],["は"],["ヨルダン"],["を"],["渡って","わたって"],["行って","いって"],["獲る","える"],["地","ち"],["から"],["、"],["たちまち"],["全滅","ぜんめつ"],["するで"],["あろう"],["。"],["あなた"],["がた"],["は"],["その"],["所","ところ"],["で"],["長く","ながく"],["命","いのち"],["を"],["保つ","たもつ"],["こと"],["が"],["できず"],["、"],["全く","まったく"],["滅ぼされるで","ほろぼされるで"],["あろう"],["。"]]},{"verse":27,"text":"主,しゅはあなたがたを国々,くにぐにに散,ちらされるであろう。そして主,しゅがあなたがたを追,おいやられる国民,こくみんのうちに、あなたがたの残,のこる者,ものの数,かずは少,すくないであろう。","tok":[["主","しゅ"],["は"],["あなた"],["がた"],["を"],["国々","くにぐに"],["に"],["散らされるで","ちらされるで"],["あろう"],["。"],["そして"],["主","しゅ"],["が"],["あなた"],["がた"],["を"],["追いやられる","おいやられる"],["国民","こくみん"],["の"],["うち"],["に"],["、"],["あなた"],["がた"],["の"],["残る","のこる"],["者","もの"],["の"],["数","かず"],["は"],["少いで","すくないで"],["あろう"],["。"]]},{"verse":28,"text":"その所,ところであなたがたは人,ひとが手,てで作,つくった、見,みることも、聞,きくことも、食,たべることも、かぐこともない木,きや石,いしの神々,かみがみに仕,つかえるであろう。","tok":[["その"],["所","ところ"],["で"],["あなた"],["がた"],["は"],["人","ひと"],["が"],["手","て"],["で"],["作った","つくった"],["、"],["見る","みる"],["こと"],["も"],["、"],["聞く","きく"],["こと"],["も"],["、"],["食べる","たべる"],["こと"],["も"],["、"],["かぐ"],["こと"],["も"],["ない"],["木","き"],["や"],["石","いし"],["の"],["神々","かみがみ"],["に"],["仕えるで","つかえるで"],["あろう"],["。"]]},{"verse":29,"text":"しかし、その所,ところからあなたの神,かみ、主,しゅを求,もとめ、もし心,こころをつくし、精神,せいしんをつくして、主,しゅを求,もとめるならば、あなたは主,しゅに会,あうであろう。","tok":[["しかし"],["、"],["その"],["所","ところ"],["から"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["を"],["求め","もとめ"],["、"],["もし"],["心","こころ"],["を"],["つくし"],["、"],["精神","せいしん"],["を"],["つくして"],["、"],["主","しゅ"],["を"],["求めるならば","もとめるならば"],["、"],["あなた"],["は"],["主に","しゅに"],["会うで","あうで"],["あろう"],["。"]]},{"verse":30,"text":"後,のちの日,ひになって、あなたがなやみにあい、これらのすべての事,ことが、あなたに臨,のぞむとき、もしあなたの神,かみ、主,しゅに立,たち帰,かえってその声,こえに聞,ききしたがうならば、","tok":[["後","のち"],["の"],["日","ひ"],["に"],["なって"],["、"],["あなた"],["が"],["なやみ"],["に"],["あい"],["、"],["これ"],["ら"],["の"],["すべて"],["の"],["事","こと"],["が"],["、"],["あなた"],["に"],["臨む","のぞむ"],["とき"],["、"],["もし"],["あなた"],["の"],["神","かみ"],["、"],["主に","しゅに"],["立ち","たち"],["帰えって","かえって"],["その"],["声","こえ"],["に"],["聞","きき"],["したがうならば"],["、"]]},{"verse":31,"text":"あなたの神,かみ、主,しゅはいつくしみの深,ふかい神,かみであるから、あなたを捨,すてず、あなたを滅,ほろぼさず、またあなたの先祖,せんぞに誓,ちかった契約,けいやくを忘,わすれられないであろう。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["いつくしみ"],["の"],["深い","ふかい"],["神","かみ"],["で"],["ある"],["から"],["、"],["あなた"],["を"],["捨てず","すてず"],["、"],["あなた"],["を"],["滅ぼさず","ほろぼさず"],["、"],["また"],["あなた"],["の"],["先祖","せんぞ"],["に"],["誓った","ちかった"],["契約","けいやく"],["を"],["忘られないで","わすれられないで"],["あろう"],["。"]]},{"verse":32,"text":"試,こころみにあなたの前,まえに過,すぎ去,さった日,ひについて問,とえ。神,かみが地上,ちじょうに人,ひとを造,つくられた日,ひからこのかた、天,てんのこの端,はしから、かの端,はしまでに、かつてこのように大,おおいなる事,ことがあったであろうか。このようなことを聞,きいたことがあったであろうか。","tok":[["試み","こころみ"],["に"],["あなた"],["の"],["前","まえ"],["に"],["過去","すぎさっ"],["た"],["日","ひ"],["について"],["問え","とえ"],["。"],["神","かみ"],["が"],["地上","ちじょう"],["に"],["人","ひと"],["を"],["造られた","つくられた"],["日","ひ"],["から"],["このかた"],["、"],["天","てん"],["の"],["この"],["端","はし"],["から"],["、"],["かの"],["端","はし"],["まで"],["に"],["、"],["かつて"],["この"],["よう"],["に"],["大いなる","おおいなる"],["事","こと"],["が"],["あったで"],["あろう"],["か"],["。"],["この"],["よう"],["な"],["こと"],["を"],["聞いた","きいた"],["こと"],["が"],["あったで"],["あろう"],["か"],["。"]]},{"verse":33,"text":"火,ひの中,なかから語,かたられる神,かみの声,こえをあなたが聞,きいたように、聞,きいてなお生,いきていた民,たみがかつてあったであろうか。","tok":[["火","ひ"],["の"],["中","なか"],["から"],["語られる","かたられる"],["神","かみ"],["の"],["声","こえ"],["を"],["あなた"],["が"],["聞いた","きいた"],["よう"],["に"],["、"],["聞いて","きいて"],["なお"],["生きて","いきて"],["いた"],["民","たみ"],["が"],["かつて"],["あったで"],["あろう"],["か"],["。"]]},{"verse":34,"text":"あるいはまた、あなたがたの神,かみ、主,しゅがエジプトにおいて、あなたがたの目,めの前,まえに、あなたがたのためにもろもろの事,ことをなされたように、試,こころみと、しるしと、不思議,ふしぎと、戦,たたかいと、強,つよい手,てと、伸,のばした腕,うでと、大,おおいなる恐,おそるべき事,こととをもって臨,のぞみ、一つの国民,こくみんを他,たの国民,こくみんのうちから引,ひき出,だして、自分,じぶんの民,たみとされた神,かみが、かつてあったであろうか。","tok":[["あるいは"],["また"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["エジプト"],["に"],["おいて"],["、"],["あなた"],["がた"],["の"],["目","め"],["の"],["前","まえ"],["に"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["もろもろ"],["の"],["事","こと"],["を"],["なされた"],["よう"],["に"],["、"],["試み","こころみ"],["と"],["、"],["しるし"],["と"],["、"],["不思議","ふしぎ"],["と"],["、"],["戦い","たたかい"],["と"],["、"],["強い","つよい"],["手","て"],["と"],["、"],["伸ばした","のばした"],["腕","うで"],["と"],["、"],["大いなる","おおいなる"],["恐るべき","おそるべき"],["事","こと"],["と"],["を"],["もって"],["臨み","のぞみ"],["、"],["一","ひと"],["つ"],["の"],["国民","こくみん"],["を"],["他","た"],["の"],["国民","こくみん"],["の"],["うち"],["から"],["引出して","ひきだして"],["、"],["自分","じぶん"],["の"],["民","たみ"],["と"],["された"],["神","かみ"],["が"],["、"],["かつて"],["あったで"],["あろう"],["か"],["。"]]},{"verse":35,"text":"あなたにこの事,ことを示,しめしたのは、主,しゅこそ神,かみであって、ほかに神,かみのないことを知,しらせるためであった。","tok":[["あなた"],["に"],["この"],["事","こと"],["を"],["示めした","しめした"],["の"],["は"],["、"],["主","しゅ"],["こそ"],["神","かみ"],["で"],["あって"],["、"],["ほか"],["に"],["神","かみ"],["の"],["ない"],["こと"],["を"],["知らせる","しらせる"],["ため"],["で"],["あった"],["。"]]},{"verse":36,"text":"あなたを訓練,くんれんするために、主,しゅは天,てんからその声,こえを聞,きかせ、地上,ちじょうでは、またその大,おおいなる火,ひを示,しめされた。あなたはその言葉,ことばが火,ひの中,なかから出,でるのを聞,きいた。","tok":[["あなた"],["を"],["訓練","くんれん"],["する"],["ため"],["に"],["、"],["主","しゅ"],["は"],["天","てん"],["から"],["その"],["声","こえ"],["を"],["聞かせ","きかせ"],["、"],["地上","ちじょう"],["で"],["は"],["、"],["また"],["その"],["大いなる","おおいなる"],["火","ひ"],["を"],["示めされた","しめされた"],["。"],["あなた"],["は"],["その"],["言葉","ことば"],["が"],["火","ひ"],["の"],["中","なか"],["から"],["出る","でる"],["の"],["を"],["聞いた","きいた"],["。"]]},{"verse":37,"text":"主,しゅはあなたの先祖,せんぞたちを愛,あいされたので、その後,のちの子孫,しそんを選,えらび、大,おおいなる力,ちからをもって、みずからあなたをエジプトから導,みちびき出,だし、","tok":[["主","しゅ"],["は"],["あなた"],["の"],["先祖","せんぞ"],["たち"],["を"],["愛された","あいされた"],["ので"],["、"],["その後","そののち"],["の"],["子孫","しそん"],["を"],["選ら","えら"],["び"],["、"],["大いなる","おおいなる"],["力","ちから"],["を"],["もって"],["、"],["みずから"],["あなた"],["を"],["エジプト"],["から"],["導き出し","みちびきだし"],["、"]]},{"verse":38,"text":"あなたよりも大,おおきく、かつ強,つよいもろもろの国民,こくみんを、あなたの前,まえから追,おい払,はらい、あなたをその地,ちに導,みちびき入,いれて、これを嗣,し業,ぎょうとしてあなたに与,あたえようとされること、今日,こんにち見,みるとおりである。","tok":[["あなた"],["より"],["も"],["大きく","おおきく"],["、"],["かつ"],["強い","つよい"],["もろもろ"],["の"],["国民","こくみん"],["を"],["、"],["あなた"],["の"],["前","まえ"],["から"],["追い払","おいはらい"],["、"],["あなた"],["を"],["その"],["地","ち"],["に"],["導き入れて","みちびきいれて"],["、"],["これ"],["を"],["嗣業","しぎょう"],["として"],["あなた"],["に"],["与","あたえ"],["よう"],["と"],["される"],["こと"],["、"],["今日","こん"],["に"],["ち"],["見る","みる"],["とおり"],["で"],["ある"],["。"]]},{"verse":39,"text":"それゆえ、あなたは、きょう知,しって、心,こころにとめなければならない。上,うえは天,てん、下,したは地,ちにおいて、主,しゅこそ神,かみにいまし、ほかに神,かみのないことを。","tok":[["それ"],["ゆえ"],["、"],["あなた"],["は"],["、"],["きょう"],["知って","しって"],["、"],["心","こころ"],["に"],["とめなければ"],["ならない"],["。"],["上","うえ"],["は"],["天","てん"],["、"],["下","した"],["は"],["地","ち"],["に"],["おいて"],["、"],["主","しゅ"],["こそ"],["神","かみ"],["に"],["いまし"],["、"],["ほか"],["に"],["神","かみ"],["の"],["ない"],["こと"],["を"],["。"]]},{"verse":40,"text":"あなたは、きょう、わたしが命,めいじる主,しゅの定,さだめと命令,めいれいとを守,まもらなければならない。そうすれば、あなたとあなたの後,のちの子孫,しそんはさいわいを得,え、あなたの神,かみ、主,しゅが永久,えいきゅうにあなたに賜,たまわる地,ちにおいて、長,ながく命,いのちを保,たもつことができるであろう」。","tok":[["あなた"],["は"],["、"],["きょう"],["、"],["わたし"],["が"],["命じる","めいじる"],["主","しゅ"],["の"],["定め","さだめ"],["と"],["命令","めいれい"],["と"],["を"],["守らなければ","まもらなければ"],["ならない"],["。"],["そう"],["すれば"],["、"],["あなた"],["と"],["あなた"],["の"],["後","のち"],["の"],["子孫","しそん"],["は"],["さいわい"],["を"],["得","え"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["永久","えいきゅう"],["に"],["あなた"],["に"],["賜わる","たまわる"],["地","ち"],["に"],["おいて"],["、"],["長く","ながく"],["命","いのち"],["を"],["保つ","たもつ"],["こと"],["が"],["できるで"],["あろう"],["」"],["。"]]},{"verse":41,"text":"それからモーセはヨルダンの向,むこう側,がわ、東,ひがしの方,ほうに三つの町々,まちまちを指定,していした。","tok":[["それ"],["から"],["モーセ"],["は"],["ヨルダン"],["の"],["向こう側","むこうがわ"],["、"],["東","ひがし"],["の"],["方","ほう"],["に"],["三","みっ"],["つ"],["の"],["町々","まちまち"],["を"],["指定","してい"],["した"],["。"]]},{"verse":42,"text":"過去,かこの恨,うらみによるのではなく、あやまって隣人,りんじんを殺,ころした者,ものをそこにのがれさせ、その町,まちの一つにのがれて、命,いのちを全,まっとうさせるためであった。","tok":[["過去","かこ"],["の"],["恨み","うらみ"],["に"],["よる"],["ので"],["は"],["なく"],["、"],["あやまって"],["隣人","りんじん"],["を"],["殺ろした","ころした"],["者","もの"],["を"],["そこ"],["に"],["のがれさせ"],["、"],["その"],["町","まち"],["の"],["一","ひと"],["つ"],["に"],["のがれて"],["、"],["命","いのち"],["を"],["全う","まっとう"],["させる"],["ため"],["で"],["あった"],["。"]]},{"verse":43,"text":"すなわちルベンびとのためには荒野,あらのの中,なかの高地,こうちにあるベゼルを、ガドびとのためにはギレアデのラモテを、マナセびとのためにはバシャンのゴランを定,さだめた。","tok":[["すなわち"],["ルベン"],["びと"],["の"],["ため"],["に"],["は"],["荒野","あら"],["の"],["の"],["中","なか"],["の"],["高地","こうち"],["に"],["ある"],["ベゼル"],["を"],["、"],["ガド"],["びと"],["の"],["ため"],["に"],["は"],["ギレアデ"],["の"],["ラモテ"],["を"],["、"],["マナセ"],["びと"],["の"],["ため"],["に"],["は"],["バシャン"],["の"],["ゴラン"],["を"],["定めた","さだめた"],["。"]]},{"verse":44,"text":"モーセがイスラエルの人々,ひとびとの前,まえに示,しめした律法,りっぽうはこれである。","tok":[["モーセ"],["が"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["前","まえ"],["に"],["示めした","しめした"],["律法","りっぽう"],["は"],["これ"],["で"],["ある"],["。"]]},{"verse":45,"text":"イスラエルの人々,ひとびとがエジプトから出,でたとき、モーセが彼,かれらに述,のべたあかしと、定,さだめと、おきてとはこれである。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["が"],["エジプト"],["から"],["出た","でた"],["とき"],["、"],["モーセ"],["が"],["彼","かれ"],["ら"],["に"],["述べた","のべた"],["あかし"],["と"],["、"],["定め","さだめ"],["と"],["、"],["おきて"],["と"],["は"],["これ"],["で"],["ある"],["。"]]},{"verse":46,"text":"すなわちヨルダンの向,むこう側,がわ、アモリびとの王,おうシホンの国,くにのベテペオルに対,たいする谷,たににおいてこれを述,のべた。シホンはヘシボンに住,すんでいたが、モーセとイスラエルの人々,ひとびとが、エジプトを出,でてきた時,とき、これを撃,うち敗,やぶって、","tok":[["すなわち"],["ヨルダン"],["の"],["向こう側","むこうがわ"],["、"],["アモリ"],["びと"],["の"],["王","おう"],["シホン"],["の"],["国","くに"],["の"],["ベテペオル"],["に"],["対する","たいする"],["谷","たに"],["に"],["おいて"],["これ"],["を"],["述べた","のべた"],["。"],["シホン"],["は"],["ヘシボン"],["に"],["住んで","すんで"],["いた"],["が"],["、"],["モーセ"],["と"],["イスラエル"],["の"],["人々","ひとびと"],["が"],["、"],["エジプト"],["を"],["出て","でて"],["きた"],["時","とき"],["、"],["これ"],["を"],["撃ち","うち"],["敗って","やぶって"],["、"]]},{"verse":47,"text":"その国,くにを獲,え、またバシャンの王,おうオグの国,くにを獲,えた。このふたりはアモリびとの王,おうであって、ヨルダンの向,むこう側,がわ、東,ひがしの方,ほうにおった。","tok":[["その"],["国","くに"],["を"],["獲","え"],["、"],["また"],["バシャン"],["の"],["王","おう"],["オグ"],["の"],["国","くに"],["を"],["獲た","えた"],["。"],["この"],["ふたり"],["は"],["アモリ"],["びと"],["の"],["王","おう"],["で"],["あって"],["、"],["ヨルダン"],["の"],["向こう側","むこうがわ"],["、"],["東","ひがし"],["の"],["方","ほう"],["に"],["おった"],["。"]]},{"verse":48,"text":"彼,かれらの獲,えた地,ちはアルノン川,がわのほとりにあるアロエルからシリオン山,ざんすなわちヘルモンに及,および、","tok":[["彼","かれ"],["ら"],["の"],["獲た","えた"],["地","ち"],["は"],["アルノン"],["川","がわ"],["の"],["ほとり"],["に"],["ある"],["アロエル"],["から"],["シリオン"],["山","ざん"],["すなわち"],["ヘルモン"],["に"],["及","および"],["、"]]},{"verse":49,"text":"ヨルダンの東側,ひがしがわのアラバの全部,ぜんぶをかねて、アラバの海,うみに達,たっし、ピスガのふもとに及,およんだ。","tok":[["ヨルダン"],["の"],["東側","ひがしがわ"],["の"],["アラバ"],["の"],["全部","ぜんぶ"],["を"],["かねて"],["、"],["アラバ"],["の"],["海","うみ"],["に"],["達し","たっし"],["、"],["ピスガ"],["の"],["ふもと"],["に"],["及んだ","およんだ"],["。"]]}]
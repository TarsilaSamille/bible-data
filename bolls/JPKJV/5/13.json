[{"verse":1,"text":"[12:32]あなたがたはわたしが命,めいじるこのすべての事,ことを守,まもって行,おこなわなければならない。これにつけ加,くわえてはならない。また減,へらしてはならない。","tok":[["["],["12"],[":"],["32"],["]"],["あなた"],["がた"],["は"],["わたし"],["が"],["命じる","めいじる"],["この"],["すべて"],["の"],["事","こと"],["を"],["守って","まもって"],["行なわなければ","おこなわなければ"],["ならない"],["。"],["これ"],["に"],["つけ加えて","つけくわえて"],["は"],["ならない"],["。"],["また"],["減らして","へらして"],["は"],["ならない"],["。"]]},{"verse":2,"text":"[1]あなたがたのうちに預言者,よげんしゃまたは夢,ゆめみる者,ものが起,たって、しるしや奇跡,きせきを示,しめし、","tok":[["["],["1"],["]"],["あなた"],["がた"],["の"],["うち"],["に"],["預言者","よげんしゃ"],["また"],["は"],["夢みる","ゆめみる"],["者","もの"],["が"],["起って","たって"],["、"],["しるし"],["や"],["奇跡","きせき"],["を"],["示めし","しめし"],["、"]]},{"verse":3,"text":"[2]あなたに告,つげるそのしるしや奇跡,きせきが実現,じつげんして、あなたがこれまで知,しらなかった『ほかの神々,かみがみに、われわれは従,したがい仕,つかえよう』と言,いっても、","tok":[["["],["2"],["]"],["あなた"],["に"],["告げる","つげる"],["その"],["しるし"],["や"],["奇跡","きせき"],["が"],["実現","じつげん"],["して"],["、"],["あなた"],["が"],["これ"],["まで"],["知らなかった","しらなかった"],["『"],["ほか"],["の"],["神々","かみがみ"],["に"],["、"],["われわれ"],["は"],["従い","したがい"],["仕えよう","つかえよう"],["』"],["と"],["言って","いって"],["も"],["、"]]},{"verse":4,"text":"[3]あなたはその預言者,よげんしゃまたは夢,ゆめみる者,ものの言葉,ことばに聞,きき従,したがってはならない。あなたがたの神,かみ、主,しゅはあなたがたが心,こころをつくし、精神,せいしんをつくして、あなたがたの神,かみ、主,しゅを愛,あいするか、どうかを知,しろうと、このようにあなたがたを試,こころみられるからである。","tok":[["["],["3"],["]"],["あなた"],["は"],["その"],["預言者","よげんしゃ"],["また"],["は"],["夢みる","ゆめみる"],["者","もの"],["の"],["言葉","ことば"],["に"],["聞","きき"],["従って","したがって"],["は"],["ならない"],["。"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["あなた"],["がた"],["が"],["心","こころ"],["を"],["つくし"],["、"],["精神","せいしん"],["を"],["つくして"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["を"],["愛する","あいする"],["か"],["、"],["どう"],["か"],["を"],["知ろう","しろう"],["と"],["、"],["この"],["よう"],["に"],["あなた"],["がた"],["を"],["試みられる","こころみられる"],["から"],["で"],["ある"],["。"]]},{"verse":5,"text":"[4]あなたがたの神,かみ、主,しゅに従,したがって歩,あゆみ、彼,かれを恐,おそれ、その戒,いましめを守,まもり、その言葉,ことばに聞,きき従,したがい、彼,かれに仕,つかえ、彼,かれにつき従,したがわなければならない。","tok":[["["],["4"],["]"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主に","しゅに"],["従って","したがって"],["歩","あゆみ"],["、"],["彼","かれ"],["を"],["恐","おそれ"],["、"],["その"],["戒しめ","いましめ"],["を"],["守り","まもり"],["、"],["その"],["言葉","ことば"],["に"],["聞","きき"],["従い","したがい"],["、"],["彼","かれ"],["に"],["仕え","つかえ"],["、"],["彼","かれ"],["に"],["つき従わなければ","つきしたがわなければ"],["ならない"],["。"]]},{"verse":6,"text":"[5]その預言者,よげんしゃまたは夢,ゆめみる者,ものを殺,ころさなければならない。あなたがたをエジプトの国,くにから導,みちびき出,だし、奴隷,どれいの家,いえからあがなわれたあなたがたの神,かみ、主,しゅにあなたがたをそむかせ、あなたの神,かみ、主,しゅが歩,あゆめと命,めいじられた道,みちを離,はなれさせようとして語,かたるゆえである。こうしてあなたがたのうちから悪,あくを除,のぞき去,さらなければならない。","tok":[["["],["5"],["]"],["その"],["預言者","よげんしゃ"],["また"],["は"],["夢みる","ゆめみる"],["者","もの"],["を"],["殺ろさなければ","ころさなければ"],["ならない"],["。"],["あなた"],["がた"],["を"],["エジプト"],["の"],["国","くに"],["から"],["導き出し","みちびきだし"],["、"],["奴隷","どれい"],["の"],["家","いえ"],["から"],["あがなわれた"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主に","しゅに"],["あなた"],["がた"],["を"],["そむかせ"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["歩め","あゆめ"],["と"],["命じられた","めいじられた"],["道","みち"],["を"],["離れさせよう","はなれさせよう"],["として"],["語る","かたる"],["ゆえ"],["で"],["ある"],["。"],["こう"],["して"],["あなた"],["がた"],["の"],["うち"],["から"],["悪","あく"],["を"],["除き去らなければ","のぞきさらなければ"],["ならない"],["。"]]},{"verse":7,"text":"[6]同,おなじ母,ははに生,うまれたあなたの兄弟,きょうだい、またはあなたのむすこ、娘,むすめ、またはあなたのふところの妻,つま、またはあなたと身命,しんめいを共,ともにする友,ともが、ひそかに誘,さそって『われわれは行,いって他,たの神々,かみがみに仕,つかえよう』と言,いうかも知,しれない。これはあなたも先祖,せんぞたちも知,しらなかった神々,かみがみ、","tok":[["["],["6"],["]"],["同じ","おなじ"],["母","はは"],["に"],["生まれた","うまれた"],["あなた"],["の"],["兄弟","きょうだい"],["、"],["また"],["は"],["あなた"],["の"],["むすこ"],["、"],["娘","むすめ"],["、"],["また"],["は"],["あなた"],["の"],["ふところ"],["の"],["妻","つま"],["、"],["また"],["は"],["あなた"],["と"],["身命","しんめい"],["を"],["共","とも"],["に"],["する"],["友","とも"],["が"],["、"],["ひそか"],["に"],["誘って","さそって"],["『"],["われわれ"],["は"],["行って","いって"],["他","た"],["の"],["神々","かみがみ"],["に"],["仕えよう","つかえよう"],["』"],["と"],["言","いうか"],["も"],["知れない","しれない"],["。"],["これ"],["は"],["あなた"],["も"],["先祖","せんぞ"],["たち"],["も"],["知らなかった","しらなかった"],["神々","かみがみ"],["、"]]},{"verse":8,"text":"[7]すなわち地,ちのこのはてから、地,ちのかのはてまで、あるいは近,ちかく、あるいは遠,とおく、あなたの周囲,しゅういにある民,たみの神々,かみがみである。","tok":[["["],["7"],["]"],["すなわち"],["地","ち"],["の"],["この"],["はて"],["から"],["、"],["地","ち"],["の"],["かの"],["はて"],["まで"],["、"],["あるいは"],["近く","ちかく"],["、"],["あるいは"],["遠く","とおく"],["、"],["あなた"],["の"],["周囲","しゅうい"],["に"],["ある"],["民","たみ"],["の"],["神々","かみがみ"],["で"],["ある"],["。"]]},{"verse":9,"text":"[8]しかし、あなたはその人,ひとに従,したがってはならない。その人,ひとの言,いうことを聞,きいてはならない。その人,ひとをあわれんではならない。その人,ひとを惜,おしんではならない。その人,ひとをかばってはならない。","tok":[["["],["8"],["]"],["しかし"],["、"],["あなた"],["は"],["その"],["人","ひと"],["に"],["従って","したがって"],["は"],["ならない"],["。"],["その"],["人","ひと"],["の"],["言う","いう"],["こと"],["を"],["聞いて","きいて"],["は"],["ならない"],["。"],["その"],["人","ひと"],["を"],["あわれんで"],["は"],["ならない"],["。"],["その"],["人","ひと"],["を"],["惜しんで","おしんで"],["は"],["ならない"],["。"],["その"],["人","ひと"],["を"],["かばって"],["は"],["ならない"],["。"]]},{"verse":10,"text":"[9]必,かならず彼,かれを殺,ころさなければならない。彼,かれを殺,ころすには、あなたがまず彼,かれに手,てを下,くだし、その後,のち、民,たみがみな手,てを下,くださなければならない。","tok":[["["],["9"],["]"],["必","かならず"],["彼","かれ"],["を"],["殺ろさなければ","ころさなければ"],["ならない"],["。"],["彼","かれ"],["を"],["殺ろす","ころす"],["に"],["は"],["、"],["あなた"],["が"],["まず"],["彼","かれ"],["に"],["手","て"],["を"],["下し","くだし"],["、"],["その後","そのの"],["ち"],["、"],["民","た"],["み"],["が"],["みな"],["手","て"],["を"],["下さなければ","くださなければ"],["ならない"],["。"]]},{"verse":11,"text":"[10]彼,かれはエジプトの国,くに、奴隷,どれいの家,いえからあなたを導,みちびき出,だされたあなたの神,かみ、主,しゅからあなたを離,はなれさせようとしたのであるから、あなたは石,いしをもって彼,かれを撃,うち殺,ころさなければならない。","tok":[["["],["10"],["]"],["彼","かれ"],["は"],["エジプト"],["の"],["国","くに"],["、"],["奴隷","どれい"],["の"],["家","いえ"],["から"],["あなた"],["を"],["導き出された","みちびきだされた"],["あなた"],["の"],["神","かみ"],["、"],["主ら","しゅから"],["あなた"],["を"],["離れさせよう","はなれさせよう"],["と"],["した"],["ので"],["ある"],["から"],["、"],["あなた"],["は"],["石","いし"],["を"],["もって"],["彼","かれ"],["を"],["撃ち","うち"],["殺ろさなければ","ころさなければ"],["ならない"],["。"]]},{"verse":12,"text":"[11]そうすればイスラエルは皆,みな聞,きいて恐,おそれ、重,かさねてこのような悪,わるい事,ことを、あなたがたのうちに行,おこなわないであろう。","tok":[["["],["11"],["]"],["そう"],["すれば"],["イスラエル"],["は"],["皆","みな"],["聞いて","きいて"],["恐","おそれ"],["、"],["重ねて","かさねて"],["この"],["よう"],["な"],["悪い","わるい"],["事","こと"],["を"],["、"],["あなた"],["がた"],["の"],["うち"],["に"],["行なわないで","おこなわないで"],["あろう"],["。"]]},{"verse":13,"text":"[12]あなたの神,かみ、主,しゅがあなたに与,あたえて住,すまわせられる町,まちの一つで、","tok":[["["],["12"],["]"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["あなた"],["に"],["与","あたえ"],["て"],["住まわせられる","すまわせられる"],["町","まち"],["の"],["一","ひと"],["つ"],["で"],["、"]]},{"verse":14,"text":"[13]よこしまな人々,ひとびとがあなたがたのうちに起,たって、あなたがたの知,しらなかった『ほかの神々,かみがみに、われわれは行,いって仕,つかえよう』と言,いって、その町,まちに住,すむ人々,ひとびとを誘惑,ゆうわくしたことを聞,きくならば、","tok":[["["],["13"],["]"],["よこしま"],["な"],["人々","ひとびと"],["が"],["あなた"],["がた"],["の"],["うち"],["に"],["起って","たって"],["、"],["あなた"],["がた"],["の"],["知らなかった","しらなかった"],["『"],["ほか"],["の"],["神々","かみがみ"],["に"],["、"],["われわれ"],["は"],["行って","いって"],["仕えよう","つかえよう"],["』"],["と"],["言って","いって"],["、"],["その"],["町","まち"],["に"],["住む","すむ"],["人々","ひとびと"],["を"],["誘惑","ゆうわく"],["した"],["こと"],["を"],["聞くならば","きくならば"],["、"]]},{"verse":15,"text":"[14]あなたはそれを尋,たずね、探,さぐり、よく問,といたださなければならない。そして、そのような憎,にくむべき事,ことがあなたがたのうちに行,おこなわれた事,ことが、真実,しんじつで、確,たしかならば、","tok":[["["],["14"],["]"],["あなた"],["は"],["それ"],["を"],["尋ね","たずね"],["、"],["探ぐり","さぐり"],["、"],["よく"],["問","とい"],["たださなければ"],["ならない"],["。"],["そして"],["、"],["その"],["よう"],["な"],["憎むべき","にくむべき"],["事","こと"],["が"],["あなた"],["がた"],["の"],["うち"],["に"],["行なわれた","おこなわれた"],["事","こと"],["が"],["、"],["真実","しんじつ"],["で"],["、"],["確か","たしか"],["ならば"],["、"]]},{"verse":16,"text":"[15]あなたは必,かならず、その町,まちに住,すむ者,ものをつるぎの刃,はにかけて撃,うち殺,ころし、その町,まちと、そのうちにおるすべての者,もの、およびその家畜,かちくをつるぎの刃,はにかけて、ことごとく滅,ほろぼさなければならない。","tok":[["["],["15"],["]"],["あなた"],["は"],["必","かならず"],["、"],["その"],["町","まち"],["に"],["住む","すむ"],["者","もの"],["を"],["つるぎ"],["の"],["刃","は"],["に"],["かけて"],["撃ち殺し","うちころし"],["、"],["その"],["町","まち"],["と"],["、"],["その"],["うち"],["に"],["おる"],["すべて"],["の"],["者","もの"],["、"],["および"],["その"],["家畜","かちく"],["を"],["つるぎ"],["の"],["刃","は"],["に"],["かけて"],["、"],["ことごとく"],["滅ぼさなければ","ほろぼさなければ"],["ならない"],["。"]]},{"verse":17,"text":"[16]またそのすべてのぶんどり物,ものは、町,まちの広場,ひろばの中央,ちゅうおうに集,あつめ、火,ひをもってその町,まちと、すべてのぶんどり物,ものとを、ことごとく焼,やいて、あなたの神,かみ、主,しゅにささげなければならない。これはながく荒塚,あらつかとなって、再,ふたたび建,たて直,なおされないであろう。","tok":[["["],["16"],["]"],["また"],["その"],["すべて"],["の"],["ぶんどり"],["物","もの"],["は"],["、"],["町","まち"],["の"],["広場","ひろば"],["の"],["中央","ちゅうおう"],["に"],["集め","あつめ"],["、"],["火","ひ"],["を"],["もって"],["その"],["町","まち"],["と"],["、"],["すべて"],["の"],["ぶんどり"],["物","もの"],["と"],["を"],["、"],["ことごとく"],["焼いて","やいて"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主に","しゅに"],["ささげなければ"],["ならない"],["。"],["これ"],["は"],["ながく"],["荒塚","あらつか"],["と"],["なって"],["、"],["再び","ふたたび"],["建て直されないで","たてなおされないで"],["あろう"],["。"]]},{"verse":18,"text":"[17]そののろわれた物,ものは一つもあなたの手,てに留,とめおいてはならない。主,しゅが激,はげしい怒,いかりをやめ、あなたに慈悲,じひを施,ほどこして、あなたをあわれみ、先祖,せんぞたちに誓,ちかわれたように、あなたの数,かずを多,おおくされるためである。","tok":[["["],["17"],["]"],["その"],["のろわれた"],["物","もの"],["は"],["一","ひと"],["つ"],["も"],["あなた"],["の"],["手","て"],["に"],["留","とめ"],["おいて"],["は"],["ならない"],["。"],["主","しゅ"],["が"],["激しい","はげしい"],["怒り","いかり"],["を"],["やめ"],["、"],["あなた"],["に"],["慈悲","じひ"],["を"],["施して","ほどこして"],["、"],["あなた"],["を"],["あわれみ"],["、"],["先祖","せんぞ"],["たち"],["に"],["誓われた","ちかわれた"],["よう"],["に"],["、"],["あなた"],["の"],["数","かず"],["を"],["多く","おおく"],["される"],["ため"],["で"],["ある"],["。"]]},{"verse":19,"text":"[18]あなたの神,かみ、主,しゅの言葉,ことばに聞,きき従,したがい、わたしが、きょう、命,めいじるすべての戒,いましめを守,まもり、あなたの神,かみ、主,しゅが正,ただしいと見,みられる事,ことを行,おこなうならば、このようになるであろう。","tok":[["["],["18"],["]"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["に"],["聞","きき"],["従い","したがい"],["、"],["わたし"],["が"],["、"],["きょう"],["、"],["命じる","めいじる"],["すべて"],["の"],["戒しめ","いましめ"],["を"],["守り","まもり"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["正い","ただしい"],["と"],["見られる","みられる"],["事","こと"],["を"],["行なうならば","おこなうならば"],["、"],["この"],["よう"],["に"],["なるで"],["あろう"],["。"]]}]
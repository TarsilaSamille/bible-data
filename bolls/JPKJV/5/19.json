[{"verse":1,"text":"あなたの神,かみ、主,しゅが国々,くにぐにの民,たみを滅,ほろぼしつくして、あなたの神,かみ、主,しゅがその地,ちを賜,たまわり、あなたがそれを獲,えて、その町々,まちまちと、その家々,いえいえに住,すむようになる時,ときは、","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["国々","くにぐに"],["の"],["民","たみ"],["を"],["滅ぼし","ほろぼし"],["つくして"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅがそ"],["の"],["地","ち"],["を"],["賜わり","たまわり"],["、"],["あなた"],["が"],["それ"],["を"],["獲て","えて"],["、"],["その"],["町々","まちまち"],["と"],["、"],["その"],["家々","いえいえ"],["に"],["住む","すむ"],["よう"],["に"],["なる"],["時","とき"],["は"],["、"]]},{"verse":2,"text":"あなたの神,かみ、主,しゅが与,あたえて獲,えさせられる地,ちのうちに、三つの町,まちをあなたのために指定,していしなければならない。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["与","あたえ"],["て"],["獲させられる","えさせられる"],["地","ち"],["の"],["うち"],["に"],["、"],["三","みっ"],["つ"],["の"],["町","まち"],["を"],["あなた"],["の"],["ため"],["に"],["指定","してい"],["しなければ"],["ならない"],["。"]]},{"verse":3,"text":"そしてそこに行,いく道,みちを備,そなえ、またあなたの神,かみ、主,しゅがあなたに継,つがせられる地,ちの領域,りょういきを三区,くに分,わけ、すべて人,ひとを殺,ころした者,ものをそこにのがれさせなければならない。","tok":[["そして"],["そこ"],["に"],["行く","いく"],["道","みち"],["を"],["備","そなえ"],["、"],["また"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["あなた"],["に"],["継がせられる","つがせられる"],["地","ち"],["の"],["領域","りょういき"],["を"],["三区","く"],["に"],["分け","わけ"],["、"],["すべて"],["人","ひと"],["を"],["殺ろした","ころした"],["者","もの"],["を"],["そこ"],["に"],["のがれさせなければ"],["ならない"],["。"]]},{"verse":4,"text":"人,ひとを殺,ころした者,ものがそこにのがれて、命,いのちを全,まっとうすべき場合,ばあいは次,つぎのとおりである。すなわち以前,いぜんから憎,にくむこともないのに、知,しらないでその隣人,りんじんを殺,ころした場合,ばあい、","tok":[["人","ひと"],["を"],["殺ろした","ころした"],["者","もの"],["が"],["そこ"],["に"],["のがれて"],["、"],["命","いのち"],["を"],["全う","まっとう"],["すべき"],["場合","ばあい"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["すなわち"],["以前","いぜん"],["から"],["憎む","にくむ"],["こと"],["も"],["ない"],["のに"],["、"],["知らないで","しらないで"],["その"],["隣人","りんじん"],["を"],["殺ろした","ころした"],["場合","ばあい"],["、"]]},{"verse":5,"text":"たとえば人,ひとが木,きを切,きろうとして、隣人,りんじんと一緒,いっしょに林,はやしに入,いり、手,てにおのを取,とって、木,きを切,きり倒,たおそうと撃,うちおろすとき、その頭,あたまが柄,えから抜,ぬけ、隣人,りんじんにあたって、死,しなせたような場合,ばあいがそれである。そういう人,ひとはこれらの町,まちの一つにのがれて、命,いのちを全,まっとうすることができる。","tok":[["たとえば"],["人","ひと"],["が"],["木","き"],["を"],["切ろう","きろう"],["として"],["、"],["隣人","りんじん"],["と"],["一緒","いっしょ"],["に"],["林","はやし"],["に"],["入","いり"],["、"],["手","て"],["に"],["おの"],["を"],["取って","とって"],["、"],["木","き"],["を"],["切り倒そう","きりたおそう"],["と"],["撃ち","うち"],["おろす"],["とき"],["、"],["その"],["頭","あたま"],["が"],["柄","えか"],["ら"],["抜","ぬけ"],["、"],["隣人","りんじん"],["に"],["あたって"],["、"],["死なせた","しなせた"],["よう"],["な"],["場合","ばあい"],["が"],["それ"],["で"],["ある"],["。"],["そう"],["いう"],["人","ひと"],["は"],["これ"],["ら"],["の"],["町","まち"],["の"],["一","ひと"],["つ"],["に"],["のがれて"],["、"],["命","いのち"],["を"],["全う","まっとう"],["する"],["こと"],["が"],["できる"],["。"]]},{"verse":6,"text":"そうしなければ、復讐,ふくしゅうする者,ものが怒,いかって、その殺,ころした者,ものを追,おいかけ、道,みちが長,ながいために、ついに追,おいついて殺,ころすであろう。しかし、その人,ひとは以前,いぜんから彼,かれを憎,にくんでいた者,ものでないから、殺,ころされる理由,りゆうはない。","tok":[["そう"],["しなければ"],["、"],["復讐","ふくしゅう"],["する"],["者","もの"],["が"],["怒","い"],["か"],["って"],["、"],["その"],["殺ろした","ころした"],["者","もの"],["を"],["追いかけ","おいかけ"],["、"],["道","みち"],["が"],["長い","ながい"],["ため"],["に"],["、"],["ついに"],["追いついて","おいついて"],["殺ろすで","ころすで"],["あろう"],["。"],["しかし"],["、"],["その"],["人","ひと"],["は"],["以前","いぜん"],["から"],["彼","かれ"],["を"],["憎んで","にくんで"],["いた"],["者","もの"],["で"],["ない"],["から"],["、"],["殺ろされる","ころされる"],["理由","りゆう"],["は"],["ない"],["。"]]},{"verse":7,"text":"それでわたしはあなたに命,めいじて『三つの町,まちをあなたのために指定,していしなければならない』と言,いったのである。","tok":[["それ"],["で"],["わたし"],["は"],["あなた"],["に"],["命じて","めいじて"],["『"],["三","みっ"],["つ"],["の"],["町","まち"],["を"],["あなた"],["の"],["ため"],["に"],["指定","してい"],["しなければ"],["ならない"],["』"],["と"],["言った","いった"],["ので"],["ある"],["。"]]},{"verse":8,"text":"あなたの神,かみ、主,しゅが先祖,せんぞたちに誓,ちかわれたように、あなたの領域,りょういきを広,ひろめ、先祖,せんぞたちに与,あたえると言,いわれた地,ちを、ことごとく賜,たまわる時,とき、――","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["先祖","せんぞ"],["たち"],["に"],["誓われた","ちかわれた"],["よう"],["に"],["、"],["あなた"],["の"],["領域","りょういき"],["を"],["広め","ひろめ"],["、"],["先祖","せんぞ"],["たち"],["に"],["与える","あたえる"],["と"],["言われた","いわれた"],["地","ち"],["を"],["、"],["ことごとく"],["賜わる","たまわる"],["時","とき"],["、"],["―"],["―"]]},{"verse":9,"text":"わたしが、きょう、命,めいじるこのすべての戒,いましめを守,まもって、それをおこない、あなたの神,かみ、主,しゅを愛,あいして、常,つねにその道,みちに歩,あゆむ時,とき――あなたはこれら三つの町,まちのほかに、また三つの町,まちをあなたのために増,まし加,くわえなければならない。","tok":[["わたし"],["が"],["、"],["きょう"],["、"],["命じる","めいじる"],["この"],["すべて"],["の"],["戒しめ","いましめ"],["を"],["守って","まもって"],["、"],["それ"],["を"],["おこない"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["を"],["愛して","あいして"],["、"],["常","つね"],["に"],["その"],["道","みち"],["に"],["歩む","あゆむ"],["時","とき"],["―"],["―"],["あなた"],["は"],["これ"],["ら"],["三","みっ"],["つ"],["の"],["町","まち"],["の"],["ほか"],["に"],["、"],["また"],["三","みっ"],["つ"],["の"],["町","まち"],["を"],["あなた"],["の"],["ため"],["に"],["増し加えなければ","ましくわえなければ"],["ならない"],["。"]]},{"verse":10,"text":"これはあなたの神,かみ、主,しゅが与,あたえて嗣,し業,ぎょうとされる地,ちのうちで、罪,つみのない者,ものの血,ちが流,ながされないようにするためである。そうしなければ、その血,ちを流,ながしたとがは、あなたに帰,きするであろう。","tok":[["これ"],["は"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["与","あたえ"],["て"],["嗣業","しぎょう"],["と"],["される"],["地","ち"],["の"],["うち"],["で"],["、"],["罪","つみ"],["の"],["ない"],["者","もの"],["の"],["血","ち"],["が"],["流されない","ながされない"],["よう"],["に"],["する"],["ため"],["で"],["ある"],["。"],["そう"],["しなければ"],["、"],["その"],["血","ち"],["を"],["流した","ながした"],["と"],["が"],["は"],["、"],["あなた"],["に"],["帰するで","きするで"],["あろう"],["。"]]},{"verse":11,"text":"しかし、もし人,ひとが隣人,りんじんを憎,にくんでそれをつけねらい、立,たちかかってその人,ひとを撃,うち殺,ころし、そしてこれらの町,まちの一つにのがれるならば、","tok":[["しかし"],["、"],["もし"],["人","ひと"],["が"],["隣人","りんじん"],["を"],["憎んで","にくんで"],["それ"],["を"],["つけねらい"],["、"],["立ち","たち"],["かかって"],["その"],["人","ひと"],["を"],["撃ち殺し","うちころし"],["、"],["そして"],["これ"],["ら"],["の"],["町","まち"],["の"],["一","ひと"],["つ"],["に"],["のがれるならば"],["、"]]},{"verse":12,"text":"その町,まちの長老,ちょうろうたちは人,ひとをつかわして彼,かれをそこから引,ひいてこさせ、復讐,ふくしゅうする者,ものにわたして殺,ころさせなければならない。","tok":[["その"],["町","まち"],["の"],["長老","ちょうろう"],["たち"],["は"],["人","ひと"],["を"],["つかわして"],["彼","かれ"],["を"],["そこ"],["から"],["引いて","ひいて"],["こさせ"],["、"],["復讐","ふくしゅう"],["する"],["者","もの"],["に"],["わたして"],["殺させなければ","ころさせなければ"],["ならない"],["。"]]},{"verse":13,"text":"彼,かれをあわれんではならない。罪,つみのない者,ものの血,ちを流,ながしたとがを、イスラエルから除,のぞかなければならない。そうすればあなたにさいわいがあるであろう。","tok":[["彼","かれ"],["を"],["あわれんで"],["は"],["ならない"],["。"],["罪","つみ"],["の"],["ない"],["者","もの"],["の"],["血","ち"],["を"],["流した","ながした"],["とが"],["を"],["、"],["イスラエル"],["から"],["除かなければ","のぞかなければ"],["ならない"],["。"],["そう"],["すれば"],["あなた"],["に"],["さいわい"],["が"],["あるで"],["あろう"],["。"]]},{"verse":14,"text":"あなたの神,かみ、主,しゅが与,あたえて獲,えさせられる地,ちで、あなたが継,つぐ嗣,し業,ぎょうにおいて、先祖,せんぞの定,さだめたあなたの隣人,りんじんの土地,とちの境,さかいを移,うつしてはならない。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["与","あたえ"],["て"],["獲させられる","えさせられる"],["地","ち"],["で"],["、"],["あなた"],["が"],["継ぐ","つぐ"],["嗣業","しぎょう"],["に"],["おいて"],["、"],["先祖","せんぞ"],["の"],["定めた","さだめた"],["あなた"],["の"],["隣人","りんじん"],["の"],["土地","とち"],["の"],["境","さかい"],["を"],["移して","うつして"],["は"],["ならない"],["。"]]},{"verse":15,"text":"どんな不正,ふせいであれ、どんなとがであれ、すべて人,ひとの犯,おかす罪,つみは、ただひとりの証人,しょうにんによって定,さだめてはならない。ふたりの証人,しょうにんの証言,しょうげんにより、または三人,にんの証人,しょうにんの証言,しょうげんによって、その事,ことを定,さだめなければならない。","tok":[["どんな"],["不正","ふせい"],["で"],["あれ"],["、"],["どんな"],["とが"],["で"],["あれ"],["、"],["すべて"],["人","ひと"],["の"],["犯す","おかす"],["罪","つみ"],["は"],["、"],["ただ"],["ひとり"],["の"],["証人","しょうにん"],["によって"],["定めて","さだめて"],["は"],["ならない"],["。"],["ふたり"],["の"],["証人","しょうにん"],["の"],["証言","しょうげん"],["に"],["より"],["、"],["また"],["は"],["三人","にん"],["の"],["証人","しょうにん"],["の"],["証言","しょうげん"],["によって"],["、"],["その"],["事","こと"],["を"],["定めなければ","さだめなければ"],["ならない"],["。"]]},{"verse":16,"text":"もし悪意,あくいのある証人,しょうにんが起,たって、人,ひとに対,たいして悪,わるい証言,しょうげんをすることがあれば、","tok":[["もし"],["悪意","あくい"],["の"],["ある"],["証人","しょうにん"],["が"],["起って","たって"],["、"],["人","ひと"],["に対して","にたいして"],["悪い","わるい"],["証言","しょうげん"],["を"],["する"],["こと"],["が"],["あれば"],["、"]]},{"verse":17,"text":"その相,あい争,あらそうふたりの者,ものは主,しゅの前,まえに行,いって、その時,ときの祭司,さいしと裁判人,さいばんにんの前,まえに立,たたなければならない。","tok":[["その"],["相","あ"],["い"],["争う","あらそう"],["ふたり"],["の"],["者","もの"],["は"],["主","しゅ"],["の"],["前","まえ"],["に"],["行って","いって"],["、"],["その"],["時","とき"],["の"],["祭司","さいし"],["と"],["裁判人","さいばんにん"],["の"],["前","まえ"],["に"],["立たなければ","たたなければ"],["ならない"],["。"]]},{"verse":18,"text":"その時,とき、裁判人,さいばんにんは詳細,しょうさいにそれを調,しらべなければならない。そしてその証人,しょうにんがもし偽,いつわりの証人,しょうにんであって、兄弟,きょうだいにむかって偽,いつわりの証言,しょうげんをした者,ものであるならば、","tok":[["その"],["時","とき"],["、"],["裁判人","さいばんにん"],["は"],["詳細","しょうさい"],["に"],["それ"],["を"],["調べなければ","しらべなければ"],["ならない"],["。"],["そして"],["その"],["証人","しょうにん"],["が"],["もし"],["偽わり","いつわり"],["の"],["証人","しょうにん"],["で"],["あって"],["、"],["兄弟","きょうだい"],["に"],["むかって"],["偽わり","いつわり"],["の"],["証言","しょうげん"],["を"],["した"],["者","もの"],["で"],["あるならば"],["、"]]},{"verse":19,"text":"あなたがたは彼,かれが兄弟,きょうだいにしようとしたことを彼,かれに行,おこない、こうしてあなたがたのうちから悪,あくを除,のぞき去,さらなければならない。","tok":[["あなた"],["がた"],["は"],["彼","かれ"],["が"],["兄弟","きょうだい"],["に"],["しよう"],["と"],["した"],["こと"],["を"],["彼","かれ"],["に"],["行ない","おこない"],["、"],["こう"],["して"],["あなた"],["がた"],["の"],["うち"],["から"],["悪","あく"],["を"],["除き去らなければ","のぞきさらなければ"],["ならない"],["。"]]},{"verse":20,"text":"そうすれば他,たの人,ひとたちは聞,きいて恐,おそれ、その後,のちふたたびそのような悪,あくをあなたがたのうちに行,おこなわないであろう。","tok":[["そう"],["すれば"],["他","た"],["の"],["人","ひと"],["たち"],["は"],["聞いて","きいて"],["恐","おそれ"],["、"],["その後","そのの"],["ち"],["ふたたび"],["その"],["よう"],["な"],["悪","あく"],["を"],["あなた"],["がた"],["の"],["うち"],["に"],["行なわないで","おこなわないで"],["あろう"],["。"]]},{"verse":21,"text":"あわれんではならない。命,いのちには命,いのち、目,めには目,め、歯,はには歯,は、手,てには手,て、足,あしには足,あしをもって償,つぐなわせなければならない。","tok":[["あわれんで"],["は"],["ならない"],["。"],["命","いのち"],["に"],["は"],["命","いのち"],["、"],["目","め"],["に"],["は"],["目","め"],["、"],["歯","は"],["に"],["は"],["歯","は"],["、"],["手","て"],["に"],["は"],["手","て"],["、"],["足","あし"],["に"],["は"],["足","あし"],["を"],["もって"],["償なわせなければ","つぐなわせなければ"],["ならない"],["。"]]}]
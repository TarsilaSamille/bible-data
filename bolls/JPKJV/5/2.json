[{"verse":1,"text":"それから、われわれは身,みをめぐらし、主,しゅがわたしに告,つげられたように、紅海,こうかいの方,ほうに向,むかって荒野,あらのに進,すすみ入,いり、日,ひ久,ひさしくセイル山,やまを行,いきめぐっていたが、","tok":[["それ"],["から"],["、"],["われわれ"],["は"],["身","み"],["を"],["めぐらし"],["、"],["主","しゅ"],["が"],["わたし"],["に"],["告げられた","つげられた"],["よう"],["に"],["、"],["紅海","こうかい"],["の"],["方","ほう"],["に"],["向かって","むかって"],["荒野","あら"],["のに"],["進み","すすみ"],["入","いり"],["、"],["日","ひ"],["久く","ひさしく"],["セイル山","せいるやま"],["を"],["行き","いき"],["めぐって"],["いた"],["が"],["、"]]},{"verse":2,"text":"主,しゅはわたしに言,いわれた、","tok":[["主","しゅ"],["は"],["わたし"],["に"],["言われた","いわれた"],["、"]]},{"verse":3,"text":"『あなたがたは既,すでに久,ひさしくこの山,やまを行,いきめぐっているが、身,みをめぐらして北,きたに進,すすみなさい。","tok":[["『"],["あなた"],["がた"],["は"],["既に","すでに"],["久く","ひさしく"],["この"],["山","やま"],["を"],["行き","いき"],["めぐって"],["いる"],["が"],["、"],["身","み"],["を"],["めぐらして"],["北","きた"],["に"],["進み","すすみ"],["なさい"],["。"]]},{"verse":4,"text":"おまえはまた民,たみに命,めいじて言,いえ、「あなたがたは、エサウの子孫,しそん、すなわちセイルに住,すんでいるあなたがたの兄弟,きょうだいの領内,りょうないを通,とおろうとしている。彼,かれらはあなたがたを恐,おそれるであろう。それゆえ、あなたがたはみずから深,ふかく慎,つつしみ、","tok":[["おまえ"],["は"],["また"],["民","たみ"],["に"],["命じて","めいじて"],["言え","いえ"],["、"],["「"],["あなた"],["がた"],["は"],["、"],["エサウ"],["の"],["子孫","しそん"],["、"],["すなわち"],["セイル"],["に"],["住んで","すんで"],["いる"],["あなた"],["がた"],["の"],["兄弟","きょうだい"],["の"],["領内","りょうない"],["を"],["通ろう","とおろう"],["として"],["いる"],["。"],["彼","かれ"],["ら"],["は"],["あなた"],["がた"],["を"],["恐れるで","おそれるで"],["あろう"],["。"],["それ"],["ゆえ"],["、"],["あなた"],["がた"],["は"],["みずから"],["深く","ふかく"],["慎しみ","つつしみ"],["、"]]},{"verse":5,"text":"彼,かれらと争,あらそってはならない。彼,かれらの地,ちは、足,あしの裏,うらで踏,ふむほどでも、あなたがたに与,あたえないであろう。わたしがセイル山,やまをエサウに与,あたえて、領地,りょうちとさせたからである。","tok":[["彼","かれ"],["ら"],["と"],["争って","あらそって"],["は"],["ならない"],["。"],["彼","かれ"],["ら"],["の"],["地","ち"],["は"],["、"],["足","あし"],["の"],["裏","うら"],["で"],["踏む","ふむ"],["ほど"],["で"],["も"],["、"],["あなた"],["がた"],["に"],["与えないで","あたえないで"],["あろう"],["。"],["わたし"],["が"],["セイル山","せいるやま"],["を"],["エサウ"],["に"],["与","あたえ"],["て"],["、"],["領地","りょうち"],["と"],["させた"],["から"],["で"],["ある"],["。"]]},{"verse":6,"text":"あなたがたは彼,かれらから金,かねで食物,しょくもつを買,かって食,たべ、また金,かねで水,みずを買,かって飲,のまなければならない。","tok":[["あなた"],["がた"],["は"],["彼","かれ"],["ら"],["から"],["金","かね"],["で"],["食物","しょくもつ"],["を"],["買って","かって"],["食べ","たべ"],["、"],["また"],["金","かね"],["で"],["水","みず"],["を"],["買って","かって"],["飲まなければ","のまなければ"],["ならない"],["。"]]},{"verse":7,"text":"あなたの神,かみ、主,しゅが、あなたのするすべての事,ことにおいて、あなたを恵,めぐみ、あなたがこの大,おおいなる荒野,あらのを通,とおるのを、見守,みまもられたからである。あなたの神,かみ、主,しゅがこの四十年,ねんの間,あいだ、あなたと共,ともにおられたので、あなたは何,なにも乏,とぼしいことがなかった」』。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["、"],["あなた"],["の"],["する"],["すべて"],["の"],["事","こと"],["に"],["おいて"],["、"],["あなた"],["を"],["恵み","めぐみ"],["、"],["あなた"],["が"],["この"],["大いなる","おおいなる"],["荒野","あら"],["の"],["を"],["通る","とおる"],["の"],["を"],["、"],["見守られた","みまもられた"],["から"],["で"],["ある"],["。"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅがこ"],["の"],["四十","よんじゅう"],["年","ねん"],["の"],["間","あいだ"],["、"],["あなた"],["と"],["共","とも"],["に"],["おられた"],["ので"],["、"],["あなた"],["は"],["何に","なに"],["も"],["乏い","とぼしい"],["こと"],["が"],["なかった"],["」"],["』"],["。"]]},{"verse":8,"text":"こうしてわれわれは、エサウの子孫,しそんでセイルに住,すんでいる兄弟,きょうだいを離,はなれ、アラバの道,みちを避,さけ、エラテとエジオン・ゲベルを離,はなれて進,すすんだ。われわれは転,てんじて、モアブの荒野,あらのの方,ほうに向,むかって進,すすんだ。","tok":[["こう"],["して"],["われわれ"],["は"],["、"],["エサウ"],["の"],["子孫","しそん"],["で"],["セイル"],["に"],["住んで","すんで"],["いる"],["兄弟","きょうだい"],["を"],["離れ","はなれ"],["、"],["アラバ"],["の"],["道","みち"],["を"],["避け","さけ"],["、"],["エラテ"],["と"],["エジオン"],["・"],["ゲベル"],["を"],["離れて","はなれて"],["進んだ","すすんだ"],["。"],["われわれ"],["は"],["転じて","てんじて"],["、"],["モアブ"],["の"],["荒野","あらの"],["の"],["方","ほう"],["に"],["向かって","むかって"],["進んだ","すすんだ"],["。"]]},{"verse":9,"text":"その時,とき、主,しゅはわたしに言,いわれた、『モアブを敵視,てきししてはならない。またそれと争,あらそい戦,たたかってはならない。彼,かれらの地,ちは、領地,りょうちとしてあなたに与,あたえない。ロトの子孫,しそんにアルを与,あたえて、領地,りょうちとさせたからである。","tok":[["その"],["時","とき"],["、"],["主","しゅ"],["は"],["わたし"],["に"],["言われた","いわれた"],["、"],["『"],["モアブ"],["を"],["敵視","てきし"],["して"],["は"],["ならない"],["。"],["また"],["それ"],["と"],["争い","あらそい"],["戦って","たたかって"],["は"],["ならない"],["。"],["彼","かれ"],["ら"],["の"],["地","ち"],["は"],["、"],["領地","りょうち"],["として"],["あなた"],["に"],["与えない","あたえない"],["。"],["ロト"],["の"],["子孫","しそん"],["に"],["アル"],["を"],["与","あたえ"],["て"],["、"],["領地","りょうち"],["と"],["させた"],["から"],["で"],["ある"],["。"]]},{"verse":10,"text":"（むかし、エミびとがこの所,ところに住,すんでいた。この民,たみは大,おおいなる民,たみであって、数,かずも多,おおく、アナクびとのように背,せも高,たかく、","tok":[["（"],["むかし"],["、"],["エミ"],["びと"],["が"],["この"],["所","ところ"],["に"],["住んで","すんで"],["いた"],["。"],["この"],["民","たみ"],["は"],["大いなる","おおいなる"],["民","たみ"],["で"],["あって"],["、"],["数","かず"],["も"],["多く","おおく"],["、"],["アナク"],["びと"],["の"],["よう"],["に"],["背","せ"],["も"],["高かく","たかく"],["、"]]},{"verse":11,"text":"またアナクびとと同,おなじくレパイムであると、みなされていたが、モアブびとは、これをエミびとと呼,よんでいた。","tok":[["また"],["アナク"],["びと"],["と"],["同じく","おなじく"],["レパイム"],["で"],["ある"],["と"],["、"],["みなされて"],["いた"],["が"],["、"],["モアブ"],["びと"],["は"],["、"],["これ"],["を"],["エミ"],["びと"],["と"],["呼んで","よんで"],["いた"],["。"]]},{"verse":12,"text":"ホリびとも、むかしはセイルに住,すんでいたが、エサウの子孫,しそんがこれを追,おい払,はらい、これを滅,ほろぼし、彼,かれらに代,かわってそこに住,すんだ。主,しゅが賜,たまわった所有,しょゆうの地,ちに、イスラエルがおこなったのと同,おなじである。）","tok":[["ホリ"],["びと"],["も"],["、"],["むかし"],["は"],["セイル"],["に"],["住んで","すんで"],["いた"],["が"],["、"],["エサウ"],["の"],["子孫","しそん"],["が"],["これ"],["を"],["追い払","おいはらい"],["、"],["これ"],["を"],["滅ぼし","ほろぼし"],["、"],["彼","かれ"],["ら"],["に"],["代わって","かわって"],["そこ"],["に"],["住んだ","すんだ"],["。"],["主","しゅ"],["が"],["賜わった","たまわった"],["所有","しょゆう"],["の"],["地","ち"],["に"],["、"],["イスラエル"],["が"],["おこなった"],["の"],["と"],["同じ","おなじ"],["で"],["ある"],["。"],["）"]]},{"verse":13,"text":"あなたがたは、いま、立,たちあがってゼレデ川,がわを渡,わたりなさい』。そこでわれわれはゼレデ川,がわを渡,わたった。","tok":[["あなた"],["がた"],["は"],["、"],["いま"],["、"],["立ちあがって","たちあがって"],["ゼレデ"],["川","がわ"],["を"],["渡り","わたり"],["なさい"],["』"],["。"],["そこ"],["で"],["われわれ"],["は"],["ゼレデ"],["川","がわ"],["を"],["渡った","わたった"],["。"]]},{"verse":14,"text":"カデシ・バルネアを出,でてこのかた、ゼレデ川,がわを渡,わたるまでの間,あいだの日,ひは三十八年,ねんであって、その世代,せだいのいくさびとはみな死,しに絶,たえて、宿営,しゅくえいのうちにいなくなった。主,しゅが彼,かれらに誓,ちかわれたとおりである。","tok":[["カデシ"],["・"],["バルネア"],["を"],["出て","でて"],["このかた"],["、"],["ゼレデ"],["川","がわ"],["を"],["渡る","わたる"],["まで"],["の"],["間","あいだ"],["の"],["日","ひ"],["は"],["三十八","さんじゅうはち"],["年","ねん"],["で"],["あって"],["、"],["その"],["世代","せだい"],["の"],["いく"],["さび"],["と"],["は"],["みな"],["死に絶えて","しにたえて"],["、"],["宿営","しゅくえい"],["の"],["うち"],["に"],["いなく"],["なった"],["。"],["主","しゅ"],["が"],["彼","かれ"],["ら"],["に"],["誓われた","ちかわれた"],["とおり"],["で"],["ある"],["。"]]},{"verse":15,"text":"まことに主,しゅの手,てが彼,かれらを攻,せめ、宿営,しゅくえいのうちから滅,ほろぼし去,さられたので、彼,かれらはついに死,しに絶,たえた。","tok":[["まこと"],["に"],["主","しゅ"],["の"],["手","て"],["が"],["彼","かれ"],["ら"],["を"],["攻め","せめ"],["、"],["宿営","しゅくえい"],["の"],["うち"],["から"],["滅ぼし去られた","ほろぼしさられた"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["ついに"],["死に絶えた","しにたえた"],["。"]]},{"verse":16,"text":"いくさびとがみな民,たみのうちから死,しに絶,たえたとき、","tok":[["いく"],["さび"],["と"],["が"],["みな民","みなたみ"],["の"],["うち"],["から"],["死に絶えた","しにたえた"],["とき"],["、"]]},{"verse":17,"text":"主,しゅはわたしに言,いわれた、","tok":[["主","しゅ"],["は"],["わたし"],["に"],["言われた","いわれた"],["、"]]},{"verse":18,"text":"『おまえは、きょう、モアブの領地,りょうちアルを通,とおろうとしている。","tok":[["『"],["おまえ"],["は"],["、"],["きょう"],["、"],["モアブ"],["の"],["領地","りょうち"],["アル"],["を"],["通ろう","とおろう"],["として"],["いる"],["。"]]},{"verse":19,"text":"アンモンの子孫,しそんに近,ちかづく時,とき、おまえは彼,かれらを敵視,てきししてはならない。また争,あらそってはならない。わたしはアンモンの子孫,しそんの地,ちを領地,りょうちとして、おまえに与,あたえない。それをロトの子孫,しそんに領地,りょうちとして与,あたえたからである。","tok":[["アンモン"],["の"],["子孫","しそん"],["に"],["近づく","ちかづく"],["時","とき"],["、"],["おまえ"],["は"],["彼","かれ"],["ら"],["を"],["敵視","てきし"],["して"],["は"],["ならない"],["。"],["また"],["争って","あらそって"],["は"],["ならない"],["。"],["わたし"],["は"],["アンモン"],["の"],["子孫","しそん"],["の"],["地","ち"],["を"],["領地","りょうち"],["として"],["、"],["おまえ"],["に"],["与えない","あたえない"],["。"],["それ"],["を"],["ロト"],["の"],["子孫","しそん"],["に"],["領地","りょうち"],["として"],["与えた","あたえた"],["から"],["で"],["ある"],["。"]]},{"verse":20,"text":"（これもまたレパイムの国,くにとみなされた。むかし、レパイムがここに住,すんでいたからである。しかし、アンモンびとは彼,かれらをザムズミびとと呼,よんだ。","tok":[["（"],["これ"],["も"],["また"],["レパイム"],["の"],["国","くに"],["と"],["みなされた"],["。"],["むかし"],["、"],["レパイム"],["が"],["ここ"],["に"],["住んで","すんで"],["いた"],["から"],["で"],["ある"],["。"],["しかし"],["、"],["アンモン"],["びと"],["は"],["彼","かれ"],["ら"],["を"],["ザムズミ"],["びと"],["と"],["呼んだ","よんだ"],["。"]]},{"verse":21,"text":"この民,たみは大,おおいなる民,たみであって数,かずも多,おおく、アナクびとのように背,せも高,たかかったが、主,しゅはアンモンびとの前,まえから、これを滅,ほろぼされ、アンモンびとがこれを追,おい払,はらって、彼,かれらに代,かわってそこに住,すんだ。","tok":[["この"],["民","たみ"],["は"],["大いなる","おおいなる"],["民","たみ"],["で"],["あって"],["数","かず"],["も"],["多く","おおく"],["、"],["アナク"],["びと"],["の"],["よう"],["に"],["背","せ"],["も"],["高かかった","たかかった"],["が"],["、"],["主","しゅ"],["は"],["アンモン"],["びと"],["の"],["前","まえ"],["から"],["、"],["これ"],["を"],["滅ぼされ","ほろぼされ"],["、"],["アンモン"],["びと"],["が"],["これ"],["を"],["追い払って","おいはらって"],["、"],["彼","かれ"],["ら"],["に"],["代わって","かわって"],["そこ"],["に"],["住んだ","すんだ"],["。"]]},{"verse":22,"text":"この事,ことは、セイルに住,すんでいるエサウの子孫,しそんのためにその前,まえから、ホリびとを滅,ほろぼされたのと同,おなじである。彼,かれらはホリびとを追,おい払,はらい、これに代,かわって今日,こんにちまでそこに住,すんでいる。","tok":[["この"],["事","こと"],["は"],["、"],["セイル"],["に"],["住んで","すんで"],["いる"],["エサウ"],["の"],["子孫","しそん"],["の"],["ため"],["に"],["その"],["前","まえ"],["から"],["、"],["ホリ"],["びと"],["を"],["滅ぼされた","ほろぼされた"],["の"],["と"],["同じ","おなじ"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["ホリ"],["びと"],["を"],["追い払","おいはらい"],["、"],["これ"],["に"],["代わって","かわって"],["今日","こんにちまでそこ"],["に"],["住んで","すんで"],["いる"],["。"]]},{"verse":23,"text":"またカフトルから出,でたカフトルびとは、ガザにまで及,およぶ村々,むらむらに住,すんでいたアビびとを滅,ほろぼして、これに代,かわってそこに住,すんでいる。）","tok":[["また"],["カフトル"],["から"],["出た","でた"],["カフトル"],["びと"],["は"],["、"],["ガザ"],["に"],["まで"],["及ぶ","およぶ"],["村々","むらむら"],["に"],["住んで","すんで"],["いた"],["アビ"],["びと"],["を"],["滅ぼして","ほろぼして"],["、"],["これ"],["に"],["代わって","かわって"],["そこ"],["に"],["住んで","すんで"],["いる"],["。"],["）"]]},{"verse":24,"text":"あなたがたは立,たちあがり、進,すすんでアルノン川,がわを渡,わたりなさい。わたしはヘシボンの王,おうアモリびとシホンとその国,くにとを、おまえの手,てに渡,わたした。それを征服,せいふくし始,はじめよ。彼,かれと争,あらそって戦,たたかえ。","tok":[["あなた"],["がた"],["は"],["立ちあがり","たちあがり"],["、"],["進","す"],["すんで"],["アルノン"],["川","がわ"],["を"],["渡り","わたり"],["なさい"],["。"],["わたし"],["は"],["ヘシボン"],["の"],["王","おう"],["アモリ"],["びと"],["シホン"],["と"],["その"],["国","くに"],["と"],["を"],["、"],["おまえ"],["の"],["手","て"],["に"],["渡","わたし"],["た"],["。"],["それ"],["を"],["征服","せいふく"],["し"],["始","はじめ"],["よ"],["。"],["彼","かれ"],["と"],["争って","あらそって"],["戦え","たたかえ"],["。"]]},{"verse":25,"text":"きょうから、わたしは全,ぜん天下,てんかの民,たみに、おまえをおびえ恐,おそれさせるであろう。彼,かれらはおまえのうわさを聞,きいて震,ふるえ、おまえのために苦,くるしむであろう』。","tok":[["きょう"],["から"],["、"],["わたし"],["は"],["全天下","ぜんてんか"],["の"],["民","たみ"],["に"],["、"],["おまえ"],["を"],["おびえ"],["恐れ","おそれ"],["させるで"],["あろう"],["。"],["彼","かれ"],["ら"],["は"],["おまえ"],["の"],["うわさ"],["を"],["聞いて","きいて"],["震え","ふるえ"],["、"],["おまえ"],["の"],["ため"],["に"],["苦しむで","くるしむで"],["あろう"],["』"],["。"]]},{"verse":26,"text":"そこでわたしは、ケデモテの荒野,あらのから、ヘシボンの王,おうシホンに使者,ししゃをつかわし、平和,へいわの言葉,ことばを述,のべさせた。","tok":[["そこ"],["で"],["わたし"],["は"],["、"],["ケデモテ"],["の"],["荒野","あらの"],["から"],["、"],["ヘシボン"],["の"],["王","おう"],["シホン"],["に"],["使者","ししゃ"],["を"],["つかわし"],["、"],["平和","へいわ"],["の"],["言葉","ことば"],["を"],["述べさせた","のべさせた"],["。"]]},{"verse":27,"text":"『あなたの国,くにを通,とおらせてください。わたしは大路,おおじをとおっていきます、右,みぎにも左,ひだりにも曲,まがりません。","tok":[["『"],["あなた"],["の"],["国","くに"],["を"],["通らせて","とおらせて"],["ください"],["。"],["わたし"],["は"],["大路","おおじ"],["を"],["とおって"],["いきます"],["、"],["右","みぎ"],["に"],["も"],["左","ひだり"],["に"],["も"],["曲がりません","まがりません"],["。"]]},{"verse":28,"text":"金,かねで食物,しょくもつを売,うってわたしに食,たべさせ、金,かねをとって水,みずを与,あたえてわたしに飲,のませてください。徒歩,とほで通,とおらせてくださるだけでよいのです。","tok":[["金","かね"],["で"],["食物","しょくもつ"],["を"],["売って","うって"],["わたし"],["に"],["食べさせ","たべさせ"],["、"],["金","かね"],["を"],["とって"],["水","みず"],["を"],["与","あたえ"],["て"],["わたし"],["に"],["飲ませて","のませて"],["ください"],["。"],["徒歩","とほ"],["で"],["通らせて","とおらせて"],["くださる"],["だけ"],["で"],["よい"],["の"],["です"],["。"]]},{"verse":29,"text":"セイルに住,すむエサウの子孫,しそんと、アルに住,すむモアブびとが、わたしにしたようにしてください。そうすれば、わたしはヨルダンを渡,わたって、われわれの神,かみ、主,しゅが賜,たまわる地,ちに行,いきます』。","tok":[["セイル"],["に"],["住む","すむ"],["エサウ"],["の"],["子孫","しそん"],["と"],["、"],["アル"],["に"],["住む","すむ"],["モアブ"],["びと"],["が"],["、"],["わたし"],["に"],["した"],["よう"],["に"],["して"],["ください"],["。"],["そう"],["すれば"],["、"],["わたし"],["は"],["ヨルダン"],["を"],["渡って","わたって"],["、"],["われわれ"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["賜わる","たまわる"],["地","ち"],["に"],["行きます","いきます"],["』"],["。"]]},{"verse":30,"text":"しかし、ヘシボンの王,おうシホンは、われわれを通,とおらせるのを好,このまなかった。あなたの神,かみ、主,しゅが彼,かれをあなたの手,てに渡,わたすため、その気,きを強,つよくし、その心,こころをかたくなにされたからである。今日,こんにち見,みるとおりである。","tok":[["しかし"],["、"],["ヘシボン"],["の"],["王","おう"],["シホン"],["は"],["、"],["われわれ"],["を"],["通らせる","とおらせる"],["の"],["を"],["好まなかった","このまなかった"],["。"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["彼","かれ"],["を"],["あなた"],["の"],["手","て"],["に"],["渡す","わたす"],["ため"],["、"],["その"],["気","き"],["を"],["強く","つよく"],["し"],["、"],["その"],["心","こころ"],["を"],["かたくな"],["に"],["された"],["から"],["で"],["ある"],["。"],["今日","こん"],["に"],["ち"],["見る","みる"],["とおり"],["で"],["ある"],["。"]]},{"verse":31,"text":"時,ときに主,しゅはわたしに言,いわれた、『わたしはシホンと、その地,ちとを、おまえに渡,わたし始,はじめた。おまえはそれを征服,せいふくしはじめ、その地,ちを自分,じぶんのものとせよ』。","tok":[["時","とき"],["に"],["主","しゅ"],["は"],["わたし"],["に"],["言われた","いわれた"],["、"],["『"],["わたし"],["は"],["シホン"],["と"],["、"],["その"],["地","ち"],["と"],["を"],["、"],["おまえ"],["に"],["渡","わたし"],["始めた","はじめた"],["。"],["おまえ"],["は"],["それ"],["を"],["征服","せいふく"],["し"],["はじめ"],["、"],["その"],["地","ち"],["を"],["自分","じぶん"],["の"],["もの"],["と"],["せよ"],["』"],["。"]]},{"verse":32,"text":"そこでシホンは、われわれを攻,せめようとして、その民,たみをことごとく率,ひきい、出,でてきてヤハズで戦,たたかったが、","tok":[["そこ"],["で"],["シホン"],["は"],["、"],["われわれ"],["を"],["攻めよう","せめよう"],["として"],["、"],["その"],["民","たみ"],["を"],["ことごとく"],["率い","ひきい"],["、"],["出て","でて"],["きて"],["ヤハズ"],["で"],["戦った","たたかった"],["が"],["、"]]},{"verse":33,"text":"われわれの神,かみ、主,しゅが彼,かれを渡,わたされたので、われわれは彼,かれとその子,こらと、そのすべての民,たみとを撃,うち殺,ころした。","tok":[["われわれ"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["彼","かれ"],["を"],["渡された","わたされた"],["ので"],["、"],["われわれ"],["は"],["彼","かれ"],["と"],["その"],["子","こ"],["ら"],["と"],["、"],["その"],["すべて"],["の"],["民","たみ"],["と"],["を"],["撃ち殺した","うちころした"],["。"]]},{"verse":34,"text":"その時,とき、われわれは彼,かれのすべての町,まちを取,とり、そのすべての町,まちの男,おとこ、女,おんなおよび子供,こどもを全,まったく滅,ほろぼして、ひとりをも残,のこさなかった。","tok":[["その"],["時","とき"],["、"],["われわれ"],["は"],["彼","かれ"],["の"],["すべて"],["の"],["町","まち"],["を"],["取","とり"],["、"],["その"],["すべて"],["の"],["町","まち"],["の"],["男","おとこ"],["、"],["女","おんな"],["および"],["子供","こども"],["を"],["全く","まったく"],["滅ぼして","ほろぼして"],["、"],["ひとり"],["を"],["も"],["残さなかった","のこさなかった"],["。"]]},{"verse":35,"text":"ただその家畜,かちくは、われわれが取,とった町々,まちまちのぶんどり物,ものと共,ともに、われわれが獲,えて自分,じぶんの物,ものとした。","tok":[["ただ"],["その"],["家畜","かちく"],["は"],["、"],["われわれ"],["が"],["取った","とった"],["町々","まちまち"],["の"],["ぶんどり"],["物","もの"],["と"],["共","とも"],["に"],["、"],["われわれ"],["が"],["獲て","えて"],["自分","じぶん"],["の"],["物","もの"],["と"],["した"],["。"]]},{"verse":36,"text":"アルノンの谷,たにのほとりにあるアロエルおよび谷,たにの中,なかにある町,まちからギレアデに至,いたるまで、われわれが攻,せめて取,とれなかった町,まちは一つもなかった。われわれの神,かみ、主,しゅがことごとくわれわれに渡,わたされたのである。","tok":[["アルノン"],["の"],["谷","たに"],["の"],["ほとり"],["に"],["ある"],["アロエル"],["および"],["谷","たに"],["の"],["中","なか"],["に"],["ある"],["町","まち"],["から"],["ギレアデ"],["に"],["至る","いたる"],["まで"],["、"],["われわれ"],["が"],["攻めて","せめて"],["取れなかった","とれなかった"],["町","まち"],["は"],["一","ひと"],["つ"],["も"],["なかった"],["。"],["われわれ"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["ことごとく"],["われわれ"],["に"],["渡された","わたされた"],["ので"],["ある"],["。"]]},{"verse":37,"text":"ただアンモンの子孫,しそんの地,ち、すなわちヤボク川,がわの全,ぜん岸,きし、および山地,さんちの町々,まちまち、またすべてわれわれの神,かみ、主,しゅが禁,きんじられた所,ところには近寄,ちかよらなかった。","tok":[["ただ"],["アンモン"],["の"],["子孫","しそん"],["の"],["地","ち"],["、"],["すなわち"],["ヤボク"],["川","がわ"],["の"],["全","ぜん"],["岸","きし"],["、"],["および"],["山地","さんち"],["の"],["町々","まちまち"],["、"],["また"],["すべて"],["われわれ"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["禁じられた","きんじられた"],["所","ところ"],["に"],["は"],["近寄らなかった","ちかよらなかった"],["。"]]}]
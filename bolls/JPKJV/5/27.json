[{"verse":1,"text":"モーセとイスラエルの長老,ちょうろうたちとは民,たみに命,めいじて言,いった、「わたしが、きょう、あなたがたに命,めいじるすべての戒,いましめを守,まもりなさい。","tok":[["モーセ"],["と"],["イスラエル"],["の"],["長老","ちょうろう"],["たち"],["と"],["は"],["民","たみ"],["に"],["命じて","めいじて"],["言った","いった"],["、"],["「"],["わたし"],["が"],["、"],["きょう"],["、"],["あなた"],["がた"],["に"],["命じる","めいじる"],["すべて"],["の"],["戒しめ","いましめ"],["を"],["守り","まもり"],["なさい"],["。"]]},{"verse":2,"text":"あなたがたがヨルダンを渡,わたってあなたの神,かみ、主,しゅが賜,たまわる国,くににはいる時,とき、あなたは大,おおきな石,いし数個,すうこを立,たてて、それにしっくいを塗,ぬり、","tok":[["あなた"],["がた"],["が"],["ヨルダン"],["を"],["渡って","わたって"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["賜わる","たまわる"],["国","くに"],["に"],["は"],["いる"],["時","とき"],["、"],["あなた"],["は"],["大きな","おおきな"],["石","いし"],["数個","すうこ"],["を"],["立てて","たてて"],["、"],["それ"],["に"],["しっくい"],["を"],["塗","ぬり"],["、"]]},{"verse":3,"text":"そしてあなたが渡,わたって、あなたの先祖,せんぞたちの神,かみ、主,しゅが約束,やくそくされたようにあなたの神,かみ、主,しゅが賜,たまわる地,ち、すなわち乳,ちちと蜜,みつの流,ながれる地,ちにはいる時,とき、この律法,りっぽうのすべての言葉,ことばをその上,うえに書,かきしるさなければならない。","tok":[["そして"],["あなた"],["が"],["渡って","わたって"],["、"],["あなた"],["の"],["先祖","せんぞ"],["たち"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["約束","やくそく"],["された"],["よう"],["に"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["賜わる","たまわる"],["地","ち"],["、"],["すなわち"],["乳","ちち"],["と"],["蜜","みつ"],["の"],["流れる","ながれる"],["地","ち"],["に"],["は"],["いる"],["時","とき"],["、"],["この"],["律法","りっぽう"],["の"],["すべて"],["の"],["言葉","ことば"],["を"],["その"],["上","うえ"],["に"],["書きしるさなければ","かきしるさなければ"],["ならない"],["。"]]},{"verse":4,"text":"すなわち、あなたがたが、ヨルダンを渡,わたったならば、わたしが、きょう、あなたがたに命,めいじるそれらの石,いしをエバル山,やまに立,たて、それにしっくいを塗,ぬらなければならない。","tok":[["すなわち"],["、"],["あなた"],["が"],["た"],["が"],["、"],["ヨルダン"],["を"],["渡ったならば","わたったならば"],["、"],["わたし"],["が"],["、"],["きょう"],["、"],["あなた"],["がた"],["に"],["命じる","めいじる"],["それ"],["ら"],["の"],["石","いし"],["を"],["エバル"],["山","やま"],["に"],["立て","たて"],["、"],["それ"],["に"],["しっくい"],["を"],["塗らなければ","ぬらなければ"],["ならない"],["。"]]},{"verse":5,"text":"またそこにあなたの神,かみ、主,しゅのために、祭壇,さいだん、すなわち石,いしの祭壇,さいだんを築,きずかなければならない。鉄,てつの器,うつわを石,いしに当,あてず、","tok":[["また"],["そこ"],["に"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["ため"],["に"],["、"],["祭壇","さいだん"],["、"],["すなわち"],["石","いし"],["の"],["祭壇","さいだん"],["を"],["築かなければ","きずかなければ"],["ならない"],["。"],["鉄","てつ"],["の"],["器","うつわ"],["を"],["石","いし"],["に"],["当てず","あてず"],["、"]]},{"verse":6,"text":"自然,しぜんのままの石,いしであなたの神,かみ、主,しゅのために祭壇,さいだんを築,きずき、その上,うえであなたの神,かみ、主,しゅに燔祭,はんさいをささげなければならない。","tok":[["自然","しぜん"],["の"],["まま"],["の"],["石","いし"],["で"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["ため"],["に"],["祭壇","さいだん"],["を"],["築き","きずき"],["、"],["その"],["上","うえ"],["で"],["あなた"],["の"],["神","かみ"],["、"],["主に","しゅに"],["燔祭","はんさい"],["を"],["ささげなければ"],["ならない"],["。"]]},{"verse":7,"text":"また酬恩祭,しゅうおんさいの犠牲,ぎせいをささげて、その所,ところで食,たべ、あなたの神,かみ、主,しゅの前,まえで喜,よろこび楽,たのしまなければならない。","tok":[["また"],["酬恩祭","しゅうおんさい"],["の"],["犠牲","ぎせい"],["を"],["ささげて"],["、"],["その"],["所","ところ"],["で"],["食べ","たべ"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["前","まえ"],["で"],["喜こび","よろこび"],["楽しまなければ","たのしまなければ"],["ならない"],["。"]]},{"verse":8,"text":"あなたはこの律法,りっぽうのすべての言葉,ことばをその石,いしの上,うえに明,あきらかに書,かきしるさなければならない」。","tok":[["あなた"],["は"],["この"],["律法","りっぽう"],["の"],["すべて"],["の"],["言葉","ことば"],["を"],["その"],["石","いし"],["の"],["上","うえ"],["に"],["明か","あきらか"],["に"],["書きしるさなければ","かきしるさなければ"],["ならない"],["」"],["。"]]},{"verse":9,"text":"またモーセとレビびとたる祭司,さいしたちとは、イスラエルのすべての人々,ひとびとに言,いった、「イスラエルよ、静,しずかに聞,ききなさい。あなたは、きょう、あなたの神,かみ、主,しゅの民,たみとなった。","tok":[["また"],["モーセ"],["と"],["レビ"],["びと"],["たる"],["祭司","さいし"],["たち"],["と"],["は"],["、"],["イスラエル"],["の"],["すべて"],["の"],["人々","ひとびと"],["に"],["言った","いった"],["、"],["「"],["イスラエル"],["よ"],["、"],["静","しずか"],["に"],["聞","きき"],["なさい"],["。"],["あなた"],["は"],["、"],["きょう"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["民","たみ"],["と"],["なった"],["。"]]},{"verse":10,"text":"それゆえ、あなたの神,かみ、主,しゅの声,こえに聞,きき従,したがい、わたしが、きょう、命,めいじる戒,いましめと定,さだめとを行,おこなわなければならない」。","tok":[["それ"],["ゆえ"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["声","こえ"],["に"],["聞","きき"],["従い","したがい"],["、"],["わたし"],["が"],["、"],["きょう"],["、"],["命じる","めいじる"],["戒しめ","いましめ"],["と"],["定め","さだめ"],["と"],["を"],["行なわなければ","おこなわなければ"],["ならない"],["」"],["。"]]},{"verse":11,"text":"その日,ひまたモーセは民,たみに命,めいじて言,いった、","tok":[["その"],["日","ひ"],["また"],["モーセ"],["は"],["民","たみ"],["に"],["命じて","めいじて"],["言った","いった"],["、"]]},{"verse":12,"text":"「あなたがたがヨルダンを渡,わたった時,とき、次,つぎの人,ひとたちはゲリジム山,やまに立,たって民,たみを祝福,しゅくふくしなければならない。すなわちシメオン、レビ、ユダ、イッサカル、ヨセフおよびベニヤミン。","tok":[["「"],["あなた"],["がた"],["が"],["ヨルダン"],["を"],["渡った","わたった"],["時","とき"],["、"],["次","つぎ"],["の"],["人","ひと"],["たち"],["は"],["ゲリジム"],["山","やま"],["に"],["立って","たって"],["民","たみ"],["を"],["祝福","しゅくふく"],["しなければ"],["ならない"],["。"],["すなわち"],["シメオン"],["、"],["レビ"],["、"],["ユダ"],["、"],["イッサカル"],["、"],["ヨセフ"],["および"],["ベニヤミン"],["。"]]},{"verse":13,"text":"また次,つぎの人,ひとたちはエバル山,やまに立,たってのろわなければならない。すなわちルベン、ガド、アセル、ゼブルン、ダンおよびナフタリ。","tok":[["また"],["次","つぎ"],["の"],["人","ひと"],["たち"],["は"],["エバル"],["山","やま"],["に"],["立って","たって"],["のろわなければ"],["ならない"],["。"],["すなわち"],["ルベン"],["、"],["ガド"],["、"],["アセル"],["、"],["ゼブルン"],["、"],["ダン"],["および"],["ナフタリ"],["。"]]},{"verse":14,"text":"そしてレビびとは大声,おおごえでイスラエルのすべての人々,ひとびとに告,つげて言,いわなければならない。","tok":[["そして"],["レビ"],["び"],["と"],["は"],["大声","おおごえ"],["で"],["イスラエル"],["の"],["すべて"],["の"],["人々","ひとびと"],["に"],["告","つげ"],["て"],["言わなければ","いわなければ"],["ならない"],["。"]]},{"verse":15,"text":"『工人,こうじんの手,ての作,さくである刻,きざんだ像,ぞう、または鋳,いた像,ぞうは、主,しゅが憎,にくまれるものであるから、それを造,つくって、ひそかに安置,あんちする者,ものはのろわれる』。民,たみは、みな答,こたえてアァメンと言,いわなければならない。","tok":[["『"],["工人","こうじん"],["の"],["手","て"],["の"],["作","さく"],["で"],["ある"],["刻んだ","きざんだ"],["像","ぞう"],["、"],["また"],["は"],["鋳た","いた"],["像","ぞう"],["は"],["、"],["主","しゅ"],["が"],["憎まれる","にくまれる"],["もの"],["で"],["ある"],["から"],["、"],["それ"],["を"],["造って","つくって"],["、"],["ひそか"],["に"],["安置","あんち"],["する"],["者","もの"],["は"],["のろわれる"],["』"],["。"],["民","たみ"],["は"],["、"],["みな"],["答","こたえ"],["て"],["アァメン"],["と"],["言わなければ","いわなければ"],["ならない"],["。"]]},{"verse":16,"text":"『父,ちちや母,ははを軽,かろんずる者,ものはのろわれる』。民,たみはみなアァメンと言,いわなければならない。","tok":[["『"],["父","ちち"],["や"],["母","はは"],["を"],["軽んずる","かろんずる"],["者","もの"],["は"],["のろわれる"],["』"],["。"],["民","たみ"],["は"],["みな"],["アァメン"],["と"],["言わなければ","いわなければ"],["ならない"],["。"]]},{"verse":17,"text":"『隣人,りんじんとの土地,とちの境,さかいを移,うつす者,ものはのろわれる』。民,たみはみなアァメンと言,いわなければならない。","tok":[["『"],["隣人","りんじん"],["と"],["の"],["土地","とち"],["の"],["境","さかい"],["を"],["移す","うつす"],["者","もの"],["は"],["のろわれる"],["』"],["。"],["民","たみ"],["は"],["みな"],["アァメン"],["と"],["言わなければ","いわなければ"],["ならない"],["。"]]},{"verse":18,"text":"『盲人,もうじんを道,みちに迷,まよわす者,ものはのろわれる』。民,たみはみなアァメンと言,いわなければならない。","tok":[["『"],["盲人","もうじん"],["を"],["道","みち"],["に"],["迷わす","まよわす"],["者","もの"],["は"],["のろわれる"],["』"],["。"],["民","たみ"],["は"],["みな"],["アァメン"],["と"],["言わなければ","いわなければ"],["ならない"],["。"]]},{"verse":19,"text":"『寄留,きりゅうの他国,たこく人,じんや孤児,こじ、寡婦,かふのさばきを曲,まげる者,ものはのろわれる』。民,たみはみなアァメンと言,いわなければならない。","tok":[["『"],["寄留","きりゅう"],["の"],["他国人","たこくじん"],["や"],["孤児","こじ"],["、"],["寡婦","かふ"],["の"],["さばき"],["を"],["曲げる","まげる"],["者","もの"],["は"],["のろわれる"],["』"],["。"],["民","たみ"],["は"],["みな"],["アァメン"],["と"],["言わなければ","いわなければ"],["ならない"],["。"]]},{"verse":20,"text":"『父,ちちの妻,つまを犯,おかす者,ものは、父,ちちを恥,はずかしめるのであるからのろわれる』。民,たみはみなアァメンと言,いわなければならない。","tok":[["『"],["父","ちち"],["の"],["妻","つま"],["を"],["犯す","おかす"],["者","もの"],["は"],["、"],["父","ちち"],["を"],["恥ずかしめる","はずかしめる"],["ので"],["ある"],["から"],["のろわれる"],["』"],["。"],["民","たみ"],["は"],["みな"],["アァメン"],["と"],["言わなければ","いわなければ"],["ならない"],["。"]]},{"verse":21,"text":"『すべて獣,けものを犯,おかす者,ものはのろわれる』。民,たみはみなアァメンと言,いわなければならない。","tok":[["『"],["すべて"],["獣","けもの"],["を"],["犯す","おかす"],["者","もの"],["は"],["のろわれる"],["』"],["。"],["民","たみ"],["は"],["みな"],["アァメン"],["と"],["言わなければ","いわなければ"],["ならない"],["。"]]},{"verse":22,"text":"『父,ちちの娘,むすめ、または母,ははの娘,むすめである自分,じぶんの姉妹,しまいを犯,おかす者,ものはのろわれる』。民,たみはみなアァメンと言,いわなければならない。","tok":[["『"],["父","ちち"],["の"],["娘","むすめ"],["、"],["また"],["は"],["母","はは"],["の"],["娘","むすめ"],["で"],["ある"],["自分","じぶん"],["の"],["姉妹","しまい"],["を"],["犯す","おかす"],["者","もの"],["は"],["のろわれる"],["』"],["。"],["民","たみ"],["は"],["みな"],["アァメン"],["と"],["言わなければ","いわなければ"],["ならない"],["。"]]},{"verse":23,"text":"『妻,つまの母,ははを犯,おかす者,ものはのろわれる』。民,たみはみなアァメンと言,いわなければならない。","tok":[["『"],["妻","つま"],["の"],["母","はは"],["を"],["犯す","おかす"],["者","もの"],["は"],["のろわれる"],["』"],["。"],["民","たみ"],["は"],["みな"],["アァメン"],["と"],["言わなければ","いわなければ"],["ならない"],["。"]]},{"verse":24,"text":"『ひそかに隣人,りんじんを撃,うち殺,ころす者,ものはのろわれる』。民,たみはみなアァメンと言,いわなければならない。","tok":[["『"],["ひそか"],["に"],["隣人","りんじん"],["を"],["撃ち","うち"],["殺ろす","ころす"],["者","もの"],["は"],["のろわれる"],["』"],["。"],["民","たみ"],["は"],["みな"],["アァメン"],["と"],["言わなければ","いわなければ"],["ならない"],["。"]]},{"verse":25,"text":"『まいないを取,とって罪,つみなき者,ものを殺,ころす者,ものはのろわれる』。民,たみはみなアァメンと言,いわなければならない。","tok":[["『"],["まいない"],["を"],["取って","とって"],["罪","つみ"],["なき"],["者","もの"],["を"],["殺ろす","ころす"],["者","もの"],["は"],["のろわれる"],["』"],["。"],["民","たみ"],["は"],["みな"],["アァメン"],["と"],["言わなければ","いわなければ"],["ならない"],["。"]]},{"verse":26,"text":"『この律法,りっぽうの言葉,ことばを守,まもり行,おこなわない者,ものはのろわれる』。民,たみはみなアァメンと言,いわなければならない。","tok":[["『"],["この"],["律法","りっぽう"],["の"],["言葉","ことば"],["を"],["守り","まもり"],["行なわない","おこなわない"],["者","もの"],["は"],["のろわれる"],["』"],["。"],["民","たみ"],["は"],["みな"],["アァメン"],["と"],["言わなければ","いわなければ"],["ならない"],["。"]]}]
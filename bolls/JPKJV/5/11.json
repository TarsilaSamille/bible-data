[{"verse":1,"text":"それゆえ、あなたの神,かみ、主,しゅを愛,あいし、常,つねにそのさとしと、定,さだめと、おきてと、戒,いましめとを守,まもらなければならない。","tok":[["それ"],["ゆえ"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["を"],["愛し","あいし"],["、"],["常","つね"],["に"],["その"],["さとし"],["と"],["、"],["定め","さだめ"],["と"],["、"],["おきて"],["と"],["、"],["戒しめ","いましめ"],["と"],["を"],["守らなければ","まもらなければ"],["ならない"],["。"]]},{"verse":2,"text":"あなたがたは、きょう、次,つぎのことを知,しらなければならない。わたしが語,かたるのは、あなたがたの子供,こどもたちに対,たいしてではない。彼,かれらはあなたがたの神,かみ、主,しゅの訓練,くんれんと、主,しゅの大,おおいなる事,ことと、その強,つよい手,てと、伸,のべた腕,うでとを知,しらず、また見,みなかった。","tok":[["あなた"],["がた"],["は"],["、"],["きょう"],["、"],["次","つぎ"],["の"],["こと"],["を"],["知らなければ","しらなければ"],["ならない"],["。"],["わたし"],["が"],["語る","かたる"],["の"],["は"],["、"],["あなた"],["がた"],["の"],["子供","こども"],["たち"],["に対して","にたいして"],["で"],["は"],["ない"],["。"],["彼","かれ"],["ら"],["は"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["訓練","くんれん"],["と"],["、"],["主","しゅ"],["の"],["大いなる","おおいなる"],["事","こと"],["と"],["、"],["その"],["強い","つよい"],["手","て"],["と"],["、"],["伸べた","のべた"],["腕","うで"],["と"],["を"],["知らず","しらず"],["、"],["また"],["見なかった","みなかった"],["。"]]},{"verse":3,"text":"また彼,かれらは主,しゅがエジプトで、エジプト王,おうパロとその全国,ぜんこくに対,たいして行,おこなわれたしるしと、わざ、","tok":[["また"],["彼","かれ"],["ら"],["は"],["主","しゅ"],["が"],["エジプト"],["で"],["、"],["エジプト"],["王","おう"],["パロ"],["と"],["その"],["全国","ぜんこく"],["に対して","にたいして"],["行なわれた","おこなわれた"],["しるし"],["と"],["、"],["わざ"],["、"]]},{"verse":4,"text":"また主,しゅがエジプトの軍勢,ぐんぜいとその馬,うまと戦車,せんしゃとに行,おこなわれた事,こと、すなわち彼,かれらがあなたがたのあとを追,おってきた時,ときに、紅海,こうかいの水,みずを彼,かれらの上,うえにあふれさせ、彼,かれらを滅,ほろぼされて、今日,こんにちに至,いたった事,こと、","tok":[["また"],["主","しゅ"],["が"],["エジプト"],["の"],["軍勢","ぐんぜい"],["と"],["その"],["馬","うま"],["と"],["戦車","せんしゃ"],["と"],["に"],["行なわれた","おこなわれた"],["事","こと"],["、"],["すなわち"],["彼","かれ"],["ら"],["が"],["あなた"],["がた"],["の"],["あと"],["を"],["追って","おって"],["きた"],["時","とき"],["に"],["、"],["紅海","こうかい"],["の"],["水","みず"],["を"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["あふれさせ"],["、"],["彼","かれ"],["ら"],["を"],["滅ぼされて","ほろぼされて"],["、"],["今日","こんにち"],["に"],["至った","いたった"],["事","こと"],["、"]]},{"verse":5,"text":"またあなたがたがこの所,ところに来,くるまで、主,しゅが荒野,あらので、あなたがたに行,おこなわれた事,こと、","tok":[["また"],["あなた"],["がた"],["が"],["この"],["所","ところ"],["に"],["来る","くる"],["まで"],["、"],["主","しゅ"],["が"],["荒野","あらの"],["で"],["、"],["あなた"],["がた"],["に"],["行なわれた","おこなわれた"],["事","こと"],["、"]]},{"verse":6,"text":"およびルベンの子,このエリアブの子,こ、ダタンとアビラムとにされた事,こと、すなわちイスラエルのすべての人々,ひとびとの中,なかで、地,ちが口,くちを開,ひらき、彼,かれらと、その家族,かぞくと、天幕,てんまくと、彼,かれらに従,したがうすべてのものを、のみつくした事,ことなどを彼,かれらは知,しらず、また見,みなかった。","tok":[["および"],["ルベン"],["の"],["子","こ"],["の"],["エリアブ"],["の"],["子","こ"],["、"],["ダタン"],["と"],["アビラム"],["と"],["に"],["された"],["事","こと"],["、"],["すなわち"],["イスラエル"],["の"],["すべて"],["の"],["人々","ひとびと"],["の"],["中","なか"],["で"],["、"],["地","ち"],["が"],["口","くち"],["を"],["開らき","ひらき"],["、"],["彼","かれ"],["ら"],["と"],["、"],["その"],["家族","かぞく"],["と"],["、"],["天幕","てんまく"],["と"],["、"],["彼","かれ"],["ら"],["に"],["従う","したがう"],["すべて"],["の"],["もの"],["を"],["、"],["のみ"],["つくした"],["事","こと"],["など"],["を"],["彼","かれ"],["ら"],["は"],["知らず","しらず"],["、"],["また"],["見なかった","みなかった"],["。"]]},{"verse":7,"text":"しかし、あなたがたは主,しゅが行,おこなわれたこれらの大,おおいなる事,ことを、ことごとく目,めに見,みたのである。","tok":[["しかし"],["、"],["あなた"],["がた"],["は"],["主","しゅ"],["が"],["行なわれた","おこなわれた"],["これ"],["ら"],["の"],["大いなる","おおいなる"],["事","こと"],["を"],["、"],["ことごとく"],["目","め"],["に"],["見た","みた"],["ので"],["ある"],["。"]]},{"verse":8,"text":"ゆえに、わたしが、きょう、あなたがたに命,めいじる戒,いましめを、ことごとく守,まもらなければならない。そうすればあなたがたは強,つよくなり、渡,わたって行,いって取,とろうとする地,ちにはいって、それを取,とることができ、","tok":[["ゆえ"],["に"],["、"],["わたし"],["が"],["、"],["きょう"],["、"],["あなた"],["がた"],["に"],["命じる","めいじる"],["戒しめ","いましめ"],["を"],["、"],["ことごとく"],["守らなければ","まもらなければ"],["ならない"],["。"],["そう"],["すれば"],["あなた"],["がた"],["は"],["強く","つよく"],["なり"],["、"],["渡って","わたって"],["行って","いって"],["取ろう","とろう"],["と"],["する"],["地","ち"],["に"],["はいって"],["、"],["それ"],["を"],["取る","とる"],["こと"],["が"],["でき"],["、"]]},{"verse":9,"text":"かつ、主,しゅが先祖,せんぞたちに誓,ちかって彼,かれらとその子孫,しそんとに与,あたえようと言,いわれた地,ち、乳,ちちと蜜,みつの流,ながれる国,くににおいて、長,ながく生,いきることができるであろう。","tok":[["かつ"],["、"],["主","しゅ"],["が"],["先祖","せんぞ"],["たち"],["に"],["誓って","ちかって"],["彼","かれ"],["ら"],["と"],["その"],["子孫","しそん"],["と"],["に"],["与","あたえ"],["よう"],["と"],["言われた","いわれた"],["地","ち"],["、"],["乳","ちち"],["と"],["蜜","みつ"],["の"],["流れる","ながれる"],["国","くに"],["に"],["おいて"],["、"],["長く","ながく"],["生きる","いきる"],["こと"],["が"],["できるで"],["あろう"],["。"]]},{"verse":10,"text":"あなたがたが行,いって取,とろうとする地,ちは、あなたがたが出,でてきたエジプトの地,ちのようではない。あそこでは、青物,あおもの畑,ばたけでするように、あなたがたは種,たねをまき、足,あしでそれに水,みずを注,そそいだ。","tok":[["あなた"],["がた"],["が"],["行って","いって"],["取ろう","とろう"],["と"],["する"],["地","ち"],["は"],["、"],["あなた"],["がた"],["が"],["出て","でて"],["きた"],["エジプト"],["の"],["地","ち"],["の"],["よう"],["で"],["は"],["ない"],["。"],["あそこ"],["で"],["は"],["、"],["青物","あおもの"],["畑","ば"],["たけ"],["で"],["する"],["よう"],["に"],["、"],["あなた"],["がた"],["は"],["種","たね"],["を"],["まき"],["、"],["足","あし"],["で"],["それ"],["に"],["水","みず"],["を"],["注いだ","そそいだ"],["。"]]},{"verse":11,"text":"しかし、あなたがたが渡,わたって行,いって取,とる地,ちは、山,やまと谷,たにの多,おおい地,ちで、天,てんから降,ふる雨,あめで潤,うるおっている。","tok":[["しかし"],["、"],["あなた"],["がた"],["が"],["渡って","わたって"],["行って","いって"],["取る","とる"],["地","ち"],["は"],["、"],["山","やま"],["と"],["谷","たに"],["の"],["多い","おおい"],["地","ち"],["で"],["、"],["天","てん"],["から"],["降る","ふる"],["雨","あめ"],["で"],["潤って","うるおって"],["いる"],["。"]]},{"verse":12,"text":"その地,ちは、あなたの神,かみ、主,しゅが顧,かえりみられる所,ところで、年,としの始,はじめから年,としの終,おわりまで、あなたの神,かみ、主,しゅの目,めが常,つねにその上,うえにある。","tok":[["その"],["地","ち"],["は"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["顧られる","かえりみられる"],["所","ところ"],["で"],["、"],["年","とし"],["の"],["始","はじめ"],["から"],["年","とし"],["の"],["終","おわり"],["まで"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["目","め"],["が"],["常","つね"],["に"],["その"],["上","うえ"],["に"],["ある"],["。"]]},{"verse":13,"text":"もし、きょう、あなたがたに命,めいじるわたしの命令,めいれいによく聞,きき従,したがって、あなたがたの神,かみ、主,しゅを愛,あいし、心,こころをつくし、精神,せいしんをつくして仕,つかえるならば、","tok":[["もし"],["、"],["きょう"],["、"],["あなた"],["がた"],["に"],["命じる","めいじる"],["わたし"],["の"],["命令","めいれい"],["に"],["よく"],["聞","きき"],["従って","したがって"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["を"],["愛し","あいし"],["、"],["心","こころ"],["を"],["つくし"],["、"],["精神","せいしん"],["を"],["つくして"],["仕えるならば","つかえるならば"],["、"]]},{"verse":14,"text":"主,しゅはあなたがたの地,ちに雨,あめを、秋,あきの雨,あめ、春,はるの雨,あめともに、時,ときにしたがって降,ふらせ、穀物,こくもつと、ぶどう酒,しゅと、油,あぶらを取,とり入,いれさせ、","tok":[["主","しゅ"],["は"],["あなた"],["がた"],["の"],["地","ち"],["に"],["雨","あめ"],["を"],["、"],["秋","あき"],["の"],["雨","あめ"],["、"],["春","はる"],["の"],["雨","あめ"],["とも"],["に"],["、"],["時","とき"],["に"],["したがって"],["降らせ","ふらせ"],["、"],["穀物","こくもつ"],["と"],["、"],["ぶどう酒","ぶどうしゅ"],["と"],["、"],["油","あぶら"],["を"],["取入","とりいれ"],["させ"],["、"]]},{"verse":15,"text":"また家畜,かちくのために野,のに草,くさを生,はえさせられるであろう。あなたは飽,あきるほど食,たべることができるであろう。","tok":[["また"],["家畜","かちく"],["の"],["ため"],["に"],["野","の"],["に"],["草","くさ"],["を"],["生えさせられるで","はえさせられるで"],["あろう"],["。"],["あなた"],["は"],["飽きる","あきる"],["ほど"],["食べる","たべる"],["こと"],["が"],["できるで"],["あろう"],["。"]]},{"verse":16,"text":"あなたがたは心,こころが迷,まよい、離,はなれ去,さって、他,たの神々,かみがみに仕,つかえ、それを拝,おがむことのないよう、慎,つつしまなければならない。","tok":[["あなた"],["がた"],["は"],["心","こころ"],["が"],["迷い","まよい"],["、"],["離れ","はなれ"],["去て","さって"],["、"],["他","た"],["の"],["神々","かみがみ"],["に"],["仕え","つかえ"],["、"],["それ"],["を"],["拝む","おがむ"],["こと"],["の"],["ない"],["よう"],["、"],["慎しまなければ","つつしまなければ"],["ならない"],["。"]]},{"verse":17,"text":"おそらく主,しゅはあなたがたにむかい怒,いかりを発,はっして、天,てんを閉,とざされるであろう。そのため雨,あめは降,ふらず、地,ちは産物,さんぶつを出,ださず、あなたがたは主,しゅが賜,たまわる良,よい地,ちから、すみやかに滅,ほろびうせるであろう。","tok":[["おそらく"],["主","しゅ"],["は"],["あなた"],["がた"],["に"],["むかい"],["怒り","いかり"],["を"],["発して","はっして"],["、"],["天","てん"],["を"],["閉ざされるで","とざされるで"],["あろう"],["。"],["その"],["ため"],["雨","あめ"],["は"],["降らず","ふらず"],["、"],["地","ち"],["は"],["産物","さんぶつ"],["を"],["出さず","ださず"],["、"],["あなた"],["がた"],["は"],["主","しゅ"],["が"],["賜わる","たまわる"],["良い","よい"],["地","ち"],["から"],["、"],["すみやか"],["に"],["滅び","ほろび"],["うせるで"],["あろう"],["。"]]},{"verse":18,"text":"それゆえ、これらのわたしの言葉,ことばを心,こころと魂,たましいにおさめ、またそれを手,てにつけて、しるしとし、目,めの間,あいだに置,おいて覚,おぼえとし、","tok":[["それ"],["ゆえ"],["、"],["これ"],["ら"],["の"],["わたし"],["の"],["言葉","ことば"],["を"],["心","こころ"],["と"],["魂","たましい"],["に"],["おさめ"],["、"],["また"],["それ"],["を"],["手","て"],["に"],["つけて"],["、"],["しるし"],["と"],["し"],["、"],["目","め"],["の"],["間","あいだ"],["に"],["置いて","おいて"],["覚え","おぼえ"],["と"],["し"],["、"]]},{"verse":19,"text":"これを子供,こどもたちに教,おしえ、家,いえに座,ざしている時,ときも、道,みちを歩,あるく時,ときも、寝,ねる時,ときも、起,おきる時,ときも、それについて語,かたり、","tok":[["これ"],["を"],["子供","こども"],["たち"],["に"],["教え","おしえ"],["、"],["家","いえ"],["に"],["座して","ざして"],["いる"],["時","とき"],["も"],["、"],["道","みち"],["を"],["歩く","あるく"],["時","とき"],["も"],["、"],["寝る","ねる"],["時","とき"],["も"],["、"],["起きる","おきる"],["時","とき"],["も"],["、"],["それ"],["について"],["語り","かたり"],["、"]]},{"verse":20,"text":"また家,いえの入口,いりぐちの柱,はしらと、門,もんにそれを書,かきしるさなければならない。","tok":[["また"],["家","いえ"],["の"],["入口","いりぐち"],["の"],["柱","はしら"],["と"],["、"],["門","もん"],["に"],["それ"],["を"],["書きしるさなければ","かきしるさなければ"],["ならない"],["。"]]},{"verse":21,"text":"そうすれば、主,しゅが先祖,せんぞたちに与,あたえようと誓,ちかわれた地,ちに、あなたがたの住,すむ日数,にっすうおよびあなたがたの子供,こどもたちの住,すむ日数,にっすうは、天,てんが地,ちをおおう日数,にっすうのように多,おおいであろう。","tok":[["そう"],["すれば"],["、"],["主","しゅ"],["が"],["先祖","せんぞ"],["たち"],["に"],["与","あたえ"],["よう"],["と"],["誓われた","ちかわれた"],["地","ち"],["に"],["、"],["あなた"],["がた"],["の"],["住む","すむ"],["日数","にっすう"],["および"],["あなた"],["がた"],["の"],["子供","こども"],["たち"],["の"],["住む","すむ"],["日数","にっすう"],["は"],["、"],["天","てん"],["が"],["地","ち"],["を"],["おおう"],["日数","にっすう"],["の"],["よう"],["に"],["多いで","おおいで"],["あろう"],["。"]]},{"verse":22,"text":"もしわたしがあなたがたに命,めいじるこのすべての命令,めいれいをよく守,まもって行,おこない、あなたがたの神,かみ、主,しゅを愛,あいし、そのすべての道,みちに歩,あゆみ、主,しゅにつき従,したがうならば、","tok":[["もし"],["わたし"],["が"],["あなた"],["がた"],["に"],["命じる","めいじる"],["この"],["すべて"],["の"],["命令","めいれい"],["を"],["よく"],["守って","まもって"],["行ない","おこない"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["を"],["愛し","あいし"],["、"],["その"],["すべて"],["の"],["道","みち"],["に"],["歩み","あゆみ"],["、"],["主に","しゅに"],["つき従うならば","つきしたがうならば"],["、"]]},{"verse":23,"text":"主,しゅはこの国々,くにぐにの民,たみを皆,みな、あなたがたの前,まえから追,おい払,はらわれ、あなたがたはあなたがたよりも大,おおきく、かつ強,つよい国々,くにぐにを取,とるに至,いたるであろう。","tok":[["主","しゅ"],["は"],["この"],["国々","くにぐに"],["の"],["民","たみ"],["を"],["皆","みな"],["、"],["あなた"],["がた"],["の"],["前","まえ"],["から"],["追い払われ","おいはらわれ"],["、"],["あなた"],["がた"],["は"],["あなた"],["が"],["たより"],["も"],["大きく","おおきく"],["、"],["かつ"],["強い","つよい"],["国々","くにぐに"],["を"],["取る","とる"],["に"],["至るで","いたるで"],["あろう"],["。"]]},{"verse":24,"text":"あなたがたが足,あしの裏,うらで踏,ふむ所,ところは皆,みな、あなたがたのものとなり、あなたがたの領域,りょういきは荒野,あらのからレバノンに及,および、また大川,おおかわユフラテから西,にしの海,うみに及,およぶであろう。","tok":[["あなた"],["がた"],["が"],["足","あし"],["の"],["裏","うら"],["で"],["踏む","ふむ"],["所","ところ"],["は"],["皆","みな"],["、"],["あなた"],["がた"],["の"],["もの"],["と"],["なり"],["、"],["あなた"],["がた"],["の"],["領域","りょういき"],["は"],["荒野","あら"],["の"],["から"],["レバノン"],["に"],["及","および"],["、"],["また"],["大川","おおかわ"],["ユフラテ"],["から"],["西","にし"],["の"],["海","うみ"],["に"],["及ぶで","およぶで"],["あろう"],["。"]]},{"verse":25,"text":"だれもあなたがたに立,たち向,むかうことのできる者,ものはないであろう。あなたがたの神,かみ、主,しゅは、かつて言,いわれたように、あなたがたの踏,ふみ入,いる地,ちの人々,ひとびとが、あなたがたを恐,おそれおののくようにされるであろう。","tok":[["だれ"],["も"],["あなた"],["がた"],["に"],["立ち向かう","たちむかう"],["こと"],["の"],["できる"],["者","もの"],["は"],["ないで"],["あろう"],["。"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["、"],["かつて"],["言われた","いわれた"],["よう"],["に"],["、"],["あなた"],["がた"],["の"],["踏み入る","ふみいる"],["地","ち"],["の"],["人々","ひとびと"],["が"],["、"],["あなた"],["がた"],["を"],["恐れおののく","おそれおののく"],["よう"],["に"],["されるで"],["あろう"],["。"]]},{"verse":26,"text":"見,みよ、わたしは、きょう、あなたがたの前,まえに祝福,しゅくふくと、のろいとを置,おく。","tok":[["見よ","みよ"],["、"],["わたし"],["は"],["、"],["きょう"],["、"],["あなた"],["がた"],["の"],["前","まえ"],["に"],["祝福","しゅくふく"],["と"],["、"],["のろい"],["と"],["を"],["置く","おく"],["。"]]},{"verse":27,"text":"もし、きょう、わたしがあなたがたに命,めいじるあなたがたの神,かみ、主,しゅの命令,めいれいに聞,きき従,したがうならば、祝福,しゅくふくを受,うけるであろう。","tok":[["もし"],["、"],["きょう"],["、"],["わたし"],["が"],["あなた"],["がた"],["に"],["命じる","めいじる"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["命令","めいれい"],["に"],["聞","きき"],["従うならば","したがうならば"],["、"],["祝福","しゅくふく"],["を"],["受るで","うけるで"],["あろう"],["。"]]},{"verse":28,"text":"もしあなたがたの神,かみ、主,しゅの命令,めいれいに聞,きき従,したがわず、わたしが、きょう、あなたがたに命,めいじる道,みちを離,はなれ、あなたがたの知,しらなかった他,たの神々,かみがみに従,したがうならば、のろいを受,うけるであろう。","tok":[["もし"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["命令","めいれい"],["に"],["聞","きき"],["従わず","したがわず"],["、"],["わたし"],["が"],["、"],["きょう"],["、"],["あなた"],["がた"],["に"],["命じる","めいじる"],["道","みち"],["を"],["離れ","はなれ"],["、"],["あなた"],["がた"],["の"],["知らなかった","しらなかった"],["他","た"],["の"],["神々","かみがみ"],["に"],["従うならば","したがうならば"],["、"],["のろい"],["を"],["受るで","うけるで"],["あろう"],["。"]]},{"verse":29,"text":"あなたの神,かみ、主,しゅが、あなたの行,いって占領,せんりょうする地,ちにあなたを導,みちびき入,いれられる時,とき、あなたはゲリジム山,やまに祝福,しゅくふくを置,おき、エバル山,やまにのろいを置,おかなければならない。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["、"],["あなた"],["の"],["行って","いって"],["占領","せんりょう"],["する"],["地","ち"],["に"],["あなた"],["を"],["導き入れられる","みちびきいれられる"],["時","とき"],["、"],["あなた"],["は"],["ゲリジム"],["山","やま"],["に"],["祝福","しゅくふく"],["を"],["置き","おき"],["、"],["エバル山","えばるやま"],["に"],["のろい"],["を"],["置かなければ","おかなければ"],["ならない"],["。"]]},{"verse":30,"text":"これらの山,やまはヨルダンの向,むこう側,がわ、アラバに住,すんでいるカナンびとの地,ちで、日,ひの入,いる方,ほうの道,みちの西側,にしがわにあり、ギルガルに向,むかいあって、モレのテレビンの木,きの近,ちかくにあるではないか。","tok":[["これ"],["ら"],["の"],["山","やま"],["は"],["ヨルダン"],["の"],["向こう側","むこうがわ"],["、"],["アラバ"],["に"],["住んで","すんで"],["いる"],["カナン"],["びと"],["の"],["地","ち"],["で"],["、"],["日","ひ"],["の"],["入る","いる"],["方","ほう"],["の"],["道","みち"],["の"],["西側","にしがわ"],["に"],["あり"],["、"],["ギルガル"],["に"],["向","むかい"],["あって"],["、"],["モレ"],["の"],["テレビン"],["の"],["木","き"],["の"],["近く","ちかく"],["に"],["ある"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":31,"text":"あなたがたはヨルダンを渡,わたり、あなたがたの神,かみ、主,しゅが賜,たまわる地,ちにはいって、それを占領,せんりょうしようとしている。あなたがたはそれを占領,せんりょうして、そこに住,すむであろう。","tok":[["あなた"],["がた"],["は"],["ヨルダン"],["を"],["渡り","わたり"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["賜わる","たまわる"],["地","ち"],["に"],["はいって"],["、"],["それ"],["を"],["占領","せんりょう"],["しよう"],["として"],["いる"],["。"],["あなた"],["がた"],["は"],["それ"],["を"],["占領","せんりょう"],["して"],["、"],["そこ"],["に"],["住むで","すむで"],["あろう"],["。"]]},{"verse":32,"text":"それゆえ、わたしが、きょう、あなたがたに授,さづける定,さだめと、おきてをことごとく守,まもって行,おこなわなければならない。","tok":[["それ"],["ゆえ"],["、"],["わたし"],["が"],["、"],["きょう"],["、"],["あなた"],["がた"],["に"],["授","さ"],["づける"],["定め","さだめ"],["と"],["、"],["おきて"],["を"],["ことごとく"],["守って","まもって"],["行なわなければ","おこなわなければ"],["ならない"],["。"]]}]
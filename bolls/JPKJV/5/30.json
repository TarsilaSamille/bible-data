[{"verse":1,"text":"わたしがあなたがたの前,まえに述,のべたこのもろもろの祝福,しゅくふくと、のろいの事,ことがあなたに臨,のぞみ、あなたがあなたの神,かみ、主,しゅに追,おいやられたもろもろの国民,こくみんのなかでこの事,ことを心,こころに考,かんがえて、","tok":[["わたし"],["が"],["あなた"],["がた"],["の"],["前","まえ"],["に"],["述べた","のべた"],["この"],["もろもろ"],["の"],["祝福","しゅくふく"],["と"],["、"],["のろい"],["の"],["事","こと"],["が"],["あなた"],["に"],["臨み","のぞみ"],["、"],["あなた"],["が"],["あなた"],["の"],["神","かみ"],["、"],["主に","しゅに"],["追いやられた","おいやられた"],["もろもろ"],["の"],["国民","こくみん"],["の"],["なか"],["で"],["この"],["事","こと"],["を"],["心","こころ"],["に"],["考","かんがえ"],["て"],["、"]]},{"verse":2,"text":"あなたもあなたの子供,こどもも共,ともにあなたの神,かみ、主,しゅに立,たち帰,かえり、わたしが、きょう、命,めいじるすべてのことにおいて、心,こころをつくし、精神,せいしんをつくして、主,しゅの声,こえに聞,きき従,したがうならば、","tok":[["あなた"],["も"],["あなた"],["の"],["子供","こども"],["も"],["共","とも"],["に"],["あなた"],["の"],["神","かみ"],["、"],["主に","しゅに"],["立ち","たち"],["帰えり","かえり"],["、"],["わたし"],["が"],["、"],["きょう"],["、"],["命じる","めいじる"],["すべて"],["の"],["こと"],["に"],["おいて"],["、"],["心","こころ"],["を"],["つくし"],["、"],["精神","せいしん"],["を"],["つくして"],["、"],["主","しゅ"],["の"],["声","こえ"],["に"],["聞","きき"],["従うならば","したがうならば"],["、"]]},{"verse":3,"text":"あなたの神,かみ、主,しゅはあなたを再,ふたたび栄,さかえさせ、あなたをあわれみ、あなたの神,かみ、主,しゅはあなたを散,ちらされた国々,くにぐにから再,ふたたび集,あつめられるであろう。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["あなた"],["を"],["再び","ふたたび"],["栄","さかえ"],["させ"],["、"],["あなた"],["を"],["あわれみ"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["あなた"],["を"],["散らされた","ちらされた"],["国々","くにぐに"],["から"],["再び","ふたたび"],["集められるで","あつめられるで"],["あろう"],["。"]]},{"verse":4,"text":"たといあなたが天,てんのはてに追,おいやられても、あなたの神,かみ、主,しゅはそこからあなたを集,あつめ、そこからあなたを連,つれ帰,かえられるであろう。","tok":[["たとい"],["あなた"],["が"],["天","てん"],["の"],["はて"],["に"],["追いやられて","おいやられて"],["も"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["そこ"],["から"],["あなた"],["を"],["集め","あつめ"],["、"],["そこ"],["から"],["あなた"],["を"],["連れ","つれ"],["帰えられるで","かえられるで"],["あろう"],["。"]]},{"verse":5,"text":"あなたの神,かみ、主,しゅはあなたの先祖,せんぞが所有,しょゆうした地,ちにあなたを帰,かえらせ、あなたはそれを所有,しょゆうするに至,いたるであろう。主,しゅはまたあなたを栄,さかえさせ、数,かずを増,まして先祖,せんぞたちよりも多,おおくされるであろう。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["あなた"],["の"],["先祖","せんぞ"],["が"],["所有","しょゆう"],["した"],["地","ち"],["に"],["あなた"],["を"],["帰えらせ","かえらせ"],["、"],["あなた"],["は"],["それ"],["を"],["所有","しょゆう"],["する"],["に"],["至るで","いたるで"],["あろう"],["。"],["主","しゅ"],["は"],["また"],["あなた"],["を"],["栄","さかえ"],["させ"],["、"],["数","かず"],["を"],["増して","まして"],["先祖","せんぞ"],["たち"],["より"],["も"],["多く","おおく"],["されるで"],["あろう"],["。"]]},{"verse":6,"text":"そしてあなたの神,かみ、主,しゅはあなたの心,こころとあなたの子孫,しそんの心,こころに割礼,かつれいを施,ほどこし、あなたをして、心,こころをつくし、精神,せいしんをつくしてあなたの神,かみ、主,しゅを愛,あいさせ、こうしてあなたに命,いのちを得,えさせられるであろう。","tok":[["そして"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["あなた"],["の"],["心","こころ"],["と"],["あなた"],["の"],["子孫","しそん"],["の"],["心","こころ"],["に"],["割礼","かつれい"],["を"],["施し","ほどこし"],["、"],["あなた"],["を"],["して"],["、"],["心","こころ"],["を"],["つくし"],["、"],["精神","せいしん"],["を"],["つくして"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["を"],["愛させ","あいさせ"],["、"],["こう"],["して"],["あなた"],["に"],["命","いのち"],["を"],["得させられるで","えさせられるで"],["あろう"],["。"]]},{"verse":7,"text":"あなたの神,かみ、主,しゅはまた、あなたを迫害,はくがいする敵,てきと、あなたを憎,にくむ者,ものとに、このもろもろののろいをこうむらせられるであろう。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["また"],["、"],["あなた"],["を"],["迫害","はくがい"],["する"],["敵","てき"],["と"],["、"],["あなた"],["を"],["憎む","にくむ"],["者","もの"],["と"],["に"],["、"],["この"],["もろもろ"],["の"],["のろい"],["を"],["こうむらせられるで"],["あろう"],["。"]]},{"verse":8,"text":"しかし、あなたは再,ふたたび主,しゅの声,こえに聞,きき従,したがい、わたしが、きょう、あなたに命,めいじるすべての戒,いましめを守,まもるであろう。","tok":[["しかし"],["、"],["あなた"],["は"],["再び","ふたたび"],["主","しゅ"],["の"],["声","こえ"],["に"],["聞","きき"],["従い","したがい"],["、"],["わたし"],["が"],["、"],["きょう"],["、"],["あなた"],["に"],["命じる","めいじる"],["すべて"],["の"],["戒しめ","いましめ"],["を"],["守","まもる"],["で"],["あろう"],["。"]]},{"verse":9,"text":"そうすればあなたの神,かみ、主,しゅはあなたのするすべてのことと、あなたの身,みから生,うまれる者,ものと、家畜,かちくの産,うむものと、地,ちに産,さんする物,ものを豊,ゆたかに与,あたえて、あなたを栄,さかえさせられるであろう。すなわち主,しゅはあなたの先祖,せんぞたちを喜,よろこばれたように再,ふたたびあなたを喜,よろこんで、あなたを栄,さかえさせられるであろう。","tok":[["そう"],["すれば"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["あなた"],["の"],["する"],["すべて"],["の"],["こと"],["と"],["、"],["あなた"],["の"],["身","み"],["から"],["生まれる","うまれる"],["者","もの"],["と"],["、"],["家畜","かちく"],["の"],["産む","うむ"],["もの"],["と"],["、"],["地","ち"],["に"],["産する","さんする"],["物","もの"],["を"],["豊","ゆたか"],["に"],["与","あたえ"],["て"],["、"],["あなた"],["を"],["栄","さかえ"],["させられるで"],["あろう"],["。"],["すなわち"],["主","しゅ"],["は"],["あなた"],["の"],["先祖","せんぞ"],["たち"],["を"],["喜こばれた","よろこばれた"],["よう"],["に"],["再び","ふたたび"],["あなた"],["を"],["喜こんで","よろこんで"],["、"],["あなた"],["を"],["栄","さかえ"],["させられるで"],["あろう"],["。"]]},{"verse":10,"text":"これはあなたが、あなたの神,かみ、主,しゅの声,こえに聞,ききしたがい、この律法,りっぽうの書,しょにしるされた戒,いましめと定,さだめとを守,まもり、心,こころをつくし、精神,せいしんをつくしてあなたの神,かみ、主,しゅに帰,きするからである。","tok":[["これ"],["は"],["あなた"],["が"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["声","こえ"],["に"],["聞き","きき"],["したがい"],["、"],["この"],["律法","りっぽう"],["の"],["書","しょ"],["に"],["しるされた"],["戒しめ","いましめ"],["と"],["定め","さだめ"],["と"],["を"],["守り","まもり"],["、"],["心","こころ"],["を"],["つくし"],["、"],["精神","せいしん"],["を"],["つくして"],["あなた"],["の"],["神","かみ"],["、"],["主に","しゅに"],["帰する","きする"],["から"],["で"],["ある"],["。"]]},{"verse":11,"text":"わたしが、きょう、あなたに命,めいじるこの戒,いましめは、むずかしいものではなく、また遠,とおいものでもない。","tok":[["わたし"],["が"],["、"],["きょう"],["、"],["あなた"],["に"],["命じる","めいじる"],["この"],["戒しめ","いましめ"],["は"],["、"],["むずかしい"],["もの"],["で"],["は"],["なく"],["、"],["また"],["遠い","とおい"],["もの"],["で"],["も"],["ない"],["。"]]},{"verse":12,"text":"これは天,てんにあるのではないから、『だれがわれわれのために天,てんに上,のぼり、それをわれわれのところへ持,もってきて、われわれに聞,きかせ、行,おこなわせるであろうか』と言,いうに及,およばない。","tok":[["これ"],["は"],["天","てん"],["に"],["ある"],["ので"],["は"],["ない"],["から"],["、"],["『"],["だれ"],["が"],["われわれ"],["の"],["ため"],["に"],["天","てん"],["に"],["上り","のぼり"],["、"],["それ"],["を"],["われわれ"],["の"],["ところ"],["へ"],["持って","もって"],["きて"],["、"],["われわれ"],["に"],["聞かせ","きかせ"],["、"],["行なわせるで","おこなわせるで"],["あろう"],["か"],["』"],["と"],["言","いう"],["に"],["及ばない","およばない"],["。"]]},{"verse":13,"text":"またこれは海,うみのかなたにあるのではないから、『だれがわれわれのために海,うみを渡,わたって行,いき、それをわれわれのところへ携,たずさえてきて、われわれに聞,きかせ、行,おこなわせるであろうか』と言,いうに及,およばない。","tok":[["また"],["これ"],["は"],["海","うみ"],["の"],["かなた"],["に"],["ある"],["ので"],["は"],["ない"],["から"],["、"],["『"],["だれ"],["が"],["われわれ"],["の"],["ため"],["に"],["海","うみ"],["を"],["渡って","わたって"],["行き","いき"],["、"],["それ"],["を"],["われわれ"],["の"],["ところ"],["へ"],["携えて","たずさえて"],["きて"],["、"],["われわれ"],["に"],["聞かせ","きかせ"],["、"],["行なわせるで","おこなわせるで"],["あろう"],["か"],["』"],["と"],["言","いう"],["に"],["及ばない","およばない"],["。"]]},{"verse":14,"text":"この言葉,ことばはあなたに、はなはだ近,ちかくあってあなたの口,くちにあり、またあなたの心,こころにあるから、あなたはこれを行,おこなうことができる。","tok":[["この"],["言葉","ことば"],["は"],["あなた"],["に"],["、"],["はなはだ"],["近く","ちかく"],["あって"],["あなた"],["の"],["口","くち"],["に"],["あり"],["、"],["また"],["あなた"],["の"],["心","こころ"],["に"],["ある"],["から"],["、"],["あなた"],["は"],["これ"],["を"],["行なう","おこなう"],["こと"],["が"],["できる"],["。"]]},{"verse":15,"text":"見,みよ、わたしは、きょう、命,いのちとさいわい、および死,しと災,わざわいをあなたの前,まえに置,おいた。","tok":[["見よ","みよ"],["、"],["わたし"],["は"],["、"],["きょう"],["、"],["命","いのち"],["と"],["さいわい"],["、"],["および"],["死","し"],["と"],["災","わざわい"],["を"],["あなた"],["の"],["前","まえ"],["に"],["置いた","おいた"],["。"]]},{"verse":16,"text":"すなわちわたしは、きょう、あなたにあなたの神,かみ、主,しゅを愛,あいし、その道,みちに歩,あゆみ、その戒,いましめと定,さだめと、おきてとを守,まもることを命,めいじる。それに従,したがうならば、あなたは生,いきながらえ、その数,かずは多,おおくなるであろう。またあなたの神,かみ、主,しゅはあなたが行,いって取,とる地,ちであなたを祝福,しゅくふくされるであろう。","tok":[["すなわち"],["わたし"],["は"],["、"],["きょう"],["、"],["あなた"],["に"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["を"],["愛し","あいし"],["、"],["その"],["道","みち"],["に"],["歩み","あゆみ"],["、"],["その"],["戒しめ","いましめ"],["と"],["定め","さだめ"],["と"],["、"],["おきて"],["と"],["を"],["守","まもる"],["こと"],["を"],["命じる","めいじる"],["。"],["それ"],["に"],["従うならば","したがうならば"],["、"],["あなた"],["は"],["生きながらえ","いきながらえ"],["、"],["その"],["数","かず"],["は"],["多く","おおく"],["なるで"],["あろう"],["。"],["また"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["あなた"],["が"],["行って","いって"],["取る","とる"],["地","ち"],["で"],["あなた"],["を"],["祝福","しゅくふく"],["されるで"],["あろう"],["。"]]},{"verse":17,"text":"しかし、もしあなたが心,こころをそむけて聞,きき従,したがわず、誘,さそわれて他,たの神々,かみがみを拝,おがみ、それに仕,つかえるならば、","tok":[["しかし"],["、"],["もし"],["あなた"],["が"],["心","こころ"],["を"],["そむけて"],["聞","きき"],["従わず","したがわず"],["、"],["誘われて","さそわれて"],["他","た"],["の"],["神々","かみがみ"],["を"],["拝み","おがみ"],["、"],["それ"],["に"],["仕えるならば","つかえるならば"],["、"]]},{"verse":18,"text":"わたしは、きょう、あなたがたに告,つげる。あなたがたは必,かならず滅,ほろびるであろう。あなたがたはヨルダンを渡,わたり、はいって行,いって取,とる地,ちでながく命,いのちを保,たもつことができないであろう。","tok":[["わたし"],["は"],["、"],["きょう"],["、"],["あなた"],["がた"],["に"],["告げる","つげる"],["。"],["あなた"],["がた"],["は"],["必","かならず"],["滅びるで","ほろびるで"],["あろう"],["。"],["あなた"],["がた"],["は"],["ヨルダン"],["を"],["渡り","わたり"],["、"],["はい"],["って"],["行って","いって"],["取る","とる"],["地","ち"],["で"],["ながく"],["命","いのち"],["を"],["保つ","たもつ"],["こと"],["が"],["できないで"],["あろう"],["。"]]},{"verse":19,"text":"わたしは、きょう、天,てんと地,ちを呼,よんであなたがたに対,たいする証人,しょうにんとする。わたしは命,いのちと死,しおよび祝福,しゅくふくとのろいをあなたの前,まえに置,おいた。あなたは命,いのちを選,えらばなければならない。そうすればあなたとあなたの子孫,しそんは生,いきながらえることができるであろう。","tok":[["わたし"],["は"],["、"],["きょう"],["、"],["天","てん"],["と"],["地","ち"],["を"],["呼んで","よんで"],["あなた"],["がた"],["に"],["対する","たいする"],["証人","しょうにん"],["と"],["する"],["。"],["わたし"],["は"],["命","いのち"],["と"],["死","し"],["および"],["祝福","しゅくふく"],["と"],["のろい"],["を"],["あなた"],["の"],["前","まえ"],["に"],["置いた","おいた"],["。"],["あなた"],["は"],["命","いのち"],["を"],["選らば","えらば"],["なければ"],["ならない"],["。"],["そう"],["すれば"],["あなた"],["と"],["あなた"],["の"],["子孫","しそん"],["は"],["生きながらえる","いきながらえる"],["こと"],["が"],["できるで"],["あろう"],["。"]]},{"verse":20,"text":"すなわちあなたの神,かみ、主,しゅを愛,あいして、その声,こえを聞,きき、主,しゅにつき従,したがわなければならない。そうすればあなたは命,いのちを得,え、かつ長,ながく命,いのちを保,たもつことができ、主,しゅが先祖,せんぞアブラハム、イサク、ヤコブに与,あたえると誓,ちかわれた地,ちに住,すむことができるであろう」。","tok":[["すなわち"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["を"],["愛して","あいして"],["、"],["その"],["声","こえ"],["を"],["聞","きき"],["、"],["主に","しゅに"],["つき従わなければ","つきしたがわなければ"],["ならない"],["。"],["そう"],["すれば"],["あなた"],["は"],["命","いのち"],["を"],["得","え"],["、"],["かつ"],["長く","ながく"],["命","いのち"],["を"],["保つ","たもつ"],["こと"],["が"],["でき"],["、"],["主","しゅ"],["が"],["先祖","せんぞ"],["アブラハム"],["、"],["イサク"],["、"],["ヤコブ"],["に"],["与える","あたえる"],["と"],["誓われた","ちかわれた"],["地","ち"],["に"],["住む","すむ"],["こと"],["が"],["できるで"],["あろう"],["」"],["。"]]}]
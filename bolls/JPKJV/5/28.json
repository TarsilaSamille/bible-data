[{"verse":1,"text":"もしあなたが、あなたの神,かみ、主,しゅの声,こえによく聞,きき従,したがい、わたしが、きょう、命,めいじるすべての戒,いましめを守,まもり行,おこなうならば、あなたの神,かみ、主,しゅはあなたを地,ちのもろもろの国民,こくみんの上,うえに立,たたせられるであろう。","tok":[["もし"],["あなた"],["が"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["声","こえ"],["に"],["よく"],["聞","きき"],["従い","したがい"],["、"],["わたし"],["が"],["、"],["きょう"],["、"],["命じる","めいじる"],["すべて"],["の"],["戒しめ","いましめ"],["を"],["守り","まもり"],["行なうならば","おこなうならば"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["あなた"],["を"],["地","ち"],["の"],["もろもろ"],["の"],["国民","こくみん"],["の"],["上","うえ"],["に"],["立たせられるで","たたせられるで"],["あろう"],["。"]]},{"verse":2,"text":"もし、あなたがあなたの神,かみ、主,しゅの声,こえに聞,きき従,したがうならば、このもろもろの祝福,しゅくふくはあなたに臨,のぞみ、あなたに及,およぶであろう。","tok":[["もし"],["、"],["あなた"],["が"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["声","こえ"],["に"],["聞","きき"],["従うならば","したがうならば"],["、"],["この"],["もろもろ"],["の"],["祝福","しゅくふく"],["は"],["あなた"],["に"],["臨み","のぞみ"],["、"],["あなた"],["に"],["及ぶで","およぶで"],["あろう"],["。"]]},{"verse":3,"text":"あなたは町,まちの内,うちでも祝福,しゅくふくされ、畑,はたけでも祝福,しゅくふくされるであろう。","tok":[["あなた"],["は"],["町","まち"],["の"],["内","うち"],["で"],["も"],["祝福","しゅくふく"],["され"],["、"],["畑","はたけ"],["で"],["も"],["祝福","しゅくふく"],["されるで"],["あろう"],["。"]]},{"verse":4,"text":"またあなたの身,みから生,うまれるもの、地,ちに産,さんする物,もの、家畜,かちくの産,うむもの、すなわち牛,うしの子,こ、羊,ひつじの子,こは祝福,しゅくふくされるであろう。","tok":[["また"],["あなた"],["の"],["身","み"],["から"],["生まれる","うまれる"],["もの"],["、"],["地","ち"],["に"],["産する","さんする"],["物","もの"],["、"],["家畜","かちく"],["の"],["産む","うむ"],["もの"],["、"],["すなわち"],["牛","うし"],["の"],["子","こ"],["、"],["羊","ひつじ"],["の"],["子","こ"],["は"],["祝福","しゅくふく"],["されるで"],["あろう"],["。"]]},{"verse":5,"text":"またあなたのかごと、こねばちは祝福,しゅくふくされるであろう。","tok":[["また"],["あなた"],["の"],["かご"],["と"],["、"],["こね"],["ばち"],["は"],["祝福","しゅくふく"],["されるで"],["あろう"],["。"]]},{"verse":6,"text":"あなたは、はいるにも祝福,しゅくふくされ、出,でるにも祝福,しゅくふくされるであろう。","tok":[["あなた"],["は"],["、"],["はいる"],["に"],["も"],["祝福","しゅくふく"],["され"],["、"],["出る","でる"],["に"],["も"],["祝福","しゅくふく"],["されるで"],["あろう"],["。"]]},{"verse":7,"text":"敵,てきが起,たってあなたを攻,せめる時,ときは、主,しゅはあなたにそれを撃,うち敗,やぶらせられるであろう。彼,かれらは一つの道,みちから攻,せめて来,くるが、あなたの前,まえで七つの道,みちから逃,にげ去,さるであろう。","tok":[["敵","てき"],["が"],["起って","たって"],["あなた"],["を"],["攻める","せめる"],["時","とき"],["は"],["、"],["主","しゅ"],["は"],["あなた"],["に"],["それ"],["を"],["撃ち","うち"],["敗らせられるで","やぶらせられるで"],["あろう"],["。"],["彼","かれ"],["ら"],["は"],["一","ひと"],["つ"],["の"],["道","みち"],["から"],["攻めて","せめて"],["来る","くる"],["が"],["、"],["あなた"],["の"],["前","まえ"],["で"],["七","なな"],["つ"],["の"],["道","みち"],["から"],["逃","にげ"],["去るで","さるで"],["あろう"],["。"]]},{"verse":8,"text":"主,しゅは命,めいじて祝福,しゅくふくをあなたの倉,くらと、あなたの手,てのすべてのわざにくだし、あなたの神,かみ、主,しゅが賜,たまわる地,ちであなたを祝福,しゅくふくされるであろう。","tok":[["主","しゅ"],["は"],["命じて","めいじて"],["祝福","しゅくふく"],["を"],["あなた"],["の"],["倉","くら"],["と"],["、"],["あなた"],["の"],["手","て"],["の"],["すべて"],["の"],["わざ"],["に"],["くだし"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["賜わる","たまわる"],["地","ち"],["で"],["あなた"],["を"],["祝福","しゅくふく"],["されるで"],["あろう"],["。"]]},{"verse":9,"text":"もし、あなたの神,かみ、主,しゅの戒,いましめを守,まもり、その道,みちを歩,あゆむならば、主,しゅは誓,ちかわれたようにあなたを立,たてて、その聖,せいなる民,たみとされるであろう。","tok":[["もし"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["戒しめ","いましめ"],["を"],["守り","まもり"],["、"],["その"],["道","みち"],["を"],["歩むならば","あゆむならば"],["、"],["主","しゅ"],["は"],["誓われた","ちかわれた"],["よう"],["に"],["あなた"],["を"],["立てて","たてて"],["、"],["その"],["聖","せい"],["なる"],["民","たみ"],["と"],["されるで"],["あろう"],["。"]]},{"verse":10,"text":"そうすれば地,ちのすべての民,たみは皆,みなあなたが主,しゅの名,なをもって唱,となえられるのを見,みてあなたを恐,おそれるであろう。","tok":[["そう"],["すれば"],["地","ち"],["の"],["すべて"],["の"],["民","たみ"],["は"],["皆","みな"],["あなた"],["が"],["主","しゅ"],["の"],["名","な"],["を"],["もって"],["唱えられる","となえられる"],["の"],["を"],["見て","みて"],["あなた"],["を"],["恐れるで","おそれるで"],["あろう"],["。"]]},{"verse":11,"text":"主,しゅがあなたに与,あたえると先祖,せんぞに誓,ちかわれた地,ちで、主,しゅは良,よい物,もの、すなわちあなたの身,みから生,うまれる者,もの、家畜,かちくの産,うむもの、地,ちに産,さんする物,ものを豊,ゆたかにされるであろう。","tok":[["主","しゅ"],["が"],["あなた"],["に"],["与える","あたえる"],["と"],["先祖","せんぞ"],["に"],["誓われた","ちかわれた"],["地","ち"],["で"],["、"],["主","しゅ"],["は"],["良い","よい"],["物","もの"],["、"],["すなわち"],["あなた"],["の"],["身","み"],["から"],["生まれる","うまれる"],["者","もの"],["、"],["家畜","かちく"],["の"],["産む","うむ"],["もの"],["、"],["地","ち"],["に"],["産する","さんする"],["物","もの"],["を"],["豊","ゆたか"],["に"],["されるで"],["あろう"],["。"]]},{"verse":12,"text":"主,しゅはその宝,たからの蔵,くらである天,てんをあなたのために開,ひらいて、雨,あめを季節,きせつにしたがってあなたの地,ちに降,ふらせ、あなたの手,てのすべてのわざを祝福,しゅくふくされるであろう。あなたは多,おおくの国民,こくみんに貸,かすようになり、借,かりることはないであろう。","tok":[["主","しゅ"],["は"],["その"],["宝","たから"],["の"],["蔵","くら"],["で"],["ある"],["天","てん"],["を"],["あなた"],["の"],["ため"],["に"],["開らいて","ひらいて"],["、"],["雨","あめ"],["を"],["季節","きせつ"],["に"],["したがって"],["あなた"],["の"],["地","ち"],["に"],["降らせ","ふらせ"],["、"],["あなた"],["の"],["手","て"],["の"],["すべて"],["の"],["わざ"],["を"],["祝福","しゅくふく"],["されるで"],["あろう"],["。"],["あなた"],["は"],["多く","おおく"],["の"],["国民","こくみん"],["に"],["貸す","かす"],["よう"],["に"],["なり"],["、"],["借りる","かりる"],["こと"],["は"],["ないで"],["あろう"],["。"]]},{"verse":13,"text":"主,しゅはあなたをかしらとならせ、尾,おとはならせられないであろう。あなたはただ栄,さかえて衰,おとろえることはないであろう。きょう、わたしが命,めいじるあなたの神,かみ、主,しゅの戒,いましめに聞,きき従,したがって、これを守,まもり行,おこなうならば、あなたは必,かならずこのようになるであろう。","tok":[["主","しゅ"],["は"],["あなた"],["を"],["かしら"],["と"],["ならせ"],["、"],["尾","お"],["と"],["は"],["ならせられないで"],["あろう"],["。"],["あなた"],["は"],["ただ"],["栄","さかえ"],["て"],["衰える","おとろえる"],["こと"],["は"],["ないで"],["あろう"],["。"],["きょう"],["、"],["わたし"],["が"],["命じる","めいじる"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["戒しめ","いましめ"],["に"],["聞","きき"],["従って","したがって"],["、"],["これ"],["を"],["守り","まもり"],["行なうならば","おこなうならば"],["、"],["あなた"],["は"],["必","かならず"],["この"],["よう"],["に"],["なるで"],["あろう"],["。"]]},{"verse":14,"text":"きょう、わたしが命,めいじるこのすべての言葉,ことばを離,はなれて右,みぎまたは左,ひだりに曲,まがり、他,たの神々,かみがみに従,したがい、それに仕,つかえてはならない。","tok":[["きょう"],["、"],["わたし"],["が"],["命じる","めいじる"],["この"],["すべて"],["の"],["言葉","ことば"],["を"],["離れて","はなれて"],["右","みぎ"],["また"],["は"],["左","ひだり"],["に"],["曲がり","まがり"],["、"],["他","た"],["の"],["神々","かみがみ"],["に"],["従い","したがい"],["、"],["それ"],["に"],["仕えて","つかえて"],["は"],["ならない"],["。"]]},{"verse":15,"text":"しかし、あなたの神,かみ、主,しゅの声,こえに聞,きき従,したがわず、きょう、わたしが命,めいじるすべての戒,いましめと定,さだめとを守,まもり行,おこなわないならば、このもろもろののろいがあなたに臨,のぞみ、あなたに及,およぶであろう。","tok":[["しかし"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["声","こえ"],["に"],["聞","きき"],["従わず","したがわず"],["、"],["きょう"],["、"],["わたし"],["が"],["命じる","めいじる"],["すべて"],["の"],["戒しめ","いましめ"],["と"],["定め","さだめ"],["と"],["を"],["守り","まもり"],["行なわないならば","おこなわないならば"],["、"],["この"],["もろもろ"],["の"],["のろい"],["が"],["あなた"],["に"],["臨み","のぞみ"],["、"],["あなた"],["に"],["及ぶで","およぶで"],["あろう"],["。"]]},{"verse":16,"text":"あなたは町,まちのうちでものろわれ、畑,はたけでものろわれ、","tok":[["あなた"],["は"],["町","まち"],["の"],["うち"],["で"],["も"],["のろわれ"],["、"],["畑","はたけ"],["で"],["も"],["のろわれ"],["、"]]},{"verse":17,"text":"あなたのかごも、こねばちものろわれ、","tok":[["あなた"],["の"],["かご"],["も"],["、"],["こね"],["ばち"],["も"],["のろわれ"],["、"]]},{"verse":18,"text":"あなたの身,みから生,うまれるもの、地,ちに産,さんする物,もの、牛,うしの子,こ、羊,ひつじの子,こものろわれるであろう。","tok":[["あなた"],["の"],["身","み"],["から"],["生まれる","うまれる"],["もの"],["、"],["地","ち"],["に"],["産する","さんする"],["物","もの"],["、"],["牛","うし"],["の"],["子","こ"],["、"],["羊","ひつじ"],["の"],["子","こ"],["も"],["のろわれるで"],["あろう"],["。"]]},{"verse":19,"text":"あなたは、はいるにものろわれ、出,でるにものろわれるであろう。","tok":[["あなた"],["は"],["、"],["はいる"],["に"],["も"],["のろわれ"],["、"],["出る","でる"],["に"],["も"],["のろわれるで"],["あろう"],["。"]]},{"verse":20,"text":"主,しゅはあなたが手,てをくだすすべての働,はたらきにのろいと、混乱,こんらんと、懲,こらしめとを送,おくられ、あなたはついに滅,ほろび、すみやかにうせ果,はてるであろう。これはあなたが悪,あくをおこなってわたしを捨,すてたからである。","tok":[["主","しゅ"],["は"],["あなた"],["が"],["手","て"],["を"],["くだす"],["すべて"],["の"],["働らき","はたらき"],["に"],["のろい"],["と"],["、"],["混乱","こんらん"],["と"],["、"],["懲らしめ","こらしめ"],["と"],["を"],["送られ","おくられ"],["、"],["あなた"],["は"],["ついに"],["滅び","ほろび"],["、"],["すみやか"],["に"],["うせ"],["果てるで","はてるで"],["あろう"],["。"],["これ"],["は"],["あなた"],["が"],["悪","あく"],["を"],["おこなって"],["わたし"],["を"],["捨てた","すてた"],["から"],["で"],["ある"],["。"]]},{"verse":21,"text":"主,しゅは疫病,えきびょうをあなたの身,みにつかせ、あなたが行,いって取,とる地,ちから、ついにあなたを断,たち滅,ほろぼされるであろう。","tok":[["主","しゅ"],["は"],["疫病","えきびょう"],["を"],["あなた"],["の"],["身","み"],["に"],["つかせ"],["、"],["あなた"],["が"],["行って","いって"],["取る","とる"],["地","ち"],["から"],["、"],["ついに"],["あなた"],["を"],["断ち","たち"],["滅ぼされるで","ほろぼされるで"],["あろう"],["。"]]},{"verse":22,"text":"主,しゅはまた肺病,はいびょうと熱病,ねつびょうと炎症,えんしょうと間,あいだけつ熱,ねつと、かんばつと、立,たち枯,がれと、腐,くさり穂,ほとをもってあなたを撃,うたれるであろう。これらのものはあなたを追,おい、ついにあなたを滅,ほろぼすであろう。","tok":[["主","しゅ"],["は"],["また"],["肺病","はいびょう"],["と"],["熱病","ねつびょう"],["と"],["炎症","えんしょう"],["と"],["間","あ"],["いだけつ"],["熱","ねつ"],["と"],["、"],["かん"],["ばつ"],["と"],["、"],["立ち枯れ","たちがれ"],["と"],["、"],["腐り","くさり"],["穂","ほ"],["と"],["を"],["もって"],["あなた"],["を"],["撃たれるで","うたれるで"],["あろう"],["。"],["これ"],["ら"],["の"],["もの"],["は"],["あなた"],["を"],["追い","おい"],["、"],["ついに"],["あなた"],["を"],["滅ぼすで","ほろぼすで"],["あろう"],["。"]]},{"verse":23,"text":"あなたの頭,あたまの上,うえの天,てんは青銅,せいどうとなり、あなたの下,したの地,ちは鉄,てつとなるであろう。","tok":[["あなた"],["の"],["頭","あたま"],["の"],["上","うえ"],["の"],["天","てん"],["は"],["青銅","せいどう"],["と"],["なり"],["、"],["あなた"],["の"],["下","した"],["の"],["地","ち"],["は"],["鉄","てつ"],["と"],["なるで"],["あろう"],["。"]]},{"verse":24,"text":"主,しゅはあなたの地,ちの雨,あめを、ちりと、ほこりに変,かわらせ、それが天,てんからあなたの上,うえにくだって、ついにあなたを滅,ほろぼすであろう。","tok":[["主","しゅ"],["は"],["あなた"],["の"],["地","ち"],["の"],["雨","あめ"],["を"],["、"],["ちり"],["と"],["、"],["ほこり"],["に"],["変わらせ","かわらせ"],["、"],["それ"],["が"],["天","てん"],["から"],["あなた"],["の"],["上","うえ"],["に"],["くだって"],["、"],["ついに"],["あなた"],["を"],["滅ぼすで","ほろぼすで"],["あろう"],["。"]]},{"verse":25,"text":"主,しゅはあなたを敵,てきの前,まえで敗,やぶれさせられるであろう。あなたは一つの道,みちから彼,かれらを攻,せめて行,いくが、彼,かれらの前,まえで七つの道,みちから逃,にげ去,さるであろう。そしてあなたは地,ちのもろもろの国,くにに恐,おそるべき見,みせしめとなるであろう。","tok":[["主","しゅ"],["は"],["あなた"],["を"],["敵","てき"],["の"],["前","まえ"],["で"],["敗れさせられるで","やぶれさせられるで"],["あろう"],["。"],["あなた"],["は"],["一","ひと"],["つ"],["の"],["道","みち"],["から"],["彼","かれ"],["ら"],["を"],["攻めて","せめて"],["行く","いく"],["が"],["、"],["彼","かれ"],["ら"],["の"],["前","まえ"],["で"],["七","なな"],["つ"],["の"],["道","みち"],["から"],["逃","にげ"],["去るで","さるで"],["あろう"],["。"],["そして"],["あなた"],["は"],["地","ち"],["の"],["もろもろ"],["の"],["国","くに"],["に"],["恐るべき","おそるべき"],["見せしめ","みせしめ"],["と"],["なるで"],["あろう"],["。"]]},{"verse":26,"text":"またあなたの死体,したいは空,そらのもろもろの鳥,とりと、地,ちの獣,けものとのえじきとなり、しかもそれを追,おい払,はらう者,ものはないであろう。","tok":[["また"],["あなた"],["の"],["死体","したい"],["は"],["空","そら"],["の"],["もろもろ"],["の"],["鳥","とり"],["と"],["、"],["地","ち"],["の"],["獣","けもの"],["と"],["の"],["えじき"],["と"],["なり"],["、"],["しかも"],["それ"],["を"],["追い払う","おいはらう"],["者","もの"],["は"],["ないで"],["あろう"],["。"]]},{"verse":27,"text":"主,しゅはエジプトの腫物,はれものと潰瘍,かいようと壊血病,かいけつびょうとひぜんとをもってあなたを撃,うたれ、あなたはいやされることはないであろう。","tok":[["主","しゅ"],["は"],["エジプト"],["の"],["腫物","はれもの"],["と"],["潰瘍","かいよう"],["と"],["壊血病","かいけつびょう"],["と"],["ひぜん"],["と"],["を"],["もって"],["あなた"],["を"],["撃たれ","うたれ"],["、"],["あなた"],["は"],["いやされる"],["こと"],["は"],["ないで"],["あろう"],["。"]]},{"verse":28,"text":"また主,しゅはあなたを撃,うって気,きを狂,くるわせ、目,めを見,みえなくし、心,こころを混乱,こんらんさせられるであろう。","tok":[["また"],["主","しゅ"],["は"],["あなた"],["を"],["撃って","うって"],["気","き"],["を"],["狂わせ","くるわせ"],["、"],["目","め"],["を"],["見えなく","みえなく"],["し"],["、"],["心","こころ"],["を"],["混乱","こんらん"],["させられるで"],["あろう"],["。"]]},{"verse":29,"text":"あなたは盲人,もうじんが暗,くらやみに手探,てさぐりするように、真昼,まひるにも手探,てさぐりするであろう。あなたは行,ゆく道,みちで栄,さかえることがなく、ただ常,つねにしえたげられ、かすめられるだけで、あなたを救,すくう者,ものはないであろう。","tok":[["あなた"],["は"],["盲人","もうじん"],["が"],["暗やみ","くらやみ"],["に"],["手","て"],["探ぐり","さぐり"],["する"],["よう"],["に"],["、"],["真昼","まひる"],["に"],["も"],["手","て"],["探ぐり","さぐり"],["するで"],["あろう"],["。"],["あなた"],["は"],["行く","ゆく"],["道","みち"],["で"],["栄","さかえ"],["る"],["こと"],["が"],["なく"],["、"],["ただ"],["常","つね"],["に"],["し"],["えたげられ"],["、"],["かすめられる"],["だけ"],["で"],["、"],["あなた"],["を"],["救う","すくう"],["者","もの"],["は"],["ないで"],["あろう"],["。"]]},{"verse":30,"text":"あなたは妻,つまをめとっても、ほかの人,ひとが彼女,かのじょと寝,ねるであろう。家,いえを建,たてても、その中,なかに住,すまないであろう。ぶどう畑,はたけを作,つくっても、その実,みを摘,つみ取,とることがないであろう。","tok":[["あなた"],["は"],["妻","つま"],["を"],["めとって"],["も"],["、"],["ほか"],["の"],["人","ひと"],["が"],["彼女","かのじょ"],["と"],["寝るで","ねるで"],["あろう"],["。"],["家","いえ"],["を"],["建てて","たてて"],["も"],["、"],["その"],["中","なか"],["に"],["住まないで","すまないで"],["あろう"],["。"],["ぶどう"],["畑","はたけ"],["を"],["作って","つくって"],["も"],["、"],["その"],["実","み"],["を"],["摘み取る","つみとる"],["こと"],["が"],["ないで"],["あろう"],["。"]]},{"verse":31,"text":"あなたの牛,うしが目,めの前,まえでほふられても、あなたはそれを食,たべることができず、あなたのろばが目,めの前,まえで奪,うばわれても、返,かえされないであろう。あなたの羊,ひつじが敵,てきのものになっても、それを救,すくってあなたに返,かえす者,ものはないであろう。","tok":[["あなた"],["の"],["牛","うし"],["が"],["目","め"],["の"],["前","まえ"],["で"],["ほふられて"],["も"],["、"],["あなた"],["は"],["それ"],["を"],["食べる","たべる"],["こと"],["が"],["できず"],["、"],["あなた"],["の"],["ろば"],["が"],["目","め"],["の"],["前","まえ"],["で"],["奪われて","うばわれて"],["も"],["、"],["返えされないで","かえされないで"],["あろう"],["。"],["あなた"],["の"],["羊","ひつじ"],["が"],["敵","てき"],["の"],["もの"],["に"],["なって"],["も"],["、"],["それ"],["を"],["救って","すくって"],["あなた"],["に"],["返えす","かえす"],["者","もの"],["は"],["ないで"],["あろう"],["。"]]},{"verse":32,"text":"あなたのむすこや娘,むすめは他国民,たこくみんにわたされる。あなたの目,めはそれを見,み、終日,しゅうじつ、彼,かれらを慕,したって衰,おとろえるが、あなたは手,てを施,ほどこすすべもないであろう。","tok":[["あなた"],["の"],["むすこ"],["や"],["娘","むすめ"],["は"],["他国民","たこくみん"],["に"],["わたされる"],["。"],["あなた"],["の"],["目","め"],["は"],["それ"],["を"],["見","み"],["、"],["終日","しゅうじつ"],["、"],["彼","かれ"],["ら"],["を"],["慕って","したって"],["衰える","おとろえる"],["が"],["、"],["あなた"],["は"],["手","て"],["を"],["施す","ほどこす"],["すべ"],["も"],["ないで"],["あろう"],["。"]]},{"verse":33,"text":"あなたの地,ちの産物,さんぶつおよびあなたの労,ろうして獲,えた物,ものはみなあなたの知,しらない民,たみが食,たべるであろう。あなたは、ただ常,つねにしえたげられ、苦,くるしめられるのみであろう。","tok":[["あなた"],["の"],["地","ち"],["の"],["産物","さんぶつ"],["および"],["あなた"],["の"],["労して","ろうして"],["獲た","えた"],["物","もの"],["は"],["みな"],["あなた"],["の"],["知らない","しらない"],["民","たみ"],["が"],["食べるで","たべるで"],["あろう"],["。"],["あなた"],["は"],["、"],["ただ"],["常","つね"],["に"],["し"],["えたげられ"],["、"],["苦しめられる","くるしめられる"],["のみ"],["で"],["あろう"],["。"]]},{"verse":34,"text":"こうしてあなたは目,めに見,みる事柄,ことがらによって、気,きが狂,くるうにいたるであろう。","tok":[["こう"],["して"],["あなた"],["は"],["目","め"],["に"],["見る","みる"],["事柄","ことがら"],["によって"],["、"],["気","き"],["が"],["狂う","くるう"],["に"],["いたるで"],["あろう"],["。"]]},{"verse":35,"text":"主,しゅはあなたのひざと、はぎとに悪,わるい、いやし得,えない腫物,はれものを生,しょうじさせて、足,あしの裏,うらから頭,あたまの頂,いただきにまで及,およぼされるであろう。","tok":[["主","しゅ"],["は"],["あなた"],["の"],["ひざ"],["と"],["、"],["はぎ"],["と"],["に"],["悪い","わるい"],["、"],["いやし"],["得ない","えない"],["腫物","はれもの"],["を"],["生じさせて","しょうじさせて"],["、"],["足","あし"],["の"],["裏","うら"],["から"],["頭","あたま"],["の"],["頂","いただき"],["に"],["まで"],["及ぼされるで","およぼされるで"],["あろう"],["。"]]},{"verse":36,"text":"主,しゅはあなたとあなたが立,たてた王,おうとを携,たずさえて、あなたもあなたの先祖,せんぞも知,しらない国,くにに移,うつされるであろう。あなたはそこで木,きや石,いしで造,つくったほかの神々,かみがみに仕,つかえるであろう。","tok":[["主","しゅ"],["は"],["あなた"],["と"],["あなた"],["が"],["立てた","たてた"],["王","おう"],["と"],["を"],["携えて","たずさえて"],["、"],["あなた"],["も"],["あなた"],["の"],["先祖","せんぞ"],["も"],["知らない","しらない"],["国","くに"],["に"],["移されるで","うつされるで"],["あろう"],["。"],["あなた"],["は"],["そこ"],["で"],["木","き"],["や"],["石","いし"],["で"],["造った","つくった"],["ほか"],["の"],["神々","かみがみ"],["に"],["仕えるで","つかえるで"],["あろう"],["。"]]},{"verse":37,"text":"あなたは主,しゅがあなたを追,おいやられるもろもろの民,たみのなかで驚,おどろきとなり、ことわざとなり、笑,わらい草,ぐさとなるであろう。","tok":[["あなた"],["は"],["主","しゅ"],["が"],["あなた"],["を"],["追いやられる","おいやられる"],["もろもろ"],["の"],["民","たみ"],["の"],["なか"],["で"],["驚","おどろき"],["と"],["なり"],["、"],["ことわざ"],["と"],["なり"],["、"],["笑草","わらいぐさ"],["と"],["なるで"],["あろう"],["。"]]},{"verse":38,"text":"あなたが多,おおくの種,たねを畑,はたけに携,たずさえて出,でても、その収穫,しゅうかくは少,すくないであろう。いなごがそれを食,くいつくすからである。","tok":[["あなた"],["が"],["多く","おおく"],["の"],["種","たね"],["を"],["畑","はたけ"],["に"],["携えて","たずさえて"],["出て","でて"],["も"],["、"],["その"],["収穫","しゅうかく"],["は"],["少いで","すくないで"],["あろう"],["。"],["いなご"],["が"],["それ"],["を"],["食い","くい"],["つくす"],["から"],["で"],["ある"],["。"]]},{"verse":39,"text":"あなたがぶどう畑,はたけを作,つくり、それにつちかっても、そのぶどう酒,しゅを飲,のむことができず、その実,みを集,あつめることもないであろう。虫,むしがそれを食,たべるからである。","tok":[["あなた"],["が"],["ぶどう"],["畑","はたけ"],["を"],["作り","つくり"],["、"],["それ"],["に"],["つちかって"],["も"],["、"],["その"],["ぶどう酒","ぶどうしゅ"],["を"],["飲む","のむ"],["こと"],["が"],["できず"],["、"],["その"],["実","み"],["を"],["集める","あつめる"],["こと"],["も"],["ないで"],["あろう"],["。"],["虫","むし"],["が"],["それ"],["を"],["食べる","たべる"],["から"],["で"],["ある"],["。"]]},{"verse":40,"text":"あなたの国,くににはあまねくオリブの木,きがあるであろう。しかし、あなたはその油,あぶらを身,みに塗,ぬることができないであろう。その実,みがみな落,おちてしまうからである。","tok":[["あなた"],["の"],["国","くに"],["に"],["は"],["あまねく"],["オリブ"],["の"],["木","き"],["が"],["あるで"],["あろう"],["。"],["しかし"],["、"],["あなた"],["は"],["その"],["油","あぶら"],["を"],["身","み"],["に"],["塗る","ぬる"],["こと"],["が"],["できないで"],["あろう"],["。"],["その"],["実","み"],["が"],["みな"],["落","おち"],["て"],["しまう"],["から"],["で"],["ある"],["。"]]},{"verse":41,"text":"むすこや、娘,むすめがあなたに生,うまれても、あなたのものにならないであろう。彼,かれらは捕,とらえられて行,いくからである。","tok":[["むすこ"],["や"],["、"],["娘","むすめ"],["が"],["あなた"],["に"],["生まれて","うまれて"],["も"],["、"],["あなた"],["の"],["もの"],["に"],["ならないで"],["あろう"],["。"],["彼","かれ"],["ら"],["は"],["捕らえられて","とらえられて"],["行く","いく"],["から"],["で"],["ある"],["。"]]},{"verse":42,"text":"あなたのもろもろの木,き、および地,ちの産物,さんぶつは、いなごが取,とって食,たべるであろう。","tok":[["あなた"],["の"],["もろもろ"],["の"],["木","き"],["、"],["および"],["地","ち"],["の"],["産物","さんぶつ"],["は"],["、"],["いなご"],["が"],["取って","とって"],["食べるで","たべるで"],["あろう"],["。"]]},{"verse":43,"text":"あなたのうちに寄留,きりゅうする他国,たこく人,じんは、ますます高,たかくなり、あなたの上,うえに出,でて、あなたはますます低,ひくくなるであろう。","tok":[["あなた"],["の"],["うち"],["に"],["寄留","きりゅう"],["する"],["他国人","たこくじん"],["は"],["、"],["ますます"],["高く","たかく"],["なり"],["、"],["あなた"],["の"],["上","うえ"],["に"],["出て","でて"],["、"],["あなた"],["は"],["ますます"],["低く","ひくく"],["なるで"],["あろう"],["。"]]},{"verse":44,"text":"彼,かれはあなたに貸,かし、あなたは彼,かれに貸,かすことができない。彼,かれはかしらとなり、あなたは尾,おとなるであろう。","tok":[["彼","かれ"],["は"],["あなた"],["に"],["貸","かし"],["、"],["あなた"],["は"],["彼","かれ"],["に"],["貸す","かす"],["こと"],["が"],["できない"],["。"],["彼","かれ"],["は"],["かしら"],["と"],["なり"],["、"],["あなた"],["は"],["尾","お"],["と"],["なるで"],["あろう"],["。"]]},{"verse":45,"text":"このもろもろののろいが、あなたに臨,のぞみ、あなたを追,おい、ついに追,おいついて、あなたを滅,ほろぼすであろう。これはあなたの神,かみ、主,しゅの声,こえに聞,きき従,したがわず、あなたに命,めいじられた戒,いましめと定,さだめとを、あなたが守,まもらなかったからである。","tok":[["この"],["もろもろ"],["の"],["のろい"],["が"],["、"],["あなた"],["に"],["臨み","のぞみ"],["、"],["あなた"],["を"],["追い","おい"],["、"],["ついに"],["追いついて","おいついて"],["、"],["あなた"],["を"],["滅ぼすで","ほろぼすで"],["あろう"],["。"],["これ"],["は"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["声","こえ"],["に"],["聞","きき"],["従わず","したがわず"],["、"],["あなた"],["に"],["命じられた","めいじられた"],["戒しめ","いましめ"],["と"],["定め","さだめ"],["と"],["を"],["、"],["あなた"],["が"],["守らなかった","まもらなかった"],["から"],["で"],["ある"],["。"]]},{"verse":46,"text":"これらの事,ことは長,ながくあなたとあなたの子孫,しそんのうえにあって、しるしとなり、また不思議,ふしぎとなるであろう。","tok":[["これ"],["ら"],["の"],["事","こと"],["は"],["長く","ながく"],["あなた"],["と"],["あなた"],["の"],["子孫","しそん"],["の"],["うえ"],["に"],["あって"],["、"],["しるし"],["と"],["なり"],["、"],["また"],["不思議","ふしぎ"],["と"],["なるで"],["あろう"],["。"]]},{"verse":47,"text":"あなたがすべての物,ものに豊,ゆたかになり、あなたの神,かみ、主,しゅに心,こころから喜,よろこび楽,たのしんで仕,つかえないので、","tok":[["あなた"],["が"],["すべて"],["の"],["物","もの"],["に"],["豊","ゆたか"],["に"],["なり"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主に","しゅに"],["心","こころ"],["から"],["喜こび","よろこび"],["楽しんで","たのしんで"],["仕えない","つかえない"],["ので"],["、"]]},{"verse":48,"text":"あなたは飢,うえ、かわき、裸,はだかになり、すべての物,ものに乏,とぼしくなって、主,しゅがあなたにつかわされる敵,てきに仕,つかえるであろう。敵,てきは鉄,てつのくびきをあなたのくびにかけ、ついにあなたを滅,ほろぼすであろう。","tok":[["あなた"],["は"],["飢","うえ"],["、"],["かわき"],["、"],["裸","はだか"],["に"],["なり"],["、"],["すべて"],["の"],["物","もの"],["に"],["乏く","とぼしく"],["なって"],["、"],["主","しゅ"],["が"],["あなた"],["に"],["つかわされる"],["敵","てき"],["に"],["仕えるで","つかえるで"],["あろう"],["。"],["敵","てき"],["は"],["鉄","てつ"],["の"],["くびき"],["を"],["あなた"],["の"],["くび"],["に"],["かけ"],["、"],["ついに"],["あなた"],["を"],["滅ぼすで","ほろぼすで"],["あろう"],["。"]]},{"verse":49,"text":"すなわち主,しゅは遠,とおい所,ところから、地,ちのはてから一つの民,たみを、はげたかが飛,とびかけるように、あなたに攻,せめきたらせられるであろう。これはあなたがその言葉,ことばを知,しらない民,たみ、","tok":[["すなわち"],["主","しゅ"],["は"],["遠い","とおい"],["所","ところ"],["から"],["、"],["地","ち"],["の"],["はて"],["から"],["一","ひと"],["つ"],["の"],["民","たみ"],["を"],["、"],["はげたか"],["が"],["飛び","とび"],["かける"],["よう"],["に"],["、"],["あなた"],["に"],["攻め","せめ"],["きたら"],["せられるで"],["あろう"],["。"],["これ"],["は"],["あなた"],["が"],["その"],["言葉","ことば"],["を"],["知らない","しらない"],["民","たみ"],["、"]]},{"verse":50,"text":"顔,かおの恐,おそろしい民,たみであって、彼,かれらは老人,ろうじんの身,みを顧,かえりみず、幼,おさない者,ものをあわれまず、","tok":[["顔","かお"],["の"],["恐ろしい","おそろしい"],["民","たみ"],["で"],["あって"],["、"],["彼","かれ"],["ら"],["は"],["老人","ろうじん"],["の"],["身","み"],["を"],["顧ず","かえりみず"],["、"],["幼ない","おさない"],["者","もの"],["を"],["あわれまず"],["、"]]},{"verse":51,"text":"あなたの家畜,かちくが産,うむものや、地,ちの産物,さんぶつを食,くって、あなたを滅,ほろぼし、穀物,こくもつをも、酒,さけをも、油,あぶらをも、牛,うしの子,こをも、羊,ひつじの子,こをも、あなたの所,ところに残,のこさず、ついにあなたを全,まったく滅,ほろぼすであろう。","tok":[["あなた"],["の"],["家畜","かちく"],["が"],["産む","うむ"],["もの"],["や"],["、"],["地","ち"],["の"],["産物","さんぶつ"],["を"],["食って","くって"],["、"],["あなた"],["を"],["滅ぼし","ほろぼし"],["、"],["穀物","こくもつ"],["を"],["も"],["、"],["酒","さけ"],["を"],["も"],["、"],["油","あぶら"],["を"],["も"],["、"],["牛","うし"],["の"],["子","こ"],["を"],["も"],["、"],["羊","ひつじ"],["の"],["子","こ"],["を"],["も"],["、"],["あなた"],["の"],["所","ところ"],["に"],["残さず","のこさず"],["、"],["ついに"],["あなた"],["を"],["全く","まったく"],["滅ぼすで","ほろぼすで"],["あろう"],["。"]]},{"verse":52,"text":"その民,たみは全国,ぜんこくですべての町,まちを攻,せめ囲,かこみ、ついにあなたが頼,たのみとする、堅固,けんごな高,たかい石,いしがきをことごとく撃,うちくずし、あなたの神,かみ、主,しゅが賜,たまわった国,くにのうちのすべての町々,まちまちを攻,せめ囲,かこむであろう。","tok":[["その"],["民","たみ"],["は"],["全国","ぜんこく"],["で"],["すべて"],["の"],["町","まち"],["を"],["攻め囲み","せめかこみ"],["、"],["ついに"],["あなた"],["が"],["頼み","たのみ"],["と"],["する"],["、"],["堅固","けんご"],["な"],["高い","たかい"],["石がき","いしがき"],["を"],["ことごとく"],["撃ち","うち"],["くずし"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["賜わった","たまわった"],["国","くに"],["の"],["うち"],["の"],["すべて"],["の"],["町々","まちまち"],["を"],["攻め囲むで","せめかこむで"],["あろう"],["。"]]},{"verse":53,"text":"あなたは敵,てきに囲,かこまれ、激,はげしく攻,せめなやまされて、ついにあなたの神,かみ、主,しゅが賜,たまわったあなたの身,みから生,うまれた者,もの、むすこ、娘,むすめの肉,にくを食,たべるに至,いたるであろう。","tok":[["あなた"],["は"],["敵","てき"],["に"],["囲まれ","かこまれ"],["、"],["激しく","はげしく"],["攻め","せめ"],["なやまされて"],["、"],["ついに"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["賜わった","たまわった"],["あなた"],["の"],["身","み"],["から"],["生まれた","うまれた"],["者","もの"],["、"],["むすこ"],["、"],["娘","むすめ"],["の"],["肉","にく"],["を"],["食べる","たべる"],["に"],["至るで","いたるで"],["あろう"],["。"]]},{"verse":54,"text":"あなたがたのうちのやさしい、温和,おんわな男,おとこでさえも、自分,じぶんの兄弟,きょうだい、自分,じぶんのふところの妻,つま、最後,さいごに残,のこっている子供,こどもにも食物,しょくもつを惜,おしんで与,あたえず、","tok":[["あなた"],["がた"],["の"],["うち"],["の"],["やさしい"],["、"],["温和","おんわ"],["な"],["男","おとこ"],["で"],["さえ"],["も"],["、"],["自分","じぶん"],["の"],["兄弟","きょうだい"],["、"],["自分","じぶん"],["の"],["ふところ"],["の"],["妻","つま"],["、"],["最後","さいご"],["に"],["残って","のこって"],["いる"],["子供","こども"],["に"],["も"],["食物","しょくもつ"],["を"],["惜しんで","おしんで"],["与えず","あたえず"],["、"]]},{"verse":55,"text":"自分,じぶんが自分,じぶんの子供,こどもを食,たべ、その肉,にくを少,すこしでも、この人々,ひとびとのだれにも与,あたえようとはしないであろう。これは敵,てきがあなたのすべての町々,まちまちを囲,かこみ、激,はげしく攻,せめ悩,なやまして、何,なにをもその人,ひとに残,のこさないからである。","tok":[["自分","じぶん"],["が"],["自分","じぶん"],["の"],["子供","こども"],["を"],["食べ","たべ"],["、"],["その"],["肉","にく"],["を"],["少し","すこし"],["で"],["も"],["、"],["この"],["人々","ひとびと"],["の"],["だれ"],["に"],["も"],["与","あたえ"],["よう"],["と"],["は"],["しないで"],["あろう"],["。"],["これ"],["は"],["敵","てき"],["が"],["あなた"],["の"],["すべて"],["の"],["町々","まちまち"],["を"],["囲み","かこみ"],["、"],["激しく","はげしく"],["攻め","せめ"],["悩して","なやまして"],["、"],["何に","なに"],["を"],["も"],["その"],["人","ひと"],["に"],["残さない","のこさない"],["から"],["で"],["ある"],["。"]]},{"verse":56,"text":"またあなたがたのうちのやさしい、柔和,にゅうわな女,おんな、すなわち柔和,にゅうわで、やさしく、足,あしの裏,うらを土,つちに付,つけようともしない者,ものでも、自分,じぶんのふところの夫,おっとや、むすこ、娘,むすめにもかくして、","tok":[["また"],["あなた"],["がた"],["の"],["うち"],["の"],["やさしい"],["、"],["柔和","にゅうわ"],["な"],["女","おんな"],["、"],["すなわち"],["柔和","にゅうわ"],["で"],["、"],["やさしく"],["、"],["足","あし"],["の"],["裏","うら"],["を"],["土","つち"],["に"],["付よう","つけよう"],["と"],["も"],["しない"],["者","もの"],["で"],["も"],["、"],["自分","じぶん"],["の"],["ふところ"],["の"],["夫","おっと"],["や"],["、"],["むすこ"],["、"],["娘","むすめ"],["に"],["も"],["かくして"],["、"]]},{"verse":57,"text":"自分,じぶんの足,あしの間,あいだからでる後産,ごさんや、自分,じぶんの産,うむ子,こをひそかに食,たべるであろう。敵,てきがあなたの町々,まちまちを囲,かこみ、激,はげしく攻,せめなやまして、すべての物,ものが欠乏,けつぼうするからである。","tok":[["自分","じぶん"],["の"],["足","あし"],["の"],["間","あいだ"],["から"],["でる"],["後産","ご"],["さん"],["や"],["、"],["自分","じぶん"],["の"],["産む","うむ"],["子","こ"],["を"],["ひそか"],["に"],["食べるで","たべるで"],["あろう"],["。"],["敵","てき"],["が"],["あなた"],["の"],["町々","まちまち"],["を"],["囲み","かこみ"],["、"],["激しく","はげしく"],["攻め","せめ"],["なやまして"],["、"],["すべて"],["の"],["物","もの"],["が"],["欠乏","けつぼう"],["する"],["から"],["で"],["ある"],["。"]]},{"verse":58,"text":"もしあなたが、この書物,しょもつにしるされているこの律法,りっぽうのすべての言葉,ことばを守,まもり行,おこなわず、あなたの神,かみ、主,しゅというこの栄,さかえある恐,おそるべき名,なを恐,おそれないならば、","tok":[["もし"],["あなた"],["が"],["、"],["この"],["書物","しょもつ"],["に"],["しるされて"],["いる"],["この"],["律法","りっぽう"],["の"],["すべて"],["の"],["言葉","ことば"],["を"],["守り","まもり"],["行なわず","おこなわず"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["と"],["いう"],["この"],["栄","さかえ"],["ある"],["恐るべき","おそるべき"],["名","な"],["を"],["恐れないならば","おそれないならば"],["、"]]},{"verse":59,"text":"主,しゅはあなたとその子孫,しそんの上,うえに激,はげしい災,わざわいを下,くだされるであろう。その災,わざわいはきびしく、かつ久,ひさしく、その病気,びょうきは重,おもく、かつ久,ひさしいであろう。","tok":[["主","しゅ"],["は"],["あなた"],["と"],["その"],["子孫","しそん"],["の"],["上","うえ"],["に"],["激しい","はげしい"],["災","わざわい"],["を"],["下されるで","くだされるで"],["あろう"],["。"],["その"],["災","わざわい"],["は"],["きびしく"],["、"],["かつ"],["久く","ひさしく"],["、"],["その"],["病気","びょうき"],["は"],["重く","おもく"],["、"],["かつ"],["久いで","ひさしいで"],["あろう"],["。"]]},{"verse":60,"text":"主,しゅはまた、あなたが恐,おそれた病気,びょうき、すなわちエジプトのもろもろの病気,びょうきを再,ふたたび臨,のぞませて、あなたの身,みにつかせられるであろう。","tok":[["主","しゅ"],["は"],["また"],["、"],["あなた"],["が"],["恐れた","おそれた"],["病気","びょうき"],["、"],["すなわち"],["エジプト"],["の"],["もろもろ"],["の"],["病気","びょうき"],["を"],["再び","ふたたび"],["臨ませて","のぞませて"],["、"],["あなた"],["の"],["身","み"],["に"],["つかせられるで"],["あろう"],["。"]]},{"verse":61,"text":"またこの律法,りっぽうの書,しょにのせてないもろもろの病気,びょうきと、もろもろの災,わざわいとを、主,しゅはあなたが滅,ほろびるまで、あなたの上,うえに下,くだされるであろう。","tok":[["また"],["この"],["律法","りっぽう"],["の"],["書","しょ"],["に"],["のせてない"],["もろもろ"],["の"],["病気","びょうき"],["と"],["、"],["もろもろ"],["の"],["災","わざわい"],["と"],["を"],["、"],["主","しゅ"],["は"],["あなた"],["が"],["滅びる","ほろびる"],["まで"],["、"],["あなた"],["の"],["上","うえ"],["に"],["下されるで","くだされるで"],["あろう"],["。"]]},{"verse":62,"text":"あなたがたは天,てんの星,ほしのように多,おおかったが、あなたの神,かみ、主,しゅの声,こえに聞,きき従,したがわなかったから、残,のこる者,ものが少,すくなくなるであろう。","tok":[["あなた"],["がた"],["は"],["天","てん"],["の"],["星","ほし"],["の"],["よう"],["に"],["多かった","おおかった"],["が"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["声","こえ"],["に"],["聞","きき"],["従わなかった","したがわなかった"],["から"],["、"],["残る","のこる"],["者","もの"],["が"],["少く","すくなく"],["なるで"],["あろう"],["。"]]},{"verse":63,"text":"さきに主,しゅがあなたがたを良,よくあしらい、あなたがたを多,おおくするのを喜,よろこばれたように、主,しゅは今,いまあなたがたを滅,ほろぼし絶,たやすのを喜,よろこばれるであろう。あなたがたは、はいって取,とる地,ちから抜,ぬき去,さられるであろう。","tok":[["さき"],["に"],["主","しゅ"],["が"],["あなた"],["がた"],["を"],["良く","よく"],["あしらい"],["、"],["あなた"],["がた"],["を"],["多く","おおく"],["する"],["の"],["を"],["喜こばれた","よろこばれた"],["よう"],["に"],["、"],["主","しゅ"],["は"],["今","いま"],["あなた"],["がた"],["を"],["滅ぼし","ほろぼし"],["絶やす","たやす"],["の"],["を"],["喜こばれるで","よろこばれるで"],["あろう"],["。"],["あなた"],["がた"],["は"],["、"],["はい"],["って"],["取る","とる"],["地","ち"],["から"],["抜き去られるで","ぬきさられるで"],["あろう"],["。"]]},{"verse":64,"text":"主,しゅは地,ちのこのはてから、かのはてまでのもろもろの民,たみのうちにあなたがたを散,ちらされるであろう。その所,ところで、あなたもあなたの先祖,せんぞたちも知,しらなかった木,きや石,いしで造,つくったほかの神々,かみがみにあなたは仕,つかえるであろう。","tok":[["主","しゅ"],["は"],["地","ち"],["の"],["この"],["はて"],["から"],["、"],["かの"],["はて"],["まで"],["の"],["もろもろ"],["の"],["民","たみ"],["の"],["うち"],["に"],["あなた"],["がた"],["を"],["散らされるで","ちらされるで"],["あろう"],["。"],["その"],["所","ところ"],["で"],["、"],["あなた"],["も"],["あなた"],["の"],["先祖","せんぞ"],["たち"],["も"],["知らなかった","しらなかった"],["木","き"],["や"],["石","いし"],["で"],["造った","つくった"],["ほか"],["の"],["神々","かみがみ"],["に"],["あなた"],["は"],["仕えるで","つかえるで"],["あろう"],["。"]]},{"verse":65,"text":"その国々,くにぐにの民,たみのうちであなたは安,やすきを得,えず、また足,あしの裏,うらを休,やすめる所,ところも得,えられないであろう。主,しゅはその所,ところで、あなたの心,こころをおののかせ、目,めを衰,おとろえさせ、精神,せいしんを打,うちしおれさせられるであろう。","tok":[["その"],["国々","くにぐに"],["の"],["民","たみ"],["の"],["うち"],["で"],["あなた"],["は"],["安き","やすき"],["を"],["得ず","えず"],["、"],["また"],["足","あし"],["の"],["裏","うら"],["を"],["休める","やすめる"],["所","ところ"],["も"],["得られないで","えられないで"],["あろう"],["。"],["主","しゅ"],["は"],["その"],["所","ところ"],["で"],["、"],["あなた"],["の"],["心","こころ"],["を"],["おののかせ"],["、"],["目","め"],["を"],["衰えさせ","おとろえさせ"],["、"],["精神","せいしん"],["を"],["打ちしおれさせられるで","うちしおれさせられるで"],["あろう"],["。"]]},{"verse":66,"text":"あなたの命,いのちは細,ほそい糸,いとにかかっているようになり、夜昼,よるひる恐,おそれおののいて、その命,いのちもおぼつかなく思,おもうであろう。","tok":[["あなた"],["の"],["命","いのち"],["は"],["細い","ほそい"],["糸","いと"],["に"],["かかって"],["いる"],["よう"],["に"],["なり"],["、"],["夜","よる"],["昼","ひる"],["恐れおののいて","おそれおののいて"],["、"],["その"],["命","いのち"],["も"],["おぼつかなく"],["思で","おもうで"],["あろう"],["。"]]},{"verse":67,"text":"あなたが心,こころにいだく恐,おそれと、目,めに見,みるものによって、朝,あさには『ああ夕,ゆうであればよいのに』と言,いい、夕,ゆうには『ああ朝,あさであればよいのに』と言,いうであろう。","tok":[["あなた"],["が"],["心","こころ"],["に"],["いだく"],["恐","おそれ"],["と"],["、"],["目","め"],["に"],["見る","みる"],["もの"],["によって"],["、"],["朝","あさ"],["に"],["は"],["『"],["ああ"],["夕","ゆう"],["で"],["あれば"],["よい"],["のに"],["』"],["と"],["言い","いい"],["、"],["夕","ゆう"],["に"],["は"],["『"],["ああ"],["朝","あさ"],["で"],["あれば"],["よい"],["のに"],["』"],["と"],["言うで","いうで"],["あろう"],["。"]]},{"verse":68,"text":"主,しゅはあなたを舟,ふねに乗,のせ、かつてわたしがあなたに告,つげて、『あなたは再,ふたたびこれを見,みることはない』と言,いった道,みちによって、あなたをエジプトへ連,つれもどされるであろう。あなたがたはそこで男女,だんじょの奴隷,どれいとして敵,てきに売,うられるが、だれも買,かう者,ものはないであろう」。","tok":[["主","しゅ"],["は"],["あなた"],["を"],["舟","ふね"],["に"],["乗せ","のせ"],["、"],["かつて"],["わたし"],["が"],["あなた"],["に"],["告","つげ"],["て"],["、"],["『"],["あなた"],["は"],["再び","ふたたび"],["これ"],["を"],["見る","みる"],["こと"],["は"],["ない"],["』"],["と"],["言った","いった"],["道","みち"],["によって"],["、"],["あなた"],["を"],["エジプト"],["へ"],["連れもどされるで","つれもどされるで"],["あろう"],["。"],["あなた"],["がた"],["は"],["そこ"],["で"],["男女","だんじょ"],["の"],["奴隷","どれい"],["として"],["敵","てき"],["に"],["売られる","うられる"],["が"],["、"],["だれ"],["も"],["買う","かう"],["者","もの"],["は"],["ないで"],["あろう"],["」"],["。"]]},{"verse":69,"text":"[29:1]これは主,しゅがモーセに命,めいじて、モアブの地,ちでイスラエルの人々,ひとびとと結,むすばせられた契約,けいやくの言葉,ことばであって、ホレブで彼,かれらと結,むすばれた契約,けいやくのほかのものである。","tok":[["["],["29"],[":"],["1"],["]"],["これ"],["は"],["主","しゅ"],["が"],["モーセ"],["に"],["命じて","めいじて"],["、"],["モアブ"],["の"],["地","ち"],["で"],["イスラエル"],["の"],["人々","ひとびと"],["と"],["結ばせられた","むすばせられた"],["契約","けいやく"],["の"],["言葉","ことば"],["で"],["あって"],["、"],["ホレブ"],["で"],["彼","かれ"],["ら"],["と"],["結ばれた","むすばれた"],["契約","けいやく"],["の"],["ほか"],["の"],["もの"],["で"],["ある"],["。"]]}]
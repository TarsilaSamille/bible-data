[{"verse":1,"text":"あなたは七年,ねんの終,おわりごとに、ゆるしを行,おこなわなければならない。","tok":[["あなた"],["は"],["七","なな"],["年","ねん"],["の"],["終","おわり"],["ごと"],["に"],["、"],["ゆるし"],["を"],["行なわなければ","おこなわなければ"],["ならない"],["。"]]},{"verse":2,"text":"そのゆるしのしかたは次,つぎのとおりである。すべてその隣人,りんじんに貸,かした貸主,かしぬしはそれをゆるさなければならない。その隣人,りんじんまたは兄弟,きょうだいにそれを督促,とくそくしてはならない。主,しゅのゆるしが、ふれ示,しめされたからである。","tok":[["その"],["ゆるし"],["の"],["しかた"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["すべて"],["その"],["隣人","りんじん"],["に"],["貸","かし"],["た"],["貸主","かしぬし"],["は"],["それ"],["を"],["ゆるさなければ"],["ならない"],["。"],["その"],["隣人","りんじん"],["また"],["は"],["兄弟","きょうだい"],["に"],["それ"],["を"],["督促","とくそく"],["して"],["は"],["ならない"],["。"],["主","しゅ"],["の"],["ゆるし"],["が"],["、"],["ふれ"],["示めされた","しめされた"],["から"],["で"],["ある"],["。"]]},{"verse":3,"text":"外国,がいこく人,じんにはそれを督促,とくそくすることができるが、あなたの兄弟,きょうだいに貸,かした物,ものはゆるさなければならない。","tok":[["外国人","がいこくじん"],["に"],["は"],["それ"],["を"],["督促","とくそく"],["する"],["こと"],["が"],["できる"],["が"],["、"],["あなた"],["の"],["兄弟","きょうだい"],["に"],["貸","かし"],["た"],["物","もの"],["は"],["ゆるさなければ"],["ならない"],["。"]]},{"verse":4,"text":"しかしあなたがたのうちに貧,まずしい者,ものはなくなるであろう。（あなたの神,かみ、主,しゅが嗣,し業,ぎょうとして与,あたえられる地,ちで、あなたを祝福,しゅくふくされるからである。）","tok":[["しかし"],["あなた"],["がた"],["の"],["うち"],["に"],["貧しい","まずしい"],["者","もの"],["は"],["なくなるで"],["あろう"],["。"],["（"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["嗣業","しぎょう"],["として"],["与えられる","あたえられる"],["地","ち"],["で"],["、"],["あなた"],["を"],["祝福","しゅくふく"],["される"],["から"],["で"],["ある"],["。"],["）"]]},{"verse":5,"text":"ただ、あなたの神,かみ、主,しゅの言葉,ことばに聞,きき従,したがって、わたしが、きょう、あなたに命,めいじることの戒,いましめを、ことごとく守,まもり行,おこなうとき、そのようになるであろう。","tok":[["ただ"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["に"],["聞","きき"],["従って","したがって"],["、"],["わたし"],["が"],["、"],["きょう"],["、"],["あなた"],["に"],["命じる","めいじる"],["こと"],["の"],["戒しめ","いましめ"],["を"],["、"],["ことごとく"],["守り","まもり"],["行なう","おこなう"],["とき"],["、"],["その"],["よう"],["に"],["なるで"],["あろう"],["。"]]},{"verse":6,"text":"あなたの神,かみ、主,しゅが約束,やくそくされたようにあなたを祝福,しゅくふくされるから、あなたは多,おおくの国,くにびとに貸,かすようになり、借,かりることはないであろう。またあなたは多,おおくの国,くにびとを治,おさめるようになり、彼,かれらがあなたを治,おさめることはないであろう。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["約束","やくそく"],["された"],["よう"],["に"],["あなた"],["を"],["祝福","しゅくふく"],["される"],["から"],["、"],["あなた"],["は"],["多く","おおく"],["の"],["国びと","くにびと"],["に"],["貸す","かす"],["よう"],["に"],["なり"],["、"],["借りる","かりる"],["こと"],["は"],["ないで"],["あろう"],["。"],["また"],["あなた"],["は"],["多く","おおく"],["の"],["国びと","くにびと"],["を"],["治める","おさめる"],["よう"],["に"],["なり"],["、"],["彼","かれ"],["ら"],["が"],["あなた"],["を"],["治める","おさめる"],["こと"],["は"],["ないで"],["あろう"],["。"]]},{"verse":7,"text":"あなたの神,かみ、主,しゅが賜,たまわる地,ちで、もしあなたの兄弟,きょうだいで貧,まずしい者,ものがひとりでも、町,まちの内,うちにおるならば、その貧,まずしい兄弟,きょうだいにむかって、心,こころをかたくなにしてはならない。また手,てを閉,とじてはならない。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["賜わる","たまわる"],["地","ち"],["で"],["、"],["もし"],["あなた"],["の"],["兄弟","きょうだい"],["で"],["貧しい","まずしい"],["者","もの"],["が"],["ひとり"],["で"],["も"],["、"],["町","まち"],["の"],["内","うち"],["に"],["おるならば"],["、"],["その"],["貧しい","まずしい"],["兄弟","きょうだい"],["に"],["むかって"],["、"],["心","こころ"],["を"],["かたくな"],["に"],["して"],["は"],["ならない"],["。"],["また"],["手","て"],["を"],["閉じ","とじ"],["ては"],["ならない"],["。"]]},{"verse":8,"text":"必,かならず彼,かれに手,てを開,ひらいて、その必要,ひつようとする物,ものを貸,かし与,あたえ、乏,とぼしいのを補,おぎなわなければならない。","tok":[["必","かならず"],["彼","かれ"],["に"],["手","て"],["を"],["開らいて","ひらいて"],["、"],["その"],["必要","ひつよう"],["と"],["する"],["物","もの"],["を"],["貸与","かしあたえ"],["、"],["乏い","とぼしい"],["の"],["を"],["補なわなければ","おぎなわなければ"],["ならない"],["。"]]},{"verse":9,"text":"あなたは心,こころに邪念,じゃねんを起,おこし、『第,だい七年,ねんのゆるしの年,としが近,ちかづいた』と言,いって、貧,まずしい兄弟,きょうだいに対,たいし、物,ものを惜,おしんで、何,なにも与,あたえないことのないように慎,つつしまなければならない。その人,ひとがあなたを主,しゅに訴,うったえるならば、あなたは罪,つみを得,えるであろう。","tok":[["あなた"],["は"],["心","こころ"],["に"],["邪念","じゃねん"],["を"],["起こし","おこし"],["、"],["『"],["第","だい"],["七","なな"],["年","ねん"],["の"],["ゆるし"],["の"],["年","とし"],["が"],["近づいた","ちかづいた"],["』"],["と"],["言って","いって"],["、"],["貧しい","まずしい"],["兄弟","きょうだい"],["に"],["対し","たいし"],["、"],["物","もの"],["を"],["惜しんで","おしんで"],["、"],["何に","なに"],["も"],["与えない","あたえない"],["こと"],["の"],["ない"],["よう"],["に"],["慎しまなければ","つつしまなければ"],["ならない"],["。"],["その"],["人","ひと"],["が"],["あなた"],["を"],["主に","しゅに"],["訴るならば","うったえるならば"],["、"],["あなた"],["は"],["罪","つみ"],["を"],["得るで","えるで"],["あろう"],["。"]]},{"verse":10,"text":"あなたは心,こころから彼,かれに与,あたえなければならない。彼,かれに与,あたえる時,ときは惜,おしんではならない。あなたの神,かみ、主,しゅはこの事,ことのために、あなたをすべての事業,じぎょうと、手,てのすべての働,はたらきにおいて祝福,しゅくふくされるからである。","tok":[["あなた"],["は"],["心","こころ"],["から"],["彼","かれ"],["に"],["与えなければ","あたえなければ"],["ならない"],["。"],["彼","かれ"],["に"],["与える","あたえる"],["時","とき"],["は"],["惜しんで","おしんで"],["は"],["ならない"],["。"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["この"],["事","こと"],["の"],["ため"],["に"],["、"],["あなた"],["を"],["すべて"],["の"],["事業","じぎょう"],["と"],["、"],["手","て"],["の"],["すべて"],["の"],["働らき","はたらき"],["に"],["おいて"],["祝福","しゅくふく"],["される"],["から"],["で"],["ある"],["。"]]},{"verse":11,"text":"貧,まずしい者,ものはいつまでも国,くにのうちに絶,たえることがないから、わたしは命,めいじて言,いう、『あなたは必,かならず国,くにのうちにいるあなたの兄弟,きょうだいの乏,とぼしい者,ものと、貧,まずしい者,ものとに、手,てを開,ひらかなければならない』。","tok":[["貧しい","まずしい"],["者","もの"],["は"],["いつ"],["まで"],["も"],["国","くに"],["の"],["うち"],["に"],["絶える","たえる"],["こと"],["が"],["ない"],["から"],["、"],["わたし"],["は"],["命じて","めいじて"],["言う","いう"],["、"],["『"],["あなた"],["は"],["必","かならず"],["国","くに"],["の"],["うち"],["に"],["いる"],["あなた"],["の"],["兄弟","きょうだい"],["の"],["乏い","とぼしい"],["者","もの"],["と"],["、"],["貧しい","まずしい"],["者","もの"],["と"],["に"],["、"],["手","て"],["を"],["開らかなければ","ひらかなければ"],["ならない"],["』"],["。"]]},{"verse":12,"text":"もしあなたの兄弟,きょうだいであるヘブルの男,おとこ、またはヘブルの女,おんなが、あなたのところに売,うられてきて、六年,ねん仕,つかえたならば、第,だい七年,ねんには彼,かれに自由,じゆうを与,あたえて去,さらせなければならない。","tok":[["もし"],["あなた"],["の"],["兄弟","きょうだい"],["で"],["ある"],["ヘブル"],["の"],["男","おとこ"],["、"],["また"],["は"],["ヘブル"],["の"],["女","おんな"],["が"],["、"],["あなた"],["の"],["ところ"],["に"],["売られて","うられて"],["きて"],["、"],["六","ろく"],["年","ねん"],["仕えたならば","つかえたならば"],["、"],["第","だい"],["七","なな"],["年","ねん"],["に"],["は"],["彼","かれ"],["に"],["自由","じゆう"],["を"],["与","あたえ"],["て"],["去らせなければ","さらせなければ"],["ならない"],["。"]]},{"verse":13,"text":"彼,かれに自由,じゆうを与,あたえて去,さらせる時,ときは、から手,てで去,さらせてはならない。","tok":[["彼","かれ"],["に"],["自由","じゆう"],["を"],["与","あたえ"],["て"],["去らせる","さらせる"],["時","とき"],["は"],["、"],["から"],["手","て"],["で"],["去らせて","さらせて"],["は"],["ならない"],["。"]]},{"verse":14,"text":"群,むれと、打,うち場,ばと、酒,さかぶねのうちから取,とって、惜,おしみなく彼,かれに与,あたえなければならない。すなわちあなたの神,かみ、主,しゅがあなたを恵,めぐまれたように、彼,かれに与,あたえなければならない。","tok":[["群れ","むれ"],["と"],["、"],["打ち","うち"],["場","ば"],["と"],["、"],["酒","さかぶね"],["の"],["うち"],["から"],["取って","とって"],["、"],["惜みなく","おしみなく"],["彼","かれ"],["に"],["与えなければ","あたえなければ"],["ならない"],["。"],["すなわち"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["あなた"],["を"],["恵れた","めぐまれた"],["よう"],["に"],["、"],["彼","かれ"],["に"],["与えなければ","あたえなければ"],["ならない"],["。"]]},{"verse":15,"text":"あなたはかつてエジプトの国,くにで奴隷,どれいであったが、あなたの神,かみ、主,しゅがあなたをあがない出,だされた事,ことを記憶,きおくしなければならない。このゆえにわたしは、きょう、この事,ことを命,めいじる。","tok":[["あなた"],["は"],["かつて"],["エジプト"],["の"],["国","くに"],["で"],["奴隷","どれい"],["で"],["あった"],["が"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["あなた"],["を"],["あがない"],["出された","だされた"],["事","こと"],["を"],["記憶","きおく"],["しなければ"],["ならない"],["。"],["この"],["ゆえ"],["に"],["わたし"],["は"],["、"],["きょう"],["、"],["この"],["事","こと"],["を"],["命じる","めいじる"],["。"]]},{"verse":16,"text":"しかしその人,ひとがあなたと、あなたの家族,かぞくを愛,あいし、あなたと一緒,いっしょにいることを望,のぞみ、『わたしはあなたを離,はなれて去,さりたくありません』と言,いうならば、","tok":[["しかし"],["その"],["人","ひと"],["が"],["あなた"],["と"],["、"],["あなた"],["の"],["家族","かぞく"],["を"],["愛し","あいし"],["、"],["あなた"],["と"],["一緒","いっしょ"],["に"],["いる"],["こと"],["を"],["望み","のぞみ"],["、"],["『"],["わたし"],["は"],["あなた"],["を"],["離れて","はなれて"],["去りたく","さりたく"],["ありません"],["』"],["と"],["言うならば","いうならば"],["、"]]},{"verse":17,"text":"あなたは、きりを取,とって彼,かれの耳,みみを戸,とに刺,ささなければならない。そうすれば、彼,かれはいつまでもあなたの奴隷,どれいとなるであろう。女,おんな奴隷,どれいにもそうしなければならない。","tok":[["あなた"],["は"],["、"],["きり"],["を"],["取って","とって"],["彼","かれ"],["の"],["耳","みみ"],["を"],["戸","と"],["に"],["刺さなければ","ささなければ"],["ならない"],["。"],["そう"],["すれば"],["、"],["彼","かれ"],["は"],["いつ"],["まで"],["も"],["あなた"],["の"],["奴隷","どれい"],["と"],["なるで"],["あろう"],["。"],["女","おんな"],["奴隷","どれい"],["に"],["も"],["そう"],["しなければ"],["ならない"],["。"]]},{"verse":18,"text":"彼,かれに自由,じゆうを与,あたえて去,さらせる時,ときには、快,こころよく去,さらせなければならない。彼,かれが六年間,ねんかん、賃銀,ちんぎんを取,とる雇人,やといにんの二倍,ばいあなたに仕,つかえて働,はたらいたからである。あなたがそうするならば、あなたの神,かみ、主,しゅはあなたが行,おこなうすべての事,ことにあなたを祝福,しゅくふくされるであろう。","tok":[["彼","かれ"],["に"],["自由","じゆう"],["を"],["与","あたえ"],["て"],["去らせる","さらせる"],["時","とき"],["に"],["は"],["、"],["快よく","こころよく"],["去らせなければ","さらせなければ"],["ならない"],["。"],["彼","かれ"],["が"],["六","ろく"],["年間","ねんかん"],["かん"],["、"],["賃銀","ちんぎん"],["を"],["取る","とる"],["雇人","やといにん"],["の"],["二","に"],["倍","ばい"],["に"],["仕えて","つかえて"],["働いた","はたらいた"],["から"],["で"],["ある"],["。"],["あなた"],["が"],["そう"],["するならば"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["あなた"],["が"],["行なう","おこなう"],["すべて"],["の"],["事","こと"],["に"],["あなた"],["を"],["祝福","しゅくふく"],["されるで"],["あろう"],["。"]]},{"verse":19,"text":"牛,うし、羊,ひつじの産,うむ雄,おすのういごは皆,みなあなたの神,かみ、主,しゅに聖別,せいべつしなければならない。牛,うしのういごを用,もちいてなんの仕事,しごとをもしてはならない。また羊,ひつじのういごの毛,けを切,きってはならない。","tok":[["牛","うし"],["、"],["羊","ひつじ"],["の"],["産む","うむ"],["雄","おす"],["の"],["うい"],["ご"],["は"],["皆","みな"],["あなた"],["の"],["神","かみ"],["、"],["主に","しゅに"],["聖別","せいべつ"],["しなければ"],["ならない"],["。"],["牛","うし"],["の"],["うい"],["ご"],["を"],["用いて","もちいて"],["なん"],["の"],["仕事","しごと"],["を"],["も"],["して"],["は"],["ならない"],["。"],["また"],["羊","ひつじ"],["の"],["うい"],["ご"],["の"],["毛","け"],["を"],["切って","きって"],["は"],["ならない"],["。"]]},{"verse":20,"text":"あなたの神,かみ、主,しゅが選,えらばれる所,ところで、主,しゅの前,まえにあなたは家族,かぞくと共,ともに年,としごとにそれを食,たべなければならない。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["選ら","えら"],["ばれる"],["所","ところ"],["で"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["あなた"],["は"],["家族","かぞく"],["と"],["共","とも"],["に"],["年","としごと"],["に"],["それ"],["を"],["食べなければ","たべなければ"],["ならない"],["。"]]},{"verse":21,"text":"しかし、その獣,けものがもし傷,きずのあるもの、すなわち足,あしなえまたは、めくらなど、すべて悪,わるい傷,きずのあるものである時,ときは、あなたの神,かみ、主,しゅにそれを犠牲,ぎせいとしてささげてはならない。","tok":[["しかし"],["、"],["その"],["獣","けもの"],["が"],["もし"],["傷","きず"],["の"],["ある"],["もの"],["、"],["すなわち"],["足","あし"],["な"],["え"],["また"],["は"],["、"],["めくら"],["など"],["、"],["すべて"],["悪い","わるい"],["傷","きず"],["の"],["ある"],["もの"],["で"],["ある"],["時","とき"],["は"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主に","しゅに"],["それ"],["を"],["犠牲","ぎせい"],["として"],["ささげて"],["は"],["ならない"],["。"]]},{"verse":22,"text":"町,まちの内,うちでそれを食,たべなければならない。汚,けがれた人,ひとも、清,きよい人,ひとも、かもしかや、雄,おじかと同様,どうようにそれを食,たべることができる。","tok":[["町","まち"],["の"],["内","うち"],["で"],["それ"],["を"],["食べなければ","たべなければ"],["ならない"],["。"],["汚","け"],["がれ"],["た"],["人","ひと"],["も"],["、"],["清い","きよい"],["人","ひと"],["も"],["、"],["かもしか"],["や"],["、"],["雄","おじか"],["と"],["同様","どうよう"],["に"],["それ"],["を"],["食べる","たべる"],["こと"],["が"],["できる"],["。"]]},{"verse":23,"text":"ただし、その血,ちは食,たべてはならない。水,みずのようにそれを地,ちにそそがなければならない。","tok":[["ただし"],["、"],["その"],["血","ち"],["は"],["食べて","たべて"],["は"],["ならない"],["。"],["水","みず"],["の"],["よう"],["に"],["それ"],["を"],["地","ち"],["に"],["そそがなければ"],["ならない"],["。"]]}]
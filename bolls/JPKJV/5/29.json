[{"verse":1,"text":"[2]モーセはイスラエルのすべての人,ひとを呼,よび集,あつめて言,いった、「あなたがたは主,しゅがエジプトの地,ちで、パロと、そのすべての家来,けらいと、その全,ぜん地,ちとにせられたすべての事,ことをまのあたり見,みた。","tok":[["["],["2"],["]"],["モーセ"],["は"],["イスラエル"],["の"],["すべて"],["の"],["人","ひと"],["を"],["呼び集めて","よびあつめて"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["主","しゅ"],["が"],["エジプト"],["の"],["地","ち"],["で"],["、"],["パロ"],["と"],["、"],["その"],["すべて"],["の"],["家来","けらい"],["と"],["、"],["その"],["全地","ぜんち"],["と"],["に"],["せられた"],["すべて"],["の"],["事","こと"],["を"],["まのあたり"],["見た","みた"],["。"]]},{"verse":2,"text":"[3]すなわちその大,おおきな試,こころみと、しるしと、大,おおきな不思議,ふしぎとをまのあたり見,みたのである。","tok":[["["],["3"],["]"],["すなわち"],["その"],["大きな","おおきな"],["試み","こころみ"],["と"],["、"],["しるし"],["と"],["、"],["大きな","おおきな"],["不思議","ふしぎ"],["と"],["を"],["まのあたり"],["見た","みた"],["ので"],["ある"],["。"]]},{"verse":3,"text":"[4]しかし、今日,こんにちまで主,しゅはあなたがたの心,こころに悟,さとらせず、目,めに見,みさせず、耳,みみに聞,きかせられなかった。","tok":[["["],["4"],["]"],["しかし"],["、"],["今日","こん"],["に"],["ち"],["まで"],["主","しゅ"],["は"],["あなた"],["がた"],["の"],["心","こころ"],["に"],["悟らせず","さとらせず"],["、"],["目","め"],["に"],["見させず","みさせず"],["、"],["耳","みみ"],["に"],["聞かせられなかった","きかせられなかった"],["。"]]},{"verse":4,"text":"[5]わたしは四十年,ねんの間,あいだ、あなたがたを導,みちびいて荒野,あらのを通,とおらせたが、あなたがたの身,みにつけた着物,きものは古,ふるびず、足,あしのくつは古,ふるびなかった。","tok":[["["],["5"],["]"],["わたし"],["は"],["四十","よんじゅう"],["年","ねん"],["の"],["間","あいだ"],["、"],["あなた"],["がた"],["を"],["導いて","みちびいて"],["荒野","あら"],["の"],["を"],["通らせた","とおらせた"],["が"],["、"],["あなた"],["がた"],["の"],["身","み"],["に"],["つけた"],["着物","きもの"],["は"],["古びず","ふるびず"],["、"],["足","あし"],["の"],["くつ"],["は"],["古びなかった","ふるびなかった"],["。"]]},{"verse":5,"text":"[6]あなたがたはまたパンも食,たべず、ぶどう酒,しゅも濃,こい酒,さけも飲,のまなかった。こうしてあなたがたは、わたしがあなたがたの神,かみ、主,しゅであることを知,しるに至,いたった。","tok":[["["],["6"],["]"],["あなた"],["がた"],["は"],["また"],["パン"],["も"],["食べず","たべず"],["、"],["ぶどう酒","ぶどうしゅ"],["も"],["濃い","こい"],["酒","さけ"],["も"],["飲まなかった","のまなかった"],["。"],["こう"],["して"],["あなた"],["がた"],["は"],["、"],["わたし"],["が"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["で"],["ある"],["こと"],["を"],["知る","しる"],["に"],["至った","いたった"],["。"]]},{"verse":6,"text":"[7]あなたがたがこの所,ところにきたとき、ヘシボンの王,おうシホンと、バシャンの王,おうオグがわれわれを迎,むかえて戦,たたかったが、われわれは彼,かれらを撃,うち敗,やぶって、","tok":[["["],["7"],["]"],["あなた"],["がた"],["が"],["この"],["所","ところ"],["に"],["きた"],["とき"],["、"],["ヘシボン"],["の"],["王","おう"],["シホン"],["と"],["、"],["バシャン"],["の"],["王","おう"],["オグ"],["が"],["われわれ"],["を"],["迎","むかえ"],["て"],["戦った","たたかった"],["が"],["、"],["われわれ"],["は"],["彼","かれ"],["ら"],["を"],["撃ち","うち"],["敗って","やぶって"],["、"]]},{"verse":7,"text":"[8]その地,ちを取,とり、これをルベンびとと、ガドびとと、マナセびとの半,なかばとに、嗣,し業,ぎょうとして与,あたえた。","tok":[["["],["8"],["]"],["その"],["地","ち"],["を"],["取","とり"],["、"],["これ"],["を"],["ルベン"],["びと"],["と"],["、"],["ガド"],["びと"],["と"],["、"],["マナセ"],["びと"],["の"],["半ば","なかば"],["と"],["に"],["、"],["嗣業","しぎょう"],["として"],["与","あたえ"],["た"],["。"]]},{"verse":8,"text":"[9]それゆえ、あなたがたはこの契約,けいやくの言葉,ことばを守,まもって、それを行,おこなわなければならない。そうすればあなたがたのするすべての事,ことは栄,さかえるであろう。","tok":[["["],["9"],["]"],["それ"],["ゆえ"],["、"],["あなた"],["がた"],["は"],["この"],["契約","けいやく"],["の"],["言葉","ことば"],["を"],["守って","まもって"],["、"],["それ"],["を"],["行なわなければ","おこなわなければ"],["ならない"],["。"],["そう"],["すれば"],["あなた"],["がた"],["の"],["する"],["すべて"],["の"],["事","こと"],["は"],["栄","さかえ"],["るで"],["あろう"],["。"]]},{"verse":9,"text":"[10]あなたがたは皆,みな、きょう、あなたがたの神,かみ、主,しゅの前,まえに立,たっている。すなわちあなたがたの部族,ぶぞくのかしらたち、長老,ちょうろうたち、つかさたちなど、イスラエルのすべての人々,ひとびと、","tok":[["["],["10"],["]"],["あなた"],["がた"],["は"],["皆","みな"],["、"],["きょう"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["立って","たって"],["いる"],["。"],["すなわち"],["あなた"],["がた"],["の"],["部族","ぶぞく"],["の"],["かしら"],["たち"],["、"],["長老","ちょうろう"],["たち"],["、"],["つかさ"],["たち"],["など"],["、"],["イスラエル"],["の"],["すべて"],["の"],["人々","ひとびと"],["、"]]},{"verse":10,"text":"[11]あなたがたの小,ちいさい者,ものたちも、妻,つまたちも、宿営,しゅくえいのうちに寄留,きりゅうしている他国,たこく人,じんも、あなたのために、たきぎを割,わる者,ものも、水,みずをくむ者,ものも、みな主,しゅの前,まえに立,たって、","tok":[["["],["11"],["]"],["あなた"],["がた"],["の"],["小さい","ちいさい"],["者","もの"],["たち"],["も"],["、"],["妻たち","つまたち"],["も"],["、"],["宿営","しゅくえい"],["の"],["うち"],["に"],["寄留","きりゅう"],["して"],["いる"],["他国人","たこくじん"],["も"],["、"],["あなた"],["の"],["ため"],["に"],["、"],["たきぎ"],["を"],["割る","わる"],["者","もの"],["も"],["、"],["水","みず"],["を"],["くむ"],["者","もの"],["も"],["、"],["みな"],["主","しゅ"],["の"],["前","まえ"],["に"],["立って","たって"],["、"]]},{"verse":11,"text":"[12]あなたの神,かみ、主,しゅが、きょう、あなたと結,むすばれるあなたの神,かみ、主,しゅの契約,けいやくと誓,ちかいとに、はいろうとしている。","tok":[["["],["12"],["]"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["、"],["きょう"],["、"],["あなた"],["と"],["結ばれる","むすばれる"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["契約","けいやく"],["と"],["誓い","ちかい"],["と"],["に"],["、"],["はいろう"],["として"],["いる"],["。"]]},{"verse":12,"text":"[13]これは主,しゅがさきにあなたに約束,やくそくされたように、またあなたの先祖,せんぞアブラハム、イサク、ヤコブに誓,ちかわれたように、きょう、あなたを立,たてて自分,じぶんの民,たみとし、またみずからあなたの神,かみとなられるためである。","tok":[["["],["13"],["]"],["これ"],["は"],["主に","しゅがさきに"],["あなた"],["に"],["約束","やくそく"],["された"],["よう"],["に"],["、"],["また"],["あなた"],["の"],["先祖","せんぞ"],["アブラハム"],["、"],["イサク"],["、"],["ヤコブ"],["に"],["誓われた","ちかわれた"],["よう"],["に"],["、"],["きょう"],["、"],["あなた"],["を"],["立てて","たてて"],["自分","じぶん"],["の"],["民","たみ"],["と"],["し"],["、"],["また"],["みずから"],["あなた"],["の"],["神","かみ"],["と"],["なられる"],["ため"],["で"],["ある"],["。"]]},{"verse":13,"text":"[14]わたしはただあなたがたとだけ、この契約,けいやくと誓,ちかいとを結,むすぶのではない。","tok":[["["],["14"],["]"],["わたし"],["は"],["ただ"],["あなた"],["がた"],["と"],["だけ"],["、"],["この"],["契約","けいやく"],["と"],["誓い","ちかい"],["と"],["を"],["結ぶ","むすぶ"],["ので"],["は"],["ない"],["。"]]},{"verse":14,"text":"[15]きょう、ここで、われわれの神,かみ、主,しゅの前,まえにわれわれと共,ともに立,たっている者,ものならびに、きょう、ここにわれわれと共,ともにいない者,ものとも結,むすぶのである。","tok":[["["],["15"],["]"],["きょう"],["、"],["ここ"],["で"],["、"],["われわれ"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["われわれ"],["と"],["共","とも"],["に"],["立って","たって"],["いる"],["者","もの"],["ならびに"],["、"],["きょう"],["、"],["ここ"],["に"],["われわれ"],["と"],["共","とも"],["に"],["いない"],["者","もの"],["と"],["も"],["結ぶ","むすぶ"],["ので"],["ある"],["。"]]},{"verse":15,"text":"[16]われわれがどのようにエジプトの国,くにに住,すんでいたか、どのように国々,くにぐにの民,たみの中,なかを通,とおってきたか、それはあなたがたが知,しっている。","tok":[["["],["16"],["]"],["われわれ"],["が"],["どの"],["よう"],["に"],["エジプト"],["の"],["国","くに"],["に"],["住んで","すんで"],["いた"],["か"],["、"],["どの"],["よう"],["に"],["国々","くにぐに"],["の"],["民","たみ"],["の"],["中","なか"],["を"],["通って","とおって"],["きた"],["か"],["、"],["それ"],["は"],["あなた"],["がた"],["が"],["知って","しって"],["いる"],["。"]]},{"verse":16,"text":"[17]またあなたがたは木,きや石,いしや銀,ぎんや金,きんで造,つくった憎,にくむべき物,ものと偶像,ぐうぞうとが、彼,かれらのうちにあるのを見,みた。","tok":[["["],["17"],["]"],["また"],["あなた"],["がた"],["は"],["木","き"],["や"],["石","いし"],["や"],["銀","ぎん"],["や"],["金","きん"],["で"],["造った","つくった"],["憎むべき","にくむべき"],["物","もの"],["と"],["偶像","ぐうぞう"],["と"],["が"],["、"],["彼","かれ"],["ら"],["の"],["うち"],["に"],["ある"],["の"],["を"],["見た","みた"],["。"]]},{"verse":17,"text":"[18]それゆえ、あなたがたのうちに、きょう、その心,こころにわれわれの神,かみ、主,しゅを離,はなれてそれらの国民,こくみんの神々,かみがみに行,いって仕,つかえる男,おとこや女,おんな、氏族,しぞくや部族,ぶぞくがあってはならない。またあなたがたのうちに、毒草,どくそうや、にがよもぎを生,しょうずる根,ねがあってはならない。","tok":[["["],["18"],["]"],["それ"],["ゆえ"],["、"],["あなた"],["がた"],["の"],["うち"],["に"],["、"],["きょう"],["、"],["その"],["心","こころ"],["に"],["われわれ"],["の"],["神","かみ"],["、"],["主","しゅ"],["を"],["離れて","はなれて"],["それ"],["ら"],["の"],["国民","こくみん"],["の"],["神々","かみがみ"],["に"],["行って","いって"],["仕える","つかえる"],["男","おとこ"],["や"],["女","おんな"],["、"],["氏族","しぞく"],["や"],["部族","ぶぞく"],["が"],["あって"],["は"],["ならない"],["。"],["また"],["あなた"],["がた"],["の"],["うち"],["に"],["、"],["毒草","どくそう"],["や"],["、"],["にがよもぎ"],["を"],["生ずる","しょうずる"],["根","ね"],["が"],["あって"],["は"],["ならない"],["。"]]},{"verse":18,"text":"[19]そのような人,ひとはこの誓,ちかいの言葉,ことばを聞,きいても、心,こころに自分,じぶんを祝福,しゅくふくして『心,こころをかたくなにして歩,あゆんでもわたしには平安,へいあんがある』と言,いうであろう。そうすれば潤,うるおった者,ものも、かわいた者,ものもひとしく滅,ほろびるであろう。","tok":[["["],["19"],["]"],["その"],["よう"],["な"],["人","ひと"],["は"],["この"],["誓い","ちかい"],["の"],["言葉","ことば"],["を"],["聞いて","きいて"],["も"],["、"],["心","こころ"],["に"],["自分","じぶん"],["を"],["祝福","しゅくふく"],["して"],["『"],["心","こころ"],["を"],["かたくな"],["に"],["して"],["歩","あゆん"],["で"],["も"],["わたし"],["に"],["は"],["平安","へいあん"],["が"],["ある"],["』"],["と"],["言うで","いうで"],["あろう"],["。"],["そう"],["すれば"],["潤った","うるおった"],["者","もの"],["も"],["、"],["かわいた"],["者","もの"],["も"],["ひとしく"],["滅びるで","ほろびるで"],["あろう"],["。"]]},{"verse":19,"text":"[20]主,しゅはそのような人,ひとをゆるすことを好,このまれない。かえって主,しゅはその人,ひとに怒,いかりとねたみを発,はっし、この書物,しょもつにしるされたすべてののろいを彼,かれの上,うえに加,くわえ、主,しゅはついにその人,ひとの名,なを天,てんの下,したから消,けし去,さられるであろう。","tok":[["["],["20"],["]"],["主","しゅ"],["は"],["その"],["よう"],["な"],["人","ひと"],["を"],["ゆるす"],["こと"],["を"],["好まれない","このまれない"],["。"],["かえって"],["主","しゅ"],["は"],["その"],["人","ひと"],["に"],["怒り","いかり"],["と"],["ねたみ"],["を"],["発し","はっし"],["、"],["この"],["書物","しょもつ"],["に"],["しるされた"],["すべて"],["の"],["のろい"],["を"],["彼","かれ"],["の"],["上","うえ"],["に"],["加え","くわえ"],["、"],["主","しゅ"],["は"],["ついに"],["その"],["人","ひと"],["の"],["名","な"],["を"],["天","てん"],["の"],["下","した"],["から"],["消し去られるで","けしさられるで"],["あろう"],["。"]]},{"verse":20,"text":"[21]主,しゅはイスラエルのすべての部族,ぶぞくのうちからその人,ひとを区,く別,べっして災,わざわいをくだし、この律法,りっぽうの書,しょにしるされた契約,けいやくの中,なかのもろもろののろいのようにされるであろう。","tok":[["["],["21"],["]"],["主","しゅ"],["は"],["イスラエル"],["の"],["すべて"],["の"],["部族","ぶぞく"],["の"],["うち"],["から"],["その"],["人","ひと"],["を"],["区別","くべっ"],["して"],["災","わざわい"],["を"],["くだし"],["、"],["この"],["律法","りっぽう"],["の"],["書","しょ"],["に"],["しるされた"],["契約","けいやく"],["の"],["中","なか"],["の"],["もろもろ"],["の"],["のろい"],["の"],["よう"],["に"],["されるで"],["あろう"],["。"]]},{"verse":21,"text":"[22]後,のちの代,よの人,ひと、すなわちあなたがたののちに起,おこるあなたがたの子孫,しそんおよび遠,とおい国,くにから来,くる外国,がいこく人,じんは、この地,ちの災,わざわいを見,み、主,しゅがこの地,ちにくだされた病気,びょうきを見,みて言,いうであろう。","tok":[["["],["22"],["]"],["後","のち"],["の"],["代","よ"],["の"],["人","ひと"],["、"],["すなわち"],["あなた"],["がた"],["の"],["のち"],["に"],["起こる","おこる"],["あなた"],["がた"],["の"],["子孫","しそん"],["および"],["遠い","とおい"],["国","くに"],["から"],["来る","くる"],["外国人","がいこくじん"],["は"],["、"],["この"],["地","ち"],["の"],["災","わざわい"],["を"],["見","み"],["、"],["主","しゅがこ"],["の"],["地","ち"],["に"],["くだされた"],["病気","びょうき"],["を"],["見て","みて"],["言うで","いうで"],["あろう"],["。"]]},{"verse":22,"text":"[23]――全,ぜん地,ちは硫黄,いおうとなり、塩,しおとなり、焼,やけ土,つちとなって、種,たねもまかれず、実,みも結,むすばず、なんの草,くさも生,しょうじなくなって、むかし主,しゅが怒,いかりと憤,いきどおりをもって滅,ほろぼされたソドム、ゴモラ、アデマ、ゼボイムの破滅,はめつのようである。――","tok":[["["],["23"],["]"],["―"],["―"],["全地","ぜんち"],["は"],["硫黄","いおう"],["と"],["なり"],["、"],["塩","しお"],["と"],["なり"],["、"],["焼土","やけつち"],["と"],["なって"],["、"],["種","たね"],["も"],["まかれず"],["、"],["実","み"],["も"],["結ばず","むすばず"],["、"],["なん"],["の"],["草","くさ"],["も"],["生じなく","しょうじなく"],["なって"],["、"],["むかし"],["主","しゅ"],["が"],["怒り","いかり"],["と"],["憤り","いきどおり"],["を"],["もって"],["滅ぼされた","ほろぼされた"],["ソドム"],["、"],["ゴモラ"],["、"],["アデマ"],["、"],["ゼボイム"],["の"],["破滅","はめつ"],["の"],["よう"],["で"],["ある"],["。"],["―"],["―"]]},{"verse":23,"text":"[24]すなわち、もろもろの国民,こくみんは言,いうであろう、『なぜ、主,しゅはこの地,ちにこのようなことをされたのか。この激,はげしい大,おおいなる怒,いかりは何,なにゆえか』。","tok":[["["],["24"],["]"],["すなわち"],["、"],["もろもろ"],["の"],["国民","こくみん"],["は"],["言うで","いうで"],["あろう"],["、"],["『"],["なぜ"],["、"],["主","しゅ"],["は"],["この"],["地","ち"],["に"],["この"],["よう"],["な"],["こと"],["を"],["された"],["の"],["か"],["。"],["この"],["激しい","はげしい"],["大いなる","おおいなる"],["怒り","いかり"],["は"],["何ゆえ","なにゆえ"],["か"],["』"],["。"]]},{"verse":24,"text":"[25]そのとき人々,ひとびとは言,いうであろう、『彼,かれらはその先祖,せんぞの神,かみ、主,しゅがエジプトの国,くにから彼,かれらを導,みちびき出,だして彼,かれらと結,むすばれた契約,けいやくをすて、","tok":[["["],["25"],["]"],["その"],["とき"],["人々","ひとびと"],["は"],["言うで","いうで"],["あろう"],["、"],["『"],["彼","かれ"],["ら"],["は"],["その"],["先祖","せんぞ"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["エジプト"],["の"],["国","くに"],["から"],["彼","かれ"],["ら"],["を"],["導き出して","みちびきだして"],["彼","かれ"],["ら"],["と"],["結ばれた","むすばれた"],["契約","けいやく"],["を"],["すて"],["、"]]},{"verse":25,"text":"[26]行,いって彼,かれらの知,しらない、また授,さずからない、ほかの神々,かみがみに仕,つかえて、それを拝,おがんだからである。","tok":[["["],["26"],["]"],["行って","いって"],["彼","かれ"],["ら"],["の"],["知らない","しらない"],["、"],["また"],["授からない","さずからない"],["、"],["ほか"],["の"],["神々","かみがみ"],["に"],["仕えて","つかえて"],["、"],["それ"],["を"],["拝んだ","おがんだ"],["から"],["で"],["ある"],["。"]]},{"verse":26,"text":"[27]それゆえ主,しゅはこの地,ちにむかって怒,いかりを発,はっし、この書物,しょもつにしるされたもろもろののろいをこれにくだし、","tok":[["["],["27"],["]"],["それ"],["ゆえ"],["主","しゅ"],["は"],["この"],["地","ち"],["に"],["むかって"],["怒り","いかり"],["を"],["発し","はっし"],["、"],["この"],["書物","しょもつ"],["に"],["しるされた"],["もろもろ"],["の"],["のろい"],["を"],["これ"],["に"],["くだし"],["、"]]},{"verse":27,"text":"[28]そして主,しゅは怒,いかりと、はげしい怒,いかりと大,おおいなる憤,いきどおりとをもって彼,かれらをこの地,ちから抜,ぬき取,とって、ほかの国,くにに投,なげやられた。今日,こんにち見,みるとおりである』。","tok":[["["],["28"],["]"],["そして"],["主","しゅ"],["は"],["怒り","いかり"],["と"],["、"],["はげしい"],["怒り","いかり"],["と"],["大いなる","おおいなる"],["憤り","いきどおり"],["と"],["を"],["もって"],["彼","かれ"],["ら"],["を"],["この"],["地","ち"],["から"],["抜き取って","ぬきとって"],["、"],["ほか"],["の"],["国","くに"],["に"],["投","なげ"],["やられた"],["。"],["今日","こん"],["に"],["ち"],["見る","みる"],["とおり"],["で"],["ある"],["』"],["。"]]},{"verse":28,"text":"[29]隠,かくれた事,ことはわれわれの神,かみ、主,しゅに属,ぞくするものである。しかし表,あらわされたことは長,ながくわれわれとわれわれの子孫,しそんに属,ぞくし、われわれにこの律法,りっぽうのすべての言葉,ことばを行,おこなわせるのである。","tok":[["["],["29"],["]"],["隠れた","かくれた"],["事","こと"],["は"],["われわれ"],["の"],["神","かみ"],["、"],["主","しゅ"],["に"],["属する","ぞくする"],["もの"],["で"],["ある"],["。"],["しかし"],["表わされた","あらわされた"],["こと"],["は"],["長く","ながく"],["われわれ"],["と"],["われわれ"],["の"],["子孫","しそん"],["に"],["属し","ぞくし"],["、"],["われわれ"],["に"],["この"],["律法","りっぽう"],["の"],["すべて"],["の"],["言葉","ことば"],["を"],["行なわせる","おこなわせる"],["ので"],["ある"],["。"]]}]
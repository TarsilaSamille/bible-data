[{"verse":1,"text":"そこでモーセは続,つづいてこの言葉,ことばをイスラエルのすべての人,ひとに告,つげて、","tok":[["そこ"],["で"],["モーセ"],["は"],["続いて","つづいて"],["この"],["言葉","ことば"],["を"],["イスラエル"],["の"],["すべて"],["の"],["人","ひと"],["に"],["告","つげ"],["て"],["、"]]},{"verse":2,"text":"彼,かれらに言,いった、「わたしは、きょう、すでに百二十歳,さいになり、もはや出入,でいりすることはできない。また主,しゅはわたしに『おまえはこのヨルダンを渡,わたることはできない』と言,いわれた。","tok":[["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["わたし"],["は"],["、"],["きょう"],["、"],["すでに"],["百二十歳","さい"],["に"],["なり"],["、"],["もはや"],["出入","でいり"],["する"],["こと"],["は"],["できない"],["。"],["また"],["主","しゅ"],["は"],["わたし"],["に"],["『"],["おまえ"],["は"],["この"],["ヨルダン"],["を"],["渡る","わたる"],["こと"],["は"],["できない"],["』"],["と"],["言われた","いわれた"],["。"]]},{"verse":3,"text":"あなたの神,かみ、主,しゅはみずからあなたに先立,さきだって渡,わたり、あなたの前,まえから、これらの国々,くにぐにの民,たみを滅,ほろぼし去,さって、あなたにこれを獲,えさせられるであろう。また主,しゅがかつて言,いわれたように、ヨシュアはあなたを率,ひきいて渡,わたるであろう。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["みずから"],["あなた"],["に"],["先立って","さきだって"],["渡り","わたり"],["、"],["あなた"],["の"],["前","まえ"],["から"],["、"],["これ"],["ら"],["の"],["国々","くにぐに"],["の"],["民","たみ"],["を"],["滅ぼし","ほろぼし"],["去て","さって"],["、"],["あなた"],["に"],["これ"],["を"],["獲させられるで","えさせられるで"],["あろう"],["。"],["また"],["主","しゅ"],["が"],["かつて"],["言われた","いわれた"],["よう"],["に"],["、"],["ヨシュア"],["は"],["あなた"],["を"],["率いて","ひきいて"],["渡るで","わたるで"],["あろう"],["。"]]},{"verse":4,"text":"主,しゅがさきにアモリびとの王,おうシホンとオグおよびその地,ちにされたように、彼,かれらにもおこなって彼,かれらを滅,ほろぼされるであろう。","tok":[["主に","しゅがさきに"],["アモリ"],["びと"],["の"],["王","おう"],["シホン"],["と"],["オグ"],["および"],["その"],["地","ち"],["に"],["された"],["よう"],["に"],["、"],["彼","かれ"],["ら"],["に"],["も"],["おこなって"],["彼","かれ"],["ら"],["を"],["滅ぼされるで","ほろぼされるで"],["あろう"],["。"]]},{"verse":5,"text":"主,しゅは彼,かれらをあなたがたに渡,わたされるから、あなたがたはわたしが命,めいじたすべての命令,めいれいのとおりに彼,かれらに行,おこなわなければならない。","tok":[["主","しゅ"],["は"],["彼","かれ"],["ら"],["を"],["あなた"],["がた"],["に"],["渡される","わたされる"],["から"],["、"],["あなた"],["がた"],["は"],["わたし"],["が"],["命じた","めいじた"],["すべて"],["の"],["命令","めいれい"],["の"],["とおり"],["に"],["彼","かれ"],["ら"],["に"],["行なわなければ","おこなわなければ"],["ならない"],["。"]]},{"verse":6,"text":"あなたがたは強,つよく、かつ勇,いさましくなければならない。彼,かれらを恐,おそれ、おののいてはならない。あなたの神,かみ、主,しゅがあなたと共,ともに行,いかれるからである。主,しゅは決,けっしてあなたを見放,みはなさず、またあなたを見捨,みすてられないであろう」。","tok":[["あなた"],["がた"],["は"],["強く","つよく"],["、"],["かつ"],["勇ましく","いさましく"],["なければ"],["ならない"],["。"],["彼","かれ"],["ら"],["を"],["恐","おそれ"],["、"],["おののいて"],["は"],["ならない"],["。"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["あなた"],["と"],["共","とも"],["に"],["行かれる","いかれる"],["から"],["で"],["ある"],["。"],["主","しゅ"],["は"],["決っして","けっして"],["あなた"],["を"],["見放さず","みはなさず"],["、"],["また"],["あなた"],["を"],["見捨てられないで","みすてられないで"],["あろう"],["」"],["。"]]},{"verse":7,"text":"モーセはヨシュアを呼,よび、イスラエルのすべての人,ひとの目,めの前,まえで彼,かれに言,いった、「あなたはこの民,たみと共,ともに行,いき、主,しゅが彼,かれらの先祖,せんぞたちに与,あたえると誓,ちかわれた地,ちに入,いるのであるから、あなたは強,つよく、かつ勇,いさましくなければならない。あなたは彼,かれらにそれを獲,えさせるであろう。","tok":[["モーセ"],["は"],["ヨシュア"],["を"],["呼び","よび"],["、"],["イスラエル"],["の"],["すべて"],["の"],["人","ひと"],["の"],["目","め"],["の"],["前","まえ"],["で"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["は"],["この"],["民","たみ"],["と"],["共","とも"],["に"],["行き","いき"],["、"],["主","しゅ"],["が"],["彼","かれ"],["ら"],["の"],["先祖","せんぞ"],["たち"],["に"],["与える","あたえる"],["と"],["誓われた","ちかわれた"],["地","ち"],["に"],["入","いる"],["ので"],["ある"],["から"],["、"],["あなた"],["は"],["強く","つよく"],["、"],["かつ"],["勇ましく","いさましく"],["なければ"],["ならない"],["。"],["あなた"],["は"],["彼","かれ"],["ら"],["に"],["それ"],["を"],["獲させるで","えさせるで"],["あろう"],["。"]]},{"verse":8,"text":"主,しゅはみずからあなたに先立,さきだって行,いき、またあなたと共,ともにおり、あなたを見放,みはなさず、見捨,みすてられないであろう。恐,おそれてはならない、おののいてはならない」。","tok":[["主","しゅ"],["は"],["みずから"],["あなた"],["に"],["先立って","さきだって"],["行き","いき"],["、"],["また"],["あなた"],["と"],["共","とも"],["に"],["おり"],["、"],["あなた"],["を"],["見放さず","みはなさず"],["、"],["見捨てられないで","みすてられないで"],["あろう"],["。"],["恐れて","おそれて"],["は"],["ならない"],["、"],["おののいて"],["は"],["ならない"],["」"],["。"]]},{"verse":9,"text":"モーセはこの律法,りっぽうを書,かいて、主,しゅの契約,けいやくの箱,はこをかつぐレビの子孫,しそんである祭司,さいしおよびイスラエルのすべての長老,ちょうろうたちに授,さづけた。","tok":[["モーセ"],["は"],["この"],["律法","りっぽう"],["を"],["書いて","かいて"],["、"],["主","しゅ"],["の"],["契約","けいやく"],["の"],["箱","はこ"],["を"],["かつぐ"],["レビ"],["の"],["子孫","しそん"],["で"],["ある"],["祭司","さいし"],["および"],["イスラエル"],["の"],["すべて"],["の"],["長老","ちょうろう"],["たち"],["に"],["授","さ"],["づけた"],["。"]]},{"verse":10,"text":"そしてモーセは彼,かれらに命,めいじて言,いった、「七年,ねんの終,おわりごとに、すなわち、ゆるしの年,としの定,さだめの時,ときになり、かりいおの祭,まつりに、","tok":[["そして"],["モーセ"],["は"],["彼","かれ"],["ら"],["に"],["命じて","めいじて"],["言った","いった"],["、"],["「"],["七","なな"],["年","ねん"],["の"],["終","おわり"],["ごと"],["に"],["、"],["すなわち"],["、"],["ゆるし"],["の"],["年","とし"],["の"],["定め","さだめ"],["の"],["時","とき"],["に"],["なり"],["、"],["かりい"],["お"],["の"],["祭","まつり"],["に"],["、"]]},{"verse":11,"text":"イスラエルのすべての人,ひとがあなたの神,かみ、主,しゅの前,まえに出,でるため、主,しゅの選,えらばれる場所,ばしょに来,くるとき、あなたはイスラエルのすべての人,ひとの前,まえでこの律法,りっぽうを読,よんで聞,きかせなければならない。","tok":[["イスラエル"],["の"],["すべて"],["の"],["人","ひと"],["が"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["出る","でる"],["ため"],["、"],["主","しゅ"],["の"],["選ら","えら"],["ばれる"],["場所","ばしょ"],["に"],["来る","くる"],["とき"],["、"],["あなた"],["は"],["イスラエル"],["の"],["すべて"],["の"],["人","ひと"],["の"],["前","まえ"],["で"],["この"],["律法","りっぽう"],["を"],["読んで","よんで"],["聞かせなければ","きかせなければ"],["ならない"],["。"]]},{"verse":12,"text":"すなわち男,おとこ、女,おんな、子供,こどもおよびあなたの町,まちのうちに寄留,きりゅうしている他国,たこく人,じんなど民,たみを集,あつめ、彼,かれらにこれを聞,きかせ、かつ学,まなばせなければならない。そうすれば彼,かれらはあなたがたの神,かみ、主,しゅを恐,おそれてこの律法,りっぽうの言葉,ことばを、ことごとく守,まもり行,おこなうであろう。","tok":[["すなわち"],["男","おとこ"],["、"],["女","おんな"],["、"],["子供","こども"],["および"],["あなた"],["の"],["町","まち"],["の"],["うち"],["に"],["寄留","きりゅう"],["して"],["いる"],["他国人","たこくじん"],["など"],["民","たみ"],["を"],["集め","あつめ"],["、"],["彼","かれ"],["ら"],["に"],["これ"],["を"],["聞かせ","きかせ"],["、"],["かつ"],["学ばせなければ","まなばせなければ"],["ならない"],["。"],["そう"],["すれば"],["彼","かれ"],["ら"],["は"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["を"],["恐て","おそれて"],["この"],["律法","りっぽう"],["の"],["言葉","ことば"],["を"],["、"],["ことごとく"],["守り","まもり"],["行なうで","おこなうで"],["あろう"],["。"]]},{"verse":13,"text":"また彼,かれらの子供,こどもたちでこれを知,しらない者,ものも聞,きいて、あなたがたの神,かみ、主,しゅを恐,おそれることを学,まなぶであろう。あなたがたがヨルダンを渡,わたって行,いって取,とる地,ちにながらえる日,ひのあいだ常,つねにそうしなければならない」。","tok":[["また"],["彼","かれ"],["ら"],["の"],["子供","こども"],["たち"],["で"],["これ"],["を"],["知らない","しらない"],["者","もの"],["も"],["聞いて","きいて"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["を"],["恐れる","おそれる"],["こと"],["を"],["学ぶで","まなぶで"],["あろう"],["。"],["あなた"],["がた"],["が"],["ヨルダン"],["を"],["渡って","わたって"],["行って","いって"],["取る","とる"],["地","ち"],["に"],["ながらえる"],["日","ひ"],["の"],["あいだ"],["常","つね"],["に"],["そう"],["しなければ"],["ならない"],["」"],["。"]]},{"verse":14,"text":"主,しゅはまたモーセに言,いわれた、「あなたの死,しぬ日,ひが近,ちかづいている。ヨシュアを召,めして共,ともに会見,かいけんの幕屋,まくやに立,たちなさい。わたしは彼,かれに務,つとめを命,めいじるであろう」。モーセとヨシュアが行,いって会見,かいけんの幕屋,まくやに立,たつと、","tok":[["主","しゅ"],["は"],["また"],["モーセ"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["の"],["死ぬ","しぬ"],["日","ひ"],["が"],["近づいて","ちかづいて"],["いる"],["。"],["ヨシュア"],["を"],["召","めし"],["て"],["共","とも"],["に"],["会見","かいけん"],["の"],["幕屋","まくや"],["に"],["立","たち"],["なさい"],["。"],["わたし"],["は"],["彼","かれ"],["に"],["務め","つとめ"],["を"],["命じるで","めいじるで"],["あろう"],["」"],["。"],["モーセ"],["と"],["ヨシュア"],["が"],["行って","いって"],["会見","かいけん"],["の"],["幕屋","まくや"],["に"],["立つ","たつ"],["と"],["、"]]},{"verse":15,"text":"主,しゅは幕屋,まくやで雲,くもの柱,はしらのうちに現,あらわれられた。その雲,くもの柱,はしらは幕屋,まくやの入口,いりぐちのかたわらにとどまった。","tok":[["主","しゅ"],["は"],["幕屋","まくや"],["で"],["雲","くも"],["の"],["柱","はしら"],["の"],["うち"],["に"],["現われられた","あらわれられた"],["。"],["その"],["雲","くも"],["の"],["柱","はしら"],["は"],["幕屋","まくや"],["の"],["入口","いりぐち"],["の"],["かたわら"],["に"],["とどまった"],["。"]]},{"verse":16,"text":"主,しゅはモーセに言,いわれた、「あなたはまもなく眠,ねむって先祖,せんぞたちと一緒,いっしょになるであろう。そのときこの民,たみはたちあがり、はいって行,いく地,ちの異,ことなる神々,かみがみを慕,したって姦淫,かんいんを行,おこない、わたしを捨,すて、わたしが彼,かれらと結,むすんだ契約,けいやくを破,やぶるであろう。","tok":[["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["は"],["ま"],["も"],["なく"],["眠って","ねむって"],["先祖","せんぞ"],["たち"],["と"],["一緒","いっしょ"],["に"],["なるで"],["あろう"],["。"],["その"],["とき"],["この"],["民","たみ"],["は"],["たちあがり"],["、"],["はい"],["って"],["行く","いく"],["地","ち"],["の"],["異なる","ことなる"],["神々","かみがみ"],["を"],["慕って","したって"],["姦淫","かんいん"],["を"],["行ない","おこない"],["、"],["わたし"],["を"],["捨て","すて"],["、"],["わたし"],["が"],["彼","かれ"],["ら"],["と"],["結んだ","むすんだ"],["契約","けいやく"],["を"],["破るで","やぶるで"],["あろう"],["。"]]},{"verse":17,"text":"その日,ひには、わたしは彼,かれらにむかって怒,いかりを発,はっし、彼,かれらを捨,すて、わたしの顔,かおを彼,かれらに隠,かくすゆえに、彼,かれらは滅,ほろぼしつくされ、多,おおくの災,わざわいと悩,なやみが彼,かれらに臨,のぞむであろう。そこでその日,ひ、彼,かれらは言,いうであろう、『これらの災,わざわいがわれわれに臨,のぞむのは、われわれの神,かみがわれわれのうちにおられないからではないか』。","tok":[["その"],["日","ひ"],["に"],["は"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["に"],["むかって"],["怒り","いかり"],["を"],["発し","はっし"],["、"],["彼","かれ"],["ら"],["を"],["捨て","すて"],["、"],["わたし"],["の"],["顔","かお"],["を"],["彼","かれ"],["ら"],["に"],["隠す","かくす"],["ゆえ"],["に"],["、"],["彼","かれ"],["ら"],["は"],["滅ぼし","ほろぼし"],["つくされ"],["、"],["多く","おおく"],["の"],["災","わざわい"],["と"],["悩み","なやみ"],["が"],["彼","かれ"],["ら"],["に"],["臨むで","のぞむで"],["あろう"],["。"],["そこ"],["で"],["その"],["日","ひ"],["、"],["彼","かれ"],["ら"],["は"],["言うで","いうで"],["あろう"],["、"],["『"],["これ"],["ら"],["の"],["災","わざわい"],["が"],["われわれ"],["に"],["臨む","のぞむ"],["の"],["は"],["、"],["われわれ"],["の"],["神","かみ"],["が"],["われわれ"],["の"],["うち"],["に"],["おられない"],["から"],["で"],["は"],["ない"],["か"],["』"],["。"]]},{"verse":18,"text":"しかも彼,かれらがほかの神々,かみがみに帰,きして、もろもろの悪,あくを行,おこなうゆえに、わたしはその日,ひには必,かならずわたしの顔,かおを隠,かくすであろう。","tok":[["しかも"],["彼","かれ"],["ら"],["が"],["ほか"],["の"],["神々","かみがみ"],["に"],["帰して","きして"],["、"],["もろもろ"],["の"],["悪","あく"],["を"],["行なう","おこなう"],["ゆえ"],["に"],["、"],["わたし"],["は"],["その"],["日","ひ"],["に"],["は"],["必","かならず"],["わたし"],["の"],["顔","かお"],["を"],["隠すで","かくすで"],["あろう"],["。"]]},{"verse":19,"text":"それであなたがたは今,いま、この歌,うたを書,かきしるし、イスラエルの人々,ひとびとに教,おしえてその口,くちに唱,となえさせ、この歌,うたをイスラエルの人々,ひとびとに対,たいするわたしのあかしとならせなさい。","tok":[["それ"],["で"],["あなた"],["がた"],["は"],["今","いま"],["、"],["この"],["歌","うた"],["を"],["書きしるし","かきしるし"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["教えて","おしえて"],["その"],["口","くち"],["に"],["唱えさせ","となえさせ"],["、"],["この"],["歌","うた"],["を"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["対する","たいする"],["わたし"],["の"],["あかし"],["と"],["ならせ"],["なさい"],["。"]]},{"verse":20,"text":"わたしが彼,かれらの先祖,せんぞたちに誓,ちかった、乳,ちちと蜜,みつの流,ながれる地,ちに彼,かれらを導,みちびき入,いれる時,とき、彼,かれらは食,たべて飽,あき、肥,こえ太,ふとるに及,およんで、ほかの神々,かみがみに帰,きし、それに仕,つかえて、わたしを軽,かろんじ、わたしの契約,けいやくを破,やぶるであろう。","tok":[["わたし"],["が"],["彼","かれ"],["ら"],["の"],["先祖","せんぞ"],["たち"],["に"],["誓った","ちかった"],["、"],["乳","ちち"],["と"],["蜜","みつ"],["の"],["流れる","ながれる"],["地","ち"],["に"],["彼","かれ"],["ら"],["を"],["導き入れる","みちびきいれる"],["時","とき"],["、"],["彼","かれ"],["ら"],["は"],["食べて","たべて"],["飽き","あき"],["、"],["肥","こえ"],["太る","ふとる"],["に"],["及んで","およんで"],["、"],["ほか"],["の"],["神々","かみがみ"],["に"],["帰し","きし"],["、"],["それ"],["に"],["仕えて","つかえて"],["、"],["わたし"],["を"],["軽んじ","かろんじ"],["、"],["わたし"],["の"],["契約","けいやく"],["を"],["破るで","やぶるで"],["あろう"],["。"]]},{"verse":21,"text":"こうして多,おおくの災,わざわいと悩,なやみとが彼,かれらに臨,のぞむ時,とき、この歌,うたは彼,かれらに対,たいして、あかしとなるであろう。（それはこの歌,うたが彼,かれらの子孫,しそんの口,くちにあって、彼,かれらはそれを忘,わすれないからである。）わたしが誓,ちかった地,ちに彼,かれらを導,みちびき入,いれる前,まえ、すでに彼,かれらが思,おもいはかっている事,ことをわたしは知,しっているからである」。","tok":[["こう"],["して"],["多く","おおく"],["の"],["災","わざわい"],["と"],["悩み","なやみ"],["と"],["が"],["彼","かれ"],["ら"],["に"],["臨む","のぞむ"],["時","とき"],["、"],["この"],["歌","うた"],["は"],["彼","かれ"],["ら"],["に対して","にたいして"],["、"],["あかし"],["と"],["なるで"],["あろう"],["。"],["（"],["それ"],["は"],["この"],["歌","うた"],["が"],["彼","かれ"],["ら"],["の"],["子孫","しそん"],["の"],["口","くち"],["に"],["あって"],["、"],["彼","かれ"],["ら"],["は"],["それ"],["を"],["忘ない","わすれない"],["から"],["で"],["ある"],["。"],["）"],["わたし"],["が"],["誓った","ちかった"],["地","ち"],["に"],["彼","かれ"],["ら"],["を"],["導き入れる","みちびきいれる"],["前","まえ"],["、"],["すでに"],["彼","かれ"],["ら"],["が"],["思い","おもい"],["はかって"],["いる"],["事","こと"],["を"],["わたし"],["は"],["知って","しって"],["いる"],["から"],["で"],["ある"],["」"],["。"]]},{"verse":22,"text":"モーセはその日,ひ、この歌,うたを書,かいてイスラエルの人々,ひとびとに教,おしえた。","tok":[["モーセ"],["は"],["その"],["日","ひ"],["、"],["この"],["歌","うた"],["を"],["書いて","かいて"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["教えた","おしえた"],["。"]]},{"verse":23,"text":"主,しゅはヌンの子,こヨシュアに命,めいじて言,いわれた、「あなたはイスラエルの人々,ひとびとをわたしが彼,かれらに誓,ちかった地,ちに導,みちびき入,いれなければならない。それゆえ強,つよくかつ勇,いさましくあれ。わたしはあなたと共,ともにいるであろう」。","tok":[["主","しゅ"],["は"],["ヌン"],["の"],["子","こ"],["ヨシュア"],["に"],["命じて","めいじて"],["言われた","いわれた"],["、"],["「"],["あなた"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["を"],["わたし"],["が"],["彼","かれ"],["ら"],["に"],["誓った","ちかった"],["地","ち"],["に"],["導き入れなければ","みちびきいれなければ"],["ならない"],["。"],["それ"],["ゆえ"],["強く","つよく"],["かつ"],["勇ましく","いさましく"],["あれ"],["。"],["わたし"],["は"],["あなた"],["と"],["共","とも"],["に"],["いるで"],["あろう"],["」"],["。"]]},{"verse":24,"text":"モーセがこの律法,りっぽうの言葉,ことばを、ことごとく書物,しょもつに書,かき終,おわった時,とき、","tok":[["モーセ"],["が"],["この"],["律法","りっぽう"],["の"],["言葉","ことば"],["を"],["、"],["ことごとく"],["書物","しょもつ"],["に"],["書き","かき"],["終わった","おわった"],["時","とき"],["、"]]},{"verse":25,"text":"モーセは主,しゅの契約,けいやくの箱,はこをかつぐレビびとに命,めいじて言,いった、","tok":[["モーセ"],["は"],["主","しゅ"],["の"],["契約","けいやく"],["の"],["箱","はこ"],["を"],["かつぐ"],["レビ"],["びと"],["に"],["命じて","めいじて"],["言った","いった"],["、"]]},{"verse":26,"text":"「この律法,りっぽうの書,しょをとって、あなたがたの神,かみ、主,しゅの契約,けいやくの箱,はこのかたわらに置,おき、その所,ところであなたにむかってあかしをするものとしなさい。","tok":[["「"],["この"],["律法","りっぽう"],["の"],["書","しょ"],["を"],["とって"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["契約","けいやく"],["の"],["箱","はこ"],["の"],["かたわら"],["に"],["置き","おき"],["、"],["その"],["所","ところ"],["で"],["あなた"],["に"],["むかって"],["あかし"],["を"],["する"],["もの"],["と"],["し"],["なさい"],["。"]]},{"verse":27,"text":"わたしはあなたのそむくことと、かたくななこととを知,しっている。きょう、わたしが生,いきながらえて、あなたがたと一緒,いっしょにいる間,あいだですら、あなたがたは主,しゅにそむいた。ましてわたしが死,しんだあとはどんなであろう。","tok":[["わたし"],["は"],["あなた"],["の"],["そむく"],["こと"],["と"],["、"],["かたくな"],["な"],["こと"],["と"],["を"],["知って","しって"],["いる"],["。"],["きょう"],["、"],["わたし"],["が"],["生きながらえて","いきながらえて"],["、"],["あなた"],["がた"],["と"],["一緒","いっしょ"],["に"],["いる"],["間","あいだ"],["で"],["すら"],["、"],["あなた"],["がた"],["は"],["主に","しゅに"],["そむいた"],["。"],["まして"],["わたし"],["が"],["死んだ","しんだ"],["あと"],["は"],["どんな"],["で"],["あろう"],["。"]]},{"verse":28,"text":"あなたがたの部族,ぶぞくのすべての長老,ちょうろうたちと、つかさたちをわたしのもとに集,あつめなさい。わたしはこれらの言葉,ことばを彼,かれらに語,かたり聞,きかせ、天,てんと地,ちとを呼,よんで彼,かれらにむかってあかしさせよう。","tok":[["あなた"],["がた"],["の"],["部族","ぶぞく"],["の"],["すべて"],["の"],["長老","ちょうろう"],["たち"],["と"],["、"],["つかさ"],["たち"],["を"],["わたし"],["の"],["もと"],["に"],["集め","あつめ"],["なさい"],["。"],["わたし"],["は"],["これ"],["ら"],["の"],["言葉","ことば"],["を"],["彼","かれ"],["ら"],["に"],["語り聞かせ","かたりきかせ"],["、"],["天","てん"],["と"],["地","ち"],["と"],["を"],["呼んで","よんで"],["彼","かれ"],["ら"],["に"],["むかって"],["あかしさせよう"],["。"]]},{"verse":29,"text":"わたしは知,しっている。わたしが死,しんだのち、あなたがたは必,かならず悪,わるい事,ことをして、わたしが命,めいじた道,みちを離,はなれる。そして後,のちの日,ひに災,わざわいがあなたがたに臨,のぞむであろう。これは主,しゅの悪,あくと見,みられることを行,おこない、あなたがたのすることをもって主,しゅを怒,いからせるからである」。","tok":[["わたし"],["は"],["知って","しって"],["いる"],["。"],["わたし"],["が"],["死んだ","しんだ"],["のち"],["、"],["あなた"],["がた"],["は"],["必","かならず"],["悪い","わるい"],["事","こと"],["を"],["して"],["、"],["わたし"],["が"],["命じた","めいじた"],["道","みち"],["を"],["離れる","はなれる"],["。"],["そして"],["後","のち"],["の"],["日","ひ"],["に"],["災","わざわい"],["が"],["あなた"],["がた"],["に"],["臨むで","のぞむで"],["あろう"],["。"],["これ"],["は"],["主","しゅ"],["の"],["悪","あく"],["と"],["見られる","みられる"],["こと"],["を"],["行ない","おこない"],["、"],["あなた"],["がた"],["の"],["する"],["こと"],["を"],["もって"],["主","しゅ"],["を"],["怒らせる","いからせる"],["から"],["で"],["ある"],["」"],["。"]]},{"verse":30,"text":"そしてモーセはイスラエルの全,ぜん会衆,かいしゅうに次,つぎの歌,うたの言葉,ことばを、ことごとく語,かたり聞,きかせた。","tok":[["そして"],["モーセ"],["は"],["イスラエル"],["の"],["全","ぜん"],["会衆","かいしゅう"],["に"],["次","つぎ"],["の"],["歌","うた"],["の"],["言葉","ことば"],["を"],["、"],["ことごとく"],["語り聞かせた","かたりきかせた"],["。"]]}]
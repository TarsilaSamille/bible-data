[{"verse":1,"text":"あなたが敵,てきと戦,たたかうために出,でる時,とき、馬,うまと戦車,せんしゃと、あなたよりも大,だいぜいの軍隊,ぐんたいを見,みても、彼,かれらを恐,おそれてはならない。あなたをエジプトの国,くにから導,みちびきのぼられたあなたの神,かみ、主,しゅが共,ともにおられるからである。","tok":[["あなた"],["が"],["敵","てき"],["と"],["戦う","たたかう"],["ため"],["に"],["出る","でる"],["時","とき"],["、"],["馬","うま"],["と"],["戦車","せんしゃ"],["と"],["、"],["あなた"],["より"],["も"],["大ぜい","だいぜい"],["の"],["軍隊","ぐんたい"],["を"],["見て","みて"],["も"],["、"],["彼","かれ"],["ら"],["を"],["恐れて","おそれて"],["は"],["ならない"],["。"],["あなた"],["を"],["エジプト"],["の"],["国","くに"],["から"],["導き","みちびき"],["のぼられた"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["共","とも"],["に"],["おられる"],["から"],["で"],["ある"],["。"]]},{"verse":2,"text":"あなたがたが戦,たたかいに臨,のぞむとき、祭司,さいしは進,すすみ出,でて民,たみに告,つげて、","tok":[["あなた"],["がた"],["が"],["戦い","たたかい"],["に"],["臨む","のぞむ"],["とき"],["、"],["祭司","さいし"],["は"],["進み出て","すすみでて"],["民","たみ"],["に"],["告","つげ"],["て"],["、"]]},{"verse":3,"text":"彼,かれらに言,いわなければならない、『イスラエルよ聞,きけ。あなたがたは、きょう、敵,てきと戦,たたかおうとしている。気,きおくれしてはならない。恐,おそれてはならない。あわててはならない。彼,かれらに驚,おどろいてはならない。","tok":[["彼","かれ"],["ら"],["に"],["言わなければ","いわなければ"],["ならない"],["、"],["『"],["イスラエル"],["よ"],["聞け","きけ"],["。"],["あなた"],["がた"],["は"],["、"],["きょう"],["、"],["敵","てき"],["と"],["戦おう","たたかおう"],["として"],["いる"],["。"],["気おくれ","きおくれ"],["して"],["は"],["ならない"],["。"],["恐れて","おそれて"],["は"],["ならない"],["。"],["あわてて"],["は"],["ならない"],["。"],["彼","かれ"],["ら"],["に"],["驚ろいて","おどろいて"],["は"],["ならない"],["。"]]},{"verse":4,"text":"あなたがたの神,かみ、主,しゅが共,ともに行,いかれ、あなたがたのために敵,てきと戦,たたかって、あなたがたを救,すくわれるからである』。","tok":[["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["共","とも"],["に"],["行かれ","いかれ"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["敵","てき"],["と"],["戦って","たたかって"],["、"],["あなた"],["がた"],["を"],["救われる","すくわれる"],["から"],["で"],["ある"],["』"],["。"]]},{"verse":5,"text":"次,つぎにつかさたちは民,たみに告,つげて言,いわなければならない。『新,あたらしい家,いえを建,たてて、まだそれをささげていない者,ものがあれば、その人,ひとを家,いえに帰,かえらせなければならない。そうしなければ、彼,かれが戦,たたかいに死,しんだとき、ほかの人,ひとがそれをささげるようになるであろう。","tok":[["次","つぎ"],["に"],["つかさ"],["たち"],["は"],["民","たみ"],["に"],["告","つげ"],["て"],["言わなければ","いわなければ"],["ならない"],["。"],["『"],["新らしい","あたらしい"],["家","いえ"],["を"],["建てて","たてて"],["、"],["まだ"],["それ"],["を"],["ささげて"],["いない"],["者","もの"],["が"],["あれば"],["、"],["その"],["人","ひと"],["を"],["家","いえ"],["に"],["帰えらせなければ","かえらせなければ"],["ならない"],["。"],["そう"],["しなければ"],["、"],["彼","かれ"],["が"],["戦い","たたかい"],["に"],["死んだ","しんだ"],["とき"],["、"],["ほか"],["の"],["人","ひと"],["が"],["それ"],["を"],["ささげる"],["よう"],["に"],["なるで"],["あろう"],["。"]]},{"verse":6,"text":"ぶどう畑,はたけを作,つくって、まだその実,みを食,たべていない者,ものがあれば、その人,ひとを家,いえに帰,かえらせなければならない。そうしなければ彼,かれが戦,たたかいに死,しんだとき、ほかの人,ひとがそれを食,たべるようになるであろう。","tok":[["ぶどう"],["畑","はたけ"],["を"],["作って","つくって"],["、"],["まだ"],["その"],["実","み"],["を"],["食べて","たべて"],["いない"],["者","もの"],["が"],["あれば"],["、"],["その"],["人","ひと"],["を"],["家","いえ"],["に"],["帰えらせなければ","かえらせなければ"],["ならない"],["。"],["そう"],["しなければ"],["彼","かれ"],["が"],["戦い","たたかい"],["に"],["死んだ","しんだ"],["とき"],["、"],["ほか"],["の"],["人","ひと"],["が"],["それ"],["を"],["食べる","たべる"],["よう"],["に"],["なるで"],["あろう"],["。"]]},{"verse":7,"text":"女,おんなと婚約,こんやくして、まだその女,おんなをめとっていない者,ものがあれば、その人,ひとを家,いえに帰,かえらせなければならない。そうしなければ彼,かれが戦,たたかいに死,しんだとき、ほかの人,ひとが彼女,かのじょをめとるようになるであろう』。","tok":[["女","おんな"],["と"],["婚約","こんやく"],["して"],["、"],["まだ"],["その"],["女","おんな"],["を"],["めとって"],["いない"],["者","もの"],["が"],["あれば"],["、"],["その"],["人","ひと"],["を"],["家","いえ"],["に"],["帰えらせなければ","かえらせなければ"],["ならない"],["。"],["そう"],["しなければ"],["彼","かれ"],["が"],["戦い","たたかい"],["に"],["死んだ","しんだ"],["とき"],["、"],["ほか"],["の"],["人","ひと"],["が"],["彼女","かのじょ"],["を"],["めとる"],["よう"],["に"],["なるで"],["あろう"],["』"],["。"]]},{"verse":8,"text":"つかさたちは、また民,たみに告,つげて言,いわなければならない。『恐,おそれて気,きおくれする者,ものがあるならば、その人,ひとを家,いえに帰,かえらせなければならない。そうしなければ、兄弟,きょうだいたちの心,こころが彼,かれの心,こころのようにくじけるであろう』。","tok":[["つかさ"],["たち"],["は"],["、"],["また"],["民","たみ"],["に"],["告","つげ"],["て"],["言わなければ","いわなければ"],["ならない"],["。"],["『"],["恐れて","おそれて"],["気おくれ","きおくれ"],["する"],["者","もの"],["が"],["あるならば"],["、"],["その"],["人","ひと"],["を"],["家","いえ"],["に"],["帰えらせなければ","かえらせなければ"],["ならない"],["。"],["そう"],["しなければ"],["、"],["兄弟","きょうだい"],["たち"],["の"],["心","こころ"],["が"],["彼","かれ"],["の"],["心","こころ"],["の"],["よう"],["に"],["くじけるで"],["あろう"],["』"],["。"]]},{"verse":9,"text":"つかさたちがこのように民,たみに告,つげ終,おわったならば、軍勢,ぐんぜいのかしらたちを立,たてて民,たみを率,ひきいさせなければならない。","tok":[["つかさ"],["たち"],["が"],["この"],["よう"],["に"],["民","たみ"],["に"],["告","つげ"],["終わったならば","おわったならば"],["、"],["軍勢","ぐんぜい"],["の"],["かしら"],["たち"],["を"],["立てて","たてて"],["民","たみ"],["を"],["率いさせなければ","ひきいさせなければ"],["ならない"],["。"]]},{"verse":10,"text":"一つの町,まちへ進,すすんで行,いって、それを攻,せめようとする時,ときは、まず穏,おだやかに降服,こうふくすることを勧,すすめなければならない。","tok":[["一","ひと"],["つ"],["の"],["町","まち"],["へ"],["進んで","すすんで"],["行って","いって"],["、"],["それ"],["を"],["攻めよう","せめよう"],["と"],["する"],["時","とき"],["は"],["、"],["まず"],["穏","おだやか"],["に"],["降服","こうふく"],["する"],["こと"],["を"],["勧めなければ","すすめなければ"],["ならない"],["。"]]},{"verse":11,"text":"もしその町,まちが穏,おだやかに降服,こうふくしようと答,こたえて、門,もんを開,ひらくならば、そこにいるすべての民,たみに、みつぎを納,おさめさせ、あなたに仕,つかえさせなければならない。","tok":[["もし"],["その"],["町","まち"],["が"],["穏","おだやか"],["に"],["降服","こうふく"],["しよう"],["と"],["答","こたえ"],["て"],["、"],["門","もん"],["を"],["開らくならば","ひらくならば"],["、"],["そこ"],["に"],["いる"],["すべて"],["の"],["民","たみ"],["に"],["、"],["みつぎ"],["を"],["納","おさめ"],["させ"],["、"],["あなた"],["に"],["仕えさせなければ","つかえさせなければ"],["ならない"],["。"]]},{"verse":12,"text":"もし穏,おだやかに降服,こうふくせず、戦,たたかおうとするならば、あなたはそれを攻,せめなければならない。","tok":[["もし"],["穏","おだやか"],["に"],["降服","こうふく"],["せず"],["、"],["戦おう","たたかおう"],["と"],["するならば"],["、"],["あなた"],["は"],["それ"],["を"],["攻めなければ","せめなければ"],["ならない"],["。"]]},{"verse":13,"text":"そしてあなたの神,かみ、主,しゅがそれをあなたの手,てにわたされる時,とき、つるぎをもってそのうちの男,おとこをみな撃,うち殺,ころさなければならない。","tok":[["そして"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅがそれ"],["を"],["あなた"],["の"],["手","て"],["に"],["わたされる"],["時","とき"],["、"],["つるぎ"],["を"],["もって"],["その"],["うち"],["の"],["男","おとこ"],["を"],["みな"],["撃ち","うち"],["殺ろさなければ","ころさなければ"],["ならない"],["。"]]},{"verse":14,"text":"ただし女,おんな、子供,こども、家畜,かちくおよびすべて町,まちのうちにあるもの、すなわちぶんどり物,ものは皆,みな、戦利,せんり品,ひんとして取,とることができる。また敵,てきからぶんどった物,ものはあなたの神,かみ、主,しゅが賜,たまわったものだから、あなたはそれを用,もちいることができる。","tok":[["ただし"],["女","おんな"],["、"],["子供","こども"],["、"],["家畜","かちく"],["および"],["すべて"],["町","まち"],["の"],["うち"],["に"],["ある"],["もの"],["、"],["すなわち"],["ぶんどり"],["物","もの"],["は"],["皆","みな"],["、"],["戦利品","せんりひん"],["として"],["取る","とる"],["こと"],["が"],["できる"],["。"],["また"],["敵","てき"],["から"],["ぶんどった"],["物","もの"],["は"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["賜わった","たまわった"],["もの"],["だ"],["から"],["、"],["あなた"],["は"],["それ"],["を"],["用いる","もちいる"],["こと"],["が"],["できる"],["。"]]},{"verse":15,"text":"遠,とおく離,はなれている町々,まちまち、すなわちこれらの国々,くにぐにに属,ぞくさない町々,まちまちには、すべてこのようにしなければならない。","tok":[["遠く","とおく"],["離れて","はなれて"],["いる"],["町々","まちまち"],["、"],["すなわち"],["これ"],["ら"],["の"],["国々","くにぐに"],["に"],["属さない","ぞくさない"],["町々","まちまち"],["に"],["は"],["、"],["すべて"],["この"],["よう"],["に"],["しなければ"],["ならない"],["。"]]},{"verse":16,"text":"ただし、あなたの神,かみ、主,しゅが嗣,し業,ぎょうとして与,あたえられるこれらの民,たみの町々,まちまちでは、息,いきのある者,ものをひとりも生,いかしておいてはならない。","tok":[["ただし"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["嗣業","しぎょう"],["として"],["与えられる","あたえられる"],["これ"],["ら"],["の"],["民","たみ"],["の"],["町々","まちまち"],["で"],["は"],["、"],["息","いき"],["の"],["ある"],["者","もの"],["を"],["ひとり"],["も"],["生かして","いかして"],["おいて"],["は"],["ならない"],["。"]]},{"verse":17,"text":"すなわちヘテびと、アモリびと、カナンびと、ペリジびと、ヒビびと、エブスびとはみな滅,ほろぼして、あなたの神,かみ、主,しゅが命,めいじられたとおりにしなければならない。","tok":[["すなわち"],["ヘテ"],["び"],["と"],["、"],["アモリ"],["び"],["と"],["、"],["カナン"],["び"],["と"],["、"],["ペリジ"],["び"],["と"],["、"],["ヒビ"],["び"],["と"],["、"],["エブス"],["びと"],["は"],["みな"],["滅ぼして","ほろぼして"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["命じられた","めいじられた"],["とおり"],["に"],["しなければ"],["ならない"],["。"]]},{"verse":18,"text":"これは彼,かれらがその神々,かみがみを拝,おがんでおこなったすべての憎,にくむべき事,ことを、あなたがたに教,おしえて、それを行,おこなわせ、あなたがたの神,かみ、主,しゅに罪,つみを犯,おかさせることのないためである。","tok":[["これ"],["は"],["彼","かれ"],["ら"],["が"],["その"],["神々","かみがみ"],["を"],["拝んで","おがんで"],["おこなった"],["すべて"],["の"],["憎むべき","にくむべき"],["事","こと"],["を"],["、"],["あなた"],["がた"],["に"],["教えて","おしえて"],["、"],["それ"],["を"],["行なわせ","おこなわせ"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主に","しゅに"],["罪","つみ"],["を"],["犯させる","おかさせる"],["こと"],["の"],["ない"],["ため"],["で"],["ある"],["。"]]},{"verse":19,"text":"長,ながく町,まちを攻,せめ囲,かこんで、それを取,とろうとする時,ときでも、おのをふるって、そこの木,きを切,きり枯,からしてはならない。それはあなたの食,しょくとなるものだから、切,きり倒,たおしてはならない。あなたは田野,でんやの木,きまでも、人,ひとのように攻,せめなければならないであろうか。","tok":[["長く","ながく"],["町","まち"],["を"],["攻め囲んで","せめかこんで"],["、"],["それ"],["を"],["取ろう","とろう"],["と"],["する"],["時","とき"],["で"],["も"],["、"],["おの"],["を"],["ふるって"],["、"],["そこ"],["の"],["木","き"],["を"],["切り","きり"],["枯らして","からして"],["は"],["ならない"],["。"],["それ"],["は"],["あなた"],["の"],["食","しょく"],["と"],["なる"],["もの"],["だ"],["から"],["、"],["切り倒して","きりたおして"],["は"],["ならない"],["。"],["あなた"],["は"],["田野","でんや"],["の"],["木","き"],["まで"],["も"],["、"],["人","ひと"],["の"],["よう"],["に"],["攻めなければ","せめなければ"],["ならないで"],["あろう"],["か"],["。"]]},{"verse":20,"text":"ただし実,みを結,むすばない木,きとわかっている木,きは切,きり倒,たおして、あなたと戦,たたかっている町,まちにむかい、それをもってとりでを築,きずき、陥落,かんらくするまで、それを攻,せめることができる。","tok":[["ただし"],["実","み"],["を"],["結ばない","むすばない"],["木","き"],["と"],["わかって"],["いる"],["木","き"],["は"],["切り倒して","きりたおして"],["、"],["あなた"],["と"],["戦って","たたかって"],["いる"],["町","まち"],["に"],["むかい"],["、"],["それ"],["を"],["もって"],["とりで"],["を"],["築き","きずき"],["、"],["陥落","かんらく"],["する"],["まで"],["、"],["それ"],["を"],["攻める","せめる"],["こと"],["が"],["できる"],["。"]]}]
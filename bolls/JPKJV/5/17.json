[{"verse":1,"text":"すべて傷,きずがあり、欠,かけた所,ところのある牛,うしまたは羊,ひつじはあなたの神,かみ、主,しゅにささげてはならない。そのようなものはあなたの神,かみ、主,しゅの忌,いみきらわれるものだからである。","tok":[["すべて"],["傷","きず"],["が"],["あり"],["、"],["欠けた","かけた"],["所","ところ"],["の"],["ある"],["牛","うし"],["また"],["は"],["羊","ひつじ"],["は"],["あなた"],["の"],["神","かみ"],["、"],["主に","しゅに"],["ささげて"],["は"],["ならない"],["。"],["その"],["よう"],["な"],["もの"],["は"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["忌","いみ"],["きらわれる"],["もの"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":2,"text":"あなたの神,かみ、主,しゅが賜,たまわる町,まちで、あなたがたのうちに、もし男子,だんしまたは女子,じょしがあなたの神,かみ、主,しゅの前,まえに悪事,あくじをおこなって、契約,けいやくにそむき、","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["賜わる","たまわる"],["町","まち"],["で"],["、"],["あなた"],["がた"],["の"],["うち"],["に"],["、"],["もし"],["男子","だんし"],["また"],["は"],["女子","じょし"],["が"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["悪事","あくじ"],["を"],["おこなって"],["、"],["契約","けいやく"],["に"],["そむき"],["、"]]},{"verse":3,"text":"行,いって他,たの神々,かみがみに仕,つかえ、それを拝,おがみ、わたしの禁,きんじる、日,ひや月,つきやその他,たの天,てんの万象,ばんしょうを拝,おがむことがあり、","tok":[["行って","いって"],["他","た"],["の"],["神々","かみがみ"],["に"],["仕え","つかえ"],["、"],["それ"],["を"],["拝み","おがみ"],["、"],["わたし"],["の"],["禁じる","きんじる"],["、"],["日","ひ"],["や"],["月","つき"],["や"],["その"],["他","た"],["の"],["天","てん"],["の"],["万象","ばんしょう"],["を"],["拝む","おがむ"],["こと"],["が"],["あり"],["、"]]},{"verse":4,"text":"その事,ことを知,しらせる者,ものがあって、あなたがそれを聞,きくならば、あなたはそれをよく調,しらべなければならない。そしてその事,ことが真実,しんじつであり、そのような憎,にくむべき事,ことが確,たしかにイスラエルのうちに行,おこなわれていたならば、","tok":[["その"],["事","こと"],["を"],["知らせる","しらせる"],["者","もの"],["が"],["あって"],["、"],["あなた"],["が"],["それ"],["を"],["聞くならば","きくならば"],["、"],["あなた"],["は"],["それ"],["を"],["よく"],["調べなければ","しらべなければ"],["ならない"],["。"],["そして"],["その"],["事","こと"],["が"],["真実","しんじつ"],["で"],["あり"],["、"],["その"],["よう"],["な"],["憎むべき","にくむべき"],["事","こと"],["が"],["確か","たしか"],["に"],["イスラエル"],["の"],["うち"],["に"],["行なわれて","おこなわれて"],["いたならば"],["、"]]},{"verse":5,"text":"あなたはその悪事,あくじをおこなった男子,だんしまたは女子,じょしを町,まちの門,もんにひき出,だし、その男子,だんしまたは女子,じょしを石,いしで撃,うち殺,ころさなければならない。","tok":[["あなた"],["は"],["その"],["悪事","あくじ"],["を"],["おこなった"],["男子","だんし"],["また"],["は"],["女子","じょし"],["を"],["町","まち"],["の"],["門","もん"],["に"],["ひき出し","ひきだし"],["、"],["その"],["男子","だんし"],["また"],["は"],["女子","じょし"],["を"],["石","いし"],["で"],["撃ち","うち"],["殺ろさなければ","ころさなければ"],["ならない"],["。"]]},{"verse":6,"text":"ふたりの証人,しょうにんまたは三人,にんの証人,しょうにんの証言,しょうげんによって殺,ころすべき者,ものを殺,ころさなければならない。ただひとりの証人,しょうにんの証言,しょうげんによって殺,ころしてはならない。","tok":[["ふたり"],["の"],["証人","しょうにん"],["また"],["は"],["三人","にん"],["の"],["証人","しょうにん"],["の"],["証言","しょうげん"],["によって"],["殺ろすべき","ころすべき"],["者","もの"],["を"],["殺ろさなければ","ころさなければ"],["ならない"],["。"],["ただ"],["ひとり"],["の"],["証人","しょうにん"],["の"],["証言","しょうげん"],["によって"],["殺ろし","ころし"],["ては"],["ならない"],["。"]]},{"verse":7,"text":"そのような者,ものを殺,ころすには、証人,しょうにんがまず手,てを下,くだし、それから民,たみが皆,みな、手,てを下,くださなければならない。こうしてあなたのうちから悪,あくを除,のぞき去,さらなければならない。","tok":[["その"],["よう"],["な"],["者","もの"],["を"],["殺ろす","ころす"],["に"],["は"],["、"],["証人","しょうにん"],["が"],["まず"],["手","て"],["を"],["下し","くだし"],["、"],["それ"],["から"],["民","たみ"],["が"],["皆","みな"],["、"],["手","て"],["を"],["下さなければ","くださなければ"],["ならない"],["。"],["こう"],["して"],["あなた"],["の"],["うち"],["から"],["悪","あく"],["を"],["除き去らなければ","のぞきさらなければ"],["ならない"],["。"]]},{"verse":8,"text":"町,まちの内,うちに訴,うったえ事,ことが起,おこり、その事件,じけんがもし血,ちを流,ながす事,こと、または権利,けんりを争,あらそう事,こと、または人,ひとを撃,うった事,ことなどであって、あなたが、さばきかねるものである時,ときは、立,たってあなたの神,かみ、主,しゅが選,えらばれる場所,ばしょにのぼり、","tok":[["町","まち"],["の"],["内","うち"],["に"],["訴","うったえ"],["事","こと"],["が"],["起こり","おこり"],["、"],["その"],["事件","じけん"],["が"],["もし"],["血","ち"],["を"],["流す","ながす"],["事","こと"],["、"],["また"],["は"],["権利","けんり"],["を"],["争う","あらそう"],["事","こと"],["、"],["また"],["は"],["人","ひと"],["を"],["撃った","うった"],["事","こと"],["など"],["で"],["あって"],["、"],["あなた"],["が"],["、"],["さばき"],["かねる"],["もの"],["で"],["ある"],["時","とき"],["は"],["、"],["立って","たって"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["選ら","えら"],["ばれる"],["場所","ばしょ"],["に"],["のぼり"],["、"]]},{"verse":9,"text":"レビびとである祭司,さいしと、その時,ときの裁判人,さいばんにんとに行,いって尋,たずねなければならない。彼,かれらはあなたに判決,はんけつの言葉,ことばを告,つげるであろう。","tok":[["レビ"],["びと"],["で"],["ある"],["祭司","さいし"],["と"],["、"],["その"],["時","とき"],["の"],["裁判人","さいばんにん"],["と"],["に"],["行って","いって"],["尋ねなければ","たずねなければ"],["ならない"],["。"],["彼","かれ"],["ら"],["は"],["あなた"],["に"],["判決","はんけつ"],["の"],["言葉","ことば"],["を"],["告げるで","つげるで"],["あろう"],["。"]]},{"verse":10,"text":"あなたは、主,しゅが選,えらばれるその場所,ばしょで、彼,かれらが告,つげる言葉,ことばに従,したがっておこない、すべて彼,かれらが教,おしえるように守,まもり行,おこなわなければならない。","tok":[["あなた"],["は"],["、"],["主","しゅ"],["が"],["選ら","えら"],["ばれる"],["その"],["場所","ばしょ"],["で"],["、"],["彼","かれ"],["ら"],["が"],["告げる","つげる"],["言葉","ことば"],["に"],["従って","したがって"],["おこない"],["、"],["すべて"],["彼","かれ"],["ら"],["が"],["教える","おしえる"],["よう"],["に"],["守り","まもり"],["行なわなければ","おこなわなければ"],["ならない"],["。"]]},{"verse":11,"text":"すなわち彼,かれらが教,おしえる律法,りっぽうと、彼,かれらが告,つげる判決,はんけつとに従,したがって行,おこなわなければならない。彼,かれらが告,つげる言葉,ことばにそむいて、右,みぎにも左,ひだりにもかたよってはならない。","tok":[["すなわち"],["彼","かれ"],["ら"],["が"],["教える","おしえる"],["律法","りっぽう"],["と"],["、"],["彼","かれ"],["ら"],["が"],["告げる","つげる"],["判決","はんけつ"],["と"],["に"],["従って","したがって"],["行なわなければ","おこなわなければ"],["ならない"],["。"],["彼","かれ"],["ら"],["が"],["告げる","つげる"],["言葉","ことば"],["に"],["そむいて"],["、"],["右","みぎ"],["に"],["も"],["左","ひだり"],["に"],["も"],["かたよって"],["は"],["ならない"],["。"]]},{"verse":12,"text":"もし人,ひとがほしいままにふるまい、あなたの神,かみ、主,しゅの前,まえに立,たって仕,つかえる祭司,さいしまたは裁判人,さいばんにんに聞,きき従,したがわないならば、その人,ひとを殺,ころして、イスラエルのうちから悪,あくを除,のぞかなければならない。","tok":[["もし"],["人","ひと"],["が"],["ほしいまま"],["に"],["ふるまい"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["立って","たって"],["仕える","つかえる"],["祭司","さいし"],["また"],["は"],["裁判人","さいばんにん"],["に"],["聞","きき"],["従わないならば","したがわないならば"],["、"],["その"],["人","ひと"],["を"],["殺ろして","ころして"],["、"],["イスラエル"],["の"],["うち"],["から"],["悪","あく"],["を"],["除かなければ","のぞかなければ"],["ならない"],["。"]]},{"verse":13,"text":"そうすれば民,たみは皆,みな、聞,きいて恐,おそれ、重,かさねてほしいままにふるまうことをしないであろう。","tok":[["そう"],["すれば"],["民","たみ"],["は"],["皆","みな"],["、"],["聞いて","きいて"],["恐","おそれ"],["、"],["重ねて","かさねて"],["ほしい"],["まま"],["に"],["ふるまう"],["こと"],["を"],["しないで"],["あろう"],["。"]]},{"verse":14,"text":"あなたの神,かみ、主,しゅが賜,たまわる地,ちに行,いき、それを獲,えてそこに住,すむようになる時,とき、もしあなたが『わたしも周囲,しゅういのすべての国,くにびとのように、わたしの上,うえに王,おうを立,たてよう』と言,いうならば、","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["賜わる","たまわる"],["地","ち"],["に"],["行き","いき"],["、"],["それ"],["を"],["獲て","えて"],["そこ"],["に"],["住む","すむ"],["よう"],["に"],["なる"],["時","とき"],["、"],["もし"],["あなた"],["が"],["『"],["わたし"],["も"],["周囲","しゅうい"],["の"],["すべて"],["の"],["国びと","くにびと"],["の"],["よう"],["に"],["、"],["わたし"],["の"],["上","うえ"],["に"],["王","おう"],["を"],["立よう","たてよう"],["』"],["と"],["言うならば","いうならば"],["、"]]},{"verse":15,"text":"必,かならずあなたの神,かみ、主,しゅが選,えらばれる者,ものを、あなたの上,うえに立,たてて王,おうとしなければならない。同胞,どうほうのひとりを、あなたの上,うえに立,たてて王,おうとしなければならない。同胞,どうほうでない外国,がいこく人,じんをあなたの上,うえに立,たててはならない。","tok":[["必","かならず"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["選ら","えら"],["ばれる"],["者","もの"],["を"],["、"],["あなた"],["の"],["上","うえ"],["に"],["立てて","たてて"],["王","おう"],["と"],["しなければ"],["ならない"],["。"],["同胞","どうほう"],["の"],["ひとり"],["を"],["、"],["あなた"],["の"],["上","うえ"],["に"],["立てて","たてて"],["王","おう"],["と"],["しなければ"],["ならない"],["。"],["同胞","どうほう"],["で"],["ない"],["外国人","がいこくじん"],["を"],["あなた"],["の"],["上","うえ"],["に"],["立てて","たてて"],["は"],["ならない"],["。"]]},{"verse":16,"text":"王,おうとなる人,ひとは自分,じぶんのために馬,うまを多,おおく獲,えようとしてはならない。また馬,うまを多,おおく獲,えるために民,たみをエジプトに帰,かえらせてはならない。主,しゅはあなたがたにむかって、『この後,のちかさねてこの道,みちに帰,かえってはならない』と仰,おおせられたからである。","tok":[["王","おう"],["と"],["なる"],["人","ひと"],["は"],["自分","じぶん"],["の"],["ため"],["に"],["馬","うま"],["を"],["多く","おおく"],["獲よう","えよう"],["として"],["は"],["ならない"],["。"],["また"],["馬","うま"],["を"],["多く","おおく"],["獲る","える"],["ため"],["に"],["民","たみ"],["を"],["エジプト"],["に"],["帰えらせて","かえらせて"],["は"],["ならない"],["。"],["主","しゅ"],["は"],["あなた"],["がた"],["に"],["むかって"],["、"],["『"],["この"],["後","の"],["ち"],["かさねて"],["この"],["道","みち"],["に"],["帰えって","かえって"],["は"],["ならない"],["』"],["と"],["仰せられた","おおせられた"],["から"],["で"],["ある"],["。"]]},{"verse":17,"text":"また妻,つまを多,おおく持,もって心,こころを、迷,まよわしてはならない。また自分,じぶんのために金銀,きんぎんを多,おおくたくわえてはならない。","tok":[["また"],["妻","つま"],["を"],["多く","おおく"],["持って","もって"],["心","こころ"],["を"],["、"],["迷わして","まよわして"],["は"],["ならない"],["。"],["また"],["自分","じぶん"],["の"],["ため"],["に"],["金銀","きんぎん"],["を"],["多く","おおく"],["たくわえて"],["は"],["ならない"],["。"]]},{"verse":18,"text":"彼,かれが国,くにの王位,おういにつくようになったら、レビびとである祭司,さいしの保管,ほかんする書物,しょもつから、この律法,りっぽうの写,うつしを一つの書物,しょもつに書,かきしるさせ、","tok":[["彼","かれ"],["が"],["国","くに"],["の"],["王位","おうい"],["に"],["つく"],["よう"],["に"],["なったら"],["、"],["レビ"],["びと"],["で"],["ある"],["祭司","さいし"],["の"],["保管","ほかん"],["する"],["書物","しょもつ"],["から"],["、"],["この"],["律法","りっぽう"],["の"],["写","うつし"],["を"],["一","ひと"],["つ"],["の"],["書物","しょもつ"],["に"],["書きしるさせ","かきしるさせ"],["、"]]},{"verse":19,"text":"世,よに生,いきながらえる日,ひの間,あいだ、常,つねにそれを自分,じぶんのもとに置,おいて読,よみ、こうしてその神,かみ、主,しゅを恐,おそれることを学,まなび、この律法,りっぽうのすべての言葉,ことばと、これらの定,さだめとを守,まもって行,おこなわなければならない。","tok":[["世","よ"],["に"],["生きながらえる","いきながらえる"],["日","ひ"],["の"],["間","あいだ"],["、"],["常","つね"],["に"],["それ"],["を"],["自分","じぶん"],["の"],["もと"],["に"],["置いて","おいて"],["読","よみ"],["、"],["こう"],["して"],["その"],["神","かみ"],["、"],["主","しゅ"],["を"],["恐れる","おそれる"],["こと"],["を"],["学び","まなび"],["、"],["この"],["律法","りっぽう"],["の"],["すべて"],["の"],["言葉","ことば"],["と"],["、"],["これ"],["ら"],["の"],["定め","さだめ"],["と"],["を"],["守って","まもって"],["行なわなければ","おこなわなければ"],["ならない"],["。"]]},{"verse":20,"text":"そうすれば彼,かれの心,こころが同胞,どうほうを見,みくだして、高,たかぶることなく、また戒,いましめを離,はなれて、右,みぎにも左,ひだりにも曲,まがることなく、その子孫,しそんと共,ともにイスラエルにおいて、長,ながくその位,くらいにとどまることができるであろう。","tok":[["そう"],["すれば"],["彼","かれ"],["の"],["心","こころ"],["が"],["同胞","どうほう"],["を"],["見くだして","みくだして"],["、"],["高か","たか"],["ぶる"],["こと"],["なく"],["、"],["また"],["戒しめ","いましめ"],["を"],["離れて","はなれて"],["、"],["右","みぎ"],["に"],["も"],["左","ひだり"],["に"],["も"],["曲がる","まがる"],["こと"],["なく"],["、"],["その"],["子孫","しそん"],["と"],["共","とも"],["に"],["イスラエル"],["に"],["おいて"],["、"],["長く","ながく"],["その"],["位","くらい"],["に"],["とどまる"],["こと"],["が"],["できるで"],["あろう"],["。"]]}]
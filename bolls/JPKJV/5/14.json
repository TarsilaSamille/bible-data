[{"verse":1,"text":"あなたがたはあなたがたの神,かみ、主,しゅの子供,こどもである。死,しんだ人,ひとのために自分,じぶんの身,みに傷,きずをつけてはならない。また額,ひたいの髪,かみをそってはならない。","tok":[["あなた"],["がた"],["は"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["子供","こども"],["で"],["ある"],["。"],["死んだ","しんだ"],["人","ひと"],["の"],["ため"],["に"],["自分","じぶん"],["の"],["身","み"],["に"],["傷","きず"],["を"],["つけて"],["は"],["ならない"],["。"],["また"],["額","ひたい"],["の"],["髪","かみ"],["を"],["そって"],["は"],["ならない"],["。"]]},{"verse":2,"text":"あなたはあなたの神,かみ、主,しゅの聖,せいなる民,たみだからである。主,しゅは地,ちのおもてのすべての民,たみのうちからあなたを選,えらんで、自分,じぶんの宝,たからの民,たみとされた。","tok":[["あなた"],["は"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["聖","せい"],["なる"],["民","たみ"],["だ"],["から"],["で"],["ある"],["。"],["主","しゅ"],["は"],["地","ち"],["の"],["おもて"],["の"],["すべて"],["の"],["民","たみ"],["の"],["うち"],["から"],["あなた"],["を"],["選らんで","えらんで"],["、"],["自分","じぶん"],["の"],["宝","たから"],["の"],["民","たみ"],["と"],["された"],["。"]]},{"verse":3,"text":"忌,いむべき物,ものは、どんなものでも食,たべてはならない。","tok":[["忌むべき","いむべき"],["物","もの"],["は"],["、"],["どんな"],["もの"],["で"],["も"],["食べて","たべて"],["は"],["ならない"],["。"]]},{"verse":4,"text":"あなたがたの食,たべることができる獣,けものは次,つぎのとおりである。すなわち牛,うし、羊,ひつじ、やぎ、","tok":[["あなた"],["がた"],["の"],["食べる","たべる"],["こと"],["が"],["できる"],["獣","けもの"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["すなわち"],["牛","うし"],["、"],["羊","ひつじ"],["、"],["やぎ"],["、"]]},{"verse":5,"text":"雄,おじか、かもしか、こじか、野,のやぎ、くじか、おおじか、野羊,やぎなど、","tok":[["雄","お"],["じか"],["、"],["かもしか"],["、"],["こじ"],["か"],["、"],["野やぎ","のやぎ"],["、"],["くじ"],["か"],["、"],["おおじ"],["か"],["、"],["野羊","やぎ"],["など"],["、"]]},{"verse":6,"text":"獣,けもののうち、すべて、ひずめの分,わかれたもの、ひずめが二つに切,きれたもので、反芻,はんすうするものは食,たべることができる。","tok":[["獣","けもの"],["の"],["うち"],["、"],["すべて"],["、"],["ひずめ"],["の"],["分かれた","わかれた"],["もの"],["、"],["ひずめ"],["が"],["二","ふた"],["つ"],["に"],["切れた","きれた"],["もの"],["で"],["、"],["反芻","はんすう"],["する"],["もの"],["は"],["食べる","たべる"],["こと"],["が"],["できる"],["。"]]},{"verse":7,"text":"ただし、反芻,はんすうするものと、ひずめの分,わかれたもののうち、次,つぎのものは食,たべてはならない。すなわち、らくだ、野,のうさぎ、および岩,いわだぬき、これらは反芻,はんすうするけれども、ひずめが分,わかれていないから汚,けがれたものである。","tok":[["ただし"],["、"],["反芻","はんすう"],["する"],["もの"],["と"],["、"],["ひずめ"],["の"],["分かれた","わかれた"],["もの"],["の"],["うち"],["、"],["次","つぎ"],["の"],["もの"],["は"],["食べて","たべて"],["は"],["ならない"],["。"],["すなわち"],["、"],["らく"],["だ"],["、"],["野うさぎ","のうさぎ"],["、"],["および"],["岩","いわ"],["だ"],["ぬき"],["、"],["これ"],["ら"],["は"],["反芻","はんすう"],["する"],["けれど"],["も"],["、"],["ひずめ"],["が"],["分かれて","わかれて"],["いない"],["から"],["汚","けがれたも"],["ので"],["ある"],["。"]]},{"verse":8,"text":"また豚,ぶた、これは、ひずめが分,わかれているけれども、反芻,はんすうしないから、汚,けがれたものである。その肉,にくを食,たべてはならない。またその死体,したいに触,ふれてはならない。","tok":[["また"],["豚","ぶた"],["、"],["これ"],["は"],["、"],["ひずめ"],["が"],["分かれて","わかれて"],["いる"],["けれど"],["も"],["、"],["反芻","はんすう"],["しない"],["から"],["、"],["汚","けがれたも"],["ので"],["ある"],["。"],["その"],["肉","にく"],["を"],["食べて","たべて"],["は"],["ならない"],["。"],["また"],["その"],["死体","したい"],["に"],["触","ふれ"],["ては"],["ならない"],["。"]]},{"verse":9,"text":"水,みずの中,なかにいるすべての物,もののうち、次,つぎのものは食,たべることができる。すなわち、すべて、ひれと、うろこのあるものは、食,たべることができる。","tok":[["水","みず"],["の"],["中","なか"],["に"],["いる"],["すべて"],["の"],["物","もの"],["の"],["うち"],["、"],["次","つぎ"],["の"],["もの"],["は"],["食べる","たべる"],["こと"],["が"],["できる"],["。"],["すなわち"],["、"],["すべて"],["、"],["ひれ"],["と"],["、"],["うろこ"],["の"],["ある"],["もの"],["は"],["、"],["食べる","たべる"],["こと"],["が"],["できる"],["。"]]},{"verse":10,"text":"すべて、ひれと、うろこのないものは、食,たべてはならない。これは汚,けがれたものである。","tok":[["すべて"],["、"],["ひれ"],["と"],["、"],["うろこ"],["の"],["ない"],["もの"],["は"],["、"],["食べて","たべて"],["は"],["ならない"],["。"],["これ"],["は"],["汚","けがれたも"],["ので"],["ある"],["。"]]},{"verse":11,"text":"すべて清,きよい鳥,とりは食,たべることができる。","tok":[["すべて"],["清い","きよい"],["鳥","とり"],["は"],["食べる","たべる"],["こと"],["が"],["できる"],["。"]]},{"verse":12,"text":"ただし、次,つぎのものは食,たべてはならない。すなわち、はげわし、ひげはげわし、みさご、","tok":[["ただし"],["、"],["次","つぎ"],["の"],["もの"],["は"],["食べて","たべて"],["は"],["ならない"],["。"],["すなわち"],["、"],["はげわし"],["、"],["ひげ"],["はげわし"],["、"],["みさご"],["、"]]},{"verse":13,"text":"黒,くろとび、はやぶさ、とびの類,るい。","tok":[["黒","くろ"],["とび"],["、"],["はやぶさ"],["、"],["とび"],["の"],["類","るい"],["。"]]},{"verse":14,"text":"各種,かくしゅのからすの類,るい。","tok":[["各種","かくしゅ"],["の"],["からす"],["の"],["類","るい"],["。"]]},{"verse":15,"text":"だちょう、夜,よるたか、かもめ、たかの類,るい。","tok":[["だちょう"],["、"],["夜たか","よるたか"],["、"],["かもめ"],["、"],["たか"],["の"],["類","るい"],["。"]]},{"verse":16,"text":"ふくろう、みみずく、むらさきばん、","tok":[["ふくろう"],["、"],["みみずく"],["、"],["むらさき"],["ばん"],["、"]]},{"verse":17,"text":"ペリカン、はげたか、う、","tok":[["ペリカン"],["、"],["はげたか"],["、"],["う"],["、"]]},{"verse":18,"text":"こうのとり、さぎの類,るい。やつがしら、こうもり。","tok":[["こうのとり"],["、"],["さぎ"],["の"],["類","るい"],["。"],["やつ"],["が"],["しら"],["、"],["こうもり"],["。"]]},{"verse":19,"text":"またすべて羽,はねがあって這,はうものは汚,けがれたものである。それを食,たべてはならない。","tok":[["また"],["すべて羽","すべてはね"],["が"],["あって"],["這う","はう"],["もの"],["は"],["汚","けがれたも"],["ので"],["ある"],["。"],["それ"],["を"],["食べて","たべて"],["は"],["ならない"],["。"]]},{"verse":20,"text":"すべて翼,つばさのある清,きよいものは食,たべることができる。","tok":[["すべて"],["翼","つばさ"],["の"],["ある"],["清い","きよい"],["もの"],["は"],["食べる","たべる"],["こと"],["が"],["できる"],["。"]]},{"verse":21,"text":"すべて自然,しぜんに死,しんだものは食,たべてはならない。町,まちの内,うちにおる寄留,きりゅうの他国,たこく人,じんに、それを与,あたえて食,たべさせることができる。またそれを外国,がいこく人,じんに売,うってもよい。あなたはあなたの神,かみ、主,しゅの聖,せいなる民,たみだからである。子,こやぎをその母,ははの乳,ちちで煮,にてはならない。","tok":[["すべて"],["自然","しぜん"],["に"],["死んだ","しんだ"],["もの"],["は"],["食べて","たべて"],["は"],["ならない"],["。"],["町","まち"],["の"],["内","うち"],["に"],["おる"],["寄留","きりゅう"],["の"],["他国人","たこくじん"],["に"],["、"],["それ"],["を"],["与","あたえ"],["て"],["食べさせる","たべさせる"],["こと"],["が"],["できる"],["。"],["また"],["それ"],["を"],["外国人","がいこくじん"],["に"],["売って","うって"],["も"],["よい"],["。"],["あなた"],["は"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["聖","せい"],["なる"],["民","たみ"],["だ"],["から"],["で"],["ある"],["。"],["子やぎ","こやぎ"],["を"],["その"],["母","はは"],["の"],["乳","ちち"],["で"],["煮て","にて"],["は"],["ならない"],["。"]]},{"verse":22,"text":"あなたは毎年,まいとし、畑,はたけに種,たねをまいて獲,えるすべての産物,さんぶつの十分,ぶんの一を必,かならず取,とり分,わけなければならない。","tok":[["あなた"],["は"],["毎年","まいとし"],["、"],["畑","はたけ"],["に"],["種","たね"],["を"],["まいて"],["獲る","える"],["すべて"],["の"],["産物","さんぶつ"],["の"],["十分","ぶん"],["の"],["一","いち"],["を"],["必","かならず"],["取分けなければ","とりわけなければ"],["ならない"],["。"]]},{"verse":23,"text":"そしてあなたの神,かみ、主,しゅの前,まえ、すなわち主,しゅがその名,なを置,おくために選,えらばれる場所,ばしょで、穀物,こくもつと、ぶどう酒,しゅと、油,あぶらとの十分,ぶんの一と、牛,うし、羊,ひつじのういごを食,たべ、こうして常,つねにあなたの神,かみ、主,しゅを恐,おそれることを学,まなばなければならない。","tok":[["そして"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["前","まえ"],["、"],["すなわち"],["主","しゅがそ"],["の"],["名","な"],["を"],["置く","おく"],["ため"],["に"],["選ら","えら"],["ばれる"],["場所","ばしょ"],["で"],["、"],["穀物","こくもつ"],["と"],["、"],["ぶどう酒","ぶどうしゅ"],["と"],["、"],["油","あぶら"],["と"],["の"],["十分","ぶん"],["の"],["一","いち"],["と"],["、"],["牛","うし"],["、"],["羊","ひつじ"],["の"],["うい"],["ご"],["を"],["食べ","たべ"],["、"],["こう"],["して"],["常","つね"],["に"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["を"],["恐れる","おそれる"],["こと"],["を"],["学ばなければ","まなばなければ"],["ならない"],["。"]]},{"verse":24,"text":"ただし、その道,みちがあまりに遠,とおく、あなたの神,かみ、主,しゅがその名,なを置,おくために選,えらばれる場所,ばしょが、非常,ひじょうに遠,とおく離,はなれていて、あなたの神,かみ、主,しゅがあなたを恵,めぐまれるとき、それを携,たずさえて行,いくことができないならば、","tok":[["ただし"],["、"],["その"],["道","みち"],["が"],["あまり"],["に"],["遠く","とおく"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅがそ"],["の"],["名","な"],["を"],["置く","おく"],["ため"],["に"],["選ら","えら"],["ばれる"],["場所","ばしょ"],["が"],["、"],["非常","ひじょう"],["に"],["遠く","とおく"],["離れて","はなれて"],["いて"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["あなた"],["を"],["恵れる","めぐまれる"],["とき"],["、"],["それ"],["を"],["携えて","たずさえて"],["行く","いく"],["こと"],["が"],["できないならば"],["、"]]},{"verse":25,"text":"あなたはその物,ものを金,かねに換,かえ、その金,かねを包,つつんで手,てに取,とり、あなたの神,かみ、主,しゅが選,えらばれる場所,ばしょに行,いき、","tok":[["あなた"],["は"],["その"],["物","もの"],["を"],["金","かね"],["に"],["換","かえ"],["、"],["その"],["金","かね"],["を"],["包んで","つつんで"],["手","て"],["に"],["取","とり"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["選ら","えら"],["ばれる"],["場所","ばしょ"],["に"],["行き","いき"],["、"]]},{"verse":26,"text":"その金,かねをすべてあなたの好,このむ物,ものに換,かえなければならない。すなわち牛,うし、羊,ひつじ、ぶどう酒,しゅ、濃,こい酒,さけなど、すべてあなたの欲,ほっする物,ものに換,かえ、その所,ところであなたの神,かみ、主,しゅの前,まえでそれを食,たべ、家族,かぞくと共,ともに楽,たのしまなければならない。","tok":[["その"],["金","かね"],["を"],["すべて"],["あなた"],["の"],["好む","このむ"],["物","もの"],["に"],["換","かえ"],["なければ"],["ならない"],["。"],["すなわち"],["牛","うし"],["、"],["羊","ひつじ"],["、"],["ぶどう酒","ぶどうしゅ"],["、"],["濃い","こい"],["酒","さけ"],["など"],["、"],["すべて"],["あなた"],["の"],["欲する","ほっする"],["物","もの"],["に"],["換","かえ"],["、"],["その"],["所","ところ"],["で"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["前","まえ"],["で"],["それ"],["を"],["食べ","たべ"],["、"],["家族","かぞく"],["と"],["共","とも"],["に"],["楽しまなければ","たのしまなければ"],["ならない"],["。"]]},{"verse":27,"text":"町,まちの内,うちにおるレビびとを捨,すててはならない。彼,かれはあなたがたのうちに分,ぶんがなく、嗣,し業,ぎょうを持,もたない者,ものだからである。","tok":[["町","まち"],["の"],["内","うち"],["に"],["おる"],["レビ"],["びと"],["を"],["捨てて","すてて"],["は"],["ならない"],["。"],["彼","かれ"],["は"],["あなた"],["がた"],["の"],["うち"],["に"],["分","ぶん"],["が"],["なく"],["、"],["嗣業","しぎょう"],["を"],["持たない","もたない"],["者","もの"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":28,"text":"三年,ねんの終,おわりごとに、その年,としの産物,さんぶつの十分,ぶんの一を、ことごとく持,もち出,だして、町,まちの内,うちにたくわえ、","tok":[["三","さん"],["年","ねん"],["の"],["終","おわり"],["ごと"],["に"],["、"],["その"],["年","とし"],["の"],["産物","さんぶつ"],["の"],["十分","ぶん"],["の"],["一","いち"],["を"],["、"],["ことごとく"],["持出して","もちだして"],["、"],["町","まち"],["の"],["内","うち"],["に"],["たくわえ"],["、"]]},{"verse":29,"text":"あなたがたのうちに分,わけ前,まえがなく、嗣,し業,ぎょうを持,もたないレビびと、および町,まちの内,うちにおる寄留,きりゅうの他国,たこく人,じんと、孤児,こじと、寡婦,かふを呼,よんで、それを食,たべさせ、満足,まんぞくさせなければならない。そうすれば、あなたの神,かみ、主,しゅはあなたが手,てで行,おこなうすべての事,ことにあなたを祝福,しゅくふくされるであろう。","tok":[["あなた"],["がた"],["の"],["うち"],["に"],["分け前","わけまえ"],["が"],["なく"],["、"],["嗣業","しぎょう"],["を"],["持たない","もたない"],["レビ"],["び"],["と"],["、"],["および"],["町","まち"],["の"],["内","うち"],["に"],["おる"],["寄留","きりゅう"],["の"],["他国人","たこくじん"],["と"],["、"],["孤児","こじ"],["と"],["、"],["寡婦","かふ"],["を"],["呼んで","よんで"],["、"],["それ"],["を"],["食べさせ","たべさせ"],["、"],["満足","まんぞく"],["させなければ"],["ならない"],["。"],["そう"],["すれば"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["あなた"],["が"],["手","て"],["で"],["行なう","おこなう"],["すべて"],["の"],["事","こと"],["に"],["あなた"],["を"],["祝福","しゅくふく"],["されるで"],["あろう"],["。"]]}]
[{"verse":1,"text":"これはあなたの先祖,せんぞたちの神,かみ、主,しゅが所有,しょゆうとして賜,たまわる地,ちで、あなたがたが世,よに生,いきながらえている間,あいだ、守,まもり行,おこなわなければならない定,さだめと、おきてである。","tok":[["これ"],["は"],["あなた"],["の"],["先祖","せんぞ"],["たち"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["所有","しょゆう"],["として"],["賜わる","たまわる"],["地","ち"],["で"],["、"],["あなた"],["がた"],["が"],["世","よ"],["に"],["生きながらえて","いきながらえて"],["いる"],["間","あいだ"],["、"],["守り","まもり"],["行なわなければ","おこなわなければ"],["ならない"],["定め","さだめ"],["と"],["、"],["おきて"],["で"],["ある"],["。"]]},{"verse":2,"text":"あなたがたの追,おい払,はらう国々,くにぐにの民,たみが、その神々,かみがみに仕,つかえた所,ところは、高,たかい山,やまにあるものも、丘,おかにあるものも、青,あお木,きの下,したにあるものも、ことごとくこわし、","tok":[["あなた"],["がた"],["の"],["追い払う","おいはらう"],["国々","くにぐに"],["の"],["民","たみ"],["が"],["、"],["その"],["神々","かみがみ"],["に"],["仕えた","つかえた"],["所","ところ"],["は"],["、"],["高かい","たかい"],["山","やま"],["に"],["ある"],["もの"],["も"],["、"],["丘","おか"],["に"],["ある"],["もの"],["も"],["、"],["青木","あおき"],["の"],["下","した"],["に"],["ある"],["もの"],["も"],["、"],["ことごとく"],["こわし"],["、"]]},{"verse":3,"text":"その祭壇,さいだんをこぼち、柱,はしらを砕,くだき、アシラ像,ぞうを火,ひで焼,やき、また刻,きざんだ神々,かみがみの像,ぞうを切,きり倒,たおして、その名,なをその所,ところから消,けし去,さらなければならない。","tok":[["その"],["祭壇","さいだん"],["を"],["こ"],["ぼ"],["ち"],["、"],["柱","はしら"],["を"],["砕き","くだき"],["、"],["アシラ"],["像","ぞう"],["を"],["火","ひ"],["で"],["焼き","やき"],["、"],["また"],["刻んだ","きざんだ"],["神々","かみがみ"],["の"],["像","ぞう"],["を"],["切り倒して","きりたおして"],["、"],["その"],["名","な"],["を"],["その"],["所","ところ"],["から"],["消し去らなければ","けしさらなければ"],["ならない"],["。"]]},{"verse":4,"text":"ただし、あなたがたの神,かみ、主,しゅにはそのようにしてはならない。","tok":[["ただし"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["に"],["は"],["その"],["よう"],["に"],["して"],["は"],["ならない"],["。"]]},{"verse":5,"text":"あなたがたの神,かみ、主,しゅがその名,なを置,おくために、あなたがたの全部,ぜんぶ族,ぞくのうちから選,えらばれる場所,ばしょ、すなわち主,しゅのすまいを尋,たずね求,もとめて、そこに行,いき、","tok":[["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅがそ"],["の"],["名","な"],["を"],["置く","おく"],["ため"],["に"],["、"],["あなた"],["がた"],["の"],["全部族","ぜんぶぞく"],["の"],["うち"],["から"],["選ら","えら"],["ばれる"],["場所","ばしょ"],["、"],["すなわち"],["主","しゅ"],["の"],["すまい"],["を"],["尋ね求めて","たずねもとめて"],["、"],["そこ"],["に"],["行き","いき"],["、"]]},{"verse":6,"text":"あなたがたの燔祭,はんさいと、犠牲,ぎせいと、十分,ぶんの一と、ささげ物,ものと、誓願,せいがんの供,そなえ物,ものと、自発,じはつの供,そなえ物,ものおよび牛,うし、羊,ひつじのういごをそこに携,たずさえて行,いって、","tok":[["あなた"],["がた"],["の"],["燔祭","はんさい"],["と"],["、"],["犠牲","ぎせい"],["と"],["、"],["十分","ぶん"],["の"],["一","いち"],["と"],["、"],["ささげ物","ささげもの"],["と"],["、"],["誓願","せいがん"],["の"],["供え物","そなえもの"],["と"],["、"],["自発","じはつ"],["の"],["供え物","そなえもの"],["および"],["牛","うし"],["、"],["羊","ひつじ"],["の"],["うい"],["ご"],["を"],["そこ"],["に"],["携えて","たずさえて"],["行って","いって"],["、"]]},{"verse":7,"text":"そこであなたがたの神,かみ、主,しゅの前,まえで食,たべ、あなたがたも、家族,かぞくも皆,みな、手,てを労,ろうして獲,えるすべての物,ものを喜,よろこび楽,たのしまなければならない。これはあなたの神,かみ、主,しゅの恵,めぐみによって獲,えるものだからである。","tok":[["そこ"],["で"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["前","まえ"],["で"],["食べ","たべ"],["、"],["あなた"],["がた"],["も"],["、"],["家族","かぞく"],["も"],["皆","みな"],["、"],["手","て"],["を"],["労して","ろうして"],["獲る","える"],["すべて"],["の"],["物","もの"],["を"],["喜こび","よろこび"],["楽しまなければ","たのしまなければ"],["ならない"],["。"],["これ"],["は"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["恵","めぐみ"],["によって"],["獲る","える"],["もの"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":8,"text":"そこでは、われわれがきょうここでしているように、めいめいで正,ただしいと思,おもうようにふるまってはならない。","tok":[["そこ"],["で"],["は"],["、"],["われわれ"],["が"],["きょう"],["ここ"],["でして"],["いる"],["よう"],["に"],["、"],["めいめい"],["で"],["正い","ただしい"],["と"],["思う","おもう"],["よう"],["に"],["ふるまって"],["は"],["ならない"],["。"]]},{"verse":9,"text":"あなたがたはまだ、あなたがたの神,かみ、主,しゅから賜,たまわる安息,あんそくと嗣,し業,ぎょうの地,ちに、はいっていないのである。","tok":[["あなた"],["がた"],["は"],["まだ"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主ら","しゅから"],["賜わる","たまわる"],["安息","あんそく"],["と"],["嗣業","しぎょう"],["の"],["地","ち"],["に"],["、"],["はいって"],["いない"],["ので"],["ある"],["。"]]},{"verse":10,"text":"しかし、あなたがたがヨルダンを渡,わたり、あなたがたの神,かみ、主,しゅが嗣,し業,ぎょうとして賜,たまわる地,ちに住,すむようになり、さらに主,しゅがあなたがたの周囲,しゅういの敵,てきをことごとく除,のぞいて、安息,あんそくを与,あたえ、あなたがたが安,やすらかに住,すむようになる時,とき、","tok":[["しかし"],["、"],["あなた"],["がた"],["が"],["ヨルダン"],["を"],["渡り","わたり"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["嗣業","しぎょう"],["として"],["賜わる","たまわる"],["地","ち"],["に"],["住む","すむ"],["よう"],["に"],["なり"],["、"],["さらに"],["主","しゅ"],["が"],["あなた"],["がた"],["の"],["周囲","しゅうい"],["の"],["敵","てき"],["を"],["ことごとく"],["除いて","のぞいて"],["、"],["安息","あんそく"],["を"],["与","あたえ"],["、"],["あなた"],["がた"],["が"],["安らか","やすらか"],["に"],["住む","すむ"],["よう"],["に"],["なる"],["時","とき"],["、"]]},{"verse":11,"text":"あなたがたの神,かみ、主,しゅはその名,なを置,おくために、一つの場所,ばしょを選,えらばれるであろう。あなたがたはそこにわたしの命,めいじる物,ものをすべて携,たずさえて行,いかなければならない。すなわち、あなたがたの燔祭,はんさいと、犠牲,ぎせいと、十分,ぶんの一と、ささげ物,ものおよびあなたがたが主,しゅに誓,ちかったすべての誓願,せいがんの供,そなえ物,ものとを携,たずさえて行,いかなければならない。","tok":[["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["その"],["名","な"],["を"],["置く","おく"],["ため"],["に"],["、"],["一","ひと"],["つ"],["の"],["場所","ばしょ"],["を"],["選ら","えら"],["ばれるで"],["あろう"],["。"],["あなた"],["がた"],["は"],["そこ"],["に"],["わたし"],["の"],["命じる","めいじる"],["物","もの"],["を"],["すべて"],["携えて","たずさえて"],["行かなければ","いかなければ"],["ならない"],["。"],["すなわち"],["、"],["あなた"],["がた"],["の"],["燔祭","はんさい"],["と"],["、"],["犠牲","ぎせい"],["と"],["、"],["十分","ぶん"],["の"],["一","いち"],["と"],["、"],["ささげ物","ささげもの"],["および"],["あなた"],["がた"],["が"],["主に","しゅに"],["誓った","ちかった"],["すべて"],["の"],["誓願","せいがん"],["の"],["供え物","そなえもの"],["と"],["を"],["携えて","たずさえて"],["行かなければ","いかなければ"],["ならない"],["。"]]},{"verse":12,"text":"そしてあなたがたのむすこ、娘,むすめ、しもべ、はしためと共,ともにあなたがたの神,かみ、主,しゅの前,まえに喜,よろこび楽,たのしまなければならない。また町,まちの内,うちにおるレビびととも、そうしなければならない。彼,かれはあなたがたのうちに分,わけ前,まえがなく、嗣,し業,ぎょうを持,もたないからである。","tok":[["そして"],["あなた"],["がた"],["の"],["むすこ"],["、"],["娘","むすめ"],["、"],["しもべ"],["、"],["はし"],["ため"],["と"],["共","とも"],["に"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["喜こび","よろこび"],["楽しまなければ","たのしまなければ"],["ならない"],["。"],["また"],["町","まち"],["の"],["内","うち"],["に"],["おる"],["レビ"],["びと"],["とも"],["、"],["そう"],["しなければ"],["ならない"],["。"],["彼","かれ"],["は"],["あなた"],["がた"],["の"],["うち"],["に"],["分け前","わけまえ"],["が"],["なく"],["、"],["嗣業","しぎょう"],["を"],["持たない","もたない"],["から"],["で"],["ある"],["。"]]},{"verse":13,"text":"慎,つつしんで、すべてあなたがよいと思,おもう場所,ばしょで、みだりに燔祭,はんさいをささげないようにしなければならない。","tok":[["慎しんで","つつしんで"],["、"],["すべて"],["あなた"],["が"],["よい"],["と"],["思う","おもう"],["場所","ばしょ"],["で"],["、"],["みだり"],["に"],["燔祭","はんさい"],["を"],["ささげない"],["よう"],["に"],["しなければ"],["ならない"],["。"]]},{"verse":14,"text":"ただあなたの部族,ぶぞくの一つのうちに、主,しゅが選,えらばれるその場所,ばしょで、燔祭,はんさいをささげ、またわたしが命,めいじるすべての事,ことをしなければならない。","tok":[["ただ"],["あなた"],["の"],["部族","ぶぞく"],["の"],["一","ひと"],["つ"],["の"],["うち"],["に"],["、"],["主","しゅ"],["が"],["選ら","えら"],["ばれる"],["その"],["場所","ばしょ"],["で"],["、"],["燔祭","はんさい"],["を"],["ささげ"],["、"],["また"],["わたし"],["が"],["命じる","めいじる"],["すべて"],["の"],["事","こと"],["を"],["しなければ"],["ならない"],["。"]]},{"verse":15,"text":"しかし、あなたの神,かみ、主,しゅが賜,たまわる恵,めぐみにしたがって、すべて心,こころに好,このむ獣,けものを、どの町,まちででも殺,ころして、その肉,にくを食,たべることができる。すなわち、かもしかや雄,おじかの肉,にくと同様,どうようにそれを、汚,けがれた人,ひとも、清,きよい人,ひとも、食,たべることができる。","tok":[["しかし"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["賜わる","たまわる"],["恵","めぐみ"],["に"],["したがって"],["、"],["すべて"],["心","こころ"],["に"],["好む","このむ"],["獣","けもの"],["を"],["、"],["どの"],["町","まち"],["でで"],["も"],["殺ろして","ころして"],["、"],["その"],["肉","にく"],["を"],["食べる","たべる"],["こと"],["が"],["できる"],["。"],["すなわち"],["、"],["かもしか"],["や"],["雄","おじか"],["の"],["肉","にく"],["と"],["同様","どうよう"],["に"],["それ"],["を"],["、"],["汚","け"],["がれ"],["た"],["人","ひと"],["も"],["、"],["清い","きよい"],["人","ひと"],["も"],["、"],["食べる","たべる"],["こと"],["が"],["できる"],["。"]]},{"verse":16,"text":"ただし、その血,ちは食,たべてはならない。水,みずのようにそれを地,ちに注,そそがなければならない。","tok":[["ただし"],["、"],["その"],["血","ち"],["は"],["食べて","たべて"],["は"],["ならない"],["。"],["水","みず"],["の"],["よう"],["に"],["それ"],["を"],["地","ち"],["に"],["注がなければ","そそがなければ"],["ならない"],["。"]]},{"verse":17,"text":"あなたの穀物,こくもつと、ぶどう酒,しゅと、油,あぶらとの十分,ぶんの一および牛,うし、羊,ひつじのういご、ならびにあなたが立,たてる誓願,せいがんの供,そなえ物,ものと、自発,じはつの供,そなえ物,ものおよびささげ物,ものは、町,まちの内,うちで食,たべることはできない。","tok":[["あなた"],["の"],["穀物","こくもつ"],["と"],["、"],["ぶどう酒","ぶどうしゅ"],["と"],["、"],["油","あぶら"],["と"],["の"],["十分","ぶん"],["の"],["一","いち"],["および"],["牛","うし"],["、"],["羊","ひつじ"],["の"],["うい"],["ご"],["、"],["ならびに"],["あなた"],["が"],["立る","たてる"],["誓願","せいがん"],["の"],["供え物","そなえもの"],["と"],["、"],["自発","じはつ"],["の"],["供え物","そなえもの"],["および"],["ささげ物","ささげもの"],["は"],["、"],["町","まち"],["の"],["内","うち"],["で"],["食べる","たべる"],["こと"],["は"],["できない"],["。"]]},{"verse":18,"text":"あなたの神,かみ、主,しゅが選,えらばれる場所,ばしょで、あなたの神,かみ、主,しゅの前,まえでそれを食,たべなければならない。すなわちあなたのむすこ、娘,むすめ、しもべ、はしため、および町,まちの内,うちにおるレビびとと共,ともにそれを食,たべ、手,てを労,ろうして獲,えるすべての物,ものを、あなたの神,かみ、主,しゅの前,まえに喜,よろこび楽,たのしまなければならない。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["選ら","えら"],["ばれる"],["場所","ばしょ"],["で"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["前","まえ"],["で"],["それ"],["を"],["食べなければ","たべなければ"],["ならない"],["。"],["すなわち"],["あなた"],["の"],["むすこ"],["、"],["娘","むすめ"],["、"],["しもべ"],["、"],["はし"],["ため"],["、"],["および"],["町","まち"],["の"],["内","うち"],["に"],["おる"],["レビ"],["びと"],["と"],["共","とも"],["に"],["それ"],["を"],["食べ","たべ"],["、"],["手","て"],["を"],["労して","ろうして"],["獲る","える"],["すべて"],["の"],["物","もの"],["を"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["喜こび","よろこび"],["楽しまなければ","たのしまなければ"],["ならない"],["。"]]},{"verse":19,"text":"慎,つつしんで、あなたが世,よに生,いきながらえている間,あいだ、レビびとを捨,すてないようにしなければならない。","tok":[["慎しんで","つつしんで"],["、"],["あなた"],["が"],["世","よ"],["に"],["生きながらえて","いきながらえて"],["いる"],["間","あいだ"],["、"],["レビ"],["びと"],["を"],["捨てない","すてない"],["よう"],["に"],["しなければ"],["ならない"],["。"]]},{"verse":20,"text":"あなたの神,かみ、主,しゅが約束,やくそくされたように、あなたの領域,りょういきを広,ひろくされるとき、あなたは肉,にくを食,たべたいと願,ねがって、『わたしは肉,にくを食,たべよう』と言,いうであろう。その時,とき、あなたはほしいだけ肉,にくを食,たべることができる。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["約束","やくそく"],["された"],["よう"],["に"],["、"],["あなた"],["の"],["領域","りょういき"],["を"],["広く","ひろく"],["される"],["とき"],["、"],["あなた"],["は"],["肉","にく"],["を"],["食べたい","たべたい"],["と"],["願って","ねがって"],["、"],["『"],["わたし"],["は"],["肉","にく"],["を"],["食べよう","たべよう"],["』"],["と"],["言うで","いうで"],["あろう"],["。"],["その"],["時","とき"],["、"],["あなた"],["は"],["ほしい"],["だけ"],["肉","にく"],["を"],["食べる","たべる"],["こと"],["が"],["できる"],["。"]]},{"verse":21,"text":"もしあなたの神,かみ、主,しゅがその名,なを置,おくために選,えらばれる場所,ばしょが、遠,とおく離,はなれているならば、わたしが命,めいじるように、主,しゅが賜,たまわる牛,うし、羊,ひつじをほふり、門,もんの内,うちで、ほしいだけ食,たべることができる。","tok":[["もし"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅがそ"],["の"],["名","な"],["を"],["置く","おく"],["ため"],["に"],["選ら","えら"],["ばれる"],["場所","ばしょ"],["が"],["、"],["遠く","とおく"],["離れて","はなれて"],["いるならば"],["、"],["わたし"],["が"],["命じる","めいじる"],["よう"],["に"],["、"],["主","しゅ"],["が"],["賜わる","たまわる"],["牛","うし"],["、"],["羊","ひつじ"],["を"],["ほふり"],["、"],["門","もん"],["の"],["内","うち"],["で"],["、"],["ほしい"],["だけ"],["食べる","たべる"],["こと"],["が"],["できる"],["。"]]},{"verse":22,"text":"かもしかや、雄,おじかを食,たべるように、それを食,たべることができる。すなわち汚,けがれた人,ひとも、清,きよい人,ひとも一様,いちようにそれを食,たべることができる。","tok":[["かもしか"],["や"],["、"],["雄","おじか"],["を"],["食べる","たべる"],["よう"],["に"],["、"],["それ"],["を"],["食べる","たべる"],["こと"],["が"],["できる"],["。"],["すなわち"],["汚","け"],["がれ"],["た"],["人","ひと"],["も"],["、"],["清い","きよい"],["人","ひと"],["も"],["一様","いちよう"],["に"],["それ"],["を"],["食べる","たべる"],["こと"],["が"],["できる"],["。"]]},{"verse":23,"text":"ただ堅,かたく慎,つつしんで、その血,ちを食,たべないようにしなければならない。血,ちは命,いのちだからである。その命,いのちを肉,にくと一緒,いっしょに食,たべてはならない。","tok":[["ただ"],["堅く","かたく"],["慎しんで","つつしんで"],["、"],["その"],["血","ち"],["を"],["食べない","たべない"],["よう"],["に"],["しなければ"],["ならない"],["。"],["血","ち"],["は"],["命","いのち"],["だ"],["から"],["で"],["ある"],["。"],["その"],["命","いのち"],["を"],["肉","にく"],["と"],["一緒","いっしょ"],["に"],["食べて","たべて"],["は"],["ならない"],["。"]]},{"verse":24,"text":"あなたはそれを食,たべてはならない。水,みずのようにそれを地,ちに注,そそがなければならない。","tok":[["あなた"],["は"],["それ"],["を"],["食べて","たべて"],["は"],["ならない"],["。"],["水","みず"],["の"],["よう"],["に"],["それ"],["を"],["地","ち"],["に"],["注がなければ","そそがなければ"],["ならない"],["。"]]},{"verse":25,"text":"あなたはそれを食,たべてはならない。こうして、主,しゅが正,ただしいと見,みられる事,ことを行,おこなうならば、あなたにも後,のちの子孫,しそんにも、さいわいがあるであろう。","tok":[["あなた"],["は"],["それ"],["を"],["食べて","たべて"],["は"],["ならない"],["。"],["こう"],["して"],["、"],["主","しゅ"],["が"],["正い","ただしい"],["と"],["見られる","みられる"],["事","こと"],["を"],["行なうならば","おこなうならば"],["、"],["あなた"],["に"],["も"],["後","のち"],["の"],["子孫","しそん"],["に"],["も"],["、"],["さいわい"],["が"],["あるで"],["あろう"],["。"]]},{"verse":26,"text":"ただあなたのささげる聖,せいなる物,ものと、誓願,せいがんの物,ものとは、主,しゅが選,えらばれる場所,ばしょへ携,たずさえて行,いかなければならない。","tok":[["ただ"],["あなた"],["の"],["ささげる"],["聖","せい"],["なる"],["物","もの"],["と"],["、"],["誓願","せいがん"],["の"],["物","もの"],["と"],["は"],["、"],["主","しゅ"],["が"],["選ら","えら"],["ばれる"],["場所","ばしょ"],["へ"],["携えて","たずさえて"],["行かなければ","いかなければ"],["ならない"],["。"]]},{"verse":27,"text":"そして燔祭,はんさいをささげる時,ときは、肉,にくと血,ちとをあなたの神,かみ、主,しゅの祭壇,さいだんの上,うえにささげなければならない。犠牲,ぎせいをささげる時,ときは、血,ちをあなたの神,かみ、主,しゅの祭壇,さいだんにそそぎかけ、肉,にくはみずから食,たべることができる。","tok":[["そして"],["燔祭","はんさい"],["を"],["ささげる"],["時","とき"],["は"],["、"],["肉","にく"],["と"],["血","ち"],["と"],["を"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["祭壇","さいだん"],["の"],["上","うえ"],["に"],["ささげなければ"],["ならない"],["。"],["犠牲","ぎせい"],["を"],["ささげる"],["時","とき"],["は"],["、"],["血","ち"],["を"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["祭壇","さいだん"],["に"],["そそぎ"],["かけ"],["、"],["肉","にく"],["は"],["みずから"],["食べる","たべる"],["こと"],["が"],["できる"],["。"]]},{"verse":28,"text":"あなたはわたしが命,めいじるこれらの事,ことを、ことごとく聞,きいて守,まもらなければならない。こうしてあなたの神,かみ、主,しゅが見,みて良,よいとし、正,ただしいとされる事,ことを行,おこなうならば、あなたにも後,のちの子孫,しそんにも、長,ながくさいわいがあるであろう。","tok":[["あなた"],["は"],["わたし"],["が"],["命じる","めいじる"],["これ"],["ら"],["の"],["事","こと"],["を"],["、"],["ことごとく"],["聞いて","きいて"],["守らなければ","まもらなければ"],["ならない"],["。"],["こう"],["して"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["見て","みて"],["良い","よい"],["と"],["し"],["、"],["正い","ただしい"],["と"],["される"],["事","こと"],["を"],["行なうならば","おこなうならば"],["、"],["あなた"],["に"],["も"],["後","のち"],["の"],["子孫","しそん"],["に"],["も"],["、"],["長く","ながく"],["さいわい"],["が"],["あるで"],["あろう"],["。"]]},{"verse":29,"text":"あなたの神,かみ、主,しゅが、あなたの行,いって追,おい払,はらおうとする国々,くにぐにの民,たみを、あなたの前,まえから断,たち滅,ほろぼされ、あなたがついにその国々,くにぐにを獲,えて、その地,ちに住,すむようになる時,とき、","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["、"],["あなた"],["の"],["行って","いって"],["追い払おう","おいはらおう"],["と"],["する"],["国々","くにぐに"],["の"],["民","たみ"],["を"],["、"],["あなた"],["の"],["前","まえ"],["から"],["断ち","たち"],["滅ぼされ","ほろぼされ"],["、"],["あなた"],["が"],["ついに"],["その"],["国々","くにぐに"],["を"],["獲て","えて"],["、"],["その"],["地","ち"],["に"],["住む","すむ"],["よう"],["に"],["なる"],["時","とき"],["、"]]},{"verse":30,"text":"あなたはみずから慎,つつしみ、彼,かれらがあなたの前,まえから滅,ほろぼされた後,のち、彼,かれらにならって、わなにかかってはならない。また彼,かれらの神々,かみがみを尋,たずね求,もとめて、『これらの国々,くにぐにの民,たみはどのようにその神々,かみがみに仕,つかえたのか、わたしもそのようにしよう』と言,いってはならない。","tok":[["あなた"],["は"],["みずから"],["慎しみ","つつしみ"],["、"],["彼","かれ"],["ら"],["が"],["あなた"],["の"],["前","まえ"],["から"],["滅ぼされた","ほろぼされた"],["後","の"],["ち"],["、"],["彼","かれ"],["ら"],["に"],["ならって"],["、"],["わな"],["に"],["かかって"],["は"],["ならない"],["。"],["また"],["彼","かれ"],["ら"],["の"],["神々","かみがみ"],["を"],["尋ね求めて","たずねもとめて"],["、"],["『"],["これ"],["ら"],["の"],["国々","くにぐに"],["の"],["民","たみ"],["は"],["どの"],["よう"],["に"],["その"],["神々","かみがみ"],["に"],["仕えた","つかえた"],["の"],["か"],["、"],["わたし"],["も"],["その"],["よう"],["に"],["しよう"],["』"],["と"],["言って","いって"],["は"],["ならない"],["。"]]},{"verse":31,"text":"あなたの神,かみ、主,しゅに対,たいしては、そのようにしてはならない。彼,かれらは主,しゅの憎,にくまれるもろもろの忌,いむべき事,ことを、その神々,かみがみにむかって行,おこない、むすこ、娘,むすめをさえ火,ひに焼,やいて、神々,かみがみにささげたからである。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主に","しゅに"],["対し","たいし"],["ては"],["、"],["その"],["よう"],["に"],["して"],["は"],["ならない"],["。"],["彼","かれ"],["ら"],["は"],["主","しゅ"],["の"],["憎まれる","にくまれる"],["もろもろ"],["の"],["忌むべき","いむべき"],["事","こと"],["を"],["、"],["その"],["神々","かみがみ"],["に"],["むかって"],["行ない","おこない"],["、"],["むすこ"],["、"],["娘","むすめ"],["を"],["さえ"],["火","ひ"],["に"],["焼いて","やいて"],["、"],["神々","かみがみ"],["に"],["ささげた"],["から"],["で"],["ある"],["。"]]}]
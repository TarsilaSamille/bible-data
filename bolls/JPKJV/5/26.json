[{"verse":1,"text":"あなたの神,かみ、主,しゅが嗣,し業,ぎょうとして賜,たまわる国,くににはいって、それを所有,しょゆうし、そこに住,すむ時,ときは、","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["嗣業","しぎょう"],["として"],["賜わる","たまわる"],["国","くに"],["に"],["はいって"],["、"],["それ"],["を"],["所有","しょゆう"],["し"],["、"],["そこ"],["に"],["住む","すむ"],["時","とき"],["は"],["、"]]},{"verse":2,"text":"あなたの神,かみ、主,しゅが賜,たまわる国,くににできる、地,ちのすべての実,みの初物,はつものを取,とってかごに入,いれ、あなたの神,かみ、主,しゅがその名,なを置,おくために選,えらばれる所,ところへ携,たずさえて行,いかなければならない。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["賜わる","たまわる"],["国","くに"],["に"],["できる"],["、"],["地","ち"],["の"],["すべて"],["の"],["実","み"],["の"],["初物","はつもの"],["を"],["取って","とって"],["かご"],["に"],["入れ","いれ"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅがそ"],["の"],["名","な"],["を"],["置く","おく"],["ため"],["に"],["選ら","えら"],["ばれる"],["所","ところ"],["へ"],["携えて","たずさえて"],["行かなければ","いかなければ"],["ならない"],["。"]]},{"verse":3,"text":"そしてその時,ときの祭司,さいしの所,ところへ行,いって彼,かれに言,いわなければならない、『きょう、あなたの神,かみ、主,しゅにわたしは申,もうします。主,しゅがわれわれに与,あたえると先祖,せんぞたちに誓,ちかわれた国,くにに、わたしははいることができました』。","tok":[["そして"],["その"],["時","とき"],["の"],["祭司","さいし"],["の"],["所","ところ"],["へ"],["行って","いって"],["彼","かれ"],["に"],["言わなければ","いわなければ"],["ならない"],["、"],["『"],["きょう"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主に","しゅに"],["わたし"],["は"],["申します","もうします"],["。"],["主","しゅ"],["が"],["われわれ"],["に"],["与える","あたえる"],["と"],["先祖","せんぞ"],["たち"],["に"],["誓われた","ちかわれた"],["国","くに"],["に"],["、"],["わたし"],["は"],["はいる"],["こと"],["が"],["できました"],["』"],["。"]]},{"verse":4,"text":"そのとき祭司,さいしはあなたの手,てからそのかごを受,うけ取,とってあなたの神,かみ、主,しゅの祭壇,さいだんの前,まえに置,おかなければならない。","tok":[["その"],["とき"],["祭司","さいし"],["は"],["あなた"],["の"],["手","て"],["から"],["その"],["かご"],["を"],["受け取って","うけとって"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["祭壇","さいだん"],["の"],["前","まえ"],["に"],["置かなければ","おかなければ"],["ならない"],["。"]]},{"verse":5,"text":"そして、あなたはあなたの神,かみ、主,しゅの前,まえに述,のべて言,いわなければならない、『わたしの先祖,せんぞは、さすらいの一アラムびとでありましたが、わずかの人,ひとを連,つれてエジプトへ下,くだって行,いって、その所,ところに寄留,きりゅうし、ついにそこで大,おおきく、強,つよい、人数,にんずうの多,おおい国民,こくみんになりました。","tok":[["そして"],["、"],["あなた"],["は"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["述べて","のべて"],["言わなければ","いわなければ"],["ならない"],["、"],["『"],["わたし"],["の"],["先祖","せんぞ"],["は"],["、"],["さすらい"],["の"],["一","いち"],["アラム"],["びと"],["で"],["ありました"],["が"],["、"],["わずか"],["の"],["人","ひと"],["を"],["連れて","つれて"],["エジプト"],["へ"],["下って","くだって"],["行って","いって"],["、"],["その"],["所","ところ"],["に"],["寄留","きりゅう"],["し"],["、"],["ついに"],["そこ"],["で"],["大きく","おおきく"],["、"],["強い","つよい"],["、"],["人数","にんずう"],["の"],["多い","おおい"],["国民","こくみん"],["に"],["なりました"],["。"]]},{"verse":6,"text":"ところがエジプトびとはわれわれをしえたげ、また悩,なやまして、つらい労役,ろうえきを負,おわせましたが、","tok":[["ところ"],["が"],["エジプト"],["び"],["と"],["は"],["われわれ"],["を"],["し"],["えたげ"],["、"],["また"],["悩して","なやまして"],["、"],["つらい"],["労役","ろうえき"],["を"],["負わせました","おわせました"],["が"],["、"]]},{"verse":7,"text":"われわれが先祖,せんぞたちの神,かみ、主,しゅに叫,さけんだので、主,しゅはわれわれの声,こえを聞,きき、われわれの悩,なやみと、骨折,ほねおりと、しえたげとを顧,かえりみ、","tok":[["われわれ"],["が"],["先祖","せんぞ"],["たち"],["の"],["神","かみ"],["、"],["主に","しゅに"],["叫けんだ","さけんだ"],["ので"],["、"],["主","しゅ"],["は"],["われわれ"],["の"],["声","こえ"],["を"],["聞","きき"],["、"],["われわれ"],["の"],["悩み","なやみ"],["と"],["、"],["骨折り","ほねおり"],["と"],["、"],["し"],["えたげ"],["と"],["を"],["顧りみ","かえりみ"],["、"]]},{"verse":8,"text":"主,しゅは強,つよい手,てと、伸,のべた腕,うでと、大,おおいなる恐,おそるべき事,ことと、しるしと、不思議,ふしぎとをもって、われわれをエジプトから導,みちびき出,だし、","tok":[["主","しゅ"],["は"],["強い","つよい"],["手","て"],["と"],["、"],["伸べた","のべた"],["腕","うで"],["と"],["、"],["大いなる","おおいなる"],["恐るべき","おそるべき"],["事","こと"],["と"],["、"],["しるし"],["と"],["、"],["不思議","ふしぎ"],["と"],["を"],["もって"],["、"],["われわれ"],["を"],["エジプト"],["から"],["導き出し","みちびきだし"],["、"]]},{"verse":9,"text":"われわれをこの所,ところへ連,つれてきて、乳,ちちと蜜,みつの流,ながれるこの地,ちをわれわれに賜,たまわりました。","tok":[["われわれ"],["を"],["この"],["所","ところ"],["へ"],["連れて","つれて"],["きて"],["、"],["乳","ちち"],["と"],["蜜","みつ"],["の"],["流れる","ながれる"],["この"],["地","ち"],["を"],["われわれ"],["に"],["賜わりました","たまわりました"],["。"]]},{"verse":10,"text":"主,しゅよ、ごらんください。あなたがわたしに賜,たまわった地,ちの実,みの初物,はつものを、いま携,たずさえてきました』。そしてあなたはそれをあなたの神,かみ、主,しゅの前,まえに置,おいて、あなたの神,かみ、主,しゅの前,まえに礼拝,れいはいし、","tok":[["主","しゅ"],["よ"],["、"],["ごらん"],["ください"],["。"],["あなた"],["が"],["わたし"],["に"],["賜わった","たまわった"],["地","ち"],["の"],["実","み"],["の"],["初物","はつもの"],["を"],["、"],["いま"],["携えて","たずさえて"],["きました"],["』"],["。"],["そして"],["あなた"],["は"],["それ"],["を"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["置いて","おいて"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["礼拝","れいはい"],["し"],["、"]]},{"verse":11,"text":"あなたの神,かみ、主,しゅがあなたとあなたの家,いえとに賜,たまわったすべての良,よい物,ものをもって、レビびとおよびあなたのなかにいる寄留,きりゅうの他国,たこく人,じんと共,ともに喜,よろこび楽,たのしまなければならない。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["あなた"],["と"],["あなた"],["の"],["家","いえ"],["と"],["に"],["賜わった","たまわった"],["すべて"],["の"],["良い","よい"],["物","もの"],["を"],["もって"],["、"],["レビ"],["び"],["と"],["および"],["あなた"],["の"],["なか"],["に"],["いる"],["寄留","きりゅう"],["の"],["他国人","たこくじん"],["と"],["共","とも"],["に"],["喜こび","よろこび"],["楽しまなければ","たのしまなければ"],["ならない"],["。"]]},{"verse":12,"text":"第,だい三年,ねんすなわち十分,ぶんの一を納,おさめる年,としに、あなたがすべての産物,さんぶつの十分,ぶんの一を納,おさめ終,おわって、それをレビびとと寄留,きりゅうの他国,たこく人,じんと孤児,こじと寡婦,かふとに与,あたえ、町,まちのうちで彼,かれらに飽,あきるほど食,たべさせた時,とき、","tok":[["第","だい"],["三","さん"],["年","ねん"],["すなわち"],["十分","ぶん"],["の"],["一","いち"],["を"],["納める","おさめる"],["年","とし"],["に"],["、"],["あなた"],["が"],["すべて"],["の"],["産物","さんぶつ"],["の"],["十分","ぶん"],["の"],["一","いち"],["を"],["納","おさめ"],["終わって","おわって"],["、"],["それ"],["を"],["レビ"],["びと"],["と"],["寄留","きりゅう"],["の"],["他国人","たこくじん"],["と"],["孤児","こじ"],["と"],["寡婦","かふ"],["と"],["に"],["与","あたえ"],["、"],["町","まち"],["の"],["うち"],["で"],["彼","かれ"],["ら"],["に"],["飽きる","あきる"],["ほど"],["食べさせた","たべさせた"],["時","とき"],["、"]]},{"verse":13,"text":"あなたの神,かみ、主,しゅの前,まえで言,いわなければならない、『わたしはその聖,せいなる物,ものを家,いえから取,とり出,だし、またレビびとと寄留,きりゅうの他国,たこく人,じんと孤児,こじと寡婦,かふとにそれを与,あたえ、すべてあなたが命,めいじられた命令,めいれいのとおりにいたしました。わたしはあなたの命令,めいれいにそむかず、またそれを忘,わすれませんでした。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["前","まえ"],["で"],["言わなければ","いわなければ"],["ならない"],["、"],["『"],["わたし"],["は"],["その"],["聖","せい"],["なる"],["物","もの"],["を"],["家","いえ"],["から"],["取出し","とりだし"],["、"],["また"],["レビ"],["びと"],["と"],["寄留","きりゅう"],["の"],["他国人","たこくじん"],["と"],["孤児","こじ"],["と"],["寡婦","かふ"],["と"],["に"],["それ"],["を"],["与","あたえ"],["、"],["すべて"],["あなた"],["が"],["命じられた","めいじられた"],["命令","めいれい"],["の"],["とおり"],["に"],["いたしました"],["。"],["わたし"],["は"],["あなた"],["の"],["命令","めいれい"],["に"],["そむかず"],["、"],["また"],["それ"],["を"],["忘ませんでした","わすれませんでした"],["。"]]},{"verse":14,"text":"わたしはその聖,せいなる物,ものを喪,ものうちで食,たべたことがなく、また汚,けがれた身,みでそれを取,とり出,だしたことがなく、また死人,しにんにそれを供,そなえたことがありませんでした。わたしはわたしの神,かみ、主,しゅの声,こえに聞,きき従,したがい、すべてあなたがわたしに命,めいじられたとおりにいたしました。","tok":[["わたし"],["は"],["その"],["聖","せい"],["なる"],["物","もの"],["を"],["喪","も"],["の"],["うち"],["で"],["食べた","たべた"],["こと"],["が"],["なく"],["、"],["また"],["汚","け"],["がれ"],["た"],["身","み"],["で"],["それ"],["を"],["取出した","とりだした"],["こと"],["が"],["なく"],["、"],["また"],["死人","しにん"],["に"],["それ"],["を"],["供えた","そなえた"],["こと"],["が"],["ありませんでした"],["。"],["わたし"],["は"],["わたし"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["声","こえ"],["に"],["聞","きき"],["従い","したがい"],["、"],["すべて"],["あなた"],["が"],["わたし"],["に"],["命じられた","めいじられた"],["とおり"],["に"],["いたしました"],["。"]]},{"verse":15,"text":"あなたの聖,せいなるすみかである天,てんからみそなわして、あなたの民,たみイスラエルと、あなたがわれわれに与,あたえられた地,ちとを祝福,しゅくふくしてください。これはあなたがわれわれの先祖,せんぞに誓,ちかわれた乳,ちちと蜜,みつの流,ながれる地,ちです』。","tok":[["あなた"],["の"],["聖","せい"],["なる"],["すみか"],["で"],["ある"],["天","てん"],["から"],["みそ"],["なわ"],["して"],["、"],["あなた"],["の"],["民","たみ"],["イスラエル"],["と"],["、"],["あなた"],["が"],["われわれ"],["に"],["与えられた","あたえられた"],["地","ち"],["と"],["を"],["祝福","しゅくふく"],["して"],["ください"],["。"],["これ"],["は"],["あなた"],["が"],["われわれ"],["の"],["先祖","せんぞ"],["に"],["誓われた","ちかわれた"],["乳","ちち"],["と"],["蜜","みつ"],["の"],["流れる","ながれる"],["地","ち"],["です"],["』"],["。"]]},{"verse":16,"text":"きょう、あなたの神,かみ、主,しゅはこれらの定,さだめと、おきてとを行,おこなうことをあなたに命,めいじられる。それゆえ、あなたは心,こころをつくし、精神,せいしんをつくしてそれを守,まもり行,おこなわなければならない。","tok":[["きょう"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["これ"],["ら"],["の"],["定め","さだめ"],["と"],["、"],["おきて"],["と"],["を"],["行なう","おこなう"],["こと"],["を"],["あなた"],["に"],["命じられる","めいじられる"],["。"],["それ"],["ゆえ"],["、"],["あなた"],["は"],["心","こころ"],["を"],["つくし"],["、"],["精神","せいしん"],["を"],["つくして"],["それ"],["を"],["守り","まもり"],["行なわなければ","おこなわなければ"],["ならない"],["。"]]},{"verse":17,"text":"きょう、あなたは主,しゅをあなたの神,かみとし、かつその道,みちに歩,あゆみ、定,さだめと、戒,いましめと、おきてとを守,まもり、その声,こえに聞,きき従,したがうことを明言,めいげんした。","tok":[["きょう"],["、"],["あなた"],["は"],["主","しゅ"],["を"],["あなた"],["の"],["神","かみ"],["と"],["し"],["、"],["かつ"],["その"],["道","みち"],["に"],["歩み","あゆみ"],["、"],["定め","さだめ"],["と"],["、"],["戒しめ","いましめ"],["と"],["、"],["おきて"],["と"],["を"],["守り","まもり"],["、"],["その"],["声","こえ"],["に"],["聞","きき"],["従う","したがう"],["こと"],["を"],["明言","めいげん"],["した"],["。"]]},{"verse":18,"text":"そして、主,しゅは先,さきに約束,やくそくされたように、きょう、あなたを自分,じぶんの宝,たからの民,たみとされること、また、あなたがそのすべての命令,めいれいを守,まもるべきことを明言,めいげんされた。","tok":[["そして"],["、"],["主","しゅ"],["は"],["先","さき"],["に"],["約束","やくそく"],["された"],["よう"],["に"],["、"],["きょう"],["、"],["あなた"],["を"],["自分","じぶん"],["の"],["宝","たから"],["の"],["民","たみ"],["と"],["される"],["こと"],["、"],["また"],["、"],["あなた"],["が"],["その"],["すべて"],["の"],["命令","めいれい"],["を"],["守","まもる"],["べき"],["こと"],["を"],["明言","めいげん"],["された"],["。"]]},{"verse":19,"text":"主,しゅは誉,ほまれと良,よき名,なと栄,さかえとをあなたに与,あたえて、主,しゅの造,つくられたすべての国民,こくみんにまさるものとされるであろう。あなたは主,しゅが言,いわれたように、あなたの神,かみ、主,しゅの聖,せいなる民,たみとなるであろう」。","tok":[["主","しゅ"],["は"],["誉","ほまれ"],["と"],["良き","よき"],["名","な"],["と"],["栄","さかえ"],["と"],["を"],["あなた"],["に"],["与","あたえ"],["て"],["、"],["主","しゅ"],["の"],["造られた","つくられた"],["すべて"],["の"],["国民","こくみん"],["に"],["まさる"],["もの"],["と"],["されるで"],["あろう"],["。"],["あなた"],["は"],["主","しゅ"],["が"],["言われた","いわれた"],["よう"],["に"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["聖","せい"],["なる"],["民","たみ"],["と"],["なるで"],["あろう"],["」"],["。"]]}]
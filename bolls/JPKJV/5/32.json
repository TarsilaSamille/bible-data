[{"verse":1,"text":"「天,てんよ、耳,みみを傾,かたむけよ、わたしは語,かたる、地,ちよ、わたしの口,くちの言葉,ことばを聞,きけ。","tok":[["「"],["天","てん"],["よ"],["、"],["耳","みみ"],["を"],["傾むけよ","かたむけよ"],["、"],["わたし"],["は"],["語る","かたる"],["、"],["地","ち"],["よ"],["、"],["わたし"],["の"],["口","くち"],["の"],["言葉","ことば"],["を"],["聞け","きけ"],["。"]]},{"verse":2,"text":"わたしの教,おしえは雨,あめのように降,ふりそそぎ、わたしの言葉,ことばは露,つゆのようにしたたるであろう。若草,わかくさの上,うえに降,ふる小雨,こさめのように、青草,あおくさの上,うえにくだる夕立,ゆうだちのように。","tok":[["わたし"],["の"],["教え","おしえ"],["は"],["雨","あめ"],["の"],["よう"],["に"],["降りそそぎ","ふりそそぎ"],["、"],["わたし"],["の"],["言葉","ことば"],["は"],["露","つゆ"],["の"],["よう"],["に"],["したたるで"],["あろう"],["。"],["若草","わかくさ"],["の"],["上","うえ"],["に"],["降る","ふる"],["小雨","こさめ"],["の"],["よう"],["に"],["、"],["青草","あおくさ"],["の"],["上","うえ"],["に"],["くだる"],["夕立","ゆうだち"],["の"],["よう"],["に"],["。"]]},{"verse":3,"text":"わたしは主,しゅの名,なをのべよう、われわれの神,かみに栄光,えいこうを帰,かえせよ。","tok":[["わたし"],["は"],["主","しゅ"],["の"],["名","な"],["を"],["のべよう"],["、"],["われわれ"],["の"],["神","かみ"],["に"],["栄光","えいこう"],["を"],["帰せ","かえせ"],["よ"],["。"]]},{"verse":4,"text":"主,しゅは岩,いわであって、そのみわざは全,まったく、その道,みちはみな正,ただしい。主,しゅは真実,しんじつなる神,かみであって、偽,いつわりなく、義,ぎであって、正,せいである。","tok":[["主","しゅ"],["は"],["岩","いわ"],["で"],["あって"],["、"],["その"],["みわざ"],["は"],["全く","まったく"],["、"],["その"],["道","みち"],["は"],["みな"],["正い","ただしい"],["。"],["主","しゅ"],["は"],["真実","しんじつ"],["なる"],["神","かみ"],["で"],["あって"],["、"],["偽り","いつわり"],["なく"],["、"],["義","ぎ"],["で"],["あって"],["、"],["正","せい"],["で"],["ある"],["。"]]},{"verse":5,"text":"彼,かれらは主,しゅにむかって悪,あくを行,おこない、そのきずのゆえに、もはや主,しゅの子,こらではなく、よこしまで、曲,まがったやからである。","tok":[["彼","かれ"],["ら"],["は"],["主に","しゅに"],["むかって"],["悪","あく"],["を"],["行ない","おこない"],["、"],["その"],["きず"],["の"],["ゆえ"],["に"],["、"],["もはや"],["主","しゅ"],["の"],["子","こ"],["ら"],["で"],["は"],["なく"],["、"],["よこしま"],["で"],["、"],["曲がった","まがった"],["やから"],["で"],["ある"],["。"]]},{"verse":6,"text":"愚,おろかな知恵,ちえのない民,たみよ、あなたがたはこのようにして主,しゅに報,むくいるのか。主,しゅはあなたを生,うみ、あなたを造,つくり、あなたを堅,かたく立,たてられたあなたの父,ちちではないか。","tok":[["愚か","おろか"],["な"],["知恵","ちえ"],["の"],["ない"],["民","たみ"],["よ"],["、"],["あなた"],["がた"],["は"],["この"],["よう"],["に"],["して"],["主に","しゅに"],["報いる","むくいる"],["の"],["か"],["。"],["主","しゅ"],["は"],["あなた"],["を"],["生み","うみ"],["、"],["あなた"],["を"],["造","つくり"],["、"],["あなた"],["を"],["堅く","かたく"],["立られた","たてられた"],["あなた"],["の"],["父","ちち"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":7,"text":"いにしえの日,ひを覚,おぼえ、代々,よよの年,としを思,おもえ。あなたの父,ちちに問,とえ、彼,かれはあなたに告,つげるであろう。長老,ちょうろうたちに問,とえ、彼,かれらはあなたに語,かたるであろう。","tok":[["いにしえ"],["の"],["日","ひ"],["を"],["覚え","おぼえ"],["、"],["代々","よよ"],["の"],["年","とし"],["を"],["思え","おもえ"],["。"],["あなた"],["の"],["父","ちち"],["に"],["問え","とえ"],["、"],["彼","かれ"],["は"],["あなた"],["に"],["告げるで","つげるで"],["あろう"],["。"],["長老","ちょうろう"],["たち"],["に"],["問え","とえ"],["、"],["彼","かれ"],["ら"],["は"],["あなた"],["に"],["語るで","かたるで"],["あろう"],["。"]]},{"verse":8,"text":"いと高,たかき者,ものは人,ひとの子,こらを分,わけ、諸,しょ国民,こくみんにその嗣,し業,ぎょうを与,あたえられたとき、イスラエルの子,こらの数,かずに照,てらして、もろもろの民,たみの境,さかいを定,さだめられた。","tok":[["いと"],["高き","たかき"],["者","もの"],["は"],["人","ひと"],["の"],["子","こ"],["ら"],["を"],["分け","わけ"],["、"],["諸","しょ"],["国民","こくみん"],["に"],["その"],["嗣業","しぎょう"],["を"],["与えられた","あたえられた"],["とき"],["、"],["イスラエル"],["の"],["子","こ"],["ら"],["の"],["数","かず"],["に"],["照","てらし"],["て"],["、"],["もろもろ"],["の"],["民","たみ"],["の"],["境","さかい"],["を"],["定められた","さだめられた"],["。"]]},{"verse":9,"text":"主,しゅの分,ぶんはその民,たみであって、ヤコブはその定,さだめられた嗣,し業,ぎょうである。","tok":[["主","しゅ"],["の"],["分","ぶん"],["は"],["その"],["民","たみ"],["で"],["あって"],["、"],["ヤコブ"],["は"],["その"],["定められた","さだめられた"],["嗣業","しぎょ"],["うで"],["ある"],["。"]]},{"verse":10,"text":"主,しゅはこれを荒野,あらのの地,ちで見,みいだし、獣,けもののほえる荒,あれ地,ちで会,あい、これを巡,めぐり囲,かこんでいたわり、目,めのひとみのように守,まもられた。","tok":[["主","しゅ"],["は"],["これ"],["を"],["荒野","あらの"],["の"],["地","ち"],["で"],["見いだし","みいだし"],["、"],["獣","けもの"],["の"],["ほえる"],["荒れ地","あれち"],["で"],["会い","あい"],["、"],["これ"],["を"],["巡り","めぐり"],["囲んで","かこんで"],["いたわり"],["、"],["目","め"],["の"],["ひとみ"],["の"],["よう"],["に"],["守られた","まもられた"],["。"]]},{"verse":11,"text":"わしがその巣,すのひなを呼,よび起,おこし、その子,この上,うえに舞,まいかけり、その羽,はねをひろげて彼,かれらをのせ、そのつばさの上,うえにこれを負,おうように、","tok":[["わし"],["が"],["その"],["巣","す"],["の"],["ひな"],["を"],["呼び起こし","よびおこし"],["、"],["その"],["子","こ"],["の"],["上","うえ"],["に"],["舞","まい"],["か"],["けり"],["、"],["その"],["羽","はね"],["を"],["ひろげて"],["彼","かれ"],["ら"],["を"],["のせ"],["、"],["その"],["つばさ"],["の"],["上","うえ"],["に"],["これ"],["を"],["負う","おう"],["よう"],["に"],["、"]]},{"verse":12,"text":"主,しゅはただひとりで彼,かれを導,みちびかれて、ほかの神々,かみがみはあずからなかった。","tok":[["主","しゅ"],["は"],["ただ"],["ひとり"],["で"],["彼","かれ"],["を"],["導かれて","みちびかれて"],["、"],["ほか"],["の"],["神々","かみがみ"],["は"],["あずからなかった"],["。"]]},{"verse":13,"text":"主,しゅは彼,かれに地,ちの高,たかき所,ところを乗,のり通,とおらせ、田畑,たはたの産物,さんぶつを食,くわせ、岩,いわの中,なかから蜜,みつを吸,すわせ、堅,かたい岩,いわから油,あぶらを吸,すわせ、","tok":[["主","しゅ"],["は"],["彼","かれ"],["に"],["地","ち"],["の"],["高き","たかき"],["所","ところ"],["を"],["乗","のり"],["通らせ","とおらせ"],["、"],["田畑","たはた"],["の"],["産物","さんぶつ"],["を"],["食わせ","くわせ"],["、"],["岩","いわ"],["の"],["中","なか"],["から"],["蜜","みつ"],["を"],["吸わせ","すわせ"],["、"],["堅い","かたい"],["岩","いわ"],["から"],["油","あぶら"],["を"],["吸わせ","すわせ"],["、"]]},{"verse":14,"text":"牛,うしの凝乳,ぎょうにゅう、羊,ひつじの乳,ちち、小羊,こひつじと雄羊,おひつじの脂肪,しぼう、バシャンの牛,うしと雄,おやぎ、小麦,こむぎの良,よい物,ものを食,くわせられた。またあなたはぶどうのしるのあわ立,たつ酒,さけを飲,のんだ。","tok":[["牛","うし"],["の"],["凝乳","ぎょうにゅう"],["、"],["羊","ひつじ"],["の"],["乳","ちち"],["、"],["小羊","こひつじ"],["と"],["雄羊","おひつじ"],["の"],["脂肪","しぼう"],["、"],["バシャン"],["の"],["牛","うし"],["と"],["雄","お"],["やぎ"],["、"],["小麦","こむぎ"],["の"],["良い","よい"],["物","もの"],["を"],["食わせられた","くわせられた"],["。"],["また"],["あなた"],["は"],["ぶどう"],["の"],["しる"],["の"],["あわ立つ","あわたつ"],["酒","さけ"],["を"],["飲んだ","のんだ"],["。"]]},{"verse":15,"text":"しかるにエシュルンは肥,こえ太,ふとって、足,あしでけった。あなたは肥,こえ太,ふとって、つややかになり、自分,じぶんを造,つくった神,かみを捨,すて、救,すくいの岩,いわを侮,あなどった。","tok":[["しかる"],["に"],["エシュルン"],["は"],["肥","こえ"],["太って","ふとって"],["、"],["足","あし"],["で"],["けった"],["。"],["あなた"],["は"],["肥","こえ"],["太って","ふとって"],["、"],["つややか"],["に"],["なり"],["、"],["自分","じぶん"],["を"],["造った","つくった"],["神","かみ"],["を"],["捨て","すて"],["、"],["救い","すくい"],["の"],["岩","いわ"],["を"],["侮った","あなどった"],["。"]]},{"verse":16,"text":"彼,かれらはほかの神々,かみがみに仕,つかえて、主,しゅのねたみを起,おこし、憎,にくむべきおこないをもって主,しゅの怒,いかりをひき起,おこした。","tok":[["彼","かれ"],["ら"],["は"],["ほか"],["の"],["神々","かみがみ"],["に"],["仕えて","つかえて"],["、"],["主","しゅ"],["の"],["ねたみ"],["を"],["起こし","おこし"],["、"],["憎むべき","にくむべき"],["おこない"],["を"],["もって"],["主","しゅ"],["の"],["怒り","いかり"],["を"],["ひき起こした","ひきおこした"],["。"]]},{"verse":17,"text":"彼,かれらは神,かみでもない悪霊,あくれいに犠牲,ぎせいをささげた。それは彼,かれらがかつて知,しらなかった神々,かみがみ、近,ちかごろ出,でた新,あたらしい神々,かみがみ、先祖,せんぞたちの恐,おそれることもしなかった者,ものである。","tok":[["彼","かれ"],["ら"],["は"],["神","かみ"],["で"],["も"],["ない"],["悪霊","あくれい"],["に"],["犠牲","ぎせい"],["を"],["ささげた"],["。"],["それ"],["は"],["彼","かれ"],["ら"],["が"],["かつて"],["知らなかった","しらなかった"],["神々","かみがみ"],["、"],["近ごろ","ちかごろ"],["出た","でた"],["新らしい","あたらしい"],["神々","かみがみ"],["、"],["先祖","せんぞ"],["たち"],["の"],["恐れる","おそれる"],["こと"],["も"],["しなかった"],["者","もの"],["で"],["ある"],["。"]]},{"verse":18,"text":"あなたは自分,じぶんを生,うんだ岩,いわを軽,かろんじ、自分,じぶんを造,つくった神,かみを忘,わすれた。","tok":[["あなた"],["は"],["自分","じぶん"],["を"],["生んだ","うんだ"],["岩","いわ"],["を"],["軽んじ","かろんじ"],["、"],["自分","じぶん"],["を"],["造った","つくった"],["神","かみ"],["を"],["忘た","わすれた"],["。"]]},{"verse":19,"text":"主,しゅはこれを見,み、そのむすこ、娘,むすめを怒,いかってそれを捨,すてられた。","tok":[["主","しゅ"],["は"],["これ"],["を"],["見","み"],["、"],["その"],["むすこ"],["、"],["娘","むすめ"],["を"],["怒","い"],["か"],["って"],["それ"],["を"],["捨てられた","すてられた"],["。"]]},{"verse":20,"text":"そして言,いわれた、『わたしはわたしの顔,かおを彼,かれらに隠,かくそう。わたしは彼,かれらの終,おわりがどうなるかを見,みよう。彼,かれらはそむき、もとるやから、真実,しんじつのない子,こらである。","tok":[["そして"],["言われた","いわれた"],["、"],["『"],["わたし"],["は"],["わたし"],["の"],["顔","かお"],["を"],["彼","かれ"],["ら"],["に"],["隠そう","かくそう"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["終","おわり"],["が"],["どう"],["なる"],["か"],["を"],["見よう","みよう"],["。"],["彼","かれ"],["ら"],["は"],["そむき"],["、"],["もとるや"],["から"],["、"],["真実","しんじつ"],["の"],["ない"],["子","こ"],["ら"],["で"],["ある"],["。"]]},{"verse":21,"text":"彼,かれらは神,かみでもない者,ものをもって、わたしにねたみを起,おこさせ、偶像,ぐうぞうをもって、わたしを怒,いからせた。それゆえ、わたしは民,たみともいえない者,ものをもって、彼,かれらにねたみを起,おこさせ、愚,おろかな民,たみをもって、彼,かれらを怒,いからせるであろう。","tok":[["彼","かれ"],["ら"],["は"],["神","かみ"],["で"],["も"],["ない"],["者","もの"],["を"],["もって"],["、"],["わたし"],["に"],["ねたみ"],["を"],["起こさせ","おこさせ"],["、"],["偶像","ぐうぞう"],["を"],["もって"],["、"],["わたし"],["を"],["怒らせた","いからせた"],["。"],["それ"],["ゆえ"],["、"],["わたし"],["は"],["民","たみと"],["も"],["いえない"],["者","もの"],["を"],["もって"],["、"],["彼","かれ"],["ら"],["に"],["ねたみ"],["を"],["起こさせ","おこさせ"],["、"],["愚か","おろか"],["な"],["民","たみ"],["を"],["もって"],["、"],["彼","かれ"],["ら"],["を"],["怒らせるで","いからせるで"],["あろう"],["。"]]},{"verse":22,"text":"わたしの怒,いかりによって、火,ひは燃,もえいで、陰府,よみの深,ふかみにまで燃,もえ行,いき、地,ちとその産物,さんぶつとを焼,やきつくし、山々,やまやまの基,もといを燃,もやすであろう。","tok":[["わたし"],["の"],["怒り","いかり"],["によって"],["、"],["火","ひ"],["は"],["燃え","もえ"],["いで"],["、"],["陰府","よみ"],["の"],["深み","ふかみ"],["に"],["まで"],["燃え","もえ"],["行き","いき"],["、"],["地","ち"],["と"],["その"],["産物","さんぶつ"],["と"],["を"],["焼きつく","やきつく"],["し"],["、"],["山々","やまやま"],["の"],["基い","もとい"],["を"],["燃やすで","もやすで"],["あろう"],["。"]]},{"verse":23,"text":"わたしは彼,かれらの上,うえに災,わざわいを積,つみかさね、わたしの矢,やを彼,かれらにむかって射,いつくすであろう。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["災","わざわい"],["を"],["積みかさね","つみかさね"],["、"],["わたし"],["の"],["矢","や"],["を"],["彼","かれ"],["ら"],["に"],["むかって"],["射つ","いつ"],["くす"],["で"],["あろう"],["。"]]},{"verse":24,"text":"彼,かれらは飢,うえて、やせ衰,おとろえ、熱病,ねつびょうと悪,わるい疫病,えきびょうによって滅,ほろびるであろう。わたしは彼,かれらを獣,けものの歯,はにかからせ、地,ちに這,はうものの毒,どくにあたらせるであろう。","tok":[["彼","かれ"],["ら"],["は"],["飢","うえ"],["て"],["、"],["やせ衰え","やせおとろえ"],["、"],["熱病","ねつびょう"],["と"],["悪い","わるい"],["疫病","えきびょう"],["によって"],["滅びるで","ほろびるで"],["あろう"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["獣","けもの"],["の"],["歯","は"],["に"],["かからせ"],["、"],["地","ち"],["に"],["這う","はう"],["もの"],["の"],["毒","どく"],["に"],["あたらせるで"],["あろう"],["。"]]},{"verse":25,"text":"外,そとにはつるぎ、内,うちには恐,おそれがあって、若,わかき男,おとこも若,わかき女,おんなも、乳,ちのみ子,ごも、しらがの人,ひとも滅,ほろびるであろう。","tok":[["外","そと"],["に"],["は"],["つるぎ"],["、"],["内","うち"],["に"],["は"],["恐","おそれ"],["が"],["あって"],["、"],["若き","わかき"],["男","おとこ"],["も"],["若き","わかき"],["女","おんな"],["も"],["、"],["乳","ち"],["のみ"],["子","ご"],["も"],["、"],["しらが"],["の"],["人","ひと"],["も"],["滅びるで","ほろびるで"],["あろう"],["。"]]},{"verse":26,"text":"わたしはまさに言,いおうとした、「彼,かれらを遠,とおく散,ちらし、彼,かれらの事,ことを人々,ひとびとが記憶,きおくしないようにしよう」。","tok":[["わたし"],["は"],["まさに"],["言おう","いおう"],["と"],["した"],["、"],["「"],["彼","かれ"],["ら"],["を"],["遠く","とおく"],["散らし","ちらし"],["、"],["彼","かれ"],["ら"],["の"],["事","こと"],["を"],["人々","ひとびと"],["が"],["記憶","きおく"],["しない"],["よう"],["に"],["しよう"],["」"],["。"]]},{"verse":27,"text":"しかし、わたしは敵,てきが誇,ほこるのを恐,おそれる。あだびとはまちがえて言,いうであろう、「われわれの手,てが勝,かちをえたのだ。これはみな主,しゅがされたことではない」』。","tok":[["しかし"],["、"],["わたし"],["は"],["敵","てき"],["が"],["誇る","ほこる"],["の"],["を"],["恐れる","おそれる"],["。"],["あだ"],["び"],["と"],["は"],["まちがえて"],["言うで","いうで"],["あろう"],["、"],["「"],["われわれ"],["の"],["手","て"],["が"],["勝","かち"],["を"],["えた"],["の"],["だ"],["。"],["これ"],["は"],["みな"],["主","しゅ"],["が"],["された"],["こと"],["で"],["は"],["ない"],["」"],["』"],["。"]]},{"verse":28,"text":"彼,かれらは思慮,しりょの欠,かけた民,たみ、そのうちには知識,ちしきがない。","tok":[["彼","かれ"],["ら"],["は"],["思慮","しりょ"],["の"],["欠けた","かけた"],["民","たみ"],["、"],["その"],["うち"],["に"],["は"],["知識","ちしき"],["が"],["ない"],["。"]]},{"verse":29,"text":"もし、彼,かれらに知恵,ちえがあれば、これをさとり、その身,みの終,おわりをわきまえたであろうに。","tok":[["もし"],["、"],["彼","かれ"],["ら"],["に"],["知恵","ちえ"],["が"],["あれば"],["、"],["これ"],["を"],["さとり"],["、"],["その"],["身","み"],["の"],["終","おわり"],["を"],["わきまえたで"],["あろう"],["に"],["。"]]},{"verse":30,"text":"彼,かれらの岩,いわが彼,かれらを売,うらず、主,しゅが彼,かれらをわたされなかったならば、どうして、ひとりで千人,にんを追,おい、ふたりで万,まん人,にんを敗,やぶることができたであろう。","tok":[["彼","かれ"],["ら"],["の"],["岩","いわ"],["が"],["彼","かれ"],["ら"],["を"],["売らず","うらず"],["、"],["主","しゅ"],["が"],["彼","かれ"],["ら"],["を"],["わたされなかったならば"],["、"],["どう"],["して"],["、"],["ひとり"],["で"],["千人","にん"],["を"],["追い","おい"],["、"],["ふたり"],["で"],["万人","まんにん"],["を"],["敗る","やぶる"],["こと"],["が"],["できたで"],["あろう"],["。"]]},{"verse":31,"text":"彼,かれらの岩,いわはわれらの岩,いわに及,およばない。われらの敵,てきもこれを認,みとめている。","tok":[["彼","かれ"],["ら"],["の"],["岩","いわ"],["は"],["われ"],["ら"],["の"],["岩","いわ"],["に"],["及ばない","およばない"],["。"],["われ"],["ら"],["の"],["敵","てき"],["も"],["これ"],["を"],["認めて","みとめて"],["いる"],["。"]]},{"verse":32,"text":"彼,かれらのぶどうの木,きは、ソドムのぶどうの木,きから出,でたもの、またゴモラの野,のから出,でたもの、そのぶどうは毒,どくぶどう、そのふさは苦,にがい。","tok":[["彼","かれ"],["ら"],["の"],["ぶどう"],["の"],["木","き"],["は"],["、"],["ソドム"],["の"],["ぶどう"],["の"],["木","き"],["から"],["出た","でた"],["もの"],["、"],["また"],["ゴモラ"],["の"],["野","の"],["から"],["出た","でた"],["もの"],["、"],["その"],["ぶどう"],["は"],["毒","どく"],["ぶどう"],["、"],["その"],["ふさ"],["は"],["苦い","にがい"],["。"]]},{"verse":33,"text":"そのぶどう酒,しゅはへびの毒,どくのよう、まむしの恐,おそろしい毒,どくのようである。","tok":[["その"],["ぶどう酒","ぶどうしゅ"],["は"],["へび"],["の"],["毒","どく"],["の"],["よう"],["、"],["まむし"],["の"],["恐ろしい","おそろしい"],["毒","どく"],["の"],["よう"],["で"],["ある"],["。"]]},{"verse":34,"text":"これはわたしのもとにたくわえられ、わたしの倉,くらに封,ふうじ込,こめられているではないか。","tok":[["これ"],["は"],["わたし"],["の"],["もと"],["に"],["たくわえられ"],["、"],["わたし"],["の"],["倉","くら"],["に"],["封じ込められて","ふうじこめられて"],["いるで"],["は"],["ない"],["か"],["。"]]},{"verse":35,"text":"彼,かれらの足,あしがすべるとき、わたしはあだを返,かえし、報,むくいをするであろう。彼,かれらの災,わざわいの日,ひは近,ちかく、彼,かれらの破滅,はめつは、すみやかに来,くるであろう。","tok":[["彼","かれ"],["ら"],["の"],["足","あし"],["が"],["すべる"],["とき"],["、"],["わたし"],["は"],["あだ"],["を"],["返","かえし"],["、"],["報い","むくい"],["を"],["するで"],["あろう"],["。"],["彼","かれ"],["ら"],["の"],["災","わざわい"],["の"],["日","ひ"],["は"],["近く","ちかく"],["、"],["彼","かれ"],["ら"],["の"],["破滅","はめつ"],["は"],["、"],["すみやか"],["に"],["来るで","くるで"],["あろう"],["。"]]},{"verse":36,"text":"主,しゅはついにその民,たみをさばき、そのしもべらにあわれみを加,くわえられるであろう。これは彼,かれらの力,ちからがうせ去,さり、つながれた者,ものもつながれない者,ものも、もはやいなくなったのを、主,しゅが見,みられるからである。","tok":[["主","しゅ"],["は"],["ついに"],["その"],["民","たみ"],["を"],["さばき"],["、"],["その"],["しもべ"],["ら"],["に"],["あわれみ"],["を"],["加えられるで","くわえられるで"],["あろう"],["。"],["これ"],["は"],["彼","かれ"],["ら"],["の"],["力","ちから"],["が"],["うせ"],["去り","さり"],["、"],["つながれた"],["者","もの"],["も"],["つながれない"],["者","もの"],["も"],["、"],["もはや"],["いなく"],["なった"],["の"],["を"],["、"],["主","しゅ"],["が"],["見られる","みられる"],["から"],["で"],["ある"],["。"]]},{"verse":37,"text":"そのとき主,しゅは言,いわれるであろう、『彼,かれらの神々,かみがみはどこにいるか、彼,かれらの頼,たのみとした岩,いわはどこにあるか。","tok":[["その"],["とき"],["主","しゅ"],["は"],["言われるで","いわれるで"],["あろう"],["、"],["『"],["彼","かれ"],["ら"],["の"],["神々","かみがみ"],["は"],["どこ"],["に"],["いる"],["か"],["、"],["彼","かれ"],["ら"],["の"],["頼み","たのみ"],["と"],["した"],["岩","いわ"],["は"],["どこ"],["に"],["ある"],["か"],["。"]]},{"verse":38,"text":"彼,かれらの犠牲,ぎせいのあぶらを食,くい、灌祭,かんさいの酒,さけを飲,のんだ者,ものはどこにいるか。立,たちあがってあなたがたを助,たすけさせよ、あなたがたを守,まもらせよ。","tok":[["彼","かれ"],["ら"],["の"],["犠牲","ぎせい"],["の"],["あぶら"],["を"],["食い","くい"],["、"],["灌祭","かんさい"],["の"],["酒","さけ"],["を"],["飲んだ","のんだ"],["者","もの"],["は"],["どこ"],["に"],["いる"],["か"],["。"],["立ちあがって","たちあがって"],["あなた"],["がた"],["を"],["助けさせ","たすけさせ"],["よ"],["、"],["あなた"],["がた"],["を"],["守らせ","まもらせ"],["よ"],["。"]]},{"verse":39,"text":"今見,いまみよ、わたしこそは彼,かれである。わたしのほかに神,かみはない。わたしは殺,ころし、また生,いかし、傷,きずつけ、またいやす。わたしの手,てから救,すくい出,だしうるものはない。","tok":[["今","いま"],["見よ","みよ"],["、"],["わたし"],["こそ"],["は"],["彼","かれ"],["で"],["ある"],["。"],["わたし"],["の"],["ほか"],["に"],["神","かみ"],["は"],["ない"],["。"],["わたし"],["は"],["殺ろし","ころし"],["、"],["また"],["生かし","いかし"],["、"],["傷つけ","きずつけ"],["、"],["また"],["いやす"],["。"],["わたし"],["の"],["手","て"],["から"],["救い出し","すくいだし"],["うる"],["もの"],["は"],["ない"],["。"]]},{"verse":40,"text":"わたしは天,てんにむかい手,てをあげて誓,ちかう、「わたしは永遠,えいえんに生,いきる。","tok":[["わたし"],["は"],["天","てん"],["に"],["むかい"],["手","て"],["を"],["あげて"],["誓う","ちかう"],["、"],["「"],["わたし"],["は"],["永遠","えいえん"],["に"],["生きる","いきる"],["。"]]},{"verse":41,"text":"わたしがきらめくつるぎをとぎ、手,てにさばきを握,にぎるとき、わたしは敵,てきにあだを返,かえし、わたしを憎,にくむ者,ものに報復,ほうふくするであろう。","tok":[["わたし"],["が"],["きらめく"],["つるぎ"],["を"],["とぎ"],["、"],["手","て"],["に"],["さばき"],["を"],["握る","にぎる"],["とき"],["、"],["わたし"],["は"],["敵","てき"],["に"],["あだ"],["を"],["返","かえし"],["、"],["わたし"],["を"],["憎む","にくむ"],["者","もの"],["に"],["報復","ほうふく"],["するで"],["あろう"],["。"]]},{"verse":42,"text":"わたしの矢,やを血,ちに酔,よわせ、わたしのつるぎに肉,にくを食,くわせるであろう。殺,ころされた者,ものと捕,とらえられた者,ものの血,ちを飲,のませ、敵,てきの長髪,ちょうはつの頭,あたまの肉,にくを食,くわせるであろう」』。","tok":[["わたし"],["の"],["矢","や"],["を"],["血","ち"],["に"],["酔わせ","よわせ"],["、"],["わたし"],["の"],["つるぎ"],["に"],["肉","にく"],["を"],["食わせるで","くわせるで"],["あろう"],["。"],["殺ろされた","ころされた"],["者","もの"],["と"],["捕らえられた","とらえられた"],["者","もの"],["の"],["血","ち"],["を"],["飲ませ","のませ"],["、"],["敵","てき"],["の"],["長髪","ちょうはつ"],["の"],["頭","あたま"],["の"],["肉","にく"],["を"],["食わせるで","くわせるで"],["あろう"],["」"],["』"],["。"]]},{"verse":43,"text":"国々,くにぐにの民,たみよ、主,しゅの民,たみのために喜,よろこび歌,うたえ。主,しゅはそのしもべの血,ちのために報復,ほうふくし、その敵,てきにあだを返,かえし、その民,たみの地,ちの汚,けがれを清,きよめられるからである」。","tok":[["国々","くにぐに"],["の"],["民","たみ"],["よ"],["、"],["主","しゅ"],["の"],["民","たみ"],["の"],["ため"],["に"],["喜こび","よろこび"],["歌え","うたえ"],["。"],["主","しゅ"],["は"],["その"],["しもべ"],["の"],["血","ち"],["の"],["ため"],["に"],["報復","ほうふく"],["し"],["、"],["その"],["敵","てき"],["に"],["あだ"],["を"],["返","かえし"],["、"],["その"],["民","たみ"],["の"],["地","ち"],["の"],["汚","けがれ"],["を"],["清められる","きよめられる"],["から"],["で"],["ある"],["」"],["。"]]},{"verse":44,"text":"モーセとヌンの子,こヨシュアは共,ともに行,いって、この歌,うたの言葉,ことばを、ことごとく民,たみに読,よみ聞,きかせた。","tok":[["モーセ"],["と"],["ヌン"],["の"],["子","こ"],["ヨシュア"],["は"],["共","とも"],["に"],["行って","いって"],["、"],["この"],["歌","うた"],["の"],["言葉","ことば"],["を"],["、"],["ことごとく"],["民","たみ"],["に"],["読","よみ"],["聞かせた","きかせた"],["。"]]},{"verse":45,"text":"モーセはこの言葉,ことばを、ことごとくイスラエルのすべての人,ひとに告,つげ終,おわって、","tok":[["モーセ"],["は"],["この"],["言葉","ことば"],["を"],["、"],["ことごとく"],["イスラエル"],["の"],["すべて"],["の"],["人","ひと"],["に"],["告","つげ"],["終わって","おわって"],["、"]]},{"verse":46,"text":"彼,かれらに言,いった、「あなたがたはわたしが、きょう、あなたがたに命,めいじるこのすべての言葉,ことばを心,こころにおさめ、子供,こどもたちにもこの律法,りっぽうのすべての言葉,ことばを守,まもり行,おこなうことを命,めいじなければならない。","tok":[["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["わたし"],["が"],["、"],["きょう"],["、"],["あなた"],["がた"],["に"],["命じる","めいじる"],["この"],["すべて"],["の"],["言葉","ことば"],["を"],["心","こころ"],["に"],["おさめ"],["、"],["子供","こども"],["たち"],["に"],["も"],["この"],["律法","りっぽう"],["の"],["すべて"],["の"],["言葉","ことば"],["を"],["守り","まもり"],["行なう","おこなう"],["こと"],["を"],["命じなければ","めいじなければ"],["ならない"],["。"]]},{"verse":47,"text":"この言葉,ことばはあなたがたにとって、むなしい言葉,ことばではない。これはあなたがたのいのちである。この言葉,ことばにより、あなたがたはヨルダンを渡,わたって行,いって取,とる地,ちで、長,ながく命,いのちを保,たもつことができるであろう」。","tok":[["この"],["言葉","ことば"],["は"],["あなた"],["がた"],["にとって"],["、"],["むなしい"],["言葉","ことば"],["で"],["は"],["ない"],["。"],["これ"],["は"],["あなた"],["がた"],["の"],["いのち"],["で"],["ある"],["。"],["この"],["言葉","ことば"],["に"],["より"],["、"],["あなた"],["がた"],["は"],["ヨルダン"],["を"],["渡って","わたって"],["行って","いって"],["取る","とる"],["地","ち"],["で"],["、"],["長く","ながく"],["命","いのち"],["を"],["保つ","たもつ"],["こと"],["が"],["できるで"],["あろう"],["」"],["。"]]},{"verse":48,"text":"この日,ひ、主,しゅはモーセに言,いわれた、","tok":[["この"],["日","ひ"],["、"],["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":49,"text":"「あなたはエリコに対,たいするモアブの地,ちにあるアバリム山,やますなわちネボ山,やまに登,のぼり、わたしがイスラエルの人々,ひとびとに与,あたえて獲,えさせるカナンの地,ちを見渡,みわたせ。","tok":[["「"],["あなた"],["は"],["エリコ"],["に"],["対する","たいする"],["モアブ"],["の"],["地","ち"],["に"],["ある"],["アバリム"],["山","やま"],["すなわち"],["ネボ山","ねぼやま"],["に"],["登り","のぼり"],["、"],["わたし"],["が"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["与","あたえ"],["て"],["獲させる","えさせる"],["カナン"],["の"],["地","ち"],["を"],["見渡せ","みわたせ"],["。"]]},{"verse":50,"text":"あなたは登,のぼって行,いくその山,やまで死,しに、あなたの民,たみに連,つらなるであろう。あなたの兄弟,きょうだいアロンがホル山,やまで死,しんでその民,たみに連,つらなったようになるであろう。","tok":[["あなた"],["は"],["登って","のぼって"],["行く","いく"],["その"],["山","やま"],["で"],["死に","しに"],["、"],["あなた"],["の"],["民","たみ"],["に"],["連なるで","つらなるで"],["あろう"],["。"],["あなた"],["の"],["兄弟","きょうだい"],["アロン"],["が"],["ホル"],["山","やま"],["で"],["死んで","しんで"],["その"],["民","たみ"],["に"],["連なった","つらなった"],["よう"],["に"],["なるで"],["あろう"],["。"]]},{"verse":51,"text":"これはあなたがたがチンの荒野,あらのにあるメリバテ・カデシの水,みずのほとりで、イスラエルの人々,ひとびとのうちでわたしにそむき、イスラエルの人々,ひとびとのうちでわたしを聖,せいなるものとして敬,うやまわなかったからである。","tok":[["これ"],["は"],["あなた"],["がた"],["が"],["チン"],["の"],["荒野","あらの"],["に"],["ある"],["メリバテ"],["・"],["カデシ"],["の"],["水","みず"],["の"],["ほとり"],["で"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["うち"],["で"],["わたし"],["に"],["そむき"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["うち"],["で"],["わたし"],["を"],["聖","せい"],["なる"],["もの"],["として"],["敬わなかった","うやまわなかった"],["から"],["で"],["ある"],["。"]]},{"verse":52,"text":"それであなたはわたしがイスラエルの人々,ひとびとに与,あたえる地,ちを、目,めの前,まえに見,みるであろう。しかし、その地,ちに、はいることはできない」。","tok":[["それ"],["で"],["あなた"],["は"],["わたし"],["が"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["与える","あたえる"],["地","ち"],["を"],["、"],["目","め"],["の"],["前","まえ"],["に"],["見るで","みるで"],["あろう"],["。"],["しかし"],["、"],["その"],["地","ち"],["に"],["、"],["はいる"],["こと"],["は"],["できない"],["」"],["。"]]}]
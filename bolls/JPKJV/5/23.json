[{"verse":1,"text":"[22:30]だれも父,ちちの妻,つまをめとってはならない。父,ちちの妻,つまと寝,ねてはならない。","tok":[["["],["22"],[":"],["30"],["]"],["だれ"],["も"],["父","ちち"],["の"],["妻","つま"],["を"],["めとって"],["は"],["ならない"],["。"],["父","ちち"],["の"],["妻","つま"],["と"],["寝て","ねて"],["は"],["ならない"],["。"]]},{"verse":2,"text":"[1]すべて去勢,きょせいした男子,だんしは主,しゅの会衆,かいしゅうに加,くわわってはならない。","tok":[["["],["1"],["]"],["すべて"],["去勢","きょせい"],["した"],["男子","だんし"],["は"],["主","しゅ"],["の"],["会衆","かいしゅう"],["に"],["加わわって","くわわって"],["は"],["ならない"],["。"]]},{"verse":3,"text":"[2]私生児,しせいじは主,しゅの会衆,かいしゅうに加,くわわってはならない。その子孫,しそんは十代,だいまでも主,しゅの会衆,かいしゅうに加,くわわってはならない。","tok":[["["],["2"],["]"],["私生児","しせいじ"],["は"],["主","しゅ"],["の"],["会衆","かいしゅう"],["に"],["加わわって","くわわって"],["は"],["ならない"],["。"],["その"],["子孫","しそん"],["は"],["十","じゅう"],["代","だい"],["で"],["も"],["主","しゅ"],["の"],["会衆","かいしゅう"],["に"],["加わわって","くわわって"],["は"],["ならない"],["。"]]},{"verse":4,"text":"[3]アンモンびととモアブびとは主,しゅの会衆,かいしゅうに加,くわわってはならない。彼,かれらの子孫,しそんは十代,だいまでも、いつまでも主,しゅの会衆,かいしゅうに加,くわわってはならない。","tok":[["["],["3"],["]"],["アンモン"],["びと"],["と"],["モアブ"],["びと"],["は"],["主","しゅ"],["の"],["会衆","かいしゅう"],["に"],["加わわって","くわわって"],["は"],["ならない"],["。"],["彼","かれ"],["ら"],["の"],["子孫","しそん"],["は"],["十","じゅう"],["代","だい"],["で"],["も"],["、"],["いつ"],["まで"],["も"],["主","しゅ"],["の"],["会衆","かいしゅう"],["に"],["加わわって","くわわって"],["は"],["ならない"],["。"]]},{"verse":5,"text":"[4]これはあなたがたがエジプトから出,でてきた時,ときに、彼,かれらがパンと水,みずを携,たずさえてあなたがたを道,みちに迎,むかえず、アラム・ナハライムのペトルからベオルの子,こバラムを雇,やとって、あなたをのろわせようとしたからである。","tok":[["["],["4"],["]"],["これ"],["は"],["あなた"],["がた"],["が"],["エジプト"],["から"],["出て","でて"],["きた"],["時","とき"],["に"],["、"],["彼","かれ"],["ら"],["が"],["パン"],["と"],["水","みず"],["を"],["携えて","たずさえて"],["あなた"],["がた"],["を"],["道","みち"],["に"],["迎","むかえ"],["ず"],["、"],["アラム"],["・"],["ナハライム"],["の"],["ペトル"],["から"],["ベオル"],["の"],["子","こ"],["バラム"],["を"],["雇って","やとって"],["、"],["あなた"],["を"],["のろわせよう"],["と"],["した"],["から"],["で"],["ある"],["。"]]},{"verse":6,"text":"[5]しかし、あなたの神,かみ、主,しゅはバラムの言,いうことを聞,きこうともせず、あなたの神,かみ、主,しゅはあなたのために、そののろいを変,かえて、祝福,しゅくふくとされた。あなたの神,かみ、主,しゅがあなたを愛,あいされたからである。","tok":[["["],["5"],["]"],["しかし"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["バラム"],["の"],["言う","いう"],["こと"],["を"],["聞こう","きこう"],["と"],["も"],["せず"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["あなた"],["の"],["ため"],["に"],["、"],["その"],["のろい"],["を"],["変えて","かえて"],["、"],["祝福","しゅくふく"],["と"],["された"],["。"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["あなた"],["を"],["愛された","あいされた"],["から"],["で"],["ある"],["。"]]},{"verse":7,"text":"[6]あなたは一生,いっしょういつまでも彼,かれらのために平安,へいあんをも、幸福,こうふくをも求,もとめてはならない。","tok":[["["],["6"],["]"],["あなた"],["は"],["一生","いっしょう"],["いつ"],["まで"],["も"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["平安","へいあん"],["を"],["も"],["、"],["幸福","こうふく"],["を"],["も"],["求めて","もとめて"],["は"],["ならない"],["。"]]},{"verse":8,"text":"[7]あなたはエドムびとを憎,にくんではならない。彼,かれはあなたの兄弟,きょうだいだからである。またエジプトびとを憎,にくんではならない。あなたはかつてその国,くにの寄留者,きりゅうしゃであったからである。","tok":[["["],["7"],["]"],["あなた"],["は"],["エドム"],["びと"],["を"],["憎","にくん"],["で"],["は"],["ならない"],["。"],["彼","かれ"],["は"],["あなた"],["の"],["兄弟","きょうだい"],["だ"],["から"],["で"],["ある"],["。"],["また"],["エジプト"],["びと"],["を"],["憎","にくん"],["で"],["は"],["ならない"],["。"],["あなた"],["は"],["かつて"],["その"],["国","くに"],["の"],["寄留者","きりゅうしゃ"],["で"],["あった"],["から"],["で"],["ある"],["。"]]},{"verse":9,"text":"[8]そして彼,かれらが産,うんだ子,こどもは三代,だい目,めには、主,しゅの会衆,かいしゅうに加,くわわることができる。","tok":[["["],["8"],["]"],["そして"],["彼","かれ"],["ら"],["が"],["産んだ","うんだ"],["子ども","こども"],["は"],["三代","だ"],["い"],["目","め"],["に"],["は"],["、"],["主","しゅ"],["の"],["会衆","かいしゅう"],["に"],["加わわる","くわわる"],["こと"],["が"],["できる"],["。"]]},{"verse":10,"text":"[9]敵,てきを攻,せめるために出,でて陣営,じんえいにおる時,ときは、すべての汚,けがれた物,ものを避,さけなければならない。","tok":[["["],["9"],["]"],["敵","てき"],["を"],["攻める","せめる"],["ため"],["に"],["出て","でて"],["陣営","じんえい"],["に"],["おる"],["時","とき"],["は"],["、"],["すべて"],["の"],["汚","け"],["がれ"],["た"],["物","もの"],["を"],["避けなければ","さけなければ"],["ならない"],["。"]]},{"verse":11,"text":"[10]あなたがたのうちに、夜,よるの思,おもいがけない事,ことによって身,みの汚,けがれた人,ひとがあるならば、陣営,じんえいの外,そとに出,でなければならない。陣営,じんえいの内,うちに、はいってはならない。","tok":[["["],["10"],["]"],["あなた"],["がた"],["の"],["うち"],["に"],["、"],["夜","よる"],["の"],["思いがけない","おもいがけない"],["事","こと"],["によって"],["身","み"],["の"],["汚","け"],["がれ"],["た"],["人","ひと"],["が"],["あるならば"],["、"],["陣営","じんえい"],["の"],["外","そと"],["に"],["出なければ","でなければ"],["ならない"],["。"],["陣営","じんえい"],["の"],["内","うち"],["に"],["、"],["はいって"],["は"],["ならない"],["。"]]},{"verse":12,"text":"[11]しかし、夕方,ゆうがたになって、水,みずで身,みを洗,あらい、日,ひが没,ぼっして後,のち、陣営,じんえいの内,うちに、はいることができる。","tok":[["["],["11"],["]"],["しかし"],["、"],["夕方","ゆうがた"],["に"],["なって"],["、"],["水","みず"],["で"],["身","み"],["を"],["洗","あらい"],["、"],["日","ひ"],["が"],["没して","ぼっして"],["後","の"],["ち"],["、"],["陣営","じんえい"],["の"],["内","うち"],["に"],["、"],["はいる"],["こと"],["が"],["できる"],["。"]]},{"verse":13,"text":"[12]あなたはまた陣営,じんえいの外,そとに一つの所,ところを設,もうけておいて、用,ようをたす時,とき、そこに出,でて行,いかなければならない。","tok":[["["],["12"],["]"],["あなた"],["は"],["また"],["陣営","じんえい"],["の"],["外","そと"],["に"],["一","ひと"],["つ"],["の"],["所","ところ"],["を"],["設けて","もうけて"],["おいて"],["、"],["用","よう"],["を"],["たす"],["時","とき"],["、"],["そこ"],["に"],["出て","でて"],["行かなければ","いかなければ"],["ならない"],["。"]]},{"verse":14,"text":"[13]また武器,ぶきと共,ともに、くわを備,そなえ、外,そとに出,でて、かがむ時,とき、それをもって土,つちを掘,ほり、向,むきをかえて、出,でた物,ものをおおわなければならない。","tok":[["["],["13"],["]"],["また"],["武器","ぶき"],["と"],["共","とも"],["に"],["、"],["くわ"],["を"],["備","そなえ"],["、"],["外","そと"],["に"],["出て","でて"],["、"],["かがむ"],["時","とき"],["、"],["それ"],["を"],["もって"],["土","つち"],["を"],["掘","ほり"],["、"],["向き","むき"],["を"],["かえて"],["、"],["出た","でた"],["物","もの"],["を"],["おおわなければ"],["ならない"],["。"]]},{"verse":15,"text":"[14]あなたの神,かみ、主,しゅがあなたを救,すくい、敵,てきをあなたにわたそうと、陣営,じんえいの中,なかを歩,あゆまれるからである。ゆえに陣営,じんえいは聖,せいなる所,ところとして保,たもたなければならない。主,しゅがあなたのうちにきたない物,もののあるのを見,みて、離,はなれ去,さられることのないためである。","tok":[["["],["14"],["]"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["あなた"],["を"],["救い","すくい"],["、"],["敵","てき"],["を"],["あなた"],["に"],["わたそう"],["と"],["、"],["陣営","じんえい"],["の"],["中","なか"],["を"],["歩まれる","あゆまれる"],["から"],["で"],["ある"],["。"],["ゆえ"],["に"],["陣営","じんえい"],["は"],["聖","せい"],["なる"],["所","ところ"],["として"],["保たなければ","たもたなければ"],["ならない"],["。"],["主","しゅ"],["が"],["あなた"],["の"],["うち"],["に"],["きたない"],["物","もの"],["の"],["ある"],["の"],["を"],["見て","みて"],["、"],["離れ去られる","はなれさられる"],["こと"],["の"],["ない"],["ため"],["で"],["ある"],["。"]]},{"verse":16,"text":"[15]主人,しゅじんを避,さけて、あなたのところに逃,にげてきた奴隷,どれいを、その主人,しゅじんにわたしてはならない。","tok":[["["],["15"],["]"],["主人","しゅじん"],["を"],["避けて","さけて"],["、"],["あなた"],["の"],["ところ"],["に"],["逃て","にげて"],["きた"],["奴隷","どれい"],["を"],["、"],["その"],["主人","しゅじん"],["に"],["わたして"],["は"],["ならない"],["。"]]},{"verse":17,"text":"[16]その者,ものをあなたがたのうちに、あなたと共,ともにおらせ、町,まちの一つのうち、彼,かれが好,このんで選,えらぶ場所,ばしょに住,すませなければならない。彼,かれを虐待,ぎゃくたいしてはならない。","tok":[["["],["16"],["]"],["その"],["者","もの"],["を"],["あなた"],["がた"],["の"],["うち"],["に"],["、"],["あなた"],["と"],["共","とも"],["に"],["おらせ"],["、"],["町","まち"],["の"],["一","ひと"],["つ"],["の"],["うち"],["、"],["彼","かれ"],["が"],["好んで","このんで"],["選ぶ","えらぶ"],["場所","ばしょ"],["に"],["住ませなければ","すませなければ"],["ならない"],["。"],["彼","かれ"],["を"],["虐待","ぎゃくたい"],["して"],["は"],["ならない"],["。"]]},{"verse":18,"text":"[17]イスラエルの女子,じょしは神殿,しんでん娼婦,しょうふとなってはならない。またイスラエルの男子,だんしは神殿,しんでん男娼,だんしょうとなってはならない。","tok":[["["],["17"],["]"],["イスラエル"],["の"],["女子","じょし"],["は"],["神殿","しんでん"],["娼婦","しょうふ"],["と"],["なって"],["は"],["ならない"],["。"],["また"],["イスラエル"],["の"],["男子","だんし"],["は"],["神殿","しんでん"],["男娼","だんしょう"],["と"],["なって"],["は"],["ならない"],["。"]]},{"verse":19,"text":"[18]娼婦,しょうふの得,えた価,あたいまたは男娼,だんしょうの価,あたいをあなたの神,かみ、主,しゅの家,いえに携,たずさえて行,いって、どんな誓願,せいがんにも用,もちいてはならない。これはともにあなたの神,かみ、主,しゅの憎,にくまれるものだからである。","tok":[["["],["18"],["]"],["娼婦","しょうふ"],["の"],["得た","えた"],["価","あたい"],["また"],["は"],["男娼","だんしょう"],["の"],["価","あたい"],["を"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["家","いえ"],["に"],["携えて","たずさえて"],["行って","いって"],["、"],["どんな"],["誓願","せいがん"],["に"],["も"],["用いて","もちいて"],["は"],["ならない"],["。"],["これ"],["は"],["とも"],["に"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["憎まれる","にくまれる"],["もの"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":20,"text":"[19]兄弟,きょうだいに利息,りそくを取,とって貸,かしてはならない。金銭,きんせんの利息,りそく、食物,しょくもつの利息,りそくなどすべて貸,かして利息,りそくのつく物,ものの利息,りそくを取,とってはならない。","tok":[["["],["19"],["]"],["兄弟","きょうだい"],["に"],["利息","りそく"],["を"],["取って","とって"],["貸","かし"],["ては"],["ならない"],["。"],["金銭","きんせん"],["の"],["利息","りそく"],["、"],["食物","しょくもつ"],["の"],["利息","りそく"],["など"],["すべて"],["貸","かし"],["て"],["利息","りそく"],["の"],["つく"],["物","もの"],["の"],["利息","りそく"],["を"],["取って","とって"],["は"],["ならない"],["。"]]},{"verse":21,"text":"[20]外国,がいこく人,じんには利息,りそくを取,とって貸,かしてもよい。ただ兄弟,きょうだいには利息,りそくを取,とって貸,かしてはならない。これはあなたが、はいって取,とる地,ちで、あなたの神,かみ、主,しゅがすべてあなたのする事,ことに祝福,しゅくふくを与,あたえられるためである。","tok":[["["],["20"],["]"],["外国人","がいこくじん"],["に"],["は"],["利息","りそく"],["を"],["取って","とって"],["貸","かし"],["て"],["も"],["よい"],["。"],["ただ"],["兄弟","きょうだい"],["に"],["は"],["利息","りそく"],["を"],["取って","とって"],["貸","かし"],["ては"],["ならない"],["。"],["これ"],["は"],["あなた"],["が"],["、"],["はい"],["って"],["取る","とる"],["地","ち"],["で"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["すべて"],["あなた"],["の"],["する"],["事","こと"],["に"],["祝福","しゅくふく"],["を"],["与えられる","あたえられる"],["ため"],["で"],["ある"],["。"]]},{"verse":22,"text":"[21]あなたの神,かみ、主,しゅに誓願,せいがんをかける時,とき、それを果,はたすことを怠,おこたってはならない。あなたの神,かみ、主,しゅは必,かならずそれをあなたに求,もとめられるからである。それを怠,おこたるときは罪,つみを得,えるであろう。","tok":[["["],["21"],["]"],["あなた"],["の"],["神","かみ"],["、"],["主に","しゅに"],["誓願","せいがん"],["を"],["かける"],["時","とき"],["、"],["それ"],["を"],["果たす","はたす"],["こと"],["を"],["怠たって","おこたって"],["は"],["ならない"],["。"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["必","かならず"],["それ"],["を"],["あなた"],["に"],["求められる","もとめられる"],["から"],["で"],["ある"],["。"],["それ"],["を"],["怠たる","おこたる"],["とき"],["は"],["罪","つみ"],["を"],["得るで","えるで"],["あろう"],["。"]]},{"verse":23,"text":"[22]しかし、あなたが誓願,せいがんをかけないならば、罪,つみを得,えることはない。","tok":[["["],["22"],["]"],["しかし"],["、"],["あなた"],["が"],["誓願","せいがん"],["を"],["かけないならば"],["、"],["罪","つみ"],["を"],["得る","える"],["こと"],["は"],["ない"],["。"]]},{"verse":24,"text":"[23]あなたが口,くちで言,いった事,ことは守,まもって行,おこなわなければならない。あなたが口,くちで約束,やくそくした事,ことは、あなたの神,かみ、主,しゅにあなたが自発,じはつ的,まとに誓願,せいがんしたのだからである。","tok":[["["],["23"],["]"],["あなた"],["が"],["口","くち"],["で"],["言った","いった"],["事","こと"],["は"],["守って","まもって"],["行なわなければ","おこなわなければ"],["ならない"],["。"],["あなた"],["が"],["口","くち"],["で"],["約束","やくそく"],["した"],["事","こと"],["は"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主に","しゅに"],["あなた"],["が"],["自発的","じはつまと"],["に"],["誓願","せいがん"],["した"],["の"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":25,"text":"[24]あなたが隣人,りんじんのぶどう畑,はたけにはいる時,とき、そのぶどうを心,こころにまかせて飽,あきるほど食,たべてもよい。しかし、あなたの器,うつわの中,なかに取,とり入,いれてはならない。","tok":[["["],["24"],["]"],["あなた"],["が"],["隣人","りんじん"],["の"],["ぶどう"],["畑","はたけ"],["に"],["は"],["いる"],["時","とき"],["、"],["その"],["ぶどう"],["を"],["心","こころ"],["に"],["まかせて"],["飽きる","あきる"],["ほど"],["食べて","たべて"],["も"],["よい"],["。"],["しかし"],["、"],["あなた"],["の"],["器","うつわ"],["の"],["中","なか"],["に"],["取入","とりいれ"],["ては"],["ならない"],["。"]]},{"verse":26,"text":"[25]あなたが隣人,りんじんの麦畑,むぎばたけにはいる時,とき、手,てでその穂,ほを摘,つんで食,たべてもよい。しかし、あなたの隣人,りんじんの麦畑,むぎばたけにかまを入,いれてはならない。","tok":[["["],["25"],["]"],["あなた"],["が"],["隣人","りんじん"],["の"],["麦畑","むぎばたけ"],["に"],["は"],["いる"],["時","とき"],["、"],["手","て"],["で"],["その"],["穂","ほ"],["を"],["摘んで","つんで"],["食べて","たべて"],["も"],["よい"],["。"],["しかし"],["、"],["あなた"],["の"],["隣人","りんじん"],["の"],["麦畑","むぎばたけ"],["に"],["かま"],["を"],["入れて","いれて"],["は"],["ならない"],["。"]]}]
[{"verse":1,"text":"[11:12]エフライムは偽,いつわりをもって、わたしを囲,かこみ、イスラエルの家,いえは欺,あざむきをもって、わたしを囲,かこんだ。しかしユダはなお神,かみに知,しられ、聖,せいなる者,ものに向,むかって真実,しんじつである。","tok":[["["],["11"],[":"],["12"],["]"],["エフライム"],["は"],["偽り","いつわり"],["を"],["もって"],["、"],["わたし"],["を"],["囲み","かこみ"],["、"],["イスラエル"],["の"],["家","いえ"],["は"],["欺き","あざむき"],["を"],["もって"],["、"],["わたし"],["を"],["囲んだ","かこんだ"],["。"],["しかし"],["ユダ"],["は"],["なお"],["神","かみ"],["に"],["知られ","しられ"],["、"],["聖","せい"],["なる"],["者","もの"],["に"],["向かって","むかって"],["真実","しんじつ"],["で"],["ある"],["。"]]},{"verse":2,"text":"[1]エフライムはひねもす風,かぜを牧,ぼくし、東風,ひがしかぜを追,おい、偽,いつわりと暴虐,ぼうぎゃくとを増,まし加,くわえ、アッスリヤと取引,とりひきをなし、油,あぶらをエジプトに送,おくった。","tok":[["["],["1"],["]"],["エフライム"],["は"],["ひねもす"],["風","かぜ"],["を"],["牧","ぼ"],["くし"],["、"],["東風","ひ"],["が"],["し"],["かぜ"],["を"],["追い","おい"],["、"],["偽り","いつわり"],["と"],["暴虐","ぼうぎゃく"],["と"],["を"],["増し加え","ましくわえ"],["、"],["アッスリヤ"],["と"],["取引","とりひき"],["を"],["なし"],["、"],["油","あぶら"],["を"],["エジプト"],["に"],["送った","おくった"],["。"]]},{"verse":3,"text":"[2]主,しゅはユダと争,あらそい、ヤコブをそのしわざにしたがって罰,ばっし、そのおこないにしたがって報,むくいられる。","tok":[["["],["2"],["]"],["主","しゅ"],["は"],["ユダ"],["と"],["争い","あらそい"],["、"],["ヤコブ"],["を"],["その"],["しわざ"],["に"],["したがって"],["罰し","ばっし"],["、"],["その"],["おこない"],["に"],["したがって"],["報いられる","むくいられる"],["。"]]},{"verse":4,"text":"[3]ヤコブは胎,たいにいたとき、その兄弟,きょうだいのかかとを捕,とらえ、成人,せいじんしたとき神,かみと争,あらそった。","tok":[["["],["3"],["]"],["ヤコブ"],["は"],["胎","たい"],["に"],["いた"],["とき"],["、"],["その"],["兄弟","きょうだい"],["の"],["かかと"],["を"],["捕らえ","とらえ"],["、"],["成人","せいじん"],["した"],["とき"],["神","かみ"],["と"],["争った","あらそった"],["。"]]},{"verse":5,"text":"[4]彼,かれは天,てんの使,つかいと争,あらそって勝,かち、泣,ないてこれにあわれみを求,もとめた。彼,かれはベテルで神,かみに出会,であい、その所,ところで神,かみは彼,かれと語,かたられた。","tok":[["["],["4"],["]"],["彼","かれ"],["は"],["天","てん"],["の"],["使","つかい"],["と"],["争って","あらそって"],["勝","かち"],["、"],["泣いて","ないて"],["これ"],["に"],["あわれみ"],["を"],["求めた","もとめた"],["。"],["彼","かれ"],["は"],["ベテル"],["で"],["神","かみ"],["に"],["出会","であい"],["、"],["その"],["所","ところ"],["で"],["神","かみ"],["は"],["彼","かれ"],["と"],["語られた","かたられた"],["。"]]},{"verse":6,"text":"[5]主,しゅは万軍,ばんぐんの神,かみ、その名,なは主,しゅである。","tok":[["["],["5"],["]"],["主","しゅ"],["は"],["万","まん"],["軍","ぐん"],["の"],["神","かみ"],["、"],["その"],["名","な"],["は"],["主","しゅ"],["で"],["ある"],["。"]]},{"verse":7,"text":"[6]それゆえ、あなたはあなたの神,かみに帰,かえり、いつくしみと正,ただしきとを守,まもり、つねにあなたの神,かみを待,まち望,のぞめ。","tok":[["["],["6"],["]"],["それ"],["ゆえ"],["、"],["あなた"],["は"],["あなた"],["の"],["神","かみ"],["に"],["帰えり","かえり"],["、"],["いつくしみ"],["と"],["正き","ただしき"],["と"],["を"],["守り","まもり"],["、"],["つね"],["に"],["あなた"],["の"],["神","かみ"],["を"],["待ち望め","まちのぞめ"],["。"]]},{"verse":8,"text":"[7]商人,しょうにんはその手,てに偽,いつわりのはかりを持,もち、しえたげることを好,このむ。","tok":[["["],["7"],["]"],["商人","しょうにん"],["は"],["その"],["手","て"],["に"],["偽わり","いつわり"],["の"],["はかり"],["を"],["持","もち"],["、"],["し"],["えたげる"],["こと"],["を"],["好む","このむ"],["。"]]},{"verse":9,"text":"[8]エフライムは言,いった、「まことにわたしは富,とめる者,ものとなった。わたしは自分,じぶんために財宝,ざいほうを得,えた」と。しかし彼,かれのすべての富,とみもその犯,おかした罪,つみをつぐなうことはできない。","tok":[["["],["8"],["]"],["エフライム"],["は"],["言った","いった"],["、"],["「"],["まこと"],["に"],["わたし"],["は"],["富める","とめる"],["者","もの"],["と"],["なった"],["。"],["わたし"],["は"],["自分","じぶん"],["ため"],["に"],["財宝","ざいほう"],["を"],["得た","えた"],["」"],["と"],["。"],["しかし"],["彼","かれ"],["の"],["すべて"],["の"],["富","とみ"],["も"],["その"],["犯した","おかした"],["罪","つみ"],["を"],["つぐなう"],["こと"],["は"],["できない"],["。"]]},{"verse":10,"text":"[9]わたしはエジプトの国,くにを出,でたときから、あなたの神,かみ、主,しゅである。わたしは祭,まつりの日,ひのように、再,ふたたびあなたを天幕,てんまくに住,すまわせよう。","tok":[["["],["9"],["]"],["わたし"],["は"],["エジプト"],["の"],["国","くに"],["を"],["出た","でた"],["とき"],["から"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["で"],["ある"],["。"],["わたし"],["は"],["祭","まつり"],["の"],["日","ひ"],["の"],["よう"],["に"],["、"],["再び","ふたたび"],["あなた"],["を"],["天幕","てんまく"],["に"],["住まわせよう","すまわせよう"],["。"]]},{"verse":11,"text":"[10]わたしは預言者,よげんしゃたちに語,かたった。幻,まぼろしを多,おおく示,しめしたのはわたしである。わたしは預言者,よげんしゃたちによってたとえを語,かたった。","tok":[["["],["10"],["]"],["わたし"],["は"],["預言者","よげんしゃ"],["たち"],["に"],["語った","かたった"],["。"],["幻","まぼろし"],["を"],["多く","おおく"],["示めした","しめした"],["の"],["は"],["わたし"],["で"],["ある"],["。"],["わたし"],["は"],["預言者","よげんしゃ"],["たち"],["によって"],["たとえ"],["を"],["語った","かたった"],["。"]]},{"verse":12,"text":"[11]もしギレアデに不義,ふぎがあるなら、彼,かれらは必,かならずむなしき者,ものとなる。もし彼,かれらがギルガルで雄牛,おうしを犠牲,ぎせいにささげるなら、彼,かれらの祭壇,さいだんは畑,はたけのうねに積,つんだ石塚,いしづかのようになる。","tok":[["["],["11"],["]"],["もし"],["ギレアデ"],["に"],["不義","ふぎ"],["が"],["あるなら"],["、"],["彼","かれ"],["ら"],["は"],["必","かならず"],["むなしき"],["者","もの"],["と"],["なる"],["。"],["もし"],["彼","かれ"],["ら"],["が"],["ギルガル"],["で"],["雄牛","おうし"],["を"],["犠牲","ぎせい"],["に"],["ささげるなら"],["、"],["彼","かれ"],["ら"],["の"],["祭壇","さいだん"],["は"],["畑","はたけ"],["の"],["うね"],["に"],["積んだ","つんだ"],["石塚","いしづか"],["の"],["よう"],["に"],["なる"],["。"]]},{"verse":13,"text":"[12]（ヤコブはアラムの地,ちに逃,にげっていった。イスラエルは妻,つまをめとるために人,ひとに仕,つかえた。彼,かれは妻,つまをめとるために羊,ひつじを飼,かった。）","tok":[["["],["12"],["]"],["（"],["ヤコブ"],["は"],["アラム"],["の"],["地","ち"],["に"],["逃","にげ"],["って"],["いった"],["。"],["イスラエル"],["は"],["妻","つま"],["を"],["めとる"],["ため"],["に"],["人","ひと"],["に"],["仕えた","つかえた"],["。"],["彼","かれ"],["は"],["妻","つま"],["を"],["めとる"],["ため"],["に"],["羊","ひつじ"],["を"],["飼った","かった"],["。"],["）"]]},{"verse":14,"text":"[13]主,しゅはひとりの預言者,よげんしゃによって、イスラエルをエジプトから導,みちびき出,だし、ひとりの預言者,よげんしゃによってこれを守,まもられた。","tok":[["["],["13"],["]"],["主","しゅ"],["は"],["ひとり"],["の"],["預言者","よげんしゃ"],["によって"],["、"],["イスラエル"],["を"],["エジプト"],["から"],["導き出し","みちびきだし"],["、"],["ひとり"],["の"],["預言者","よげんしゃ"],["によって"],["これ"],["を"],["守られた","まもられた"],["。"]]},{"verse":15,"text":"[14]エフライムはいたく主,しゅを怒,いからせた。それゆえ主,しゅはその血,ちのとがを彼,かれの上,うえにのこし、そのはずかしめを彼,かれに返,かえされる。","tok":[["["],["14"],["]"],["エフライム"],["は"],["いたく"],["主","しゅ"],["を"],["怒らせた","いからせた"],["。"],["それ"],["ゆえ"],["主","しゅ"],["は"],["その"],["血","ち"],["の"],["とが"],["を"],["彼","かれ"],["の"],["上","うえ"],["に"],["のこし"],["、"],["その"],["はずかし"],["め"],["を"],["彼","かれ"],["に"],["返えされる","かえされる"],["。"]]}]
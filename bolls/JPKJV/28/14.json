[{"verse":1,"text":"[13:16]サマリヤはその神,かみにそむいたので、その罪,つみを負,おい、つるぎに倒,たおれ、その幼,おさな子,こは投,なげ砕,くだかれ、そのはらめる女,おんなは引,ひき裂,さかれる。","tok":[["["],["13"],[":"],["16"],["]"],["サマリヤ"],["は"],["その"],["神","かみ"],["に"],["そむいた"],["ので"],["、"],["その"],["罪","つみ"],["を"],["負い","おい"],["、"],["つるぎ"],["に"],["倒れ","たおれ"],["、"],["その"],["幼な子","おさなこ"],["は"],["投","なげ"],["砕かれ","くだかれ"],["、"],["その"],["はらめる"],["女","おんな"],["は"],["引裂かれる","ひきさかれる"],["。"]]},{"verse":2,"text":"[1]イスラエルよ、あなたの神,かみ、主,しゅに帰,かえれ。あなたは自分,じぶんの不義,ふぎによって、つまずいたからだ。","tok":[["["],["1"],["]"],["イスラエル"],["よ"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主に","しゅに"],["帰えれ","かえれ"],["。"],["あなた"],["は"],["自分","じぶん"],["の"],["不義","ふぎ"],["によって"],["、"],["つまずいた"],["から"],["だ"],["。"]]},{"verse":3,"text":"[2]あなたがたは言葉,ことばを携,たずさえて、主,しゅに帰,かえって言,いえ、「不義,ふぎはことごとくゆるして、よきものを受,うけいれてください。わたしたちは自分,じぶんのくちびるの実,みをささげます。","tok":[["["],["2"],["]"],["あなた"],["がた"],["は"],["言葉","ことば"],["を"],["携えて","たずさえて"],["、"],["主に","しゅに"],["帰えって","かえって"],["言え","いえ"],["、"],["「"],["不義","ふぎ"],["は"],["ことごとく"],["ゆるして"],["、"],["よき"],["もの"],["を"],["受","うけ"],["いれて"],["ください"],["。"],["わたしたち"],["は"],["自分","じぶん"],["の"],["くちびる"],["の"],["実","み"],["を"],["ささげます"],["。"]]},{"verse":4,"text":"[3]アッスリヤはわたしたちを助,たすけず、わたしたちは馬,うまに乗,のりません。わたしたちはもはや自分,じぶんたちの手,てのわざに向,むかって『われわれの神,かみ』とは言,いいません。みなしごはあなたによって、あわれみを得,えるでしょう」。","tok":[["["],["3"],["]"],["アッスリヤ"],["は"],["わたしたち"],["を"],["助けず","たすけず"],["、"],["わたしたち"],["は"],["馬","うま"],["に"],["乗","のり"],["ません"],["。"],["わたしたち"],["は"],["もはや"],["自分","じぶん"],["たち"],["の"],["手","て"],["の"],["わざ"],["に"],["向かって","むかって"],["『"],["われわれ"],["の"],["神","かみ"],["』"],["と"],["は"],["言いません","いいません"],["。"],["みなしご"],["は"],["あなた"],["によって"],["、"],["あわれみ"],["を"],["得るでしょう","えるでしょう"],["」"],["。"]]},{"verse":5,"text":"[4]わたしは彼,かれらのそむきをいやし、喜,よろこんでこれを愛,あいする。わたしの怒,いかりは彼,かれらを離,はなれ去,さったからである。","tok":[["["],["4"],["]"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["そむき"],["を"],["いやし"],["、"],["喜こんで","よろこんで"],["これ"],["を"],["愛する","あいする"],["。"],["わたし"],["の"],["怒り","いかり"],["は"],["彼","かれ"],["ら"],["を"],["離れ","はなれ"],["去た","さった"],["から"],["で"],["ある"],["。"]]},{"verse":6,"text":"[5]わたしはイスラエルに対,たいしては露,つゆのようになる。彼,かれはゆりのように花,はな咲,さき、ポプラのように根,ねを張,はり、","tok":[["["],["5"],["]"],["わたし"],["は"],["イスラエル"],["に対して","にたいして"],["は"],["露","つゆ"],["の"],["よう"],["に"],["なる"],["。"],["彼","かれ"],["は"],["ゆり"],["の"],["よう"],["に"],["花咲き","はなさき"],["、"],["ポプラ"],["の"],["よう"],["に"],["根","ね"],["を"],["張り","はり"],["、"]]},{"verse":7,"text":"[6]その枝,えだは茂,しげりひろがり、その麗,うるわしさはオリブの木,きのように、そのかんばしさはレバノンのようになる。","tok":[["["],["6"],["]"],["その"],["枝","えだ"],["は"],["茂り","しげり"],["ひろがり"],["、"],["その"],["麗わし","うるわし"],["さ"],["は"],["オリブ"],["の"],["木","き"],["の"],["よう"],["に"],["、"],["その"],["かんばし"],["さ"],["は"],["レバノン"],["の"],["よう"],["に"],["なる"],["。"]]},{"verse":8,"text":"[7]彼,かれらは帰,かえって来,きて、わが陰,かげに住,すみ、園,そののように栄,さかえ、ぶどうの木,きのように花,はな咲,さき、そのかんばしさはレバノンの酒,さけのようになる。","tok":[["["],["7"],["]"],["彼","かれ"],["ら"],["は"],["帰えって","かえって"],["来て","きて"],["、"],["わが"],["陰","かげ"],["に"],["住み","すみ"],["、"],["園","その"],["の"],["よう"],["に"],["栄","さかえ"],["、"],["ぶどう"],["の"],["木","き"],["の"],["よう"],["に"],["花咲き","はなさき"],["、"],["その"],["かんばし"],["さ"],["は"],["レバノン"],["の"],["酒","さけ"],["の"],["よう"],["に"],["なる"],["。"]]},{"verse":9,"text":"[8]エフライムよ、わたしは偶像,ぐうぞうとなんの係,かかわりがあろうか。あなたに答,こたえ、あなたを顧,かえりみる者,ものはわたしである。わたしは緑,みどりのいとすぎのようだ。あなたはわたしから実,みを得,える。","tok":[["["],["8"],["]"],["エフライム"],["よ"],["、"],["わたし"],["は"],["偶像","ぐうぞう"],["と"],["なん"],["の"],["係わり","かかわり"],["が"],["あろう"],["か"],["。"],["あなた"],["に"],["答","こたえ"],["、"],["あなた"],["を"],["顧る","かえりみる"],["者","もの"],["は"],["わたし"],["で"],["ある"],["。"],["わたし"],["は"],["緑","みどり"],["の"],["いと"],["すぎ"],["の"],["よう"],["だ"],["。"],["あなた"],["は"],["わたし"],["から"],["実","み"],["を"],["得る","える"],["。"]]},{"verse":10,"text":"[9]知恵,ちえのある者,ものはだれか。その人,ひとにこれらのことを悟,さとらせよ。悟,さとりある者,ものはだれか。その人,ひとにこれらのことを知,しらせよ。主,しゅの道,みちは直,なおく、正,ただしき者,ものはこれを歩,あゆむ。しかし罪,つみびとはこれにつまずく。","tok":[["["],["9"],["]"],["知恵","ちえ"],["の"],["ある"],["者","もの"],["は"],["だれ"],["か"],["。"],["その"],["人","ひと"],["に"],["これ"],["ら"],["の"],["こと"],["を"],["悟らせ","さとらせ"],["よ"],["。"],["悟り","さとり"],["ある"],["者","もの"],["は"],["だれ"],["か"],["。"],["その"],["人","ひと"],["に"],["これ"],["ら"],["の"],["こと"],["を"],["知らせ","しらせ"],["よ"],["。"],["主","しゅ"],["の"],["道","みち"],["は"],["直","な"],["おく"],["、"],["正き者","ただしきもの"],["は"],["これ"],["を"],["歩む","あゆむ"],["。"],["しかし"],["罪びと","つみびと"],["は"],["これ"],["に"],["つまずく"],["。"]]}]
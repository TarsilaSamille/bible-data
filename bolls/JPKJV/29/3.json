[{"verse":1,"text":"[2:28]その後,のちわたしはわが霊,れいをすべての肉,にくなる者,ものに注,そそぐ。あなたがたのむすこ、娘,むすめは預言,よげんをし、あなたがたの老人,ろうじんたちは夢,ゆめを見,み、あなたがたの若者,わかものたちは幻,まぼろしを見,みる。","tok":[["["],["2"],[":"],["28"],["]"],["その後","そののちわたし"],["は"],["わが"],["霊","れい"],["を"],["すべて"],["の"],["肉","にく"],["なる"],["者","もの"],["に"],["注ぐ","そそぐ"],["。"],["あなた"],["がた"],["の"],["むすこ"],["、"],["娘","むすめ"],["は"],["預言","よげん"],["を"],["し"],["、"],["あなた"],["がた"],["の"],["老人","ろうじん"],["たち"],["は"],["夢","ゆめ"],["を"],["見","み"],["、"],["あなた"],["がた"],["の"],["若者","わかもの"],["たち"],["は"],["幻","まぼろし"],["を"],["見る","みる"],["。"]]},{"verse":2,"text":"[2:29]その日,ひわたしはまたわが霊,れいをしもべ、はしために注,そそぐ。","tok":[["["],["2"],[":"],["29"],["]"],["その"],["日","ひ"],["わたし"],["は"],["また"],["わが"],["霊","れい"],["を"],["しもべ"],["、"],["はし"],["ため"],["に"],["注ぐ","そそぐ"],["。"]]},{"verse":3,"text":"[2:30]わたしはまた、天,てんと地,ちとにしるしを示,しめす。すなわち血,ちと、火,ひと、煙,けむりの柱,はしらとがあるであろう。","tok":[["["],["2"],[":"],["30"],["]"],["わたし"],["は"],["また"],["、"],["天","てん"],["と"],["地","ち"],["と"],["に"],["しるし"],["を"],["示めす","しめす"],["。"],["すなわち"],["血","ち"],["と"],["、"],["火","ひ"],["と"],["、"],["煙","けむり"],["の"],["柱","はしら"],["と"],["が"],["あるで"],["あろう"],["。"]]},{"verse":4,"text":"[2:31]主,しゅの大,おおいなる恐,おそるべき日,ひが来,くる前,まえに、日,ひは暗,くらく、月,つきは血,ちに変,かわる。","tok":[["["],["2"],[":"],["31"],["]"],["主","しゅ"],["の"],["大いなる","おおいなる"],["恐るべき","おそるべき"],["日","ひ"],["が"],["来る","くる"],["前","まえ"],["に"],["、"],["日","ひ"],["は"],["暗く","くらく"],["、"],["月","つき"],["は"],["血","ち"],["に"],["変わる","かわる"],["。"]]},{"verse":5,"text":"[2:32]すべて主,しゅの名,なを呼,よぶ者,ものは救,すくわれる。それは主,しゅが言,いわれたように、シオンの山,やまとエルサレムとに、のがれる者,ものがあるからである。その残,のこった者,もののうちに、主,しゅのお召,めしになる者,ものがある。","tok":[["["],["2"],[":"],["32"],["]"],["すべて"],["主","しゅ"],["の"],["名","な"],["を"],["呼ぶ","よぶ"],["者","もの"],["は"],["救われる","すくわれる"],["。"],["それ"],["は"],["主","しゅ"],["が"],["言われた","いわれた"],["よう"],["に"],["、"],["シオン"],["の"],["山","やま"],["と"],["エルサレム"],["と"],["に"],["、"],["のがれる"],["者","もの"],["が"],["ある"],["から"],["で"],["ある"],["。"],["その"],["残った","のこった"],["者","もの"],["の"],["うち"],["に"],["、"],["主","しゅ"],["の"],["お召","おめし"],["に"],["なる"],["者","もの"],["が"],["ある"],["。"]]}]
[{"verse":1,"text":"主,しゅからエレミヤに臨,のぞんだ言葉,ことば。","tok":[["主ら","しゅから"],["エレミヤ"],["に"],["臨んだ","のぞんだ"],["言葉","ことば"],["。"]]},{"verse":2,"text":"「立,たって、陶器,とうき師,しの家,いえに下,くだって行,いきなさい。その所,ところでわたしはあなたにわたしの言葉,ことばを聞,きかせよう」。","tok":[["「"],["立って","たって"],["、"],["陶器師","とうきし"],["の"],["家","いえ"],["に"],["下って","くだって"],["行き","いき"],["なさい"],["。"],["その"],["所","ところ"],["で"],["わたし"],["は"],["あなた"],["に"],["わたし"],["の"],["言葉","ことば"],["を"],["聞かせよう","きかせよう"],["」"],["。"]]},{"verse":3,"text":"わたしは陶器,とうき師,しの家,いえへ下,くだって行,いった。見,みると彼,かれは、ろくろで仕事,しごとをしていたが、","tok":[["わたし"],["は"],["陶器師","とうきし"],["の"],["家","いえ"],["へ"],["下って","くだって"],["行った","いった"],["。"],["見る","みる"],["と"],["彼","かれ"],["は"],["、"],["ろくろ"],["で"],["仕事","しごと"],["を"],["して"],["いた"],["が"],["、"]]},{"verse":4,"text":"粘土,ねんどで造,つくっていた器,うつわが、その人,ひとの手,ての中,なかで仕損,しそんじたので、彼,かれは自分,じぶんの意,いのままに、それをもってほかの器,うつわを造,つくった。","tok":[["粘土","ねんど"],["で"],["造って","つくって"],["いた"],["器","うつわ"],["が"],["、"],["その"],["人","ひと"],["の"],["手","て"],["の"],["中","なか"],["で"],["仕","し"],["損じた","そんじた"],["ので"],["、"],["彼","かれ"],["は"],["自分","じぶん"],["の"],["意","い"],["の"],["まま"],["に"],["、"],["それ"],["を"],["もって"],["ほか"],["の"],["器","うつわ"],["を"],["造った","つくった"],["。"]]},{"verse":5,"text":"その時,とき、主,しゅの言葉,ことばがわたしに臨,のぞんだ、","tok":[["その"],["時","とき"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":6,"text":"「主,しゅは仰,おおせられる、イスラエルの家,いえよ、この陶器,とうき師,しがしたように、わたしもあなたがたにできないのだろうか。イスラエルの家,いえよ、陶器,とうき師,しの手,てに粘土,ねんどがあるように、あなたがたはわたしの手,てのうちにある。","tok":[["「"],["主","しゅ"],["は"],["仰せられる","おおせられる"],["、"],["イスラエル"],["の"],["家","いえ"],["よ"],["、"],["この"],["陶器師","とうきし"],["が"],["した"],["よう"],["に"],["、"],["わたし"],["も"],["あなた"],["がた"],["に"],["できない"],["の"],["だろう"],["か"],["。"],["イスラエル"],["の"],["家","いえ"],["よ"],["、"],["陶器師","とうきし"],["の"],["手","て"],["に"],["粘土","ねんど"],["が"],["ある"],["よう"],["に"],["、"],["あなた"],["がた"],["は"],["わたし"],["の"],["手","て"],["の"],["うち"],["に"],["ある"],["。"]]},{"verse":7,"text":"ある時,ときには、わたしが民,たみまたは国,くにを抜,ぬく、破,やぶる、滅,ほろぼすということがあるが、","tok":[["ある"],["時","とき"],["に"],["は"],["、"],["わたし"],["が"],["民","たみ"],["また"],["は"],["国","くに"],["を"],["抜く","ぬく"],["、"],["破る","やぶる"],["、"],["滅ぼす","ほろぼす"],["と"],["いう"],["こと"],["が"],["ある"],["が"],["、"]]},{"verse":8,"text":"もしわたしの言,いった国,くにがその悪,あくを離,はなれるならば、わたしはこれに災,わざわいを下,くだそうとしたことを思,おもいかえす。","tok":[["もし"],["わたし"],["の"],["言った","いった"],["国","くに"],["が"],["その"],["悪","あく"],["を"],["離れるならば","はなれるならば"],["、"],["わたし"],["は"],["これ"],["に"],["災","わざわい"],["を"],["下そう","くだそう"],["と"],["した"],["こと"],["を"],["思いかえす","おもいかえす"],["。"]]},{"verse":9,"text":"またある時,ときには、わたしが民,たみまたは国,くにを建,たてる、植,うえるということがあるが、","tok":[["また"],["ある"],["時","とき"],["に"],["は"],["、"],["わたし"],["が"],["民","たみ"],["また"],["は"],["国","くに"],["を"],["建てる","たてる"],["、"],["植える","うえる"],["と"],["いう"],["こと"],["が"],["ある"],["が"],["、"]]},{"verse":10,"text":"もしその国,くにがわたしの目,めに悪,あくと見,みえることを行,おこない、わたしの声,こえに聞,きき従,したがわないなら、わたしはこれに幸,さいわいを与,あたえようとしたことを思,おもいかえす。","tok":[["もし"],["その"],["国","くに"],["が"],["わたし"],["の"],["目","め"],["に"],["悪","あく"],["と"],["見える","みえる"],["こと"],["を"],["行ない","おこない"],["、"],["わたし"],["の"],["声","こえ"],["に"],["聞","きき"],["従わないなら","したがわないなら"],["、"],["わたし"],["は"],["これ"],["に"],["幸い","さいわい"],["を"],["与","あたえ"],["よう"],["と"],["した"],["こと"],["を"],["思いかえす","おもいかえす"],["。"]]},{"verse":11,"text":"それゆえ、ユダの人々,ひとびととエルサレムに住,すむ者,ものに言,いいなさい、『主,しゅはこう仰,おおせられる、見,みよ、わたしはあなたがたに災,わざわいを下,くだそうと工夫,くふうし、あなたがたを攻,せめる計,はかりごとを立,たてている。あなたがたはおのおのその悪,あしき道,みちを離,はなれ、その道,みちと行,おこないを改,あらためなさい』と。","tok":[["それ"],["ゆえ"],["、"],["ユダ"],["の"],["人々","ひとびと"],["と"],["エルサレム"],["に"],["住む","すむ"],["者","もの"],["に"],["言い","いい"],["なさい"],["、"],["『"],["主","しゅ"],["は"],["こう"],["仰せられる","おおせられる"],["、"],["見よ","みよ"],["、"],["わたし"],["は"],["あなた"],["がた"],["に"],["災","わざわい"],["を"],["下そう","くだそう"],["と"],["工夫","くふう"],["し"],["、"],["あなた"],["がた"],["を"],["攻める","せめる"],["計り","はかり"],["ごと"],["を"],["立て","たてて"],["いる"],["。"],["あなた"],["がた"],["は"],["おのおの"],["その"],["悪しき","あしき"],["道","みち"],["を"],["離れ","はなれ"],["、"],["その"],["道","みち"],["と"],["行ない","おこない"],["を"],["改め","あらため"],["なさい"],["』"],["と"],["。"]]},{"verse":12,"text":"しかし彼,かれらは言,いう、『それはむだです。われわれは自分,じぶんの図,はかるところに従,したがい、おのおのその悪,わるい強情,ごうじょうな心,こころにしたがって行動,こうどうします』と。","tok":[["しかし"],["彼","かれ"],["ら"],["は"],["言う","いう"],["、"],["『"],["それ"],["は"],["むだ"],["です"],["。"],["われわれ"],["は"],["自分","じぶん"],["の"],["図る","はかる"],["ところ"],["に"],["従い","したがい"],["、"],["おのおの"],["その"],["悪い","わるい"],["強情","ごうじょう"],["な"],["心","こころ"],["に"],["したがって"],["行動","こうどう"],["します"],["』"],["と"],["。"]]},{"verse":13,"text":"それゆえ主,しゅはこう言,いわれる、異邦,いほうの民,たみのうちのある者,ものに尋,たずねてみよ、このような事,ことを聞,きいた者,ものがあろうか。おとめイスラエルは恐,おそろしい事,ことをした。","tok":[["それ"],["ゆえ"],["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["異邦","いほう"],["の"],["民","たみ"],["の"],["うち"],["の"],["ある"],["者","もの"],["に"],["尋ねて","たずねて"],["みよ"],["、"],["この"],["よう"],["な"],["事","こと"],["を"],["聞いた","きいた"],["者","もの"],["が"],["あろう"],["か"],["。"],["おとめ"],["イスラエル"],["は"],["恐ろしい","おそろしい"],["事","こと"],["を"],["した"],["。"]]},{"verse":14,"text":"レバノンの雪,ゆきが、どうしてシリオンの岩,いわを離,はなれようか。山,やまの水,みず、冷,つめたい川,かわの流,ながれが、どうしてかわいてしまおうか。","tok":[["レバノン"],["の"],["雪","ゆき"],["が"],["、"],["どう"],["して"],["シリオン"],["の"],["岩","いわ"],["を"],["離れよう","はなれよう"],["か"],["。"],["山","やま"],["の"],["水","みず"],["、"],["冷たい","つめたい"],["川","かわ"],["の"],["流れ","ながれ"],["が"],["、"],["どう"],["して"],["かわいて"],["しまおう"],["か"],["。"]]},{"verse":15,"text":"それなのにわが民,たみはわたしを忘,わすれて、偽,いつわりの神々,かみがみに香,こうをたいている。彼,かれらはその道,みち、古,ふるい道,みちにつまずき、また小道,こみちに入,いり、大路,おおじからはなれた。","tok":[["それ"],["な"],["のに"],["わが"],["民","たみ"],["は"],["わたし"],["を"],["忘て","わすれて"],["、"],["偽わり","いつわり"],["の"],["神々","かみがみ"],["に"],["香","こう"],["を"],["たいて"],["いる"],["。"],["彼","かれ"],["ら"],["は"],["その"],["道","みち"],["、"],["古い","ふるい"],["道","みち"],["に"],["つまずき"],["、"],["また"],["小道","こみち"],["に"],["入","いり"],["、"],["大路","おおじ"],["から"],["はなれた"],["。"]]},{"verse":16,"text":"自分,じぶんの地,ちを荒,あれすたれさせて、いつまでも人,ひとに舌打,したうちされるものとした。そこを通,とおる人,ひとはみな身震,みぶるいして、首,くびを振,ふる。","tok":[["自分","じぶん"],["の"],["地","ち"],["を"],["荒れ","あれ"],["すたれさせて"],["、"],["いつ"],["まで"],["も"],["人","ひと"],["に"],["舌打ち","したうち"],["される"],["もの"],["と"],["した"],["。"],["そこ"],["を"],["通る","とおる"],["人","ひと"],["は"],["みな"],["身震い","みぶるい"],["して"],["、"],["首","くび"],["を"],["振る","ふる"],["。"]]},{"verse":17,"text":"わたしは東風,ひがしかぜのように、彼,かれらをその敵,てきの前,まえに散,ちらす。その滅,ほろびの日,ひには、わたしは彼,かれらに背,せを向,むけ、顔,かおを向,むけない」。","tok":[["わたし"],["は"],["東風","ひ"],["が"],["し"],["かぜ"],["の"],["よう"],["に"],["、"],["彼","かれ"],["ら"],["を"],["その"],["敵","てき"],["の"],["前","まえ"],["に"],["散らす","ちらす"],["。"],["その"],["滅び","ほろび"],["の"],["日","ひ"],["に"],["は"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["に"],["背","せ"],["を"],["向け","むけ"],["、"],["顔","かお"],["を"],["向けない","むけない"],["」"],["。"]]},{"verse":18,"text":"彼,かれらは言,いった、「さあ、計略,けいりゃくをめぐらして、エレミヤを倒,たおそう。祭司,さいしには律法,りっぽうがあり、知恵,ちえある者,ものには計,はかりごとがあり、預言者,よげんしゃには言葉,ことばがあって、これらのものが滅,ほろびてしまうことはない。さあ、われわれは舌,したをもって彼,かれを撃,うとう。彼,かれのすべての言葉,ことばに、心,こころを留,とめないことにしよう」。","tok":[["彼","かれ"],["ら"],["は"],["言った","いった"],["、"],["「"],["さあ"],["、"],["計略","けいりゃく"],["を"],["めぐらして"],["、"],["エレミヤ"],["を"],["倒そう","たおそう"],["。"],["祭司","さいし"],["に"],["は"],["律法","りっぽう"],["が"],["あり"],["、"],["知恵","ちえ"],["ある"],["者","もの"],["に"],["は"],["計り","はかり"],["ごと"],["が"],["あり"],["、"],["預言者","よげんしゃ"],["に"],["は"],["言葉","ことば"],["が"],["あって"],["、"],["これ"],["ら"],["の"],["もの"],["が"],["滅びて","ほろびて"],["しまう"],["こと"],["は"],["ない"],["。"],["さあ"],["、"],["われわれ"],["は"],["舌","した"],["を"],["もって"],["彼","かれ"],["を"],["撃とう","うとう"],["。"],["彼","かれ"],["の"],["すべて"],["の"],["言葉","ことば"],["に"],["、"],["心","こころ"],["を"],["留","とめ"],["ない"],["こと"],["に"],["しよう"],["」"],["。"]]},{"verse":19,"text":"主,しゅよ、どうぞわたしにみ心,こころを留,とめ、わたしの訴,うったえをお聞,ききください。","tok":[["主","しゅ"],["よ"],["、"],["どうぞ"],["わたし"],["に"],["み心","みこころ"],["を"],["留","とめ"],["、"],["わたし"],["の"],["訴","うったえ"],["を"],["お聞く","おききく"],["ださい"],["。"]]},{"verse":20,"text":"悪,あくをもって善,ぜんに報,むくいるべきでしょうか。しかもなお彼,かれらはわたしの命,いのちを取,とろうとして穴,あなを掘,ほりました。わたしがあなたの前,まえに立,たって、彼,かれらのことを良,よく言,いい、あなたの憤,いきどおりを止,とめようとしたのを覚,おぼえてください。","tok":[["悪","あく"],["を"],["もって"],["善","ぜん"],["に"],["報いるべきでしょう","むくいるべきでしょう"],["か"],["。"],["しかも"],["なお"],["彼","かれ"],["ら"],["は"],["わたし"],["の"],["命","いのち"],["を"],["取ろう","とろう"],["として"],["穴","あな"],["を"],["掘","ほり"],["ました"],["。"],["わたし"],["が"],["あなた"],["の"],["前","まえ"],["に"],["立って","たって"],["、"],["彼","かれ"],["ら"],["の"],["こと"],["を"],["良く","よく"],["言い","いい"],["、"],["あなた"],["の"],["憤り","いきどおり"],["を"],["止","とめ"],["よう"],["と"],["した"],["の"],["を"],["覚えて","おぼえて"],["ください"],["。"]]},{"verse":21,"text":"それゆえ、彼,かれらの子,こどもたちをききんに渡,わたし、彼,かれらをつるぎの刃,はに渡,わたしてください。彼,かれらの妻,つまは子,こを失,うしない、また寡婦,かふとなり、男,おとこは疫病,えきびょうにかかって死,しに、若,わかい者,ものは、戦争,せんそうでつるぎに殺,ころされますように。","tok":[["それ"],["ゆえ"],["、"],["彼","かれ"],["ら"],["の"],["子ども","こども"],["たち"],["を"],["ききん"],["に"],["渡","わたし"],["、"],["彼","かれ"],["ら"],["を"],["つるぎ"],["の"],["刃","は"],["に"],["渡","わたし"],["て"],["ください"],["。"],["彼","かれ"],["ら"],["の"],["妻","つま"],["は"],["子","こ"],["を"],["失ない","うしない"],["、"],["また"],["寡婦","かふ"],["と"],["なり"],["、"],["男","おとこ"],["は"],["疫病","えきびょう"],["に"],["かかって"],["死に","しに"],["、"],["若い","わかい"],["者","もの"],["は"],["、"],["戦争","せんそう"],["で"],["つるぎ"],["に"],["殺ろされます","ころされます"],["よう"],["に"],["。"]]},{"verse":22,"text":"あなたが敵,てきをにわかに彼,かれらに臨,のぞませられるとき、彼,かれらの家,いえから叫,さけび声,ごえが聞,きこえますように。彼,かれらは穴,あなを掘,ほって、わたしを捕,とらえようとし、わなをつくって、わたしの足,あしを捕,とらえようとしたからです。","tok":[["あなた"],["が"],["敵","てき"],["を"],["にわか"],["に"],["彼","かれ"],["ら"],["に"],["臨ませられる","のぞませられる"],["とき"],["、"],["彼","かれ"],["ら"],["の"],["家","いえ"],["から"],["叫声","さけびご"],["え"],["が"],["聞こえます","きこえます"],["よう"],["に"],["。"],["彼","かれ"],["ら"],["は"],["穴","あな"],["を"],["掘って","ほって"],["、"],["わたし"],["を"],["捕らえよう","とらえよう"],["と"],["し"],["、"],["わな"],["を"],["つくって"],["、"],["わたし"],["の"],["足","あし"],["を"],["捕らえよう","とらえよう"],["と"],["した"],["から"],["です"],["。"]]},{"verse":23,"text":"主,しゅよ、あなたは彼,かれらがわたしを殺,ころすためにめぐらしている計略,けいりゃくを皆,みなごぞんじです。その悪,あくをゆるすことなく、その罪,つみをあなたの前,まえから消,けし去,さらないでください。彼,かれらをあなたの前,まえに倒,たおれさせてください。あなたのお怒,いかりになる時,ときに彼,かれらを罰,ばっしてください。","tok":[["主","しゅ"],["よ"],["、"],["あなた"],["は"],["彼","かれ"],["ら"],["が"],["わたし"],["を"],["殺ろす","ころす"],["ため"],["に"],["めぐらして"],["いる"],["計略","けいりゃく"],["を"],["皆","みな"],["ごぞんじ"],["です"],["。"],["その"],["悪","あく"],["を"],["ゆるす"],["こと"],["なく"],["、"],["その"],["罪","つみ"],["を"],["あなた"],["の"],["前","まえ"],["から"],["消し去らないで","けしさらないで"],["ください"],["。"],["彼","かれ"],["ら"],["を"],["あなた"],["の"],["前","まえ"],["に"],["倒れさせて","たおれさせて"],["ください"],["。"],["あなた"],["の"],["お怒り","おいかり"],["に"],["なる"],["時","とき"],["に"],["彼","かれ"],["ら"],["を"],["罰して","ばっして"],["ください"],["。"]]}]
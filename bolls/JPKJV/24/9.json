[{"verse":1,"text":"[2]ああ、わたしが荒野,あらのに、隊商,たいしょうの宿,やどを得,えることができればよいのに。そうすれば、わたしは民,たみを離,はなれて去,さって行,いくことができる。彼,かれらはみな姦淫,かんいんする者,もの、不信,ふしんのともがらだからである。","tok":[["["],["2"],["]"],["ああ"],["、"],["わたし"],["が"],["荒野","あらの"],["に"],["、"],["隊商","たいしょう"],["の"],["宿","やど"],["を"],["得る","える"],["こと"],["が"],["できれば"],["よい"],["のに"],["。"],["そう"],["すれば"],["、"],["わたし"],["は"],["民","たみ"],["を"],["離れて","はなれて"],["去て","さって"],["行く","いく"],["こと"],["が"],["できる"],["。"],["彼","かれ"],["ら"],["は"],["みな"],["姦淫","かんいん"],["する"],["者","もの"],["、"],["不信","ふしん"],["の"],["とも"],["がら"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":2,"text":"[3]彼,かれらは弓,ゆみをひくように、その舌,したを曲,まげる。真実,しんじつではなく、偽,いつわりがこの地,ちに強,つよくなった。彼,かれらは悪,あくより悪,あくに進,すすみ、またわたしを知,しらないと、主,しゅは言,いわれる。","tok":[["["],["3"],["]"],["彼","かれ"],["ら"],["は"],["弓","ゆみ"],["を"],["ひく"],["よう"],["に"],["、"],["その"],["舌","した"],["を"],["曲げる","まげる"],["。"],["真実","しんじつ"],["で"],["は"],["なく"],["、"],["偽わり","いつわり"],["が"],["この"],["地","ち"],["に"],["強く","つよく"],["なった"],["。"],["彼","かれ"],["ら"],["は"],["悪","あく"],["より"],["悪","あく"],["に"],["進み","すすみ"],["、"],["また"],["わたし"],["を"],["知らない","しらない"],["と"],["、"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":3,"text":"[4]あなたがたはおのおの隣,となり人,びとに気,きをつけよ。どの兄弟,きょうだいをも信,しんじてはならない。兄弟,きょうだいはみな、押,おしのける者,ものであり、隣,となり人,びとはみな、ののしって歩,あるく者,ものだからである。","tok":[["["],["4"],["]"],["あなた"],["がた"],["は"],["おのおの"],["隣人","となりびと"],["に"],["気","き"],["を"],["つけよ"],["。"],["どの"],["兄弟","きょうだい"],["を"],["も"],["信じて","しんじて"],["は"],["ならない"],["。"],["兄弟","きょうだい"],["は"],["みな"],["、"],["押","おし"],["の"],["ける"],["者","もの"],["で"],["あり"],["、"],["隣人","となりびと"],["は"],["みな"],["、"],["ののしって"],["歩く","あるく"],["者","もの"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":4,"text":"[5]人,ひとはみな、その隣,となり人,びとを欺,あざむき、真実,しんじつを言,いう者,ものはない。彼,かれらは自分,じぶんの舌,したに偽,いつわりを言,いうことを教,おしえ、悪,あくを行,おこない、疲,つかれて悔,くい改,あらためるいとまもなく、","tok":[["["],["5"],["]"],["人","ひと"],["は"],["みな"],["、"],["その"],["隣人","となりびと"],["を"],["欺き","あざむき"],["、"],["真実","しんじつ"],["を"],["言う","いう"],["者","もの"],["は"],["ない"],["。"],["彼","かれ"],["ら"],["は"],["自分","じぶん"],["の"],["舌","した"],["に"],["偽り","いつわり"],["を"],["言う","いう"],["こと"],["を"],["教え","おしえ"],["、"],["悪","あく"],["を"],["行ない","おこない"],["、"],["疲れて","つかれて"],["悔い改める","くいあらためる"],["いとま"],["も"],["なく"],["、"]]},{"verse":5,"text":"[6]しえたげに、しえたげを積,つみ重,かさね、偽,いつわりに偽,いつわりを積,つみ重,かさね、わたしを知,しることを拒,こばんでいると、主,しゅは言,いわれる。","tok":[["["],["6"],["]"],["し"],["えたげ"],["に"],["、"],["し"],["えたげ"],["を"],["積み重ね","つみかさね"],["、"],["偽わり","いつわり"],["に"],["偽り","いつわり"],["を"],["積み重ね","つみかさね"],["、"],["わたし"],["を"],["知る","しる"],["こと"],["を"],["拒んで","こばんで"],["いる"],["と"],["、"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":6,"text":"[7]それゆえ万軍,ばんぐんの主,しゅはこう言,いわれる、「見,みよ、わたしは彼,かれらを溶,とかし、試,こころみる。このほか、わが民,たみをどうすることができよう。","tok":[["["],["7"],["]"],["それ"],["ゆえ"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["「"],["見よ","みよ"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["溶かし","とかし"],["、"],["試みる","こころみる"],["。"],["この"],["ほか"],["、"],["わが"],["民","たみ"],["を"],["どう"],["する"],["こと"],["が"],["できよう"],["。"]]},{"verse":7,"text":"[8]彼,かれらの舌,したは殺,ころす矢,やのようだ、それは偽,いつわりを言,いう。その口,くちではおのおの隣,となり人,びとにおだやかに語,かたるが、その心,こころでは彼,かれを待,まち伏,ぶせる計,はかりごとを立,たてる。","tok":[["["],["8"],["]"],["彼","かれ"],["ら"],["の"],["舌","した"],["は"],["殺ろす","ころす"],["矢","や"],["の"],["よう"],["だ"],["、"],["それ"],["は"],["偽り","いつわり"],["を"],["言う","いう"],["。"],["その"],["口","くち"],["で"],["は"],["おのおの"],["隣人","となりびと"],["に"],["おだやか"],["に"],["語る","かたる"],["が"],["、"],["その"],["心","こころ"],["で"],["は"],["彼","かれ"],["を"],["待ち","まち"],["伏","ぶせ"],["る"],["計り","はかり"],["ごと"],["を"],["立る","たてる"],["。"]]},{"verse":8,"text":"[9]主,しゅは言,いわれる、これらのことのために、わたしが彼,かれらを罰,ばっしないだろうか。わたしがこのような民,たみにあだを返,かえさないだろうか。","tok":[["["],["9"],["]"],["主","しゅ"],["は"],["言われる","いわれる"],["、"],["これ"],["ら"],["の"],["こと"],["の"],["ため"],["に"],["、"],["わたし"],["が"],["彼","かれ"],["ら"],["を"],["罰しないだろう","ばっしないだろう"],["か"],["。"],["わたし"],["が"],["この"],["よう"],["な"],["民","たみ"],["に"],["あだ"],["を"],["返えさないだろう","かえさないだろう"],["か"],["。"]]},{"verse":9,"text":"[10]山,やまのために泣,なき叫,さけび、野,のの牧場,まきばのために悲,かなしめ。これらは荒,あれすたれて、通,とおり過,すぎる人,ひともない。ここには牛,うし、羊,ひつじの鳴,なく声,こえも聞,きこえず、空,そらの鳥,とりも獣,けものも皆,みな逃,にげ去,さった。","tok":[["["],["10"],["]"],["山","やま"],["の"],["ため"],["に"],["泣","なき"],["叫","さけび"],["、"],["野","の"],["の"],["牧場","まきば"],["の"],["ため"],["に"],["悲しめ","かなしめ"],["。"],["これ"],["ら"],["は"],["荒れ","あれ"],["すたれて"],["、"],["通り","とおり"],["過る","すぎる"],["人","ひと"],["も"],["ない"],["。"],["ここ"],["に"],["は"],["牛","うし"],["、"],["羊","ひつじ"],["の"],["鳴く","なく"],["声","こえ"],["も"],["聞こえず","きこえず"],["、"],["空","そら"],["の"],["鳥","とり"],["も"],["獣","けもの"],["も"],["皆","みな"],["逃去","にげさっ"],["た"],["。"]]},{"verse":10,"text":"[11]わたしはエルサレムを荒塚,あれづかとし、山犬,やまいぬの巣,すとする。またユダの町々,まちまちを荒,あらして、住,すむ人,ひともない所,ところとする」。","tok":[["["],["11"],["]"],["わたし"],["は"],["エルサレム"],["を"],["荒塚","あ"],["れ"],["づか"],["と"],["し"],["、"],["山犬","やまいぬ"],["の"],["巣","す"],["と"],["する"],["。"],["また"],["ユダ"],["の"],["町々","まちまち"],["を"],["荒して","あらして"],["、"],["住む","すむ"],["人","ひと"],["も"],["ない"],["所","ところ"],["と"],["する"],["」"],["。"]]},{"verse":11,"text":"[12]知恵,ちえがあって、これを悟,さとることのできる人,ひとはだれか。主,しゅの口,くちの言葉,ことばをうけて、それを示,しめす人,ひとはだれか。この地,ちが滅,ほろぼされて荒野,あらののようになり、通,とおり過,すぎる人,ひともなくなったのはどういうわけか。","tok":[["["],["12"],["]"],["知恵","ちえ"],["が"],["あって"],["、"],["これ"],["を"],["悟","さとる"],["こと"],["の"],["できる"],["人","ひと"],["は"],["だれ"],["か"],["。"],["主","しゅ"],["の"],["口","くち"],["の"],["言葉","ことば"],["を"],["うけて"],["、"],["それ"],["を"],["示めす","しめす"],["人","ひと"],["は"],["だれ"],["か"],["。"],["この"],["地","ち"],["が"],["滅ぼされて","ほろぼされて"],["荒野","あら"],["の"],["の"],["よう"],["に"],["なり"],["、"],["通り","とおり"],["過る","すぎる"],["人","ひと"],["も"],["なくなった"],["の"],["は"],["どういう"],["わけ"],["か"],["。"]]},{"verse":12,"text":"[13]主,しゅは言,いわれる、「それは彼,かれらの前,まえにわたしが立,たてたおきてを彼,かれらが捨,すてて、わたしの声,こえに聞,きき従,したがわず、そのとおりに歩,あるかなかったからである。","tok":[["["],["13"],["]"],["主","しゅ"],["は"],["言われる","いわれる"],["、"],["「"],["それ"],["は"],["彼","かれ"],["ら"],["の"],["前","まえ"],["に"],["わたし"],["が"],["立てた","たてた"],["おきて"],["を"],["彼","かれ"],["ら"],["が"],["捨てて","すてて"],["、"],["わたし"],["の"],["声","こえ"],["に"],["聞","きき"],["従わず","したがわず"],["、"],["その"],["とおり"],["に"],["歩かなかった","あるかなかった"],["から"],["で"],["ある"],["。"]]},{"verse":13,"text":"[14]彼,かれらは強情,ごうじょうに自分,じぶんの心,こころに従,したがい、また先祖,せんぞの教,おしえたようにバアルに従,したがった。","tok":[["["],["14"],["]"],["彼","かれ"],["ら"],["は"],["強情","ごうじょう"],["に"],["自分","じぶん"],["の"],["心","こころ"],["に"],["従い","したがい"],["、"],["また"],["先祖","せんぞ"],["の"],["教えた","おしえた"],["よう"],["に"],["バアル"],["に"],["従った","したがった"],["。"]]},{"verse":14,"text":"[15]それゆえ万軍,ばんぐんの主,しゅ、イスラエルの神,かみはこう言,いわれる、見,みよ、わたしはこの民,たみに、にがよもぎを食,たべさせ、毒,どくの水,みずを飲,のませ、","tok":[["["],["15"],["]"],["それ"],["ゆえ"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["、"],["イスラエル"],["の"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["見よ","みよ"],["、"],["わたし"],["は"],["この"],["民","たみ"],["に"],["、"],["にがよもぎ"],["を"],["食べさせ","たべさせ"],["、"],["毒","どく"],["の"],["水","みず"],["を"],["飲ませ","のませ"],["、"]]},{"verse":15,"text":"[16]彼,かれらも、その先祖,せんぞたちも知,しらなかった国,くにびとのうちに彼,かれらを散,ちらし、また彼,かれらを滅,ほろぼし尽,つくすまで、そのうしろに、つるぎをつかわす」。","tok":[["["],["16"],["]"],["彼","かれ"],["ら"],["も"],["、"],["その"],["先祖","せんぞ"],["たち"],["も"],["知らなかった","しらなかった"],["国びと","くにびと"],["の"],["うち"],["に"],["彼","かれ"],["ら"],["を"],["散らし","ちらし"],["、"],["また"],["彼","かれ"],["ら"],["を"],["滅ぼし","ほろぼし"],["尽くす","つくす"],["まで"],["、"],["その"],["うしろ"],["に"],["、"],["つるぎ"],["を"],["つかわす"],["」"],["。"]]},{"verse":16,"text":"[17]万軍,ばんぐんの主,しゅはこう言,いわれる、「よく考,かんがえて、泣,なき女,おんなを呼,よべ。また人,ひとをつかわして巧,たくみな女,おんなを招,まねけ。","tok":[["["],["17"],["]"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["「"],["よく"],["考","かんがえ"],["て"],["、"],["泣","なき"],["女","おんな"],["を"],["呼べ","よべ"],["。"],["また"],["人","ひと"],["を"],["つかわして"],["巧み","たくみ"],["な"],["女","おんな"],["を"],["招け","まねけ"],["。"]]},{"verse":17,"text":"[18]彼,かれらに急,いそいでこさせ、われわれのために泣,なき悲,かなしませて、われわれの目,めに涙,なみだをこぼさせ、まぶたから水,みずをあふれさせよ。","tok":[["["],["18"],["]"],["彼","かれ"],["ら"],["に"],["急いで","いそいで"],["こさせ"],["、"],["われわれ"],["の"],["ため"],["に"],["泣","なき"],["悲しませて","かなしませて"],["、"],["われわれ"],["の"],["目","め"],["に"],["涙","なみだ"],["を"],["こぼさせ"],["、"],["まぶた"],["から"],["水","みず"],["を"],["あふれさせ"],["よ"],["。"]]},{"verse":18,"text":"[19]シオンから悲,かなしみの声,こえが聞,きこえる。それは言,いう、『ああ、われわれは滅,ほろぼされ、いたく、はずかしめられている。われわれはその地,ちを去,さり、彼,かれらがわれわれのすみかをこわしたからだ』」。","tok":[["["],["19"],["]"],["シオン"],["から"],["悲しみ","かなしみ"],["の"],["声","こえ"],["が"],["聞こえる","きこえる"],["。"],["それ"],["は"],["言う","いう"],["、"],["『"],["ああ"],["、"],["われわれ"],["は"],["滅ぼされ","ほろぼされ"],["、"],["いたく"],["、"],["はずかしめられて"],["いる"],["。"],["われわれ"],["は"],["その"],["地","ち"],["を"],["去り","さり"],["、"],["彼","かれ"],["ら"],["が"],["われわれ"],["の"],["すみか"],["を"],["こわした"],["から"],["だ"],["』"],["」"],["。"]]},{"verse":19,"text":"[20]女,おんなたちよ、主,しゅの言葉,ことばを聞,きけ。あなたがたの耳,みみに、その口,くちの言葉,ことばをいれよ。あなたがたの娘,むすめに悲,かなしみの歌,うたを教,おしえ、おのおのその隣,となり人,びとに哀悼,あいとうの歌,うたを教,おしえよ。","tok":[["["],["20"],["]"],["女","おんな"],["たち"],["よ"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["を"],["聞け","きけ"],["。"],["あなた"],["がた"],["の"],["耳","みみ"],["に"],["、"],["その"],["口","くち"],["の"],["言葉","ことば"],["を"],["いれよ"],["。"],["あなた"],["がた"],["の"],["娘","むすめ"],["に"],["悲しみ","かなしみ"],["の"],["歌","うた"],["を"],["教え","おしえ"],["、"],["おのおの"],["その"],["隣人","となりびと"],["に"],["哀悼","あいとう"],["の"],["歌","うた"],["を"],["教え","おしえ"],["よ"],["。"]]},{"verse":20,"text":"[21]死,しがわれわれの窓,まどに上,のぼって来,き、われわれの邸宅,ていたくの中,なかにはいり、ちまたにいる子,こどもらを絶,たやし、広場,ひろばにいる若,わかい人,ひとたちを殺,ころそうとしているからだ。","tok":[["["],["21"],["]"],["死","し"],["が"],["われわれ"],["の"],["窓","まど"],["に"],["上って","のぼって"],["来","き"],["、"],["われわれ"],["の"],["邸宅","ていたく"],["の"],["中","なか"],["に"],["はいり"],["、"],["ちまた"],["に"],["いる"],["子ども","こども"],["ら"],["を"],["絶やし","たやし"],["、"],["広場","ひろば"],["に"],["いる"],["若い","わかい"],["人","ひと"],["たち"],["を"],["殺そう","ころそう"],["として"],["いる"],["から"],["だ"],["。"]]},{"verse":21,"text":"[22]あなたはこう言,いいなさい、「主,しゅは言,いわれる、『人,ひとの死体,したいが糞土,ふんどのように、野,のに倒,たおれているようになり、また刈入,かりいれする人,ひとのうしろに残,のこって、だれも集,あつめることをしない束,たばのようになる』」。","tok":[["["],["22"],["]"],["あなた"],["は"],["こう"],["言い","いい"],["なさい"],["、"],["「"],["主","しゅ"],["は"],["言われる","いわれる"],["、"],["『"],["人","ひと"],["の"],["死体","したい"],["が"],["糞土","ふんど"],["の"],["よう"],["に"],["、"],["野","の"],["に"],["倒れて","たおれて"],["いる"],["よう"],["に"],["なり"],["、"],["また"],["刈入れ","かりいれ"],["する"],["人","ひと"],["の"],["うしろ"],["に"],["残って","のこって"],["、"],["だれ"],["も"],["集める","あつめる"],["こと"],["を"],["しない"],["束","たば"],["の"],["よう"],["に"],["なる"],["』"],["」"],["。"]]},{"verse":22,"text":"[23]主,しゅはこう言,いわれる、「知恵,ちえある人,ひとはその知恵,ちえを誇,ほこってはならない。力,ちからある人,ひとはその力,ちからを誇,ほこってはならない。富,とめる者,ものはその富,とみを誇,ほこってはならない。","tok":[["["],["23"],["]"],["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["「"],["知恵","ちえ"],["ある"],["人","ひと"],["は"],["その"],["知恵","ちえ"],["を"],["誇って","ほこって"],["は"],["ならない"],["。"],["力","ちから"],["ある"],["人","ひと"],["は"],["その"],["力","ちから"],["を"],["誇って","ほこって"],["は"],["ならない"],["。"],["富める","とめる"],["者","もの"],["は"],["その"],["富","とみ"],["を"],["誇って","ほこって"],["は"],["ならない"],["。"]]},{"verse":23,"text":"[24]誇,ほこる者,ものはこれを誇,ほこりとせよ。すなわち、さとくあって、わたしを知,しっていること、わたしが主,しゅであって、地,ちに、いつくしみと公平,こうへいと正義,せいぎを行,いっている者,ものであることを知,しることがそれである。わたしはこれらの事,ことを喜,よろこぶと、主,しゅは言,いわれる」。","tok":[["["],["24"],["]"],["誇る","ほこる"],["者","もの"],["は"],["これ"],["を"],["誇","ほこり"],["と"],["せよ"],["。"],["すなわち"],["、"],["さとく"],["あって"],["、"],["わたし"],["を"],["知って","しって"],["いる"],["こと"],["、"],["わたし"],["が"],["主","しゅ"],["で"],["あって"],["、"],["地","ち"],["に"],["、"],["いつくしみ"],["と"],["公平","こうへい"],["と"],["正義","せいぎ"],["を"],["行って","いって"],["いる"],["者","もの"],["で"],["ある"],["こと"],["を"],["知る","しる"],["こと"],["が"],["それ"],["で"],["ある"],["。"],["わたし"],["は"],["これ"],["ら"],["の"],["事","こと"],["を"],["喜こぶ","よろこぶ"],["と"],["、"],["主","しゅ"],["は"],["言われる","いわれる"],["」"],["。"]]},{"verse":24,"text":"[25]主,しゅは言,いわれる、「見,みよ、このような日,ひが来,くる。その日,ひには、割礼,かつれいをうけても、心,こころに割礼,かつれいをうけていないすべての人,ひとをわたしは罰,ばっする。","tok":[["["],["25"],["]"],["主","しゅ"],["は"],["言われる","いわれる"],["、"],["「"],["見よ","みよ"],["、"],["この"],["よう"],["な"],["日","ひ"],["が"],["来る","くる"],["。"],["その"],["日","ひ"],["に"],["は"],["、"],["割礼","かつれい"],["を"],["うけて"],["も"],["、"],["心","こころ"],["に"],["割礼","かつれい"],["を"],["うけて"],["いない"],["すべて"],["の"],["人","ひと"],["を"],["わたし"],["は"],["罰する","ばっする"],["。"]]},{"verse":25,"text":"[26]エジプト、ユダ、エドム、アンモンの人々,ひとびと、モアブ、および野,のにいて、髪,かみの毛,けのすみずみをそる人々,ひとびとはそれである。これらの国,くにびとはみな割礼,かつれいをうけていない者,ものであり、イスラエルの全家,ぜんかもみな心,こころに割礼,かつれいをうけていない者,ものである」。","tok":[["["],["26"],["]"],["エジプト"],["、"],["ユダ"],["、"],["エドム"],["、"],["アンモン"],["の"],["人々","ひとびと"],["、"],["モアブ"],["、"],["および"],["野","の"],["に"],["いて"],["、"],["髪の毛","かみのけ"],["の"],["すみずみ"],["を"],["そる"],["人々","ひとびと"],["は"],["それ"],["で"],["ある"],["。"],["これ"],["ら"],["の"],["国びと","くにびと"],["は"],["みな"],["割礼","かつれい"],["を"],["うけて"],["いない"],["者","もの"],["で"],["あり"],["、"],["イスラエル"],["の"],["全","ぜん"],["家","いえ"],["も"],["みな"],["心","こころ"],["に"],["割礼","かつれい"],["を"],["うけて"],["いない"],["者","もの"],["で"],["ある"],["」"],["。"]]}]
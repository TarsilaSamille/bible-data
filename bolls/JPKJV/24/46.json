[{"verse":1,"text":"もろもろの国,くにの事,ことについて預言者,よげんしゃエレミヤに臨,のぞんだ主,しゅの言葉,ことば。","tok":[["もろもろ"],["の"],["国","くに"],["の"],["事","こと"],["について"],["預言者","よげんしゃ"],["エレミヤ"],["に"],["臨んだ","のぞんだ"],["主","しゅ"],["の"],["言葉","ことば"],["。"]]},{"verse":2,"text":"エジプトの事,こと、すなわちユフラテ川,かわのほとりにあるカルケミシの近,ちかくにいるエジプトの王,おうパロ・ネコの軍勢,ぐんぜいの事,ことについて。これはユダの王,おうヨシヤの子,こエホヤキムの四年,ねんに、バビロンの王,おうネブカデレザルが撃,うち破,やぶったものである。その言葉,ことばは次,つぎのとおりである、","tok":[["エジプト"],["の"],["事","こと"],["、"],["すなわち"],["ユフラテ"],["川","かわ"],["の"],["ほとり"],["に"],["ある"],["カルケミシ"],["の"],["近く","ちかく"],["に"],["いる"],["エジプト"],["の"],["王","おう"],["パロ"],["・"],["ネコ"],["の"],["軍勢","ぐんぜい"],["の"],["事","こと"],["について"],["。"],["これ"],["は"],["ユダ"],["の"],["王","おう"],["ヨシヤ"],["の"],["子","こ"],["エホヤキム"],["の"],["四","よん"],["年","ねん"],["に"],["、"],["バビロン"],["の"],["王","おう"],["ネブカデレザル"],["が"],["撃ち破った","うちやぶった"],["もの"],["で"],["ある"],["。"],["その"],["言葉","ことば"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["、"]]},{"verse":3,"text":"「大盾,おおだてと小盾,こだてとを備,そなえ、進,すすんで戦,たたかえ。","tok":[["「"],["大","だい"],["盾","たて"],["と"],["小","こ"],["盾","たて"],["を"],["備","そなえ"],["、"],["進","す"],["すんで"],["戦え","たたかえ"],["。"]]},{"verse":4,"text":"騎兵,きへいよ、馬,うまを戦車,せんしゃにつなぎ、馬,うまに乗,のれ。かぶとをかぶって立,たて。ほこをみがき、よろいを着,きよ。","tok":[["騎兵","きへい"],["よ"],["、"],["馬","うま"],["を"],["戦車","せんしゃ"],["に"],["つなぎ"],["、"],["馬","うま"],["に"],["乗れ","のれ"],["。"],["かぶと"],["を"],["かぶって"],["立","たて"],["。"],["ほ"],["こ"],["を"],["みがき"],["、"],["よろい"],["を"],["着","き"],["よ"],["。"]]},{"verse":5,"text":"わたしは見,みたが、何,なにゆえか彼,かれらは恐,おそれて退,しりぞき、その勇士,ゆうしたちは打,うち敗,やぶられ、あわてて逃,にげて、うしろをふり向,むくこともしない、――恐,おそれが彼,かれらの周囲,しゅういにあると主,しゅは言,いわれる。","tok":[["わたし"],["は"],["見た","みた"],["が"],["、"],["何ゆえ","なにゆえ"],["か"],["彼","かれ"],["ら"],["は"],["恐れて","おそれて"],["退ぞき","しりぞき"],["、"],["その"],["勇士","ゆうし"],["たち"],["は"],["打ち","うち"],["敗られ","やぶられ"],["、"],["あわてて"],["逃て","にげて"],["、"],["うしろ"],["を"],["ふり向く","ふりむく"],["こと"],["も"],["しない"],["、"],["―"],["―"],["恐","おそれ"],["が"],["彼","かれ"],["ら"],["の"],["周囲","しゅうい"],["に"],["ある"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":6,"text":"足早,あしばやき者,ものも逃,にげることができず、勇士,ゆうしものがれることができない。北,きたの方,ほう、ユフラテ川,かわのほとりで彼,かれらはつまずき倒,たおれた。","tok":[["足","あし"],["早き","はやき"],["者","もの"],["も"],["逃る","にげる"],["こと"],["が"],["できず"],["、"],["勇士","ゆうし"],["も"],["のがれる"],["こと"],["が"],["できない"],["。"],["北","きた"],["の"],["方","ほう"],["、"],["ユフラテ"],["川","かわ"],["の"],["ほとり"],["で"],["彼","かれ"],["ら"],["は"],["つまずき"],["倒れた","たおれた"],["。"]]},{"verse":7,"text":"あのナイル川,かわのようにわきあがり、川,かわ々のように、その水,みずのさかまく者,ものはだれか。","tok":[["あの"],["ナイル"],["川","かわ"],["の"],["よう"],["に"],["わきあがり"],["、"],["川","かわ"],["々"],["の"],["よう"],["に"],["、"],["その"],["水","みず"],["の"],["さかまく"],["者","もの"],["は"],["だれ"],["か"],["。"]]},{"verse":8,"text":"エジプトはナイル川,かわのようにわきあがり、その水,みずは川,かわ々のようにさかまく。そしてこれは言,いう、わたしは上,のぼって、地,ちをおおい、町々,まちまちとそのうちに住,すむ者,ものを滅,ほろぼそう。","tok":[["エジプト"],["は"],["ナイル"],["川","かわ"],["の"],["よう"],["に"],["わきあがり"],["、"],["その"],["水","みず"],["は"],["川","かわ"],["々"],["の"],["よう"],["に"],["さかまく"],["。"],["そして"],["これ"],["は"],["言う","いう"],["、"],["わたし"],["は"],["上って","のぼって"],["、"],["地","ち"],["を"],["おおい"],["、"],["町々","まちまち"],["と"],["その"],["うち"],["に"],["住む","すむ"],["者","もの"],["を"],["滅ぼそう","ほろぼそう"],["。"]]},{"verse":9,"text":"馬,うまよ、進,すすめ、車,くるまよ、激,はげしく走,はしれ。勇士,ゆうしよ、盾,たてを取,とるエチオピヤびとと、プテびとよ、弓,ゆみを巧,たくみに引,ひくルデびとよ、進,すすみ出,でよ。","tok":[["馬","うま"],["よ"],["、"],["進め","すすめ"],["、"],["車","くるま"],["よ"],["、"],["激しく","はげしく"],["走れ","はしれ"],["。"],["勇士","ゆうし"],["よ"],["、"],["盾","たて"],["を"],["取る","とる"],["エチオピヤ"],["びと"],["と"],["、"],["プテ"],["びと"],["よ"],["、"],["弓","ゆみ"],["を"],["巧","たくみ"],["に"],["引く","ひく"],["ルデ"],["びと"],["よ"],["、"],["進み出よ","すすみでよ"],["。"]]},{"verse":10,"text":"その日,ひは万軍,ばんぐんの神,かみ、主,しゅの日,ひであって、主,しゅがあだを報,むくいられる日,ひ、その敵,てきにあだをかえされる日,ひだ。つるぎは食,たべて飽,あき、彼,かれらの血,ちに酔,よう。万軍,ばんぐんの神,かみ、主,しゅが、北,きたの地,ちで、ユフラテ川,かわのほとりで、ほふることをなされるからだ。","tok":[["その"],["日","ひ"],["は"],["万","まん"],["軍","ぐん"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["日","ひ"],["で"],["あって"],["、"],["主","しゅ"],["が"],["あだ"],["を"],["報いられる","むくいられる"],["日","ひ"],["、"],["その"],["敵","てき"],["に"],["あだ"],["を"],["かえされる"],["日","ひ"],["だ"],["。"],["つるぎ"],["は"],["食べて","たべて"],["飽き","あき"],["、"],["彼","かれ"],["ら"],["の"],["血","ち"],["に"],["酔う","よう"],["。"],["万","まん"],["軍","ぐん"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["、"],["北","きた"],["の"],["地","ち"],["で"],["、"],["ユフラテ"],["川","かわ"],["の"],["ほとり"],["で"],["、"],["ほふる"],["こと"],["を"],["なされる"],["から"],["だ"],["。"]]},{"verse":11,"text":"おとめなるエジプトの娘,むすめよ、ギレアデに上,のぼって乳香,にゅうこうを取,とれ。あなたは多,おおくの薬,くすりを用,もちいても、むだだ。あなたは、いやされることはない。","tok":[["おとめなる"],["エジプト"],["の"],["娘","むすめ"],["よ"],["、"],["ギレアデ"],["に"],["上って","のぼって"],["乳香","にゅうこう"],["を"],["取れ","とれ"],["。"],["あなた"],["は"],["多く","おおく"],["の"],["薬","くすり"],["を"],["用いて","もちいて"],["も"],["、"],["むだ"],["だ"],["。"],["あなた"],["は"],["、"],["いや"],["される"],["こと"],["は"],["ない"],["。"]]},{"verse":12,"text":"あなたの恥,はじは国々,くにぐにに聞,きこえている、あなたの叫,さけびは地,ちに満,みちている。勇士,ゆうしが勇士,ゆうしにつまずいて、共,ともに倒,たおれたからである」。","tok":[["あなた"],["の"],["恥","はじ"],["は"],["国々","くにぐに"],["に"],["聞こえて","きこえて"],["いる"],["、"],["あなた"],["の"],["叫","さけび"],["は"],["地","ち"],["に"],["満ちて","みちて"],["いる"],["。"],["勇士","ゆうし"],["が"],["勇士","ゆうし"],["に"],["つまずいて"],["、"],["共","とも"],["に"],["倒れた","たおれた"],["から"],["で"],["ある"],["」"],["。"]]},{"verse":13,"text":"バビロンの王,おうネブカデレザルが来,きて、エジプトの地,ちを撃,うとうとする事,ことについて、主,しゅが預言者,よげんしゃエレミヤにお告,つげになった言葉,ことば、","tok":[["バビロン"],["の"],["王","おう"],["ネブカデレザル"],["が"],["来て","きて"],["、"],["エジプト"],["の"],["地","ち"],["を"],["撃とう","うとう"],["と"],["する"],["事","こと"],["について"],["、"],["主","しゅ"],["が"],["預言者","よげんしゃ"],["エレミヤ"],["に"],["お告","おつげ"],["に"],["なった"],["言葉","ことば"],["、"]]},{"verse":14,"text":"「エジプトで宣,のべ、ミグドルで告,つげ示,しめし、またメンピスとタパネスに告,つげ示,しめして言,いえ、『堅,かたく立,たって、備,そなえせよ、つるぎがあなたの周囲,しゅういを、滅,ほろぼし尽,つくすからだ』。","tok":[["「"],["エジプト"],["で"],["宣べ","のべ"],["、"],["ミグドル"],["で"],["告示","つげし"],["めし"],["、"],["また"],["メンピス"],["と"],["タパネス"],["に"],["告","つげ"],["示めして","しめして"],["言え","いえ"],["、"],["『"],["堅く","かたく"],["立って","たって"],["、"],["備","そなえ"],["せよ"],["、"],["つるぎ"],["が"],["あなた"],["の"],["周囲","しゅうい"],["を"],["、"],["滅ぼし","ほろぼし"],["尽くす","つくす"],["から"],["だ"],["』"],["。"]]},{"verse":15,"text":"なぜ、アピスはのがれたのか。あなたの雄牛,おうしは、なぜ立,たたなかったのか。それは主,しゅがこれを倒,たおされたからだ。","tok":[["なぜ"],["、"],["アピス"],["は"],["のがれた"],["の"],["か"],["。"],["あなた"],["の"],["雄牛","おうし"],["は"],["、"],["なぜ"],["立たなかった","たたなかった"],["の"],["か"],["。"],["それ"],["は"],["主","しゅがこれ"],["を"],["倒された","たおされた"],["から"],["だ"],["。"]]},{"verse":16,"text":"あなたに属,ぞくする多,おおくの兵,へいは、つまずいて倒,たおれた。そして互,たがいに言,いった、『立,たてよ、われわれは、しえたげる者,もののつるぎを避,さけて、われわれの民,たみに帰,かえり、故郷,こきょうの地,ちへ行,いこう』と。","tok":[["あなた"],["に"],["属する","ぞくする"],["多く","おおく"],["の"],["兵","へい"],["は"],["、"],["つまずいて"],["倒れた","たおれた"],["。"],["そして"],["互","たがい"],["に"],["言った","いった"],["、"],["『"],["立","たて"],["よ"],["、"],["われわれ"],["は"],["、"],["し"],["えたげる"],["者","もの"],["の"],["つるぎ"],["を"],["避けて","さけて"],["、"],["われわれ"],["の"],["民","たみ"],["に"],["帰えり","かえり"],["、"],["故郷","こきょう"],["の"],["地","ち"],["へ"],["行こう","いこう"],["』"],["と"],["。"]]},{"verse":17,"text":"エジプトの王,おうパロの名,なを、『好機,こうきを逸,いっする騒,さわがしい者,もの』と呼,よべ。","tok":[["エジプト"],["の"],["王","おう"],["パロ"],["の"],["名","な"],["を"],["、"],["『"],["好機","こうき"],["を"],["逸する","いっする"],["騒がしい","さわがしい"],["者","もの"],["』"],["と"],["呼べ","よべ"],["。"]]},{"verse":18,"text":"万軍,ばんぐんの主,しゅという名,なの王,おうは言,いわれる、わたしは生,いきている、彼,かれは山々,やまやまのうちのタボルのように、海,うみのほとりのカルメルのように来,きたり臨,のぞむ。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["と"],["いう"],["名","な"],["の"],["王","おう"],["は"],["言われる","いわれる"],["、"],["わたし"],["は"],["生きて","いきて"],["いる"],["、"],["彼","かれ"],["は"],["山々","やまやま"],["の"],["うち"],["の"],["タボル"],["の"],["よう"],["に"],["、"],["海","うみ"],["の"],["ほとり"],["の"],["カルメル"],["の"],["よう"],["に"],["来","き"],["たり"],["臨む","のぞむ"],["。"]]},{"verse":19,"text":"エジプトに住,すむ民,たみよ、捕,とらわれのために荷物,にもつを備,そなえよ。メンピスは荒,あれ地,ちとなり、廃虚,はいきょとなって住,すむ人,ひともなくなる。","tok":[["エジプト"],["に"],["住む","すむ"],["民","たみ"],["よ"],["、"],["捕らわれ","とらわれ"],["の"],["ため"],["に"],["荷物","にもつ"],["を"],["備","そなえ"],["よ"],["。"],["メンピス"],["は"],["荒れ地","あれち"],["と"],["なり"],["、"],["廃虚","はいきょ"],["と"],["なって"],["住む","すむ"],["人","ひと"],["も"],["なくなる"],["。"]]},{"verse":20,"text":"エジプトは美,うつくしい雌,めすの子,こ牛,うしだ、しかし北,きたから、牛,うしばえが来,きて、それにとまった。","tok":[["エジプト"],["は"],["美しい","うつくしい"],["雌","めす"],["の"],["子牛","こうし"],["だ"],["、"],["しかし"],["北","きた"],["から"],["、"],["牛","うし"],["ばえ"],["が"],["来て","きて"],["、"],["それ"],["に"],["とまった"],["。"]]},{"verse":21,"text":"そのうちにいる雇,やとい兵,へいでさえ、肥,こえた子,こ牛,うしのようだ。彼,かれらはふり返,かえって共,ともに逃,にげ、立,たつことをしなかった。彼,かれらの災難,さいなんの日,ひ、その罰,ばっせられる時,ときが来,きたからだ。","tok":[["その"],["うち"],["に"],["いる"],["雇兵","やといへい"],["で"],["さえ"],["、"],["肥","こえ"],["た"],["子牛","こうし"],["の"],["よう"],["だ"],["。"],["彼","かれ"],["ら"],["は"],["ふり返って","ふりかえって"],["共","とも"],["に"],["逃","にげ"],["、"],["立つ","たつ"],["こと"],["を"],["しなかった"],["。"],["彼","かれ"],["ら"],["の"],["災難","さいなん"],["の"],["日","ひ"],["、"],["その"],["罰せられる","ばっせられる"],["時","とき"],["が"],["来た","きた"],["から"],["だ"],["。"]]},{"verse":22,"text":"彼,かれは逃,にげ去,さるへびのような音,おとをたてる。その敵,てきが軍勢,ぐんぜいを率,ひきいて彼,かれに臨,のぞみ、きこりのように、おのをもって来,くるからだ。","tok":[["彼","かれ"],["は"],["逃","にげ"],["去る","さる"],["へび"],["の"],["よう"],["な"],["音","おと"],["を"],["たてる"],["。"],["その"],["敵","てき"],["が"],["軍勢","ぐんぜい"],["を"],["率いて","ひきいて"],["彼","かれ"],["に"],["臨み","のぞみ"],["、"],["きこり"],["の"],["よう"],["に"],["、"],["おの"],["を"],["もって"],["来る","くる"],["から"],["だ"],["。"]]},{"verse":23,"text":"彼,かれらは彼,かれの林,はやしがいかに入,いり込,こみがたくとも、それを切,きり倒,たおす。彼,かれらはいなごよりも多,おおく、数,かぞえがたいからであると、主,しゅは言,いわれる。","tok":[["彼","かれ"],["ら"],["は"],["彼","かれ"],["の"],["林","はやし"],["が"],["いかに"],["入込","いりこみ"],["がたく"],["とも"],["、"],["それ"],["を"],["切り倒す","きりたおす"],["。"],["彼","かれ"],["ら"],["は"],["いなご"],["より"],["も"],["多く","おおく"],["、"],["数え","かぞえ"],["がたい"],["から"],["で"],["ある"],["と"],["、"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":24,"text":"エジプトの娘,むすめははずかしめを受,うけ、北,きたからくる民,たみの手,てに渡,わたされる」。","tok":[["エジプト"],["の"],["娘","むすめ"],["は"],["はずかしめ"],["を"],["受け","うけ"],["、"],["北","きた"],["から"],["くる"],["民","たみ"],["の"],["手","て"],["に"],["渡される","わたされる"],["」"],["。"]]},{"verse":25,"text":"万軍,ばんぐんの主,しゅ、イスラエルの神,かみは言,いわれた、「見,みよ、わたしはテーベのアモンと、パロと、エジプトとその神々,かみがみとその王,おうたち、すなわちパロと彼,かれを頼,たのむ者,ものとを罰,ばっする。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["、"],["イスラエル"],["の"],["神","かみ"],["は"],["言われた","いわれた"],["、"],["「"],["見よ","みよ"],["、"],["わたし"],["は"],["テーベ"],["の"],["アモン"],["と"],["、"],["パロ"],["と"],["、"],["エジプト"],["と"],["その"],["神々","かみがみ"],["と"],["その"],["王","おう"],["たち"],["、"],["すなわち"],["パロ"],["と"],["彼","かれ"],["を"],["頼む","たのむ"],["者","もの"],["と"],["を"],["罰する","ばっする"],["。"]]},{"verse":26,"text":"わたしは彼,かれらを、その命,いのちを求,もとめる者,ものの手,てと、バビロンの王,おうネブカデレザルの手,てと、その家来,けらいたちの手,てに渡,わたす。その後,のち、エジプトは昔,むかしのように人,ひとの住,すむ所,ところとなると、主,しゅは言,いわれる。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["を"],["、"],["その"],["命","いのち"],["を"],["求める","もとめる"],["者","もの"],["の"],["手","て"],["と"],["、"],["バビロン"],["の"],["王","おう"],["ネブカデレザル"],["の"],["手","て"],["と"],["、"],["その"],["家来","けらい"],["たち"],["の"],["手","て"],["に"],["渡す","わたす"],["。"],["その後","そのの"],["ち"],["、"],["エジプト"],["は"],["昔","むかし"],["の"],["よう"],["に"],["人","ひと"],["の"],["住む","すむ"],["所","ところ"],["と"],["なる"],["と"],["、"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":27,"text":"わたしのしもべヤコブよ、恐,おそれることはない、イスラエルよ、驚,おどろくことはない。見,みよ、わたしがあなたを遠,とおくから救,すくい、あなたの子孫,しそんをその捕,とらえ移,うつされた地,ちから救,すくうからだ。ヤコブは帰,かえってきて、おだやかに、安,やすらかになり、彼,かれを恐,おそれさせる者,ものはない。","tok":[["わたし"],["の"],["しもべ"],["ヤコブ"],["よ"],["、"],["恐れる","おそれる"],["こと"],["は"],["ない"],["、"],["イスラエル"],["よ"],["、"],["驚ろく","おどろく"],["こと"],["は"],["ない"],["。"],["見よ","みよ"],["、"],["わたし"],["が"],["あなた"],["を"],["遠く","とおく"],["から"],["救い","すくい"],["、"],["あなた"],["の"],["子孫","しそん"],["を"],["その"],["捕らえ","とらえ"],["移された","うつされた"],["地","ち"],["から"],["救う","すくう"],["から"],["だ"],["。"],["ヤコブ"],["は"],["帰えって","かえって"],["きて"],["、"],["おだやか"],["に"],["、"],["安らか","やすらか"],["に"],["なり"],["、"],["彼","かれ"],["を"],["恐れさせる","おそれさせる"],["者","もの"],["は"],["ない"],["。"]]},{"verse":28,"text":"主,しゅは言,いわれる、わたしのしもべヤコブよ、恐,おそれることはない、わたしが共,ともにいるからだ。わたしはあなたを追,おいやった国々,くにぐにをことごとく滅,ほろぼし尽,つくす。しかしあなたを滅,ほろぼし尽,つくすことはしない。わたしは正,ただしい道,みちに従,したがって、あなたを懲,こらしめる、決,けっして罰,ばっしないではおかない」。","tok":[["主","しゅ"],["は"],["言われる","いわれる"],["、"],["わたし"],["の"],["しもべ"],["ヤコブ"],["よ"],["、"],["恐れる","おそれる"],["こと"],["は"],["ない"],["、"],["わたし"],["が"],["共","とも"],["に"],["いる"],["から"],["だ"],["。"],["わたし"],["は"],["あなた"],["を"],["追いやった","おいやった"],["国々","くにぐに"],["を"],["ことごとく"],["滅ぼし","ほろぼし"],["尽くす","つくす"],["。"],["しかし"],["あなた"],["を"],["滅ぼし","ほろぼし"],["尽くす","つくす"],["こと"],["は"],["しない"],["。"],["わたし"],["は"],["正い","ただしい"],["道","みち"],["に"],["従って","したがって"],["、"],["あなた"],["を"],["懲らしめる","こらしめる"],["、"],["決っして","けっして"],["罰しないで","ばっしないで"],["は"],["おかない"],["」"],["。"]]}]
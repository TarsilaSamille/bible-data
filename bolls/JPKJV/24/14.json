[{"verse":1,"text":"ひでりの事,ことについてエレミヤに臨,のぞんだ主,しゅの言葉,ことば。","tok":[["ひでり"],["の"],["事","こと"],["について"],["エレミヤ"],["に"],["臨んだ","のぞんだ"],["主","しゅ"],["の"],["言葉","ことば"],["。"]]},{"verse":2,"text":"「ユダは悲,かなしみ、その町々,まちまちの門,もんは傾,かたむき、民,たみは地,ちに座,ざして嘆,なげき、エルサレムの叫,さけびはあがる。","tok":[["「"],["ユダ"],["は"],["悲しみ","かなしみ"],["、"],["その"],["町々","まちまち"],["の"],["門","もん"],["は"],["傾き","かたむき"],["、"],["民","たみ"],["は"],["地","ち"],["に"],["座して","ざして"],["嘆き","なげき"],["、"],["エルサレム"],["の"],["叫","さけび"],["は"],["あがる"],["。"]]},{"verse":3,"text":"その君,きみたちは、しもべをつかわして水,みずをくませる。彼,かれらが井戸,いどの所,ところにきても、水,みずは見,みつからず、むなしい器,うつわをもって帰,かえり、恥,はじ、かつ当惑,とうわくして、その頭,あたまをおおう。","tok":[["その"],["君","きみ"],["たち"],["は"],["、"],["しもべ"],["を"],["つかわして"],["水","みず"],["を"],["くませる"],["。"],["彼","かれ"],["ら"],["が"],["井戸","いど"],["の"],["所","ところ"],["に"],["きて"],["も"],["、"],["水","みず"],["は"],["見つからず","みつからず"],["、"],["むなしい"],["器","うつわ"],["を"],["もって"],["帰えり","かえり"],["、"],["恥","はじ"],["、"],["かつ"],["当惑","とうわく"],["して"],["、"],["その"],["頭","あたま"],["を"],["おおう"],["。"]]},{"verse":4,"text":"地,ちに雨,あめが降,ふらず、土,つちが、かわいて割,われたため、農夫,のうふは恥,はじて、その頭,あたまをおおう。","tok":[["地","ち"],["に"],["雨","あめ"],["が"],["降らず","ふらず"],["、"],["土","つち"],["が"],["、"],["かわいて"],["割れた","われた"],["ため"],["、"],["農夫","のうふ"],["は"],["恥","はじ"],["て"],["、"],["その"],["頭","あたま"],["を"],["おおう"],["。"]]},{"verse":5,"text":"野,のにいる雌,めじかでさえも子,こを産,うんで、これを捨,すてる。草,くさがないからである。","tok":[["野","の"],["に"],["いる"],["雌","め"],["じか"],["で"],["さえ"],["も"],["子","こ"],["を"],["産んで","うんで"],["、"],["これ"],["を"],["捨てる","すてる"],["。"],["草","くさ"],["が"],["ない"],["から"],["で"],["ある"],["。"]]},{"verse":6,"text":"野,のろばは、はげ山,やまの上,うえに立,たって、山犬,やまいぬのようにあえぎ、草,くさのないために、その目,めはくらむ。","tok":[["野","の"],["ろば"],["は"],["、"],["はげ山","はげやま"],["の"],["上","うえ"],["に"],["立って","たって"],["、"],["山犬","やまいぬ"],["の"],["よう"],["に"],["あえぎ"],["、"],["草","くさ"],["の"],["ない"],["ため"],["に"],["、"],["その"],["目","め"],["は"],["くらむ"],["。"]]},{"verse":7,"text":"主,しゅよ、われわれの罪,つみがわれわれを訴,うったえて不利,ふりな証言,しょうげんをしても、あなたの名,なのために、事,ことをなしてください。われわれの背信,はいしんの数,かずは多,おおく、あなたに向,むかって罪,つみを犯,おかしました。","tok":[["主","しゅ"],["よ"],["、"],["われわれ"],["の"],["罪","つみ"],["が"],["われわれ"],["を"],["訴て","うったえて"],["不利","ふり"],["な"],["証言","しょうげん"],["を"],["して"],["も"],["、"],["あなた"],["の"],["名","な"],["の"],["ため"],["に"],["、"],["事","こと"],["を"],["なして"],["ください"],["。"],["われわれ"],["の"],["背信","はいしん"],["の"],["数","かず"],["は"],["多く","おおく"],["、"],["あなた"],["に"],["向かって","むかって"],["罪","つみ"],["を"],["犯しました","おかしました"],["。"]]},{"verse":8,"text":"イスラエルの望,のぞみなる主,しゅよ、悩,なやみの時,ときの救主,すくいぬしよ、なぜ、あなたはこの地,ちに住,すむ異邦,いほうの人,ひとのようにし、また一夜,いちやの宿,やどりのために立,たち寄,よる旅,たびびとのようになさらねばならないのですか。","tok":[["イスラエル"],["の"],["望み","のぞみ"],["なる"],["主","しゅ"],["よ"],["、"],["悩み","なやみ"],["の"],["時","とき"],["の"],["救主","す"],["くい"],["ぬし"],["よ"],["、"],["なぜ"],["、"],["あなた"],["は"],["この"],["地","ち"],["に"],["住む","すむ"],["異邦","いほう"],["の"],["人","ひと"],["の"],["よう"],["に"],["し"],["、"],["また"],["一夜","いちや"],["の"],["宿り","やどり"],["の"],["ため"],["に"],["立ち寄る","たちよる"],["旅びと","たびびと"],["の"],["よう"],["に"],["なさらねば"],["ならない"],["の"],["です"],["か"],["。"]]},{"verse":9,"text":"なぜ、あなたは、うろたえている人,ひとのようにし、また人,ひとを救,すくいえない勇士,ゆうしのようになさらねばならないのですか。主,しゅよ、あなたはわれわれのうちにいらせられます。われわれは、み名,なによって呼,よばれている者,ものです。われわれを見捨,みすてないでください」。","tok":[["なぜ"],["、"],["あなた"],["は"],["、"],["うろたえて"],["いる"],["人","ひと"],["の"],["よう"],["に"],["し"],["、"],["また"],["人","ひと"],["を"],["救い","すくい"],["えない"],["勇士","ゆうし"],["の"],["よう"],["に"],["なさらねば"],["ならない"],["の"],["です"],["か"],["。"],["主","しゅ"],["よ"],["、"],["あなた"],["は"],["われわれ"],["の"],["うち"],["に"],["いらせられます"],["。"],["われわれ"],["は"],["、"],["み名","みな"],["によって"],["呼ばれて","よばれて"],["いる"],["者","もの"],["です"],["。"],["われわれ"],["を"],["見捨てないで","みすてないで"],["ください"],["」"],["。"]]},{"verse":10,"text":"この民,たみについて主,しゅはこう言,いわれる、「彼,かれらはこのように好,このんで、さまよい、その足,あしをとどめることをしなかったので、主,しゅは彼,かれらを喜,よろこばず、いまそのとがを覚,おぼえ、その罪,つみを罰,ばっするのだ」。","tok":[["この"],["民","たみ"],["について"],["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["「"],["彼","かれ"],["ら"],["は"],["この"],["よう"],["に"],["好んで","このんで"],["、"],["さまよい"],["、"],["その"],["足","あし"],["を"],["とどめる"],["こと"],["を"],["しなかった"],["ので"],["、"],["主","しゅ"],["は"],["彼","かれ"],["ら"],["を"],["喜こばず","よろこばず"],["、"],["いま"],["その"],["とが"],["を"],["覚え","おぼえ"],["、"],["その"],["罪","つみ"],["を"],["罰する","ばっする"],["の"],["だ"],["」"],["。"]]},{"verse":11,"text":"主,しゅはわたしに言,いわれた、「この民,たみのために恵,めぐみを祈,いのってはならない。","tok":[["主","しゅ"],["は"],["わたし"],["に"],["言われた","いわれた"],["、"],["「"],["この"],["民","たみ"],["の"],["ため"],["に"],["恵","めぐみ"],["を"],["祈って","いのって"],["は"],["ならない"],["。"]]},{"verse":12,"text":"彼,かれらが断食,だんじきしても、わたしは彼,かれらの呼,よぶのを聞,きかない。燔祭,はんさいと素祭,そさいをささげても、わたしはそれを受,うけない。かえって、つるぎと、ききん、および疫病,えきびょうをもって、彼,かれらを滅,ほろぼしてしまう」。","tok":[["彼","かれ"],["ら"],["が"],["断食","だんじき"],["して"],["も"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["呼ぶ","よぶ"],["の"],["を"],["聞かない","きかない"],["。"],["燔祭","はんさい"],["と"],["素","す"],["祭","まつり"],["を"],["ささげて"],["も"],["、"],["わたし"],["は"],["それ"],["を"],["受ない","うけない"],["。"],["かえって"],["、"],["つるぎ"],["と"],["、"],["ききん"],["、"],["および"],["疫病","えきびょう"],["を"],["もって"],["、"],["彼","かれ"],["ら"],["を"],["滅ぼして","ほろぼして"],["しまう"],["」"],["。"]]},{"verse":13,"text":"わたしは言,いった、「ああ、主,しゅなる神,かみよ、預言者,よげんしゃたちはこの民,たみに向,むかい、『あなたがたは、つるぎを見,みることはない。ききんもこない。わたしはこの所,ところに確,たしかな平安,へいあんをあなたがたに与,あたえる』と言,いっています」。","tok":[["わたし"],["は"],["言った","いった"],["、"],["「"],["ああ"],["、"],["主","しゅ"],["なる"],["神","かみ"],["よ"],["、"],["預言者","よげんしゃ"],["たち"],["は"],["この"],["民","たみ"],["に"],["向","むかい"],["、"],["『"],["あなた"],["がた"],["は"],["、"],["つるぎ"],["を"],["見る","みる"],["こと"],["は"],["ない"],["。"],["ききん"],["も"],["こない"],["。"],["わたし"],["は"],["この"],["所","ところ"],["に"],["確か","たしか"],["な"],["平安","へいあん"],["を"],["あなた"],["がた"],["に"],["与える","あたえる"],["』"],["と"],["言って","いって"],["います"],["」"],["。"]]},{"verse":14,"text":"主,しゅはわたしに言,いわれた、「預言者,よげんしゃらはわたしの名,なによって偽,いつわりの預言,よげんをしている。わたしは彼,かれらをつかわさなかった。また彼,かれらに命,めいじたこともなく、話,はなしたこともない。彼,かれらは偽,いつわりの黙示,もくしと、役,やくに立,たたない占,うらない、および自分,じぶんの心,こころでつくりあげた欺,あざむきをあなたがたに預言,よげんしているのだ。","tok":[["主","しゅ"],["は"],["わたし"],["に"],["言われた","いわれた"],["、"],["「"],["預言者","よげんしゃ"],["ら"],["は"],["わたし"],["の"],["名","な"],["によって"],["偽わり","いつわり"],["の"],["預言","よげん"],["を"],["して"],["いる"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["つかわさなかった"],["。"],["また"],["彼","かれ"],["ら"],["に"],["命じた","めいじた"],["こと"],["も"],["なく"],["、"],["話","はなし"],["た"],["こと"],["も"],["ない"],["。"],["彼","かれ"],["ら"],["は"],["偽わり","いつわり"],["の"],["黙示","もくし"],["と"],["、"],["役","やく"],["に"],["立たない","たたない"],["占","うらない"],["、"],["および"],["自分","じぶん"],["の"],["心","こころ"],["で"],["つくりあげた"],["欺き","あざむき"],["を"],["あなた"],["がた"],["に"],["預言","よげん"],["して"],["いる"],["の"],["だ"],["。"]]},{"verse":15,"text":"それゆえ、わたしがつかわさないのに、わたしの名,なによって預言,よげんして、『つるぎとききんは、この地,ちにこない』と言,いっているあの預言者,よげんしゃについて、主,しゅはこう仰,おおせられる、この預言者,よげんしゃらは、つるぎとききんに滅,ほろぼされる。","tok":[["それ"],["ゆえ"],["、"],["わたし"],["が"],["つかわさない"],["のに"],["、"],["わたし"],["の"],["名","な"],["によって"],["預言","よげん"],["して"],["、"],["『"],["つるぎ"],["と"],["ききん"],["は"],["、"],["この"],["地","ち"],["に"],["こない"],["』"],["と"],["言って","いって"],["いる"],["あの"],["預言者","よげんしゃ"],["について"],["、"],["主","しゅ"],["は"],["こう"],["仰せられる","おおせられる"],["、"],["この"],["預言者","よげんしゃ"],["ら"],["は"],["、"],["つるぎ"],["と"],["ききん"],["に"],["滅ぼされる","ほろぼされる"],["。"]]},{"verse":16,"text":"また彼,かれらの預言,よげんを聞,きく民,たみは、ききんとつるぎとによって、エルサレムのちまたに投,なげ捨,すてられる。だれもこれを葬,ほうむる者,ものはない。彼,かれらとその妻,つま、およびそのむすこ娘,むすめも同様,どうようである。わたしが彼,かれらの悪,あくをその上,うえに注,そそぐからである。","tok":[["また"],["彼","かれ"],["ら"],["の"],["預言","よげん"],["を"],["聞く","きく"],["民","たみ"],["は"],["、"],["ききん"],["と"],["つるぎ"],["と"],["によって"],["、"],["エルサレム"],["の"],["ちまた"],["に"],["投捨てられる","なげすてられる"],["。"],["だれ"],["も"],["これ"],["を"],["葬むる","ほうむる"],["者","もの"],["は"],["ない"],["。"],["彼","かれ"],["ら"],["と"],["その"],["妻","つま"],["、"],["および"],["その"],["むすこ"],["娘","むすめ"],["も"],["同様","どうよう"],["で"],["ある"],["。"],["わたし"],["が"],["彼","かれ"],["ら"],["の"],["悪","あく"],["を"],["その"],["上","うえ"],["に"],["注ぐ","そそぐ"],["から"],["で"],["ある"],["。"]]},{"verse":17,"text":"この言葉,ことばを彼,かれらに語,かたれ、『わたしの目,めは夜,よるも昼,ひるも絶,たえず涙,なみだを流,ながす。わが民,たみの娘,むすめであるおとめが大,おおきな傷,きずと重,おもい打撃,だげきによって滅,ほろぼされるからである。","tok":[["この"],["言葉","ことば"],["を"],["彼","かれ"],["ら"],["に"],["語れ","かたれ"],["、"],["『"],["わたし"],["の"],["目","め"],["は"],["夜","よる"],["も"],["昼","ひる"],["も"],["絶えず","たえず"],["涙","なみだ"],["を"],["流す","ながす"],["。"],["わが"],["民","たみ"],["の"],["娘","むすめ"],["で"],["ある"],["おとめ"],["が"],["大きな","おおきな"],["傷","きず"],["と"],["重い","おもい"],["打撃","だげき"],["によって"],["滅ぼされる","ほろぼされる"],["から"],["で"],["ある"],["。"]]},{"verse":18,"text":"わたしが出,でて畑,はたけに行,いくと、つるぎで殺,ころされた者,ものがある。町,まちにはいると、ききんで病,やんでいる者,ものがある。預言者,よげんしゃも祭司,さいしも共,ともにその地,ちにさまよって、知,しるところがない』」。","tok":[["わたし"],["が"],["出て","でて"],["畑","はたけ"],["に"],["行く","いく"],["と"],["、"],["つるぎ"],["で"],["殺ろされた","ころされた"],["者","もの"],["が"],["ある"],["。"],["町","まち"],["に"],["はいる"],["と"],["、"],["ききん"],["で"],["病んで","やんで"],["いる"],["者","もの"],["が"],["ある"],["。"],["預言者","よげんしゃ"],["も"],["祭司","さいし"],["も"],["共","とも"],["に"],["その"],["地","ち"],["に"],["さまよって"],["、"],["知る","しる"],["ところ"],["が"],["ない"],["』"],["」"],["。"]]},{"verse":19,"text":"あなたはまったくユダを捨,すてられたのですか。あなたの心,こころはシオンをきらわれるのですか。あなたはわれわれを撃,うったのに、どうしていやしてはくださらないのですか。われわれは平安,へいあんを望,のぞんだが、良,よい事,ことはこなかった。いやされる時,ときを望,のぞんだが、かえって恐怖,きょうふが来,きた。","tok":[["あなた"],["は"],["まったく"],["ユダ"],["を"],["捨てられた","すてられた"],["の"],["です"],["か"],["。"],["あなた"],["の"],["心","こころ"],["は"],["シオン"],["を"],["きらわれる"],["の"],["です"],["か"],["。"],["あなた"],["は"],["われわれ"],["を"],["撃った","うった"],["のに"],["、"],["どう"],["して"],["いやして"],["は"],["くださらない"],["の"],["です"],["か"],["。"],["われわれ"],["は"],["平安","へいあん"],["を"],["望んだ","のぞんだ"],["が"],["、"],["良い","よい"],["事","こと"],["は"],["こなかった"],["。"],["いや"],["される"],["時","とき"],["を"],["望んだ","のぞんだ"],["が"],["、"],["かえって"],["恐怖","きょうふ"],["が"],["来た","きた"],["。"]]},{"verse":20,"text":"主,しゅよ、われわれは自分,じぶんの悪,あくと、先祖,せんぞのとがとを認,みとめています。われわれはあなたに罪,つみを犯,おかしました。","tok":[["主","しゅ"],["よ"],["、"],["われわれ"],["は"],["自分","じぶん"],["の"],["悪","あく"],["と"],["、"],["先祖","せんぞ"],["の"],["とが"],["と"],["を"],["認めて","みとめて"],["います"],["。"],["われわれ"],["は"],["あなた"],["に"],["罪","つみ"],["を"],["犯しました","おかしました"],["。"]]},{"verse":21,"text":"み名,なのために、われわれを捨,すてないでください。あなたの栄,さかえあるみ位,くらいをはずかしめないでください。あなたがわれわれにお立,たてになった契約,けいやくを覚,おぼえて、それを破,やぶらないでください。","tok":[["み名","みな"],["の"],["ため"],["に"],["、"],["われわれ"],["を"],["捨てないで","すてないで"],["ください"],["。"],["あなた"],["の"],["栄","さかえ"],["ある"],["み位","みくらい"],["を"],["はずかしめないで"],["ください"],["。"],["あなた"],["が"],["われわれ"],["に"],["お立","おたて"],["に"],["なった"],["契約","けいやく"],["を"],["覚えて","おぼえて"],["、"],["それ"],["を"],["破らないで","やぶらないで"],["ください"],["。"]]},{"verse":22,"text":"異邦,いほうの偽,いつわりの神々,かみがみのうちに、雨,あめを降,ふらせうる者,ものがあるであろうか。天,てんが自分,じぶんで夕立,ゆうだちを降,ふらすことができようか。われわれの神,かみ、主,しゅよ、あなたこそ、これをなさる方,かたではありませんか。われわれの待,まち望,のぞむのはあなたです。あなたがこれらすべてのことをなさるからです。","tok":[["異邦","いほう"],["の"],["偽わり","いつわり"],["の"],["神々","かみがみ"],["の"],["うち"],["に"],["、"],["雨","あめ"],["を"],["降らせ","ふらせ"],["うる"],["者","もの"],["が"],["あるで"],["あろう"],["か"],["。"],["天","てん"],["が"],["自分","じぶん"],["で"],["夕立","ゆうだち"],["を"],["降らす","ふらす"],["こと"],["が"],["できよう"],["か"],["。"],["われわれ"],["の"],["神","かみ"],["、"],["主","しゅ"],["よ"],["、"],["あなた"],["こそ"],["、"],["これ"],["を"],["なさる"],["方","かた"],["で"],["は"],["ありません"],["か"],["。"],["われわれ"],["の"],["待望む","まちのぞむ"],["の"],["は"],["あなた"],["です"],["。"],["あなた"],["が"],["これ"],["ら"],["すべて"],["の"],["こと"],["を"],["なさる"],["から"],["です"],["。"]]}]
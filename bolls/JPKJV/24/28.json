[{"verse":1,"text":"その年,ねん、すなわちユダの王,おうゼデキヤの治世,ちせいの初,はじめ、その第,だい四年,ねんの五月,がつ、ギベオン出身,しゅっしんの預言者,よげんしゃであって、アズルの子,こであるハナニヤは、主,しゅの宮,みやで祭司,さいしとすべての民,たみの前,まえでわたしに語,かたって言,いった、","tok":[["その"],["年","ねん"],["、"],["すなわち"],["ユダ"],["の"],["王","おう"],["ゼデキヤ"],["の"],["治世","ちせい"],["の"],["初め","はじめ"],["、"],["その"],["第","だい"],["四","よん"],["年","ねん"],["の"],["五","ご"],["月","がつ"],["つ"],["、"],["ギベオン"],["出身","しゅっしん"],["の"],["預言者","よげんしゃ"],["で"],["あって"],["、"],["アズル"],["の"],["子","こ"],["で"],["ある"],["ハナニヤ"],["は"],["、"],["主","しゅ"],["の"],["宮","みや"],["で"],["祭司","さいし"],["と"],["すべて"],["の"],["民","たみ"],["の"],["前","まえ"],["で"],["わたし"],["に"],["語って","かたって"],["言った","いった"],["、"]]},{"verse":2,"text":"「万軍,ばんぐんの主,しゅ、イスラエルの神,かみはこう仰,おおせられる、わたしはバビロンの王,おうのくびきを砕,くだいた。","tok":[["「"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["、"],["イスラエル"],["の"],["神","かみ"],["は"],["こう"],["仰せられる","おおせられる"],["、"],["わたし"],["は"],["バビロン"],["の"],["王","おう"],["の"],["くびき"],["を"],["砕いた","くだいた"],["。"]]},{"verse":3,"text":"二年,ねんの内,うちに、バビロンの王,おうネブカデネザルが、この所,ところから取,とってバビロンに携,たずさえて行,いった主,しゅの宮,みやの器,うつわを、皆,みなこの所,ところに帰,かえらせる。","tok":[["二","に"],["年","ねん"],["の"],["内","うち"],["に"],["、"],["バビロン"],["の"],["王","おう"],["ネブカデネザル"],["が"],["、"],["この"],["所","ところ"],["から"],["取って","とって"],["バビロン"],["に"],["携えて","たずさえて"],["行った","いった"],["主","しゅ"],["の"],["宮","みや"],["の"],["器","うつわ"],["を"],["、"],["皆","みな"],["この"],["所","ところ"],["に"],["帰えらせる","かえらせる"],["。"]]},{"verse":4,"text":"わたしはまたユダの王,おうエホヤキムの子,こエコニヤと、バビロンに行,いったユダのすべての捕,とらわれ人,びとをこの所,ところに帰,かえらせる。それは、わたしがバビロンの王,おうのくびきを、砕,くだくからであると主,しゅは言,いわれる」。","tok":[["わたし"],["は"],["また"],["ユダ"],["の"],["王","おう"],["エホヤキム"],["の"],["子","こ"],["エコニヤ"],["と"],["、"],["バビロン"],["に"],["行った","いった"],["ユダ"],["の"],["すべて"],["の"],["捕らわれ","とらわれ"],["人","びとをこ"],["の"],["所","ところ"],["に"],["帰えらせる","かえらせる"],["。"],["それ"],["は"],["、"],["わたし"],["が"],["バビロン"],["の"],["王","おう"],["の"],["くびき"],["を"],["、"],["砕く","くだく"],["から"],["で"],["ある"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["」"],["。"]]},{"verse":5,"text":"そこで預言者,よげんしゃエレミヤは主,しゅの宮,みやのうちに立,たっている祭司,さいしとすべての民,たみの前,まえで、預言者,よげんしゃハナニヤに言,いった。","tok":[["そこ"],["で"],["預言者","よげんしゃ"],["エレミヤ"],["は"],["主","しゅ"],["の"],["宮","みや"],["の"],["うち"],["に"],["立って","たって"],["いる"],["祭司","さいし"],["と"],["すべて"],["の"],["民","たみ"],["の"],["前","まえ"],["で"],["、"],["預言者","よげんしゃ"],["ハナニヤ"],["に"],["言った","いった"],["。"]]},{"verse":6,"text":"すなわち預言者,よげんしゃエレミヤは言,いった、「アァメン。どうか主,しゅがこのようにしてくださるように。どうかあなたの預言,よげんした言葉,ことばが成就,じょうじゅして、バビロンに携,たずさえて行,いった主,しゅの宮,みやの器,うつわとすべての捕,とらわれ人,びとを、主,しゅがバビロンから再,ふたたびこの所,ところに帰,かえらせてくださるように。","tok":[["すなわち"],["預言者","よげんしゃ"],["エレミヤ"],["は"],["言った","いった"],["、"],["「"],["アァメン"],["。"],["どう"],["か"],["主","しゅがこ"],["の"],["よう"],["に"],["して"],["くださる"],["よう"],["に"],["。"],["どう"],["か"],["あなた"],["の"],["預言","よげん"],["した"],["言葉","ことば"],["が"],["成就","じょうじゅ"],["して"],["、"],["バビロン"],["に"],["携えて","たずさえて"],["行った","いった"],["主","しゅ"],["の"],["宮","みや"],["の"],["器","うつわ"],["と"],["すべて"],["の"],["捕らわれ","とらわれ"],["人","びと"],["を"],["、"],["主","しゅ"],["が"],["バビロン"],["から"],["再び","ふたたび"],["この"],["所","ところ"],["に"],["帰えらせて","かえらせて"],["くださる"],["よう"],["に"],["。"]]},{"verse":7,"text":"ただし、今,いまわたしがあなたとすべての民,たみの聞,きいている所,ところで語,かたるこの言葉,ことばを聞,ききなさい。","tok":[["ただし"],["、"],["今","いま"],["わたし"],["が"],["あなた"],["と"],["すべて"],["の"],["民","たみ"],["の"],["聞いて","きいて"],["いる"],["所","ところ"],["で"],["語る","かたる"],["この"],["言葉","ことば"],["を"],["聞","きき"],["なさい"],["。"]]},{"verse":8,"text":"わたしと、あなたの先,さきに出,でた預言者,よげんしゃは、むかしから、多,おおくの地,ちと大,おおきな国,くにについて、戦,たたかいと、ききんと、疫病,えきびょうの事,ことを預言,よげんした。","tok":[["わたし"],["と"],["、"],["あなた"],["の"],["先","さき"],["に"],["出た","でた"],["預言者","よげんしゃ"],["は"],["、"],["むかし"],["から"],["、"],["多く","おおく"],["の"],["地","ち"],["と"],["大きな","おおきな"],["国","くに"],["について"],["、"],["戦い","たたかい"],["と"],["、"],["ききん"],["と"],["、"],["疫病","えきびょう"],["の"],["事","こと"],["を"],["預言","よげん"],["した"],["。"]]},{"verse":9,"text":"平和,へいわを預言,よげんする預言者,よげんしゃは、その預言者,よげんしゃの言葉,ことばが成就,じょうじゅするとき、真実,しんじつに主,しゅがその預言者,よげんしゃをつかわされたのであることが知,しられるのだ」。","tok":[["平和","へいわ"],["を"],["預言","よげん"],["する"],["預言者","よげんしゃ"],["は"],["、"],["その"],["預言者","よげんしゃ"],["の"],["言葉","ことば"],["が"],["成就","じょうじゅ"],["する"],["とき"],["、"],["真実","しんじつ"],["に"],["主","しゅがそ"],["の"],["預言者","よげんしゃ"],["を"],["つかわされた"],["ので"],["ある"],["こと"],["が"],["知られる","しられる"],["の"],["だ"],["」"],["。"]]},{"verse":10,"text":"そこで預言者,よげんしゃハナニヤは預言者,よげんしゃエレミヤの首,くびから、くびきを取,とって、それを砕,くだいた。","tok":[["そこ"],["で"],["預言者","よげんしゃ"],["ハナニヤ"],["は"],["預言者","よげんしゃ"],["エレミヤ"],["の"],["首","くび"],["から"],["、"],["くびき"],["を"],["取って","とって"],["、"],["それ"],["を"],["砕いた","くだいた"],["。"]]},{"verse":11,"text":"そしてハナニヤは、すべての民,たみの前,まえで語,かたり、「主,しゅはこう仰,おおせられる、『わたしは二年,ねんのうちに、このように、万国民,ばんこくみんの首,くびからバビロンの王,おうネブカデネザルのくびきを離,はなして砕,くだく』」と言,いった。預言者,よげんしゃエレミヤは去,さって行,いった。","tok":[["そして"],["ハナニヤ"],["は"],["、"],["すべて"],["の"],["民","たみ"],["の"],["前","まえ"],["で"],["語り","かたり"],["、"],["「"],["主","しゅ"],["は"],["こう"],["仰せられる","おおせられる"],["、"],["『"],["わたし"],["は"],["二","に"],["年","ねん"],["の"],["うち"],["に"],["、"],["この"],["よう"],["に"],["、"],["万","まん"],["国民","こくみん"],["の"],["首","くび"],["から"],["バビロン"],["の"],["王","おう"],["ネブカデネザル"],["の"],["くびき"],["を"],["離して","はなして"],["砕く","くだく"],["』"],["」"],["と"],["言った","いった"],["。"],["預言者","よげんしゃ"],["エレミヤ"],["は"],["去て","さって"],["行った","いった"],["。"]]},{"verse":12,"text":"預言者,よげんしゃハナニヤが預言者,よげんしゃエレミヤの首,くびから、くびきを離,はなして砕,くだいた後,のち、しばらくして主,しゅの言葉,ことばがエレミヤに臨,のぞんだ、","tok":[["預言者","よげんしゃ"],["ハナニヤ"],["が"],["預言者","よげんしゃ"],["エレミヤ"],["の"],["首","くび"],["から"],["、"],["くびき"],["を"],["離して","はなして"],["砕いた","くだいた"],["後","の"],["ち"],["、"],["しばらく"],["して"],["主","しゅ"],["の"],["言葉","ことば"],["が"],["エレミヤ"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":13,"text":"「行,いって、ハナニヤに告,つげなさい、『主,しゅはこう仰,おおせられる、あなたは木,きのくびきを砕,くだいたが、わたしはそれに替,かえて鉄,てつのくびきを作,つくろう。","tok":[["「"],["行って","いって"],["、"],["ハナニヤ"],["に"],["告","つげ"],["なさい"],["、"],["『"],["主","しゅ"],["は"],["こう"],["仰せられる","おおせられる"],["、"],["あなた"],["は"],["木","き"],["の"],["くびき"],["を"],["砕いた","くだいた"],["が"],["、"],["わたし"],["は"],["それ"],["に"],["替","かえ"],["て"],["鉄","てつ"],["の"],["くびき"],["を"],["作ろう","つくろう"],["。"]]},{"verse":14,"text":"万軍,ばんぐんの主,しゅ、イスラエルの神,かみはこう仰,おおせられる、わたしは鉄,てつのくびきをこの万国民,ばんこくみんの首,くびに置,おいて、バビロンの王,おうネブカデネザルに仕,つかえさせる。彼,かれらはこれに仕,つかえる。わたしは野,のの獣,けものをも彼,かれに与,あたえた』」。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["、"],["イスラエル"],["の"],["神","かみ"],["は"],["こう"],["仰せられる","おおせられる"],["、"],["わたし"],["は"],["鉄","てつ"],["の"],["くびき"],["を"],["この"],["万","まん"],["国民","こくみん"],["の"],["首","くび"],["に"],["置いて","おいて"],["、"],["バビロン"],["の"],["王","おう"],["ネブカデネザル"],["に"],["仕えさせる","つかえさせる"],["。"],["彼","かれ"],["ら"],["は"],["これ"],["に"],["仕える","つかえる"],["。"],["わたし"],["は"],["野","の"],["の"],["獣","けもの"],["を"],["も"],["彼","かれ"],["に"],["与","あたえ"],["た"],["』"],["」"],["。"]]},{"verse":15,"text":"預言者,よげんしゃエレミヤはまた預言者,よげんしゃハナニヤに言,いった、「ハナニヤよ、聞,ききなさい。主,しゅがあなたをつかわされたのではない。あなたはこの民,たみに偽,いつわりを信,しんじさせた。","tok":[["預言者","よげんしゃ"],["エレミヤ"],["は"],["また"],["預言者","よげんしゃ"],["ハナニヤ"],["に"],["言った","いった"],["、"],["「"],["ハナニヤ"],["よ"],["、"],["聞","きき"],["なさい"],["。"],["主","しゅ"],["が"],["あなた"],["を"],["つかわされた"],["ので"],["は"],["ない"],["。"],["あなた"],["は"],["この"],["民","たみ"],["に"],["偽り","いつわり"],["を"],["信じさせた","しんじさせた"],["。"]]},{"verse":16,"text":"それゆえ主,しゅは仰,おおせられる、『わたしはあなたを地,ちのおもてから除,のぞく。あなたは主,しゅに対,たいする反逆,はんぎゃくを語,かたったので、今,いま年,としのうちに死,しぬのだ』と」。","tok":[["それ"],["ゆえ"],["主","しゅ"],["は"],["仰せられる","おおせられる"],["、"],["『"],["わたし"],["は"],["あなた"],["を"],["地","ち"],["の"],["おもて"],["から"],["除く","のぞく"],["。"],["あなた"],["は"],["主","しゅ"],["に"],["対する","たいする"],["反逆","はんぎゃく"],["を"],["語った","かたった"],["ので"],["、"],["今年","いまとし"],["の"],["うち"],["に"],["死ぬ","しぬ"],["の"],["だ"],["』"],["と"],["」"],["。"]]},{"verse":17,"text":"預言者,よげんしゃハナニヤはその年,ねんの七月,がつに死,しんだ。","tok":[["預言者","よげんしゃ"],["ハナニヤ"],["は"],["その"],["年","ねん"],["の"],["七","なな"],["月","がつ"],["に"],["死んだ","しんだ"],["。"]]}]
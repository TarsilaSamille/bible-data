[{"verse":1,"text":"主,しゅよ、わたしがあなたと論,ろんじ争,あらそう時,とき、あなたは常,つねに正,ただしい。しかしなお、わたしはあなたの前,まえに、さばきのことを論,ろんじてみたい。悪人,あくにんの道,みちがさかえ、不信実,ふしんじつな者,ものがみな繁栄,はんえいするのはなにゆえですか。","tok":[["主","しゅ"],["よ"],["、"],["わたし"],["が"],["あなた"],["と"],["論じ","ろんじ"],["争う","あらそう"],["時","とき"],["、"],["あなた"],["は"],["常","つね"],["に"],["正い","ただしい"],["。"],["しかし"],["なお"],["、"],["わたし"],["は"],["あなた"],["の"],["前","まえ"],["に"],["、"],["さばき"],["の"],["こと"],["を"],["論じて","ろんじて"],["みたい"],["。"],["悪人","あくにん"],["の"],["道","みち"],["が"],["さかえ"],["、"],["不","ふ"],["信実","しんじつ"],["な"],["者","もの"],["が"],["みな"],["繁栄","はんえい"],["する"],["の"],["は"],["なにゆえ"],["です"],["か"],["。"]]},{"verse":2,"text":"あなたが彼,かれらを植,うえられたので、彼,かれらは根,ねづき、育,そだって、実,みを結,むすびます。彼,かれらは口,くちではあなたに近,ちかづきますが、心,こころはあなたから遠,とおざかっています。","tok":[["あなた"],["が"],["彼","かれ"],["ら"],["を"],["植えられた","うえられた"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["根づき","ねづき"],["、"],["育って","そだって"],["、"],["実","み"],["を"],["結びます","むすびます"],["。"],["彼","かれ"],["ら"],["は"],["口","くち"],["で"],["は"],["あなた"],["に"],["近づきます","ちかづきます"],["が"],["、"],["心","こころ"],["は"],["あなた"],["から"],["遠ざかって","とおざかって"],["います"],["。"]]},{"verse":3,"text":"主,しゅよ、あなたはわたしを知,しり、わたしを見,み、わたしの心,こころがあなたに対,たいしていかにあるかを試,こころみられます。ほふるために羊,ひつじを引,ひき出,だすように、彼,かれらを引,ひき出,だし、殺,ころす日,ひにそなえて、彼,かれらを残,のこしておいてください。","tok":[["主","しゅ"],["よ"],["、"],["あなた"],["は"],["わたし"],["を"],["知り","しり"],["、"],["わたし"],["を"],["見","み"],["、"],["わたし"],["の"],["心","こころ"],["が"],["あなた"],["に対して","にたいして"],["いかに"],["ある"],["か"],["を"],["試みられます","こころみられます"],["。"],["ほふる"],["ため"],["に"],["羊","ひつじ"],["を"],["引出す","ひきだす"],["よう"],["に"],["、"],["彼","かれ"],["ら"],["を"],["引出し","ひきだし"],["、"],["殺ろす","ころす"],["日","ひ"],["に"],["そなえて"],["、"],["彼","かれ"],["ら"],["を"],["残して","のこして"],["おいて"],["ください"],["。"]]},{"verse":4,"text":"いつまで、この地,ちは嘆,なげき、どの畑,はたけの野菜,やさいも枯,かれていてよいでしょうか。この地,ちに住,すむ者,ものの悪,あくによって、獣,けものと鳥,とりは滅,ほろびうせます。人々,ひとびとは言,いいました、「彼,かれはわれわれの終,おわりを見,みることはない」と。","tok":[["いつ"],["まで"],["、"],["この"],["地","ち"],["は"],["嘆き","なげき"],["、"],["どの"],["畑","はたけ"],["の"],["野菜","やさい"],["も"],["枯て","かれて"],["いて"],["よいでしょう"],["か"],["。"],["この"],["地","ち"],["に"],["住む","すむ"],["者","もの"],["の"],["悪","あく"],["によって"],["、"],["獣","けもの"],["と"],["鳥","とり"],["は"],["滅び","ほろび"],["うせます"],["。"],["人々","ひとびと"],["は"],["言いました","いいました"],["、"],["「"],["彼","かれ"],["は"],["われわれ"],["の"],["終","おわり"],["を"],["見る","みる"],["こと"],["は"],["ない"],["」"],["と"],["。"]]},{"verse":5,"text":"「もしあなたが、徒歩,とほの人,ひとと競争,きょうそうして疲,つかれるなら、どうして騎馬,きばの人,ひとと競,きそうことができようか。もし安全,あんぜんな地,ちで、あなたが倒,たおれるなら、ヨルダンの密林,みつりんでは、どうするつもりか。","tok":[["「"],["もし"],["あなた"],["が"],["、"],["徒歩","とほ"],["の"],["人","ひと"],["と"],["競争","きょうそう"],["して"],["疲れるなら","つかれるなら"],["、"],["どう"],["して"],["騎馬","きば"],["の"],["人","ひと"],["と"],["競う","きそう"],["こと"],["が"],["できよう"],["か"],["。"],["もし"],["安全","あんぜん"],["な"],["地","ち"],["で"],["、"],["あなた"],["が"],["倒れるなら","たおれるなら"],["、"],["ヨルダン"],["の"],["密林","みつりん"],["で"],["は"],["、"],["どう"],["する"],["つもり"],["か"],["。"]]},{"verse":6,"text":"あなたの兄弟,きょうだいたち、あなたの父,ちちの家,いえのものさえ、あなたを欺,あざむき、大声,おおごえをあげて、あなたを追,おっている。彼,かれらが親,したしげにあなたに語,かたることがあっても、彼,かれらを信,しんじてはならない」。","tok":[["あなた"],["の"],["兄弟","きょうだい"],["たち"],["、"],["あなた"],["の"],["父","ちち"],["の"],["家","いえ"],["の"],["もの"],["さえ"],["、"],["あなた"],["を"],["欺き","あざむき"],["、"],["大声","おおごえ"],["を"],["あげて"],["、"],["あなた"],["を"],["追って","おって"],["いる"],["。"],["彼","かれ"],["ら"],["が"],["親し","したし"],["げ"],["に"],["あなた"],["に"],["語る","かたる"],["こと"],["が"],["あって"],["も"],["、"],["彼","かれ"],["ら"],["を"],["信じて","しんじて"],["は"],["ならない"],["」"],["。"]]},{"verse":7,"text":"「わたしはわが家,やを離,はなれ、わが嗣,し業,ぎょうを捨,すて、わが魂,たましいの愛,あいする者,ものを敵,てきの手,てに渡,わたした。","tok":[["「"],["わたし"],["は"],["わが家","わがや"],["を"],["離れ","はなれ"],["、"],["わが"],["嗣業","しぎょう"],["を"],["捨て","すて"],["、"],["わが"],["魂","たましい"],["の"],["愛する","あいする"],["者","もの"],["を"],["敵","てき"],["の"],["手","て"],["に"],["渡","わたし"],["た"],["。"]]},{"verse":8,"text":"わたしの嗣,し業,ぎょうは、わたしにとって林,はやしの中,なかのししのようになった。これはわたしに向,むかってその声,こえをあげる。それゆえわたしはこれを憎,にくむ。","tok":[["わたし"],["の"],["嗣業","しぎょう"],["は"],["、"],["わたし"],["にとって"],["林","はやし"],["の"],["中","なか"],["の"],["しし"],["の"],["よう"],["に"],["なった"],["。"],["これ"],["は"],["わたし"],["に"],["向かって","むかって"],["その"],["声","こえ"],["を"],["あげる"],["。"],["それ"],["ゆえ"],["わたし"],["は"],["これ"],["を"],["憎む","にくむ"],["。"]]},{"verse":9,"text":"わたしの嗣,し業,ぎょうは、わたしにとって、斑点,はんてんのある猛禽,もうきんのようではないか。他,たの猛禽,もうきんがこれを囲,かこんでいるではないか。行,いって、野,のの獣,けものをみな集,あつめ、連,つれてきてこれを食,たべさせよ。","tok":[["わたし"],["の"],["嗣業","しぎょう"],["は"],["、"],["わたし"],["にとって"],["、"],["斑点","はんてん"],["の"],["ある"],["猛禽","もうきん"],["の"],["よう"],["で"],["は"],["ない"],["か"],["。"],["他","た"],["の"],["猛禽","もうきん"],["が"],["これ"],["を"],["囲んで","かこんで"],["いるで"],["は"],["ない"],["か"],["。"],["行って","いって"],["、"],["野","の"],["の"],["獣","けもの"],["を"],["みな"],["集め","あつめ"],["、"],["連れて","つれて"],["きて"],["これ"],["を"],["食べさせ","たべさせ"],["よ"],["。"]]},{"verse":10,"text":"多,おおくの牧者,ぼくしゃたちはわたしのぶどう畑,はたけを滅,ほろぼし、わたしの地,ちを踏,ふみ荒,あらした。わたしの麗,うるわしい地,ちを荒,あれた野,のにした。","tok":[["多く","おおく"],["の"],["牧者","ぼくしゃ"],["たち"],["は"],["わたし"],["の"],["ぶどう"],["畑","はたけ"],["を"],["滅ぼし","ほろぼし"],["、"],["わたし"],["の"],["地","ち"],["を"],["踏み荒した","ふみあらした"],["。"],["わたし"],["の"],["麗わしい","うるわしい"],["地","ち"],["を"],["荒た","あれた"],["野","の"],["に"],["した"],["。"]]},{"verse":11,"text":"彼,かれらはこれを荒,あれ地,ちとしてしまった。その荒,あれ地,ちがわたしに向,むかって嘆,なげくのだ。全,ぜん地,ちは荒,あれ地,ちにされた。しかし、ひとりもこれを心,こころに留,とめる者,ものはない。","tok":[["彼","かれ"],["ら"],["は"],["これ"],["を"],["荒れ地","あれち"],["として"],["しまった"],["。"],["その"],["荒れ地","あれち"],["が"],["わたし"],["に"],["向かって","むかって"],["嘆く","なげく"],["の"],["だ"],["。"],["全地","ぜんち"],["は"],["荒れ地","あれち"],["に"],["された"],["。"],["しかし"],["、"],["ひとり"],["も"],["これ"],["を"],["心","こころ"],["に"],["留める","とめる"],["者","もの"],["は"],["ない"],["。"]]},{"verse":12,"text":"滅,ほろぼす者,ものどもが荒野,あらののすべての、はげ山,やまの上,うえにきた。主,しゅのつるぎが、地,ちの、この果,はてから、かの果,はてまでを滅,ほろぼすのだ。命,いのちあるものは安,やすらかであることができない。","tok":[["滅ぼす","ほろぼす"],["者","もの"],["ども"],["が"],["荒野","あらの"],["の"],["すべて"],["の"],["、"],["はげ山","はげやま"],["の"],["上","うえ"],["に"],["きた"],["。"],["主","しゅ"],["の"],["つるぎ"],["が"],["、"],["地","ち"],["の"],["、"],["この"],["果て","はて"],["から"],["、"],["かの"],["果て","はて"],["まで"],["を"],["滅ぼす","ほろぼす"],["の"],["だ"],["。"],["命","いのち"],["ある"],["もの"],["は"],["安らか","やすらか"],["で"],["ある"],["こと"],["が"],["できない"],["。"]]},{"verse":13,"text":"彼,かれらは麦,むぎをまいて、いばらを刈,かり取,とる。苦労,くろうしてもなんの利益,りえきもない。彼,かれらはその収穫,しゅうかくを恥,はじるようになる。主,しゅの激,はげしい怒,いかりによってである」。","tok":[["彼","かれ"],["ら"],["は"],["麦","むぎ"],["を"],["まいて"],["、"],["いばら"],["を"],["刈取る","かりとる"],["。"],["苦労","くろう"],["して"],["も"],["なん"],["の"],["利益","りえき"],["も"],["ない"],["。"],["彼","かれ"],["ら"],["は"],["その"],["収穫","しゅうかく"],["を"],["恥","はじ"],["る"],["よう"],["に"],["なる"],["。"],["主","しゅ"],["の"],["激しい","はげしい"],["怒り","いかり"],["によって"],["で"],["ある"],["」"],["。"]]},{"verse":14,"text":"わたしがわが民,たみイスラエルにつがせた嗣,し業,ぎょうに手,てを触,ふれるすべての悪,わるい隣,となり人,びとについて、主,しゅはこう言,いわれる、「見,みよ、わたしは彼,かれらをその地,ちから抜,ぬき出,だし、ユダの家,いえを彼,かれらのうちから抜,ぬき出,だす。","tok":[["わたし"],["が"],["わが"],["民","た"],["みイスラエル"],["に"],["つがせた"],["嗣業","しぎょう"],["に"],["手","て"],["を"],["触れる","ふれる"],["すべて"],["の"],["悪い","わるい"],["隣人","となりびと"],["について"],["、"],["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["「"],["見よ","みよ"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["その"],["地","ち"],["から"],["抜き出し","ぬきだし"],["、"],["ユダ"],["の"],["家","いえ"],["を"],["彼","かれ"],["ら"],["の"],["うち"],["から"],["抜き出す","ぬきだす"],["。"]]},{"verse":15,"text":"わたしは、彼,かれらを抜,ぬき出,だしたのちに、また彼,かれらをあわれんで、それぞれその嗣,し業,ぎょうに導,みちびき返,かえし、おのおのを、その地,ちに帰,かえらせる。","tok":[["わたし"],["は"],["、"],["彼","かれ"],["ら"],["を"],["抜き出した","ぬきだした"],["のち"],["に"],["、"],["また"],["彼","かれ"],["ら"],["を"],["あわれんで"],["、"],["それぞれ"],["その"],["嗣業","しぎょう"],["に"],["導き","みちびき"],["返","かえし"],["、"],["おのおの"],["を"],["、"],["その"],["地","ち"],["に"],["帰えらせる","かえらせる"],["。"]]},{"verse":16,"text":"もし彼,かれらがわたしの民,たみの道,みちを学,まなび、わたしの名,なによって、『主,しゅは生,いきておられる』と言,いって誓,ちかうことが、かつて彼,かれらがわたしの民,たみに教,おしえてバアルをさして誓,ちかわせたようになるならば、彼,かれらはわたしの民,たみのうちに建,たてられる。","tok":[["もし"],["彼","かれ"],["ら"],["が"],["わたし"],["の"],["民","たみ"],["の"],["道","みち"],["を"],["学び","まなび"],["、"],["わたし"],["の"],["名","な"],["によって"],["、"],["『"],["主","しゅ"],["は"],["生きて","いきて"],["おられる"],["』"],["と"],["言って","いって"],["誓う","ちかう"],["こと"],["が"],["、"],["かつて"],["彼","かれ"],["ら"],["が"],["わたし"],["の"],["民","たみ"],["に"],["教えて","おしえて"],["バアル"],["を"],["さして"],["誓わせた","ちかわせた"],["よう"],["に"],["なるならば"],["、"],["彼","かれ"],["ら"],["は"],["わたし"],["の"],["民","たみ"],["の"],["うち"],["に"],["建てられる","たてられる"],["。"]]},{"verse":17,"text":"しかし耳,みみをかさない民,たみがあるときは、わたしはその民,たみを抜,ぬき出,だして滅,ほろぼすと、主,しゅは言,いわれる」。","tok":[["しかし"],["耳","みみ"],["を"],["かさない"],["民","たみ"],["が"],["ある"],["とき"],["は"],["、"],["わたし"],["は"],["その"],["民","たみ"],["を"],["抜き出して","ぬきだして"],["滅ぼす","ほろぼす"],["と"],["、"],["主","しゅ"],["は"],["言われる","いわれる"],["」"],["。"]]}]
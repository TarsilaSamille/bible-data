[{"verse":1,"text":"ユダの王,おうゼデキヤの十年,ねん、すなわちネブカデレザルの十八年,ねんに、主,しゅの言葉,ことばがエレミヤに臨,のぞんだ。","tok":[["ユダ"],["の"],["王","おう"],["ゼデキヤ"],["の"],["十","じゅう"],["年","ねん"],["、"],["すなわち"],["ネブカデレザル"],["の"],["十八","じゅうはち"],["年","ねん"],["に"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["が"],["エレミヤ"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":2,"text":"その時,とき、バビロンの王,おうの軍勢,ぐんぜいがエルサレムを攻,せめ囲,かこんでいて、預言者,よげんしゃエレミヤはユダの王,おうの宮殿,きゅうでんにある監視,かんしの庭,にわのうちに監禁,かんきんされていた。","tok":[["その"],["時","とき"],["、"],["バビロン"],["の"],["王","おう"],["の"],["軍勢","ぐんぜい"],["が"],["エルサレム"],["を"],["攻め囲んで","せめかこんで"],["いて"],["、"],["預言者","よげんしゃ"],["エレミヤ"],["は"],["ユダ"],["の"],["王","おう"],["の"],["宮殿","きゅうでん"],["に"],["ある"],["監視","かんし"],["の"],["庭","にわ"],["の"],["うち"],["に"],["監禁","かんきん"],["されて"],["いた"],["。"]]},{"verse":3,"text":"ユダの王,おうゼデキヤが彼,かれを閉,とじ込,こめたのであるが、王,おうは言,いった、「なぜあなたは預言,よげんして言,いうのか、『主,しゅはこう仰,おおせられる、見,みよ、わたしはこの町,まちをバビロンの王,おうの手,てに渡,わたし、彼,かれはこれを取,とる。","tok":[["ユダ"],["の"],["王","おう"],["ゼデキヤ"],["が"],["彼","かれ"],["を"],["閉じ込めた","とじこめた"],["ので"],["ある"],["が"],["、"],["王","おう"],["は"],["言った","いった"],["、"],["「"],["なぜ"],["あなた"],["は"],["預言","よげん"],["して"],["言う","いう"],["の"],["か"],["、"],["『"],["主","しゅ"],["は"],["こう"],["仰せられる","おおせられる"],["、"],["見よ","みよ"],["、"],["わたし"],["は"],["この"],["町","まち"],["を"],["バビロン"],["の"],["王","おう"],["の"],["手","て"],["に"],["渡","わたし"],["、"],["彼","かれ"],["は"],["これ"],["を"],["取る","とる"],["。"]]},{"verse":4,"text":"またユダの王,おうゼデキヤはカルデヤびとの手,てをのがれることなく、かならずバビロンの王,おうの手,てに渡,わたされ、顔,かおと顔,かおを合,あわせて彼,かれと語,かたり、目,めと目,めは相,あいまみえる。","tok":[["また"],["ユダ"],["の"],["王","おう"],["ゼデキヤ"],["は"],["カルデヤ"],["びと"],["の"],["手","て"],["を"],["のがれる"],["こと"],["なく"],["、"],["かならず"],["バビロン"],["の"],["王","おう"],["の"],["手","て"],["に"],["渡され","わたされ"],["、"],["顔","かお"],["と"],["顔","かお"],["を"],["合","あわせ"],["て"],["彼","かれ"],["と"],["語り","かたり"],["、"],["目","め"],["と"],["目","め"],["は"],["相","あい"],["まみえる"],["。"]]},{"verse":5,"text":"そして彼,かれはゼデキヤをバビロンに引,ひいていき、ゼデキヤは、わたしが彼,かれを顧,かえりみる時,ときまで、そこにいると主,しゅは言,いわれる。あなたがたは、カルデヤびとと戦,たたかっても勝,かつことはできない』と」。","tok":[["そして"],["彼","かれ"],["は"],["ゼデキヤ"],["を"],["バビロン"],["に"],["引いて","ひいて"],["いき"],["、"],["ゼデキヤ"],["は"],["、"],["わたし"],["が"],["彼","かれ"],["を"],["顧る","かえりみる"],["時","とき"],["まで"],["、"],["そこ"],["に"],["いる"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["。"],["あなた"],["がた"],["は"],["、"],["カルデヤ"],["びと"],["と"],["戦って","たたかって"],["も"],["勝つ","かつ"],["こと"],["は"],["できない"],["』"],["と"],["」"],["。"]]},{"verse":6,"text":"エレミヤは言,いった、「主,しゅの言葉,ことばがわたしに臨,のぞんで言,いわれる、","tok":[["エレミヤ"],["は"],["言った","いった"],["、"],["「"],["主","しゅ"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んで","のぞんで"],["言われる","いわれる"],["、"]]},{"verse":7,"text":"『見,みよ、あなたのおじシャルムの子,こハナメルがあなたの所,ところに来,きて言,いう、「アナトテにあるわたしの畑,はたけを買,かいなさい。それは、これを買,かい取,とり、あがなう権利,けんりがあなたにあるから」と』。","tok":[["『"],["見よ","みよ"],["、"],["あなた"],["の"],["おじ"],["シャルム"],["の"],["子","こ"],["ハナメル"],["が"],["あなた"],["の"],["所","ところ"],["に"],["来て","きて"],["言う","いう"],["、"],["「"],["アナトテ"],["に"],["ある"],["わたし"],["の"],["畑","はたけ"],["を"],["買","かい"],["なさい"],["。"],["それ"],["は"],["、"],["これ"],["を"],["買取","かいとり"],["、"],["あがなう"],["権利","けんり"],["が"],["あなた"],["に"],["ある"],["から"],["」"],["と"],["』"],["。"]]},{"verse":8,"text":"はたして主,しゅの言葉,ことばのように、わたしのいとこであるハナメルが監視,かんしの庭,にわのうちにいるわたしの所,ところに来,きて言,いった、『ベニヤミンの地,ちのアナトテにあるわたしの畑,はたけを買,かってください。所有,しょゆうするのも、あがなうのも、あなたの権利,けんりなのです。買,かい取,とってあなたの物,ものにしてください。これが主,しゅの言葉,ことばであるのをわたしは知,しっていました』。","tok":[["はたして"],["主","しゅ"],["の"],["言葉","ことば"],["の"],["よう"],["に"],["、"],["わたし"],["の"],["いとこ"],["で"],["ある"],["ハナメル"],["が"],["監視","かんし"],["の"],["庭","にわ"],["の"],["うち"],["に"],["いる"],["わたし"],["の"],["所","ところ"],["に"],["来て","きて"],["言った","いった"],["、"],["『"],["ベニヤミン"],["の"],["地","ち"],["の"],["アナトテ"],["に"],["ある"],["わたし"],["の"],["畑","はたけ"],["を"],["買って","かって"],["ください"],["。"],["所有","しょゆう"],["する"],["の"],["も"],["、"],["あがなう"],["の"],["も"],["、"],["あなた"],["の"],["権利","けんり"],["な"],["の"],["です"],["。"],["買取って","かいとって"],["あなた"],["の"],["物","もの"],["に"],["して"],["ください"],["。"],["これ"],["が"],["主","しゅ"],["の"],["言葉","ことば"],["で"],["ある"],["の"],["を"],["わたし"],["は"],["知って","しって"],["いました"],["』"],["。"]]},{"verse":9,"text":"そこでわたしは、いとこのハナメルからアナトテにある畑,はたけを買,かい取,とり、銀,ぎん十七シケルを量,はかって彼,かれに支払,しはらった。","tok":[["そこ"],["で"],["わたし"],["は"],["、"],["いとこ"],["の"],["ハナメル"],["から"],["アナトテ"],["に"],["ある"],["畑","はたけ"],["を"],["買取","かいとり"],["、"],["銀","ぎん"],["十七","じゅうなな"],["シケル"],["を"],["量って","はかって"],["彼","かれ"],["に"],["支払った","しはらった"],["。"]]},{"verse":10,"text":"すなわち、わたしはその証書,しょうしょをつくって、これに記名,きめいし、それを封印,ふういんし、証人,しょうにんを立,たて、はかりをもって銀,ぎんを量,はかって与,あたえた。","tok":[["すなわち"],["、"],["わたし"],["は"],["その"],["証書","しょうしょ"],["を"],["つくって"],["、"],["これ"],["に"],["記名","きめい"],["し"],["、"],["それ"],["を"],["封印","ふういん"],["し"],["、"],["証人","しょうにん"],["を"],["立て","たて"],["、"],["はかり"],["を"],["もって"],["銀","ぎん"],["を"],["量って","はかって"],["与","あたえ"],["た"],["。"]]},{"verse":11,"text":"そしてわたしはその約定,やくじょうをしるして封印,ふういんした買収,ばいしゅう証書,しょうしょと、封印,ふういんのない写,うつしとを取,とり、","tok":[["そして"],["わたし"],["は"],["その"],["約定","やくじょう"],["を"],["しるして"],["封印","ふういん"],["した"],["買収","ばいしゅう"],["証書","しょうしょ"],["と"],["、"],["封印","ふういん"],["の"],["ない"],["写","うつし"],["と"],["を"],["取","とり"],["、"]]},{"verse":12,"text":"いとこのハナメルと、買収,ばいしゅう証書,しょうしょに記名,きめいした証人,しょうにんたち、および監視,かんしの庭,にわにすわっているすべてのユダヤ人,ひとの前,まえで、その証書,しょうしょをマアセヤの子,こであるネリヤの子,こバルクに与,あたえ、","tok":[["いとこ"],["の"],["ハナメル"],["と"],["、"],["買収","ばいしゅう"],["証書","しょうしょ"],["に"],["記名","きめい"],["した"],["証人","しょうにん"],["たち"],["、"],["および"],["監視","かんし"],["の"],["庭","にわ"],["に"],["すわって"],["いる"],["すべて"],["の"],["ユダヤ人","ゆだやひと"],["の"],["前","まえ"],["で"],["、"],["その"],["証書","しょうしょ"],["を"],["マアセヤ"],["の"],["子","こ"],["で"],["ある"],["ネリヤ"],["の"],["子","こ"],["バルク"],["に"],["与","あたえ"],["、"]]},{"verse":13,"text":"彼,かれらの前,まえで、わたしはバルクに命,めいじて言,いった、","tok":[["彼","かれ"],["ら"],["の"],["前","まえ"],["で"],["、"],["わたし"],["は"],["バルク"],["に"],["命じて","めいじて"],["言った","いった"],["、"]]},{"verse":14,"text":"『万軍,ばんぐんの主,しゅ、イスラエルの神,かみはこう仰,おおせられる、これらの証書,しょうしょすなわち、この買収,ばいしゅう証書,しょうしょの封印,ふういんしたものと、封印,ふういんのない写,うつしとを取,とり、これらを土,つちの器,うつわに入,いれて、長,ながく保存,ほぞんせよ。","tok":[["『"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["、"],["イスラエル"],["の"],["神","かみ"],["は"],["こう"],["仰せられる","おおせられる"],["、"],["これ"],["ら"],["の"],["証書","しょうしょ"],["すなわち"],["、"],["この"],["買収","ばいしゅう"],["証書","しょうしょ"],["の"],["封印","ふういん"],["した"],["もの"],["と"],["、"],["封印","ふういん"],["の"],["ない"],["写","うつし"],["と"],["を"],["取","とり"],["、"],["これ"],["ら"],["を"],["土","つち"],["の"],["器","うつわ"],["に"],["入れて","いれて"],["、"],["長く","ながく"],["保存","ほぞん"],["せよ"],["。"]]},{"verse":15,"text":"万軍,ばんぐんの主,しゅ、イスラエルの神,かみがこう言,いわれるからである、「この地,ちで人々,ひとびとはまた家,いえと畑,はたけとぶどう畑,はたけを買,かうようになる」と』。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["、"],["イスラエル"],["の"],["神","かみ"],["が"],["こう"],["言われる","いわれる"],["から"],["で"],["ある"],["、"],["「"],["この"],["地","ち"],["で"],["人々","ひとびと"],["は"],["また"],["家","いえ"],["と"],["畑","はたけ"],["と"],["ぶどう"],["畑","はたけ"],["を"],["買う","かう"],["よう"],["に"],["なる"],["」"],["と"],["』"],["。"]]},{"verse":16,"text":"わたしは買収,ばいしゅう証書,しょうしょをネリヤの子,こバルクに渡,わたしたあとで主,しゅに祈,いのって言,いった、","tok":[["わたし"],["は"],["買収","ばいしゅう"],["証書","しょうしょ"],["を"],["ネリヤ"],["の"],["子","こ"],["バルク"],["に"],["渡","わたし"],["た"],["あと"],["で"],["主に","しゅに"],["祈って","いのって"],["言った","いった"],["、"]]},{"verse":17,"text":"『ああ主,しゅなる神,かみよ、あなたは大,おおいなる力,ちからと、伸,のべた腕,うでをもって天,てんと地,ちをお造,つくりになったのです。あなたのできないことは、ひとつもありません。","tok":[["『"],["ああ"],["主","しゅ"],["なる"],["神","かみ"],["よ"],["、"],["あなた"],["は"],["大いなる","おおいなる"],["力","ちから"],["と"],["、"],["伸べた","のべた"],["腕","うで"],["を"],["もって"],["天","てん"],["と"],["地","ち"],["を"],["お造","おつくり"],["に"],["なった"],["の"],["です"],["。"],["あなた"],["の"],["できない"],["こと"],["は"],["、"],["ひと"],["つ"],["も"],["ありません"],["。"]]},{"verse":18,"text":"あなたはいつくしみを千万人,にんに施,ほどこし、また父,ちちの罪,つみをそののちの子孫,しそんに報,むくいられるのです。あなたは大,おおいなる全能,ぜんのうの神,かみでいらせられ、その名,なは万軍,ばんぐんの主,しゅと申,もうされます。","tok":[["あなた"],["は"],["いつくしみ"],["を"],["千万人","にん"],["に"],["施し","ほどこし"],["、"],["また"],["父","ちち"],["の"],["罪","つみ"],["を"],["その"],["のち"],["の"],["子孫","しそん"],["に"],["報いられる","むくいられる"],["の"],["です"],["。"],["あなた"],["は"],["大いなる","おおいなる"],["全能","ぜんのう"],["の"],["神","かみ"],["で"],["いらせられ"],["、"],["その"],["名","な"],["は"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["と"],["申されます","もうされます"],["。"]]},{"verse":19,"text":"あなたの計,はかりごとは大,おおきく、また、事,ことを行,おこなうのに力,ちからがあり、あなたの目,めは人々,ひとびとの歩,あゆむすべての道,みちを見,みて、おのおのの道,みちにしたがい、その行,おこないの実,みによってこれに報,むくいられます。","tok":[["あなた"],["の"],["計り","はかり"],["ごと"],["は"],["大きく","おおきく"],["、"],["また"],["、"],["事","こと"],["を"],["行なう","おこなう"],["のに"],["力","ちから"],["が"],["あり"],["、"],["あなた"],["の"],["目","め"],["は"],["人々","ひとびと"],["の"],["歩む","あゆむ"],["すべて"],["の"],["道","みち"],["を"],["見て","みて"],["、"],["おのおの"],["の"],["道","みち"],["に"],["したがい"],["、"],["その"],["行ない","おこない"],["の"],["実","み"],["によって"],["これ"],["に"],["報いられます","むくいられます"],["。"]]},{"verse":20,"text":"あなたは、しるしと、不思議,ふしぎなわざとをエジプトの地,ちに行,おこない、また今日,こんにちに至,いたるまでイスラエルと全,ぜん人類,じんるいのうちに行,おこない、そして今日,こんにちのように名,なをあげられました。","tok":[["あなた"],["は"],["、"],["しるし"],["と"],["、"],["不思議","ふしぎ"],["な"],["わざと"],["を"],["エジプト"],["の"],["地","ち"],["に"],["行ない","おこない"],["、"],["また"],["今日","こんにち"],["に"],["至る","いたる"],["まで"],["イスラエル"],["と"],["全","ぜん"],["人類","じんるい"],["の"],["うち"],["に"],["行ない","おこない"],["、"],["そして"],["今日","こんにち"],["の"],["よう"],["に"],["名","な"],["を"],["あげられました"],["。"]]},{"verse":21,"text":"あなたは、しるしと、不思議,ふしぎなわざと、強,つよい手,てと、伸,のべた腕,うでと、大,おおいなる恐,おそるべき事,ことをもって、あなたの民,たみイスラエルをエジプトの地,ちから導,みちびき出,だし、","tok":[["あなた"],["は"],["、"],["しるし"],["と"],["、"],["不思議","ふしぎ"],["な"],["わざ"],["と"],["、"],["強い","つよい"],["手","て"],["と"],["、"],["伸べた","のべた"],["腕","うで"],["と"],["、"],["大いなる","おおいなる"],["恐るべき","おそるべき"],["事","こと"],["を"],["もって"],["、"],["あなた"],["の"],["民","たみ"],["イスラエル"],["を"],["エジプト"],["の"],["地","ち"],["から"],["導き出し","みちびきだし"],["、"]]},{"verse":22,"text":"この地,ちを彼,かれらに賜,たまわりました。これはあなたが彼,かれらの先祖,せんぞたちに与,あたえようと誓,ちかわれた乳,ちちと蜜,みつの流,ながれる地,ちです。","tok":[["この"],["地","ち"],["を"],["彼","かれ"],["ら"],["に"],["賜わりました","たまわりました"],["。"],["これ"],["は"],["あなた"],["が"],["彼","かれ"],["ら"],["の"],["先祖","せんぞ"],["たち"],["に"],["与","あたえ"],["よう"],["と"],["誓われた","ちかわれた"],["乳","ちち"],["と"],["蜜","みつ"],["の"],["流れる","ながれる"],["地","ち"],["です"],["。"]]},{"verse":23,"text":"こうして彼,かれらは、はいってこれを獲,えたのですが、あなたの声,こえに聞,きき従,したがわず、あなたの律法,りっぽうを行,おこなわず、すべてあなたがせよと命,めいじられたことをしなかったので、あなたはこの災,わざわいを彼,かれらの上,うえにお下,くだしになりました。","tok":[["こう"],["して"],["彼","かれ"],["ら"],["は"],["、"],["はい"],["って"],["これ"],["を"],["獲た","えた"],["の"],["です"],["が"],["、"],["あなた"],["の"],["声","こえ"],["に"],["聞","きき"],["従わず","したがわず"],["、"],["あなた"],["の"],["律法","りっぽう"],["を"],["行なわず","おこなわず"],["、"],["すべて"],["あなた"],["が"],["せよ"],["と"],["命じられた","めいじられた"],["こと"],["を"],["しなかった"],["ので"],["、"],["あなた"],["は"],["この"],["災","わざわい"],["を"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["お下","おくだし"],["に"],["なりました"],["。"]]},{"verse":24,"text":"見,みよ、塁,るいが築,きずきあげられたのは、この町,まちを取,とるためです。つるぎと、ききんと、疫病,えきびょうのために、町,まちはこれを攻,せめているカルデヤびとの手,てに渡,わたされます。あなたの言,いわれたようになりましたのは、ごらんのとおりであります。","tok":[["見よ","みよ"],["、"],["塁","るい"],["が"],["築きあげられた","きずきあげられた"],["の"],["は"],["、"],["この"],["町","まち"],["を"],["取る","とる"],["ため"],["です"],["。"],["つるぎ"],["と"],["、"],["ききん"],["と"],["、"],["疫病","えきびょう"],["の"],["ため"],["に"],["、"],["町","まち"],["は"],["これ"],["を"],["攻めて","せめて"],["いる"],["カルデヤ"],["びと"],["の"],["手","て"],["に"],["渡されます","わたされます"],["。"],["あなた"],["の"],["言われた","いわれた"],["よう"],["に"],["なりました"],["の"],["は"],["、"],["ごらん"],["の"],["とおり"],["で"],["あります"],["。"]]},{"verse":25,"text":"主,しゅなる神,かみよ、あなたはわたしに言,いわれました、「銀,ぎんをもって畑,はたけを買,かい、証人,しょうにんを立,たてよ」と。そうであるのに、町,まちはカルデヤびとの手,てに渡,わたされています』」。","tok":[["主","しゅ"],["なる"],["神","かみ"],["よ"],["、"],["あなた"],["は"],["わたし"],["に"],["言われました","いわれました"],["、"],["「"],["銀","ぎん"],["を"],["もって"],["畑","はたけ"],["を"],["買","かい"],["、"],["証人","しょうにん"],["を"],["立よ","たてよ"],["」"],["と"],["。"],["そう"],["で"],["ある"],["のに"],["、"],["町","まち"],["は"],["カルデヤ"],["びと"],["の"],["手","て"],["に"],["渡されて","わたされて"],["います"],["』"],["」"],["。"]]},{"verse":26,"text":"主,しゅの言葉,ことばがエレミヤに臨,のぞんだ、","tok":[["主","しゅ"],["の"],["言葉","ことば"],["が"],["エレミヤ"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":27,"text":"「見,みよ、わたしは主,しゅである、すべて命,いのちある者,ものの神,かみである。わたしにできない事,ことがあろうか。","tok":[["「"],["見よ","みよ"],["、"],["わたし"],["は"],["主","しゅ"],["で"],["ある"],["、"],["すべて"],["命","いのち"],["ある"],["者","もの"],["の"],["神","かみ"],["で"],["ある"],["。"],["わたし"],["に"],["できない"],["事","こと"],["が"],["あろう"],["か"],["。"]]},{"verse":28,"text":"それゆえ、主,しゅはこう言,いわれる、見,みよ、わたしはこの町,まちをカルデヤびとと、バビロンの王,おうネブカデレザルの手,てに渡,わたす。彼,かれはこれを取,とる。","tok":[["それ"],["ゆえ"],["、"],["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["見よ","みよ"],["、"],["わたし"],["は"],["この"],["町","まち"],["を"],["カルデヤ"],["びと"],["と"],["、"],["バビロン"],["の"],["王","おう"],["ネブカデレザル"],["の"],["手","て"],["に"],["渡す","わたす"],["。"],["彼","かれ"],["は"],["これ"],["を"],["取る","とる"],["。"]]},{"verse":29,"text":"この町,まちを攻,せめているカルデヤびとがきて、この町,まちに火,ひをつけて焼,やき払,はらう。屋根,やねの上,うえで人々,ひとびとが、バアルに香,こうをたき、ほかの神々,かみがみに酒,さけをそそいで、わたしを怒,いからせたその家,いえをも彼,かれらは焼,やく。","tok":[["この"],["町","まち"],["を"],["攻めて","せめて"],["いる"],["カルデヤ"],["びと"],["が"],["きて"],["、"],["この"],["町","まち"],["に"],["火","ひ"],["を"],["つけて"],["焼き払う","やきはらう"],["。"],["屋根","やね"],["の"],["上","うえ"],["で"],["人々","ひとびと"],["が"],["、"],["バアル"],["に"],["香","こう"],["を"],["たき"],["、"],["ほか"],["の"],["神々","かみがみ"],["に"],["酒","さけ"],["を"],["そそいで"],["、"],["わたし"],["を"],["怒らせた","いからせた"],["その"],["家","いえ"],["を"],["も"],["彼","かれ"],["ら"],["は"],["焼く","やく"],["。"]]},{"verse":30,"text":"それは、イスラエルの人々,ひとびととユダの人々,ひとびととは、その若,わかい時,ときから、わたしの前,まえに悪,わるいことのみを行,おこない、またイスラエルの民,たみはその手,てのわざをもって、わたしを怒,いからせることばかりをしたからであると主,しゅは言,いわれる。","tok":[["それ"],["は"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["と"],["ユダ"],["の"],["人々","ひとびと"],["と"],["は"],["、"],["その"],["若い","わかい"],["時","とき"],["から"],["、"],["わたし"],["の"],["前","まえ"],["に"],["悪い","わるい"],["こと"],["のみ"],["を"],["行ない","おこない"],["、"],["また"],["イスラエル"],["の"],["民","たみ"],["は"],["その"],["手","て"],["の"],["わざ"],["を"],["もって"],["、"],["わたし"],["を"],["怒らせる","いからせる"],["こと"],["ばかり"],["を"],["した"],["から"],["で"],["ある"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":31,"text":"この町,まちはそれが建,たった日,ひからきょうまで、わたしの怒,いかりと憤,いきどおりとをひき起,おこしてきたので、わたしの前,まえからこれを除,のぞき去,さるのである。","tok":[["この"],["町","まち"],["は"],["それ"],["が"],["建った","たった"],["日","ひ"],["から"],["きょう"],["まで"],["、"],["わたし"],["の"],["怒り","いかり"],["と"],["憤り","いきどおり"],["と"],["を"],["ひき起こして","ひきおこして"],["きた"],["ので"],["、"],["わたし"],["の"],["前","まえ"],["から"],["これ"],["を"],["除き去る","のぞきさる"],["ので"],["ある"],["。"]]},{"verse":32,"text":"それは、イスラエルの民,たみとユダの民,たみとが、もろもろの悪,あくを行,いって、わたしを怒,いからせたことによるのである。――彼,かれらの王,おうたちと、そのつかさたち、祭司,さいしたち、預言者,よげんしゃたち、またユダの人々,ひとびととエルサレムの住民,じゅうみんたちが皆,みなそうである。","tok":[["それ"],["は"],["、"],["イスラエル"],["の"],["民","たみ"],["と"],["ユダ"],["の"],["民","たみ"],["と"],["が"],["、"],["もろもろ"],["の"],["悪","あく"],["を"],["行って","いって"],["、"],["わたし"],["を"],["怒らせた","いからせた"],["こと"],["に"],["よる"],["ので"],["ある"],["。"],["―"],["―"],["彼","かれ"],["ら"],["の"],["王","おう"],["たち"],["と"],["、"],["その"],["つかさ"],["たち"],["、"],["祭司","さいし"],["たち"],["、"],["預言者","よげんしゃ"],["たち"],["、"],["また"],["ユダ"],["の"],["人々","ひとびと"],["と"],["エルサレム"],["の"],["住民","じゅうみん"],["たち"],["が"],["皆","みな"],["そう"],["で"],["ある"],["。"]]},{"verse":33,"text":"彼,かれらはその背中,せなかをわたしに向,むけて顔,かおをわたしに向,むけず、わたしがたゆまず教,おしえたにもかかわらず、彼,かれらは教,おしえを聞,きかず、またうけないのである。","tok":[["彼","かれ"],["ら"],["は"],["その"],["背中","せなか"],["を"],["わたし"],["に"],["向けて","むけて"],["顔","かお"],["を"],["わたし"],["に"],["向けず","むけず"],["、"],["わたし"],["が"],["たゆまず"],["教えた","おしえた"],["に"],["も"],["かかわらず"],["、"],["彼","かれ"],["ら"],["は"],["教え","おしえ"],["を"],["聞かず","きかず"],["、"],["また"],["うけない"],["ので"],["ある"],["。"]]},{"verse":34,"text":"彼,かれらは憎,にくむべき物,ものを、わが名,なをもって呼,よばれている家,いえにすえつけて、そこを汚,けがし、","tok":[["彼","かれ"],["ら"],["は"],["憎むべき","にくむべき"],["物","もの"],["を"],["、"],["わが"],["名","な"],["を"],["もって"],["呼ばれて","よばれて"],["いる"],["家","いえ"],["に"],["すえつけて"],["、"],["そこ"],["を"],["汚","け"],["がし"],["、"]]},{"verse":35,"text":"またベンヒンノムの谷,たににバアルの高,たかき所,ところを築,きずいて、むすこ娘,むすめをモレクにささげた。わたしは彼,かれらにこのようなことを命,めいじたことはなく、また彼,かれらがこの憎,にくむべきことを行,いって、ユダに罪,つみを犯,おかさせようとは考,かんがえもしなかった。","tok":[["また"],["ベンヒンノム"],["の"],["谷","たに"],["に"],["バアル"],["の"],["高き","たかき"],["所","ところ"],["を"],["築いて","きずいて"],["、"],["むすこ"],["娘","むすめ"],["を"],["モレク"],["に"],["ささげた"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["に"],["この"],["よう"],["な"],["こと"],["を"],["命じた","めいじた"],["こと"],["は"],["なく"],["、"],["また"],["彼","かれ"],["ら"],["が"],["この"],["憎むべき","にくむべき"],["こと"],["を"],["行って","いって"],["、"],["ユダ"],["に"],["罪","つみ"],["を"],["犯させよう","おかさせよう"],["と"],["は"],["考","かんがえ"],["も"],["しなかった"],["。"]]},{"verse":36,"text":"それゆえ今,いまイスラエルの神,かみ、主,しゅは、この町,まち、すなわちあなたがたが、『つるぎと、ききんと、疫病,えきびょうのためにバビロンの王,おうの手,てに渡,わたされる』といっている町,まちについてこう仰,おおせられる、","tok":[["それ"],["ゆえ"],["今","いま"],["イスラエル"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["、"],["この"],["町","まち"],["、"],["すなわち"],["あなた"],["が"],["た"],["が"],["、"],["『"],["つるぎ"],["と"],["、"],["ききん"],["と"],["、"],["疫病","えきびょう"],["の"],["ため"],["に"],["バビロン"],["の"],["王","おう"],["の"],["手","て"],["に"],["渡される","わたされる"],["』"],["と"],["いって"],["いる"],["町","まち"],["について"],["こう"],["仰せられる","おおせられる"],["、"]]},{"verse":37,"text":"見,みよ、わたしは、わたしの怒,いかりと憤,いきどおりと大,おおいなる怒,いかりをもって、彼,かれらを追,おいやったもろもろの国,くにから彼,かれらを集,あつめ、この所,ところへ導,みちびきかえって、安,やすらかに住,すまわせる。","tok":[["見よ","みよ"],["、"],["わたし"],["は"],["、"],["わたし"],["の"],["怒り","いかり"],["と"],["憤り","いきどおり"],["と"],["大いなる","おおいなる"],["怒り","いかり"],["を"],["もって"],["、"],["彼","かれ"],["ら"],["を"],["追いやった","おいやった"],["もろもろ"],["の"],["国","くに"],["から"],["彼","かれ"],["ら"],["を"],["集め","あつめ"],["、"],["この"],["所","ところ"],["へ"],["導き","みちびき"],["かえって"],["、"],["安らか","やすらか"],["に"],["住まわせる","すまわせる"],["。"]]},{"verse":38,"text":"そして彼,かれらはわたしの民,たみとなり、わたしは彼,かれらの神,かみとなる。","tok":[["そして"],["彼","かれ"],["ら"],["は"],["わたし"],["の"],["民","たみ"],["と"],["なり"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["神","かみ"],["と"],["なる"],["。"]]},{"verse":39,"text":"わたしは彼,かれらに一つの心,こころと一つの道,みちを与,あたえて常,つねにわたしを恐,おそれさせる。これは彼,かれらが彼,かれら自身,じしんとその後,のちの子孫,しそんの幸,さいわいを得,えるためである。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["に"],["一","ひと"],["つ"],["の"],["心","こころ"],["と"],["一","ひと"],["つ"],["の"],["道","みち"],["を"],["与","あたえ"],["て"],["常","つね"],["に"],["わたし"],["を"],["恐れさせる","おそれさせる"],["。"],["これ"],["は"],["彼","かれ"],["ら"],["が"],["彼","かれ"],["ら"],["自身","じしん"],["と"],["その後","そののち"],["の"],["子孫","しそん"],["の"],["幸い","さいわい"],["を"],["得る","える"],["ため"],["で"],["ある"],["。"]]},{"verse":40,"text":"わたしは彼,かれらと永遠,えいえんの契約,けいやくを立,たてて、彼,かれらを見捨,みすてずに恵,めぐみを施,ほどこすことを誓,ちかい、またわたしを恐,おそれる恐,おそれを彼,かれらの心,こころに置,おいて、わたしを離,はなれることのないようにしよう。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["と"],["永遠","えいえん"],["の"],["契約","けいやく"],["を"],["立てて","たてて"],["、"],["彼","かれ"],["ら"],["を"],["見捨てず","みすてず"],["に"],["恵","めぐみ"],["を"],["施す","ほどこす"],["こと"],["を"],["誓い","ちかい"],["、"],["また"],["わたし"],["を"],["恐れる","おそれる"],["恐","おそれ"],["を"],["彼","かれ"],["ら"],["の"],["心","こころ"],["に"],["置いて","おいて"],["、"],["わたし"],["を"],["離れる","はなれる"],["こと"],["の"],["ない"],["よう"],["に"],["しよう"],["。"]]},{"verse":41,"text":"わたしは彼,かれらに恵,めぐみを施,ほどこすことを喜,よろこびとし、心,こころをつくし、精神,せいしんをつくし、真実,しんじつをもって彼,かれらをこの地,ちに植,うえる。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["に"],["恵","めぐみ"],["を"],["施す","ほどこす"],["こと"],["を"],["喜こび","よろこび"],["と"],["し"],["、"],["心","こころ"],["を"],["つくし"],["、"],["精神","せいしん"],["を"],["つくし"],["、"],["真実","しんじつ"],["を"],["もって"],["彼","かれ"],["ら"],["を"],["この"],["地","ち"],["に"],["植える","うえる"],["。"]]},{"verse":42,"text":"主,しゅはこう仰,おおせられる、わたしがこのもろもろの大,おおきな災,わざわいをこの民,たみに下,くだしたように、わたしが彼,かれらに約束,やくそくするもろもろの幸,さいわいを彼,かれらの上,うえに下,くだす。","tok":[["主","しゅ"],["は"],["こう"],["仰せられる","おおせられる"],["、"],["わたし"],["が"],["この"],["もろもろ"],["の"],["大きな","おおきな"],["災","わざわい"],["を"],["この"],["民","たみ"],["に"],["下した","くだした"],["よう"],["に"],["、"],["わたし"],["が"],["彼","かれ"],["ら"],["に"],["約束","やくそく"],["する"],["もろもろ"],["の"],["幸い","さいわい"],["を"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["下す","くだす"],["。"]]},{"verse":43,"text":"人々,ひとびとはこの地,ちに畑,はたけを買,かうようになる。あなたがたが、『それは荒,あれて人,ひとも獣,けものもいなくなり、カルデヤびとの手,てに渡,わたされてしまう』といっている地,ちである。","tok":[["人々","ひとびと"],["は"],["この"],["地","ち"],["に"],["畑","はたけ"],["を"],["買う","かう"],["よう"],["に"],["なる"],["。"],["あなた"],["が"],["た"],["が"],["、"],["『"],["それ"],["は"],["荒て","あれて"],["人","ひと"],["も"],["獣","けもの"],["も"],["いなく"],["なり"],["、"],["カルデヤ"],["びと"],["の"],["手","て"],["に"],["渡されて","わたされて"],["しまう"],["』"],["と"],["いって"],["いる"],["地","ち"],["で"],["ある"],["。"]]},{"verse":44,"text":"人々,ひとびとはベニヤミンの地,ちと、エルサレムの周囲,しゅういと、ユダの町々,まちまちと、山地,さんちの町々,まちまちと、平地,へいちの町々,まちまちと、ネゲブの町々,まちまちで、銀,ぎんをもって畑,はたけを買,かい、証書,しょうしょをつくって、これに記名,きめいし封印,ふういんし、また証人,しょうにんを立,たてる。それは、わたしが彼,かれらを再,ふたたび栄,さかえさせるからであると主,しゅは言,いわれる」。","tok":[["人々","ひとびと"],["は"],["ベニヤミン"],["の"],["地","ち"],["と"],["、"],["エルサレム"],["の"],["周囲","しゅうい"],["と"],["、"],["ユダ"],["の"],["町々","まちまち"],["と"],["、"],["山地","さんち"],["の"],["町々","まちまち"],["と"],["、"],["平地","へいち"],["の"],["町々","まちまち"],["と"],["、"],["ネゲブ"],["の"],["町々","まちまち"],["で"],["、"],["銀","ぎん"],["を"],["もって"],["畑","はたけ"],["を"],["買","かい"],["、"],["証書","しょうしょ"],["を"],["つくって"],["、"],["これ"],["に"],["記名","きめい"],["し"],["封印","ふういん"],["し"],["、"],["また"],["証人","しょうにん"],["を"],["立る","たてる"],["。"],["それ"],["は"],["、"],["わたし"],["が"],["彼","かれ"],["ら"],["を"],["再び","ふたたび"],["栄","さかえ"],["させる"],["から"],["で"],["ある"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["」"],["。"]]}]
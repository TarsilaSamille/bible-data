[{"verse":1,"text":"主,しゅは言,いわれる、「わが牧場,まきばの羊,ひつじを滅,ほろぼし散,ちらす牧者,ぼくしゃはわざわいである」。","tok":[["主","しゅ"],["は"],["言われる","いわれる"],["、"],["「"],["わが"],["牧場","まきば"],["の"],["羊","ひつじ"],["を"],["滅ぼし","ほろぼし"],["散らす","ちらす"],["牧者","ぼくしゃ"],["は"],["わざわい"],["で"],["ある"],["」"],["。"]]},{"verse":2,"text":"それゆえイスラエルの神,かみ、主,しゅはわが民,たみを養,やしなう牧者,ぼくしゃについてこう言,いわれる、「あなたがたはわたしの群,むれを散,ちらし、これを追,おいやって顧,かえりみなかった。見,みよ、わたしはあなたがたの悪,あしき行,おこないによってあなたがたに報,むくいると、主,しゅは言,いわれる。","tok":[["それ"],["ゆえ"],["イスラエル"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["わが"],["民","たみ"],["を"],["養う","やしなう"],["牧者","ぼくしゃ"],["について"],["こう"],["言われる","いわれる"],["、"],["「"],["あなた"],["がた"],["は"],["わたし"],["の"],["群れ","むれ"],["を"],["散らし","ちらし"],["、"],["これ"],["を"],["追いやって","おいやって"],["顧なかった","かえりみなかった"],["。"],["見よ","みよ"],["、"],["わたし"],["は"],["あなた"],["がた"],["の"],["悪しき","あしき"],["行ない","おこない"],["によって"],["あなた"],["がた"],["に"],["報いる","むくいる"],["と"],["、"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":3,"text":"わたしの群,むれの残,のこった者,ものを、追,おいやったすべての地,ちから集,あつめ、再,ふたたびこれをそのおりに帰,かえらせよう。彼,かれらは子,こを産,うんでその数,かずが多,おおくなる。","tok":[["わたし"],["の"],["群れ","むれ"],["の"],["残った","のこった"],["者","もの"],["を"],["、"],["追いやった","おいやった"],["すべて"],["の"],["地","ち"],["から"],["集め","あつめ"],["、"],["再び","ふたたび"],["これ"],["を"],["その"],["おり"],["に"],["帰えらせよう","かえらせよう"],["。"],["彼","かれ"],["ら"],["は"],["子","こ"],["を"],["産","うんでそ"],["の"],["数","かず"],["が"],["多く","おおく"],["なる"],["。"]]},{"verse":4,"text":"わたしはこれを養,やしなう牧者,ぼくしゃをその上,うえに立,たてる、彼,かれらは再,ふたたび恐,おそれることなく、またおののくことなく、いなくなることもないと、主,しゅは言,いわれる。","tok":[["わたし"],["は"],["これ"],["を"],["養う","やしなう"],["牧者","ぼくしゃ"],["を"],["その"],["上","うえ"],["に"],["立る","たてる"],["、"],["彼","かれ"],["ら"],["は"],["再び","ふたたび"],["恐れる","おそれる"],["こと"],["なく"],["、"],["また"],["おののく"],["こと"],["なく"],["、"],["いなく"],["なる"],["こと"],["も"],["ない"],["と"],["、"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":5,"text":"主,しゅは仰,おおせられる、見,みよ、わたしがダビデのために一つの正,ただしい枝,えだを起,おこす日,ひがくる。彼,かれは王,おうとなって世,よを治,おさめ、栄,さかえて、公平,こうへいと正義,せいぎを世,よに行,おこなう。","tok":[["主","しゅ"],["は"],["仰せられる","おおせられる"],["、"],["見よ","みよ"],["、"],["わたし"],["が"],["ダビデ"],["の"],["ため"],["に"],["一","ひと"],["つ"],["の"],["正い","ただしい"],["枝","えだ"],["を"],["起こす","おこす"],["日","ひ"],["が"],["くる"],["。"],["彼","かれ"],["は"],["王","おう"],["と"],["なって"],["世","よ"],["を"],["治め","おさめ"],["、"],["栄","さかえ"],["て"],["、"],["公平","こうへい"],["と"],["正義","せいぎ"],["を"],["世","よ"],["に"],["行なう","おこなう"],["。"]]},{"verse":6,"text":"その日,ひユダは救,すくいを得,え、イスラエルは安,やすらかにおる。その名,なは『主,しゅはわれわれの正義,せいぎ』ととなえられる。","tok":[["その"],["日","ひ"],["ユダ"],["は"],["救い","すくい"],["を"],["得","え"],["、"],["イスラエル"],["は"],["安らか","やすらか"],["に"],["おる"],["。"],["その"],["名","な"],["は"],["『"],["主","しゅ"],["は"],["われわれ"],["の"],["正義","せいぎ"],["』"],["と"],["となえられる"],["。"]]},{"verse":7,"text":"主,しゅは言,いわれる、それゆえ見,みよ、人々,ひとびとは『イスラエルの民,たみをエジプトの地,ちから導,みちびき出,だされた主,しゅは生,いきておられる』とまた言,いわないで、","tok":[["主","しゅ"],["は"],["言われる","いわれる"],["、"],["それ"],["ゆえ"],["見よ","みよ"],["、"],["人々","ひとびと"],["は"],["『"],["イスラエル"],["の"],["民","たみ"],["を"],["エジプト"],["の"],["地","ち"],["から"],["導き出された","みちびきだされた"],["主","しゅ"],["は"],["生きて","いきて"],["おられる"],["』"],["と"],["また"],["言わないで","いわないで"],["、"]]},{"verse":8,"text":"『イスラエルの家,いえの子孫,しそんを北,きたの地,ちと、そのすべて追,おいやられた地,ちから導,みちびき出,だされた神,かみは生,いきておられる』という日,ひがくる。その時,とき、彼,かれらは自分,じぶんの地,ちに住,すんでいる」。","tok":[["『"],["イスラエル"],["の"],["家","いえ"],["の"],["子孫","しそん"],["を"],["北","きた"],["の"],["地","ち"],["と"],["、"],["その"],["すべて"],["追いやられた","おいやられた"],["地","ち"],["から"],["導き出された","みちびきだされた"],["神","かみ"],["は"],["生きて","いきて"],["おられる"],["』"],["と"],["いう"],["日","ひ"],["が"],["くる"],["。"],["その"],["時","とき"],["、"],["彼","かれ"],["ら"],["は"],["自分","じぶん"],["の"],["地","ち"],["に"],["住んで","すんで"],["いる"],["」"],["。"]]},{"verse":9,"text":"預言者,よげんしゃたちについて。わが心,こころはわたしのうちに破,やぶれ、わが骨,ほねはみな震,ふるう。主,しゅとその聖,せいなる言葉,ことばのために、わたしは酔,よっている人,ひとのよう、酒,さけに打,うち負,まかされた人,ひとのようである。","tok":[["預言者","よげんしゃ"],["たち"],["について"],["。"],["わが"],["心","こころ"],["は"],["わたし"],["の"],["うち"],["に"],["破れ","やぶれ"],["、"],["わが"],["骨","ほね"],["は"],["みな"],["震う","ふるう"],["。"],["主","しゅとそ"],["の"],["聖","せい"],["なる"],["言葉","ことば"],["の"],["ため"],["に"],["、"],["わたし"],["は"],["酔って","よって"],["いる"],["人","ひと"],["の"],["よう"],["、"],["酒","さけ"],["に"],["打ち負かされた","うちまかされた"],["人","ひと"],["の"],["よう"],["で"],["ある"],["。"]]},{"verse":10,"text":"この地,ちに姦淫,かんいんを行,おこなうものが満,みちているからだ。のろいによって地,ちは嘆,なげき、荒野,あらのの牧場,まきばはかわく。彼,かれらの道,みちは悪,わるく、その力,ちからは正,ただしくない。","tok":[["この"],["地","ち"],["に"],["姦淫","かんいん"],["を"],["行なう","おこなう"],["もの"],["が"],["満ちて","みちて"],["いる"],["から"],["だ"],["。"],["のろい"],["によって"],["地","ち"],["は"],["嘆き","なげき"],["、"],["荒野","あら"],["の"],["の"],["牧場","まきば"],["は"],["かわく"],["。"],["彼","かれ"],["ら"],["の"],["道","みち"],["は"],["悪く","わるく"],["、"],["その"],["力","ちから"],["は"],["正く","ただしく"],["ない"],["。"]]},{"verse":11,"text":"「預言者,よげんしゃと祭司,さいしとは共,ともに神,かみを汚,けがす者,ものである。わたしの家,いえにおいてすら彼,かれらの悪,あくを見,みたと、主,しゅは言,いわれる。","tok":[["「"],["預言者","よげんしゃ"],["と"],["祭司","さいし"],["と"],["は"],["共","とも"],["に"],["神","かみ"],["を"],["汚","け"],["がす"],["者","もの"],["で"],["ある"],["。"],["わたし"],["の"],["家","いえ"],["に"],["おいて"],["すら"],["彼","かれ"],["ら"],["の"],["悪","あく"],["を"],["見た","みた"],["と"],["、"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":12,"text":"それゆえ、彼,かれらの道,みちは、おのずから暗黒,あんこくの中,なかにあるなめらかな道,みちのようになり、彼,かれらは押,おされてその道,みちに倒,たおれる。わたしが彼,かれらの罰,ばっせられる年,ねんに、災,わざわいをその上,うえに臨,のぞませるからであると、主,しゅは言,いわれる。","tok":[["それ"],["ゆえ"],["、"],["彼","かれ"],["ら"],["の"],["道","みち"],["は"],["、"],["おのずから"],["暗黒","あんこく"],["の"],["中","なか"],["に"],["ある"],["なめらか"],["な"],["道","みち"],["の"],["よう"],["に"],["なり"],["、"],["彼","かれ"],["ら"],["は"],["押されて","おされて"],["その"],["道","みち"],["に"],["倒れる","たおれる"],["。"],["わたし"],["が"],["彼","かれ"],["ら"],["の"],["罰せられる","ばっせられる"],["年","ねん"],["に"],["、"],["災","わざわい"],["を"],["その"],["上","うえ"],["に"],["臨ませる","のぞませる"],["から"],["で"],["ある"],["と"],["、"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":13,"text":"わたしはサマリヤの預言者,よげんしゃのうちに不快,ふかいな事,ことのあるのを見,みた。彼,かれらはバアルによって預言,よげんし、わが民,たみイスラエルを惑,まどわした。","tok":[["わたし"],["は"],["サマリヤ"],["の"],["預言者","よげんしゃ"],["の"],["うち"],["に"],["不快","ふかい"],["な"],["事","こと"],["の"],["ある"],["の"],["を"],["見た","みた"],["。"],["彼","かれ"],["ら"],["は"],["バアル"],["によって"],["預言","よげん"],["し"],["、"],["わが"],["民","た"],["みイスラエル"],["を"],["惑わした","まどわした"],["。"]]},{"verse":14,"text":"しかしエルサレムの預言者,よげんしゃのうちには、恐,おそろしい事,ことのあるのを見,みた。彼,かれらは姦淫,かんいんを行,おこない、偽,いつわりに歩,あゆみ、悪人,あくにんの手,てを強,つよくし、人,ひとをその悪,あくから離,はなれさせない。彼,かれらはみなわたしにはソドムのようであり、その民,たみはゴモラのようである」。","tok":[["しかし"],["エルサレム"],["の"],["預言者","よげんしゃ"],["の"],["うち"],["に"],["は"],["、"],["恐ろしい","おそろしい"],["事","こと"],["の"],["ある"],["の"],["を"],["見た","みた"],["。"],["彼","かれ"],["ら"],["は"],["姦淫","かんいん"],["を"],["行ない","おこない"],["、"],["偽わり","いつわり"],["に"],["歩み","あゆみ"],["、"],["悪人","あくにん"],["の"],["手","て"],["を"],["強く","つよく"],["し"],["、"],["人","ひと"],["を"],["その"],["悪","あく"],["から"],["離れさせない","はなれさせない"],["。"],["彼","かれ"],["ら"],["は"],["みな"],["わたし"],["に"],["は"],["ソドム"],["の"],["よう"],["で"],["あり"],["、"],["その"],["民","たみ"],["は"],["ゴモラ"],["の"],["よう"],["で"],["ある"],["」"],["。"]]},{"verse":15,"text":"それゆえ万軍,ばんぐんの主,しゅは預言者,よげんしゃについてこう言,いわれる、「見,みよ、わたしは彼,かれらに、にがよもぎを食,たべさせ、毒,どくの水,みずを飲,のませる。神,かみを汚,けがすことがエルサレムの預言者,よげんしゃから出,でて、全,ぜん地,ちに及,およんでいるからである」。","tok":[["それ"],["ゆえ"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["預言者","よげんしゃ"],["について"],["こう"],["言われる","いわれる"],["、"],["「"],["見よ","みよ"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["に"],["、"],["にがよもぎ"],["を"],["食べさせ","たべさせ"],["、"],["毒","どく"],["の"],["水","みず"],["を"],["飲ませる","のませる"],["。"],["神","かみ"],["を"],["汚す","けがす"],["こと"],["が"],["エルサレム"],["の"],["預言者","よげんしゃ"],["から"],["出て","でて"],["、"],["全地","ぜんち"],["に"],["及んで","およんで"],["いる"],["から"],["で"],["ある"],["」"],["。"]]},{"verse":16,"text":"万軍,ばんぐんの主,しゅはこう言,いわれる、「あなたがたに預言,よげんする預言者,よげんしゃの言葉,ことばを聞,きいてはならない。彼,かれらはあなたがたに、むなしい望,のぞみをいだかせ、主,しゅの口,くちから出,でたのでない、自分,じぶんの心,こころの黙示,もくしを語,かたるのである。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["「"],["あなた"],["がた"],["に"],["預言","よげん"],["する"],["預言者","よげんしゃ"],["の"],["言葉","ことば"],["を"],["聞いて","きいて"],["は"],["ならない"],["。"],["彼","かれ"],["ら"],["は"],["あなた"],["がた"],["に"],["、"],["むなしい"],["望み","のぞみ"],["を"],["いだかせ"],["、"],["主","しゅ"],["の"],["口","くち"],["から"],["出た","でた"],["ので"],["ない"],["、"],["自分","じぶん"],["の"],["心","こころ"],["の"],["黙示","もくし"],["を"],["語る","かたる"],["ので"],["ある"],["。"]]},{"verse":17,"text":"彼,かれらは主,しゅの言葉,ことばを軽,かるんじる者,ものに向,むかって絶,たえず、『あなたがたは平安,へいあんを得,える』と言,いい、また自分,じぶんの強情,ごうじょうな心,こころにしたがって歩,あゆむすべての人,ひとに向,むかって、『あなたがたに災,わざわいはこない』と言,いう」。","tok":[["彼","かれ"],["ら"],["は"],["主","しゅ"],["の"],["言葉","ことば"],["を"],["軽","か"],["るん"],["じる者","じるもの"],["に"],["向かって","むかって"],["絶えず","たえず"],["、"],["『"],["あなた"],["がた"],["は"],["平安","へいあん"],["を"],["得る","える"],["』"],["と"],["言い","いい"],["、"],["また"],["自分","じぶん"],["の"],["強情","ごうじょう"],["な"],["心","こころ"],["に"],["したがって"],["歩む","あゆむ"],["すべて"],["の"],["人","ひと"],["に"],["向かって","むかって"],["、"],["『"],["あなた"],["がた"],["に"],["災","わざわい"],["は"],["こない"],["』"],["と"],["言う","いう"],["」"],["。"]]},{"verse":18,"text":"彼,かれらのうちだれか主,しゅの議会,ぎかいに立,たって、その言葉,ことばを見聞,みききした者,ものがあろうか。だれか耳,みみを傾,かたむけてその言葉,ことばを聞,きいた者,ものがあろうか。","tok":[["彼","かれ"],["ら"],["の"],["うち"],["だれ"],["か"],["主","しゅ"],["の"],["議会","ぎかい"],["に"],["立って","たって"],["、"],["その"],["言葉","ことば"],["を"],["見聞き","みきき"],["した"],["者","もの"],["が"],["あろう"],["か"],["。"],["だれ"],["か"],["耳","みみ"],["を"],["傾むけて","かたむけて"],["その"],["言葉","ことば"],["を"],["聞いた","きいた"],["者","もの"],["が"],["あろう"],["か"],["。"]]},{"verse":19,"text":"見,みよ、主,しゅの暴風,ぼうふうがくる。憤,いきどおりと、つむじ風,かぜが出,でて、悪人,あくにんのこうべをうつ。","tok":[["見よ","みよ"],["、"],["主","しゅ"],["の"],["暴風","ぼうふう"],["が"],["くる"],["。"],["憤り","いきどおり"],["と"],["、"],["つむじ風","つむじかぜ"],["が"],["出て","でて"],["、"],["悪人","あくにん"],["の"],["こうべ"],["を"],["うつ"],["。"]]},{"verse":20,"text":"主,しゅの怒,いかりは、み心,こころに思,おもい定,さだめられたことをなし遂,とげられるまで退,しりぞくことはない。末,すえの日,ひにあなたがたはそれを明,あきらかに悟,さとる。","tok":[["主","しゅ"],["の"],["怒り","いかり"],["は"],["、"],["み心","みこころ"],["に"],["思い定められた","おもいさだめられた"],["こと"],["を"],["なし遂げられる","なしとげられる"],["まで"],["退ぞく","しりぞく"],["こと"],["は"],["ない"],["。"],["末","すえ"],["の"],["日","ひ"],["に"],["あなた"],["がた"],["は"],["それ"],["を"],["明か","あきらか"],["に"],["悟","さとる"],["。"]]},{"verse":21,"text":"預言者,よげんしゃたちはわたしがつかわさなかったのに、彼,かれらは走,はしった。わたしが、彼,かれらに告,つげなかったのに、彼,かれらは預言,よげんした。","tok":[["預言者","よげんしゃ"],["たち"],["は"],["わたし"],["が"],["つかわさなかった"],["のに"],["、"],["彼","かれ"],["ら"],["は"],["走った","はしった"],["。"],["わたし"],["が"],["、"],["彼","かれ"],["ら"],["に"],["告","つげ"],["なかった"],["のに"],["、"],["彼","かれ"],["ら"],["は"],["預言","よげん"],["した"],["。"]]},{"verse":22,"text":"もし彼,かれらがわたしの議会,ぎかいに立,たったのであれば、わたしの民,たみにわが言葉,ことばを告,つげ示,しめして、その悪,わるい道,みちと悪,わるい行,おこないから、離,はなれさせたであろうに。","tok":[["もし"],["彼","かれ"],["ら"],["が"],["わたし"],["の"],["議会","ぎかい"],["に"],["立った","たった"],["ので"],["あれば"],["、"],["わたし"],["の"],["民","たみ"],["に"],["わが"],["言葉","ことば"],["を"],["告示","つげし"],["めして"],["、"],["その"],["悪い","わるい"],["道","みち"],["と"],["悪い","わるい"],["行ない","おこない"],["から"],["、"],["離れさせたで","はなれさせたで"],["あろう"],["に"],["。"]]},{"verse":23,"text":"「主,しゅは言,いわれる、わたしはただ近,ちかくの神,かみであって、遠,とおくの神,かみではないのであるか。","tok":[["「"],["主","しゅ"],["は"],["言われる","いわれる"],["、"],["わたし"],["は"],["ただ"],["近く","ちかく"],["の"],["神","かみ"],["で"],["あって"],["、"],["遠く","とおく"],["の"],["神","かみ"],["で"],["は"],["ない"],["ので"],["ある"],["か"],["。"]]},{"verse":24,"text":"主,しゅは言,いわれる、人,ひとは、ひそかな所,ところに身,みを隠,かくして、わたしに見,みられないようにすることができようか。主,しゅは言,いわれる、わたしは天,てんと地,ちとに満,みちているではないか。","tok":[["主","しゅ"],["は"],["言われる","いわれる"],["、"],["人","ひと"],["は"],["、"],["ひそか"],["な"],["所","ところ"],["に"],["身","み"],["を"],["隠して","かくして"],["、"],["わたし"],["に"],["見られない","みられない"],["よう"],["に"],["する"],["こと"],["が"],["できよう"],["か"],["。"],["主","しゅ"],["は"],["言われる","いわれる"],["、"],["わたし"],["は"],["天","てん"],["と"],["地","ち"],["と"],["に"],["満ちて","みちて"],["いるで"],["は"],["ない"],["か"],["。"]]},{"verse":25,"text":"わが名,なによって偽,いつわりを預言,よげんする預言者,よげんしゃたちが、『わたしは夢,ゆめを見,みた、わたしは夢,ゆめを見,みた』と言,いうのを聞,きいた。","tok":[["わが"],["名","な"],["によって"],["偽り","いつわり"],["を"],["預言","よげん"],["する"],["預言者","よげんしゃ"],["たち"],["が"],["、"],["『"],["わたし"],["は"],["夢","ゆめ"],["を"],["見た","みた"],["、"],["わたし"],["は"],["夢","ゆめ"],["を"],["見た","みた"],["』"],["と"],["言う","いう"],["の"],["を"],["聞いた","きいた"],["。"]]},{"verse":26,"text":"偽,いつわりを預言,よげんする預言者,よげんしゃたちの心,こころに、いつまで偽,いつわりがあるのであるか。彼,かれらはその心,こころの欺,あざむきを預言,よげんする。","tok":[["偽り","いつわり"],["を"],["預言","よげん"],["する"],["預言者","よげんしゃ"],["たち"],["の"],["心","こころ"],["に"],["、"],["いつ"],["まで"],["偽り","いつわり"],["が"],["ある"],["ので"],["ある"],["か"],["。"],["彼","かれ"],["ら"],["は"],["その"],["心","こころ"],["の"],["欺き","あざむき"],["を"],["預言","よげん"],["する"],["。"]]},{"verse":27,"text":"彼,かれらはその先祖,せんぞがバアルに従,したがってわが名,なを忘,わすれたように、互,たがいに夢,ゆめを語,かたって、わたしの民,たみにわが名,なを忘,わすれさせようとする。","tok":[["彼","かれ"],["ら"],["は"],["その"],["先祖","せんぞ"],["が"],["バアル"],["に"],["従って","したがって"],["わが"],["名","な"],["を"],["忘た","わすれた"],["よう"],["に"],["、"],["互","たがい"],["に"],["夢","ゆめ"],["を"],["語って","かたって"],["、"],["わたし"],["の"],["民","たみ"],["に"],["わが"],["名","な"],["を"],["忘させよう","わすれさせよう"],["と"],["する"],["。"]]},{"verse":28,"text":"夢,ゆめをみた預言者,よげんしゃは夢,ゆめを語,かたるがよい。しかし、わたしの言葉,ことばを受,うけた者,ものは誠実,せいじつにわたしの言葉,ことばを語,かたらなければならない。わらと麦,むぎとをくらべることができようかと、主,しゅは言,いわれる。","tok":[["夢","ゆめ"],["を"],["みた"],["預言者","よげんしゃ"],["は"],["夢","ゆめ"],["を"],["語る","かたる"],["が"],["よい"],["。"],["しかし"],["、"],["わたし"],["の"],["言葉","ことば"],["を"],["受た","うけた"],["者","もの"],["は"],["誠実","せいじつ"],["に"],["わたし"],["の"],["言葉","ことば"],["を"],["語らなければ","かたらなければ"],["ならない"],["。"],["わら"],["と"],["麦","むぎ"],["と"],["を"],["くらべる"],["こと"],["が"],["できよう"],["か"],["と"],["、"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":29,"text":"主,しゅは仰,おおせられる、わたしの言葉,ことばは火,ひのようではないか。また岩,いわを打,うち砕,くだく鎚,つちのようではないか。","tok":[["主","しゅ"],["は"],["仰せられる","おおせられる"],["、"],["わたし"],["の"],["言葉","ことば"],["は"],["火","ひ"],["の"],["よう"],["で"],["は"],["ない"],["か"],["。"],["また"],["岩","いわ"],["を"],["打ち砕く","うちくだく"],["鎚","つち"],["の"],["よう"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":30,"text":"それゆえ見,みよ、わたしはわたしの言葉,ことばを互,たがいに盗,ぬすむ預言者,よげんしゃの敵,てきとなると、主,しゅは言,いわれる。","tok":[["それ"],["ゆえ"],["見よ","みよ"],["、"],["わたし"],["は"],["わたし"],["の"],["言葉","ことば"],["を"],["互","たがい"],["に"],["盗む","ぬすむ"],["預言者","よげんしゃ"],["の"],["敵","てき"],["と"],["なる"],["と"],["、"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":31,"text":"見,みよ、わたしは、『主,しゅは言,いいたもう』と舌,したをもって語,かたる預言者,よげんしゃの敵,てきとなると、主,しゅは言,いわれる。","tok":[["見よ","みよ"],["、"],["わたし"],["は"],["、"],["『"],["主","しゅ"],["は"],["言いた","いいた"],["もう"],["』"],["と"],["舌","した"],["を"],["もって"],["語る","かたる"],["預言者","よげんしゃ"],["の"],["敵","てき"],["と"],["なる"],["と"],["、"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":32,"text":"主,しゅは仰,おおせられる、見,みよ、わたしは偽,いつわりの夢,ゆめを預言,よげんする者,ものの敵,てきとなる。彼,かれらはそれを語,かたり、またその偽,いつわりと大言,たいげんをもってわたしの民,たみを惑,まどわす。わたしが彼,かれらをつかわしたのではなく、また彼,かれらに命,めいじたのでもない。それで彼,かれらはこの民,たみにすこしも益,えきにならないと、主,しゅは言,いわれる。","tok":[["主","しゅ"],["は"],["仰せられる","おおせられる"],["、"],["見よ","みよ"],["、"],["わたし"],["は"],["偽わり","いつわり"],["の"],["夢","ゆめ"],["を"],["預言","よげん"],["する"],["者","もの"],["の"],["敵","てき"],["と"],["なる"],["。"],["彼","かれ"],["ら"],["は"],["それ"],["を"],["語り","かたり"],["、"],["また"],["その"],["偽り","いつわり"],["と"],["大言","たいげん"],["を"],["もって"],["わたし"],["の"],["民","たみ"],["を"],["惑わす","まどわす"],["。"],["わたし"],["が"],["彼","かれ"],["ら"],["を"],["つかわした"],["ので"],["は"],["なく"],["、"],["また"],["彼","かれ"],["ら"],["に"],["命じた","めいじた"],["ので"],["も"],["ない"],["。"],["それ"],["で"],["彼","かれ"],["ら"],["は"],["この"],["民","たみ"],["に"],["すこし"],["も"],["益","えき"],["に"],["ならない"],["と"],["、"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":33,"text":"この民,たみのひとり、または預言者,よげんしゃ、または祭司,さいしがあなたに、『主,しゅの重荷,おもにはなんですか』と問,とうならば、彼,かれらに答,こたえなさい、『あなたがたがその重荷,おもにです。そして主,しゅは、あなたがたを捨,すてると言,いっておられます』と。","tok":[["この"],["民","たみ"],["の"],["ひとり"],["、"],["また"],["は"],["預言者","よげんしゃ"],["、"],["また"],["は"],["祭司","さいし"],["が"],["あなた"],["に"],["、"],["『"],["主","しゅ"],["の"],["重荷","おもに"],["は"],["なん"],["です"],["か"],["』"],["と"],["問うならば","とうならば"],["、"],["彼","かれ"],["ら"],["に"],["答","こたえ"],["なさい"],["、"],["『"],["あなた"],["がた"],["が"],["その"],["重荷","おもに"],["です"],["。"],["そして"],["主","しゅ"],["は"],["、"],["あなた"],["がた"],["を"],["捨てる","すてる"],["と"],["言って","いって"],["おられます"],["』"],["と"],["。"]]},{"verse":34,"text":"そして、『主,しゅの重荷,おもに』と言,いうその預言者,よげんしゃ、祭司,さいし、または民,たみのひとりを、その家族,かぞくと共,ともにわたしは罰,ばっする。","tok":[["そして"],["、"],["『"],["主","しゅ"],["の"],["重荷","おもに"],["』"],["と"],["言う","いう"],["その"],["預言者","よげんしゃ"],["、"],["祭司","さいし"],["、"],["また"],["は"],["民","たみ"],["の"],["ひとり"],["を"],["、"],["その"],["家族","かぞく"],["と"],["共","とも"],["に"],["わたし"],["は"],["罰する","ばっする"],["。"]]},{"verse":35,"text":"あなたがたは、みな互,たがいに、隣,となり人,びとに、また兄弟,きょうだいに、こう言,いわなければならない、『主,しゅはなんと答,こたえられましたか』、『主,しゅはなんと言,いわれましたか』と。","tok":[["あなた"],["がた"],["は"],["、"],["みな"],["互","たがい"],["に"],["、"],["隣人","となりびと"],["に"],["、"],["また"],["兄弟","きょうだい"],["に"],["、"],["こう"],["言わなければ","いわなければ"],["ならない"],["、"],["『"],["主","しゅ"],["は"],["なん"],["と"],["答","こたえ"],["られました"],["か"],["』"],["、"],["『"],["主","しゅ"],["は"],["なん"],["と"],["言われました","いわれました"],["か"],["』"],["と"],["。"]]},{"verse":36,"text":"しかし重,かさねて『主,しゅの重荷,おもに』と言,いってはならない。重荷,おもには人,ひとおのおのの自分,じぶんの言葉,ことばだからである。あなたがたは生,いける神,かみ、万軍,ばんぐんの主,しゅなるわれわれの神,かみの言葉,ことばを曲,まげる者,ものである。","tok":[["しかし"],["重ねて","かさねて"],["『"],["主","しゅ"],["の"],["重荷","おもに"],["』"],["と"],["言って","いって"],["は"],["ならない"],["。"],["重荷","おもに"],["は"],["人","ひと"],["おのおの"],["の"],["自分","じぶん"],["の"],["言葉","ことば"],["だ"],["から"],["で"],["ある"],["。"],["あなた"],["がた"],["は"],["生ける","いける"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["なる"],["われわれ"],["の"],["神","かみ"],["の"],["言葉","ことば"],["を"],["曲げる","まげる"],["者","もの"],["で"],["ある"],["。"]]},{"verse":37,"text":"あなたは預言者,よげんしゃにこう言,いわなければならない、『主,しゅはあなたになんと答,こたえられましたか』、『主,しゅはなんと言,いわれましたか』と。","tok":[["あなた"],["は"],["預言者","よげんしゃ"],["に"],["こう"],["言わなければ","いわなければ"],["ならない"],["、"],["『"],["主","しゅ"],["は"],["あなた"],["に"],["なん"],["と"],["答","こたえ"],["られました"],["か"],["』"],["、"],["『"],["主","しゅ"],["は"],["なん"],["と"],["言われました","いわれました"],["か"],["』"],["と"],["。"]]},{"verse":38,"text":"もしあなたがたが『主,しゅの重荷,おもに』と言,いうならば、主,しゅはこう仰,おおせられる、『わたしが人,ひとをあなたがたにつかわして、あなたがたは「主,しゅの重荷,おもに」と言,いってはならないと言,いわせたのに、あなたがたは「主,しゅの重荷,おもに」という言葉,ことばを言,いったので、","tok":[["もし"],["あなた"],["がた"],["が"],["『"],["主","しゅ"],["の"],["重荷","おもに"],["』"],["と"],["言うならば","いうならば"],["、"],["主","しゅ"],["は"],["こう"],["仰せられる","おおせられる"],["、"],["『"],["わたし"],["が"],["人","ひと"],["を"],["あなた"],["がた"],["に"],["つかわして"],["、"],["あなた"],["がた"],["は"],["「"],["主","しゅ"],["の"],["重荷","おもに"],["」"],["と"],["言って","いって"],["は"],["ならない"],["と"],["言わせた","いわせた"],["のに"],["、"],["あなた"],["がた"],["は"],["「"],["主","しゅ"],["の"],["重荷","おもに"],["」"],["と"],["いう"],["言葉","ことば"],["を"],["言った","いった"],["ので"],["、"]]},{"verse":39,"text":"わたしは必,かならずあなたがたを捕,とらえ移,うつさせ、あなたがたとあなたがたの先祖,せんぞとに与,あたえたこの町,まちと、あなたがたとを、わたしの前,まえから捨,すて去,さる。","tok":[["わたし"],["は"],["必","かならず"],["あなた"],["がた"],["を"],["捕らえ","とらえ"],["移させ","うつさせ"],["、"],["あなた"],["がた"],["と"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["と"],["に"],["与えた","あたえた"],["この"],["町","まち"],["と"],["、"],["あなた"],["がた"],["と"],["を"],["、"],["わたし"],["の"],["前","まえ"],["から"],["捨て去る","すてさる"],["。"]]},{"verse":40,"text":"そして、忘,わすれられることのない永遠,えいえんのはずかしめと永遠,えいえんの恥,はじを、あなたがたにこうむらせる』」。","tok":[["そして"],["、"],["忘られる","わすれられる"],["こと"],["の"],["ない"],["永遠","えいえん"],["の"],["はずかしめ"],["と"],["永遠","えいえん"],["の"],["恥","はじ"],["を"],["、"],["あなた"],["がた"],["に"],["こうむらせる"],["』"],["」"],["。"]]}]
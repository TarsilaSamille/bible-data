[{"verse":1,"text":"ユダの王,おうヨシヤの子,こゼデキヤが世,よを治,おさめ始,はじめたころ、この言葉,ことばが主,しゅからエレミヤに臨,のぞんだ。","tok":[["ユダ"],["の"],["王","おう"],["ヨシヤ"],["の"],["子","こ"],["ゼデキヤ"],["が"],["世","よ"],["を"],["治め","おさめ"],["始","はじめ"],["た"],["ころ"],["、"],["この"],["言葉","ことば"],["が"],["主ら","しゅから"],["エレミヤ"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":2,"text":"すなわち主,しゅはこうわたしに仰,おおせられた、「綱,つなと、くびきとを作,つくって、それをあなたの首,くびにつけ、","tok":[["すなわち"],["主","しゅ"],["は"],["こう"],["わたし"],["に"],["仰せられた","おおせられた"],["、"],["「"],["綱","つな"],["と"],["、"],["くびき"],["と"],["を"],["作って","つくって"],["、"],["それ"],["を"],["あなた"],["の"],["首","くび"],["に"],["つけ"],["、"]]},{"verse":3,"text":"エルサレムにいるユダの王,おうゼデキヤの所,ところに来,きた使者,ししゃたちによって、エドムの王,おう、モアブの王,おう、アンモンびとの王,おう、ツロの王,おう、シドンの王,おうに言,いいおくりなさい。","tok":[["エルサレム"],["に"],["いる"],["ユダ"],["の"],["王","おう"],["ゼデキヤ"],["の"],["所","ところ"],["に"],["来た","きた"],["使者","ししゃ"],["たち"],["によって"],["、"],["エドム"],["の"],["王","おう"],["、"],["モアブ"],["の"],["王","おう"],["、"],["アンモン"],["びと"],["の"],["王","おう"],["、"],["ツロ"],["の"],["王","おう"],["、"],["シドン"],["の"],["王","おう"],["に"],["言い","いい"],["おくり"],["なさい"],["。"]]},{"verse":4,"text":"彼,かれらの主君,しゅくんにこの命,いのちを伝,つたえさせなさい、『万軍,ばんぐんの主,しゅ、イスラエルの神,かみはこう仰,おおせられる、あなたがたは主君,しゅくんにこのように告,つげなければならない。","tok":[["彼","かれ"],["ら"],["の"],["主君","しゅくん"],["に"],["この"],["命","いのち"],["を"],["伝えさせ","つたえさせ"],["なさい"],["、"],["『"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["、"],["イスラエル"],["の"],["神","かみ"],["は"],["こう"],["仰せられる","おおせられる"],["、"],["あなた"],["がた"],["は"],["主君","しゅくん"],["に"],["この"],["よう"],["に"],["告","つげ"],["なければ"],["ならない"],["。"]]},{"verse":5,"text":"わたしは大,おおいなる力,ちからと伸,のべた腕,うでとをもって、地,ちと地,ちの上,うえにいる人,ひとと獣,けものとをつくった者,ものである。そして心,こころのままに地,ちを人,ひとに与,あたえる。","tok":[["わたし"],["は"],["大いなる","おおいなる"],["力","ちから"],["と"],["伸べた","のべた"],["腕","うで"],["と"],["を"],["もって"],["、"],["地","ち"],["と"],["地","ち"],["の"],["上","うえ"],["に"],["いる"],["人","ひと"],["と"],["獣","けもの"],["と"],["を"],["つくった"],["者","もの"],["で"],["ある"],["。"],["そして"],["心","こころ"],["の"],["まま"],["に"],["地","ち"],["を"],["人","ひと"],["に"],["与える","あたえる"],["。"]]},{"verse":6,"text":"いまわたしはこのすべての国,くにを、わたしのしもべであるバビロンの王,おうネブカデネザルの手,てに与,あたえ、また野,のの獣,けものをも彼,かれに与,あたえて彼,かれに仕,つかえさせた。","tok":[["いま"],["わたし"],["は"],["この"],["すべて"],["の"],["国","くに"],["を"],["、"],["わたし"],["の"],["しもべ"],["で"],["ある"],["バビロン"],["の"],["王","おう"],["ネブカデネザル"],["の"],["手","て"],["に"],["与","あたえ"],["、"],["また"],["野","の"],["の"],["獣","けもの"],["を"],["も"],["彼","かれ"],["に"],["与","あたえ"],["て"],["彼","かれ"],["に"],["仕えさせた","つかえさせた"],["。"]]},{"verse":7,"text":"彼,かれの地,ちに時,ときがくるまで、万国民,ばんこくみんは彼,かれとその子,ことその孫,まごに仕,つかえる。その時,ときがくるならば、多,おおくの国,くにと大,おおいなる王,おうたちとが彼,かれを自分,じぶんの奴隷,どれいにする。","tok":[["彼","かれ"],["の"],["地","ち"],["に"],["時","とき"],["が"],["くる"],["まで"],["、"],["万","まん"],["国民","こくみん"],["は"],["彼","かれ"],["と"],["その"],["子","こ"],["と"],["その"],["孫","まご"],["に"],["仕える","つかえる"],["。"],["その"],["時","とき"],["が"],["くるならば"],["、"],["多く","おおく"],["の"],["国","くに"],["と"],["大いなる","おおいなる"],["王","おう"],["たち"],["と"],["が"],["彼","かれ"],["を"],["自分","じぶん"],["の"],["奴隷","どれい"],["に"],["する"],["。"]]},{"verse":8,"text":"バビロンの王,おうネブカデネザルに仕,つかえず、バビロンの王,おうのくびきを自分,じぶんの首,くびに負,おわない民,たみと国,くにとは、わたしがつるぎと、ききんと、疫病,えきびょうをもって罰,ばっし、ついには彼,かれの手,てによってことごとく滅,ほろぼすと主,しゅは言,いわれる。","tok":[["バビロン"],["の"],["王","おう"],["ネブカデネザル"],["に"],["仕えず","つかえず"],["、"],["バビロン"],["の"],["王","おう"],["の"],["くびき"],["を"],["自分","じぶん"],["の"],["首","くび"],["に"],["負わない","おわない"],["民","たみ"],["と"],["国","くに"],["と"],["は"],["、"],["わたし"],["が"],["つるぎ"],["と"],["、"],["ききん"],["と"],["、"],["疫病","えきびょう"],["を"],["もって"],["罰し","ばっし"],["、"],["ついに"],["は"],["彼","かれ"],["の"],["手","て"],["によって"],["ことごとく"],["滅ぼす","ほろぼす"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":9,"text":"それで、あなたがたの預言者,よげんしゃ、占,うらない師,し、夢,ゆめみる者,もの、法,ほう術,じゅつ師,し、魔法使,まほうつかいが、「あなたがたはバビロンの王,おうに仕,つかえることはない」と言,いっても、聞,きいてはならない。","tok":[["それ"],["で"],["、"],["あなた"],["がた"],["の"],["預言者","よげんしゃ"],["、"],["占師","うらないし"],["、"],["夢みる","ゆめみる"],["者","もの"],["、"],["法","ほう"],["術師","じゅつし"],["、"],["魔法","まほう"],["使い","つかい"],["が"],["、"],["「"],["あなた"],["がた"],["は"],["バビロン"],["の"],["王","おう"],["に"],["仕える","つかえる"],["こと"],["は"],["ない"],["」"],["と"],["言って","いって"],["も"],["、"],["聞いて","きいて"],["は"],["ならない"],["。"]]},{"verse":10,"text":"彼,かれらはあなたがたに偽,いつわりを預言,よげんして、あなたがたを自分,じぶんの国,くにから遠,とおく離,はなれさせ、わたしに、あなたがたを追,おい出,だしてあなたがたを滅,ほろぼさせるのである。","tok":[["彼","かれ"],["ら"],["は"],["あなた"],["がた"],["に"],["偽り","いつわり"],["を"],["預言","よげん"],["して"],["、"],["あなた"],["がた"],["を"],["自分","じぶん"],["の"],["国","くに"],["から"],["遠く","とおく"],["離れさせ","はなれさせ"],["、"],["わたし"],["に"],["、"],["あなた"],["がた"],["を"],["追い出して","おいだして"],["あなた"],["がた"],["を"],["滅ぼさせる","ほろぼさせる"],["ので"],["ある"],["。"]]},{"verse":11,"text":"しかしバビロンの王,おうのくびきを首,くびに負,おって、彼,かれに仕,つかえる国民,こくみんを、わたしはその故国,ここくに残,のこらせ、それを耕,たがやして、そこに住,すまわせると主,しゅは言,いわれる』」。","tok":[["しかし"],["バビロン"],["の"],["王","おう"],["の"],["くびき"],["を"],["首","くび"],["に"],["負って","おって"],["、"],["彼","かれ"],["に"],["仕える","つかえる"],["国民","こくみん"],["を"],["、"],["わたし"],["は"],["その"],["故国","ここく"],["に"],["残らせ","のこらせ"],["、"],["それ"],["を"],["耕やして","たがやして"],["、"],["そこ"],["に"],["住まわせる","すまわせる"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["』"],["」"],["。"]]},{"verse":12,"text":"わたしはユダの王,おうゼデキヤにも同,おなじように言,いった、「あなたがたは、バビロンの王,おうのくびきを自分,じぶんの首,くびに負,おって、彼,かれとその民,たみとに仕,つかえ、そして生,いきなさい。","tok":[["わたし"],["は"],["ユダ"],["の"],["王","おう"],["ゼデキヤ"],["に"],["も"],["同じ","おなじ"],["よう"],["に"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["、"],["バビロン"],["の"],["王","おう"],["の"],["くびき"],["を"],["自分","じぶん"],["の"],["首","くび"],["に"],["負って","おって"],["、"],["彼","かれ"],["と"],["その"],["民","たみ"],["と"],["に"],["仕え","つかえ"],["、"],["そして"],["生き","いき"],["なさい"],["。"]]},{"verse":13,"text":"どうしてあなたと、あなたの民,たみとが、主,しゅがバビロンの王,おうに仕,つかえない国民,こくみんについて言,いわれたように、つるぎと、ききんと、疫病,えきびょうに死,しんでよかろうか。","tok":[["どう"],["して"],["あなた"],["と"],["、"],["あなた"],["の"],["民","たみ"],["と"],["が"],["、"],["主","しゅ"],["が"],["バビロン"],["の"],["王","おう"],["に"],["仕えない","つかえない"],["国民","こくみん"],["について"],["言われた","いわれた"],["よう"],["に"],["、"],["つるぎ"],["と"],["、"],["ききん"],["と"],["、"],["疫病","えきびょう"],["に"],["死んで","しんで"],["よかろう"],["か"],["。"]]},{"verse":14,"text":"あなたがたはバビロンの王,おうに仕,つかえることはないとあなたがたに告,つげる預言者,よげんしゃの言葉,ことばを聞,きいてはならない。彼,かれらがあなたがたに預言,よげんしていることは偽,いつわりであるからだ。","tok":[["あなた"],["がた"],["は"],["バビロン"],["の"],["王","おう"],["に"],["仕える","つかえる"],["こと"],["は"],["ない"],["と"],["あなた"],["がた"],["に"],["告げる","つげる"],["預言者","よげんしゃ"],["の"],["言葉","ことば"],["を"],["聞いて","きいて"],["は"],["ならない"],["。"],["彼","かれ"],["ら"],["が"],["あなた"],["がた"],["に"],["預言","よげん"],["して"],["いる"],["こと"],["は"],["偽わりで","いつわりで"],["ある"],["から"],["だ"],["。"]]},{"verse":15,"text":"主,しゅは言,いわれる、わたしが彼,かれらをつかわしたのではないのに、彼,かれらはわたしの名,なによって偽,いつわって預言,よげんしている。そのために、わたしはあなたがたを追,おい払,はらい、あなたがたと、あなたがたに預言,よげんする預言者,よげんしゃたちを滅,ほろぼすようになるのだ」。","tok":[["主","しゅ"],["は"],["言われる","いわれる"],["、"],["わたし"],["が"],["彼","かれ"],["ら"],["を"],["つかわした"],["ので"],["は"],["ない"],["のに"],["、"],["彼","かれ"],["ら"],["は"],["わたし"],["の"],["名","な"],["によって"],["偽わって","いつわって"],["預言","よげん"],["して"],["いる"],["。"],["その"],["ため"],["に"],["、"],["わたし"],["は"],["あなた"],["がた"],["を"],["追い払","おいはらい"],["、"],["あなた"],["がた"],["と"],["、"],["あなた"],["がた"],["に"],["預言","よげん"],["する"],["預言者","よげんしゃ"],["たち"],["を"],["滅ぼす","ほろぼす"],["よう"],["に"],["なる"],["の"],["だ"],["」"],["。"]]},{"verse":16,"text":"わたしはまた祭司,さいしとこのすべての民,たみとに語,かたって言,いった、「主,しゅはこう仰,おおせられる、『見,みよ、主,しゅの宮,みやの器,うつわは今,いま、すみやかに、バビロンから返,かえされてくる』とあなたがたに預言,よげんする預言者,よげんしゃの言葉,ことばを聞,きいてはならない。それは、彼,かれらがあなたがたに預言,よげんしていることは偽,いつわりであるからだ。","tok":[["わたし"],["は"],["また"],["祭司","さいし"],["と"],["この"],["すべて"],["の"],["民","たみ"],["と"],["に"],["語って","かたって"],["言った","いった"],["、"],["「"],["主","しゅ"],["は"],["こう"],["仰せられる","おおせられる"],["、"],["『"],["見よ","みよ"],["、"],["主","しゅ"],["の"],["宮","みや"],["の"],["器","うつわ"],["は"],["今","いま"],["、"],["すみやか"],["に"],["、"],["バビロン"],["から"],["返えされて","かえされて"],["くる"],["』"],["と"],["あなた"],["がた"],["に"],["預言","よげん"],["する"],["預言者","よげんしゃ"],["の"],["言葉","ことば"],["を"],["聞いて","きいて"],["は"],["ならない"],["。"],["それ"],["は"],["、"],["彼","かれ"],["ら"],["が"],["あなた"],["がた"],["に"],["預言","よげん"],["して"],["いる"],["こと"],["は"],["偽わりで","いつわりで"],["ある"],["から"],["だ"],["。"]]},{"verse":17,"text":"彼,かれらのいうことを聞,きいてはならない。バビロンの王,おうに仕,つかえ、そして生,いきなさい。どうしてこの町,まちが荒,あれ地,ちとなってよかろうか。","tok":[["彼","かれ"],["ら"],["の"],["いう"],["こと"],["を"],["聞いて","きいて"],["は"],["ならない"],["。"],["バビロン"],["の"],["王","おう"],["に"],["仕え","つかえ"],["、"],["そして"],["生き","いき"],["なさい"],["。"],["どう"],["して"],["この"],["町","まち"],["が"],["荒れ地","あれち"],["と"],["なって"],["よかろう"],["か"],["。"]]},{"verse":18,"text":"もし彼,かれらが預言者,よげんしゃであって、主,しゅの言葉,ことばが彼,かれらのうちにあるのであれば、主,しゅの宮,みやとユダの王,おうの宮殿,きゅうでんとエルサレムとに残,のこされている器,うつわが、バビロンに移,うつされないように、万軍,ばんぐんの主,しゅに、とりなしを願,ねがうべきだ。","tok":[["もし"],["彼","かれ"],["ら"],["が"],["預言者","よげんしゃ"],["で"],["あって"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["が"],["彼","かれ"],["ら"],["の"],["うち"],["に"],["ある"],["ので"],["あれば"],["、"],["主","しゅ"],["の"],["宮","みや"],["と"],["ユダ"],["の"],["王","おう"],["の"],["宮殿","きゅうでん"],["と"],["エルサレム"],["と"],["に"],["残されて","のこされて"],["いる"],["器","うつわ"],["が"],["、"],["バビロン"],["に"],["移されない","うつされない"],["よう"],["に"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["に"],["、"],["とりなし"],["を"],["願うべきだ","ねがうべきだ"],["。"]]},{"verse":19,"text":"万軍,ばんぐんの主,しゅは柱,はしらと海,うみと台,だい、その他,たこの町,まちに残,のこっている器,うつわについて、こう仰,おおせられる。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["柱","はしら"],["と"],["海","うみ"],["と"],["台","だい"],["、"],["その"],["他","た"],["この"],["町","まち"],["に"],["残って","のこって"],["いる"],["器","うつわ"],["について"],["、"],["こう"],["仰せられる","おおせられる"],["。"]]},{"verse":20,"text":"これはバビロンの王,おうネブカデネザルが、ユダの王,おうエホヤキムの子,こエコニヤ、およびユダとエルサレムのすべての身分,みぶんの尊,たっとい人々,ひとびとを捕,とらえてエルサレムからバビロンに移,うつしたときに、持,もち去,さらなかった器,うつわである。――","tok":[["これ"],["は"],["バビロン"],["の"],["王","おう"],["ネブカデネザル"],["が"],["、"],["ユダ"],["の"],["王","おう"],["エホヤキム"],["の"],["子","こ"],["エコニヤ"],["、"],["および"],["ユダ"],["と"],["エルサレム"],["の"],["すべて"],["の"],["身分","みぶん"],["の"],["尊","た"],["っと"],["い"],["人々","ひとびと"],["を"],["捕らえて","とらえて"],["エルサレム"],["から"],["バビロン"],["に"],["移した","うつした"],["とき"],["に"],["、"],["持去らなかった","もちさらなかった"],["器","うつわ"],["で"],["ある"],["。"],["―"],["―"]]},{"verse":21,"text":"すなわち万軍,ばんぐんの主,しゅ、イスラエルの神,かみは、主,しゅの宮,みやとユダの王,おうの宮殿,きゅうでんとエルサレムとに残,のこされている器,うつわについて、こう仰,おおせられる。","tok":[["すなわち"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["、"],["イスラエル"],["の"],["神","かみ"],["は"],["、"],["主","しゅ"],["の"],["宮","みや"],["と"],["ユダ"],["の"],["王","おう"],["の"],["宮殿","きゅうでん"],["と"],["エルサレム"],["と"],["に"],["残されて","のこされて"],["いる"],["器","うつわ"],["について"],["、"],["こう"],["仰せられる","おおせられる"],["。"]]},{"verse":22,"text":"これらはバビロンに携,たずさえ行,いかれ、わたしが顧,かえりみる日,ひまでそこにおかれている。その後,のち、わたしはこれらのものを、この所,ところに携,たずさえ帰,かえらせると主,しゅは言,いわれる」。","tok":[["これ"],["ら"],["は"],["バビロン"],["に"],["携え","たずさえ"],["行かれ","いかれ"],["、"],["わたし"],["が"],["顧る","かえりみる"],["日","ひ"],["まで"],["そこ"],["に"],["おかれて"],["いる"],["。"],["その後","そのの"],["ち"],["、"],["わたし"],["は"],["これ"],["ら"],["の"],["もの"],["を"],["、"],["この"],["所","ところ"],["に"],["携え","たずさえ"],["帰えらせる","かえらせる"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["」"],["。"]]}]
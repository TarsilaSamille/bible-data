[{"verse":1,"text":"エレミヤがなお監視,かんしの庭,にわに閉,とじ込,こめられている時,とき、主,しゅの言葉,ことばはふたたび彼,かれに臨,のぞんだ、","tok":[["エレミヤ"],["が"],["なお"],["監視","かんし"],["の"],["庭","にわ"],["に"],["閉じ込められて","とじこめられて"],["いる"],["時","とき"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["は"],["ふたたび"],["彼","かれ"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":2,"text":"「地,ちを造,つくられた主,しゅ、それを形,かたち造,つくって堅,かたく立,たたせられた主,しゅ、その名,なを主,しゅと名,なのっておられる者,ものがこう仰,おおせられる、","tok":[["「"],["地","ち"],["を"],["造られた","つくられた"],["主","しゅ"],["、"],["それ"],["を"],["形造って","かたちつくって"],["堅く","かたく"],["立たせられた","たたせられた"],["主","しゅ"],["、"],["その"],["名","な"],["を"],["主","しゅ"],["と"],["名のって","なのって"],["おられる"],["者","もの"],["が"],["こう"],["仰せられる","おおせられる"],["、"]]},{"verse":3,"text":"わたしに呼,よび求,もとめよ、そうすれば、わたしはあなたに答,こたえる。そしてあなたの知,しらない大,おおきな隠,かくされている事,ことを、あなたに示,しめす。","tok":[["わたし"],["に"],["呼び求めよ","よびもとめよ"],["、"],["そう"],["すれば"],["、"],["わたし"],["は"],["あなた"],["に"],["答","こたえ"],["る"],["。"],["そして"],["あなた"],["の"],["知らない","しらない"],["大きな","おおきな"],["隠されて","かくされて"],["いる"],["事","こと"],["を"],["、"],["あなた"],["に"],["示めす","しめす"],["。"]]},{"verse":4,"text":"イスラエルの神,かみ、主,しゅは塁,るいと、つるぎとを防,ふせぐために破壊,はかいされたこの町,まちの家,いえと、ユダの王,おうの家,いえについてこう言,いわれる、","tok":[["イスラエル"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["塁","るい"],["と"],["、"],["つるぎ"],["と"],["を"],["防ぐ","ふせぐ"],["ため"],["に"],["破壊","はかい"],["された"],["この"],["町","まち"],["の"],["家","いえ"],["と"],["、"],["ユダ"],["の"],["王","おう"],["の"],["家","いえ"],["について"],["こう"],["言われる","いわれる"],["、"]]},{"verse":5,"text":"カルデヤびとは来,きて戦,たたかい、わたしが怒,いかりと憤,いきどおりをもって殺,ころす人々,ひとびとの死体,したいを、それに満,みたす。わたしは人々,ひとびとのもろもろの悪,あくのために、この町,まちにわたしの顔,かおをおおい隠,かくした。","tok":[["カルデヤ"],["びと"],["は"],["来て","きて"],["戦い","たたかい"],["、"],["わたし"],["が"],["怒り","いかり"],["と"],["憤り","いきどおり"],["を"],["もって"],["殺ろす","ころす"],["人々","ひとびと"],["の"],["死体","したい"],["を"],["、"],["それ"],["に"],["満たす","みたす"],["。"],["わたし"],["は"],["人々","ひとびと"],["の"],["もろもろ"],["の"],["悪","あく"],["の"],["ため"],["に"],["、"],["この"],["町","まち"],["に"],["わたし"],["の"],["顔","かお"],["を"],["おおい隠した","おおいかくした"],["。"]]},{"verse":6,"text":"見,みよ、わたしは健康,けんこうと、いやしとを、ここにもたらして人々,ひとびとをいやし、豊,ゆたかな繁栄,はんえいと安全,あんぜんとを彼,かれらに示,しめす。","tok":[["見よ","みよ"],["、"],["わたし"],["は"],["健康","けんこう"],["と"],["、"],["いやし"],["と"],["を"],["、"],["ここ"],["に"],["もたらして"],["人々","ひとびと"],["を"],["いやし"],["、"],["豊","ゆたか"],["な"],["繁栄","はんえい"],["と"],["安全","あんぜん"],["と"],["を"],["彼","かれ"],["ら"],["に"],["示めす","しめす"],["。"]]},{"verse":7,"text":"わたしはユダとイスラエルを再,ふたたび栄,さかえさせ、彼,かれらを建,たてて、もとのようにする。","tok":[["わたし"],["は"],["ユダ"],["と"],["イスラエル"],["を"],["再び","ふたたび"],["栄","さかえ"],["させ"],["、"],["彼","かれ"],["ら"],["を"],["建てて","たてて"],["、"],["もと"],["の"],["よう"],["に"],["する"],["。"]]},{"verse":8,"text":"わたしは彼,かれらがわたしに向,むかって犯,おかした罪,つみのすべてのとがを清,きよめ、彼,かれらがわたしに向,むかって犯,おかした罪,つみと反逆,はんぎゃくのすべてのとがをゆるす。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["が"],["わたし"],["に"],["向かって","むかって"],["犯した","おかした"],["罪","つみ"],["の"],["すべて"],["の"],["とが"],["を"],["清め","きよめ"],["、"],["彼","かれ"],["ら"],["が"],["わたし"],["に"],["向かって","むかって"],["犯した","おかした"],["罪","つみ"],["と"],["反逆","はんぎゃく"],["の"],["すべて"],["の"],["とが"],["を"],["ゆるす"],["。"]]},{"verse":9,"text":"この町,まちは地,ちのもろもろの民,たみの前,まえに、わたしのために喜,よろこびの名,なとなり、誉,ほまれとなり、栄,さかえとなる。彼,かれらはわたしがわたしの民,たみに施,ほどこすもろもろの恵,めぐみのことを聞,きく。そして、わたしがこの町,まちに施,ほどこすもろもろの恵,めぐみと、もろもろの繁栄,はんえいのために恐,おそれて身,みをふるわす。","tok":[["この"],["町","まち"],["は"],["地","ち"],["の"],["もろもろ"],["の"],["民","たみ"],["の"],["前","まえ"],["に"],["、"],["わたし"],["の"],["ため"],["に"],["喜こび","よろこび"],["の"],["名","な"],["と"],["なり"],["、"],["誉","ほまれ"],["と"],["なり"],["、"],["栄","さかえ"],["と"],["なる"],["。"],["彼","かれ"],["ら"],["は"],["わたし"],["が"],["わたし"],["の"],["民","たみ"],["に"],["施す","ほどこす"],["もろもろ"],["の"],["恵","めぐみ"],["の"],["こと"],["を"],["聞く","きく"],["。"],["そして"],["、"],["わたし"],["が"],["この"],["町","まち"],["に"],["施す","ほどこす"],["もろもろ"],["の"],["恵","めぐみ"],["と"],["、"],["もろもろ"],["の"],["繁栄","はんえい"],["の"],["ため"],["に"],["恐れて","おそれて"],["身","み"],["を"],["ふるわす"],["。"]]},{"verse":10,"text":"主,しゅはこう言,いわれる、あなたがたが、『それは荒,あれて、人,ひともおらず獣,けものもいない』というこの所,ところ、すなわち、荒,あれて、人,ひともおらず住,すむ者,ものもなく、獣,けものもいないユダの町,まちとエルサレムのちまたに、","tok":[["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["あなた"],["が"],["た"],["が"],["、"],["『"],["それ"],["は"],["荒て","あれて"],["、"],["人","ひと"],["も"],["おらず"],["獣","けもの"],["も"],["いない"],["』"],["と"],["いう"],["この"],["所","ところ"],["、"],["すなわち"],["、"],["荒て","あれて"],["、"],["人","ひと"],["も"],["おらず"],["住む","すむ"],["者","もの"],["も"],["なく"],["、"],["獣","けもの"],["も"],["いない"],["ユダ"],["の"],["町","まち"],["と"],["エルサレム"],["の"],["ちまた"],["に"],["、"]]},{"verse":11,"text":"再,ふたたび喜,よろこびの声,こえ、楽,たのしみの声,こえ、花婿,はなむこの声,こえ、花嫁,はなよめの声,こえ、および『万軍,ばんぐんの主,しゅに感謝,かんしゃせよ、主,しゅは恵,めぐみふかく、そのいつくしみは、いつまでも絶,たえることがない』といって、感謝,かんしゃの供,そなえ物,ものを主,しゅの宮,みやに携,たずさえてくる者,ものの声,こえが聞,きこえる。それは、わたしがこの地,ちを再,ふたたび栄,さかえさせて初,はじめのようにするからであると主,しゅは言,いわれる。","tok":[["再び","ふたたび"],["喜こび","よろこび"],["の"],["声","こえ"],["、"],["楽み","たのしみ"],["の"],["声","こえ"],["、"],["花婿","はなむこ"],["の"],["声","こえ"],["、"],["花嫁","はなよめ"],["の"],["声","こえ"],["、"],["および"],["『"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["に"],["感謝","かんしゃ"],["せよ"],["、"],["主","しゅ"],["は"],["恵","めぐみ"],["ふかく"],["、"],["その"],["いつくしみ"],["は"],["、"],["いつ"],["まで"],["も"],["絶える","たえる"],["こと"],["が"],["ない"],["』"],["と"],["いって"],["、"],["感謝","かんしゃ"],["の"],["供え物","そなえもの"],["を"],["主","しゅ"],["の"],["宮","みや"],["に"],["携えて","たずさえて"],["くる"],["者","もの"],["の"],["声","こえ"],["が"],["聞こえる","きこえる"],["。"],["それ"],["は"],["、"],["わたし"],["が"],["この"],["地","ち"],["を"],["再び","ふたたび"],["栄","さかえ"],["させて"],["初め","はじめ"],["の"],["よう"],["に"],["する"],["から"],["で"],["ある"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":12,"text":"万軍,ばんぐんの主,しゅはこう言,いわれる、荒,あれて、人,ひともおらず獣,けものもいないこの所,ところと、そのすべての町々,まちまちに再,ふたたびその群,むれを伏,ふさせる牧者,ぼくしゃのすまいがあるようになる。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["荒て","あれて"],["、"],["人","ひと"],["も"],["おらず"],["獣","けもの"],["も"],["いない"],["この"],["所","ところ"],["と"],["、"],["その"],["すべて"],["の"],["町々","まちまち"],["に"],["再び","ふたたび"],["その"],["群れ","むれ"],["を"],["伏させる","ふさせる"],["牧者","ぼくしゃ"],["の"],["すまい"],["が"],["ある"],["よう"],["に"],["なる"],["。"]]},{"verse":13,"text":"山地,さんちの町々,まちまちと、平地,へいちの町々,まちまちと、ネゲブの町々,まちまちと、ベニヤミンの地,ち、エルサレムの周囲,しゅういと、ユダの町々,まちまちで、群,むれは再,ふたたびそれを数,かぞえる者,ものの手,ての下,したを通,とおりすぎると主,しゅは言,いわれる。","tok":[["山地","さんち"],["の"],["町々","まちまち"],["と"],["、"],["平地","へいち"],["の"],["町々","まちまち"],["と"],["、"],["ネゲブ"],["の"],["町々","まちまち"],["と"],["、"],["ベニヤミン"],["の"],["地","ち"],["、"],["エルサレム"],["の"],["周囲","しゅうい"],["と"],["、"],["ユダ"],["の"],["町々","まちまち"],["で"],["、"],["群れ","むれ"],["は"],["再び","ふたたび"],["それ"],["を"],["数える","かぞえる"],["者","もの"],["の"],["手","て"],["の"],["下","した"],["を"],["通りすぎる","とおりすぎる"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":14,"text":"主,しゅは言,いわれる、見,みよ、わたしがイスラエルの家,いえとユダの家,いえに約束,やくそくしたことをなし遂,とげる日,ひが来,くる。","tok":[["主","しゅ"],["は"],["言われる","いわれる"],["、"],["見よ","みよ"],["、"],["わたし"],["が"],["イスラエル"],["の"],["家","いえ"],["と"],["ユダ"],["の"],["家","いえ"],["に"],["約束","やくそく"],["した"],["こと"],["を"],["なし遂げる","なしとげる"],["日","ひ"],["が"],["来る","くる"],["。"]]},{"verse":15,"text":"その日,ひ、その時,ときになるならば、わたしはダビデのために一つの正,ただしい枝,えだを生,しょうじさせよう。彼,かれは公平,こうへいと正義,せいぎを地,ちに行,おこなう。","tok":[["その"],["日","ひ"],["、"],["その"],["時","とき"],["に"],["なるならば"],["、"],["わたし"],["は"],["ダビデ"],["の"],["ため"],["に"],["一","ひと"],["つ"],["の"],["正い","ただしい"],["枝","えだ"],["を"],["生じさせよう","しょうじさせよう"],["。"],["彼","かれ"],["は"],["公平","こうへい"],["と"],["正義","せいぎ"],["を"],["地","ち"],["に"],["行なう","おこなう"],["。"]]},{"verse":16,"text":"その日,ひ、ユダは救,すくいを得,え、エルサレムは安,やすらかにおる。その名,なは『主,しゅはわれわれの正義,せいぎ』ととなえられる。","tok":[["その"],["日","ひ"],["、"],["ユダ"],["は"],["救い","すくい"],["を"],["得","え"],["、"],["エルサレム"],["は"],["安らか","やすらか"],["に"],["おる"],["。"],["その"],["名","な"],["は"],["『"],["主","しゅ"],["は"],["われわれ"],["の"],["正義","せいぎ"],["』"],["と"],["となえられる"],["。"]]},{"verse":17,"text":"主,しゅはこう仰,おおせられる、イスラエルの家,いえの位,くらいに座,ざする人,ひとがダビデの子孫,しそんのうちに欠,かけることはない。","tok":[["主","しゅ"],["は"],["こう"],["仰せられる","おおせられる"],["、"],["イスラエル"],["の"],["家","いえ"],["の"],["位","くらい"],["に"],["座する","ざする"],["人","ひと"],["が"],["ダビデ"],["の"],["子孫","しそん"],["の"],["うち"],["に"],["欠ける","かける"],["こと"],["は"],["ない"],["。"]]},{"verse":18,"text":"またわたしの前,まえに燔祭,はんさいをささげ、素祭,そさいを焼,やき、つねに犠牲,ぎせいをささげる人,ひとが、レビびとである祭司,さいしのうちに絶,たえることはない」。","tok":[["また"],["わたし"],["の"],["前","まえ"],["に"],["燔祭","はんさい"],["を"],["ささげ"],["、"],["素","す"],["祭","まつり"],["を"],["焼き","やき"],["、"],["つね"],["に"],["犠牲","ぎせい"],["を"],["ささげる"],["人","ひと"],["が"],["、"],["レビ"],["びと"],["で"],["ある"],["祭司","さいし"],["の"],["うち"],["に"],["絶える","たえる"],["こと"],["は"],["ない"],["」"],["。"]]},{"verse":19,"text":"主,しゅの言葉,ことばはエレミヤに臨,のぞんだ、","tok":[["主","しゅ"],["の"],["言葉","ことば"],["は"],["エレミヤ"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":20,"text":"「主,しゅはこう仰,おおせられる、もしあなたがたが、昼,ひると結,むすんだわたしの契約,けいやくを破,やぶり、また夜,よると結,むすんだわたしの契約,けいやくを破,やぶり、昼,ひると夜,よるが定,さだめられた時,ときに来,きないようにすることができるならば、","tok":[["「"],["主","しゅ"],["は"],["こう"],["仰せられる","おおせられる"],["、"],["もし"],["あなた"],["が"],["た"],["が"],["、"],["昼","ひる"],["と"],["結んだ","むすんだ"],["わたし"],["の"],["契約","けいやく"],["を"],["破り","やぶり"],["、"],["また"],["夜","よる"],["と"],["結んだ","むすんだ"],["わたし"],["の"],["契約","けいやく"],["を"],["破り","やぶり"],["、"],["昼","ひる"],["と"],["夜","よる"],["が"],["定められた","さだめられた"],["時","とき"],["に"],["来ない","きない"],["よう"],["に"],["する"],["こと"],["が"],["できるならば"],["、"]]},{"verse":21,"text":"しもべダビデとわたしが結,むすんだ契約,けいやくもまた破,やぶれ、彼,かれはその位,くらいに座,ざして王,おうとなる子,こを与,あたえられない。またわたしがわたしに仕,つかえるレビびとである祭司,さいしに立,たてた契約,けいやくも破,やぶれる。","tok":[["しもべ"],["ダビデ"],["と"],["わたし"],["が"],["結んだ","むすんだ"],["契約","けいやく"],["も"],["また"],["破れ","やぶれ"],["、"],["彼","かれ"],["は"],["その"],["位","くらい"],["に"],["座して","ざして"],["王","おう"],["と"],["なる"],["子","こ"],["を"],["与えられない","あたえられない"],["。"],["また"],["わたし"],["が"],["わたし"],["に"],["仕える","つかえる"],["レビ"],["びと"],["で"],["ある"],["祭司","さいし"],["に"],["立てた","たてた"],["契約","けいやく"],["も"],["破れる","やぶれる"],["。"]]},{"verse":22,"text":"天,てんの星,ほしは数,かぞえることができず、浜,はまの砂,すなは量,はかることができない。そのようにわたしは、しもべダビデの子孫,しそんと、わたしに仕,つかえるレビびとである祭司,さいしの数,かずを増,まそう」。","tok":[["天","てん"],["の"],["星","ほし"],["は"],["数える","かぞえる"],["こと"],["が"],["できず"],["、"],["浜","はま"],["の"],["砂","すな"],["は"],["量る","はかる"],["こと"],["が"],["できない"],["。"],["その"],["よう"],["に"],["わたし"],["は"],["、"],["しもべ"],["ダビデ"],["の"],["子孫","しそん"],["と"],["、"],["わたし"],["に"],["仕える","つかえる"],["レビ"],["びと"],["で"],["ある"],["祭司","さいし"],["の"],["数","かず"],["を"],["増そう","まそう"],["」"],["。"]]},{"verse":23,"text":"主,しゅの言葉,ことばはエレミヤに臨,のぞんだ、","tok":[["主","しゅ"],["の"],["言葉","ことば"],["は"],["エレミヤ"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":24,"text":"「あなたはこの民,たみが、『主,しゅは自,みずから選,えらんだ二つのやからを捨,すてた』といっているのを聞,きかないか。彼,かれらはこのようにわたしの民,たみを侮,あなどって、これを国,くにとみなさないのである。","tok":[["「"],["あなた"],["は"],["この"],["民","たみ"],["が"],["、"],["『"],["主","しゅ"],["は"],["自から","みずから"],["選らんだ","えらんだ"],["二","ふた"],["つ"],["の"],["やから"],["を"],["捨てた","すてた"],["』"],["と"],["いって"],["いる"],["の"],["を"],["聞かない","きかない"],["か"],["。"],["彼","かれ"],["ら"],["は"],["この"],["よう"],["に"],["わたし"],["の"],["民","たみ"],["を"],["侮って","あなどって"],["、"],["これ"],["を"],["国","くに"],["と"],["みなさない"],["ので"],["ある"],["。"]]},{"verse":25,"text":"主,しゅはこう言,いわれる、もしわたしが昼,ひると夜,よるとに契約,けいやくを立,たてず、また天地,てんちのおきてを定,さだめなかったのであれば、","tok":[["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["もし"],["わたし"],["が"],["昼","ひる"],["と"],["夜","よる"],["と"],["に"],["契約","けいやく"],["を"],["立てず","たてず"],["、"],["また"],["天地","てんち"],["の"],["おきて"],["を"],["定めなかった","さだめなかった"],["ので"],["あれば"],["、"]]},{"verse":26,"text":"わたしは、ヤコブとわたしのしもべダビデとの子孫,しそんを捨,すてて、再,ふたたび彼,かれの子孫,しそんのうちからアブラハム、イサク、ヤコブの子孫,しそんを治,おさめる者,ものを選,えらばない。わたしは彼,かれらを再,ふたたび栄,さかえさせ、彼,かれらにあわれみをたれよう」。","tok":[["わたし"],["は"],["、"],["ヤコブ"],["と"],["わたし"],["の"],["しもべ"],["ダビデ"],["と"],["の"],["子孫","しそん"],["を"],["捨てて","すてて"],["、"],["再び","ふたたび"],["彼","かれ"],["の"],["子孫","しそん"],["の"],["うち"],["から"],["アブラハム"],["、"],["イサク"],["、"],["ヤコブ"],["の"],["子孫","しそん"],["を"],["治める","おさめる"],["者","もの"],["を"],["選らば","えらば"],["ない"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["再び","ふたたび"],["栄","さかえ"],["させ"],["、"],["彼","かれ"],["ら"],["に"],["あわれみ"],["を"],["たれよう"],["」"],["。"]]}]
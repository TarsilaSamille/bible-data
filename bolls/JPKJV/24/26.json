[{"verse":1,"text":"ユダの王,おうヨシヤの子,こエホヤキムが世,よを治,おさめた初,はじめのころ、主,しゅからこの言葉,ことばがあった、","tok":[["ユダ"],["の"],["王","おう"],["ヨシヤ"],["の"],["子","こ"],["エホヤキム"],["が"],["世","よ"],["を"],["治めた","おさめた"],["初め","はじめ"],["の"],["ころ"],["、"],["主ら","しゅから"],["この"],["言葉","ことば"],["が"],["あった"],["、"]]},{"verse":2,"text":"「主,しゅはこう仰,おおせられる、主,しゅの宮,みやの庭,にわに立,たち、わたしがあなたに命,めいじて言,いわせるすべての言葉,ことばを、主,しゅの宮,みやで礼,れい拝,はいするために来,きているユダの町々,まちまちの人々,ひとびとに告,つげなさい。ひと言,ことをも言,いい残,のこしておいてはならない。","tok":[["「"],["主","しゅ"],["は"],["こう"],["仰せられる","おおせられる"],["、"],["主","しゅ"],["の"],["宮","みや"],["の"],["庭","にわ"],["に"],["立ち","たち"],["、"],["わたし"],["が"],["あなた"],["に"],["命じて","めいじて"],["言わせる","いわせる"],["すべて"],["の"],["言葉","ことば"],["を"],["、"],["主","しゅ"],["の"],["宮","みや"],["で"],["礼拝","れいはい"],["する"],["ため"],["に"],["来て","きて"],["いる"],["ユダ"],["の"],["町々","まちまち"],["の"],["人々","ひとびと"],["に"],["告","つげ"],["なさい"],["。"],["ひと言","ひとこと"],["を"],["も"],["言い残して","いいのこして"],["おいて"],["は"],["ならない"],["。"]]},{"verse":3,"text":"彼,かれらが聞,きいて、おのおのその悪,わるい道,みちを離,はなれることがあるかも知,しれない。そのとき、わたしは彼,かれらの行,おこないの悪,わるいために、災,わざわいを彼,かれらに下,くだそうとしたのを思,おもいなおす。","tok":[["彼","かれ"],["ら"],["が"],["聞いて","きいて"],["、"],["おのおの"],["その"],["悪い","わるい"],["道","みち"],["を"],["離れる","はなれる"],["こと"],["が"],["ある"],["か"],["も"],["知れない","しれない"],["。"],["その"],["とき"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["行ない","おこない"],["の"],["悪い","わるい"],["ため"],["に"],["、"],["災","わざわい"],["を"],["彼","かれ"],["ら"],["に"],["下そう","くだそう"],["と"],["した"],["の"],["を"],["思いなおす","おもいなおす"],["。"]]},{"verse":4,"text":"あなたは彼,かれらに言,いいなさい、『主,しゅはこう仰,おおせられる、もしあなたがたがわたしに聞,きき従,したがわず、わたしがあなたがたの前,まえに定,さだめおいた律法,りっぽうを行,おこなわず、","tok":[["あなた"],["は"],["彼","かれ"],["ら"],["に"],["言い","いい"],["なさい"],["、"],["『"],["主","しゅ"],["は"],["こう"],["仰せられる","おおせられる"],["、"],["もし"],["あなた"],["がた"],["が"],["わたし"],["に"],["聞","きき"],["従わず","したがわず"],["、"],["わたし"],["が"],["あなた"],["がた"],["の"],["前","まえ"],["に"],["定め","さだめ"],["おいた"],["律法","りっぽう"],["を"],["行なわず","おこなわず"],["、"]]},{"verse":5,"text":"わたしがあなたがたに、しきりにつかわすわたしのしもべである預言者,よげんしゃの言葉,ことばに聞,きき従,したがわないならば、（あなたがたは聞,きき従,したがわなかったが、）","tok":[["わたし"],["が"],["あなた"],["がた"],["に"],["、"],["しきり"],["に"],["つかわす"],["わたし"],["の"],["しもべ"],["で"],["ある"],["預言者","よげんしゃ"],["の"],["言葉","ことば"],["に"],["聞","きき"],["従わないならば","したがわないならば"],["、"],["（"],["あなた"],["がた"],["は"],["聞","きき"],["従わなかった","したがわなかった"],["が"],["、"],["）"]]},{"verse":6,"text":"わたしはこの宮,みやをシロのようにし、またこの町,まちを地,ちの万国,ばんこくにのろわれるものとする』」。","tok":[["わたし"],["は"],["この"],["宮","みや"],["を"],["シロ"],["の"],["よう"],["に"],["し"],["、"],["また"],["この"],["町","まち"],["を"],["地","ち"],["の"],["万国","ばんこく"],["に"],["のろわれる"],["もの"],["と"],["する"],["』"],["」"],["。"]]},{"verse":7,"text":"祭司,さいしと預言者,よげんしゃおよびすべての民,たみは、エレミヤが主,しゅの宮,みやでこれらの言葉,ことばを語,かたるのを聞,きいた。","tok":[["祭司","さいし"],["と"],["預言者","よげんしゃ"],["および"],["すべて"],["の"],["民","たみ"],["は"],["、"],["エレミヤ"],["が"],["主","しゅ"],["の"],["宮","みや"],["で"],["これ"],["ら"],["の"],["言葉","ことば"],["を"],["語る","かたる"],["の"],["を"],["聞いた","きいた"],["。"]]},{"verse":8,"text":"エレミヤが主,しゅに命,めいじられたすべての言葉,ことばを民,たみに告,つげ終,おわった時,とき、祭司,さいしと預言者,よげんしゃおよび民,たみはみな彼,かれを捕,とらえて言,いった、「あなたは死,しななければならない。","tok":[["エレミヤ"],["が"],["主に","しゅに"],["命じられた","めいじられた"],["すべて"],["の"],["言葉","ことば"],["を"],["民","たみ"],["に"],["告","つげ"],["終わった","おわった"],["時","とき"],["、"],["祭司","さいし"],["と"],["預言者","よげんしゃ"],["および"],["民","たみ"],["は"],["みな"],["彼","かれ"],["を"],["捕らえて","とらえて"],["言った","いった"],["、"],["「"],["あなた"],["は"],["死ななければ","しななければ"],["ならない"],["。"]]},{"verse":9,"text":"なぜあなたは主,しゅの名,なによって預言,よげんし、この宮,みやはシロのようになり、この町,まちは荒,あらされて住,すむ人,ひともなくなるであろうと言,いったのか」と。民,たみはみな主,しゅの宮,みやに集,あつまってエレミヤを取,とり囲,かこんだ。","tok":[["なぜ"],["あなた"],["は"],["主","しゅ"],["の"],["名","な"],["によって"],["預言","よげん"],["し"],["、"],["この"],["宮","みや"],["は"],["シロ"],["の"],["よう"],["に"],["なり"],["、"],["この"],["町","まち"],["は"],["荒されて","あらされて"],["住む","すむ"],["人","ひと"],["も"],["なくなるで"],["あろう"],["と"],["言った","いった"],["の"],["か"],["」"],["と"],["。"],["民","たみ"],["は"],["みな"],["主","しゅ"],["の"],["宮","みや"],["に"],["集まって","あつまって"],["エレミヤ"],["を"],["取囲んだ","とりかこんだ"],["。"]]},{"verse":10,"text":"ユダのつかさたちはこの事,ことを聞,きいて王,おうの宮殿,きゅうでんを出,でて主,しゅの宮,みやに上,のぼり、主,しゅの宮,みやの「新,あたらしい門,もん」の入口,いりぐちに座,ざした。","tok":[["ユダ"],["の"],["つかさ"],["たち"],["は"],["この"],["事","こと"],["を"],["聞いて","きいて"],["王","おう"],["の"],["宮殿","きゅうでん"],["を"],["出て","でて"],["主","しゅ"],["の"],["宮","みや"],["に"],["上り","のぼり"],["、"],["主","しゅ"],["の"],["宮","みや"],["の"],["「"],["新らしい","あたらしい"],["門","もん"],["」"],["の"],["入口","いりぐち"],["に"],["座した","ざした"],["。"]]},{"verse":11,"text":"祭司,さいしと預言者,よげんしゃらは、つかさたちとすべての民,たみに訴,うったえて言,いった、「この人,ひとは死刑,しけいに処,しょすべき者,ものです。あなたがたが自分,じぶんの耳,みみで聞,きかれたように、この町,まちに逆,さからう預言,よげんをしたのです」。","tok":[["祭司","さいし"],["と"],["預言者","よげんしゃ"],["ら"],["は"],["、"],["つかさ"],["たち"],["と"],["すべて"],["の"],["民","たみ"],["に"],["訴て","うったえて"],["言った","いった"],["、"],["「"],["この"],["人","ひと"],["は"],["死刑","しけい"],["に"],["処すべき","しょすべき"],["者","もの"],["です"],["。"],["あなた"],["がた"],["が"],["自分","じぶん"],["の"],["耳","みみ"],["で"],["聞かれた","きかれた"],["よう"],["に"],["、"],["この"],["町","まち"],["に"],["逆らう","さからう"],["預言","よげん"],["を"],["した"],["の"],["です"],["」"],["。"]]},{"verse":12,"text":"その時,ときエレミヤは、つかさたちとすべての民,たみに言,いった、「主,しゅはわたしをつかわし、この宮,みやとこの町,まちにむかって、預言,よげんをさせられたので、そのすべての言葉,ことばをあなたがたは聞,きいた。","tok":[["その"],["時","とき"],["エレミヤ"],["は"],["、"],["つかさ"],["たち"],["と"],["すべて"],["の"],["民","たみ"],["に"],["言った","いった"],["、"],["「"],["主","しゅ"],["は"],["わたし"],["を"],["つかわし"],["、"],["この"],["宮","みや"],["と"],["この"],["町","まち"],["に"],["むかって"],["、"],["預言","よげん"],["を"],["させられた"],["ので"],["、"],["その"],["すべて"],["の"],["言葉","ことば"],["を"],["あなた"],["がた"],["は"],["聞いた","きいた"],["。"]]},{"verse":13,"text":"それで、あなたがたは今,いま、あなたがたの道,みちと行,おこないを改,あらため、あなたがたの神,かみ、主,しゅの声,こえに聞,きき従,したがいなさい。そうするならば主,しゅはあなたがたに災,わざわいを下,くだそうとしたことを思,おもいなおされる。","tok":[["それ"],["で"],["、"],["あなた"],["がた"],["は"],["今","いま"],["、"],["あなた"],["がた"],["の"],["道","みち"],["と"],["行ない","おこない"],["を"],["改","あらため"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["声","こえ"],["に"],["聞","きき"],["従い","したがい"],["なさい"],["。"],["そう"],["するならば"],["主","しゅ"],["は"],["あなた"],["がた"],["に"],["災","わざわい"],["を"],["下そう","くだそう"],["と"],["した"],["こと"],["を"],["思いなおされる","おもいなおされる"],["。"]]},{"verse":14,"text":"見,みよ、わたしはあなたがたの手,ての中,なかにある。あなたがたの目,めに、良,よいと見,みえ、正,ただしいと思,おもうことをわたしに行,おこなうがよい。","tok":[["見よ","みよ"],["、"],["わたし"],["は"],["あなた"],["がた"],["の"],["手","て"],["の"],["中","なか"],["に"],["ある"],["。"],["あなた"],["がた"],["の"],["目","め"],["に"],["、"],["良い","よい"],["と"],["見え","みえ"],["、"],["正い","ただしい"],["と"],["思う","おもう"],["こと"],["を"],["わたし"],["に"],["行なう","おこなう"],["が"],["よい"],["。"]]},{"verse":15,"text":"ただ明,あきらかにこのことを知,しっておきなさい。もしあなたがたがわたしを殺,ころすならば、罪,つみなき者,ものの血,ちはあなたがたの身,みと、この町,まちと、その住民,じゅうみんとに帰,きする。まことに主,しゅがわたしをつかわして、このすべての言葉,ことばをあなたがたの耳,みみに、告,つげさせられたからである」。","tok":[["ただ"],["明か","あきらか"],["に"],["この"],["こと"],["を"],["知って","しって"],["おき"],["なさい"],["。"],["もし"],["あなた"],["がた"],["が"],["わたし"],["を"],["殺ろすならば","ころすならば"],["、"],["罪","つみ"],["なき"],["者","もの"],["の"],["血","ち"],["は"],["あなた"],["がた"],["の"],["身","み"],["と"],["、"],["この"],["町","まち"],["と"],["、"],["その"],["住民","じゅうみん"],["と"],["に"],["帰する","きする"],["。"],["まこと"],["に"],["主","しゅ"],["が"],["わたし"],["を"],["つかわして"],["、"],["この"],["すべて"],["の"],["言葉","ことば"],["を"],["あなた"],["がた"],["の"],["耳","みみ"],["に"],["、"],["告","つげ"],["させられた"],["から"],["で"],["ある"],["」"],["。"]]},{"verse":16,"text":"つかさたちと、すべての民,たみとは、祭司,さいしと預言者,よげんしゃに言,いった、「この人,ひとは死刑,しけいに処,しょすべき者,ものではない。われわれの神,かみ、主,しゅの名,なによってわれわれに語,かたったのである」。","tok":[["つかさ"],["たち"],["と"],["、"],["すべて"],["の"],["民","たみ"],["と"],["は"],["、"],["祭司","さいし"],["と"],["預言者","よげんしゃ"],["に"],["言った","いった"],["、"],["「"],["この"],["人","ひと"],["は"],["死刑","しけい"],["に"],["処すべき","しょすべき"],["者","もの"],["で"],["は"],["ない"],["。"],["われわれ"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["名","な"],["によって"],["われわれ"],["に"],["語った","かたった"],["ので"],["ある"],["」"],["。"]]},{"verse":17,"text":"その時,ときこの地,ちの長老,ちょうろうたち数人,すうにんが立,たって、そこに集,あつまっているすべての者,ものに告,つげて言,いった、","tok":[["その"],["時","とき"],["この"],["地","ち"],["の"],["長老","ちょうろう"],["たち"],["数人","すうにん"],["が"],["立って","たって"],["、"],["そこ"],["に"],["集まって","あつまって"],["いる"],["すべて"],["の"],["者","もの"],["に"],["告","つげ"],["て"],["言った","いった"],["、"]]},{"verse":18,"text":"「ユダの王,おうヒゼキヤの世,よに、モレシテびとミカはユダのすべての民,たみに預言,よげんして言,いった、『万軍,ばんぐんの主,しゅはこう仰,おおせられる、シオンは畑,はたけのように耕,たがやされ、エルサレムは石塚,いしづかとなり、宮,みやの山,やまは木,きのおい茂,しげる高,たかい所,ところとなる』。","tok":[["「"],["ユダ"],["の"],["王","おう"],["ヒゼキヤ"],["の"],["世","よ"],["に"],["、"],["モレシテ"],["び"],["と"],["ミカ"],["は"],["ユダ"],["の"],["すべて"],["の"],["民","たみ"],["に"],["預言","よげん"],["して"],["言った","いった"],["、"],["『"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["こう"],["仰せられる","おおせられる"],["、"],["シオン"],["は"],["畑","はたけ"],["の"],["よう"],["に"],["耕やされ","たがやされ"],["、"],["エルサレム"],["は"],["石塚","いしづか"],["と"],["なり"],["、"],["宮","みや"],["の"],["山","やま"],["は"],["木","き"],["の"],["おい"],["茂","しげる"],["高い","たかい"],["所","ところ"],["と"],["なる"],["』"],["。"]]},{"verse":19,"text":"ユダの王,おうヒゼキヤと、すべてのユダの人,ひとは彼,かれを殺,ころそうとしたことがあろうか。ヒゼキヤは主,しゅを恐,おそれ、主,しゅの恵,めぐみを求,もとめたので、主,しゅは彼,かれらに災,わざわいを下,くだすとお告,つげになったのを思,おもいなおされたではないか。しかし、われわれは、自分,じぶんの身,みに大,おおきな災,わざわいを招,まねこうとしている」。","tok":[["ユダ"],["の"],["王","おう"],["ヒゼキヤ"],["と"],["、"],["すべて"],["の"],["ユダ"],["の"],["人","ひと"],["は"],["彼","かれ"],["を"],["殺そう","ころそう"],["と"],["した"],["こと"],["が"],["あろう"],["か"],["。"],["ヒゼキヤ"],["は"],["主","しゅ"],["を"],["恐","おそれ"],["、"],["主","しゅ"],["の"],["恵","めぐみ"],["を"],["求めた","もとめた"],["ので"],["、"],["主","しゅ"],["は"],["彼","かれ"],["ら"],["に"],["災","わざわい"],["を"],["下す","くだす"],["と"],["お告","おつげ"],["に"],["なった"],["の"],["を"],["思いなおされたで","おもいなおされたで"],["は"],["ない"],["か"],["。"],["しかし"],["、"],["われわれ"],["は"],["、"],["自分","じぶん"],["の"],["身","み"],["に"],["大きな","おおきな"],["災","わざわい"],["を"],["招こう","まねこう"],["として"],["いる"],["」"],["。"]]},{"verse":20,"text":"主,しゅの名,なによって預言,よげんした人,ひとがほかにもあった。すなわちキリアテ・ヤリムのシマヤの子,こウリヤである。彼,かれはエレミヤとおなじような言葉,ことばをもって、この町,まちとこの地,ちにむかって預言,よげんした。","tok":[["主","しゅ"],["の"],["名","な"],["によって"],["預言","よげん"],["した"],["人","ひと"],["が"],["ほか"],["に"],["も"],["あった"],["。"],["すなわち"],["キリアテ"],["・"],["ヤリム"],["の"],["シマヤ"],["の"],["子","こ"],["ウリヤ"],["で"],["ある"],["。"],["彼","かれ"],["は"],["エレミヤ"],["と"],["おなじ"],["よう"],["な"],["言葉","ことば"],["を"],["もって"],["、"],["この"],["町","まち"],["と"],["この"],["地","ち"],["に"],["むかって"],["預言","よげん"],["した"],["。"]]},{"verse":21,"text":"エホヤキム王,おうと、そのすべての勇士,ゆうしと、すべてのつかさたちはその言葉,ことばを聞,きいた。そして王,おうは彼,かれを殺,ころそうと思,おもったが、ウリヤはこれを聞,きいて恐,おそれ、エジプトに逃,にげて行,いったので、","tok":[["エホヤキム"],["王","おう"],["と"],["、"],["その"],["すべて"],["の"],["勇士","ゆうし"],["と"],["、"],["すべて"],["の"],["つかさ"],["たち"],["は"],["その"],["言葉","ことば"],["を"],["聞いた","きいた"],["。"],["そして"],["王","おう"],["は"],["彼","かれ"],["を"],["殺そう","ころそう"],["と"],["思った","おもった"],["が"],["、"],["ウリヤ"],["は"],["これ"],["を"],["聞いて","きいて"],["恐","おそれ"],["、"],["エジプト"],["に"],["逃て","にげて"],["行った","いった"],["ので"],["、"]]},{"verse":22,"text":"エホヤキム王,おうは人,ひとをエジプトにつかわした。すなわちアクボルの子,こエルナタンと他,たの数,すう名,めいの人,ひとを、エジプトにつかわした。","tok":[["エホヤキム"],["王","おう"],["は"],["人","ひと"],["を"],["エジプト"],["に"],["つかわした"],["。"],["すなわち"],["アクボル"],["の"],["子","こ"],["エルナタン"],["と"],["他","た"],["の"],["数","すう"],["名","めい"],["の"],["人","ひと"],["を"],["、"],["エジプト"],["に"],["つかわした"],["。"]]},{"verse":23,"text":"彼,かれらはウリヤをエジプトから引,ひき出,だし、エホヤキム王,おうのもとに連,つれてきたので、王,おうはつるぎをもって彼,かれを殺,ころし、その死体,したいを共同,きょうどう墓地,ぼちに捨,すてさせた。","tok":[["彼","かれ"],["ら"],["は"],["ウリヤ"],["を"],["エジプト"],["から"],["引出し","ひきだし"],["、"],["エホヤキム"],["王","おう"],["の"],["もと"],["に"],["連れて","つれて"],["きた"],["ので"],["、"],["王","おう"],["は"],["つるぎ"],["を"],["もって"],["彼","かれ"],["を"],["殺ろし","ころし"],["、"],["その"],["死体","したい"],["を"],["共同","きょうどう"],["墓地","ぼち"],["に"],["捨てさせた","すてさせた"],["。"]]},{"verse":24,"text":"しかしシャパンの子,こアヒカムはエレミヤを助,たすけ、民,たみの手,てに渡,わたされて殺,ころされることのないようにした。","tok":[["しかし"],["シャパン"],["の"],["子","こ"],["アヒカム"],["は"],["エレミヤ"],["を"],["助け","たすけ"],["、"],["民","たみ"],["の"],["手","て"],["に"],["渡されて","わたされて"],["殺ろされる","ころされる"],["こと"],["の"],["ない"],["よう"],["に"],["した"],["。"]]}]
[{"verse":1,"text":"主,しゅはわたしに言,いわれた、「たといモーセとサムエルとがわたしの前,まえに立,たっても、わたしの心,こころはこの民,たみを顧,かえりみない。彼,かれらをわたしの前,まえから追,おい出,だし、ここを去,さらせよ。","tok":[["主","しゅ"],["は"],["わたし"],["に"],["言われた","いわれた"],["、"],["「"],["たとい"],["モーセ"],["と"],["サムエル"],["と"],["が"],["わたし"],["の"],["前","まえ"],["に"],["立って","たって"],["も"],["、"],["わたし"],["の"],["心","こころ"],["は"],["この"],["民","たみ"],["を"],["顧ない","かえりみない"],["。"],["彼","かれ"],["ら"],["を"],["わたし"],["の"],["前","まえ"],["から"],["追い出し","おいだし"],["、"],["ここ"],["を"],["去らせ","さらせ"],["よ"],["。"]]},{"verse":2,"text":"もし彼,かれらが、『われわれはどこに行,いけばよいのか』とあなたに尋,たずねるならば、彼,かれらに言,いいなさい、『主,しゅはこう仰,おおせられる、疫病,えきびょうに定,さだめられた者,ものは疫病,えきびょうに、つるぎに定,さだめられた者,ものはつるぎに、ききんに定,さだめられた者,ものはききんに、とりこに定,さだめられた者,ものはとりこに行,いく』。","tok":[["もし"],["彼","かれ"],["ら"],["が"],["、"],["『"],["われわれ"],["は"],["どこ"],["に"],["行けば","いけば"],["よい"],["の"],["か"],["』"],["と"],["あなた"],["に"],["尋ねるならば","たずねるならば"],["、"],["彼","かれ"],["ら"],["に"],["言い","いい"],["なさい"],["、"],["『"],["主","しゅ"],["は"],["こう"],["仰せられる","おおせられる"],["、"],["疫病","えきびょう"],["に"],["定められた","さだめられた"],["者","もの"],["は"],["疫病","えきびょう"],["に"],["、"],["つるぎ"],["に"],["定められた","さだめられた"],["者","もの"],["は"],["つるぎ"],["に"],["、"],["ききん"],["に"],["定められた","さだめられた"],["者","もの"],["は"],["ききん"],["に"],["、"],["とりこ"],["に"],["定められた","さだめられた"],["者","もの"],["は"],["とりこ"],["に"],["行く","いく"],["』"],["。"]]},{"verse":3,"text":"主,しゅは仰,おおせられる、わたしは四つの物,ものをもって彼,かれらを罰,ばっする。すなわち、つるぎをもって殺,ころし、犬,いぬをもってかませ、空,そらの鳥,とりと地,ちの獣,けものをもって食,くい滅,ほろぼさせる。","tok":[["主","しゅ"],["は"],["仰せられる","おおせられる"],["、"],["わたし"],["は"],["四","よん"],["つ"],["の"],["物","もの"],["を"],["もって"],["彼","かれ"],["ら"],["を"],["罰する","ばっする"],["。"],["すなわち"],["、"],["つるぎ"],["を"],["もって"],["殺ろし","ころし"],["、"],["犬","いぬ"],["を"],["もって"],["かませ"],["、"],["空","そら"],["の"],["鳥","とり"],["と"],["地","ち"],["の"],["獣","けもの"],["を"],["もって"],["食い滅ぼさせる","くいほろぼさせる"],["。"]]},{"verse":4,"text":"またユダの王,おうヒゼキヤの子,こマナセが、エルサレムでした行,おこないのゆえに、わたしは彼,かれらを地,ちのすべての国,くにが見,みて恐,おそれおののくものとする。","tok":[["また"],["ユダ"],["の"],["王","おう"],["ヒゼキヤ"],["の"],["子","こ"],["マナセ"],["が"],["、"],["エルサレム"],["でした"],["行ない","おこない"],["の"],["ゆえ"],["に"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["地","ち"],["の"],["すべて"],["の"],["国","くに"],["が"],["見て","みて"],["恐れおののく","おそれおののく"],["もの"],["と"],["する"],["。"]]},{"verse":5,"text":"エルサレムよ、だれがあなたをあわれむであろうか。だれがあなたのために嘆,なげくであろうか。だれがふり返,かえって、あなたの安否,あんぴを問,とうであろうか。","tok":[["エルサレム"],["よ"],["、"],["だれ"],["が"],["あなた"],["を"],["あわれむで"],["あろう"],["か"],["。"],["だれ"],["が"],["あなた"],["の"],["ため"],["に"],["嘆くで","なげくで"],["あろう"],["か"],["。"],["だれ"],["が"],["ふり返って","ふりかえって"],["、"],["あなた"],["の"],["安否","あんぴ"],["を"],["問うで","とうで"],["あろう"],["か"],["。"]]},{"verse":6,"text":"主,しゅは言,いわれる、あなたはわたしを捨,すてた。そしてますます退,しりぞいて行,いく。それゆえ、わたしは手,てを伸,のべてあなたを滅,ほろぼした。わたしはあわれむことには飽,あきた。","tok":[["主","しゅ"],["は"],["言われる","いわれる"],["、"],["あなた"],["は"],["わたし"],["を"],["捨てた","すてた"],["。"],["そして"],["ますます"],["退ぞいて","しりぞいて"],["行く","いく"],["。"],["それ"],["ゆえ"],["、"],["わたし"],["は"],["手","て"],["を"],["伸べて","のべて"],["あなた"],["を"],["滅ぼした","ほろぼした"],["。"],["わたし"],["は"],["あわれむ"],["こと"],["に"],["は"],["飽きた","あきた"],["。"]]},{"verse":7,"text":"わたしはこの地,ちの門,もんで、箕,みので彼,かれらをあおぎ分,わけた。彼,かれらがその道,みちを離,はなれなかったので、わたしは彼,かれらの子,こを奪,うばい、わが民,たみを滅,ほろぼした。","tok":[["わたし"],["は"],["この"],["地","ち"],["の"],["門","もん"],["で"],["、"],["箕","み"],["ので"],["彼","かれ"],["ら"],["を"],["あおぎ"],["分けた","わけた"],["。"],["彼","かれ"],["ら"],["が"],["その"],["道","みち"],["を"],["離れなかった","はなれなかった"],["ので"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["子","こ"],["を"],["奪い","うばい"],["、"],["わが"],["民","たみ"],["を"],["滅ぼした","ほろぼした"],["。"]]},{"verse":8,"text":"わたしは彼,かれらの寡婦,かふの数,かずを浜,はまべの砂,すなよりも多,おおくした。わたしは真昼,まひるに、滅,ほろぼす者,ものを連,つれてきて、若者,わかものらの母,ははたちをせめ、驚,おどろきと恐,おそれを、にわかに母,ははたちにおこした。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["の"],["寡婦","かふ"],["の"],["数","かず"],["を"],["浜べ","はまべ"],["の"],["砂","すな"],["より"],["も"],["多く","おおく"],["した"],["。"],["わたし"],["は"],["真昼","まひる"],["に"],["、"],["滅ぼす","ほろぼす"],["者","もの"],["を"],["連れて","つれて"],["きて"],["、"],["若者","わかもの"],["ら"],["の"],["母","はは"],["たち"],["を"],["せめ"],["、"],["驚","おどろき"],["と"],["恐","おそれ"],["を"],["、"],["にわか"],["に"],["母","はは"],["たち"],["に"],["おこした"],["。"]]},{"verse":9,"text":"七人,にんの子,こを産,うんだ女,おんなは、弱,よわり衰,おとろえて、息,いき絶,たえ、まだ昼,ひるであったが、彼女,かのじょの日,ひは没,ぼっした。彼女,かのじょは恥,はじ、うろたえた。その残,のこりの者,ものは、これを敵,てきのつるぎに渡,わたすと主,しゅは言,いわれる」。","tok":[["七人","にん"],["の"],["子","こ"],["を"],["産んだ","うんだ"],["女","おんな"],["は"],["、"],["弱り","よわり"],["衰えて","おとろえて"],["、"],["息","いき"],["絶え","たえ"],["、"],["まだ"],["昼","ひる"],["で"],["あった"],["が"],["、"],["彼女","かのじょ"],["の"],["日","ひ"],["は"],["没した","ぼっした"],["。"],["彼女","かのじょ"],["は"],["恥","はじ"],["、"],["うろたえた"],["。"],["その"],["残り","のこり"],["の"],["者","もの"],["は"],["、"],["これ"],["を"],["敵","てき"],["の"],["つるぎ"],["に"],["渡す","わたす"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["」"],["。"]]},{"verse":10,"text":"ああ、わたしはわざわいだ。わが母,ははよ、あなたは、なぜ、わたしを産,うんだのか。全国,ぜんこくの人,ひとはわたしと争,あらそい、わたしを攻,せめる。わたしは人,ひとに貸,かしたこともなく、人,ひとに借,かりたこともないのに、皆,みなわたしをのろう。","tok":[["ああ"],["、"],["わたし"],["は"],["わざわい"],["だ"],["。"],["わが"],["母","はは"],["よ"],["、"],["あなた"],["は"],["、"],["なぜ"],["、"],["わたし"],["を"],["産","うんだ"],["の"],["か"],["。"],["全国","ぜんこく"],["の"],["人","ひと"],["は"],["わたし"],["と"],["争い","あらそい"],["、"],["わたし"],["を"],["攻める","せめる"],["。"],["わたし"],["は"],["人","ひと"],["に"],["貸","かし"],["た"],["こと"],["も"],["なく"],["、"],["人","ひと"],["に"],["借","かり"],["た"],["こと"],["も"],["ない"],["のに"],["、"],["皆","みな"],["わたし"],["を"],["のろう"],["。"]]},{"verse":11,"text":"主,しゅよ、もしわたしが彼,かれらの幸福,こうふくをあなたに祈,いのり求,もとめず、また敵,てきのため、その悩,なやみのときと、災,わざわいのときに、わたしがあなたにとりなしをしなかったのであれば、彼,かれらののろいも、やむをえないでしょう。","tok":[["主","しゅ"],["よ"],["、"],["もし"],["わたし"],["が"],["彼","かれ"],["ら"],["の"],["幸福","こうふく"],["を"],["あなた"],["に"],["祈","いのり"],["求めず","もとめず"],["、"],["また"],["敵","てき"],["の"],["ため"],["、"],["その"],["悩み","なやみ"],["の"],["とき"],["と"],["、"],["災","わざわい"],["の"],["とき"],["に"],["、"],["わたし"],["が"],["あなた"],["に"],["とり"],["なし"],["を"],["しなかった"],["ので"],["あれば"],["、"],["彼","かれ"],["ら"],["の"],["のろい"],["も"],["、"],["やむ"],["を"],["えないでしょう"],["。"]]},{"verse":12,"text":"人,ひとは鉄,てつを、北,きたからくる鉄,てつや青銅,せいどうを砕,くだくことができましょうか。","tok":[["人","ひと"],["は"],["鉄","てつ"],["を"],["、"],["北","きた"],["から"],["くる"],["鉄","てつ"],["や"],["青銅","せいどう"],["を"],["砕く","くだく"],["こと"],["が"],["できましょう"],["か"],["。"]]},{"verse":13,"text":"「わたしはあなたの富,とみと宝,たからを、ぶんどり物,ものとして他,ほかに与,あたえる。代価,だいかを受,うけることはできない。それはあなたのすべての罪,つみによるので、領域,りょういき内,ないのいたる所,ところにこのことが起,おこる。","tok":[["「"],["わたし"],["は"],["あなた"],["の"],["富","とみ"],["と"],["宝","たから"],["を"],["、"],["ぶんどり"],["物","もの"],["として"],["他","ほか"],["に"],["与える","あたえる"],["。"],["代価","だいか"],["を"],["受る","うける"],["こと"],["は"],["できない"],["。"],["それ"],["は"],["あなた"],["の"],["すべて"],["の"],["罪","つみ"],["に"],["よる"],["ので"],["、"],["領域内","りょういきない"],["の"],["いたる所","いたるところ"],["に"],["この"],["こと"],["が"],["起こる","おこる"],["。"]]},{"verse":14,"text":"わたしはあなたの知,しらない地,ちで、あなたの敵,てきに仕,つかえさせる。わたしの怒,いかりによって火,ひは点,てんじられ、いつまでも燃,もえ続,つづけるからである」。","tok":[["わたし"],["は"],["あなた"],["の"],["知らない","しらない"],["地","ち"],["で"],["、"],["あなた"],["の"],["敵","てき"],["に"],["仕えさせる","つかえさせる"],["。"],["わたし"],["の"],["怒り","いかり"],["によって"],["火","ひ"],["は"],["点じられ","てんじられ"],["、"],["いつ"],["まで"],["も"],["燃え","もえ"],["続ける","つづける"],["から"],["で"],["ある"],["」"],["。"]]},{"verse":15,"text":"主,しゅよ、あなたは知,しっておられます。わたしを覚,おぼえ、わたしを顧,かえりみてください。わたしを迫害,はくがいする者,ものに、あだを返,かえし、あなたの寛容,かんようによって、わたしを取,とり去,さらないでください。わたしがあなたのために、はずかしめを受,うけるのを知,しってください。","tok":[["主","しゅ"],["よ"],["、"],["あなた"],["は"],["知って","しって"],["おられます"],["。"],["わたし"],["を"],["覚え","おぼえ"],["、"],["わたし"],["を"],["顧て","かえりみて"],["ください"],["。"],["わたし"],["を"],["迫害","はくがい"],["する"],["者","もの"],["に"],["、"],["あだ"],["を"],["返","かえし"],["、"],["あなた"],["の"],["寛容","かんよう"],["によって"],["、"],["わたし"],["を"],["取去らないで","とりさらないで"],["ください"],["。"],["わたし"],["が"],["あなた"],["の"],["ため"],["に"],["、"],["はずかしめ"],["を"],["受る","うける"],["の"],["を"],["知って","しって"],["ください"],["。"]]},{"verse":16,"text":"わたしはみ言葉,ことばを与,あたえられて、それを食,たべました。み言葉,ことばは、わたしに喜,よろこびとなり、心,こころの楽,たのしみとなりました。万軍,ばんぐんの神,かみ、主,しゅよ、わたしは、あなたの名,なをもってとなえられている者,ものです。","tok":[["わたし"],["は"],["み言葉","みことば"],["を"],["与えられて","あたえられて"],["、"],["それ"],["を"],["食べました","たべました"],["。"],["み言葉","みことば"],["は"],["、"],["わたし"],["に"],["喜こび","よろこび"],["と"],["なり"],["、"],["心","こころ"],["の"],["楽み","たのしみ"],["と"],["なりました"],["。"],["万","まん"],["軍","ぐん"],["の"],["神","かみ"],["、"],["主","しゅ"],["よ"],["、"],["わたし"],["は"],["、"],["あなた"],["の"],["名","な"],["を"],["もって"],["となえられて"],["いる"],["者","もの"],["です"],["。"]]},{"verse":17,"text":"わたしは笑,わらいさざめく人,ひとのつどいにすわることなく、また喜,よろこぶことをせず、ただひとりですわっていました。あなたの手,てがわたしの上,うえにあり、あなたが憤,いきどおりをもってわたしを満,みたされたからです。","tok":[["わたし"],["は"],["笑","わらい"],["さざめく"],["人","ひと"],["の"],["つどい"],["に"],["すわる"],["こと"],["なく"],["、"],["また"],["喜こぶ","よろこぶ"],["こと"],["を"],["せず"],["、"],["ただ"],["ひとり"],["で"],["すわって"],["いました"],["。"],["あなた"],["の"],["手","て"],["が"],["わたし"],["の"],["上","うえ"],["に"],["あり"],["、"],["あなた"],["が"],["憤り","いきどおり"],["を"],["もって"],["わたし"],["を"],["満たされた","みたされた"],["から"],["です"],["。"]]},{"verse":18,"text":"どうしてわたしの痛,いたみは止,とまらず、傷,きずは重,おもくて、なおらないのですか。あなたはわたしにとって、水,みずがなくて人,ひとを欺,あざむく谷川,たにがわのようになられるのですか。","tok":[["どう"],["して"],["わたし"],["の"],["痛み","いたみ"],["は"],["止まらず","とまらず"],["、"],["傷","きず"],["は"],["重くて","おもくて"],["、"],["なおらない"],["の"],["です"],["か"],["。"],["あなた"],["は"],["わたし"],["にとって"],["、"],["水","みず"],["が"],["なくて"],["人","ひと"],["を"],["欺く","あざむく"],["谷川","たにがわ"],["の"],["よう"],["に"],["なられる"],["の"],["です"],["か"],["。"]]},{"verse":19,"text":"それゆえ主,しゅはこう仰,おおせられる、「もしあなたが帰,かえってくるならば、もとのようにして、わたしの前,まえに立,たたせよう。もしあなたが、つまらないことを言,いうのをやめて、貴重,きちょうなことを言,いうならば、わたしの口,くちのようになる。彼,かれらはあなたの所,ところに帰,かえってくる。しかしあなたが彼,かれらの所,ところに帰,かえるのではない。","tok":[["それ"],["ゆえ"],["主","しゅ"],["は"],["こう"],["仰せられる","おおせられる"],["、"],["「"],["もし"],["あなた"],["が"],["帰えって","かえって"],["くるならば"],["、"],["もと"],["の"],["よう"],["に"],["して"],["、"],["わたし"],["の"],["前","まえ"],["に"],["立たせよう","たたせよう"],["。"],["もし"],["あなた"],["が"],["、"],["つまらない"],["こと"],["を"],["言う","いう"],["の"],["を"],["やめて"],["、"],["貴重","きちょう"],["な"],["こと"],["を"],["言うならば","いうならば"],["、"],["わたし"],["の"],["口","くち"],["の"],["よう"],["に"],["なる"],["。"],["彼","かれ"],["ら"],["は"],["あなた"],["の"],["所","ところ"],["に"],["帰えって","かえって"],["くる"],["。"],["しかし"],["あなた"],["が"],["彼","かれ"],["ら"],["の"],["所","ところ"],["に"],["帰える","かえる"],["ので"],["は"],["ない"],["。"]]},{"verse":20,"text":"わたしはあなたをこの民,たみの前,まえに、堅固,けんごな青銅,せいどうの城壁,じょうへきにする。彼,かれらがあなたを攻,せめても、あなたに勝,かつことはできない。わたしがあなたと共,ともにいて、あなたを助,たすけ、あなたを救,すくうからであると、主,しゅは言,いわれる。","tok":[["わたし"],["は"],["あなた"],["を"],["この"],["民","たみ"],["の"],["前","まえ"],["に"],["、"],["堅固","けんご"],["な"],["青銅","せいどう"],["の"],["城壁","じょうへき"],["に"],["する"],["。"],["彼","かれ"],["ら"],["が"],["あなた"],["を"],["攻めて","せめて"],["も"],["、"],["あなた"],["に"],["勝つ","かつ"],["こと"],["は"],["できない"],["。"],["わたし"],["が"],["あなた"],["と"],["共","とも"],["に"],["いて"],["、"],["あなた"],["を"],["助け","たすけ"],["、"],["あなた"],["を"],["救う","すくう"],["から"],["で"],["ある"],["と"],["、"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":21,"text":"わたしはあなたを悪人,あくにんの手,てから救,すくい、無慈悲,むじひな人,ひとの手,てからあがなう」。","tok":[["わたし"],["は"],["あなた"],["を"],["悪人","あくにん"],["の"],["手","て"],["から"],["救い","すくい"],["、"],["無慈悲","むじひ"],["な"],["人","ひと"],["の"],["手","て"],["から"],["あがなう"],["」"],["。"]]}]
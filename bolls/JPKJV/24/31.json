[{"verse":1,"text":"「主,しゅは言,いわれる、その時,ときわたしはイスラエルの全部,ぜんぶ族,ぞくの神,かみとなり、彼,かれらはわたしの民,たみとなる」。","tok":[["「"],["主","しゅ"],["は"],["言われる","いわれる"],["、"],["その"],["時","とき"],["わたし"],["は"],["イスラエル"],["の"],["全部族","ぜんぶぞく"],["の"],["神","かみ"],["と"],["なり"],["、"],["彼","かれ"],["ら"],["は"],["わたし"],["の"],["民","たみ"],["と"],["なる"],["」"],["。"]]},{"verse":2,"text":"主,しゅはこう言,いわれる、「つるぎをのがれて生,いき残,のこった民,たみは、荒野,あらので恵,めぐみを得,えた。イスラエルが安息,あんそくを求,もとめた時,とき、","tok":[["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["「"],["つるぎ"],["を"],["のがれて"],["生き残った","いきのこった"],["民","たみ"],["は"],["、"],["荒野","あらの"],["で"],["恵","めぐみ"],["を"],["得た","えた"],["。"],["イスラエル"],["が"],["安息","あんそく"],["を"],["求めた","もとめた"],["時","とき"],["、"]]},{"verse":3,"text":"主,しゅは遠,とおくから彼,かれに現,あらわれた。わたしは限,かぎりなき愛,あいをもってあなたを愛,あいしている。それゆえ、わたしは絶,たえずあなたに真実,しんじつをつくしてきた。","tok":[["主","しゅ"],["は"],["遠く","とおく"],["から"],["彼","かれ"],["に"],["現われた","あらわれた"],["。"],["わたし"],["は"],["限","かぎり"],["なき"],["愛","あい"],["を"],["もって"],["あなた"],["を"],["愛して","あいして"],["いる"],["。"],["それ"],["ゆえ"],["、"],["わたし"],["は"],["絶えず","たえず"],["あなた"],["に"],["真実","しんじつ"],["を"],["つくして"],["きた"],["。"]]},{"verse":4,"text":"イスラエルのおとめよ、再,ふたたびわたしはあなたを建,たてる、あなたは建,たてられる。あなたは再,ふたたび鼓,つづみをもって身,みを飾,かざり、出,でて行,いって、喜,よろこび楽,たのしむ者,ものと共,ともに踊,おどる。","tok":[["イスラエル"],["の"],["おとめ"],["よ"],["、"],["再び","ふたたび"],["わたし"],["は"],["あなた"],["を"],["建てる","たてる"],["、"],["あなた"],["は"],["建てられる","たてられる"],["。"],["あなた"],["は"],["再び","ふたたび"],["鼓","つづみ"],["を"],["もって"],["身","み"],["を"],["飾","かざり"],["、"],["出て","でて"],["行って","いって"],["、"],["喜こび","よろこび"],["楽しむ","たのしむ"],["者","もの"],["と"],["共","とも"],["に"],["踊る","おどる"],["。"]]},{"verse":5,"text":"またあなたはぶどうの木,きをサマリヤの山,やまに植,うえる。植,うえる者,ものは、植,うえてその実,みを食,たべることができる。","tok":[["また"],["あなた"],["は"],["ぶどう"],["の"],["木","き"],["を"],["サマリヤ"],["の"],["山","やま"],["に"],["植える","うえる"],["。"],["植える","うえる"],["者","もの"],["は"],["、"],["植えて","うえて"],["その"],["実","み"],["を"],["食べる","たべる"],["こと"],["が"],["できる"],["。"]]},{"verse":6,"text":"見守,みまもる者,ものがエフライムの山,やまの上,うえに立,たって呼,よばわる日,ひが来,くる。『立,たって、シオンに上,のぼり、われわれの神,かみ、主,しゅに、もうでよう』と」。","tok":[["見","み"],["守者","守もの"],["が"],["エフライム"],["の"],["山","やま"],["の"],["上","うえ"],["に"],["立って","たって"],["呼ばわる","よばわる"],["日","ひ"],["が"],["来る","くる"],["。"],["『"],["立って","たって"],["、"],["シオン"],["に"],["上り","のぼり"],["、"],["われわれ"],["の"],["神","かみ"],["、"],["主に","しゅに"],["、"],["もう"],["で"],["よう"],["』"],["と"],["」"],["。"]]},{"verse":7,"text":"主,しゅはこう仰,おおせられる、「ヤコブのために喜,よろこんで声,こえ高,たかく歌,うたい、万国,ばんこくのかしらのために叫,さけび声,ごえをあげよ。告,つげ示,しめし、ほめたたえて言,いえ、『主,しゅはその民,たみイスラエルの残,のこりの者,ものを救,すくわれた』と。","tok":[["主","しゅ"],["は"],["こう"],["仰せられる","おおせられる"],["、"],["「"],["ヤコブ"],["の"],["ため"],["に"],["喜こんで","よろこんで"],["声","こえ"],["高かく","たかく"],["歌い","うたい"],["、"],["万国","ばんこく"],["の"],["かしら"],["の"],["ため"],["に"],["叫声","さけびごえ"],["を"],["あげ"],["よ"],["。"],["告","つげ"],["示めし","しめし"],["、"],["ほめたたえて"],["言え","いえ"],["、"],["『"],["主","しゅ"],["は"],["その"],["民","た"],["みイスラエル"],["の"],["残り","のこり"],["の"],["者","もの"],["を"],["救われた","すくわれた"],["』"],["と"],["。"]]},{"verse":8,"text":"見,みよ、わたしは彼,かれらを北,きたの国,くにから連,つれ帰,かえり、彼,かれらを地,ちの果,はてから集,あつめる。彼,かれらのうちには、盲人,もうじんやあしなえ、妊婦,にんぷ、産婦,さんぷも共,ともにいる。彼,かれらは大,おおきな群,むれとなって、ここに帰,かえってくる。","tok":[["見よ","みよ"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["北","きた"],["の"],["国","くに"],["から"],["連れ","つれ"],["帰えり","かえり"],["、"],["彼","かれ"],["ら"],["を"],["地","ち"],["の"],["果て","はて"],["から"],["集める","あつめる"],["。"],["彼","かれ"],["ら"],["の"],["うち"],["に"],["は"],["、"],["盲人","もうじん"],["やあ"],["しなえ"],["、"],["妊婦","にんぷ"],["、"],["産婦","さんぷ"],["も"],["共","とも"],["に"],["いる"],["。"],["彼","かれ"],["ら"],["は"],["大きな","おおきな"],["群れ","むれ"],["と"],["なって"],["、"],["ここ"],["に"],["帰えって","かえって"],["くる"],["。"]]},{"verse":9,"text":"彼,かれらは泣,なき悲,かなしんで帰,かえってくる。わたしは慰,なぐさめながら彼,かれらを導,みちびき帰,かえる。彼,かれらがつまずかないように、まっすぐな道,みちにより、水,みずの流,ながれのそばを通,とおらせる。それは、わたしがイスラエルの父,ちちであり、エフライムはわたしの長子,ちょうしだからである。","tok":[["彼","かれ"],["ら"],["は"],["泣","なき"],["悲しんで","かなしんで"],["帰えって","かえって"],["くる"],["。"],["わたし"],["は"],["慰さめ","なぐさめ"],["ながら"],["彼","かれ"],["ら"],["を"],["導き","みちびき"],["帰える","かえる"],["。"],["彼","かれ"],["ら"],["が"],["つまずかない"],["よう"],["に"],["、"],["まっすぐ"],["な"],["道","みち"],["に"],["より"],["、"],["水","みず"],["の"],["流れ","ながれ"],["の"],["そば"],["を"],["通らせる","とおらせる"],["。"],["それ"],["は"],["、"],["わたし"],["が"],["イスラエル"],["の"],["父","ちち"],["で"],["あり"],["、"],["エフライム"],["は"],["わたし"],["の"],["長子","ちょうし"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":10,"text":"万国,ばんこくの民,たみよ、あなたがたは主,しゅの言葉,ことばを聞,きき、これを遠,とおい、海沿,うみぞいの地,ちに示,しめして言,いいなさい、『イスラエルを散,ちらした者,ものがこれを集,あつめられる。牧者,ぼくしゃがその群,むれを守,まもるようにこれを守,まもられる』と。","tok":[["万国","ばんこく"],["の"],["民","たみ"],["よ"],["、"],["あなた"],["がた"],["は"],["主","しゅ"],["の"],["言葉","ことば"],["を"],["聞","きき"],["、"],["これ"],["を"],["遠い","とおい"],["、"],["海沿い","うみぞい"],["の"],["地","ち"],["に"],["示めして","しめして"],["言い","いい"],["なさい"],["、"],["『"],["イスラエル"],["を"],["散らした","ちらした"],["者","もの"],["が"],["これ"],["を"],["集められる","あつめられる"],["。"],["牧者","ぼくしゃ"],["が"],["その"],["群れ","むれ"],["を"],["守","まもる"],["よう"],["に"],["これ"],["を"],["守られる","まもられる"],["』"],["と"],["。"]]},{"verse":11,"text":"すなわち主,しゅはヤコブをあがない、彼,かれらよりも強,つよい者,ものの手,てから彼,かれを救,すくいだされた。","tok":[["すなわち"],["主","しゅ"],["は"],["ヤコブ"],["を"],["あがない"],["、"],["彼","かれ"],["ら"],["より"],["も"],["強い","つよい"],["者","もの"],["の"],["手","て"],["から"],["彼","かれ"],["を"],["救いだされた","すくいだされた"],["。"]]},{"verse":12,"text":"彼,かれらは来,きてシオンの山,やまで声,こえ高,たかく歌,うたい、主,しゅから賜,たまわった良,よい物,もののために、穀物,こくもつと酒,さけと油,あぶらおよび若,わかき羊,ひつじと牛,うしのために、喜,よろこびに輝,かがやく。その魂,たましいは潤,うるおう園,そののようになり、彼,かれらは重,かさねて憂,うれえることがない。","tok":[["彼","かれ"],["ら"],["は"],["来て","きて"],["シオン"],["の"],["山","やま"],["で"],["声","こえ"],["高かく","たかく"],["歌い","うたい"],["、"],["主ら","しゅから"],["賜わった","たまわった"],["良い","よい"],["物","もの"],["の"],["ため"],["に"],["、"],["穀物","こくもつ"],["と"],["酒","さけ"],["と"],["油","あぶら"],["および"],["若き","わかき"],["羊","ひつじ"],["と"],["牛","うし"],["の"],["ため"],["に"],["、"],["喜こび","よろこび"],["に"],["輝やく","かがやく"],["。"],["その"],["魂","たましい"],["は"],["潤う","うるおう"],["園","その"],["の"],["よう"],["に"],["なり"],["、"],["彼","かれ"],["ら"],["は"],["重ねて","かさねて"],["憂える","うれえる"],["こと"],["が"],["ない"],["。"]]},{"verse":13,"text":"その時,ときおとめたちは舞,まって楽,たのしみ、若,わかい者,ものも老,おいた者,ものも共,ともに楽,たのしむ。わたしは彼,かれらの悲,かなしみを喜,よろこびにかえ、彼,かれらを慰,なぐさめ、憂,うれいの代,かわりに喜,よろこびを与,あたえる。","tok":[["その"],["時","とき"],["おとめ"],["たち"],["は"],["舞って","まって"],["楽み","たのしみ"],["、"],["若い","わかい"],["者","もの"],["も"],["老","おい"],["た"],["者","もの"],["も"],["共","とも"],["に"],["楽しむ","たのしむ"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["悲しみ","かなしみ"],["を"],["喜こび","よろこび"],["に"],["かえ"],["、"],["彼","かれ"],["ら"],["を"],["慰さめ","なぐさめ"],["、"],["憂","うれい"],["の"],["代わり","かわり"],["に"],["喜こび","よろこび"],["を"],["与える","あたえる"],["。"]]},{"verse":14,"text":"わたしは多,おおくのささげ物,もので、祭司,さいしの心,こころを飽,あかせ、わたしの良,よき物,もので、わたしの民,たみを満,みち足,たらせると主,しゅは言,いわれる」。","tok":[["わたし"],["は"],["多く","おおく"],["の"],["ささげ物","ささげもの"],["で"],["、"],["祭司","さいし"],["の"],["心","こころ"],["を"],["飽かせ","あかせ"],["、"],["わたし"],["の"],["良き","よき"],["物","もの"],["で"],["、"],["わたし"],["の"],["民","たみ"],["を"],["満ち","みち"],["足らせる","たらせる"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["」"],["。"]]},{"verse":15,"text":"主,しゅはこう仰,おおせられる、「嘆,なげき悲,かなしみ、いたく泣,なく声,こえがラマで聞,きこえる。ラケルがその子,こらのために嘆,なげくのである。子,こらがもはやいないので、彼女,かのじょはその子,こらのことで慰,なぐさめられるのを願,ねがわない」。","tok":[["主","しゅ"],["は"],["こう"],["仰せられる","おおせられる"],["、"],["「"],["嘆き悲しみ","なげきかなしみ"],["、"],["いたく"],["泣く","なく"],["声","こえ"],["が"],["ラマ"],["で"],["聞こえる","きこえる"],["。"],["ラケル"],["が"],["その"],["子","こ"],["ら"],["の"],["ため"],["に"],["嘆く","なげく"],["ので"],["ある"],["。"],["子","こ"],["ら"],["が"],["もはや"],["いない"],["ので"],["、"],["彼女","かのじょ"],["は"],["その"],["子","こ"],["ら"],["の"],["こと"],["で"],["慰さめられる","なぐさめられる"],["の"],["を"],["願わない","ねがわない"],["」"],["。"]]},{"verse":16,"text":"主,しゅはこう仰,おおせられる、「あなたは泣,なく声,こえをとどめ、目,めから涙,なみだをながすことをやめよ。あなたのわざに報,むくいがある。彼,かれらは敵,てきの地,ちから帰,かえってくると主,しゅは言,いわれる。","tok":[["主","しゅ"],["は"],["こう"],["仰せられる","おおせられる"],["、"],["「"],["あなた"],["は"],["泣く","なく"],["声","こえ"],["を"],["とどめ"],["、"],["目","め"],["から"],["涙","なみだ"],["を"],["ながす"],["こと"],["を"],["やめよ"],["。"],["あなた"],["の"],["わざ"],["に"],["報い","むくい"],["が"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["敵","てき"],["の"],["地","ち"],["から"],["帰えって","かえって"],["くる"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":17,"text":"あなたの将来,しょうらいには希望,きぼうがあり、あなたの子供,こどもたちは自分,じぶんの国,くにに帰,かえってくると主,しゅは言,いわれる。","tok":[["あなた"],["の"],["将来","しょうらい"],["に"],["は"],["希望","きぼう"],["が"],["あり"],["、"],["あなた"],["の"],["子供","こども"],["たち"],["は"],["自分","じぶん"],["の"],["国","くに"],["に"],["帰えって","かえって"],["くる"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":18,"text":"わたしは確,たしかに、エフライムがこう言,いって嘆,なげくの聞,きいた、『あなたはわたしを懲,こらしめられた、わたしはくびきに慣,なれない子,こ牛,うしのように懲,こらしめをうけた。主,しゅよ、あなたはわたしの神,かみ、主,しゅでいらせられる、わたしを連,つれ帰,かえって、もとにかえしてください。","tok":[["わたし"],["は"],["確か","たしか"],["に"],["、"],["エフライム"],["が"],["こう"],["言って","いって"],["嘆く","なげく"],["の"],["聞いた","きいた"],["、"],["『"],["あなた"],["は"],["わたし"],["を"],["懲らしめられた","こらしめられた"],["、"],["わたし"],["は"],["くびき"],["に"],["慣れない","なれない"],["子牛","こうし"],["の"],["よう"],["に"],["懲らしめ","こらしめ"],["を"],["うけた"],["。"],["主","しゅ"],["よ"],["、"],["あなた"],["は"],["わたし"],["の"],["神","かみ"],["、"],["主らせられる","しゅでいらせられる"],["、"],["わたし"],["を"],["連れ","つれ"],["帰えって","かえって"],["、"],["もと"],["に"],["かえして"],["ください"],["。"]]},{"verse":19,"text":"わたしはそむき去,さった後,のち、悔,くい、教,おしえをうけた後,のち、ももを打,うった。若,わかい時,ときのはずかしめが身,みにあるので、わたしは恥,はじ、 うろたえた』。","tok":[["わたし"],["は"],["そむき"],["去た","さった"],["後","の"],["ち"],["、"],["悔い","くい"],["、"],["教え","おしえ"],["を"],["うけた"],["後","の"],["ち"],["、"],["もも"],["を"],["打った","うった"],["。"],["若い","わかい"],["時","とき"],["の"],["はずかし"],["め"],["が"],["身","み"],["に"],["ある"],["ので"],["、"],["わたし"],["は"],["恥","はじ"],["、"],[" "],["うろたえた"],["』"],["。"]]},{"verse":20,"text":"主,しゅは言,いわれる、エフライムはわたしの愛,あいする子,こ、わたしの喜,よろこぶ子,こであろうか。わたしは彼,かれについて語,かたるごとに、なお彼,かれを忘,わすれることができない。それゆえ、わたしの心,こころは彼,かれをしたっている。わたしは必,かならず彼,かれをあわれむ。","tok":[["主","しゅ"],["は"],["言われる","いわれる"],["、"],["エフライム"],["は"],["わたし"],["の"],["愛する","あいする"],["子","こ"],["、"],["わたし"],["の"],["喜こぶ","よろこぶ"],["子","こ"],["で"],["あろう"],["か"],["。"],["わたし"],["は"],["彼","かれ"],["について"],["語る","かたる"],["ごと"],["に"],["、"],["なお"],["彼","かれ"],["を"],["忘る","わすれる"],["こと"],["が"],["できない"],["。"],["それ"],["ゆえ"],["、"],["わたし"],["の"],["心","こころ"],["は"],["彼","かれ"],["を"],["したって"],["いる"],["。"],["わたし"],["は"],["必","かならず"],["彼","かれ"],["を"],["あわれむ"],["。"]]},{"verse":21,"text":"みずからのために道,みちしるべを置,おき、みずからのために標柱,ひょうちゅうを立,たてよ。大路,おおじに、あなたの通,とおって行,いった道,みちに心,こころを留,とめよ。イスラエルのおとめよ、帰,かえれ、これらの、あなたの町々,まちまちに帰,かえれ。","tok":[["みずから"],["の"],["ため"],["に"],["道しるべ","みちしるべ"],["を"],["置き","おき"],["、"],["みずから"],["の"],["ため"],["に"],["標柱","ひょうちゅう"],["を"],["立","たて"],["よ"],["。"],["大路","おおじ"],["に"],["、"],["あなた"],["の"],["通って","とおって"],["行った","いった"],["道","みち"],["に"],["心","こころ"],["を"],["留","とめ"],["よ"],["。"],["イスラエル"],["の"],["おとめ"],["よ"],["、"],["帰えれ","かえれ"],["、"],["これ"],["ら"],["の"],["、"],["あなた"],["の"],["町々","まちまち"],["に"],["帰えれ","かえれ"],["。"]]},{"verse":22,"text":"不信,ふしんの娘,むすめよ、いつまでさまようのか。主,しゅは地,ちの上,うえに新,あたらしい事,ことを創造,そうぞうされたのだ、女,おんなが男,おとこを保護,ほごする事,ことである」。","tok":[["不信","ふしん"],["の"],["娘","むすめ"],["よ"],["、"],["いつ"],["まで"],["さまよう"],["の"],["か"],["。"],["主","しゅ"],["は"],["地","ち"],["の"],["上","うえ"],["に"],["新らしい","あたらしい"],["事","こと"],["を"],["創造","そうぞう"],["された"],["の"],["だ"],["、"],["女","おんな"],["が"],["男","おとこ"],["を"],["保護","ほご"],["する"],["事","こと"],["で"],["ある"],["」"],["。"]]},{"verse":23,"text":"万軍,ばんぐんの主,しゅ、イスラエルの神,かみはこう言,いわれる、「わたしが彼,かれらを再,ふたたび栄,さかえさせる時,とき、人々,ひとびとはまたユダの地,ちとその町々,まちまちでこの言葉,ことばを言,いう、『正義,せいぎのすみかよ、聖,せいなる山,やまよ、どうか主,しゅがおまえを祝福,しゅくふくしてくださるように』。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["、"],["イスラエル"],["の"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["「"],["わたし"],["が"],["彼","かれ"],["ら"],["を"],["再び","ふたたび"],["栄","さかえ"],["させる"],["時","とき"],["、"],["人々","ひとびと"],["は"],["また"],["ユダ"],["の"],["地","ち"],["と"],["その"],["町々","まちまち"],["で"],["この"],["言葉","ことば"],["を"],["言う","いう"],["、"],["『"],["正義","せいぎ"],["の"],["すみか"],["よ"],["、"],["聖","せい"],["なる"],["山","やま"],["よ"],["、"],["どう"],["か"],["主","しゅ"],["が"],["おまえ"],["を"],["祝福","しゅくふく"],["して"],["くださる"],["よう"],["に"],["』"],["。"]]},{"verse":24,"text":"ユダとそのすべての町,まちの人,ひと、および農夫,のうふと群,むれを飼,かって歩,あるき回,まわる者,ものは共,ともにそこに住,すむ。","tok":[["ユダ"],["と"],["その"],["すべて"],["の"],["町","まち"],["の"],["人","ひと"],["、"],["および"],["農夫","のうふ"],["と"],["群れ","むれ"],["を"],["飼って","かって"],["歩き","あるき"],["回わる","まわる"],["者","もの"],["は"],["共","とも"],["に"],["そこ"],["に"],["住む","すむ"],["。"]]},{"verse":25,"text":"わたしが疲,つかれた魂,たましいを飽,あき足,たらせ、すべて悩,なやんでいる魂,たましいを慰,なぐさめるからである」。","tok":[["わたし"],["が"],["疲れた","つかれた"],["魂","たましい"],["を"],["飽き足らせ","あきたらせ"],["、"],["すべて"],["悩んで","なやんで"],["いる"],["魂","たましい"],["を"],["慰さめる","なぐさめる"],["から"],["で"],["ある"],["」"],["。"]]},{"verse":26,"text":"ここでわたしは目,めをさましたが、わたしの眠,ねむりは、ここちよかった。","tok":[["ここ"],["で"],["わたし"],["は"],["目","め"],["を"],["さました"],["が"],["、"],["わたし"],["の"],["眠","ねむり"],["は"],["、"],["ここちよかった"],["。"]]},{"verse":27,"text":"「主,しゅは言,いわれる、見,みよ、わたしが人,ひとの種,たねと獣,けものの種,たねとをイスラエルの家,いえとユダの家,いえとにまく日,ひが来,くる。","tok":[["「"],["主","しゅ"],["は"],["言われる","いわれる"],["、"],["見よ","みよ"],["、"],["わたし"],["が"],["人","ひと"],["の"],["種","たね"],["と"],["獣","けもの"],["の"],["種","たね"],["と"],["を"],["イスラエル"],["の"],["家","いえ"],["と"],["ユダ"],["の"],["家","いえ"],["と"],["に"],["まく"],["日","ひ"],["が"],["来る","くる"],["。"]]},{"verse":28,"text":"わたしは彼,かれらを抜,ぬき、砕,くだき、倒,たおし、滅,ほろぼし、悩,なやまそうと待,まちかまえていたように、また彼,かれらを建,たて、植,うえようと待,まちかまえていると主,しゅは言,いわれる。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["を"],["抜き","ぬき"],["、"],["砕き","くだき"],["、"],["倒し","たおし"],["、"],["滅ぼし","ほろぼし"],["、"],["悩そう","なやまそう"],["と"],["待","まち"],["かまえて"],["いた"],["よう"],["に"],["、"],["また"],["彼","かれ"],["ら"],["を"],["建て","たて"],["、"],["植えよう","うえよう"],["と"],["待","まち"],["かまえて"],["いる"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":29,"text":"その時,とき、彼,かれらはもはや、『父,ちちがすっぱいぶどうを食,たべたので、子,こどもの歯,はがうく』とは言,いわない。","tok":[["その"],["時","とき"],["、"],["彼","かれ"],["ら"],["は"],["もはや"],["、"],["『"],["父","ちち"],["が"],["すっぱい"],["ぶどう"],["を"],["食べた","たべた"],["ので"],["、"],["子ども","こども"],["の"],["歯","は"],["が"],["うく"],["』"],["と"],["は"],["言わない","いわない"],["。"]]},{"verse":30,"text":"人,ひとはめいめい自分,じぶんの罪,つみによって死,しぬ。すっぱいぶどうを食,たべる人,ひとはみな、その歯,はがうく。","tok":[["人","ひと"],["は"],["めいめい"],["自分","じぶん"],["の"],["罪","つみ"],["によって"],["死ぬ","しぬ"],["。"],["すっぱい"],["ぶどう"],["を"],["食べる","たべる"],["人","ひと"],["は"],["みな"],["、"],["その"],["歯","は"],["が"],["うく"],["。"]]},{"verse":31,"text":"主,しゅは言,いわれる、見,みよ、わたしがイスラエルの家,いえとユダの家,いえとに新,あたらしい契約,けいやくを立,たてる日,ひが来,くる。","tok":[["主","しゅ"],["は"],["言われる","いわれる"],["、"],["見よ","みよ"],["、"],["わたし"],["が"],["イスラエル"],["の"],["家","いえ"],["と"],["ユダ"],["の"],["家","いえ"],["と"],["に"],["新らしい","あたらしい"],["契約","けいやく"],["を"],["立る","たてる"],["日","ひ"],["が"],["来る","くる"],["。"]]},{"verse":32,"text":"この契約,けいやくはわたしが彼,かれらの先祖,せんぞをその手,てをとってエジプトの地,ちから導,みちびき出,だした日,ひに立,たてたようなものではない。わたしは彼,かれらの夫,おっとであったのだが、彼,かれらはそのわたしの契約,けいやくを破,やぶったと主,しゅは言,いわれる。","tok":[["この"],["契約","けいやく"],["は"],["わたし"],["が"],["彼","かれ"],["ら"],["の"],["先祖","せんぞ"],["を"],["その"],["手","て"],["を"],["とって"],["エジプト"],["の"],["地","ち"],["から"],["導き出した","みちびきだした"],["日","ひ"],["に"],["立てた","たてた"],["よう"],["な"],["もの"],["で"],["は"],["ない"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["夫","おっと"],["で"],["あった"],["の"],["だ"],["が"],["、"],["彼","かれ"],["ら"],["は"],["その"],["わたし"],["の"],["契約","けいやく"],["を"],["破った","やぶった"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":33,"text":"しかし、それらの日,ひの後,のちにわたしがイスラエルの家,いえに立,たてる契約,けいやくはこれである。すなわちわたしは、わたしの律法,りっぽうを彼,かれらのうちに置,おき、その心,こころにしるす。わたしは彼,かれらの神,かみとなり、彼,かれらはわたしの民,たみとなると主,しゅは言,いわれる。","tok":[["しかし"],["、"],["それ"],["ら"],["の"],["日","ひ"],["の"],["後","のち"],["に"],["わたし"],["が"],["イスラエル"],["の"],["家","いえ"],["に"],["立る","たてる"],["契約","けいやく"],["は"],["これ"],["で"],["ある"],["。"],["すなわち"],["わたし"],["は"],["、"],["わたし"],["の"],["律法","りっぽう"],["を"],["彼","かれ"],["ら"],["の"],["うち"],["に"],["置き","おき"],["、"],["その"],["心","こころ"],["に"],["しるす"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["神","かみ"],["と"],["なり"],["、"],["彼","かれ"],["ら"],["は"],["わたし"],["の"],["民","たみ"],["と"],["なる"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":34,"text":"人,ひとはもはや、おのおのその隣,となりとその兄弟,きょうだいに教,おしえて、『あなたは主,しゅを知,しりなさい』とは言,いわない。それは、彼,かれらが小,しょうより大,だいに至,いたるまで皆,みな、わたしを知,しるようになるからであると主,しゅは言,いわれる。わたしは彼,かれらの不義,ふぎをゆるし、もはやその罪,つみを思,おもわない」。","tok":[["人","ひと"],["は"],["もはや"],["、"],["おのおの"],["その"],["隣","となり"],["と"],["その"],["兄弟","きょうだい"],["に"],["教えて","おしえて"],["、"],["『"],["あなた"],["は"],["主","しゅ"],["を"],["知り","しり"],["なさい"],["』"],["と"],["は"],["言わない","いわない"],["。"],["それ"],["は"],["、"],["彼","かれ"],["ら"],["が"],["小","しょう"],["より"],["大","だい"],["に"],["至る","いたる"],["まで"],["皆","みな"],["、"],["わたし"],["を"],["知る","しる"],["よう"],["に"],["なる"],["から"],["で"],["ある"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["不義","ふぎ"],["を"],["ゆるし"],["、"],["もはや"],["その"],["罪","つみ"],["を"],["思わない","おもわない"],["」"],["。"]]},{"verse":35,"text":"主,しゅはこう言,いわれる、すなわち太陽,たいようを与,あたえて昼,ひるの光,ひかりとし、月,つきと星,ほしとを定,さだめて夜,よるの光,ひかりとし、海,うみをかき立,たてて、その波,なみを鳴,なりとどろかせる者,もの――その名,なは万軍,ばんぐんの主,しゅという。","tok":[["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["すなわち"],["太陽","たいよう"],["を"],["与","あたえ"],["て"],["昼","ひる"],["の"],["光","ひかり"],["と"],["し"],["、"],["月","つき"],["と"],["星","ほし"],["と"],["を"],["定めて","さだめて"],["夜","よる"],["の"],["光","ひかり"],["と"],["し"],["、"],["海","うみ"],["を"],["かき立てて","かきたてて"],["、"],["その"],["波","なみ"],["を"],["鳴り","なり"],["とどろかせる"],["者","もの"],["―"],["―"],["その"],["名","な"],["は"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["と"],["いう"],["。"]]},{"verse":36,"text":"主,しゅは言,いわれる、「もしこの定,さだめがわたしの前,まえですたれてしまうなら、イスラエルの子孫,しそんもすたって、永久,えいきゅうにわたしの前,まえで民,たみであることはできない」。","tok":[["主","しゅ"],["は"],["言われる","いわれる"],["、"],["「"],["もし"],["この"],["定め","さだめ"],["が"],["わたし"],["の"],["前","まえ"],["で"],["すたれて"],["しまうなら"],["、"],["イスラエル"],["の"],["子孫","しそん"],["も"],["すたって"],["、"],["永久","えいきゅう"],["に"],["わたし"],["の"],["前","まえ"],["で"],["民","たみ"],["で"],["ある"],["こと"],["は"],["できない"],["」"],["。"]]},{"verse":37,"text":"主,しゅはこう言,いわれる、「もし上,うえの天,てんを量,はかることができ、下,したの地,ちの基,もといを探,さぐることができるなら、そのとき、わたしはイスラエルのすべての子孫,しそんをそのもろもろの行,おこないのために捨,すて去,さると主,しゅは言,いわれる」。","tok":[["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["「"],["もし"],["上","うえ"],["の"],["天","てん"],["を"],["量る","はかる"],["こと"],["が"],["でき"],["、"],["下","した"],["の"],["地","ち"],["の"],["基い","もとい"],["を"],["探ぐる","さぐる"],["こと"],["が"],["できるなら"],["、"],["その"],["とき"],["、"],["わたし"],["は"],["イスラエル"],["の"],["すべて"],["の"],["子孫","しそん"],["を"],["その"],["もろもろ"],["の"],["行ない","おこない"],["の"],["ため"],["に"],["捨て去る","すてさる"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["」"],["。"]]},{"verse":38,"text":"主,しゅは言,いわれる、「見,みよ、この町,まちが、ハナネルの塔,とうから隅,すみの門,もんまで、主,しゅのために再建,さいけんされる時,ときが来,くる。","tok":[["主","しゅ"],["は"],["言われる","いわれる"],["、"],["「"],["見よ","みよ"],["、"],["この"],["町","まち"],["が"],["、"],["ハナネル"],["の"],["塔","とう"],["から"],["隅","すみ"],["の"],["門","もん"],["まで"],["、"],["主","しゅ"],["の"],["ため"],["に"],["再建","さいけん"],["される"],["時","とき"],["が"],["来る","くる"],["。"]]},{"verse":39,"text":"測,はかりなわはそれよりも遠,とおくまっすぐに延,のびて、ガレブの丘,おかに達,たっし、ゴアのほうに向,むかう。","tok":[["測り","はかり"],["なわ"],["は"],["それ"],["より"],["も"],["遠く","とおく"],["まっすぐ"],["に"],["延びて","のびて"],["、"],["ガレブ"],["の"],["丘","おか"],["に"],["達し","たっし"],["、"],["ゴア"],["の"],["ほう"],["に"],["向かう","むかう"],["。"]]},{"verse":40,"text":"死体,したいと灰,はいとの谷,たにの全部,ぜんぶ、またキデロンの谷,たにに行,いくまでと、東,ひがしのほうの馬,うまの門,もんのすみに行,いくまでとのすべての畑,はたけはみな主,しゅの聖,せいなる所,ところとなり、永遠,えいえんにわたって、ふたたび抜,ぬかれ、また倒,たおされることはない」。","tok":[["死体","したい"],["と"],["灰","はい"],["と"],["の"],["谷","たに"],["の"],["全部","ぜんぶ"],["、"],["また"],["キデロン"],["の"],["谷","たに"],["に"],["行く","いく"],["まで"],["と"],["、"],["東","ひがし"],["の"],["ほう"],["の"],["馬","うま"],["の"],["門","もん"],["の"],["すみ"],["に"],["行く","いく"],["まで"],["と"],["の"],["すべて"],["の"],["畑","はたけ"],["は"],["みな"],["主","しゅ"],["の"],["聖","せい"],["なる"],["所","ところ"],["と"],["なり"],["、"],["永遠","えいえん"],["に"],["わたって"],["、"],["ふたたび"],["抜かれ","ぬかれ"],["、"],["また"],["倒される","たおされる"],["こと"],["は"],["ない"],["」"],["。"]]}]
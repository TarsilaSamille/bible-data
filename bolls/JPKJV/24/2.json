[{"verse":1,"text":"主,しゅの言葉,ことばがわたしに臨,のぞんで言,いう、","tok":[["主","しゅ"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んで","のぞんで"],["言う","いう"],["、"]]},{"verse":2,"text":"「行,いって、エルサレムに住,すむ者,ものの耳,みみに告,つげよ、主,しゅはこう言,いわれる、わたしはあなたの若,わかい時,ときの純情,じゅんじょう、花嫁,はなよめの時,ときの愛,あい、荒野,あらのなる、種,たねまかぬ地,ちでわたしに従,したがったことを覚,おぼえている。","tok":[["「"],["行って","いって"],["、"],["エルサレム"],["に"],["住む","すむ"],["者","もの"],["の"],["耳","みみ"],["に"],["告","つげ"],["よ"],["、"],["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["わたし"],["は"],["あなた"],["の"],["若い","わかい"],["時","とき"],["の"],["純情","じゅんじょう"],["、"],["花嫁","はなよめ"],["の"],["時","とき"],["の"],["愛","あい"],["、"],["荒野","あらの"],["なる"],["、"],["種","た"],["ね"],["まかぬ"],["地","ち"],["で"],["わたし"],["に"],["従った","したがった"],["こと"],["を"],["覚えて","おぼえて"],["いる"],["。"]]},{"verse":3,"text":"イスラエルは主,しゅのために聖別,せいべつされたもの、その刈入,かりいれの初穂,はつほである。すべてこれを食,たべる者,ものは罪,つみせられ、災,わざわいにあう」と主,しゅは言,いわれる。","tok":[["イスラエル"],["は"],["主","しゅ"],["の"],["ため"],["に"],["聖別","せいべつ"],["された"],["もの"],["、"],["その"],["刈入れ","かりいれ"],["の"],["初穂","はつほ"],["で"],["ある"],["。"],["すべて"],["これ"],["を"],["食べる","たべる"],["者","もの"],["は"],["罪","つみ"],["せられ"],["、"],["災","わざわい"],["に"],["あう"],["」"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":4,"text":"ヤコブの家,いえとイスラエルの家,いえのすべてのやからよ、主,しゅの言葉,ことばを聞,きけ。","tok":[["ヤコブ"],["の"],["家","いえ"],["と"],["イスラエル"],["の"],["家","いえ"],["の"],["すべて"],["の"],["やから"],["よ"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["を"],["聞け","きけ"],["。"]]},{"verse":5,"text":"主,しゅはこう言,いわれる、「あなたがたの先祖,せんぞは、わたしになんの悪,わるい事,ことがあるのを見,みて、わたしから遠,とおざかり、むなしいものに従,したがって、むなしくなったのか。","tok":[["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["「"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["は"],["、"],["わたし"],["に"],["なん"],["の"],["悪い","わるい"],["事","こと"],["が"],["ある"],["の"],["を"],["見て","みて"],["、"],["わたし"],["から"],["遠ざかり","とおざかり"],["、"],["むなしい"],["もの"],["に"],["従って","したがって"],["、"],["むなしく"],["なった"],["の"],["か"],["。"]]},{"verse":6,"text":"彼,かれらは言,いわなかった、『われわれをエジプトの地,ちより導,みちびき出,だし、荒野,あらのなる、穴,あなの多,おおい荒,あれた地,ち、かわいた濃,こい暗黒,あんこくの地,ち、人,ひとの通,とおらない、人,ひとの住,すまない地,ちを通,とおらせた主,しゅはどこにおられるか』と。","tok":[["彼","かれ"],["ら"],["は"],["言わなかった","いわなかった"],["、"],["『"],["われわれ"],["を"],["エジプト"],["の"],["地","ち"],["より"],["導き出し","みちびきだし"],["、"],["荒野","あらの"],["なる"],["、"],["穴","あな"],["の"],["多い","おおい"],["荒れた","あれた"],["地","ち"],["、"],["かわいた"],["濃い","こい"],["暗黒","あんこく"],["の"],["地","ち"],["、"],["人","ひと"],["の"],["通らない","とおらない"],["、"],["人","ひと"],["の"],["住まない","すまない"],["地","ち"],["を"],["通らせた","とおらせた"],["主","しゅ"],["は"],["どこ"],["に"],["おられる"],["か"],["』"],["と"],["。"]]},{"verse":7,"text":"わたしはあなたがたを導,みちびいて豊,ゆたかな地,ちに入,いれ、その実,みと良,よい物,ものを食,たべさせた。しかしあなたがたはここにはいって、わたしの地,ちを汚,けがし、わたしの嗣,し業,ぎょうを憎,にくむべきものとした。","tok":[["わたし"],["は"],["あなた"],["がた"],["を"],["導いて","みちびいて"],["豊","ゆたか"],["な"],["地","ち"],["に"],["入れ","いれ"],["、"],["その"],["実","み"],["と"],["良い","よい"],["物","もの"],["を"],["食べさせた","たべさせた"],["。"],["しかし"],["あなた"],["がた"],["は"],["ここ"],["に"],["はいって"],["、"],["わたし"],["の"],["地","ち"],["を"],["汚","け"],["がし"],["、"],["わたし"],["の"],["嗣業","しぎょう"],["を"],["憎むべき","にくむべき"],["もの"],["と"],["した"],["。"]]},{"verse":8,"text":"祭司,さいしたちは、『主,しゅはどこにおられるか』と言,いわなかった。律法,りっぽうを扱,あつかう者,ものたちはわたしを知,しらず、つかさたちはわたしにそむき、預言者,よげんしゃたちはバアルによって預言,よげんし、益,えきなき者,ものに従,したがって行,いった。","tok":[["祭司","さいし"],["たち"],["は"],["、"],["『"],["主","しゅ"],["は"],["どこ"],["に"],["おられる"],["か"],["』"],["と"],["言わなかった","いわなかった"],["。"],["律法","りっぽう"],["を"],["扱う","あつかう"],["者","もの"],["たち"],["は"],["わたし"],["を"],["知らず","しらず"],["、"],["つかさ"],["たち"],["は"],["わたし"],["に"],["そむき"],["、"],["預言者","よげんしゃ"],["たち"],["は"],["バアル"],["によって"],["預言","よげん"],["し"],["、"],["益","えき"],["なき"],["者","もの"],["に"],["従って","したがって"],["行った","いった"],["。"]]},{"verse":9,"text":"それゆえ、わたしはなお、あなたがたと争,あらそう、またあなたがたの子孫,しそんと争,あらそう」と主,しゅは言,いわれる。","tok":[["それ"],["ゆえ"],["、"],["わたし"],["は"],["なお"],["、"],["あなた"],["がた"],["と"],["争う","あらそう"],["、"],["また"],["あなた"],["がた"],["の"],["子孫","しそん"],["と"],["争う","あらそう"],["」"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":10,"text":"「あなたがたはクプロの島々,しまじまに渡,わたってみよ、また人,ひとをケダルにつかわして、このようなことがかつてあったかをつまびらかに、しらべてみよ。","tok":[["「"],["あなた"],["がた"],["は"],["クプロ"],["の"],["島々","しまじま"],["に"],["渡って","わたって"],["みよ"],["、"],["また"],["人","ひと"],["を"],["ケダル"],["に"],["つかわして"],["、"],["この"],["よう"],["な"],["こと"],["が"],["かつて"],["あった"],["か"],["を"],["つまびらか"],["に"],["、"],["しらべて"],["み"],["よ"],["。"]]},{"verse":11,"text":"その神,かみを神,かみではない者,ものに取,とり替,かえた国,くにがあろうか。ところが、わたしの民,たみはその栄光,えいこうを益,えきなきものと取,とり替,かえた。","tok":[["その"],["神","かみ"],["を"],["神","かみ"],["で"],["は"],["ない"],["者","もの"],["に"],["取替","とりかえ"],["た"],["国","くに"],["が"],["あろう"],["か"],["。"],["ところ"],["が"],["、"],["わたし"],["の"],["民","たみ"],["は"],["その"],["栄光","えいこう"],["を"],["益","えき"],["なき"],["もの"],["と"],["取替","とりかえ"],["た"],["。"]]},{"verse":12,"text":"天,てんよ、この事,ことを知,しって驚,おどろけ、おののけ、いたく恐,おそれよ」と主,しゅは言,いわれる。","tok":[["天","てん"],["よ"],["、"],["この"],["事","こと"],["を"],["知って","しって"],["驚ろけ","おどろけ"],["、"],["おののけ"],["、"],["いたく"],["恐れよ","おそれよ"],["」"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":13,"text":"「それは、わたしの民,たみが二つの悪,あしき事,ことを行,おこなったからである。すなわち生,いける水,みずの源,みなもとであるわたしを捨,すてて、自分,じぶんで水,みずためを掘,ほった。それは、こわれた水,みずためで、水,みずを入,いれておくことのできないものだ。","tok":[["「"],["それ"],["は"],["、"],["わたし"],["の"],["民","たみ"],["が"],["二","ふた"],["つ"],["の"],["悪しき","あしき"],["事","こと"],["を"],["行なった","おこなった"],["から"],["で"],["ある"],["。"],["すなわち"],["生ける","いける"],["水","みず"],["の"],["源","みなもと"],["で"],["ある"],["わたし"],["を"],["捨てて","すてて"],["、"],["自分","じぶん"],["で"],["水","みず"],["ため"],["を"],["掘った","ほった"],["。"],["それ"],["は"],["、"],["こわれた"],["水","みず"],["ため"],["で"],["、"],["水","みず"],["を"],["入れて","いれて"],["おく"],["こと"],["の"],["できない"],["もの"],["だ"],["。"]]},{"verse":14,"text":"イスラエルは奴隷,どれいであるか、家,いえに生,うまれたしもべであるか。それならなぜ捕,とらわれの身,みとなったのか。","tok":[["イスラエル"],["は"],["奴隷","どれい"],["で"],["ある"],["か"],["、"],["家","いえ"],["に"],["生まれた","うまれた"],["しもべ"],["で"],["ある"],["か"],["。"],["それ"],["なら"],["なぜ"],["捕らわれ","とらわれ"],["の"],["身","み"],["と"],["なった"],["の"],["か"],["。"]]},{"verse":15,"text":"ししは彼,かれに向,むかってほえ、その声,こえを高,たかくあげて、彼,かれの地,ちを荒,あらした。その町々,まちまちは滅,ほろびて住,すむ人,ひともない。","tok":[["しし"],["は"],["彼","かれ"],["に"],["向かって","むかって"],["ほえ"],["、"],["その"],["声","こえ"],["を"],["高かく","たかく"],["あげて"],["、"],["彼","かれ"],["の"],["地","ち"],["を"],["荒した","あらした"],["。"],["その"],["町々","まちまち"],["は"],["滅びて","ほろびて"],["住む","すむ"],["人","ひと"],["も"],["ない"],["。"]]},{"verse":16,"text":"メンピスとタパネスの人々,ひとびともまた、あなたのかしらの冠,かんむりを砕,くだいた。","tok":[["メンピス"],["と"],["タパネス"],["の"],["人々","ひとびと"],["も"],["また"],["、"],["あなた"],["の"],["かしら"],["の"],["冠","かんむり"],["を"],["砕いた","くだいた"],["。"]]},{"verse":17,"text":"あなたの神,かみ、主,しゅがあなたを道,みちに導,みちびかれた時,とき、あなたは主,しゅを捨,すてたので、この事,ことがあなたに及,およんだのではないか。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["あなた"],["を"],["道","みち"],["に"],["導かれた","みちびかれた"],["時","とき"],["、"],["あなた"],["は"],["主","しゅ"],["を"],["捨てた","すてた"],["ので"],["、"],["この"],["事","こと"],["が"],["あなた"],["に"],["及","およんだ"],["ので"],["は"],["ない"],["か"],["。"]]},{"verse":18,"text":"あなたがナイルの水,みずを飲,のもうとして、エジプトへ行,いくのは何,なにのためか。またユフラテの水,みずを飲,のもうとして、アッスリヤへ行,いくのは何,なにのためか。","tok":[["あなた"],["が"],["ナイル"],["の"],["水","みず"],["を"],["飲もう","のもう"],["として"],["、"],["エジプト"],["へ"],["行く","いく"],["の"],["は"],["何に","なに"],["の"],["ため"],["か"],["。"],["また"],["ユフラテ"],["の"],["水","みず"],["を"],["飲もう","のもう"],["として"],["、"],["アッスリヤ"],["へ"],["行く","いく"],["の"],["は"],["何に","なに"],["の"],["ため"],["か"],["。"]]},{"verse":19,"text":"あなたの悪事,あくじはあなたを懲,こらしめ、あなたの背信,はいしんはあなたを責,せめる。あなたが、あなたの神,かみ、主,しゅを捨,すてることの悪,あしくかつ苦,にがいことであるのを見,みて知,しるがよい。わたしを恐,おそれることがあなたのうちにないのだ」と万軍,ばんぐんの神,かみ、主,しゅは言,いわれる。","tok":[["あなた"],["の"],["悪事","あくじ"],["は"],["あなた"],["を"],["懲らしめ","こらしめ"],["、"],["あなた"],["の"],["背信","はいしん"],["は"],["あなた"],["を"],["責","せめ"],["る"],["。"],["あなた"],["が"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["を"],["捨てる","すてる"],["こと"],["の"],["悪しく","あしく"],["かつ"],["苦い","にがい"],["こと"],["で"],["ある"],["の"],["を"],["見て","みて"],["知る","しる"],["が"],["よい"],["。"],["わたし"],["を"],["恐れる","おそれる"],["こと"],["が"],["あなた"],["の"],["うち"],["に"],["ない"],["の"],["だ"],["」"],["と"],["万","まん"],["軍","ぐん"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":20,"text":"「あなたは久,ひさしい以前,いぜんに自分,じぶんのくびきを折,おり、自分,じぶんのなわめを断,たち切,きって、『わたしは仕,つかえることをしない』と言,いった。そして、すべての高,たかい丘,おかの上,うえと、すべての青,あお木,きの下,したで、遊女,ゆうじょのように身,みをかがめた。","tok":[["「"],["あなた"],["は"],["久い","ひさしい"],["以前","いぜん"],["に"],["自分","じぶん"],["の"],["くびき"],["を"],["折","おり"],["、"],["自分","じぶん"],["の"],["なわ"],["め"],["を"],["断ち切って","たちきって"],["、"],["『"],["わたし"],["は"],["仕える","つかえる"],["こと"],["を"],["しない"],["』"],["と"],["言った","いった"],["。"],["そして"],["、"],["すべて"],["の"],["高い","たかい"],["丘","おか"],["の"],["上","うえ"],["と"],["、"],["すべて"],["の"],["青木","あおき"],["の"],["下","した"],["で"],["、"],["遊女","ゆうじょ"],["の"],["よう"],["に"],["身","み"],["を"],["かがめた"],["。"]]},{"verse":21,"text":"わたしはあなたを、まったく良,よい種,たねのすぐれたぶどうの木,きとして植,うえたのに、どうしてあなたは変,かわって、悪,わるい野,のぶどうの木,きとなったのか。","tok":[["わたし"],["は"],["あなた"],["を"],["、"],["まったく"],["良い","よい"],["種","たね"],["の"],["すぐれた"],["ぶどう"],["の"],["木","き"],["として"],["植えた","うえた"],["のに"],["、"],["どう"],["して"],["あなた"],["は"],["変わって","かわって"],["、"],["悪い","わるい"],["野","の"],["ぶどう"],["の"],["木","き"],["と"],["なった"],["の"],["か"],["。"]]},{"verse":22,"text":"たといソーダをもって自,みずから洗,あらい、また多,おおくの灰汁,あくを用,もちいても、あなたの悪,あくの汚,けがれは、なおわたしの前,まえにある」と主,しゅなる神,かみは言,いわれる。","tok":[["たとい"],["ソーダ"],["を"],["もって"],["自から","みずから"],["洗","あらい"],["、"],["また"],["多く","おおく"],["の"],["灰汁","あく"],["を"],["用いて","もちいて"],["も"],["、"],["あなた"],["の"],["悪","あく"],["の"],["汚","けがれ"],["は"],["、"],["なお"],["わたし"],["の"],["前","まえ"],["に"],["ある"],["」"],["と"],["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"]]},{"verse":23,"text":"「どうしてあなたは、『わたしは汚,けがれていない、バアルに従,したがわなかった』と言,いうことができようか。谷,たにの中,なかでのあなたの行,おこないを見,みるがよい。あなたのしたことを知,しるがよい。あなたは御,ぎょしがたい若,わかいらくだであって、その道,みちを行,ゆきつもどりつする。","tok":[["「"],["どう"],["して"],["あなた"],["は"],["、"],["『"],["わたし"],["は"],["汚","け"],["がれ"],["て"],["いない"],["、"],["バアル"],["に"],["従わなかった","したがわなかった"],["』"],["と"],["言う","いう"],["こと"],["が"],["できよう"],["か"],["。"],["谷","たに"],["の"],["中","なか"],["で"],["の"],["あなた"],["の"],["行ない","おこない"],["を"],["見る","みる"],["が"],["よい"],["。"],["あなた"],["の"],["した"],["こと"],["を"],["知る","しる"],["が"],["よい"],["。"],["あなた"],["は"],["御し","ぎょし"],["がたい"],["若い","わかい"],["らくだ"],["で"],["あって"],["、"],["その"],["道","みち"],["を"],["行き","ゆき"],["つ"],["もどり"],["つ"],["する"],["。"]]},{"verse":24,"text":"あなたは荒野,あらのに慣,なれた野,のの雌,めろばである、その欲情,よくじょうのために風,かぜにあえぐ。その欲情,よくじょうをだれがとどめることができようか。すべてこれを尋,たずねる者,ものは苦,く労,ろうするにおよばない、その月,つきであればこれに会,あうことができる。","tok":[["あなた"],["は"],["荒野","あら"],["のに"],["慣れた","なれた"],["野","の"],["の"],["雌","め"],["ろば"],["で"],["ある"],["、"],["その"],["欲情","よくじょう"],["の"],["ため"],["に"],["風","かぜ"],["に"],["あえぐ"],["。"],["その"],["欲情","よくじょう"],["を"],["だれ"],["が"],["とどめる"],["こと"],["が"],["できよう"],["か"],["。"],["すべて"],["これ"],["を"],["尋ねる","たずねる"],["者","もの"],["は"],["苦労","くろう"],["する"],["に"],["およばない"],["、"],["その"],["月","つき"],["で"],["あれば"],["これ"],["に"],["会う","あう"],["こと"],["が"],["できる"],["。"]]},{"verse":25,"text":"あなたの足,あしが、はだしにならないように、のどが、かわかないようにせよ。ところが、あなたは言,いった、『それはだめだ、わたしは異,ことなる国,くにの者,ものを愛,あいして、それに従,したがって行,いこう』と。","tok":[["あなた"],["の"],["足","あし"],["が"],["、"],["はだし"],["に"],["ならない"],["よう"],["に"],["、"],["のど"],["が"],["、"],["かわかない"],["よう"],["に"],["せよ"],["。"],["ところ"],["が"],["、"],["あなた"],["は"],["言った","いった"],["、"],["『"],["それ"],["は"],["だめ"],["だ"],["、"],["わたし"],["は"],["異なる","ことなる"],["国","くに"],["の"],["者","もの"],["を"],["愛して","あいして"],["、"],["それ"],["に"],["従って","したがって"],["行こう","いこう"],["』"],["と"],["。"]]},{"verse":26,"text":"盗,ぬすびとが捕,とらえられて、はずかしめを受,うけるように、イスラエルの家,いえは、はずかしめを受,うける。彼,かれらはその王,おうも、そのつかさも、その祭司,さいしも、その預言者,よげんしゃもみなそのとおりである。","tok":[["盗","ぬすび"],["と"],["が"],["捕らえられて","とらえられて"],["、"],["はずかしめ"],["を"],["受る","うける"],["よう"],["に"],["、"],["イスラエル"],["の"],["家","いえ"],["は"],["、"],["はずかしめ"],["を"],["受る","うける"],["。"],["彼","かれ"],["ら"],["は"],["その"],["王","おう"],["も"],["、"],["その"],["つかさ"],["も"],["、"],["その"],["祭司","さいし"],["も"],["、"],["その"],["預言者","よげんしゃ"],["も"],["みな"],["その"],["とおり"],["で"],["ある"],["。"]]},{"verse":27,"text":"彼,かれらは木,きに向,むかって、『あなたはわたしの父,ちちです』と言,いい、また石,いしに向,むかって、『あなたはわたしを生,うんでくださった』と言,いう。彼,かれらは背,せをわたしに向,むけて、その顔,かおをわたしに向,むけない。しかし彼,かれらが災,わざわいにあう時,ときは、『立,たって、われわれを救,すくいたまえ』と言,いう。","tok":[["彼","かれ"],["ら"],["は"],["木","き"],["に"],["向かって","むかって"],["、"],["『"],["あなた"],["は"],["わたし"],["の"],["父","ちち"],["です"],["』"],["と"],["言い","いい"],["、"],["また"],["石","いし"],["に"],["向かって","むかって"],["、"],["『"],["あなた"],["は"],["わたし"],["を"],["生んで","うんで"],["くださった"],["』"],["と"],["言う","いう"],["。"],["彼","かれ"],["ら"],["は"],["背","せ"],["を"],["わたし"],["に"],["向けて","むけて"],["、"],["その"],["顔","かお"],["を"],["わたし"],["に"],["向けない","むけない"],["。"],["しかし"],["彼","かれ"],["ら"],["が"],["災","わざわい"],["に"],["あう"],["時","とき"],["は"],["、"],["『"],["立って","たって"],["、"],["われわれ"],["を"],["救い","すくい"],["たまえ"],["』"],["と"],["言う","いう"],["。"]]},{"verse":28,"text":"あなたが自分,じぶんのために造,つくった神々,かみがみはどこにいるのか。あなたが災,わざわいにあう時,とき、もし彼,かれらがあなたを救,すくえるなら、立,たってもらうがよい。ユダよ、あなたの神々,かみがみは、あなたの町,まちの数,かずほど多,おおいからである。","tok":[["あなた"],["が"],["自分","じぶん"],["の"],["ため"],["に"],["造った","つくった"],["神々","かみがみ"],["は"],["どこ"],["に"],["いる"],["の"],["か"],["。"],["あなた"],["が"],["災","わざわい"],["に"],["あう"],["時","とき"],["、"],["もし"],["彼","かれ"],["ら"],["が"],["あなた"],["を"],["救えるなら","すくえるなら"],["、"],["立って","たって"],["もらう"],["が"],["よい"],["。"],["ユダ"],["よ"],["、"],["あなた"],["の"],["神々","かみがみ"],["は"],["、"],["あなた"],["の"],["町","まち"],["の"],["数","かず"],["ほど"],["多い","おおい"],["から"],["で"],["ある"],["。"]]},{"verse":29,"text":"あなたがたは、なぜわたしと争,あらそうのか。あなたがたは皆,みなわたしにそむいている」と主,しゅは言,いわれる。","tok":[["あなた"],["がた"],["は"],["、"],["なぜ"],["わたし"],["と"],["争う","あらそう"],["の"],["か"],["。"],["あなた"],["がた"],["は"],["皆","みな"],["わたし"],["に"],["そむいて"],["いる"],["」"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":30,"text":"「わたしがあなたがたの子,こどもたちを打,うったのはむだであった。彼,かれらは戒,いましめを受,うけず、あなたがたのつるぎは、たけりたつししのように、預言者,よげんしゃたちを滅,ほろぼした。","tok":[["「"],["わたし"],["が"],["あなた"],["がた"],["の"],["子ども","こども"],["たち"],["を"],["打った","うった"],["の"],["は"],["むだ"],["で"],["あった"],["。"],["彼","かれ"],["ら"],["は"],["戒しめ","いましめ"],["を"],["受ず","うけず"],["、"],["あなた"],["がた"],["の"],["つるぎ"],["は"],["、"],["たけりたつ"],["しし"],["の"],["よう"],["に"],["、"],["預言者","よげんしゃ"],["たち"],["を"],["滅ぼした","ほろぼした"],["。"]]},{"verse":31,"text":"あなたがたこの世代,せだいの人,ひとよ、主,しゅの言葉,ことばを聞,きけ。わたしはイスラエルにとって、荒野,あらのであったであろうか。暗黒,あんこくの地,ちであったであろうか。それならなぜ、わたしの民,たみは『われわれは自由,じゆうだ、もはやあなたのところへは行,いかない』と言,いうのか。","tok":[["あなた"],["が"],["たこ"],["の"],["世代","せだい"],["の"],["人","ひと"],["よ"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["を"],["聞け","きけ"],["。"],["わたし"],["は"],["イスラエル"],["にとって"],["、"],["荒野","あらの"],["で"],["あったで"],["あろう"],["か"],["。"],["暗黒","あんこく"],["の"],["地","ち"],["で"],["あったで"],["あろう"],["か"],["。"],["それ"],["なら"],["なぜ"],["、"],["わたし"],["の"],["民","たみ"],["は"],["『"],["われわれ"],["は"],["自由","じゆう"],["だ"],["、"],["もはや"],["あなた"],["の"],["ところ"],["へ"],["は"],["行かない","いかない"],["』"],["と"],["言う","いう"],["の"],["か"],["。"]]},{"verse":32,"text":"おとめはその飾,かざり物,ものを忘,わすれることができようか。花嫁,はなよめはその帯,おびを忘,わすれることができようか。ところが、わたしの民,たみの、わたしを忘,わすれた日,ひは数,かぞえがたい。","tok":[["おとめ"],["は"],["その"],["飾","かざり"],["物","もの"],["を"],["忘る","わすれる"],["こと"],["が"],["できよう"],["か"],["。"],["花嫁","はなよめ"],["は"],["その"],["帯","おび"],["を"],["忘る","わすれる"],["こと"],["が"],["できよう"],["か"],["。"],["ところ"],["が"],["、"],["わたし"],["の"],["民","たみ"],["の"],["、"],["わたし"],["を"],["忘た","わすれた"],["日","ひ"],["は"],["数え","かぞえ"],["がたい"],["。"]]},{"verse":33,"text":"あなたは恋人,こいびとを尋,たずねて、いかにも巧,たくみにその方,ほうに足,あしを向,むける。それゆえ悪,わるい女,おんなさえ、あなたの道,みちを学,まなんだ。","tok":[["あなた"],["は"],["恋人","こいびと"],["を"],["尋ねて","たずねて"],["、"],["いかに"],["も"],["巧","たくみ"],["に"],["その"],["方","ほう"],["に"],["足","あし"],["を"],["向ける","むける"],["。"],["それ"],["ゆえ"],["悪い","わるい"],["女","おんな"],["さえ"],["、"],["あなた"],["の"],["道","みち"],["を"],["学んだ","まなんだ"],["。"]]},{"verse":34,"text":"また、あなたの着物,きもののすそには罪,つみのない貧,まずしい人,ひとの命,いのちの血,ちがついている。あなたは彼,かれらが押,おし入,いるのを見,みたのではない。しかも、すべてこれらの事,ことにもかかわらず、","tok":[["また"],["、"],["あなた"],["の"],["着物","きもの"],["の"],["すそ"],["に"],["は"],["罪","つみ"],["の"],["ない"],["貧しい","まずしい"],["人","ひと"],["の"],["命","いのち"],["の"],["血","ち"],["が"],["ついて"],["いる"],["。"],["あなた"],["は"],["彼","かれ"],["ら"],["が"],["押入る","おしいる"],["の"],["を"],["見た","みた"],["ので"],["は"],["ない"],["。"],["しかも"],["、"],["すべて"],["これ"],["ら"],["の"],["事","こと"],["に"],["も"],["かかわらず"],["、"]]},{"verse":35,"text":"あなたは言,いう、『わたしは罪,つみがない。彼,かれの怒,いかりは、決,けっしてわたしに臨,のぞむことがない』と。あなたが『わたしは罪,つみを犯,おかさなかった』と言,いうことによって、わたしはあなたをさばく。","tok":[["あなた"],["は"],["言う","いう"],["、"],["『"],["わたし"],["は"],["罪","つみ"],["が"],["ない"],["。"],["彼","かれ"],["の"],["怒り","いかり"],["は"],["、"],["決っして","けっして"],["わたし"],["に"],["臨む","のぞむ"],["こと"],["が"],["ない"],["』"],["と"],["。"],["あなた"],["が"],["『"],["わたし"],["は"],["罪","つみ"],["を"],["犯さなかった","おかさなかった"],["』"],["と"],["言う","いう"],["こと"],["によって"],["、"],["わたし"],["は"],["あなた"],["を"],["さばく"],["。"]]},{"verse":36,"text":"あなたはなぜ軽々,かるがるしくさまよって、その道,みちを変,かえようとするのか。あなたはアッスリヤに、はずかしめを受,うけたように、エジプトにもまた、はずかしめを受,うける。","tok":[["あなた"],["は"],["なぜ"],["軽々しく","かるがるしく"],["さまよって"],["、"],["その"],["道","みち"],["を"],["変えよう","かえよう"],["と"],["する"],["の"],["か"],["。"],["あなた"],["は"],["アッスリヤ"],["に"],["、"],["はずかしめ"],["を"],["受た","うけた"],["よう"],["に"],["、"],["エジプト"],["に"],["も"],["また"],["、"],["はずかしめ"],["を"],["受る","うける"],["。"]]},{"verse":37,"text":"あなたはまた両手,りょうてを頭,あたまに置,おいて、そこから出,でて来,くる。主,しゅがあなたの頼,たのみとする者,ものどもを捨,すてられたので、あなたは彼,かれらによって栄,さかえることがないからだ。","tok":[["あなた"],["は"],["また"],["両手","りょうて"],["を"],["頭","あたま"],["に"],["置いて","おいて"],["、"],["そこ"],["から"],["出て","でて"],["来る","くる"],["。"],["主","しゅ"],["が"],["あなた"],["の"],["頼み","たのみ"],["と"],["する"],["者","もの"],["ども"],["を"],["捨てられた","すてられた"],["ので"],["、"],["あなた"],["は"],["彼","かれ"],["ら"],["によって"],["栄","さかえ"],["る"],["こと"],["が"],["ない"],["から"],["だ"],["。"]]}]
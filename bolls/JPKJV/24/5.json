[{"verse":1,"text":"エルサレムのちまたを行,いきめぐり、見,みて、知,しるがよい。その広場,ひろばを尋,たずねて、公平,こうへいを行,おこない、真実,しんじつを求,もとめる者,ものが、ひとりでもあるか捜,さがしてみよ。あれば、わたしはエルサレムをゆるす。","tok":[["エルサレム"],["の"],["ちまた"],["を"],["行き","いき"],["めぐり"],["、"],["見て","みて"],["、"],["知る","しる"],["が"],["よい"],["。"],["その"],["広場","ひろば"],["を"],["尋ねて","たずねて"],["、"],["公平","こうへい"],["を"],["行ない","おこない"],["、"],["真実","しんじつ"],["を"],["求める","もとめる"],["者","もの"],["が"],["、"],["ひとり"],["で"],["も"],["ある"],["か"],["捜して","さがして"],["み"],["よ"],["。"],["あれば"],["、"],["わたし"],["は"],["エルサレム"],["を"],["ゆるす"],["。"]]},{"verse":2,"text":"彼,かれらは、「主,しゅは生,いきておられる」と言,いうけれども、実,じつは、偽,いつわって誓,ちかうのだ。","tok":[["彼","かれ"],["ら"],["は"],["、"],["「"],["主","しゅ"],["は"],["生きて","いきて"],["おられる"],["」"],["と"],["言","いうけれど"],["も"],["、"],["実","じつ"],["は"],["、"],["偽わって","いつわって"],["誓う","ちかう"],["の"],["だ"],["。"]]},{"verse":3,"text":"主,しゅよ、あなたの目,めは、真実,しんじつを顧,かえりみられるではありませんか。あなたが彼,かれらを打,うたれても、痛,いたみを覚,おぼえず、彼,かれらを滅,ほろぼされても、懲,こらしめを受,うけることを拒,こばみ、その顔,かおを岩,いわよりも堅,かたくして、悔,くい改,あらためることを拒,こばみました。","tok":[["主","しゅ"],["よ"],["、"],["あなた"],["の"],["目","め"],["は"],["、"],["真実","しんじつ"],["を"],["顧られるで","かえりみられるで"],["は"],["ありません"],["か"],["。"],["あなた"],["が"],["彼","かれ"],["ら"],["を"],["打たれて","うたれて"],["も"],["、"],["痛み","いたみ"],["を"],["覚えず","おぼえず"],["、"],["彼","かれ"],["ら"],["を"],["滅ぼされて","ほろぼされて"],["も"],["、"],["懲らしめ","こらしめ"],["を"],["受る","うける"],["こと"],["を"],["拒み","こばみ"],["、"],["その"],["顔","かお"],["を"],["岩","いわ"],["より"],["も"],["堅く","かたく"],["して"],["、"],["悔い改める","くいあらためる"],["こと"],["を"],["拒みました","こばみました"],["。"]]},{"verse":4,"text":"それで、わたしは言,いった、「これらはただ貧,まずしい愚,おろかな人々,ひとびとで、主,しゅの道,みちと、神,かみのおきてを知,しりません。","tok":[["それ"],["で"],["、"],["わたし"],["は"],["言った","いった"],["、"],["「"],["これ"],["ら"],["は"],["ただ"],["貧しい","まずしい"],["愚か","おろか"],["な"],["人々","ひとびと"],["で"],["、"],["主","しゅ"],["の"],["道","みち"],["と"],["、"],["神","かみ"],["の"],["おきて"],["を"],["知りません","しりません"],["。"]]},{"verse":5,"text":"わたしは偉,えらい人,ひとたちの所,ところへ行,いって、彼,かれらに語,かたります。彼,かれらは主,しゅの道,みちを知,しり、神,かみのおきてを知,しっています」。ところが、彼,かれらも皆,みなおなじように、くびきを折,おり、なわめを断,たっていた。","tok":[["わたし"],["は"],["偉い","えらい"],["人","ひと"],["たち"],["の"],["所","ところ"],["へ"],["行って","いって"],["、"],["彼","かれ"],["ら"],["に"],["語ります","かたります"],["。"],["彼","かれ"],["ら"],["は"],["主","しゅ"],["の"],["道","みち"],["を"],["知り","しり"],["、"],["神","かみ"],["の"],["おきて"],["を"],["知って","しって"],["います"],["」"],["。"],["ところ"],["が"],["、"],["彼","かれ"],["ら"],["も"],["皆","みな"],["おなじ"],["よう"],["に"],["、"],["くびき"],["を"],["折","おり"],["、"],["なわ"],["め"],["を"],["断って","たって"],["いた"],["。"]]},{"verse":6,"text":"それゆえ林,はやしから、ししが出,でてきて彼,かれらを殺,ころし、荒野,あらのから、おおかみが出,でてきて彼,かれらを滅,ほろぼす。ひょうは彼,かれらの町々,まちまちをねらっている。そこから出,でる者,ものはみな裂,さかれる。彼,かれらの罪,つみが多,おおく、その背信,はいしんがはなはだしいからである。","tok":[["それ"],["ゆえ"],["林","はやし"],["から"],["、"],["しし"],["が"],["出て","でて"],["きて"],["彼","かれ"],["ら"],["を"],["殺ろし","ころし"],["、"],["荒野","あら"],["の"],["から"],["、"],["おおかみ"],["が"],["出て","でて"],["きて"],["彼","かれ"],["ら"],["を"],["滅ぼす","ほろぼす"],["。"],["ひょう"],["は"],["彼","かれ"],["ら"],["の"],["町々","まちまち"],["を"],["ねらって"],["いる"],["。"],["そこ"],["から"],["出る","でる"],["者","もの"],["は"],["みな"],["裂かれる","さかれる"],["。"],["彼","かれ"],["ら"],["の"],["罪","つみ"],["が"],["多く","おおく"],["、"],["その"],["背信","はいしん"],["が"],["はなはだしい"],["から"],["で"],["ある"],["。"]]},{"verse":7,"text":"「わたしはどうしてあなたを、ゆるすことができようか。あなたの子,こどもらは、わたしを捨,すてさり、神,かみでもないものをさして誓,ちかった。わたしが彼,かれらを満,みち足,たらせた時,とき、彼,かれらは姦淫,かんいんを行,おこない、遊女,ゆうじょの家,いえに群,むれ集,あつまった。","tok":[["「"],["わたし"],["は"],["どう"],["して"],["あなた"],["を"],["、"],["ゆるす"],["こと"],["が"],["できよう"],["か"],["。"],["あなた"],["の"],["子ども","こども"],["ら"],["は"],["、"],["わたし"],["を"],["捨てさり","すてさり"],["、"],["神","かみ"],["で"],["も"],["ない"],["もの"],["を"],["さして"],["誓った","ちかった"],["。"],["わたし"],["が"],["彼","かれ"],["ら"],["を"],["満ち","みち"],["足らせた","たらせた"],["時","とき"],["、"],["彼","かれ"],["ら"],["は"],["姦淫","かんいん"],["を"],["行ない","おこない"],["、"],["遊女","ゆうじょ"],["の"],["家","いえ"],["に"],["群れ集まった","むれあつまった"],["。"]]},{"verse":8,"text":"彼,かれらは肥,こえ太,ふとった丈夫,じょうぶな雄,お馬,うまのように、おのおの、いなないて隣,となりの妻,つまを慕,したう。","tok":[["彼","かれ"],["ら"],["は"],["肥","こえ"],["太った","ふとった"],["丈夫","じょうぶ"],["な"],["雄馬","おうま"],["の"],["よう"],["に"],["、"],["おのおの"],["、"],["いなないて"],["隣","となり"],["の"],["妻","つま"],["を"],["慕う","したう"],["。"]]},{"verse":9,"text":"わたしはこれらの事,ことのために彼,かれらを罰,ばっしないでいられようか。このような国民,こくみんにあだを返,かえさないであろうか」と主,しゅは言,いわれる。","tok":[["わたし"],["は"],["これ"],["ら"],["の"],["事","こと"],["の"],["ため"],["に"],["彼","かれ"],["ら"],["を"],["罰しないで","ばっしないで"],["いられよう"],["か"],["。"],["この"],["よう"],["な"],["国民","こくみん"],["に"],["あだ"],["を"],["返えさないで","かえさないで"],["あろう"],["か"],["」"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":10,"text":"「あなたがたはユダのぶどうの並,なみ木,きの間,あいだを、のぼって行,いって、滅,ほろぼせ、ただ、ことごとく滅,ほろぼしてはならない。その枝,えだを切,きり除,のぞけ、主,しゅのものではないからである。","tok":[["「"],["あなた"],["がた"],["は"],["ユダ"],["の"],["ぶどう"],["の"],["並木","なみき"],["の"],["間","あいだ"],["を"],["、"],["のぼって"],["行って","いって"],["、"],["滅ぼせ","ほろぼせ"],["、"],["ただ"],["、"],["ことごとく"],["滅ぼして","ほろぼして"],["は"],["ならない"],["。"],["その"],["枝","えだ"],["を"],["切り除け","きりのぞけ"],["、"],["主","しゅ"],["の"],["もの"],["で"],["は"],["ない"],["から"],["で"],["ある"],["。"]]},{"verse":11,"text":"イスラエルの家,いえとユダの家,いえとはわたしにまったく不信,ふしんであった」と主,しゅは言,いわれる。","tok":[["イスラエル"],["の"],["家","いえ"],["と"],["ユダ"],["の"],["家","いえ"],["と"],["は"],["わたし"],["に"],["まったく"],["不信","ふしん"],["で"],["あった"],["」"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":12,"text":"「彼,かれらは主,しゅについて偽,いつわり語,かたって言,いった、『主,しゅは何事,なにごともなされない、災,わざわいはわれわれに来,きない、またつるぎや、ききんを見,みることはない。","tok":[["「"],["彼","かれ"],["ら"],["は"],["主に","しゅに"],["ついて"],["偽わり","いつわり"],["語って","かたって"],["言った","いった"],["、"],["『"],["主","しゅ"],["は"],["何事","なにごと"],["も"],["なされない"],["、"],["災","わざわい"],["は"],["われわれ"],["に"],["来ない","きない"],["、"],["また"],["つるぎ"],["や"],["、"],["ききん"],["を"],["見る","みる"],["こと"],["は"],["ない"],["。"]]},{"verse":13,"text":"預言者,よげんしゃらは風,かぜとなり、彼,かれらのうちに言葉,ことばはない。彼,かれらはこのようになる』と」。","tok":[["預言者","よげんしゃ"],["ら"],["は"],["風","かぜ"],["と"],["なり"],["、"],["彼","かれ"],["ら"],["の"],["うち"],["に"],["言葉","ことば"],["は"],["ない"],["。"],["彼","かれ"],["ら"],["は"],["この"],["よう"],["に"],["なる"],["』"],["と"],["」"],["。"]]},{"verse":14,"text":"それゆえ万軍,ばんぐんの神,かみ、主,しゅはこう言,いわれる、「彼,かれらがこの言葉,ことばを語,かたったので、見,みよ、わたしはあなたの口,くちにあるわたしの言葉,ことばを火,ひとし、この民,たみをたきぎとする。火,ひは彼,かれらを焼,やき尽,つくす」。","tok":[["それ"],["ゆえ"],["万","まん"],["軍","ぐん"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["「"],["彼","かれ"],["ら"],["が"],["この"],["言葉","ことば"],["を"],["語った","かたった"],["ので"],["、"],["見よ","みよ"],["、"],["わたし"],["は"],["あなた"],["の"],["口","くち"],["に"],["ある"],["わたし"],["の"],["言葉","ことば"],["を"],["火","ひ"],["と"],["し"],["、"],["この"],["民","たみ"],["を"],["たきぎ"],["と"],["する"],["。"],["火","ひ"],["は"],["彼","かれ"],["ら"],["を"],["焼き","やき"],["尽くす","つくす"],["」"],["。"]]},{"verse":15,"text":"主,しゅは言,いわれる、「イスラエルの家,いえよ、見,みよ、わたしは遠,とおい国,くにの民,たみをあなたがたのところに攻,せめこさせる。その国,くには長,ながく続,つづく国,くに、古,ふるい国,くにで、あなたがたはその国,くにの言葉,ことばを知,しらず、人々,ひとびとの語,かたるのを悟,さとることもできない。","tok":[["主","しゅ"],["は"],["言われる","いわれる"],["、"],["「"],["イスラエル"],["の"],["家","いえ"],["よ"],["、"],["見よ","みよ"],["、"],["わたし"],["は"],["遠い","とおい"],["国","くに"],["の"],["民","たみ"],["を"],["あなた"],["がた"],["の"],["ところ"],["に"],["攻め","せめ"],["こさせる"],["。"],["その"],["国","くに"],["は"],["長く","ながく"],["続く","つづく"],["国","くに"],["、"],["古い","ふるい"],["国","くに"],["で"],["、"],["あなた"],["がた"],["は"],["その"],["国","くに"],["の"],["言葉","ことば"],["を"],["知らず","しらず"],["、"],["人々","ひとびと"],["の"],["語る","かたる"],["の"],["を"],["悟","さとる"],["こと"],["も"],["できない"],["。"]]},{"verse":16,"text":"その箙,えびらは開,ひらいた墓,はかのようであり、彼,かれらはみな勇士,ゆうしである。","tok":[["その"],["箙","えびら"],["は"],["開らいた","ひらいた"],["墓","はか"],["の"],["よう"],["で"],["あり"],["、"],["彼","かれ"],["ら"],["は"],["みな"],["勇士","ゆうし"],["で"],["ある"],["。"]]},{"verse":17,"text":"彼,かれらはあなたが刈,かり入,いれた物,ものと、あなたの糧食,りょうしょくとを食,くい尽,つくし、あなたのむすこ娘,むすめを食,くい尽,つくし、あなたの羊,ひつじと牛,うしを食,くい尽,つくし、あなたのぶどうの木,きといちじくの木,きを食,くい尽,つくし、またつるぎをもって、あなたが頼,たのみとする堅固,けんごな町々,まちまちを滅,ほろぼす」。","tok":[["彼","かれ"],["ら"],["は"],["あなた"],["が"],["刈入れた","かりいれた"],["物","もの"],["と"],["、"],["あなた"],["の"],["糧食","りょうしょく"],["と"],["を"],["食い","くい"],["尽くし","つくし"],["、"],["あなた"],["の"],["むすこ"],["娘","むすめ"],["を"],["食い","くい"],["尽くし","つくし"],["、"],["あなた"],["の"],["羊","ひつじ"],["と"],["牛","うし"],["を"],["食い","くい"],["尽くし","つくし"],["、"],["あなた"],["の"],["ぶどう"],["の"],["木","き"],["と"],["いちじく"],["の"],["木","き"],["を"],["食い","くい"],["尽くし","つくし"],["、"],["また"],["つるぎ"],["を"],["もって"],["、"],["あなた"],["が"],["頼み","たのみ"],["と"],["する"],["堅固","けんご"],["な"],["町々","まちまち"],["を"],["滅ぼす","ほろぼす"],["」"],["。"]]},{"verse":18,"text":"主,しゅは言,いわれる、「しかしその時,ときでも、わたしはことごとくはあなたを滅,ほろぼさない。","tok":[["主","しゅ"],["は"],["言われる","いわれる"],["、"],["「"],["しかし"],["その"],["時","とき"],["で"],["も"],["、"],["わたし"],["は"],["ことごとく"],["は"],["あなた"],["を"],["滅ぼさない","ほろぼさない"],["。"]]},{"verse":19,"text":"あなたの民,たみが、『どうしてわれわれの神,かみ、主,しゅはこれらのすべての事,ことをわれわれになされたのか』と言,いうならば、あなたは彼,かれらに答,こたえなければならない、『あなたがたがわたしを捨,すてて、自分,じぶんの地,ちで異,ことなる神々,かみがみに仕,つかえたように、あなたがたは自分,じぶんのものでない地,ちで異邦,いほうの人,ひとに仕,つかえるようになる』と」。","tok":[["あなた"],["の"],["民","たみ"],["が"],["、"],["『"],["どう"],["して"],["われわれ"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["これ"],["ら"],["の"],["すべて"],["の"],["事","こと"],["を"],["われわれ"],["に"],["なされた"],["の"],["か"],["』"],["と"],["言うならば","いうならば"],["、"],["あなた"],["は"],["彼","かれ"],["ら"],["に"],["答","こたえ"],["なければ"],["ならない"],["、"],["『"],["あなた"],["がた"],["が"],["わたし"],["を"],["捨てて","すてて"],["、"],["自分","じぶん"],["の"],["地","ち"],["で"],["異なる","ことなる"],["神々","かみがみ"],["に"],["仕えた","つかえた"],["よう"],["に"],["、"],["あなた"],["がた"],["は"],["自分","じぶん"],["の"],["もの"],["で"],["ない"],["地","ち"],["で"],["異邦","いほう"],["の"],["人","ひと"],["に"],["仕える","つかえる"],["よう"],["に"],["なる"],["』"],["と"],["」"],["。"]]},{"verse":20,"text":"これをヤコブの家,いえにのべ、またユダに示,しめして言,いえ、","tok":[["これ"],["を"],["ヤコブ"],["の"],["家","いえ"],["に"],["のべ"],["、"],["また"],["ユダ"],["に"],["示めして","しめして"],["言え","いえ"],["、"]]},{"verse":21,"text":"「愚,おろかで、悟,さとりもなく、目,めがあっても見,みえず、耳,みみがあっても聞,きこえない民,たみよ、これを聞,きけ。","tok":[["「"],["愚か","おろか"],["で"],["、"],["悟り","さとり"],["も"],["なく"],["、"],["目","め"],["が"],["あって"],["も"],["見えず","みえず"],["、"],["耳","みみ"],["が"],["あって"],["も"],["聞こえない","きこえない"],["民","たみ"],["よ"],["、"],["これ"],["を"],["聞け","きけ"],["。"]]},{"verse":22,"text":"主,しゅは言,いわれる、あなたがたはわたしを恐,おそれないのか、わたしの前,まえにおののかないのか。わたしは砂,すなを置,おいて海,うみの境,さかいとし、これを永遠,えいえんの限界,げんかいとして、越,こえることができないようにした。波,なみはさかまいても、勝,かつことはできない、鳴,なりわたっても、これを越,こえることはできない。","tok":[["主","しゅ"],["は"],["言われる","いわれる"],["、"],["あなた"],["がた"],["は"],["わたし"],["を"],["恐れない","おそれない"],["の"],["か"],["、"],["わたし"],["の"],["前","まえ"],["に"],["おののかない"],["の"],["か"],["。"],["わたし"],["は"],["砂","すな"],["を"],["置いて","おいて"],["海","うみ"],["の"],["境","さかい"],["と"],["し"],["、"],["これ"],["を"],["永遠","えいえん"],["の"],["限界","げんかい"],["として"],["、"],["越える","こえる"],["こと"],["が"],["できない"],["よう"],["に"],["した"],["。"],["波","なみ"],["は"],["さかまいて"],["も"],["、"],["勝つ","かつ"],["こと"],["は"],["できない"],["、"],["鳴り","なり"],["わたって"],["も"],["、"],["これ"],["を"],["越える","こえる"],["こと"],["は"],["できない"],["。"]]},{"verse":23,"text":"ところが、この民,たみには強情,ごうじょうな、そむく心,こころがあり、彼,かれらはわき道,みちにそれて、去,さってしまった。","tok":[["ところ"],["が"],["、"],["この"],["民","たみ"],["に"],["は"],["強情","ごうじょう"],["な"],["、"],["そむく"],["心","こころ"],["が"],["あり"],["、"],["彼","かれ"],["ら"],["は"],["わき道","わきみち"],["に"],["それて"],["、"],["去て","さって"],["しまった"],["。"]]},{"verse":24,"text":"彼,かれらは『われわれに雨,あめを与,あたえ、秋,あきの雨,あめと春,はるの雨,あめを時,ときにしたがって降,ふらせ、われわれのために刈入,かりいれの時,ときを定,さだめられたわれわれの神,かみ、主,しゅを恐,おそれよう』とその心,こころのうちに言,いわないのだ。","tok":[["彼","かれ"],["ら"],["は"],["『"],["われわれ"],["に"],["雨","あめ"],["を"],["与","あたえ"],["、"],["秋","あき"],["の"],["雨","あめ"],["と"],["春","はる"],["の"],["雨","あめ"],["を"],["時","とき"],["に"],["したがって"],["降らせ","ふらせ"],["、"],["われわれ"],["の"],["ため"],["に"],["刈入れ","かりいれ"],["の"],["時","とき"],["を"],["定められた","さだめられた"],["われわれ"],["の"],["神","かみ"],["、"],["主","しゅ"],["を"],["恐","おそれ"],["よう"],["』"],["と"],["その"],["心","こころ"],["の"],["うち"],["に"],["言わない","いわない"],["の"],["だ"],["。"]]},{"verse":25,"text":"あなたがたのとがは、これらの事,ことをしりぞけ、あなたがたの罪,つみは、良,よい物,ものがあなたがたに来,くるのをさまたげた。","tok":[["あなた"],["がた"],["の"],["とが"],["は"],["、"],["これ"],["ら"],["の"],["事","こと"],["を"],["しりぞけ"],["、"],["あなた"],["がた"],["の"],["罪","つみ"],["は"],["、"],["良い","よい"],["物","もの"],["が"],["あなた"],["がた"],["に"],["来る","くる"],["の"],["を"],["さまたげた"],["。"]]},{"verse":26,"text":"わが民,たみのうちには悪,わるい者,ものがあって、鳥,とりをとる人,ひとのように身,みをかがめてうかがい、わなを置,おいて人,ひとを捕,とらえる。","tok":[["わが"],["民","たみ"],["の"],["うち"],["に"],["は"],["悪い","わるい"],["者","もの"],["が"],["あって"],["、"],["鳥","とり"],["を"],["とる"],["人","ひと"],["の"],["よう"],["に"],["身","み"],["を"],["かがめて"],["うかがい"],["、"],["わな"],["を"],["置いて","おいて"],["人","ひと"],["を"],["捕らえる","とらえる"],["。"]]},{"verse":27,"text":"かごに鳥,とりが満,みちているように、彼,かれらの家,いえは不義,ふぎの宝,たからで満,みちている。それゆえ、彼,かれらは大,おおいなる者,もの、裕福,ゆうふくな者,ものとなり、","tok":[["かご"],["に"],["鳥","とり"],["が"],["満ちて","みちて"],["いる"],["よう"],["に"],["、"],["彼","かれ"],["ら"],["の"],["家","いえ"],["は"],["不義","ふぎ"],["の"],["宝","たから"],["で"],["満ちて","みちて"],["いる"],["。"],["それ"],["ゆえ"],["、"],["彼","かれ"],["ら"],["は"],["大いなる","おおいなる"],["者","もの"],["、"],["裕福","ゆうふく"],["な"],["者","もの"],["と"],["なり"],["、"]]},{"verse":28,"text":"肥,こえて、つやがあり、その悪,あしき行,おこないには際限,さいげんがない。彼,かれらは公正,こうせいに、みなしごの訴,うったえをさばいて、それを助,たすけようとはせず、また貧,まずしい人,ひとの訴,うったえをさばかない。","tok":[["肥","こえ"],["て"],["、"],["つや"],["が"],["あり"],["、"],["その"],["悪しき","あしき"],["行ない","おこない"],["に"],["は"],["際限","さいげん"],["が"],["ない"],["。"],["彼","かれ"],["ら"],["は"],["公正","こうせい"],["に"],["、"],["みなしご"],["の"],["訴","うったえ"],["を"],["さばいて"],["、"],["それ"],["を"],["助けよう","たすけよう"],["と"],["は"],["せず"],["、"],["また"],["貧しい","まずしい"],["人","ひと"],["の"],["訴","うったえ"],["を"],["さばかない"],["。"]]},{"verse":29,"text":"主,しゅは言,いわれる、わたしはこのような事,ことのために、彼,かれらを罰,ばっしないであろうか。わたしはこのような民,たみに、あだを返,かえさないであろうか」。","tok":[["主","しゅ"],["は"],["言われる","いわれる"],["、"],["わたし"],["は"],["この"],["よう"],["な"],["事","こと"],["の"],["ため"],["に"],["、"],["彼","かれ"],["ら"],["を"],["罰しないで","ばっしないで"],["あろう"],["か"],["。"],["わたし"],["は"],["この"],["よう"],["な"],["民","たみ"],["に"],["、"],["あだ"],["を"],["返えさないで","かえさないで"],["あろう"],["か"],["」"],["。"]]},{"verse":30,"text":"驚,おどろくべきこと、恐,おそるべきことがこの地,ちに起,たっている。","tok":[["驚ろくべき","おどろくべき"],["こと"],["、"],["恐るべき","おそるべき"],["こと"],["が"],["この"],["地","ち"],["に"],["起って","たって"],["いる"],["。"]]},{"verse":31,"text":"預言者,よげんしゃは偽,いつわって預言,よげんし、祭司,さいしは自分,じぶんの手,てによって治,おさめ、わが民,たみはこのようにすることを愛,あいしている。しかしあなたがたはその終,おわりにはどうするつもりか。","tok":[["預言者","よげんしゃ"],["は"],["偽わって","いつわって"],["預言","よげん"],["し"],["、"],["祭司","さいし"],["は"],["自分","じぶん"],["の"],["手","て"],["によって"],["治め","おさめ"],["、"],["わが"],["民","たみ"],["は"],["この"],["よう"],["に"],["する"],["こと"],["を"],["愛して","あいして"],["いる"],["。"],["しかし"],["あなた"],["がた"],["は"],["その"],["終","おわり"],["に"],["は"],["どう"],["する"],["つもり"],["か"],["。"]]}]
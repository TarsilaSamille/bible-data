[{"verse":1,"text":"ベニヤミンの人々,ひとびとよ、エルサレムの中,なかから避難,ひなんせよ。テコアでラッパを吹,ふき、ベテハケレムに合図,あいずの火,ひをあげよ。北,きたから災,わざわいが臨,のぞみ、大,おおいなる滅,ほろびが来,くるからである。","tok":[["ベニヤミン"],["の"],["人々","ひとびと"],["よ"],["、"],["エルサレム"],["の"],["中","なか"],["から"],["避難","ひなん"],["せよ"],["。"],["テコア"],["で"],["ラッパ"],["を"],["吹","ふき"],["、"],["ベテハケレム"],["に"],["合図","あいず"],["の"],["火","ひ"],["を"],["あげ"],["よ"],["。"],["北","きた"],["から"],["災","わざわい"],["が"],["臨み","のぞみ"],["、"],["大いなる","おおいなる"],["滅び","ほろび"],["が"],["来る","くる"],["から"],["で"],["ある"],["。"]]},{"verse":2,"text":"わたしは美,うつくしい、たおやかなシオンの娘,むすめを滅,ほろぼす。","tok":[["わたし"],["は"],["美しい","うつくしい"],["、"],["たおやか"],["な"],["シオン"],["の"],["娘","むすめ"],["を"],["滅ぼす","ほろぼす"],["。"]]},{"verse":3,"text":"牧者,ぼくしゃたちは、その群,むれをひきいて来,きて、彼女,かのじょを攻,せめ、彼女,かのじょの周囲,しゅういに天幕,てんまくを張,はる。群,むれはおのおのその所,ところで草,くさを食,くう。","tok":[["牧者","ぼくしゃ"],["たち"],["は"],["、"],["その"],["群れ","むれ"],["を"],["ひきいて"],["来て","きて"],["、"],["彼女","かのじょ"],["を"],["攻め","せめ"],["、"],["彼女","かのじょ"],["の"],["周囲","しゅうい"],["に"],["天幕","てんまく"],["を"],["張る","はる"],["。"],["群れ","むれ"],["は"],["おのおの"],["その"],["所","ところ"],["で"],["草","くさ"],["を"],["食う","くう"],["。"]]},{"verse":4,"text":"「戦,たたかいを始,はじめ、彼女,かのじょを攻,せめよ。立,たて、われわれは真昼,まひるに攻撃,こうげきしよう」。「わざわいなるかな、日,ひははや傾,かたむき、夕日,ゆうひの影,かげは長,ながくなった」。","tok":[["「"],["戦い","たたかい"],["を"],["始め","はじめ"],["、"],["彼女","かのじょ"],["を"],["攻めよ","せめよ"],["。"],["立","たて"],["、"],["われわれ"],["は"],["真昼","まひる"],["に"],["攻撃","こうげき"],["しよう"],["」"],["。"],["「"],["わざわい"],["なる"],["か"],["な"],["、"],["日","ひ"],["は"],["はや"],["傾き","かたむき"],["、"],["夕日","ゆうひ"],["の"],["影","かげ"],["は"],["長く","ながく"],["なった"],["」"],["。"]]},{"verse":5,"text":"「立,たて、われわれは夜,よるの間,あいだに攻撃,こうげきしよう、そして彼女,かのじょのもろもろの宮殿,きゅうでんを破壊,はかいしよう」。","tok":[["「"],["立","たて"],["、"],["われわれ"],["は"],["夜","よる"],["の"],["間","あいだ"],["に"],["攻撃","こうげき"],["しよう"],["、"],["そして"],["彼女","かのじょ"],["の"],["もろもろ"],["の"],["宮殿","きゅうでん"],["を"],["破壊","はかい"],["しよう"],["」"],["。"]]},{"verse":6,"text":"万軍,ばんぐんの主,しゅはこう言,いわれる、「あなたがたは彼女,かのじょの木,きを切,きり倒,たおし、エルサレムにむかって塁,るいを築,きずけ。これは罰,ばつすべき町,まちである、そのうちにはただ圧制,あっせいだけがある。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["「"],["あなた"],["がた"],["は"],["彼女","かのじょ"],["の"],["木","き"],["を"],["切り倒し","きりたおし"],["、"],["エルサレム"],["に"],["むかって"],["塁","るい"],["を"],["築け","きずけ"],["。"],["これ"],["は"],["罰すべき","ばつすべき"],["町","まち"],["で"],["ある"],["、"],["その"],["うち"],["に"],["は"],["ただ"],["圧制","あっせい"],["だけ"],["が"],["ある"],["。"]]},{"verse":7,"text":"井戸,いどに新,あたらしい水,みずがわくように彼女,かのじょはその悪,あくを常,つねにあらたに流,ながす。そのうちには暴虐,ぼうぎゃくと破滅,はめつとが聞,きこえる。わたしの前,まえに病,やまいと傷,きずとが絶,たえない。","tok":[["井戸","いど"],["に"],["新らしい","あたらしい"],["水","みず"],["が"],["わく"],["よう"],["に"],["彼女","かのじょ"],["は"],["その"],["悪","あく"],["を"],["常","つね"],["に"],["あらた"],["に"],["流す","ながす"],["。"],["その"],["うち"],["に"],["は"],["暴虐","ぼうぎゃく"],["と"],["破滅","はめつ"],["と"],["が"],["聞こえる","きこえる"],["。"],["わたし"],["の"],["前","まえ"],["に"],["病","やまい"],["と"],["傷","きず"],["と"],["が"],["絶えない","たえない"],["。"]]},{"verse":8,"text":"エルサレムよ、戒,いましめを受,うけいれよ。さもないと、わたしはあなたから離,はなれ、あなたを荒,あれ地,ちとし、住,すむ人,ひとのない地,ちとする」。","tok":[["エルサレム"],["よ"],["、"],["戒しめ","いましめ"],["を"],["受","うけ"],["いれよ"],["。"],["さも"],["ない"],["と"],["、"],["わたし"],["は"],["あなた"],["から"],["離れ","はなれ"],["、"],["あなた"],["を"],["荒れ地","あれち"],["と"],["し"],["、"],["住む","すむ"],["人","ひと"],["の"],["ない"],["地","ち"],["と"],["する"],["」"],["。"]]},{"verse":9,"text":"万軍,ばんぐんの主,しゅはこう言,いわれる、「ぶどうの残,のこりを摘,つみとるように、イスラエルの残,のこりの民,たみをのこらず摘,つみ取,とれ。ぶどうを摘,つみとる人,ひとのように、あなたの手,てをふたたびその枝,えだに伸,のばせ」。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["「"],["ぶどう"],["の"],["残り","のこり"],["を"],["摘みとる","つみとる"],["よう"],["に"],["、"],["イスラエル"],["の"],["残り","のこり"],["の"],["民","たみ"],["を"],["のこらず"],["摘み取れ","つみとれ"],["。"],["ぶどう"],["を"],["摘みとる","つみとる"],["人","ひと"],["の"],["よう"],["に"],["、"],["あなた"],["の"],["手","て"],["を"],["ふたたび"],["その"],["枝","えだ"],["に"],["伸ばせ","のばせ"],["」"],["。"]]},{"verse":10,"text":"わたしはだれに語,かたり、だれを戒,いましめて、聞,きかせようか。見,みよ、彼,かれらの耳,みみは閉,とざされて、聞,きくことができない。見,みよ、彼,かれらは主,しゅの言葉,ことばをあざけり、それを喜,よろこばない。","tok":[["わたし"],["は"],["だれ"],["に"],["語り","かたり"],["、"],["だれ"],["を"],["戒しめ","いましめ"],["て"],["、"],["聞かせよう","きかせよう"],["か"],["。"],["見よ","みよ"],["、"],["彼","かれ"],["ら"],["の"],["耳","みみ"],["は"],["閉ざされて","とざされて"],["、"],["聞く","きく"],["こと"],["が"],["できない"],["。"],["見よ","みよ"],["、"],["彼","かれ"],["ら"],["は"],["主","しゅ"],["の"],["言葉","ことば"],["を"],["あざけり"],["、"],["それ"],["を"],["喜こばない","よろこばない"],["。"]]},{"verse":11,"text":"それゆえ、わたしの身,みには主,しゅの怒,いかりが満,みち、それを忍,しのぶのに、うみつかれている。「それをちまたにいる子供,こどもらと、集,あつまっている若,わかい人々,ひとびととに漏,もらせ。夫,おっとも妻,つまも、老,おいた人,ひとも、年,ねんのひじょうに進,すすんだ人,ひとも捕,とらえられ、","tok":[["それ"],["ゆえ"],["、"],["わたし"],["の"],["身","み"],["に"],["は"],["主","しゅ"],["の"],["怒り","いかり"],["が"],["満ち","みち"],["、"],["それ"],["を"],["忍","しのぶ"],["のに"],["、"],["うみ"],["つかれて"],["いる"],["。"],["「"],["それ"],["を"],["ちまた"],["に"],["いる"],["子供","こども"],["ら"],["と"],["、"],["集まって","あつまって"],["いる"],["若い","わかい"],["人々","ひとびと"],["と"],["に"],["漏らせ","もらせ"],["。"],["夫","おっと"],["も"],["妻","つま"],["も"],["、"],["老","おい"],["た"],["人","ひと"],["も"],["、"],["年","ねん"],["の"],["ひじょう"],["に"],["進んだ","すすんだ"],["人","ひと"],["も"],["捕らえられ","とらえられ"],["、"]]},{"verse":12,"text":"彼,かれらの家,いえと畑,はたけと妻,つまとは共,ともに他人,たにんに渡,わたる。わたしが手,てを伸,のばして、この地,ちに住,すむ者,ものを撃,うつからである」と主,しゅは言,いわれる。","tok":[["彼","かれ"],["ら"],["の"],["家","いえ"],["と"],["畑","はたけ"],["と"],["妻","つま"],["と"],["は"],["共","とも"],["に"],["他人","たにん"],["に"],["渡る","わたる"],["。"],["わたし"],["が"],["手","て"],["を"],["伸ばして","のばして"],["、"],["この"],["地","ち"],["に"],["住む","すむ"],["者","もの"],["を"],["撃つ","うつ"],["から"],["で"],["ある"],["」"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":13,"text":"「それは彼,かれらが、小,ちいさい者,ものから大,おおきい者,ものまで、みな不正,ふせいな利,りをむさぼり、また預言者,よげんしゃから祭司,さいしにいたるまで、みな偽,いつわりを行,おこなっているからだ。","tok":[["「"],["それ"],["は"],["彼","かれ"],["ら"],["が"],["、"],["小さい","ちいさい"],["者","もの"],["から"],["大きい","おおきい"],["者","もの"],["まで"],["、"],["みな"],["不正","ふせい"],["な"],["利","り"],["を"],["むさぼり"],["、"],["また"],["預言者","よげんしゃ"],["から"],["祭司","さいし"],["に"],["いたる"],["まで"],["、"],["みな"],["偽り","いつわり"],["を"],["行なって","おこなって"],["いる"],["から"],["だ"],["。"]]},{"verse":14,"text":"彼,かれらは、手軽,てがるにわたしの民,たみの傷,きずをいやし、平安,へいあんがないのに『平安,へいあん、平安,へいあん』と言,いっている。","tok":[["彼","かれ"],["ら"],["は"],["、"],["手軽","てがる"],["に"],["わたし"],["の"],["民","たみ"],["の"],["傷","きず"],["を"],["いやし"],["、"],["平安","へいあん"],["が"],["ない"],["のに"],["『"],["平安","へいあん"],["、"],["平安","へいあん"],["』"],["と"],["言って","いって"],["いる"],["。"]]},{"verse":15,"text":"彼,かれらは憎,にくむべきことをして、恥,はじたであろうか。すこしも恥,はずかしいとは思,おもわず、また恥,はじることを知,しらなかった。それゆえ彼,かれらは倒,たおれる者,ものと共,ともに倒,たおれる。わたしが彼,かれらを罰,ばっするとき、彼,かれらは倒,たおれる」と主,しゅは言,いわれる。","tok":[["彼","かれ"],["ら"],["は"],["憎むべき","にくむべき"],["こと"],["を"],["して"],["、"],["恥","はじ"],["たで"],["あろう"],["か"],["。"],["すこし"],["も"],["恥ずかしい","はずかしい"],["と"],["は"],["思わず","おもわず"],["、"],["また"],["恥","はじ"],["る"],["こと"],["を"],["知らなかった","しらなかった"],["。"],["それ"],["ゆえ"],["彼","かれ"],["ら"],["は"],["倒れる","たおれる"],["者","もの"],["と"],["共","とも"],["に"],["倒れる","たおれる"],["。"],["わたし"],["が"],["彼","かれ"],["ら"],["を"],["罰する","ばっする"],["とき"],["、"],["彼","かれ"],["ら"],["は"],["倒れる","たおれる"],["」"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":16,"text":"主,しゅはこう言,いわれる、「あなたがたはわかれ道,みちに立,たって、よく見,み、いにしえの道,みちにつき、良,よい道,みちがどれかを尋,たずねて、その道,みちに歩,あゆみ、そしてあなたがたの魂,たましいのために、安息,あんそくを得,えよ。しかし彼,かれらは答,こたえて、『われわれはその道,みちに歩,あゆまない』と言,いった。","tok":[["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["「"],["あなた"],["がた"],["は"],["わかれ道","わかれみち"],["に"],["立って","たって"],["、"],["よく"],["見","み"],["、"],["いにしえ"],["の"],["道","みち"],["に"],["つき"],["、"],["良い","よい"],["道","みち"],["が"],["どれ"],["か"],["を"],["尋ねて","たずねて"],["、"],["その"],["道","みち"],["に"],["歩み","あゆみ"],["、"],["そして"],["あなた"],["がた"],["の"],["魂","たましい"],["の"],["ため"],["に"],["、"],["安息","あんそく"],["を"],["得","え"],["よ"],["。"],["しかし"],["彼","かれ"],["ら"],["は"],["答","こたえ"],["て"],["、"],["『"],["われわれ"],["は"],["その"],["道","みち"],["に"],["歩まない","あゆまない"],["』"],["と"],["言った","いった"],["。"]]},{"verse":17,"text":"わたしはあなたがたの上,うえに見張,みはりびとを立,たて、『ラッパの音,おとに気,きをつけよ』と言,いった。しかし彼,かれらは答,こたえて、『われわれは気,きをつけることはしない』と言,いった。","tok":[["わたし"],["は"],["あなた"],["がた"],["の"],["上","うえ"],["に"],["見張","みはり"],["びと"],["を"],["立て","たて"],["、"],["『"],["ラッパ"],["の"],["音","おと"],["に"],["気","き"],["を"],["つけよ"],["』"],["と"],["言った","いった"],["。"],["しかし"],["彼","かれ"],["ら"],["は"],["答","こたえ"],["て"],["、"],["『"],["われわれ"],["は"],["気","き"],["を"],["つける"],["こと"],["は"],["しない"],["』"],["と"],["言った","いった"],["。"]]},{"verse":18,"text":"それゆえ国々,くにぐにの民,たみよ、聞,きけ。会衆,かいしゅうよ、彼,かれらにどのようなことが起,おこるかを知,しれ。","tok":[["それ"],["ゆえ"],["国々","くにぐに"],["の"],["民","たみ"],["よ"],["、"],["聞け","きけ"],["。"],["会衆","かいしゅう"],["よ"],["、"],["彼","かれ"],["ら"],["に"],["どのような"],["こと"],["が"],["起こる","おこる"],["か"],["を"],["知れ","しれ"],["。"]]},{"verse":19,"text":"地,ちよ、聞,きけ。見,みよ、わたしはこの民,たみに災,わざわいをくだす。それは彼,かれらのたくらみの実,みである。彼,かれらがわたしの言葉,ことばに気,きをつけず、わたしのおきてを捨,すてたからである。","tok":[["地","ち"],["よ"],["、"],["聞け","きけ"],["。"],["見よ","みよ"],["、"],["わたし"],["は"],["この"],["民","たみ"],["に"],["災","わざわい"],["を"],["くだす"],["。"],["それ"],["は"],["彼","かれ"],["ら"],["の"],["たくらみ"],["の"],["実","み"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["が"],["わたし"],["の"],["言葉","ことば"],["に"],["気","き"],["を"],["つけず"],["、"],["わたし"],["の"],["おきて"],["を"],["捨てた","すてた"],["から"],["で"],["ある"],["。"]]},{"verse":20,"text":"シバから、わたしの所,ところに乳香,にゅうこうが来,き、遠,とおい国,くにから、菖蒲,しょうぶが来,くるのはなんのためか。あなたがたの燔祭,はんさいはわたしには喜,よろこばしくなく、あなたがたの犠牲,ぎせいもうれしくはない。","tok":[["シバ"],["から"],["、"],["わたし"],["の"],["所","ところ"],["に"],["乳香","にゅうこう"],["が"],["来","き"],["、"],["遠い","とおい"],["国","くに"],["から"],["、"],["菖蒲","しょうぶ"],["が"],["来る","くる"],["の"],["は"],["なん"],["の"],["ため"],["か"],["。"],["あなた"],["がた"],["の"],["燔祭","はんさい"],["は"],["わたし"],["に"],["は"],["喜こば","よろこば"],["しくなく"],["、"],["あなた"],["がた"],["の"],["犠牲","ぎせい"],["も"],["うれしく"],["は"],["ない"],["。"]]},{"verse":21,"text":"それゆえ主,しゅはこう言,いわれる、『見,みよ、わたしはこの民,たみの前,まえにつまずく石,いしを置,おく、人々,ひとびとは父,ちちも子,こも共,ともにそれにつまずき、隣,となり人,びともその友,ともも滅,ほろびる』」。","tok":[["それ"],["ゆえ"],["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["『"],["見よ","みよ"],["、"],["わたし"],["は"],["この"],["民","たみ"],["の"],["前","まえ"],["に"],["つまずく"],["石","いし"],["を"],["置く","おく"],["、"],["人々","ひとびと"],["は"],["父","ちち"],["も"],["子","こ"],["も"],["共","とも"],["に"],["それ"],["に"],["つまずき"],["、"],["隣人","となりびともそ"],["の"],["友","とも"],["も"],["滅びる","ほろびる"],["』"],["」"],["。"]]},{"verse":22,"text":"主,しゅはこう言,いわれる、「見,みよ、民,たみが北,きたの国,くにから来,くる、大,おおいなる国民,こくみんが地,ちの果,はてから興,おこる。","tok":[["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["「"],["見よ","みよ"],["、"],["民","た"],["み"],["が"],["北","きた"],["の"],["国","くに"],["から"],["来る","くる"],["、"],["大いなる","おおいなる"],["国民","こくみん"],["が"],["地","ち"],["の"],["果て","はて"],["から"],["興る","おこる"],["。"]]},{"verse":23,"text":"彼,かれらは弓,ゆみとやりをとる。彼,かれらは残忍,ざんにんで、あわれみがなく、海,うみのような響,ひびきを立,たてる。シオンの娘,むすめよ、彼,かれらは馬,うまに乗,のり、いくさ人,ひとのように身,みをよろって、あなたを攻,せめる」。","tok":[["彼","かれ"],["ら"],["は"],["弓","ゆみ"],["と"],["やり"],["を"],["とる"],["。"],["彼","かれ"],["ら"],["は"],["残忍","ざんにん"],["で"],["、"],["あわれみ"],["が"],["なく"],["、"],["海","うみ"],["の"],["よう"],["な"],["響","ひびき"],["を"],["立る","たてる"],["。"],["シオン"],["の"],["娘","むすめ"],["よ"],["、"],["彼","かれ"],["ら"],["は"],["馬","うま"],["に"],["乗","のり"],["、"],["いくさ人","いくさひと"],["の"],["よう"],["に"],["身","み"],["を"],["よろって"],["、"],["あなた"],["を"],["攻める","せめる"],["」"],["。"]]},{"verse":24,"text":"われわれはそのうわさを聞,きいて、手,ては弱,よわり、子,こを産,うむ女,おんなに臨,のぞむような悩,なやみと苦,くるしみとに捕,とらえられた。","tok":[["われわれ"],["は"],["その"],["うわさ"],["を"],["聞いて","きいて"],["、"],["手","て"],["は"],["弱り","よわり"],["、"],["子","こ"],["を"],["産む","うむ"],["女","おんな"],["に"],["臨む","のぞむ"],["よう"],["な"],["悩み","なやみ"],["と"],["苦しみ","くるしみ"],["と"],["に"],["捕らえられた","とらえられた"],["。"]]},{"verse":25,"text":"畑,はたけに出,でてはならない、また道,みちを歩,あるいてはならない。敵,てきはつるぎを持,もち、恐,おそれが四方,しほうにあるからだ。","tok":[["畑","はたけ"],["に"],["出て","でて"],["は"],["ならない"],["、"],["また"],["道","みち"],["を"],["歩いて","あるいて"],["は"],["ならない"],["。"],["敵","てき"],["は"],["つるぎ"],["を"],["持","もち"],["、"],["恐","おそれ"],["が"],["四方","しほう"],["に"],["ある"],["から"],["だ"],["。"]]},{"verse":26,"text":"わが民,たみの娘,むすめよ、荒布,あらぬのを身,みにまとい、灰,はいの中,なかにまろび、ひとり子,こを失,うしなった時,ときのように、悲,かなしみ、いたく嘆,なげけ。滅,ほろぼす者,ものが、にわかにわれわれを襲,おそうからだ。","tok":[["わが"],["民","たみ"],["の"],["娘","むすめ"],["よ"],["、"],["荒布","あらぬ"],["の"],["を"],["身","み"],["に"],["まとい"],["、"],["灰","はい"],["の"],["中","なか"],["に"],["まろび"],["、"],["ひとり子","ひとりこ"],["を"],["失なった","うしなった"],["時","とき"],["の"],["よう"],["に"],["、"],["悲しみ","かなしみ"],["、"],["いたく"],["嘆け","なげけ"],["。"],["滅ぼす","ほろぼす"],["者","もの"],["が"],["、"],["にわか"],["に"],["われわれ"],["を"],["襲う","おそう"],["から"],["だ"],["。"]]},{"verse":27,"text":"「わたしはあなたを民,たみのうちに立,たてて、ためす者,もの、試,こころみる者,ものとした。あなたが彼,かれらの道,みちを知,しり、それをためすことができるようにするためである。","tok":[["「"],["わたし"],["は"],["あなた"],["を"],["民","たみ"],["の"],["うち"],["に"],["立てて","たてて"],["、"],["ためす"],["者","もの"],["、"],["試みる","こころみる"],["者","もの"],["と"],["した"],["。"],["あなた"],["が"],["彼","かれ"],["ら"],["の"],["道","みち"],["を"],["知り","しり"],["、"],["それ"],["を"],["ためす"],["こと"],["が"],["できる"],["よう"],["に"],["する"],["ため"],["で"],["ある"],["。"]]},{"verse":28,"text":"彼,かれらはみな、強情,ごうじょうな反逆者,はんぎゃくしゃであって、歩,あるきまわって人,ひとをそしる。彼,かれらは青銅,せいどうや鉄,てつであって、みな卑,いやしいことを行,おこなう。","tok":[["彼","かれ"],["ら"],["は"],["みな"],["、"],["強情","ごうじょう"],["な"],["反逆者","はんぎゃくしゃ"],["で"],["あって"],["、"],["歩き","あるき"],["まわって"],["人","ひと"],["を"],["そしる"],["。"],["彼","かれ"],["ら"],["は"],["青銅","せいどう"],["や"],["鉄","てつ"],["で"],["あって"],["、"],["みな"],["卑しい","いやしい"],["こと"],["を"],["行なう","おこなう"],["。"]]},{"verse":29,"text":"ふいごは激,はげしく吹,ふき、鉛,なまりは火,ひにとけて尽,つき、精錬,せいれんはいたずらに進,すすむ。悪,あしき者,ものがまだ除,のぞかれないからである。","tok":[["ふいご"],["は"],["激しく","はげしく"],["吹","ふき"],["、"],["鉛","なまり"],["は"],["火","ひ"],["に"],["とけて"],["尽き","つき"],["、"],["精錬","せいれん"],["は"],["いたずら"],["に"],["進","すすむ"],["。"],["悪しき","あしき"],["者","もの"],["が"],["まだ"],["除かれない","のぞかれない"],["から"],["で"],["ある"],["。"]]},{"verse":30,"text":"主,しゅが彼,かれらを捨,すてられたので、彼,かれらは捨,すてられた銀,ぎんと呼,よばれる」。","tok":[["主","しゅ"],["が"],["彼","かれ"],["ら"],["を"],["捨てられた","すてられた"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["捨てられた","すてられた"],["銀","ぎん"],["と"],["呼ばれる","よばれる"],["」"],["。"]]}]
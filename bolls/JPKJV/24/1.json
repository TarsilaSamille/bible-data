[{"verse":1,"text":"ベニヤミンの地,ちアナトテの祭司,さいしのひとりである、ヒルキヤの子,こエレミヤの言葉,ことば。","tok":[["ベニヤミン"],["の"],["地","ち"],["アナトテ"],["の"],["祭司","さいし"],["の"],["ひとり"],["で"],["ある"],["、"],["ヒルキヤ"],["の"],["子","こ"],["エレミヤ"],["の"],["言葉","ことば"],["。"]]},{"verse":2,"text":"アモンの子,こ、ユダの王,おうヨシヤの時,とき、すなわちその治世,ちせいの十三年,ねんに、主,しゅの言葉,ことばがエレミヤに臨,のぞんだ。","tok":[["アモン"],["の"],["子","こ"],["、"],["ユダ"],["の"],["王","おう"],["ヨシヤ"],["の"],["時","とき"],["、"],["すなわち"],["その"],["治世","ちせい"],["の"],["十三","じゅうさん"],["年","ねん"],["に"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["が"],["エレミヤ"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":3,"text":"その言葉,ことばはまたヨシヤの子,こ、ユダの王,おうエホヤキムの時,ときにも臨,のぞんで、ヨシヤの子,こ、ユダの王,おうゼデキヤの十一年,ねんの終,おわり、すなわちその年,ねんの五月,がつにエルサレムの民,たみが捕,とらえ移,うつされた時,ときにまで及,およんだ。","tok":[["その"],["言葉","ことば"],["は"],["また"],["ヨシヤ"],["の"],["子","こ"],["、"],["ユダ"],["の"],["王","おう"],["エホヤキム"],["の"],["時","とき"],["に"],["も"],["臨んで","のぞんで"],["、"],["ヨシヤ"],["の"],["子","こ"],["、"],["ユダ"],["の"],["王","おう"],["ゼデキヤ"],["の"],["十一","じゅういち"],["年","ねん"],["の"],["終","おわり"],["、"],["すなわち"],["その"],["年","ねん"],["の"],["五","ご"],["月","がつ"],["に"],["エルサレム"],["の"],["民","たみ"],["が"],["捕らえ","とらえ"],["移された","うつされた"],["時","とき"],["に"],["まで"],["及んだ","およんだ"],["。"]]},{"verse":4,"text":"主,しゅの言葉,ことばがわたしに臨,のぞんで言,いう、","tok":[["主","しゅ"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んで","のぞんで"],["言う","いう"],["、"]]},{"verse":5,"text":"「わたしはあなたをまだ母,ははの胎,たいにつくらないさきに、あなたを知,しり、あなたがまだ生,うまれないさきに、あなたを聖別,せいべつし、あなたを立,たてて万国,ばんこくの預言者,よげんしゃとした」。","tok":[["「"],["わたし"],["は"],["あなた"],["を"],["まだ"],["母","はは"],["の"],["胎","たい"],["に"],["つくらない"],["さき"],["に"],["、"],["あなた"],["を"],["知り","しり"],["、"],["あなた"],["が"],["まだ"],["生まれない","うまれない"],["さき"],["に"],["、"],["あなた"],["を"],["聖別","せいべつ"],["し"],["、"],["あなた"],["を"],["立てて","たてて"],["万国","ばんこく"],["の"],["預言者","よげんしゃ"],["と"],["した"],["」"],["。"]]},{"verse":6,"text":"その時,ときわたしは言,いった、「ああ、主,しゅなる神,かみよ、わたしはただ若者,わかものにすぎず、どのように語,かたってよいか知,しりません」。","tok":[["その"],["時","とき"],["わたし"],["は"],["言った","いった"],["、"],["「"],["ああ"],["、"],["主","しゅ"],["なる"],["神","かみ"],["よ"],["、"],["わたし"],["は"],["ただ"],["若者","わかもの"],["に"],["すぎず"],["、"],["どの"],["よう"],["に"],["語って","かたって"],["よい"],["か"],["知りません","しりません"],["」"],["。"]]},{"verse":7,"text":"しかし主,しゅはわたしに言,いわれた、「あなたはただ若者,わかものにすぎないと言,いってはならない。だれにでも、すべてわたしがつかわす人,ひとへ行,いき、あなたに命,めいじることをみな語,かたらなければならない。","tok":[["しかし"],["主","しゅ"],["は"],["わたし"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["は"],["ただ"],["若者","わかもの"],["に"],["すぎない"],["と"],["言って","いって"],["は"],["ならない"],["。"],["だれ"],["に"],["で"],["も"],["、"],["すべて"],["わたし"],["が"],["つかわす"],["人","ひと"],["へ"],["行き","いき"],["、"],["あなた"],["に"],["命じる","めいじる"],["こと"],["を"],["みな"],["語らなければ","かたらなければ"],["ならない"],["。"]]},{"verse":8,"text":"彼,かれらを恐,おそれてはならない、わたしがあなたと共,ともにいて、あなたを救,すくうからである」と主,しゅは仰,おおせられる。","tok":[["彼","かれ"],["ら"],["を"],["恐れて","おそれて"],["は"],["ならない"],["、"],["わたし"],["が"],["あなた"],["と"],["共","とも"],["に"],["いて"],["、"],["あなた"],["を"],["救う","すくう"],["から"],["で"],["ある"],["」"],["と"],["主","しゅ"],["は"],["仰せられる","おおせられる"],["。"]]},{"verse":9,"text":"そして主,しゅはみ手,てを伸,のべて、わたしの口,くちにつけ、主,しゅはわたしに言,いわれた、「見,みよ、わたしの言葉,ことばをあなたの口,くちに入,いれた。","tok":[["そして"],["主","しゅ"],["は"],["み手","みて"],["を"],["伸べて","のべて"],["、"],["わたし"],["の"],["口","くち"],["に"],["つけ"],["、"],["主","しゅ"],["は"],["わたし"],["に"],["言われた","いわれた"],["、"],["「"],["見よ","みよ"],["、"],["わたし"],["の"],["言葉","ことば"],["を"],["あなた"],["の"],["口","くち"],["に"],["入れた","いれた"],["。"]]},{"verse":10,"text":"見,みよ、わたしはきょう、あなたを万民,ばんみんの上,うえと、万国,ばんこくの上,うえに立,たて、あなたに、あるいは抜,ぬき、あるいはこわし、あるいは滅,ほろぼし、あるいは倒,たおし、あるいは建,たて、あるいは植,うえさせる」。","tok":[["見よ","みよ"],["、"],["わたし"],["は"],["きょう"],["、"],["あなた"],["を"],["万民","ばんみん"],["の"],["上","うえ"],["と"],["、"],["万国","ばんこく"],["の"],["上","うえ"],["に"],["立て","たて"],["、"],["あなた"],["に"],["、"],["あるいは"],["抜き","ぬき"],["、"],["あるいは"],["こわし"],["、"],["あるいは"],["滅ぼし","ほろぼし"],["、"],["あるいは"],["倒し","たおし"],["、"],["あるいは"],["建て","たて"],["、"],["あるいは"],["植えさせる","うえさせる"],["」"],["。"]]},{"verse":11,"text":"主,しゅの言葉,ことばがまたわたしに臨,のぞんで言,いう、「エレミヤよ、あなたは何,なにを見,みるか」。わたしは答,こたえた、「あめんどうの枝,えだを見,みます」。","tok":[["主","しゅ"],["の"],["言葉","ことば"],["が"],["また"],["わたし"],["に"],["臨んで","のぞんで"],["言う","いう"],["、"],["「"],["エレミヤ"],["よ"],["、"],["あなた"],["は"],["何に","なに"],["を"],["見る","みる"],["か"],["」"],["。"],["わたし"],["は"],["答","こたえ"],["た"],["、"],["「"],["あ"],["めんどう"],["の"],["枝","えだ"],["を"],["見ます","みます"],["」"],["。"]]},{"verse":12,"text":"主,しゅはわたしに言,いわれた、「あなたの見,みたとおりだ。わたしは自分,じぶんの言葉,ことばを行,おこなおうとして見張,みはっているのだ」。","tok":[["主","しゅ"],["は"],["わたし"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["の"],["見た","みた"],["とおり"],["だ"],["。"],["わたし"],["は"],["自分","じぶん"],["の"],["言葉","ことば"],["を"],["行なおう","おこなおう"],["として"],["見張って","みはって"],["いる"],["の"],["だ"],["」"],["。"]]},{"verse":13,"text":"主,しゅの言葉,ことばがふたたびわたしに臨,のぞんで言,いう、「あなたは何,なにを見,みるか」。わたしは答,こたえた、「煮,にえ立,たっているなべを見,みます。北,きたからこちらに向,むかっています」。","tok":[["主","しゅ"],["の"],["言葉","ことば"],["が"],["ふたたび"],["わたし"],["に"],["臨んで","のぞんで"],["言う","いう"],["、"],["「"],["あなた"],["は"],["何に","なに"],["を"],["見る","みる"],["か"],["」"],["。"],["わたし"],["は"],["答","こたえ"],["た"],["、"],["「"],["煮え立って","にえたって"],["いる"],["なべ"],["を"],["見ます","みます"],["。"],["北","きた"],["から"],["こちら"],["に"],["向かって","むかって"],["います"],["」"],["。"]]},{"verse":14,"text":"主,しゅはわたしに言,いわれた、「災,わざわいが北,きたから起,たって、この地,ちに住,すむすべての者,ものの上,うえに臨,のぞむ」。","tok":[["主","しゅ"],["は"],["わたし"],["に"],["言われた","いわれた"],["、"],["「"],["災","わざわい"],["が"],["北","きた"],["から"],["起って","たって"],["、"],["この"],["地","ち"],["に"],["住む","すむ"],["すべて"],["の"],["者","もの"],["の"],["上","うえ"],["に"],["臨む","のぞむ"],["」"],["。"]]},{"verse":15,"text":"主,しゅは言,いわれる、「見,みよ、わたしは北,きたの国々,くにぐにのすべての民,たみを呼,よぶ。彼,かれらは来,きて、エルサレムの門,もんの入口,いりぐちと、周囲,しゅういのすべての城壁,じょうへき、およびユダのすべての町々,まちまちに向,むかって、おのおのその座,ざを設,もうける。","tok":[["主","しゅ"],["は"],["言われる","いわれる"],["、"],["「"],["見よ","みよ"],["、"],["わたし"],["は"],["北","きた"],["の"],["国々","くにぐに"],["の"],["すべて"],["の"],["民","たみ"],["を"],["呼ぶ","よぶ"],["。"],["彼","かれ"],["ら"],["は"],["来て","きて"],["、"],["エルサレム"],["の"],["門","もん"],["の"],["入口","いりぐち"],["と"],["、"],["周囲","しゅうい"],["の"],["すべて"],["の"],["城壁","じょうへき"],["、"],["および"],["ユダ"],["の"],["すべて"],["の"],["町々","まちまち"],["に"],["向かって","むかって"],["、"],["おのおの"],["その"],["座","ざ"],["を"],["設ける","もうける"],["。"]]},{"verse":16,"text":"わたしは、彼,かれらがわたしを捨,すてて、すべての悪事,あくじを行,おこなったゆえに、わたしのさばきを彼,かれらに告,つげる。彼,かれらは他,たの神々,かみがみに香,こうをたき、自分,じぶんの手,てで作,つくった物,ものを拝,はいしたのである。","tok":[["わたし"],["は"],["、"],["彼","かれ"],["ら"],["が"],["わたし"],["を"],["捨てて","すてて"],["、"],["すべて"],["の"],["悪事","あくじ"],["を"],["行なった","おこなった"],["ゆえ"],["に"],["、"],["わたし"],["の"],["さばき"],["を"],["彼","かれ"],["ら"],["に"],["告げる","つげる"],["。"],["彼","かれ"],["ら"],["は"],["他","た"],["の"],["神々","かみがみ"],["に"],["香","こう"],["を"],["たき"],["、"],["自分","じぶん"],["の"],["手","て"],["で"],["作った","つくった"],["物","もの"],["を"],["拝した","はいした"],["ので"],["ある"],["。"]]},{"verse":17,"text":"しかしあなたは腰,こしに帯,おびして立,たち、わたしが命,めいじるすべての事,ことを彼,かれらに告,つげよ。彼,かれらを恐,おそれてはならない。さもないと、わたしは彼,かれらの前,まえであなたをあわてさせる。","tok":[["しかし"],["あなた"],["は"],["腰","こし"],["に"],["帯び","おび"],["して"],["立ち","たち"],["、"],["わたし"],["が"],["命じる","めいじる"],["すべて"],["の"],["事","こと"],["を"],["彼","かれ"],["ら"],["に"],["告","つげ"],["よ"],["。"],["彼","かれ"],["ら"],["を"],["恐れて","おそれて"],["は"],["ならない"],["。"],["さも"],["ない"],["と"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["前","まえ"],["で"],["あなた"],["を"],["あわてさせる"],["。"]]},{"verse":18,"text":"見,みよ、わたしはきょう、この全国,ぜんこくと、ユダの王,おうと、そのつかさと、その祭司,さいしと、その地,ちの民,たみの前,まえに、あなたを堅,かたき城,しろ、鉄,てつの柱,はしら、青銅,せいどうの城壁,じょうへきとする。","tok":[["見よ","みよ"],["、"],["わたし"],["は"],["きょう"],["、"],["この"],["全国","ぜんこく"],["と"],["、"],["ユダ"],["の"],["王","おう"],["と"],["、"],["その"],["つかさ"],["と"],["、"],["その"],["祭司","さいし"],["と"],["、"],["その"],["地","ち"],["の"],["民","たみ"],["の"],["前","まえ"],["に"],["、"],["あなた"],["を"],["堅","か"],["たき城","たきしろ"],["、"],["鉄","てつ"],["の"],["柱","はしら"],["、"],["青銅","せいどう"],["の"],["城壁","じょうへき"],["と"],["する"],["。"]]},{"verse":19,"text":"彼,かれらはあなたと戦,たたかうが、あなたに勝,かつことはできない。わたしがあなたと共,ともにいて、あなたを救,すくうからである」と主,しゅは言,いわれる。","tok":[["彼","かれ"],["ら"],["は"],["あなた"],["と"],["戦う","たたかう"],["が"],["、"],["あなた"],["に"],["勝つ","かつ"],["こと"],["は"],["できない"],["。"],["わたし"],["が"],["あなた"],["と"],["共","とも"],["に"],["いて"],["、"],["あなた"],["を"],["救う","すくう"],["から"],["で"],["ある"],["」"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]}]
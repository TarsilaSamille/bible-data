[{"verse":1,"text":"エジプトの地,ちに住,すんでいるユダヤ人,ひとすなわちミグドル、タパネス、メンピス、パテロスの地,ちに住,すむ者,ものの事,ことについてエレミヤに臨,のぞんだ言葉,ことば、","tok":[["エジプト"],["の"],["地","ち"],["に"],["住んで","すんで"],["いる"],["ユダヤ人","ゆだやひと"],["すなわち"],["ミグドル"],["、"],["タパネス"],["、"],["メンピス"],["、"],["パテロス"],["の"],["地","ち"],["に"],["住む","すむ"],["者","もの"],["の"],["事","こと"],["について"],["エレミヤ"],["に"],["臨んだ","のぞんだ"],["言葉","ことば"],["、"]]},{"verse":2,"text":"「万軍,ばんぐんの主,しゅ、イスラエルの神,かみはこう言,いわれる、あなたがたはわたしがエルサレムとユダの町々,まちまちに下,くだした災,わざわいを見,みた。見,みよ、これらは今日,こんにち、すでに荒,あれ地,ちとなって住,すむ人,ひともない。","tok":[["「"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["、"],["イスラエル"],["の"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["あなた"],["がた"],["は"],["わたし"],["が"],["エルサレム"],["と"],["ユダ"],["の"],["町々","まちまち"],["に"],["下した","くだした"],["災","わざわい"],["を"],["見た","みた"],["。"],["見よ","みよ"],["、"],["これ"],["ら"],["は"],["今日","こん"],["に"],["ち"],["、"],["すでに"],["荒れ地","あれち"],["と"],["なって"],["住む","すむ"],["人","ひと"],["も"],["ない"],["。"]]},{"verse":3,"text":"これは彼,かれらが悪,あくを行,いって、わたしを怒,いからせたことによるのである。すなわち彼,かれらは自分,じぶんも、あなたがたも、あなたがたの先祖,せんぞたちも知,しらなかった、ほかの神々,かみがみに行,いって、香,こうをたき、これに仕,つかえた。","tok":[["これ"],["は"],["彼","かれ"],["ら"],["が"],["悪","あく"],["を"],["行って","いって"],["、"],["わたし"],["を"],["怒らせた","いからせた"],["こと"],["に"],["よる"],["ので"],["ある"],["。"],["すなわち"],["彼","かれ"],["ら"],["は"],["自分","じぶん"],["も"],["、"],["あなた"],["がた"],["も"],["、"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["たち"],["も"],["知らなかった","しらなかった"],["、"],["ほか"],["の"],["神々","かみがみ"],["に"],["行って","いって"],["、"],["香","こう"],["を"],["たき"],["、"],["これ"],["に"],["仕えた","つかえた"],["。"]]},{"verse":4,"text":"わたしは自分,じぶんのしもべであるすべての預言者,よげんしゃたちを、しきりにあなたがたにつかわして、『どうか、わたしの忌,いみきらうこの憎,にくむべき事,ことをしないように』と言,いわせたけれども、","tok":[["わたし"],["は"],["自分","じぶん"],["の"],["しもべ"],["で"],["ある"],["すべて"],["の"],["預言者","よげんしゃ"],["たち"],["を"],["、"],["しきり"],["に"],["あなた"],["がた"],["に"],["つかわして"],["、"],["『"],["どう"],["か"],["、"],["わたし"],["の"],["忌","いみ"],["きらう"],["この"],["憎むべき","にくむべき"],["事","こと"],["を"],["しない"],["よう"],["に"],["』"],["と"],["言わせた","いわせた"],["けれど"],["も"],["、"]]},{"verse":5,"text":"彼,かれらは聞,きかず、耳,みみを傾,かたむけず、ほかの神々,かみがみに香,こうをたいて、その悪,あくを離,はなれなかった。","tok":[["彼","かれ"],["ら"],["は"],["聞かず","きかず"],["、"],["耳","みみ"],["を"],["傾むけず","かたむけず"],["、"],["ほか"],["の"],["神々","かみがみ"],["に"],["香","こう"],["を"],["たいて"],["、"],["その"],["悪","あく"],["を"],["離れなかった","はなれなかった"],["。"]]},{"verse":6,"text":"それゆえ、わたしは怒,いかりと憤,いきどおりをユダの町々,まちまちとエルサレムのちまたに注,そそぎ、それを焼,やいたので、それらは今日,こんにちのように荒,あれ、滅,ほろびてしまった。","tok":[["それ"],["ゆえ"],["、"],["わたし"],["は"],["怒り","いかり"],["と"],["憤り","いきどおり"],["を"],["ユダ"],["の"],["町々","まちまち"],["と"],["エルサレム"],["の"],["ちまた"],["に"],["注ぎ","そそぎ"],["、"],["それ"],["を"],["焼いた","やいた"],["ので"],["、"],["それ"],["ら"],["は"],["今日","こんにち"],["の"],["よう"],["に"],["荒れ","あれ"],["、"],["滅びて","ほろびて"],["しまった"],["。"]]},{"verse":7,"text":"万軍,ばんぐんの神,かみ、イスラエルの神,かみ、主,しゅは今,いまこう言,いわれる、あなたがたはなぜ大,おおいなる悪,あくを行,いって自分,じぶん自身,じしんを害,がいし、ユダのうちから、あなたがたの男,おとこと女,おんなと、子供,こどもと乳,ちのみ子,ごを断,たって、ひとりも残,のこらないようにしようとするのか。","tok":[["万","まん"],["軍","ぐん"],["の"],["神","かみ"],["、"],["イスラエル"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["今","いま"],["こう"],["言われる","いわれる"],["、"],["あなた"],["がた"],["は"],["なぜ"],["大いなる","おおいなる"],["悪","あく"],["を"],["行って","いって"],["自分","じぶん"],["自身","じしん"],["を"],["害し","がいし"],["、"],["ユダ"],["の"],["うち"],["から"],["、"],["あなた"],["がた"],["の"],["男","おとこ"],["と"],["女","おんな"],["と"],["、"],["子供","こども"],["と"],["乳","ち"],["のみ"],["子","ご"],["を"],["断って","たって"],["、"],["ひとり"],["も"],["残らない","のこらない"],["よう"],["に"],["しよう"],["と"],["する"],["の"],["か"],["。"]]},{"verse":8,"text":"なぜあなたがたはその手,てのわざをもってわたしを怒,いからせ、あなたがたが行,いって住,すまうエジプトの地,ちで、ほかの神々,かみがみに香,こうをたいて自分,じぶんの身,みを滅,ほろぼし、地,ちの万国,ばんこくのうちに、のろいとなり、はずかしめとなろうとするのか。","tok":[["なぜ"],["あなた"],["がた"],["は"],["その"],["手","て"],["の"],["わざ"],["を"],["もって"],["わたし"],["を"],["怒らせ","いからせ"],["、"],["あなた"],["がた"],["が"],["行って","いって"],["住まう","すまう"],["エジプト"],["の"],["地","ち"],["で"],["、"],["ほか"],["の"],["神々","かみがみ"],["に"],["香","こう"],["を"],["たいて"],["自分","じぶん"],["の"],["身","み"],["を"],["滅ぼし","ほろぼし"],["、"],["地","ち"],["の"],["万国","ばんこく"],["の"],["うち"],["に"],["、"],["のろい"],["と"],["なり"],["、"],["はずかしめ"],["と"],["なろう"],["と"],["する"],["の"],["か"],["。"]]},{"verse":9,"text":"ユダの地,ちとエルサレムのちまたで行,いったあなたがたの先祖,せんぞたちの悪,あく、ユダの王,おうたちの悪,あく、その妻,つまたちの悪,あく、およびあなたがた自身,じしんの悪,あく、あなたがたの妻,つまたちの悪,あくをあなたがたは忘,わすれたのか。","tok":[["ユダ"],["の"],["地","ち"],["と"],["エルサレム"],["の"],["ちまた"],["で"],["行った","いった"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["たち"],["の"],["悪く","あく"],["、"],["ユダ"],["の"],["王","おう"],["たち"],["の"],["悪く","あく"],["、"],["その"],["妻たち","つまたち"],["の"],["悪く","あく"],["、"],["および"],["あなた"],["がた"],["自身","じしん"],["の"],["悪く","あく"],["、"],["あなた"],["がた"],["の"],["妻たち","つまたち"],["の"],["悪","あく"],["を"],["あなた"],["がた"],["は"],["忘た","わすれた"],["の"],["か"],["。"]]},{"verse":10,"text":"彼,かれらは今日,こんにちに至,いたるまで悔,くいず、また恐,おそれず、あなたがたとあなたがたの先祖,せんぞたちの前,まえに立,たてた、わたしの律法,りっぽうとわたしの定,さだめとに従,したがって歩,あゆまないのである。","tok":[["彼","かれ"],["ら"],["は"],["今日","こんにち"],["に"],["至る","いたる"],["まで"],["悔いず","くいず"],["、"],["また"],["恐れず","おそれず"],["、"],["あなた"],["がた"],["と"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["たち"],["の"],["前","まえ"],["に"],["立てた","たてた"],["、"],["わたし"],["の"],["律法","りっぽう"],["と"],["わたし"],["の"],["定め","さだめ"],["と"],["に"],["従って","したがって"],["歩まない","あゆまない"],["ので"],["ある"],["。"]]},{"verse":11,"text":"それゆえ万軍,ばんぐんの主,しゅ、イスラエルの神,かみはこう言,いわれる、見,みよ、わたしは顔,かおをあなたがたに向,むけて災,わざわいを下,くだし、ユダの人々,ひとびとをことごとく断,たつ。","tok":[["それ"],["ゆえ"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["、"],["イスラエル"],["の"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["見よ","みよ"],["、"],["わたし"],["は"],["顔","かお"],["を"],["あなた"],["がた"],["に"],["向けて","むけて"],["災","わざわい"],["を"],["下し","くだし"],["、"],["ユダ"],["の"],["人々","ひとびと"],["を"],["ことごとく"],["断つ","たつ"],["。"]]},{"verse":12,"text":"またわたしは、エジプトの地,ちに住,すむために、むりに行,いったあのユダの残,のこりの者,ものを取,とり除,のぞく。彼,かれらはみな滅,ほろぼされてエジプトの地,ちに倒,たおれる。彼,かれらは、つるぎとききんに滅,ほろぼされ、最,もっとも小,ちいさい者,ものから最,もっとも大,おおいなる者,ものまで、つるぎとききんによって死,しぬ。そして、のろいとなり、恐怖,きょうふとなり、ののしりとなり、はずかしめとなる。","tok":[["また"],["わたし"],["は"],["、"],["エジプト"],["の"],["地","ち"],["に"],["住む","すむ"],["ため"],["に"],["、"],["むり"],["に"],["行った","いった"],["あの"],["ユダ"],["の"],["残り","のこり"],["の"],["者","もの"],["を"],["取除く","とりのぞく"],["。"],["彼","かれ"],["ら"],["は"],["みな"],["滅ぼされて","ほろぼされて"],["エジプト"],["の"],["地","ち"],["に"],["倒れる","たおれる"],["。"],["彼","かれ"],["ら"],["は"],["、"],["つるぎ"],["と"],["ききん"],["に"],["滅ぼされ","ほろぼされ"],["、"],["最も","もっとも"],["小さい","ちいさい"],["者","もの"],["から"],["最も","もっとも"],["大いなる","おおいなる"],["者","もの"],["まで"],["、"],["つるぎ"],["と"],["ききん"],["によって"],["死ぬ","しぬ"],["。"],["そして"],["、"],["のろい"],["と"],["なり"],["、"],["恐怖","きょうふ"],["と"],["なり"],["、"],["ののしり"],["と"],["なり"],["、"],["はずかしめ"],["と"],["なる"],["。"]]},{"verse":13,"text":"わたしはエルサレムを罰,ばっしたように、つるぎと、ききんと、疫病,えきびょうをもってエジプトに住,すんでいる者,ものを罰,ばっする。","tok":[["わたし"],["は"],["エルサレム"],["を"],["罰した","ばっした"],["よう"],["に"],["、"],["つるぎ"],["と"],["、"],["ききん"],["と"],["、"],["疫病","えきびょう"],["を"],["もって"],["エジプト"],["に"],["住んで","すんで"],["いる"],["者","もの"],["を"],["罰する","ばっする"],["。"]]},{"verse":14,"text":"それゆえ、エジプトの地,ちへ行,いってそこに住,すんでいるユダの残,のこりの者,もののうち、のがれ、または残,のこって、帰,かえり住,すまおうと願,ねがうユダの地,ちへ帰,かえる者,ものはひとりもない。少数,しょうすうののがれる者,もののほかには、帰,かえってくる者,ものはない」。","tok":[["それ"],["ゆえ"],["、"],["エジプト"],["の"],["地","ち"],["へ"],["行って","いって"],["そこ"],["に"],["住んで","すんで"],["いる"],["ユダ"],["の"],["残り","のこり"],["の"],["者","もの"],["の"],["うち"],["、"],["のがれ"],["、"],["また"],["は"],["残って","のこって"],["、"],["帰えり","かえり"],["住まおう","すまおう"],["と"],["願う","ねがう"],["ユダ"],["の"],["地","ち"],["へ"],["帰える","かえる"],["者","もの"],["は"],["ひとり"],["も"],["ない"],["。"],["少数","しょうすう"],["の"],["のがれる"],["者","もの"],["の"],["ほか"],["に"],["は"],["、"],["帰えって","かえって"],["くる"],["者","もの"],["は"],["ない"],["」"],["。"]]},{"verse":15,"text":"その時,とき、自分,じぶんの妻,つまがほかの神々,かみがみに香,こうをたいたことを知,しっている人々,ひとびと、およびその所,ところに立,たっている女,おんなたちの大,おおいなる群衆,ぐんしゅう、ならびにエジプトの地,ちのパテロスに住,すんでいる民,たみはエレミヤに答,こたえて言,いった、","tok":[["その"],["時","とき"],["、"],["自分","じぶん"],["の"],["妻","つま"],["が"],["ほか"],["の"],["神々","かみがみ"],["に"],["香","こう"],["を"],["たいた"],["こと"],["を"],["知って","しって"],["いる"],["人々","ひとびと"],["、"],["および"],["その"],["所","ところ"],["に"],["立って","たって"],["いる"],["女","おんな"],["たち"],["の"],["大いなる","おおいなる"],["群衆","ぐんしゅう"],["、"],["ならびに"],["エジプト"],["の"],["地","ち"],["の"],["パテロス"],["に"],["住んで","すんで"],["いる"],["民","たみ"],["は"],["エレミヤ"],["に"],["答","こたえ"],["て"],["言った","いった"],["、"]]},{"verse":16,"text":"「あなたが主,しゅの名,なによってわたしたちに述,のべられた言葉,ことばは、わたしたちは聞,きくことができません。","tok":[["「"],["あなた"],["が"],["主","しゅ"],["の"],["名","な"],["によって"],["わたしたち"],["に"],["述べられた","のべられた"],["言葉","ことば"],["は"],["、"],["わたしたち"],["は"],["聞く","きく"],["こと"],["が"],["できません"],["。"]]},{"verse":17,"text":"わたしたちは誓,ちかったことをみな行,おこない、わたしたちが、もと行,いっていたように香,こうを天后,てんこうにたき、また酒,さけをその前,まえに注,そそぎます。すなわち、ユダの町々,まちまちとエルサレムのちまたで、わたしたちとわたしたちの先祖,せんぞたちおよびわたしたちの王,おうたちと、わたしたちのつかさたちが行,いったようにいたします。その時,ときには、わたしたちは糧食,りょうしょくには飽,あき、しあわせで、災,わざわいに会,あいませんでした。","tok":[["わたしたち"],["は"],["誓った","ちかった"],["こと"],["を"],["みな"],["行ない","おこない"],["、"],["わたしたち"],["が"],["、"],["もと"],["行って","いって"],["いた"],["よう"],["に"],["香","こう"],["を"],["天后","てんこう"],["に"],["たき"],["、"],["また"],["酒","さけ"],["を"],["その"],["前","まえ"],["に"],["注ぎます","そそぎます"],["。"],["すなわち"],["、"],["ユダ"],["の"],["町々","まちまち"],["と"],["エルサレム"],["の"],["ちまた"],["で"],["、"],["わたしたち"],["と"],["わたしたち"],["の"],["先祖","せんぞ"],["たち"],["および"],["わたしたち"],["の"],["王","おう"],["たち"],["と"],["、"],["わたしたち"],["の"],["つかさ"],["たち"],["が"],["行った","いった"],["よう"],["に"],["いたします"],["。"],["その"],["時","とき"],["に"],["は"],["、"],["わたしたち"],["は"],["糧食","りょうしょく"],["に"],["は"],["飽き","あき"],["、"],["しあわせ"],["で"],["、"],["災","わざわい"],["に"],["会いませんでした","あいませんでした"],["。"]]},{"verse":18,"text":"ところが、わたしたちが、天后,てんこうに香,こうをたくことをやめ、酒,さけをその前,まえに注,そそがなくなった時,ときから、すべての物,ものに乏,とぼしくなり、つるぎとききんに滅,ほろぼされました」。","tok":[["ところ"],["が"],["、"],["わたしたち"],["が"],["、"],["天后","てんこう"],["に"],["香","こう"],["を"],["たく"],["こと"],["を"],["やめ"],["、"],["酒","さけ"],["を"],["その"],["前","まえ"],["に"],["注がなく","そそがなく"],["なった"],["時","とき"],["から"],["、"],["すべて"],["の"],["物","もの"],["に"],["乏く","とぼしく"],["なり"],["、"],["つるぎ"],["と"],["ききん"],["に"],["滅ぼされました","ほろぼされました"],["」"],["。"]]},{"verse":19,"text":"また女,おんなたちは言,いった、「わたしたちが天后,てんこうに香,こうをたき、酒,さけをその前,まえに注,そそぐに当,あたって、これにかたどってパンを造,つくり、酒,さけを注,そそいだのは、わたしたちの夫,おっとが許,ゆるしたことではありませんか」。","tok":[["また"],["女","おんな"],["たち"],["は"],["言った","いった"],["、"],["「"],["わたしたち"],["が"],["天后","てんこう"],["に"],["香","こう"],["を"],["たき"],["、"],["酒","さけ"],["を"],["その"],["前","まえ"],["に"],["注ぐ","そそぐ"],["に"],["当たって","あたって"],["、"],["これ"],["に"],["かたどって"],["パン"],["を"],["造","つくり"],["、"],["酒","さけ"],["を"],["注いだ","そそいだ"],["の"],["は"],["、"],["わたしたち"],["の"],["夫","おっと"],["が"],["許した","ゆるした"],["こと"],["で"],["は"],["ありません"],["か"],["」"],["。"]]},{"verse":20,"text":"そこでエレミヤは男女,だんじょのすべての人,ひと、およびこの答,こたえをしたすべての民,たみに言,いった、","tok":[["そこ"],["で"],["エレミヤ"],["は"],["男女","だんじょ"],["の"],["すべて"],["の"],["人","ひと"],["、"],["および"],["この"],["答","こたえ"],["を"],["した"],["すべて"],["の"],["民","たみ"],["に"],["言った","いった"],["、"]]},{"verse":21,"text":"「ユダの町々,まちまちとエルサレムのちまたで、あなたがたとあなたがたの先祖,せんぞたち、およびあなたがたの王,おうたちとあなたがたのつかさたち、およびその地,ちの民,たみが香,こうをたいたことは、主,しゅがこれを忘,わすれず、また、心,こころにとどめておられることではないか。","tok":[["「"],["ユダ"],["の"],["町々","まちまち"],["と"],["エルサレム"],["の"],["ちまた"],["で"],["、"],["あなた"],["がた"],["と"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["たち"],["、"],["および"],["あなた"],["がた"],["の"],["王","おう"],["たち"],["と"],["あなた"],["がた"],["の"],["つかさ"],["たち"],["、"],["および"],["その"],["地","ち"],["の"],["民","たみ"],["が"],["香","こう"],["を"],["たいた"],["こと"],["は"],["、"],["主","しゅがこれ"],["を"],["忘ず","わすれず"],["、"],["また"],["、"],["心","こころ"],["に"],["とどめて"],["おられる"],["こと"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":22,"text":"主,しゅはあなたがたの悪,あしきわざのため、あなたがたの憎,にくむべき行,おこないのために、もはや忍,しのぶことができなくなられた。それゆえ、あなたがたの地,ちは今日,こんにちのごとく荒,あれ地,ちとなり、驚,おどろきとなり、のろいとなり、住,すむ人,ひとのない地,ちとなった。","tok":[["主","しゅ"],["は"],["あなた"],["がた"],["の"],["悪しき","あしき"],["わざ"],["の"],["ため"],["、"],["あなた"],["がた"],["の"],["憎むべき","にくむべき"],["行ない","おこない"],["の"],["ため"],["に"],["、"],["もはや"],["忍ぶ","しのぶ"],["こと"],["が"],["できなく"],["なられた"],["。"],["それ"],["ゆえ"],["、"],["あなた"],["がた"],["の"],["地","ち"],["は"],["今日","こんにち"],["の"],["ごとく"],["荒れ地","あれち"],["と"],["なり"],["、"],["驚","おどろき"],["と"],["なり"],["、"],["のろい"],["と"],["なり"],["、"],["住む","すむ"],["人","ひと"],["の"],["ない"],["地","ち"],["と"],["なった"],["。"]]},{"verse":23,"text":"あなたがたが香,こうをたき、主,しゅに罪,つみを犯,おかし、主,しゅの声,こえに聞,きき従,したがわず、その律法,りっぽうと、定,さだめと、あかしに従,したがって歩,あゆまなかったので、今日,こんにちのようにこの災,わざわいがあなたがたに臨,のぞんだのである」。","tok":[["あなた"],["がた"],["が"],["香","こう"],["を"],["たき"],["、"],["主に","しゅに"],["罪","つみ"],["を"],["犯し","おかし"],["、"],["主","しゅ"],["の"],["声","こえ"],["に"],["聞","きき"],["従わず","したがわず"],["、"],["その"],["律法","りっぽう"],["と"],["、"],["定め","さだめ"],["と"],["、"],["あかし"],["に"],["従って","したがって"],["歩まなかった","あゆまなかった"],["ので"],["、"],["今日","こんにち"],["の"],["よう"],["に"],["この"],["災","わざわい"],["が"],["あなた"],["がた"],["に"],["臨","のぞんだ"],["ので"],["ある"],["」"],["。"]]},{"verse":24,"text":"エレミヤはまたすべての民,たみと女,おんなたちに言,いった、「あなたがたすべてエジプトの地,ちにいるユダの人々,ひとびとよ、主,しゅの言葉,ことばを聞,ききなさい。","tok":[["エレミヤ"],["は"],["また"],["すべて"],["の"],["民","たみ"],["と"],["女","おんな"],["たち"],["に"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["すべて"],["エジプト"],["の"],["地","ち"],["に"],["いる"],["ユダ"],["の"],["人々","ひとびと"],["よ"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["を"],["聞","きき"],["なさい"],["。"]]},{"verse":25,"text":"万軍,ばんぐんの主,しゅ、イスラエルの神,かみはこう言,いわれる、あなたがたとあなたがたの妻,つまたちは口,くちで言,いい、手,てで行,おこない、『わたしたちは天后,てんこうに香,こうをたき、酒,さけを注,そそいで立,たてた誓,ちかいを必,かならずなし遂,とげる』と言,いう。それならば、あなたがたの誓,ちかいをかため、あなたがたの誓,ちかいをなし遂,とげなさい。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["、"],["イスラエル"],["の"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["あなた"],["がた"],["と"],["あなた"],["がた"],["の"],["妻たち","つまたち"],["は"],["口","くち"],["で"],["言い","いい"],["、"],["手","て"],["で"],["行ない","おこない"],["、"],["『"],["わたしたち"],["は"],["天后","てんこう"],["に"],["香","こう"],["を"],["たき"],["、"],["酒","さけ"],["を"],["注いで","そそいで"],["立てた","たてた"],["誓い","ちかい"],["を"],["必","かならず"],["なし遂げる","なしとげる"],["』"],["と"],["言う","いう"],["。"],["それ"],["ならば"],["、"],["あなた"],["がた"],["の"],["誓い","ちかい"],["を"],["かため"],["、"],["あなた"],["がた"],["の"],["誓い","ちかい"],["を"],["なし遂げ","なしとげ"],["なさい"],["。"]]},{"verse":26,"text":"それゆえ、あなたがたすべてエジプトの地,ちにいるユダの人々,ひとびとよ、主,しゅの言葉,ことばを聞,ききなさい。主,しゅは言,いわれる、わたしは自分,じぶんの大,おおいなる名,なをさして誓,ちかう、すなわちエジプトの全,ぜん地,ちに、ユダの人々,ひとびとで、その口,くちに、『主,しゅなる神,かみは生,いきておられる』と言,いって、わたしの名,なをとなえるものは、もはやひとりもないようになる。","tok":[["それ"],["ゆえ"],["、"],["あなた"],["がた"],["すべて"],["エジプト"],["の"],["地","ち"],["に"],["いる"],["ユダ"],["の"],["人々","ひとびと"],["よ"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["を"],["聞","きき"],["なさい"],["。"],["主","しゅ"],["は"],["言われる","いわれる"],["、"],["わたし"],["は"],["自分","じぶん"],["の"],["大いなる","おおいなる"],["名","な"],["を"],["さして"],["誓う","ちかう"],["、"],["すなわち"],["エジプト"],["の"],["全地","ぜんち"],["に"],["、"],["ユダ"],["の"],["人々","ひとびと"],["で"],["、"],["その"],["口","くち"],["に"],["、"],["『"],["主","しゅ"],["なる"],["神","かみ"],["は"],["生きて","いきて"],["おられる"],["』"],["と"],["言って","いって"],["、"],["わたし"],["の"],["名","な"],["を"],["となえる"],["もの"],["は"],["、"],["もはや"],["ひとり"],["も"],["ない"],["よう"],["に"],["なる"],["。"]]},{"verse":27,"text":"見,みよ、わたしは彼,かれらを見守,みまもっている、それは幸,さいわいを与,あたえるためではなく、災,わざわいを下,くだすためである。エジプトの地,ちにいるユダの人々,ひとびとは、つるぎとききんによって滅,ほろび絶,たえる。","tok":[["見よ","みよ"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["見守って","みまもって"],["いる"],["、"],["それ"],["は"],["幸い","さいわい"],["を"],["与える","あたえる"],["ため"],["で"],["は"],["なく"],["、"],["災","わざわい"],["を"],["下す","くだす"],["ため"],["で"],["ある"],["。"],["エジプト"],["の"],["地","ち"],["に"],["いる"],["ユダ"],["の"],["人々","ひとびと"],["は"],["、"],["つるぎ"],["と"],["ききん"],["によって"],["滅び","ほろび"],["絶える","たえる"],["。"]]},{"verse":28,"text":"しかし、つるぎをのがれるわずかの者,ものはエジプトの地,ちを出,でてユダの地,ちに帰,かえる。そしてユダの残,のこっている民,たみでエジプトに来,きて住,すんだ者,ものは、わたしの言葉,ことばが立,たつか、彼,かれらの言葉,ことばが立,たつか、いずれであるかを知,しるようになる。","tok":[["しかし"],["、"],["つるぎ"],["を"],["のがれる"],["わずか"],["の"],["者","もの"],["は"],["エジプト"],["の"],["地","ち"],["を"],["出て","でて"],["ユダ"],["の"],["地","ち"],["に"],["帰える","かえる"],["。"],["そして"],["ユダ"],["の"],["残って","のこって"],["いる"],["民","たみ"],["で"],["エジプト"],["に"],["来て","きて"],["住んだ","すんだ"],["者","もの"],["は"],["、"],["わたし"],["の"],["言葉","ことば"],["が"],["立つ","たつ"],["か"],["、"],["彼","かれ"],["ら"],["の"],["言葉","ことば"],["が"],["立つ","たつ"],["か"],["、"],["いずれ"],["で"],["ある"],["か"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"]]},{"verse":29,"text":"主,しゅは言,いわれる、わたしがこの所,ところであなたがたを罰,ばっするしるしはこれである。わたしはこのようにしてわたしがあなたがたに災,わざわいを下,くだそうと言,いった事,ことの必,かならず立,たつことを知,しらせよう。","tok":[["主","しゅ"],["は"],["言われる","いわれる"],["、"],["わたし"],["が"],["この"],["所","ところ"],["で"],["あなた"],["がた"],["を"],["罰する","ばっする"],["しるし"],["は"],["これ"],["で"],["ある"],["。"],["わたし"],["は"],["この"],["よう"],["に"],["して"],["わたし"],["が"],["あなた"],["がた"],["に"],["災","わざわい"],["を"],["下そう","くだそう"],["と"],["言った","いった"],["事","こと"],["の"],["必","かならず"],["立つ","たつ"],["こと"],["を"],["知らせよう","しらせよう"],["。"]]},{"verse":30,"text":"すなわち主,しゅはこう言,いわれる、見,みよ、わたしはユダの王,おうゼデキヤを、その命,いのちを求,もとめる敵,てきであるバビロンの王,おうネブカデレザルの手,てに渡,わたしたように、エジプトの王,おうパロ・ホフラをその敵,てきの手,て、その命,いのちを求,もとめる者,ものの手,てに渡,わたす」。","tok":[["すなわち"],["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["見よ","みよ"],["、"],["わたし"],["は"],["ユダ"],["の"],["王","おう"],["ゼデキヤ"],["を"],["、"],["その"],["命","いのち"],["を"],["求める","もとめる"],["敵","てき"],["で"],["ある"],["バビロン"],["の"],["王","おう"],["ネブカデレザル"],["の"],["手","て"],["に"],["渡","わたし"],["た"],["よう"],["に"],["、"],["エジプト"],["の"],["王","おう"],["パロ"],["・"],["ホフラ"],["を"],["その"],["敵","てき"],["の"],["手","て"],["、"],["その"],["命","いのち"],["を"],["求める","もとめる"],["者","もの"],["の"],["手","て"],["に"],["渡す","わたす"],["」"],["。"]]}]
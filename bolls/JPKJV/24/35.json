[{"verse":1,"text":"ユダの王,おうヨシヤの子,こエホヤキムの時,とき、主,しゅからエレミヤに臨,のぞんだ言葉,ことば。","tok":[["ユダ"],["の"],["王","おう"],["ヨシヤ"],["の"],["子","こ"],["エホヤキム"],["の"],["時","とき"],["、"],["主ら","しゅから"],["エレミヤ"],["に"],["臨んだ","のぞんだ"],["言葉","ことば"],["。"]]},{"verse":2,"text":"「レカブびとの家,いえに行,いって、彼,かれらと語,かたり、彼,かれらを主,しゅの宮,みやの一室,いっしつに連,つれてきて、酒,さけを飲,のませなさい」。","tok":[["「"],["レカブ"],["びと"],["の"],["家","いえ"],["に"],["行って","いって"],["、"],["彼","かれ"],["ら"],["と"],["語り","かたり"],["、"],["彼","かれ"],["ら"],["を"],["主","しゅ"],["の"],["宮","みや"],["の"],["一室","いっしつ"],["に"],["連れて","つれて"],["きて"],["、"],["酒","さけ"],["を"],["飲ませ","のませ"],["なさい"],["」"],["。"]]},{"verse":3,"text":"そこでわたしはハバジニヤの子,こエレミヤの子,こであるヤザニヤと、その兄弟,きょうだいと、そのむすこたち、およびレカブびとの全家,ぜんかを連,つれ、","tok":[["そこ"],["で"],["わたし"],["は"],["ハバジニヤ"],["の"],["子","こ"],["エレミヤ"],["の"],["子","こ"],["で"],["ある"],["ヤザニヤ"],["と"],["、"],["その"],["兄弟","きょうだい"],["と"],["、"],["その"],["むすこ"],["たち"],["、"],["および"],["レカブ"],["びと"],["の"],["全","ぜん"],["家","いえ"],["を"],["連れ","つれ"],["、"]]},{"verse":4,"text":"これを主,しゅの宮,みやにあるハナンの子,こたちの室,しつに連,つれてきた。ハナンはイグダリヤの子,こであって神,かみの人,ひとであった。その室,しつは、つかさたちの室,しつの次,つぎにあって、門,もんを守,まもるシャルムの子,こマアセヤの室,しつの上,うえにあった。","tok":[["これ"],["を"],["主","しゅ"],["の"],["宮","みや"],["に"],["ある"],["ハナン"],["の"],["子","こ"],["たち"],["の"],["室","しつ"],["に"],["連れて","つれて"],["きた"],["。"],["ハナン"],["は"],["イグダリヤ"],["の"],["子","こ"],["で"],["あって"],["神","かみ"],["の"],["人","ひと"],["で"],["あった"],["。"],["その"],["室","しつ"],["は"],["、"],["つかさ"],["たち"],["の"],["室","しつ"],["の"],["次","つぎ"],["に"],["あって"],["、"],["門","もん"],["を"],["守","まもる"],["シャルム"],["の"],["子","こ"],["マアセヤ"],["の"],["室","しつ"],["の"],["上","うえ"],["に"],["あった"],["。"]]},{"verse":5,"text":"わたしはレカブびとの前,まえに酒,さけを満,みたしたつぼと杯,さかずきを置,おき、彼,かれらに、「酒,さけを飲,のみなさい」と言,いったが、","tok":[["わたし"],["は"],["レカブ"],["びと"],["の"],["前","まえ"],["に"],["酒","さけ"],["を"],["満たした","みたした"],["つぼ"],["と"],["杯","さかずき"],["を"],["置き","おき"],["、"],["彼","かれ"],["ら"],["に"],["、"],["「"],["酒","さけ"],["を"],["飲み","のみ"],["なさい"],["」"],["と"],["言った","いった"],["が"],["、"]]},{"verse":6,"text":"彼,かれらは答,こたえた、「われわれは酒,さけを飲,のみません。それは、レカブの子,こであるわれわれの先祖,せんぞヨナダブがわれわれに命,めいじて、『あなたがたとあなたがたの子孫,しそんはいつまでも酒,さけを飲,のんではならない。","tok":[["彼","かれ"],["ら"],["は"],["答","こたえ"],["た"],["、"],["「"],["われわれ"],["は"],["酒","さけ"],["を"],["飲みません","のみません"],["。"],["それ"],["は"],["、"],["レカブ"],["の"],["子","こ"],["で"],["ある"],["われわれ"],["の"],["先祖","せんぞ"],["ヨナダブ"],["が"],["われわれ"],["に"],["命じて","めいじて"],["、"],["『"],["あなた"],["がた"],["と"],["あなた"],["がた"],["の"],["子孫","しそん"],["は"],["いつ"],["まで"],["も"],["酒","さけ"],["を"],["飲","のん"],["で"],["は"],["ならない"],["。"]]},{"verse":7,"text":"また家,いえを建,たてず、種,たねをまかず、またぶどう畑,はたけを植,うえてはならない。またこれを所有,しょゆうしてはならない。あなたがたは生,いきながらえる間,あいだは幕屋,まくやに住,すんでいなさい。そうするならば、あなたがたはその宿,やどっている地,ちに長,ながく生,いきることができると言,いったからです』。","tok":[["また"],["家","いえ"],["を"],["建てず","たてず"],["、"],["種","たね"],["を"],["まかず"],["、"],["また"],["ぶどう"],["畑","はたけ"],["を"],["植えて","うえて"],["は"],["ならない"],["。"],["また"],["これ"],["を"],["所有","しょゆう"],["して"],["は"],["ならない"],["。"],["あなた"],["がた"],["は"],["生きながらえる","いきながらえる"],["間","あいだ"],["は"],["幕屋","まくや"],["に"],["住んで","すんで"],["い"],["なさい"],["。"],["そう"],["するならば"],["、"],["あなた"],["がた"],["は"],["その"],["宿って","やどって"],["いる"],["地","ち"],["に"],["長く","ながく"],["生きる","いきる"],["こと"],["が"],["できる"],["と"],["言った","いった"],["から"],["です"],["』"],["。"]]},{"verse":8,"text":"こうしてわれわれは、レカブの子,こであるわれわれの先祖,せんぞヨナダブがすべて命,めいじた言葉,ことばに従,したがって、われわれも、妻,つまも、むすこ娘,むすめも生,いきながらえる間,あいだ、酒,さけを飲,のまず、","tok":[["こう"],["して"],["われわれ"],["は"],["、"],["レカブ"],["の"],["子","こ"],["で"],["ある"],["われわれ"],["の"],["先祖","せんぞ"],["ヨナダブ"],["が"],["すべて"],["命じた","めいじた"],["言葉","ことば"],["に"],["従って","したがって"],["、"],["われわれ"],["も"],["、"],["妻","つま"],["も"],["、"],["むすこ"],["娘","むすめ"],["も"],["生きながらえる","いきながらえる"],["間","あ"],["い"],["だ"],["、"],["酒","さけ"],["を"],["飲まず","のまず"],["、"]]},{"verse":9,"text":"住,すむ家,いえを建,たてず、ぶどう畑,はたけも畑,はたけも種,たねも持,もたないで、","tok":[["住む","すむ"],["家","いえ"],["を"],["建てず","たてず"],["、"],["ぶどう"],["畑","はたけ"],["も"],["畑","はたけ"],["も"],["種","たね"],["も"],["持たないで","もたないで"],["、"]]},{"verse":10,"text":"幕屋,まくやに住,すみ、すべてわれわれの先祖,せんぞヨナダブがわれわれに命,めいじたところに従,したがい、そのように行,おこないました。","tok":[["幕屋","まくや"],["に"],["住み","すみ"],["、"],["すべて"],["われわれ"],["の"],["先祖","せんぞ"],["ヨナダブ"],["が"],["われわれ"],["に"],["命じた","めいじた"],["ところ"],["に"],["従い","したがい"],["、"],["その"],["よう"],["に"],["行ないました","おこないました"],["。"]]},{"verse":11,"text":"しかしバビロンの王,おうネブカデレザルがこの地,ちに上,のぼってきた時,とき、われわれは言,いいました、『さあ、われわれはエルサレムへ行,いこう。カルデヤびとの軍勢,ぐんぜいとスリヤびとの軍勢,ぐんぜいが恐,おそろしい』と。こうしてわれわれはエルサレムに住,すんでいるのです」。","tok":[["しかし"],["バビロン"],["の"],["王","おう"],["ネブカデレザル"],["が"],["この"],["地","ち"],["に"],["上って","のぼって"],["きた"],["時","とき"],["、"],["われわれ"],["は"],["言いました","いいました"],["、"],["『"],["さあ"],["、"],["われわれ"],["は"],["エルサレム"],["へ"],["行こう","いこう"],["。"],["カルデヤ"],["びと"],["の"],["軍勢","ぐんぜい"],["と"],["スリヤ"],["びと"],["の"],["軍勢","ぐんぜい"],["が"],["恐ろしい","おそろしい"],["』"],["と"],["。"],["こう"],["して"],["われわれ"],["は"],["エルサレム"],["に"],["住","すんでいる"],["の"],["です"],["」"],["。"]]},{"verse":12,"text":"その時,とき、主,しゅの言葉,ことばがエレミヤに臨,のぞんだ、","tok":[["その"],["時","とき"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["が"],["エレミヤ"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":13,"text":"「万軍,ばんぐんの主,しゅ、イスラエルの神,かみはこう言,いわれる、行,いって、ユダの人々,ひとびととエルサレムに住,すむ者,ものとに告,つげよ。主,しゅは仰,おおせられる、あなたがたはわたしの言葉,ことばを聞,きいて教,おしえを受,うけないのか。","tok":[["「"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["、"],["イスラエル"],["の"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["行って","いって"],["、"],["ユダ"],["の"],["人々","ひとびと"],["と"],["エルサレム"],["に"],["住む","すむ"],["者","もの"],["と"],["に"],["告","つげ"],["よ"],["。"],["主","しゅ"],["は"],["仰せられる","おおせられる"],["、"],["あなた"],["がた"],["は"],["わたし"],["の"],["言葉","ことば"],["を"],["聞いて","きいて"],["教え","おしえ"],["を"],["受ない","うけない"],["の"],["か"],["。"]]},{"verse":14,"text":"レカブの子,こヨナダブがその子孫,しそんに酒,さけを飲,のむなと命,めいじた言葉,ことばは守,まもられてきた。彼,かれらは今日,こんにちに至,いたるまで酒,さけを飲,のまず、その先祖,せんぞの命,いのちに従,したがってきた。ところがあなたがたはわたしがしきりに語,かたったけれども、わたしに聞,きき従,したがわなかった。","tok":[["レカブ"],["の"],["子","こ"],["ヨナダブ"],["が"],["その"],["子孫","しそん"],["に"],["酒","さけ"],["を"],["飲む","のむ"],["な"],["と"],["命じた","めいじた"],["言葉","ことば"],["は"],["守られて","まもられて"],["きた"],["。"],["彼","かれ"],["ら"],["は"],["今日","こんにち"],["に"],["至る","いたる"],["まで"],["酒","さけ"],["を"],["飲まず","のまず"],["、"],["その"],["先祖","せんぞ"],["の"],["命","いのち"],["に"],["従って","したがって"],["きた"],["。"],["ところ"],["が"],["あなた"],["がた"],["は"],["わたし"],["が"],["しきり"],["に"],["語った","かたった"],["けれど"],["も"],["、"],["わたし"],["に"],["聞","きき"],["従わなかった","したがわなかった"],["。"]]},{"verse":15,"text":"わたしはまた、わたしのしもべである預言者,よげんしゃたちを、しきりにあなたがたにつかわして言,いわせた、『あなたがたは今,いまおのおのその悪,わるい道,みちを離,はなれ、その行,おこないを改,あらためなさい。ほかの神々,かみがみに従,したがい仕,つかえてはならない。そうすれば、あなたがたはわたしがあなたがたと、あなたがたの先祖,せんぞに与,あたえたこの地,ちに住,すむことができる』と。しかしあなたがたは耳,みみを傾,かたむけず、わたしに聞,きかなかった。","tok":[["わたし"],["は"],["また"],["、"],["わたし"],["の"],["しもべ"],["で"],["ある"],["預言者","よげんしゃ"],["たち"],["を"],["、"],["しきり"],["に"],["あなた"],["がた"],["に"],["つかわして"],["言わせた","いわせた"],["、"],["『"],["あなた"],["がた"],["は"],["今","いま"],["おのおの"],["その"],["悪い","わるい"],["道","みち"],["を"],["離れ","はなれ"],["、"],["その"],["行ない","おこない"],["を"],["改め","あらため"],["なさい"],["。"],["ほか"],["の"],["神々","かみがみ"],["に"],["従い","したがい"],["仕えて","つかえて"],["は"],["ならない"],["。"],["そう"],["すれば"],["、"],["あなた"],["がた"],["は"],["わたし"],["が"],["あなた"],["がた"],["と"],["、"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["に"],["与えた","あたえた"],["この"],["地","ち"],["に"],["住む","すむ"],["こと"],["が"],["できる"],["』"],["と"],["。"],["しかし"],["あなた"],["がた"],["は"],["耳","みみ"],["を"],["傾むけず","かたむけず"],["、"],["わたし"],["に"],["聞かなかった","きかなかった"],["。"]]},{"verse":16,"text":"レカブの子,こヨナダブの子孫,しそんは、その先祖,せんぞが彼,かれらに命,めいじた命令,めいれいを守,まもっているのである。しかしこの民,たみはわたしに従,したがわなかった。","tok":[["レカブ"],["の"],["子","こ"],["ヨナダブ"],["の"],["子孫","しそん"],["は"],["、"],["その"],["先祖","せんぞ"],["が"],["彼","かれ"],["ら"],["に"],["命じた","めいじた"],["命令","めいれい"],["を"],["守って","まもって"],["いる"],["ので"],["ある"],["。"],["しかし"],["この"],["民","たみ"],["は"],["わたし"],["に"],["従わなかった","したがわなかった"],["。"]]},{"verse":17,"text":"それゆえ万軍,ばんぐんの神,かみ、主,しゅ、イスラエルの神,かみはこう仰,おおせられる、見,みよ、わたしはユダとエルサレムに住,すむ者,ものとに、わたしが彼,かれらの上,うえに宣告,せんこくした災,わざわいを下,くだす。わたしが彼,かれらに語,かたっても聞,きかず、彼,かれらを呼,よんでも答,こたえなかったからである」。","tok":[["それ"],["ゆえ"],["万","まん"],["軍","ぐん"],["の"],["神","かみ"],["、"],["主","しゅ"],["、"],["イスラエル"],["の"],["神","かみ"],["は"],["こう"],["仰せられる","おおせられる"],["、"],["見よ","みよ"],["、"],["わたし"],["は"],["ユダ"],["と"],["エルサレム"],["に"],["住む","すむ"],["者","もの"],["と"],["に"],["、"],["わたし"],["が"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["宣告","せんこく"],["した"],["災","わざわい"],["を"],["下す","くだす"],["。"],["わたし"],["が"],["彼","かれ"],["ら"],["に"],["語って","かたって"],["も"],["聞かず","きかず"],["、"],["彼","かれ"],["ら"],["を"],["呼","よん"],["で"],["も"],["答","こたえ"],["なかった"],["から"],["で"],["ある"],["」"],["。"]]},{"verse":18,"text":"ところでエレミヤはレカブびとの家,いえの人々,ひとびとに言,いった、「万軍,ばんぐんの主,しゅ、イスラエルの神,かみはこう仰,おおせられる、あなたがたは先祖,せんぞヨナダブの命,いのちに従,したがい、そのすべての戒,いましめを守,まもり、彼,かれがあなたがたに命,めいじた事,ことを行,おこなった。","tok":[["ところ"],["で"],["エレミヤ"],["は"],["レカブ"],["びと"],["の"],["家","いえ"],["の"],["人々","ひとびと"],["に"],["言った","いった"],["、"],["「"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["、"],["イスラエル"],["の"],["神","かみ"],["は"],["こう"],["仰せられる","おおせられる"],["、"],["あなた"],["がた"],["は"],["先祖","せんぞ"],["ヨナダブ"],["の"],["命","いのち"],["に"],["従い","したがい"],["、"],["その"],["すべて"],["の"],["戒しめ","いましめ"],["を"],["守り","まもり"],["、"],["彼","かれ"],["が"],["あなた"],["がた"],["に"],["命じた","めいじた"],["事","こと"],["を"],["行なった","おこなった"],["。"]]},{"verse":19,"text":"それゆえ、万軍,ばんぐんの主,しゅ、イスラエルの神,かみはこう言,いわれる、レカブの子,こヨナダブには、わたしの前,まえに立,たつ人,ひとがいつまでも欠,かけることはない」。","tok":[["それ"],["ゆえ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["、"],["イスラエル"],["の"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["レカブ"],["の"],["子","こ"],["ヨナダブ"],["に"],["は"],["、"],["わたし"],["の"],["前","まえ"],["に"],["立つ","たつ"],["人","ひと"],["が"],["いつ"],["まで"],["も"],["欠ける","かける"],["こと"],["は"],["ない"],["」"],["。"]]}]
[{"verse":1,"text":"バビロンの王,おうネブカデレザルがその全,ぜん軍,ぐんと、彼,かれに従,したがっている地,ちのすべての国,くにの人々,ひとびと、およびもろもろの民,たみを率,ひきいて、エルサレムとその町々,まちまちを攻,せめて戦,たたかっていた時,ときに、主,しゅからエレミヤに臨,のぞんだ言葉,ことば、","tok":[["バビロン"],["の"],["王","おう"],["ネブカデレザル"],["が"],["その"],["全軍","ぜんぐん"],["と"],["、"],["彼","かれ"],["に"],["従って","したがって"],["いる"],["地","ち"],["の"],["すべて"],["の"],["国","くに"],["の"],["人々","ひとびと"],["、"],["および"],["もろもろ"],["の"],["民","たみ"],["を"],["率いて","ひきいて"],["、"],["エルサレム"],["と"],["その"],["町々","まちまち"],["を"],["攻めて","せめて"],["戦って","たたかって"],["いた"],["時","とき"],["に"],["、"],["主ら","しゅから"],["エレミヤ"],["に"],["臨んだ","のぞんだ"],["言葉","ことば"],["、"]]},{"verse":2,"text":"「イスラエルの神,かみ、主,しゅはこう言,いわれる、行,いってユダの王,おうゼデキヤに告,つげて言,いいなさい、『主,しゅはこう言,いわれる、見,みよ、わたしはこの町,まちをバビロンの王,おうの手,てに渡,わたす。彼,かれは火,ひでこれを焼,やく。","tok":[["「"],["イスラエル"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["行って","いって"],["ユダ"],["の"],["王","おう"],["ゼデキヤ"],["に"],["告","つげ"],["て"],["言い","いい"],["なさい"],["、"],["『"],["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["見よ","みよ"],["、"],["わたし"],["は"],["この"],["町","まち"],["を"],["バビロン"],["の"],["王","おう"],["の"],["手","て"],["に"],["渡す","わたす"],["。"],["彼","かれ"],["は"],["火","ひ"],["で"],["これ"],["を"],["焼く","やく"],["。"]]},{"verse":3,"text":"あなたはその手,てをのがれることはできない、必,かならず捕,とらえられてその手,てに渡,わたされる。あなたはまのあたりバビロンの王,おうを見,み、顔,かおと顔,かおを合,あわせて彼,かれと語,かたる。それからバビロンへ行,いく』。","tok":[["あなた"],["は"],["その"],["手","て"],["を"],["のがれる"],["こと"],["は"],["できない"],["、"],["必","かならず"],["捕らえられて","とらえられて"],["その"],["手","て"],["に"],["渡される","わたされる"],["。"],["あなた"],["は"],["まのあたり"],["バビロン"],["の"],["王","おう"],["を"],["見","み"],["、"],["顔","かお"],["と"],["顔","かお"],["を"],["合","あわせ"],["て"],["彼","かれ"],["と"],["語る","かたる"],["。"],["それ"],["から"],["バビロン"],["へ"],["行く","いく"],["』"],["。"]]},{"verse":4,"text":"しかしユダの王,おうゼデキヤよ、主,しゅの言葉,ことばを聞,ききなさい。主,しゅはあなたの事,ことについてこう言,いわれる、『あなたはつるぎで死,しぬことはない。","tok":[["しかし"],["ユダ"],["の"],["王","おう"],["ゼデキヤ"],["よ"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["を"],["聞","きき"],["なさい"],["。"],["主","しゅ"],["は"],["あなた"],["の"],["事","こと"],["について"],["こう"],["言われる","いわれる"],["、"],["『"],["あなた"],["は"],["つるぎ"],["で"],["死ぬ","しぬ"],["こと"],["は"],["ない"],["。"]]},{"verse":5,"text":"あなたは安,やすらかに死,しぬ。民,たみはあなたの先祖,せんぞであるあなたの先,さきの王,おうたちのために香,こうをたいたように、あなたのためにも香,こうをたき、またあなたのために嘆,なげいて「ああ、主君,しゅくんよ」と言,いう』。わたしがこの言葉,ことばをいうのであると主,しゅは言,いわれる」。","tok":[["あなた"],["は"],["安らか","やすらか"],["に"],["死ぬ","しぬ"],["。"],["民","たみ"],["は"],["あなた"],["の"],["先祖","せんぞ"],["で"],["ある"],["あなた"],["の"],["先","さき"],["の"],["王","おう"],["たち"],["の"],["ため"],["に"],["香","こう"],["を"],["たいた"],["よう"],["に"],["、"],["あなた"],["の"],["ため"],["に"],["も"],["香","こう"],["を"],["たき"],["、"],["また"],["あなた"],["の"],["ため"],["に"],["嘆いて","なげいて"],["「"],["ああ"],["、"],["主君","しゅくん"],["よ"],["」"],["と"],["言う","いう"],["』"],["。"],["わたし"],["が"],["この"],["言葉","ことば"],["を"],["いう"],["ので"],["ある"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["」"],["。"]]},{"verse":6,"text":"そこで預言者,よげんしゃエレミヤはこの言葉,ことばをことごとくエルサレムでユダの王,おうゼデキヤに告,つげた。","tok":[["そこ"],["で"],["預言者","よげんしゃ"],["エレミヤ"],["は"],["この"],["言葉","ことば"],["を"],["ことごとく"],["エルサレム"],["で"],["ユダ"],["の"],["王","おう"],["ゼデキヤ"],["に"],["告","つげ"],["た"],["。"]]},{"verse":7,"text":"その時,ときバビロンの王,おうの軍勢,ぐんぜいはエルサレム、および残,のこっているユダのすべての町,まち、すなわちラキシとアゼカを攻,せめて戦,たたかっていた。それはユダの町々,まちまちのうちに、これらの堅固,けんごな町,まちがなお残,のこっていたからである。","tok":[["その"],["時","とき"],["バビロン"],["の"],["王","おう"],["の"],["軍勢","ぐんぜい"],["は"],["エルサレム"],["、"],["および"],["残って","のこって"],["いる"],["ユダ"],["の"],["すべて"],["の"],["町","まち"],["、"],["すなわち"],["ラキシ"],["と"],["アゼカ"],["を"],["攻めて","せめて"],["戦って","たたかって"],["いた"],["。"],["それ"],["は"],["ユダ"],["の"],["町々","まちまち"],["の"],["うち"],["に"],["、"],["これ"],["ら"],["の"],["堅固","けんご"],["な"],["町","まち"],["が"],["なお"],["残って","のこって"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":8,"text":"ゼデキヤ王,おうがエルサレムにいるすべての民,たみと契約,けいやくを立,たてて、彼,かれらに釈放,しゃくほうのことを告,つげ示,しめした後,のちに、主,しゅからエレミヤに臨,のぞんだ言葉,ことば。","tok":[["ゼデキヤ"],["王","おう"],["が"],["エルサレム"],["に"],["いる"],["すべて"],["の"],["民","たみ"],["と"],["契約","けいやく"],["を"],["立てて","たてて"],["、"],["彼","かれ"],["ら"],["に"],["釈放","しゃくほう"],["の"],["こと"],["を"],["告示","つげし"],["めした"],["後","のち"],["に"],["、"],["主ら","しゅから"],["エレミヤ"],["に"],["臨んだ","のぞんだ"],["言葉","ことば"],["。"]]},{"verse":9,"text":"その契約,けいやくはすなわち人,ひとがおのおのそのヘブルびとである男女,だんじょの奴隷,どれいを解放,かいほうし、その兄弟,きょうだいであるユダヤ人,ひとを奴隷,どれいとしないことを定,さだめたものであった。","tok":[["その"],["契約","けいやく"],["は"],["すなわち"],["人","ひと"],["が"],["おのおの"],["その"],["ヘブル"],["びと"],["で"],["ある"],["男女","だんじょ"],["の"],["奴隷","どれい"],["を"],["解放","かいほう"],["し"],["、"],["その"],["兄弟","きょうだい"],["で"],["ある"],["ユダヤ人","ゆだやひと"],["を"],["奴隷","どれい"],["と"],["しない"],["こと"],["を"],["定めた","さだめた"],["もの"],["で"],["あった"],["。"]]},{"verse":10,"text":"この契約,けいやくをしたつかさたちと、すべての民,たみは人,ひとがおのおのその男女,だんじょの奴隷,どれいを解放,かいほうし、再,ふたたびこれを奴隷,どれいとしないということに聞,きき従,したがって、これを解放,かいほうしたが、","tok":[["この"],["契約","けいやく"],["を"],["した"],["つかさ"],["たち"],["と"],["、"],["すべて"],["の"],["民","たみ"],["は"],["人","ひと"],["が"],["おのおの"],["その"],["男女","だんじょ"],["の"],["奴隷","どれい"],["を"],["解放","かいほう"],["し"],["、"],["再び","ふたたび"],["これ"],["を"],["奴隷","どれい"],["と"],["しない"],["と"],["いう"],["こと"],["に"],["聞","きき"],["従って","したがって"],["、"],["これ"],["を"],["解放","かいほう"],["した"],["が"],["、"]]},{"verse":11,"text":"後,のちに心,こころを翻,ひるがえし、解放,かいほうした男女,だんじょの奴隷,どれいをひきかえさせ、再,ふたたびこれを従,したがわせて奴隷,どれいとした。","tok":[["後","のち"],["に"],["心","こころ"],["を"],["翻がえし","ひるがえし"],["、"],["解放","かいほう"],["した"],["男女","だんじょ"],["の"],["奴隷","どれい"],["を"],["ひきかえさせ"],["、"],["再び","ふたたび"],["これ"],["を"],["従わせて","したがわせて"],["奴隷","どれい"],["と"],["した"],["。"]]},{"verse":12,"text":"そこで主,しゅの言葉,ことばが主,しゅからエレミヤに臨,のぞんだ、","tok":[["そこ"],["で"],["主","しゅ"],["の"],["言葉","ことば"],["が"],["主ら","しゅから"],["エレミヤ"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":13,"text":"「イスラエルの神,かみ、主,しゅはこう言,いわれる、わたしはあなたがたの先祖,せんぞをエジプトの地,ち、その奴隷,どれいであった家,いえから導,みちびき出,だした時,とき、彼,かれらと契約,けいやくを立,たてて言,いった、","tok":[["「"],["イスラエル"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["わたし"],["は"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["を"],["エジプト"],["の"],["地","ち"],["、"],["その"],["奴隷","どれい"],["で"],["あった"],["家","いえ"],["から"],["導き出した","みちびきだした"],["時","とき"],["、"],["彼","かれ"],["ら"],["と"],["契約","けいやく"],["を"],["立てて","たてて"],["言った","いった"],["、"]]},{"verse":14,"text":"『あなたがたの兄弟,きょうだいであるヘブルびとで、あなたがたに身,みを売,うり、六年,ねんの間,あいだあなたがたに仕,つかえた者,ものは、六年,ねんの終,おわりに、あなたがたおのおのがこれを解放,かいほうしなければならない。あなたがたは彼,かれを解放,かいほうして、あなたがたに仕,つかえることをやめさせなければならない』。ところがあなたがたの先祖,せんぞたちはわたしに聞,きき従,したがわず、またその耳,みみを傾,かたむけなかった。","tok":[["『"],["あなた"],["がた"],["の"],["兄弟","きょうだい"],["で"],["ある"],["ヘブル"],["びと"],["で"],["、"],["あなた"],["がた"],["に"],["身","み"],["を"],["売","うり"],["、"],["六","ろく"],["年","ねん"],["の"],["間","あいだ"],["あなた"],["がた"],["に"],["仕えた","つかえた"],["者","もの"],["は"],["、"],["六","ろく"],["年","ねん"],["の"],["終わり","おわり"],["に"],["、"],["あなた"],["がた"],["おのおの"],["が"],["これ"],["を"],["解放","かいほう"],["しなければ"],["ならない"],["。"],["あなた"],["がた"],["は"],["彼","かれ"],["を"],["解放","かいほう"],["して"],["、"],["あなた"],["がた"],["に"],["仕える","つかえる"],["こと"],["を"],["やめさせなければ"],["ならない"],["』"],["。"],["ところ"],["が"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["たち"],["は"],["わたし"],["に"],["聞","きき"],["従わず","したがわず"],["、"],["また"],["その"],["耳","みみ"],["を"],["傾むけなかった","かたむけなかった"],["。"]]},{"verse":15,"text":"しかしあなたがたは今日,こんにち、心,こころを改,あらため、おのおのその隣,となり人,びとに釈放,しゃくほうのことを告,つげ示,しめして、わたしの見,みて正,ただしいとすることを行,おこない、かつわたしの名,なをもってとなえられる家,いえで、わたしの前,まえに契約,けいやくを立,たてた。","tok":[["しかし"],["あなた"],["がた"],["は"],["今日","こん"],["に"],["ち"],["、"],["心","こころ"],["を"],["改","あらため"],["、"],["おのおの"],["その"],["隣人","となりびと"],["に"],["釈放","しゃくほう"],["の"],["こと"],["を"],["告示","つげし"],["めして"],["、"],["わたし"],["の"],["見て","みて"],["正い","ただしい"],["と"],["する"],["こと"],["を"],["行ない","おこない"],["、"],["かつ"],["わたし"],["の"],["名","な"],["を"],["もって"],["となえられる"],["家","いえ"],["で"],["、"],["わたし"],["の"],["前","まえ"],["に"],["契約","けいやく"],["を"],["立てた","たてた"],["。"]]},{"verse":16,"text":"ところがあなたがたは再,ふたたび心,こころを翻,ひるがえして、わたしの名,なを汚,けがし、おのおの男女,だんじょの奴隷,どれいをその願,ねがいのままに解放,かいほうしたのをひきかえさせ、再,ふたたびこれを従,したがわせて、あなたがたの奴隷,どれいとした。","tok":[["ところ"],["が"],["あなた"],["がた"],["は"],["再び","ふたたび"],["心","こころ"],["を"],["翻がえして","ひるがえして"],["、"],["わたし"],["の"],["名","な"],["を"],["汚","け"],["がし"],["、"],["おのおの"],["男女","だんじょ"],["の"],["奴隷","どれい"],["を"],["その"],["願い","ねがい"],["の"],["まま"],["に"],["解放","かいほう"],["した"],["の"],["を"],["ひきかえさせ"],["、"],["再び","ふたたび"],["これ"],["を"],["従わせて","したがわせて"],["、"],["あなた"],["がた"],["の"],["奴隷","どれい"],["と"],["した"],["。"]]},{"verse":17,"text":"それゆえに、主,しゅはこう仰,おおせられる、あなたがたがわたしに聞,きき従,したがわず、おのおのその兄弟,きょうだいとその隣,となりに釈放,しゃくほうのことを告,つげ示,しめさなかったので、見,みよ、わたしはあなたがたのために釈放,しゃくほうを告,つげ示,しめして、あなたがたをつるぎと、疫病,えきびょうと、ききんとに渡,わたすと主,しゅは言,いわれる。わたしはあなたがたを地,ちのもろもろの国,くにに忌,いみきらわれるものとする。","tok":[["それ"],["ゆえ"],["に"],["、"],["主","しゅ"],["は"],["こう"],["仰せられる","おおせられる"],["、"],["あなた"],["がた"],["が"],["わたし"],["に"],["聞","きき"],["従わず","したがわず"],["、"],["おのおの"],["その"],["兄弟","きょうだい"],["と"],["その"],["隣","となり"],["に"],["釈放","しゃくほう"],["の"],["こと"],["を"],["告","つげ"],["示めさなかった","しめさなかった"],["ので"],["、"],["見よ","みよ"],["、"],["わたし"],["は"],["あなた"],["がた"],["の"],["ため"],["に"],["釈放","しゃくほう"],["を"],["告示","つげし"],["めして"],["、"],["あなた"],["がた"],["を"],["つるぎ"],["と"],["、"],["疫病","えきびょう"],["と"],["、"],["ききん"],["と"],["に"],["渡す","わたす"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["。"],["わたし"],["は"],["あなた"],["がた"],["を"],["地","ち"],["の"],["もろもろ"],["の"],["国","くに"],["に"],["忌","いみ"],["きらわれる"],["もの"],["と"],["する"],["。"]]},{"verse":18,"text":"わたしの契約,けいやくを破,やぶり、わたしの前,まえに立,たてた契約,けいやくの定,さだめに従,したがわない人々,ひとびとを、わたしは彼,かれらが二つに裂,さいて、その二つの間,あいだを通,とおった子,こ牛,うしのようにする。――","tok":[["わたし"],["の"],["契約","けいやく"],["を"],["破り","やぶり"],["、"],["わたし"],["の"],["前","まえ"],["に"],["立てた","たてた"],["契約","けいやく"],["の"],["定め","さだめ"],["に"],["従わない","したがわない"],["人々","ひとびと"],["を"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["が"],["二","ふた"],["つ"],["に"],["裂いて","さいて"],["、"],["その"],["二","ふた"],["つ"],["の"],["間","あいだ"],["を"],["通った","とおった"],["子牛","こうし"],["の"],["よう"],["に"],["する"],["。"],["―"],["―"]]},{"verse":19,"text":"すなわち二つに分,わけた子,こ牛,うしの間,あいだを通,とおったユダのつかさたち、エルサレムのつかさたちと宦官,かんがんと祭司,さいしと、この地,ちのすべての民,たみを、","tok":[["すなわち"],["二","ふた"],["つ"],["に"],["分けた","わけた"],["子牛","こうし"],["の"],["間","あいだ"],["を"],["通った","とおった"],["ユダ"],["の"],["つかさ"],["たち"],["、"],["エルサレム"],["の"],["つかさ"],["たち"],["と"],["宦官","かんがん"],["と"],["祭司","さいし"],["と"],["、"],["この"],["地","ち"],["の"],["すべて"],["の"],["民","たみ"],["を"],["、"]]},{"verse":20,"text":"わたしはその敵,てきの手,てと、その命,いのちを求,もとめる者,ものの手,てに渡,わたす。その死体,したいは空,そらの鳥,とりと野,のの獣,けものの食物,しょくもつとなる。","tok":[["わたし"],["は"],["その"],["敵","てき"],["の"],["手","て"],["と"],["、"],["その"],["命","いのち"],["を"],["求める","もとめる"],["者","もの"],["の"],["手","て"],["に"],["渡す","わたす"],["。"],["その"],["死体","したい"],["は"],["空","そら"],["の"],["鳥","とり"],["と"],["野","の"],["の"],["獣","けもの"],["の"],["食物","しょくもつ"],["と"],["なる"],["。"]]},{"verse":21,"text":"わたしはまたユダの王,おうゼデキヤと、そのつかさたちをその敵,てきの手,て、その命,いのちを求,もとめる者,ものの手,て、あなたがたを離,はなれて去,さったバビロンの王,おうの軍勢,ぐんぜいの手,てに渡,わたす。","tok":[["わたし"],["は"],["また"],["ユダ"],["の"],["王","おう"],["ゼデキヤ"],["と"],["、"],["その"],["つかさ"],["たち"],["を"],["その"],["敵","てき"],["の"],["手","て"],["、"],["その"],["命","いのち"],["を"],["求める","もとめる"],["者","もの"],["の"],["手","て"],["、"],["あなた"],["がた"],["を"],["離れて","はなれて"],["去た","さった"],["バビロン"],["の"],["王","おう"],["の"],["軍勢","ぐんぜい"],["の"],["手","て"],["に"],["渡す","わたす"],["。"]]},{"verse":22,"text":"主,しゅは言,いわれる、見,みよ、わたしは彼,かれらに命,めいじて、この町,まちに引,ひきかえしてこさせる。彼,かれらはこの町,まちを攻,せめて戦,たたかい、これを取,とり、火,ひを放,はなって焼,やき払,はらう。わたしはユダの町々,まちまちを住,すむ人,ひとのない荒,あれ地,ちとする」。","tok":[["主","しゅ"],["は"],["言われる","いわれる"],["、"],["見よ","みよ"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["に"],["命じて","めいじて"],["、"],["この"],["町","まち"],["に"],["引か","ひきか"],["え"],["して"],["こさせる"],["。"],["彼","かれ"],["ら"],["は"],["この"],["町","まち"],["を"],["攻めて","せめて"],["戦い","たたかい"],["、"],["これ"],["を"],["取","とり"],["、"],["火","ひ"],["を"],["放って","はなって"],["焼き払う","やきはらう"],["。"],["わたし"],["は"],["ユダ"],["の"],["町々","まちまち"],["を"],["住む","すむ"],["人","ひと"],["の"],["ない"],["荒れ地","あれち"],["と"],["する"],["」"],["。"]]}]
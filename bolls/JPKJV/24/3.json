[{"verse":1,"text":"もし人,ひとがその妻,つまを離婚,りこんし、女,おんなが彼,かれのもとを去,さって、他人,たにんの妻,つまとなるなら、その人,ひとはふたたび彼女,かのじょに帰,かえるであろうか。その地,ちは大,おおいに汚,けがれないであろうか。あなたは多,おおくの恋人,こいびとと姦淫,かんいんを行,おこなった。しかもわたしに帰,かえろうというのか」と主,しゅは言,いわれる。","tok":[["もし"],["人","ひと"],["が"],["その"],["妻","つま"],["を"],["離婚","りこん"],["し"],["、"],["女","おんな"],["が"],["彼","かれ"],["の"],["もと"],["を"],["去て","さって"],["、"],["他人","たにん"],["の"],["妻","つま"],["と"],["なるなら"],["、"],["その"],["人","ひと"],["は"],["ふたたび"],["彼女","かのじょ"],["に"],["帰えるで","かえるで"],["あろう"],["か"],["。"],["その"],["地","ち"],["は"],["大いに","おおいに"],["汚","け"],["がれ"],["ないで"],["あろう"],["か"],["。"],["あなた"],["は"],["多く","おおく"],["の"],["恋人","こいびと"],["と"],["姦淫","かんいん"],["を"],["行なった","おこなった"],["。"],["しかも"],["わたし"],["に"],["帰えろう","かえろう"],["と"],["いう"],["の"],["か"],["」"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":2,"text":"「目,めをあげてもろもろの裸,はだかの山,やまを見,みよ、姦淫,かんいんを行,おこなわなかった所,ところがどこにあるか。荒野,あらのにいるアラビヤびとがするように、あなたは道,みちのかたわらに座,ざして恋人,こいびとを待,まった。あなたは姦淫,かんいんの悪事,あくじをもって、この地,ちを汚,けがした。","tok":[["「"],["目","め"],["を"],["あげて"],["もろもろ"],["の"],["裸","はだか"],["の"],["山","やま"],["を"],["見よ","みよ"],["、"],["姦淫","かんいん"],["を"],["行なわなかった","おこなわなかった"],["所","ところ"],["が"],["どこ"],["に"],["ある"],["か"],["。"],["荒野","あら"],["のに"],["いる"],["アラビヤ"],["びと"],["が"],["する"],["よう"],["に"],["、"],["あなた"],["は"],["道","みち"],["の"],["かたわら"],["に"],["座して","ざして"],["恋人","こいびと"],["を"],["待った","まった"],["。"],["あなた"],["は"],["姦淫","かんいん"],["の"],["悪事","あくじ"],["を"],["もって"],["、"],["この"],["地","ち"],["を"],["汚","け"],["がした"],["。"]]},{"verse":3,"text":"それゆえ雨,あめはとどめられ、春,はるの雨,あめは降,ふらなかった。しかもあなたには遊女,ゆうじょの額,ひたいがあり、少,すこしも恥,はじようとはしない。","tok":[["それ"],["ゆえ"],["雨","あめ"],["は"],["とどめられ"],["、"],["春","はる"],["の"],["雨","あめ"],["は"],["降らなかった","ふらなかった"],["。"],["しかも"],["あなた"],["に"],["は"],["遊女","ゆうじょ"],["の"],["額","ひたい"],["が"],["あり"],["、"],["少し","すこし"],["も"],["恥","はじ"],["よう"],["と"],["は"],["しない"],["。"]]},{"verse":4,"text":"今,いまあなたは、わたしを呼,よんで言,いったではないか、『わが父,ちちよ、あなたはわたしの若,わかい時,ときの友,ともです。","tok":[["今","いま"],["あなた"],["は"],["、"],["わたし"],["を"],["呼んで","よんで"],["言ったで","いったで"],["は"],["ない"],["か"],["、"],["『"],["わが"],["父","ちち"],["よ"],["、"],["あなた"],["は"],["わたし"],["の"],["若い","わかい"],["時","とき"],["の"],["友","とも"],["です"],["。"]]},{"verse":5,"text":"永久,えいきゅうに怒,いかられるのですか、終,おわりまで憤,いきどおられるのですか』と。見,みよ、あなたはこう言,いったけれども、なしうるかぎりのもろもろの悪,あくを行,おこなった」。","tok":[["永久","えいきゅう"],["に"],["怒","いかられる"],["の"],["です"],["か"],["、"],["終","おわり"],["まで"],["憤られる","いきどおられる"],["の"],["です"],["か"],["』"],["と"],["。"],["見よ","みよ"],["、"],["あなた"],["は"],["こう"],["言った","いった"],["けれど"],["も"],["、"],["なし"],["うる"],["かぎり"],["の"],["もろもろ"],["の"],["悪","あく"],["を"],["行なった","おこなった"],["」"],["。"]]},{"verse":6,"text":"ヨシヤ王,おうの時,とき、主,しゅはまたわたしに言,いわれた、「あなたは、かの背信,はいしんのイスラエルがしたことを見,みたか。彼女,かのじょはすべての高,たかい丘,おかにのぼり、すべての青,あお木,きの下,したに行,いって、そこで姦淫,かんいんを行,おこなった。","tok":[["ヨシヤ"],["王","おう"],["の"],["時","とき"],["、"],["主","しゅ"],["は"],["また"],["わたし"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["は"],["、"],["かの"],["背信","はいしん"],["の"],["イスラエル"],["が"],["した"],["こと"],["を"],["見た","みた"],["か"],["。"],["彼女","かのじょ"],["は"],["すべて"],["の"],["高い","たかい"],["丘","おか"],["に"],["のぼり"],["、"],["すべて"],["の"],["青木","あおき"],["の"],["下","した"],["に"],["行って","いって"],["、"],["そこ"],["で"],["姦淫","かんいん"],["を"],["行なった","おこなった"],["。"]]},{"verse":7,"text":"わたしは、彼女,かのじょがこのすべてを行,おこなった後,のち、わたしの所,ところに帰,かえるであろうと思,おもったが、帰,かえってこなかった。その不信,ふしんの姉妹,しまいユダはこれを見,みた。","tok":[["わたし"],["は"],["、"],["彼女","かのじょ"],["が"],["この"],["すべて"],["を"],["行なった","おこなった"],["後","の"],["ち"],["、"],["わたし"],["の"],["所","ところ"],["に"],["帰えるで","かえるで"],["あろう"],["と"],["思った","おもった"],["が"],["、"],["帰えって","かえって"],["こなかった"],["。"],["その"],["不信","ふしん"],["の"],["姉妹","しまい"],["ユダ"],["は"],["これ"],["を"],["見た","みた"],["。"]]},{"verse":8,"text":"わたしが背信,はいしんのイスラエルを、そのすべての姦淫,かんいんのゆえに、離縁,りえん状,じょうを与,あたえて出,だしたのをユダは見,みた。しかもその不信,ふしんの姉妹,しまいユダは恐,おそれず、自分,じぶんも行,いって姦淫,かんいんを行,おこなった。","tok":[["わたし"],["が"],["背信","はいしん"],["の"],["イスラエル"],["を"],["、"],["その"],["すべて"],["の"],["姦淫","かんいん"],["の"],["ゆえ"],["に"],["、"],["離縁状","りえんじょう"],["を"],["与","あたえ"],["て"],["出した","だした"],["の"],["を"],["ユダ"],["は"],["見た","みた"],["。"],["しかも"],["その"],["不信","ふしん"],["の"],["姉妹","しまい"],["ユダ"],["は"],["恐れず","おそれず"],["、"],["自分","じぶん"],["も"],["行って","いって"],["姦淫","かんいん"],["を"],["行なった","おこなった"],["。"]]},{"verse":9,"text":"彼女,かのじょにとって姦淫,かんいんは軽,かるいことであったので、石,いしと木,きとに姦淫,かんいんを行,いって、この地,ちを汚,けがした。","tok":[["彼女","かのじょ"],["にとって"],["姦淫","かんいん"],["は"],["軽い","かるい"],["こと"],["で"],["あった"],["ので"],["、"],["石","いし"],["と"],["木","き"],["と"],["に"],["姦淫","かんいん"],["を"],["行って","いって"],["、"],["この"],["地","ち"],["を"],["汚","け"],["がした"],["。"]]},{"verse":10,"text":"このすべての事,ことがあっても、なおその不信,ふしんの姉妹,しまいユダは真心,まごころをもってわたしに帰,かえらない、ただ偽,いつわっているだけだ」と主,しゅは言,いわれる。","tok":[["この"],["すべて"],["の"],["事","こと"],["が"],["あって"],["も"],["、"],["なお"],["その"],["不信","ふしん"],["の"],["姉妹","しまい"],["ユダ"],["は"],["真心","まごころ"],["を"],["もって"],["わたし"],["に"],["帰えらない","かえらない"],["、"],["ただ"],["偽わって","いつわって"],["いる"],["だけ"],["だ"],["」"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":11,"text":"主,しゅはまたわたしに言,いわれた、「背信,はいしんのイスラエルは不信,ふしんのユダよりも自分,じぶんの罪,つみの少,すくないことを示,しめした。","tok":[["主","しゅ"],["は"],["また"],["わたし"],["に"],["言われた","いわれた"],["、"],["「"],["背信","はいしん"],["の"],["イスラエル"],["は"],["不信","ふしん"],["の"],["ユダ"],["より"],["も"],["自分","じぶん"],["の"],["罪","つみ"],["の"],["少ない","すくない"],["こと"],["を"],["示めした","しめした"],["。"]]},{"verse":12,"text":"あなたは行,いって北,きたにむかい、この言葉,ことばをのべて言,いうがよい、『主,しゅは言,いわれる、背信,はいしんのイスラエルよ、帰,かえれ。わたしは怒,いかりの顔,かおをあなたがたに向,むけない、わたしはいつくしみ深,ふかい者,ものである。いつまでも怒,いかることはしないと、主,しゅは言,いわれる。","tok":[["あなた"],["は"],["行って","いって"],["北","きた"],["に"],["むかい"],["、"],["この"],["言葉","ことば"],["を"],["のべて"],["言","いう"],["が"],["よい"],["、"],["『"],["主","しゅ"],["は"],["言われる","いわれる"],["、"],["背信","はいしん"],["の"],["イスラエル"],["よ"],["、"],["帰えれ","かえれ"],["。"],["わたし"],["は"],["怒り","いかり"],["の"],["顔","かお"],["を"],["あなた"],["がた"],["に"],["向けない","むけない"],["、"],["わたし"],["は"],["いつくしみ"],["深い","ふかい"],["者","もの"],["で"],["ある"],["。"],["いつ"],["まで"],["も"],["怒","いかるこ"],["と"],["は"],["しない"],["と"],["、"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":13,"text":"ただあなたは自分,じぶんの罪,つみを認,みとめ、あなたの神,かみ、主,しゅにそむいてすべての青,あお木,きの下,したで異,ことなる神々,かみがみにあなたの愛,あいを惜,おしまず与,あたえたこと、わたしの声,こえに聞,きき従,したがわなかったことを言,いいあらわせと、主,しゅは言,いわれる。","tok":[["ただ"],["あなた"],["は"],["自分","じぶん"],["の"],["罪","つみ"],["を"],["認め","みとめ"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主に","しゅに"],["そむいて"],["すべて"],["の"],["青木","あおき"],["の"],["下","した"],["で"],["異なる","ことなる"],["神々","かみがみ"],["に"],["あなた"],["の"],["愛","あい"],["を"],["惜まず","おしまず"],["与えた","あたえた"],["こと"],["、"],["わたし"],["の"],["声","こえ"],["に"],["聞","きき"],["従わなかった","したがわなかった"],["こと"],["を"],["言いあらわせ","いいあらわせ"],["と"],["、"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":14,"text":"主,しゅは言,いわれる、背信,はいしんの子,こらよ、帰,かえれ。わたしはあなたがたの夫,おっとだからである。町,まちからひとり、氏族,しぞくからふたりを取,とって、あなたがたをシオンへ連,つれて行,いこう。","tok":[["主","しゅ"],["は"],["言われる","いわれる"],["、"],["背信","はいしん"],["の"],["子","こ"],["ら"],["よ"],["、"],["帰えれ","かえれ"],["。"],["わたし"],["は"],["あなた"],["がた"],["の"],["夫","おっと"],["だ"],["から"],["で"],["ある"],["。"],["町","まち"],["から"],["ひとり"],["、"],["氏族","しぞく"],["から"],["ふたり"],["を"],["取って","とって"],["、"],["あなた"],["がた"],["を"],["シオン"],["へ"],["連れて","つれて"],["行こう","いこう"],["。"]]},{"verse":15,"text":"わたしは自分,じぶんの心,こころにかなう牧者,ぼくしゃたちをあなたがたに与,あたえる。彼,かれらは知識,ちしきと悟,さとりとをもってあなたがたを養,やしなう。","tok":[["わたし"],["は"],["自分","じぶん"],["の"],["心","こころ"],["に"],["かなう"],["牧者","ぼくしゃ"],["たち"],["を"],["あなた"],["がた"],["に"],["与える","あたえる"],["。"],["彼","かれ"],["ら"],["は"],["知識","ちしき"],["と"],["悟り","さとり"],["と"],["を"],["もって"],["あなた"],["がた"],["を"],["養う","やしなう"],["。"]]},{"verse":16,"text":"主,しゅは言,いわれる、あなたがたが地,ちに増,まして多,おおくなるとき、その日,ひには、人々,ひとびとはかさねて「主,しゅの契約,けいやくの箱,はこ」と言,いわず、これを思,おもい出,ださず、これを覚,おぼえず、これを尋,たずねず、これを作,つくらない。","tok":[["主","しゅ"],["は"],["言われる","いわれる"],["、"],["あなた"],["がた"],["が"],["地","ち"],["に"],["増して","まして"],["多く","おおく"],["なる"],["とき"],["、"],["その"],["日","ひ"],["に"],["は"],["、"],["人々","ひとびと"],["は"],["かさねて"],["「"],["主","しゅ"],["の"],["契約","けいやく"],["の"],["箱","は"],["こ"],["」"],["と"],["言わず","いわず"],["、"],["これ"],["を"],["思い出さず","おもいださず"],["、"],["これ"],["を"],["覚えず","おぼえず"],["、"],["これ"],["を"],["尋ねず","たずねず"],["、"],["これ"],["を"],["作らない","つくらない"],["。"]]},{"verse":17,"text":"そのときエルサレムは主,しゅのみ位,くらいととなえられ、万国,ばんこくの民,たみはここに集,あつまる。すなわち主,しゅの名,なのもとにエルサレムに集,あつまり、かさねて、かたくなに自分,じぶんの悪,わるい心,こころに従,したがうことはしない。","tok":[["その"],["とき"],["エルサレム"],["は"],["主","しゅ"],["のみ"],["位","くらい"],["と"],["となえられ"],["、"],["万国","ばんこく"],["の"],["民","たみ"],["は"],["ここ"],["に"],["集まる","あつまる"],["。"],["すなわち"],["主","しゅ"],["の"],["名","な"],["の"],["もと"],["に"],["エルサレム"],["に"],["集まり","あつまり"],["、"],["かさねて"],["、"],["かたくな"],["に"],["自分","じぶん"],["の"],["悪い","わるい"],["心","こころ"],["に"],["従う","したがう"],["こと"],["は"],["しない"],["。"]]},{"verse":18,"text":"その日,ひには、ユダの家,いえはイスラエルの家,いえと一緒,いっしょになり、北,きたの地,ちから出,でて、わたしがあなたがたの先祖,せんぞたちに嗣,し業,ぎょうとして与,あたえた地,ちに共,ともに来,くる。","tok":[["その"],["日","ひ"],["に"],["は"],["、"],["ユダ"],["の"],["家","いえ"],["は"],["イスラエル"],["の"],["家","いえ"],["と"],["一緒","いっしょ"],["に"],["なり"],["、"],["北","きた"],["の"],["地","ち"],["から"],["出て","でて"],["、"],["わたし"],["が"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["たち"],["に"],["嗣業","しぎょう"],["として"],["与","あたえ"],["た"],["地","ち"],["に"],["共","とも"],["に"],["来る","くる"],["。"]]},{"verse":19,"text":"どのようにして、あなたをわたしの子,こどもたちのうちに置,おき、万国,ばんこくのうちで最,もっとも美,うつくしい嗣,し業,ぎょうである良,よい地,ちをあなたに与,あたえようかと、わたしは思,おもっていた。わたしはまた、あなたがわたしを「わが父,ちち」と呼,よび、わたしに従,したがって離,はなれることはないと思,おもっていた。","tok":[["どの"],["よう"],["に"],["して"],["、"],["あなた"],["を"],["わたし"],["の"],["子ども","こども"],["たち"],["の"],["うち"],["に"],["置き","おき"],["、"],["万国","ばんこく"],["の"],["うち"],["で"],["最も","もっとも"],["美しい","うつくしい"],["嗣業","しぎょ"],["うで"],["ある"],["良い","よい"],["地","ち"],["を"],["あなた"],["に"],["与","あたえ"],["よう"],["か"],["と"],["、"],["わたし"],["は"],["思って","おもって"],["いた"],["。"],["わたし"],["は"],["また"],["、"],["あなた"],["が"],["わたし"],["を"],["「"],["わが"],["父","ちち"],["」"],["と"],["呼び","よび"],["、"],["わたし"],["に"],["従って","したがって"],["離れる","はなれる"],["こと"],["は"],["ない"],["と"],["思って","おもって"],["いた"],["。"]]},{"verse":20,"text":"イスラエルの家,いえよ、背信,はいしんの妻,つまが夫,おっとのもとを去,さるように、たしかに、あなたがたはわたしにそむいた』と主,しゅは言,いわれる」。","tok":[["イスラエル"],["の"],["家","いえ"],["よ"],["、"],["背信","はいしん"],["の"],["妻","つま"],["が"],["夫","おっと"],["の"],["もと"],["を"],["去る","さる"],["よう"],["に"],["、"],["たしか"],["に"],["、"],["あなた"],["がた"],["は"],["わたし"],["に"],["そむいた"],["』"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["」"],["。"]]},{"verse":21,"text":"裸,はだかの山,やまの上,うえに声,こえが聞,きこえる、イスラエルの民,たみが悲,かなしみ祈,いのるのである。彼,かれらが曲,まがった道,みちに歩,あゆみ、その神,かみ、主,しゅを忘,わすれたからだ。","tok":[["裸","はだか"],["の"],["山","やま"],["の"],["上","うえ"],["に"],["声","こえ"],["が"],["聞こえる","きこえる"],["、"],["イスラエル"],["の"],["民","たみ"],["が"],["悲しみ","かなしみ"],["祈る","いのる"],["ので"],["ある"],["。"],["彼","かれ"],["ら"],["が"],["曲がった","まがった"],["道","みち"],["に"],["歩み","あゆみ"],["、"],["その"],["神","かみ"],["、"],["主","しゅ"],["を"],["忘た","わすれた"],["から"],["だ"],["。"]]},{"verse":22,"text":"「背信,はいしんの子,こどもたちよ、帰,かえれ。わたしはあなたがたの背信,はいしんをいやす」。「見,みよ、われわれはあなたのもとに帰,かえります。あなたはわれわれの神,かみ、主,しゅであらせられます。","tok":[["「"],["背信","はいしん"],["の"],["子ども","こども"],["たち"],["よ"],["、"],["帰えれ","かえれ"],["。"],["わたし"],["は"],["あなた"],["がた"],["の"],["背信","はいしん"],["を"],["いやす"],["」"],["。"],["「"],["見よ","みよ"],["、"],["われわれ"],["は"],["あなた"],["の"],["もと"],["に"],["帰えります","かえります"],["。"],["あなた"],["は"],["われわれ"],["の"],["神","かみ"],["、"],["主らせられます","しゅであらせられます"],["。"]]},{"verse":23,"text":"まことに、もろもろの丘,おかは迷,まよいであり、山,やまの上,うえの騒,さわぎも同,おなじです。まことに、イスラエルの救,すくいはわれわれの神,かみ、主,しゅにあるのです。","tok":[["まこと"],["に"],["、"],["もろもろ"],["の"],["丘","おか"],["は"],["迷い","まよい"],["で"],["あり"],["、"],["山","やま"],["の"],["上","うえ"],["の"],["騒","さわぎ"],["も"],["同じ","おなじ"],["です"],["。"],["まこと"],["に"],["、"],["イスラエル"],["の"],["救い","すくい"],["は"],["われわれ"],["の"],["神","かみ"],["、"],["主に","しゅに"],["ある"],["の"],["です"],["。"]]},{"verse":24,"text":"しかし、われわれの幼少,ようしょうの時,ときから、恥,はずべきことが、われわれの先祖,せんぞのほねおって得,えたもの、すなわちその羊,ひつじ、その牛,うし、およびそのむすこ、娘,むすめたちをことごとくのみ尽,つくしました。","tok":[["しかし"],["、"],["われわれ"],["の"],["幼少","ようしょう"],["の"],["時","とき"],["から"],["、"],["恥ずべき","はずべき"],["こと"],["が"],["、"],["われわれ"],["の"],["先祖","せんぞ"],["の"],["ほねおって"],["得た","えた"],["もの"],["、"],["すなわち"],["その"],["羊","ひつじ"],["、"],["その"],["牛","うし"],["、"],["および"],["その"],["むすこ"],["、"],["娘","むすめ"],["たち"],["を"],["ことごとく"],["のみ"],["尽くしました","つくしました"],["。"]]},{"verse":25,"text":"われわれは恥,はじの中,なかに伏,ふし、はずかしめにおおわれています。それはわれわれと先祖,せんぞとが、われわれの幼少,ようしょうの時,ときから今日,こんにちまで、われわれの神,かみ、主,しゅに罪,つみを犯,おかし、われわれの神,かみ、主,しゅの声,こえに従,したがわなかったからです」。","tok":[["われわれ"],["は"],["恥","はじ"],["の"],["中","なか"],["に"],["伏し","ふし"],["、"],["はずかしめ"],["に"],["おおわれて"],["います"],["。"],["それ"],["は"],["われわれ"],["と"],["先祖","せんぞ"],["と"],["が"],["、"],["われわれ"],["の"],["幼少","ようしょう"],["の"],["時","とき"],["から"],["今日","こん"],["に"],["ち"],["まで"],["、"],["われわれ"],["の"],["神","かみ"],["、"],["主に","しゅに"],["罪","つみ"],["を"],["犯し","おかし"],["、"],["われわれ"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["声","こえ"],["に"],["従わなかった","したがわなかった"],["から"],["です"],["」"],["。"]]}]
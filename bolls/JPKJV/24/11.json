[{"verse":1,"text":"主,しゅからエレミヤに臨,のぞんだ言葉,ことばは言,いう、","tok":[["主ら","しゅから"],["エレミヤ"],["に"],["臨んだ","のぞんだ"],["言葉","ことば"],["は"],["言う","いう"],["、"]]},{"verse":2,"text":"「この契約,けいやくの言葉,ことばを聞,きき、ユダの人々,ひとびととエルサレムに住,すむ者,ものに告,つげよ。","tok":[["「"],["この"],["契約","けいやく"],["の"],["言葉","ことば"],["を"],["聞","きき"],["、"],["ユダ"],["の"],["人々","ひとびと"],["と"],["エルサレム"],["に"],["住む","すむ"],["者","もの"],["に"],["告","つげ"],["よ"],["。"]]},{"verse":3,"text":"彼,かれらに言,いえ、イスラエルの神,かみ、主,しゅはこう仰,おおせられる、この契約,けいやくの言葉,ことばに従,したがわない人,ひとは、のろわれる。","tok":[["彼","かれ"],["ら"],["に"],["言え","いえ"],["、"],["イスラエル"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["こう"],["仰せられる","おおせられる"],["、"],["この"],["契約","けいやく"],["の"],["言葉","ことば"],["に"],["従わない","したがわない"],["人","ひと"],["は"],["、"],["のろわれる"],["。"]]},{"verse":4,"text":"この契約,けいやくは、わたしがあなたがたの先祖,せんぞをエジプトの地,ち、鉄,てつのかまどの中,なかから導,みちびき出,だした時,ときに、彼,かれらに命,めいじたところのものである。すなわち、その時,ときわたしは彼,かれらに言,いった、わたしの声,こえを聞,きき、あなたがたに命,めいじるすべてのことを行,おこなうならば、あなたがたはわたしの民,たみとなり、わたしはあなたがたの神,かみとなる。","tok":[["この"],["契約","けいやく"],["は"],["、"],["わたし"],["が"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["を"],["エジプト"],["の"],["地","ち"],["、"],["鉄","てつ"],["の"],["かまど"],["の"],["中","なか"],["から"],["導き出した","みちびきだした"],["時","とき"],["に"],["、"],["彼","かれ"],["ら"],["に"],["命じた","めいじた"],["ところ"],["の"],["もの"],["で"],["ある"],["。"],["すなわち"],["、"],["その"],["時","とき"],["わたし"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["わたし"],["の"],["声","こえ"],["を"],["聞","きき"],["、"],["あなた"],["がた"],["に"],["命じる","めいじる"],["すべて"],["の"],["こと"],["を"],["行なうならば","おこなうならば"],["、"],["あなた"],["がた"],["は"],["わたし"],["の"],["民","たみ"],["と"],["なり"],["、"],["わたし"],["は"],["あなた"],["がた"],["の"],["神","かみ"],["と"],["なる"],["。"]]},{"verse":5,"text":"そして、わたしがあなたがたの先祖,せんぞに、乳,ちちと蜜,みつとの流,ながれる地,ちを与,あたえると誓,ちかったことを、なし遂,とげると。すなわち今日,こんにちのとおりである」。その時,ときわたしは、「主,しゅよ、仰,おおせのとおりです」と答,こたえた。","tok":[["そして"],["、"],["わたし"],["が"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["に"],["、"],["乳","ちち"],["と"],["蜜","みつ"],["と"],["の"],["流れる","ながれる"],["地","ち"],["を"],["与える","あたえる"],["と"],["誓った","ちかった"],["こと"],["を"],["、"],["なし遂げる","なしとげる"],["と"],["。"],["すなわち"],["今日","こんにち"],["の"],["とおり"],["で"],["ある"],["」"],["。"],["その"],["時","とき"],["わたし"],["は"],["、"],["「"],["主","しゅ"],["よ"],["、"],["仰せ","おおせ"],["の"],["とおり"],["です"],["」"],["と"],["答","こたえ"],["た"],["。"]]},{"verse":6,"text":"主,しゅはわたしに言,いわれた、「このすべての言葉,ことばを、ユダの町々,まちまちと、エルサレムのちまたに告,つげ示,しめし、この契約,けいやくの言葉,ことばを聞,きき、これを行,おこなえ、と言,いいなさい。","tok":[["主","しゅ"],["は"],["わたし"],["に"],["言われた","いわれた"],["、"],["「"],["この"],["すべて"],["の"],["言葉","ことば"],["を"],["、"],["ユダ"],["の"],["町々","まちまち"],["と"],["、"],["エルサレム"],["の"],["ちまた"],["に"],["告","つげ"],["示めし","しめし"],["、"],["この"],["契約","けいやく"],["の"],["言葉","ことば"],["を"],["聞","きき"],["、"],["これ"],["を"],["行なえ","おこなえ"],["、"],["と"],["言い","いい"],["なさい"],["。"]]},{"verse":7,"text":"わたしは、あなたがたの先祖,せんぞをエジプトの地,ちから導,みちびき出,だした時,ときから今日,こんにちにいたるまで、おごそかに彼,かれらを戒,いましめ、絶,たえず戒,いましめて、わたしの声,こえに聞,きき従,したがうようにと言,いった。","tok":[["わたし"],["は"],["、"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["を"],["エジプト"],["の"],["地","ち"],["から"],["導き出した","みちびきだした"],["時","とき"],["から"],["今日","こんにち"],["に"],["いたる"],["まで"],["、"],["おごそか"],["に"],["彼","かれ"],["ら"],["を"],["戒しめ","いましめ"],["、"],["絶えず","たえず"],["戒しめ","いましめ"],["て"],["、"],["わたし"],["の"],["声","こえ"],["に"],["聞","きき"],["従う","したがう"],["よう"],["に"],["と"],["言った","いった"],["。"]]},{"verse":8,"text":"しかし彼,かれらは従,したがわず、その耳,みみを傾,かたむけず、おのおの自分,じぶんの悪,わるい強情,ごうじょうな心,こころに従,したがって歩,あゆんだ。それゆえ、わたしはこの契約,けいやくの言葉,ことばをもって彼,かれらを責,せめた。これはわたしが彼,かれらに行,おこなえと命,めいじたが、行,おこなわなかったものである」。","tok":[["しかし"],["彼","かれ"],["ら"],["は"],["従わず","したがわず"],["、"],["その"],["耳","みみ"],["を"],["傾むけず","かたむけず"],["、"],["おのおの"],["自分","じぶん"],["の"],["悪い","わるい"],["強情","ごうじょう"],["な"],["心","こころ"],["に"],["従って","したがって"],["歩んだ","あゆんだ"],["。"],["それ"],["ゆえ"],["、"],["わたし"],["は"],["この"],["契約","けいやく"],["の"],["言葉","ことば"],["を"],["もって"],["彼","かれ"],["ら"],["を"],["責","せめ"],["た"],["。"],["これ"],["は"],["わたし"],["が"],["彼","かれ"],["ら"],["に"],["行なえ","おこなえ"],["と"],["命じた","めいじた"],["が"],["、"],["行なわなかった","おこなわなかった"],["もの"],["で"],["ある"],["」"],["。"]]},{"verse":9,"text":"主,しゅはまたわたしに言,いわれた、「ユダの人々,ひとびととエルサレムに住,すむ者,もののうちに反逆,はんぎゃくの事,ことがある。","tok":[["主","しゅ"],["は"],["また"],["わたし"],["に"],["言われた","いわれた"],["、"],["「"],["ユダ"],["の"],["人々","ひとびと"],["と"],["エルサレム"],["に"],["住む","すむ"],["者","もの"],["の"],["うち"],["に"],["反逆","はんぎゃく"],["の"],["事","こと"],["が"],["ある"],["。"]]},{"verse":10,"text":"彼,かれらは、わたしの言葉,ことばを聞,きくことを拒,こばんだその先祖,せんぞたちの罪,つみに立,たち返,かえり、またほかの神々,かみがみに従,したがってそれに仕,つかえた。イスラエルの家,いえとユダの家,いえとは、わたしがその先祖,せんぞたちと結,むすんだ契約,けいやくを破,やぶった。","tok":[["彼","かれ"],["ら"],["は"],["、"],["わたし"],["の"],["言葉","ことば"],["を"],["聞く","きく"],["こと"],["を"],["拒","こばんだそ"],["の"],["先祖","せんぞ"],["たち"],["の"],["罪","つみ"],["に"],["立ち返り","たちかえり"],["、"],["また"],["ほか"],["の"],["神々","かみがみ"],["に"],["従って","したがって"],["それ"],["に"],["仕えた","つかえた"],["。"],["イスラエル"],["の"],["家","いえ"],["と"],["ユダ"],["の"],["家","いえ"],["と"],["は"],["、"],["わたし"],["が"],["その"],["先祖","せんぞ"],["たち"],["と"],["結んだ","むすんだ"],["契約","けいやく"],["を"],["破った","やぶった"],["。"]]},{"verse":11,"text":"それゆえ主,しゅはこう言,いわれる、見,みよ、わたしは災,わざわいを彼,かれらの上,うえに下,くだす。彼,かれらはそれを免,まぬかれることはできない。彼,かれらがわたしを呼,よんでも、わたしは聞,きかない。","tok":[["それ"],["ゆえ"],["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["見よ","みよ"],["、"],["わたし"],["は"],["災","わざわい"],["を"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["下す","くだす"],["。"],["彼","かれ"],["ら"],["は"],["それ"],["を"],["免かれる","まぬかれる"],["こと"],["は"],["できない"],["。"],["彼","かれ"],["ら"],["が"],["わたし"],["を"],["呼","よん"],["で"],["も"],["、"],["わたし"],["は"],["聞かない","きかない"],["。"]]},{"verse":12,"text":"ユダの町々,まちまちとエルサレムに住,すむ者,ものは、行,いって、自分,じぶんたちがそれに香,こうをたいている神々,かみがみに呼,よび求,もとめるが、これらは、彼,かれらの災,わざわいの時,ときにも決,けっして彼,かれらを救,すくうことはできない。","tok":[["ユダ"],["の"],["町々","まちまち"],["と"],["エルサレム"],["に"],["住む","すむ"],["者","もの"],["は"],["、"],["行って","いって"],["、"],["自分","じぶん"],["たち"],["が"],["それ"],["に"],["香","こう"],["を"],["たいて"],["いる"],["神々","かみがみ"],["に"],["呼び求める","よびもとめる"],["が"],["、"],["これ"],["ら"],["は"],["、"],["彼","かれ"],["ら"],["の"],["災","わざわい"],["の"],["時","とき"],["に"],["も"],["決っして","けっして"],["彼","かれ"],["ら"],["を"],["救う","すくう"],["こと"],["は"],["できない"],["。"]]},{"verse":13,"text":"ユダよ、あなたの神々,かみがみは、あなたの町,まちの数,かずほど多,おおくなった。またあなたがたはエルサレムのちまたの数,かずほどの祭壇,さいだんを恥,はずべき者,もののために立,たてた。すなわちバアルに香,こうをたくための祭壇,さいだんである。","tok":[["ユダ"],["よ"],["、"],["あなた"],["の"],["神々","かみがみ"],["は"],["、"],["あなた"],["の"],["町","まち"],["の"],["数","かず"],["ほど"],["多く","おおく"],["なった"],["。"],["また"],["あなた"],["がた"],["は"],["エルサレム"],["の"],["ちまた"],["の"],["数","かず"],["ほど"],["の"],["祭壇","さいだん"],["を"],["恥ずべき","はずべき"],["者","もの"],["の"],["ため"],["に"],["立てた","たてた"],["。"],["すなわち"],["バアル"],["に"],["香","こう"],["を"],["たく"],["ため"],["の"],["祭壇","さいだん"],["で"],["ある"],["。"]]},{"verse":14,"text":"それゆえ、この民,たみのために祈,いのってはならない。また彼,かれらのために泣,なき、あるいは祈,いのり求,もとめてはならない。彼,かれらがその災,わざわいの時,ときに、わたしに呼,よばわっても、わたしは彼,かれらに聞,きくことをしないからだ。","tok":[["それ"],["ゆえ"],["、"],["この"],["民","たみ"],["の"],["ため"],["に"],["祈って","いのって"],["は"],["ならない"],["。"],["また"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["泣","なき"],["、"],["あるいは"],["祈","いのり"],["求めて","もとめて"],["は"],["ならない"],["。"],["彼","かれ"],["ら"],["が"],["その"],["災","わざわい"],["の"],["時","とき"],["に"],["、"],["わたし"],["に"],["呼ばわって","よばわって"],["も"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["に"],["聞く","きく"],["こと"],["を"],["しない"],["から"],["だ"],["。"]]},{"verse":15,"text":"わが愛,あいする者,ものは、わたしの家,いえで何,なにをするのか。すでにこれは悪事,あくじを行,おこなった。誓願,せいがんと犠牲,ぎせいの肉,にくとがあなたに災,わざわいを免,まぬかれさせることができるであろうか。それであなたは喜,よろこぶことができるであろうか。","tok":[["わが"],["愛する","あいする"],["者","もの"],["は"],["、"],["わたし"],["の"],["家","いえ"],["で"],["何に","なに"],["を"],["する"],["の"],["か"],["。"],["すでに"],["これ"],["は"],["悪事","あくじ"],["を"],["行なった","おこなった"],["。"],["誓願","せいがん"],["と"],["犠牲","ぎせい"],["の"],["肉","にく"],["と"],["が"],["あなた"],["に"],["災","わざわい"],["を"],["免かれさせる","まぬかれさせる"],["こと"],["が"],["できるで"],["あろう"],["か"],["。"],["それ"],["で"],["あなた"],["は"],["喜こぶ","よろこぶ"],["こと"],["が"],["できるで"],["あろう"],["か"],["。"]]},{"verse":16,"text":"主,しゅはあなたを、かつては『良,よい実,みのなる美,うつくしい青々,あおあおとしたオリブの木,き』と呼,よばれたが、激,はげしい暴風,ぼうふうのとどろきと共,ともに、主,しゅはそれに火,ひをかけ、その枝,えだを焼,やき払,はらわれるのである。","tok":[["主","しゅ"],["は"],["あなた"],["を"],["、"],["かつて"],["は"],["『"],["良い","よい"],["実","み"],["の"],["なる"],["美しい","うつくしい"],["青々","あおあお"],["と"],["した"],["オリブ"],["の"],["木","き"],["』"],["と"],["呼ばれた","よばれた"],["が"],["、"],["激しい","はげしい"],["暴風","ぼうふう"],["の"],["とどろき"],["と"],["共","とも"],["に"],["、"],["主","しゅ"],["は"],["それ"],["に"],["火","ひ"],["を"],["かけ"],["、"],["その"],["枝","えだ"],["を"],["焼き払われる","やきはらわれる"],["ので"],["ある"],["。"]]},{"verse":17,"text":"あなたを植,うえた万軍,ばんぐんの主,しゅは、あなたに向,むかって災,わざわいを言,いい渡,わたされた。これはイスラエルの家,いえとユダの家,いえとが悪,あくを行,おこない、バアルに香,こうをたいて、わたしを怒,いからせたからである」。","tok":[["あなた"],["を"],["植えた","うえた"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["、"],["あなた"],["に"],["向かって","むかって"],["災","わざわい"],["を"],["言い渡された","いいわたされた"],["。"],["これ"],["は"],["イスラエル"],["の"],["家","いえ"],["と"],["ユダ"],["の"],["家","いえ"],["と"],["が"],["悪","あく"],["を"],["行ない","おこない"],["、"],["バアル"],["に"],["香","こう"],["を"],["たいて"],["、"],["わたし"],["を"],["怒らせた","いからせた"],["から"],["で"],["ある"],["」"],["。"]]},{"verse":18,"text":"主,しゅが知,しらせてくださったので、わたしはそれを知,しった。その時,とき、あなたは彼,かれらの悪,あしきわざをわたしに示,しめされた。","tok":[["主","しゅ"],["が"],["知らせて","しらせて"],["くださった"],["ので"],["、"],["わたし"],["は"],["それ"],["を"],["知った","しった"],["。"],["その"],["時","とき"],["、"],["あなた"],["は"],["彼","かれ"],["ら"],["の"],["悪しき","あしき"],["わざ"],["を"],["わたし"],["に"],["示めされた","しめされた"],["。"]]},{"verse":19,"text":"しかしわたしは、ほふられに行,いく、おとなしい小羊,こひつじのようで、彼,かれらがわたしを害,がいしようと、計,はかりごとをめぐらしているのを知,しらなかった。彼,かれらは言,いう、「さあ、木,きとその実,みを共,ともに滅,ほろぼそう。生,いける者,ものの地,ちから彼,かれを絶,たって、その名,なを人,ひとに忘,わすれさせよう」。","tok":[["しかし"],["わたし"],["は"],["、"],["ほふられ"],["に"],["行く","いく"],["、"],["おとなしい"],["小羊","こひつじ"],["の"],["よう"],["で"],["、"],["彼","かれ"],["ら"],["が"],["わたし"],["を"],["害しよう","がいしよう"],["と"],["、"],["計り","はかり"],["ごと"],["を"],["めぐらして"],["いる"],["の"],["を"],["知らなかった","しらなかった"],["。"],["彼","かれ"],["ら"],["は"],["言う","いう"],["、"],["「"],["さあ"],["、"],["木","き"],["と"],["その"],["実","み"],["を"],["共","とも"],["に"],["滅ぼそう","ほろぼそう"],["。"],["生ける","いける"],["者","もの"],["の"],["地","ち"],["から"],["彼","かれ"],["を"],["絶って","たって"],["、"],["その"],["名","な"],["を"],["人","ひと"],["に"],["忘させよう","わすれさせよう"],["」"],["。"]]},{"verse":20,"text":"正,ただしいさばきをし、人,ひとの心,こころと思,おもいを探,さぐられる万軍,ばんぐんの主,しゅよ、わたしは自分,じぶんの訴,うったえをあなたにお任,まかせしました。あなたが彼,かれらにあだをかえされるのを見,みさせてください。","tok":[["正い","ただしい"],["さばき"],["を"],["し"],["、"],["人","ひと"],["の"],["心","こころ"],["と"],["思い","おもい"],["を"],["探ぐられる","さぐられる"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["よ"],["、"],["わたし"],["は"],["自分","じぶん"],["の"],["訴","うったえ"],["を"],["あなた"],["に"],["お任せ","おまかせ"],["しました"],["。"],["あなた"],["が"],["彼","かれ"],["ら"],["に"],["あだ"],["を"],["かえされる"],["の"],["を"],["見させて","みさせて"],["ください"],["。"]]},{"verse":21,"text":"それゆえ主,しゅはアナトテの人々,ひとびとについてこう言,いわれる、彼,かれらはあなたの命,いのちを取,とろうと求,もとめて言,いう、「主,しゅの名,なによって預言,よげんしてはならない。それをするならば、あなたはわれわれの手,てにかかって死,しぬであろう」。","tok":[["それ"],["ゆえ"],["主","しゅ"],["は"],["アナトテ"],["の"],["人々","ひとびと"],["について"],["こう"],["言われる","いわれる"],["、"],["彼","かれ"],["ら"],["は"],["あなた"],["の"],["命","いのち"],["を"],["取ろう","とろう"],["と"],["求めて","もとめて"],["言う","いう"],["、"],["「"],["主","しゅ"],["の"],["名","な"],["によって"],["預言","よげん"],["して"],["は"],["ならない"],["。"],["それ"],["を"],["するならば"],["、"],["あなた"],["は"],["われわれ"],["の"],["手","て"],["に"],["かかって"],["死ぬで","しぬで"],["あろう"],["」"],["。"]]},{"verse":22,"text":"それで万軍,ばんぐんの主,しゅはこう言,いわれる、「見,みよ、わたしは彼,かれらを罰,ばっする。若,わかい人,ひとはつるぎで死,しに、彼,かれらのむすこ娘,むすめは、ききんで死,しに、","tok":[["それ"],["で"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["「"],["見よ","みよ"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["罰する","ばっする"],["。"],["若い","わかい"],["人","ひと"],["は"],["つるぎ"],["で"],["死に","しに"],["、"],["彼","かれ"],["ら"],["の"],["むすこ"],["娘","むすめ"],["は"],["、"],["ききん"],["で"],["死に","しに"],["、"]]},{"verse":23,"text":"だれも残,のこる者,ものはない。わたしがアナトテの人々,ひとびとに災,わざわいを下,くだし、彼,かれらを罰,ばっする年,ねんをこさせるからである」。","tok":[["だれ"],["も"],["残る","のこる"],["者","もの"],["は"],["ない"],["。"],["わたし"],["が"],["アナトテ"],["の"],["人々","ひとびと"],["に"],["災","わざわい"],["を"],["下し","くだし"],["、"],["彼","かれ"],["ら"],["を"],["罰する","ばっする"],["年","ねん"],["を"],["こさせる"],["から"],["で"],["ある"],["」"],["。"]]}]
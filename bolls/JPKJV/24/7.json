[{"verse":1,"text":"主,しゅからエレミヤに臨,のぞんだ言葉,ことばはこうである。","tok":[["主ら","しゅから"],["エレミヤ"],["に"],["臨んだ","のぞんだ"],["言葉","ことば"],["は"],["こう"],["で"],["ある"],["。"]]},{"verse":2,"text":"「主,しゅの家,いえの門,もんに立,たち、その所,ところで、この言葉,ことばをのべて言,いえ、主,しゅを拝,おがむために、この門,もんをはいるユダのすべての人,ひとよ、主,しゅの言葉,ことばを聞,きけ。","tok":[["「"],["主","しゅ"],["の"],["家","いえ"],["の"],["門","もん"],["に"],["立ち","たち"],["、"],["その"],["所","ところ"],["で"],["、"],["この"],["言葉","ことば"],["を"],["のべて"],["言え","いえ"],["、"],["主","しゅ"],["を"],["拝む","おがむ"],["ため"],["に"],["、"],["この"],["門","もん"],["を"],["はいる"],["ユダ"],["の"],["すべて"],["の"],["人","ひと"],["よ"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["を"],["聞け","きけ"],["。"]]},{"verse":3,"text":"万軍,ばんぐんの主,しゅ、イスラエルの神,かみはこう言,いわれる、あなたがたの道,みちとあなたがたの行,おこないを改,あらためるならば、わたしはあなたがたをこの所,ところに住,すまわせる。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["、"],["イスラエル"],["の"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["あなた"],["がた"],["の"],["道","みち"],["と"],["あなた"],["がた"],["の"],["行ない","おこない"],["を"],["改めるならば","あらためるならば"],["、"],["わたし"],["は"],["あなた"],["がた"],["を"],["この"],["所","ところ"],["に"],["住まわせる","すまわせる"],["。"]]},{"verse":4,"text":"あなたがたは、『これは主,しゅの神殿,しんでんだ、主,しゅの神殿,しんでんだ、主,しゅの神殿,しんでんだ』という偽,いつわりの言葉,ことばを頼,たのみとしてはならない。","tok":[["あなた"],["がた"],["は"],["、"],["『"],["これ"],["は"],["主","しゅ"],["の"],["神殿","しんでん"],["だ"],["、"],["主","しゅ"],["の"],["神殿","しんでん"],["だ"],["、"],["主","しゅ"],["の"],["神殿","しんでん"],["だ"],["』"],["と"],["いう"],["偽わり","いつわり"],["の"],["言葉","ことば"],["を"],["頼み","たのみ"],["として"],["は"],["ならない"],["。"]]},{"verse":5,"text":"もしあなたがたが、まことに、その道,みちと行,おこないを改,あらためて、互,たがいに公正,こうせいを行,おこない、","tok":[["もし"],["あなた"],["が"],["た"],["が"],["、"],["まこと"],["に"],["、"],["その"],["道","みち"],["と"],["行ない","おこない"],["を"],["改","あらため"],["て"],["、"],["互","たがい"],["に"],["公正","こうせい"],["を"],["行ない","おこない"],["、"]]},{"verse":6,"text":"寄留,きりゅうの他国,たこく人,じんと、みなしごと、やもめをしえたげることなく、罪,つみのない人,ひとの血,ちをこの所,ところに流,ながすことなく、また、ほかの神々,かみがみに従,したがって自,みずから害,がいをまねくことをしないならば、","tok":[["寄留","きりゅう"],["の"],["他国人","たこくじん"],["と"],["、"],["みなしご"],["と"],["、"],["やもめ"],["を"],["し"],["えたげる"],["こと"],["なく"],["、"],["罪","つみ"],["の"],["ない"],["人","ひと"],["の"],["血","ち"],["を"],["この"],["所","ところ"],["に"],["流す","ながす"],["こと"],["なく"],["、"],["また"],["、"],["ほか"],["の"],["神々","かみがみ"],["に"],["従って","したがって"],["自から","みずから"],["害","がい"],["を"],["まねく"],["こと"],["を"],["しないならば"],["、"]]},{"verse":7,"text":"わたしはあなたがたを、わたしが昔,むかしあなたがたの先祖,せんぞに与,あたえたこの地,ちに永遠,えいえんに住,すまわせる。","tok":[["わたし"],["は"],["あなた"],["がた"],["を"],["、"],["わたし"],["が"],["昔","むかし"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["に"],["与えた","あたえた"],["この"],["地","ち"],["に"],["永遠","えいえん"],["に"],["住まわせる","すまわせる"],["。"]]},{"verse":8,"text":"見,みよ、あなたがたは偽,いつわりの言葉,ことばを頼,たのみとしているが、それはむだである。","tok":[["見よ","みよ"],["、"],["あなた"],["がた"],["は"],["偽わり","いつわり"],["の"],["言葉","ことば"],["を"],["頼み","たのみ"],["として"],["いる"],["が"],["、"],["それ"],["は"],["むだ"],["で"],["ある"],["。"]]},{"verse":9,"text":"あなたがたは盗,ぬすみ、殺,ころし、姦淫,かんいんし、偽,いつわって誓,ちかい、バアルに香,こうをたき、あなたがたが以前,いぜんには知,しらなかった他,たの神々,かみがみに従,したがいながら、","tok":[["あなた"],["がた"],["は"],["盗み","ぬすみ"],["、"],["殺ろし","ころし"],["、"],["姦淫","かんいん"],["し"],["、"],["偽わって","いつわって"],["誓い","ちかい"],["、"],["バアル"],["に"],["香","こう"],["を"],["たき"],["、"],["あなた"],["がた"],["が"],["以前","いぜん"],["に"],["は"],["知らなかった","しらなかった"],["他","た"],["の"],["神々","かみがみ"],["に"],["従い","したがい"],["ながら"],["、"]]},{"verse":10,"text":"わたしの名,なをもって、となえられるこの家,いえに来,きてわたしの前,まえに立,たち、『われわれは救,すくわれた』と言,いい、しかもすべてこれら憎,にくむべきことを行,おこなうのは、どうしたことか。","tok":[["わたし"],["の"],["名","な"],["を"],["もって"],["、"],["となえられる"],["この"],["家","いえ"],["に"],["来て","きて"],["わたし"],["の"],["前","まえ"],["に"],["立ち","たち"],["、"],["『"],["われわれ"],["は"],["救われた","すくわれた"],["』"],["と"],["言い","いい"],["、"],["しかも"],["すべて"],["これ"],["ら"],["憎むべき","にくむべき"],["こと"],["を"],["行なう","おこなう"],["の"],["は"],["、"],["どう"],["した"],["こと"],["か"],["。"]]},{"verse":11,"text":"わたしの名,なをもって、となえられるこの家,いえが、あなたがたの目,めには盗賊,とうぞくの巣,すと見,みえるのか。わたし自身,じしん、そう見,みたと主,しゅは言,いわれる。","tok":[["わたし"],["の"],["名","な"],["を"],["もって"],["、"],["となえられる"],["この"],["家","いえ"],["が"],["、"],["あなた"],["がた"],["の"],["目","め"],["に"],["は"],["盗賊","とうぞく"],["の"],["巣","す"],["と"],["見える","みえる"],["の"],["か"],["。"],["わたし"],["自身","じしん"],["、"],["そう"],["見た","みた"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":12,"text":"わたしが初,はじめにわたしの名,なを置,おいた場所,ばしょシロへ行,いき、わが民,たみイスラエルの悪,あくのために、わたしがその場所,ばしょに対,たいして行,おこなったことを見,みよ。","tok":[["わたし"],["が"],["初め","はじめ"],["に"],["わたし"],["の"],["名","な"],["を"],["置いた","おいた"],["場所","ばしょ"],["シロ"],["へ"],["行き","いき"],["、"],["わが"],["民","た"],["みイスラエル"],["の"],["悪","あく"],["の"],["ため"],["に"],["、"],["わたし"],["が"],["その"],["場所","ばしょ"],["に対して","にたいして"],["行なった","おこなった"],["こと"],["を"],["見よ","みよ"],["。"]]},{"verse":13,"text":"主,しゅは言,いわれる、今,いまあなたがたはこれらのすべてのことを行,おこなっている。またわたしはあなたがたに、しきりに語,かたったけれども、あなたがたは聞,きかず、あなたがたを呼,よんだけれども答,こたえなかった。","tok":[["主","しゅ"],["は"],["言われる","いわれる"],["、"],["今","いま"],["あなた"],["がた"],["は"],["これ"],["ら"],["の"],["すべて"],["の"],["こと"],["を"],["行なって","おこなって"],["いる"],["。"],["また"],["わたし"],["は"],["あなた"],["がた"],["に"],["、"],["しきり"],["に"],["語った","かたった"],["けれど"],["も"],["、"],["あなた"],["がた"],["は"],["聞かず","きかず"],["、"],["あなた"],["がた"],["を"],["呼んだ","よんだ"],["けれど"],["も"],["答","こたえ"],["なかった"],["。"]]},{"verse":14,"text":"それゆえわたしはシロに対,たいして行,おこなったように、わたしの名,なをもって、となえられるこの家,いえにも行,おこなう。すなわちあなたがたが頼,たのみとする所,ところ、わたしがあなたがたと、あなたがたの先祖,せんぞに与,あたえたこの所,ところに行,おこなう。","tok":[["それ"],["ゆえ"],["わたし"],["は"],["シロ"],["に対して","にたいして"],["行なった","おこなった"],["よう"],["に"],["、"],["わたし"],["の"],["名","な"],["を"],["もって"],["、"],["となえられる"],["この"],["家","いえ"],["に"],["も"],["行なう","おこなう"],["。"],["すなわち"],["あなた"],["がた"],["が"],["頼み","たのみ"],["と"],["する"],["所","ところ"],["、"],["わたし"],["が"],["あなた"],["がた"],["と"],["、"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["に"],["与えた","あたえた"],["この"],["所","ところ"],["に"],["行なう","おこなう"],["。"]]},{"verse":15,"text":"そしてわたしは、あなたがたのすべての兄弟,きょうだい、すなわちエフライムのすべての子孫,しそんを捨,すてたように、わたしの前,まえからあなたがたをも捨,すてる。","tok":[["そして"],["わたし"],["は"],["、"],["あなた"],["がた"],["の"],["すべて"],["の"],["兄弟","きょうだい"],["、"],["すなわち"],["エフライム"],["の"],["すべて"],["の"],["子孫","しそん"],["を"],["捨てた","すてた"],["よう"],["に"],["、"],["わたし"],["の"],["前","まえ"],["から"],["あなた"],["がた"],["を"],["も"],["捨てる","すてる"],["。"]]},{"verse":16,"text":"あなたはこの民,たみのために祈,いのってはならない。彼,かれらのために嘆,なげき、祈,いのってはならない。またわたしに、とりなしをしてはならない。わたしはあなたの求,もとめを聞,きかない。","tok":[["あなた"],["は"],["この"],["民","たみ"],["の"],["ため"],["に"],["祈って","いのって"],["は"],["ならない"],["。"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["嘆き","なげき"],["、"],["祈って","いのって"],["は"],["ならない"],["。"],["また"],["わたし"],["に"],["、"],["とりなし"],["を"],["して"],["は"],["ならない"],["。"],["わたし"],["は"],["あなた"],["の"],["求め","もとめ"],["を"],["聞かない","きかない"],["。"]]},{"verse":17,"text":"あなたは彼,かれらがユダの町々,まちまちと、エルサレムのちまたでしていることを見,みないのか。","tok":[["あなた"],["は"],["彼","かれ"],["ら"],["が"],["ユダ"],["の"],["町々","まちまち"],["と"],["、"],["エルサレム"],["の"],["ちまた"],["でして"],["いる"],["こと"],["を"],["見ない","みない"],["の"],["か"],["。"]]},{"verse":18,"text":"子,こどもらは、たきぎを集,あつめ、父,ちちたちは火,ひをたき、女,おんなは粉,こなをこね、パンを造,つくってこれを天后,てんこうに供,そなえる。また彼,かれらは他,たの神々,かみがみの前,まえに酒,さけを注,そそいで、わたしを怒,いからせる。","tok":[["子ども","こども"],["ら"],["は"],["、"],["たきぎ"],["を"],["集め","あつめ"],["、"],["父","ちち"],["たち"],["は"],["火","ひ"],["を"],["たき"],["、"],["女","おんな"],["は"],["粉","こな"],["を"],["こね"],["、"],["パン"],["を"],["造って","つくって"],["これ"],["を"],["天后","てんこう"],["に"],["供える","そなえる"],["。"],["また"],["彼","かれ"],["ら"],["は"],["他","た"],["の"],["神々","かみがみ"],["の"],["前","まえ"],["に"],["酒","さけ"],["を"],["注いで","そそいで"],["、"],["わたし"],["を"],["怒らせる","いからせる"],["。"]]},{"verse":19,"text":"主,しゅは言,いわれる、彼,かれらが怒,いからせるのはわたしなのか。自分,じぶんたち自身,じしんではないのか。そして自,みずからうろたえている。","tok":[["主","しゅ"],["は"],["言われる","いわれる"],["、"],["彼","かれ"],["ら"],["が"],["怒らせる","いからせる"],["の"],["は"],["わたし"],["な"],["の"],["か"],["。"],["自分","じぶん"],["たち"],["自身","じしん"],["で"],["は"],["ない"],["の"],["か"],["。"],["そして"],["自から","みずから"],["うろたえて"],["いる"],["。"]]},{"verse":20,"text":"それゆえ主,しゅなる神,かみはこう言,いわれる、見,みよ、わたしの怒,いかりと憤,いきどおりを、この所,ところと、人,ひとと獣,けものと、畑,はたけの木,きと、地,ちの産物,さんぶつとに注,そそぐ。怒,いかりは燃,もえて消,きえることがない」。","tok":[["それ"],["ゆえ"],["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["見よ","みよ"],["、"],["わたし"],["の"],["怒り","いかり"],["と"],["憤り","いきどおり"],["を"],["、"],["この"],["所","ところ"],["と"],["、"],["人","ひと"],["と"],["獣","けもの"],["と"],["、"],["畑","はたけ"],["の"],["木","き"],["と"],["、"],["地","ち"],["の"],["産物","さんぶつ"],["と"],["に"],["注ぐ","そそぐ"],["。"],["怒り","いかり"],["は"],["燃えて","もえて"],["消える","きえる"],["こと"],["が"],["ない"],["」"],["。"]]},{"verse":21,"text":"万軍,ばんぐんの主,しゅ、イスラエルの神,かみはこう言,いわれる、「あなたがたの犠牲,ぎせいに燔祭,はんさいの物,ものを合,あわせて肉,にくを食,たべるがよい。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["、"],["イスラエル"],["の"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["「"],["あなた"],["がた"],["の"],["犠牲","ぎせい"],["に"],["燔祭","はんさい"],["の"],["物","もの"],["を"],["合","あわせ"],["て"],["肉","にく"],["を"],["食べる","たべる"],["が"],["よい"],["。"]]},{"verse":22,"text":"それはあなたがたの先祖,せんぞをエジプトの地,ちから導,みちびき出,だした日,ひに、わたしは燔祭,はんさいと犠牲,ぎせいとについて彼,かれらに語,かたったこともなく、また命,めいじたこともないからである。","tok":[["それ"],["は"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["を"],["エジプト"],["の"],["地","ち"],["から"],["導き出した","みちびきだした"],["日","ひ"],["に"],["、"],["わたし"],["は"],["燔祭","はんさい"],["と"],["犠牲","ぎせい"],["と"],["について"],["彼","かれ"],["ら"],["に"],["語った","かたった"],["こと"],["も"],["なく"],["、"],["また"],["命じた","めいじた"],["こと"],["も"],["ない"],["から"],["で"],["ある"],["。"]]},{"verse":23,"text":"ただわたしはこの戒,いましめを彼,かれらに与,あたえて言,いった、『わたしの声,こえに聞,ききしたがいなさい。そうすれば、わたしはあなたがたの神,かみとなり、あなたがたはわたしの民,たみとなる。わたしがあなたがたに命,めいじるすべての道,みちを歩,あゆんで幸,さいわいを得,えなさい』と。","tok":[["ただ"],["わたし"],["は"],["この"],["戒しめ","いましめ"],["を"],["彼","かれ"],["ら"],["に"],["与","あたえ"],["て"],["言った","いった"],["、"],["『"],["わたし"],["の"],["声","こえ"],["に"],["聞した","ききした"],["が"],["い"],["なさい"],["。"],["そう"],["すれば"],["、"],["わたし"],["は"],["あなた"],["がた"],["の"],["神","かみ"],["と"],["なり"],["、"],["あなた"],["がた"],["は"],["わたし"],["の"],["民","たみ"],["と"],["なる"],["。"],["わたし"],["が"],["あなた"],["がた"],["に"],["命じる","めいじる"],["すべて"],["の"],["道","みち"],["を"],["歩んで","あゆんで"],["幸い","さいわい"],["を"],["得","え"],["なさい"],["』"],["と"],["。"]]},{"verse":24,"text":"しかし彼,かれらは聞,きき従,したがわず、耳,みみを傾,かたむけず、自分,じぶんの悪,わるい心,こころの計,はかりごとと強情,ごうじょうにしたがって歩,あゆみ、悪,わるくなるばかりで、よくはならなかった。","tok":[["しかし"],["彼","かれ"],["ら"],["は"],["聞","きき"],["従わず","したがわず"],["、"],["耳","みみ"],["を"],["傾むけず","かたむけず"],["、"],["自分","じぶん"],["の"],["悪い","わるい"],["心","こころ"],["の"],["計り","はかり"],["ごと"],["と"],["強情","ごうじょう"],["に"],["したがって"],["歩","あゆみ"],["、"],["悪く","わるく"],["なる"],["ばかり"],["で"],["、"],["よく"],["は"],["ならなかった"],["。"]]},{"verse":25,"text":"あなたがたの先祖,せんぞがエジプトの地,ちを出,でた日,ひから今日,こんにちまで、わたしはわたしのしもべである預言者,よげんしゃたちを日々,ひび彼,かれらにつかわした。","tok":[["あなた"],["がた"],["の"],["先祖","せんぞ"],["が"],["エジプト"],["の"],["地","ち"],["を"],["出た","でた"],["日","ひ"],["から"],["今日","こん"],["に"],["ち"],["まで"],["、"],["わたし"],["は"],["わたし"],["の"],["しもべ"],["で"],["ある"],["預言者","よげんしゃ"],["たち"],["を"],["日々","ひび"],["彼","かれ"],["ら"],["に"],["つかわした"],["。"]]},{"verse":26,"text":"しかし彼,かれらはわたしに聞,きかず、耳,みみを傾,かたむけないで強情,ごうじょうになり、先祖,せんぞたちにもまさって悪,あくを行,おこなった。","tok":[["しかし"],["彼","かれ"],["ら"],["は"],["わたし"],["に"],["聞かず","きかず"],["、"],["耳","みみ"],["を"],["傾むけないで","かたむけないで"],["強情","ごうじょう"],["に"],["なり"],["、"],["先祖","せんぞ"],["たち"],["に"],["も"],["まさって"],["悪","あく"],["を"],["行なった","おこなった"],["。"]]},{"verse":27,"text":"たといあなたが彼,かれらにこのすべての言葉,ことばを語,かたっても彼,かれらは聞,きかない。また彼,かれらを呼,よんでもあなたに答,こたえない。","tok":[["たとい"],["あなた"],["が"],["彼","かれ"],["ら"],["に"],["この"],["すべて"],["の"],["言葉","ことば"],["を"],["語って","かたって"],["も"],["彼","かれ"],["ら"],["は"],["聞かない","きかない"],["。"],["また"],["彼","かれ"],["ら"],["を"],["呼","よん"],["で"],["も"],["あなた"],["に"],["答","こたえ"],["ない"],["。"]]},{"verse":28,"text":"それゆえ、あなたはこう彼,かれらに言,いわなければならない、『これはその神,かみ、主,しゅの声,こえに聞,きき従,したがわず、その戒,いましめを受,うけいれなかった国民,こくみんである。真実,しんじつはうせ、彼,かれらの口,くちから絶,たえた。","tok":[["それ"],["ゆえ"],["、"],["あなた"],["は"],["こう"],["彼","かれ"],["ら"],["に"],["言わなければ","いわなければ"],["ならない"],["、"],["『"],["これ"],["は"],["その"],["神","かみ"],["、"],["主","しゅ"],["の"],["声","こえ"],["に"],["聞","きき"],["従わず","したがわず"],["、"],["その"],["戒しめ","いましめ"],["を"],["受","うけ"],["いれなかった"],["国民","こくみん"],["で"],["ある"],["。"],["真実","しんじつ"],["は"],["うせ"],["、"],["彼","かれ"],["ら"],["の"],["口","くち"],["から"],["絶えた","たえた"],["。"]]},{"verse":29,"text":"あなたの髪,かみの毛,けを切,きって捨,すてよ、裸,はだかの山,やまの上,うえに嘆,なげきの声,こえをあげよ。主,しゅが、お怒,いかりになっている世,よの人,ひとを退,しりぞけ捨,すてられたからだ』。","tok":[["あなた"],["の"],["髪の毛","かみのけ"],["を"],["切って","きって"],["捨てよ","すてよ"],["、"],["裸","はだか"],["の"],["山","やま"],["の"],["上","うえ"],["に"],["嘆き","なげき"],["の"],["声","こえ"],["を"],["あげ"],["よ"],["。"],["主","しゅ"],["が"],["、"],["お怒り","おいかり"],["に"],["なって"],["いる"],["世","よ"],["の"],["人","ひと"],["を"],["退ぞけ","しりぞけ"],["捨てられた","すてられた"],["から"],["だ"],["』"],["。"]]},{"verse":30,"text":"主,しゅは言,いわれる、ユダの民,たみはわたしの前,まえに悪,あくを行,おこない、わたしの名,なをもってとなえられる家,いえに、憎,にくむべき者,ものを置,おいてそこを汚,けがした。","tok":[["主","しゅ"],["は"],["言われる","いわれる"],["、"],["ユダ"],["の"],["民","たみ"],["は"],["わたし"],["の"],["前","まえ"],["に"],["悪","あく"],["を"],["行ない","おこない"],["、"],["わたし"],["の"],["名","な"],["を"],["もって"],["となえられる"],["家","いえ"],["に"],["、"],["憎むべき","にくむべき"],["者","もの"],["を"],["置いて","おいて"],["そこ"],["を"],["汚","け"],["がした"],["。"]]},{"verse":31,"text":"またベンヒンノムの谷,たににあるトペテの高,たかき所,ところを築,きずいて、むすこ娘,むすめを火,ひに焼,やいた。わたしはそれを命,めいじたことはなく、またそのようなことを考,かんがえたこともなかった。","tok":[["また"],["ベンヒンノム"],["の"],["谷","たに"],["に"],["ある"],["トペテ"],["の"],["高き","たかき"],["所","ところ"],["を"],["築いて","きずいて"],["、"],["むすこ"],["娘","むすめ"],["を"],["火","ひ"],["に"],["焼いた","やいた"],["。"],["わたし"],["は"],["それ"],["を"],["命じた","めいじた"],["こと"],["は"],["なく"],["、"],["また"],["その"],["よう"],["な"],["こと"],["を"],["考","かんがえ"],["た"],["こと"],["も"],["なかった"],["。"]]},{"verse":32,"text":"主,しゅは言,いわれる、それゆえに見,みよ、その所,ところをトペテ、またはベンヒンノムの谷,たにと呼,よばないで、ほふりの谷,たにと呼,よぶ日,ひが来,くる。それはほかに場所,ばしょがないので、トペテに葬,ほうむるからである。","tok":[["主","しゅ"],["は"],["言われる","いわれる"],["、"],["それ"],["ゆえ"],["に"],["見よ","みよ"],["、"],["その"],["所","ところ"],["を"],["トペテ"],["、"],["また"],["は"],["ベンヒンノム"],["の"],["谷","たに"],["と"],["呼ばないで","よばないで"],["、"],["ほふり"],["の"],["谷","たに"],["と"],["呼ぶ","よぶ"],["日","ひ"],["が"],["来る","くる"],["。"],["それ"],["は"],["ほか"],["に"],["場所","ばしょ"],["が"],["ない"],["ので"],["、"],["トペテ"],["に"],["葬むる","ほうむる"],["から"],["で"],["ある"],["。"]]},{"verse":33,"text":"この民,たみの死体,したいは空,そらの鳥,とりと地,ちの獣,けものの食物,しょくもつとなり、これを追,おい払,はらう者,ものもない。","tok":[["この"],["民","たみ"],["の"],["死体","したい"],["は"],["空","そら"],["の"],["鳥","とり"],["と"],["地","ち"],["の"],["獣","けもの"],["の"],["食物","しょくもつ"],["と"],["なり"],["、"],["これ"],["を"],["追い払う","おいはらう"],["者","もの"],["も"],["ない"],["。"]]},{"verse":34,"text":"そのときわたしはユダの町々,まちまちとエルサレムのちまたに、喜,よろこびの声,こえ、楽,たのしみの声,こえ、花婿,はなむこの声,こえ、花嫁,はなよめの声,こえを絶,たやす。この地,ちは荒,あれ果,はてるからである。","tok":[["その"],["とき"],["わたし"],["は"],["ユダ"],["の"],["町々","まちまち"],["と"],["エルサレム"],["の"],["ちまた"],["に"],["、"],["喜こび","よろこび"],["の"],["声","こえ"],["、"],["楽み","たのしみ"],["の"],["声","こえ"],["、"],["花婿","はなむこ"],["の"],["声","こえ"],["、"],["花嫁","はなよめ"],["の"],["声","こえ"],["を"],["絶やす","たやす"],["。"],["この"],["地","ち"],["は"],["荒れ果てる","あれはてる"],["から"],["で"],["ある"],["。"]]}]
[{"verse":1,"text":"主,しゅの言葉,ことばはまたわたしに臨,のぞんだ、","tok":[["主","しゅ"],["の"],["言葉","ことば"],["は"],["また"],["わたし"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":2,"text":"「あなたはこの所,ところで妻,つまをめとってはならない。またむすこ娘,むすめを持,もってはならない。","tok":[["「"],["あなた"],["は"],["この"],["所","ところ"],["で"],["妻","つま"],["を"],["めとって"],["は"],["ならない"],["。"],["また"],["むすこ"],["娘","むすめ"],["を"],["持って","もって"],["は"],["ならない"],["。"]]},{"verse":3,"text":"この所,ところで生,うまれるむすこ娘,むすめと、この地,ちでこれを産,うむ母,ははたちと、これを生,うむ父,ちちたちとについて主,しゅはこう言,いわれる、","tok":[["この"],["所","ところ"],["で"],["生まれる","うまれる"],["むすこ"],["娘","むすめ"],["と"],["、"],["この"],["地","ち"],["で"],["これ"],["を"],["産む","うむ"],["母","はは"],["たち"],["と"],["、"],["これ"],["を"],["生む","うむ"],["父","ちち"],["たち"],["と"],["について"],["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"]]},{"verse":4,"text":"彼,かれらは死,しの病,やまいにかかって死,しに、哀悼,あいとうする者,ものもなく、埋葬,まいそうする者,ものもなく、地,ちのおもてに、糞土,ふんどのようになる。またつるぎと、ききんに滅,ほろぼされて、その死体,したいは空,そらの鳥,とりと地,ちの獣,けものの食,くい物,ものとなる。","tok":[["彼","かれ"],["ら"],["は"],["死","し"],["の"],["病","やまい"],["に"],["かかって"],["死に","しに"],["、"],["哀悼","あいとう"],["する"],["者","もの"],["も"],["なく"],["、"],["埋葬","まいそう"],["する"],["者","もの"],["も"],["なく"],["、"],["地","ち"],["の"],["おもて"],["に"],["、"],["糞土","ふんど"],["の"],["よう"],["に"],["なる"],["。"],["また"],["つるぎ"],["と"],["、"],["ききん"],["に"],["滅ぼされて","ほろぼされて"],["、"],["その"],["死体","したい"],["は"],["空","そら"],["の"],["鳥","とり"],["と"],["地","ち"],["の"],["獣","けもの"],["の"],["食い物","くいもの"],["と"],["なる"],["。"]]},{"verse":5,"text":"主,しゅはこう言,いわれる、喪,ものある家,いえに、はいってはならない。また行,いって、それを悲,かなしみ嘆,なげいてはならない。わたしがこの民,たみからわたしの平安,へいあんと、いつくしみと、あわれみとを取,とり去,さったからであると、主,しゅは言,いわれる。","tok":[["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["喪","も"],["の"],["ある"],["家","いえ"],["に"],["、"],["はいって"],["は"],["ならない"],["。"],["また"],["行って","いって"],["、"],["それ"],["を"],["悲しみ嘆いて","かなしみなげいて"],["は"],["ならない"],["。"],["わたし"],["が"],["この"],["民","たみ"],["から"],["わたし"],["の"],["平安","へいあん"],["と"],["、"],["いつくしみ"],["と"],["、"],["あわれみ"],["と"],["を"],["取","とり"],["去た","さった"],["から"],["で"],["ある"],["と"],["、"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":6,"text":"大,おおいなる者,ものも小,ちいさき者,ものも、この地,ちに死,しぬ。彼,かれらは葬,ほうむられず、また彼,かれらのために悲,かなしむ者,ものもなく、自分,じぶんの身,みを傷,きずつける者,ものもなく、髪,かみをそる者,ものもない。","tok":[["大いなる","おおいなる"],["者","もの"],["も"],["小い","ちい"],["さき"],["者","もの"],["も"],["、"],["この"],["地","ち"],["に"],["死ぬ","しぬ"],["。"],["彼","かれ"],["ら"],["は"],["葬むられず","ほうむられず"],["、"],["また"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["悲しむ","かなしむ"],["者","もの"],["も"],["なく"],["、"],["自分","じぶん"],["の"],["身","み"],["を"],["傷つける","きずつける"],["者","もの"],["も"],["なく"],["、"],["髪","かみ"],["を"],["そる"],["者","もの"],["も"],["ない"],["。"]]},{"verse":7,"text":"悲,かなしむ者,もののためにパンをさいて、死者,ししゃのためにこれを慰,なぐさめる者,ものはなく、また父,ちちあるいは母,ははのために慰,なぐさめの杯,さかずきをこれに与,あたえて飲,のませる者,ものもない。","tok":[["悲しむ","かなしむ"],["者","もの"],["の"],["ため"],["に"],["パン"],["を"],["さいて"],["、"],["死者","ししゃ"],["の"],["ため"],["に"],["これ"],["を"],["慰さめる","なぐさめる"],["者","もの"],["は"],["なく"],["、"],["また"],["父","ちち"],["あるいは"],["母","はは"],["の"],["ため"],["に"],["慰さめ","なぐさめ"],["の"],["杯","さかずき"],["を"],["これ"],["に"],["与","あたえ"],["て"],["飲ませる","のませる"],["者","もの"],["も"],["ない"],["。"]]},{"verse":8,"text":"またあなたは宴会,えんかいをする家,いえにはいって、人々,ひとびとと共,ともにすわって食,くい飲,のみしてはならない。","tok":[["また"],["あなた"],["は"],["宴会","えんかい"],["を"],["する"],["家","いえ"],["に"],["はいって"],["、"],["人々","ひとびと"],["と"],["共","とも"],["に"],["すわって"],["食い","くい"],["飲み","のみ"],["して"],["は"],["ならない"],["。"]]},{"verse":9,"text":"万軍,ばんぐんの主,しゅ、イスラエルの神,かみはこう言,いわれる、見,みよ、あなたの目,めの前,まえで、あなたのなおこの世,よにいる間,あいだに、わたしは喜,よろこびの声,こえと楽,たのしみの声,こえ、花婿,はなむこの声,こえと花嫁,はなよめの声,こえとをこの所,ところに絶,たやしてしまう。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["、"],["イスラエル"],["の"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["見よ","みよ"],["、"],["あなた"],["の"],["目","め"],["の"],["前","まえ"],["で"],["、"],["あなた"],["の"],["なお"],["この世","このよ"],["に"],["いる"],["間","あいだ"],["に"],["、"],["わたし"],["は"],["喜こび","よろこび"],["の"],["声","こえ"],["と"],["楽み","たのしみ"],["の"],["声","こえ"],["、"],["花婿","はなむこ"],["の"],["声","こえ"],["と"],["花嫁","はなよめ"],["の"],["声","こえ"],["と"],["を"],["この"],["所","ところ"],["に"],["絶やして","たやして"],["しまう"],["。"]]},{"verse":10,"text":"あなたがこのすべての言葉,ことばをこの民,たみに告,つげるとき、彼,かれらがあなたに尋,たずねて、『主,しゅがわれわれにこの大,おおきな災,わざわいを宣告,せんこくされるのはどうしてですか。われわれにどんな悪,わるい所,ところがあるのですか。われわれの神,かみ、主,しゅにそむいて、われわれが犯,おかした罪,つみとはなんですか』と言,いうならば、","tok":[["あなた"],["が"],["この"],["すべて"],["の"],["言葉","ことば"],["を"],["この"],["民","たみ"],["に"],["告げる","つげる"],["とき"],["、"],["彼","かれ"],["ら"],["が"],["あなた"],["に"],["尋ねて","たずねて"],["、"],["『"],["主","しゅ"],["が"],["われわれ"],["に"],["この"],["大きな","おおきな"],["災","わざわい"],["を"],["宣告","せんこく"],["される"],["の"],["は"],["どう"],["して"],["です"],["か"],["。"],["われわれ"],["に"],["どんな"],["悪い","わるい"],["所","ところ"],["が"],["ある"],["の"],["です"],["か"],["。"],["われわれ"],["の"],["神","かみ"],["、"],["主に","しゅに"],["そむいて"],["、"],["われわれ"],["が"],["犯した","おかした"],["罪","つみ"],["と"],["は"],["なん"],["です"],["か"],["』"],["と"],["言うならば","いうならば"],["、"]]},{"verse":11,"text":"あなたは彼,かれらに答,こたえなければならない、『主,しゅは仰,おおせられる、それはあなたがたの先祖,せんぞがわたしを捨,すてて他,たの神々,かみがみに従,したがい、これに仕,つかえ、これを拝,はいし、またわたしを捨,すて、わたしの律法,りっぽうを守,まもらなかったからである。","tok":[["あなた"],["は"],["彼","かれ"],["ら"],["に"],["答","こたえ"],["なければ"],["ならない"],["、"],["『"],["主","しゅ"],["は"],["仰せられる","おおせられる"],["、"],["それ"],["は"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["が"],["わたし"],["を"],["捨てて","すてて"],["他","た"],["の"],["神々","かみがみ"],["に"],["従い","したがい"],["、"],["これ"],["に"],["仕え","つかえ"],["、"],["これ"],["を"],["拝し","はいし"],["、"],["また"],["わたし"],["を"],["捨て","すて"],["、"],["わたし"],["の"],["律法","りっぽう"],["を"],["守らなかった","まもらなかった"],["から"],["で"],["ある"],["。"]]},{"verse":12,"text":"あなたがたは、あなたがたの先祖,せんぞよりも、いっそう悪,わるいことをした。見,みよ、あなたがたはおのおの自分,じぶんの悪,わるい強情,ごうじょうな心,こころに従,したがい、わたしに聞,きき従,したがうことはしない。","tok":[["あなた"],["がた"],["は"],["、"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["より"],["も"],["、"],["いっそう"],["悪い","わるい"],["こと"],["を"],["した"],["。"],["見よ","みよ"],["、"],["あなた"],["がた"],["は"],["おのおの"],["自分","じぶん"],["の"],["悪い","わるい"],["強情","ごうじょう"],["な"],["心","こころ"],["に"],["従い","したがい"],["、"],["わたし"],["に"],["聞","きき"],["従う","したがう"],["こと"],["は"],["しない"],["。"]]},{"verse":13,"text":"それゆえ、わたしはあなたがたをこの地,ちより追,おい出,だし、あなたがたも、あなたがたの先祖,せんぞも知,しらない地,ちに行,いかせる。その所,ところであなたがたは昼夜,ちゅうや、ほかの神々,かみがみに仕,つかえるようになる。これはわたしがあなたがたにあわれみを示,しめさないからである』と。","tok":[["それ"],["ゆえ"],["、"],["わたし"],["は"],["あなた"],["がた"],["を"],["この"],["地","ち"],["より"],["追い出し","おいだし"],["、"],["あなた"],["がた"],["も"],["、"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["も"],["知らない","しらない"],["地","ち"],["に"],["行かせる","いかせる"],["。"],["その"],["所","ところ"],["で"],["あなた"],["がた"],["は"],["昼夜","ちゅうや"],["、"],["ほか"],["の"],["神々","かみがみ"],["に"],["仕える","つかえる"],["よう"],["に"],["なる"],["。"],["これ"],["は"],["わたし"],["が"],["あなた"],["がた"],["に"],["あわれみ"],["を"],["示めさない","しめさない"],["から"],["で"],["ある"],["』"],["と"],["。"]]},{"verse":14,"text":"主,しゅは言,いわれる、それゆえ、見,みよ、こののち『イスラエルの民,たみをエジプトの地,ちから導,みちびき出,だした主,しゅは生,いきておられる』とは言,いわないで、","tok":[["主","しゅ"],["は"],["言われる","いわれる"],["、"],["それ"],["ゆえ"],["、"],["見よ","みよ"],["、"],["この"],["のち"],["『"],["イスラエル"],["の"],["民","たみ"],["を"],["エジプト"],["の"],["地","ち"],["から"],["導き出した","みちびきだした"],["主","しゅ"],["は"],["生きて","いきて"],["おられる"],["』"],["と"],["は"],["言わないで","いわないで"],["、"]]},{"verse":15,"text":"『イスラエルの民,たみを北,きたの国,くにと、そのすべて追,おいやられた国々,くにぐにから導,みちびき出,だした主,しゅは生,いきておられる』という日,ひがくる。わたしが彼,かれらを、その先祖,せんぞに与,あたえた彼,かれらの地,ちに導,みちびきかえすからである。","tok":[["『"],["イスラエル"],["の"],["民","たみ"],["を"],["北","きた"],["の"],["国","くに"],["と"],["、"],["その"],["すべて"],["追いやられた","おいやられた"],["国々","くにぐに"],["から"],["導き出した","みちびきだした"],["主","しゅ"],["は"],["生きて","いきて"],["おられる"],["』"],["と"],["いう"],["日","ひ"],["が"],["くる"],["。"],["わたし"],["が"],["彼","かれ"],["ら"],["を"],["、"],["その"],["先祖","せんぞ"],["に"],["与","あたえ"],["た"],["彼","かれ"],["ら"],["の"],["地","ち"],["に"],["導き","みちびき"],["かえす"],["から"],["で"],["ある"],["。"]]},{"verse":16,"text":"主,しゅは言,いわれる、見,みよ、わたしは多,おおくの漁夫,ぎょふを呼,よんできて、彼,かれらをすなどらせ、また、そののち多,おおくの猟師,りょうしを呼,よんできて、もろもろの山,やま、もろもろの丘,おか、および岩,いわの裂,さけ目,めから彼,かれらをかり出,ださせる。","tok":[["主","しゅ"],["は"],["言われる","いわれる"],["、"],["見よ","みよ"],["、"],["わたし"],["は"],["多く","おおく"],["の"],["漁夫","ぎょふ"],["を"],["呼んで","よんで"],["きて"],["、"],["彼","かれ"],["ら"],["を"],["すなどらせ"],["、"],["また"],["、"],["その"],["のち"],["多く","おおく"],["の"],["猟師","りょうし"],["を"],["呼んで","よんで"],["きて"],["、"],["もろもろ"],["の"],["山","やま"],["、"],["もろもろ"],["の"],["丘","おか"],["、"],["および"],["岩","いわ"],["の"],["裂け目","さけめ"],["から"],["彼","かれ"],["ら"],["を"],["かり出させる","かりださせる"],["。"]]},{"verse":17,"text":"わたしの目,めは彼,かれらのすべての道,みちを見,みているからである。みなわたしに隠,かくれてはいない。またその悪,あくはわたしの目,めに隠,かくれることはない。","tok":[["わたし"],["の"],["目","め"],["は"],["彼","かれ"],["ら"],["の"],["すべて"],["の"],["道","みち"],["を"],["見て","みて"],["いる"],["から"],["で"],["ある"],["。"],["みな"],["わたし"],["に"],["隠れて","かくれて"],["は"],["いない"],["。"],["また"],["その"],["悪","あく"],["は"],["わたし"],["の"],["目","め"],["に"],["隠れる","かくれる"],["こと"],["は"],["ない"],["。"]]},{"verse":18,"text":"わたしはその悪,あくとその罪,つみの報,むくいを二倍,ばいにする。彼,かれらがその忌,いむべき偶像,ぐうぞうの死体,したいをもって、わたしの地,ちを汚,けがし、その憎,にくむべきものをもって、わたしの嗣,し業,ぎょうを満,みたしたからである」。","tok":[["わたし"],["は"],["その"],["悪","あく"],["と"],["その"],["罪","つみ"],["の"],["報い","むくい"],["を"],["二","に"],["倍","ばい"],["に"],["する"],["。"],["彼","かれ"],["ら"],["が"],["その"],["忌むべき","いむべき"],["偶像","ぐうぞう"],["の"],["死体","したい"],["を"],["もって"],["、"],["わたし"],["の"],["地","ち"],["を"],["汚","け"],["がし"],["、"],["その"],["憎むべき","にくむべき"],["もの"],["を"],["もって"],["、"],["わたし"],["の"],["嗣業","しぎょう"],["を"],["満たした","みたした"],["から"],["で"],["ある"],["」"],["。"]]},{"verse":19,"text":"主,しゅ、わが力,ちから、わが城,しろ、悩,なやみの時,ときの、のがれ場,ばよ、万国,ばんこくの民,たみは地,ちの果,はてからあなたのもとにきて申,もうします、「われわれの先祖,せんぞが受,うけ嗣,ついだのは、ただ偽,いつわりと、役,やくに立,たたないつまらない事,ことばかりです。","tok":[["主","しゅ"],["、"],["わが"],["力","ちから"],["、"],["わが"],["城","しろ"],["、"],["悩み","なやみ"],["の"],["時","とき"],["の"],["、"],["の"],["がれ場","がれば"],["よ"],["、"],["万国","ばんこく"],["の"],["民","たみ"],["は"],["地","ち"],["の"],["果て","はて"],["から"],["あなた"],["の"],["もと"],["に"],["きて"],["申します","もうします"],["、"],["「"],["われわれ"],["の"],["先祖","せんぞ"],["が"],["受け嗣いだ","うけついだ"],["の"],["は"],["、"],["ただ"],["偽り","いつわり"],["と"],["、"],["役","やく"],["に"],["立たない","たたない"],["つまらない"],["事","こと"],["ばかり"],["です"],["。"]]},{"verse":20,"text":"人,ひとが自分,じぶんで神々,かみがみを造,つくることができましょうか。そういうものは神,かみではありません」。","tok":[["人","ひと"],["が"],["自分","じぶん"],["で"],["神々","かみがみ"],["を"],["造る","つくる"],["こと"],["が"],["できましょう"],["か"],["。"],["そう"],["いう"],["もの"],["は"],["神","かみ"],["で"],["は"],["ありません"],["」"],["。"]]},{"verse":21,"text":"「それゆえ、見,みよ、わたしは彼,かれらに知,しらせよう。すなわち、この際,さいわたしの力,ちからと、わたしの勢,いきおいとを知,しらせよう。彼,かれらはわたしの名,なが、主,しゅであることを知,しるようになる」。","tok":[["「"],["それ"],["ゆえ"],["、"],["見よ","みよ"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["に"],["知らせよう","しらせよう"],["。"],["すなわち"],["、"],["この"],["際","さい"],["わたし"],["の"],["力","ちから"],["と"],["、"],["わたし"],["の"],["勢","いきおい"],["と"],["を"],["知らせよう","しらせよう"],["。"],["彼","かれ"],["ら"],["は"],["わたし"],["の"],["名","な"],["が"],["、"],["主","しゅ"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["」"],["。"]]}]
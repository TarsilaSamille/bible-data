[{"verse":1,"text":"七月,がつのころ、王,おう家,いえのもので、エリシャマの子,こネタニヤの子,こであり、また王,おうの高官,こうかんのひとりであるイシマエルは、王,おうの十人,にんのつかさたちと共,ともにミヅパにいたアヒカムの子,こゲダリヤのもとにきて、ミヅパで食,しょくを共,ともにしたが、","tok":[["七","なな"],["月","がつ"],["の"],["ころ"],["、"],["王家","おういえ"],["の"],["もの"],["で"],["、"],["エリシャマ"],["の"],["子","こ"],["ネタニヤ"],["の"],["子","こ"],["で"],["あり"],["、"],["また"],["王","おう"],["の"],["高官","こうかん"],["の"],["ひとり"],["で"],["ある"],["イシマエル"],["は"],["、"],["王","おう"],["の"],["十人","にん"],["の"],["つかさ"],["たち"],["と"],["共","とも"],["に"],["ミヅパ"],["に"],["いた"],["アヒカム"],["の"],["子","こ"],["ゲダリヤ"],["の"],["もと"],["に"],["きて"],["、"],["ミヅパ"],["で"],["食","しょく"],["を"],["共","とも"],["に"],["した"],["が"],["、"]]},{"verse":2,"text":"ネタニヤの子,こイシマエルおよび共,ともにいた十人,にんの者,ものは立,たち上,あがって、バビロンの王,おうがこの地,ちの総督,そうとくとしたシャパンの子,こアヒカムの子,こであるゲダリヤを刀,かたなで殺,ころし、","tok":[["ネタニヤ"],["の"],["子","こ"],["イシマエル"],["および"],["共","とも"],["に"],["いた"],["十人","にん"],["の"],["者","もの"],["は"],["立ち上がって","たちあがって"],["、"],["バビロン"],["の"],["王","おう"],["が"],["この"],["地","ち"],["の"],["総督","そうとく"],["と"],["した"],["シャパン"],["の"],["子","こ"],["アヒカム"],["の"],["子","こ"],["で"],["ある"],["ゲダリヤ"],["を"],["刀","かたな"],["で"],["殺ろし","ころし"],["、"]]},{"verse":3,"text":"イシマエルはまたミヅパでゲダリヤと共,ともにいたすべてのユダヤ人,ひとと、たまたまそこにいたカルデヤびとの兵士,へいしたちを殺,ころした。","tok":[["イシマエル"],["は"],["また"],["ミヅパ"],["で"],["ゲダリヤ"],["と"],["共","とも"],["に"],["いた"],["すべて"],["の"],["ユダヤ人","ゆだやひと"],["と"],["、"],["たまたま"],["そこ"],["に"],["いた"],["カルデヤ"],["びと"],["の"],["兵士","へいし"],["たち"],["を"],["殺ろした","ころした"],["。"]]},{"verse":4,"text":"ゲダリヤが殺,ころされた次,つぎの日,ひ、まだだれもその事,ことを知,しらないうちに、","tok":[["ゲダリヤ"],["が"],["殺ろされた","ころされた"],["次","つぎ"],["の"],["日","ひ"],["、"],["まだ"],["だれ"],["も"],["その"],["事","こと"],["を"],["知らない","しらない"],["うち"],["に"],["、"]]},{"verse":5,"text":"八十人,にんの人々,ひとびとがそのひげをそり、衣服,いふくをさき、身,みに傷,きずをつけ、手,てには素祭,そさいのささげ物,ものと香,こうを携,たずさえ、シケム、シロ、サマリヤからきて、主,しゅの宮,みやにささげようとした。","tok":[["八","はち"],["十人","じゅうにん"],["の"],["人々","ひとびと"],["が"],["その"],["ひげ"],["を"],["そり"],["、"],["衣服","いふく"],["を"],["さき"],["、"],["身","み"],["に"],["傷","きず"],["を"],["つけ"],["、"],["手","て"],["に"],["は"],["素","す"],["祭","まつり"],["の"],["ささげ物","ささげもの"],["と"],["香","こう"],["を"],["携え","たずさえ"],["、"],["シケム"],["、"],["シロ"],["、"],["サマリヤ"],["から"],["きて"],["、"],["主","しゅ"],["の"],["宮","みや"],["に"],["ささげよう"],["と"],["した"],["。"]]},{"verse":6,"text":"ネタニヤの子,こイシマエルはミヅパから泣,なきながら出,でてきて彼,かれらを迎,むかえ、彼,かれらに会,あって、「アヒカムの子,こゲダリヤのもとにおいでなさい」と言,いった。","tok":[["ネタニヤ"],["の"],["子","こ"],["イシマエル"],["は"],["ミヅパ"],["から"],["泣","なき"],["ながら"],["出て","でて"],["きて"],["彼","かれ"],["ら"],["を"],["迎","むかえ"],["、"],["彼","かれ"],["ら"],["に"],["会って","あって"],["、"],["「"],["アヒカム"],["の"],["子","こ"],["ゲダリヤ"],["の"],["もと"],["に"],["おいで"],["なさい"],["」"],["と"],["言った","いった"],["。"]]},{"verse":7,"text":"そして彼,かれらが町,まちの中,なかにはいったとき、ネタニヤの子,こイシマエルは自分,じぶんと一緒,いっしょにいた人々,ひとびとと共,ともに彼,かれらを殺,ころして、その死体,したいを穴,あなに投,なげ入,いれた。","tok":[["そして"],["彼","かれ"],["ら"],["が"],["町","まち"],["の"],["中","なか"],["に"],["はいった"],["とき"],["、"],["ネタニヤ"],["の"],["子","こ"],["イシマエル"],["は"],["自分","じぶん"],["と"],["一緒","いっしょ"],["に"],["いた"],["人々","ひとびと"],["と"],["共","とも"],["に"],["彼","かれ"],["ら"],["を"],["殺ろして","ころして"],["、"],["その"],["死体","したい"],["を"],["穴","あな"],["に"],["投入れた","なげいれた"],["。"]]},{"verse":8,"text":"しかしそのうちの十人,にんはイシマエルに向,むかい、「わたしたちは畑,はたけに小麦,こむぎ、大麦,おおむぎ、油,あぶら、および蜜,みつを隠,かくしています、わたしたちを殺,ころさないでください」と言,いったので、彼,かれらをその仲間,なかまと共,ともに殺,ころさないでしまった。","tok":[["しかし"],["その"],["うち"],["の"],["十人","にん"],["は"],["イシマエル"],["に"],["向","むかい"],["、"],["「"],["わたしたち"],["は"],["畑","はたけ"],["に"],["小麦","こむぎ"],["、"],["大麦","おおむぎ"],["、"],["油","あぶら"],["、"],["および"],["蜜","みつ"],["を"],["隠して","かくして"],["います"],["、"],["わたしたち"],["を"],["殺ろさないで","ころさないで"],["ください"],["」"],["と"],["言った","いった"],["ので"],["、"],["彼","かれ"],["ら"],["を"],["その"],["仲間","なかま"],["と"],["共","とも"],["に"],["殺ろさないで","ころさないで"],["しまった"],["。"]]},{"verse":9,"text":"イシマエルが自分,じぶんの殺,ころした人々,ひとびとの死体,したいを投,なげ入,いれた穴,あなは、アサ王,おうがイスラエルの王,おうバアシャを恐,おそれて掘,ほった穴,あなであった。ネタニヤの子,こイシマエルは殺,ころした人々,ひとびとをこれに満,みたした。","tok":[["イシマエル"],["が"],["自分","じぶん"],["の"],["殺ろした","ころした"],["人々","ひとびと"],["の"],["死体","したい"],["を"],["投入れた","なげいれた"],["穴","あな"],["は"],["、"],["アサ"],["王","おう"],["が"],["イスラエル"],["の"],["王","おう"],["バアシャ"],["を"],["恐れて","おそれて"],["掘った","ほった"],["穴","あな"],["で"],["あった"],["。"],["ネタニヤ"],["の"],["子","こ"],["イシマエル"],["は"],["殺ろした","ころした"],["人々","ひとびと"],["を"],["これ"],["に"],["満たした","みたした"],["。"]]},{"verse":10,"text":"次,ついでイシマエルはミヅパに残,のこっているすべての民,たみ、すなわち王,おうの娘,むすめたちと侍衛,じえいの長,ちょうネブザラダンがアヒカムの子,こゲダリヤに託,たくしたミヅパに残,のこっているすべての民,たみとを捕虜,ほりょとした。ネタニヤの子,こイシマエルは彼,かれらを捕虜,ほりょとし、アンモンびとのもとに渡,わたり行,いこうとして立,たち去,さった。","tok":[["次いで","ついで"],["イシマエル"],["は"],["ミヅパ"],["に"],["残って","のこって"],["いる"],["すべて"],["の"],["民","たみ"],["、"],["すなわち"],["王","おう"],["の"],["娘","むすめ"],["たち"],["と"],["侍衛","じえい"],["の"],["長う","ちょう"],["ネブザラダン"],["が"],["アヒカム"],["の"],["子","こ"],["ゲダリヤ"],["に"],["託した","たくした"],["ミヅパ"],["に"],["残って","のこって"],["いる"],["すべて"],["の"],["民","たみ"],["と"],["を"],["捕虜","ほりょ"],["と"],["した"],["。"],["ネタニヤ"],["の"],["子","こ"],["イシマエル"],["は"],["彼","かれ"],["ら"],["を"],["捕虜","ほりょ"],["と"],["し"],["、"],["アンモン"],["びと"],["の"],["もと"],["に"],["渡り","わたり"],["行こう","いこう"],["として"],["立ち","たち"],["去た","さった"],["。"]]},{"verse":11,"text":"カレヤの子,こヨハナンおよび彼,かれと共,ともにいる軍勢,ぐんぜいの長,ちょうたちはネタニヤの子,こイシマエルの行,いった悪事,あくじをみな聞,きき、","tok":[["カレヤ"],["の"],["子","こ"],["ヨハナン"],["および"],["彼","かれ"],["と"],["共","とも"],["に"],["いる"],["軍勢","ぐんぜい"],["の"],["長","ちょう"],["たち"],["は"],["ネタニヤ"],["の"],["子","こ"],["イシマエル"],["の"],["行った","いった"],["悪事","あくじ"],["を"],["みな聞","みなきき"],["、"]]},{"verse":12,"text":"その兵士,へいしたちを率,ひきいて、ネタニヤの子,こイシマエルと戦,たたかうために出,でて行,いき、ギベオンの大池,おおいけのほとりで彼,かれに会,あった。","tok":[["その"],["兵士","へいし"],["たち"],["を"],["率いて","ひきいて"],["、"],["ネタニヤ"],["の"],["子","こ"],["イシマエル"],["と"],["戦う","たたかう"],["ため"],["に"],["出て","でて"],["行き","いき"],["、"],["ギベオン"],["の"],["大池","おおいけ"],["の"],["ほとり"],["で"],["彼","かれ"],["に"],["会った","あった"],["。"]]},{"verse":13,"text":"イシマエルと共,ともにいる人々,ひとびとは、カレヤの子,こヨハナンおよび彼,かれと共,ともにいる軍勢,ぐんぜいの長,ちょうたちを見,みて喜,よろこんだ。","tok":[["イシマエル"],["と"],["共","とも"],["に"],["いる"],["人々","ひとびと"],["は"],["、"],["カレヤ"],["の"],["子","こ"],["ヨハナン"],["および"],["彼","かれ"],["と"],["共","とも"],["に"],["いる"],["軍勢","ぐんぜい"],["の"],["長","ちょう"],["たち"],["を"],["見て","みて"],["喜こんだ","よろこんだ"],["。"]]},{"verse":14,"text":"そしてイシマエルがミヅパから捕虜,ほりょにしてきた人々,ひとびとは身,みをめぐらしてカレヤの子,こヨハナンのもとへ行,いった。","tok":[["そして"],["イシマエル"],["が"],["ミヅパ"],["から"],["捕虜","ほりょ"],["に"],["して"],["きた"],["人々","ひとびと"],["は"],["身","み"],["を"],["めぐらして"],["カレヤ"],["の"],["子","こ"],["ヨハナン"],["の"],["もと"],["へ"],["行った","いった"],["。"]]},{"verse":15,"text":"ネタニヤの子,こイシマエルは八人,にんの者,ものと共,ともにヨハナンを避,さけて逃,にげ、アンモンびとの所,ところへ行,いった。","tok":[["ネタニヤ"],["の"],["子","こ"],["イシマエル"],["は"],["八人","にん"],["の"],["者","もの"],["と"],["共","とも"],["に"],["ヨハナン"],["を"],["避けて","さけて"],["逃","にげ"],["、"],["アンモン"],["びと"],["の"],["所","ところ"],["へ"],["行った","いった"],["。"]]},{"verse":16,"text":"そこでカレヤの子,こヨハナンおよび彼,かれと共,ともにいる軍勢,ぐんぜいの長,ちょうたちはネタニヤの子,こイシマエルがアヒカムの子,こゲダリヤを殺,ころして、ミヅパから捕虜,ほりょとして連,つれてきた、あの残,のこっていた民,たみ、すなわち兵士,へいしや女,おんな、子供,こども、宦官,かんがんをギベオンから連,つれ帰,かえったが、","tok":[["そこ"],["で"],["カレヤ"],["の"],["子","こ"],["ヨハナン"],["および"],["彼","かれ"],["と"],["共","とも"],["に"],["いる"],["軍勢","ぐんぜい"],["の"],["長","ちょう"],["たち"],["は"],["ネタニヤ"],["の"],["子","こ"],["イシマエル"],["が"],["アヒカム"],["の"],["子","こ"],["ゲダリヤ"],["を"],["殺ろして","ころして"],["、"],["ミヅパ"],["から"],["捕虜","ほりょ"],["として"],["連れて","つれて"],["きた"],["、"],["あの"],["残って","のこって"],["いた"],["民","たみ"],["、"],["すなわち"],["兵士","へいし"],["や"],["女","おんな"],["、"],["子供","こども"],["、"],["宦官","かんがん"],["を"],["ギベオン"],["から"],["連れ","つれ"],["帰えった","かえった"],["が"],["、"]]},{"verse":17,"text":"彼,かれらはエジプトへ行,いこうとしてベツレヘムの近,ちかくにあるゲルテ・キムハムへ行,いって、そこにとどまった。","tok":[["彼","かれ"],["ら"],["は"],["エジプト"],["へ"],["行こう","いこう"],["として"],["ベツレヘム"],["の"],["近く","ちかく"],["に"],["ある"],["ゲルテ"],["・"],["キムハム"],["へ"],["行って","いって"],["、"],["そこ"],["に"],["とどまった"],["。"]]},{"verse":18,"text":"これは、ネタニヤの子,こイシマエルが、バビロンの王,おうによってこの地,ちの総督,そうとくに任,にんじられたアヒカムの子,こゲダリヤを殺,ころしたことにより、カルデヤびとを恐,おそれたからである。","tok":[["これ"],["は"],["、"],["ネタニヤ"],["の"],["子","こ"],["イシマエル"],["が"],["、"],["バビロン"],["の"],["王","おう"],["によって"],["この"],["地","ち"],["の"],["総督","そうとく"],["に"],["任じられた","にんじられた"],["アヒカム"],["の"],["子","こ"],["ゲダリヤ"],["を"],["殺ろした","ころした"],["こと"],["に"],["より"],["、"],["カルデヤ"],["びと"],["を"],["恐","おそれ"],["たから"],["で"],["ある"],["。"]]}]
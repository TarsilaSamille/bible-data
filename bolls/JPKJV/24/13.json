[{"verse":1,"text":"主,しゅはわたしにこう言,いわれた、「行,いって、亜麻,あま布,ぬのの帯,おびを買,かい、腰,こしに結,むすべ。水,みずにつけてはならない」。","tok":[["主","しゅ"],["は"],["わたし"],["に"],["こう"],["言われた","いわれた"],["、"],["「"],["行って","いって"],["、"],["亜","あ"],["麻布","麻ぬの"],["の"],["帯","おび"],["を"],["買","かい"],["、"],["腰","こし"],["に"],["結べ","むすべ"],["。"],["水","みず"],["に"],["つけて"],["は"],["ならない"],["」"],["。"]]},{"verse":2,"text":"そこで、わたしは主,しゅの言葉,ことばに従,したがい、帯,おびを買,かって腰,こしに結,むすんだ。","tok":[["そこ"],["で"],["、"],["わたし"],["は"],["主","しゅ"],["の"],["言葉","ことば"],["に"],["従い","したがい"],["、"],["帯","おび"],["を"],["買って","かって"],["腰","こし"],["に"],["結んだ","むすんだ"],["。"]]},{"verse":3,"text":"主,しゅの言葉,ことばは、再,ふたたびわたしに臨,のぞんで言,いった、","tok":[["主","しゅ"],["の"],["言葉","ことば"],["は"],["、"],["再び","ふたたび"],["わたし"],["に"],["臨んで","のぞんで"],["言った","いった"],["、"]]},{"verse":4,"text":"「あなたが買,かって腰,こしに結,むすんでいる帯,おびを手,てに取,とり、立,たってユフラテの川,かわへ行,いき、その所,ところの岩,いわの裂,さけ目,めにこれを隠,かくせ」。","tok":[["「"],["あなた"],["が"],["買って","かって"],["腰","こし"],["に"],["結んで","むすんで"],["いる"],["帯","おび"],["を"],["手","て"],["に"],["取","とり"],["、"],["立って","たって"],["ユフラテ"],["の"],["川","かわ"],["へ"],["行き","いき"],["、"],["その"],["所","ところ"],["の"],["岩","いわ"],["の"],["裂け目","さけめ"],["に"],["これ"],["を"],["隠せ","かくせ"],["」"],["。"]]},{"verse":5,"text":"わたしは主,しゅが命,めいじられたように、行,いって、これをユフラテの川,かわのほとりに隠,かくした。","tok":[["わたし"],["は"],["主","しゅ"],["が"],["命じられた","めいじられた"],["よう"],["に"],["、"],["行って","いって"],["、"],["これ"],["を"],["ユフラテ"],["の"],["川","かわ"],["の"],["ほとり"],["に"],["隠した","かくした"],["。"]]},{"verse":6,"text":"多,おおくの日,ひを経,へてのち、主,しゅはわたしに言,いわれた、「立,たって、ユフラテの川,かわへ行,いき、あなたに命,めいじて、そこに隠,かくさせた帯,おびをその所,ところから取,とってきなさい」。","tok":[["多く","おおく"],["の"],["日","ひ"],["を"],["経て","へて"],["のち"],["、"],["主","しゅ"],["は"],["わたし"],["に"],["言われた","いわれた"],["、"],["「"],["立って","たって"],["、"],["ユフラテ"],["の"],["川","かわ"],["へ"],["行き","いき"],["、"],["あなた"],["に"],["命じて","めいじて"],["、"],["そこ"],["に"],["隠させた","かくさせた"],["帯","おび"],["を"],["その"],["所","ところ"],["から"],["取って","とって"],["き"],["なさい"],["」"],["。"]]},{"verse":7,"text":"そこでわたしはユフラテの川,かわへ行,いき、地,ちを掘,ほって、隠,かくした所,ところから帯,おびを取,とり出,だしたが、その帯,おびはそこなわれて、役,やくに立,たたなくなっていた。","tok":[["そこ"],["で"],["わたし"],["は"],["ユフラテ"],["の"],["川","かわ"],["へ"],["行き","いき"],["、"],["地","ち"],["を"],["掘って","ほって"],["、"],["隠した","かくした"],["所","ところ"],["から"],["帯","おび"],["を"],["取出した","とりだした"],["が"],["、"],["その"],["帯","おび"],["は"],["そこなわれて"],["、"],["役","やく"],["に"],["立たなく","たたなく"],["なって"],["いた"],["。"]]},{"verse":8,"text":"その時,とき、主,しゅの言葉,ことばがわたしに臨,のぞんだ、","tok":[["その"],["時","とき"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":9,"text":"「主,しゅはこう仰,おおせられる、これと同,おなじように、わたしはユダの高,たかぶりとエルサレムの大,おおいなる高,たかぶりを、破,やぶるのである。","tok":[["「"],["主","しゅ"],["は"],["こう"],["仰せられる","おおせられる"],["、"],["これ"],["と"],["同じ","おなじ"],["よう"],["に"],["、"],["わたし"],["は"],["ユダ"],["の"],["高ぶり","たかぶり"],["と"],["エルサレム"],["の"],["大いなる","おおいなる"],["高ぶり","たかぶり"],["を"],["、"],["破る","やぶる"],["ので"],["ある"],["。"]]},{"verse":10,"text":"この悪,あしき民,たみはわたしの言葉,ことばを聞,きくことを拒,こばみ、自分,じぶんの心,こころを強情,ごうじょうにして歩,あゆみ、また他,たの神々,かみがみに従,したがってこれに仕,つかえ、これを拝,おがんでいる。彼,かれらはこの帯,おびのように、なんの役,やくにも立,たたなくなる」。","tok":[["この"],["悪しき","あしき"],["民","たみ"],["は"],["わたし"],["の"],["言葉","ことば"],["を"],["聞く","きく"],["こと"],["を"],["拒み","こばみ"],["、"],["自分","じぶん"],["の"],["心","こころ"],["を"],["強情","ごうじょう"],["に"],["して"],["歩","あゆみ"],["、"],["また"],["他","た"],["の"],["神々","かみがみ"],["に"],["従って","したがって"],["これ"],["に"],["仕え","つかえ"],["、"],["これ"],["を"],["拝んで","おがんで"],["いる"],["。"],["彼","かれ"],["ら"],["は"],["この"],["帯","おび"],["の"],["よう"],["に"],["、"],["なん"],["の"],["役","やく"],["に"],["も"],["立たなく","たたなく"],["なる"],["」"],["。"]]},{"verse":11,"text":"主,しゅは言,いわれる、「帯,おびが人,ひとの腰,こしに着,つくように、イスラエルのすべての家,いえとユダのすべての家,いえとをわたしに着,つかせ、これをわたしの民,たみとし、名,なとし、誉,ほまれとし、栄,さかえとしようとした。しかし彼,かれらは聞,きき従,したがおうともしなかった」。","tok":[["主","しゅ"],["は"],["言われる","いわれる"],["、"],["「"],["帯","おび"],["が"],["人","ひと"],["の"],["腰","こし"],["に"],["着く","つく"],["よう"],["に"],["、"],["イスラエル"],["の"],["すべて"],["の"],["家","いえ"],["と"],["ユダ"],["の"],["すべて"],["の"],["家","いえ"],["と"],["を"],["わたし"],["に"],["着かせ","つかせ"],["、"],["これ"],["を"],["わたし"],["の"],["民","たみ"],["と"],["し"],["、"],["名","な"],["と"],["し"],["、"],["誉","ほまれ"],["と"],["し"],["、"],["栄","さかえ"],["と"],["しよう"],["と"],["した"],["。"],["しかし"],["彼","かれ"],["ら"],["は"],["聞","きき"],["従おう","したがおう"],["と"],["も"],["しなかった"],["」"],["。"]]},{"verse":12,"text":"「あなたはこの言葉,ことばを彼,かれらに語,かたらなければならない、『イスラエルの神,かみはこう言,いわれる、酒,さけつぼには、みな酒,さけが満,みちる』と。彼,かれらはあなたに言,いうであろう、『酒,さけつぼに、みな酒,さけが満,みちることをわれわれが知,しらないことがあろうか』と。","tok":[["「"],["あなた"],["は"],["この"],["言葉","ことば"],["を"],["彼","かれ"],["ら"],["に"],["語らなければ","かたらなければ"],["ならない"],["、"],["『"],["イスラエル"],["の"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["酒つぼ","さけつぼ"],["に"],["は"],["、"],["みな"],["酒","さけ"],["が"],["満ちる","みちる"],["』"],["と"],["。"],["彼","かれ"],["ら"],["は"],["あなた"],["に"],["言うで","いうで"],["あろう"],["、"],["『"],["酒つぼ","さけつぼ"],["に"],["、"],["みな"],["酒","さけ"],["が"],["満ちる","みちる"],["こと"],["を"],["われわれ"],["が"],["知らない","しらない"],["こと"],["が"],["あろう"],["か"],["』"],["と"],["。"]]},{"verse":13,"text":"その時,とき、あなたは彼,かれらに言,いわなければならない、『主,しゅはこう言,いわれる、見,みよ、わたしはこの地,ちに住,すむすべての者,ものと、ダビデの位,くらいに座,ざす王,おうたちと、祭司,さいしと預言者,よげんしゃおよびエルサレムに住,すむすべての者,ものに酔,よいを満,みたし、","tok":[["その"],["時","とき"],["、"],["あなた"],["は"],["彼","かれ"],["ら"],["に"],["言わなければ","いわなければ"],["ならない"],["、"],["『"],["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["見よ","みよ"],["、"],["わたし"],["は"],["この"],["地","ち"],["に"],["住む","すむ"],["すべて"],["の"],["者","もの"],["と"],["、"],["ダビデ"],["の"],["位","くらい"],["に"],["座す","ざす"],["王","おう"],["たち"],["と"],["、"],["祭司","さいし"],["と"],["預言者","よげんしゃ"],["および"],["エルサレム"],["に"],["住む","すむ"],["すべて"],["の"],["者","もの"],["に"],["酔","よい"],["を"],["満たし","みたし"],["、"]]},{"verse":14,"text":"彼,かれらを互,たがいに打,うち当,あてて砕,くだく。父,ちちと子,こをもそのようにすると、主,しゅは言,いわれる。わたしは彼,かれらをあわれまず、惜,おしまず、かわいそうとも思,おもわずに滅,ほろぼす』と」。","tok":[["彼","かれ"],["ら"],["を"],["互","たがい"],["に"],["打ち当てて","うちあてて"],["砕く","くだく"],["。"],["父","ちち"],["と"],["子","こ"],["を"],["も"],["その"],["よう"],["に"],["する"],["と"],["、"],["主","しゅ"],["は"],["言われる","いわれる"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["あわれまず"],["、"],["惜まず","おしまず"],["、"],["かわいそう"],["と"],["も"],["思わず","おもわず"],["に"],["滅ぼす","ほろぼす"],["』"],["と"],["」"],["。"]]},{"verse":15,"text":"耳,みみを傾,かたむけて聞,きけ、高,たかぶってはならない、主,しゅがお語,かたりになるからである。","tok":[["耳","みみ"],["を"],["傾むけて","かたむけて"],["聞け","きけ"],["、"],["高か","たか"],["ぶっ"],["て"],["は"],["ならない"],["、"],["主","しゅ"],["が"],["お語り","おかたり"],["に"],["なる"],["から"],["で"],["ある"],["。"]]},{"verse":16,"text":"主,しゅがまだやみを起,おこされないうちに、またあなたがたの足,あしが薄暗,うすくらがりの山,やまにつまずかないうちに、あなたがたの神,かみ、主,しゅに栄光,えいこうを帰,かえせよ。さもないと、あなたがたが光,ひかりを望,のぞんでいる間,あいだに、主,しゅはそれを暗黒,あんこくに変,かえ、それを暗,くらやみとされるからである。","tok":[["主","しゅ"],["が"],["まだ"],["やみ"],["を"],["起こされない","おこされない"],["うち"],["に"],["、"],["また"],["あなた"],["がた"],["の"],["足","あし"],["が"],["薄","うす"],["暗がり","くらがり"],["の"],["山","やま"],["に"],["つまずかない"],["うち"],["に"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主に","しゅに"],["栄光","えいこう"],["を"],["帰せ","かえせ"],["よ"],["。"],["さも"],["ない"],["と"],["、"],["あなた"],["がた"],["が"],["光","ひかり"],["を"],["望んで","のぞんで"],["いる"],["間","あいだ"],["に"],["、"],["主","しゅ"],["は"],["それ"],["を"],["暗黒","あんこく"],["に"],["変え","かえ"],["、"],["それ"],["を"],["暗やみ","くらやみ"],["と"],["される"],["から"],["で"],["ある"],["。"]]},{"verse":17,"text":"もしあなたがたが聞,きかないならば、わたしの魂,たましいはひそかな所,ところで、あなたがたの高,たかぶりのために悲,かなしむ。また主,しゅの群,むれが、かすめられたために、わたしの目,めはいたく泣,ないて、涙,なみだを流,ながすのである。","tok":[["もし"],["あなた"],["がた"],["が"],["聞かないならば","きかないならば"],["、"],["わたし"],["の"],["魂","たましい"],["は"],["ひそか"],["な"],["所","ところ"],["で"],["、"],["あなた"],["がた"],["の"],["高ぶり","たかぶり"],["の"],["ため"],["に"],["悲しむ","かなしむ"],["。"],["また"],["主","しゅ"],["の"],["群れ","むれ"],["が"],["、"],["かすめられた"],["ため"],["に"],["、"],["わたし"],["の"],["目","め"],["は"],["いたく"],["泣いて","ないて"],["、"],["涙","なみだ"],["を"],["流す","ながす"],["ので"],["ある"],["。"]]},{"verse":18,"text":"王,おうと太后,たいこうとに告,つげよ、「あなたがたは低,ひくい座,ざにすわりなさい。麗,うるわしい冠,かんむりはすでにあなたがたの頭,あたまから落,おちてしまったからです」。","tok":[["王","おう"],["と"],["太后","たいこうと"],["に"],["告","つげ"],["よ"],["、"],["「"],["あなた"],["がた"],["は"],["低い","ひくい"],["座","ざ"],["に"],["すわり"],["なさい"],["。"],["麗わしい","うるわしい"],["冠","かんむり"],["は"],["すでに"],["あなた"],["がた"],["の"],["頭","あたま"],["から"],["落","おち"],["て"],["しまった"],["から"],["です"],["」"],["。"]]},{"verse":19,"text":"ネゲブの町々,まちまちは閉,とざされて、これを開,ひらく人,ひとがない。ユダはみな捕,とらえ移,うつされる、ことごとく捕,とらえ移,うつされる。","tok":[["ネゲブ"],["の"],["町々","まちまち"],["は"],["閉ざされて","とざされて"],["、"],["これ"],["を"],["開らく","ひらく"],["人","ひと"],["が"],["ない"],["。"],["ユダ"],["は"],["みな"],["捕らえ","とらえ"],["移される","うつされる"],["、"],["ことごとく"],["捕らえ","とらえ"],["移される","うつされる"],["。"]]},{"verse":20,"text":"「目,めをあげて、北,きたの方,ほうからくる者,ものを見,みよ、あなたに賜,たまわった群,むれ、あなたの麗,うるわしい群,むれはどこにいるのか。","tok":[["「"],["目","め"],["を"],["あげて"],["、"],["北","きた"],["の"],["方","ほう"],["から"],["くる"],["者","もの"],["を"],["見よ","みよ"],["、"],["あなた"],["に"],["賜わった","たまわった"],["群れ","むれ"],["、"],["あなた"],["の"],["麗わしい","うるわしい"],["群れ","むれ"],["は"],["どこ"],["に"],["いる"],["の"],["か"],["。"]]},{"verse":21,"text":"彼,かれらがあなたの親,したしみ慣,なれた人,ひとたちを、あなたの上,うえに立,たててかしらとするとき、あなたは何,なにを言,いおうとするのか。あなたの苦,くるしみは、子,こを産,うむ女,おんなの苦,くるしみのようでないであろうか。","tok":[["彼","かれ"],["ら"],["が"],["あなた"],["の"],["親しみ","したしみ"],["慣れた","なれた"],["人","ひと"],["たち"],["を"],["、"],["あなた"],["の"],["上","うえ"],["に"],["立てて","たてて"],["かしら"],["と"],["する"],["とき"],["、"],["あなた"],["は"],["何に","なに"],["を"],["言おう","いおう"],["と"],["する"],["の"],["か"],["。"],["あなた"],["の"],["苦しみ","くるしみ"],["は"],["、"],["子","こ"],["を"],["産む","うむ"],["女","おんな"],["の"],["苦しみ","くるしみ"],["の"],["よう"],["で"],["ないで"],["あろう"],["か"],["。"]]},{"verse":22,"text":"あなたが心,こころのうちに、『どうしてこのようなことがわたしに起,たったのか』というならば、あなたの罪,つみが重,おもいゆえに、あなたの着物,きもののすそはあげられ、はずかしめを受,うけるのだ。","tok":[["あなた"],["が"],["心","こころ"],["の"],["うち"],["に"],["、"],["『"],["どう"],["して"],["この"],["よう"],["な"],["こと"],["が"],["わたし"],["に"],["起","たった"],["の"],["か"],["』"],["と"],["いうならば"],["、"],["あなた"],["の"],["罪","つみ"],["が"],["重い","おもい"],["ゆえ"],["に"],["、"],["あなた"],["の"],["着物","きもの"],["の"],["すそ"],["は"],["あげられ"],["、"],["はずかしめ"],["を"],["受る","うける"],["の"],["だ"],["。"]]},{"verse":23,"text":"エチオピヤびとはその皮膚,ひふを変,かえることができようか。ひょうはその斑点,はんてんを変,かえることができようか。もしそれができるならば、悪,あくに慣,なれたあなたがたも、善,ぜんを行,おこなうことができる。","tok":[["エチオピヤ"],["びと"],["は"],["その"],["皮膚","ひふ"],["を"],["変える","かえる"],["こと"],["が"],["できよう"],["か"],["。"],["ひょう"],["は"],["その"],["斑点","はんてん"],["を"],["変える","かえる"],["こと"],["が"],["できよう"],["か"],["。"],["もし"],["それ"],["が"],["できるならば"],["、"],["悪","あく"],["に"],["慣れた","なれた"],["あなた"],["がた"],["も"],["、"],["善","ぜん"],["を"],["行なう","おこなう"],["こと"],["が"],["できる"],["。"]]},{"verse":24,"text":"わたしはあなたがたを散,ちらし、野,のの風,かぜに吹,ふき散,ちらされるもみがらのようにする。","tok":[["わたし"],["は"],["あなた"],["がた"],["を"],["散らし","ちらし"],["、"],["野","の"],["の"],["風","かぜ"],["に"],["吹","ふき"],["散らされる","ちらされる"],["もみがら"],["の"],["よう"],["に"],["する"],["。"]]},{"verse":25,"text":"主,しゅは言,いわれる、これがあなたに授,さづけられた定,さだめ、わたしが量,はかってあなたに与,あたえる分,ぶんである。あなたがわたしを忘,わすれて、偽,いつわりを頼,たのみとしたからだ。","tok":[["主","しゅ"],["は"],["言われる","いわれる"],["、"],["これ"],["が"],["あなた"],["に"],["授","さ"],["づけられた"],["定め","さだめ"],["、"],["わたし"],["が"],["量って","はかって"],["あなた"],["に"],["与える","あたえる"],["分","ぶん"],["で"],["ある"],["。"],["あなた"],["が"],["わたし"],["を"],["忘て","わすれて"],["、"],["偽り","いつわり"],["を"],["頼み","たのみ"],["と"],["した"],["から"],["だ"],["。"]]},{"verse":26,"text":"わたしはまたあなたの着物,きもののすそを顔,かおまであげて、あなたの恥,はじをあらわす。","tok":[["わたし"],["は"],["また"],["あなた"],["の"],["着物","きもの"],["の"],["すそ"],["を"],["顔","かお"],["まで"],["あげて"],["、"],["あなた"],["の"],["恥","はじ"],["を"],["あらわす"],["。"]]},{"verse":27,"text":"わたしはあなたの憎,にくむべき行,おこない、あなたの姦淫,かんいんと、いななき、野,のの丘,おかの上,うえで行,いったあなたのみだらな行,おこないを見,みた。エルサレムよ、あなたはわざわいだ、あなたの清,きよめられるのはいつのことであろうか」。","tok":[["わたし"],["は"],["あなた"],["の"],["憎むべき","にくむべき"],["行ない","おこない"],["、"],["あなた"],["の"],["姦淫","かんいん"],["と"],["、"],["いななき"],["、"],["野","の"],["の"],["丘","おか"],["の"],["上","うえ"],["で"],["行った","いった"],["あなた"],["の"],["みだら"],["な"],["行ない","おこない"],["を"],["見た","みた"],["。"],["エルサレム"],["よ"],["、"],["あなた"],["は"],["わざわい"],["だ"],["、"],["あなた"],["の"],["清められる","きよめられる"],["の"],["は"],["いつ"],["の"],["こと"],["で"],["あろう"],["か"],["」"],["。"]]}]
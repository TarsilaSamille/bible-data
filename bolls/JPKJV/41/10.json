[{"verse":1,"text":"それから、イエスはそこを去,さって、ユダヤの地方,ちほうとヨルダンの向,むこう側,がわへ行,いかれたが、群衆,ぐんしゅうがまた寄,より集,あつまったので、いつものように、また教,おしえておられた。","tok":[["それ"],["から"],["、"],["イエス"],["は"],["そこ"],["を"],["去て","さって"],["、"],["ユダヤ"],["の"],["地方","ちほう"],["と"],["ヨルダン"],["の"],["向こう側","むこうがわ"],["へ"],["行かれた","いかれた"],["が"],["、"],["群衆","ぐんしゅう"],["が"],["また"],["寄り集まった","よりあつまった"],["ので"],["、"],["いつも"],["の"],["よう"],["に"],["、"],["また"],["教えて","おしえて"],["おられた"],["。"]]},{"verse":2,"text":"そのとき、パリサイ人,びとたちが近,ちかづいてきて、イエスを試,こころみようとして質問,しつもんした、「夫,おっとはその妻,つまを出,だしても差,さしつかえないでしょうか」。","tok":[["その"],["とき"],["、"],["パリサイ"],["人","びと"],["たち"],["が"],["近づいて","ちかづいて"],["きて"],["、"],["イエス"],["を"],["試みよう","こころみよう"],["として"],["質問","しつもん"],["した"],["、"],["「"],["夫","おっと"],["は"],["その"],["妻","つま"],["を"],["出して","だして"],["も"],["差しつかえないでしょう","さしつかえないでしょう"],["か"],["」"],["。"]]},{"verse":3,"text":"イエスは答,こたえて言,いわれた、「モーセはあなたがたになんと命,めいじたか」。","tok":[["イエス"],["は"],["答","こたえ"],["て"],["言われた","いわれた"],["、"],["「"],["モーセ"],["は"],["あなた"],["がた"],["に"],["なん"],["と"],["命じた","めいじた"],["か"],["」"],["。"]]},{"verse":4,"text":"彼,かれらは言,いった、「モーセは、離縁,りえん状,じょうを書,かいて妻,つまを出,だすことを許,ゆるしました」。","tok":[["彼","かれ"],["ら"],["は"],["言った","いった"],["、"],["「"],["モーセ"],["は"],["、"],["離縁状","りえんじょう"],["を"],["書いて","かいて"],["妻","つま"],["を"],["出す","だす"],["こと"],["を"],["許しました","ゆるしました"],["」"],["。"]]},{"verse":5,"text":"そこでイエスは言,いわれた、「モーセはあなたがたの心,こころが、かたくななので、あなたがたのためにこの定,さだめを書,かいたのである。","tok":[["そこ"],["で"],["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["モーセ"],["は"],["あなた"],["がた"],["の"],["心","こころ"],["が"],["、"],["かたくな"],["な"],["ので"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["この"],["定め","さだめ"],["を"],["書いた","かいた"],["ので"],["ある"],["。"]]},{"verse":6,"text":"しかし、天地,てんち創造,そうぞうの初,はじめから、『神,かみは人,ひとを男,おとこと女,おんなとに造,つくられた。","tok":[["しかし"],["、"],["天地","てんち"],["創造","そうぞう"],["の"],["初め","はじめ"],["から"],["、"],["『"],["神","かみ"],["は"],["人","ひと"],["を"],["男","おとこ"],["と"],["女","おんな"],["と"],["に"],["造られた","つくられた"],["。"]]},{"verse":7,"text":"それゆえに、人,ひとはその父母,ふぼを離,はなれ、","tok":[["それ"],["ゆえ"],["に"],["、"],["人","ひと"],["は"],["その"],["父母","ふぼ"],["を"],["離れ","はなれ"],["、"]]},{"verse":8,"text":"ふたりの者,ものは一体,いったいとなるべきである』。彼,かれらはもはや、ふたりではなく一体,いったいである。","tok":[["ふたり"],["の"],["者","もの"],["は"],["一体","いったい"],["と"],["なるべきで"],["ある"],["』"],["。"],["彼","かれ"],["ら"],["は"],["もはや"],["、"],["ふたり"],["で"],["は"],["なく"],["一","いち"],["体","たい"],["で"],["ある"],["。"]]},{"verse":9,"text":"だから、神,かみが合,あわせられたものを、人,ひとは離,はなしてはならない」。","tok":[["だ"],["から"],["、"],["神","かみ"],["が"],["合","あわせ"],["られた"],["もの"],["を"],["、"],["人","ひと"],["は"],["離して","はなして"],["は"],["ならない"],["」"],["。"]]},{"verse":10,"text":"家,いえにはいってから、弟子,でしたちはまたこのことについて尋,たずねた。","tok":[["家","いえ"],["に"],["はいって"],["から"],["、"],["弟子","でし"],["たち"],["は"],["また"],["この"],["こと"],["について"],["尋ねた","たずねた"],["。"]]},{"verse":11,"text":"そこで、イエスは言,いわれた、「だれでも、自分,じぶんの妻,つまを出,だして他,たの女,おんなをめとる者,ものは、その妻,つまに対,たいして姦淫,かんいんを行,おこなうのである。","tok":[["そこ"],["で"],["、"],["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["だれ"],["で"],["も"],["、"],["自分","じぶん"],["の"],["妻","つま"],["を"],["出して","だして"],["他","た"],["の"],["女","おんな"],["を"],["めとる"],["者","もの"],["は"],["、"],["その"],["妻","つま"],["に対して","にたいして"],["姦淫","かんいん"],["を"],["行なう","おこなう"],["ので"],["ある"],["。"]]},{"verse":12,"text":"また妻,つまが、その夫,おっとと別,わかれて他,たの男,おとこにとつぐならば、姦淫,かんいんを行,おこなうのである」。","tok":[["また"],["妻","つま"],["が"],["、"],["その"],["夫","おっと"],["と"],["別かれて","わかれて"],["他","た"],["の"],["男","おとこ"],["に"],["とつぐならば"],["、"],["姦淫","かんいん"],["を"],["行なう","おこなう"],["ので"],["ある"],["」"],["。"]]},{"verse":13,"text":"イエスにさわっていただくために、人々,ひとびとが幼,おさな子,ごらをみもとに連,つれてきた。ところが、弟子,でしたちは彼,かれらをたしなめた。","tok":[["イエス"],["に"],["さわって"],["いただく"],["ため"],["に"],["、"],["人々","ひとびと"],["が"],["幼な子","おさなご"],["ら"],["を"],["みもと"],["に"],["連れて","つれて"],["きた"],["。"],["ところ"],["が"],["、"],["弟子","でし"],["たち"],["は"],["彼","かれ"],["ら"],["を"],["たしなめた"],["。"]]},{"verse":14,"text":"それを見,みてイエスは憤,いきどおり、彼,かれらに言,いわれた、「幼,おさな子,ごらをわたしの所,ところに来,くるままにしておきなさい。止,とめてはならない。神,かみの国,くにはこのような者,ものの国,くにである。","tok":[["それ"],["を"],["見て","みて"],["イエス"],["は"],["憤り","いきどおり"],["、"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["幼な子","おさなご"],["ら"],["を"],["わたし"],["の"],["所","ところ"],["に"],["来る","くる"],["まま"],["に"],["して"],["おき"],["なさい"],["。"],["止","とめ"],["ては"],["ならない"],["。"],["神","かみ"],["の"],["国","くに"],["は"],["この"],["よう"],["な"],["者","もの"],["の"],["国","くに"],["で"],["ある"],["。"]]},{"verse":15,"text":"よく聞,きいておくがよい。だれでも幼,おさな子,ごのように神,かみの国,くにを受,うけいれる者,ものでなければ、そこにはいることは決,けっしてできない」。","tok":[["よく"],["聞いて","きいて"],["おく"],["が"],["よい"],["。"],["だれ"],["で"],["も"],["幼な子","おさなご"],["の"],["よう"],["に"],["神","かみ"],["の"],["国","くに"],["を"],["受","うけ"],["いれる"],["者","もの"],["で"],["なければ"],["、"],["そこ"],["に"],["はいる"],["こと"],["は"],["決っして","けっして"],["できない"],["」"],["。"]]},{"verse":16,"text":"そして彼,かれらを抱,いだき、手,てをその上,うえにおいて祝福,しゅくふくされた。","tok":[["そして"],["彼","かれ"],["ら"],["を"],["抱き","いだき"],["、"],["手","て"],["を"],["その"],["上","うえ"],["に"],["おいて"],["祝福","しゅくふく"],["された"],["。"]]},{"verse":17,"text":"イエスが道,みちに出,でて行,いかれると、ひとりの人,ひとが走,はしり寄,より、みまえにひざまずいて尋,たずねた、「よき師,しよ、永遠,えいえんの生命,せいめいを受,うけるために、何,なにをしたらよいでしょうか」。","tok":[["イエス"],["が"],["道","みち"],["に"],["出て","でて"],["行かれる","いかれる"],["と"],["、"],["ひとり"],["の"],["人","ひと"],["が"],["走り寄り","はしりより"],["、"],["みまえ"],["に"],["ひざまずいて"],["尋ねた","たずねた"],["、"],["「"],["よき"],["師","し"],["よ"],["、"],["永遠","えいえん"],["の"],["生命","せいめい"],["を"],["受る","うける"],["ため"],["に"],["、"],["何に","なに"],["を"],["したら"],["よいでしょう"],["か"],["」"],["。"]]},{"verse":18,"text":"イエスは言,いわれた、「なぜわたしをよき者,ものと言,いうのか。神,かみひとりのほかによい者,ものはいない。","tok":[["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["なぜ"],["わたし"],["を"],["よき"],["者","もの"],["と"],["言う","いう"],["の"],["か"],["。"],["神","かみ"],["ひとり"],["の"],["ほか"],["に"],["よい"],["者","もの"],["は"],["いない"],["。"]]},{"verse":19,"text":"いましめはあなたの知,しっているとおりである。『殺,ころすな、姦淫,かんいんするな、盗,ぬすむな、偽証,ぎしょうを立,たてるな。欺,あざむき取,とるな。父,ちちと母,ははとを敬,うやまえ』」。","tok":[["いましめ"],["は"],["あなた"],["の"],["知って","しって"],["いる"],["とおり"],["で"],["ある"],["。"],["『"],["殺ろす","ころす"],["な"],["、"],["姦淫","かんいん"],["する"],["な"],["、"],["盗む","ぬすむ"],["な"],["、"],["偽証","ぎしょう"],["を"],["立る","たてる"],["な"],["。"],["欺き","あざむき"],["取る","とる"],["な"],["。"],["父","ちち"],["と"],["母","はは"],["と"],["を"],["敬え","うやまえ"],["』"],["」"],["。"]]},{"verse":20,"text":"すると、彼,かれは言,いった、「先生,せんせい、それらの事,ことはみな、小,ちいさい時,ときから守,まもっております」。","tok":[["する"],["と"],["、"],["彼","かれ"],["は"],["言った","いった"],["、"],["「"],["先生","せんせい"],["、"],["それ"],["ら"],["の"],["事","こと"],["は"],["みな"],["、"],["小さい","ちいさい"],["時","とき"],["から"],["守って","まもって"],["おります"],["」"],["。"]]},{"verse":21,"text":"イエスは彼,かれに目,めをとめ、いつくしんで言,いわれた、「あなたに足,たりないことが一つある。帰,かえって、持,もっているものをみな売,うり払,はらって、貧,まずしい人々,ひとびとに施,ほどこしなさい。そうすれば、天,てんに宝,たからを持,もつようになろう。そして、わたしに従,したがってきなさい」。","tok":[["イエス"],["は"],["彼","かれ"],["に"],["目","め"],["を"],["とめ"],["、"],["いつくしんで"],["言われた","いわれた"],["、"],["「"],["あなた"],["に"],["足りない","たりない"],["こと"],["が"],["一","ひと"],["つ"],["ある"],["。"],["帰えって","かえって"],["、"],["持て","もって"],["いる"],["もの"],["を"],["みな"],["売払って","うりはらって"],["、"],["貧しい","まずしい"],["人々","ひとびと"],["に"],["施し","ほどこし"],["なさい"],["。"],["そう"],["すれば"],["、"],["天","てん"],["に"],["宝","たから"],["を"],["持つ","もつ"],["よう"],["に"],["なろう"],["。"],["そして"],["、"],["わたし"],["に"],["従って","したがって"],["き"],["なさい"],["」"],["。"]]},{"verse":22,"text":"すると、彼,かれはこの言葉,ことばを聞,きいて、顔,かおを曇,くもらせ、悲,かなしみながら立,たち去,さった。たくさんの資産,しさんを持,もっていたからである。","tok":[["する"],["と"],["、"],["彼","かれ"],["は"],["この"],["言葉","ことば"],["を"],["聞いて","きいて"],["、"],["顔","かお"],["を"],["曇らせ","くもらせ"],["、"],["悲しみ","かなしみ"],["ながら"],["立ち","たち"],["去た","さった"],["。"],["たくさん"],["の"],["資産","しさん"],["を"],["持って","もって"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":23,"text":"それから、イエスは見,みまわして、弟子,でしたちに言,いわれた、「財産,ざいさんのある者,ものが神,かみの国,くににはいるのは、なんとむずかしいことであろう」。","tok":[["それ"],["から"],["、"],["イエス"],["は"],["見まわして","みまわして"],["、"],["弟子","でし"],["たち"],["に"],["言われた","いわれた"],["、"],["「"],["財産","ざいさん"],["の"],["ある"],["者","もの"],["が"],["神","かみ"],["の"],["国","くに"],["に"],["は"],["いる"],["の"],["は"],["、"],["なん"],["と"],["むずかしい"],["こと"],["で"],["あろう"],["」"],["。"]]},{"verse":24,"text":"弟子,でしたちはこの言葉,ことばに驚,おどろき怪,あやしんだ。イエスは更,さらに言,いわれた、「子,こたちよ、神,かみの国,くににはいるのは、なんとむずかしいことであろう。","tok":[["弟子","でし"],["たち"],["は"],["この"],["言葉","ことば"],["に"],["驚","おどろき"],["怪しんだ","あやしんだ"],["。"],["イエス"],["は"],["更に","さらに"],["言われた","いわれた"],["、"],["「"],["子","こ"],["たち"],["よ"],["、"],["神","かみ"],["の"],["国","くに"],["に"],["は"],["いる"],["の"],["は"],["、"],["なん"],["と"],["むずかしい"],["こと"],["で"],["あろう"],["。"]]},{"verse":25,"text":"富,とんでいる者,ものが神,かみの国,くににはいるよりは、らくだが針,はりの穴,あなを通,とおる方,ほうが、もっとやさしい」。","tok":[["富","とん"],["で"],["いる"],["者","もの"],["が"],["神","かみ"],["の"],["国","くに"],["に"],["は"],["いる"],["より"],["は"],["、"],["らくだ"],["が"],["針","はり"],["の"],["穴","あな"],["を"],["通る","とおる"],["方","ほう"],["が"],["、"],["もっと"],["やさしい"],["」"],["。"]]},{"verse":26,"text":"すると彼,かれらはますます驚,おどろいて、互,たがいに言,いった、「それでは、だれが救,すくわれることができるのだろう」。","tok":[["する"],["と"],["彼","かれ"],["ら"],["は"],["ますます"],["驚ろいて","おどろいて"],["、"],["互","たがい"],["に"],["言った","いった"],["、"],["「"],["それ"],["で"],["は"],["、"],["だれ"],["が"],["救われる","すくわれる"],["こと"],["が"],["できる"],["の"],["だろう"],["」"],["。"]]},{"verse":27,"text":"イエスは彼,かれらを見,みつめて言,いわれた、「人,ひとにはできないが、神,かみにはできる。神,かみはなんでもできるからである」。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["を"],["見つめて","みつめて"],["言われた","いわれた"],["、"],["「"],["人","ひと"],["に"],["は"],["できない"],["が"],["、"],["神","かみ"],["に"],["は"],["できる"],["。"],["神","かみ"],["は"],["なん"],["で"],["も"],["できる"],["から"],["で"],["ある"],["」"],["。"]]},{"verse":28,"text":"ペテロがイエスに言,いい出,だした、「ごらんなさい、わたしたちはいっさいを捨,すてて、あなたに従,したがって参,まいりました」。","tok":[["ペテロ"],["が"],["イエス"],["に"],["言い","いい"],["出した","だした"],["、"],["「"],["ごらん"],["なさい"],["、"],["わたしたち"],["は"],["いっさい"],["を"],["捨てて","すてて"],["、"],["あなた"],["に"],["従って","したがって"],["参りました","まいりました"],["」"],["。"]]},{"verse":29,"text":"イエスは言,いわれた、「よく聞,きいておくがよい。だれでもわたしのために、また福音,ふくいんのために、家,いえ、兄弟,きょうだい、姉妹,しまい、母,はは、父,ちち、子,こ、もしくは畑,はたけを捨,すてた者,ものは、","tok":[["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["よく"],["聞いて","きいて"],["おく"],["が"],["よい"],["。"],["だれ"],["で"],["も"],["わたし"],["の"],["ため"],["に"],["、"],["また"],["福音","ふくいん"],["の"],["ため"],["に"],["、"],["家","いえ"],["、"],["兄弟","きょうだい"],["、"],["姉妹","しまい"],["、"],["母","はは"],["、"],["父","ちち"],["、"],["子","こ"],["、"],["もしくは"],["畑","はたけ"],["を"],["捨てた","すてた"],["者","もの"],["は"],["、"]]},{"verse":30,"text":"必,かならずその百倍,ばいを受,うける。すなわち、今,いまこの時代,じだいでは家,いえ、兄弟,きょうだい、姉妹,しまい、母,はは、子,こおよび畑,はたけを迫害,はくがいと共,ともに受,うけ、また、きたるべき世,よでは永遠,えいえんの生命,せいめいを受,うける。","tok":[["必","かならず"],["その"],["百","ひゃく"],["倍","ばい"],["を"],["受る","うける"],["。"],["すなわち"],["、"],["今","いま"],["この"],["時代","じだい"],["で"],["は"],["家","いえ"],["、"],["兄弟","きょうだい"],["、"],["姉妹","しまい"],["、"],["母","はは"],["、"],["子","こ"],["および"],["畑","はたけ"],["を"],["迫害","はくがい"],["と"],["共","とも"],["に"],["受け","うけ"],["、"],["また"],["、"],["きたるべき"],["世","よ"],["で"],["は"],["永遠","えいえん"],["の"],["生命","せいめい"],["を"],["受る","うける"],["。"]]},{"verse":31,"text":"しかし、多,おおくの先,さきの者,ものはあとになり、あとの者,ものは先,さきになるであろう」。","tok":[["しかし"],["、"],["多く","おおく"],["の"],["先","さき"],["の"],["者","もの"],["は"],["あと"],["に"],["なり"],["、"],["あと"],["の"],["者","もの"],["は"],["先","さき"],["に"],["なるで"],["あろう"],["」"],["。"]]},{"verse":32,"text":"さて、一同,いちどうはエルサレムへ上,のぼる途上,とじょうにあったが、イエスが先頭,せんとうに立,たって行,いかれたので、彼,かれらは驚,おどろき怪,あやしみ、従,したがう者,ものたちは恐,おそれた。するとイエスはまた十二弟子,でしを呼,よび寄,よせて、自分,じぶんの身,みに起,おころうとすることについて語,かたりはじめられた、","tok":[["さて"],["、"],["一同","いちどう"],["は"],["エルサレム"],["へ"],["上る","のぼる"],["途上","とじょう"],["に"],["あった"],["が"],["、"],["イエス"],["が"],["先頭","せんとう"],["に"],["立って","たって"],["行かれた","いかれた"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["驚","おどろき"],["怪しみ","あやしみ"],["、"],["従う","したがう"],["者","もの"],["たち"],["は"],["恐れた","おそれた"],["。"],["する"],["と"],["イエス"],["は"],["また"],["十二","じゅうに"],["弟子","でし"],["を"],["呼び寄せて","よびよせて"],["、"],["自分","じぶん"],["の"],["身","み"],["に"],["起ころう","おころう"],["と"],["する"],["こと"],["について"],["語り","かたり"],["はじめられた"],["、"]]},{"verse":33,"text":"「見,みよ、わたしたちはエルサレムへ上,のぼって行,いくが、人,ひとの子,こは祭司長,さいしちょう、律法,りっぽう学者,がくしゃたちの手,てに引,ひきわたされる。そして彼,かれらは死刑,しけいを宣告,せんこくした上,うえ、彼,かれを異邦人,いほうじんに引,ひきわたすであろう。","tok":[["「"],["見よ","みよ"],["、"],["わたしたち"],["は"],["エルサレム"],["へ"],["上って","のぼって"],["行く","いく"],["が"],["、"],["人","ひと"],["の"],["子","こ"],["は"],["祭司長","さいしちょう"],["、"],["律法学者","りっぽうがくしゃ"],["たち"],["の"],["手","て"],["に"],["引","ひき"],["わたされる"],["。"],["そして"],["彼","かれ"],["ら"],["は"],["死刑","しけい"],["を"],["宣告","せんこく"],["した"],["上","うえ"],["、"],["彼","かれ"],["を"],["異邦人","いほうじん"],["に"],["引","ひき"],["わたすで"],["あろう"],["。"]]},{"verse":34,"text":"また彼,かれをあざけり、つばきをかけ、むち打,うち、ついに殺,ころしてしまう。そして彼,かれは三日,かの後,のちによみがえるであろう」。","tok":[["また"],["彼","かれ"],["を"],["あざけり"],["、"],["つばき"],["を"],["かけ"],["、"],["むち打ち","むちうち"],["、"],["ついに"],["殺ろして","ころして"],["しまう"],["。"],["そして"],["彼","かれ"],["は"],["三日","か"],["の"],["後","のち"],["に"],["よみがえるで"],["あろう"],["」"],["。"]]},{"verse":35,"text":"さて、ゼベダイの子,このヤコブとヨハネとがイエスのもとにきて言,いった、「先生,せんせい、わたしたちがお頼,たのみすることは、なんでもかなえてくださるようにお願,ねがいします」。","tok":[["さて"],["、"],["ゼベダイ"],["の"],["子","こ"],["の"],["ヤコブ"],["と"],["ヨハネ"],["と"],["が"],["イエス"],["の"],["もと"],["に"],["きて"],["言った","いった"],["、"],["「"],["先生","せんせい"],["、"],["わたしたち"],["が"],["お頼み","おたのみ"],["する"],["こと"],["は"],["、"],["なん"],["で"],["も"],["かなえて"],["くださる"],["よう"],["に"],["お願い","おねがい"],["します"],["」"],["。"]]},{"verse":36,"text":"イエスは彼,かれらに「何,なにをしてほしいと、願,ねがうのか」と言,いわれた。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["に"],["「"],["何に","なに"],["を"],["して"],["ほしい"],["と"],["、"],["願う","ねがう"],["の"],["か"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":37,"text":"すると彼,かれらは言,いった、「栄光,えいこうをお受,うけになるとき、ひとりをあなたの右,みぎに、ひとりを左,ひだりにすわるようにしてください」。","tok":[["する"],["と"],["彼","かれ"],["ら"],["は"],["言った","いった"],["、"],["「"],["栄光","えいこう"],["を"],["お受け","おうけ"],["に"],["なる"],["とき"],["、"],["ひとり"],["を"],["あなた"],["の"],["右","みぎ"],["に"],["、"],["ひとり"],["を"],["左","ひだり"],["に"],["すわる"],["よう"],["に"],["して"],["ください"],["」"],["。"]]},{"verse":38,"text":"イエスは言,いわれた、「あなたがたは自分,じぶんが何,なにを求,もとめているのか、わかっていない。あなたがたは、わたしが飲,のむ杯,さかずきを飲,のみ、わたしが受,うけるバプテスマを受,うけることができるか」。","tok":[["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["あなた"],["がた"],["は"],["自分","じぶん"],["が"],["何に","なに"],["を"],["求めて","もとめて"],["いる"],["の"],["か"],["、"],["わかって"],["いない"],["。"],["あなた"],["がた"],["は"],["、"],["わたし"],["が"],["飲む","のむ"],["杯","さかずき"],["を"],["飲み","のみ"],["、"],["わたし"],["が"],["受る","うける"],["バプテスマ"],["を"],["受る","うける"],["こと"],["が"],["できる"],["か"],["」"],["。"]]},{"verse":39,"text":"彼,かれらは「できます」と答,こたえた。するとイエスは言,いわれた、「あなたがたは、わたしが飲,のむ杯,さかずきを飲,のみ、わたしが受,うけるバプテスマを受,うけるであろう。","tok":[["彼","かれ"],["ら"],["は"],["「"],["できます"],["」"],["と"],["答","こたえ"],["た"],["。"],["する"],["と"],["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["あなた"],["がた"],["は"],["、"],["わたし"],["が"],["飲む","のむ"],["杯","さかずき"],["を"],["飲み","のみ"],["、"],["わたし"],["が"],["受る","うける"],["バプテスマ"],["を"],["受るで","うけるで"],["あろう"],["。"]]},{"verse":40,"text":"しかし、わたしの右,みぎ、左,ひだりにすわらせることは、わたしのすることではなく、ただ備,そなえられている人々,ひとびとだけに許,ゆるされることである」。","tok":[["しかし"],["、"],["わたし"],["の"],["右","みぎ"],["、"],["左","ひだり"],["に"],["すわらせる"],["こと"],["は"],["、"],["わたし"],["の"],["する"],["こと"],["で"],["は"],["なく"],["、"],["ただ"],["備","そなえ"],["られて"],["いる"],["人々","ひとびと"],["だけ"],["に"],["許される","ゆるされる"],["こと"],["で"],["ある"],["」"],["。"]]},{"verse":41,"text":"十人,にんの者,ものはこれを聞,きいて、ヤコブとヨハネとのことで憤慨,ふんがいし出,だした。","tok":[["十人","にん"],["の"],["者","もの"],["は"],["これ"],["を"],["聞いて","きいて"],["、"],["ヤコブ"],["と"],["ヨハネ"],["と"],["の"],["こと"],["で"],["憤慨","ふんがい"],["し"],["出した","だした"],["。"]]},{"verse":42,"text":"そこで、イエスは彼,かれらを呼,よび寄,よせて言,いわれた、「あなたがたの知,しっているとおり、異邦人,いほうじんの支配者,しはいしゃと見,みられている人々,ひとびとは、その民,たみを治め,おさめ、また偉,えらい人,ひとたちは、その民,たみの上,うえに権力,けんりょくをふるっている。","tok":[["そこ"],["で"],["、"],["イエス"],["は"],["彼","かれ"],["ら"],["を"],["呼び寄せて","よびよせて"],["言われた","いわれた"],["、"],["「"],["あなた"],["がた"],["の"],["知って","しって"],["いる"],["とおり"],["、"],["異邦人","いほうじん"],["の"],["支配者","しはいしゃ"],["と"],["見られて","みられて"],["いる"],["人々","ひとびと"],["は"],["、"],["その"],["民","たみ"],["を"],["治め","おさめ"],[","],["おさめ"],["、"],["また"],["偉い","えらい"],["人","ひと"],["たち"],["は"],["、"],["その"],["民","たみ"],["の"],["上","うえ"],["に"],["権力","けんりょく"],["を"],["ふるって"],["いる"],["。"]]},{"verse":43,"text":"しかし、あなたがたの間,あいだでは、そうであってはならない。かえって、あなたがたの間,あいだで偉,えらくなりたいと思,おもう者,ものは、仕,つかえる人,ひととなり、","tok":[["しかし"],["、"],["あなた"],["がた"],["の"],["間","あいだ"],["で"],["は"],["、"],["そう"],["で"],["あって"],["は"],["ならない"],["。"],["かえって"],["、"],["あなた"],["がた"],["の"],["間","あいだ"],["で"],["偉く","えらく"],["なりたい"],["と"],["思う","おもう"],["者","もの"],["は"],["、"],["仕える","つかえる"],["人となり","ひととなり"],["、"]]},{"verse":44,"text":"あなたがたの間,あいだでかしらになりたいと思,おもう者,ものは、すべての人,ひとの僕,しもべとならねばならない。","tok":[["あなた"],["がた"],["の"],["間","あいだ"],["で"],["かしら"],["に"],["なりたい"],["と"],["思う","おもう"],["者","もの"],["は"],["、"],["すべて"],["の"],["人","ひと"],["の"],["僕","し"],["も"],["べ"],["と"],["ならねば"],["ならない"],["。"]]},{"verse":45,"text":"人,ひとの子,こがきたのも、仕,つかえられるためではなく、仕,つかえるためであり、また多,おおくの人,ひとのあがないとして、自分,じぶんの命,いのちを与,あたえるためである」。","tok":[["人","ひと"],["の"],["子","こ"],["が"],["きた"],["の"],["も"],["、"],["仕えられる","つかえられる"],["ため"],["で"],["は"],["なく"],["、"],["仕える","つかえる"],["ため"],["で"],["あり"],["、"],["また"],["多く","おおく"],["の"],["人","ひと"],["の"],["あ"],["が"],["ない"],["として"],["、"],["自分","じぶん"],["の"],["命","いのち"],["を"],["与える","あたえる"],["ため"],["で"],["ある"],["」"],["。"]]},{"verse":46,"text":"それから、彼,かれらはエリコにきた。そして、イエスが弟子,でしたちや大,おおぜいの群衆,ぐんしゅうと共,ともにエリコから出,でかけられたとき、テマイの子,こ、バルテマイという盲人,もうじんのこじきが、道,みちばたにすわっていた。","tok":[["それ"],["から"],["、"],["彼","かれ"],["ら"],["は"],["エリコ"],["に"],["きた"],["。"],["そして"],["、"],["イエス"],["が"],["弟子","でし"],["たち"],["や"],["大ぜい","おおぜい"],["の"],["群衆","ぐんしゅう"],["と"],["共","とも"],["に"],["エリコ"],["から"],["出かけられた","でかけられた"],["とき"],["、"],["テマイ"],["の"],["子","こ"],["、"],["バルテマイ"],["と"],["いう"],["盲人","もうじん"],["の"],["こじき"],["が"],["、"],["道ばた","みちばた"],["に"],["すわって"],["いた"],["。"]]},{"verse":47,"text":"ところが、ナザレのイエスだと聞,きいて、彼,かれは「ダビデの子,こイエスよ、わたしをあわれんでください」と叫,さけび出,だした。","tok":[["ところ"],["が"],["、"],["ナザレ"],["の"],["イエス"],["だ"],["と"],["聞いて","きいて"],["、"],["彼","かれ"],["は"],["「"],["ダビデ"],["の"],["子","こ"],["イエス"],["よ"],["、"],["わたし"],["を"],["あわれんで"],["ください"],["」"],["と"],["叫","さけび"],["出した","だした"],["。"]]},{"verse":48,"text":"多,おおくの人々,ひとびとは彼,かれをしかって黙,だまらせようとしたが、彼,かれはますます激,はげしく叫,さけびつづけた、「ダビデの子,こイエスよ、わたしをあわれんでください」。","tok":[["多く","おおく"],["の"],["人々","ひとびと"],["は"],["彼","かれ"],["を"],["しかって"],["黙らせよう","だまらせよう"],["と"],["した"],["が"],["、"],["彼","かれ"],["は"],["ますます"],["激しく","はげしく"],["叫","さけび"],["つづけた"],["、"],["「"],["ダビデ"],["の"],["子","こ"],["イエス"],["よ"],["、"],["わたし"],["を"],["あわれんで"],["ください"],["」"],["。"]]},{"verse":49,"text":"イエスは立,たちどまって「彼,かれを呼,よべ」と命,めいじられた。そこで、人々,ひとびとはその盲人,もうじんを呼,よんで言,いった、「喜,よろこべ、立,たて、おまえを呼,よんでおられる」。","tok":[["イエス"],["は"],["立ちどまって","たちどまって"],["「"],["彼","かれ"],["を"],["呼べ","よべ"],["」"],["と"],["命じられた","めいじられた"],["。"],["そこ"],["で"],["、"],["人々","ひとびと"],["は"],["その"],["盲人","もうじん"],["を"],["呼んで","よんで"],["言った","いった"],["、"],["「"],["喜こべ","よろこべ"],["、"],["立","たて"],["、"],["おまえ"],["を"],["呼んで","よんで"],["おられる"],["」"],["。"]]},{"verse":50,"text":"そこで彼,かれは上着,うわぎを脱,ぬぎ捨,すて、踊,おどりあがってイエスのもとにきた。","tok":[["そこ"],["で"],["彼","かれ"],["は"],["上着","うわぎ"],["を"],["脱ぎ捨て","ぬぎすて"],["、"],["踊","おどり"],["あがって"],["イエス"],["の"],["もと"],["に"],["きた"],["。"]]},{"verse":51,"text":"イエスは彼,かれにむかって言,いわれた、「わたしに何,なにをしてほしいのか」。その盲人,もうじんは言,いった、「先生,せんせい、見,みえるようになることです」。","tok":[["イエス"],["は"],["彼","かれ"],["に"],["むかって"],["言われた","いわれた"],["、"],["「"],["わたし"],["に"],["何に","なに"],["を"],["して"],["ほしい"],["の"],["か"],["」"],["。"],["その"],["盲人","もうじん"],["は"],["言った","いった"],["、"],["「"],["先生","せんせい"],["、"],["見える","みえる"],["よう"],["に"],["なる"],["こと"],["です"],["」"],["。"]]},{"verse":52,"text":"そこでイエスは言,いわれた、「行,いけ、あなたの信仰,しんこうがあなたを救,すくった」。すると彼,かれは、たちまち見,みえるようになり、イエスに従,したがって行,いった。","tok":[["そこ"],["で"],["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["行け","いけ"],["、"],["あなた"],["の"],["信仰","しんこう"],["が"],["あなた"],["を"],["救った","すくった"],["」"],["。"],["する"],["と"],["彼","かれ"],["は"],["、"],["たちまち"],["見える","みえる"],["よう"],["に"],["なり"],["、"],["イエス"],["に"],["従って","したがって"],["行った","いった"],["。"]]}]
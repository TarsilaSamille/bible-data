[{"verse":1,"text":"さて、彼,かれらがエルサレムに近,ちかづき、オリブの山,やまに沿,そったベテパゲ、ベタニヤの附近,ふきんにきた時,とき、イエスはふたりの弟子,でしをつかわして言,いわれた、","tok":[["さて"],["、"],["彼","かれ"],["ら"],["が"],["エルサレム"],["に"],["近づき","ちかづき"],["、"],["オリブ"],["の"],["山","やま"],["に"],["沿った","そった"],["ベテパゲ"],["、"],["ベタニヤ"],["の"],["附近","ふきん"],["に"],["きた"],["時","とき"],["、"],["イエス"],["は"],["ふたり"],["の"],["弟子","でし"],["を"],["つかわして"],["言われた","いわれた"],["、"]]},{"verse":2,"text":"「むこうの村,むらへ行,いきなさい。そこにはいるとすぐ、まだだれも乗,のったことのないろばの子,こが、つないであるのを見,みるであろう。それを解,といて引,ひいてきなさい。","tok":[["「"],["むこう"],["の"],["村","むら"],["へ"],["行き","いき"],["なさい"],["。"],["そこ"],["に"],["はいる"],["と"],["すぐ"],["、"],["まだ"],["だれ"],["も"],["乗った","のった"],["こと"],["の"],["ない"],["ろば"],["の"],["子","こ"],["が"],["、"],["つないで"],["ある"],["の"],["を"],["見るで","みるで"],["あろう"],["。"],["それ"],["を"],["解いて","といて"],["引いて","ひいて"],["き"],["なさい"],["。"]]},{"verse":3,"text":"もし、だれかがあなたがたに、なぜそんな事,ことをするのかと言,いったなら、主,しゅがお入,いり用,ようなのです。またすぐ、ここへ返,かえしてくださいますと、言,いいなさい」。","tok":[["もし"],["、"],["だれ"],["か"],["が"],["あなた"],["がた"],["に"],["、"],["なぜ"],["そんな"],["事","こと"],["を"],["する"],["の"],["か"],["と"],["言ったなら","いったなら"],["、"],["主","しゅ"],["が"],["お入用","おいりよう"],["な"],["の"],["です"],["。"],["また"],["すぐ"],["、"],["ここ"],["へ"],["返","かえし"],["て"],["くださいます"],["と"],["、"],["言い","いい"],["なさい"],["」"],["。"]]},{"verse":4,"text":"そこで、彼,かれらは出,でかけて行,いき、そして表通,おもてどおりの戸口,とぐちに、ろばの子,こがつないであるのを見,みたので、それを解,といた。","tok":[["そこ"],["で"],["、"],["彼","かれ"],["ら"],["は"],["出かけて","でかけて"],["行き","いき"],["、"],["そして"],["表通","おもてどおり"],["の"],["戸口","とぐち"],["に"],["、"],["ろば"],["の"],["子","こ"],["が"],["つないで"],["ある"],["の"],["を"],["見た","みた"],["ので"],["、"],["それ"],["を"],["解いた","といた"],["。"]]},{"verse":5,"text":"すると、そこに立,たっていた人々,ひとびとが言,いった、「そのろばの子,こを解,といて、どうするのか」。","tok":[["する"],["と"],["、"],["そこ"],["に"],["立って","たって"],["いた"],["人々","ひとびと"],["が"],["言った","いった"],["、"],["「"],["その"],["ろば"],["の"],["子","こ"],["を"],["解いて","といて"],["、"],["どう"],["する"],["の"],["か"],["」"],["。"]]},{"verse":6,"text":"弟子,でしたちは、イエスが言,いわれたとおり彼,かれらに話,はなしたので、ゆるしてくれた。","tok":[["弟子","でし"],["たち"],["は"],["、"],["イエス"],["が"],["言われた","いわれた"],["とおり"],["彼","かれ"],["ら"],["に"],["話","はなし"],["た"],["ので"],["、"],["ゆるして"],["くれた"],["。"]]},{"verse":7,"text":"そこで、弟子,でしたちは、そのろばの子,こをイエスのところに引,ひいてきて、自分,じぶんたちの上着,うわぎをそれに投,なげかけると、イエスはその上,うえにお乗,のりになった。","tok":[["そこ"],["で"],["、"],["弟子","でし"],["たち"],["は"],["、"],["その"],["ろば"],["の"],["子","こ"],["を"],["イエス"],["の"],["ところ"],["に"],["引いて","ひいて"],["きて"],["、"],["自分","じぶん"],["たち"],["の"],["上着","うわぎ"],["を"],["それ"],["に"],["投","なげ"],["かける"],["と"],["、"],["イエス"],["は"],["その"],["上","うえ"],["に"],["お乗","おのり"],["に"],["なった"],["。"]]},{"verse":8,"text":"すると多,おおくの人々,ひとびとは自分,じぶんたちの上着,うわぎを道,みちに敷,しき、また他,たの人々,ひとびとは葉,はのついた枝,えだを野原,のはらから切,きってきて敷,しいた。","tok":[["する"],["と"],["多く","おおく"],["の"],["人々","ひとびと"],["は"],["自分","じぶん"],["たち"],["の"],["上着","うわぎ"],["を"],["道","みち"],["に"],["敷","しき"],["、"],["また"],["他","た"],["の"],["人々","ひとびと"],["は"],["葉","は"],["の"],["ついた"],["枝","えだ"],["を"],["野原","のはら"],["から"],["切って","きって"],["きて"],["敷いた","しいた"],["。"]]},{"verse":9,"text":"そして、前,まえに行,ゆく者,ものも、あとに従,したがう者,ものも共,ともに叫,さけびつづけた、「ホサナ、主,しゅの御名,みなによってきたる者,ものに、祝福,しゅくふくあれ。","tok":[["そして"],["、"],["前","まえ"],["に"],["行く","ゆく"],["者","もの"],["も"],["、"],["あと"],["に"],["従う","したがう"],["者","もの"],["も"],["共","とも"],["に"],["叫","さけび"],["つづけた"],["、"],["「"],["ホサナ"],["、"],["主","しゅ"],["の"],["御名","みな"],["によって"],["きたる"],["者","もの"],["に"],["、"],["祝福","しゅくふく"],["あれ"],["。"]]},{"verse":10,"text":"今,いまきたる、われらの父,ちちダビデの国,くにに、祝福,しゅくふくあれ。いと高,たかき所,ところに、ホサナ」。","tok":[["今","いま"],["きたる"],["、"],["われ"],["ら"],["の"],["父","ちち"],["ダビデ"],["の"],["国","くに"],["に"],["、"],["祝福","しゅくふく"],["あれ"],["。"],["いと"],["高き","たかき"],["所","ところ"],["に"],["、"],["ホサナ"],["」"],["。"]]},{"verse":11,"text":"こうしてイエスはエルサレムに着,つき、宮,みやにはいられた。そして、すべてのものを見,みまわった後,のち、もはや時,ときもおそくなっていたので、十二弟子,でしと共,ともにベタニヤに出,でて行,いかれた。","tok":[["こう"],["して"],["イエス"],["は"],["エルサレム"],["に"],["着き","つき"],["、"],["宮","みや"],["に"],["は"],["いられた"],["。"],["そして"],["、"],["すべて"],["の"],["もの"],["を"],["見まわった","みまわった"],["後","の"],["ち"],["、"],["もはや"],["時","とき"],["も"],["おそく"],["なって"],["いた"],["ので"],["、"],["十二","じゅうに"],["弟子","でし"],["と"],["共","とも"],["に"],["ベタニヤ"],["に"],["出て","でて"],["行かれた","いかれた"],["。"]]},{"verse":12,"text":"翌日,よくじつ、彼,かれらがベタニヤから出,でかけてきたとき、イエスは空腹,くうふくをおぼえられた。","tok":[["翌日","よくじつ"],["、"],["彼","かれ"],["ら"],["が"],["ベタニヤ"],["から"],["出かけて","でかけて"],["きた"],["とき"],["、"],["イエス"],["は"],["空腹","くうふく"],["を"],["おぼえられた"],["。"]]},{"verse":13,"text":"そして、葉,はの茂,しげったいちじくの木,きを遠,とおくからごらんになって、その木,きに何,なにかありはしないかと近寄,ちかよられたが、葉,はのほかは何,なにも見当,みあたらなかった。いちじくの季節,きせつでなかったからである。","tok":[["そして"],["、"],["葉","は"],["の"],["茂った","しげった"],["いちじく"],["の"],["木","き"],["を"],["遠く","とおく"],["から"],["ごらん"],["に"],["なって"],["、"],["その"],["木","き"],["に"],["何に","なに"],["か"],["あり"],["は"],["しない"],["か"],["と"],["近寄られた","ちかよられた"],["が"],["、"],["葉","は"],["の"],["ほか"],["は"],["何に","なに"],["も"],["見当たらなかった","みあたらなかった"],["。"],["いちじく"],["の"],["季節","きせつ"],["で"],["なかった"],["から"],["で"],["ある"],["。"]]},{"verse":14,"text":"そこで、イエスはその木,きにむかって、「今,いまから後,のちいつまでも、おまえの実,みを食,たべる者,ものがないように」と言,いわれた。弟子,でしたちはこれを聞,きいていた。","tok":[["そこ"],["で"],["、"],["イエス"],["は"],["その"],["木","き"],["に"],["むかって"],["、"],["「"],["今","いま"],["から"],["後","のちいつま"],["で"],["も"],["、"],["おまえ"],["の"],["実","み"],["を"],["食べる","たべる"],["者","もの"],["が"],["ない"],["よう"],["に"],["」"],["と"],["言われた","いわれた"],["。"],["弟子","でし"],["たち"],["は"],["これ"],["を"],["聞いて","きいて"],["いた"],["。"]]},{"verse":15,"text":"それから、彼,かれらはエルサレムにきた。イエスは宮,みやに入,はいり、宮,みやの庭,にわで売,うり買,かいしていた人々,ひとびとを追,おい出,だしはじめ、両替人,りょうがえにんの台,だいや、はとを売,うる者,ものの腰掛,こしかけをくつがえし、","tok":[["それ"],["から"],["、"],["彼","かれ"],["ら"],["は"],["エルサレム"],["に"],["きた"],["。"],["イエス"],["は"],["宮","みや"],["に"],["入り","はいり"],["、"],["宮","みや"],["の"],["庭","にわ"],["で"],["売買","うりかい"],["して"],["いた"],["人々","ひとびと"],["を"],["追い出し","おいだし"],["はじめ"],["、"],["両替人","りょうがえにん"],["の"],["台","だい"],["や"],["、"],["はと"],["を"],["売る","うる"],["者","もの"],["の"],["腰掛","こしかけ"],["を"],["くつがえし"],["、"]]},{"verse":16,"text":"また器,うつわものを持,もって宮,みやの庭,にわを通,とおり抜,ぬけるのをお許,ゆるしにならなかった。","tok":[["また"],["器","うつわ"],["もの"],["を"],["持って","もって"],["宮","みや"],["の"],["庭","にわ"],["を"],["通り","とおり"],["抜る","ぬける"],["の"],["を"],["お許し","おゆるし"],["に"],["ならなかった"],["。"]]},{"verse":17,"text":"そして、彼,かれらに教,おしえて言,いわれた、「『わたしの家,いえは、すべての国民,こくみんの祈,いのりの家,いえととなえらるべきである』と書,かいてあるではないか。それだのに、あなたがたはそれを強盗,ごうとうの巣,すにしてしまった」。","tok":[["そして"],["、"],["彼","かれ"],["ら"],["に"],["教えて","おしえて"],["言われた","いわれた"],["、"],["「"],["『"],["わたし"],["の"],["家","いえ"],["は"],["、"],["すべて"],["の"],["国民","こくみん"],["の"],["祈","いのり"],["の"],["家","いえ"],["と"],["となえらるべきで"],["ある"],["』"],["と"],["書いて","かいて"],["ある"],["で"],["は"],["ない"],["か"],["。"],["それ"],["だ"],["のに"],["、"],["あなた"],["がた"],["は"],["それ"],["を"],["強盗","ごうとう"],["の"],["巣","す"],["に"],["して"],["しまった"],["」"],["。"]]},{"verse":18,"text":"祭司長,さいしちょう、律法,りっぽう学者,がくしゃたちはこれを聞,きいて、どうかしてイエスを殺,ころそうと計,はかった。彼,かれらは、群衆,ぐんしゅうがみなその教,おしえに感動,かんどうしていたので、イエスを恐,おそれていたからである。","tok":[["祭司長","さいしちょう"],["、"],["律法学者","りっぽうがくしゃ"],["たち"],["は"],["これ"],["を"],["聞いて","きいて"],["、"],["どう"],["か"],["して"],["イエス"],["を"],["殺そう","ころそう"],["と"],["計った","はかった"],["。"],["彼","かれ"],["ら"],["は"],["、"],["群衆","ぐんしゅう"],["が"],["みな"],["その"],["教え","おしえ"],["に"],["感動","かんどう"],["して"],["いた"],["ので"],["、"],["イエス"],["を"],["恐れて","おそれて"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":19,"text":"夕方,ゆうがたになると、イエスと弟子,でしたちとは、いつものように都,みやこの外,そとに出,でて行,いった。","tok":[["夕方","ゆうがた"],["に"],["なる"],["と"],["、"],["イエス"],["と"],["弟子","でし"],["たち"],["と"],["は"],["、"],["いつも"],["の"],["よう"],["に"],["都","みやこ"],["の"],["外","そと"],["に"],["出て","でて"],["行った","いった"],["。"]]},{"verse":20,"text":"朝,あさはやく道,みちをとおっていると、彼,かれらは先,さきのいちじくが根元,ねもとから枯,かれているのを見,みた。","tok":[["朝","あさ"],["はやく"],["道","みち"],["を"],["とおって"],["いる"],["と"],["、"],["彼","かれ"],["ら"],["は"],["先","さき"],["の"],["いちじく"],["が"],["根元","ねもと"],["から"],["枯て","かれて"],["いる"],["の"],["を"],["見た","みた"],["。"]]},{"verse":21,"text":"そこで、ペテロは思,おもい出,だしてイエスに言,いった、「先生,せんせい、ごらんなさい。あなたがのろわれたいちじくが、枯,かれています」。","tok":[["そこ"],["で"],["、"],["ペテロ"],["は"],["思い出して","おもいだして"],["イエス"],["に"],["言った","いった"],["、"],["「"],["先生","せんせい"],["、"],["ごらん"],["なさい"],["。"],["あなた"],["が"],["のろわれた"],["いちじく"],["が"],["、"],["枯て","かれて"],["います"],["」"],["。"]]},{"verse":22,"text":"イエスは答,こたえて言,いわれた、「神,かみを信,しんじなさい。","tok":[["イエス"],["は"],["答","こたえ"],["て"],["言われた","いわれた"],["、"],["「"],["神","かみ"],["を"],["信じ","しんじ"],["なさい"],["。"]]},{"verse":23,"text":"よく聞,きいておくがよい。だれでもこの山,やまに、動,うごき出,だして、海,うみの中,なかにはいれと言,いい、その言,いったことは必,かならず成,なると、心,こころに疑,うたがわないで信,しんじるなら、そのとおりに成,なるであろう。","tok":[["よく"],["聞いて","きいて"],["おく"],["が"],["よい"],["。"],["だれ"],["で"],["も"],["この"],["山","やま"],["に"],["、"],["動き","うごき"],["出して","だして"],["、"],["海","うみ"],["の"],["中","なか"],["に"],["はいれ"],["と"],["言い","いい"],["、"],["その"],["言った","いった"],["こと"],["は"],["必","かならず"],["成る","なる"],["と"],["、"],["心","こころ"],["に"],["疑がわないで","うたがわないで"],["信じるなら","しんじるなら"],["、"],["その"],["とおり"],["に"],["成るで","なるで"],["あろう"],["。"]]},{"verse":24,"text":"そこで、あなたがたに言,いうが、なんでも祈,いのり求,もとめることは、すでにかなえられたと信,しんじなさい。そうすれば、そのとおりになるであろう。","tok":[["そこ"],["で"],["、"],["あなた"],["がた"],["に"],["言う","いう"],["が"],["、"],["なん"],["で"],["も"],["祈","いのり"],["求める","もとめる"],["こと"],["は"],["、"],["すでに"],["かなえられた"],["と"],["信じ","しんじ"],["なさい"],["。"],["そう"],["すれば"],["、"],["その"],["とおり"],["に"],["なるで"],["あろう"],["。"]]},{"verse":25,"text":"また立,たって祈,いのるとき、だれかに対,たいして、何,なにか恨,うらみ事,ことがあるならば、ゆるしてやりなさい。そうすれば、天,てんにいますあなたがたの父,ちちも、あなたがたのあやまちを、ゆるしてくださるであろう。〔","tok":[["また"],["立って","たって"],["祈る","いのる"],["とき"],["、"],["だれ"],["か"],["に対して","にたいして"],["、"],["何に","なに"],["か"],["恨み","うらみ"],["事","こと"],["が"],["あるならば"],["、"],["ゆるして"],["やり"],["なさい"],["。"],["そう"],["すれば"],["、"],["天","てん"],["に"],["います"],["あなた"],["がた"],["の"],["父","ちち"],["も"],["、"],["あなた"],["がた"],["の"],["あやまち"],["を"],["、"],["ゆるして"],["くださるで"],["あろう"],["。"],["〔"]]},{"verse":26,"text":"もしゆるさないならば、天,てんにいますあなたがたの父,ちちも、あなたがたのあやまちを、ゆるしてくださらないであろう〕」。","tok":[["もし"],["ゆるさないならば"],["、"],["天","てん"],["に"],["います"],["あなた"],["がた"],["の"],["父","ちち"],["も"],["、"],["あなた"],["がた"],["の"],["あやまち"],["を"],["、"],["ゆるして"],["くださらないで"],["あろう"],["〕"],["」"],["。"]]},{"verse":27,"text":"彼,かれらはまたエルサレムにきた。そして、イエスが宮,みやの内,うちを歩,あるいておられると、祭司長,さいしちょう、律法,りっぽう学者,がくしゃ、長老,ちょうろうたちが、みもとにきて言,いった、","tok":[["彼","かれ"],["ら"],["は"],["また"],["エルサレム"],["に"],["きた"],["。"],["そして"],["、"],["イエス"],["が"],["宮","みや"],["の"],["内","うち"],["を"],["歩いて","あるいて"],["おられる"],["と"],["、"],["祭司長","さいしちょう"],["、"],["律法学者","りっぽうがくしゃ"],["、"],["長老","ちょうろう"],["たち"],["が"],["、"],["みもと"],["に"],["きて"],["言った","いった"],["、"]]},{"verse":28,"text":"「何,なにの権威,けんいによってこれらの事,ことをするのですか。だれが、そうする権威,けんいを授,さづけたのですか」。","tok":[["「"],["何","なに"],["の"],["権威","けんい"],["によって"],["これ"],["ら"],["の"],["事","こと"],["を"],["する"],["の"],["です"],["か"],["。"],["だれ"],["が"],["、"],["そう"],["する"],["権威","けんい"],["を"],["授","さづけた"],["の"],["です"],["か"],["」"],["。"]]},{"verse":29,"text":"そこで、イエスは彼,かれらに言,いわれた、「一つだけ尋,たずねよう。それに答,こたえてほしい。そうしたら、何,なにの権威,けんいによって、わたしがこれらの事,ことをするのか、あなたがたに言,いおう。","tok":[["そこ"],["で"],["、"],["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["一","ひと"],["つ"],["だけ"],["尋ねよう","たずねよう"],["。"],["それ"],["に"],["答","こたえ"],["て"],["ほしい"],["。"],["そう"],["したら"],["、"],["何","なに"],["の"],["権威","けんい"],["によって"],["、"],["わたし"],["が"],["これ"],["ら"],["の"],["事","こと"],["を"],["する"],["の"],["か"],["、"],["あなた"],["がた"],["に"],["言おう","いおう"],["。"]]},{"verse":30,"text":"ヨハネのバプテスマは天,てんからであったか、人,ひとからであったか、答,こたえなさい」。","tok":[["ヨハネ"],["の"],["バプテスマ"],["は"],["天","てん"],["から"],["で"],["あった"],["か"],["、"],["人","ひと"],["から"],["で"],["あった"],["か"],["、"],["答","こたえ"],["なさい"],["」"],["。"]]},{"verse":31,"text":"すると、彼,かれらは互,たがいに論,ろんじて言,いった、「もし天,てんからだと言,いえば、では、なぜ彼,かれを信,しんじなかったのか、とイエスは言,いうだろう。","tok":[["する"],["と"],["、"],["彼","かれ"],["ら"],["は"],["互","たがい"],["に"],["論じて","ろんじて"],["言った","いった"],["、"],["「"],["もし"],["天","てん"],["から"],["だ"],["と"],["言えば","いえば"],["、"],["で"],["は"],["、"],["なぜ"],["彼","かれ"],["を"],["信じなかった","しんじなかった"],["の"],["か"],["、"],["と"],["イエス"],["は"],["言うだろう","いうだろう"],["。"]]},{"verse":32,"text":"しかし、人,ひとからだと言,いえば……」。彼,かれらは群衆,ぐんしゅうを恐,おそれていた。人々,ひとびとが皆,みな、ヨハネを預言者,よげんしゃだとほんとうに思,おもっていたからである。","tok":[["しかし"],["、"],["人","ひと"],["から"],["だ"],["と"],["言えば","いえば"],["…"],["…"],["」"],["。"],["彼","かれ"],["ら"],["は"],["群衆","ぐんしゅう"],["を"],["恐れて","おそれて"],["いた"],["。"],["人々","ひとびと"],["が"],["皆","みな"],["、"],["ヨハネ"],["を"],["預言者","よげんしゃ"],["だ"],["と"],["ほんとう"],["に"],["思って","おもって"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":33,"text":"それで彼,かれらは「わたしたちにはわかりません」と答,こたえた。するとイエスは言,いわれた、「わたしも何,なにの権威,けんいによってこれらの事,ことをするのか、あなたがたに言,いうまい」。","tok":[["それ"],["で"],["彼","かれ"],["ら"],["は"],["「"],["わたしたち"],["に"],["は"],["わかりません"],["」"],["と"],["答","こたえ"],["た"],["。"],["する"],["と"],["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["わたし"],["も"],["何","なに"],["の"],["権威","けんい"],["によって"],["これ"],["ら"],["の"],["事","こと"],["を"],["する"],["の"],["か"],["、"],["あなた"],["がた"],["に"],["言うまい","いうまい"],["」"],["。"]]}]
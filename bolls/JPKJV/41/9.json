[{"verse":1,"text":"また、彼,かれらに言,いわれた、「よく聞,きいておくがよい。神,かみの国,くにが力,ちからをもって来,くるのを見,みるまでは、決,けっして死,しを味,あじわわない者,ものが、ここに立,たっている者,ものの中,なかにいる」。","tok":[["また"],["、"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["よく"],["聞いて","きいて"],["おく"],["が"],["よい"],["。"],["神","かみ"],["の"],["国","くに"],["が"],["力","ちから"],["を"],["もって"],["来る","くる"],["の"],["を"],["見る","みる"],["まで"],["は"],["、"],["決っして","けっして"],["死","し"],["を"],["味わわない","あじわわない"],["者","もの"],["が"],["、"],["ここ"],["に"],["立って","たって"],["いる"],["者","もの"],["の"],["中","なか"],["に"],["いる"],["」"],["。"]]},{"verse":2,"text":"六日,むいかの後,のち、イエスは、ただペテロ、ヤコブ、ヨハネだけを連,つれて、高,たかい山,やまに登,のぼられた。ところが、彼,かれらの目,めの前,まえでイエスの姿,すがたが変,かわり、","tok":[["六日","むいか"],["の"],["後","の"],["ち"],["、"],["イエス"],["は"],["、"],["ただ"],["ペテロ"],["、"],["ヤコブ"],["、"],["ヨハネ"],["だけ"],["を"],["連れて","つれて"],["、"],["高かい","たかい"],["山","やま"],["に"],["登られた","のぼられた"],["。"],["ところ"],["が"],["、"],["彼","かれ"],["ら"],["の"],["目","め"],["の"],["前","まえ"],["で"],["イエス"],["の"],["姿","すがた"],["が"],["変わり","かわり"],["、"]]},{"verse":3,"text":"その衣,ころもは真白,まっしろく輝,かがやき、どんな布,ぬのさらしでも、それほどに白,しろくすることはできないくらいになった。","tok":[["その"],["衣","ころも"],["は"],["真白く","まっしろく"],["輝やき","かがやき"],["、"],["どんな"],["布","ぬの"],["さらし"],["で"],["も"],["、"],["それ"],["ほど"],["に"],["白く","しろく"],["する"],["こと"],["は"],["できない"],["くらい"],["に"],["なった"],["。"]]},{"verse":4,"text":"すると、エリヤがモーセと共,ともに彼,かれらに現,あらわれて、イエスと語,かたり合,あっていた。","tok":[["する"],["と"],["、"],["エリヤ"],["が"],["モーセ"],["と"],["共","とも"],["に"],["彼","かれ"],["ら"],["に"],["現われて","あらわれて"],["、"],["イエス"],["と"],["語り合って","かたりあって"],["いた"],["。"]]},{"verse":5,"text":"ペテロはイエスにむかって言,いった、「先生,せんせい、わたしたちがここにいるのは、すばらしいことです。それで、わたしたちは小屋,こやを三つ建,たてましょう。一つはあなたのために、一つはモーセのために、一つはエリヤのために」。","tok":[["ペテロ"],["は"],["イエス"],["に"],["むかって"],["言った","いった"],["、"],["「"],["先生","せんせい"],["、"],["わたしたち"],["が"],["ここ"],["に"],["いる"],["の"],["は"],["、"],["すばらしい"],["こと"],["です"],["。"],["それ"],["で"],["、"],["わたしたち"],["は"],["小屋","こや"],["を"],["三","みっ"],["つ"],["建てましょう","たてましょう"],["。"],["一","ひと"],["つ"],["は"],["あなた"],["の"],["ため"],["に"],["、"],["一","ひと"],["つ"],["は"],["モーセ"],["の"],["ため"],["に"],["、"],["一","ひと"],["つ"],["は"],["エリヤ"],["の"],["ため"],["に"],["」"],["。"]]},{"verse":6,"text":"そう言,いったのは、みんなの者,ものが非常,ひじょうに恐,おそれていたので、ペテロは何,なにを言,いってよいか、わからなかったからである。","tok":[["そう"],["言った","いった"],["の"],["は"],["、"],["みんな"],["の"],["者","もの"],["が"],["非常","ひじょう"],["に"],["恐れて","おそれて"],["いた"],["ので"],["、"],["ペテロ"],["は"],["何に","なに"],["を"],["言って","いって"],["よい"],["か"],["、"],["わからなかった"],["から"],["で"],["ある"],["。"]]},{"verse":7,"text":"すると、雲,くもがわき起,おこって彼,かれらをおおった。そして、その雲,くもの中,なかから声,こえがあった、「これはわたしの愛,あいする子,こである。これに聞,きけ」。","tok":[["する"],["と"],["、"],["雲","くも"],["が"],["わき起こって","わきおこって"],["彼","かれ"],["ら"],["を"],["おおった"],["。"],["そして"],["、"],["その"],["雲","くも"],["の"],["中","なか"],["から"],["声","こえ"],["が"],["あった"],["、"],["「"],["これ"],["は"],["わたし"],["の"],["愛する","あいする"],["子","こ"],["で"],["ある"],["。"],["これ"],["に"],["聞け","きけ"],["」"],["。"]]},{"verse":8,"text":"彼,かれらは急,いそいで見,みまわしたが、もはやだれも見,みえず、ただイエスだけが、自分,じぶんたちと一緒,いっしょにおられた。","tok":[["彼","かれ"],["ら"],["は"],["急いで","いそいで"],["見まわした","みまわした"],["が"],["、"],["もはや"],["だれ"],["も"],["見えず","みえず"],["、"],["ただ"],["イエス"],["だけ"],["が"],["、"],["自分","じぶん"],["たち"],["と"],["一緒","いっしょ"],["に"],["おられた"],["。"]]},{"verse":9,"text":"一同,いちどうが山,やまを下,くだって来,くるとき、イエスは「人,ひとの子,こが死人,しにんの中,なかからよみがえるまでは、いま見,みたことをだれにも話,はなしてはならない」と、彼,かれらに命,めいじられた。","tok":[["一同","いちどう"],["が"],["山","やま"],["を"],["下って","くだって"],["来る","くる"],["とき"],["、"],["イエス"],["は"],["「"],["人","ひと"],["の"],["子","こ"],["が"],["死人","しにん"],["の"],["中","なか"],["から"],["よみがえる"],["まで"],["は"],["、"],["いま"],["見た","みた"],["こと"],["を"],["だれ"],["に"],["も"],["話","はなし"],["ては"],["ならない"],["」"],["と"],["、"],["彼","かれ"],["ら"],["に"],["命じられた","めいじられた"],["。"]]},{"verse":10,"text":"彼,かれらはこの言葉,ことばを心,こころにとめ、死人,しにんの中,なかからよみがえるとはどういうことかと、互,たがいに論,ろんじ合,あった。","tok":[["彼","かれ"],["ら"],["は"],["この"],["言葉","ことば"],["を"],["心","こころ"],["に"],["とめ"],["、"],["死人","しにん"],["の"],["中","なか"],["から"],["よみがえる"],["と"],["は"],["どういう"],["こと"],["か"],["と"],["、"],["互","たがい"],["に"],["論じ合った","ろんじあった"],["。"]]},{"verse":11,"text":"そしてイエスに尋,たずねた、「なぜ、律法,りっぽう学者,がくしゃたちは、エリヤが先,さきに来,くるはずだと言,いっているのですか」。","tok":[["そして"],["イエス"],["に"],["尋ねた","たずねた"],["、"],["「"],["なぜ"],["、"],["律法学者","りっぽうがくしゃ"],["たち"],["は"],["、"],["エリヤ"],["が"],["先","さき"],["に"],["来る","くる"],["はず"],["だ"],["と"],["言って","いって"],["いる"],["の"],["です"],["か"],["」"],["。"]]},{"verse":12,"text":"イエスは言,いわれた、「確,たしかに、エリヤが先,さきにきて、万事,ばんじを元,もとどおりに改,あらためる。しかし、人,ひとの子,こについて、彼,かれが多,おおくの苦,くるしみを受,うけ、かつ恥,はずかしめられると、書,かいてあるのはなぜか。","tok":[["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["確か","たしか"],["に"],["、"],["エリヤ"],["が"],["先","さき"],["に"],["きて"],["、"],["万事","ばんじ"],["を"],["元どおり","もとどおり"],["に"],["改める","あらためる"],["。"],["しかし"],["、"],["人","ひと"],["の"],["子","こ"],["について"],["、"],["彼","かれ"],["が"],["多く","おおく"],["の"],["苦しみ","くるしみ"],["を"],["受け","うけ"],["、"],["かつ"],["恥ずかしめられる","はずかしめられる"],["と"],["、"],["書いて","かいて"],["ある"],["の"],["は"],["なぜ"],["か"],["。"]]},{"verse":13,"text":"しかしあなたがたに言,いっておく、エリヤはすでにきたのだ。そして彼,かれについて書,かいてあるように、人々,ひとびとは自分,じぶんかってに彼,かれをあしらった」。","tok":[["しかし"],["あなた"],["がた"],["に"],["言って","いって"],["おく"],["、"],["エリヤ"],["は"],["すでに"],["きた"],["の"],["だ"],["。"],["そして"],["彼","かれ"],["について"],["書いて","かいて"],["ある"],["よう"],["に"],["、"],["人々","ひとびと"],["は"],["自分","じぶん"],["かって"],["に"],["彼","かれ"],["を"],["あしらった"],["」"],["。"]]},{"verse":14,"text":"さて、彼,かれらがほかの弟子,でしたちの所,ところにきて見,みると、大,おおぜいの群衆,ぐんしゅうが弟子,でしたちを取,とり囲,かこみ、そして律法,りっぽう学者,がくしゃたちが彼,かれらと論,ろんじ合,あっていた。","tok":[["さて"],["、"],["彼","かれ"],["ら"],["が"],["ほか"],["の"],["弟子","でし"],["たち"],["の"],["所","ところ"],["に"],["きて"],["見る","みる"],["と"],["、"],["大ぜい","おおぜい"],["の"],["群衆","ぐんしゅう"],["が"],["弟子","でし"],["たち"],["を"],["取囲み","とりかこみ"],["、"],["そして"],["律法学者","りっぽうがくしゃ"],["たち"],["が"],["彼","かれ"],["ら"],["と"],["論じ合って","ろんじあって"],["いた"],["。"]]},{"verse":15,"text":"群衆,ぐんしゅうはみな、すぐイエスを見,みつけて、非常,ひじょうに驚,おどろき、駆,かけ寄,よってきて、あいさつをした。","tok":[["群衆","ぐんしゅう"],["は"],["みな"],["、"],["すぐ"],["イエス"],["を"],["見つけて","みつけて"],["、"],["非常","ひじょう"],["に"],["驚","おどろき"],["、"],["駆け寄って","かけよって"],["きて"],["、"],["あいさつ"],["を"],["した"],["。"]]},{"verse":16,"text":"イエスが彼,かれらに、「あなたがたは彼,かれらと何,なにを論,ろんじているのか」と尋,たずねられると、","tok":[["イエス"],["が"],["彼","かれ"],["ら"],["に"],["、"],["「"],["あなた"],["がた"],["は"],["彼","かれ"],["ら"],["と"],["何に","なに"],["を"],["論じて","ろんじて"],["いる"],["の"],["か"],["」"],["と"],["尋ねられる","たずねられる"],["と"],["、"]]},{"verse":17,"text":"群衆,ぐんしゅうのひとりが答,こたえた、「先生,せんせい、おしの霊,れいにつかれているわたしのむすこを、こちらに連,つれて参,まいりました。","tok":[["群衆","ぐんしゅう"],["の"],["ひとり"],["が"],["答","こたえ"],["た"],["、"],["「"],["先生","せんせい"],["、"],["おし"],["の"],["霊","れい"],["に"],["つかれて"],["いる"],["わたし"],["の"],["むすこ"],["を"],["、"],["こちら"],["に"],["連れて","つれて"],["参りました","まいりました"],["。"]]},{"verse":18,"text":"霊,れいがこのむすこにとりつきますと、どこででも彼,かれを引,ひき倒,たおし、それから彼,かれはあわを吹,ふき、歯,はをくいしばり、からだをこわばらせてしまいます。それでお弟子,でしたちに、この霊,れいを追,おい出,だしてくださるように願,ねがいましたが、できませんでした」。","tok":[["霊","れい"],["が"],["この"],["むすこ"],["に"],["とりつきます"],["と"],["、"],["どこ"],["で"],["で"],["も"],["彼","かれ"],["を"],["引倒","ひきたお"],["し"],["、"],["それ"],["から"],["彼","かれ"],["は"],["あわ"],["を"],["吹","ふき"],["、"],["歯","は"],["を"],["くいしばり"],["、"],["からだ"],["を"],["こわばらせて"],["しまいます"],["。"],["それ"],["で"],["お弟子","おでし"],["たち"],["に"],["、"],["この"],["霊","れい"],["を"],["追い出して","おいだして"],["くださる"],["よう"],["に"],["願いました","ねがいました"],["が"],["、"],["できませんでした"],["」"],["。"]]},{"verse":19,"text":"イエスは答,こたえて言,いわれた、「ああ、なんという不,ふ信仰,しんこうな時代,じだいであろう。いつまで、わたしはあなたがたと一緒,いっしょにおられようか。いつまで、あなたがたに我慢,がまんができようか。その子,こをわたしの所,ところに連,つれてきなさい」。","tok":[["イエス"],["は"],["答","こたえ"],["て"],["言われた","いわれた"],["、"],["「"],["ああ"],["、"],["なん"],["と"],["いう"],["不","ふ"],["信仰","しんこう"],["な"],["時代","じだい"],["で"],["あろう"],["。"],["いつ"],["まで"],["、"],["わたし"],["は"],["あなた"],["がた"],["と"],["一緒","いっしょ"],["に"],["おられよう"],["か"],["。"],["いつ"],["まで"],["、"],["あなた"],["がた"],["に"],["我慢","がまん"],["が"],["できよう"],["か"],["。"],["その"],["子","こ"],["を"],["わたし"],["の"],["所","ところ"],["に"],["連れて","つれて"],["き"],["なさい"],["」"],["。"]]},{"verse":20,"text":"そこで人々,ひとびとは、その子,こをみもとに連,つれてきた。霊,れいがイエスを見,みるや否,いなや、その子,こをひきつけさせたので、子,こは地,ちに倒,たおれ、あわを吹,ふきながらころげまわった。","tok":[["そこ"],["で"],["人々","ひとびと"],["は"],["、"],["その"],["子","こ"],["を"],["みもと"],["に"],["連れて","つれて"],["きた"],["。"],["霊","れい"],["が"],["イエス"],["を"],["見る","みる"],["や"],["否","いな"],["や"],["、"],["その"],["子","こ"],["を"],["ひきつけさせた"],["ので"],["、"],["子","こ"],["は"],["地","ち"],["に"],["倒れ","たおれ"],["、"],["あわ"],["を"],["吹","ふき"],["ながら"],["ころげまわった"],["。"]]},{"verse":21,"text":"そこで、イエスが父親,ちちおやに「いつごろから、こんなになったのか」と尋,たずねられると、父親,ちちおやは答,こたえた、「幼,おさない時,ときからです。","tok":[["そこ"],["で"],["、"],["イエス"],["が"],["父親","ちちおや"],["に"],["「"],["いつごろ"],["から"],["、"],["こんな"],["に"],["なった"],["の"],["か"],["」"],["と"],["尋ねられる","たずねられる"],["と"],["、"],["父親","ちちおや"],["は"],["答","こたえ"],["た"],["、"],["「"],["幼ない","おさない"],["時","とき"],["から"],["です"],["。"]]},{"verse":22,"text":"霊,れいはたびたび、この子,こを火,ひの中,なか、水,みずの中,なかに投,なげ入,いれて、殺,ころそうとしました。しかしできますれば、わたしどもをあわれんでお助,たすけください」。","tok":[["霊","れい"],["は"],["たびたび"],["、"],["この"],["子","こ"],["を"],["火","ひ"],["の"],["中","なか"],["、"],["水","みず"],["の"],["中","なか"],["に"],["投入れて","なげいれて"],["、"],["殺そう","ころそう"],["と"],["しました"],["。"],["しかし"],["できますれば"],["、"],["わたし"],["ども"],["を"],["あわれんで"],["お助け","おたすけ"],["ください"],["」"],["。"]]},{"verse":23,"text":"イエスは彼,かれに言,いわれた、「もしできれば、と言,いうのか。信,しんずる者,ものには、どんな事,ことでもできる」。","tok":[["イエス"],["は"],["彼","かれ"],["に"],["言われた","いわれた"],["、"],["「"],["もし"],["できれば"],["、"],["と"],["言う","いう"],["の"],["か"],["。"],["信ずる","しんずる"],["者","もの"],["に"],["は"],["、"],["どんな"],["事","こと"],["で"],["も"],["できる"],["」"],["。"]]},{"verse":24,"text":"その子,この父親,ちちおやはすぐ叫,さけんで言,いった、「信,しんじます。不,ふ信仰,しんこうなわたしを、お助,たすけください」。","tok":[["その"],["子","こ"],["の"],["父親","ちちおや"],["は"],["すぐ"],["叫けんで","さけんで"],["言った","いった"],["、"],["「"],["信じます","しんじます"],["。"],["不","ふ"],["信仰","しんこう"],["な"],["わたし"],["を"],["、"],["お助け","おたすけ"],["ください"],["」"],["。"]]},{"verse":25,"text":"イエスは群衆,ぐんしゅうが駆,かけ寄,よって来,くるのをごらんになって、けがれた霊,れいをしかって言,いわれた、「おしとつんぼの霊,れいよ、わたしがおまえに命,めいじる。この子,こから出,でて行,いけ。二度,どと、はいって来,くるな」。","tok":[["イエス"],["は"],["群衆","ぐんしゅう"],["が"],["駆け寄って","かけよって"],["来る","くる"],["の"],["を"],["ごらん"],["に"],["なって"],["、"],["けがれた"],["霊","れい"],["を"],["しかって"],["言われた","いわれた"],["、"],["「"],["おし"],["と"],["つんぼ"],["の"],["霊","れい"],["よ"],["、"],["わたし"],["が"],["おまえ"],["に"],["命じる","めいじる"],["。"],["この"],["子","こ"],["から"],["出て","でて"],["行け","いけ"],["。"],["二","に"],["度","ど"],["と"],["、"],["はいって"],["来る","くる"],["な"],["」"],["。"]]},{"verse":26,"text":"すると霊,れいは叫,さけび声,ごえをあげ、激,はげしく引,ひきつけさせて出,でて行,いった。その子,こは死人,しにんのようになったので、多,おおくの人,ひとは、死,しんだのだと言,いった。","tok":[["する"],["と"],["霊","れい"],["は"],["叫声","さけびごえ"],["を"],["あげ"],["、"],["激しく","はげしく"],["引","ひき"],["つけさせて"],["出て","でて"],["行った","いった"],["。"],["その"],["子","こ"],["は"],["死人","しにん"],["の"],["よう"],["に"],["なった"],["ので"],["、"],["多く","おおく"],["の"],["人","ひと"],["は"],["、"],["死","しんだ"],["の"],["だ"],["と"],["言った","いった"],["。"]]},{"verse":27,"text":"しかし、イエスが手,てを取,とって起,おこされると、その子,こは立,たち上,あがった。","tok":[["しかし"],["、"],["イエス"],["が"],["手","て"],["を"],["取って","とって"],["起こされる","おこされる"],["と"],["、"],["その"],["子","こ"],["は"],["立ち上がった","たちあがった"],["。"]]},{"verse":28,"text":"家,いえにはいられたとき、弟子,でしたちはひそかにお尋,たずねした、「わたしたちは、どうして霊,れいを追,おい出,だせなかったのですか」。","tok":[["家","いえ"],["に"],["は"],["いられた"],["とき"],["、"],["弟子","でし"],["たち"],["は"],["ひそか"],["に"],["お尋ね","おたずね"],["した"],["、"],["「"],["わたしたち"],["は"],["、"],["どう"],["して"],["霊","れい"],["を"],["追い出せなかった","おいだせなかった"],["の"],["です"],["か"],["」"],["。"]]},{"verse":29,"text":"すると、イエスは言,いわれた、「このたぐいは、祈,いのりによらなければ、どうしても追,おい出,だすことはできない」。","tok":[["する"],["と"],["、"],["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["この"],["たぐい"],["は"],["、"],["祈","いのり"],["に"],["よらなければ"],["、"],["どう"],["して"],["も"],["追い出す","おいだす"],["こと"],["は"],["できない"],["」"],["。"]]},{"verse":30,"text":"それから彼,かれらはそこを立,たち去,さり、ガリラヤをとおって行,いったが、イエスは人,ひとに気,きづかれるのを好,このまれなかった。","tok":[["それ"],["から"],["彼","かれ"],["ら"],["は"],["そこ"],["を"],["立ち去り","たちさり"],["、"],["ガリラヤ"],["を"],["とおって"],["行った","いった"],["が"],["、"],["イエス"],["は"],["人","ひと"],["に"],["気づかれる","きづかれる"],["の"],["を"],["好まれなかった","このまれなかった"],["。"]]},{"verse":31,"text":"それは、イエスが弟子,でしたちに教,おしえて、「人,ひとの子,こは人々,ひとびとの手,てにわたされ、彼,かれらに殺,ころされ、殺,ころされてから三日,かの後,のちによみがえるであろう」と言,いっておられたからである。","tok":[["それ"],["は"],["、"],["イエス"],["が"],["弟子","でし"],["たち"],["に"],["教えて","おしえて"],["、"],["「"],["人","ひと"],["の"],["子","こ"],["は"],["人々","ひとびと"],["の"],["手","て"],["に"],["わたされ"],["、"],["彼","かれ"],["ら"],["に"],["殺ろされ","ころされ"],["、"],["殺ろされて","ころされて"],["から"],["三日","か"],["の"],["後","のち"],["に"],["よみがえるで"],["あろう"],["」"],["と"],["言って","いって"],["おられた"],["から"],["で"],["ある"],["。"]]},{"verse":32,"text":"しかし、彼,かれらはイエスの言,いわれたことを悟,さとらず、また尋,たずねるのを恐,おそれていた。","tok":[["しかし"],["、"],["彼","かれ"],["ら"],["は"],["イエス"],["の"],["言われた","いわれた"],["こと"],["を"],["悟らず","さとらず"],["、"],["また"],["尋ねる","たずねる"],["の"],["を"],["恐れて","おそれて"],["いた"],["。"]]},{"verse":33,"text":"それから彼,かれらはカペナウムにきた。そして家,いえにおられるとき、イエスは弟子,でしたちに尋,たずねられた、「あなたがたは途中,とちゅうで何,なにを論,ろんじていたのか」。","tok":[["それ"],["から"],["彼","かれ"],["ら"],["は"],["カペナウム"],["に"],["きた"],["。"],["そして"],["家","いえ"],["に"],["おられる"],["とき"],["、"],["イエス"],["は"],["弟子","でし"],["たち"],["に"],["尋ねられた","たずねられた"],["、"],["「"],["あなた"],["がた"],["は"],["途中","とちゅう"],["で"],["何に","なに"],["を"],["論じて","ろんじて"],["いた"],["の"],["か"],["」"],["。"]]},{"verse":34,"text":"彼,かれらは黙,だまっていた。それは途中,とちゅうで、だれが一ばん偉,えらいかと、互,たがいに論,ろんじ合,あっていたからである。","tok":[["彼","かれ"],["ら"],["は"],["黙って","だまって"],["いた"],["。"],["それ"],["は"],["途中","とちゅう"],["で"],["、"],["だれ"],["が"],["一ばん","いちばん"],["偉い","えらい"],["か"],["と"],["、"],["互","たがい"],["に"],["論じ合って","ろんじあって"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":35,"text":"そこで、イエスはすわって十二弟子,でしを呼,よび、そして言,いわれた、「だれでも一ばん先,さきになろうと思,おもうならば、一ばんあとになり、みんなに仕,つかえる者,ものとならねばならない」。","tok":[["そこ"],["で"],["、"],["イエス"],["は"],["すわって"],["十二","じゅうに"],["弟子","でし"],["を"],["呼び","よび"],["、"],["そして"],["言われた","いわれた"],["、"],["「"],["だれ"],["で"],["も"],["一ばん","いちばん"],["先","さき"],["に"],["なろう"],["と"],["思うならば","おもうならば"],["、"],["一ばん","いちばん"],["あと"],["に"],["なり"],["、"],["みんな"],["に"],["仕える","つかえる"],["者","もの"],["と"],["ならねば"],["ならない"],["」"],["。"]]},{"verse":36,"text":"そして、ひとりの幼,おさな子,ごをとりあげて、彼,かれらのまん中,なかに立,たたせ、それを抱,だいて言,いわれた。","tok":[["そして"],["、"],["ひとり"],["の"],["幼な子","おさなご"],["を"],["とりあげて"],["、"],["彼","かれ"],["ら"],["の"],["まん中","まんなか"],["に"],["立たせ","たたせ"],["、"],["それ"],["を"],["抱いて","だいて"],["言われた","いわれた"],["。"]]},{"verse":37,"text":"「だれでも、このような幼,おさな子,ごのひとりを、わたしの名,なのゆえに受,うけいれる者,ものは、わたしを受,うけいれるのである。そして、わたしを受,うけいれる者,ものは、わたしを受,うけいれるのではなく、わたしをおつかわしになったかたを受,うけいれるのである」。","tok":[["「"],["だれ"],["で"],["も"],["、"],["この"],["よう"],["な"],["幼な子","おさなご"],["の"],["ひとり"],["を"],["、"],["わたし"],["の"],["名","な"],["の"],["ゆえ"],["に"],["受","うけ"],["いれる"],["者","もの"],["は"],["、"],["わたし"],["を"],["受","うけ"],["いれる"],["ので"],["ある"],["。"],["そして"],["、"],["わたし"],["を"],["受","うけ"],["いれる"],["者","もの"],["は"],["、"],["わたし"],["を"],["受","うけ"],["いれる"],["ので"],["は"],["なく"],["、"],["わたし"],["を"],["おつかわし"],["に"],["なった"],["かた"],["を"],["受","うけ"],["いれる"],["ので"],["ある"],["」"],["。"]]},{"verse":38,"text":"ヨハネがイエスに言,いった、「先生,せんせい、わたしたちについてこない者,ものが、あなたの名,なを使,つかって悪霊,あくれいを追,おい出,だしているのを見,みましたが、その人,ひとはわたしたちについてこなかったので、やめさせました」。","tok":[["ヨハネ"],["が"],["イエス"],["に"],["言った","いった"],["、"],["「"],["先生","せんせい"],["、"],["わたしたち"],["について"],["こない"],["者","もの"],["が"],["、"],["あなた"],["の"],["名","な"],["を"],["使って","つかって"],["悪霊","あくれい"],["を"],["追い出して","おいだして"],["いる"],["の"],["を"],["見ました","みました"],["が"],["、"],["その"],["人","ひと"],["は"],["わたしたち"],["について"],["こなかった"],["ので"],["、"],["やめさせました"],["」"],["。"]]},{"verse":39,"text":"イエスは言,いわれた、「やめさせないがよい。だれでもわたしの名,なで力,ちからあるわざを行,おこないながら、すぐそのあとで、わたしをそしることはできない。","tok":[["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["やめさせない"],["が"],["よい"],["。"],["だれ"],["で"],["も"],["わたし"],["の"],["名","な"],["で"],["力","ちから"],["ある"],["わざ"],["を"],["行ない","おこない"],["ながら"],["、"],["すぐ"],["その"],["あと"],["で"],["、"],["わたし"],["を"],["そしる"],["こと"],["は"],["できない"],["。"]]},{"verse":40,"text":"わたしたちに反対,はんたいしない者,ものは、わたしたちの味方,みかたである。","tok":[["わたしたち"],["に"],["反対","はんたい"],["しない"],["者","もの"],["は"],["、"],["わたしたち"],["の"],["味方","みかた"],["で"],["ある"],["。"]]},{"verse":41,"text":"だれでも、キリストについている者,ものだというので、あなたがたに水,みず一杯,いっぱいでも飲,のませてくれるものは、よく言,いっておくが、決,けっしてその報,むくいからもれることはないであろう。","tok":[["だれ"],["で"],["も"],["、"],["キリスト"],["について"],["いる"],["者","もの"],["だ"],["と"],["いう"],["ので"],["、"],["あなた"],["がた"],["に"],["水","みず"],["一杯","いっぱい"],["で"],["も"],["飲ませて","のませて"],["くれる"],["もの"],["は"],["、"],["よく"],["言って","いって"],["おく"],["が"],["、"],["決っして","けっして"],["その"],["報い","むくい"],["から"],["もれる"],["こと"],["は"],["ないで"],["あろう"],["。"]]},{"verse":42,"text":"また、わたしを信,しんじるこれらの小,ちいさい者,もののひとりをつまずかせる者,ものは、大,おおきなひきうすを首,くびにかけられて海,うみに投,なげ込,こまれた方,ほうが、はるかによい。","tok":[["また"],["、"],["わたし"],["を"],["信じる","しんじる"],["これ"],["ら"],["の"],["小さい","ちいさい"],["者","もの"],["の"],["ひとり"],["を"],["つまずかせる"],["者","もの"],["は"],["、"],["大きな","おおきな"],["ひきうす"],["を"],["首","くび"],["に"],["かけられて"],["海","うみ"],["に"],["投込まれた","なげこまれた"],["方","ほう"],["が"],["、"],["はるか"],["に"],["よい"],["。"]]},{"verse":43,"text":"もし、あなたの片手,かたてが罪,つみを犯,おかさせるなら、それを切,きり捨,すてなさい。両手,りょうてがそろったままで地獄,じごくの消,きえない火,ひの中,なかに落,おち込,こむよりは、かたわになって命,いのちに入,はいる方,ほうがよい。〔","tok":[["もし"],["、"],["あなた"],["の"],["片手","かたて"],["が"],["罪","つみ"],["を"],["犯させるなら","おかさせるなら"],["、"],["それ"],["を"],["切り捨て","きりすて"],["なさい"],["。"],["両手","りょうて"],["が"],["そろった"],["まま"],["で"],["地獄","じごく"],["の"],["消えない","きえない"],["火","ひ"],["の"],["中","なか"],["に"],["落込む","おちこむ"],["より"],["は"],["、"],["かた"],["わ"],["に"],["なって"],["命","いのち"],["に"],["入る","はいる"],["方","ほう"],["が"],["よい"],["。"],["〔"]]},{"verse":44,"text":"地獄,じごくでは、うじがつきず、火,ひも消,きえることがない。〕","tok":[["地獄","じごく"],["で"],["は"],["、"],["うじ"],["が"],["つきず"],["、"],["火","ひ"],["も"],["消える","きえる"],["こと"],["が"],["ない"],["。"],["〕"]]},{"verse":45,"text":"もし、あなたの片足,かたあしが罪,つみを犯,おかさせるなら、それを切,きり捨,すてなさい。両足,りょうあしがそろったままで地獄,じごくに投,なげ入,いれられるよりは、片足,かたあしで命,いのちに入,はいる方,ほうがよい。〔","tok":[["もし"],["、"],["あなた"],["の"],["片足","かたあし"],["が"],["罪","つみ"],["を"],["犯させるなら","おかさせるなら"],["、"],["それ"],["を"],["切り捨て","きりすて"],["なさい"],["。"],["両足","りょうあし"],["が"],["そろった"],["まま"],["で"],["地獄","じごく"],["に"],["投入れられる","なげいれられる"],["より"],["は"],["、"],["片足","かたあし"],["で"],["命","いのち"],["に"],["入る","はいる"],["方","ほう"],["が"],["よい"],["。"],["〔"]]},{"verse":46,"text":"地獄,じごくでは、うじがつきず、火,ひも消,きえることがない。〕","tok":[["地獄","じごく"],["で"],["は"],["、"],["うじ"],["が"],["つきず"],["、"],["火","ひ"],["も"],["消える","きえる"],["こと"],["が"],["ない"],["。"],["〕"]]},{"verse":47,"text":"もし、あなたの片目,かためが罪,つみを犯,おかさせるなら、それを抜,ぬき出,だしなさい。両,りょう眼,がんがそろったままで地獄,じごくに投,なげ入,いれられるよりは、片目,かためになって神,かみの国,くにに入,はいる方,ほうがよい。","tok":[["もし"],["、"],["あなた"],["の"],["片目","かため"],["が"],["罪","つみ"],["を"],["犯させるなら","おかさせるなら"],["、"],["それ"],["を"],["抜き出し","ぬきだし"],["なさい"],["。"],["両眼","りょうがん"],["が"],["そろった"],["まま"],["で"],["地獄","じごく"],["に"],["投入れられる","なげいれられる"],["より"],["は"],["、"],["片目","かため"],["に"],["なって"],["神","かみ"],["の"],["国","くに"],["に"],["入る","はいる"],["方","ほう"],["が"],["よい"],["。"]]},{"verse":48,"text":"地獄,じごくでは、うじがつきず、火,ひも消,きえることがない。","tok":[["地獄","じごく"],["で"],["は"],["、"],["うじ"],["が"],["つきず"],["、"],["火","ひ"],["も"],["消える","きえる"],["こと"],["が"],["ない"],["。"]]},{"verse":49,"text":"人,ひとはすべて火,ひで塩,しおづけられねばならない。","tok":[["人","ひと"],["は"],["すべて"],["火","ひ"],["で"],["塩づけ","しおづけ"],["られねば"],["ならない"],["。"]]},{"verse":50,"text":"塩,しおはよいものである。しかし、もしその塩,しおの味,あじがぬけたら、何,なにによってその味,あじが取,とりもどされようか。あなたがた自身,じしんの内,うちに塩,しおを持,もちなさい。そして、互,たがいに和,やわらぎなさい」。","tok":[["塩","しお"],["は"],["よい"],["もの"],["で"],["ある"],["。"],["しかし"],["、"],["もし"],["その"],["塩","しお"],["の"],["味","あじ"],["が"],["ぬけたら"],["、"],["何に","なに"],["によって"],["その"],["味","あじ"],["が"],["取","とり"],["もどされよう"],["か"],["。"],["あなた"],["がた"],["自身","じしん"],["の"],["内","うち"],["に"],["塩","しお"],["を"],["持","もち"],["なさい"],["。"],["そして"],["、"],["互","たがい"],["に"],["和らぎ","やわらぎ"],["なさい"],["」"],["。"]]}]
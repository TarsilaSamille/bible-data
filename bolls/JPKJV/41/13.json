[{"verse":1,"text":"イエスが宮,みやから出,でて行,いかれるとき、弟子,でしのひとりが言,いった、「先生,せんせい、ごらんなさい。なんという見事,みごとな石,いし、なんという立派,りっぱな建物,たてものでしょう」。","tok":[["イエス"],["が"],["宮","みや"],["から"],["出て","でて"],["行かれる","いかれる"],["とき"],["、"],["弟子","でし"],["の"],["ひとり"],["が"],["言った","いった"],["、"],["「"],["先生","せんせい"],["、"],["ごらん"],["なさい"],["。"],["なん"],["と"],["いう"],["見事","みごと"],["な"],["石","いし"],["、"],["なん"],["と"],["いう"],["立派","りっぱ"],["な"],["建物","たてもの"],["でしょう"],["」"],["。"]]},{"verse":2,"text":"イエスは言,いわれた、「あなたは、これらの大,おおきな建物,たてものをながめているのか。その石,いし一つでもくずされないままで、他,たの石,いしの上,うえに残,のこることもなくなるであろう」。","tok":[["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["あなた"],["は"],["、"],["これ"],["ら"],["の"],["大きな","おおきな"],["建物","たてもの"],["を"],["ながめて"],["いる"],["の"],["か"],["。"],["その"],["石","いし"],["一","ひと"],["つ"],["で"],["も"],["くずされない"],["まま"],["で"],["、"],["他","た"],["の"],["石","いし"],["の"],["上","うえ"],["に"],["残る","のこる"],["こと"],["も"],["なくなるで"],["あろう"],["」"],["。"]]},{"verse":3,"text":"またオリブ山,やまで、宮,みやにむかってすわっておられると、ペテロ、ヤコブ、ヨハネ、アンデレが、ひそかにお尋,たずねした。","tok":[["また"],["オリブ山","おりぶやま"],["で"],["、"],["宮","みや"],["に"],["むかって"],["すわって"],["おられる"],["と"],["、"],["ペテロ"],["、"],["ヤコブ"],["、"],["ヨハネ"],["、"],["アンデレ"],["が"],["、"],["ひそか"],["に"],["お尋ね","おたずね"],["した"],["。"]]},{"verse":4,"text":"「わたしたちにお話,はなしください。いつ、そんなことが起,おこるのでしょうか。またそんなことがことごとく成就,じょうじゅするような場合,ばあいには、どんな前兆,ぜんちょうがありますか」。","tok":[["「"],["わたしたち"],["に"],["お話","おはなし"],["ください"],["。"],["いつ"],["、"],["そんな"],["こと"],["が"],["起こる","おこる"],["の"],["でしょう"],["か"],["。"],["また"],["そんな"],["こと"],["が"],["ことごとく"],["成就","じょうじゅ"],["する"],["よう"],["な"],["場合","ばあい"],["に"],["は"],["、"],["どんな"],["前兆","ぜんちょう"],["が"],["あります"],["か"],["」"],["。"]]},{"verse":5,"text":"そこで、イエスは話,はなしはじめられた、「人,ひとに惑,まどわされないように気,きをつけなさい。","tok":[["そこ"],["で"],["、"],["イエス"],["は"],["話","はなし"],["はじめられた"],["、"],["「"],["人","ひと"],["に"],["惑わされない","まどわされない"],["よう"],["に"],["気","き"],["を"],["つけ"],["なさい"],["。"]]},{"verse":6,"text":"多,おおくの者,ものがわたしの名,なを名,なのって現,あらわれ、自分,じぶんがそれだと言,いって、多,おおくの人,ひとを惑,まどわすであろう。","tok":[["多く","おおく"],["の"],["者","もの"],["が"],["わたし"],["の"],["名","な"],["を"],["名のって","なのって"],["現われ","あらわれ"],["、"],["自分","じぶん"],["が"],["それ"],["だ"],["と"],["言って","いって"],["、"],["多く","おおく"],["の"],["人","ひと"],["を"],["惑わすで","まどわすで"],["あろう"],["。"]]},{"verse":7,"text":"また、戦争,せんそうと戦争,せんそうのうわさとを聞,きくときにも、あわてるな。それは起,おこらねばならないが、まだ終,おわりではない。","tok":[["また"],["、"],["戦争","せんそう"],["と"],["戦争","せんそう"],["の"],["うわさ"],["と"],["を"],["聞く","きく"],["とき"],["に"],["も"],["、"],["あわてる"],["な"],["。"],["それ"],["は"],["起こらねば","おこらねば"],["ならない"],["が"],["、"],["まだ"],["終","おわり"],["で"],["は"],["ない"],["。"]]},{"verse":8,"text":"民,たみは民,たみに、国,くには国,くにに敵対,てきたいして立,たち上,あがるであろう。またあちこちに地震,じしんがあり、またききんが起,おこるであろう。これらは産,うみの苦,くるしみの初,はじめである。","tok":[["民","たみ"],["は"],["民","たみ"],["に"],["、"],["国","くに"],["は"],["国","くに"],["に"],["敵対","てきたい"],["して"],["立ち上がるで","たちあがるで"],["あろう"],["。"],["また"],["あちこち"],["に"],["地震","じしん"],["が"],["あり"],["、"],["また"],["ききん"],["が"],["起こるで","おこるで"],["あろう"],["。"],["これ"],["ら"],["は"],["産み","うみ"],["の"],["苦しみ","くるしみ"],["の"],["初め","はじめ"],["で"],["ある"],["。"]]},{"verse":9,"text":"あなたがたは自分,じぶんで気,きをつけていなさい。あなたがたは、わたしのために、衆議所,しゅうぎしょに引,ひきわたされ、会堂,かいどうで打,うたれ、長官,ちょうかんたちや王,おうたちの前,まえに立,たたされ、彼,かれらに対,たいしてあかしをさせられるであろう。","tok":[["あなた"],["がた"],["は"],["自分","じぶん"],["で"],["気","き"],["を"],["つけて"],["い"],["なさい"],["。"],["あなた"],["がた"],["は"],["、"],["わたし"],["の"],["ため"],["に"],["、"],["衆議所","しゅうぎしょ"],["に"],["引","ひき"],["わたされ"],["、"],["会堂","かいどう"],["で"],["打たれ","うたれ"],["、"],["長官","ちょうかん"],["たち"],["や"],["王","おう"],["たち"],["の"],["前","まえ"],["に"],["立たされ","たたされ"],["、"],["彼","かれ"],["ら"],["に対して","にたいして"],["あかし"],["を"],["させられるで"],["あろう"],["。"]]},{"verse":10,"text":"こうして、福音,ふくいんはまずすべての民,たみに宣,のべ伝,つたえられねばならない。","tok":[["こう"],["して"],["、"],["福音","ふくいん"],["は"],["まず"],["すべて"],["の"],["民","たみ"],["に"],["宣べ伝えられねば","のべつたえられねば"],["ならない"],["。"]]},{"verse":11,"text":"そして、人々,ひとびとがあなたがたを連,つれて行,いって引,ひきわたすとき、何,なにを言,いおうかと、前,まえもって心配,しんぱいするな。その場合,ばあい、自分,じぶんに示,しめされることを語,かたるがよい。語,かたる者,ものはあなたがた自身,じしんではなくて、聖霊,せいれいである。","tok":[["そして"],["、"],["人々","ひとびと"],["が"],["あなた"],["がた"],["を"],["連れて","つれて"],["行って","いって"],["引","ひき"],["わたす"],["とき"],["、"],["何に","なに"],["を"],["言おう","いおう"],["か"],["と"],["、"],["前もって","まえもって"],["心配","しんぱい"],["する"],["な"],["。"],["その"],["場合","ばあい"],["、"],["自分","じぶん"],["に"],["示めされる","しめされる"],["こと"],["を"],["語る","かたる"],["が"],["よい"],["。"],["語る","かたる"],["者","もの"],["は"],["あなた"],["がた"],["自身","じしん"],["で"],["は"],["なくて"],["、"],["聖霊","せいれい"],["で"],["ある"],["。"]]},{"verse":12,"text":"また兄弟,きょうだいは兄弟,きょうだいを、父,ちちは子,こを殺,ころすために渡,わたし、子,こは両親,りょうしんに逆,さからって立,たち、彼,かれらを殺,ころさせるであろう。","tok":[["また"],["兄弟","きょうだい"],["は"],["兄弟","きょうだい"],["を"],["、"],["父","ちち"],["は"],["子","こ"],["を"],["殺ろす","ころす"],["ため"],["に"],["渡","わたし"],["、"],["子","こ"],["は"],["両親","りょうしん"],["に"],["逆らって","さからって"],["立ち","たち"],["、"],["彼","かれ"],["ら"],["を"],["殺させるで","ころさせるで"],["あろう"],["。"]]},{"verse":13,"text":"また、あなたがたはわたしの名,なのゆえに、すべての人,ひとに憎,にくまれるであろう。しかし、最後,さいごまで耐,たえ忍,しのぶ者,ものは救,すくわれる。","tok":[["また"],["、"],["あなた"],["がた"],["は"],["わたし"],["の"],["名","な"],["の"],["ゆえ"],["に"],["、"],["すべて"],["の"],["人","ひと"],["に"],["憎まれるで","にくまれるで"],["あろう"],["。"],["しかし"],["、"],["最後","さいご"],["まで"],["耐え","たえ"],["忍者","しのぶもの"],["は"],["救われる","すくわれる"],["。"]]},{"verse":14,"text":"荒,あらす憎,にくむべきものが、立,たってはならぬ所,ところに立,たつのを見,みたならば（読者,どくしゃよ、悟,さとれ）、そのとき、ユダヤにいる人々,ひとびとは山,やまへ逃,にげよ。","tok":[["荒す","あらす"],["憎むべき","にくむべき"],["もの"],["が"],["、"],["立って","たって"],["は"],["ならぬ"],["所","ところ"],["に"],["立つ","たつ"],["の"],["を"],["見たならば","みたならば"],["（"],["読者","どくしゃ"],["よ"],["、"],["悟れ","さとれ"],["）"],["、"],["その"],["とき"],["、"],["ユダヤ"],["に"],["いる"],["人々","ひとびと"],["は"],["山","やま"],["へ"],["逃","にげ"],["よ"],["。"]]},{"verse":15,"text":"屋上,おくじょうにいる者,ものは、下,したにおりるな。また家,いえから物,ものを取,とり出,だそうとして内,うちにはいるな。","tok":[["屋上","おくじょう"],["に"],["いる"],["者","もの"],["は"],["、"],["下","した"],["に"],["おりる"],["な"],["。"],["また"],["家","いえ"],["から"],["物","もの"],["を"],["取出そう","とりだそう"],["として"],["内","うち"],["に"],["はいる"],["な"],["。"]]},{"verse":16,"text":"畑,はたけにいる者,ものは、上着,うわぎを取,とりにあとへもどるな。","tok":[["畑","はたけ"],["に"],["いる"],["者","もの"],["は"],["、"],["上着","うわぎ"],["を"],["取","とり"],["に"],["あと"],["へ"],["もどる"],["な"],["。"]]},{"verse":17,"text":"その日,ひには、身重,みおもの女,おんなと乳飲,ちのみ子,ごをもつ女,おんなとは、不幸,ふこうである。","tok":[["その"],["日","ひ"],["に"],["は"],["、"],["身重","みおも"],["の"],["女","おんな"],["と"],["乳飲み子","ちのみご"],["を"],["もつ"],["女","おんな"],["と"],["は"],["、"],["不幸","ふこう"],["で"],["ある"],["。"]]},{"verse":18,"text":"この事,ことが冬,ふゆおこらぬように祈,いのれ。","tok":[["この"],["事","こと"],["が"],["冬","ふゆ"],["おこらぬ"],["よう"],["に"],["祈れ","いのれ"],["。"]]},{"verse":19,"text":"その日,ひには、神,かみが万物,ばんぶつを造,つくられた創造,そうぞうの初,はじめから現在,げんざいに至,いたるまで、かつてなく今後,こんごもないような患難,かんなんが起,おこるからである。","tok":[["その"],["日","ひ"],["に"],["は"],["、"],["神","かみ"],["が"],["万物","ばんぶつ"],["を"],["造られた","つくられた"],["創造","そうぞう"],["の"],["初め","はじめ"],["から"],["現在","げんざい"],["に"],["至る","いたる"],["まで"],["、"],["かつて"],["なく"],["今後","こんご"],["も"],["ない"],["よう"],["な"],["患難","かんなん"],["が"],["起こる","おこる"],["から"],["で"],["ある"],["。"]]},{"verse":20,"text":"もし主,しゅがその期間,きかんを縮,ちぢめてくださらないなら、救,すくわれる者,ものはひとりもないであろう。しかし、選,えらばれた選民,せんみんのために、その期間,きかんを縮,ちぢめてくださったのである。","tok":[["もし"],["主","しゅがそ"],["の"],["期間","きかん"],["を"],["縮めて","ちぢめて"],["くださらないなら"],["、"],["救われる","すくわれる"],["者","もの"],["は"],["ひとり"],["も"],["ないで"],["あろう"],["。"],["しかし"],["、"],["選ら","えら"],["ばれた"],["選民","せんみん"],["の"],["ため"],["に"],["、"],["その"],["期間","きかん"],["を"],["縮めて","ちぢめて"],["くださった"],["ので"],["ある"],["。"]]},{"verse":21,"text":"そのとき、だれかがあなたがたに『見,みよ、ここにキリストがいる』、『見,みよ、あそこにいる』と言,いっても、それを信,しんじるな。","tok":[["その"],["とき"],["、"],["だれ"],["か"],["が"],["あなた"],["がた"],["に"],["『"],["見よ","みよ"],["、"],["ここ"],["に"],["キリスト"],["が"],["いる"],["』"],["、"],["『"],["見よ","みよ"],["、"],["あそこ"],["に"],["いる"],["』"],["と"],["言って","いって"],["も"],["、"],["それ"],["を"],["信じる","しんじる"],["な"],["。"]]},{"verse":22,"text":"にせキリストたちや、にせ預言者,よげんしゃたちが起,おこって、しるしと奇跡,きせきとを行,おこない、できれば、選民,せんみんをも惑,まどわそうとするであろう。","tok":[["にせ"],["キリスト"],["たち"],["や"],["、"],["にせ"],["預言者","よげんしゃ"],["たち"],["が"],["起こって","おこって"],["、"],["しるし"],["と"],["奇跡","きせき"],["と"],["を"],["行ない","おこない"],["、"],["できれば"],["、"],["選民","せんみん"],["を"],["も"],["惑わそう","まどわそう"],["と"],["するで"],["あろう"],["。"]]},{"verse":23,"text":"だから、気,きをつけていなさい。いっさいの事,ことを、あなたがたに前,まえもって言,いっておく。","tok":[["だ"],["から"],["、"],["気","き"],["を"],["つけて"],["い"],["なさい"],["。"],["いっさい"],["の"],["事","こと"],["を"],["、"],["あなた"],["がた"],["に"],["前もって","まえもって"],["言って","いって"],["おく"],["。"]]},{"verse":24,"text":"その日,ひには、この患難,かんなんの後,のち、日,ひは暗,くらくなり、月,つきはその光,ひかりを放,はなつことをやめ、","tok":[["その"],["日","ひ"],["に"],["は"],["、"],["この"],["患難","かんなん"],["の"],["後","の"],["ち"],["、"],["日","ひ"],["は"],["暗く","くらく"],["なり"],["、"],["月","つき"],["は"],["その"],["光","ひかり"],["を"],["放つ","はなつ"],["こと"],["を"],["やめ"],["、"]]},{"verse":25,"text":"星,ほしは空,そらから落,おち、天体,てんたいは揺,ゆり動,うごかされるであろう。","tok":[["星","ほし"],["は"],["空","そら"],["から"],["落","おち"],["、"],["天体","てんたい"],["は"],["揺り動かされるで","ゆりうごかされるで"],["あろう"],["。"]]},{"verse":26,"text":"そのとき、大,おおいなる力,ちからと栄光,えいこうとをもって、人,ひとの子,こが雲,くもに乗,のって来,くるのを、人々,ひとびとは見,みるであろう。","tok":[["その"],["とき"],["、"],["大いなる","おおいなる"],["力","ちから"],["と"],["栄光","えいこう"],["と"],["を"],["もって"],["、"],["人","ひと"],["の"],["子","こ"],["が"],["雲","くも"],["に"],["乗って","のって"],["来る","くる"],["の"],["を"],["、"],["人々","ひとびと"],["は"],["見るで","みるで"],["あろう"],["。"]]},{"verse":27,"text":"そのとき、彼,かれは御使,みつかいたちをつかわして、地,ちのはてから天,てんのはてまで、四方,しほうからその選民,せんみんを呼,よび集,あつめるであろう。","tok":[["その"],["とき"],["、"],["彼","かれ"],["は"],["御使","みつかいたち"],["を"],["つかわして"],["、"],["地","ち"],["の"],["はて"],["から"],["天","てん"],["の"],["はて"],["まで"],["、"],["四方","しほう"],["から"],["その"],["選民","せんみん"],["を"],["呼び集めるで","よびあつめるで"],["あろう"],["。"]]},{"verse":28,"text":"いちじくの木,きからこの譬,たとえを学,まなびなさい。その枝,えだが柔,やわらかになり、葉,はが出,でるようになると、夏,なつの近,ちかいことがわかる。","tok":[["いちじく"],["の"],["木","き"],["から"],["この"],["譬","たとえ"],["を"],["学び","まなび"],["なさい"],["。"],["その"],["枝","えだ"],["が"],["柔らか","やわらか"],["に"],["なり"],["、"],["葉","は"],["が"],["出る","でる"],["よう"],["に"],["なる"],["と"],["、"],["夏","なつ"],["の"],["近い","ちかい"],["こと"],["が"],["わかる"],["。"]]},{"verse":29,"text":"そのように、これらの事,ことが起,おこるのを見,みたならば、人,ひとの子,こが戸口,とぐちまで近,ちかづいていると知,しりなさい。","tok":[["その"],["よう"],["に"],["、"],["これ"],["ら"],["の"],["事","こと"],["が"],["起こる","おこる"],["の"],["を"],["見たならば","みたならば"],["、"],["人","ひと"],["の"],["子","こ"],["が"],["戸口","とぐち"],["まで"],["近づいて","ちかづいて"],["いる"],["と"],["知り","しり"],["なさい"],["。"]]},{"verse":30,"text":"よく聞,きいておきなさい。これらの事,ことが、ことごとく起,おこるまでは、この時代,じだいは滅,ほろびることがない。","tok":[["よく"],["聞いて","きいて"],["おき"],["なさい"],["。"],["これ"],["ら"],["の"],["事","こと"],["が"],["、"],["ことごとく"],["起こる","おこる"],["まで"],["は"],["、"],["この"],["時代","じだい"],["は"],["滅びる","ほろびる"],["こと"],["が"],["ない"],["。"]]},{"verse":31,"text":"天地,てんちは滅,ほろびるであろう。しかしわたしの言葉,ことばは滅,ほろびることがない。","tok":[["天地","てんち"],["は"],["滅びるで","ほろびるで"],["あろう"],["。"],["しかし"],["わたし"],["の"],["言葉","ことば"],["は"],["滅びる","ほろびる"],["こと"],["が"],["ない"],["。"]]},{"verse":32,"text":"その日,ひ、その時,ときは、だれも知,しらない。天,てんにいる御使,みつかいたちも、また子,こも知,しらない、ただ父,ちちだけが知,しっておられる。","tok":[["その"],["日","ひ"],["、"],["その"],["時","とき"],["は"],["、"],["だれ"],["も"],["知らない","しらない"],["。"],["天","てん"],["に"],["いる"],["御使","みつかいたち"],["も"],["、"],["また子","またこ"],["も"],["知らない","しらない"],["、"],["ただ"],["父","ちち"],["だけ"],["が"],["知って","しって"],["おられる"],["。"]]},{"verse":33,"text":"気,きをつけて、目,めをさましていなさい。その時,ときがいつであるか、あなたがたにはわからないからである。","tok":[["気","き"],["を"],["つけて"],["、"],["目","め"],["を"],["さまして"],["い"],["なさい"],["。"],["その"],["時","とき"],["が"],["いつ"],["で"],["ある"],["か"],["、"],["あなた"],["がた"],["に"],["は"],["わからない"],["から"],["で"],["ある"],["。"]]},{"verse":34,"text":"それはちょうど、旅,たびに立,たつ人,ひとが家,いえを出,でるに当,あたり、その僕,しもべたちに、それぞれ仕事,しごとを割,わり当,あてて責任,せきにんをもたせ、門番,もんばんには目,めをさましておれと、命,めいじるようなものである。","tok":[["それ"],["は"],["ちょうど"],["、"],["旅","たび"],["に"],["立つ","たつ"],["人","ひと"],["が"],["家","いえ"],["を"],["出る","でる"],["に"],["当たり","あたり"],["、"],["その"],["僕","し"],["も"],["べ"],["たち"],["に"],["、"],["それぞれ"],["仕事","しごと"],["を"],["割当てて","わりあてて"],["責任","せきにん"],["を"],["もたせ"],["、"],["門番","もんばん"],["に"],["は"],["目","め"],["を"],["さまして"],["おれ"],["と"],["、"],["命じる","めいじる"],["よう"],["な"],["もの"],["で"],["ある"],["。"]]},{"verse":35,"text":"だから、目,めをさましていなさい。いつ、家,いえの主人,しゅじんが帰,かえって来,くるのか、夕方,ゆうがたか、夜中,よなかか、にわとりの鳴,なくころか、明,あけ方,がたか、わからないからである。","tok":[["だ"],["から"],["、"],["目","め"],["を"],["さまして"],["い"],["なさい"],["。"],["いつ"],["、"],["家","いえ"],["の"],["主人","しゅじん"],["が"],["帰えって","かえって"],["来る","くる"],["の"],["か"],["、"],["夕方","ゆうがた"],["か"],["、"],["夜中","よなか"],["か"],["、"],["にわとり"],["の"],["鳴く","なく"],["ころ"],["か"],["、"],["明け方","あけがた"],["か"],["、"],["わからない"],["から"],["で"],["ある"],["。"]]},{"verse":36,"text":"あるいは急,きゅうに帰,かえってきて、あなたがたの眠,ねむっているところを見,みつけるかも知,しれない。","tok":[["あるいは"],["急","きゅう"],["に"],["帰えって","かえって"],["きて"],["、"],["あなた"],["がた"],["の"],["眠って","ねむって"],["いる"],["ところ"],["を"],["見つける","みつける"],["か"],["も"],["知れない","しれない"],["。"]]},{"verse":37,"text":"目,めをさましていなさい。わたしがあなたがたに言,いうこの言葉,ことばは、すべての人々,ひとびとに言,いうのである」。","tok":[["目","め"],["を"],["さまして"],["い"],["なさい"],["。"],["わたし"],["が"],["あなた"],["がた"],["に"],["言う","いう"],["この"],["言葉","ことば"],["は"],["、"],["すべて"],["の"],["人々","ひとびと"],["に"],["言う","いう"],["ので"],["ある"],["」"],["。"]]}]
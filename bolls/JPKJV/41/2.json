[{"verse":1,"text":"幾日,いくにちかたって、イエスがまたカペナウムにお帰,かえりになったとき、家,いえにおられるといううわさが立,たったので、","tok":[["幾日","い"],["く"],["にち"],["か"],["たって"],["、"],["イエス"],["が"],["また"],["カペナウム"],["に"],["お帰えり","おかえり"],["に"],["なった"],["とき"],["、"],["家","いえ"],["に"],["おられる"],["と"],["いう"],["うわさ"],["が"],["立った","たった"],["ので"],["、"]]},{"verse":2,"text":"多,おおくの人々,ひとびとが集,あつまってきて、もはや戸口,とぐちのあたりまでも、すきまが無,ないほどになった。そして、イエスは御言,みことばを彼,かれらに語,かたっておられた。","tok":[["多く","おおく"],["の"],["人々","ひとびと"],["が"],["集まって","あつまって"],["きて"],["、"],["もはや"],["戸口","とぐち"],["の"],["あたり"],["まで"],["も"],["、"],["すきま"],["が"],["無い","ない"],["ほど"],["に"],["なった"],["。"],["そして"],["、"],["イエス"],["は"],["御言","みこと"],["ば"],["を"],["彼","かれ"],["ら"],["に"],["語って","かたって"],["おられた"],["。"]]},{"verse":3,"text":"すると、人々,ひとびとがひとりの中風,ちゅうぶの者,ものを四人,にんの人,ひとに運,はこばせて、イエスのところに連,つれてきた。","tok":[["する"],["と"],["、"],["人々","ひとびと"],["が"],["ひとり"],["の"],["中風","ちゅうぶ"],["の"],["者","もの"],["を"],["四人","にん"],["の"],["人","ひと"],["に"],["運こばせて","はこばせて"],["、"],["イエス"],["の"],["ところ"],["に"],["連れて","つれて"],["きた"],["。"]]},{"verse":4,"text":"ところが、群衆,ぐんしゅうのために近寄,ちかよることができないので、イエスのおられるあたりの屋根,やねをはぎ、穴,あなをあけて、中風,ちゅうぶの者,ものを寝,ねかせたまま、床,とこをつりおろした。","tok":[["ところ"],["が"],["、"],["群衆","ぐんしゅう"],["の"],["ため"],["に"],["近寄る","ちかよる"],["こと"],["が"],["できない"],["ので"],["、"],["イエス"],["の"],["おられる"],["あたり"],["の"],["屋根","やね"],["を"],["はぎ"],["、"],["穴","あな"],["を"],["あけて"],["、"],["中風","ちゅうぶ"],["の"],["者","もの"],["を"],["寝かせた","ねかせた"],["まま"],["、"],["床","とこ"],["を"],["つりおろした"],["。"]]},{"verse":5,"text":"イエスは彼,かれらの信仰,しんこうを見,みて、中風,ちゅうぶの者,ものに、「子,こよ、あなたの罪,つみはゆるされた」と言,いわれた。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["の"],["信仰","しんこう"],["を"],["見て","みて"],["、"],["中風","ちゅうぶ"],["の"],["者","もの"],["に"],["、"],["「"],["子","こ"],["よ"],["、"],["あなた"],["の"],["罪","つみ"],["は"],["ゆるされた"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":6,"text":"ところが、そこに幾人,いくにんかの律法,りっぽう学者,がくしゃがすわっていて、心,こころの中,なかで論,ろんじた、","tok":[["ところ"],["が"],["、"],["そこ"],["に"],["幾人","いくにん"],["か"],["の"],["律法学者","りっぽうがくしゃ"],["が"],["すわって"],["いて"],["、"],["心","こころ"],["の"],["中","なか"],["で"],["論じた","ろんじた"],["、"]]},{"verse":7,"text":"「この人,ひとは、なぜあんなことを言,いうのか。それは神,かみをけがすことだ。神,かみひとりのほかに、だれが罪,つみをゆるすことができるか」。","tok":[["「"],["この"],["人","ひと"],["は"],["、"],["なぜ"],["あんな"],["こと"],["を"],["言う","いう"],["の"],["か"],["。"],["それ"],["は"],["神","かみ"],["を"],["けがす"],["こと"],["だ"],["。"],["神","かみ"],["ひとり"],["の"],["ほか"],["に"],["、"],["だれ"],["が"],["罪","つみ"],["を"],["ゆるす"],["こと"],["が"],["できる"],["か"],["」"],["。"]]},{"verse":8,"text":"イエスは、彼,かれらが内心,ないしんこのように論,ろんじているのを、自分,じぶんの心,こころですぐ見,みぬいて、「なぜ、あなたがたは心,こころの中,なかでそんなことを論,ろんじているのか。","tok":[["イエス"],["は"],["、"],["彼","かれ"],["ら"],["が"],["内心","ないしん"],["この"],["よう"],["に"],["論じて","ろんじて"],["いる"],["の"],["を"],["、"],["自分","じぶん"],["の"],["心","こころ"],["で"],["すぐ"],["見ぬいて","みぬいて"],["、"],["「"],["なぜ"],["、"],["あなた"],["がた"],["は"],["心","こころ"],["の"],["中","なか"],["で"],["そんな"],["こと"],["を"],["論じて","ろんじて"],["いる"],["の"],["か"],["。"]]},{"verse":9,"text":"中風,ちゅうぶの者,ものに、あなたの罪,つみはゆるされた、と言,いうのと、起,おきよ、床,とこを取,とりあげて歩,あるけ、と言,いうのと、どちらがたやすいか。","tok":[["中風","ちゅうぶ"],["の"],["者","もの"],["に"],["、"],["あなた"],["の"],["罪","つみ"],["は"],["ゆるされた"],["、"],["と"],["言う","いう"],["の"],["と"],["、"],["起きよ","おきよ"],["、"],["床","とこ"],["を"],["取","とり"],["あげて"],["歩け","あるけ"],["、"],["と"],["言う","いう"],["の"],["と"],["、"],["どちら"],["が"],["たやすい"],["か"],["。"]]},{"verse":10,"text":"しかし、人,ひとの子,こは地上,ちじょうで罪,つみをゆるす権威,けんいをもっていることが、あなたがたにわかるために」と彼,かれらに言,いい、中風,ちゅうぶの者,ものにむかって、","tok":[["しかし"],["、"],["人","ひと"],["の"],["子","こ"],["は"],["地上","ちじょう"],["で"],["罪","つみ"],["を"],["ゆるす"],["権威","けんい"],["を"],["もって"],["いる"],["こと"],["が"],["、"],["あなた"],["がた"],["に"],["わかる"],["ため"],["に"],["」"],["と"],["彼","かれ"],["ら"],["に"],["言い","いい"],["、"],["中風","ちゅうぶ"],["の"],["者","もの"],["に"],["むかって"],["、"]]},{"verse":11,"text":"「あなたに命,めいじる。起,おきよ、床,とこを取,とりあげて家,いえに帰,かえれ」と言,いわれた。","tok":[["「"],["あなた"],["に"],["命じる","めいじる"],["。"],["起きよ","おきよ"],["、"],["床","とこ"],["を"],["取","とり"],["あげて"],["家","いえ"],["に"],["帰えれ","かえれ"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":12,"text":"すると彼,かれは起,おきあがり、すぐに床,とこを取,とりあげて、みんなの前,まえを出,でて行,いったので、一同,いちどうは大,おおいに驚,おどろき、神,かみをあがめて、「こんな事,ことは、まだ一度,ども見,みたことがない」と言,いった。","tok":[["する"],["と"],["彼","かれ"],["は"],["起きあがり","おきあがり"],["、"],["すぐ"],["に"],["床","とこ"],["を"],["取","とり"],["あげて"],["、"],["みんな"],["の"],["前","まえ"],["を"],["出て","でて"],["行った","いった"],["ので"],["、"],["一同","いちどう"],["は"],["大いに","おおいに"],["驚","おどろき"],["、"],["神","かみ"],["を"],["あがめて"],["、"],["「"],["こんな"],["事","こと"],["は"],["、"],["まだ"],["一度","ど"],["も"],["見た","みた"],["こと"],["が"],["ない"],["」"],["と"],["言った","いった"],["。"]]},{"verse":13,"text":"イエスはまた海,うみべに出,でて行,いかれると、多,おおくの人々,ひとびとがみもとに集,あつまってきたので、彼,かれらを教,おしえられた。","tok":[["イエス"],["は"],["また"],["海べ","うみべ"],["に"],["出て","でて"],["行かれる","いかれる"],["と"],["、"],["多く","おおく"],["の"],["人々","ひとびと"],["が"],["みもと"],["に"],["集まって","あつまって"],["きた"],["ので"],["、"],["彼","かれ"],["ら"],["を"],["教えられた","おしえられた"],["。"]]},{"verse":14,"text":"また途中,とちゅうで、アルパヨの子,こレビが収税所,しゅうぜいしょにすわっているのをごらんになって、「わたしに従,したがってきなさい」と言,いわれた。すると彼,かれは立,たちあがって、イエスに従,したがった。","tok":[["また"],["途中","とちゅう"],["で"],["、"],["アルパヨ"],["の"],["子","こ"],["レビ"],["が"],["収税所","しゅうぜいしょ"],["に"],["すわって"],["いる"],["の"],["を"],["ごらん"],["に"],["なって"],["、"],["「"],["わたし"],["に"],["従って","したがって"],["き"],["なさい"],["」"],["と"],["言われた","いわれた"],["。"],["する"],["と"],["彼","かれ"],["は"],["立ちあがって","たちあがって"],["、"],["イエス"],["に"],["従った","したがった"],["。"]]},{"verse":15,"text":"それから彼,かれの家,いえで、食事,しょくじの席,せきについておられたときのことである。多,おおくの取税人,しゅぜいにんや罪人,つみびとたちも、イエスや弟子,でしたちと共,ともにその席,せきに着,ついていた。こんな人,ひとたちが大,おおぜいいて、イエスに従,したがってきたのである。","tok":[["それ"],["から"],["彼","かれ"],["の"],["家","いえ"],["で"],["、"],["食事","しょくじ"],["の"],["席","せき"],["について"],["おられた"],["とき"],["の"],["こと"],["で"],["ある"],["。"],["多く","おおく"],["の"],["取","とり"],["税人","ぜいにん"],["ぜ"],["い"],["に"],["ん"],["や"],["罪人","つみびとたち"],["も"],["、"],["イエス"],["や"],["弟子","でし"],["たち"],["と"],["共","とも"],["に"],["その"],["席","せき"],["に"],["着いて","ついて"],["いた"],["。"],["こんな"],["人","ひと"],["たち"],["が"],["大ぜい","おおぜい"],["いて"],["、"],["イエス"],["に"],["従って","したがって"],["きた"],["ので"],["ある"],["。"]]},{"verse":16,"text":"パリサイ派,はの律法,りっぽう学者,がくしゃたちは、イエスが罪人,つみびとや取税人,しゅぜいにんたちと食事,しょくじを共,ともにしておられるのを見,みて、弟子,でしたちに言,いった、「なぜ、彼,かれは取税人,しゅぜいにんや罪人,つみびとなどと食事,しょくじを共,ともにするのか」。","tok":[["パリサイ"],["派","は"],["の"],["律法学者","りっぽうがくしゃ"],["たち"],["は"],["、"],["イエス"],["が"],["罪人","つみび"],["と"],["や"],["取","とり"],["税人","ぜいにん"],["たち"],["と"],["食事","しょくじ"],["を"],["共","とも"],["に"],["して"],["おられる"],["の"],["を"],["見て","みて"],["、"],["弟子","でし"],["たち"],["に"],["言った","いった"],["、"],["「"],["なぜ"],["、"],["彼","かれ"],["は"],["取","とり"],["税人","ぜいにん"],["ぜ"],["い"],["に"],["ん"],["や"],["罪人","つみび"],["と"],["など"],["と"],["食事","しょくじ"],["を"],["共","とも"],["に"],["する"],["の"],["か"],["」"],["。"]]},{"verse":17,"text":"イエスはこれを聞,きいて言,いわれた、「丈夫,じょうぶな人,ひとには医者,いしゃはいらない。いるのは病人,びょうにんである。わたしがきたのは、義人,ぎじんを招,まねくためではなく、罪人,つみびとを招,まねくためである」。","tok":[["イエス"],["は"],["これ"],["を"],["聞いて","きいて"],["言われた","いわれた"],["、"],["「"],["丈夫","じょうぶ"],["な"],["人","ひと"],["に"],["は"],["医者","いしゃ"],["は"],["いらない"],["。"],["いる"],["の"],["は"],["病人","びょうにん"],["で"],["ある"],["。"],["わたし"],["が"],["きた"],["の"],["は"],["、"],["義人","ぎじん"],["を"],["招く","まねく"],["ため"],["で"],["は"],["なく"],["、"],["罪人","つみびと"],["を"],["招く","まねく"],["ため"],["で"],["ある"],["」"],["。"]]},{"verse":18,"text":"ヨハネの弟子,でしとパリサイ人,びととは、断食,だんじきをしていた。そこで人々,ひとびとがきて、イエスに言,いった、「ヨハネの弟子,でしたちとパリサイ人,びとの弟子,でしたちとが断食,だんじきをしているのに、あなたの弟子,でしたちは、なぜ断食,だんじきをしないのですか」。","tok":[["ヨハネ"],["の"],["弟子","でし"],["と"],["パリサイ"],["人","びとと"],["は"],["、"],["断食","だんじき"],["を"],["して"],["いた"],["。"],["そこ"],["で"],["人々","ひとびと"],["が"],["きて"],["、"],["イエス"],["に"],["言った","いった"],["、"],["「"],["ヨハネ"],["の"],["弟子","でし"],["たち"],["と"],["パリサイ"],["人","びと"],["の"],["弟子","でし"],["たち"],["と"],["が"],["断食","だんじき"],["を"],["して"],["いる"],["のに"],["、"],["あなた"],["の"],["弟子","でし"],["たち"],["は"],["、"],["なぜ"],["断食","だんじき"],["を"],["しない"],["の"],["です"],["か"],["」"],["。"]]},{"verse":19,"text":"するとイエスは言,いわれた、「婚礼,こんれいの客,きゃくは、花婿,はなむこが一緒,いっしょにいるのに、断食,だんじきができるであろうか。花婿,はなむこと一緒,いっしょにいる間,あいだは、断食,だんじきはできない。","tok":[["する"],["と"],["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["婚礼","こんれい"],["の"],["客","きゃく"],["は"],["、"],["花婿","はなむこ"],["が"],["一緒","いっしょ"],["に"],["いる"],["のに"],["、"],["断食","だんじき"],["が"],["できるで"],["あろう"],["か"],["。"],["花婿","はなむこ"],["と"],["一緒","いっしょ"],["に"],["いる"],["間","あいだ"],["は"],["、"],["断食","だんじき"],["は"],["できない"],["。"]]},{"verse":20,"text":"しかし、花婿,はなむこが奪,うばい去,さられる日,ひが来,くる。その日,ひには断食,だんじきをするであろう。","tok":[["しかし"],["、"],["花婿","はなむこ"],["が"],["奪い去られる","うばいさられる"],["日","ひ"],["が"],["来る","くる"],["。"],["その"],["日","ひ"],["に"],["は"],["断食","だんじき"],["を"],["するで"],["あろう"],["。"]]},{"verse":21,"text":"だれも、真新,まあたらしい布,ぬのぎれを、古,ふるい着物,きものに縫,ぬいつけはしない。もしそうすれば、新,あたらしいつぎは古,ふるい着物,きものを引,ひき破,やぶり、そして、破,やぶれがもっとひどくなる。","tok":[["だれ"],["も"],["、"],["真","ま"],["新らしい","あたらしい"],["布ぎれ","ぬのぎれ"],["を"],["、"],["古い","ふるい"],["着物","きもの"],["に"],["縫","ぬい"],["つけ"],["は"],["しない"],["。"],["もし"],["そう"],["すれば"],["、"],["新らしい","あたらしい"],["つぎ"],["は"],["古い","ふるい"],["着物","きもの"],["を"],["引","ひき"],["破り","やぶり"],["、"],["そして"],["、"],["破れ","やぶれ"],["が"],["もっと"],["ひどく"],["なる"],["。"]]},{"verse":22,"text":"まただれも、新,あたらしいぶどう酒,しゅを古,ふるい皮,かわ袋,ぶくろに入,いれはしない。もしそうすれば、ぶどう酒,しゅは皮,かわ袋,ぶくろをはり裂,さき、そして、ぶどう酒,しゅも皮,かわ袋,ぶくろもむだになってしまう。〔だから、新,あたらしいぶどう酒,しゅは新,あたらしい皮,かわ袋,ぶくろに入,いれるべきである〕」。","tok":[["また"],["だれ"],["も"],["、"],["新らしい","あたらしい"],["ぶどう酒","ぶどうしゅ"],["を"],["古い","ふるい"],["皮袋","かわぶくろ"],["に"],["入れ","いれ"],["は"],["しない"],["。"],["もし"],["そう"],["すれば"],["、"],["ぶどう酒","ぶどうしゅ"],["は"],["皮袋","かわぶくろ"],["を"],["はり"],["裂き","さき"],["、"],["そして"],["、"],["ぶどう酒","ぶどうしゅ"],["も"],["皮袋","かわぶくろ"],["も"],["むだ"],["に"],["なって"],["しまう"],["。"],["〔"],["だ"],["から"],["、"],["新らしい","あたらしい"],["ぶどう酒","ぶどうしゅ"],["は"],["新らしい","あたらしい"],["皮袋","かわぶくろ"],["に"],["入れるべきで","いれるべきで"],["ある"],["〕"],["」"],["。"]]},{"verse":23,"text":"ある安息日,あんそくにちに、イエスは麦畑,むぎばたけの中,なかをとおって行,いかれた。そのとき弟子,でしたちが、歩,あるきながら穂,ほをつみはじめた。","tok":[["ある"],["安息日","あんそくにち"],["に"],["、"],["イエス"],["は"],["麦畑","むぎばたけ"],["の"],["中","なか"],["を"],["とおって"],["行かれた","いかれた"],["。"],["その"],["とき"],["弟子","でし"],["たち"],["が"],["、"],["歩き","あるき"],["ながら"],["穂","ほ"],["を"],["つみ"],["はじめた"],["。"]]},{"verse":24,"text":"すると、パリサイ人,びとたちがイエスに言,いった、「いったい、彼,かれらはなぜ、安息日,あんそくにちにしてはならぬことをするのですか」。","tok":[["する"],["と"],["、"],["パリサイ"],["人","びと"],["たち"],["が"],["イエス"],["に"],["言った","いった"],["、"],["「"],["いったい"],["、"],["彼","かれ"],["ら"],["は"],["なぜ"],["、"],["安息日","あんそくにち"],["に"],["して"],["は"],["ならぬ"],["こと"],["を"],["する"],["の"],["です"],["か"],["」"],["。"]]},{"verse":25,"text":"そこで彼,かれらに言,いわれた、「あなたがたは、ダビデとその供,ともの者,ものたちとが食物,しょくもつがなくて飢,うえたとき、ダビデが何,なにをしたか、まだ読,よんだことがないのか。","tok":[["そこ"],["で"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["がた"],["は"],["、"],["ダビデ"],["と"],["その"],["供","とも"],["の"],["者","もの"],["たち"],["と"],["が"],["食物","しょくもつ"],["が"],["なくて"],["飢","うえ"],["た"],["とき"],["、"],["ダビデ"],["が"],["何に","なに"],["を"],["した"],["か"],["、"],["まだ"],["読","よんだこ"],["と"],["が"],["ない"],["の"],["か"],["。"]]},{"verse":26,"text":"すなわち、大祭司,だいさいしアビアタルの時,とき、神,かみの家,いえにはいって、祭司,さいしたちのほか食,たべてはならぬ供,そなえのパンを、自分,じぶんも食,たべ、また供,ともの者,ものたちにも与,あたえたではないか」。","tok":[["すなわち"],["、"],["大","だい"],["祭司","さいし"],["アビアタル"],["の"],["時","とき"],["、"],["神","かみ"],["の"],["家","いえ"],["に"],["はいって"],["、"],["祭司","さいし"],["たち"],["の"],["ほか"],["食べて","たべて"],["は"],["ならぬ"],["供え","そなえ"],["の"],["パン"],["を"],["、"],["自分","じぶん"],["も"],["食べ","たべ"],["、"],["また"],["供","とも"],["の"],["者","もの"],["たち"],["に"],["も"],["与","あたえ"],["たで"],["は"],["ない"],["か"],["」"],["。"]]},{"verse":27,"text":"また彼,かれらに言,いわれた、「安息日,あんそくにちは人,ひとのためにあるもので、人,ひとが安息日,あんそくにちのためにあるのではない。","tok":[["また"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["安息日","あんそくにち"],["は"],["人","ひと"],["の"],["ため"],["に"],["ある"],["もの"],["で"],["、"],["人","ひと"],["が"],["安息日","あんそくにち"],["の"],["ため"],["に"],["ある"],["ので"],["は"],["ない"],["。"]]},{"verse":28,"text":"それだから、人,ひとの子,こは、安息日,あんそくにちにもまた主,しゅなのである」。","tok":[["それ"],["だ"],["から"],["、"],["人","ひと"],["の"],["子","こ"],["は"],["、"],["安息日","あんそくにち"],["に"],["も"],["また"],["主","しゅな"],["ので"],["ある"],["」"],["。"]]}]
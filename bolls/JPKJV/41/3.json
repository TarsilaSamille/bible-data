[{"verse":1,"text":"イエスがまた会堂,かいどうにはいられると、そこに片手,かたてのなえた人,ひとがいた。","tok":[["イエス"],["が"],["また"],["会堂","かいどう"],["に"],["は"],["いられる"],["と"],["、"],["そこ"],["に"],["片手","かたて"],["の"],["なえた"],["人","ひと"],["が"],["いた"],["。"]]},{"verse":2,"text":"人々,ひとびとはイエスを訴,うったえようと思,おもって、安息日,あんそくにちにその人,ひとをいやされるかどうかをうかがっていた。","tok":[["人々","ひとびと"],["は"],["イエス"],["を"],["訴よう","うったえよう"],["と"],["思って","おもって"],["、"],["安息日","あんそくにち"],["に"],["その"],["人","ひと"],["を"],["いやされる"],["か"],["どう"],["か"],["を"],["うかがって"],["いた"],["。"]]},{"verse":3,"text":"すると、イエスは片手,かたてのなえたその人,ひとに、「立,たって、中,なかへ出,でてきなさい」と言,いい、","tok":[["する"],["と"],["、"],["イエス"],["は"],["片手","かたて"],["の"],["なえた"],["その"],["人","ひと"],["に"],["、"],["「"],["立って","たって"],["、"],["中","なか"],["へ"],["出て","でて"],["き"],["なさい"],["」"],["と"],["言い","いい"],["、"]]},{"verse":4,"text":"人々,ひとびとにむかって、「安息日,あんそくにちに善,ぜんを行,おこなうのと悪,あくを行,おこなうのと、命,いのちを救,すくうのと殺,ころすのと、どちらがよいか」と言,いわれた。彼,かれらは黙,だまっていた。","tok":[["人々","ひとびと"],["に"],["むかって"],["、"],["「"],["安息日","あんそくにち"],["に"],["善","ぜん"],["を"],["行なう","おこなう"],["の"],["と"],["悪","あく"],["を"],["行なう","おこなう"],["の"],["と"],["、"],["命","いのち"],["を"],["救う","すくう"],["の"],["と"],["殺ろす","ころす"],["の"],["と"],["、"],["どちら"],["が"],["よい"],["か"],["」"],["と"],["言われた","いわれた"],["。"],["彼","かれ"],["ら"],["は"],["黙って","だまって"],["いた"],["。"]]},{"verse":5,"text":"イエスは怒,いかりを含,ふくんで彼,かれらを見,みまわし、その心,こころのかたくななのを嘆,なげいて、その人,ひとに「手,てを伸,のばしなさい」と言,いわれた。そこで手,てを伸,のばすと、その手,ては元,もとどおりになった。","tok":[["イエス"],["は"],["怒り","いかり"],["を"],["含んで","ふくんで"],["彼","かれ"],["ら"],["を"],["見まわし","みまわし"],["、"],["その"],["心","こころ"],["の"],["かたくな"],["な"],["の"],["を"],["嘆いて","なげいて"],["、"],["その"],["人","ひと"],["に"],["「"],["手","て"],["を"],["伸ばし","のばし"],["なさい"],["」"],["と"],["言われた","いわれた"],["。"],["そこ"],["で"],["手","て"],["を"],["伸ばす","のばす"],["と"],["、"],["その"],["手","て"],["は"],["元どおり","もとどおり"],["に"],["なった"],["。"]]},{"verse":6,"text":"パリサイ人,びとたちは出,でて行,いって、すぐにヘロデ党,とうの者,ものたちと、なんとかしてイエスを殺,ころそうと相談,そうだんしはじめた。","tok":[["パリサイ"],["人","びとたち"],["は"],["出て","でて"],["行って","いって"],["、"],["すぐ"],["に"],["ヘロデ党","へろでとう"],["の"],["者","もの"],["たち"],["と"],["、"],["なん"],["と"],["か"],["して"],["イエス"],["を"],["殺そう","ころそう"],["と"],["相談","そうだん"],["し"],["はじめた"],["。"]]},{"verse":7,"text":"それから、イエスは弟子,でしたちと共,ともに海,うみべに退,しりぞかれたが、ガリラヤからきたおびただしい群衆,ぐんしゅうがついて行,いった。またユダヤから、","tok":[["それ"],["から"],["、"],["イエス"],["は"],["弟子","でし"],["たち"],["と"],["共","とも"],["に"],["海べ","うみべ"],["に"],["退ぞかれた","しりぞかれた"],["が"],["、"],["ガリラヤ"],["から"],["きた"],["おびただしい"],["群衆","ぐんしゅう"],["が"],["ついて"],["行った","いった"],["。"],["また"],["ユダヤ"],["から"],["、"]]},{"verse":8,"text":"エルサレムから、イドマヤから、更,さらにヨルダンの向,むこうから、ツロ、シドンのあたりからも、おびただしい群衆,ぐんしゅうが、そのなさっていることを聞,きいて、みもとにきた。","tok":[["エルサレム"],["から"],["、"],["イドマヤ"],["から"],["、"],["更に","さらに"],["ヨルダン"],["の"],["向こう","むこう"],["から"],["、"],["ツロ"],["、"],["シドン"],["の"],["あたり"],["から"],["も"],["、"],["おびただしい"],["群衆","ぐんしゅう"],["が"],["、"],["その"],["なさって"],["いる"],["こと"],["を"],["聞いて","きいて"],["、"],["みもと"],["に"],["きた"],["。"]]},{"verse":9,"text":"イエスは群衆,ぐんしゅうが自分,じぶんに押,おし迫,せまるのを避,さけるために、小舟,こぶねを用意,よういしておけと、弟子,でしたちに命,めいじられた。","tok":[["イエス"],["は"],["群衆","ぐんしゅう"],["が"],["自分","じぶん"],["に"],["押","おし"],["迫まる","せまる"],["の"],["を"],["避ける","さける"],["ため"],["に"],["、"],["小舟","こぶね"],["を"],["用意","ようい"],["して"],["おけ"],["と"],["、"],["弟子","でし"],["たち"],["に"],["命じられた","めいじられた"],["。"]]},{"verse":10,"text":"それは、多,おおくの人,ひとをいやされたので、病苦,びょうくに悩,なやむ者,ものは皆,みなイエスにさわろうとして、押,おし寄,よせてきたからである。","tok":[["それ"],["は"],["、"],["多く","おおく"],["の"],["人","ひと"],["を"],["いやされた"],["ので"],["、"],["病苦","びょうく"],["に"],["悩む","なやむ"],["者","もの"],["は"],["皆","みな"],["イエス"],["に"],["さわろう"],["として"],["、"],["押寄せて","おしよせて"],["きた"],["から"],["で"],["ある"],["。"]]},{"verse":11,"text":"また、けがれた霊,れいどもはイエスを見,みるごとに、みまえにひれ伏,ふし、叫,さけんで、「あなたこそ神,かみの子,こです」と言,いった。","tok":[["また"],["、"],["けがれた"],["霊","れい"],["ども"],["は"],["イエス"],["を"],["見る","みる"],["ごと"],["に"],["、"],["みまえ"],["に"],["ひれ伏し","ひれふし"],["、"],["叫けんで","さけんで"],["、"],["「"],["あなた"],["こそ"],["神","かみ"],["の"],["子","こ"],["です"],["」"],["と"],["言った","いった"],["。"]]},{"verse":12,"text":"イエスは御,ご自身,じしんのことを人,ひとにあらわさないようにと、彼,かれらをきびしく戒,いましめられた。","tok":[["イエス"],["は"],["御自身","ごじしん"],["の"],["こと"],["を"],["人","ひと"],["に"],["あらわさない"],["よう"],["に"],["と"],["、"],["彼","かれ"],["ら"],["を"],["きびしく"],["戒しめ","いましめ"],["られた"],["。"]]},{"verse":13,"text":"さてイエスは山,やまに登,のぼり、みこころにかなった者,ものたちを呼,よび寄,よせられたので、彼,かれらはみもとにきた。","tok":[["さて"],["イエス"],["は"],["山","やま"],["に"],["登り","のぼり"],["、"],["みこころ"],["に"],["かなった"],["者","もの"],["たち"],["を"],["呼び寄せられた","よびよせられた"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["みもと"],["に"],["きた"],["。"]]},{"verse":14,"text":"そこで十二人,にんをお立,たてになった。彼,かれらを自分,じぶんのそばに置,おくためであり、さらに宣教,せんきょうにつかわし、","tok":[["そこ"],["で"],["十二人","にん"],["を"],["お立","おたて"],["に"],["なった"],["。"],["彼","かれ"],["ら"],["を"],["自分","じぶん"],["の"],["そば"],["に"],["置く","おく"],["ため"],["で"],["あり"],["、"],["さらに"],["宣教","せんきょう"],["に"],["つかわし"],["、"]]},{"verse":15,"text":"また悪霊,あくれいを追,おい出,だす権威,けんいを持,もたせるためであった。","tok":[["また"],["悪霊","あくれい"],["を"],["追い出す","おいだす"],["権威","けんい"],["を"],["持たせる","もたせる"],["ため"],["で"],["あった"],["。"]]},{"verse":16,"text":"こうして、この十二人,にんをお立,たてになった。そしてシモンにペテロという名,なをつけ、","tok":[["こう"],["して"],["、"],["この"],["十二人","にん"],["を"],["お立","おたて"],["に"],["なった"],["。"],["そして"],["シモン"],["に"],["ペテロ"],["と"],["いう"],["名","な"],["を"],["つけ"],["、"]]},{"verse":17,"text":"またゼベダイの子,こヤコブと、ヤコブの兄弟,きょうだいヨハネ、彼,かれらにはボアネルゲ、すなわち、雷,かみなりの子,こという名,なをつけられた。","tok":[["また"],["ゼベダイ"],["の"],["子","こ"],["ヤコブ"],["と"],["、"],["ヤコブ"],["の"],["兄弟","きょうだい"],["ヨハネ"],["、"],["彼","かれ"],["ら"],["に"],["は"],["ボアネルゲ"],["、"],["すなわち"],["、"],["雷","かみなり"],["の"],["子","こ"],["と"],["いう"],["名","な"],["を"],["つけられた"],["。"]]},{"verse":18,"text":"つぎにアンデレ、ピリポ、バルトロマイ、マタイ、トマス、アルパヨの子,こヤコブ、タダイ、熱心,ねっしん党,とうのシモン、","tok":[["つぎ"],["に"],["アンデレ"],["、"],["ピリポ"],["、"],["バルトロマイ"],["、"],["マタイ"],["、"],["トマス"],["、"],["アルパヨ"],["の"],["子","こ"],["ヤコブ"],["、"],["タダイ"],["、"],["熱心","ねっしん"],["党","とう"],["の"],["シモン"],["、"]]},{"verse":19,"text":"それからイスカリオテのユダ。このユダがイエスを裏切,うらぎったのである。イエスが家,いえにはいられると、","tok":[["それ"],["から"],["イスカリオテ"],["の"],["ユダ"],["。"],["この"],["ユダ"],["が"],["イエス"],["を"],["裏切った","うらぎった"],["ので"],["ある"],["。"],["イエス"],["が"],["家","いえ"],["に"],["は"],["いられる"],["と"],["、"]]},{"verse":20,"text":"群衆,ぐんしゅうがまた集,あつまってきたので、一同,いちどうは食事,しょくじをする暇,ひまもないほどであった。","tok":[["群衆","ぐんしゅう"],["が"],["また"],["集まって","あつまって"],["きた"],["ので"],["、"],["一同","いちどう"],["は"],["食事","しょくじ"],["を"],["する"],["暇","ひま"],["も"],["ない"],["ほど"],["で"],["あった"],["。"]]},{"verse":21,"text":"身内,みうちの者,ものたちはこの事,ことを聞,きいて、イエスを取押,とりおさえに出,でてきた。気,きが狂,くるったと思,おもったからである。","tok":[["身内","みうち"],["の"],["者","もの"],["たち"],["は"],["この"],["事","こと"],["を"],["聞いて","きいて"],["、"],["イエス"],["を"],["取押さえ","とりおさえ"],["に"],["出て","でて"],["きた"],["。"],["気","き"],["が"],["狂った","くるった"],["と"],["思った","おもった"],["から"],["で"],["ある"],["。"]]},{"verse":22,"text":"また、エルサレムから下,くだってきた律法,りっぽう学者,がくしゃたちも、「彼,かれはベルゼブルにとりつかれている」と言,いい、「悪霊,あくれいどものかしらによって、悪霊,あくれいどもを追,おい出,だしているのだ」とも言,いった。","tok":[["また"],["、"],["エルサレム"],["から"],["下って","くだって"],["きた"],["律法学者","りっぽうがくしゃ"],["たち"],["も"],["、"],["「"],["彼","かれ"],["は"],["ベルゼブル"],["に"],["とりつかれて"],["いる"],["」"],["と"],["言い","いい"],["、"],["「"],["悪霊","あくれいども"],["の"],["かしら"],["によって"],["、"],["悪霊","あくれいども"],["を"],["追い出して","おいだして"],["いる"],["の"],["だ"],["」"],["と"],["も"],["言った","いった"],["。"]]},{"verse":23,"text":"そこでイエスは彼,かれらを呼,よび寄,よせ、譬,たとえをもって言,いわれた、「どうして、サタンがサタンを追,おい出,だすことができようか。","tok":[["そこ"],["で"],["イエス"],["は"],["彼","かれ"],["ら"],["を"],["呼び寄せ","よびよせ"],["、"],["譬","たとえ"],["を"],["もって"],["言われた","いわれた"],["、"],["「"],["どう"],["して"],["、"],["サタン"],["が"],["サタン"],["を"],["追い出す","おいだす"],["こと"],["が"],["できよう"],["か"],["。"]]},{"verse":24,"text":"もし国,くにが内部,ないぶで分,わかれ争,あらそうなら、その国,くには立,たち行,いかない。","tok":[["もし"],["国","くに"],["が"],["内部","ないぶ"],["で"],["分かれ","わかれ"],["争うなら","あらそうなら"],["、"],["その"],["国","くに"],["は"],["立ち行かない","たちいかない"],["。"]]},{"verse":25,"text":"また、もし家,いえが内,うちわで分,わかれ争,あらそうなら、その家,いえは立,たち行,いかないであろう。","tok":[["また"],["、"],["もし"],["家","いえ"],["が"],["内","うち"],["わ"],["で"],["分かれ","わかれ"],["争うなら","あらそうなら"],["、"],["その"],["家","いえ"],["は"],["立ち行かないで","たちいかないで"],["あろう"],["。"]]},{"verse":26,"text":"もしサタンが内部,ないぶで対立,たいりつし分争,ぶんそうするなら、彼,かれは立,たち行,いけず、滅,ほろんでしまう。","tok":[["もし"],["サタン"],["が"],["内部","ないぶ"],["で"],["対立","たいりつ"],["し"],["分争","ぶんそう"],["するなら"],["、"],["彼","かれ"],["は"],["立ち","たち"],["行けず","いけず"],["、"],["滅","ほ"],["ろん"],["で"],["しまう"],["。"]]},{"verse":27,"text":"だれでも、まず強,つよい人,ひとを縛,しばりあげなければ、その人,ひとの家,いえに押,おし入,いって家財,かざいを奪,うばい取,とることはできない。縛,しばってからはじめて、その家,いえを略奪,りゃくだつすることができる。","tok":[["だれ"],["で"],["も"],["、"],["まず"],["強い","つよい"],["人","ひと"],["を"],["縛りあげなければ","しばりあげなければ"],["、"],["その"],["人","ひと"],["の"],["家","いえ"],["に"],["押入って","おしいって"],["家財","かざい"],["を"],["奪い取る","うばいとる"],["こと"],["は"],["できない"],["。"],["縛って","しばって"],["から"],["はじめて"],["、"],["その"],["家","いえ"],["を"],["略奪","りゃくだつ"],["する"],["こと"],["が"],["できる"],["。"]]},{"verse":28,"text":"よく言,いい聞,きかせておくが、人,ひとの子,こらには、その犯,おかすすべての罪,つみも神,かみをけがす言葉,ことばも、ゆるされる。","tok":[["よく"],["言い聞かせて","いいきかせて"],["おく"],["が"],["、"],["人","ひと"],["の"],["子","こ"],["ら"],["に"],["は"],["、"],["その"],["犯す","おかす"],["すべて"],["の"],["罪","つみ"],["も"],["神","かみ"],["を"],["けがす"],["言葉","ことば"],["も"],["、"],["ゆるされる"],["。"]]},{"verse":29,"text":"しかし、聖霊,せいれいをけがす者,ものは、いつまでもゆるされず、永遠,えいえんの罪,つみに定,さだめられる」。","tok":[["しかし"],["、"],["聖霊","せいれい"],["を"],["けがす"],["者","もの"],["は"],["、"],["いつ"],["まで"],["も"],["ゆるされず"],["、"],["永遠","えいえん"],["の"],["罪","つみ"],["に"],["定められる","さだめられる"],["」"],["。"]]},{"verse":30,"text":"そう言,いわれたのは、彼,かれらが「イエスはけがれた霊,れいにつかれている」と言,いっていたからである。","tok":[["そう"],["言われた","いわれた"],["の"],["は"],["、"],["彼","かれ"],["ら"],["が"],["「"],["イエス"],["は"],["けがれた"],["霊","れい"],["に"],["つかれて"],["いる"],["」"],["と"],["言って","いって"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":31,"text":"さて、イエスの母,ははと兄弟,きょうだいたちとがきて、外,そとに立,たち、人,ひとをやってイエスを呼,よばせた。","tok":[["さて"],["、"],["イエス"],["の"],["母","はは"],["と"],["兄弟","きょうだい"],["たち"],["と"],["が"],["きて"],["、"],["外","そと"],["に"],["立ち","たち"],["、"],["人","ひと"],["を"],["やって"],["イエス"],["を"],["呼ばせた","よばせた"],["。"]]},{"verse":32,"text":"ときに、群衆,ぐんしゅうはイエスを囲,かこんですわっていたが、「ごらんなさい。あなたの母上,ははうえと兄弟,きょうだい、姉妹,しまいたちが、外,そとであなたを尋,たずねておられます」と言,いった。","tok":[["とき"],["に"],["、"],["群衆","ぐんしゅう"],["は"],["イエス"],["を"],["囲んで","かこんで"],["すわって"],["いた"],["が"],["、"],["「"],["ごらん"],["なさい"],["。"],["あなた"],["の"],["母","はは"],["上","うえ"],["と"],["兄弟","きょうだい"],["、"],["姉妹","しまい"],["たち"],["が"],["、"],["外","そと"],["で"],["あなた"],["を"],["尋ねて","たずねて"],["おられます"],["」"],["と"],["言った","いった"],["。"]]},{"verse":33,"text":"すると、イエスは彼,かれらに答,こたえて言,いわれた、「わたしの母,はは、わたしの兄弟,きょうだいとは、だれのことか」。","tok":[["する"],["と"],["、"],["イエス"],["は"],["彼","かれ"],["ら"],["に"],["答","こたえ"],["て"],["言われた","いわれた"],["、"],["「"],["わたし"],["の"],["母","はは"],["、"],["わたし"],["の"],["兄弟","きょうだい"],["と"],["は"],["、"],["だれ"],["の"],["こと"],["か"],["」"],["。"]]},{"verse":34,"text":"そして、自分,じぶんをとりかこんで、すわっている人々,ひとびとを見,みまわして、言,いわれた、「ごらんなさい、ここにわたしの母,はは、わたしの兄弟,きょうだいがいる。","tok":[["そして"],["、"],["自分","じぶん"],["を"],["とりかこんで"],["、"],["すわって"],["いる"],["人々","ひとびと"],["を"],["見まわして","みまわして"],["、"],["言われた","いわれた"],["、"],["「"],["ごらん"],["なさい"],["、"],["ここ"],["に"],["わたし"],["の"],["母","はは"],["、"],["わたし"],["の"],["兄弟","きょうだい"],["が"],["いる"],["。"]]},{"verse":35,"text":"神,かみのみこころを行,おこなう者,ものはだれでも、わたしの兄弟,きょうだい、また姉妹,しまい、また母,ははなのである」。","tok":[["神","かみ"],["のみ"],["こころ"],["を"],["行なう","おこなう"],["者","もの"],["は"],["だれ"],["で"],["も"],["、"],["わたし"],["の"],["兄弟","きょうだい"],["、"],["また"],["姉妹","しまい"],["、"],["また"],["母","はは"],["な"],["ので"],["ある"],["」"],["。"]]}]
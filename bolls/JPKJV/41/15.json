[{"verse":1,"text":"夜,よが明,あけるとすぐ、祭司長,さいしちょうたちは長老,ちょうろう、律法,りっぽう学者,がくしゃたち、および全,ぜん議会,ぎかいと協議,きょうぎをこらした末,すえ、イエスを縛,しばって引,ひき出,だし、ピラトに渡,わたした。","tok":[["夜","よ"],["が"],["明ける","あける"],["と"],["すぐ"],["、"],["祭司長","さいしちょう"],["たち"],["は"],["長老","ちょうろう"],["、"],["律法学者","りっぽうがくしゃ"],["たち"],["、"],["および"],["全","ぜん"],["議会","ぎかい"],["と"],["協議","きょうぎ"],["を"],["こらした"],["末","すえ"],["、"],["イエス"],["を"],["縛って","しばって"],["引出し","ひきだし"],["、"],["ピラト"],["に"],["渡","わたし"],["た"],["。"]]},{"verse":2,"text":"ピラトはイエスに尋,たずねた、「あなたがユダヤ人,じんの王,おうであるか」。イエスは、「そのとおりである」とお答,こたえになった。","tok":[["ピラト"],["は"],["イエス"],["に"],["尋ねた","たずねた"],["、"],["「"],["あなた"],["が"],["ユダヤ人","ゆだやじん"],["の"],["王","おう"],["で"],["ある"],["か"],["」"],["。"],["イエス"],["は"],["、"],["「"],["その"],["とおり"],["で"],["ある"],["」"],["と"],["お答","おこたえ"],["に"],["なった"],["。"]]},{"verse":3,"text":"そこで祭司長,さいしちょうたちは、イエスのことをいろいろと訴,うったえた。","tok":[["そこ"],["で"],["祭司長","さいしちょう"],["たち"],["は"],["、"],["イエス"],["の"],["こと"],["を"],["いろいろ"],["と"],["訴た","うったえた"],["。"]]},{"verse":4,"text":"ピラトはもう一度,いちどイエスに尋,たずねた、「何,なにも答,こたえないのか。見,みよ、あなたに対,たいしてあんなにまで次々,つぎつぎに訴,うったえているではないか」。","tok":[["ピラト"],["は"],["もう"],["一度","いちど"],["イエス"],["に"],["尋ねた","たずねた"],["、"],["「"],["何に","なに"],["も"],["答","こたえ"],["ない"],["の"],["か"],["。"],["見よ","みよ"],["、"],["あなた"],["に対して","にたいして"],["あんな"],["に"],["まで"],["次々","つぎつぎ"],["に"],["訴て","うったえて"],["いるで"],["は"],["ない"],["か"],["」"],["。"]]},{"verse":5,"text":"しかし、イエスはピラトが不思議,ふしぎに思,おもうほどに、もう何,なにもお答,こたえにならなかった。","tok":[["しかし"],["、"],["イエス"],["は"],["ピラト"],["が"],["不思議","ふしぎ"],["に"],["思","おもう"],["ほど"],["に"],["、"],["もう"],["何に","なに"],["も"],["お答","おこたえ"],["に"],["ならなかった"],["。"]]},{"verse":6,"text":"さて、祭,まつりのたびごとに、ピラトは人々,ひとびとが願,ねがい出,でる囚人,しゅうじんひとりを、ゆるしてやることにしていた。","tok":[["さて"],["、"],["祭","まつり"],["の"],["たび"],["ごと"],["に"],["、"],["ピラト"],["は"],["人々","ひとびと"],["が"],["願い出る","ねがいでる"],["囚人","しゅうじん"],["ひとり"],["を"],["、"],["ゆるして"],["やる"],["こと"],["に"],["して"],["いた"],["。"]]},{"verse":7,"text":"ここに、暴動,ぼうどうを起,おこし人殺,ひとごろしをしてつながれていた暴徒,ぼうとの中,なかに、バラバという者,ものがいた。","tok":[["ここ"],["に"],["、"],["暴動","ぼうどう"],["を"],["起こし","おこし"],["人殺し","ひとごろし"],["を"],["して"],["つながれて"],["いた"],["暴徒","ぼうと"],["の"],["中","なか"],["に"],["、"],["バラバ"],["と"],["いう"],["者","もの"],["が"],["いた"],["。"]]},{"verse":8,"text":"群衆,ぐんしゅうが押,おしかけてきて、いつものとおりにしてほしいと要求,ようきゅうしはじめたので、","tok":[["群衆","ぐんしゅう"],["が"],["押","おし"],["かけて"],["きて"],["、"],["いつも"],["の"],["とおり"],["に"],["して"],["ほしい"],["と"],["要求","ようきゅう"],["し"],["はじめた"],["ので"],["、"]]},{"verse":9,"text":"ピラトは彼,かれらにむかって、「おまえたちはユダヤ人,じんの王,おうをゆるしてもらいたいのか」と言,いった。","tok":[["ピラト"],["は"],["彼","かれ"],["ら"],["に"],["むかって"],["、"],["「"],["おまえ"],["たち"],["は"],["ユダヤ人","ゆだやじん"],["の"],["王","おう"],["を"],["ゆるして"],["もらいたい"],["の"],["か"],["」"],["と"],["言った","いった"],["。"]]},{"verse":10,"text":"それは、祭司長,さいしちょうたちがイエスを引,ひきわたしたのは、ねたみのためであることが、ピラトにわかっていたからである。","tok":[["それ"],["は"],["、"],["祭司長","さいしちょう"],["たち"],["が"],["イエス"],["を"],["引","ひき"],["わたした"],["の"],["は"],["、"],["ねたみ"],["の"],["ため"],["で"],["ある"],["こと"],["が"],["、"],["ピラト"],["に"],["わかって"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":11,"text":"しかし祭司長,さいしちょうたちは、バラバの方,ほうをゆるしてもらうように、群衆,ぐんしゅうを煽動,せんどうした。","tok":[["しかし"],["祭司長","さいしちょう"],["たち"],["は"],["、"],["バラバ"],["の"],["方","ほう"],["を"],["ゆるして"],["もらう"],["よう"],["に"],["、"],["群衆","ぐんしゅう"],["を"],["煽動","せんどう"],["した"],["。"]]},{"verse":12,"text":"そこでピラトはまた彼,かれらに言,いった、「それでは、おまえたちがユダヤ人,じんの王,おうと呼,よんでいるあの人,ひとは、どうしたらよいか」。","tok":[["そこ"],["で"],["ピラト"],["は"],["また"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["それ"],["で"],["は"],["、"],["おまえ"],["たち"],["が"],["ユダヤ人","ゆだやじん"],["の"],["王","おう"],["と"],["呼んで","よんで"],["いる"],["あの"],["人","ひと"],["は"],["、"],["どう"],["したら"],["よい"],["か"],["」"],["。"]]},{"verse":13,"text":"彼,かれらは、また叫,さけんだ、「十字架,じゅうじかにつけよ」。","tok":[["彼","かれ"],["ら"],["は"],["、"],["また"],["叫けんだ","さけんだ"],["、"],["「"],["十字架","じゅうじか"],["に"],["つけよ"],["」"],["。"]]},{"verse":14,"text":"ピラトは言,いった、「あの人,ひとは、いったい、どんな悪事,あくじをしたのか」。すると、彼,かれらは一そう激,はげしく叫,さけんで、「十字架,じゅうじかにつけよ」と言,いった。","tok":[["ピラト"],["は"],["言った","いった"],["、"],["「"],["あの"],["人","ひと"],["は"],["、"],["いったい"],["、"],["どんな"],["悪事","あくじ"],["を"],["した"],["の"],["か"],["」"],["。"],["する"],["と"],["、"],["彼","かれ"],["ら"],["は"],["一そう","いっそう"],["激しく","はげしく"],["叫けんで","さけんで"],["、"],["「"],["十字架","じゅうじか"],["に"],["つけよ"],["」"],["と"],["言った","いった"],["。"]]},{"verse":15,"text":"それで、ピラトは群衆,ぐんしゅうを満足,まんぞくさせようと思,おもって、バラバをゆるしてやり、イエスをむち打,うったのち、十字架,じゅうじかにつけるために引,ひきわたした。","tok":[["それ"],["で"],["、"],["ピラト"],["は"],["群衆","ぐんしゅう"],["を"],["満足","まんぞく"],["させよう"],["と"],["思って","おもって"],["、"],["バラバ"],["を"],["ゆるして"],["やり"],["、"],["イエス"],["を"],["むち打った","むちうった"],["のち"],["、"],["十字架","じゅうじか"],["に"],["つける"],["ため"],["に"],["引","ひき"],["わたした"],["。"]]},{"verse":16,"text":"兵士,へいしたちはイエスを、邸宅,ていたく、すなわち総督,そうとく官邸,かんていの内,うちに連,つれて行,いき、全,ぜん部隊,ぶたいを呼,よび集,あつめた。","tok":[["兵士","へいし"],["たち"],["は"],["イエス"],["を"],["、"],["邸宅","ていたく"],["、"],["すなわち"],["総督","そうとく"],["官邸","かんてい"],["の"],["内","うち"],["に"],["連れて","つれて"],["行き","いき"],["、"],["全","ぜん"],["部隊","ぶたい"],["を"],["呼び集めた","よびあつめた"],["。"]]},{"verse":17,"text":"そしてイエスに紫,むらさきの衣,ころもを着,きせ、いばらの冠,かんむりを編,あんでかぶらせ、","tok":[["そして"],["イエス"],["に"],["紫","むらさき"],["の"],["衣","ころも"],["を"],["着せ","きせ"],["、"],["いばら"],["の"],["冠","かんむり"],["を"],["編んで","あんで"],["かぶらせ"],["、"]]},{"verse":18,"text":"「ユダヤ人,じんの王,おう、ばんざい」と言,いって敬礼,けいれいをしはじめた。","tok":[["「"],["ユダヤ人","ゆだやじん"],["の"],["王","おう"],["、"],["ばんざい"],["」"],["と"],["言って","いって"],["敬礼","けいれい"],["を"],["し"],["はじめた"],["。"]]},{"verse":19,"text":"また、葦,あしの棒,ぼうでその頭,あたまをたたき、つばきをかけ、ひざまずいて拝,おがんだりした。","tok":[["また"],["、"],["葦","あし"],["の"],["棒","ぼう"],["で"],["その"],["頭","あたま"],["を"],["たたき"],["、"],["つばき"],["を"],["かけ"],["、"],["ひざまずいて"],["拝ん","おがん"],["だり"],["した"],["。"]]},{"verse":20,"text":"こうして、イエスを嘲弄,ちょうろうしたあげく、紫,むらさきの衣,ころもをはぎとり、元,もとの上着,うわぎを着,きせた。それから、彼,かれらはイエスを十字架,じゅうじかにつけるために引,ひき出,だした。","tok":[["こう"],["して"],["、"],["イエス"],["を"],["嘲弄","ちょうろう"],["した"],["あげく"],["、"],["紫","むらさき"],["の"],["衣","ころも"],["を"],["はぎとり"],["、"],["元","もと"],["の"],["上着","うわぎ"],["を"],["着せた","きせた"],["。"],["それ"],["から"],["、"],["彼","かれ"],["ら"],["は"],["イエス"],["を"],["十字架","じゅうじか"],["に"],["つける"],["ため"],["に"],["引出した","ひきだした"],["。"]]},{"verse":21,"text":"そこへ、アレキサンデルとルポスとの父,ちちシモンというクレネ人,びとが、郊外,こうがいからきて通,とおりかかったので、人々,ひとびとはイエスの十字架,じゅうじかを無理,むりに負,おわせた。","tok":[["そこ"],["へ"],["、"],["アレキサンデル"],["と"],["ルポス"],["と"],["の"],["父","ちち"],["シモン"],["と"],["いう"],["クレネ人","くれねび"],["と"],["が"],["、"],["郊外","こうがい"],["から"],["きて"],["通","とおり"],["かかった"],["ので"],["、"],["人々","ひとびと"],["は"],["イエス"],["の"],["十字架","じゅうじか"],["を"],["無理","むり"],["に"],["負わせた","おわせた"],["。"]]},{"verse":22,"text":"そしてイエスをゴルゴタ、その意味,いみは、されこうべ、という所,ところに連,つれて行,いった。","tok":[["そして"],["イエス"],["を"],["ゴルゴタ"],["、"],["その"],["意味","いみ"],["は"],["、"],["されこうべ"],["、"],["と"],["いう"],["所","ところ"],["に"],["連れて","つれて"],["行った","いった"],["。"]]},{"verse":23,"text":"そしてイエスに、没薬,もつやくをまぜたぶどう酒,しゅをさし出,だしたが、お受,うけにならなかった。","tok":[["そして"],["イエス"],["に"],["、"],["没薬","もつやく"],["を"],["まぜた"],["ぶどう酒","ぶどうしゅ"],["を"],["さし出した","さしだした"],["が"],["、"],["お受け","おうけ"],["に"],["ならなかった"],["。"]]},{"verse":24,"text":"それから、イエスを十字架,じゅうじかにつけた。そしてくじを引,ひいて、だれが何,なにを取,とるかを定,さだめたうえ、イエスの着物,きものを分,わけた。","tok":[["それ"],["から"],["、"],["イエス"],["を"],["十字架","じゅうじか"],["に"],["つけた"],["。"],["そして"],["くじ"],["を"],["引いて","ひいて"],["、"],["だれ"],["が"],["何に","なに"],["を"],["取る","とる"],["か"],["を"],["定めた","さだめた"],["うえ"],["、"],["イエス"],["の"],["着物","きもの"],["を"],["分けた","わけた"],["。"]]},{"verse":25,"text":"イエスを十字架,じゅうじかにつけたのは、朝,あさの九時,じごろであった。","tok":[["イエス"],["を"],["十字架","じゅうじか"],["に"],["つけた"],["の"],["は"],["、"],["朝","あさ"],["の"],["九","きゅう"],["時","じ"],["ごろ"],["で"],["あった"],["。"]]},{"verse":26,"text":"イエスの罪状,ざいじょう書,がきには「ユダヤ人,じんの王,おう」と、しるしてあった。","tok":[["イエス"],["の"],["罪状書","ざいじょうがき"],["に"],["は"],["「"],["ユダヤ人","ゆだやじん"],["の"],["王","おう"],["」"],["と"],["、"],["しるして"],["あった"],["。"]]},{"verse":27,"text":"また、イエスと共,ともにふたりの強盗,ごうとうを、ひとりを右,みぎに、ひとりを左,ひだりに、十字架,じゅうじかにつけた。〔","tok":[["また"],["、"],["イエス"],["と"],["共","とも"],["に"],["ふたり"],["の"],["強盗","ごうとう"],["を"],["、"],["ひとり"],["を"],["右","みぎ"],["に"],["、"],["ひとり"],["を"],["左","ひだり"],["に"],["、"],["十字架","じゅうじか"],["に"],["つけた"],["。"],["〔"]]},{"verse":28,"text":"こうして「彼,かれは罪人,つみびとたちのひとりに数,かぞえられた」と書,かいてある言葉,ことばが成就,じょうじゅしたのである。〕","tok":[["こう"],["して"],["「"],["彼","かれ"],["は"],["罪人","つみびとたち"],["の"],["ひとり"],["に"],["数えられた","かぞえられた"],["」"],["と"],["書いて","かいて"],["ある"],["言葉","ことば"],["が"],["成就","じょうじゅ"],["した"],["ので"],["ある"],["。"],["〕"]]},{"verse":29,"text":"そこを通,とおりかかった者,ものたちは、頭,あたまを振,ふりながら、イエスをののしって言,いった、「ああ、神殿,しんでんを打,うちこわして三日,かのうちに建,たてる者,ものよ、","tok":[["そこ"],["を"],["通りかかった","とおりかかった"],["者","もの"],["たち"],["は"],["、"],["頭","あたま"],["を"],["振り","ふり"],["ながら"],["、"],["イエス"],["を"],["ののしって"],["言った","いった"],["、"],["「"],["ああ"],["、"],["神殿","しんでん"],["を"],["打ちこわして","うちこわして"],["三日","か"],["の"],["うち"],["に"],["建てる","たてる"],["者","もの"],["よ"],["、"]]},{"verse":30,"text":"十字架,じゅうじかからおりてきて自分,じぶんを救,すくえ」。","tok":[["十字架","じゅうじか"],["から"],["おりて"],["きて"],["自分","じぶん"],["を"],["救え","すくえ"],["」"],["。"]]},{"verse":31,"text":"祭司長,さいしちょうたちも同,おなじように、律法,りっぽう学者,がくしゃたちと一緒,いっしょになって、かわるがわる嘲弄,ちょうろうして言,いった、「他人,たにんを救,すくったが、自分,じぶん自身,じしんを救,すくうことができない。","tok":[["祭司長","さいしちょう"],["たち"],["も"],["同じ","おなじ"],["よう"],["に"],["、"],["律法学者","りっぽうがくしゃ"],["たち"],["と"],["一緒","いっしょ"],["に"],["なって"],["、"],["かわるがわる"],["嘲弄","ちょうろう"],["して"],["言った","いった"],["、"],["「"],["他人","たにん"],["を"],["救った","すくった"],["が"],["、"],["自分","じぶん"],["自身","じしん"],["を"],["救う","すくう"],["こと"],["が"],["できない"],["。"]]},{"verse":32,"text":"イスラエルの王,おうキリスト、いま十字架,じゅうじかからおりてみるがよい。それを見,みたら信,しんじよう」。また、一緒,いっしょに十字架,じゅうじかにつけられた者,ものたちも、イエスをののしった。","tok":[["イスラエル"],["の"],["王","おう"],["キリスト"],["、"],["いま"],["十字架","じゅうじか"],["から"],["おりて"],["みる"],["が"],["よい"],["。"],["それ"],["を"],["見たら","みたら"],["信じよう","しんじよう"],["」"],["。"],["また"],["、"],["一緒","いっしょ"],["に"],["十字架","じゅうじか"],["に"],["つけられた"],["者","もの"],["たち"],["も"],["、"],["イエス"],["を"],["ののしった"],["。"]]},{"verse":33,"text":"昼,ひるの十二時,じになると、全,ぜん地,ちは暗,くらくなって、三時,じに及,およんだ。","tok":[["昼","ひる"],["の"],["十二","じゅうに"],["時","じ"],["に"],["なる"],["と"],["、"],["全地","ぜんち"],["は"],["暗く","くらく"],["なって"],["、"],["三","さん"],["時","じ"],["に"],["及んだ","およんだ"],["。"]]},{"verse":34,"text":"そして三時,じに、イエスは大声,おおごえで、「エロイ、エロイ、ラマ、サバクタニ」と叫,さけばれた。それは「わが神,かみ、わが神,かみ、どうしてわたしをお見捨,みすてになったのですか」という意味,いみである。","tok":[["そして"],["三","さん"],["時","じ"],["に"],["、"],["イエス"],["は"],["大声","おおごえ"],["で"],["、"],["「"],["エロイ"],["、"],["エロイ"],["、"],["ラマ"],["、"],["サバクタニ"],["」"],["と"],["叫けばれた","さけばれた"],["。"],["それ"],["は"],["「"],["わが"],["神","かみ"],["、"],["わが"],["神","かみ"],["、"],["どう"],["して"],["わたし"],["を"],["お見捨て","おみすて"],["に"],["なった"],["の"],["です"],["か"],["」"],["と"],["いう"],["意味","いみ"],["で"],["ある"],["。"]]},{"verse":35,"text":"すると、そばに立,たっていたある人々,ひとびとが、これを聞,きいて言,いった、「そら、エリヤを呼,よんでいる」。","tok":[["する"],["と"],["、"],["そば"],["に"],["立って","たって"],["いた"],["ある"],["人々","ひとびと"],["が"],["、"],["これ"],["を"],["聞いて","きいて"],["言った","いった"],["、"],["「"],["そら"],["、"],["エリヤ"],["を"],["呼んで","よんで"],["いる"],["」"],["。"]]},{"verse":36,"text":"ひとりの人,ひとが走,はしって行,いき、海綿,かいめんに酢,すいぶどう酒,しゅを含,ふくませて葦,あしの棒,ぼうにつけ、イエスに飲,のませようとして言,いった、「待,まて、エリヤが彼,かれをおろしに来,くるかどうか、見,みていよう」。","tok":[["ひとり"],["の"],["人","ひと"],["が"],["走って","はしって"],["行き","いき"],["、"],["海綿","かいめん"],["に"],["酢","す"],["い"],["ぶどう酒","ぶどうしゅ"],["を"],["含ませて","ふくませて"],["葦","あし"],["の"],["棒","ぼう"],["に"],["つけ"],["、"],["イエス"],["に"],["飲ませよう","のませよう"],["として"],["言った","いった"],["、"],["「"],["待て","まて"],["、"],["エリヤ"],["が"],["彼","かれ"],["を"],["おろし"],["に"],["来る","くる"],["か"],["どう"],["か"],["、"],["見て","みて"],["いよう"],["」"],["。"]]},{"verse":37,"text":"イエスは声,こえ高,たかく叫,さけんで、ついに息,いきをひきとられた。","tok":[["イエス"],["は"],["声","こえ"],["高かく","たかく"],["叫けんで","さけんで"],["、"],["ついに"],["息","いき"],["を"],["ひきとられた"],["。"]]},{"verse":38,"text":"そのとき、神殿,しんでんの幕,まくが上,うえから下,したまで真二,まっぷたつに裂,さけた。","tok":[["その"],["とき"],["、"],["神殿","しんでん"],["の"],["幕","まく"],["が"],["上","うえ"],["から"],["下","した"],["まで"],["真二","まっぷたつ"],["に"],["裂けた","さけた"],["。"]]},{"verse":39,"text":"イエスにむかって立,たっていた百卒長,ひゃくそつちょうは、このようにして息,いきをひきとられたのを見,みて言,いった、「まことに、この人,ひとは神,かみの子,こであった」。","tok":[["イエス"],["に"],["むかって"],["立って","たって"],["いた"],["百卒長","ひゃくそつちょう"],["は"],["、"],["この"],["よう"],["に"],["して"],["息","いき"],["を"],["ひきとられた"],["の"],["を"],["見て","みて"],["言った","いった"],["、"],["「"],["まこと"],["に"],["、"],["この"],["人","ひと"],["は"],["神","かみ"],["の"],["子","こ"],["で"],["あった"],["」"],["。"]]},{"verse":40,"text":"また、遠,とおくの方,ほうから見,みている女,おんなたちもいた。その中,なかには、マグダラのマリヤ、小,しょうヤコブとヨセとの母,ははマリヤ、またサロメがいた。","tok":[["また"],["、"],["遠く","とおく"],["の"],["方","ほう"],["から"],["見て","みて"],["いる"],["女","おんな"],["たち"],["も"],["いた"],["。"],["その"],["中","なか"],["に"],["は"],["、"],["マグダラ"],["の"],["マリヤ"],["、"],["小","しょう"],["ヤコブ"],["と"],["ヨセ"],["と"],["の"],["母","はは"],["マリヤ"],["、"],["また"],["サロメ"],["が"],["いた"],["。"]]},{"verse":41,"text":"彼,かれらはイエスがガリラヤにおられたとき、そのあとに従,したがって仕,つかえた女,おんなたちであった。なおそのほか、イエスと共,ともにエルサレムに上,のぼってきた多,おおくの女,おんなたちもいた。","tok":[["彼","かれ"],["ら"],["は"],["イエス"],["が"],["ガリラヤ"],["に"],["おられた"],["とき"],["、"],["その"],["あと"],["に"],["従って","したがって"],["仕えた","つかえた"],["女","おんな"],["たち"],["で"],["あった"],["。"],["なお"],["その"],["ほか"],["、"],["イエス"],["と"],["共","とも"],["に"],["エルサレム"],["に"],["上って","のぼって"],["きた"],["多く","おおく"],["の"],["女","おんな"],["たち"],["も"],["いた"],["。"]]},{"verse":42,"text":"さて、すでに夕,ゆうがたになったが、その日,ひは準備,じゅんびの日,ひ、すなわち安息日,あんそくにちの前日,ぜんじつであったので、","tok":[["さて"],["、"],["すでに"],["夕がた","ゆうがた"],["に"],["なった"],["が"],["、"],["その"],["日","ひ"],["は"],["準備","じゅんび"],["の"],["日","ひ"],["、"],["すなわち"],["安息日","あんそくにち"],["の"],["前日","ぜんじつ"],["で"],["あった"],["ので"],["、"]]},{"verse":43,"text":"アリマタヤのヨセフが大胆,だいたんにもピラトの所,ところへ行,いき、イエスのからだの引取,とりかたを願,ねがった。彼,かれは地位,ちいの高,たかい議員,ぎいんであって、彼,かれ自身,じしん、神,かみの国,くにを待,まち望,のぞんでいる人,ひとであった。","tok":[["アリマタヤ"],["の"],["ヨセフ"],["が"],["大胆","だいたん"],["に"],["も"],["ピラト"],["の"],["所","ところ"],["へ"],["行き","いき"],["、"],["イエス"],["の"],["からだ"],["の"],["引取","とりかた"],["を"],["願った","ねがった"],["。"],["彼","かれ"],["は"],["地位","ちい"],["の"],["高い","たかい"],["議員","ぎいん"],["で"],["あって"],["、"],["彼","かれ"],["自身","じしん"],["、"],["神","かみ"],["の"],["国","くに"],["を"],["待ち望んで","まちのぞんで"],["いる"],["人","ひと"],["で"],["あった"],["。"]]},{"verse":44,"text":"ピラトは、イエスがもはや死,しんでしまったのかと不審,ふしんに思,おもい、百卒長,ひゃくそつちょうを呼,よんで、もう死,しんだのかと尋,たずねた。","tok":[["ピラト"],["は"],["、"],["イエス"],["が"],["もはや"],["死んで","しんで"],["しまった"],["の"],["か"],["と"],["不審","ふしん"],["に"],["思い","おもい"],["、"],["百卒長","ひゃくそつちょう"],["を"],["呼んで","よんで"],["、"],["もう"],["死んだ","しんだ"],["の"],["か"],["と"],["尋ねた","たずねた"],["。"]]},{"verse":45,"text":"そして、百卒長,ひゃくそつちょうから確,たしかめた上,うえ、死体,したいをヨセフに渡,わたした。","tok":[["そして"],["、"],["百卒長","ひゃくそつちょう"],["から"],["確かめた","たしかめた"],["上","うえ"],["、"],["死体","したい"],["を"],["ヨセフ"],["に"],["渡","わたし"],["た"],["。"]]},{"verse":46,"text":"そこで、ヨセフは亜麻布,あまぬのを買,かい求,もとめ、イエスをとりおろして、その亜麻布,あまぬのに包,つつみ、岩,いわを掘,ほって造,つくった墓,はかに納,おさめ、墓,はかの入口,いりぐちに石,いしをころがしておいた。","tok":[["そこ"],["で"],["、"],["ヨセフ"],["は"],["亜","あ"],["麻布","あざぶ"],["の"],["を"],["買","かい"],["求め","もとめ"],["、"],["イエス"],["を"],["とりおろして"],["、"],["その"],["亜","あ"],["麻布","あざぶ"],["のに"],["包","つつみ"],["、"],["岩","いわ"],["を"],["掘って","ほって"],["造った","つくった"],["墓","はか"],["に"],["納","おさめ"],["、"],["墓","はか"],["の"],["入口","いりぐち"],["に"],["石","いし"],["を"],["ころがして"],["おいた"],["。"]]},{"verse":47,"text":"マグダラのマリヤとヨセの母,ははマリヤとは、イエスが納,おさめられた場所,ばしょを見,みとどけた。","tok":[["マグダラ"],["の"],["マリヤ"],["と"],["ヨセ"],["の"],["母","はは"],["マリヤ"],["と"],["は"],["、"],["イエス"],["が"],["納められた","おさめられた"],["場所","ばしょ"],["を"],["見とどけた","みとどけた"],["。"]]}]
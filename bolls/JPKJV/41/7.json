[{"verse":1,"text":"さて、パリサイ人,びとと、ある律法,りっぽう学者,がくしゃたちとが、エルサレムからきて、イエスのもとに集,あつまった。","tok":[["さて"],["、"],["パリサイ"],["人","び"],["と"],["と"],["、"],["ある"],["律法学者","りっぽうがくしゃ"],["たち"],["と"],["が"],["、"],["エルサレム"],["から"],["きて"],["、"],["イエス"],["の"],["もと"],["に"],["集まった","あつまった"],["。"]]},{"verse":2,"text":"そして弟子,でしたちのうちに、不浄,ふじょうな手,て、すなわち洗,あらわない手,てで、パンを食,たべている者,ものがあるのを見,みた。","tok":[["そして"],["弟子","でし"],["たち"],["の"],["うち"],["に"],["、"],["不浄","ふじょう"],["な"],["手","て"],["、"],["すなわち"],["洗わない","あらわない"],["手","て"],["で"],["、"],["パン"],["を"],["食べて","たべて"],["いる"],["者","もの"],["が"],["ある"],["の"],["を"],["見た","みた"],["。"]]},{"verse":3,"text":"もともと、パリサイ人,びとをはじめユダヤ人,じんはみな、昔,むかしの人,ひとの言伝,いいつたえをかたく守,まもって、念入,ねんいりに手,てを洗,あらってからでないと、食事,しょくじをしない。","tok":[["もともと"],["、"],["パリサイ"],["人","びと"],["を"],["はじめ"],["ユダヤ人","ゆだやじん"],["は"],["みな"],["、"],["昔","むかし"],["の"],["人","ひと"],["の"],["言伝え","いいつたえ"],["を"],["かたく"],["守って","まもって"],["、"],["念","ねん"],["入","いり"],["に"],["手","て"],["を"],["洗って","あらって"],["から"],["で"],["ない"],["と"],["、"],["食事","しょくじ"],["を"],["しない"],["。"]]},{"verse":4,"text":"また市場,いちばから帰,かえったときには、身,みを清,きよめてからでないと、食事,しょくじをせず、なおそのほかにも、杯,さかずき、鉢,はち、銅器,どうきを洗,あらうことなど、昔,むかしから受,うけついでかたく守,まもっている事,ことが、たくさんあった。","tok":[["また"],["市場","いちばか"],["ら"],["帰えった","かえった"],["とき"],["に"],["は"],["、"],["身","み"],["を"],["清めて","きよめて"],["から"],["で"],["ない"],["と"],["、"],["食事","しょくじ"],["を"],["せず"],["、"],["なお"],["その"],["ほか"],["に"],["も"],["、"],["杯","さかずき"],["、"],["鉢","は"],["ち"],["、"],["銅器","どうき"],["を"],["洗う","あらう"],["こと"],["など"],["、"],["昔","むかし"],["から"],["受けついで","うけついで"],["かたく"],["守って","まもって"],["いる"],["事","こと"],["が"],["、"],["たくさん"],["あった"],["。"]]},{"verse":5,"text":"そこで、パリサイ人,びとと律法,りっぽう学者,がくしゃたちとは、イエスに尋,たずねた、「なぜ、あなたの弟子,でしたちは、昔,むかしの人,ひとの言伝,いいつたえに従,したがって歩,あゆまないで、不浄,ふじょうな手,てでパンを食,たべるのですか」。","tok":[["そこ"],["で"],["、"],["パリサイ"],["人","び"],["と"],["と"],["律法学者","りっぽうがくしゃ"],["たち"],["と"],["は"],["、"],["イエス"],["に"],["尋ねた","たずねた"],["、"],["「"],["なぜ"],["、"],["あなた"],["の"],["弟子","でし"],["たち"],["は"],["、"],["昔","むかし"],["の"],["人","ひと"],["の"],["言伝え","いいつたえ"],["に"],["従って","したがって"],["歩まないで","あゆまないで"],["、"],["不浄","ふじょう"],["な"],["手","て"],["で"],["パン"],["を"],["食べる","たべる"],["の"],["です"],["か"],["」"],["。"]]},{"verse":6,"text":"イエスは言,いわれた、「イザヤは、あなたがた偽善者,ぎぜんしゃについて、こう書,かいているが、それは適切,てきせつな預言,よげんである、『この民,たみは、口,くちさきではわたしを敬,うやまうが、その心,こころはわたしから遠,とおく離,はなれている。","tok":[["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["イザヤ"],["は"],["、"],["あなた"],["がた"],["偽善者","ぎぜんしゃ"],["について"],["、"],["こう"],["書いて","かいて"],["いる"],["が"],["、"],["それ"],["は"],["適切","てきせつ"],["な"],["預言","よげん"],["で"],["ある"],["、"],["『"],["この"],["民","たみ"],["は"],["、"],["口さき","くちさき"],["で"],["は"],["わたし"],["を"],["敬う","うやまう"],["が"],["、"],["その"],["心","こころ"],["は"],["わたし"],["から"],["遠く","とおく"],["離れて","はなれて"],["いる"],["。"]]},{"verse":7,"text":"人間,にんげんのいましめを教,おしえとして教,おしえ、無意味,むいみにわたしを拝,おがんでいる』。","tok":[["人間","にんげん"],["の"],["いましめ"],["を"],["教え","おしえ"],["として"],["教え","おしえ"],["、"],["無意味","むいみ"],["に"],["わたし"],["を"],["拝んで","おがんで"],["いる"],["』"],["。"]]},{"verse":8,"text":"あなたがたは、神,かみのいましめをさしおいて、人間,にんげんの言伝,いいつたえを固執,こしつしている」。","tok":[["あなた"],["がた"],["は"],["、"],["神","かみ"],["の"],["いましめ"],["を"],["さしおいて"],["、"],["人間","にんげん"],["の"],["言伝え","いいつたえ"],["を"],["固執","こしつ"],["して"],["いる"],["」"],["。"]]},{"verse":9,"text":"また、言,いわれた、「あなたがたは、自分,じぶんたちの言伝,いいつたえを守,まもるために、よくも神,かみのいましめを捨,すてたものだ。","tok":[["また"],["、"],["言われた","いわれた"],["、"],["「"],["あなた"],["がた"],["は"],["、"],["自分","じぶん"],["たち"],["の"],["言伝え","いいつたえ"],["を"],["守","まもる"],["ため"],["に"],["、"],["よく"],["も"],["神","かみ"],["の"],["いましめ"],["を"],["捨てた","すてた"],["もの"],["だ"],["。"]]},{"verse":10,"text":"モーセは言,いったではないか、『父,ちちと母,ははとを敬,うやまえ』、また『父,ちちまたは母,ははをののしる者,ものは、必,かならず死,しに定,さだめられる』と。","tok":[["モーセ"],["は"],["言ったで","いったで"],["は"],["ない"],["か"],["、"],["『"],["父","ちち"],["と"],["母","はは"],["と"],["を"],["敬え","うやまえ"],["』"],["、"],["また"],["『"],["父","ちち"],["また"],["は"],["母","はは"],["を"],["ののしる"],["者","もの"],["は"],["、"],["必死","かならずし"],["に"],["定められる","さだめられる"],["』"],["と"],["。"]]},{"verse":11,"text":"それだのに、あなたがたは、もし人,ひとが父,ちちまたは母,ははにむかって、あなたに差上,さしあげるはずのこのものはコルバン、すなわち、供,そなえ物,ものですと言,いえば、それでよいとして、","tok":[["それ"],["だ"],["のに"],["、"],["あなた"],["がた"],["は"],["、"],["もし"],["人","ひと"],["が"],["父","ちち"],["また"],["は"],["母","はは"],["に"],["むかって"],["、"],["あなた"],["に"],["差上げる","さしあげる"],["はず"],["の"],["この"],["もの"],["は"],["コルバン"],["、"],["すなわち"],["、"],["供え物","そなえもの"],["です"],["と"],["言えば","いえば"],["、"],["それ"],["で"],["よい"],["として"],["、"]]},{"verse":12,"text":"その人,ひとは父母,ふぼに対,たいして、もう何,なにもしないで済,すむのだと言,いっている。","tok":[["その"],["人","ひと"],["は"],["父母","ふぼ"],["に対して","にたいして"],["、"],["もう"],["何に","なに"],["も"],["しないで"],["済む","すむ"],["の"],["だ"],["と"],["言って","いって"],["いる"],["。"]]},{"verse":13,"text":"こうしてあなたがたは、自分,じぶんたちが受,うけついだ言伝,いいつたえによって、神,かみの言,ことばを無,むにしている。また、このような事,ことをしばしばおこなっている」。","tok":[["こう"],["して"],["あなた"],["がた"],["は"],["、"],["自分","じぶん"],["たち"],["が"],["受ついだ","うけついだ"],["言伝え","いいつたえ"],["によって"],["、"],["神","かみ"],["の"],["言","ことば"],["を"],["無","む"],["に"],["して"],["いる"],["。"],["また"],["、"],["この"],["よう"],["な"],["事","こと"],["を"],["しばしば"],["おこなって"],["いる"],["」"],["。"]]},{"verse":14,"text":"それから、イエスは再,ふたたび群衆,ぐんしゅうを呼,よび寄,よせて言,いわれた、「あなたがたはみんな、わたしの言,いうことを聞,きいて悟,さとるがよい。","tok":[["それ"],["から"],["、"],["イエス"],["は"],["再び","ふたたび"],["群衆","ぐんしゅう"],["を"],["呼び寄せて","よびよせて"],["言われた","いわれた"],["、"],["「"],["あなた"],["がた"],["は"],["みんな"],["、"],["わたし"],["の"],["言う","いう"],["こと"],["を"],["聞いて","きいて"],["悟","さとる"],["が"],["よい"],["。"]]},{"verse":15,"text":"すべて外,そとから人,ひとの中,なかにはいって、人,ひとをけがしうるものはない。かえって、人,ひとの中,なかから出,でてくるものが、人,ひとをけがすのである。〔","tok":[["すべて"],["外","そと"],["から"],["人","ひと"],["の"],["中","なか"],["に"],["はいって"],["、"],["人","ひと"],["を"],["けがし"],["うる"],["もの"],["は"],["ない"],["。"],["かえって"],["、"],["人","ひと"],["の"],["中","なか"],["から"],["出て","でて"],["くる"],["もの"],["が"],["、"],["人","ひと"],["を"],["けがす"],["ので"],["ある"],["。"],["〔"]]},{"verse":16,"text":"聞,きく耳,みみのある者,ものは聞,きくがよい〕」。","tok":[["聞く","きく"],["耳","みみ"],["の"],["ある"],["者","もの"],["は"],["聞く","きく"],["が"],["よい"],["〕"],["」"],["。"]]},{"verse":17,"text":"イエスが群衆,ぐんしゅうを離,はなれて家,いえにはいられると、弟子,でしたちはこの譬,たとえについて尋,たずねた。","tok":[["イエス"],["が"],["群衆","ぐんしゅう"],["を"],["離れて","はなれて"],["家","いえ"],["に"],["は"],["いられる"],["と"],["、"],["弟子","でし"],["たち"],["は"],["この"],["譬","たとえ"],["について"],["尋ねた","たずねた"],["。"]]},{"verse":18,"text":"すると、言,いわれた、「あなたがたも、そんなに鈍,にぶいのか。すべて、外,そとから人,ひとの中,なかにはいって来,くるものは、人,ひとを汚,けがし得,えないことが、わからないのか。","tok":[["する"],["と"],["、"],["言われた","いわれた"],["、"],["「"],["あなた"],["がた"],["も"],["、"],["そんな"],["に"],["鈍い","にぶい"],["の"],["か"],["。"],["すべて"],["、"],["外","そと"],["から"],["人","ひと"],["の"],["中","なか"],["に"],["はいって"],["来る","くる"],["もの"],["は"],["、"],["人","ひと"],["を"],["汚","け"],["がし"],["得ない","えない"],["こと"],["が"],["、"],["わからない"],["の"],["か"],["。"]]},{"verse":19,"text":"それは人,ひとの心,こころの中,なかにはいるのではなく、腹,はらの中,うちにはいり、そして、外,そとに出,でて行,いくだけである」。イエスはこのように、どんな食物,しょくもつでもきよいものとされた。","tok":[["それ"],["は"],["人","ひと"],["の"],["心","こころ"],["の"],["中","なか"],["に"],["は"],["いる"],["ので"],["は"],["なく"],["、"],["腹","はら"],["の"],["中","うち"],["に"],["はいり"],["、"],["そして"],["、"],["外","そと"],["に"],["出て","でて"],["行く","いく"],["だけ"],["で"],["ある"],["」"],["。"],["イエス"],["は"],["この"],["よう"],["に"],["、"],["どんな"],["食物","しょくもつ"],["で"],["も"],["きよい"],["もの"],["と"],["された"],["。"]]},{"verse":20,"text":"さらに言,いわれた、「人,ひとから出,でて来,くるもの、それが人,ひとをけがすのである。","tok":[["さらに"],["言われた","いわれた"],["、"],["「"],["人","ひと"],["から"],["出て","でて"],["来る","くる"],["もの"],["、"],["それ"],["が"],["人","ひと"],["を"],["けがす"],["ので"],["ある"],["。"]]},{"verse":21,"text":"すなわち内部,ないぶから、人,ひとの心,こころの中,なかから、悪,わるい思,おもいが出,でて来,くる。不品行,ふひんこう、盗,ぬすみ、殺人,さつじん、","tok":[["すなわち"],["内部","ないぶ"],["から"],["、"],["人","ひと"],["の"],["心","こころ"],["の"],["中","なか"],["から"],["、"],["悪い","わるい"],["思い","おもい"],["が"],["出て","でて"],["来る","くる"],["。"],["不品行","ふひんこう"],["、"],["盗み","ぬすみ"],["、"],["殺人","さつじん"],["、"]]},{"verse":22,"text":"姦淫,かんいん、貪欲,どんよく、邪悪,じゃあく、欺,あざむき、好色,こうしょく、妬,ねたみ、誹,そしり、高慢,こうまん、愚痴,ぐち。","tok":[["姦淫","かんいん"],["、"],["貪欲","どんよく"],["、"],["邪悪","じゃあく"],["、"],["欺き","あざむき"],["、"],["好色","こうしょく"],["、"],["妬み","ねたみ"],["、"],["誹り","そしり"],["、"],["高慢","こうまん"],["、"],["愚痴","ぐち"],["。"]]},{"verse":23,"text":"これらの悪,あくはすべて内部,ないぶから出,でてきて、人,ひとをけがすのである」。","tok":[["これ"],["ら"],["の"],["悪","あく"],["は"],["すべて"],["内部","ないぶ"],["から"],["出て","でて"],["きて"],["、"],["人","ひと"],["を"],["けがす"],["ので"],["ある"],["」"],["。"]]},{"verse":24,"text":"さて、イエスは、そこを立,たち去,さって、ツロの地方,ちほうに行,いかれた。そして、だれにも知,しれないように、家,いえの中,なかにはいられたが、隠,かくれていることができなかった。","tok":[["さて"],["、"],["イエス"],["は"],["、"],["そこ"],["を"],["立ち","たち"],["去て","さって"],["、"],["ツロ"],["の"],["地方","ちほう"],["に"],["行かれた","いかれた"],["。"],["そして"],["、"],["だれ"],["に"],["も"],["知れない","しれない"],["よう"],["に"],["、"],["家","いえ"],["の"],["中","なか"],["に"],["は"],["いられた"],["が"],["、"],["隠れて","かくれて"],["いる"],["こと"],["が"],["できなかった"],["。"]]},{"verse":25,"text":"そして、けがれた霊,れいにつかれた幼,おさない娘,むすめをもつ女,おんなが、イエスのことをすぐ聞,ききつけてきて、その足,あしもとにひれ伏,ふした。","tok":[["そして"],["、"],["けがれた"],["霊","れい"],["に"],["つかれた"],["幼ない","おさない"],["娘","むすめ"],["を"],["もつ"],["女","おんな"],["が"],["、"],["イエス"],["の"],["こと"],["を"],["すぐ"],["聞","きき"],["つけて"],["きて"],["、"],["その"],["足もと","あしもと"],["に"],["ひれ伏した","ひれふした"],["。"]]},{"verse":26,"text":"この女,おんなはギリシヤ人,じんで、スロ・フェニキヤの生,うまれであった。そして、娘,むすめから悪霊,あくれいを追,おい出,だしてくださいとお願,ねがいした。","tok":[["この"],["女","おんな"],["は"],["ギリシヤ"],["人","じん"],["で"],["、"],["スロ"],["・"],["フェニキヤ"],["の"],["生まれ","うまれ"],["で"],["あった"],["。"],["そして"],["、"],["娘","むすめ"],["から"],["悪霊","あくれい"],["を"],["追い出して","おいだして"],["ください"],["と"],["お願い","おねがい"],["した"],["。"]]},{"verse":27,"text":"イエスは女,おんなに言,いわれた、「まず子供,こどもたちに十分,じゅうぶん食,たべさすべきである。子供,こどもたちのパンを取,とって小犬,こいぬに投,なげてやるのは、よろしくない」。","tok":[["イエス"],["は"],["女","おんな"],["に"],["言われた","いわれた"],["、"],["「"],["まず"],["子供","こども"],["たち"],["に"],["十分","じゅうぶん"],["食べさすべきで","たべさすべきで"],["ある"],["。"],["子供","こども"],["たち"],["の"],["パン"],["を"],["取って","とって"],["小犬","こいぬ"],["に"],["投て","なげて"],["やる"],["の"],["は"],["、"],["よろしく"],["ない"],["」"],["。"]]},{"verse":28,"text":"すると、女,おんなは答,こたえて言,いった、「主,しゅよ、お言葉,ことばどおりです。でも、食卓,しょくたくの下,したにいる小犬,こいぬも、子供,こどもたちのパンくずは、いただきます」。","tok":[["する"],["と"],["、"],["女","おんな"],["は"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["主","しゅ"],["よ"],["、"],["お言葉","おことば"],["どおり"],["です"],["。"],["で"],["も"],["、"],["食卓","しょくたく"],["の"],["下","した"],["に"],["いる"],["小犬","こいぬ"],["も"],["、"],["子供","こども"],["たち"],["の"],["パン"],["くず"],["は"],["、"],["いただきます"],["」"],["。"]]},{"verse":29,"text":"そこでイエスは言,いわれた、「その言葉,ことばで、じゅうぶんである。お帰,かえりなさい。悪霊,あくれいは娘,むすめから出,でてしまった」。","tok":[["そこ"],["で"],["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["その"],["言葉","ことば"],["で"],["、"],["じゅうぶん"],["で"],["ある"],["。"],["お帰えり","おかえり"],["なさい"],["。"],["悪霊","あくれい"],["は"],["娘","むすめ"],["から"],["出て","でて"],["しまった"],["」"],["。"]]},{"verse":30,"text":"そこで、女,おんなが家,いえに帰,かえってみると、その子,こは床,とこの上,うえに寝,ねており、悪霊,あくれいは出,でてしまっていた。","tok":[["そこ"],["で"],["、"],["女","おんな"],["が"],["家","いえ"],["に"],["帰えって","かえって"],["みる"],["と"],["、"],["その"],["子","こ"],["は"],["床","とこ"],["の"],["上","うえ"],["に"],["寝て","ねて"],["おり"],["、"],["悪霊","あくれい"],["は"],["出て","でて"],["しまって"],["いた"],["。"]]},{"verse":31,"text":"それから、イエスはまたツロの地方,ちほうを去,さり、シドンを経,へてデカポリス地方,ちほうを通,とおりぬけ、ガリラヤの海,うみべにこられた。","tok":[["それ"],["から"],["、"],["イエス"],["は"],["また"],["ツロ"],["の"],["地方","ちほう"],["を"],["去り","さり"],["、"],["シドン"],["を"],["経て","へて"],["デカポリス"],["地方","ちほう"],["を"],["通りぬけ","とおりぬけ"],["、"],["ガリラヤ"],["の"],["海べ","うみべ"],["に"],["こられた"],["。"]]},{"verse":32,"text":"すると人々,ひとびとは、耳,みみが聞,きこえず口,くちのきけない人,ひとを、みもとに連,つれてきて、手,てを置,おいてやっていただきたいとお願,ねがいした。","tok":[["する"],["と"],["人々","ひとびと"],["は"],["、"],["耳","みみ"],["が"],["聞こえず","きこえず"],["口","くち"],["の"],["きけない"],["人","ひと"],["を"],["、"],["みもと"],["に"],["連れて","つれて"],["きて"],["、"],["手","て"],["を"],["置いて","おいて"],["やって"],["いただきたい"],["と"],["お願い","おねがい"],["した"],["。"]]},{"verse":33,"text":"そこで、イエスは彼,かれひとりを群衆,ぐんしゅうの中,なかから連,つれ出,だし、その両,りょう耳,みみに指,ゆびをさし入,いれ、それから、つばきでその舌,したを潤,うるおし、","tok":[["そこ"],["で"],["、"],["イエス"],["は"],["彼","かれ"],["ひとり"],["を"],["群衆","ぐんしゅう"],["の"],["中","なか"],["から"],["連れ出し","つれだし"],["、"],["その"],["両耳","りょうみみ"],["に"],["指","ゆび"],["を"],["さし入れ","さしいれ"],["、"],["それ"],["から"],["、"],["つばき"],["で"],["その"],["舌","した"],["を"],["潤おし","うるおし"],["、"]]},{"verse":34,"text":"天,てんを仰,あおいでため息,いきをつき、その人,ひとに「エパタ」と言,いわれた。これは「開,ひらけよ」という意味,いみである。","tok":[["天","てん"],["を"],["仰いで","あおいで"],["ため息","ためいき"],["を"],["つき"],["、"],["その"],["人","ひと"],["に"],["「"],["エパタ"],["」"],["と"],["言われた","いわれた"],["。"],["これ"],["は"],["「"],["開らけよ","ひらけよ"],["」"],["と"],["いう"],["意味","いみ"],["で"],["ある"],["。"]]},{"verse":35,"text":"すると彼,かれの耳,みみが開,ひらけ、その舌,したのもつれもすぐ解,とけて、はっきりと話,はなすようになった。","tok":[["する"],["と"],["彼","かれ"],["の"],["耳","みみ"],["が"],["開らけ","ひらけ"],["、"],["その"],["舌","した"],["の"],["もつれ"],["も"],["すぐ"],["解けて","とけて"],["、"],["はっきり"],["と"],["話す","はなす"],["よう"],["に"],["なった"],["。"]]},{"verse":36,"text":"イエスは、この事,ことをだれにも言,いってはならぬと、人々,ひとびとに口止,くちどめをされたが、口止,くちどめをすればするほど、かえって、ますます言,いいひろめた。","tok":[["イエス"],["は"],["、"],["この"],["事","こと"],["を"],["だれ"],["に"],["も"],["言って","いって"],["は"],["ならぬ"],["と"],["、"],["人々","ひとびと"],["に"],["口止め","くちどめ"],["を"],["された"],["が"],["、"],["口止め","くちどめ"],["を"],["すれば"],["する"],["ほど"],["、"],["かえって"],["、"],["ますます"],["言い","いい"],["ひろめた"],["。"]]},{"verse":37,"text":"彼,かれらは、ひとかたならず驚,おどろいて言,いった、「このかたのなさった事,ことは、何,なにもかも、すばらしい。耳,みみの聞,きこえない者,ものを聞,きこえるようにしてやり、口,くちのきけない者,ものをきけるようにしておやりになった」。","tok":[["彼","かれ"],["ら"],["は"],["、"],["ひとかた"],["ならず"],["驚ろいて","おどろいて"],["言った","いった"],["、"],["「"],["このかた"],["の"],["なさった"],["事","こと"],["は"],["、"],["何に","なに"],["も"],["か"],["も"],["、"],["すばらしい"],["。"],["耳","みみ"],["の"],["聞こえない","きこえない"],["者","もの"],["を"],["聞こえる","きこえる"],["よう"],["に"],["して"],["やり"],["、"],["口","くち"],["の"],["きけない"],["者","もの"],["を"],["きける"],["よう"],["に"],["して"],["おやり"],["に"],["なった"],["」"],["。"]]}]
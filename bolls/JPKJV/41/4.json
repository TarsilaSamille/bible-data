[{"verse":1,"text":"イエスはまたも、海,うみべで教,おしえはじめられた。おびただしい群衆,ぐんしゅうがみもとに集,あつまったので、イエスは舟,ふねに乗,のってすわったまま、海上,かいじょうにおられ、群衆,ぐんしゅうはみな海,うみに沿,そって陸地,りくちにいた。","tok":[["イエス"],["は"],["また"],["も"],["、"],["海べ","うみべ"],["で"],["教え","おしえ"],["はじめられた"],["。"],["おびただしい"],["群衆","ぐんしゅう"],["が"],["みもと"],["に"],["集まった","あつまった"],["ので"],["、"],["イエス"],["は"],["舟","ふね"],["に"],["乗って","のって"],["すわった"],["まま"],["、"],["海上","かいじょう"],["に"],["おられ"],["、"],["群衆","ぐんしゅう"],["は"],["みな"],["海","うみ"],["に"],["沿って","そって"],["陸地","りくち"],["に"],["いた"],["。"]]},{"verse":2,"text":"イエスは譬,たとえで多,おおくの事,ことを教,おしえられたが、その教,おしえの中,なかで彼,かれらにこう言,いわれた、","tok":[["イエス"],["は"],["譬","たとえ"],["で"],["多く","おおく"],["の"],["事","こと"],["を"],["教えられた","おしえられた"],["が"],["、"],["その"],["教え","おしえ"],["の"],["中","なか"],["で"],["彼","かれ"],["ら"],["に"],["こう"],["言われた","いわれた"],["、"]]},{"verse":3,"text":"「聞,ききなさい、種,たねまきが種,たねをまきに出,でて行,いった。","tok":[["「"],["聞","きき"],["なさい"],["、"],["種まき","たねまき"],["が"],["種","たね"],["を"],["まき"],["に"],["出て","でて"],["行った","いった"],["。"]]},{"verse":4,"text":"まいているうちに、道,みちばたに落,おちた種,たねがあった。すると、鳥,とりがきて食,たべてしまった。","tok":[["ま"],["いて"],["いる"],["うち"],["に"],["、"],["道ばた","みちばた"],["に"],["落","おち"],["た"],["種","たね"],["が"],["あった"],["。"],["する"],["と"],["、"],["鳥","とり"],["が"],["きて"],["食べて","たべて"],["しまった"],["。"]]},{"verse":5,"text":"ほかの種,たねは土,つちの薄,うすい石地,いしじに落,おちた。そこは土,つちが深,ふかくないので、すぐ芽,めを出,だしたが、","tok":[["ほか"],["の"],["種","たね"],["は"],["土","つち"],["の"],["薄い","うすい"],["石地","いしじ"],["に"],["落","おち"],["た"],["。"],["そこ"],["は"],["土","つち"],["が"],["深く","ふかく"],["ない"],["ので"],["、"],["すぐ"],["芽","め"],["を"],["出した","だした"],["が"],["、"]]},{"verse":6,"text":"日,ひが上,のぼると焼,やけて、根,ねがないために枯,かれてしまった。","tok":[["日","ひ"],["が"],["上る","のぼる"],["と"],["焼","やけ"],["て"],["、"],["根","ね"],["が"],["ない"],["ため"],["に"],["枯て","かれて"],["しまった"],["。"]]},{"verse":7,"text":"ほかの種,たねはいばらの中,なかに落,おちた。すると、いばらが伸,のびて、ふさいでしまったので、実,みを結,むすばなかった。","tok":[["ほか"],["の"],["種","たね"],["は"],["いばら"],["の"],["中","なか"],["に"],["落","おち"],["た"],["。"],["する"],["と"],["、"],["いばら"],["が"],["伸びて","のびて"],["、"],["ふさいで"],["しまった"],["ので"],["、"],["実","み"],["を"],["結ばなかった","むすばなかった"],["。"]]},{"verse":8,"text":"ほかの種,たねは良,よい地,ちに落,おちた。そしてはえて、育,そだって、ますます実,みを結,むすび、三十倍,ばい、六十倍,ばい、百倍,ばいにもなった」。","tok":[["ほか"],["の"],["種","たね"],["は"],["良い","よい"],["地","ち"],["に"],["落","おち"],["た"],["。"],["そして"],["はえて"],["、"],["育って","そだって"],["、"],["ますます"],["実","み"],["を"],["結び","むすび"],["、"],["三十","さんじゅう"],["倍","ばい"],["い"],["、"],["六十","ろくじゅう"],["倍","ばい"],["い"],["、"],["百","ひゃく"],["倍","ばい"],["に"],["も"],["なった"],["」"],["。"]]},{"verse":9,"text":"そして言,いわれた、「聞,きく耳,みみのある者,ものは聞,きくがよい」。","tok":[["そして"],["言われた","いわれた"],["、"],["「"],["聞く","きく"],["耳","みみ"],["の"],["ある"],["者","もの"],["は"],["聞く","きく"],["が"],["よい"],["」"],["。"]]},{"verse":10,"text":"イエスがひとりになられた時,とき、そばにいた者,ものたちが、十二弟子,でしと共,ともに、これらの譬,たとえについて尋,たずねた。","tok":[["イエス"],["が"],["ひとり"],["に"],["なられた"],["時","とき"],["、"],["そば"],["に"],["いた"],["者","もの"],["たち"],["が"],["、"],["十二","じゅうに"],["弟子","でし"],["と"],["共","とも"],["に"],["、"],["これ"],["ら"],["の"],["譬","たとえ"],["について"],["尋ねた","たずねた"],["。"]]},{"verse":11,"text":"そこでイエスは言,いわれた、「あなたがたには神,かみの国,くにの奥義,おくぎが授,さづけられているが、ほかの者,ものたちには、すべてが譬,たとえで語,かたられる。","tok":[["そこ"],["で"],["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["あなた"],["がた"],["に"],["は"],["神","かみ"],["の"],["国","くに"],["の"],["奥義","お"],["くぎ"],["が"],["授","さ"],["づけられて"],["いる"],["が"],["、"],["ほか"],["の"],["者","もの"],["たち"],["に"],["は"],["、"],["すべて"],["が"],["譬","たとえ"],["で"],["語られる","かたられる"],["。"]]},{"verse":12,"text":"それは『彼,かれらは見,みるには見,みるが、認,みとめず、聞,きくには聞,きくが、悟,さとらず、悔,くい改,あらためてゆるされることがない』ためである」。","tok":[["それ"],["は"],["『"],["彼","かれ"],["ら"],["は"],["見る","みる"],["に"],["は"],["見る","みる"],["が"],["、"],["認めず","みとめず"],["、"],["聞く","きく"],["に"],["は"],["聞く","きく"],["が"],["、"],["悟らず","さとらず"],["、"],["悔い","くい"],["改","あらため"],["て"],["ゆるされる"],["こと"],["が"],["ない"],["』"],["ため"],["で"],["ある"],["」"],["。"]]},{"verse":13,"text":"また彼,かれらに言,いわれた、「あなたがたはこの譬,たとえがわからないのか。それでは、どうしてすべての譬,たとえがわかるだろうか。","tok":[["また"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["がた"],["は"],["この"],["譬","たとえ"],["が"],["わからない"],["の"],["か"],["。"],["それ"],["で"],["は"],["、"],["どう"],["して"],["すべて"],["の"],["譬","たとえ"],["が"],["わかるだろう"],["か"],["。"]]},{"verse":14,"text":"種,たねまきは御言,みことばをまくのである。","tok":[["種まき","たねまき"],["は"],["御言","みこと"],["ば"],["を"],["まく"],["ので"],["ある"],["。"]]},{"verse":15,"text":"道,みちばたに御言,みことばがまかれたとは、こういう人,ひとたちのことである。すなわち、御言,みことばを聞,きくと、すぐにサタンがきて、彼,かれらの中,なかにまかれた御言,みことばを、奪,うばって行,いくのである。","tok":[["道ばた","みちばた"],["に"],["御言","みこと"],["ば"],["が"],["まかれた"],["と"],["は"],["、"],["こう"],["いう"],["人","ひと"],["たち"],["の"],["こと"],["で"],["ある"],["。"],["すなわち"],["、"],["御言","みこと"],["ば"],["を"],["聞く","きく"],["と"],["、"],["すぐ"],["に"],["サタン"],["が"],["きて"],["、"],["彼","かれ"],["ら"],["の"],["中","なか"],["に"],["まかれた"],["御言","みこと"],["ば"],["を"],["、"],["奪って","うばって"],["行く","いく"],["ので"],["ある"],["。"]]},{"verse":16,"text":"同,おなじように、石地,いしじにまかれたものとは、こういう人,ひとたちのことである。御言,みことばを聞,きくと、すぐに喜,よろこんで受,うけるが、","tok":[["同じ","おなじ"],["よう"],["に"],["、"],["石地","いしじ"],["に"],["まかれた"],["もの"],["と"],["は"],["、"],["こう"],["いう"],["人","ひと"],["たち"],["の"],["こと"],["で"],["ある"],["。"],["御言","みこと"],["ば"],["を"],["聞く","きく"],["と"],["、"],["すぐ"],["に"],["喜こんで","よろこんで"],["受ける","うける"],["が"],["、"]]},{"verse":17,"text":"自分,じぶんの中,なかに根,ねがないので、しばらく続,つづくだけである。そののち、御言,みことばのために困難,こんなんや迫害,はくがいが起,おこってくると、すぐつまずいてしまう。","tok":[["自分","じぶん"],["の"],["中","なか"],["に"],["根","ね"],["が"],["ない"],["ので"],["、"],["しばらく"],["続","つづく"],["だけ"],["で"],["ある"],["。"],["その"],["のち"],["、"],["御言","みこと"],["ば"],["の"],["ため"],["に"],["困難","こんなん"],["や"],["迫害","はくがい"],["が"],["起こって","おこって"],["くる"],["と"],["、"],["すぐ"],["つまずいて"],["しまう"],["。"]]},{"verse":18,"text":"また、いばらの中,なかにまかれたものとは、こういう人,ひとたちのことである。御言,みことばを聞,きくが、","tok":[["また"],["、"],["いばら"],["の"],["中","なか"],["に"],["まかれた"],["もの"],["と"],["は"],["、"],["こう"],["いう"],["人","ひと"],["たち"],["の"],["こと"],["で"],["ある"],["。"],["御言","みこと"],["ば"],["を"],["聞く","きく"],["が"],["、"]]},{"verse":19,"text":"世,よの心,こころづかいと、富,とみの惑,まどわしと、その他,たいろいろな欲,よくとがはいってきて、御言,みことばをふさぐので、実,みを結,むすばなくなる。","tok":[["世","よ"],["の"],["心づかい","こころづかい"],["と"],["、"],["富","とみ"],["の"],["惑わし","まどわし"],["と"],["、"],["その"],["他","た"],["いろいろ"],["な"],["欲","よく"],["と"],["が"],["はいって"],["きて"],["、"],["御言","みこと"],["ば"],["を"],["ふさぐ"],["ので"],["、"],["実","み"],["を"],["結ばなく","むすばなく"],["なる"],["。"]]},{"verse":20,"text":"また、良,よい地,ちにまかれたものとは、こういう人,ひとたちのことである。御言,みことばを聞,きいて受,うけいれ、三十倍,ばい、六十倍,ばい、百倍,ばいの実,みを結,むすぶのである」。","tok":[["また"],["、"],["良い","よい"],["地","ち"],["に"],["まかれた"],["もの"],["と"],["は"],["、"],["こう"],["いう"],["人","ひと"],["たち"],["の"],["こと"],["で"],["ある"],["。"],["御言","みこと"],["ば"],["を"],["聞いて","きいて"],["受","うけ"],["いれ"],["、"],["三十","さんじゅう"],["倍","ばい"],["い"],["、"],["六十","ろくじゅう"],["倍","ばい"],["い"],["、"],["百","ひゃく"],["倍","ばい"],["の"],["実","み"],["を"],["結ぶ","むすぶ"],["ので"],["ある"],["」"],["。"]]},{"verse":21,"text":"また彼,かれらに言,いわれた、「ますの下,したや寝台,しんだいの下,したに置,おくために、あかりを持,もってくることがあろうか。燭台,しょくだいの上,うえに置,おくためではないか。","tok":[["また"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["ます"],["の"],["下","した"],["や"],["寝台","しんだい"],["の"],["下","した"],["に"],["置く","おく"],["ため"],["に"],["、"],["あかり"],["を"],["持って","もって"],["くる"],["こと"],["が"],["あろう"],["か"],["。"],["燭台","しょくだい"],["の"],["上","うえ"],["に"],["置く","おく"],["ため"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":22,"text":"なんでも、隠,かくされているもので、現,あらわれないものはなく、秘密,ひみつにされているもので、明,あかるみに出,でないものはない。","tok":[["なん"],["で"],["も"],["、"],["隠されて","かくされて"],["いる"],["もの"],["で"],["、"],["現われない","あらわれない"],["もの"],["は"],["なく"],["、"],["秘密","ひみつ"],["に"],["されて"],["いる"],["もの"],["で"],["、"],["明かるみ","あかるみ"],["に"],["出ない","でない"],["もの"],["は"],["ない"],["。"]]},{"verse":23,"text":"聞,きく耳,みみのある者,ものは聞,きくがよい」。","tok":[["聞く","きく"],["耳","みみ"],["の"],["ある"],["者","もの"],["は"],["聞く","きく"],["が"],["よい"],["」"],["。"]]},{"verse":24,"text":"また彼,かれらに言,いわれた、「聞,きくことがらに注意,ちゅういしなさい。あなたがたの量,はかるそのはかりで、自分,じぶんにも量,はかり与,あたえられ、その上,うえになお増,まし加,くわえられるであろう。","tok":[["また"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["聞く","きく"],["ことがら"],["に"],["注意","ちゅうい"],["し"],["なさい"],["。"],["あなた"],["がた"],["の"],["量る","はかる"],["その"],["はかり"],["で"],["、"],["自分","じぶん"],["に"],["も"],["量り","はかり"],["与えられ","あたえられ"],["、"],["その"],["上","うえ"],["に"],["なお"],["増し加えられるで","ましくわえられるで"],["あろう"],["。"]]},{"verse":25,"text":"だれでも、持,もっている人,ひとは更,さらに与,あたえられ、持,もっていない人,ひとは、持,もっているものまでも取,とり上,あげられるであろう」。","tok":[["だれ"],["で"],["も"],["、"],["持て","もって"],["いる"],["人","ひと"],["は"],["更に","さらに"],["与えられ","あたえられ"],["、"],["持て","もって"],["いない"],["人","ひと"],["は"],["、"],["持て","もって"],["いる"],["もの"],["まで"],["も"],["取上げられるで","とりあげられるで"],["あろう"],["」"],["。"]]},{"verse":26,"text":"また言,いわれた、「神,かみの国,くには、ある人,ひとが地,ちに種,たねをまくようなものである。","tok":[["また"],["言われた","いわれた"],["、"],["「"],["神","かみ"],["の"],["国","くに"],["は"],["、"],["ある"],["人","ひと"],["が"],["地","ち"],["に"],["種","たね"],["を"],["まく"],["よう"],["な"],["もの"],["で"],["ある"],["。"]]},{"verse":27,"text":"夜昼,よるひる、寝起,ねおきしている間,あいだに、種,たねは芽,めを出,だして育,そだって行,いくが、どうしてそうなるのか、その人,ひとは知,しらない。","tok":[["夜","よる"],["昼","ひる"],["、"],["寝起き","ねおき"],["して"],["いる"],["間","あいだ"],["に"],["、"],["種","たね"],["は"],["芽","め"],["を"],["出して","だして"],["育って","そだって"],["行く","いく"],["が"],["、"],["どう"],["して"],["そう"],["なる"],["の"],["か"],["、"],["その"],["人","ひと"],["は"],["知らない","しらない"],["。"]]},{"verse":28,"text":"地,ちはおのずから実,みを結,むすばせるもので、初,はじめに芽,め、つぎに穂,ほ、つぎに穂,ほの中,なかに豊,ゆたかな実,みができる。","tok":[["地","ち"],["は"],["おのずから"],["実","み"],["を"],["結ばせる","むすばせる"],["もの"],["で"],["、"],["初め","はじめ"],["に"],["芽","め"],["、"],["つぎ"],["に"],["穂","ほ"],["、"],["つぎ"],["に"],["穂","ほ"],["の"],["中","なか"],["に"],["豊","ゆたか"],["な"],["実","み"],["が"],["できる"],["。"]]},{"verse":29,"text":"実,みがいると、すぐにかまを入,いれる。刈入,かりいれ時,ときがきたからである」。","tok":[["実","み"],["が"],["いる"],["と"],["、"],["すぐ"],["に"],["かま"],["を"],["入れる","いれる"],["。"],["刈入れ","かりいれ"],["時","とき"],["が"],["きた"],["から"],["で"],["ある"],["」"],["。"]]},{"verse":30,"text":"また言,いわれた、「神,かみの国,くにを何,なにに比,くらべようか。また、どんな譬,たとえで言,いいあらわそうか。","tok":[["また"],["言われた","いわれた"],["、"],["「"],["神","かみ"],["の"],["国","くに"],["を"],["何に","なに"],["に"],["比べよう","くらべよう"],["か"],["。"],["また"],["、"],["どんな"],["譬","たとえ"],["で"],["言いあらわそう","いいあらわそう"],["か"],["。"]]},{"verse":31,"text":"それは一粒,つぶのからし種,たねのようなものである。地,ちにまかれる時,ときには、地上,ちじょうのどんな種,たねよりも小,ちいさいが、","tok":[["それ"],["は"],["一","いち"],["粒","つぶ"],["の"],["からし"],["種","たね"],["の"],["よう"],["な"],["もの"],["で"],["ある"],["。"],["地","ち"],["に"],["まかれる"],["時","とき"],["に"],["は"],["、"],["地上","ちじょう"],["の"],["どんな"],["種","たね"],["より"],["も"],["小さい","ちいさい"],["が"],["、"]]},{"verse":32,"text":"まかれると、成長,せいちょうしてどんな野菜,やさいよりも大,おおきくなり、大,おおきな枝,えだを張,はり、その陰,かげに空,そらの鳥,とりが宿,やどるほどになる」。","tok":[["ま"],["かれる"],["と"],["、"],["成長","せいちょう"],["して"],["どんな"],["野菜","やさい"],["より"],["も"],["大きく","おおきく"],["なり"],["、"],["大きな","おおきな"],["枝","えだ"],["を"],["張り","はり"],["、"],["その"],["陰","かげ"],["に"],["空","そら"],["の"],["鳥","とり"],["が"],["宿る","やどる"],["ほど"],["に"],["なる"],["」"],["。"]]},{"verse":33,"text":"イエスはこのような多,おおくの譬,たとえで、人々,ひとびとの聞,きく力,ちからにしたがって、御言,みことばを語,かたられた。","tok":[["イエス"],["は"],["この"],["よう"],["な"],["多く","おおく"],["の"],["譬","たとえ"],["で"],["、"],["人々","ひとびと"],["の"],["聞く","きく"],["力","ちから"],["に"],["したがって"],["、"],["御言","みこと"],["ば"],["を"],["語られた","かたられた"],["。"]]},{"verse":34,"text":"譬,たとえによらないでは語,かたられなかったが、自分,じぶんの弟子,でしたちには、ひそかにすべてのことを解,とき明,あかされた。","tok":[["譬","たとえ"],["に"],["よらないで"],["は"],["語られなかった","かたられなかった"],["が"],["、"],["自分","じぶん"],["の"],["弟子","でし"],["たち"],["に"],["は"],["、"],["ひそか"],["に"],["すべて"],["の"],["こと"],["を"],["解き明かされた","ときあかされた"],["。"]]},{"verse":35,"text":"さてその日,ひ、夕方,ゆうがたになると、イエスは弟子,でしたちに、「向,むこう岸,ぎしへ渡,わたろう」と言,いわれた。","tok":[["さて"],["その"],["日","ひ"],["、"],["夕方","ゆうがた"],["に"],["なる"],["と"],["、"],["イエス"],["は"],["弟子","でし"],["たち"],["に"],["、"],["「"],["向こう岸","むこうぎし"],["へ"],["渡ろう","わたろう"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":36,"text":"そこで、彼,かれらは群衆,ぐんしゅうをあとに残,のこし、イエスが舟,ふねに乗,のっておられるまま、乗,のり出,だした。ほかの舟,ふねも一緒,いっしょに行,いった。","tok":[["そこ"],["で"],["、"],["彼","かれ"],["ら"],["は"],["群衆","ぐんしゅう"],["を"],["あと"],["に"],["残し","のこし"],["、"],["イエス"],["が"],["舟","ふね"],["に"],["乗って","のって"],["おられる"],["まま"],["、"],["乗出した","のりだした"],["。"],["ほか"],["の"],["舟","ふね"],["も"],["一緒","いっしょ"],["に"],["行った","いった"],["。"]]},{"verse":37,"text":"すると、激,はげしい突風,とっぷうが起,おこり、波,なみが舟,ふねの中,なかに打,うち込,こんできて、舟,ふねに満,みちそうになった。","tok":[["する"],["と"],["、"],["激しい","はげしい"],["突風","とっぷう"],["が"],["起こり","おこり"],["、"],["波","なみ"],["が"],["舟","ふね"],["の"],["中","なか"],["に"],["打ち込んで","うちこんで"],["きて"],["、"],["舟","ふね"],["に"],["満ち","みち"],["そう"],["に"],["なった"],["。"]]},{"verse":38,"text":"ところがイエス自身,じしんは、舳,ともの方,ほうでまくらをして、眠,ねむっておられた。そこで、弟子,でしたちはイエスをおこして、「先生,せんせい、わたしどもがおぼれ死,しんでも、おかまいにならないのですか」と言,いった。","tok":[["ところ"],["が"],["イエス"],["自身","じしん"],["は"],["、"],["舳","とも"],["の"],["方","ほう"],["で"],["まくら"],["を"],["して"],["、"],["眠って","ねむって"],["おられた"],["。"],["そこ"],["で"],["、"],["弟子","でし"],["たち"],["は"],["イエス"],["を"],["おこして"],["、"],["「"],["先生","せんせい"],["、"],["わたし"],["ども"],["が"],["おぼれ死んで","おぼれしんで"],["も"],["、"],["おかまい"],["に"],["ならない"],["の"],["です"],["か"],["」"],["と"],["言った","いった"],["。"]]},{"verse":39,"text":"イエスは起,おきあがって風,かぜをしかり、海,うみにむかって、「静,しずまれ、黙,だまれ」と言,いわれると、風,かぜはやんで、大,おおなぎになった。","tok":[["イエス"],["は"],["起きあがって","おきあがって"],["風","かぜ"],["を"],["しかり"],["、"],["海","うみ"],["に"],["むかって"],["、"],["「"],["静まれ","しずまれ"],["、"],["黙れ","だまれ"],["」"],["と"],["言われる","いわれる"],["と"],["、"],["風","かぜ"],["は"],["やんで"],["、"],["大なぎ","おおなぎ"],["に"],["なった"],["。"]]},{"verse":40,"text":"イエスは彼,かれらに言,いわれた、「なぜ、そんなにこわがるのか。どうして信仰,しんこうがないのか」。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["なぜ"],["、"],["そんな"],["に"],["こわ"],["がる"],["の"],["か"],["。"],["どう"],["して"],["信仰","しんこう"],["が"],["ない"],["の"],["か"],["」"],["。"]]},{"verse":41,"text":"彼,かれらは恐,おそれおののいて、互,たがいに言,いった、「いったい、この方,ほうはだれだろう。風,かぜも海,うみも従,したがわせるとは」。","tok":[["彼","かれ"],["ら"],["は"],["恐れおののいて","おそれおののいて"],["、"],["互","たがい"],["に"],["言った","いった"],["、"],["「"],["いったい"],["、"],["この"],["方","ほう"],["は"],["だれ"],["だろう"],["。"],["風","かぜ"],["も"],["海","うみ"],["も"],["従わせる","したがわせる"],["と"],["は"],["」"],["。"]]}]
[{"verse":1,"text":"さてダビデは自分,じぶんの家,いえに住,すむようになったとき、預言者,よげんしゃナタンに言,いった、「見,みよ、わたしは香柏,こうはくの家,いえに住,すんでいるが、主,しゅの契約,けいやくの箱,はこは天幕,てんまくのうちにある」。","tok":[["さて"],["ダビデ"],["は"],["自分","じぶん"],["の"],["家","いえ"],["に"],["住む","すむ"],["よう"],["に"],["なった"],["とき"],["、"],["預言者","よげんしゃ"],["ナタン"],["に"],["言った","いった"],["、"],["「"],["見よ","みよ"],["、"],["わたし"],["は"],["香","こう"],["柏","かしわ"],["の"],["家","いえ"],["に"],["住んで","すんで"],["いる"],["が"],["、"],["主","しゅ"],["の"],["契約","けいやく"],["の"],["箱","はこ"],["は"],["天幕","てんまく"],["の"],["うち"],["に"],["ある"],["」"],["。"]]},{"verse":2,"text":"ナタンはダビデに言,いった、「神,かみがあなたとともにおられるから、すべてあなたの心,こころにあるところを行,おこないなさい」。","tok":[["ナタン"],["は"],["ダビデ"],["に"],["言った","いった"],["、"],["「"],["神","かみ"],["が"],["あなた"],["と"],["とも"],["に"],["おられる"],["から"],["、"],["すべて"],["あなた"],["の"],["心","こころ"],["に"],["ある"],["ところ"],["を"],["行ない","おこない"],["なさい"],["」"],["。"]]},{"verse":3,"text":"その夜,よる、神,かみの言葉,ことばがナタンに臨,のぞんで言,いった、","tok":[["その"],["夜","よる"],["、"],["神","かみ"],["の"],["言葉","ことば"],["が"],["ナタン"],["に"],["臨んで","のぞんで"],["言った","いった"],["、"]]},{"verse":4,"text":"「行,いってわたしのしもべダビデに告,つげよ、『主,しゅはこう言,いわれる、わたしの住,すむ家,いえを建,たててはならない。","tok":[["「"],["行って","いって"],["わたし"],["の"],["しもべ"],["ダビデ"],["に"],["告","つげ"],["よ"],["、"],["『"],["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["わたし"],["の"],["住む","すむ"],["家","いえ"],["を"],["建てて","たてて"],["は"],["ならない"],["。"]]},{"verse":5,"text":"わたしはイスラエルを導,みちびき上,のぼった日,ひから今日,こんにちまで、家,いえに住,すまわず、天幕,てんまくから天幕,てんまくに、幕屋,まくやから幕屋,まくやに移,うつったのである。","tok":[["わたし"],["は"],["イスラエル"],["を"],["導き","みちびき"],["上った","のぼった"],["日","ひ"],["から"],["今日","こん"],["に"],["ち"],["まで"],["、"],["家","いえ"],["に"],["住まわず","すまわず"],["、"],["天幕","てんまく"],["から"],["天幕","てんまく"],["に"],["、"],["幕屋","まくや"],["から"],["幕屋","まくや"],["に"],["移った","うつった"],["ので"],["ある"],["。"]]},{"verse":6,"text":"わたしがすべてのイスラエルと共,ともに歩,あゆんだすべての所,ところで、わたしの民,たみを牧,ぼくすることを命,めいじたイスラエルのさばきづかさのひとりに、ひと言,ことでも、「どうしてあなたがたは、わたしのために香柏,こうはくの家,いえを建,たてないのか」と言,いったことがあるだろうか』と。","tok":[["わたし"],["が"],["すべて"],["の"],["イスラエル"],["と"],["共","とも"],["に"],["歩んだ","あゆんだ"],["すべて"],["の"],["所","ところ"],["で"],["、"],["わたし"],["の"],["民","たみ"],["を"],["牧","ぼくするこ"],["と"],["を"],["命じた","めいじた"],["イスラエル"],["の"],["さばき"],["づかさ"],["の"],["ひとり"],["に"],["、"],["ひと言","ひとこと"],["で"],["も"],["、"],["「"],["どう"],["して"],["あなた"],["がた"],["は"],["、"],["わたし"],["の"],["ため"],["に"],["香","こう"],["柏","かしわ"],["の"],["家","いえ"],["を"],["建てない","たてない"],["の"],["か"],["」"],["と"],["言った","いった"],["こと"],["が"],["あるだろう"],["か"],["』"],["と"],["。"]]},{"verse":7,"text":"それゆえ今,いまあなたは、わたしのしもべダビデにこう言,いいなさい、『万軍,ばんぐんの主,しゅはこう仰,おおせられる、「わたしはあなたを牧場,まきばから、羊,ひつじに従,したがっている所,ところから取,とって、わたしの民,たみイスラエルの君,きみとし、","tok":[["それ"],["ゆえ"],["今","いま"],["あなた"],["は"],["、"],["わたし"],["の"],["しもべ"],["ダビデ"],["に"],["こう"],["言い","いい"],["なさい"],["、"],["『"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["こう"],["仰せられる","おおせられる"],["、"],["「"],["わたし"],["は"],["あなた"],["を"],["牧場","まきばか"],["ら"],["、"],["羊","ひつじ"],["に"],["従って","したがって"],["いる"],["所","ところ"],["から"],["取って","とって"],["、"],["わたし"],["の"],["民","たみ"],["イスラエル"],["の"],["君","きみ"],["と"],["し"],["、"]]},{"verse":8,"text":"あなたがどこへ行,いくにもあなたと共,ともにおり、あなたのすべての敵,てきをあなたの前,まえから断,たち去,さった。わたしはまた地,ちの上,うえの大,おおいなる者,ものの名,なのような名,なをあなたに得,えさせよう。","tok":[["あなた"],["が"],["どこ"],["へ"],["行く","いく"],["に"],["も"],["あなた"],["と"],["共","とも"],["に"],["おり"],["、"],["あなた"],["の"],["すべて"],["の"],["敵","てき"],["を"],["あなた"],["の"],["前","まえ"],["から"],["断ち","たち"],["去た","さった"],["。"],["わたし"],["は"],["また"],["地","ち"],["の"],["上","うえ"],["の"],["大いなる","おおいなる"],["者","もの"],["の"],["名","な"],["の"],["よう"],["な"],["名","な"],["を"],["あなた"],["に"],["得させよう","えさせよう"],["。"]]},{"verse":9,"text":"そしてわたしはわが民,たみイスラエルのために一つの所,ところを定,さだめて、彼,かれらを植,うえつけ、彼,かれらを自分,じぶんの所,ところに住,すませ、重,かさねて動,うごくことのないようにしよう。","tok":[["そして"],["わたし"],["は"],["わが"],["民","た"],["みイスラエル"],["の"],["ため"],["に"],["一","ひと"],["つ"],["の"],["所","ところ"],["を"],["定めて","さだめて"],["、"],["彼","かれ"],["ら"],["を"],["植えつけ","うえつけ"],["、"],["彼","かれ"],["ら"],["を"],["自分","じぶん"],["の"],["所","ところ"],["に"],["住ませ","すませ"],["、"],["重ねて","かさねて"],["動く","うごく"],["こと"],["の"],["ない"],["よう"],["に"],["しよう"],["。"]]},{"verse":10,"text":"また前,まえのように、すなわちわたしがわが民,たみイスラエルの上,うえにさばきづかさを立,たてた時,ときからこのかたのように、悪,わるい人,ひとが重,かさねてこれを荒,あらすことはないであろう。わたしはまたあなたのもろもろの敵,てきを征服,せいふくする。かつわたしは主,しゅがあなたのために家,いえを建,たてられることを告,つげる。","tok":[["また"],["前","まえ"],["の"],["よう"],["に"],["、"],["すなわち"],["わたし"],["が"],["わが"],["民","た"],["みイスラエル"],["の"],["上","うえ"],["に"],["さばき"],["づかさ"],["を"],["立てた","たてた"],["時","とき"],["から"],["このかた"],["の"],["よう"],["に"],["、"],["悪い","わるい"],["人","ひと"],["が"],["重ねて","かさねて"],["これ"],["を"],["荒す","あらす"],["こと"],["は"],["ないで"],["あろう"],["。"],["わたし"],["は"],["また"],["あなた"],["の"],["もろもろ"],["の"],["敵","てき"],["を"],["征服","せいふく"],["する"],["。"],["かつ"],["わたし"],["は"],["主","しゅ"],["が"],["あなた"],["の"],["ため"],["に"],["家","いえ"],["を"],["建てられる","たてられる"],["こと"],["を"],["告げる","つげる"],["。"]]},{"verse":11,"text":"あなたの日,ひが満,みち、あなたの先祖,せんぞたちの所,ところへ行,いかねばならぬとき、わたしはあなたの子,こ、すなわちあなたの子,こらのひとりを、あなたのあとに立,たてて、その王国,おうこくを堅,かたくする。","tok":[["あなた"],["の"],["日","ひ"],["が"],["満ち","みち"],["、"],["あなた"],["の"],["先祖","せんぞ"],["たち"],["の"],["所","ところ"],["へ"],["行かねば","いかねば"],["ならぬ"],["とき"],["、"],["わたし"],["は"],["あなた"],["の"],["子","こ"],["、"],["すなわち"],["あなた"],["の"],["子","こ"],["ら"],["の"],["ひとり"],["を"],["、"],["あなた"],["の"],["あと"],["に"],["立てて","たてて"],["、"],["その"],["王国","おうこく"],["を"],["堅く","かたく"],["する"],["。"]]},{"verse":12,"text":"彼,かれはわたしのために家,いえを建,たてるであろう。わたしは長,ながく彼,かれの位,くらいを堅,かたくする。","tok":[["彼","かれ"],["は"],["わたし"],["の"],["ため"],["に"],["家","いえ"],["を"],["建てるで","たてるで"],["あろう"],["。"],["わたし"],["は"],["長く","ながく"],["彼","かれ"],["の"],["位","くらい"],["を"],["堅く","かたく"],["する"],["。"]]},{"verse":13,"text":"わたしは彼,かれの父,ちちとなり、彼,かれはわたしの子,ことなる。わたしは、わたしのいつくしみを、あなたのさきにあった者,ものから取,とり去,さったように、彼,かれからは取,とり去,さらない。","tok":[["わたし"],["は"],["彼","かれ"],["の"],["父","ちち"],["と"],["なり"],["、"],["彼","かれ"],["は"],["わたし"],["の"],["子","こ"],["と"],["なる"],["。"],["わたし"],["は"],["、"],["わたし"],["の"],["いつくしみ"],["を"],["、"],["あなた"],["の"],["さき"],["に"],["あった"],["者","もの"],["から"],["取","とり"],["去た","さった"],["よう"],["に"],["、"],["彼","かれ"],["から"],["は"],["取去らない","とりさらない"],["。"]]},{"verse":14,"text":"かえって、わたしは彼,かれを長,ながくわたしの家,いえに、わたしの王国,おうこくにすえおく。彼,かれの位,くらいはとこしえに堅,かたく立,たつであろう』」。","tok":[["かえって"],["、"],["わたし"],["は"],["彼","かれ"],["を"],["長く","ながく"],["わたし"],["の"],["家","いえ"],["に"],["、"],["わたし"],["の"],["王国","おうこく"],["に"],["すえおく"],["。"],["彼","かれ"],["の"],["位","くらい"],["は"],["とこしえ"],["に"],["堅く","かたく"],["立つで","たつで"],["あろう"],["』"],["」"],["。"]]},{"verse":15,"text":"ナタンはすべてこれらの言葉,ことばのように、またすべてこの幻,まぼろしのようにダビデに語,かたった。","tok":[["ナタン"],["は"],["すべて"],["これ"],["ら"],["の"],["言葉","ことば"],["の"],["よう"],["に"],["、"],["また"],["すべて"],["この"],["幻","まぼろし"],["の"],["よう"],["に"],["ダビデ"],["に"],["語った","かたった"],["。"]]},{"verse":16,"text":"そこで、ダビデ王,おうは、はいって主,しゅの前,まえに座,ざして言,いった、「主,しゅなる神,かみよ、わたしがだれ、わたしの家,いえがなんであるので、あなたはこれまでわたしを導,みちびかれたのですか。","tok":[["そこ"],["で"],["、"],["ダビデ"],["王","おう"],["は"],["、"],["はい"],["って"],["主","しゅ"],["の"],["前","まえ"],["に"],["座して","ざして"],["言った","いった"],["、"],["「"],["主","しゅ"],["なる"],["神","かみ"],["よ"],["、"],["わたし"],["が"],["だれ"],["、"],["わたし"],["の"],["家","いえ"],["が"],["なん"],["で"],["ある"],["ので"],["、"],["あなた"],["は"],["これ"],["まで"],["わたし"],["を"],["導かれた","みちびかれた"],["の"],["です"],["か"],["。"]]},{"verse":17,"text":"神,かみよ、これはあなたの目,めには小,ちいさな事,ことです。主,しゅなる神,かみよ、あなたはしもべの家,いえについて、はるか後,のちの事,ことを語,かたって、きたるべき代々,よよのことを示,しめされました。","tok":[["神","かみ"],["よ"],["、"],["これ"],["は"],["あなた"],["の"],["目","め"],["に"],["は"],["小さな","ちいさな"],["事","こと"],["です"],["。"],["主","しゅ"],["なる"],["神","かみ"],["よ"],["、"],["あなた"],["は"],["しもべ"],["の"],["家","いえ"],["について"],["、"],["はるか"],["後","のち"],["の"],["事","こと"],["を"],["語って","かたって"],["、"],["きたるべき"],["代々","よよ"],["の"],["こと"],["を"],["示めされました","しめされました"],["。"]]},{"verse":18,"text":"しもべの名誉,めいよについては、ダビデはこの上,うえあなたに何,なにを申,もうしあげることができましょう。あなたはしもべを知,しっておられるからです。","tok":[["しもべ"],["の"],["名誉","めいよ"],["について"],["は"],["、"],["ダビデ"],["は"],["この"],["上","うえ"],["あなた"],["に"],["何に","なに"],["を"],["申しあげる","もうしあげる"],["こと"],["が"],["できましょう"],["。"],["あなた"],["は"],["しもべ"],["を"],["知って","しって"],["おられる"],["から"],["です"],["。"]]},{"verse":19,"text":"主,しゅよ、あなたはしもべのために、またあなたの心,こころにしたがって、このもろもろの大,おおいなる事,ことをなし、すべての大,おおいなる事,ことを知,しらされました。","tok":[["主","しゅ"],["よ"],["、"],["あなた"],["は"],["しもべ"],["の"],["ため"],["に"],["、"],["また"],["あなた"],["の"],["心","こころ"],["に"],["したがって"],["、"],["この"],["もろもろ"],["の"],["大いなる","おおいなる"],["事","こと"],["を"],["なし"],["、"],["すべて"],["の"],["大いなる","おおいなる"],["事","こと"],["を"],["知らされました","しらされました"],["。"]]},{"verse":20,"text":"主,しゅよ、われわれがすべて耳,みみに聞,きいた所,ところによれば、あなたのようなものはなく、またあなたのほかに神,かみはありません。","tok":[["主","しゅ"],["よ"],["、"],["われわれ"],["が"],["すべて"],["耳","みみ"],["に"],["聞いた","きいた"],["所","ところ"],["に"],["よれば"],["、"],["あなた"],["の"],["よう"],["な"],["もの"],["は"],["なく"],["、"],["また"],["あなた"],["の"],["ほか"],["に"],["神","かみ"],["は"],["ありません"],["。"]]},{"verse":21,"text":"また地上,ちじょうのどの国民,こくみんが、あなたの民,たみイスラエルのようでありましょうか。これは神,かみが行,いって、自分,じぶんのためにあがなって民,たみとし、エジプトからあなたがあがない出,だされたあなたの民,たみの前,まえから国々,くにぐにの民,たみを追,おい払,はらい、大,おおいなる恐,おそるべき事,ことを行,いって、名,なを得,えられたものではありませんか。","tok":[["また"],["地上","ちじょう"],["の"],["どの"],["国民","こくみん"],["が"],["、"],["あなた"],["の"],["民","たみ"],["イスラエル"],["の"],["よう"],["で"],["ありましょう"],["か"],["。"],["これ"],["は"],["神","かみ"],["が"],["行って","いって"],["、"],["自分","じぶん"],["の"],["ため"],["に"],["あがなって"],["民","た"],["み"],["と"],["し"],["、"],["エジプト"],["から"],["あなた"],["が"],["あがない"],["出された","だされた"],["あなた"],["の"],["民","たみ"],["の"],["前","まえ"],["から"],["国々","くにぐに"],["の"],["民","たみ"],["を"],["追い払","おいはらい"],["、"],["大いなる","おおいなる"],["恐るべき","おそるべき"],["事","こと"],["を"],["行って","いって"],["、"],["名","な"],["を"],["得られた","えられた"],["もの"],["で"],["は"],["ありません"],["か"],["。"]]},{"verse":22,"text":"あなたはあなたの民,たみイスラエルを長,ながくあなたの民,たみとされました。主,しゅよ、あなたは彼,かれらの神,かみとなられたのです。","tok":[["あなた"],["は"],["あなた"],["の"],["民","たみ"],["イスラエル"],["を"],["長く","ながく"],["あなた"],["の"],["民","たみ"],["と"],["されました"],["。"],["主","しゅ"],["よ"],["、"],["あなた"],["は"],["彼","かれ"],["ら"],["の"],["神","かみ"],["と"],["なられた"],["の"],["です"],["。"]]},{"verse":23,"text":"それゆえ主,しゅよ、あなたがしもべと、しもべの家,いえについて語,かたられた言葉,ことばを長,ながく堅,かたくして、あなたの言,いわれたとおりにしてください。","tok":[["それ"],["ゆえ"],["主","しゅ"],["よ"],["、"],["あなた"],["が"],["しもべ"],["と"],["、"],["しもべ"],["の"],["家","いえ"],["について"],["語られた","かたられた"],["言葉","ことば"],["を"],["長く","ながく"],["堅く","かたく"],["して"],["、"],["あなた"],["の"],["言われた","いわれた"],["とおり"],["に"],["して"],["ください"],["。"]]},{"verse":24,"text":"そうすればあなたの名,なはとこしえに堅,かたくされ、あがめられて、『イスラエルの神,かみ、万軍,ばんぐんの主,しゅはイスラエルの神,かみである』と言,いわれ、またあなたのしもべダビデの家,いえはあなたの前,まえに堅,かたく立,たつことができるでしょう。","tok":[["そう"],["すれば"],["あなた"],["の"],["名","な"],["は"],["とこしえ"],["に"],["堅く","かたく"],["され"],["、"],["あがめられて"],["、"],["『"],["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["イスラエル"],["の"],["神","かみ"],["で"],["ある"],["』"],["と"],["言われ","いわれ"],["、"],["また"],["あなた"],["の"],["しもべ"],["ダビデ"],["の"],["家","いえ"],["は"],["あなた"],["の"],["前","まえ"],["に"],["堅く","かたく"],["立つ","たつ"],["こと"],["が"],["できるでしょう"],["。"]]},{"verse":25,"text":"わが神,かみよ、あなたは彼,かれのために家,いえを建,たてると、しもべに示,しめされました。それゆえ、しもべはあなたの前,まえに祈,いのる勇気,ゆうきを得,えました。","tok":[["わが"],["神","かみ"],["よ"],["、"],["あなた"],["は"],["彼","かれ"],["の"],["ため"],["に"],["家","いえ"],["を"],["建てる","たてる"],["と"],["、"],["しもべ"],["に"],["示めされました","しめされました"],["。"],["それ"],["ゆえ"],["、"],["しもべ"],["は"],["あなた"],["の"],["前","まえ"],["に"],["祈る","いのる"],["勇気","ゆうき"],["を"],["得ました","えました"],["。"]]},{"verse":26,"text":"主,しゅよ、あなたは神,かみにいまし、この良,よき事,ことをしもべに約束,やくそくされました。","tok":[["主","しゅ"],["よ"],["、"],["あなた"],["は"],["神","かみ"],["に"],["いまし"],["、"],["この"],["良き","よき"],["事","こと"],["を"],["しもべ"],["に"],["約束","やくそく"],["されました"],["。"]]},{"verse":27,"text":"それゆえどうぞいま、しもべの家,いえを祝福,しゅくふくし、あなたの前,まえに長,ながく続,つづかせてくださるように。主,しゅよ、あなたの祝福,しゅくふくされるものは長,ながく祝福,しゅくふくを受,うけるからです」。","tok":[["それ"],["ゆえ"],["どうぞ"],["いま"],["、"],["しもべ"],["の"],["家","いえ"],["を"],["祝福","しゅくふく"],["し"],["、"],["あなた"],["の"],["前","まえ"],["に"],["長く","ながく"],["続かせて","つづかせて"],["くださる"],["よう"],["に"],["。"],["主","しゅ"],["よ"],["、"],["あなた"],["の"],["祝福","しゅくふく"],["される"],["もの"],["は"],["長く","ながく"],["祝福","しゅくふく"],["を"],["受る","うける"],["から"],["です"],["」"],["。"]]}]
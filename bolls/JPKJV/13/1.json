[{"verse":1,"text":"アダム、セツ、エノス、","tok":[["アダム"],["、"],["セツ"],["、"],["エノス"],["、"]]},{"verse":2,"text":"ケナン、マハラレル、ヤレド、","tok":[["ケナン"],["、"],["マハラレル"],["、"],["ヤレド"],["、"]]},{"verse":3,"text":"エノク、メトセラ、ラメク、","tok":[["エノク"],["、"],["メトセラ"],["、"],["ラメク"],["、"]]},{"verse":4,"text":"ノア、セム、ハム、ヤペテ。","tok":[["ノア"],["、"],["セム"],["、"],["ハム"],["、"],["ヤペテ"],["。"]]},{"verse":5,"text":"ヤペテの子,こらはゴメル、マゴグ、マダイ、ヤワン、トバル、メセク、テラス。","tok":[["ヤペテ"],["の"],["子","こ"],["ら"],["は"],["ゴメル"],["、"],["マゴグ"],["、"],["マダイ"],["、"],["ヤワン"],["、"],["トバル"],["、"],["メセク"],["、"],["テラス"],["。"]]},{"verse":6,"text":"ゴメルの子,こらはアシケナズ、デパテ、トガルマ。","tok":[["ゴメル"],["の"],["子","こ"],["ら"],["は"],["アシケナズ"],["、"],["デパテ"],["、"],["トガルマ"],["。"]]},{"verse":7,"text":"ヤワンの子,こらはエリシャ、タルシシ、キッテム、ロダニム。","tok":[["ヤワン"],["の"],["子","こ"],["ら"],["は"],["エリシャ"],["、"],["タルシシ"],["、"],["キッテム"],["、"],["ロダニム"],["。"]]},{"verse":8,"text":"ハムの子,こらはクシ、エジプト、プテ、カナン。","tok":[["ハム"],["の"],["子","こ"],["ら"],["は"],["クシ"],["、"],["エジプト"],["、"],["プテ"],["、"],["カナン"],["。"]]},{"verse":9,"text":"クシの子,こらはセバ、ハビラ、サブタ、ラアマ、サブテカ。ラアマの子,こらはシバとデダン。","tok":[["クシ"],["の"],["子","こ"],["ら"],["は"],["セバ"],["、"],["ハビラ"],["、"],["サブタ"],["、"],["ラアマ"],["、"],["サブテカ"],["。"],["ラアマ"],["の"],["子","こ"],["ら"],["は"],["シバ"],["と"],["デダン"],["。"]]},{"verse":10,"text":"クシはニムロデを生,うんだ。ニムロデは初,はじめて世,よの権力,けんりょくある者,ものとなった。","tok":[["クシ"],["は"],["ニムロデ"],["を"],["生んだ","うんだ"],["。"],["ニムロデ"],["は"],["初めて","はじめて"],["世","よ"],["の"],["権力","けんりょく"],["ある"],["者","もの"],["と"],["なった"],["。"]]},{"verse":11,"text":"エジプトはルデびと、アナムびと、レハブびと、ナフトびと、","tok":[["エジプト"],["は"],["ルデ"],["び"],["と"],["、"],["アナム"],["び"],["と"],["、"],["レハブ"],["び"],["と"],["、"],["ナフト"],["び"],["と"],["、"]]},{"verse":12,"text":"パテロスびと、カスルびと、カフトルびとを生,うんだ。カフトルびとからペリシテびとが出,でた。","tok":[["パテロス"],["び"],["と"],["、"],["カスル"],["び"],["と"],["、"],["カフトル"],["びと"],["を"],["生んだ","うんだ"],["。"],["カフトル"],["びと"],["から"],["ペリシテ"],["びと"],["が"],["出た","でた"],["。"]]},{"verse":13,"text":"カナンは長子,ちょうしシドンとヘテを生,うんだ。","tok":[["カナン"],["は"],["長子","ちょうし"],["シドン"],["と"],["ヘテ"],["を"],["生んだ","うんだ"],["。"]]},{"verse":14,"text":"またエブスびと、アモリびと、ギルガシびと、","tok":[["また"],["エブス"],["び"],["と"],["、"],["アモリ"],["び"],["と"],["、"],["ギルガシ"],["び"],["と"],["、"]]},{"verse":15,"text":"ヒビびと、アルキびと、セニびと、","tok":[["ヒビ"],["び"],["と"],["、"],["アルキ"],["び"],["と"],["、"],["セニ"],["び"],["と"],["、"]]},{"verse":16,"text":"アルワデびと、ゼマリびと、ハマテびとを生,うんだ。","tok":[["アルワデ"],["び"],["と"],["、"],["ゼマリ"],["び"],["と"],["、"],["ハマテ"],["びと"],["を"],["生んだ","うんだ"],["。"]]},{"verse":17,"text":"セムの子,こらはエラム、アシュル、アルパクサデ、ルデ、アラム、ウズ、ホル、ゲテル、メセクである。","tok":[["セム"],["の"],["子","こ"],["ら"],["は"],["エラム"],["、"],["アシュル"],["、"],["アルパクサデ"],["、"],["ルデ"],["、"],["アラム"],["、"],["ウズ"],["、"],["ホル"],["、"],["ゲテル"],["、"],["メセク"],["で"],["ある"],["。"]]},{"verse":18,"text":"アルパクサデはシラを生,うみ、シラはエベルを生,うんだ。","tok":[["アルパクサデ"],["は"],["シラ"],["を"],["生み","うみ"],["、"],["シラ"],["は"],["エベル"],["を"],["生んだ","うんだ"],["。"]]},{"verse":19,"text":"エベルにふたりの子,こが生,うまれた。ひとりの名,なはペレグ――彼,かれの代,よに地,ちの民,たみが散,ちり分,わかれたからである――その弟,おとうとの名,なはヨクタンといった。","tok":[["エベル"],["に"],["ふたり"],["の"],["子","こ"],["が"],["生まれた","うまれた"],["。"],["ひとり"],["の"],["名","な"],["は"],["ペレグ"],["―"],["―"],["彼","かれ"],["の"],["代","よ"],["に"],["地","ち"],["の"],["民","たみ"],["が"],["散り","ちり"],["分かれた","わかれた"],["から"],["で"],["ある"],["―"],["―"],["その"],["弟","おとうと"],["の"],["名","な"],["は"],["ヨクタン"],["と"],["いった"],["。"]]},{"verse":20,"text":"ヨクタンはアルモダデ、シャレフ、ハザル・マウテ、エラ、","tok":[["ヨクタン"],["は"],["アルモダデ"],["、"],["シャレフ"],["、"],["ハザル"],["・"],["マウテ"],["、"],["エラ"],["、"]]},{"verse":21,"text":"ハドラム、ウザル、デクラ、","tok":[["ハドラム"],["、"],["ウザル"],["、"],["デクラ"],["、"]]},{"verse":22,"text":"エバル、アビマエル、シバ、","tok":[["エバル"],["、"],["アビマエル"],["、"],["シバ"],["、"]]},{"verse":23,"text":"オフル、ハビラ、ヨバブを生,うんだ。これらはみなヨクタンの子,こである。","tok":[["オフル"],["、"],["ハビラ"],["、"],["ヨバブ"],["を"],["生んだ","うんだ"],["。"],["これ"],["ら"],["は"],["みな"],["ヨクタン"],["の"],["子","こ"],["で"],["ある"],["。"]]},{"verse":24,"text":"セム、アルパクサデ、シラ、","tok":[["セム"],["、"],["アルパクサデ"],["、"],["シラ"],["、"]]},{"verse":25,"text":"エベル、ペレグ、リウ、","tok":[["エベル"],["、"],["ペレグ"],["、"],["リウ"],["、"]]},{"verse":26,"text":"セルグ、ナホル、テラ、","tok":[["セルグ"],["、"],["ナホル"],["、"],["テラ"],["、"]]},{"verse":27,"text":"アブラムすなわちアブラハムである。","tok":[["アブラム"],["すなわち"],["アブラハム"],["で"],["ある"],["。"]]},{"verse":28,"text":"アブラハムの子,こらはイサクとイシマエルである。","tok":[["アブラハム"],["の"],["子","こ"],["ら"],["は"],["イサク"],["と"],["イシマエル"],["で"],["ある"],["。"]]},{"verse":29,"text":"彼,かれらの子孫,しそんは次,つぎのとおりである。イシマエルの長子,ちょうしはネバヨテ、次,つぎはケダル、アデビエル、ミブサム、","tok":[["彼","かれ"],["ら"],["の"],["子孫","しそん"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["イシマエル"],["の"],["長子","ちょうし"],["は"],["ネバヨテ"],["、"],["次","つぎ"],["は"],["ケダル"],["、"],["アデビエル"],["、"],["ミブサム"],["、"]]},{"verse":30,"text":"ミシマ、ドマ、マッサ、ハダデ、テマ、","tok":[["ミシマ"],["、"],["ドマ"],["、"],["マッサ"],["、"],["ハダデ"],["、"],["テマ"],["、"]]},{"verse":31,"text":"エトル、ネフシ、ケデマ。これらはイシマエルの子孫,しそんである。","tok":[["エトル"],["、"],["ネフシ"],["、"],["ケデマ"],["。"],["これ"],["ら"],["は"],["イシマエル"],["の"],["子孫","しそん"],["で"],["ある"],["。"]]},{"verse":32,"text":"アブラハムのそばめケトラの子孫,しそんは次,つぎのとおりである。彼女,かのじょはジムラン、ヨクシャン、メダン、ミデアン、イシバク、シュワを産,うんだ。ヨクシャンの子,こらはシバとデダンである。","tok":[["アブラハム"],["の"],["そばめ"],["ケトラ"],["の"],["子孫","しそん"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["彼女","かのじょ"],["は"],["ジムラン"],["、"],["ヨクシャン"],["、"],["メダン"],["、"],["ミデアン"],["、"],["イシバク"],["、"],["シュワ"],["を"],["産んだ","うんだ"],["。"],["ヨクシャン"],["の"],["子","こ"],["ら"],["は"],["シバ"],["と"],["デダン"],["で"],["ある"],["。"]]},{"verse":33,"text":"ミデアンの子,こらはエパ、エペル、ヘノク、アビダ、エルダア。これらはみなケトラの子孫,しそんである。","tok":[["ミデアン"],["の"],["子","こ"],["ら"],["は"],["エパ"],["、"],["エペル"],["、"],["ヘノク"],["、"],["アビダ"],["、"],["エルダア"],["。"],["これ"],["ら"],["は"],["みな"],["ケトラ"],["の"],["子孫","しそん"],["で"],["ある"],["。"]]},{"verse":34,"text":"アブラハムはイサクを生,うんだ。イサクの子,こらはエサウとイスラエル。","tok":[["アブラハム"],["は"],["イサク"],["を"],["生んだ","うんだ"],["。"],["イサク"],["の"],["子","こ"],["ら"],["は"],["エサウ"],["と"],["イスラエル"],["。"]]},{"verse":35,"text":"エサウの子,こらはエリパズ、リウエル、エウシ、ヤラム、コラ。","tok":[["エサウ"],["の"],["子","こ"],["ら"],["は"],["エリパズ"],["、"],["リウエル"],["、"],["エウシ"],["、"],["ヤラム"],["、"],["コラ"],["。"]]},{"verse":36,"text":"エリパズの子,こらはテマン、オマル、ゼピ、ガタム、ケナズ、テムナ、アマレク。","tok":[["エリパズ"],["の"],["子","こ"],["ら"],["は"],["テマン"],["、"],["オマル"],["、"],["ゼピ"],["、"],["ガタム"],["、"],["ケナズ"],["、"],["テムナ"],["、"],["アマレク"],["。"]]},{"verse":37,"text":"リウエルの子,こらはナハテ、ゼラ、シャンマ、ミッザ。","tok":[["リウエル"],["の"],["子","こ"],["ら"],["は"],["ナハテ"],["、"],["ゼラ"],["、"],["シャンマ"],["、"],["ミッザ"],["。"]]},{"verse":38,"text":"セイルの子,こらはロタン、ショバル、ヂベオン、アナ、デション、エゼル、デシャン。","tok":[["セイル"],["の"],["子","こ"],["ら"],["は"],["ロタン"],["、"],["ショバル"],["、"],["ヂベオン"],["、"],["アナ"],["、"],["デション"],["、"],["エゼル"],["、"],["デシャン"],["。"]]},{"verse":39,"text":"ロタンの子,こらはホリとホマム。ロタンの妹,いもうとはテムナ。","tok":[["ロタン"],["の"],["子","こ"],["ら"],["は"],["ホリ"],["と"],["ホマム"],["。"],["ロタン"],["の"],["妹","いもうと"],["は"],["テムナ"],["。"]]},{"verse":40,"text":"ショバルの子,こらはアルヤン、マナハテ、エバル、シピ、オナム。ヂベオンの子,こらはアヤとアナ。","tok":[["ショバル"],["の"],["子","こ"],["ら"],["は"],["アルヤン"],["、"],["マナハテ"],["、"],["エバル"],["、"],["シピ"],["、"],["オナム"],["。"],["ヂベオン"],["の"],["子","こ"],["ら"],["は"],["アヤ"],["と"],["アナ"],["。"]]},{"verse":41,"text":"アナの子,こはデション。デションの子,こらはハムラン、エシバン、イテラン、ケラン。","tok":[["アナ"],["の"],["子","こ"],["は"],["デション"],["。"],["デション"],["の"],["子","こ"],["ら"],["は"],["ハムラン"],["、"],["エシバン"],["、"],["イテラン"],["、"],["ケラン"],["。"]]},{"verse":42,"text":"エゼルの子,こらはビルハン、ザワン、ヤカン。デシャンの子,こらはウズとアラン。","tok":[["エゼル"],["の"],["子","こ"],["ら"],["は"],["ビルハン"],["、"],["ザワン"],["、"],["ヤカン"],["。"],["デシャン"],["の"],["子","こ"],["ら"],["は"],["ウズ"],["と"],["アラン"],["。"]]},{"verse":43,"text":"イスラエルの人々,ひとびとを治,おさめる王,おうがまだなかった時,とき、エドムの地,ちを治,おさめた王,おうたちは次,つぎのとおりである。ベオルの子,こベラ。その都,みやこの名,なはデナバといった。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["を"],["治める","おさめる"],["王","おう"],["が"],["まだ"],["なかった"],["時","とき"],["、"],["エドム"],["の"],["地","ち"],["を"],["治めた","おさめた"],["王","おう"],["たち"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["ベオル"],["の"],["子","こ"],["ベラ"],["。"],["その"],["都","みやこ"],["の"],["名","な"],["は"],["デナバ"],["と"],["いった"],["。"]]},{"verse":44,"text":"ベラが死,しんで、ボズラのゼラの子,こヨバブが代,かわって王,おうとなった。","tok":[["ベラ"],["が"],["死んで","しんで"],["、"],["ボズラ"],["の"],["ゼラ"],["の"],["子","こ"],["ヨバブ"],["が"],["代わって","かわって"],["王","おう"],["と"],["なった"],["。"]]},{"verse":45,"text":"ヨバブが死,しんで、テマンびとの地,ちのホシャムが代,かわって王,おうとなった。","tok":[["ヨバブ"],["が"],["死んで","しんで"],["、"],["テマン"],["びと"],["の"],["地","ち"],["の"],["ホシャム"],["が"],["代わって","かわって"],["王","おう"],["と"],["なった"],["。"]]},{"verse":46,"text":"ホシャムが死,しんで、ベダテの子,こハダデが代,かわって王,おうとなった。彼,かれはモアブの野,のでミデアンを撃,うった。彼,かれの都,みやこの名,なはアビテといった。","tok":[["ホシャム"],["が"],["死んで","しんで"],["、"],["ベダテ"],["の"],["子","こ"],["ハダデ"],["が"],["代わって","かわって"],["王","おう"],["と"],["なった"],["。"],["彼","かれ"],["は"],["モアブ"],["の"],["野","の"],["で"],["ミデアン"],["を"],["撃った","うった"],["。"],["彼","かれ"],["の"],["都","みやこ"],["の"],["名","な"],["は"],["アビテ"],["と"],["いった"],["。"]]},{"verse":47,"text":"ハダデが死,しんで、マスレカのサムラが代,かわって王,おうとなった。","tok":[["ハダデ"],["が"],["死んで","しんで"],["、"],["マスレカ"],["の"],["サムラ"],["が"],["代わって","かわって"],["王","おう"],["と"],["なった"],["。"]]},{"verse":48,"text":"サムラが死,しんで、ユフラテ川,かわのほとりのレホボテのサウルが代,かわって王,おうとなった。","tok":[["サムラ"],["が"],["死んで","しんで"],["、"],["ユフラテ"],["川","かわ"],["の"],["ほとり"],["の"],["レホボテ"],["の"],["サウル"],["が"],["代わって","かわって"],["王","おう"],["と"],["なった"],["。"]]},{"verse":49,"text":"サウルが死,しんで、アクボルの子,こバアル・ハナンが代,かわって王,おうとなった。","tok":[["サウル"],["が"],["死んで","しんで"],["、"],["アクボル"],["の"],["子","こ"],["バアル"],["・"],["ハナン"],["が"],["代わって","かわって"],["王","おう"],["と"],["なった"],["。"]]},{"verse":50,"text":"バアル・ハナンが死,しんで、ハダデが代,かわって王,おうとなった。彼,かれの都,みやこの名,なはパイといった。彼,かれの妻,つまはマテレデの娘,むすめであって、名,なをメヘタベルといった。マテレデはメザハブの娘,むすめである。","tok":[["バアル"],["・"],["ハナン"],["が"],["死んで","しんで"],["、"],["ハダデ"],["が"],["代わって","かわって"],["王","おう"],["と"],["なった"],["。"],["彼","かれ"],["の"],["都","みやこ"],["の"],["名","な"],["は"],["パイ"],["と"],["いった"],["。"],["彼","かれ"],["の"],["妻","つま"],["は"],["マテレデ"],["の"],["娘","むすめ"],["で"],["あって"],["、"],["名","な"],["を"],["メヘタベル"],["と"],["いった"],["。"],["マテレデ"],["は"],["メザハブ"],["の"],["娘","むすめ"],["で"],["ある"],["。"]]},{"verse":51,"text":"ハダデも死,しんだ。エドムの族長,ぞくちょうは、テムナ侯,こう、アルヤ侯,こう、エテテ侯,こう、","tok":[["ハダデ"],["も"],["死んだ","しんだ"],["。"],["エドム"],["の"],["族長","ぞくちょう"],["は"],["、"],["テムナ侯","てむなこう"],["、"],["アルヤ侯","あるやこう"],["、"],["エテテ侯","えててこう"],["、"]]},{"verse":52,"text":"アホリバマ侯,こう、エラ侯,こう、ピノン侯,こう、","tok":[["アホリバマ"],["侯","こう"],["、"],["エラ侯","えらこう"],["、"],["ピノン侯","ぴのんこう"],["、"]]},{"verse":53,"text":"ケナズ侯,こう、テマン侯,こう、ミブザル侯,こう、","tok":[["ケナズ侯","けなずこう"],["、"],["テマン侯","てまんこう"],["、"],["ミブザル"],["侯","こう"],["、"]]},{"verse":54,"text":"マグデエル侯,こう、イラム侯,こう。これらはエドムの族長,ぞくちょうである。","tok":[["マグデエル"],["侯","こう"],["、"],["イラム"],["侯","こう"],["。"],["これ"],["ら"],["は"],["エドム"],["の"],["族長","ぞくちょう"],["で"],["ある"],["。"]]}]
[{"verse":1,"text":"イッサカルの子,こらはトラ、プワ、ヤシュブ、シムロムの四人,にん。","tok":[["イッサカル"],["の"],["子","こ"],["ら"],["は"],["トラ"],["、"],["プワ"],["、"],["ヤシュブ"],["、"],["シムロム"],["の"],["四人","にん"],["。"]]},{"verse":2,"text":"トラの子,こらはウジ、レパヤ、エリエル、ヤマイ、エブサム、サムエル。これは皆,みなトラの子,こで、その氏族,しぞくの長,ちょうである。その子孫,しそんの大,だい勇士,ゆうしたる者,ものはダビデの世,よにはその数,かず二万二千六百人,にんであった。","tok":[["トラ"],["の"],["子","こ"],["ら"],["は"],["ウジ"],["、"],["レパヤ"],["、"],["エリエル"],["、"],["ヤマイ"],["、"],["エブサム"],["、"],["サムエル"],["。"],["これ"],["は"],["皆","みな"],["トラ"],["の"],["子","こ"],["で"],["、"],["その"],["氏族","しぞく"],["の"],["長","ちょう"],["で"],["ある"],["。"],["その"],["子孫","しそん"],["の"],["大","だい"],["勇士","ゆうし"],["たる"],["者","もの"],["は"],["ダビデ"],["の"],["世","よ"],["に"],["は"],["その"],["数","か"],["ず"],["二万二千六百","にまんにせんろくひゃく"],["人","にん"],["で"],["あった"],["。"]]},{"verse":3,"text":"ウジの子,こはイズラヒヤ、イズラヒヤの子,こらはミカエル、オバデヤ、ヨエル、イシアの五人,にんで、みな長,ちょうたる者,ものであった。","tok":[["ウジ"],["の"],["子","こ"],["は"],["イズラヒヤ"],["、"],["イズラヒヤ"],["の"],["子","こ"],["ら"],["は"],["ミカエル"],["、"],["オバデヤ"],["、"],["ヨエル"],["、"],["イシア"],["の"],["五人","にん"],["で"],["、"],["みな"],["長たる","ちょうたる"],["者","もの"],["で"],["あった"],["。"]]},{"verse":4,"text":"その子孫,しそんのうちに、その氏族,しぞくに従,したがえば軍勢,ぐんぜいの士卒,しそつ三万六千人,にんあった。これは彼,かれらが妻子,さいしを多,おおくもっていたからである。","tok":[["その"],["子孫","しそん"],["の"],["うち"],["に"],["、"],["その"],["氏族","しぞく"],["に"],["従えば","したがえば"],["軍勢","ぐんぜい"],["の"],["士卒","しそつ"],["三万六千","さんまんろくせん"],["人","にん"],["あった"],["。"],["これ"],["は"],["彼","かれ"],["ら"],["が"],["妻子","さいし"],["を"],["多く","おおく"],["もって"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":5,"text":"イッサカルのすべての氏族,しぞくのうちの兄弟,きょうだいたちで系図,けいずによって数,かぞえられた大,だい勇士,ゆうしは合,あわせて八万七千人,にんあった。","tok":[["イッサカル"],["の"],["すべて"],["の"],["氏族","しぞく"],["の"],["うち"],["の"],["兄弟","きょうだい"],["たち"],["で"],["系図","けいず"],["によって"],["数えられた","かぞえられた"],["大","だい"],["勇士","ゆうし"],["は"],["合","あわせ"],["て"],["八万七千","はちまんななせん"],["人","にん"],["あった"],["。"]]},{"verse":6,"text":"ベニヤミンの子,こらはベラ、ベケル、エデアエルの三人,にん。","tok":[["ベニヤミン"],["の"],["子","こ"],["ら"],["は"],["ベラ"],["、"],["ベケル"],["、"],["エデアエル"],["の"],["三人","にん"],["。"]]},{"verse":7,"text":"ベラの子,こらはエヅボン、ウジ、ウジエル、エレモテ、イリの五人,にんで、皆,みなその氏族,しぞくの長,ちょうである。その系図,けいずによって数,かぞえられた大,だい勇士,ゆうしは二万二千三十四人,にんあった。","tok":[["ベラ"],["の"],["子","こ"],["ら"],["は"],["エヅボン"],["、"],["ウジ"],["、"],["ウジエル"],["、"],["エレモテ"],["、"],["イリ"],["の"],["五人","にん"],["で"],["、"],["皆","みな"],["その"],["氏族","しぞく"],["の"],["長","ちょう"],["で"],["ある"],["。"],["その"],["系図","けいず"],["によって"],["数えられた","かぞえられた"],["大","だい"],["勇士","ゆうし"],["は"],["二万二千三十四","にまんにせんみつじゅうよん"],["人","にん"],["あった"],["。"]]},{"verse":8,"text":"ベケルの子,こらはゼミラ、ヨアシ、エリエゼル、エリオエナイ、オムリ、エレモテ、アビヤ、アナトテ、アラメテで皆,みなベケルの子,こらである。","tok":[["ベケル"],["の"],["子","こ"],["ら"],["は"],["ゼミラ"],["、"],["ヨアシ"],["、"],["エリエゼル"],["、"],["エリオエナイ"],["、"],["オムリ"],["、"],["エレモテ"],["、"],["アビヤ"],["、"],["アナトテ"],["、"],["アラメテ"],["で"],["皆","みな"],["ベケル"],["の"],["子","こ"],["ら"],["で"],["ある"],["。"]]},{"verse":9,"text":"その子孫,しそんのうち、その氏族,しぞくの長,ちょうとして系図,けいずによって数,かぞえられた大,だい勇士,ゆうしは二万二百人,にんあった。","tok":[["その"],["子孫","しそん"],["の"],["うち"],["、"],["その"],["氏族","しぞく"],["の"],["長","ちょう"],["として"],["系図","けいず"],["によって"],["数えられた","かぞえられた"],["大","だい"],["勇士","ゆうし"],["は"],["二万二百","にまんにひゃく"],["人","にん"],["あった"],["。"]]},{"verse":10,"text":"エデアエルの子,こはビルハン。ビルハンの子,こらはエウシ、ベニヤミン、エホデ、ケナアナ、ゼタン、タルシシ、アヒシャハル。","tok":[["エデアエル"],["の"],["子","こ"],["は"],["ビルハン"],["。"],["ビルハン"],["の"],["子","こ"],["ら"],["は"],["エウシ"],["、"],["ベニヤミン"],["、"],["エホデ"],["、"],["ケナアナ"],["、"],["ゼタン"],["、"],["タルシシ"],["、"],["アヒシャハル"],["。"]]},{"verse":11,"text":"皆,みなエデアエルの子,こらで氏族,しぞくの長,ちょうであった。その子孫,しそんのうちには、いくさに出,でてよく戦,たたかう大,だい勇士,ゆうしが一万七千二百人,にんあった。","tok":[["皆","みな"],["エデアエル"],["の"],["子","こ"],["ら"],["で"],["氏族","しぞく"],["の"],["長","ちょう"],["で"],["あった"],["。"],["その"],["子孫","しそん"],["の"],["うち"],["に"],["は"],["、"],["いくさ"],["に"],["出て","でて"],["よく"],["戦う","たたかう"],["大","だい"],["勇士","ゆうし"],["が"],["一万七千二百","いちまんななせんにひゃく"],["人","にん"],["あった"],["。"]]},{"verse":12,"text":"またイルの子,こらはシュパムとホパム。アヘルの子,こはホシムである。","tok":[["また"],["イル"],["の"],["子","こ"],["ら"],["は"],["シュパム"],["と"],["ホパム"],["。"],["アヘル"],["の"],["子","こ"],["は"],["ホシム"],["で"],["ある"],["。"]]},{"verse":13,"text":"ナフタリの子,こらはヤハジエル、グニ、エゼル、シャルムで皆,みなビルハの産,うんだ子,こである。","tok":[["ナフタリ"],["の"],["子","こ"],["ら"],["は"],["ヤハジエル"],["、"],["グニ"],["、"],["エゼル"],["、"],["シャルム"],["で"],["皆","みな"],["ビルハ"],["の"],["産んだ","うんだ"],["子","こ"],["で"],["ある"],["。"]]},{"verse":14,"text":"マナセの子,こらはそのそばめであるスリヤの女,おんなの産,うんだアスリエル。彼女,かのじょはまたギレアデの父,ちちマキルを産,うんだ。","tok":[["マナセ"],["の"],["子","こ"],["ら"],["は"],["その"],["そばめ"],["で"],["ある"],["スリヤ"],["の"],["女","おんな"],["の"],["産んだ","うんだ"],["アスリエル"],["。"],["彼女","かのじょ"],["は"],["また"],["ギレアデ"],["の"],["父","ちち"],["マキル"],["を"],["産んだ","うんだ"],["。"]]},{"verse":15,"text":"マキルはホパムとシュパムの妹,いもうとマアカという者,ものを妻,つまにめとった。二番目,ばんめの子,こはゼロペハデという。ゼロペハデには女,おんなの子,こだけがあった。","tok":[["マキル"],["は"],["ホパム"],["と"],["シュパム"],["の"],["妹","いもうと"],["マアカ"],["と"],["いう"],["者","もの"],["を"],["妻","つま"],["に"],["めとった"],["。"],["二番目","ばんめ"],["の"],["子","こ"],["は"],["ゼロペハデ"],["と"],["いう"],["。"],["ゼロペハデ"],["に"],["は"],["女の子","おんなのこ"],["だけ"],["が"],["あった"],["。"]]},{"verse":16,"text":"マキルの妻,つまマアカは男,おとこの子,こを産,うんで名,なをペレシと名,なづけた。その弟,おとうとの名,なはシャレシ。シャレシの子,こらはウラムとラケムである。","tok":[["マキル"],["の"],["妻","つま"],["マアカ"],["は"],["男の子","おとこのこ"],["を"],["産んで","うんで"],["名","な"],["を"],["ペレシ"],["と"],["名づけた","なづけた"],["。"],["その"],["弟","おとうと"],["の"],["名","な"],["は"],["シャレシ"],["。"],["シャレシ"],["の"],["子","こ"],["ら"],["は"],["ウラム"],["と"],["ラケム"],["で"],["ある"],["。"]]},{"verse":17,"text":"ウラムの子,こはベダン。これらはマナセの子,こマキルの子,こであるギレアデの子,こらである。","tok":[["ウラム"],["の"],["子","こ"],["は"],["ベダン"],["。"],["これ"],["ら"],["は"],["マナセ"],["の"],["子","こ"],["マキル"],["の"],["子","こ"],["で"],["ある"],["ギレアデ"],["の"],["子","こ"],["ら"],["で"],["ある"],["。"]]},{"verse":18,"text":"その妹,いもうとハンモレケテはイシホデ、アビエゼル、マヘラを産,うんだ。","tok":[["その"],["妹","いもうと"],["ハンモレケテ"],["は"],["イシホデ"],["、"],["アビエゼル"],["、"],["マヘラ"],["を"],["産んだ","うんだ"],["。"]]},{"verse":19,"text":"セミダの子,こらはアヒアン、シケム、リキ、アニアムである。","tok":[["セミダ"],["の"],["子","こ"],["ら"],["は"],["アヒアン"],["、"],["シケム"],["、"],["リキ"],["、"],["アニアム"],["で"],["ある"],["。"]]},{"verse":20,"text":"エフライムの子,こはシュテラ、その子,こはベレデ、その子,こはタハテ、その子,こはエラダ、その子,こはタハテ、","tok":[["エフライム"],["の"],["子","こ"],["は"],["シュテラ"],["、"],["その"],["子","こ"],["は"],["ベレデ"],["、"],["その"],["子","こ"],["は"],["タハテ"],["、"],["その"],["子","こ"],["は"],["エラダ"],["、"],["その"],["子","こ"],["は"],["タハテ"],["、"]]},{"verse":21,"text":"その子,こはザバデ、その子,こはシュテラである。エゼルとエレアデはガテの土人,どじんらに殺,ころされた。これは彼,かれらが下,くだって行,いってその家畜,かちくを奪,うばおうとしたからである。","tok":[["その"],["子","こ"],["は"],["ザバデ"],["、"],["その"],["子","こ"],["は"],["シュテラ"],["で"],["ある"],["。"],["エゼル"],["と"],["エレアデ"],["は"],["ガテ"],["の"],["土人","どじん"],["ら"],["に"],["殺ろされた","ころされた"],["。"],["これ"],["は"],["彼","かれ"],["ら"],["が"],["下って","くだって"],["行って","いって"],["その"],["家畜","かちく"],["を"],["奪おう","うばおう"],["と"],["した"],["から"],["で"],["ある"],["。"]]},{"verse":22,"text":"父,ちちエフライムが日,ひ久,ひさしくこのために悲,かなしんだので、その兄弟,きょうだいたちが来,きて彼,かれを慰,なぐさめた。","tok":[["父","ちち"],["エフライム"],["が"],["日","ひ"],["久く","ひさしく"],["この"],["ため"],["に"],["悲しんだ","かなしんだ"],["ので"],["、"],["その"],["兄弟","きょうだい"],["たち"],["が"],["来て","きて"],["彼","かれ"],["を"],["慰さめた","なぐさめた"],["。"]]},{"verse":23,"text":"そののち、エフライムは妻,つまのところにはいった。妻,つまははらんで男,おとこの子,こを産,うみ、その名,なをベリアと名,なづけた。その家,いえに災,わざわいがあったからである。","tok":[["その"],["のち"],["、"],["エフライム"],["は"],["妻","つま"],["の"],["ところ"],["に"],["はいった"],["。"],["妻","つま"],["は"],["はらんで"],["男の子","おとこのこ"],["を"],["産み","うみ"],["、"],["その"],["名","な"],["を"],["ベリア"],["と"],["名づけた","なづけた"],["。"],["その"],["家","いえ"],["に"],["災","わざわい"],["が"],["あった"],["から"],["で"],["ある"],["。"]]},{"verse":24,"text":"エフライムの娘,むすめセラは上,うえと下,したのベテホロンおよびウゼン・セラを建,たてた。","tok":[["エフライム"],["の"],["娘","むすめ"],["セラ"],["は"],["上","うえ"],["と"],["下","した"],["の"],["ベテホロン"],["および"],["ウゼン"],["・"],["セラ"],["を"],["建てた","たてた"],["。"]]},{"verse":25,"text":"ベリアの子,こはレパ、その子,こはレセフ、その子,こはテラ、その子,こはタハン、","tok":[["ベリア"],["の"],["子","こ"],["は"],["レパ"],["、"],["その"],["子","こ"],["は"],["レセフ"],["、"],["その"],["子","こ"],["は"],["テラ"],["、"],["その"],["子","こ"],["は"],["タハン"],["、"]]},{"verse":26,"text":"その子,こはラダン、その子,こはアミホデ、その子,こはエリシャマ、","tok":[["その"],["子","こ"],["は"],["ラダン"],["、"],["その"],["子","こ"],["は"],["アミホデ"],["、"],["その"],["子","こ"],["は"],["エリシャマ"],["、"]]},{"verse":27,"text":"その子,こはヌン、その子,こはヨシュア。","tok":[["その"],["子","こ"],["は"],["ヌン"],["、"],["その"],["子","こ"],["は"],["ヨシュア"],["。"]]},{"verse":28,"text":"エフライムの子孫,しそんの領地,りょうちと住所,じゅうしょはベテルとその村々,むらむら、また東,ひがしの方,ほうではナアラン、西,にしの方,ほうではゲゼルとその村々,むらむら、またシケムとその村々,むらむら、アワとその村々,むらむら。","tok":[["エフライム"],["の"],["子孫","しそん"],["の"],["領地","りょうち"],["と"],["住所","じゅうしょ"],["は"],["ベテル"],["と"],["その"],["村々","むらむら"],["、"],["また"],["東","ひがし"],["の"],["方","ほう"],["で"],["は"],["ナアラン"],["、"],["西","にし"],["の"],["方","ほう"],["で"],["は"],["ゲゼル"],["と"],["その"],["村々","むらむら"],["、"],["また"],["シケム"],["と"],["その"],["村々","むらむら"],["、"],["アワ"],["と"],["その"],["村々","むらむら"],["。"]]},{"verse":29,"text":"またマナセの子孫,しそんの国境,こっきょうに沿,そって、ベテシャンとその村々,むらむら、タアナクとその村々,むらむら、メギドンとその村々,むらむら、ドルとその村々,むらむらで、イスラエルの子,こヨセフの子孫,しそんはこれらの所,ところに住,すんだ。","tok":[["また"],["マナセ"],["の"],["子孫","しそん"],["の"],["国境","こっきょう"],["に"],["沿って","そって"],["、"],["ベテシャン"],["と"],["その"],["村々","むらむら"],["、"],["タアナク"],["と"],["その"],["村々","むらむら"],["、"],["メギドン"],["と"],["その"],["村々","むらむら"],["、"],["ドル"],["と"],["その"],["村々","むらむら"],["で"],["、"],["イスラエル"],["の"],["子","こ"],["ヨセフ"],["の"],["子孫","しそん"],["は"],["これ"],["ら"],["の"],["所","ところ"],["に"],["住んだ","すんだ"],["。"]]},{"verse":30,"text":"アセルの子,こらはイムナ、イシワ、エスイ、ベリアおよびその姉妹,しまいセラ。","tok":[["アセル"],["の"],["子","こ"],["ら"],["は"],["イムナ"],["、"],["イシワ"],["、"],["エスイ"],["、"],["ベリア"],["および"],["その"],["姉妹","しまい"],["セラ"],["。"]]},{"verse":31,"text":"ベリアの子,こらはヘベルとマルキエル。マルキエルはビルザヒテの父,ちちである。","tok":[["ベリア"],["の"],["子","こ"],["ら"],["は"],["ヘベル"],["と"],["マルキエル"],["。"],["マルキエル"],["は"],["ビルザヒテ"],["の"],["父","ちち"],["で"],["ある"],["。"]]},{"verse":32,"text":"ヘベルはヤフレテ、ショメル、ホタムおよびその姉妹,しまいシュアを生,うんだ。","tok":[["ヘベル"],["は"],["ヤフレテ"],["、"],["ショメル"],["、"],["ホタム"],["および"],["その"],["姉妹","しまい"],["シュア"],["を"],["生んだ","うんだ"],["。"]]},{"verse":33,"text":"ヤフレテの子,こらはパサク、ビムハル、アシワテ。これらはヤレフテの子,こらである。","tok":[["ヤフレテ"],["の"],["子","こ"],["ら"],["は"],["パサク"],["、"],["ビムハル"],["、"],["アシワテ"],["。"],["これ"],["ら"],["は"],["ヤレフテ"],["の"],["子","こ"],["ら"],["で"],["ある"],["。"]]},{"verse":34,"text":"彼,かれの兄弟,きょうだいショメルの子,こらはロガ、ホバおよびアラム。","tok":[["彼","かれ"],["の"],["兄弟","きょうだい"],["ショメル"],["の"],["子","こ"],["ら"],["は"],["ロガ"],["、"],["ホバ"],["および"],["アラム"],["。"]]},{"verse":35,"text":"ショメルの兄弟,きょうだいヘレムの子,こらはゾパ、イムナ、シレシ、アマル。","tok":[["ショメル"],["の"],["兄弟","きょうだい"],["ヘレム"],["の"],["子","こ"],["ら"],["は"],["ゾパ"],["、"],["イムナ"],["、"],["シレシ"],["、"],["アマル"],["。"]]},{"verse":36,"text":"ゾパの子,こらはスア、ハルネペル、シュアル、ベリ、イムラ、","tok":[["ゾパ"],["の"],["子","こ"],["ら"],["は"],["スア"],["、"],["ハルネペル"],["、"],["シュアル"],["、"],["ベリ"],["、"],["イムラ"],["、"]]},{"verse":37,"text":"ベゼル、ホド、シャンマ、シルシャ、イテラン、ベエラ。","tok":[["ベゼル"],["、"],["ホド"],["、"],["シャンマ"],["、"],["シルシャ"],["、"],["イテラン"],["、"],["ベエラ"],["。"]]},{"verse":38,"text":"エテルの子,こらはエフンネ、ピスパおよびアラ。","tok":[["エテル"],["の"],["子","こ"],["ら"],["は"],["エフンネ"],["、"],["ピスパ"],["および"],["アラ"],["。"]]},{"verse":39,"text":"ウラの子,こらはアラ、ハニエル、およびリヂア。","tok":[["ウラ"],["の"],["子","こ"],["ら"],["は"],["アラ"],["、"],["ハニエル"],["、"],["および"],["リヂア"],["。"]]},{"verse":40,"text":"これらは皆,みなアセルの子孫,しそんであって、その氏族,しぞくの長,ちょう、えりぬきの大,だい勇士,ゆうし、つかさたちのかしらであった。その系図,けいずによって数,かぞえられた者,もので、いくさに出,でてよく戦,たたかう者,ものの数,かずは二万六千人,にんであった。","tok":[["これ"],["ら"],["は"],["皆","みな"],["アセル"],["の"],["子孫","しそん"],["で"],["あって"],["、"],["その"],["氏族","しぞく"],["の"],["長う","ちょう"],["、"],["えりぬき"],["の"],["大","だい"],["勇士","ゆうし"],["、"],["つかさ"],["たち"],["の"],["かしら"],["で"],["あった"],["。"],["その"],["系図","けいず"],["によって"],["数えられた","かぞえられた"],["者","もの"],["で"],["、"],["いくさ"],["に"],["出て","でて"],["よく"],["戦う","たたかう"],["者","もの"],["の"],["数","かず"],["は"],["二万六千","にまんろくせん"],["人","にん"],["で"],["あった"],["。"]]}]
[{"verse":1,"text":"このようにすべてのイスラエルびとは系図,けいずによって数,かぞえられた。これらはイスラエルの列王紀,れつおうきにしるされている。ユダはその不信,ふしんのゆえにバビロンに捕囚,ほしゅうとなった。","tok":[["この"],["よう"],["に"],["すべて"],["の"],["イスラエル"],["び"],["と"],["は"],["系図","けいず"],["によって"],["数えられた","かぞえられた"],["。"],["これ"],["ら"],["は"],["イスラエル"],["の"],["列王紀","れつおうき"],["に"],["しるされて"],["いる"],["。"],["ユダ"],["は"],["その"],["不信","ふしん"],["の"],["ゆえ"],["に"],["バビロン"],["に"],["捕囚","ほしゅう"],["と"],["なった"],["。"]]},{"verse":2,"text":"その領地,りょうちの町々,まちまちに最初,さいしょに住,すんだものはイスラエルびと、祭司,さいし、レビびとおよび宮,みやに仕,つかえるしもべたちであった。","tok":[["その"],["領地","りょうち"],["の"],["町々","まちまち"],["に"],["最初","さいしょ"],["に"],["住","すんだも"],["の"],["は"],["イスラエル"],["び"],["と"],["、"],["祭司","さいし"],["、"],["レビ"],["び"],["と"],["および"],["宮","みや"],["に"],["仕える","つかえる"],["しもべ"],["たち"],["で"],["あった"],["。"]]},{"verse":3,"text":"またエルサレムにはユダの子孫,しそん、ベニヤミンの子孫,しそんおよびエフライムとマナセの子孫,しそんが住,すんでいた。","tok":[["また"],["エルサレム"],["に"],["は"],["ユダ"],["の"],["子孫","しそん"],["、"],["ベニヤミン"],["の"],["子孫","しそん"],["および"],["エフライム"],["と"],["マナセ"],["の"],["子孫","しそん"],["が"],["住んで","すんで"],["いた"],["。"]]},{"verse":4,"text":"すなわちユダの子,こペレヅの子孫,しそんのうちではアミホデの子,こウタイ。アミホデはオムリの子,こ、オムリはイムリの子,こ、イムリはバニの子,こである。","tok":[["すなわち"],["ユダ"],["の"],["子","こ"],["ペレヅ"],["の"],["子孫","しそん"],["の"],["うち"],["で"],["は"],["アミホデ"],["の"],["子","こ"],["ウタイ"],["。"],["アミホデ"],["は"],["オムリ"],["の"],["子","こ"],["、"],["オムリ"],["は"],["イムリ"],["の"],["子","こ"],["、"],["イムリ"],["は"],["バニ"],["の"],["子","こ"],["で"],["ある"],["。"]]},{"verse":5,"text":"シロびとのうちでは長子,ちょうしアサヤとそのほかの子,こたち。","tok":[["シロ"],["びと"],["の"],["うち"],["で"],["は"],["長子","ちょうし"],["アサヤ"],["と"],["その"],["ほか"],["の"],["子","こ"],["たち"],["。"]]},{"verse":6,"text":"ゼラの子孫,しそんのうちではユエルとその兄弟,きょうだい六百九十人,にん。","tok":[["ゼラ"],["の"],["子孫","しそん"],["の"],["うち"],["で"],["は"],["ユエル"],["と"],["その"],["兄弟","きょうだい"],["六百九","ろくひゃくきゅう"],["十人","じゅうにん"],["。"]]},{"verse":7,"text":"ベニヤミンの子孫,しそんのうちではハセヌアの子,こホダビヤの子,こであるメシュラムの子,こサル、","tok":[["ベニヤミン"],["の"],["子孫","しそん"],["の"],["うち"],["で"],["は"],["ハセヌア"],["の"],["子","こ"],["ホダビヤ"],["の"],["子","こ"],["で"],["ある"],["メシュラム"],["の"],["子","こ"],["サル"],["、"]]},{"verse":8,"text":"エロハムの子,こイブニヤ、ミクリの子,こであるウジの子,こエラおよびイブニヤの子,こリウエルの子,こであるシパテヤの子,こメシュラム、","tok":[["エロハム"],["の"],["子","こ"],["イブニヤ"],["、"],["ミクリ"],["の"],["子","こ"],["で"],["ある"],["ウジ"],["の"],["子","こ"],["エラ"],["および"],["イブニヤ"],["の"],["子","こ"],["リウエル"],["の"],["子","こ"],["で"],["ある"],["シパテヤ"],["の"],["子","こ"],["メシュラム"],["、"]]},{"verse":9,"text":"ならびに彼,かれらの兄弟,きょうだいたちで、その系図,けいずによれば合,あわせて九百五十六人,にん。これらの人々,ひとびとは皆,みなその氏族,しぞくの長,ちょうであった。","tok":[["ならびに"],["彼","かれ"],["ら"],["の"],["兄弟","きょうだい"],["たち"],["で"],["、"],["その"],["系図","けいず"],["に"],["よれば"],["合","あわせ"],["て"],["九百五十六","きゅうひゃくごじゅうろく"],["人","にん"],["。"],["これ"],["ら"],["の"],["人々","ひとびと"],["は"],["皆","みな"],["その"],["氏族","しぞく"],["の"],["長","ちょう"],["で"],["あった"],["。"]]},{"verse":10,"text":"祭司,さいしのうちではエダヤ、ヨアリブ、ヤキン、","tok":[["祭司","さいし"],["の"],["うち"],["で"],["は"],["エダヤ"],["、"],["ヨアリブ"],["、"],["ヤキン"],["、"]]},{"verse":11,"text":"およびヒルキヤの子,こアザリヤ、ヒルキヤはメシュラムの子,こ、メシュラムはザドクの子,こ、ザドクはメラヨテの子,こ、メラヨテはアヒトブの子,こである。アザリヤは神,かみの宮,みやのつかさである。","tok":[["および"],["ヒルキヤ"],["の"],["子","こ"],["アザリヤ"],["、"],["ヒルキヤ"],["は"],["メシュラム"],["の"],["子","こ"],["、"],["メシュラム"],["は"],["ザドク"],["の"],["子","こ"],["、"],["ザドク"],["は"],["メラヨテ"],["の"],["子","こ"],["、"],["メラヨテ"],["は"],["アヒトブ"],["の"],["子","こ"],["で"],["ある"],["。"],["アザリヤ"],["は"],["神","かみ"],["の"],["宮","みや"],["の"],["つかさ"],["で"],["ある"],["。"]]},{"verse":12,"text":"またエロハムの子,こアダヤ、エロハムはパシュルの子,こ、パシュルはマルキヤの子,こである。またアデエルの子,こはマアセヤ、アデエルはヤゼラの子,こ、ヤゼラはメシュラムの子,こ、メシュラムはメシレモテの子,こ、メシレモテはインメルの子,こである。","tok":[["また"],["エロハム"],["の"],["子","こ"],["アダヤ"],["、"],["エロハム"],["は"],["パシュル"],["の"],["子","こ"],["、"],["パシュル"],["は"],["マルキヤ"],["の"],["子","こ"],["で"],["ある"],["。"],["また"],["アデエル"],["の"],["子","こ"],["は"],["マアセヤ"],["、"],["アデエル"],["は"],["ヤゼラ"],["の"],["子","こ"],["、"],["ヤゼラ"],["は"],["メシュラム"],["の"],["子","こ"],["、"],["メシュラム"],["は"],["メシレモテ"],["の"],["子","こ"],["、"],["メシレモテ"],["は"],["インメル"],["の"],["子","こ"],["で"],["ある"],["。"]]},{"verse":13,"text":"そのほかに彼,かれらの兄弟,きょうだいたちもあった。これらはその氏族,しぞくの長,ちょうで、合,あわせて一千七百六十人,にん、みな神,かみの宮,みやの務,つとめをするのに、はなはだ力,ちからのある人々,ひとびとであった。","tok":[["その"],["ほか"],["に"],["彼","かれ"],["ら"],["の"],["兄弟","きょうだい"],["たち"],["も"],["あった"],["。"],["これ"],["ら"],["は"],["その"],["氏族","しぞく"],["の"],["長","ちょう"],["で"],["、"],["合","あわせ"],["て"],["一千七百六","いちせんななひゃくろく"],["十人","じゅうにん"],["、"],["みな"],["神","かみ"],["の"],["宮","みや"],["の"],["務め","つとめ"],["を"],["する"],["のに"],["、"],["はなはだ"],["力","ちから"],["の"],["ある"],["人々","ひとびと"],["で"],["あった"],["。"]]},{"verse":14,"text":"レビびとのうちではハシュブの子,こシマヤ、ハシュブはアズリカムの子,こ、アズリカムはハシャビヤの子,こで、これらはメラリの子孫,しそんである。","tok":[["レビ"],["びと"],["の"],["うち"],["で"],["は"],["ハシュブ"],["の"],["子","こ"],["シマヤ"],["、"],["ハシュブ"],["は"],["アズリカム"],["の"],["子","こ"],["、"],["アズリカム"],["は"],["ハシャビヤ"],["の"],["子","こ"],["で"],["、"],["これ"],["ら"],["は"],["メラリ"],["の"],["子孫","しそん"],["で"],["ある"],["。"]]},{"verse":15,"text":"またバクバッカル、ヘレシ、ガラル、およびアサフの子,こジクリの子,こであるミカの子,こマッタニヤ、","tok":[["また"],["バクバッカル"],["、"],["ヘレシ"],["、"],["ガラル"],["、"],["および"],["アサフ"],["の"],["子","こ"],["ジクリ"],["の"],["子","こ"],["で"],["ある"],["ミカ"],["の"],["子","こ"],["マッタニヤ"],["、"]]},{"verse":16,"text":"ならびにエドトンの子,こガラルの子,こであるシマヤの子,こオバデヤおよびエルカナの子,こであるアサの子,こベレキヤ、エルカナはネトパびとの村里,むらざとに住,すんだ者,ものである。","tok":[["ならびに"],["エドトン"],["の"],["子","こ"],["ガラル"],["の"],["子","こ"],["で"],["ある"],["シマヤ"],["の"],["子","こ"],["オバデヤ"],["および"],["エルカナ"],["の"],["子","こ"],["で"],["ある"],["アサ"],["の"],["子","こ"],["ベレキヤ"],["、"],["エルカナ"],["は"],["ネトパ"],["びと"],["の"],["村里","むらざと"],["に"],["住んだ","すんだ"],["者","もの"],["で"],["ある"],["。"]]},{"verse":17,"text":"門,もんを守,まもるものはシャルム、アックブ、タルモン、アヒマンおよびその兄弟,きょうだいたちで、シャルムはその長,ちょうであった。","tok":[["門","もん"],["を"],["守る","まもる"],["もの"],["は"],["シャルム"],["、"],["アックブ"],["、"],["タルモン"],["、"],["アヒマン"],["および"],["その"],["兄弟","きょうだい"],["たち"],["で"],["、"],["シャルム"],["は"],["その"],["長","ちょう"],["で"],["あった"],["。"]]},{"verse":18,"text":"彼,かれは今日,こんにちまで東,ひがしの方,ほうにある王,おうの門,もんを守,まもっている。これらはレビの子孫,しそんで営の門,もんを守,まもる者,ものである。","tok":[["彼","かれ"],["は"],["今日","こん"],["に"],["ち"],["まで"],["東","ひがし"],["の"],["方","ほう"],["に"],["ある"],["王","おう"],["の"],["門","もん"],["を"],["守って","まもって"],["いる"],["。"],["これ"],["ら"],["は"],["レビ"],["の"],["子孫","しそん"],["で"],["営","えい"],["の"],["門","もん"],["を"],["守者","まもるもの"],["で"],["ある"],["。"]]},{"verse":19,"text":"コラの子,こエビヤサフの子,こであるコレの子,こシャルムおよびその氏族,しぞくの兄弟,きょうだいたちなどのコラびとは幕屋,まくやのもろもろの門,もんを守,まもる務,つとめをつかさどった。その先祖,せんぞたちは主,しゅの営,えいをつかさどり、その入口,いりぐちを守,まもる者,ものであった。","tok":[["コラ"],["の"],["子","こ"],["エビヤサフ"],["の"],["子","こ"],["で"],["ある"],["コレ"],["の"],["子","こ"],["シャルム"],["および"],["その"],["氏族","しぞく"],["の"],["兄弟","きょうだい"],["たち"],["など"],["の"],["コラ"],["び"],["と"],["は"],["幕屋","まくや"],["の"],["もろもろ"],["の"],["門","もん"],["を"],["守","まもる"],["務め","つとめ"],["を"],["つかさどった"],["。"],["その"],["先祖","せんぞ"],["たち"],["は"],["主","しゅ"],["の"],["営","えい"],["を"],["つかさどり"],["、"],["その"],["入口","いりぐち"],["を"],["守者","まもるもの"],["で"],["あった"],["。"]]},{"verse":20,"text":"エレアザルの子,こピネハスが、むかし彼,かれらのつかさであった。主,しゅは彼,かれとともにおられた。","tok":[["エレアザル"],["の"],["子","こ"],["ピネハス"],["が"],["、"],["むかし"],["彼","かれ"],["ら"],["の"],["つかさ"],["で"],["あった"],["。"],["主","しゅ"],["は"],["彼","かれ"],["と"],["とも"],["に"],["おられた"],["。"]]},{"verse":21,"text":"メシレミヤの子,こゼカリヤは会見,かいけんの幕屋,まくやの門,もんを守,まもる者,ものであった。","tok":[["メシレミヤ"],["の"],["子","こ"],["ゼカリヤ"],["は"],["会見","かいけん"],["の"],["幕屋","まくや"],["の"],["門","もん"],["を"],["守者","まもるもの"],["で"],["あった"],["。"]]},{"verse":22,"text":"これらは皆,みな選,えらばれて門,もんを守,まもる者,もので、合,あわせて二百十二人,にんあった。彼,かれらはその村々,むらむらで系図,けいずによって数,かぞえられた者,もので、ダビデと先見者,せんけんしゃサムエルが彼,かれらを職,しょくに任,にんじたのである。","tok":[["これ"],["ら"],["は"],["皆","みな"],["選ら","えら"],["ばれて"],["門","もん"],["を"],["守者","まもるもの"],["で"],["、"],["合","あわせ"],["て"],["二百十二","にひゃくじゅうに"],["人","にん"],["あった"],["。"],["彼","かれ"],["ら"],["は"],["その"],["村々","むらむら"],["で"],["系図","けいず"],["によって"],["数えられた","かぞえられた"],["者","もの"],["で"],["、"],["ダビデ"],["と"],["先見者","せんけんしゃ"],["サムエル"],["が"],["彼","かれ"],["ら"],["を"],["職","しょく"],["に"],["任じた","にんじた"],["ので"],["ある"],["。"]]},{"verse":23,"text":"こうして彼,かれらとその子孫,しそんは監守,かんしゅ人,にんとして、主,しゅの家,いえである幕屋,まくやの家,いえの門,もんをつかさどった。","tok":[["こう"],["して"],["彼","かれ"],["ら"],["と"],["その"],["子孫","しそん"],["は"],["監守人","かんしゅにん"],["として"],["、"],["主","しゅ"],["の"],["家","いえ"],["で"],["ある"],["幕屋","まくや"],["の"],["家","いえ"],["の"],["門","もん"],["を"],["つかさどった"],["。"]]},{"verse":24,"text":"門,もんを守,まもる者,ものは東西,とうざい南北,なんぼくの四方,しほうにいた。","tok":[["門","もん"],["を"],["守者","まもるもの"],["は"],["東西","とうざい"],["南北","なんぼく"],["の"],["四方","しほう"],["に"],["いた"],["。"]]},{"verse":25,"text":"またその村々,むらむらにいる兄弟,きょうだいたちは七日,なぬかごとに代,かわり、来,きて彼,かれらを助,たすけた。","tok":[["また"],["その"],["村々","むらむら"],["に"],["いる"],["兄弟","きょうだい"],["たち"],["は"],["七","なな"],["日","にち"],["に"],["代わり","かわり"],["、"],["来て","きて"],["彼","かれ"],["ら"],["を"],["助けた","たすけた"],["。"]]},{"verse":26,"text":"門,もんを守,まもる者,ものの長,ちょうである四人,にんのレビびとは神,かみの家,いえのもろもろの室,しつと宝,たからとをつかさどった。","tok":[["門","もん"],["を"],["守者","まもるもの"],["の"],["長","ちょう"],["で"],["ある"],["四人","にん"],["の"],["レビ"],["び"],["と"],["は"],["神","かみ"],["の"],["家","いえ"],["の"],["もろもろ"],["の"],["室","しつ"],["と"],["宝","たから"],["と"],["を"],["つかさどった"],["。"]]},{"verse":27,"text":"彼,かれらは神,かみの家,いえを守,まもる身,みであるから、そのまわりに宿,やどった。そして朝,あさごとにこれを開,ひらくことをした。","tok":[["彼","かれ"],["ら"],["は"],["神","かみ"],["の"],["家","いえ"],["を"],["守","まもる"],["身","み"],["で"],["ある"],["から"],["、"],["その"],["まわり"],["に"],["宿った","やどった"],["。"],["そして"],["朝","あさ"],["ごと"],["に"],["これ"],["を"],["開らく","ひらく"],["こと"],["を"],["した"],["。"]]},{"verse":28,"text":"そのうちに務,つとめの器,うつわをつかさどる者,ものがあった。彼,かれらはその数,かずを調,しらべて携,たずさえ入,はいり、またその数,かずを調,しらべて携,たずさえ出,だした。","tok":[["その"],["うち"],["に"],["務め","つとめ"],["の"],["器","うつわ"],["を"],["つかさどる"],["者","もの"],["が"],["あった"],["。"],["彼","かれ"],["ら"],["は"],["その"],["数","かず"],["を"],["調べて","しらべて"],["携え","たずさえ"],["入","は"],["いり"],["、"],["また"],["その"],["数","かず"],["を"],["調べて","しらべて"],["携え","たずさえ"],["出した","だした"],["。"]]},{"verse":29,"text":"またそのほかの品,ひん、すべての聖,せいなる器,うつわおよび麦粉,むぎこ、ぶどう酒,しゅ、油,あぶら、乳香,にゅうこう、香料,こうりょうをつかさどる者,ものがあった。","tok":[["また"],["その"],["ほか"],["の"],["品","ひん"],["、"],["すべて"],["の"],["聖","せい"],["なる"],["器","うつわ"],["および"],["麦粉","むぎこ"],["、"],["ぶどう酒","ぶどうしゅ"],["、"],["油","あぶら"],["、"],["乳香","にゅうこう"],["、"],["香料","こうりょう"],["を"],["つかさどる"],["者","もの"],["が"],["あった"],["。"]]},{"verse":30,"text":"また祭司,さいしのともがらのうちに香料,こうりょうを混,まぜる者,ものがあった。","tok":[["また"],["祭司","さいし"],["の"],["とも"],["がら"],["の"],["うち"],["に"],["香料","こうりょう"],["を"],["混ぜる","まぜる"],["者","もの"],["が"],["あった"],["。"]]},{"verse":31,"text":"コラびとシャルムの長子,ちょうしでレビびとのひとりであるマタテヤはせんべいを造,つくる勤,つとめをつかさどった。","tok":[["コラ"],["び"],["と"],["シャルム"],["の"],["長子","ちょうし"],["で"],["レビ"],["びと"],["の"],["ひとり"],["で"],["ある"],["マタテヤ"],["は"],["せんべい"],["を"],["造る","つくる"],["勤め","つとめ"],["を"],["つかさどった"],["。"]]},{"verse":32,"text":"またコハテびとの子孫,しそんであるその兄弟,きょうだいたちのうちに供,そなえのパンをつかさどって、安息日,あんそくにちごとにこれを整,ととのえる者,ものどもがあった。","tok":[["また"],["コハテ"],["びと"],["の"],["子孫","しそん"],["で"],["ある"],["その"],["兄弟","きょうだい"],["たち"],["の"],["うち"],["に"],["供え","そなえ"],["の"],["パン"],["を"],["つかさどって"],["、"],["安息日","あんそくにちごと"],["に"],["これ"],["を"],["整える","ととのえる"],["者","もの"],["ども"],["が"],["あった"],["。"]]},{"verse":33,"text":"レビびとの氏族,しぞくの長,ちょうであるこれらの者,ものは歌,うたうたう者,ものであって、宮,みやのもろもろの室,しつに住,すみ、ほかの務,つとめはしなかった。彼,かれらは日夜,にちや自分,じぶんの務,つとめに従,したがったからである。","tok":[["レビ"],["びと"],["の"],["氏族","しぞく"],["の"],["長","ちょう"],["で"],["ある"],["これ"],["ら"],["の"],["者","もの"],["は"],["歌","うた"],["うたう"],["者","もの"],["で"],["あって"],["、"],["宮","みや"],["の"],["もろもろ"],["の"],["室","しつ"],["に"],["住み","すみ"],["、"],["ほか"],["の"],["務め","つとめ"],["は"],["しなかった"],["。"],["彼","かれ"],["ら"],["は"],["日夜","にちや"],["自分","じぶん"],["の"],["務め","つとめ"],["に"],["従った","したがった"],["から"],["で"],["ある"],["。"]]},{"verse":34,"text":"これらはレビびとの歴代,れきだいの氏族,しぞくの長,ちょうであって、かしらたる人々,ひとびとであった。彼,かれらはエルサレムに住,すんだ。","tok":[["これ"],["ら"],["は"],["レビ"],["びと"],["の"],["歴代","れきだい"],["の"],["氏族","しぞく"],["の"],["長","ちょう"],["で"],["あって"],["、"],["かしら"],["たる"],["人々","ひとびと"],["で"],["あった"],["。"],["彼","かれ"],["ら"],["は"],["エルサレム"],["に"],["住んだ","すんだ"],["。"]]},{"verse":35,"text":"ギベオンの父,ちちエヒエルはギベオンに住,すんでいた。その妻,つまの名,なはマアカといった。","tok":[["ギベオン"],["の"],["父","ちち"],["エヒエル"],["は"],["ギベオン"],["に"],["住んで","すんで"],["いた"],["。"],["その"],["妻","つま"],["の"],["名","な"],["は"],["マアカ"],["と"],["いった"],["。"]]},{"verse":36,"text":"彼,かれの長子,ちょうしはアブドン、次,つぎはツル、キシ、バアル、ネル、ナダブ、","tok":[["彼","かれ"],["の"],["長子","ちょうし"],["は"],["アブドン"],["、"],["次","つぎ"],["は"],["ツル"],["、"],["キシ"],["、"],["バアル"],["、"],["ネル"],["、"],["ナダブ"],["、"]]},{"verse":37,"text":"ゲドル、アヒオ、ゼカリヤ、ミクロテである。","tok":[["ゲドル"],["、"],["アヒオ"],["、"],["ゼカリヤ"],["、"],["ミクロテ"],["で"],["ある"],["。"]]},{"verse":38,"text":"ミクロテはシメアムを生,うんだ。彼,かれらもその兄弟,きょうだいたちとともにエルサレムに住,すんで、その兄弟,きょうだいたちと向,むかいあっていた。","tok":[["ミクロテ"],["は"],["シメアム"],["を"],["生んだ","うんだ"],["。"],["彼","かれ"],["ら"],["も"],["その"],["兄弟","きょうだい"],["たち"],["と"],["とも"],["に"],["エルサレム"],["に"],["住んで","すんで"],["、"],["その"],["兄弟","きょうだい"],["たち"],["と"],["向","むかい"],["あって"],["いた"],["。"]]},{"verse":39,"text":"ネルはキシを生,うみ、キシはサウルを生,うみ、サウルはヨナタン、マルキシュア、アビナダブ、エシバアルを生,うんだ。","tok":[["ネル"],["は"],["キシ"],["を"],["生み","うみ"],["、"],["キシ"],["は"],["サウル"],["を"],["生み","うみ"],["、"],["サウル"],["は"],["ヨナタン"],["、"],["マルキ"],["シュア"],["、"],["アビナダブ"],["、"],["エシバアル"],["を"],["生んだ","うんだ"],["。"]]},{"verse":40,"text":"ヨナタンの子,こはメリバアルで、メリバアルはミカを生,うんだ。","tok":[["ヨナタン"],["の"],["子","こ"],["は"],["メリバアル"],["で"],["、"],["メリバアル"],["は"],["ミカ"],["を"],["生んだ","うんだ"],["。"]]},{"verse":41,"text":"ミカの子,こらはピトン、メレク、タレアおよびアハズである。","tok":[["ミカ"],["の"],["子","こ"],["ら"],["は"],["ピトン"],["、"],["メレク"],["、"],["タレア"],["および"],["アハズ"],["で"],["ある"],["。"]]},{"verse":42,"text":"アハズはヤラを生,うみ、ヤラはアレメテ、アズマウテおよびジムリを生,うみ、ジムリはモザを生,うみ、","tok":[["アハズ"],["は"],["ヤラ"],["を"],["生み","うみ"],["、"],["ヤラ"],["は"],["アレメテ"],["、"],["アズマウテ"],["および"],["ジムリ"],["を"],["生み","うみ"],["、"],["ジムリ"],["は"],["モザ"],["を"],["生み","うみ"],["、"]]},{"verse":43,"text":"モザはビネアを生,うんだ。ビネアの子,こはレパヤ、その子,こはエレアサ、その子,こはアゼルである。","tok":[["モザ"],["は"],["ビネア"],["を"],["生んだ","うんだ"],["。"],["ビネア"],["の"],["子","こ"],["は"],["レパヤ"],["、"],["その"],["子","こ"],["は"],["エレアサ"],["、"],["その"],["子","こ"],["は"],["アゼル"],["で"],["ある"],["。"]]},{"verse":44,"text":"アゼルに六人,にんの男,おとこの子,こがあった。その名,なはアズリカム、ボケル、イシマエル、シャリヤ、オバデヤ、ハナン。これらはみなアゼルの子,こらであった。","tok":[["アゼル"],["に"],["六人","にん"],["の"],["男の子","おとこのこ"],["が"],["あった"],["。"],["その"],["名","な"],["は"],["アズリカム"],["、"],["ボケル"],["、"],["イシマエル"],["、"],["シャリヤ"],["、"],["オバデヤ"],["、"],["ハナン"],["。"],["これ"],["ら"],["は"],["みな"],["アゼル"],["の"],["子","こ"],["ら"],["で"],["あった"],["。"]]}]
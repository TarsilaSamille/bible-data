[{"verse":1,"text":"アロンの子孫,しそんの組,くみは次,つぎのとおりである。すなわちアロンの子,こらはナダブ、アビウ、エレアザル、イタマル。","tok":[["アロン"],["の"],["子孫","しそん"],["の"],["組","くみ"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["すなわち"],["アロン"],["の"],["子","こ"],["ら"],["は"],["ナダブ"],["、"],["アビウ"],["、"],["エレアザル"],["、"],["イタマル"],["。"]]},{"verse":2,"text":"ナダブとアビウはその父,ちちに先,さきだって死,しに、子,こがなかったので、エレアザルとイタマルが祭司,さいしとなった。","tok":[["ナダブ"],["と"],["アビウ"],["は"],["その"],["父","ちち"],["に"],["先き","さき"],["だ"],["って"],["死に","しに"],["、"],["子","こ"],["が"],["なかった"],["ので"],["、"],["エレアザル"],["と"],["イタマル"],["が"],["祭司","さいし"],["と"],["なった"],["。"]]},{"verse":3,"text":"ダビデはエレアザルの子孫,しそんザドクとイタマルの子孫,しそんアヒメレクの助,たすけによって彼,かれらを分,わけて、それぞれの勤,つとめにつけた。","tok":[["ダビデ"],["は"],["エレアザル"],["の"],["子孫","しそん"],["ザドク"],["と"],["イタマル"],["の"],["子孫","しそん"],["アヒメレク"],["の"],["助け","たすけ"],["によって"],["彼","かれ"],["ら"],["を"],["分けて","わけて"],["、"],["それぞれ"],["の"],["勤め","つとめ"],["に"],["つけた"],["。"]]},{"verse":4,"text":"エレアザルの子孫,しそんのうちにはイタマルの子孫,しそんのうちよりも長,ちょうたる人々,ひとびとが多,おおかった。それでエレアザルの子孫,しそんで氏族,しぞくの長,ちょうである十六人,にんと、イタマルの子孫,しそんで氏族,しぞくの長,ちょうである者,もの八人,にんにこれを分,わけた。","tok":[["エレアザル"],["の"],["子孫","しそん"],["の"],["うち"],["に"],["は"],["イタマル"],["の"],["子孫","しそん"],["の"],["うち"],["より"],["も"],["長うたる","ちょうたる"],["人々","ひとびと"],["が"],["多かった","おおかった"],["。"],["それ"],["で"],["エレアザル"],["の"],["子孫","しそん"],["で"],["氏族","しぞく"],["の"],["長","ちょう"],["で"],["ある"],["十六人","にん"],["と"],["、"],["イタマル"],["の"],["子孫","しそん"],["で"],["氏族","しぞく"],["の"],["長","ちょう"],["で"],["ある"],["者","もの"],["八人","にん"],["に"],["これ"],["を"],["分けた","わけた"],["。"]]},{"verse":5,"text":"このように彼,かれらは皆,みなひとしく、くじによって分,わけられた。聖所,せいじょのつかさ、および神,かみのつかさは、ともにエレアザルの子孫,しそんとイタマルの子孫,しそんから出,でたからである。","tok":[["この"],["よう"],["に"],["彼","かれ"],["ら"],["は"],["皆","みな"],["ひとしく"],["、"],["くじ"],["によって"],["分けられた","わけられた"],["。"],["聖","せい"],["所","しょ"],["の"],["つかさ"],["、"],["および"],["神","かみ"],["の"],["つかさ"],["は"],["、"],["とも"],["に"],["エレアザル"],["の"],["子孫","しそん"],["と"],["イタマル"],["の"],["子孫","しそん"],["から"],["出た","でた"],["から"],["で"],["ある"],["。"]]},{"verse":6,"text":"レビびとネタネルの子,こである書記,しょきシマヤは、王,おうとつかさたちと祭司,さいしザドクとアビヤタルの子,こアヒメレクと祭司,さいしおよびレビびとの氏族,しぞくの長,ちょうたちの前,まえで、これを書,かきしるした。すなわちエレアザルのために氏族,しぞく一つを取,とれば、イタマルのためにも一つを取,とった。","tok":[["レビ"],["びと"],["ネタネル"],["の"],["子","こ"],["で"],["ある"],["書記","しょき"],["シマヤ"],["は"],["、"],["王","おう"],["と"],["つかさ"],["たち"],["と"],["祭司","さいし"],["ザドク"],["と"],["アビヤタル"],["の"],["子","こ"],["アヒメレク"],["と"],["祭司","さいし"],["および"],["レビ"],["びと"],["の"],["氏族","しぞく"],["の"],["長","ちょう"],["たち"],["の"],["前","まえ"],["で"],["、"],["これ"],["を"],["書きしるした","かきしるした"],["。"],["すなわち"],["エレアザル"],["の"],["ため"],["に"],["氏族","しぞく"],["一","ひと"],["つ"],["を"],["取れば","とれば"],["、"],["イタマル"],["の"],["ため"],["に"],["も"],["一","ひと"],["つ"],["を"],["取った","とった"],["。"]]},{"verse":7,"text":"第,だい一のくじはヨアリブに当,あたり、第,だい二はエダヤに当,あたり、","tok":[["第","だい"],["一","いち"],["の"],["くじ"],["は"],["ヨアリブ"],["に"],["当たり","あたり"],["、"],["第","だい"],["二","に"],["は"],["エダヤ"],["に"],["当たり","あたり"],["、"]]},{"verse":8,"text":"第,だい三はハリムに、第,だい四はセオリムに、","tok":[["第","だい"],["三","さん"],["は"],["ハリム"],["に"],["、"],["第","だい"],["四","よん"],["は"],["セオリム"],["に"],["、"]]},{"verse":9,"text":"第,だい五はマルキヤに、第,だい六はミヤミンに、","tok":[["第","だい"],["五","ご"],["は"],["マルキヤ"],["に"],["、"],["第","だい"],["六","ろく"],["は"],["ミヤミン"],["に"],["、"]]},{"verse":10,"text":"第,だい七はハッコヅに、第,だい八はアビヤに、","tok":[["第","だい"],["七","なな"],["は"],["ハッコヅ"],["に"],["、"],["第","だい"],["八","はち"],["は"],["アビヤ"],["に"],["、"]]},{"verse":11,"text":"第,だい九はエシュアに、第,だい十はシカニヤに、","tok":[["第","だい"],["九","きゅう"],["は"],["エシュア"],["に"],["、"],["第","だい"],["十","じゅう"],["は"],["シカニヤ"],["に"],["、"]]},{"verse":12,"text":"第,だい十一はエリアシブに、第,だい十二はヤキムに、","tok":[["第","だい"],["十一","じゅういち"],["は"],["エリアシブ"],["に"],["、"],["第","だい"],["十二","じゅうに"],["は"],["ヤキム"],["に"],["、"]]},{"verse":13,"text":"第,だい十三はホッパに、第,だい十四はエシバブに、","tok":[["第","だい"],["十三","じゅうさん"],["は"],["ホッパ"],["に"],["、"],["第","だい"],["十四","じゅうよん"],["は"],["エシバブ"],["に"],["、"]]},{"verse":14,"text":"第,だい十五はビルガに、第,だい十六はインメルに、","tok":[["第","だい"],["十五","じゅうご"],["は"],["ビルガ"],["に"],["、"],["第","だい"],["十六","じゅうろく"],["は"],["インメル"],["に"],["、"]]},{"verse":15,"text":"第,だい十七はヘジルに、第,だい十八はハピセツに、","tok":[["第","だい"],["十七","じゅうなな"],["は"],["ヘジル"],["に"],["、"],["第","だい"],["十八","じゅうはち"],["は"],["ハピセツ"],["に"],["、"]]},{"verse":16,"text":"第,だい十九はペタヒヤに、第,だい二十はエゼキエルに、","tok":[["第","だい"],["十九","じゅうきゅう"],["は"],["ペタヒヤ"],["に"],["、"],["第","だい"],["二十","にじゅう"],["は"],["エゼキエル"],["に"],["、"]]},{"verse":17,"text":"第,だい二十一はヤキンに、第,だい二十二はガムルに、","tok":[["第","だい"],["二十一","にじゅういち"],["は"],["ヤキン"],["に"],["、"],["第","だい"],["二十二","にじゅうに"],["は"],["ガムル"],["に"],["、"]]},{"verse":18,"text":"第,だい二十三はデラヤに、第,だい二十四はマアジヤに当,あたった。","tok":[["第","だい"],["二十三","にじゅうさん"],["は"],["デラヤ"],["に"],["、"],["第","だい"],["二十四","にじゅうよん"],["は"],["マアジヤ"],["に"],["当たった","あたった"],["。"]]},{"verse":19,"text":"これは、彼,かれらの先祖,せんぞアロンによって設,もうけられた定,さだめにしたがい、主,しゅの家,いえにはいって務,つとめをなす順序,じゅんじょであって、イスラエルの神,かみ、主,しゅの彼,かれに命,めいじられたとおりである。","tok":[["これ"],["は"],["、"],["彼","かれ"],["ら"],["の"],["先祖","せんぞ"],["アロン"],["によって"],["設けられた","もうけられた"],["定め","さだめ"],["に"],["したがい"],["、"],["主","しゅ"],["の"],["家","いえ"],["に"],["はいって"],["務め","つとめ"],["を"],["なす"],["順序","じゅんじょ"],["で"],["あって"],["、"],["イスラエル"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["彼","かれ"],["に"],["命じられた","めいじられた"],["とおり"],["で"],["ある"],["。"]]},{"verse":20,"text":"このほかのレビの子孫,しそんは次,つぎのとおりである。すなわちアムラムの子,こらのうちではシュバエル。シュバエルの子,こらのうちではエデヤ。","tok":[["この"],["ほか"],["の"],["レビ"],["の"],["子孫","しそん"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["すなわち"],["アムラム"],["の"],["子","こ"],["ら"],["の"],["うち"],["で"],["は"],["シュバエル"],["。"],["シュバエル"],["の"],["子","こ"],["ら"],["の"],["うち"],["で"],["は"],["エデヤ"],["。"]]},{"verse":21,"text":"レハビヤについては、レハビヤの子,こらのうちでは長子,ちょうしイシア。","tok":[["レハビヤ"],["について"],["は"],["、"],["レハビヤ"],["の"],["子","こ"],["ら"],["の"],["うち"],["で"],["は"],["長子","ちょうし"],["イシア"],["。"]]},{"verse":22,"text":"イヅハリびとのうちではシロミテ。シロミテの子,こらのうちではヤハテ。","tok":[["イヅハリ"],["びと"],["の"],["うち"],["で"],["は"],["シロミテ"],["。"],["シロミテ"],["の"],["子","こ"],["ら"],["の"],["うち"],["で"],["は"],["ヤハテ"],["。"]]},{"verse":23,"text":"ヘブロンの子,こらは長子,ちょうしはエリヤ、次,つぎはアマリヤ、第,だい三はヤハジエル、第,だい四はエカメアム。","tok":[["ヘブロン"],["の"],["子","こ"],["ら"],["は"],["長子","ちょうし"],["は"],["エリヤ"],["、"],["次","つぎ"],["は"],["アマリヤ"],["、"],["第","だい"],["三","さん"],["は"],["ヤハジエル"],["、"],["第","だい"],["四","よん"],["は"],["エカメアム"],["。"]]},{"verse":24,"text":"ウジエルの子,こらのうちではミカ。ミカの子,こらのうちではシャミル。","tok":[["ウジエル"],["の"],["子","こ"],["ら"],["の"],["うち"],["で"],["は"],["ミカ"],["。"],["ミカ"],["の"],["子","こ"],["ら"],["の"],["うち"],["で"],["は"],["シャミル"],["。"]]},{"verse":25,"text":"ミカの兄弟,きょうだいはイシア。イシアの子,こらのうちではゼカリヤ。","tok":[["ミカ"],["の"],["兄弟","きょうだい"],["は"],["イシア"],["。"],["イシア"],["の"],["子","こ"],["ら"],["の"],["うち"],["で"],["は"],["ゼカリヤ"],["。"]]},{"verse":26,"text":"メラリの子,こらはマヘリとムシ。ヤジアの子,こらはベノ。","tok":[["メラリ"],["の"],["子","こ"],["ら"],["は"],["マヘリ"],["と"],["ムシ"],["。"],["ヤジア"],["の"],["子","こ"],["ら"],["は"],["ベノ"],["。"]]},{"verse":27,"text":"メラリの子孫,しそんのヤジアから出,でた者,ものはベノ、ショハム、ザックル、イブリ。","tok":[["メラリ"],["の"],["子孫","しそん"],["の"],["ヤジア"],["から"],["出た","でた"],["者","もの"],["は"],["ベノ"],["、"],["ショハム"],["、"],["ザックル"],["、"],["イブリ"],["。"]]},{"verse":28,"text":"マヘリからエレアザルが出,でた。彼,かれには子,こがなかった。","tok":[["マヘリ"],["から"],["エレアザル"],["が"],["出た","でた"],["。"],["彼","かれ"],["に"],["は"],["子","こ"],["が"],["なかった"],["。"]]},{"verse":29,"text":"キシについては、キシの子,こはエラメル。","tok":[["キシ"],["について"],["は"],["、"],["キシ"],["の"],["子","こ"],["は"],["エラメル"],["。"]]},{"verse":30,"text":"ムシの子,こらはマヘリ、エデル、エリモテ。これらはレビびとの子孫,しそんで、その氏族,しぞくによっていった者,ものである。","tok":[["ムシ"],["の"],["子","こ"],["ら"],["は"],["マヘリ"],["、"],["エデル"],["、"],["エリモテ"],["。"],["これ"],["ら"],["は"],["レビ"],["びと"],["の"],["子孫","しそん"],["で"],["、"],["その"],["氏族","しぞく"],["によって"],["いった"],["者","もの"],["で"],["ある"],["。"]]},{"verse":31,"text":"これらの者,ものもまた氏族,しぞくの兄,あにもその弟,おとうとも同様,どうように、ダビデ王,おうと、ザドクと、アヒメレクと、祭司,さいしおよびレビびとの氏族,しぞくの長,ちょうたちの前,まえで、アロンの子孫,しそんであるその兄弟,きょうだいたちのようにくじを引,ひいた。","tok":[["これ"],["ら"],["の"],["者","もの"],["も"],["また"],["氏族","しぞく"],["の"],["兄","あに"],["も"],["その"],["弟","おとうと"],["も"],["同様","どうよう"],["に"],["、"],["ダビデ"],["王","おう"],["と"],["、"],["ザドク"],["と"],["、"],["アヒメレク"],["と"],["、"],["祭司","さいし"],["および"],["レビ"],["びと"],["の"],["氏族","しぞく"],["の"],["長","ちょう"],["たち"],["の"],["前","まえ"],["で"],["、"],["アロン"],["の"],["子孫","しそん"],["で"],["ある"],["その"],["兄弟","きょうだい"],["たち"],["の"],["よう"],["に"],["くじ"],["を"],["引いた","ひいた"],["。"]]}]
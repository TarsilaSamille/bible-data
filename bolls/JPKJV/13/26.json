[{"verse":1,"text":"門,もんを守,まもる者,ものの組,くみは次,つぎのとおりである。すなわちコラびとのうちでは、アサフの子孫,しそんのうちのコレの子,こメシレミヤ。","tok":[["門","もん"],["を"],["守者","まもるもの"],["の"],["組","くみ"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["すなわち"],["コラ"],["びと"],["の"],["うち"],["で"],["は"],["、"],["アサフ"],["の"],["子孫","しそん"],["の"],["うち"],["の"],["コレ"],["の"],["子","こ"],["メシレミヤ"],["。"]]},{"verse":2,"text":"メシレミヤの子,こたちは、長子,ちょうしはゼカリヤ、次,つぎはエデアエル、第,だい三はゼバデヤ、第,だい四はヤテニエル、","tok":[["メシレミヤ"],["の"],["子","こ"],["たち"],["は"],["、"],["長子","ちょうし"],["は"],["ゼカリヤ"],["、"],["次","つぎ"],["は"],["エデアエル"],["、"],["第","だい"],["三","さん"],["は"],["ゼバデヤ"],["、"],["第","だい"],["四","よん"],["は"],["ヤテニエル"],["、"]]},{"verse":3,"text":"第,だい五はエラム、第,だい六はヨハナン、第,だい七はエリヨエナイである。","tok":[["第","だい"],["五","ご"],["は"],["エラム"],["、"],["第","だい"],["六","ろく"],["は"],["ヨハナン"],["、"],["第","だい"],["七","なな"],["は"],["エリヨエナイ"],["で"],["ある"],["。"]]},{"verse":4,"text":"オベデ・エドムの子,こたちは、長子,ちょうしはシマヤ、次,つぎはヨザバデ、第,だい三はヨア、第,だい四はサカル、第,だい五はネタネル、","tok":[["オベデ"],["・"],["エドム"],["の"],["子","こ"],["たち"],["は"],["、"],["長子","ちょうし"],["は"],["シマヤ"],["、"],["次","つぎ"],["は"],["ヨザバデ"],["、"],["第","だい"],["三","さん"],["は"],["ヨア"],["、"],["第","だい"],["四","よん"],["は"],["サカル"],["、"],["第","だい"],["五","ご"],["は"],["ネタネル"],["、"]]},{"verse":5,"text":"第,だい六はアンミエル、第,だい七はイッサカル、第,だい八はピウレタイである。神,かみが彼,かれを祝福,しゅくふくされたからである。","tok":[["第六","だい六"],["は"],["アンミエル"],["、"],["第","だい"],["七","なな"],["は"],["イッサカル"],["、"],["第","だい"],["八","はち"],["は"],["ピウレタイ"],["で"],["ある"],["。"],["神","かみ"],["が"],["彼","かれ"],["を"],["祝福","しゅくふく"],["された"],["から"],["で"],["ある"],["。"]]},{"verse":6,"text":"彼,かれの子,こシマヤにも数人,すうにんの子,こが生,うまれ、有能,ゆうのうな人々,ひとびとであったので、その父,ちちの家,いえを治,おさめる者,ものとなった。","tok":[["彼","かれ"],["の"],["子","こ"],["シマヤ"],["に"],["も"],["数人","すうにん"],["の"],["子","こ"],["が"],["生まれ","うまれ"],["、"],["有能","ゆうのう"],["な"],["人々","ひとびと"],["で"],["あった"],["ので"],["、"],["その"],["父","ちち"],["の"],["家","いえ"],["を"],["治める","おさめる"],["者","もの"],["と"],["なった"],["。"]]},{"verse":7,"text":"すなわちシマヤの子,こたちはオテニ、レパエル、オベデ、エルザバデで、エルザバデの兄弟,きょうだいエリウとセマキヤは力,ちからある人々,ひとびとであった。","tok":[["すなわち"],["シマヤ"],["の"],["子","こ"],["たち"],["は"],["オテニ"],["、"],["レパエル"],["、"],["オベデ"],["、"],["エルザバデ"],["で"],["、"],["エルザバデ"],["の"],["兄弟","きょうだい"],["エリウ"],["と"],["セマキヤ"],["は"],["力","ちから"],["ある"],["人々","ひとびと"],["で"],["あった"],["。"]]},{"verse":8,"text":"これらは皆,みなオベデ・エドムの子孫,しそんである。彼,かれらはその子,こたちおよびその兄弟,きょうだいたちと共,ともにその勤,つとめに適,てきした力,ちからある人々,ひとびとで、合,あわせて六十二人,にん、みなオベデ・エドムに属,ぞくする者,ものである。","tok":[["これ"],["ら"],["は"],["皆","みな"],["オベデ"],["・"],["エドム"],["の"],["子孫","しそん"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["その"],["子","こ"],["たち"],["および"],["その"],["兄弟","きょうだい"],["たち"],["と"],["共","とも"],["に"],["その"],["勤め","つとめ"],["に"],["適した","てきした"],["力","ちから"],["ある"],["人々","ひとびと"],["で"],["、"],["合","あわせ"],["て"],["六十二人","にん"],["、"],["みな"],["オベデ"],["・"],["エドム"],["に"],["属する","ぞくする"],["者","もの"],["で"],["ある"],["。"]]},{"verse":9,"text":"メシレミヤにも子,こたちと兄弟,きょうだいたち合,あわせて十八人,にんあって、皆,みな力,ちからある人々,ひとびとであった。","tok":[["メシレミヤ"],["に"],["も"],["子","こ"],["たち"],["と"],["兄弟","きょうだい"],["たち"],["合","あわせ"],["て"],["十八人","にん"],["あって"],["、"],["皆","みな"],["力","ちから"],["ある"],["人々","ひとびと"],["で"],["あった"],["。"]]},{"verse":10,"text":"メラリの子孫,しそんホサにも子,こたちがあった。そのかしらはシムリ、これは長子,ちょうしではなかったが、父,ちちはこれをかしらにしたのであった。","tok":[["メラリ"],["の"],["子孫","しそん"],["ホサ"],["に"],["も"],["子","こ"],["たち"],["が"],["あった"],["。"],["その"],["かしら"],["は"],["シムリ"],["、"],["これ"],["は"],["長子","ちょうし"],["で"],["は"],["なかった"],["が"],["、"],["父","ちち"],["は"],["これ"],["を"],["かしら"],["に"],["した"],["ので"],["あった"],["。"]]},{"verse":11,"text":"次,つぎはヒルキヤ、第,だい三はテバリヤ、第,だい四はゼカリヤである。ホサの子,こたちと兄弟,きょうだいたちは合,あわせて十三人,にんである。","tok":[["次","つぎ"],["は"],["ヒルキヤ"],["、"],["第","だい"],["三","さん"],["は"],["テバリヤ"],["、"],["第","だい"],["四","よん"],["は"],["ゼカリヤ"],["で"],["ある"],["。"],["ホサ"],["の"],["子","こ"],["たち"],["と"],["兄弟","きょうだい"],["たち"],["は"],["合","あわせ"],["て"],["十三人","にん"],["で"],["ある"],["。"]]},{"verse":12,"text":"これらは門,もんを守,まもる者,ものの組,くみの長,ちょうたる人々,ひとびとであって、その兄弟,きょうだいたちと同様,どうように務,つとめをなして、主,しゅの宮,みやに仕,つかえた。","tok":[["これ"],["ら"],["は"],["門","もん"],["を"],["守者","まもるもの"],["の"],["組","くみ"],["の"],["長うたる","ちょうたる"],["人々","ひとびと"],["で"],["あって"],["、"],["その"],["兄弟","きょうだい"],["たち"],["と"],["同様","どうよう"],["に"],["務め","つとめ"],["を"],["なして"],["、"],["主","しゅ"],["の"],["宮","みや"],["に"],["仕えた","つかえた"],["。"]]},{"verse":13,"text":"彼,かれらはそれぞれ門,もんのために小,しょうなる者,ものも、大,だいなる者,ものも等,ひとしく、その氏族,しぞくにしたがってくじを引,ひいた。","tok":[["彼","かれ"],["ら"],["は"],["それぞれ"],["門","もん"],["の"],["ため"],["に"],["小","しょう"],["なる"],["者","もの"],["も"],["、"],["大","だい"],["なる"],["者","もの"],["も"],["等く","ひとしく"],["、"],["その"],["氏族","しぞく"],["に"],["したがって"],["くじ"],["を"],["引いた","ひいた"],["。"]]},{"verse":14,"text":"東,ひがしの門,もんのくじはシレミヤに当,あたった。また彼,かれの子,こで思慮,しりょ深,ふかい議,ぎ士,しゼカリヤのためにくじを引,ひいたが、北,きたの門,もんのくじがこれに当,あたった。","tok":[["東","ひがし"],["の"],["門","もん"],["の"],["くじ"],["は"],["シレミヤ"],["に"],["当たった","あたった"],["。"],["また"],["彼","かれ"],["の"],["子","こ"],["で"],["思慮","しりょ"],["深","ふ"],["かい議士","かいぎし"],["ゼカリヤ"],["の"],["ため"],["に"],["くじ"],["を"],["引いた","ひいた"],["が"],["、"],["北","きた"],["の"],["門","もん"],["の"],["くじ"],["が"],["これ"],["に"],["当たった","あたった"],["。"]]},{"verse":15,"text":"オベデ・エドムには南,みなみの門,もんのくじ、その子,こたちには倉,くらのくじ、","tok":[["オベデ"],["・"],["エドム"],["に"],["は"],["南","みなみ"],["の"],["門","もん"],["の"],["くじ"],["、"],["その"],["子","こ"],["たち"],["に"],["は"],["倉","くら"],["の"],["くじ"],["、"]]},{"verse":16,"text":"シュパムとホサには西,にしの門,もんのくじが当,あたった。これは坂,さかの大路,おおじにあるシャレケテの門,もんのかたわらにあった。守,まもる者,ものと守,まもる者,ものとが相対,あいたいしていた。","tok":[["シュパム"],["と"],["ホサ"],["に"],["は"],["西","にし"],["の"],["門","もん"],["の"],["くじ"],["が"],["当たった","あたった"],["。"],["これ"],["は"],["坂","さか"],["の"],["大路","おおじ"],["に"],["ある"],["シャレケテ"],["の"],["門","もん"],["の"],["かたわら"],["に"],["あった"],["。"],["守者","まもるもの"],["と"],["守者","まもるもの"],["と"],["が"],["相対","あ"],["いたい"],["して"],["いた"],["。"]]},{"verse":17,"text":"東,ひがしの方,ほうには毎日,まいにち六人,にん、北,きたの方,ほうには毎日,まいにち四人,にん、南,みなみの方,ほうには毎日,まいにち四人,にん、倉,くらには二人,にんと二人,にん、","tok":[["東","ひがし"],["の"],["方","ほう"],["に"],["は"],["毎日","まいにち"],["六人","にん"],["、"],["北","きた"],["の"],["方","ほう"],["に"],["は"],["毎日","まいにち"],["四人","にん"],["、"],["南","みなみ"],["の"],["方","ほう"],["に"],["は"],["毎日","まいにち"],["四人","にん"],["、"],["倉","くら"],["に"],["は"],["二人","にん"],["と"],["二人","にん"],["、"]]},{"verse":18,"text":"西,にしの方,ほうパルバルには大路,おおじに四人,にん、パルバルに二人,にん。","tok":[["西","にし"],["の"],["方","ほう"],["パルバル"],["に"],["は"],["大路","おおじ"],["に"],["四人","にん"],["、"],["パルバル"],["に"],["二人","にん"],["。"]]},{"verse":19,"text":"門,もんを守,まもる者,ものの組,くみは以上,いじょうのとおりで、コラの子孫,しそんとメラリの子孫,しそんであった。","tok":[["門","もん"],["を"],["守者","まもるもの"],["の"],["組","くみ"],["は"],["以上","いじょう"],["の"],["とおり"],["で"],["、"],["コラ"],["の"],["子孫","しそん"],["と"],["メラリ"],["の"],["子孫","しそん"],["で"],["あった"],["。"]]},{"verse":20,"text":"レビびとのうちアヒヤは神,かみの宮,みやの倉,くらおよび聖,せいなる物,ものの倉,くらをつかさどった。","tok":[["レビ"],["びと"],["の"],["うち"],["アヒヤ"],["は"],["神","かみ"],["の"],["宮","みや"],["の"],["倉","くら"],["および"],["聖","せい"],["なる"],["物","もの"],["の"],["倉","くら"],["を"],["つかさどった"],["。"]]},{"verse":21,"text":"ラダンの子孫,しそんすなわちラダンから出,でたゲルションびとの子孫,しそんで、ゲルションびとの氏族,しぞくの長,ちょうはエヒエリである。","tok":[["ラダン"],["の"],["子孫","しそん"],["すなわち"],["ラダン"],["から"],["出た","でた"],["ゲルション"],["びと"],["の"],["子孫","しそん"],["で"],["、"],["ゲルション"],["びと"],["の"],["氏族","しぞく"],["の"],["長","ちょう"],["は"],["エヒエリ"],["で"],["ある"],["。"]]},{"verse":22,"text":"エヒエリ、ゼタムおよびその兄弟,きょうだいヨエルの子,こたちは主,しゅの宮,みやの倉,くらをつかさどった。","tok":[["エヒエリ"],["、"],["ゼタム"],["および"],["その"],["兄弟","きょうだい"],["ヨエル"],["の"],["子","こ"],["たち"],["は"],["主","しゅ"],["の"],["宮","みや"],["の"],["倉","くら"],["を"],["つかさどった"],["。"]]},{"verse":23,"text":"アムラムびと、イヅハルびと、ヘブロンびと、ウジエルびとのうちでは次,つぎのとおりであった。","tok":[["アムラム"],["び"],["と"],["、"],["イヅハル"],["び"],["と"],["、"],["ヘブロン"],["び"],["と"],["、"],["ウジエル"],["びと"],["の"],["うち"],["で"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["あった"],["。"]]},{"verse":24,"text":"すなわちモーセの子,こゲルショムの子,こシブエルは倉,くらのつかさであった。","tok":[["すなわち"],["モーセ"],["の"],["子","こ"],["ゲルショム"],["の"],["子","こ"],["シブエル"],["は"],["倉","くら"],["の"],["つかさ"],["で"],["あった"],["。"]]},{"verse":25,"text":"その兄弟,きょうだいでエリエゼルから出,でた者,ものは、その子,こはレハビヤ、その子,こはエサヤ、その子,こはヨラム、その子,こはジクリ、その子,こはシロミテである。","tok":[["その"],["兄弟","きょうだい"],["で"],["エリエゼル"],["から"],["出た","でた"],["者","もの"],["は"],["、"],["その"],["子","こ"],["は"],["レハビヤ"],["、"],["その"],["子","こ"],["は"],["エサヤ"],["、"],["その"],["子","こ"],["は"],["ヨラム"],["、"],["その"],["子","こ"],["は"],["ジクリ"],["、"],["その"],["子","こ"],["は"],["シロミテ"],["で"],["ある"],["。"]]},{"verse":26,"text":"このシロミテとその兄弟,きょうだいたちはすべての聖,せいなる物,ものの倉,くらをつかさどった。これはダビデ王,おうと、氏族,しぞくの長,ちょうと、千人,にんの長,ちょうと、百人,にんの長,ちょうと、軍,ぐんの長,ちょうたちのささげたものである。","tok":[["この"],["シロミテ"],["と"],["その"],["兄弟","きょうだい"],["たち"],["は"],["すべて"],["の"],["聖","せい"],["なる"],["物","もの"],["の"],["倉","くら"],["を"],["つかさどった"],["。"],["これ"],["は"],["ダビデ"],["王","おう"],["と"],["、"],["氏族","しぞく"],["の"],["長","ちょう"],["と"],["、"],["千人","にん"],["の"],["長","ちょう"],["と"],["、"],["百人","にん"],["の"],["長","ちょう"],["と"],["、"],["軍","ぐん"],["の"],["長","ちょう"],["たち"],["の"],["ささげた"],["もの"],["で"],["ある"],["。"]]},{"verse":27,"text":"すなわち彼,かれらが戦,たたかいで獲,えたぶんどり物,もののうちから主,しゅの宮,みやの修繕,しゅうぜんのためにささげたものである。","tok":[["すなわち"],["彼","かれ"],["ら"],["が"],["戦い","たたかい"],["で"],["獲た","えた"],["ぶんどり"],["物","もの"],["の"],["うち"],["から"],["主","しゅ"],["の"],["宮","みや"],["の"],["修繕","しゅうぜん"],["の"],["ため"],["に"],["ささげた"],["もの"],["で"],["ある"],["。"]]},{"verse":28,"text":"またすべて先見者,せんけんしゃサムエル、キシの子,こサウル、ネルの子,こアブネル、ゼルヤの子,こヨアブなどがささげた物,もの。すべてこれらのささげ物,ものはシロミテとその兄弟,きょうだいたちが管理,かんりした。","tok":[["また"],["すべて"],["先見者","せんけんしゃ"],["サムエル"],["、"],["キシ"],["の"],["子","こ"],["サウル"],["、"],["ネル"],["の"],["子","こ"],["アブネル"],["、"],["ゼルヤ"],["の"],["子","こ"],["ヨアブ"],["など"],["が"],["ささげた"],["物","もの"],["。"],["すべて"],["これ"],["ら"],["の"],["ささげ物","ささげもの"],["は"],["シロミテ"],["と"],["その"],["兄弟","きょうだい"],["たち"],["が"],["管理","かんり"],["した"],["。"]]},{"verse":29,"text":"イヅハルびとのうちでは、ケナニヤとその子,こたちが、つかさおよびさばきびととしてイスラエルの外事,がいじのために選,えらばれた。","tok":[["イヅハル"],["びと"],["の"],["うち"],["で"],["は"],["、"],["ケナニヤ"],["と"],["その"],["子","こ"],["たち"],["が"],["、"],["つかさ"],["および"],["さばき"],["びと"],["として"],["イスラエル"],["の"],["外事","がいじ"],["の"],["ため"],["に"],["選ら","えら"],["ばれた"],["。"]]},{"verse":30,"text":"ヘブロンびとのうちでは、ハシャビヤおよびその兄弟,きょうだいなど勇士,ゆうし千七百人,にんがあって、ヨルダンのこなた、すなわち西,にしの方,ほうでイスラエルの監督,かんとくとなり、主,しゅのすべての事,ことを行,おこない、王,おうに奉仕,ほうしした。","tok":[["ヘブロン"],["びと"],["の"],["うち"],["で"],["は"],["、"],["ハシャビヤ"],["および"],["その"],["兄弟","きょうだい"],["など"],["勇士","ゆうし"],["千七百人","にん"],["が"],["あって"],["、"],["ヨルダン"],["の"],["こなた"],["、"],["すなわち"],["西","にし"],["の"],["方","ほう"],["で"],["イスラエル"],["の"],["監督","かんとく"],["と"],["なり"],["、"],["主","しゅ"],["の"],["すべて"],["の"],["事","こと"],["を"],["行ない","おこない"],["、"],["王","おう"],["に"],["奉仕","ほうし"],["した"],["。"]]},{"verse":31,"text":"ヘブロンびとのうちでは、系図,けいずと氏族,しぞくによってエリヤがヘブロンびとの長,ちょうであったが、ダビデの治世,ちせいの第,だい四十年,ねんに彼,かれらを尋,たずね求,もとめ、ギレアデのヤゼルで彼,かれらのうちから大,だい勇士,ゆうしを得,えた。","tok":[["ヘブロン"],["びと"],["の"],["うち"],["で"],["は"],["、"],["系図","けいず"],["と"],["氏族","しぞく"],["によって"],["エリヤ"],["が"],["ヘブロン"],["びと"],["の"],["長","ちょう"],["で"],["あった"],["が"],["、"],["ダビデ"],["の"],["治世","ちせい"],["の"],["第","だい"],["四十","よんじゅう"],["年","ねん"],["に"],["彼","かれ"],["ら"],["を"],["尋ね求め","たずねもとめ"],["、"],["ギレアデ"],["の"],["ヤゼル"],["で"],["彼","かれ"],["ら"],["の"],["うち"],["から"],["大","だい"],["勇士","ゆうし"],["を"],["得た","えた"],["。"]]},{"verse":32,"text":"ダビデ王,おうは彼,かれとその兄弟,きょうだいなど氏族,しぞくの長,ちょうたち二千七百人,にんの勇士,ゆうしをルベンびと、ガドびと、マナセびとの半,はん部族,ぶぞくの監督,かんとくとなし、すべて神,かみにつける事,ことと王,おうの事,こととをつかさどらせた。","tok":[["ダビデ"],["王","おう"],["は"],["彼","かれ"],["と"],["その"],["兄弟","きょうだい"],["など"],["氏族","しぞく"],["の"],["長","ちょう"],["たち"],["二千七百","にせんななひゃく"],["人","にん"],["の"],["勇士","ゆうし"],["を"],["ルベン"],["び"],["と"],["、"],["ガド"],["び"],["と"],["、"],["マナセ"],["びと"],["の"],["半","はん"],["部族","ぶぞく"],["の"],["監督","かんとく"],["と"],["なし"],["、"],["すべて"],["神","かみ"],["に"],["つける"],["事","こと"],["と"],["王","おう"],["の"],["事","こと"],["と"],["を"],["つかさどらせた"],["。"]]}]
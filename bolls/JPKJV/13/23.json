[{"verse":1,"text":"ダビデは老,おい、その日,ひが満,みちたので、その子,こソロモンをイスラエルの王,おうとした。","tok":[["ダビデ"],["は"],["老","おい"],["、"],["その"],["日","ひ"],["が"],["満ちた","みちた"],["ので"],["、"],["その"],["子","こ"],["ソロモン"],["を"],["イスラエル"],["の"],["王","おう"],["と"],["した"],["。"]]},{"verse":2,"text":"ダビデはイスラエルのすべてのつかさおよび祭司,さいしとレビびとを集,あつめた。","tok":[["ダビデ"],["は"],["イスラエル"],["の"],["すべて"],["の"],["つかさ"],["および"],["祭司","さいし"],["と"],["レビ"],["びと"],["を"],["集めた","あつめた"],["。"]]},{"verse":3,"text":"レビびとの三十歳,さい以上,いじょうのものを数,かぞえると、その男,おとこの数,かずが三万八千人,にんあった。","tok":[["レビ"],["びと"],["の"],["三十歳","さ"],["い"],["以上","いじょう"],["の"],["もの"],["を"],["数える","かぞえる"],["と"],["、"],["その"],["男","おとこ"],["の"],["数","かず"],["が"],["三万八千","さんまんはちせん"],["人","にん"],["あった"],["。"]]},{"verse":4,"text":"ダビデは言,いった、「そのうち二万四千人,にんは主,しゅの家,いえの仕事,しごとをつかさどり、六千人,にんはつかさびと、およびさばきびととなり、","tok":[["ダビデ"],["は"],["言った","いった"],["、"],["「"],["その"],["うち"],["二万四千","にまんよんせん"],["人","にん"],["は"],["主","しゅ"],["の"],["家","いえ"],["の"],["仕事","しごと"],["を"],["つかさどり"],["、"],["六千人","にんはつかさび"],["と"],["、"],["および"],["さばき"],["びと"],["と"],["なり"],["、"]]},{"verse":5,"text":"四千人,にんは門,もんを守,まもる者,ものとなり、また四千人,にんはさんびのためにわたしの造,つくった楽器,がっきで主,しゅをたたえよ」。","tok":[["四千人","にん"],["は"],["門","もん"],["を"],["守者","まもるもの"],["と"],["なり"],["、"],["また"],["四千人","にんはさんび"],["の"],["ため"],["に"],["わたし"],["の"],["造った","つくった"],["楽器","がっき"],["で"],["主","しゅ"],["を"],["たたえよ"],["」"],["。"]]},{"verse":6,"text":"そしてダビデは彼,かれらをレビの子,こらにしたがってゲルション、コハテ、メラリの組,くみに分,わけた。","tok":[["そして"],["ダビデ"],["は"],["彼","かれ"],["ら"],["を"],["レビ"],["の"],["子","こ"],["ら"],["に"],["したがって"],["ゲルション"],["、"],["コハテ"],["、"],["メラリ"],["の"],["組","くみ"],["に"],["分けた","わけた"],["。"]]},{"verse":7,"text":"ゲルションの子,こらはラダンとシメイ。","tok":[["ゲルション"],["の"],["子","こ"],["ら"],["は"],["ラダン"],["と"],["シメイ"],["。"]]},{"verse":8,"text":"ラダンの子,こらは、かしらのエヒエルとゼタムとヨエルの三人,にん。","tok":[["ラダン"],["の"],["子","こ"],["ら"],["は"],["、"],["かしら"],["の"],["エヒエル"],["と"],["ゼタム"],["と"],["ヨエル"],["の"],["三人","にん"],["。"]]},{"verse":9,"text":"シメイの子,こらはシロミテ、ハジエル、ハランの三人,にん。これらはラダンの氏族,しぞくの長,ちょうであった。","tok":[["シメイ"],["の"],["子","こ"],["ら"],["は"],["シロミテ"],["、"],["ハジエル"],["、"],["ハラン"],["の"],["三人","にん"],["。"],["これ"],["ら"],["は"],["ラダン"],["の"],["氏族","しぞく"],["の"],["長","ちょう"],["で"],["あった"],["。"]]},{"verse":10,"text":"シメイの子,こらはヤハテ、ジナ、エウシ、ベリアの四人,にん。皆,みなシメイの子,こで、","tok":[["シメイ"],["の"],["子","こ"],["ら"],["は"],["ヤハテ"],["、"],["ジナ"],["、"],["エウシ"],["、"],["ベリア"],["の"],["四人","にん"],["。"],["皆","みな"],["シメイ"],["の"],["子","こ"],["で"],["、"]]},{"verse":11,"text":"ヤハテはかしら、ジザはその次,つぎ、エウシとベリアは子,こが多,おおくなかったので、ともに数,かぞえられて一つの氏族,しぞくとなった。","tok":[["ヤハテ"],["は"],["かしら"],["、"],["ジザ"],["は"],["その"],["次","つぎ"],["、"],["エウシ"],["と"],["ベリア"],["は"],["子","こ"],["が"],["多く","おおく"],["なかった"],["ので"],["、"],["とも"],["に"],["数えられて","かぞえられて"],["一","ひと"],["つ"],["の"],["氏族","しぞく"],["と"],["なった"],["。"]]},{"verse":12,"text":"コハテの子,こらはアムラム、イヅハル、ヘブロン、ウジエルの四人,にん。","tok":[["コハテ"],["の"],["子","こ"],["ら"],["は"],["アムラム"],["、"],["イヅハル"],["、"],["ヘブロン"],["、"],["ウジエル"],["の"],["四人","にん"],["。"]]},{"verse":13,"text":"アムラムの子,こらはアロンとモーセである。アロンはその子,こらとともに、ながくいと聖,せいなるものを聖別,せいべつするために分,わかたれて、主,しゅの前,まえに香,こうをたき、主,しゅに仕,つかえ、常,つねに主,しゅの名,なをもって祝福,しゅくふくすることをなした。","tok":[["アムラム"],["の"],["子","こ"],["ら"],["は"],["アロン"],["と"],["モーセ"],["で"],["ある"],["。"],["アロン"],["は"],["その"],["子","こ"],["ら"],["と"],["とも"],["に"],["、"],["ながく"],["い"],["と"],["聖","せい"],["なる"],["もの"],["を"],["聖別","せいべつ"],["する"],["ため"],["に"],["分かたれて","わかたれて"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["香","こう"],["を"],["たき"],["、"],["主に","しゅに"],["仕え","つかえ"],["、"],["常","つね"],["に"],["主","しゅ"],["の"],["名","な"],["を"],["もって"],["祝福","しゅくふく"],["する"],["こと"],["を"],["なした"],["。"]]},{"verse":14,"text":"神,かみの人,ひとモーセの子,こらはレビの部族,ぶぞくのうちに数,かぞえられた。","tok":[["神","かみ"],["の"],["人","ひと"],["モーセ"],["の"],["子","こ"],["ら"],["は"],["レビ"],["の"],["部族","ぶぞく"],["の"],["うち"],["に"],["数えられた","かぞえられた"],["。"]]},{"verse":15,"text":"モーセの子,こらはゲルションとエリエゼル。","tok":[["モーセ"],["の"],["子","こ"],["ら"],["は"],["ゲルション"],["と"],["エリエゼル"],["。"]]},{"verse":16,"text":"ゲルションの子,こらは、かしらはシブエル。","tok":[["ゲルション"],["の"],["子","こ"],["ら"],["は"],["、"],["かしら"],["は"],["シブエル"],["。"]]},{"verse":17,"text":"エリエゼルの子,こらは、かしらはレハビヤ。エリエゼルにはこのほかに子,こがなかった。しかしレハビヤの子,こらは非常,ひじょうに多,おおかった。","tok":[["エリエゼル"],["の"],["子","こ"],["ら"],["は"],["、"],["かしら"],["は"],["レハビヤ"],["。"],["エリエゼル"],["に"],["は"],["この"],["ほか"],["に"],["子","こ"],["が"],["なかった"],["。"],["しかし"],["レハビヤ"],["の"],["子","こ"],["ら"],["は"],["非常","ひじょう"],["に"],["多かった","おおかった"],["。"]]},{"verse":18,"text":"イヅハルの子,こらは、かしらはシロミテ。","tok":[["イヅハル"],["の"],["子","こ"],["ら"],["は"],["、"],["かしら"],["は"],["シロミテ"],["。"]]},{"verse":19,"text":"ヘブロンの子,こらは長子,ちょうしはエリヤ、次,つぎはアマリヤ、第,だい三はヤハジエル、第,だい四はエカメアム。","tok":[["ヘブロン"],["の"],["子","こ"],["ら"],["は"],["長子","ちょうし"],["は"],["エリヤ"],["、"],["次","つぎ"],["は"],["アマリヤ"],["、"],["第","だい"],["三","さん"],["は"],["ヤハジエル"],["、"],["第","だい"],["四","よん"],["は"],["エカメアム"],["。"]]},{"verse":20,"text":"ウジエルの子,こらは、かしらはミカ、次,つぎはイシアである。","tok":[["ウジエル"],["の"],["子","こ"],["ら"],["は"],["、"],["かしら"],["は"],["ミカ"],["、"],["次","つぎ"],["は"],["イシア"],["で"],["ある"],["。"]]},{"verse":21,"text":"メラリの子,こらはマヘリとムシ。マヘリの子,こらはエレアザルとキシ。","tok":[["メラリ"],["の"],["子","こ"],["ら"],["は"],["マヘリ"],["と"],["ムシ"],["。"],["マヘリ"],["の"],["子","こ"],["ら"],["は"],["エレアザル"],["と"],["キシ"],["。"]]},{"verse":22,"text":"エレアザルは男,おとこの子,こがなくて死,しに、ただ娘,むすめたちだけであったが、キシの子,こであるその身内,みうちの男,おとこたちが彼女,かのじょたちをめとった。","tok":[["エレアザル"],["は"],["男の子","おとこのこ"],["が"],["なくて"],["死に","しに"],["、"],["ただ"],["娘","むすめ"],["たち"],["だけ"],["で"],["あった"],["が"],["、"],["キシ"],["の"],["子","こ"],["で"],["ある"],["その"],["身内","みうち"],["の"],["男","おとこ"],["たち"],["が"],["彼女","かのじょ"],["たち"],["を"],["めとった"],["。"]]},{"verse":23,"text":"ムシの子,こらはマヘリ、エデル、エレモテの三人,にんである。","tok":[["ムシ"],["の"],["子","こ"],["ら"],["は"],["マヘリ"],["、"],["エデル"],["、"],["エレモテ"],["の"],["三人","にん"],["で"],["ある"],["。"]]},{"verse":24,"text":"これらはその氏族,しぞくによるレビの子孫,しそんであって、その人数,にんずうが数,かぞえられ、その名,ながしるされて、主,しゅの家,いえの務,つとめをなした二十歳,さい以上,いじょうの者,もので、氏族,しぞくの長,ちょうであった。","tok":[["これ"],["ら"],["は"],["その"],["氏族","しぞく"],["に"],["よる"],["レビ"],["の"],["子孫","しそん"],["で"],["あって"],["、"],["その"],["人数","にんずう"],["が"],["数えられ","かぞえられ"],["、"],["その"],["名","な"],["が"],["しるされて"],["、"],["主","しゅ"],["の"],["家","いえ"],["の"],["務め","つとめ"],["を"],["なした"],["二十歳","さ"],["い"],["以上","いじょう"],["の"],["者","もの"],["で"],["、"],["氏族","しぞく"],["の"],["長","ちょう"],["で"],["あった"],["。"]]},{"verse":25,"text":"ダビデは言,いった、「イスラエルの神,かみ、主,しゅはその民,たみに平安,へいあんを与,あたえ、ながくエルサレムに住,すまわれる。","tok":[["ダビデ"],["は"],["言った","いった"],["、"],["「"],["イスラエル"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["その"],["民","たみ"],["に"],["平安","へいあん"],["を"],["与","あたえ"],["、"],["ながく"],["エルサレム"],["に"],["住まわれる","すまわれる"],["。"]]},{"verse":26,"text":"レビびとは重,かさねて幕屋,まくやおよびその勤,つとめの器物,うつわものをかつぐことはない。","tok":[["レビ"],["び"],["と"],["は"],["重ねて","かさねて"],["幕屋","まくや"],["および"],["その"],["勤め","つとめ"],["の"],["器物","うつわも"],["の"],["を"],["かつぐ"],["こと"],["は"],["ない"],["。"]]},{"verse":27,"text":"――ダビデの最後,さいごの言葉,ことばによって、レビびとは二十歳,さい以上,いじょうの者,ものが数,かぞえられた――","tok":[["―"],["―"],["ダビデ"],["の"],["最後","さいご"],["の"],["言葉","ことば"],["によって"],["、"],["レビ"],["び"],["と"],["は"],["二十歳","さ"],["い"],["以上","いじょう"],["の"],["者","もの"],["が"],["数えられた","かぞえられた"],["―"],["―"]]},{"verse":28,"text":"彼,かれらの務,つとめはアロンの子孫,しそんを助,たすけて主,しゅの家,いえの働,はたらきをし、庭,にわとへやの仕事,しごとおよびすべての聖,せいなるものを清,きよめること、そのほか、すべて神,かみの家,いえの働,はたらきをすることである。","tok":[["彼","かれ"],["ら"],["の"],["務め","つとめ"],["は"],["アロン"],["の"],["子孫","しそん"],["を"],["助けて","たすけて"],["主","しゅ"],["の"],["家","いえ"],["の"],["働らき","はたらき"],["を"],["し"],["、"],["庭","にわ"],["と"],["へや"],["の"],["仕事","しごと"],["および"],["すべて"],["の"],["聖","せい"],["なる"],["もの"],["を"],["清める","きよめる"],["こと"],["、"],["その"],["ほか"],["、"],["すべて"],["神","かみ"],["の"],["家","いえ"],["の"],["働らき","はたらき"],["を"],["する"],["こと"],["で"],["ある"],["。"]]},{"verse":29,"text":"また供,そなえのパン、素祭,そさいの麦粉,むぎこ、種,たね入,いれぬ菓子,かし、焼,やいた供,そなえ物,もの、油,あぶらをまぜた供,そなえ物,ものをつかさどり、またすべて分量,ぶんりょうおよび大,おおきさを量,はかることをつかさどり、","tok":[["また"],["供え","そなえ"],["の"],["パン"],["、"],["素","す"],["祭","まつり"],["の"],["麦粉","むぎこ"],["、"],["種","た"],["ね"],["入れぬ","いれぬ"],["菓子","かし"],["、"],["焼いた","やいた"],["供え物","そなえもの"],["、"],["油","あぶら"],["を"],["まぜた"],["供え物","そなえもの"],["を"],["つかさどり"],["、"],["また"],["すべて"],["分量","ぶんりょう"],["および"],["大きさ","おおきさ"],["を"],["量る","はかる"],["こと"],["を"],["つかさどり"],["、"]]},{"verse":30,"text":"また朝,あさごとに立,たって主,しゅに感謝,かんしゃし、さんびし、夕,ゆうにもまたそのようにし、","tok":[["また"],["朝","あさ"],["ごと"],["に"],["立って","たって"],["主に","しゅに"],["感謝","かんしゃ"],["し"],["、"],["さん"],["びし"],["、"],["夕","ゆう"],["に"],["も"],["また"],["その"],["よう"],["に"],["し"],["、"]]},{"verse":31,"text":"また安息日,あんそくにちと新月,しんげつと祭日,さいじつに、主,しゅにもろもろの燔祭,はんさいをささげるときは、絶,たえず主,しゅの前,まえにその命,めいじられた数,かずにしたがってささげなければならない。","tok":[["また"],["安息日","あんそく"],["に"],["ちと"],["新月","しんげつ"],["と"],["祭日","さいじつ"],["に"],["、"],["主に","しゅに"],["もろもろ"],["の"],["燔祭","はんさい"],["を"],["ささげる"],["とき"],["は"],["、"],["絶えず","たえず"],["主","しゅ"],["の"],["前","まえ"],["に"],["その"],["命じられた","めいじられた"],["数","かず"],["に"],["したがって"],["ささげなければ"],["ならない"],["。"]]},{"verse":32,"text":"このようにして彼,かれらは会見,かいけんの幕屋,まくやと聖所,せいじょの務,つとめを守,まもり、主,しゅの家,いえの働,はたらきのためにその兄弟,きょうだいであるアロンの子,こらに仕,つかえなければならない」。","tok":[["この"],["よう"],["に"],["して"],["彼","かれ"],["ら"],["は"],["会見","かいけん"],["の"],["幕屋","まくや"],["と"],["聖","せい"],["所","しょ"],["の"],["務め","つとめ"],["を"],["守り","まもり"],["、"],["主","しゅ"],["の"],["家","いえ"],["の"],["働らき","はたらき"],["の"],["ため"],["に"],["その"],["兄弟","きょうだい"],["で"],["ある"],["アロン"],["の"],["子","こ"],["ら"],["に"],["仕えなければ","つかえなければ"],["ならない"],["」"],["。"]]}]
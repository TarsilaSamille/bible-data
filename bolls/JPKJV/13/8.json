[{"verse":1,"text":"ベニヤミンの生,うんだ者,ものは長子,ちょうしはベラ、その次,つぎはアシベル、第,だい三はアハラ、","tok":[["ベニヤミン"],["の"],["生んだ","うんだ"],["者","もの"],["は"],["長子","ちょうし"],["は"],["ベラ"],["、"],["その"],["次","つぎ"],["は"],["アシベル"],["、"],["第","だい"],["三","さん"],["は"],["アハラ"],["、"]]},{"verse":2,"text":"第,だい四はノハ、第,だい五はラパ。","tok":[["第","だい"],["四","よん"],["は"],["ノハ"],["、"],["第","だい"],["五","ご"],["は"],["ラパ"],["。"]]},{"verse":3,"text":"ベラの子,こらはアダル、ゲラ、アビウデ、","tok":[["ベラ"],["の"],["子","こ"],["ら"],["は"],["アダル"],["、"],["ゲラ"],["、"],["アビウデ"],["、"]]},{"verse":4,"text":"アビシュア、ナアマン、アホア、","tok":[["アビシュア"],["、"],["ナアマン"],["、"],["アホア"],["、"]]},{"verse":5,"text":"ゲラ、シフパム、ヒラム。","tok":[["ゲラ"],["、"],["シフパム"],["、"],["ヒラム"],["。"]]},{"verse":6,"text":"エホデの子,こらは次,つぎのとおりである。（これらはゲバの住民,じゅうみんの氏族,しぞくの長,ちょうであって、マナハテに捕,とらえ移,うつされたものである。）","tok":[["エホデ"],["の"],["子","こ"],["ら"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["（"],["これ"],["ら"],["は"],["ゲバ"],["の"],["住民","じゅうみん"],["の"],["氏族","しぞく"],["の"],["長","ちょう"],["で"],["あって"],["、"],["マナハテ"],["に"],["捕らえ","とらえ"],["移された","うつされた"],["もの"],["で"],["ある"],["。"],["）"]]},{"verse":7,"text":"すなわちナアマン、アヒヤ、ゲラすなわちヘグラム。ゲラはウザとアヒフデの父,ちちであった。","tok":[["すなわち"],["ナアマン"],["、"],["アヒヤ"],["、"],["ゲラ"],["すなわち"],["ヘグラム"],["。"],["ゲラ"],["は"],["ウザ"],["と"],["アヒフデ"],["の"],["父","ちち"],["で"],["あった"],["。"]]},{"verse":8,"text":"シャハライムは妻,つまホシムとバアラを離別,りべつしてのち、モアブの国,くにで子,こらをもうけた。","tok":[["シャハ"],["ライム"],["は"],["妻","つま"],["ホシム"],["と"],["バアラ"],["を"],["離別","りべつ"],["して"],["のち"],["、"],["モアブ"],["の"],["国","くに"],["で"],["子","こ"],["ら"],["を"],["もうけた"],["。"]]},{"verse":9,"text":"彼,かれが妻,つまホデシによってもうけた子,こらはヨバブ、ヂビア、メシャ、マルカム、","tok":[["彼","かれ"],["が"],["妻","つま"],["ホデシ"],["によって"],["もうけた"],["子","こ"],["ら"],["は"],["ヨバブ"],["、"],["ヂビア"],["、"],["メシャ"],["、"],["マルカム"],["、"]]},{"verse":10,"text":"エウヅ、シャキヤ、ミルマ。これらはその子,こらであって氏族,しぞくの長,ちょうである。","tok":[["エウヅ"],["、"],["シャキヤ"],["、"],["ミルマ"],["。"],["これ"],["ら"],["は"],["その"],["子","こ"],["ら"],["で"],["あって"],["氏族","しぞく"],["の"],["長","ちょう"],["で"],["ある"],["。"]]},{"verse":11,"text":"彼,かれはまたホシムによってアビトブとエルパアルをもうけた。","tok":[["彼","かれ"],["は"],["また"],["ホシム"],["によって"],["アビトブ"],["と"],["エルパアル"],["を"],["もうけた"],["。"]]},{"verse":12,"text":"エルパアルの子,こらはエベル、ミシャムおよびセメド。彼,かれはオノとロドとその村々,むらむらを建,たてた者,ものである。","tok":[["エルパアル"],["の"],["子","こ"],["ら"],["は"],["エベル"],["、"],["ミシャム"],["および"],["セメド"],["。"],["彼","かれ"],["は"],["オノ"],["と"],["ロド"],["と"],["その"],["村々","むらむら"],["を"],["建てた","たてた"],["者","もの"],["で"],["ある"],["。"]]},{"verse":13,"text":"またベリアとシマがあった。（これはアヤロンの住民,じゅうみんの氏族,しぞくの長,ちょうであって、ガテの住民,じゅうみんを追,おい払,はらったものである。）","tok":[["また"],["ベリア"],["と"],["シマ"],["が"],["あった"],["。"],["（"],["これ"],["は"],["アヤロン"],["の"],["住民","じゅうみん"],["の"],["氏族","しぞく"],["の"],["長","ちょう"],["で"],["あって"],["、"],["ガテ"],["の"],["住民","じゅうみん"],["を"],["追い払った","おいはらった"],["もの"],["で"],["ある"],["。"],["）"]]},{"verse":14,"text":"またアヒオ、シャシャク、エレモテ。","tok":[["また"],["アヒオ"],["、"],["シャシャク"],["、"],["エレモテ"],["。"]]},{"verse":15,"text":"ゼバデヤ、アラデ、アデル、","tok":[["ゼバデヤ"],["、"],["アラデ"],["、"],["アデル"],["、"]]},{"verse":16,"text":"ミカエル、イシパおよびヨハはベリアの子,こらであった。","tok":[["ミカエル"],["、"],["イシパ"],["および"],["ヨハ"],["は"],["ベリア"],["の"],["子","こ"],["ら"],["で"],["あった"],["。"]]},{"verse":17,"text":"ゼバデヤ、メシュラム、ヘゼキ、ヘベル、","tok":[["ゼバデヤ"],["、"],["メシュラム"],["、"],["ヘゼキ"],["、"],["ヘベル"],["、"]]},{"verse":18,"text":"イシメライ、エズリアおよびヨバブはエルパアルの子,こらであった。","tok":[["イシメライ"],["、"],["エズリア"],["および"],["ヨバブ"],["は"],["エルパアル"],["の"],["子","こ"],["ら"],["で"],["あった"],["。"]]},{"verse":19,"text":"ヤキン、ジクリ、ザベデ、","tok":[["ヤキン"],["、"],["ジクリ"],["、"],["ザベデ"],["、"]]},{"verse":20,"text":"エリエナイ、チルタイ、エリエル、","tok":[["エリエナイ"],["、"],["チルタイ"],["、"],["エリエル"],["、"]]},{"verse":21,"text":"アダヤ、ベラヤおよびシムラテはシマの子,こらであった。","tok":[["アダヤ"],["、"],["ベラヤ"],["および"],["シムラテ"],["は"],["シマ"],["の"],["子","こ"],["ら"],["で"],["あった"],["。"]]},{"verse":22,"text":"イシパン、ヘベル、エリエル、","tok":[["イシパン"],["、"],["ヘベル"],["、"],["エリエル"],["、"]]},{"verse":23,"text":"アブドン、ジクリ、ハナン、","tok":[["アブドン"],["、"],["ジクリ"],["、"],["ハナン"],["、"]]},{"verse":24,"text":"ハナニヤ、エラム、アントテヤ、","tok":[["ハナニヤ"],["、"],["エラム"],["、"],["アントテヤ"],["、"]]},{"verse":25,"text":"イペデヤおよびペヌエルはシャシャクの子,こらであった。","tok":[["イペデヤ"],["および"],["ペヌエル"],["は"],["シャシャク"],["の"],["子","こ"],["ら"],["で"],["あった"],["。"]]},{"verse":26,"text":"シャムセライ、シハリア、アタリヤ、","tok":[["シャムセライ"],["、"],["シハリア"],["、"],["アタリヤ"],["、"]]},{"verse":27,"text":"ヤレシャ、エリヤおよびジクリはエロハムの子,こらであった。","tok":[["ヤレシャ"],["、"],["エリヤ"],["および"],["ジクリ"],["は"],["エロハム"],["の"],["子","こ"],["ら"],["で"],["あった"],["。"]]},{"verse":28,"text":"これらは歴代,れきだいの氏族,しぞくの長,ちょうであり、またかしらであって、エルサレムに住,すんだ。","tok":[["これ"],["ら"],["は"],["歴代","れきだい"],["の"],["氏族","しぞく"],["の"],["長","ちょう"],["で"],["あり"],["、"],["また"],["かしら"],["で"],["あって"],["、"],["エルサレム"],["に"],["住んだ","すんだ"],["。"]]},{"verse":29,"text":"ギベオンの父,ちちエイエルはギベオンに住,すみ、その妻,つまの名,なはマアカといった。","tok":[["ギベオン"],["の"],["父","ちち"],["エイエル"],["は"],["ギベオン"],["に"],["住み","すみ"],["、"],["その"],["妻","つま"],["の"],["名","な"],["は"],["マアカ"],["と"],["いった"],["。"]]},{"verse":30,"text":"その長子,ちょうしはアブドンで、次,つぎはツル、キシ、バアル、ナダブ、","tok":[["その"],["長子","ちょうし"],["は"],["アブドン"],["で"],["、"],["次","つぎ"],["は"],["ツル"],["、"],["キシ"],["、"],["バアル"],["、"],["ナダブ"],["、"]]},{"verse":31,"text":"ゲドル、アヒオ、ザケル、","tok":[["ゲドル"],["、"],["アヒオ"],["、"],["ザケル"],["、"]]},{"verse":32,"text":"およびミクロテ。ミクロテはシメアを生,うんだ。これらもまた兄弟,きょうだいたちと向,むかいあってエルサレムに住,すんだ。","tok":[["および"],["ミクロテ"],["。"],["ミクロテ"],["は"],["シメア"],["を"],["生んだ","うんだ"],["。"],["これ"],["ら"],["も"],["また"],["兄弟","きょうだい"],["たち"],["と"],["向","むかい"],["あって"],["エルサレム"],["に"],["住んだ","すんだ"],["。"]]},{"verse":33,"text":"ネルはキシを生,うみ、キシはサウルを生,うみ、サウルはヨナタン、マルキシュア、アビナダブ、エシバアルを生,うんだ。","tok":[["ネル"],["は"],["キシ"],["を"],["生み","うみ"],["、"],["キシ"],["は"],["サウル"],["を"],["生み","うみ"],["、"],["サウル"],["は"],["ヨナタン"],["、"],["マルキ"],["シュア"],["、"],["アビナダブ"],["、"],["エシバアル"],["を"],["生んだ","うんだ"],["。"]]},{"verse":34,"text":"ヨナタンの子,こはメリバアルで、メリバアルはミカエルを生,うんだ。","tok":[["ヨナタン"],["の"],["子","こ"],["は"],["メリバアル"],["で"],["、"],["メリバアル"],["は"],["ミカエル"],["を"],["生んだ","うんだ"],["。"]]},{"verse":35,"text":"ミカの子,こらはピトン、メレク、タレア、アハズである。","tok":[["ミカ"],["の"],["子","こ"],["ら"],["は"],["ピトン"],["、"],["メレク"],["、"],["タレア"],["、"],["アハズ"],["で"],["ある"],["。"]]},{"verse":36,"text":"アハズはエホアダを生,うみ、エホアダはアレメテ、アズマウテ、ジムリを生,うみ、ジムリはモザを生,うみ、","tok":[["アハズ"],["は"],["エホアダ"],["を"],["生み","うみ"],["、"],["エホアダ"],["は"],["アレメテ"],["、"],["アズマウテ"],["、"],["ジムリ"],["を"],["生み","うみ"],["、"],["ジムリ"],["は"],["モザ"],["を"],["生み","うみ"],["、"]]},{"verse":37,"text":"モザはビネアを生,うんだ。ビネアの子,こはラパ、ラパの子,こはエレアサ、エレアサの子,こはアゼルである。","tok":[["モザ"],["は"],["ビネア"],["を"],["生んだ","うんだ"],["。"],["ビネア"],["の"],["子","こ"],["は"],["ラパ"],["、"],["ラパ"],["の"],["子","こ"],["は"],["エレアサ"],["、"],["エレアサ"],["の"],["子","こ"],["は"],["アゼル"],["で"],["ある"],["。"]]},{"verse":38,"text":"アゼルには六人,にんの子,こがあり、その名,なはアズリカム、ボケル、イシマエル、シャリヤ、オバデヤ、ハナンで、皆,みなアゼルの子,こである。","tok":[["アゼル"],["に"],["は"],["六人","にん"],["の"],["子","こ"],["が"],["あり"],["、"],["その"],["名","な"],["は"],["アズリカム"],["、"],["ボケル"],["、"],["イシマエル"],["、"],["シャリヤ"],["、"],["オバデヤ"],["、"],["ハナン"],["で"],["、"],["皆","みな"],["アゼル"],["の"],["子","こ"],["で"],["ある"],["。"]]},{"verse":39,"text":"その兄弟,きょうだいエセクの子,こらは、長子,ちょうしはウラム、次,つぎはエウシ、第,だい三はエリペレテである。","tok":[["その"],["兄弟","きょうだい"],["エセク"],["の"],["子","こ"],["ら"],["は"],["、"],["長子","ちょうし"],["は"],["ウラム"],["、"],["次","つぎ"],["は"],["エウシ"],["、"],["第","だい"],["三","さん"],["は"],["エリペレテ"],["で"],["ある"],["。"]]},{"verse":40,"text":"ウラムの子,こらは大,だい勇士,ゆうしで、よく弓,ゆみを射,いる者,ものであった。彼,かれは多,おおくの子,こと孫,まごをもち、百五十人,にんもあった。これらは皆,みなベニヤミンの子孫,しそんである。","tok":[["ウラム"],["の"],["子","こ"],["ら"],["は"],["大","だい"],["勇士","ゆうし"],["で"],["、"],["よく"],["弓","ゆみ"],["を"],["射る","いる"],["者","もの"],["で"],["あった"],["。"],["彼","かれ"],["は"],["多く","おおく"],["の"],["子","こ"],["と"],["孫","まご"],["を"],["もち"],["、"],["百五","ひゃくご"],["十人","じゅうにん"],["も"],["あった"],["。"],["これ"],["ら"],["は"],["皆","みな"],["ベニヤミン"],["の"],["子孫","しそん"],["で"],["ある"],["。"]]}]
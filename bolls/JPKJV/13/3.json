[{"verse":1,"text":"ヘブロンで生,うまれたダビデの子,こらは次,つぎのとおりである。長子,ちょうしはアムノンでエズレルびとアヒノアムから生,うまれ、次,つぎはダニエルでカルメルびとアビガイルから生,うまれ、","tok":[["ヘブロン"],["で"],["生まれた","うまれた"],["ダビデ"],["の"],["子","こ"],["ら"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["長子","ちょうし"],["は"],["アムノン"],["で"],["エズレル"],["びと"],["アヒノアム"],["から"],["生まれ","うまれ"],["、"],["次","つぎ"],["は"],["ダニエル"],["で"],["カルメル"],["び"],["と"],["アビガイル"],["から"],["生まれ","うまれ"],["、"]]},{"verse":2,"text":"第,だい三はアブサロムでゲシュルの王,おうタルマイの娘,むすめマアカの産,うんだ子,こ、第,だい四はアドニヤでハギテの産,うんだ子,こ、","tok":[["第","だい"],["三","さん"],["は"],["アブサロム"],["で"],["ゲシュル"],["の"],["王","おう"],["タルマイ"],["の"],["娘","むすめ"],["マアカ"],["の"],["産んだ","うんだ"],["子","こ"],["、"],["第","だい"],["四","よん"],["は"],["アドニヤ"],["で"],["ハギテ"],["の"],["産んだ","うんだ"],["子","こ"],["、"]]},{"verse":3,"text":"第,だい五はシパテヤでアビタルから生,うまれ、第,だい六はイテレアムで、彼,かれの妻,つまエグラから生,うまれた。","tok":[["第","だい"],["五","ご"],["は"],["シパテヤ"],["で"],["アビタル"],["から"],["生まれ","うまれ"],["、"],["第","だい"],["六","ろく"],["は"],["イテレアム"],["で"],["、"],["彼","かれ"],["の"],["妻","つま"],["エグラ"],["から"],["生まれた","うまれた"],["。"]]},{"verse":4,"text":"この六人,にんはヘブロンで彼,かれに生,うまれた。ダビデがそこで王,おうとなっていたのは七年,ねん六か月,げつ、エルサレムで王,おうとなっていたのは三十三年,ねんであった。","tok":[["この"],["六人","にん"],["は"],["ヘブロン"],["で"],["彼","かれ"],["に"],["生まれた","うまれた"],["。"],["ダビデ"],["が"],["そこ"],["で"],["王","おう"],["と"],["なって"],["いた"],["の"],["は"],["七","なな"],["年","ねん"],["六","ろく"],["か月","かげつ"],["、"],["エルサレム"],["で"],["王","おう"],["と"],["なって"],["いた"],["の"],["は"],["三十三","さんじゅうさん"],["年","ねん"],["で"],["あった"],["。"]]},{"verse":5,"text":"エルサレムで生,うまれたものは次,つぎのとおりである。すなわちシメア、ショバブ、ナタン、ソロモン。この四人,にんはアンミエルの娘,むすめバテシュアから生,うまれた。","tok":[["エルサレム"],["で"],["生まれた","うまれた"],["もの"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["すなわち"],["シメア"],["、"],["ショバブ"],["、"],["ナタン"],["、"],["ソロモン"],["。"],["この"],["四人","にん"],["は"],["アンミエル"],["の"],["娘","むすめ"],["バテシュア"],["から"],["生まれた","うまれた"],["。"]]},{"verse":6,"text":"またイブハル、エリシャマ、エリペレテ、","tok":[["また"],["イブハル"],["、"],["エリシャマ"],["、"],["エリペレテ"],["、"]]},{"verse":7,"text":"ノガ、ネペグ、ヤピア、","tok":[["ノガ"],["、"],["ネペグ"],["、"],["ヤピア"],["、"]]},{"verse":8,"text":"エリシャマ、エリアダ、エリペレテの九人,にん、","tok":[["エリシャマ"],["、"],["エリアダ"],["、"],["エリペレテ"],["の"],["九人","にん"],["、"]]},{"verse":9,"text":"これらはみなダビデの子,こである。このほかに、そばめどもの産,うんだ子,こらがあり、タマルは彼,かれらの姉妹,しまいであった。","tok":[["これ"],["ら"],["は"],["みな"],["ダビデ"],["の"],["子","こ"],["で"],["ある"],["。"],["この"],["ほか"],["に"],["、"],["そばめ"],["ども"],["の"],["産んだ","うんだ"],["子","こ"],["ら"],["が"],["あり"],["、"],["タマル"],["は"],["彼","かれ"],["ら"],["の"],["姉妹","しまい"],["で"],["あった"],["。"]]},{"verse":10,"text":"ソロモンの子,こはレハベアム、その子,こはアビヤ、その子,こはアサ、その子,こはヨシャパテ、","tok":[["ソロモン"],["の"],["子","こ"],["は"],["レハベアム"],["、"],["その"],["子","こ"],["は"],["アビヤ"],["、"],["その"],["子","こ"],["は"],["アサ"],["、"],["その"],["子","こ"],["は"],["ヨシャパテ"],["、"]]},{"verse":11,"text":"その子,こはヨラム、その子,こはアハジヤ、その子,こはヨアシ、","tok":[["その"],["子","こ"],["は"],["ヨラム"],["、"],["その"],["子","こ"],["は"],["アハジヤ"],["、"],["その"],["子","こ"],["は"],["ヨアシ"],["、"]]},{"verse":12,"text":"その子,こはアマジヤ、その子,こはアザリヤ、その子,こはヨタム、","tok":[["その"],["子","こ"],["は"],["アマジヤ"],["、"],["その"],["子","こ"],["は"],["アザリヤ"],["、"],["その"],["子","こ"],["は"],["ヨタム"],["、"]]},{"verse":13,"text":"その子,こはアハズ、その子,こはヒゼキヤ、その子,こはマナセ、","tok":[["その"],["子","こ"],["は"],["アハズ"],["、"],["その"],["子","こ"],["は"],["ヒゼキヤ"],["、"],["その"],["子","こ"],["は"],["マナセ"],["、"]]},{"verse":14,"text":"その子,こはアモン、その子,こはヨシヤ、","tok":[["その"],["子","こ"],["は"],["アモン"],["、"],["その"],["子","こ"],["は"],["ヨシヤ"],["、"]]},{"verse":15,"text":"ヨシヤの子,こらは長子,ちょうしヨハナン、次,つぎはエホヤキム、第,だい三はゼデキヤ、第,だい四はシャルムである。","tok":[["ヨシヤ"],["の"],["子","こ"],["ら"],["は"],["長子","ちょうし"],["ヨハナン"],["、"],["次","つぎ"],["は"],["エホヤキム"],["、"],["第","だい"],["三","さん"],["は"],["ゼデキヤ"],["、"],["第","だい"],["四","よん"],["は"],["シャルム"],["で"],["ある"],["。"]]},{"verse":16,"text":"エホヤキムの子孫,しそんはその子,こはエコニア、その子,こはゼデキヤである。","tok":[["エホヤキム"],["の"],["子孫","しそん"],["は"],["その"],["子","こ"],["は"],["エコニア"],["、"],["その"],["子","こ"],["は"],["ゼデキヤ"],["で"],["ある"],["。"]]},{"verse":17,"text":"捕虜,ほりょとなったエコニヤの子,こらはその子,こシャルテル、","tok":[["捕虜","ほりょ"],["と"],["なった"],["エコニヤ"],["の"],["子","こ"],["ら"],["は"],["その"],["子","こ"],["シャルテル"],["、"]]},{"verse":18,"text":"マルキラム、ペダヤ、セナザル、エカミア、ホシャマ、ネダビヤである。","tok":[["マルキラム"],["、"],["ペダヤ"],["、"],["セナザル"],["、"],["エカミア"],["、"],["ホシャマ"],["、"],["ネダビヤ"],["で"],["ある"],["。"]]},{"verse":19,"text":"ペダヤの子,こらはゼルバベルとシメイである。ゼルバベルの子,こらはメシュラムとハナニヤ。シロミテは彼,かれらの姉妹,しまいである。","tok":[["ペダヤ"],["の"],["子","こ"],["ら"],["は"],["ゼルバベル"],["と"],["シメイ"],["で"],["ある"],["。"],["ゼルバベル"],["の"],["子","こ"],["ら"],["は"],["メシュラム"],["と"],["ハナニヤ"],["。"],["シロミテ"],["は"],["彼","かれ"],["ら"],["の"],["姉妹","しまい"],["で"],["ある"],["。"]]},{"verse":20,"text":"またハシュバ、オヘル、ベレキヤ、ハサデヤ、ユサブ・ヘセデの五人,にんがある。","tok":[["また"],["ハシュバ"],["、"],["オヘル"],["、"],["ベレキヤ"],["、"],["ハサデヤ"],["、"],["ユサブ"],["・"],["ヘセデ"],["の"],["五人","にん"],["が"],["ある"],["。"]]},{"verse":21,"text":"ハナニヤの子,こらはペラテヤとエシャヤ、その子,こレパヤ、その子,こアルナン、その子,こオバデヤ、その子,こシカニヤである。","tok":[["ハナニヤ"],["の"],["子","こ"],["ら"],["は"],["ペラテヤ"],["と"],["エシャヤ"],["、"],["その"],["子","こ"],["レパヤ"],["、"],["その"],["子","こ"],["アルナン"],["、"],["その"],["子","こ"],["オバデヤ"],["、"],["その"],["子","こ"],["シカニヤ"],["で"],["ある"],["。"]]},{"verse":22,"text":"シカニヤの子,こらはシマヤ。シマヤの子,こらはハットシ、イガル、バリア、ネアリヤ、シャパテの六人,にんである。","tok":[["シカニヤ"],["の"],["子","こ"],["ら"],["は"],["シマヤ"],["。"],["シマヤ"],["の"],["子","こ"],["ら"],["は"],["ハットシ"],["、"],["イガル"],["、"],["バリア"],["、"],["ネアリヤ"],["、"],["シャパテ"],["の"],["六人","にん"],["で"],["ある"],["。"]]},{"verse":23,"text":"ネアリヤの子,こらはエリオエナイ、ヒゼキヤ、アズリカムの三人,にんである。","tok":[["ネアリヤ"],["の"],["子","こ"],["ら"],["は"],["エリオエナイ"],["、"],["ヒゼキヤ"],["、"],["アズリカム"],["の"],["三人","にん"],["で"],["ある"],["。"]]},{"verse":24,"text":"エリオエナイの子,こらはホダヤ、エリアシブ、ペラヤ、アックブ、ヨハナン、デラヤ、アナニの七人,にんである。","tok":[["エリオエナイ"],["の"],["子","こ"],["ら"],["は"],["ホダヤ"],["、"],["エリアシブ"],["、"],["ペラヤ"],["、"],["アックブ"],["、"],["ヨハナン"],["、"],["デラヤ"],["、"],["アナニ"],["の"],["七人","にん"],["で"],["ある"],["。"]]}]
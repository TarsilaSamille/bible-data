[{"verse":1,"text":"イスラエルの子,こらは次,つぎのとおりである。ルベン、シメオン、レビ、ユダ、イッサカル、ゼブルン、","tok":[["イスラエル"],["の"],["子","こ"],["ら"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["ルベン"],["、"],["シメオン"],["、"],["レビ"],["、"],["ユダ"],["、"],["イッサカル"],["、"],["ゼブルン"],["、"]]},{"verse":2,"text":"ダン、ヨセフ、ベニヤミン、ナフタリ、ガド、アセル。","tok":[["ダン"],["、"],["ヨセフ"],["、"],["ベニヤミン"],["、"],["ナフタリ"],["、"],["ガド"],["、"],["アセル"],["。"]]},{"verse":3,"text":"ユダの子,こらはエル、オナン、シラである。この三人,にんはカナンの女,おんなバテシュアがユダによって産,うんだ者,ものである。ユダの長子,ちょうしエルは主,しゅの前,まえに悪,あくを行,おこなったので、主,しゅは彼,かれを殺,ころされた。","tok":[["ユダ"],["の"],["子","こ"],["ら"],["は"],["エル"],["、"],["オナン"],["、"],["シラ"],["で"],["ある"],["。"],["この"],["三人","にん"],["は"],["カナン"],["の"],["女","おんな"],["バテシュア"],["が"],["ユダ"],["によって"],["産んだ","うんだ"],["者","もの"],["で"],["ある"],["。"],["ユダ"],["の"],["長子","ちょうし"],["エル"],["は"],["主","しゅ"],["の"],["前","まえ"],["に"],["悪","あく"],["を"],["行なった","おこなった"],["ので"],["、"],["主","しゅ"],["は"],["彼","かれ"],["を"],["殺ろされた","ころされた"],["。"]]},{"verse":4,"text":"ユダの嫁,よめタマルはユダによってペレヅとゼラを産,うんだ。ユダの子,こらは合,あわせて五人,にんである。","tok":[["ユダ"],["の"],["嫁","よめ"],["タマル"],["は"],["ユダ"],["によって"],["ペレヅ"],["と"],["ゼラ"],["を"],["産んだ","うんだ"],["。"],["ユダ"],["の"],["子","こ"],["ら"],["は"],["合","あわせ"],["て"],["五人","にん"],["で"],["ある"],["。"]]},{"verse":5,"text":"ペレヅの子,こらはヘヅロンとハムル。","tok":[["ペレヅ"],["の"],["子","こ"],["ら"],["は"],["ヘヅロン"],["と"],["ハムル"],["。"]]},{"verse":6,"text":"ゼラの子,こらはジムリ、エタン、ヘマン、カルコル、ダラで、合,あわせて五人,にんである。","tok":[["ゼラ"],["の"],["子","こ"],["ら"],["は"],["ジムリ"],["、"],["エタン"],["、"],["ヘマン"],["、"],["カルコル"],["、"],["ダラ"],["で"],["、"],["合","あわせ"],["て"],["五人","にん"],["で"],["ある"],["。"]]},{"verse":7,"text":"カルミの子,こはアカル。アカルは奉納物,ほうのうぶつについて罪,つみを犯,おかし、イスラエルを悩,なやました者,ものである。","tok":[["カルミ"],["の"],["子","こ"],["は"],["アカル"],["。"],["アカル"],["は"],["奉納物","ほうのうぶつ"],["について"],["罪","つみ"],["を"],["犯し","おかし"],["、"],["イスラエル"],["を"],["悩した","なやました"],["者","もの"],["で"],["ある"],["。"]]},{"verse":8,"text":"エタンの子,こはアザリヤである。","tok":[["エタン"],["の"],["子","こ"],["は"],["アザリヤ"],["で"],["ある"],["。"]]},{"verse":9,"text":"ヘヅロンに生,うまれた子,こらはエラメル、ラム、ケルバイである。","tok":[["ヘヅロン"],["に"],["生まれた","うまれた"],["子","こ"],["ら"],["は"],["エラメル"],["、"],["ラム"],["、"],["ケルバイ"],["で"],["ある"],["。"]]},{"verse":10,"text":"ラムはアミナダブを生,うみ、アミナダブはユダの子孫,しそんのつかさナションを生,うんだ。","tok":[["ラム"],["は"],["アミナダブ"],["を"],["生み","うみ"],["、"],["アミナダブ"],["は"],["ユダ"],["の"],["子孫","しそん"],["の"],["つかさ"],["ナション"],["を"],["生んだ","うんだ"],["。"]]},{"verse":11,"text":"ナションはサルマを生,うみ、サルマはボアズを生,うみ、","tok":[["ナション"],["は"],["サルマ"],["を"],["生み","うみ"],["、"],["サルマ"],["は"],["ボアズ"],["を"],["生み","うみ"],["、"]]},{"verse":12,"text":"ボアズはオベデを生,うみ、オベデはエッサイを生,うんだ。","tok":[["ボアズ"],["は"],["オベデ"],["を"],["生み","うみ"],["、"],["オベデ"],["は"],["エッサイ"],["を"],["生んだ","うんだ"],["。"]]},{"verse":13,"text":"エッサイは長子,ちょうしエリアブ、次,つぎにアビナダブ、第,だい三にシメア、","tok":[["エッサイ"],["は"],["長子","ちょうし"],["エリアブ"],["、"],["次","つぎ"],["に"],["アビナダブ"],["、"],["第","だい"],["三","さん"],["に"],["シメア"],["、"]]},{"verse":14,"text":"第,だい四にネタンエル、第,だい五にラダイ、","tok":[["第","だい"],["四","よん"],["に"],["ネタンエル"],["、"],["第","だい"],["五","ご"],["に"],["ラダイ"],["、"]]},{"verse":15,"text":"第,だい六にオゼム、第,だい七にダビデを生,うんだ。","tok":[["第六","だい六"],["に"],["オゼム"],["、"],["第","だい"],["七","なな"],["に"],["ダビデ"],["を"],["生んだ","うんだ"],["。"]]},{"verse":16,"text":"彼,かれらの姉妹,しまいはゼルヤとアビガイルである。ゼルヤの産,うんだ子,こはアビシャイ、ヨアブ、アサヘルの三人,にんである。","tok":[["彼","かれ"],["ら"],["の"],["姉妹","しまい"],["は"],["ゼルヤ"],["と"],["アビガイル"],["で"],["ある"],["。"],["ゼルヤ"],["の"],["産んだ","うんだ"],["子","こ"],["は"],["アビシャイ"],["、"],["ヨアブ"],["、"],["アサヘル"],["の"],["三人","にん"],["で"],["ある"],["。"]]},{"verse":17,"text":"アビガイルはアマサを産,うんだ。アマサの父,ちちはイシマエルびとエテルである。","tok":[["アビガイル"],["は"],["アマサ"],["を"],["産んだ","うんだ"],["。"],["アマサ"],["の"],["父","ちち"],["は"],["イシマエル"],["びと"],["エテル"],["で"],["ある"],["。"]]},{"verse":18,"text":"ヘヅロンの子,こカレブはその妻,つまアズバおよびエリオテによって子,こをもうけた。その子,こらはエシル、ショバブ、アルドンである。","tok":[["ヘヅロン"],["の"],["子","こ"],["カレブ"],["は"],["その"],["妻","つま"],["アズバ"],["および"],["エリオテ"],["によって"],["子","こ"],["を"],["もうけた"],["。"],["その"],["子","こ"],["ら"],["は"],["エシル"],["、"],["ショバブ"],["、"],["アルドン"],["で"],["ある"],["。"]]},{"verse":19,"text":"カレブはアズバが死,しんだのでエフラタをめとった。エフラタはカレブによってホルを産,うんだ。","tok":[["カレブ"],["は"],["アズバ"],["が"],["死んだ","しんだ"],["ので"],["エフラタ"],["を"],["めとった"],["。"],["エフラタ"],["は"],["カレブ"],["によって"],["ホル"],["を"],["産んだ","うんだ"],["。"]]},{"verse":20,"text":"ホルはウリを生,うみ、ウリはベザレルを生,うんだ。","tok":[["ホル"],["は"],["ウリ"],["を"],["生み","うみ"],["、"],["ウリ"],["は"],["ベザレル"],["を"],["生んだ","うんだ"],["。"]]},{"verse":21,"text":"そののちヘヅロンはギレアデの父,ちちマキルの娘,むすめの所,ところにはいった。彼,かれが彼女,かのじょをめとったときは六十歳,さいであった。彼女,かのじょはヘヅロンによってセグブを産,うんだ。","tok":[["その"],["のち"],["ヘヅロン"],["は"],["ギレアデ"],["の"],["父","ちち"],["マキル"],["の"],["娘","むすめ"],["の"],["所","ところ"],["に"],["はいった"],["。"],["彼","かれ"],["が"],["彼女","かのじょ"],["を"],["めとった"],["とき"],["は"],["六十歳","さ"],["いで"],["あった"],["。"],["彼女","かのじょ"],["は"],["ヘヅロン"],["によって"],["セグブ"],["を"],["産んだ","うんだ"],["。"]]},{"verse":22,"text":"セグブはヤイルを生,うんだ。ヤイルはギレアデの地,ちに二十三の町,まちをもっていた。","tok":[["セグブ"],["は"],["ヤイル"],["を"],["生んだ","うんだ"],["。"],["ヤイル"],["は"],["ギレアデ"],["の"],["地","ち"],["に"],["二十三","にじゅうさん"],["の"],["町","まち"],["を"],["もって"],["いた"],["。"]]},{"verse":23,"text":"しかしゲシュルとアラムは彼,かれらからハボテ・ヤイルおよびケナテとその村里,むらざとなど合,あわせて六十の町,まちを取,とった。これらはみなギレアデの父,ちちマキルの子孫,しそんであった。","tok":[["しかし"],["ゲシュル"],["と"],["アラム"],["は"],["彼","かれ"],["ら"],["から"],["ハボテ"],["・"],["ヤイル"],["および"],["ケナテ"],["と"],["その"],["村里","むらざと"],["など"],["合","あわせ"],["て"],["六十","ろくじゅう"],["の"],["町","まち"],["を"],["取った","とった"],["。"],["これ"],["ら"],["は"],["みな"],["ギレアデ"],["の"],["父","ちち"],["マキル"],["の"],["子孫","しそん"],["で"],["あった"],["。"]]},{"verse":24,"text":"ヘヅロンが死,しんだのち、カレブは父,ちちヘヅロンの妻,つまエフラタの所,ところにはいった。彼女,かのじょは彼,かれにテコアの父,ちちアシュルを産,うんだ。","tok":[["ヘヅロン"],["が"],["死んだ","しんだ"],["のち"],["、"],["カレブ"],["は"],["父","ちち"],["ヘヅロン"],["の"],["妻","つま"],["エフラタ"],["の"],["所","ところ"],["に"],["はいった"],["。"],["彼女","かのじょ"],["は"],["彼","かれ"],["に"],["テコア"],["の"],["父","ちち"],["アシュル"],["を"],["産んだ","うんだ"],["。"]]},{"verse":25,"text":"ヘヅロンの長子,ちょうしエラメルの子,こらは長子,ちょうしラム、次,つぎはブナ、オレン、オゼム、アヒヤである。","tok":[["ヘヅロン"],["の"],["長子","ちょうし"],["エラメル"],["の"],["子","こ"],["ら"],["は"],["長子","ちょうし"],["ラム"],["、"],["次","つぎ"],["は"],["ブナ"],["、"],["オレン"],["、"],["オゼム"],["、"],["アヒヤ"],["で"],["ある"],["。"]]},{"verse":26,"text":"エラメルはまたほかの妻,つまをもっていた。名,なをアタラといって、オナムの母,ははである。","tok":[["エラメル"],["は"],["また"],["ほか"],["の"],["妻","つま"],["を"],["もって"],["いた"],["。"],["名","な"],["を"],["アタラ"],["と"],["いって"],["、"],["オナム"],["の"],["母","はは"],["で"],["ある"],["。"]]},{"verse":27,"text":"エラメルの長子,ちょうしラムの子,こらはマアツ、ヤミン、エケルである。","tok":[["エラメル"],["の"],["長子","ちょうし"],["ラム"],["の"],["子","こ"],["ら"],["は"],["マアツ"],["、"],["ヤミン"],["、"],["エケル"],["で"],["ある"],["。"]]},{"verse":28,"text":"オナムの子,こらはシャンマイとヤダである。シャンマイの子,こらはナダブとアビシュルである。","tok":[["オナム"],["の"],["子","こ"],["ら"],["は"],["シャンマイ"],["と"],["ヤダ"],["で"],["ある"],["。"],["シャンマイ"],["の"],["子","こ"],["ら"],["は"],["ナダブ"],["と"],["アビシュル"],["で"],["ある"],["。"]]},{"verse":29,"text":"アビシュルの妻,つまの名,なはアビハイルといって、アバンとモリデを産,うんだ。","tok":[["アビシュル"],["の"],["妻","つま"],["の"],["名","な"],["は"],["アビハイル"],["と"],["いって"],["、"],["アバン"],["と"],["モリデ"],["を"],["産んだ","うんだ"],["。"]]},{"verse":30,"text":"ナダブの子,こらはセレデとアッパイムである。セレデは子,こをもたずに死,しんだ。","tok":[["ナダブ"],["の"],["子","こ"],["ら"],["は"],["セレデ"],["と"],["アッパイム"],["で"],["ある"],["。"],["セレデ"],["は"],["子","こ"],["を"],["もたず"],["に"],["死んだ","しんだ"],["。"]]},{"verse":31,"text":"アッパイムの子,こはイシ、イシの子,こはセシャン、セシャンの子,こはアヘライである。","tok":[["アッパイム"],["の"],["子","こ"],["は"],["イシ"],["、"],["イシ"],["の"],["子","こ"],["は"],["セシャン"],["、"],["セシャン"],["の"],["子","こ"],["は"],["アヘライ"],["で"],["ある"],["。"]]},{"verse":32,"text":"シャンマイの兄弟,きょうだいヤダの子,こらはエテルとヨナタンである。エテルは子,こをもたずに死,しんだ。","tok":[["シャンマイ"],["の"],["兄弟","きょうだい"],["ヤダ"],["の"],["子","こ"],["ら"],["は"],["エテル"],["と"],["ヨナタン"],["で"],["ある"],["。"],["エテル"],["は"],["子","こ"],["を"],["もたず"],["に"],["死んだ","しんだ"],["。"]]},{"verse":33,"text":"ヨナタンの子,こらはペレテとザザである。以上,いじょうはエラメルの子孫,しそんである。","tok":[["ヨナタン"],["の"],["子","こ"],["ら"],["は"],["ペレテ"],["と"],["ザザ"],["で"],["ある"],["。"],["以上","いじょう"],["は"],["エラメル"],["の"],["子孫","しそん"],["で"],["ある"],["。"]]},{"verse":34,"text":"セシャンには男,おとこの子,こはなく、ただ女,おんなの子,このみであったが、彼,かれはヤルハと呼,よぶエジプトびとの奴隷,どれいをもっていたので、","tok":[["セシャン"],["に"],["は"],["男の子","おとこのこ"],["は"],["なく"],["、"],["ただ"],["女の子","おんなのこ"],["のみ"],["で"],["あった"],["が"],["、"],["彼","かれ"],["は"],["ヤルハ"],["と"],["呼ぶ","よぶ"],["エジプト"],["びと"],["の"],["奴隷","どれい"],["を"],["もって"],["いた"],["ので"],["、"]]},{"verse":35,"text":"セシャンは娘,むすめを奴隷,どれいヤルハに与,あたえてその妻,つまとさせた。彼女,かのじょはヤルハによってアッタイを産,うんだ。","tok":[["セシャン"],["は"],["娘","むすめ"],["を"],["奴隷","どれい"],["ヤルハ"],["に"],["与","あたえ"],["て"],["その"],["妻","つま"],["と"],["させた"],["。"],["彼女","かのじょ"],["は"],["ヤルハ"],["によって"],["アッタイ"],["を"],["産んだ","うんだ"],["。"]]},{"verse":36,"text":"アッタイはナタンを生,うみ、ナタンはザバデを生,うみ、","tok":[["アッタイ"],["は"],["ナタン"],["を"],["生み","うみ"],["、"],["ナタン"],["は"],["ザバデ"],["を"],["生み","うみ"],["、"]]},{"verse":37,"text":"ザバデはエフラルを生,うみ、エフラルはオベデを生,うみ、","tok":[["ザバデ"],["は"],["エフラル"],["を"],["生み","うみ"],["、"],["エフラル"],["は"],["オベデ"],["を"],["生み","うみ"],["、"]]},{"verse":38,"text":"オベデはエヒウを生,うみ、エヒウはアザリヤを生,うみ、","tok":[["オベデ"],["は"],["エヒウ"],["を"],["生み","うみ"],["、"],["エヒウ"],["は"],["アザリヤ"],["を"],["生み","うみ"],["、"]]},{"verse":39,"text":"アザリヤはヘレヅを生,うみ、ヘレヅはエレアサを生,うみ、","tok":[["アザリヤ"],["は"],["ヘレヅ"],["を"],["生み","うみ"],["、"],["ヘレヅ"],["は"],["エレアサ"],["を"],["生み","うみ"],["、"]]},{"verse":40,"text":"エレアサはシスマイを生,うみ、シスマイはシャルムを生,うみ、","tok":[["エレアサ"],["は"],["シスマイ"],["を"],["生み","うみ"],["、"],["シスマイ"],["は"],["シャルム"],["を"],["生み","うみ"],["、"]]},{"verse":41,"text":"シャルムはエカミヤを生,うみ、エカミヤはエリシャマを生,うんだ。","tok":[["シャルム"],["は"],["エカミヤ"],["を"],["生み","うみ"],["、"],["エカミヤ"],["は"],["エリシャマ"],["を"],["生んだ","うんだ"],["。"]]},{"verse":42,"text":"エラメルの兄弟,きょうだいであるカレブの子,こらは長子,ちょうしをマレシャといってジフの父,ちちである。マレシャの子,こはヘブロン。","tok":[["エラメル"],["の"],["兄弟","きょうだい"],["で"],["ある"],["カレブ"],["の"],["子","こ"],["ら"],["は"],["長子","ちょうし"],["を"],["マレシャ"],["と"],["いって"],["ジフ"],["の"],["父","ちち"],["で"],["ある"],["。"],["マレシャ"],["の"],["子","こ"],["は"],["ヘブロン"],["。"]]},{"verse":43,"text":"ヘブロンの子,こらはコラ、タップア、レケム、シマである。","tok":[["ヘブロン"],["の"],["子","こ"],["ら"],["は"],["コラ"],["、"],["タップア"],["、"],["レケム"],["、"],["シマ"],["で"],["ある"],["。"]]},{"verse":44,"text":"シマはラハムを生,うんだ。ラハムはヨルカムの父,ちちである。またレケムはシャンマイを生,うんだ。","tok":[["シマ"],["は"],["ラハム"],["を"],["生んだ","うんだ"],["。"],["ラハム"],["は"],["ヨルカム"],["の"],["父","ちち"],["で"],["ある"],["。"],["また"],["レケム"],["は"],["シャンマイ"],["を"],["生んだ","うんだ"],["。"]]},{"verse":45,"text":"シャンマイの子,こはマオン。マオンはベテヅルの父,ちちである。","tok":[["シャンマイ"],["の"],["子","こ"],["は"],["マオン"],["。"],["マオン"],["は"],["ベテヅル"],["の"],["父","ちち"],["で"],["ある"],["。"]]},{"verse":46,"text":"カレブのそばめエパはハラン、モザ、ガゼズを産,うんだ。ハランはガゼズを生,うんだ。","tok":[["カレブ"],["の"],["そばめ"],["エパ"],["は"],["ハラン"],["、"],["モザ"],["、"],["ガゼズ"],["を"],["産んだ","うんだ"],["。"],["ハラン"],["は"],["ガゼズ"],["を"],["生んだ","うんだ"],["。"]]},{"verse":47,"text":"エダイの子,こらはレゲム、ヨタム、ゲシャン、ペレテ、エパ、シャフである。","tok":[["エダイ"],["の"],["子","こ"],["ら"],["は"],["レゲム"],["、"],["ヨタム"],["、"],["ゲシャン"],["、"],["ペレテ"],["、"],["エパ"],["、"],["シャフ"],["で"],["ある"],["。"]]},{"verse":48,"text":"カレブのそばめマアカはシベルとテルハナを産,うみ、","tok":[["カレブ"],["の"],["そばめ"],["マアカ"],["は"],["シベル"],["と"],["テルハナ"],["を"],["産み","うみ"],["、"]]},{"verse":49,"text":"またマデマンナの父,ちちシャフおよびマクベナとギベアの父,ちちシワを産,うんだ。カレブの娘,むすめはアクサである。","tok":[["また"],["マデマンナ"],["の"],["父","ちち"],["シャフ"],["および"],["マクベナ"],["と"],["ギベア"],["の"],["父","ちち"],["シワ"],["を"],["産んだ","うんだ"],["。"],["カレブ"],["の"],["娘","むすめ"],["は"],["アクサ"],["で"],["ある"],["。"]]},{"verse":50,"text":"これらはカレブの子孫,しそんであった。エフラタの長子,ちょうしホルの子,こらはキリアテ・ヤリムの父,ちちショバル、","tok":[["これ"],["ら"],["は"],["カレブ"],["の"],["子孫","しそん"],["で"],["あった"],["。"],["エフラタ"],["の"],["長子","ちょうし"],["ホル"],["の"],["子","こ"],["ら"],["は"],["キリアテ"],["・"],["ヤリム"],["の"],["父","ちち"],["ショバル"],["、"]]},{"verse":51,"text":"ベツレヘムの父,ちちサルマおよびベテガデルの父,ちちハレフである。","tok":[["ベツレヘム"],["の"],["父","ちち"],["サルマ"],["および"],["ベテガデル"],["の"],["父","ちち"],["ハレフ"],["で"],["ある"],["。"]]},{"verse":52,"text":"キリアテ・ヤリムの父,ちちショバル子,こらはハロエとメヌコテびとの半,なかばである。","tok":[["キリアテ"],["・"],["ヤリム"],["の"],["父","ちち"],["ショバル"],["子","こ"],["ら"],["は"],["ハロエ"],["と"],["メヌコテ"],["びと"],["の"],["半ば","なかば"],["で"],["ある"],["。"]]},{"verse":53,"text":"キリアテ・ヤリムの氏族,しぞくはイテルびと、プテびと、シュマびと、ミシラびとであって、これらからザレアびとおよびエシタオルびとが出,でた。","tok":[["キリアテ"],["・"],["ヤリム"],["の"],["氏族","しぞく"],["は"],["イテル"],["び"],["と"],["、"],["プテ"],["び"],["と"],["、"],["シュマ"],["び"],["と"],["、"],["ミシラ"],["びと"],["で"],["あって"],["、"],["これ"],["ら"],["から"],["ザレア"],["びと"],["および"],["エシタオル"],["びと"],["が"],["出た","でた"],["。"]]},{"verse":54,"text":"サルマの子,こらはベツレヘム、ネトパびと、アタロテ・ベテ・ヨアブ、マナハテびとの半,なかばおよびゾリびとである。","tok":[["サルマ"],["の"],["子","こ"],["ら"],["は"],["ベツレヘム"],["、"],["ネトパ"],["び"],["と"],["、"],["アタロテ"],["・"],["ベテ"],["・"],["ヨアブ"],["、"],["マナハテ"],["びと"],["の"],["半ば","なかば"],["および"],["ゾリ"],["びと"],["で"],["ある"],["。"]]},{"verse":55,"text":"またヤベヅに住,すんでいた書記,しょきの氏族,しぞくテラテびと、シメアテびと、スカテびとである。これらはケニびとであってレカブの家,いえの先祖,せんぞハマテから出,でた者,ものである。","tok":[["また"],["ヤベヅ"],["に"],["住んで","すんで"],["いた"],["書記","しょき"],["の"],["氏族","しぞく"],["テラテ"],["び"],["と"],["、"],["シメアテ"],["び"],["と"],["、"],["スカテ"],["びと"],["で"],["ある"],["。"],["これ"],["ら"],["は"],["ケニ"],["びと"],["で"],["あって"],["レカブ"],["の"],["家","いえ"],["の"],["先祖","せんぞ"],["ハマテ"],["から"],["出た","でた"],["者","もの"],["で"],["ある"],["。"]]}]
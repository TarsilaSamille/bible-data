[{"verse":1,"text":"ここにイスラエルの人,ひとは皆,みなヘブロンにいるダビデのもとに集,あつまって来,きて言,いった、「われわれは、あなたの骨肉,こつにくです。","tok":[["ここ"],["に"],["イスラエル"],["の"],["人","ひと"],["は"],["皆","みな"],["ヘブロン"],["に"],["いる"],["ダビデ"],["の"],["もと"],["に"],["集まって","あつまって"],["来て","きて"],["言った","いった"],["、"],["「"],["われわれ"],["は"],["、"],["あなた"],["の"],["骨肉","こつにく"],["です"],["。"]]},{"verse":2,"text":"先,さきにサウルが王,おうであった時,ときにも、あなたはイスラエルを率,ひきいて出入,でいりされました。そしてあなたの神,かみ、主,しゅはあなたに『あなたはわが民,たみイスラエルを牧,ぼくする者,ものとなり、わが民,たみイスラエルの君,きみとなるであろう』と言,いわれました」。","tok":[["先","さき"],["に"],["サウル"],["が"],["王","おう"],["で"],["あった"],["時","とき"],["に"],["も"],["、"],["あなた"],["は"],["イスラエル"],["を"],["率いて","ひきいて"],["出入","でいり"],["されました"],["。"],["そして"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["あなた"],["に"],["『"],["あなた"],["は"],["わが"],["民","た"],["みイスラエル"],["を"],["牧","ぼ"],["く"],["する"],["者","もの"],["と"],["なり"],["、"],["わが"],["民","た"],["みイスラエル"],["の"],["君","きみ"],["と"],["なるで"],["あろう"],["』"],["と"],["言われました","いわれました"],["」"],["。"]]},{"verse":3,"text":"このようにイスラエルの長老,ちょうろうが皆,みなヘブロンにいる王,おうのもとに来,きたので、ダビデはヘブロンで主,しゅの前,まえに彼,かれらと契約,けいやくを結,むすんだ。そして彼,かれらは、サムエルによって語,かたられた主,しゅの言葉,ことばに従,したがってダビデに油,あぶらを注,そそぎ、イスラエルの王,おうとした。","tok":[["この"],["よう"],["に"],["イスラエル"],["の"],["長老","ちょうろう"],["が"],["皆","みな"],["ヘブロン"],["に"],["いる"],["王","おう"],["の"],["もと"],["に"],["来た","きた"],["ので"],["、"],["ダビデ"],["は"],["ヘブロン"],["で"],["主","しゅ"],["の"],["前","まえ"],["に"],["彼","かれ"],["ら"],["と"],["契約","けいやく"],["を"],["結んだ","むすんだ"],["。"],["そして"],["彼","かれ"],["ら"],["は"],["、"],["サムエル"],["によって"],["語られた","かたられた"],["主","しゅ"],["の"],["言葉","ことば"],["に"],["従って","したがって"],["ダビデ"],["に"],["油","あぶら"],["を"],["注ぎ","そそぎ"],["、"],["イスラエル"],["の"],["王","おう"],["と"],["した"],["。"]]},{"verse":4,"text":"ダビデとすべてのイスラエルはエルサレムへ行,いった。エルサレムはすなわちエブスであって、そこにはその地,ちの住民,じゅうみんであるエブスびとがいた。","tok":[["ダビデ"],["と"],["すべて"],["の"],["イスラエル"],["は"],["エルサレム"],["へ"],["行った","いった"],["。"],["エルサレム"],["は"],["すなわち"],["エブス"],["で"],["あって"],["、"],["そこ"],["に"],["は"],["その"],["地","ち"],["の"],["住民","じゅうみん"],["で"],["ある"],["エブス"],["びと"],["が"],["いた"],["。"]]},{"verse":5,"text":"エブスの住民,じゅうみんはダビデに言,いった、「あなたはここにはいってはならない」。しかし、ダビデはシオンの要害,ようがいを取,とった。これがすなわちダビデの町,まちである。","tok":[["エブス"],["の"],["住民","じゅうみん"],["は"],["ダビデ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["は"],["ここ"],["に"],["はいって"],["は"],["ならない"],["」"],["。"],["しかし"],["、"],["ダビデ"],["は"],["シオン"],["の"],["要害","ようがい"],["を"],["取った","とった"],["。"],["これ"],["が"],["すなわち"],["ダビデ"],["の"],["町","まち"],["で"],["ある"],["。"]]},{"verse":6,"text":"この時,ときダビデは言,いった、「だれでも第,だい一にエブスびとを撃,うつ者,ものを、かしらとし、将,しょうとする」。ゼルヤの子,こヨアブが第,だい一にのぼっていったので、かしらとなった。","tok":[["この"],["時","とき"],["ダビデ"],["は"],["言った","いった"],["、"],["「"],["だれ"],["で"],["も"],["第","だい"],["一","いち"],["に"],["エブス"],["びと"],["を"],["撃つ","うつ"],["者","もの"],["を"],["、"],["かしら"],["と"],["し"],["、"],["将","しょう"],["と"],["する"],["」"],["。"],["ゼルヤ"],["の"],["子","こ"],["ヨアブ"],["が"],["第","だい"],["一","いち"],["に"],["のぼって"],["いった"],["ので"],["、"],["かしら"],["と"],["なった"],["。"]]},{"verse":7,"text":"そしてダビデがその要害,ようがいに住,すんだので人々,ひとびとはこれをダビデの町,まちと名,なづけた。","tok":[["そして"],["ダビデ"],["が"],["その"],["要害","ようがい"],["に"],["住","すんだ"],["ので"],["人々","ひとびと"],["は"],["これ"],["を"],["ダビデ"],["の"],["町","まち"],["と"],["名づけた","なづけた"],["。"]]},{"verse":8,"text":"ダビデはまたその町,まちの周囲,しゅういすなわちミロから四方,しほうに石,いしがきを築,きずき、ヨアブは町,まちのほかの部分,ぶぶんを繕,つくろった。","tok":[["ダビデ"],["は"],["また"],["その"],["町","まち"],["の"],["周囲","しゅうい"],["すなわち"],["ミロ"],["から"],["四方","しほう"],["に"],["石がき","いしがき"],["を"],["築き","きずき"],["、"],["ヨアブ"],["は"],["町","まち"],["の"],["ほか"],["の"],["部分","ぶぶん"],["を"],["繕った","つくろった"],["。"]]},{"verse":9,"text":"こうしてダビデはますます大,おおいなる者,ものとなった。万軍,ばんぐんの主,しゅが彼,かれとともにおられたからである。","tok":[["こう"],["して"],["ダビデ"],["は"],["ますます"],["大いなる","おおいなる"],["者","もの"],["と"],["なった"],["。"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["が"],["彼","かれ"],["と"],["とも"],["に"],["おられた"],["から"],["で"],["ある"],["。"]]},{"verse":10,"text":"ダビデの勇士,ゆうしのおもなものは次,つぎのとおりである。彼,かれらはイスラエルのすべての人,ひととともにダビデに力,ちからをそえて国,くにを得,えさせ、主,しゅがイスラエルについて言,いわれた言葉,ことばにしたがって、彼,かれを王,おうとした人々,ひとびとである。","tok":[["ダビデ"],["の"],["勇士","ゆうし"],["の"],["おもな"],["もの"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["イスラエル"],["の"],["すべて"],["の"],["人","ひと"],["と"],["とも"],["に"],["ダビデ"],["に"],["力","ちから"],["を"],["そえて"],["国","くに"],["を"],["得させ","えさせ"],["、"],["主","しゅ"],["が"],["イスラエル"],["について"],["言われた","いわれた"],["言葉","ことば"],["に"],["したがって"],["、"],["彼","かれ"],["を"],["王","おう"],["と"],["した"],["人々","ひとびと"],["で"],["ある"],["。"]]},{"verse":11,"text":"ダビデの勇士,ゆうしの数,かずは次,つぎのとおりである。すなわち三人,にんの長,ちょうであるハクモニびとの子,こヤショベアム、彼,かれはやりをふるって三百人,にんに向,むかい、一度,どにこれを殺,ころした者,ものである。","tok":[["ダビデ"],["の"],["勇士","ゆうし"],["の"],["数","かず"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["すなわち"],["三人","にん"],["の"],["長","ちょう"],["で"],["ある"],["ハクモニ"],["びと"],["の"],["子","こ"],["ヤショベアム"],["、"],["彼","かれ"],["は"],["やり"],["を"],["ふるって"],["三百人","にん"],["に"],["向","むかい"],["、"],["一度","ど"],["に"],["これ"],["を"],["殺ろした","ころした"],["者","もの"],["で"],["ある"],["。"]]},{"verse":12,"text":"彼,かれの次,つぎはアホアびとドドの子,こエレアザルで、三勇士,ゆうしのひとりである。","tok":[["彼","かれ"],["の"],["次","つぎ"],["は"],["アホア"],["びと"],["ドド"],["の"],["子","こ"],["エレアザル"],["で"],["、"],["三","さん"],["勇士","ゆうし"],["の"],["ひとり"],["で"],["ある"],["。"]]},{"verse":13,"text":"彼,かれはダビデとともにパスダミムにいたが、ペリシテびとがそこに集,あつまって来,きて戦,たたかった。そこに一面,いちめんに大麦,おおむぎのはえた地所,じしょがあった。民,たみはペリシテびとの前,まえから逃,にげた。","tok":[["彼","かれ"],["は"],["ダビデ"],["と"],["とも"],["に"],["パスダミム"],["に"],["いた"],["が"],["、"],["ペリシテ"],["びと"],["が"],["そこ"],["に"],["集まって","あつまって"],["来て","きて"],["戦った","たたかった"],["。"],["そこ"],["に"],["一面","いちめん"],["に"],["大麦","おおむぎ"],["の"],["はえた"],["地所","じしょ"],["が"],["あった"],["。"],["民","たみ"],["は"],["ペリシテ"],["びと"],["の"],["前","まえ"],["から"],["逃た","にげた"],["。"]]},{"verse":14,"text":"しかし彼,かれは地所,じしょの中,なかに立,たってこれを防,ふせぎ、ペリシテびとを殺,ころした。そして主,しゅは大,おおいなる勝利,しょうりを与,あたえて彼,かれらを救,すくわれた。","tok":[["しかし"],["彼","かれ"],["は"],["地所","じしょ"],["の"],["中","なか"],["に"],["立って","たって"],["これ"],["を"],["防ぎ","ふせぎ"],["、"],["ペリシテ"],["びと"],["を"],["殺ろした","ころした"],["。"],["そして"],["主","しゅ"],["は"],["大いなる","おおいなる"],["勝利","しょうり"],["を"],["与","あたえ"],["て"],["彼","かれ"],["ら"],["を"],["救われた","すくわれた"],["。"]]},{"verse":15,"text":"三十人,にんの長,ちょうたちのうちの三人,にんは下,くだっていってアドラムのほらあなの岩,いわの所,ところにいるダビデのもとへ行,いった。時,ときにペリシテびとの軍勢,ぐんぜいはレパイムの谷,たにに陣,じんを取,とっていた。","tok":[["三","さん"],["十人","じゅうにん"],["の"],["長","ちょう"],["たち"],["の"],["うち"],["の"],["三人","にん"],["は"],["下って","くだって"],["いって"],["アドラム"],["の"],["ほらあな"],["の"],["岩","いわ"],["の"],["所","ところ"],["に"],["いる"],["ダビデ"],["の"],["もと"],["へ"],["行った","いった"],["。"],["時","とき"],["に"],["ペリシテ"],["びと"],["の"],["軍勢","ぐんぜい"],["は"],["レパイム"],["の"],["谷","たに"],["に"],["陣","じん"],["を"],["取って","とって"],["いた"],["。"]]},{"verse":16,"text":"その時,ときダビデは要害,ようがいにおり、ペリシテびとの先陣,せんじんはベツレヘムにあったが、","tok":[["その"],["時","とき"],["ダビデ"],["は"],["要害","ようがい"],["に"],["おり"],["、"],["ペリシテ"],["びと"],["の"],["先陣","せんじん"],["は"],["ベツレヘム"],["に"],["あった"],["が"],["、"]]},{"verse":17,"text":"ダビデはせつに望,のぞんで、「だれかベツレヘムの門,もんのかたわらにある井戸,いどの水,みずをわたしに飲,のませてくれるとよいのだが」と言,いった。","tok":[["ダビデ"],["は"],["せつ"],["に"],["望んで","のぞんで"],["、"],["「"],["だれ"],["か"],["ベツレヘム"],["の"],["門","もん"],["の"],["かたわら"],["に"],["ある"],["井戸","いど"],["の"],["水","みず"],["を"],["わたし"],["に"],["飲ませて","のませて"],["くれる"],["と"],["よい"],["の"],["だ"],["が"],["」"],["と"],["言った","いった"],["。"]]},{"verse":18,"text":"そこでその三人,にんはペリシテびとの陣,じんを突,つき通,とおって、ベツレヘムの門,もんのかたわらにある井戸,いどの水,みずをくみ取,とって、ダビデのもとに携,たずさえて来,きた。しかしダビデはそれを飲,のもうとはせず、それを主,しゅの前,まえに注,そそいで、","tok":[["そこ"],["で"],["その"],["三人","にん"],["は"],["ペリシテ"],["びと"],["の"],["陣","じん"],["を"],["突き通って","つきとおって"],["、"],["ベツレヘム"],["の"],["門","もん"],["の"],["かたわら"],["に"],["ある"],["井戸","いど"],["の"],["水","みず"],["を"],["くみ取って","くみとって"],["、"],["ダビデ"],["の"],["もと"],["に"],["携えて","たずさえて"],["来た","きた"],["。"],["しかし"],["ダビデ"],["は"],["それ"],["を"],["飲もう","のもう"],["と"],["は"],["せず"],["、"],["それ"],["を"],["主","しゅ"],["の"],["前","まえ"],["に"],["注いで","そそいで"],["、"]]},{"verse":19,"text":"言,いった、「わが神,かみよ、わたしは断,だんじてこれをいたしません。命,いのちをかけて行,いったこの人,ひとたちの血,ちをどうしてわたしは飲,のむことができましょう。彼,かれらは命,いのちをかけてこの水,みずをとって来,きたのです」。それゆえ、ダビデはこの水,みずを飲,のもうとはしなかった。三勇士,ゆうしはこのことをおこなった。","tok":[["言った","いった"],["、"],["「"],["わが"],["神","かみ"],["よ"],["、"],["わたし"],["は"],["断じて","だんじて"],["これ"],["を"],["いたしません"],["。"],["命","いのち"],["を"],["かけて"],["行った","いった"],["この"],["人","ひと"],["たち"],["の"],["血","ち"],["を"],["どう"],["して"],["わたし"],["は"],["飲む","のむ"],["こと"],["が"],["できましょう"],["。"],["彼","かれ"],["ら"],["は"],["命","いのち"],["を"],["かけて"],["この"],["水","みず"],["を"],["とって"],["来た","きた"],["の"],["です"],["」"],["。"],["それ"],["ゆえ"],["、"],["ダビデ"],["は"],["この"],["水","みず"],["を"],["飲もう","のもう"],["と"],["は"],["しなかった"],["。"],["三","さん"],["勇士","ゆうし"],["は"],["この"],["こと"],["を"],["おこなった"],["。"]]},{"verse":20,"text":"ヨアブの兄弟,きょうだいアビシャイは三十人,にんの長,ちょうであった。彼,かれはやりをふるって三百人,にんに立,たち向,むかい、これを殺,ころして三人,にんのほかに名,なを得,えた。","tok":[["ヨアブ"],["の"],["兄弟","きょうだい"],["アビシャイ"],["は"],["三","さん"],["十人","じゅうにん"],["の"],["長","ちょう"],["で"],["あった"],["。"],["彼","かれ"],["は"],["やり"],["を"],["ふるって"],["三百人","にん"],["に"],["立ち向かい","たちむかい"],["、"],["これ"],["を"],["殺ろして","ころして"],["三人","にん"],["の"],["ほか"],["に"],["名","な"],["を"],["得た","えた"],["。"]]},{"verse":21,"text":"彼,かれは三十人,にんのうち、最,もっとも尊,たっとばれた者,もので、彼,かれらのかしらとなった。しかし、かの三人,にんには及,およばなかった。","tok":[["彼","かれ"],["は"],["三","さん"],["十人","じゅうにん"],["の"],["うち"],["、"],["最も","もっとも"],["尊","た"],["っと"],["ばれた"],["者","もの"],["で"],["、"],["彼","かれ"],["ら"],["の"],["かしら"],["と"],["なった"],["。"],["しかし"],["、"],["かの"],["三人","にん"],["に"],["は"],["及ばなかった","およばなかった"],["。"]]},{"verse":22,"text":"エホヤダの子,こベナヤは、カブジエル出身,しゅっしんの勇士,ゆうしであって、多,おおくのてがらを立,たてた。彼,かれはモアブのアリエルのふたりの子,こを撃,うち殺,ころした。彼,かれはまた雪,ゆきの日,ひに下,くだっていって、穴,あなの中,なかでししを撃,うち殺,ころした。","tok":[["エホヤダ"],["の"],["子","こ"],["ベナヤ"],["は"],["、"],["カブジエル"],["出身","しゅっしん"],["の"],["勇士","ゆうし"],["で"],["あって"],["、"],["多く","おおく"],["の"],["てがら"],["を"],["立てた","たてた"],["。"],["彼","かれ"],["は"],["モアブ"],["の"],["アリエル"],["の"],["ふたり"],["の"],["子","こ"],["を"],["撃ち殺した","うちころした"],["。"],["彼","かれ"],["は"],["また"],["雪","ゆき"],["の"],["日","ひ"],["に"],["下って","くだって"],["いって"],["、"],["穴","あな"],["の"],["中","なか"],["で"],["しし"],["を"],["撃ち殺した","うちころした"],["。"]]},{"verse":23,"text":"彼,かれはまた身,みのたけ五キュビトばかりのエジプトびとを撃,うち殺,ころした。そのエジプトびとは手,てに機,はたの巻棒,まきぼうほどのやりを持,もっていたが、ベナヤはつえをとって彼,かれの所,ところへ下,くだって行,いき、エジプトびとの手,てから、やりをもぎとり、そのやりをもって彼,かれを殺,ころした。","tok":[["彼","かれ"],["は"],["また"],["身","み"],["の"],["たけ"],["五","ご"],["キュビト"],["ばかり"],["の"],["エジプト"],["びと"],["を"],["撃ち殺した","うちころした"],["。"],["その"],["エジプト"],["び"],["と"],["は"],["手","て"],["に"],["機","はた"],["の"],["巻","まき"],["棒","ぼう"],["ほど"],["の"],["やり"],["を"],["持って","もって"],["いた"],["が"],["、"],["ベナヤ"],["はつえ"],["を"],["とって"],["彼","かれ"],["の"],["所","ところ"],["へ"],["下って","くだって"],["行き","いき"],["、"],["エジプト"],["びと"],["の"],["手","て"],["から"],["、"],["やり"],["を"],["もぎとり"],["、"],["その"],["やり"],["を"],["もって"],["彼","かれ"],["を"],["殺ろした","ころした"],["。"]]},{"verse":24,"text":"エホヤダの子,こベナヤは、これらの事,ことを行,いって三勇士,ゆうしのほかに名,なを得,えた。","tok":[["エホヤダ"],["の"],["子","こ"],["ベナヤ"],["は"],["、"],["これ"],["ら"],["の"],["事","こと"],["を"],["行って","いって"],["三","さん"],["勇士","ゆうし"],["の"],["ほか"],["に"],["名","な"],["を"],["得た","えた"],["。"]]},{"verse":25,"text":"彼,かれは三十人,にんのうちに有名,ゆうめいであったが、かの三人,にんには及,およばなかった。ダビデは彼,かれを侍衛,じえいの長,ちょうとした。","tok":[["彼","かれ"],["は"],["三","さん"],["十人","じゅうにん"],["の"],["うち"],["に"],["有名","ゆうめい"],["で"],["あった"],["が"],["、"],["かの"],["三人","にん"],["に"],["は"],["及ばなかった","およばなかった"],["。"],["ダビデ"],["は"],["彼","かれ"],["を"],["侍衛","じえい"],["の"],["長","ちょう"],["と"],["した"],["。"]]},{"verse":26,"text":"軍団,ぐんだんのうちの勇士,ゆうしはヨアブの兄弟,きょうだいアサヘル。ベツレヘム出身,しゅっしんのドドの子,こエルハナン。","tok":[["軍団","ぐんだん"],["の"],["うち"],["の"],["勇士","ゆうし"],["は"],["ヨアブ"],["の"],["兄弟","きょうだい"],["アサヘル"],["。"],["ベツレヘム"],["出身","しゅっしん"],["の"],["ドド"],["の"],["子","こ"],["エルハナン"],["。"]]},{"verse":27,"text":"ハロデ出身,しゅっしんのシャンマ。ペロンびとヘレヅ。","tok":[["ハロデ"],["出身","しゅっしん"],["の"],["シャンマ"],["。"],["ペロン"],["びと"],["ヘレヅ"],["。"]]},{"verse":28,"text":"テコア出身,しゅっしんのイッケシの子,こイラ。アナトテ出身,しゅっしんのアビエゼル。","tok":[["テコア"],["出身","しゅっしん"],["の"],["イッケシ"],["の"],["子","こ"],["イラ"],["。"],["アナトテ"],["出身","しゅっしん"],["の"],["アビエゼル"],["。"]]},{"verse":29,"text":"ホシャテびとシベカイ。アホアびとイライ。","tok":[["ホシャテ"],["びと"],["シベカイ"],["。"],["アホア"],["びと"],["イライ"],["。"]]},{"verse":30,"text":"ネトパ出身,しゅっしんのマハライ。ネトパ出身,しゅっしんのバアナの子,こヘレデ。","tok":[["ネトパ"],["出身","しゅっしん"],["の"],["マハライ"],["。"],["ネトパ"],["出身","しゅっしん"],["の"],["バアナ"],["の"],["子","こ"],["ヘレデ"],["。"]]},{"verse":31,"text":"ベニヤミンびとのギベアから出,でたリバイの子,こイタイ。ピラトンのベナヤ。","tok":[["ベニヤミン"],["びと"],["の"],["ギベア"],["から"],["出た","でた"],["リバイ"],["の"],["子","こ"],["イタイ"],["。"],["ピラトン"],["の"],["ベナヤ"],["。"]]},{"verse":32,"text":"ガアシの谷,たにのホライ。アルバテびとアビエル。","tok":[["ガアシ"],["の"],["谷","たに"],["の"],["ホライ"],["。"],["アルバテ"],["びと"],["アビエル"],["。"]]},{"verse":33,"text":"バハルム出身,しゅっしんのアズマウテ。シャルボン出身,しゅっしんのエリヤバ。","tok":[["バハルム"],["出身","しゅっしん"],["の"],["アズマウテ"],["。"],["シャルボン"],["出身","しゅっしん"],["の"],["エリヤバ"],["。"]]},{"verse":34,"text":"ギゾンびとハセム。ハラルびとシャゲの子,こヨナタン。","tok":[["ギゾン"],["びと"],["ハセム"],["。"],["ハラル"],["び"],["と"],["シャゲ"],["の"],["子","こ"],["ヨナタン"],["。"]]},{"verse":35,"text":"ハラルびとサカルの子,こアヒアム。ウルの子,こエリパル。","tok":[["ハラル"],["び"],["と"],["サカル"],["の"],["子","こ"],["アヒアム"],["。"],["ウル"],["の"],["子","こ"],["エリパル"],["。"]]},{"verse":36,"text":"メケラテびとヘペル。ペロンびとアヒヤ。","tok":[["メケラテ"],["びと"],["ヘペル"],["。"],["ペロン"],["び"],["と"],["アヒヤ"],["。"]]},{"verse":37,"text":"カルメル出身,しゅっしんのヘズロ。エズバイの子,こナアライ。","tok":[["カルメル"],["出身","しゅっしん"],["の"],["ヘズロ"],["。"],["エズバイ"],["の"],["子","こ"],["ナアライ"],["。"]]},{"verse":38,"text":"ナタンの兄弟,きょうだいヨエル。ハグリの子,こミブハル。","tok":[["ナタン"],["の"],["兄弟","きょうだい"],["ヨエル"],["。"],["ハグリ"],["の"],["子","こ"],["ミブハル"],["。"]]},{"verse":39,"text":"アンモンびとゼレク。ゼルヤの子,こヨアブの武器,ぶきを執,とるもの、ベエロテ出身,しゅっしんのナハライ。","tok":[["アンモン"],["びと"],["ゼレク"],["。"],["ゼルヤ"],["の"],["子","こ"],["ヨアブ"],["の"],["武器","ぶき"],["を"],["執る","とる"],["もの"],["、"],["ベエロテ"],["出身","しゅっしん"],["の"],["ナハライ"],["。"]]},{"verse":40,"text":"イテルびとイラ。イテルびとガレブ。","tok":[["イテル"],["びと"],["イラ"],["。"],["イテル"],["びと"],["ガレブ"],["。"]]},{"verse":41,"text":"ヘテびとウリヤ。アハライの子,こザバデ。","tok":[["ヘテ"],["びと"],["ウリヤ"],["。"],["アハライ"],["の"],["子","こ"],["ザバデ"],["。"]]},{"verse":42,"text":"ルベンびとシザの子,こアデナ。彼,かれはルベンびとの長,ちょうであって、三十人,にんを率,ひきいた。","tok":[["ルベン"],["びと"],["シザ"],["の"],["子","こ"],["アデナ"],["。"],["彼","かれ"],["は"],["ルベン"],["びと"],["の"],["長","ちょう"],["で"],["あって"],["、"],["三","さん"],["十人","じゅうにん"],["を"],["率いた","ひきいた"],["。"]]},{"verse":43,"text":"またマアカの子,こハナン。ミテニびとヨシャパテ。","tok":[["また"],["マアカ"],["の"],["子","こ"],["ハナン"],["。"],["ミテニ"],["びと"],["ヨシャパテ"],["。"]]},{"verse":44,"text":"アシテラテびとウジヤ。アロエルびとホタムの子,こらシャマとエイエル。","tok":[["アシテラテ"],["びと"],["ウジヤ"],["。"],["アロエル"],["びと"],["ホタム"],["の"],["子","こ"],["ら"],["シャマ"],["と"],["エイエル"],["。"]]},{"verse":45,"text":"テジびとシムリの子,こエデアエルおよびその兄弟,きょうだいヨハ。","tok":[["テジ"],["び"],["と"],["シムリ"],["の"],["子","こ"],["エデアエル"],["および"],["その"],["兄弟","きょうだい"],["ヨハ"],["。"]]},{"verse":46,"text":"マハブびとエリエル。エルナアムの子,こらエリバイおよびヨシャビヤ。モアブびとイテマ。","tok":[["マハブ"],["びと"],["エリエル"],["。"],["エルナアム"],["の"],["子","こ"],["ら"],["エリバイ"],["および"],["ヨシャビヤ"],["。"],["モアブ"],["びと"],["イテマ"],["。"]]},{"verse":47,"text":"エリエル、オベデおよびメゾバびとヤシエルである。","tok":[["エリエル"],["、"],["オベデ"],["および"],["メゾバ"],["びと"],["ヤシエル"],["で"],["ある"],["。"]]}]
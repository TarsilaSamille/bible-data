[{"verse":1,"text":"ダビデと軍,ぐんの長,ちょうたちはまたアサフ、ヘマンおよびエドトンの子,こらを勤,つとめのために分,わかち、琴,ことと、立琴,たてごとと、シンバルをもって預言,よげんする者,ものにした。その勤,つとめをなした人々,ひとびとの数,かずは次,つぎのとおりである。","tok":[["ダビデ"],["と"],["軍","ぐん"],["の"],["長","ちょう"],["たち"],["は"],["また"],["アサフ"],["、"],["ヘマン"],["および"],["エドトン"],["の"],["子","こ"],["ら"],["を"],["勤め","つとめ"],["の"],["ため"],["に"],["分かち","わかち"],["、"],["琴","こと"],["と"],["、"],["立琴","たてごと"],["と"],["、"],["シンバル"],["を"],["もって"],["預言","よげん"],["する"],["者","もの"],["に"],["した"],["。"],["その"],["勤め","つとめ"],["を"],["なした"],["人々","ひとびと"],["の"],["数","かず"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"]]},{"verse":2,"text":"アサフの子,こたちはザックル、ヨセフ、ネタニヤ、アサレラであって、アサフの指揮,しきのもとに王,おうの命,いのちによって預言,よげんした者,ものである。","tok":[["アサフ"],["の"],["子","こ"],["たち"],["は"],["ザックル"],["、"],["ヨセフ"],["、"],["ネタニヤ"],["、"],["アサレラ"],["で"],["あって"],["、"],["アサフ"],["の"],["指揮","しき"],["の"],["もと"],["に"],["王","おう"],["の"],["命","いのち"],["によって"],["預言","よげん"],["した"],["者","もの"],["で"],["ある"],["。"]]},{"verse":3,"text":"エドトンについては、エドトンの子,こたちはゲダリヤ、ゼリ、エサヤ、ハシャビヤ、マッタテヤの六人,にんで、琴,ことをもって主,しゅに感謝,かんしゃし、かつほめたたえて預言,よげんしたその父,ちちエドトンの指揮,しきの下,したにあった。","tok":[["エドトン"],["について"],["は"],["、"],["エドトン"],["の"],["子","こ"],["たち"],["は"],["ゲダリヤ"],["、"],["ゼリ"],["、"],["エサヤ"],["、"],["ハシャビヤ"],["、"],["マッタテヤ"],["の"],["六人","にん"],["で"],["、"],["琴","こと"],["を"],["もって"],["主に","しゅに"],["感謝","かんしゃ"],["し"],["、"],["かつ"],["ほめたたえて"],["預言","よげん"],["した"],["その"],["父","ちち"],["エドトン"],["の"],["指揮","しき"],["の"],["下","した"],["に"],["あった"],["。"]]},{"verse":4,"text":"ヘマンについては、ヘマンの子,こたちはブッキヤ、マッタニヤ、ウジエル、シブエル、エレモテ、ハナニヤ、ハナニ、エリアタ、ギダルテ、ロマムテ・エゼル、ヨシベカシャ、マロテ、ホテル、マハジオテである。","tok":[["ヘマン"],["について"],["は"],["、"],["ヘマン"],["の"],["子","こ"],["たち"],["は"],["ブッキヤ"],["、"],["マッタニヤ"],["、"],["ウジエル"],["、"],["シブエル"],["、"],["エレモテ"],["、"],["ハナニヤ"],["、"],["ハナニ"],["、"],["エリアタ"],["、"],["ギダルテ"],["、"],["ロマムテ"],["・"],["エゼル"],["、"],["ヨシベカシャ"],["、"],["マロテ"],["、"],["ホテル"],["、"],["マハジオテ"],["で"],["ある"],["。"]]},{"verse":5,"text":"これらは皆,みな、神,かみがご自身,じしんの約束,やくそくにしたがって高,たかくされた王,おうの先見者,せんけんしゃヘマンの子,こたちであった。神,かみはヘマンに男,おとこの子,こ十四人,にん、女,おんなの子,こ三人,にんを与,あたえられた。","tok":[["これ"],["ら"],["は"],["皆","みな"],["、"],["神","かみ"],["が"],["ご自身","ごじしん"],["の"],["約束","やくそく"],["に"],["したがって"],["高かく","たかく"],["された"],["王","おう"],["の"],["先見者","せんけんしゃ"],["ヘマン"],["の"],["子","こ"],["たち"],["で"],["あった"],["。"],["神","かみ"],["は"],["ヘマン"],["に"],["男の子","おとこのこ"],["十四人","にん"],["、"],["女の子","おんなのこ"],["三人","にん"],["を"],["与えられた","あたえられた"],["。"]]},{"verse":6,"text":"これらの者,ものは皆,みなその父,ちちの指揮,しきの下,したにあって、主,しゅの宮,みやで歌,うたをうたい、シンバルと立琴,たてごとと琴,ことをもって神,かみの宮,みやの務,つとめをした。アサフ、エドトンおよびヘマンは王,おうの命,いのちの下,したにあった。","tok":[["これ"],["ら"],["の"],["者","もの"],["は"],["皆","みな"],["その"],["父","ちち"],["の"],["指揮","しき"],["の"],["下","した"],["に"],["あって"],["、"],["主","しゅ"],["の"],["宮","みや"],["で"],["歌","うた"],["を"],["うたい"],["、"],["シンバル"],["と"],["立琴","たてごと"],["と"],["琴","こと"],["を"],["もって"],["神","かみ"],["の"],["宮","みや"],["の"],["務め","つとめ"],["を"],["した"],["。"],["アサフ"],["、"],["エドトン"],["および"],["ヘマン"],["は"],["王","おう"],["の"],["命","いのち"],["の"],["下","した"],["に"],["あった"],["。"]]},{"verse":7,"text":"彼,かれらおよび主,しゅに歌,うたをうたうことのために訓練,くんれんされ、すべて熟練,じゅくれんした兄弟,きょうだいたちの数,かずは二百八十八人,にんであった。","tok":[["彼","かれ"],["ら"],["および"],["主に","しゅに"],["歌","うた"],["を"],["うたう"],["こと"],["の"],["ため"],["に"],["訓練","くんれん"],["され"],["、"],["すべて"],["熟練","じゅくれん"],["した"],["兄弟","きょうだい"],["たち"],["の"],["数","かず"],["は"],["二百八十八","にひゃくはちじゅうはち"],["人","にん"],["で"],["あった"],["。"]]},{"verse":8,"text":"彼,かれらは小,しょうなる者,ものも、大,だいなる者,ものも、教師,きょうしも生徒,せいとも皆,みなひとしくその務,つとめのためにくじを引,ひいた。","tok":[["彼","かれ"],["ら"],["は"],["小","しょう"],["なる"],["者","もの"],["も"],["、"],["大","だい"],["なる"],["者","もの"],["も"],["、"],["教師","きょうし"],["も"],["生徒","せいと"],["も"],["皆","みな"],["ひとしく"],["その"],["務め","つとめ"],["の"],["ため"],["に"],["くじ"],["を"],["引いた","ひいた"],["。"]]},{"verse":9,"text":"第,だい一のくじはアサフのためにヨセフに当,あたり、第,だい二はゲダリヤに当,あたった。彼,かれとその兄弟,きょうだいたちおよびその子,こたち、合,あわせて十二人,にん。","tok":[["第","だい"],["一","いち"],["の"],["くじ"],["は"],["アサフ"],["の"],["ため"],["に"],["ヨセフ"],["に"],["当たり","あたり"],["、"],["第","だい"],["二","に"],["は"],["ゲダリヤ"],["に"],["当たった","あたった"],["。"],["彼","かれ"],["と"],["その"],["兄弟","きょうだい"],["たち"],["および"],["その"],["子","こ"],["たち"],["、"],["合","あわせ"],["て"],["十二人","にん"],["。"]]},{"verse":10,"text":"第,だい三はザックルに当,あたった。その子,こたちおよびその兄弟,きょうだいたち、合,あわせて十二人,にん。","tok":[["第","だい"],["三","さん"],["は"],["ザックル"],["に"],["当たった","あたった"],["。"],["その"],["子","こ"],["たち"],["および"],["その"],["兄弟","きょうだい"],["たち"],["、"],["合","あわせ"],["て"],["十二人","にん"],["。"]]},{"verse":11,"text":"第,だい四はイヅリに当,あたった。その子,こたちおよびその兄弟,きょうだいたち、合,あわせて十二人,にん。","tok":[["第","だい"],["四","よん"],["は"],["イヅリ"],["に"],["当たった","あたった"],["。"],["その"],["子","こ"],["たち"],["および"],["その"],["兄弟","きょうだい"],["たち"],["、"],["合","あわせ"],["て"],["十二人","にん"],["。"]]},{"verse":12,"text":"第,だい五はネタニヤに当,あたった。その子,こたちおよびその兄弟,きょうだいたち、合,あわせて十二人,にん。","tok":[["第","だい"],["五","ご"],["は"],["ネタニヤ"],["に"],["当たった","あたった"],["。"],["その"],["子","こ"],["たち"],["および"],["その"],["兄弟","きょうだい"],["たち"],["、"],["合","あわせ"],["て"],["十二人","にん"],["。"]]},{"verse":13,"text":"第,だい六はブッキヤに当,あたった。その子,こたちおよびその兄弟,きょうだいたち、合,あわせて十二人,にん。","tok":[["第六","だい六"],["は"],["ブッキヤ"],["に"],["当たった","あたった"],["。"],["その"],["子","こ"],["たち"],["および"],["その"],["兄弟","きょうだい"],["たち"],["、"],["合","あわせ"],["て"],["十二人","にん"],["。"]]},{"verse":14,"text":"第,だい七はアサレラに当,あたった。その子,こたちおよびその兄弟,きょうだいたち、合,あわせて十二人,にん。","tok":[["第","だい"],["七","なな"],["は"],["アサレラ"],["に"],["当たった","あたった"],["。"],["その"],["子","こ"],["たち"],["および"],["その"],["兄弟","きょうだい"],["たち"],["、"],["合","あわせ"],["て"],["十二人","にん"],["。"]]},{"verse":15,"text":"第,だい八はエサヤに当,あたった。その子,こたちおよびその兄弟,きょうだいたち、合,あわせて十二人,にん。","tok":[["第","だい"],["八","はち"],["は"],["エサヤ"],["に"],["当たった","あたった"],["。"],["その"],["子","こ"],["たち"],["および"],["その"],["兄弟","きょうだい"],["たち"],["、"],["合","あわせ"],["て"],["十二人","にん"],["。"]]},{"verse":16,"text":"第,だい九はマッタニヤに当,あたった。その子,こたちおよびその兄弟,きょうだいたち、合,あわせて十二人,にん。","tok":[["第","だい"],["九","きゅう"],["は"],["マッタニヤ"],["に"],["当たった","あたった"],["。"],["その"],["子","こ"],["たち"],["および"],["その"],["兄弟","きょうだい"],["たち"],["、"],["合","あわせ"],["て"],["十二人","にん"],["。"]]},{"verse":17,"text":"第,だい十はシメイに当,あたった。その子,こたちおよびその兄弟,きょうだいたち、合,あわせて十二人,にん。","tok":[["第","だい"],["十","じゅう"],["は"],["シメイ"],["に"],["当たった","あたった"],["。"],["その"],["子","こ"],["たち"],["および"],["その"],["兄弟","きょうだい"],["たち"],["、"],["合","あわせ"],["て"],["十二人","にん"],["。"]]},{"verse":18,"text":"第,だい十一はアザリエルに当,あたった。その子,こたちおよびその兄弟,きょうだいたち、合,あわせて十二人,にん。","tok":[["第","だい"],["十一","じゅういち"],["は"],["アザリエル"],["に"],["当たった","あたった"],["。"],["その"],["子","こ"],["たち"],["および"],["その"],["兄弟","きょうだい"],["たち"],["、"],["合","あわせ"],["て"],["十二人","にん"],["。"]]},{"verse":19,"text":"第,だい十二はハシャビヤに当,あたった。その子,こたちおよびその兄弟,きょうだいたち、合,あわせて十二人,にん。","tok":[["第","だい"],["十二","じゅうに"],["は"],["ハシャビヤ"],["に"],["当たった","あたった"],["。"],["その"],["子","こ"],["たち"],["および"],["その"],["兄弟","きょうだい"],["たち"],["、"],["合","あわせ"],["て"],["十二人","にん"],["。"]]},{"verse":20,"text":"第,だい十三はシュバエルに当,あたった。その子,こたちおよびその兄弟,きょうだいたち、合,あわせて十二人,にん。","tok":[["第","だい"],["十三","じゅうさん"],["は"],["シュバエル"],["に"],["当たった","あたった"],["。"],["その"],["子","こ"],["たち"],["および"],["その"],["兄弟","きょうだい"],["たち"],["、"],["合","あわせ"],["て"],["十二人","にん"],["。"]]},{"verse":21,"text":"第,だい十四はマッタテヤに当,あたった。その子,こたちおよびその兄弟,きょうだいたち、合,あわせて十二人,にん。","tok":[["第","だい"],["十四","じゅうよん"],["は"],["マッタテヤ"],["に"],["当たった","あたった"],["。"],["その"],["子","こ"],["たち"],["および"],["その"],["兄弟","きょうだい"],["たち"],["、"],["合","あわせ"],["て"],["十二人","にん"],["。"]]},{"verse":22,"text":"第,だい十五はエレモテに当,あたった。その子,こたちおよびその兄弟,きょうだいたち、合,あわせて十二人,にん。","tok":[["第","だい"],["十五","じゅうご"],["は"],["エレモテ"],["に"],["当たった","あたった"],["。"],["その"],["子","こ"],["たち"],["および"],["その"],["兄弟","きょうだい"],["たち"],["、"],["合","あわせ"],["て"],["十二人","にん"],["。"]]},{"verse":23,"text":"第,だい十六はハナニヤに当,あたった。その子,こたちおよびその兄弟,きょうだいたち、合,あわせて十二人,にん。","tok":[["第","だい"],["十六","じゅうろく"],["は"],["ハナニヤ"],["に"],["当たった","あたった"],["。"],["その"],["子","こ"],["たち"],["および"],["その"],["兄弟","きょうだい"],["たち"],["、"],["合","あわせ"],["て"],["十二人","にん"],["。"]]},{"verse":24,"text":"第,だい十七はヨシベカシャに当,あたった。その子,こたちおよびその兄弟,きょうだいたち、合,あわせて十二人,にん。","tok":[["第","だい"],["十七","じゅうなな"],["は"],["ヨシベカシャ"],["に"],["当たった","あたった"],["。"],["その"],["子","こ"],["たち"],["および"],["その"],["兄弟","きょうだい"],["たち"],["、"],["合","あわせ"],["て"],["十二人","にん"],["。"]]},{"verse":25,"text":"第,だい十八はハナニに当,あたった。その子,こたちおよびその兄弟,きょうだいたち、合,あわせて十二人,にん。","tok":[["第","だい"],["十八","じゅうはち"],["は"],["ハナニ"],["に"],["当たった","あたった"],["。"],["その"],["子","こ"],["たち"],["および"],["その"],["兄弟","きょうだい"],["たち"],["、"],["合","あわせ"],["て"],["十二人","にん"],["。"]]},{"verse":26,"text":"第,だい十九はマロテに当,あたった。その子,こたちおよびその兄弟,きょうだいたち、合,あわせて十二人,にん。","tok":[["第","だい"],["十九","じゅうきゅう"],["は"],["マロテ"],["に"],["当たった","あたった"],["。"],["その"],["子","こ"],["たち"],["および"],["その"],["兄弟","きょうだい"],["たち"],["、"],["合","あわせ"],["て"],["十二人","にん"],["。"]]},{"verse":27,"text":"第,だい二十はエリアタに当,あたった。その子,こたちおよびその兄弟,きょうだいたち、合,あわせて十二人,にん。","tok":[["第","だい"],["二十","にじゅう"],["は"],["エリアタ"],["に"],["当たった","あたった"],["。"],["その"],["子","こ"],["たち"],["および"],["その"],["兄弟","きょうだい"],["たち"],["、"],["合","あわせ"],["て"],["十二人","にん"],["。"]]},{"verse":28,"text":"第,だい二十一はホテルに当,あたった。その子,こたちおよびその兄弟,きょうだいたち、合,あわせて十二人,にん。","tok":[["第","だい"],["二十一","にじゅういち"],["は"],["ホテル"],["に"],["当たった","あたった"],["。"],["その"],["子","こ"],["たち"],["および"],["その"],["兄弟","きょうだい"],["たち"],["、"],["合","あわせ"],["て"],["十二人","にん"],["。"]]},{"verse":29,"text":"第,だい二十二はギダルテに当,あたった。その子,こたちおよびその兄弟,きょうだいたち、合,あわせて十二人,にん。","tok":[["第","だい"],["二十二","にじゅうに"],["は"],["ギダルテ"],["に"],["当たった","あたった"],["。"],["その"],["子","こ"],["たち"],["および"],["その"],["兄弟","きょうだい"],["たち"],["、"],["合","あわせ"],["て"],["十二人","にん"],["。"]]},{"verse":30,"text":"第,だい二十三はマハジオテに当,あたった。その子,こたちおよびその兄弟,きょうだいたち、合,あわせて十二人,にん。","tok":[["第","だい"],["二十三","にじゅうさん"],["は"],["マハジオテ"],["に"],["当たった","あたった"],["。"],["その"],["子","こ"],["たち"],["および"],["その"],["兄弟","きょうだい"],["たち"],["、"],["合","あわせ"],["て"],["十二人","にん"],["。"]]},{"verse":31,"text":"第,だい二十四はロマムテ・エゼルに当,あたった。その子,こたちおよびその兄弟,きょうだいたち、合,あわせて十二人,にんであった。","tok":[["第","だい"],["二十四","にじゅうよん"],["は"],["ロマムテ"],["・"],["エゼル"],["に"],["当たった","あたった"],["。"],["その"],["子","こ"],["たち"],["および"],["その"],["兄弟","きょうだい"],["たち"],["、"],["合","あわせ"],["て"],["十二人","にん"],["で"],["あった"],["。"]]}]
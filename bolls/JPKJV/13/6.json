[{"verse":1,"text":"[16]レビの子,こらはゲルション、コハテおよびメラリ。","tok":[["["],["16"],["]"],["レビ"],["の"],["子","こ"],["ら"],["は"],["ゲルション"],["、"],["コハテ"],["および"],["メラリ"],["。"]]},{"verse":2,"text":"[17]ゲルションの子,こらの名,なはリブニとシメイ。","tok":[["["],["17"],["]"],["ゲルション"],["の"],["子","こ"],["ら"],["の"],["名","な"],["は"],["リブニ"],["と"],["シメイ"],["。"]]},{"verse":3,"text":"[18]コハテの子,こらはアムラム、イヅハル、ヘブロン、ウジエルである。","tok":[["["],["18"],["]"],["コハテ"],["の"],["子","こ"],["ら"],["は"],["アムラム"],["、"],["イヅハル"],["、"],["ヘブロン"],["、"],["ウジエル"],["で"],["ある"],["。"]]},{"verse":4,"text":"[19]メラリの子,こらはマヘリとムシ。これらはレビびとのその家筋,いえすじによる氏族,しぞくである。","tok":[["["],["19"],["]"],["メラリ"],["の"],["子","こ"],["ら"],["は"],["マヘリ"],["と"],["ムシ"],["。"],["これ"],["ら"],["は"],["レビ"],["びと"],["の"],["その"],["家筋","いえすじ"],["に"],["よる"],["氏族","しぞく"],["で"],["ある"],["。"]]},{"verse":5,"text":"[20]ゲルションの子,こはリブニ、その子,こはヤハテ、その子,こはジンマ、","tok":[["["],["20"],["]"],["ゲルション"],["の"],["子","こ"],["は"],["リブニ"],["、"],["その"],["子","こ"],["は"],["ヤハテ"],["、"],["その"],["子","こ"],["は"],["ジンマ"],["、"]]},{"verse":6,"text":"[21]その子,こはヨア、その子,こはイド、その子,こはゼラ、その子,こはヤテライ。","tok":[["["],["21"],["]"],["その"],["子","こ"],["は"],["ヨア"],["、"],["その"],["子","こ"],["は"],["イド"],["、"],["その"],["子","こ"],["は"],["ゼラ"],["、"],["その"],["子","こ"],["は"],["ヤテライ"],["。"]]},{"verse":7,"text":"[22]コハテの子,こはアミナダブ、その子,こはコラ、その子,こはアシル、","tok":[["["],["22"],["]"],["コハテ"],["の"],["子","こ"],["は"],["アミナダブ"],["、"],["その"],["子","こ"],["は"],["コラ"],["、"],["その"],["子","こ"],["は"],["アシル"],["、"]]},{"verse":8,"text":"[23]その子,こはエルカナ、その子,こはエビアサフ、その子,こはアシル、","tok":[["["],["23"],["]"],["その"],["子","こ"],["は"],["エルカナ"],["、"],["その"],["子","こ"],["は"],["エビアサフ"],["、"],["その"],["子","こ"],["は"],["アシル"],["、"]]},{"verse":9,"text":"[24]その子,こはタハテ、その子,こはウリエル、その子,こはウジヤ、その子,こはシャウル。","tok":[["["],["24"],["]"],["その"],["子","こ"],["は"],["タハテ"],["、"],["その"],["子","こ"],["は"],["ウリエル"],["、"],["その"],["子","こ"],["は"],["ウジヤ"],["、"],["その"],["子","こ"],["は"],["シャウル"],["。"]]},{"verse":10,"text":"[25]エルカナの子,こらはアマサイとアヒモテ、","tok":[["["],["25"],["]"],["エルカナ"],["の"],["子","こ"],["ら"],["は"],["アマサイ"],["と"],["ア
歌,うたをうたう者,もの、ヘマンはヨエルの子,こ、ヨエルはサムエルの子,こ、","tok":[["["],["33"],["]"],["その"],["務め","つとめ"],["を"],["した"],["もの"],["、"],["および"],["その"],["子","こ"],["ら"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["コハテ"],["びと"],["の"],["子","こ"],["ら"],["の"],["うち"],["ヘマン"],["は"],["歌","うた"],["を"],["うたう"],["者","もの"],["、"],["ヘマン"],["は"],["ヨエル"],["の"],["子","こ"],["、"],["ヨエル"],["は"],["サムエル"],["の"],["子","こ"],["、"]]},{"verse":19,"text":"[34]サムエルはエルカナの子,こ、エルカナはエロハムの子,こ、エロハムはエリエルの子,こ、エリエルはトアの子,こ、","tok":[["["],["34"],["]"],["サムエル"],["は"],["エルカナ"],["の"],["子","こ"],["、"],["エルカナ"],["は"],["エロハム"],["の"],["子","こ"],["、"],["エロハム"],["は"],["エリエル"],["の"],["子","こ"],["、"],["エリエル"],["は"],["トア"],["の"],["子","こ"],["、"]]},{"verse":20,"text":"[35]トアはヅフの子,こ、ヅフはエルカナの子,こ、エルカナはマハテの子,こ、マハテはアマサイの子,こ、","tok":[["["],["35"],["]"],["トア"],["は"],["ヅフ"],["の"],["子","こ"],["、"],["ヅフ"],["は"],["エルカナ"],["の"],["子","こ"],["、"],["エルカナ"],["は"],["マハテ"],["の"],["子","こ"],["、"],["マハテ"],["は"],["アマサイ"],["の"],["子","こ"],["、"]]},{"verse":21,"text":"[36]アマサイはエルカナの子,こ、エルカナはヨエルの子,こ、ヨエルはアザリヤの子,こ、アザリヤはゼパニヤの子,こ、","tok":[["["],["36"],["]"],["アマサイ"],["は"],["エルカナ"],["の"],["子","こ"],["、"],["エルカナ"],["は"],["ヨエル"],["の"],["子","こ"],["、"],["ヨエル"],["は"],["アザリヤ"],["の"],["子","こ"],["、"],["アザリヤ"],["は"],["ゼパニヤ"],["の"],["子","こ"],["、"]]},{"verse":22,"text":"[37]ゼパニヤはタハテの子,こ、タハテはアシルの子,こ、アシルはエビアサフの子,こ、エビアサフはコラの子,こ、","tok":[["["],["37"],["]"],["ゼパニヤ"],["は"],["タハテ"],["の"],["子","こ"],["、"],["タハテ"],["は"],["アシル"],["の"],["子","こ"],["、"],["アシル"],["は"],["エビアサフ"],["の"],["子","こ"],["、"],["エビアサフ"],["は"],["コラ"],["の"],["子","こ"],["、"]]},{"verse":23,"text":"[38]コラはイヅハルの子,こ、イヅハルはコハテの子,こ、コハテはレビの子,こ、レビはイスラエルの子,こである。","tok":[["["],["38"],["]"],["コラ"],["は"],["イヅハル"],["の"],["子","こ"],["、"],["イヅハル"],["は"],["コハテ"],["の"],["子","こ"],["、"],["コハテ"],["は"],["レビ"],["の"],["子","こ"],["、"],["レビ"],["は"],["イスラエル"],["の"],["子","こ"],["で"],["ある"],["。"]]},{"verse":24,"text":"[39]ヘマンの兄弟,きょうだいアサフはヘマンの右,みぎに立,たった。アサフはベレキヤの子,こ、ベレキヤはシメアの子,こ、","tok":[["["],["39"],["]"],["ヘマン"],["の"],["兄弟","きょうだい"],["アサフ"],["は"],["ヘマン"],["の"],["右","みぎ"],["に"],["立った","たった"],["。"],["アサフ"],["は"],["ベレキヤ"],["の"],["子","こ"],["、"],["ベレキヤ"],["は"],["シメア"],["の"],["子","こ"],["、"]]},{"verse":25,"text":"[40]シメアはミカエルの子,こ、ミカエルはバアセヤの子,こ、バアセヤはマルキヤの子,こ、","tok":[["["],["40"],["]"],["シメア"],["は"],["ミカエル"],["の"],["子","こ"],["、"],["ミカエル"],["は"],["バアセヤ"],["の"],["子","こ"],["、"],["バアセヤ"],["は"],["マルキヤ"],["の"],["子","こ"],["、"]]},{"verse":26,"text":"[41]マルキヤはエテニの子,こ、エテニはゼラの子,こ、ゼラはアダヤの子,こ、","tok":[["["],["41"],["]"],["マルキヤ"],["は"],["エテニ"],["の"],["子","こ"],["、"],["エテニ"],["は"],["ゼラ"],["の"],["子","こ"],["、"],["ゼラ"],["は"],["アダヤ"],["の"],["子","こ"],["、"]]},{"verse":27,"text":"[42]アダヤはエタンの子,こ、エタンはジンマの子,こ、ジンマはシメイの子,こ、","tok":[["["],["42"],["]"],["アダヤ"],["は"],["エタン"],["の"],["子","こ"],["、"],["エタン"],["は"],["ジンマ"],["の"],["子","こ"],["、"],["ジンマ"],["は"],["シメイ"],["の"],["子","こ"],["、"]]},{"verse":28,"text":"[43]シメイはヤハテの子,こ、ヤハテはゲルションの子,こ、ゲルションはレビの子,こである。","tok":[["["],["43"],["]"],["シメイ"],["は"],["ヤハテ"],["の"],["子","こ"],["、"],["ヤハテ"],["は"],["ゲルション"],["の"],["子","こ"],["、"],["ゲルション"],["は"],["レビ"],["の"],["子","こ"],["で"],["ある"],["。"]]},{"verse":29,"text":"[44]また彼,かれらの兄弟,きょうだいであるメラリの子,こらが左,ひだりに立,たった。そのうちのエタンはキシの子,こ、キシはアブデの子,こ、アブデはマルクの子,こ、","tok":[["["],["44"],["]"],["また"],["彼","かれ"],["ら"],["の"],["兄弟","きょうだい"],["で"],["ある"],["メラリ"],["の"],["子","こ"],["ら"],["が"],["左","ひだり"],["に"],["立った","たった"],["。"],["その"],["うち"],["の"],["エタン"],["は"],["キシ"],["の"],["子","こ"],["、"],["キシ"],["は"],["アブデ"],["の"],["子","こ"],["、"],["アブデ"],["は"],["マルク"],["の"],["子","こ"],["、"]]},{"verse":30,"text":"[45]マルクはハシャビヤの子,こ、ハシャビヤはアマジヤの子,こ、アマジヤはヒルキヤの子,こ、","tok":[["["],["45"],["]"],["マルク"],["は"],["ハシャビヤ"],["の"],["子","こ"],["、"],["ハシャビヤ"],["は"],["アマジヤ"],["の"],["子","こ"],["、"],["アマジヤ"],["は"],["ヒルキヤ"],["の"],["子","こ"],["、"]]},{"verse":31,"text":"[46]ヒルキヤはアムジの子,こ、アムジはバニの子,こ、バニはセメルの子,こ、","tok":[["["],["46"],["]"],["ヒルキヤ"],["は"],["アムジ"],["の"],["子","こ"],["、"],["アムジ"],["は"],["バニ"],["の"],["子","こ"],["、"],["バニ"],["は"],["セメル"],["の"],["子","こ"],["、"]]},{"verse":32,"text":"[47]セメルはマヘリの子,こ、マヘリはムシの子,こ、ムシはメラリの子,こ、メラリはレビの子,こである。","tok":[["["]
[{"verse":1,"text":"イスラエルの子孫,しそんのうちで氏族,しぞくの長,ちょう、千,せん人,にんの長,ちょう、百人,にんの長,ちょう、およびつかさたちは年,ねんのすべての月,つきの間,あいだ、月,つきごとに交替,こうたいして組,くみのすべての事,ことをなして王,おうに仕,つかえたが、その数,かずにしたがえば各組,かくくみ二万四千人,にんあった。","tok":[["イスラエル"],["の"],["子孫","しそん"],["の"],["うち"],["で"],["氏族","しぞく"],["の"],["長う","ちょう"],["、"],["千人","せんにん"],["の"],["長う","ちょう"],["、"],["百人","にん"],["の"],["長う","ちょう"],["、"],["および"],["つかさ"],["たち"],["は"],["年","ねん"],["の"],["すべて"],["の"],["月","つき"],["の"],["間","あいだ"],["、"],["月","つき"],["ごと"],["に"],["交替","こうたい"],["して"],["組","くみ"],["の"],["すべて"],["の"],["事","こと"],["を"],["なして"],["王","おう"],["に"],["仕えた","つかえた"],["が"],["、"],["その"],["数","かず"],["に"],["したがえば"],["各","かく"],["組","くみ"],["二万四千","にまんよんせん"],["人","にん"],["あった"],["。"]]},{"verse":2,"text":"まず第,だい一の組,くみすなわち正月,しょうがつの分,ぶんはザブデエルの子,こヤショベアムがこれを率,ひきいた。その組,くみには二万四千人,にんあった。","tok":[["まず"],["第","だい"],["一","いち"],["の"],["組","くみ"],["すなわち"],["正月","しょうがつ"],["の"],["分","ぶん"],["は"],["ザブデエル"],["の"],["子","こ"],["ヤショベアム"],["が"],["これ"],["を"],["率いた","ひきいた"],["。"],["その"],["組","くみ"],["に"],["は"],["二万四千","にまんよんせん"],["人","にん"],["あった"],["。"]]},{"verse":3,"text":"彼,かれはペレヅの子孫,しそんで、正月,しょうがつの軍団,ぐんだんのすべての将,しょうたちのかしらであった。","tok":[["彼","かれ"],["は"],["ペレヅ"],["の"],["子孫","しそん"],["で"],["、"],["正月","しょうがつ"],["の"],["軍団","ぐんだん"],["の"],["すべて"],["の"],["将","しょう"],["たち"],["の"],["かしら"],["で"],["あった"],["。"]]},{"verse":4,"text":"二月,がつの組,くみはアホアびとドダイがこれを率,ひきいた。その組,くみには二万四千人,にんあった。","tok":[["二","に"],["月","がつ"],["の"],["組","くみ"],["は"],["アホア"],["びと"],["ドダイ"],["が"],["これ"],["を"],["率いた","ひきいた"],["。"],["その"],["組","くみ"],["に"],["は"],["二万四千","にまんよんせん"],["人","にん"],["あった"],["。"]]},{"verse":5,"text":"三月,がつの第,だい三の将,しょうは祭司,さいしエホヤダの子,こベナヤが長,ちょうであって、その組,くみには二万四千人,にんあった。","tok":[["三","さん"],["月","がつ"],["の"],["第","だい"],["三","さん"],["の"],["将","しょう"],["は"],["祭司","さいし"],["エホヤダ"],["の"],["子","こ"],["ベナヤ"],["が"],["長","ちょう"],["で"],["あって"],["、"],["その"],["組","くみ"],["に"],["は"],["二万四千","にまんよんせん"],["人","にん"],["あった"],["。"]]},{"verse":6,"text":"このベナヤはかの三十人,にんのうちの勇士,ゆうしであって三十人,にんを率,ひきい、その子,こアミザバデがその組,くみにあった。","tok":[["この"],["ベナヤ"],["は"],["か"],["の"],["三","さん"],["十人","じゅうにん"],["の"],["うち"],["の"],["勇士","ゆうし"],["で"],["あって"],["三","さん"],["十人","じゅうにん"],["を"],["率い","ひきい"],["、"],["その"],["子","こ"],["アミザバデ"],["が"],["その"],["組","くみ"],["に"],["あった"],["。"]]},{"verse":7,"text":"四月,がつの第,だい四の将,しょうはヨアブの兄弟,きょうだいアサヘルであって、その子,こゼバデヤがこれに次,ついだ。その組,くみには二万四千人,にんあった。","tok":[["四","よん"],["月","がつ"],["の"],["第","だい"],["四","よん"],["の"],["将","しょう"],["は"],["ヨアブ"],["の"],["兄弟","きょうだい"],["アサヘル"],["で"],["あって"],["、"],["その"],["子","こ"],["ゼバデヤ"],["が"],["これ"],["に"],["次いだ","ついだ"],["。"],["その"],["組","くみ"],["に"],["は"],["二万四千","にまんよんせん"],["人","にん"],["あった"],["。"]]},{"verse":8,"text":"五月,がつの第,だい五の将,しょうはイズラヒびとシャンモテであって、その組,くみには二万四千人,にんあった。","tok":[["五","ご"],["月","がつ"],["の"],["第","だい"],["五","ご"],["の"],["将","しょう"],["は"],["イズラヒ"],["びと"],["シャンモテ"],["で"],["あって"],["、"],["その"],["組","くみ"],["に"],["は"],["二万四千","にまんよんせん"],["人","にん"],["あった"],["。"]]},{"verse":9,"text":"六月,がつの第,だい六の将,しょうはテコアびとイッケシの子,こイラであって、その組,くみには二万四千人,にんあった。","tok":[["六","ろく"],["月","がつ"],["の"],["第","だい"],["六","ろく"],["の"],["将","しょう"],["は"],["テコア"],["びと"],["イッケシ"],["の"],["子","こ"],["イラ"],["で"],["あって"],["、"],["その"],["組","くみ"],["に"],["は"],["二万四千","にまんよんせん"],["人","にん"],["あった"],["。"]]},{"verse":10,"text":"七月,がつの第,だい七の将,しょうはエフライムの子孫,しそんであるペロンびとヘレヅであって、その組,くみには二万四千人,にんあった。","tok":[["七","なな"],["月","がつ"],["の"],["第","だい"],["七","なな"],["の"],["将","しょう"],["は"],["エフライム"],["の"],["子孫","しそん"],["で"],["ある"],["ペロン"],["びと"],["ヘレヅ"],["で"],["あって"],["、"],["その"],["組","くみ"],["に"],["は"],["二万四千","にまんよんせん"],["人","にん"],["あった"],["。"]]},{"verse":11,"text":"八月,がつの第,だい八の将,しょうはゼラびとの子孫,しそんであるホシャびとシベカイであって、その組,くみには二万四千人,にんあった。","tok":[["八","はち"],["月","がつ"],["の"],["第","だい"],["八","はち"],["の"],["将","しょう"],["は"],["ゼラ"],["びと"],["の"],["子孫","しそん"],["で"],["ある"],["ホシャ"],["びと"],["シベカイ"],["で"],["あって"],["、"],["その"],["組","くみ"],["に"],["は"],["二万四千","にまんよんせん"],["人","にん"],["あった"],["。"]]},{"verse":12,"text":"九月,がつの第,だい九の将,しょうはベニヤミンの子孫,しそんであるアナトテびとアビエゼルであって、その組,くみには二万四千人,にんあった。","tok":[["九","きゅう"],["月","がつ"],["の"],["第","だい"],["九","きゅう"],["の"],["将","しょう"],["は"],["ベニヤミン"],["の"],["子孫","しそん"],["で"],["ある"],["アナトテ"],["びと"],["アビエゼル"],["で"],["あって"],["、"],["その"],["組","くみ"],["に"],["は"],["二万四千","にまんよんせん"],["人","にん"],["あった"],["。"]]},{"verse":13,"text":"十月,がつの第,だい十の将,しょうはゼラびとの子孫,しそんであるネトパびとマハライであって、その組,くみには二万四千人,にんあった。","tok":[["十","じゅう"],["月","がつ"],["の"],["第","だい"],["十","じゅう"],["の"],["将","しょう"],["は"],["ゼラ"],["びと"],["の"],["子孫","しそん"],["で"],["ある"],["ネトパ"],["びと"],["マハライ"],["で"],["あって"],["、"],["その"],["組","くみ"],["に"],["は"],["二万四千","にまんよんせん"],["人","にん"],["あった"],["。"]]},{"verse":14,"text":"十一月,がつの第,だい十一の将,しょうはエフライムの子孫,しそんであるピラトンびとベナヤであって、その組,くみには二万四千人,にんあった。","tok":[["十一","じゅういち"],["月","がつ"],["の"],["第","だい"],["十一","じゅういち"],["の"],["将","しょう"],["は"],["エフライム"],["の"],["子孫","しそん"],["で"],["ある"],["ピラトン"],["び"],["と"],["ベナヤ"],["で"],["あって"],["、"],["その"],["組","くみ"],["に"],["は"],["二万四千","にまんよんせん"],["人","にん"],["あった"],["。"]]},{"verse":15,"text":"十二月,がつの第,だい十二の将,しょうはオテニエルの子孫,しそんであるネトパびとヘルダイであって、その組,くみには二万四千人,にんあった。","tok":[["十二","じゅうに"],["月","がつ"],["の"],["第","だい"],["十二","じゅうに"],["の"],["将","しょう"],["は"],["オテニエル"],["の"],["子孫","しそん"],["で"],["ある"],["ネトパ"],["びと"],["ヘルダイ"],["で"],["あって"],["、"],["その"],["組","くみ"],["に"],["は"],["二万四千","にまんよんせん"],["人","にん"],["あった"],["。"]]},{"verse":16,"text":"なおイスラエルの部族,ぶぞくを治,おさめる者,ものたちは次,つぎのとおりである。ルベンびとのつかさはヂクリの子,こエリエゼル。シメオンびとのつかさはマアカの子,こシパテヤ。","tok":[["なお"],["イスラエル"],["の"],["部族","ぶぞく"],["を"],["治める","おさめる"],["者","もの"],["たち"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["ルベン"],["びと"],["の"],["つかさ"],["は"],["ヂクリ"],["の"],["子","こ"],["エリエゼル"],["。"],["シメオン"],["びと"],["の"],["つかさ"],["は"],["マアカ"],["の"],["子","こ"],["シパテヤ"],["。"]]},{"verse":17,"text":"レビびとのつかさはケムエルの子,こハシャビヤ。アロンびとのつかさはザドク。","tok":[["レビ"],["びと"],["の"],["つかさ"],["は"],["ケムエル"],["の"],["子","こ"],["ハシャビヤ"],["。"],["アロン"],["びと"],["の"],["つかさ"],["は"],["ザドク"],["。"]]},{"verse":18,"text":"ユダのつかさはダビデの兄弟,きょうだいのひとりエリウ。イッサカルのつかさはミカエルの子,こオムリ。","tok":[["ユダ"],["の"],["つかさ"],["は"],["ダビデ"],["の"],["兄弟","きょうだい"],["の"],["ひとり"],["エリウ"],["。"],["イッサカル"],["の"],["つかさ"],["は"],["ミカエル"],["の"],["子","こ"],["オムリ"],["。"]]},{"verse":19,"text":"ゼブルンのつかさはオバデヤの子,こイシマヤ。ナフタリのつかさはアズリエルの子,こエレモテ。","tok":[["ゼブルン"],["の"],["つかさ"],["は"],["オバデヤ"],["の"],["子","こ"],["イシマヤ"],["。"],["ナフタリ"],["の"],["つかさ"],["は"],["アズリエル"],["の"],["子","こ"],["エレモテ"],["。"]]},{"verse":20,"text":"エフライムの子孫,しそんのつかさはアザジヤの子,こホセア。マナセの半,はん部族,ぶぞくのつかさはペダヤの子,こヨエル。","tok":[["エフライム"],["の"],["子孫","しそん"],["の"],["つかさ"],["は"],["アザジヤ"],["の"],["子","こ"],["ホセア"],["。"],["マナセ"],["の"],["半","はん"],["部族","ぶぞく"],["の"],["つかさ"],["は"],["ペダヤ"],["の"],["子","こ"],["ヨエル"],["。"]]},{"verse":21,"text":"ギレアデにあるマナセの半,はん部族,ぶぞくのつかさはゼカリヤの子,こイド。ベニヤミンのつかさはアブネルの子,こヤシエル。","tok":[["ギレアデ"],["に"],["ある"],["マナセ"],["の"],["半","はん"],["部族","ぶぞく"],["の"],["つかさ"],["は"],["ゼカリヤ"],["の"],["子","こ"],["イド"],["。"],["ベニヤミン"],["の"],["つかさ"],["は"],["アブネル"],["の"],["子","こ"],["ヤシエル"],["。"]]},{"verse":22,"text":"ダンのつかさはエロハムの子,こアザリエル。これらはイスラエルの部族,ぶぞくのつかさたちであった。","tok":[["ダン"],["の"],["つかさ"],["は"],["エロハム"],["の"],["子","こ"],["アザリエル"],["。"],["これ"],["ら"],["は"],["イスラエル"],["の"],["部族","ぶぞく"],["の"],["つかさ"],["たち"],["で"],["あった"],["。"]]},{"verse":23,"text":"しかしダビデは二十歳,さい以下,いかの者,ものは数,かぞえなかった。主,しゅがかつてイスラエルを天,てんの星,ほしのように多,おおくすると言,いわれたからである。","tok":[["しかし"],["ダビデ"],["は"],["二十歳","さ"],["い"],["以下","いか"],["の"],["者","もの"],["は"],["数えなかった","かぞえなかった"],["。"],["主","しゅ"],["が"],["かつて"],["イスラエル"],["を"],["天","てん"],["の"],["星","ほし"],["の"],["よう"],["に"],["多く","おおく"],["する"],["と"],["言われた","いわれた"],["から"],["で"],["ある"],["。"]]},{"verse":24,"text":"ゼルヤの子,こヨアブは数,かぞえ始,はじめたが、これをなし終,おえなかった。その数,かぞえることによって怒,いかりがイスラエルの上,うえに臨,のぞんだ。またその数,かずはダビデ王,おうの歴代志,れきだいしに載,のせなかった。","tok":[["ゼルヤ"],["の"],["子","こ"],["ヨアブ"],["は"],["数え","かぞえ"],["始めた","はじめた"],["が"],["、"],["これ"],["を"],["なし"],["終えなかった","おえなかった"],["。"],["その"],["数える","かぞえる"],["こと"],["によって"],["怒り","いかり"],["が"],["イスラエル"],["の"],["上","うえ"],["に"],["臨んだ","のぞんだ"],["。"],["また"],["その"],["数","かず"],["は"],["ダビデ"],["王","おう"],["の"],["歴代志","れきだいし"],["に"],["載せなかった","のせなかった"],["。"]]},{"verse":25,"text":"アデエルの子,こアズマウテは王,おうの倉,くらをつかさどり、ウジヤの子,こヨナタンは田野,でんや、町々,まちまち、村々,むらむら、もろもろの塔,とうにある倉,くらをつかさどり、","tok":[["アデエル"],["の"],["子","こ"],["アズマウテ"],["は"],["王","おう"],["の"],["倉","くら"],["を"],["つかさどり"],["、"],["ウジヤ"],["の"],["子","こ"],["ヨナタン"],["は"],["田野","でんや"],["、"],["町々","まちまち"],["、"],["村々","むらむら"],["、"],["もろもろ"],["の"],["塔","とう"],["に"],["ある"],["倉","くら"],["を"],["つかさどり"],["、"]]},{"verse":26,"text":"ケルブの子,こエズリは地,ちを耕,たがやす農夫,のうふをつかさどり、","tok":[["ケルブ"],["の"],["子","こ"],["エズリ"],["は"],["地","ち"],["を"],["耕やす","たがやす"],["農夫","のうふ"],["を"],["つかさどり"],["、"]]},{"verse":27,"text":"ラマテびとシメイはぶどう畑,はたけをつかさどり、シプミびとザブデはぶどう畑,はたけから取,とったぶどう酒,しゅの倉,くらをつかさどり、","tok":[["ラマテ"],["びと"],["シメイ"],["は"],["ぶどう"],["畑","はたけ"],["を"],["つかさどり"],["、"],["シプミ"],["びと"],["ザブデ"],["は"],["ぶどう"],["畑","はたけ"],["から"],["取った","とった"],["ぶどう酒","ぶどうしゅ"],["の"],["倉","くら"],["を"],["つかさどり"],["、"]]},{"verse":28,"text":"ゲデルびとバアル・ハナンは平野,へいやのオリブの木,きといちじく桑,くわの木,きをつかさどり、ヨアシは油,あぶらの倉,くらをつかさどり、","tok":[["ゲデル"],["び"],["と"],["バアル"],["・"],["ハナン"],["は"],["平野","へいや"],["の"],["オリブ"],["の"],["木","き"],["と"],["いちじく"],["桑","くわ"],["の"],["木","き"],["を"],["つかさどり"],["、"],["ヨアシ"],["は"],["油","あぶら"],["の"],["倉","くら"],["を"],["つかさどり"],["、"]]},{"verse":29,"text":"シャロンびとシテライはシャロンで飼,かう牛,うしの群,むれをつかさどり、アデライの子,こシャパテはもろもろの谷,たににおる牛,うしの群,むれをつかさどり、","tok":[["シャロン"],["びと"],["シテライ"],["は"],["シャロン"],["で"],["飼う","かう"],["牛","うし"],["の"],["群れ","むれ"],["を"],["つかさどり"],["、"],["アデライ"],["の"],["子","こ"],["シャパテ"],["は"],["もろもろ"],["の"],["谷","たに"],["に"],["おる"],["牛","うし"],["の"],["群れ","むれ"],["を"],["つかさどり"],["、"]]},{"verse":30,"text":"イシマエルびとオビルはらくだをつかさどり、メロノテびとエデヤはろばをつかさどり、","tok":[["イシマエル"],["び"],["と"],["オビル"],["は"],["らくだ"],["を"],["つかさどり"],["、"],["メロノテ"],["びと"],["エデヤ"],["は"],["ろば"],["を"],["つかさどり"],["、"]]},{"verse":31,"text":"ハガルびとヤジズは羊,ひつじの群,むれをつかさどった。彼,かれらは皆,みなダビデ王,おうの財産,ざいさんのつかさであった。","tok":[["ハガル"],["びと"],["ヤジズ"],["は"],["羊","ひつじ"],["の"],["群れ","むれ"],["を"],["つかさどった"],["。"],["彼","かれ"],["ら"],["は"],["皆","みな"],["ダビデ"],["王","おう"],["の"],["財産","ざいさん"],["の"],["つかさ"],["で"],["あった"],["。"]]},{"verse":32,"text":"またダビデのおじヨナタンは議,ぎ官,かんで、知恵,ちえある人,ひとであり、学者,がくしゃであった。また彼,かれとハクモニの子,こエヒエルは王,おうの子,こたちの補佐,ほさであった。","tok":[["また"],["ダビデ"],["の"],["おじ"],["ヨナタン"],["は"],["議官","ぎかん"],["で"],["、"],["知恵","ちえ"],["ある"],["人","ひと"],["で"],["あり"],["、"],["学者","がくしゃ"],["で"],["あった"],["。"],["また"],["彼","かれ"],["と"],["ハクモニ"],["の"],["子","こ"],["エヒエル"],["は"],["王","おう"],["の"],["子","こ"],["たち"],["の"],["補佐","ほさ"],["で"],["あった"],["。"]]},{"verse":33,"text":"アヒトペルは王,おうの議,ぎ官,かん。アルキびとホシャイは王,おうの友,ともであった。","tok":[["アヒトペル"],["は"],["王","おう"],["の"],["議官","ぎかん"],["。"],["アルキ"],["びと"],["ホシャイ"],["は"],["王","おう"],["の"],["友","とも"],["で"],["あった"],["。"]]},{"verse":34,"text":"アヒトペルに次,つぐ者,ものはベナヤの子,こエホヤダおよびアビヤタル。王,おうの軍,ぐんの長,ちょうはヨアブであった。","tok":[["アヒトペル"],["に"],["次ぐ","つぐ"],["者","もの"],["は"],["ベナヤ"],["の"],["子","こ"],["エホヤダ"],["および"],["アビヤタル"],["。"],["王","おう"],["の"],["軍","ぐん"],["の"],["長","ちょう"],["は"],["ヨアブ"],["で"],["あった"],["。"]]}]
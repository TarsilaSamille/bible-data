[{"verse":1,"text":"イスラエルの長子,ちょうしルベンの子,こらは次,つぎのとおりである。――ルベンは長子,ちょうしであったが父,ちちの床,とこを汚,けがしたので、長子,ちょうしの権,けんはイスラエルの子,こヨセフの子,こらに与,あたえられた。それで長子,ちょうしの権,けんによる系図,けいずにしるされていない。","tok":[["イスラエル"],["の"],["長子","ちょうし"],["ルベン"],["の"],["子","こ"],["ら"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["―"],["―"],["ルベン"],["は"],["長子","ちょうし"],["で"],["あった"],["が"],["父","ちち"],["の"],["床","とこ"],["を"],["汚","け"],["がした"],["ので"],["、"],["長子","ちょうし"],["の"],["権","けん"],["は"],["イスラエル"],["の"],["子","こ"],["ヨセフ"],["の"],["子","こ"],["ら"],["に"],["与えられた","あたえられた"],["。"],["それ"],["で"],["長子","ちょうし"],["の"],["権","けん"],["に"],["よる"],["系図","けいず"],["に"],["しるされて"],["いない"],["。"]]},{"verse":2,"text":"またユダは兄弟,きょうだいたちにまさる者,ものとなり、その中,なかから君,くんたる者,ものがでたが長子,ちょうしの権,けんはヨセフのものとなったのである。――","tok":[["また"],["ユダ"],["は"],["兄弟","きょうだい"],["たち"],["に"],["まさる"],["者","もの"],["と"],["なり"],["、"],["その"],["中","なか"],["から"],["君","くん"],["たる"],["者","もの"],["が"],["でた"],["が"],["長子","ちょうし"],["の"],["権","けん"],["は"],["ヨセフ"],["の"],["もの"],["と"],["なった"],["ので"],["ある"],["。"],["―"],["―"]]},{"verse":3,"text":"すなわちイスラエルの長子,ちょうしルベンの子,こらはハノク、パル、ヘヅロン、カルミ。","tok":[["すなわち"],["イスラエル"],["の"],["長子","ちょうし"],["ルベン"],["の"],["子","こ"],["ら"],["は"],["ハノク"],["、"],["パル"],["、"],["ヘヅロン"],["、"],["カルミ"],["。"]]},{"verse":4,"text":"ヨエルの子,こらはその子,こはシマヤ、その子,こはゴグ、その子,こはシメイ、","tok":[["ヨエル"],["の"],["子","こ"],["ら"],["は"],["その"],["子","こ"],["は"],["シマヤ"],["、"],["その"],["子","こ"],["は"],["ゴグ"],["、"],["その"],["子","こ"],["は"],["シメイ"],["、"]]},{"verse":5,"text":"その子,こはミカ、その子,こはレアヤ、その子,こはバアル、","tok":[["その"],["子","こ"],["は"],["ミカ"],["、"],["その"],["子","こ"],["は"],["レアヤ"],["、"],["その"],["子","こ"],["は"],["バアル"],["、"]]},{"verse":6,"text":"その子,こはベエラである。このベエラはアッスリヤの王,おうテルガテ・ピルネセルが捕,とらえ移,うつした者,ものである。彼,かれはルベンびとのつかさであった。","tok":[["その"],["子","こ"],["は"],["ベエラ"],["で"],["ある"],["。"],["この"],["ベエラ"],["は"],["アッスリヤ"],["の"],["王","おう"],["テルガテ"],["・"],["ピルネセル"],["が"],["捕らえ","とらえ"],["移した","うつした"],["者","もの"],["で"],["ある"],["。"],["彼","かれ"],["は"],["ルベン"],["びと"],["の"],["つかさ"],["で"],["あった"],["。"]]},{"verse":7,"text":"彼,かれの兄弟,きょうだいたちは、その氏族,しぞくにより、その歴代,れきだいの系図,けいずによれば、かしらエイエルおよびゼカリヤ、","tok":[["彼","かれ"],["の"],["兄弟","きょうだい"],["たち"],["は"],["、"],["その"],["氏族","しぞく"],["に"],["より"],["、"],["その"],["歴代","れきだい"],["の"],["系図","けいず"],["に"],["よれば"],["、"],["かしら"],["エイエル"],["および"],["ゼカリヤ"],["、"]]},{"verse":8,"text":"ベラなどである。ベラはアザズの子,こ、シマの孫,まご、ヨエルのひこである。彼,かれはアロエルに住,すみ、ネボおよびバアル・メオンまで及,およんでいたが、","tok":[["ベラ"],["など"],["で"],["ある"],["。"],["ベラ"],["は"],["アザズ"],["の"],["子","こ"],["、"],["シマ"],["の"],["孫","まご"],["、"],["ヨエル"],["の"],["ひこ"],["で"],["ある"],["。"],["彼","かれ"],["は"],["アロエル"],["に"],["住み","すみ"],["、"],["ネボ"],["および"],["バアル"],["・"],["メオン"],["まで"],["及んで","およんで"],["いた"],["が"],["、"]]},{"verse":9,"text":"ギレアデの地,ちで彼,かれの家畜,かちくがふえ増,ましたので、彼,かれは東,ひがしの方,ほうユフラテ川,かわのこなたの荒野,あらのの入口,いりぐちにまで住,すんだ。","tok":[["ギレアデ"],["の"],["地","ち"],["で"],["彼","かれ"],["の"],["家畜","かちく"],["が"],["ふえ"],["増した","ました"],["ので"],["、"],["彼","かれ"],["は"],["東","ひがし"],["の"],["方","ほう"],["ユフラテ"],["川","かわ"],["の"],["こなた"],["の"],["荒野","あらの"],["の"],["入口","いりぐち"],["に"],["まで"],["住んだ","すんだ"],["。"]]},{"verse":10,"text":"またサウルの時,とき、彼,かれらはハガルびとと戦,たたかって、これを撃,うち倒,たおし、ギレアデの東,ひがしの全部,ぜんぶにわたって彼,かれらの天幕,てんまくに住,すんだ。","tok":[["また"],["サウル"],["の"],["時","とき"],["、"],["彼","かれ"],["ら"],["は"],["ハガル"],["びと"],["と"],["戦って","たたかって"],["、"],["これ"],["を"],["撃ち倒し","うちたおし"],["、"],["ギレアデ"],["の"],["東","ひがし"],["の"],["全部","ぜんぶ"],["に"],["わたって"],["彼","かれ"],["ら"],["の"],["天幕","てんまく"],["に"],["住んだ","すんだ"],["。"]]},{"verse":11,"text":"ガドの子孫,しそんはこれと相対,あいたいしてバシャンの地,ちに住,すみ、サルカまで及,およんでいた。","tok":[["ガド"],["の"],["子孫","しそん"],["は"],["これ"],["と"],["相対","あ"],["い"],["たいして"],["バシャン"],["の"],["地","ち"],["に"],["住み","すみ"],["、"],["サルカ"],["まで"],["及んで","およんで"],["いた"],["。"]]},{"verse":12,"text":"そのかしらはヨエル、次,つぎはシャパム、ヤアナイ、シャパテで、ともにバシャンに住,すんだ。","tok":[["その"],["かしら"],["は"],["ヨエル"],["、"],["次","つぎ"],["は"],["シャパム"],["、"],["ヤアナイ"],["、"],["シャパテ"],["で"],["、"],["とも"],["に"],["バシャン"],["に"],["住んだ","すんだ"],["。"]]},{"verse":13,"text":"彼,かれらの兄弟,きょうだいたちは、その氏族,しぞくによればミカエル、メシュラム、シバ、ヨライ、ヤカン、ジア、エベルの七人,にんである。","tok":[["彼","かれ"],["ら"],["の"],["兄弟","きょうだい"],["たち"],["は"],["、"],["その"],["氏族","しぞく"],["に"],["よれば"],["ミカエル"],["、"],["メシュラム"],["、"],["シバ"],["、"],["ヨライ"],["、"],["ヤカン"],["、"],["ジア"],["、"],["エベル"],["の"],["七人","にん"],["で"],["ある"],["。"]]},{"verse":14,"text":"これらはホリの子,こアビハイルの子,こらである。ホリはヤロアの子,こ、ヤロアはギレアデの子,こ、ギレアデはミカエルの子,こ、ミカエルはエシサイの子,こ、エシサイはヤドの子,こ、ヤドはブズの子,こである。","tok":[["これ"],["ら"],["は"],["ホリ"],["の"],["子","こ"],["アビハイル"],["の"],["子","こ"],["ら"],["で"],["ある"],["。"],["ホリ"],["は"],["ヤロア"],["の"],["子","こ"],["、"],["ヤロア"],["は"],["ギレアデ"],["の"],["子","こ"],["、"],["ギレアデ"],["は"],["ミカエル"],["の"],["子","こ"],["、"],["ミカエル"],["は"],["エシサイ"],["の"],["子","こ"],["、"],["エシサイ"],["は"],["ヤド"],["の"],["子","こ"],["、"],["ヤド"],["は"],["ブズ"],["の"],["子","こ"],["で"],["ある"],["。"]]},{"verse":15,"text":"アヒはアブデルの子,こ、アブデルはグニの子,こ、グニはその氏族,しぞくの長,ちょうである。","tok":[["アヒ"],["は"],["アブデル"],["の"],["子","こ"],["、"],["アブデル"],["は"],["グニ"],["の"],["子","こ"],["、"],["グニ"],["は"],["その"],["氏族","しぞく"],["の"],["長","ちょう"],["で"],["ある"],["。"]]},{"verse":16,"text":"彼,かれらはギレアデとバシャンとその村里,むらざととシャロンのすべての放牧,ほうぼく地,ちに住,すんで、その四方,しほうの境,さかいにまで及,およんでいた。","tok":[["彼","かれ"],["ら"],["は"],["ギレアデ"],["と"],["バシャン"],["と"],["その"],["村里","むらざと"],["と"],["シャロン"],["の"],["すべて"],["の"],["放牧","ほうぼく"],["地","ち"],["に"],["住んで","すんで"],["、"],["その"],["四方","しほう"],["の"],["境","さかい"],["に"],["まで"],["及んで","およんで"],["いた"],["。"]]},{"verse":17,"text":"これらはみなユダの王,おうヨタムの世,よとイスラエルの王,おうヤラベアムの世,よに系図,けいずにのせられた。","tok":[["これ"],["ら"],["は"],["みな"],["ユダ"],["の"],["王","おう"],["ヨタム"],["の"],["世","よ"],["と"],["イスラエル"],["の"],["王","おう"],["ヤラベアム"],["の"],["世","よ"],["に"],["系図","けいず"],["に"],["のせられた"],["。"]]},{"verse":18,"text":"ルベンびとと、ガドびとと、マナセの半,はん部族,ぶぞくには出,でて戦,たたかいうる者,もの四万四千七百六十人,にんあり、皆,みな勇士,ゆうしで、盾,たてとつるぎをとり、弓,ゆみをひき、戦,たたかいに巧,たくみな人々,ひとびとであった。","tok":[["ルベン"],["びと"],["と"],["、"],["ガド"],["びと"],["と"],["、"],["マナセ"],["の"],["半","はん"],["部族","ぶぞく"],["に"],["は"],["出て","でて"],["戦い","たたかい"],["うる"],["者","もの"],["四万四千七百六","よんまんよんせんななひゃくろく"],["十人","じゅうにん"],["あり"],["、"],["皆","みな"],["勇士","ゆうし"],["で"],["、"],["盾","たて"],["と"],["つるぎ"],["を"],["とり"],["、"],["弓","ゆみ"],["を"],["ひき"],["、"],["戦い","たたかい"],["に"],["巧み","たくみ"],["な"],["人々","ひとびと"],["で"],["あった"],["。"]]},{"verse":19,"text":"彼,かれらはハガルびとおよびエトル、ネフシ、ノダブなどと戦,たたかったが、","tok":[["彼","かれ"],["ら"],["は"],["ハガル"],["び"],["と"],["および"],["エトル"],["、"],["ネフシ"],["、"],["ノダブ"],["など"],["と"],["戦った","たたかった"],["が"],["、"]]},{"verse":20,"text":"助,たすけを得,えてこれを攻,せめたので、ハガルびとおよびこれとともにいた者,ものは皆,みな、彼,かれらの手,てにわたされた。これは彼,かれらが戦,たたかいにあたって神,かみに呼,よばわり、神,かみに寄,より頼,たよんだので神,かみはその願,ねがいを聞,きかれたからである。","tok":[["助け","たすけ"],["を"],["得て","えて"],["これ"],["を"],["攻めた","せめた"],["ので"],["、"],["ハガル"],["び"],["と"],["および"],["これ"],["と"],["とも"],["に"],["いた"],["者","もの"],["は"],["皆","みな"],["、"],["彼","かれ"],["ら"],["の"],["手","て"],["に"],["わたされた"],["。"],["これ"],["は"],["彼","かれ"],["ら"],["が"],["戦い","たたかい"],["に"],["あたって"],["神","かみ"],["に"],["呼ばわり","よばわり"],["、"],["神","かみ"],["に"],["寄り","より"],["頼","たよんだ"],["ので"],["神","かみ"],["は"],["その"],["願い","ねがい"],["を"],["聞かれた","きかれた"],["から"],["で"],["ある"],["。"]]},{"verse":21,"text":"彼,かれらはその家畜,かちくを奪,うばい取,とったが、らくだ五万、羊,ひつじ二十五万、ろば二千あり、また人,ひとは十,じゅう万,まん人,にんあった。","tok":[["彼","かれ"],["ら"],["は"],["その"],["家畜","かちく"],["を"],["奪い取った","うばいとった"],["が"],["、"],["らくだ"],["五万","ごまん"],["、"],["羊","ひつじ"],["二十五万","にじゅうごまん"],["、"],["ろば"],["二千","にせん"],["あり"],["、"],["また"],["人","ひと"],["は"],["十万人","じゅうまんにん"],["あった"],["。"]]},{"verse":22,"text":"これはその戦,たたかいが神,かみによったので、多,おおくの者,ものが殺,ころされて倒,たおれたからである。そして彼,かれらは捕,とらえ移,うつされる時,ときまで、これに代,かわってその所,ところに住,すんだ。","tok":[["これ"],["は"],["その"],["戦い","たたかい"],["が"],["神","かみ"],["に"],["よった"],["ので"],["、"],["多く","おおく"],["の"],["者","もの"],["が"],["殺ろされて","ころされて"],["倒れた","たおれた"],["から"],["で"],["ある"],["。"],["そして"],["彼","かれ"],["ら"],["は"],["捕らえ","とらえ"],["移される","うつされる"],["時","とき"],["まで"],["、"],["これ"],["に"],["代わって","かわって"],["その"],["所","ところ"],["に"],["住んだ","すんだ"],["。"]]},{"verse":23,"text":"マナセの半,はん部族,ぶぞくの人々,ひとびとはこの地,ちに住,すみ、ふえ広,ひろがって、ついにバシャンからバアル・ヘルモン、セニルおよびヘルモン山,やまにまで及,およんだ。","tok":[["マナセ"],["の"],["半","はん"],["部族","ぶぞく"],["の"],["人々","ひとびと"],["は"],["この"],["地","ち"],["に"],["住み","すみ"],["、"],["ふえ"],["広がって","ひろがって"],["、"],["ついに"],["バシャン"],["から"],["バアル"],["・"],["ヘルモン"],["、"],["セニル"],["および"],["ヘルモン"],["山","やま"],["に"],["まで"],["及んだ","およんだ"],["。"]]},{"verse":24,"text":"その氏族,しぞくの長,ちょうたちは次,つぎのとおりである。すなわち、エペル、イシ、エリエル、アズリエル、エレミヤ、ホダヤ、ヤデエル。これらは皆,みなその氏族,しぞくの長,ちょうで名高,なだかい大,だい勇士,ゆうしであった。","tok":[["その"],["氏族","しぞく"],["の"],["長","ちょう"],["たち"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["すなわち"],["、"],["エペル"],["、"],["イシ"],["、"],["エリエル"],["、"],["アズリエル"],["、"],["エレミヤ"],["、"],["ホダヤ"],["、"],["ヤデエル"],["。"],["これ"],["ら"],["は"],["皆","みな"],["その"],["氏族","しぞく"],["の"],["長","ちょう"],["で"],["名高い","なだかい"],["大","だい"],["勇士","ゆうし"],["で"],["あった"],["。"]]},{"verse":25,"text":"彼,かれらは先祖,せんぞたちの神,かみにむかって罪,つみを犯,おかし、神,かみが、かつて彼,かれらの前,まえから滅,ほろぼされた国,くにの民,たみの神々,かみがみを慕,したって、これと姦淫,かんいんしたので、","tok":[["彼","かれ"],["ら"],["は"],["先祖","せんぞ"],["たち"],["の"],["神","かみ"],["に"],["むかって"],["罪","つみ"],["を"],["犯し","おかし"],["、"],["神","かみ"],["が"],["、"],["かつて"],["彼","かれ"],["ら"],["の"],["前","まえ"],["から"],["滅ぼされた","ほろぼされた"],["国","くに"],["の"],["民","たみ"],["の"],["神々","かみがみ"],["を"],["慕って","したって"],["、"],["これ"],["と"],["姦淫","かんいん"],["した"],["ので"],["、"]]},{"verse":26,"text":"イスラエルの神,かみは、アッスリヤの王,おうプルの心,こころを奮,ふるい起,おこし、またアッスリヤの王,おうテルガテ・ピルネセルの心,こころを奮,ふるい起,おこされたので、彼,かれはついにルベンびとと、ガドびとと、マナセの半,はん部族,ぶぞくを捕,とらえて行,いき、ハウラとハボルとハラとゴザン川,かわのほとりに移,うつして今日,こんにちに至,いたっている。","tok":[["イスラエル"],["の"],["神","かみ"],["は"],["、"],["アッスリヤ"],["の"],["王","おう"],["プル"],["の"],["心","こころ"],["を"],["奮い起こし","ふるいおこし"],["、"],["また"],["アッスリヤ"],["の"],["王","おう"],["テルガテ"],["・"],["ピルネセル"],["の"],["心","こころ"],["を"],["奮い起こされた","ふるいおこされた"],["ので"],["、"],["彼","かれ"],["は"],["ついに"],["ルベン"],["びと"],["と"],["、"],["ガド"],["びと"],["と"],["、"],["マナセ"],["の"],["半","はん"],["部族","ぶぞく"],["を"],["捕らえて","とらえて"],["行き","いき"],["、"],["ハウラ"],["と"],["ハボル"],["と"],["ハラ"],["と"],["ゴザン"],["川","かわ"],["の"],["ほとり"],["に"],["移して","うつして"],["今日","こんにち"],["に"],["至って","いたって"],["いる"],["。"]]},{"verse":27,"text":"[6:1]レビの子,こらはゲルション、コハテ、メラリ。","tok":[["["],["6"],[":"],["1"],["]"],["レビ"],["の"],["子","こ"],["ら"],["は"],["ゲルション"],["、"],["コハテ"],["、"],["メラリ"],["。"]]},{"verse":28,"text":"[6:2]コハテの子,こらはアムラム、イヅハル、ヘブロン、ウジエル。","tok":[["["],["6"],[":"],["2"],["]"],["コハテ"],["の"],["子","こ"],["ら"],["は"],["アムラム"],["、"],["イヅハル"],["、"],["ヘブロン"],["、"],["ウジエル"],["。"]]},{"verse":29,"text":"[6:3]アムラムの子,こらはアロン、モーセ、ミリアム。アロンの子,こらはナダブ、アビウ、エレアザル、イタマル。","tok":[["["],["6"],[":"],["3"],["]"],["アムラム"],["の"],["子","こ"],["ら"],["は"],["アロン"],["、"],["モーセ"],["、"],["ミリアム"],["。"],["アロン"],["の"],["子","こ"],["ら"],["は"],["ナダブ"],["、"],["アビウ"],["、"],["エレアザル"],["、"],["イタマル"],["。"]]},{"verse":30,"text":"[6:4]エレアザルはピネハスを生,うみ、ピネハスはアビシュアを生,うみ、","tok":[["["],["6"],[":"],["4"],["]"],["エレアザル"],["は"],["ピネハス"],["を"],["生み","うみ"],["、"],["ピネハス"],["は"],["アビシュア"],["を"],["生み","うみ"],["、"]]},{"verse":31,"text":"[6:5]アビシュアはブッキを生,うみ、ブッキはウジを生,うみ、","tok":[["["],["6"],[":"],["5"],["]"],["アビシュア"],["は"],["ブッキ"],["を"],["生み","うみ"],["、"],["ブッキ"],["は"],["ウジ"],["を"],["生み","うみ"],["、"]]},{"verse":32,"text":"[6:6]ウジはゼラヒヤを生,うみ、ゼラヒヤはメラヨテを生,うみ、","tok":[["["],["6"],[":"],["6"],["]"],["ウジ"],["は"],["ゼラヒヤ"],["を"],["生み","うみ"],["、"],["ゼラヒヤ"],["は"],["メラヨテ"],["を"],["生み","うみ"],["、"]]},{"verse":33,"text":"[6:7]メラヨテはアマリヤを生,うみ、アマリヤはアヒトブを生,うみ、","tok":[["["],["6"],[":"],["7"],["]"],["メラヨテ"],["は"],["アマリヤ"],["を"],["生み","うみ"],["、"],["アマリヤ"],["は"],["アヒトブ"],["を"],["生み","うみ"],["、"]]},{"verse":34,"text":"[6:8]アヒトブはザドクを生,うみ、ザドクはアヒマアズを生,うみ、","tok":[["["],["6"],[":"],["8"],["]"],["アヒトブ"],["は"],["ザドク"],["を"],["生み","うみ"],["、"],["ザドク"],["は"],["アヒマアズ"],["を"],["生み","うみ"],["、"]]},{"verse":35,"text":"[6:9]アヒマアズはアザリヤを生,うみ、アザリヤはヨナハンを生,うみ、","tok":[["["],["6"],[":"],["9"],["]"],["アヒマアズ"],["は"],["アザリヤ"],["を"],["生み","うみ"],["、"],["アザリヤ"],["は"],["ヨナハン"],["を"],["生み","うみ"],["、"]]},{"verse":36,"text":"[6:10]ヨナハンはアザリヤを生,うんだ。このアザリヤはソロモンがエルサレムに建,たてた宮,みやで祭司,さいしの務,つとめをした者,ものである。","tok":[["["],["6"],[":"],["10"],["]"],["ヨナハン"],["は"],["アザリヤ"],["を"],["生んだ","うんだ"],["。"],["この"],["アザリヤ"],["は"],["ソロモン"],["が"],["エルサレム"],["に"],["建てた","たてた"],["宮","みや"],["で"],["祭司","さいし"],["の"],["務め","つとめ"],["を"],["した"],["者","もの"],["で"],["ある"],["。"]]},{"verse":37,"text":"[6:11]アザリヤはアマリヤを生,うみ、アマリヤはアヒトブを生,うみ、","tok":[["["],["6"],[":"],["11"],["]"],["アザリヤ"],["は"],["アマリヤ"],["を"],["生み","うみ"],["、"],["アマリヤ"],["は"],["アヒトブ"],["を"],["生み","うみ"],["、"]]},{"verse":38,"text":"[6:12]アヒトブはザトクを生,うみ、ザトクはシャルムを生,うみ、","tok":[["["],["6"],[":"],["12"],["]"],["アヒトブ"],["は"],["ザトク"],["を"],["生み","うみ"],["、"],["ザトク"],["は"],["シャルム"],["を"],["生み","うみ"],["、"]]},{"verse":39,"text":"[6:13]シャルムはヒルキヤを生,うみ、ヒルキヤはアザリヤを生,うみ、","tok":[["["],["6"],[":"],["13"],["]"],["シャルム"],["は"],["ヒルキヤ"],["を"],["生み","うみ"],["、"],["ヒルキヤ"],["は"],["アザリヤ"],["を"],["生み","うみ"],["、"]]},{"verse":40,"text":"[6:14]アザリヤはセラヤを生,うみ、セラヤはヨザダクを生,うんだ。","tok":[["["],["6"],[":"],["14"],["]"],["アザリヤ"],["は"],["セラヤ"],["を"],["生み","うみ"],["、"],["セラヤ"],["は"],["ヨザダク"],["を"],["生んだ","うんだ"],["。"]]},{"verse":41,"text":"[6:15]ヨザダクは主,しゅがネブカデネザルの手,てによってユダとエルサレムの人,ひとを捕,とらえ移,うつされた時,ときに捕,とらえられて行,いった。","tok":[["["],["6"],[":"],["15"],["]"],["ヨザダク"],["は"],["主","しゅ"],["が"],["ネブカデネザル"],["の"],["手","て"],["によって"],["ユダ"],["と"],["エルサレム"],["の"],["人","ひと"],["を"],["捕らえ","とらえ"],["移された","うつされた"],["時","とき"],["に"],["捕らえられて","とらえられて"],["行った","いった"],["。"]]}]
[{"verse":1,"text":"ダビデ王,おうはまた全,ぜん会衆,かいしゅうに言,いった、「わが子,こソロモンは神,かみがただひとりを選,えらばれた者,ものであるが、まだ若,わかくて経験,けいけんがなく、この事業,じぎょうは大,おおきい。この宮,みやは人,ひとのためではなく、主,しゅなる神,かみのためだからである。","tok":[["ダビデ"],["王","おう"],["は"],["また"],["全","ぜん"],["会衆","かいしゅう"],["に"],["言った","いった"],["、"],["「"],["わが"],["子","こ"],["ソロモン"],["は"],["神","かみ"],["が"],["ただ"],["ひとり"],["を"],["選ら","えら"],["ばれた"],["者","もの"],["で"],["ある"],["が"],["、"],["まだ"],["若くて","わかくて"],["経験","けいけん"],["が"],["なく"],["、"],["この"],["事業","じぎょう"],["は"],["大きい","おおきい"],["。"],["この"],["宮","みや"],["は"],["人","ひと"],["の"],["ため"],["で"],["は"],["なく"],["、"],["主","しゅ"],["なる"],["神","かみ"],["の"],["ため"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":2,"text":"そこでわたしは力,ちからをつくして神,かみの宮,みやのために備,そなえた。すなわち金,きんの物,ものを造,つくるために金,きん、銀,ぎんの物,もののために銀,ぎん、青銅,せいどうの物,もののために青銅,せいどう、鉄,てつの物,もののために鉄,てつ、木,きの物,もののために木,きを備,そなえた。その他,た縞,しまめのう、はめ石,いし、アンチモニイ、色,いろのついた石,いし、さまざまの宝石,ほうせき、大理石,だいりせきなどおびただしい。","tok":[["そこ"],["で"],["わたし"],["は"],["力","ちから"],["を"],["つくして"],["神","かみ"],["の"],["宮","みや"],["の"],["ため"],["に"],["備","そなえ"],["た"],["。"],["すなわち"],["金","きん"],["の"],["物","もの"],["を"],["造る","つくる"],["ため"],["に"],["金","きん"],["、"],["銀","ぎん"],["の"],["物","もの"],["の"],["ため"],["に"],["銀","ぎん"],["、"],["青銅","せいどう"],["の"],["物","もの"],["の"],["ため"],["に"],["青銅","せいどう"],["、"],["鉄","てつ"],["の"],["物","もの"],["の"],["ため"],["に"],["鉄","てつ"],["、"],["木","き"],["の"],["物","もの"],["の"],["ため"],["に"],["木","き"],["を"],["備","そなえ"],["た"],["。"],["その"],["他","た"],["縞","しま"],["めのう"],["、"],["はめ"],["石","いし"],["、"],["アンチモニイ"],["、"],["色","いろ"],["の"],["ついた"],["石","いし"],["、"],["さまざま"],["の"],["宝石","ほうせき"],["、"],["大理石","だいりせき"],["など"],["おびただしい"],["。"]]},{"verse":3,"text":"なおわたしはわが神,かみの宮,みやに熱心,ねっしんなるがゆえに、聖,せいなる家,いえのために備,そなえたすべての物,ものに加,くわえて、わたしの持,もっている金銀,きんぎんの財宝,ざいほうをわが神,かみの宮,みやにささげる。","tok":[["なお"],["わたし"],["は"],["わが"],["神","かみ"],["の"],["宮","みや"],["に"],["熱心","ねっしん"],["なる"],["が"],["ゆえ"],["に"],["、"],["聖","せい"],["なる"],["家","いえ"],["の"],["ため"],["に"],["備","そなえ"],["た"],["すべて"],["の"],["物","もの"],["に"],["加えて","くわえて"],["、"],["わたし"],["の"],["持って","もって"],["いる"],["金銀","きんぎん"],["の"],["財宝","ざいほう"],["を"],["わが"],["神","かみ"],["の"],["宮","みや"],["に"],["ささげる"],["。"]]},{"verse":4,"text":"すなわちオフルの金,きん三千タラント、精,せい銀,ぎん七千タラントをそのもろもろの建物,たてものの壁,かべをおおうためにささげる。","tok":[["すなわち"],["オフル"],["の"],["金三","きん三"],["千","せん"],["タラント"],["、"],["精","せい"],["銀","ぎん"],["七千","ななせん"],["タラント"],["を"],["その"],["もろもろ"],["の"],["建物","たてもの"],["の"],["壁","かべ"],["を"],["おおう"],["ため"],["に"],["ささげる"],["。"]]},{"verse":5,"text":"金,きんは金,きんの物,もののために、銀,ぎんは銀,ぎんの物,もののために、すべて工人,こうじんによって造,つくられるもののために用,もちいる。だれかきょう、主,しゅにその身,みをささげる者,もののように喜,よろこんでささげ物,ものをするだろうか」。","tok":[["金","きん"],["は"],["金","きん"],["の"],["物","もの"],["の"],["ため"],["に"],["、"],["銀","ぎん"],["は"],["銀","ぎん"],["の"],["物","もの"],["の"],["ため"],["に"],["、"],["すべて"],["工人","こうじん"],["によって"],["造られる","つくられる"],["もの"],["の"],["ため"],["に"],["用いる","もちいる"],["。"],["だれ"],["か"],["きょう"],["、"],["主に","しゅに"],["その"],["身","み"],["を"],["ささげる"],["者","もの"],["の"],["よう"],["に"],["喜こんで","よろこんで"],["ささげ物","ささげもの"],["を"],["するだろう"],["か"],["」"],["。"]]},{"verse":6,"text":"そこで氏族,しぞくの長,ちょうたち、イスラエルの部族,ぶぞくのつかさたち、千人,にんの長,ちょう、百人,にんの長,ちょうおよび王,おうの工事,こうじをつかさどる者,ものたちは喜,よろこんでささげ物,ものをした。","tok":[["そこ"],["で"],["氏族","しぞく"],["の"],["長","ちょう"],["たち"],["、"],["イスラエル"],["の"],["部族","ぶぞく"],["の"],["つかさ"],["たち"],["、"],["千人","にん"],["の"],["長う","ちょう"],["、"],["百人","にん"],["の"],["長う","ちょう"],["および"],["王","おう"],["の"],["工事","こうじ"],["を"],["つかさどる"],["者","もの"],["たち"],["は"],["喜こんで","よろこんで"],["ささげ物","ささげもの"],["を"],["した"],["。"]]},{"verse":7,"text":"こうして彼,かれらは神,かみの宮,みやの務,つとめのために金,きん五千タラント一万ダリク、銀,ぎん一万タラント、青銅,せいどう一万八千タラント、鉄,てつ十万タラントをささげた。","tok":[["こう"],["して"],["彼","かれ"],["ら"],["は"],["神","かみ"],["の"],["宮","みや"],["の"],["務め","つとめ"],["の"],["ため"],["に"],["金","きん"],["五千","ごせん"],["タラント"],["一万","いちまん"],["ダリク"],["、"],["銀","ぎん"],["一万","いちまん"],["タラント"],["、"],["青銅","せいどう"],["一万八千","いちまんはちせん"],["タラント"],["、"],["鉄","てつ"],["十万","じゅうまん"],["タラント"],["を"],["ささげた"],["。"]]},{"verse":8,"text":"宝石,ほうせきを持,もっている者,ものはそれをゲルションびとエヒエルの手,てによって神,かみの宮,みやの倉,くらに納,おさめた。","tok":[["宝石","ほうせき"],["を"],["持って","もって"],["いる"],["者","もの"],["は"],["それ"],["を"],["ゲルション"],["びと"],["エヒエル"],["の"],["手","て"],["によって"],["神","かみ"],["の"],["宮","みや"],["の"],["倉","くら"],["に"],["納","おさめ"],["た"],["。"]]},{"verse":9,"text":"彼,かれらがこのように真心,こころからみずから進,すすんで主,しゅにささげたので、民,たみはそのみずから進,すすんでささげたのを喜,よろこんだ。ダビデ王,おうもまた大,おおいに喜,よろこんだ。","tok":[["彼","かれ"],["ら"],["が"],["この"],["よう"],["に"],["真心","こころか"],["ら"],["みずから"],["進んで","すすんで"],["主に","しゅに"],["ささげた"],["ので"],["、"],["民","たみ"],["は"],["その"],["みずから"],["進んで","すすんで"],["ささげた"],["の"],["を"],["喜こんだ","よろこんだ"],["。"],["ダビデ"],["王","おう"],["も"],["また"],["大いに","おおいに"],["喜こんだ","よろこんだ"],["。"]]},{"verse":10,"text":"そこでダビデは全,ぜん会衆,かいしゅうの前,まえで主,しゅをほめたたえた。ダビデは言,いった、「われわれの先祖,せんぞイスラエルの神,かみ、主,しゅよ、あなたはとこしえにほむべきかたです。","tok":[["そこ"],["で"],["ダビデ"],["は"],["全","ぜん"],["会衆","かいしゅう"],["の"],["前","まえ"],["で"],["主","しゅ"],["を"],["ほめたたえた"],["。"],["ダビデ"],["は"],["言った","いった"],["、"],["「"],["われわれ"],["の"],["先祖","せんぞ"],["イスラエル"],["の"],["神","かみ"],["、"],["主","しゅ"],["よ"],["、"],["あなた"],["は"],["とこしえ"],["に"],["ほ"],["むべき"],["かた"],["です"],["。"]]},{"verse":11,"text":"主,しゅよ、大,おおいなることと、力,ちからと、栄光,えいこうと、勝利,しょうりと、威光,いこうとはあなたのものです。天,てんにあるもの、地,ちにあるものも皆,みなあなたのものです。主,しゅよ、国,くにもまたあなたのものです。あなたは万有,ばんゆうのかしらとして、あがめられます。","tok":[["主","しゅ"],["よ"],["、"],["大いなる","おおいなる"],["こと"],["と"],["、"],["力","ちから"],["と"],["、"],["栄光","えいこう"],["と"],["、"],["勝利","しょうり"],["と"],["、"],["威光","いこう"],["と"],["は"],["あなた"],["の"],["もの"],["です"],["。"],["天","てん"],["に"],["ある"],["もの"],["、"],["地","ち"],["に"],["ある"],["もの"],["も"],["皆","みな"],["あなた"],["の"],["もの"],["です"],["。"],["主","しゅ"],["よ"],["、"],["国","くに"],["も"],["また"],["あなた"],["の"],["もの"],["です"],["。"],["あなた"],["は"],["万有","ばんゆう"],["の"],["かしら"],["として"],["、"],["あがめられます"],["。"]]},{"verse":12,"text":"富,とみと誉,ほまれとはあなたから出,でます。あなたは万有,ばんゆうをつかさどられます。あなたの手,てには勢,いきおいと力,ちからがあります。あなたの手,てはすべてのものを大,おおいならしめ、強,つよくされます。","tok":[["富","とみ"],["と"],["誉","ほまれ"],["と"],["は"],["あなた"],["から"],["出ます","でます"],["。"],["あなた"],["は"],["万有","ばんゆう"],["を"],["つかさどられます"],["。"],["あなた"],["の"],["手","て"],["に"],["は"],["勢","いきおい"],["と"],["力","ちから"],["が"],["あります"],["。"],["あなた"],["の"],["手","て"],["は"],["すべて"],["の"],["もの"],["を"],["大","お"],["おい"],["ならしめ"],["、"],["強く","つよく"],["されます"],["。"]]},{"verse":13,"text":"われわれの神,かみよ、われわれは、いま、あなたに感謝,かんしゃし、あなたの光栄,こうえいある名,なをたたえます。","tok":[["われわれ"],["の"],["神","かみ"],["よ"],["、"],["われわれ"],["は"],["、"],["いま"],["、"],["あなた"],["に"],["感謝","かんしゃ"],["し"],["、"],["あなた"],["の"],["光栄","こうえい"],["ある"],["名","な"],["を"],["たたえます"],["。"]]},{"verse":14,"text":"しかしわれわれがこのように喜,よろこんでささげることができても、わたしは何者,なにものでしょう。わたしの民,たみは何,なにでしょう。すべての物,ものはあなたから出,でます。われわれはあなたから受,うけて、あなたにささげたのです。","tok":[["しかし"],["われわれ"],["が"],["この"],["よう"],["に"],["喜こんで","よろこんで"],["ささげる"],["こと"],["が"],["できて"],["も"],["、"],["わたし"],["は"],["何者","なにもの"],["でしょう"],["。"],["わたし"],["の"],["民","たみ"],["は"],["何に","なに"],["でしょう"],["。"],["すべて"],["の"],["物","もの"],["は"],["あなた"],["から"],["出ます","でます"],["。"],["われわれ"],["は"],["あなた"],["から"],["受けて","うけて"],["、"],["あなた"],["に"],["ささげた"],["の"],["です"],["。"]]},{"verse":15,"text":"われわれはあなたの前,まえではすべての先祖,せんぞたちのように、旅,たびびとです、寄留者,きりゅうしゃです。われわれの世,よにある日,ひは影,かげのようで、長,ながくとどまることはできません。","tok":[["われわれ"],["は"],["あなた"],["の"],["前","まえ"],["で"],["は"],["すべて"],["の"],["先祖","せんぞ"],["たち"],["の"],["よう"],["に"],["、"],["旅びと","たびびと"],["です"],["、"],["寄留者","きりゅうしゃ"],["です"],["。"],["われわれ"],["の"],["世","よ"],["に"],["ある"],["日","ひ"],["は"],["影","かげ"],["の"],["よう"],["で"],["、"],["長く","ながく"],["とどまる"],["こと"],["は"],["できません"],["。"]]},{"verse":16,"text":"われわれの神,かみ、主,しゅよ、あなたの聖,せいなる名,なのために、あなたに家,いえを建,たてようとしてわれわれが備,そなえたこの多,おおくの物,ものは皆,みなあなたの手,てから出,でたもの、また皆,みなあなたのものです。","tok":[["われわれ"],["の"],["神","かみ"],["、"],["主","しゅ"],["よ"],["、"],["あなた"],["の"],["聖","せい"],["なる"],["名","な"],["の"],["ため"],["に"],["、"],["あなた"],["に"],["家","いえ"],["を"],["建てよう","たてよう"],["として"],["われわれ"],["が"],["備","そなえ"],["たこ"],["の"],["多く","おおく"],["の"],["物","もの"],["は"],["皆","みな"],["あなた"],["の"],["手","て"],["から"],["出た","でた"],["もの"],["、"],["また"],["皆","みな"],["あなた"],["の"],["もの"],["です"],["。"]]},{"verse":17,"text":"わが神,かみよ、あなたは心,こころをためし、また正直,しょうじきを喜,よろこばれることを、わたしは知,しっています。わたしは正,ただしい心,こころで、このすべての物,ものを喜,よろこんでささげました。今,いまわたしはまた、ここにおるあなたの民,たみが喜,よろこんで、みずから進,すすんであなたにささげ物,ものをするのを見,みました。","tok":[["わが"],["神","かみ"],["よ"],["、"],["あなた"],["は"],["心","こころ"],["を"],["ためし"],["、"],["また"],["正直","しょうじき"],["を"],["喜こばれる","よろこばれる"],["こと"],["を"],["、"],["わたし"],["は"],["知って","しって"],["います"],["。"],["わたし"],["は"],["正い","ただしい"],["心","こころ"],["で"],["、"],["この"],["すべて"],["の"],["物","もの"],["を"],["喜こんで","よろこんで"],["ささげました"],["。"],["今","いま"],["わたし"],["は"],["また"],["、"],["ここ"],["に"],["おる"],["あなた"],["の"],["民","たみ"],["が"],["喜こんで","よろこんで"],["、"],["みずから"],["進んで","すすんで"],["あなた"],["に"],["ささげ物","ささげもの"],["を"],["する"],["の"],["を"],["見ました","みました"],["。"]]},{"verse":18,"text":"われわれの先祖,せんぞアブラハム、イサク、イスラエルの神,かみ、主,しゅよ、あなたの民,たみの心,こころにこの意志,いしと精神,せいしんとをいつまでも保,たもたせ、その心,こころをあなたに向,むけさせてください。","tok":[["われわれ"],["の"],["先祖","せんぞ"],["アブラハム"],["、"],["イサク"],["、"],["イスラエル"],["の"],["神","かみ"],["、"],["主","しゅ"],["よ"],["、"],["あなた"],["の"],["民","たみ"],["の"],["心","こころ"],["に"],["この"],["意志","いし"],["と"],["精神","せいしん"],["と"],["を"],["いつ"],["まで"],["も"],["保たせ","たもたせ"],["、"],["その"],["心","こころ"],["を"],["あなた"],["に"],["向けさせて","むけさせて"],["ください"],["。"]]},{"verse":19,"text":"またわが子,こソロモンに心,こころをつくしてあなたの命令,めいれいと、あなたのあかしと、あなたのさだめとを守,まもらせて、これをことごとく行,おこなわせ、わたしが備,そなえをした宮,みやを建,たてさせてください」。","tok":[["また"],["わが"],["子","こ"],["ソロモン"],["に"],["心","こころ"],["を"],["つくして"],["あなた"],["の"],["命令","めいれい"],["と"],["、"],["あなた"],["の"],["あかし"],["と"],["、"],["あなた"],["の"],["さだめ"],["と"],["を"],["守らせて","まもらせて"],["、"],["これ"],["を"],["ことごとく"],["行なわせ","おこなわせ"],["、"],["わたし"],["が"],["備","そなえ"],["を"],["した"],["宮","みや"],["を"],["建てさせて","たてさせて"],["ください"],["」"],["。"]]},{"verse":20,"text":"そしてダビデが全,ぜん会衆,かいしゅうにむかって、「あなたがたの神,かみ、主,しゅをほめたたえよ」と言,いったので、全,ぜん会衆,かいしゅうは先祖,せんぞたちの神,かみ、主,しゅをほめたたえ、伏,ふして主,しゅを拝,はいし、王,おうに敬礼,けいれいした。","tok":[["そして"],["ダビデ"],["が"],["全","ぜん"],["会衆","かいしゅう"],["に"],["むかって"],["、"],["「"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["を"],["ほめたたえよ"],["」"],["と"],["言った","いった"],["ので"],["、"],["全","ぜん"],["会衆","かいしゅう"],["は"],["先祖","せんぞ"],["たち"],["の"],["神","かみ"],["、"],["主","しゅ"],["を"],["ほめたたえ"],["、"],["伏して","ふして"],["主","しゅ"],["を"],["拝し","はいし"],["、"],["王","おう"],["に"],["敬礼","けいれい"],["した"],["。"]]},{"verse":21,"text":"そしてその翌日,よくじつ彼,かれらは全,ぜんイスラエルのために主,しゅに犠牲,ぎせいをささげた。すなわち燔祭,はんさいとして雄牛,おうし一千、雄羊,おひつじ一千、小羊,こひつじ一千をその灌祭,かんさいと共,ともに主,しゅにささげ、おびただしい犠牲,ぎせいをささげた。","tok":[["そして"],["その"],["翌日","よくじつ"],["彼","かれ"],["ら"],["は"],["全","ぜん"],["イスラエル"],["の"],["ため"],["に"],["主に","しゅに"],["犠牲","ぎせい"],["を"],["ささげた"],["。"],["すなわち"],["燔祭","はんさい"],["として"],["雄牛","おうし"],["一千","いちせん"],["、"],["雄羊","おひつじ"],["一千","いちせん"],["、"],["小羊","こひつじ"],["一千","いちせん"],["を"],["その"],["灌祭","かんさい"],["と"],["共","とも"],["に"],["主に","しゅに"],["ささげ"],["、"],["おびただしい"],["犠牲","ぎせい"],["を"],["ささげた"],["。"]]},{"verse":22,"text":"そしてその日,ひ、彼,かれらは大,おおいなる喜,よろこびをもって主,しゅの前,まえに食,くい飲,のみした。彼,かれらはさらに改,あらためてダビデの子,こソロモンを王,おうとなし、これに油,あぶらを注,そそいで主,しゅの君,きみとなし、またザドクを祭司,さいしとした。","tok":[["そして"],["その"],["日","ひ"],["、"],["彼","かれ"],["ら"],["は"],["大いなる","おおいなる"],["喜こび","よろこび"],["を"],["もって"],["主","しゅ"],["の"],["前","まえ"],["に"],["食い","くい"],["飲み","のみ"],["した"],["。"],["彼","かれ"],["ら"],["は"],["さらに"],["改","あらため"],["て"],["ダビデ"],["の"],["子","こ"],["ソロモン"],["を"],["王","おう"],["と"],["なし"],["、"],["これ"],["に"],["油","あぶら"],["を"],["注いで","そそいで"],["主","しゅ"],["の"],["君","きみ"],["と"],["なし"],["、"],["また"],["ザドク"],["を"],["祭司","さいし"],["と"],["した"],["。"]]},{"verse":23,"text":"こうしてソロモンはその父,ちちダビデに代,かわり、王,おうとして主,しゅの位,くらいに座,ざした。彼,かれは栄,さかえ、イスラエルは皆,みな彼,かれに従,したがった。","tok":[["こう"],["して"],["ソロモン"],["は"],["その"],["父","ちち"],["ダビデ"],["に"],["代わり","かわり"],["、"],["王","おう"],["として"],["主","しゅ"],["の"],["位","くらい"],["に"],["座した","ざした"],["。"],["彼","かれ"],["は"],["栄","さかえ"],["、"],["イスラエル"],["は"],["皆","みな"],["彼","かれ"],["に"],["従った","したがった"],["。"]]},{"verse":24,"text":"またすべてのつかさたち、勇士,ゆうしたち、およびダビデ王,おうの王子,おうじたちも皆,みなソロモン王,おうに忠誠,ちゅうせいを誓,ちかった。","tok":[["また"],["すべて"],["の"],["つかさ"],["たち"],["、"],["勇士","ゆうし"],["たち"],["、"],["および"],["ダビデ"],["王","おう"],["の"],["王子","おうじ"],["たち"],["も"],["皆","みな"],["ソロモン"],["王","おう"],["に"],["忠誠","ちゅうせい"],["を"],["誓った","ちかった"],["。"]]},{"verse":25,"text":"主,しゅは全,ぜんイスラエルの目,めの前,まえでソロモンを非常,ひじょうに大,おおいならしめ、彼,かれより前,まえのイスラエルのどの王,おうも得,えたことのない王威,おういを彼,かれに与,あたえられた。","tok":[["主","しゅ"],["は"],["全","ぜん"],["イスラエル"],["の"],["目","め"],["の"],["前","まえ"],["で"],["ソロモン"],["を"],["非常","ひじょう"],["に"],["大","お"],["おい"],["ならしめ"],["、"],["彼","かれ"],["より"],["前","まえ"],["の"],["イスラエル"],["の"],["どの"],["王","おう"],["も"],["得た","えた"],["こと"],["の"],["ない"],["王威","おうい"],["を"],["彼","かれ"],["に"],["与えられた","あたえられた"],["。"]]},{"verse":26,"text":"このようにエッサイの子,こダビデは全,ぜんイスラエルを治,おさめた。","tok":[["この"],["よう"],["に"],["エッサイ"],["の"],["子","こ"],["ダビデ"],["は"],["全","ぜん"],["イスラエル"],["を"],["治めた","おさめた"],["。"]]},{"verse":27,"text":"彼,かれがイスラエルを治,おさめた期間,きかんは四十年,ねんであった。すなわちヘブロンで七年,ねん世,よを治,おさめ、エルサレムで三十三年,ねん世,よを治,おさめた。","tok":[["彼","かれ"],["が"],["イスラエル"],["を"],["治めた","おさめた"],["期間","きかん"],["は"],["四十","よんじゅう"],["年","ねん"],["で"],["あった"],["。"],["すなわち"],["ヘブロン"],["で"],["七","なな"],["年世","年よ"],["を"],["治め","おさめ"],["、"],["エルサレム"],["で"],["三十三","さんじゅうさん"],["年世","年よ"],["を"],["治めた","おさめた"],["。"]]},{"verse":28,"text":"彼,かれは高齢,こうれいに達,たっし、年,ねんも富,とみも誉,ほまれも満,みち足,たりて死,しんだ。その子,こソロモンが彼,かれに代,かわって王,おうとなった。","tok":[["彼","かれ"],["は"],["高齢","こうれい"],["に"],["達し","たっし"],["、"],["年","ねん"],["も"],["富","とみ"],["も"],["誉","ほまれ"],["も"],["満ち足りて","みちたりて"],["死んだ","しんだ"],["。"],["その"],["子","こ"],["ソロモン"],["が"],["彼","かれ"],["に"],["代わって","かわって"],["王","おう"],["と"],["なった"],["。"]]},{"verse":29,"text":"ダビデ王,おうの始終,しじゅうの行為,こういは、先見者,せんけんしゃサムエルの書,しょ、預言者,よげんしゃナタンの書,しょおよび先見者,せんけんしゃガドの書,しょにしるされている。","tok":[["ダビデ"],["王","おう"],["の"],["始終","しじゅう"],["の"],["行為","こうい"],["は"],["、"],["先見者","せんけんしゃ"],["サムエル"],["の"],["書","しょ"],["、"],["預言者","よげんしゃ"],["ナタン"],["の"],["書","しょ"],["および"],["先見者","せんけんしゃ"],["ガド"],["の"],["書","しょ"],["に"],["しるされて"],["いる"],["。"]]},{"verse":30,"text":"そのうちには彼,かれのすべての政,せいと、その力,ちからおよび彼,かれとイスラエルと他,たのすべての国々,くにぐにに臨,のぞんだ事,ことどもをしるしている。","tok":[["その"],["うち"],["に"],["は"],["彼","かれ"],["の"],["すべて"],["の"],["政","せい"],["と"],["、"],["その"],["力","ちから"],["および"],["彼","かれ"],["と"],["イスラエル"],["と"],["他","た"],["の"],["すべて"],["の"],["国々","くにぐに"],["に"],["臨んだ","のぞんだ"],["事","こと"],["ども"],["を"],["しるして"],["いる"],["。"]]}]
[{"verse":1,"text":"ユダの子,こらはペレヅ、ヘヅロン、カルミ、ホル、ショバルである。","tok":[["ユダ"],["の"],["子","こ"],["ら"],["は"],["ペレヅ"],["、"],["ヘヅロン"],["、"],["カルミ"],["、"],["ホル"],["、"],["ショバル"],["で"],["ある"],["。"]]},{"verse":2,"text":"ショバルの子,こレアヤはヤハテを生,うみ、ヤハテはアホマイとラハデを生,うんだ。これらはザレアびとの一族,いちぞくである。","tok":[["ショバル"],["の"],["子","こ"],["レアヤ"],["は"],["ヤハテ"],["を"],["生み","うみ"],["、"],["ヤハテ"],["は"],["アホマイ"],["と"],["ラハデ"],["を"],["生んだ","うんだ"],["。"],["これ"],["ら"],["は"],["ザレア"],["びと"],["の"],["一族","いちぞく"],["で"],["ある"],["。"]]},{"verse":3,"text":"エタムの子,こらはエズレル、イシマおよびイデバシ、彼,かれらの姉妹,しまいの名,なはハゼレルポニである。","tok":[["エタム"],["の"],["子","こ"],["ら"],["は"],["エズレル"],["、"],["イシマ"],["および"],["イデバシ"],["、"],["彼","かれ"],["ら"],["の"],["姉妹","しまい"],["の"],["名","な"],["は"],["ハゼレルポニ"],["で"],["ある"],["。"]]},{"verse":4,"text":"ゲドルの父,ちちはペヌエル、ホシャの父,ちちはエゼルである。これらはベツレヘムの父,ちちエフラタの長子,ちょうしホルの子,こらである。","tok":[["ゲドル"],["の"],["父","ちち"],["は"],["ペヌエル"],["、"],["ホシャ"],["の"],["父","ちち"],["は"],["エゼル"],["で"],["ある"],["。"],["これ"],["ら"],["は"],["ベツレヘム"],["の"],["父","ちち"],["エフラタ"],["の"],["長子","ちょうし"],["ホル"],["の"],["子","こ"],["ら"],["で"],["ある"],["。"]]},{"verse":5,"text":"テコアの父,ちちアシュルにはふたりの妻,つまヘラとナアラとがあった。","tok":[["テコア"],["の"],["父","ちち"],["アシュル"],["に"],["は"],["ふたり"],["の"],["妻","つま"],["ヘラ"],["と"],["ナアラ"],["と"],["が"],["あった"],["。"]]},{"verse":6,"text":"ナアラはアシュルによってアホザム、ヘペル、テメニおよびアハシタリを産,うんだ。これらはナアラの子,こである。","tok":[["ナアラ"],["は"],["アシュル"],["によって"],["アホザム"],["、"],["ヘペル"],["、"],["テメニ"],["および"],["アハシタリ"],["を"],["産んだ","うんだ"],["。"],["これ"],["ら"],["は"],["ナアラ"],["の"],["子","こ"],["で"],["ある"],["。"]]},{"verse":7,"text":"ヘラの子,こらはゼレテ、エゾアル、エテナンである。","tok":[["ヘラ"],["の"],["子","こ"],["ら"],["は"],["ゼレテ"],["、"],["エゾアル"],["、"],["エテナン"],["で"],["ある"],["。"]]},{"verse":8,"text":"コヅはアヌブとゾベバを生,うんだ。またハルムの子,こアハルヘルの氏族,しぞくも彼,かれから出,でた。","tok":[["コヅ"],["は"],["アヌブ"],["と"],["ゾベバ"],["を"],["生んだ","うんだ"],["。"],["また"],["ハルム"],["の"],["子","こ"],["アハルヘル"],["の"],["氏族","しぞく"],["も"],["彼","かれ"],["から"],["出た","でた"],["。"]]},{"verse":9,"text":"ヤベヅはその兄弟,きょうだいのうちで最,もっとも尊,たっとばれた者,ものであった。その母,ははが「わたしは苦,くるしんでこの子,こを産,うんだから」と言,いってその名,なをヤベヅと名,なづけたのである。","tok":[["ヤベヅ"],["は"],["その"],["兄弟","きょうだい"],["の"],["うち"],["で"],["最も","もっとも"],["尊","た"],["っと"],["ばれた"],["者","もの"],["で"],["あった"],["。"],["その"],["母","はは"],["が"],["「"],["わたし"],["は"],["苦しんで","くるしんで"],["この"],["子","こ"],["を"],["産","うんだか"],["ら"],["」"],["と"],["言って","いって"],["その"],["名","な"],["を"],["ヤベヅ"],["と"],["名づけた","なづけた"],["ので"],["ある"],["。"]]},{"verse":10,"text":"ヤベヅはイスラエルの神,かみに呼,よばわって言,いった、「どうか、あなたが豊,ゆたかにわたしを恵,めぐみ、わたしの国境,こっきょうを広,ひろげ、あなたの手,てがわたしとともにあって、わたしを災,わざわいから免,まぬかれさせ、苦,くるしみをうけさせられないように」。神,かみは彼,かれの求,もとめるところをゆるされた。","tok":[["ヤベヅ"],["は"],["イスラエル"],["の"],["神","かみ"],["に"],["呼ばわって","よばわって"],["言った","いった"],["、"],["「"],["どう"],["か"],["、"],["あなた"],["が"],["豊","ゆたか"],["に"],["わたし"],["を"],["恵み","めぐみ"],["、"],["わたし"],["の"],["国境","こっきょう"],["を"],["広げ","ひろげ"],["、"],["あなた"],["の"],["手","て"],["が"],["わたし"],["と"],["とも"],["に"],["あって"],["、"],["わたし"],["を"],["災","わざわい"],["から"],["免かれさせ","まぬかれさせ"],["、"],["苦しみ","くるしみ"],["を"],["うけさせられない"],["よう"],["に"],["」"],["。"],["神","かみ"],["は"],["彼","かれ"],["の"],["求める","もとめる"],["ところ"],["を"],["ゆるされた"],["。"]]},{"verse":11,"text":"シュワの兄弟,きょうだいケルブはメヒルを生,うんだ。メヒルはエシトンの父,ちち、","tok":[["シュワ"],["の"],["兄弟","きょうだい"],["ケルブ"],["は"],["メヒル"],["を"],["生んだ","うんだ"],["。"],["メヒル"],["は"],["エシトン"],["の"],["父","ちち"],["、"]]},{"verse":12,"text":"エシトンはベテラパ、パセアおよびイルナハシの父,ちちテヒンナを生,うんだ。これらはレカの人々,ひとびとである。","tok":[["エシトン"],["は"],["ベテラパ"],["、"],["パセア"],["および"],["イルナハシ"],["の"],["父","ちち"],["テヒンナ"],["を"],["生んだ","うんだ"],["。"],["これ"],["ら"],["は"],["レカ"],["の"],["人々","ひとびと"],["で"],["ある"],["。"]]},{"verse":13,"text":"ケナズの子,こらはオテニエルとセラヤ。オテニエルの子,こらはハタテとメオノタイ。","tok":[["ケナズ"],["の"],["子","こ"],["ら"],["は"],["オテニエル"],["と"],["セラヤ"],["。"],["オテニエル"],["の"],["子","こ"],["ら"],["は"],["ハタテ"],["と"],["メオノタイ"],["。"]]},{"verse":14,"text":"メオノタイはオフラを生,うみ、セラヤはゲハラシムの父,ちちヨアブを生,うんだ。彼,かれらは工人,こうじんであったのでゲハラシムと呼,よばれたのである。","tok":[["メオノタイ"],["は"],["オフラ"],["を"],["生み","うみ"],["、"],["セラヤ"],["は"],["ゲハラシム"],["の"],["父","ちち"],["ヨアブ"],["を"],["生んだ","うんだ"],["。"],["彼","かれ"],["ら"],["は"],["工人","こうじん"],["で"],["あった"],["ので"],["ゲハラシム"],["と"],["呼ばれた","よばれた"],["ので"],["ある"],["。"]]},{"verse":15,"text":"エフンネの子,こカレブの子,こらはイル、エラおよびナアム。エラの子,こはケナズ。","tok":[["エフンネ"],["の"],["子","こ"],["カレブ"],["の"],["子","こ"],["ら"],["は"],["イル"],["、"],["エラ"],["および"],["ナアム"],["。"],["エラ"],["の"],["子","こ"],["は"],["ケナズ"],["。"]]},{"verse":16,"text":"エハレレルの子,こらはジフ、ジバ、テリア、アサレルである。","tok":[["エハレレル"],["の"],["子","こ"],["ら"],["は"],["ジフ"],["、"],["ジバ"],["、"],["テリア"],["、"],["アサレル"],["で"],["ある"],["。"]]},{"verse":17,"text":"エズラの子,こらはエテル、メレデ、エペル、ヤロン。次,つぎのものはメレデがめとったパロの娘,むすめビテヤの子,こらである。すなわち彼女,かのじょはみごもってミリアム、シャンマイおよびイシバを産,うんだ。イシバはエシテモアの父,ちちである。","tok":[["エズラ"],["の"],["子","こ"],["ら"],["は"],["エテル"],["、"],["メレデ"],["、"],["エペル"],["、"],["ヤロン"],["。"],["次","つぎ"],["の"],["もの"],["は"],["メレデ"],["が"],["めとった"],["パロ"],["の"],["娘","むすめ"],["ビテヤ"],["の"],["子","こ"],["ら"],["で"],["ある"],["。"],["すなわち"],["彼女","かのじょ"],["は"],["みごもって"],["ミリアム"],["、"],["シャンマイ"],["および"],["イシバ"],["を"],["産んだ","うんだ"],["。"],["イシバ"],["は"],["エシテモア"],["の"],["父","ちち"],["で"],["ある"],["。"]]},{"verse":18,"text":"彼,かれの妻,つまはユダヤ人,ひとで、ゲドルの父,ちちエレデとソコの父,ちちヘベルとザノアの父,ちちエクテエルを産,うんだ。","tok":[["彼","かれ"],["の"],["妻","つま"],["は"],["ユダヤ人","ゆだやひと"],["で"],["、"],["ゲドル"],["の"],["父","ちち"],["エレデ"],["と"],["ソコ"],["の"],["父","ちち"],["ヘベル"],["と"],["ザノア"],["の"],["父","ちち"],["エクテエル"],["を"],["産んだ","うんだ"],["。"]]},{"verse":19,"text":"ナハムの姉妹,しまいであるホデヤの妻,つまの子,こらはガルムびとケイラの父,ちちおよびマアカびとエシテモアである。","tok":[["ナハム"],["の"],["姉妹","しまい"],["で"],["ある"],["ホデヤ"],["の"],["妻","つま"],["の"],["子","こ"],["ら"],["は"],["ガルム"],["び"],["と"],["ケイラ"],["の"],["父","ちち"],["および"],["マアカ"],["びと"],["エシテモア"],["で"],["ある"],["。"]]},{"verse":20,"text":"シモンの子,こらはアムノン、リンナ、ベネハナン、テロンである。イシの子,こらはゾヘテとベネゾヘテである。","tok":[["シモン"],["の"],["子","こ"],["ら"],["は"],["アムノン"],["、"],["リンナ"],["、"],["ベネハナン"],["、"],["テロン"],["で"],["ある"],["。"],["イシ"],["の"],["子","こ"],["ら"],["は"],["ゾヘテ"],["と"],["ベネゾヘテ"],["で"],["ある"],["。"]]},{"verse":21,"text":"ユダの子,こシラの子,こらはレカの父,ちちエル、マレシャの父,ちちラダおよびベテアシベアの亜麻布,あまぬの織,おりの家,いえの一族,いちぞく、","tok":[["ユダ"],["の"],["子","こ"],["シラ"],["の"],["子","こ"],["ら"],["は"],["レカ"],["の"],["父","ちち"],["エル"],["、"],["マレシャ"],["の"],["父","ちち"],["ラダ"],["および"],["ベテアシベア"],["の"],["亜","あ"],["麻布","あざぶ"],["の"],["織","おり"],["の"],["家","いえ"],["の"],["一族","いちぞく"],["、"]]},{"verse":22,"text":"ならびにモアブを治,おさめてレヘムに帰,かえったヨキム、コゼバの人々,ひとびと、ヨアシおよびサラフである。その記録,きろくは古,ふるい。","tok":[["ならびに"],["モアブ"],["を"],["治めて","おさめて"],["レヘム"],["に"],["帰えった","かえった"],["ヨキム"],["、"],["コゼバ"],["の"],["人々","ひとびと"],["、"],["ヨアシ"],["および"],["サラフ"],["で"],["ある"],["。"],["その"],["記録","きろく"],["は"],["古い","ふるい"],["。"]]},{"verse":23,"text":"これらの者,ものは陶器,とうきを造,つくる人,ひとで、ネタイムおよびゲデラに住,すみ、王,おうの用,ようをするため、王,おうとともに、そこに住,すんだ。","tok":[["これ"],["ら"],["の"],["者","もの"],["は"],["陶器","とうき"],["を"],["造る","つくる"],["人","ひと"],["で"],["、"],["ネタイム"],["および"],["ゲデラ"],["に"],["住み","すみ"],["、"],["王","おう"],["の"],["用","よう"],["を"],["する"],["ため"],["、"],["王","おう"],["と"],["とも"],["に"],["、"],["そこ"],["に"],["住んだ","すんだ"],["。"]]},{"verse":24,"text":"シメオンの子,こらはネムエル、ヤミン、ヤリブ、ゼラ、シャウル。","tok":[["シメオン"],["の"],["子","こ"],["ら"],["は"],["ネムエル"],["、"],["ヤミン"],["、"],["ヤリブ"],["、"],["ゼラ"],["、"],["シャウル"],["。"]]},{"verse":25,"text":"シャウルの子,こはシャルム、その子,こはミブサム、その子,こはミシマ。","tok":[["シャウル"],["の"],["子","こ"],["は"],["シャルム"],["、"],["その"],["子","こ"],["は"],["ミブサム"],["、"],["その"],["子","こ"],["は"],["ミシマ"],["。"]]},{"verse":26,"text":"ミシマの子孫,しそんは、その子,こはハムエル、その子,こはザックル、その子,こはシメイ。","tok":[["ミシマ"],["の"],["子孫","しそん"],["は"],["、"],["その"],["子","こ"],["は"],["ハムエル"],["、"],["その"],["子","こ"],["は"],["ザックル"],["、"],["その"],["子","こ"],["は"],["シメイ"],["。"]]},{"verse":27,"text":"シメイには男,おとこの子,こ十六人,にん、女,おんなの子,こ六人,にんあったが、その兄弟,きょうだいたちには多,おおくの子,こはなかった。またその氏族,しぞくの者,ものはすべてユダの子孫,しそんほどにはふえなかった。","tok":[["シメイ"],["に"],["は"],["男の子","おとこのこ"],["十六人","にん"],["、"],["女の子","おんなのこ"],["六人","にん"],["あった"],["が"],["、"],["その"],["兄弟","きょうだい"],["たち"],["に"],["は"],["多く","おおく"],["の"],["子","こ"],["は"],["なかった"],["。"],["また"],["その"],["氏族","しぞく"],["の"],["者","もの"],["は"],["すべて"],["ユダ"],["の"],["子孫","しそん"],["ほど"],["に"],["は"],["ふえなかった"],["。"]]},{"verse":28,"text":"彼,かれらの住,すんだ所,ところはベエルシバ、モラダ、ハザル・シュアル、","tok":[["彼","かれ"],["ら"],["の"],["住んだ","すんだ"],["所","ところ"],["は"],["ベエルシバ"],["、"],["モラダ"],["、"],["ハザル"],["・"],["シュアル"],["、"]]},{"verse":29,"text":"ビルハ、エゼム、トラデ、","tok":[["ビルハ"],["、"],["エゼム"],["、"],["トラデ"],["、"]]},{"verse":30,"text":"ベトエル、ホルマ、チクラグ、","tok":[["ベトエル"],["、"],["ホルマ"],["、"],["チクラグ"],["、"]]},{"verse":31,"text":"ベテ・マルカボテ、ハザル・スシム、ベテ・ビリ、およびシャライムである。これらはダビデの世,よに至,いたるまで彼,かれらの町,まちであった。","tok":[["ベテ"],["・"],["マルカボテ"],["、"],["ハザル"],["・"],["スシム"],["、"],["ベテ"],["・"],["ビリ"],["、"],["および"],["シャライム"],["で"],["ある"],["。"],["これ"],["ら"],["は"],["ダビデ"],["の"],["世","よ"],["に"],["至る","いたる"],["まで"],["彼","かれ"],["ら"],["の"],["町","まち"],["で"],["あった"],["。"]]},{"verse":32,"text":"その村里,むらざとはエタム、アイン、リンモン、トケン、アシャンの五つの町,まちである。","tok":[["その"],["村里","むらざと"],["は"],["エタム"],["、"],["アイン"],["、"],["リンモン"],["、"],["トケン"],["、"],["アシャン"],["の"],["五","いつ"],["つ"],["の"],["町","まち"],["で"],["ある"],["。"]]},{"verse":33,"text":"またこれらの町々,まちまちの周囲,しゅういに多,おおくの村,むらがあって、バアルまでおよんだ。彼,かれらのすみかは以上,いじょうのとおりで、彼,かれらはおのおの系図,けいずをもっていた。","tok":[["また"],["これ"],["ら"],["の"],["町々","まちまち"],["の"],["周囲","しゅうい"],["に"],["多く","おおく"],["の"],["村","むら"],["が"],["あって"],["、"],["バアル"],["まで"],["およんだ"],["。"],["彼","かれ"],["ら"],["の"],["すみか"],["は"],["以上","いじょう"],["の"],["とおり"],["で"],["、"],["彼","かれ"],["ら"],["は"],["おのおの"],["系図","けいず"],["を"],["もって"],["いた"],["。"]]},{"verse":34,"text":"メショバブ、ヤムレク、アマジヤの子,こヨシャ、","tok":[["メショバブ"],["、"],["ヤムレク"],["、"],["アマジヤ"],["の"],["子","こ"],["ヨシャ"],["、"]]},{"verse":35,"text":"ヨエル、アシエルのひこ、セラヤの孫,まご、ヨシビアの子,こエヒウ。","tok":[["ヨエル"],["、"],["アシエル"],["の"],["ひこ"],["、"],["セラヤ"],["の"],["孫","まご"],["、"],["ヨシビア"],["の"],["子","こ"],["エヒウ"],["。"]]},{"verse":36,"text":"エリオエナイ、ヤコバ、エショハヤ、アサヤ、アデエル、エシミエル、ベナヤ、","tok":[["エリオエナイ"],["、"],["ヤコバ"],["、"],["エショハヤ"],["、"],["アサヤ"],["、"],["アデエル"],["、"],["エシミエル"],["、"],["ベナヤ"],["、"]]},{"verse":37,"text":"およびシピの子,こジザ。シピはアロンの子,こ、アロンはエダヤの子,こ、エダヤはシムリの子,こ、シムリはシマヤの子,こである。","tok":[["および"],["シピ"],["の"],["子","こ"],["ジザ"],["。"],["シピ"],["は"],["アロン"],["の"],["子","こ"],["、"],["アロン"],["は"],["エダヤ"],["の"],["子","こ"],["、"],["エダヤ"],["は"],["シムリ"],["の"],["子","こ"],["、"],["シムリ"],["は"],["シマヤ"],["の"],["子","こ"],["で"],["ある"],["。"]]},{"verse":38,"text":"ここに名,なをあげた者,ものどもはその氏族,しぞくの長,ちょうであって、それらの氏族,しぞくは大,おおいにふえ広,ひろがった。","tok":[["ここ"],["に"],["名","な"],["を"],["あげた"],["者","もの"],["ども"],["は"],["その"],["氏族","しぞく"],["の"],["長","ちょう"],["で"],["あって"],["、"],["それ"],["ら"],["の"],["氏族","しぞく"],["は"],["大いに","おおいに"],["ふえ"],["広がった","ひろがった"],["。"]]},{"verse":39,"text":"彼,かれらは群,むれのために牧場,まきばを求,もとめてゲドルの入口,いりぐちに行,いき、谷,たにの東,ひがしの方,ほうまで進,すすみ、","tok":[["彼","かれ"],["ら"],["は"],["群れ","むれ"],["の"],["ため"],["に"],["牧場","まきば"],["を"],["求めて","もとめて"],["ゲドル"],["の"],["入口","いりぐち"],["に"],["行き","いき"],["、"],["谷","たに"],["の"],["東","ひがし"],["の"],["方","ほう"],["まで"],["進み","すすみ"],["、"]]},{"verse":40,"text":"ついに豊,ゆたかな良,よい牧場,まきばを見,みいだした。その地,ちは広,ひろく穏,おだやかで、安,やすらかであった。その地,ちの前,まえの住民,じゅうみんはハムびとであったからである。","tok":[["ついに"],["豊","ゆたか"],["な"],["良い","よい"],["牧場","まきば"],["を"],["見いだした","みいだした"],["。"],["その"],["地","ち"],["は"],["広く","ひろく"],["穏","おだやか"],["で"],["、"],["安らか","やすらか"],["で"],["あった"],["。"],["その"],["地","ち"],["の"],["前","まえ"],["の"],["住民","じゅうみん"],["は"],["ハム"],["びと"],["で"],["あった"],["から"],["で"],["ある"],["。"]]},{"verse":41,"text":"これらの名,なをしるした者,ものどもはユダの王,おうヒゼキヤの世,よに行,いって、彼,かれらの天幕,てんまくと、そこにいたメウニびとを撃,うち破,やぶり、彼,かれらをことごとく滅,ほろぼして今日,こんにちに至,いたっている。そこには、群,むれのための牧場,まきばがあったので、彼,かれらはそこに住,すんだ。","tok":[["これ"],["ら"],["の"],["名","な"],["を"],["しるした"],["者","もの"],["ども"],["は"],["ユダ"],["の"],["王","おう"],["ヒゼキヤ"],["の"],["世","よ"],["に"],["行って","いって"],["、"],["彼","かれ"],["ら"],["の"],["天幕","てんまく"],["と"],["、"],["そこ"],["に"],["いた"],["メウニ"],["びと"],["を"],["撃ち破り","うちやぶり"],["、"],["彼","かれ"],["ら"],["を"],["ことごとく"],["滅ぼして","ほろぼして"],["今日","こんにち"],["に"],["至って","いたって"],["いる"],["。"],["そこ"],["に"],["は"],["、"],["群れ","むれ"],["の"],["ため"],["の"],["牧場","まきば"],["が"],["あった"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["そこ"],["に"],["住んだ","すんだ"],["。"]]},{"verse":42,"text":"またシメオンびとのうちの五百人,にんはイシの子,こらペラテヤ、ネアリヤ、レパヤ、ウジエルをかしらとしてセイル山,やまに行,いき、","tok":[["また"],["シメオン"],["びと"],["の"],["うち"],["の"],["五百人","にん"],["は"],["イシ"],["の"],["子","こ"],["ら"],["ペラテヤ"],["、"],["ネアリヤ"],["、"],["レパヤ"],["、"],["ウジエル"],["を"],["かしら"],["として"],["セイル山","せいるやま"],["に"],["行き","いき"],["、"]]},{"verse":43,"text":"アマレクびとで、のがれて残,のこっていた者,ものを撃,うち滅,ほろぼして、今日,こんにちまでそこに住,すんでいる。","tok":[["アマレク"],["びと"],["で"],["、"],["のがれて"],["残って","のこって"],["いた"],["者","もの"],["を"],["撃ち","うち"],["滅ぼして","ほろぼして"],["、"],["今日","こんにちまでそこ"],["に"],["住んで","すんで"],["いる"],["。"]]}]
[{"verse":1,"text":"サムソンはガザへ行,いって、そこでひとりの遊女,ゆうじょを見,み、その女,おんなのところにはいった。","tok":[["サムソン"],["は"],["ガザ"],["へ"],["行って","いって"],["、"],["そこ"],["で"],["ひとり"],["の"],["遊女","ゆうじょ"],["を"],["見","み"],["、"],["その"],["女","おんな"],["の"],["ところ"],["に"],["はいった"],["。"]]},{"verse":2,"text":"「サムソンがここにきた」と、ガザの人々,ひとびとに告,つげるものがあったので、ガザの人々,ひとびとはその所,ところを取,とり囲,かこみ、夜通,よどおし町,まちの門,もんで待,まち伏,ぶせし、「われわれは朝,あさまで待,まって彼,かれを殺,ころそう」と言,いって、夜通,よどおし静,しずかにしていた。","tok":[["「"],["サムソン"],["が"],["ここ"],["に"],["きた"],["」"],["と"],["、"],["ガザ"],["の"],["人々","ひとびと"],["に"],["告げる","つげる"],["もの"],["が"],["あった"],["ので"],["、"],["ガザ"],["の"],["人々","ひとびと"],["は"],["その"],["所","ところ"],["を"],["取囲み","とりかこみ"],["、"],["夜通し","よどおし"],["町","まち"],["の"],["門","もん"],["で"],["待伏せ","まちぶせ"],["し"],["、"],["「"],["われわれ"],["は"],["朝","あさ"],["まで"],["待って","まって"],["彼","かれ"],["を"],["殺そう","ころそう"],["」"],["と"],["言って","いって"],["、"],["夜通し","よどおし"],["静","しずか"],["に"],["して"],["いた"],["。"]]},{"verse":3,"text":"サムソンは夜中,よなかまで寝,ねたが、夜中,よなかに起,おきて、町,まちの門,もんのとびらと二つの門柱,もんちゅうに手,てをかけて、貫,かんの木,きもろともに引,ひき抜,ぬき、肩,かたに載,のせて、ヘブロンの向,むかいにある山,やまの頂,いただきに運,はこんで行,いった。","tok":[["サムソン"],["は"],["夜中","よなか"],["まで"],["寝た","ねた"],["が"],["、"],["夜中","よなか"],["に"],["起きて","おきて"],["、"],["町","まち"],["の"],["門","もん"],["の"],["とびら"],["と"],["二","ふた"],["つ"],["の"],["門柱","もんちゅう"],["に"],["手","て"],["を"],["かけて"],["、"],["貫の木","かんのき"],["もろとも"],["に"],["引抜き","ひきぬき"],["、"],["肩","かた"],["に"],["載せて","のせて"],["、"],["ヘブロン"],["の"],["向","むかい"],["に"],["ある"],["山","やま"],["の"],["頂","いただき"],["に"],["運こんで","はこんで"],["行った","いった"],["。"]]},{"verse":4,"text":"この後,のち、サムソンはソレクの谷,たににいるデリラという女,おんなを愛,あいした。","tok":[["この"],["後","の"],["ち"],["、"],["サムソン"],["は"],["ソレク"],["の"],["谷","たに"],["に"],["いる"],["デリラ"],["と"],["いう"],["女","おんな"],["を"],["愛した","あいした"],["。"]]},{"verse":5,"text":"ペリシテびとの君,きみたちはその女,おんなのところにきて言,いった、「あなたはサムソンを説,ときすすめて、彼,かれの大力,だいりきはどこにあるのか、またわれわれはどうすれば彼,かれに勝,かって、彼,かれを縛,しばり苦,くるしめることができるかを見,みつけなさい。そうすればわれわれはおのおの銀,ぎん千百枚,まいずつをあなたにさしあげましょう」。","tok":[["ペリシテ"],["びと"],["の"],["君","きみ"],["たち"],["は"],["その"],["女","おんな"],["の"],["ところ"],["に"],["きて"],["言った","いった"],["、"],["「"],["あなた"],["は"],["サムソン"],["を"],["説きすすめて","ときすすめて"],["、"],["彼","かれ"],["の"],["大力","だいりき"],["は"],["どこ"],["に"],["ある"],["の"],["か"],["、"],["また"],["われわれ"],["は"],["どう"],["すれば"],["彼","かれ"],["に"],["勝って","かって"],["、"],["彼","かれ"],["を"],["縛り","しばり"],["苦しめる","くるしめる"],["こと"],["が"],["できる"],["か"],["を"],["見つけ","みつけ"],["なさい"],["。"],["そう"],["すれば"],["われわれ"],["は"],["おのおの"],["銀","ぎん"],["千百枚","まいずつ"],["を"],["あなた"],["に"],["さしあげましょう"],["」"],["。"]]},{"verse":6,"text":"そこでデリラはサムソンに言,いった、「あなたの大力,だいりきはどこにあるのか、またどうすればあなたを縛,しばって苦,くるしめることができるか、どうぞわたしに聞,きかせてください」。","tok":[["そこ"],["で"],["デリラ"],["は"],["サムソン"],["に"],["言った","いった"],["、"],["「"],["あなた"],["の"],["大力","だいりき"],["は"],["どこ"],["に"],["ある"],["の"],["か"],["、"],["また"],["どう"],["すれば"],["あなた"],["を"],["縛って","しばって"],["苦しめる","くるしめる"],["こと"],["が"],["できる"],["か"],["、"],["どうぞ"],["わたし"],["に"],["聞かせて","きかせて"],["ください"],["」"],["。"]]},{"verse":7,"text":"サムソンは女,おんなに言,いった、「人々,ひとびとがもし、かわいたことのない七本,ほんの新,あたらしい弓弦,ゆみづるをもってわたしを縛,しばるなら、わたしは弱,よわくなってほかの人,ひとのようになるでしょう」。","tok":[["サムソン"],["は"],["女","おんな"],["に"],["言った","いった"],["、"],["「"],["人々","ひとびと"],["が"],["もし"],["、"],["かわいた"],["こと"],["の"],["ない"],["七本","ほん"],["の"],["新らしい","あたらしい"],["弓弦","ゆみづる"],["を"],["もって"],["わたし"],["を"],["縛るなら","しばるなら"],["、"],["わたし"],["は"],["弱く","よわく"],["なって"],["ほか"],["の"],["人","ひと"],["の"],["よう"],["に"],["なるでしょう"],["」"],["。"]]},{"verse":8,"text":"そこでペリシテびとの君,きみたちが、かわいたことのない七本,ほんの新,あたらしい弓弦,ゆみづるを女,おんなに持,もってきたので、女,おんなはそれをもってサムソンを縛,しばった。","tok":[["そこ"],["で"],["ペリシテ"],["びと"],["の"],["君","きみ"],["たち"],["が"],["、"],["かわいた"],["こと"],["の"],["ない"],["七本","ほん"],["の"],["新らしい","あたらしい"],["弓弦","ゆみづる"],["を"],["女","おんな"],["に"],["持って","もって"],["きた"],["ので"],["、"],["女","おんな"],["は"],["それ"],["を"],["もって"],["サムソン"],["を"],["縛った","しばった"],["。"]]},{"verse":9,"text":"女,おんなはかねて奥,おくのへやに人,ひとを忍,しのばせておいて、サムソンに言,いった、「サムソンよ、ペリシテびとがあなたに迫,せまっています」。しかしサムソンはその弓弦,ゆみづるを、あたかも亜麻,あま糸,いとが火,ひにあって断,たたれるように断,たち切,きった。こうして彼,かれの力,ちからの秘密,ひみつは知,しれなかった。","tok":[["女","おんな"],["は"],["かねて"],["奥","おく"],["の"],["へや"],["に"],["人","ひと"],["を"],["忍ばせて","しのばせて"],["おいて"],["、"],["サムソン"],["に"],["言った","いった"],["、"],["「"],["サムソン"],["よ"],["、"],["ペリシテ"],["びと"],["が"],["あなた"],["に"],["迫まって","せまって"],["います"],["」"],["。"],["しかし"],["サムソン"],["は"],["その"],["弓弦","ゆみづる"],["を"],["、"],["あたかも"],["亜麻","あま"],["糸","いと"],["が"],["火","ひ"],["に"],["あって"],["断たれる","たたれる"],["よう"],["に"],["断ち切った","たちきった"],["。"],["こう"],["して"],["彼","かれ"],["の"],["力","ちから"],["の"],["秘密","ひみつ"],["は"],["知れなかった","しれなかった"],["。"]]},{"verse":10,"text":"デリラはサムソンに言,いった、「あなたはわたしを欺,あざむいて、うそを言,いいました。どうしたらあなたを縛,しばることができるか、どうぞ今,いまわたしに聞,きかせてください」。","tok":[["デリラ"],["は"],["サムソン"],["に"],["言った","いった"],["、"],["「"],["あなた"],["は"],["わたし"],["を"],["欺いて","あざむいて"],["、"],["うそ"],["を"],["言いました","いいました"],["。"],["どう"],["したら"],["あなた"],["を"],["縛る","しばる"],["こと"],["が"],["できる"],["か"],["、"],["どうぞ"],["今","いま"],["わたし"],["に"],["聞かせて","きかせて"],["ください"],["」"],["。"]]},{"verse":11,"text":"サムソンは女,おんなに言,いった、「もし人々,ひとびとがまだ用,もちいたことのない新,あたらしい綱,つなをもって、わたしを縛,しばるなら、弱,よわくなってほかの人,ひとのようになるでしょう」。","tok":[["サムソン"],["は"],["女","おんな"],["に"],["言った","いった"],["、"],["「"],["もし"],["人々","ひとびと"],["が"],["まだ"],["用いた","もちいた"],["こと"],["の"],["ない"],["新らしい","あたらしい"],["綱","つな"],["を"],["もって"],["、"],["わたし"],["を"],["縛るなら","しばるなら"],["、"],["弱く","よわく"],["なって"],["ほか"],["の"],["人","ひと"],["の"],["よう"],["に"],["なるでしょう"],["」"],["。"]]},{"verse":12,"text":"そこでデリラは新,あたらしい綱,つなをとり、それをもって彼,かれを縛,しばり、そして彼,かれに言,いった、「サムソンよ、ペリシテびとがあなたに迫,せまっています」。時,ときに人々,ひとびとは奥,おくのへやに忍,しのんでいたが、サムソンはその綱,つなを糸,いとのように腕,うでから断,たち落,おとした。","tok":[["そこ"],["で"],["デリラ"],["は"],["新らしい","あたらしい"],["綱","つな"],["を"],["とり"],["、"],["それ"],["を"],["もって"],["彼","かれ"],["を"],["縛り","しばり"],["、"],["そして"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["サムソン"],["よ"],["、"],["ペリシテ"],["びと"],["が"],["あなた"],["に"],["迫まって","せまって"],["います"],["」"],["。"],["時","とき"],["に"],["人々","ひとびと"],["は"],["奥","おく"],["の"],["へや"],["に"],["忍んで","しのんで"],["いた"],["が"],["、"],["サムソン"],["は"],["その"],["綱","つな"],["を"],["糸","いと"],["の"],["よう"],["に"],["腕","うで"],["から"],["断ち落とした","たちおとした"],["。"]]},{"verse":13,"text":"そこでデリラはサムソンに言,いった、「あなたは今,いままで、わたしを欺,あざむいて、うそを言,いいましたが、どうしたらあなたを縛,しばることができるか、わたしに聞,きかせてください」。彼,かれは女,おんなに言,いった、「あなたがもし、わたしの髪,かみの毛,け七ふさを機,はたの縦糸,たていとと一緒,いっしょに織,おって、くぎでそれを留,とめておくならば、わたしは弱,よわくなってほかの人,ひとのようになるでしょう」。そこで彼,かれが眠,ねむったとき、デリラはサムソンの髪,かみの毛,け、七ふさをとって、それを機,はたの縦糸,たていとに織,おり込,こみ、","tok":[["そこ"],["で"],["デリラ"],["は"],["サムソン"],["に"],["言った","いった"],["、"],["「"],["あなた"],["は"],["今まで","いままで"],["、"],["わたし"],["を"],["欺いて","あざむいて"],["、"],["うそ"],["を"],["言いました","いいました"],["が"],["、"],["どう"],["したら"],["あなた"],["を"],["縛る","しばる"],["こと"],["が"],["できる"],["か"],["、"],["わたし"],["に"],["聞かせて","きかせて"],["ください"],["」"],["。"],["彼","かれ"],["は"],["女","おんな"],["に"],["言った","いった"],["、"],["「"],["あなた"],["が"],["もし"],["、"],["わたし"],["の"],["髪の毛","かみのけ"],["七","なな"],["ふさ"],["を"],["機","はた"],["の"],["縦糸","たていと"],["と"],["一緒","いっしょ"],["に"],["織って","おって"],["、"],["くぎ"],["で"],["それ"],["を"],["留","とめ"],["て"],["おくならば"],["、"],["わたし"],["は"],["弱く","よわく"],["なって"],["ほか"],["の"],["人","ひと"],["の"],["よう"],["に"],["なるでしょう"],["」"],["。"],["そこ"],["で"],["彼","かれ"],["が"],["眠った","ねむった"],["とき"],["、"],["デリラ"],["は"],["サムソン"],["の"],["髪の毛","かみのけ"],["、"],["七","なな"],["ふさ"],["を"],["とって"],["、"],["それ"],["を"],["機","はた"],["の"],["縦糸","たていと"],["に"],["織","おり"],["込","こみ"],["、"]]},{"verse":14,"text":"くぎでそれを留,とめておいて、彼,かれに言,いった、「サムソンよ、ペリシテびとがあなたに迫,せまっています」。しかしサムソンは目,めをさまして、くぎと機,はたと縦糸,たていととを引,ひき抜,ぬいた。","tok":[["くぎ"],["で"],["それ"],["を"],["留","とめ"],["て"],["おいて"],["、"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["サムソン"],["よ"],["、"],["ペリシテ"],["びと"],["が"],["あなた"],["に"],["迫まって","せまって"],["います"],["」"],["。"],["しかし"],["サムソン"],["は"],["目","め"],["を"],["さまして"],["、"],["くぎ"],["と"],["機","はた"],["と"],["縦糸","たていと"],["と"],["を"],["引抜いた","ひきぬいた"],["。"]]},{"verse":15,"text":"そこで女,おんなはサムソンに言,いった、「あなたの心,こころがわたしを離,はなれているのに、どうして『おまえを愛,あいする』と言,いうことができますか。あなたはすでに三度,どもわたしを欺,あざむき、あなたの大力,だいりきがどこにあるかをわたしに告,つげませんでした」。","tok":[["そこ"],["で"],["女","おんな"],["は"],["サムソン"],["に"],["言った","いった"],["、"],["「"],["あなた"],["の"],["心","こころ"],["が"],["わたし"],["を"],["離れて","はなれて"],["いる"],["のに"],["、"],["どう"],["して"],["『"],["おまえ"],["を"],["愛する","あいする"],["』"],["と"],["言う","いう"],["こと"],["が"],["できます"],["か"],["。"],["あなた"],["は"],["すでに"],["三","さん"],["度","ど"],["も"],["わたし"],["を"],["欺き","あざむき"],["、"],["あなた"],["の"],["大力","だいりき"],["が"],["どこ"],["に"],["ある"],["か"],["を"],["わたし"],["に"],["告","つげ"],["ませんでした"],["」"],["。"]]},{"verse":16,"text":"女,おんなは毎日,まいにちその言葉,ことばをもって彼,かれに迫,せまり促,うながしたので、彼,かれの魂,たましいは死,しぬばかりに苦,くるしんだ。","tok":[["女","おんな"],["は"],["毎日","まいにち"],["その"],["言葉","ことば"],["を"],["もって"],["彼","かれ"],["に"],["迫まり","せまり"],["促がした","うながした"],["ので"],["、"],["彼","かれ"],["の"],["魂","たましい"],["は"],["死ぬ","しぬ"],["ばかり"],["に"],["苦しんだ","くるしんだ"],["。"]]},{"verse":17,"text":"彼,かれはついにその心,こころをことごとく打,うち明,あけて女,おんなに言,いった、「わたしの頭,あたまにはかみそりを当,あてたことがありません。わたしは生,うまれた時,ときから神,かみにささげられたナジルびとだからです。もし髪,かみをそり落,おとされたなら、わたしの力,ちからは去,さって弱,よわくなり、ほかの人,ひとのようになるでしょう」。","tok":[["彼","かれ"],["は"],["ついに"],["その"],["心","こころ"],["を"],["ことごとく"],["打ち明けて","うちあけて"],["女","おんな"],["に"],["言った","いった"],["、"],["「"],["わたし"],["の"],["頭","あたま"],["に"],["は"],["かみそり"],["を"],["当てた","あてた"],["こと"],["が"],["ありません"],["。"],["わたし"],["は"],["生まれた","うまれた"],["時","とき"],["から"],["神","かみ"],["に"],["ささげられた"],["ナジル"],["びと"],["だ"],["から"],["です"],["。"],["もし"],["髪","かみ"],["を"],["そり落とされたなら","そりおとされたなら"],["、"],["わたし"],["の"],["力","ちから"],["は"],["去て","さって"],["弱く","よわく"],["なり"],["、"],["ほか"],["の"],["人","ひと"],["の"],["よう"],["に"],["なるでしょう"],["」"],["。"]]},{"verse":18,"text":"デリラはサムソンがその心,こころをことごとく打,うち明,あけたのを見,み、人,ひとをつかわしてペリシテびとの君,きみたちを呼,よんで言,いった、「サムソンはその心,こころをことごとくわたしに打,うち明,あけましたから、今度,こんどこそ上,のぼっておいでなさい」。そこでペリシテびとの君,きみたちは、銀,ぎんを携,たずさえて女,おんなのもとに上,のぼってきた。","tok":[["デリラ"],["は"],["サムソン"],["が"],["その"],["心","こころ"],["を"],["ことごとく"],["打ち明けた","うちあけた"],["の"],["を"],["見","み"],["、"],["人","ひと"],["を"],["つかわして"],["ペリシテ"],["びと"],["の"],["君","きみ"],["たち"],["を"],["呼んで","よんで"],["言った","いった"],["、"],["「"],["サムソン"],["は"],["その"],["心","こころ"],["を"],["ことごとく"],["わたし"],["に"],["打ち明けました","うちあけました"],["から"],["、"],["今度","こんど"],["こそ"],["上って","のぼって"],["おいで"],["なさい"],["」"],["。"],["そこ"],["で"],["ペリシテ"],["びと"],["の"],["君","きみ"],["たち"],["は"],["、"],["銀","ぎん"],["を"],["携えて","たずさえて"],["女","おんな"],["の"],["もと"],["に"],["上って","のぼって"],["きた"],["。"]]},{"verse":19,"text":"女,おんなは自分,じぶんのひざの上,うえにサムソンを眠,ねむらせ、人,ひとを呼,よんで髪,かみの毛,け、七ふさをそり落,おとさせ、彼,かれを苦,くるしめ始,はじめたが、その力,ちからは彼,かれを去,さっていた。","tok":[["女","おんな"],["は"],["自分","じぶん"],["の"],["ひざ"],["の"],["上","うえ"],["に"],["サムソン"],["を"],["眠らせ","ねむらせ"],["、"],["人","ひと"],["を"],["呼んで","よんで"],["髪の毛","かみのけ"],["、"],["七","なな"],["ふさ"],["を"],["そり落とさせ","そりおとさせ"],["、"],["彼","かれ"],["を"],["苦しめ","くるしめ"],["始めた","はじめた"],["が"],["、"],["その"],["力","ちから"],["は"],["彼","かれ"],["を"],["去て","さって"],["いた"],["。"]]},{"verse":20,"text":"そして女,おんなが「サムソンよ、ペリシテびとがあなたに迫,せまっています」と言,いったので、彼,かれは目,めをさまして言,いった、「わたしはいつものように出,でて行,いって、からだをゆすろう」。彼,かれは主,しゅが自分,じぶんを去,さられたことを知,しらなかった。","tok":[["そして"],["女","おんな"],["が"],["「"],["サムソン"],["よ"],["、"],["ペリシテ"],["びと"],["が"],["あなた"],["に"],["迫まって","せまって"],["います"],["」"],["と"],["言った","いった"],["ので"],["、"],["彼","かれ"],["は"],["目","め"],["を"],["さまして"],["言った","いった"],["、"],["「"],["わたし"],["は"],["いつも"],["の"],["よう"],["に"],["出て","でて"],["行って","いって"],["、"],["からだ"],["を"],["ゆすろう"],["」"],["。"],["彼","かれ"],["は"],["主","しゅ"],["が"],["自分","じぶん"],["を"],["去られた","さられた"],["こと"],["を"],["知らなかった","しらなかった"],["。"]]},{"verse":21,"text":"そこでペリシテびとは彼,かれを捕,とらえて、両,りょう眼,めをえぐり、ガザに引,ひいて行,いって、青銅,せいどうの足,あしかせをかけて彼,かれをつないだ。こうしてサムソンは獄屋,ごくやの中,なかで、うすをひいていたが、","tok":[["そこ"],["で"],["ペリシテ"],["び"],["と"],["は"],["彼","かれ"],["を"],["捕らえて","とらえて"],["、"],["両眼","りょうめ"],["を"],["えぐり"],["、"],["ガザ"],["に"],["引いて","ひいて"],["行って","いって"],["、"],["青銅","せいどう"],["の"],["足かせ","あしかせ"],["を"],["かけて"],["彼","かれ"],["を"],["つないだ"],["。"],["こう"],["して"],["サムソン"],["は"],["獄屋","ごくや"],["の"],["中","なか"],["で"],["、"],["うす"],["を"],["ひいて"],["いた"],["が"],["、"]]},{"verse":22,"text":"その髪,かみの毛,けはそり落,おとされた後,のち、ふたたび伸,のび始,はじめた。","tok":[["その"],["髪の毛","かみのけ"],["は"],["そり落とされた","そりおとされた"],["後","の"],["ち"],["、"],["ふたたび"],["伸び","のび"],["始めた","はじめた"],["。"]]},{"verse":23,"text":"さてペリシテびとの君,きみたちは、彼,かれらの神,かみダゴンに大,おおいなる犠牲,ぎせいをささげて祝,しゅくをしようと、共,ともに集,あつまって言,いった、「われわれの神,かみは、敵,てきサムソンをわれわれの手,てにわたされた」。","tok":[["さて"],["ペリシテ"],["びと"],["の"],["君","きみ"],["たち"],["は"],["、"],["彼","かれ"],["ら"],["の"],["神","かみ"],["ダゴン"],["に"],["大いなる","おおいなる"],["犠牲","ぎせい"],["を"],["ささげて"],["祝","しゅく"],["を"],["しよう"],["と"],["、"],["共","とも"],["に"],["集まって","あつまって"],["言った","いった"],["、"],["「"],["われわれ"],["の"],["神","かみ"],["は"],["、"],["敵","てき"],["サムソン"],["を"],["われわれ"],["の"],["手","て"],["に"],["わたされた"],["」"],["。"]]},{"verse":24,"text":"民,たみはサムソンを見,みて、自分,じぶんたちの神,かみをほめたたえて言,いった、「われわれの神,かみは、われわれの国,くにを荒,あらし、われわれを多,おおく殺,ころした敵,てきをわれわれの手,てにわたされた」。","tok":[["民","たみ"],["は"],["サムソン"],["を"],["見て","みて"],["、"],["自分","じぶん"],["たち"],["の"],["神","かみ"],["を"],["ほめたたえて"],["言った","いった"],["、"],["「"],["われわれ"],["の"],["神","かみ"],["は"],["、"],["われわれ"],["の"],["国","くに"],["を"],["荒し","あらし"],["、"],["われわれ"],["を"],["多く","おおく"],["殺ろした","ころした"],["敵","てき"],["を"],["われわれ"],["の"],["手","て"],["に"],["わたされた"],["」"],["。"]]},{"verse":25,"text":"彼,かれらはまた心,こころに喜,よろこんで言,いった、「サムソンを呼,よんで、われわれのために戯,ざれ事,ごとをさせよう」。彼,かれらは獄屋,ごくやからサムソンを呼,よび出,だして、彼,かれらの前,まえに戯,ざれ事,ごとをさせた。彼,かれらがサムソンを柱,はしらのあいだに立,たたせると、","tok":[["彼","かれ"],["ら"],["は"],["また"],["心","こころ"],["に"],["喜こんで","よろこんで"],["言った","いった"],["、"],["「"],["サムソン"],["を"],["呼んで","よんで"],["、"],["われわれ"],["の"],["ため"],["に"],["戯れ事","ざれごと"],["を"],["させよう"],["」"],["。"],["彼","かれ"],["ら"],["は"],["獄屋","ごくや"],["から"],["サムソン"],["を"],["呼び出して","よびだして"],["、"],["彼","かれ"],["ら"],["の"],["前","まえ"],["に"],["戯れ事","ざれごと"],["を"],["させた"],["。"],["彼","かれ"],["ら"],["が"],["サムソン"],["を"],["柱","はしら"],["の"],["あいだ"],["に"],["立たせる","たたせる"],["と"],["、"]]},{"verse":26,"text":"サムソンは自分,じぶんの手,てをひいている若者,わかものに言,いった、「わたしの手,てを放,はなして、この家,いえをささえている柱,はしらをさぐらせ、それに寄,よりかからせてください」。","tok":[["サムソン"],["は"],["自分","じぶん"],["の"],["手","て"],["を"],["ひいて"],["いる"],["若者","わかもの"],["に"],["言った","いった"],["、"],["「"],["わたし"],["の"],["手","て"],["を"],["放して","はなして"],["、"],["この"],["家","いえ"],["を"],["ささえて"],["いる"],["柱","はしら"],["を"],["さぐらせ"],["、"],["それ"],["に"],["寄りかからせて","よりかからせて"],["ください"],["」"],["。"]]},{"verse":27,"text":"その家,いえには男女,だんじょが満,みち、ペリシテびとの君,きみたちも皆,みなそこにいた。また屋根,やねの上,うえには三千人,にんばかりの男女,だんじょがいて、サムソンの戯,ざれ事,ごとをするのを見,みていた。","tok":[["その"],["家","いえ"],["に"],["は"],["男女","だんじょ"],["が"],["満ち","みち"],["、"],["ペリシテ"],["びと"],["の"],["君","きみ"],["たち"],["も"],["皆","みな"],["そこ"],["に"],["いた"],["。"],["また"],["屋根","やね"],["の"],["上","うえ"],["に"],["は"],["三千人","にんばかり"],["の"],["男女","だんじょ"],["が"],["いて"],["、"],["サムソン"],["の"],["戯れ事","ざれごと"],["を"],["する"],["の"],["を"],["見て","みて"],["いた"],["。"]]},{"verse":28,"text":"サムソンは主,しゅに呼,よばわって言,いった、「ああ、主,しゅなる神,かみよ、どうぞ、わたしを覚,おぼえてください。ああ、神,かみよ、どうぞもう一度,ど、わたしを強,つよくして、わたしの二つの目,めの一つのためにでもペリシテびとにあだを報,むくいさせてください」。","tok":[["サムソン"],["は"],["主に","しゅに"],["呼ばわって","よばわって"],["言った","いった"],["、"],["「"],["ああ"],["、"],["主","しゅ"],["なる"],["神","かみ"],["よ"],["、"],["どうぞ"],["、"],["わたし"],["を"],["覚えて","おぼえて"],["ください"],["。"],["ああ"],["、"],["神","かみ"],["よ"],["、"],["どうぞ"],["もう"],["一度","ど"],["、"],["わたし"],["を"],["強く","つよく"],["して"],["、"],["わたし"],["の"],["二","ふた"],["つ"],["の"],["目","め"],["の"],["一","ひと"],["つ"],["の"],["ため"],["に"],["で"],["も"],["ペリシテ"],["びと"],["に"],["あだ"],["を"],["報いさせて","むくいさせて"],["ください"],["」"],["。"]]},{"verse":29,"text":"そしてサムソンは、その家,いえをささえている二つの中,なか柱,はしらの一つを右,みぎの手,てに、一つを左,ひだりの手,てにかかえて、身,みをそれに寄,よせ、","tok":[["そして"],["サムソン"],["は"],["、"],["その"],["家","いえ"],["を"],["ささえて"],["いる"],["二","ふた"],["つ"],["の"],["中","なか"],["柱","はしら"],["の"],["一","ひと"],["つ"],["を"],["右","みぎ"],["の"],["手","て"],["に"],["、"],["一","ひと"],["つ"],["を"],["左","ひだり"],["の"],["手","て"],["に"],["かかえて"],["、"],["身","み"],["を"],["それ"],["に"],["寄せ","よせ"],["、"]]},{"verse":30,"text":"「わたしはペリシテびとと共,ともに死,しのう」と言,いって、力,ちからをこめて身,みをかがめると、家,いえはその中,なかにいた君,きみたちと、すべての民,たみの上,うえに倒,たおれた。こうしてサムソンが死,しぬときに殺,ころしたものは、生,いきているときに殺,ころしたものよりも多,おおかった。","tok":[["「"],["わたし"],["は"],["ペリシテ"],["びと"],["と"],["共","とも"],["に"],["死のう","しのう"],["」"],["と"],["言って","いって"],["、"],["力","ちから"],["を"],["こめて"],["身","み"],["を"],["かがめる"],["と"],["、"],["家","いえ"],["は"],["その"],["中","なか"],["に"],["いた"],["君","きみ"],["たち"],["と"],["、"],["すべて"],["の"],["民","たみ"],["の"],["上","うえ"],["に"],["倒れた","たおれた"],["。"],["こう"],["して"],["サムソン"],["が"],["死ぬ","しぬ"],["とき"],["に"],["殺ろした","ころした"],["もの"],["は"],["、"],["生きて","いきて"],["いる"],["とき"],["に"],["殺ろした","ころした"],["もの"],["より"],["も"],["多かった","おおかった"],["。"]]},{"verse":31,"text":"やがて彼,かれの身内,みうちの人,ひとたちおよび父,ちちの家族,かぞくの者,ものがみな下,くだってきて、彼,かれを引,ひき取,とり、携,たずさえ上,のぼって、ゾラとエシタオルの間,あいだにある父,ちちマノアの墓,はかに葬,ほうむった。サムソンがイスラエルをさばいたのは二十年,ねんであった。","tok":[["やがて"],["彼","かれ"],["の"],["身内","みうち"],["の"],["人","ひと"],["たち"],["および"],["父","ちち"],["の"],["家族","かぞく"],["の"],["者","もの"],["が"],["みな"],["下って","くだって"],["きて"],["、"],["彼","かれ"],["を"],["引取","ひきとり"],["、"],["携え","たずさえ"],["上","のぼ"],["って"],["、"],["ゾラ"],["と"],["エシタオル"],["の"],["間","あいだ"],["に"],["ある"],["父","ちち"],["マノア"],["の"],["墓","はか"],["に"],["葬むった","ほうむった"],["。"],["サムソン"],["が"],["イスラエル"],["を"],["さばいた"],["の"],["は"],["二十","にじゅう"],["年","ねん"],["で"],["あった"],["。"]]}]
[{"verse":1,"text":"ヨシュアが死,しんだ後,のち、イスラエルの人々,ひとびとは主,しゅに問,とうて言,いった、「わたしたちのうち、だれが先,さきに攻,せめ上,のぼって、カナンびとと戦,たたかいましょうか」。","tok":[["ヨシュア"],["が"],["死んだ","しんだ"],["後","の"],["ち"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["主に","しゅに"],["問うて","とうて"],["言った","いった"],["、"],["「"],["わたしたち"],["の"],["うち"],["、"],["だれ"],["が"],["先","さき"],["に"],["攻め上って","せめのぼって"],["、"],["カナン"],["びと"],["と"],["戦いましょう","たたかいましょう"],["か"],["」"],["。"]]},{"verse":2,"text":"主,しゅは言,いわれた、「ユダが上,のぼるべきである。わたしはこの国,くにを彼,かれの手,てにわたした」。","tok":[["主","しゅ"],["は"],["言われた","いわれた"],["、"],["「"],["ユダ"],["が"],["上るべきで","のぼるべきで"],["ある"],["。"],["わたし"],["は"],["この"],["国","くに"],["を"],["彼","かれ"],["の"],["手","て"],["に"],["わたした"],["」"],["。"]]},{"verse":3,"text":"ユダはその兄弟,きょうだいシメオンに言,いった、「わたしと一緒,いっしょに、わたしに割,わり当,あてられた領地,りょうちへ上,のぼって行,いって、カナンびとと戦,たたかってください。そうすればわたしもあなたと一緒,いっしょに、あなたに割,わり当,あてられた領地,りょうちへ行,いきましょう」。そこでシメオンは彼,かれと一緒,いっしょに行,いった。","tok":[["ユダ"],["は"],["その"],["兄弟","きょうだい"],["シメオン"],["に"],["言った","いった"],["、"],["「"],["わたし"],["と"],["一緒","いっしょ"],["に"],["、"],["わたし"],["に"],["割当られた","わりあてられた"],["領地","りょうち"],["へ"],["上って","のぼって"],["行って","いって"],["、"],["カナン"],["びと"],["と"],["戦って","たたかって"],["ください"],["。"],["そう"],["すれば"],["わたし"],["も"],["あなた"],["と"],["一緒","いっしょ"],["に"],["、"],["あなた"],["に"],["割当られた","わりあてられた"],["領地","りょうち"],["へ"],["行きましょう","いきましょう"],["」"],["。"],["そこ"],["で"],["シメオン"],["は"],["彼","かれ"],["と"],["一緒","いっしょ"],["に"],["行った","いった"],["。"]]},{"verse":4,"text":"ユダが上,のぼって行,いくと、主,しゅは彼,かれらの手,てにカナンびととペリジびととをわたされたので、彼,かれらはベゼクで一万人,にんを撃,うち破,やぶり、","tok":[["ユダ"],["が"],["上って","のぼって"],["行く","いく"],["と"],["、"],["主","しゅ"],["は"],["彼","かれ"],["ら"],["の"],["手","て"],["に"],["カナン"],["びと"],["と"],["ペリジ"],["びと"],["と"],["を"],["わたされた"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["ベゼク"],["で"],["一万人","にん"],["を"],["撃ち破り","うちやぶり"],["、"]]},{"verse":5,"text":"またベゼクでアドニベゼクに会,あい、彼,かれと戦,たたかってカナンびととペリジびととを撃,うち破,やぶった。","tok":[["また"],["ベゼク"],["で"],["アドニベゼク"],["に"],["会い","あい"],["、"],["彼","かれ"],["と"],["戦って","たたかって"],["カナン"],["びと"],["と"],["ペリジ"],["びと"],["と"],["を"],["撃ち破った","うちやぶった"],["。"]]},{"verse":6,"text":"アドニベゼクは逃,にげたが、彼,かれらはそのあとを追,おって彼,かれを捕,とらえ、その手足,てあしの親指,おやゆびを切,きり放,はなった。","tok":[["アドニベゼク"],["は"],["逃た","にげた"],["が"],["、"],["彼","かれ"],["ら"],["は"],["その"],["あと"],["を"],["追って","おって"],["彼","かれ"],["を"],["捕らえ","とらえ"],["、"],["その"],["手足","てあし"],["の"],["親指","おやゆび"],["を"],["切り放った","きりはなった"],["。"]]},{"verse":7,"text":"アドニベゼクは言,いった、「かつて七十人,にんの王,おうたちが手足,てあしの親指,おやゆびを切,きられて、わたしの食卓,しょくたくの下,したで、くずを拾,ひろったことがあったが、神,かみはわたしがしたように、わたしに報,むくいられたのだ」。人々,ひとびとは彼,かれをエルサレムへ連,つれて行,いったが、彼,かれはそこで死,しんだ。","tok":[["アドニベゼク"],["は"],["言った","いった"],["、"],["「"],["かつて"],["七","なな"],["十人","じゅうにん"],["の"],["王","おう"],["たち"],["が"],["手足","てあし"],["の"],["親指","おやゆび"],["を"],["切られて","きられて"],["、"],["わたし"],["の"],["食卓","しょくたく"],["の"],["下","した"],["で"],["、"],["くず"],["を"],["拾った","ひろった"],["こと"],["が"],["あった"],["が"],["、"],["神","かみ"],["は"],["わたし"],["が"],["した"],["よう"],["に"],["、"],["わたし"],["に"],["報いられた","むくいられた"],["の"],["だ"],["」"],["。"],["人々","ひとびと"],["は"],["彼","かれ"],["を"],["エルサレム"],["へ"],["連れて","つれて"],["行った","いった"],["が"],["、"],["彼","かれ"],["は"],["そこ"],["で"],["死んだ","しんだ"],["。"]]},{"verse":8,"text":"ユダの人々,ひとびとはエルサレムを攻,せめて、これを取,とり、つるぎをもってこれを撃,うち、町,まちに火,ひを放,はなった。","tok":[["ユダ"],["の"],["人々","ひとびと"],["は"],["エルサレム"],["を"],["攻めて","せめて"],["、"],["これ"],["を"],["取","とり"],["、"],["つるぎ"],["を"],["もって"],["これ"],["を"],["撃ち","うち"],["、"],["町","まち"],["に"],["火","ひ"],["を"],["放った","はなった"],["。"]]},{"verse":9,"text":"その後,のち、ユダの人々,ひとびとは山地,さんちとネゲブと平地,へいちに住,すんでいるカナンびとと戦,たたかうために下,くだったが、","tok":[["その後","そのの"],["ち"],["、"],["ユダ"],["の"],["人々","ひとびと"],["は"],["山地","さんち"],["と"],["ネゲブ"],["と"],["平地","へいち"],["に"],["住んで","すんで"],["いる"],["カナン"],["びと"],["と"],["戦う","たたかう"],["ため"],["に"],["下った","くだった"],["が"],["、"]]},{"verse":10,"text":"ユダはまずヘブロンに住,すんでいるカナンびとを攻,せめて、セシャイとアヒマンとタルマイを撃,うち破,やぶった。ヘブロンのもとの名,なはキリアテ・アルバであった。","tok":[["ユダ"],["は"],["まず"],["ヘブロン"],["に"],["住んで","すんで"],["いる"],["カナン"],["びと"],["を"],["攻めて","せめて"],["、"],["セシャイ"],["と"],["アヒマン"],["と"],["タルマイ"],["を"],["撃ち破った","うちやぶった"],["。"],["ヘブロン"],["の"],["もと"],["の"],["名","な"],["は"],["キリアテ"],["・"],["アルバ"],["で"],["あった"],["。"]]},{"verse":11,"text":"またそこから進,すすんでデビルの住民,じゅうみんを攻,せめた。（デビルのもとの名,なはキリアテ・セペルであった。）","tok":[["また"],["そこ"],["から"],["進んで","すすんで"],["デビル"],["の"],["住民","じゅうみん"],["を"],["攻めた","せめた"],["。"],["（"],["デビル"],["の"],["もと"],["の"],["名","な"],["は"],["キリアテ"],["・"],["セペル"],["で"],["あった"],["。"],["）"]]},{"verse":12,"text":"時,ときにカレブは言,いった、「キリアテ・セペルを撃,うって、これを取,とる者,ものには、わたしの娘,むすめアクサを妻,つまとして与,あたえるであろう」。","tok":[["時","とき"],["に"],["カレブ"],["は"],["言った","いった"],["、"],["「"],["キリアテ"],["・"],["セペル"],["を"],["撃って","うって"],["、"],["これ"],["を"],["取る","とる"],["者","もの"],["に"],["は"],["、"],["わたし"],["の"],["娘","むすめ"],["アクサ"],["を"],["妻","つま"],["として"],["与えるで","あたえるで"],["あろう"],["」"],["。"]]},{"verse":13,"text":"カレブの弟,おとうとケナズの子,こオテニエルがそれを取,とったので、カレブは娘,むすめアクサを妻,つまとして彼,かれに与,あたえた。","tok":[["カレブ"],["の"],["弟","おとうと"],["ケナズ"],["の"],["子","こ"],["オテニエル"],["が"],["それ"],["を"],["取った","とった"],["ので"],["、"],["カレブ"],["は"],["娘","むすめ"],["アクサ"],["を"],["妻","つま"],["として"],["彼","かれ"],["に"],["与","あたえ"],["た"],["。"]]},{"verse":14,"text":"アクサは行,いくとき彼女,かのじょの父,ちちに畑,はたけを求,もとめることを夫,おっとにすすめられたので、アクサがろばから降,おりると、カレブは彼女,かのじょに言,いった、「あなたは何,なにを望,のぞむのか」。","tok":[["アクサ"],["は"],["行く","いく"],["とき"],["彼女","かのじょ"],["の"],["父","ちち"],["に"],["畑","はたけ"],["を"],["求める","もとめる"],["こと"],["を"],["夫","おっと"],["に"],["すすめられた"],["ので"],["、"],["アクサ"],["が"],["ろば"],["から"],["降りる","おりる"],["と"],["、"],["カレブ"],["は"],["彼女","かのじょ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["は"],["何に","なに"],["を"],["望む","のぞむ"],["の"],["か"],["」"],["。"]]},{"verse":15,"text":"アクサは彼,かれに言,いった、「わたしに贈,おくり物,ものをください。あなたはわたしをネゲブの地,ちへやられるのですから、泉,いずみをもください」。それでカレブは上,うえの泉,いずみと下,したの泉,いずみとを彼女,かのじょに与,あたえた。","tok":[["アクサ"],["は"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["わたし"],["に"],["贈り物","おくりもの"],["を"],["ください"],["。"],["あなた"],["は"],["わたし"],["を"],["ネゲブ"],["の"],["地","ち"],["へ"],["やられる"],["の"],["です"],["から"],["、"],["泉","いずみ"],["を"],["も"],["ください"],["」"],["。"],["それ"],["で"],["カレブ"],["は"],["上","うえ"],["の"],["泉","いずみ"],["と"],["下","した"],["の"],["泉","いずみ"],["と"],["を"],["彼女","かのじょ"],["に"],["与","あたえ"],["た"],["。"]]},{"verse":16,"text":"モーセのしゅうとであるケニびとの子孫,しそんはユダの人々,ひとびとと共,ともに、しゅろの町,まちからアラドに近,ちかいネゲブにあるユダの野,のに上,のぼってきて、アマレクびとと共,ともに住,すんだ。","tok":[["モーセ"],["の"],["しゅうと"],["で"],["ある"],["ケニ"],["びと"],["の"],["子孫","しそん"],["は"],["ユダ"],["の"],["人々","ひとびと"],["と"],["共","とも"],["に"],["、"],["しゅろ"],["の"],["町","まち"],["から"],["アラド"],["に"],["近い","ちかい"],["ネゲブ"],["に"],["ある"],["ユダ"],["の"],["野","の"],["に"],["上って","のぼって"],["きて"],["、"],["アマレク"],["びと"],["と"],["共","とも"],["に"],["住んだ","すんだ"],["。"]]},{"verse":17,"text":"そしてユダはその兄弟,きょうだいシメオンと共,ともに行,いって、ゼパテに住,すんでいたカナンびとを撃,うち、それをことごとく滅,ほろぼした。これによってその町,まちの名,なはホルマと呼,よばれた。","tok":[["そして"],["ユダ"],["は"],["その"],["兄弟","きょうだい"],["シメオン"],["と"],["共","とも"],["に"],["行って","いって"],["、"],["ゼパテ"],["に"],["住んで","すんで"],["いた"],["カナン"],["びと"],["を"],["撃ち","うち"],["、"],["それ"],["を"],["ことごとく"],["滅ぼした","ほろぼした"],["。"],["これ"],["によって"],["その"],["町","まち"],["の"],["名","な"],["は"],["ホルマ"],["と"],["呼ばれた","よばれた"],["。"]]},{"verse":18,"text":"ユダはまたガザとその地域,ちいき、アシケロンとその地域,ちいき、エクロンとその地域,ちいきを取,とった。","tok":[["ユダ"],["は"],["また"],["ガザ"],["と"],["その"],["地域","ちいき"],["、"],["アシケロン"],["と"],["その"],["地域","ちいき"],["、"],["エクロン"],["と"],["その"],["地域","ちいき"],["を"],["取った","とった"],["。"]]},{"verse":19,"text":"主,しゅがユダと共,ともにおられたので、ユダはついに山地,さんちを手,てに入,いれたが、平地,へいちに住,すんでいた民,たみは鉄,てつの戦車,せんしゃをもっていたので、これを追,おい出,だすことができなかった。","tok":[["主","しゅ"],["が"],["ユダ"],["と"],["共","とも"],["に"],["おられた"],["ので"],["、"],["ユダ"],["は"],["ついに"],["山地","さんち"],["を"],["手","て"],["に"],["入れた","いれた"],["が"],["、"],["平地","へいち"],["に"],["住んで","すんで"],["いた"],["民","たみ"],["は"],["鉄","てつ"],["の"],["戦車","せんしゃ"],["を"],["もって"],["いた"],["ので"],["、"],["これ"],["を"],["追い出す","おいだす"],["こと"],["が"],["できなかった"],["。"]]},{"verse":20,"text":"人々,ひとびとはモーセがかつて言,いったように、ヘブロンをカレブに与,あたえたので、カレブはその所,ところからアナクの三人,にんの子,こを追,おい出,だした。","tok":[["人々","ひとびと"],["は"],["モーセ"],["が"],["かつて"],["言った","いった"],["よう"],["に"],["、"],["ヘブロン"],["を"],["カレブ"],["に"],["与","あたえ"],["た"],["ので"],["、"],["カレブ"],["は"],["その"],["所","ところ"],["から"],["アナク"],["の"],["三人","にん"],["の"],["子","こ"],["を"],["追い出した","おいだした"],["。"]]},{"verse":21,"text":"ベニヤミンの人々,ひとびとはエルサレムに住,すんでいたエブスびとを追,おい出,ださなかったので、エブスびとは今日,こんにちまでベニヤミンの人々,ひとびとと共,ともにエルサレムに住,すんでいる。","tok":[["ベニヤミン"],["の"],["人々","ひとびと"],["は"],["エルサレム"],["に"],["住んで","すんで"],["いた"],["エブス"],["びと"],["を"],["追い出さなかった","おいださなかった"],["ので"],["、"],["エブス"],["びと"],["は"],["今日","こん"],["に"],["ち"],["まで"],["ベニヤミン"],["の"],["人々","ひとびと"],["と"],["共","とも"],["に"],["エルサレム"],["に"],["住んで","すんで"],["いる"],["。"]]},{"verse":22,"text":"ヨセフの一族,いちぞくはまたベテルに攻,せめ上,のぼったが、主,しゅは彼,かれらと共,ともにおられた。","tok":[["ヨセフ"],["の"],["一族","いちぞく"],["は"],["また"],["ベテル"],["に"],["攻め上った","せめのぼった"],["が"],["、"],["主","しゅ"],["は"],["彼","かれ"],["ら"],["と"],["共","とも"],["に"],["おられた"],["。"]]},{"verse":23,"text":"すなわちヨセフの一族,いちぞくは人,ひとをやってベテルを探,さぐらせた。この町,まちのもとの名,なはルズであった。","tok":[["すなわち"],["ヨセフ"],["の"],["一族","いちぞく"],["は"],["人","ひと"],["を"],["やって"],["ベテル"],["を"],["探ぐらせた","さぐらせた"],["。"],["この"],["町","まち"],["の"],["もと"],["の"],["名","な"],["は"],["ルズ"],["で"],["あった"],["。"]]},{"verse":24,"text":"その斥候,せっこうたちは町,まちから出,でてきた人,ひとを見,みて、言,いった、「どうぞこの町,まちにはいる道,みちを教,おしえてください。そうすればわたしたちはあなたに恵,めぐみを施,ほどこしましょう」。","tok":[["その"],["斥候","せっこう"],["たち"],["は"],["町","まち"],["から"],["出て","でて"],["きた"],["人","ひと"],["を"],["見て","みて"],["、"],["言った","いった"],["、"],["「"],["どうぞ"],["この"],["町","まち"],["に"],["はいる"],["道","みち"],["を"],["教えて","おしえて"],["ください"],["。"],["そう"],["すれば"],["わたしたち"],["は"],["あなた"],["に"],["恵","めぐみ"],["を"],["施しましょう","ほどこしましょう"],["」"],["。"]]},{"verse":25,"text":"彼,かれが町,まちにはいる道,みちを教,おしえたので、彼,かれらはつるぎをもって町,まちを撃,うった。しかし、かの人,ひととその家族,かぞくは自由,じゆうに去,さらせた。","tok":[["彼","かれ"],["が"],["町","まち"],["に"],["はいる"],["道","みち"],["を"],["教えた","おしえた"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["つるぎ"],["を"],["もって"],["町","まち"],["を"],["撃った","うった"],["。"],["しかし"],["、"],["かの"],["人","ひと"],["と"],["その"],["家族","かぞく"],["は"],["自由","じゆう"],["に"],["去らせた","さらせた"],["。"]]},{"verse":26,"text":"その人,ひとはヘテびとの地,ちに行,いって町,まちを建,たて、それをルズと名,なづけた。これは今日,こんにちまでその名,なである。","tok":[["その"],["人","ひと"],["は"],["ヘテ"],["びと"],["の"],["地","ち"],["に"],["行って","いって"],["町","まち"],["を"],["建て","たて"],["、"],["それ"],["を"],["ルズ"],["と"],["名づけた","なづけた"],["。"],["これ"],["は"],["今日","こんにちまでそ"],["の"],["名","な"],["で"],["ある"],["。"]]},{"verse":27,"text":"マナセはベテシャンとその村里,むらざとの住民,じゅうみん、タアナクとその村里,むらざとの住民,じゅうみん、ドルとその村里,むらざとの住民,じゅうみん、イブレアムとその村里,むらざとの住民,じゅうみん、メギドとその村里,むらざとの住民,じゅうみんを追,おい出,ださなかったので、カナンびとは引,ひき続,つづいてその地,ちに住,すんでいたが、","tok":[["マナセ"],["は"],["ベテシャン"],["と"],["その"],["村里","むらざと"],["の"],["住民","じゅうみん"],["、"],["タアナク"],["と"],["その"],["村里","むらざと"],["の"],["住民","じゅうみん"],["、"],["ドル"],["と"],["その"],["村里","むらざと"],["の"],["住民","じゅうみん"],["、"],["イブレアム"],["と"],["その"],["村里","むらざと"],["の"],["住民","じゅうみん"],["、"],["メギド"],["と"],["その"],["村里","むらざと"],["の"],["住民","じゅうみん"],["を"],["追い出さなかった","おいださなかった"],["ので"],["、"],["カナン"],["びと"],["は"],["引続いて","ひきつづいて"],["その"],["地","ち"],["に"],["住んで","すんで"],["いた"],["が"],["、"]]},{"verse":28,"text":"イスラエルは強,つよくなったとき、カナンびとを強制,きょうせい労働,ろうどうに服,ふくさせ、彼,かれらをことごとくは追,おい出,ださなかった。","tok":[["イスラエル"],["は"],["強く","つよく"],["なった"],["とき"],["、"],["カナン"],["びと"],["を"],["強制","きょうせい"],["労働","ろうどう"],["に"],["服させ","ふくさせ"],["、"],["彼","かれ"],["ら"],["を"],["ことごとく"],["は"],["追い出さなかった","おいださなかった"],["。"]]},{"verse":29,"text":"またエフライムはゲゼルに住,すんでいたカナンびとを追,おい出,ださなかったので、カナンびとはゲゼルにおいて彼,かれらのうちに住,すんでいた。","tok":[["また"],["エフライム"],["は"],["ゲゼル"],["に"],["住んで","すんで"],["いた"],["カナン"],["びと"],["を"],["追い出さなかった","おいださなかった"],["ので"],["、"],["カナン"],["びと"],["は"],["ゲゼル"],["に"],["おいて"],["彼","かれ"],["ら"],["の"],["うち"],["に"],["住んで","すんで"],["いた"],["。"]]},{"verse":30,"text":"ゼブルンはキテロンの住民,じゅうみんおよびナハラルの住民,じゅうみんを追,おい出,ださなかったので、カナンびとは彼,かれらのうちに住,すんで強制,きょうせい労働,ろうどうに服,ふくした。","tok":[["ゼブルン"],["は"],["キテロン"],["の"],["住民","じゅうみん"],["および"],["ナハラル"],["の"],["住民","じゅうみん"],["を"],["追い出さなかった","おいださなかった"],["ので"],["、"],["カナン"],["びと"],["は"],["彼","かれ"],["ら"],["の"],["うち"],["に"],["住んで","すんで"],["強制","きょうせい"],["労働","ろうどう"],["に"],["服した","ふくした"],["。"]]},{"verse":31,"text":"アセルはアッコの住民,じゅうみんおよびシドン、アヘラブ、アクジブ、ヘルバ、アピク、レホブの住民,じゅうみんを追,おい出,ださなかったので、","tok":[["アセル"],["は"],["アッコ"],["の"],["住民","じゅうみん"],["および"],["シドン"],["、"],["アヘラブ"],["、"],["アクジブ"],["、"],["ヘルバ"],["、"],["アピク"],["、"],["レホブ"],["の"],["住民","じゅうみん"],["を"],["追い出さなかった","おいださなかった"],["ので"],["、"]]},{"verse":32,"text":"アセルびとは、その地,ちの住民,じゅうみんであるカナンびとのうちに住,すんでいた。彼,かれらが追,おい出,ださなかったからである。","tok":[["アセル"],["び"],["と"],["は"],["、"],["その"],["地","ち"],["の"],["住民","じゅうみん"],["で"],["ある"],["カナン"],["びと"],["の"],["うち"],["に"],["住んで","すんで"],["いた"],["。"],["彼","かれ"],["ら"],["が"],["追い出さなかった","おいださなかった"],["から"],["で"],["ある"],["。"]]},{"verse":33,"text":"ナフタリはベテシメシの住民,じゅうみんおよびベテアナテの住民,じゅうみんを追,おい出,ださずに、その地,ちの住民,じゅうみんであるカナンびとのうちに住,すんでいた。しかしベテシメシとベテアナテの住民,じゅうみんは、ついに彼,かれらの強制,きょうせい労働,ろうどうに服,ふくした。","tok":[["ナフタリ"],["は"],["ベテシメシ"],["の"],["住民","じゅうみん"],["および"],["ベテアナテ"],["の"],["住民","じゅうみん"],["を"],["追い出さず","おいださず"],["に"],["、"],["その"],["地","ち"],["の"],["住民","じゅうみん"],["で"],["ある"],["カナン"],["びと"],["の"],["うち"],["に"],["住んで","すんで"],["いた"],["。"],["しかし"],["ベテシメシ"],["と"],["ベテアナテ"],["の"],["住民","じゅうみん"],["は"],["、"],["ついに"],["彼","かれ"],["ら"],["の"],["強制","きょうせい"],["労働","ろうどう"],["に"],["服した","ふくした"],["。"]]},{"verse":34,"text":"アモリびとはダンの人々,ひとびとを山地,さんちに追,おい込,こんで平地,へいちに下,くだることを許,ゆるさなかった。","tok":[["アモリ"],["び"],["と"],["は"],["ダン"],["の"],["人々","ひとびと"],["を"],["山地","さんち"],["に"],["追い込んで","おいこんで"],["平地","へいち"],["に"],["下る","くだる"],["こと"],["を"],["許さなかった","ゆるさなかった"],["。"]]},{"verse":35,"text":"アモリびとは引,ひき続,つづいてハルヘレス、アヤロン、シャラビムに住,すんでいたが、ヨセフの一族,いちぞくの手,てが強,つよくなったので、彼,かれらは強制,きょうせい労働,ろうどうに服,ふくした。","tok":[["アモリ"],["び"],["と"],["は"],["引続いて","ひきつづいて"],["ハルヘレス"],["、"],["アヤロン"],["、"],["シャラビム"],["に"],["住んで","すんで"],["いた"],["が"],["、"],["ヨセフ"],["の"],["一族","いちぞく"],["の"],["手","て"],["が"],["強く","つよく"],["なった"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["強制","きょうせい"],["労働","ろうどう"],["に"],["服した","ふくした"],["。"]]},{"verse":36,"text":"アモリびとの境,さかいはアクラビムの坂,さかからセラを経,へて上,うえの方,ほうに及,およんだ。","tok":[["アモリ"],["びと"],["の"],["境","さかい"],["は"],["アクラビム"],["の"],["坂","さか"],["から"],["セラ"],["を"],["経て","へて"],["上","うえ"],["の"],["方","ほう"],["に"],["及んだ","およんだ"],["。"]]}]
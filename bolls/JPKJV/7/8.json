[{"verse":1,"text":"エフライムの人々,ひとびとはギデオンに向,むかい「あなたが、ミデアンびとと戦,たたかうために行,いかれたとき、われわれを呼,よばれなかったが、どうしてそういうことをされたのですか」と言,いって激,はげしく彼,かれを責,せめた。","tok":[["エフライム"],["の"],["人々","ひとびと"],["は"],["ギデオン"],["に"],["向","むかい"],["「"],["あなた"],["が"],["、"],["ミデアン"],["びと"],["と"],["戦う","たたかう"],["ため"],["に"],["行かれた","いかれた"],["とき"],["、"],["われわれ"],["を"],["呼ばれなかった","よばれなかった"],["が"],["、"],["どう"],["して"],["そう"],["いう"],["こと"],["を"],["された"],["の"],["です"],["か"],["」"],["と"],["言って","いって"],["激しく","はげしく"],["彼","かれ"],["を"],["責","せめ"],["た"],["。"]]},{"verse":2,"text":"ギデオンは彼,かれらに言,いった、「今,いまわたしのした事,ことは、あなたがたのした事,ことと比,くらべものになりましょうか。エフライムの拾,ひろい集,あつめた取,とり残,のこりのぶどうはアビエゼルの収穫,しゅうかくしたぶどうにもまさるではありませんか。","tok":[["ギデオン"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["今","いま"],["わたし"],["の"],["した"],["事","こと"],["は"],["、"],["あなた"],["がた"],["の"],["した"],["事","こと"],["と"],["比べもの","くらべもの"],["に"],["なりましょう"],["か"],["。"],["エフライム"],["の"],["拾い集めた","ひろいあつめた"],["取","とり"],["残り","のこり"],["の"],["ぶどう"],["は"],["アビエゼル"],["の"],["収穫","しゅうかく"],["した"],["ぶどう"],["に"],["も"],["まさる"],["で"],["は"],["ありません"],["か"],["。"]]},{"verse":3,"text":"神,かみはミデアンの君,きみオレブとゼエブをあなたがたの手,てにわたされました。わたしのなし得,えた事,ことは、あなたがたのした事,ことと比,くらべものになりましょうか」。ギデオンがこの言葉,ことばを述,のべると、彼,かれらの憤,いきどおりは解,とけた。","tok":[["神","かみ"],["は"],["ミデアン"],["の"],["君","きみ"],["オレブ"],["と"],["ゼエブ"],["を"],["あなた"],["がた"],["の"],["手","て"],["に"],["わたされました"],["。"],["わたし"],["の"],["なし"],["得た","えた"],["事","こと"],["は"],["、"],["あなた"],["がた"],["の"],["した"],["事","こと"],["と"],["比べもの","くらべもの"],["に"],["なりましょう"],["か"],["」"],["。"],["ギデオン"],["が"],["この"],["言葉","ことば"],["を"],["述べる","のべる"],["と"],["、"],["彼","かれ"],["ら"],["の"],["憤り","いきどおり"],["は"],["解けた","とけた"],["。"]]},{"verse":4,"text":"ギデオンは自分,じぶんに従,したがっていた三百人,にんと共,ともにヨルダンに行,いってこれを渡,わたり、疲,つかれながらもなお追撃,ついげきしたが、","tok":[["ギデオン"],["は"],["自分","じぶん"],["に"],["従って","したがって"],["いた"],["三百人","にん"],["と"],["共","とも"],["に"],["ヨルダン"],["に"],["行って","いって"],["これ"],["を"],["渡り","わたり"],["、"],["疲れ","つかれ"],["ながら"],["も"],["なお"],["追撃","ついげき"],["した"],["が"],["、"]]},{"verse":5,"text":"彼,かれはスコテの人々,ひとびとに言,いった、「どうぞわたしに従,したがっている民,たみにパンを与,あたえてください。彼,かれらが疲,つかれているのに、わたしはミデアンの王,おうゼバとザルムンナを追撃,ついげきしているのですから」。","tok":[["彼","かれ"],["は"],["スコテ"],["の"],["人々","ひとびと"],["に"],["言った","いった"],["、"],["「"],["どうぞ"],["わたし"],["に"],["従って","したがって"],["いる"],["民","たみ"],["に"],["パン"],["を"],["与","あたえ"],["て"],["ください"],["。"],["彼","かれ"],["ら"],["が"],["疲れて","つかれて"],["いる"],["のに"],["、"],["わたし"],["は"],["ミデアン"],["の"],["王","おう"],["ゼバ"],["と"],["ザルムンナ"],["を"],["追撃","ついげき"],["して"],["いる"],["の"],["です"],["から"],["」"],["。"]]},{"verse":6,"text":"スコテのつかさたちは言,いった、「ゼバとザルムンナは、すでにあなたの手,てのうちにあるのですか。われわれはどうしてあなたの軍勢,ぐんぜいにパンを与,あたえねばならないのですか」。","tok":[["スコテ"],["の"],["つかさ"],["たち"],["は"],["言った","いった"],["、"],["「"],["ゼバ"],["と"],["ザルムンナ"],["は"],["、"],["すでに"],["あなた"],["の"],["手","て"],["の"],["うち"],["に"],["ある"],["の"],["です"],["か"],["。"],["われわれ"],["は"],["どう"],["して"],["あなた"],["の"],["軍勢","ぐんぜい"],["に"],["パン"],["を"],["与","あたえ"],["ねば"],["ならない"],["の"],["です"],["か"],["」"],["。"]]},{"verse":7,"text":"ギデオンは言,いった、「それならば主,しゅがわたしの手,てにゼバとザルムンナをわたされるとき、わたしは野,ののいばらと、おどろをもって、あなたがたの肉,にくを打,うつであろう」。","tok":[["ギデオン"],["は"],["言った","いった"],["、"],["「"],["それ"],["ならば"],["主","しゅ"],["が"],["わたし"],["の"],["手","て"],["に"],["ゼバ"],["と"],["ザルムンナ"],["を"],["わたされる"],["とき"],["、"],["わたし"],["は"],["野","の"],["の"],["いばら"],["と"],["、"],["おどろ"],["を"],["もって"],["、"],["あなた"],["がた"],["の"],["肉","にく"],["を"],["打つで","うつで"],["あろう"],["」"],["。"]]},{"verse":8,"text":"そしてギデオンはそこからペヌエルに上,のぼり、同,おなじことをペヌエルの人々,ひとびとに述,のべると、彼,かれらもスコテの人々,ひとびとが答,こたえたように答,こたえたので、","tok":[["そして"],["ギデオン"],["は"],["そこ"],["から"],["ペヌエル"],["に"],["上り","のぼり"],["、"],["同じ","おなじ"],["こと"],["を"],["ペヌエル"],["の"],["人々","ひとびと"],["に"],["述べる","のべる"],["と"],["、"],["彼","かれ"],["ら"],["も"],["スコテ"],["の"],["人々","ひとびと"],["が"],["答","こたえ"],["た"],["よう"],["に"],["答","こたえ"],["た"],["ので"],["、"]]},{"verse":9,"text":"ペヌエルの人々,ひとびとに言,いった、「わたしが安,やすらかに帰,かえってきたとき、このやぐらを打,うちこわすであろう」。","tok":[["ペヌエル"],["の"],["人々","ひとびと"],["に"],["言った","いった"],["、"],["「"],["わたし"],["が"],["安らか","やすらか"],["に"],["帰えって","かえって"],["きた"],["とき"],["、"],["この"],["やぐら"],["を"],["打ちこわすで","うちこわすで"],["あろう"],["」"],["。"]]},{"verse":10,"text":"さてゼバとザルムンナは軍勢,ぐんぜいおおよそ一万五千人,にんを率,ひきいて、カルコルにいた。これは皆,みな、東方,とうほうの民,たみの全,ぜん軍,ぐんのうち生,いき残,のこったもので、戦死,せんしした者,ものは、つるぎを帯,おびているものが十二万人,にんあった。","tok":[["さて"],["ゼバ"],["と"],["ザルムンナ"],["は"],["軍勢","ぐんぜい"],["おおよそ"],["一万五千","いちまんごせん"],["人","にん"],["を"],["率いて","ひきいて"],["、"],["カルコル"],["に"],["いた"],["。"],["これ"],["は"],["皆","みな"],["、"],["東方","とうほう"],["の"],["民","たみ"],["の"],["全軍","ぜんぐん"],["の"],["うち"],["生き残った","いきのこった"],["もの"],["で"],["、"],["戦死","せんし"],["した"],["者","もの"],["は"],["、"],["つるぎ"],["を"],["帯","おび"],["て"],["いる"],["もの"],["が"],["十二万人","にん"],["あった"],["。"]]},{"verse":11,"text":"ギデオンはノバとヨグベハの東,ひがしの隊商,たいしょうの道,みちを上,のぼって、敵,てき軍,ぐんの油断,ゆだんしているところを撃,うった。","tok":[["ギデオン"],["は"],["ノバ"],["と"],["ヨグベハ"],["の"],["東","ひがし"],["の"],["隊商","たいしょう"],["の"],["道","みち"],["を"],["上って","のぼって"],["、"],["敵軍","てきぐん"],["の"],["油断","ゆだん"],["して"],["いる"],["ところ"],["を"],["撃った","うった"],["。"]]},{"verse":12,"text":"ゼバとザルムンナは逃,にげたが、ギデオンは追撃,ついげきして、ミデアンのふたりの王,おうゼバとザルムンナを捕,とらえ、その軍勢,ぐんぜいをことごとく撃,うち敗,やぶった。","tok":[["ゼバ"],["と"],["ザルムンナ"],["は"],["逃た","にげた"],["が"],["、"],["ギデオン"],["は"],["追撃","ついげき"],["して"],["、"],["ミデアン"],["の"],["ふたり"],["の"],["王","おう"],["ゼバ"],["と"],["ザルムンナ"],["を"],["捕らえ","とらえ"],["、"],["その"],["軍勢","ぐんぜい"],["を"],["ことごとく"],["撃ち","うち"],["敗った","やぶった"],["。"]]},{"verse":13,"text":"こうしてヨアシの子,こギデオンはヘレスの坂,さかをとおって戦,たたかいから帰,かえり、","tok":[["こう"],["して"],["ヨアシ"],["の"],["子","こ"],["ギデオン"],["は"],["ヘレス"],["の"],["坂","さか"],["を"],["とおって"],["戦い","たたかい"],["から"],["帰えり","かえり"],["、"]]},{"verse":14,"text":"スコテの若者,わかものひとりを捕,とらえて、尋,たずねたところ、彼,かれはスコテのつかさたち及,および長老,ちょうろうたち七十七人,にんの名,なをギデオンのために書,かきしるした。","tok":[["スコテ"],["の"],["若者","わかもの"],["ひとり"],["を"],["捕らえて","とらえて"],["、"],["尋ねた","たずねた"],["ところ"],["、"],["彼","かれ"],["は"],["スコテ"],["の"],["つかさ"],["たち"],["及","および"],["長老","ちょうろう"],["たち"],["七十七人","にん"],["の"],["名","な"],["を"],["ギデオン"],["の"],["ため"],["に"],["書きしるした","かきしるした"],["。"]]},{"verse":15,"text":"ギデオンはスコテの人々,ひとびとのところへ行,いって言,いった、「あなたがたがかつて『ゼバとザルムンナはすでにあなたの手,てのうちにあるのか。われわれはどうしてあなたの疲,つかれた人々,ひとびとにパンを与,あたえねばならないのか』と言,いって、わたしをののしったそのゼバとザルムンナを見,みなさい」。","tok":[["ギデオン"],["は"],["スコテ"],["の"],["人々","ひとびと"],["の"],["ところ"],["へ"],["行って","いって"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["が"],["かつて"],["『"],["ゼバ"],["と"],["ザルムンナ"],["は"],["すでに"],["あなた"],["の"],["手","て"],["の"],["うち"],["に"],["ある"],["の"],["か"],["。"],["われわれ"],["は"],["どう"],["して"],["あなた"],["の"],["疲れた","つかれた"],["人々","ひとびと"],["に"],["パン"],["を"],["与","あたえ"],["ねば"],["ならない"],["の"],["か"],["』"],["と"],["言って","いって"],["、"],["わたし"],["を"],["ののしった"],["その"],["ゼバ"],["と"],["ザルムンナ"],["を"],["見","み"],["なさい"],["」"],["。"]]},{"verse":16,"text":"そして彼,かれは、その町,まちの長老,ちょうろうたちを捕,とらえ、野,ののいばらと、おどろとを取,とり、それをもってスコテの人々,ひとびとを懲,こらし、","tok":[["そして"],["彼","かれ"],["は"],["、"],["その"],["町","まち"],["の"],["長老","ちょうろう"],["たち"],["を"],["捕らえ","とらえ"],["、"],["野","の"],["の"],["いばら"],["と"],["、"],["おどろ"],["と"],["を"],["取","とり"],["、"],["それ"],["を"],["もって"],["スコテ"],["の"],["人々","ひとびと"],["を"],["懲らし","こらし"],["、"]]},{"verse":17,"text":"またペヌエルのやぐらを打,うちこわして町,まちの人々,ひとびとを殺,ころした。","tok":[["また"],["ペヌエル"],["の"],["やぐら"],["を"],["打ちこわして","うちこわして"],["町","まち"],["の"],["人々","ひとびと"],["を"],["殺ろした","ころした"],["。"]]},{"verse":18,"text":"そしてギデオンはゼバとザルムンナに言,いった、「あなたがたがタボルで殺,ころしたのは、どんな人々,ひとびとであったか」。彼,かれらは答,こたえた、「彼,かれらはあなたに似,にてみな王子,おうじのように見,みえました」。","tok":[["そして"],["ギデオン"],["は"],["ゼバ"],["と"],["ザルムンナ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["が"],["タボル"],["で"],["殺ろした","ころした"],["の"],["は"],["、"],["どんな"],["人々","ひとびと"],["で"],["あった"],["か"],["」"],["。"],["彼","かれ"],["ら"],["は"],["答","こたえ"],["た"],["、"],["「"],["彼","かれ"],["ら"],["は"],["あなた"],["に"],["似て","にて"],["みな"],["王子","おうじ"],["の"],["よう"],["に"],["見えました","みえました"],["」"],["。"]]},{"verse":19,"text":"ギデオンは言,いった、「彼,かれらはわたしの兄弟,きょうだい、わたしの母,ははの子,こたちだ。主,しゅは生,いきておられる。もしあなたがたが彼,かれらを生,いかしておいたならば、わたしはあなたがたを殺,ころさないのだが」。","tok":[["ギデオン"],["は"],["言った","いった"],["、"],["「"],["彼","かれ"],["ら"],["は"],["わたし"],["の"],["兄弟","きょうだい"],["、"],["わたし"],["の"],["母","はは"],["の"],["子","こ"],["たち"],["だ"],["。"],["主","しゅ"],["は"],["生きて","いきて"],["おられる"],["。"],["もし"],["あなた"],["がた"],["が"],["彼","かれ"],["ら"],["を"],["生かして","いかして"],["おいたならば"],["、"],["わたし"],["は"],["あなた"],["がた"],["を"],["殺ろさない","ころさない"],["の"],["だ"],["が"],["」"],["。"]]},{"verse":20,"text":"そして長子,ちょうしエテルに言,いった、「立,たって、彼,かれらを殺,ころしなさい」。しかしその若者,わかものはなお年,としが若,わかかったので、恐,おそれてつるぎを抜,ぬかなかった。","tok":[["そして"],["長子","ちょうし"],["エテル"],["に"],["言った","いった"],["、"],["「"],["立って","たって"],["、"],["彼","かれ"],["ら"],["を"],["殺ろし","ころし"],["なさい"],["」"],["。"],["しかし"],["その"],["若者","わかもの"],["は"],["なお"],["年","とし"],["が"],["若かった","わかかった"],["ので"],["、"],["恐","おそれ"],["て"],["つるぎ"],["を"],["抜かなかった","ぬかなかった"],["。"]]},{"verse":21,"text":"そこでゼバとザルムンナは言,いった、「あなた自身,じしんが立,たって、わたしたちを撃,うってください。人,ひとによってそれぞれ力,ちからも違,ちがいますから」。ギデオンは立,たちあがってゼバとザルムンナを殺,ころし、彼,かれらのらくだの首,くびに掛,かけてあった月形,つきがたの飾,かざりを取,とった。","tok":[["そこ"],["で"],["ゼバ"],["と"],["ザルムンナ"],["は"],["言った","いった"],["、"],["「"],["あなた"],["自身","じしん"],["が"],["立って","たって"],["、"],["わたしたち"],["を"],["撃って","うって"],["ください"],["。"],["人","ひと"],["によって"],["それぞれ"],["力","ちから"],["も"],["違います","ちがいます"],["から"],["」"],["。"],["ギデオン"],["は"],["立ちあがって","たちあがって"],["ゼバ"],["と"],["ザルムンナ"],["を"],["殺ろし","ころし"],["、"],["彼","かれ"],["ら"],["の"],["らくだ"],["の"],["首","くび"],["に"],["掛て","かけて"],["あった"],["月形","つきがた"],["の"],["飾","かざり"],["を"],["取った","とった"],["。"]]},{"verse":22,"text":"イスラエルの人々,ひとびとはギデオンに言,いった、「あなたはミデアンの手,てからわれわれを救,すくわれたのですから、あなたも、あなたの子,こも孫,まごもわれわれを治,おさめてください」。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["は"],["ギデオン"],["に"],["言った","いった"],["、"],["「"],["あなた"],["は"],["ミデアン"],["の"],["手","て"],["から"],["われわれ"],["を"],["救われた","すくわれた"],["の"],["です"],["から"],["、"],["あなた"],["も"],["、"],["あなた"],["の"],["子","こ"],["も"],["孫","まご"],["も"],["われわれ"],["を"],["治めて","おさめて"],["ください"],["」"],["。"]]},{"verse":23,"text":"ギデオンは彼,かれらに言,いった、「わたしはあなたがたを治,おさめることはいたしません。またわたしの子,こもあなたがたを治,おさめてはなりません。主,しゅがあなたがたを治,おさめられます」。","tok":[["ギデオン"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["わたし"],["は"],["あなた"],["がた"],["を"],["治める","おさめる"],["こと"],["は"],["いたしません"],["。"],["また"],["わたし"],["の"],["子","こ"],["も"],["あなた"],["がた"],["を"],["治めて","おさめて"],["は"],["なりません"],["。"],["主","しゅ"],["が"],["あなた"],["がた"],["を"],["治められます","おさめられます"],["」"],["。"]]},{"verse":24,"text":"ギデオンはまた彼,かれらに言,いった、「わたしはあなたがたに一つの願,ねがいがあります。あなたがたのぶんどった耳輪,みみわをめいめいわたしにください」。ミデアンびとはイシマエルびとであったゆえに、金,きんの耳輪,みみわを持,もっていたからである。","tok":[["ギデオン"],["は"],["また"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["わたし"],["は"],["あなた"],["がた"],["に"],["一","ひと"],["つ"],["の"],["願い","ねがい"],["が"],["あります"],["。"],["あなた"],["がた"],["の"],["ぶんどった"],["耳輪","みみわ"],["を"],["めいめい"],["わたし"],["に"],["ください"],["」"],["。"],["ミデアン"],["びと"],["は"],["イシマエル"],["びと"],["で"],["あった"],["ゆえ"],["に"],["、"],["金","きん"],["の"],["耳輪","みみわ"],["を"],["持って","もって"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":25,"text":"彼,かれらは答,こたえた、「わたしどもは喜,よろこんでそれをさしあげます」。そして衣,ころもをひろげ、めいめいぶんどった耳輪,みみわをその中,なかに投,なげ入,いれた。","tok":[["彼","かれ"],["ら"],["は"],["答","こたえ"],["た"],["、"],["「"],["わたし"],["ども"],["は"],["喜こんで","よろこんで"],["それ"],["を"],["さしあげます"],["」"],["。"],["そして"],["衣","ころも"],["を"],["ひろげ"],["、"],["めいめい"],["ぶんどった"],["耳輪","みみわ"],["を"],["その"],["中","なか"],["に"],["投入れた","なげいれた"],["。"]]},{"verse":26,"text":"こうしてギデオンが求,もとめて得,えた金,きんの耳輪,みみわの重,おもさは一千七百金,きんシケルであった。ほかに月形,つきがたの飾,かざりと耳飾,みみかざりと、ミデアンの王,おうたちの着,きた紫,むらさきの衣,ころもおよびらくだの首,くびに掛,かけた首飾,くびかざりなどもあった。","tok":[["こう"],["して"],["ギデオン"],["が"],["求めて","もとめて"],["得た","えた"],["金","きん"],["の"],["耳輪","みみわ"],["の"],["重さ","おもさ"],["は"],["一千七百","いちせんななひゃく"],["金","きん"],["シケル"],["で"],["あった"],["。"],["ほか"],["に"],["月形","つきがた"],["の"],["飾","かざり"],["と"],["耳飾り","みみかざり"],["と"],["、"],["ミデアン"],["の"],["王","おう"],["たち"],["の"],["着た","きた"],["紫","むらさき"],["の"],["衣","ころも"],["および"],["らくだ"],["の"],["首","くび"],["に"],["掛た","かけた"],["首","くび"],["飾","かざり"],["など"],["も"],["あった"],["。"]]},{"verse":27,"text":"ギデオンはそれをもって一つのエポデを作,つくり、それを自分,じぶんの町,まちオフラに置,おいた。イスラエルは皆,みなそれを慕,したって姦淫,かんいんをおこなった。それはギデオンとその家,いえにとって、わなとなった。","tok":[["ギデオン"],["は"],["それ"],["を"],["もって"],["一","ひと"],["つ"],["の"],["エポデ"],["を"],["作り","つくり"],["、"],["それ"],["を"],["自分","じぶん"],["の"],["町","まち"],["オフラ"],["に"],["置いた","おいた"],["。"],["イスラエル"],["は"],["皆","みな"],["それ"],["を"],["慕って","したって"],["姦淫","かんいん"],["を"],["おこなった"],["。"],["それ"],["は"],["ギデオン"],["と"],["その"],["家","いえ"],["にとって"],["、"],["わな"],["と"],["なった"],["。"]]},{"verse":28,"text":"このようにしてミデアンはイスラエルの人々,ひとびとに征服,せいふくされて、再,ふたたびその頭,あたまをあげることができなかった。そして国,くにはギデオンの世,よにあるうち、四十年,ねんのあいだ太平,たいへいであった。","tok":[["この"],["よう"],["に"],["して"],["ミデアン"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["征服","せいふく"],["されて"],["、"],["再び","ふたたび"],["その"],["頭","あたま"],["を"],["あげる"],["こと"],["が"],["できなかった"],["。"],["そして"],["国","くに"],["は"],["ギデオン"],["の"],["世","よ"],["に"],["ある"],["うち"],["、"],["四十","よんじゅう"],["年","ねん"],["の"],["あいだ"],["太平","たいへい"],["で"],["あった"],["。"]]},{"verse":29,"text":"ヨアシの子,こエルバアルは行,いって自分,じぶんの家,いえに住,すんだ。","tok":[["ヨアシ"],["の"],["子","こ"],["エルバアル"],["は"],["行って","いって"],["自分","じぶん"],["の"],["家","いえ"],["に"],["住んだ","すんだ"],["。"]]},{"verse":30,"text":"ギデオンは多,おおくの妻,つまをもっていたので、自分,じぶんの子供,こどもだけで七十人,にんあった。","tok":[["ギデオン"],["は"],["多く","おおく"],["の"],["妻","つま"],["を"],["もって"],["いた"],["ので"],["、"],["自分","じぶん"],["の"],["子供","こども"],["だけ"],["で"],["七","なな"],["十人","じゅうにん"],["あった"],["。"]]},{"verse":31,"text":"シケムにいた彼,かれのめかけがまたひとりの子,こを産,うんだので、アビメレクと名,なづけた。","tok":[["シケム"],["に"],["いた"],["彼","かれ"],["の"],["めかけ"],["が"],["また"],["ひとり"],["の"],["子","こ"],["を"],["産","うんだ"],["ので"],["、"],["アビメレク"],["と"],["名づけた","なづけた"],["。"]]},{"verse":32,"text":"ヨアシの子,こギデオンは高齢,こうれいに達,たっして死,しに、アビエゼルびとのオフラにある父,ちちヨアシの墓,はかに葬,ほうむられた。","tok":[["ヨアシ"],["の"],["子","こ"],["ギデオン"],["は"],["高齢","こうれい"],["に"],["達して","たっして"],["死に","しに"],["、"],["アビエゼル"],["びと"],["の"],["オフラ"],["に"],["ある"],["父","ちち"],["ヨアシ"],["の"],["墓","はか"],["に"],["葬むられた","ほうむられた"],["。"]]},{"verse":33,"text":"ギデオンが死,しぬと、イスラエルの人々,ひとびとはまたバアルを慕,したって、これと姦淫,かんいんを行,おこない、バアル・ベリテを自分,じぶんたちの神,かみとした。","tok":[["ギデオン"],["が"],["死ぬ","しぬ"],["と"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["また"],["バアル"],["を"],["慕って","したって"],["、"],["これ"],["と"],["姦淫","かんいん"],["を"],["行ない","おこない"],["、"],["バアル"],["・"],["ベリテ"],["を"],["自分","じぶん"],["たち"],["の"],["神","かみ"],["と"],["した"],["。"]]},{"verse":34,"text":"すなわちイスラエルの人々,ひとびとは周囲,しゅういのもろもろの敵,てきの手,てから自分,じぶんたちを救,すくわれた彼,かれらの神,かみ、主,しゅを覚,おぼえず、","tok":[["すなわち"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["周囲","しゅうい"],["の"],["もろもろ"],["の"],["敵","てき"],["の"],["手","て"],["から"],["自分","じぶん"],["たち"],["を"],["救われた","すくわれた"],["彼","かれ"],["ら"],["の"],["神","かみ"],["、"],["主","しゅ"],["を"],["覚えず","おぼえず"],["、"]]},{"verse":35,"text":"またエルバアルすなわちギデオンがイスラエルのためにしたもろもろの善行,ぜんこうに応,おうじて彼,かれの家族,かぞくに親切,しんせつをつくすこともしなかった。","tok":[["また"],["エルバアル"],["すなわち"],["ギデオン"],["が"],["イスラエル"],["の"],["ため"],["に"],["した"],["もろもろ"],["の"],["善行","ぜんこう"],["に"],["応じて","おうじて"],["彼","かれ"],["の"],["家族","かぞく"],["に"],["親切","しんせつ"],["を"],["つくす"],["こと"],["も"],["しなかった"],["。"]]}]
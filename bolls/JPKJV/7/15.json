[{"verse":1,"text":"日,ひがたって後,のち、麦,むぎ刈,かりの時,ときにサムソンは子,こやぎを携,たずさえて妻,つまをおとずれ、「へやにはいって、妻,つまに会,あいましょう」と言,いったが、妻,つまの父,ちちははいることを許,ゆるさなかった。","tok":[["日","ひ"],["がた"],["って"],["後","の"],["ち"],["、"],["麦刈","むぎかり"],["の"],["時","とき"],["に"],["サムソン"],["は"],["子やぎ","こやぎ"],["を"],["携えて","たずさえて"],["妻","つま"],["を"],["おとずれ"],["、"],["「"],["へや"],["に"],["はいって"],["、"],["妻","つま"],["に"],["会いましょう","あいましょう"],["」"],["と"],["言った","いった"],["が"],["、"],["妻","つま"],["の"],["父","ちち"],["は"],["はいる"],["こと"],["を"],["許さなかった","ゆるさなかった"],["。"]]},{"verse":2,"text":"そして父,ちちは言,いった、「あなたが確,たしかに彼女,かのじょをきらったに相違,そういないと思,おもったので、わたしは彼女,かのじょをあなたの客,きゃくであった者,ものにやりました。彼女,かのじょの妹,いもうとは彼女,かのじょよりもきれいではありませんか。どうぞ、彼女,かのじょの代,かわりに妹,いもうとをめとってください」。","tok":[["そして"],["父","ちち"],["は"],["言った","いった"],["、"],["「"],["あなた"],["が"],["確か","たしか"],["に"],["彼女","かのじょ"],["を"],["きらった"],["に"],["相違","そうい"],["ない"],["と"],["思った","おもった"],["ので"],["、"],["わたし"],["は"],["彼女","かのじょ"],["を"],["あなた"],["の"],["客","きゃく"],["で"],["あった"],["者","もの"],["に"],["やりました"],["。"],["彼女","かのじょ"],["の"],["妹","いもうと"],["は"],["彼女","かのじょ"],["より"],["も"],["きれい"],["で"],["は"],["ありません"],["か"],["。"],["どうぞ"],["、"],["彼女","かのじょ"],["の"],["代わり","かわり"],["に"],["妹","いもうと"],["を"],["めとって"],["ください"],["」"],["。"]]},{"verse":3,"text":"サムソンは彼,かれらに言,いった、「今度,こんどはわたしがペリシテびとに害,がいを加,くわえても、彼,かれらのことでは、わたしに罪,つみがない」。","tok":[["サムソン"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["今度","こんど"],["は"],["わたし"],["が"],["ペリシテ"],["びと"],["に"],["害","がい"],["を"],["加えて","くわえて"],["も"],["、"],["彼","かれ"],["ら"],["の"],["こと"],["で"],["は"],["、"],["わたし"],["に"],["罪","つみ"],["が"],["ない"],["」"],["。"]]},{"verse":4,"text":"そこでサムソンは行,いって、きつね三百匹,ひきを捕,とらえ、たいまつをとり、尾,おと尾,おをあわせて、その二つの尾,おの間,あいだに一つのたいまつを結,むすびつけ、","tok":[["そこ"],["で"],["サムソン"],["は"],["行って","いって"],["、"],["きつね"],["三百匹","ひき"],["を"],["捕らえ","とらえ"],["、"],["たいまつ"],["を"],["とり"],["、"],["尾","お"],["と"],["尾","お"],["を"],["あわせて"],["、"],["その"],["二","ふた"],["つ"],["の"],["尾","お"],["の"],["間","あいだ"],["に"],["一","ひと"],["つ"],["の"],["たいまつ"],["を"],["結びつけ","むすびつけ"],["、"]]},{"verse":5,"text":"たいまつに火,ひをつけて、そのきつねをペリシテびとのまだ刈,からない麦,むぎの中,なかに放,はなし入,いれ、そのたばね積,つんだものと、まだ刈,からないものとを焼,やき、オリブ畑,はたけをも焼,やいた。","tok":[["たいまつ"],["に"],["火","ひ"],["を"],["つけて"],["、"],["その"],["きつね"],["を"],["ペリシテ"],["びと"],["の"],["まだ"],["刈らない","からない"],["麦","むぎ"],["の"],["中","なか"],["に"],["放し","はなし"],["入れ","いれ"],["、"],["その"],["たばね"],["積","つんだも"],["の"],["と"],["、"],["まだ"],["刈らない","からない"],["もの"],["と"],["を"],["焼き","やき"],["、"],["オリブ"],["畑","はたけ"],["を"],["も"],["焼いた","やいた"],["。"]]},{"verse":6,"text":"ペリシテびとは言,いった、「これはだれのしわざか」。人々,ひとびとは言,いった、「テムナびとの婿,むこサムソンだ。そのしゅうとがサムソンの妻,つまを取,とり返,かえして、その客,きゃくであった者,ものに与,あたえたからだ」。そこでペリシテびとは上,のぼってきて彼女,かのじょとその父,ちちの家,いえを火,ひで焼,やき払,はらった。","tok":[["ペリシテ"],["び"],["と"],["は"],["言った","いった"],["、"],["「"],["これ"],["は"],["だれ"],["の"],["しわざ"],["か"],["」"],["。"],["人々","ひとびと"],["は"],["言った","いった"],["、"],["「"],["テムナ"],["びと"],["の"],["婿","むこ"],["サムソン"],["だ"],["。"],["その"],["しゅうと"],["が"],["サムソン"],["の"],["妻","つま"],["を"],["取","とり"],["返","かえし"],["て"],["、"],["その"],["客","きゃく"],["で"],["あった"],["者","もの"],["に"],["与","あたえ"],["たから"],["だ"],["」"],["。"],["そこ"],["で"],["ペリシテ"],["び"],["と"],["は"],["上って","のぼって"],["きて"],["彼女","かのじょ"],["と"],["その"],["父","ちち"],["の"],["家","いえ"],["を"],["火","ひ"],["で"],["焼き払った","やきはらった"],["。"]]},{"verse":7,"text":"サムソンは彼,かれらに言,いった、「あなたがたがそんなことをするならば、わたしはあなたがたに仕返,しかえしせずにはおかない」。","tok":[["サムソン"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["が"],["そんな"],["こと"],["を"],["するならば"],["、"],["わたし"],["は"],["あなた"],["がた"],["に"],["仕返し","しかえし"],["せず"],["に"],["は"],["おかない"],["」"],["。"]]},{"verse":8,"text":"そしてサムソンは彼,かれらを、さんざんに撃,うって大,だいぜい殺,ころした。こうしてサムソンは下,くだって行,いって、エタムの岩,いわの裂,さけ目,めに住,すんでいた。","tok":[["そして"],["サムソン"],["は"],["彼","かれ"],["ら"],["を"],["、"],["さんざん"],["に"],["撃って","うって"],["大ぜい","だいぜい"],["殺ろした","ころした"],["。"],["こう"],["して"],["サムソン"],["は"],["下って","くだって"],["行って","いって"],["、"],["エタム"],["の"],["岩","いわ"],["の"],["裂け目","さけめ"],["に"],["住んで","すんで"],["いた"],["。"]]},{"verse":9,"text":"そこでペリシテびとは上,のぼってきて、ユダに陣,じんを取,とり、レヒを攻,せめたので、","tok":[["そこ"],["で"],["ペリシテ"],["び"],["と"],["は"],["上って","のぼって"],["きて"],["、"],["ユダ"],["に"],["陣","じん"],["を"],["取","とり"],["、"],["レヒ"],["を"],["攻めた","せめた"],["ので"],["、"]]},{"verse":10,"text":"ユダの人々,ひとびとは言,いった、「あなたがたはどうしてわれわれのところに攻,せめのぼってきたのですか」。彼,かれらは言,いった、「われわれはサムソンを縛,しばり、彼,かれがわれわれにしたように、彼,かれにするために上,のぼってきたのです」。","tok":[["ユダ"],["の"],["人々","ひとびと"],["は"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["どう"],["して"],["われわれ"],["の"],["ところ"],["に"],["攻めのぼって","せめのぼって"],["きた"],["の"],["です"],["か"],["」"],["。"],["彼","かれ"],["ら"],["は"],["言った","いった"],["、"],["「"],["われわれ"],["は"],["サムソン"],["を"],["縛り","しばり"],["、"],["彼","かれ"],["が"],["われわれ"],["に"],["した"],["よう"],["に"],["、"],["彼","かれ"],["に"],["する"],["ため"],["に"],["上って","のぼって"],["きた"],["の"],["です"],["」"],["。"]]},{"verse":11,"text":"そこでユダの人々,ひとびと三千人,にんがエタムの岩,いわの裂,さけ目,めに下,くだって行,いって、サムソンに言,いった、「ペリシテびとはわれわれの支配者,しはいしゃであることをあなたは知,しらないのですか。あなたはどうしてわれわれにこんな事,ことをしたのですか」。サムソンは彼,かれらに言,いった、「彼,かれらがわたしにしたように、わたしは彼,かれらにしたのです」。","tok":[["そこ"],["で"],["ユダ"],["の"],["人々","ひとびと"],["三千人","にん"],["が"],["エタム"],["の"],["岩","いわ"],["の"],["裂け目","さけめ"],["に"],["下って","くだって"],["行って","いって"],["、"],["サムソン"],["に"],["言った","いった"],["、"],["「"],["ペリシテ"],["び"],["と"],["は"],["われわれ"],["の"],["支配者","しはいしゃ"],["で"],["ある"],["こと"],["を"],["あなた"],["は"],["知らない","しらない"],["の"],["です"],["か"],["。"],["あなた"],["は"],["どう"],["して"],["われわれ"],["に"],["こんな"],["事","こと"],["を"],["した"],["の"],["です"],["か"],["」"],["。"],["サムソン"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["彼","かれ"],["ら"],["が"],["わたし"],["に"],["した"],["よう"],["に"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["に"],["した"],["の"],["です"],["」"],["。"]]},{"verse":12,"text":"彼,かれらはまたサムソンに言,いった、「われわれはあなたを縛,しばって、ペリシテびとの手,てにわたすために下,くだってきたのです」。サムソンは彼,かれらに言,いった、「あなたがた自身,じしんはわたしを撃,うたないということを誓,ちかいなさい」。","tok":[["彼","かれ"],["ら"],["は"],["また"],["サムソン"],["に"],["言った","いった"],["、"],["「"],["われわれ"],["は"],["あなた"],["を"],["縛って","しばって"],["、"],["ペリシテ"],["びと"],["の"],["手","て"],["に"],["わたす"],["ため"],["に"],["下って","くだって"],["きた"],["の"],["です"],["」"],["。"],["サムソン"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["自身","じしん"],["は"],["わたし"],["を"],["撃たない","うたない"],["と"],["いう"],["こと"],["を"],["誓い","ちかい"],["なさい"],["」"],["。"]]},{"verse":13,"text":"彼,かれらはサムソンに言,いった、「いや、われわれはただ、あなたを縛,しばって、ペリシテびとの手,てにわたすだけです。決,けっしてあなたを殺,ころしません」。彼,かれらは二本,ほんの新,あたらしい綱,つなをもって彼,かれを縛,しばって、岩,いわからひきあげた。","tok":[["彼","かれ"],["ら"],["は"],["サムソン"],["に"],["言った","いった"],["、"],["「"],["いや"],["、"],["われわれ"],["は"],["ただ"],["、"],["あなた"],["を"],["縛って","しばって"],["、"],["ペリシテ"],["びと"],["の"],["手","て"],["に"],["わたす"],["だけ"],["です"],["。"],["決っして","けっして"],["あなた"],["を"],["殺ろしません","ころしません"],["」"],["。"],["彼","かれ"],["ら"],["は"],["二本","ほん"],["の"],["新らしい","あたらしい"],["綱","つな"],["を"],["もって"],["彼","かれ"],["を"],["縛って","しばって"],["、"],["岩","いわ"],["から"],["ひきあげた"],["。"]]},{"verse":14,"text":"サムソンがレヒにきたとき、ペリシテびとは声,こえをあげて、彼,かれに近,ちかづいた。その時,とき、主,しゅの霊,れいが激,はげしく彼,かれに臨,のぞんだので、彼,かれの腕,うでにかかっていた綱,つなは火,ひに焼,やけた亜麻,あまのようになって、そのなわめが手,てから解,とけて落,おちた。","tok":[["サムソン"],["が"],["レヒ"],["に"],["きた"],["とき"],["、"],["ペリシテ"],["び"],["と"],["は"],["声","こえ"],["を"],["あげて"],["、"],["彼","かれ"],["に"],["近づいた","ちかづいた"],["。"],["その"],["時","とき"],["、"],["主","しゅ"],["の"],["霊","れい"],["が"],["激しく","はげしく"],["彼","かれ"],["に"],["臨","のぞんだ"],["ので"],["、"],["彼","かれ"],["の"],["腕","うで"],["に"],["かかって"],["いた"],["綱","つな"],["は"],["火","ひ"],["に"],["焼","やけ"],["た"],["亜麻","あま"],["の"],["よう"],["に"],["なって"],["、"],["その"],["なわ"],["め"],["が"],["手","て"],["から"],["解けて","とけて"],["落","おち"],["た"],["。"]]},{"verse":15,"text":"彼,かれはろばの新,あたらしいあご骨,ほね一つを見,みつけたので、手,てを伸,のべて取,とり、それをもって一千人,にんを打,うち殺,ころした。","tok":[["彼","かれ"],["は"],["ろば"],["の"],["新らしい","あたらしい"],["あご骨","あごほね"],["一","ひと"],["つ"],["を"],["見つけた","みつけた"],["ので"],["、"],["手","て"],["を"],["伸べて","のべて"],["取","とり"],["、"],["それ"],["を"],["もって"],["一千人","にん"],["を"],["打ち","うち"],["殺ろ","ころ"],["した"],["。"]]},{"verse":16,"text":"そしてサムソンは言,いった、「ろばのあご骨,ほねをもって山,やままた山,やまを築,きずき、ろばのあご骨,ほねをもって一千人,にんを打,うち殺,ころした」。","tok":[["そして"],["サムソン"],["は"],["言った","いった"],["、"],["「"],["ろば"],["の"],["あご骨","あごほね"],["を"],["もって"],["山","やま"],["また"],["山","やま"],["を"],["築き","きずき"],["、"],["ろば"],["の"],["あご骨","あごほね"],["を"],["もって"],["一千人","にん"],["を"],["打ち","うち"],["殺ろ","ころ"],["した"],["」"],["。"]]},{"verse":17,"text":"彼,かれは言,いい終,おわると、その手,てからあご骨,ほねを投,なげすてた。これがためにその所,ところは「あご骨,ほねの丘,おか」と呼,よばれた。","tok":[["彼","かれ"],["は"],["言い","いい"],["終わる","おわる"],["と"],["、"],["その"],["手","て"],["から"],["あご骨","あごほね"],["を"],["投","なげ"],["すてた"],["。"],["これ"],["が"],["ため"],["に"],["その"],["所","ところ"],["は"],["「"],["あご骨","あごほね"],["の"],["丘","おか"],["」"],["と"],["呼ばれた","よばれた"],["。"]]},{"verse":18,"text":"時,ときに彼,かれはひどくかわきを覚,おぼえたので、主,しゅに呼,よばわって言,いった、「あなたはしもべの手,てをもって、この大,おおきな救,すくいを施,ほどこされたのに、わたしは今,いま、かわいて死,しに、割礼,かつれいをうけないものの手,てに陥,おちいろうとしています」。","tok":[["時","とき"],["に"],["彼","かれ"],["は"],["ひどく"],["かわき"],["を"],["覚えた","おぼえた"],["ので"],["、"],["主に","しゅに"],["呼ばわって","よばわって"],["言った","いった"],["、"],["「"],["あなた"],["は"],["しもべ"],["の"],["手","て"],["を"],["もって"],["、"],["この"],["大きな","おおきな"],["救い","すくい"],["を"],["施された","ほどこされた"],["のに"],["、"],["わたし"],["は"],["今","いま"],["、"],["かわいて"],["死に","しに"],["、"],["割礼","かつれい"],["を"],["うけない"],["もの"],["の"],["手","て"],["に"],["陥ち","おち"],["いろう"],["として"],["います"],["」"],["。"]]},{"verse":19,"text":"そこで神,かみはレヒにあるくぼんだ所,ところを裂,さかれたので、そこから水,みずが流,ながれ出,でた。サムソンがそれを飲,のむと彼,かれの霊,れいはもとにかえって元,もと気,きづいた。それでその名,なを「呼,よばわった者,ものの泉,いずみ」と呼,よんだ。これは今日,こんにちまでレヒにある。","tok":[["そこ"],["で"],["神","かみ"],["は"],["レヒ"],["に"],["ある"],["くぼんだ"],["所","ところ"],["を"],["裂かれた","さかれた"],["ので"],["、"],["そこ"],["から"],["水","みず"],["が"],["流れ出た","ながれでた"],["。"],["サムソン"],["が"],["それ"],["を"],["飲む","のむ"],["と"],["彼","かれ"],["の"],["霊","れい"],["は"],["もと"],["に"],["かえって"],["元気","もとき"],["づいた"],["。"],["それ"],["で"],["その"],["名","な"],["を"],["「"],["呼ばわった","よばわった"],["者","もの"],["の"],["泉","いずみ"],["」"],["と"],["呼んだ","よんだ"],["。"],["これ"],["は"],["今日","こん"],["に"],["ち"],["まで"],["レヒ"],["に"],["ある"],["。"]]},{"verse":20,"text":"サムソンはペリシテびとの時代,じだいに二十年,ねんの間,あいだイスラエルをさばいた。","tok":[["サムソン"],["は"],["ペリシテ"],["びと"],["の"],["時代","じだい"],["に"],["二十","にじゅう"],["年","ねん"],["の"],["間","あいだ"],["イスラエル"],["を"],["さばいた"],["。"]]}]
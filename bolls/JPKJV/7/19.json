[{"verse":1,"text":"そのころ、イスラエルに王,おうがなかった時,とき、エフライムの山地,さんちの奥,おくにひとりのレビびとが寄留,きりゅうしていた。彼,かれはユダのベツレヘムからひとりの女,おんなを迎,むかえて、めかけとしていたが、","tok":[["その"],["ころ"],["、"],["イスラエル"],["に"],["王","おう"],["が"],["なかった"],["時","とき"],["、"],["エフライム"],["の"],["山地","さんち"],["の"],["奥","おく"],["に"],["ひとり"],["の"],["レビ"],["びと"],["が"],["寄留","きりゅう"],["して"],["いた"],["。"],["彼","かれ"],["は"],["ユダ"],["の"],["ベツレヘム"],["から"],["ひとり"],["の"],["女","おんな"],["を"],["迎","むかえ"],["て"],["、"],["めかけ"],["として"],["いた"],["が"],["、"]]},{"verse":2,"text":"そのめかけは怒,いかって、彼,かれのところを去,さり、ユダのベツレヘムの父,ちちの家,いえに帰,かえって、そこに四か月,げつばかり過,すごした。","tok":[["その"],["めかけ"],["は"],["怒","い"],["か"],["って"],["、"],["彼","かれ"],["の"],["ところ"],["を"],["去り","さり"],["、"],["ユダ"],["の"],["ベツレヘム"],["の"],["父","ちち"],["の"],["家","いえ"],["に"],["帰えって","かえって"],["、"],["そこ"],["に"],["四","よん"],["か月","かげつ"],["ばかり"],["過ごした","すごした"],["。"]]},{"verse":3,"text":"そこで夫,おっとは彼女,かのじょをなだめて連,つれ帰,かえろうと、しもべと二頭,とうのろばを従,したがえ、立,たって彼女,かのじょのあとを追,おって行,いった。彼,かれが女,おんなの父,ちちの家,いえに着,ついた時,とき、娘,むすめの父,ちちは彼,かれを見,みて、喜,よろこんで迎,むかえた。","tok":[["そこ"],["で"],["夫","おっと"],["は"],["彼女","かのじょ"],["を"],["なだめて"],["連れ","つれ"],["帰えろう","かえろう"],["と"],["、"],["しもべ"],["と"],["二頭","とう"],["の"],["ろば"],["を"],["従え","したがえ"],["、"],["立って","たって"],["彼女","かのじょ"],["の"],["あと"],["を"],["追って","おって"],["行った","いった"],["。"],["彼","かれ"],["が"],["女","おんな"],["の"],["父","ちち"],["の"],["家","いえ"],["に"],["着いた","ついた"],["時","とき"],["、"],["娘","むすめ"],["の"],["父","ちち"],["は"],["彼","かれ"],["を"],["見て","みて"],["、"],["喜こんで","よろこんで"],["迎","むかえ"],["た"],["。"]]},{"verse":4,"text":"娘,むすめの父,ちちであるしゅうとが引,ひき留,とめたので、彼,かれは三日,か共,ともにおり、みな飲,のみ食,くいしてそこに宿,やどった。","tok":[["娘","むすめ"],["の"],["父","ちち"],["で"],["ある"],["しゅうと"],["が"],["引","ひき"],["留","とめ"],["た"],["ので"],["、"],["彼","かれ"],["は"],["三日","か"],["共","とも"],["に"],["おり"],["、"],["みな"],["飲み食い","のみくい"],["して"],["そこ"],["に"],["宿った","やどった"],["。"]]},{"verse":5,"text":"四日,か目,めに彼,かれらは朝,あさはやく起,おき、彼,かれが立,たち去,さろうとしたので、娘,むすめの父,ちちは婿,むこに言,いった、「少,すこし食事,しょくじをして元気,げんきをつけ、それから出,でかけなさい」。","tok":[["四日目","かめ"],["に"],["彼","かれ"],["ら"],["は"],["朝","あさ"],["はやく"],["起き","おき"],["、"],["彼","かれ"],["が"],["立ち去ろう","たちさろう"],["と"],["した"],["ので"],["、"],["娘","むすめ"],["の"],["父","ちち"],["は"],["婿","むこ"],["に"],["言った","いった"],["、"],["「"],["少し","すこし"],["食事","しょくじ"],["を"],["して"],["元気","げんき"],["を"],["つけ"],["、"],["それ"],["から"],["出かけ","でかけ"],["なさい"],["」"],["。"]]},{"verse":6,"text":"そこでふたりは座,ざして共,ともに飲,のみ食,くいしたが、娘,むすめの父,ちちはその人,ひとに言,いった、「どうぞもう一晩,ひとばん泊,とまって楽,たのしく過,すごしなさい」。","tok":[["そこ"],["で"],["ふたり"],["は"],["座して","ざして"],["共","とも"],["に"],["飲み食い","のみくい"],["した"],["が"],["、"],["娘","むすめ"],["の"],["父","ちち"],["は"],["その"],["人","ひと"],["に"],["言った","いった"],["、"],["「"],["どうぞ"],["もう"],["一","いち"],["晩","ばん"],["と"],["ばん"],["泊まって","とまって"],["楽く","たのしく"],["過ごし","すごし"],["なさい"],["」"],["。"]]},{"verse":7,"text":"その人,ひとは立,たって去,さろうとしたが、しゅうとがしいたので、ついにまたそこに宿,やどった。","tok":[["その"],["人","ひと"],["は"],["立って","たって"],["去ろう","さろう"],["と"],["した"],["が"],["、"],["しゅうと"],["が"],["し"],["いた"],["ので"],["、"],["ついに"],["また"],["そこ"],["に"],["宿った","やどった"],["。"]]},{"verse":8,"text":"五日,か目,めになって、朝,あさはやく起,おきて去,さろうとしたが、娘,むすめの父,ちちは言,いった、「どうぞ、元気,げんきをつけて、日,ひが傾,かたむくまでとどまりなさい」。そこで彼,かれらふたりは食事,しょくじをした。","tok":[["五日目","かめ"],["に"],["なって"],["、"],["朝","あさ"],["はやく"],["起きて","おきて"],["去ろう","さろう"],["と"],["した"],["が"],["、"],["娘","むすめ"],["の"],["父","ちち"],["は"],["言った","いった"],["、"],["「"],["どうぞ"],["、"],["元気","げんき"],["を"],["つけて"],["、"],["日","ひ"],["が"],["傾く","かたむく"],["まで"],["とどまり"],["なさい"],["」"],["。"],["そこ"],["で"],["彼","かれ"],["ら"],["ふたり"],["は"],["食事","しょくじ"],["を"],["した"],["。"]]},{"verse":9,"text":"その人,ひとがついにめかけおよびしもべと共,ともに去,さろうとして立,たちあがったとき、娘,むすめの父,ちちであるしゅうとは彼,かれに言,いった、「日,ひも暮,くれようとしている。どうぞもう一晩,ばん泊,とまりなさい。日,ひは傾,かたむいた。ここに宿,やどって楽,たのしく過,すごしなさい。そしてあしたの朝,あさはやく起,おきて出立,しゅったつし、家,いえに帰,かえりなさい」。","tok":[["その"],["人","ひと"],["が"],["ついに"],["めかけ"],["および"],["しもべ"],["と"],["共","とも"],["に"],["去ろう","さろう"],["として"],["立ちあがった","たちあがった"],["とき"],["、"],["娘","むすめ"],["の"],["父","ちち"],["で"],["ある"],["しゅうと"],["は"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["日","ひ"],["も"],["暮","くれ"],["よう"],["として"],["いる"],["。"],["どうぞ"],["もう"],["一","いち"],["晩","ばん"],["泊まり","とまり"],["なさい"],["。"],["日","ひ"],["は"],["傾いた","かたむいた"],["。"],["ここ"],["に"],["宿って","やどって"],["楽く","たのしく"],["過ごし","すごし"],["なさい"],["。"],["そして"],["あした"],["の"],["朝","あさ"],["はやく"],["起きて","おきて"],["出立","しゅったつ"],["し"],["、"],["家","いえ"],["に"],["帰えり","かえり"],["なさい"],["」"],["。"]]},{"verse":10,"text":"しかし、その人,ひとは泊,とまることを好,このまないので、立,たって去,さり、エブスすなわちエルサレムの向,むかいに着,ついた。くらをおいた二頭,とうのろばと彼,かれのめかけも一緒,いっしょであった。","tok":[["しかし"],["、"],["その"],["人","ひと"],["は"],["泊まる","とまる"],["こと"],["を"],["好まない","このまない"],["ので"],["、"],["立って","たって"],["去り","さり"],["、"],["エブス"],["すなわち"],["エルサレム"],["の"],["向","むかい"],["に"],["着いた","ついた"],["。"],["くら"],["を"],["おいた"],["二頭","とう"],["の"],["ろば"],["と"],["彼","かれ"],["の"],["めかけ"],["も"],["一緒","いっしょ"],["で"],["あった"],["。"]]},{"verse":11,"text":"彼,かれらがエブスに近,ちかづいたとき、日,ひはすでに没,ぼっしたので、しもべは主人,しゅじんに言,いった、「さあ、われわれは道,みちを転,てんじてエブスびとのこの町,まちにはいって、そこに宿,やどりましょう」。","tok":[["彼","かれ"],["ら"],["が"],["エブス"],["に"],["近づいた","ちかづいた"],["とき"],["、"],["日","ひ"],["は"],["すでに"],["没した","ぼっした"],["ので"],["、"],["しもべ"],["は"],["主人","しゅじん"],["に"],["言った","いった"],["、"],["「"],["さあ"],["、"],["われわれ"],["は"],["道","みち"],["を"],["転じて","てんじて"],["エブス"],["びと"],["の"],["この"],["町","まち"],["に"],["はいって"],["、"],["そこ"],["に"],["宿りましょう","やどりましょう"],["」"],["。"]]},{"verse":12,"text":"主人,しゅじんは彼,かれに言,いった、「われわれは道,みちを転,てんじて、イスラエルの人々,ひとびとの町,まちでない外国,がいこく人,じんの町,まちに、はいってはならない。ギベアまで行,いこう」。","tok":[["主人","しゅじん"],["は"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["われわれ"],["は"],["道","みち"],["を"],["転じて","てんじて"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["町","まち"],["で"],["ない"],["外国人","がいこくじん"],["の"],["町","まち"],["に"],["、"],["はいって"],["は"],["ならない"],["。"],["ギベア"],["まで"],["行こう","いこう"],["」"],["。"]]},{"verse":13,"text":"彼,かれはまたしもべに言,いった、「さあ、われわれはギベアかラマか、そのうちの一つに着,ついてそこに宿,やどろう」。","tok":[["彼","かれ"],["は"],["また"],["しもべ"],["に"],["言った","いった"],["、"],["「"],["さあ"],["、"],["われわれ"],["は"],["ギベア"],["か"],["ラマ"],["か"],["、"],["その"],["うち"],["の"],["一","ひと"],["つ"],["に"],["着いて","ついて"],["そこ"],["に"],["宿ろう","やどろう"],["」"],["。"]]},{"verse":14,"text":"彼,かれらは進,すすんで行,いったが、ベニヤミンに属,ぞくするギベアの近,ちかくで日,ひが暮,くれたので、","tok":[["彼","かれ"],["ら"],["は"],["進んで","すすんで"],["行った","いった"],["が"],["、"],["ベニヤミン"],["に"],["属する","ぞくする"],["ギベア"],["の"],["近く","ちかく"],["で"],["日","ひ"],["が"],["暮","くれ"],["た"],["ので"],["、"]]},{"verse":15,"text":"ギベアへ行,いって宿,やどろうと、そこに道,みちを転,てんじ、町,まちにはいって、その広場,ひろばに座,ざした。だれも彼,かれらを家,いえに迎,むかえて泊,とめてくれる者,ものがなかったからである。","tok":[["ギベア"],["へ"],["行って","いって"],["宿ろう","やどろう"],["と"],["、"],["そこ"],["に"],["道","みち"],["を"],["転じ","てんじ"],["、"],["町","まち"],["に"],["はいって"],["、"],["その"],["広場","ひろば"],["に"],["座した","ざした"],["。"],["だれ"],["も"],["彼","かれ"],["ら"],["を"],["家","いえ"],["に"],["迎","むかえ"],["て"],["泊めて","とめて"],["くれる"],["者","もの"],["が"],["なかった"],["から"],["で"],["ある"],["。"]]},{"verse":16,"text":"時,ときにひとりの老人,ろうじんが夕暮,ゆうぐれに畑,はたけの仕事,しごとから帰,かえってきた。この人,ひとはエフライムの山地,さんちの者,もので、ギベアに寄留,きりゅうしていたのである。ただしこの所,ところの人々,ひとびとはベニヤミンびとであった。","tok":[["時","とき"],["に"],["ひとり"],["の"],["老人","ろうじん"],["が"],["夕暮","ゆうぐれ"],["に"],["畑","はたけ"],["の"],["仕事","しごと"],["から"],["帰えって","かえって"],["きた"],["。"],["この"],["人","ひと"],["は"],["エフライム"],["の"],["山地","さんち"],["の"],["者","もの"],["で"],["、"],["ギベア"],["に"],["寄留","きりゅう"],["して"],["いた"],["ので"],["ある"],["。"],["ただし"],["この"],["所","ところ"],["の"],["人々","ひとびと"],["は"],["ベニヤミン"],["びと"],["で"],["あった"],["。"]]},{"verse":17,"text":"彼,かれは目,めをあげて、町,まちの広場,ひろばに旅人,たびびとのおるのを見,みた。老人,ろうじんは言,いった、「あなたはどこへ行,いかれるのですか。どこからおいでになりましたか」。","tok":[["彼","かれ"],["は"],["目","め"],["を"],["あげて"],["、"],["町","まち"],["の"],["広場","ひろば"],["に"],["旅人","たびびと"],["の"],["おる"],["の"],["を"],["見た","みた"],["。"],["老人","ろうじん"],["は"],["言った","いった"],["、"],["「"],["あなた"],["は"],["どこ"],["へ"],["行かれる","いかれる"],["の"],["です"],["か"],["。"],["どこ"],["から"],["おいで"],["に"],["なりました"],["か"],["」"],["。"]]},{"verse":18,"text":"その人,ひとは言,いった、「われわれはユダのベツレヘムから、エフライムの山地,さんちの奥,おくへ行,いくものです。わたしはあそこの者,もので、ユダのベツレヘムへ行,いき、今,いまわたしの家,いえに帰,かえるところですが、だれもわたしを家,いえに泊,とめてくれる者,ものがありません。","tok":[["その"],["人","ひと"],["は"],["言った","いった"],["、"],["「"],["われわれ"],["は"],["ユダ"],["の"],["ベツレヘム"],["から"],["、"],["エフライム"],["の"],["山地","さんち"],["の"],["奥","おく"],["へ"],["行く","いく"],["もの"],["です"],["。"],["わたし"],["は"],["あそこ"],["の"],["者","もの"],["で"],["、"],["ユダ"],["の"],["ベツレヘム"],["へ"],["行き","いき"],["、"],["今","いま"],["わたし"],["の"],["家","いえ"],["に"],["帰える","かえる"],["ところ"],["です"],["が"],["、"],["だれ"],["も"],["わたし"],["を"],["家","いえ"],["に"],["泊めて","とめて"],["くれる"],["者","もの"],["が"],["ありません"],["。"]]},{"verse":19,"text":"われわれには、ろばのわらも飼葉,かいばもあり、またわたしと、はしためと、しもべと共,ともにいる若者,わかものとの食物,しょくもつも酒,さけもあって、何,なにも欠,かけているものはありません」。","tok":[["われわれ"],["に"],["は"],["、"],["ろば"],["の"],["わら"],["も"],["飼葉","かいば"],["も"],["あり"],["、"],["また"],["わたし"],["と"],["、"],["はし"],["ため"],["と"],["、"],["しもべ"],["と"],["共","とも"],["に"],["いる"],["若者","わかもの"],["と"],["の"],["食物","しょくもつ"],["も"],["酒","さけ"],["も"],["あって"],["、"],["何に","なに"],["も"],["欠けて","かけて"],["いる"],["もの"],["は"],["ありません"],["」"],["。"]]},{"verse":20,"text":"老人,ろうじんは言,いった、「安心,あんしんしなさい。あなたの必要,ひつようなものはなんでも備,そなえましょう。ただ広場,ひろばで夜,よるを過,すごしてはなりません」。","tok":[["老人","ろうじん"],["は"],["言った","いった"],["、"],["「"],["安心","あんしん"],["し"],["なさい"],["。"],["あなた"],["の"],["必要","ひつよう"],["な"],["もの"],["は"],["なん"],["で"],["も"],["備","そなえ"],["ましょう"],["。"],["ただ"],["広場","ひろば"],["で"],["夜","よる"],["を"],["過ごして","すごして"],["は"],["なりません"],["」"],["。"]]},{"verse":21,"text":"そして彼,かれを家,いえに連,つれていって、ろばに飼葉,かいばを与,あたえた。彼,かれらは足,あしを洗,あらって飲,のみ食,くいした。","tok":[["そして"],["彼","かれ"],["を"],["家","いえ"],["に"],["連れて","つれて"],["いって"],["、"],["ろば"],["に"],["飼葉","かいば"],["を"],["与","あたえ"],["た"],["。"],["彼","かれ"],["ら"],["は"],["足","あし"],["を"],["洗って","あらって"],["飲み食い","のみくい"],["した"],["。"]]},{"verse":22,"text":"彼,かれらが楽,たのしく過,すごしていた時,とき、町,まちの人々,ひとびとの悪,わるい者,ものどもがその家,いえを取,とり囲,かこみ、戸,とを打,うちたたいて、家,いえのあるじである老人,ろうじんに言,いった、「あなたの家,いえにきた人,ひとを出,だしなさい。われわれはその者,ものを知,しるであろう」。","tok":[["彼","かれ"],["ら"],["が"],["楽く","たのしく"],["過ごして","すごして"],["いた"],["時","とき"],["、"],["町","まち"],["の"],["人々","ひとびと"],["の"],["悪い","わるい"],["者","もの"],["ども"],["が"],["その"],["家","いえ"],["を"],["取囲み","とりかこみ"],["、"],["戸","と"],["を"],["打ちたたいて","うちたたいて"],["、"],["家","いえ"],["の"],["あるじ"],["で"],["ある"],["老人","ろうじん"],["に"],["言った","いった"],["、"],["「"],["あなた"],["の"],["家","いえ"],["に"],["きた"],["人","ひと"],["を"],["出し","だし"],["なさい"],["。"],["われわれ"],["は"],["その"],["者","もの"],["を"],["知るで","しるで"],["あろう"],["」"],["。"]]},{"verse":23,"text":"しかし家,いえのあるじは彼,かれらのところに出,でていって言,いった、「いいえ、兄弟,きょうだいたちよ、どうぞ、そんな悪,わるいことをしないでください。この人,ひとはすでにわたしの家,いえにはいったのだから、そんなつまらない事,ことをしないでください。","tok":[["しかし"],["家","いえ"],["の"],["あるじ"],["は"],["彼","かれ"],["ら"],["の"],["ところ"],["に"],["出て","でて"],["いって"],["言った","いった"],["、"],["「"],["いいえ"],["、"],["兄弟","きょうだい"],["たち"],["よ"],["、"],["どうぞ"],["、"],["そんな"],["悪い","わるい"],["こと"],["を"],["しないで"],["ください"],["。"],["この"],["人","ひと"],["は"],["すでに"],["わたし"],["の"],["家","いえ"],["に"],["はいった"],["の"],["だ"],["から"],["、"],["そんな"],["つまらない"],["事","こと"],["を"],["しないで"],["ください"],["。"]]},{"verse":24,"text":"ここに処女,しょじょであるわたしの娘,むすめと、この人,ひとのめかけがいます。今,いまそれを出,だしますから、それをはずかしめ、あなたがたの好,すきなようにしなさい。しかしこの人,ひとにはそのようなつまらない事,ことをしないでください」。","tok":[["ここ"],["に"],["処女","しょじょ"],["で"],["ある"],["わたし"],["の"],["娘","むすめ"],["と"],["、"],["この"],["人","ひと"],["の"],["めかけ"],["が"],["います"],["。"],["今","いま"],["それ"],["を"],["出します","だします"],["から"],["、"],["それ"],["を"],["はずかしめ"],["、"],["あなた"],["がた"],["の"],["好き","すき"],["な"],["よう"],["に"],["し"],["なさい"],["。"],["しかし"],["この"],["人","ひと"],["に"],["は"],["その"],["よう"],["な"],["つまらない"],["事","こと"],["を"],["しないで"],["ください"],["」"],["。"]]},{"verse":25,"text":"しかし人々,ひとびとが聞,ききいれなかったので、その人,ひとは自分,じぶんのめかけをとって彼,かれらのところに出,だした。彼,かれらはその女,おんなを犯,おかして朝,あさまで終夜,しゅうやはずかしめ、日,ひののぼるころになって放,はなし帰,かえらせた。","tok":[["しかし"],["人々","ひとびと"],["が"],["聞きいれなかった","ききいれなかった"],["ので"],["、"],["その"],["人","ひと"],["は"],["自分","じぶん"],["の"],["めかけ"],["を"],["とって"],["彼","かれ"],["ら"],["の"],["ところ"],["に"],["出した","だした"],["。"],["彼","かれ"],["ら"],["は"],["その"],["女","おんな"],["を"],["犯して","おかして"],["朝","あさ"],["まで"],["終夜","しゅうや"],["はずかしめ"],["、"],["日","ひ"],["の"],["のぼる"],["ころ"],["に"],["なって"],["放し","はなし"],["帰えらせた","かえらせた"],["。"]]},{"verse":26,"text":"朝,あさになって女,おんなは自分,じぶんの主人,しゅじんを宿,やどしてくれた人,ひとの家,いえの戸口,とぐちにきて倒,たおれ伏,ふし、夜,よるのあけるまでに及,およんだ。","tok":[["朝","あさ"],["に"],["なって"],["女","おんな"],["は"],["自分","じぶん"],["の"],["主人","しゅじん"],["を"],["宿して","やどして"],["くれた"],["人","ひと"],["の"],["家","いえ"],["の"],["戸口","とぐち"],["に"],["きて"],["倒れ伏し","たおれふし"],["、"],["夜","よる"],["の"],["あける"],["まで"],["に"],["及んだ","およんだ"],["。"]]},{"verse":27,"text":"彼女,かのじょの主人,しゅじんは朝,あさ起,おきて家,いえの戸,とを開,ひらき、出,でて旅立,たびだとうとすると、そのめかけである女,おんなが家,いえの戸口,とぐちに、手,てを敷居,しきいにかけて倒,たおれていた。","tok":[["彼女","かのじょ"],["の"],["主人","しゅじん"],["は"],["朝","あさ"],["起きて","おきて"],["家","いえ"],["の"],["戸","と"],["を"],["開らき","ひらき"],["、"],["出て","でて"],["旅立とう","たびだとう"],["と"],["する"],["と"],["、"],["その"],["めかけ"],["で"],["ある"],["女","おんな"],["が"],["家","いえ"],["の"],["戸口","とぐち"],["に"],["、"],["手","て"],["を"],["敷居","しきい"],["に"],["かけて"],["倒れて","たおれて"],["いた"],["。"]]},{"verse":28,"text":"彼,かれは女,おんなに向,むかって、「起,おきよ、行,いこう」と言,いったけれども、なんの答,こたえもなかった。そこでその人,ひとは女,おんなをろばに乗,のせ、立,たって自分,じぶんの家,いえにおもむいたが、","tok":[["彼","かれ"],["は"],["女","おんな"],["に"],["向かって","むかって"],["、"],["「"],["起きよ","おきよ"],["、"],["行こう","いこう"],["」"],["と"],["言った","いった"],["けれど"],["も"],["、"],["なん"],["の"],["答","こたえ"],["も"],["なかった"],["。"],["そこ"],["で"],["その"],["人","ひと"],["は"],["女","おんな"],["を"],["ろば"],["に"],["乗せ","のせ"],["、"],["立って","たって"],["自分","じぶん"],["の"],["家","いえ"],["に"],["おもむいた"],["が"],["、"]]},{"verse":29,"text":"その家,いえに着,ついたとき、刀,かたなを執,とり、めかけを捕,とらえて、そのからだを十二切,きれに断,たち切,きり、それをイスラエルの全,ぜん領域,りょういきにあまねく送,おくった。","tok":[["その"],["家","いえ"],["に"],["着いた","ついた"],["とき"],["、"],["刀","かたな"],["を"],["執り","とり"],["、"],["めかけ"],["を"],["捕らえて","とらえて"],["、"],["その"],["からだ"],["を"],["十二","じゅうに"],["切","きれ"],["に"],["断ち切り","たちきり"],["、"],["それ"],["を"],["イスラエル"],["の"],["全","ぜん"],["領域","りょういき"],["に"],["あまねく"],["送った","おくった"],["。"]]},{"verse":30,"text":"それを見,みたものはみな言,いった、「イスラエルの人々,ひとびとがエジプトの地,ちから上,のぼってきた日,ひから今日,こんにちまで、このような事,ことは起,たったこともなく、また見,みたこともない。この事,ことをよく考,かんがえ、協議,きょうぎして言,いうことを決,きめよ」。","tok":[["それ"],["を"],["見た","みた"],["もの"],["は"],["みな"],["言った","いった"],["、"],["「"],["イスラエル"],["の"],["人々","ひとびと"],["が"],["エジプト"],["の"],["地","ち"],["から"],["上って","のぼって"],["きた"],["日","ひ"],["から"],["今日","こん"],["に"],["ち"],["まで"],["、"],["この"],["よう"],["な"],["事","こと"],["は"],["起","たったこと"],["も"],["なく"],["、"],["また"],["見た","みた"],["こと"],["も"],["ない"],["。"],["この"],["事","こと"],["を"],["よく"],["考","かんがえ"],["、"],["協議","きょうぎ"],["して"],["言う","いう"],["こと"],["を"],["決めよ","きめよ"],["」"],["。"]]}]
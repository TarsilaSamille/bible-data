[{"verse":1,"text":"エフライムの人々,ひとびとは集,あつまってザポンに行,いき、エフタに言,いった、「なぜあなたは進,すすんで行,いってアンモンの人々,ひとびとと戦,たたかいながら、われわれを招,まねいて一緒,いっしょに行,いかせませんでしたか。われわれはあなたの家,いえに火,ひをつけてあなたを一緒,いっしょに焼,やいてしまいます」。","tok":[["エフライム"],["の"],["人々","ひとびと"],["は"],["集まって","あつまって"],["ザポン"],["に"],["行き","いき"],["、"],["エフタ"],["に"],["言った","いった"],["、"],["「"],["なぜ"],["あなた"],["は"],["進んで","すすんで"],["行って","いって"],["アンモン"],["の"],["人々","ひとびと"],["と"],["戦い","たたかい"],["ながら"],["、"],["われわれ"],["を"],["招いて","まねいて"],["一緒","いっしょ"],["に"],["行かせませんでした","いかせませんでした"],["か"],["。"],["われわれ"],["は"],["あなた"],["の"],["家","いえ"],["に"],["火","ひ"],["を"],["つけて"],["あなた"],["を"],["一緒","いっしょ"],["に"],["焼いて","やいて"],["しまいます"],["」"],["。"]]},{"verse":2,"text":"エフタは彼,かれらに言,いった、「かつてわたしとわたしの民,たみがアンモンの人々,ひとびとと大,おおいに争,あらそったとき、あなたがたを呼,よんだが、あなたがたはわたしを彼,かれらの手,てから救,すくってくれませんでした。","tok":[["エフタ"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["かつて"],["わたし"],["と"],["わたし"],["の"],["民","たみ"],["が"],["アンモン"],["の"],["人々","ひとびと"],["と"],["大いに","おおいに"],["争った","あらそった"],["とき"],["、"],["あなた"],["がた"],["を"],["呼んだ","よんだ"],["が"],["、"],["あなた"],["がた"],["は"],["わたし"],["を"],["彼","かれ"],["ら"],["の"],["手","て"],["から"],["救って","すくって"],["くれませんでした"],["。"]]},{"verse":3,"text":"あなたがたが救,すくってくれないのを見,みたから、わたしは命,いのちがけでアンモンの人々,ひとびとのところへ攻,せめて行,いきますと、主,しゅは彼,かれらをわたしの手,てにわたされたのです。どうしてあなたがたは、きょう、わたしのところに上,のぼってきて、わたしと戦,たたかおうとするのですか」。","tok":[["あなた"],["がた"],["が"],["救って","すくって"],["くれない"],["の"],["を"],["見た","みた"],["から"],["、"],["わたし"],["は"],["命がけ","いのちがけ"],["で"],["アンモン"],["の"],["人々","ひとびと"],["の"],["ところ"],["へ"],["攻めて","せめて"],["行きます","いきます"],["と"],["、"],["主","しゅ"],["は"],["彼","かれ"],["ら"],["を"],["わたし"],["の"],["手","て"],["に"],["わたされた"],["の"],["です"],["。"],["どう"],["して"],["あなた"],["がた"],["は"],["、"],["きょう"],["、"],["わたし"],["の"],["ところ"],["に"],["上って","のぼって"],["きて"],["、"],["わたし"],["と"],["戦おう","たたかおう"],["と"],["する"],["の"],["です"],["か"],["」"],["。"]]},{"verse":4,"text":"そこでエフタはギレアデの人々,ひとびとをことごとく集,あつめてエフライムと戦,たたかい、ギレアデの人々,ひとびとはエフライムを撃,うち破,やぶった。これはエフライムが「ギレアデびとよ、あなたがたはエフライムとマナセのうちにいるエフライムの落人,おちうどだ」と言,いったからである。","tok":[["そこ"],["で"],["エフタ"],["は"],["ギレアデ"],["の"],["人々","ひとびと"],["を"],["ことごとく"],["集めて","あつめて"],["エフライム"],["と"],["戦い","たたかい"],["、"],["ギレアデ"],["の"],["人々","ひとびと"],["は"],["エフライム"],["を"],["撃ち破った","うちやぶった"],["。"],["これ"],["は"],["エフライム"],["が"],["「"],["ギレアデ"],["びと"],["よ"],["、"],["あなた"],["がた"],["は"],["エフライム"],["と"],["マナセ"],["の"],["うち"],["に"],["いる"],["エフライム"],["の"],["落人","おちうど"],["だ"],["」"],["と"],["言った","いった"],["から"],["で"],["ある"],["。"]]},{"verse":5,"text":"そしてギレアデびとはエフライムに渡,わたるヨルダンの渡,わたし場,ばを押,おさえたので、エフライムの落人,おちうどが「渡,わたらせてください」と言,いうとき、ギレアデの人々,ひとびとは「あなたはエフライムびとですか」と問,とい、その人,ひとがもし「そうではありません」と言,いうならば、","tok":[["そして"],["ギレアデ"],["びと"],["は"],["エフライム"],["に"],["渡る","わたる"],["ヨルダン"],["の"],["渡場","わたしば"],["を"],["押さえた","おさえた"],["ので"],["、"],["エフライム"],["の"],["落人","おちうど"],["が"],["「"],["渡らせて","わたらせて"],["ください"],["」"],["と"],["言う","いう"],["とき"],["、"],["ギレアデ"],["の"],["人々","ひとびと"],["は"],["「"],["あなた"],["は"],["エフライム"],["びと"],["です"],["か"],["」"],["と"],["問","とい"],["、"],["その"],["人","ひと"],["が"],["もし"],["「"],["そう"],["で"],["は"],["ありません"],["」"],["と"],["言うならば","いうならば"],["、"]]},{"verse":6,"text":"またその人,ひとに「では『シボレテ』と言,いってごらんなさい」と言,いい、その人,ひとがそれを正,ただしく発音,はつおんすることができないで「セボレテ」と言,いうときは、その人,ひとを捕,とらえて、ヨルダンの渡,わたし場,ばで殺,ころした。その時,ときエフライムびとの倒,たおれたものは四万二千人,にんであった。","tok":[["また"],["その"],["人","ひと"],["に"],["「"],["で"],["は"],["『"],["シボレテ"],["』"],["と"],["言って","いって"],["ごらん"],["なさい"],["」"],["と"],["言い","いい"],["、"],["その"],["人","ひと"],["が"],["それ"],["を"],["正く","ただしく"],["発音","はつおん"],["する"],["こと"],["が"],["できないで"],["「"],["セボレテ"],["」"],["と"],["言う","いう"],["とき"],["は"],["、"],["その"],["人","ひと"],["を"],["捕らえて","とらえて"],["、"],["ヨルダン"],["の"],["渡場","わたしば"],["で"],["殺ろした","ころした"],["。"],["その"],["時","とき"],["エフライム"],["びと"],["の"],["倒れた","たおれた"],["もの"],["は"],["四万二千","よんまんにせん"],["人","にん"],["で"],["あった"],["。"]]},{"verse":7,"text":"エフタは六年,ねんの間,あいだイスラエルをさばいた。ギレアデびとエフタはついに死,しんで、ギレアデの自分,じぶんの町,まちに葬,ほうむられた。","tok":[["エフタ"],["は"],["六","ろく"],["年","ねん"],["の"],["間","あいだ"],["イスラエル"],["を"],["さばいた"],["。"],["ギレアデ"],["びと"],["エフタ"],["は"],["ついに"],["死んで","しんで"],["、"],["ギレアデ"],["の"],["自分","じぶん"],["の"],["町","まち"],["に"],["葬むられた","ほうむられた"],["。"]]},{"verse":8,"text":"彼,かれの後,のちにベツレヘムのイブザンがイスラエルをさばいた。","tok":[["彼","かれ"],["の"],["後","のち"],["に"],["ベツレヘム"],["の"],["イブザン"],["が"],["イスラエル"],["を"],["さばいた"],["。"]]},{"verse":9,"text":"彼,かれに三十人,にんのむすこがあった。また三十人,にんの娘,むすめがあったが、それを自分,じぶんの氏族,しぞく以外,いがいの者,ものにとつがせ、むすこたちのためには三十人,にんの娘,むすめをほかからめとった。彼,かれは七年,ねんの間,あいだイスラエルをさばいた。","tok":[["彼","かれ"],["に"],["三","さん"],["十人","じゅうにん"],["の"],["むすこ"],["が"],["あった"],["。"],["また"],["三","さん"],["十人","じゅうにん"],["の"],["娘","むすめ"],["が"],["あった"],["が"],["、"],["それ"],["を"],["自分","じぶん"],["の"],["氏族","しぞく"],["以外","いがい"],["の"],["者","もの"],["に"],["とつがせ"],["、"],["むすこ"],["たち"],["の"],["ため"],["に"],["は"],["三","さん"],["十人","じゅうにん"],["の"],["娘","むすめ"],["を"],["ほか"],["からめとった"],["。"],["彼","かれ"],["は"],["七","なな"],["年","ねん"],["の"],["間","あいだ"],["イスラエル"],["を"],["さばいた"],["。"]]},{"verse":10,"text":"イブザンはついに死,しんで、ベツレヘムに葬,ほうむられた。","tok":[["イブザン"],["は"],["ついに"],["死んで","しんで"],["、"],["ベツレヘム"],["に"],["葬むられた","ほうむられた"],["。"]]},{"verse":11,"text":"彼,かれの後,のちにゼブルンびとエロンがイスラエルをさばいた。彼,かれは十年,ねんの間,あいだイスラエルをさばいた。","tok":[["彼","かれ"],["の"],["後","のち"],["に"],["ゼブルン"],["びと"],["エロン"],["が"],["イスラエル"],["を"],["さばいた"],["。"],["彼","かれ"],["は"],["十","じゅう"],["年","ねん"],["の"],["間","あいだ"],["イスラエル"],["を"],["さばいた"],["。"]]},{"verse":12,"text":"ゼブルンびとエロンはついに死,しんで、ゼブルンの地,ちのアヤロンに葬,ほうむられた。","tok":[["ゼブルン"],["びと"],["エロン"],["は"],["ついに"],["死んで","しんで"],["、"],["ゼブルン"],["の"],["地","ち"],["の"],["アヤロン"],["に"],["葬むられた","ほうむられた"],["。"]]},{"verse":13,"text":"彼,かれの後,のちにピラトンびとヒレルの子,こアブドンがイスラエルをさばいた。","tok":[["彼","かれ"],["の"],["後","のち"],["に"],["ピラトン"],["びと"],["ヒレル"],["の"],["子","こ"],["アブドン"],["が"],["イスラエル"],["を"],["さばいた"],["。"]]},{"verse":14,"text":"彼,かれに四十人,にんのむすこ及,および三十人,にんの孫,まごがあり、七十頭,とうのろばに乗,のった。彼,かれは八年,ねんの間,あいだイスラエルをさばいた。","tok":[["彼","かれ"],["に"],["四","よん"],["十人","じゅうにん"],["の"],["むすこ"],["及","および"],["三","さん"],["十人","じゅうにん"],["の"],["孫","まご"],["が"],["あり"],["、"],["七十頭","とう"],["の"],["ろば"],["に"],["乗った","のった"],["。"],["彼","かれ"],["は"],["八","はち"],["年","ねん"],["の"],["間","あいだ"],["イスラエル"],["を"],["さばいた"],["。"]]},{"verse":15,"text":"ピラトンびとヒレルの子,こアブドンはついに死,しんで、エフライムの地,ちのアマレクびとの山地,さんちにあるピラトンに葬,ほうむられた。","tok":[["ピラトン"],["びと"],["ヒレル"],["の"],["子","こ"],["アブドン"],["は"],["ついに"],["死んで","しんで"],["、"],["エフライム"],["の"],["地","ち"],["の"],["アマレク"],["びと"],["の"],["山地","さんち"],["に"],["ある"],["ピラトン"],["に"],["葬むられた","ほうむられた"],["。"]]}]
[{"verse":1,"text":"その日,ひデボラとアビノアムの子,こバラクは歌,うたって言,いった。","tok":[["その"],["日","ひ"],["デボラ"],["と"],["アビノアム"],["の"],["子","こ"],["バラク"],["は"],["歌","うた"],["って"],["言った","いった"],["。"]]},{"verse":2,"text":"「イスラエルの指導者,しどうしゃたちは先,さきに立,たち、民,たみは喜,よろこび勇,いさんで進,すすみ出,でた。主,しゅをさんびせよ。","tok":[["「"],["イスラエル"],["の"],["指導者","しどうしゃ"],["たち"],["は"],["先","さき"],["に"],["立ち","たち"],["、"],["民","たみ"],["は"],["喜こび","よろこび"],["勇んで","いさんで"],["進み出た","すすみでた"],["。"],["主","しゅ"],["を"],["さん"],["び"],["せよ"],["。"]]},{"verse":3,"text":"もろもろの王,おうよ聞,きけ、もろもろの君,きみよ、耳,みみを傾,かたむけよ。わたしは主,しゅに向,むかって歌,うたおう、わたしはイスラエルの神,かみ、主,しゅをほめたたえよう。","tok":[["もろもろ"],["の"],["王","おう"],["よ"],["聞け","きけ"],["、"],["もろもろ"],["の"],["君","きみ"],["よ"],["、"],["耳","みみ"],["を"],["傾むけよ","かたむけよ"],["。"],["わたし"],["は"],["主に","しゅに"],["向かって","むかって"],["歌おう","うたおう"],["、"],["わたし"],["は"],["イスラエル"],["の"],["神","かみ"],["、"],["主","しゅ"],["を"],["ほめたたえよう"],["。"]]},{"verse":4,"text":"主,しゅよ、あなたがセイルを出,で、エドムの地,ちから進,すすまれたとき、地,ちは震,ふるい、天,てんはしたたり、雲,くもは水,みずをしたたらせた。","tok":[["主","しゅ"],["よ"],["、"],["あなた"],["が"],["セイル"],["を"],["出","で"],["、"],["エドム"],["の"],["地","ち"],["から"],["進まれた","すすまれた"],["とき"],["、"],["地","ち"],["は"],["震い","ふるい"],["、"],["天","てん"],["は"],["した"],["たり"],["、"],["雲","くも"],["は"],["水","みず"],["を"],["したたらせた"],["。"]]},{"verse":5,"text":"もろもろの山,やまは主,しゅの前,まえに揺,ゆり動,うごき、シナイの主,しゅ、すなわちイスラエルの神,かみ、主,しゅの前,まえに揺,ゆり動,うごいた。","tok":[["もろもろ"],["の"],["山","やま"],["は"],["主","しゅ"],["の"],["前","まえ"],["に"],["揺り","ゆり"],["動き","うごき"],["、"],["シナイ"],["の"],["主","しゅ"],["、"],["すなわち"],["イスラエル"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["揺り","ゆり"],["動いた","うごいた"],["。"]]},{"verse":6,"text":"アナテの子,こシャムガルのとき、ヤエルの時,ときには隊商,たいしょうは絶,たえ、旅人,たびびとはわき道,みちをとおった。","tok":[["アナテ"],["の"],["子","こ"],["シャムガル"],["の"],["とき"],["、"],["ヤエル"],["の"],["時","とき"],["に"],["は"],["隊商","たいしょう"],["は"],["絶え","たえ"],["、"],["旅人","たびびと"],["は"],["わき道","わきみち"],["を"],["とおった"],["。"]]},{"verse":7,"text":"イスラエルには農民,のうみんが絶,たえ、かれらは絶,たえ果,はてたが、デボラよ、ついにあなたは立,たちあがり、立,たってイスラエルの母,ははとなった。","tok":[["イスラエル"],["に"],["は"],["農民","のうみん"],["が"],["絶え","たえ"],["、"],["かれ"],["ら"],["は"],["絶え","たえ"],["果てた","はてた"],["が"],["、"],["デボラ"],["よ"],["、"],["ついに"],["あなた"],["は"],["立ちあがり","たちあがり"],["、"],["立って","たって"],["イスラエル"],["の"],["母","はは"],["と"],["なった"],["。"]]},{"verse":8,"text":"人々,ひとびとが新,あたらしい神々,かみがみを選,えらんだとき、戦,たたかいは門,もんに及,およんだ。イスラエルの四万人,にんのうちに、盾,たてあるいは槍,やりの見,みられたことがあったか。","tok":[["人々","ひとびと"],["が"],["新らしい","あたらしい"],["神々","かみがみ"],["を"],["選らんだ","えらんだ"],["とき"],["、"],["戦い","たたかい"],["は"],["門","もん"],["に"],["及んだ","およんだ"],["。"],["イスラエル"],["の"],["四万人","にん"],["の"],["うち"],["に"],["、"],["盾","たて"],["あるいは"],["槍","やり"],["の"],["見られた","みられた"],["こと"],["が"],["あった"],["か"],["。"]]},{"verse":9,"text":"わたしの心,こころは民,たみのうちの喜,よろこび勇,いさんで進,すすみ出,でたイスラエルのつかさたちと共,ともにある。主,しゅをさんびせよ。","tok":[["わたし"],["の"],["心","こころ"],["は"],["民","たみ"],["の"],["うち"],["の"],["喜こび","よろこび"],["勇んで","いさんで"],["進み出た","すすみでた"],["イスラエル"],["の"],["つかさ"],["たち"],["と"],["共","とも"],["に"],["ある"],["。"],["主","しゅ"],["を"],["さん"],["び"],["せよ"],["。"]]},{"verse":10,"text":"茶色,ちゃいろのろばに乗,のるもの、毛氈,もうせんの上,うえにすわるもの、および道,みちを歩,あゆむものよ、共,ともに歌,うたえ。","tok":[["茶色","ちゃいろ"],["の"],["ろば"],["に"],["乗る","のる"],["もの"],["、"],["毛氈","もうせん"],["の"],["上","うえ"],["に"],["すわる"],["もの"],["、"],["および"],["道","みち"],["を"],["歩む","あゆむ"],["もの"],["よ"],["、"],["共","とも"],["に"],["歌え","うたえ"],["。"]]},{"verse":11,"text":"楽人,がくじんの調,しらべは水,みずくむ所,ところに聞,きこえる。かれらはそこで主,しゅの救,すくいを唱,となえ、イスラエルの農民,のうみんの救,すくいを唱,となえている。その時,とき、主,しゅの民,たみは門,もんに下,くだって行,いった。","tok":[["楽人","がくじん"],["の"],["調べ","しらべ"],["は"],["水","みず"],["くむ"],["所","ところ"],["に"],["聞こえる","きこえる"],["。"],["かれ"],["ら"],["は"],["そこ"],["で"],["主","しゅ"],["の"],["救い","すくい"],["を"],["唱え","となえ"],["、"],["イスラエル"],["の"],["農民","のうみん"],["の"],["救い","すくい"],["を"],["唱えて","となえて"],["いる"],["。"],["その"],["時","とき"],["、"],["主","しゅ"],["の"],["民","たみ"],["は"],["門","もん"],["に"],["下って","くだって"],["行った","いった"],["。"]]},{"verse":12,"text":"起,おきよ、起,おきよ、デボラ。起,おきよ、起,おきよ、歌,うたをうたえ。立,たてよ、バラク、とりこを捕,とらえよ、アビノアムの子,こよ。","tok":[["起きよ","おきよ"],["、"],["起きよ","おきよ"],["、"],["デボラ"],["。"],["起きよ","おきよ"],["、"],["起きよ","おきよ"],["、"],["歌","うた"],["を"],["うたえ"],["。"],["立","たて"],["よ"],["、"],["バラク"],["、"],["とりこ"],["を"],["捕らえよ","とらえよ"],["、"],["アビノアム"],["の"],["子","こ"],["よ"],["。"]]},{"verse":13,"text":"その時,とき、残,のこった者,ものは尊,たっとい者,もののように下,くだって行,いき、主,しゅの民,たみは勇士,ゆうしのように下,くだって行,いった。","tok":[["その"],["時","とき"],["、"],["残った","のこった"],["者","もの"],["は"],["尊","た"],["っと"],["い"],["者","もの"],["の"],["よう"],["に"],["下って","くだって"],["行き","いき"],["、"],["主","しゅ"],["の"],["民","たみ"],["は"],["勇士","ゆうし"],["の"],["よう"],["に"],["下って","くだって"],["行った","いった"],["。"]]},{"verse":14,"text":"彼,かれらはエフライムから出,でて谷,たにに進,すすみ、兄弟,きょうだいベニヤミンはあなたの民,たみのうちにある。マキルからはつかさたちが下,くだって行,いき、ゼブルンからは指揮,しきを執,とるものが下,くだって行,いった。","tok":[["彼","かれ"],["ら"],["は"],["エフライム"],["から"],["出て","でて"],["谷","たに"],["に"],["進み","すすみ"],["、"],["兄弟","きょうだい"],["ベニヤミン"],["は"],["あなた"],["の"],["民","たみ"],["の"],["うち"],["に"],["ある"],["。"],["マキル"],["から"],["は"],["つかさ"],["たち"],["が"],["下って","くだって"],["行き","いき"],["、"],["ゼブルン"],["から"],["は"],["指揮","しき"],["を"],["執る","とる"],["もの"],["が"],["下って","くだって"],["行った","いった"],["。"]]},{"verse":15,"text":"イッサカルの君,きみたちはデボラと共,ともにおり、イッサカルはバラクと同,おなじく、直,ただちにそのあとについて谷,たにに突進,とっしんした。しかしルベンの氏族,しぞくは大,おおいに思案,しあんした。","tok":[["イッサカル"],["の"],["君","きみ"],["たち"],["は"],["デボラ"],["と"],["共","とも"],["に"],["おり"],["、"],["イッサカル"],["は"],["バラク"],["と"],["同じく","おなじく"],["、"],["直ちに","ただちに"],["その"],["あと"],["について"],["谷","たに"],["に"],["突進","とっしん"],["した"],["。"],["しかし"],["ルベン"],["の"],["氏族","しぞく"],["は"],["大いに","おおいに"],["思案","しあん"],["した"],["。"]]},{"verse":16,"text":"なぜ、あなたは、おりの間,あいだにとどまって、羊,ひつじの群,むれに笛,ふえ吹,ふくのを聞,きいているのか。ルベンの氏族,しぞくは大,おおいに思案,しあんした。","tok":[["なぜ"],["、"],["あなた"],["は"],["、"],["おり"],["の"],["間","あいだ"],["に"],["とどまって"],["、"],["羊","ひつじ"],["の"],["群れ","むれ"],["に"],["笛","ふえ"],["吹く","ふく"],["の"],["を"],["聞いて","きいて"],["いる"],["の"],["か"],["。"],["ルベン"],["の"],["氏族","しぞく"],["は"],["大いに","おおいに"],["思案","しあん"],["した"],["。"]]},{"verse":17,"text":"ギレアデはヨルダンの向,むこうにとどまっていた。なぜ、ダンは舟,ふねのかたわらにとどまったか。アセルは浜,はまべに座,ざし、その波止場,はとばのかたわらにとどまっていた。","tok":[["ギレアデ"],["は"],["ヨルダン"],["の"],["向こう","むこう"],["に"],["とどまって"],["いた"],["。"],["なぜ"],["、"],["ダン"],["は"],["舟","ふね"],["の"],["かたわら"],["に"],["とどまった"],["か"],["。"],["アセル"],["は"],["浜べ","はまべ"],["に"],["座し","ざし"],["、"],["その"],["波止場","はとば"],["の"],["かたわら"],["に"],["とどまって"],["いた"],["。"]]},{"verse":18,"text":"ゼブルンは命,いのちをすてて、死,しを恐,おそれぬ民,たみである。野,のの高,たかい所,ところにおるナフタリもまたそうであった。","tok":[["ゼブルン"],["は"],["命","いのち"],["を"],["すてて"],["、"],["死","し"],["を"],["恐れぬ","おそれぬ"],["民","たみ"],["で"],["ある"],["。"],["野","の"],["の"],["高い","たかい"],["所","ところ"],["に"],["おる"],["ナフタリ"],["も"],["また"],["そう"],["で"],["あった"],["。"]]},{"verse":19,"text":"もろもろの王,おうたちはきて戦,たたかった。その時,ときカナンの王,おうたちは、メギドの水,みずのほとりのタアナクで戦,たたかった。彼,かれらは一片,いっぺんの銀,ぎんをも獲,えなかった。","tok":[["もろもろ"],["の"],["王","おう"],["たち"],["は"],["きて"],["戦った","たたかった"],["。"],["その"],["時","とき"],["カナン"],["の"],["王","おう"],["たち"],["は"],["、"],["メギド"],["の"],["水","みず"],["の"],["ほとり"],["の"],["タアナク"],["で"],["戦った","たたかった"],["。"],["彼","かれ"],["ら"],["は"],["一片","いっぺん"],["の"],["銀","ぎん"],["を"],["も"],["獲なかった","えなかった"],["。"]]},{"verse":20,"text":"もろもろの星,ほしは天,てんより戦,たたかい、その軌道,きどうをはなれてシセラと戦,たたかった。","tok":[["もろもろ"],["の"],["星","ほし"],["は"],["天","てん"],["より"],["戦い","たたかい"],["、"],["その"],["軌道","きどう"],["を"],["はなれて"],["シセラ"],["と"],["戦った","たたかった"],["。"]]},{"verse":21,"text":"キションの川,かわは彼,かれらを押,おし流,ながした、激,はげしく流,ながれる川,かわ、キションの川,かわ。わが魂,たましいよ、勇,いさましく進,すすめ。","tok":[["キション"],["の"],["川","かわ"],["は"],["彼","かれ"],["ら"],["を"],["押","おし"],["流した","ながした"],["、"],["激しく","はげしく"],["流れる","ながれる"],["川","かわ"],["、"],["キション"],["の"],["川","かわ"],["。"],["わが"],["魂","たましい"],["よ"],["、"],["勇ましく","いさましく"],["進め","すすめ"],["。"]]},{"verse":22,"text":"その時,とき、軍馬,ぐんばははせ駆,かけり、馬,うまのひずめは地,ちを踏,ふみならした。","tok":[["その"],["時","とき"],["、"],["軍馬","ぐんば"],["は"],["はせ"],["駆けり","かけり"],["、"],["馬","うま"],["の"],["ひずめ"],["は"],["地","ち"],["を"],["踏みならした","ふみならした"],["。"]]},{"verse":23,"text":"主,しゅの使,つかいは言,いった、『メロズをのろえ、激,はげしくその民,たみをのろえ、彼,かれらはきて主,しゅを助,たすけず、主,しゅを助,たすけて勇士,ゆうしを攻,せめなかったからである』。","tok":[["主","しゅ"],["の"],["使い","つかい"],["は"],["言った","いった"],["、"],["『"],["メロズ"],["を"],["のろえ"],["、"],["激しく","はげしく"],["その"],["民","たみ"],["を"],["のろえ"],["、"],["彼","かれ"],["ら"],["は"],["きて"],["主","しゅ"],["を"],["助けず","たすけず"],["、"],["主","しゅ"],["を"],["助けて","たすけて"],["勇士","ゆうし"],["を"],["攻めなかった","せめなかった"],["から"],["で"],["ある"],["』"],["。"]]},{"verse":24,"text":"ケニびとヘベルの妻,つまヤエルは、女,おんなのうちの最,もっとも恵,めぐまれた者,もの、天幕,てんまくに住,すむ女,おんなのうち最,もっとも恵,めぐまれた者,ものである。","tok":[["ケニ"],["びと"],["ヘベル"],["の"],["妻","つま"],["ヤエル"],["は"],["、"],["女","おんな"],["の"],["うち"],["の"],["最も","もっとも"],["恵まれた","めぐまれた"],["者","もの"],["、"],["天幕","てんまく"],["に"],["住む","すむ"],["女","おんな"],["の"],["うち"],["最も","もっとも"],["恵まれた","めぐまれた"],["者","もの"],["で"],["ある"],["。"]]},{"verse":25,"text":"シセラが水,みずを求,もとめると、ヤエルは乳,ちちを与,あたえた。すなわち貴重,きちょうな鉢,はちに凝乳,ぎょうにゅうを盛,もってささげた。","tok":[["シセラ"],["が"],["水","みず"],["を"],["求める","もとめる"],["と"],["、"],["ヤエル"],["は"],["乳","ちち"],["を"],["与","あたえ"],["た"],["。"],["すなわち"],["貴重","きちょう"],["な"],["鉢","はち"],["に"],["凝乳","ぎょうにゅう"],["を"],["盛って","もって"],["ささげた"],["。"]]},{"verse":26,"text":"ヤエルはくぎに手,てをかけ、右手,みぎてに重,おもい槌,つちをとって、シセラを打,うち、その頭,あたまを砕,くだき、粉々,こなごなにして、そのこめかみを打,うち貫,つらぬいた。","tok":[["ヤエル"],["は"],["くぎ"],["に"],["手","て"],["を"],["かけ"],["、"],["右手","みぎて"],["に"],["重い","おもい"],["槌","つち"],["を"],["とって"],["、"],["シセラ"],["を"],["打ち","うち"],["、"],["その"],["頭","あたま"],["を"],["砕き","くだき"],["、"],["粉々","こなごな"],["に"],["して"],["、"],["その"],["こめかみ"],["を"],["打ち","うち"],["貫ぬいた","つらぬいた"],["。"]]},{"verse":27,"text":"シセラはヤエルの足,あしもとにかがんで倒,たおれ伏,ふし、その足,あしもとにかがんで倒,たおれ、そのかがんだ所,ところに倒,たおれて死,しんだ。","tok":[["シセラ"],["は"],["ヤエル"],["の"],["足もと","あしもと"],["に"],["かがんで"],["倒れ伏し","たおれふし"],["、"],["その"],["足もと","あしもと"],["に"],["かがんで"],["倒れ","たおれ"],["、"],["その"],["かがんだ"],["所","ところ"],["に"],["倒れて","たおれて"],["死んだ","しんだ"],["。"]]},{"verse":28,"text":"シセラの母,ははは窓,まどからながめ、格子,こうし窓,まどから叫,さけんで言,いった、『どうして彼,かれの車,くるまの来,くるのがおそいのか、どうして彼,かれの車,くるまの歩,あゆみがはかどらないのか』。","tok":[["シセラ"],["の"],["母","はは"],["は"],["窓","まど"],["から"],["ながめ"],["、"],["格子窓","こうしまど"],["から"],["叫けんで","さけんで"],["言った","いった"],["、"],["『"],["どう"],["して"],["彼","かれ"],["の"],["車","くるま"],["の"],["来る","くる"],["の"],["が"],["おそい"],["の"],["か"],["、"],["どう"],["して"],["彼","かれ"],["の"],["車","くるま"],["の"],["歩み","あゆみ"],["が"],["はかどらない"],["の"],["か"],["』"],["。"]]},{"verse":29,"text":"その侍女,じじょたちの賢,かしこい者,ものは答,こたえ、母,ははまたみずからおのれに答,こたえて言,いった、","tok":[["その"],["侍女","じじょ"],["たち"],["の"],["賢しこい","かしこい"],["者","もの"],["は"],["答","こたえ"],["、"],["母","はは"],["また"],["みずから"],["おのれ"],["に"],["答","こたえ"],["て"],["言った","いった"],["、"]]},{"verse":30,"text":"『彼,かれらは獲物,えものを得,えて、それを分,わけているのではないか、人,ひとごとにひとり、ふたりのおなごを取,とり、シセラの獲物,えものは色,いろ染,ぞめの衣,ころも、縫,ぬい取,とりした色,いろ染,ぞめの衣,ころもの獲物,えものであろう。すなわち縫,ぬい取,とりした色,いろ染,ぞめの衣,ころも二つを、獲物,えものとしてそのくびにまとうであろう』。","tok":[["『"],["彼","かれ"],["ら"],["は"],["獲物","えもの"],["を"],["得て","えて"],["、"],["それ"],["を"],["分けて","わけて"],["いる"],["ので"],["は"],["ない"],["か"],["、"],["人ごと","ひとごと"],["に"],["ひとり"],["、"],["ふたり"],["の"],["おなご"],["を"],["取","とり"],["、"],["シセラ"],["の"],["獲物","えもの"],["は"],["色染","いろぞめ"],["の"],["衣","ころも"],["、"],["縫","ぬい"],["取","とり"],["した"],["色染","いろぞめ"],["の"],["衣","ころも"],["の"],["獲物","えもの"],["で"],["あろう"],["。"],["すなわち"],["縫","ぬい"],["取","とり"],["した"],["色染","いろぞめ"],["の"],["衣","ころも"],["二","ふた"],["つ"],["を"],["、"],["獲物","えもの"],["として"],["その"],["くび"],["に"],["まとうで"],["あろう"],["』"],["。"]]},{"verse":31,"text":"主,しゅよ、あなたの敵,てきはみなこのように滅,ほろび、あなたを愛,あいする者,ものを太陽,たいようの勢,いきおいよく上,のぼるようにしてください」。こうして後,のち、国,くには四十年,ねんのあいだ太平,たいへいであった。","tok":[["主","しゅ"],["よ"],["、"],["あなた"],["の"],["敵","てき"],["は"],["みな"],["この"],["よう"],["に"],["滅び","ほろび"],["、"],["あなた"],["を"],["愛する","あいする"],["者","もの"],["を"],["太陽","たいよう"],["の"],["勢","いきおい"],["よく"],["上る","のぼる"],["よう"],["に"],["して"],["ください"],["」"],["。"],["こう"],["して"],["後","の"],["ち"],["、"],["国","くに"],["は"],["四十","よんじゅう"],["年","ねん"],["の"],["あいだ"],["太平","たいへい"],["で"],["あった"],["。"]]}]
[{"verse":1,"text":"すべてカナンのもろもろの戦争,せんそうを知,しらないイスラエルの人々,ひとびとを試,こころみるために、主,しゅが残,のこしておかれた国民,こくみんは次,つぎのとおりである。","tok":[["すべて"],["カナン"],["の"],["もろもろ"],["の"],["戦争","せんそう"],["を"],["知らない","しらない"],["イスラエル"],["の"],["人々","ひとびと"],["を"],["試みる","こころみる"],["ため"],["に"],["、"],["主","しゅ"],["が"],["残して","のこして"],["おかれた"],["国民","こくみん"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"]]},{"verse":2,"text":"これはただイスラエルの代々,よよの子孫,しそん、特,とくにまだ戦争,せんそうを知,しらないものに、それを教,おしえ知,しらせるためである。","tok":[["これ"],["は"],["ただ"],["イスラエル"],["の"],["代々","よよ"],["の"],["子孫","しそん"],["、"],["特に","とくに"],["まだ"],["戦争","せんそう"],["を"],["知らない","しらない"],["もの"],["に"],["、"],["それ"],["を"],["教え","おしえ"],["知らせる","しらせる"],["ため"],["で"],["ある"],["。"]]},{"verse":3,"text":"すなわちペリシテびとの五人,にんの君,きみたちと、すべてのカナンびとと、シドンびとおよびレバノン山,やまに住,すんで、バアル・ヘルモン山,やまからハマテの入口,いりぐちまでを占,しめていたヒビびとなどであって、","tok":[["すなわち"],["ペリシテ"],["びと"],["の"],["五人","にん"],["の"],["君","きみ"],["たち"],["と"],["、"],["すべて"],["の"],["カナン"],["びと"],["と"],["、"],["シドン"],["びと"],["および"],["レバノン"],["山","やま"],["に"],["住んで","すんで"],["、"],["バアル"],["・"],["ヘルモン"],["山","やま"],["から"],["ハマテ"],["の"],["入口","いりぐち"],["まで"],["を"],["占めて","しめて"],["いた"],["ヒビ"],["びと"],["など"],["で"],["あって"],["、"]]},{"verse":4,"text":"これらをもってイスラエルを試,こころみ、主,しゅがモーセによって先祖,せんぞたちに命,めいじられた命令,めいれいに、彼,かれらが従,したがうかどうかを知,しろうとされたのである。","tok":[["これ"],["ら"],["を"],["もって"],["イスラエル"],["を"],["試み","こころみ"],["、"],["主","しゅ"],["が"],["モーセ"],["によって"],["先祖","せんぞ"],["たち"],["に"],["命じられた","めいじられた"],["命令","めいれい"],["に"],["、"],["彼","かれ"],["ら"],["が"],["従う","したがう"],["か"],["どう"],["か"],["を"],["知ろう","しろう"],["と"],["された"],["ので"],["ある"],["。"]]},{"verse":5,"text":"しかるにイスラエルの人々,ひとびとはカナンびと、ヘテびと、アモリびと、ペリジびと、ヒビびと、エブスびとのうちに住,すんで、","tok":[["しかる"],["に"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["カナン"],["び"],["と"],["、"],["ヘテ"],["び"],["と"],["、"],["アモリ"],["び"],["と"],["、"],["ペリジ"],["び"],["と"],["、"],["ヒビ"],["び"],["と"],["、"],["エブス"],["びと"],["の"],["うち"],["に"],["住んで","すんで"],["、"]]},{"verse":6,"text":"彼,かれらの娘,むすめを妻,つまにめとり、また自分,じぶんたちの娘,むすめを彼,かれらのむすこに与,あたえて、彼,かれらの神々,かみがみに仕,つかえた。","tok":[["彼","かれ"],["ら"],["の"],["娘","むすめ"],["を"],["妻","つま"],["に"],["めとり"],["、"],["また"],["自分","じぶん"],["たち"],["の"],["娘","むすめ"],["を"],["彼","かれ"],["ら"],["の"],["むすこ"],["に"],["与","あたえ"],["て"],["、"],["彼","かれ"],["ら"],["の"],["神々","かみがみ"],["に"],["仕えた","つかえた"],["。"]]},{"verse":7,"text":"こうしてイスラエルの人々,ひとびとは主,しゅの前,まえに悪,あくを行,おこない、自分,じぶんたちの神,かみ、主,しゅを忘,わすれて、バアルおよびアシラに仕,つかえた。","tok":[["こう"],["して"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["主","しゅ"],["の"],["前","まえ"],["に"],["悪","あく"],["を"],["行ない","おこない"],["、"],["自分","じぶん"],["たち"],["の"],["神","かみ"],["、"],["主","しゅ"],["を"],["忘て","わすれて"],["、"],["バアル"],["および"],["アシラ"],["に"],["仕えた","つかえた"],["。"]]},{"verse":8,"text":"そこで主,しゅはイスラエルに対,たいして激,はげしく怒,いかり、彼,かれらをメソポタミヤの王,おうクシャン・リシャタイムの手,てに売,うりわたされたので、イスラエルの人々,ひとびとは八年,ねんの間,あいだ、クシャン・リシャタイムに仕,つかえた。","tok":[["そこ"],["で"],["主","しゅ"],["は"],["イスラエル"],["に対して","にたいして"],["激しく","はげしく"],["怒り","いかり"],["、"],["彼","かれ"],["ら"],["を"],["メソポタミヤ"],["の"],["王","おう"],["クシャン"],["・"],["リシャタイム"],["の"],["手","て"],["に"],["売","うり"],["わたされた"],["ので"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["八","はち"],["年","ねん"],["の"],["間","あいだ"],["、"],["クシャン"],["・"],["リシャタイム"],["に"],["仕えた","つかえた"],["。"]]},{"verse":9,"text":"しかし、イスラエルの人々,ひとびとが主,しゅに呼,よばわったとき、主,しゅはイスラエルの人々,ひとびとのために、ひとりの救助者,きゅうじょしゃを起,おこして彼,かれらを救,すくわれた。すなわちカレブの弟,おとうと、ケナズの子,こオテニエルである。","tok":[["しかし"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["が"],["主に","しゅに"],["呼ばわった","よばわった"],["とき"],["、"],["主","しゅ"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["ため"],["に"],["、"],["ひとり"],["の"],["救助者","きゅうじょしゃ"],["を"],["起こして","おこして"],["彼","かれ"],["ら"],["を"],["救われた","すくわれた"],["。"],["すなわち"],["カレブ"],["の"],["弟","おとうと"],["、"],["ケナズ"],["の"],["子","こ"],["オテニエル"],["で"],["ある"],["。"]]},{"verse":10,"text":"主,しゅの霊,れいがオテニエルに臨,のぞんだので、彼,かれはイスラエルをさばいた。彼,かれが戦,たたかいに出,でると、主,しゅはメソポタミヤの王,おうクシャン・リシャタイムをその手,てにわたされたので、オテニエルの手,てはクシャン・リシャタイムに勝,かち、","tok":[["主","しゅ"],["の"],["霊","れい"],["が"],["オテニエル"],["に"],["臨","のぞんだ"],["ので"],["、"],["彼","かれ"],["は"],["イスラエル"],["を"],["さばいた"],["。"],["彼","かれ"],["が"],["戦い","たたかい"],["に"],["出る","でる"],["と"],["、"],["主","しゅ"],["は"],["メソポタミヤ"],["の"],["王","おう"],["クシャン"],["・"],["リシャタイム"],["を"],["その"],["手","て"],["に"],["わたされた"],["ので"],["、"],["オテニエル"],["の"],["手","て"],["は"],["クシャン"],["・"],["リシャタイム"],["に"],["勝","かち"],["、"]]},{"verse":11,"text":"国,くには四十年,ねんのあいだ太平,たいへいであった。ケナズの子,こオテニエルはついに死,しんだ。","tok":[["国","くに"],["は"],["四十","よんじゅう"],["年","ねん"],["の"],["あいだ"],["太平","たいへい"],["で"],["あった"],["。"],["ケナズ"],["の"],["子","こ"],["オテニエル"],["は"],["ついに"],["死んだ","しんだ"],["。"]]},{"verse":12,"text":"イスラエルの人々,ひとびとはまた主,しゅの前,まえに悪,あくをおこなった。すなわち彼,かれらが主,しゅの前,まえに悪,あくをおこなったので、主,しゅはモアブの王,おうエグロンを強,つよめて、イスラエルに敵対,てきたいさせられた。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["は"],["また"],["主","しゅ"],["の"],["前","まえ"],["に"],["悪","あく"],["を"],["おこなった"],["。"],["すなわち"],["彼","かれ"],["ら"],["が"],["主","しゅ"],["の"],["前","まえ"],["に"],["悪","あく"],["を"],["おこなった"],["ので"],["、"],["主","しゅ"],["は"],["モアブ"],["の"],["王","おう"],["エグロン"],["を"],["強めて","つよめて"],["、"],["イスラエル"],["に"],["敵対","てきたい"],["させられた"],["。"]]},{"verse":13,"text":"エグロンはアンモンおよびアマレクの人々,ひとびとを集,あつめ、きてイスラエルを撃,うち、しゅろの町,まちを占領,せんりょうした。","tok":[["エグロン"],["は"],["アンモン"],["および"],["アマレク"],["の"],["人々","ひとびと"],["を"],["集め","あつめ"],["、"],["きて"],["イスラエル"],["を"],["撃ち","うち"],["、"],["しゅろ"],["の"],["町","まち"],["を"],["占領","せんりょう"],["した"],["。"]]},{"verse":14,"text":"こうしてイスラエルの人々,ひとびとは十八年,ねんの間,あいだモアブの王,おうエグロンに仕,つかえた。","tok":[["こう"],["して"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["十八","じゅうはち"],["年","ねん"],["の"],["間","あいだ"],["モアブ"],["の"],["王","おう"],["エグロン"],["に"],["仕えた","つかえた"],["。"]]},{"verse":15,"text":"しかしイスラエルの人々,ひとびとが主,しゅに呼,よばわったとき、主,しゅは彼,かれらのために、ひとりの救助者,きゅうじょしゃを起,おこされた。すなわちベニヤミンびと、ゲラの子,こ、左,ひだりききのエホデである。イスラエルの人々,ひとびとは彼,かれによってモアブの王,おうエグロンに、みつぎ物,ものを送,おくった。","tok":[["しかし"],["イスラエル"],["の"],["人々","ひとびと"],["が"],["主に","しゅに"],["呼ばわった","よばわった"],["とき"],["、"],["主","しゅ"],["は"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["、"],["ひとり"],["の"],["救助者","きゅうじょしゃ"],["を"],["起こされた","おこされた"],["。"],["すなわち"],["ベニヤミン"],["び"],["と"],["、"],["ゲラ"],["の"],["子","こ"],["、"],["左きき","ひだりきき"],["の"],["エホデ"],["で"],["ある"],["。"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["彼","かれ"],["によって"],["モアブ"],["の"],["王","おう"],["エグロン"],["に"],["、"],["みつぎ"],["物","もの"],["を"],["送った","おくった"],["。"]]},{"verse":16,"text":"エホデは長,ながさ一キュビトのもろ刃,はのつるぎを作,つくらせ、それを衣,ころもの下,した、右,みぎのももの上,うえに帯,おびて、","tok":[["エホデ"],["は"],["長さ","ながさ"],["一","いち"],["キュビト"],["の"],["もろ刃","もろは"],["の"],["つるぎ"],["を"],["作らせ","つくらせ"],["、"],["それ"],["を"],["衣","ころも"],["の"],["下","した"],["、"],["右","みぎ"],["の"],["もも"],["の"],["上","うえ"],["に"],["帯","おび"],["て"],["、"]]},{"verse":17,"text":"モアブの王,おうエグロンにみつぎ物,ものをもってきた。エグロンは非常,ひじょうに肥,こえた人,ひとであった。","tok":[["モアブ"],["の"],["王","おう"],["エグロン"],["に"],["みつぎ"],["物","もの"],["を"],["もって"],["きた"],["。"],["エグロン"],["は"],["非常","ひじょう"],["に"],["肥","こえ"],["た"],["人","ひと"],["で"],["あった"],["。"]]},{"verse":18,"text":"エホデがみつぎ物,ものをささげ終,おわったとき、彼,かれはみつぎ物,ものをになってきた民,たみを帰,かえらせ、","tok":[["エホデ"],["が"],["みつぎ"],["物","もの"],["を"],["ささげ"],["終わった","おわった"],["とき"],["、"],["彼","かれ"],["は"],["みつぎ"],["物","もの"],["を"],["に"],["なって"],["きた"],["民","たみ"],["を"],["帰えらせ","かえらせ"],["、"]]},{"verse":19,"text":"かれ自身,じしんはギルガルに近,ちかい石像,せきぞうのある所,ところから引,ひきかえして言,いった、「王,おうよ、わたしはあなたに申,もうしあげる機密,きみつをもっています」。そこで王,おうは「さがっておれ」と言,いったので、かたわらに立,たっている者,ものは皆,みな出,でて行,いった。","tok":[["かれ"],["自身","じしん"],["は"],["ギルガル"],["に"],["近い","ちかい"],["石像","せきぞう"],["の"],["ある"],["所","ところ"],["から"],["引か","ひきか"],["え"],["して"],["言った","いった"],["、"],["「"],["王","おう"],["よ"],["、"],["わたし"],["は"],["あなた"],["に"],["申しあげる","もうしあげる"],["機密","きみつ"],["を"],["もって"],["います"],["」"],["。"],["そこ"],["で"],["王","おう"],["は"],["「"],["さがって"],["おれ"],["」"],["と"],["言った","いった"],["ので"],["、"],["かたわら"],["に"],["立って","たって"],["いる"],["者","もの"],["は"],["皆","みな"],["出て","でて"],["行った","いった"],["。"]]},{"verse":20,"text":"エホデが王,おうのところにはいって来,くると、王,おうはひとりで涼,すずみの高殿,たかどのに座,ざしていたので、エホデが「わたしは神,かみの命,いのちによってあなたに申,もうしあげることがあります」と言,いうと、王,おうは座,ざから立,たちあがった。","tok":[["エホデ"],["が"],["王","おう"],["の"],["ところ"],["に"],["はいって"],["来る","くる"],["と"],["、"],["王","おう"],["は"],["ひとり"],["で"],["涼み","すずみ"],["の"],["高殿","たかどの"],["に"],["座して","ざして"],["いた"],["ので"],["、"],["エホデ"],["が"],["「"],["わたし"],["は"],["神","かみ"],["の"],["命","いのち"],["によって"],["あなた"],["に"],["申しあげる","もうしあげる"],["こと"],["が"],["あります"],["」"],["と"],["言","いう"],["と"],["、"],["王","おう"],["は"],["座","ざ"],["から"],["立ちあがった","たちあがった"],["。"]]},{"verse":21,"text":"そのときエホデは左,ひだりの手,てを伸,のばし、右,みぎのももからつるぎをとって王,おうの腹,はらを刺,さした。","tok":[["その"],["とき"],["エホデ"],["は"],["左","ひだり"],["の"],["手","て"],["を"],["伸ばし","のばし"],["、"],["右","みぎ"],["の"],["もも"],["から"],["つるぎ"],["を"],["とって"],["王","おう"],["の"],["腹","はら"],["を"],["刺","さし"],["た"],["。"]]},{"verse":22,"text":"つるぎのつかも刃,はと共,ともにはいったが、つるぎを腹,はらから抜,ぬき出,ださなかったので、脂肪,しぼうが刃,はをふさいだ。そして汚物,おぶつが出,でた。","tok":[["つるぎ"],["の"],["つか"],["も"],["刃","は"],["と"],["共","とも"],["に"],["はいった"],["が"],["、"],["つるぎ"],["を"],["腹","はら"],["から"],["抜き出さなかった","ぬきださなかった"],["ので"],["、"],["脂肪","しぼう"],["が"],["刃","は"],["を"],["ふさいだ"],["。"],["そして"],["汚物","おぶつ"],["が"],["出た","でた"],["。"]]},{"verse":23,"text":"エホデは廊下,ろうかに出,でて、王,おうのおる高殿,たかどのの戸,とを閉,とじ、錠,じょうをおろした。","tok":[["エホデ"],["は"],["廊下","ろうか"],["に"],["出て","でて"],["、"],["王","おう"],["の"],["おる"],["高殿","たかどの"],["の"],["戸","と"],["を"],["閉じ","とじ"],["、"],["錠","じょう"],["を"],["おろした"],["。"]]},{"verse":24,"text":"彼,かれが出,でた後,のち、王,おうのしもべどもがきて、高殿,たかどのの戸,とに錠,じょうのおろされてあるのを見,みて、「王,おうはきっと涼,すずみ殿,どののへやで足,あしをおおっておられるのだ」と思,おもった。","tok":[["彼","かれ"],["が"],["出た","でた"],["後","の"],["ち"],["、"],["王","おう"],["の"],["しもべ"],["ども"],["が"],["きて"],["、"],["高殿","たかどの"],["の"],["戸","と"],["に"],["錠","じょう"],["の"],["おろされて"],["ある"],["の"],["を"],["見て","みて"],["、"],["「"],["王","おう"],["は"],["きっと"],["涼み","すずみ"],["殿","どの"],["の"],["へや"],["で"],["足","あし"],["を"],["おおって"],["おられる"],["の"],["だ"],["」"],["と"],["思った","おもった"],["。"]]},{"verse":25,"text":"しもべどもは長,ながいあいだ待,まっていたが、王,おうがなお高殿,たかどのの戸,とを開,ひらかないので、心配,しんぱいしてかぎをとって開,ひらいて見,みると、王,おうは床,ゆかにたおれて死,しんでいた。","tok":[["しもべ"],["ども"],["は"],["長い","ながい"],["あいだ"],["待って","まって"],["いた"],["が"],["、"],["王","おう"],["が"],["なお"],["高殿","たかどの"],["の"],["戸","と"],["を"],["開らかない","ひらかない"],["ので"],["、"],["心配","しんぱい"],["して"],["かぎ"],["を"],["とって"],["開らいて","ひらいて"],["見る","みる"],["と"],["、"],["王","おう"],["は"],["床","ゆか"],["に"],["たおれて"],["死んで","しんで"],["いた"],["。"]]},{"verse":26,"text":"エホデは彼,かれらのためらうまに、のがれて石像,せきぞうのある所,ところを過,すぎ、セイラに逃,にげていった。","tok":[["エホデ"],["は"],["彼","かれ"],["ら"],["の"],["ためらう"],["ま"],["に"],["、"],["のがれて"],["石像","せきぞう"],["の"],["ある"],["所","ところ"],["を"],["過","すぎ"],["、"],["セイラ"],["に"],["逃て","にげて"],["いった"],["。"]]},{"verse":27,"text":"彼,かれが行,いってエフライムの山地,さんちにラッパを吹,ふき鳴,ならしたので、イスラエルの人々,ひとびとは彼,かれと共,ともに山地,さんちから下,くだってエホデに従,したがった。","tok":[["彼","かれ"],["が"],["行って","いって"],["エフライム"],["の"],["山地","さんち"],["に"],["ラッパ"],["を"],["吹鳴","ふきな"],["らした"],["ので"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["彼","かれ"],["と"],["共","とも"],["に"],["山地","さんち"],["から"],["下って","くだって"],["エホデ"],["に"],["従った","したがった"],["。"]]},{"verse":28,"text":"エホデは彼,かれらに言,いった、「わたしについてきなさい。主,しゅはあなたがたの敵,てきモアブびとをあなたがたの手,てにわたされます」。そこで彼,かれらはエホデに従,したがって下,くだり、ヨルダンの渡,わたし場,ばをおさえ、モアブびとをひとりも渡,わたらせなかった。","tok":[["エホデ"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["わたし"],["について"],["き"],["なさい"],["。"],["主","しゅ"],["は"],["あなた"],["がた"],["の"],["敵","てき"],["モアブ"],["びと"],["を"],["あなた"],["がた"],["の"],["手","て"],["に"],["わたされます"],["」"],["。"],["そこ"],["で"],["彼","かれ"],["ら"],["は"],["エホデ"],["に"],["従って","したがって"],["下り","くだり"],["、"],["ヨルダン"],["の"],["渡場","わたしば"],["を"],["おさえ"],["、"],["モアブ"],["びと"],["を"],["ひとり"],["も"],["渡らせなかった","わたらせなかった"],["。"]]},{"verse":29,"text":"そのとき彼,かれらはモアブびとおおよそ一万人,にんを殺,ころした。これはいずれも肥,こえ太,ふとった勇士,ゆうしであって、ひとりも、のがれた者,ものがなかった。","tok":[["その"],["とき"],["彼","かれ"],["ら"],["は"],["モアブ"],["びと"],["おおよそ"],["一万人","にん"],["を"],["殺ろした","ころした"],["。"],["これ"],["は"],["いずれ"],["も"],["肥","こえ"],["太った","ふとった"],["勇士","ゆうし"],["で"],["あって"],["、"],["ひとり"],["も"],["、"],["のがれた"],["者","もの"],["が"],["なかった"],["。"]]},{"verse":30,"text":"こうしてモアブはその日,ひイスラエルの手,てに服,ふくし、国,くには八十年,ねんのあいだ太平,たいへいであった。","tok":[["こう"],["して"],["モアブ"],["は"],["その"],["日","ひ"],["イスラエル"],["の"],["手","て"],["に"],["服し","ふくし"],["、"],["国","くに"],["は"],["八十","はちじゅう"],["年","ねん"],["の"],["あいだ"],["太平","たいへい"],["で"],["あった"],["。"]]},{"verse":31,"text":"エホデの後,のち、アナテの子,こシャムガルが起,おこり、牛,うしのむちをもってペリシテびと六百人,にんを殺,ころした。この人,ひともまたイスラエルを救,すくった。","tok":[["エホデ"],["の"],["後","の"],["ち"],["、"],["アナテ"],["の"],["子","こ"],["シャムガル"],["が"],["起こり","おこり"],["、"],["牛","うし"],["の"],["むち"],["を"],["もって"],["ペリシテ"],["びと"],["六百人","にん"],["を"],["殺ろした","ころした"],["。"],["この"],["人","ひと"],["も"],["また"],["イスラエル"],["を"],["救った","すくった"],["。"]]}]
[{"verse":1,"text":"さてエルバアルの子,こアビメレクはシケムに行,いき、母,ははの身内,みうちの人,ひとたちのもとに行,いって、彼,かれらと母,ははの父,ちちの家,いえの一族,いちぞくとに言,いった、","tok":[["さて"],["エルバアル"],["の"],["子","こ"],["アビメレク"],["は"],["シケム"],["に"],["行き","いき"],["、"],["母","はは"],["の"],["身内","みうち"],["の"],["人","ひと"],["たち"],["の"],["もと"],["に"],["行って","いって"],["、"],["彼","かれ"],["ら"],["と"],["母","はは"],["の"],["父","ちち"],["の"],["家","いえ"],["の"],["一族","いちぞく"],["と"],["に"],["言った","いった"],["、"]]},{"verse":2,"text":"「どうぞ、シケムのすべての人々,ひとびとの耳,みみに告,つげてください、『エルバアルのすべての子,こ七十人,にんであなたがたを治,おさめるのと、ただひとりであなたがたを治,おさめるのと、どちらがよいか。わたしがあなたがたの骨肉,こつにくであることを覚,おぼえてください』と」。","tok":[["「"],["どうぞ"],["、"],["シケム"],["の"],["すべて"],["の"],["人々","ひとびと"],["の"],["耳","みみ"],["に"],["告","つげ"],["て"],["ください"],["、"],["『"],["エルバアル"],["の"],["すべて"],["の"],["子","こ"],["七","なな"],["十人","じゅうにん"],["を"],["治める","おさめる"],["の"],["と"],["、"],["ただ"],["ひとり"],["で"],["あなた"],["がた"],["を"],["治める","おさめる"],["の"],["と"],["、"],["どちら"],["が"],["よい"],["か"],["。"],["わたし"],["が"],["あなた"],["がた"],["の"],["骨肉","こつにく"],["で"],["ある"],["こと"],["を"],["覚えて","おぼえて"],["ください"],["』"],["と"],["」"],["。"]]},{"verse":3,"text":"そこで母,ははの身内,みうちの人,ひとたちがアビメレクに代,かわってこれらの言葉,ことばをことごとくシケムのすべての人々,ひとびとの耳,みみに告,つげると、彼,かれらは心,こころをアビメレクに傾,かたむけ、「彼,かれはわれわれの兄弟,きょうだいだ」と言,いって、","tok":[["そこ"],["で"],["母","はは"],["の"],["身内","みうち"],["の"],["人","ひと"],["たち"],["が"],["アビメレク"],["に"],["代わって","かわって"],["これ"],["ら"],["の"],["言葉","ことば"],["を"],["ことごとく"],["シケム"],["の"],["すべて"],["の"],["人々","ひとびと"],["の"],["耳","みみ"],["に"],["告げる","つげる"],["と"],["、"],["彼","かれ"],["ら"],["は"],["心","こころ"],["を"],["アビメレク"],["に"],["傾むけ","かたむけ"],["、"],["「"],["彼","かれ"],["は"],["われわれ"],["の"],["兄弟","きょうだい"],["だ"],["」"],["と"],["言って","いって"],["、"]]},{"verse":4,"text":"バアル・ベリテの宮,みやから銀,ぎん七十シケルを取,とって彼,かれに与,あたえた。アビメレクはそれをもって、やくざのならず者,ものを雇,やとって自分,じぶんに従,したがわせ、","tok":[["バアル"],["・"],["ベリテ"],["の"],["宮","みや"],["から"],["銀","ぎん"],["七十","ななじゅう"],["シケル"],["を"],["取って","とって"],["彼","かれ"],["に"],["与","あたえ"],["た"],["。"],["アビメレク"],["は"],["それ"],["を"],["もって"],["、"],["やくざ"],["の"],["ならず者","ならずもの"],["を"],["雇って","やとって"],["自分","じぶん"],["に"],["従わせ","したがわせ"],["、"]]},{"verse":5,"text":"オフラにある父,ちちの家,いえに行,いって、エルバアルの子,こで、自分,じぶんの兄弟,きょうだいである七十人,にんを、一つの石,いしの上,うえで殺,ころした。ただしエルバアルの末,すえの子,こヨタムは身,みを隠,かくしたので生,いき残,のこった。","tok":[["オフラ"],["に"],["ある"],["父","ちち"],["の"],["家","いえ"],["に"],["行って","いって"],["、"],["エルバアル"],["の"],["子","こ"],["で"],["、"],["自分","じぶん"],["の"],["兄弟","きょうだい"],["で"],["ある"],["七","なな"],["十人","じゅうにん"],["を"],["、"],["一","ひと"],["つ"],["の"],["石","いし"],["の"],["上","うえ"],["で"],["殺ろした","ころした"],["。"],["ただし"],["エルバアル"],["の"],["末","すえ"],["の"],["子","こ"],["ヨタム"],["は"],["身","み"],["を"],["隠した","かくした"],["ので"],["生き残った","いきのこった"],["。"]]},{"verse":6,"text":"そこでシケムのすべての人々,ひとびととベテミロのすべての人々,ひとびとは集,あつまり、行,いってシケムにある石,いしの柱,はしらのかたわらのテレビンの木,きのもとで、アビメレクを立,たてて王,おうとした。","tok":[["そこ"],["で"],["シケム"],["の"],["すべて"],["の"],["人々","ひとびと"],["と"],["ベテミロ"],["の"],["すべて"],["の"],["人々","ひとびと"],["は"],["集まり","あつまり"],["、"],["行って","いって"],["シケム"],["に"],["ある"],["石","いし"],["の"],["柱","はしら"],["の"],["かたわら"],["の"],["テレビン"],["の"],["木","き"],["の"],["もと"],["で"],["、"],["アビメレク"],["を"],["立てて","たてて"],["王","おう"],["と"],["した"],["。"]]},{"verse":7,"text":"このことをヨタムに告,つげる者,ものがあったので、ヨタムは行,いってゲリジム山,やまの頂,いただきに立,たち、大声,おおごえに叫,さけんで彼,かれらに言,いった、「シケムの人々,ひとびとよ、わたしに聞,ききなさい。そうすれば神,かみはあなたがたに聞,きかれるでしょう。","tok":[["この"],["こと"],["を"],["ヨタム"],["に"],["告げる","つげる"],["者","もの"],["が"],["あった"],["ので"],["、"],["ヨタム"],["は"],["行って","いって"],["ゲリジム"],["山","やま"],["の"],["頂","いただき"],["に"],["立ち","たち"],["、"],["大声","おおごえ"],["に"],["叫けんで","さけんで"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["シケム"],["の"],["人々","ひとびと"],["よ"],["、"],["わたし"],["に"],["聞","きき"],["なさい"],["。"],["そう"],["すれば"],["神","かみ"],["は"],["あなた"],["がた"],["に"],["聞かれるでしょう","きかれるでしょう"],["。"]]},{"verse":8,"text":"ある時,とき、もろもろの木,きが自分,じぶんたちの上,うえに王,おうを立,たてようと出,でて行,いってオリブの木,きに言,いった、『わたしたちの王,おうになってください』。","tok":[["ある"],["時","とき"],["、"],["もろもろ"],["の"],["木","き"],["が"],["自分","じぶん"],["たち"],["の"],["上","うえ"],["に"],["王","おう"],["を"],["立よう","たてよう"],["と"],["出て","でて"],["行って","いって"],["オリブ"],["の"],["木","き"],["に"],["言った","いった"],["、"],["『"],["わたしたち"],["の"],["王","おう"],["に"],["なって"],["ください"],["』"],["。"]]},{"verse":9,"text":"しかしオリブの木,きは彼,かれらに言,いった、『わたしはどうして神,かみと人,ひととをあがめるために用,もちいられるわたしの油,あぶらを捨,すてて行,いって、もろもろの木,きを治,おさめることができましょう』。","tok":[["しかし"],["オリブ"],["の"],["木","き"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["『"],["わたし"],["は"],["どう"],["して"],["神","かみ"],["と"],["人","ひと"],["と"],["を"],["あがめる"],["ため"],["に"],["用いられる","もちいられる"],["わたし"],["の"],["油","あぶら"],["を"],["捨てて","すてて"],["行って","いって"],["、"],["もろもろ"],["の"],["木","き"],["を"],["治める","おさめる"],["こと"],["が"],["できましょう"],["』"],["。"]]},{"verse":10,"text":"もろもろの木,きはまたいちじくの木,きに言,いった、『きてわたしたちの王,おうになってください』。","tok":[["もろもろ"],["の"],["木","き"],["は"],["また"],["いちじく"],["の"],["木","き"],["に"],["言った","いった"],["、"],["『"],["きて"],["わたしたち"],["の"],["王","おう"],["に"],["なって"],["ください"],["』"],["。"]]},{"verse":11,"text":"しかしいちじくの木,きは彼,かれらに言,いった、『わたしはどうしてわたしの甘味,かんみと、わたしの良,よい果実,かじつとを捨,すてて行,いって、もろもろの木,きを治,おさめることができましょう』。","tok":[["しかし"],["いちじく"],["の"],["木","き"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["『"],["わたし"],["は"],["どう"],["して"],["わたし"],["の"],["甘味","かんみ"],["と"],["、"],["わたし"],["の"],["良い","よい"],["果実","かじつ"],["と"],["を"],["捨てて","すてて"],["行って","いって"],["、"],["もろもろ"],["の"],["木","き"],["を"],["治める","おさめる"],["こと"],["が"],["できましょう"],["』"],["。"]]},{"verse":12,"text":"もろもろの木,きはまたぶどうの木,きに言,いった、『きてわたしたちの王,おうになってください』。","tok":[["もろもろ"],["の"],["木","き"],["は"],["また"],["ぶどう"],["の"],["木","き"],["に"],["言った","いった"],["、"],["『"],["きて"],["わたしたち"],["の"],["王","おう"],["に"],["なって"],["ください"],["』"],["。"]]},{"verse":13,"text":"しかし、ぶどうの木,きは彼,かれらに言,いった、『わたしはどうして神,かみと人,ひととを喜,よろこばせるわたしのぶどう酒,しゅを捨,すてて行,いって、もろもろの木,きを治,おさめることができましょう』。","tok":[["しかし"],["、"],["ぶどう"],["の"],["木","き"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["『"],["わたし"],["は"],["どう"],["して"],["神","かみ"],["と"],["人","ひと"],["と"],["を"],["喜こばせる","よろこばせる"],["わたし"],["の"],["ぶどう酒","ぶどうしゅ"],["を"],["捨てて","すてて"],["行って","いって"],["、"],["もろもろ"],["の"],["木","き"],["を"],["治める","おさめる"],["こと"],["が"],["できましょう"],["』"],["。"]]},{"verse":14,"text":"そこですべての木,きはいばらに言,いった、『きてわたしたちの王,おうになってください』。","tok":[["そこ"],["で"],["すべて"],["の"],["木","き"],["は"],["いばら"],["に"],["言った","いった"],["、"],["『"],["きて"],["わたしたち"],["の"],["王","おう"],["に"],["なって"],["ください"],["』"],["。"]]},{"verse":15,"text":"いばらはもろもろの木,きに言,いった、『あなたがたが真実,しんじつにわたしを立,たてて王,おうにするならば、きてわたしの陰,かげに難,なんを避,さけなさい。そうしなければ、いばらから火,ひが出,でてレバノンの香柏,こうはくを焼,やきつくすでしょう』。","tok":[["いばら"],["は"],["もろもろ"],["の"],["木","き"],["に"],["言った","いった"],["、"],["『"],["あなた"],["がた"],["が"],["真実","しんじつ"],["に"],["わたし"],["を"],["立てて","たてて"],["王","おう"],["に"],["するならば"],["、"],["きて"],["わたし"],["の"],["陰","かげ"],["に"],["難","なん"],["を"],["避け","さけ"],["なさい"],["。"],["そう"],["しなければ"],["、"],["いばら"],["から"],["火","ひ"],["が"],["出て","でて"],["レバノン"],["の"],["香","こう"],["柏","かしわ"],["を"],["焼き","やき"],["つくすでしょう"],["』"],["。"]]},{"verse":16,"text":"あなたがたがアビメレクを立,たてて王,おうにしたことは、真実,しんじつと敬意,けいいとをもってしたものですか。あなたがたはエルバアルとその家,いえをよく扱,あつかい、彼,かれのおこないに応,おうじてしたのですか。","tok":[["あなた"],["がた"],["が"],["アビメレク"],["を"],["立てて","たてて"],["王","おう"],["に"],["した"],["こと"],["は"],["、"],["真実","しんじつ"],["と"],["敬意","けいい"],["と"],["を"],["もって"],["した"],["もの"],["です"],["か"],["。"],["あなた"],["がた"],["は"],["エルバアル"],["と"],["その"],["家","いえ"],["を"],["よく"],["扱い","あつかい"],["、"],["彼","かれ"],["の"],["おこない"],["に"],["応じて","おうじて"],["した"],["の"],["です"],["か"],["。"]]},{"verse":17,"text":"わたしの父,ちちはあなたがたのために戦,たたかい、自分,じぶんの命,いのちを投,なげ出,だして、あなたがたをミデアンの手,てから救,すくい出,だしたのに、","tok":[["わたし"],["の"],["父","ちち"],["は"],["あなた"],["がた"],["の"],["ため"],["に"],["戦い","たたかい"],["、"],["自分","じぶん"],["の"],["命","いのち"],["を"],["投出して","なげだして"],["、"],["あなた"],["がた"],["を"],["ミデアン"],["の"],["手","て"],["から"],["救い出した","すくいだした"],["のに"],["、"]]},{"verse":18,"text":"あなたがたは、きょう、わたしの父,ちちの家,いえに反抗,はんこうして起,おこり、その子,こ七十人,にんを一つの石,いしの上,うえで殺,ころし、その腰元,こしもとの子,こアビメレクをあなたがたの身内,みうちの者,ものであるゆえに立,たてて、シケムの人々,ひとびとの王,おうにしました。","tok":[["あなた"],["がた"],["は"],["、"],["きょう"],["、"],["わたし"],["の"],["父","ちち"],["の"],["家","いえ"],["に"],["反抗","はんこう"],["して"],["起こり","おこり"],["、"],["その"],["子","こ"],["七","なな"],["十人","じゅうにん"],["を"],["一","ひと"],["つ"],["の"],["石","いし"],["の"],["上","うえ"],["で"],["殺ろし","ころし"],["、"],["その"],["腰元","こしもと"],["の"],["子","こ"],["アビメレク"],["を"],["あなた"],["がた"],["の"],["身内","みうち"],["の"],["者","もの"],["で"],["ある"],["ゆえ"],["に"],["立てて","たてて"],["、"],["シケム"],["の"],["人々","ひとびと"],["の"],["王","おう"],["に"],["しました"],["。"]]},{"verse":19,"text":"あなたがたが、きょう、エルバアルとその家,いえになされたことが真実,しんじつと敬意,けいいをもってしたものであるならば、アビメレクのために喜,よろこびなさい。彼,かれもまたあなたがたのために喜,よろこぶでしょう。","tok":[["あなた"],["が"],["た"],["が"],["、"],["きょう"],["、"],["エルバアル"],["と"],["その"],["家","いえ"],["に"],["なされた"],["こと"],["が"],["真実","しんじつ"],["と"],["敬意","けいい"],["を"],["もって"],["した"],["もの"],["で"],["あるならば"],["、"],["アビメレク"],["の"],["ため"],["に"],["喜こび","よろこび"],["なさい"],["。"],["彼","かれ"],["も"],["また"],["あなた"],["がた"],["の"],["ため"],["に"],["喜こぶでしょう","よろこぶでしょう"],["。"]]},{"verse":20,"text":"しかし、そうでなければ、アビメレクから火,ひが出,でて、シケムの人々,ひとびととベテミロとを焼,やきつくし、またシケムの人々,ひとびととベテミロからも火,ひが出,でてアビメレクを焼,やきつくすでしょう」。","tok":[["しかし"],["、"],["そう"],["で"],["なければ"],["、"],["アビメレク"],["から"],["火","ひ"],["が"],["出て","でて"],["、"],["シケム"],["の"],["人々","ひとびと"],["と"],["ベテミロ"],["と"],["を"],["焼きつく","やきつく"],["し"],["、"],["また"],["シケム"],["の"],["人々","ひとびと"],["と"],["ベテミロ"],["から"],["も"],["火","ひ"],["が"],["出て","でて"],["アビメレク"],["を"],["焼き","やき"],["つくすでしょう"],["」"],["。"]]},{"verse":21,"text":"こうしてヨタムは走,はしって逃,にげ去,さり、ベエルに行,いき、兄弟,きょうだいアビメレクの顔,かおをさけてそこに住,すんだ。","tok":[["こう"],["して"],["ヨタム"],["は"],["走って","はしって"],["逃","にげ"],["去り","さり"],["、"],["ベエル"],["に"],["行き","いき"],["、"],["兄弟","きょうだい"],["アビメレク"],["の"],["顔","かお"],["を"],["さけて"],["そこ"],["に"],["住んだ","すんだ"],["。"]]},{"verse":22,"text":"アビメレクは三年,ねんの間,あいだイスラエルを治,おさめたが、","tok":[["アビメレク"],["は"],["三","さん"],["年","ねん"],["の"],["間","あいだ"],["イスラエル"],["を"],["治めた","おさめた"],["が"],["、"]]},{"verse":23,"text":"神,かみはアビメレクとシケムの人々,ひとびとの間,あいだに悪霊,あくれいをおくられたので、シケムの人々,ひとびとはアビメレクを欺,あざむくようになった。","tok":[["神","かみ"],["は"],["アビメレク"],["と"],["シケム"],["の"],["人々","ひとびと"],["の"],["間","あいだ"],["に"],["悪霊","あくれい"],["を"],["おくられた"],["ので"],["、"],["シケム"],["の"],["人々","ひとびと"],["は"],["アビメレク"],["を"],["欺く","あざむく"],["よう"],["に"],["なった"],["。"]]},{"verse":24,"text":"これはエルバアルの七十人,にんの子,こが受,うけた暴虐,ぼうぎゃくと彼,かれらの血,ちが、彼,かれらを殺,ころした兄弟,きょうだいアビメレクの上,うえと、彼,かれの手,てを強,つよめてその兄弟,きょうだいを殺,ころさせたシケムの人々,ひとびとの上,うえとに報,むくいとなってきたのである。","tok":[["これ"],["は"],["エルバアル"],["の"],["七","なな"],["十人","じゅうにん"],["の"],["子","こ"],["が"],["受た","うけた"],["暴虐","ぼうぎゃく"],["と"],["彼","かれ"],["ら"],["の"],["血","ち"],["が"],["、"],["彼","かれ"],["ら"],["を"],["殺ろした","ころした"],["兄弟","きょうだい"],["アビメレク"],["の"],["上","うえ"],["と"],["、"],["彼","かれ"],["の"],["手","て"],["を"],["強めて","つよめて"],["その"],["兄弟","きょうだい"],["を"],["殺させた","ころさせた"],["シケム"],["の"],["人々","ひとびと"],["の"],["上","うえ"],["と"],["に"],["報い","むくい"],["と"],["なって"],["きた"],["ので"],["ある"],["。"]]},{"verse":25,"text":"シケムの人々,ひとびとは彼,かれに敵,てきして待,まち伏,ぶせする者,ものを山々,やまやまの頂,いただきにおき、すべてその道,みちを通,とおり過,すぎる者,ものを略奪,りゃくだつさせた。このことがアビメレクに告,つげ知,しらされた。","tok":[["シケム"],["の"],["人々","ひとびと"],["は"],["彼","かれ"],["に"],["敵して","てきして"],["待伏せ","まちぶせ"],["する"],["者","もの"],["を"],["山々","やまやま"],["の"],["頂","いただき"],["に"],["おき"],["、"],["すべて"],["その"],["道","みち"],["を"],["通り","とおり"],["過る","すぎる"],["者","もの"],["を"],["略奪","りゃくだつ"],["させた"],["。"],["この"],["こと"],["が"],["アビメレク"],["に"],["告","つげ"],["知らされた","しらされた"],["。"]]},{"verse":26,"text":"さてエベデの子,こガアルはその身内,みうちの人々,ひとびとと一緒,いっしょにシケムに移住,いじゅうしたが、シケムの人々,ひとびとは彼,かれを信用,しんようした。","tok":[["さて"],["エベデ"],["の"],["子","こ"],["ガアル"],["は"],["その"],["身内","みうち"],["の"],["人々","ひとびと"],["と"],["一緒","いっしょ"],["に"],["シケム"],["に"],["移住","いじゅう"],["した"],["が"],["、"],["シケム"],["の"],["人々","ひとびと"],["は"],["彼","かれ"],["を"],["信用","しんよう"],["した"],["。"]]},{"verse":27,"text":"人々,ひとびとは畑,はたけに出,でてぶどうを取,とり入,いれ、それを踏,ふみ絞,しぼって祭,まつりをし、神,かみの宮,みやに行,いって飲,のみ食,くいしてアビメレクをのろった。","tok":[["人々","ひとびと"],["は"],["畑","はたけ"],["に"],["出て","でて"],["ぶどう"],["を"],["取入れ","とりいれ"],["、"],["それ"],["を"],["踏み","ふみ"],["絞って","しぼって"],["祭","まつり"],["を"],["し"],["、"],["神","かみ"],["の"],["宮","みや"],["に"],["行って","いって"],["飲み食い","のみくい"],["して"],["アビメレク"],["を"],["のろった"],["。"]]},{"verse":28,"text":"そしてエベデの子,こガアルは言,いった、「アビメレクは何,なにものか。シケムのわれわれは何,なにものなれば彼,かれに仕,つかえなければならないのか。エルバアルの子,ことその役人,やくにんゼブルはシケムの先祖,せんぞハモルの一族,いちぞくに仕,つかえたではないか。われわれはどうして彼,かれに仕,つかえなければならないのか。","tok":[["そして"],["エベデ"],["の"],["子","こ"],["ガアル"],["は"],["言った","いった"],["、"],["「"],["アビメレク"],["は"],["何もの","なにもの"],["か"],["。"],["シケム"],["の"],["われわれ"],["は"],["何","な"],["に"],["もの"],["なれば"],["彼","かれ"],["に"],["仕えなければ","つかえなければ"],["ならない"],["の"],["か"],["。"],["エルバアル"],["の"],["子","こ"],["と"],["その"],["役人","やくにん"],["ゼブル"],["は"],["シケム"],["の"],["先祖","せんぞ"],["ハモル"],["の"],["一族","いちぞく"],["に"],["仕えたで","つかえたで"],["は"],["ない"],["か"],["。"],["われわれ"],["は"],["どう"],["して"],["彼","かれ"],["に"],["仕えなければ","つかえなければ"],["ならない"],["の"],["か"],["。"]]},{"verse":29,"text":"ああ、この民,たみがわたしの手,ての下,したにあったらよいのだが。そうすればわたしはアビメレクをやめさせ、アビメレクに向,むかって『おまえの軍勢,ぐんぜいを増,まして出,でてこい』と言,いうであろう」。","tok":[["ああ"],["、"],["この"],["民","たみ"],["が"],["わたし"],["の"],["手","て"],["の"],["下","した"],["に"],["あったら"],["よい"],["の"],["だ"],["が"],["。"],["そう"],["すれば"],["わたし"],["は"],["アビメレク"],["を"],["やめさせ"],["、"],["アビメレク"],["に"],["向かって","むかって"],["『"],["おまえ"],["の"],["軍勢","ぐんぜい"],["を"],["増して","まして"],["出て","でて"],["こい"],["』"],["と"],["言うで","いうで"],["あろう"],["」"],["。"]]},{"verse":30,"text":"町,まちのつかさゼブルはエベデの子,こガアルの言葉,ことばを聞,きいて怒,いかりを発,はっし、","tok":[["町","まち"],["の"],["つかさ"],["ゼブル"],["は"],["エベデ"],["の"],["子","こ"],["ガアル"],["の"],["言葉","ことば"],["を"],["聞いて","きいて"],["怒り","いかり"],["を"],["発し","はっし"],["、"]]},{"verse":31,"text":"使者,ししゃをアルマにおるアビメレクにつかわして言,いわせた、「エベデの子,こガアルとその身内,みうちの人々,ひとびとがシケムにきて、町,まちを騒,さわがせ、あなたにそむかせようとしています。","tok":[["使者","ししゃ"],["を"],["アルマ"],["に"],["おる"],["アビメレク"],["に"],["つかわして"],["言わせた","いわせた"],["、"],["「"],["エベデ"],["の"],["子","こ"],["ガアル"],["と"],["その"],["身内","みうち"],["の"],["人々","ひとびと"],["が"],["シケム"],["に"],["きて"],["、"],["町","まち"],["を"],["騒がせ","さわがせ"],["、"],["あなた"],["に"],["そむかせよう"],["として"],["います"],["。"]]},{"verse":32,"text":"それであなたと、あなたと共,ともにおる人々,ひとびとが夜,よるのうちに行,いって、野,のに身,みを伏,ふせ、","tok":[["それ"],["で"],["あなた"],["と"],["、"],["あなた"],["と"],["共","とも"],["に"],["おる"],["人々","ひとびと"],["が"],["夜","よる"],["の"],["うち"],["に"],["行って","いって"],["、"],["野","の"],["に"],["身","み"],["を"],["伏せ","ふせ"],["、"]]},{"verse":33,"text":"朝,あさになって、日,ひののぼるとき、早,はやく起,おき出,でて町,まちを襲,おそうならば、ガアルと、彼,かれと共,ともにおる民,たみは出,でてきて、あなたに抵抗,ていこうするでしょう。その時,ときあなたは機,はたを得,えて、彼,かれらを撃,うつことができるでしょう」。","tok":[["朝","あさ"],["に"],["なって"],["、"],["日","ひ"],["の"],["のぼる"],["とき"],["、"],["早く","はやく"],["起き出て","おきでて"],["町","まち"],["を"],["襲うならば","おそうならば"],["、"],["ガアル"],["と"],["、"],["彼","かれ"],["と"],["共","とも"],["に"],["おる"],["民","たみ"],["は"],["出て","でて"],["きて"],["、"],["あなた"],["に"],["抵抗","ていこう"],["するでしょう"],["。"],["その"],["時","とき"],["あなた"],["は"],["機","はた"],["を"],["得て","えて"],["、"],["彼","かれ"],["ら"],["を"],["撃つ","うつ"],["こと"],["が"],["できるでしょう"],["」"],["。"]]},{"verse":34,"text":"アビメレクと、彼,かれと共,ともにいたすべての民,たみは夜,よるのうちに起,おき出,でて、四組,くみに分,わかれ、身,みを伏,ふせてシケムをうかがった。","tok":[["アビメレク"],["と"],["、"],["彼","かれ"],["と"],["共","とも"],["に"],["いた"],["すべて"],["の"],["民","たみ"],["は"],["夜","よる"],["の"],["うち"],["に"],["起き出て","おきでて"],["、"],["四","よん"],["組","くみ"],["に"],["分かれ","わかれ"],["、"],["身","み"],["を"],["伏せて","ふせて"],["シケム"],["を"],["うかがった"],["。"]]},{"verse":35,"text":"エベデの子,こガアルが出,でて、町,まちの門,もんの入口,いりぐちに立,たったとき、アビメレクと、彼,かれと共,ともにいた民,たみが身,みを伏,ふせていたところから立,たちあがったので、","tok":[["エベデ"],["の"],["子","こ"],["ガアル"],["が"],["出て","でて"],["、"],["町","まち"],["の"],["門","もん"],["の"],["入口","いりぐち"],["に"],["立った","たった"],["とき"],["、"],["アビメレク"],["と"],["、"],["彼","かれ"],["と"],["共","とも"],["に"],["いた"],["民","たみ"],["が"],["身","み"],["を"],["伏せて","ふせて"],["いた"],["ところ"],["から"],["立ちあがった","たちあがった"],["ので"],["、"]]},{"verse":36,"text":"ガアルは民,たみを見,みてゼブルに言,いった、「ごらんなさい。民,たみが山々,やまやまの頂,いただきからおりてきます」。ゼブルは彼,かれに言,いった、「あなたは山々,やまやまの影,かげを人,ひとのように見,みるのです」。","tok":[["ガアル"],["は"],["民","たみ"],["を"],["見て","みて"],["ゼブル"],["に"],["言った","いった"],["、"],["「"],["ごらん"],["なさい"],["。"],["民","た"],["み"],["が"],["山々","やまやま"],["の"],["頂","いただき"],["から"],["おりて"],["きます"],["」"],["。"],["ゼブル"],["は"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["は"],["山々","やまやま"],["の"],["影","かげ"],["を"],["人","ひと"],["の"],["よう"],["に"],["見る","みる"],["の"],["です"],["」"],["。"]]},{"verse":37,"text":"ガアルは再,ふたたび言,いった、「ごらんなさい。民,たみが国,くにの中央,ちゅうおう部,ぶからおりてきます。一組,くみは占,うらない師,しのテレビンの木,きの方,ほうからきます」。","tok":[["ガアル"],["は"],["再び","ふたたび"],["言った","いった"],["、"],["「"],["ごらん"],["なさい"],["。"],["民","た"],["み"],["が"],["国","くに"],["の"],["中央部","ちゅうおうぶ"],["から"],["おりて"],["きます"],["。"],["一","いち"],["組","くみ"],["は"],["占師","うらないし"],["の"],["テレビン"],["の"],["木","き"],["の"],["方","ほう"],["から"],["きます"],["」"],["。"]]},{"verse":38,"text":"ゼブルは彼,かれに言,いった、「あなたがかつて『アビメレクは何,なにものか。われわれは何,なにものなれば彼,かれに仕,つかえなければならないのか』と言,いったあなたの口,くちは今,いまどこにありますか。これはあなたが侮,あなどった民,たみではありませんか。今,いま、出,でて彼,かれらと戦,たたかいなさい」。","tok":[["ゼブル"],["は"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["が"],["かつて"],["『"],["アビメレク"],["は"],["何もの","なにもの"],["か"],["。"],["われわれ"],["は"],["何","な"],["に"],["もの"],["なれば"],["彼","かれ"],["に"],["仕えなければ","つかえなければ"],["ならない"],["の"],["か"],["』"],["と"],["言った","いった"],["あなた"],["の"],["口","くち"],["は"],["今","いま"],["どこ"],["に"],["あります"],["か"],["。"],["これ"],["は"],["あなた"],["が"],["侮った","あなどった"],["民","たみ"],["で"],["は"],["ありません"],["か"],["。"],["今","いま"],["、"],["出て","でて"],["彼","かれ"],["ら"],["と"],["戦い","たたかい"],["なさい"],["」"],["。"]]},{"verse":39,"text":"そこでガアルはシケムの人々,ひとびとを率,ひきい、出,でてアビメレクと戦,たたかったが、","tok":[["そこ"],["で"],["ガアル"],["は"],["シケム"],["の"],["人々","ひとびと"],["を"],["率い","ひきい"],["、"],["出て","でて"],["アビメレク"],["と"],["戦った","たたかった"],["が"],["、"]]},{"verse":40,"text":"アビメレクは彼,かれを追,おったので、ガアルは彼,かれの前,まえから逃,にげた。そして傷,きずつき倒,たおれる者,ものが多,おおく、門,もんの入口,いりぐちにまで及,およんだ。","tok":[["アビメレク"],["は"],["彼","かれ"],["を"],["追った","おった"],["ので"],["、"],["ガアル"],["は"],["彼","かれ"],["の"],["前","まえ"],["から"],["逃た","にげた"],["。"],["そして"],["傷つき","きずつき"],["倒れる","たおれる"],["者","もの"],["が"],["多く","おおく"],["、"],["門","もん"],["の"],["入口","いりぐち"],["に"],["まで"],["及んだ","およんだ"],["。"]]},{"verse":41,"text":"こうしてアビメレクは引,ひき続,つづいてアルマにいたが、ゼブルはガアルとその身内,みうちの人々,ひとびとを追,おい出,だしてシケムにおらせなかった。","tok":[["こう"],["して"],["アビメレク"],["は"],["引続いて","ひきつづいて"],["アルマ"],["に"],["いた"],["が"],["、"],["ゼブル"],["は"],["ガアル"],["と"],["その"],["身内","みうち"],["の"],["人々","ひとびと"],["を"],["追い出して","おいだして"],["シケム"],["に"],["おらせなかった"],["。"]]},{"verse":42,"text":"翌日,よくじつ、民,たみが畑,はたけに出,でると、そのことがアビメレクに聞,きこえた。","tok":[["翌日","よくじつ"],["、"],["民","た"],["み"],["が"],["畑","はたけ"],["に"],["出る","でる"],["と"],["、"],["その"],["こと"],["が"],["アビメレク"],["に"],["聞こえた","きこえた"],["。"]]},{"verse":43,"text":"アビメレクは自分,じぶんの民,たみを率,ひきい、それを三組,くみに分,わけ、野,のに身,みを伏,ふせて、うかがっていると、民,たみが町,まちから出,でてきたので、たちあがってこれを撃,うった。","tok":[["アビメレク"],["は"],["自分","じぶん"],["の"],["民","たみ"],["を"],["率い","ひきい"],["、"],["それ"],["を"],["三","さん"],["組","くみ"],["に"],["分け","わけ"],["、"],["野","の"],["に"],["身","み"],["を"],["伏せて","ふせて"],["、"],["うかがって"],["いる"],["と"],["、"],["民","た"],["み"],["が"],["町","まち"],["から"],["出て","でて"],["きた"],["ので"],["、"],["たちあがって"],["これ"],["を"],["撃った","うった"],["。"]]},{"verse":44,"text":"アビメレクと、彼,かれと共,ともにいた組,くみの者,ものは襲,おそって行,いって、町,まちの門,もんの入口,いりぐちに立,たち、他,たの二組,くみは野,のにいたすべてのものを襲,おそって、それを殺,ころした。","tok":[["アビメレク"],["と"],["、"],["彼","かれ"],["と"],["共","とも"],["に"],["いた"],["組","くみ"],["の"],["者","もの"],["は"],["襲って","おそって"],["行って","いって"],["、"],["町","まち"],["の"],["門","もん"],["の"],["入口","いりぐち"],["に"],["立ち","たち"],["、"],["他","た"],["の"],["二","に"],["組","くみ"],["は"],["野","の"],["に"],["いた"],["すべて"],["の"],["もの"],["を"],["襲って","おそって"],["、"],["それ"],["を"],["殺ろした","ころした"],["。"]]},{"verse":45,"text":"アビメレクはその日,ひ、終日,しゅうじつ、町,まちを攻,せめ、ついに町,まちを取,とって、そのうちの民,たみを殺,ころし、町,まちを破壊,はかいして、塩,しおをまいた。","tok":[["アビメレク"],["は"],["その"],["日","ひ"],["、"],["終日","しゅうじつ"],["、"],["町","まち"],["を"],["攻め","せめ"],["、"],["ついに"],["町","まち"],["を"],["取って","とって"],["、"],["その"],["うち"],["の"],["民","たみ"],["を"],["殺ろし","ころし"],["、"],["町","まち"],["を"],["破壊","はかい"],["して"],["、"],["塩","しお"],["を"],["まいた"],["。"]]},{"verse":46,"text":"シケムのやぐらの人々,ひとびとは皆,みなこれを聞,きいて、エルベリテの宮,みやの塔,とうにはいった。","tok":[["シケム"],["の"],["やぐら"],["の"],["人々","ひとびと"],["は"],["皆","みな"],["これ"],["を"],["聞いて","きいて"],["、"],["エルベリテ"],["の"],["宮","みや"],["の"],["塔","とう"],["に"],["はいった"],["。"]]},{"verse":47,"text":"シケムのやぐらの人々,ひとびとが皆,みな集,あつまったことがアビメレクに聞,きこえたので、","tok":[["シケム"],["の"],["やぐら"],["の"],["人々","ひとびと"],["が"],["皆","みな"],["集まった","あつまった"],["こと"],["が"],["アビメレク"],["に"],["聞こえた","きこえた"],["ので"],["、"]]},{"verse":48,"text":"アビメレクは自分,じぶんと一緒,いっしょにいた民,たみをことごとく率,ひきいてザルモン山,さんにのぼり、アビメレクは手,てにおのを取,とって、木,きの枝,えだを切,きり落,おとし、それを取,とりあげて自分,じぶんの肩,かたにのせ、一緒,いっしょにいた民,たみにむかって言,いった、「あなたがたはわたしがしたことを見,みたとおりに急,いそいでしなさい」。","tok":[["アビメレク"],["は"],["自分","じぶん"],["と"],["一緒","いっしょ"],["に"],["いた"],["民","たみ"],["を"],["ことごとく"],["率いて","ひきいて"],["ザルモン"],["山","さん"],["に"],["のぼり"],["、"],["アビメレク"],["は"],["手","て"],["に"],["おの"],["を"],["取って","とって"],["、"],["木","き"],["の"],["枝","えだ"],["を"],["切り落とし","きりおとし"],["、"],["それ"],["を"],["取","とり"],["あげて"],["自分","じぶん"],["の"],["肩","かた"],["に"],["のせ"],["、"],["一緒","いっしょ"],["に"],["いた"],["民","たみ"],["に"],["むかって"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["わたし"],["が"],["した"],["こと"],["を"],["見た","みた"],["とおり"],["に"],["急いで","いそいで"],["し"],["なさい"],["」"],["。"]]},{"verse":49,"text":"そこで民,たみもまた皆,みなおのおのその枝,えだを切,きり落,おとし、アビメレクに従,したがって行,いって、枝,えだを塔,とうによせかけ、塔,とうに火,ひをつけて彼,かれらを攻,せめた。こうしてシケムのやぐらの人々,ひとびともまたことごとく死,しんだ。男女,だんじょおおよそ一千人,にんであった。","tok":[["そこ"],["で"],["民","たみ"],["も"],["また"],["皆","みな"],["おのおの"],["その"],["枝","えだ"],["を"],["切り落とし","きりおとし"],["、"],["アビメレク"],["に"],["従って","したがって"],["行って","いって"],["、"],["枝","えだ"],["を"],["塔","とう"],["に"],["よせかけ"],["、"],["塔","とう"],["に"],["火","ひ"],["を"],["つけて"],["彼","かれ"],["ら"],["を"],["攻めた","せめた"],["。"],["こう"],["して"],["シケム"],["の"],["やぐら"],["の"],["人々","ひとびと"],["も"],["また"],["ことごとく"],["死んだ","しんだ"],["。"],["男女","だんじょ"],["おおよそ"],["一千人","にん"],["で"],["あった"],["。"]]},{"verse":50,"text":"ついでアビメレクはテベツに行,いき、テベツに向,むかって陣,じんを張,はり、これを攻,せめ取,とったが、","tok":[["ついで"],["アビメレク"],["は"],["テベツ"],["に"],["行き","いき"],["、"],["テベツ"],["に"],["向かって","むかって"],["陣","じん"],["を"],["張り","はり"],["、"],["これ"],["を"],["攻め取った","せめとった"],["が"],["、"]]},{"verse":51,"text":"町,まちの中,なかに一つの堅固,けんごなやぐらがあって、すべての男女,だんじょすなわち町,まちの人々,ひとびとが皆,みなそこに逃,にげ込,こみ、あとを閉,とざして、やぐらの屋根,やねに上,のぼったので、","tok":[["町","まち"],["の"],["中","なか"],["に"],["一","ひと"],["つ"],["の"],["堅固","けんご"],["な"],["やぐら"],["が"],["あって"],["、"],["すべて"],["の"],["男女","だんじょ"],["すなわち"],["町","まち"],["の"],["人々","ひとびと"],["が"],["皆","みな"],["そこ"],["に"],["逃","にげ"],["込","こみ"],["、"],["あと"],["を"],["閉ざして","とざして"],["、"],["やぐら"],["の"],["屋根","やね"],["に"],["上った","のぼった"],["ので"],["、"]]},{"verse":52,"text":"アビメレクはやぐらのもとに押,おし寄,よせてこれを攻,せめ、やぐらの入口,いりぐちに近,ちかづいて、火,ひをつけて焼,やこうとしたとき、","tok":[["アビメレク"],["は"],["やぐら"],["の"],["もと"],["に"],["押寄せて","おしよせて"],["これ"],["を"],["攻め","せめ"],["、"],["やぐら"],["の"],["入口","いりぐち"],["に"],["近づいて","ちかづいて"],["、"],["火","ひ"],["を"],["つけて"],["焼こう","やこう"],["と"],["した"],["とき"],["、"]]},{"verse":53,"text":"ひとりの女,おんながアビメレクの頭,あたまに、うすの上石,うわいしを投,なげて、その頭,ず骸骨,がいこつを砕,くだいた。","tok":[["ひとり"],["の"],["女","おんな"],["が"],["アビメレク"],["の"],["頭","あたま"],["に"],["、"],["うす"],["の"],["上","うえ"],["石","いし"],["を"],["投て","なげて"],["、"],["その"],["頭","ず"],["骸骨","がいこつ"],["を"],["砕いた","くだいた"],["。"]]},{"verse":54,"text":"アビメレクは自分,じぶんの武器,ぶきを持,もつ若者,わかものを急,いそぎ呼,よんで言,いった、「つるぎを抜,ぬいてわたしを殺,ころせ。さもないと人々,ひとびとはわたしを、女,おんなに殺,ころされたのだと言,いうであろう」。その若者,わかものが彼,かれを刺,さし通,とおしたので彼,かれは死,しんだ。","tok":[["アビメレク"],["は"],["自分","じぶん"],["の"],["武器","ぶき"],["を"],["持つ","もつ"],["若者","わかもの"],["を"],["急ぎ","いそぎ"],["呼んで","よんで"],["言った","いった"],["、"],["「"],["つるぎ"],["を"],["抜いて","ぬいて"],["わたし"],["を"],["殺ろせ","ころせ"],["。"],["さも"],["ない"],["と"],["人々","ひとびと"],["は"],["わたし"],["を"],["、"],["女","おんな"],["に"],["殺ろされた","ころされた"],["の"],["だ"],["と"],["言うで","いうで"],["あろう"],["」"],["。"],["その"],["若者","わかもの"],["が"],["彼","かれ"],["を"],["刺通した","さしとおした"],["ので"],["彼","かれ"],["は"],["死んだ","しんだ"],["。"]]},{"verse":55,"text":"イスラエルの人々,ひとびとはアビメレクの死,しんだのを見,みて、おのおの去,さって家,いえに帰,かえった。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["は"],["アビメレク"],["の"],["死んだ","しんだ"],["の"],["を"],["見て","みて"],["、"],["おのおの"],["去て","さって"],["家","いえ"],["に"],["帰えった","かえった"],["。"]]},{"verse":56,"text":"このように神,かみはアビメレクがその兄弟,きょうだい七十人,にんを殺,ころして、自分,じぶんの父,ちちに対,たいして犯,おかした悪,あくに報,むくいられた。","tok":[["この"],["よう"],["に"],["神","かみ"],["は"],["アビメレク"],["が"],["その"],["兄弟","きょうだい"],["七","なな"],["十人","じゅうにん"],["を"],["殺ろして","ころして"],["、"],["自分","じぶん"],["の"],["父","ちち"],["に対して","にたいして"],["犯した","おかした"],["悪","あく"],["に"],["報いられた","むくいられた"],["。"]]},{"verse":57,"text":"また神,かみはシケムの人々,ひとびとのすべての悪,あくを彼,かれらのこうべに報,むくいられた。こうしてエルバアルの子,こヨタムののろいが、彼,かれらに臨,のぞんだのである。","tok":[["また"],["神","かみ"],["は"],["シケム"],["の"],["人々","ひとびと"],["の"],["すべて"],["の"],["悪","あく"],["を"],["彼","かれ"],["ら"],["の"],["こうべ"],["に"],["報いられた","むくいられた"],["。"],["こう"],["して"],["エルバアル"],["の"],["子","こ"],["ヨタム"],["の"],["のろい"],["が"],["、"],["彼","かれ"],["ら"],["に"],["臨","のぞんだ"],["ので"],["ある"],["。"]]}]
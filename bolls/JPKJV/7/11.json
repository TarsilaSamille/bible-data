[{"verse":1,"text":"さてギレアデびとエフタは強,つよい勇士,ゆうしであったが遊女,ゆうじょの子,こで、エフタの父,ちちはギレアデであった。","tok":[["さて"],["ギレアデ"],["びと"],["エフタ"],["は"],["強い","つよい"],["勇士","ゆうし"],["で"],["あった"],["が"],["遊女","ゆうじょ"],["の"],["子","こ"],["で"],["、"],["エフタ"],["の"],["父","ちち"],["は"],["ギレアデ"],["で"],["あった"],["。"]]},{"verse":2,"text":"ギレアデの妻,つまも子供,こどもを産,うんだが、その妻,つまの子供,こどもたちが成長,せいちょうしたとき、彼,かれらはエフタを追,おい出,だして彼,かれに言,いった、「あなたはほかの女,おんなの産,うんだ子,こだから、わたしたちの父,ちちの家,いえを継,つぐことはできません」。","tok":[["ギレアデ"],["の"],["妻","つま"],["も"],["子供","こども"],["を"],["産んだ","うんだ"],["が"],["、"],["その"],["妻","つま"],["の"],["子供","こども"],["たち"],["が"],["成長","せいちょう"],["した"],["とき"],["、"],["彼","かれ"],["ら"],["は"],["エフタ"],["を"],["追い出して","おいだして"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["は"],["ほか"],["の"],["女","おんな"],["の"],["産んだ","うんだ"],["子","こ"],["だ"],["から"],["、"],["わたしたち"],["の"],["父","ちち"],["の"],["家","いえ"],["を"],["継ぐ","つぐ"],["こと"],["は"],["できません"],["」"],["。"]]},{"verse":3,"text":"それでエフタはその兄弟,きょうだいたちのもとから逃,にげ去,さって、トブの地,ちに住,すんでいると、やくざ者,ものがエフタのもとに集,あつまってきて、彼,かれと一緒,いっしょに出,でかけて略奪,りゃくだつを事,こととしていた。","tok":[["それ"],["で"],["エフタ"],["は"],["その"],["兄弟","きょうだい"],["たち"],["の"],["もと"],["から"],["逃去","にげさっ"],["て"],["、"],["トブ"],["の"],["地","ち"],["に"],["住んで","すんで"],["いる"],["と"],["、"],["やくざ者","やくざもの"],["が"],["エフタ"],["の"],["もと"],["に"],["集まって","あつまって"],["きて"],["、"],["彼","かれ"],["と"],["一緒","いっしょ"],["に"],["出かけて","でかけて"],["略奪","りゃくだつ"],["を"],["事","こと"],["として"],["いた"],["。"]]},{"verse":4,"text":"日,ひがたって後,のち、アンモンの人々,ひとびとはイスラエルと戦,たたかうことになり、","tok":[["日","ひ"],["がた"],["って"],["後","の"],["ち"],["、"],["アンモン"],["の"],["人々","ひとびと"],["は"],["イスラエル"],["と"],["戦う","たたかう"],["こと"],["に"],["なり"],["、"]]},{"verse":5,"text":"アンモンの人々,ひとびとがイスラエルと戦,たたかったとき、ギレアデの長老,ちょうろうたちは行,いってエフタをトブの地,ちから連,つれてこようとして、","tok":[["アンモン"],["の"],["人々","ひとびと"],["が"],["イスラエル"],["と"],["戦った","たたかった"],["とき"],["、"],["ギレアデ"],["の"],["長老","ちょうろう"],["たち"],["は"],["行って","いって"],["エフタ"],["を"],["トブ"],["の"],["地","ち"],["から"],["連れて","つれて"],["こよう"],["として"],["、"]]},{"verse":6,"text":"エフタに言,いった、「きて、わたしたちの大将,たいしょうになってください。そうすればわたしたちはアンモンの人々,ひとびとと戦,たたかうことができます」。","tok":[["エフタ"],["に"],["言った","いった"],["、"],["「"],["きて"],["、"],["わたしたち"],["の"],["大将","たいしょう"],["に"],["なって"],["ください"],["。"],["そう"],["すれば"],["わたしたち"],["は"],["アンモン"],["の"],["人々","ひとびと"],["と"],["戦う","たたかう"],["こと"],["が"],["できます"],["」"],["。"]]},{"verse":7,"text":"エフタはギレアデの長老,ちょうろうたちに言,いった、「あなたがたはわたしを憎,にくんで、わたしの父,ちちの家,いえから追,おい出,だしたではありませんか。しかるに今,いまあなたがたが困,こまっている時,ときとはいえ、わたしのところに来,くるとはどういうわけですか」。","tok":[["エフタ"],["は"],["ギレアデ"],["の"],["長老","ちょうろう"],["たち"],["に"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["わたし"],["を"],["憎んで","にくんで"],["、"],["わたし"],["の"],["父","ちち"],["の"],["家","いえ"],["から"],["追い出したで","おいだしたで"],["は"],["ありません"],["か"],["。"],["しかる"],["に"],["今","いま"],["あなた"],["がた"],["が"],["困まって","こまって"],["いる"],["時","とき"],["と"],["は"],["いえ"],["、"],["わたし"],["の"],["ところ"],["に"],["来る","くる"],["と"],["は"],["どういう"],["わけ"],["です"],["か"],["」"],["。"]]},{"verse":8,"text":"ギレアデの長老,ちょうろうたちはエフタに言,いった、「それでわたしたちは今,いま、あなたに帰,かえったのです。どうぞ、わたしたちと一緒,いっしょに行,いって、アンモンの人々,ひとびとと戦,たたかってください。そしてわたしたちとギレアデに住,すんでいるすべてのものとのかしらになってください」。","tok":[["ギレアデ"],["の"],["長老","ちょうろう"],["たち"],["は"],["エフタ"],["に"],["言った","いった"],["、"],["「"],["それ"],["で"],["わたしたち"],["は"],["今","いま"],["、"],["あなた"],["に"],["帰えった","かえった"],["の"],["です"],["。"],["どうぞ"],["、"],["わたしたち"],["と"],["一緒","いっしょ"],["に"],["行って","いって"],["、"],["アンモン"],["の"],["人々","ひとびと"],["と"],["戦って","たたかって"],["ください"],["。"],["そして"],["わたしたち"],["と"],["ギレアデ"],["に"],["住んで","すんで"],["いる"],["すべて"],["の"],["もの"],["と"],["の"],["かしら"],["に"],["なって"],["ください"],["」"],["。"]]},{"verse":9,"text":"エフタはギレアデの長老,ちょうろうたちに言,いった、「もしあなたがたが、わたしをつれて帰,かえって、アンモンの人々,ひとびとと戦,たたかわせるとき、主,しゅが彼,かれらをわたしにわたされるならば、わたしはあなたがたのかしらとなりましょう」。","tok":[["エフタ"],["は"],["ギレアデ"],["の"],["長老","ちょうろう"],["たち"],["に"],["言った","いった"],["、"],["「"],["もし"],["あなた"],["が"],["た"],["が"],["、"],["わたし"],["を"],["つれて"],["帰えって","かえって"],["、"],["アンモン"],["の"],["人々","ひとびと"],["と"],["戦わせる","たたかわせる"],["とき"],["、"],["主","しゅ"],["が"],["彼","かれ"],["ら"],["を"],["わたし"],["に"],["わたされるならば"],["、"],["わたし"],["は"],["あなた"],["がた"],["の"],["かしら"],["と"],["なりましょう"],["」"],["。"]]},{"verse":10,"text":"ギレアデの長老,ちょうろうたちはエフタに言,いった、「主,しゅはあなたとわたしたちの間,あいだの証人,しょうにんです。わたしたちは必,かならずあなたの言,いわれるとおりにしましょう」。","tok":[["ギレアデ"],["の"],["長老","ちょうろう"],["たち"],["は"],["エフタ"],["に"],["言った","いった"],["、"],["「"],["主","しゅ"],["は"],["あなた"],["と"],["わたしたち"],["の"],["間","あいだ"],["の"],["証人","しょうにん"],["です"],["。"],["わたしたち"],["は"],["必","かならず"],["あなた"],["の"],["言われる","いわれる"],["とおり"],["に"],["しましょう"],["」"],["。"]]},{"verse":11,"text":"そこでエフタはギレアデの長老,ちょうろうたちと一緒,いっしょに行,いった。民,たみは彼,かれを立,たてて自分,じぶんたちのかしらとし、大将,たいしょうとした。それでエフタはミヅパで、自分,じぶんの言葉,ことばをことごとく主,しゅの前,まえに述,のべた。","tok":[["そこ"],["で"],["エフタ"],["は"],["ギレアデ"],["の"],["長老","ちょうろう"],["たち"],["と"],["一緒","いっしょ"],["に"],["行った","いった"],["。"],["民","たみ"],["は"],["彼","かれ"],["を"],["立てて","たてて"],["自分","じぶん"],["たち"],["の"],["かしら"],["と"],["し"],["、"],["大将","たいしょう"],["と"],["した"],["。"],["それ"],["で"],["エフタ"],["は"],["ミヅパ"],["で"],["、"],["自分","じぶん"],["の"],["言葉","ことば"],["を"],["ことごとく"],["主","しゅ"],["の"],["前","まえ"],["に"],["述べた","のべた"],["。"]]},{"verse":12,"text":"かくてエフタはアンモンの人々,ひとびとの王,おうに使者,ししゃをつかわして言,いった、「あなたはわたしとなんのかかわりがあって、わたしのところへ攻,せめてきて、わたしの国,くにと戦,たたかおうとするのですか」。","tok":[["かくて"],["エフタ"],["は"],["アンモン"],["の"],["人々","ひとびと"],["の"],["王","おう"],["に"],["使者","ししゃ"],["を"],["つかわして"],["言った","いった"],["、"],["「"],["あなた"],["は"],["わたし"],["と"],["なん"],["の"],["かかわり"],["が"],["あって"],["、"],["わたし"],["の"],["ところ"],["へ"],["攻めて","せめて"],["きて"],["、"],["わたし"],["の"],["国","くに"],["と"],["戦おう","たたかおう"],["と"],["する"],["の"],["です"],["か"],["」"],["。"]]},{"verse":13,"text":"アンモンの人々,ひとびとの王,おうはエフタの使者,ししゃに答,こたえた、「昔,むかし、イスラエルがエジプトから上,のぼってきたとき、アルノンからヤボクに及,および、またヨルダンに及,およぶわたしの国,くにを奪,うばい取,とったからです。それゆえ今,いま、穏,おだやかにそれを返,かえしなさい」。","tok":[["アンモン"],["の"],["人々","ひとびと"],["の"],["王","おう"],["は"],["エフタ"],["の"],["使者","ししゃ"],["に"],["答","こたえ"],["た"],["、"],["「"],["昔","むかし"],["、"],["イスラエル"],["が"],["エジプト"],["から"],["上って","のぼって"],["きた"],["とき"],["、"],["アルノン"],["から"],["ヤボク"],["に"],["及","および"],["、"],["また"],["ヨルダン"],["に"],["及ぶ","およぶ"],["わたし"],["の"],["国","くに"],["を"],["奪い取った","うばいとった"],["から"],["です"],["。"],["それ"],["ゆえ"],["今","いま"],["、"],["穏","おだやか"],["に"],["それ"],["を"],["返","かえし"],["なさい"],["」"],["。"]]},{"verse":14,"text":"エフタはまた使者,ししゃをアンモンの人々,ひとびとの王,おうにつかわして、","tok":[["エフタ"],["は"],["また"],["使者","ししゃ"],["を"],["アンモン"],["の"],["人々","ひとびと"],["の"],["王","おう"],["に"],["つかわして"],["、"]]},{"verse":15,"text":"言,いわせた、「エフタはこう申,もうします、『イスラエルはモアブの地,ちも、またアンモンの人々,ひとびとの地,ちも取,とりませんでした。","tok":[["言わせた","いわせた"],["、"],["「"],["エフタ"],["は"],["こう"],["申します","もうします"],["、"],["『"],["イスラエル"],["は"],["モアブ"],["の"],["地","ち"],["も"],["、"],["また"],["アンモン"],["の"],["人々","ひとびと"],["の"],["地","ち"],["も"],["取","とり"],["ませんでした"],["。"]]},{"verse":16,"text":"イスラエルはエジプトから上,のぼってきたとき、荒野,あらのをとおって紅海,こうかいにいたり、カデシにきました。","tok":[["イスラエル"],["は"],["エジプト"],["から"],["上って","のぼって"],["きた"],["とき"],["、"],["荒野","あら"],["の"],["を"],["とおって"],["紅海","こうかい"],["に"],["い"],["たり"],["、"],["カデシ"],["に"],["きました"],["。"]]},{"verse":17,"text":"そしてイスラエルは使者,ししゃをエドムの王,おうにつかわして「どうぞ、われわれにあなたの国,くにを通,とおらせてください」と言,いわせましたが、エドムの王,おうは聞,ききいれませんでした。また同,おなじように人,ひとをモアブの王,おうにつかわしたが、彼,かれも承諾,しょうだくしなかったので、イスラエルはカデシにとどまりました。","tok":[["そして"],["イスラエル"],["は"],["使者","ししゃ"],["を"],["エドム"],["の"],["王","おう"],["に"],["つかわして"],["「"],["どうぞ"],["、"],["われわれ"],["に"],["あなた"],["の"],["国","くに"],["を"],["通らせて","とおらせて"],["ください"],["」"],["と"],["言わせました","いわせました"],["が"],["、"],["エドム"],["の"],["王","おう"],["は"],["聞きいれませんでした","ききいれませんでした"],["。"],["また"],["同じ","おなじ"],["よう"],["に"],["人","ひと"],["を"],["モアブ"],["の"],["王","おう"],["に"],["つかわした"],["が"],["、"],["彼","かれ"],["も"],["承諾","しょうだく"],["しなかった"],["ので"],["、"],["イスラエル"],["は"],["カデシ"],["に"],["とどまりました"],["。"]]},{"verse":18,"text":"それから荒野,あらのをとおって、エドムの地,ちとモアブの地,ちを回,まわり、モアブの地,ちの東部,とうぶに達,たっし、アルノンの向,むこうに宿営,しゅくえいしましたがモアブの領域,りょういきには、はいりませんでした。アルノンはモアブの境,さかいだからです。","tok":[["それ"],["から"],["荒野","あらの"],["を"],["とおって"],["、"],["エドム"],["の"],["地","ち"],["と"],["モアブ"],["の"],["地","ち"],["を"],["回わり","まわり"],["、"],["モアブ"],["の"],["地","ち"],["の"],["東部","とうぶ"],["に"],["達し","たっし"],["、"],["アルノン"],["の"],["向こう","むこう"],["に"],["宿営","しゅくえい"],["しました"],["が"],["モアブ"],["の"],["領域","りょういき"],["に"],["は"],["、"],["はいりませんでした"],["。"],["アルノン"],["は"],["モアブ"],["の"],["境","さかい"],["だ"],["から"],["です"],["。"]]},{"verse":19,"text":"次,つぎにイスラエルはヘシボンの王,おうすなわちアモリびとの王,おうシホンに使者,ししゃをつかわし、シホンに向,むかって「どうぞ、われわれにあなたの国,くにをとおって、われわれの目的,もくてき地,ちへ行,いかせてください」と言,いわせました。","tok":[["次","つぎ"],["に"],["イスラエル"],["は"],["ヘシボン"],["の"],["王","おう"],["すなわち"],["アモリ"],["びと"],["の"],["王","おう"],["シホン"],["に"],["使者","ししゃ"],["を"],["つかわし"],["、"],["シホン"],["に"],["向かって","むかって"],["「"],["どうぞ"],["、"],["われわれ"],["に"],["あなた"],["の"],["国","くに"],["を"],["とおって"],["、"],["われわれ"],["の"],["目的地","もくてきち"],["へ"],["行かせて","いかせて"],["ください"],["」"],["と"],["言わせました","いわせました"],["。"]]},{"verse":20,"text":"ところがシホンはイスラエルを信,しんぜず、その領域,りょういきを通,とおらせないばかりか、かえってすべての民,たみを集,あつめてヤハヅに陣,じんを取,とり、イスラエルと戦,たたかいましたが、","tok":[["ところ"],["が"],["シホン"],["は"],["イスラエル"],["を"],["信ぜず","しんぜず"],["、"],["その"],["領域","りょういき"],["を"],["通らせない","とおらせない"],["ばかり"],["か"],["、"],["かえって"],["すべて"],["の"],["民","たみ"],["を"],["集めて","あつめて"],["ヤハヅ"],["に"],["陣","じん"],["を"],["取","とり"],["、"],["イスラエル"],["と"],["戦いました","たたかいました"],["が"],["、"]]},{"verse":21,"text":"イスラエルの神,かみ、主,しゅはシホンとそのすべての民,たみをイスラエルの手,てにわたされたので、イスラエルは彼,かれらを撃,うち破,やぶって、その土地,とちに住,すんでいたアモリびとの地,ちをことごとく占領,せんりょうし、","tok":[["イスラエル"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["シホン"],["と"],["その"],["すべて"],["の"],["民","たみ"],["を"],["イスラエル"],["の"],["手","て"],["に"],["わたされた"],["ので"],["、"],["イスラエル"],["は"],["彼","かれ"],["ら"],["を"],["撃ち破って","うちやぶって"],["、"],["その"],["土地","とち"],["に"],["住んで","すんで"],["いた"],["アモリ"],["びと"],["の"],["地","ち"],["を"],["ことごとく"],["占領","せんりょう"],["し"],["、"]]},{"verse":22,"text":"アルノンからヤボクまでと、荒野,あらのからヨルダンまで、アモリびとの領域,りょういきをことごとく占領,せんりょうしました。","tok":[["アルノン"],["から"],["ヤボク"],["まで"],["と"],["、"],["荒野","あら"],["の"],["から"],["ヨルダン"],["まで"],["、"],["アモリ"],["びと"],["の"],["領域","りょういき"],["を"],["ことごとく"],["占領","せんりょう"],["しました"],["。"]]},{"verse":23,"text":"このようにイスラエルの神,かみ、主,しゅはその民,たみイスラエルの前,まえからアモリびとを追,おい払,はらわれたのに、あなたはそれを取,とろうとするのですか。","tok":[["この"],["よう"],["に"],["イスラエル"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["その"],["民","た"],["みイスラエル"],["の"],["前","まえ"],["から"],["アモリ"],["びと"],["を"],["追い払われた","おいはらわれた"],["のに"],["、"],["あなた"],["は"],["それ"],["を"],["取ろう","とろう"],["と"],["する"],["の"],["です"],["か"],["。"]]},{"verse":24,"text":"あなたは、あなたの神,かみケモシがあなたに取,とらせるものを取,とらないのですか。われわれはわれわれの神,かみ、主,しゅがわれわれの前,まえから追,おい払,はらわれたものの土地,とちを取,とるのです。","tok":[["あなた"],["は"],["、"],["あなた"],["の"],["神","かみ"],["ケモシ"],["が"],["あなた"],["に"],["取らせる","とらせる"],["もの"],["を"],["取らない","とらない"],["の"],["です"],["か"],["。"],["われわれ"],["は"],["われわれ"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["われわれ"],["の"],["前","まえ"],["から"],["追い払われた","おいはらわれた"],["もの"],["の"],["土地","とち"],["を"],["取る","とる"],["の"],["です"],["。"]]},{"verse":25,"text":"あなたはモアブの王,おうチッポルの子,こバラクにまさる者,ものですか。バラクはかつてイスラエルと争,あらそったことがありますか。かつて彼,かれらと戦,たたかったことがありますか。","tok":[["あなた"],["は"],["モアブ"],["の"],["王","おう"],["チッポル"],["の"],["子","こ"],["バラク"],["に"],["まさる"],["者","もの"],["です"],["か"],["。"],["バラク"],["は"],["かつて"],["イスラエル"],["と"],["争った","あらそった"],["こと"],["が"],["あります"],["か"],["。"],["かつて"],["彼","かれ"],["ら"],["と"],["戦った","たたかった"],["こと"],["が"],["あります"],["か"],["。"]]},{"verse":26,"text":"イスラエルはヘシボンとその村里,むらざとに住,すみ、またアロエルとその村里,むらざとおよびアルノンの岸,きしに沿,そうすべての町々,まちまちに住,すむこと三百年,ねんになりますが、あなたがたはどうしてその間,かんにそれを取,とりもどさなかったのですか。","tok":[["イスラエル"],["は"],["ヘシボン"],["と"],["その"],["村里","むらざと"],["に"],["住み","すみ"],["、"],["また"],["アロエル"],["と"],["その"],["村里","むらざと"],["および"],["アルノン"],["の"],["岸","きし"],["に"],["沿う","そう"],["すべて"],["の"],["町々","まちまち"],["に"],["住む","すむ"],["こと"],["三百","さんひゃく"],["年","ねん"],["に"],["なります"],["が"],["、"],["あなた"],["がた"],["は"],["どう"],["して"],["その"],["間","かん"],["に"],["それ"],["を"],["取","とり"],["もどさなかった"],["の"],["です"],["か"],["。"]]},{"verse":27,"text":"わたしはあなたに何,なにも悪,わるい事,ことをしたこともないのに、あなたはわたしと戦,たたかって、わたしに害,がいを加,くわえようとします。審判者,しんぱんしゃであられる主,しゅよ、どうぞ、きょう、イスラエルの人々,ひとびととアンモンの人々,ひとびととの間,あいだをおさばきください』」。","tok":[["わたし"],["は"],["あなた"],["に"],["何に","なに"],["も"],["悪い","わるい"],["事","こと"],["を"],["した"],["こと"],["も"],["ない"],["のに"],["、"],["あなた"],["は"],["わたし"],["と"],["戦って","たたかって"],["、"],["わたし"],["に"],["害","がい"],["を"],["加えよう","くわえよう"],["と"],["します"],["。"],["審判者","しんぱんしゃ"],["で"],["あられる"],["主","しゅ"],["よ"],["、"],["どうぞ"],["、"],["きょう"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["と"],["アンモン"],["の"],["人々","ひとびと"],["と"],["の"],["間","あいだ"],["を"],["おさばき"],["ください"],["』"],["」"],["。"]]},{"verse":28,"text":"しかしアンモンの人々,ひとびとの王,おうはエフタが言,いいつかわした言葉,ことばをききいれなかった。","tok":[["しかし"],["アンモン"],["の"],["人々","ひとびと"],["の"],["王","おう"],["は"],["エフタ"],["が"],["言い","いい"],["つかわした"],["言葉","ことば"],["を"],["ききいれなかった"],["。"]]},{"verse":29,"text":"時,ときに主,しゅの霊,れいがエフタに臨,のぞみ、エフタはギレアデおよびマナセをとおって、ギレアデのミヅパに行,いき、ギレアデのミヅパから進,すすんでアンモンの人々,ひとびとのところに行,いった。","tok":[["時","とき"],["に"],["主","しゅ"],["の"],["霊","れい"],["が"],["エフタ"],["に"],["臨み","のぞみ"],["、"],["エフタ"],["は"],["ギレアデ"],["および"],["マナセ"],["を"],["とおって"],["、"],["ギレアデ"],["の"],["ミヅパ"],["に"],["行き","いき"],["、"],["ギレアデ"],["の"],["ミヅパ"],["から"],["進んで","すすんで"],["アンモン"],["の"],["人々","ひとびと"],["の"],["ところ"],["に"],["行った","いった"],["。"]]},{"verse":30,"text":"エフタは主,しゅに誓願,せいがんを立,たてて言,いった、「もしあなたがアンモンの人々,ひとびとをわたしの手,てにわたされるならば、","tok":[["エフタ"],["は"],["主に","しゅに"],["誓願","せいがん"],["を"],["立てて","たてて"],["言った","いった"],["、"],["「"],["もし"],["あなた"],["が"],["アンモン"],["の"],["人々","ひとびと"],["を"],["わたし"],["の"],["手","て"],["に"],["わたされるならば"],["、"]]},{"verse":31,"text":"わたしがアンモンの人々,ひとびとに勝,かって帰,かえるときに、わたしの家,いえの戸口,とぐちから出,でてきて、わたしを迎,むかえるものはだれでも主,しゅのものとし、その者,ものを燔祭,はんさいとしてささげましょう」。","tok":[["わたし"],["が"],["アンモン"],["の"],["人々","ひとびと"],["に"],["勝って","かって"],["帰える","かえる"],["とき"],["に"],["、"],["わたし"],["の"],["家","いえ"],["の"],["戸口","とぐち"],["から"],["出て","でて"],["きて"],["、"],["わたし"],["を"],["迎","むかえ"],["る"],["もの"],["は"],["だれ"],["で"],["も"],["主","しゅ"],["の"],["もの"],["と"],["し"],["、"],["その"],["者","もの"],["を"],["燔祭","はんさい"],["として"],["ささげましょう"],["」"],["。"]]},{"verse":32,"text":"エフタはアンモンの人々,ひとびとのところに進,すすんで行,いって、彼,かれらと戦,たたかったが、主,しゅは彼,かれらをエフタの手,てにわたされたので、","tok":[["エフタ"],["は"],["アンモン"],["の"],["人々","ひとびと"],["の"],["ところ"],["に"],["進んで","すすんで"],["行って","いって"],["、"],["彼","かれ"],["ら"],["と"],["戦った","たたかった"],["が"],["、"],["主","しゅ"],["は"],["彼","かれ"],["ら"],["を"],["エフタ"],["の"],["手","て"],["に"],["わたされた"],["ので"],["、"]]},{"verse":33,"text":"アロエルからミンニテの附近,ふきんまで、二十の町,まちを撃,うち敗,はいり、アベル・ケラミムに至,いたるまで、非常,ひじょうに多,おおくの人,ひとを殺,ころした。こうしてアンモンの人々,ひとびとはイスラエルの人々,ひとびとの前,まえに攻,せめ伏,ふせられた。","tok":[["アロエル"],["から"],["ミンニテ"],["の"],["附近","ふきん"],["まで"],["、"],["二十","にじゅう"],["の"],["町","まち"],["を"],["撃ち","うち"],["敗り","はいり"],["、"],["アベル"],["・"],["ケラミム"],["に"],["至る","いたる"],["まで"],["、"],["非常","ひじょう"],["に"],["多く","おおく"],["の"],["人","ひと"],["を"],["殺ろした","ころした"],["。"],["こう"],["して"],["アンモン"],["の"],["人々","ひとびと"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["前","まえ"],["に"],["攻め伏せられた","せめふせられた"],["。"]]},{"verse":34,"text":"やがてエフタはミヅパに帰,かえり、自分,じぶんの家,いえに来,くると、彼,かれの娘,むすめが鼓,つづみをもち、舞,まい踊,おどって彼,かれを出迎,でむかえた。彼女,かのじょはエフタのひとり子,こで、ほかに男子,だんしも女子,じょしもなかった。","tok":[["やがて"],["エフタ"],["は"],["ミヅパ"],["に"],["帰えり","かえり"],["、"],["自分","じぶん"],["の"],["家","いえ"],["に"],["来る","くる"],["と"],["、"],["彼","かれ"],["の"],["娘","むすめ"],["が"],["鼓","つづみ"],["を"],["もち"],["、"],["舞踊","まいおど"],["って"],["彼","かれ"],["を"],["出迎","でむかえ"],["た"],["。"],["彼女","かのじょ"],["は"],["エフタ"],["の"],["ひとり"],["子","こ"],["で"],["、"],["ほか"],["に"],["男子","だんし"],["も"],["女子","じょし"],["も"],["なかった"],["。"]]},{"verse":35,"text":"エフタは彼女,かのじょを見,みると、衣,ころもを裂,さいて言,いった、「ああ、娘,むすめよ、あなたは全,まったくわたしを打,うちのめした。わたしを悩,なやますものとなった。わたしが主,しゅに誓,ちかったのだから改,あらためることはできないのだ」。","tok":[["エフタ"],["は"],["彼女","かのじょ"],["を"],["見る","みる"],["と"],["、"],["衣","ころも"],["を"],["裂いて","さいて"],["言った","いった"],["、"],["「"],["ああ"],["、"],["娘","むすめ"],["よ"],["、"],["あなた"],["は"],["全く","まったく"],["わたし"],["を"],["打ちのめした","うちのめした"],["。"],["わたし"],["を"],["悩す","なやます"],["もの"],["と"],["なった"],["。"],["わたし"],["が"],["主に","しゅに"],["誓った","ちかった"],["の"],["だ"],["から"],["改める","あらためる"],["こと"],["は"],["できない"],["の"],["だ"],["」"],["。"]]},{"verse":36,"text":"娘,むすめは言,いった、「父,ちちよ、あなたは主,しゅに誓,ちかわれたのですから、主,しゅがあなたのために、あなたの敵,てきアンモンの人々,ひとびとに報復,ほうふくされた今,いま、あなたが言,いわれたとおりにわたしにしてください」。","tok":[["娘","むすめ"],["は"],["言った","いった"],["、"],["「"],["父","ちち"],["よ"],["、"],["あなた"],["は"],["主に","しゅに"],["誓われた","ちかわれた"],["の"],["です"],["から"],["、"],["主","しゅ"],["が"],["あなた"],["の"],["ため"],["に"],["、"],["あなた"],["の"],["敵","てき"],["アンモン"],["の"],["人々","ひとびと"],["に"],["報復","ほうふく"],["された"],["今","いま"],["、"],["あなた"],["が"],["言われた","いわれた"],["とおり"],["に"],["わたし"],["に"],["して"],["ください"],["」"],["。"]]},{"verse":37,"text":"娘,むすめはまた父,ちちに言,いった、「どうぞ、この事,ことをわたしにさせてください。すなわち二か月,げつの間,あいだわたしをゆるし、友,ともだちと一緒,いっしょに行,いって、山々,やまやまをゆきめぐり、わたしの処女,しょじょであることを嘆,なげかせてください」。","tok":[["娘","むすめ"],["は"],["また"],["父","ちち"],["に"],["言った","いった"],["、"],["「"],["どうぞ"],["、"],["この"],["事","こと"],["を"],["わたし"],["に"],["させて"],["ください"],["。"],["すなわち"],["二","に"],["か月","かげつ"],["の"],["間","あいだ"],["わたし"],["を"],["ゆるし"],["、"],["友だち","ともだち"],["と"],["一緒","いっしょ"],["に"],["行って","いって"],["、"],["山々","やまやま"],["を"],["ゆき"],["めぐり"],["、"],["わたし"],["の"],["処女","しょじょ"],["で"],["ある"],["こと"],["を"],["嘆かせて","なげかせて"],["ください"],["」"],["。"]]},{"verse":38,"text":"エフタは「行,いきなさい」と言,いって、彼女,かのじょを二か月,げつの間,あいだ、出,だしてやった。彼女,かのじょは友,ともだちと一緒,いっしょに行,いって、山,やまの上,うえで自分,じぶんの処女,しょじょであることを嘆,なげいたが、","tok":[["エフタ"],["は"],["「"],["行き","いき"],["なさい"],["」"],["と"],["言って","いって"],["、"],["彼女","かのじょ"],["を"],["二","に"],["か月","かげつ"],["の"],["間","あいだ"],["、"],["出して","だして"],["やった"],["。"],["彼女","かのじょ"],["は"],["友だち","ともだち"],["と"],["一緒","いっしょ"],["に"],["行って","いって"],["、"],["山","やま"],["の"],["上","うえ"],["で"],["自分","じぶん"],["の"],["処女","しょじょ"],["で"],["ある"],["こと"],["を"],["嘆いた","なげいた"],["が"],["、"]]},{"verse":39,"text":"二か月,げつの後,のち、父,ちちのもとに帰,かえってきたので、父,ちちは誓,ちかった誓願,せいがんのとおりに彼女,かのじょにおこなった。彼女,かのじょはついに男,おとこを知,しらなかった。","tok":[["二","に"],["か月","かげつ"],["の"],["後","の"],["ち"],["、"],["父","ちち"],["の"],["もと"],["に"],["帰えって","かえって"],["きた"],["ので"],["、"],["父","ちち"],["は"],["誓った","ちかった"],["誓願","せいがん"],["の"],["とおり"],["に"],["彼女","かのじょ"],["に"],["おこなった"],["。"],["彼女","かのじょ"],["は"],["ついに"],["男","おとこ"],["を"],["知らなかった","しらなかった"],["。"]]},{"verse":40,"text":"これによって年々,ねんねんイスラエルの娘,むすめたちは行,いって、年,ねんに四日,かほどギレアデびとエフタの娘,むすめのために嘆,なげくことがイスラエルのならわしとなった。","tok":[["これ"],["によって"],["年々","ねんねん"],["イスラエル"],["の"],["娘","むすめ"],["たち"],["は"],["行って","いって"],["、"],["年","ねん"],["に"],["四日","か"],["ほど"],["ギレアデ"],["びと"],["エフタ"],["の"],["娘","むすめ"],["の"],["ため"],["に"],["嘆く","なげく"],["こと"],["が"],["イスラエル"],["の"],["ならわし"],["と"],["なった"],["。"]]}]
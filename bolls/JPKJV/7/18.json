[{"verse":1,"text":"そのころイスラエルには王,おうがなかった。そのころダンびとの部族,ぶぞくはイスラエルの部族,ぶぞくのうちにあって、その日,ひまでまだ嗣,し業,ぎょうの地,ちを得,えなかったので自分,じぶんたちの住,すむべき嗣,し業,ぎょうの地,ちを求,もとめていた。","tok":[["その"],["ころ"],["イスラエル"],["に"],["は"],["王","おう"],["が"],["なかった"],["。"],["その"],["ころ"],["ダン"],["びと"],["の"],["部族","ぶぞく"],["は"],["イスラエル"],["の"],["部族","ぶぞく"],["の"],["うち"],["に"],["あって"],["、"],["その"],["日","ひ"],["まで"],["まだ"],["嗣業","しぎょう"],["の"],["地","ち"],["を"],["得なかった","えなかった"],["ので"],["自分","じぶん"],["たち"],["の"],["住むべき","すむべき"],["嗣業","しぎょう"],["の"],["地","ち"],["を"],["求めて","もとめて"],["いた"],["。"]]},{"verse":2,"text":"それでダンの人々,ひとびとは自分,じぶんの部族,ぶぞくの総勢,そうぜいのうちから、勇者,ゆうしゃ五人,にんをゾラとエシタオルからつかわして土地,とちをうかがい探,さぐらせた。すなわち彼,かれらに言,いった、「行,いって土地,とちを探,さぐってきなさい」。彼,かれらはエフライムの山地,さんちに行,いき、ミカの家,いえに着,ついて、そこに宿,やどろうとした。","tok":[["それ"],["で"],["ダン"],["の"],["人々","ひとびと"],["は"],["自分","じぶん"],["の"],["部族","ぶぞく"],["の"],["総勢","そうぜい"],["の"],["うち"],["から"],["、"],["勇者","ゆうしゃ"],["五人","にん"],["を"],["ゾラ"],["と"],["エシタオル"],["から"],["つかわして"],["土地","とち"],["を"],["うかがい"],["探ぐらせた","さぐらせた"],["。"],["すなわち"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["行って","いって"],["土地","とち"],["を"],["探って","さぐって"],["き"],["なさい"],["」"],["。"],["彼","かれ"],["ら"],["は"],["エフライム"],["の"],["山地","さんち"],["に"],["行き","いき"],["、"],["ミカ"],["の"],["家","いえ"],["に"],["着いて","ついて"],["、"],["そこ"],["に"],["宿ろう","やどろう"],["と"],["した"],["。"]]},{"verse":3,"text":"彼,かれらがミカの家,いえに近,ちかづいたとき、レビびとである若者,わかものの声,こえを聞,ききわけたので、身,みをめぐらしてそこにはいって彼,かれに言,いった、「だれがあなたをここに連,つれてきたのですか。あなたはここで何,なにをしているのですか。ここになんの用,ようがあるのですか」。","tok":[["彼","かれ"],["ら"],["が"],["ミカ"],["の"],["家","いえ"],["に"],["近づいた","ちかづいた"],["とき"],["、"],["レビ"],["びと"],["で"],["ある"],["若者","わかもの"],["の"],["声","こえ"],["を"],["聞","きき"],["わけた"],["ので"],["、"],["身","み"],["を"],["めぐらして"],["そこ"],["に"],["はいって"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["だれ"],["が"],["あなた"],["を"],["ここ"],["に"],["連れて","つれて"],["きた"],["の"],["です"],["か"],["。"],["あなた"],["は"],["ここ"],["で"],["何に","なに"],["を"],["して"],["いる"],["の"],["です"],["か"],["。"],["ここ"],["に"],["なん"],["の"],["用","よう"],["が"],["ある"],["の"],["です"],["か"],["」"],["。"]]},{"verse":4,"text":"若者,わかものは彼,かれらに言,いった、「ミカが、かようかようにしてわたしを雇,やとったので、わたしはその祭司,さいしとなったのです」。","tok":[["若者","わかもの"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["ミカ"],["が"],["、"],["かよう"],["かよう"],["に"],["して"],["わたし"],["を"],["雇った","やとった"],["ので"],["、"],["わたし"],["は"],["その"],["祭司","さいし"],["と"],["なった"],["の"],["です"],["」"],["。"]]},{"verse":5,"text":"彼,かれらは言,いった、「どうぞ、神,かみに伺,うかがって、われわれが行,いく道,みちにしあわせがあるかどうかを知,しらせてください」。","tok":[["彼","かれ"],["ら"],["は"],["言った","いった"],["、"],["「"],["どうぞ"],["、"],["神","かみ"],["に"],["伺って","うかがって"],["、"],["われわれ"],["が"],["行く","いく"],["道","みち"],["に"],["しあわせ"],["が"],["ある"],["か"],["どう"],["か"],["を"],["知らせて","しらせて"],["ください"],["」"],["。"]]},{"verse":6,"text":"その祭司,さいしは彼,かれらに言,いった、「安心,あんしんして行,いきなさい。あなたがたが行,いく道,みちは主,しゅが見守,みまもっておられます」。","tok":[["その"],["祭司","さいし"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["安心","あんしん"],["して"],["行き","いき"],["なさい"],["。"],["あなた"],["がた"],["が"],["行く","いく"],["道","みち"],["は"],["主","しゅ"],["が"],["見守って","みまもって"],["おられます"],["」"],["。"]]},{"verse":7,"text":"そこで五人,にんの者,ものは去,さってライシに行,いき、そこにいる民,たみを見,みると、彼,かれらは安,やすらかに住,すまい、その穏,おだやかで安,やすらかなことシドンびとのようであって、この国,くにには一つとして欠,かけたものがなく、富,とみを持,もち、またシドンびとと遠,とおく離,はなれており、ほかの民,たみと交,まじわることがなかった。","tok":[["そこ"],["で"],["五人","にん"],["の"],["者","もの"],["は"],["去て","さって"],["ライシ"],["に"],["行き","いき"],["、"],["そこ"],["に"],["いる"],["民","たみ"],["を"],["見る","みる"],["と"],["、"],["彼","かれ"],["ら"],["は"],["安らか","やすらか"],["に"],["住まい","すまい"],["、"],["その"],["穏","おだやか"],["で"],["安らか","やすらか"],["な"],["こと"],["シドン"],["びと"],["の"],["よう"],["で"],["あって"],["、"],["この"],["国","くに"],["に"],["は"],["一","ひと"],["つ"],["として"],["欠けた","かけた"],["もの"],["が"],["なく"],["、"],["富","とみ"],["を"],["持","もち"],["、"],["また"],["シドン"],["びと"],["と"],["遠く","とおく"],["離れて","はなれて"],["おり"],["、"],["ほか"],["の"],["民","たみ"],["と"],["交じわる","まじわる"],["こと"],["が"],["なかった"],["。"]]},{"verse":8,"text":"かくて彼,かれらがゾラとエシタオルにおる兄弟,きょうだいたちのもとに帰,かえってくると、兄弟,きょうだいたちは彼,かれらに言,いった、「いかがでしたか」。","tok":[["かくて"],["彼","かれ"],["ら"],["が"],["ゾラ"],["と"],["エシタオル"],["に"],["おる"],["兄弟","きょうだい"],["たち"],["の"],["もと"],["に"],["帰えって","かえって"],["くる"],["と"],["、"],["兄弟","きょうだい"],["たち"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["いかが"],["でした"],["か"],["」"],["。"]]},{"verse":9,"text":"彼,かれらは言,いった、「立,たって彼,かれらのところに攻,せめ上,のぼりましょう。われわれはかの地,ちを見,みたが、非常,ひじょうに豊,ゆたかです。あなたがたはなぜじっとしているのですか。ためらわずに進,すすんで行,いって、かの地,ちを取,とりなさい。","tok":[["彼","かれ"],["ら"],["は"],["言った","いった"],["、"],["「"],["立って","たって"],["彼","かれ"],["ら"],["の"],["ところ"],["に"],["攻め上りましょう","せめのぼりましょう"],["。"],["われわれ"],["は"],["かの"],["地","ち"],["を"],["見た","みた"],["が"],["、"],["非常","ひじょう"],["に"],["豊","ゆたか"],["です"],["。"],["あなた"],["がた"],["は"],["なぜ"],["じっと"],["して"],["いる"],["の"],["です"],["か"],["。"],["ためらわず"],["に"],["進んで","すすんで"],["行って","いって"],["、"],["かの"],["地","ち"],["を"],["取","とり"],["なさい"],["。"]]},{"verse":10,"text":"あなたがたが行,いけば、安,やすらかにおる民,たみの所,ところに行,いくでしょう。その地,ちは広,ひろく、神,かみはそれをあなたがたの手,てに賜,たまわるのです。そこには地,ちにあるもの一つとして欠,かけているものはありません」。","tok":[["あなた"],["がた"],["が"],["行けば","いけば"],["、"],["安らか","やすらか"],["に"],["おる"],["民","たみ"],["の"],["所","ところ"],["に"],["行くでしょう","いくでしょう"],["。"],["その"],["地","ち"],["は"],["広く","ひろく"],["、"],["神","かみ"],["は"],["それ"],["を"],["あなた"],["がた"],["の"],["手","て"],["に"],["賜わる","たまわる"],["の"],["です"],["。"],["そこ"],["に"],["は"],["地","ち"],["に"],["ある"],["もの"],["一","ひと"],["つ"],["として"],["欠けて","かけて"],["いる"],["もの"],["は"],["ありません"],["」"],["。"]]},{"verse":11,"text":"そこでダンの氏族,しぞくのもの六百人,にんが武器,ぶきを帯,おびて、ゾラとエシタオルを出発,しゅっぱつし、","tok":[["そこ"],["で"],["ダン"],["の"],["氏族","しぞく"],["の"],["もの"],["六百人","にん"],["が"],["武器","ぶき"],["を"],["帯","おび"],["て"],["、"],["ゾラ"],["と"],["エシタオル"],["を"],["出発","しゅっぱつ"],["し"],["、"]]},{"verse":12,"text":"上,のぼって行,いってユダのキリアテ・ヤリムに陣,じんを張,はった。このゆえに、その所,ところは今日,こんにちまでマハネダンと呼,よばれる。それはキリアテ・ヤリムの西,にしにある。","tok":[["上って","のぼって"],["行って","いって"],["ユダ"],["の"],["キリアテ"],["・"],["ヤリム"],["に"],["陣","じん"],["を"],["張った","はった"],["。"],["この"],["ゆえ"],["に"],["、"],["その"],["所","ところ"],["は"],["今日","こん"],["に"],["ち"],["まで"],["マハネダン"],["と"],["呼ばれる","よばれる"],["。"],["それ"],["は"],["キリアテ"],["・"],["ヤリム"],["の"],["西","にし"],["に"],["ある"],["。"]]},{"verse":13,"text":"彼,かれらはそこからエフライムの山地,さんちに進,すすみ、ミカの家,いえに着,ついた。","tok":[["彼","かれ"],["ら"],["は"],["そこ"],["から"],["エフライム"],["の"],["山地","さんち"],["に"],["進み","すすみ"],["、"],["ミカ"],["の"],["家","いえ"],["に"],["着いた","ついた"],["。"]]},{"verse":14,"text":"かのライシの国,くにをうかがいに行,いった五人,にんの者,ものはその兄弟,きょうだいたちに言,いった、「あなたがたはこれらの家,いえにエポデとテラピムと刻,きざんだ像,ぞうと鋳,いた像,ぞうのあるのを知,しっていますか。それであなたがたは今,いま、なすべきことを決,きめなさい」。","tok":[["かの"],["ライシ"],["の"],["国","くに"],["を"],["うかがい"],["に"],["行った","いった"],["五人","にん"],["の"],["者","もの"],["は"],["その"],["兄弟","きょうだい"],["たち"],["に"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["これ"],["ら"],["の"],["家","いえ"],["に"],["エポデ"],["と"],["テラピム"],["と"],["刻んだ","きざんだ"],["像","ぞう"],["と"],["鋳た","いた"],["像","ぞう"],["の"],["ある"],["の"],["を"],["知って","しって"],["います"],["か"],["。"],["それ"],["で"],["あなた"],["がた"],["は"],["今","いま"],["、"],["なすべき"],["こと"],["を"],["決め","きめ"],["なさい"],["」"],["。"]]},{"verse":15,"text":"そこで彼,かれらはその方,ほうへ身,みをめぐらして、かのレビびとの若者,わかものの家,いえすなわちミカの家,いえに行,いって、彼,かれに安否,あんぴを問,とうた。","tok":[["そこ"],["で"],["彼","かれ"],["ら"],["は"],["その"],["方","ほう"],["へ"],["身","み"],["を"],["めぐらして"],["、"],["かの"],["レビ"],["びと"],["の"],["若者","わかもの"],["の"],["家","いえ"],["すなわち"],["ミカ"],["の"],["家","いえ"],["に"],["行って","いって"],["、"],["彼","かれ"],["に"],["安否","あんぴ"],["を"],["問うた","とうた"],["。"]]},{"verse":16,"text":"しかし武器,ぶきを帯,おびた六百人,にんのダンの人々,ひとびとは門,もんの入口,いりぐちに立,たっていた。","tok":[["しかし"],["武器","ぶき"],["を"],["帯","おび"],["た"],["六百人","にん"],["の"],["ダン"],["の"],["人々","ひとびと"],["は"],["門","もん"],["の"],["入口","いりぐち"],["に"],["立って","たって"],["いた"],["。"]]},{"verse":17,"text":"かの土地,とちをうかがいに行,いった五人,にんの者,ものは上,のぼって行,いって、そこにはいり、刻,きざんだ像,ぞうとエポデとテラピムと鋳,いた像,ぞうとを取,とったが、祭司,さいしは武器,ぶきを帯,おびた六百人,にんの者,ものと共,ともに門,もんの入口,いりぐちに立,たっていた。","tok":[["かの"],["土地","とち"],["を"],["うかがい"],["に"],["行った","いった"],["五人","にん"],["の"],["者","もの"],["は"],["上って","のぼって"],["行って","いって"],["、"],["そこ"],["に"],["はいり"],["、"],["刻","き"],["ざ"],["ん"],["だ"],["像","ぞう"],["と"],["エポデ"],["と"],["テラピム"],["と"],["鋳た","いた"],["像","ぞう"],["と"],["を"],["取った","とった"],["が"],["、"],["祭司","さいし"],["は"],["武器","ぶき"],["を"],["帯","おび"],["た"],["六百人","にん"],["の"],["者","もの"],["と"],["共","とも"],["に"],["門","もん"],["の"],["入口","いりぐち"],["に"],["立って","たって"],["いた"],["。"]]},{"verse":18,"text":"彼,かれらがミカの家,いえにはいって刻,きざんだ像,ぞうとエポデとテラピムと鋳,いた像,ぞうとを取,とった時,とき、祭司,さいしは彼,かれらに言,いった、「あなたがたは何,なにをなさいますか」。","tok":[["彼","かれ"],["ら"],["が"],["ミカ"],["の"],["家","いえ"],["に"],["はいって"],["刻んだ","きざんだ"],["像","ぞう"],["と"],["エポデ"],["と"],["テラピム"],["と"],["鋳た","いた"],["像","ぞう"],["と"],["を"],["取った","とった"],["時","とき"],["、"],["祭司","さいし"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["何に","なに"],["を"],["なさいます"],["か"],["」"],["。"]]},{"verse":19,"text":"彼,かれらは言,いった、「黙,だまりなさい。あなたの手,てを口,くちにあてて、われわれと一緒,いっしょにきて、われわれのために父,ちちとも祭司,さいしともなりなさい。ひとりの家,いえの祭司,さいしであるのと、イスラエルの一,いち部族,ぶぞく、一,いち氏族,しぞくの祭司,さいしであるのと、どちらがよいですか」。","tok":[["彼","かれ"],["ら"],["は"],["言った","いった"],["、"],["「"],["黙り","だまり"],["なさい"],["。"],["あなた"],["の"],["手","て"],["を"],["口","くち"],["に"],["あてて"],["、"],["われわれ"],["と"],["一緒","いっしょ"],["に"],["きて"],["、"],["われわれ"],["の"],["ため"],["に"],["父","ちち"],["とも"],["祭司","さいし"],["と"],["も"],["なり"],["なさい"],["。"],["ひとり"],["の"],["家","いえ"],["の"],["祭司","さいし"],["で"],["ある"],["の"],["と"],["、"],["イスラエル"],["の"],["一部族","いちぶぞく"],["、"],["一","いち"],["氏族","しぞく"],["の"],["祭司","さいし"],["で"],["ある"],["の"],["と"],["、"],["どちら"],["が"],["よいです"],["か"],["」"],["。"]]},{"verse":20,"text":"祭司,さいしは喜,よろこんで、エポデとテラピムと刻,きざんだ像,ぞうとを取,とり、民,たみのなかに加,くわわった。","tok":[["祭司","さいし"],["は"],["喜こんで","よろこんで"],["、"],["エポデ"],["と"],["テラピム"],["と"],["刻んだ","きざんだ"],["像","ぞう"],["と"],["を"],["取","とり"],["、"],["民","たみ"],["の"],["なか"],["に"],["加わわった","くわわった"],["。"]]},{"verse":21,"text":"かくて彼,かれらは身,みをめぐらして去,さり、その子,こ供,ともたちと家畜,かちくと貨,か財,ざいをさきにたてて進,すすんだが、","tok":[["かくて"],["彼","かれ"],["ら"],["は"],["身","み"],["を"],["めぐらして"],["去り","さり"],["、"],["その"],["子供","ことも"],["たち"],["と"],["家畜","かちく"],["と"],["貨財","かざい"],["を"],["さき"],["に"],["たてて"],["進んだ","すすんだ"],["が"],["、"]]},{"verse":22,"text":"ミカの家,いえをはるかに離,はなれたとき、ミカは家,いえに近,ちかい家,いえの人々,ひとびとを集,あつめ、ダンの人々,ひとびとに追,おいつき、","tok":[["ミカ"],["の"],["家","いえ"],["を"],["はるか"],["に"],["離れた","はなれた"],["とき"],["、"],["ミカ"],["は"],["家","いえ"],["に"],["近い","ちかい"],["家","いえ"],["の"],["人々","ひとびと"],["を"],["集め","あつめ"],["、"],["ダン"],["の"],["人々","ひとびと"],["に"],["追いつき","おいつき"],["、"]]},{"verse":23,"text":"ダンの人々,ひとびとを呼,よんだので、彼,かれらはふり向,むいてミカに言,いった、「あなたがそのように仲間,なかまを連,つれてきたのは、どうしたのですか」。","tok":[["ダン"],["の"],["人々","ひとびと"],["を"],["呼","よんだ"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["ふり向いて","ふりむいて"],["ミカ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["が"],["その"],["よう"],["に"],["仲間","なかま"],["を"],["連れて","つれて"],["きた"],["の"],["は"],["、"],["どう"],["した"],["の"],["です"],["か"],["」"],["。"]]},{"verse":24,"text":"彼,かれは言,いった、「あなたがたが、わたしの造,つくった神々,かみがみおよび祭司,さいしを奪,うばい去,さったので、わたしに何,なにが残,のこっていますか。しかるにあなたがたがわたしに向,むかって『どうしたのですか』と言,いわれるとは何事,なにごとですか」。","tok":[["彼","かれ"],["は"],["言った","いった"],["、"],["「"],["あなた"],["が"],["た"],["が"],["、"],["わたし"],["の"],["造った","つくった"],["神々","かみがみ"],["および"],["祭司","さいし"],["を"],["奪い","うばい"],["去た","さった"],["ので"],["、"],["わたし"],["に"],["何に","なに"],["が"],["残って","のこって"],["います"],["か"],["。"],["しかる"],["に"],["あなた"],["がた"],["が"],["わたし"],["に"],["向かって","むかって"],["『"],["どう"],["した"],["の"],["です"],["か"],["』"],["と"],["言われる","いわれる"],["と"],["は"],["何事","なにごと"],["です"],["か"],["」"],["。"]]},{"verse":25,"text":"ダンの人々,ひとびとは彼,かれに言,いった、「あなたは大,おおきな声,こえを出,ださないがよい。気,きの荒,あらい連中,れんちゅうがあなたに撃,うちかかって、あなたは自分,じぶんの命,いのちと家族,かぞくの命,いのちを失,うしなうようになるでしょう」。","tok":[["ダン"],["の"],["人々","ひとびと"],["は"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["は"],["大きな","おおきな"],["声","こえ"],["を"],["出さない","ださない"],["が"],["よい"],["。"],["気","き"],["の"],["荒い","あらい"],["連中","れんちゅう"],["が"],["あなた"],["に"],["撃ち","うち"],["かかって"],["、"],["あなた"],["は"],["自分","じぶん"],["の"],["命","いのち"],["と"],["家族","かぞく"],["の"],["命","いのち"],["を"],["失なう","うしなう"],["よう"],["に"],["なるでしょう"],["」"],["。"]]},{"verse":26,"text":"こうしてダンの人々,ひとびとは去,さって行,いったが、ミカは彼,かれらの強,つよいのを見,みて、くびすをかえして自分,じぶんの家,いえに帰,かえった。","tok":[["こう"],["して"],["ダン"],["の"],["人々","ひとびと"],["は"],["去て","さって"],["行った","いった"],["が"],["、"],["ミカ"],["は"],["彼","かれ"],["ら"],["の"],["強い","つよい"],["の"],["を"],["見て","みて"],["、"],["くびす"],["を"],["かえして"],["自分","じぶん"],["の"],["家","いえ"],["に"],["帰えった","かえった"],["。"]]},{"verse":27,"text":"さて彼,かれらはミカが造,つくった物,ものと、ミカと共,ともにいた祭司,さいしとを奪,うばってライシにおもむき、穏,おだやかで、安,やすらかな民,たみのところへ行,いって、つるぎをもって彼,かれらを撃,うち、火,ひをつけてその町,まちを焼,やいたが、","tok":[["さて"],["彼","かれ"],["ら"],["は"],["ミカ"],["が"],["造った","つくった"],["物","もの"],["と"],["、"],["ミカ"],["と"],["共","とも"],["に"],["いた"],["祭司","さいし"],["と"],["を"],["奪って","うばって"],["ライシ"],["に"],["おもむき"],["、"],["穏","おだやか"],["で"],["、"],["安らか","やすらか"],["な"],["民","たみ"],["の"],["ところ"],["へ"],["行って","いって"],["、"],["つるぎ"],["を"],["もって"],["彼","かれ"],["ら"],["を"],["撃ち","うち"],["、"],["火","ひ"],["を"],["つけて"],["その"],["町","まち"],["を"],["焼いた","やいた"],["が"],["、"]]},{"verse":28,"text":"シドンを遠,とおく離,はなれており、ほかの民,たみとの交,まじわりがなかったので、それを救,すくうものがなかった。その町,まちはベテレホブに属,ぞくする谷,たににあった。彼,かれらは町,まちを建,たてなおしてそこに住,すみ、","tok":[["シドン"],["を"],["遠く","とおく"],["離れて","はなれて"],["おり"],["、"],["ほか"],["の"],["民","たみ"],["と"],["の"],["交じわり","まじわり"],["が"],["なかった"],["ので"],["、"],["それ"],["を"],["救う","すくう"],["もの"],["が"],["なかった"],["。"],["その"],["町","まち"],["は"],["ベテレホブ"],["に"],["属する","ぞくする"],["谷","たに"],["に"],["あった"],["。"],["彼","かれ"],["ら"],["は"],["町","まち"],["を"],["建てなおして","たてなおして"],["そこ"],["に"],["住み","すみ"],["、"]]},{"verse":29,"text":"イスラエルに生,うまれた先祖,せんぞダンの名,なにしたがって、その町,まちの名,なをダンと名,なづけた。その町,まちの名,なはもとはライシであった。","tok":[["イスラエル"],["に"],["生まれた","うまれた"],["先祖","せんぞ"],["ダン"],["の"],["名","な"],["に"],["したがって"],["、"],["その"],["町","まち"],["の"],["名","な"],["を"],["ダン"],["と"],["名づけた","なづけた"],["。"],["その"],["町","まち"],["の"],["名","な"],["は"],["もと"],["は"],["ライシ"],["で"],["あった"],["。"]]},{"verse":30,"text":"そしてダンの人々,ひとびとは刻,きざんだ像,ぞうを自分,じぶんたちのために安置,あんちし、モーセの孫,まごすなわちゲルショムの子,こヨナタンとその子孫,しそんがダンびとの部族,ぶぞくの祭司,さいしとなって、国,くにが捕囚,ほしゅうとなる日,ひにまで及,およんだ。","tok":[["そして"],["ダン"],["の"],["人々","ひとびと"],["は"],["刻んだ","きざんだ"],["像","ぞう"],["を"],["自分","じぶん"],["たち"],["の"],["ため"],["に"],["安置","あんち"],["し"],["、"],["モーセ"],["の"],["孫","まご"],["すなわち"],["ゲルショム"],["の"],["子","こ"],["ヨナタン"],["と"],["その"],["子孫","しそん"],["が"],["ダン"],["びと"],["の"],["部族","ぶぞく"],["の"],["祭司","さいし"],["と"],["なって"],["、"],["国","くに"],["が"],["捕囚","ほしゅう"],["と"],["なる"],["日","ひ"],["に"],["まで"],["及んだ","およんだ"],["。"]]},{"verse":31,"text":"神,かみの家,いえがシロにあったあいだ、常,つねに彼,かれらはミカが造,つくったその刻,きざんだ像,ぞうを飾,かざって置,おいた。","tok":[["神","かみ"],["の"],["家","いえ"],["が"],["シロ"],["に"],["あった"],["あいだ"],["、"],["常","つね"],["に"],["彼","かれ"],["ら"],["は"],["ミカ"],["が"],["造った","つくった"],["その"],["刻んだ","きざんだ"],["像","ぞう"],["を"],["飾って","かざって"],["置いた","おいた"],["。"]]}]
[{"verse":1,"text":"エホデが死,しんだ後,のち、イスラエルの人々,ひとびとがまた主,しゅの前,まえに悪,あくをおこなったので、","tok":[["エホデ"],["が"],["死んだ","しんだ"],["後","の"],["ち"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["が"],["また"],["主","しゅ"],["の"],["前","まえ"],["に"],["悪","あく"],["を"],["おこなった"],["ので"],["、"]]},{"verse":2,"text":"主,しゅは、ハゾルで世,よを治,おさめていたカナンの王,おうヤビンの手,てに彼,かれらを売,うりわたされた。ヤビンの軍勢,ぐんぜいの長,ちょうはハロセテ・ゴイムに住,すんでいたシセラであった。","tok":[["主","しゅ"],["は"],["、"],["ハゾル"],["で"],["世","よ"],["を"],["治めて","おさめて"],["いた"],["カナン"],["の"],["王","おう"],["ヤビン"],["の"],["手","て"],["に"],["彼","かれ"],["ら"],["を"],["売","うり"],["わたされた"],["。"],["ヤビン"],["の"],["軍勢","ぐんぜい"],["の"],["長","ちょう"],["は"],["ハロセテ"],["・"],["ゴイム"],["に"],["住んで","すんで"],["いた"],["シセラ"],["で"],["あった"],["。"]]},{"verse":3,"text":"彼,かれは鉄,てつの戦車,せんしゃ九百両,りょうをもち、二十年,ねんの間,あいだイスラエルの人々,ひとびとを激,はげしくしえたげたので、イスラエルの人々,ひとびとは主,しゅに向,むかって呼,よばわった。","tok":[["彼","かれ"],["は"],["鉄","てつ"],["の"],["戦車","せんしゃ"],["九百","きゅうひゃく"],["両","りょう"],["を"],["もち"],["、"],["二十","にじゅう"],["年","ねん"],["の"],["間","あいだ"],["イスラエル"],["の"],["人々","ひとびと"],["を"],["激しく","はげしく"],["し"],["えたげた"],["ので"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["主に","しゅに"],["向かって","むかって"],["呼ばわった","よばわった"],["。"]]},{"verse":4,"text":"そのころラピドテの妻,つま、女,おんな預言者,よげんしゃデボラがイスラエルをさばいていた。","tok":[["その"],["ころ"],["ラピドテ"],["の"],["妻","つま"],["、"],["女","おんな"],["預言者","よげんしゃ"],["デボラ"],["が"],["イスラエル"],["を"],["さばいて"],["いた"],["。"]]},{"verse":5,"text":"彼女,かのじょはエフライムの山地,さんちのラマとベテルの間,あいだにあるデボラのしゅろの木,きの下,したに座,ざし、イスラエルの人々,ひとびとは彼女,かのじょのもとに上,のぼってきて、さばきをうけた。","tok":[["彼女","かのじょ"],["は"],["エフライム"],["の"],["山地","さんち"],["の"],["ラマ"],["と"],["ベテル"],["の"],["間","あいだ"],["に"],["ある"],["デボラ"],["の"],["しゅろ"],["の"],["木","き"],["の"],["下","した"],["に"],["座し","ざし"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["彼女","かのじょ"],["の"],["もと"],["に"],["上って","のぼって"],["きて"],["、"],["さばき"],["を"],["うけた"],["。"]]},{"verse":6,"text":"デボラは人,ひとをつかわして、ナフタリのケデシからアビノアムの子,こバラクを招,まねいて言,いった、「イスラエルの神,かみ、主,しゅはあなたに、こう命,めいじられるではありませんか、『ナフタリの部族,ぶぞくとゼブルンの部族,ぶぞくから一万人,にんを率,ひきい、行,いって、タボル山,やまに陣,じんをしけ。","tok":[["デボラ"],["は"],["人","ひと"],["を"],["つかわして"],["、"],["ナフタリ"],["の"],["ケデシ"],["から"],["アビノアム"],["の"],["子","こ"],["バラク"],["を"],["招いて","まねいて"],["言った","いった"],["、"],["「"],["イスラエル"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["あなた"],["に"],["、"],["こう"],["命じられるで","めいじられるで"],["は"],["ありません"],["か"],["、"],["『"],["ナフタリ"],["の"],["部族","ぶぞく"],["と"],["ゼブルン"],["の"],["部族","ぶぞく"],["から"],["一万人","にん"],["を"],["率い","ひきい"],["、"],["行って","いって"],["、"],["タボル山","たぼるやま"],["に"],["陣","じん"],["を"],["しけ"],["。"]]},{"verse":7,"text":"わたしはヤビンの軍勢,ぐんぜいの長,ちょうシセラとその戦車,せんしゃと軍隊,ぐんたいとをキション川,かわに引,ひき寄,よせて、あなたに出,であわせ、彼,かれをあなたの手,てにわたすであろう』」。","tok":[["わたし"],["は"],["ヤビン"],["の"],["軍勢","ぐんぜい"],["の"],["長う","ちょう"],["シセラ"],["と"],["その"],["戦車","せんしゃ"],["と"],["軍隊","ぐんたい"],["と"],["を"],["キション"],["川","かわ"],["に"],["引寄せて","ひきよせて"],["、"],["あなた"],["に"],["出あわせ","であわせ"],["、"],["彼","かれ"],["を"],["あなた"],["の"],["手","て"],["に"],["わたすで"],["あろう"],["』"],["」"],["。"]]},{"verse":8,"text":"バラクは彼女,かのじょに言,いった、「あなたがもし一緒,いっしょに行,いってくだされば、わたしは行,いきます。しかし、一緒,いっしょに行,いってくださらないならば、行,いきません」。","tok":[["バラク"],["は"],["彼女","かのじょ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["が"],["もし"],["一緒","いっしょ"],["に"],["行って","いって"],["くだされば"],["、"],["わたし"],["は"],["行きます","いきます"],["。"],["しかし"],["、"],["一緒","いっしょ"],["に"],["行って","いって"],["くださらないならば"],["、"],["行きません","いきません"],["」"],["。"]]},{"verse":9,"text":"デボラは言,いった、「必,かならずあなたと一緒,いっしょに行,いきます。しかしあなたは今,いま行,いく道,みちでは誉,ほまれを得,えないでしょう。主,しゅはシセラを女,おんなの手,てにわたされるからです」。デボラは立,たってバラクと一緒,いっしょにケデシに行,いった。","tok":[["デボラ"],["は"],["言った","いった"],["、"],["「"],["必","かならず"],["あなた"],["と"],["一緒","いっしょ"],["に"],["行きます","いきます"],["。"],["しかし"],["あなた"],["は"],["今","いま"],["行く","いく"],["道","みち"],["で"],["は"],["誉","ほまれ"],["を"],["得ないでしょう","えないでしょう"],["。"],["主","しゅ"],["は"],["シセラ"],["を"],["女","おんな"],["の"],["手","て"],["に"],["わたされる"],["から"],["です"],["」"],["。"],["デボラ"],["は"],["立って","たって"],["バラク"],["と"],["一緒","いっしょ"],["に"],["ケデシ"],["に"],["行った","いった"],["。"]]},{"verse":10,"text":"バラクはゼブルンとナフタリをケデシに呼,よび集,あつめ、一万人,にんを従,したがえて上,のぼった。デボラも彼,かれと共,ともに上,のぼった。","tok":[["バラク"],["は"],["ゼブルン"],["と"],["ナフタリ"],["を"],["ケデシ"],["に"],["呼び集め","よびあつめ"],["、"],["一万人","にん"],["を"],["従えて","したがえて"],["上った","のぼった"],["。"],["デボラ"],["も"],["彼","かれ"],["と"],["共","とも"],["に"],["上った","のぼった"],["。"]]},{"verse":11,"text":"時,ときにケニびとヘベルはモーセのしゅうとホバブの子孫,しそんであるケニびとから分,わかれて、ケデシに近,ちかいザアナイムのかしの木,きまでも遠,とおく行,いって天幕,てんまくを張,はっていた。","tok":[["時","とき"],["に"],["ケニ"],["びと"],["ヘベル"],["は"],["モーセ"],["の"],["しゅうと"],["ホバブ"],["の"],["子孫","しそん"],["で"],["ある"],["ケニ"],["びと"],["から"],["分かれて","わかれて"],["、"],["ケデシ"],["に"],["近い","ちかい"],["ザアナイム"],["の"],["かし"],["の"],["木","き"],["まで"],["も"],["遠く","とおく"],["行って","いって"],["天幕","てんまく"],["を"],["張って","はって"],["いた"],["。"]]},{"verse":12,"text":"アビノアムの子,こバラクがタボル山,やまに上,のぼったと、人々,ひとびとがシセラに告,つげたので、","tok":[["アビノアム"],["の"],["子","こ"],["バラク"],["が"],["タボル山","たぼるやま"],["に"],["上った","のぼった"],["と"],["、"],["人々","ひとびと"],["が"],["シセラ"],["に"],["告","つげ"],["た"],["ので"],["、"]]},{"verse":13,"text":"シセラは自分,じぶんの戦車,せんしゃの全部,ぜんぶすなわち鉄,てつの戦車,せんしゃ九百両,りょうと、自分,じぶんと共,ともにおるすべての民,たみをハロセテ・ゴイムからキション川,かわに呼,よび集,あつめた。","tok":[["シセラ"],["は"],["自分","じぶん"],["の"],["戦車","せんしゃ"],["の"],["全部","ぜんぶ"],["すなわち"],["鉄","てつ"],["の"],["戦車","せんしゃ"],["九百","きゅうひゃく"],["両","りょう"],["と"],["、"],["自分","じぶん"],["と"],["共","とも"],["に"],["おる"],["すべて"],["の"],["民","たみ"],["を"],["ハロセテ"],["・"],["ゴイム"],["から"],["キション"],["川","かわ"],["に"],["呼び集めた","よびあつめた"],["。"]]},{"verse":14,"text":"デボラはバラクに言,いった、「さあ、立,たちあがりなさい。きょうは主,しゅがシセラをあなたの手,てにわたされる日,ひです。主,しゅはあなたに先立,さきだって出,でられるではありませんか」。そこでバラクは一万人,にんを従,したがえてタボル山,やまから下,くだった。","tok":[["デボラ"],["は"],["バラク"],["に"],["言った","いった"],["、"],["「"],["さあ"],["、"],["立ちあがり","たちあがり"],["なさい"],["。"],["きょう"],["は"],["主","しゅ"],["が"],["シセラ"],["を"],["あなた"],["の"],["手","て"],["に"],["わたされる"],["日","ひ"],["です"],["。"],["主","しゅ"],["は"],["あなた"],["に"],["先立って","さきだって"],["出られるで","でられるで"],["は"],["ありません"],["か"],["」"],["。"],["そこ"],["で"],["バラク"],["は"],["一万人","にん"],["を"],["従えて","したがえて"],["タボル"],["山","やま"],["から"],["下った","くだった"],["。"]]},{"verse":15,"text":"主,しゅはつるぎをもってシセラとすべての戦車,せんしゃおよび軍勢,ぐんぜいをことごとくバラクの前,まえに撃,うち敗,やぶられたので、シセラは戦車,せんしゃから飛,とびおり、徒歩,とほで逃,にげ去,さった。","tok":[["主","しゅ"],["は"],["つるぎ"],["を"],["もって"],["シセラ"],["と"],["すべて"],["の"],["戦車","せんしゃ"],["および"],["軍勢","ぐんぜい"],["を"],["ことごとく"],["バラク"],["の"],["前","まえ"],["に"],["撃ち","うち"],["敗られた","やぶられた"],["ので"],["、"],["シセラ"],["は"],["戦車","せんしゃ"],["から"],["飛びおり","とびおり"],["、"],["徒歩","とほ"],["で"],["逃去","にげさっ"],["た"],["。"]]},{"verse":16,"text":"バラクは戦車,せんしゃと軍勢,ぐんぜいとを追撃,ついげきしてハロセテ・ゴイムまで行,いった。シセラの軍勢,ぐんぜいはことごとくつるぎにたおれて、残,のこったものはひとりもなかった。","tok":[["バラク"],["は"],["戦車","せんしゃ"],["と"],["軍勢","ぐんぜい"],["と"],["を"],["追撃","ついげき"],["して"],["ハロセテ"],["・"],["ゴイム"],["まで"],["行った","いった"],["。"],["シセラ"],["の"],["軍勢","ぐんぜい"],["は"],["ことごとく"],["つるぎ"],["に"],["たおれて"],["、"],["残った","のこった"],["もの"],["は"],["ひとり"],["も"],["なかった"],["。"]]},{"verse":17,"text":"しかしシセラは徒歩,とほで逃,にげ去,さって、ケニびとヘベルの妻,つまヤエルの天幕,てんまくに行,いった。ハゾルの王,おうヤビンとケニびとヘベルの家,いえとは互,たがいにむつまじかったからである。","tok":[["しかし"],["シセラ"],["は"],["徒歩","とほ"],["で"],["逃去","にげさっ"],["て"],["、"],["ケニ"],["びと"],["ヘベル"],["の"],["妻","つま"],["ヤエル"],["の"],["天幕","てんまく"],["に"],["行った","いった"],["。"],["ハゾル"],["の"],["王","おう"],["ヤビン"],["と"],["ケニ"],["びと"],["ヘベル"],["の"],["家","いえ"],["と"],["は"],["互","たがい"],["に"],["むつまじかった"],["から"],["で"],["ある"],["。"]]},{"verse":18,"text":"ヤエルは出,でてきてシセラを迎,むかえ、彼,かれに言,いった、「おはいりください。主,しゅよ、どうぞうちへおはいりください。恐,おそれるにはおよびません」。シセラが天幕,てんまくにはいったので、ヤエルは毛布,もうふをもって彼,かれをおおった。","tok":[["ヤエル"],["は"],["出て","でて"],["きて"],["シセラ"],["を"],["迎","むかえ"],["、"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["おはいり"],["ください"],["。"],["主","しゅ"],["よ"],["、"],["どうぞ"],["うち"],["へ"],["おはいり"],["ください"],["。"],["恐れる","おそれる"],["に"],["は"],["およびません"],["」"],["。"],["シセラ"],["が"],["天幕","てんまく"],["に"],["はいった"],["ので"],["、"],["ヤエル"],["は"],["毛布","もうふ"],["を"],["もって"],["彼","かれ"],["を"],["おおった"],["。"]]},{"verse":19,"text":"シセラはヤエルに言,いった、「どうぞ、わたしに水,みずを少,すこし飲,のませてください。のどがかわきましたから」。ヤエルは乳,ちちの皮,かわ袋,ぶくろを開,ひらいて彼,かれに飲,のませ、また彼,かれをおおった。","tok":[["シセラ"],["は"],["ヤエル"],["に"],["言った","いった"],["、"],["「"],["どうぞ"],["、"],["わたし"],["に"],["水","みず"],["を"],["少し","すこし"],["飲ませて","のませて"],["ください"],["。"],["のど"],["が"],["かわきました"],["から"],["」"],["。"],["ヤエル"],["は"],["乳","ちち"],["の"],["皮袋","かわぶくろ"],["を"],["開らいて","ひらいて"],["彼","かれ"],["に"],["飲ませ","のませ"],["、"],["また"],["彼","かれ"],["を"],["おおった"],["。"]]},{"verse":20,"text":"シセラはまたヤエルに言,いった、「天幕,てんまくの入口,いりぐちに立,たっていてください。もし人,ひとがきて、あなたに『だれか、ここにおりますか』と問,とうならば『おりません』と答,こたえてください」。","tok":[["シセラ"],["は"],["また"],["ヤエル"],["に"],["言った","いった"],["、"],["「"],["天幕","てんまく"],["の"],["入口","いりぐち"],["に"],["立って","たって"],["いて"],["ください"],["。"],["もし"],["人","ひと"],["が"],["きて"],["、"],["あなた"],["に"],["『"],["だれ"],["か"],["、"],["ここ"],["に"],["おります"],["か"],["』"],["と"],["問うならば","とうならば"],["『"],["おりません"],["』"],["と"],["答","こたえ"],["て"],["ください"],["」"],["。"]]},{"verse":21,"text":"しかし彼,かれが疲,つかれて熟睡,じゅくすいしたとき、ヘベルの妻,つまヤエルは天幕,てんまくのくぎを取,とり、手,てに槌,つちを携,たずさえて彼,かれに忍,しのび寄,より、こめかみにくぎを打,うち込,こんで地,ちに刺,さし通,とおしたので、彼,かれは息,いき絶,たえて死,しんだ。","tok":[["しかし"],["彼","かれ"],["が"],["疲れて","つかれて"],["熟睡","じゅくすい"],["した"],["とき"],["、"],["ヘベル"],["の"],["妻","つま"],["ヤエル"],["は"],["天幕","てんまく"],["の"],["くぎ"],["を"],["取","とり"],["、"],["手","て"],["に"],["槌","つち"],["を"],["携えて","たずさえて"],["彼","かれ"],["に"],["忍び寄り","しのびより"],["、"],["こめかみ"],["に"],["くぎ"],["を"],["打ち込んで","うちこんで"],["地","ち"],["に"],["刺通した","さしとおした"],["ので"],["、"],["彼","かれ"],["は"],["息","いき"],["絶えて","たえて"],["死んだ","しんだ"],["。"]]},{"verse":22,"text":"バラクがシセラを追,おってきたとき、ヤエルは彼,かれを出迎,でむかえて言,いった、「おいでなさい。あなたが求,もとめている人,ひとをお見,みせしましょう」。彼,かれがヤエルの天幕,てんまくにはいって見,みると、シセラはこめかみにくぎを打,うたれて倒,たおれて死,しんでいた。","tok":[["バラク"],["が"],["シセラ"],["を"],["追って","おって"],["きた"],["とき"],["、"],["ヤエル"],["は"],["彼","かれ"],["を"],["出迎","でむかえ"],["て"],["言った","いった"],["、"],["「"],["おいで"],["なさい"],["。"],["あなた"],["が"],["求めて","もとめて"],["いる"],["人","ひと"],["を"],["お見せ","おみせ"],["しましょう"],["」"],["。"],["彼","かれ"],["が"],["ヤエル"],["の"],["天幕","てんまく"],["に"],["はいって"],["見る","みる"],["と"],["、"],["シセラ"],["は"],["こめかみ"],["に"],["くぎ"],["を"],["打たれて","うたれて"],["倒れて","たおれて"],["死んで","しんで"],["いた"],["。"]]},{"verse":23,"text":"こうしてその日,ひ、神,かみはカナンの王,おうヤビンをイスラエルの人々,ひとびとの前,まえに撃,うち敗,やぶられた。","tok":[["こう"],["して"],["その"],["日","ひ"],["、"],["神","かみ"],["は"],["カナン"],["の"],["王","おう"],["ヤビン"],["を"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["前","まえ"],["に"],["撃ち","うち"],["敗られた","やぶられた"],["。"]]},{"verse":24,"text":"そしてイスラエルの人々,ひとびとの手,てはますますカナンびとの王,おうヤビンの上,うえに重,おもくなって、ついにカナンの王,おうヤビンを滅,ほろぼすに至,いたった。","tok":[["そして"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["手","て"],["は"],["ますます"],["カナン"],["びと"],["の"],["王","おう"],["ヤビン"],["の"],["上","うえ"],["に"],["重く","おもく"],["なって"],["、"],["ついに"],["カナン"],["の"],["王","おう"],["ヤビン"],["を"],["滅ぼす","ほろぼす"],["に"],["至った","いたった"],["。"]]}]
[{"verse":1,"text":"しかし、あなたは、健全,けんぜんな教,おしえにかなうことを語,かたりなさい。","tok":[["しかし"],["、"],["あなた"],["は"],["、"],["健全","けんぜん"],["な"],["教え","おしえ"],["に"],["かなう"],["こと"],["を"],["語り","かたり"],["なさい"],["。"]]},{"verse":2,"text":"老人,ろうじんたちには自,みずからを制,せいし、謹厳,きんげんで、慎,つつしみ深,ふかくし、また、信仰,しんこうと愛,あいと忍耐,にんたいとにおいて健全,けんぜんであるように勧,すすめ、","tok":[["老人","ろうじん"],["たち"],["に"],["は"],["自から","みずから"],["を"],["制し","せいし"],["、"],["謹厳","きんげん"],["で"],["、"],["慎しみ深く","つつしみふかく"],["し"],["、"],["また"],["、"],["信仰","しんこう"],["と"],["愛","あい"],["と"],["忍耐","にんたい"],["と"],["に"],["おいて"],["健全","けんぜん"],["で"],["ある"],["よう"],["に"],["勧め","すすめ"],["、"]]},{"verse":3,"text":"年老,としおいた女,おんなたちにも、同,おなじように、たち居,いふるまいをうやうやしくし、人,ひとをそしったり大酒,たいしゅの奴隷,どれいになったりせず、良,よいことを教,おしえる者,ものとなるように、勧,すすめなさい。","tok":[["年老いた","としおいた"],["女","おんな"],["たち"],["に"],["も"],["、"],["同じ","おなじ"],["よう"],["に"],["、"],["たち"],["居","い"],["ふるまい"],["を"],["うやうやしく"],["し"],["、"],["人","ひと"],["を"],["そしっ"],["たり"],["大酒","たいしゅ"],["の"],["奴隷","どれい"],["に"],["なっ"],["たり"],["せず"],["、"],["良い","よい"],["こと"],["を"],["教える","おしえる"],["者","もの"],["と"],["なる"],["よう"],["に"],["、"],["勧め","すすめ"],["なさい"],["。"]]},{"verse":4,"text":"そうすれば、彼女,かのじょたちは、若,わかい女,おんなたちに、夫,おっとを愛,あいし、子供,こどもを愛,あいし、","tok":[["そう"],["すれば"],["、"],["彼女","かのじょ"],["たち"],["は"],["、"],["若い","わかい"],["女","おんな"],["たち"],["に"],["、"],["夫","おっと"],["を"],["愛し","あいし"],["、"],["子供","こども"],["を"],["愛し","あいし"],["、"]]},{"verse":5,"text":"慎,つつしみ深,ふかく、純潔,じゅんけつで、家事,かじに努,つとめ、善良,ぜんりょうで、自分,じぶんの夫,おっとに従順,じゅうじゅんであるように教,おしえることになり、したがって、神,かみの言,ことばがそしりを受,うけないようになるであろう。","tok":[["慎しみ深く","つつしみふかく"],["、"],["純潔","じゅんけつ"],["で"],["、"],["家事","かじ"],["に"],["努め","つとめ"],["、"],["善良","ぜんりょう"],["で"],["、"],["自分","じぶん"],["の"],["夫","おっと"],["に"],["従順","じゅうじゅん"],["で"],["ある"],["よう"],["に"],["教える","おしえる"],["こと"],["に"],["なり"],["、"],["したがって"],["、"],["神","かみ"],["の"],["言","ことば"],["が"],["そ"],["しり"],["を"],["受ない","うけない"],["よう"],["に"],["なるで"],["あろう"],["。"]]},{"verse":6,"text":"若,わかい男,おとこにも、同,おなじく、万事,ばんじにつけ慎,つつしみ深,ぶかくあるように、勧,すすめなさい。","tok":[["若い","わかい"],["男","おとこ"],["に"],["も"],["、"],["同じく","おなじく"],["、"],["万事","ばんじ"],["に"],["つけ"],["慎しみ深く","つつしみぶかく"],["ある"],["よう"],["に"],["、"],["勧め","すすめ"],["なさい"],["。"]]},{"verse":7,"text":"あなた自身,じしんを良,よいわざの模範,もはんとして示,しめし、人,ひとを教,おしえる場合,ばあいには、清廉,せいれんと謹厳,きんげんとをもってし、","tok":[["あなた"],["自身","じしん"],["を"],["良い","よい"],["わざ"],["の"],["模範","もはん"],["として"],["示めし","しめし"],["、"],["人","ひと"],["を"],["教える","おしえる"],["場合","ばあい"],["に"],["は"],["、"],["清廉","せいれん"],["と"],["謹厳","きんげん"],["と"],["を"],["もって"],["し"],["、"]]},{"verse":8,"text":"非難,ひなんのない健全,けんぜんな言葉,ことばを用,もちいなさい。そうすれば、反対者,はんたいしゃも、わたしたちについてなんの悪口,あっこうも言,いえなくなり、自,みずから恥,はじいるであろう。","tok":[["非難","ひなん"],["の"],["ない"],["健全","けんぜん"],["な"],["言葉","ことば"],["を"],["用い","もちい"],["なさい"],["。"],["そう"],["すれば"],["、"],["反対者","はんたいしゃ"],["も"],["、"],["わたしたち"],["について"],["なん"],["の"],["悪口","あっこう"],["も"],["言えなく","いえなく"],["なり"],["、"],["自から","みずから"],["恥","はじ"],["いるで"],["あろう"],["。"]]},{"verse":9,"text":"奴隷,どれいには、万事,ばんじにつけその主人,しゅじんに服従,ふくじゅうして、喜,よろこばれるようになり、反抗,はんこうをせず、","tok":[["奴隷","どれい"],["に"],["は"],["、"],["万事","ばんじ"],["に"],["つけ"],["その"],["主人","しゅじん"],["に"],["服従","ふくじゅう"],["して"],["、"],["喜こばれる","よろこばれる"],["よう"],["に"],["なり"],["、"],["反抗","はんこう"],["を"],["せず"],["、"]]},{"verse":10,"text":"盗,ぬすみをせず、どこまでも心,こころをこめた真実,しんじつを示,しめすようにと、勧,すすめなさい。そうすれば、彼,かれらは万事,ばんじにつけ、わたしたちの救主,すくいぬしなる神,かみの教,おしえを飾,かざることになろう。","tok":[["盗み","ぬすみ"],["を"],["せず"],["、"],["どこ"],["まで"],["も"],["心","こころ"],["を"],["こめた"],["真実","しんじつ"],["を"],["示めす","しめす"],["よう"],["に"],["と"],["、"],["勧め","すすめ"],["なさい"],["。"],["そう"],["すれば"],["、"],["彼","かれ"],["ら"],["は"],["万事","ばんじ"],["に"],["つけ"],["、"],["わたしたち"],["の"],["救主","す"],["くい"],["ぬし"],["なる"],["神","かみ"],["の"],["教え","おしえ"],["を"],["飾る","かざる"],["こと"],["に"],["なろう"],["。"]]},{"verse":11,"text":"すべての人,ひとを救,すくう神,かみの恵,めぐみが現,あらわれた。","tok":[["すべて"],["の"],["人","ひと"],["を"],["救う","すくう"],["神","かみ"],["の"],["恵","めぐみ"],["が"],["現われた","あらわれた"],["。"]]},{"verse":12,"text":"そして、わたしたちを導,みちびき、不信心,ふしんじんとこの世,よの情欲,じょうよくとを捨,すてて、慎,つつしみ深,ぶかく、正,ただしく、信心,しんじん深,ぶかくこの世,よで生活,せいかつし、","tok":[["そして"],["、"],["わたしたち"],["を"],["導き","みちびき"],["、"],["不信心","ふしんじん"],["と"],["この世","このよ"],["の"],["情欲","じょうよく"],["と"],["を"],["捨てて","すてて"],["、"],["慎しみ深く","つつしみぶかく"],["、"],["正く","ただしく"],["、"],["信心","しんじん"],["深","ぶかくこ"],["の"],["世","よ"],["で"],["生活","せいかつ"],["し"],["、"]]},{"verse":13,"text":"祝福,しゅくふくに満,みちた望,のぞみ、すなわち、大,おおいなる神,かみ、わたしたちの救主,すくいぬしキリスト・イエスの栄光,えいこうの出現,しゅつげんを待,まち望,のぞむようにと、教,おしえている。","tok":[["祝福","しゅくふく"],["に"],["満ちた","みちた"],["望み","のぞみ"],["、"],["すなわち"],["、"],["大いなる","おおいなる"],["神","かみ"],["、"],["わたしたち"],["の"],["救主","す"],["くい"],["ぬし"],["キリスト"],["・"],["イエス"],["の"],["栄光","えいこう"],["の"],["出現","しゅつげん"],["を"],["待ち望む","まちのぞむ"],["よう"],["に"],["と"],["、"],["教て","おしえて"],["いる"],["。"]]},{"verse":14,"text":"このキリストが、わたしたちのためにご自身,じしんをささげられたのは、わたしたちをすべての不法,ふほうからあがない出,だして、良,よいわざに熱心,ねっしんな選,えらびの民,たみを、ご自身,じしんのものとして聖,せい別,べつするためにほかならない。","tok":[["この"],["キリスト"],["が"],["、"],["わたしたち"],["の"],["ため"],["に"],["ご自身","ごじしん"],["を"],["ささげられた"],["の"],["は"],["、"],["わたしたち"],["を"],["すべて"],["の"],["不法","ふほう"],["から"],["あがない"],["出して","だして"],["、"],["良い","よい"],["わざ"],["に"],["熱心","ねっしん"],["な"],["選ら","えら"],["び"],["の"],["民","たみ"],["を"],["、"],["ご自身","ごじしん"],["の"],["もの"],["として"],["聖い","せい"],["別","べつ"],["する"],["ため"],["に"],["ほか"],["ならない"],["。"]]},{"verse":15,"text":"あなたは、権威,けんいをもってこれらのことを語,かたり、勧,すすめ、また責,せめなさい。だれにも軽,かろんじられてはならない。","tok":[["あなた"],["は"],["、"],["権威","けんい"],["を"],["もって"],["これ"],["ら"],["の"],["こと"],["を"],["語り","かたり"],["、"],["勧め","すすめ"],["、"],["また"],["責","せめ"],["なさい"],["。"],["だれ"],["に"],["も"],["軽んじられて","かろんじられて"],["は"],["ならない"],["。"]]}]
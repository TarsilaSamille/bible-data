[{"verse":1,"text":"さて、ヨルダンの西側,にしがわの、山地,さんち、平地,へいち、およびレバノンまでの大海,たいかいの沿岸,えんがんに住,すむもろもろの王,おうたち、すなわちヘテびと、アモリびと、カナンびと、ペリジびと、ヒビびと、エブスびとの王,おうたちは、これを聞,きいて、","tok":[["さて"],["、"],["ヨルダン"],["の"],["西側","にしがわ"],["の"],["、"],["山地","さんち"],["、"],["平地","へいち"],["、"],["および"],["レバノン"],["まで"],["の"],["大海","たいかい"],["の"],["沿岸","えんがん"],["に"],["住む","すむ"],["もろもろ"],["の"],["王","おう"],["たち"],["、"],["すなわち"],["ヘテ"],["び"],["と"],["、"],["アモリ"],["び"],["と"],["、"],["カナン"],["び"],["と"],["、"],["ペリジ"],["び"],["と"],["、"],["ヒビ"],["び"],["と"],["、"],["エブス"],["びと"],["の"],["王","おう"],["たち"],["は"],["、"],["これ"],["を"],["聞いて","きいて"],["、"]]},{"verse":2,"text":"心,こころを合,あわせ、相,あい集,あつまって、ヨシュアおよびイスラエルと戦,たたかおうとした。","tok":[["心","こころ"],["を"],["合","あわせ"],["、"],["相","あ"],["い集","いあつ"],["まって"],["、"],["ヨシュア"],["および"],["イスラエル"],["と"],["戦おう","たたかおう"],["と"],["した"],["。"]]},{"verse":3,"text":"しかし、ギベオンの住民,じゅうみんたちは、ヨシュアがエリコとアイにおこなったことを聞,きいて、","tok":[["しかし"],["、"],["ギベオン"],["の"],["住民","じゅうみん"],["たち"],["は"],["、"],["ヨシュア"],["が"],["エリコ"],["と"],["アイ"],["に"],["おこなった"],["こと"],["を"],["聞いて","きいて"],["、"]]},{"verse":4,"text":"自分,じぶんたちも策略,さくりゃくをめぐらし、行,いって食料,しょくりょう品,ひんを準備,じゅんびし、古,ふるびた袋,ふくろと、古,ふるびて破,やぶれたのを繕,つくろったぶどう酒,しゅの皮,かわ袋,ぶくろとを、ろばに負,おわせ、","tok":[["自分","じぶん"],["たち"],["も"],["策略","さくりゃく"],["を"],["めぐらし"],["、"],["行って","いって"],["食料品","しょくりょうひん"],["を"],["準備","じゅんび"],["し"],["、"],["古びた","ふるびた"],["袋","ふくろ"],["と"],["、"],["古びて","ふるびて"],["破れた","やぶれた"],["の"],["を"],["繕った","つくろった"],["ぶどう酒","ぶどうしゅ"],["の"],["皮袋","かわぶくろ"],["と"],["を"],["、"],["ろば"],["に"],["負わせ","おわせ"],["、"]]},{"verse":5,"text":"繕,つくろった古,ふるぐつを足,あしにはき、古,ふるびた着物,きものを身,みにつけた。彼,かれらの食料,しょくりょうのパンは、みなかわいて、砕,くだけていた。","tok":[["繕った","つくろった"],["古","ふる"],["ぐつ"],["を"],["足","あし"],["に"],["はき"],["、"],["古びた","ふるびた"],["着物","きもの"],["を"],["身","み"],["に"],["つけた"],["。"],["彼","かれ"],["ら"],["の"],["食料","しょくりょう"],["の"],["パン"],["は"],["、"],["みな"],["かわいて"],["、"],["砕けて","くだけて"],["いた"],["。"]]},{"verse":6,"text":"彼,かれらはギルガルの陣営,じんえいのヨシュアの所,ところにきて、彼,かれとイスラエルの人々,ひとびとに言,いった、「われわれは遠,とおい国,くにからまいりました。それで今,いまわれわれと契約,けいやくを結,むすんでください」。","tok":[["彼","かれ"],["ら"],["は"],["ギルガル"],["の"],["陣営","じんえい"],["の"],["ヨシュア"],["の"],["所","ところ"],["に"],["きて"],["、"],["彼","かれ"],["と"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["言った","いった"],["、"],["「"],["われわれ"],["は"],["遠い","とおい"],["国","くに"],["から"],["まいりました"],["。"],["それ"],["で"],["今","いま"],["われわれ"],["と"],["契約","けいやく"],["を"],["結んで","むすんで"],["ください"],["」"],["。"]]},{"verse":7,"text":"しかし、イスラエルの人々,ひとびとはそのヒビびとたちに言,いった、「あなたがたはわれわれのうちに住,すんでいるのかも知,しれないから、われわれはどうしてあなたがたと契約,けいやくが結,むすべましょう」。","tok":[["しかし"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["その"],["ヒビ"],["びと"],["たち"],["に"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["われわれ"],["の"],["うち"],["に"],["住","すんでいる"],["の"],["か"],["も"],["知れない","しれない"],["から"],["、"],["われわれ"],["は"],["どう"],["して"],["あなた"],["がた"],["と"],["契約","けいやく"],["が"],["結べましょう","むすべましょう"],["」"],["。"]]},{"verse":8,"text":"彼,かれらはヨシュアに言,いった、「われわれはあなたのしもべです」。ヨシュアは彼,かれらに言,いった、「あなたがたはだれですか。どこからきたのですか」。","tok":[["彼","かれ"],["ら"],["は"],["ヨシュア"],["に"],["言った","いった"],["、"],["「"],["われわれ"],["は"],["あなた"],["の"],["しもべ"],["です"],["」"],["。"],["ヨシュア"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["だれ"],["です"],["か"],["。"],["どこ"],["から"],["きた"],["の"],["です"],["か"],["」"],["。"]]},{"verse":9,"text":"彼,かれらはヨシュアに言,いった、「しもべどもはあなたの神,かみ、主,しゅの名,なのゆえに、ひじょうに遠,とおい国,くにからまいりました。われわれは主,しゅの名声,めいせい、および主,しゅがエジプトで行,おこなわれたすべての事,ことを聞,きき、","tok":[["彼","かれ"],["ら"],["は"],["ヨシュア"],["に"],["言った","いった"],["、"],["「"],["しもべ"],["ども"],["は"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["名","な"],["の"],["ゆえ"],["に"],["、"],["ひじょう"],["に"],["遠い","とおい"],["国","くに"],["から"],["まいりました"],["。"],["われわれ"],["は"],["主","しゅ"],["の"],["名声","めいせい"],["、"],["および"],["主","しゅ"],["が"],["エジプト"],["で"],["行なわれた","おこなわれた"],["すべて"],["の"],["事","こと"],["を"],["聞","きき"],["、"]]},{"verse":10,"text":"また主,しゅがヨルダンの向,むこう側,がわにいたアモリびとのふたりの王,おう、すなわちヘシボンの王,おうシホン、およびアシタロテにおったバシャンの王,おうオグに行,おこなわれたすべてのことを聞,きいたからです。","tok":[["また"],["主","しゅ"],["が"],["ヨルダン"],["の"],["向こう側","むこうがわ"],["に"],["いた"],["アモリ"],["びと"],["の"],["ふたり"],["の"],["王","おう"],["、"],["すなわち"],["ヘシボン"],["の"],["王","おう"],["シホン"],["、"],["および"],["アシタロテ"],["に"],["おった"],["バシャン"],["の"],["王","おう"],["オグ"],["に"],["行なわれた","おこなわれた"],["すべて"],["の"],["こと"],["を"],["聞いた","きいた"],["から"],["です"],["。"]]},{"verse":11,"text":"それで、われわれの長老,ちょうろうたち、および国,くにの住民,じゅうみんはみなわれわれに言,いいました、『おまえたちは旅路,たびじの食料,しょくりょうを手,てに携,たずさえていって、彼,かれらに会,あって言,いいなさい、「われわれはあなたがたのしもべです。それで今,いまわれわれと契約,けいやくを結,むすんでください」』。","tok":[["それ"],["で"],["、"],["われわれ"],["の"],["長老","ちょうろう"],["たち"],["、"],["および"],["国","くに"],["の"],["住民","じゅうみん"],["は"],["みな"],["われわれ"],["に"],["言いました","いいました"],["、"],["『"],["おまえ"],["たち"],["は"],["旅路","たびじ"],["の"],["食料","しょくりょう"],["を"],["手","て"],["に"],["携えて","たずさえて"],["いって"],["、"],["彼","かれ"],["ら"],["に"],["会って","あって"],["言い","いい"],["なさい"],["、"],["「"],["われわれ"],["は"],["あなた"],["がた"],["の"],["しもべ"],["です"],["。"],["それ"],["で"],["今","いま"],["われわれ"],["と"],["契約","けいやく"],["を"],["結んで","むすんで"],["ください"],["」"],["』"],["。"]]},{"verse":12,"text":"ここにあるこのパンは、あなたがたの所,ところに来,くるため、われわれが出立,しゅったつする日,ひに、おのおの家,いえから、まだあたたかなのを旅,たびの食料,しょくりょうとして準備,じゅんびしたのですが、今,いまはもうかわいて砕,くだけています。","tok":[["ここ"],["に"],["ある"],["この"],["パン"],["は"],["、"],["あなた"],["がた"],["の"],["所","ところ"],["に"],["来る","くる"],["ため"],["、"],["われわれ"],["が"],["出立","しゅったつ"],["する"],["日","ひ"],["に"],["、"],["おのおの"],["家","いえ"],["から"],["、"],["まだ"],["あたたか"],["な"],["の"],["を"],["旅","たび"],["の"],["食料","しょくりょう"],["として"],["準備","じゅんび"],["した"],["の"],["です"],["が"],["、"],["今","いま"],["は"],["もう"],["かわいて"],["砕けて","くだけて"],["います"],["。"]]},{"verse":13,"text":"またぶどう酒,しゅを満,みたしたこれらの皮,かわ袋,ぶくろも、新,あたらしかったのですが、破,やぶれました。われわれのこの着物,きものも、くつも、旅路,たびじがひじょうに長,ながかったので、古,ふるびてしまいました」。","tok":[["また"],["ぶどう酒","ぶどうしゅ"],["を"],["満たした","みたした"],["これ"],["ら"],["の"],["皮袋","かわぶくろ"],["も"],["、"],["新らしかった","あたらしかった"],["の"],["です"],["が"],["、"],["破れました","やぶれました"],["。"],["われわれ"],["の"],["この"],["着物","きもの"],["も"],["、"],["くつ"],["も"],["、"],["旅路","たびじ"],["が"],["ひじょう"],["に"],["長かった","ながかった"],["ので"],["、"],["古びて","ふるびて"],["しまいました"],["」"],["。"]]},{"verse":14,"text":"そこでイスラエルの人々,ひとびとは彼,かれらの食料,しょくりょう品,ひんを共,ともに食,たべ、主,しゅのさしずを求,もとめようとはしなかった。","tok":[["そこ"],["で"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["彼","かれ"],["ら"],["の"],["食料品","しょくりょうひん"],["を"],["共","とも"],["に"],["食べ","たべ"],["、"],["主","しゅ"],["の"],["さしず"],["を"],["求めよう","もとめよう"],["と"],["は"],["しなかった"],["。"]]},{"verse":15,"text":"そしてヨシュアは彼,かれらと和,わを講,こうじ、契約,けいやくを結,むすんで、彼,かれらを生,いかしておいた。会衆,かいしゅうの長,ちょうたちは彼,かれらに誓,ちかいを立,たてた。","tok":[["そして"],["ヨシュア"],["は"],["彼","かれ"],["ら"],["と"],["和","わ"],["を"],["講じ","こうじ"],["、"],["契約","けいやく"],["を"],["結んで","むすんで"],["、"],["彼","かれ"],["ら"],["を"],["生かして","いかして"],["おいた"],["。"],["会衆","かいしゅう"],["の"],["長","ちょう"],["たち"],["は"],["彼","かれ"],["ら"],["に"],["誓い","ちかい"],["を"],["立てた","たてた"],["。"]]},{"verse":16,"text":"契約,けいやくを結,むすんで三日,かの後,のちに、彼,かれらはその人々,ひとびとが近,ちかくの人々,ひとびとで、自分,じぶんたちのうちに住,すんでいるということを聞,きいた。","tok":[["契約","けいやく"],["を"],["結んで","むすんで"],["三日","か"],["の"],["後","のち"],["に"],["、"],["彼","かれ"],["ら"],["は"],["その"],["人々","ひとびと"],["が"],["近く","ちかく"],["の"],["人々","ひとびと"],["で"],["、"],["自分","じぶん"],["たち"],["の"],["うち"],["に"],["住んで","すんで"],["いる"],["と"],["いう"],["こと"],["を"],["聞いた","きいた"],["。"]]},{"verse":17,"text":"イスラエルの人々,ひとびとは進,すすんで、三日,か目,めにその町々,まちまちに着,ついた。その町々,まちまちとは、ギベオン、ケピラ、ベエロテおよびキリアテ・ヤリムであった。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["は"],["進んで","すすんで"],["、"],["三日目","かめ"],["に"],["その"],["町々","まちまち"],["に"],["着いた","ついた"],["。"],["その"],["町々","まちまち"],["と"],["は"],["、"],["ギベオン"],["、"],["ケピラ"],["、"],["ベエロテ"],["および"],["キリアテ"],["・"],["ヤリム"],["で"],["あった"],["。"]]},{"verse":18,"text":"ところで会衆,かいしゅうの長,ちょうたちが、すでにイスラエルの神,かみ、主,しゅをさして彼,かれらに誓,ちかいを立,たてていたので、イスラエルの人々,ひとびとは彼,かれらを殺,ころさなかった。そこで会衆,かいしゅうはみな、長,ちょうたちにむかってつぶやいた。","tok":[["ところ"],["で"],["会衆","かいしゅう"],["の"],["長","ちょう"],["たち"],["が"],["、"],["すでに"],["イスラエル"],["の"],["神","かみ"],["、"],["主","しゅ"],["を"],["さして"],["彼","かれ"],["ら"],["に"],["誓い","ちかい"],["を"],["立て","たてて"],["いた"],["ので"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["彼","かれ"],["ら"],["を"],["殺ろさなかった","ころさなかった"],["。"],["そこ"],["で"],["会衆","かいしゅう"],["は"],["みな"],["、"],["長","ちょう"],["たち"],["に"],["むかって"],["つぶやいた"],["。"]]},{"verse":19,"text":"しかし、長,ちょうたちは皆,みな、全,ぜん会衆,かいしゅうに言,いった、「われわれはイスラエルの神,かみ、主,しゅをさして彼,かれらに誓,ちかった。それゆえ今,いま、彼,かれらに触,ふれてはならない。","tok":[["しかし"],["、"],["長","ちょう"],["たち"],["は"],["皆","みな"],["、"],["全","ぜん"],["会衆","かいしゅう"],["に"],["言った","いった"],["、"],["「"],["われわれ"],["は"],["イスラエル"],["の"],["神","かみ"],["、"],["主","しゅ"],["を"],["さして"],["彼","かれ"],["ら"],["に"],["誓った","ちかった"],["。"],["それ"],["ゆえ"],["今","いま"],["、"],["彼","かれ"],["ら"],["に"],["触","ふれ"],["ては"],["ならない"],["。"]]},{"verse":20,"text":"われわれは、こうして彼,かれらを生,いかしておこう。そうすれば、われわれが彼,かれらに立,たてた誓,ちかいのゆえに、怒,いかりがわれわれに臨,のぞむことはないであろう」。","tok":[["われわれ"],["は"],["、"],["こう"],["して"],["彼","かれ"],["ら"],["を"],["生かして","いかして"],["おこう"],["。"],["そう"],["すれば"],["、"],["われわれ"],["が"],["彼","かれ"],["ら"],["に"],["立てた","たてた"],["誓い","ちかい"],["の"],["ゆえ"],["に"],["、"],["怒り","いかり"],["が"],["われわれ"],["に"],["臨む","のぞむ"],["こと"],["は"],["ないで"],["あろう"],["」"],["。"]]},{"verse":21,"text":"長,ちょうたちはまた人々,ひとびとに「彼,かれらを生,いかしておこう」と言,いったので、彼,かれらはついに、全,ぜん会衆,かいしゅうのために、たきぎを切,きり、水,みずをくむものとなった。長,ちょうたちが彼,かれらに言,いったとおりである。","tok":[["長","ちょう"],["たち"],["は"],["また"],["人々","ひとびと"],["に"],["「"],["彼","かれ"],["ら"],["を"],["生かして","いかして"],["おこう"],["」"],["と"],["言った","いった"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["ついに"],["、"],["全","ぜん"],["会衆","かいしゅう"],["の"],["ため"],["に"],["、"],["たきぎ"],["を"],["切り","きり"],["、"],["水","みず"],["を"],["くむ"],["もの"],["と"],["なった"],["。"],["長","ちょう"],["たち"],["が"],["彼","かれ"],["ら"],["に"],["言った","いった"],["とおり"],["で"],["ある"],["。"]]},{"verse":22,"text":"ヨシュアは彼,かれらを呼,よび寄,よせて言,いった、「あなたがたは、われわれのうちに住,すみながら、なぜ『われわれはあなたがたからは遠,とおく離,はなれている』と言,いって、われわれをだましたのか。","tok":[["ヨシュア"],["は"],["彼","かれ"],["ら"],["を"],["呼び寄せて","よびよせて"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["、"],["われわれ"],["の"],["うち"],["に"],["住み","すみ"],["ながら"],["、"],["なぜ"],["『"],["われわれ"],["は"],["あなた"],["がた"],["から"],["は"],["遠く","とおく"],["離れて","はなれて"],["いる"],["』"],["と"],["言って","いって"],["、"],["われわれ"],["を"],["だました"],["の"],["か"],["。"]]},{"verse":23,"text":"それであなたがたは今,いまのろわれ、奴隷,どれいとなってわたしの神,かみの家,いえのために、たきぎを切,きり、水,みずをくむものが、絶,たえずあなたがたのうちから出,でるであろう」。","tok":[["それ"],["で"],["あなた"],["がた"],["は"],["今","いま"],["のろわれ"],["、"],["奴隷","どれい"],["と"],["なって"],["わたし"],["の"],["神","かみ"],["の"],["家","いえ"],["の"],["ため"],["に"],["、"],["たきぎ"],["を"],["切り","きり"],["、"],["水","みず"],["を"],["くむ"],["もの"],["が"],["、"],["絶えず","たえず"],["あなた"],["がた"],["の"],["うち"],["から"],["出るで","でるで"],["あろう"],["」"],["。"]]},{"verse":24,"text":"彼,かれらはヨシュアに答,こたえて言,いった、「あなたの神,かみ、主,しゅがそのしもべモーセに、この地,ちをことごとくあなたがたに与,あたえ、この地,ちに住,すむ民,たみをことごとくあなたがたの前,まえから滅,ほろぼし去,さるようにと、お命,めいじになったことを、しもべどもは明,あきらかに伝,つたえ聞,ききましたので、あなたがたのゆえに、命,いのちが危,あやういと、われわれは非常,ひじょうに恐,おそれて、このことをしたのです。","tok":[["彼","かれ"],["ら"],["は"],["ヨシュア"],["に"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅがそ"],["の"],["しもべ"],["モーセ"],["に"],["、"],["この"],["地","ち"],["を"],["ことごとく"],["あなた"],["がた"],["に"],["与","あたえ"],["、"],["この"],["地","ち"],["に"],["住む","すむ"],["民","たみ"],["を"],["ことごとく"],["あなた"],["がた"],["の"],["前","まえ"],["から"],["滅ぼし去る","ほろぼしさる"],["よう"],["に"],["と"],["、"],["お命じ","おめいじ"],["に"],["なった"],["こと"],["を"],["、"],["しもべ"],["ども"],["は"],["明か","あきらか"],["に"],["伝え","つたえ"],["聞","きき"],["ました"],["ので"],["、"],["あなた"],["がた"],["の"],["ゆえ"],["に"],["、"],["命","いのち"],["が"],["危い","あやうい"],["と"],["、"],["われわれ"],["は"],["非常","ひじょう"],["に"],["恐れて","おそれて"],["、"],["この"],["こと"],["を"],["した"],["の"],["です"],["。"]]},{"verse":25,"text":"われわれは、今,いま、あなたの手,てのうちにあります。われわれにあなたがして良,よいと思,おもい、正,ただしいと思,おもうことをしてください」。","tok":[["われわれ"],["は"],["、"],["今","いま"],["、"],["あなた"],["の"],["手","て"],["の"],["うち"],["に"],["あります"],["。"],["われわれ"],["に"],["あなた"],["が"],["して"],["良い","よい"],["と"],["思い","おもい"],["、"],["正い","ただしい"],["と"],["思う","おもう"],["こと"],["を"],["して"],["ください"],["」"],["。"]]},{"verse":26,"text":"そこでヨシュアは、彼,かれらにそのようにし、彼,かれらをイスラエルの人々,ひとびとの手,てから救,すくって殺,ころさせなかった。","tok":[["そこ"],["で"],["ヨシュア"],["は"],["、"],["彼","かれ"],["ら"],["に"],["その"],["よう"],["に"],["し"],["、"],["彼","かれ"],["ら"],["を"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["手","て"],["から"],["救って","すくって"],["殺させなかった","ころさせなかった"],["。"]]},{"verse":27,"text":"しかし、ヨシュアは、その日,ひ、彼,かれらを、会衆,かいしゅうのため、また主,しゅの祭壇,さいだんのため、主,しゅが選,えらばれる場所,ばしょで、たきぎを切,きり、水,みずをくむ者,ものとした。これは今日,こんにちまでつづいている。","tok":[["しかし"],["、"],["ヨシュア"],["は"],["、"],["その"],["日","ひ"],["、"],["彼","かれ"],["ら"],["を"],["、"],["会衆","かいしゅう"],["の"],["ため"],["、"],["また"],["主","しゅ"],["の"],["祭壇","さいだん"],["の"],["ため"],["、"],["主","しゅ"],["が"],["選ら","えら"],["ばれる"],["場所","ばしょ"],["で"],["、"],["たきぎ"],["を"],["切り","きり"],["、"],["水","みず"],["を"],["くむ"],["者","もの"],["と"],["した"],["。"],["これ"],["は"],["今日","こんにち"],["まで"],["つづいて"],["いる"],["。"]]}]
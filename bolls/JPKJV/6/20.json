[{"verse":1,"text":"そこで主,しゅはヨシュアに言,いわれた、","tok":[["そこ"],["で"],["主","しゅ"],["は"],["ヨシュア"],["に"],["言われた","いわれた"],["、"]]},{"verse":2,"text":"「イスラエルの人々,ひとびとに言,いいなさい、『先,さきにわたしがモーセによって言,いっておいた、のがれの町,まちを選,えらび定,さだめ、","tok":[["「"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["言い","いい"],["なさい"],["、"],["『"],["先","さき"],["に"],["わたし"],["が"],["モーセ"],["によって"],["言って","いって"],["おいた"],["、"],["のがれ"],["の"],["町","まち"],["を"],["選ら","えら"],["び"],["定め","さだめ"],["、"]]},{"verse":3,"text":"あやまって、知,しらずに人,ひとを殺,ころした者,ものを、そこへのがれさせなさい。これはあなたがたが、あだを討,うつ者,ものをさけて、のがれる場所,ばしょとなるでしょう。","tok":[["あやまって"],["、"],["知らず","しらず"],["に"],["人","ひと"],["を"],["殺ろした","ころした"],["者","もの"],["を"],["、"],["そこ"],["へ"],["のがれさせ"],["なさい"],["。"],["これ"],["は"],["あなた"],["が"],["た"],["が"],["、"],["あだ"],["を"],["討つ","うつ"],["者","もの"],["を"],["さけて"],["、"],["のがれる"],["場所","ばしょ"],["と"],["なるでしょう"],["。"]]},{"verse":4,"text":"その人,ひとは、これらの町,まちの一つにのがれて行,いって、町,まちの門,もんの入口,いりぐちに立,たち、その町,まちの長老,ちょうろうたちに、そのわけを述,のべなければならない。そうすれば、彼,かれらはその人,ひとを町,まちに受,うけ入,いれて、場所,ばしょを与,あたえ、共,ともに住,すませるであろう。","tok":[["その"],["人","ひと"],["は"],["、"],["これ"],["ら"],["の"],["町","まち"],["の"],["一","ひと"],["つ"],["に"],["のがれて"],["行って","いって"],["、"],["町","まち"],["の"],["門","もん"],["の"],["入口","いりぐち"],["に"],["立ち","たち"],["、"],["その"],["町","まち"],["の"],["長老","ちょうろう"],["たち"],["に"],["、"],["その"],["わけ"],["を"],["述べなければ","のべなければ"],["ならない"],["。"],["そう"],["すれば"],["、"],["彼","かれ"],["ら"],["は"],["その"],["人","ひと"],["を"],["町","まち"],["に"],["受け入れて","うけいれて"],["、"],["場所","ばしょ"],["を"],["与","あたえ"],["、"],["共","とも"],["に"],["住ませるで","すませるで"],["あろう"],["。"]]},{"verse":5,"text":"たとい、あだを討,うつ者,ものが追,おってきても、人,ひとを殺,ころしたその者,ものを、その手,てに渡,わたしてはならない。彼,かれはあやまって隣人,りんじんを殺,ころしたのであって、もとからそれを憎,にくんでいたのではないからである。","tok":[["たとい"],["、"],["あだ"],["を"],["討つ","うつ"],["者","もの"],["が"],["追って","おって"],["きて"],["も"],["、"],["人","ひと"],["を"],["殺ろした","ころした"],["その"],["者","もの"],["を"],["、"],["その"],["手","て"],["に"],["渡","わたし"],["ては"],["ならない"],["。"],["彼","かれ"],["は"],["あやまって"],["隣人","りんじん"],["を"],["殺ろした","ころした"],["ので"],["あって"],["、"],["もと"],["から"],["それ"],["を"],["憎んで","にくんで"],["いた"],["ので"],["は"],["ない"],["から"],["で"],["ある"],["。"]]},{"verse":6,"text":"その人,ひとは、会衆,かいしゅうの前,まえに立,たって、さばきを受,うけるまで、あるいはその時,ときの大,だい祭司,さいしが死,しぬまで、その町,まちに住,すまなければならない。そして後,のち、彼,かれは自分,じぶんの町,まち、自分,じぶんの家,いえに帰,かえって行,いって、逃,にげ出,だしてきたその町,まちに住,すむことができる』」。","tok":[["その"],["人","ひと"],["は"],["、"],["会衆","かいしゅう"],["の"],["前","まえ"],["に"],["立って","たって"],["、"],["さばき"],["を"],["受る","うける"],["まで"],["、"],["あるいは"],["その"],["時","とき"],["の"],["大","だい"],["祭司","さいし"],["が"],["死ぬ","しぬ"],["まで"],["、"],["その"],["町","まち"],["に"],["住まなければ","すまなければ"],["ならない"],["。"],["そして"],["後","の"],["ち"],["、"],["彼","かれ"],["は"],["自分","じぶん"],["の"],["町","まち"],["、"],["自分","じぶん"],["の"],["家","いえ"],["に"],["帰えって","かえって"],["行って","いって"],["、"],["逃出して","にげだして"],["きた"],["その"],["町","まち"],["に"],["住む","すむ"],["こと"],["が"],["できる"],["』"],["」"],["。"]]},{"verse":7,"text":"そこで、ナフタリの山地,さんちにあるガリラヤのケデシ、エフライムの山地,さんちにあるシケム、およびユダの山地,さんちにあるキリアテ・アルバすなわちヘブロンを、これがために選,えらび分,わかち、","tok":[["そこ"],["で"],["、"],["ナフタリ"],["の"],["山地","さんち"],["に"],["ある"],["ガリラヤ"],["の"],["ケデシ"],["、"],["エフライム"],["の"],["山地","さんち"],["に"],["ある"],["シケム"],["、"],["および"],["ユダ"],["の"],["山地","さんち"],["に"],["ある"],["キリアテ"],["・"],["アルバ"],["すなわち"],["ヘブロン"],["を"],["、"],["これ"],["が"],["ため"],["に"],["選ら","えら"],["び"],["分かち","わかち"],["、"]]},{"verse":8,"text":"またヨルダンの向,むこう側,がわ、エリコの東,ひがしの方,ほうでは、ルベンの部族,ぶぞくのうちから、高原,こうげんの荒野,あらのにあるベゼル、ガドの部族,ぶぞくのうちから、ギレアデのラモテ、マナセの部族,ぶぞくのうちから、バシャンのゴランを選,えらび定,さだめた。","tok":[["また"],["ヨルダン"],["の"],["向こう側","むこうがわ"],["、"],["エリコ"],["の"],["東","ひがし"],["の"],["方","ほう"],["で"],["は"],["、"],["ルベン"],["の"],["部族","ぶぞく"],["の"],["うち"],["から"],["、"],["高原","こうげん"],["の"],["荒野","あらの"],["に"],["ある"],["ベゼル"],["、"],["ガド"],["の"],["部族","ぶぞく"],["の"],["うち"],["から"],["、"],["ギレアデ"],["の"],["ラモテ"],["、"],["マナセ"],["の"],["部族","ぶぞく"],["の"],["うち"],["から"],["、"],["バシャン"],["の"],["ゴラン"],["を"],["選ら","えら"],["び"],["定めた","さだめた"],["。"]]},{"verse":9,"text":"これらは、イスラエルのすべての人々,ひとびと、およびそのうちに寄留,きりゅうする他国,たこく人,じんのために設,もうけられた町々,まちまちであって、すべて、あやまって人,ひとを殺,ころした者,ものを、そこにのがれさせ、会衆,かいしゅうの前,まえに立,たたないうちに、あだを討,うつ者,ものの手,てにかかって死,しぬことのないようにするためである。","tok":[["これ"],["ら"],["は"],["、"],["イスラエル"],["の"],["すべて"],["の"],["人々","ひとびと"],["、"],["および"],["その"],["うち"],["に"],["寄留","きりゅう"],["する"],["他国人","たこくじん"],["の"],["ため"],["に"],["設けられた","もうけられた"],["町々","まちまち"],["で"],["あって"],["、"],["すべて"],["、"],["あやまって"],["人","ひと"],["を"],["殺ろした","ころした"],["者","もの"],["を"],["、"],["そこ"],["に"],["のがれさせ"],["、"],["会衆","かいしゅう"],["の"],["前","まえ"],["に"],["立たない","たたない"],["うち"],["に"],["、"],["あだ"],["を"],["討つ","うつ"],["者","もの"],["の"],["手","て"],["に"],["かかって"],["死ぬ","しぬ"],["こと"],["の"],["ない"],["よう"],["に"],["する"],["ため"],["で"],["ある"],["。"]]}]
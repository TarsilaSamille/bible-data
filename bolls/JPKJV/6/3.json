[{"verse":1,"text":"ヨシュアは朝,あさ早,はやく起,おき、イスラエルの人々,ひとびとすべてとともにシッテムを出立,しゅったつして、ヨルダンに行,いき、それを渡,わたらずに、そこに宿,やどった。","tok":[["ヨシュア"],["は"],["朝","あさ"],["早く","はやく"],["起き","おき"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["すべて"],["と"],["とも"],["に"],["シッテム"],["を"],["出立","しゅったつ"],["して"],["、"],["ヨルダン"],["に"],["行き","いき"],["、"],["それ"],["を"],["渡らず","わたらず"],["に"],["、"],["そこ"],["に"],["宿った","やどった"],["。"]]},{"verse":2,"text":"三日,かの後,のち、つかさたちは宿営,しゅくえいの中,なかを行,いき巡,めぐり、","tok":[["三日","か"],["の"],["後","の"],["ち"],["、"],["つかさ"],["たち"],["は"],["宿営","しゅくえい"],["の"],["中","なか"],["を"],["行き","いき"],["巡り","めぐり"],["、"]]},{"verse":3,"text":"民,たみに命,めいじて言,いった、「レビびとである祭司,さいしたちが、あなたがたの神,かみ、主,しゅの契約,けいやくの箱,はこをかきあげるのを見,みるならば、あなたがたはその所,ところを出立,しゅったつして、そのあとに従,したがわなければならない。","tok":[["民","たみ"],["に"],["命じて","めいじて"],["言った","いった"],["、"],["「"],["レビ"],["びと"],["で"],["ある"],["祭司","さいし"],["たち"],["が"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["契約","けいやく"],["の"],["箱","はこ"],["を"],["かきあげる"],["の"],["を"],["見るならば","みるならば"],["、"],["あなた"],["がた"],["は"],["その"],["所","ところ"],["を"],["出立","しゅったつ"],["して"],["、"],["その"],["あと"],["に"],["従わなければ","したがわなければ"],["ならない"],["。"]]},{"verse":4,"text":"そうすれば、あなたがたは行,いくべき道,みちを知,しることができるであろう。あなたがたは前,まえにこの道,みちをとおったことがないからである。しかし、あなたがたと箱,はことの間,あいだには、おおよそ二千キュビトの距離,きょりをおかなければならない。それに近,ちかづいてはならない」。","tok":[["そう"],["すれば"],["、"],["あなた"],["がた"],["は"],["行くべき","いくべき"],["道","みち"],["を"],["知る","しる"],["こと"],["が"],["できるで"],["あろう"],["。"],["あなた"],["がた"],["は"],["前","まえ"],["に"],["この"],["道","みち"],["を"],["とおった"],["こと"],["が"],["ない"],["から"],["で"],["ある"],["。"],["しかし"],["、"],["あなた"],["がた"],["と"],["箱","はこと"],["の"],["間","あいだ"],["に"],["は"],["、"],["おおよそ"],["二千","にせん"],["キュビト"],["の"],["距離","きょり"],["を"],["おかなければ"],["ならない"],["。"],["それ"],["に"],["近づいて","ちかづいて"],["は"],["ならない"],["」"],["。"]]},{"verse":5,"text":"ヨシュアはまた民,たみに言,いった、「あなたがたは身,みを清,きよめなさい。あす、主,しゅがあなたがたのうちに不思議,ふしぎを行,おこなわれるからである」。","tok":[["ヨシュア"],["は"],["また"],["民","たみ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["身","み"],["を"],["清め","きよめ"],["なさい"],["。"],["あす"],["、"],["主","しゅ"],["が"],["あなた"],["がた"],["の"],["うち"],["に"],["不思議","ふしぎ"],["を"],["行なわれる","おこなわれる"],["から"],["で"],["ある"],["」"],["。"]]},{"verse":6,"text":"ヨシュアは祭司,さいしたちに言,いった、「契約,けいやくの箱,はこをかき、民,たみに先立,さきだって渡,わたりなさい」。そこで彼,かれらは契約,けいやくの箱,はこをかき、民,たみに先立,さきだって進,すすんだ。","tok":[["ヨシュア"],["は"],["祭司","さいし"],["たち"],["に"],["言った","いった"],["、"],["「"],["契約","けいやく"],["の"],["箱","はこ"],["を"],["かき"],["、"],["民","たみ"],["に"],["先立って","さきだって"],["渡り","わたり"],["なさい"],["」"],["。"],["そこ"],["で"],["彼","かれ"],["ら"],["は"],["契約","けいやく"],["の"],["箱","はこ"],["を"],["かき"],["、"],["民","たみ"],["に"],["先立って","さきだって"],["進んだ","すすんだ"],["。"]]},{"verse":7,"text":"主,しゅはヨシュアに言,いわれた、「きょうからわたしはすべてのイスラエルの前,まえにあなたを尊,たっとい者,ものとするであろう。こうしてわたしがモーセと共,ともにいたように、あなたとともにおることを彼,かれらに知,しらせるであろう。","tok":[["主","しゅ"],["は"],["ヨシュア"],["に"],["言われた","いわれた"],["、"],["「"],["きょう"],["から"],["わたし"],["は"],["すべて"],["の"],["イスラエル"],["の"],["前","まえ"],["に"],["あなた"],["を"],["尊","た"],["っと"],["い"],["者","もの"],["と"],["するで"],["あろう"],["。"],["こう"],["して"],["わたし"],["が"],["モーセ"],["と"],["共","とも"],["に"],["いた"],["よう"],["に"],["、"],["あなた"],["と"],["とも"],["に"],["おる"],["こと"],["を"],["彼","かれ"],["ら"],["に"],["知らせるで","しらせるで"],["あろう"],["。"]]},{"verse":8,"text":"あなたは契約,けいやくの箱,はこをかく祭司,さいしたちに命,めいじて言,いわなければならない、『あなたがたは、ヨルダンの水,みずぎわへ行,いくと、すぐ、ヨルダンの中,なかに立,たちとどまらなければならない』」。","tok":[["あなた"],["は"],["契約","けいやく"],["の"],["箱","はこ"],["を"],["かく"],["祭司","さいし"],["たち"],["に"],["命じて","めいじて"],["言わなければ","いわなければ"],["ならない"],["、"],["『"],["あなた"],["がた"],["は"],["、"],["ヨルダン"],["の"],["水ぎわ","みずぎわ"],["へ"],["行く","いく"],["と"],["、"],["すぐ"],["、"],["ヨルダン"],["の"],["中","なか"],["に"],["立ち","たち"],["とどまらなければ"],["ならない"],["』"],["」"],["。"]]},{"verse":9,"text":"ヨシュアはイスラエルの人々,ひとびとに言,いった、「あなたがたはここに近,ちかづいて、あなたがたの神,かみ、主,しゅの言葉,ことばを聞,ききなさい」。","tok":[["ヨシュア"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["ここ"],["に"],["近づいて","ちかづいて"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["を"],["聞","きき"],["なさい"],["」"],["。"]]},{"verse":10,"text":"そしてヨシュアは言,いった、「生,いける神,かみがあなたがたのうちにおいでになり、あなたがたの前,まえから、カナンびと、ヘテびと、ヒビびと、ペリジびと、ギルガシびと、アモリびと、エブスびとを、必,かならず追,おい払,はらわれることを、次,つぎのことによって、あなたがたは知,しるであろう。","tok":[["そして"],["ヨシュア"],["は"],["言った","いった"],["、"],["「"],["生ける","いける"],["神","かみ"],["が"],["あなた"],["がた"],["の"],["うち"],["に"],["おいで"],["に"],["なり"],["、"],["あなた"],["がた"],["の"],["前","まえ"],["から"],["、"],["カナン"],["び"],["と"],["、"],["ヘテ"],["び"],["と"],["、"],["ヒビ"],["び"],["と"],["、"],["ペリジ"],["び"],["と"],["、"],["ギルガシ"],["び"],["と"],["、"],["アモリ"],["び"],["と"],["、"],["エブス"],["びと"],["を"],["、"],["必","かならず"],["追い払われる","おいはらわれる"],["こと"],["を"],["、"],["次","つぎ"],["の"],["こと"],["によって"],["、"],["あなた"],["がた"],["は"],["知るで","しるで"],["あろう"],["。"]]},{"verse":11,"text":"ごらんなさい。全,ぜん地,ちの主,しゅの契約,けいやくの箱,はこは、あなたがたに先立,さきだってヨルダンを渡,わたろうとしている。","tok":[["ごらん"],["なさい"],["。"],["全地","ぜんち"],["の"],["主","しゅ"],["の"],["契約","けいやく"],["の"],["箱","はこ"],["は"],["、"],["あなた"],["がた"],["に"],["先立って","さきだって"],["ヨルダン"],["を"],["渡ろう","わたろう"],["として"],["いる"],["。"]]},{"verse":12,"text":"それゆえ、今,いま、イスラエルの部族,ぶぞくのうちから、部族,ぶぞくごとにひとりずつ、合,あわせて十二人,にんを選,えらびなさい。","tok":[["それ"],["ゆえ"],["、"],["今","いま"],["、"],["イスラエル"],["の"],["部族","ぶぞく"],["の"],["うち"],["から"],["、"],["部族","ぶぞく"],["ごと"],["に"],["ひとり"],["ずつ"],["、"],["合","あわせ"],["て"],["十二人","にん"],["を"],["選ら","えら"],["び"],["なさい"],["。"]]},{"verse":13,"text":"全,ぜん地,ちの主,しゅなる神,かみの箱,はこをかく祭司,さいしたちの足,あしの裏,うらが、ヨルダンの水,みずの中,なかに踏,ふみとどまる時,とき、ヨルダンの水,みずは流,ながれをせきとめられ、上,うえから流,ながれくだる水,みずはとどまって、うず高,たかくなるであろう」。","tok":[["全地","ぜんち"],["の"],["主","しゅ"],["なる"],["神","かみ"],["の"],["箱","はこ"],["を"],["かく"],["祭司","さいし"],["たち"],["の"],["足","あし"],["の"],["裏","うら"],["が"],["、"],["ヨルダン"],["の"],["水","みず"],["の"],["中","なか"],["に"],["踏みとどまる","ふみとどまる"],["時","とき"],["、"],["ヨルダン"],["の"],["水","みず"],["は"],["流れ","ながれ"],["を"],["せきとめられ"],["、"],["上","うえ"],["から"],["流れくだる","ながれくだる"],["水","みず"],["は"],["とどまって"],["、"],["うず高く","うずたかく"],["なるで"],["あろう"],["」"],["。"]]},{"verse":14,"text":"こうして民,たみはヨルダンを渡,わたろうとして天幕,てんまくをいで立,たち、祭司,さいしたちは契約,けいやくの箱,はこをかき、民,たみに先立,さきだって行,いったが、","tok":[["こう"],["して"],["民","たみ"],["は"],["ヨルダン"],["を"],["渡ろう","わたろう"],["として"],["天幕","てんまく"],["を"],["いで立ち","いでたち"],["、"],["祭司","さいし"],["たち"],["は"],["契約","けいやく"],["の"],["箱","はこ"],["を"],["かき"],["、"],["民","たみ"],["に"],["先立って","さきだって"],["行った","いった"],["が"],["、"]]},{"verse":15,"text":"箱,はこをかく者,ものがヨルダンにきて、箱,はこをかく祭司,さいしたちの足,あしが水,みずぎわにひたると同時,どうじに、――ヨルダンは刈入,かりいれの間,あいだ中,ぢゅう、岸,きし一面,いちめんにあふれるのであるが、――","tok":[["箱","はこ"],["を"],["かく"],["者","もの"],["が"],["ヨルダン"],["に"],["きて"],["、"],["箱","はこ"],["を"],["かく"],["祭司","さいし"],["たち"],["の"],["足","あし"],["が"],["水ぎわ","みずぎわ"],["に"],["ひたる"],["と"],["同時","どうじ"],["に"],["、"],["―"],["―"],["ヨルダン"],["は"],["刈入れ","かりいれ"],["の"],["間中","あいだぢゅ"],["う"],["、"],["岸","きし"],["一面","いちめん"],["に"],["あふれる"],["ので"],["ある"],["が"],["、"],["―"],["―"]]},{"verse":16,"text":"上,うえから流,ながれくだる水,みずはとどまって、はるか遠,とおくのザレタンのかたわらにある町,まちアダムのあたりで、うず高,たかく立,たち、アラバの海,うみすなわち塩,しおの海,うみの方,ほうに流,ながれくだる水,みずは全,まったくせきとめられたので、民,たみはエリコに向,むかって渡,わたった。","tok":[["上","うえ"],["から"],["流れくだる","ながれくだる"],["水","みず"],["は"],["とどまって"],["、"],["はるか"],["遠く","とおく"],["の"],["ザレタン"],["の"],["かたわら"],["に"],["ある"],["町","まち"],["アダム"],["の"],["あたり"],["で"],["、"],["うず高く","うずたかく"],["立ち","たち"],["、"],["アラバ"],["の"],["海","うみ"],["すなわち"],["塩","しお"],["の"],["海","うみ"],["の"],["方","ほう"],["に"],["流れくだる","ながれくだる"],["水","みず"],["は"],["全く","まったく"],["せきとめられた"],["ので"],["、"],["民","たみ"],["は"],["エリコ"],["に"],["向かって","むかって"],["渡った","わたった"],["。"]]},{"verse":17,"text":"すべてのイスラエルが、かわいた地,ちを渡,わたって行,いく間,あいだ、主,しゅの契約,けいやくの箱,はこをかく祭司,さいしたちは、ヨルダンの中,なかのかわいた地,ちに立,たっていた。そしてついに民,たみはみなヨルダンを渡,わたり終,おわった。","tok":[["すべて"],["の"],["イスラエル"],["が"],["、"],["かわいた"],["地","ち"],["を"],["渡って","わたって"],["行く","いく"],["間","あいだ"],["、"],["主","しゅ"],["の"],["契約","けいやく"],["の"],["箱","はこ"],["を"],["かく"],["祭司","さいし"],["たち"],["は"],["、"],["ヨルダン"],["の"],["中","なか"],["の"],["かわいた"],["地","ち"],["に"],["立って","たって"],["いた"],["。"],["そして"],["ついに"],["民","たみ"],["は"],["みな"],["ヨルダン"],["を"],["渡り","わたり"],["終わった","おわった"],["。"]]}]
[{"verse":1,"text":"さてヨシュアは年,としが進,すすんで老,おいたが、主,しゅは彼,かれに言,いわれた、「あなたは年,としが進,すすんで老,おいたが、取,とるべき地,ちは、なお多,おおく残,のこっている。","tok":[["さて"],["ヨシュア"],["は"],["年","と"],["し"],["が"],["進んで","すすんで"],["老","おい"],["た"],["が"],["、"],["主","しゅ"],["は"],["彼","かれ"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["は"],["年","と"],["し"],["が"],["進んで","すすんで"],["老","おい"],["た"],["が"],["、"],["取るべき","とるべき"],["地","ち"],["は"],["、"],["なお"],["多く","おおく"],["残って","のこって"],["いる"],["。"]]},{"verse":2,"text":"その残,のこっている地,ちは、次,つぎのとおりである。ペリシテびとの全,ぜん地域,ちいき、ゲシュルびとの全土,ぜんど、","tok":[["その"],["残って","のこって"],["いる"],["地","ち"],["は"],["、"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["ペリシテ"],["びと"],["の"],["全","ぜん"],["地域","ちいき"],["、"],["ゲシュル"],["びと"],["の"],["全土","ぜんど"],["、"]]},{"verse":3,"text":"エジプトの東,ひがしのシホルから北,きたにのびて、カナンびとに属,ぞくするといわれるエクロンの境,さかいまでの地,ち、ペリシテびとの五人,にんの君,きみたちの地,ち、すなわち、ガザ、アシドド、アシケロン、ガテ、およびエクロン。","tok":[["エジプト"],["の"],["東","ひがし"],["の"],["シホル"],["から"],["北","きた"],["に"],["のびて"],["、"],["カナン"],["びと"],["に"],["属する","ぞくする"],["と"],["いわれる"],["エクロン"],["の"],["境","さかい"],["まで"],["の"],["地","ち"],["、"],["ペリシテ"],["びと"],["の"],["五人","にん"],["の"],["君","きみ"],["たち"],["の"],["地","ち"],["、"],["すなわち"],["、"],["ガザ"],["、"],["アシドド"],["、"],["アシケロン"],["、"],["ガテ"],["、"],["および"],["エクロン"],["。"]]},{"verse":4,"text":"南,みなみのアビびとの地,ち、カナンびとの全,ぜん地,ち、シドンびとに属,ぞくするメアラからアモリびとの境,さかいにあるアペクまでの部分,ぶぶん。","tok":[["南","みなみ"],["の"],["アビ"],["びと"],["の"],["地","ち"],["、"],["カナン"],["びと"],["の"],["全地","ぜんち"],["、"],["シドン"],["びと"],["に"],["属する","ぞくする"],["メアラ"],["から"],["アモリ"],["びと"],["の"],["境","さかい"],["に"],["ある"],["アペク"],["まで"],["の"],["部分","ぶぶん"],["。"]]},{"verse":5,"text":"またヘルモン山,やまのふもとのバアルガデからハマテの入口,いりぐちに至,いたるゲバルびとの地,ち、およびレバノンの東,ひがしの全土,ぜんど。","tok":[["また"],["ヘルモン"],["山","やま"],["の"],["ふもと"],["の"],["バアルガデ"],["から"],["ハマテ"],["の"],["入口","いりぐち"],["に"],["至る","いたる"],["ゲバル"],["びと"],["の"],["地","ち"],["、"],["および"],["レバノン"],["の"],["東","ひがし"],["の"],["全土","ぜんど"],["。"]]},{"verse":6,"text":"レバノンからミスレポテ・マイムまでの山地,さんちのすべての民,たみ、すなわちシドンびとの全土,ぜんど。わたしはみずから彼,かれらをイスラエルの人々,ひとびとの前,まえから追,おい払,はらうであろう。わたしが命,めいじたように、あなたはその地,ちをイスラエルに分,わけ与,あたえて、嗣,し業,ぎょうとさせなければならない。","tok":[["レバノン"],["から"],["ミスレポテ"],["・"],["マイム"],["まで"],["の"],["山地","さんち"],["の"],["すべて"],["の"],["民","たみ"],["、"],["すなわち"],["シドン"],["びと"],["の"],["全土","ぜんど"],["。"],["わたし"],["は"],["みずから"],["彼","かれ"],["ら"],["を"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["前","まえ"],["から"],["追い払うで","おいはらうで"],["あろう"],["。"],["わたし"],["が"],["命じた","めいじた"],["よう"],["に"],["、"],["あなた"],["は"],["その"],["地","ち"],["を"],["イスラエル"],["に"],["分け","わけ"],["与","あたえ"],["て"],["、"],["嗣業","しぎょう"],["と"],["させなければ"],["ならない"],["。"]]},{"verse":7,"text":"すなわち、その地,ちを九つの部族,ぶぞくと、マナセの半,はん部族,ぶぞくとに分,わけ与,あたえて、嗣,し業,ぎょうとさせなければならない」。","tok":[["すなわち"],["、"],["その"],["地","ち"],["を"],["九","ここの"],["つ"],["の"],["部族","ぶぞく"],["と"],["、"],["マナセ"],["の"],["半","はん"],["部族","ぶぞく"],["と"],["に"],["分け","わけ"],["与","あたえ"],["て"],["、"],["嗣業","しぎょう"],["と"],["させなければ"],["ならない"],["」"],["。"]]},{"verse":8,"text":"マナセの他,たの半,はん部族,ぶぞくと共,ともに、ルベンびとと、ガドびととは、ヨルダンの向,むこう側,がわ、東,ひがしの方,ほうで、その嗣,し業,ぎょうをモーセから受,うけた。主,しゅのしもべモーセが、彼,かれらに与,あたえたのは、","tok":[["マナセ"],["の"],["他","た"],["の"],["半","はん"],["部族","ぶぞく"],["と"],["共","とも"],["に"],["、"],["ルベン"],["びと"],["と"],["、"],["ガド"],["びと"],["と"],["は"],["、"],["ヨルダン"],["の"],["向こう側","むこうがわ"],["、"],["東","ひがし"],["の"],["方","ほう"],["で"],["、"],["その"],["嗣業","しぎょう"],["を"],["モーセ"],["から"],["受けた","うけた"],["。"],["主","しゅ"],["の"],["しもべ"],["モーセ"],["が"],["、"],["彼","かれ"],["ら"],["に"],["与","あたえ"],["た"],["の"],["は"],["、"]]},{"verse":9,"text":"アルノンの谷,たにのほとりにあるアロエル、および谷,たにの中,なかにある町,まちから、デボンとメデバの間,あいだにある高原,こうげんのすべての地,ち。","tok":[["アルノン"],["の"],["谷","たに"],["の"],["ほとり"],["に"],["ある"],["アロエル"],["、"],["および"],["谷","たに"],["の"],["中","なか"],["に"],["ある"],["町","まち"],["から"],["、"],["デボン"],["と"],["メデバ"],["の"],["間","あいだ"],["に"],["ある"],["高原","こうげん"],["の"],["すべて"],["の"],["地","ち"],["。"]]},{"verse":10,"text":"ヘシボンで世,よを治,おさめた、アモリびとの王,おうシホンのすべての町々,まちまちを含,ふくめて、アンモンの人々,ひとびとの境,さかいまでの地,ち。","tok":[["ヘシボン"],["で"],["世","よ"],["を"],["治めた","おさめた"],["、"],["アモリ"],["びと"],["の"],["王","おう"],["シホン"],["の"],["すべて"],["の"],["町々","まちまち"],["を"],["含めて","ふくめて"],["、"],["アンモン"],["の"],["人々","ひとびと"],["の"],["境","さかい"],["まで"],["の"],["地","ち"],["。"]]},{"verse":11,"text":"ギレアデと、ゲシュルびと、ならびにマアカびとの領地,りょうち、ヘルモン山,やまの全土,ぜんど、サルカまでのバシャン全体,ぜんたい。","tok":[["ギレアデ"],["と"],["、"],["ゲシュル"],["び"],["と"],["、"],["ならびに"],["マアカ"],["びと"],["の"],["領地","りょうち"],["、"],["ヘルモン"],["山","やま"],["の"],["全土","ぜんど"],["、"],["サルカ"],["まで"],["の"],["バシャン"],["全体","ぜんたい"],["。"]]},{"verse":12,"text":"アシタロテとエデレイで世,よを治,おさめたバシャンの王,おうオグの全国,ぜんこく。オグはレパイムの生,いき残,のこりであった。モーセはこれらを撃,うって、追,おい払,はらった。","tok":[["アシタロテ"],["と"],["エデレイ"],["で"],["世","よ"],["を"],["治めた","おさめた"],["バシャン"],["の"],["王","おう"],["オグ"],["の"],["全国","ぜんこく"],["。"],["オグ"],["は"],["レパイム"],["の"],["生き残り","いきのこり"],["で"],["あった"],["。"],["モーセ"],["は"],["これ"],["ら"],["を"],["撃って","うって"],["、"],["追い払った","おいはらった"],["。"]]},{"verse":13,"text":"ただし、イスラエルの人々,ひとびとは、ゲシュルびとと、マアカびとを追,おい払,はらわなかった。ゲシュルびとと、マアカびとは、今日,こんにちまでイスラエルのうちに住,すんでいる。","tok":[["ただし"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["、"],["ゲシュル"],["びと"],["と"],["、"],["マアカ"],["びと"],["を"],["追い払わなかった","おいはらわなかった"],["。"],["ゲシュル"],["びと"],["と"],["、"],["マアカ"],["びと"],["は"],["、"],["今日","こん"],["に"],["ち"],["まで"],["イスラエル"],["の"],["うち"],["に"],["住んで","すんで"],["いる"],["。"]]},{"verse":14,"text":"ただレビの部族,ぶぞくには、ヨシュアはなんの嗣,し業,ぎょうをも与,あたえなかった。イスラエルの神,かみ、主,しゅの火祭,かさいが彼,かれらの嗣,し業,ぎょうであるからである。主,しゅがヨシュアに言,いわれたとおりである。","tok":[["ただ"],["レビ"],["の"],["部族","ぶぞく"],["に"],["は"],["、"],["ヨシュア"],["は"],["なん"],["の"],["嗣業","しぎょう"],["を"],["も"],["与えなかった","あたえなかった"],["。"],["イスラエル"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["火祭","か"],["さい"],["が"],["彼","かれ"],["ら"],["の"],["嗣業","しぎょ"],["うで"],["ある"],["から"],["で"],["ある"],["。"],["主","しゅ"],["が"],["ヨシュア"],["に"],["言われた","いわれた"],["とおり"],["で"],["ある"],["。"]]},{"verse":15,"text":"モーセはルベンびとの部族,ぶぞくに、その家族,かぞくにしたがって嗣,し業,ぎょうを与,あたえたが、","tok":[["モーセ"],["は"],["ルベン"],["びと"],["の"],["部族","ぶぞく"],["に"],["、"],["その"],["家族","かぞく"],["に"],["したがって"],["嗣業","しぎょう"],["を"],["与えた","あたえた"],["が"],["、"]]},{"verse":16,"text":"その領域,りょういきはアルノンの谷,たにのほとりにあるアロエル、および谷,たにの中,なかにある町,まちからメデバのほとりのすべての高原,こうげん、","tok":[["その"],["領域","りょういき"],["は"],["アルノン"],["の"],["谷","たに"],["の"],["ほとり"],["に"],["ある"],["アロエル"],["、"],["および"],["谷","たに"],["の"],["中","なか"],["に"],["ある"],["町","まち"],["から"],["メデバ"],["の"],["ほとり"],["の"],["すべて"],["の"],["高原","こ"],["う"],["げん"],["、"]]},{"verse":17,"text":"ヘシボンおよびその高原,こうげんのすべての町々,まちまち、デボン、バモテ・バアル、ベテ・バアル・メオン、","tok":[["ヘシボン"],["および"],["その"],["高原","こうげん"],["の"],["すべて"],["の"],["町々","まちまち"],["、"],["デボン"],["、"],["バモテ"],["・"],["バアル"],["、"],["ベテ"],["・"],["バアル"],["・"],["メオン"],["、"]]},{"verse":18,"text":"ヤハヅ、ケデモテ、メパアテ、","tok":[["ヤハヅ"],["、"],["ケデモテ"],["、"],["メパアテ"],["、"]]},{"verse":19,"text":"キリアタイム、シブマ、谷,たにの中,なかの山,やまにあるゼレテ・シャハル、","tok":[["キリアタイム"],["、"],["シブマ"],["、"],["谷","たに"],["の"],["中","なか"],["の"],["山","やま"],["に"],["ある"],["ゼレテ"],["・"],["シャハル"],["、"]]},{"verse":20,"text":"ベテペオル、ピスガの山腹,さんぷく、ベテエシモテ、","tok":[["ベテペオル"],["、"],["ピスガ"],["の"],["山腹","さんぷく"],["、"],["ベテエシモテ"],["、"]]},{"verse":21,"text":"すなわち高原,こうげんのすべての町々,まちまちと、ヘシボンで世,よを治,おさめたアモリびとの王,おうシホンの全国,ぜんこくに及,およんだ。モーセはシホンを、ミデアンのつかさたちエビ、レケム、ツル、ホルおよびレバと共,ともに撃,うち殺,ころした。これらはみなシホンの諸侯,しょこうであって、その地,ちに住,すんでいた者,ものである。","tok":[["すなわち"],["高原","こうげん"],["の"],["すべて"],["の"],["町々","まちまち"],["と"],["、"],["ヘシボン"],["で"],["世","よ"],["を"],["治めた","おさめた"],["アモリ"],["びと"],["の"],["王","おう"],["シホン"],["の"],["全国","ぜんこく"],["に"],["及んだ","およんだ"],["。"],["モーセ"],["は"],["シホン"],["を"],["、"],["ミデアン"],["の"],["つかさ"],["たち"],["エビ"],["、"],["レケム"],["、"],["ツル"],["、"],["ホル"],["および"],["レバ"],["と"],["共","とも"],["に"],["撃ち殺した","うちころした"],["。"],["これ"],["ら"],["は"],["みな"],["シホン"],["の"],["諸侯","しょこう"],["で"],["あって"],["、"],["その"],["地","ち"],["に"],["住んで","すんで"],["いた"],["者","もの"],["で"],["ある"],["。"]]},{"verse":22,"text":"イスラエルの人々,ひとびとはまたベオルの子,こ、占,うらない師,しバラムをもつるぎにかけて、そのほかに殺,ころした者,ものどもと共,ともに殺,ころした。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["は"],["また"],["ベオル"],["の"],["子","こ"],["、"],["占師","うらないし"],["バラム"],["を"],["も"],["つるぎ"],["に"],["かけて"],["、"],["その"],["ほか"],["に"],["殺ろした","ころした"],["者","もの"],["ども"],["と"],["共","とも"],["に"],["殺ろした","ころした"],["。"]]},{"verse":23,"text":"ルベンびとの領域,りょういきはヨルダンを境,さかいとした。これはルベンびとが、その家族,かぞくにしたがって獲,えた嗣,し業,ぎょうであって、その町々,まちまちと村々,むらむらとを含,ふくむ。","tok":[["ルベン"],["びと"],["の"],["領域","りょういき"],["は"],["ヨルダン"],["を"],["境","さかい"],["と"],["した"],["。"],["これ"],["は"],["ルベン"],["びと"],["が"],["、"],["その"],["家族","かぞく"],["に"],["したがって"],["獲た","えた"],["嗣業","しぎょ"],["うで"],["あって"],["、"],["その"],["町々","まちまち"],["と"],["村々","むらむら"],["と"],["を"],["含","ふくむ"],["。"]]},{"verse":24,"text":"モーセはまたガドの部族,ぶぞく、ガドの子孫,しそんにも、その家族,かぞくにしたがって、嗣,し業,ぎょうを与,あたえたが、","tok":[["モーセ"],["は"],["また"],["ガド"],["の"],["部族","ぶぞく"],["、"],["ガド"],["の"],["子孫","しそん"],["に"],["も"],["、"],["その"],["家族","かぞく"],["に"],["したがって"],["、"],["嗣業","しぎょう"],["を"],["与えた","あたえた"],["が"],["、"]]},{"verse":25,"text":"その領域,りょういきはヤゼル、ギレアデのすべての町々,まちまち、アンモンびとの地,ちの半,なかばで、ラバの東,ひがしのアロエルまでの地,ち。","tok":[["その"],["領域","りょういき"],["は"],["ヤゼル"],["、"],["ギレアデ"],["の"],["すべて"],["の"],["町々","まちまち"],["、"],["アンモン"],["びと"],["の"],["地","ち"],["の"],["半ば","なかば"],["で"],["、"],["ラバ"],["の"],["東","ひがし"],["の"],["アロエル"],["まで"],["の"],["地","ち"],["。"]]},{"verse":26,"text":"ヘシボンからラマテ・ミゾパまでの地,ち、およびベトニム、マハナイムからデビルの境,さかいまでの地,ち。","tok":[["ヘシボン"],["から"],["ラマテ"],["・"],["ミゾパ"],["まで"],["の"],["地","ち"],["、"],["および"],["ベトニム"],["、"],["マハナイム"],["から"],["デビル"],["の"],["境","さかい"],["まで"],["の"],["地","ち"],["。"]]},{"verse":27,"text":"谷,たにの中,なかではベテハラム、ベテニムラ、スコテ、およびザポンなど、ヘシボンの王,おうシホンの国,くにの残,のこりの部分,ぶぶん。ヨルダンを境,さかいとして、ヨルダンの東側,ひがしがわ、キンネレテの湖,みずうみの南,みなみの端,はしまでの地,ち。","tok":[["谷","たに"],["の"],["中","なか"],["で"],["は"],["ベテハラム"],["、"],["ベテニムラ"],["、"],["スコテ"],["、"],["および"],["ザポン"],["など"],["、"],["ヘシボン"],["の"],["王","おう"],["シホン"],["の"],["国","くに"],["の"],["残り","のこり"],["の"],["部分","ぶぶん"],["。"],["ヨルダン"],["を"],["境","さかい"],["として"],["、"],["ヨルダン"],["の"],["東側","ひがしがわ"],["、"],["キンネレテ"],["の"],["湖","みずうみ"],["の"],["南","みなみ"],["の"],["端","はし"],["まで"],["の"],["地","ち"],["。"]]},{"verse":28,"text":"これはガドびとが、その家族,かぞくにしたがって獲,えた嗣,し業,ぎょうであって、その町々,まちまちと村々,むらむらとを含,ふくむ。","tok":[["これ"],["は"],["ガド"],["びと"],["が"],["、"],["その"],["家族","かぞく"],["に"],["したがって"],["獲た","えた"],["嗣業","しぎょ"],["うで"],["あって"],["、"],["その"],["町々","まちまち"],["と"],["村々","むらむら"],["と"],["を"],["含","ふくむ"],["。"]]},{"verse":29,"text":"モーセはまたマナセの半,はん部族,ぶぞくにも、嗣,し業,ぎょうを与,あたえたが、それはマナセの半,はん部族,ぶぞくが、その家族,かぞくにしたがって与,あたえられたものである。","tok":[["モーセ"],["は"],["また"],["マナセ"],["の"],["半","はん"],["部族","ぶぞく"],["に"],["も"],["、"],["嗣業","しぎょう"],["を"],["与えた","あたえた"],["が"],["、"],["それ"],["は"],["マナセ"],["の"],["半","はん"],["部族","ぶぞく"],["が"],["、"],["その"],["家族","かぞく"],["に"],["したがって"],["与えられた","あたえられた"],["もの"],["で"],["ある"],["。"]]},{"verse":30,"text":"その領域,りょういきはマハナイムからバシャンの全土,ぜんどに及,および、バシャンの王,おうオグの全国,ぜんこく、バシャンにあるヤイルのすべての町々,まちまち、すなわちその六十の町,まち。","tok":[["その"],["領域","りょういき"],["は"],["マハナイム"],["から"],["バシャン"],["の"],["全土","ぜんど"],["に"],["及","および"],["、"],["バシャン"],["の"],["王","おう"],["オグ"],["の"],["全国","ぜんこく"],["、"],["バシャン"],["に"],["ある"],["ヤイル"],["の"],["すべて"],["の"],["町々","まちまち"],["、"],["すなわち"],["その"],["六十","ろくじゅう"],["の"],["町","まち"],["。"]]},{"verse":31,"text":"またギレアデの半,なかば、バシャンのオグの国,くにの町,まちであるアシタロテとエデレイ。これらはマナセの子,こマキルの子孫,しそんに与,あたえられた。すなわちマキルの子孫,しそんの半,なかばが、その家族,かぞくにしたがって、それを獲,えた。","tok":[["また"],["ギレアデ"],["の"],["半ば","なかば"],["、"],["バシャン"],["の"],["オグ"],["の"],["国","くに"],["の"],["町","まち"],["で"],["ある"],["アシタロテ"],["と"],["エデレイ"],["。"],["これ"],["ら"],["は"],["マナセ"],["の"],["子","こ"],["マキル"],["の"],["子孫","しそん"],["に"],["与えられた","あたえられた"],["。"],["すなわち"],["マキル"],["の"],["子孫","しそん"],["の"],["半ば","なかば"],["が"],["、"],["その"],["家族","かぞく"],["に"],["したがって"],["、"],["それ"],["を"],["獲た","えた"],["。"]]},{"verse":32,"text":"これらはヨルダンの向,むこう側,がわ、エリコの東,ひがしのモアブの平野,へいやで、モーセが分,わけ与,あたえた嗣,し業,ぎょうである。","tok":[["これ"],["ら"],["は"],["ヨルダン"],["の"],["向こう側","むこうがわ"],["、"],["エリコ"],["の"],["東","ひがし"],["の"],["モアブ"],["の"],["平野","へいや"],["で"],["、"],["モーセ"],["が"],["分け","わけ"],["与","あたえ"],["た"],["嗣業","しぎょ"],["うで"],["ある"],["。"]]},{"verse":33,"text":"ただし、レビの部族,ぶぞくには、モーセはなんの嗣,し業,ぎょうをも与,あたえなかった。イスラエルの神,かみ、主,しゅがその嗣,し業,ぎょうだからである。主,しゅがモーセに言,いわれたとおりである。","tok":[["ただし"],["、"],["レビ"],["の"],["部族","ぶぞく"],["に"],["は"],["、"],["モーセ"],["は"],["なん"],["の"],["嗣業","しぎょう"],["を"],["も"],["与えなかった","あたえなかった"],["。"],["イスラエル"],["の"],["神","かみ"],["、"],["主","しゅがそ"],["の"],["嗣業","しぎょうだか"],["ら"],["で"],["ある"],["。"],["主","しゅ"],["が"],["モーセ"],["に"],["言われた","いわれた"],["とおり"],["で"],["ある"],["。"]]}]
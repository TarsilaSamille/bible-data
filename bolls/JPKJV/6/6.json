[{"verse":1,"text":"さてエリコは、イスラエルの人々,ひとびとのゆえに、かたく閉,とざして、出入,でいりするものがなかった。","tok":[["さて"],["エリコ"],["は"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["ゆえ"],["に"],["、"],["かたく"],["閉ざして","とざして"],["、"],["出入","でいり"],["する"],["もの"],["が"],["なかった"],["。"]]},{"verse":2,"text":"主,しゅはヨシュアに言,いわれた、「見,みよ、わたしはエリコと、その王,おうおよび大,だい勇士,ゆうしを、あなたの手,てにわたしている。","tok":[["主","しゅ"],["は"],["ヨシュア"],["に"],["言われた","いわれた"],["、"],["「"],["見よ","みよ"],["、"],["わたし"],["は"],["エリコ"],["と"],["、"],["その"],["王","おう"],["および"],["大","だい"],["勇士","ゆうし"],["を"],["、"],["あなた"],["の"],["手","て"],["に"],["わたして"],["いる"],["。"]]},{"verse":3,"text":"あなたがた、いくさびとはみな、町,まちを巡,めぐって、町,まちの周囲,しゅういを一度,ど回,まわらなければならない。六日,むいかの間,あいだそのようにしなければならない。","tok":[["あなた"],["がた"],["、"],["いく"],["さび"],["と"],["は"],["みな"],["、"],["町","まち"],["を"],["巡って","めぐって"],["、"],["町","まち"],["の"],["周囲","しゅうい"],["を"],["一度","ど"],["回わらなければ","まわらなければ"],["ならない"],["。"],["六日","むいか"],["の"],["間","あいだ"],["その"],["よう"],["に"],["しなければ"],["ならない"],["。"]]},{"verse":4,"text":"七人,にんの祭司,さいしたちは、おのおの雄羊,おひつじの角,つののラッパを携,たずさえて、箱,はこに先立,さきだたなければならない。そして七日,なぬか目,めには七度,ど町,まちを巡,めぐり、祭司,さいしたちはラッパを吹,ふき鳴,ならさなければならない。","tok":[["七人","にん"],["の"],["祭司","さいし"],["たち"],["は"],["、"],["おのおの"],["雄羊","おひつじ"],["の"],["角","つ"],["の"],["の"],["ラッパ"],["を"],["携えて","たずさえて"],["、"],["箱","はこ"],["に"],["先立たなければ","さきだたなければ"],["ならない"],["。"],["そして"],["七日","な"],["ぬか目","ぬかめ"],["に"],["は"],["七","なな"],["度","ど"],["町","まち"],["を"],["巡り","めぐり"],["、"],["祭司","さいし"],["たち"],["は"],["ラッパ"],["を"],["吹","ふき"],["鳴らさなければ","ならさなければ"],["ならない"],["。"]]},{"verse":5,"text":"そして祭司,さいしたちが雄羊,おひつじの角,つのを長,ながく吹,ふき鳴,ならし、そのラッパの音,おとが、あなたがたに聞,きこえる時,とき、民,たみはみな大声,おおごえに呼,よばわり、叫,さけばなければならない。そうすれば、町,まちの周囲,しゅういの石,いしがきは、くずれ落,おち、民,たみはみなただちに進,すすんで、攻,せめ上,のぼることができる」。","tok":[["そして"],["祭司","さいし"],["たち"],["が"],["雄羊","おひつじ"],["の"],["角","つ"],["の"],["を"],["長く","ながく"],["吹鳴","ふきな"],["らし"],["、"],["その"],["ラッパ"],["の"],["音","おと"],["が"],["、"],["あなた"],["がた"],["に"],["聞こえる","きこえる"],["時","とき"],["、"],["民","たみ"],["は"],["みな"],["大声","おおごえ"],["に"],["呼ばわり","よばわり"],["、"],["叫けばなければ","さけばなければ"],["ならない"],["。"],["そう"],["すれば"],["、"],["町","まち"],["の"],["周囲","しゅうい"],["の"],["石がき","いしがき"],["は"],["、"],["くずれ"],["落","おち"],["、"],["民","たみ"],["は"],["みな"],["ただちに"],["進んで","すすんで"],["、"],["攻め上る","せめのぼる"],["こと"],["が"],["できる"],["」"],["。"]]},{"verse":6,"text":"ヌンの子,こヨシュアは祭司,さいしたちを召,めして言,いった、「あなたがたは契約,けいやくの箱,はこをかき、七人,にんの祭司,さいしたちは雄羊,おひつじの角,つののラッパ七本,ほんを携,たずさえて、主,しゅの箱,はこに先立,さきだたなければならない」。","tok":[["ヌン"],["の"],["子","こ"],["ヨシュア"],["は"],["祭司","さいし"],["たち"],["を"],["召","めし"],["て"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["契約","けいやく"],["の"],["箱","はこ"],["を"],["かき"],["、"],["七人","にん"],["の"],["祭司","さいし"],["たち"],["は"],["雄羊","おひつじ"],["の"],["角","つ"],["の"],["の"],["ラッパ"],["七本","ほん"],["を"],["携えて","たずさえて"],["、"],["主","しゅ"],["の"],["箱","はこ"],["に"],["先立たなければ","さきだたなければ"],["ならない"],["」"],["。"]]},{"verse":7,"text":"そして民,たみに言,いった、「あなたがたは進,すすんで行,いって町,まちを巡,めぐりなさい。武装,ぶそうした者,ものは主,しゅの箱,はこに先立,さきだって進,すすまなければならない」。","tok":[["そして"],["民","たみ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["進んで","すすんで"],["行って","いって"],["町","まち"],["を"],["巡り","めぐり"],["なさい"],["。"],["武装","ぶそう"],["した"],["者","もの"],["は"],["主","しゅ"],["の"],["箱","はこ"],["に"],["先立って","さきだって"],["進まなければ","すすまなければ"],["ならない"],["」"],["。"]]},{"verse":8,"text":"ヨシュアが民,たみに命,めいじたように、七人,にんの祭司,さいしたちは、雄羊,おひつじの角,つののラッパ七本,ほんを携,たずさえて、主,しゅに先立,さきだって進,すすみ、ラッパを吹,ふき鳴,ならした。主,しゅの契約,けいやくの箱,はこはそのあとに従,したがった。","tok":[["ヨシュア"],["が"],["民","たみ"],["に"],["命じた","めいじた"],["よう"],["に"],["、"],["七人","にん"],["の"],["祭司","さいし"],["たち"],["は"],["、"],["雄羊","おひつじ"],["の"],["角","つ"],["の"],["の"],["ラッパ"],["七本","ほん"],["を"],["携えて","たずさえて"],["、"],["主に","しゅに"],["先立って","さきだって"],["進み","すすみ"],["、"],["ラッパ"],["を"],["吹鳴","ふきな"],["らした"],["。"],["主","しゅ"],["の"],["契約","けいやく"],["の"],["箱","はこ"],["は"],["その"],["あと"],["に"],["従った","したがった"],["。"]]},{"verse":9,"text":"武装,ぶそうした者,ものはラッパを吹,ふき鳴,ならす祭司,さいしたちに先立,さきだって行,いき、しんがりは箱,はこに従,したがった。ラッパは絶,たえ間,まなく鳴,なり響,ひびいた。","tok":[["武装","ぶそう"],["した"],["者","もの"],["は"],["ラッパ"],["を"],["吹","ふき"],["鳴らす","ならす"],["祭司","さいし"],["たち"],["に"],["先立って","さきだって"],["行き","いき"],["、"],["しんがり"],["は"],["箱","はこ"],["に"],["従った","したがった"],["。"],["ラッパ"],["は"],["絶え間","たえま"],["なく"],["鳴り響いた","なりひびいた"],["。"]]},{"verse":10,"text":"しかし、ヨシュアは民,たみに命,めいじて言,いった、「あなたがたは呼,よばわってはならない。あなたがたの声,こえを聞,きこえさせてはならない。また口,くちから言葉,ことばを出,だしてはならない。ただ、わたしが呼,よばわれと命,めいじる日,ひに、あなたがたは呼,よばわらなければならない」。","tok":[["しかし"],["、"],["ヨシュア"],["は"],["民","たみ"],["に"],["命じて","めいじて"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["呼ばわって","よばわって"],["は"],["ならない"],["。"],["あなた"],["がた"],["の"],["声","こえ"],["を"],["聞こえさせて","きこえさせて"],["は"],["ならない"],["。"],["また"],["口","くち"],["から"],["言葉","ことば"],["を"],["出して","だして"],["は"],["ならない"],["。"],["ただ"],["、"],["わたし"],["が"],["呼ばわれ","よばわれ"],["と"],["命じる","めいじる"],["日","ひ"],["に"],["、"],["あなた"],["がた"],["は"],["呼ばわらなければ","よばわらなければ"],["ならない"],["」"],["。"]]},{"verse":11,"text":"こうして主,しゅの箱,はこを持,もって、町,まちを巡,めぐらせ、その周囲,しゅういを一度,ど回,まわらせた。人々,ひとびとは宿営,しゅくえいに帰,かえり、夜,よるを宿営,しゅくえいで過,すごした。","tok":[["こう"],["して"],["主","しゅ"],["の"],["箱","はこ"],["を"],["持って","もって"],["、"],["町","まち"],["を"],["巡らせ","めぐらせ"],["、"],["その"],["周囲","しゅうい"],["を"],["一度","ど"],["回わらせた","まわらせた"],["。"],["人々","ひとびと"],["は"],["宿営","しゅくえい"],["に"],["帰えり","かえり"],["、"],["夜","よる"],["を"],["宿営","しゅくえい"],["で"],["過ごした","すごした"],["。"]]},{"verse":12,"text":"翌朝,よくあさヨシュアは早,はやく起,おき、祭司,さいしたちは主,しゅの箱,はこをかき、","tok":[["翌朝","よくあさ"],["ヨシュア"],["は"],["早く","はやく"],["起き","おき"],["、"],["祭司","さいし"],["たち"],["は"],["主","しゅ"],["の"],["箱","はこ"],["を"],["かき"],["、"]]},{"verse":13,"text":"七人,にんの祭司,さいしたちは、雄羊,おひつじの角,つののラッパ七本,ほんを携,たずさえて、主,しゅの箱,はこに先立,さきだち、絶,たえず、ラッパを吹,ふき鳴,ならして進,すすみ、武装,ぶそうした者,ものはこれに先立,さきだって行,いき、しんがりは主,しゅの箱,はこに従,したがった。ラッパは絶,たえ間,まなく鳴,なり響,ひびいた。","tok":[["七人","にん"],["の"],["祭司","さいし"],["たち"],["は"],["、"],["雄羊","おひつじ"],["の"],["角","つ"],["の"],["の"],["ラッパ"],["七本","ほん"],["を"],["携えて","たずさえて"],["、"],["主","しゅ"],["の"],["箱","はこ"],["に"],["先立ち","さきだち"],["、"],["絶えず","たえず"],["、"],["ラッパ"],["を"],["吹鳴","ふきな"],["らして"],["進み","すすみ"],["、"],["武装","ぶそう"],["した"],["者","もの"],["は"],["これ"],["に"],["先立って","さきだって"],["行き","いき"],["、"],["しんがり"],["は"],["主","しゅ"],["の"],["箱","はこ"],["に"],["従った","したがった"],["。"],["ラッパ"],["は"],["絶え間","たえま"],["なく"],["鳴り響いた","なりひびいた"],["。"]]},{"verse":14,"text":"その次,つぎの日,ひにも、町,まちの周囲,しゅういを一度,ど巡,めぐって宿営,しゅくえいに帰,かえった。六日,むいかの間,あいだそのようにした。","tok":[["その"],["次","つぎ"],["の"],["日","ひ"],["に"],["も"],["、"],["町","まち"],["の"],["周囲","しゅうい"],["を"],["一度","ど"],["巡って","めぐって"],["宿営","しゅくえい"],["に"],["帰えった","かえった"],["。"],["六日","むいか"],["の"],["間","あいだ"],["その"],["よう"],["に"],["した"],["。"]]},{"verse":15,"text":"七日,なぬか目,めには、夜明,よあけに、早,はやく起,おき、同,おなじようにして、町,まちを七度,どめぐった。町,まちを七度,どめぐったのはこの日,ひだけであった。","tok":[["七日","な"],["ぬか目","ぬかめ"],["に"],["は"],["、"],["夜明","よあけ"],["に"],["、"],["早く","はやく"],["起き","おき"],["、"],["同じ","おなじ"],["よう"],["に"],["して"],["、"],["町","まち"],["を"],["七","しち"],["度","ど"],["めぐった"],["。"],["町","まち"],["を"],["七","しち"],["度","ど"],["の"],["は"],["この"],["日","ひ"],["だけ"],["で"],["あった"],["。"]]},{"verse":16,"text":"七度目,どめに、祭司,さいしたちがラッパを吹,ふいた時,とき、ヨシュアは民,たみに言,いった、「呼,よばわりなさい。主,しゅはこの町,まちをあなたがたに賜,たまわった。","tok":[["七度目","どめ"],["に"],["、"],["祭司","さいし"],["たち"],["が"],["ラッパ"],["を"],["吹いた","ふいた"],["時","とき"],["、"],["ヨシュア"],["は"],["民","たみ"],["に"],["言った","いった"],["、"],["「"],["呼ばわり","よばわり"],["なさい"],["。"],["主","しゅ"],["は"],["この"],["町","まち"],["を"],["あなた"],["がた"],["に"],["賜わった","たまわった"],["。"]]},{"verse":17,"text":"この町,まちと、その中,なかのすべてのものは、主,しゅへの奉納物,ほうのうぶつとして滅,ほろぼされなければならない。ただし遊女,ゆうじょラハブと、その家,いえに共,ともにおる者,ものはみな生,いかしておかなければならない。われわれが送,おくった使者,ししゃたちをかくまったからである。","tok":[["この"],["町","まち"],["と"],["、"],["その"],["中","なか"],["の"],["すべて"],["の"],["もの"],["は"],["、"],["主","しゅ"],["へ"],["の"],["奉納物","ほうのうぶつ"],["として"],["滅ぼされなければ","ほろぼされなければ"],["ならない"],["。"],["ただし"],["遊女","ゆうじょ"],["ラハブ"],["と"],["、"],["その"],["家","いえ"],["に"],["共","とも"],["に"],["おる"],["者","もの"],["は"],["みな"],["生かして","いかして"],["おかなければ"],["ならない"],["。"],["われわれ"],["が"],["送った","おくった"],["使者","ししゃ"],["たち"],["を"],["かくまった"],["から"],["で"],["ある"],["。"]]},{"verse":18,"text":"また、あなたがたは、奉納物,ほうのうぶつに手,てを触,ふれてはならない。奉納,ほうのうに当,あたり、その奉納物,ほうのうぶつをみずから取,とって、イスラエルの宿営,しゅくえいを、滅,ほろぼさるべきものとし、それを悩,なやますことのないためである。","tok":[["また"],["、"],["あなた"],["がた"],["は"],["、"],["奉納物","ほうのうぶつ"],["に"],["手","て"],["を"],["触","ふれ"],["ては"],["ならない"],["。"],["奉納","ほうのう"],["に"],["当たり","あたり"],["、"],["その"],["奉納物","ほうのうぶつ"],["を"],["みずから"],["取って","とって"],["、"],["イスラエル"],["の"],["宿営","しゅくえい"],["を"],["、"],["滅ぼさるべき","ほろぼさるべき"],["もの"],["と"],["し"],["、"],["それ"],["を"],["悩す","なやます"],["こと"],["の"],["ない"],["ため"],["で"],["ある"],["。"]]},{"verse":19,"text":"ただし、銀,ぎんと金,きん、青銅,せいどうと鉄,てつの器,うつわは、みな主,しゅに聖,せいなる物,ものであるから、主,しゅの倉,くらに携,たずさえ入,いれなければならない」。","tok":[["ただし"],["、"],["銀","ぎん"],["と"],["金","きん"],["、"],["青銅","せいどう"],["と"],["鉄","てつ"],["の"],["器","うつわ"],["は"],["、"],["みな"],["主に","しゅに"],["聖","せい"],["なる"],["物","もの"],["で"],["ある"],["から"],["、"],["主","しゅ"],["の"],["倉","くら"],["に"],["携え","たずさえ"],["入れなければ","いれなければ"],["ならない"],["」"],["。"]]},{"verse":20,"text":"そこで民,たみは呼,よばわり、祭司,さいしたちはラッパを吹,ふき鳴,ならした。民,たみはラッパの音,おとを聞,きくと同時,どうじに、みな大声,おおごえをあげて呼,よばわったので、石,いしがきはくずれ落,おちた。そこで民,たみはみな、すぐに上,のぼって町,まちにはいり、町,まちを攻,せめ取,とった。","tok":[["そこ"],["で"],["民","たみ"],["は"],["呼ばわり","よばわり"],["、"],["祭司","さいし"],["たち"],["は"],["ラッパ"],["を"],["吹鳴","ふきな"],["らした"],["。"],["民","たみ"],["は"],["ラッパ"],["の"],["音","おと"],["を"],["聞く","きく"],["と"],["同時","どうじ"],["に"],["、"],["みな"],["大声","おおごえ"],["を"],["あげて"],["呼ばわった","よばわった"],["ので"],["、"],["石がき","いしがき"],["は"],["くずれ"],["落","おち"],["た"],["。"],["そこ"],["で"],["民","たみ"],["は"],["みな"],["、"],["すぐ"],["に"],["上って","のぼって"],["町","まち"],["に"],["はいり"],["、"],["町","まち"],["を"],["攻め取った","せめとった"],["。"]]},{"verse":21,"text":"そして町,まちにあるものは、男,おとこも、女,おんなも、若,わかい者,ものも、老,おいた者,ものも、また牛,うし、羊,ひつじ、ろばをも、ことごとくつるぎにかけて滅,ほろぼした。","tok":[["そして"],["町","まち"],["に"],["ある"],["もの"],["は"],["、"],["男","おとこ"],["も"],["、"],["女","おんな"],["も"],["、"],["若い","わかい"],["者","もの"],["も"],["、"],["老","おい"],["た"],["者","もの"],["も"],["、"],["また"],["牛","うし"],["、"],["羊","ひつじ"],["、"],["ろば"],["を"],["も"],["、"],["ことごとく"],["つるぎ"],["に"],["かけて"],["滅ぼした","ほろぼした"],["。"]]},{"verse":22,"text":"その時,ときヨシュアは、この地,ちを探,さぐったふたりの人,ひとに言,いった、「あの遊女,ゆうじょの家,いえにはいって、その女,おんなと彼女,かのじょに属,ぞくするすべてのものを連,つれ出,だし、彼女,かのじょに誓,ちかったようにしなさい」。","tok":[["その"],["時","とき"],["ヨシュア"],["は"],["、"],["この"],["地","ち"],["を"],["探った","さぐった"],["ふたり"],["の"],["人","ひと"],["に"],["言った","いった"],["、"],["「"],["あの"],["遊女","ゆうじょ"],["の"],["家","いえ"],["に"],["はいって"],["、"],["その"],["女","おんな"],["と"],["彼女","かのじょ"],["に"],["属する","ぞくする"],["すべて"],["の"],["もの"],["を"],["連れ出し","つれだし"],["、"],["彼女","かのじょ"],["に"],["誓った","ちかった"],["よう"],["に"],["し"],["なさい"],["」"],["。"]]},{"verse":23,"text":"斥候,せっこうとなったその若,わかい人,ひとたちははいって、ラハブとその父母,ふぼ、兄弟,きょうだい、そのほか彼女,かのじょに属,ぞくするすべてのものを連,つれ出,だし、その親族,しんぞくをみな連,つれ出,だして、イスラエルの宿営,しゅくえいの外,そとに置,おいた。","tok":[["斥候","せっこう"],["と"],["なった"],["その"],["若い","わかい"],["人","ひと"],["たち"],["は"],["はい"],["って"],["、"],["ラハブ"],["と"],["その"],["父母","ふぼ"],["、"],["兄弟","きょうだい"],["、"],["その"],["ほか"],["彼女","かのじょ"],["に"],["属する","ぞくする"],["すべて"],["の"],["もの"],["を"],["連れ出し","つれだし"],["、"],["その"],["親族","しんぞく"],["を"],["みな"],["連れ出して","つれだして"],["、"],["イスラエル"],["の"],["宿営","しゅくえい"],["の"],["外","そと"],["に"],["置いた","おいた"],["。"]]},{"verse":24,"text":"そして火,ひで町,まちとその中,なかのすべてのものを焼,やいた。ただ、銀,ぎんと金,きん、青銅,せいどうと鉄,てつの器,うつわは、主,しゅの家,いえの倉,くらに納,おさめた。","tok":[["そして"],["火","ひ"],["で"],["町","まち"],["と"],["その"],["中","なか"],["の"],["すべて"],["の"],["もの"],["を"],["焼いた","やいた"],["。"],["ただ"],["、"],["銀","ぎん"],["と"],["金","きん"],["、"],["青銅","せいどう"],["と"],["鉄","てつ"],["の"],["器","うつわ"],["は"],["、"],["主","しゅ"],["の"],["家","いえ"],["の"],["倉","くら"],["に"],["納","おさめ"],["た"],["。"]]},{"verse":25,"text":"しかし、遊女,ゆうじょラハブとその父,ちちの家,いえの一族,いちぞくと彼女,かのじょに属,ぞくするすべてのものとは、ヨシュアが生,いかしておいたので、ラハブは今日,こんにちまでイスラエルのうちに住,すんでいる。これはヨシュアがエリコを探,さぐらせるためにつかわした使者,ししゃたちをかくまったためである。","tok":[["しかし"],["、"],["遊女","ゆうじょ"],["ラハブ"],["と"],["その"],["父","ちち"],["の"],["家","いえ"],["の"],["一族","いちぞく"],["と"],["彼女","かのじょ"],["に"],["属する","ぞくする"],["すべて"],["の"],["もの"],["と"],["は"],["、"],["ヨシュア"],["が"],["生かして","いかして"],["おいた"],["ので"],["、"],["ラハブ"],["は"],["今日","こん"],["に"],["ち"],["まで"],["イスラエル"],["の"],["うち"],["に"],["住んで","すんで"],["いる"],["。"],["これ"],["は"],["ヨシュア"],["が"],["エリコ"],["を"],["探ぐらせる","さぐらせる"],["ため"],["に"],["つかわした"],["使者","ししゃ"],["たち"],["を"],["かくまった"],["ため"],["で"],["ある"],["。"]]},{"verse":26,"text":"ヨシュアは、その時,とき、人々,ひとびとに誓,ちかいを立,たてて言,いった、「おおよそ立,たって、このエリコの町,まちを再建,さいけんする人,ひとは、主,しゅの前,まえにのろわれるであろう。その礎,いしずえをすえる人,ひとは長子,ちょうしを失,うしない、その門,もんを建,たてる人,ひとは末,すえの子,こを失,うしなうであろう」。","tok":[["ヨシュア"],["は"],["、"],["その"],["時","とき"],["、"],["人々","ひとびと"],["に"],["誓い","ちかい"],["を"],["立てて","たてて"],["言った","いった"],["、"],["「"],["おおよそ"],["立って","たって"],["、"],["この"],["エリコ"],["の"],["町","まち"],["を"],["再建","さいけん"],["する"],["人","ひと"],["は"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["のろわれるで"],["あろう"],["。"],["その"],["礎","いしずえ"],["を"],["すえる"],["人","ひと"],["は"],["長子","ちょうし"],["を"],["失ない","うしない"],["、"],["その"],["門","もん"],["を"],["建てる","たてる"],["人","ひと"],["は"],["末","すえ"],["の"],["子","こ"],["を"],["失なうで","うしなうで"],["あろう"],["」"],["。"]]},{"verse":27,"text":"主,しゅはヨシュアと共,ともにおられ、ヨシュアの名声,めいせいは、あまねくその地,ちに広,ひろがった。","tok":[["主","しゅ"],["は"],["ヨシュア"],["と"],["共","とも"],["に"],["おられ"],["、"],["ヨシュア"],["の"],["名声","めいせい"],["は"],["、"],["あまねく"],["その"],["地","ち"],["に"],["広がった","ひろがった"],["。"]]}]
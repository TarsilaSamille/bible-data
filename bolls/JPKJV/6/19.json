[{"verse":1,"text":"次,つぎにシメオンのため、すなわちシメオンの子孫,しそんの部族,ぶぞくのために、その家族,かぞくにしたがって、くじを引,ひいた。その嗣,し業,ぎょうはユダの子孫,しそんの嗣,し業,ぎょうのうちにあった。","tok":[["次","つぎ"],["に"],["シメオン"],["の"],["ため"],["、"],["すなわち"],["シメオン"],["の"],["子孫","しそん"],["の"],["部族","ぶぞく"],["の"],["ため"],["に"],["、"],["その"],["家族","かぞく"],["に"],["したがって"],["、"],["くじ"],["を"],["引いた","ひいた"],["。"],["その"],["嗣業","しぎょう"],["は"],["ユダ"],["の"],["子孫","しそん"],["の"],["嗣業","しぎょう"],["の"],["うち"],["に"],["あった"],["。"]]},{"verse":2,"text":"その嗣,し業,ぎょうとして獲,えたものは、ベエルシバ、すなわちシバ、モラダ、","tok":[["その"],["嗣業","しぎょう"],["として"],["獲た","えた"],["もの"],["は"],["、"],["ベエルシバ"],["、"],["すなわち"],["シバ"],["、"],["モラダ"],["、"]]},{"verse":3,"text":"ハザル・シュアル、バラ、エゼム、","tok":[["ハザル"],["・"],["シュアル"],["、"],["バラ"],["、"],["エゼム"],["、"]]},{"verse":4,"text":"エルトラデ、ベトル、ホルマ、","tok":[["エルトラデ"],["、"],["ベトル"],["、"],["ホルマ"],["、"]]},{"verse":5,"text":"チクラグ、ベテ・マルカボテ、ハザルスサ、","tok":[["チクラグ"],["、"],["ベテ"],["・"],["マルカボテ"],["、"],["ハザルスサ"],["、"]]},{"verse":6,"text":"ベテレバオテ、シャルヘン。すなわち十三の町々,まちまちと、それに属,ぞくする村々,むらむら。","tok":[["ベテレバオテ"],["、"],["シャルヘン"],["。"],["すなわち"],["十三","じゅうさん"],["の"],["町々","まちまち"],["と"],["、"],["それ"],["に"],["属する","ぞくする"],["村々","むらむら"],["。"]]},{"verse":7,"text":"またアイン、リンモン、エテル、アシャン。すなわち四つの町々,まちまちと、それに属,ぞくする村々,むらむら。","tok":[["また"],["アイン"],["、"],["リンモン"],["、"],["エテル"],["、"],["アシャン"],["。"],["すなわち"],["四","よん"],["つ"],["の"],["町々","まちまち"],["と"],["、"],["それ"],["に"],["属する","ぞくする"],["村々","むらむら"],["。"]]},{"verse":8,"text":"およびこれらの町,まちの周囲,しゅういにあって、バアラテ・ベエル、すなわちネゲブのラマに至,いたるまでのすべての村々,むらむら。これがシメオンの子孫,しそんの部族,ぶぞくの、その家族,かぞくにしたがって獲,えた嗣,し業,ぎょうである。","tok":[["および"],["これ"],["ら"],["の"],["町","まち"],["の"],["周囲","しゅうい"],["に"],["あって"],["、"],["バアラテ"],["・"],["ベエル"],["、"],["すなわち"],["ネゲブ"],["の"],["ラマ"],["に"],["至る","いたる"],["まで"],["の"],["すべて"],["の"],["村々","むらむら"],["。"],["これ"],["が"],["シメオン"],["の"],["子孫","しそん"],["の"],["部族","ぶぞく"],["の"],["、"],["その"],["家族","かぞく"],["に"],["したがって"],["獲た","えた"],["嗣業","しぎょ"],["うで"],["ある"],["。"]]},{"verse":9,"text":"シメオンの子孫,しそんの嗣,し業,ぎょうは、ユダの子孫,しそんの領域,りょういきのうちにあった。これはユダの子孫,しそんの分,ぶんが大,おおきかったので、シメオンの子孫,しそんが、その嗣,し業,ぎょうを彼,かれらの嗣,し業,ぎょうの中,なかに獲,えたからである。","tok":[["シメオン"],["の"],["子孫","しそん"],["の"],["嗣業","しぎょう"],["は"],["、"],["ユダ"],["の"],["子孫","しそん"],["の"],["領域","りょういき"],["の"],["うち"],["に"],["あった"],["。"],["これ"],["は"],["ユダ"],["の"],["子孫","しそん"],["の"],["分","ぶん"],["が"],["大きかった","おおきかった"],["ので"],["、"],["シメオン"],["の"],["子孫","しそん"],["が"],["、"],["その"],["嗣業","しぎょう"],["を"],["彼","かれ"],["ら"],["の"],["嗣業","しぎょう"],["の"],["中","なか"],["に"],["獲た","えた"],["から"],["で"],["ある"],["。"]]},{"verse":10,"text":"第,だい三にゼブルンの子孫,しそんのために、その家族,かぞくにしたがって、くじを引,ひいた。その嗣,し業,ぎょうの領域,りょういきはサリデに及,および、","tok":[["第","だい"],["三","さん"],["に"],["ゼブルン"],["の"],["子孫","しそん"],["の"],["ため"],["に"],["、"],["その"],["家族","かぞく"],["に"],["したがって"],["、"],["くじ"],["を"],["引いた","ひいた"],["。"],["その"],["嗣業","しぎょう"],["の"],["領域","りょういき"],["は"],["サリデ"],["に"],["及","および"],["、"]]},{"verse":11,"text":"その境,さかいは西,にしに上,のぼって、マララに至,いたり、ダバセテに達,たっし、ヨクネアムの東,ひがしにある川,かわに達,たっし、","tok":[["その"],["境","さかい"],["は"],["西","にし"],["に"],["上って","のぼって"],["、"],["マララ"],["に"],["至","いたり"],["、"],["ダバセテ"],["に"],["達し","たっし"],["、"],["ヨクネアム"],["の"],["東","ひがし"],["に"],["ある"],["川","かわ"],["に"],["達し","たっし"],["、"]]},{"verse":12,"text":"サリデから、東,ひがしの方,ほう、日,ひの出,での方,ほうに曲,まがり、キスロテ・タボルの境,さかいに至,いたり、ダベラテに出,でて、ヤピアに上,のぼり、","tok":[["サリデ"],["から"],["、"],["東","ひがし"],["の"],["方","ほう"],["、"],["日の出","ひので"],["の"],["方","ほう"],["に"],["曲がり","まがり"],["、"],["キスロテ"],["・"],["タボル"],["の"],["境","さかい"],["に"],["至","いたり"],["、"],["ダベラテ"],["に"],["出て","でて"],["、"],["ヤピア"],["に"],["上り","のぼり"],["、"]]},{"verse":13,"text":"そこから東,ひがしの方,ほう、日,ひの出,での方,ほうに進,すすんで、ガテヘペルとイッタ・カジンに至,いたり、リンモンに進,すすんで、ネアの方,ほうに曲,まがる。","tok":[["そこ"],["から"],["東","ひがし"],["の"],["方","ほう"],["、"],["日の出","ひので"],["の"],["方","ほう"],["に"],["進んで","すすんで"],["、"],["ガテヘペル"],["と"],["イッタ"],["・"],["カジン"],["に"],["至","いたり"],["、"],["リンモン"],["に"],["進んで","すすんで"],["、"],["ネア"],["の"],["方","ほう"],["に"],["曲がる","まがる"],["。"]]},{"verse":14,"text":"北,きたではその境,さかいはハンナトンに回,まわり、イフタエルの谷,たにに至,いたって尽,つきる。","tok":[["北","きた"],["で"],["は"],["その"],["境","さかい"],["は"],["ハンナトン"],["に"],["回わり","まわり"],["、"],["イフタエル"],["の"],["谷","たに"],["に"],["至って","いたって"],["尽る","つきる"],["。"]]},{"verse":15,"text":"そしてカッタテ、ナハラル、シムロン、イダラ、ベツレヘムなど十二の町々,まちまちと、それに属,ぞくする村々,むらむらがあった。","tok":[["そして"],["カッタテ"],["、"],["ナハラル"],["、"],["シムロン"],["、"],["イダラ"],["、"],["ベツレヘム"],["など"],["十二","じゅうに"],["の"],["町々","まちまち"],["と"],["、"],["それ"],["に"],["属する","ぞくする"],["村々","むらむら"],["が"],["あった"],["。"]]},{"verse":16,"text":"これがゼブルンの子孫,しそんの、その家族,かぞくにしたがって獲,えた嗣,し業,ぎょうであって、その町々,まちまちと、それに属,ぞくする村々,むらむらとである。","tok":[["これ"],["が"],["ゼブルン"],["の"],["子孫","しそん"],["の"],["、"],["その"],["家族","かぞく"],["に"],["したがって"],["獲た","えた"],["嗣業","しぎょ"],["うで"],["あって"],["、"],["その"],["町々","まちまち"],["と"],["、"],["それ"],["に"],["属する","ぞくする"],["村々","むらむら"],["と"],["で"],["ある"],["。"]]},{"verse":17,"text":"第,だい四にイッサカル、すなわちイッサカルの子孫,しそんのために、その家族,かぞくにしたがって、くじを引,ひいた。","tok":[["第","だい"],["四","よん"],["に"],["イッサカル"],["、"],["すなわち"],["イッサカル"],["の"],["子孫","しそん"],["の"],["ため"],["に"],["、"],["その"],["家族","かぞく"],["に"],["したがって"],["、"],["くじ"],["を"],["引いた","ひいた"],["。"]]},{"verse":18,"text":"その領域,りょういきには、エズレル、ケスロテ、シュネム、","tok":[["その"],["領域","りょういき"],["に"],["は"],["、"],["エズレル"],["、"],["ケスロテ"],["、"],["シュネム"],["、"]]},{"verse":19,"text":"ハパライム、シオン、アナハラテ、","tok":[["ハパライム"],["、"],["シオン"],["、"],["アナハラテ"],["、"]]},{"verse":20,"text":"ラビテ、キション、エベツ、","tok":[["ラビテ"],["、"],["キション"],["、"],["エベツ"],["、"]]},{"verse":21,"text":"レメテ、エンガンニム、エンハダ、ベテパッゼズがあり、","tok":[["レメテ"],["、"],["エンガンニム"],["、"],["エンハダ"],["、"],["ベテパッゼズ"],["が"],["あり"],["、"]]},{"verse":22,"text":"その境,さかいはタボル、シャハヂマ、ベテシメシに達,たっし、その境,さかいはヨルダンに至,いたって尽,つきる。十六の町々,まちまちと、それに属,ぞくする村々,むらむらがあった。","tok":[["その"],["境","さかい"],["は"],["タボル"],["、"],["シャハヂマ"],["、"],["ベテシメシ"],["に"],["達し","たっし"],["、"],["その"],["境","さかい"],["は"],["ヨルダン"],["に"],["至って","いたって"],["尽る","つきる"],["。"],["十六","じゅうろく"],["の"],["町々","まちまち"],["と"],["、"],["それ"],["に"],["属する","ぞくする"],["村々","むらむら"],["が"],["あった"],["。"]]},{"verse":23,"text":"これがイッサカルの子孫,しそんの部族,ぶぞくの、その家族,かぞくにしたがって獲,えた嗣,し業,ぎょうであって、その町々,まちまちと、それに属,ぞくする村々,むらむらとである。","tok":[["これ"],["が"],["イッサカル"],["の"],["子孫","しそん"],["の"],["部族","ぶぞく"],["の"],["、"],["その"],["家族","かぞく"],["に"],["したがって"],["獲た","えた"],["嗣業","しぎょ"],["うで"],["あって"],["、"],["その"],["町々","まちまち"],["と"],["、"],["それ"],["に"],["属する","ぞくする"],["村々","むらむら"],["と"],["で"],["ある"],["。"]]},{"verse":24,"text":"第,だい五に、アセルの子孫,しそんの部族,ぶぞくのために、その家族,かぞくにしたがって、くじを引,ひいた。","tok":[["第","だい"],["五","ご"],["に"],["、"],["アセル"],["の"],["子孫","しそん"],["の"],["部族","ぶぞく"],["の"],["ため"],["に"],["、"],["その"],["家族","かぞく"],["に"],["したがって"],["、"],["くじ"],["を"],["引いた","ひいた"],["。"]]},{"verse":25,"text":"その領域,りょういきには、ヘルカテ、ハリ、ベテン、アクサフ、","tok":[["その"],["領域","りょういき"],["に"],["は"],["、"],["ヘルカテ"],["、"],["ハリ"],["、"],["ベテン"],["、"],["アクサフ"],["、"]]},{"verse":26,"text":"アランメレク、アマデ、ミシャルがあり、その境,さかいは西,にしでは、カルメルとシホル・リブナテに達,たっし、","tok":[["アランメレク"],["、"],["アマデ"],["、"],["ミシャル"],["が"],["あり"],["、"],["その"],["境","さかい"],["は"],["西","にし"],["で"],["は"],["、"],["カルメル"],["と"],["シホル"],["・"],["リブナテ"],["に"],["達し","たっし"],["、"]]},{"verse":27,"text":"それから東,ひがしに折,おれて、ベテダゴンに至,いたり、北,きたの方,ほうゼブルンと、イプタエルの谷,たにに達,たっし、ベテエメクおよびネイエルに至,いたり、北,きたはカブルにいで、","tok":[["それ"],["から"],["東","ひがし"],["に"],["折れて","おれて"],["、"],["ベテダゴン"],["に"],["至","いたり"],["、"],["北","きた"],["の"],["方","ほう"],["ゼブルン"],["と"],["、"],["イプタエル"],["の"],["谷","たに"],["に"],["達し","たっし"],["、"],["ベテエメク"],["および"],["ネイエル"],["に"],["至","いたり"],["、"],["北","きた"],["は"],["カブル"],["に"],["いで"],["、"]]},{"verse":28,"text":"更,さらにエブロン、レホブ、ハンモン、カナを経,へて、大,だいシドンに及,および、","tok":[["更に","さらに"],["エブロン"],["、"],["レホブ"],["、"],["ハンモン"],["、"],["カナ"],["を"],["経て","へて"],["、"],["大","だい"],["シドン"],["に"],["及","および"],["、"]]},{"verse":29,"text":"それから、その境,さかいはラマに曲,まがり、堅固,けんごな町,まちツロに至,いたる。またその境,さかいはホサに曲,まがり、海,うみに至,いたって尽,つきる。そして、マハラブ、アクジブ、","tok":[["それ"],["から"],["、"],["その"],["境","さかい"],["は"],["ラマ"],["に"],["曲がり","まがり"],["、"],["堅固","けんご"],["な"],["町","まち"],["ツロ"],["に"],["至る","いたる"],["。"],["また"],["その"],["境","さかい"],["は"],["ホサ"],["に"],["曲がり","まがり"],["、"],["海","うみ"],["に"],["至って","いたって"],["尽る","つきる"],["。"],["そして"],["、"],["マハラブ"],["、"],["アクジブ"],["、"]]},{"verse":30,"text":"ウンマ、アペク、レホブなど、二十二の町々,まちまちと、それに属,ぞくする村々,むらむらがあった。","tok":[["ウンマ"],["、"],["アペク"],["、"],["レホブ"],["など"],["、"],["二十二","じそじ"],["の"],["町々","まちまち"],["と"],["、"],["それ"],["に"],["属する","ぞくする"],["村々","むらむら"],["が"],["あった"],["。"]]},{"verse":31,"text":"これがアセルの子孫,しそんの部族,ぶぞくの、その家族,かぞくにしたがって獲,えた嗣,し業,ぎょうであって、その町々,まちまちと、それに属,ぞくする村々,むらむらとである。","tok":[["これ"],["が"],["アセル"],["の"],["子孫","しそん"],["の"],["部族","ぶぞく"],["の"],["、"],["その"],["家族","かぞく"],["に"],["したがって"],["獲た","えた"],["嗣業","しぎょ"],["うで"],["あって"],["、"],["その"],["町々","まちまち"],["と"],["、"],["それ"],["に"],["属する","ぞくする"],["村々","むらむら"],["と"],["で"],["ある"],["。"]]},{"verse":32,"text":"第,だい六に、ナフタリの子孫,しそんのために、その家族,かぞくにしたがって、くじを引,ひいた。","tok":[["第六","だい六"],["に"],["、"],["ナフタリ"],["の"],["子孫","しそん"],["の"],["ため"],["に"],["、"],["その"],["家族","かぞく"],["に"],["したがって"],["、"],["くじ"],["を"],["引いた","ひいた"],["。"]]},{"verse":33,"text":"その境,さかいはヘレフから、すなわちザアナニイムのかしの木,きから起,おこり、アダミ・ネケブおよび、ヤブネルを経,へて、ラクムに至,いたり、ヨルダンに至,いたって尽,つきる。","tok":[["その"],["境","さかい"],["は"],["ヘレフ"],["から"],["、"],["すなわち"],["ザアナニイム"],["の"],["かし"],["の"],["木","き"],["から"],["起こり","おこり"],["、"],["アダミ"],["・"],["ネケブ"],["および"],["、"],["ヤブネル"],["を"],["経て","へて"],["、"],["ラクム"],["に"],["至","いたり"],["、"],["ヨルダン"],["に"],["至って","いたって"],["尽る","つきる"],["。"]]},{"verse":34,"text":"そしてその境,さかいは西,にしに向,むかって、アズノテ・タボルに至,いたり、そこからホッコクに出,でる。南,みなみはゼブルンに接,せっし、西,にしはアセルに接,せっし、東,ひがしはヨルダンのユダに達,たっする。","tok":[["そして"],["その"],["境","さかい"],["は"],["西","にし"],["に"],["向かって","むかって"],["、"],["アズノテ"],["・"],["タボル"],["に"],["至","いたり"],["、"],["そこ"],["から"],["ホッコク"],["に"],["出る","でる"],["。"],["南","みなみ"],["は"],["ゼブルン"],["に"],["接し","せっし"],["、"],["西","にし"],["は"],["アセル"],["に"],["接し","せっし"],["、"],["東","ひがし"],["は"],["ヨルダン"],["の"],["ユダ"],["に"],["達する","たっする"],["。"]]},{"verse":35,"text":"その堅固,けんごな町々,まちまちは、ヂデム、ゼル、ハンマテ、ラッカテ、キンネレテ、","tok":[["その"],["堅固","けんご"],["な"],["町々","まちまち"],["は"],["、"],["ヂデム"],["、"],["ゼル"],["、"],["ハンマテ"],["、"],["ラッカテ"],["、"],["キンネレテ"],["、"]]},{"verse":36,"text":"アダマ、ラマ、ハゾル、","tok":[["アダマ"],["、"],["ラマ"],["、"],["ハゾル"],["、"]]},{"verse":37,"text":"ケデシ、エデレイ、エンハゾル、","tok":[["ケデシ"],["、"],["エデレイ"],["、"],["エンハゾル"],["、"]]},{"verse":38,"text":"イロン、ミグダルエル、ホレム、ベテアナテ、ベテシメシなどで、十九の町々,まちまちと、それに属,ぞくする村々,むらむらがあった。","tok":[["イロン"],["、"],["ミグダルエル"],["、"],["ホレム"],["、"],["ベテアナテ"],["、"],["ベテシメシ"],["など"],["で"],["、"],["十九","じゅうきゅう"],["の"],["町々","まちまち"],["と"],["、"],["それ"],["に"],["属する","ぞくする"],["村々","むらむら"],["が"],["あった"],["。"]]},{"verse":39,"text":"これがナフタリの子孫,しそんの部族,ぶぞくが、その家族,かぞくにしたがって獲,えた嗣,し業,ぎょうであって、その町々,まちまちと、それに属,ぞくする村々,むらむらとである。","tok":[["これ"],["が"],["ナフタリ"],["の"],["子孫","しそん"],["の"],["部族","ぶぞく"],["が"],["、"],["その"],["家族","かぞく"],["に"],["したがって"],["獲た","えた"],["嗣業","しぎょ"],["うで"],["あって"],["、"],["その"],["町々","まちまち"],["と"],["、"],["それ"],["に"],["属する","ぞくする"],["村々","むらむら"],["と"],["で"],["ある"],["。"]]},{"verse":40,"text":"第,だい七に、ダンの子孫,しそんの部族,ぶぞくのために、その家族,かぞくにしたがって、くじを引,ひいた。","tok":[["第","だい"],["七","なな"],["に"],["、"],["ダン"],["の"],["子孫","しそん"],["の"],["部族","ぶぞく"],["の"],["ため"],["に"],["、"],["その"],["家族","かぞく"],["に"],["したがって"],["、"],["くじ"],["を"],["引いた","ひいた"],["。"]]},{"verse":41,"text":"その嗣,し業,ぎょうの領域,りょういきには、ゾラ、エシタオル、イルシメシ、","tok":[["その"],["嗣業","しぎょう"],["の"],["領域","りょういき"],["に"],["は"],["、"],["ゾラ"],["、"],["エシタオル"],["、"],["イルシメシ"],["、"]]},{"verse":42,"text":"シャラビム、アヤロン、イテラ、","tok":[["シャラビム"],["、"],["アヤロン"],["、"],["イテラ"],["、"]]},{"verse":43,"text":"エロン、テムナ、エクロン、","tok":[["エロン"],["、"],["テムナ"],["、"],["エクロン"],["、"]]},{"verse":44,"text":"エルテケ、ギベトン、バアラテ、","tok":[["エルテケ"],["、"],["ギベトン"],["、"],["バアラテ"],["、"]]},{"verse":45,"text":"エホデ、ベネベラク、ガテリンモン、","tok":[["エホデ"],["、"],["ベネベラク"],["、"],["ガテリンモン"],["、"]]},{"verse":46,"text":"メヤルコン、ラッコン、およびヨッパと相対,あいたいする地域,ちいきがあった。","tok":[["メヤルコン"],["、"],["ラッコン"],["、"],["および"],["ヨッパ"],["と"],["相対","あ"],["いたい"],["する"],["地域","ちいき"],["が"],["あった"],["。"]]},{"verse":47,"text":"ただし、ダンの子孫,しそんの領域,りょういきは、彼,かれらのために小,ちいさかったので、ダンの子孫,しそんは、上,のぼって行,いき、レセムを攻,せめてそれを取,とり、つるぎにかけて撃,うち滅,ほろぼし、それを獲,えてそこに住,すみ、先祖,せんぞダンの名,なにしたがって、レセムをダンと名,なづけた。","tok":[["ただし"],["、"],["ダン"],["の"],["子孫","しそん"],["の"],["領域","りょういき"],["は"],["、"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["小さかった","ちいさかった"],["ので"],["、"],["ダン"],["の"],["子孫","しそん"],["は"],["、"],["上って","のぼって"],["行き","いき"],["、"],["レセム"],["を"],["攻め
[{"verse":1,"text":"主,しゅがイスラエルの周囲,しゅういの敵,てきを、ことごとく除,のぞいて、イスラエルに安息,あんそくを賜,たまわってのち、久,ひさしくたち、ヨシュアも年,としが進,すすんで老,おいた。","tok":[["主","しゅ"],["が"],["イスラエル"],["の"],["周囲","しゅうい"],["の"],["敵","てき"],["を"],["、"],["ことごとく"],["除いて","のぞいて"],["、"],["イスラエル"],["に"],["安息","あんそく"],["を"],["賜わって","たまわって"],["のち"],["、"],["久く","ひさしく"],["たち"],["、"],["ヨシュア"],["も"],["年","とし"],["が"],["進んで","すすんで"],["老","おい"],["た"],["。"]]},{"verse":2,"text":"ヨシュアはイスラエルのすべての人,ひと、その長老,ちょうろう、かしらたち、さばきびと、つかさびとたちを呼,よび集,あつめて言,いった、「わたしは年,ねんも進,すすんで老人,ろうじんとなった。","tok":[["ヨシュア"],["は"],["イスラエル"],["の"],["すべて"],["の"],["人","ひと"],["、"],["その"],["長老","ちょうろう"],["、"],["かしら"],["たち"],["、"],["さば"],["きび"],["と"],["、"],["つかさ"],["びと"],["たち"],["を"],["呼び集めて","よびあつめて"],["言った","いった"],["、"],["「"],["わたし"],["は"],["年","ねん"],["も"],["進んで","すすんで"],["老人","ろうじん"],["と"],["なった"],["。"]]},{"verse":3,"text":"あなたがたは、すでにあなたがたの神,かみ、主,しゅが、このもろもろの国,くにびとに行,おこなわれたすべてのことを見,みた。あなたがたのために戦,たたかわれたのは、あなたがたの神,かみ、主,しゅである。","tok":[["あなた"],["がた"],["は"],["、"],["すでに"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["、"],["この"],["もろもろ"],["の"],["国びと","くにびと"],["に"],["行なわれた","おこなわれた"],["すべて"],["の"],["こと"],["を"],["見た","みた"],["。"],["あなた"],["がた"],["の"],["ため"],["に"],["戦われた","たたかわれた"],["の"],["は"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["で"],["ある"],["。"]]},{"verse":4,"text":"見,みよ、わたしはヨルダンから、日,ひの入,いる方,ほう、大海,たいかいまでの、このもろもろの残,のこっている国々,くにぐにと、すでにわたしが滅,ほろぼし去,さったすべての国々,くにぐにを、くじをもって、あなたがたに分,わけ与,あたえ、あなたがたの各,かく部族,ぶぞくの嗣,し業,ぎょうとさせた。","tok":[["見よ","みよ"],["、"],["わたし"],["は"],["ヨルダン"],["から"],["、"],["日","ひ"],["の"],["入る","いる"],["方","ほう"],["、"],["大海","たいかい"],["まで"],["の"],["、"],["この"],["もろもろ"],["の"],["残って","のこって"],["いる"],["国々","くにぐに"],["と"],["、"],["すでに"],["わたし"],["が"],["滅ぼし","ほろぼし"],["去た","さった"],["すべて"],["の"],["国々","くにぐに"],["を"],["、"],["くじ"],["を"],["もって"],["、"],["あなた"],["がた"],["に"],["分け","わけ"],["与","あたえ"],["、"],["あなた"],["がた"],["の"],["各","かく"],["部族","ぶぞく"],["の"],["嗣業","しぎょう"],["と"],["させた"],["。"]]},{"verse":5,"text":"あなたがたの前,まえから、その国民,こくみんを打,うち払,はらい、あなたがたの目,めの前,まえから追,おい払,はらわれるのは、あなたがたの神,かみ、主,しゅである。そしてあなたがたの神,かみ、主,しゅが約束,やくそくされたように、あなたがたは彼,かれらの地,ちを獲,えるであろう。","tok":[["あなた"],["がた"],["の"],["前","まえ"],["から"],["、"],["その"],["国民","こくみん"],["を"],["打ち","うち"],["払","はらい"],["、"],["あなた"],["がた"],["の"],["目","め"],["の"],["前","まえ"],["から"],["追い払われる","おいはらわれる"],["の"],["は"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["で"],["ある"],["。"],["そして"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["約束","やくそく"],["された"],["よう"],["に"],["、"],["あなた"],["がた"],["は"],["彼","かれ"],["ら"],["の"],["地","ち"],["を"],["獲るで","えるで"],["あろう"],["。"]]},{"verse":6,"text":"それゆえ、あなたがたは堅,かたく立,たって、モーセの律法,りっぽうの書,しょにしるされていることを、ことごとく守,まもって行,おこなわなければならない。それを離,はなれて右,みぎにも左,ひだりにも曲,まがってはならない。","tok":[["それ"],["ゆえ"],["、"],["あなた"],["がた"],["は"],["堅く","かたく"],["立って","たって"],["、"],["モーセ"],["の"],["律法","りっぽう"],["の"],["書","しょ"],["に"],["しるされて"],["いる"],["こと"],["を"],["、"],["ことごとく"],["守って","まもって"],["行なわなければ","おこなわなければ"],["ならない"],["。"],["それ"],["を"],["離れて","はなれて"],["右","みぎ"],["に"],["も"],["左","ひだり"],["に"],["も"],["曲がって","まがって"],["は"],["ならない"],["。"]]},{"verse":7,"text":"あなたがたのうちに残,のこっている、これらの国民,こくみんと交,まじってはならない。彼,かれらの神々,かみがみの名,なを唱,となえてはならない。それをさして誓,ちかってはならない。またそれに仕,つかえ、それを拝,おがんではならない。","tok":[["あなた"],["がた"],["の"],["うち"],["に"],["残って","のこって"],["いる"],["、"],["これ"],["ら"],["の"],["国民","こくみん"],["と"],["交じって","まじって"],["は"],["ならない"],["。"],["彼","かれ"],["ら"],["の"],["神々","かみがみ"],["の"],["名","な"],["を"],["唱えて","となえて"],["は"],["ならない"],["。"],["それ"],["を"],["さして"],["誓って","ちかって"],["は"],["ならない"],["。"],["また"],["それ"],["に"],["仕え","つかえ"],["、"],["それ"],["を"],["拝","おがん"],["で"],["は"],["ならない"],["。"]]},{"verse":8,"text":"ただ、今日,こんにちまでしてきたように、あなたがたの神,かみ、主,しゅにつき従,したがわなければならない。","tok":[["ただ"],["、"],["今日","こんにち"],["まで"],["して"],["きた"],["よう"],["に"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主に","しゅに"],["つき従わなければ","つきしたがわなければ"],["ならない"],["。"]]},{"verse":9,"text":"主,しゅが大,おおいなる強,つよき国民,こくみんを、あなたがたの前,まえから追,おい払,はらわれた。あなたがたには今日,こんにちまで、立,たち向,むかうことのできる者,ものは、ひとりもなかった。","tok":[["主","しゅ"],["が"],["大いなる","おおいなる"],["強き","つよき"],["国民","こくみん"],["を"],["、"],["あなた"],["がた"],["の"],["前","まえ"],["から"],["追い払われた","おいはらわれた"],["。"],["あなた"],["がた"],["に"],["は"],["今日","こん"],["に"],["ち"],["まで"],["、"],["立ち向かう","たちむかう"],["こと"],["の"],["できる"],["者","もの"],["は"],["、"],["ひとり"],["も"],["なかった"],["。"]]},{"verse":10,"text":"あなたがたのひとりは、千人,にんを追,おい払,はらうことができるであろう。あなたがたの神,かみ、主,しゅが約束,やくそくされたように、みずからあなたがたのために戦,たたかわれるからである。","tok":[["あなた"],["がた"],["の"],["ひとり"],["は"],["、"],["千人","にん"],["を"],["追い払う","おいはらう"],["こと"],["が"],["できるで"],["あろう"],["。"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["約束","やくそく"],["された"],["よう"],["に"],["、"],["みずから"],["あなた"],["がた"],["の"],["ため"],["に"],["戦われる","たたかわれる"],["から"],["で"],["ある"],["。"]]},{"verse":11,"text":"それゆえ、あなたがたは深,ふかく慎,つつしんで、あなたがたの神,かみ、主,しゅを愛,あいさなければならない。","tok":[["それ"],["ゆえ"],["、"],["あなた"],["がた"],["は"],["深く","ふかく"],["慎しんで","つつしんで"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["を"],["愛さなければ","あいさなければ"],["ならない"],["。"]]},{"verse":12,"text":"しかし、あなたがたがもしひるがえって、これらの国民,こくみんの、生,いき残,のこって、あなたがたの中,なかにとどまる者,ものどもと親,したしくなり、これと婚姻,こんいんし、ゆききするならば、","tok":[["しかし"],["、"],["あなた"],["がた"],["が"],["もし"],["ひるがえって"],["、"],["これ"],["ら"],["の"],["国民","こくみん"],["の"],["、"],["生き残って","いきのこって"],["、"],["あなた"],["がた"],["の"],["中","なか"],["に"],["とどまる"],["者","もの"],["ども"],["と"],["親しく","したしく"],["なり"],["、"],["これ"],["と"],["婚姻","こんいん"],["し"],["、"],["ゆきき"],["するならば"],["、"]]},{"verse":13,"text":"あなたがたは、しかと知,しらなければならない。あなたがたの神,かみ、主,しゅは、もはや、これらの国民,こくみんをあなたがたの前,まえから、追,おい払,はらうことをされないであろう。彼,かれらは、かえって、あなたがたのわなとなり、網,あみとなり、あなたがたのわきに、むちとなり、あなたがたの目,めに、とげとなって、あなたがたはついに、あなたがたの神,かみ、主,しゅが賜,たまわったこの良,よい地,ちから、滅,ほろびうせるであろう。","tok":[["あなた"],["がた"],["は"],["、"],["しかと"],["知らなければ","しらなければ"],["ならない"],["。"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["、"],["もはや"],["、"],["これ"],["ら"],["の"],["国民","こくみん"],["を"],["あなた"],["がた"],["の"],["前","まえ"],["から"],["、"],["追い払う","おいはらう"],["こと"],["を"],["されないで"],["あろう"],["。"],["彼","かれ"],["ら"],["は"],["、"],["かえって"],["、"],["あなた"],["がた"],["の"],["わな"],["と"],["なり"],["、"],["網","あみ"],["と"],["なり"],["、"],["あなた"],["がた"],["の"],["わき"],["に"],["、"],["むち"],["と"],["なり"],["、"],["あなた"],["がた"],["の"],["目","め"],["に"],["、"],["とげ"],["と"],["なって"],["、"],["あなた"],["がた"],["は"],["ついに"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["賜わった","たまわった"],["この"],["良い","よい"],["地","ち"],["から"],["、"],["滅び","ほろび"],["うせるで"],["あろう"],["。"]]},{"verse":14,"text":"見,みよ、今日,こんにち、わたしは世,よの人,ひとのみな行,いく道,みちを行,いこうとする。あなたがたがみな、心,こころのうちにまた、肝,きもに銘,めいじて知,しっているように、あなたがたの神,かみ、主,しゅが、あなたがたについて約束,やくそくされたもろもろの良,よいことで、一つも欠,かけたものはなかった。みなあなたがたに臨,のぞんで、一つも欠,かけたものはなかった。","tok":[["見よ","みよ"],["、"],["今日","こん"],["に"],["ち"],["、"],["わたし"],["は"],["世","よ"],["の"],["人","ひと"],["の"],["みな"],["行く","いく"],["道","みち"],["を"],["行こう","いこう"],["と"],["する"],["。"],["あなた"],["がた"],["が"],["みな"],["、"],["心","こころ"],["の"],["うち"],["に"],["また"],["、"],["肝","きも"],["に"],["銘じて","めいじて"],["知って","しって"],["いる"],["よう"],["に"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["、"],["あなた"],["がた"],["について"],["約束","やくそく"],["された"],["もろもろ"],["の"],["良い","よい"],["こと"],["で"],["、"],["一","ひと"],["つ"],["も"],["欠けた","かけた"],["もの"],["は"],["なかった"],["。"],["みな"],["あなた"],["がた"],["に"],["臨んで","のぞんで"],["、"],["一","ひと"],["つ"],["も"],["欠けた","かけた"],["もの"],["は"],["なかった"],["。"]]},{"verse":15,"text":"しかし、あなたがたの神,かみ、主,しゅがあなたがたについて約束,やくそくされた、もろもろの良,よいことが、あなたがたに臨,のぞんだように、主,しゅはまた、もろもろの悪,わるいことをあなたがたに下,くだして、あなたがたの神,かみ、主,しゅが賜,たまわったこの良,よい地,ちから、ついに、あなたがたを滅,ほろぼし断,たたれるであろう。","tok":[["しかし"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["あなた"],["がた"],["について"],["約束","やくそく"],["された"],["、"],["もろもろ"],["の"],["良い","よい"],["こと"],["が"],["、"],["あなた"],["がた"],["に"],["臨んだ","のぞんだ"],["よう"],["に"],["、"],["主","しゅ"],["は"],["また"],["、"],["もろもろ"],["の"],["悪い","わるい"],["こと"],["を"],["あなた"],["がた"],["に"],["下して","くだして"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["賜わった","たまわった"],["この"],["良い","よい"],["地","ち"],["から"],["、"],["ついに"],["、"],["あなた"],["がた"],["を"],["滅ぼし","ほろぼし"],["断たれるで","たたれるで"],["あろう"],["。"]]},{"verse":16,"text":"もし、あなたがたの神,かみ、主,しゅが命,めいじられたその契約,けいやくを犯,おかし、行,いって他,たの神々,かみがみに仕,つかえ、それを拝,おがむならば、主,しゅはあなたがたにむかって怒,いかりを発,はっし、あなたがたは、主,しゅが賜,たまわった良,よい地,ちから、すみやかに滅,ほろびうせるであろう」。","tok":[["もし"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["命じられた","めいじられた"],["その"],["契約","けいやく"],["を"],["犯し","おかし"],["、"],["行って","いって"],["他","た"],["の"],["神々","かみがみ"],["に"],["仕え","つかえ"],["、"],["それ"],["を"],["拝むならば","おがむならば"],["、"],["主","しゅ"],["は"],["あなた"],["がた"],["に"],["むかって"],["怒り","いかり"],["を"],["発し","はっし"],["、"],["あなた"],["がた"],["は"],["、"],["主","しゅ"],["が"],["賜わった","たまわった"],["良い","よい"],["地","ち"],["から"],["、"],["すみやか"],["に"],["滅び","ほろび"],["うせるで"],["あろう"],["」"],["。"]]}]
[{"verse":1,"text":"ヨシュアは、イスラエルのすべての部族,ぶぞくをシケムに集,あつめ、イスラエルの長老,ちょうろう、かしら、さばきびと、つかさたちを召,めし寄,よせて、共,ともに神,かみの前,まえに進,すすみ出,でた。","tok":[["ヨシュア"],["は"],["、"],["イスラエル"],["の"],["すべて"],["の"],["部族","ぶぞく"],["を"],["シケム"],["に"],["集め","あつめ"],["、"],["イスラエル"],["の"],["長老","ちょうろう"],["、"],["かしら"],["、"],["さば"],["きび"],["と"],["、"],["つかさ"],["たち"],["を"],["召寄せて","めしよせて"],["、"],["共","とも"],["に"],["神","かみ"],["の"],["前","まえ"],["に"],["進み出た","すすみでた"],["。"]]},{"verse":2,"text":"そしてヨシュアはすべての民,たみに言,いった、「イスラエルの神,かみ、主,しゅは、こう仰,おおせられる、『あなたがたの先祖,せんぞたち、すなわちアブラハムの父,ちち、ナホルの父,ちちテラは、昔,むかし、ユフラテ川,かわの向,むこうに住,すみ、みな、ほかの神々,かみがみに仕,つかえていたが、","tok":[["そして"],["ヨシュア"],["は"],["すべて"],["の"],["民","たみ"],["に"],["言った","いった"],["、"],["「"],["イスラエル"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["、"],["こう"],["仰せられる","おおせられる"],["、"],["『"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["たち"],["、"],["すなわち"],["アブラハム"],["の"],["父","ちち"],["、"],["ナホル"],["の"],["父","ちち"],["テラ"],["は"],["、"],["昔","むかし"],["、"],["ユフラテ"],["川","かわ"],["の"],["向こう","むこう"],["に"],["住み","すみ"],["、"],["みな"],["、"],["ほか"],["の"],["神々","かみがみ"],["に"],["仕えて","つかえて"],["いた"],["が"],["、"]]},{"verse":3,"text":"わたしは、あなたがたの先祖,せんぞアブラハムを、川,かわの向,むこうから連,つれ出,だして、カナンの全,ぜん地,ちを導,みちびき通,とおり、その子孫,しそんを増,ました。わたしは彼,かれにイサクを与,あたえ、","tok":[["わたし"],["は"],["、"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["アブラハム"],["を"],["、"],["川","かわ"],["の"],["向こう","むこう"],["から"],["連れ出して","つれだして"],["、"],["カナン"],["の"],["全地","ぜんち"],["を"],["導き","みちびき"],["通り","とおり"],["、"],["その"],["子孫","しそん"],["を"],["増した","ました"],["。"],["わたし"],["は"],["彼","かれ"],["に"],["イサク"],["を"],["与","あたえ"],["、"]]},{"verse":4,"text":"イサクにヤコブとエサウを与,あたえ、エサウにはセイルの山地,さんちを与,あたえて、所有,しょゆうとさせたが、ヤコブとその子,こ供,ともたちはエジプトに下,くだった。","tok":[["イサク"],["に"],["ヤコブ"],["と"],["エサウ"],["を"],["与","あたえ"],["、"],["エサウ"],["に"],["は"],["セイル"],["の"],["山地","さんち"],["を"],["与","あたえ"],["て"],["、"],["所有","しょゆう"],["と"],["させた"],["が"],["、"],["ヤコブ"],["と"],["その"],["子供","ことも"],["たち"],["は"],["エジプト"],["に"],["下った","くだった"],["。"]]},{"verse":5,"text":"わたしはモーセとアロンをつかわし、またエジプトのうちに不思議,ふしぎをおこなって、これに災,わざわいを下,くだし、その後,のちあなたがたを導,みちびき出,だした。","tok":[["わたし"],["は"],["モーセ"],["と"],["アロン"],["を"],["つかわし"],["、"],["また"],["エジプト"],["の"],["うち"],["に"],["不思議","ふしぎ"],["を"],["おこなって"],["、"],["これ"],["に"],["災","わざわい"],["を"],["下し","くだし"],["、"],["その"],["後","のちあなた"],["がた"],["を"],["導き出した","みちびきだした"],["。"]]},{"verse":6,"text":"わたしはあなたがたの父,ちちたちを、エジプトから導,みちびき出,だし、あなたがたが海,うみにきたとき、エジプトびとは、戦車,せんしゃと騎兵,きへいとをもって、あなたがたの父,ちちたちを紅海,こうかいに追,おってきた。","tok":[["わたし"],["は"],["あなた"],["がた"],["の"],["父","ちち"],["たち"],["を"],["、"],["エジプト"],["から"],["導き出し","みちびきだし"],["、"],["あなた"],["がた"],["が"],["海","うみ"],["に"],["きた"],["とき"],["、"],["エジプト"],["び"],["と"],["は"],["、"],["戦車","せんしゃ"],["と"],["騎兵","きへい"],["と"],["を"],["もって"],["、"],["あなた"],["がた"],["の"],["父","ちち"],["たち"],["を"],["紅海","こうかい"],["に"],["追って","おって"],["きた"],["。"]]},{"verse":7,"text":"そのとき、あなたがたの父,ちちたちが主,しゅに呼,よばわったので、主,しゅは暗,くらやみをあなたがたとエジプトびととの間,あいだに置,おき、海,うみを彼,かれらの上,うえに傾,かたむけて彼,かれらをおおわれた。あなたがたは、わたしがエジプトでしたことを目,めで見,みた。そして長,ながい間,あいだ、荒野,あらのに住,すんでいた。","tok":[["その"],["とき"],["、"],["あなた"],["がた"],["の"],["父","ちち"],["たち"],["が"],["主に","しゅに"],["呼ばわった","よばわった"],["ので"],["、"],["主","しゅ"],["は"],["暗やみ","くらやみ"],["を"],["あなた"],["がた"],["と"],["エジプト"],["びと"],["と"],["の"],["間","あいだ"],["に"],["置き","おき"],["、"],["海","うみ"],["を"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["傾むけて","かたむけて"],["彼","かれ"],["ら"],["を"],["おおわれた"],["。"],["あなた"],["がた"],["は"],["、"],["わたし"],["が"],["エジプト"],["でした"],["こと"],["を"],["目","め"],["で"],["見た","みた"],["。"],["そして"],["長い","ながい"],["間","あいだ"],["、"],["荒野","あら"],["のに"],["住んで","すんで"],["いた"],["。"]]},{"verse":8,"text":"わたしはまたヨルダンの向,むこう側,がわに住,すんでいたアモリびとの地,ちに、あなたがたを導,みちびき入,いれた。彼,かれらはあなたがたと戦,たたかったので、わたしは彼,かれらをあなたがたの手,てに渡,わたして、彼,かれらの地,ちを獲,えさせ、彼,かれらをあなたがたの前,まえから滅,ほろぼし去,さった。","tok":[["わたし"],["は"],["また"],["ヨルダン"],["の"],["向こう側","むこうがわ"],["に"],["住んで","すんで"],["いた"],["アモリ"],["びと"],["の"],["地","ち"],["に"],["、"],["あなた"],["がた"],["を"],["導き入れた","みちびきいれた"],["。"],["彼","かれ"],["ら"],["は"],["あなた"],["がた"],["と"],["戦った","たたかった"],["ので"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["あなた"],["がた"],["の"],["手","て"],["に"],["渡","わたし"],["て"],["、"],["彼","かれ"],["ら"],["の"],["地","ち"],["を"],["獲させ","えさせ"],["、"],["彼","かれ"],["ら"],["を"],["あなた"],["がた"],["の"],["前","まえ"],["から"],["滅ぼし","ほろぼし"],["去た","さった"],["。"]]},{"verse":9,"text":"ついで、モアブの王,おうチッポルの子,こバラクが立,たって、イスラエルに敵,てきし、人,ひとをつかわし、ベオルの子,こバラムを招,まねき、あなたがたをのろわせようとしたが、","tok":[["つい"],["で"],["、"],["モアブ"],["の"],["王","おう"],["チッポル"],["の"],["子","こ"],["バラク"],["が"],["立って","たって"],["、"],["イスラエル"],["に"],["敵し","てきし"],["、"],["人","ひと"],["を"],["つかわし"],["、"],["ベオル"],["の"],["子","こ"],["バラム"],["を"],["招き","まねき"],["、"],["あなた"],["がた"],["を"],["のろわせよう"],["と"],["した"],["が"],["、"]]},{"verse":10,"text":"わたしがバラムに聞,きこうとしなかったので、彼,かれは、かえって、あなたがたを祝福,しゅくふくした。こうしてわたしは彼,かれの手,てからあなたがたを救,すくい出,だした。","tok":[["わたし"],["が"],["バラム"],["に"],["聞こう","きこう"],["と"],["しなかった"],["ので"],["、"],["彼","かれ"],["は"],["、"],["かえって"],["、"],["あなた"],["がた"],["を"],["祝福","しゅくふく"],["した"],["。"],["こう"],["して"],["わたし"],["は"],["彼","かれ"],["の"],["手","て"],["から"],["あなた"],["がた"],["を"],["救い出した","すくいだした"],["。"]]},{"verse":11,"text":"そしてあなたがたは、ヨルダンを渡,わたって、エリコにきたが、エリコの人々,ひとびとはあなたがたと戦,たたかい、アモリびと、ペリジびと、カナンびと、ヘテびと、ギルガシびと、ヒビびと、およびエブスびとも、あなたがたと戦,たたかったが、わたしは彼,かれらをあなたがたの手,てに渡,わたした。","tok":[["そして"],["あなた"],["がた"],["は"],["、"],["ヨルダン"],["を"],["渡って","わたって"],["、"],["エリコ"],["に"],["きた"],["が"],["、"],["エリコ"],["の"],["人々","ひとびと"],["は"],["あなた"],["がた"],["と"],["戦い","たたかい"],["、"],["アモリ"],["び"],["と"],["、"],["ペリジ"],["び"],["と"],["、"],["カナン"],["び"],["と"],["、"],["ヘテ"],["び"],["と"],["、"],["ギルガシ"],["び"],["と"],["、"],["ヒビ"],["び"],["と"],["、"],["および"],["エブス"],["びと"],["も"],["、"],["あなた"],["がた"],["と"],["戦った","たたかった"],["が"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["あなた"],["がた"],["の"],["手","て"],["に"],["渡","わたし"],["た"],["。"]]},{"verse":12,"text":"わたしは、あなたがたの前,まえに、くまばちを送,おくって、あのアモリびとのふたりの王,おうを、あなたがたの前,まえから追,おい払,はらった。これはあなたがたのつるぎ、または、あなたがたの弓,ゆみによってではなかった。","tok":[["わたし"],["は"],["、"],["あなた"],["がた"],["の"],["前","まえ"],["に"],["、"],["くまばち"],["を"],["送って","おくって"],["、"],["あの"],["アモリ"],["びと"],["の"],["ふたり"],["の"],["王","おう"],["を"],["、"],["あなた"],["がた"],["の"],["前","まえ"],["から"],["追い払った","おいはらった"],["。"],["これ"],["は"],["あなた"],["がた"],["の"],["つるぎ"],["、"],["また"],["は"],["、"],["あなた"],["がた"],["の"],["弓","ゆみ"],["によって"],["で"],["は"],["なかった"],["。"]]},{"verse":13,"text":"そしてわたしは、あなたがたが自分,じぶんで労,ろうしなかった地,ちを、あなたがたに与,あたえ、あなたがたが建,たてなかった町,まちを、あなたがたに与,あたえた。そしてあなたがたはいまその所,ところに住,すんでいる。あなたがたはまた自分,じぶんで作,つくらなかったぶどう畑,はたけと、オリブ畑,はたけの実,みを食,たべている』。","tok":[["そして"],["わたし"],["は"],["、"],["あなた"],["がた"],["が"],["自分","じぶん"],["で"],["労しなかった","ろうしなかった"],["地","ち"],["を"],["、"],["あなた"],["がた"],["に"],["与","あたえ"],["、"],["あなた"],["がた"],["が"],["建てなかった","たてなかった"],["町","まち"],["を"],["、"],["あなた"],["がた"],["に"],["与","あたえ"],["た"],["。"],["そして"],["あなた"],["がた"],["は"],["いま"],["その"],["所","ところ"],["に"],["住んで","すんで"],["いる"],["。"],["あなた"],["がた"],["は"],["また"],["自分","じぶん"],["で"],["作らなかった","つくらなかった"],["ぶどう"],["畑","はたけ"],["と"],["、"],["オリブ"],["畑","はたけ"],["の"],["実","み"],["を"],["食べて","たべて"],["いる"],["』"],["。"]]},{"verse":14,"text":"それゆえ、いま、あなたがたは主,しゅを恐,おそれ、まことと、まごころと、真実,しんじつとをもって、主,しゅに仕,つかえ、あなたがたの先祖,せんぞが、川,かわの向,むこう、およびエジプトで仕,つかえた他,たの神々,かみがみを除,のぞき去,さって、主,しゅに仕,つかえなさい。","tok":[["それ"],["ゆえ"],["、"],["いま"],["、"],["あなた"],["がた"],["は"],["主","しゅ"],["を"],["恐","おそれ"],["、"],["まこと"],["と"],["、"],["まごころ"],["と"],["、"],["真実","しんじつ"],["と"],["を"],["もって"],["、"],["主に","しゅに"],["仕え","つかえ"],["、"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["が"],["、"],["川","かわ"],["の"],["向こう","むこう"],["、"],["および"],["エジプト"],["で"],["仕えた","つかえた"],["他","た"],["の"],["神々","かみがみ"],["を"],["除き","のぞき"],["去て","さって"],["、"],["主に","しゅに"],["仕え","つかえ"],["なさい"],["。"]]},{"verse":15,"text":"もしあなたがたが主,しゅに仕,つかえることを、こころよしとしないのならば、あなたがたの先祖,せんぞが、川,かわの向,むこうで仕,つかえた神々,かみがみでも、または、いまあなたがたの住,すむ地,ちのアモリびとの神々,かみがみでも、あなたがたの仕,つかえる者,ものを、きょう、選,えらびなさい。ただし、わたしとわたしの家,いえとは共,ともに主,しゅに仕,つかえます」。","tok":[["もし"],["あなた"],["がた"],["が"],["主に","しゅに"],["仕える","つかえる"],["こと"],["を"],["、"],["こころ"],["よし"],["と"],["しない"],["の"],["ならば"],["、"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["が"],["、"],["川","かわ"],["の"],["向こう","むこう"],["で"],["仕えた","つかえた"],["神々","かみがみ"],["で"],["も"],["、"],["また"],["は"],["、"],["いま"],["あなた"],["がた"],["の"],["住む","すむ"],["地","ち"],["の"],["アモリ"],["びと"],["の"],["神々","かみがみ"],["で"],["も"],["、"],["あなた"],["がた"],["の"],["仕える","つかえる"],["者","もの"],["を"],["、"],["きょう"],["、"],["選ら","えら"],["び"],["なさい"],["。"],["ただし"],["、"],["わたし"],["と"],["わたし"],["の"],["家","いえ"],["と"],["は"],["共","とも"],["に"],["主に","しゅに"],["仕えます","つかえます"],["」"],["。"]]},{"verse":16,"text":"その時,とき、民,たみは答,こたえて言,いった、「主,しゅを捨,すてて、他,たの神々,かみがみに仕,つかえるなど、われわれは決,けっしていたしません。","tok":[["その"],["時","とき"],["、"],["民","たみ"],["は"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["主","しゅ"],["を"],["捨てて","すてて"],["、"],["他","た"],["の"],["神々","かみがみ"],["に"],["仕える","つかえる"],["など"],["、"],["われわれ"],["は"],["決っして","けっして"],["いたしません"],["。"]]},{"verse":17,"text":"われわれの神,かみ、主,しゅがみずからわれわれと、われわれの先祖,せんぞとを、エジプトの地,ち、奴隷,どれいの家,いえから導,みちびき上,のぼり、またわれわれの目,めの前,まえで、あの大,おおいなるしるしを行,おこない、われわれの行,いくすべての道,みちで守,まもり、われわれが通,とおったすべての国民,こくみんの中,なかでわれわれを守,まもられたからです。","tok":[["われわれ"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["みずから"],["われわれ"],["と"],["、"],["われわれ"],["の"],["先祖","せんぞ"],["と"],["を"],["、"],["エジプト"],["の"],["地","ち"],["、"],["奴隷","どれい"],["の"],["家","いえ"],["から"],["導き","みちびき"],["上り","のぼり"],["、"],["また"],["われわれ"],["の"],["目","め"],["の"],["前","まえ"],["で"],["、"],["あの"],["大いなる","おおいなる"],["しるし"],["を"],["行ない","おこない"],["、"],["われわれ"],["の"],["行く","いく"],["すべて"],["の"],["道","みち"],["で"],["守り","まもり"],["、"],["われわれ"],["が"],["通った","とおった"],["すべて"],["の"],["国民","こくみん"],["の"],["中","なか"],["で"],["われわれ"],["を"],["守られた","まもられた"],["から"],["です"],["。"]]},{"verse":18,"text":"主,しゅはまた、この地,ちに住,すんでいたアモリびとなど、すべての民,たみを、われわれの前,まえから追,おい払,はらわれました。それゆえ、われわれも主,しゅに仕,つかえます。主,しゅはわれわれの神,かみだからです」。","tok":[["主","しゅ"],["は"],["また"],["、"],["この"],["地","ち"],["に"],["住んで","すんで"],["いた"],["アモリ"],["びと"],["など"],["、"],["すべて"],["の"],["民","たみ"],["を"],["、"],["われわれ"],["の"],["前","まえ"],["から"],["追い払われました","おいはらわれました"],["。"],["それ"],["ゆえ"],["、"],["われわれ"],["も"],["主に","しゅに"],["仕えます","つかえます"],["。"],["主","しゅ"],["は"],["われわれ"],["の"],["神","かみ"],["だ"],["から"],["です"],["」"],["。"]]},{"verse":19,"text":"しかし、ヨシュアは民,たみに言,いった、「あなたがたは主,しゅに仕,つかえることはできないであろう。主,しゅは聖,せいなる神,かみであり、ねたむ神,かみであって、あなたがたの罪,つみ、あなたがたのとがを、ゆるされないからである。","tok":[["しかし"],["、"],["ヨシュア"],["は"],["民","たみ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["主に","しゅに"],["仕える","つかえる"],["こと"],["は"],["できないで"],["あろう"],["。"],["主","しゅ"],["は"],["聖","せい"],["なる"],["神","かみ"],["で"],["あり"],["、"],["ねたむ"],["神","かみ"],["で"],["あって"],["、"],["あなた"],["がた"],["の"],["罪","つみ"],["、"],["あなた"],["がた"],["の"],["とが"],["を"],["、"],["ゆるされない"],["から"],["で"],["ある"],["。"]]},{"verse":20,"text":"もしあなたがたが主,しゅを捨,すてて、異,ことなる神々,かみがみに仕,つかえるならば、あなたがたにさいわいを下,くだされたのちにも、ひるがえってあなたがたに災,わざわいをくだし、あなたがたを滅,ほろぼしつくされるであろう」。","tok":[["もし"],["あなた"],["がた"],["が"],["主","しゅ"],["を"],["捨てて","すてて"],["、"],["異なる","ことなる"],["神々","かみがみ"],["に"],["仕えるならば","つかえるならば"],["、"],["あなた"],["がた"],["に"],["さいわい"],["を"],["下された","くだされた"],["のち"],["に"],["も"],["、"],["ひるがえって"],["あなた"],["がた"],["に"],["災","わざわい"],["を"],["くだし"],["、"],["あなた"],["がた"],["を"],["滅ぼし","ほろぼし"],["つくされるで"],["あろう"],["」"],["。"]]},{"verse":21,"text":"民,たみはヨシュアに言,いった、「いいえ、われわれは主,しゅに仕,つかえます」。","tok":[["民","たみ"],["は"],["ヨシュア"],["に"],["言った","いった"],["、"],["「"],["いいえ"],["、"],["われわれ"],["は"],["主に","しゅに"],["仕えます","つかえます"],["」"],["。"]]},{"verse":22,"text":"そこでヨシュアは民,たみに言,いった、「あなたがたは主,しゅを選,えらんで、主,しゅに仕,つかえると言,いった。あなたがたみずからその証人,しょうにんである」。彼,かれらは言,いった、「われわれは証人,しょうにんです」。","tok":[["そこ"],["で"],["ヨシュア"],["は"],["民","たみ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["主","しゅ"],["を"],["選らんで","えらんで"],["、"],["主に","しゅに"],["仕える","つかえる"],["と"],["言った","いった"],["。"],["あなた"],["がた"],["みずから"],["その"],["証人","しょうにん"],["で"],["ある"],["」"],["。"],["彼","かれ"],["ら"],["は"],["言った","いった"],["、"],["「"],["われわれ"],["は"],["証人","しょうにん"],["です"],["」"],["。"]]},{"verse":23,"text":"ヨシュアはまた言,いった、「それならば、あなたがたのうちにある、異,ことなる神々,かみがみを除,のぞき去,さり、イスラエルの神,かみ、主,しゅに、心,こころを傾,かたむけなさい」。","tok":[["ヨシュア"],["は"],["また"],["言った","いった"],["、"],["「"],["それ"],["ならば"],["、"],["あなた"],["がた"],["の"],["うち"],["に"],["ある"],["、"],["異なる","ことなる"],["神々","かみがみ"],["を"],["除き去り","のぞきさり"],["、"],["イスラエル"],["の"],["神","かみ"],["、"],["主に","しゅに"],["、"],["心","こころ"],["を"],["傾むけ","かたむけ"],["なさい"],["」"],["。"]]},{"verse":24,"text":"民,たみはヨシュアに言,いった、「われわれの神,かみ、主,しゅに、われわれは仕,つかえ、その声,こえに聞,ききしたがいます」。","tok":[["民","たみ"],["は"],["ヨシュア"],["に"],["言った","いった"],["、"],["「"],["われわれ"],["の"],["神","かみ"],["、"],["主に","しゅに"],["、"],["われわれ"],["は"],["仕え","つかえ"],["、"],["その"],["声","こえ"],["に"],["聞き","きき"],["したがいます"],["」"],["。"]]},{"verse":25,"text":"こうしてヨシュアは、その日,ひ、民,たみと契約,けいやくをむすび、シケムにおいて、定,さだめと、おきてを、彼,かれらのために設,もうけた。","tok":[["こう"],["して"],["ヨシュア"],["は"],["、"],["その"],["日","ひ"],["、"],["民","たみ"],["と"],["契約","けいやく"],["を"],["むすび"],["、"],["シケム"],["に"],["おいて"],["、"],["定め","さだめ"],["と"],["、"],["おきて"],["を"],["、"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["設けた","もうけた"],["。"]]},{"verse":26,"text":"ヨシュアはこれらの言葉,ことばを神,かみの律法,りっぽうの書,しょにしるし、大,おおきな石,いしを取,とって、その所,ところで、主,しゅの聖所,せいじょにあるかしの木,きの下,したにそれを立,たて、","tok":[["ヨシュア"],["は"],["これ"],["ら"],["の"],["言葉","ことば"],["を"],["神","かみ"],["の"],["律法","りっぽう"],["の"],["書","しょ"],["に"],["しるし"],["、"],["大きな","おおきな"],["石","いし"],["を"],["取って","とって"],["、"],["その"],["所","ところ"],["で"],["、"],["主","しゅ"],["の"],["聖","せい"],["所","しょ"],["に"],["ある"],["かし"],["の"],["木","き"],["の"],["下","した"],["に"],["それ"],["を"],["立て","たて"],["、"]]},{"verse":27,"text":"ヨシュアは、すべての民,たみに言,いった、「見,みよ、この石,いしはわれわれのあかしとなるであろう。主,しゅがわれわれに語,かたられたすべての言葉,ことばを、聞,きいたからである。それゆえ、あなたがたが自分,じぶんの神,かみを捨,すてることのないために、この石,いしが、あなたがたのあかしとなるであろう」。","tok":[["ヨシュア"],["は"],["、"],["すべて"],["の"],["民","たみ"],["に"],["言った","いった"],["、"],["「"],["見よ","みよ"],["、"],["この"],["石","いし"],["は"],["われわれ"],["の"],["あかし"],["と"],["なるで"],["あろう"],["。"],["主","しゅ"],["が"],["われわれ"],["に"],["語られた","かたられた"],["すべて"],["の"],["言葉","ことば"],["を"],["、"],["聞いた","きいた"],["から"],["で"],["ある"],["。"],["それ"],["ゆえ"],["、"],["あなた"],["がた"],["が"],["自分","じぶん"],["の"],["神","かみ"],["を"],["捨てる","すてる"],["こと"],["の"],["ない"],["ため"],["に"],["、"],["この"],["石","いし"],["が"],["、"],["あなた"],["がた"],["の"],["あかし"],["と"],["なるで"],["あろう"],["」"],["。"]]},{"verse":28,"text":"こうしてヨシュアは民,たみを、おのおのその嗣,し業,ぎょうの地,ちに帰,きし去,さらせた。","tok":[["こう"],["して"],["ヨシュア"],["は"],["民","たみ"],["を"],["、"],["おのおの"],["その"],["嗣業","しぎょう"],["の"],["地","ち"],["に"],["帰し","きし"],["去らせた","さらせた"],["。"]]},{"verse":29,"text":"これらの事,ことの後,のち、主,しゅのしもべ、ヌンの子,こヨシュアは百十歳,さいで死,しんだ、","tok":[["これ"],["ら"],["の"],["事","こと"],["の"],["後","の"],["ち"],["、"],["主","しゅ"],["の"],["しもべ"],["、"],["ヌン"],["の"],["子","こ"],["ヨシュア"],["は"],["百十歳","さ"],["いで"],["死んだ","しんだ"],["、"]]},{"verse":30,"text":"人々,ひとびとは彼,かれをその嗣,し業,ぎょうの地,ちのうちのテムナテ・セラに葬,ほうむった。テムナテ・セラは、エフライムの山地,さんちで、ガアシ山,やまの北,きたにある。","tok":[["人々","ひとびと"],["は"],["彼","かれ"],["を"],["その"],["嗣業","しぎょう"],["の"],["地","ち"],["の"],["うち"],["の"],["テムナテ"],["・"],["セラ"],["に"],["葬むった","ほうむった"],["。"],["テムナテ"],["・"],["セラ"],["は"],["、"],["エフライム"],["の"],["山地","さんち"],["で"],["、"],["ガアシ"],["山","やま"],["の"],["北","きた"],["に"],["ある"],["。"]]},{"verse":31,"text":"イスラエルはヨシュアの世,よにある日,ひの間,あいだ、また主,しゅがイスラエルのために行,おこなわれたもろもろのことを知,しっていて、ヨシュアのあとに生,いき残,のこった長老,ちょうろうたちが世,よにある日,ひの間,あいだ、つねに主,しゅに仕,つかえた。","tok":[["イスラエル"],["は"],["ヨシュア"],["の"],["世","よ"],["に"],["ある"],["日","ひ"],["の"],["間","あいだ"],["、"],["また"],["主","しゅ"],["が"],["イスラエル"],["の"],["ため"],["に"],["行なわれた","おこなわれた"],["もろもろ"],["の"],["こと"],["を"],["知って","しって"],["いて"],["、"],["ヨシュア"],["の"],["あと"],["に"],["生き残った","いきのこった"],["長老","ちょうろう"],["たち"],["が"],["世","よ"],["に"],["ある"],["日","ひ"],["の"],["間","あいだ"],["、"],["つね"],["に"],["主に","しゅに"],["仕えた","つかえた"],["。"]]},{"verse":32,"text":"イスラエルの人々,ひとびとが、エジプトから携,たずさえ上,のぼったヨセフの骨,ほねは、むかしヤコブが銀,ぎん百枚,まいで、シケムの父,ちちハモルの子,こらから買,かい取,とったシケムのうちの地所,じしょの一部,いちぶに葬,ほうむられた。これはヨセフの子孫,しそんの嗣,し業,ぎょうとなった。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["が"],["、"],["エジプト"],["から"],["携え","たずさえ"],["上った","のぼった"],["ヨセフ"],["の"],["骨","ほね"],["は"],["、"],["むかし"],["ヤコブ"],["が"],["銀","ぎん"],["百枚","ま"],["いで"],["、"],["シケム"],["の"],["父","ちち"],["ハモル"],["の"],["子","こ"],["ら"],["から"],["買取った","かいとった"],["シケム"],["の"],["うち"],["の"],["地所","じしょ"],["の"],["一部","いちぶ"],["に"],["葬むられた","ほうむられた"],["。"],["これ"],["は"],["ヨセフ"],["の"],["子孫","しそん"],["の"],["嗣業","しぎょう"],["と"],["なった"],["。"]]},{"verse":33,"text":"アロンの子,こエレアザルも死,しんだ。人々,ひとびとは彼,かれを、その子,こピネハスに与,あたえられた町,まちで、エフライムの山地,さんちにあるギベアに葬,ほうむった。","tok":[["アロン"],["の"],["子","こ"],["エレアザル"],["も"],["死んだ","しんだ"],["。"],["人々","ひとびと"],["は"],["彼","かれ"],["を"],["、"],["その"],["子","こ"],["ピネハス"],["に"],["与えられた","あたえられた"],["町","まち"],["で"],["、"],["エフライム"],["の"],["山地","さんち"],["に"],["ある"],["ギベア"],["に"],["葬むった","ほうむった"],["。"]]}]
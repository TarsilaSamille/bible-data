[{"verse":1,"text":"時,ときにヨシュアは、ルベンびと、ガドびと、およびマナセの部族,ぶぞくの半,なかばを呼,よび集,あつめて、","tok":[["時","とき"],["に"],["ヨシュア"],["は"],["、"],["ルベン"],["び"],["と"],["、"],["ガド"],["び"],["と"],["、"],["および"],["マナセ"],["の"],["部族","ぶぞく"],["の"],["半ば","なかば"],["を"],["呼び集めて","よびあつめて"],["、"]]},{"verse":2,"text":"言,いった、「あなたがたは主,しゅのしもべモーセが命,めいじたことを、ことごとく守,まもり、またわたしの命,めいじたすべての事,ことにも、わたしの言葉,ことばに聞,ききしたがいました。","tok":[["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["主","しゅ"],["の"],["しもべ"],["モーセ"],["が"],["命じた","めいじた"],["こと"],["を"],["、"],["ことごとく"],["守り","まもり"],["、"],["また"],["わたし"],["の"],["命じた","めいじた"],["すべて"],["の"],["事","こと"],["に"],["も"],["、"],["わたし"],["の"],["言葉","ことば"],["に"],["聞き","きき"],["したがいました"],["。"]]},{"verse":3,"text":"今日,こんにちまで長,ながい年月,としつきの間,あいだ、あなたがたの兄弟,きょうだいたちを捨,すてず、あなたがたの神,かみ、主,しゅの命令,めいれいを、よく守,まもってきました。","tok":[["今日","こん"],["に"],["ち"],["まで"],["長い","ながい"],["年月","としつき"],["の"],["間","あいだ"],["、"],["あなた"],["がた"],["の"],["兄弟","きょうだい"],["たち"],["を"],["捨てず","すてず"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["命令","めいれい"],["を"],["、"],["よく"],["守って","まもって"],["きました"],["。"]]},{"verse":4,"text":"今,いまはすでに、あなたがたの神,かみ、主,しゅが、あなたがたの兄弟,きょうだいたちに、先,さきに約束,やくそくされたとおり、安息,あんそくを賜,たまわるようになりました。それで、あなたがたは身,みを返,かえして、主,しゅのしもべモーセが、あなたがたに与,あたえたヨルダンの向,むこう側,がわの所有,しょゆうの地,ちに行,いき、自分,じぶんたちの天幕,てんまくに帰,かえりなさい。","tok":[["今","いま"],["は"],["すでに"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["、"],["あなた"],["がた"],["の"],["兄弟","きょうだい"],["たち"],["に"],["、"],["先","さき"],["に"],["約束","やくそく"],["された"],["とおり"],["、"],["安息","あんそく"],["を"],["賜わる","たまわる"],["よう"],["に"],["なりました"],["。"],["それ"],["で"],["、"],["あなた"],["がた"],["は"],["身","み"],["を"],["返","かえし"],["て"],["、"],["主","しゅ"],["の"],["しもべ"],["モーセ"],["が"],["、"],["あなた"],["がた"],["に"],["与","あたえ"],["た"],["ヨルダン"],["の"],["向こう側","むこうがわ"],["の"],["所有","しょゆう"],["の"],["地","ち"],["に"],["行き","いき"],["、"],["自分","じぶん"],["たち"],["の"],["天幕","てんまく"],["に"],["帰えり","かえり"],["なさい"],["。"]]},{"verse":5,"text":"ただ主,しゅのしもべモーセが、あなたがたに命,めいじた戒,いましめと、律法,りっぽうとを慎,つつしんで行,おこない、あなたがたの神,かみ、主,しゅを愛,あいし、そのすべての道,みちに歩,あゆみ、その命令,めいれいを守,まもって、主,しゅにつき従,したがい、心,こころをつくし、精神,せいしんをつくして、主,しゅに仕,つかえなさい」。","tok":[["ただ"],["主","しゅ"],["の"],["しもべ"],["モーセ"],["が"],["、"],["あなた"],["がた"],["に"],["命じた","めいじた"],["戒しめ","いましめ"],["と"],["、"],["律法","りっぽう"],["と"],["を"],["慎しんで","つつしんで"],["行ない","おこない"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["を"],["愛し","あいし"],["、"],["その"],["すべて"],["の"],["道","みち"],["に"],["歩み","あゆみ"],["、"],["その"],["命令","めいれい"],["を"],["守って","まもって"],["、"],["主に","しゅに"],["つき従い","つきしたがい"],["、"],["心","こころ"],["を"],["つくし"],["、"],["精神","せいしん"],["を"],["つくして"],["、"],["主に","しゅに"],["仕え","つかえ"],["なさい"],["」"],["。"]]},{"verse":6,"text":"そしてヨシュアが彼,かれらを祝福,しゅくふくして去,さらせたので、彼,かれらはその天幕,てんまくに帰,かえった。","tok":[["そして"],["ヨシュア"],["が"],["彼","かれ"],["ら"],["を"],["祝福","しゅくふく"],["して"],["去らせた","さらせた"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["その"],["天幕","てんまく"],["に"],["帰えった","かえった"],["。"]]},{"verse":7,"text":"マナセの部族,ぶぞくの半,なかばには、すでにモーセがバシャンで所有,しょゆう地,ちを与,あたえたが、他,たの半,なかばには、ヨシュアがヨルダンのこちら側,がわ、西,にしの方,ほうで、その兄弟,きょうだいたちのうちに、所有,しょゆう地,ちを与,あたえた。ヨシュアは、彼,かれらをその天幕,てんまくに送,おくりかえす時,とき、彼,かれらを祝福,しゅくふくして、","tok":[["マナセ"],["の"],["部族","ぶぞく"],["の"],["半ば","なかば"],["に"],["は"],["、"],["すでに"],["モーセ"],["が"],["バシャン"],["で"],["所有地","しょゆうち"],["を"],["与えた","あたえた"],["が"],["、"],["他","た"],["の"],["半ば","なかば"],["に"],["は"],["、"],["ヨシュア"],["が"],["ヨルダン"],["の"],["こちら側","こちらがわ"],["、"],["西","にし"],["の"],["方","ほう"],["で"],["、"],["その"],["兄弟","きょうだい"],["たち"],["の"],["うち"],["に"],["、"],["所有地","しょゆうち"],["を"],["与","あたえ"],["た"],["。"],["ヨシュア"],["は"],["、"],["彼","かれ"],["ら"],["を"],["その"],["天幕","てんまく"],["に"],["送りかえす","おくりかえす"],["時","とき"],["、"],["彼","かれ"],["ら"],["を"],["祝福","しゅくふく"],["して"],["、"]]},{"verse":8,"text":"言,いった、「あなたがたは多,おおくの貨,か財,ざいと、おびただしい数,かずの家畜,かちくと、金,きん、銀,ぎん、青銅,せいどう、鉄,てつ、および多,おおくの衣服,いふくを持,もって天幕,てんまくに帰,かえり、敵,てきから獲,えたぶんどり物,ものを兄弟,きょうだいたちに分,わけなさい」。","tok":[["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["多く","おおく"],["の"],["貨財","かざい"],["と"],["、"],["おびただしい"],["数","かず"],["の"],["家畜","かちく"],["と"],["、"],["金","きん"],["、"],["銀","ぎん"],["、"],["青銅","せいどう"],["、"],["鉄","てつ"],["、"],["および"],["多く","おおく"],["の"],["衣服","いふく"],["を"],["持って","もって"],["天幕","てんまく"],["に"],["帰えり","かえり"],["、"],["敵","てき"],["から"],["獲た","えた"],["ぶんどり"],["物","もの"],["を"],["兄弟","きょうだい"],["たち"],["に"],["分け","わけ"],["なさい"],["」"],["。"]]},{"verse":9,"text":"こうしてルベンの子孫,しそん、ガドの子孫,しそん、およびマナセの部族,ぶぞくの半,なかばは、主,しゅがモーセによって命,めいじられたように、すでに自分,じぶんの所有,しょゆう地,ちとなっているギレアデの地,ちに行,いこうと、カナンの地,ちのシロで、イスラエルの人々,ひとびとと別,わかれて帰,かえって行,いった。","tok":[["こう"],["して"],["ルベン"],["の"],["子孫","しそん"],["、"],["ガド"],["の"],["子孫","しそん"],["、"],["および"],["マナセ"],["の"],["部族","ぶぞく"],["の"],["半ば","なかば"],["は"],["、"],["主","しゅ"],["が"],["モーセ"],["によって"],["命じられた","めいじられた"],["よう"],["に"],["、"],["すでに"],["自分","じぶん"],["の"],["所有地","しょゆうち"],["と"],["なって"],["いる"],["ギレアデ"],["の"],["地","ち"],["に"],["行こう","いこう"],["と"],["、"],["カナン"],["の"],["地","ち"],["の"],["シロ"],["で"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["と"],["別かれて","わかれて"],["帰えって","かえって"],["行った","いった"],["。"]]},{"verse":10,"text":"ルベンの子孫,しそん、ガドの子孫,しそん、およびマナセの部族,ぶぞくの半,なかばが、カナンの地,ちのヨルダンのほとりにきた時,とき、その所,ところで、ヨルダンの岸,きしべに一つの祭壇,さいだんを築,きずいた。それは大,おおきくて遠,とおくから見,みえる祭壇,さいだんであった。","tok":[["ルベン"],["の"],["子孫","しそん"],["、"],["ガド"],["の"],["子孫","しそん"],["、"],["および"],["マナセ"],["の"],["部族","ぶぞく"],["の"],["半ば","なかば"],["が"],["、"],["カナン"],["の"],["地","ち"],["の"],["ヨルダン"],["の"],["ほとり"],["に"],["きた"],["時","とき"],["、"],["その"],["所","ところ"],["で"],["、"],["ヨルダン"],["の"],["岸べ","きしべ"],["に"],["一","ひと"],["つ"],["の"],["祭壇","さいだん"],["を"],["築いた","きずいた"],["。"],["それ"],["は"],["大きくて","おおきくて"],["遠く","とおく"],["から"],["見える","みえる"],["祭壇","さいだん"],["で"],["あった"],["。"]]},{"verse":11,"text":"イスラエルの人々,ひとびとは、「ルベンの子孫,しそん、ガドの子孫,しそん、およびマナセの部族,ぶぞくの半,なかばが、カナンの地,ちの国境,こっきょう、ヨルダンのほとりのイスラエルの人々,ひとびとに属,ぞくする方,ほうで、一つの祭壇,さいだんを築,きずいた」といううわさを聞,きいた。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["は"],["、"],["「"],["ルベン"],["の"],["子孫","しそん"],["、"],["ガド"],["の"],["子孫","しそん"],["、"],["および"],["マナセ"],["の"],["部族","ぶぞく"],["の"],["半ば","なかば"],["が"],["、"],["カナン"],["の"],["地","ち"],["の"],["国境","こっきょう"],["、"],["ヨルダン"],["の"],["ほとり"],["の"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["属する","ぞくする"],["方","ほう"],["で"],["、"],["一","ひと"],["つ"],["の"],["祭壇","さいだん"],["を"],["築いた","きずいた"],["」"],["と"],["いう"],["うわさ"],["を"],["聞いた","きいた"],["。"]]},{"verse":12,"text":"イスラエルの人々,ひとびとが、それを聞,きくとひとしく、イスラエルの人々,ひとびとの全,ぜん会衆,かいしゅうはシロに集,あつまって、彼,かれらの所,ところに攻,せめ上,のぼろうとした。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["が"],["、"],["それ"],["を"],["聞く","きく"],["と"],["ひとしく"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["全","ぜん"],["会衆","かいしゅう"],["は"],["シロ"],["に"],["集まって","あつまって"],["、"],["彼","かれ"],["ら"],["の"],["所","ところ"],["に"],["攻め上ろう","せめのぼろう"],["と"],["した"],["。"]]},{"verse":13,"text":"そしてイスラエルの人々,ひとびとは、祭司,さいしエレアザルの子,こピネハスをギレアデの地,ちのルベンの子孫,しそん、ガドの子孫,しそん、およびマナセの半,はん部族,ぶぞくの所,ところにつかわし、","tok":[["そして"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["、"],["祭司","さいし"],["エレアザル"],["の"],["子","こ"],["ピネハス"],["を"],["ギレアデ"],["の"],["地","ち"],["の"],["ルベン"],["の"],["子孫","しそん"],["、"],["ガド"],["の"],["子孫","しそん"],["、"],["および"],["マナセ"],["の"],["半","はん"],["部族","ぶぞく"],["の"],["所","ところ"],["に"],["つかわし"],["、"]]},{"verse":14,"text":"イスラエルの各,かく部族,ぶぞくのうちから、父祖,ふその家,いえのつかさ、ひとりずつをあげて、合,あわせて十人,にんのつかさたちを、彼,かれと共,ともに行,いかせた。これらはみなイスラエルの氏族,しぞくのうちで、父祖,ふその家,いえのかしらたる人々,ひとびとであった。","tok":[["イスラエル"],["の"],["各","かく"],["部族","ぶぞく"],["の"],["うち"],["から"],["、"],["父祖","ふそ"],["の"],["家","いえ"],["の"],["つかさ"],["、"],["ひとり"],["ずつ"],["を"],["あげて"],["、"],["合","あわせ"],["て"],["十人","にん"],["の"],["つかさ"],["たち"],["を"],["、"],["彼","かれ"],["と"],["共","とも"],["に"],["行かせた","いかせた"],["。"],["これ"],["ら"],["は"],["みな"],["イスラエル"],["の"],["氏族","しぞく"],["の"],["うち"],["で"],["、"],["父祖","ふそ"],["の"],["家","いえ"],["の"],["かしら"],["たる"],["人々","ひとびと"],["で"],["あった"],["。"]]},{"verse":15,"text":"彼,かれらはギレアデの地,ちに行,いき、ルベンの子孫,しそん、ガドの子孫,しそん、およびマナセの半,はん部族,ぶぞくに語,かたって言,いった、","tok":[["彼","かれ"],["ら"],["は"],["ギレアデ"],["の"],["地","ち"],["に"],["行き","いき"],["、"],["ルベン"],["の"],["子孫","しそん"],["、"],["ガド"],["の"],["子孫","しそん"],["、"],["および"],["マナセ"],["の"],["半","はん"],["部族","ぶぞく"],["に"],["語って","かたって"],["言った","いった"],["、"]]},{"verse":16,"text":"「主,しゅの全,ぜん会衆,かいしゅうはこう言,いいます、『あなたがたがイスラエルの神,かみにむかって、とがを犯,おかし、今日,こんにち、ひるがえって主,しゅに従,したがうことをやめ、自分,じぶんのために一つの祭壇,さいだんを築,きずいて、今日,こんにち、主,しゅにそむこうとするのは何事,なにごとか。","tok":[["「"],["主","しゅ"],["の"],["全","ぜん"],["会衆","かいしゅう"],["は"],["こう"],["言います","いいます"],["、"],["『"],["あなた"],["がた"],["が"],["イスラエル"],["の"],["神","かみ"],["に"],["むかって"],["、"],["とが"],["を"],["犯し","おかし"],["、"],["今日","こん"],["に"],["ち"],["、"],["ひるがえって"],["主に","しゅに"],["従う","したがう"],["こと"],["を"],["やめ"],["、"],["自分","じぶん"],["の"],["ため"],["に"],["一","ひと"],["つ"],["の"],["祭壇","さいだん"],["を"],["築いて","きずいて"],["、"],["今日","こん"],["に"],["ち"],["、"],["主に","しゅに"],["そむこう"],["と"],["する"],["の"],["は"],["何事","なにごと"],["か"],["。"]]},{"verse":17,"text":"ペオルで犯,おかした罪,つみで、なお足,たりないとするのか。それがために主,しゅの会衆,かいしゅうに災,わざわいが下,くだったが、われわれは今日,こんにちもなお、その罪,つみから清,きよめられていない。","tok":[["ペオル"],["で"],["犯した","おかした"],["罪","つみ"],["で"],["、"],["なお"],["足りない","たりない"],["と"],["する"],["の"],["か"],["。"],["それ"],["が"],["ため"],["に"],["主","しゅ"],["の"],["会衆","かいしゅう"],["に"],["災","わざわい"],["が"],["下った","くだった"],["が"],["、"],["われわれ"],["は"],["今日","こんにち"],["も"],["なお"],["、"],["その"],["罪","つみ"],["から"],["清められて","きよめられて"],["いない"],["。"]]},{"verse":18,"text":"しかもあなたがたは、今日,こんにち、ひるがえって主,しゅに従,したがうことをやめようとするのか。あなたがたが、きょう、主,しゅにそむくならば、あす、主,しゅはイスラエルの全,ぜん会衆,かいしゅうにむかって怒,いかられるであろう。","tok":[["しかも"],["あなた"],["がた"],["は"],["、"],["今日","こん"],["に"],["ち"],["、"],["ひるがえって"],["主に","しゅに"],["従う","したがう"],["こと"],["を"],["やめよう"],["と"],["する"],["の"],["か"],["。"],["あなた"],["が"],["た"],["が"],["、"],["きょう"],["、"],["主に","しゅに"],["そむくならば"],["、"],["あす"],["、"],["主","しゅ"],["は"],["イスラエル"],["の"],["全","ぜん"],["会衆","かいしゅう"],["に"],["むかって"],["怒","い"],["から"],["れるで"],["あろう"],["。"]]},{"verse":19,"text":"もしあなたがたの所有,しょゆうの地,ちが清,きよくないのであれば、主,しゅの幕屋,まくやの立,たっている主,しゅの所有,しょゆうの地,ちに渡,わたってきて、われわれのうちに、所有,しょゆうの地,ちを獲,えなさい。ただ、われわれの神,かみ、主,しゅの祭壇,さいだんのほかに、自分,じぶんのために祭壇,さいだんを築,きずいて、主,しゅにそむき、またわれわれをそむく者,ものとならせないでください。","tok":[["もし"],["あなた"],["がた"],["の"],["所有","しょゆう"],["の"],["地","ち"],["が"],["清く","きよく"],["ない"],["ので"],["あれば"],["、"],["主","しゅ"],["の"],["幕屋","まくや"],["の"],["立って","たって"],["いる"],["主","しゅ"],["の"],["所有","しょゆう"],["の"],["地","ち"],["に"],["渡って","わたって"],["きて"],["、"],["われわれ"],["の"],["うち"],["に"],["、"],["所有","しょゆう"],["の"],["地","ち"],["を"],["獲","え"],["なさい"],["。"],["ただ"],["、"],["われわれ"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["祭壇","さいだん"],["の"],["ほか"],["に"],["、"],["自分","じぶん"],["の"],["ため"],["に"],["祭壇","さいだん"],["を"],["築いて","きずいて"],["、"],["主","しゅ"],["に"],["そむき"],["、"],["また"],["われわれ"],["を"],["そむく"],["者","もの"],["と"],["ならせないで"],["ください"],["。"]]},{"verse":20,"text":"ゼラの子,こアカンは、のろわれた物,ものについて、とがを犯,おかし、それがためイスラエルの全,ぜん会衆,かいしゅうに、怒,いかりが臨,のぞんだではないか。またその罪,つみによって滅,ほろびた者,ものは、彼,かれひとりではなかった』」。","tok":[["ゼラ"],["の"],["子","こ"],["アカン"],["は"],["、"],["のろわれた"],["物","もの"],["について"],["、"],["とが"],["を"],["犯し","おかし"],["、"],["それ"],["が"],["ため"],["イスラエル"],["の"],["全","ぜん"],["会衆","かいしゅう"],["に"],["、"],["怒り","いかり"],["が"],["臨","のぞんだ"],["で"],["は"],["ない"],["か"],["。"],["また"],["その"],["罪","つみ"],["によって"],["滅びた","ほろびた"],["者","もの"],["は"],["、"],["彼","かれ"],["ひとり"],["で"],["は"],["なかった"],["』"],["」"],["。"]]},{"verse":21,"text":"その時,とき、ルベンの子孫,しそん、ガドの子孫,しそん、およびマナセの半,はん部族,ぶぞくは、イスラエルの氏族,しぞくのかしらたちに答,こたえて言,いった、","tok":[["その"],["時","とき"],["、"],["ルベン"],["の"],["子孫","しそん"],["、"],["ガド"],["の"],["子孫","しそん"],["、"],["および"],["マナセ"],["の"],["半","はん"],["部族","ぶぞく"],["は"],["、"],["イスラエル"],["の"],["氏族","しぞく"],["の"],["かしら"],["たち"],["に"],["答","こたえ"],["て"],["言った","いった"],["、"]]},{"verse":22,"text":"「力,ちからある者,もの、神,かみ、主,しゅ。力,ちからある者,もの、神,かみ、主,しゅ。主,しゅは知,しろしめす。イスラエルもまた知,しらなければならない。もしそれがそむくことであり、あるいは主,しゅに罪,つみを犯,おかすことであるならば、きょう、われわれをゆるさないでください。","tok":[["「"],["力","ちから"],["ある"],["者","もの"],["、"],["神","かみ"],["、"],["主","しゅ"],["。"],["力","ちから"],["ある"],["者","もの"],["、"],["神","かみ"],["、"],["主","しゅ"],["。"],["主","しゅ"],["は"],["知ろしめす","しろしめす"],["。"],["イスラエル"],["も"],["また"],["知らなければ","しらなければ"],["ならない"],["。"],["もし"],["それ"],["が"],["そむく"],["こと"],["で"],["あり"],["、"],["あるいは"],["主に","しゅに"],["罪","つみ"],["を"],["犯す","おかす"],["こと"],["で"],["あるならば"],["、"],["きょう"],["、"],["われわれ"],["を"],["ゆるさないで"],["ください"],["。"]]},{"verse":23,"text":"われわれが祭壇,さいだんを築,きずいたことが、もし主,しゅに従,したがうことをやめるためであり、またその上,うえに、燔祭,はんさい、素祭,そさいをささげるためであり、あるいはまたその上,うえに、酬恩祭,しゅうおんさいの犠牲,ぎせいをささげるためであったならば、主,しゅみずから、その罪,つみを問,といただしてください。","tok":[["われわれ"],["が"],["祭壇","さいだん"],["を"],["築いた","きずいた"],["こと"],["が"],["、"],["もし"],["主に","しゅに"],["従う","したがう"],["こと"],["を"],["やめる"],["ため"],["で"],["あり"],["、"],["また"],["その"],["上","うえ"],["に"],["、"],["燔祭","はんさい"],["、"],["素","す"],["祭","まつり"],["を"],["ささげる"],["ため"],["で"],["あり"],["、"],["あるいは"],["また"],["その"],["上","うえ"],["に"],["、"],["酬恩祭","しゅうおんさい"],["の"],["犠牲","ぎせい"],["を"],["ささげる"],["ため"],["で"],["あったならば"],["、"],["主ら","しゅみずから"],["、"],["その"],["罪","つみ"],["を"],["問","とい"],["ただして"],["ください"],["。"]]},{"verse":24,"text":"しかし、われわれは次,つぎのことを考,かんがえてしたのです。すなわち、のちの日,ひになって、あなたがたの子孫,しそんが、われわれの子孫,しそんにむかって言,いうことがあるかも知,しれません、『あなたがたは、イスラエルの神,かみ、主,しゅと、なんの関係,かんけいがあるのですか。","tok":[["しかし"],["、"],["われわれ"],["は"],["次","つぎ"],["の"],["こと"],["を"],["考","かんがえ"],["て"],["した"],["の"],["です"],["。"],["すなわち"],["、"],["のち"],["の"],["日","ひ"],["に"],["なって"],["、"],["あなた"],["がた"],["の"],["子孫","しそん"],["が"],["、"],["われわれ"],["の"],["子孫","しそん"],["に"],["むかって"],["言う","いう"],["こと"],["が"],["ある"],["か"],["も"],["知れません","しれません"],["、"],["『"],["あなた"],["がた"],["は"],["、"],["イスラエル"],["の"],["神","かみ"],["、"],["主","しゅ"],["と"],["、"],["なん"],["の"],["関係","かんけい"],["が"],["ある"],["の"],["です"],["か"],["。"]]},{"verse":25,"text":"ルベンの子孫,しそんと、ガドの子孫,しそんよ、主,しゅは、あなたがたと、われわれとの間,あいだに、ヨルダンを境,さかいとされました。あなたがたは主,しゅの民,たみの特権,とっけんがありません』。こう言,いって、あなたがたの子孫,しそんが、われわれの子孫,しそんに、主,しゅを拝,おがむことをやめさせるかも知,しれないので、","tok":[["ルベン"],["の"],["子孫","しそん"],["と"],["、"],["ガド"],["の"],["子孫","しそん"],["よ"],["、"],["主","しゅ"],["は"],["、"],["あなた"],["がた"],["と"],["、"],["われわれ"],["と"],["の"],["間","あいだ"],["に"],["、"],["ヨルダン"],["を"],["境","さかい"],["と"],["されました"],["。"],["あなた"],["がた"],["は"],["主","しゅ"],["の"],["民","たみ"],["の"],["特権","とっけん"],["が"],["ありません"],["』"],["。"],["こう"],["言って","いって"],["、"],["あなた"],["がた"],["の"],["子孫","しそん"],["が"],["、"],["われわれ"],["の"],["子孫","しそん"],["に"],["、"],["主","しゅ"],["を"],["拝む","おがむ"],["こと"],["を"],["やめさせる"],["か"],["も"],["知れない","しれない"],["ので"],["、"]]},{"verse":26,"text":"われわれは言,いいました、『さあ、われわれは一つの祭壇,さいだんを築,きずこう。燔祭,はんさいのためではなく、また犠牲,ぎせいのためでもなく、","tok":[["われわれ"],["は"],["言いました","いいました"],["、"],["『"],["さあ"],["、"],["われわれ"],["は"],["一","ひと"],["つ"],["の"],["祭壇","さいだん"],["を"],["築こう","きずこう"],["。"],["燔祭","はんさい"],["の"],["ため"],["で"],["は"],["なく"],["、"],["また"],["犠牲","ぎせい"],["の"],["ため"],["で"],["も"],["なく"],["、"]]},{"verse":27,"text":"ただあなたがたと、われわれとの間,あいだ、およびわれわれの後,のちの子孫,しそんの間,あいだに、証拠,しょうことならせて、われわれが、燔祭,はんさいと犠牲,ぎせい、および酬恩祭,しゅうおんさいをもって、主,しゅの前,まえで、主,しゅにつとめをするためである。こうすれば、のちの日,ひになって、あなたがたの子孫,しそんが、われわれの子孫,しそんに、「あなたがたは主,しゅの民,たみの特権,とっけんがありません」とは言,いわないであろう』。","tok":[["ただ"],["あなた"],["がた"],["と"],["、"],["われわれ"],["と"],["の"],["間","あいだ"],["、"],["および"],["われわれ"],["の"],["後","のち"],["の"],["子孫","しそん"],["の"],["間","あいだ"],["に"],["、"],["証拠","しょうこ"],["と"],["ならせて"],["、"],["われわれ"],["が"],["、"],["燔祭","はんさい"],["と"],["犠牲","ぎせい"],["、"],["および"],["酬恩祭","しゅうおんさい"],["を"],["もって"],["、"],["主","しゅ"],["の"],["前","まえ"],["で"],["、"],["主に","しゅに"],["つとめ"],["を"],["する"],["ため"],["で"],["ある"],["。"],["こう"],["すれば"],["、"],["のち"],["の"],["日","ひ"],["に"],["なって"],["、"],["あなた"],["がた"],["の"],["子孫","しそん"],["が"],["、"],["われわれ"],["の"],["子孫","しそん"],["に"],["、"],["「"],["あなた"],["がた"],["は"],["主","しゅ"],["の"],["民","たみ"],["の"],["特権","とっけん"],["が"],["ありません"],["」"],["と"],["は"],["言わないで","いわないで"],["あろう"],["』"],["。"]]},{"verse":28,"text":"またわれわれは言,いいました、『のちの日,ひに、われわれ、またわれわれの子孫,しそんが、もしそのようなことを言,いわれるならば、その時,とき、われわれは言,いおう、「われわれの先祖,せんぞが造,つくった主,しゅの祭壇,さいだんの型,かたをごらんなさい。これは燔祭,はんさいのためではなく、また犠牲,ぎせいのためでもなく、あなたがたと、われわれとの間,あいだの証拠,しょうこである」。","tok":[["また"],["われわれ"],["は"],["言いました","いいました"],["、"],["『"],["のち"],["の"],["日","ひ"],["に"],["、"],["われわれ"],["、"],["また"],["われわれ"],["の"],["子孫","しそん"],["が"],["、"],["もし"],["その"],["よう"],["な"],["こと"],["を"],["言われるならば","いわれるならば"],["、"],["その"],["時","とき"],["、"],["われわれ"],["は"],["言おう","いおう"],["、"],["「"],["われわれ"],["の"],["先祖","せんぞ"],["が"],["造った","つくった"],["主","しゅ"],["の"],["祭壇","さいだん"],["の"],["型","かた"],["を"],["ごらん"],["なさい"],["。"],["これ"],["は"],["燔祭","はんさい"],["の"],["ため"],["で"],["は"],["なく"],["、"],["また"],["犠牲","ぎせい"],["の"],["ため"],["で"],["も"],["なく"],["、"],["あなた"],["がた"],["と"],["、"],["われわれ"],["と"],["の"],["間","あいだ"],["の"],["証拠","しょうこ"],["で"],["ある"],["」"],["。"]]},{"verse":29,"text":"主,しゅにそむき、ひるがえって今日,こんにち、主,しゅに従,したがうことをやめて、われわれの神,かみ、主,しゅの幕屋,まくやの前,まえにある祭壇,さいだんのほかに、燔祭,はんさい、素祭,そさい、または犠牲,ぎせいをささげるための祭壇,さいだんを築,きずくようなことは、決,けっしていたしません』」。","tok":[["主","しゅ"],["に"],["そむき"],["、"],["ひるがえって"],["今日","こん"],["に"],["ち"],["、"],["主に","しゅに"],["従う","したがう"],["こと"],["を"],["やめて"],["、"],["われわれ"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["幕屋","まくや"],["の"],["前","まえ"],["に"],["ある"],["祭壇","さいだん"],["の"],["ほか"],["に"],["、"],["燔祭","はんさい"],["、"],["素","す"],["祭","まつり"],["さい"],["、"],["また"],["は"],["犠牲","ぎせい"],["を"],["ささげる"],["ため"],["の"],["祭壇","さいだん"],["を"],["築く","きずく"],["よう"],["な"],["こと"],["は"],["、"],["決っして","けっして"],["いたしません"],["』"],["」"],["。"]]},{"verse":30,"text":"祭司,さいしピネハス、および会衆,かいしゅうのつかさたち、すなわち彼,かれと共,ともに行,いったイスラエルの氏族,しぞくのかしらたちは、ルベンの子孫,しそん、ガドの子孫,しそん、およびマナセの子孫,しそんが語,かたった言葉,ことばを聞,きいて、それを良,よしとした。","tok":[["祭司","さいし"],["ピネハス"],["、"],["および"],["会衆","かいしゅう"],["の"],["つかさ"],["たち"],["、"],["すなわち"],["彼","かれ"],["と"],["共","とも"],["に"],["行った","いった"],["イスラエル"],["の"],["氏族","しぞく"],["の"],["かしら"],["たち"],["は"],["、"],["ルベン"],["の"],["子孫","しそん"],["、"],["ガド"],["の"],["子孫","しそん"],["、"],["および"],["マナセ"],["の"],["子孫","しそん"],["が"],["語った","かたった"],["言葉","ことば"],["を"],["聞いて","きいて"],["、"],["それ"],["を"],["良し","よし"],["と"],["した"],["。"]]},{"verse":31,"text":"そして祭司,さいしエレアザルの子,こピネハスは、ルベンの子孫,しそん、ガドの子孫,しそん、およびマナセの子孫,しそんに言,いった、「今日,こんにち、われわれは、主,しゅがわれわれのうちにいますことを知,しった。あなたがたが、主,しゅにむかって、このとがを犯,おかさなかったからである。あなたがたは今,いま、イスラエルの人々,ひとびとを、主,しゅの手,てから救,すくい出,だしたのです」。","tok":[["そして"],["祭司","さいし"],["エレアザル"],["の"],["子","こ"],["ピネハス"],["は"],["、"],["ルベン"],["の"],["子孫","しそん"],["、"],["ガド"],["の"],["子孫","しそん"],["、"],["および"],["マナセ"],["の"],["子孫","しそん"],["に"],["言った","いった"],["、"],["「"],["今日","こん"],["に"],["ち"],["、"],["われわれ"],["は"],["、"],["主","しゅ"],["が"],["われわれ"],["の"],["うち"],["に"],["います"],["こと"],["を"],["知った","しった"],["。"],["あなた"],["が"],["た"],["が"],["、"],["主に","しゅに"],["むかって"],["、"],["この"],["とが"],["を"],["犯さなかった","おかさなかった"],["から"],["で"],["ある"],["。"],["あなた"],["がた"],["は"],["今","いま"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["を"],["、"],["主","しゅ"],["の"],["手","て"],["から"],["救い出した","すくいだした"],["の"],["です"],["」"],["。"]]},{"verse":32,"text":"こうして祭司,さいしエレアザルの子,こピネハスと、つかさたちは、ルベンの子孫,しそん、およびガドの子孫,しそんに別,わかれて、ギレアデの地,ちからカナンの地,ちに帰,かえり、イスラエルの人々,ひとびとのところに行,いって復命,ふくめいしたので、","tok":[["こう"],["して"],["祭司","さいし"],["エレアザル"],["の"],["子","こ"],["ピネハス"],["と"],["、"],["つかさ"],["たち"],["は"],["、"],["ルベン"],["の"],["子孫","しそん"],["、"],["および"],["ガド"],["の"],["子孫","しそん"],["に"],["別かれて","わかれて"],["、"],["ギレアデ"],["の"],["地","ち"],["から"],["カナン"],["の"],["地","ち"],["に"],["帰えり","かえり"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["ところ"],["に"],["行って","いって"],["復命","ふくめい"],["した"],["ので"],["、"]]},{"verse":33,"text":"イスラエルの人々,ひとびとはそれを良,よしとした。そしてイスラエルの人々,ひとびとは神,かみをほめたたえ、ルベンの子孫,しそん、およびガドの子孫,しそんの住,すんでいる国,くにを滅,ほろぼすために攻,せめ上,のぼろうとは、もはや言,いわなかった。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["は"],["それ"],["を"],["良し","よし"],["と"],["した"],["。"],["そして"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["神","かみ"],["を"],["ほめたたえ"],["、"],["ルベン"],["の"],["子孫","しそん"],["、"],["および"],["ガド"],["の"],["子孫","しそん"],["の"],["住んで","すんで"],["いる"],["国","くに"],["を"],["滅ぼす","ほろぼす"],["ため"],["に"],["攻め上ろう","せめのぼろう"],["と"],["は"],["、"],["もはや"],["言わなかった","いわなかった"],["。"]]},{"verse":34,"text":"ルベンの子孫,しそんとガドの子孫,しそんは、その祭壇,さいだんを「あかし」と名,なづけて言,いった、「これは、われわれの間,あいだにあって、主,しゅが神,かみにいますというあかしをするものである」。","tok":[["ルベン"],["の"],["子孫","しそん"],["と"],["ガド"],["の"],["子孫","しそん"],["は"],["、"],["その"],["祭壇","さいだん"],["を"],["「"],["あかし"],["」"],["と"],["名づけて","なづけて"],["言った","いった"],["、"],["「"],["これ"],["は"],["、"],["われわれ"],["の"],["間","あいだ"],["に"],["あって"],["、"],["主","しゅ"],["が"],["神","かみ"],["に"],["います"],["と"],["いう"],["あかし"],["を"],["する"],["もの"],["で"],["ある"],["」"],["。"]]}]
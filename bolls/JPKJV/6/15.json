[{"verse":1,"text":"ユダの人々,ひとびとの部族,ぶぞくが、その家族,かぞくにしたがって、くじで獲,えた地,ちは、南,みなみの方,ほうでは、エドムの境,さかいに達,たっし、南,みなみのはてにあるチンの荒野,あらのに及,およんでいた。","tok":[["ユダ"],["の"],["人々","ひとびと"],["の"],["部族","ぶぞく"],["が"],["、"],["その"],["家族","かぞく"],["に"],["したがって"],["、"],["くじ"],["で"],["獲た","えた"],["地","ち"],["は"],["、"],["南","みなみ"],["の"],["方","ほう"],["で"],["は"],["、"],["エドム"],["の"],["境","さかい"],["に"],["達し","たっし"],["、"],["南","みなみ"],["の"],["はて"],["に"],["ある"],["チン"],["の"],["荒野","あらの"],["に"],["及んで","およんで"],["いた"],["。"]]},{"verse":2,"text":"その南,みなみの境,さかいは、塩,しおの海,うみの南,みなみの端,はしの、入海,いりうみから起,おこり、","tok":[["その"],["南","みなみ"],["の"],["境","さかい"],["は"],["、"],["塩","しお"],["の"],["海","うみ"],["の"],["南","みなみ"],["の"],["端","はし"],["の"],["、"],["入海","いりうみ"],["から"],["起こり","おこり"],["、"]]},{"verse":3,"text":"アクラビムの坂,さかの南,みなみに出,でてチンに進,すすみ、カデシ・バルネアの南,みなみから上,のぼって、ヘヅロンに進,すすみ、アダルに上,のぼっていって、カルカに回,まわり、","tok":[["アクラビム"],["の"],["坂","さか"],["の"],["南","みなみ"],["に"],["出て","でて"],["チン"],["に"],["進み","すすみ"],["、"],["カデシ"],["・"],["バルネア"],["の"],["南","みなみ"],["から"],["上って","のぼって"],["、"],["ヘヅロン"],["に"],["進み","すすみ"],["、"],["アダル"],["に"],["上って","のぼって"],["いって"],["、"],["カルカ"],["に"],["回わり","まわり"],["、"]]},{"verse":4,"text":"アヅモンに進,すすんで、エジプトの川,かわに達,たっし、その境,さかいは海,うみに至,いたって尽,つきる。これが彼,かれらの南,みなみの境,さかいである。","tok":[["アヅモン"],["に"],["進んで","すすんで"],["、"],["エジプト"],["の"],["川","かわ"],["に"],["達し","たっし"],["、"],["その"],["境","さかい"],["は"],["海","うみ"],["に"],["至って","いたって"],["尽る","つきる"],["。"],["これ"],["が"],["彼","かれ"],["ら"],["の"],["南","みなみ"],["の"],["境","さかい"],["で"],["ある"],["。"]]},{"verse":5,"text":"東,ひがしの境,さかいは塩,しおの海,うみであって、ヨルダンの川口,かわぐちに達,たっする。北,きたの方,ほうの境,さかいは、ヨルダンの川口,かわぐちの、入海,いりうみから起,おこり、","tok":[["東","ひがし"],["の"],["境","さかい"],["は"],["塩","しお"],["の"],["海","うみ"],["で"],["あって"],["、"],["ヨルダン"],["の"],["川口","かわぐち"],["に"],["達する","たっする"],["。"],["北","きた"],["の"],["方","ほう"],["の"],["境","さかい"],["は"],["、"],["ヨルダン"],["の"],["川口","かわぐち"],["の"],["、"],["入海","いりうみ"],["から"],["起こり","おこり"],["、"]]},{"verse":6,"text":"上,のぼってベテホグラに行,いき、ベテアラバの北,きたを過,すぎ、上,のぼってルベンびとボハンの石,いしに達,たっし、","tok":[["上って","のぼって"],["ベテホグラ"],["に"],["行き","いき"],["、"],["ベテアラバ"],["の"],["北","きた"],["を"],["過","すぎ"],["、"],["上って","のぼって"],["ルベン"],["びと"],["ボハン"],["の"],["石","いし"],["に"],["達し","たっし"],["、"]]},{"verse":7,"text":"またアコルの谷,たにからデビルに上,のぼって、北,きたにおもむき、川,かわの南,みなみにあるアドミムの坂,さかに対,たいするギルガルに向,むかって進,すすみ、エンシメシの水,みずに達,たっし、エンロゲルに至,いたって尽,つきる。","tok":[["また"],["アコル"],["の"],["谷","たに"],["から"],["デビル"],["に"],["上って","のぼって"],["、"],["北","きた"],["に"],["おもむき"],["、"],["川","かわ"],["の"],["南","みなみ"],["に"],["ある"],["アドミム"],["の"],["坂","さか"],["に"],["対する","たいする"],["ギルガル"],["に"],["向かって","むかって"],["進み","すすみ"],["、"],["エンシメシ"],["の"],["水","みず"],["に"],["達し","たっし"],["、"],["エンロゲル"],["に"],["至って","いたって"],["尽る","つきる"],["。"]]},{"verse":8,"text":"またその境,さかいはベンヒンノムの谷,たにに沿,そって、エブスびとの地,ち、すなわちエルサレムの南,みなみのわきに上,のぼり、ヒンノムの谷,たにの西,にしにある山,やまの頂,いただきに上,のぼる。これはレパイムの谷,たにの北,きたの果,はてにあるものである。","tok":[["また"],["その"],["境","さかい"],["は"],["ベンヒンノム"],["の"],["谷","たに"],["に"],["沿って","そって"],["、"],["エブス"],["びと"],["の"],["地","ち"],["、"],["すなわち"],["エルサレム"],["の"],["南","みなみ"],["の"],["わき"],["に"],["上り","のぼり"],["、"],["ヒンノム"],["の"],["谷","たに"],["の"],["西","にし"],["に"],["ある"],["山","やま"],["の"],["頂","いただき"],["に"],["上る","のぼる"],["。"],["これ"],["は"],["レパイム"],["の"],["谷","たに"],["の"],["北","きた"],["の"],["果て","はて"],["に"],["ある"],["もの"],["で"],["ある"],["。"]]},{"verse":9,"text":"その境,さかいは、この山,やまの頂,いただきからネフトアの水,みずの源,みなもとに至,いたり、その所,ところからエフロン山,やまの町々,まちまちに及,および、その境,さかいは曲,まがってバアラに達,たっする。これは、すなわちキリアテ・ヤリムである。","tok":[["その"],["境","さかい"],["は"],["、"],["この"],["山","やま"],["の"],["頂","いただき"],["から"],["ネフトア"],["の"],["水","みず"],["の"],["源","みなもと"],["に"],["至","いたり"],["、"],["その"],["所","ところ"],["から"],["エフロン"],["山","やま"],["の"],["町々","まちまち"],["に"],["及","および"],["、"],["その"],["境","さかい"],["は"],["曲がって","まがって"],["バアラ"],["に"],["達する","たっする"],["。"],["これ"],["は"],["、"],["すなわち"],["キリアテ"],["・"],["ヤリム"],["で"],["ある"],["。"]]},{"verse":10,"text":"その境,さかいは、バアラから西,にしに回,まわって、セイル山,やまに及,および、ヤリム山,やま、すなわちケサロンの北,きたのわきを経,へて、ベテシメシに下,くだり、テムナに進,すすみ、","tok":[["その"],["境","さかい"],["は"],["、"],["バアラ"],["から"],["西","にし"],["に"],["回わって","まわって"],["、"],["セイル山","せいるやま"],["に"],["及","および"],["、"],["ヤリム山","やりむやま"],["、"],["すなわち"],["ケサロン"],["の"],["北","きた"],["の"],["わき"],["を"],["経て","へて"],["、"],["ベテシメシ"],["に"],["下り","くだり"],["、"],["テムナ"],["に"],["進み","すすみ"],["、"]]},{"verse":11,"text":"エクロンの北,きたの丘,おかのわきに出,でて、シッケロンに曲,まがり、バアラ山,やまに進,すすみ、ヤブネルに達,たっし、海,うみに至,いたって尽,つきる。","tok":[["エクロン"],["の"],["北","きた"],["の"],["丘","おか"],["の"],["わき"],["に"],["出て","でて"],["、"],["シッケロン"],["に"],["曲がり","まがり"],["、"],["バアラ"],["山","やま"],["に"],["進み","すすみ"],["、"],["ヤブネル"],["に"],["達し","たっし"],["、"],["海","うみ"],["に"],["至って","いたって"],["尽る","つきる"],["。"]]},{"verse":12,"text":"また西,にしの境,さかいは大海,たいかいであって、海岸,かいがんを境,さかいとした。これがユダの人々,ひとびとの、その家族,かぞくにしたがって獲,えた地,ちの四方,しほうの境,さかいである。","tok":[["また"],["西","にし"],["の"],["境","さかい"],["は"],["大海","たいかい"],["で"],["あって"],["、"],["海岸","かいがん"],["を"],["境","さかい"],["と"],["した"],["。"],["これ"],["が"],["ユダ"],["の"],["人々","ひとびと"],["の"],["、"],["その"],["家族","かぞく"],["に"],["したがって"],["獲た","えた"],["地","ち"],["の"],["四方","しほう"],["の"],["境","さかい"],["で"],["ある"],["。"]]},{"verse":13,"text":"ヨシュアは、主,しゅに命,めいじられたように、エフンネの子,こカレブに、ユダの人々,ひとびとのうちで、キリアテ・アルバ、すなわちヘブロンを与,あたえて、その分,ぶんとさせた。アルバはアナクの父,ちちであった。","tok":[["ヨシュア"],["は"],["、"],["主に","しゅに"],["命じられた","めいじられた"],["よう"],["に"],["、"],["エフンネ"],["の"],["子","こ"],["カレブ"],["に"],["、"],["ユダ"],["の"],["人々","ひとびと"],["の"],["うち"],["で"],["、"],["キリアテ"],["・"],["アルバ"],["、"],["すなわち"],["ヘブロン"],["を"],["与","あたえ"],["て"],["、"],["その"],["分","ぶん"],["と"],["させた"],["。"],["アルバ"],["は"],["アナク"],["の"],["父","ちち"],["で"],["あった"],["。"]]},{"verse":14,"text":"カレブはその所,ところから、アナクの子,こ三人,にんを追,おい払,はらった。すなわち、セシャイ、アヒマン、およびタルマイであって、アナクから出,でたものである。","tok":[["カレブ"],["は"],["その"],["所","ところ"],["から"],["、"],["アナク"],["の"],["子","こ"],["三人","にん"],["を"],["追い払った","おいはらった"],["。"],["すなわち"],["、"],["セシャイ"],["、"],["アヒマン"],["、"],["および"],["タルマイ"],["で"],["あって"],["、"],["アナク"],["から"],["出た","でた"],["もの"],["で"],["ある"],["。"]]},{"verse":15,"text":"そして彼,かれはこの所,ところからデビルに住,すむ民,たみの所,ところに攻,せめ上,のぼった。デビルの名,なは、もとはキリアテ・セペルといった。","tok":[["そして"],["彼","かれ"],["は"],["この"],["所","ところ"],["から"],["デビル"],["に"],["住む","すむ"],["民","たみ"],["の"],["所","ところ"],["に"],["攻め上った","せめのぼった"],["。"],["デビル"],["の"],["名","な"],["は"],["、"],["もと"],["は"],["キリアテ"],["・"],["セペル"],["と"],["いった"],["。"]]},{"verse":16,"text":"カレブは言,いった、「キリアテ・セペルを撃,うって、これを取,とる者,ものには、わたしの娘,むすめアクサを妻,つまとして与,あたえるであろう」。","tok":[["カレブ"],["は"],["言った","いった"],["、"],["「"],["キリアテ"],["・"],["セペル"],["を"],["撃って","うって"],["、"],["これ"],["を"],["取る","とる"],["者","もの"],["に"],["は"],["、"],["わたし"],["の"],["娘","むすめ"],["アクサ"],["を"],["妻","つま"],["として"],["与えるで","あたえるで"],["あろう"],["」"],["。"]]},{"verse":17,"text":"ケナズの子,こで、カレブの弟,おとうとオテニエルがそれを取,とったので、カレブは娘,むすめアクサを、妻,つまとして彼,かれに与,あたえた。","tok":[["ケナズ"],["の"],["子","こ"],["で"],["、"],["カレブ"],["の"],["弟","おとうと"],["オテニエル"],["が"],["それ"],["を"],["取った","とった"],["ので"],["、"],["カレブ"],["は"],["娘","むすめ"],["アクサ"],["を"],["、"],["妻","つま"],["として"],["彼","かれ"],["に"],["与","あたえ"],["た"],["。"]]},{"verse":18,"text":"彼女,かのじょがとつぐ時,とき、畑,はたけを父,ちちに求,もとめるようにと、オテニエルに勧,すすめられた。そして彼女,かのじょが、ろばから降,ふりたので、カレブは彼女,かのじょに、何,なにを望,のぞむのかとたずねた。","tok":[["彼女","かのじょ"],["が"],["とつぐ"],["時","とき"],["、"],["畑","はたけ"],["を"],["父","ちち"],["に"],["求める","もとめる"],["よう"],["に"],["と"],["、"],["オテニエル"],["に"],["勧められた","すすめられた"],["。"],["そして"],["彼女","かのじょ"],["が"],["、"],["ろば"],["から"],["降","ふりた"],["ので"],["、"],["カレブ"],["は"],["彼女","かのじょ"],["に"],["、"],["何に","なに"],["を"],["望む","のぞむ"],["の"],["か"],["と"],["たずねた"],["。"]]},{"verse":19,"text":"彼女,かのじょは答,こたえて言,いった、「わたしに贈,おくり物,ものをください。あなたはネゲブの地,ちに、わたしをやられるのですから、泉,いずみをもください」。カレブは彼女,かのじょに上,うえの泉,いずみと下,したの泉,いずみとを与,あたえた。","tok":[["彼女","かのじょ"],["は"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["わたし"],["に"],["贈り物","おくりもの"],["を"],["ください"],["。"],["あなた"],["は"],["ネゲブ"],["の"],["地","ち"],["に"],["、"],["わたし"],["を"],["やられる"],["の"],["です"],["から"],["、"],["泉","いずみ"],["を"],["も"],["ください"],["」"],["。"],["カレブ"],["は"],["彼女","かのじょ"],["に"],["上","うえ"],["の"],["泉","いずみ"],["と"],["下","した"],["の"],["泉","いずみ"],["と"],["を"],["与","あたえ"],["た"],["。"]]},{"verse":20,"text":"ユダの人々,ひとびとの部族,ぶぞくが、その家族,かぞくにしたがって獲,えた嗣,し業,ぎょうは、次,つぎのとおりである。","tok":[["ユダ"],["の"],["人々","ひとびと"],["の"],["部族","ぶぞく"],["が"],["、"],["その"],["家族","かぞく"],["に"],["したがって"],["獲た","えた"],["嗣業","しぎょう"],["は"],["、"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"]]},{"verse":21,"text":"ユダの人々,ひとびとの部族,ぶぞくが、南,みなみでエドムの境,さかいの方,ほうにもっていた遠,とおくの町々,まちまちは、カブジエル、エデル、ヤグル、","tok":[["ユダ"],["の"],["人々","ひとびと"],["の"],["部族","ぶぞく"],["が"],["、"],["南","みなみ"],["で"],["エドム"],["の"],["境","さかい"],["の"],["方","ほう"],["に"],["もって"],["いた"],["遠く","とおく"],["の"],["町々","まちまち"],["は"],["、"],["カブジエル"],["、"],["エデル"],["、"],["ヤグル"],["、"]]},{"verse":22,"text":"キナ、デモナ、アダダ、","tok":[["キナ"],["、"],["デモナ"],["、"],["アダダ"],["、"]]},{"verse":23,"text":"ケデシ、ハゾル、イテナン、","tok":[["ケデシ"],["、"],["ハゾル"],["、"],["イテナン"],["、"]]},{"verse":24,"text":"ジフ、テレム、ベアロテ、","tok":[["ジフ"],["、"],["テレム"],["、"],["ベアロテ"],["、"]]},{"verse":25,"text":"ハゾル・ハダッタ、ケリオテ・ヘヅロンすなわちハゾル、","tok":[["ハゾル"],["・"],["ハダッタ"],["、"],["ケリオテ"],["・"],["ヘヅロン"],["すなわち"],["ハゾル"],["、"]]},{"verse":26,"text":"アマム、シマ、モラダ、","tok":[["アマム"],["、"],["シマ"],["、"],["モラダ"],["、"]]},{"verse":27,"text":"ハザルガダ、ヘシモン、ベテペレテ、","tok":[["ハザルガダ"],["、"],["ヘシモン"],["、"],["ベテペレテ"],["、"]]},{"verse":28,"text":"ハザル・シュアル、ベエルシバ、ビジョテヤ、","tok":[["ハザル"],["・"],["シュアル"],["、"],["ベエルシバ"],["、"],["ビジョテヤ"],["、"]]},{"verse":29,"text":"バアラ、イイム、エゼム、","tok":[["バアラ"],["、"],["イイム"],["、"],["エゼム"],["、"]]},{"verse":30,"text":"エルトラデ、ケシル、ホルマ、","tok":[["エルトラデ"],["、"],["ケシル"],["、"],["ホルマ"],["、"]]},{"verse":31,"text":"チクラグ、マデマンナ、サンサンナ、","tok":[["チクラグ"],["、"],["マデマンナ"],["、"],["サンサンナ"],["、"]]},{"verse":32,"text":"レバオテ、シルヒム、アイン、リンモン。これらの町,まちは合,あわせて二十九、ならびにそれに属,ぞくする村々,むらむら。","tok":[["レバオテ"],["、"],["シルヒム"],["、"],["アイン"],["、"],["リンモン"],["。"],["これ"],["ら"],["の"],["町","まち"],["は"],["合","あわせ"],["て"],["二十九","にじゅうきゅう"],["、"],["ならびに"],["それ"],["に"],["属する","ぞくする"],["村々","むらむら"],["。"]]},{"verse":33,"text":"平地,へいちでは、エシタオル、ゾラ、アシナ、","tok":[["平地","へいち"],["で"],["は"],["、"],["エシタオル"],["、"],["ゾラ"],["、"],["アシナ"],["、"]]},{"verse":34,"text":"ザノア、エンガンニム、タップア、エナム、","tok":[["ザノア"],["、"],["エンガンニム"],["、"],["タップア"],["、"],["エナム"],["、"]]},{"verse":35,"text":"ヤルムテ、アドラム、ソコ、アゼカ、","tok":[["ヤルムテ"],["、"],["アドラム"],["、"],["ソコ"],["、"],["アゼカ"],["、"]]},{"verse":36,"text":"シャアライム、アデタイム
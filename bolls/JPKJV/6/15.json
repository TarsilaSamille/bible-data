":48,"text":"山地,さんちでは、シャミル、ヤッテル、ソコ、","tok":[["山地","さんち"],["で"],["は"],["、"],["シャミル"],["、"],["ヤッテル"],["、"],["ソコ"],["、"]]},{"verse":49,"text":"ダンナ、キリアテ・サンナすなわちデビル、","tok":[["ダンナ"],["、"],["キリアテ"],["・"],["サンナ"],["すなわち"],["デビル"],["、"]]},{"verse":50,"text":"アナブ、エシテモ、アニム、","tok":[["アナブ"],["、"],["エシテモ"],["、"],["アニム"],["、"]]},{"verse":51,"text":"ゴセン、ホロン、ギロ。すなわち十一の町々,まちまちと、それに属,ぞくする村々,むらむら。","tok":[["ゴセン"],["、"],["ホロン"],["、"],["ギロ"],["。"],["すなわち"],["十一","じゅういち"],["の"],["町々","まちまち"],["と"],["、"],["それ"],["に"],["属する","ぞくする"],["村々","むらむら"],["。"]]},{"verse":52,"text":"アラブ、ドマ、エシャン、","tok":[["アラブ"],["、"],["ドマ"],["、"],["エシャン"],["、"]]},{"verse":53,"text":"ヤニム、ベテタップア、アペカ、","tok":[["ヤニム"],["、"],["ベテタップア"],["、"],["アペカ"],["、"]]},{"verse":54,"text":"ホムタ、キリアテ・アルバすなわちヘブロン、ヂオル。すなわち九つの町々,まちまちと、それに属,ぞくする村々,むらむら。","tok":[["ホムタ"],["、"],["キリアテ"],["・"],["アルバ"],["すなわち"],["ヘブロン"],["、"],["ヂオル"],["。"],["すなわち"],["九","ここの"],["つ"],["の"],["町々","まちまち"],["と"],["、"],["それ"],["に"],["属する","ぞくする"],["村々","むらむら"],["。"]]},{"verse":55,"text":"マオン、カルメル、ジフ、ユッタ、","tok":[["マオン"],["、"],["カルメル"],["、"],["ジフ"],["、"],["ユッタ"],["、"]]},{"verse":56,"text":"エズレル、ヨクデアム、ザノア、","tok":[["エズレル"],["、"],["ヨクデアム"],["、"],["ザノア"],["、"]]},{"verse":57,"text":"カイン、ギベア、テムナ。すなわち十の町々,まちまちと、それに属,ぞくする村々,むらむら。","tok":[["カイン"],["、"],["ギベア"],["、"],["テムナ"],["。"],["すなわち"],["十","じゅう"],["の"],["町々","まちまち"],["と"],["、"],["それ"],["に"],["属する","ぞくする"],["村々","むらむら"],["。"]]},{"verse":58,"text":"ハルホル、ベテズル、ゲドル、","tok":[["ハルホル"],["、"],["ベテズル"],["、"],["ゲドル"],["、"]]},{"verse":59,"text":"マアラテ、ベテアノテ、エルテコン。すなわち六つの町々,まちまちと、それに属,ぞくする村々,むらむら。","tok":[["マアラテ"],["、"],["ベテアノテ"],["、"],["エルテコン"],["。"],["すなわち"],["六","むい"],["つ"],["の"],["町々","まちまち"],["と"],["、"],["それ"],["に"],["属する","ぞくする"],["村々","むらむら"],["。"]]},{"verse":60,"text":"キリアテ・バアルすなわちキリアテ・ヤリム、ラバ。これらの二つの町,まちとそれに属,ぞくする村々,むらむら。","tok":[["キリアテ"],["・"],["バアル"],["すなわち"],["キリアテ"],["・"],["ヤリム"],["、"],["ラバ"],["。"],["これ"],["ら"],["の"],["二","ふた"],["つ"],["の"],["町","まち"],["と"],["それ"],["に"],["属する","ぞくする"],["村々","むらむら"],["。"]]},{"verse":61,"text":"荒野,あらのでは、ベテアラバ、ミデン、セカカ、","tok":[["荒野","あら"],["ので"],["は"],["、"],["ベテアラバ"],["、"],["ミデン"],["、"],["セカカ"],["、"]]},{"verse":62,"text":"ニブシャン、塩,しおの町,まち、エンゲデ。すなわち六つの町々,まちまちと、それに属,ぞくする村々,むらむら。","tok":[["ニブシャン"],["、"],["塩","しお"],["の"],["町","まち"],["、"],["エンゲデ"],["。"],["すなわち"],["六","むい"],["つ"],["の"],["町々","まちまち"],["と"],["、"],["それ"],["に"],["属する","ぞくする"],["村々","むらむら"],["。"]]},{"verse":63,"text":"しかし、ユダの人々,ひとびとは、エルサレムの住民,じゅうみんエブスびとを追,おい払,はらうことができなかった。それでエブスびとは今日,こんにちまで、ユダの人々,ひとびとと共,ともにエルサレムに住,すんでいる。","tok":[["しかし"],["、"],["ユダ"],["の"],["人々","ひとびと"],["は"],["、"],["エルサレム"],["の"],["住民","じゅうみん"],["エブス"],["びと"],["を"],["追い払う","おいはらう"],["こと"],["が"],["できなかった"],["。"],["それ"],["で"],["エブス"],["びと"],["は"],["今日","こん"],["に"],["ち"],["まで"],["、"],["ユダ"],["の"],["人々","ひとびと"],["と"],["共","とも"],["に"],["エルサレム"],["に"],["住んで","すんで"],["いる"],["。"]]}]
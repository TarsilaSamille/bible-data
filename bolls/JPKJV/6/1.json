[{"verse":1,"text":"主,しゅのしもべモーセが死,しんだ後,のち、主,しゅはモーセの従者,じゅうしゃ、ヌンの子,こヨシュアに言,いわれた、","tok":[["主","しゅ"],["の"],["しもべ"],["モーセ"],["が"],["死んだ","しんだ"],["後","の"],["ち"],["、"],["主","しゅ"],["は"],["モーセ"],["の"],["従者","じゅうしゃ"],["、"],["ヌン"],["の"],["子","こ"],["ヨシュア"],["に"],["言われた","いわれた"],["、"]]},{"verse":2,"text":"「わたしのしもべモーセは死,しんだ。それゆえ、今,いまあなたと、このすべての民,たみとは、共,ともに立,たって、このヨルダンを渡,わたり、わたしがイスラエルの人々,ひとびとに与,あたえる地,ちに行,いきなさい。","tok":[["「"],["わたし"],["の"],["しもべ"],["モーセ"],["は"],["死んだ","しんだ"],["。"],["それ"],["ゆえ"],["、"],["今","いま"],["あなた"],["と"],["、"],["この"],["すべて"],["の"],["民","たみ"],["と"],["は"],["、"],["共","とも"],["に"],["立って","たって"],["、"],["この"],["ヨルダン"],["を"],["渡り","わたり"],["、"],["わたし"],["が"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["与える","あたえる"],["地","ち"],["に"],["行き","いき"],["なさい"],["。"]]},{"verse":3,"text":"あなたがたが、足,あしの裏,うらで踏,ふむ所,ところはみな、わたしがモーセに約束,やくそくしたように、あなたがたに与,あたえるであろう。","tok":[["あなた"],["が"],["た"],["が"],["、"],["足","あし"],["の"],["裏","うら"],["で"],["踏む","ふむ"],["所","ところ"],["は"],["みな"],["、"],["わたし"],["が"],["モーセ"],["に"],["約束","やくそく"],["した"],["よう"],["に"],["、"],["あなた"],["がた"],["に"],["与えるで","あたえるで"],["あろう"],["。"]]},{"verse":4,"text":"あなたがたの領域,りょういきは、荒野,あらのからレバノンに及,および、また大川,おおかわユフラテからヘテびとの全,ぜん地,ちにわたり、日,ひの入,いる方,ほうの大海,たいかいに達,たっするであろう。","tok":[["あなた"],["がた"],["の"],["領域","りょういき"],["は"],["、"],["荒野","あら"],["の"],["から"],["レバノン"],["に"],["及","および"],["、"],["また"],["大川","おおかわ"],["ユフラテ"],["から"],["ヘテ"],["びと"],["の"],["全地","ぜんち"],["に"],["わたり"],["、"],["日","ひ"],["の"],["入る","いる"],["方","ほう"],["の"],["大海","たいかい"],["に"],["達するで","たっするで"],["あろう"],["。"]]},{"verse":5,"text":"あなたが生,いきながらえる日,ひの間,あいだ、あなたに当,あたることのできる者,ものは、ひとりもないであろう。わたしは、モーセと共,ともにいたように、あなたと共,ともにおるであろう。わたしはあなたを見放,みはなすことも、見捨,みすてることもしない。","tok":[["あなた"],["が"],["生きながらえる","いきながらえる"],["日","ひ"],["の"],["間","あいだ"],["、"],["あなた"],["に"],["当たる","あたる"],["こと"],["の"],["できる"],["者","もの"],["は"],["、"],["ひとり"],["も"],["ないで"],["あろう"],["。"],["わたし"],["は"],["、"],["モーセ"],["と"],["共","とも"],["に"],["いた"],["よう"],["に"],["、"],["あなた"],["と"],["共","とも"],["に"],["おるで"],["あろう"],["。"],["わたし"],["は"],["あなた"],["を"],["見放す","みはなす"],["こと"],["も"],["、"],["見捨てる","みすてる"],["こと"],["も"],["しない"],["。"]]},{"verse":6,"text":"強,つよく、また雄々,おおしくあれ。あなたはこの民,たみに、わたしが彼,かれらに与,あたえると、その先祖,せんぞたちに誓,ちかった地,ちを獲,えさせなければならない。","tok":[["強く","つよく"],["、"],["また"],["雄々しく","おおしく"],["あれ"],["。"],["あなた"],["は"],["この"],["民","たみ"],["に"],["、"],["わたし"],["が"],["彼","かれ"],["ら"],["に"],["与える","あたえる"],["と"],["、"],["その"],["先祖","せんぞ"],["たち"],["に"],["誓った","ちかった"],["地","ち"],["を"],["獲させなければ","えさせなければ"],["ならない"],["。"]]},{"verse":7,"text":"ただ強,つよく、また雄々,おおしくあって、わたしのしもべモーセがあなたに命,めいじた律法,りっぽうをことごとく守,まもって行,おこない、これを離,はなれて右,みぎにも左,ひだりにも曲,まがってはならない。それはすべてあなたが行,いくところで、勝利,しょうりを得,えるためである。","tok":[["ただ"],["強く","つよく"],["、"],["また"],["雄々しく","おおしく"],["あって"],["、"],["わたし"],["の"],["しもべ"],["モーセ"],["が"],["あなた"],["に"],["命じた","めいじた"],["律法","りっぽう"],["を"],["ことごとく"],["守って","まもって"],["行ない","おこない"],["、"],["これ"],["を"],["離れて","はなれて"],["右","みぎ"],["に"],["も"],["左","ひだり"],["に"],["も"],["曲がって","まがって"],["は"],["ならない"],["。"],["それ"],["は"],["すべて"],["あなた"],["が"],["行く","いく"],["ところ"],["で"],["、"],["勝利","しょうり"],["を"],["得る","える"],["ため"],["で"],["ある"],["。"]]},{"verse":8,"text":"この律法,りっぽうの書,しょをあなたの口,くちから離,はなすことなく、昼,ひるも夜,よるもそれを思,おもい、そのうちにしるされていることを、ことごとく守,まもって行,おこなわなければならない。そうするならば、あなたの道,みちは栄,さかえ、あなたは勝利,しょうりを得,えるであろう。","tok":[["この"],["律法","りっぽう"],["の"],["書","しょ"],["を"],["あなた"],["の"],["口","くち"],["から"],["離す","はなす"],["こと"],["なく"],["、"],["昼","ひる"],["も"],["夜","よる"],["も"],["それ"],["を"],["思い","おもい"],["、"],["その"],["うち"],["に"],["しるされて"],["いる"],["こと"],["を"],["、"],["ことごとく"],["守って","まもって"],["行なわなければ","おこなわなければ"],["ならない"],["。"],["そう"],["するならば"],["、"],["あなた"],["の"],["道","みち"],["は"],["栄","さかえ"],["、"],["あなた"],["は"],["勝利","しょうり"],["を"],["得るで","えるで"],["あろう"],["。"]]},{"verse":9,"text":"わたしはあなたに命,めいじたではないか。強,つよく、また雄々,おおしくあれ。あなたがどこへ行,いくにも、あなたの神,かみ、主,しゅが共,ともにおられるゆえ、恐,おそれてはならない、おののいてはならない」。","tok":[["わたし"],["は"],["あなた"],["に"],["命じたで","めいじたで"],["は"],["ない"],["か"],["。"],["強く","つよく"],["、"],["また"],["雄々しく","おおしく"],["あれ"],["。"],["あなた"],["が"],["どこ"],["へ"],["行く","いく"],["に"],["も"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["共","とも"],["に"],["おられる"],["ゆえ"],["、"],["恐れて","おそれて"],["は"],["ならない"],["、"],["おののいて"],["は"],["ならない"],["」"],["。"]]},{"verse":10,"text":"そこでヨシュアは民,たみのつかさたちに命,めいじて言,いった、","tok":[["そこ"],["で"],["ヨシュア"],["は"],["民","たみ"],["の"],["つかさ"],["たち"],["に"],["命じて","めいじて"],["言った","いった"],["、"]]},{"verse":11,"text":"「宿営,しゅくえいのなかを巡,めぐって民,たみに命,めいじて言,いいなさい、『糧食,りょうしょくの備,そなえをしなさい。三日,かのうちに、あなたがたはこのヨルダンを渡,わたって、あなたがたの神,かみ、主,しゅがあなたがたに与,あたえて獲,えさせようとされる地,ちを獲,えるために、進,すすみ行,いかなければならないからである』」。","tok":[["「"],["宿営","しゅくえい"],["の"],["なか"],["を"],["巡って","めぐって"],["民","たみ"],["に"],["命じて","めいじて"],["言い","いい"],["なさい"],["、"],["『"],["糧食","りょうしょく"],["の"],["備","そなえ"],["を"],["し"],["なさい"],["。"],["三日","か"],["の"],["うち"],["に"],["、"],["あなた"],["がた"],["は"],["この"],["ヨルダン"],["を"],["渡って","わたって"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["あなた"],["がた"],["に"],["与","あたえ"],["て"],["獲させよう","えさせよう"],["と"],["される"],["地","ち"],["を"],["獲る","える"],["ため"],["に"],["、"],["進み","すすみ"],["行かなければ","いかなければ"],["ならない"],["から"],["で"],["ある"],["』"],["」"],["。"]]},{"verse":12,"text":"ヨシュアはまたルベンびと、ガドびと、およびマナセの半,はん部族,ぶぞくに言,いった、","tok":[["ヨシュア"],["は"],["また"],["ルベン"],["び"],["と"],["、"],["ガド"],["び"],["と"],["、"],["および"],["マナセ"],["の"],["半","はん"],["部族","ぶぞく"],["に"],["言った","いった"],["、"]]},{"verse":13,"text":"「主,しゅのしもべモーセがあなたがたに命,めいじて、『あなたがたの神,かみ、主,しゅはあなたがたのために安息,あんそくの場所,ばしょを備,そなえ、この地,ちをあなたがたに賜,たまわるであろう』と言,いった言葉,ことばを記憶,きおくしなさい。","tok":[["「"],["主","しゅ"],["の"],["しもべ"],["モーセ"],["が"],["あなた"],["がた"],["に"],["命じて","めいじて"],["、"],["『"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["あなた"],["がた"],["の"],["ため"],["に"],["安息","あんそく"],["の"],["場所","ばしょ"],["を"],["備","そなえ"],["、"],["この"],["地","ち"],["を"],["あなた"],["がた"],["に"],["賜わるで","たまわるで"],["あろう"],["』"],["と"],["言った","いった"],["言葉","ことば"],["を"],["記憶","きおく"],["し"],["なさい"],["。"]]},{"verse":14,"text":"あなたがたの妻子,さいしと家畜,かちくとは、モーセがあなたがたに与,あたえたヨルダンのこちら側,がわの地,ちにとどまらなければならない。しかし、あなたがたのうちの勇士,ゆうしはみな武装,ぶそうして、兄弟,きょうだいたちの先,さきに立,たって渡,わたり、これを助,たすけなければならない。","tok":[["あなた"],["がた"],["の"],["妻子","さいし"],["と"],["家畜","かちく"],["と"],["は"],["、"],["モーセ"],["が"],["あなた"],["がた"],["に"],["与","あたえ"],["た"],["ヨルダン"],["の"],["こちら側","こちらがわ"],["の"],["地","ち"],["に"],["とどまらなければ"],["ならない"],["。"],["しかし"],["、"],["あなた"],["がた"],["の"],["うち"],["の"],["勇士","ゆうし"],["は"],["みな"],["武装","ぶそう"],["して"],["、"],["兄弟","きょうだい"],["たち"],["の"],["先","さき"],["に"],["立って","たって"],["渡り","わたり"],["、"],["これ"],["を"],["助けなければ","たすけなければ"],["ならない"],["。"]]},{"verse":15,"text":"そして主,しゅがあなたがたに賜,たまわったように、あなたがたの兄弟,きょうだいたちにも安息,あんそくを賜,たまわり、彼,かれらもあなたがたの神,かみ、主,しゅが賜,たまわる地,ちを獲,えるようになるならば、あなたがたは、主,しゅのしもべモーセから与,あたえられた、ヨルダンのこちら側,がわ、日,ひの出,での方,ほうにある、あなたがたの所有,しょゆうの地,ちに帰,かえって、それを保,たもつことができるであろう」。","tok":[["そして"],["主","しゅ"],["が"],["あなた"],["がた"],["に"],["賜わった","たまわった"],["よう"],["に"],["、"],["あなた"],["がた"],["の"],["兄弟","きょうだい"],["たち"],["に"],["も"],["安息","あんそく"],["を"],["賜わり","たまわり"],["、"],["彼","かれ"],["ら"],["も"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["賜わる","たまわる"],["地","ち"],["を"],["獲る","える"],["よう"],["に"],["なるならば"],["、"],["あなた"],["がた"],["は"],["、"],["主","しゅ"],["の"],["しもべ"],["モーセ"],["から"],["与えられた","あたえられた"],["、"],["ヨルダン"],["の"],["こちら側","こちらがわ"],["、"],["日の出","ひので"],["の"],["方","ほう"],["に"],["ある"],["、"],["あなた"],["がた"],["の"],["所有","しょゆう"],["の"],["地","ち"],["に"],["帰えって","かえって"],["、"],["それ"],["を"],["保つ","たもつ"],["こと"],["が"],["できるで"],["あろう"],["」"],["。"]]},{"verse":16,"text":"彼,かれらはヨシュアに答,こたえた、「あなたがわれわれに命,めいじられたことをみな行,おこないます。あなたがつかわされる所,ところへは、どこへでも行,いきます。","tok":[["彼","かれ"],["ら"],["は"],["ヨシュア"],["に"],["答","こたえ"],["た"],["、"],["「"],["あなた"],["が"],["われわれ"],["に"],["命じられた","めいじられた"],["こと"],["を"],["みな"],["行ないます","おこないます"],["。"],["あなた"],["が"],["つかわされる"],["所","ところ"],["へ"],["は"],["、"],["どこ"],["へ"],["で"],["も"],["行きます","いきます"],["。"]]},{"verse":17,"text":"われわれはすべてのことをモーセに聞,きき従,したがったように、あなたに聞,きき従,したがいます。ただ、どうぞ、あなたの神,かみ、主,しゅがモーセと共,ともにおられたように、あなたと共,ともにおられますように。","tok":[["われわれ"],["は"],["すべて"],["の"],["こと"],["を"],["モーセ"],["に"],["聞","きき"],["従った","したがった"],["よう"],["に"],["、"],["あなた"],["に"],["聞","きき"],["従います","したがいます"],["。"],["ただ"],["、"],["どうぞ"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["モーセ"],["と"],["共","とも"],["に"],["おられた"],["よう"],["に"],["、"],["あなた"],["と"],["共","とも"],["に"],["おられます"],["よう"],["に"],["。"]]},{"verse":18,"text":"だれであっても、あなたの命令,めいれいにそむき、あなたの命,めいじられる言葉,ことばに聞,きき従,したがわないものがあれば、生,いかしてはおきません。ただ、強,つよく、また雄々,おおしくあってください」。","tok":[["だれ"],["で"],["あって"],["も"],["、"],["あなた"],["の"],["命令","めいれい"],["に"],["そむき"],["、"],["あなた"],["の"],["命じられる","めいじられる"],["言葉","ことば"],["に"],["聞","きき"],["従わない","したがわない"],["もの"],["が"],["あれば"],["、"],["生かして","いかして"],["は"],["おきません"],["。"],["ただ"],["、"],["強く","つよく"],["、"],["また"],["雄々しく","おおしく"],["あって"],["ください"],["」"],["。"]]}]
[{"verse":1,"text":"イエスは目,めをあげて、金持,かねもちたちがさいせん箱,はこに献金,けんきんを投,なげ入,いれるのを見,みられ、","tok":[["イエス"],["は"],["目","め"],["を"],["あげて"],["、"],["金持","かねもち"],["たち"],["が"],["さいせん"],["箱","はこ"],["に"],["献金","けんきん"],["を"],["投入れる","なげいれる"],["の"],["を"],["見られ","みられ"],["、"]]},{"verse":2,"text":"また、ある貧,まずしいやもめが、レプタ二つを入,いれるのを見,みて","tok":[["また"],["、"],["ある"],["貧しい","まずしい"],["やもめ"],["が"],["、"],["レプタ"],["二","ふた"],["つ"],["を"],["入れる","いれる"],["の"],["を"],["見て","みて"]]},{"verse":3,"text":"言,いわれた、「よく聞,ききなさい。あの貧,まずしいやもめはだれよりもたくさん入,いれたのだ。","tok":[["言われた","いわれた"],["、"],["「"],["よく"],["聞","きき"],["なさい"],["。"],["あの"],["貧しい","まずしい"],["やもめ"],["は"],["だれ"],["より"],["も"],["たくさん"],["入れた","いれた"],["の"],["だ"],["。"]]},{"verse":4,"text":"これらの人,ひとたちはみな、ありあまる中,なかから献金,けんきんを投,なげ入,いれたが、あの婦人,ふじんは、その乏,とぼしい中,なかから、持,もっている生活,せいかつ費,ひ全部,ぜんぶを入,いれたからである」。","tok":[["これ"],["ら"],["の"],["人","ひと"],["たち"],["は"],["みな"],["、"],["ありあまる"],["中","なか"],["から"],["献金","けんきん"],["を"],["投入れた","なげいれた"],["が"],["、"],["あの"],["婦人","ふじん"],["は"],["、"],["その"],["乏い","とぼしい"],["中","なか"],["から"],["、"],["持て","もって"],["いる"],["生活費","せいかつひ"],["全部","ぜんぶ"],["を"],["入れた","いれた"],["から"],["で"],["ある"],["」"],["。"]]},{"verse":5,"text":"ある人々,ひとびとが、見事,みごとな石,いしと奉納物,ほうのうぶつとで宮,みやが飾,かざられていることを話,はなしていたので、イエスは言,いわれた、","tok":[["ある"],["人々","ひとびと"],["が"],["、"],["見事","みごと"],["な"],["石","いし"],["と"],["奉納物","ほうのうぶつ"],["と"],["で"],["宮","みや"],["が"],["飾られて","かざられて"],["いる"],["こと"],["を"],["話","はなし"],["て"],["いた"],["ので"],["、"],["イエス"],["は"],["言われた","いわれた"],["、"]]},{"verse":6,"text":"「あなたがたはこれらのものをながめているが、その石,いし一つでもくずされずに、他,たの石,いしの上,うえに残,のこることもなくなる日,ひが、来,くるであろう」。","tok":[["「"],["あなた"],["がた"],["は"],["これ"],["ら"],["の"],["もの"],["を"],["ながめて"],["いる"],["が"],["、"],["その"],["石","いし"],["一","ひと"],["つ"],["で"],["も"],["くずされず"],["に"],["、"],["他","た"],["の"],["石","いし"],["の"],["上","うえ"],["に"],["残る","のこる"],["こと"],["も"],["なくなる"],["日","ひ"],["が"],["、"],["来るで","くるで"],["あろう"],["」"],["。"]]},{"verse":7,"text":"そこで彼,かれらはたずねた、「先生,せんせい、では、いつそんなことが起,おこるのでしょうか。またそんなことが起,おこるような場合,ばあいには、どんな前兆,ぜんちょうがありますか」。","tok":[["そこ"],["で"],["彼","かれ"],["ら"],["は"],["たずねた"],["、"],["「"],["先生","せんせい"],["、"],["で"],["は"],["、"],["いつ"],["そんな"],["こと"],["が"],["起こる","おこる"],["の"],["でしょう"],["か"],["。"],["また"],["そんな"],["こと"],["が"],["起こる","おこる"],["よう"],["な"],["場合","ばあい"],["に"],["は"],["、"],["どんな"],["前兆","ぜんちょう"],["が"],["あります"],["か"],["」"],["。"]]},{"verse":8,"text":"イエスが言,いわれた、「あなたがたは、惑,まどわされないように気,きをつけなさい。多,おおくの者,ものがわたしの名,なを名,なのって現,あらわれ、自分,じぶんがそれだとか、時,ときが近,ちかづいたとか、言,いうであろう。彼,かれらについて行,いくな。","tok":[["イエス"],["が"],["言われた","いわれた"],["、"],["「"],["あなた"],["がた"],["は"],["、"],["惑わされない","まどわされない"],["よう"],["に"],["気","き"],["を"],["つけ"],["なさい"],["。"],["多く","おおく"],["の"],["者","もの"],["が"],["わたし"],["の"],["名","な"],["を"],["名のって","なのって"],["現われ","あらわれ"],["、"],["自分","じぶん"],["が"],["それ"],["だ"],["と"],["か"],["、"],["時","とき"],["が"],["近づいた","ちかづいた"],["と"],["か"],["、"],["言うで","いうで"],["あろう"],["。"],["彼","かれ"],["ら"],["について"],["行く","いく"],["な"],["。"]]},{"verse":9,"text":"戦争,せんそうと騒乱,そうらんとのうわさを聞,きくときにも、おじ恐,おそれるな。こうしたことはまず起,おこらねばならないが、終,おわりはすぐにはこない」。","tok":[["戦争","せんそう"],["と"],["騒乱","そうらん"],["と"],["の"],["うわさ"],["を"],["聞く","きく"],["とき"],["に"],["も"],["、"],["おじ恐れる","おじおそれる"],["な"],["。"],["こう"],["した"],["こと"],["は"],["まず"],["起こらねば","おこらねば"],["ならない"],["が"],["、"],["終","おわり"],["は"],["すぐ"],["に"],["は"],["こない"],["」"],["。"]]},{"verse":10,"text":"それから彼,かれらに言,いわれた、「民,たみは民,たみに、国,くには国,くにに敵対,てきたいして立,たち上,あがるであろう。","tok":[["それ"],["から"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["民","たみ"],["は"],["民","たみ"],["に"],["、"],["国","くに"],["は"],["国","くに"],["に"],["敵対","てきたい"],["して"],["立ち上がるで","たちあがるで"],["あろう"],["。"]]},{"verse":11,"text":"また大,だい地震,じしんがあり、あちこちに疫病,えきびょうやききんが起,おこり、いろいろ恐,おそろしいことや天,てんからの物,ものすごい前兆,ぜんちょうがあるであろう。","tok":[["また"],["大地震","だいじしん"],["が"],["あり"],["、"],["あちこち"],["に"],["疫病","え"],["き"],["びょう"],["や"],["ききん"],["が"],["起こり","おこり"],["、"],["いろいろ"],["恐ろしい","おそろしい"],["こと"],["や"],["天","てん"],["から"],["の"],["物すごい","ものすごい"],["前兆","ぜんちょう"],["が"],["あるで"],["あろう"],["。"]]},{"verse":12,"text":"しかし、これらのあらゆる出来事,できごとのある前,まえに、人々,ひとびとはあなたがたに手,てをかけて迫害,はくがいをし、会堂,かいどうや獄,ごくに引,ひき渡,わたし、わたしの名,なのゆえに王,おうや総督,そうとくの前,まえにひっぱって行,いくであろう。","tok":[["しかし"],["、"],["これ"],["ら"],["の"],["あらゆる"],["出来事","できごと"],["の"],["ある"],["前","まえ"],["に"],["、"],["人々","ひとびと"],["は"],["あなた"],["がた"],["に"],["手","て"],["を"],["かけて"],["迫害","はくがい"],["を"],["し"],["、"],["会堂","かいどう"],["や"],["獄","ごく"],["に"],["引渡","ひきわたし"],["、"],["わたし"],["の"],["名","な"],["の"],["ゆえ"],["に"],["王","おう"],["や"],["総督","そうとく"],["の"],["前","まえ"],["に"],["ひっぱって"],["行くで","いくで"],["あろう"],["。"]]},{"verse":13,"text":"それは、あなたがたがあかしをする機会,きかいとなるであろう。","tok":[["それ"],["は"],["、"],["あなた"],["がた"],["が"],["あかし"],["を"],["する"],["機会","きかい"],["と"],["なるで"],["あろう"],["。"]]},{"verse":14,"text":"だから、どう答弁,とうべんしようかと、前,まえもって考,かんがえておかないことに心,こころを決,きめなさい。","tok":[["だ"],["から"],["、"],["どう"],["答弁","とうべん"],["しよう"],["か"],["と"],["、"],["前もって","まえもって"],["考","かんがえ"],["て"],["おかない"],["こと"],["に"],["心","こころ"],["を"],["決め","きめ"],["なさい"],["。"]]},{"verse":15,"text":"あなたの反対者,はんたいしゃのだれもが抗弁,こうべんも否定,ひていもできないような言葉,ことばと知恵,ちえとを、わたしが授,さづけるから。","tok":[["あなた"],["の"],["反対者","はんたいしゃ"],["の"],["だれ"],["も"],["が"],["抗弁","こうべん"],["も"],["否定","ひてい"],["も"],["できない"],["よう"],["な"],["言葉","ことば"],["と"],["知恵","ちえ"],["と"],["を"],["、"],["わたし"],["が"],["授ら","さづけるから"],["。"]]},{"verse":16,"text":"しかし、あなたがたは両親,りょうしん、兄弟,きょうだい、親族,しんぞく、友人,ゆうじんにさえ裏切,うらぎられるであろう。また、あなたがたの中,なかで殺,ころされるものもあろう。","tok":[["しかし"],["、"],["あなた"],["がた"],["は"],["両親","りょうしん"],["、"],["兄弟","きょうだい"],["、"],["親族","しんぞく"],["、"],["友人","ゆうじん"],["に"],["さえ"],["裏切られるで","うらぎられるで"],["あろう"],["。"],["また"],["、"],["あなた"],["がた"],["の"],["中","なか"],["で"],["殺ろされる","ころされる"],["もの"],["も"],["あろう"],["。"]]},{"verse":17,"text":"また、わたしの名,なのゆえにすべての人,ひとに憎,にくまれるであろう。","tok":[["また"],["、"],["わたし"],["の"],["名","な"],["の"],["ゆえ"],["に"],["すべて"],["の"],["人","ひと"],["に"],["憎まれるで","にくまれるで"],["あろう"],["。"]]},{"verse":18,"text":"しかし、あなたがたの髪,かみの毛,け一すじでも失,うしなわれることはない。","tok":[["しかし"],["、"],["あなた"],["がた"],["の"],["髪の毛","かみのけ"],["一すじ","ひとすじ"],["で"],["も"],["失なわれる","うしなわれる"],["こと"],["は"],["ない"],["。"]]},{"verse":19,"text":"あなたがたは耐,たえ忍,しのぶことによって、自分,じぶんの魂,たましいをかち取,とるであろう。","tok":[["あなた"],["がた"],["は"],["耐え忍ぶ","たえしのぶ"],["こと"],["によって"],["、"],["自分","じぶん"],["の"],["魂","たましい"],["を"],["かち取るで","かちとるで"],["あろう"],["。"]]},{"verse":20,"text":"エルサレムが軍隊,ぐんたいに包囲,ほういされるのを見,みたならば、そのときは、その滅亡,めつぼうが近,ちかづいたとさとりなさい。","tok":[["エルサレム"],["が"],["軍隊","ぐんたい"],["に"],["包囲","ほうい"],["される"],["の"],["を"],["見たならば","みたならば"],["、"],["その"],["とき"],["は"],["、"],["その"],["滅亡","めつぼう"],["が"],["近づいた","ちかづいた"],["と"],["さとり"],["なさい"],["。"]]},{"verse":21,"text":"そのとき、ユダヤにいる人々,ひとびとは山,やまへ逃,にげよ。市中,しちゅうにいる者,ものは、そこから出,でて行,いくがよい。また、いなかにいる者,ものは市内,しないにはいってはいけない。","tok":[["その"],["とき"],["、"],["ユダヤ"],["に"],["いる"],["人々","ひとびと"],["は"],["山","やま"],["へ"],["逃","にげ"],["よ"],["。"],["市中","しちゅう"],["に"],["いる"],["者","もの"],["は"],["、"],["そこ"],["から"],["出て","でて"],["行く","いく"],["が"],["よい"],["。"],["また"],["、"],["いなか"],["に"],["いる"],["者","もの"],["は"],["市内","しない"],["に"],["はいって"],["は"],["いけない"],["。"]]},{"verse":22,"text":"それは、聖書,せいしょにしるされたすべての事,ことが実現,じつげんする刑罰,けいばつの日,ひであるからだ。","tok":[["それ"],["は"],["、"],["聖書","せいしょ"],["に"],["しるされた"],["すべて"],["の"],["事","こと"],["が"],["実現","じつげん"],["する"],["刑罰","けいばつ"],["の"],["日","ひ"],["で"],["ある"],["から"],["だ"],["。"]]},{"verse":23,"text":"その日,ひには、身重,みおもの女,おんなと乳飲,ちのみ子,ごをもつ女,おんなとは、不幸,ふこうである。地上,ちじょうには大,おおきな苦難,くなんがあり、この民,たみにはみ怒,いかりが臨,のぞみ、","tok":[["その"],["日","ひ"],["に"],["は"],["、"],["身重","みおも"],["の"],["女","おんな"],["と"],["乳飲み子","ちのみご"],["を"],["もつ"],["女","おんな"],["と"],["は"],["、"],["不幸","ふこう"],["で"],["ある"],["。"],["地上","ちじょう"],["に"],["は"],["大きな","おおきな"],["苦難","くなん"],["が"],["あり"],["、"],["この"],["民","たみ"],["に"],["は"],["み怒り","みいかり"],["が"],["臨み","のぞみ"],["、"]]},{"verse":24,"text":"彼,かれらはつるぎの刃,はに倒,たおれ、また捕,とらえられて諸国,しょこくへ引,ひきゆかれるであろう。そしてエルサレムは、異邦人,いほうじんの時期,じきが満,みちるまで、彼,かれらに踏,ふみにじられているであろう。","tok":[["彼","かれ"],["ら"],["は"],["つるぎ"],["の"],["刃","は"],["に"],["倒れ","たおれ"],["、"],["また"],["捕らえられて","とらえられて"],["諸国","しょこく"],["へ"],["引","ひき"],["ゆかれるで"],["あろう"],["。"],["そして"],["エルサレム"],["は"],["、"],["異邦人","いほうじん"],["の"],["時期","じき"],["が"],["満ちる","みちる"],["まで"],["、"],["彼","かれ"],["ら"],["に"],["踏みにじられて","ふみにじられて"],["いるで"],["あろう"],["。"]]},{"verse":25,"text":"また日,ひと月,つきと星,ほしとに、しるしが現,あらわれるであろう。そして、地上,ちじょうでは、諸,しょ国民,こくみんが悩,なやみ、海,うみと大波,おおなみとのとどろきにおじ惑,まどい、","tok":[["また"],["日","ひ"],["と"],["月","つき"],["と"],["星","ほし"],["と"],["に"],["、"],["しるし"],["が"],["現われるで","あらわれるで"],["あろう"],["。"],["そして"],["、"],["地上","ちじょう"],["で"],["は"],["、"],["諸","しょ"],["国民","こくみん"],["が"],["悩み","なやみ"],["、"],["海","うみ"],["と"],["大波","おおなみ"],["と"],["の"],["とどろき"],["に"],["おじ"],["惑い","まどい"],["、"]]},{"verse":26,"text":"人々,ひとびとは世界,せかいに起,おころうとする事,ことを思,おもい、恐怖,きょうふと不安,ふあんで気絶,きぜつするであろう。もろもろの天体,てんたいが揺,ゆり動,うごかされるからである。","tok":[["人々","ひとびと"],["は"],["世界","せかい"],["に"],["起ころう","おころう"],["と"],["する"],["事","こと"],["を"],["思い","おもい"],["、"],["恐怖","きょうふ"],["と"],["不安","ふあん"],["で"],["気絶","きぜつ"],["するで"],["あろう"],["。"],["もろもろ"],["の"],["天体","てんたい"],["が"],["揺り動かされる","ゆりうごかされる"],["から"],["で"],["ある"],["。"]]},{"verse":27,"text":"そのとき、大,おおいなる力,ちからと栄光,えいこうとをもって、人,ひとの子,こが雲,くもに乗,のって来,くるのを、人々,ひとびとは見,みるであろう。","tok":[["その"],["とき"],["、"],["大いなる","おおいなる"],["力","ちから"],["と"],["栄光","えいこう"],["と"],["を"],["もって"],["、"],["人","ひと"],["の"],["子","こ"],["が"],["雲","くも"],["に"],["乗って","のって"],["来る","くる"],["の"],["を"],["、"],["人々","ひとびと"],["は"],["見るで","みるで"],["あろう"],["。"]]},{"verse":28,"text":"これらの事,ことが起,おこりはじめたら、身,みを起,おこし頭,あたまをもたげなさい。あなたがたの救,すくいが近,ちかづいているのだから」。","tok":[["これ"],["ら"],["の"],["事","こと"],["が"],["起こり","おこり"],["はじめたら"],["、"],["身","み"],["を"],["起こし","おこし"],["頭","あたま"],["を"],["もたげ"],["なさい"],["。"],["あなた"],["がた"],["の"],["救い","すくい"],["が"],["近づいて","ちかづいて"],["いる"],["の"],["だ"],["から"],["」"],["。"]]},{"verse":29,"text":"それから一つの譬,たとえを話,はなされた、「いちじくの木,きを、またすべての木,きを見,みなさい。","tok":[["それ"],["から"],["一","ひと"],["つ"],["の"],["譬","たとえ"],["を"],["話された","はなされた"],["、"],["「"],["いちじく"],["の"],["木","き"],["を"],["、"],["また"],["すべて"],["の"],["木","き"],["を"],["見","み"],["なさい"],["。"]]},{"verse":30,"text":"はや芽,めを出,だせば、あなたがたはそれを見,みて、夏,なつがすでに近,ちかいと、自分,じぶんで気,きづくのである。","tok":[["はや"],["芽","め"],["を"],["出せば","だせば"],["、"],["あなた"],["がた"],["は"],["それ"],["を"],["見て","みて"],["、"],["夏","なつ"],["が"],["すでに"],["近い","ちかい"],["と"],["、"],["自分","じぶん"],["で"],["気づく","きづく"],["ので"],["ある"],["。"]]},{"verse":31,"text":"このようにあなたがたも、これらの事,ことが起,おこるのを見,みたなら、神,かみの国,くにが近,ちかいのだとさとりなさい。","tok":[["この"],["よう"],["に"],["あなた"],["がた"],["も"],["、"],["これ"],["ら"],["の"],["事","こと"],["が"],["起こる","おこる"],["の"],["を"],["見たなら","みたなら"],["、"],["神","かみ"],["の"],["国","くに"],["が"],["近い","ちかい"],["の"],["だ"],["と"],["さとり"],["なさい"],["。"]]},{"verse":32,"text":"よく聞,きいておきなさい。これらの事,ことが、ことごとく起,おこるまでは、この時代,じだいは滅,ほろびることがない。","tok":[["よく"],["聞いて","きいて"],["おき"],["なさい"],["。"],["これ"],["ら"],["の"],["事","こと"],["が"],["、"],["ことごとく"],["起こる","おこる"],["まで"],["は"],["、"],["この"],["時代","じだい"],["は"],["滅びる","ほろびる"],["こと"],["が"],["ない"],["。"]]},{"verse":33,"text":"天地,てんちは滅,ほろびるであろう。しかしわたしの言葉,ことばは決,けっして滅,ほろびることがない。","tok":[["天地","てんち"],["は"],["滅びるで","ほろびるで"],["あろう"],["。"],["しかし"],["わたし"],["の"],["言葉","ことば"],["は"],["決っして","けっして"],["滅びる","ほろびる"],["こと"],["が"],["ない"],["。"]]},{"verse":34,"text":"あなたがたが放縦,ほうじゅうや、泥酔,でいすいや、世,よの煩,わずらいのために心,こころが鈍,にぶっているうちに、思,おもいがけないとき、その日,ひがわなのようにあなたがたを捕,とらえることがないように、よく注意,ちゅういしていなさい。","tok":[["あなた"],["がた"],["が"],["放縦","ほ"],["う"],["じゅう"],["や"],["、"],["泥酔","でいすい"],["や"],["、"],["世","よ"],["の"],["煩い","わずらい"],["の"],["ため"],["に"],["心","こころ"],["が"],["鈍って","にぶって"],["いる"],["うち"],["に"],["、"],["思いがけない","おもいがけない"],["とき"],["、"],["その"],["日","ひ"],["が"],["わな"],["の"],["よう"],["に"],["あなた"],["がた"],["を"],["捕らえる","とらえる"],["こと"],["が"],["ない"],["よう"],["に"],["、"],["よく"],["注意","ちゅうい"],["して"],["い"],["なさい"],["。"]]},{"verse":35,"text":"その日,ひは地,ちの全面,ぜんめんに住,すむすべての人,ひとに臨,のぞむのであるから。","tok":[["その"],["日","ひ"],["は"],["地","ち"],["の"],["全面","ぜんめん"],["に"],["住む","すむ"],["すべて"],["の"],["人","ひと"],["に"],["臨む","のぞむ"],["ので"],["ある"],["から"],["。"]]},{"verse":36,"text":"これらの起,おころうとしているすべての事,ことからのがれて、人,ひとの子,この前,まえに立,たつことができるように、絶,たえず目,めをさまして祈,いのっていなさい」。","tok":[["これ"],["ら"],["の"],["起ころう","おころう"],["として"],["いる"],["すべて"],["の"],["事","こと"],["から"],["のがれて"],["、"],["人","ひと"],["の"],["子","こ"],["の"],["前","まえ"],["に"],["立つ","たつ"],["こと"],["が"],["できる"],["よう"],["に"],["、"],["絶えず","たえず"],["目","め"],["を"],["さまして"],["祈って","いのって"],["い"],["なさい"],["」"],["。"]]},{"verse":37,"text":"イエスは昼,ひるのあいだは宮,みやで教,おしえ、夜,よるには出,でて行,いってオリブという山,やまで夜,よをすごしておられた。","tok":[["イエス"],["は"],["昼","ひる"],["の"],["あいだ"],["は"],["宮","みや"],["で"],["教え","おしえ"],["、"],["夜","よる"],["に"],["は"],["出て","でて"],["行って","いって"],["オリブ"],["と"],["いう"],["山","やま"],["で"],["夜","よ"],["を"],["すごして"],["おられた"],["。"]]},{"verse":38,"text":"民衆,みんしゅうはみな、み教,おしえを聞,きこうとして、いつも朝,あさ早,はやく宮,みやに行,いき、イエスのもとに集,あつまった。","tok":[["民衆","みんしゅう"],["は"],["みな"],["、"],["み教え","みおしえ"],["を"],["聞こう","きこう"],["として"],["、"],["いつも"],["朝","あさ"],["早く","はやく"],["宮","みや"],["に"],["行き","いき"],["、"],["イエス"],["の"],["もと"],["に"],["集まった","あつまった"],["。"]]}]
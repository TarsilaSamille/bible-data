[{"verse":1,"text":"わたしたちの間,あいだに成就,じょうじゅされた出来事,できごとを、最初,さいしょから親,したしく見,みた人々,ひとびとであって、","tok":[["わたしたち"],["の"],["間","あいだ"],["に"],["成就","じょうじゅ"],["された"],["出来事","できごと"],["を"],["、"],["最初","さいしょ"],["から"],["親しく","したしく"],["見た","みた"],["人々","ひとびと"],["で"],["あって"],["、"]]},{"verse":2,"text":"御言,みことばに仕,つかえた人々,ひとびとが伝,つたえたとおり物語,ものがたりに書,かき連,つらねようと、多,おおくの人,ひとが手,てを着,つけましたが、","tok":[["御言","みこと"],["ば"],["に"],["仕えた","つかえた"],["人々","ひとびと"],["が"],["伝えた","つたえた"],["とおり"],["物語","ものがたり"],["に"],["書き連ねよう","かきつらねよう"],["と"],["、"],["多く","おおく"],["の"],["人","ひと"],["が"],["手","て"],["を"],["着けました","つけました"],["が"],["、"]]},{"verse":3,"text":"テオピロ閣下,かっかよ、わたしもすべての事,ことを初,はじめから詳,くわしく調,しらべていますので、ここに、それを順序,じゅんじょ正,ただしく書,かきつづって、閣下,かっかに献,けんじることにしました。","tok":[["テオピロ"],["閣下","かっか"],["よ"],["、"],["わたし"],["も"],["すべて"],["の"],["事","こと"],["を"],["初め","はじめ"],["から"],["詳しく","くわしく"],["調べて","しらべて"],["います"],["ので"],["、"],["ここ"],["に"],["、"],["それ"],["を"],["順序","じゅんじょ"],["正く","ただしく"],["書きつづって","かきつづって"],["、"],["閣下","かっか"],["に"],["献じる","けんじる"],["こと"],["に"],["しました"],["。"]]},{"verse":4,"text":"すでにお聞,ききになっている事,ことが確実,かくじつであることを、これによって十分,じゅうぶんに知,しっていただきたいためであります。","tok":[["すでに"],["お聞","おきき"],["に"],["なって"],["いる"],["事","こと"],["が"],["確実","かくじつ"],["で"],["ある"],["こと"],["を"],["、"],["これ"],["によって"],["十分","じゅうぶん"],["に"],["知って","しって"],["いただきたい"],["ため"],["で"],["あります"],["。"]]},{"verse":5,"text":"ユダヤの王,おうヘロデの世,よに、アビヤの組,くみの祭司,さいしで名,なをザカリヤという者,ものがいた。その妻,つまはアロン家,いえの娘,むすめのひとりで、名,なをエリサベツといった。","tok":[["ユダヤ"],["の"],["王","おう"],["ヘロデ"],["の"],["世","よ"],["に"],["、"],["アビヤ"],["の"],["組","くみ"],["の"],["祭司","さいし"],["で"],["名","な"],["を"],["ザカリヤ"],["と"],["いう"],["者","もの"],["が"],["いた"],["。"],["その"],["妻","つま"],["は"],["アロン家","あろんいえ"],["の"],["娘","むすめ"],["の"],["ひとり"],["で"],["、"],["名","な"],["を"],["エリサベツ"],["と"],["いった"],["。"]]},{"verse":6,"text":"ふたりとも神,かみのみまえに正,ただしい人,ひとであって、主,しゅの戒,いましめと定,さだめとを、みな落度,おちどなく行,おこなっていた。","tok":[["ふたり"],["とも"],["神","かみ"],["のみ"],["まえ"],["に"],["正い","ただしい"],["人","ひと"],["で"],["あって"],["、"],["主","しゅ"],["の"],["戒しめ","いましめ"],["と"],["定め","さだめ"],["と"],["を"],["、"],["みな"],["落度","おちど"],["なく"],["行なって","おこなって"],["いた"],["。"]]},{"verse":7,"text":"ところが、エリサベツは不妊,ふにんの女,おんなであったため、彼,かれらには子,こがなく、そしてふたりともすでに年老,としおいていた。","tok":[["ところ"],["が"],["、"],["エリサベツ"],["は"],["不妊","ふにん"],["の"],["女","おんな"],["で"],["あった"],["ため"],["、"],["彼","かれ"],["ら"],["に"],["は"],["子","こ"],["が"],["なく"],["、"],["そして"],["ふたり"],["とも"],["すでに"],["年老いて","としおいて"],["いた"],["。"]]},{"verse":8,"text":"さてザカリヤは、その組,くみが当番,とうばんになり神,かみのみまえに祭司,さいしの務,つとめをしていたとき、","tok":[["さて"],["ザカリヤ"],["は"],["、"],["その"],["組","くみ"],["が"],["当番","とうばん"],["に"],["なり"],["神","かみ"],["のみ"],["まえ"],["に"],["祭司","さいし"],["の"],["務め","つとめ"],["を"],["して"],["いた"],["とき"],["、"]]},{"verse":9,"text":"祭司,さいし職,しょくの慣例,かんれいに従,したがってくじを引,ひいたところ、主,しゅの聖所,せいじょにはいって香,こうをたくことになった。","tok":[["祭司","さいし"],["職","しょく"],["の"],["慣例","かんれい"],["に"],["従って","したがって"],["くじ"],["を"],["引いた","ひいた"],["ところ"],["、"],["主","しゅ"],["の"],["聖","せい"],["所","しょ"],["に"],["はいって"],["香","こう"],["を"],["たく"],["こと"],["に"],["なった"],["。"]]},{"verse":10,"text":"香,こうをたいている間,あいだ、多,おおくの民衆,みんしゅうはみな外,そとで祈,いのっていた。","tok":[["香","こう"],["を"],["たいて"],["いる"],["間","あいだ"],["、"],["多く","おおく"],["の"],["民衆","みんしゅう"],["は"],["みな"],["外","そと"],["で"],["祈って","いのって"],["いた"],["。"]]},{"verse":11,"text":"すると主,しゅの御使,みつかいが現,あらわれて、香,こう壇,だんの右,みぎに立,たった。","tok":[["する"],["と"],["主","しゅ"],["の"],["御使","み"],["つかい"],["が"],["現われて","あらわれて"],["、"],["香","こう"],["壇","だん"],["の"],["右","みぎ"],["に"],["立った","たった"],["。"]]},{"verse":12,"text":"ザカリヤはこれを見,みて、おじ惑,まどい、恐怖,きょうふの念,ねんに襲,おそわれた。","tok":[["ザカリヤ"],["は"],["これ"],["を"],["見て","みて"],["、"],["おじ"],["惑い","まどい"],["、"],["恐怖","きょうふ"],["の"],["念","ねん"],["に"],["襲れた","おそわれた"],["。"]]},{"verse":13,"text":"そこで御使,みつかいが彼,かれに言,いった、「恐,おそれるな、ザカリヤよ、あなたの祈,いのりが聞,ききいれられたのだ。あなたの妻,つまエリサベツは男,おとこの子,こを産,うむであろう。その子,こをヨハネと名,なづけなさい。","tok":[["そこ"],["で"],["御使","み"],["つかい"],["が"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["恐れる","おそれる"],["な"],["、"],["ザカリヤ"],["よ"],["、"],["あなた"],["の"],["祈","いのり"],["が"],["聞きいれられた","ききいれられた"],["の"],["だ"],["。"],["あなた"],["の"],["妻","つま"],["エリサベツ"],["は"],["男の子","おとこのこ"],["を"],["産むで","うむで"],["あろう"],["。"],["その"],["子","こ"],["を"],["ヨハネ"],["と"],["名づけ","なづけ"],["なさい"],["。"]]},{"verse":14,"text":"彼,かれはあなたに喜,よろこびと楽,たのしみとをもたらし、多,おおくの人々,ひとびともその誕生,たんじょうを喜,よろこぶであろう。","tok":[["彼","かれ"],["は"],["あなた"],["に"],["喜こび","よろこび"],["と"],["楽み","たのしみ"],["と"],["を"],["もたらし"],["、"],["多く","おおく"],["の"],["人々","ひとびと"],["も"],["その"],["誕生","たんじょう"],["を"],["喜こぶで","よろこぶで"],["あろう"],["。"]]},{"verse":15,"text":"彼,かれは主,しゅのみまえに大,おおいなる者,ものとなり、ぶどう酒,しゅや強,つよい酒,さけをいっさい飲,のまず、母,ははの胎内,たいないにいる時,ときからすでに聖霊,せいれいに満,みたされており、","tok":[["彼","かれ"],["は"],["主","しゅ"],["のみ"],["まえ"],["に"],["大いなる","おおいなる"],["者","もの"],["と"],["なり"],["、"],["ぶどう酒","ぶどうしゅ"],["や"],["強い","つよい"],["酒","さけ"],["を"],["いっさい"],["飲まず","のまず"],["、"],["母","はは"],["の"],["胎内","たいない"],["に"],["いる"],["時","とき"],["から"],["すでに"],["聖霊","せいれい"],["に"],["満たされて","みたされて"],["おり"],["、"]]},{"verse":16,"text":"そして、イスラエルの多,おおくの子,こらを、主,しゅなる彼,かれらの神,かみに立,たち帰,かえらせるであろう。","tok":[["そして"],["、"],["イスラエル"],["の"],["多く","おおく"],["の"],["子","こ"],["ら"],["を"],["、"],["主","しゅ"],["なる"],["彼","かれ"],["ら"],["の"],["神","かみ"],["に"],["立ち","たち"],["帰えらせるで","かえらせるで"],["あろう"],["。"]]},{"verse":17,"text":"彼,かれはエリヤの霊,れいと力,ちからとをもって、みまえに先立,さきだって行,いき、父,ちちの心,こころを子,こに向,むけさせ、逆,さからう者,ものに義人,ぎじんの思,おもいを持,もたせて、整,ととのえられた民,たみを主,しゅに備,そなえるであろう」。","tok":[["彼","かれ"],["は"],["エリヤ"],["の"],["霊","れい"],["と"],["力","ちから"],["と"],["を"],["もって"],["、"],["みまえ"],["に"],["先立って","さきだって"],["行き","いき"],["、"],["父","ちち"],["の"],["心","こころ"],["を"],["子","こ"],["に"],["向けさせ","むけさせ"],["、"],["逆らう","さからう"],["者","もの"],["に"],["義人","ぎじん"],["の"],["思い","おもい"],["を"],["持たせて","もたせて"],["、"],["整えられた","ととのえられた"],["民","たみ"],["を"],["主に","しゅに"],["備","そなえ"],["るで"],["あろう"],["」"],["。"]]},{"verse":18,"text":"するとザカリヤは御使,みつかいに言,いった、「どうしてそんな事,ことが、わたしにわかるでしょうか。わたしは老人,ろうじんですし、妻,つまも年,としをとっています」。","tok":[["する"],["と"],["ザカリヤ"],["は"],["御使","みつかい"],["に"],["言った","いった"],["、"],["「"],["どう"],["して"],["そんな"],["事","こと"],["が"],["、"],["わたし"],["に"],["わかるでしょう"],["か"],["。"],["わたし"],["は"],["老人","ろうじん"],["です"],["し"],["、"],["妻","つま"],["も"],["年","とし"],["を"],["とって"],["います"],["」"],["。"]]},{"verse":19,"text":"御使,みつかいが答,こたえて言,いった、「わたしは神,かみのみまえに立,たつガブリエルであって、この喜,よろこばしい知,しらせをあなたに語,かたり伝,つたえるために、つかわされたものである。","tok":[["御使","み"],["つかい"],["が"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["わたし"],["は"],["神","かみ"],["のみ"],["まえ"],["に"],["立つ","たつ"],["ガブリエル"],["で"],["あって"],["、"],["この"],["喜こば","よろこば"],["しい"],["知らせ","しらせ"],["を"],["あなた"],["に"],["語り伝える","かたりつたえる"],["ため"],["に"],["、"],["つかわされた"],["もの"],["で"],["ある"],["。"]]},{"verse":20,"text":"時,ときが来,くれば成就,じょうじゅするわたしの言葉,ことばを信,しんじなかったから、あなたはおしになり、この事,ことの起,おこる日,ひまで、ものが言,いえなくなる」。","tok":[["時","とき"],["が"],["来れば","くれば"],["成就","じょうじゅ"],["する"],["わたし"],["の"],["言葉","ことば"],["を"],["信じなかった","しんじなかった"],["から"],["、"],["あなた"],["は"],["おし"],["に"],["なり"],["、"],["この"],["事","こと"],["の"],["起こる","おこる"],["日","ひ"],["まで"],["、"],["もの"],["が"],["言えなく","いえなく"],["なる"],["」"],["。"]]},{"verse":21,"text":"民衆,みんしゅうはザカリヤを待,まっていたので、彼,かれが聖所,せいじょ内,うちで暇,ひまどっているのを不思議,ふしぎに思,おもっていた。","tok":[["民衆","みんしゅう"],["は"],["ザカリヤ"],["を"],["待って","まって"],["いた"],["ので"],["、"],["彼","かれ"],["が"],["聖","せい"],["所","しょ"],["い"],["じょ"],["内","うち"],["で"],["暇どって","ひまどって"],["いる"],["の"],["を"],["不思議","ふしぎ"],["に"],["思って","おもって"],["いた"],["。"]]},{"verse":22,"text":"ついに彼,かれは出,でてきたが、物,ものが言,いえなかったので、人々,ひとびとは彼,かれが聖所,せいじょ内,うちでまぼろしを見,みたのだと悟,さとった。彼,かれは彼,かれらに合図,あいずをするだけで、引,ひきつづき、おしのままでいた。","tok":[["ついに"],["彼","かれ"],["は"],["出て","でて"],["きた"],["が"],["、"],["物","もの"],["が"],["言えなかった","いえなかった"],["ので"],["、"],["人々","ひとびと"],["は"],["彼","かれ"],["が"],["聖","せい"],["所","しょ"],["い"],["じょ"],["内","うち"],["で"],["まぼろし"],["を"],["見た","みた"],["の"],["だ"],["と"],["悟った","さとった"],["。"],["彼","かれ"],["は"],["彼","かれ"],["ら"],["に"],["合図","あいず"],["を"],["する"],["だけ"],["で"],["、"],["引","ひき"],["つづき"],["、"],["おし"],["の"],["まま"],["で"],["いた"],["。"]]},{"verse":23,"text":"それから務,つとめの期日,きじつが終,おわったので、家,いえに帰,かえった。","tok":[["それ"],["から"],["務め","つとめ"],["の"],["期日","きじつ"],["が"],["終わった","おわった"],["ので"],["、"],["家","いえ"],["に"],["帰えった","かえった"],["。"]]},{"verse":24,"text":"そののち、妻,つまエリサベツはみごもり、五か月,げつのあいだ引,ひきこもっていたが、","tok":[["その"],["のち"],["、"],["妻","つま"],["エリサベツ"],["は"],["みごもり"],["、"],["五","ご"],["か月","かげつ"],["の"],["あいだ"],["引","ひき"],["こもって"],["いた"],["が"],["、"]]},{"verse":25,"text":"「主,しゅは、今,いまわたしを心,こころにかけてくださって、人々,ひとびとの間,あいだからわたしの恥,はじを取,とり除,のぞくために、こうしてくださいました」と言,いった。","tok":[["「"],["主","しゅ"],["は"],["、"],["今","いま"],["わたし"],["を"],["心","こころ"],["に"],["かけて"],["くださって"],["、"],["人々","ひとびと"],["の"],["間","あいだ"],["から"],["わたし"],["の"],["恥","はじ"],["を"],["取除く","とりのぞく"],["ため"],["に"],["、"],["こう"],["して"],["くださいました"],["」"],["と"],["言った","いった"],["。"]]},{"verse":26,"text":"六か月,げつ目,めに、御使,みつかいガブリエルが、神,かみからつかわされて、ナザレというガリラヤの町,まちの一,いち処女,しょじょのもとにきた。","tok":[["六","ろく"],["か月目","かげつめ"],["に"],["、"],["御使","み"],["つかい"],["ガブリエル"],["が"],["、"],["神","かみ"],["から"],["つかわされて"],["、"],["ナザレ"],["と"],["いう"],["ガリラヤ"],["の"],["町","まち"],["の"],["一","いち"],["処女","しょじょ"],["の"],["もと"],["に"],["きた"],["。"]]},{"verse":27,"text":"この処女,しょじょはダビデ家,いえの出,でであるヨセフという人,ひとのいいなづけになっていて、名,なをマリヤといった。","tok":[["この"],["処女","しょじょ"],["は"],["ダビデ家","だびでいえ"],["の"],["出","で"],["で"],["ある"],["ヨセフ"],["と"],["いう"],["人","ひと"],["の"],["いいなづけ"],["に"],["なって"],["いて"],["、"],["名","な"],["を"],["マリヤ"],["と"],["いった"],["。"]]},{"verse":28,"text":"御使,みつかいがマリヤのところにきて言,いった、「恵,めぐまれた女,おんなよ、おめでとう、主,しゅがあなたと共,ともにおられます」。","tok":[["御使","み"],["つかい"],["が"],["マリヤ"],["の"],["ところ"],["に"],["きて"],["言った","いった"],["、"],["「"],["恵れた","めぐまれた"],["女","おんな"],["よ"],["、"],["おめでとう"],["、"],["主","しゅ"],["が"],["あなた"],["と"],["共","とも"],["に"],["おられます"],["」"],["。"]]},{"verse":29,"text":"この言葉,ことばにマリヤはひどく胸騒,むなさわぎがして、このあいさつはなんの事,ことであろうかと、思,おもいめぐらしていた。","tok":[["この"],["言葉","ことば"],["に"],["マリヤ"],["は"],["ひどく"],["胸騒ぎ","むなさわぎ"],["が"],["して"],["、"],["この"],["あいさつ"],["は"],["なん"],["の"],["事","こと"],["で"],["あろう"],["か"],["と"],["、"],["思いめぐらして","おもいめぐらして"],["いた"],["。"]]},{"verse":30,"text":"すると御使,みつかいが言,いった、「恐,おそれるな、マリヤよ、あなたは神,かみから恵,めぐみをいただいているのです。","tok":[["する"],["と"],["御使","み"],["つかい"],["が"],["言った","いった"],["、"],["「"],["恐れる","おそれる"],["な"],["、"],["マリヤ"],["よ"],["、"],["あなた"],["は"],["神","かみ"],["から"],["恵","めぐみ"],["を"],["いただいて"],["いる"],["の"],["です"],["。"]]},{"verse":31,"text":"見,みよ、あなたはみごもって男,おとこの子,こを産,うむでしょう。その子,こをイエスと名,なづけなさい。","tok":[["見よ","みよ"],["、"],["あなた"],["は"],["みごもって"],["男の子","おとこのこ"],["を"],["産むでしょう","うむでしょう"],["。"],["その"],["子","こ"],["を"],["イエス"],["と"],["名づけ","なづけ"],["なさい"],["。"]]},{"verse":32,"text":"彼,かれは大,おおいなる者,ものとなり、いと高,たかき者,ものの子,こと、となえられるでしょう。そして、主,しゅなる神,かみは彼,かれに父,ちちダビデの王座,おうざをお与,あたえになり、","tok":[["彼","かれ"],["は"],["大いなる","おおいなる"],["者","もの"],["と"],["なり"],["、"],["いと"],["高き","たかき"],["者","もの"],["の"],["子","こ"],["と"],["、"],["となえられるでしょう"],["。"],["そして"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["彼","かれ"],["に"],["父","ちち"],["ダビデ"],["の"],["王座","おうざ"],["を"],["お"],["与","あたえ"],["に"],["なり"],["、"]]},{"verse":33,"text":"彼,かれはとこしえにヤコブの家,いえを支配,しはいし、その支配,しはいは限,かぎりなく続,つづくでしょう」。","tok":[["彼","かれ"],["は"],["とこしえ"],["に"],["ヤコブ"],["の"],["家","いえ"],["を"],["支配","しはい"],["し"],["、"],["その"],["支配","しはい"],["は"],["限","かぎり"],["なく"],["続くでしょう","つづくでしょう"],["」"],["。"]]},{"verse":34,"text":"そこでマリヤは御使,みつかいに言,いった、「どうして、そんな事,ことがあり得,えましょうか。わたしにはまだ夫,おっとがありませんのに」。","tok":[["そこ"],["で"],["マリヤ"],["は"],["御使","みつかい"],["に"],["言った","いった"],["、"],["「"],["どう"],["して"],["、"],["そんな"],["事","こと"],["が"],["あり"],["得ましょう","えましょう"],["か"],["。"],["わたし"],["に"],["は"],["まだ"],["夫","おっと"],["が"],["ありません"],["のに"],["」"],["。"]]},{"verse":35,"text":"御使,みつかいが答,こたえて言,いった、「聖霊,せいれいがあなたに臨,のぞみ、いと高,たかき者,ものの力,ちからがあなたをおおうでしょう。それゆえに、生,うまれ出,でる子,こは聖,せいなるものであり、神,かみの子,こと、となえられるでしょう。","tok":[["御使","み"],["つかい"],["が"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["聖霊","せいれい"],["が"],["あなた"],["に"],["臨み","のぞみ"],["、"],["いと"],["高き","たかき"],["者","もの"],["の"],["力","ちから"],["が"],["あなた"],["を"],["おおうでしょう"],["。"],["それ"],["ゆえ"],["に"],["、"],["生まれ出る","うまれでる"],["子","こ"],["は"],["聖","せい"],["なる"],["もの"],["で"],["あり"],["、"],["神","かみ"],["の"],["子","こ"],["と"],["、"],["となえられるでしょう"],["。"]]},{"verse":36,"text":"あなたの親族,しんぞくエリサベツも老年,ろうねんながら子,こを宿,やどしています。不妊,ふにんの女,おんなといわれていたのに、はや六か月,げつになっています。","tok":[["あなた"],["の"],["親族","しんぞく"],["エリサベツ"],["も"],["老年","ろうねん"],["ながら"],["子","こ"],["を"],["宿して","やどして"],["います"],["。"],["不妊","ふにん"],["の"],["女","おんな"],["と"],["いわれて"],["いた"],["のに"],["、"],["はや"],["六","ろく"],["か月","かげつ"],["に"],["なって"],["います"],["。"]]},{"verse":37,"text":"神,かみには、なんでもできないことはありません」。","tok":[["神","かみ"],["に"],["は"],["、"],["なん"],["で"],["も"],["できない"],["こと"],["は"],["ありません"],["」"],["。"]]},{"verse":38,"text":"そこでマリヤが言,いった、「わたしは主,しゅのはしためです。お言葉,ことばどおりこの身,みに成,なりますように」。そして御使,みつかいは彼女,かのじょから離,はなれて行,いった。","tok":[["そこ"],["で"],["マリヤ"],["が"],["言った","いった"],["、"],["「"],["わたし"],["は"],["主","しゅ"],["の"],["はし"],["ため"],["です"],["。"],["お言葉","おことば"],["どおり"],["この"],["身","み"],["に"],["成ります","なります"],["よう"],["に"],["」"],["。"],["そして"],["御使","みつかい"],["は"],["彼女","かのじょ"],["から"],["離れて","はなれて"],["行った","いった"],["。"]]},{"verse":39,"text":"そのころ、マリヤは立,たって、大急,おおいそぎで山里,やまざとへむかいユダの町,まちに行,いき、","tok":[["その"],["ころ"],["、"],["マリヤ"],["は"],["立って","たって"],["、"],["大急ぎ","おおいそぎ"],["で"],["山里","やまざと"],["へ"],["むかい"],["ユダ"],["の"],["町","まち"],["に"],["行き","いき"],["、"]]},{"verse":40,"text":"ザカリヤの家,いえにはいってエリサベツにあいさつした。","tok":[["ザカリヤ"],["の"],["家","いえ"],["に"],["はいって"],["エリサベツ"],["に"],["あいさつ"],["した"],["。"]]},{"verse":41,"text":"エリサベツがマリヤのあいさつを聞,きいたとき、その子,こが胎内,たいないでおどった。エリサベツは聖霊,せいれいに満,みたされ、","tok":[["エリサベツ"],["が"],["マリヤ"],["の"],["あいさつ"],["を"],["聞いた","きいた"],["とき"],["、"],["その"],["子","こ"],["が"],["胎内","たいない"],["で"],["おどった"],["。"],["エリサベツ"],["は"],["聖霊","せいれい"],["に"],["満たされ","みたされ"],["、"]]},{"verse":42,"text":"声,こえ高,たかく叫,さけんで言,いった、「あなたは女,おんなの中,なかで祝福,しゅくふくされたかた、あなたの胎,たいの実,みも祝福,しゅくふくされています。","tok":[["声","こえ"],["高かく","たかく"],["叫けんで","さけんで"],["言った","いった"],["、"],["「"],["あなた"],["は"],["女","おんな"],["の"],["中","なか"],["で"],["祝福","しゅくふく"],["された"],["かた"],["、"],["あなた"],["の"],["胎","たい"],["の"],["実","み"],["も"],["祝福","しゅくふく"],["されて"],["います"],["。"]]},{"verse":43,"text":"主,しゅの母上,ははうえがわたしのところにきてくださるとは、なんという光栄,こうえいでしょう。","tok":[["主","しゅ"],["の"],["母","はは"],["上","うえ"],["が"],["わたし"],["の"],["ところ"],["に"],["きて"],["くださる"],["と"],["は"],["、"],["なん"],["と"],["いう"],["光栄","こうえい"],["でしょう"],["。"]]},{"verse":44,"text":"ごらんなさい。あなたのあいさつの声,こえがわたしの耳,みみにはいったとき、子供,こどもが胎内,たいないで喜,よろこびおどりました。","tok":[["ごらん"],["なさい"],["。"],["あなた"],["の"],["あいさつ"],["の"],["声","こえ"],["が"],["わたし"],["の"],["耳","みみ"],["に"],["はいった"],["とき"],["、"],["子供","こども"],["が"],["胎内","たいない"],["で"],["喜こび","よろこび"],["おどりました"],["。"]]},{"verse":45,"text":"主,しゅのお語,かたりになったことが必,かならず成就,じょうじゅすると信,しんじた女,おんなは、なんとさいわいなことでしょう」。","tok":[["主","しゅ"],["の"],["お語り","おかたり"],["に"],["なった"],["こと"],["が"],["必","かならず"],["成就","じょうじゅ"],["する"],["と"],["信じた","しんじた"],["女","おんな"],["は"],["、"],["なん"],["と"],["さいわい"],["な"],["こと"],["でしょう"],["」"],["。"]]},{"verse":46,"text":"するとマリヤは言,いった、「わたしの魂,たましいは主,しゅをあがめ、","tok":[["する"],["と"],["マリヤ"],["は"],["言った","いった"],["、"],["「"],["わたし"],["の"],["魂","たましい"],["は"],["主","しゅ"],["を"],["あがめ"],["、"]]},{"verse":47,"text":"わたしの霊,れいは救主,すくいぬしなる神,かみをたたえます。","tok":[["わたし"],["の"],["霊","れい"],["は"],["救主","す"],["くい"],["ぬし"],["なる"],["神","かみ"],["を"],["たたえます"],["。"]]},{"verse":48,"text":"この卑,いやしい女,おんなをさえ、心,こころにかけてくださいました。今,いまからのち代々,よよの人々,ひとびとは、わたしをさいわいな女,おんなと言,いうでしょう、","tok":[["この"],["卑しい","いやしい"],["女","おんな"],["を"],["さえ"],["、"],["心","こころ"],["に"],["かけて"],["くださいました"],["。"],["今","いま"],["から"],["のち"],["代々","よよ"],["の"],["人々","ひとびと"],["は"],["、"],["わたし"],["を"],["さいわい"],["な"],["女","おんな"],["と"],["言うでしょう","いうでしょう"],["、"]]},{"verse":49,"text":"力,ちからあるかたが、わたしに大,おおきな事,ことをしてくださったからです。そのみ名,なはきよく、","tok":[["力","ちから"],["ある"],["かた"],["が"],["、"],["わたし"],["に"],["大きな","おおきな"],["事","こと"],["を"],["して"],["くださった"],["から"],["です"],["。"],["その"],["み名","みな"],["は"],["きよく"],["、"]]},{"verse":50,"text":"そのあわれみは、代々,よよ限,かぎりなく主,しゅをかしこみ恐,おそれる者,ものに及,およびます。","tok":[["その"],["あわれみ"],["は"],["、"],["代々","よ"],["よ"],["限","かぎり"],["なく"],["主","しゅ"],["を"],["かしこみ"],["恐れる","おそれる"],["者","もの"],["に"],["及","および"],["ます"],["。"]]},{"verse":51,"text":"主,しゅはみ腕,うでをもって力,ちからをふるい、心,こころの思,おもいのおごり高,たかぶる者,ものを追,おい散,ちらし、","tok":[["主","しゅ"],["は"],["み腕","みうで"],["を"],["もって"],["力","ちから"],["を"],["ふるい"],["、"],["心","こころ"],["の"],["思い","おもい"],["の"],["おごり高ぶる","おごりたかぶる"],["者","もの"],["を"],["追い散らし","おいちらし"],["、"]]},{"verse":52,"text":"権力,けんりょくある者,ものを王座,おうざから引,ひきおろし、卑,いやしい者,ものを引,ひき上,あげ、","tok":[["権力","けんりょく"],["ある"],["者","もの"],["を"],["王座","おうざ"],["から"],["引","ひき"],["おろし"],["、"],["卑しい","いやしい"],["者","もの"],["を"],["引上げ","ひきあげ"],["、"]]},{"verse":53,"text":"飢,うえている者,ものを良,よいもので飽,あかせ、富,とんでいる者,ものを空腹,くうふくのまま帰,かえらせなさいます。","tok":[["飢","うえ"],["て"],["いる"],["者","もの"],["を"],["良い","よい"],["もの"],["で"],["飽かせ","あかせ"],["、"],["富","とん"],["で"],["いる"],["者","もの"],["を"],["空腹","くうふく"],["の"],["まま"],["帰えらせ","かえらせ"],["なさいます"],["。"]]},{"verse":54,"text":"主,しゅは、あわれみをお忘,わすれにならず、その僕,しもべイスラエルを助,たすけてくださいました、","tok":[["主","しゅ"],["は"],["、"],["あわれみ"],["を"],["お忘","おわすれ"],["に"],["ならず"],["、"],["その"],["僕","し"],["も"],["べ"],["イスラエル"],["を"],["助けて","たすけて"],["くださいました"],["、"]]},{"verse":55,"text":"わたしたちの父祖,ふそアブラハムとその子孫,しそんとをとこしえにあわれむと約束,やくそくなさったとおりに」。","tok":[["わたしたち"],["の"],["父祖","ふそ"],["アブラハム"],["と"],["その"],["子孫","しそん"],["と"],["を"],["とこしえ"],["に"],["あわれむ"],["と"],["約束","やくそく"],["なさった"],["とおり"],["に"],["」"],["。"]]},{"verse":56,"text":"マリヤは、エリサベツのところに三か月,げつほど滞在,たいざいしてから、家,いえに帰,かえった。","tok":[["マリヤ"],["は"],["、"],["エリサベツ"],["の"],["ところ"],["に"],["三","さん"],["か月","かげつ"],["ほど"],["滞在","たいざい"],["して"],["から"],["、"],["家","いえ"],["に"],["帰えった","かえった"],["。"]]},{"verse":57,"text":"さてエリサベツは月,つきが満,みちて、男,おとこの子,こを産,うんだ。","tok":[["さて"],["エリサベツ"],["は"],["月","つき"],["が"],["満ちて","みちて"],["、"],["男の子","おとこのこ"],["を"],["産んだ","うんだ"],["。"]]},{"verse":58,"text":"近所,きんじょの人々,ひとびとや親族,しんぞくは、主,しゅが大,おおきなあわれみを彼女,かのじょにおかけになったことを聞,きいて、共,ともどもに喜,よろこんだ。","tok":[["近所","きんじょ"],["の"],["人々","ひとびと"],["や"],["親族","しんぞく"],["は"],["、"],["主","しゅ"],["が"],["大きな","おおきな"],["あわれみ"],["を"],["彼女","かのじょ"],["に"],["おかけ"],["に"],["なった"],["こと"],["を"],["聞いて","きいて"],["、"],["共ども","ともども"],["に"],["喜こんだ","よろこんだ"],["。"]]},{"verse":59,"text":"八日目,かめになったので、幼,おさな子,ごに割礼,かつれいをするために人々,ひとびとがきて、父,ちちの名,なにちなんでザカリヤという名,なにしようとした。","tok":[["八日目","かめ"],["に"],["なった"],["ので"],["、"],["幼な子","おさなご"],["に"],["割礼","かつれい"],["を"],["する"],["ため"],["に"],["人々","ひとびと"],["が"],["きて"],["、"],["父","ちち"],["の"],["名","な"],["に"],["ちなんで"],["ザカリヤ"],["と"],["いう"],["名","な"],["に"],["しよう"],["と"],["した"],["。"]]},{"verse":60,"text":"ところが、母親,ははおやは、「いいえ、ヨハネという名,なにしなくてはいけません」と言,いった。","tok":[["ところ"],["が"],["、"],["母親","ははおや"],["は"],["、"],["「"],["いいえ"],["、"],["ヨハネ"],["と"],["いう"],["名","な"],["に"],["しなくて"],["は"],["いけません"],["」"],["と"],["言った","いった"],["。"]]},{"verse":61,"text":"人々,ひとびとは、「あなたの親族,しんぞくの中,なかには、そういう名,なのついた者,ものは、ひとりもいません」と彼女,かのじょに言,いった。","tok":[["人々","ひとびと"],["は"],["、"],["「"],["あなた"],["の"],["親族","しんぞく"],["の"],["中","なか"],["に"],["は"],["、"],["そう"],["いう"],["名","な"],["の"],["ついた"],["者","もの"],["は"],["、"],["ひとり"],["も"],["いません"],["」"],["と"],["彼女","かのじょ"],["に"],["言った","いった"],["。"]]},{"verse":62,"text":"そして父親,ちちおやに、どんな名,なにしたいのですかと、合図,あいずで尋,たずねた。","tok":[["そして"],["父親","ちちおや"],["に"],["、"],["どんな"],["名","な"],["に"],["したい"],["の"],["です"],["か"],["と"],["、"],["合図","あいず"],["で"],["尋ねた","たずねた"],["。"]]},{"verse":63,"text":"ザカリヤは書,かき板,いたを持,もってこさせて、それに「その名,なはヨハネ」と書,かいたので、みんなの者,ものは不思議,ふしぎに思,おもった。","tok":[["ザカリヤ"],["は"],["書き","かき"],["板","いた"],["を"],["持って","もって"],["こさせて"],["、"],["それ"],["に"],["「"],["その"],["名","な"],["は"],["ヨハネ"],["」"],["と"],["書いた","かいた"],["ので"],["、"],["みんな"],["の"],["者","もの"],["は"],["不思議","ふしぎ"],["に"],["思った","おもった"],["。"]]},{"verse":64,"text":"すると、立,たちどころにザカリヤの口,くちが開,ひらけて舌,したがゆるみ、語,かたり出,だして神,かみをほめたたえた。","tok":[["する"],["と"],["、"],["立ち","たち"],["どころ"],["に"],["ザカリヤ"],["の"],["口","くち"],["が"],["開て","ひらけて"],["舌","した"],["が"],["ゆるみ"],["、"],["語り","かたり"],["出して","だして"],["神","かみ"],["を"],["ほめたたえた"],["。"]]},{"verse":65,"text":"近所,きんじょの人々,ひとびとはみな恐,おそれをいだき、またユダヤの山里,やまざとの至,いたるところに、これらの事,ことがことごとく語,かたり伝,つたえられたので、","tok":[["近所","きんじょ"],["の"],["人々","ひとびと"],["は"],["みな"],["恐","おそれ"],["を"],["いだき"],["、"],["また"],["ユダヤ"],["の"],["山里","やまざと"],["の"],["至る","いたる"],["ところ"],["に"],["、"],["これ"],["ら"],["の"],["事","こと"],["が"],["ことごとく"],["語り伝えられた","かたりつたえられた"],["ので"],["、"]]},{"verse":66,"text":"聞,きく者,ものたちは皆,みなそれを心,こころに留,とめて、「この子,こは、いったい、どんな者,ものになるだろう」と語,かたり合,あった。主,しゅのみ手,てが彼,かれと共,ともにあった。","tok":[["聞く","きく"],["者","もの"],["たち"],["は"],["皆","みな"],["それ"],["を"],["心","こころ"],["に"],["留","とめ"],["て"],["、"],["「"],["この"],["子","こ"],["は"],["、"],["いったい"],["、"],["どんな"],["者","もの"],["に"],["なるだろう"],["」"],["と"],["語り合った","かたりあった"],["。"],["主","しゅ"],["のみ"],["手","て"],["が"],["彼","かれ"],["と"],["共","とも"],["に"],["あった"],["。"]]},{"verse":67,"text":"父,ちちザカリヤは聖霊,せいれいに満,みたされ、預言,よげんして言,いった、","tok":[["父","ちち"],["ザカリヤ"],["は"],["聖霊","せいれい"],["に"],["満たされ","みたされ"],["、"],["預言","よげん"],["して"],["言った","いった"],["、"]]},{"verse":68,"text":"「主,しゅなるイスラエルの神,かみは、ほむべきかな。神,かみはその民,たみを顧,かえりみてこれをあがない、","tok":[["「"],["主","しゅ"],["なる"],["イスラエル"],["の"],["神","かみ"],["は"],["、"],["ほ"],["むべき"],["か"],["な"],["。"],["神","かみ"],["は"],["その"],["民","たみ"],["を"],["顧て","かえりみて"],["これ"],["を"],["あがない"],["、"]]},{"verse":69,"text":"わたしたちのために救,すくいの角,つのを僕,しもべダビデの家,いえにお立,たてになった。","tok":[["わたしたち"],["の"],["ため"],["に"],["救い","すくい"],["の"],["角","つ"],["の"],["を"],["僕","し"],["も"],["べ"],["ダビデ"],["の"],["家","いえ"],["に"],["お立","おたて"],["に"],["なった"],["。"]]},{"verse":70,"text":"古,ふるくから、聖,せいなる預言者,よげんしゃたちの口,くちによってお語,かたりになったように、","tok":[["古く","ふるく"],["から"],["、"],["聖","せい"],["なる"],["預言者","よげんしゃ"],["たち"],["の"],["口","くち"],["によって"],["お語り","おかたり"],["に"],["なった"],["よう"],["に"],["、"]]},{"verse":71,"text":"わたしたちを敵,てきから、またすべてわたしたちを憎,にくむ者,ものの手,てから、救,すくい出,だすためである。","tok":[["わたしたち"],["を"],["敵","てき"],["から"],["、"],["また"],["すべて"],["わたしたち"],["を"],["憎む","にくむ"],["者","もの"],["の"],["手","て"],["から"],["、"],["救い出す","すくいだす"],["ため"],["で"],["ある"],["。"]]},{"verse":72,"text":"こうして、神,かみはわたしたちの父祖,ふそたちにあわれみをかけ、その聖,せいなる契約,けいやく、","tok":[["こう"],["して"],["、"],["神","かみ"],["は"],["わたしたち"],["の"],["父祖","ふそ"],["たち"],["に"],["あわれみ"],["を"],["かけ"],["、"],["その"],["聖","せい"],["なる"],["契約","けいやく"],["、"]]},{"verse":73,"text":"すなわち、父祖,ふそアブラハムにお立,たてになった誓,ちかいをおぼえて、","tok":[["すなわち"],["、"],["父祖","ふそ"],["アブラハム"],["に"],["お立","おたて"],["に"],["なった"],["誓い","ちかい"],["を"],["おぼえて"],["、"]]},{"verse":74,"text":"わたしたちを敵,てきの手,てから救,すくい出,だし、","tok":[["わたしたち"],["を"],["敵","てき"],["の"],["手","て"],["から"],["救い出し","すくいだし"],["、"]]},{"verse":75,"text":"生,いきている限,かぎり、きよく正,ただしく、みまえに恐,おそれなく仕,つかえさせてくださるのである。","tok":[["生きて","いきて"],["いる"],["限","かぎり"],["、"],["きよく"],["正く","ただしく"],["、"],["みまえ"],["に"],["恐れなく","おそれなく"],["仕えさせて","つかえさせて"],["くださる"],["ので"],["ある"],["。"]]},{"verse":76,"text":"幼,おさな子,ごよ、あなたは、いと高,たかき者,ものの預言者,よげんしゃと呼,よばれるであろう。主,しゅのみまえに先立,さきだって行,いき、その道,みちを備,そなえ、","tok":[["幼な子","おさなご"],["よ"],["、"],["あなた"],["は"],["、"],["いと"],["高き","たかき"],["者","もの"],["の"],["預言者","よげんしゃ"],["と"],["呼ばれるで","よばれるで"],["あろう"],["。"],["主","しゅ"],["のみ"],["まえ"],["に"],["先立って","さきだって"],["行き","いき"],["、"],["その"],["道","みち"],["を"],["備","そなえ"],["、"]]},{"verse":77,"text":"罪,つみのゆるしによる救,すくいをその民,たみに知,しらせるのであるから。","tok":[["罪","つみ"],["の"],["ゆるし"],["に"],["よる"],["救い","すくい"],["を"],["その"],["民","たみ"],["に"],["知らせる","しらせる"],["ので"],["ある"],["から"],["。"]]},{"verse":78,"text":"これはわたしたちの神,かみのあわれみ深,ふかいみこころによる。また、そのあわれみによって、日,ひの光,ひかりが上,うえからわたしたちに臨,のぞみ、","tok":[["これ"],["は"],["わたしたち"],["の"],["神","かみ"],["の"],["あわれみ"],["深い","ふかい"],["みこころ"],["に"],["よる"],["。"],["また"],["、"],["その"],["あわれみ"],["によって"],["、"],["日","ひ"],["の"],["光","ひかり"],["が"],["上","うえ"],["から"],["わたしたち"],["に"],["臨み","のぞみ"],["、"]]},{"verse":79,"text":"暗黒,あんこくと死,しの陰,かげとに住,すむ者,ものを照,てらし、わたしたちの足,あしを平和,へいわの道,みちへ導,みちびくであろう」。","tok":[["暗黒","あんこく"],["と"],["死","し"],["の"],["陰","かげ"],["と"],["に"],["住む","すむ"],["者","もの"],["を"],["照","てらし"],["、"],["わたしたち"],["の"],["足","あし"],["を"],["平和","へいわ"],["の"],["道","みち"],["へ"],["導くで","みちびくで"],["あろう"],["」"],["。"]]},{"verse":80,"text":"幼,おさな子,ごは成長,せいちょうし、その霊,れいも強,つよくなり、そしてイスラエルに現,あらわれる日,ひまで、荒野,あらのにいた。","tok":[["幼な子","おさなご"],["は"],["成長","せいちょう"],["し"],["、"],["その"],["霊","れい"],["も"],["強く","つよく"],["なり"],["、"],["そして"],["イスラエル"],["に"],["現われる","あらわれる"],["日","ひ"],["まで"],["、"],["荒野","あら"],["のに"],["いた"],["。"]]}]
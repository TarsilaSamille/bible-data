[{"verse":1,"text":"ある安息日,あんそくにちのこと、食事,しょくじをするために、あるパリサイ派,はのかしらの家,いえにはいって行,いかれたが、人々,ひとびとはイエスの様子,ようすをうかがっていた。","tok":[["ある"],["安息日","あんそくにち"],["の"],["こと"],["、"],["食事","しょくじ"],["を"],["する"],["ため"],["に"],["、"],["ある"],["パリサイ"],["派","は"],["の"],["かしら"],["の"],["家","いえ"],["に"],["はいって"],["行かれた","いかれた"],["が"],["、"],["人々","ひとびと"],["は"],["イエス"],["の"],["様子","ようす"],["を"],["うかがって"],["いた"],["。"]]},{"verse":2,"text":"するとそこに、水腫,すいしゅをわずらっている人,ひとが、みまえにいた。","tok":[["する"],["と"],["そこ"],["に"],["、"],["水腫","すいしゅ"],["を"],["わずらって"],["いる"],["人","ひと"],["が"],["、"],["みまえ"],["に"],["いた"],["。"]]},{"verse":3,"text":"イエスは律法,りっぽう学者,がくしゃやパリサイ人,びとたちにむかって言,いわれた、「安息日,あんそくにちに人,ひとをいやすのは、正,ただしいことかどうか」。","tok":[["イエス"],["は"],["律法学者","りっぽうがくしゃ"],["や"],["パリサイ"],["人","びとたち"],["に"],["むかって"],["言われた","いわれた"],["、"],["「"],["安息日","あんそくにち"],["に"],["人","ひと"],["を"],["いやす"],["の"],["は"],["、"],["正い","ただしい"],["こと"],["か"],["どう"],["か"],["」"],["。"]]},{"verse":4,"text":"彼,かれらは黙,だまっていた。そこでイエスはその人,ひとに手,てを置,おいていやしてやり、そしてお帰,かえしになった。","tok":[["彼","かれ"],["ら"],["は"],["黙って","だまって"],["いた"],["。"],["そこ"],["で"],["イエス"],["は"],["その"],["人","ひと"],["に"],["手","て"],["を"],["置いて","おいて"],["いやして"],["やり"],["、"],["そして"],["お帰し","おかえし"],["に"],["なった"],["。"]]},{"verse":5,"text":"それから彼,かれらに言,いわれた、「あなたがたのうちで、自分,じぶんのむすこか牛,うしが井戸,いどに落,おち込,こんだなら、安息日,あんそくにちだからといって、すぐに引,ひき上,あげてやらない者,ものがいるだろうか」。","tok":[["それ"],["から"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["がた"],["の"],["うち"],["で"],["、"],["自分","じぶん"],["の"],["むすこ"],["か"],["牛","うし"],["が"],["井戸","いど"],["に"],["落込","おちこんだな"],["ら"],["、"],["安息日","あんそくにちだか"],["ら"],["と"],["いって"],["、"],["すぐ"],["に"],["引上げて","ひきあげて"],["やらない"],["者","もの"],["が"],["いるだろう"],["か"],["」"],["。"]]},{"verse":6,"text":"彼,かれらはこれに対,たいして返,かえす言葉,ことばがなかった。","tok":[["彼","かれ"],["ら"],["は"],["これ"],["に対して","にたいして"],["返えす","かえす"],["言葉","ことば"],["が"],["なかった"],["。"]]},{"verse":7,"text":"客,きゃくに招,まねかれた者,ものたちが上座,じょうざを選,えらんでいる様子,ようすをごらんになって、彼,かれらに一つの譬,たとえを語,かたられた。","tok":[["客","きゃく"],["に"],["招かれた","まねかれた"],["者","もの"],["たち"],["が"],["上座","じょうざ"],["を"],["選らんで","えらんで"],["いる"],["様子","ようす"],["を"],["ごらん"],["に"],["なって"],["、"],["彼","かれ"],["ら"],["に"],["一","ひと"],["つ"],["の"],["譬","たとえ"],["を"],["語られた","かたられた"],["。"]]},{"verse":8,"text":"「婚,こん宴,えんに招,まねかれたときには、上座,じょうざにつくな。あるいは、あなたよりも身分,みぶんの高,たかい人,ひとが招,まねかれているかも知,しれない。","tok":[["「"],["婚","こん"],["宴","えん"],["に"],["招かれた","まねかれた"],["とき"],["に"],["は"],["、"],["上座","じょうざ"],["に"],["つく"],["な"],["。"],["あるいは"],["、"],["あなた"],["より"],["も"],["身分","みぶん"],["の"],["高い","たかい"],["人","ひと"],["が"],["招かれて","まねかれて"],["いる"],["か"],["も"],["知れない","しれない"],["。"]]},{"verse":9,"text":"その場合,ばあい、あなたとその人,ひととを招,まねいた者,ものがきて、『このかたに座,ざを譲,ゆずってください』と言,いうであろう。そのとき、あなたは恥,はじ入,いって末座,まつざにつくことになるであろう。","tok":[["その"],["場合","ばあい"],["、"],["あなた"],["と"],["その"],["人","ひと"],["と"],["を"],["招いた","まねいた"],["者","もの"],["が"],["きて"],["、"],["『"],["このかた"],["に"],["座","ざ"],["を"],["譲って","ゆずって"],["ください"],["』"],["と"],["言うで","いうで"],["あろう"],["。"],["その"],["とき"],["、"],["あなた"],["は"],["恥入って","はじいって"],["末座","まつざ"],["に"],["つく"],["こと"],["に"],["なるで"],["あろう"],["。"]]},{"verse":10,"text":"むしろ、招,まねかれた場合,ばあいには、末座,まつざに行,いってすわりなさい。そうすれば、招,まねいてくれた人,ひとがきて、『友,ともよ、上座,じょうざの方,ほうへお進,すすみください』と言,いうであろう。そのとき、あなたは席,せきを共,ともにするみんなの前,まえで、面目,めんぼくをほどこすことになるであろう。","tok":[["むしろ"],["、"],["招かれた","まねかれた"],["場合","ばあい"],["に"],["は"],["、"],["末座","まつざ"],["に"],["行って","いって"],["すわり"],["なさい"],["。"],["そう"],["すれば"],["、"],["招いて","まねいて"],["くれた"],["人","ひと"],["が"],["きて"],["、"],["『"],["友","とも"],["よ"],["、"],["上座","じょうざ"],["の"],["方","ほう"],["へ"],["お進み","おすすみ"],["ください"],["』"],["と"],["言うで","いうで"],["あろう"],["。"],["その"],["とき"],["、"],["あなた"],["は"],["席","せき"],["を"],["共","とも"],["に"],["する"],["みんな"],["の"],["前","まえ"],["で"],["、"],["面目","めんぼく"],["を"],["ほどこす"],["こと"],["に"],["なるで"],["あろう"],["。"]]},{"verse":11,"text":"おおよそ、自分,じぶんを高,たかくする者,ものは低,ひくくされ、自分,じぶんを低,ひくくする者,ものは高,たかくされるであろう」。","tok":[["おおよそ"],["、"],["自分","じぶん"],["を"],["高かく","たかく"],["する"],["者","もの"],["は"],["低く","ひくく"],["され"],["、"],["自分","じぶん"],["を"],["低く","ひくく"],["する"],["者","もの"],["は"],["高かく","たかく"],["されるで"],["あろう"],["」"],["。"]]},{"verse":12,"text":"また、イエスは自分,じぶんを招,まねいた人,ひとに言,いわれた、「午餐,ごさんまたは晩餐,ばんさんの席,せきを設,もうける場合,ばあいには、友人,ゆうじん、兄弟,きょうだい、親族,しんぞく、金持,かねもちの隣,となり人,びとなどは呼,よばぬがよい。恐,おそらく彼,かれらもあなたを招,まねきかえし、それであなたは返礼,へんれいを受,うけることになるから。","tok":[["また"],["、"],["イエス"],["は"],["自分","じぶん"],["を"],["招いた","まねいた"],["人","ひと"],["に"],["言われた","いわれた"],["、"],["「"],["午餐","ごさん"],["また"],["は"],["晩餐","ばんさん"],["の"],["席","せき"],["を"],["設ける","もうける"],["場合","ばあい"],["に"],["は"],["、"],["友人","ゆうじん"],["、"],["兄弟","きょうだい"],["、"],["親族","しんぞく"],["、"],["金持","かねもち"],["の"],["隣人","となりびとなど"],["は"],["呼ばぬ","よばぬ"],["が"],["よい"],["。"],["恐らく","おそらく"],["彼","かれ"],["ら"],["も"],["あなた"],["を"],["招き","まねき"],["かえし"],["、"],["それ"],["で"],["あなた"],["は"],["返礼","へんれい"],["を"],["受る","うける"],["こと"],["に"],["なる"],["から"],["。"]]},{"verse":13,"text":"むしろ、宴会,えんかいを催,もよおす場合,ばあいには、貧乏人,びんぼうにん、不具者,ふぐしゃ、足,あしなえ、盲人,もうじんなどを招,まねくがよい。","tok":[["むしろ"],["、"],["宴会","えんかい"],["を"],["催おす","もよおす"],["場合","ばあい"],["に"],["は"],["、"],["貧乏人","びんぼうにん"],["、"],["不具者","ふぐしゃ"],["、"],["足","あし"],["なえ"],["、"],["盲人","もうじん"],["など"],["を"],["招く","まねく"],["が"],["よい"],["。"]]},{"verse":14,"text":"そうすれば、彼,かれらは返礼,へんれいができないから、あなたはさいわいになるであろう。正,ただしい人々,ひとびとの復活,ふっかつの際,さいには、あなたは報,むくいられるであろう」。","tok":[["そう"],["すれば"],["、"],["彼","かれ"],["ら"],["は"],["返礼","へんれい"],["が"],["できない"],["から"],["、"],["あなた"],["は"],["さいわい"],["に"],["なるで"],["あろう"],["。"],["正い","ただしい"],["人々","ひとびと"],["の"],["復活","ふっかつ"],["の"],["際","さい"],["に"],["は"],["、"],["あなた"],["は"],["報いられるで","むくいられるで"],["あろう"],["」"],["。"]]},{"verse":15,"text":"列席者,れっせきしゃのひとりがこれを聞,きいてイエスに「神,かみの国,くにで食事,しょくじをする人,ひとは、さいわいです」と言,いった。","tok":[["列席者","れっせきしゃ"],["の"],["ひとり"],["が"],["これ"],["を"],["聞いて","きいて"],["イエス"],["に"],["「"],["神","かみ"],["の"],["国","くに"],["で"],["食事","しょくじ"],["を"],["する"],["人","ひと"],["は"],["、"],["さいわい"],["です"],["」"],["と"],["言った","いった"],["。"]]},{"verse":16,"text":"そこでイエスが言,いわれた、「ある人,ひとが盛大,せいだいな晩餐,ばんさん会,かいを催,もよおして、大,おおぜいの人,ひとを招,まねいた。","tok":[["そこ"],["で"],["イエス"],["が"],["言われた","いわれた"],["、"],["「"],["ある"],["人","ひと"],["が"],["盛大","せいだい"],["な"],["晩餐会","ばんさんかい"],["を"],["催","もよおし"],["て"],["、"],["大ぜい","おおぜい"],["の"],["人","ひと"],["を"],["招いた","まねいた"],["。"]]},{"verse":17,"text":"晩餐,ばんさんの時刻,じこくになったので、招,まねいておいた人,ひとたちのもとに僕,しもべを送,おくって、『さあ、おいでください。もう準備,じゅんびができましたから』と言,いわせた。","tok":[["晩餐","ばんさん"],["の"],["時刻","じこく"],["に"],["なった"],["ので"],["、"],["招いて","まねいて"],["おいた"],["人","ひと"],["たち"],["の"],["もと"],["に"],["僕","し"],["も"],["べ"],["を"],["送って","おくって"],["、"],["『"],["さあ"],["、"],["おいで"],["ください"],["。"],["もう"],["準備","じゅんび"],["が"],["できました"],["から"],["』"],["と"],["言わせた","いわせた"],["。"]]},{"verse":18,"text":"ところが、みんな一様,いちように断,ことわりはじめた。最初,さいしょの人,ひとは、『わたしは土地,とちを買,かいましたので、行,いって見,みなければなりません。どうぞ、おゆるしください』と言,いった。","tok":[["ところ"],["が"],["、"],["みんな"],["一様","いちよう"],["に"],["断り","ことわり"],["はじめた"],["。"],["最初","さいしょ"],["の"],["人","ひと"],["は"],["、"],["『"],["わたし"],["は"],["土地","とち"],["を"],["買","かい"],["ました"],["ので"],["、"],["行って","いって"],["見なければ","みなければ"],["なりません"],["。"],["どうぞ"],["、"],["おゆるし"],["ください"],["』"],["と"],["言った","いった"],["。"]]},{"verse":19,"text":"ほかの人,ひとは、『わたしは五対,ついの牛,うしを買,かいましたので、それをしらべに行,いくところです。どうぞ、おゆるしください』、","tok":[["ほか"],["の"],["人","ひと"],["は"],["、"],["『"],["わたし"],["は"],["五","ご"],["対","たい"],["の"],["牛","うし"],["を"],["買","かい"],["ました"],["ので"],["、"],["それ"],["を"],["しらべ"],["に"],["行く","いく"],["ところ"],["です"],["。"],["どうぞ"],["、"],["おゆるし"],["ください"],["』"],["、"]]},{"verse":20,"text":"もうひとりの人,ひとは、『わたしは妻,つまをめとりましたので、参,まいることができません』と言,いった。","tok":[["もう"],["ひとり"],["の"],["人","ひと"],["は"],["、"],["『"],["わたし"],["は"],["妻","つま"],["を"],["めとりました"],["ので"],["、"],["参る","まいる"],["こと"],["が"],["できません"],["』"],["と"],["言った","いった"],["。"]]},{"verse":21,"text":"僕,しもべは帰,かえってきて、以上,いじょうの事,ことを主人,しゅじんに報告,ほうこくした。すると家,いえの主人,しゅじんはおこって僕,しもべに言,いった、『いますぐに、町,まちの大通,おおどおりや小道,こみちへ行,いって、貧乏人,びんぼうにん、不具者,ふぐしゃ、盲人,もうじん、足,あしなえなどを、ここへ連,つれてきなさい』。","tok":[["僕","し"],["も"],["べ"],["は"],["帰えって","かえって"],["きて"],["、"],["以上","いじょう"],["の"],["事","こと"],["を"],["主人","しゅじん"],["に"],["報告","ほうこく"],["した"],["。"],["する"],["と"],["家","いえ"],["の"],["主人","しゅじん"],["は"],["おこって"],["僕","し"],["も"],["べ"],["に"],["言った","いった"],["、"],["『"],["いま"],["すぐ"],["に"],["、"],["町","まち"],["の"],["大通り","おおどおり"],["や"],["小道","こみち"],["へ"],["行って","いって"],["、"],["貧乏人","びんぼうにん"],["、"],["不具者","ふぐしゃ"],["、"],["盲人","もうじん"],["、"],["足","あし"],["な"],["え"],["など"],["を"],["、"],["ここ"],["へ"],["連れて","つれて"],["き"],["なさい"],["』"],["。"]]},{"verse":22,"text":"僕,しもべは言,いった、『ご主人様,しゅじんさま、仰,おおせのとおりにいたしましたが、まだ席,せきがございます』。","tok":[["僕","し"],["も"],["べ"],["は"],["言った","いった"],["、"],["『"],["ご主人様","ごしゅじんさま"],["、"],["仰せ","おおせ"],["の"],["とおり"],["に"],["いたしました"],["が"],["、"],["まだ"],["席","せき"],["が"],["ございます"],["』"],["。"]]},{"verse":23,"text":"主人,しゅじんが僕,しもべに言,いった、『道,みちやかきねのあたりに出,でて行,いって、この家,いえがいっぱいになるように、人々,ひとびとを無理,むりやりにひっぱってきなさい。","tok":[["主人","しゅじん"],["が"],["僕","し"],["も"],["べ"],["に"],["言った","いった"],["、"],["『"],["道","みち"],["や"],["かきね"],["の"],["あたり"],["に"],["出て","でて"],["行って","いって"],["、"],["この"],["家","いえ"],["が"],["いっぱい"],["に"],["なる"],["よう"],["に"],["、"],["人々","ひとびと"],["を"],["無理やり","むりやり"],["に"],["ひっぱって"],["き"],["なさい"],["。"]]},{"verse":24,"text":"あなたがたに言,いって置,おくが、招,まねかれた人,ひとで、わたしの晩餐,ばんさんにあずかる者,ものはひとりもないであろう』」。","tok":[["あなた"],["がた"],["に"],["言って","いって"],["置く","おく"],["が"],["、"],["招かれた","まねかれた"],["人","ひと"],["で"],["、"],["わたし"],["の"],["晩餐","ばんさん"],["に"],["あずかる"],["者","もの"],["は"],["ひとり"],["も"],["ないで"],["あろう"],["』"],["」"],["。"]]},{"verse":25,"text":"大,おおぜいの群衆,ぐんしゅうがついてきたので、イエスは彼,かれらの方,ほうに向,むいて言,いわれた、","tok":[["大ぜい","おおぜい"],["の"],["群衆","ぐんしゅう"],["が"],["ついて"],["きた"],["ので"],["、"],["イエス"],["は"],["彼","かれ"],["ら"],["の"],["方","ほう"],["に"],["向いて","むいて"],["言われた","いわれた"],["、"]]},{"verse":26,"text":"「だれでも、父,ちち、母,はは、妻,つま、子,こ、兄弟,きょうだい、姉妹,しまい、さらに自分,じぶんの命,いのちまでも捨,すてて、わたしのもとに来,くるのでなければ、わたしの弟子,でしとなることはできない。","tok":[["「"],["だれ"],["で"],["も"],["、"],["父","ちち"],["、"],["母","はは"],["、"],["妻","つま"],["、"],["子","こ"],["、"],["兄弟","きょうだい"],["、"],["姉妹","しまい"],["、"],["さらに"],["自分","じぶん"],["の"],["命","いのち"],["まで"],["も"],["捨てて","すてて"],["、"],["わたし"],["の"],["もと"],["に"],["来る","くる"],["ので"],["なければ"],["、"],["わたし"],["の"],["弟子","でし"],["と"],["なる"],["こと"],["は"],["できない"],["。"]]},{"verse":27,"text":"自分,じぶんの十字架,じゅうじかを負,おうてわたしについて来,くるものでなければ、わたしの弟子,でしとなることはできない。","tok":[["自分","じぶん"],["の"],["十字架","じゅうじか"],["を"],["負うて","おうて"],["わたし"],["について"],["来る","くる"],["もの"],["で"],["なければ"],["、"],["わたし"],["の"],["弟子","でし"],["と"],["なる"],["こと"],["は"],["できない"],["。"]]},{"verse":28,"text":"あなたがたのうちで、だれかが邸宅,ていたくを建,たてようと思,おもうなら、それを仕上,しあげるのに足,たりるだけの金,かねを持,もっているかどうかを見,みるため、まず、すわってその費用,ひようを計算,けいさんしないだろうか。","tok":[["あなた"],["がた"],["の"],["うち"],["で"],["、"],["だれ"],["か"],["が"],["邸宅","ていたく"],["を"],["建てよう","たてよう"],["と"],["思うなら","おもうなら"],["、"],["それ"],["を"],["仕上げる","しあげる"],["のに"],["足りる","たりる"],["だけ"],["の"],["金","かね"],["を"],["持って","もって"],["いる"],["か"],["どう"],["か"],["を"],["見る","みる"],["ため"],["、"],["まず"],["、"],["すわって"],["その"],["費用","ひよう"],["を"],["計算","けいさん"],["しないだろう"],["か"],["。"]]},{"verse":29,"text":"そうしないと、土台,どだいをすえただけで完成,かんせいすることができず、見,みているみんなの人,ひとが、","tok":[["そう"],["しない"],["と"],["、"],["土台","どだい"],["を"],["すえた"],["だけ"],["で"],["完成","かんせい"],["する"],["こと"],["が"],["できず"],["、"],["見て","みて"],["いる"],["みんな"],["の"],["人","ひと"],["が"],["、"]]},{"verse":30,"text":"『あの人,ひとは建,たてかけたが、仕上,しあげができなかった』と言,いってあざ笑,わらうようになろう。","tok":[["『"],["あの"],["人","ひと"],["は"],["建て","たて"],["かけた"],["が"],["、"],["仕上","しあげ"],["が"],["できなかった"],["』"],["と"],["言って","いって"],["あざ笑う","あざわらう"],["よう"],["に"],["なろう"],["。"]]},{"verse":31,"text":"また、どんな王,おうでも、ほかの王,おうと戦,たたかいを交,まじえるために出,でて行,いく場合,ばあいには、まず座,ざして、こちらの一万人,まんにんをもって、二万人,まんにんを率,ひきいて向,むかって来,くる敵,てきに対抗,たいこうできるかどうか、考,かんがえて見,みないだろうか。","tok":[["また"],["、"],["どんな"],["王","おう"],["で"],["も"],["、"],["ほか"],["の"],["王","おう"],["と"],["戦い","たたかい"],["を"],["交じえる","まじえる"],["ため"],["に"],["出て","でて"],["行く","いく"],["場合","ばあい"],["に"],["は"],["、"],["まず"],["座して","ざして"],["、"],["こちら"],["の"],["一万人","まんにん"],["を"],["もって"],["、"],["二万人","まんにん"],["を"],["率いて","ひきいて"],["向かって","むかって"],["来る","くる"],["敵","てき"],["に"],["対抗","たいこう"],["できる"],["か"],["どう"],["か"],["、"],["考","かんがえ"],["て"],["見ないだろう","みないだろう"],["か"],["。"]]},{"verse":32,"text":"もし自分,じぶんの力,ちからにあまれば、敵,てきがまだ遠,とおくにいるうちに、使者,ししゃを送,おくって、和,わを求,もとめるであろう。","tok":[["もし"],["自分","じぶん"],["の"],["力","ちから"],["に"],["あまれば"],["、"],["敵","てき"],["が"],["まだ"],["遠く","とおく"],["に"],["いる"],["うち"],["に"],["、"],["使者","ししゃ"],["を"],["送って","おくって"],["、"],["和","わ"],["を"],["求めるで","もとめるで"],["あろう"],["。"]]},{"verse":33,"text":"それと同,おなじように、あなたがたのうちで、自分,じぶんの財産,ざいさんをことごとく捨,すて切,きるものでなくては、わたしの弟子,でしとなることはできない。","tok":[["それ"],["と"],["同じ","おなじ"],["よう"],["に"],["、"],["あなた"],["がた"],["の"],["うち"],["で"],["、"],["自分","じぶん"],["の"],["財産","ざいさん"],["を"],["ことごとく"],["捨て","すて"],["切る","きる"],["もの"],["で"],["なく"],["ては"],["、"],["わたし"],["の"],["弟子","でし"],["と"],["なる"],["こと"],["は"],["できない"],["。"]]},{"verse":34,"text":"塩,しおは良,よいものだ。しかし、塩,しおもききめがなくなったら、何,なにによって塩味,しおあじが取,とりもどされようか。","tok":[["塩","しお"],["は"],["良い","よい"],["もの"],["だ"],["。"],["しかし"],["、"],["塩","しお"],["も"],["きき"],["め"],["が"],["なくなったら"],["、"],["何に","なに"],["によって"],["塩味","しおあじ"],["が"],["取","とり"],["もどされよう"],["か"],["。"]]},{"verse":35,"text":"土,つちにも肥料,ひりょうにも役,やく立,たたず、外,そとに投,なげ捨,すてられてしまう。聞,きく耳,みみのあるものは聞,きくがよい」。","tok":[["土","つち"],["に"],["も"],["肥料","ひりょう"],["に"],["も"],["役立たず","やくたたず"],["、"],["外","そと"],["に"],["投捨てられて","なげすてられて"],["しまう"],["。"],["聞く","きく"],["耳","みみ"],["の"],["ある"],["もの"],["は"],["聞く","きく"],["が"],["よい"],["」"],["。"]]}]
[{"verse":1,"text":"イエスは弟子,でしたちに言,いわれた、「罪,つみの誘惑,ゆうわくが来,くることは避,さけられない。しかし、それをきたらせる者,ものは、わざわいである。","tok":[["イエス"],["は"],["弟子","でし"],["たち"],["に"],["言われた","いわれた"],["、"],["「"],["罪","つみ"],["の"],["誘惑","ゆうわく"],["が"],["来る","くる"],["こと"],["は"],["避けられない","さけられない"],["。"],["しかし"],["、"],["それ"],["を"],["きたらせる"],["者","もの"],["は"],["、"],["わざわい"],["で"],["ある"],["。"]]},{"verse":2,"text":"これらの小,ちいさい者,もののひとりを罪,つみに誘惑,ゆうわくするよりは、むしろ、ひきうすを首,くびにかけられて海,うみに投,なげ入,いれられた方,ほうが、ましである。","tok":[["これ"],["ら"],["の"],["小さい","ちいさい"],["者","もの"],["の"],["ひとり"],["を"],["罪","つみ"],["に"],["誘惑","ゆうわく"],["する"],["より"],["は"],["、"],["むしろ"],["、"],["ひきうす"],["を"],["首","くび"],["に"],["かけられて"],["海","うみ"],["に"],["投入れられた","なげいれられた"],["方","ほう"],["が"],["、"],["まし"],["で"],["ある"],["。"]]},{"verse":3,"text":"あなたがたは、自分,じぶんで注意,ちゅういしていなさい。もしあなたの兄弟,きょうだいが罪,つみを犯,おかすなら、彼,かれをいさめなさい。そして悔,くい改,あらためたら、ゆるしてやりなさい。","tok":[["あなた"],["がた"],["は"],["、"],["自分","じぶん"],["で"],["注意","ちゅうい"],["して"],["い"],["なさい"],["。"],["もし"],["あなた"],["の"],["兄弟","きょうだい"],["が"],["罪","つみ"],["を"],["犯すなら","おかすなら"],["、"],["彼","かれ"],["を"],["いさめ"],["なさい"],["。"],["そして"],["悔い","くい"],["改","あらため"],["たら"],["、"],["ゆるして"],["やり"],["なさい"],["。"]]},{"verse":4,"text":"もしあなたに対,たいして一日,にちに七度,ど罪,つみを犯,おかし、そして七度,ど『悔,くい改,あらためます』と言,いってあなたのところへ帰,かえってくれば、ゆるしてやるがよい」。","tok":[["もし"],["あなた"],["に対して","にたいして"],["一","いち"],["日","にち"],["に"],["七","しち"],["度罪","度つみ"],["を"],["犯し","おかし"],["、"],["そして"],["七","なな"],["度","ど"],["『"],["悔い改めます","くいあらためます"],["』"],["と"],["言って","いって"],["あなた"],["の"],["ところ"],["へ"],["帰えって","かえって"],["くれば"],["、"],["ゆるして"],["やる"],["が"],["よい"],["」"],["。"]]},{"verse":5,"text":"使徒,しとたちは主,しゅに「わたしたちの信仰,しんこうを増,ましてください」と言,いった。","tok":[["使徒","しと"],["たち"],["は"],["主に","しゅに"],["「"],["わたしたち"],["の"],["信仰","しんこう"],["を"],["増して","まして"],["ください"],["」"],["と"],["言った","いった"],["。"]]},{"verse":6,"text":"そこで主,しゅが言,いわれた、「もし、からし種,だね一粒,つぶほどの信仰,しんこうがあるなら、この桑,くわの木,きに、『抜,ぬけ出,だして海,うみに植,うわれ』と言,いったとしても、その言葉,ことばどおりになるであろう。","tok":[["そこ"],["で"],["主","しゅ"],["が"],["言われた","いわれた"],["、"],["「"],["もし"],["、"],["からし"],["種","だ"],["ね"],["一","いち"],["粒","つぶ"],["の"],["信仰","しんこう"],["が"],["あるなら"],["、"],["この"],["桑","くわ"],["の"],["木","き"],["に"],["、"],["『"],["抜出して","ぬけだして"],["海","うみ"],["に"],["植われ","うわれ"],["』"],["と"],["言った","いった"],["として"],["も"],["、"],["その"],["言葉","ことば"],["どおり"],["に"],["なるで"],["あろう"],["。"]]},{"verse":7,"text":"あなたがたのうちのだれかに、耕作,こうさくか牧畜,ぼくちくかをする僕,しもべがあるとする。その僕,しもべが畑,はたけから帰,かえって来,きたとき、彼,かれに『すぐきて、食卓,しょくたくにつきなさい』と言,いうだろうか。","tok":[["あなた"],["がた"],["の"],["うち"],["の"],["だれ"],["か"],["に"],["、"],["耕作","こうさく"],["か"],["牧畜","ぼくちく"],["か"],["を"],["する"],["僕","し"],["も"],["べ"],["が"],["ある"],["と"],["する"],["。"],["その"],["僕","し"],["も"],["べ"],["が"],["畑","はたけ"],["から"],["帰えって","かえって"],["来た","きた"],["とき"],["、"],["彼","かれ"],["に"],["『"],["すぐ"],["きて"],["、"],["食卓","しょくたく"],["に"],["つき"],["なさい"],["』"],["と"],["言うだろう","いうだろう"],["か"],["。"]]},{"verse":8,"text":"かえって、『夕食,ゆうしょくの用意,よういをしてくれ。そしてわたしが飲,のみ食,くいをするあいだ、帯,おびをしめて給仕,きゅうじをしなさい。そのあとで、飲,のみ食,くいをするがよい』と、言,いうではないか。","tok":[["かえって"],["、"],["『"],["夕食","ゆうしょく"],["の"],["用意","ようい"],["を"],["して"],["くれ"],["。"],["そして"],["わたし"],["が"],["飲み食い","のみくい"],["を"],["する"],["あいだ"],["、"],["帯","おび"],["を"],["しめて"],["給仕","きゅうじ"],["を"],["し"],["なさい"],["。"],["その"],["あと"],["で"],["、"],["飲み食い","のみくい"],["を"],["する"],["が"],["よい"],["』"],["と"],["、"],["言","いう"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":9,"text":"僕,しもべが命,めいじられたことをしたからといって、主人,しゅじんは彼,かれに感謝,かんしゃするだろうか。","tok":[["僕","し"],["も"],["べ"],["が"],["命じられた","めいじられた"],["こと"],["を"],["した"],["から"],["と"],["いって"],["、"],["主人","しゅじん"],["は"],["彼","かれ"],["に"],["感謝","かんしゃ"],["するだろう"],["か"],["。"]]},{"verse":10,"text":"同様,どうようにあなたがたも、命,めいじられたことを皆,みなしてしまったとき、『わたしたちはふつつかな僕,しもべです。すべき事,ことをしたに過,すぎません』と言,いいなさい」。","tok":[["同様","どうよう"],["に"],["あなた"],["がた"],["も"],["、"],["命じられた","めいじられた"],["こと"],["を"],["皆","みな"],["して"],["しまった"],["とき"],["、"],["『"],["わたしたち"],["は"],["ふつつか"],["な"],["僕","し"],["も"],["べ"],["です"],["。"],["すべき"],["事","こと"],["を"],["した"],["に"],["過ません","すぎません"],["』"],["と"],["言い","いい"],["なさい"],["」"],["。"]]},{"verse":11,"text":"イエスはエルサレムへ行,いかれるとき、サマリヤとガリラヤとの間,あいだを通,とおられた。","tok":[["イエス"],["は"],["エルサレム"],["へ"],["行かれる","いかれる"],["とき"],["、"],["サマリヤ"],["と"],["ガリラヤ"],["と"],["の"],["間","あいだ"],["を"],["通られた","とおられた"],["。"]]},{"verse":12,"text":"そして、ある村,むらにはいられると、十人,にんのらい病人,びょうにんに出会,であわれたが、彼,かれらは遠,とおくの方,ほうで立,たちとどまり、","tok":[["そして"],["、"],["ある"],["村","むら"],["に"],["は"],["いられる"],["と"],["、"],["十人","にん"],["の"],["らい病人","らいびょうにん"],["に"],["出会われた","であわれた"],["が"],["、"],["彼","かれ"],["ら"],["は"],["遠く","とおく"],["の"],["方","ほう"],["で"],["立ち","たち"],["とどまり"],["、"]]},{"verse":13,"text":"声,こえを張,はりあげて、「イエスさま、わたしたちをあわれんでください」と言,いった。","tok":[["声","こえ"],["を"],["張りあげて","はりあげて"],["、"],["「"],["イエス"],["さま"],["、"],["わたしたち"],["を"],["あわれんで"],["ください"],["」"],["と"],["言った","いった"],["。"]]},{"verse":14,"text":"イエスは彼,かれらをごらんになって、「祭司,さいしたちのところに行,いって、からだを見,みせなさい」と言,いわれた。そして、行,いく途中,とちゅうで彼,かれらはきよめられた。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["を"],["ごらん"],["に"],["なって"],["、"],["「"],["祭司","さいし"],["たち"],["の"],["ところ"],["に"],["行って","いって"],["、"],["からだ"],["を"],["見せ","みせ"],["なさい"],["」"],["と"],["言われた","いわれた"],["。"],["そして"],["、"],["行く","いく"],["途中","とちゅう"],["で"],["彼","かれ"],["ら"],["は"],["きよめられた"],["。"]]},{"verse":15,"text":"そのうちのひとりは、自分,じぶんがいやされたことを知,しり、大声,おおごえで神,かみをほめたたえながら帰,かえってきて、","tok":[["その"],["うち"],["の"],["ひとり"],["は"],["、"],["自分","じぶん"],["が"],["いやされた"],["こと"],["を"],["知り","しり"],["、"],["大声","おおごえ"],["で"],["神","かみ"],["を"],["ほめたたえ"],["ながら"],["帰えって","かえって"],["きて"],["、"]]},{"verse":16,"text":"イエスの足,あしもとにひれ伏,ふして感謝,かんしゃした。これはサマリヤ人,びとであった。","tok":[["イエス"],["の"],["足もと","あしもと"],["に"],["ひれ伏して","ひれふして"],["感謝","かんしゃ"],["した"],["。"],["これ"],["は"],["サマリヤ"],["人","び"],["と"],["で"],["あった"],["。"]]},{"verse":17,"text":"イエスは彼,かれにむかって言,いわれた、「きよめられたのは、十人,にんではなかったか。ほかの九人,にんは、どこにいるのか。","tok":[["イエス"],["は"],["彼","かれ"],["に"],["むかって"],["言われた","いわれた"],["、"],["「"],["きよめられた"],["の"],["は"],["、"],["十人","にん"],["で"],["は"],["なかった"],["か"],["。"],["ほか"],["の"],["九人","にん"],["は"],["、"],["どこ"],["に"],["いる"],["の"],["か"],["。"]]},{"verse":18,"text":"神,かみをほめたたえるために帰,かえってきたものは、この他国,たこく人,じんのほかにはいないのか」。","tok":[["神","かみ"],["を"],["ほめたたえる"],["ため"],["に"],["帰えって","かえって"],["きた"],["もの"],["は"],["、"],["この"],["他国人","たこくじん"],["の"],["ほか"],["に"],["は"],["いない"],["の"],["か"],["」"],["。"]]},{"verse":19,"text":"それから、その人,ひとに言,いわれた、「立,たって行,いきなさい。あなたの信仰,しんこうがあなたを救,すくったのだ」。","tok":[["それ"],["から"],["、"],["その"],["人","ひと"],["に"],["言われた","いわれた"],["、"],["「"],["立って","たって"],["行き","いき"],["なさい"],["。"],["あなた"],["の"],["信仰","しんこう"],["が"],["あなた"],["を"],["救った","すくった"],["の"],["だ"],["」"],["。"]]},{"verse":20,"text":"神,かみの国,くにはいつ来,くるのかと、パリサイ人,びとが尋,たずねたので、イエスは答,こたえて言,いわれた、「神,かみの国,くには、見,みられるかたちで来,くるものではない。","tok":[["神","かみ"],["の"],["国","くに"],["は"],["いつ"],["来る","くる"],["の"],["か"],["と"],["、"],["パリサイ"],["人","び"],["と"],["が"],["尋ねた","たずねた"],["ので"],["、"],["イエス"],["は"],["答","こたえ"],["て"],["言われた","いわれた"],["、"],["「"],["神","かみ"],["の"],["国","くに"],["は"],["、"],["見られる","みられる"],["かたち"],["で"],["来る","くる"],["もの"],["で"],["は"],["ない"],["。"]]},{"verse":21,"text":"また『見,みよ、ここにある』『あそこにある』などとも言,いえない。神,かみの国,くには、実,じつにあなたがたのただ中,なかにあるのだ」。","tok":[["また"],["『"],["見よ","みよ"],["、"],["ここ"],["に"],["ある"],["』"],["『"],["あそこ"],["に"],["ある"],["』"],["など"],["と"],["も"],["言えない","いえない"],["。"],["神","かみ"],["の"],["国","くに"],["は"],["、"],["実","じつ"],["に"],["あなた"],["がた"],["の"],["ただ中","ただなか"],["に"],["ある"],["の"],["だ"],["」"],["。"]]},{"verse":22,"text":"それから弟子,でしたちに言,いわれた、「あなたがたは、人,ひとの子,この日,ひを一日,にちでも見,みたいと願,ねがっても見,みることができない時,ときが来,くるであろう。","tok":[["それ"],["から"],["弟子","でし"],["たち"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["がた"],["は"],["、"],["人","ひと"],["の"],["子","こ"],["の"],["日","ひ"],["を"],["一","いち"],["日","にち"],["で"],["も"],["見たい","みたい"],["と"],["願って","ねがって"],["も"],["見る","みる"],["こと"],["が"],["できない"],["時","とき"],["が"],["来るで","くるで"],["あろう"],["。"]]},{"verse":23,"text":"人々,ひとびとはあなたがたに、『見,みよ、あそこに』『見,みよ、ここに』と言,いうだろう。しかし、そちらへ行,いくな、彼,かれらのあとを追,おうな。","tok":[["人々","ひとびと"],["は"],["あなた"],["がた"],["に"],["、"],["『"],["見よ","みよ"],["、"],["あそこ"],["に"],["』"],["『"],["見よ","みよ"],["、"],["ここ"],["に"],["』"],["と"],["言うだろう","いうだろう"],["。"],["しかし"],["、"],["そちら"],["へ"],["行く","いく"],["な"],["、"],["彼","かれ"],["ら"],["の"],["あと"],["を"],["追う","おう"],["な"],["。"]]},{"verse":24,"text":"いなずまが天,てんの端,はしからひかり出,でて天,てんの端,はしへとひらめき渡,わたるように、人,ひとの子,こもその日,ひには同,おなじようであるだろう。","tok":[["いなずま"],["が"],["天","てん"],["の"],["端","はし"],["から"],["ひかり"],["出て","でて"],["天","てん"],["の"],["端","はし"],["へ"],["と"],["ひらめき"],["渡る","わたる"],["よう"],["に"],["、"],["人","ひと"],["の"],["子","こ"],["も"],["その"],["日","ひ"],["に"],["は"],["同じ","おなじ"],["よう"],["で"],["あるだろう"],["。"]]},{"verse":25,"text":"しかし、彼,かれはまず多,おおくの苦,くるしみを受,うけ、またこの時代,じだいの人々,ひとびとに捨,すてられねばならない。","tok":[["しかし"],["、"],["彼","かれ"],["は"],["まず"],["多く","おおく"],["の"],["苦しみ","くるしみ"],["を"],["受け","うけ"],["、"],["また"],["この"],["時代","じだい"],["の"],["人々","ひとびと"],["に"],["捨てられねば","すてられねば"],["ならない"],["。"]]},{"verse":26,"text":"そして、ノアの時,ときにあったように、人,ひとの子,この時,ときにも同様,どうようなことが起,おこるであろう。","tok":[["そして"],["、"],["ノア"],["の"],["時","とき"],["に"],["あった"],["よう"],["に"],["、"],["人","ひと"],["の"],["子","こ"],["の"],["時","とき"],["に"],["も"],["同様","どうよう"],["な"],["こと"],["が"],["起こるで","おこるで"],["あろう"],["。"]]},{"verse":27,"text":"ノアが箱舟,はこぶねにはいる日,ひまで、人々,ひとびとは食,くい、飲,のみ、めとり、とつぎなどしていたが、そこへ洪水,こうずいが襲,おそってきて、彼,かれらをことごとく滅,ほろぼした。","tok":[["ノア"],["が"],["箱舟","はこぶね"],["に"],["は"],["いる"],["日","ひ"],["まで"],["、"],["人々","ひとびと"],["は"],["食い","くい"],["、"],["飲み","のみ"],["、"],["めとり"],["、"],["と"],["つぎ"],["など"],["して"],["いた"],["が"],["、"],["そこ"],["へ"],["洪水","こうずい"],["が"],["襲って","おそって"],["きて"],["、"],["彼","かれ"],["ら"],["を"],["ことごとく"],["滅ぼした","ほろぼした"],["。"]]},{"verse":28,"text":"ロトの時,ときにも同,おなじようなことが起,おこった。人々,ひとびとは食,くい、飲,のみ、買,かい、売,うり、植,うえ、建,たてなどしていたが、","tok":[["ロト"],["の"],["時","とき"],["に"],["も"],["同じ","おなじ"],["よう"],["な"],["こと"],["が"],["起こった","おこった"],["。"],["人々","ひとびと"],["は"],["食い","くい"],["、"],["飲み","のみ"],["、"],["買","かい"],["、"],["売","うり"],["、"],["植え","うえ"],["、"],["建て","たて"],["など"],["して"],["いた"],["が"],["、"]]},{"verse":29,"text":"ロトがソドムから出,でて行,いった日,ひに、天,てんから火,ひと硫黄,いおうとが降,ふってきて、彼,かれらをことごとく滅,ほろぼした。","tok":[["ロト"],["が"],["ソドム"],["から"],["出て","でて"],["行った","いった"],["日","ひ"],["に"],["、"],["天","てん"],["から"],["火","ひ"],["と"],["硫黄","いおう"],["と"],["が"],["降って","ふって"],["きて"],["、"],["彼","かれ"],["ら"],["を"],["ことごとく"],["滅ぼした","ほろぼした"],["。"]]},{"verse":30,"text":"人,ひとの子,こが現,あらわれる日,ひも、ちょうどそれと同様,どうようであろう。","tok":[["人","ひと"],["の"],["子","こ"],["が"],["現われる","あらわれる"],["日","ひ"],["も"],["、"],["ちょうど"],["それ"],["と"],["同様","どうよう"],["で"],["あろう"],["。"]]},{"verse":31,"text":"その日,ひには、屋上,おくじょうにいる者,ものは、自分,じぶんの持,もち物,ものが家,いえの中,なかにあっても、取,とりにおりるな。畑,はたけにいる者,ものも同,おなじように、あとへもどるな。","tok":[["その"],["日","ひ"],["に"],["は"],["、"],["屋上","おくじょう"],["に"],["いる"],["者","もの"],["は"],["、"],["自分","じぶん"],["の"],["持物","もちもの"],["が"],["家","いえ"],["の"],["中","なか"],["に"],["あって"],["も"],["、"],["取","とり"],["に"],["おりる"],["な"],["。"],["畑","はたけ"],["に"],["いる"],["者","もの"],["も"],["同じ","おなじ"],["よう"],["に"],["、"],["あと"],["へ"],["もどる"],["な"],["。"]]},{"verse":32,"text":"ロトの妻,つまのことを思,おもい出,だしなさい。","tok":[["ロト"],["の"],["妻","つま"],["の"],["こと"],["を"],["思い出し","おもいだし"],["なさい"],["。"]]},{"verse":33,"text":"自分,じぶんの命,いのちを救,すくおうとするものは、それを失,うしない、それを失,うしなうものは、保,たもつのである。","tok":[["自分","じぶん"],["の"],["命","いのち"],["を"],["救おう","すくおう"],["と"],["する"],["もの"],["は"],["、"],["それ"],["を"],["失ない","うしない"],["、"],["それ"],["を"],["失なう","うしなう"],["もの"],["は"],["、"],["保つ","たもつ"],["ので"],["ある"],["。"]]},{"verse":34,"text":"あなたがたに言,いっておく。その夜,よ、ふたりの男,おとこが一つ寝床,ねどこにいるならば、ひとりは取,とり去,さられ、他,たのひとりは残,のこされるであろう。","tok":[["あなた"],["がた"],["に"],["言って","いって"],["おく"],["。"],["その"],["夜","よ"],["、"],["ふたり"],["の"],["男","おとこ"],["が"],["一","ひと"],["つ"],["寝床","ねどこ"],["に"],["いるならば"],["、"],["ひとり"],["は"],["取去られ","とりさられ"],["、"],["他","た"],["の"],["ひとり"],["は"],["残されるで","のこされるで"],["あろう"],["。"]]},{"verse":35,"text":"ふたりの女,おんなが一緒,いっしょにうすをひいているならば、ひとりは取,とり去,さられ、他,たのひとりは残,のこされるであろう。〔","tok":[["ふたり"],["の"],["女","おんな"],["が"],["一緒","いっしょ"],["に"],["うす"],["を"],["ひいて"],["いるならば"],["、"],["ひとり"],["は"],["取去られ","とりさられ"],["、"],["他","た"],["の"],["ひとり"],["は"],["残されるで","のこされるで"],["あろう"],["。"],["〔"]]},{"verse":36,"text":"ふたりの男,おとこが畑,はたけにおれば、ひとりは取,とり去,さられ、他,たのひとりは残,のこされるであろう〕」。","tok":[["ふたり"],["の"],["男","おとこ"],["が"],["畑","はたけ"],["に"],["おれば"],["、"],["ひとり"],["は"],["取去られ","とりさられ"],["、"],["他","た"],["の"],["ひとり"],["は"],["残されるで","のこされるで"],["あろう"],["〕"],["」"],["。"]]},{"verse":37,"text":"弟子,でしたちは「主,しゅよ、それはどこであるのですか」と尋,たずねた。するとイエスは言,いわれた、「死体,したいのある所,ところには、またはげたかが集,あつまるものである」。","tok":[["弟子","でし"],["たち"],["は"],["「"],["主","しゅ"],["よ"],["、"],["それ"],["は"],["どこ"],["で"],["ある"],["の"],["です"],["か"],["」"],["と"],["尋ねた","たずねた"],["。"],["する"],["と"],["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["死体","したい"],["の"],["ある"],["所","ところ"],["に"],["は"],["、"],["また"],["はげたか"],["が"],["集まる","あつまる"],["もの"],["で"],["ある"],["」"],["。"]]}]
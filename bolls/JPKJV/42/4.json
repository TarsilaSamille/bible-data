[{"verse":1,"text":"さて、イエスは聖霊,せいれいに満,みちてヨルダン川,がわから帰,かえり、","tok":[["さて"],["、"],["イエス"],["は"],["聖霊","せいれい"],["に"],["満ちて","みちて"],["ヨルダン"],["川","がわか"],["ら"],["帰えり","かえり"],["、"]]},{"verse":2,"text":"荒野,あらのを四十日,にちのあいだ御霊,みたまにひきまわされて、悪魔,あくまの試,こころみにあわれた。そのあいだ何,なにも食,たべず、その日数,ひかずがつきると、空腹,くうふくになられた。","tok":[["荒野","あら"],["の"],["を"],["四十日","にち"],["の"],["あいだ"],["御霊","みたま"],["に"],["ひきまわされて"],["、"],["悪魔","あくま"],["の"],["試み","こころみ"],["に"],["あわれた"],["。"],["その"],["あいだ"],["何に","なに"],["も"],["食べず","たべず"],["、"],["その"],["日数","ひかずがつきる"],["と"],["、"],["空腹","くうふく"],["に"],["なられた"],["。"]]},{"verse":3,"text":"そこで悪魔,あくまが言,いった、「もしあなたが神,かみの子,こであるなら、この石,いしに、パンになれと命,めいじてごらんなさい」。","tok":[["そこ"],["で"],["悪魔","あくま"],["が"],["言った","いった"],["、"],["「"],["もし"],["あなた"],["が"],["神","かみ"],["の"],["子","こ"],["で"],["あるなら"],["、"],["この"],["石","いし"],["に"],["、"],["パン"],["に"],["なれ"],["と"],["命じて","めいじて"],["ごらん"],["なさい"],["」"],["。"]]},{"verse":4,"text":"イエスは答,こたえて言,いわれた、「『人,ひとはパンだけで生,いきるものではない』と書,かいてある」。","tok":[["イエス"],["は"],["答","こたえ"],["て"],["言われた","いわれた"],["、"],["「"],["『"],["人","ひと"],["は"],["パン"],["だけ"],["で"],["生きる","いきる"],["もの"],["で"],["は"],["ない"],["』"],["と"],["書いて","かいて"],["ある"],["」"],["。"]]},{"verse":5,"text":"それから、悪魔,あくまはイエスを高,たかい所,ところへ連,つれて行,いき、またたくまに世界,せかいのすべての国々,くにぐにを見,みせて","tok":[["それ"],["から"],["、"],["悪魔","あくま"],["は"],["イエス"],["を"],["高かい","たかい"],["所","ところ"],["へ"],["連れて","つれて"],["行き","いき"],["、"],["またたく"],["ま"],["に"],["世界","せかい"],["の"],["すべて"],["の"],["国々","くにぐに"],["を"],["見せて","みせて"]]},{"verse":6,"text":"言,いった、「これらの国々,くにぐにの権威,けんいと栄華,えいがとをみんな、あなたにあげましょう。それらはわたしに任,まかせられていて、だれでも好,すきな人,ひとにあげてよいのですから。","tok":[["言った","いった"],["、"],["「"],["これ"],["ら"],["の"],["国々","くにぐに"],["の"],["権威","けんい"],["と"],["栄華","えいが"],["と"],["を"],["みんな"],["、"],["あなた"],["に"],["あげましょう"],["。"],["それ"],["ら"],["は"],["わたし"],["に"],["任せられて","まかせられて"],["いて"],["、"],["だれ"],["で"],["も"],["好き","すき"],["な"],["人","ひと"],["に"],["あげて"],["よい"],["の"],["です"],["から"],["。"]]},{"verse":7,"text":"それで、もしあなたがわたしの前,まえにひざまずくなら、これを全部,ぜんぶあなたのものにしてあげましょう」。","tok":[["それ"],["で"],["、"],["もし"],["あなた"],["が"],["わたし"],["の"],["前","まえ"],["に"],["ひざまずくなら"],["、"],["これ"],["を"],["全部","ぜんぶ"],["あなた"],["の"],["もの"],["に"],["して"],["あげましょう"],["」"],["。"]]},{"verse":8,"text":"イエスは答,こたえて言,いわれた、「『主,しゅなるあなたの神,かみを拝,はいし、ただ神,かみにのみ仕,つかえよ』と書,かいてある」。","tok":[["イエス"],["は"],["答","こたえ"],["て"],["言われた","いわれた"],["、"],["「"],["『"],["主","しゅ"],["なる"],["あなた"],["の"],["神","かみ"],["を"],["拝し","はいし"],["、"],["ただ"],["神","かみ"],["に"],["のみ"],["仕え","つかえ"],["よ"],["』"],["と"],["書いて","かいて"],["ある"],["」"],["。"]]},{"verse":9,"text":"それから悪魔,あくまはイエスをエルサレムに連,つれて行,いき、宮,みやの頂上,ちょうじょうに立,たたせて言,いった、「もしあなたが神,かみの子,こであるなら、ここから下,したへ飛,とびおりてごらんなさい。","tok":[["それ"],["から"],["悪魔","あくま"],["は"],["イエス"],["を"],["エルサレム"],["に"],["連れて","つれて"],["行き","いき"],["、"],["宮","みや"],["の"],["頂上","ちょうじょう"],["に"],["立たせて","たたせて"],["言った","いった"],["、"],["「"],["もし"],["あなた"],["が"],["神","かみ"],["の"],["子","こ"],["で"],["あるなら"],["、"],["ここ"],["から"],["下","した"],["へ"],["飛びおりて","とびおりて"],["ごらん"],["なさい"],["。"]]},{"verse":10,"text":"『神,かみはあなたのために、御使,みつかいたちに命,めいじてあなたを守,まもらせるであろう』とあり、","tok":[["『"],["神","かみ"],["は"],["あなた"],["の"],["ため"],["に"],["、"],["御使","みつかいたち"],["に"],["命じて","めいじて"],["あなた"],["を"],["守らせるで","まもらせるで"],["あろう"],["』"],["と"],["あり"],["、"]]},{"verse":11,"text":"また、『あなたの足,あしが石,いしに打,うちつけられないように、彼,かれらはあなたを手,てでささえるであろう』とも書,かいてあります」。","tok":[["また"],["、"],["『"],["あなた"],["の"],["足","あし"],["が"],["石","いし"],["に"],["打ちつけられない","うちつけられない"],["よう"],["に"],["、"],["彼","かれ"],["ら"],["は"],["あなた"],["を"],["手","て"],["で"],["ささえるで"],["あろう"],["』"],["と"],["も"],["書いて","かいて"],["あります"],["」"],["。"]]},{"verse":12,"text":"イエスは答,こたえて言,いわれた、「『主,しゅなるあなたの神,かみを試,こころみてはならない』と言,いわれている」。","tok":[["イエス"],["は"],["答","こたえ"],["て"],["言われた","いわれた"],["、"],["「"],["『"],["主","しゅ"],["なる"],["あなた"],["の"],["神","かみ"],["を"],["試みて","こころみて"],["は"],["ならない"],["』"],["と"],["言われて","いわれて"],["いる"],["」"],["。"]]},{"verse":13,"text":"悪魔,あくまはあらゆる試,こころみをしつくして、一時,いちじイエスを離,はなれた。","tok":[["悪魔","あくま"],["は"],["あらゆる"],["試み","こころみ"],["を"],["し"],["つくして"],["、"],["一時","いちじ"],["イエス"],["を"],["離れた","はなれた"],["。"]]},{"verse":14,"text":"それからイエスは御霊,みたまの力,ちからに満,みちあふれてガリラヤへ帰,かえられると、そのうわさがその地方,ちほう全体,ぜんたいにひろまった。","tok":[["それ"],["から"],["イエス"],["は"],["御霊","みたま"],["の"],["力","ちから"],["に"],["満ちあふれて","みちあふれて"],["ガリラヤ"],["へ"],["帰えられる","かえられる"],["と"],["、"],["その"],["うわさ"],["が"],["その"],["地方","ちほう"],["全体","ぜんたい"],["に"],["ひろまった"],["。"]]},{"verse":15,"text":"イエスは諸,しょ会堂,かいどうで教,おしえ、みんなの者,ものから尊敬,そんけいをお受,うけになった。","tok":[["イエス"],["は"],["諸","しょ"],["会堂","かいどう"],["で"],["教え","おしえ"],["、"],["みんな"],["の"],["者","もの"],["から"],["尊敬","そんけい"],["を"],["お受け","おうけ"],["に"],["なった"],["。"]]},{"verse":16,"text":"それからお育,そだちになったナザレに行,いき、安息日,あんそくにちにいつものように会堂,かいどうにはいり、聖書,せいしょを朗読,ろうどくしようとして立,たたれた。","tok":[["それ"],["から"],["お育ち","おそだち"],["に"],["なった"],["ナザレ"],["に"],["行き","いき"],["、"],["安息日","あんそくにち"],["に"],["いつも"],["の"],["よう"],["に"],["会堂","かいどう"],["に"],["はいり"],["、"],["聖書","せいしょ"],["を"],["朗読","ろうどく"],["しよう"],["として"],["立たれた","たたれた"],["。"]]},{"verse":17,"text":"すると預言者,よげんしゃイザヤの書,しょが手渡,てわたされたので、その書,しょを開,ひらいて、こう書,かいてある所,ところを出,だされた、","tok":[["する"],["と"],["預言者","よげんしゃ"],["イザヤ"],["の"],["書","しょ"],["が"],["手渡された","てわたされた"],["ので"],["、"],["その"],["書","しょ"],["を"],["開らいて","ひらいて"],["、"],["こう"],["書いて","かいて"],["ある"],["所","ところ"],["を"],["出された","だされた"],["、"]]},{"verse":18,"text":"「主,しゅの御霊,みたまがわたしに宿,やどっている。貧,まずしい人々,ひとびとに福音,ふくいんを宣,のべ伝,つたえさせるために、わたしを聖,せい別,べつしてくださったからである。主,しゅはわたしをつかわして、囚人,しゅうじんが解放,かいほうされ、盲人,もうじんの目,めが開,ひらかれることを告,つげ知,しらせ、打,うちひしがれている者,ものに自由,じゆうを得,えさせ、","tok":[["「"],["主","しゅ"],["の"],["御霊","みたまがわたし"],["に"],["宿って","やどって"],["いる"],["。"],["貧しい","まずしい"],["人々","ひとびと"],["に"],["福音","ふくいん"],["を"],["宣べ伝えさせる","のべつたえさせる"],["ため"],["に"],["、"],["わたし"],["を"],["聖別","せいべつ"],["して"],["くださった"],["から"],["で"],["ある"],["。"],["主","しゅ"],["は"],["わたし"],["を"],["つかわして"],["、"],["囚人","しゅうじん"],["が"],["解放","かいほう"],["され"],["、"],["盲人","もうじん"],["の"],["目","め"],["が"],["開らかれる","ひらかれる"],["こと"],["を"],["告","つげ"],["知らせ","しらせ"],["、"],["打ちひしがれて","うちひしがれて"],["いる"],["者","もの"],["に"],["自由","じゆう"],["を"],["得させ","えさせ"],["、"]]},{"verse":19,"text":"主,しゅのめぐみの年,としを告,つげ知,しらせるのである」。","tok":[["主","しゅ"],["の"],["めぐみ"],["の"],["年","とし"],["を"],["告","つげ"],["知らせる","しらせる"],["ので"],["ある"],["」"],["。"]]},{"verse":20,"text":"イエスは聖書,せいしょを巻,まいて係,かかりの者,ものに返,かえし、席,せきに着,つかれると、会堂,かいどうにいるみんなの者,ものの目,めがイエスに注,そそがれた。","tok":[["イエス"],["は"],["聖書","せいしょ"],["を"],["巻いて","まいて"],["係","かかり"],["の"],["者","もの"],["に"],["返","かえし"],["、"],["席","せき"],["に"],["着かれる","つかれる"],["と"],["、"],["会堂","かいどう"],["に"],["いる"],["みんな"],["の"],["者","もの"],["の"],["目","め"],["が"],["イエス"],["に"],["注がれた","そそがれた"],["。"]]},{"verse":21,"text":"そこでイエスは、「この聖,せい句,くは、あなたがたが耳,みみにしたこの日,ひに成就,じょうじゅした」と説,ときはじめられた。","tok":[["そこ"],["で"],["イエス"],["は"],["、"],["「"],["この"],["聖句","せいく"],["は"],["、"],["あなた"],["がた"],["が"],["耳","みみ"],["に"],["した"],["この"],["日","ひ"],["に"],["成就","じょうじゅ"],["した"],["」"],["と"],["説き","とき"],["はじめられた"],["。"]]},{"verse":22,"text":"すると、彼,かれらはみなイエスをほめ、またその口,くちから出,でて来,くるめぐみの言葉,ことばに感嘆,かんたんして言,いった、「この人,ひとはヨセフの子,こではないか」。","tok":[["する"],["と"],["、"],["彼","かれ"],["ら"],["は"],["みな"],["イエス"],["を"],["ほめ"],["、"],["また"],["その"],["口","くち"],["から"],["出て","でて"],["来る","くる"],["めぐみ"],["の"],["言葉","ことば"],["に"],["感嘆","かんたん"],["して"],["言った","いった"],["、"],["「"],["この"],["人","ひと"],["は"],["ヨセフ"],["の"],["子","こ"],["で"],["は"],["ない"],["か"],["」"],["。"]]},{"verse":23,"text":"そこで彼,かれらに言,いわれた、「あなたがたは、きっと『医者,いしゃよ、自分,じぶん自身,じしんをいやせ』ということわざを引,ひいて、カペナウムで行,おこなわれたと聞,きいていた事,ことを、あなたの郷里,きょうりのこの地,ちでもしてくれ、と言,いうであろう」。","tok":[["そこ"],["で"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["がた"],["は"],["、"],["きっと"],["『"],["医者","いしゃ"],["よ"],["、"],["自分","じぶん"],["自身","じしん"],["を"],["いやせ"],["』"],["と"],["いう"],["ことわざ"],["を"],["引いて","ひいて"],["、"],["カペナウム"],["で"],["行なわれた","おこなわれた"],["と"],["聞いて","きいて"],["いた"],["事","こと"],["を"],["、"],["あなた"],["の"],["郷里","きょうり"],["の"],["この"],["地","ち"],["で"],["も"],["して"],["くれ"],["、"],["と"],["言うで","いうで"],["あろう"],["」"],["。"]]},{"verse":24,"text":"それから言,いわれた、「よく言,いっておく。預言者,よげんしゃは、自分,じぶんの郷里,きょうりでは歓迎,かんげいされないものである。","tok":[["それ"],["から"],["言われた","いわれた"],["、"],["「"],["よく"],["言って","いって"],["おく"],["。"],["預言者","よげんしゃ"],["は"],["、"],["自分","じぶん"],["の"],["郷里","きょうり"],["で"],["は"],["歓迎","かんげい"],["されない"],["もの"],["で"],["ある"],["。"]]},{"verse":25,"text":"よく聞,きいておきなさい。エリヤの時代,じだいに、三年,ねん六か月,げつにわたって天,てんが閉,とじ、イスラエル全土,ぜんどに大,だいききんがあった際,さい、そこには多,おおくのやもめがいたのに、","tok":[["よく"],["聞いて","きいて"],["おき"],["なさい"],["。"],["エリヤ"],["の"],["時代","じだい"],["に"],["、"],["三","さん"],["年","ねん"],["六","ろく"],["か月","かげつ"],["に"],["わたって"],["天","てん"],["が"],["閉じ","とじ"],["、"],["イスラエル"],["全土","ぜんど"],["に"],["大","だい"],["ききん"],["が"],["あった"],["際","さい"],["、"],["そこ"],["に"],["は"],["多く","おおく"],["の"],["やもめ"],["が"],["いた"],["のに"],["、"]]},{"verse":26,"text":"エリヤはそのうちのだれにもつかわされないで、ただシドンのサレプタにいるひとりのやもめにだけつかわされた。","tok":[["エリヤ"],["は"],["その"],["うち"],["の"],["だれ"],["に"],["も"],["つかわされないで"],["、"],["ただ"],["シドン"],["の"],["サレプタ"],["に"],["いる"],["ひとり"],["の"],["やもめ"],["に"],["だけ"],["つかわされた"],["。"]]},{"verse":27,"text":"また預言者,よげんしゃエリシャの時代,じだいに、イスラエルには多,おおくのらい病人,びょうにんがいたのに、そのうちのひとりもきよめられないで、ただシリヤのナアマンだけがきよめられた」。","tok":[["また"],["預言者","よげんしゃ"],["エリシャ"],["の"],["時代","じだい"],["に"],["、"],["イスラエル"],["に"],["は"],["多く","おおく"],["の"],["らい病人","らいびょうにん"],["が"],["いた"],["のに"],["、"],["その"],["うち"],["の"],["ひとり"],["も"],["きよめられないで"],["、"],["ただ"],["シリヤ"],["の"],["ナアマン"],["だけ"],["が"],["きよめられた"],["」"],["。"]]},{"verse":28,"text":"会堂,かいどうにいた者,ものたちはこれを聞,きいて、みな憤,いきどおりに満,みち、","tok":[["会堂","かいどう"],["に"],["いた"],["者","もの"],["たち"],["は"],["これ"],["を"],["聞いて","きいて"],["、"],["みな"],["憤り","いきどおり"],["に"],["満ち","みち"],["、"]]},{"verse":29,"text":"立,たち上,あがってイエスを町,まちの外,そとへ追,おい出,だし、その町,まちが建,たっている丘,おかのがけまでひっぱって行,いって、突,つき落,おとそうとした。","tok":[["立ち上がって","たちあがって"],["イエス"],["を"],["町","まち"],["の"],["外","そと"],["へ"],["追い出し","おいだし"],["、"],["その"],["町","まち"],["が"],["建って","たって"],["いる"],["丘","おか"],["の"],["がけ"],["まで"],["ひっぱって"],["行って","いって"],["、"],["突き落とそう","つきおとそう"],["と"],["した"],["。"]]},{"verse":30,"text":"しかし、イエスは彼,かれらのまん中,なかを通,とおり抜,ぬけて、去,さって行,いかれた。","tok":[["しかし"],["、"],["イエス"],["は"],["彼","かれ"],["ら"],["の"],["まん中","まんなか"],["を"],["通り","とおり"],["抜て","ぬけて"],["、"],["去て","さって"],["行かれた","いかれた"],["。"]]},{"verse":31,"text":"それから、イエスはガリラヤの町,まちカペナウムに下,くだって行,いかれた。そして安息日,あんそくにちになると、人々,ひとびとをお教,おしえになったが、","tok":[["それ"],["から"],["、"],["イエス"],["は"],["ガリラヤ"],["の"],["町","まち"],["カペナウム"],["に"],["下って","くだって"],["行かれた","いかれた"],["。"],["そして"],["安息日","あんそくにち"],["に"],["なる"],["と"],["、"],["人々","ひとびと"],["を"],["お教え","おおしえ"],["に"],["なった"],["が"],["、"]]},{"verse":32,"text":"その言葉,ことばに権威,けんいがあったので、彼,かれらはその教,おしえに驚,おどろいた。","tok":[["その"],["言葉","ことば"],["に"],["権威","けんい"],["が"],["あった"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["その"],["教え","おしえ"],["に"],["驚ろいた","おどろいた"],["。"]]},{"verse":33,"text":"すると、汚,けがれた悪霊,あくれいにつかれた人,ひとが会堂,かいどうにいて、大声,おおごえで叫,さけび出,だした、","tok":[["する"],["と"],["、"],["汚","け"],["がれ"],["た"],["悪霊","あくれい"],["に"],["つかれた"],["人","ひと"],["が"],["会堂","かいどう"],["に"],["いて"],["、"],["大声","おおごえ"],["で"],["叫","さけび"],["出した","だした"],["、"]]},{"verse":34,"text":"「ああ、ナザレのイエスよ、あなたはわたしたちとなんの係,かかわりがあるのです。わたしたちを滅,ほろぼしにこられたのですか。あなたがどなたであるか、わかっています。神,かみの聖者,せいじゃです」。","tok":[["「"],["ああ"],["、"],["ナザレ"],["の"],["イエス"],["よ"],["、"],["あなた"],["は"],["わたしたち"],["と"],["なん"],["の"],["係わり","かかわり"],["が"],["ある"],["の"],["です"],["。"],["わたしたち"],["を"],["滅ぼし","ほろぼし"],["に"],["こられた"],["の"],["です"],["か"],["。"],["あなた"],["が"],["どなた"],["で"],["ある"],["か"],["、"],["わかって"],["います"],["。"],["神","かみ"],["の"],["聖者","せいじゃ"],["です"],["」"],["。"]]},{"verse":35,"text":"イエスはこれをしかって、「黙,だまれ、この人,ひとから出,でて行,いけ」と言,いわれた。すると悪霊,あくれいは彼,かれを人,ひとなかに投,なげ倒,たおし、傷,きずは負,おわせずに、その人,ひとから出,でて行,いった。","tok":[["イエス"],["は"],["これ"],["を"],["しかって"],["、"],["「"],["黙れ","だまれ"],["、"],["この"],["人","ひと"],["から"],["出て","でて"],["行け","いけ"],["」"],["と"],["言われた","いわれた"],["。"],["する"],["と"],["悪霊","あくれい"],["は"],["彼","かれ"],["を"],["人","ひと"],["なか"],["に"],["投","なげ"],["倒し","たおし"],["、"],["傷","きず"],["は"],["負わせず","おわせず"],["に"],["、"],["その"],["人","ひと"],["から"],["出て","でて"],["行った","いった"],["。"]]},{"verse":36,"text":"みんなの者,ものは驚,おどろいて、互,たがいに語,かたり合,あって言,いった、「これは、いったい、なんという言葉,ことばだろう。権威,けんいと力,ちからとをもって汚,けがれた霊,れいに命,めいじられると、彼,かれらは出,でて行,いくのだ」。","tok":[["みんな"],["の"],["者","もの"],["は"],["驚ろいて","おどろいて"],["、"],["互","たがい"],["に"],["語り合って","かたりあって"],["言った","いった"],["、"],["「"],["これ"],["は"],["、"],["いったい"],["、"],["なん"],["と"],["いう"],["言葉","ことば"],["だろう"],["。"],["権威","けんい"],["と"],["力","ちから"],["と"],["を"],["もって"],["汚","け"],["がれ"],["た"],["霊","れい"],["に"],["命じられる","めいじられる"],["と"],["、"],["彼","かれ"],["ら"],["は"],["出て","でて"],["行く","いく"],["の"],["だ"],["」"],["。"]]},{"verse":37,"text":"こうしてイエスの評判,ひょうばんが、その地方,ちほうのいたる所,ところにひろまっていった。","tok":[["こう"],["して"],["イエス"],["の"],["評判","ひょうばん"],["が"],["、"],["その"],["地方","ちほう"],["の"],["いたる所","いたるところ"],["に"],["ひろまって"],["いった"],["。"]]},{"verse":38,"text":"イエスは会堂,かいどうを出,でてシモンの家,いえにおはいりになった。ところがシモンのしゅうとめが高,たかい熱,ねつを病,やんでいたので、人々,ひとびとは彼女,かのじょのためにイエスにお願,ねがいした。","tok":[["イエス"],["は"],["会堂","かいどう"],["を"],["出て","でて"],["シモン"],["の"],["家","いえ"],["に"],["おはいり"],["に"],["なった"],["。"],["ところ"],["が"],["シモン"],["の"],["しゅうとめ"],["が"],["高かい","たかい"],["熱","ねつ"],["を"],["病","やんでいた"],["ので"],["、"],["人々","ひとびと"],["は"],["彼女","かのじょ"],["の"],["ため"],["に"],["イエス"],["に"],["お願い","おねがい"],["した"],["。"]]},{"verse":39,"text":"そこで、イエスはそのまくらもとに立,たって、熱,ねつが引,ひくように命,めいじられると、熱,ねつは引,ひき、女,おんなはすぐに起,おき上,あがって、彼,かれらをもてなした。","tok":[["そこ"],["で"],["、"],["イエス"],["は"],["その"],["まくらもと"],["に"],["立って","たって"],["、"],["熱","ねつ"],["が"],["引く","ひく"],["よう"],["に"],["命じられる","めいじられる"],["と"],["、"],["熱","ねつ"],["は"],["引","ひき"],["、"],["女","おんな"],["は"],["すぐ"],["に"],["起き上がって","おきあがって"],["、"],["彼","かれ"],["ら"],["を"],["もてなした"],["。"]]},{"verse":40,"text":"日,ひが暮,くれると、いろいろな病気,びょうきになやむ者,ものをかかえている人々,ひとびとが、皆,みなそれをイエスのところに連,つれてきたので、そのひとりびとりに手,てを置,おいて、おいやしになった。","tok":[["日","ひ"],["が"],["暮","くれ"],["る"],["と"],["、"],["いろいろ"],["な"],["病気","びょうき"],["に"],["なやむ"],["者","もの"],["を"],["かかえて"],["いる"],["人々","ひとびと"],["が"],["、"],["皆","みな"],["それ"],["を"],["イエス"],["の"],["ところ"],["に"],["連れて","つれて"],["きた"],["ので"],["、"],["その"],["ひとりびとり"],["に"],["手","て"],["を"],["置いて","おいて"],["、"],["おいやし"],["に"],["なった"],["。"]]},{"verse":41,"text":"悪霊,あくれいも「あなたこそ神,かみの子,こです」と叫,さけびながら多,おおくの人々,ひとびとから出,でていった。しかし、イエスは彼,かれらを戒,いましめて、物,ものを言,いうことをお許,ゆるしにならなかった。彼,かれらがイエスはキリストだと知,しっていたからである。","tok":[["悪霊","あくれい"],["も"],["「"],["あなた"],["こそ"],["神","かみ"],["の"],["子","こ"],["です"],["」"],["と"],["叫","さけび"],["ながら"],["多く","おおく"],["の"],["人々","ひとびと"],["から"],["出て","でて"],["いった"],["。"],["しかし"],["、"],["イエス"],["は"],["彼","かれ"],["ら"],["を"],["戒しめ","いましめ"],["て"],["、"],["物","もの"],["を"],["言う","いう"],["こと"],["を"],["お許し","おゆるし"],["に"],["ならなかった"],["。"],["彼","かれ"],["ら"],["が"],["イエス"],["は"],["キリスト"],["だ"],["と"],["知って","しって"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":42,"text":"夜,よが明,あけると、イエスは寂,さびしい所,ところへ出,でて行,いかれたが、群衆,ぐんしゅうが捜,さがしまわって、みもとに集,あつまり、自分,じぶんたちから離,はなれて行,いかれないようにと、引,ひき止,とめた。","tok":[["夜","よ"],["が"],["明ける","あける"],["と"],["、"],["イエス"],["は"],["寂しい","さびしい"],["所","ところ"],["へ"],["出て","でて"],["行かれた","いかれた"],["が"],["、"],["群衆","ぐんしゅう"],["が"],["捜しまわって","さがしまわって"],["、"],["みもと"],["に"],["集まり","あつまり"],["、"],["自分","じぶん"],["たち"],["から"],["離れて","はなれて"],["行かれない","いかれない"],["よう"],["に"],["と"],["、"],["引","ひき"],["止","とめ"],["た"],["。"]]},{"verse":43,"text":"しかしイエスは、「わたしは、ほかの町々,まちまちにも神,かみの国,くにの福音,ふくいんを宣,のべ伝,つたえねばならない。自分,じぶんはそのためにつかわされたのである」と言,いわれた。","tok":[["しかし"],["イエス"],["は"],["、"],["「"],["わたし"],["は"],["、"],["ほか"],["の"],["町々","まちまち"],["に"],["も"],["神","かみ"],["の"],["国","くに"],["の"],["福音","ふくいん"],["を"],["宣べ伝えねば","のべつたえねば"],["ならない"],["。"],["自分","じぶん"],["は"],["その"],["ため"],["に"],["つかわされた"],["ので"],["ある"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":44,"text":"そして、ユダヤの諸,しょ会堂,かいどうで教,おしえを説,とかれた。","tok":[["そして"],["、"],["ユダヤ"],["の"],["諸","しょ"],["会堂","かいどう"],["で"],["教え","おしえ"],["を"],["説かれた","とかれた"],["。"]]}]
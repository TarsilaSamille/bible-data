[{"verse":1,"text":"その後,のち、主,しゅは別,べつに七十二人,にんを選,えらび、行,いこうとしておられたすべての町,まちや村,むらへ、ふたりずつ先,さきにおつかわしになった。","tok":[["その後","そのの"],["ち"],["、"],["主","しゅ"],["は"],["別","べつ"],["に"],["七十二人","にん"],["を"],["選ら","えら"],["び"],["、"],["行こう","いこう"],["として"],["おられた"],["すべて"],["の"],["町","まち"],["や"],["村","むら"],["へ"],["、"],["ふたり"],["ずつ"],["先","さき"],["に"],["おつかわし"],["に"],["なった"],["。"]]},{"verse":2,"text":"そのとき、彼,かれらに言,いわれた、「収穫,しゅうかくは多,おおいが、働,はたらき人,びとが少,すくない。だから、収穫,しゅうかくの主,しゅに願,ねがって、その収穫,しゅうかくのために働,はたらき人,びとを送,おくり出,だすようにしてもらいなさい。","tok":[["その"],["とき"],["、"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["収穫","しゅうかく"],["は"],["多い","おおい"],["が"],["、"],["働らき人","はたらきび"],["と"],["が"],["少い","すくない"],["。"],["だ"],["から"],["、"],["収穫","しゅうかく"],["の"],["主","しゅ"],["に"],["願って","ねがって"],["、"],["その"],["収穫","しゅうかく"],["の"],["ため"],["に"],["働らき人","はたらきびと"],["を"],["送り出す","おくりだす"],["よう"],["に"],["して"],["もらい"],["なさい"],["。"]]},{"verse":3,"text":"さあ、行,いきなさい。わたしがあなたがたをつかわすのは、小羊,こひつじをおおかみの中,なかに送,おくるようなものである。","tok":[["さあ"],["、"],["行き","いき"],["なさい"],["。"],["わたし"],["が"],["あなた"],["がた"],["を"],["つかわす"],["の"],["は"],["、"],["小羊","こひつじ"],["を"],["おおかみ"],["の"],["中","なか"],["に"],["送る","おくる"],["よう"],["な"],["もの"],["で"],["ある"],["。"]]},{"verse":4,"text":"財布,さいふも袋,ふくろもくつも持,もって行,いくな。だれにも道,みちであいさつするな。","tok":[["財布","さいふ"],["も"],["袋","ふくろ"],["も"],["くつ"],["も"],["持って","もって"],["行く","いく"],["な"],["。"],["だれ"],["に"],["も"],["道","みち"],["で"],["あいさつ"],["する"],["な"],["。"]]},{"verse":5,"text":"どこかの家,いえにはいったら、まず『平安,へいあんがこの家,いえにあるように』と言,いいなさい。","tok":[["どこ"],["か"],["の"],["家","いえ"],["に"],["はいったら"],["、"],["まず"],["『"],["平安","へいあん"],["が"],["この"],["家","いえ"],["に"],["ある"],["よう"],["に"],["』"],["と"],["言い","いい"],["なさい"],["。"]]},{"verse":6,"text":"もし平安,へいあんの子,こがそこにおれば、あなたがたの祈,いのる平安,へいあんはその人,ひとの上,うえにとどまるであろう。もしそうでなかったら、それはあなたがたの上,うえに帰,かえって来,くるであろう。","tok":[["もし"],["平安","へいあん"],["の"],["子","こ"],["が"],["そこ"],["に"],["おれば"],["、"],["あなた"],["がた"],["の"],["祈る","いのる"],["平安","へいあん"],["は"],["その"],["人","ひと"],["の"],["上","うえ"],["に"],["とどまるで"],["あろう"],["。"],["もし"],["そう"],["で"],["なかったら"],["、"],["それ"],["は"],["あなた"],["がた"],["の"],["上","うえ"],["に"],["帰えって","かえって"],["来るで","くるで"],["あろう"],["。"]]},{"verse":7,"text":"それで、その同,おなじ家,いえに留,とどまっていて、家,いえの人,ひとが出,だしてくれるものを飲,のみ食,くいしなさい。働,はたらき人,びとがその報,むくいを得,えるのは当然,とうぜんである。家,いえから家,いえへと渡,わたり歩,あるくな。","tok":[["それ"],["で"],["、"],["その"],["同じ","おなじ"],["家","いえ"],["に"],["留","と"],["ど"],["まって"],["いて"],["、"],["家","いえ"],["の"],["人","ひと"],["が"],["出して","だして"],["くれる"],["もの"],["を"],["飲み食い","のみくい"],["し"],["なさい"],["。"],["働らき人","はたらきびとがそ"],["の"],["報い","むくい"],["を"],["得る","える"],["の"],["は"],["当然","とうぜん"],["で"],["ある"],["。"],["家","いえ"],["から"],["家","いえ"],["へ"],["と"],["渡り歩く","わたりあるく"],["な"],["。"]]},{"verse":8,"text":"どの町,まちへはいっても、人々,ひとびとがあなたがたを迎,むかえてくれるなら、前,まえに出,だされるものを食,たべなさい。","tok":[["どの"],["町","まち"],["へ"],["はいって"],["も"],["、"],["人々","ひとびと"],["が"],["あなた"],["がた"],["を"],["迎","むかえ"],["て"],["くれるなら"],["、"],["前","まえ"],["に"],["出される","だされる"],["もの"],["を"],["食べ","たべ"],["なさい"],["。"]]},{"verse":9,"text":"そして、その町,まちにいる病人,びょうにんをいやしてやり、『神,かみの国,くにはあなたがたに近,ちかづいた』と言,いいなさい。","tok":[["そして"],["、"],["その"],["町","まち"],["に"],["いる"],["病人","びょうにん"],["を"],["いやして"],["やり"],["、"],["『"],["神","かみ"],["の"],["国","くに"],["は"],["あなた"],["がた"],["に"],["近づいた","ちかづいた"],["』"],["と"],["言い","いい"],["なさい"],["。"]]},{"verse":10,"text":"しかし、どの町,まちへはいっても、人々,ひとびとがあなたがたを迎,むかえない場合,ばあいには、大通,おおどおりに出,でて行,いって言,いいなさい、","tok":[["しかし"],["、"],["どの"],["町","まち"],["へ"],["はいって"],["も"],["、"],["人々","ひとびと"],["が"],["あなた"],["がた"],["を"],["迎","むかえ"],["ない"],["場合","ばあい"],["に"],["は"],["、"],["大通り","おおどおり"],["に"],["出て","でて"],["行って","いって"],["言い","いい"],["なさい"],["、"]]},{"verse":11,"text":"『わたしたちの足,あしについているこの町,まちのちりも、ぬぐい捨,すてて行,いく。しかし、神,かみの国,くにが近,ちかづいたことは、承知,しょうちしているがよい』。","tok":[["『"],["わたしたち"],["の"],["足","あし"],["について"],["いる"],["この"],["町","まち"],["の"],["ちり"],["も"],["、"],["ぬぐい"],["捨てて","すてて"],["行く","いく"],["。"],["しかし"],["、"],["神","かみ"],["の"],["国","くに"],["が"],["近づいた","ちかづいた"],["こと"],["は"],["、"],["承知","しょうち"],["して"],["いる"],["が"],["よい"],["』"],["。"]]},{"verse":12,"text":"あなたがたに言,いっておく。その日,ひには、この町,まちよりもソドムの方,ほうが耐,たえやすいであろう。","tok":[["あなた"],["がた"],["に"],["言って","いって"],["おく"],["。"],["その"],["日","ひ"],["に"],["は"],["、"],["この"],["町","まち"],["より"],["も"],["ソドム"],["の"],["方","ほう"],["が"],["耐え","たえ"],["やすい"],["で"],["あろう"],["。"]]},{"verse":13,"text":"わざわいだ、コラジンよ。わざわいだ、ベツサイダよ。おまえたちの中,なかでなされた力,ちからあるわざが、もしツロとシドンでなされたなら、彼,かれらはとうの昔,むかしに、荒布,あらぬのをまとい灰,はいの中,なかにすわって、悔,くい改,あらためたであろう。","tok":[["わざわい"],["だ"],["、"],["コラジン"],["よ"],["。"],["わざわい"],["だ"],["、"],["ベツサイダ"],["よ"],["。"],["おまえ"],["たち"],["の"],["中","なか"],["で"],["なされた"],["力","ちから"],["ある"],["わざ"],["が"],["、"],["もし"],["ツロ"],["と"],["シドン"],["で"],["なされたなら"],["、"],["彼","かれ"],["ら"],["は"],["とう"],["の"],["昔","むかし"],["に"],["、"],["荒布","あらぬ"],["の"],["を"],["まとい"],["灰","はい"],["の"],["中","なか"],["に"],["すわって"],["、"],["悔い","くい"],["改","あらため"],["たで"],["あろう"],["。"]]},{"verse":14,"text":"しかし、さばきの日,ひには、ツロとシドンの方,ほうがおまえたちよりも、耐,たえやすいであろう。","tok":[["しかし"],["、"],["さばき"],["の"],["日","ひ"],["に"],["は"],["、"],["ツロ"],["と"],["シドン"],["の"],["方","ほう"],["が"],["おまえ"],["たち"],["より"],["も"],["、"],["耐え","たえ"],["やすい"],["で"],["あろう"],["。"]]},{"verse":15,"text":"ああ、カペナウムよ、おまえは天,てんにまで上,あげられようとでもいうのか。黄泉,よみにまで落,おとされるであろう。","tok":[["ああ"],["、"],["カペナウム"],["よ"],["、"],["おまえ"],["は"],["天","てん"],["に"],["まで"],["上げられよう","あげられよう"],["と"],["で"],["も"],["いう"],["の"],["か"],["。"],["黄泉","よみ"],["に"],["まで"],["落とされるで","おとされるで"],["あろう"],["。"]]},{"verse":16,"text":"あなたがたに聞,きき従,したがう者,ものは、わたしに聞,きき従,したがうのであり、あなたがたを拒,こばむ者,ものは、わたしを拒,こばむのである。そしてわたしを拒,こばむ者,ものは、わたしをおつかわしになったかたを拒,こばむのである」。","tok":[["あなた"],["がた"],["に"],["聞","きき"],["従う","したがう"],["者","もの"],["は"],["、"],["わたし"],["に"],["聞","きき"],["従う","したがう"],["ので"],["あり"],["、"],["あなた"],["がた"],["を"],["拒む","こばむ"],["者","もの"],["は"],["、"],["わたし"],["を"],["拒む","こばむ"],["ので"],["ある"],["。"],["そして"],["わたし"],["を"],["拒む","こばむ"],["者","もの"],["は"],["、"],["わたし"],["を"],["おつかわし"],["に"],["なった"],["かた"],["を"],["拒む","こばむ"],["ので"],["ある"],["」"],["。"]]},{"verse":17,"text":"七十二人,にんが喜,よろこんで帰,かえってきて言,いった、「主,しゅよ、あなたの名,なによっていたしますと、悪霊,あくれいまでがわたしたちに服従,ふくじゅうします」。","tok":[["七十二人","にん"],["が"],["喜こんで","よろこんで"],["帰えって","かえって"],["きて"],["言った","いった"],["、"],["「"],["主","しゅ"],["よ"],["、"],["あなた"],["の"],["名","な"],["によって"],["いたします"],["と"],["、"],["悪霊","あくれい"],["まで"],["が"],["わたしたち"],["に"],["服従","ふくじゅう"],["します"],["」"],["。"]]},{"verse":18,"text":"彼,かれらに言,いわれた、「わたしはサタンが電光,でんこうのように天,てんから落,おちるのを見,みた。","tok":[["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["わたし"],["は"],["サタン"],["が"],["電光","でんこう"],["の"],["よう"],["に"],["天","てん"],["から"],["落","おち"],["る"],["の"],["を"],["見た","みた"],["。"]]},{"verse":19,"text":"わたしはあなたがたに、へびやさそりを踏,ふみつけ、敵,てきのあらゆる力,ちからに打,うち勝,かつ権威,けんいを授,さづけた。だから、あなたがたに害,がいをおよぼす者,ものはまったく無,ないであろう。","tok":[["わたし"],["は"],["あなた"],["がた"],["に"],["、"],["へび"],["や"],["さそり"],["を"],["踏みつけ","ふみつけ"],["、"],["敵","てき"],["の"],["あらゆる"],["力","ちから"],["に"],["打ち勝つ","うちかつ"],["権威","けんい"],["を"],["授","さ"],["づけた"],["。"],["だ"],["から"],["、"],["あなた"],["がた"],["に"],["害","がい"],["を"],["およぼす"],["者","もの"],["は"],["まったく"],["無いで","ないで"],["あろう"],["。"]]},{"verse":20,"text":"しかし、霊,れいがあなたがたに服従,ふくじゅうすることを喜,よろこぶな。むしろ、あなたがたの名,なが天,てんにしるされていることを喜,よろこびなさい」。","tok":[["しかし"],["、"],["霊","れい"],["が"],["あなた"],["がた"],["に"],["服従","ふくじゅう"],["する"],["こと"],["を"],["喜こぶ","よろこぶ"],["な"],["。"],["むしろ"],["、"],["あなた"],["がた"],["の"],["名","な"],["が"],["天","てん"],["に"],["しるされて"],["いる"],["こと"],["を"],["喜こび","よろこび"],["なさい"],["」"],["。"]]},{"verse":21,"text":"そのとき、イエスは聖霊,せいれいによって喜,よろこびあふれて言,いわれた、「天地,てんちの主,しゅなる父,ちちよ。あなたをほめたたえます。これらの事,ことを知恵,ちえのある者,ものや賢,かしこい者,ものに隠,かくして、幼,おさな子,ごにあらわしてくださいました。父,ちちよ、これはまことに、みこころにかなった事,ことでした。","tok":[["その"],["とき"],["、"],["イエス"],["は"],["聖霊","せいれい"],["によって"],["喜こび","よろこび"],["あふれて"],["言われた","いわれた"],["、"],["「"],["天地","てんち"],["の"],["主","しゅ"],["なる"],["父","ちち"],["よ"],["。"],["あなた"],["を"],["ほめたたえます"],["。"],["これ"],["ら"],["の"],["事","こと"],["を"],["知恵","ちえ"],["の"],["ある"],["者","もの"],["や"],["賢しこい","かしこい"],["者","もの"],["に"],["隠して","かくして"],["、"],["幼な子","おさなご"],["に"],["あらわして"],["くださいました"],["。"],["父","ちち"],["よ"],["、"],["これ"],["は"],["まこと"],["に"],["、"],["みこころ"],["に"],["かなった"],["事","こと"],["でした"],["。"]]},{"verse":22,"text":"すべての事,ことは父,ちちからわたしに任,まかせられています。そして、子,こがだれであるかは、父,ちちのほか知,しっている者,ものはありません。また父,ちちがだれであるかは、子,こと、父,ちちをあらわそうとして子,こが選,えらんだ者,ものとのほか、だれも知,しっている者,ものはいません」。","tok":[["すべて"],["の"],["事","こと"],["は"],["父","ちち"],["から"],["わたし"],["に"],["任せられて","まかせられて"],["います"],["。"],["そして"],["、"],["子","こ"],["が"],["だれ"],["で"],["ある"],["か"],["は"],["、"],["父","ちち"],["の"],["ほか"],["知って","しって"],["いる"],["者","もの"],["は"],["ありません"],["。"],["また"],["父","ちち"],["が"],["だれ"],["で"],["ある"],["か"],["は"],["、"],["子","こ"],["と"],["、"],["父","ちち"],["を"],["あらわそう"],["として"],["子","こ"],["が"],["選らんだ","えらんだ"],["者","もの"],["と"],["の"],["ほか"],["、"],["だれ"],["も"],["知って","しって"],["いる"],["者","もの"],["は"],["いません"],["」"],["。"]]},{"verse":23,"text":"それから弟子,でしたちの方,ほうに振,ふりむいて、ひそかに言,いわれた、「あなたがたが見,みていることを見,みる目,めは、さいわいである。","tok":[["それ"],["から"],["弟子","でし"],["たち"],["の"],["方","ほう"],["に"],["振りむいて","ふりむいて"],["、"],["ひそか"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["がた"],["が"],["見て","みて"],["いる"],["こと"],["を"],["見る","みる"],["目","め"],["は"],["、"],["さいわい"],["で"],["ある"],["。"]]},{"verse":24,"text":"あなたがたに言,いっておく。多,おおくの預言者,よげんしゃや王,おうたちも、あなたがたの見,みていることを見,みようとしたが、見,みることができず、あなたがたの聞,きいていることを聞,きこうとしたが、聞,きけなかったのである」。","tok":[["あなた"],["がた"],["に"],["言って","いって"],["おく"],["。"],["多く","おおく"],["の"],["預言者","よげんしゃ"],["や"],["王","おう"],["たち"],["も"],["、"],["あなた"],["がた"],["の"],["見て","みて"],["いる"],["こと"],["を"],["見よう","みよう"],["と"],["した"],["が"],["、"],["見る","みる"],["こと"],["が"],["できず"],["、"],["あなた"],["がた"],["の"],["聞いて","きいて"],["いる"],["こと"],["を"],["聞こう","きこう"],["と"],["した"],["が"],["、"],["聞けなかった","きけなかった"],["ので"],["ある"],["」"],["。"]]},{"verse":25,"text":"するとそこへ、ある律法,りっぽう学者,がくしゃが現,あらわれ、イエスを試,こころみようとして言,いった、「先生,せんせい、何,なにをしたら永遠,えいえんの生命,せいめいが受,うけられましょうか」。","tok":[["する"],["と"],["そこ"],["へ"],["、"],["ある"],["律法学者","りっぽうがくしゃ"],["が"],["現われ","あらわれ"],["、"],["イエス"],["を"],["試みよう","こころみよう"],["として"],["言った","いった"],["、"],["「"],["先生","せんせい"],["、"],["何に","なに"],["を"],["したら"],["永遠","えいえん"],["の"],["生命","せいめい"],["が"],["受られましょう","うけられましょう"],["か"],["」"],["。"]]},{"verse":26,"text":"彼,かれに言,いわれた、「律法,りっぽうにはなんと書,かいてあるか。あなたはどう読,よむか」。","tok":[["彼","かれ"],["に"],["言われた","いわれた"],["、"],["「"],["律法","りっぽう"],["に"],["は"],["なん"],["と"],["書いて","かいて"],["ある"],["か"],["。"],["あなた"],["は"],["どう"],["読む","よむ"],["か"],["」"],["。"]]},{"verse":27,"text":"彼,かれは答,こたえて言,いった、「『心,こころをつくし、精神,せいしんをつくし、力,ちからをつくし、思,おもいをつくして、主,しゅなるあなたの神,かみを愛,あいせよ』。また、『自分,じぶんを愛,あいするように、あなたの隣,となり人,びとを愛,あいせよ』とあります」。","tok":[["彼","かれ"],["は"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["『"],["心","こころ"],["を"],["つくし"],["、"],["精神","せいしん"],["を"],["つくし"],["、"],["力","ちから"],["を"],["つくし"],["、"],["思い","おもい"],["を"],["つくして"],["、"],["主","しゅ"],["なる"],["あなた"],["の"],["神","かみ"],["を"],["愛せよ","あいせよ"],["』"],["。"],["また"],["、"],["『"],["自分","じぶん"],["を"],["愛する","あいする"],["よう"],["に"],["、"],["あなた"],["の"],["隣人","となりびと"],["を"],["愛せよ","あいせよ"],["』"],["と"],["あります"],["」"],["。"]]},{"verse":28,"text":"彼,かれに言,いわれた、「あなたの答,こたえは正,ただしい。そのとおり行,おこないなさい。そうすれば、いのちが得,えられる」。","tok":[["彼","かれ"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["の"],["答","こたえ"],["は"],["正い","ただしい"],["。"],["その"],["とおり"],["行ない","おこない"],["なさい"],["。"],["そう"],["すれば"],["、"],["いのち"],["が"],["得られる","えられる"],["」"],["。"]]},{"verse":29,"text":"すると彼,かれは自分,じぶんの立場,たちばを弁護,べんごしようと思,おもって、イエスに言,いった、「では、わたしの隣,となり人,びととはだれのことですか」。","tok":[["する"],["と"],["彼","かれ"],["は"],["自分","じぶん"],["の"],["立場","たちば"],["を"],["弁護","べんご"],["しよう"],["と"],["思って","おもって"],["、"],["イエス"],["に"],["言った","いった"],["、"],["「"],["で"],["は"],["、"],["わたし"],["の"],["隣人","となりびとと"],["は"],["だれ"],["の"],["こと"],["です"],["か"],["」"],["。"]]},{"verse":30,"text":"イエスが答,こたえて言,いわれた、「ある人,ひとがエルサレムからエリコに下,くだって行,いく途中,とちゅう、強盗,ごうとうどもが彼,かれを襲,おそい、その着物,きものをはぎ取,とり、傷,きずを負,おわせ、半殺,はんごろしにしたまま、逃,にげ去,さった。","tok":[["イエス"],["が"],["答","こたえ"],["て"],["言われた","いわれた"],["、"],["「"],["ある"],["人","ひと"],["が"],["エルサレム"],["から"],["エリコ"],["に"],["下って","くだって"],["行く","いく"],["途中","とちゅう"],["、"],["強盗","ごうとう"],["ども"],["が"],["彼","かれ"],["を"],["襲い","おそい"],["、"],["その"],["着物","きもの"],["を"],["はぎ"],["取","とり"],["、"],["傷","きず"],["を"],["負わせ","おわせ"],["、"],["半殺し","はんごろし"],["に"],["した"],["まま"],["、"],["逃去","にげさっ"],["た"],["。"]]},{"verse":31,"text":"するとたまたま、ひとりの祭司,さいしがその道,みちを下,くだってきたが、この人,ひとを見,みると、向,むこう側,がわを通,とおって行,いった。","tok":[["する"],["と"],["たまたま"],["、"],["ひとり"],["の"],["祭司","さいし"],["が"],["その"],["道","みち"],["を"],["下って","くだって"],["きた"],["が"],["、"],["この"],["人","ひと"],["を"],["見る","みる"],["と"],["、"],["向こう側","むこうがわ"],["を"],["通って","とおって"],["行った","いった"],["。"]]},{"verse":32,"text":"同様,どうように、レビ人,ひともこの場所,ばしょにさしかかってきたが、彼,かれを見,みると向,むこう側,がわを通,とおって行,いった。","tok":[["同様","どうよう"],["に"],["、"],["レビ人","れびひと"],["も"],["この"],["場所","ばしょ"],["に"],["さしかかって"],["きた"],["が"],["、"],["彼","かれ"],["を"],["見る","みる"],["と"],["向こう側","むこうがわ"],["を"],["通って","とおって"],["行った","いった"],["。"]]},{"verse":33,"text":"ところが、あるサマリヤ人,びとが旅,たびをしてこの人,ひとのところを通,とおりかかり、彼,かれを見,みて気,きの毒,どくに思,おもい、","tok":[["ところ"],["が"],["、"],["ある"],["サマリヤ"],["人","び"],["と"],["が"],["旅","たび"],["を"],["して"],["この"],["人","ひと"],["の"],["ところ"],["を"],["通りかかり","とおりかかり"],["、"],["彼","かれ"],["を"],["見て","みて"],["気の毒","きのどく"],["に"],["思い","おもい"],["、"]]},{"verse":34,"text":"近寄,ちかよってきてその傷,きずにオリブ油,ゆとぶどう酒,しゅとを注,そそいでほうたいをしてやり、自分,じぶんの家畜,かちくに乗,のせ、宿屋,やどやに連,つれて行,いって介抱,かいほうした。","tok":[["近寄って","ちかよって"],["きて"],["その"],["傷","きず"],["に"],["オリブ"],["油","ゆ"],["と"],["ぶどう酒","ぶどうしゅ"],["と"],["を"],["注いで","そそいで"],["ほうたい"],["を"],["して"],["やり"],["、"],["自分","じぶん"],["の"],["家畜","かちく"],["に"],["乗せ","のせ"],["、"],["宿屋","やどや"],["に"],["連れて","つれて"],["行って","いって"],["介抱","かいほう"],["した"],["。"]]},{"verse":35,"text":"翌日,よくじつ、デナリ二つを取,とり出,だして宿屋,やどやの主人,しゅじんに手渡,てわたし、『この人,ひとを見,みてやってください。費用,ひようがよけいにかかったら、帰,かえりがけに、わたしが支払,しはらいます』と言,いった。","tok":[["翌日","よくじつ"],["、"],["デナリ"],["二","ふた"],["つ"],["を"],["取出して","とりだして"],["宿屋","やどや"],["の"],["主人","しゅじん"],["に"],["手渡","てわたし"],["、"],["『"],["この"],["人","ひと"],["を"],["見て","みて"],["やって"],["ください"],["。"],["費用","ひよう"],["が"],["よけい"],["に"],["かかったら"],["、"],["帰えり","かえり"],["がけ"],["に"],["、"],["わたし"],["が"],["支払います","しはらいます"],["』"],["と"],["言った","いった"],["。"]]},{"verse":36,"text":"この三人,にんのうち、だれが強盗,ごうとうに襲,おそわれた人,ひとの隣,となり人,びとになったと思,おもうか」。","tok":[["この"],["三人","にん"],["の"],["うち"],["、"],["だれ"],["が"],["強盗","ごうとう"],["に"],["襲れた","おそわれた"],["人","ひと"],["の"],["隣人","となりびと"],["に"],["なった"],["と"],["思","おもう"],["か"],["」"],["。"]]},{"verse":37,"text":"彼,かれが言,いった、「その人,ひとに慈悲,じひ深,ぶかい行,おこないをした人,ひとです」。そこでイエスは言,いわれた、「あなたも行,いって同,おなじようにしなさい」。","tok":[["彼","かれ"],["が"],["言った","いった"],["、"],["「"],["その"],["人","ひと"],["に"],["慈悲","じひ"],["深い","ぶかい"],["行ない","おこない"],["を"],["した"],["人","ひと"],["です"],["」"],["。"],["そこ"],["で"],["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["あなた"],["も"],["行って","いって"],["同じ","おなじ"],["よう"],["に"],["し"],["なさい"],["」"],["。"]]},{"verse":38,"text":"一同,いちどうが旅,たびを続,つづけているうちに、イエスがある村,むらへはいられた。するとマルタという名,なの女,おんながイエスを家,いえに迎,むかえ入,いれた。","tok":[["一同","いちどう"],["が"],["旅","たび"],["を"],["続けて","つづけて"],["いる"],["うち"],["に"],["、"],["イエス"],["が"],["ある"],["村","むら"],["へ"],["はいられた"],["。"],["する"],["と"],["マルタ"],["と"],["いう"],["名","な"],["の"],["女","おんな"],["が"],["イエス"],["を"],["家","いえ"],["に"],["迎","むかえ"],["入れた","いれた"],["。"]]},{"verse":39,"text":"この女,おんなにマリヤという妹,いもうとがいたが、主,しゅの足,あしもとにすわって、御言,みことばに聞,きき入,いっていた。","tok":[["この"],["女","おんな"],["に"],["マリヤ"],["と"],["いう"],["妹","いもうと"],["が"],["いた"],["が"],["、"],["主","しゅ"],["の"],["足もと","あしもと"],["に"],["すわって"],["、"],["御言","みこと"],["ば"],["に"],["聞入って","ききいって"],["いた"],["。"]]},{"verse":40,"text":"ところが、マルタは接待,せったいのことで忙,いそがしくて心,こころをとりみだし、イエスのところにきて言,いった、「主,しゅよ、妹,いもうとがわたしだけに接待,せったいをさせているのを、なんともお思,おもいになりませんか。わたしの手伝,てつだいをするように妹,いもうとにおっしゃってください」。","tok":[["ところ"],["が"],["、"],["マルタ"],["は"],["接待","せったい"],["の"],["こと"],["で"],["忙がしくて","いそがしくて"],["心","こころ"],["を"],["とりみだし"],["、"],["イエス"],["の"],["ところ"],["に"],["きて"],["言った","いった"],["、"],["「"],["主","しゅ"],["よ"],["、"],["妹","いもうと"],["が"],["わたし"],["だけ"],["に"],["接待","せったい"],["を"],["させて"],["いる"],["の"],["を"],["、"],["なん"],["と"],["も"],["お思い","おおもい"],["に"],["なりません"],["か"],["。"],["わたし"],["の"],["手伝","てつだい"],["を"],["する"],["よう"],["に"],["妹","いもうと"],["に"],["おっしゃって"],["ください"],["」"],["。"]]},{"verse":41,"text":"主,しゅは答,こたえて言,いわれた、「マルタよ、マルタよ、あなたは多,おおくのことに心,こころを配,くばって思,おもいわずらっている。","tok":[["主","しゅ"],["は"],["答","こたえ"],["て"],["言われた","いわれた"],["、"],["「"],["マルタ"],["よ"],["、"],["マルタ"],["よ"],["、"],["あなた"],["は"],["多く","おおく"],["の"],["こと"],["に"],["心","こころ"],["を"],["配ばって","くばって"],["思いわずらって","おもいわずらって"],["いる"],["。"]]},{"verse":42,"text":"しかし、無,なくてならぬものは多,おおくはない。いや、一つだけである。マリヤはその良,よい方,ほうを選,えらんだのだ。そしてそれは、彼女,かのじょから取,とり去,さってはならないものである」。","tok":[["しかし"],["、"],["無くて","なくて"],["ならぬ"],["もの"],["は"],["多く","おおく"],["は"],["ない"],["。"],["いや"],["、"],["一","ひと"],["つ"],["だけ"],["で"],["ある"],["。"],["マリヤ"],["は"],["その"],["良い","よい"],["方","ほう"],["を"],["選らんだ","えらんだ"],["の"],["だ"],["。"],["そして"],["それ"],["は"],["、"],["彼女","かのじょ"],["から"],["取","とり"],["去て","さって"],["は"],["ならない"],["もの"],["で"],["ある"],["」"],["。"]]}]
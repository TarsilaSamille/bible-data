[{"verse":1,"text":"ある日,ひ、イエスが宮,みやで人々,ひとびとに教,おしえ、福音,ふくいんを宣,のべておられると、祭司長,さいしちょうや律法,りっぽう学者,がくしゃたちが、長老,ちょうろうたちと共,ともに近寄,ちかよってきて、","tok":[["ある"],["日","ひ"],["、"],["イエス"],["が"],["宮","みや"],["で"],["人々","ひとびと"],["に"],["教え","おしえ"],["、"],["福音","ふくいん"],["を"],["宣べて","のべて"],["おられる"],["と"],["、"],["祭司長","さいしちょう"],["や"],["律法学者","りっぽうがくしゃ"],["たち"],["が"],["、"],["長老","ちょうろう"],["たち"],["と"],["共","とも"],["に"],["近寄って","ちかよって"],["きて"],["、"]]},{"verse":2,"text":"イエスに言,いった、「何,なにの権威,けんいによってこれらの事,ことをするのですか。そうする権威,けんいをあなたに与,あたえたのはだれですか、わたしたちに言,いってください」。","tok":[["イエス"],["に"],["言った","いった"],["、"],["「"],["何","なに"],["の"],["権威","けんい"],["によって"],["これ"],["ら"],["の"],["事","こと"],["を"],["する"],["の"],["です"],["か"],["。"],["そう"],["する"],["権威","けんい"],["を"],["あなた"],["に"],["与","あたえ"],["た"],["の"],["は"],["だれ"],["です"],["か"],["、"],["わたしたち"],["に"],["言って","いって"],["ください"],["」"],["。"]]},{"verse":3,"text":"そこで、イエスは答,こたえて言,いわれた、「わたしも、ひと言,ことたずねよう。それに答,こたえてほしい。","tok":[["そこ"],["で"],["、"],["イエス"],["は"],["答","こたえ"],["て"],["言われた","いわれた"],["、"],["「"],["わたし"],["も"],["、"],["ひと言","ひとこと"],["たずねよう"],["。"],["それ"],["に"],["答","こたえ"],["て"],["ほしい"],["。"]]},{"verse":4,"text":"ヨハネのバプテスマは、天,てんからであったか、人,ひとからであったか」。","tok":[["ヨハネ"],["の"],["バプテスマ"],["は"],["、"],["天","てん"],["から"],["で"],["あった"],["か"],["、"],["人","ひと"],["から"],["で"],["あった"],["か"],["」"],["。"]]},{"verse":5,"text":"彼,かれらは互,たがいに論,ろんじて言,いった、「もし天,てんからだと言,いえば、では、なぜ彼,かれを信,しんじなかったのか、とイエスは言,いうだろう。","tok":[["彼","かれ"],["ら"],["は"],["互","たがい"],["に"],["論じて","ろんじて"],["言った","いった"],["、"],["「"],["もし"],["天","てん"],["から"],["だ"],["と"],["言えば","いえば"],["、"],["で"],["は"],["、"],["なぜ"],["彼","かれ"],["を"],["信じなかった","しんじなかった"],["の"],["か"],["、"],["と"],["イエス"],["は"],["言うだろう","いうだろう"],["。"]]},{"verse":6,"text":"しかし、もし人,ひとからだと言,いえば、民衆,みんしゅうはみな、ヨハネを預言者,よげんしゃだと信,しんじているから、わたしたちを石,いしで打,うつだろう」。","tok":[["しかし"],["、"],["もし"],["人","ひと"],["から"],["だ"],["と"],["言えば","いえば"],["、"],["民衆","みんしゅう"],["は"],["みな"],["、"],["ヨハネ"],["を"],["預言者","よげんしゃ"],["だ"],["と"],["信じて","しんじて"],["いる"],["から"],["、"],["わたしたち"],["を"],["石","いし"],["で"],["打つだろう","うつだろう"],["」"],["。"]]},{"verse":7,"text":"それで彼,かれらは「どこからか、知,しりません」と答,こたえた。","tok":[["それ"],["で"],["彼","かれ"],["ら"],["は"],["「"],["どこ"],["から"],["か"],["、"],["知りません","しりません"],["」"],["と"],["答","こたえ"],["た"],["。"]]},{"verse":8,"text":"イエスはこれに対,たいして言,いわれた、「わたしも何,なにの権威,けんいによってこれらの事,ことをするのか、あなたがたに言,いうまい」。","tok":[["イエス"],["は"],["これ"],["に対して","にたいして"],["言われた","いわれた"],["、"],["「"],["わたし"],["も"],["何","なに"],["の"],["権威","けんい"],["によって"],["これ"],["ら"],["の"],["事","こと"],["を"],["する"],["の"],["か"],["、"],["あなた"],["がた"],["に"],["言うまい","いうまい"],["」"],["。"]]},{"verse":9,"text":"そこでイエスは次,つぎの譬,たとえを民衆,みんしゅうに語,かたり出,だされた、「ある人,ひとがぶどう園,えんを造,つくって農夫,のうふたちに貸,かし、長,ながい旅,たびに出,でた。","tok":[["そこ"],["で"],["イエス"],["は"],["次","つぎ"],["の"],["譬","たとえ"],["を"],["民衆","みんしゅう"],["に"],["語り","かたり"],["出された","だされた"],["、"],["「"],["ある"],["人","ひと"],["が"],["ぶどう園","ぶどうえん"],["を"],["造って","つくって"],["農夫","のうふ"],["たち"],["に"],["貸","かし"],["、"],["長い","ながい"],["旅","たび"],["に"],["出た","でた"],["。"]]},{"verse":10,"text":"季節,きせつになったので、農夫,のうふたちのところへ、ひとりの僕,しもべを送,おくって、ぶどう園,えんの収穫,しゅうかくの分,わけ前,まえを出,ださせようとした。ところが、農夫,のうふたちは、その僕,しもべを袋,ふくろだたきにし、から手,てで帰,かえらせた。","tok":[["季節","きせつ"],["に"],["なった"],["ので"],["、"],["農夫","のうふ"],["たち"],["の"],["ところ"],["へ"],["、"],["ひとり"],["の"],["僕","し"],["も"],["べ"],["を"],["送って","おくって"],["、"],["ぶどう園","ぶどうえん"],["の"],["収穫","しゅうかく"],["の"],["分け前","わけまえ"],["を"],["出させよう","ださせよう"],["と"],["した"],["。"],["ところ"],["が"],["、"],["農夫","のうふ"],["たち"],["は"],["、"],["その"],["僕","し"],["も"],["べ"],["を"],["袋だたき","ふくろだたき"],["に"],["し"],["、"],["から"],["手","て"],["で"],["帰えらせた","かえらせた"],["。"]]},{"verse":11,"text":"そこで彼,かれはもうひとりの僕,しもべを送,おくった。彼,かれらはその僕,しもべも袋,ふくろだたきにし、侮辱,ぶじょくを加,くわえて、から手,てで帰,かえらせた。","tok":[["そこ"],["で"],["彼","かれ"],["は"],["もう"],["ひとり"],["の"],["僕","し"],["も"],["べ"],["を"],["送った","おくった"],["。"],["彼","かれ"],["ら"],["は"],["その"],["僕","し"],["も"],["べ"],["も"],["袋だたき","ふくろだたき"],["に"],["し"],["、"],["侮辱","ぶじょく"],["を"],["加えて","くわえて"],["、"],["から"],["手","て"],["で"],["帰えらせた","かえらせた"],["。"]]},{"verse":12,"text":"そこで更,さらに三人,にん目,めの者,ものを送,おくったが、彼,かれらはこの者,ものも、傷,きずを負,おわせて追,おい出,だした。","tok":[["そこ"],["で"],["更に","さらに"],["三人目","にんめ"],["の"],["者","もの"],["を"],["送った","おくった"],["が"],["、"],["彼","かれ"],["ら"],["は"],["この"],["者","もの"],["も"],["、"],["傷","きず"],["を"],["負わせて","おわせて"],["追い出した","おいだした"],["。"]]},{"verse":13,"text":"ぶどう園,えんの主人,しゅじんは言,いった、『どうしようか。そうだ、わたしの愛子,あいしをつかわそう。これなら、たぶん敬,うやまってくれるだろう』。","tok":[["ぶどう園","ぶどうえん"],["の"],["主人","しゅじん"],["は"],["言った","いった"],["、"],["『"],["どう"],["しよう"],["か"],["。"],["そう"],["だ"],["、"],["わたし"],["の"],["愛子","あいし"],["を"],["つかわそう"],["。"],["これ"],["なら"],["、"],["たぶん"],["敬って","うやまって"],["くれるだろう"],["』"],["。"]]},{"verse":14,"text":"ところが、農夫,のうふたちは彼,かれを見,みると、『あれはあと取,とりだ。あれを殺,ころしてしまおう。そうしたら、その財産,ざいさんはわれわれのものになるのだ』と互,たがいに話,はなし合,あい、","tok":[["ところ"],["が"],["、"],["農夫","のうふ"],["たち"],["は"],["彼","かれ"],["を"],["見る","みる"],["と"],["、"],["『"],["あれ"],["は"],["あと"],["取","とり"],["だ"],["。"],["あれ"],["を"],["殺ろして","ころして"],["しまおう"],["。"],["そう"],["したら"],["、"],["その"],["財産","ざいさん"],["は"],["われわれ"],["の"],["もの"],["に"],["なる"],["の"],["だ"],["』"],["と"],["互","たがい"],["に"],["話合い","はなしあい"],["、"]]},{"verse":15,"text":"彼,かれをぶどう園,えんの外,そとに追,おい出,だして殺,ころした。そのさい、ぶどう園,えんの主人,しゅじんは、彼,かれらをどうするだろうか。","tok":[["彼","かれ"],["を"],["ぶどう園","ぶどうえん"],["の"],["外","そと"],["に"],["追い出して","おいだして"],["殺ろした","ころした"],["。"],["その"],["さい"],["、"],["ぶどう園","ぶどうえん"],["の"],["主人","しゅじん"],["は"],["、"],["彼","かれ"],["ら"],["を"],["どう"],["するだろう"],["か"],["。"]]},{"verse":16,"text":"彼,かれは出,でてきて、この農夫,のうふたちを殺,ころし、ぶどう園,えんを他,たの人々,ひとびとに与,あたえるであろう」。人々,ひとびとはこれを聞,きいて、「そんなことがあってはなりません」と言,いった。","tok":[["彼","かれ"],["は"],["出て","でて"],["きて"],["、"],["この"],["農夫","のうふ"],["たち"],["を"],["殺ろし","ころし"],["、"],["ぶどう園","ぶどうえん"],["を"],["他","た"],["の"],["人々","ひとびと"],["に"],["与えるで","あたえるで"],["あろう"],["」"],["。"],["人々","ひとびと"],["は"],["これ"],["を"],["聞いて","きいて"],["、"],["「"],["そんな"],["こと"],["が"],["あって"],["は"],["なりません"],["」"],["と"],["言った","いった"],["。"]]},{"verse":17,"text":"そこで、イエスは彼,かれらを見,みつめて言,いわれた、「それでは、『家,いえ造,つくりらの捨,すてた石,いしが隅,すみのかしら石,いしになった』と書,かいてあるのは、どういうことか。","tok":[["そこ"],["で"],["、"],["イエス"],["は"],["彼","かれ"],["ら"],["を"],["見つめて","みつめて"],["言われた","いわれた"],["、"],["「"],["それ"],["で"],["は"],["、"],["『"],["家造","いえつくり"],["ら"],["の"],["捨てた","すてた"],["石","いし"],["が"],["隅","すみ"],["の"],["かしら"],["石","いし"],["に"],["なった"],["』"],["と"],["書いて","かいて"],["ある"],["の"],["は"],["、"],["どういう"],["こと"],["か"],["。"]]},{"verse":18,"text":"すべてその石,いしの上,うえに落,おちる者,ものは打,うち砕,くだかれ、それがだれかの上,うえに落,おちかかるなら、その人,ひとはこなみじんにされるであろう」。","tok":[["すべて"],["その"],["石","いし"],["の"],["上","うえ"],["に"],["落","おち"],["る"],["者","もの"],["は"],["打ち砕かれ","うちくだかれ"],["、"],["それ"],["が"],["だれ"],["か"],["の"],["上","うえ"],["に"],["落","おち"],["かかるなら"],["、"],["その"],["人","ひと"],["は"],["こな"],["みじん"],["に"],["されるで"],["あろう"],["」"],["。"]]},{"verse":19,"text":"このとき、律法,りっぽう学者,がくしゃたちや祭司長,さいしちょうたちはイエスに手,てをかけようと思,おもったが、民衆,みんしゅうを恐,おそれた。いまの譬,たとえが自分,じぶんたちに当,あてて語,かたられたのだと、悟,さとったからである。","tok":[["この"],["とき"],["、"],["律法学者","りっぽうがくしゃ"],["たち"],["や"],["祭司長","さいしちょう"],["たち"],["は"],["イエス"],["に"],["手","て"],["を"],["かけよう"],["と"],["思った","おもった"],["が"],["、"],["民衆","みんしゅう"],["を"],["恐れた","おそれた"],["。"],["いま"],["の"],["譬","たとえ"],["が"],["自分","じぶん"],["たち"],["に"],["当てて","あてて"],["語られた","かたられた"],["の"],["だ"],["と"],["、"],["悟った","さとった"],["から"],["で"],["ある"],["。"]]},{"verse":20,"text":"そこで、彼,かれらは機会,きかいをうかがい、義人,ぎじんを装,よそおうまわし者,ものどもを送,おくって、イエスを総督,そうとくの支配,しはいと権威,けんいとに引,ひき渡,わたすため、その言葉,ことばじりを捕,とらえさせようとした。","tok":[["そこ"],["で"],["、"],["彼","かれ"],["ら"],["は"],["機会","きかい"],["を"],["うかがい"],["、"],["義人","ぎじん"],["を"],["装う","よそおう"],["まわし者","まわしもの"],["ども"],["を"],["送って","おくって"],["、"],["イエス"],["を"],["総督","そうとく"],["の"],["支配","しはい"],["と"],["権威","けんい"],["と"],["に"],["引渡す","ひきわたす"],["ため"],["、"],["その"],["言葉じり","ことばじり"],["を"],["捕らえさせよう","とらえさせよう"],["と"],["した"],["。"]]},{"verse":21,"text":"彼,かれらは尋,たずねて言,いった、「先生,せんせい、わたしたちは、あなたの語,かたり教,おしえられることが正,ただしく、また、あなたは分,わけ隔,へだてをなさらず、真理,しんりに基,もとづいて神,かみの道,みちを教,おしえておられることを、承知,しょうちしています。","tok":[["彼","かれ"],["ら"],["は"],["尋ねて","たずねて"],["言った","いった"],["、"],["「"],["先生","せんせい"],["、"],["わたしたち"],["は"],["、"],["あなた"],["の"],["語り","かたり"],["教えられる","おしえられる"],["こと"],["が"],["正く","ただしく"],["、"],["また"],["、"],["あなた"],["は"],["分け隔て","わけへだて"],["を"],["なさらず"],["、"],["真理","しんり"],["に"],["基づいて","もとづいて"],["神","かみ"],["の"],["道","みち"],["を"],["教えて","おしえて"],["おられる"],["こと"],["を"],["、"],["承知","しょうち"],["して"],["います"],["。"]]},{"verse":22,"text":"ところで、カイザルに貢,みつぎを納,おさめてよいでしょうか、いけないでしょうか」。","tok":[["ところ"],["で"],["、"],["カイザル"],["に"],["貢","みつぎ"],["を"],["納","おさめ"],["て"],["よいでしょう"],["か"],["、"],["いけないでしょう"],["か"],["」"],["。"]]},{"verse":23,"text":"イエスは彼,かれらの悪巧,わるだくみを見破,みやぶって言,いわれた、","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["の"],["悪巧み","わるだくみ"],["を"],["見破って","みやぶって"],["言われた","いわれた"],["、"]]},{"verse":24,"text":"「デナリを見,みせなさい。それにあるのは、だれの肖像,しょうぞう、だれの記号,きごうなのか」。「カイザルのです」と、彼,かれらが答,こたえた。","tok":[["「"],["デナリ"],["を"],["見せ","みせ"],["なさい"],["。"],["それ"],["に"],["ある"],["の"],["は"],["、"],["だれ"],["の"],["肖像","しょうぞう"],["、"],["だれ"],["の"],["記号","きごう"],["な"],["の"],["か"],["」"],["。"],["「"],["カイザル"],["の"],["です"],["」"],["と"],["、"],["彼","かれ"],["ら"],["が"],["答","こたえ"],["た"],["。"]]},{"verse":25,"text":"するとイエスは彼,かれらに言,いわれた、「それなら、カイザルのものはカイザルに、神,かみのものは神,かみに返,かえしなさい」。","tok":[["する"],["と"],["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["それ"],["なら"],["、"],["カイザル"],["の"],["もの"],["は"],["カイザル"],["に"],["、"],["神","かみ"],["の"],["もの"],["は"],["神","かみ"],["に"],["返","かえし"],["なさい"],["」"],["。"]]},{"verse":26,"text":"そこで彼,かれらは、民衆,みんしゅうの前,まえでイエスの言葉,ことばじりを捕,とらえることができず、その答,こたえに驚嘆,きょうたんして、黙,だまってしまった。","tok":[["そこ"],["で"],["彼","かれ"],["ら"],["は"],["、"],["民衆","みんしゅう"],["の"],["前","まえ"],["で"],["イエス"],["の"],["言葉じり","ことばじり"],["を"],["捕らえる","とらえる"],["こと"],["が"],["できず"],["、"],["その"],["答","こたえ"],["に"],["驚嘆","きょうたん"],["して"],["、"],["黙って","だまって"],["しまった"],["。"]]},{"verse":27,"text":"復活,ふっかつということはないと言,いい張,はっていたサドカイ人,びとのある者,ものたちが、イエスに近寄,ちかよってきて質問,しつもんした、","tok":[["復活","ふっかつ"],["と"],["いう"],["こと"],["は"],["ない"],["と"],["言い張って","いいはって"],["いた"],["サドカイ"],["人","びと"],["の"],["ある"],["者","もの"],["たち"],["が"],["、"],["イエス"],["に"],["近寄って","ちかよって"],["きて"],["質問","しつもん"],["した"],["、"]]},{"verse":28,"text":"「先生,せんせい、モーセは、わたしたちのためにこう書,かいています、『もしある人,ひとの兄,あにが妻,つまをめとり、子,こがなくて死,しんだなら、弟,おとうとはこの女,おんなをめとって、兄,あにのために子,こをもうけねばならない』。","tok":[["「"],["先生","せんせい"],["、"],["モーセ"],["は"],["、"],["わたしたち"],["の"],["ため"],["に"],["こう"],["書いて","かいて"],["います"],["、"],["『"],["もし"],["ある"],["人","ひと"],["の"],["兄","あに"],["が"],["妻","つま"],["を"],["めとり"],["、"],["子","こ"],["が"],["なくて"],["死んだなら","しんだなら"],["、"],["弟","おとうと"],["は"],["この"],["女","おんな"],["を"],["めとって"],["、"],["兄","あに"],["の"],["ため"],["に"],["子","こ"],["を"],["もうけねば"],["ならない"],["』"],["。"]]},{"verse":29,"text":"ところで、ここに七人,にんの兄弟,きょうだいがいました。長男,ちょうなんは妻,つまをめとりましたが、子,こがなくて死,しに、","tok":[["ところ"],["で"],["、"],["ここ"],["に"],["七人","にん"],["の"],["兄弟","きょうだい"],["が"],["いました"],["。"],["長男","ちょうなん"],["は"],["妻","つま"],["を"],["めとりました"],["が"],["、"],["子","こ"],["が"],["なくて"],["死に","しに"],["、"]]},{"verse":30,"text":"そして次男,じなん、三男,さんなんと、次々,つぎつぎに、その女,おんなをめとり、","tok":[["そして"],["次男","じなん"],["、"],["三男","さんなん"],["と"],["、"],["次々","つぎつぎ"],["に"],["、"],["その"],["女","おんな"],["を"],["めとり"],["、"]]},{"verse":31,"text":"七人,にんとも同様,どうように、子,こをもうけずに死,しにました。","tok":[["七人","にんと"],["も"],["同様","どうよう"],["に"],["、"],["子","こ"],["を"],["もうけず"],["に"],["死にました","しにました"],["。"]]},{"verse":32,"text":"のちに、その女,おんなも死,しにました。","tok":[["のち"],["に"],["、"],["その"],["女","おんな"],["も"],["死にました","しにました"],["。"]]},{"verse":33,"text":"さて、復活,ふっかつの時,ときには、この女,おんなは七人,にんのうち、だれの妻,つまになるのですか。七人,にんとも彼女,かのじょを妻,つまにしたのですが」。","tok":[["さて"],["、"],["復活","ふっかつ"],["の"],["時","とき"],["に"],["は"],["、"],["この"],["女","おんな"],["は"],["七人","にん"],["の"],["うち"],["、"],["だれ"],["の"],["妻","つま"],["に"],["なる"],["の"],["です"],["か"],["。"],["七人","にんと"],["も"],["彼女","かのじょ"],["を"],["妻","つま"],["に"],["した"],["の"],["です"],["が"],["」"],["。"]]},{"verse":34,"text":"イエスは彼,かれらに言,いわれた、「この世,よの子,こらは、めとったり、とついだりするが、","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["この世","このよ"],["の"],["子","こ"],["ら"],["は"],["、"],["めとっ"],["たり"],["、"],["と"],["つい"],["だり"],["する"],["が"],["、"]]},{"verse":35,"text":"かの世,よにはいって死人,しにんからの復活,ふっかつにあずかるにふさわしい者,ものたちは、めとったり、とついだりすることはない。","tok":[["かの"],["世","よ"],["に"],["はいって"],["死人","しにん"],["から"],["の"],["復活","ふっかつ"],["に"],["あずかる"],["に"],["ふさわしい"],["者","もの"],["たち"],["は"],["、"],["めとっ"],["たり"],["、"],["と"],["つい"],["だり"],["する"],["こと"],["は"],["ない"],["。"]]},{"verse":36,"text":"彼,かれらは天使,てんしに等,ひとしいものであり、また復活,ふっかつにあずかるゆえに、神,かみの子,こでもあるので、もう死,しぬことはあり得,えないからである。","tok":[["彼","かれ"],["ら"],["は"],["天使","てんし"],["に"],["等い","ひとしい"],["もの"],["で"],["あり"],["、"],["また"],["復活","ふっかつ"],["に"],["あずかる"],["ゆえ"],["に"],["、"],["神","かみ"],["の"],["子","こ"],["で"],["も"],["ある"],["ので"],["、"],["もう"],["死ぬ","しぬ"],["こと"],["は"],["あり"],["得ない","えない"],["から"],["で"],["ある"],["。"]]},{"verse":37,"text":"死人,しにんがよみがえることは、モーセも柴,しばの篇,へんで、主,しゅを『アブラハムの神,かみ、イサクの神,かみ、ヤコブの神,かみ』と呼,よんで、これを示,しめした。","tok":[["死人","しにん"],["が"],["よみがえる"],["こと"],["は"],["、"],["モーセ"],["も"],["柴","しば"],["の"],["篇","へん"],["で"],["、"],["主","しゅ"],["を"],["『"],["アブラハム"],["の"],["神","かみ"],["、"],["イサク"],["の"],["神","かみ"],["、"],["ヤコブ"],["の"],["神","かみ"],["』"],["と"],["呼んで","よんで"],["、"],["これ"],["を"],["示めした","しめした"],["。"]]},{"verse":38,"text":"神,かみは死,しんだ者,ものの神,かみではなく、生,いきている者,ものの神,かみである。人,ひとはみな神,かみに生,いきるものだからである」。","tok":[["神","かみ"],["は"],["死んだ","しんだ"],["者","もの"],["の"],["神","かみ"],["で"],["は"],["なく"],["、"],["生きて","いきて"],["いる"],["者","もの"],["の"],["神","かみ"],["で"],["ある"],["。"],["人","ひと"],["は"],["みな"],["神","かみ"],["に"],["生きる","いきる"],["もの"],["だ"],["から"],["で"],["ある"],["」"],["。"]]},{"verse":39,"text":"律法,りっぽう学者,がくしゃのうちのある人々,ひとびとが答,こたえて言,いった、「先生,せんせい、仰,おおせのとおりです」。","tok":[["律法学者","りっぽうがくしゃ"],["の"],["うち"],["の"],["ある"],["人々","ひとびと"],["が"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["先生","せんせい"],["、"],["仰せ","おおせ"],["の"],["とおり"],["です"],["」"],["。"]]},{"verse":40,"text":"彼,かれらはそれ以上,いじょう何,なにもあえて問,といかけようとしなかった。","tok":[["彼","かれ"],["ら"],["は"],["それ"],["以上","いじょう"],["何に","なに"],["も"],["あえて"],["問","とい"],["かけよう"],["と"],["しなかった"],["。"]]},{"verse":41,"text":"イエスは彼,かれらに言,いわれた、「どうして人々,ひとびとはキリストをダビデの子,こだと言,いうのか。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["どう"],["して"],["人々","ひとびと"],["は"],["キリスト"],["を"],["ダビデ"],["の"],["子","こ"],["だ"],["と"],["言う","いう"],["の"],["か"],["。"]]},{"verse":42,"text":"ダビデ自身,じしんが詩篇,しへんの中,なかで言,いっている、『主,しゅはわが主,しゅに仰,おおせになった、","tok":[["ダビデ"],["自身","じしん"],["が"],["詩篇","しへん"],["の"],["中","なか"],["で"],["言って","いって"],["いる"],["、"],["『"],["主","しゅ"],["は"],["わが"],["主に","しゅに"],["仰せ","おおせ"],["に"],["なった"],["、"]]},{"verse":43,"text":"あなたの敵,てきをあなたの足,あし台,だいとする時,ときまでは、わたしの右,みぎに座,ざしていなさい』。","tok":[["あなた"],["の"],["敵","てき"],["を"],["あなた"],["の"],["足台","あしだい"],["と"],["する"],["時","とき"],["まで"],["は"],["、"],["わたし"],["の"],["右","みぎ"],["に"],["座して","ざして"],["い"],["なさい"],["』"],["。"]]},{"verse":44,"text":"このように、ダビデはキリストを主,しゅと呼,よんでいる。それなら、どうしてキリストはダビデの子,こであろうか」。","tok":[["この"],["よう"],["に"],["、"],["ダビデ"],["は"],["キリスト"],["を"],["主","しゅ"],["と"],["呼んで","よんで"],["いる"],["。"],["それ"],["なら"],["、"],["どう"],["して"],["キリスト"],["は"],["ダビデ"],["の"],["子","こ"],["で"],["あろう"],["か"],["」"],["。"]]},{"verse":45,"text":"民衆,みんしゅうがみな聞,きいているとき、イエスは弟子,でしたちに言,いわれた、","tok":[["民衆","みんしゅう"],["が"],["みな"],["聞いて","きいて"],["いる"],["とき"],["、"],["イエス"],["は"],["弟子","でし"],["たち"],["に"],["言われた","いわれた"],["、"]]},{"verse":46,"text":"「律法,りっぽう学者,がくしゃに気,きをつけなさい。彼,かれらは長,ながい衣,ころもを着,きて歩,あるくのを好,このみ、広場,ひろばでの敬礼,けいれいや会堂,かいどうの上席,じょうせきや宴会,えんかいの上座,じょうざをよろこび、","tok":[["「"],["律法学者","りっぽうがくしゃ"],["に"],["気","き"],["を"],["つけ"],["なさい"],["。"],["彼","かれ"],["ら"],["は"],["長い","ながい"],["衣","ころも"],["を"],["着て","きて"],["歩く","あるく"],["の"],["を"],["好み","このみ"],["、"],["広場","ひろば"],["で"],["の"],["敬礼","けいれい"],["や"],["会堂","かいどう"],["の"],["上席","じょうせき"],["や"],["宴会","えんかい"],["の"],["上座","じょうざ"],["を"],["よろこび"],["、"]]},{"verse":47,"text":"やもめたちの家,いえを食,くい倒,たおし、見,みえのために長,ながい祈,いのりをする。彼,かれらはもっときびしいさばきを受,うけるであろう」。","tok":[["やもめ"],["たち"],["の"],["家","いえ"],["を"],["食い倒し","くいたおし"],["、"],["見え","みえ"],["の"],["ため"],["に"],["長い","ながい"],["祈","いのり"],["を"],["する"],["。"],["彼","かれ"],["ら"],["は"],["もっと"],["きびしい"],["さばき"],["を"],["受るで","うけるで"],["あろう"],["」"],["。"]]}]
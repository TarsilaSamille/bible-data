[{"verse":1,"text":"また、イエスは失望,しつぼうせずに常,つねに祈,いのるべきことを、人々,ひとびとに譬,たとえで教,おしえられた。","tok":[["また"],["、"],["イエス"],["は"],["失望","しつぼう"],["せず"],["に"],["常","つね"],["に"],["祈るべき","いのるべき"],["こと"],["を"],["、"],["人々","ひとびと"],["に"],["譬","たとえ"],["で"],["教えられた","おしえられた"],["。"]]},{"verse":2,"text":"「ある町,まちに、神,かみを恐,おそれず、人,ひとを人,ひととも思,おもわぬ裁判官,さいばんかんがいた。","tok":[["「"],["ある"],["町","まち"],["に"],["、"],["神","かみ"],["を"],["恐れず","おそれず"],["、"],["人","ひと"],["を"],["人","ひと"],["と"],["も"],["思わぬ","おもわぬ"],["裁判官","さいばんかん"],["が"],["いた"],["。"]]},{"verse":3,"text":"ところが、その同,おなじ町,まちにひとりのやもめがいて、彼,かれのもとにたびたびきて、『どうぞ、わたしを訴,うったえる者,ものをさばいて、わたしを守,まもってください』と願,ねがいつづけた。","tok":[["ところ"],["が"],["、"],["その"],["同じ","おなじ"],["町","まち"],["に"],["ひとり"],["の"],["やもめ"],["が"],["いて"],["、"],["彼","かれ"],["の"],["もと"],["に"],["たびたび"],["きて"],["、"],["『"],["どうぞ"],["、"],["わたし"],["を"],["訴る","うったえる"],["者","もの"],["を"],["さばいて"],["、"],["わたし"],["を"],["守って","まもって"],["ください"],["』"],["と"],["願い","ねがい"],["つづけた"],["。"]]},{"verse":4,"text":"彼,かれはしばらくの間,あいだきき入,いれないでいたが、そののち、心,こころのうちで考,かんがえた、『わたしは神,かみをも恐,おそれず、人,ひとを人,ひととも思,おもわないが、","tok":[["彼","かれ"],["は"],["しばらく"],["の"],["間","あいだ"],["きき入れないで","ききいれないで"],["いた"],["が"],["、"],["その"],["のち"],["、"],["心","こころ"],["の"],["うち"],["で"],["考","かんがえ"],["た"],["、"],["『"],["わたし"],["は"],["神","かみ"],["を"],["も"],["恐れず","おそれず"],["、"],["人","ひと"],["を"],["人","ひと"],["と"],["も"],["思わない","おもわない"],["が"],["、"]]},{"verse":5,"text":"このやもめがわたしに面倒,めんどうをかけるから、彼女,かのじょのためになる裁判,さいばんをしてやろう。そうしたら、絶,たえずやってきてわたしを悩,なやますことがなくなるだろう』」。","tok":[["この"],["やもめ"],["が"],["わたし"],["に"],["面倒","めんどう"],["を"],["かける"],["から"],["、"],["彼女","かのじょ"],["の"],["ため"],["に"],["なる"],["裁判","さいばん"],["を"],["して"],["やろう"],["。"],["そう"],["したら"],["、"],["絶えず","たえず"],["やって"],["きて"],["わたし"],["を"],["悩す","なやます"],["こと"],["が"],["なくなるだろう"],["』"],["」"],["。"]]},{"verse":6,"text":"そこで主,しゅは言,いわれた、「この不義,ふぎな裁判官,さいばんかんの言,いっていることを聞,きいたか。","tok":[["そこ"],["で"],["主","しゅ"],["は"],["言われた","いわれた"],["、"],["「"],["この"],["不義","ふぎ"],["な"],["裁判官","さいばんかん"],["の"],["言って","いって"],["いる"],["こと"],["を"],["聞いた","きいた"],["か"],["。"]]},{"verse":7,"text":"まして神,かみは、日夜,にちや叫,さけび求,もとめる選民,せんみんのために、正,ただしいさばきをしてくださらずに長,ながい間,あいだそのままにしておかれることがあろうか。","tok":[["まして"],["神","かみ"],["は"],["、"],["日夜","にちや"],["叫","さけび"],["求める","もとめる"],["選民","せんみん"],["の"],["ため"],["に"],["、"],["正い","ただしい"],["さばき"],["を"],["して"],["くださらず"],["に"],["長い","ながい"],["間","あいだ"],["そのまま"],["に"],["して"],["おかれる"],["こと"],["が"],["あろう"],["か"],["。"]]},{"verse":8,"text":"あなたがたに言,いっておくが、神,かみはすみやかにさばいてくださるであろう。しかし、人,ひとの子,こが来,くるとき、地上,ちじょうに信仰,しんこうが見,みられるであろうか」。","tok":[["あなた"],["がた"],["に"],["言って","いって"],["おく"],["が"],["、"],["神","かみ"],["は"],["すみやか"],["に"],["さばいて"],["くださるで"],["あろう"],["。"],["しかし"],["、"],["人","ひと"],["の"],["子","こ"],["が"],["来る","くる"],["とき"],["、"],["地上","ちじょう"],["に"],["信仰","しんこう"],["が"],["見られるで","みられるで"],["あろう"],["か"],["」"],["。"]]},{"verse":9,"text":"自分,じぶんを義人,ぎじんだと自任,じにんして他人,たにんを見下,みさげている人,ひとたちに対,たいして、イエスはまたこの譬,たとえをお話,はなしになった。","tok":[["自分","じぶん"],["を"],["義人","ぎじん"],["だ"],["と"],["自任","じにん"],["して"],["他人","たにん"],["を"],["見下げて","みさげて"],["いる"],["人","ひと"],["たち"],["に対して","にたいして"],["、"],["イエス"],["は"],["また"],["この"],["譬","たとえ"],["を"],["お話","おはなし"],["に"],["なった"],["。"]]},{"verse":10,"text":"「ふたりの人,ひとが祈,いのるために宮,みやに上,のぼった。そのひとりはパリサイ人,びとであり、もうひとりは取税人,しゅぜいにんであった。","tok":[["「"],["ふたり"],["の"],["人","ひと"],["が"],["祈る","いのる"],["ため"],["に"],["宮","みや"],["に"],["上った","のぼった"],["。"],["その"],["ひとり"],["は"],["パリサイ"],["人","び"],["と"],["で"],["あり"],["、"],["もう"],["ひとり"],["は"],["取","とり"],["税人","ぜいにん"],["ぜ"],["い"],["に"],["ん"],["で"],["あった"],["。"]]},{"verse":11,"text":"パリサイ人,びとは立,たって、ひとりでこう祈,いのった、『神,かみよ、わたしはほかの人,ひとたちのような貪欲,どんよくな者,もの、不正,ふせいな者,もの、姦淫,かんいんをする者,ものではなく、また、この取税人,しゅぜいにんのような人間,にんげんでもないことを感謝,かんしゃします。","tok":[["パリサイ"],["人","びと"],["は"],["立って","たって"],["、"],["ひとり"],["で"],["こう"],["祈った","いのった"],["、"],["『"],["神","かみ"],["よ"],["、"],["わたし"],["は"],["ほか"],["の"],["人","ひと"],["たち"],["の"],["よう"],["な"],["貪欲","どんよく"],["な"],["者","もの"],["、"],["不正","ふせい"],["な"],["者","もの"],["、"],["姦淫","かんいん"],["を"],["する"],["者","もの"],["で"],["は"],["なく"],["、"],["また"],["、"],["この"],["取","とり"],["税人","ぜいにん"],["の"],["よう"],["な"],["人間","にんげん"],["で"],["も"],["ない"],["こと"],["を"],["感謝","かんしゃ"],["します"],["。"]]},{"verse":12,"text":"わたしは一週,しゅうに二度,ど断食,だんじきしており、全,ぜん収入,しゅうにゅうの十分,ぶんの一をささげています』。","tok":[["わたし"],["は"],["一","いち"],["週","しゅう"],["に"],["二","に"],["度","ど"],["断食","だんじき"],["して"],["おり"],["、"],["全","ぜん"],["収入","しゅうにゅう"],["の"],["十分","ぶん"],["の"],["一","いち"],["を"],["ささげて"],["います"],["』"],["。"]]},{"verse":13,"text":"ところが、取税人,しゅぜいにんは遠,とおく離,はなれて立,たち、目,めを天,てんにむけようともしないで、胸,むねを打,うちながら言,いった、『神様,かみさま、罪人,つみびとのわたしをおゆるしください』と。","tok":[["ところ"],["が"],["、"],["取","とり"],["税人","ぜいにん"],["に"],["ん"],["は"],["遠く","とおく"],["離れて","はなれて"],["立ち","たち"],["、"],["目","め"],["を"],["天","てん"],["に"],["むけよう"],["と"],["も"],["しないで"],["、"],["胸","むね"],["を"],["打ち","うち"],["ながら"],["言った","いった"],["、"],["『"],["神様","かみさま"],["、"],["罪人","つみびと"],["の"],["わたし"],["を"],["おゆるし"],["ください"],["』"],["と"],["。"]]},{"verse":14,"text":"あなたがたに言,いっておく。神,かみに義,ぎとされて自分,じぶんの家,いえに帰,かえったのは、この取税人,しゅぜいにんであって、あのパリサイ人,びとではなかった。おおよそ、自分,じぶんを高,たかくする者,ものは低,ひくくされ、自分,じぶんを低,ひくくする者,ものは高,たかくされるであろう」。","tok":[["あなた"],["がた"],["に"],["言って","いって"],["おく"],["。"],["神","かみ"],["に"],["義","ぎ"],["と"],["されて"],["自分","じぶん"],["の"],["家","いえ"],["に"],["帰えった","かえった"],["の"],["は"],["、"],["この"],["取","とり"],["税人","ぜいにん"],["ぜ"],["い"],["に"],["ん"],["で"],["あって"],["、"],["あの"],["パリサイ"],["人","びと"],["で"],["は"],["なかった"],["。"],["おおよそ"],["、"],["自分","じぶん"],["を"],["高かく","たかく"],["する"],["者","もの"],["は"],["低く","ひくく"],["され"],["、"],["自分","じぶん"],["を"],["低く","ひくく"],["する"],["者","もの"],["は"],["高かく","たかく"],["されるで"],["あろう"],["」"],["。"]]},{"verse":15,"text":"イエスにさわっていただくために、人々,ひとびとが幼,おさな子,ごらをみもとに連,つれてきた。ところが、弟子,でしたちはそれを見,みて、彼,かれらをたしなめた。","tok":[["イエス"],["に"],["さわって"],["いただく"],["ため"],["に"],["、"],["人々","ひとびと"],["が"],["幼な子","おさなご"],["ら"],["を"],["みもと"],["に"],["連れて","つれて"],["きた"],["。"],["ところ"],["が"],["、"],["弟子","でし"],["たち"],["は"],["それ"],["を"],["見て","みて"],["、"],["彼","かれ"],["ら"],["を"],["たしなめた"],["。"]]},{"verse":16,"text":"するとイエスは幼,おさな子,ごらを呼,よび寄,よせて言,いわれた、「幼,おさな子,ごらをわたしのところに来,くるままにしておきなさい、止,とめてはならない。神,かみの国,くにはこのような者,ものの国,くにである。","tok":[["する"],["と"],["イエス"],["は"],["幼な子","おさなご"],["ら"],["を"],["呼び寄せて","よびよせて"],["言われた","いわれた"],["、"],["「"],["幼な子","おさなご"],["ら"],["を"],["わたし"],["の"],["ところ"],["に"],["来る","くる"],["まま"],["に"],["して"],["おき"],["なさい"],["、"],["止","とめ"],["ては"],["ならない"],["。"],["神","かみ"],["の"],["国","くに"],["は"],["この"],["よう"],["な"],["者","もの"],["の"],["国","くに"],["で"],["ある"],["。"]]},{"verse":17,"text":"よく聞,きいておくがよい。だれでも幼,おさな子,ごのように神,かみの国,くにを受,うけいれる者,ものでなければ、そこにはいることは決,けっしてできない」。","tok":[["よく"],["聞いて","きいて"],["おく"],["が"],["よい"],["。"],["だれ"],["で"],["も"],["幼な子","おさなご"],["の"],["よう"],["に"],["神","かみ"],["の"],["国","くに"],["を"],["受","うけ"],["いれる"],["者","もの"],["で"],["なければ"],["、"],["そこ"],["に"],["はいる"],["こと"],["は"],["決っして","けっして"],["できない"],["」"],["。"]]},{"verse":18,"text":"また、ある役人,やくにんがイエスに尋,たずねた、「よき師,しよ、何,なにをしたら永遠,えいえんの生命,せいめいが受,うけられましょうか」。","tok":[["また"],["、"],["ある"],["役人","やくにん"],["が"],["イエス"],["に"],["尋ねた","たずねた"],["、"],["「"],["よき"],["師","し"],["よ"],["、"],["何に","なに"],["を"],["したら"],["永遠","えいえん"],["の"],["生命","せいめい"],["が"],["受られましょう","うけられましょう"],["か"],["」"],["。"]]},{"verse":19,"text":"イエスは言,いわれた、「なぜわたしをよき者,ものと言,いうのか。神,かみひとりのほかによい者,ものはいない。","tok":[["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["なぜ"],["わたし"],["を"],["よき"],["者","もの"],["と"],["言う","いう"],["の"],["か"],["。"],["神","かみ"],["ひとり"],["の"],["ほか"],["に"],["よい"],["者","もの"],["は"],["いない"],["。"]]},{"verse":20,"text":"いましめはあなたの知,しっているとおりである、『姦淫,かんいんするな、殺,ころすな、盗,ぬすむな、偽証,ぎしょうを立,たてるな、父,ちちと母,ははとを敬,うやまえ』」。","tok":[["いましめ"],["は"],["あなた"],["の"],["知って","しって"],["いる"],["とおり"],["で"],["ある"],["、"],["『"],["姦淫","かんいん"],["する"],["な"],["、"],["殺ろす","ころす"],["な"],["、"],["盗む","ぬすむ"],["な"],["、"],["偽証","ぎしょう"],["を"],["立る","たてる"],["な"],["、"],["父","ちち"],["と"],["母","はは"],["と"],["を"],["敬え","うやまえ"],["』"],["」"],["。"]]},{"verse":21,"text":"すると彼,かれは言,いった、「それらのことはみな、小,ちいさい時,ときから守,まもっております」。","tok":[["する"],["と"],["彼","かれ"],["は"],["言った","いった"],["、"],["「"],["それ"],["ら"],["の"],["こと"],["は"],["みな"],["、"],["小さい","ちいさい"],["時","とき"],["から"],["守って","まもって"],["おります"],["」"],["。"]]},{"verse":22,"text":"イエスはこれを聞,きいて言,いわれた、「あなたのする事,ことがまだ一つ残,のこっている。持,もっているものをみな売,うり払,はらって、貧,まずしい人々,ひとびとに分,わけてやりなさい。そうすれば、天,てんに宝,たからを持,もつようになろう。そして、わたしに従,したがってきなさい」。","tok":[["イエス"],["は"],["これ"],["を"],["聞いて","きいて"],["言われた","いわれた"],["、"],["「"],["あなた"],["の"],["する"],["事","こと"],["が"],["まだ"],["一","ひと"],["つ"],["残って","のこって"],["いる"],["。"],["持て","もって"],["いる"],["もの"],["を"],["みな"],["売払って","うりはらって"],["、"],["貧しい","まずしい"],["人々","ひとびと"],["に"],["分けて","わけて"],["やり"],["なさい"],["。"],["そう"],["すれば"],["、"],["天","てん"],["に"],["宝","たから"],["を"],["持つ","もつ"],["よう"],["に"],["なろう"],["。"],["そして"],["、"],["わたし"],["に"],["従って","したがって"],["き"],["なさい"],["」"],["。"]]},{"verse":23,"text":"彼,かれはこの言葉,ことばを聞,きいて非常,ひじょうに悲,かなしんだ。大金持,おおがねもちであったからである。","tok":[["彼","かれ"],["は"],["この"],["言葉","ことば"],["を"],["聞いて","きいて"],["非常","ひじょう"],["に"],["悲しんだ","かなしんだ"],["。"],["大金持","おおがねもち"],["で"],["あった"],["から"],["で"],["ある"],["。"]]},{"verse":24,"text":"イエスは彼,かれの様子,ようすを見,みて言,いわれた、「財産,ざいさんのある者,ものが神,かみの国,くににはいるのはなんとむずかしいことであろう。","tok":[["イエス"],["は"],["彼","かれ"],["の"],["様子","ようす"],["を"],["見て","みて"],["言われた","いわれた"],["、"],["「"],["財産","ざいさん"],["の"],["ある"],["者","もの"],["が"],["神","かみ"],["の"],["国","くに"],["に"],["は"],["いる"],["の"],["は"],["なん"],["と"],["むずかしい"],["こと"],["で"],["あろう"],["。"]]},{"verse":25,"text":"富,とんでいる者,ものが神,かみの国,くににはいるよりは、らくだが針,はりの穴,あなを通,とおる方,ほうが、もっとやさしい」。","tok":[["富","とん"],["で"],["いる"],["者","もの"],["が"],["神","かみ"],["の"],["国","くに"],["に"],["は"],["いる"],["より"],["は"],["、"],["らくだ"],["が"],["針","はり"],["の"],["穴","あな"],["を"],["通る","とおる"],["方","ほう"],["が"],["、"],["もっと"],["やさしい"],["」"],["。"]]},{"verse":26,"text":"これを聞,きいた人々,ひとびとが、「それでは、だれが救,すくわれることができるのですか」と尋,たずねると、","tok":[["これ"],["を"],["聞いた","きいた"],["人々","ひとびと"],["が"],["、"],["「"],["それ"],["で"],["は"],["、"],["だれ"],["が"],["救われる","すくわれる"],["こと"],["が"],["できる"],["の"],["です"],["か"],["」"],["と"],["尋ねる","たずねる"],["と"],["、"]]},{"verse":27,"text":"イエスは言,いわれた、「人,ひとにはできない事,ことも、神,かみにはできる」。","tok":[["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["人","ひと"],["に"],["は"],["できない"],["事","こと"],["も"],["、"],["神","かみ"],["に"],["は"],["できる"],["」"],["。"]]},{"verse":28,"text":"ペテロが言,いった、「ごらんなさい、わたしたちは自分,じぶんのものを捨,すてて、あなたに従,したがいました」。","tok":[["ペテロ"],["が"],["言った","いった"],["、"],["「"],["ごらん"],["なさい"],["、"],["わたしたち"],["は"],["自分","じぶん"],["の"],["もの"],["を"],["捨てて","すてて"],["、"],["あなた"],["に"],["従いました","したがいました"],["」"],["。"]]},{"verse":29,"text":"イエスは言,いわれた、「よく聞,きいておくがよい。だれでも神,かみの国,くにのために、家,いえ、妻,つま、兄弟,きょうだい、両親,りょうしん、子,こを捨,すてた者,ものは、","tok":[["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["よく"],["聞いて","きいて"],["おく"],["が"],["よい"],["。"],["だれ"],["で"],["も"],["神","かみ"],["の"],["国","くに"],["の"],["ため"],["に"],["、"],["家","いえ"],["、"],["妻","つま"],["、"],["兄弟","きょうだい"],["、"],["両親","りょうしん"],["、"],["子","こ"],["を"],["捨てた","すてた"],["者","もの"],["は"],["、"]]},{"verse":30,"text":"必,かならずこの時代,じだいではその幾,いく倍,ばいもを受,うけ、また、きたるべき世,よでは永遠,えいえんの生命,せいめいを受,うけるのである」。","tok":[["必","かならず"],["この"],["時代","じだい"],["で"],["は"],["その"],["幾","いく"],["倍","ばい"],["も"],["を"],["受け","うけ"],["、"],["また"],["、"],["きたるべき"],["世","よ"],["で"],["は"],["永遠","えいえん"],["の"],["生命","せいめい"],["を"],["受る","うける"],["ので"],["ある"],["」"],["。"]]},{"verse":31,"text":"イエスは十二弟子,でしを呼,よび寄,よせて言,いわれた、「見,みよ、わたしたちはエルサレムへ上,のぼって行,いくが、人,ひとの子,こについて預言者,よげんしゃたちがしるしたことは、すべて成就,じょうじゅするであろう。","tok":[["イエス"],["は"],["十二","じゅうに"],["弟子","でし"],["を"],["呼び寄せて","よびよせて"],["言われた","いわれた"],["、"],["「"],["見よ","みよ"],["、"],["わたしたち"],["は"],["エルサレム"],["へ"],["上って","のぼって"],["行く","いく"],["が"],["、"],["人","ひと"],["の"],["子","こ"],["について"],["預言者","よげんしゃ"],["たち"],["が"],["しるした"],["こと"],["は"],["、"],["すべて"],["成就","じょうじゅ"],["するで"],["あろう"],["。"]]},{"verse":32,"text":"人,ひとの子,こは異邦人,いほうじんに引,ひきわたされ、あざけられ、はずかしめを受,うけ、つばきをかけられ、","tok":[["人","ひと"],["の"],["子","こ"],["は"],["異邦人","いほうじん"],["に"],["引","ひき"],["わたされ"],["、"],["あざけられ"],["、"],["はずかしめ"],["を"],["受け","うけ"],["、"],["つばき"],["を"],["かけられ"],["、"]]},{"verse":33,"text":"また、むち打,うたれてから、ついに殺,ころされ、そして三日,か目,めによみがえるであろう」。","tok":[["また"],["、"],["むち打たれて","むちうたれて"],["から"],["、"],["ついに"],["殺ろされ","ころされ"],["、"],["そして"],["三日目","かめ"],["に"],["よみがえるで"],["あろう"],["」"],["。"]]},{"verse":34,"text":"弟子,でしたちには、これらのことが何一,なにひとつわからなかった。この言葉,ことばが彼,かれらに隠,かくされていたので、イエスの言,いわれた事,ことが理解,りかいできなかった。","tok":[["弟子","でし"],["たち"],["に"],["は"],["、"],["これ"],["ら"],["の"],["こと"],["が"],["何","なん"],["一","いち"],["に"],["ひと"],["つ"],["わからなかった"],["。"],["この"],["言葉","ことば"],["が"],["彼","かれ"],["ら"],["に"],["隠されて","かくされて"],["いた"],["ので"],["、"],["イエス"],["の"],["言われた","いわれた"],["事","こと"],["が"],["理解","りかい"],["できなかった"],["。"]]},{"verse":35,"text":"イエスがエリコに近,ちかづかれたとき、ある盲人,もうじんが道,みちばたにすわって、物,ものごいをしていた。","tok":[["イエス"],["が"],["エリコ"],["に"],["近づかれた","ちかづかれた"],["とき"],["、"],["ある"],["盲人","もうじん"],["が"],["道ばた","みちばた"],["に"],["すわって"],["、"],["物ごい","ものごい"],["を"],["して"],["いた"],["。"]]},{"verse":36,"text":"群衆,ぐんしゅうが通,とおり過,すぎる音,おとを耳,みみにして、彼,かれは何事,なにごとがあるのかと尋,たずねた。","tok":[["群衆","ぐんしゅう"],["が"],["通り","とおり"],["過る","すぎる"],["音","おと"],["を"],["耳","みみ"],["に"],["して"],["、"],["彼","かれ"],["は"],["何事","なにごと"],["が"],["ある"],["の"],["か"],["と"],["尋ねた","たずねた"],["。"]]},{"verse":37,"text":"ところが、ナザレのイエスがお通,とおりなのだと聞,きかされたので、","tok":[["ところ"],["が"],["、"],["ナザレ"],["の"],["イエス"],["が"],["お通り","おとおり"],["な"],["の"],["だ"],["と"],["聞かされた","きかされた"],["ので"],["、"]]},{"verse":38,"text":"声,こえをあげて、「ダビデの子,こイエスよ、わたしをあわれんで下,ください」と言,いった。","tok":[["声","こえ"],["を"],["あげて"],["、"],["「"],["ダビデ"],["の"],["子","こ"],["イエス"],["よ"],["、"],["わたし"],["を"],["あわれんで"],["下さい","ください"],["」"],["と"],["言った","いった"],["。"]]},{"verse":39,"text":"先頭,せんとうに立,たつ人々,ひとびとが彼,かれをしかって黙,だまらせようとしたが、彼,かれはますます激,はげしく叫,さけびつづけた、「ダビデの子,こよ、わたしをあわれんで下,ください」。","tok":[["先頭","せんとう"],["に"],["立つ","たつ"],["人々","ひとびと"],["が"],["彼","かれ"],["を"],["しかって"],["黙らせよう","だまらせよう"],["と"],["した"],["が"],["、"],["彼","かれ"],["は"],["ますます"],["激しく","はげしく"],["叫","さけび"],["つづけた"],["、"],["「"],["ダビデ"],["の"],["子","こ"],["よ"],["、"],["わたし"],["を"],["あわれんで"],["下さい","ください"],["」"],["。"]]},{"verse":40,"text":"そこでイエスは立,たちどまって、その者,ものを連,つれて来,くるように、とお命,めいじになった。彼,かれが近,ちかづいたとき、","tok":[["そこ"],["で"],["イエス"],["は"],["立ちどまって","たちどまって"],["、"],["その"],["者","もの"],["を"],["連れて","つれて"],["来る","くる"],["よう"],["に"],["、"],["と"],["お命じ","おめいじ"],["に"],["なった"],["。"],["彼","かれ"],["が"],["近づいた","ちかづいた"],["とき"],["、"]]},{"verse":41,"text":"「わたしに何,なにをしてほしいのか」とおたずねになると、「主,しゅよ、見,みえるようになることです」と答,こたえた。","tok":[["「"],["わたし"],["に"],["何に","なに"],["を"],["して"],["ほしい"],["の"],["か"],["」"],["と"],["おたずね"],["に"],["なる"],["と"],["、"],["「"],["主","しゅ"],["よ"],["、"],["見える","みえる"],["よう"],["に"],["なる"],["こと"],["です"],["」"],["と"],["答","こたえ"],["た"],["。"]]},{"verse":42,"text":"そこでイエスは言,いわれた、「見,みえるようになれ。あなたの信仰,しんこうがあなたを救,すくった」。","tok":[["そこ"],["で"],["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["見える","みえる"],["よう"],["に"],["なれ"],["。"],["あなた"],["の"],["信仰","しんこう"],["が"],["あなた"],["を"],["救った","すくった"],["」"],["。"]]},{"verse":43,"text":"すると彼,かれは、たちまち見,みえるようになった。そして神,かみをあがめながらイエスに従,したがって行,いった。これを見,みて、人々,ひとびとはみな神,かみをさんびした。","tok":[["する"],["と"],["彼","かれ"],["は"],["、"],["たちまち"],["見える","みえる"],["よう"],["に"],["なった"],["。"],["そして"],["神","かみ"],["を"],["あがめ"],["ながら"],["イエス"],["に"],["従って","したがって"],["行った","いった"],["。"],["これ"],["を"],["見て","みて"],["、"],["人々","ひとびと"],["は"],["みな"],["神","かみ"],["を"],["さん"],["び"],["した"],["。"]]}]
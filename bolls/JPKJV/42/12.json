[{"verse":1,"text":"その間,あいだに、おびただしい群衆,ぐんしゅうが、互,たがいに踏,ふみ合,あうほどに群,むらがってきたが、イエスはまず弟子,でしたちに語,かたりはじめられた、「パリサイ人,びとのパン種,だね、すなわち彼,かれらの偽善,ぎぜんに気,きをつけなさい。","tok":[["その"],["間","あいだ"],["に"],["、"],["おびただしい"],["群衆","ぐんしゅう"],["が"],["、"],["互","たがい"],["に"],["踏み合う","ふみあう"],["ほど"],["に"],["群らがって","むらがって"],["きた"],["が"],["、"],["イエス"],["は"],["まず"],["弟子","でし"],["たち"],["に"],["語り","かたり"],["はじめられた"],["、"],["「"],["パリサイ"],["人","びと"],["の"],["パン種","ぱんだね"],["、"],["すなわち"],["彼","かれ"],["ら"],["の"],["偽善","ぎぜん"],["に"],["気","き"],["を"],["つけ"],["なさい"],["。"]]},{"verse":2,"text":"おおいかぶされたもので、現,あらわれてこないものはなく、隠,かくれているもので、知,しられてこないものはない。","tok":[["おおいかぶされた"],["もの"],["で"],["、"],["現われて","あらわれて"],["こない"],["もの"],["は"],["なく"],["、"],["隠れて","かくれて"],["いる"],["もの"],["で"],["、"],["知られて","しられて"],["こない"],["もの"],["は"],["ない"],["。"]]},{"verse":3,"text":"だから、あなたがたが暗,くらやみで言,いったことは、なんでもみな明,あかるみで聞,きかれ、密室,みっしつで耳,みみにささやいたことは、屋根,やねの上,うえで言,いいひろめられるであろう。","tok":[["だ"],["から"],["、"],["あなた"],["がた"],["が"],["暗やみ","くらやみ"],["で"],["言った","いった"],["こと"],["は"],["、"],["なん"],["で"],["も"],["みな"],["明かるみ","あかるみ"],["で"],["聞かれ","きかれ"],["、"],["密室","みっしつ"],["で"],["耳","みみ"],["に"],["ささやいた"],["こと"],["は"],["、"],["屋根","やね"],["の"],["上","うえ"],["で"],["言い","いい"],["ひろめられるで"],["あろう"],["。"]]},{"verse":4,"text":"そこでわたしの友,ともであるあなたがたに言,いうが、からだを殺,ころしても、そのあとでそれ以上,いじょうなにもできない者,ものどもを恐,おそれるな。","tok":[["そこ"],["で"],["わたし"],["の"],["友","とも"],["で"],["ある"],["あなた"],["がた"],["に"],["言う","いう"],["が"],["、"],["からだ"],["を"],["殺ろして","ころして"],["も"],["、"],["その"],["あと"],["で"],["それ"],["以上","いじょう"],["なに"],["も"],["できない"],["者","もの"],["ども"],["を"],["恐れる","おそれる"],["な"],["。"]]},{"verse":5,"text":"恐,おそるべき者,ものがだれであるか、教,おしえてあげよう。殺,ころしたあとで、更,さらに地獄,じごくに投,なげ込,こむ権威,けんいのあるかたを恐,おそれなさい。そうだ、あなたがたに言,いっておくが、そのかたを恐,おそれなさい。","tok":[["恐るべき","おそるべき"],["者","もの"],["が"],["だれ"],["で"],["ある"],["か"],["、"],["教て","おしえて"],["あげよう"],["。"],["殺ろした","ころした"],["あと"],["で"],["、"],["更に","さらに"],["地獄","じごく"],["に"],["投込む","なげこむ"],["権威","けんい"],["の"],["ある"],["かた"],["を"],["恐れ","おそれ"],["なさい"],["。"],["そう"],["だ"],["、"],["あなた"],["がた"],["に"],["言って","いって"],["おく"],["が"],["、"],["その"],["かた"],["を"],["恐れ","おそれ"],["なさい"],["。"]]},{"verse":6,"text":"五羽,わのすずめは二アサリオンで売,うられているではないか。しかも、その一羽,わも神,かみのみまえで忘,わすれられてはいない。","tok":[["五羽","わ"],["の"],["すずめ"],["は"],["二","に"],["アサリオン"],["で"],["売られて","うられて"],["いるで"],["は"],["ない"],["か"],["。"],["しかも"],["、"],["その"],["一羽","わ"],["も"],["神","かみ"],["のみ"],["まえ"],["で"],["忘られて","わすれられて"],["は"],["いない"],["。"]]},{"verse":7,"text":"その上,うえ、あなたがたの頭,あたまの毛,けまでも、みな数,かぞえられている。恐,おそれることはない。あなたがたは多,おおくのすずめよりも、まさった者,ものである。","tok":[["その"],["上","うえ"],["、"],["あなた"],["がた"],["の"],["頭","あたま"],["の"],["毛","け"],["まで"],["も"],["、"],["みな"],["数えられて","かぞえられて"],["いる"],["。"],["恐れる","おそれる"],["こと"],["は"],["ない"],["。"],["あなた"],["がた"],["は"],["多く","おおく"],["の"],["すずめ"],["より"],["も"],["、"],["まさった"],["者","もの"],["で"],["ある"],["。"]]},{"verse":8,"text":"そこで、あなたがたに言,いう。だれでも人,ひとの前,まえでわたしを受,うけいれる者,ものを、人,ひとの子,こも神,かみの使,つかいたちの前,まえで受,うけいれるであろう。","tok":[["そこ"],["で"],["、"],["あなた"],["がた"],["に"],["言う","いう"],["。"],["だれ"],["で"],["も"],["人","ひと"],["の"],["前","まえ"],["で"],["わたし"],["を"],["受","うけ"],["いれる"],["者","もの"],["を"],["、"],["人","ひと"],["の"],["子","こ"],["も"],["神","かみ"],["の"],["使","つかい"],["たち"],["の"],["前","まえ"],["で"],["受","うけ"],["いれるで"],["あろう"],["。"]]},{"verse":9,"text":"しかし、人,ひとの前,まえでわたしを拒,こばむ者,ものは、神,かみの使,つかいたちの前,まえで拒,こばまれるであろう。","tok":[["しかし"],["、"],["人","ひと"],["の"],["前","まえ"],["で"],["わたし"],["を"],["拒む","こばむ"],["者","もの"],["は"],["、"],["神","かみ"],["の"],["使","つかい"],["たち"],["の"],["前","まえ"],["で"],["拒まれるで","こばまれるで"],["あろう"],["。"]]},{"verse":10,"text":"また、人,ひとの子,こに言,いい逆,さからう者,ものはゆるされるであろうが、聖霊,せいれいをけがす者,ものは、ゆるされることはない。","tok":[["また"],["、"],["人","ひと"],["の"],["子","こ"],["に"],["言い","いい"],["逆らう","さからう"],["者","もの"],["は"],["ゆるされるで"],["あろう"],["が"],["、"],["聖霊","せいれい"],["を"],["けがす"],["者","もの"],["は"],["、"],["ゆるされる"],["こと"],["は"],["ない"],["。"]]},{"verse":11,"text":"あなたがたが会堂,かいどうや役人,やくにんや高官,こうかんの前,まえへひっぱられて行,いった場合,ばあいには、何,なにをどう弁明,べんめいしようか、何,なにを言,いおうかと心配,しんぱいしないがよい。","tok":[["あなた"],["がた"],["が"],["会堂","かいどう"],["や"],["役人","やくにん"],["や"],["高官","こうかん"],["の"],["前","まえ"],["へ"],["ひっぱられて"],["行った","いった"],["場合","ばあい"],["に"],["は"],["、"],["何に","なに"],["を"],["どう"],["弁明","べんめい"],["しよう"],["か"],["、"],["何に","なに"],["を"],["言おう","いおう"],["か"],["と"],["心配","しんぱい"],["しない"],["が"],["よい"],["。"]]},{"verse":12,"text":"言,いうべきことは、聖霊,せいれいがその時,ときに教,おしえてくださるからである」。","tok":[["言","いうべきこ"],["と"],["は"],["、"],["聖霊","せいれい"],["が"],["その"],["時","とき"],["に"],["教えて","おしえて"],["くださる"],["から"],["で"],["ある"],["」"],["。"]]},{"verse":13,"text":"群衆,ぐんしゅうの中,なかのひとりがイエスに言,いった、「先生,せんせい、わたしの兄弟,きょうだいに、遺産,いさんを分,わけてくれるようにおっしゃってください」。","tok":[["群衆","ぐんしゅう"],["の"],["中","なか"],["の"],["ひとり"],["が"],["イエス"],["に"],["言った","いった"],["、"],["「"],["先生","せんせい"],["、"],["わたし"],["の"],["兄弟","きょうだい"],["に"],["、"],["遺産","いさん"],["を"],["分けて","わけて"],["くれる"],["よう"],["に"],["おっしゃって"],["ください"],["」"],["。"]]},{"verse":14,"text":"彼,かれに言,いわれた、「人,ひとよ、だれがわたしをあなたがたの裁判人,さいばんにんまたは分配,ぶんぱい人,にんに立,たてたのか」。","tok":[["彼","かれ"],["に"],["言われた","いわれた"],["、"],["「"],["人","ひと"],["よ"],["、"],["だれ"],["が"],["わたし"],["を"],["あなた"],["がた"],["の"],["裁判人","さいばんにん"],["また"],["は"],["分配人","ぶんぱいにん"],["に"],["立てた","たてた"],["の"],["か"],["」"],["。"]]},{"verse":15,"text":"それから人々,ひとびとにむかって言,いわれた、「あらゆる貪欲,どんよくに対,たいしてよくよく警戒,けいかいしなさい。たといたくさんの物,ものを持,もっていても、人,ひとのいのちは、持,もち物,ものにはよらないのである」。","tok":[["それ"],["から"],["人々","ひとびと"],["に"],["むかって"],["言われた","いわれた"],["、"],["「"],["あらゆる"],["貪欲","どんよく"],["に対して","にたいして"],["よくよく"],["警戒","けいかい"],["し"],["なさい"],["。"],["たとい"],["たくさん"],["の"],["物","もの"],["を"],["持って","もって"],["いて"],["も"],["、"],["人","ひと"],["の"],["いのち"],["は"],["、"],["持物","もちもの"],["に"],["は"],["よらない"],["ので"],["ある"],["」"],["。"]]},{"verse":16,"text":"そこで一つの譬,たとえを語,かたられた、「ある金持,かねもちの畑,はたけが豊作,ほうさくであった。","tok":[["そこ"],["で"],["一","ひと"],["つ"],["の"],["譬","たとえ"],["を"],["語られた","かたられた"],["、"],["「"],["ある"],["金持","かねもち"],["の"],["畑","はたけ"],["が"],["豊作","ほうさく"],["で"],["あった"],["。"]]},{"verse":17,"text":"そこで彼,かれは心,こころの中,なかで、『どうしようか、わたしの作物,さくもつをしまっておく所,ところがないのだが』と思,おもいめぐらして","tok":[["そこ"],["で"],["彼","かれ"],["は"],["心","こころ"],["の"],["中","なか"],["で"],["、"],["『"],["どう"],["しよう"],["か"],["、"],["わたし"],["の"],["作物","さくもつ"],["を"],["しまって"],["おく"],["所","ところ"],["が"],["ない"],["の"],["だ"],["が"],["』"],["と"],["思いめぐらして","おもいめぐらして"]]},{"verse":18,"text":"言,いった、『こうしよう。わたしの倉,くらを取,とりこわし、もっと大,おおきいのを建,たてて、そこに穀物,こくもつや食糧,しょくりょうを全部,ぜんぶしまい込,こもう。","tok":[["言った","いった"],["、"],["『"],["こう"],["しよう"],["。"],["わたし"],["の"],["倉","くら"],["を"],["取","とり"],["こわし"],["、"],["もっと"],["大きい","おおきい"],["の"],["を"],["建てて","たてて"],["、"],["そこ"],["に"],["穀物","こくもつ"],["や"],["食糧","しょくりょう"],["を"],["全部","ぜんぶ"],["しまい込もう","しまいこもう"],["。"]]},{"verse":19,"text":"そして自分,じぶんの魂,たましいに言,いおう。たましいよ、おまえには長年,ながねん分,ぶんの食糧,しょくりょうがたくさんたくわえてある。さあ安心,あんしんせよ、食,くえ、飲,のめ、楽,たのしめ』。","tok":[["そして"],["自分","じぶん"],["の"],["魂","たましい"],["に"],["言おう","いおう"],["。"],["たましい"],["よ"],["、"],["おまえ"],["に"],["は"],["長年","ながねん"],["分","ぶん"],["の"],["食糧","しょくりょう"],["が"],["たくさん"],["たくわえて"],["ある"],["。"],["さあ"],["安心","あんしん"],["せよ"],["、"],["食え","くえ"],["、"],["飲め","のめ"],["、"],["楽め","たのしめ"],["』"],["。"]]},{"verse":20,"text":"すると神,かみが彼,かれに言,いわれた、『愚,おろかな者,ものよ、あなたの魂,たましいは今夜,こんやのうちにも取,とり去,さられるであろう。そしたら、あなたが用意,よういした物,ものは、だれのものになるのか』。","tok":[["する"],["と"],["神","かみ"],["が"],["彼","かれ"],["に"],["言われた","いわれた"],["、"],["『"],["愚か","おろか"],["な"],["者","もの"],["よ"],["、"],["あなた"],["の"],["魂","たましい"],["は"],["今夜","こんや"],["の"],["うち"],["に"],["も"],["取去られるで","とりさられるで"],["あろう"],["。"],["そ"],["したら"],["、"],["あなた"],["が"],["用意","ようい"],["した"],["物","もの"],["は"],["、"],["だれ"],["の"],["もの"],["に"],["なる"],["の"],["か"],["』"],["。"]]},{"verse":21,"text":"自分,じぶんのために宝,たからを積,つんで神,かみに対,たいして富,とまない者,ものは、これと同,おなじである」。","tok":[["自分","じぶん"],["の"],["ため"],["に"],["宝","たから"],["を"],["積んで","つんで"],["神","かみ"],["に対して","にたいして"],["富まない","とまない"],["者","もの"],["は"],["、"],["これ"],["と"],["同じ","おなじ"],["で"],["ある"],["」"],["。"]]},{"verse":22,"text":"それから弟子,でしたちに言,いわれた、「それだから、あなたがたに言,いっておく。何,なにを食,たべようかと、命,いのちのことで思,おもいわずらい、何,なにを着,きようかとからだのことで思,おもいわずらうな。","tok":[["それ"],["から"],["弟子","でし"],["たち"],["に"],["言われた","いわれた"],["、"],["「"],["それ"],["だ"],["から"],["、"],["あなた"],["がた"],["に"],["言って","いって"],["おく"],["。"],["何に","なに"],["を"],["食べよう","たべよう"],["か"],["と"],["、"],["命","いのち"],["の"],["こと"],["で"],["思いわずらい","おもいわずらい"],["、"],["何に","なに"],["を"],["着よう","きよう"],["か"],["と"],["からだ"],["の"],["こと"],["で"],["思いわずらう","おもいわずらう"],["な"],["。"]]},{"verse":23,"text":"命,いのちは食物,しょくもつにまさり、からだは着物,きものにまさっている。","tok":[["命","いのち"],["は"],["食物","しょくもつ"],["に"],["まさり"],["、"],["からだ"],["は"],["着物","きもの"],["に"],["まさって"],["いる"],["。"]]},{"verse":24,"text":"からすのことを考,かんがえて見,みよ。まくことも、刈,かることもせず、また、納屋,なやもなく倉,くらもない。それだのに、神,かみは彼,かれらを養,やしなっていて下,くださる。あなたがたは鳥,とりよりも、はるかにすぐれているではないか。","tok":[["からす"],["の"],["こと"],["を"],["考","かんがえ"],["て"],["見","み"],["よ"],["。"],["まく"],["こと"],["も"],["、"],["刈る","かる"],["こと"],["も"],["せず"],["、"],["また"],["、"],["納屋","なや"],["も"],["なく"],["倉","くら"],["も"],["ない"],["。"],["それ"],["だ"],["のに"],["、"],["神","かみ"],["は"],["彼","かれ"],["ら"],["を"],["養って","やしなって"],["いて"],["下さる","くださる"],["。"],["あなた"],["がた"],["は"],["鳥","とり"],["より"],["も"],["、"],["はるか"],["に"],["すぐれて"],["いるで"],["は"],["ない"],["か"],["。"]]},{"verse":25,"text":"あなたがたのうち、だれが思,おもいわずらったからとて、自分,じぶんの寿命,じゅみょうをわずかでも延,のばすことができようか。","tok":[["あなた"],["がた"],["の"],["うち"],["、"],["だれ"],["が"],["思いわずらった","おもいわずらった"],["から"],["とて"],["、"],["自分","じぶん"],["の"],["寿命","じゅみょう"],["を"],["わずか"],["で"],["も"],["延ばす","のばす"],["こと"],["が"],["できよう"],["か"],["。"]]},{"verse":26,"text":"そんな小,ちいさな事,ことさえできないのに、どうしてほかのことを思,おもいわずらうのか。","tok":[["そんな"],["小さな","ちいさな"],["事","こと"],["さえ"],["できない"],["のに"],["、"],["どう"],["して"],["ほか"],["の"],["こと"],["を"],["思いわずらう","おもいわずらう"],["の"],["か"],["。"]]},{"verse":27,"text":"野,のの花,はなのことを考,かんがえて見,みるがよい。紡,つむぎもせず、織,おりもしない。しかし、あなたがたに言,いうが、栄華,えいがをきわめた時,ときのソロモンでさえ、この花,はなの一つほどにも着飾,きかざってはいなかった。","tok":[["野","の"],["の"],["花","はな"],["の"],["こと"],["を"],["考","かんがえ"],["て"],["見る","みる"],["が"],["よい"],["。"],["紡ぎ","つむぎ"],["も"],["せず"],["、"],["織","おり"],["も"],["しない"],["。"],["しかし"],["、"],["あなた"],["がた"],["に"],["言う","いう"],["が"],["、"],["栄華","えいが"],["を"],["きわめた"],["時","とき"],["の"],["ソロモン"],["で"],["さえ"],["、"],["この"],["花","はな"],["の"],["一","ひと"],["つ"],["ほど"],["に"],["も"],["着飾って","きかざって"],["は"],["いなかった"],["。"]]},{"verse":28,"text":"きょうは野,のにあって、あすは炉,ろに投,なげ入,いれられる草,くさでさえ、神,かみはこのように装,よそおって下,くださるのなら、あなたがたに、それ以上,いじょうよくしてくださらないはずがあろうか。ああ、信仰,しんこうの薄,うすい者,ものたちよ。","tok":[["きょう"],["は"],["野","の"],["に"],["あって"],["、"],["あす"],["は"],["炉","ろ"],["に"],["投入れられる","なげいれられる"],["草","くさ"],["で"],["さえ"],["、"],["神","かみ"],["は"],["この"],["よう"],["に"],["装って","よそおって"],["下さる","くださる"],["の"],["なら"],["、"],["あなた"],["がた"],["に"],["、"],["それ"],["以上","いじょう"],["よく"],["して"],["くださらない"],["はず"],["が"],["あろう"],["か"],["。"],["ああ"],["、"],["信仰","しんこう"],["の"],["薄い","うすい"],["者","もの"],["たち"],["よ"],["。"]]},{"verse":29,"text":"あなたがたも、何,なにを食,たべ、何,なにを飲,のもうかと、あくせくするな、また気,きを使,つかうな。","tok":[["あなた"],["がた"],["も"],["、"],["何に","なに"],["を"],["食べ","たべ"],["、"],["何に","なに"],["を"],["飲もう","のもう"],["か"],["と"],["、"],["あくせく"],["する"],["な"],["、"],["また"],["気","き"],["を"],["使う","つかう"],["な"],["。"]]},{"verse":30,"text":"これらのものは皆,みな、この世,よの異邦人,いほうじんが切,せつに求,もとめているものである。あなたがたの父,ちちは、これらのものがあなたがたに必要,ひつようであることを、ご存,ぞんじである。","tok":[["これ"],["ら"],["の"],["もの"],["は"],["皆","みな"],["、"],["この世","このよ"],["の"],["異邦人","いほうじん"],["が"],["切に","せつに"],["求めて","もとめて"],["いる"],["もの"],["で"],["ある"],["。"],["あなた"],["がた"],["の"],["父","ちち"],["は"],["、"],["これ"],["ら"],["の"],["もの"],["が"],["あなた"],["がた"],["に"],["必要","ひつよう"],["で"],["ある"],["こと"],["を"],["、"],["ご存じ","ごぞんじ"],["で"],["ある"],["。"]]},{"verse":31,"text":"ただ、御国,みくにを求,もとめなさい。そうすれば、これらのものは添,そえて与,あたえられるであろう。","tok":[["ただ"],["、"],["御国","みくに"],["を"],["求め","もとめ"],["なさい"],["。"],["そう"],["すれば"],["、"],["これ"],["ら"],["の"],["もの"],["は"],["添えて","そえて"],["与えられるで","あたえられるで"],["あろう"],["。"]]},{"verse":32,"text":"恐,おそれるな、小,ちいさい群,むれよ。御国,みくにを下,くださることは、あなたがたの父,ちちのみこころなのである。","tok":[["恐れる","おそれる"],["な"],["、"],["小さい","ちいさい"],["群れ","むれ"],["よ"],["。"],["御国","みくに"],["を"],["下さる","くださる"],["こと"],["は"],["、"],["あなた"],["がた"],["の"],["父","ちち"],["のみ"],["こころ"],["な"],["ので"],["ある"],["。"]]},{"verse":33,"text":"自分,じぶんの持,もち物,ものを売,うって、施,ほどこしなさい。自分,じぶんのために古,ふるびることのない財布,さいふをつくり、盗人,ぬすびとも近寄,ちかよらず、虫,むしも食,くい破,やぶらない天,てんに、尽,つきることのない宝,たからをたくわえなさい。","tok":[["自分","じぶん"],["の"],["持物","もちもの"],["を"],["売って","うって"],["、"],["施し","ほどこし"],["なさい"],["。"],["自分","じぶん"],["の"],["ため"],["に"],["古びる","ふるびる"],["こと"],["の"],["ない"],["財布","さいふ"],["を"],["つくり"],["、"],["盗人","ぬすびと"],["も"],["近寄らず","ちかよらず"],["、"],["虫","むし"],["も"],["食い破らない","くいやぶらない"],["天","てん"],["に"],["、"],["尽きる","つきる"],["こと"],["の"],["ない"],["宝","たから"],["を"],["たくわえ"],["なさい"],["。"]]},{"verse":34,"text":"あなたがたの宝,たからのある所,ところには、心,こころもあるからである。","tok":[["あなた"],["がた"],["の"],["宝","たから"],["の"],["ある"],["所","ところ"],["に"],["は"],["、"],["心","こころ"],["も"],["ある"],["から"],["で"],["ある"],["。"]]},{"verse":35,"text":"腰,こしに帯,おびをしめ、あかりをともしていなさい。","tok":[["腰","こし"],["に"],["帯","おび"],["を"],["しめ"],["、"],["あかり"],["を"],["ともして"],["い"],["なさい"],["。"]]},{"verse":36,"text":"主人,しゅじんが婚,こん宴,えんから帰,かえってきて戸,とをたたくとき、すぐあけてあげようと待,まっている人,ひとのようにしていなさい。","tok":[["主人","しゅじん"],["が"],["婚","こん"],["宴","えん"],["から"],["帰えって","かえって"],["きて"],["戸","と"],["を"],["たたく"],["とき"],["、"],["すぐ"],["あけて"],["あげよう"],["と"],["待って","まって"],["いる"],["人","ひと"],["の"],["よう"],["に"],["して"],["い"],["なさい"],["。"]]},{"verse":37,"text":"主人,しゅじんが帰,かえってきたとき、目,めを覚,さましているのを見,みられる僕,しもべたちは、さいわいである。よく言,いっておく。主人,しゅじんが帯,おびをしめて僕,しもべたちを食卓,しょくたくにつかせ、進,すすみ寄,よって給仕,きゅうじをしてくれるであろう。","tok":[["主人","しゅじん"],["が"],["帰えって","かえって"],["きた"],["とき"],["、"],["目","め"],["を"],["覚まして","さまして"],["いる"],["の"],["を"],["見られる","みられる"],["僕","し"],["も"],["べ"],["たち"],["は"],["、"],["さいわい"],["で"],["ある"],["。"],["よく"],["言って","いって"],["おく"],["。"],["主人","しゅじん"],["が"],["帯","おび"],["を"],["しめて"],["僕","し"],["も"],["べ"],["たち"],["を"],["食卓","しょくたく"],["に"],["つかせ"],["、"],["進み寄って","すすみよって"],["給仕","きゅうじ"],["を"],["して"],["くれるで"],["あろう"],["。"]]},{"verse":38,"text":"主人,しゅじんが夜中,よなかごろ、あるいは夜明,よあけごろに帰,かえってきても、そうしているのを見,みられるなら、その人,ひとたちはさいわいである。","tok":[["主人","しゅじん"],["が"],["夜","よる"],["中ごろ","なかごろ"],["、"],["あるいは"],["夜明","よあけ"],["ごろ"],["に"],["帰えって","かえって"],["きて"],["も"],["、"],["そう"],["して"],["いる"],["の"],["を"],["見られるなら","みられるなら"],["、"],["その"],["人","ひと"],["たち"],["は"],["さいわい"],["で"],["ある"],["。"]]},{"verse":39,"text":"このことを、わきまえているがよい。家,いえの主人,しゅじんは、盗賊,とうぞくがいつごろ来,くるかわかっているなら、自分,じぶんの家,いえに押,おし入,いらせはしないであろう。","tok":[["この"],["こと"],["を"],["、"],["わきまえて"],["いる"],["が"],["よい"],["。"],["家","いえ"],["の"],["主人","しゅじん"],["は"],["、"],["盗賊","とうぞく"],["が"],["いつごろ"],["来る","くる"],["か"],["わかって"],["いるなら"],["、"],["自分","じぶん"],["の"],["家","いえ"],["に"],["押入らせ","おしいらせ"],["は"],["しないで"],["あろう"],["。"]]},{"verse":40,"text":"あなたがたも用意,よういしていなさい。思,おもいがけない時,ときに人,ひとの子,こが来,くるからである」。","tok":[["あなた"],["がた"],["も"],["用意","ようい"],["して"],["い"],["なさい"],["。"],["思いがけない","おもいがけない"],["時","とき"],["に"],["人","ひと"],["の"],["子","こ"],["が"],["来る","くる"],["から"],["で"],["ある"],["」"],["。"]]},{"verse":41,"text":"するとペテロが言,いった、「主,しゅよ、この譬,たとえを話,はなしておられるのはわたしたちのためなのですか。それとも、みんなの者,もののためなのですか」。","tok":[["する"],["と"],["ペテロ"],["が"],["言った","いった"],["、"],["「"],["主","しゅ"],["よ"],["、"],["この"],["譬","たとえ"],["を"],["話","はなし"],["て"],["おられる"],["の"],["は"],["わたしたち"],["の"],["ため"],["な"],["の"],["です"],["か"],["。"],["それ"],["と"],["も"],["、"],["みんな"],["の"],["者","もの"],["の"],["ため"],["な"],["の"],["です"],["か"],["」"],["。"]]},{"verse":42,"text":"そこで主,しゅが言,いわれた、「主人,しゅじんが、召使,めしつかいたちの上,うえに立,たてて、時,ときに応,おうじて定,さだめの食事,しょくじをそなえさせる忠実,ちゅうじつな思慮,しりょ深,ぶかい家令,かれいは、いったいだれであろう。","tok":[["そこ"],["で"],["主","しゅ"],["が"],["言われた","いわれた"],["、"],["「"],["主人","しゅじん"],["が"],["、"],["召使","めしつかい"],["たち"],["の"],["上","うえ"],["に"],["立てて","たてて"],["、"],["時","とき"],["に"],["応じて","おうじて"],["定め","さだめ"],["の"],["食事","しょくじ"],["を"],["そなえさせる"],["忠実","ちゅうじつ"],["な"],["思慮","しりょ"],["深い","ぶかい"],["家令","かれい"],["は"],["、"],["いったい"],["だれ"],["で"],["あろう"],["。"]]},{"verse":43,"text":"主人,しゅじんが帰,かえってきたとき、そのようにつとめているのを見,みられる僕,しもべは、さいわいである。","tok":[["主人","しゅじん"],["が"],["帰えって","かえって"],["きた"],["とき"],["、"],["その"],["よう"],["に"],["つとめて"],["いる"],["の"],["を"],["見られる","みられる"],["僕","し"],["も"],["べ"],["は"],["、"],["さいわい"],["で"],["ある"],["。"]]},{"verse":44,"text":"よく言,いっておくが、主人,しゅじんはその僕,しもべを立,たてて自分,じぶんの全,ぜん財産,ざいさんを管理,かんりさせるであろう。","tok":[["よく"],["言って","いって"],["おく"],["が"],["、"],["主人","しゅじん"],["は"],["その"],["僕","し"],["も"],["べ"],["を"],["立てて","たてて"],["自分","じぶん"],["の"],["全","ぜん"],["財産","ざいさん"],["を"],["管理","かんり"],["させるで"],["あろう"],["。"]]},{"verse":45,"text":"しかし、もしその僕,しもべが、主人,しゅじんの帰,かえりがおそいと心,こころの中,なかで思,おもい、男女,だんじょの召使,めしつかいたちを打,うちたたき、そして食,たべたり、飲,のんだりして酔,よいはじめるならば、","tok":[["しかし"],["、"],["もし"],["その"],["僕","し"],["も"],["べ"],["が"],["、"],["主人","しゅじん"],["の"],["帰えり","かえり"],["が"],["おそい"],["と"],["心","こころ"],["の"],["中","なか"],["で"],["思い","おもい"],["、"],["男女","だんじょ"],["の"],["召使","めしつかい"],["たち"],["を"],["打ちたたき","うちたたき"],["、"],["そして"],["食べ","たべ"],["たり"],["、"],["飲","のん"],["だり"],["して"],["酔","よい"],["はじめるならば"],["、"]]},{"verse":46,"text":"その僕,しもべの主人,しゅじんは思,おもいがけない日,ひ、気,きがつかない時,ときに帰,かえって来,くるであろう。そして、彼,かれを厳罰,げんばつに処,しょして、不,ふ忠実,ちゅうじつなものたちと同,おなじ目,めにあわせるであろう。","tok":[["その"],["僕","し"],["も"],["べ"],["の"],["主人","しゅじん"],["は"],["思いがけない","おもいがけない"],["日","ひ"],["、"],["気","き"],["が"],["つかない"],["時","とき"],["に"],["帰えって","かえって"],["来るで","くるで"],["あろう"],["。"],["そして"],["、"],["彼","かれ"],["を"],["厳罰","げんばつ"],["に"],["処して","しょして"],["、"],["不","ふ"],["忠実","ちゅうじつ"],["な"],["もの"],["たち"],["と"],["同じ","おなじ"],["目","め"],["に"],["あわせるで"],["あろう"],["。"]]},{"verse":47,"text":"主人,しゅじんのこころを知,しっていながら、それに従,したがって用意,よういもせず勤,つとめもしなかった僕,しもべは、多,おおくむち打,うたれるであろう。","tok":[["主人","しゅじん"],["の"],["こころ"],["を"],["知って","しって"],["い"],["ながら"],["、"],["それ"],["に"],["従って","したがって"],["用意","ようい"],["も"],["せず"],["勤め","つとめ"],["も"],["しなかった"],["僕","し"],["も"],["べ"],["は"],["、"],["多く","おおく"],["むち打たれるで","むちうたれるで"],["あろう"],["。"]]},{"verse":48,"text":"しかし、知,しらずに打,うたれるようなことをした者,ものは、打,うたれ方,ほうが少,すくないだろう。多,おおく与,あたえられた者,ものからは多,おおく求,もとめられ、多,おおく任,まかせられた者,ものからは更,さらに多,おおく要求,ようきゅうされるのである。","tok":[["しかし"],["、"],["知らず","しらず"],["に"],["打たれる","うたれる"],["よう"],["な"],["こと"],["を"],["した"],["者","もの"],["は"],["、"],["打たれ","うたれ"],["方","ほう"],["が"],["少いだろう","すくないだろう"],["。"],["多く","おおく"],["与えられた","あたえられた"],["者","もの"],["から"],["は"],["多く","おおく"],["求められ","もとめられ"],["、"],["多く","おおく"],["任せられた","まかせられた"],["者","もの"],["から"],["は"],["更に","さらに"],["多く","おおく"],["要求","ようきゅう"],["される"],["ので"],["ある"],["。"]]},{"verse":49,"text":"わたしは、火,ひを地上,ちじょうに投,とうじるためにきたのだ。火,ひがすでに燃,もえていたならと、わたしはどんなに願,ねがっていることか。","tok":[["わたし"],["は"],["、"],["火","ひ"],["を"],["地上","ちじょう"],["に"],["投じる","とうじる"],["ため"],["に"],["きた"],["の"],["だ"],["。"],["火","ひ"],["が"],["すでに"],["燃えて","もえて"],["いたなら"],["と"],["、"],["わたし"],["は"],["どんな"],["に"],["願って","ねがって"],["いる"],["こと"],["か"],["。"]]},{"verse":50,"text":"しかし、わたしには受,うけねばならないバプテスマがある。そして、それを受,うけてしまうまでは、わたしはどんなにか苦,くるしい思,おもいをすることであろう。","tok":[["しかし"],["、"],["わたし"],["に"],["は"],["受けねば","うけねば"],["ならない"],["バプテスマ"],["が"],["ある"],["。"],["そして"],["、"],["それ"],["を"],["受て","うけて"],["しまう"],["まで"],["は"],["、"],["わたし"],["は"],["どんな"],["に"],["か"],["苦しい","くるしい"],["思い","おもい"],["を"],["する"],["こと"],["で"],["あろう"],["。"]]},{"verse":51,"text":"あなたがたは、わたしが平和,へいわをこの地上,ちじょうにもたらすためにきたと思,おもっているのか。あなたがたに言,いっておく。そうではない。むしろ分裂,ぶんれつである。","tok":[["あなた"],["がた"],["は"],["、"],["わたし"],["が"],["平和","へいわ"],["を"],["この"],["地上","ちじょう"],["に"],["もたらす"],["ため"],["に"],["きた"],["と"],["思って","おもって"],["いる"],["の"],["か"],["。"],["あなた"],["がた"],["に"],["言って","いって"],["おく"],["。"],["そう"],["で"],["は"],["ない"],["。"],["むしろ"],["分裂","ぶんれつ"],["で"],["ある"],["。"]]},{"verse":52,"text":"というのは、今,いまから後,のちは、一家,いっかの内,うちで五人,にんが相,あい分,わかれて、三人,にんはふたりに、ふたりは三人,にんに対立,たいりつし、","tok":[["と"],["いう"],["の"],["は"],["、"],["今","いま"],["から"],["後","のち"],["は"],["、"],["一家","いっか"],["の"],["内","うち"],["で"],["五人","にん"],["が"],["相","あい"],["分かれて","わかれて"],["、"],["三人","にん"],["は"],["ふたり"],["に"],["、"],["ふたり"],["は"],["三人","にん"],["に"],["対立","たいりつ"],["し"],["、"]]},{"verse":53,"text":"また父,ちちは子,こに、子,こは父,ちちに、母,ははは娘,むすめに、娘,むすめは母,ははに、しゅうとめは嫁,よめに、嫁,よめはしゅうとめに、対立,たいりつするであろう」。","tok":[["また"],["父","ちち"],["は"],["子","こ"],["に"],["、"],["子","こ"],["は"],["父","ちち"],["に"],["、"],["母","はは"],["は"],["娘","むすめ"],["に"],["、"],["娘","むすめ"],["は"],["母","はは"],["に"],["、"],["しゅうとめ"],["は"],["嫁","よめ"],["に"],["、"],["嫁","よめ"],["は"],["しゅうとめ"],["に"],["、"],["対立","たいりつ"],["するで"],["あろう"],["」"],["。"]]},{"verse":54,"text":"イエスはまた群衆,ぐんしゅうに対,たいしても言,いわれた、「あなたがたは、雲,くもが西,にしに起,おこるのを見,みるとすぐ、にわか雨,あめがやって来,くる、と言,いう。果,はたしてそのとおりになる。","tok":[["イエス"],["は"],["また"],["群衆","ぐんしゅう"],["に対して","にたいして"],["も"],["言われた","いわれた"],["、"],["「"],["あなた"],["がた"],["は"],["、"],["雲","くも"],["が"],["西","にし"],["に"],["起こる","おこる"],["の"],["を"],["見る","みる"],["と"],["すぐ"],["、"],["にわか雨","にわかあめ"],["が"],["やって"],["来る","くる"],["、"],["と"],["言う","いう"],["。"],["果たして","はたして"],["その"],["とおり"],["に"],["なる"],["。"]]},{"verse":55,"text":"それから南風,みなみかぜが吹,ふくと、暑,あつくなるだろう、と言,いう。果,はたしてそのとおりになる。","tok":[["それ"],["から"],["南風","み"],["なみ"],["かぜ"],["が"],["吹く","ふく"],["と"],["、"],["暑く","あつく"],["なるだろう"],["、"],["と"],["言う","いう"],["。"],["果たして","はたして"],["その"],["とおり"],["に"],["なる"],["。"]]},{"verse":56,"text":"偽善者,ぎぜんしゃよ、あなたがたは天地,てんちの模様,もようを見分,みわけることを知,しりながら、どうして今,いまの時代,じだいを見分,みわけることができないのか。","tok":[["偽善者","ぎぜんしゃ"],["よ"],["、"],["あなた"],["がた"],["は"],["天地","てんち"],["の"],["模様","もよう"],["を"],["見分ける","みわける"],["こと"],["を"],["知り","しり"],["ながら"],["、"],["どう"],["して"],["今","いま"],["の"],["時代","じだい"],["を"],["見分ける","みわける"],["こと"],["が"],["できない"],["の"],["か"],["。"]]},{"verse":57,"text":"また、あなたがたは、なぜ正,ただしいことを自分,じぶんで判断,はんだんしないのか。","tok":[["また"],["、"],["あなた"],["がた"],["は"],["、"],["なぜ"],["正い","ただしい"],["こと"],["を"],["自分","じぶん"],["で"],["判断","はんだん"],["しない"],["の"],["か"],["。"]]},{"verse":58,"text":"たとえば、あなたを訴,うったえる人,ひとと一緒,いっしょに役人,やくにんのところへ行,いくときには、途中,とちゅうでその人,ひとと和解,わかいするように努,つとめるがよい。そうしないと、その人,ひとはあなたを裁判官,さいばんかんのところへひっぱって行,いき、裁判官,さいばんかんはあなたを獄吏,ごくりに引,ひき渡,わたし、獄吏,ごくりはあなたを獄,ごくに投,なげ込,こむであろう。","tok":[["たとえば"],["、"],["あなた"],["を"],["訴る","うったえる"],["人","ひと"],["と"],["一緒","いっしょ"],["に"],["役人","やくにん"],["の"],["ところ"],["へ"],["行く","いく"],["とき"],["に"],["は"],["、"],["途中","とちゅう"],["で"],["その"],["人","ひと"],["と"],["和解","わかい"],["する"],["よう"],["に"],["努める","つとめる"],["が"],["よい"],["。"],["そう"],["しない"],["と"],["、"],["その"],["人","ひと"],["は"],["あなた"],["を"],["裁判官","さいばんかん"],["の"],["ところ"],["へ"],["ひっぱって"],["行き","いき"],["、"],["裁判官","さいばんかん"],["は"],["あなた"],["を"],["獄吏","ごくり"],["に"],["引渡","ひきわたし"],["、"],["獄吏","ごくり"],["は"],["あなた"],["を"],["獄","ごく"],["に"],["投込むで","なげこむで"],["あろう"],["。"]]},{"verse":59,"text":"わたしは言,いって置,おく、最後,さいごの一レプタまでも支払,しはらってしまうまでは、決,けっしてそこから出,でて来,くることはできない」。","tok":[["わたし"],["は"],["言って","いって"],["置く","おく"],["、"],["最後","さいご"],["の"],["一","いち"],["レプタ"],["まで"],["も"],["支払って","しはらって"],["しまう"],["まで"],["は"],["、"],["決っして","けっして"],["そこ"],["から"],["出て","でて"],["来る","くる"],["こと"],["は"],["できない"],["」"],["。"]]}]
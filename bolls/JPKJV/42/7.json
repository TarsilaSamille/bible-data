[{"verse":1,"text":"イエスはこれらの言葉,ことばをことごとく人々,ひとびとに聞,きかせてしまったのち、カペナウムに帰,かえってこられた。","tok":[["イエス"],["は"],["これ"],["ら"],["の"],["言葉","ことば"],["を"],["ことごとく"],["人々","ひとびと"],["に"],["聞かせて","きかせて"],["しまった"],["のち"],["、"],["カペナウム"],["に"],["帰えって","かえって"],["こられた"],["。"]]},{"verse":2,"text":"ところが、ある百卒長,ひゃくそつちょうの頼,たのみにしていた僕,しもべが、病気,びょうきになって死,しにかかっていた。","tok":[["ところ"],["が"],["、"],["ある"],["百卒長","ひゃくそつちょう"],["の"],["頼み","たのみ"],["に"],["して"],["いた"],["僕","し"],["も"],["べ"],["が"],["、"],["病気","びょうき"],["に"],["なって"],["死にかかって","しにかかって"],["いた"],["。"]]},{"verse":3,"text":"この百卒長,ひゃくそつちょうはイエスのことを聞,きいて、ユダヤ人,じんの長老,ちょうろうたちをイエスのところにつかわし、自分,じぶんの僕,しもべを助,たすけにきてくださるようにと、お願,ねがいした。","tok":[["この"],["百卒長","ひゃくそつちょう"],["は"],["イエス"],["の"],["こと"],["を"],["聞いて","きいて"],["、"],["ユダヤ人","ゆだやじん"],["の"],["長老","ちょうろう"],["たち"],["を"],["イエス"],["の"],["ところ"],["に"],["つかわし"],["、"],["自分","じぶん"],["の"],["僕","し"],["も"],["べ"],["を"],["助け","たすけ"],["に"],["きて"],["くださる"],["よう"],["に"],["と"],["、"],["お願い","おねがい"],["した"],["。"]]},{"verse":4,"text":"彼,かれらはイエスのところにきて、熱心,ねっしんに願,ねがって言,いった、「あの人,ひとはそうしていただくねうちがございます。","tok":[["彼","かれ"],["ら"],["は"],["イエス"],["の"],["ところ"],["に"],["きて"],["、"],["熱心","ねっしん"],["に"],["願って","ねがって"],["言った","いった"],["、"],["「"],["あの"],["人","ひと"],["は"],["そう"],["して"],["いただく"],["ねうち"],["が"],["ございます"],["。"]]},{"verse":5,"text":"わたしたちの国民,こくみんを愛,あいし、わたしたちのために会堂,かいどうを建,たててくれたのです」。","tok":[["わたしたち"],["の"],["国民","こくみん"],["を"],["愛し","あいし"],["、"],["わたしたち"],["の"],["ため"],["に"],["会堂","かいどう"],["を"],["建てて","たてて"],["くれた"],["の"],["です"],["」"],["。"]]},{"verse":6,"text":"そこで、イエスは彼,かれらと連,つれだってお出,でかけになった。ところが、その家,いえからほど遠,とおくないあたりまでこられたとき、百卒長,ひゃくそつちょうは友,ともだちを送,おくってイエスに言,いわせた、「主,しゅよ、どうぞ、ご足労,そくろうくださいませんように。わたしの屋根,やねの下,したにあなたをお入,いれする資格,しかくは、わたしにはございません。","tok":[["そこ"],["で"],["、"],["イエス"],["は"],["彼","かれ"],["ら"],["と"],["連れだって","つれだって"],["お出かけ","おでかけ"],["に"],["なった"],["。"],["ところ"],["が"],["、"],["その"],["家","いえ"],["から"],["ほど遠く","ほどとおく"],["ない"],["あたり"],["まで"],["こられた"],["とき"],["、"],["百卒長","ひゃくそつちょう"],["は"],["友だち","ともだち"],["を"],["送って","おくって"],["イエス"],["に"],["言わせた","いわせた"],["、"],["「"],["主","しゅ"],["よ"],["、"],["どうぞ"],["、"],["ご足労","ごそくろう"],["くださいません"],["よう"],["に"],["。"],["わたし"],["の"],["屋根","やね"],["の"],["下","した"],["に"],["あなた"],["を"],["お入れ","おいれ"],["する"],["資格","しかく"],["は"],["、"],["わたし"],["に"],["は"],["ございません"],["。"]]},{"verse":7,"text":"それですから、自分,じぶんでお迎,むかえにあがるねうちさえないと思,おもっていたのです。ただ、お言葉,ことばを下,ください。そして、わたしの僕,しもべをなおしてください。","tok":[["それ"],["です"],["から"],["、"],["自分","じぶん"],["で"],["お迎","おむかえ"],["に"],["あがる"],["ねうち"],["さえ"],["ない"],["と"],["思って","おもって"],["いた"],["の"],["です"],["。"],["ただ"],["、"],["お言葉","おことば"],["を"],["下さい","ください"],["。"],["そして"],["、"],["わたし"],["の"],["僕","し"],["も"],["べ"],["を"],["なおして"],["ください"],["。"]]},{"verse":8,"text":"わたしも権威,けんいの下,したに服,ふくしている者,ものですが、わたしの下,したにも兵卒,へいそつがいまして、ひとりの者,ものに『行,いけ』と言,いえば行,いき、ほかの者,ものに『こい』と言,いえばきますし、また、僕,しもべに『これをせよ』と言,いえば、してくれるのです」。","tok":[["わたし"],["も"],["権威","けんい"],["の"],["下","した"],["に"],["服して","ふくして"],["いる"],["者","もの"],["です"],["が"],["、"],["わたし"],["の"],["下","した"],["に"],["も"],["兵卒","へいそつ"],["が"],["いまして"],["、"],["ひとり"],["の"],["者","もの"],["に"],["『"],["行け","いけ"],["』"],["と"],["言えば","いえば"],["行き","いき"],["、"],["ほか"],["の"],["者","もの"],["に"],["『"],["こい"],["』"],["と"],["言えば","いえば"],["きます"],["し"],["、"],["また"],["、"],["僕","し"],["も"],["べ"],["に"],["『"],["これ"],["を"],["せよ"],["』"],["と"],["言えば","いえば"],["、"],["して"],["くれる"],["の"],["です"],["」"],["。"]]},{"verse":9,"text":"イエスはこれを聞,きいて非常,ひじょうに感心,かんしんされ、ついてきた群衆,ぐんしゅうの方,ほうに振,ふり向,むいて言,いわれた、「あなたがたに言,いっておくが、これほどの信仰,しんこうは、イスラエルの中,なかでも見,みたことがない」。","tok":[["イエス"],["は"],["これ"],["を"],["聞いて","きいて"],["非常","ひじょう"],["に"],["感心","かんしん"],["され"],["、"],["ついて"],["きた"],["群衆","ぐんしゅう"],["の"],["方","ほう"],["に"],["振り向いて","ふりむいて"],["言われた","いわれた"],["、"],["「"],["あなた"],["がた"],["に"],["言って","いって"],["おく"],["が"],["、"],["これ"],["ほど"],["の"],["信仰","しんこう"],["は"],["、"],["イスラエル"],["の"],["中","なか"],["で"],["も"],["見た","みた"],["こと"],["が"],["ない"],["」"],["。"]]},{"verse":10,"text":"使,つかいにきた者,ものたちが家,いえに帰,かえってみると、僕,しもべは元気,げんきになっていた。","tok":[["使","つかい"],["に"],["きた"],["者","もの"],["たち"],["が"],["家","いえ"],["に"],["帰えって","かえって"],["みる"],["と"],["、"],["僕","し"],["も"],["べ"],["は"],["元気","げんき"],["に"],["なって"],["いた"],["。"]]},{"verse":11,"text":"そののち、間,まもなく、ナインという町,まちへおいでになったが、弟子,でしたちや大,おおぜいの群衆,ぐんしゅうも一緒,いっしょに行,いった。","tok":[["その"],["のち"],["、"],["間","ま"],["も"],["なく"],["、"],["ナイン"],["と"],["いう"],["町","まち"],["へ"],["おいで"],["に"],["なった"],["が"],["、"],["弟子","でし"],["たち"],["や"],["大ぜい","おおぜい"],["の"],["群衆","ぐんしゅう"],["も"],["一緒","いっしょ"],["に"],["行った","いった"],["。"]]},{"verse":12,"text":"町,まちの門,もんに近,ちかづかれると、ちょうど、あるやもめにとってひとりむすこであった者,ものが死,しんだので、葬,ほうむりに出,だすところであった。大,おおぜいの町,まちの人,ひとたちが、その母,ははにつきそっていた。","tok":[["町","まち"],["の"],["門","もん"],["に"],["近づかれる","ちかづかれる"],["と"],["、"],["ちょうど"],["、"],["ある"],["やもめ"],["にとって"],["ひとり"],["むすこ"],["で"],["あった"],["者","もの"],["が"],["死んだ","しんだ"],["ので"],["、"],["葬むり","ほうむり"],["に"],["出す","だす"],["ところ"],["で"],["あった"],["。"],["大ぜい","おおぜい"],["の"],["町","まち"],["の"],["人","ひと"],["たち"],["が"],["、"],["その"],["母","はは"],["に"],["つきそって"],["いた"],["。"]]},{"verse":13,"text":"主,しゅはこの婦人,ふじんを見,みて深,ふかい同情,どうじょうを寄,よせられ、「泣,なかないでいなさい」と言,いわれた。","tok":[["主","しゅ"],["は"],["この"],["婦人","ふじん"],["を"],["見て","みて"],["深","ふ"],["かい"],["同情","どうじょう"],["を"],["寄せられ","よせられ"],["、"],["「"],["泣かないで","なかないで"],["い"],["なさい"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":14,"text":"そして近寄,ちかよって棺,かんに手,てをかけられると、かついでいる者,ものたちが立,たち止,どまったので、「若者,わかものよ、さあ、起,おきなさい」と言,いわれた。","tok":[["そして"],["近寄って","ちかよって"],["棺","かん"],["に"],["手","て"],["を"],["かけられる"],["と"],["、"],["かついで"],["いる"],["者","もの"],["たち"],["が"],["立ち止まった","たちどまった"],["ので"],["、"],["「"],["若者","わかもの"],["よ"],["、"],["さあ"],["、"],["起き","おき"],["なさい"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":15,"text":"すると、死人,しにんが起,おき上,あがって物,ものを言,いい出,だした。イエスは彼,かれをその母,ははにお渡,わたしになった。","tok":[["する"],["と"],["、"],["死人","しにん"],["が"],["起き上がって","おきあがって"],["物","もの"],["を"],["言い","いい"],["出した","だした"],["。"],["イエス"],["は"],["彼","かれ"],["を"],["その"],["母","はは"],["に"],["お渡","おわたし"],["に"],["なった"],["。"]]},{"verse":16,"text":"人々,ひとびとはみな恐,おそれをいだき、「大,だい預言者,よげんしゃがわたしたちの間,あいだに現,あらわれた」、また、「神,かみはその民,たみを顧,かえりみてくださった」と言,いって、神,かみをほめたたえた。","tok":[["人々","ひとびと"],["は"],["みな"],["恐","おそれ"],["を"],["いだき"],["、"],["「"],["大","だい"],["預言者","よげんしゃ"],["が"],["わたしたち"],["の"],["間","あいだ"],["に"],["現われた","あらわれた"],["」"],["、"],["また"],["、"],["「"],["神","かみ"],["は"],["その"],["民","たみ"],["を"],["顧て","かえりみて"],["くださった"],["」"],["と"],["言って","いって"],["、"],["神","かみ"],["を"],["ほめたたえた"],["。"]]},{"verse":17,"text":"イエスについてのこの話,はなしは、ユダヤ全土,ぜんどおよびその附近,ふきんのいたる所,ところにひろまった。","tok":[["イエス"],["について"],["の"],["この"],["話","はなし"],["は"],["、"],["ユダヤ"],["全土","ぜんど"],["および"],["その"],["附近","ふきん"],["の"],["いたる所","いたるところ"],["に"],["ひろまった"],["。"]]},{"verse":18,"text":"ヨハネの弟子,でしたちは、これらのことを全部,ぜんぶ彼,かれに報告,ほうこくした。するとヨハネは弟子,でしの中,なかからふたりの者,ものを呼,よんで、","tok":[["ヨハネ"],["の"],["弟子","でし"],["たち"],["は"],["、"],["これ"],["ら"],["の"],["こと"],["を"],["全部","ぜんぶ"],["彼","かれ"],["に"],["報告","ほうこく"],["した"],["。"],["する"],["と"],["ヨハネ"],["は"],["弟子","でし"],["の"],["中","なか"],["から"],["ふたり"],["の"],["者","もの"],["を"],["呼んで","よんで"],["、"]]},{"verse":19,"text":"主,しゅのもとに送,おくり、「『きたるべきかた』はあなたなのですか。それとも、ほかにだれかを待,まつべきでしょうか」と尋,たずねさせた。","tok":[["主","しゅ"],["の"],["もと"],["に"],["送り","おくり"],["、"],["「"],["『"],["きたるべき"],["かた"],["』"],["は"],["あなた"],["な"],["の"],["です"],["か"],["。"],["それ"],["と"],["も"],["、"],["ほか"],["に"],["だれ"],["か"],["を"],["待つべきでしょう","まつべきでしょう"],["か"],["」"],["と"],["尋ねさせた","たずねさせた"],["。"]]},{"verse":20,"text":"そこで、この人,ひとたちがイエスのもとにきて言,いった、「わたしたちはバプテスマのヨハネからの使,つかいですが、『きたるべきかた』はあなたなのですか、それとも、ほかにだれかを待,まつべきでしょうか、とヨハネが尋,たずねています」。","tok":[["そこ"],["で"],["、"],["この"],["人","ひと"],["たち"],["が"],["イエス"],["の"],["もと"],["に"],["きて"],["言った","いった"],["、"],["「"],["わたしたち"],["は"],["バプテスマ"],["の"],["ヨハネ"],["から"],["の"],["使","つかい"],["です"],["が"],["、"],["『"],["きたるべき"],["かた"],["』"],["は"],["あなた"],["な"],["の"],["です"],["か"],["、"],["それ"],["と"],["も"],["、"],["ほか"],["に"],["だれ"],["か"],["を"],["待つべきでしょう","まつべきでしょう"],["か"],["、"],["と"],["ヨハネ"],["が"],["尋ねて","たずねて"],["います"],["」"],["。"]]},{"verse":21,"text":"そのとき、イエスはさまざまの病苦,びょうくと悪霊,あくれいとに悩,なやむ人々,ひとびとをいやし、また多,おおくの盲人,もうじんを見,みえるようにしておられたが、","tok":[["その"],["とき"],["、"],["イエス"],["は"],["さまざま"],["の"],["病苦","びょうく"],["と"],["悪霊","あくれいと"],["に"],["悩む","なやむ"],["人々","ひとびと"],["を"],["いやし"],["、"],["また"],["多く","おおく"],["の"],["盲人","もうじん"],["を"],["見える","みえる"],["よう"],["に"],["して"],["おられた"],["が"],["、"]]},{"verse":22,"text":"答,こたえて言,いわれた、「行,いって、あなたがたが見聞,みききしたことを、ヨハネに報告,ほうこくしなさい。盲人,もうじんは見,みえ、足,あしなえは歩,あるき、らい病人,びょうにんはきよまり、耳,みみしいは聞,きこえ、死人,しにんは生,いきかえり、貧,まずしい人々,ひとびとは福音,ふくいんを聞,きかされている。","tok":[["答","こたえ"],["て"],["言われた","いわれた"],["、"],["「"],["行って","いって"],["、"],["あなた"],["がた"],["が"],["見聞き","みきき"],["した"],["こと"],["を"],["、"],["ヨハネ"],["に"],["報告","ほうこく"],["し"],["なさい"],["。"],["盲人","もうじん"],["は"],["見え","みえ"],["、"],["足","あし"],["なえ"],["は"],["歩き","あるき"],["、"],["らい病人","らいびょうにん"],["は"],["きよまり"],["、"],["耳","みみ"],["しい"],["は"],["聞こえ","きこえ"],["、"],["死人","しにん"],["は"],["生きかえり","いきかえり"],["、"],["貧しい","まずしい"],["人々","ひとびと"],["は"],["福音","ふくいん"],["を"],["聞かされて","きかされて"],["いる"],["。"]]},{"verse":23,"text":"わたしにつまずかない者,ものは、さいわいである」。","tok":[["わたし"],["に"],["つまずかない"],["者","もの"],["は"],["、"],["さいわい"],["で"],["ある"],["」"],["。"]]},{"verse":24,"text":"ヨハネの使,つかいが行,いってしまうと、イエスはヨハネのことを群衆,ぐんしゅうに語,かたりはじめられた、「あなたがたは、何,なにを見,みに荒野,あらのに出,でてきたのか。風,かぜに揺,ゆらぐ葦,あしであるか。","tok":[["ヨハネ"],["の"],["使","つかい"],["が"],["行って","いって"],["しまう"],["と"],["、"],["イエス"],["は"],["ヨハネ"],["の"],["こと"],["を"],["群衆","ぐんしゅう"],["に"],["語り","かたり"],["はじめられた"],["、"],["「"],["あなた"],["がた"],["は"],["、"],["何に","なに"],["を"],["見","み"],["に"],["荒野","あらの"],["に"],["出て","でて"],["きた"],["の"],["か"],["。"],["風","かぜ"],["に"],["揺らぐ","ゆらぐ"],["葦","あし"],["で"],["ある"],["か"],["。"]]},{"verse":25,"text":"では、何,なにを見,みに出,でてきたのか。柔,やわらかい着物,きものをまとった人,ひとか。きらびやかに着,つかざって、ぜいたくに暮,くらしている人々,ひとびとなら、宮殿,きゅうでんにいる。","tok":[["で"],["は"],["、"],["何に","なに"],["を"],["見","み"],["に"],["出て","でて"],["きた"],["の"],["か"],["。"],["柔らかい","やわらかい"],["着物","きもの"],["を"],["まとった"],["人","ひと"],["か"],["。"],["きらびやか"],["に"],["着かざって","つかざって"],["、"],["ぜいたく"],["に"],["暮らして","くらして"],["いる"],["人々","ひとびと"],["なら"],["、"],["宮殿","きゅうでん"],["に"],["いる"],["。"]]},{"verse":26,"text":"では、何,なにを見,みに出,でてきたのか。預言者,よげんしゃか。そうだ、あなたがたに言,いうが、預言者,よげんしゃ以上,いじょうの者,ものである。","tok":[["で"],["は"],["、"],["何に","なに"],["を"],["見","み"],["に"],["出て","でて"],["きた"],["の"],["か"],["。"],["預言者","よげんしゃ"],["か"],["。"],["そう"],["だ"],["、"],["あなた"],["がた"],["に"],["言う","いう"],["が"],["、"],["預言者","よげんしゃ"],["以上","いじょう"],["の"],["者","もの"],["で"],["ある"],["。"]]},{"verse":27,"text":"『見,みよ、わたしは使,つかいをあなたの先,さきにつかわし、あなたの前,まえに、道,みちを整,ととのえさせるであろう』と書,かいてあるのは、この人,ひとのことである。","tok":[["『"],["見よ","みよ"],["、"],["わたし"],["は"],["使","つかい"],["を"],["あなた"],["の"],["先","さき"],["に"],["つかわし"],["、"],["あなた"],["の"],["前","まえ"],["に"],["、"],["道","みち"],["を"],["整えさせるで","ととのえさせるで"],["あろう"],["』"],["と"],["書いて","かいて"],["ある"],["の"],["は"],["、"],["この"],["人","ひと"],["の"],["こと"],["で"],["ある"],["。"]]},{"verse":28,"text":"あなたがたに言,いっておく。女,おんなの産,うんだ者,ものの中,なかで、ヨハネより大,おおきい人物,じんぶつはいない。しかし、神,かみの国,くにで最,もっとも小,ちいさい者,ものも、彼,かれよりは大,おおきい。","tok":[["あなた"],["がた"],["に"],["言って","いって"],["おく"],["。"],["女","おんな"],["の"],["産んだ","うんだ"],["者","もの"],["の"],["中","なか"],["で"],["、"],["ヨハネ"],["より"],["大きい","おおきい"],["人物","じんぶつ"],["は"],["いない"],["。"],["しかし"],["、"],["神","かみ"],["の"],["国","くに"],["で"],["最も","もっとも"],["小さい","ちいさい"],["者","もの"],["も"],["、"],["彼","かれ"],["より"],["は"],["大きい","おおきい"],["。"]]},{"verse":29,"text":"（これを聞,きいた民衆,みんしゅうは皆,みな、また取税人,しゅぜいにんたちも、ヨハネのバプテスマを受,うけて神,かみの正,ただしいことを認,みとめた。","tok":[["（"],["これ"],["を"],["聞いた","きいた"],["民衆","みんしゅう"],["は"],["皆","みな"],["、"],["また"],["取","とり"],["税人","ぜいにん"],["に"],["ん"],["たち"],["も"],["、"],["ヨハネ"],["の"],["バプテスマ"],["を"],["受て","うけて"],["神","かみ"],["の"],["正い","ただしい"],["こと"],["を"],["認めた","みとめた"],["。"]]},{"verse":30,"text":"しかし、パリサイ人,びとと律法,りっぽう学者,がくしゃたちとは彼,かれからバプテスマを受,うけないで、自分,じぶんたちに対,たいする神,かみのみこころを無,むにした。）","tok":[["しかし"],["、"],["パリサイ"],["人","び"],["と"],["と"],["律法学者","りっぽうがくしゃ"],["たち"],["と"],["は"],["彼","かれ"],["から"],["バプテスマ"],["を"],["受ないで","うけないで"],["、"],["自分","じぶん"],["たち"],["に"],["対する","たいする"],["神","かみ"],["のみ"],["こころ"],["を"],["無","む"],["に"],["した"],["。"],["）"]]},{"verse":31,"text":"だから今,いまの時代,じだいの人々,ひとびとを何,なにに比,くらべようか。彼,かれらは何,なにに似,にているか。","tok":[["だ"],["から"],["今","いま"],["の"],["時代","じだい"],["の"],["人々","ひとびと"],["を"],["何に","なに"],["に"],["比べよう","くらべよう"],["か"],["。"],["彼","かれ"],["ら"],["は"],["何に","なに"],["に"],["似て","にて"],["いる"],["か"],["。"]]},{"verse":32,"text":"それは子供,こどもたちが広場,ひろばにすわって、互,たがいに呼,よびかけ、『わたしたちが笛,ふえを吹,ふいたのに、あなたたちは踊,おどってくれなかった。弔,とむらいの歌,うたを歌,うたったのに、泣,ないてくれなかった』と言,いうのに似,にている。","tok":[["それ"],["は"],["子供","こども"],["たち"],["が"],["広場","ひろば"],["に"],["すわって"],["、"],["互","たがい"],["に"],["呼びかけ","よびかけ"],["、"],["『"],["わたしたち"],["が"],["笛","ふえ"],["を"],["吹いた","ふいた"],["のに"],["、"],["あなた"],["たち"],["は"],["踊って","おどって"],["くれなかった"],["。"],["弔","とむらい"],["の"],["歌","うた"],["を"],["歌った","うたった"],["のに"],["、"],["泣いて","ないて"],["くれなかった"],["』"],["と"],["言う","いう"],["のに"],["似て","にて"],["いる"],["。"]]},{"verse":33,"text":"なぜなら、バプテスマのヨハネがきて、パンを食,たべることも、ぶどう酒,しゅを飲,のむこともしないと、あなたがたは、あれは悪霊,あくれいにつかれているのだ、と言,いい、","tok":[["なぜ"],["なら"],["、"],["バプテスマ"],["の"],["ヨハネ"],["が"],["きて"],["、"],["パン"],["を"],["食べる","たべる"],["こと"],["も"],["、"],["ぶどう酒","ぶどうしゅ"],["を"],["飲む","のむ"],["こと"],["も"],["しない"],["と"],["、"],["あなた"],["がた"],["は"],["、"],["あれ"],["は"],["悪霊","あくれい"],["に"],["つかれて"],["いる"],["の"],["だ"],["、"],["と"],["言い","いい"],["、"]]},{"verse":34,"text":"また人,ひとの子,こがきて食,たべたり飲,のんだりしていると、見,みよ、あれは食,しょくをむさぼる者,もの、大酒,おおざけを飲,のむ者,もの、また取税人,しゅぜいにん、罪人,つみびとの仲間,なかまだ、と言,いう。","tok":[["また"],["人","ひと"],["の"],["子","こ"],["が"],["きて"],["食べ","たべ"],["たり"],["飲ん","のん"],["だり"],["して"],["いる"],["と"],["、"],["見よ","みよ"],["、"],["あれ"],["は"],["食","しょく"],["を"],["むさぼる"],["者","もの"],["、"],["大酒","おおざけ"],["を"],["飲む","のむ"],["者","もの"],["、"],["また"],["取","とり"],["税人","ぜいにん"],["ぜ"],["い"],["にん"],["、"],["罪人","つみびと"],["の"],["仲間","なかま"],["だ"],["、"],["と"],["言う","いう"],["。"]]},{"verse":35,"text":"しかし、知恵,ちえの正,ただしいことは、そのすべての子,こが証明,しょうめいする」。","tok":[["しかし"],["、"],["知恵","ちえ"],["の"],["正い","ただしい"],["こと"],["は"],["、"],["その"],["すべて"],["の"],["子","こ"],["が"],["証明","しょうめい"],["する"],["」"],["。"]]},{"verse":36,"text":"あるパリサイ人,びとがイエスに、食事,しょくじを共,ともにしたいと申,もうし出,でたので、そのパリサイ人,びとの家,いえにはいって食卓,しょくたくに着,つかれた。","tok":[["ある"],["パリサイ"],["人","び"],["と"],["が"],["イエス"],["に"],["、"],["食事","しょくじ"],["を"],["共","とも"],["に"],["したい"],["と"],["申し出た","もうしでた"],["ので"],["、"],["その"],["パリサイ"],["人","びと"],["の"],["家","いえ"],["に"],["はいって"],["食卓","しょくたく"],["に"],["着かれた","つかれた"],["。"]]},{"verse":37,"text":"するとそのとき、その町,まちで罪,つみの女,おんなであったものが、パリサイ人,びとの家,いえで食卓,しょくたくに着,ついておられることを聞,きいて、香油,こうゆが入,いれてある石膏,せっこうのつぼを持,もってきて、","tok":[["する"],["と"],["その"],["とき"],["、"],["その"],["町","まち"],["で"],["罪","つみ"],["の"],["女","おんな"],["で"],["あった"],["もの"],["が"],["、"],["パリサイ"],["人","びと"],["の"],["家","いえ"],["で"],["食卓","しょくたく"],["に"],["着いて","ついて"],["おられる"],["こと"],["を"],["聞いて","きいて"],["、"],["香油","こうゆ"],["が"],["入れて","いれて"],["ある"],["石膏","せっこう"],["の"],["つぼ"],["を"],["持って","もって"],["きて"],["、"]]},{"verse":38,"text":"泣,なきながら、イエスのうしろでその足,あしもとに寄,より、まず涙,なみだでイエスの足,あしをぬらし、自分,じぶんの髪,かみの毛,けでぬぐい、そして、その足,あしに接吻,せっぷんして、香油,こうゆを塗,ぬった。","tok":[["泣","なき"],["ながら"],["、"],["イエス"],["の"],["うしろ"],["で"],["その"],["足もと","あしもと"],["に"],["寄り","より"],["、"],["まず"],["涙","なみだ"],["で"],["イエス"],["の"],["足","あし"],["を"],["ぬらし"],["、"],["自分","じぶん"],["の"],["髪の毛","かみのけ"],["で"],["ぬぐい"],["、"],["そして"],["、"],["その"],["足","あし"],["に"],["接吻","せっぷん"],["して"],["、"],["香油","こうゆ"],["を"],["塗った","ぬった"],["。"]]},{"verse":39,"text":"イエスを招,まねいたパリサイ人,びとがそれを見,みて、心,こころの中,なかで言,いった、「もしこの人,ひとが預言者,よげんしゃであるなら、自分,じぶんにさわっている女,おんながだれだか、どんな女,おんなかわかるはずだ。それは罪,つみの女,おんななのだから」。","tok":[["イエス"],["を"],["招いた","まねいた"],["パリサイ"],["人","び"],["と"],["が"],["それ"],["を"],["見て","みて"],["、"],["心","こころ"],["の"],["中","なか"],["で"],["言った","いった"],["、"],["「"],["もし"],["この"],["人","ひと"],["が"],["預言者","よげんしゃ"],["で"],["あるなら"],["、"],["自分","じぶん"],["に"],["さわって"],["いる"],["女","おんな"],["が"],["だれ"],["だ"],["か"],["、"],["どんな"],["女","おんな"],["か"],["わかる"],["はず"],["だ"],["。"],["それ"],["は"],["罪","つみ"],["の"],["女","おんな"],["な"],["の"],["だ"],["から"],["」"],["。"]]},{"verse":40,"text":"そこでイエスは彼,かれにむかって言,いわれた、「シモン、あなたに言,いうことがある」。彼,かれは「先生,せんせい、おっしゃってください」と言,いった。","tok":[["そこ"],["で"],["イエス"],["は"],["彼","かれ"],["に"],["むかって"],["言われた","いわれた"],["、"],["「"],["シモン"],["、"],["あなた"],["に"],["言う","いう"],["こと"],["が"],["ある"],["」"],["。"],["彼","かれ"],["は"],["「"],["先生","せんせい"],["、"],["おっしゃって"],["ください"],["」"],["と"],["言った","いった"],["。"]]},{"verse":41,"text":"イエスが言,いわれた、「ある金貸,かねかしに金,かねをかりた人,ひとがふたりいたが、ひとりは五百デナリ、もうひとりは五十デナリを借,かりていた。","tok":[["イエス"],["が"],["言われた","いわれた"],["、"],["「"],["ある"],["金貸","かねかし"],["に"],["金","かね"],["を"],["かりた"],["人","ひと"],["が"],["ふたり"],["いた"],["が"],["、"],["ひとり"],["は"],["五百","ごひゃく"],["デナリ"],["、"],["もう"],["ひとり"],["は"],["五十","ごじゅう"],["デナリ"],["を"],["借","かり"],["て"],["いた"],["。"]]},{"verse":42,"text":"ところが、返,かえすことができなかったので、彼,かれはふたり共,ともゆるしてやった。このふたりのうちで、どちらが彼,かれを多,おおく愛,あいするだろうか」。","tok":[["ところ"],["が"],["、"],["返えす","かえす"],["こと"],["が"],["できなかった"],["ので"],["、"],["彼","かれ"],["は"],["ふたり共","ふたりとも"],["ゆるして"],["やった"],["。"],["この"],["ふたり"],["の"],["うち"],["で"],["、"],["どちら"],["が"],["彼","かれ"],["を"],["多く","おおく"],["愛するだろう","あいするだろう"],["か"],["」"],["。"]]},{"verse":43,"text":"シモンが答,こたえて言,いった、「多,おおくゆるしてもらったほうだと思,おもいます」。イエスが言,いわれた、「あなたの判断,はんだんは正,ただしい」。","tok":[["シモン"],["が"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["多く","おおく"],["ゆるして"],["もらった"],["ほう"],["だ"],["と"],["思います","おもいます"],["」"],["。"],["イエス"],["が"],["言われた","いわれた"],["、"],["「"],["あなた"],["の"],["判断","はんだん"],["は"],["正い","ただしい"],["」"],["。"]]},{"verse":44,"text":"それから女,おんなの方,ほうに振,ふり向,むいて、シモンに言,いわれた、「この女,おんなを見,みないか。わたしがあなたの家,いえにはいってきた時,ときに、あなたは足,あしを洗,あらう水,みずをくれなかった。ところが、この女,おんなは涙,なみだでわたしの足,あしをぬらし、髪,かみの毛,けでふいてくれた。","tok":[["それ"],["から"],["女","おんな"],["の"],["方","ほう"],["に"],["振り向いて","ふりむいて"],["、"],["シモン"],["に"],["言われた","いわれた"],["、"],["「"],["この"],["女","おんな"],["を"],["見ない","みない"],["か"],["。"],["わたし"],["が"],["あなた"],["の"],["家","いえ"],["に"],["はいって"],["きた"],["時","とき"],["に"],["、"],["あなた"],["は"],["足","あし"],["を"],["洗う","あらう"],["水","みず"],["を"],["くれなかった"],["。"],["ところ"],["が"],["、"],["この"],["女","おんな"],["は"],["涙","なみだ"],["で"],["わたし"],["の"],["足","あし"],["を"],["ぬらし"],["、"],["髪の毛","かみのけ"],["で"],["ふいて"],["くれた"],["。"]]},{"verse":45,"text":"あなたはわたしに接吻,せっぷんをしてくれなかったが、彼女,かのじょはわたしが家,いえにはいった時,ときから、わたしの足,あしに接吻,せっぷんをしてやまなかった。","tok":[["あなた"],["は"],["わたし"],["に"],["接吻","せっぷん"],["を"],["して"],["くれなかった"],["が"],["、"],["彼女","かのじょ"],["は"],["わたし"],["が"],["家","いえ"],["に"],["はいった"],["時","とき"],["から"],["、"],["わたし"],["の"],["足","あし"],["に"],["接吻","せっぷん"],["を"],["して"],["やまなかった"],["。"]]},{"verse":46,"text":"あなたはわたしの頭,あたまに油,あぶらを塗,ぬってくれなかったが、彼女,かのじょはわたしの足,あしに香油,こうゆを塗,ぬってくれた。","tok":[["あなた"],["は"],["わたし"],["の"],["頭","あたま"],["に"],["油","あぶら"],["を"],["塗って","ぬって"],["くれなかった"],["が"],["、"],["彼女","かのじょ"],["は"],["わたし"],["の"],["足","あし"],["に"],["香油","こうゆ"],["を"],["塗って","ぬって"],["くれた"],["。"]]},{"verse":47,"text":"それであなたに言,いうが、この女,おんなは多,おおく愛,あいしたから、その多,おおくの罪,つみはゆるされているのである。少,すこしだけゆるされた者,ものは、少,すこしだけしか愛,あいさない」。","tok":[["それ"],["で"],["あなた"],["に"],["言う","いう"],["が"],["、"],["この"],["女","おんな"],["は"],["多く","おおく"],["愛した","あいした"],["から"],["、"],["その"],["多く","おおく"],["の"],["罪","つみ"],["は"],["ゆるされて"],["いる"],["ので"],["ある"],["。"],["少し","すこし"],["だけ"],["ゆるされた"],["者","もの"],["は"],["、"],["少し","すこし"],["だけ"],["しか"],["愛さない","あいさない"],["」"],["。"]]},{"verse":48,"text":"そして女,おんなに、「あなたの罪,つみはゆるされた」と言,いわれた。","tok":[["そして"],["女","おんな"],["に"],["、"],["「"],["あなた"],["の"],["罪","つみ"],["は"],["ゆるされた"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":49,"text":"すると同席,どうせきの者,ものたちが心,こころの中,なかで言,いいはじめた、「罪,つみをゆるすことさえするこの人,ひとは、いったい、何者,なにものだろう」。","tok":[["する"],["と"],["同席","どうせき"],["の"],["者","もの"],["たち"],["が"],["心","こころ"],["の"],["中","なか"],["で"],["言い","いい"],["はじめた"],["、"],["「"],["罪","つみ"],["を"],["ゆるす"],["こと"],["さえ"],["する"],["この"],["人","ひと"],["は"],["、"],["いったい"],["、"],["何者","なにもの"],["だろう"],["」"],["。"]]},{"verse":50,"text":"しかし、イエスは女,おんなにむかって言,いわれた、「あなたの信仰,しんこうがあなたを救,すくったのです。安心,あんしんして行,いきなさい」。","tok":[["しかし"],["、"],["イエス"],["は"],["女","おんな"],["に"],["むかって"],["言われた","いわれた"],["、"],["「"],["あなた"],["の"],["信仰","しんこう"],["が"],["あなた"],["を"],["救った","すくった"],["の"],["です"],["。"],["安心","あんしん"],["して"],["行き","いき"],["なさい"],["」"],["。"]]}]
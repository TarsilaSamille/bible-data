[{"verse":1,"text":"さて、過越,すぎこしといわれている除酵祭,じょこうさいが近,ちかづいた。","tok":[["さて"],["、"],["過越","すぎこし"],["と"],["いわれて"],["いる"],["除","じょ"],["酵祭"],["こう"],["さい"],["が"],["近づいた","ちかづいた"],["。"]]},{"verse":2,"text":"祭司長,さいしちょうたちや律法,りっぽう学者,がくしゃたちは、どうかしてイエスを殺,ころそうと計,はかっていた。民衆,みんしゅうを恐,おそれていたからである。","tok":[["祭司長","さいしちょう"],["たち"],["や"],["律法学者","りっぽうがくしゃ"],["たち"],["は"],["、"],["どう"],["か"],["して"],["イエス"],["を"],["殺そう","ころそう"],["と"],["計って","はかって"],["いた"],["。"],["民衆","みんしゅう"],["を"],["恐れて","おそれて"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":3,"text":"そのとき、十二弟子,でしのひとりで、イスカリオテと呼,よばれていたユダに、サタンがはいった。","tok":[["その"],["とき"],["、"],["十二","じゅうに"],["弟子","でし"],["の"],["ひとり"],["で"],["、"],["イスカリオテ"],["と"],["呼ばれて","よばれて"],["いた"],["ユダ"],["に"],["、"],["サタン"],["が"],["はいった"],["。"]]},{"verse":4,"text":"すなわち、彼,かれは祭司長,さいしちょうたちや宮守,みやもりがしらたちのところへ行,いって、どうしてイエスを彼,かれらに渡,わたそうかと、その方法,ほうほうについて協議,きょうぎした。","tok":[["すなわち"],["、"],["彼","かれ"],["は"],["祭司長","さいしちょう"],["たち"],["や"],["宮守","みやもり"],["がしら"],["たち"],["の"],["ところ"],["へ"],["行って","いって"],["、"],["どう"],["して"],["イエス"],["を"],["彼","かれ"],["ら"],["に"],["渡そう","わたそう"],["か"],["と"],["、"],["その"],["方法","ほうほう"],["について"],["協議","きょうぎ"],["した"],["。"]]},{"verse":5,"text":"彼,かれらは喜,よろこんで、ユダに金,かねを与,あたえる取決,とりきめをした。","tok":[["彼","かれ"],["ら"],["は"],["喜こんで","よろこんで"],["、"],["ユダ"],["に"],["金","かね"],["を"],["与える","あたえる"],["取決","とりきめ"],["を"],["した"],["。"]]},{"verse":6,"text":"ユダはそれを承諾,しょうだくした。そして、群衆,ぐんしゅうのいないときにイエスを引,ひき渡,わたそうと、機会,きかいをねらっていた。","tok":[["ユダ"],["は"],["それ"],["を"],["承諾","しょうだく"],["した"],["。"],["そして"],["、"],["群衆","ぐんしゅう"],["の"],["いない"],["とき"],["に"],["イエス"],["を"],["引渡そう","ひきわたそう"],["と"],["、"],["機会","きかい"],["を"],["ねらって"],["いた"],["。"]]},{"verse":7,"text":"さて、過越,すぎこしの小羊,こひつじをほふるべき除酵祭,じょこうさいの日,ひがきたので、","tok":[["さて"],["、"],["過越","すぎこし"],["の"],["小羊","こひつじ"],["を"],["ほふるべき"],["除","じょ"],["酵祭"],["の"],["日","ひ"],["が"],["きた"],["ので"],["、"]]},{"verse":8,"text":"イエスはペテロとヨハネとを使,つかいに出,だして言,いわれた、「行,いって、過越,すぎこしの食事,しょくじができるように準備,じゅんびをしなさい」。","tok":[["イエス"],["は"],["ペテロ"],["と"],["ヨハネ"],["と"],["を"],["使","つかい"],["に"],["出して","だして"],["言われた","いわれた"],["、"],["「"],["行って","いって"],["、"],["過越","すぎこし"],["の"],["食事","しょくじ"],["が"],["できる"],["よう"],["に"],["準備","じゅんび"],["を"],["し"],["なさい"],["」"],["。"]]},{"verse":9,"text":"彼,かれらは言,いった、「どこに準備,じゅんびをしたらよいのですか」。","tok":[["彼","かれ"],["ら"],["は"],["言った","いった"],["、"],["「"],["どこ"],["に"],["準備","じゅんび"],["を"],["したら"],["よい"],["の"],["です"],["か"],["」"],["。"]]},{"verse":10,"text":"イエスは言,いわれた、「市内,しないにはいったら、水,みずがめを持,もっている男,おとこに出会,であうであろう。その人,ひとがはいる家,いえまでついて行,いって、","tok":[["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["市内","しない"],["に"],["はいったら"],["、"],["水がめ","みずがめ"],["を"],["持って","もって"],["いる"],["男","おとこ"],["に"],["出会うで","であうで"],["あろう"],["。"],["その"],["人","ひと"],["が"],["はいる"],["家","いえ"],["まで"],["ついて"],["行って","いって"],["、"]]},{"verse":11,"text":"その家,いえの主人,しゅじんに言,いいなさい、『弟子,でしたちと一緒,いっしょに過越,すぎこしの食事,しょくじをする座敷,ざしきはどこか、と先生,せんせいが言,いっておられます』。","tok":[["その"],["家","いえ"],["の"],["主人","しゅじん"],["に"],["言い","いい"],["なさい"],["、"],["『"],["弟子","でし"],["たち"],["と"],["一緒","いっしょ"],["に"],["過越","すぎこし"],["の"],["食事","しょくじ"],["を"],["する"],["座敷","ざしき"],["は"],["どこ"],["か"],["、"],["と"],["先生","せんせい"],["が"],["言って","いって"],["おられます"],["』"],["。"]]},{"verse":12,"text":"すると、その主人,しゅじんは席,せきの整,ととのえられた二階,かいの広間,ひろまを見,みせてくれるから、そこに用意,よういをしなさい」。","tok":[["する"],["と"],["、"],["その"],["主人","しゅじん"],["は"],["席","せき"],["の"],["整えられた","ととのえられた"],["二","に"],["階","かい"],["の"],["広間","ひろま"],["を"],["見せて","みせて"],["くれる"],["から"],["、"],["そこ"],["に"],["用意","ようい"],["を"],["し"],["なさい"],["」"],["。"]]},{"verse":13,"text":"弟子,でしたちは出,でて行,いってみると、イエスが言,いわれたとおりであったので、過越,すぎこしの食事,しょくじの用意,よういをした。","tok":[["弟子","でし"],["たち"],["は"],["出て","でて"],["行って","いって"],["みる"],["と"],["、"],["イエス"],["が"],["言われた","いわれた"],["とおり"],["で"],["あった"],["ので"],["、"],["過越","すぎこし"],["の"],["食事","しょくじ"],["の"],["用意","ようい"],["を"],["した"],["。"]]},{"verse":14,"text":"時間,じかんになったので、イエスは食卓,しょくたくにつかれ、使徒,しとたちも共,ともに席,せきについた。","tok":[["時間","じかん"],["に"],["なった"],["ので"],["、"],["イエス"],["は"],["食卓","しょくたく"],["に"],["つかれ"],["、"],["使徒","しと"],["たち"],["も"],["共","とも"],["に"],["席","せき"],["に"],["ついた"],["。"]]},{"verse":15,"text":"イエスは彼,かれらに言,いわれた、「わたしは苦,くるしみを受,うける前,まえに、あなたがたとこの過越,すぎこしの食事,しょくじをしようと、切,せつに望,のぞんでいた。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["わたし"],["は"],["苦しみ","くるしみ"],["を"],["受る","うける"],["前","まえ"],["に"],["、"],["あなた"],["がた"],["と"],["この"],["過越","すぎこし"],["の"],["食事","しょくじ"],["を"],["しよう"],["と"],["、"],["切に","せつに"],["望んで","のぞんで"],["いた"],["。"]]},{"verse":16,"text":"あなたがたに言,いって置,おくが、神,かみの国,くにで過越,すぎこしが成就,じょうじゅする時,ときまでは、わたしは二度,どと、この過越,すぎこしの食事,しょくじをすることはない」。","tok":[["あなた"],["がた"],["に"],["言って","いって"],["置く","おく"],["が"],["、"],["神","かみ"],["の"],["国","くに"],["で"],["過越","すぎこし"],["が"],["成就","じょうじゅ"],["する"],["時","とき"],["まで"],["は"],["、"],["わたし"],["は"],["二","に"],["度","ど"],["と"],["、"],["この"],["過越","すぎこし"],["の"],["食事","しょくじ"],["を"],["する"],["こと"],["は"],["ない"],["」"],["。"]]},{"verse":17,"text":"そして杯,さかずきを取,とり、感謝,かんしゃして言,いわれた、「これを取,とって、互,たがいに分,わけて飲,のめ。","tok":[["そして"],["杯","さかずき"],["を"],["取","とり"],["、"],["感謝","かんしゃ"],["して"],["言われた","いわれた"],["、"],["「"],["これ"],["を"],["取って","とって"],["、"],["互","たがい"],["に"],["分けて","わけて"],["飲め","のめ"],["。"]]},{"verse":18,"text":"あなたがたに言,いっておくが、今,いまからのち神,かみの国,くにが来,くるまでは、わたしはぶどうの実,みから造,つくったものを、いっさい飲,のまない」。","tok":[["あなた"],["がた"],["に"],["言って","いって"],["おく"],["が"],["、"],["今","いま"],["から"],["のち"],["神","かみ"],["の"],["国","くに"],["が"],["来る","くる"],["まで"],["は"],["、"],["わたし"],["は"],["ぶどう"],["の"],["実ら","みから"],["造った","つくった"],["もの"],["を"],["、"],["いっさい"],["飲まない","のまない"],["」"],["。"]]},{"verse":19,"text":"またパンを取,とり、感謝,かんしゃしてこれをさき、弟子,でしたちに与,あたえて言,いわれた、「これは、あなたがたのために与,あたえるわたしのからだである。わたしを記念,きねんするため、このように行,おこないなさい」。","tok":[["また"],["パン"],["を"],["取","とり"],["、"],["感謝","かんしゃ"],["して"],["これ"],["を"],["さき"],["、"],["弟子","でし"],["たち"],["に"],["与","あたえ"],["て"],["言われた","いわれた"],["、"],["「"],["これ"],["は"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["与える","あたえる"],["わたし"],["の"],["からだ"],["で"],["ある"],["。"],["わたし"],["を"],["記念","きねん"],["する"],["ため"],["、"],["この"],["よう"],["に"],["行ない","おこない"],["なさい"],["」"],["。"]]},{"verse":20,"text":"食事,しょくじののち、杯,さかずきも同,おなじ様,ようにして言,いわれた、「この杯,さかずきは、あなたがたのために流,ながすわたしの血,ちで立,たてられる新,あたらしい契約,けいやくである。","tok":[["食事","しょくじ"],["の"],["のち"],["、"],["杯","さかずき"],["も"],["同じ","おなじ"],["様","よう"],["に"],["して"],["言われた","いわれた"],["、"],["「"],["この"],["杯","さかずき"],["は"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["流す","ながす"],["わたし"],["の"],["血","ち"],["で"],["立られる","たてられる"],["新らしい","あたらしい"],["契約","けいやく"],["で"],["ある"],["。"]]},{"verse":21,"text":"しかし、そこに、わたしを裏切,うらぎる者,ものが、わたしと一緒,いっしょに食卓,しょくたくに手,てを置,おいている。","tok":[["しかし"],["、"],["そこ"],["に"],["、"],["わたし"],["を"],["裏切る","うらぎる"],["者","もの"],["が"],["、"],["わたし"],["と"],["一緒","いっしょ"],["に"],["食卓","しょくたく"],["に"],["手","て"],["を"],["置いて","おいて"],["いる"],["。"]]},{"verse":22,"text":"人,ひとの子,こは定,さだめられたとおりに、去,さって行,いく。しかし人,ひとの子,こを裏切,うらぎるその人,ひとは、わざわいである」。","tok":[["人","ひと"],["の"],["子","こ"],["は"],["定められた","さだめられた"],["とおり"],["に"],["、"],["去て","さって"],["行く","いく"],["。"],["しかし"],["人","ひと"],["の"],["子","こ"],["を"],["裏切る","うらぎる"],["その"],["人","ひと"],["は"],["、"],["わざわい"],["で"],["ある"],["」"],["。"]]},{"verse":23,"text":"弟子,でしたちは、自分,じぶんたちのうちのだれが、そんな事,ことをしようとしているのだろうと、互,たがいに論,ろんじはじめた。","tok":[["弟子","でし"],["たち"],["は"],["、"],["自分","じぶん"],["たち"],["の"],["うち"],["の"],["だれ"],["が"],["、"],["そんな"],["事","こと"],["を"],["しよう"],["として"],["いる"],["の"],["だろう"],["と"],["、"],["互","たがい"],["に"],["論じ","ろんじ"],["はじめた"],["。"]]},{"verse":24,"text":"それから、自分,じぶんたちの中,なかでだれがいちばん偉,えらいだろうかと言,いって、争論,そうろんが彼,かれらの間,あいだに、起,おこった。","tok":[["それ"],["から"],["、"],["自分","じぶん"],["たち"],["の"],["中","なか"],["で"],["だれ"],["が"],["いちばん"],["偉いだろう","えらいだろう"],["か"],["と"],["言って","いって"],["、"],["争論","そうろん"],["が"],["彼","かれ"],["ら"],["の"],["間","あいだ"],["に"],["、"],["起こった","おこった"],["。"]]},{"verse":25,"text":"そこでイエスが言,いわれた、「異邦,いほうの王,おうたちはその民,たみの上,うえに君臨,くんりんし、また、権力,けんりょくをふるっている者,ものたちは恩人,おんじんと呼,よばれる。","tok":[["そこ"],["で"],["イエス"],["が"],["言われた","いわれた"],["、"],["「"],["異邦","いほう"],["の"],["王","おう"],["たち"],["は"],["その"],["民","たみ"],["の"],["上","うえ"],["に"],["君臨","くんりん"],["し"],["、"],["また"],["、"],["権力","けんりょく"],["を"],["ふるって"],["いる"],["者","もの"],["たち"],["は"],["恩人","おんじん"],["と"],["呼ばれる","よばれる"],["。"]]},{"verse":26,"text":"しかし、あなたがたは、そうであってはならない。かえって、あなたがたの中,なかでいちばん偉,えらい人,ひとはいちばん若,わかい者,もののように、指導,しどうする人,ひとは仕,つかえる者,もののようになるべきである。","tok":[["しかし"],["、"],["あなた"],["がた"],["は"],["、"],["そう"],["で"],["あって"],["は"],["ならない"],["。"],["かえって"],["、"],["あなた"],["がた"],["の"],["中","なか"],["で"],["いちばん"],["偉い","えらい"],["人","ひと"],["は"],["いちばん"],["若い","わかい"],["者","もの"],["の"],["よう"],["に"],["、"],["指導","しどう"],["する"],["人","ひと"],["は"],["仕える","つかえる"],["者","もの"],["の"],["よう"],["に"],["なるべきで"],["ある"],["。"]]},{"verse":27,"text":"食卓,しょくたくにつく人,ひとと給仕,きゅうじする者,ものと、どちらが偉,えらいのか。食卓,しょくたくにつく人,ひとの方,ほうではないか。しかし、わたしはあなたがたの中,なかで、給仕,きゅうじをする者,もののようにしている。","tok":[["食卓","しょくたく"],["に"],["つく"],["人","ひと"],["と"],["給仕","きゅうじ"],["する"],["者","もの"],["と"],["、"],["どちら"],["が"],["偉い","えらい"],["の"],["か"],["。"],["食卓","しょくたく"],["に"],["つく"],["人","ひと"],["の"],["方","ほう"],["で"],["は"],["ない"],["か"],["。"],["しかし"],["、"],["わたし"],["は"],["あなた"],["がた"],["の"],["中","なか"],["で"],["、"],["給仕","きゅうじ"],["を"],["する"],["者","もの"],["の"],["よう"],["に"],["して"],["いる"],["。"]]},{"verse":28,"text":"あなたがたは、わたしの試錬,しれんのあいだ、わたしと一緒,いっしょに最後,さいごまで忍,しのんでくれた人,ひとたちである。","tok":[["あなた"],["がた"],["は"],["、"],["わたし"],["の"],["試錬","しれん"],["の"],["あいだ"],["、"],["わたし"],["と"],["一緒","いっしょ"],["に"],["最後","さいご"],["まで"],["忍んで","しのんで"],["くれた"],["人","ひと"],["たち"],["で"],["ある"],["。"]]},{"verse":29,"text":"それで、わたしの父,ちちが国,くにの支配,しはいをわたしにゆだねてくださったように、わたしもそれをあなたがたにゆだね、","tok":[["それ"],["で"],["、"],["わたし"],["の"],["父","ちち"],["が"],["国","くに"],["の"],["支配","しはい"],["を"],["わたし"],["に"],["ゆだねて"],["くださった"],["よう"],["に"],["、"],["わたし"],["も"],["それ"],["を"],["あなた"],["がた"],["に"],["ゆだね"],["、"]]},{"verse":30,"text":"わたしの国,くにで食卓,しょくたくについて飲,のみ食,くいをさせ、また位,くらいに座,ざしてイスラエルの十二の部族,ぶぞくをさばかせるであろう。","tok":[["わたし"],["の"],["国","くに"],["で"],["食卓","しょくたく"],["について"],["飲み食い","のみくい"],["を"],["させ"],["、"],["また"],["位","くらい"],["に"],["座して","ざして"],["イスラエル"],["の"],["十二","じゅうに"],["の"],["部族","ぶぞく"],["を"],["さばかせるで"],["あろう"],["。"]]},{"verse":31,"text":"シモン、シモン、見,みよ、サタンはあなたがたを麦,むぎのようにふるいにかけることを願,ねがって許,ゆるされた。","tok":[["シモン"],["、"],["シモン"],["、"],["見よ","みよ"],["、"],["サタン"],["は"],["あなた"],["がた"],["を"],["麦","むぎ"],["の"],["よう"],["に"],["ふるい"],["に"],["かける"],["こと"],["を"],["願って","ねがって"],["許された","ゆるされた"],["。"]]},{"verse":32,"text":"しかし、わたしはあなたの信仰,しんこうがなくならないように、あなたのために祈,いのった。それで、あなたが立,たち直,なおったときには、兄弟,きょうだいたちを力,ちからづけてやりなさい」。","tok":[["しかし"],["、"],["わたし"],["は"],["あなた"],["の"],["信仰","しんこう"],["が"],["なくならない"],["よう"],["に"],["、"],["あなた"],["の"],["ため"],["に"],["祈った","いのった"],["。"],["それ"],["で"],["、"],["あなた"],["が"],["立ち直った","たちなおった"],["とき"],["に"],["は"],["、"],["兄弟","きょうだい"],["たち"],["を"],["力づけて","ちからづけて"],["やり"],["なさい"],["」"],["。"]]},{"verse":33,"text":"シモンが言,いった、「主,しゅよ、わたしは獄,ごくにでも、また死,しに至,いたるまでも、あなたとご一緒,いっしょに行,いく覚悟,かくごです」。","tok":[["シモン"],["が"],["言った","いった"],["、"],["「"],["主","しゅ"],["よ"],["、"],["わたし"],["は"],["獄","ごく"],["に"],["で"],["も"],["、"],["また"],["死","し"],["に"],["至る","いたる"],["まで"],["も"],["、"],["あなた"],["と"],["ご一緒","ごいっしょ"],["に"],["行く","いく"],["覚悟","かくご"],["です"],["」"],["。"]]},{"verse":34,"text":"するとイエスが言,いわれた、「ペテロよ、あなたに言,いっておく。きょう、鶏,にわとりが鳴,なくまでに、あなたは三度,どわたしを知,しらないと言,いうだろう」。","tok":[["する"],["と"],["イエス"],["が"],["言われた","いわれた"],["、"],["「"],["ペテロ"],["よ"],["、"],["あなた"],["に"],["言って","いって"],["おく"],["。"],["きょう"],["、"],["鶏","にわとり"],["が"],["鳴く","なく"],["まで"],["に"],["、"],["あなた"],["は"],["三","さん"],["度","ど"],["を"],["知らない","しらない"],["と"],["言うだろう","いうだろう"],["」"],["。"]]},{"verse":35,"text":"そして彼,かれらに言,いわれた、「わたしが財布,さいふも袋,ふくろもくつも持,もたせずにあなたがたをつかわしたとき、何,なにかこまったことがあったか」。彼,かれらは、「いいえ、何,なにもありませんでした」と答,こたえた。","tok":[["そして"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["わたし"],["が"],["財布","さいふ"],["も"],["袋","ふくろ"],["も"],["くつ"],["も"],["持たせず","もたせず"],["に"],["あなた"],["がた"],["を"],["つかわした"],["とき"],["、"],["何に","なに"],["か"],["こまった"],["こと"],["が"],["あった"],["か"],["」"],["。"],["彼","かれ"],["ら"],["は"],["、"],["「"],["いいえ"],["、"],["何に","なに"],["も"],["ありませんでした"],["」"],["と"],["答","こたえ"],["た"],["。"]]},{"verse":36,"text":"そこで言,いわれた、「しかし今,いまは、財布,さいふのあるものは、それを持,もって行,いけ。袋,ふくろも同様,どうように持,もって行,いけ。また、つるぎのない者,ものは、自分,じぶんの上着,うわぎを売,うって、それを買,かうがよい。","tok":[["そこ"],["で"],["言われた","いわれた"],["、"],["「"],["しかし"],["今","いま"],["は"],["、"],["財布","さいふ"],["の"],["ある"],["もの"],["は"],["、"],["それ"],["を"],["持って","もって"],["行け","いけ"],["。"],["袋","ふくろ"],["も"],["同様","どうよう"],["に"],["持って","もって"],["行け","いけ"],["。"],["また"],["、"],["つるぎ"],["の"],["ない"],["者","もの"],["は"],["、"],["自分","じぶん"],["の"],["上着","うわぎ"],["を"],["売って","うって"],["、"],["それ"],["を"],["買う","かう"],["が"],["よい"],["。"]]},{"verse":37,"text":"あなたがたに言,いうが、『彼,かれは罪人,つみびとのひとりに数,かぞえられた』としるしてあることは、わたしの身,みに成,なしとげられねばならない。そうだ、わたしに係,かかわることは成就,じょうじゅしている」。","tok":[["あなた"],["がた"],["に"],["言う","いう"],["が"],["、"],["『"],["彼","かれ"],["は"],["罪人","つみびと"],["の"],["ひとり"],["に"],["数えられた","かぞえられた"],["』"],["と"],["しるして"],["ある"],["こと"],["は"],["、"],["わたし"],["の"],["身","み"],["に"],["成しとげられねば","なしとげられねば"],["ならない"],["。"],["そう"],["だ"],["、"],["わたし"],["に"],["係わる","かかわる"],["こと"],["は"],["成就","じょうじゅ"],["して"],["いる"],["」"],["。"]]},{"verse":38,"text":"弟子,でしたちが言,いった、「主,しゅよ、ごらんなさい、ここにつるぎが二振,ふりございます」。イエスは言,いわれた、「それでよい」。","tok":[["弟子","でし"],["たち"],["が"],["言った","いった"],["、"],["「"],["主","しゅ"],["よ"],["、"],["ごらん"],["なさい"],["、"],["ここ"],["に"],["つるぎ"],["が"],["二","に"],["振り","ふり"],["ございます"],["」"],["。"],["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["それ"],["で"],["よい"],["」"],["。"]]},{"verse":39,"text":"イエスは出,でて、いつものようにオリブ山,やまに行,いかれると、弟子,でしたちも従,したがって行,いった。","tok":[["イエス"],["は"],["出て","でて"],["、"],["いつも"],["の"],["よう"],["に"],["オリブ山","おりぶやま"],["に"],["行かれる","いかれる"],["と"],["、"],["弟子","でし"],["たち"],["も"],["従って","したがって"],["行った","いった"],["。"]]},{"verse":40,"text":"いつもの場所,ばしょに着,ついてから、彼,かれらに言,いわれた、「誘惑,ゆうわくに陥,おちいらないように祈,いのりなさい」。","tok":[["いつも"],["の"],["場所","ばしょ"],["に"],["着いて","ついて"],["から"],["、"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["誘惑","ゆうわく"],["に"],["陥ち","おち"],["いらない"],["よう"],["に"],["祈","いのり"],["なさい"],["」"],["。"]]},{"verse":41,"text":"そしてご自分,じぶんは、石,いしを投,なげてとどくほど離,はなれたところへ退,しりぞき、ひざまずいて、祈,いのって言,いわれた、","tok":[["そして"],["ご自分","ごじぶん"],["は"],["、"],["石","いし"],["を"],["投て","なげて"],["とどく"],["ほど"],["離れた","はなれた"],["ところ"],["へ"],["退ぞき","しりぞき"],["、"],["ひざまずいて"],["、"],["祈って","いのって"],["言われた","いわれた"],["、"]]},{"verse":42,"text":"「父,ちちよ、みこころならば、どうぞ、この杯,さかずきをわたしから取,とりのけてください。しかし、わたしの思,おもいではなく、みこころが成,なるようにしてください」。","tok":[["「"],["父","ちち"],["よ"],["、"],["みこころ"],["ならば"],["、"],["どうぞ"],["、"],["この"],["杯","さかずき"],["を"],["わたし"],["から"],["取","とり"],["のけて"],["ください"],["。"],["しかし"],["、"],["わたし"],["の"],["思い","おもい"],["で"],["は"],["なく"],["、"],["みこころ"],["が"],["成る","なる"],["よう"],["に"],["して"],["ください"],["」"],["。"]]},{"verse":43,"text":"そのとき、御使,みつかいが天,てんからあらわれてイエスを力,ちからづけた。","tok":[["その"],["とき"],["、"],["御使","み"],["つかい"],["が"],["天","てん"],["から"],["あらわれて"],["イエス"],["を"],["力づけた","ちからづけた"],["。"]]},{"verse":44,"text":"イエスは苦,くるしみもだえて、ますます切,せつに祈,いのられた。そして、その汗,あせが血,ちのしたたりのように地,ちに落,おちた。","tok":[["イエス"],["は"],["苦しみもだえて","くるしみもだえて"],["、"],["ますます"],["切に","せつに"],["祈られた","いのられた"],["。"],["そして"],["、"],["その"],["汗","あせ"],["が"],["血","ち"],["の"],["したたり"],["の"],["よう"],["に"],["地","ち"],["に"],["落","おち"],["た"],["。"]]},{"verse":45,"text":"祈,いのりを終,おえて立,たちあがり、弟子,でしたちのところへ行,いかれると、彼,かれらが悲,かなしみのはて寝入,ねいっているのをごらんになって","tok":[["祈","いのり"],["を"],["終えて","おえて"],["立ちあがり","たちあがり"],["、"],["弟子","でし"],["たち"],["の"],["ところ"],["へ"],["行かれる","いかれる"],["と"],["、"],["彼","かれ"],["ら"],["が"],["悲しみ","かなしみ"],["の"],["はて"],["寝入って","ねいって"],["いる"],["の"],["を"],["ごらん"],["に"],["なって"]]},{"verse":46,"text":"言,いわれた、「なぜ眠,ねむっているのか。誘惑,ゆうわくに陥,おちいらないように、起,おきて祈,いのっていなさい」。","tok":[["言われた","いわれた"],["、"],["「"],["なぜ"],["眠って","ねむって"],["いる"],["の"],["か"],["。"],["誘惑","ゆうわく"],["に"],["陥ち","おち"],["いらない"],["よう"],["に"],["、"],["起きて","おきて"],["祈って","いのって"],["い"],["なさい"],["」"],["。"]]},{"verse":47,"text":"イエスがまだそう言,いっておられるうちに、そこに群衆,ぐんしゅうが現,あらわれ、十二弟子,でしのひとりでユダという者,ものが先頭,せんとうに立,たって、イエスに接吻,せっぷんしようとして近,ちかづいてきた。","tok":[["イエス"],["が"],["まだ"],["そう"],["言って","いって"],["おられる"],["うち"],["に"],["、"],["そこ"],["に"],["群衆","ぐんしゅう"],["が"],["現われ","あらわれ"],["、"],["十二","じゅうに"],["弟子","でし"],["の"],["ひとり"],["で"],["ユダ"],["と"],["いう"],["者","もの"],["が"],["先頭","せんとう"],["に"],["立って","たって"],["、"],["イエス"],["に"],["接吻","せっぷん"],["しよう"],["として"],["近づいて","ちかづいて"],["きた"],["。"]]},{"verse":48,"text":"そこでイエスは言,いわれた、「ユダ、あなたは接吻,せっぷんをもって人,ひとの子,こを裏切,うらぎるのか」。","tok":[["そこ"],["で"],["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["ユダ"],["、"],["あなた"],["は"],["接吻","せっぷん"],["を"],["もって"],["人","ひと"],["の"],["子","こ"],["を"],["裏切る","うらぎる"],["の"],["か"],["」"],["。"]]},{"verse":49,"text":"イエスのそばにいた人,ひとたちは、事,ことのなりゆきを見,みて、「主,しゅよ、つるぎで切,きりつけてやりましょうか」と言,いって、","tok":[["イエス"],["の"],["そば"],["に"],["いた"],["人","ひと"],["たち"],["は"],["、"],["事","こと"],["の"],["なりゆき"],["を"],["見て","みて"],["、"],["「"],["主","しゅ"],["よ"],["、"],["つるぎ"],["で"],["切りつけて","きりつけて"],["やりましょう"],["か"],["」"],["と"],["言って","いって"],["、"]]},{"verse":50,"text":"そのうちのひとりが、祭司長,さいしちょうの僕,しもべに切,きりつけ、その右,みぎの耳,みみを切,きり落,おとした。","tok":[["その"],["うち"],["の"],["ひとり"],["が"],["、"],["祭司長","さいしちょう"],["の"],["僕","し"],["も"],["べ"],["に"],["切りつけ","きりつけ"],["、"],["その"],["右","みぎ"],["の"],["耳","みみ"],["を"],["切り落とした","きりおとした"],["。"]]},{"verse":51,"text":"イエスはこれに対,たいして言,いわれた、「それだけでやめなさい」。そして、その僕,しもべの耳,みみに手,てを触,ふれて、おいやしになった。","tok":[["イエス"],["は"],["これ"],["に対して","にたいして"],["言われた","いわれた"],["、"],["「"],["それ"],["だけ"],["で"],["やめ"],["なさい"],["」"],["。"],["そして"],["、"],["その"],["僕","し"],["も"],["べ"],["の"],["耳","みみ"],["に"],["手","て"],["を"],["触","ふれ"],["て"],["、"],["おいやし"],["に"],["なった"],["。"]]},{"verse":52,"text":"それから、自分,じぶんにむかって来,くる祭司長,さいしちょう、宮守,みやもりがしら、長老,ちょうろうたちに対,たいして言,いわれた、「あなたがたは、強盗,ごうとうにむかうように剣,けんや棒,ぼうを持,もって出,でてきたのか。","tok":[["それ"],["から"],["、"],["自分","じぶん"],["に"],["むかって"],["来る","くる"],["祭","まつり"],["司長","しちょう"],["、"],["宮守","みやもり"],["が"],["しら"],["、"],["長老","ちょうろう"],["たち"],["に対して","にたいして"],["言われた","いわれた"],["、"],["「"],["あなた"],["がた"],["は"],["、"],["強盗","ごうとう"],["に"],["むかう"],["よう"],["に"],["剣","けん"],["や"],["棒","ぼう"],["を"],["持って","もって"],["出て","でて"],["きた"],["の"],["か"],["。"]]},{"verse":53,"text":"毎日,まいにちあなたがたと一緒,いっしょに宮,みやにいた時,ときには、わたしに手,てをかけなかった。だが、今,いまはあなたがたの時,とき、また、やみの支配,しはいの時,ときである」。","tok":[["毎日","まいにち"],["あなた"],["がた"],["と"],["一緒","いっしょ"],["に"],["宮","みや"],["に"],["いた"],["時","とき"],["に"],["は"],["、"],["わたし"],["に"],["手","て"],["を"],["かけなかった"],["。"],["だ"],["が"],["、"],["今","いま"],["は"],["あなた"],["がた"],["の"],["時","とき"],["、"],["また"],["、"],["やみ"],["の"],["支配","しはい"],["の"],["時","とき"],["で"],["ある"],["」"],["。"]]},{"verse":54,"text":"それから人々,ひとびとはイエスを捕,とらえ、ひっぱって大祭司,だいさいしの邸宅,ていたくへつれて行,いった。ペテロは遠,とおくからついて行,いった。","tok":[["それ"],["から"],["人々","ひとびと"],["は"],["イエス"],["を"],["捕らえ","とらえ"],["、"],["ひっぱって"],["大","だい"],["祭司","さいし"],["の"],["邸宅","ていたく"],["へ"],["つれて"],["行った","いった"],["。"],["ペテロ"],["は"],["遠く","とおく"],["から"],["ついて"],["行った","いった"],["。"]]},{"verse":55,"text":"人々,ひとびとは中庭,なかにわのまん中,なかに火,ひをたいて、一緒,いっしょにすわっていたので、ペテロもその中,なかにすわった。","tok":[["人々","ひとびと"],["は"],["中庭","なかにわ"],["の"],["まん中","まんなか"],["に"],["火","ひ"],["を"],["たいて"],["、"],["一緒","いっしょ"],["に"],["すわって"],["いた"],["ので"],["、"],["ペテロ"],["も"],["その"],["中","なか"],["に"],["すわった"],["。"]]},{"verse":56,"text":"すると、ある女中,じょちゅうが、彼,かれが火,ひのそばにすわっているのを見,み、彼,かれを見,みつめて、「この人,ひともイエスと一緒,いっしょにいました」と言,いった。","tok":[["する"],["と"],["、"],["ある"],["女中","じょちゅう"],["が"],["、"],["彼","かれ"],["が"],["火","ひ"],["の"],["そば"],["に"],["すわって"],["いる"],["の"],["を"],["見","み"],["、"],["彼","かれ"],["を"],["見つめて","みつめて"],["、"],["「"],["この"],["人","ひと"],["も"],["イエス"],["と"],["一緒","いっしょ"],["に"],["いました"],["」"],["と"],["言った","いった"],["。"]]},{"verse":57,"text":"ペテロはそれを打,うち消,けして、「わたしはその人,ひとを知,しらない」と言,いった。","tok":[["ペテロ"],["は"],["それ"],["を"],["打ち消して","うちけして"],["、"],["「"],["わたし"],["は"],["その"],["人","ひと"],["を"],["知らない","しらない"],["」"],["と"],["言った","いった"],["。"]]},{"verse":58,"text":"しばらくして、ほかの人,ひとがペテロを見,みて言,いった、「あなたもあの仲間,なかまのひとりだ」。するとペテロは言,いった、「いや、それはちがう」。","tok":[["しばらく"],["して"],["、"],["ほか"],["の"],["人","ひと"],["が"],["ペテロ"],["を"],["見て","みて"],["言った","いった"],["、"],["「"],["あなた"],["も"],["あの"],["仲間","なかま"],["の"],["ひとり"],["だ"],["」"],["。"],["する"],["と"],["ペテロ"],["は"],["言った","いった"],["、"],["「"],["いや"],["、"],["それ"],["は"],["ちがう"],["」"],["。"]]},{"verse":59,"text":"約,やく一時間,じかんたってから、またほかの者,ものが言,いい張,はった、「たしかにこの人,ひともイエスと一緒,いっしょだった。この人,ひともガリラヤ人,びとなのだから」。","tok":[["約","やく"],["一","いち"],["時間","じかん"],["ら"],["、"],["また"],["ほか"],["の"],["者","もの"],["が"],["言い張った","いいはった"],["、"],["「"],["たしか"],["に"],["この"],["人","ひと"],["も"],["イエス"],["と"],["一緒","いっしょ"],["だった"],["。"],["この"],["人","ひと"],["も"],["ガリラヤ"],["人","びとな"],["の"],["だ"],["から"],["」"],["。"]]},{"verse":60,"text":"ペテロは言,いった、「あなたの言,いっていることは、わたしにわからない」。すると、彼,かれがまだ言,いい終,おわらぬうちに、たちまち、鶏,にわとりが鳴,ないた。","tok":[["ペテロ"],["は"],["言った","いった"],["、"],["「"],["あなた"],["の"],["言って","いって"],["いる"],["こと"],["は"],["、"],["わたし"],["に"],["わからない"],["」"],["。"],["する"],["と"],["、"],["彼","かれ"],["が"],["まだ"],["言い","いい"],["終わらぬ","おわらぬ"],["うち"],["に"],["、"],["たちまち"],["、"],["鶏","にわとり"],["が"],["鳴いた","ないた"],["。"]]},{"verse":61,"text":"主,しゅは振,ふりむいてペテロを見,みつめられた。そのときペテロは、「きょう、鶏,にわとりが鳴,なく前,まえに、三度,どわたしを知,しらないと言,いうであろう」と言,いわれた主,しゅのお言葉,ことばを思,おもい出,だした。","tok":[["主","しゅ"],["は"],["振りむいて","ふりむいて"],["ペテロ"],["を"],["見つめられた","みつめられた"],["。"],["その"],["とき"],["ペテロ"],["は"],["、"],["「"],["きょう"],["、"],["鶏","にわとり"],["が"],["鳴く","なく"],["前","まえ"],["に"],["、"],["三","さん"],["度","ど"],["を"],["知らない","しらない"],["と"],["言うで","いうで"],["あろう"],["」"],["と"],["言われた","いわれた"],["主","しゅ"],["の"],["お言葉","おことば"],["を"],["思い出した","おもいだした"],["。"]]},{"verse":62,"text":"そして外,そとへ出,でて、激,はげしく泣,ないた。","tok":[["そして"],["外","そと"],["へ"],["出て","でて"],["、"],["激しく","はげしく"],["泣いた","ないた"],["。"]]},{"verse":63,"text":"イエスを監視,かんししていた人,ひとたちは、イエスを嘲弄,ちょうろうし、打,うちたたき、","tok":[["イエス"],["を"],["監視","かんし"],["して"],["いた"],["人","ひと"],["たち"],["は"],["、"],["イエス"],["を"],["嘲弄","ちょうろう"],["し"],["、"],["打ちたたき","うちたたき"],["、"]]},{"verse":64,"text":"目,めかくしをして、「言,いいあててみよ。打,うったのは、だれか」ときいたりした。","tok":[["目かくし","めかくし"],["を"],["して"],["、"],["「"],["言いあてて","いいあてて"],["み"],["よ"],["。"],["打った","うった"],["の"],["は"],["、"],["だれ"],["か"],["」"],["と"],["きい"],["たり"],["した"],["。"]]},{"verse":65,"text":"そのほか、いろいろな事,ことを言,いって、イエスを愚弄,ぐろうした。","tok":[["その"],["ほか"],["、"],["いろいろ"],["な"],["事","こと"],["を"],["言って","いって"],["、"],["イエス"],["を"],["愚弄","ぐろう"],["した"],["。"]]},{"verse":66,"text":"夜,よが明,あけたとき、人民,じんみんの長老,ちょうろう、祭司長,さいしちょうたち、律法,りっぽう学者,がくしゃたちが集,あつまり、イエスを議会,ぎかいに引,ひき出,だして言,いった、","tok":[["夜","よ"],["が"],["明けた","あけた"],["とき"],["、"],["人民","じんみん"],["の"],["長老","ちょうろう"],["、"],["祭司長","さいしちょう"],["たち"],["、"],["律法学者","りっぽうがくしゃ"],["たち"],["が"],["集まり","あつまり"],["、"],["イエス"],["を"],["議会","ぎかい"],["に"],["引出して","ひきだして"],["言った","いった"],["、"]]},{"verse":67,"text":"「あなたがキリストなら、そう言,いってもらいたい」。イエスは言,いわれた、「わたしが言,いっても、あなたがたは信,しんじないだろう。","tok":[["「"],["あなた"],["が"],["キリスト"],["なら"],["、"],["そう"],["言って","いって"],["もらいたい"],["」"],["。"],["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["わたし"],["が"],["言って","いって"],["も"],["、"],["あなた"],["がた"],["は"],["信じないだろう","しんじないだろう"],["。"]]},{"verse":68,"text":"また、わたしがたずねても、答,こたえないだろう。","tok":[["また"],["、"],["わたし"],["が"],["たずねて"],["も"],["、"],["答","こたえ"],["ないだろう"],["。"]]},{"verse":69,"text":"しかし、人,ひとの子,こは今,いまからのち、全能,ぜんのうの神,かみの右,みぎに座,ざするであろう」。","tok":[["しかし"],["、"],["人","ひと"],["の"],["子","こ"],["は"],["今","いま"],["から"],["のち"],["、"],["全能","ぜんのう"],["の"],["神","かみ"],["の"],["右","みぎ"],["に"],["座するで","ざするで"],["あろう"],["」"],["。"]]},{"verse":70,"text":"彼,かれらは言,いった、「では、あなたは神,かみの子,こなのか」。イエスは言,いわれた、「あなたがたの言,いうとおりである」。","tok":[["彼","かれ"],["ら"],["は"],["言った","いった"],["、"],["「"],["で"],["は"],["、"],["あなた"],["は"],["神","かみ"],["の"],["子","こ"],["な"],["の"],["か"],["」"],["。"],["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["あなた"],["がた"],["の"],["言う","いう"],["とおり"],["で"],["ある"],["」"],["。"]]},{"verse":71,"text":"すると彼,かれらは言,いった、「これ以上,いじょう、なんの証拠,しょうこがいるか。われわれは直接,ちょくせつ彼,かれの口,くちから聞,きいたのだから」。","tok":[["する"],["と"],["彼","かれ"],["ら"],["は"],["言った","いった"],["、"],["「"],["これ"],["以上","いじょう"],["、"],["なん"],["の"],["証拠","しょうこ"],["が"],["いる"],["か"],["。"],["われわれ"],["は"],["直接","ちょくせつ"],["彼","かれ"],["の"],["口","くち"],["から"],["聞いた","きいた"],["の"],["だ"],["から"],["」"],["。"]]}]
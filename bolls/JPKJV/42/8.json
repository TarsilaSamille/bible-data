[{"verse":1,"text":"そののちイエスは、神,かみの国,くにの福音,ふくいんを説,ときまた伝,つたえながら、町々,まちまち村々,むらむらを巡回,じゅんかいし続,つづけられたが、十二弟子,でしもお供,ともをした。","tok":[["その"],["のち"],["イエス"],["は"],["、"],["神","かみ"],["の"],["国","くに"],["の"],["福音","ふくいん"],["を"],["説き","とき"],["また"],["伝え","つたえ"],["ながら"],["、"],["町々","まちまち"],["村々","むらむら"],["を"],["巡回","じゅんかい"],["し"],["続けられた","つづけられた"],["が"],["、"],["十二","じゅうに"],["弟子","でし"],["しも"],["お供","おとも"],["を"],["した"],["。"]]},{"verse":2,"text":"また悪霊,あくれいを追,おい出,だされ病気,びょうきをいやされた数名,すうめいの婦人,ふじんたち、すなわち、七つの悪霊,あくれいを追,おい出,だしてもらったマグダラと呼,よばれるマリヤ、","tok":[["また"],["悪霊","あくれい"],["を"],["追い出され","おいだされ"],["病気","びょうき"],["を"],["いやされた"],["数","すう"],["名","めい"],["の"],["婦人","ふじん"],["たち"],["、"],["すなわち"],["、"],["七","なな"],["つ"],["の"],["悪霊","あくれい"],["を"],["追い出して","おいだして"],["もらった"],["マグダラ"],["と"],["呼ばれる","よばれる"],["マリヤ"],["、"]]},{"verse":3,"text":"ヘロデの家令,かれいクーザの妻,つまヨハンナ、スザンナ、そのほか多,おおくの婦人,ふじんたちも一緒,いっしょにいて、自分,じぶんたちの持,もち物,ものをもって一行,いっこうに奉仕,ほうしした。","tok":[["ヘロデ"],["の"],["家令","かれい"],["クーザ"],["の"],["妻","つま"],["ヨハンナ"],["、"],["スザンナ"],["、"],["その"],["ほか"],["多く","おおく"],["の"],["婦人","ふじん"],["たち"],["も"],["一緒","いっしょ"],["に"],["いて"],["、"],["自分","じぶん"],["たち"],["の"],["持物","もちもの"],["を"],["もって"],["一行","いっこう"],["に"],["奉仕","ほうし"],["した"],["。"]]},{"verse":4,"text":"さて、大,おおぜいの群衆,ぐんしゅうが集,あつまり、その上,うえ、町々,まちまちからの人,ひとたちがイエスのところに、ぞくぞくと押,おし寄,よせてきたので、一つの譬,たとえで話,はなしをされた、","tok":[["さて"],["、"],["大ぜい","おおぜい"],["の"],["群衆","ぐんしゅう"],["が"],["集まり","あつまり"],["、"],["その"],["上","うえ"],["、"],["町々","まちまち"],["から"],["の"],["人","ひと"],["たち"],["が"],["イエス"],["の"],["ところ"],["に"],["、"],["ぞくぞく"],["と"],["押寄せて","おしよせて"],["きた"],["ので"],["、"],["一","ひと"],["つ"],["の"],["譬","たとえ"],["で"],["話","はなし"],["を"],["された"],["、"]]},{"verse":5,"text":"「種,たねまきが種,たねをまきに出,でて行,いった。まいているうちに、ある種,たねは道,みちばたに落,おち、踏,ふみつけられ、そして空,そらの鳥,とりに食,たべられてしまった。","tok":[["「"],["種まき","たねまき"],["が"],["種","たね"],["を"],["まき"],["に"],["出て","でて"],["行った","いった"],["。"],["まいて"],["いる"],["うち"],["に"],["、"],["ある"],["種","たね"],["は"],["道ばた","みちばた"],["に"],["落","おち"],["、"],["踏みつけられ","ふみつけられ"],["、"],["そして"],["空","そら"],["の"],["鳥","とり"],["に"],["食べられて","たべられて"],["しまった"],["。"]]},{"verse":6,"text":"ほかの種,たねは岩,いわの上,うえに落,おち、はえはしたが水気,みずけがないので枯,かれてしまった。","tok":[["ほか"],["の"],["種","たね"],["は"],["岩","いわ"],["の"],["上","うえ"],["に"],["落","おち"],["、"],["はえ"],["は"],["した"],["が"],["水気","みずけ"],["が"],["ない"],["ので"],["枯て","かれて"],["しまった"],["。"]]},{"verse":7,"text":"ほかの種,たねは、いばらの間,あいだに落,おちたので、いばらも一緒,いっしょに茂,しげってきて、それをふさいでしまった。","tok":[["ほか"],["の"],["種","たね"],["は"],["、"],["いばら"],["の"],["間","あいだ"],["に"],["落","おち"],["た"],["ので"],["、"],["いばら"],["も"],["一緒","いっしょ"],["に"],["茂って","しげって"],["きて"],["、"],["それ"],["を"],["ふさいで"],["しまった"],["。"]]},{"verse":8,"text":"ところが、ほかの種,たねは良,よい地,ちに落,おちたので、はえ育,そだって百倍,ばいもの実,みを結,むすんだ」。こう語,かたられたのち、声,こえをあげて「聞,きく耳,みみのある者,ものは聞,きくがよい」と言,いわれた。","tok":[["ところ"],["が"],["、"],["ほか"],["の"],["種","たね"],["は"],["良い","よい"],["地","ち"],["に"],["落","おち"],["た"],["ので"],["、"],["は"],["え"],["育って","そだって"],["百","ひゃく"],["倍","ばい"],["の"],["実","み"],["を"],["結んだ","むすんだ"],["」"],["。"],["こう"],["語られた","かたられた"],["のち"],["、"],["声","こえ"],["を"],["あげて"],["「"],["聞く","きく"],["耳","みみ"],["の"],["ある"],["者","もの"],["は"],["聞く","きく"],["が"],["よい"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":9,"text":"弟子,でしたちは、この譬,たとえはどういう意味,いみでしょうか、とイエスに質問,しつもんした。","tok":[["弟子","でし"],["たち"],["は"],["、"],["この"],["譬","たとえ"],["は"],["どういう"],["意味","いみ"],["でしょう"],["か"],["、"],["と"],["イエス"],["に"],["質問","しつもん"],["した"],["。"]]},{"verse":10,"text":"そこで言,いわれた、「あなたがたには、神,かみの国,くにの奥義,おくぎを知,しることが許,ゆるされているが、ほかの人,ひとたちには、見,みても見,みえず、聞,きいても悟,さとられないために、譬,たとえで話,はなすのである。","tok":[["そこ"],["で"],["言われた","いわれた"],["、"],["「"],["あなた"],["がた"],["に"],["は"],["、"],["神","かみ"],["の"],["国","くに"],["の"],["奥義","おくぎ"],["を"],["知る","しる"],["こと"],["が"],["許されて","ゆるされて"],["いる"],["が"],["、"],["ほか"],["の"],["人","ひと"],["たち"],["に"],["は"],["、"],["見て","みて"],["も"],["見えず","みえず"],["、"],["聞いて","きいて"],["も"],["悟られない","さとられない"],["ため"],["に"],["、"],["譬","たとえ"],["で"],["話す","はなす"],["ので"],["ある"],["。"]]},{"verse":11,"text":"この譬,たとえはこういう意味,いみである。種,たねは神,かみの言,ことばである。","tok":[["この"],["譬","たとえ"],["は"],["こう"],["いう"],["意味","いみ"],["で"],["ある"],["。"],["種","たね"],["は"],["神","かみ"],["の"],["言","こ"],["と"],["ば"],["で"],["ある"],["。"]]},{"verse":12,"text":"道,みちばたに落,おちたのは、聞,きいたのち、信,しんじることも救,すくわれることもないように、悪魔,あくまによってその心,こころから御言,みことばが奪,うばい取,とられる人,ひとたちのことである。","tok":[["道ばた","みちばた"],["に"],["落","おち"],["た"],["の"],["は"],["、"],["聞いた","きいた"],["のち"],["、"],["信じる","しんじる"],["こと"],["も"],["救われる","すくわれる"],["こと"],["も"],["ない"],["よう"],["に"],["、"],["悪魔","あくま"],["によって"],["その"],["心","こころ"],["から"],["御言","みこと"],["ば"],["が"],["奪い取られる","うばいとられる"],["人","ひと"],["たち"],["の"],["こと"],["で"],["ある"],["。"]]},{"verse":13,"text":"岩,いわの上,うえに落,おちたのは、御言,みことばを聞,きいた時,ときには喜,よろこんで受,うけいれるが、根,ねが無,ないので、しばらくは信,しんじていても、試錬,しれんの時,ときが来,くると、信仰,しんこうを捨,すてる人,ひとたちのことである。","tok":[["岩","いわ"],["の"],["上","うえ"],["に"],["落","おち"],["た"],["の"],["は"],["、"],["御言","みこと"],["ば"],["を"],["聞いた","きいた"],["時","とき"],["に"],["は"],["喜こんで","よろこんで"],["受けいれる","うけいれる"],["が"],["、"],["根","ね"],["が"],["無い","ない"],["ので"],["、"],["しばらく"],["は"],["信じて","しんじて"],["いて"],["も"],["、"],["試錬","しれん"],["の"],["時","とき"],["が"],["来る","くる"],["と"],["、"],["信仰","しんこう"],["を"],["捨てる","すてる"],["人","ひと"],["たち"],["の"],["こと"],["で"],["ある"],["。"]]},{"verse":14,"text":"いばらの中,なかに落,おちたのは、聞,きいてから日,ひを過,すごすうちに、生活,せいかつの心,こころづかいや富,とみや快楽,かいらくにふさがれて、実,みの熟,じゅくするまでにならない人,ひとたちのことである。","tok":[["いばら"],["の"],["中","なか"],["に"],["落","おち"],["た"],["の"],["は"],["、"],["聞いて","きいて"],["から"],["日","ひ"],["を"],["過ごす","すごす"],["うち"],["に"],["、"],["生活","せいかつ"],["の"],["心づかい","こころづかい"],["や"],["富","とみ"],["や"],["快楽","かいらく"],["に"],["ふさがれて"],["、"],["実","み"],["の"],["熟する","じゅくする"],["まで"],["に"],["ならない"],["人","ひと"],["たち"],["の"],["こと"],["で"],["ある"],["。"]]},{"verse":15,"text":"良,よい地,ちに落,おちたのは、御言,みことばを聞,きいたのち、これを正,ただしい良,よい心,こころでしっかりと守,まもり、耐,たえ忍,しのんで実,みを結,むすぶに至,いたる人,ひとたちのことである。","tok":[["良い","よい"],["地","ち"],["に"],["落","おち"],["た"],["の"],["は"],["、"],["御言","みこと"],["ば"],["を"],["聞いた","きいた"],["のち"],["、"],["これ"],["を"],["正い","ただしい"],["良い","よい"],["心","こころ"],["で"],["しっかり"],["と"],["守り","まもり"],["、"],["耐え忍んで","たえしのんで"],["実","み"],["を"],["結ぶ","むすぶ"],["に"],["至る","いたる"],["人","ひと"],["たち"],["の"],["こと"],["で"],["ある"],["。"]]},{"verse":16,"text":"だれもあかりをともして、それを何,なにかの器,うつわでおおいかぶせたり、寝台,しんだいの下,したに置,おいたりはしない。燭台,しょくだいの上,うえに置,おいて、はいって来,くる人,ひとたちに光,ひかりが見,みえるようにするのである。","tok":[["だれ"],["も"],["あかり"],["を"],["ともして"],["、"],["それ"],["を"],["何に","なに"],["か"],["の"],["器","うつわ"],["で"],["おおいかぶせ"],["たり"],["、"],["寝台","しんだい"],["の"],["下","した"],["に"],["置い","おい"],["たり"],["は"],["しない"],["。"],["燭台","しょくだい"],["の"],["上","うえ"],["に"],["置いて","おいて"],["、"],["はいって"],["来る","くる"],["人","ひと"],["たち"],["に"],["光","ひかり"],["が"],["見える","みえる"],["よう"],["に"],["する"],["ので"],["ある"],["。"]]},{"verse":17,"text":"隠,かくされているもので、あらわにならないものはなく、秘密,ひみつにされているもので、ついには知,しられ、明,あかるみに出,だされないものはない。","tok":[["隠されて","かくされて"],["いる"],["もの"],["で"],["、"],["あらわ"],["に"],["ならない"],["もの"],["は"],["なく"],["、"],["秘密","ひみつ"],["に"],["されて"],["いる"],["もの"],["で"],["、"],["ついに"],["は"],["知られ","しられ"],["、"],["明かるみ","あかるみ"],["に"],["出されない","だされない"],["もの"],["は"],["ない"],["。"]]},{"verse":18,"text":"だから、どう聞,きくかに注意,ちゅういするがよい。持,もっている人,ひとは更,さらに与,あたえられ、持,もっていない人,ひとは、持,もっていると思,おもっているものまでも、取,とり上,あげられるであろう」。","tok":[["だ"],["から"],["、"],["どう"],["聞く","きく"],["か"],["に"],["注意","ちゅうい"],["する"],["が"],["よい"],["。"],["持て","もって"],["いる"],["人","ひと"],["は"],["更に","さらに"],["与えられ","あたえられ"],["、"],["持て","もって"],["いない"],["人","ひと"],["は"],["、"],["持て","もって"],["いる"],["と"],["思って","おもって"],["いる"],["もの"],["まで"],["も"],["、"],["取上げられるで","とりあげられるで"],["あろう"],["」"],["。"]]},{"verse":19,"text":"さて、イエスの母,ははと兄弟,きょうだいたちとがイエスのところにきたが、群衆,ぐんしゅうのためそば近,ちかくに行,いくことができなかった。","tok":[["さて"],["、"],["イエス"],["の"],["母","はは"],["と"],["兄弟","きょうだい"],["たち"],["と"],["が"],["イエス"],["の"],["ところ"],["に"],["きた"],["が"],["、"],["群衆","ぐんしゅう"],["の"],["ため"],["そば"],["近く","ちかく"],["に"],["行く","いく"],["こと"],["が"],["できなかった"],["。"]]},{"verse":20,"text":"それで、だれかが「あなたの母上,ははうえと兄弟,きょうだいがたが、お目,めにかかろうと思,おもって、外,そとに立,たっておられます」と取次,とりついだ。","tok":[["それ"],["で"],["、"],["だれ"],["か"],["が"],["「"],["あなた"],["の"],["母","はは"],["上","うえ"],["と"],["兄弟","きょうだい"],["がた"],["が"],["、"],["お目","おめ"],["に"],["かかろう"],["と"],["思って","おもって"],["、"],["外","そと"],["に"],["立って","たって"],["おられます"],["」"],["と"],["取次いだ","とりついだ"],["。"]]},{"verse":21,"text":"するとイエスは人々,ひとびとにむかって言,いわれた、「神,かみの御言,みことばを聞,きいて行,おこなう者,ものこそ、わたしの母,はは、わたしの兄弟,きょうだいなのである」。","tok":[["する"],["と"],["イエス"],["は"],["人々","ひとびと"],["に"],["むかって"],["言われた","いわれた"],["、"],["「"],["神","かみ"],["の"],["御言","みこと"],["ば"],["を"],["聞いて","きいて"],["行なう","おこなう"],["者","もの"],["こそ"],["、"],["わたし"],["の"],["母","はは"],["、"],["わたし"],["の"],["兄弟","きょうだい"],["な"],["ので"],["ある"],["」"],["。"]]},{"verse":22,"text":"ある日,ひのこと、イエスは弟子,でしたちと舟,ふねに乗,のり込,こみ、「湖,みずうみの向,むこう岸,ぎしへ渡,わたろう」と言,いわれたので、一同,いちどうが船出,ふなでした。","tok":[["ある"],["日","ひ"],["の"],["こと"],["、"],["イエス"],["は"],["弟子","でし"],["たち"],["と"],["舟","ふね"],["に"],["乗込","のりこみ"],["、"],["「"],["湖","みずうみ"],["の"],["向こう岸","むこうぎし"],["へ"],["渡ろう","わたろう"],["」"],["と"],["言われた","いわれた"],["ので"],["、"],["一同","いちどう"],["が"],["船出","ふなで"],["した"],["。"]]},{"verse":23,"text":"渡,わたって行,いく間,あいだに、イエスは眠,ねむってしまわれた。すると突風,とっぷうが湖,みずうみに吹,ふきおろしてきたので、彼,かれらは水,みずをかぶって危険,きけんになった。","tok":[["渡って","わたって"],["行く","いく"],["間","あいだ"],["に"],["、"],["イエス"],["は"],["眠って","ねむって"],["しまわれた"],["。"],["する"],["と"],["突風","とっぷう"],["が"],["湖","みずうみ"],["に"],["吹","ふき"],["おろして"],["きた"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["水","みず"],["を"],["かぶって"],["危険","きけん"],["に"],["なった"],["。"]]},{"verse":24,"text":"そこで、みそばに寄,よってきてイエスを起,おこし、「先生,せんせい、先生,せんせい、わたしたちは死,しにそうです」と言,いった。イエスは起,おき上,あがって、風,かぜと荒浪,あらなみとをおしかりになると、止,やんでなぎになった。","tok":[["そこ"],["で"],["、"],["みそば"],["に"],["寄って","よって"],["きて"],["イエス"],["を"],["起こし","おこし"],["、"],["「"],["先生","せんせい"],["、"],["先生","せんせい"],["、"],["わたしたち"],["は"],["死に","しに"],["そう"],["です"],["」"],["と"],["言った","いった"],["。"],["イエス"],["は"],["起き上がって","おきあがって"],["、"],["風","かぜ"],["と"],["荒浪","あらなみ"],["と"],["を"],["おしかり"],["に"],["なる"],["と"],["、"],["止","やんでなぎ"],["に"],["なった"],["。"]]},{"verse":25,"text":"イエスは彼,かれらに言,いわれた、「あなたがたの信仰,しんこうは、どこにあるのか」。彼,かれらは恐,おそれ驚,おどろいて互,たがいに言,いい合,あった、「いったい、このかたはだれだろう。お命,めいじになると、風,かぜも水,みずも従,したがうとは」。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["がた"],["の"],["信仰","しんこう"],["は"],["、"],["どこ"],["に"],["ある"],["の"],["か"],["」"],["。"],["彼","かれ"],["ら"],["は"],["恐","おそれ"],["驚ろいて","おどろいて"],["互","たがい"],["に"],["言い合った","いいあった"],["、"],["「"],["いったい"],["、"],["このかた"],["は"],["だれ"],["だろう"],["。"],["お命じ","おめいじ"],["に"],["なる"],["と"],["、"],["風","かぜ"],["も"],["水","みず"],["も"],["従う","したがう"],["と"],["は"],["」"],["。"]]},{"verse":26,"text":"それから、彼,かれらはガリラヤの対岸,たいがん、ゲラサ人,びとの地,ちに渡,わたった。","tok":[["それ"],["から"],["、"],["彼","かれ"],["ら"],["は"],["ガリラヤ"],["の"],["対岸","たいがん"],["、"],["ゲラサ人","げらさびと"],["の"],["地","ち"],["に"],["渡った","わたった"],["。"]]},{"verse":27,"text":"陸,りくにあがられると、その町,まちの人,ひとで、悪霊,あくれいにつかれて長,ながいあいだ着物,きものも着,きず、家,いえに居,いつかないで墓場,はかばにばかりいた人,ひとに、出会,であわれた。","tok":[["陸","りく"],["に"],["あがられる"],["と"],["、"],["その"],["町","まち"],["の"],["人","ひと"],["で"],["、"],["悪霊","あくれい"],["に"],["つかれて"],["長い","ながい"],["あいだ"],["着物","きもの"],["も"],["着ず","きず"],["、"],["家","いえ"],["に"],["居つかないで","いつかないで"],["墓場","はかば"],["に"],["ばかり"],["いた"],["人","ひと"],["に"],["、"],["出会われた","であわれた"],["。"]]},{"verse":28,"text":"この人,ひとがイエスを見,みて叫,さけび出,だし、みまえにひれ伏,ふして大声,おおごえで言,いった、「いと高,たかき神,かみの子,こイエスよ、あなたはわたしとなんの係,かかわりがあるのです。お願,ねがいです、わたしを苦,くるしめないでください」。","tok":[["この"],["人","ひと"],["が"],["イエス"],["を"],["見て","みて"],["叫出し","さけびだし"],["、"],["みまえ"],["に"],["ひれ伏して","ひれふして"],["大声","おおごえ"],["で"],["言った","いった"],["、"],["「"],["いと"],["高き","たかき"],["神","かみ"],["の"],["子","こ"],["イエス"],["よ"],["、"],["あなた"],["は"],["わたし"],["と"],["なん"],["の"],["係わり","かかわり"],["が"],["ある"],["の"],["です"],["。"],["お願い","おねがい"],["です"],["、"],["わたし"],["を"],["苦しめないで","くるしめないで"],["ください"],["」"],["。"]]},{"verse":29,"text":"それは、イエスが汚,けがれた霊,れいに、その人,ひとから出,でて行,いけ、とお命,めいじになったからである。というのは、悪霊,あくれいが何,なん度,ども彼,かれをひき捕,とらえたので、彼,かれは鎖,くさりと足,あしかせとでつながれて看,み視,しされていたが、それを断,たち切,きっては悪霊,あくれいによって荒野,あらのへ追,おいやられていたのである。","tok":[["それ"],["は"],["、"],["イエス"],["が"],["汚","け"],["がれ"],["た"],["霊","れい"],["に"],["、"],["その"],["人","ひと"],["から"],["出て","でて"],["行け","いけ"],["、"],["と"],["お命じ","おめいじ"],["に"],["なった"],["から"],["で"],["ある"],["。"],["と"],["いう"],["の"],["は"],["、"],["悪霊","あ"],["く"],["れい"],["が"],["何度","なんど"],["も"],["彼","かれ"],["を"],["ひき"],["捕らえた","とらえた"],["ので"],["、"],["彼","かれ"],["は"],["鎖","くさり"],["と"],["足かせ","あしかせ"],["と"],["で"],["つながれて"],["看視","みし"],["されて"],["いた"],["が"],["、"],["それ"],["を"],["断ち切って","たちきって"],["は"],["悪霊","あくれい"],["によって"],["荒野","あら"],["の"],["へ"],["追いやられて","おいやられて"],["いた"],["ので"],["ある"],["。"]]},{"verse":30,"text":"イエスは彼,かれに「なんという名前,なまえか」とお尋,たずねになると、「レギオンと言,いいます」と答,こたえた。彼,かれの中,なかにたくさんの悪霊,あくれいがはいり込,こんでいたからである。","tok":[["イエス"],["は"],["彼","かれ"],["に"],["「"],["なん"],["と"],["いう"],["名前","なまえ"],["か"],["」"],["と"],["お尋ね","おたずね"],["に"],["なる"],["と"],["、"],["「"],["レギオン"],["と"],["言います","いいます"],["」"],["と"],["答","こたえ"],["た"],["。"],["彼","かれ"],["の"],["中","なか"],["に"],["たくさん"],["の"],["悪霊","あくれい"],["が"],["はいり込んで","はいりこんで"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":31,"text":"悪霊,あくれいどもは、底,そこ知,しれぬ所,ところに落,おちて行,いくことを自分,じぶんたちにお命,めいじにならぬようにと、イエスに願,ねがいつづけた。","tok":[["悪霊","あくれいど"],["も"],["は"],["、"],["底","そこ"],["知れぬ","しれぬ"],["所","ところ"],["に"],["落","おち"],["て"],["行く","いく"],["こと"],["を"],["自分","じぶん"],["たち"],["に"],["お命じ","おめいじ"],["に"],["ならぬ"],["よう"],["に"],["と"],["、"],["イエス"],["に"],["願い","ねがい"],["つづけた"],["。"]]},{"verse":32,"text":"ところが、そこの山,やまべにおびただしい豚,ぶたの群,むれが飼,かってあったので、その豚,ぶたの中,なかへはいることを許,ゆるしていただきたいと、悪霊,あくれいどもが願,ねがい出,でた。イエスはそれをお許,ゆるしになった。","tok":[["ところ"],["が"],["、"],["そこ"],["の"],["山べ","やまべ"],["に"],["おびただしい"],["豚","ぶた"],["の"],["群れ","むれ"],["が"],["飼って","かって"],["あった"],["ので"],["、"],["その"],["豚","ぶた"],["の"],["中","なか"],["へ"],["はいる"],["こと"],["を"],["許して","ゆるして"],["いただきたい"],["と"],["、"],["悪霊","あ"],["く"],["れい"],["ど"],["も"],["が"],["願い出た","ねがいでた"],["。"],["イエス"],["は"],["それ"],["を"],["お許し","おゆるし"],["に"],["なった"],["。"]]},{"verse":33,"text":"そこで悪霊,あくれいどもは、その人,ひとから出,でて豚,ぶたの中,なかへはいり込,こんだ。するとその群,むれは、がけから湖,みずうみへなだれを打,うって駆,かけ下,くだり、おぼれ死,しんでしまった。","tok":[["そこ"],["で"],["悪霊","あくれいど"],["も"],["は"],["、"],["その"],["人","ひと"],["から"],["出て","でて"],["豚","ぶた"],["の"],["中","なか"],["へ"],["はいり込んだ","はいりこんだ"],["。"],["する"],["と"],["その"],["群れ","むれ"],["は"],["、"],["がけ"],["から"],["湖","みずうみ"],["へ"],["なだれ"],["を"],["打って","うって"],["駆け下り","かけくだり"],["、"],["おぼれ死んで","おぼれしんで"],["しまった"],["。"]]},{"verse":34,"text":"飼,かう者,ものたちは、この出来事,できごとを見,みて逃,にげ出,だして、町,まちや村里,むらざとにふれまわった。","tok":[["飼う","かう"],["者","もの"],["たち"],["は"],["、"],["この"],["出来事","できごと"],["を"],["見て","みて"],["逃出して","にげだして"],["、"],["町","まち"],["や"],["村里","むらざと"],["に"],["ふれまわった"],["。"]]},{"verse":35,"text":"人々,ひとびとはこの出来事,できごとを見,みに出,でてきた。そして、イエスのところにきて、悪霊,あくれいを追,おい出,だしてもらった人,ひとが着物,きものを着,きて、正気,しょうきになってイエスの足,あしもとにすわっているのを見,みて、恐,おそれた。","tok":[["人々","ひとびと"],["は"],["この"],["出来事","できごと"],["を"],["見","み"],["に"],["出て","でて"],["きた"],["。"],["そして"],["、"],["イエス"],["の"],["ところ"],["に"],["きて"],["、"],["悪霊","あくれい"],["を"],["追い出して","おいだして"],["もらった"],["人","ひと"],["が"],["着物","きもの"],["を"],["着て","きて"],["、"],["正気","しょうき"],["に"],["なって"],["イエス"],["の"],["足もと","あしもと"],["に"],["すわって"],["いる"],["の"],["を"],["見て","みて"],["、"],["恐れた","おそれた"],["。"]]},{"verse":36,"text":"それを見,みた人,ひとたちは、この悪霊,あくれいにつかれていた者,ものが救,すくわれた次第,しだいを、彼,かれらに語,かたり聞,きかせた。","tok":[["それ"],["を"],["見た","みた"],["人","ひと"],["たち"],["は"],["、"],["この"],["悪霊","あくれい"],["に"],["つかれて"],["いた"],["者","もの"],["が"],["救われた","すくわれた"],["次第","しだい"],["を"],["、"],["彼","かれ"],["ら"],["に"],["語り聞かせた","かたりきかせた"],["。"]]},{"verse":37,"text":"それから、ゲラサの地方,ちほうの民衆,みんしゅうはこぞって、自分,じぶんたちの所,ところから立,たち去,さってくださるようにとイエスに頼,たのんだ。彼,かれらが非常,ひじょうな恐怖,きょうふに襲,おそわれていたからである。そこで、イエスは舟,ふねに乗,のって帰,かえりかけられた。","tok":[["それ"],["から"],["、"],["ゲラサ"],["の"],["地方","ちほう"],["の"],["民衆","みんしゅう"],["は"],["こぞって"],["、"],["自分","じぶん"],["たち"],["の"],["所","ところ"],["から"],["立ち","たち"],["去て","さって"],["くださる"],["よう"],["に"],["と"],["イエス"],["に"],["頼んだ","たのんだ"],["。"],["彼","かれ"],["ら"],["が"],["非常","ひじょう"],["な"],["恐怖","きょうふ"],["に"],["襲れて","おそわれて"],["いた"],["から"],["で"],["ある"],["。"],["そこ"],["で"],["、"],["イエス"],["は"],["舟","ふね"],["に"],["乗って","のって"],["帰えり","かえり"],["かけられた"],["。"]]},{"verse":38,"text":"悪霊,あくれいを追,おい出,だしてもらった人,ひとは、お供,ともをしたいと、しきりに願,ねがったが、イエスはこう言,いって彼,かれをお帰,かえしになった。","tok":[["悪霊","あくれい"],["を"],["追い出して","おいだして"],["もらった"],["人","ひと"],["は"],["、"],["お供","おとも"],["を"],["したい"],["と"],["、"],["しきり"],["に"],["願った","ねがった"],["が"],["、"],["イエス"],["は"],["こう"],["言って","いって"],["彼","かれ"],["を"],["お帰し","おかえし"],["に"],["なった"],["。"]]},{"verse":39,"text":"「家,いえへ帰,かえって、神,かみがあなたにどんなに大,おおきなことをしてくださったか、語,かたり聞,きかせなさい」。そこで彼,かれは立,たち去,さって、自分,じぶんにイエスがして下,くださったことを、ことごとく町中,まちじゅうに言,いいひろめた。","tok":[["「"],["家","いえ"],["へ"],["帰えって","かえって"],["、"],["神","かみ"],["が"],["あなた"],["に"],["どんな"],["に"],["大きな","おおきな"],["こと"],["を"],["して"],["くださった"],["か"],["、"],["語り聞かせ","かたりきかせ"],["なさい"],["」"],["。"],["そこ"],["で"],["彼","かれ"],["は"],["立ち","たち"],["去て","さって"],["、"],["自分","じぶん"],["に"],["イエス"],["が"],["して"],["下さった","くださった"],["こと"],["を"],["、"],["ことごとく"],["町中","まちじゅう"],["に"],["言い","いい"],["ひろめた"],["。"]]},{"verse":40,"text":"イエスが帰,かえってこられると、群衆,ぐんしゅうは喜,よろこび迎,むかえた。みんながイエスを待,まちうけていたのである。","tok":[["イエス"],["が"],["帰えって","かえって"],["こられる"],["と"],["、"],["群衆","ぐんしゅう"],["は"],["喜こび","よろこび"],["迎","むかえ"],["た"],["。"],["みんな"],["が"],["イエス"],["を"],["待","まち"],["うけて"],["いた"],["ので"],["ある"],["。"]]},{"verse":41,"text":"するとそこに、ヤイロという名,なの人,ひとがきた。この人,ひとは会堂司,かいどうづかさであった。イエスの足,あしもとにひれ伏,ふして、自分,じぶんの家,いえにおいでくださるようにと、しきりに願,ねがった。","tok":[["する"],["と"],["そこ"],["に"],["、"],["ヤイロ"],["と"],["いう"],["名","な"],["の"],["人","ひと"],["が"],["きた"],["。"],["この"],["人","ひと"],["は"],["会堂司","か"],["いどう"],["づかさ"],["で"],["あった"],["。"],["イエス"],["の"],["足もと","あしもと"],["に"],["ひれ伏して","ひれふして"],["、"],["自分","じぶん"],["の"],["家","いえ"],["に"],["おいで"],["くださる"],["よう"],["に"],["と"],["、"],["しきり"],["に"],["願った","ねがった"],["。"]]},{"verse":42,"text":"彼,かれに十二歳,さいばかりになるひとり娘,むすめがあったが、死,しにかけていた。ところが、イエスが出,でて行,いかれる途中,とちゅう、群衆,ぐんしゅうが押,おし迫,せまってきた。","tok":[["彼","かれ"],["に"],["十二歳","さいばかり"],["に"],["なる"],["ひとり"],["娘","むすめ"],["が"],["あった"],["が"],["、"],["死","し"],["に"],["かけて"],["いた"],["。"],["ところ"],["が"],["、"],["イエス"],["が"],["出て","でて"],["行かれる","いかれる"],["途中","とちゅう"],["、"],["群衆","ぐんしゅう"],["が"],["押","おし"],["迫まって","せまって"],["きた"],["。"]]},{"verse":43,"text":"ここに、十二年間,ねんかんも長,なが血,ちをわずらっていて、医者,いしゃのために自分,じぶんの身代,しんだいをみな使,つかい果,はたしてしまったが、だれにもなおしてもらえなかった女,おんながいた。","tok":[["ここ"],["に"],["、"],["十二","じゅうに"],["年間","ねんかん"],["も"],["長","なが"],["血","ち"],["を"],["わずらって"],["いて"],["、"],["医者","いしゃ"],["の"],["ため"],["に"],["自分","じぶん"],["の"],["身代","しんだい"],["を"],["みな"],["使い果たして","つかいはたして"],["しまった"],["が"],["、"],["だれ"],["に"],["も"],["なおして"],["もらえなかった"],["女","おんな"],["が"],["いた"],["。"]]},{"verse":44,"text":"この女,おんながうしろから近寄,ちかよってみ衣,ころものふさにさわったところ、その長,なが血,ちがたちまち止,とまってしまった。","tok":[["この"],["女","おんな"],["が"],["うしろ"],["から"],["近寄って","ちかよって"],["み"],["衣","ころも"],["の"],["ふさ"],["に"],["さわった"],["ところ"],["、"],["その"],["長","なが"],["血","ち"],["が"],["たちまち"],["止まって","とまって"],["しまった"],["。"]]},{"verse":45,"text":"イエスは言,いわれた、「わたしにさわったのは、だれか」。人々,ひとびとはみな自分,じぶんではないと言,いったので、ペテロが「先生,せんせい、群衆,ぐんしゅうがあなたを取,とり囲,かこんで、ひしめき合,あっているのです」と答,こたえた。","tok":[["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["わたし"],["に"],["さわった"],["の"],["は"],["、"],["だれ"],["か"],["」"],["。"],["人々","ひとびと"],["は"],["みな"],["自分","じぶん"],["で"],["は"],["ない"],["と"],["言った","いった"],["ので"],["、"],["ペテロ"],["が"],["「"],["先生","せんせい"],["、"],["群衆","ぐんしゅう"],["が"],["あなた"],["を"],["取囲んで","とりかこんで"],["、"],["ひしめき合って","ひしめきあって"],["いる"],["の"],["です"],["」"],["と"],["答","こたえ"],["た"],["。"]]},{"verse":46,"text":"しかしイエスは言,いわれた、「だれかがわたしにさわった。力,ちからがわたしから出,でて行,いったのを感,かんじたのだ」。","tok":[["しかし"],["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["だれ"],["か"],["が"],["わたし"],["に"],["さわった"],["。"],["力","ちから"],["が"],["わたし"],["から"],["出て","でて"],["行った","いった"],["の"],["を"],["感じた","かんじた"],["の"],["だ"],["」"],["。"]]},{"verse":47,"text":"女,おんなは隠,かくしきれないのを知,しって、震,ふるえながら進,すすみ出,でて、みまえにひれ伏,ふし、イエスにさわった訳,わけと、さわるとたちまちなおったこととを、みんなの前,まえで話,はなした。","tok":[["女","おんな"],["は"],["隠し","かくし"],["きれない"],["の"],["を"],["知って","しって"],["、"],["震え","ふるえ"],["ながら"],["進み出て","すすみでて"],["、"],["みまえ"],["に"],["ひれ伏し","ひれふし"],["、"],["イエス"],["に"],["さわった"],["訳","わけ"],["と"],["、"],["さわる"],["と"],["たちまち"],["なおった"],["こと"],["と"],["を"],["、"],["みんな"],["の"],["前","まえ"],["で"],["話","はなし"],["た"],["。"]]},{"verse":48,"text":"そこでイエスが女,おんなに言,いわれた、「娘,むすめよ、あなたの信仰,しんこうがあなたを救,すくったのです。安心,あんしんして行,いきなさい」。","tok":[["そこ"],["で"],["イエス"],["が"],["女","おんな"],["に"],["言われた","いわれた"],["、"],["「"],["娘","むすめ"],["よ"],["、"],["あなた"],["の"],["信仰","しんこう"],["が"],["あなた"],["を"],["救った","すくった"],["の"],["です"],["。"],["安心","あんしん"],["して"],["行き","いき"],["なさい"],["」"],["。"]]},{"verse":49,"text":"イエスがまだ話,はなしておられるうちに、会堂司,かいどうづかさの家,いえから人,ひとがきて、「お嬢,じょうさんはなくなられました。この上,うえ、先生,せんせいを煩,わずらわすには及,およびません」と言,いった。","tok":[["イエス"],["が"],["まだ"],["話","はなし"],["て"],["おられる"],["うち"],["に"],["、"],["会堂司","かいどうづかさ"],["の"],["家","いえ"],["から"],["人","ひと"],["が"],["きて"],["、"],["「"],["お嬢さん","おじょうさん"],["は"],["なくなられました"],["。"],["この"],["上","うえ"],["、"],["先生","せんせい"],["を"],["煩わす","わずらわす"],["に"],["は"],["及","および"],["ません"],["」"],["と"],["言った","いった"],["。"]]},{"verse":50,"text":"しかしイエスはこれを聞,きいて会堂司,かいどうづかさにむかって言,いわれた、「恐,おそれることはない。ただ信,しんじなさい。娘,むすめは助,たすかるのだ」。","tok":[["しかし"],["イエス"],["は"],["これ"],["を"],["聞いて","きいて"],["会堂司","かいどうづかさ"],["に"],["むかって"],["言われた","いわれた"],["、"],["「"],["恐れる","おそれる"],["こと"],["は"],["ない"],["。"],["ただ"],["信じ","しんじ"],["なさい"],["。"],["娘","むすめ"],["は"],["助かる","たすかる"],["の"],["だ"],["」"],["。"]]},{"verse":51,"text":"それから家,いえにはいられるとき、ペテロ、ヨハネ、ヤコブおよびその子,この父母,ふぼのほかは、だれも一緒,いっしょにはいって来,くることをお許,ゆるしにならなかった。","tok":[["それ"],["から"],["家","いえ"],["に"],["は"],["いられる"],["とき"],["、"],["ペテロ"],["、"],["ヨハネ"],["、"],["ヤコブ"],["および"],["その"],["子","こ"],["の"],["父母","ふぼ"],["の"],["ほか"],["は"],["、"],["だれ"],["も"],["一緒","いっしょ"],["に"],["はいって"],["来る","くる"],["こと"],["を"],["お許し","おゆるし"],["に"],["ならなかった"],["。"]]},{"verse":52,"text":"人々,ひとびとはみな、娘,むすめのために泣,なき悲,かなしんでいた。イエスは言,いわれた、「泣,なくな、娘,むすめは死,しんだのではない。眠,ねむっているだけである」。","tok":[["人々","ひとびと"],["は"],["みな"],["、"],["娘","むすめ"],["の"],["ため"],["に"],["泣","なき"],["悲しんで","かなしんで"],["いた"],["。"],["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["泣く","なく"],["な"],["、"],["娘","むすめ"],["は"],["死んだ","しんだ"],["ので"],["は"],["ない"],["。"],["眠って","ねむって"],["いる"],["だけ"],["で"],["ある"],["」"],["。"]]},{"verse":53,"text":"人々,ひとびとは娘,むすめが死,しんだことを知,しっていたので、イエスをあざ笑,わらった。","tok":[["人々","ひとびと"],["は"],["娘","むすめ"],["が"],["死んだ","しんだ"],["こと"],["を"],["知って","しって"],["いた"],["ので"],["、"],["イエス"],["を"],["あざ笑った","あざわらった"],["。"]]},{"verse":54,"text":"イエスは娘,むすめの手,てを取,とって、呼,よびかけて言,いわれた、「娘,むすめよ、起,おきなさい」。","tok":[["イエス"],["は"],["娘","むすめ"],["の"],["手","て"],["を"],["取って","とって"],["、"],["呼びかけて","よびかけて"],["言われた","いわれた"],["、"],["「"],["娘","むすめ"],["よ"],["、"],["起き","おき"],["なさい"],["」"],["。"]]},{"verse":55,"text":"するとその霊,れいがもどってきて、娘,むすめは即座,そくざに立,たち上,あがった。イエスは何,なにか食,たべ物,ものを与,あたえるように、さしずをされた。","tok":[["する"],["と"],["その"],["霊","れい"],["が"],["もどって"],["きて"],["、"],["娘","むすめ"],["は"],["即座","そくざ"],["に"],["立ち上がった","たちあがった"],["。"],["イエス"],["は"],["何に","なに"],["か"],["食べ物","たべもの"],["を"],["与える","あたえる"],["よう"],["に"],["、"],["さしず"],["を"],["された"],["。"]]},{"verse":56,"text":"両親,りょうしんは驚,おどろいてしまった。イエスはこの出来事,できごとをだれにも話,はなさないようにと、彼,かれらに命,めいじられた。","tok":[["両親","りょうしん"],["は"],["驚ろいて","おどろいて"],["しまった"],["。"],["イエス"],["は"],["この"],["出来事","できごと"],["を"],["だれ"],["に"],["も"],["話さない","はなさない"],["よう"],["に"],["と"],["、"],["彼","かれ"],["ら"],["に"],["命じられた","めいじられた"],["。"]]}]
[{"verse":1,"text":"それからイエスは十二弟子,でしを呼,よび集,あつめて、彼,かれらにすべての悪霊,あくれいを制,せいし、病気,びょうきをいやす力,ちからと権威,けんいとをお授,さづけになった。","tok":[["それ"],["から"],["イエス"],["は"],["十二","じゅうに"],["弟子","でし"],["を"],["呼び集めて","よびあつめて"],["、"],["彼","かれ"],["ら"],["に"],["すべて"],["の"],["悪霊","あくれい"],["を"],["制し","せいし"],["、"],["病気","びょうき"],["を"],["いやす"],["力","ちから"],["と"],["権威","けんい"],["と"],["を"],["お"],["授","さづけ"],["に"],["なった"],["。"]]},{"verse":2,"text":"また神,かみの国,くにを宣,のべ伝,つたえ、かつ病気,びょうきをなおすためにつかわして","tok":[["また"],["神","かみ"],["の"],["国","くに"],["を"],["宣べ伝え","のべつたえ"],["、"],["かつ"],["病気","びょうき"],["を"],["なおす"],["ため"],["に"],["つかわして"]]},{"verse":3,"text":"言,いわれた、「旅,たびのために何,なにも携,たずさえるな。つえも袋,ふくろもパンも銭,ぜにも持,もたず、また下着,したぎも二枚,まいは持,もつな。","tok":[["言われた","いわれた"],["、"],["「"],["旅","たび"],["の"],["ため"],["に"],["何に","なに"],["も"],["携える","たずさえる"],["な"],["。"],["つえ"],["も"],["袋","ふくろ"],["も"],["パン"],["も"],["銭","ぜに"],["も"],["持たず","もたず"],["、"],["また"],["下着","したぎ"],["も"],["二枚","まい"],["は"],["持つ","もつ"],["な"],["。"]]},{"verse":4,"text":"また、どこかの家,いえにはいったら、そこに留,とどまっておれ。そしてそこから出,でかけることにしなさい。","tok":[["また"],["、"],["どこ"],["か"],["の"],["家","いえ"],["に"],["はいったら"],["、"],["そこ"],["に"],["留","と"],["ど"],["まって"],["おれ"],["。"],["そして"],["そこ"],["から"],["出かける","でかける"],["こと"],["に"],["し"],["なさい"],["。"]]},{"verse":5,"text":"だれもあなたがたを迎,むかえるものがいなかったら、その町,まちを出,でて行,いくとき、彼,かれらに対,たいする抗議,こうぎのしるしに、足,あしからちりを払,はらい落,おとしなさい」。","tok":[["だれ"],["も"],["あなた"],["がた"],["を"],["迎","むかえ"],["る"],["もの"],["が"],["いなかったら"],["、"],["その"],["町","まち"],["を"],["出て","でて"],["行く","いく"],["とき"],["、"],["彼","かれ"],["ら"],["に"],["対する","たいする"],["抗議","こうぎ"],["の"],["しるし"],["に"],["、"],["足","あし"],["から"],["ちり"],["を"],["払","はらい"],["落とし","おとし"],["なさい"],["」"],["。"]]},{"verse":6,"text":"弟子,でしたちは出,でて行,いって、村々,むらむらを巡,めぐり歩,あるき、いたる所,ところで福音,ふくいんを宣,のべ伝,つたえ、また病気,びょうきをいやした。","tok":[["弟子","でし"],["たち"],["は"],["出て","でて"],["行って","いって"],["、"],["村々","むらむら"],["を"],["巡り歩き","めぐりあるき"],["、"],["いたる"],["所","ところ"],["で"],["福音","ふくいん"],["を"],["宣べ伝え","のべつたえ"],["、"],["また"],["病気","びょうき"],["を"],["いやした"],["。"]]},{"verse":7,"text":"さて、領主,りょうしゅヘロデはいろいろな出来事,できごとを耳,みみにして、あわて惑,まどっていた。それは、ある人,ひとたちは、ヨハネが死人,しにんの中,なかからよみがえったと言,いい、","tok":[["さて"],["、"],["領主","りょうしゅ"],["ヘロデ"],["は"],["いろいろ"],["な"],["出来事","できごと"],["を"],["耳","みみ"],["に"],["して"],["、"],["あわて惑って","あわてまどって"],["いた"],["。"],["それ"],["は"],["、"],["ある"],["人","ひと"],["たち"],["は"],["、"],["ヨハネ"],["が"],["死人","しにん"],["の"],["中","なか"],["から"],["よみがえった"],["と"],["言い","いい"],["、"]]},{"verse":8,"text":"またある人,ひとたちは、エリヤが現,あらわれたと言,いい、またほかの人,ひとたちは、昔,むかしの預言者,よげんしゃのひとりが復活,ふっかつしたのだと言,いっていたからである。","tok":[["また"],["ある"],["人","ひと"],["たち"],["は"],["、"],["エリヤ"],["が"],["現われた","あらわれた"],["と"],["言い","いい"],["、"],["また"],["ほか"],["の"],["人","ひと"],["たち"],["は"],["、"],["昔","むかし"],["の"],["預言者","よげんしゃ"],["の"],["ひとり"],["が"],["復活","ふっかつ"],["した"],["の"],["だ"],["と"],["言って","いって"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":9,"text":"そこでヘロデが言,いった、「ヨハネはわたしがすでに首,くびを切,きったのだが、こうしてうわさされているこの人,ひとは、いったい、だれなのだろう」。そしてイエスに会,あってみようと思,おもっていた。","tok":[["そこ"],["で"],["ヘロデ"],["が"],["言った","いった"],["、"],["「"],["ヨハネ"],["は"],["わたし"],["が"],["すでに"],["首","くび"],["を"],["切った","きった"],["の"],["だ"],["が"],["、"],["こう"],["して"],["うわさ"],["されて"],["いる"],["この"],["人","ひと"],["は"],["、"],["いったい"],["、"],["だれ"],["な"],["の"],["だろう"],["」"],["。"],["そして"],["イエス"],["に"],["会って","あって"],["みよう"],["と"],["思って","おもって"],["いた"],["。"]]},{"verse":10,"text":"使徒,しとたちは帰,かえってきて、自分,じぶんたちのしたことをすべてイエスに話,はなした。それからイエスは彼,かれらを連,つれて、ベツサイダという町,まちへひそかに退,しりぞかれた。","tok":[["使徒","しと"],["たち"],["は"],["帰えって","かえって"],["きて"],["、"],["自分","じぶん"],["たち"],["の"],["した"],["こと"],["を"],["すべて"],["イエス"],["に"],["話","はなし"],["た"],["。"],["それ"],["から"],["イエス"],["は"],["彼","かれ"],["ら"],["を"],["連れて","つれて"],["、"],["ベツサイダ"],["と"],["いう"],["町","まち"],["へ"],["ひそか"],["に"],["退ぞかれた","しりぞかれた"],["。"]]},{"verse":11,"text":"ところが群衆,ぐんしゅうがそれと知,しって、ついてきたので、これを迎,むかえて神,かみの国,くにのことを語,かたり聞,きかせ、また治療,ちりょうを要,ようする人,ひとたちをいやされた。","tok":[["ところ"],["が"],["群衆","ぐんしゅう"],["が"],["それ"],["と"],["知って","しって"],["、"],["ついて"],["きた"],["ので"],["、"],["これ"],["を"],["迎","むかえ"],["て"],["神","かみ"],["の"],["国","くに"],["の"],["こと"],["を"],["語り聞かせ","かたりきかせ"],["、"],["また"],["治療","ちりょう"],["を"],["要する","ようする"],["人","ひと"],["たち"],["を"],["いやされた"],["。"]]},{"verse":12,"text":"それから日,ひが傾,かたむきかけたので、十二弟子,でしがイエスのもとにきて言,いった、「群衆,ぐんしゅうを解散,かいさんして、まわりの村々,むらむらや部落,ぶらくへ行,いって宿,やどを取,とり、食物,しょくもつを手,てにいれるようにさせてください。わたしたちはこんな寂,さびしい所,ところにきているのですから」。","tok":[["それ"],["から"],["日","ひ"],["が"],["傾きかけた","かたむきかけた"],["ので"],["、"],["十二","じゅうに"],["弟子","でし"],["しが"],["イエス"],["の"],["もと"],["に"],["きて"],["言った","いった"],["、"],["「"],["群衆","ぐんしゅう"],["を"],["解散","かいさん"],["して"],["、"],["まわり"],["の"],["村々","むらむら"],["や"],["部落","ぶらく"],["へ"],["行って","いって"],["宿","やど"],["を"],["取","とり"],["、"],["食物","しょくもつ"],["を"],["手","て"],["に"],["いれる"],["よう"],["に"],["させて"],["ください"],["。"],["わたしたち"],["は"],["こんな"],["寂しい","さびしい"],["所","ところ"],["に"],["きて"],["いる"],["の"],["です"],["から"],["」"],["。"]]},{"verse":13,"text":"しかしイエスは言,いわれた、「あなたがたの手,てで食物,しょくもつをやりなさい」。彼,かれらは言,いった、「わたしたちにはパン五つと魚,うお二ひきしかありません、この大,おおぜいの人,ひとのために食物,しょくもつを買,かいに行,いくかしなければ」。","tok":[["しかし"],["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["あなた"],["がた"],["の"],["手","て"],["で"],["食物","しょくもつ"],["を"],["やり"],["なさい"],["」"],["。"],["彼","かれ"],["ら"],["は"],["言った","いった"],["、"],["「"],["わたしたち"],["に"],["は"],["パン"],["五","いつ"],["つ"],["と"],["魚","う"],["お二","おに"],["ひき"],["しか"],["ありません"],["、"],["この"],["大ぜい","おおぜい"],["の"],["人","ひと"],["の"],["ため"],["に"],["食物","しょくもつ"],["を"],["買","かい"],["に"],["行く","いく"],["か"],["しなければ"],["」"],["。"]]},{"verse":14,"text":"というのは、男,おとこが五千人,にんばかりもいたからである。しかしイエスは弟子,でしたちに言,いわれた、「人々,ひとびとをおおよそ五十人,にんずつの組,くみにして、すわらせなさい」。","tok":[["と"],["いう"],["の"],["は"],["、"],["男","おとこ"],["が"],["五千人","にんばかり"],["も"],["いた"],["から"],["で"],["ある"],["。"],["しかし"],["イエス"],["は"],["弟子","でし"],["たち"],["に"],["言われた","いわれた"],["、"],["「"],["人々","ひとびと"],["を"],["おおよそ"],["五","ご"],["十人","じゅうにん"],["の"],["組","くみ"],["に"],["して"],["、"],["すわらせ"],["なさい"],["」"],["。"]]},{"verse":15,"text":"彼,かれらはそのとおりにして、みんなをすわらせた。","tok":[["彼","かれ"],["ら"],["は"],["その"],["とおり"],["に"],["して"],["、"],["みんな"],["を"],["すわらせた"],["。"]]},{"verse":16,"text":"イエスは五つのパンと二ひきの魚,うおとを手,てに取,とり、天,てんを仰,あおいでそれを祝福,しゅくふくしてさき、弟子,でしたちにわたして群衆,ぐんしゅうに配,くばらせた。","tok":[["イエス"],["は"],["五","いつ"],["つ"],["の"],["パン"],["と"],["二","に"],["ひき"],["の"],["魚","うおと"],["を"],["手","て"],["に"],["取","とり"],["、"],["天","てん"],["を"],["仰いで","あおいで"],["それ"],["を"],["祝福","しゅくふく"],["して"],["さき"],["、"],["弟子","でし"],["たち"],["に"],["わたして"],["群衆","ぐんしゅう"],["に"],["配ばらせた","くばらせた"],["。"]]},{"verse":17,"text":"みんなの者,ものは食,たべて満腹,まんぷくした。そして、その余,あまりくずを集,あつめたら、十二かごあった。","tok":[["みんな"],["の"],["者","もの"],["は"],["食べて","たべて"],["満腹","まんぷく"],["した"],["。"],["そして"],["、"],["その"],["余","あまり"],["くず"],["を"],["集めたら","あつめたら"],["、"],["十二","じゅうに"],["かご"],["あった"],["。"]]},{"verse":18,"text":"イエスがひとりで祈,いのっておられたとき、弟子,でしたちが近,ちかくにいたので、彼,かれらに尋,たずねて言,いわれた、「群衆,ぐんしゅうはわたしをだれと言,いっているか」。","tok":[["イエス"],["が"],["ひとり"],["で"],["祈って","いのって"],["おられた"],["とき"],["、"],["弟子","でし"],["たち"],["が"],["近く","ちかく"],["に"],["いた"],["ので"],["、"],["彼","かれ"],["ら"],["に"],["尋ねて","たずねて"],["言われた","いわれた"],["、"],["「"],["群衆","ぐんしゅう"],["は"],["わたし"],["を"],["だれ"],["と"],["言って","いって"],["いる"],["か"],["」"],["。"]]},{"verse":19,"text":"彼,かれらは答,こたえて言,いった、「バプテスマのヨハネだと、言,いっています。しかしほかの人,ひとたちは、エリヤだと言,いい、また昔,むかしの預言者,よげんしゃのひとりが復活,ふっかつしたのだと、言,いっている者,ものもあります」。","tok":[["彼","かれ"],["ら"],["は"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["バプテスマ"],["の"],["ヨハネ"],["だ"],["と"],["、"],["言って","いって"],["います"],["。"],["しかし"],["ほか"],["の"],["人","ひと"],["たち"],["は"],["、"],["エリヤ"],["だ"],["と"],["言い","いい"],["、"],["また"],["昔","むかし"],["の"],["預言者","よげんしゃ"],["の"],["ひとり"],["が"],["復活","ふっかつ"],["した"],["の"],["だ"],["と"],["、"],["言って","いって"],["いる"],["者","もの"],["も"],["あります"],["」"],["。"]]},{"verse":20,"text":"彼,かれらに言,いわれた、「それでは、あなたがたはわたしをだれと言,いうか」。ペテロが答,こたえて言,いった、「神,かみのキリストです」。","tok":[["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["それ"],["で"],["は"],["、"],["あなた"],["がた"],["は"],["わたし"],["を"],["だれ"],["と"],["言う","いう"],["か"],["」"],["。"],["ペテロ"],["が"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["神","かみ"],["の"],["キリスト"],["です"],["」"],["。"]]},{"verse":21,"text":"イエスは彼,かれらを戒,いましめ、この事,ことをだれにも言,いうなと命,めいじ、そして言,いわれた、","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["を"],["戒しめ","いましめ"],["、"],["この"],["事","こと"],["を"],["だれ"],["に"],["も"],["言","いうな"],["と"],["命じ","めいじ"],["、"],["そして"],["言われた","いわれた"],["、"]]},{"verse":22,"text":"「人,ひとの子,こは必,かならず多,おおくの苦,くるしみを受,うけ、長老,ちょうろう、祭司長,さいしちょう、律法,りっぽう学者,がくしゃたちに捨,すてられ、また殺,ころされ、そして三日,か目,めによみがえる」。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["は"],["必","かならず"],["多く","おおく"],["の"],["苦しみ","くるしみ"],["を"],["受け","うけ"],["、"],["長老","ちょうろう"],["、"],["祭司長","さいしちょう"],["、"],["律法学者","りっぽうがくしゃ"],["たち"],["に"],["捨てられ","すてられ"],["、"],["また"],["殺ろされ","ころされ"],["、"],["そして"],["三日目","かめ"],["に"],["よみがえる"],["」"],["。"]]},{"verse":23,"text":"それから、みんなの者,ものに言,いわれた、「だれでもわたしについてきたいと思,おもうなら、自分,じぶんを捨,すて、日々,ひび自分,じぶんの十字架,じゅうじかを負,おうて、わたしに従,したがってきなさい。","tok":[["それ"],["から"],["、"],["みんな"],["の"],["者","もの"],["に"],["言われた","いわれた"],["、"],["「"],["だれ"],["で"],["も"],["わたし"],["について"],["きたい"],["と"],["思うなら","おもうなら"],["、"],["自分","じぶん"],["を"],["捨て","すて"],["、"],["日々","ひび"],["自分","じぶん"],["の"],["十字架","じゅうじか"],["を"],["負うて","おうて"],["、"],["わたし"],["に"],["従って","したがって"],["き"],["なさい"],["。"]]},{"verse":24,"text":"自分,じぶんの命,いのちを救,すくおうと思,おもう者,ものはそれを失,うしない、わたしのために自分,じぶんの命,いのちを失,うしなう者,ものは、それを救,すくうであろう。","tok":[["自分","じぶん"],["の"],["命","いのち"],["を"],["救おう","すくおう"],["と"],["思う","おもう"],["者","もの"],["は"],["それ"],["を"],["失ない","うしない"],["、"],["わたし"],["の"],["ため"],["に"],["自分","じぶん"],["の"],["命","いのち"],["を"],["失なう","うしなう"],["者","もの"],["は"],["、"],["それ"],["を"],["救うで","すくうで"],["あろう"],["。"]]},{"verse":25,"text":"人,ひとが全,ぜん世界,せかいをもうけても、自分,じぶん自身,じしんを失,うしないまたは損,そんしたら、なんの得,えになろうか。","tok":[["人","ひと"],["が"],["全","ぜん"],["世界","せかい"],["を"],["もうけて"],["も"],["、"],["自分","じぶん"],["自身","じしん"],["を"],["失ない","うしない"],["また"],["は"],["損したら","そんしたら"],["、"],["なん"],["の"],["得","え"],["に"],["なろう"],["か"],["。"]]},{"verse":26,"text":"わたしとわたしの言葉,ことばとを恥,はじる者,ものに対,たいしては、人,ひとの子,こもまた、自分,じぶんの栄光,えいこうと、父,ちちと聖,せいなる御使,みつかいとの栄光,えいこうのうちに現,あらわれて来,くるとき、その者,ものを恥,はじるであろう。","tok":[["わたし"],["と"],["わたし"],["の"],["言葉","ことば"],["と"],["を"],["恥","はじ"],["る"],["者","もの"],["に"],["対し","たいし"],["ては"],["、"],["人","ひと"],["の"],["子","こ"],["も"],["また"],["、"],["自分","じぶん"],["の"],["栄光","えいこう"],["と"],["、"],["父","ちち"],["と"],["聖","せい"],["なる"],["御使","みつかいと"],["の"],["栄光","えいこう"],["の"],["うち"],["に"],["現われて","あらわれて"],["来る","くる"],["とき"],["、"],["その"],["者","もの"],["を"],["恥","はじ"],["るで"],["あろう"],["。"]]},{"verse":27,"text":"よく聞,きいておくがよい、神,かみの国,くにを見,みるまでは、死,しを味,あじわわない者,ものが、ここに立,たっている者,ものの中,なかにいる」。","tok":[["よく"],["聞いて","きいて"],["おく"],["が"],["よい"],["、"],["神","かみ"],["の"],["国","くに"],["を"],["見る","みる"],["まで"],["は"],["、"],["死","し"],["を"],["味わわない","あじわわない"],["者","もの"],["が"],["、"],["ここ"],["に"],["立って","たって"],["いる"],["者","もの"],["の"],["中","なか"],["に"],["いる"],["」"],["。"]]},{"verse":28,"text":"これらのことを話,はなされた後,のち、八日,かほどたってから、イエスはペテロ、ヨハネ、ヤコブを連,つれて、祈,いのるために山,やまに登,のぼられた。","tok":[["これ"],["ら"],["の"],["こと"],["を"],["話された","はなされた"],["後","の"],["ち"],["、"],["八日","かほどたってか"],["ら"],["、"],["イエス"],["は"],["ペテロ"],["、"],["ヨハネ"],["、"],["ヤコブ"],["を"],["連れて","つれて"],["、"],["祈る","いのる"],["ため"],["に"],["山","やま"],["に"],["登られた","のぼられた"],["。"]]},{"verse":29,"text":"祈,いのっておられる間,あいだに、み顔,かおの様,さまが変,かわり、み衣,ころもがまばゆいほどに白,しろく輝,かがやいた。","tok":[["祈って","いのって"],["おられる"],["間","あいだ"],["に"],["、"],["み顔","みかお"],["の"],["様","さま"],["が"],["変わり","かわり"],["、"],["み衣","みころも"],["が"],["まばゆい"],["ほど"],["に"],["白く","しろく"],["輝やいた","かがやいた"],["。"]]},{"verse":30,"text":"すると見,みよ、ふたりの人,ひとがイエスと語,かたり合,あっていた。それはモーセとエリヤであったが、","tok":[["する"],["と"],["見よ","みよ"],["、"],["ふたり"],["の"],["人","ひと"],["が"],["イエス"],["と"],["語り合って","かたりあって"],["いた"],["。"],["それ"],["は"],["モーセ"],["と"],["エリヤ"],["で"],["あった"],["が"],["、"]]},{"verse":31,"text":"栄光,えいこうの中,なかに現,あらわれて、イエスがエルサレムで遂,とげようとする最後,さいごのことについて話,はなしていたのである。","tok":[["栄光","えいこう"],["の"],["中","なか"],["に"],["現われて","あらわれて"],["、"],["イエス"],["が"],["エルサレム"],["で"],["遂げよう","とげよう"],["と"],["する"],["最後","さいご"],["の"],["こと"],["について"],["話","はなし"],["て"],["いた"],["ので"],["ある"],["。"]]},{"verse":32,"text":"ペテロとその仲間,なかまの者,ものたちとは熟睡,じゅくすいしていたが、目,めをさますと、イエスの栄光,えいこうの姿,すがたと、共,ともに立,たっているふたりの人,ひととを見,みた。","tok":[["ペテロ"],["と"],["その"],["仲間","なかま"],["の"],["者","もの"],["たち"],["と"],["は"],["熟睡","じゅくすい"],["して"],["いた"],["が"],["、"],["目","め"],["を"],["さます"],["と"],["、"],["イエス"],["の"],["栄光","えいこう"],["の"],["姿","すがた"],["と"],["、"],["共","とも"],["に"],["立って","たって"],["いる"],["ふたり"],["の"],["人","ひと"],["と"],["を"],["見た","みた"],["。"]]},{"verse":33,"text":"このふたりがイエスを離,はなれ去,さろうとしたとき、ペテロは自分,じぶんが何,なにを言,いっているのかわからないで、イエスに言,いった、「先生,せんせい、わたしたちがここにいるのは、すばらしいことです。それで、わたしたちは小屋,こやを三つ建,たてましょう。一つはあなたのために、一つはモーセのために、一つはエリヤのために」。","tok":[["この"],["ふたり"],["が"],["イエス"],["を"],["離れ去ろう","はなれさろう"],["と"],["した"],["とき"],["、"],["ペテロ"],["は"],["自分","じぶん"],["が"],["何に","なに"],["を"],["言って","いって"],["いる"],["の"],["か"],["わからないで"],["、"],["イエス"],["に"],["言った","いった"],["、"],["「"],["先生","せんせい"],["、"],["わたしたち"],["が"],["ここ"],["に"],["いる"],["の"],["は"],["、"],["すばらしい"],["こと"],["です"],["。"],["それ"],["で"],["、"],["わたしたち"],["は"],["小屋","こや"],["を"],["三","みっ"],["つ"],["建てましょう","たてましょう"],["。"],["一","ひと"],["つ"],["は"],["あなた"],["の"],["ため"],["に"],["、"],["一","ひと"],["つ"],["は"],["モーセ"],["の"],["ため"],["に"],["、"],["一","ひと"],["つ"],["は"],["エリヤ"],["の"],["ため"],["に"],["」"],["。"]]},{"verse":34,"text":"彼,かれがこう言,いっている間,あいだに、雲,くもがわき起,おこって彼,かれらをおおいはじめた。そしてその雲,くもに囲,かこまれたとき、彼,かれらは恐,おそれた。","tok":[["彼","かれ"],["が"],["こう"],["言って","いって"],["いる"],["間","あいだ"],["に"],["、"],["雲","くも"],["が"],["わき起こって","わきおこって"],["彼","かれ"],["ら"],["を"],["おおい"],["はじめた"],["。"],["そして"],["その"],["雲","くも"],["に"],["囲まれた","かこまれた"],["とき"],["、"],["彼","かれ"],["ら"],["は"],["恐れた","おそれた"],["。"]]},{"verse":35,"text":"すると雲,くもの中,なかから声,こえがあった、「これはわたしの子,こ、わたしの選,えらんだ者,ものである。これに聞,きけ」。","tok":[["する"],["と"],["雲","くも"],["の"],["中","なか"],["から"],["声","こえ"],["が"],["あった"],["、"],["「"],["これ"],["は"],["わたし"],["の"],["子","こ"],["、"],["わたし"],["の"],["選らんだ","えらんだ"],["者","もの"],["で"],["ある"],["。"],["これ"],["に"],["聞け","きけ"],["」"],["。"]]},{"verse":36,"text":"そして声,こえが止,やんだとき、イエスがひとりだけになっておられた。弟子,でしたちは沈黙,ちんもくを守,まもって、自分,じぶんたちが見,みたことについては、そのころだれにも話,はなさなかった。","tok":[["そして"],["声","こえ"],["が"],["止んだ","やんだ"],["とき"],["、"],["イエス"],["が"],["ひとり"],["だけ"],["に"],["なって"],["おられた"],["。"],["弟子","でし"],["たち"],["は"],["沈黙","ちんもく"],["を"],["守って","まもって"],["、"],["自分","じぶん"],["たち"],["が"],["見た","みた"],["こと"],["について"],["は"],["、"],["その"],["ころ"],["だれ"],["に"],["も"],["話さなかった","はなさなかった"],["。"]]},{"verse":37,"text":"翌日,よくじつ、一同,いちどうが山,やまを降,おりて来,くると、大,おおぜいの群衆,ぐんしゅうがイエスを出迎,でむかえた。","tok":[["翌日","よくじつ"],["、"],["一同","いちどう"],["が"],["山","やま"],["を"],["降りて","おりて"],["来る","くる"],["と"],["、"],["大ぜい","おおぜい"],["の"],["群衆","ぐんしゅう"],["が"],["イエス"],["を"],["出迎","でむかえ"],["た"],["。"]]},{"verse":38,"text":"すると突然,とつぜん、ある人,ひとが群衆,ぐんしゅうの中,なかから大声,おおごえをあげて言,いった、「先生,せんせい、お願,ねがいです。わたしのむすこを見,みてやってください。この子,こはわたしのひとりむすこですが、","tok":[["する"],["と"],["突然","とつぜん"],["、"],["ある"],["人","ひと"],["が"],["群衆","ぐんしゅう"],["の"],["中","なか"],["から"],["大声","おおごえ"],["を"],["あげて"],["言った","いった"],["、"],["「"],["先生","せんせい"],["、"],["お願い","おねがい"],["です"],["。"],["わたし"],["の"],["むすこ"],["を"],["見て","みて"],["やって"],["ください"],["。"],["この"],["子","こ"],["は"],["わたし"],["の"],["ひとり"],["むすこ"],["です"],["が"],["、"]]},{"verse":39,"text":"霊,れいが取,とりつきますと、彼,かれは急,きゅうに叫,さけび出,だすのです。それから、霊,れいは彼,かれをひきつけさせて、あわを吹,ふかせ、彼,かれを弱,よわり果,はてさせて、なかなか出,でて行,いかないのです。","tok":[["霊","れい"],["が"],["取","とり"],["つきます"],["と"],["、"],["彼","かれ"],["は"],["急","きゅう"],["に"],["叫","さけび"],["出す","だす"],["の"],["です"],["。"],["それ"],["から"],["、"],["霊","れい"],["は"],["彼","かれ"],["を"],["ひきつけさせて"],["、"],["あわ"],["を"],["吹かせ","ふかせ"],["、"],["彼","かれ"],["を"],["弱り","よわり"],["果てさせて","はてさせて"],["、"],["なかなか"],["出て","でて"],["行かない","いかない"],["の"],["です"],["。"]]},{"verse":40,"text":"それで、お弟子,でしたちに、この霊,れいを追,おい出,だしてくださるように願,ねがいましたが、できませんでした」。","tok":[["それ"],["で"],["、"],["お弟子","おでし"],["たち"],["に"],["、"],["この"],["霊","れい"],["を"],["追い出して","おいだして"],["くださる"],["よう"],["に"],["願いました","ねがいました"],["が"],["、"],["できませんでした"],["」"],["。"]]},{"verse":41,"text":"イエスは答,こたえて言,いわれた、「ああ、なんという不,ふ信仰,しんこうな、曲,まがった時代,じだいであろう。いつまで、わたしはあなたがたと一緒,いっしょにおられようか、またあなたがたに我慢,がまんができようか。あなたの子,こをここに連,つれてきなさい」。","tok":[["イエス"],["は"],["答","こたえ"],["て"],["言われた","いわれた"],["、"],["「"],["ああ"],["、"],["なん"],["と"],["いう"],["不","ふ"],["信仰","しんこう"],["な"],["、"],["曲がった","まがった"],["時代","じだい"],["で"],["あろう"],["。"],["いつ"],["まで"],["、"],["わたし"],["は"],["あなた"],["がた"],["と"],["一緒","いっしょ"],["に"],["おられよう"],["か"],["、"],["また"],["あなた"],["がた"],["に"],["我慢","がまん"],["が"],["できよう"],["か"],["。"],["あなた"],["の"],["子","こ"],["を"],["ここ"],["に"],["連れて","つれて"],["き"],["なさい"],["」"],["。"]]},{"verse":42,"text":"ところが、その子,こがイエスのところに来,くる時,ときにも、悪霊,あくれいが彼,かれを引,ひき倒,たおして、引,ひきつけさせた。イエスはこの汚,けがれた霊,れいをしかりつけ、その子供,こどもをいやして、父親,ちちおやにお渡,わたしになった。","tok":[["ところ"],["が"],["、"],["その"],["子","こ"],["が"],["イエス"],["の"],["ところ"],["に"],["来る","くる"],["時","とき"],["に"],["も"],["、"],["悪霊","あ"],["く"],["れい"],["が"],["彼","かれ"],["を"],["引倒","ひきたお"],["して"],["、"],["引","ひき"],["つけさせた"],["。"],["イエス"],["は"],["この"],["汚","け"],["がれ"],["た"],["霊","れい"],["を"],["しかりつけ"],["、"],["その"],["子供","こども"],["を"],["いやして"],["、"],["父親","ちちおや"],["に"],["お渡","おわたし"],["に"],["なった"],["。"]]},{"verse":43,"text":"人々,ひとびとはみな、神,かみの偉大,いだいな力,ちからに非常,ひじょうに驚,おどろいた。みんなの者,ものがイエスのしておられた数々,かずかずの事,ことを不思議,ふしぎに思,おもっていると、弟子,でしたちに言,いわれた、","tok":[["人々","ひとびと"],["は"],["みな"],["、"],["神","かみ"],["の"],["偉大","いだい"],["な"],["力","ちから"],["に"],["非常","ひじょう"],["に"],["驚ろいた","おどろいた"],["。"],["みんな"],["の"],["者","もの"],["が"],["イエス"],["の"],["して"],["おられた"],["数々","かずかず"],["の"],["事","こと"],["を"],["不思議","ふしぎ"],["に"],["思って","おもって"],["いる"],["と"],["、"],["弟子","でし"],["たち"],["に"],["言われた","いわれた"],["、"]]},{"verse":44,"text":"「あなたがたはこの言葉,ことばを耳,みみにおさめて置,おきなさい。人,ひとの子,こは人々,ひとびとの手,てに渡,わたされようとしている」。","tok":[["「"],["あなた"],["がた"],["は"],["この"],["言葉","ことば"],["を"],["耳","みみ"],["に"],["おさめて"],["置き","おき"],["なさい"],["。"],["人","ひと"],["の"],["子","こ"],["は"],["人々","ひとびと"],["の"],["手","て"],["に"],["渡されよう","わたされよう"],["として"],["いる"],["」"],["。"]]},{"verse":45,"text":"しかし、彼,かれらはなんのことかわからなかった。それが彼,かれらに隠,かくされていて、悟,さとることができなかったのである。また彼,かれらはそのことについて尋,たずねるのを恐,おそれていた。","tok":[["しかし"],["、"],["彼","かれ"],["ら"],["は"],["なん"],["の"],["こと"],["か"],["わからなかった"],["。"],["それ"],["が"],["彼","かれ"],["ら"],["に"],["隠されて","かくされて"],["いて"],["、"],["悟","さとる"],["こと"],["が"],["できなかった"],["ので"],["ある"],["。"],["また"],["彼","かれ"],["ら"],["は"],["その"],["こと"],["について"],["尋ねる","たずねる"],["の"],["を"],["恐れて","おそれて"],["いた"],["。"]]},{"verse":46,"text":"弟子,でしたちの間,あいだに、彼,かれらのうちでだれがいちばん偉,えらいだろうかということで、議論,ぎろんがはじまった。","tok":[["弟子","でし"],["たち"],["の"],["間","あいだ"],["に"],["、"],["彼","かれ"],["ら"],["の"],["うち"],["で"],["だれ"],["が"],["いちばん"],["偉いだろう","えらいだろう"],["か"],["と"],["いう"],["こと"],["で"],["、"],["議論","ぎろん"],["が"],["はじまった"],["。"]]},{"verse":47,"text":"イエスは彼,かれらの心,こころの思,おもいを見抜,みぬき、ひとりの幼,おさな子,ごを取,とりあげて自分,じぶんのそばに立,たたせ、彼,かれらに言,いわれた、","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["の"],["心","こころ"],["の"],["思い","おもい"],["を"],["見抜き","みぬき"],["、"],["ひとり"],["の"],["幼な子","おさなご"],["を"],["取","とり"],["あげて"],["自分","じぶん"],["の"],["そば"],["に"],["立たせ","たたせ"],["、"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"]]},{"verse":48,"text":"「だれでもこの幼,おさな子,ごをわたしの名,なのゆえに受,うけいれる者,ものは、わたしを受,うけいれるのである。そしてわたしを受,うけいれる者,ものは、わたしをおつかわしになったかたを受,うけいれるのである。あなたがたみんなの中,なかでいちばん小,ちいさい者,ものこそ、大,おおきいのである」。","tok":[["「"],["だれ"],["で"],["も"],["この"],["幼な子","おさなご"],["を"],["わたし"],["の"],["名","な"],["の"],["ゆえ"],["に"],["受","うけ"],["いれる"],["者","もの"],["は"],["、"],["わたし"],["を"],["受","うけ"],["いれる"],["ので"],["ある"],["。"],["そして"],["わたし"],["を"],["受","うけ"],["いれる"],["者","もの"],["は"],["、"],["わたし"],["を"],["おつかわし"],["に"],["なった"],["かた"],["を"],["受","うけ"],["いれる"],["ので"],["ある"],["。"],["あなた"],["がた"],["みんな"],["の"],["中","なか"],["で"],["いちばん"],["小さい","ちいさい"],["者","もの"],["こそ"],["、"],["大きい","おおきい"],["ので"],["ある"],["」"],["。"]]},{"verse":49,"text":"するとヨハネが答,こたえて言,いった、「先生,せんせい、わたしたちはある人,ひとがあなたの名,なを使,つかって悪霊,あくれいを追,おい出,だしているのを見,みましたが、その人,ひとはわたしたちの仲間,なかまでないので、やめさせました」。","tok":[["する"],["と"],["ヨハネ"],["が"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["先生","せんせい"],["、"],["わたしたち"],["は"],["ある"],["人","ひと"],["が"],["あなた"],["の"],["名","な"],["を"],["使って","つかって"],["悪霊","あくれい"],["を"],["追い出して","おいだして"],["いる"],["の"],["を"],["見ました","みました"],["が"],["、"],["その"],["人","ひと"],["は"],["わたしたち"],["の"],["仲間","なかま"],["で"],["ない"],["ので"],["、"],["やめさせました"],["」"],["。"]]},{"verse":50,"text":"イエスは彼,かれに言,いわれた、「やめさせないがよい。あなたがたに反対,はんたいしない者,ものは、あなたがたの味方,みかたなのである」。","tok":[["イエス"],["は"],["彼","かれ"],["に"],["言われた","いわれた"],["、"],["「"],["やめさせない"],["が"],["よい"],["。"],["あなた"],["がた"],["に"],["反対","はんたい"],["しない"],["者","もの"],["は"],["、"],["あなた"],["がた"],["の"],["味方","みかた"],["な"],["ので"],["ある"],["」"],["。"]]},{"verse":51,"text":"さて、イエスが天,てんに上,あげられる日,ひが近,ちかづいたので、エルサレムへ行,いこうと決意,けついして、その方,ほうへ顔,かおをむけられ、","tok":[["さて"],["、"],["イエス"],["が"],["天","てん"],["に"],["上げられる","あげられる"],["日","ひ"],["が"],["近づいた","ちかづいた"],["ので"],["、"],["エルサレム"],["へ"],["行こう","いこう"],["と"],["決意","けつい"],["して"],["、"],["その"],["方","ほう"],["へ"],["顔","かお"],["を"],["むけられ"],["、"]]},{"verse":52,"text":"自分,じぶんに先立,さきだって使者,ししゃたちをおつかわしになった。そして彼,かれらがサマリヤ人,びとの村,むらへはいって行,いき、イエスのために準備,じゅんびをしようとしたところ、","tok":[["自分","じぶん"],["に"],["先立って","さきだって"],["使者","ししゃ"],["たち"],["を"],["おつかわし"],["に"],["なった"],["。"],["そして"],["彼","かれ"],["ら"],["が"],["サマリヤ"],["人","びと"],["の"],["村","むら"],["へ"],["はいって"],["行き","いき"],["、"],["イエス"],["の"],["ため"],["に"],["準備","じゅんび"],["を"],["しよう"],["と"],["した"],["ところ"],["、"]]},{"verse":53,"text":"村人,むらびとは、エルサレムへむかって進,すすんで行,いかれるというので、イエスを歓迎,かんげいしようとはしなかった。","tok":[["村人","むらびと"],["は"],["、"],["エルサレム"],["へ"],["むかって"],["進んで","すすんで"],["行かれる","いかれる"],["と"],["いう"],["ので"],["、"],["イエス"],["を"],["歓迎","かんげい"],["しよう"],["と"],["は"],["しなかった"],["。"]]},{"verse":54,"text":"弟子,でしのヤコブとヨハネとはそれを見,みて言,いった、「主,しゅよ、いかがでしょう。彼,かれらを焼,やき払,はらってしまうように、天,てんから火,ひをよび求,もとめましょうか」。","tok":[["弟子","でし"],["の"],["ヤコブ"],["と"],["ヨハネ"],["と"],["は"],["それ"],["を"],["見て","みて"],["言った","いった"],["、"],["「"],["主","しゅ"],["よ"],["、"],["いかが"],["でしょう"],["。"],["彼","かれ"],["ら"],["を"],["焼き払って","やきはらって"],["しまう"],["よう"],["に"],["、"],["天","てん"],["から"],["火","ひ"],["を"],["よび求めましょう","よびもとめましょう"],["か"],["」"],["。"]]},{"verse":55,"text":"イエスは振,ふりかえって、彼,かれらをおしかりになった。","tok":[["イエス"],["は"],["振りかえって","ふりかえって"],["、"],["彼","かれ"],["ら"],["を"],["おしかり"],["に"],["なった"],["。"]]},{"verse":56,"text":"そして一同,いちどうはほかの村,むらへ行,いった。","tok":[["そして"],["一同","いちどう"],["は"],["ほか"],["の"],["村","むら"],["へ"],["行った","いった"],["。"]]},{"verse":57,"text":"道,みちを進,すすんで行,いくと、ある人,ひとがイエスに言,いった、「あなたがおいでになる所,ところならどこへでも従,したがってまいります」。","tok":[["道","みち"],["を"],["進んで","すすんで"],["行く","いく"],["と"],["、"],["ある"],["人","ひと"],["が"],["イエス"],["に"],["言った","いった"],["、"],["「"],["あなた"],["が"],["おいで"],["に"],["なる"],["所","ところ"],["なら"],["どこ"],["へ"],["で"],["も"],["従って","したがって"],["まいります"],["」"],["。"]]},{"verse":58,"text":"イエスはその人,ひとに言,いわれた、「きつねには穴,あながあり、空,そらの鳥,とりには巣,すがある。しかし、人,ひとの子,こにはまくらする所,ところがない」。","tok":[["イエス"],["は"],["その"],["人","ひと"],["に"],["言われた","いわれた"],["、"],["「"],["きつね"],["に"],["は"],["穴","あな"],["が"],["あり"],["、"],["空","そら"],["の"],["鳥","とり"],["に"],["は"],["巣","す"],["が"],["ある"],["。"],["しかし"],["、"],["人","ひと"],["の"],["子","こ"],["に"],["は"],["まくら"],["する"],["所","ところ"],["が"],["ない"],["」"],["。"]]},{"verse":59,"text":"またほかの人,ひとに、「わたしに従,したがってきなさい」と言,いわれた。するとその人,ひとが言,いった、「まず、父,ちちを葬,ほうむりに行,いかせてください」。","tok":[["また"],["ほか"],["の"],["人","ひと"],["に"],["、"],["「"],["わたし"],["に"],["従って","したがって"],["き"],["なさい"],["」"],["と"],["言われた","いわれた"],["。"],["する"],["と"],["その"],["人","ひと"],["が"],["言った","いった"],["、"],["「"],["まず"],["、"],["父","ちち"],["を"],["葬むり","ほうむり"],["に"],["行かせて","いかせて"],["ください"],["」"],["。"]]},{"verse":60,"text":"彼,かれに言,いわれた、「その死人,しにんを葬,ほうむることは、死人,しにんに任,まかせておくがよい。あなたは、出,でて行,いって神,かみの国,くにを告,つげひろめなさい」。","tok":[["彼","かれ"],["に"],["言われた","いわれた"],["、"],["「"],["その"],["死人","しにん"],["を"],["葬むる","ほうむる"],["こと"],["は"],["、"],["死人","しにん"],["に"],["任せて","まかせて"],["おく"],["が"],["よい"],["。"],["あなた"],["は"],["、"],["出て","でて"],["行って","いって"],["神","かみ"],["の"],["国","くに"],["を"],["告","つげ"],["ひろめ"],["なさい"],["」"],["。"]]},{"verse":61,"text":"またほかの人,ひとが言,いった、「主,しゅよ、従,したがってまいりますが、まず家,いえの者,ものに別,わかれを言,いいに行,いかせてください」。","tok":[["また"],["ほか"],["の"],["人","ひと"],["が"],["言った","いった"],["、"],["「"],["主","しゅ"],["よ"],["、"],["従って","したがって"],["まいります"],["が"],["、"],["まず"],["家","いえ"],["の"],["者","もの"],["に"],["別れ","わかれ"],["を"],["言い","いい"],["に"],["行かせて","いかせて"],["ください"],["」"],["。"]]},{"verse":62,"text":"イエスは言,いわれた、「手,てをすきにかけてから、うしろを見,みる者,ものは、神,かみの国,くににふさわしくないものである」。","tok":[["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["手","て"],["を"],["すき"],["に"],["かけて"],["から"],["、"],["うしろ"],["を"],["見る","みる"],["者","もの"],["は"],["、"],["神","かみ"],["の"],["国","くに"],["に"],["ふさわしく"],["ない"],["もの"],["で"],["ある"],["」"],["。"]]}]
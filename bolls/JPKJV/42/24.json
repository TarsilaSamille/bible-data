[{"verse":1,"text":"週,しゅうの初,はじめの日,ひ、夜明,よあけ前,まえに、女,おんなたちは用意,よういしておいた香料,こうりょうを携,たずさえて、墓,はかに行,いった。","tok":[["週","しゅう"],["の"],["初め","はじめ"],["の"],["日","ひ"],["、"],["夜明","よあけ"],["前","まえ"],["に"],["、"],["女","おんな"],["たち"],["は"],["用意","ようい"],["して"],["おいた"],["香料","こうりょう"],["を"],["携えて","たずさえて"],["、"],["墓","はか"],["に"],["行った","いった"],["。"]]},{"verse":2,"text":"ところが、石,いしが墓,はかからころがしてあるので、","tok":[["ところ"],["が"],["、"],["石","いし"],["が"],["墓","はか"],["から"],["ころがして"],["ある"],["ので"],["、"]]},{"verse":3,"text":"中,なかにはいってみると、主,しゅイエスのからだが見当,みあたらなかった。","tok":[["中","なか"],["に"],["はいって"],["みる"],["と"],["、"],["主","しゅ"],["イエス"],["の"],["からだ"],["が"],["見当たらなかった","みあたらなかった"],["。"]]},{"verse":4,"text":"そのため途方,とほうにくれていると、見,みよ、輝,かがやいた衣,ころもを着,きたふたりの者,ものが、彼,かれらに現,あらわれた。","tok":[["その"],["ため"],["途方","とほう"],["に"],["くれて"],["いる"],["と"],["、"],["見よ","みよ"],["、"],["輝やいた","かがやいた"],["衣","ころも"],["を"],["着た","きた"],["ふたり"],["の"],["者","もの"],["が"],["、"],["彼","かれ"],["ら"],["に"],["現われた","あらわれた"],["。"]]},{"verse":5,"text":"女,おんなたちは驚,おどろき恐,おそれて、顔,かおを地,ちに伏,ふせていると、このふたりの者,ものが言,いった、「あなたがたは、なぜ生,いきた方,ほうを死人,しにんの中,なかにたずねているのか。","tok":[["女","おんな"],["たち"],["は"],["驚","おどろき"],["恐れて","おそれて"],["、"],["顔","かお"],["を"],["地","ち"],["に"],["伏せて","ふせて"],["いる"],["と"],["、"],["この"],["ふたり"],["の"],["者","もの"],["が"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["、"],["なぜ"],["生きた","いきた"],["方","ほう"],["を"],["死人","しにん"],["の"],["中","なか"],["に"],["たずねて"],["いる"],["の"],["か"],["。"]]},{"verse":6,"text":"そのかたは、ここにはおられない。よみがえられたのだ。まだガリラヤにおられたとき、あなたがたにお話,はなしになったことを思,おもい出,だしなさい。","tok":[["その"],["かた"],["は"],["、"],["ここ"],["に"],["は"],["おられない"],["。"],["よみがえられた"],["の"],["だ"],["。"],["まだ"],["ガリラヤ"],["に"],["おられた"],["とき"],["、"],["あなた"],["がた"],["に"],["お話","おはなし"],["に"],["なった"],["こと"],["を"],["思い出し","おもいだし"],["なさい"],["。"]]},{"verse":7,"text":"すなわち、人,ひとの子,こは必,かならず罪人,つみびとらの手,てに渡,わたされ、十字架,じゅうじかにつけられ、そして三日,か目,めによみがえる、と仰,おおせられたではないか」。","tok":[["すなわち"],["、"],["人","ひと"],["の"],["子","こ"],["は"],["必","かならず"],["罪人","つみびとら"],["の"],["手","て"],["に"],["渡され","わたされ"],["、"],["十字架","じゅうじか"],["に"],["つけられ"],["、"],["そして"],["三日目","かめ"],["に"],["よみがえる"],["、"],["と"],["仰せられたで","おおせられたで"],["は"],["ない"],["か"],["」"],["。"]]},{"verse":8,"text":"そこで女,おんなたちはその言葉,ことばを思,おもい出,だし、","tok":[["そこ"],["で"],["女","おんな"],["たち"],["は"],["その"],["言葉","ことば"],["を"],["思い出し","おもいだし"],["、"]]},{"verse":9,"text":"墓,はかから帰,かえって、これらいっさいのことを、十一弟子,でしや、その他,たみんなの人,ひとに報告,ほうこくした。","tok":[["墓","はか"],["から"],["帰えって","かえって"],["、"],["これ"],["ら"],["いっさい"],["の"],["こと"],["を"],["、"],["十一","じゅういち"],["弟子","でし"],["し"],["や"],["、"],["その"],["他","た"],["みんな"],["の"],["人","ひと"],["に"],["報告","ほうこく"],["した"],["。"]]},{"verse":10,"text":"この女,おんなたちというのは、マグダラのマリヤ、ヨハンナ、およびヤコブの母,ははマリヤであった。彼女,かのじょたちと一緒,いっしょにいたほかの女,おんなたちも、このことを使徒,しとたちに話,はなした。","tok":[["この"],["女","おんな"],["たち"],["と"],["いう"],["の"],["は"],["、"],["マグダラ"],["の"],["マリヤ"],["、"],["ヨハンナ"],["、"],["および"],["ヤコブ"],["の"],["母","はは"],["マリヤ"],["で"],["あった"],["。"],["彼女","かのじょ"],["たち"],["と"],["一緒","いっしょ"],["に"],["いた"],["ほか"],["の"],["女","おんな"],["たち"],["も"],["、"],["この"],["こと"],["を"],["使徒","しと"],["たち"],["に"],["話","はなし"],["た"],["。"]]},{"verse":11,"text":"ところが、使徒,しとたちには、それが愚,おろかな話,はなしのように思,おもわれて、それを信,しんじなかった。〔","tok":[["ところ"],["が"],["、"],["使徒","しと"],["たち"],["に"],["は"],["、"],["それ"],["が"],["愚か","おろか"],["な"],["話","はなし"],["の"],["よう"],["に"],["思われて","おもわれて"],["、"],["それ"],["を"],["信じなかった","しんじなかった"],["。"],["〔"]]},{"verse":12,"text":"ペテロは立,たって墓,はかへ走,はしって行,いき、かがんで中,なかを見,みると、亜麻布,あまぬのだけがそこにあったので、事,ことの次第,しだいを不思議,ふしぎに思,おもいながら帰,かえって行,いった。〕","tok":[["ペテロ"],["は"],["立って","たって"],["墓","はか"],["へ"],["走って","はしって"],["行き","いき"],["、"],["かがんで"],["中","なか"],["を"],["見る","みる"],["と"],["、"],["亜","あ"],["麻布","あざぶ"],["の"],["だけ"],["が"],["そこ"],["に"],["あった"],["ので"],["、"],["事","こと"],["の"],["次第","しだい"],["を"],["不思議","ふしぎ"],["に"],["思い","おもい"],["ながら"],["帰えって","かえって"],["行った","いった"],["。"],["〕"]]},{"verse":13,"text":"この日,ひ、ふたりの弟子,でしが、エルサレムから七マイルばかり離,はなれたエマオという村,むらへ行,いきながら、","tok":[["この"],["日","ひ"],["、"],["ふたり"],["の"],["弟子","でし"],["が"],["、"],["エルサレム"],["から"],["七","なな"],["マイル"],["ばかり"],["離れた","はなれた"],["エマオ"],["と"],["いう"],["村","むら"],["へ"],["行き","いき"],["ながら"],["、"]]},{"verse":14,"text":"このいっさいの出来事,できごとについて互,たがいに語,かたり合,あっていた。","tok":[["この"],["いっさい"],["の"],["出来事","できごと"],["について"],["互","たがい"],["に"],["語り合って","かたりあって"],["いた"],["。"]]},{"verse":15,"text":"語,かたり合,あい論,ろんじ合,あっていると、イエスご自身,じしんが近,ちかづいてきて、彼,かれらと一緒,いっしょに歩,あるいて行,いかれた。","tok":[["語り合い","かたりあい"],["論じ合って","ろんじあって"],["いる"],["と"],["、"],["イエス"],["ご自身","ごじしん"],["が"],["近づいて","ちかづいて"],["きて"],["、"],["彼","かれ"],["ら"],["と"],["一緒","いっしょ"],["に"],["歩いて","あるいて"],["行かれた","いかれた"],["。"]]},{"verse":16,"text":"しかし、彼,かれらの目,めがさえぎられて、イエスを認,みとめることができなかった。","tok":[["しかし"],["、"],["彼","かれ"],["ら"],["の"],["目","め"],["が"],["さえぎられて"],["、"],["イエス"],["を"],["認める","みとめる"],["こと"],["が"],["できなかった"],["。"]]},{"verse":17,"text":"イエスは彼,かれらに言,いわれた、「歩,あるきながら互,たがいに語,かたり合,あっているその話,はなしは、なんのことなのか」。彼,かれらは悲,かなしそうな顔,かおをして立,たちどまった。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["歩き","あるき"],["ながら"],["互","たがい"],["に"],["語り合って","かたりあって"],["いる"],["その"],["話","はなし"],["は"],["、"],["なん"],["の"],["こと"],["な"],["の"],["か"],["」"],["。"],["彼","かれ"],["ら"],["は"],["悲し","かなし"],["そう"],["な"],["顔","かお"],["を"],["して"],["立ちどまった","たちどまった"],["。"]]},{"verse":18,"text":"そのひとりのクレオパという者,ものが、答,こたえて言,いった、「あなたはエルサレムに泊,とまっていながら、あなただけが、この都,みやこでこのごろ起,おこったことをご存,ぞんじないのですか」。","tok":[["その"],["ひとり"],["の"],["クレオパ"],["と"],["いう"],["者","もの"],["が"],["、"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["あなた"],["は"],["エルサレム"],["に"],["泊まって","とまって"],["い"],["ながら"],["、"],["あなた"],["だけ"],["が"],["、"],["この"],["都","みやこでこ"],["の"],["ごろ"],["起こった","おこった"],["こと"],["を"],["ご存じ","ごぞんじ"],["ない"],["の"],["です"],["か"],["」"],["。"]]},{"verse":19,"text":"「それは、どんなことか」と言,いわれると、彼,かれらは言,いった、「ナザレのイエスのことです。あのかたは、神,かみとすべての民衆,みんしゅうとの前,まえで、わざにも言葉,ことばにも力,ちからある預言者,よげんしゃでしたが、","tok":[["「"],["それ"],["は"],["、"],["どんな"],["こと"],["か"],["」"],["と"],["言われる","いわれる"],["と"],["、"],["彼","かれ"],["ら"],["は"],["言った","いった"],["、"],["「"],["ナザレ"],["の"],["イエス"],["の"],["こと"],["です"],["。"],["あの"],["かた"],["は"],["、"],["神","かみ"],["と"],["すべて"],["の"],["民衆","みんしゅう"],["と"],["の"],["前","まえ"],["で"],["、"],["わざ"],["に"],["も"],["言葉","ことば"],["に"],["も"],["力","ちから"],["ある"],["預言者","よげんしゃ"],["でした"],["が"],["、"]]},{"verse":20,"text":"祭司長,さいしちょうたちや役人,やくにんたちが、死刑,しけいに処,しょするために引,ひき渡,わたし、十字架,じゅうじかにつけたのです。","tok":[["祭司長","さいしちょう"],["たち"],["や"],["役人","やくにん"],["たち"],["が"],["、"],["死刑","しけい"],["に"],["処する","しょする"],["ため"],["に"],["引渡","ひきわたし"],["、"],["十字架","じゅうじか"],["に"],["つけた"],["の"],["です"],["。"]]},{"verse":21,"text":"わたしたちは、イスラエルを救,すくうのはこの人,ひとであろうと、望,のぞみをかけていました。しかもその上,うえに、この事,ことが起,おこってから、きょうが三日,か目,めなのです。","tok":[["わたしたち"],["は"],["、"],["イスラエル"],["を"],["救う","すくう"],["の"],["は"],["この"],["人","ひと"],["で"],["あろう"],["と"],["、"],["望み","のぞみ"],["を"],["かけて"],["いました"],["。"],["しかも"],["その"],["上","うえ"],["に"],["、"],["この"],["事","こと"],["が"],["起こって","おこって"],["から"],["、"],["きょう"],["が"],["三日目","かめ"],["な"],["の"],["です"],["。"]]},{"verse":22,"text":"ところが、わたしたちの仲間,なかまである数人,すうにんの女,おんなが、わたしたちを驚,おどろかせました。というのは、彼,かれらが朝,あさ早,はやく墓,はかに行,いきますと、","tok":[["ところ"],["が"],["、"],["わたしたち"],["の"],["仲間","なかま"],["で"],["ある"],["数人","すうにん"],["の"],["女","おんな"],["が"],["、"],["わたしたち"],["を"],["驚ろかせました","おどろかせました"],["。"],["と"],["いう"],["の"],["は"],["、"],["彼","かれ"],["ら"],["が"],["朝","あさ"],["早く","はやく"],["墓","はか"],["に"],["行きます","いきます"],["と"],["、"]]},{"verse":23,"text":"イエスのからだが見当,みあたらないので、帰,かえってきましたが、そのとき御使,みつかいが現,あらわれて、『イエスは生,いきておられる』と告,つげたと申,もうすのです。","tok":[["イエス"],["の"],["からだ"],["が"],["見当たらない","みあたらない"],["ので"],["、"],["帰えって","かえって"],["きました"],["が"],["、"],["その"],["とき"],["御使","み"],["つかい"],["が"],["現われて","あらわれて"],["、"],["『"],["イエス"],["は"],["生きて","いきて"],["おられる"],["』"],["と"],["告","つげ"],["た"],["と"],["申す","もうす"],["の"],["です"],["。"]]},{"verse":24,"text":"それで、わたしたちの仲間,なかまが数人,すうにん、墓,はかに行,いって見,みますと、果,はたして女,おんなたちが言,いったとおりで、イエスは見当,みあたりませんでした」。","tok":[["それ"],["で"],["、"],["わたしたち"],["の"],["仲間","なかま"],["が"],["数人","す"],["うに"],["ん"],["、"],["墓","はか"],["に"],["行って","いって"],["見ます","みます"],["と"],["、"],["果して","はたして"],["女","おんな"],["たち"],["が"],["言った","いった"],["とおり"],["で"],["、"],["イエス"],["は"],["見当たりませんでした","みあたりませんでした"],["」"],["。"]]},{"verse":25,"text":"そこでイエスが言,いわれた、「ああ、愚,おろかで心,こころのにぶいため、預言者,よげんしゃたちが説,といたすべての事,ことを信,しんじられない者,ものたちよ。","tok":[["そこ"],["で"],["イエス"],["が"],["言われた","いわれた"],["、"],["「"],["ああ"],["、"],["愚か","おろか"],["で"],["心","こころ"],["の"],["にぶい"],["ため"],["、"],["預言者","よげんしゃ"],["たち"],["が"],["説いた","といた"],["すべて"],["の"],["事","こと"],["を"],["信じられない","しんじられない"],["者","もの"],["たち"],["よ"],["。"]]},{"verse":26,"text":"キリストは必,かならず、これらの苦難,くなんを受,うけて、その栄光,えいこうに入,はいるはずではなかったのか」。","tok":[["キリスト"],["は"],["必","かならず"],["、"],["これ"],["ら"],["の"],["苦難","くなん"],["を"],["受て","うけて"],["、"],["その"],["栄光","えいこう"],["に"],["入る","はいる"],["はず"],["で"],["は"],["なかった"],["の"],["か"],["」"],["。"]]},{"verse":27,"text":"こう言,いって、モーセやすべての預言者,よげんしゃからはじめて、聖書,せいしょ全体,ぜんたいにわたり、ご自身,じしんについてしるしてある事,ことどもを、説,ときあかされた。","tok":[["こう"],["言って","いって"],["、"],["モーセ"],["や"],["すべて"],["の"],["預言者","よげんしゃ"],["から"],["はじめて"],["、"],["聖書","せいしょ"],["全体","ぜんたい"],["に"],["わたり"],["、"],["ご自身","ごじしん"],["について"],["しるして"],["ある"],["事","こと"],["ども"],["を"],["、"],["説きあかされた","ときあかされた"],["。"]]},{"verse":28,"text":"それから、彼,かれらは行,いこうとしていた村,むらに近,ちかづいたが、イエスがなお先,さきへ進,すすみ行,いかれる様子,ようすであった。","tok":[["それ"],["から"],["、"],["彼","かれ"],["ら"],["は"],["行こう","いこう"],["として"],["いた"],["村","むら"],["に"],["近づいた","ちかづいた"],["が"],["、"],["イエス"],["が"],["なお"],["先","さき"],["へ"],["進み","すすみ"],["行かれる","いかれる"],["様子","ようす"],["で"],["あった"],["。"]]},{"verse":29,"text":"そこで、しいて引,ひき止,とめて言,いった、「わたしたちと一緒,いっしょにお泊,とまり下,ください。もう夕暮,ゆうぐれになっており、日,ひもはや傾,かたむいています」。イエスは、彼,かれらと共,ともに泊,とまるために、家,いえにはいられた。","tok":[["そこ"],["で"],["、"],["しいて"],["引","ひき"],["止","とめ"],["て"],["言った","いった"],["、"],["「"],["わたしたち"],["と"],["一緒","いっしょ"],["に"],["お泊まり","おとまり"],["下さい","ください"],["。"],["もう"],["夕暮","ゆうぐれ"],["に"],["なって"],["おり"],["、"],["日","ひ"],["もはや"],["傾いて","かたむいて"],["います"],["」"],["。"],["イエス"],["は"],["、"],["彼","かれ"],["ら"],["と"],["共","とも"],["に"],["泊まる","とまる"],["ため"],["に"],["、"],["家","いえ"],["に"],["は"],["いられた"],["。"]]},{"verse":30,"text":"一緒,いっしょに食卓,しょくたくにつかれたとき、パンを取,とり、祝福,しゅくふくしてさき、彼,かれらに渡,わたしておられるうちに、","tok":[["一緒","いっしょ"],["に"],["食卓","しょくたく"],["に"],["つかれた"],["とき"],["、"],["パン"],["を"],["取","とり"],["、"],["祝福","しゅくふく"],["して"],["さき"],["、"],["彼","かれ"],["ら"],["に"],["渡","わたし"],["て"],["おられる"],["うち"],["に"],["、"]]},{"verse":31,"text":"彼,かれらの目,めが開,ひらけて、それがイエスであることがわかった。すると、み姿,すがたが見,みえなくなった。","tok":[["彼","かれ"],["ら"],["の"],["目","め"],["が"],["開て","ひらけて"],["、"],["それ"],["が"],["イエス"],["で"],["ある"],["こと"],["が"],["わかった"],["。"],["する"],["と"],["、"],["み姿","みすがた"],["が"],["見えなく","みえなく"],["なった"],["。"]]},{"verse":32,"text":"彼,かれらは互,たがいに言,いった、「道々,みちみちお話,はなしになったとき、また聖書,せいしょを説,とき明,めいしてくださったとき、お互,たがいの心,こころが内,うちに燃,もえたではないか」。","tok":[["彼","かれ"],["ら"],["は"],["互","たがい"],["に"],["言った","いった"],["、"],["「"],["道々","みちみち"],["お話","おはなし"],["に"],["なった"],["とき"],["、"],["また"],["聖書","せいしょ"],["を"],["説き","とき"],["明い","めい"],["して"],["くださった"],["とき"],["、"],["お互","おたがい"],["の"],["心","こころ"],["が"],["内","うち"],["に"],["燃えたで","もえたで"],["は"],["ない"],["か"],["」"],["。"]]},{"verse":33,"text":"そして、すぐに立,たってエルサレムに帰,かえって見,みると、十一弟子,でしとその仲間,なかまが集,あつまっていて、","tok":[["そして"],["、"],["すぐ"],["に"],["立って","たって"],["エルサレム"],["に"],["帰えって","かえって"],["見る","みる"],["と"],["、"],["十一","じゅういち"],["弟子","でし"],["の"],["仲間","なかま"],["が"],["集まって","あつまって"],["いて"],["、"]]},{"verse":34,"text":"「主,しゅは、ほんとうによみがえって、シモンに現,あらわれなさった」と言,いっていた。","tok":[["「"],["主","しゅ"],["は"],["、"],["ほんとう"],["に"],["よみがえって"],["、"],["シモン"],["に"],["現われ","あらわれ"],["なさった"],["」"],["と"],["言って","いって"],["いた"],["。"]]},{"verse":35,"text":"そこでふたりの者,ものは、途中,とちゅうであったことや、パンをおさきになる様子,ようすでイエスだとわかったことなどを話,はなした。","tok":[["そこ"],["で"],["ふたり"],["の"],["者","もの"],["は"],["、"],["途中","とちゅう"],["で"],["あった"],["こと"],["や"],["、"],["パン"],["を"],["お"],["さき"],["に"],["なる"],["様子","ようす"],["で"],["イエス"],["だ"],["と"],["わかった"],["こと"],["など"],["を"],["話","はなし"],["た"],["。"]]},{"verse":36,"text":"こう話,はなしていると、イエスが彼,かれらの中,なかにお立,たちになった。〔そして「やすかれ」と言,いわれた。〕","tok":[["こう"],["話","はなし"],["て"],["いる"],["と"],["、"],["イエス"],["が"],["彼","かれ"],["ら"],["の"],["中","なか"],["に"],["お立ち","おたち"],["に"],["なった"],["。"],["〔"],["そして"],["「"],["やすかれ"],["」"],["と"],["言われた","いわれた"],["。"],["〕"]]},{"verse":37,"text":"彼,かれらは恐,おそれ驚,おどろいて、霊,れいを見,みているのだと思,おもった。","tok":[["彼","かれ"],["ら"],["は"],["恐","おそれ"],["驚ろいて","おどろいて"],["、"],["霊","れい"],["を"],["見て","みて"],["いる"],["の"],["だ"],["と"],["思った","おもった"],["。"]]},{"verse":38,"text":"そこでイエスが言,いわれた、「なぜおじ惑,まどっているのか。どうして心,こころに疑,うたがいを起,おこすのか。","tok":[["そこ"],["で"],["イエス"],["が"],["言われた","いわれた"],["、"],["「"],["なぜ"],["おじ"],["惑って","まどって"],["いる"],["の"],["か"],["。"],["どう"],["して"],["心","こころ"],["に"],["疑がい","うたがい"],["を"],["起こす","おこす"],["の"],["か"],["。"]]},{"verse":39,"text":"わたしの手,てや足,あしを見,みなさい。まさしくわたしなのだ。さわって見,みなさい。霊,れいには肉,にくや骨,ほねはないが、あなたがたが見,みるとおり、わたしにはあるのだ」。〔","tok":[["わたし"],["の"],["手","て"],["や"],["足","あし"],["を"],["見","み"],["なさい"],["。"],["まさしく"],["わたし"],["な"],["の"],["だ"],["。"],["さわって"],["見","み"],["なさい"],["。"],["霊","れい"],["に"],["は"],["肉","にく"],["や"],["骨","ほね"],["は"],["ない"],["が"],["、"],["あなた"],["がた"],["が"],["見る","みる"],["と"],["おり"],["、"],["わたし"],["に"],["は"],["ある"],["の"],["だ"],["」"],["。"],["〔"]]},{"verse":40,"text":"こう言,いって、手,てと足,あしとをお見,みせになった。〕","tok":[["こう"],["言って","いって"],["、"],["手","て"],["と"],["足","あし"],["と"],["を"],["お見せ","おみせ"],["に"],["なった"],["。"],["〕"]]},{"verse":41,"text":"彼,かれらは喜,よろこびのあまり、まだ信,しんじられないで不思議,ふしぎに思,おもっていると、イエスが「ここに何,なにか食物,しょくもつがあるか」と言,いわれた。","tok":[["彼","かれ"],["ら"],["は"],["喜こび","よろこび"],["の"],["あまり"],["、"],["まだ"],["信じられないで","しんじられないで"],["不思議","ふしぎ"],["に"],["思って","おもって"],["いる"],["と"],["、"],["イエス"],["が"],["「"],["ここ"],["に"],["何に","なに"],["か"],["食物","しょくもつ"],["が"],["ある"],["か"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":42,"text":"彼,かれらが焼,やいた魚,うおの一きれをさしあげると、","tok":[["彼","かれ"],["ら"],["が"],["焼いた","やいた"],["魚","うお"],["の"],["一","いち"],["きれ"],["を"],["さしあげる"],["と"],["、"]]},{"verse":43,"text":"イエスはそれを取,とって、みんなの前,まえで食,たべられた。","tok":[["イエス"],["は"],["それ"],["を"],["取って","とって"],["、"],["みんな"],["の"],["前","まえ"],["で"],["食べられた","たべられた"],["。"]]},{"verse":44,"text":"それから彼,かれらに対,たいして言,いわれた、「わたしが以前,いぜんあなたがたと一緒,いっしょにいた時分,じぶんに話,はなして聞,きかせた言葉,ことばは、こうであった。すなわち、モーセの律法,りっぽうと預言,よげん書,しょと詩篇,しへんとに、わたしについて書,かいてあることは、必,かならずことごとく成就,じょうじゅする」。","tok":[["それ"],["から"],["彼","かれ"],["ら"],["に対して","にたいして"],["言われた","いわれた"],["、"],["「"],["わたし"],["が"],["以前","いぜん"],["あなた"],["がた"],["と"],["一緒","いっしょ"],["に"],["いた"],["時分","じぶん"],["に"],["話","はなし"],["て"],["聞かせた","きかせた"],["言葉","ことば"],["は"],["、"],["こう"],["で"],["あった"],["。"],["すなわち"],["、"],["モーセ"],["の"],["律法","りっぽう"],["と"],["預言書","よげんしょ"],["と"],["詩篇","しへん"],["と"],["に"],["、"],["わたし"],["について"],["書いて","かいて"],["ある"],["こと"],["は"],["、"],["必","かならず"],["ことごとく"],["成就","じょうじゅ"],["する"],["」"],["。"]]},{"verse":45,"text":"そこでイエスは、聖書,せいしょを悟,さとらせるために彼,かれらの心,こころを開,ひらいて","tok":[["そこ"],["で"],["イエス"],["は"],["、"],["聖書","せいしょ"],["を"],["悟らせる","さとらせる"],["ため"],["に"],["彼","かれ"],["ら"],["の"],["心","こころ"],["を"],["開らいて","ひらいて"]]},{"verse":46,"text":"言,いわれた、「こう、しるしてある。キリストは苦,くるしみを受,うけて、三日,か目,めに死人,しにんの中,なかからよみがえる。","tok":[["言われた","いわれた"],["、"],["「"],["こう"],["、"],["しるして"],["ある"],["。"],["キリスト"],["は"],["苦しみ","くるしみ"],["を"],["受て","うけて"],["、"],["三日目","かめ"],["に"],["死人","しにん"],["の"],["中","なか"],["から"],["よみがえる"],["。"]]},{"verse":47,"text":"そして、その名,なによって罪,つみのゆるしを得,えさせる悔改,くいあらためが、エルサレムからはじまって、もろもろの国民,こくみんに宣,のべ伝,つたえられる。","tok":[["そして"],["、"],["その"],["名","な"],["によって"],["罪","つみ"],["の"],["ゆるし"],["を"],["得させる","えさせる"],["悔改め","くいあらため"],["が"],["、"],["エルサレム"],["から"],["はじまって"],["、"],["もろもろ"],["の"],["国民","こくみん"],["に"],["宣べ伝えられる","のべつたえられる"],["。"]]},{"verse":48,"text":"あなたがたは、これらの事,ことの証人,しょうにんである。","tok":[["あなた"],["がた"],["は"],["、"],["これ"],["ら"],["の"],["事","こと"],["の"],["証人","しょうにん"],["で"],["ある"],["。"]]},{"verse":49,"text":"見,みよ、わたしの父,ちちが約束,やくそくされたものを、あなたがたに贈,おくる。だから、上,うえから力,ちからを授,さづけられるまでは、あなたがたは都,みやこにとどまっていなさい」。","tok":[["見よ","みよ"],["、"],["わたし"],["の"],["父","ちち"],["が"],["約束","やくそく"],["された"],["もの"],["を"],["、"],["あなた"],["がた"],["に"],["贈る","おくる"],["。"],["だ"],["から"],["、"],["上","うえ"],["から"],["力","ちから"],["を"],["授","さ"],["づけられる"],["まで"],["は"],["、"],["あなた"],["がた"],["は"],["都","みやこ"],["に"],["とどまって"],["い"],["なさい"],["」"],["。"]]},{"verse":50,"text":"それから、イエスは彼,かれらをベタニヤの近,ちかくまで連,つれて行,いき、手,てをあげて彼,かれらを祝福,しゅくふくされた。","tok":[["それ"],["から"],["、"],["イエス"],["は"],["彼","かれ"],["ら"],["を"],["ベタニヤ"],["の"],["近く","ちかく"],["まで"],["連れて","つれて"],["行き","いき"],["、"],["手","て"],["を"],["あげて"],["彼","かれ"],["ら"],["を"],["祝福","しゅくふく"],["された"],["。"]]},{"verse":51,"text":"祝福,しゅくふくしておられるうちに、彼,かれらを離,はなれて、〔天,てんにあげられた。〕","tok":[["祝福","しゅくふく"],["して"],["おられる"],["うち"],["に"],["、"],["彼","かれ"],["ら"],["を"],["離れて","はなれて"],["、"],["〔"],["天","てん"],["に"],["あげられた"],["。"],["〕"]]},{"verse":52,"text":"彼,かれらは〔イエスを拝,はいし、〕非常,ひじょうな喜,よろこびをもってエルサレムに帰,かえり、","tok":[["彼","かれ"],["ら"],["は"],["〔"],["イエス"],["を"],["拝し","はいし"],["、"],["〕"],["非常","ひじょう"],["な"],["喜こび","よろこび"],["を"],["もって"],["エルサレム"],["に"],["帰えり","かえり"],["、"]]},{"verse":53,"text":"絶,たえず宮,みやにいて、神,かみをほめたたえていた。","tok":[["絶えず","たえず"],["宮","みや"],["に"],["いて"],["、"],["神","かみ"],["を"],["ほめたたえて"],["いた"],["。"]]}]
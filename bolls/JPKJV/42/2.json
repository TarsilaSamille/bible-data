[{"verse":1,"text":"そのころ、全,ぜん世界,せかいの人口,じんこう調査,ちょうさをせよとの勅令,ちょくれいが、皇帝,こうていアウグストから出,でた。","tok":[["その"],["ころ"],["、"],["全","ぜん"],["世界","せかい"],["の"],["人口","じんこう"],["調査","ちょうさ"],["を"],["せよ"],["と"],["の"],["勅令","ちょくれい"],["が"],["、"],["皇帝","こうてい"],["アウグスト"],["から"],["出た","でた"],["。"]]},{"verse":2,"text":"これは、クレニオがシリヤの総督,そうとくであった時,ときに行,おこなわれた最初,さいしょの人口,じんこう調査,ちょうさであった。","tok":[["これ"],["は"],["、"],["クレニオ"],["が"],["シリヤ"],["の"],["総督","そうとく"],["で"],["あった"],["時","とき"],["に"],["行なわれた","おこなわれた"],["最初","さいしょ"],["の"],["人口","じんこう"],["調査","ちょうさ"],["で"],["あった"],["。"]]},{"verse":3,"text":"人々,ひとびとはみな登録,とうろくをするために、それぞれ自分,じぶんの町,まちへ帰,かえって行,いった。","tok":[["人々","ひとびと"],["は"],["みな"],["登録","とうろく"],["を"],["する"],["ため"],["に"],["、"],["それぞれ"],["自分","じぶん"],["の"],["町","まち"],["へ"],["帰えって","かえって"],["行った","いった"],["。"]]},{"verse":4,"text":"ヨセフもダビデの家系,かけいであり、またその血統,けっとうであったので、ガリラヤの町,まちナザレを出,でて、ユダヤのベツレヘムというダビデの町,まちへ上,のぼって行,いった。","tok":[["ヨセフ"],["も"],["ダビデ"],["の"],["家系","かけい"],["で"],["あり"],["、"],["また"],["その"],["血統","けっとう"],["で"],["あった"],["ので"],["、"],["ガリラヤ"],["の"],["町","まち"],["ナザレ"],["を"],["出て","でて"],["、"],["ユダヤ"],["の"],["ベツレヘム"],["と"],["いう"],["ダビデ"],["の"],["町","まち"],["へ"],["上って","のぼって"],["行った","いった"],["。"]]},{"verse":5,"text":"それは、すでに身重,みおもになっていたいいなづけの妻,つまマリヤと共,ともに、登録,とうろくをするためであった。","tok":[["それ"],["は"],["、"],["すでに"],["身重","みおも"],["に"],["なって"],["いた"],["いいなづけ"],["の"],["妻","つま"],["マリヤ"],["と"],["共","とも"],["に"],["、"],["登録","とうろく"],["を"],["する"],["ため"],["で"],["あった"],["。"]]},{"verse":6,"text":"ところが、彼,かれらがベツレヘムに滞在,たいざいしている間,あいだに、マリヤは月,つきが満,みちて、","tok":[["ところ"],["が"],["、"],["彼","かれ"],["ら"],["が"],["ベツレヘム"],["に"],["滞在","たいざい"],["して"],["いる"],["間","あいだ"],["に"],["、"],["マリヤ"],["は"],["月","つき"],["が"],["満ちて","みちて"],["、"]]},{"verse":7,"text":"初子,ういごを産,うみ、布,ぬのにくるんで、飼葉,かいばおけの中,なかに寝,ねかせた。客間,きゃくまには彼,かれらのいる余地,よちがなかったからである。","tok":[["初子","ういご"],["を"],["産み","うみ"],["、"],["布","ぬの"],["に"],["くる"],["ん"],["で"],["、"],["飼葉","かいば"],["おけ"],["の"],["中","なか"],["に"],["寝かせた","ねかせた"],["。"],["客間","きゃくま"],["に"],["は"],["彼","かれ"],["ら"],["の"],["いる"],["余地","よち"],["が"],["なかった"],["から"],["で"],["ある"],["。"]]},{"verse":8,"text":"さて、この地方,ちほうで羊飼,ひつじかいたちが夜,よる、野宿,のじゅくしながら羊,ひつじの群,むれの番,ばんをしていた。","tok":[["さて"],["、"],["この"],["地方","ちほう"],["で"],["羊飼","ひつじかい"],["たち"],["が"],["夜","よる"],["、"],["野宿","のじゅく"],["し"],["ながら"],["羊","ひつじ"],["の"],["群れ","むれ"],["の"],["番","ばん"],["を"],["して"],["いた"],["。"]]},{"verse":9,"text":"すると主,しゅの御使,みつかいが現,あらわれ、主,しゅの栄光,えいこうが彼,かれらをめぐり照,てらしたので、彼,かれらは非常,ひじょうに恐,おそれた。","tok":[["する"],["と"],["主","しゅ"],["の"],["御使","み"],["つかい"],["が"],["現われ","あらわれ"],["、"],["主","しゅ"],["の"],["栄光","えいこう"],["が"],["彼","かれ"],["ら"],["を"],["めぐり"],["照","てらし"],["た"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["非常","ひじょう"],["に"],["恐れた","おそれた"],["。"]]},{"verse":10,"text":"御使,みつかいは言,いった、「恐,おそれるな。見,みよ、すべての民,たみに与,あたえられる大,おおきな喜,よろこびを、あなたがたに伝,つたえる。","tok":[["御使","みつかい"],["は"],["言った","いった"],["、"],["「"],["恐れる","おそれる"],["な"],["。"],["見よ","みよ"],["、"],["すべて"],["の"],["民","たみ"],["に"],["与えられる","あたえられる"],["大きな","おおきな"],["喜こび","よろこび"],["を"],["、"],["あなた"],["がた"],["に"],["伝える","つたえる"],["。"]]},{"verse":11,"text":"きょうダビデの町,まちに、あなたがたのために救主,すくいぬしがお生,うまれになった。このかたこそ主,しゅなるキリストである。","tok":[["きょう"],["ダビデ"],["の"],["町","まち"],["に"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["救主","す"],["くい"],["ぬし"],["が"],["お生まれ","おうまれ"],["に"],["なった"],["。"],["この"],["かた"],["こそ"],["主","しゅ"],["なる"],["キリスト"],["で"],["ある"],["。"]]},{"verse":12,"text":"あなたがたは、幼,おさな子,ごが布,ぬのにくるまって飼葉,かいばおけの中,なかに寝,ねかしてあるのを見,みるであろう。それが、あなたがたに与,あたえられるしるしである」。","tok":[["あなた"],["がた"],["は"],["、"],["幼な子","おさなご"],["が"],["布","ぬの"],["に"],["くるまって"],["飼葉","かいば"],["おけ"],["の"],["中","なか"],["に"],["寝かして","ねかして"],["ある"],["の"],["を"],["見るで","みるで"],["あろう"],["。"],["それ"],["が"],["、"],["あなた"],["がた"],["に"],["与えられる","あたえられる"],["しるし"],["で"],["ある"],["」"],["。"]]},{"verse":13,"text":"するとたちまち、おびただしい天,てんの軍勢,ぐんぜいが現,あらわれ、御使,みつかいと一緒,いっしょになって神,かみをさんびして言,いった、","tok":[["する"],["と"],["たちまち"],["、"],["おびただしい"],["天","てん"],["の"],["軍勢","ぐんぜい"],["が"],["現われ","あらわれ"],["、"],["御使","みつかい"],["と"],["一緒","いっしょ"],["に"],["なって"],["神","かみ"],["を"],["さん"],["び"],["して"],["言った","いった"],["、"]]},{"verse":14,"text":"「いと高,たかきところでは、神,かみに栄光,えいこうがあるように、地,ちの上,うえでは、み心,こころにかなう人々,ひとびとに平和,へいわがあるように」。","tok":[["「"],["いと"],["高き","たかき"],["ところ"],["で"],["は"],["、"],["神","かみ"],["に"],["栄光","えいこう"],["が"],["ある"],["よう"],["に"],["、"],["地","ち"],["の"],["上","うえ"],["で"],["は"],["、"],["み心","みこころ"],["に"],["かなう"],["人々","ひとびと"],["に"],["平和","へいわ"],["が"],["ある"],["よう"],["に"],["」"],["。"]]},{"verse":15,"text":"御使,みつかいたちが彼,かれらを離,はなれて天,てんに帰,かえったとき、羊飼,ひつじかいたちは「さあ、ベツレヘムへ行,いって、主,しゅがお知,しらせ下,くださったその出来事,できごとを見,みてこようではないか」と、互,たがいに語,かたり合,あった。","tok":[["御使","みつかい"],["たち"],["が"],["彼","かれ"],["ら"],["を"],["離れて","はなれて"],["天","てん"],["に"],["帰えった","かえった"],["とき"],["、"],["羊飼","ひつじかい"],["たち"],["は"],["「"],["さあ"],["、"],["ベツレヘム"],["へ"],["行って","いって"],["、"],["主","しゅ"],["が"],["お知らせ","おしらせ"],["下さった","くださった"],["その"],["出来事","できごと"],["を"],["見て","みて"],["こようで"],["は"],["ない"],["か"],["」"],["と"],["、"],["互","たがい"],["に"],["語り合った","かたりあった"],["。"]]},{"verse":16,"text":"そして急,いそいで行,いって、マリヤとヨセフ、また飼葉,かいばおけに寝,ねかしてある幼,おさな子,ごを捜,さがしあてた。","tok":[["そして"],["急いで","いそいで"],["行って","いって"],["、"],["マリヤ"],["と"],["ヨセフ"],["、"],["また"],["飼葉","かいば"],["おけ"],["に"],["寝かして","ねかして"],["ある"],["幼な子","おさなご"],["を"],["捜しあてた","さがしあてた"],["。"]]},{"verse":17,"text":"彼,かれらに会,あった上,うえで、この子,こについて自分,じぶんたちに告,つげ知,しらされた事,ことを、人々,ひとびとに伝,つたえた。","tok":[["彼","かれ"],["ら"],["に"],["会った","あった"],["上","うえ"],["で"],["、"],["この"],["子","こ"],["について"],["自分","じぶん"],["たち"],["に"],["告","つげ"],["知らされた","しらされた"],["事","こと"],["を"],["、"],["人々","ひとびと"],["に"],["伝えた","つたえた"],["。"]]},{"verse":18,"text":"人々,ひとびとはみな、羊飼,ひつじかいたちが話,はなしてくれたことを聞,きいて、不思議,ふしぎに思,おもった。","tok":[["人々","ひとびと"],["は"],["みな"],["、"],["羊飼","ひつじかい"],["たち"],["が"],["話","はなし"],["て"],["くれた"],["こと"],["を"],["聞いて","きいて"],["、"],["不思議","ふしぎ"],["に"],["思った","おもった"],["。"]]},{"verse":19,"text":"しかし、マリヤはこれらの事,ことをことごとく心,こころに留,とめて、思,おもいめぐらしていた。","tok":[["しかし"],["、"],["マリヤ"],["は"],["これ"],["ら"],["の"],["事","こと"],["を"],["ことごとく"],["心","こころ"],["に"],["留","とめ"],["て"],["、"],["思いめぐらして","おもいめぐらして"],["いた"],["。"]]},{"verse":20,"text":"羊飼,ひつじかいたちは、見聞,みききしたことが何,なにもかも自分,じぶんたちに語,かたられたとおりであったので、神,かみをあがめ、またさんびしながら帰,かえって行,いった。","tok":[["羊飼","ひつじかい"],["たち"],["は"],["、"],["見聞き","みきき"],["した"],["こと"],["が"],["何に","なに"],["も"],["か"],["も"],["自分","じぶん"],["たち"],["に"],["語られた","かたられた"],["とおり"],["で"],["あった"],["ので"],["、"],["神","かみ"],["を"],["あがめ"],["、"],["また"],["さん"],["び"],["し"],["ながら"],["帰えって","かえって"],["行った","いった"],["。"]]},{"verse":21,"text":"八日,かが過,すぎ、割礼,かつれいをほどこす時,ときとなったので、受胎,じゅたいのまえに御使,みつかいが告,つげたとおり、幼,おさな子,ごをイエスと名,なづけた。","tok":[["八日","か"],["が"],["過","すぎ"],["、"],["割礼","かつれい"],["を"],["ほどこす"],["時","とき"],["と"],["なった"],["ので"],["、"],["受胎","じゅたい"],["の"],["まえ"],["に"],["御使","み"],["つかい"],["が"],["告","つげ"],["た"],["とおり"],["、"],["幼な子","おさなご"],["を"],["イエス"],["と"],["名づけた","なづけた"],["。"]]},{"verse":22,"text":"それから、モーセの律法,りっぽうによる彼,かれらのきよめの期間,きかんが過,すぎたとき、両親,りょうしんは幼,おさな子,ごを連,つれてエルサレムへ上,のぼった。","tok":[["それ"],["から"],["、"],["モーセ"],["の"],["律法","りっぽう"],["に"],["よる"],["彼","かれ"],["ら"],["の"],["きよめ"],["の"],["期間","きかん"],["が"],["過た","すぎた"],["とき"],["、"],["両親","りょうしん"],["は"],["幼な子","おさなご"],["を"],["連れて","つれて"],["エルサレム"],["へ"],["上った","のぼった"],["。"]]},{"verse":23,"text":"それは主,しゅの律法,りっぽうに「母,ははの胎,たいを初,はじめて開,ひらく男,おとこの子,こはみな、主,しゅに聖,せい別,べつされた者,ものと、となえられねばならない」と書,かいてあるとおり、幼,おさな子,ごを主,しゅにささげるためであり、","tok":[["それ"],["は"],["主","しゅ"],["の"],["律法","りっぽう"],["に"],["「"],["母","はは"],["の"],["胎","たい"],["を"],["初めて","はじめて"],["開らく","ひらく"],["男の子","おとこのこ"],["は"],["みな"],["、"],["主に","しゅに"],["聖別","せいべつ"],["された"],["者","もの"],["と"],["、"],["となえられねば"],["ならない"],["」"],["と"],["書いて","かいて"],["ある"],["と"],["おり"],["、"],["幼な子","おさなご"],["を"],["主に","しゅに"],["ささげる"],["ため"],["で"],["あり"],["、"]]},{"verse":24,"text":"また同,おなじ主,しゅの律法,りっぽうに、「山,やまばと一つがい、または、家,いえばとのひな二羽,わ」と定,さだめてあるのに従,したがって、犠牲,ぎせいをささげるためであった。","tok":[["また"],["同じ","おなじ"],["主","しゅ"],["の"],["律法","りっぽう"],["に"],["、"],["「"],["山ばと","やまばと"],["一","ひと"],["つ"],["が"],["い"],["、"],["また"],["は"],["、"],["家ばと","いえばと"],["の"],["ひな"],["二羽","わ"],["」"],["と"],["定めて","さだめて"],["ある"],["のに"],["従って","したがって"],["、"],["犠牲","ぎせい"],["を"],["ささげる"],["ため"],["で"],["あった"],["。"]]},{"verse":25,"text":"その時,とき、エルサレムにシメオンという名,なの人,ひとがいた。この人,ひとは正,ただしい信仰,しんこう深,ふかい人,ひとで、イスラエルの慰,なぐさめられるのを待,まち望,のぞんでいた。また聖霊,せいれいが彼,かれに宿,やどっていた。","tok":[["その"],["時","とき"],["、"],["エルサレム"],["に"],["シメオン"],["と"],["いう"],["名","な"],["の"],["人","ひと"],["が"],["いた"],["。"],["この"],["人","ひと"],["は"],["正い","ただしい"],["信仰","しんこう"],["深","ふ"],["かい人","かいひと"],["で"],["、"],["イスラエル"],["の"],["慰さめられる","なぐさめられる"],["の"],["を"],["待ち望んで","まちのぞんで"],["いた"],["。"],["また"],["聖霊","せいれい"],["が"],["彼","かれ"],["に"],["宿って","やどって"],["いた"],["。"]]},{"verse":26,"text":"そして主,しゅのつかわす救主,すくいぬしに会,あうまでは死,しぬことはないと、聖霊,せいれいの示,しめしを受,うけていた。","tok":[["そして"],["主","しゅ"],["の"],["つかわす"],["救主","すくいぬし"],["に"],["会う","あう"],["まで"],["は"],["死ぬ","しぬ"],["こと"],["は"],["ない"],["と"],["、"],["聖霊","せいれい"],["の"],["示めし","しめし"],["を"],["受て","うけて"],["いた"],["。"]]},{"verse":27,"text":"この人,ひとが御霊,みたまに感,かんじて宮,みやにはいった。すると律法,りっぽうに定,さだめてあることを行,おこなうため、両親,りょうしんもその子,こイエスを連,つれてはいってきたので、","tok":[["この"],["人","ひと"],["が"],["御霊","みたま"],["に"],["感じて","かんじて"],["宮","みや"],["に"],["はいった"],["。"],["する"],["と"],["律法","りっぽう"],["に"],["定めて","さだめて"],["ある"],["こと"],["を"],["行なう","おこなう"],["ため"],["、"],["両親","りょうしん"],["も"],["その"],["子","こ"],["イエス"],["を"],["連れて","つれて"],["は"],["いって"],["きた"],["ので"],["、"]]},{"verse":28,"text":"シメオンは幼,おさな子,ごを腕,うでに抱,いだき、神,かみをほめたたえて言,いった、","tok":[["シメオン"],["は"],["幼な子","おさなご"],["を"],["腕","うで"],["に"],["抱き","いだき"],["、"],["神","かみ"],["を"],["ほめたたえて"],["言った","いった"],["、"]]},{"verse":29,"text":"「主,しゅよ、今,いまこそ、あなたはみ言葉,ことばのとおりにこの僕,しもべを安,やすらかに去,さらせてくださいます、","tok":[["「"],["主","しゅ"],["よ"],["、"],["今","いま"],["こそ"],["、"],["あなた"],["は"],["み言葉","みことば"],["の"],["とおり"],["に"],["この"],["僕","し"],["も"],["べ"],["を"],["安らか","やすらか"],["に"],["去らせて","さらせて"],["くださいます"],["、"]]},{"verse":30,"text":"わたしの目,めが今,いまあなたの救,すくいを見,みたのですから。","tok":[["わたし"],["の"],["目","め"],["が"],["今","いま"],["あなた"],["の"],["救い","すくい"],["を"],["見た","みた"],["の"],["です"],["から"],["。"]]},{"verse":31,"text":"この救,すくいはあなたが万民,ばんみんのまえにお備,そなえになったもので、","tok":[["この"],["救い","すくい"],["は"],["あなた"],["が"],["万民","ばんみん"],["の"],["まえ"],["に"],["お備え","おそなえ"],["に"],["なった"],["もの"],["で"],["、"]]},{"verse":32,"text":"異邦人,いほうじんを照,てらす啓示,けいじの光,ひかり、み民,たみイスラエルの栄光,えいこうであります」。","tok":[["異邦人","いほうじん"],["を"],["照らす","てらす"],["啓示","けいじ"],["の"],["光","ひかり"],["、"],["み民","みたみ"],["イスラエル"],["の"],["栄光","えいこう"],["で"],["あります"],["」"],["。"]]},{"verse":33,"text":"父,ちちと母,ははとは幼,おさな子,ごについてこのように語,かたられたことを、不思議,ふしぎに思,おもった。","tok":[["父","ちち"],["と"],["母","はは"],["と"],["は"],["幼な子","おさなご"],["について"],["この"],["よう"],["に"],["語られた","かたられた"],["こと"],["を"],["、"],["不思議","ふしぎ"],["に"],["思った","おもった"],["。"]]},{"verse":34,"text":"するとシメオンは彼,かれらを祝,しゅくし、そして母,ははマリヤに言,いった、「ごらんなさい、この幼,おさな子,ごは、イスラエルの多,おおくの人,ひとを倒,たおれさせたり立,たちあがらせたりするために、また反対,はんたいを受,うけるしるしとして、定,さだめられています。――","tok":[["する"],["と"],["シメオン"],["は"],["彼","かれ"],["ら"],["を"],["祝し","しゅくし"],["、"],["そして"],["母","はは"],["マリヤ"],["に"],["言った","いった"],["、"],["「"],["ごらん"],["なさい"],["、"],["この"],["幼な子","おさなご"],["は"],["、"],["イスラエル"],["の"],["多く","おおく"],["の"],["人","ひと"],["を"],["倒れさせ","たおれさせ"],["たり"],["立ちあがらせ","たちあがらせ"],["たり"],["する"],["ため"],["に"],["、"],["また"],["反対","はんたい"],["を"],["受る","うける"],["しるし"],["として"],["、"],["定められて","さだめられて"],["います"],["。"],["―"],["―"]]},{"verse":35,"text":"そして、あなた自身,じしんもつるぎで胸,むねを刺,さし貫,つらぬかれるでしょう。――それは多,おおくの人,ひとの心,こころにある思,おもいが、現,あらわれるようになるためです」。","tok":[["そして"],["、"],["あなた"],["自身","じしん"],["も"],["つるぎ"],["で"],["胸","むね"],["を"],["刺","さし"],["貫ぬかれるでしょう","つらぬかれるでしょう"],["。"],["―"],["―"],["それ"],["は"],["多く","おおく"],["の"],["人","ひと"],["の"],["心","こころ"],["に"],["ある"],["思い","おもい"],["が"],["、"],["現われる","あらわれる"],["よう"],["に"],["なる"],["ため"],["です"],["」"],["。"]]},{"verse":36,"text":"また、アセル族,ぞくのパヌエルの娘,むすめで、アンナという女,おんな預言者,よげんしゃがいた。彼女,かのじょは非常,ひじょうに年,としをとっていた。むすめ時代,じだいにとついで、七年間,ねんかんだけ夫,おっとと共,ともに住,すみ、","tok":[["また"],["、"],["アセル族","あせるぞく"],["の"],["パヌエル"],["の"],["娘","むすめ"],["で"],["、"],["アンナ"],["と"],["いう"],["女","おんな"],["預言者","よげんしゃ"],["が"],["いた"],["。"],["彼女","かのじょ"],["は"],["非常","ひじょう"],["に"],["年","とし"],["を"],["とって"],["いた"],["。"],["むすめ"],["時代","じだい"],["に"],["とついで"],["、"],["七","なな"],["年間","ねんかん"],["かん"],["だけ"],["夫","おっと"],["と"],["共","とも"],["に"],["住み","すみ"],["、"]]},{"verse":37,"text":"その後,のちやもめぐらしをし、八十四歳,さいになっていた。そして宮,みやを離,はなれずに夜,よるも昼,ひるも断食,だんじきと祈,いのりとをもって神,かみに仕,つかえていた。","tok":[["その後","そのの"],["ちや"],["も"],["めぐらし"],["を"],["し"],["、"],["八十四歳","さい"],["に"],["なって"],["いた"],["。"],["そして"],["宮","みや"],["を"],["離れず","はなれず"],["に"],["夜","よる"],["も"],["昼","ひる"],["も"],["断食","だんじき"],["と"],["祈","いのり"],["と"],["を"],["もって"],["神","かみ"],["に"],["仕えて","つかえて"],["いた"],["。"]]},{"verse":38,"text":"この老女,ろうじょも、ちょうどそのとき近寄,ちかよってきて、神,かみに感謝,かんしゃをささげ、そしてこの幼,おさな子,ごのことを、エルサレムの救,すくいを待,まち望,のぞんでいるすべての人々,ひとびとに語,かたりきかせた。","tok":[["この"],["老女","ろうじょ"],["も"],["、"],["ちょうど"],["その"],["とき"],["近寄って","ちかよって"],["きて"],["、"],["神","かみ"],["に"],["感謝","かんしゃ"],["を"],["ささげ"],["、"],["そして"],["この"],["幼な子","おさなご"],["の"],["こと"],["を"],["、"],["エルサレム"],["の"],["救い","すくい"],["を"],["待ち望んで","まちのぞんで"],["いる"],["すべて"],["の"],["人々","ひとびと"],["に"],["語りきかせた","かたりきかせた"],["。"]]},{"verse":39,"text":"両親,りょうしんは主,しゅの律法,りっぽうどおりすべての事,ことをすませたので、ガリラヤへむかい、自分,じぶんの町,まちナザレに帰,かえった。","tok":[["両親","りょうしん"],["は"],["主","しゅ"],["の"],["律法","りっぽう"],["どおり"],["すべて"],["の"],["事","こと"],["を"],["すませた"],["ので"],["、"],["ガリラヤ"],["へ"],["むかい"],["、"],["自分","じぶん"],["の"],["町","まち"],["ナザレ"],["に"],["帰えった","かえった"],["。"]]},{"verse":40,"text":"幼,おさな子,ごは、ますます成長,せいちょうして強,つよくなり、知恵,ちえに満,みち、そして神,かみの恵,めぐみがその上,うえにあった。","tok":[["幼な子","おさなご"],["は"],["、"],["ますます"],["成長","せいちょう"],["して"],["強く","つよく"],["なり"],["、"],["知恵","ちえ"],["に"],["満ち","みち"],["、"],["そして"],["神","かみ"],["の"],["恵","めぐみ"],["が"],["その"],["上","うえ"],["に"],["あった"],["。"]]},{"verse":41,"text":"さて、イエスの両親,りょうしんは、過越,すぎこしの祭,まつりには毎年,まいとしエルサレムへ上,のぼっていた。","tok":[["さて"],["、"],["イエス"],["の"],["両親","りょうしん"],["は"],["、"],["過越","すぎこし"],["の"],["祭","まつり"],["に"],["は"],["毎年","まいとし"],["エルサレム"],["へ"],["上って","のぼって"],["いた"],["。"]]},{"verse":42,"text":"イエスが十二歳,さいになった時,ときも、慣例,かんれいに従,したがって祭,まつりのために上京,じょうきょうした。","tok":[["イエス"],["が"],["十二歳","さい"],["に"],["なった"],["時","とき"],["も"],["、"],["慣例","かんれい"],["に"],["従って","したがって"],["祭","まつり"],["の"],["ため"],["に"],["上京","じょうきょう"],["した"],["。"]]},{"verse":43,"text":"ところが、祭,まつりが終,おわって帰,かえるとき、少年,しょうねんイエスはエルサレムに居残,いのこっておられたが、両親,りょうしんはそれに気,きづかなかった。","tok":[["ところ"],["が"],["、"],["祭","まつり"],["が"],["終わって","おわって"],["帰える","かえる"],["とき"],["、"],["少年","しょうねん"],["イエス"],["は"],["エルサレム"],["に"],["居残って","いのこって"],["おられた"],["が"],["、"],["両親","りょうしん"],["は"],["それ"],["に"],["気づかなかった","きづかなかった"],["。"]]},{"verse":44,"text":"そして道連,みちづれの中,なかにいることと思,おもいこんで、一日,にち路,じを行,いってしまい、それから、親族,しんぞくや知人,ちじんの中,なかを捜,さがしはじめたが、","tok":[["そして"],["道連れ","みちづれ"],["の"],["中","なか"],["に"],["いる"],["こと"],["と"],["思いこんで","おもいこんで"],["、"],["一","いち"],["日","にち"],["ち路","ちじ"],["を"],["行って","いって"],["しまい"],["、"],["それ"],["から"],["、"],["親族","しんぞく"],["や"],["知人","ちじん"],["の"],["中","なか"],["を"],["捜し","さがし"],["はじめた"],["が"],["、"]]},{"verse":45,"text":"見,みつからないので、捜,さがしまわりながらエルサレムへ引返,ひきかえした。","tok":[["見つからない","みつからない"],["ので"],["、"],["捜しまわり","さがしまわり"],["ながら"],["エルサレム"],["へ"],["引","ひき"],["返","かえし"],["た"],["。"]]},{"verse":46,"text":"そして三日,かの後,のちに、イエスが宮,みやの中,なかで教師,きょうしたちのまん中,なかにすわって、彼,かれらの話,はなしを聞,きいたり質問,しつもんしたりしておられるのを見,みつけた。","tok":[["そして"],["三日","か"],["の"],["後","のち"],["に"],["、"],["イエス"],["が"],["宮","みや"],["の"],["中","なか"],["で"],["教師","きょうし"],["たち"],["の"],["まん中","まんなか"],["に"],["すわって"],["、"],["彼","かれ"],["ら"],["の"],["話","はなし"],["を"],["聞い","きい"],["たり"],["質問","しつもん"],["し"],["たり"],["して"],["おられる"],["の"],["を"],["見つけた","みつけた"],["。"]]},{"verse":47,"text":"聞,きく人々,ひとびとはみな、イエスの賢,かしこさやその答,こたえに驚嘆,きょうたんしていた。","tok":[["聞く","きく"],["人々","ひとびと"],["は"],["みな"],["、"],["イエス"],["の"],["賢こ","かしこ"],["さ"],["や"],["その"],["答","こたえ"],["に"],["驚嘆","きょうたん"],["して"],["いた"],["。"]]},{"verse":48,"text":"両親,りょうしんはこれを見,みて驚,おどろき、そして母,ははが彼,かれに言,いった、「どうしてこんな事,ことをしてくれたのです。ごらんなさい、おとう様,さまもわたしも心配,しんぱいして、あなたを捜,さがしていたのです」。","tok":[["両親","りょうしん"],["は"],["これ"],["を"],["見て","みて"],["驚","おどろき"],["、"],["そして"],["母","はは"],["が"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["どう"],["して"],["こんな"],["事","こと"],["を"],["して"],["くれた"],["の"],["です"],["。"],["ごらん"],["なさい"],["、"],["おとう様","おとうさま"],["も"],["わたし"],["も"],["心配","しんぱい"],["して"],["、"],["あなた"],["を"],["捜して","さがして"],["いた"],["の"],["です"],["」"],["。"]]},{"verse":49,"text":"するとイエスは言,いわれた、「どうしてお捜,さがしになったのですか。わたしが自分,じぶんの父,ちちの家,いえにいるはずのことを、ご存,ぞんじなかったのですか」。","tok":[["する"],["と"],["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["どう"],["して"],["お捜し","おさがし"],["に"],["なった"],["の"],["です"],["か"],["。"],["わたし"],["が"],["自分","じぶん"],["の"],["父","ちち"],["の"],["家","いえ"],["に"],["いる"],["はず"],["の"],["こと"],["を"],["、"],["ご存じ","ごぞんじ"],["なかった"],["の"],["です"],["か"],["」"],["。"]]},{"verse":50,"text":"しかし、両親,りょうしんはその語,かたられた言葉,ことばを悟,さとることができなかった。","tok":[["しかし"],["、"],["両親","りょうしん"],["は"],["その"],["語られた","かたられた"],["言葉","ことば"],["を"],["悟","さとる"],["こと"],["が"],["できなかった"],["。"]]},{"verse":51,"text":"それからイエスは両親,りょうしんと一緒,いっしょにナザレに下,くだって行,いき、彼,かれらにお仕,つかえになった。母,はははこれらの事,ことをみな心,こころに留,とめていた。","tok":[["それ"],["から"],["イエス"],["は"],["両親","りょうしん"],["と"],["一緒","いっしょ"],["に"],["ナザレ"],["に"],["下って","くだって"],["行き","いき"],["、"],["彼","かれ"],["ら"],["に"],["お仕え","おつかえ"],["に"],["なった"],["。"],["母","はは"],["は"],["これ"],["ら"],["の"],["事","こと"],["を"],["みな"],["心","こころ"],["に"],["留","とめ"],["て"],["いた"],["。"]]},{"verse":52,"text":"イエスはますます知恵,ちえが加,くわわり、背,せたけも伸,のび、そして神,かみと人,ひとから愛,あいされた。","tok":[["イエス"],["は"],["ますます"],["知恵","ちえ"],["が"],["加わわり","くわわり"],["、"],["背たけ","せたけ"],["も"],["伸び","のび"],["、"],["そして"],["神","かみ"],["と"],["人","ひと"],["から"],["愛された","あいされた"],["。"]]}]
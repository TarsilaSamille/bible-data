[{"verse":1,"text":"また、イエスはある所,ところで祈,いのっておられたが、それが終,おわったとき、弟子,でしのひとりが言,いった、「主,しゅよ、ヨハネがその弟子,でしたちに教,おしえたように、わたしたちにも祈,いのることを教,おしえてください」。","tok":[["また"],["、"],["イエス"],["は"],["ある"],["所","ところ"],["で"],["祈って","いのって"],["おられた"],["が"],["、"],["それ"],["が"],["終わった","おわった"],["とき"],["、"],["弟子","でし"],["の"],["ひとり"],["が"],["言った","いった"],["、"],["「"],["主","しゅ"],["よ"],["、"],["ヨハネ"],["が"],["その"],["弟子","でし"],["たち"],["に"],["教えた","おしえた"],["よう"],["に"],["、"],["わたしたち"],["に"],["も"],["祈る","いのる"],["こと"],["を"],["教えて","おしえて"],["ください"],["」"],["。"]]},{"verse":2,"text":"そこで彼,かれらに言,いわれた、「祈,いのるときには、こう言,いいなさい、『父,ちちよ、御名,みながあがめられますように。御国,みくにがきますように。","tok":[["そこ"],["で"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["祈る","いのる"],["とき"],["に"],["は"],["、"],["こう"],["言い","いい"],["なさい"],["、"],["『"],["父","ちち"],["よ"],["、"],["御名","みな"],["が"],["あがめられます"],["よう"],["に"],["。"],["御国","みくに"],["が"],["きます"],["よう"],["に"],["。"]]},{"verse":3,"text":"わたしたちの日,ひごとの食物,しょくもつを、日々,ひびお与,あたえください。","tok":[["わたしたち"],["の"],["日ごと","ひごと"],["の"],["食物","しょくもつ"],["を"],["、"],["日々","ひび"],["お与え","おあたえ"],["ください"],["。"]]},{"verse":4,"text":"わたしたちに負債,ふさいのある者,ものを皆,みなゆるしますから、わたしたちの罪,つみをもおゆるしください。わたしたちを試,こころみに会,あわせないでください』」。","tok":[["わたしたち"],["に"],["負債","ふさい"],["の"],["ある"],["者","もの"],["を"],["皆","みな"],["ゆるします"],["から"],["、"],["わたしたち"],["の"],["罪","つみ"],["を"],["も"],["おゆるし"],["ください"],["。"],["わたしたち"],["を"],["試み","こころみ"],["に"],["会わせないで","あわせないで"],["ください"],["』"],["」"],["。"]]},{"verse":5,"text":"そして彼,かれらに言,いわれた、「あなたがたのうちのだれかに、友人,ゆうじんがあるとして、その人,ひとのところへ真夜中,まよなかに行,いき、『友,ともよ、パンを三つ貸,かしてください。","tok":[["そして"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["がた"],["の"],["うち"],["の"],["だれ"],["か"],["に"],["、"],["友人","ゆうじん"],["が"],["ある"],["として"],["、"],["その"],["人","ひと"],["の"],["ところ"],["へ"],["真夜中","まよなか"],["に"],["行き","いき"],["、"],["『"],["友","とも"],["よ"],["、"],["パン"],["を"],["三","みっ"],["つ"],["貸","かし"],["て"],["ください"],["。"]]},{"verse":6,"text":"友,ともだちが旅先,たびさきからわたしのところに着,ついたのですが、何,なにも出,だすものがありませんから』と言,いった場合,ばあい、","tok":[["友だち","ともだち"],["が"],["旅先","たびさき"],["から"],["わたし"],["の"],["ところ"],["に"],["着いた","ついた"],["の"],["です"],["が"],["、"],["何に","なに"],["も"],["出す","だす"],["もの"],["が"],["ありません"],["から"],["』"],["と"],["言った","いった"],["場合","ばあい"],["、"]]},{"verse":7,"text":"彼,かれは内,うちから、『面倒,めんどうをかけないでくれ。もう戸,とは締,しめてしまったし、子供,こどもたちもわたしと一緒,いっしょに床,とこにはいっているので、いま起,おきて何,なにもあげるわけにはいかない』と言,いうであろう。","tok":[["彼","かれ"],["は"],["内","うち"],["から"],["、"],["『"],["面倒","めんどう"],["を"],["かけないで"],["くれ"],["。"],["もう"],["戸","と"],["は"],["締","しめ"],["て"],["しまった"],["し"],["、"],["子供","こども"],["たち"],["も"],["わたし"],["と"],["一緒","いっしょ"],["に"],["床","とこ"],["に"],["はいって"],["いる"],["ので"],["、"],["いま"],["起きて","おきて"],["何に","なに"],["も"],["あげる"],["わけ"],["に"],["は"],["いかない"],["』"],["と"],["言うで","いうで"],["あろう"],["。"]]},{"verse":8,"text":"しかし、よく聞,ききなさい、友人,ゆうじんだからというのでは起,おきて与,あたえないが、しきりに願,ねがうので、起,おき上,あがって必要,ひつようなものを出,だしてくれるであろう。","tok":[["しかし"],["、"],["よく"],["聞","きき"],["なさい"],["、"],["友人","ゆうじん"],["だ"],["から"],["と"],["いう"],["ので"],["は"],["起きて","おきて"],["与えない","あたえない"],["が"],["、"],["しきり"],["に"],["願う","ねがう"],["ので"],["、"],["起き上がって","おきあがって"],["必要","ひつよう"],["な"],["もの"],["を"],["出して","だして"],["くれるで"],["あろう"],["。"]]},{"verse":9,"text":"そこでわたしはあなたがたに言,いう。求,もとめよ、そうすれば、与,あたえられるであろう。捜,さがせ、そうすれば見,みいだすであろう。門,もんをたたけ、そうすれば、あけてもらえるであろう。","tok":[["そこ"],["で"],["わたし"],["は"],["あなた"],["がた"],["に"],["言う","いう"],["。"],["求めよ","もとめよ"],["、"],["そう"],["すれば"],["、"],["与えられるで","あたえられるで"],["あろう"],["。"],["捜","さがせ"],["、"],["そう"],["すれば"],["見いだすで","みいだすで"],["あろう"],["。"],["門","もん"],["を"],["たたけ"],["、"],["そう"],["すれば"],["、"],["あけて"],["もらえるで"],["あろう"],["。"]]},{"verse":10,"text":"すべて求,もとめる者,ものは得,え、捜,さがす者,ものは見,みいだし、門,もんをたたく者,ものはあけてもらえるからである。","tok":[["すべて"],["求める","もとめる"],["者","もの"],["は"],["得","え"],["、"],["捜す","さがす"],["者","もの"],["は"],["見いだし","みいだし"],["、"],["門","もん"],["を"],["たたく"],["者","もの"],["は"],["あけて"],["もらえる"],["から"],["で"],["ある"],["。"]]},{"verse":11,"text":"あなたがたのうちで、父,ちちであるものは、その子,こが魚,うおを求,もとめるのに、魚,うおの代,かわりにへびを与,あたえるだろうか。","tok":[["あなた"],["がた"],["の"],["うち"],["で"],["、"],["父","ちち"],["で"],["ある"],["もの"],["は"],["、"],["その"],["子","こ"],["が"],["魚","うお"],["を"],["求める","もとめる"],["のに"],["、"],["魚","うお"],["の"],["代わり","かわり"],["に"],["へび"],["を"],["与えるだろう","あたえるだろう"],["か"],["。"]]},{"verse":12,"text":"卵,たまごを求,もとめるのに、さそりを与,あたえるだろうか。","tok":[["卵","たまご"],["を"],["求める","もとめる"],["のに"],["、"],["さそり"],["を"],["与えるだろう","あたえるだろう"],["か"],["。"]]},{"verse":13,"text":"このように、あなたがたは悪,わるい者,ものであっても、自分,じぶんの子供,こどもには、良,よい贈,おくり物,ものをすることを知,しっているとすれば、天,てんの父,ちちはなおさら、求,もとめて来,くる者,ものに聖霊,せいれいを下,くださらないことがあろうか」。","tok":[["この"],["よう"],["に"],["、"],["あなた"],["がた"],["は"],["悪い","わるい"],["者","もの"],["で"],["あって"],["も"],["、"],["自分","じぶん"],["の"],["子供","こども"],["に"],["は"],["、"],["良い","よい"],["贈り物","おくりもの"],["を"],["する"],["こと"],["を"],["知って","しって"],["いる"],["と"],["すれば"],["、"],["天","てん"],["の"],["父","ちち"],["は"],["なおさら"],["、"],["求めて","もとめて"],["来る","くる"],["者","もの"],["に"],["聖霊","せいれい"],["を"],["下さらない","くださらない"],["こと"],["が"],["あろう"],["か"],["」"],["。"]]},{"verse":14,"text":"さて、イエスが悪霊,あくれいを追,おい出,だしておられた。それは、おしの霊,れいであった。悪霊,あくれいが出,でて行,いくと、おしが物,ものを言,いうようになったので、群衆,ぐんしゅうは不思議,ふしぎに思,おもった。","tok":[["さて"],["、"],["イエス"],["が"],["悪霊","あくれい"],["を"],["追い出して","おいだして"],["おられた"],["。"],["それ"],["は"],["、"],["おし"],["の"],["霊","れい"],["で"],["あった"],["。"],["悪霊","あ"],["く"],["れい"],["が"],["出て","でて"],["行く","いく"],["と"],["、"],["おし"],["が"],["物","もの"],["を"],["言う","いう"],["よう"],["に"],["なった"],["ので"],["、"],["群衆","ぐんしゅう"],["は"],["不思議","ふしぎ"],["に"],["思った","おもった"],["。"]]},{"verse":15,"text":"その中,なかのある人々,ひとびとが、「彼,かれは悪霊,あくれいのかしらベルゼブルによって、悪霊,あくれいどもを追,おい出,だしているのだ」と言,いい、","tok":[["その"],["中","なか"],["の"],["ある"],["人々","ひとびと"],["が"],["、"],["「"],["彼","かれ"],["は"],["悪霊","あくれい"],["の"],["かしら"],["ベルゼブル"],["によって"],["、"],["悪霊","あくれいども"],["を"],["追い出して","おいだして"],["いる"],["の"],["だ"],["」"],["と"],["言い","いい"],["、"]]},{"verse":16,"text":"またほかの人々,ひとびとは、イエスを試,こころみようとして、天,てんからのしるしを求,もとめた。","tok":[["また"],["ほか"],["の"],["人々","ひとびと"],["は"],["、"],["イエス"],["を"],["試みよう","こころみよう"],["として"],["、"],["天","てん"],["から"],["の"],["しるし"],["を"],["求めた","もとめた"],["。"]]},{"verse":17,"text":"しかしイエスは、彼,かれらの思,おもいを見抜,みぬいて言,いわれた、「おおよそ国,くにが内部,ないぶで分裂,ぶんれつすれば自滅,じめつしてしまい、また家,いえが分,わかれ争,あらそえば倒,たおれてしまう。","tok":[["しかし"],["イエス"],["は"],["、"],["彼","かれ"],["ら"],["の"],["思い","おもい"],["を"],["見抜いて","みぬいて"],["言われた","いわれた"],["、"],["「"],["おおよそ"],["国","くに"],["が"],["内部","ないぶ"],["で"],["分裂","ぶんれつ"],["すれば"],["自滅","じめつ"],["して"],["しまい"],["、"],["また"],["家","いえ"],["が"],["分かれ","わかれ"],["争えば","あらそえば"],["倒れて","たおれて"],["しまう"],["。"]]},{"verse":18,"text":"そこでサタンも内部,ないぶで分裂,ぶんれつすれば、その国,くにはどうして立,たち行,いけよう。あなたがたはわたしがベルゼブルによって悪霊,あくれいを追,おい出,だしていると言,いうが、","tok":[["そこ"],["で"],["サタン"],["も"],["内部","ないぶ"],["で"],["分裂","ぶんれつ"],["すれば"],["、"],["その"],["国","くに"],["は"],["どう"],["して"],["立ち","たち"],["行けよう","いけよう"],["。"],["あなた"],["がた"],["は"],["わたし"],["が"],["ベルゼブル"],["によって"],["悪霊","あくれい"],["を"],["追い出して","おいだして"],["いる"],["と"],["言う","いう"],["が"],["、"]]},{"verse":19,"text":"もしわたしがベルゼブルによって悪霊,あくれいを追,おい出,だすとすれば、あなたがたの仲間,なかまはだれによって追,おい出,だすのであろうか。だから、彼,かれらがあなたがたをさばく者,ものとなるであろう。","tok":[["もし"],["わたし"],["が"],["ベルゼブル"],["によって"],["悪霊","あくれい"],["を"],["追い出す","おいだす"],["と"],["すれば"],["、"],["あなた"],["がた"],["の"],["仲間","なかま"],["は"],["だれ"],["によって"],["追い出す","おいだす"],["ので"],["あろう"],["か"],["。"],["だ"],["から"],["、"],["彼","かれ"],["ら"],["が"],["あなた"],["がた"],["を"],["さばく"],["者","もの"],["と"],["なるで"],["あろう"],["。"]]},{"verse":20,"text":"しかし、わたしが神,かみの指,ゆびによって悪霊,あくれいを追,おい出,だしているのなら、神,かみの国,くにはすでにあなたがたのところにきたのである。","tok":[["しかし"],["、"],["わたし"],["が"],["神","かみ"],["の"],["指","ゆび"],["によって"],["悪霊","あくれい"],["を"],["追い出して","おいだして"],["いる"],["の"],["なら"],["、"],["神","かみ"],["の"],["国","くに"],["は"],["すでに"],["あなた"],["がた"],["の"],["ところ"],["に"],["きた"],["ので"],["ある"],["。"]]},{"verse":21,"text":"強,つよい人,ひとが十分,じゅうぶんに武装,ぶそうして自分,じぶんの邸宅,ていたくを守,まもっている限,かぎり、その持,もち物,ものは安全,あんぜんである。","tok":[["強い","つよい"],["人","ひと"],["が"],["十分","じゅうぶん"],["に"],["武装","ぶそう"],["して"],["自分","じぶん"],["の"],["邸宅","ていたく"],["を"],["守って","まもって"],["いる"],["限","かぎり"],["、"],["その"],["持物","もちもの"],["は"],["安全","あんぜん"],["で"],["ある"],["。"]]},{"verse":22,"text":"しかし、もっと強,つよい者,ものが襲,おそってきて彼,かれに打,うち勝,かてば、その頼,たのみにしていた武具,ぶぐを奪,うばって、その分捕,ぶんどり品,ひんを分,わけるのである。","tok":[["しかし"],["、"],["もっと"],["強い","つよい"],["者","もの"],["が"],["襲って","おそって"],["きて"],["彼","かれ"],["に"],["打ち勝てば","うちかてば"],["、"],["その"],["頼み","たのみ"],["に"],["して"],["いた"],["武具","ぶぐ"],["を"],["奪って","うばって"],["、"],["その"],["分捕り品","ぶんどりひん"],["を"],["分ける","わける"],["ので"],["ある"],["。"]]},{"verse":23,"text":"わたしの味方,みかたでない者,ものは、わたしに反対,はんたいするものであり、わたしと共,ともに集,あつめない者,ものは、散,ちらすものである。","tok":[["わたし"],["の"],["味方","みかた"],["で"],["ない"],["者","もの"],["は"],["、"],["わたし"],["に"],["反対","はんたい"],["する"],["もの"],["で"],["あり"],["、"],["わたし"],["と"],["共","とも"],["に"],["集めない","あつめない"],["者","もの"],["は"],["、"],["散らす","ちらす"],["もの"],["で"],["ある"],["。"]]},{"verse":24,"text":"汚,けがれた霊,れいが人,ひとから出,でると、休,やすみ場,ばを求,もとめて水,みずの無,ない所,ところを歩,あるきまわるが、見,みつからないので、出,でてきた元,もとの家,いえに帰,かえろうと言,いって、","tok":[["汚","け"],["がれ"],["た"],["霊","れい"],["が"],["人","ひと"],["から"],["出る","でる"],["と"],["、"],["休み場","やすみば"],["を"],["求めて","もとめて"],["水","みず"],["の"],["無い","ない"],["所","ところ"],["を"],["歩き","あるき"],["まわる"],["が"],["、"],["見つからない","みつからない"],["ので"],["、"],["出て","でて"],["きた"],["元","もと"],["の"],["家","いえ"],["に"],["帰えろう","かえろう"],["と"],["言って","いって"],["、"]]},{"verse":25,"text":"帰,かえって見,みると、その家,いえはそうじがしてある上,うえ、飾,かざりつけがしてあった。","tok":[["帰えって","かえって"],["見る","みる"],["と"],["、"],["その"],["家","いえ"],["は"],["そうじ"],["が"],["して"],["ある"],["上","うえ"],["、"],["飾","かざり"],["つけ"],["が"],["して"],["あった"],["。"]]},{"verse":26,"text":"そこでまた出,でて行,いって、自分,じぶん以上,いじょうに悪,わるい他,たの七つの霊,れいを引,ひき連,つれてきて中,なかにはいり、そこに住,すみ込,こむ。そうすると、その人,ひとの後,のちの状態,じょうたいは初,はじめよりももっと悪,わるくなるのである」。","tok":[["そこ"],["で"],["また"],["出て","でて"],["行って","いって"],["、"],["自分","じぶん"],["以上","いじょう"],["に"],["悪い","わるい"],["他","た"],["の"],["七","なな"],["つ"],["の"],["霊","れい"],["を"],["引連れて","ひきつれて"],["きて"],["中","なか"],["に"],["はいり"],["、"],["そこ"],["に"],["住み込む","すみこむ"],["。"],["そう"],["する"],["と"],["、"],["その"],["人","ひと"],["の"],["後","のち"],["の"],["状態","じょうたい"],["は"],["初め","はじめ"],["より"],["も"],["もっと"],["悪く","わるく"],["なる"],["ので"],["ある"],["」"],["。"]]},{"verse":27,"text":"イエスがこう話,はなしておられるとき、群衆,ぐんしゅうの中,なかからひとりの女,おんなが声,こえを張,はりあげて言,いった、「あなたを宿,やどした胎,たい、あなたが吸,すわれた乳房,ちぶさは、なんとめぐまれていることでしょう」。","tok":[["イエス"],["が"],["こう"],["話","はなし"],["て"],["おられる"],["とき"],["、"],["群衆","ぐんしゅう"],["の"],["中","なか"],["から"],["ひとり"],["の"],["女","おんな"],["が"],["声","こえ"],["を"],["張りあげて","はりあげて"],["言った","いった"],["、"],["「"],["あなた"],["を"],["宿した","やどした"],["胎","た"],["い"],["、"],["あなた"],["が"],["吸われた","すわれた"],["乳房","ちぶさ"],["は"],["、"],["なん"],["と"],["めぐまれて"],["いる"],["こと"],["でしょう"],["」"],["。"]]},{"verse":28,"text":"しかしイエスは言,いわれた、「いや、めぐまれているのは、むしろ、神,かみの言,ことばを聞,きいてそれを守,まもる人,ひとたちである」。","tok":[["しかし"],["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["いや"],["、"],["めぐまれて"],["いる"],["の"],["は"],["、"],["むしろ"],["、"],["神","かみ"],["の"],["言","ことば"],["を"],["聞いて","きいて"],["それ"],["を"],["守人","まもるひと"],["たち"],["で"],["ある"],["」"],["。"]]},{"verse":29,"text":"さて群衆,ぐんしゅうが群,むらがり集,あつまったので、イエスは語,かたり出,だされた、「この時代,じだいは邪悪,じゃあくな時代,じだいである。それはしるしを求,もとめるが、ヨナのしるしのほかには、なんのしるしも与,あたえられないであろう。","tok":[["さて"],["群衆","ぐんしゅう"],["が"],["群らがり","むらがり"],["集まった","あつまった"],["ので"],["、"],["イエス"],["は"],["語り","かたり"],["出された","だされた"],["、"],["「"],["この"],["時代","じだい"],["は"],["邪悪","じゃあく"],["な"],["時代","じだい"],["で"],["ある"],["。"],["それ"],["は"],["しるし"],["を"],["求める","もとめる"],["が"],["、"],["ヨナ"],["の"],["しるし"],["の"],["ほか"],["に"],["は"],["、"],["なん"],["の"],["しるし"],["も"],["与えられないで","あたえられないで"],["あろう"],["。"]]},{"verse":30,"text":"というのは、ニネベの人々,ひとびとに対,たいしてヨナがしるしとなったように、人,ひとの子,こもこの時代,じだいに対,たいしてしるしとなるであろう。","tok":[["と"],["いう"],["の"],["は"],["、"],["ニネベ"],["の"],["人々","ひとびと"],["に対して","にたいして"],["ヨナ"],["が"],["しるし"],["と"],["なった"],["よう"],["に"],["、"],["人","ひと"],["の"],["子","こ"],["も"],["この"],["時代","じだい"],["に対して","にたいして"],["しるし"],["と"],["なるで"],["あろう"],["。"]]},{"verse":31,"text":"南,みなみの女王,じょおうが、今,いまの時代,じだいの人々,ひとびとと共,ともにさばきの場,ばに立,たって、彼,かれらを罪,つみに定,さだめるであろう。なぜなら、彼女,かのじょはソロモンの知恵,ちえを聞,きくために、地,ちの果,はてからはるばるきたからである。しかし見,みよ、ソロモンにまさる者,ものがここにいる。","tok":[["南","みなみ"],["の"],["女王","じょおう"],["が"],["、"],["今","いま"],["の"],["時代","じだい"],["の"],["人々","ひとびと"],["と"],["共","とも"],["に"],["さばき"],["の"],["場","ば"],["に"],["立って","たって"],["、"],["彼","かれ"],["ら"],["を"],["罪","つみ"],["に"],["定めるで","さだめるで"],["あろう"],["。"],["なぜ"],["なら"],["、"],["彼女","かのじょ"],["は"],["ソロモン"],["の"],["知恵","ちえ"],["を"],["聞く","きく"],["ため"],["に"],["、"],["地","ち"],["の"],["果て","はて"],["から"],["はるばる"],["きた"],["から"],["で"],["ある"],["。"],["しかし"],["見よ","みよ"],["、"],["ソロモン"],["に"],["まさる"],["者","もの"],["が"],["ここ"],["に"],["いる"],["。"]]},{"verse":32,"text":"ニネベの人々,ひとびとが、今,いまの時代,じだいの人々,ひとびとと共,ともにさばきの場,ばに立,たって、彼,かれらを罪,つみに定,さだめるであろう。なぜなら、ニネベの人々,ひとびとはヨナの宣教,せんきょうによって悔,くい改,あらためたからである。しかし見,みよ、ヨナにまさる者,ものがここにいる。","tok":[["ニネベ"],["の"],["人々","ひとびと"],["が"],["、"],["今","いま"],["の"],["時代","じだい"],["の"],["人々","ひとびと"],["と"],["共","とも"],["に"],["さばき"],["の"],["場","ば"],["に"],["立って","たって"],["、"],["彼","かれ"],["ら"],["を"],["罪","つみ"],["に"],["定めるで","さだめるで"],["あろう"],["。"],["なぜ"],["なら"],["、"],["ニネベ"],["の"],["人々","ひとびと"],["は"],["ヨナ"],["の"],["宣教","せんきょう"],["によって"],["悔い改めた","くいあらためた"],["から"],["で"],["ある"],["。"],["しかし"],["見よ","みよ"],["、"],["ヨナ"],["に"],["まさる"],["者","もの"],["が"],["ここ"],["に"],["いる"],["。"]]},{"verse":33,"text":"だれもあかりをともして、それを穴倉,あなぐらの中,なかや枡,ますの下,したに置,おくことはしない。むしろはいって来,くる人,ひとたちに、そのあかりが見,みえるように、燭台,しょくだいの上,うえにおく。","tok":[["だれ"],["も"],["あかり"],["を"],["ともして"],["、"],["それ"],["を"],["穴倉","あなぐら"],["の"],["中","なか"],["や"],["枡","ます"],["の"],["下","した"],["に"],["置く","おく"],["こと"],["は"],["しない"],["。"],["むしろ"],["はいって"],["来る","くる"],["人","ひと"],["たち"],["に"],["、"],["その"],["あかり"],["が"],["見える","みえる"],["よう"],["に"],["、"],["燭台","しょくだい"],["の"],["上","うえ"],["に"],["おく"],["。"]]},{"verse":34,"text":"あなたの目,めは、からだのあかりである。あなたの目,めが澄,すんでおれば、全身,ぜんしんも明,あかるいが、目,めがわるければ、からだも暗,くらい。","tok":[["あなた"],["の"],["目","め"],["は"],["、"],["からだ"],["の"],["あかり"],["で"],["ある"],["。"],["あなた"],["の"],["目","め"],["が"],["澄んで","すんで"],["おれば"],["、"],["全身","ぜんしん"],["も"],["明かるい","あかるい"],["が"],["、"],["目","め"],["が"],["わるければ"],["、"],["からだ"],["も"],["暗い","くらい"],["。"]]},{"verse":35,"text":"だから、あなたの内,うちなる光,ひかりが暗,くらくならないように注意,ちゅういしなさい。","tok":[["だ"],["から"],["、"],["あなた"],["の"],["内","うち"],["なる"],["光","ひかり"],["が"],["暗く","くらく"],["ならない"],["よう"],["に"],["注意","ちゅうい"],["し"],["なさい"],["。"]]},{"verse":36,"text":"もし、あなたのからだ全体,ぜんたいが明,あかるくて、暗,くらい部分,ぶぶんが少,すこしもなければ、ちょうど、あかりが輝,かがやいてあなたを照,てらす時,ときのように、全身,ぜんしんが明,あかるくなるであろう」。","tok":[["もし"],["、"],["あなた"],["の"],["からだ"],["全体","ぜんたい"],["が"],["明かるくて","あかるくて"],["、"],["暗い","くらい"],["部分","ぶぶん"],["が"],["少し","すこし"],["も"],["なければ"],["、"],["ちょうど"],["、"],["あかり"],["が"],["輝やいて","かがやいて"],["あなた"],["を"],["照らす","てらす"],["時","とき"],["の"],["よう"],["に"],["、"],["全身","ぜんしん"],["が"],["明かるく","あかるく"],["なるで"],["あろう"],["」"],["。"]]},{"verse":37,"text":"イエスが語,かたっておられた時,とき、あるパリサイ人,びとが、自分,じぶんの家,いえで食事,しょくじをしていただきたいと申,もうし出,でたので、はいって食卓,しょくたくにつかれた。","tok":[["イエス"],["が"],["語って","かたって"],["おられた"],["時","とき"],["、"],["ある"],["パリサイ"],["人","び"],["と"],["が"],["、"],["自分","じぶん"],["の"],["家","いえ"],["で"],["食事","しょくじ"],["を"],["して"],["いただきたい"],["と"],["申し出た","もうしでた"],["ので"],["、"],["はい"],["って"],["食卓","しょくたく"],["に"],["つかれた"],["。"]]},{"verse":38,"text":"ところが、食前,しょくぜんにまず洗,あらうことをなさらなかったのを見,みて、そのパリサイ人,びとが不思議,ふしぎに思,おもった。","tok":[["ところ"],["が"],["、"],["食前","しょくぜん"],["に"],["まず"],["洗う","あらう"],["こと"],["を"],["なさらなかった"],["の"],["を"],["見て","みて"],["、"],["その"],["パリサイ"],["人","び"],["と"],["が"],["不思議","ふしぎ"],["に"],["思った","おもった"],["。"]]},{"verse":39,"text":"そこで主,しゅは彼,かれに言,いわれた、「いったい、あなたがたパリサイ人,びとは、杯,さかずきや盆,ぼんの外側,そとがわをきよめるが、あなたがたの内側,うちがわは貪欲,どんよくと邪悪,じゃあくとで満,みちている。","tok":[["そこ"],["で"],["主","しゅ"],["は"],["彼","かれ"],["に"],["言われた","いわれた"],["、"],["「"],["いったい"],["、"],["あなた"],["がた"],["パリサイ"],["人","びと"],["は"],["、"],["杯","さかずき"],["や"],["盆","ぼん"],["の"],["外側","そとがわ"],["を"],["きよめる"],["が"],["、"],["あなた"],["がた"],["の"],["内側","うちがわ"],["は"],["貪欲","どんよく"],["と"],["邪悪","じゃあく"],["と"],["で"],["満ちて","みちて"],["いる"],["。"]]},{"verse":40,"text":"愚,おろかな者,ものたちよ、外側,そとがわを造,つくったかたは、また内側,うちがわも造,つくられたではないか。","tok":[["愚か","おろか"],["な"],["者","もの"],["たち"],["よ"],["、"],["外側","そとがわ"],["を"],["造った","つくった"],["かた"],["は"],["、"],["また"],["内側","うちがわ"],["も"],["造られたで","つくられたで"],["は"],["ない"],["か"],["。"]]},{"verse":41,"text":"ただ、内側,うちがわにあるものをきよめなさい。そうすれば、いっさいがあなたがたにとって、清,きよいものとなる。","tok":[["ただ"],["、"],["内側","うちがわ"],["に"],["ある"],["もの"],["を"],["きよめ"],["なさい"],["。"],["そう"],["すれば"],["、"],["いっさい"],["が"],["あなた"],["がた"],["にとって"],["、"],["清い","きよい"],["もの"],["と"],["なる"],["。"]]},{"verse":42,"text":"しかし、あなた方,ほうパリサイ人,びとは、わざわいである。はっか、うん香,こう、あらゆる野菜,やさいなどの十分,ぶんの一を宮,みやに納,おさめておりながら、義,ぎと神,かみに対,たいする愛,あいとをなおざりにしている。それもなおざりにはできないが、これは行,おこなわねばならない。","tok":[["しかし"],["、"],["あなた"],["方","ほう"],["パリサイ"],["人","びと"],["は"],["、"],["わざわい"],["で"],["ある"],["。"],["はっか"],["、"],["うん"],["香","こう"],["、"],["あらゆる"],["野菜","やさい"],["など"],["の"],["十分","ぶん"],["の"],["一","いち"],["を"],["宮","みや"],["に"],["納","おさめ"],["て"],["おり"],["ながら"],["、"],["義","ぎ"],["と"],["神","かみ"],["に"],["対する","たいする"],["愛","あい"],["と"],["を"],["なおざり"],["に"],["して"],["いる"],["。"],["それ"],["も"],["なおざり"],["に"],["は"],["できない"],["が"],["、"],["これ"],["は"],["行なわねば","おこなわねば"],["ならない"],["。"]]},{"verse":43,"text":"あなたがたパリサイ人,びとは、わざわいである。会堂,かいどうの上席,じょうせきや広場,ひろばでの敬礼,けいれいを好,このんでいる。","tok":[["あなた"],["がた"],["パリサイ"],["人","びと"],["は"],["、"],["わざわい"],["で"],["ある"],["。"],["会堂","かいどう"],["の"],["上席","じょうせき"],["や"],["広場","ひろば"],["で"],["の"],["敬礼","けいれい"],["を"],["好んで","このんで"],["いる"],["。"]]},{"verse":44,"text":"あなたがたは、わざわいである。人目,ひとめにつかない墓,はかのようなものである。その上,うえを歩,あるいても人々,ひとびとは気,きづかないでいる」。","tok":[["あなた"],["がた"],["は"],["、"],["わざわい"],["で"],["ある"],["。"],["人目","ひとめ"],["に"],["つかない"],["墓","はか"],["の"],["よう"],["な"],["もの"],["で"],["ある"],["。"],["その"],["上","うえ"],["を"],["歩いて","あるいて"],["も"],["人々","ひとびと"],["は"],["気づかないで","きづかないで"],["いる"],["」"],["。"]]},{"verse":45,"text":"ひとりの律法,りっぽう学者,がくしゃがイエスに答,こたえて言,いった、「先生,せんせい、そんなことを言,いわれるのは、わたしたちまでも侮辱,ぶじょくすることです」。","tok":[["ひとり"],["の"],["律法学者","りっぽうがくしゃ"],["が"],["イエス"],["に"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["先生","せんせい"],["、"],["そんな"],["こと"],["を"],["言われる","いわれる"],["の"],["は"],["、"],["わたしたち"],["まで"],["も"],["侮辱","ぶじょく"],["する"],["こと"],["です"],["」"],["。"]]},{"verse":46,"text":"そこで言,いわれた、「あなたがた律法,りっぽう学者,がくしゃも、わざわいである。負,おい切,きれない重荷,おもにを人,ひとに負,おわせながら、自分,じぶんではその荷,にに指,ゆび一本,ぽんでも触,ふれようとしない。","tok":[["そこ"],["で"],["言われた","いわれた"],["、"],["「"],["あなた"],["がた"],["律法学者","りっぽうがくしゃ"],["も"],["、"],["わざわい"],["で"],["ある"],["。"],["負い","おい"],["切れない","きれない"],["重荷","おもに"],["を"],["人","ひと"],["に"],["負わせ","おわせ"],["ながら"],["、"],["自分","じぶん"],["で"],["は"],["その"],["荷","に"],["に"],["指","ゆび"],["一本","ぽん"],["で"],["も"],["触","ふれ"],["よう"],["と"],["しない"],["。"]]},{"verse":47,"text":"あなたがたは、わざわいである。預言者,よげんしゃたちの碑,ひを建,たてるが、しかし彼,かれらを殺,ころしたのは、あなたがたの先祖,せんぞであったのだ。","tok":[["あなた"],["がた"],["は"],["、"],["わざわい"],["で"],["ある"],["。"],["預言者","よげんしゃ"],["たち"],["の"],["碑","ひ"],["を"],["建てる","たてる"],["が"],["、"],["しかし"],["彼","かれ"],["ら"],["を"],["殺ろした","ころした"],["の"],["は"],["、"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["で"],["あった"],["の"],["だ"],["。"]]},{"verse":48,"text":"だから、あなたがたは、自分,じぶんの先祖,せんぞのしわざに同意,どういする証人,しょうにんなのだ。先祖,せんぞが彼,かれらを殺,ころし、あなたがたがその碑,ひを建,たてるのだから。","tok":[["だ"],["から"],["、"],["あなた"],["がた"],["は"],["、"],["自分","じぶん"],["の"],["先祖","せんぞ"],["の"],["しわざ"],["に"],["同意","どうい"],["する"],["証人","しょうにん"],["な"],["の"],["だ"],["。"],["先祖","せんぞ"],["が"],["彼","かれ"],["ら"],["を"],["殺ろし","ころし"],["、"],["あなた"],["がた"],["が"],["その"],["碑","ひ"],["を"],["建てる","たてる"],["の"],["だ"],["から"],["。"]]},{"verse":49,"text":"それゆえに、『神,かみの知恵,ちえ』も言,いっている、『わたしは預言者,よげんしゃと使徒,しととを彼,かれらにつかわすが、彼,かれらはそのうちのある者,ものを殺,ころしたり、迫害,はくがいしたりするであろう』。","tok":[["それ"],["ゆえ"],["に"],["、"],["『"],["神","かみ"],["の"],["知恵","ちえ"],["』"],["も"],["言って","いって"],["いる"],["、"],["『"],["わたし"],["は"],["預言者","よげんしゃ"],["と"],["使徒","しと"],["と"],["を"],["彼","かれ"],["ら"],["に"],["つかわす"],["が"],["、"],["彼","かれ"],["ら"],["は"],["その"],["うち"],["の"],["ある"],["者","もの"],["を"],["殺ろし","ころし"],["たり"],["、"],["迫害","はくがい"],["し"],["たり"],["するで"],["あろう"],["』"],["。"]]},{"verse":50,"text":"それで、アベルの血,ちから祭壇,さいだんと神殿,しんでんとの間,あいだで殺,ころされたザカリヤの血,ちに至,いたるまで、世,よの初,はじめから流,ながされてきたすべての預言者,よげんしゃの血,ちについて、この時代,じだいがその責任,せきにんを問,とわれる。","tok":[["それ"],["で"],["、"],["アベル"],["の"],["血","ち"],["から"],["祭壇","さいだん"],["と"],["神殿","しんでん"],["と"],["の"],["間","あいだ"],["で"],["殺ろされた","ころされた"],["ザカリヤ"],["の"],["血","ち"],["に"],["至る","いたる"],["まで"],["、"],["世","よ"],["の"],["初め","はじめ"],["から"],["流されて","ながされて"],["きた"],["すべて"],["の"],["預言者","よげんしゃ"],["の"],["血","ち"],["について"],["、"],["この"],["時代","じだい"],["が"],["その"],["責任","せきにん"],["を"],["問われる","とわれる"],["。"]]},{"verse":51,"text":"そうだ、あなたがたに言,いっておく、この時代,じだいがその責任,せきにんを問,とわれるであろう。","tok":[["そう"],["だ"],["、"],["あなた"],["がた"],["に"],["言って","いって"],["おく"],["、"],["この"],["時代","じだい"],["が"],["その"],["責任","せきにん"],["を"],["問われるで","とわれるで"],["あろう"],["。"]]},{"verse":52,"text":"あなたがた律法,りっぽう学者,がくしゃは、わざわいである。知識,ちしきのかぎを取,とりあげて、自分,じぶんがはいらないばかりか、はいろうとする人,ひとたちを妨,さまたげてきた」。","tok":[["あなた"],["がた"],["律法学者","りっぽうがくしゃ"],["は"],["、"],["わざわい"],["で"],["ある"],["。"],["知識","ちしき"],["の"],["かぎ"],["を"],["取","とり"],["あげて"],["、"],["自分","じぶん"],["が"],["はいらない"],["ばかり"],["か"],["、"],["はいろう"],["と"],["する"],["人","ひと"],["たち"],["を"],["妨げて","さまたげて"],["きた"],["」"],["。"]]},{"verse":53,"text":"イエスがそこを出,でて行,いかれると、律法,りっぽう学者,がくしゃやパリサイ人,びとは、激,はげしく詰,つめ寄,より、いろいろな事,ことを問,といかけて、","tok":[["イエス"],["が"],["そこ"],["を"],["出て","でて"],["行かれる","いかれる"],["と"],["、"],["律法学者","りっぽうがくしゃ"],["や"],["パリサイ"],["人","びと"],["は"],["、"],["激しく","はげしく"],["詰寄り","つめより"],["、"],["いろいろ"],["な"],["事","こと"],["を"],["問","とい"],["かけて"],["、"]]},{"verse":54,"text":"イエスの口,くちから何,なにか言,いいがかりを得,えようと、ねらいはじめた。","tok":[["イエス"],["の"],["口","くち"],["から"],["何に","なに"],["か"],["言いがかり","いいがかり"],["を"],["得よう","えよう"],["と"],["、"],["ねらい"],["はじめた"],["。"]]}]
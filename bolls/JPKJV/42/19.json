[{"verse":1,"text":"さて、イエスはエリコにはいって、その町,まちをお通,とおりになった。","tok":[["さて"],["、"],["イエス"],["は"],["エリコ"],["に"],["はいって"],["、"],["その"],["町","まち"],["を"],["お通り","おとおり"],["に"],["なった"],["。"]]},{"verse":2,"text":"ところが、そこにザアカイという名,なの人,ひとがいた。この人,ひとは取税人,しゅぜいにんのかしらで、金持,かねもちであった。","tok":[["ところ"],["が"],["、"],["そこ"],["に"],["ザアカイ"],["と"],["いう"],["名","な"],["の"],["人","ひと"],["が"],["いた"],["。"],["この"],["人","ひと"],["は"],["取","とり"],["税人","ぜいにん"],["の"],["かしら"],["で"],["、"],["金持","かねもち"],["で"],["あった"],["。"]]},{"verse":3,"text":"彼,かれは、イエスがどんな人,ひとか見,みたいと思,おもっていたが、背,せが低,ひくかったので、群衆,ぐんしゅうにさえぎられて見,みることができなかった。","tok":[["彼","かれ"],["は"],["、"],["イエス"],["が"],["どんな"],["人","ひと"],["か"],["見たい","みたい"],["と"],["思って","おもって"],["いた"],["が"],["、"],["背","せ"],["が"],["低かった","ひくかった"],["ので"],["、"],["群衆","ぐんしゅう"],["に"],["さえぎられて"],["見る","みる"],["こと"],["が"],["できなかった"],["。"]]},{"verse":4,"text":"それでイエスを見,みるために、前,まえの方,ほうに走,はしって行,いって、いちじく桑,くわの木,きに登,のぼった。そこを通,とおられるところだったからである。","tok":[["それ"],["で"],["イエス"],["を"],["見る","みる"],["ため"],["に"],["、"],["前","まえ"],["の"],["方","ほう"],["に"],["走って","はしって"],["行って","いって"],["、"],["いちじく"],["桑","くわ"],["の"],["木","き"],["に"],["登った","のぼった"],["。"],["そこ"],["を"],["通られる","とおられる"],["ところ"],["だった"],["から"],["で"],["ある"],["。"]]},{"verse":5,"text":"イエスは、その場所,ばしょにこられたとき、上,うえを見,みあげて言,いわれた、「ザアカイよ、急,いそいで下,くだりてきなさい。きょう、あなたの家,いえに泊,とまることにしているから」。","tok":[["イエス"],["は"],["、"],["その"],["場所","ばしょ"],["に"],["こられた"],["とき"],["、"],["上","うえ"],["を"],["見あげて","みあげて"],["言われた","いわれた"],["、"],["「"],["ザアカイ"],["よ"],["、"],["急いで","いそいで"],["下","く"],["だり"],["てき"],["なさい"],["。"],["きょう"],["、"],["あなた"],["の"],["家","いえ"],["に"],["泊まる","とまる"],["こと"],["に"],["して"],["いる"],["から"],["」"],["。"]]},{"verse":6,"text":"そこでザアカイは急,いそいでおりてきて、よろこんでイエスを迎,むかえ入,いれた。","tok":[["そこ"],["で"],["ザアカイ"],["は"],["急いで","いそいで"],["おりて"],["きて"],["、"],["よろこんで"],["イエス"],["を"],["迎","むかえ"],["入れた","いれた"],["。"]]},{"verse":7,"text":"人々,ひとびとはみな、これを見,みてつぶやき、「彼,かれは罪人,つみびとの家,いえにはいって客,きゃくとなった」と言,いった。","tok":[["人々","ひとびと"],["は"],["みな"],["、"],["これ"],["を"],["見て","みて"],["つぶやき"],["、"],["「"],["彼","かれ"],["は"],["罪人","つみびと"],["の"],["家","いえ"],["に"],["はいって"],["客","きゃく"],["と"],["なった"],["」"],["と"],["言った","いった"],["。"]]},{"verse":8,"text":"ザアカイは立,たって主,しゅに言,いった、「主,しゅよ、わたしは誓,ちかって自分,じぶんの財産,ざいさんの半分,はんぶんを貧民,ひんみんに施,ほどこします。また、もしだれかから不正,ふせいな取立,とりたてをしていましたら、それを四倍,ばいにして返,かえします」。","tok":[["ザアカイ"],["は"],["立って","たって"],["主に","しゅに"],["言った","いった"],["、"],["「"],["主","しゅ"],["よ"],["、"],["わたし"],["は"],["誓って","ちかって"],["自分","じぶん"],["の"],["財産","ざいさん"],["の"],["半分","はんぶん"],["を"],["貧民","ひんみん"],["に"],["施します","ほどこします"],["。"],["また"],["、"],["もし"],["だれ"],["か"],["から"],["不正","ふせい"],["な"],["取立","とりたて"],["を"],["して"],["いましたら"],["、"],["それ"],["を"],["四","よん"],["倍","ばい"],["に"],["して"],["返","かえし"],["ます"],["」"],["。"]]},{"verse":9,"text":"イエスは彼,かれに言,いわれた、「きょう、救,すくいがこの家,いえにきた。この人,ひともアブラハムの子,こなのだから。","tok":[["イエス"],["は"],["彼","かれ"],["に"],["言われた","いわれた"],["、"],["「"],["きょう"],["、"],["救い","すくい"],["が"],["この"],["家","いえ"],["に"],["きた"],["。"],["この"],["人","ひと"],["も"],["アブラハム"],["の"],["子","こ"],["な"],["の"],["だ"],["から"],["。"]]},{"verse":10,"text":"人,ひとの子,こがきたのは、失,うしなわれたものを尋,たずね出,だして救,すくうためである」。","tok":[["人","ひと"],["の"],["子","こ"],["が"],["きた"],["の"],["は"],["、"],["失なわれた","うしなわれた"],["もの"],["を"],["尋ね出して","たずねだして"],["救う","すくう"],["ため"],["で"],["ある"],["」"],["。"]]},{"verse":11,"text":"人々,ひとびとがこれらの言葉,ことばを聞,きいているときに、イエスはなお一つの譬,たとえをお話,はなしになった。それはエルサレムに近,ちかづいてこられたし、また人々,ひとびとが神,かみの国,くにはたちまち現,あらわれると思,おもっていたためである。","tok":[["人々","ひとびと"],["が"],["これ"],["ら"],["の"],["言葉","ことば"],["を"],["聞いて","きいて"],["いる"],["とき"],["に"],["、"],["イエス"],["は"],["なお"],["一","ひと"],["つ"],["の"],["譬","たとえ"],["を"],["お話","おはなし"],["に"],["なった"],["。"],["それ"],["は"],["エルサレム"],["に"],["近づいて","ちかづいて"],["こられた"],["し"],["、"],["また"],["人々","ひとびと"],["が"],["神","かみ"],["の"],["国","くに"],["は"],["たちまち"],["現われる","あらわれる"],["と"],["思って","おもって"],["いた"],["ため"],["で"],["ある"],["。"]]},{"verse":12,"text":"それで言,いわれた、「ある身分,みぶんの高,たかい人,ひとが、王位,おういを受,うけて帰,かえってくるために遠,とおい所,ところへ旅立,たびだつことになった。","tok":[["それ"],["で"],["言われた","いわれた"],["、"],["「"],["ある"],["身分","みぶん"],["の"],["高い","たかい"],["人","ひと"],["が"],["、"],["王位","おうい"],["を"],["受て","うけて"],["帰えって","かえって"],["くる"],["ため"],["に"],["遠い","とおい"],["所","ところ"],["へ"],["旅立つ","たびだつ"],["こと"],["に"],["なった"],["。"]]},{"verse":13,"text":"そこで十人,にんの僕,しもべを呼,よび十ミナを渡,わたして言,いった、『わたしが帰,かえって来,くるまで、これで商売,しょうばいをしなさい』。","tok":[["そこ"],["で"],["十人","にん"],["の"],["僕","し"],["も"],["べ"],["を"],["呼び","よび"],["十","じゅう"],["ミナ"],["を"],["渡","わたし"],["て"],["言った","いった"],["、"],["『"],["わたし"],["が"],["帰えって","かえって"],["来る","くる"],["まで"],["、"],["これ"],["で"],["商売","しょうばい"],["を"],["し"],["なさい"],["』"],["。"]]},{"verse":14,"text":"ところが、本国,ほんごくの住民,じゅうみんは彼,かれを憎,にくんでいたので、あとから使者,ししゃをおくって、『この人,ひとが王,おうになるのをわれわれは望,のぞんでいない』と言,いわせた。","tok":[["ところ"],["が"],["、"],["本国","ほんごく"],["の"],["住民","じゅうみん"],["は"],["彼","かれ"],["を"],["憎んで","にくんで"],["いた"],["ので"],["、"],["あと"],["から"],["使者","ししゃ"],["を"],["おくって"],["、"],["『"],["この"],["人","ひと"],["が"],["王","おう"],["に"],["なる"],["の"],["を"],["われわれ"],["は"],["望んで","のぞんで"],["いない"],["』"],["と"],["言わせた","いわせた"],["。"]]},{"verse":15,"text":"さて、彼,かれが王位,おういを受,うけて帰,かえってきたとき、だれがどんなもうけをしたかを知,しろうとして、金,かねを渡,わたしておいた僕,しもべたちを呼,よんでこさせた。","tok":[["さて"],["、"],["彼","かれ"],["が"],["王位","おうい"],["を"],["受て","うけて"],["帰えって","かえって"],["きた"],["とき"],["、"],["だれ"],["が"],["どんな"],["もうけ"],["を"],["した"],["か"],["を"],["知ろう","しろう"],["として"],["、"],["金","かね"],["を"],["渡","わたし"],["て"],["おいた"],["僕","し"],["も"],["べ"],["たち"],["を"],["呼んで","よんで"],["こさせた"],["。"]]},{"verse":16,"text":"最初,さいしょの者,ものが進,すすみ出,でて言,いった、『ご主人様,しゅじんさま、あなたの一ミナで十ミナをもうけました』。","tok":[["最初","さいしょ"],["の"],["者","もの"],["が"],["進み出て","すすみでて"],["言った","いった"],["、"],["『"],["ご主人様","ごしゅじんさま"],["、"],["あなた"],["の"],["一","いち"],["ミナ"],["で"],["十","じゅう"],["ミナ"],["を"],["もうけました"],["』"],["。"]]},{"verse":17,"text":"主人,しゅじんは言,いった、『よい僕,しもべよ、うまくやった。あなたは小,ちいさい事,ことに忠実,ちゅうじつであったから、十の町,まちを支配,しはいさせる』。","tok":[["主人","しゅじん"],["は"],["言った","いった"],["、"],["『"],["よい"],["僕","し"],["も"],["べ"],["よ"],["、"],["うまく"],["やった"],["。"],["あなた"],["は"],["小さい","ちいさい"],["事","こと"],["に"],["忠実","ちゅうじつ"],["で"],["あった"],["から"],["、"],["十","じゅう"],["の"],["町","まち"],["を"],["支配","しはい"],["させる"],["』"],["。"]]},{"verse":18,"text":"次,つぎの者,ものがきて言,いった、『ご主人様,しゅじんさま、あなたの一ミナで五ミナをつくりました』。","tok":[["次","つぎ"],["の"],["者","もの"],["が"],["きて"],["言った","いった"],["、"],["『"],["ご主人様","ごしゅじんさま"],["、"],["あなた"],["の"],["一","いち"],["ミナ"],["で"],["五","ご"],["ミナ"],["を"],["つくりました"],["』"],["。"]]},{"verse":19,"text":"そこでこの者,ものにも、『では、あなたは五つの町,まちのかしらになれ』と言,いった。","tok":[["そこ"],["で"],["この"],["者","もの"],["に"],["も"],["、"],["『"],["で"],["は"],["、"],["あなた"],["は"],["五","いつ"],["つ"],["の"],["町","まち"],["の"],["かしら"],["に"],["なれ"],["』"],["と"],["言った","いった"],["。"]]},{"verse":20,"text":"それから、もうひとりの者,ものがきて言,いった、『ご主人様,しゅじんさま、さあ、ここにあなたの一ミナがあります。わたしはそれをふくさに包,つつんで、しまっておきました。","tok":[["それ"],["から"],["、"],["もう"],["ひとり"],["の"],["者","もの"],["が"],["きて"],["言った","いった"],["、"],["『"],["ご主人様","ごしゅじんさま"],["、"],["さあ"],["、"],["ここ"],["に"],["あなた"],["の"],["一","いち"],["ミナ"],["が"],["あります"],["。"],["わたし"],["は"],["それ"],["を"],["ふくさ"],["に"],["包んで","つつんで"],["、"],["しまって"],["おきました"],["。"]]},{"verse":21,"text":"あなたはきびしい方,ほうで、おあずけにならなかったものを取,とりたて、おまきにならなかったものを刈,かる人,ひとなので、おそろしかったのです』。","tok":[["あなた"],["は"],["きびしい"],["方","ほう"],["で"],["、"],["おあずけ"],["に"],["ならなかった"],["もの"],["を"],["取","とり"],["たて"],["、"],["おまき"],["に"],["ならなかった"],["もの"],["を"],["刈る","かる"],["人","ひと"],["な"],["ので"],["、"],["おそろしかった"],["の"],["です"],["』"],["。"]]},{"verse":22,"text":"彼,かれに言,いった、『悪,わるい僕,しもべよ、わたしはあなたの言,いったその言葉,ことばであなたをさばこう。わたしがきびしくて、あずけなかったものを取,とりたて、まかなかったものを刈,かる人間,にんげんだと、知,しっているのか。","tok":[["彼","かれ"],["に"],["言った","いった"],["、"],["『"],["悪い","わるい"],["僕","し"],["も"],["べ"],["よ"],["、"],["わたし"],["は"],["あなた"],["の"],["言った","いった"],["その"],["言葉","ことば"],["で"],["あなた"],["を"],["さばこう"],["。"],["わたし"],["が"],["きびしくて"],["、"],["あずけなかった"],["もの"],["を"],["取","とり"],["たて"],["、"],["まかなかった"],["もの"],["を"],["刈る","かる"],["人間","にんげん"],["だ"],["と"],["、"],["知って","しって"],["いる"],["の"],["か"],["。"]]},{"verse":23,"text":"では、なぜわたしの金,かねを銀行,ぎんこうに入,いれなかったのか。そうすれば、わたしが帰,かえってきたとき、その金,かねを利子,りしと一緒,いっしょに引,ひき出,だしたであろうに』。","tok":[["で"],["は"],["、"],["なぜ"],["わたし"],["の"],["金","かね"],["を"],["銀行","ぎんこう"],["に"],["入れなかった","いれなかった"],["の"],["か"],["。"],["そう"],["すれば"],["、"],["わたし"],["が"],["帰えって","かえって"],["きた"],["とき"],["、"],["その"],["金","かね"],["を"],["利子","りし"],["と"],["一緒","いっしょ"],["に"],["引出したで","ひきだしたで"],["あろう"],["に"],["』"],["。"]]},{"verse":24,"text":"そして、そばに立,たっていた人々,ひとびとに、『その一ミナを彼,かれから取,とり上,あげて、十ミナを持,もっている者,ものに与,あたえなさい』と言,いった。","tok":[["そして"],["、"],["そば"],["に"],["立って","たって"],["いた"],["人々","ひとびと"],["に"],["、"],["『"],["その"],["一","いち"],["ミナ"],["を"],["彼","かれ"],["から"],["取上","とりあげ"],["て"],["、"],["十","じゅう"],["ミナ"],["を"],["持って","もって"],["いる"],["者","もの"],["に"],["与え","あたえ"],["なさい"],["』"],["と"],["言った","いった"],["。"]]},{"verse":25,"text":"彼,かれらは言,いった、『ご主人様,しゅじんさま、あの人,ひとは既,すでに十ミナを持,もっています』。","tok":[["彼","かれ"],["ら"],["は"],["言った","いった"],["、"],["『"],["ご主人様","ごしゅじんさま"],["、"],["あの"],["人","ひと"],["は"],["既に","すでに"],["十","じゅう"],["ミナ"],["を"],["持って","もって"],["います"],["』"],["。"]]},{"verse":26,"text":"『あなたがたに言,いうが、おおよそ持,もっている人,ひとには、なお与,あたえられ、持,もっていない人,ひとからは、持,もっているものまでも取,とり上,あげられるであろう。","tok":[["『"],["あなた"],["がた"],["に"],["言う","いう"],["が"],["、"],["おおよそ"],["持って","もって"],["いる"],["人","ひと"],["に"],["は"],["、"],["なお"],["与えられ","あたえられ"],["、"],["持て","もって"],["いない"],["人","ひと"],["から"],["は"],["、"],["持て","もって"],["いる"],["もの"],["まで"],["も"],["取上げられるで","とりあげられるで"],["あろう"],["。"]]},{"verse":27,"text":"しかしわたしが王,おうになることを好,このまなかったあの敵,てきどもを、ここにひっぱってきて、わたしの前,まえで打,うち殺,ころせ』」。","tok":[["しかし"],["わたし"],["が"],["王","おう"],["に"],["なる"],["こと"],["を"],["好まなかった","このまなかった"],["あの"],["敵","てき"],["ども"],["を"],["、"],["ここ"],["に"],["ひっぱって"],["きて"],["、"],["わたし"],["の"],["前","まえ"],["で"],["打ち","うち"],["殺ろせ","ころせ"],["』"],["」"],["。"]]},{"verse":28,"text":"イエスはこれらのことを言,いったのち、先頭,せんとうに立,たち、エルサレムへ上,のぼって行,いかれた。","tok":[["イエス"],["は"],["これ"],["ら"],["の"],["こと"],["を"],["言った","いった"],["のち"],["、"],["先頭","せんとう"],["に"],["立ち","たち"],["、"],["エルサレム"],["へ"],["上って","のぼって"],["行かれた","いかれた"],["。"]]},{"verse":29,"text":"そしてオリブという山,やまに沿,そったベテパゲとベタニヤに近,ちかづかれたとき、ふたりの弟子,でしをつかわして言,いわれた、","tok":[["そして"],["オリブ"],["と"],["いう"],["山","やま"],["に"],["沿った","そった"],["ベテパゲ"],["と"],["ベタニヤ"],["に"],["近づかれた","ちかづかれた"],["とき"],["、"],["ふたり"],["の"],["弟子","でし"],["を"],["つかわして"],["言われた","いわれた"],["、"]]},{"verse":30,"text":"「向,むこうの村,むらへ行,いきなさい。そこにはいったら、まだだれも乗,のったことのないろばの子,こがつないであるのを見,みるであろう。それを解,といて、引,ひいてきなさい。","tok":[["「"],["向こう","むこう"],["の"],["村","むら"],["へ"],["行き","いき"],["なさい"],["。"],["そこ"],["に"],["はいったら"],["、"],["まだ"],["だれ"],["も"],["乗った","のった"],["こと"],["の"],["ない"],["ろば"],["の"],["子","こ"],["が"],["つないで"],["ある"],["の"],["を"],["見るで","みるで"],["あろう"],["。"],["それ"],["を"],["解いて","といて"],["、"],["引いて","ひいて"],["き"],["なさい"],["。"]]},{"verse":31,"text":"もしだれかが『なぜ解,とくのか』と問,とうたら、『主,しゅがお入,いり用,ようなのです』と、そう言,いいなさい」。","tok":[["もし"],["だれ"],["か"],["が"],["『"],["なぜ"],["解く","とく"],["の"],["か"],["』"],["と"],["問うたら","とうたら"],["、"],["『"],["主","しゅ"],["が"],["お入用","おいりよう"],["な"],["の"],["です"],["』"],["と"],["、"],["そう"],["言い","いい"],["なさい"],["」"],["。"]]},{"verse":32,"text":"そこで、つかわされた者,ものたちが行,いって見,みると、果,はたして、言,いわれたとおりであった。","tok":[["そこ"],["で"],["、"],["つかわされた"],["者","もの"],["たち"],["が"],["行って","いって"],["見る","みる"],["と"],["、"],["果して","はたして"],["、"],["言われた","いわれた"],["とおり"],["で"],["あった"],["。"]]},{"verse":33,"text":"彼,かれらが、そのろばの子,こを解,といていると、その持,もち主,ぬしたちが、「なぜろばの子,こを解,とくのか」と言,いったので、","tok":[["彼","かれ"],["ら"],["が"],["、"],["その"],["ろば"],["の"],["子","こ"],["を"],["解いて","といて"],["いる"],["と"],["、"],["その"],["持主","もちぬし"],["たち"],["が"],["、"],["「"],["なぜ"],["ろば"],["の"],["子","こ"],["を"],["解く","とく"],["の"],["か"],["」"],["と"],["言った","いった"],["ので"],["、"]]},{"verse":34,"text":"「主,しゅがお入,いり用,ようなのです」と答,こたえた。","tok":[["「"],["主","しゅ"],["が"],["お入用","おいりよう"],["な"],["の"],["です"],["」"],["と"],["答","こたえ"],["た"],["。"]]},{"verse":35,"text":"そしてそれをイエスのところに引,ひいてきて、その子,ころばの上,うえに自分,じぶんたちの上着,うわぎをかけてイエスをお乗,のせした。","tok":[["そして"],["それ"],["を"],["イエス"],["の"],["ところ"],["に"],["引いて","ひいて"],["きて"],["、"],["その"],["子","こ"],["ろば"],["の"],["上","うえ"],["に"],["自分","じぶん"],["たち"],["の"],["上着","うわぎ"],["を"],["かけて"],["イエス"],["を"],["お乗せ","おのせ"],["した"],["。"]]},{"verse":36,"text":"そして進,すすんで行,いかれると、人々,ひとびとは自分,じぶんたちの上着,うわぎを道,みちに敷,しいた。","tok":[["そして"],["進んで","すすんで"],["行かれる","いかれる"],["と"],["、"],["人々","ひとびと"],["は"],["自分","じぶん"],["たち"],["の"],["上着","うわぎ"],["を"],["道","みち"],["に"],["敷いた","しいた"],["。"]]},{"verse":37,"text":"いよいよオリブ山,やまの下,くだり道,みちあたりに近,ちかづかれると、大,おおぜいの弟子,でしたちはみな喜,よろこんで、彼,かれらが見,みたすべての力,ちからあるみわざについて、声,こえ高,たからかに神,かみをさんびして言,いいはじめた、","tok":[["いよいよ"],["オリブ山","おりぶやま"],["の"],["下り道","くだりみち"],["あたり"],["に"],["近づかれる","ちかづかれる"],["と"],["、"],["大ぜい","おおぜい"],["の"],["弟子","でし"],["たち"],["は"],["みな"],["喜こんで","よろこんで"],["、"],["彼","かれ"],["ら"],["が"],["見た","みた"],["すべて"],["の"],["力","ちから"],["ある"],["みわざ"],["について"],["、"],["声","こえ"],["高らか","たからか"],["に"],["神","かみ"],["を"],["さん"],["び"],["して"],["言い","いい"],["はじめた"],["、"]]},{"verse":38,"text":"「主,しゅの御名,みなによってきたる王,おうに、祝福,しゅくふくあれ。天,てんには平和,へいわ、いと高,たかきところには栄光,えいこうあれ」。","tok":[["「"],["主","しゅ"],["の"],["御名","みな"],["によって"],["きたる"],["王","おう"],["に"],["、"],["祝福","しゅくふく"],["あれ"],["。"],["天","てん"],["に"],["は"],["平和","へいわ"],["、"],["いと"],["高き","たかき"],["ところ"],["に"],["は"],["栄光","えいこう"],["あれ"],["」"],["。"]]},{"verse":39,"text":"ところが、群衆,ぐんしゅうの中,なかにいたあるパリサイ人,びとたちがイエスに言,いった、「先生,せんせい、あなたの弟子,でしたちをおしかり下,ください」。","tok":[["ところ"],["が"],["、"],["群衆","ぐんしゅう"],["の"],["中","なか"],["に"],["いた"],["ある"],["パリサイ"],["人","びと"],["たち"],["が"],["イエス"],["に"],["言った","いった"],["、"],["「"],["先生","せんせい"],["、"],["あなた"],["の"],["弟子","でし"],["たち"],["を"],["おしかり"],["下さい","ください"],["」"],["。"]]},{"verse":40,"text":"答,こたえて言,いわれた、「あなたがたに言,いうが、もしこの人,ひとたちが黙,だまれば、石,いしが叫,さけぶであろう」。","tok":[["答","こたえ"],["て"],["言われた","いわれた"],["、"],["「"],["あなた"],["がた"],["に"],["言う","いう"],["が"],["、"],["もし"],["この"],["人","ひと"],["たち"],["が"],["黙れば","だまれば"],["、"],["石","いし"],["が"],["叫けぶで","さけぶで"],["あろう"],["」"],["。"]]},{"verse":41,"text":"いよいよ都,みやこの近,ちかくにきて、それが見,みえたとき、そのために泣,ないて言,いわれた、","tok":[["いよいよ"],["都","みやこ"],["の"],["近く","ちかく"],["に"],["きて"],["、"],["それ"],["が"],["見えた","みえた"],["とき"],["、"],["その"],["ため"],["に"],["泣いて","ないて"],["言われた","いわれた"],["、"]]},{"verse":42,"text":"「もしおまえも、この日,ひに、平和,へいわをもたらす道,みちを知,しってさえいたら……しかし、それは今,いまおまえの目,めに隠,かくされている。","tok":[["「"],["もし"],["おまえ"],["も"],["、"],["この"],["日","ひ"],["に"],["、"],["平和","へいわ"],["を"],["もたらす"],["道","みち"],["を"],["知って","しって"],["さえ"],["いたら"],["…"],["…"],[""],[""],["しかし"],["、"],["それ"],["は"],["今","いま"],["おまえ"],["の"],["目","め"],["に"],["隠されて","かくされて"],["いる"],["。"]]},{"verse":43,"text":"いつかは、敵,てきが周囲,しゅういに塁,るいを築,きずき、おまえを取,とりかこんで、四方,しほうから押,おし迫,せまり、","tok":[["いつ"],["か"],["は"],["、"],["敵","てき"],["が"],["周囲","しゅうい"],["に"],["塁","るい"],["を"],["築き","きずき"],["、"],["おまえ"],["を"],["取","とり"],["か"],["こん"],["で"],["、"],["四方","しほう"],["から"],["押","おし"],["迫まり","せまり"],["、"]]},{"verse":44,"text":"おまえとその内,うちにいる子,こらとを地,ちに打,うち倒,たおし、城内,じょうないの一つの石,いしも他,たの石,いしの上,うえに残,のこして置,おかない日,ひが来,くるであろう。それは、おまえが神,かみのおとずれの時,ときを知,しらないでいたからである」。","tok":[["おまえ"],["と"],["その"],["内","うち"],["に"],["いる"],["子","こ"],["ら"],["と"],["を"],["地","ち"],["に"],["打ち倒し","うちたおし"],["、"],["城内","じょうない"],["の"],["一","ひと"],["つ"],["の"],["石","いし"],["も"],["他","た"],["の"],["石","いし"],["の"],["上","うえ"],["に"],["残して","のこして"],["置かない","おかない"],["日","ひ"],["が"],["来るで","くるで"],["あろう"],["。"],["それ"],["は"],["、"],["おまえ"],["が"],["神","かみ"],["の"],["おとずれ"],["の"],["時","とき"],["を"],["知らないで","しらないで"],["いた"],["から"],["で"],["ある"],["」"],["。"]]},{"verse":45,"text":"それから宮,みやにはいり、商売人,しょうばいにんたちを追,おい出,だしはじめて、","tok":[["それ"],["から"],["宮","みや"],["に"],["はいり"],["、"],["商売人","しょうばいにん"],["たち"],["を"],["追い出し","おいだし"],["はじめて"],["、"]]},{"verse":46,"text":"彼,かれらに言,いわれた、「『わが家,やは祈,いのりの家,いえであるべきだ』と書,かいてあるのに、あなたがたはそれを盗賊,とうぞくの巣,すにしてしまった」。","tok":[["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["『"],["わが家","わがや"],["は"],["祈","いのり"],["の"],["家","いえ"],["で"],["あるべきだ"],["』"],["と"],["書いて","かいて"],["ある"],["のに"],["、"],["あなた"],["がた"],["は"],["それ"],["を"],["盗賊","とうぞく"],["の"],["巣","す"],["に"],["して"],["しまった"],["」"],["。"]]},{"verse":47,"text":"イエスは毎日,まいにち、宮,みやで教,おしえておられた。祭司長,さいしちょう、律法,りっぽう学者,がくしゃまた民衆,みんしゅうの重立,おもだった者,ものたちはイエスを殺,ころそうと思,おもっていたが、","tok":[["イエス"],["は"],["毎日","まいにち"],["、"],["宮","みや"],["で"],["教えて","おしえて"],["おられた"],["。"],["祭司長","さいしちょう"],["、"],["律法学者","りっぽうがくしゃ"],["また"],["民衆","みんしゅう"],["の"],["重立った","おもだった"],["者","もの"],["たち"],["は"],["イエス"],["を"],["殺そう","ころそう"],["と"],["思って","おもって"],["いた"],["が"],["、"]]},{"verse":48,"text":"民衆,みんしゅうがみな熱心,ねっしんにイエスに耳,みみを傾,かたむけていたので、手,てのくだしようがなかった。","tok":[["民衆","みんしゅう"],["が"],["みな"],["熱心","ねっしん"],["に"],["イエス"],["に"],["耳","みみ"],["を"],["傾むけて","かたむけて"],["いた"],["ので"],["、"],["手","て"],["の"],["くだし"],["よう"],["が"],["なかった"],["。"]]}]
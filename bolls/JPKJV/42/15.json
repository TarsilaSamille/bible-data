[{"verse":1,"text":"さて、取税人,しゅぜいにんや罪人,つみびとたちが皆,みな、イエスの話,はなしを聞,きこうとして近寄,ちかよってきた。","tok":[["さて"],["、"],["取","とり"],["税人","ぜいにん"],["ぜ"],["い"],["に"],["ん"],["や"],["罪人","つみびと"],["たち"],["が"],["皆","みな"],["、"],["イエス"],["の"],["話","はなし"],["を"],["聞こう","きこう"],["として"],["近寄って","ちかよって"],["きた"],["。"]]},{"verse":2,"text":"するとパリサイ人,びとや律法,りっぽう学者,がくしゃたちがつぶやいて、「この人,ひとは罪人,つみびとたちを迎,むかえて一緒,いっしょに食事,しょくじをしている」と言,いった。","tok":[["する"],["と"],["パリサイ"],["人","び"],["と"],["や"],["律法学者","りっぽうがくしゃ"],["たち"],["が"],["つぶやいて"],["、"],["「"],["この"],["人","ひと"],["は"],["罪人","つみびとたち"],["を"],["迎","むかえ"],["て"],["一緒","いっしょ"],["に"],["食事","しょくじ"],["を"],["して"],["いる"],["」"],["と"],["言った","いった"],["。"]]},{"verse":3,"text":"そこでイエスは彼,かれらに、この譬,たとえをお話,はなしになった、","tok":[["そこ"],["で"],["イエス"],["は"],["彼","かれ"],["ら"],["に"],["、"],["この"],["譬","たとえ"],["を"],["お話","おはなし"],["に"],["なった"],["、"]]},{"verse":4,"text":"「あなたがたのうちに、百匹,ぴきの羊,ひつじを持,もっている者,ものがいたとする。その一匹,ぴきがいなくなったら、九十九匹,ひきを野原,のはらに残,のこしておいて、いなくなった一匹,ぴきを見,みつけるまでは捜,さがし歩,あるかないであろうか。","tok":[["「"],["あなた"],["がた"],["の"],["うち"],["に"],["、"],["百匹","ぴき"],["の"],["羊","ひつじ"],["を"],["持って","もって"],["いる"],["者","もの"],["が"],["いた"],["と"],["する"],["。"],["その"],["一匹","ぴき"],["が"],["いなく"],["なったら"],["、"],["九十九匹","ひき"],["を"],["野原","のはら"],["に"],["残して","のこして"],["おいて"],["、"],["いなく"],["なった"],["一匹","ぴき"],["を"],["見つける","みつける"],["まで"],["は"],["捜し歩かないで","さがしあるかないで"],["あろう"],["か"],["。"]]},{"verse":5,"text":"そして見,みつけたら、喜,よろこんでそれを自分,じぶんの肩,かたに乗,のせ、","tok":[["そして"],["見つけたら","みつけたら"],["、"],["喜こんで","よろこんで"],["それ"],["を"],["自分","じぶん"],["の"],["肩","かた"],["に"],["乗せ","のせ"],["、"]]},{"verse":6,"text":"家,いえに帰,かえってきて友人,ゆうじんや隣,となり人,びとを呼,よび集,あつめ、『わたしと一緒,いっしょに喜,よろこんでください。いなくなった羊,ひつじを見,みつけましたから』と言,いうであろう。","tok":[["家","いえ"],["に"],["帰えって","かえって"],["きて"],["友人","ゆうじん"],["や"],["隣人","となりびと"],["を"],["呼び集め","よびあつめ"],["、"],["『"],["わたし"],["と"],["一緒","いっしょ"],["に"],["喜こんで","よろこんで"],["ください"],["。"],["いなく"],["なった"],["羊","ひつじ"],["を"],["見つけました","みつけました"],["から"],["』"],["と"],["言うで","いうで"],["あろう"],["。"]]},{"verse":7,"text":"よく聞,ききなさい。それと同,おなじように、罪人,つみびとがひとりでも悔,くい改,あらためるなら、悔改,くいあらためを必要,ひつようとしない九十九人,にんの正,ただしい人,ひとのためにもまさる大,おおきいよろこびが、天,てんにあるであろう。","tok":[["よく"],["聞","きき"],["なさい"],["。"],["それ"],["と"],["同じ","おなじ"],["よう"],["に"],["、"],["罪人","つみび"],["と"],["が"],["ひとり"],["で"],["も"],["悔い改めるなら","くいあらためるなら"],["、"],["悔改め","くいあらため"],["を"],["必要","ひつよう"],["と"],["しない"],["九十九人","にん"],["の"],["正い","ただしい"],["人","ひと"],["の"],["ため"],["に"],["も"],["まさる"],["大きい","おおきい"],["よろこび"],["が"],["、"],["天","てん"],["に"],["あるで"],["あろう"],["。"]]},{"verse":8,"text":"また、ある女,おんなが銀貨,ぎんか十枚,まいを持,もっていて、もしその一枚,まいをなくしたとすれば、彼女,かのじょはあかりをつけて家中,いえじゅうを掃,はき、それを見,みつけるまでは注意深,ちゅういぶかく捜,さがさないであろうか。","tok":[["また"],["、"],["ある"],["女","おんな"],["が"],["銀貨","ぎんか"],["十枚","まい"],["を"],["持って","もって"],["いて"],["、"],["もし"],["その"],["一枚","まい"],["を"],["なくした"],["と"],["すれば"],["、"],["彼女","かのじょ"],["は"],["あかり"],["を"],["つけて"],["家中","いえじゅう"],["を"],["掃き","はき"],["、"],["それ"],["を"],["見つける","みつける"],["まで"],["は"],["注意","ちゅうい"],["深","しん"],["うい"],["ぶかく"],["捜さないで","さがさないで"],["あろう"],["か"],["。"]]},{"verse":9,"text":"そして、見,みつけたなら、女,おんな友,ともだちや近所,きんじょの女,おんなたちを呼,よび集,あつめて、『わたしと一緒,いっしょに喜,よろこんでください。なくした銀貨,ぎんかが見,みつかりましたから』と言,いうであろう。","tok":[["そして"],["、"],["見つけたなら","みつけたなら"],["、"],["女","おんな"],["友だち","ともだち"],["や"],["近所","きんじょ"],["の"],["女","おんな"],["たち"],["を"],["呼び集めて","よびあつめて"],["、"],["『"],["わたし"],["と"],["一緒","いっしょ"],["に"],["喜こんで","よろこんで"],["ください"],["。"],["なくした"],["銀貨","ぎんか"],["が"],["見つかりました","みつかりました"],["から"],["』"],["と"],["言うで","いうで"],["あろう"],["。"]]},{"verse":10,"text":"よく聞,ききなさい。それと同,おなじように、罪人,つみびとがひとりでも悔,くい改,あらためるなら、神,かみの御使,みつかいたちの前,まえでよろこびがあるであろう」。","tok":[["よく"],["聞","きき"],["なさい"],["。"],["それ"],["と"],["同じ","おなじ"],["よう"],["に"],["、"],["罪人","つみび"],["と"],["が"],["ひとり"],["で"],["も"],["悔い改めるなら","くいあらためるなら"],["、"],["神","かみ"],["の"],["御使","みつかいたち"],["の"],["前","まえ"],["で"],["よろこび"],["が"],["あるで"],["あろう"],["」"],["。"]]},{"verse":11,"text":"また言,いわれた、「ある人,ひとに、ふたりのむすこがあった。","tok":[["また"],["言われた","いわれた"],["、"],["「"],["ある"],["人","ひと"],["に"],["、"],["ふたり"],["の"],["むすこ"],["が"],["あった"],["。"]]},{"verse":12,"text":"ところが、弟,おとうとが父親,ちちおやに言,いった、『父,ちちよ、あなたの財産,ざいさんのうちでわたしがいただく分,ぶんをください』。そこで、父,ちちはその身代,しんだいをふたりに分,わけてやった。","tok":[["ところ"],["が"],["、"],["弟","おとうと"],["が"],["父親","ちちおや"],["に"],["言った","いった"],["、"],["『"],["父","ちち"],["よ"],["、"],["あなた"],["の"],["財産","ざいさん"],["の"],["うち"],["で"],["わたし"],["が"],["いただく"],["分","ぶん"],["を"],["ください"],["』"],["。"],["そこ"],["で"],["、"],["父","ちち"],["は"],["その"],["身代","しんだい"],["を"],["ふたり"],["に"],["分けて","わけて"],["やった"],["。"]]},{"verse":13,"text":"それから幾日,いくにちもたたないうちに、弟,おとうとは自分,じぶんのものを全部,ぜんぶとりまとめて遠,とおい所,ところへ行,いき、そこで放蕩,ほうとうに身,みを持,もちくずして財産,ざいさんを使,つかい果,はたした。","tok":[["それ"],["から"],["幾日","いくにち"],["も"],["たたない"],["うち"],["に"],["、"],["弟","おとうと"],["は"],["自分","じぶん"],["の"],["もの"],["を"],["全部","ぜんぶ"],["とりまとめて"],["遠い","とおい"],["所","ところ"],["へ"],["行き","いき"],["、"],["そこ"],["で"],["放蕩","ほうとう"],["に"],["身","み"],["を"],["持","もち"],["くずして"],["財産","ざいさん"],["を"],["使い果たした","つかいはたした"],["。"]]},{"verse":14,"text":"何,なにもかも浪費,ろうひしてしまったのち、その地方,ちほうにひどいききんがあったので、彼,かれは食,たべることにも窮,きゅうしはじめた。","tok":[["何に","なに"],["も"],["か"],["も"],["浪費","ろうひ"],["して"],["しまった"],["のち"],["、"],["その"],["地方","ちほう"],["に"],["ひどい"],["ききん"],["が"],["あった"],["ので"],["、"],["彼","かれ"],["は"],["食べる","たべる"],["こと"],["に"],["も"],["窮し","きゅうし"],["はじめた"],["。"]]},{"verse":15,"text":"そこで、その地方,ちほうのある住民,じゅうみんのところに行,いって身,みを寄,よせたところが、その人,ひとは彼,かれを畑,はたけにやって豚,ぶたを飼,かわせた。","tok":[["そこ"],["で"],["、"],["その"],["地方","ちほう"],["の"],["ある"],["住民","じゅうみん"],["の"],["ところ"],["に"],["行って","いって"],["身","み"],["を"],["寄せた","よせた"],["ところ"],["が"],["、"],["その"],["人","ひと"],["は"],["彼","かれ"],["を"],["畑","はたけ"],["に"],["やって"],["豚","ぶた"],["を"],["飼わせた","かわせた"],["。"]]},{"verse":16,"text":"彼,かれは、豚,ぶたの食,たべるいなご豆,まめで腹,はらを満,みたしたいと思,おもうほどであったが、何,なにもくれる人,ひとはなかった。","tok":[["彼","かれ"],["は"],["、"],["豚","ぶた"],["の"],["食べる","たべる"],["いなご"],["豆","まめ"],["で"],["腹","はら"],["を"],["満たしたい","みたしたい"],["と"],["思","おもう"],["ほど"],["で"],["あった"],["が"],["、"],["何に","なに"],["も"],["くれる"],["人","ひと"],["は"],["なかった"],["。"]]},{"verse":17,"text":"そこで彼,かれは本心,ほんしんに立,たちかえって言,いった、『父,ちちのところには食物,しょくもつのあり余,あまっている雇人,やといにんが大,おおぜいいるのに、わたしはここで飢,うえて死,しのうとしている。","tok":[["そこ"],["で"],["彼","かれ"],["は"],["本心","ほんしん"],["に"],["立ちかえって","たちかえって"],["言った","いった"],["、"],["『"],["父","ちち"],["の"],["ところ"],["に"],["は"],["食物","しょくもつ"],["の"],["あり余って","ありあまって"],["いる"],["雇人","やといにん"],["が"],["大ぜい","おおぜい"],["いる"],["のに"],["、"],["わたし"],["は"],["ここ"],["で"],["飢","うえ"],["て"],["死のう","しのう"],["として"],["いる"],["。"]]},{"verse":18,"text":"立,たって、父,ちちのところへ帰,かえって、こう言,いおう、父,ちちよ、わたしは天,てんに対,たいしても、あなたにむかっても、罪,つみを犯,おかしました。","tok":[["立って","たって"],["、"],["父","ちち"],["の"],["ところ"],["へ"],["帰えって","かえって"],["、"],["こう"],["言おう","いおう"],["、"],["父","ちち"],["よ"],["、"],["わたし"],["は"],["天","てん"],["に対して","にたいして"],["も"],["、"],["あなた"],["に"],["むかって"],["も"],["、"],["罪","つみ"],["を"],["犯しました","おかしました"],["。"]]},{"verse":19,"text":"もう、あなたのむすこと呼,よばれる資格,しかくはありません。どうぞ、雇人,やといにんのひとり同様,どうようにしてください』。","tok":[["もう"],["、"],["あなた"],["の"],["むすこ"],["と"],["呼ばれる","よばれる"],["資格","しかく"],["は"],["ありません"],["。"],["どうぞ"],["、"],["雇人","やといにん"],["の"],["ひとり"],["同様","どうよう"],["に"],["して"],["ください"],["』"],["。"]]},{"verse":20,"text":"そこで立,たって、父,ちちのところへ出,でかけた。まだ遠,とおく離,はなれていたのに、父,ちちは彼,かれをみとめ、哀,あわれに思,おもって走,はしり寄,より、その首,くびをだいて接吻,せっぷんした。","tok":[["そこ"],["で"],["立って","たって"],["、"],["父","ちち"],["の"],["ところ"],["へ"],["出かけた","でかけた"],["。"],["まだ"],["遠く","とおく"],["離れて","はなれて"],["いた"],["のに"],["、"],["父","ちち"],["は"],["彼","かれ"],["を"],["みとめ"],["、"],["哀れ","あわれ"],["に"],["思って","おもって"],["走り寄り","はしりより"],["、"],["その"],["首","くび"],["を"],["だいて"],["接吻","せっぷん"],["した"],["。"]]},{"verse":21,"text":"むすこは父,ちちに言,いった、『父,ちちよ、わたしは天,てんに対,たいしても、あなたにむかっても、罪,つみを犯,おかしました。もうあなたのむすこと呼,よばれる資格,しかくはありません』。","tok":[["むすこ"],["は"],["父","ちち"],["に"],["言った","いった"],["、"],["『"],["父","ちち"],["よ"],["、"],["わたし"],["は"],["天","てん"],["に対して","にたいして"],["も"],["、"],["あなた"],["に"],["むかって"],["も"],["、"],["罪","つみ"],["を"],["犯しました","おかしました"],["。"],["もう"],["あなた"],["の"],["むすこ"],["と"],["呼ばれる","よばれる"],["資格","しかく"],["は"],["ありません"],["』"],["。"]]},{"verse":22,"text":"しかし父,ちちは僕,しもべたちに言,いいつけた、『さあ、早,はやく、最上,さいじょうの着物,きものを出,だしてきてこの子,こに着,きせ、指輪,ゆびわを手,てにはめ、はきものを足,あしにはかせなさい。","tok":[["しかし"],["父","ちち"],["は"],["僕","し"],["も"],["べ"],["たち"],["に"],["言いつけた","いいつけた"],["、"],["『"],["さあ"],["、"],["早く","はやく"],["、"],["最上","さいじょう"],["の"],["着物","きもの"],["を"],["出して","だして"],["きて"],["この"],["子","こ"],["に"],["着せ","きせ"],["、"],["指輪","ゆびわ"],["を"],["手","て"],["に"],["はめ"],["、"],["はきもの"],["を"],["足","あし"],["に"],["はかせ"],["なさい"],["。"]]},{"verse":23,"text":"また、肥,こえた子,こ牛,うしを引,ひいてきてほふりなさい。食,たべて楽,たのしもうではないか。","tok":[["また"],["、"],["肥","こえ"],["た"],["子牛","こうし"],["を"],["引いて","ひいて"],["きて"],["ほふり"],["なさい"],["。"],["食べて","たべて"],["楽しもうで","たのしもうで"],["は"],["ない"],["か"],["。"]]},{"verse":24,"text":"このむすこが死,しんでいたのに生,いき返,かえり、いなくなっていたのに見,みつかったのだから』。それから祝宴,しゅくえんがはじまった。","tok":[["この"],["むすこ"],["が"],["死んで","しんで"],["いた"],["のに"],["生き返り","いきかえり"],["、"],["いなく"],["なって"],["いた"],["のに"],["見つかった","みつかった"],["の"],["だ"],["から"],["』"],["。"],["それ"],["から"],["祝宴","しゅくえん"],["が"],["はじまった"],["。"]]},{"verse":25,"text":"ところが、兄,あには畑,はたけにいたが、帰,かえってきて家,いえに近,ちかづくと、音楽,おんがくや踊,おどりの音,おとが聞,きこえたので、","tok":[["ところ"],["が"],["、"],["兄","あに"],["は"],["畑","はたけ"],["に"],["いた"],["が"],["、"],["帰えって","かえって"],["きて"],["家","いえ"],["に"],["近づく","ちかづく"],["と"],["、"],["音楽","おんがく"],["や"],["踊","おどり"],["の"],["音","おと"],["が"],["聞こえた","きこえた"],["ので"],["、"]]},{"verse":26,"text":"ひとりの僕,しもべを呼,よんで、『いったい、これは何事,なにごとなのか』と尋,たずねた。","tok":[["ひとり"],["の"],["僕","し"],["も"],["べ"],["を"],["呼んで","よんで"],["、"],["『"],["いったい"],["、"],["これ"],["は"],["何事","なにごと"],["な"],["の"],["か"],["』"],["と"],["尋ねた","たずねた"],["。"]]},{"verse":27,"text":"僕,しもべは答,こたえた、『あなたのご兄弟,きょうだいがお帰,かえりになりました。無事,ぶじに迎,むかえたというので、父上,ちちうえが肥,こえた子,こ牛,うしをほふらせなさったのです』。","tok":[["僕","し"],["も"],["べ"],["は"],["答","こたえ"],["た"],["、"],["『"],["あなた"],["の"],["ご兄弟","ごきょうだい"],["が"],["お帰えり","おかえり"],["に"],["なりました"],["。"],["無事","ぶじ"],["に"],["迎","むかえ"],["た"],["と"],["いう"],["ので"],["、"],["父","ちち"],["上","うえ"],["が"],["肥","こえ"],["た"],["子牛","こうし"],["を"],["ほふらせ"],["なさった"],["の"],["です"],["』"],["。"]]},{"verse":28,"text":"兄,あにはおこって家,いえにはいろうとしなかったので、父,ちちが出,でてきてなだめると、","tok":[["兄","あに"],["は"],["おこって"],["家","いえ"],["に"],["はいろう"],["と"],["しなかった"],["ので"],["、"],["父","ちち"],["が"],["出て","でて"],["きて"],["なだめる"],["と"],["、"]]},{"verse":29,"text":"兄,あには父,ちちにむかって言,いった、『わたしは何,なんか年,ねんもあなたに仕,つかえて、一度,どでもあなたの言,いいつけにそむいたことはなかったのに、友,ともだちと楽,たのしむために子,こやぎ一匹,ぴきも下,くださったことはありません。","tok":[["兄","あに"],["は"],["父","ちち"],["に"],["むかって"],["言った","いった"],["、"],["『"],["わたし"],["は"],["何","なん"],["か"],["年","ねん"],["も"],["あなた"],["に"],["仕えて","つかえて"],["、"],["一度","ど"],["で"],["も"],["あなた"],["の"],["言いつけ","いいつけ"],["に"],["そむいた"],["こと"],["は"],["なかった"],["のに"],["、"],["友だち","ともだち"],["と"],["楽しむ","たのしむ"],["ため"],["に"],["子やぎ","こやぎ"],["一匹","ぴき"],["も"],["下さった","くださった"],["こと"],["は"],["ありません"],["。"]]},{"verse":30,"text":"それだのに、遊女,ゆうじょどもと一緒,いっしょになって、あなたの身代,しんだいを食,くいつぶしたこのあなたの子,こが帰,かえってくると、そのために肥,こえた子,こ牛,うしをほふりなさいました』。","tok":[["それ"],["だ"],["のに"],["、"],["遊女","ゆうじょ"],["ども"],["と"],["一緒","いっしょ"],["に"],["なって"],["、"],["あなた"],["の"],["身代","しんだい"],["を"],["食いつぶした","くいつぶした"],["この"],["あなた"],["の"],["子","こ"],["が"],["帰えって","かえって"],["くる"],["と"],["、"],["その"],["ため"],["に"],["肥","こえ"],["た"],["子牛","こうし"],["を"],["ほふり"],["なさいました"],["』"],["。"]]},{"verse":31,"text":"すると父,ちちは言,いった、『子,こよ、あなたはいつもわたしと一緒,いっしょにいるし、またわたしのものは全部,ぜんぶあなたのものだ。","tok":[["する"],["と"],["父","ちち"],["は"],["言った","いった"],["、"],["『"],["子","こ"],["よ"],["、"],["あなた"],["は"],["いつも"],["わたし"],["と"],["一緒","いっしょ"],["に"],["いる"],["し"],["、"],["また"],["わたし"],["の"],["もの"],["は"],["全部","ぜんぶ"],["あなた"],["の"],["もの"],["だ"],["。"]]},{"verse":32,"text":"しかし、このあなたの弟,おとうとは、死,しんでいたのに生,いき返,かえり、いなくなっていたのに見,みつかったのだから、喜,よろこび祝,いわうのはあたりまえである』」。","tok":[["しかし"],["、"],["この"],["あなた"],["の"],["弟","おとうと"],["は"],["、"],["死の","しんでいたの"],["に"],["生き返り","いきかえり"],["、"],["いなく"],["なって"],["いた"],["のに"],["見つかった","みつかった"],["の"],["だ"],["から"],["、"],["喜こび","よろこび"],["祝う","いわう"],["の"],["は"],["あたりまえ"],["で"],["ある"],["』"],["」"],["。"]]}]
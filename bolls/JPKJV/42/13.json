[{"verse":1,"text":"ちょうどその時,とき、ある人々,ひとびとがきて、ピラトがガリラヤ人,びとたちの血,ちを流,ながし、それを彼,かれらの犠牲,ぎせいの血,ちに混,まぜたことを、イエスに知,しらせた。","tok":[["ちょうど"],["その"],["時","とき"],["、"],["ある"],["人々","ひとびと"],["が"],["きて"],["、"],["ピラト"],["が"],["ガリラヤ"],["人","びとたち"],["の"],["血","ち"],["を"],["流し","ながし"],["、"],["それ"],["を"],["彼","かれ"],["ら"],["の"],["犠牲","ぎせい"],["の"],["血","ち"],["に"],["混ぜた","まぜた"],["こと"],["を"],["、"],["イエス"],["に"],["知らせた","しらせた"],["。"]]},{"verse":2,"text":"そこでイエスは答,こたえて言,いわれた、「それらのガリラヤ人,びとが、そのような災難,さいなんにあったからといって、他,たのすべてのガリラヤ人,びと以上,いじょうに罪,つみが深,ふかかったと思,おもうのか。","tok":[["そこ"],["で"],["イエス"],["は"],["答","こたえ"],["て"],["言われた","いわれた"],["、"],["「"],["それ"],["ら"],["の"],["ガリラヤ"],["人","び"],["と"],["が"],["、"],["その"],["よう"],["な"],["災難","さいなん"],["に"],["あった"],["から"],["と"],["いって"],["、"],["他","た"],["の"],["すべて"],["の"],["ガリラヤ"],["人","び"],["と"],["以上","いじょう"],["に"],["罪","つみ"],["が"],["深","ふかかった"],["と"],["思","おもう"],["の"],["か"],["。"]]},{"verse":3,"text":"あなたがたに言,いうが、そうではない。あなたがたも悔,くい改,あらためなければ、みな同,おなじように滅,ほろびるであろう。","tok":[["あなた"],["がた"],["に"],["言う","いう"],["が"],["、"],["そう"],["で"],["は"],["ない"],["。"],["あなた"],["がた"],["も"],["悔い","くい"],["改","あらため"],["なければ"],["、"],["みな"],["同じ","おなじ"],["よう"],["に"],["滅びるで","ほろびるで"],["あろう"],["。"]]},{"verse":4,"text":"また、シロアムの塔,とうが倒,たおれたためにおし殺,ころされたあの十八人,にんは、エルサレムの他,たの全,ぜん住民,じゅうみん以上,いじょうに罪,つみの負債,ふさいがあったと思,おもうか。","tok":[["また"],["、"],["シロアム"],["の"],["塔","とう"],["が"],["倒れた","たおれた"],["ため"],["に"],["おし殺された","おしころされた"],["あの"],["十八人","にん"],["は"],["、"],["エルサレム"],["の"],["他","た"],["の"],["全住民","ぜんじゅうみん"],["以上","いじょう"],["に"],["罪","つみ"],["の"],["負債","ふさい"],["が"],["あった"],["と"],["思","おもう"],["か"],["。"]]},{"verse":5,"text":"あなたがたに言,いうが、そうではない。あなたがたも悔,くい改,あらためなければ、みな同,おなじように滅,ほろびるであろう」。","tok":[["あなた"],["がた"],["に"],["言う","いう"],["が"],["、"],["そう"],["で"],["は"],["ない"],["。"],["あなた"],["がた"],["も"],["悔い","くい"],["改","あらため"],["なければ"],["、"],["みな"],["同じ","おなじ"],["よう"],["に"],["滅びるで","ほろびるで"],["あろう"],["」"],["。"]]},{"verse":6,"text":"それから、この譬,たとえを語,かたられた、「ある人,ひとが自分,じぶんのぶどう園,えんにいちじくの木,きを植,うえて置,おいたので、実,みを捜,さがしにきたが見,みつからなかった。","tok":[["それ"],["から"],["、"],["この"],["譬","たとえ"],["を"],["語られた","かたられた"],["、"],["「"],["ある"],["人","ひと"],["が"],["自分","じぶん"],["の"],["ぶどう園","ぶどうえん"],["に"],["いちじく"],["の"],["木","き"],["を"],["植えて","うえて"],["置いた","おいた"],["ので"],["、"],["実","み"],["を"],["捜し","さがし"],["に"],["きた"],["が"],["見つからなかった","みつからなかった"],["。"]]},{"verse":7,"text":"そこで園丁,えんていに言,いった、『わたしは三年間,ねんかんも実,みを求,もとめて、このいちじくの木,きのところにきたのだが、いまだに見,みあたらない。その木,きを切,きり倒,たおしてしまえ。なんのために、土地,とちをむだにふさがせて置,おくのか』。","tok":[["そこ"],["で"],["園丁","えんてい"],["に"],["言った","いった"],["、"],["『"],["わたし"],["は"],["三","さん"],["年間","ねんかん"],["も"],["実","み"],["を"],["求めて","もとめて"],["、"],["この"],["いちじく"],["の"],["木","き"],["の"],["ところ"],["に"],["きた"],["の"],["だ"],["が"],["、"],["いまだ"],["に"],["見あたらない","みあたらない"],["。"],["その"],["木","き"],["を"],["切り倒して","きりたおして"],["しまえ"],["。"],["なん"],["の"],["ため"],["に"],["、"],["土地","とち"],["を"],["むだ"],["に"],["ふさがせて"],["置く","おく"],["の"],["か"],["』"],["。"]]},{"verse":8,"text":"すると園丁,えんていは答,こたえて言,いった、『ご主人様,しゅじんさま、ことしも、そのままにして置,おいてください。そのまわりを掘,ほって肥料,ひりょうをやって見,みますから。","tok":[["する"],["と"],["園丁","えんてい"],["は"],["答","こたえ"],["て"],["言った","いった"],["、"],["『"],["ご主人様","ごしゅじんさま"],["、"],["こと"],["しも"],["、"],["そのまま"],["に"],["して"],["置いて","おいて"],["ください"],["。"],["その"],["まわり"],["を"],["掘って","ほって"],["肥料","ひりょう"],["を"],["やって"],["見ます","みます"],["から"],["。"]]},{"verse":9,"text":"それで来年,らいねん実,みがなりましたら結構,けっこうです。もしそれでもだめでしたら、切,きり倒,たおしてください』」。","tok":[["それ"],["で"],["来年","らいねん"],["実","み"],["が"],["なりましたら"],["結構","けっこう"],["です"],["。"],["もし"],["それ"],["で"],["も"],["だめ"],["でしたら"],["、"],["切り倒して","きりたおして"],["ください"],["』"],["」"],["。"]]},{"verse":10,"text":"安息日,あんそくにちに、ある会堂,かいどうで教,おしえておられると、","tok":[["安息日","あんそくにち"],["に"],["、"],["ある"],["会堂","かいどう"],["で"],["教えて","おしえて"],["おられる"],["と"],["、"]]},{"verse":11,"text":"そこに十八年間,ねんかんも病気,びょうきの霊,れいにつかれ、かがんだままで、からだを伸,のばすことの全,まったくできない女,おんながいた。","tok":[["そこ"],["に"],["十八","じゅうはち"],["年間","ねんかん"],["も"],["病気","びょうき"],["の"],["霊","れい"],["に"],["つかれ"],["、"],["かがんだ"],["まま"],["で"],["、"],["からだ"],["を"],["伸ばす","のばす"],["こと"],["の"],["全く","まったく"],["できない"],["女","おんな"],["が"],["いた"],["。"]]},{"verse":12,"text":"イエスはこの女,おんなを見,みて、呼,よびよせ、「女,おんなよ、あなたの病気,びょうきはなおった」と言,いって、","tok":[["イエス"],["は"],["この"],["女","おんな"],["を"],["見て","みて"],["、"],["呼びよせ","よびよせ"],["、"],["「"],["女","おんな"],["よ"],["、"],["あなた"],["の"],["病気","びょうき"],["は"],["なおった"],["」"],["と"],["言って","いって"],["、"]]},{"verse":13,"text":"手,てをその上,うえに置,おかれた。すると立,たちどころに、そのからだがまっすぐになり、そして神,かみをたたえはじめた。","tok":[["手","て"],["を"],["その"],["上","うえ"],["に"],["置かれた","おかれた"],["。"],["する"],["と"],["立ち","たち"],["どころ"],["に"],["、"],["その"],["からだ"],["が"],["まっすぐ"],["に"],["なり"],["、"],["そして"],["神","かみ"],["を"],["たたえ"],["はじめた"],["。"]]},{"verse":14,"text":"ところが会堂司,かいどうづかさは、イエスが安息日,あんそくにちに病気,びょうきをいやされたことを憤,いきどおり、群衆,ぐんしゅうにむかって言,いった、「働,はたらくべき日,ひは六日,むいかある。その間,あいだに、なおしてもらいにきなさい。安息日,あんそくにちにはいけない」。","tok":[["ところ"],["が"],["会堂司","かいどうづかさ"],["は"],["、"],["イエス"],["が"],["安息日","あんそくにち"],["に"],["病気","びょうき"],["を"],["いやされた"],["こと"],["を"],["憤り","いきどおり"],["、"],["群衆","ぐんしゅう"],["に"],["むかって"],["言った","いった"],["、"],["「"],["働くべき","はたらくべき"],["日","ひ"],["は"],["六日","むいか"],["ある"],["。"],["その"],["間","あいだ"],["に"],["、"],["なお"],["して"],["もらい"],["に"],["き"],["なさい"],["。"],["安息日","あんそくにち"],["に"],["は"],["いけない"],["」"],["。"]]},{"verse":15,"text":"主,しゅはこれに答,こたえて言,いわれた、「偽善者,ぎぜんしゃたちよ、あなたがたはだれでも、安息日,あんそくにちであっても、自分,じぶんの牛,うしやろばを家畜,かちく小屋,こやから解,といて、水,みずを飲,のませに引,ひき出,だしてやるではないか。","tok":[["主","しゅ"],["は"],["これ"],["に"],["答","こたえ"],["て"],["言われた","いわれた"],["、"],["「"],["偽善者","ぎぜんしゃ"],["たち"],["よ"],["、"],["あなた"],["がた"],["は"],["だれ"],["で"],["も"],["、"],["安息日","あんそくにちであって"],["も"],["、"],["自分","じぶん"],["の"],["牛","うし"],["や"],["ろば"],["を"],["家畜","かちく"],["小屋","こや"],["から"],["解いて","といて"],["、"],["水","みず"],["を"],["飲ませ","のませ"],["に"],["引出して","ひきだして"],["やるで"],["は"],["ない"],["か"],["。"]]},{"verse":16,"text":"それなら、十八年間,ねんかんもサタンに縛,しばられていた、アブラハムの娘,むすめであるこの女,おんなを、安息日,あんそくにちであっても、その束縛,そくばくから解,といてやるべきではなかったか」。","tok":[["それ"],["なら"],["、"],["十八","じゅうはち"],["年間","ねんかん"],["も"],["サタン"],["に"],["縛られて","しばられて"],["いた"],["、"],["アブラハム"],["の"],["娘","むすめ"],["で"],["ある"],["この"],["女","おんな"],["を"],["、"],["安息日","あんそくにちであって"],["も"],["、"],["その"],["束縛","そくばく"],["から"],["解いて","といて"],["やるべきで"],["は"],["なかった"],["か"],["」"],["。"]]},{"verse":17,"text":"こう言,いわれたので、イエスに反対,はんたいしていた人,ひとたちはみな恥,はじ入,いった。そして群衆,ぐんしゅうはこぞって、イエスがなされたすべてのすばらしいみわざを見,みて喜,よろこんだ。","tok":[["こう"],["言われた","いわれた"],["ので"],["、"],["イエス"],["に"],["反対","はんたい"],["して"],["いた"],["人","ひと"],["たち"],["は"],["みな"],["恥入った","はじいった"],["。"],["そして"],["群衆","ぐんしゅう"],["は"],["こぞって"],["、"],["イエス"],["が"],["なされた"],["すべて"],["の"],["すばらしい"],["みわざ"],["を"],["見て","みて"],["喜こんだ","よろこんだ"],["。"]]},{"verse":18,"text":"そこで言,いわれた、「神,かみの国,くには何,なにに似,にているか。またそれを何,なににたとえようか。","tok":[["そこ"],["で"],["言われた","いわれた"],["、"],["「"],["神","かみ"],["の"],["国","くに"],["は"],["何に","なに"],["に"],["似て","にて"],["いる"],["か"],["。"],["また"],["それ"],["を"],["何に","なに"],["に"],["たとえよう"],["か"],["。"]]},{"verse":19,"text":"一粒,つぶのからし種,だねのようなものである。ある人,ひとがそれを取,とって庭,にわにまくと、育,そだって木,きとなり、空,そらの鳥,とりもその枝,えだに宿,やどるようになる」。","tok":[["一","いち"],["粒","つぶ"],["の"],["からし"],["種","だね"],["の"],["よう"],["な"],["もの"],["で"],["ある"],["。"],["ある"],["人","ひと"],["が"],["それ"],["を"],["取って","とって"],["庭","にわ"],["に"],["まく"],["と"],["、"],["育って","そだって"],["木","き"],["と"],["なり"],["、"],["空","そら"],["の"],["鳥","とり"],["も"],["その"],["枝","えだ"],["に"],["宿る","やどる"],["よう"],["に"],["なる"],["」"],["。"]]},{"verse":20,"text":"また言,いわれた、「神,かみの国,くにを何,なににたとえようか。","tok":[["また"],["言われた","いわれた"],["、"],["「"],["神","かみ"],["の"],["国","くに"],["を"],["何に","なに"],["に"],["たとえよう"],["か"],["。"]]},{"verse":21,"text":"パン種,だねのようなものである。女,おんながそれを取,とって三斗,との粉,こなの中,なかに混,まぜると、全体,ぜんたいがふくらんでくる」。","tok":[["パン種","ぱんだね"],["の"],["よう"],["な"],["もの"],["で"],["ある"],["。"],["女","おんな"],["が"],["それ"],["を"],["取って","とって"],["三","さん"],["斗","と"],["の"],["粉","こな"],["の"],["中","なか"],["に"],["混ぜる","まぜる"],["と"],["、"],["全体","ぜんたい"],["が"],["ふくらんで"],["くる"],["」"],["。"]]},{"verse":22,"text":"さてイエスは教,おしえながら町々,まちまち村々,むらむらを通,とおり過,すぎ、エルサレムへと旅,たびを続,つづけられた。","tok":[["さて"],["イエス"],["は"],["教え","おしえ"],["ながら"],["町々","まちまち"],["村々","むらむら"],["を"],["通り","とおり"],["過","すぎ"],["、"],["エルサレム"],["へ"],["と"],["旅","たび"],["を"],["続けられた","つづけられた"],["。"]]},{"verse":23,"text":"すると、ある人,ひとがイエスに、「主,しゅよ、救,すくわれる人,ひとは少,すくないのですか」と尋,たずねた。","tok":[["する"],["と"],["、"],["ある"],["人","ひと"],["が"],["イエス"],["に"],["、"],["「"],["主","しゅ"],["よ"],["、"],["救われる","すくわれる"],["人","ひと"],["は"],["少ない","すくない"],["の"],["です"],["か"],["」"],["と"],["尋ねた","たずねた"],["。"]]},{"verse":24,"text":"そこでイエスは人々,ひとびとにむかって言,いわれた、「狭,せまい戸口,とぐちからはいるように努,つとめなさい。事実,じじつ、はいろうとしても、はいれない人,ひとが多,おおいのだから。","tok":[["そこ"],["で"],["イエス"],["は"],["人々","ひとびと"],["に"],["むかって"],["言われた","いわれた"],["、"],["「"],["狭い","せまい"],["戸口","とぐち"],["から"],["は"],["いる"],["よう"],["に"],["努め","つとめ"],["なさい"],["。"],["事実","じじつ"],["、"],["はいろう"],["として"],["も"],["、"],["は"],["いれない"],["人","ひと"],["が"],["多い","おおい"],["の"],["だ"],["から"],["。"]]},{"verse":25,"text":"家,いえの主人,しゅじんが立,たって戸,とを閉,とじてしまってから、あなたがたが外,そとに立,たち戸,とをたたき始,はじめて、『ご主人様,しゅじんさま、どうぞあけてください』と言,いっても、主人,しゅじんはそれに答,こたえて、『あなたがたがどこからきた人,ひとなのか、わたしは知,しらない』と言,いうであろう。","tok":[["家","いえ"],["の"],["主人","しゅじん"],["が"],["立って","たって"],["戸","と"],["を"],["閉じて","とじて"],["しまって"],["から"],["、"],["あなた"],["がた"],["が"],["外","そと"],["に"],["立ち","たち"],["戸","と"],["を"],["たたき"],["始","はじめ"],["て"],["、"],["『"],["ご主人様","ごしゅじんさま"],["、"],["どうぞ"],["あけて"],["ください"],["』"],["と"],["言って","いって"],["も"],["、"],["主人","しゅじん"],["は"],["それ"],["に"],["答","こたえ"],["て"],["、"],["『"],["あなた"],["がた"],["が"],["どこ"],["から"],["きた"],["人","ひと"],["な"],["の"],["か"],["、"],["わたし"],["は"],["知らない","しらない"],["』"],["と"],["言うで","いうで"],["あろう"],["。"]]},{"verse":26,"text":"そのとき、『わたしたちはあなたとご一緒,いっしょに飲,のみ食,くいしました。また、あなたはわたしたちの大通,おおどおりで教,おしえてくださいました』と言,いい出,だしても、","tok":[["その"],["とき"],["、"],["『"],["わたしたち"],["は"],["あなた"],["と"],["ご一緒","ごいっしょ"],["に"],["飲み食い","のみくい"],["しました"],["。"],["また"],["、"],["あなた"],["は"],["わたしたち"],["の"],["大通り","おおどおり"],["で"],["教えて","おしえて"],["くださいました"],["』"],["と"],["言い","いい"],["出して","だして"],["も"],["、"]]},{"verse":27,"text":"彼,かれは、『あなたがたがどこからきた人,ひとなのか、わたしは知,しらない。悪事,あくじを働,はたらく者,ものどもよ、みんな行,いってしまえ』と言,いうであろう。","tok":[["彼","かれ"],["は"],["、"],["『"],["あなた"],["がた"],["が"],["どこ"],["から"],["きた"],["人","ひと"],["な"],["の"],["か"],["、"],["わたし"],["は"],["知らない","しらない"],["。"],["悪事","あくじ"],["を"],["働く","はたらく"],["者","もの"],["ども"],["よ"],["、"],["みんな"],["行って","いって"],["しまえ"],["』"],["と"],["言うで","いうで"],["あろう"],["。"]]},{"verse":28,"text":"あなたがたは、アブラハム、イサク、ヤコブやすべての預言者,よげんしゃたちが、神,かみの国,くににはいっているのに、自分,じぶんたちは外,そとに投,なげ出,だされることになれば、そこで泣,なき叫,さけんだり、歯,はがみをしたりするであろう。","tok":[["あなた"],["がた"],["は"],["、"],["アブラハム"],["、"],["イサク"],["、"],["ヤコブ"],["や"],["すべて"],["の"],["預言者","よげんしゃ"],["たち"],["が"],["、"],["神","かみ"],["の"],["国","くに"],["に"],["はいって"],["いる"],["のに"],["、"],["自分","じぶん"],["たち"],["は"],["外","そと"],["に"],["投出される","なげだされる"],["こと"],["に"],["なれば"],["、"],["そこ"],["で"],["泣","なき"],["叫けん","さけん"],["だり"],["、"],["歯がみ","はがみ"],["を"],["し"],["たり"],["するで"],["あろう"],["。"]]},{"verse":29,"text":"それから人々,ひとびとが、東,ひがしから西,にしから、また南,みなみから北,きたからきて、神,かみの国,くにで宴会,えんかいの席,せきにつくであろう。","tok":[["それ"],["から"],["人々","ひとびと"],["が"],["、"],["東","ひがし"],["から"],["西","にし"],["から"],["、"],["また"],["南","みなみ"],["から"],["北","きた"],["から"],["きて"],["、"],["神","かみ"],["の"],["国","くに"],["で"],["宴会","えんかい"],["の"],["席","せき"],["に"],["つくで"],["あろう"],["。"]]},{"verse":30,"text":"こうしてあとのもので先,さきになるものがあり、また、先,さきのものであとになるものもある」。","tok":[["こう"],["して"],["あと"],["の"],["もの"],["で"],["先","さき"],["に"],["なる"],["もの"],["が"],["あり"],["、"],["また"],["、"],["先","さき"],["の"],["もの"],["で"],["あと"],["に"],["なる"],["もの"],["も"],["ある"],["」"],["。"]]},{"verse":31,"text":"ちょうどその時,とき、あるパリサイ人,びとたちが、イエスに近寄,ちかよってきて言,いった、「ここから出,でて行,いきなさい。ヘロデがあなたを殺,ころそうとしています」。","tok":[["ちょうど"],["その"],["時","とき"],["、"],["ある"],["パリサイ"],["人","びと"],["たち"],["が"],["、"],["イエス"],["に"],["近寄って","ちかよって"],["きて"],["言った","いった"],["、"],["「"],["ここ"],["から"],["出て","でて"],["行き","いき"],["なさい"],["。"],["ヘロデ"],["が"],["あなた"],["を"],["殺そう","ころそう"],["として"],["います"],["」"],["。"]]},{"verse":32,"text":"そこで彼,かれらに言,いわれた、「あのきつねのところへ行,いってこう言,いえ、『見,みよ、わたしはきょうもあすも悪霊,あくれいを追,おい出,だし、また、病気,びょうきをいやし、そして三日,か目,めにわざを終,おえるであろう。","tok":[["そこ"],["で"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["あの"],["きつね"],["の"],["ところ"],["へ"],["行って","いって"],["こう"],["言え","いえ"],["、"],["『"],["見よ","みよ"],["、"],["わたし"],["は"],["きょう"],["も"],["あす"],["も"],["悪霊","あくれい"],["を"],["追い出し","おいだし"],["、"],["また"],["、"],["病気","びょうき"],["を"],["いやし"],["、"],["そして"],["三日目","かめ"],["に"],["わざ"],["を"],["終えるで","おえるで"],["あろう"],["。"]]},{"verse":33,"text":"しかし、きょうもあすも、またその次,つぎの日,ひも、わたしは進,すすんで行,いかねばならない。預言者,よげんしゃがエルサレム以外,いがいの地,ちで死,しぬことは、あり得,えないからである』。","tok":[["しかし"],["、"],["きょう"],["も"],["あす"],["も"],["、"],["また"],["その"],["次","つぎ"],["の"],["日","ひ"],["も"],["、"],["わたし"],["は"],["進んで","すすんで"],["行かねば","いかねば"],["ならない"],["。"],["預言者","よげんしゃ"],["が"],["エルサレム"],["以外","いがい"],["の"],["地","ち"],["で"],["死ぬ","しぬ"],["こと"],["は"],["、"],["あり"],["得ない","えない"],["から"],["で"],["ある"],["』"],["。"]]},{"verse":34,"text":"ああ、エルサレム、エルサレム、預言者,よげんしゃたちを殺,ころし、おまえにつかわされた人々,ひとびとを石,いしで打,うち殺,ころす者,ものよ。ちょうどめんどりが翼,つばさの下,したにひなを集,あつめるように、わたしはおまえの子,こらを幾,いくたび集,あつめようとしたことであろう。それだのに、おまえたちは応,おうじようとしなかった。","tok":[["ああ"],["、"],["エルサレム"],["、"],["エルサレム"],["、"],["預言者","よげんしゃ"],["たち"],["を"],["殺ろし","ころし"],["、"],["おまえ"],["に"],["つかわされた"],["人々","ひとびと"],["を"],["石","いし"],["で"],["打ち","うち"],["殺ろす","ころす"],["者","もの"],["よ"],["。"],["ちょうど"],["めんどり"],["が"],["翼","つばさ"],["の"],["下","した"],["に"],["ひな"],["を"],["集める","あつめる"],["よう"],["に"],["、"],["わたし"],["は"],["おまえ"],["の"],["子","こ"],["ら"],["を"],["幾","いく"],["たび"],["集めよう","あつめよう"],["と"],["した"],["こと"],["で"],["あろう"],["。"],["それ"],["だ"],["のに"],["、"],["おまえ"],["たち"],["は"],["応じよう","おうじよう"],["と"],["しなかった"],["。"]]},{"verse":35,"text":"見,みよ、おまえたちの家,いえは見捨,みすてられてしまう。わたしは言,いって置,おく、『主,しゅの名,なによってきたるものに、祝福,しゅくふくあれ』とおまえたちが言,いう時,ときの来,くるまでは、再,ふたたびわたしに会,あうことはないであろう」。","tok":[["見よ","みよ"],["、"],["おまえ"],["たち"],["の"],["家","いえ"],["は"],["見捨てられて","みすてられて"],["しまう"],["。"],["わたし"],["は"],["言って","いって"],["置く","おく"],["、"],["『"],["主","しゅ"],["の"],["名","な"],["によって"],["きたる"],["もの"],["に"],["、"],["祝福","しゅくふく"],["あれ"],["』"],["と"],["おまえ"],["たち"],["が"],["言う","いう"],["時","とき"],["の"],["来る","くる"],["まで"],["は"],["、"],["再び","ふたたび"],["わたし"],["に"],["会う","あう"],["こと"],["は"],["ないで"],["あろう"],["」"],["。"]]}]
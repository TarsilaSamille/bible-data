[{"verse":1,"text":"ダリヨス王,おうの二年,ねん六月,がつ、その月,つきの一日,にちに、主,しゅの言葉,ことばが預言者,よげんしゃハガイによって、シャルテルの子,こ、ユダの総督,そうとくゼルバベル、およびヨザダクの子,こ、大,だい祭司,さいしヨシュアに臨,のぞんだ、","tok":[["ダリヨス"],["王","おう"],["の"],["二","に"],["年","ねん"],["六","ろく"],["月","がつ"],["つ"],["、"],["その"],["月","つき"],["の"],["一","いち"],["日","にち"],["に"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["が"],["預言者","よげんしゃ"],["ハガイ"],["によって"],["、"],["シャルテル"],["の"],["子","こ"],["、"],["ユダ"],["の"],["総督","そうとく"],["ゼルバベル"],["、"],["および"],["ヨザダク"],["の"],["子","こ"],["、"],["大","だい"],["祭司","さいし"],["ヨシュア"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":2,"text":"「万軍,ばんぐんの主,しゅはこう言,いわれる、この民,たみは、主,しゅの家,いえを再,ふたたび建,たてる時,ときは、まだこないと言,いっている」。","tok":[["「"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["この"],["民","たみ"],["は"],["、"],["主","しゅ"],["の"],["家","いえ"],["を"],["再び","ふたたび"],["建てる","たてる"],["時","とき"],["は"],["、"],["まだ"],["こない"],["と"],["言って","いって"],["いる"],["」"],["。"]]},{"verse":3,"text":"そこで、主,しゅの言葉,ことばはまた預言者,よげんしゃハガイに臨,のぞんだ、","tok":[["そこ"],["で"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["は"],["また"],["預言者","よげんしゃ"],["ハガイ"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":4,"text":"「主,しゅの家,いえはこのように荒,あれはてているのに、あなたがたは、みずから板,いたで張,はった家,いえに住,すんでいる時,ときであろうか。","tok":[["「"],["主","しゅ"],["の"],["家","いえ"],["は"],["この"],["よう"],["に"],["荒れはてて","あれはてて"],["いる"],["のに"],["、"],["あなた"],["がた"],["は"],["、"],["みずから"],["板","いた"],["で"],["張った","はった"],["家","いえ"],["に"],["住んで","すんで"],["いる"],["時","とき"],["で"],["あろう"],["か"],["。"]]},{"verse":5,"text":"それで今,いま、万軍,ばんぐんの主,しゅはこう言,いわれる、あなたがたは自分,じぶんのなすべきことをよく考,かんがえるがよい。","tok":[["それ"],["で"],["今","いま"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["あなた"],["がた"],["は"],["自分","じぶん"],["の"],["なすべき"],["こと"],["を"],["よく"],["考","かんがえ"],["る"],["が"],["よい"],["。"]]},{"verse":6,"text":"あなたがたは多,おおくまいても、取入,とりいれは少,すくなく、食,たべても、飽,あきることはない。飲,のんでも、満,みたされない。着,きても、暖,あたたまらない。賃銀,ちんぎんを得,えても、これを破,やぶれた袋,ふくろに入,いれているようなものである。","tok":[["あなた"],["がた"],["は"],["多く","おおく"],["まいて"],["も"],["、"],["取入","とりいれ"],["は"],["少く","すくなく"],["、"],["食べて","たべて"],["も"],["、"],["飽きる","あきる"],["こと"],["は"],["ない"],["。"],["飲","のん"],["で"],["も"],["、"],["満たされない","みたされない"],["。"],["着て","きて"],["も"],["、"],["暖まらない","あたたまらない"],["。"],["賃銀","ちんぎん"],["を"],["得て","えて"],["も"],["、"],["これ"],["を"],["破れた","やぶれた"],["袋","ふくろ"],["に"],["入れて","いれて"],["いる"],["よう"],["な"],["もの"],["で"],["ある"],["。"]]},{"verse":7,"text":"万軍,ばんぐんの主,しゅはこう言,いわれる、あなたがたは、自分,じぶんのなすべきことを考,かんがえるがよい。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["あなた"],["がた"],["は"],["、"],["自分","じぶん"],["の"],["なすべき"],["こと"],["を"],["考","かんがえ"],["る"],["が"],["よい"],["。"]]},{"verse":8,"text":"山,やまに登,のぼり、木,きを持,もってきて主,しゅの家,いえを建,たてよ。そうすればわたしはこれを喜,よろこび、かつ栄光,えいこうのうちに現,あらわれると主,しゅは言,いわれる。","tok":[["山","やま"],["に"],["登り","のぼり"],["、"],["木","き"],["を"],["持って","もって"],["きて"],["主","しゅ"],["の"],["家","いえ"],["を"],["建て","たて"],["よ"],["。"],["そう"],["すれば"],["わたし"],["は"],["これ"],["を"],["喜こび","よろこび"],["、"],["かつ"],["栄光","えいこう"],["の"],["うち"],["に"],["現われる","あらわれる"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":9,"text":"あなたがたは多,おおくを望,のぞんだが、見,みよ、それは少,すくなかった。あなたがたが家,いえに持,もってきたとき、わたしはそれを吹,ふき払,はらった。これは何,なにゆえであるかと、万軍,ばんぐんの主,しゅは言,いわれる。これはわたしの家,いえが荒,あれはてているのに、あなたがたは、おのおの自分,じぶんの家,いえの事,ことだけに、忙,いそがしくしている。","tok":[["あなた"],["がた"],["は"],["多く","おおく"],["を"],["望んだ","のぞんだ"],["が"],["、"],["見よ","みよ"],["、"],["それ"],["は"],["少かった","すくなかった"],["。"],["あなた"],["がた"],["が"],["家","いえ"],["に"],["持って","もって"],["きた"],["とき"],["、"],["わたし"],["は"],["それ"],["を"],["吹払った","ふきはらった"],["。"],["これ"],["は"],["何ゆえ","なにゆえ"],["で"],["ある"],["か"],["と"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["言われる","いわれる"],["。"],["これ"],["は"],["わたし"],["の"],["家","いえ"],["が"],["荒れはてて","あれはてて"],["いる"],["のに"],["、"],["あなた"],["がた"],["は"],["、"],["おのおの"],["自分","じぶん"],["の"],["家","いえ"],["の"],["事","こと"],["だけ"],["に"],["、"],["忙がしく","いそがしく"],["して"],["いる"],["。"]]},{"verse":10,"text":"それゆえ、あなたがたの上,うえの天,てんは露,つゆをさし止,とめ、地,ちはその産物,さんぶつをさし止,とめた。","tok":[["それ"],["ゆえ"],["、"],["あなた"],["がた"],["の"],["上","うえ"],["の"],["天","てん"],["は"],["露","つゆ"],["を"],["さし"],["止","とめ"],["、"],["地","ち"],["は"],["その"],["産物","さんぶつ"],["を"],["さし"],["止","とめ"],["た"],["。"]]},{"verse":11,"text":"また、わたしは地,ちにも、山,やまにも、穀物,こくもつにも、新,あたらしい酒,さけにも、油,あぶらにも、地,ちに生,しょうじるものにも、人間,にんげんにも、家畜,かちくにも、手,てで作,つくるすべての作物,さくもつにも、ひでりを呼,よび寄,よせた」。","tok":[["また"],["、"],["わたし"],["は"],["地","ち"],["に"],["も"],["、"],["山","やま"],["に"],["も"],["、"],["穀物","こくもつ"],["に"],["も"],["、"],["新らしい","あたらしい"],["酒","さけ"],["に"],["も"],["、"],["油","あぶら"],["に"],["も"],["、"],["地","ち"],["に"],["生じる","しょうじる"],["もの"],["に"],["も"],["、"],["人間","にんげん"],["に"],["も"],["、"],["家畜","かちく"],["に"],["も"],["、"],["手","て"],["で"],["作る","つくる"],["すべて"],["の"],["作物","さくもつ"],["に"],["も"],["、"],["ひでり"],["を"],["呼び寄せた","よびよせた"],["」"],["。"]]},{"verse":12,"text":"そこで、シャルテルの子,こゼルバベルとヨザダクの子,こ、大,だい祭司,さいしヨシュアおよび残,のこりのすべての民,たみは、その神,かみ、主,しゅの声,こえと、その神,かみ、主,しゅのつかわされた預言者,よげんしゃハガイの言葉,ことばとに聞,ききしたがい、そして民,たみは、主,しゅの前,まえに恐,おそれかしこんだ。","tok":[["そこ"],["で"],["、"],["シャルテル"],["の"],["子","こ"],["ゼルバベル"],["と"],["ヨザダク"],["の"],["子","こ"],["、"],["大","だい"],["祭司","さいし"],["ヨシュア"],["および"],["残り","のこり"],["の"],["すべて"],["の"],["民","たみ"],["は"],["、"],["その"],["神","かみ"],["、"],["主","しゅ"],["の"],["声","こえ"],["と"],["、"],["その"],["神","かみ"],["、"],["主","しゅ"],["の"],["つかわされた"],["預言者","よげんしゃ"],["ハガイ"],["の"],["言葉","ことば"],["と"],["に"],["聞き","きき"],["したがい"],["、"],["そして"],["民","たみ"],["は"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["恐","おそれ"],["かしこ"],["ん"],["だ"],["。"]]},{"verse":13,"text":"時,ときに、主,しゅの使者,ししゃハガイは主,しゅの命令,めいれいにより、民,たみに告,つげて言,いった、「わたしはあなたがたと共,ともにいると主,しゅは言,いわれる」。","tok":[["時","とき"],["に"],["、"],["主","しゅ"],["の"],["使者","ししゃ"],["ハガイ"],["は"],["主","しゅ"],["の"],["命令","めいれい"],["に"],["より"],["、"],["民","たみ"],["に"],["告","つげ"],["て"],["言った","いった"],["、"],["「"],["わたし"],["は"],["あなた"],["がた"],["と"],["共","とも"],["に"],["いる"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["」"],["。"]]},{"verse":14,"text":"そして主,しゅは、シャルテルの子,こ、ユダの総督,そうとくゼルバベルの心,こころと、ヨザダクの子,こ、大,だい祭司,さいしヨシュアの心,こころ、および残,のこりのすべての民,たみの心,こころを、振,ふり動,うごかされたので、彼,かれらは来,きて、その神,かみ、万軍,ばんぐんの主,しゅの家,いえの作業,さぎょうにとりかかった。","tok":[["そして"],["主","しゅ"],["は"],["、"],["シャルテル"],["の"],["子","こ"],["、"],["ユダ"],["の"],["総督","そうとく"],["ゼルバベル"],["の"],["心","こころ"],["と"],["、"],["ヨザダク"],["の"],["子","こ"],["、"],["大","だい"],["祭司","さいし"],["ヨシュア"],["の"],["心","こころ"],["、"],["および"],["残り","のこり"],["の"],["すべて"],["の"],["民","たみ"],["の"],["心","こころ"],["を"],["、"],["振り動かされた","ふりうごかされた"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["来て","きて"],["、"],["その"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["の"],["家","いえ"],["の"],["作業","さぎょう"],["に"],["とりかかった"],["。"]]},{"verse":15,"text":"これは六月,がつ二十四日,かのことであった。","tok":[["これ"],["は"],["六","ろく"],["月","がつ"],["つ"],["二十四日","か"],["の"],["こと"],["で"],["あった"],["。"]]}]
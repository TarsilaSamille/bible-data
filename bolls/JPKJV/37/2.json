[{"verse":1,"text":"ダリヨス王,おうの二年,ねんの七月,がつ二十一日,にちに、主,しゅの言葉,ことばが預言者,よげんしゃハガイに臨,のぞんだ、","tok":[["ダリヨス"],["王","おう"],["の"],["二","に"],["年","ねん"],["の"],["七","なな"],["月","がつ"],["つ"],["二十一","にじゅういち"],["日","にち"],["に"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["が"],["預言者","よげんしゃ"],["ハガイ"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":2,"text":"「シャルテルの子,こ、ユダの総督,そうとくゼルバベルと、ヨザダクの子,こ、大,だい祭司,さいしヨシュア、および残,のこりのすべての民,たみに告,つげて言,いえ、","tok":[["「"],["シャルテル"],["の"],["子","こ"],["、"],["ユダ"],["の"],["総督","そうとく"],["ゼルバベル"],["と"],["、"],["ヨザダク"],["の"],["子","こ"],["、"],["大","だい"],["祭司","さいし"],["ヨシュア"],["、"],["および"],["残り","のこり"],["の"],["すべて"],["の"],["民","たみ"],["に"],["告","つげ"],["て"],["言え","いえ"],["、"]]},{"verse":3,"text":"『あなたがた残,のこりの者,もののうち、以前,いぜんの栄光,えいこうに輝,かがやく主,しゅの家,いえを見,みた者,ものはだれか。あなたがたは今,いま、この状態,じょうたいをどう思,おもうか。これはあなたがたの目,めには、無,むにひとしいではないか。","tok":[["『"],["あなた"],["がた"],["残り","のこり"],["の"],["者","もの"],["の"],["うち"],["、"],["以前","いぜん"],["の"],["栄光","えいこう"],["に"],["輝やく","かがやく"],["主","しゅ"],["の"],["家","いえ"],["を"],["見た","みた"],["者","もの"],["は"],["だれ"],["か"],["。"],["あなた"],["がた"],["は"],["今","いま"],["、"],["この"],["状態","じょうたい"],["を"],["どう"],["思","おもう"],["か"],["。"],["これ"],["は"],["あなた"],["がた"],["の"],["目","め"],["に"],["は"],["、"],["無","む"],["に"],["ひとしいで"],["は"],["ない"],["か"],["。"]]},{"verse":4,"text":"主,しゅは言,いわれる、ゼルバベルよ、勇気,ゆうきを出,だせ。ヨザダクの子,こ、大,だい祭司,さいしヨシュアよ、勇気,ゆうきを出,だせ。主,しゅは言,いわれる。この地,ちのすべての民,たみよ、勇気,ゆうきを出,だせ。働,はたらけ。わたしはあなたがたと共,ともにいると、万軍,ばんぐんの主,しゅは言,いわれる。","tok":[["主","しゅ"],["は"],["言われる","いわれる"],["、"],["ゼルバベル"],["よ"],["、"],["勇気","ゆうき"],["を"],["出せ","だせ"],["。"],["ヨザダク"],["の"],["子","こ"],["、"],["大","だい"],["祭司","さいし"],["ヨシュア"],["よ"],["、"],["勇気","ゆうき"],["を"],["出せ","だせ"],["。"],["主","しゅ"],["は"],["言われる","いわれる"],["。"],["この"],["地","ち"],["の"],["すべて"],["の"],["民","たみ"],["よ"],["、"],["勇気","ゆうき"],["を"],["出せ","だせ"],["。"],["働","はたらけ"],["。"],["わたし"],["は"],["あなた"],["がた"],["と"],["共","とも"],["に"],["いる"],["と"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":5,"text":"これはあなたがたがエジプトから出,でた時,とき、わたしがあなたがたに、約束,やくそくした言葉,ことばである。わたしの霊,れいが、あなたがたのうちに宿,やどっている。恐,おそれるな。","tok":[["これ"],["は"],["あなた"],["がた"],["が"],["エジプト"],["から"],["出た","でた"],["時","とき"],["、"],["わたし"],["が"],["あなた"],["がた"],["に"],["、"],["約束","やくそく"],["した"],["言葉","ことば"],["で"],["ある"],["。"],["わたし"],["の"],["霊","れい"],["が"],["、"],["あなた"],["がた"],["の"],["うち"],["に"],["宿って","やどって"],["いる"],["。"],["恐れる","おそれる"],["な"],["。"]]},{"verse":6,"text":"万軍,ばんぐんの主,しゅはこう言,いわれる、しばらくして、いま一度,いちど、わたしは天,てんと、地,ちと、海,うみと、かわいた地,ちとを震,ふるう。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["しばらく"],["して"],["、"],["いま"],["一度","いちど"],["、"],["わたし"],["は"],["天","てん"],["と"],["、"],["地","ち"],["と"],["、"],["海","うみ"],["と"],["、"],["かわいた"],["地","ち"],["と"],["を"],["震う","ふるう"],["。"]]},{"verse":7,"text":"わたしはまた万国民,ばんこくみんを震,ふるう。万国民,ばんこくみんの財宝,ざいほうは、はいって来,きて、わたしは栄光,えいこうをこの家,いえに満,みたすと、万軍,ばんぐんの主,しゅは言,いわれる。","tok":[["わたし"],["は"],["また"],["万","まん"],["国民","こくみん"],["を"],["震う","ふるう"],["。"],["万国民","ばんこくみん"],["の"],["財宝","ざいほう"],["は"],["、"],["はいって"],["来て","きて"],["、"],["わたし"],["は"],["栄光","えいこう"],["を"],["この"],["家","いえ"],["に"],["満たす","みたす"],["と"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":8,"text":"銀,ぎんはわたしのもの、金,きんもわたしのものであると、万軍,ばんぐんの主,しゅは言,いわれる。","tok":[["銀","ぎん"],["は"],["わたし"],["の"],["もの"],["、"],["金","きん"],["も"],["わたし"],["の"],["もの"],["で"],["ある"],["と"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":9,"text":"主,しゅの家,いえの後,のちの栄光,えいこうは、前,まえの栄光,えいこうよりも大,おおきいと、万軍,ばんぐんの主,しゅは言,いわれる。わたしはこの所,ところに繁栄,はんえいを与,あたえると、万軍,ばんぐんの主,しゅは言,いわれる』」。","tok":[["主","しゅ"],["の"],["家","いえ"],["の"],["後","のち"],["の"],["栄光","えいこう"],["は"],["、"],["前","まえ"],["の"],["栄光","えいこう"],["より"],["も"],["大きい","おおきい"],["と"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["言われる","いわれる"],["。"],["わたし"],["は"],["この"],["所","ところ"],["に"],["繁栄","はんえい"],["を"],["与える","あたえる"],["と"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["言われる","いわれる"],["』"],["」"],["。"]]},{"verse":10,"text":"ダリヨスの二年,ねんの九月,がつ二十四日,かに、主,しゅの言葉,ことばが預言者,よげんしゃハガイに臨,のぞんだ、","tok":[["ダリヨス"],["の"],["二","に"],["年","ねん"],["の"],["九","きゅう"],["月","がつ"],["つ"],["二十四日","か"],["に"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["が"],["預言者","よげんしゃ"],["ハガイ"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":11,"text":"「万軍,ばんぐんの主,しゅはこう言,いわれる、律法,りっぽうについて祭司,さいしたちに尋,たずねて言,いえ、","tok":[["「"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["律法","りっぽう"],["について"],["祭司","さいし"],["たち"],["に"],["尋ねて","たずねて"],["言え","いえ"],["、"]]},{"verse":12,"text":"『人,ひとがその衣服,いふくのすそで聖,せいなる肉,にくを運,はこんで行,いき、そのすそがもし、パンまたはあつもの、または酒,さけ、または油,あぶら、またはどんな食物,しょくもつにでもさわったなら、それらは聖,せいなるものとなるか』と」。祭司,さいしたちは「ならない」と答,こたえた。","tok":[["『"],["人","ひと"],["が"],["その"],["衣服","いふく"],["の"],["すそ"],["で"],["聖","せい"],["なる"],["肉","にく"],["を"],["運こんで","はこんで"],["行き","いき"],["、"],["その"],["すそ"],["が"],["もし"],["、"],["パン"],["また"],["は"],["あつもの"],["、"],["また"],["は"],["酒","さけ"],["、"],["また"],["は"],["油","あぶら"],["、"],["また"],["は"],["どんな"],["食物","しょくもつ"],["に"],["で"],["も"],["さわったなら"],["、"],["それ"],["ら"],["は"],["聖","せい"],["なる"],["もの"],["と"],["なる"],["か"],["』"],["と"],["」"],["。"],["祭司","さいし"],["たち"],["は"],["「"],["ならない"],["」"],["と"],["答","こたえ"],["た"],["。"]]},{"verse":13,"text":"ハガイはまた言,いった、「もし、死体,したいによって汚,けがれた人,ひとが、これらの一,ひとつにさわったなら、それは汚,けがれるか」。祭司,さいしたちは「汚,けがれる」と答,こたえた。","tok":[["ハガイ"],["は"],["また"],["言った","いった"],["、"],["「"],["もし"],["、"],["死体","したい"],["によって"],["汚","け"],["がれ"],["た"],["人","ひと"],["が"],["、"],["これ"],["ら"],["の"],["一","ひと"],["つ"],["に"],["さわったなら"],["、"],["それ"],["は"],["汚","け"],["がれる"],["か"],["」"],["。"],["祭司","さいし"],["たち"],["は"],["「"],["汚","け"],["がれる"],["」"],["と"],["答","こたえ"],["た"],["。"]]},{"verse":14,"text":"そこで、ハガイは言,いった、「主,しゅは言,いわれる、この民,たみも、この国,くにも、わたしの前,まえでは、そのようである。またその手,てのわざもそのようである。その所,ところで彼,かれらのささげるものは、汚,けがれたものである。","tok":[["そこ"],["で"],["、"],["ハガイ"],["は"],["言った","いった"],["、"],["「"],["主","しゅ"],["は"],["言われる","いわれる"],["、"],["この"],["民","たみ"],["も"],["、"],["この"],["国","くに"],["も"],["、"],["わたし"],["の"],["前","まえ"],["で"],["は"],["、"],["その"],["よう"],["で"],["ある"],["。"],["また"],["その"],["手","て"],["の"],["わざ"],["も"],["その"],["よう"],["で"],["ある"],["。"],["その"],["所","ところ"],["で"],["彼","かれ"],["ら"],["の"],["ささげる"],["もの"],["は"],["、"],["汚","けがれたも"],["ので"],["ある"],["。"]]},{"verse":15,"text":"今,いま、あなたがたはこの日,ひから、後,のちの事,ことを思,おもうがよい。主,しゅの宮,みやで石,いしの上,うえに石,いしが積,つまれなかった前,まえ、あなたがたは、どんなであったか。","tok":[["今","いま"],["、"],["あなた"],["がた"],["は"],["この"],["日","ひ"],["から"],["、"],["後","のち"],["の"],["事","こと"],["を"],["思","おもう"],["が"],["よい"],["。"],["主","しゅ"],["の"],["宮","みや"],["で"],["石","いし"],["の"],["上","うえ"],["に"],["石","いし"],["が"],["積まれなかった","つまれなかった"],["前","まえ"],["、"],["あなた"],["がた"],["は"],["、"],["どんな"],["で"],["あった"],["か"],["。"]]},{"verse":16,"text":"あの時,ときには、二十枡,ますの麦,むぎの積,つまれる所,ところに行,いったが、わずかに十枡,ますを得,え、また五十桶,おけをくもうとして、酒,さかぶねに行,いったが、二十桶,おけを得,えたのみであった。","tok":[["あの"],["時","とき"],["に"],["は"],["、"],["二十","にじゅう"],["枡","ます"],["の"],["麦","むぎ"],["の"],["積まれる","つまれる"],["所","ところ"],["に"],["行った","いった"],["が"],["、"],["わずか"],["に"],["十","じゅう"],["枡","ます"],["を"],["得","え"],["、"],["また"],["五十","ごじゅう"],["桶","おけ"],["を"],["くもう"],["として"],["、"],["酒","さかぶね"],["に"],["行った","いった"],["が"],["、"],["二十","にじゅう"],["桶","おけ"],["を"],["得た","えた"],["のみ"],["で"],["あった"],["。"]]},{"verse":17,"text":"わたしは立,たち枯,がれと、腐,くさり穂,ほと、ひょうをもってあなたがたと、あなたがたのすべての手,てのわざを撃,うった。しかし、あなたがたは、わたしに帰,かえらなかったと主,しゅは言,いわれる。","tok":[["わたし"],["は"],["立ち枯れ","たちがれ"],["と"],["、"],["腐り","くさり"],["穂","ほ"],["と"],["、"],["ひょう"],["を"],["もって"],["あなた"],["がた"],["と"],["、"],["あなた"],["がた"],["の"],["すべて"],["の"],["手","て"],["の"],["わざ"],["を"],["撃った","うった"],["。"],["しかし"],["、"],["あなた"],["がた"],["は"],["、"],["わたし"],["に"],["帰えらなかった","かえらなかった"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":18,"text":"あなたがたはこの日,ひより後,のち、すなわち、九月,がつ二十四日,かよりの事,ことを思,おもうがよい。また主,しゅの宮,みやの基,もといをすえた日,ひから後,のちの事,ことを心,こころにとめるがよい。","tok":[["あなた"],["がた"],["は"],["この"],["日","ひ"],["より"],["後","の"],["ち"],["、"],["すなわち"],["、"],["九","きゅう"],["月","がつ"],["つ"],["二十四日","かより"],["の"],["事","こと"],["を"],["思","おもう"],["が"],["よい"],["。"],["また"],["主","しゅ"],["の"],["宮","みや"],["の"],["基い","もとい"],["を"],["すえた"],["日","ひ"],["から"],["後","のち"],["の"],["事","こと"],["を"],["心","こころ"],["に"],["とめる"],["が"],["よい"],["。"]]},{"verse":19,"text":"種,たねはなお、納屋,なやにあるか。ぶどうの木,き、いちじくの木,き、ざくろの木,き、オリブの木,きもまだ実,みを結,むすばない。しかし、わたしはこの日,ひから、あなたがたに恵,めぐみを与,あたえる」。","tok":[["種","た"],["ね"],["は"],["なお"],["、"],["納屋","なや"],["に"],["ある"],["か"],["。"],["ぶどう"],["の"],["木","き"],["、"],["いちじく"],["の"],["木","き"],["、"],["ざくろ"],["の"],["木","き"],["、"],["オリブ"],["の"],["木","き"],["も"],["まだ"],["実","み"],["を"],["結ばない","むすばない"],["。"],["しかし"],["、"],["わたし"],["は"],["この"],["日","ひ"],["から"],["、"],["あなた"],["がた"],["に"],["恵","めぐみ"],["を"],["与える","あたえる"],["」"],["。"]]},{"verse":20,"text":"この月,つきの二十四日,かに、主,しゅの言葉,ことばがふたたびハガイに臨,のぞんだ、","tok":[["この"],["月","つき"],["の"],["二十四日","か"],["に"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["が"],["ふたたび"],["ハガイ"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":21,"text":"「ユダの総督,そうとくゼルバベルに告,つげて言,いえ、わたしは天,てんと地,ちを震,ふるう。","tok":[["「"],["ユダ"],["の"],["総督","そうとく"],["ゼルバベル"],["に"],["告","つげ"],["て"],["言え","いえ"],["、"],["わたし"],["は"],["天","てん"],["と"],["地","ち"],["を"],["震う","ふるう"],["。"]]},{"verse":22,"text":"わたしは国々,くにぐにの王位,おういを倒,たおし、異邦,いほうの国々,くにぐにの力,ちからを滅,ほろぼし、また戦車,せんしゃ、およびこれに乗,のる者,ものを倒,たおす。馬,うまおよびこれに乗,のる者,ものは、たがいにその仲間,なかまのつるぎによって倒,たおれる。","tok":[["わたし"],["は"],["国々","くにぐに"],["の"],["王位","おうい"],["を"],["倒し","たおし"],["、"],["異邦","いほう"],["の"],["国々","くにぐに"],["の"],["力","ちから"],["を"],["滅ぼし","ほろぼし"],["、"],["また"],["戦車","せんしゃ"],["、"],["および"],["これ"],["に"],["乗る","のる"],["者","もの"],["を"],["倒す","たおす"],["。"],["馬","うま"],["および"],["これ"],["に"],["乗る","のる"],["者","もの"],["は"],["、"],["たがい"],["に"],["その"],["仲間","なかま"],["の"],["つるぎ"],["によって"],["倒れる","たおれる"],["。"]]},{"verse":23,"text":"万軍,ばんぐんの主,しゅは言,いわれる、シャルテルの子,こ、わがしもべゼルバベルよ、主,しゅは言,いわれる、その日,ひ、わたしはあなたを立,たて、あなたを印章,いんしょうのようにする。わたしはあなたを選,えらんだからであると、万軍,ばんぐんの主,しゅは言,いわれる」。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["言われる","いわれる"],["、"],["シャルテル"],["の"],["子","こ"],["、"],["わが"],["しもべ"],["ゼルバベル"],["よ"],["、"],["主","しゅ"],["は"],["言われる","いわれる"],["、"],["その"],["日","ひ"],["、"],["わたし"],["は"],["あなた"],["を"],["立て","たて"],["、"],["あなた"],["を"],["印章","いんしょう"],["の"],["よう"],["に"],["する"],["。"],["わたし"],["は"],["あなた"],["を"],["選らんだ","えらんだ"],["から"],["で"],["ある"],["と"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["言われる","いわれる"],["」"],["。"]]}]
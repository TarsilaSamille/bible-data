[{"verse":1,"text":"さて兄弟,きょうだいたちよ。わたしたちの主,しゅイエス・キリストの来臨,らいりんと、わたしたちがみもとに集,あつめられることとについて、あなたがたにお願,ねがいすることがある。","tok":[["さて"],["兄弟","きょうだい"],["たち"],["よ"],["。"],["わたしたち"],["の"],["主","しゅ"],["イエス"],["・"],["キリスト"],["の"],["来臨","らいりん"],["と"],["、"],["わたしたち"],["が"],["みもと"],["に"],["集められる","あつめられる"],["こと"],["と"],["について"],["、"],["あなた"],["がた"],["に"],["お願い","おねがい"],["する"],["こと"],["が"],["ある"],["。"]]},{"verse":2,"text":"霊,れいにより、あるいは言葉,ことばにより、あるいはわたしたちから出,でたという手紙,てがみによって、主,しゅの日,ひはすでにきたとふれまわる者,ものがあっても、すぐさま心,こころを動,うごかされたり、あわてたりしてはいけない。","tok":[["霊","れい"],["に"],["より"],["、"],["あるいは"],["言葉","ことば"],["に"],["より"],["、"],["あるいは"],["わたしたち"],["から"],["出た","でた"],["と"],["いう"],["手紙","てがみ"],["によって"],["、"],["主","しゅ"],["の"],["日","ひ"],["は"],["すでに"],["きた"],["と"],["ふれまわる"],["者","もの"],["が"],["あって"],["も"],["、"],["すぐさま"],["心","こころ"],["を"],["動かされ","うごかされ"],["たり"],["、"],["あわて"],["たり"],["して"],["は"],["いけない"],["。"]]},{"verse":3,"text":"だれがどんな事,ことをしても、それにだまされてはならない。まず背教,はいきょうのことが起,おこり、不法,ふほうの者,もの、すなわち、滅,ほろびの子,こが現,あらわれるにちがいない。","tok":[["だれ"],["が"],["どんな"],["事","こと"],["を"],["して"],["も"],["、"],["それ"],["に"],["だまされて"],["は"],["ならない"],["。"],["まず"],["背教","はいきょう"],["の"],["こと"],["が"],["起こり","おこり"],["、"],["不法","ふほう"],["の"],["者","もの"],["、"],["すなわち"],["、"],["滅び","ほろび"],["の"],["子","こ"],["が"],["現われる","あらわれる"],["に"],["ちがい"],["ない"],["。"]]},{"verse":4,"text":"彼,かれは、すべて神,かみと呼,よばれたり拝,おがまれたりするものに反抗,はんこうして立,たち上,あがり、自,みずから神,かみの宮,みやに座,ざして、自分,じぶんは神,かみだと宣言,せんげんする。","tok":[["彼","かれ"],["は"],["、"],["すべて"],["神","かみ"],["と"],["呼ばれ","よばれ"],["たり"],["拝まれ","おがまれ"],["たり"],["する"],["もの"],["に"],["反抗","はんこう"],["して"],["立ち上がり","たちあがり"],["、"],["自から","みずから"],["神","かみ"],["の"],["宮","みや"],["に"],["座して","ざして"],["、"],["自分","じぶん"],["は"],["神","かみ"],["だ"],["と"],["宣言","せんげん"],["する"],["。"]]},{"verse":5,"text":"わたしがまだあなたがたの所,ところにいた時,とき、これらの事,ことをくり返,かえして言,いったのを思,おもい出,ださないのか。","tok":[["わたし"],["が"],["まだ"],["あなた"],["がた"],["の"],["所","ところ"],["に"],["いた"],["時","とき"],["、"],["これ"],["ら"],["の"],["事","こと"],["を"],["くり"],["返","かえし"],["て"],["言った","いった"],["の"],["を"],["思い出さない","おもいださない"],["の"],["か"],["。"]]},{"verse":6,"text":"そして、あなたがたが知,しっているとおり、彼,かれが自分,じぶんに定,さだめられた時,ときになってから現,あらわれるように、いま彼,かれを阻止,そししているものがある。","tok":[["そして"],["、"],["あなた"],["がた"],["が"],["知って","しって"],["いる"],["とおり"],["、"],["彼","かれ"],["が"],["自分","じぶん"],["に"],["定められた","さだめられた"],["時","とき"],["に"],["なって"],["から"],["現われる","あらわれる"],["よう"],["に"],["、"],["いま"],["彼","かれ"],["を"],["阻止","そし"],["して"],["いる"],["もの"],["が"],["ある"],["。"]]},{"verse":7,"text":"不法,ふほうの秘密,ひみつの力,ちからが、すでに働,はたらいているのである。ただそれは、いま阻止,そししている者,ものが取,とり除,のぞかれる時,ときまでのことである。","tok":[["不法","ふほう"],["の"],["秘密","ひみつ"],["の"],["力","ちから"],["が"],["、"],["すでに"],["働いて","はたらいて"],["いる"],["ので"],["ある"],["。"],["ただ"],["それ"],["は"],["、"],["いま"],["阻止","そし"],["して"],["いる"],["者","もの"],["が"],["取除かれる","とりのぞかれる"],["時","とき"],["まで"],["の"],["こと"],["で"],["ある"],["。"]]},{"verse":8,"text":"その時,ときになると、不法,ふほうの者,ものが現,あらわれる。この者,ものを、主,しゅイエスは口,くちの息,いきをもって殺,ころし、来臨,らいりんの輝,かがやきによって滅,ほろぼすであろう。","tok":[["その"],["時","とき"],["に"],["なる"],["と"],["、"],["不法","ふほう"],["の"],["者","もの"],["が"],["現われる","あらわれる"],["。"],["この"],["者","もの"],["を"],["、"],["主","しゅ"],["イエス"],["は"],["口","くち"],["の"],["息","いき"],["を"],["もって"],["殺ろし","ころし"],["、"],["来臨","らいりん"],["の"],["輝やき","かがやき"],["によって"],["滅ぼすで","ほろぼすで"],["あろう"],["。"]]},{"verse":9,"text":"不法,ふほうの者,ものが来,くるのは、サタンの働,はたらきによるのであって、あらゆる偽,いつわりの力,ちからと、しるしと、不思議,ふしぎと、","tok":[["不法","ふほう"],["の"],["者","もの"],["が"],["来る","くる"],["の"],["は"],["、"],["サタン"],["の"],["働らき","はたらき"],["に"],["よる"],["ので"],["あって"],["、"],["あらゆる"],["偽わり","いつわり"],["の"],["力","ちから"],["と"],["、"],["しるし"],["と"],["、"],["不思議","ふしぎ"],["と"],["、"]]},{"verse":10,"text":"また、あらゆる不義,ふぎの惑,まどわしとを、滅,ほろぶべき者,ものどもに対,たいして行,おこなうためである。彼,かれらが滅,ほろびるのは、自分,じぶんらの救,すくいとなるべき真理,しんりに対,たいする愛,あいを受,うけいれなかった報,むくいである。","tok":[["また"],["、"],["あらゆる"],["不義","ふぎ"],["の"],["惑わし","まどわし"],["と"],["を"],["、"],["滅ぶべき","ほろぶべき"],["者","もの"],["ども"],["に対して","にたいして"],["行なう","おこなう"],["ため"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["が"],["滅びる","ほろびる"],["の"],["は"],["、"],["自分","じぶん"],["ら"],["の"],["救い","すくい"],["と"],["なるべき"],["真理","しんり"],["に"],["対する","たいする"],["愛","あい"],["を"],["受","うけ"],["いれなかった"],["報い","むくい"],["で"],["ある"],["。"]]},{"verse":11,"text":"そこで神,かみは、彼,かれらが偽,いつわりを信,しんじるように、迷,まよわす力,ちからを送,おくり、","tok":[["そこ"],["で"],["神","かみ"],["は"],["、"],["彼","かれ"],["ら"],["が"],["偽り","いつわり"],["を"],["信じる","しんじる"],["よう"],["に"],["、"],["迷わす","まよわす"],["力","ちから"],["を"],["送り","おくり"],["、"]]},{"verse":12,"text":"こうして、真理,しんりを信,しんじないで不義,ふぎを喜,よろこんでいたすべての人,ひとを、さばくのである。","tok":[["こう"],["して"],["、"],["真理","しんり"],["を"],["信じないで","しんじないで"],["不義","ふぎ"],["を"],["喜こんで","よろこんで"],["いた"],["すべて"],["の"],["人","ひと"],["を"],["、"],["さばく"],["ので"],["ある"],["。"]]},{"verse":13,"text":"しかし、主,しゅに愛,あいされている兄弟,きょうだいたちよ。わたしたちはいつもあなたがたのことを、神,かみに感謝,かんしゃせずにはおられない。それは、神,かみがあなたがたを初,はじめから選,えらんで、御霊,みたまによるきよめと、真理,しんりに対,たいする信仰,しんこうとによって、救,すくいを得,えさせようとし、","tok":[["しかし"],["、"],["主に","しゅに"],["愛されて","あいされて"],["いる"],["兄弟","きょうだい"],["たち"],["よ"],["。"],["わたしたち"],["は"],["いつも"],["あなた"],["がた"],["の"],["こと"],["を"],["、"],["神","かみ"],["に"],["感謝","かんしゃ"],["せず"],["に"],["は"],["おられない"],["。"],["それ"],["は"],["、"],["神","かみ"],["が"],["あなた"],["がた"],["を"],["初め","はじめ"],["から"],["選らんで","えらんで"],["、"],["御霊","みたま"],["に"],["よる"],["きよめ"],["と"],["、"],["真理","しんり"],["に"],["対する","たいする"],["信仰","しんこう"],["と"],["によって"],["、"],["救い","すくい"],["を"],["得させよう","えさせよう"],["と"],["し"],["、"]]},{"verse":14,"text":"そのために、わたしたちの福音,ふくいんによりあなたがたを召,めして、わたしたちの主,しゅイエス・キリストの栄光,えいこうにあずからせて下,くださるからである。","tok":[["その"],["ため"],["に"],["、"],["わたしたち"],["の"],["福音","ふくいん"],["に"],["より"],["あなた"],["がた"],["を"],["召","めし"],["て"],["、"],["わたしたち"],["の"],["主","しゅ"],["イエス"],["・"],["キリスト"],["の"],["栄光","えいこう"],["に"],["あずからせて"],["下さる","くださる"],["から"],["で"],["ある"],["。"]]},{"verse":15,"text":"そこで、兄弟,きょうだいたちよ。堅,かたく立,たって、わたしたちの言葉,ことばや手紙,てがみで教,おしえられた言伝,いいつたえを、しっかりと守,まもり続,つづけなさい。","tok":[["そこ"],["で"],["、"],["兄弟","きょうだい"],["たち"],["よ"],["。"],["堅く","かたく"],["立って","たって"],["、"],["わたしたち"],["の"],["言葉","ことば"],["や"],["手紙","てがみ"],["で"],["教えられた","おしえられた"],["言伝え","いいつたえ"],["を"],["、"],["しっかり"],["と"],["守り","まもり"],["続け","つづけ"],["なさい"],["。"]]},{"verse":16,"text":"どうか、わたしたちの主,しゅイエス・キリストご自身,じしんと、わたしたちを愛,あいし、恵,めぐみをもって永遠,えいえんの慰,なぐさめと確,たしかな望,のぞみとを賜,たまわるわたしたちの父,ちちなる神,かみとが、","tok":[["どう"],["か"],["、"],["わたしたち"],["の"],["主","しゅ"],["イエス"],["・"],["キリスト"],["ご自身","ごじしん"],["と"],["、"],["わたしたち"],["を"],["愛し","あいし"],["、"],["恵","めぐみ"],["を"],["もって"],["永遠","えいえん"],["の"],["慰さめ","なぐさめ"],["と"],["確か","たしか"],["な"],["望み","のぞみ"],["と"],["を"],["賜わる","たまわる"],["わたしたち"],["の"],["父","ちち"],["なる"],["神","かみ"],["と"],["が"],["、"]]},{"verse":17,"text":"あなたがたの心,こころを励,はげまし、あなたがたを強,つよめて、すべての良,よいわざを行,おこない、正,ただしい言葉,ことばを語,かたる者,ものとして下,くださるように。","tok":[["あなた"],["がた"],["の"],["心","こころ"],["を"],["励まし","はげまし"],["、"],["あなた"],["がた"],["を"],["強めて","つよめて"],["、"],["すべて"],["の"],["良い","よい"],["わざ"],["を"],["行ない","おこない"],["、"],["正い","ただしい"],["言葉","ことば"],["を"],["語る","かたる"],["者","もの"],["として"],["下さる","くださる"],["よう"],["に"],["。"]]}]
[{"verse":1,"text":"最後,さいごに、兄弟,きょうだいたちよ。わたしたちのために祈,いのってほしい。どうか主,しゅの言葉,ことばが、あなたがたの所,ところと同,おなじように、ここでも早,はやく広,ひろまり、また、あがめられるように。","tok":[["最後","さいご"],["に"],["、"],["兄弟","きょうだい"],["たち"],["よ"],["。"],["わたしたち"],["の"],["ため"],["に"],["祈って","いのって"],["ほしい"],["。"],["どう"],["か"],["主","しゅ"],["の"],["言葉","ことば"],["が"],["、"],["あなた"],["がた"],["の"],["所","ところ"],["と"],["同じ","おなじ"],["よう"],["に"],["、"],["ここ"],["で"],["も"],["早く","はやく"],["広まり","ひろまり"],["、"],["また"],["、"],["あがめられる"],["よう"],["に"],["。"]]},{"verse":2,"text":"また、どうか、わたしたちが不都合,ふつごうな悪人,あくにんから救,すくわれるように。事実,じじつ、すべての人,ひとが信仰,しんこうを持,もっているわけではない。","tok":[["また"],["、"],["どう"],["か"],["、"],["わたしたち"],["が"],["不都合","ふつごう"],["な"],["悪人","あくにん"],["から"],["救われる","すくわれる"],["よう"],["に"],["。"],["事実","じじつ"],["、"],["すべて"],["の"],["人","ひと"],["が"],["信仰","しんこう"],["を"],["持って","もって"],["いる"],["わけ"],["で"],["は"],["ない"],["。"]]},{"verse":3,"text":"しかし、主,しゅは真実,しんじつなかたであるから、あなたがたを強,つよめ、悪,あしき者,ものから守,まもって下,くださるであろう。","tok":[["しかし"],["、"],["主","しゅ"],["は"],["真実","しんじつ"],["な"],["かた"],["で"],["ある"],["から"],["、"],["あなた"],["がた"],["を"],["強め","つよめ"],["、"],["悪しき","あしき"],["者","もの"],["から"],["守って","まもって"],["下さるで","くださるで"],["あろう"],["。"]]},{"verse":4,"text":"わたしたちが命,めいじる事,ことを、あなたがたは現,げんに実行,じっこうしており、また、実行,じっこうするであろうと、わたしたちは、主,しゅにあって確信,かくしんしている。","tok":[["わたしたち"],["が"],["命じる","めいじる"],["事","こと"],["を"],["、"],["あなた"],["がた"],["は"],["現に","げんに"],["実行","じっこう"],["して"],["おり"],["、"],["また"],["、"],["実行","じっこう"],["するで"],["あろう"],["と"],["、"],["わたしたち"],["は"],["、"],["主に","しゅに"],["あって"],["確信","かくしん"],["して"],["いる"],["。"]]},{"verse":5,"text":"どうか、主,しゅがあなたがたの心,こころを導,みちびいて、神,かみの愛,あいとキリストの忍耐,にんたいとを持,もたせて下,くださるように。","tok":[["どう"],["か"],["、"],["主","しゅ"],["が"],["あなた"],["がた"],["の"],["心","こころ"],["を"],["導いて","みちびいて"],["、"],["神","かみ"],["の"],["愛","あい"],["と"],["キリスト"],["の"],["忍耐","にんたい"],["と"],["を"],["持たせて","もたせて"],["下さる","くださる"],["よう"],["に"],["。"]]},{"verse":6,"text":"兄弟,きょうだいたちよ。主,しゅイエス・キリストの名,なによってあなたがたに命,めいじる。怠惰,たいだな生活,せいかつをして、わたしたちから受,うけた言伝,いいつたえに従,したがわないすべての兄弟,きょうだいたちから、遠,とおざかりなさい。","tok":[["兄弟","きょうだい"],["たち"],["よ"],["。"],["主","しゅ"],["イエス"],["・"],["キリスト"],["の"],["名","な"],["によって"],["あなた"],["がた"],["に"],["命じる","めいじる"],["。"],["怠惰","たいだ"],["な"],["生活","せいかつ"],["を"],["して"],["、"],["わたしたち"],["から"],["受けた","うけた"],["言伝え","いいつたえ"],["に"],["従わない","したがわない"],["すべて"],["の"],["兄弟","きょうだい"],["たち"],["から"],["、"],["遠ざかり","とおざかり"],["なさい"],["。"]]},{"verse":7,"text":"わたしたちに、どうならうべきであるかは、あなたがた自身,じしんが知,しっているはずである。あなたがたの所,ところにいた時,ときには、わたしたちは怠惰,たいだな生活,せいかつをしなかったし、","tok":[["わたしたち"],["に"],["、"],["どう"],["ならうべきで"],["ある"],["か"],["は"],["、"],["あなた"],["がた"],["自身","じしん"],["が"],["知って","しって"],["いる"],["はず"],["で"],["ある"],["。"],["あなた"],["がた"],["の"],["所","ところ"],["に"],["いた"],["時","とき"],["に"],["は"],["、"],["わたしたち"],["は"],["怠惰","たいだ"],["な"],["生活","せいかつ"],["を"],["しなかった"],["し"],["、"]]},{"verse":8,"text":"人,ひとからパンをもらって食,たべることもしなかった。それどころか、あなたがたのだれにも負担,ふたんをかけまいと、日夜,にちや、労苦,ろうくし努力,どりょくして働,はたらき続,つづけた。","tok":[["人","ひと"],["から"],["パン"],["を"],["もらって"],["食べる","たべる"],["こと"],["も"],["しなかった"],["。"],["それ"],["どころ"],["か"],["、"],["あなた"],["がた"],["の"],["だれ"],["に"],["も"],["負担","ふたん"],["を"],["かけまい"],["と"],["、"],["日夜","にちや"],["、"],["労苦","ろうく"],["し"],["努力","どりょく"],["して"],["働らき","はたらき"],["続けた","つづけた"],["。"]]},{"verse":9,"text":"それは、わたしたちにその権利,けんりがないからではなく、ただわたしたちにあなたがたが見習,みならうように、身,みをもって模範,もはんを示,しめしたのである。","tok":[["それ"],["は"],["、"],["わたしたち"],["に"],["その"],["権利","けんり"],["が"],["ない"],["から"],["で"],["は"],["なく"],["、"],["ただ"],["わたしたち"],["に"],["あなた"],["がた"],["が"],["見","み"],["習らう","ならう"],["よう"],["に"],["、"],["身","み"],["を"],["もって"],["模範","もはん"],["を"],["示めした","しめした"],["ので"],["ある"],["。"]]},{"verse":10,"text":"また、あなたがたの所,ところにいた時,ときに、「働,はたらこうとしない者,ものは、食,たべることもしてはならない」と命,めいじておいた。","tok":[["また"],["、"],["あなた"],["がた"],["の"],["所","ところ"],["に"],["いた"],["時","とき"],["に"],["、"],["「"],["働こう","はたらこう"],["と"],["しない"],["者","もの"],["は"],["、"],["食べる","たべる"],["こと"],["も"],["して"],["は"],["ならない"],["」"],["と"],["命じて","めいじて"],["おいた"],["。"]]},{"verse":11,"text":"ところが、聞,きくところによると、あなたがたのうちのある者,ものは怠惰,たいだな生活,せいかつを送,おくり、働,はたらかないで、ただいたずらに動,うごきまわっているとのことである。","tok":[["ところ"],["が"],["、"],["聞く","きく"],["ところ"],["に"],["よる"],["と"],["、"],["あなた"],["がた"],["の"],["うち"],["の"],["ある"],["者","もの"],["は"],["怠惰","たいだ"],["な"],["生活","せいかつ"],["を"],["送り","おくり"],["、"],["働かないで","はたらかないで"],["、"],["ただ"],["いたずら"],["に"],["動きまわって","うごきまわって"],["いる"],["と"],["の"],["こと"],["で"],["ある"],["。"]]},{"verse":12,"text":"こうした人々,ひとびとに対,たいしては、静,しずかに働,はたらいて自分,じぶんで得,えたパンを食,たべるように、主,しゅイエス・キリストによって命,めいじまた勧,すすめる。","tok":[["こう"],["した"],["人々","ひとびと"],["に"],["対し","たいし"],["ては"],["、"],["静","しずか"],["に"],["働いて","はたらいて"],["自分","じぶん"],["で"],["得た","えた"],["パン"],["を"],["食べる","たべる"],["よう"],["に"],["、"],["主","しゅ"],["イエス"],["・"],["キリスト"],["によって"],["命じ","めいじ"],["また"],["勧める","すすめる"],["。"]]},{"verse":13,"text":"兄弟,きょうだいたちよ。あなたがたは、たゆまずに良,よい働,はたらきをしなさい。","tok":[["兄弟","きょうだい"],["たち"],["よ"],["。"],["あなた"],["がた"],["は"],["、"],["たゆまず"],["に"],["良い","よい"],["働らき","はたらき"],["を"],["し"],["なさい"],["。"]]},{"verse":14,"text":"もしこの手紙,てがみにしるしたわたしたちの言葉,ことばに聞,きき従,したがわない人,ひとがあれば、そのような人,ひとには注意,ちゅういをして、交際,こうさいしないがよい。彼,かれが自,みずから恥,はじるようになるためである。","tok":[["もし"],["この"],["手紙","てがみ"],["に"],["しるした"],["わたしたち"],["の"],["言葉","ことば"],["に"],["聞","きき"],["従わない","したがわない"],["人","ひと"],["が"],["あれば"],["、"],["その"],["よう"],["な"],["人","ひと"],["に"],["は"],["注意","ちゅうい"],["を"],["して"],["、"],["交際","こうさい"],["しない"],["が"],["よい"],["。"],["彼","かれ"],["が"],["自から","みずから"],["恥","はじ"],["る"],["よう"],["に"],["なる"],["ため"],["で"],["ある"],["。"]]},{"verse":15,"text":"しかし、彼,かれを敵,てきのように思,おもわないで、兄弟,きょうだいとして訓戒,くんかいしなさい。","tok":[["しかし"],["、"],["彼","かれ"],["を"],["敵","てき"],["の"],["よう"],["に"],["思わないで","おもわないで"],["、"],["兄弟","きょうだい"],["として"],["訓戒","くんかい"],["し"],["なさい"],["。"]]},{"verse":16,"text":"どうか、平和,へいわの主,しゅご自身,じしんが、いついかなる場合,ばあいにも、あなたがたに平和,へいわを与,あたえて下,くださるように。主,しゅがあなたがた一同,いちどうと共,ともにおられるように。","tok":[["どう"],["か"],["、"],["平和","へいわ"],["の"],["主","しゅ"],["ご自身","ごじしん"],["が"],["、"],["いつ"],["いかなる"],["場合","ばあい"],["に"],["も"],["、"],["あなた"],["がた"],["に"],["平和","へいわ"],["を"],["与","あたえ"],["て"],["下さる","くださる"],["よう"],["に"],["。"],["主","しゅ"],["が"],["あなた"],["がた"],["一同","いちどう"],["と"],["共","とも"],["に"],["おられる"],["よう"],["に"],["。"]]},{"verse":17,"text":"ここでパウロ自身,じしんが、手,てずからあいさつを書,かく。これは、わたしのどの手紙,てがみにも書,かく印,しるしである。わたしは、このように書,かく。","tok":[["ここ"],["で"],["パウロ"],["自身","じしん"],["が"],["、"],["手ずから","てずから"],["あいさつ"],["を"],["書く","かく"],["。"],["これ"],["は"],["、"],["わたし"],["の"],["どの"],["手紙","てがみ"],["に"],["も"],["書く","かく"],["印","しるし"],["で"],["ある"],["。"],["わたし"],["は"],["、"],["この"],["よう"],["に"],["書く","かく"],["。"]]},{"verse":18,"text":"どうか、わたしたちの主,しゅイエス・キリストの恵,めぐみが、あなたがた一同,いちどうと共,ともにあるように。","tok":[["どう"],["か"],["、"],["わたしたち"],["の"],["主","しゅ"],["イエス"],["・"],["キリスト"],["の"],["恵","めぐみ"],["が"],["、"],["あなた"],["がた"],["一同","いちどう"],["と"],["共","とも"],["に"],["ある"],["よう"],["に"],["。"]]}]
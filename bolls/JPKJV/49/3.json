[{"verse":1,"text":"こういうわけで、あなたがた異邦人,いほうじんのためにキリスト・イエスの囚人,しゅうじんとなっているこのパウロ――","tok":[["こう"],["いう"],["わけ"],["で"],["、"],["あなた"],["がた"],["異邦人","いほうじん"],["の"],["ため"],["に"],["キリスト"],["・"],["イエス"],["の"],["囚人","しゅうじん"],["と"],["なって"],["いる"],["この"],["パウロ"],["―"],["―"]]},{"verse":2,"text":"わたしがあなたがたのために神,かみから賜,たまわった恵,めぐみの務,つとめについて、あなたがたはたしかに聞,きいたであろう。","tok":[["わたし"],["が"],["あなた"],["がた"],["の"],["ため"],["に"],["神","かみ"],["から"],["賜わった","たまわった"],["恵","めぐみ"],["の"],["務め","つとめ"],["について"],["、"],["あなた"],["がた"],["は"],["たしか"],["に"],["聞いたで","きいたで"],["あろう"],["。"]]},{"verse":3,"text":"すなわち、すでに簡単,かんたんに書,かきおくったように、わたしは啓示,けいじによって奥義,おくぎを知,しらされたのである。","tok":[["すなわち"],["、"],["すでに"],["簡単","かんたん"],["に"],["書きおくった","かきおくった"],["よう"],["に"],["、"],["わたし"],["は"],["啓示","けいじ"],["によって"],["奥義","おくぎ"],["を"],["知らされた","しらされた"],["ので"],["ある"],["。"]]},{"verse":4,"text":"あなたがたはそれを読,よめば、キリストの奥義,おくぎをわたしがどう理解,りかいしているかがわかる。","tok":[["あなた"],["がた"],["は"],["それ"],["を"],["読めば","よめば"],["、"],["キリスト"],["の"],["奥義","おくぎ"],["を"],["わたし"],["が"],["どう"],["理解","りかい"],["して"],["いる"],["か"],["が"],["わかる"],["。"]]},{"verse":5,"text":"この奥義,おくぎは、いまは、御霊,みたまによって彼,かれの聖,せいなる使徒,しとたちと預言者,よげんしゃたちとに啓示,けいじされているが、前,まえの時代,じだいには、人,ひとの子,こらに対,たいして、そのように知,しらされてはいなかったのである。","tok":[["この"],["奥義","おくぎ"],["は"],["、"],["いま"],["は"],["、"],["御霊","みたま"],["によって"],["彼","かれ"],["の"],["聖","せい"],["なる"],["使徒","しと"],["たち"],["と"],["預言者","よげんしゃ"],["たち"],["と"],["に"],["啓示","けいじ"],["されて"],["いる"],["が"],["、"],["前","まえ"],["の"],["時代","じだい"],["に"],["は"],["、"],["人","ひと"],["の"],["子","こ"],["ら"],["に対して","にたいして"],["、"],["その"],["よう"],["に"],["知らされて","しらされて"],["は"],["いなかった"],["ので"],["ある"],["。"]]},{"verse":6,"text":"それは、異邦人,いほうじんが、福音,ふくいんによりキリスト・イエスにあって、わたしたちと共,ともに神,かみの国,くにをつぐ者,ものとなり、共,ともに一つのからだとなり、共,ともに約束,やくそくにあずかる者,ものとなることである。","tok":[["それ"],["は"],["、"],["異邦人","いほうじん"],["が"],["、"],["福音","ふくいん"],["に"],["より"],["キリスト"],["・"],["イエス"],["に"],["あって"],["、"],["わたしたち"],["と"],["共","とも"],["に"],["神","かみ"],["の"],["国","くに"],["を"],["つぐ"],["者","もの"],["と"],["なり"],["、"],["共","とも"],["に"],["一","ひと"],["つ"],["の"],["からだ"],["と"],["なり"],["、"],["共","とも"],["に"],["約束","やくそく"],["に"],["あずかる"],["者","もの"],["と"],["なる"],["こと"],["で"],["ある"],["。"]]},{"verse":7,"text":"わたしは、神,かみの力,ちからがわたしに働,はたらいて、自分,じぶんに与,あたえられた神,かみの恵,めぐみの賜物,たまものにより、福音,ふくいんの僕,しもべとされたのである。","tok":[["わたし"],["は"],["、"],["神","かみ"],["の"],["力","ちから"],["が"],["わたし"],["に"],["働いて","はたらいて"],["、"],["自分","じぶん"],["に"],["与えられた","あたえられた"],["神","かみ"],["の"],["恵","めぐみ"],["の"],["賜物","たまもの"],["に"],["より"],["、"],["福音","ふくいん"],["の"],["僕","し"],["も"],["べと"],["された"],["ので"],["ある"],["。"]]},{"verse":8,"text":"すなわち、聖徒,せいとたちのうちで最,もっとも小,ちいさい者,ものであるわたしにこの恵,めぐみが与,あたえられたが、それは、キリストの無尽蔵,むじんぞうの富,とみを異邦人,いほうじんに宣,のべ伝,つたえ、","tok":[["すなわち"],["、"],["聖徒","せいと"],["たち"],["の"],["うち"],["で"],["最も","もっとも"],["小さい","ちいさい"],["者","もの"],["で"],["ある"],["わたし"],["に"],["この"],["恵","めぐみ"],["が"],["与えられた","あたえられた"],["が"],["、"],["それ"],["は"],["、"],["キリスト"],["の"],["無尽蔵","むじんぞう"],["の"],["富","とみ"],["を"],["異邦人","いほうじん"],["に"],["宣べ伝え","のべつたえ"],["、"]]},{"verse":9,"text":"更,さらにまた、万物,ばんぶつの造,つくり主,しゅである神,かみの中,なかに世々,よよ隠,かくされていた奥義,おくぎにあずかる務,つとめがどんなものであるかを、明,あきらかに示,しめすためである。","tok":[["更に","さらに"],["また"],["、"],["万物","ばんぶつ"],["の"],["造主","つくりしゅ"],["で"],["ある"],["神","かみ"],["の"],["中","なか"],["に"],["世々","よ"],["よ"],["隠されて","かくされて"],["いた"],["奥義","おくぎ"],["に"],["あずかる"],["務め","つとめ"],["が"],["どんな"],["もの"],["で"],["ある"],["か"],["を"],["、"],["明か","あきらか"],["に"],["示めす","しめす"],["ため"],["で"],["ある"],["。"]]},{"verse":10,"text":"それは今,いま、天上,てんじょうにあるもろもろの支配,しはいや権威,けんいが、教会,きょうかいをとおして、神,かみの多種,たしゅ多様,たような知恵,ちえを知,しるに至,いたるためであって、","tok":[["それ"],["は"],["今","いま"],["、"],["天上","てんじょう"],["に"],["ある"],["もろもろ"],["の"],["支配","しはい"],["や"],["権威","けんい"],["が"],["、"],["教会","きょうかい"],["を"],["とおして"],["、"],["神","かみ"],["の"],["多種","たしゅ"],["多様","たよう"],["な"],["知恵","ちえ"],["を"],["知る","しる"],["に"],["至る","いたる"],["ため"],["で"],["あって"],["、"]]},{"verse":11,"text":"わたしたちの主,しゅキリスト・イエスにあって実現,じつげんされた神,かみの永遠,えいえんの目的,もくてきにそうものである。","tok":[["わたしたち"],["の"],["主","しゅ"],["キリスト"],["・"],["イエス"],["に"],["あって"],["実現","じつげん"],["された"],["神","かみ"],["の"],["永遠","えいえん"],["の"],["目的","もくてき"],["に"],["そう"],["もの"],["で"],["ある"],["。"]]},{"verse":12,"text":"この主,しゅキリストにあって、わたしたちは、彼,かれに対,たいする信仰,しんこうによって、確信,かくしんをもって大胆,だいたんに神,かみに近,ちかづくことができるのである。","tok":[["この"],["主","しゅ"],["キリスト"],["に"],["あって"],["、"],["わたしたち"],["は"],["、"],["彼","かれ"],["に"],["対する","たいする"],["信仰","しんこう"],["によって"],["、"],["確信","かくしん"],["を"],["もって"],["大胆","だいたん"],["に"],["神","かみ"],["に"],["近づく","ちかづく"],["こと"],["が"],["できる"],["ので"],["ある"],["。"]]},{"verse":13,"text":"だから、あなたがたのためにわたしが受,うけている患難,かんなんを見,みて、落胆,らくたんしないでいてもらいたい。わたしの患難,かんなんは、あなたがたの光栄,こうえいなのである。","tok":[["だ"],["から"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["わたし"],["が"],["受て","うけて"],["いる"],["患難","かんなん"],["を"],["見て","みて"],["、"],["落胆","らくたん"],["しないで"],["いて"],["もらいたい"],["。"],["わたし"],["の"],["患難","かんなん"],["は"],["、"],["あなた"],["がた"],["の"],["光栄","こうえい"],["な"],["ので"],["ある"],["。"]]},{"verse":14,"text":"こういうわけで、わたしはひざをかがめて、","tok":[["こう"],["いう"],["わけ"],["で"],["、"],["わたし"],["は"],["ひざ"],["を"],["かがめて"],["、"]]},{"verse":15,"text":"天上,てんじょうにあり地上,ちじょうにあって「父,ちち」と呼,よばれているあらゆるものの源,みなもとなる父,ちちに祈,いのる。","tok":[["天上","てんじょう"],["に"],["あり"],["地上","ちじょう"],["に"],["あって"],["「"],["父","ちち"],["」"],["と"],["呼ばれて","よばれて"],["いる"],["あらゆる"],["もの"],["の"],["源","みなもと"],["なる"],["父","ちち"],["に"],["祈る","いのる"],["。"]]},{"verse":16,"text":"どうか父,ちちが、その栄光,えいこうの富,とみにしたがい、御霊,みたまにより、力,ちからをもってあなたがたの内,うちなる人,ひとを強,つよくして下,くださるように、","tok":[["どう"],["か"],["父","ちち"],["が"],["、"],["その"],["栄光","えいこう"],["の"],["富","とみ"],["に"],["したがい"],["、"],["御霊","みたま"],["に"],["より"],["、"],["力","ちから"],["を"],["もって"],["あなた"],["がた"],["の"],["内","うち"],["なる"],["人","ひと"],["を"],["強く","つよく"],["して"],["下さる","くださる"],["よう"],["に"],["、"]]},{"verse":17,"text":"また、信仰,しんこうによって、キリストがあなたがたの心,こころのうちに住,すみ、あなたがたが愛,あいに根,ねざし愛,あいを基,もといとして生活,せいかつすることにより、","tok":[["また"],["、"],["信仰","しんこう"],["によって"],["、"],["キリスト"],["が"],["あなた"],["がた"],["の"],["心","こころ"],["の"],["うち"],["に"],["住み","すみ"],["、"],["あなた"],["がた"],["が"],["愛","あい"],["に"],["根ざし","ねざし"],["愛","あい"],["を"],["基い","もとい"],["として"],["生活","せいかつ"],["する"],["こと"],["に"],["より"],["、"]]},{"verse":18,"text":"すべての聖徒,せいとと共,ともに、その広,ひろさ、長,ながさ、高,たかさ、深,ふかさを理解,りかいすることができ、","tok":[["すべて"],["の"],["聖徒","せいと"],["と"],["共","とも"],["に"],["、"],["その"],["広さ","ひろさ"],["、"],["長さ","ながさ"],["、"],["高か","たか"],["さ"],["、"],["深さ","ふかさ"],["を"],["理解","りかい"],["する"],["こと"],["が"],["でき"],["、"]]},{"verse":19,"text":"また人知,じんちをはるかに越,こえたキリストの愛,あいを知,しって、神,かみに満,みちているもののすべてをもって、あなたがたが満,みたされるように、と祈,いのる。","tok":[["また"],["人知","じんち"],["を"],["はるか"],["に"],["越えた","こえた"],["キリスト"],["の"],["愛","あい"],["を"],["知って","しって"],["、"],["神","かみ"],["に"],["満ちて","みちて"],["いる"],["もの"],["の"],["すべて"],["を"],["もって"],["、"],["あなた"],["がた"],["が"],["満たされる","みたされる"],["よう"],["に"],["、"],["と"],["祈る","いのる"],["。"]]},{"verse":20,"text":"どうか、わたしたちのうちに働,はたらく力,ちからによって、わたしたちが求,もとめまた思,おもうところのいっさいを、はるかに越,こえてかなえて下,くださることができるかたに、","tok":[["どう"],["か"],["、"],["わたしたち"],["の"],["うち"],["に"],["働く","はたらく"],["力","ちから"],["によって"],["、"],["わたしたち"],["が"],["求め","もとめ"],["また"],["思う","おもう"],["ところ"],["の"],["いっさい"],["を"],["、"],["はるか"],["に"],["越えて","こえて"],["かなえて"],["下さる","くださる"],["こと"],["が"],["できる"],["かた"],["に"],["、"]]},{"verse":21,"text":"教会,きょうかいにより、また、キリスト・イエスによって、栄光,えいこうが世々,よよ限,かぎりなくあるように、アァメン。","tok":[["教会","きょうかい"],["に"],["より"],["、"],["また"],["、"],["キリスト"],["・"],["イエス"],["によって"],["、"],["栄光","えいこう"],["が"],["世々","よ"],["よ"],["限","かぎり"],["なく"],["ある"],["よう"],["に"],["、"],["アァメン"],["。"]]}]
[{"verse":1,"text":"神,かみの御旨,みむねによるキリスト・イエスの使徒,しとパウロから、エペソにいる、キリスト・イエスにあって忠実,ちゅうじつな聖徒,せいとたちへ。","tok":[["神","かみ"],["の"],["御旨","みむね"],["に"],["よる"],["キリスト"],["・"],["イエス"],["の"],["使徒","しと"],["パウロ"],["から"],["、"],["エペソ"],["に"],["いる"],["、"],["キリスト"],["・"],["イエス"],["に"],["あって"],["忠実","ちゅうじつ"],["な"],["聖徒","せいと"],["たち"],["へ"],["。"]]},{"verse":2,"text":"わたしたちの父,ちちなる神,かみと主,しゅイエス・キリストから、恵,めぐみと平安,へいあんとが、あなたがたにあるように。","tok":[["わたしたち"],["の"],["父","ちち"],["なる"],["神","かみ"],["と"],["主","しゅ"],["イエス"],["・"],["キリスト"],["から"],["、"],["恵","めぐみ"],["と"],["平安","へいあん"],["と"],["が"],["、"],["あなた"],["がた"],["に"],["ある"],["よう"],["に"],["。"]]},{"verse":3,"text":"ほむべきかな、わたしたちの主,しゅイエス・キリストの父,ちちなる神,かみ。神,かみはキリストにあって、天上,てんじょうで霊,れいのもろもろの祝福,しゅくふくをもって、わたしたちを祝福,しゅくふくし、","tok":[["ほ"],["むべき"],["か"],["な"],["、"],["わたしたち"],["の"],["主","しゅ"],["イエス"],["・"],["キリスト"],["の"],["父","ちち"],["なる"],["神","かみ"],["。"],["神","かみ"],["は"],["キリスト"],["に"],["あって"],["、"],["天上","てんじょう"],["で"],["霊","れい"],["の"],["もろもろ"],["の"],["祝福","しゅくふく"],["を"],["もって"],["、"],["わたしたち"],["を"],["祝福","しゅくふく"],["し"],["、"]]},{"verse":4,"text":"みまえにきよく傷,きずのない者,ものとなるようにと、天地,てんちの造,つくられる前,まえから、キリストにあってわたしたちを選,えらび、","tok":[["みまえ"],["に"],["きよく"],["傷","きず"],["の"],["ない"],["者","もの"],["と"],["なる"],["よう"],["に"],["と"],["、"],["天地","てんち"],["の"],["造られる","つくられる"],["前","まえ"],["から"],["、"],["キリスト"],["に"],["あって"],["わたしたち"],["を"],["選ら","えら"],["び"],["、"]]},{"verse":5,"text":"わたしたちに、イエス・キリストによって神,かみの子,こたる身分,みぶんを授,さづけるようにと、御旨,みむねのよしとするところに従,したがい、愛,あいのうちにあらかじめ定,さだめて下,くださったのである。","tok":[["わたしたち"],["に"],["、"],["イエス"],["・"],["キリスト"],["によって"],["神","かみ"],["の"],["子","こ"],["たる"],["身分","みぶん"],["を"],["授","さ"],["づける"],["よう"],["に"],["と"],["、"],["御旨","みむね"],["の"],["よし"],["と"],["する"],["ところ"],["に"],["従い","したがい"],["、"],["愛","あい"],["の"],["うち"],["に"],["あらかじめ"],["定めて","さだめて"],["下さった","くださった"],["ので"],["ある"],["。"]]},{"verse":6,"text":"これは、その愛,あいする御子,みこによって賜,たまわった栄光,えいこうある恵,めぐみを、わたしたちがほめたたえるためである。","tok":[["これ"],["は"],["、"],["その"],["愛する","あいする"],["御子","みこ"],["によって"],["賜わった","たまわった"],["栄光","えいこう"],["ある"],["恵","めぐみ"],["を"],["、"],["わたしたち"],["が"],["ほめたたえる"],["ため"],["で"],["ある"],["。"]]},{"verse":7,"text":"わたしたちは、御子,みこにあって、神,かみの豊,ゆたかな恵,めぐみのゆえに、その血,ちによるあがない、すなわち、罪過,ざいかのゆるしを受,うけたのである。","tok":[["わたしたち"],["は"],["、"],["御子","みこ"],["に"],["あって"],["、"],["神","かみ"],["の"],["豊","ゆたか"],["な"],["恵","めぐみ"],["の"],["ゆえ"],["に"],["、"],["その"],["血","ち"],["に"],["よる"],["あがない"],["、"],["すなわち"],["、"],["罪過","ざいか"],["の"],["ゆるし"],["を"],["受た","うけた"],["ので"],["ある"],["。"]]},{"verse":8,"text":"神,かみはその恵,めぐみをさらに増,まし加,くわえて、あらゆる知恵,ちえと悟,さとりとをわたしたちに賜,たまわり、","tok":[["神","かみ"],["は"],["その"],["恵","めぐみ"],["を"],["さらに"],["増し加えて","ましくわえて"],["、"],["あらゆる"],["知恵","ちえ"],["と"],["悟り","さとり"],["と"],["を"],["わたしたち"],["に"],["賜わり","たまわり"],["、"]]},{"verse":9,"text":"御旨,みむねの奥義,おくぎを、自,みずからあらかじめ定,さだめられた計画,けいかくに従,したがって、わたしたちに示,しめして下,くださったのである。","tok":[["御旨","みむね"],["の"],["奥義","おくぎ"],["を"],["、"],["自から","みずから"],["あらかじめ"],["定められた","さだめられた"],["計画","けいかく"],["に"],["従って","したがって"],["、"],["わたしたち"],["に"],["示めして","しめして"],["下さった","くださった"],["ので"],["ある"],["。"]]},{"verse":10,"text":"それは、時,ときの満,みちるに及,およんで実現,じつげんされるご計画,けいかくにほかならない。それによって、神,かみは天,てんにあるもの地,ちにあるものを、ことごとく、キリストにあって一つに帰,きせしめようとされたのである。","tok":[["それ"],["は"],["、"],["時","とき"],["の"],["満ちる","みちる"],["に"],["及んで","およんで"],["実現","じつげん"],["される"],["ご計画","ごけいかく"],["に"],["ほか"],["ならない"],["。"],["それ"],["によって"],["、"],["神","かみ"],["は"],["天","てん"],["に"],["ある"],["もの"],["地","ち"],["に"],["ある"],["もの"],["を"],["、"],["ことごとく"],["、"],["キリスト"],["に"],["あって"],["一","ひと"],["つ"],["に"],["帰せしめよう","きせしめよう"],["と"],["された"],["ので"],["ある"],["。"]]},{"verse":11,"text":"わたしたちは、御旨,みむねの欲,ほっするままにすべての事,ことをなさるかたの目的,もくてきの下,もとに、キリストにあってあらかじめ定,さだめられ、神,かみの民,たみとして選,えらばれたのである。","tok":[["わたしたち"],["は"],["、"],["御旨","みむね"],["の"],["欲する","ほっする"],["まま"],["に"],["すべて"],["の"],["事","こと"],["を"],["なさる"],["かた"],["の"],["目的","もくてき"],["の"],["下","もと"],["に"],["、"],["キリスト"],["に"],["あって"],["あらかじめ"],["定められ","さだめられ"],["、"],["神","かみ"],["の"],["民","たみ"],["として"],["選ら","えら"],["ばれた"],["ので"],["ある"],["。"]]},{"verse":12,"text":"それは、早,はやくからキリストに望,のぞみをおいているわたしたちが、神,かみの栄光,えいこうをほめたたえる者,ものとなるためである。","tok":[["それ"],["は"],["、"],["早く","はやく"],["から"],["キリスト"],["に"],["望み","のぞみ"],["を"],["おいて"],["いる"],["わたしたち"],["が"],["、"],["神","かみ"],["の"],["栄光","えいこう"],["を"],["ほめたたえる"],["者","もの"],["と"],["なる"],["ため"],["で"],["ある"],["。"]]},{"verse":13,"text":"あなたがたもまた、キリストにあって、真理,しんりの言葉,ことば、すなわち、あなたがたの救,すくいの福音,ふくいんを聞,きき、また、彼,かれを信,しんじた結果,けっか、約束,やくそくされた聖霊,せいれいの証印,しょういんをおされたのである。","tok":[["あなた"],["がた"],["も"],["また"],["、"],["キリスト"],["に"],["あって"],["、"],["真理","しんり"],["の"],["言葉","ことば"],["、"],["すなわち"],["、"],["あなた"],["がた"],["の"],["救い","すくい"],["の"],["福音","ふくいん"],["を"],["聞","きき"],["、"],["また"],["、"],["彼","かれ"],["を"],["信じた","しんじた"],["結果","けっか"],["、"],["約束","やくそく"],["された"],["聖霊","せいれい"],["の"],["証印","しょういん"],["を"],["おされた"],["ので"],["ある"],["。"]]},{"verse":14,"text":"この聖霊,せいれいは、わたしたちが神,かみの国,くにをつぐことの保証,ほしょうであって、やがて神,かみにつける者,ものが全,まったくあがなわれ、神,かみの栄光,えいこうをほめたたえるに至,いたるためである。","tok":[["この"],["聖霊","せいれい"],["は"],["、"],["わたしたち"],["が"],["神","かみ"],["の"],["国","くに"],["を"],["つぐ"],["こと"],["の"],["保証","ほしょう"],["で"],["あって"],["、"],["やがて"],["神","かみ"],["に"],["つける"],["者","もの"],["が"],["全く","まったく"],["あがなわれ"],["、"],["神","かみ"],["の"],["栄光","えいこう"],["を"],["ほめたたえる"],["に"],["至る","いたる"],["ため"],["で"],["ある"],["。"]]},{"verse":15,"text":"こういうわけで、わたしも、主,しゅイエスに対,たいするあなたがたの信仰,しんこうと、すべての聖徒,せいとに対,たいする愛,あいとを耳,みみにし、","tok":[["こう"],["いう"],["わけ"],["で"],["、"],["わたし"],["も"],["、"],["主","しゅ"],["イエス"],["に"],["対する","たいする"],["あなた"],["がた"],["の"],["信仰","しんこう"],["と"],["、"],["すべて"],["の"],["聖徒","せいと"],["に"],["対する","たいする"],["愛","あい"],["と"],["を"],["耳","みみ"],["に"],["し"],["、"]]},{"verse":16,"text":"わたしの祈,いのりのたびごとにあなたがたを覚,おぼえて、絶,たえずあなたがたのために感謝,かんしゃしている。","tok":[["わたし"],["の"],["祈","いのり"],["の"],["たび"],["ごと"],["に"],["あなた"],["がた"],["を"],["覚えて","おぼえて"],["、"],["絶えず","たえず"],["あなた"],["がた"],["の"],["ため"],["に"],["感謝","かんしゃ"],["して"],["いる"],["。"]]},{"verse":17,"text":"どうか、わたしたちの主,しゅイエス・キリストの神,かみ、栄光,えいこうの父,ちちが、知恵,ちえと啓示,けいじとの霊,れいをあなたがたに賜,たまわって神,かみを認,みとめさせ、","tok":[["どう"],["か"],["、"],["わたしたち"],["の"],["主","しゅ"],["イエス"],["・"],["キリスト"],["の"],["神","かみ"],["、"],["栄光","えいこう"],["の"],["父","ちち"],["が"],["、"],["知恵","ちえ"],["と"],["啓示","けいじ"],["と"],["の"],["霊","れい"],["を"],["あなた"],["がた"],["に"],["賜わって","たまわって"],["神","かみ"],["を"],["認めさせ","みとめさせ"],["、"]]},{"verse":18,"text":"あなたがたの心,こころの目,めを明,あきらかにして下,くださるように、そして、あなたがたが神,かみに召,めされていだいている望,のぞみがどんなものであるか、聖徒,せいとたちがつぐべき神,かみの国,くにがいかに栄光,えいこうに富,とんだものであるか、","tok":[["あなた"],["がた"],["の"],["心","こころ"],["の"],["目","め"],["を"],["明か","あきらか"],["に"],["して"],["下さる","くださる"],["よう"],["に"],["、"],["そして"],["、"],["あなた"],["がた"],["が"],["神","かみ"],["に"],["召されて","めされて"],["いだいて"],["いる"],["望み","のぞみ"],["が"],["どんな"],["もの"],["で"],["ある"],["か"],["、"],["聖徒","せいと"],["たち"],["が"],["つぐべき"],["神","かみ"],["の"],["国","くに"],["が"],["いかに"],["栄光","えいこう"],["に"],["富","とんだも"],["ので"],["ある"],["か"],["、"]]},{"verse":19,"text":"また、神,かみの力強,ちからづよい活動,かつどうによって働,はたらく力,ちからが、わたしたち信,しんじる者,ものにとっていかに絶大,ぜつだいなものであるかを、あなたがたが知,しるに至,いたるように、と祈,いのっている。","tok":[["また"],["、"],["神","かみ"],["の"],["力強い","ちからづよい"],["活動","かつどう"],["によって"],["働く","はたらく"],["力","ちから"],["が"],["、"],["わたしたち"],["信じる","しんじる"],["者","もの"],["にとって"],["いかに"],["絶大","ぜつだい"],["な"],["もの"],["で"],["ある"],["か"],["を"],["、"],["あなた"],["がた"],["が"],["知る","しる"],["に"],["至る","いたる"],["よう"],["に"],["、"],["と"],["祈って","いのって"],["いる"],["。"]]},{"verse":20,"text":"神,かみはその力,ちからをキリストのうちに働,はたらかせて、彼,かれを死人,しにんの中,なかからよみがえらせ、天上,てんじょうにおいてご自分,じぶんの右,みぎに座,ざせしめ、","tok":[["神","かみ"],["は"],["その"],["力","ちから"],["を"],["キリスト"],["の"],["うち"],["に"],["働かせて","はたらかせて"],["、"],["彼","かれ"],["を"],["死人","しにん"],["の"],["中","なか"],["から"],["よみがえらせ"],["、"],["天上","てんじょう"],["に"],["おいて"],["ご自分","ごじぶん"],["の"],["右","みぎ"],["に"],["座せしめ","ざせしめ"],["、"]]},{"verse":21,"text":"彼,かれを、すべての支配,しはい、権威,けんい、権力,けんりょく、権勢,けんせいの上,うえにおき、また、この世,よばかりでなくきたるべき世,よにおいても唱,となえられる、あらゆる名,なの上,うえにおかれたのである。","tok":[["彼","かれ"],["を"],["、"],["すべて"],["の"],["支配","しはい"],["、"],["権威","けんい"],["、"],["権力","けんりょく"],["、"],["権勢","けんせい"],["の"],["上","うえ"],["に"],["おき"],["、"],["また"],["、"],["この世","このよ"],["ばかり"],["で"],["なく"],["きたるべき"],["世","よ"],["に"],["おいて"],["も"],["唱えられる","となえられる"],["、"],["あらゆる"],["名","な"],["の"],["上","うえ"],["に"],["おかれた"],["ので"],["ある"],["。"]]},{"verse":22,"text":"そして、万物,ばんぶつをキリストの足,あしの下,したに従,したがわせ、彼,かれを万物,ばんぶつの上,うえにかしらとして教会,きょうかいに与,あたえられた。","tok":[["そして"],["、"],["万物","ばんぶつ"],["を"],["キリスト"],["の"],["足","あし"],["の"],["下","した"],["に"],["従わせ","したがわせ"],["、"],["彼","かれ"],["を"],["万物","ばんぶつ"],["の"],["上","うえ"],["に"],["かしら"],["として"],["教会","きょうかい"],["に"],["与えられた","あたえられた"],["。"]]},{"verse":23,"text":"この教会,きょうかいはキリストのからだであって、すべてのものを、すべてのもののうちに満,みたしているかたが、満,みちみちているものに、ほかならない。","tok":[["この"],["教会","きょうかい"],["は"],["キリスト"],["の"],["からだ"],["で"],["あって"],["、"],["すべて"],["の"],["もの"],["を"],["、"],["すべて"],["の"],["もの"],["の"],["うち"],["に"],["満たして","みたして"],["いる"],["か"],["た"],["が"],["、"],["満ちみちて","みちみちて"],["いる"],["もの"],["に"],["、"],["ほか"],["ならない"],["。"]]}]
[{"verse":1,"text":"さて、主,しゅにある囚人,しゅうじんであるわたしは、あなたがたに勧,すすめる。あなたがたが召,めされたその召,めしにふさわしく歩,あるき、","tok":[["さて"],["、"],["主に","しゅに"],["ある"],["囚人","しゅうじん"],["で"],["ある"],["わたし"],["は"],["、"],["あなた"],["がた"],["に"],["勧める","すすめる"],["。"],["あなた"],["がた"],["が"],["召された","めされた"],["その"],["召","めし"],["に"],["ふさわしく"],["歩き","あるき"],["、"]]},{"verse":2,"text":"できる限,かぎり謙虚,けんきょで、かつ柔和,にゅうわであり、寛容,かんようを示,しめし、愛,あいをもって互,たがいに忍,しのびあい、","tok":[["できる"],["限","かぎり"],["謙虚","けんきょ"],["で"],["、"],["かつ"],["柔和","にゅうわ"],["で"],["あり"],["、"],["寛容","かんよう"],["を"],["示めし","しめし"],["、"],["愛","あい"],["を"],["もって"],["互","たがい"],["に"],["忍び","しのび"],["あい"],["、"]]},{"verse":3,"text":"平和,へいわのきずなで結,むすばれて、聖霊,せいれいによる一致,いっちを守,まもり続,つづけるように努,つとめなさい。","tok":[["平和","へいわ"],["の"],["きずな"],["で"],["結ばれて","むすばれて"],["、"],["聖霊","せいれい"],["に"],["よる"],["一致","いっち"],["を"],["守り","まもり"],["続ける","つづける"],["よう"],["に"],["努め","つとめ"],["なさい"],["。"]]},{"verse":4,"text":"からだは一つ、御霊,みたまも一つである。あなたがたが召,めされたのは、一つの望,のぞみを目,めざして召,めされたのと同様,どうようである。","tok":[["からだ"],["は"],["一","ひと"],["つ"],["、"],["御霊","みたま"],["も"],["一","ひと"],["つ"],["で"],["ある"],["。"],["あなた"],["がた"],["が"],["召された","めされた"],["の"],["は"],["、"],["一","ひと"],["つ"],["の"],["望み","のぞみ"],["を"],["目ざして","めざして"],["召された","めされた"],["の"],["と"],["同様","どうよう"],["で"],["ある"],["。"]]},{"verse":5,"text":"主,しゅは一つ、信仰,しんこうは一つ、バプテスマは一つ。","tok":[["主","しゅ"],["は"],["一","ひと"],["つ"],["、"],["信仰","しんこう"],["は"],["一","ひと"],["つ"],["、"],["バプテスマ"],["は"],["一","ひと"],["つ"],["。"]]},{"verse":6,"text":"すべてのものの上,うえにあり、すべてのものを貫,つらぬき、すべてのものの内,うちにいます、すべてのものの父,ちちなる神,かみは一つである。","tok":[["すべて"],["の"],["もの"],["の"],["上","うえ"],["に"],["あり"],["、"],["すべて"],["の"],["もの"],["を"],["貫ぬき","つらぬき"],["、"],["すべて"],["の"],["もの"],["の"],["内","うち"],["に"],["います"],["、"],["すべて"],["の"],["もの"],["の"],["父","ちち"],["なる"],["神","かみ"],["は"],["一","ひと"],["つ"],["で"],["ある"],["。"]]},{"verse":7,"text":"しかし、キリストから賜,たまわる賜物,たまもののはかりに従,したがって、わたしたちひとりびとりに、恵,めぐみが与,あたえられている。","tok":[["しかし"],["、"],["キリスト"],["から"],["賜わる","たまわる"],["賜物","たまもの"],["の"],["はかり"],["に"],["従って","したがって"],["、"],["わたしたち"],["ひとりびとり"],["に"],["、"],["恵","めぐみ"],["が"],["与えられて","あたえられて"],["いる"],["。"]]},{"verse":8,"text":"そこで、こう言,いわれている、「彼,かれは高,たかいところに上,のぼった時,とき、とりこを捕,とらえて引,ひき行,ゆき、人々,ひとびとに賜物,たまものを分,わけ与,あたえた」。","tok":[["そこ"],["で"],["、"],["こう"],["言われて","いわれて"],["いる"],["、"],["「"],["彼","かれ"],["は"],["高かい","たかい"],["ところ"],["に"],["上った","のぼった"],["時","とき"],["、"],["とりこ"],["を"],["捕らえて","とらえて"],["引","ひき"],["行き","ゆき"],["、"],["人々","ひとびと"],["に"],["賜物","たまもの"],["を"],["分け","わけ"],["与","あたえ"],["た"],["」"],["。"]]},{"verse":9,"text":"さて「上,のぼった」と言,いう以上,いじょう、また地下,ちかの低,ひくい底,そこにも降,おりてこられたわけではないか。","tok":[["さて"],["「"],["上った","のぼった"],["」"],["と"],["言う","いう"],["以上","いじょう"],["、"],["また"],["地下","ちか"],["の"],["低い","ひくい"],["底","そこ"],["に"],["も"],["降りて","おりて"],["こられた"],["わけ"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":10,"text":"降,おりてこられた者,もの自身,じしんは、同時,どうじに、あらゆるものに満,みちるために、もろもろの天,てんの上,うえにまで上,のぼられたかたなのである。","tok":[["降りて","おりて"],["こられた"],["者","もの"],["自身","じしん"],["は"],["、"],["同時","どうじ"],["に"],["、"],["あらゆる"],["もの"],["に"],["満ちる","みちる"],["ため"],["に"],["、"],["もろもろ"],["の"],["天","てん"],["の"],["上","うえ"],["に"],["まで"],["上られた","のぼられた"],["かた"],["な"],["ので"],["ある"],["。"]]},{"verse":11,"text":"そして彼,かれは、ある人,ひとを使徒,しととし、ある人,ひとを預言者,よげんしゃとし、ある人,ひとを伝道者,でんどうしゃとし、ある人,ひとを牧師,ぼくし、教師,きょうしとして、お立,たてになった。","tok":[["そして"],["彼","かれ"],["は"],["、"],["ある"],["人","ひと"],["を"],["使徒","しと"],["と"],["し"],["、"],["ある"],["人","ひと"],["を"],["預言者","よげんしゃ"],["と"],["し"],["、"],["ある"],["人","ひと"],["を"],["伝道者","でんどうしゃ"],["と"],["し"],["、"],["ある"],["人","ひと"],["を"],["牧師","ぼくし"],["、"],["教師","きょうし"],["として"],["、"],["お立","おたて"],["に"],["なった"],["。"]]},{"verse":12,"text":"それは、聖徒,せいとたちをととのえて奉仕,ほうしのわざをさせ、キリストのからだを建,たてさせ、","tok":[["それ"],["は"],["、"],["聖徒","せいと"],["たち"],["を"],["ととのえて"],["奉仕","ほうし"],["の"],["わざ"],["を"],["させ"],["、"],["キリスト"],["の"],["からだ"],["を"],["建てさせ","たてさせ"],["、"]]},{"verse":13,"text":"わたしたちすべての者,ものが、神,かみの子,こを信,しんじる信仰,しんこうの一致,いっちと彼,かれを知,しる知識,ちしきの一致,いっちとに到達,とうたつし、全,まったき人,ひととなり、ついに、キリストの満,みちみちた徳,とくの高,たかさにまで至,いたるためである。","tok":[["わたしたち"],["すべて"],["の"],["者","もの"],["が"],["、"],["神","かみ"],["の"],["子","こ"],["を"],["信じる","しんじる"],["信仰","しんこう"],["の"],["一致","いっち"],["と"],["彼","かれ"],["を"],["知る","しる"],["知識","ちしき"],["の"],["一致","いっち"],["と"],["に"],["到達","とうたつ"],["し"],["、"],["全","ま"],["っ"],["たき人","たきひと"],["と"],["なり"],["、"],["ついに"],["、"],["キリスト"],["の"],["満ちみちた","みちみちた"],["徳","とく"],["の"],["高さ","たかさ"],["に"],["まで"],["至る","いたる"],["ため"],["で"],["ある"],["。"]]},{"verse":14,"text":"こうして、わたしたちはもはや子供,こどもではないので、だまし惑,まどわす策略,さくりゃくにより、人々,ひとびとの悪巧,わるだくみによって起,おこる様々,さまざまな教,おしえの風,かぜに吹,ふきまわされたり、もてあそばれたりすることがなく、","tok":[["こう"],["して"],["、"],["わたしたち"],["は"],["もはや"],["子供","こども"],["で"],["は"],["ない"],["ので"],["、"],["だまし"],["惑わす","まどわす"],["策略","さくりゃく"],["に"],["より"],["、"],["人々","ひとびと"],["の"],["悪巧み","わるだくみ"],["によって"],["起こる","おこる"],["様々","さまざま"],["な"],["教え","おしえ"],["の"],["風","かぜ"],["に"],["吹","ふき"],["まわされ"],["たり"],["、"],["もてあそばれ"],["たり"],["する"],["こと"],["が"],["なく"],["、"]]},{"verse":15,"text":"愛,あいにあって真理,しんりを語,かたり、あらゆる点,てんにおいて成長,せいちょうし、かしらなるキリストに達,たっするのである。","tok":[["愛","あい"],["に"],["あって"],["真理","しんり"],["を"],["語り","かたり"],["、"],["あらゆる"],["点","てん"],["に"],["おいて"],["成長","せいちょう"],["し"],["、"],["かしら"],["なる"],["キリスト"],["に"],["達する","たっする"],["ので"],["ある"],["。"]]},{"verse":16,"text":"また、キリストを基,もといとして、全身,ぜんしんはすべての節々,ふしぶしの助,たすけにより、しっかりと組,くみ合,あわされ結,むすび合,あわされ、それぞれの部分,ぶぶんは分,ぶんに応,おうじて働,はたらき、からだを成長,せいちょうさせ、愛,あいのうちに育,そだてられていくのである。","tok":[["また"],["、"],["キリスト"],["を"],["基い","もとい"],["として"],["、"],["全身","ぜんしん"],["は"],["すべて"],["の"],["節々","ふしぶし"],["の"],["助け","たすけ"],["に"],["より"],["、"],["しっかり"],["と"],["組合わされ","くみあわされ"],["結び合わされ","むすびあわされ"],["、"],["それぞれ"],["の"],["部分","ぶぶん"],["は"],["分","ぶん"],["に"],["応じて","おうじて"],["働らき","はたらき"],["、"],["からだ"],["を"],["成長","せいちょう"],["させ"],["、"],["愛","あい"],["の"],["うち"],["に"],["育てられて","そだてられて"],["いく"],["ので"],["ある"],["。"]]},{"verse":17,"text":"そこで、わたしは主,しゅにあっておごそかに勧,すすめる。あなたがたは今後,こんご、異邦人,いほうじんがむなしい心,こころで歩,あるいているように歩,あるいてはならない。","tok":[["そこ"],["で"],["、"],["わたし"],["は"],["主に","しゅに"],["あって"],["おごそか"],["に"],["勧める","すすめる"],["。"],["あなた"],["がた"],["は"],["今後","こんご"],["、"],["異邦人","いほうじん"],["が"],["むなしい"],["心","こころ"],["で"],["歩いて","あるいて"],["いる"],["よう"],["に"],["歩いて","あるいて"],["は"],["ならない"],["。"]]},{"verse":18,"text":"彼,かれらの知力,ちりょくは暗,くらくなり、その内,うちなる無知,むちと心,こころの硬化,こうかとにより、神,かみのいのちから遠,とおく離,はなれ、","tok":[["彼","かれ"],["ら"],["の"],["知力","ちりょく"],["は"],["暗く","くらく"],["なり"],["、"],["その"],["内","うち"],["なる"],["無知","むち"],["と"],["心","こころ"],["の"],["硬化","こうか"],["と"],["に"],["より"],["、"],["神","かみ"],["の"],["いのち"],["から"],["遠く","とおく"],["離れ","はなれ"],["、"]]},{"verse":19,"text":"自,みずから無感覚,むかんかくになって、ほしいままにあらゆる不潔,ふけつな行,おこないをして、放縦,ほうじゅうに身,みをゆだねている。","tok":[["自から","みずから"],["無感覚","むかんかく"],["に"],["なって"],["、"],["ほしいまま"],["に"],["あらゆる"],["不潔","ふけつ"],["な"],["行ない","おこない"],["を"],["して"],["、"],["放縦","ほうじゅう"],["に"],["身","み"],["を"],["ゆだねて"],["いる"],["。"]]},{"verse":20,"text":"しかしあなたがたは、そのようにキリストに学,まなんだのではなかった。","tok":[["しかし"],["あなた"],["がた"],["は"],["、"],["その"],["よう"],["に"],["キリスト"],["に"],["学","まなんだ"],["ので"],["は"],["なかった"],["。"]]},{"verse":21,"text":"あなたがたはたしかに彼,かれに聞,きき、彼,かれにあって教,おしえられて、イエスにある真理,しんりをそのまま学,まなんだはずである。","tok":[["あなた"],["がた"],["は"],["たしか"],["に"],["彼","かれ"],["に"],["聞","きき"],["、"],["彼","かれ"],["に"],["あって"],["教えられて","おしえられて"],["、"],["イエス"],["に"],["ある"],["真理","しんり"],["を"],["そのまま"],["学んだ","まなんだ"],["はず"],["で"],["ある"],["。"]]},{"verse":22,"text":"すなわち、あなたがたは、以前,いぜんの生活,せいかつに属,ぞくする、情欲,じょうよくに迷,まよって滅,ほろび行,いく古,ふるき人,ひとを脱,ぬぎ捨,すて、","tok":[["すなわち"],["、"],["あなた"],["がた"],["は"],["、"],["以前","いぜん"],["の"],["生活","せいかつ"],["に"],["属する","ぞくする"],["、"],["情欲","じょうよく"],["に"],["迷って","まよって"],["滅び","ほろび"],["行く","いく"],["古き","ふるき"],["人","ひと"],["を"],["脱ぎ捨て","ぬぎすて"],["、"]]},{"verse":23,"text":"心,こころの深,ふかみまで新,あらたにされて、","tok":[["心","こころ"],["の"],["深み","ふかみ"],["まで"],["新らた","あらた"],["に"],["されて"],["、"]]},{"verse":24,"text":"真,しんの義,ぎと聖,せいとをそなえた神,かみにかたどって造,つくられた新,あたらしき人,ひとを着,きるべきである。","tok":[["真","しん"],["の"],["義","ぎ"],["と"],["聖","せい"],["と"],["を"],["そなえた"],["神","かみ"],["に"],["かたどって"],["造られた","つくられた"],["新らしき","あたらしき"],["人","ひと"],["を"],["着るべきで","きるべきで"],["ある"],["。"]]},{"verse":25,"text":"こういうわけだから、あなたがたは偽,いつわりを捨,すてて、おのおの隣,となり人,ひとに対,たいして、真実,しんじつを語,かたりなさい。わたしたちは、お互,たがいに肢体,したいなのであるから。","tok":[["こう"],["いう"],["わけ"],["だ"],["から"],["、"],["あなた"],["がた"],["は"],["偽り","いつわり"],["を"],["捨てて","すてて"],["、"],["おのおの"],["隣人","となりひと"],["に対して","にたいして"],["、"],["真実","しんじつ"],["を"],["語り","かたり"],["なさい"],["。"],["わたしたち"],["は"],["、"],["お互","おたがい"],["に"],["肢体","したい"],["な"],["ので"],["ある"],["から"],["。"]]},{"verse":26,"text":"怒,いかることがあっても、罪,つみを犯,おかしてはならない。憤,いきどおったままで、日,ひが暮,くれるようであってはならない。","tok":[["怒","いかるこ"],["と"],["が"],["あって"],["も"],["、"],["罪","つみ"],["を"],["犯して","おかして"],["は"],["ならない"],["。"],["憤った","いきどおった"],["まま"],["で"],["、"],["日","ひ"],["が"],["暮","くれ"],["る"],["よう"],["で"],["あって"],["は"],["ならない"],["。"]]},{"verse":27,"text":"また、悪魔,あくまに機会,きかいを与,あたえてはいけない。","tok":[["また"],["、"],["悪魔","あくま"],["に"],["機会","きかい"],["を"],["与","あたえ"],["ては"],["いけない"],["。"]]},{"verse":28,"text":"盗,ぬすんだ者,ものは、今後,こんご、盗,ぬすんではならない。むしろ、貧,まずしい人々,ひとびとに分,わけ与,あたえるようになるために、自分,じぶんの手,てで正当,せいとうな働,はたらきをしなさい。","tok":[["盗","ぬ"],["すんだ"],["者","もの"],["は"],["、"],["今後","こんご"],["、"],["盗","ぬすん"],["で"],["は"],["ならない"],["。"],["むしろ"],["、"],["貧しい","まずしい"],["人々","ひとびと"],["に"],["分け与える","わけあたえる"],["よう"],["に"],["なる"],["ため"],["に"],["、"],["自分","じぶん"],["の"],["手","て"],["で"],["正当","せいとう"],["な"],["働らき","はたらき"],["を"],["し"],["なさい"],["。"]]},{"verse":29,"text":"悪,わるい言葉,ことばをいっさい、あなたがたの口,くちから出,だしてはいけない。必要,ひつようがあれば、人,ひとの徳,とくを高,たかめるのに役立,やくだつような言葉,ことばを語,かたって、聞,きいている者,ものの益,えきになるようにしなさい。","tok":[["悪い","わるい"],["言葉","ことば"],["を"],["いっさい"],["、"],["あなた"],["がた"],["の"],["口","くち"],["から"],["出して","だして"],["は"],["いけない"],["。"],["必要","ひつよう"],["が"],["あれば"],["、"],["人","ひと"],["の"],["徳","とく"],["を"],["高める","たかめる"],["のに"],["役立つ","やくだつ"],["よう"],["な"],["言葉","ことば"],["を"],["語って","かたって"],["、"],["聞いて","きいて"],["いる"],["者","もの"],["の"],["益","えき"],["に"],["なる"],["よう"],["に"],["し"],["なさい"],["。"]]},{"verse":30,"text":"神,かみの聖霊,せいれいを悲,かなしませてはいけない。あなたがたは、あがないの日,ひのために、聖霊,せいれいの証印,しょういんを受,うけたのである。","tok":[["神","かみ"],["の"],["聖霊","せいれい"],["を"],["悲しませて","かなしませて"],["は"],["いけない"],["。"],["あなた"],["がた"],["は"],["、"],["あがない"],["の"],["日","ひ"],["の"],["ため"],["に"],["、"],["聖霊","せいれい"],["の"],["証印","しょういん"],["を"],["受た","うけた"],["ので"],["ある"],["。"]]},{"verse":31,"text":"すべての無慈悲,むじひ、憤,いきどおり、怒,いかり、騒,さわぎ、そしり、また、いっさいの悪意,あくいを捨,すて去,さりなさい。","tok":[["すべて"],["の"],["無慈悲","むじひ"],["、"],["憤り","いきどおり"],["、"],["怒り","いかり"],["、"],["騒","さわぎ"],["、"],["そしり"],["、"],["また"],["、"],["いっさい"],["の"],["悪意","あくい"],["を"],["捨て去り","すてさり"],["なさい"],["。"]]},{"verse":32,"text":"互,たがいに情深,なさけぶかく、あわれみ深,ぶかい者,ものとなり、神,かみがキリストにあってあなたがたをゆるして下,くださったように、あなたがたも互,たがいにゆるし合,あいなさい。","tok":[["互","たがい"],["に"],["情深く","なさけぶかく"],["、"],["あわれみ"],["深い","ぶかい"],["者","もの"],["と"],["なり"],["、"],["神","かみ"],["が"],["キリスト"],["に"],["あって"],["あなた"],["がた"],["を"],["ゆるして"],["下さった","くださった"],["よう"],["に"],["、"],["あなた"],["がた"],["も"],["互","たがい"],["に"],["ゆるし"],["合い","あい"],["なさい"],["。"]]}]
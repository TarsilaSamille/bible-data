[{"verse":1,"text":"さてあなたがたは、先,さきには自分,じぶんの罪過,ざいかと罪,つみとによって死,しんでいた者,ものであって、","tok":[["さて"],["あなた"],["がた"],["は"],["、"],["先","さき"],["に"],["は"],["自分","じぶん"],["の"],["罪過","ざいか"],["と"],["罪","つみ"],["と"],["によって"],["死んで","しんで"],["いた"],["者","もの"],["で"],["あって"],["、"]]},{"verse":2,"text":"かつてはそれらの中,なかで、この世,よのならわしに従,したがい、空中,くうちゅうの権,けんをもつ君,きみ、すなわち、不,ふ従順,じゅうじゅんの子,こらの中,なかに今,いまも働,はたらいている霊,れいに従,したがって、歩,あるいていたのである。","tok":[["かつて"],["は"],["それ"],["ら"],["の"],["中","なか"],["で"],["、"],["この世","このよ"],["の"],["ならわし"],["に"],["従い","したがい"],["、"],["空中","くうちゅう"],["の"],["権","けん"],["を"],["もつ"],["君","きみ"],["、"],["すなわち"],["、"],["不","ふ"],["従順","じゅうじゅん"],["の"],["子","こ"],["ら"],["の"],["中","なか"],["に"],["今","いま"],["も"],["働いて","はたらいて"],["いる"],["霊","れい"],["に"],["従って","したがって"],["、"],["歩いて","あるいて"],["いた"],["ので"],["ある"],["。"]]},{"verse":3,"text":"また、わたしたちもみな、かつては彼,かれらの中,なかにいて、肉,にくの欲,よくに従,したがって日,ひを過,すごし、肉,にくとその思,おもいとの欲,ほっするままを行,おこない、ほかの人々,ひとびとと同,おなじく、生,うまれながらの怒,いかりの子,こであった。","tok":[["また"],["、"],["わたしたち"],["も"],["みな"],["、"],["かつて"],["は"],["彼","かれ"],["ら"],["の"],["中","なか"],["に"],["いて"],["、"],["肉","にく"],["の"],["欲","よく"],["に"],["従って","したがって"],["日","ひ"],["を"],["過ごし","すごし"],["、"],["肉","にく"],["と"],["その"],["思い","おもい"],["と"],["の"],["欲する","ほっする"],["まま"],["を"],["行ない","おこない"],["、"],["ほか"],["の"],["人々","ひとびと"],["と"],["同じく","おなじく"],["、"],["生まれ","うまれ"],["ながら"],["の"],["怒り","いかり"],["の"],["子","こ"],["で"],["あった"],["。"]]},{"verse":4,"text":"しかるに、あわれみに富,とむ神,かみは、わたしたちを愛,あいして下,くださったその大,おおきな愛,あいをもって、","tok":[["しかる"],["に"],["、"],["あわれみ"],["に"],["富む","とむ"],["神","かみ"],["は"],["、"],["わたしたち"],["を"],["愛して","あいして"],["下さった","くださった"],["その"],["大きな","おおきな"],["愛","あい"],["を"],["もって"],["、"]]},{"verse":5,"text":"罪過,ざいかによって死,しんでいたわたしたちを、キリストと共,ともに生,いかし――あなたがたの救,すくわれたのは、恵,めぐみによるのである――","tok":[["罪過","ざいか"],["によって"],["死んで","しんで"],["いた"],["わたしたち"],["を"],["、"],["キリスト"],["と"],["共","とも"],["に"],["生かし","いかし"],["―"],["―"],["あなた"],["がた"],["の"],["救われた","すくわれた"],["の"],["は"],["、"],["恵","めぐみ"],["に"],["よる"],["ので"],["ある"],["―"],["―"]]},{"verse":6,"text":"キリスト・イエスにあって、共,ともによみがえらせ、共,ともに天上,てんじょうで座,ざにつかせて下,くださったのである。","tok":[["キリスト"],["・"],["イエス"],["に"],["あって"],["、"],["共","とも"],["に"],["よみがえらせ"],["、"],["共","とも"],["に"],["天上","てんじょう"],["で"],["座","ざ"],["に"],["つかせて"],["下さった","くださった"],["ので"],["ある"],["。"]]},{"verse":7,"text":"それは、キリスト・イエスにあってわたしたちに賜,たまわった慈愛,じあいによる神,かみの恵,めぐみの絶大,ぜつだいな富,とみを、きたるべき世々,よよに示,しめすためであった。","tok":[["それ"],["は"],["、"],["キリスト"],["・"],["イエス"],["に"],["あって"],["わたしたち"],["に"],["賜わった","たまわった"],["慈愛","じあい"],["に"],["よる"],["神","かみ"],["の"],["恵","めぐみ"],["の"],["絶大","ぜつだい"],["な"],["富","とみ"],["を"],["、"],["きたるべき"],["世々","よよ"],["に"],["示めす","しめす"],["ため"],["で"],["あった"],["。"]]},{"verse":8,"text":"あなたがたの救,すくわれたのは、実,じつに、恵,めぐみにより、信仰,しんこうによるのである。それは、あなたがた自身,じしんから出,でたものではなく、神,かみの賜物,たまものである。","tok":[["あなた"],["がた"],["の"],["救われた","すくわれた"],["の"],["は"],["、"],["実","じつ"],["に"],["、"],["恵","めぐみ"],["に"],["より"],["、"],["信仰","しんこう"],["に"],["よる"],["ので"],["ある"],["。"],["それ"],["は"],["、"],["あなた"],["がた"],["自身","じしん"],["から"],["出た","でた"],["もの"],["で"],["は"],["なく"],["、"],["神","かみ"],["の"],["賜物","たまもの"],["で"],["ある"],["。"]]},{"verse":9,"text":"決,けっして行,おこないによるのではない。それは、だれも誇,ほこることがないためなのである。","tok":[["決っして","けっして"],["行ない","おこない"],["に"],["よる"],["ので"],["は"],["ない"],["。"],["それ"],["は"],["、"],["だれ"],["も"],["誇る","ほこる"],["こと"],["が"],["ない"],["ため"],["な"],["ので"],["ある"],["。"]]},{"verse":10,"text":"わたしたちは神,かみの作品,さくひんであって、良,よい行,おこないをするように、キリスト・イエスにあって造,つくられたのである。神,かみは、わたしたちが、良,よい行,おこないをして日,ひを過,すごすようにと、あらかじめ備,そなえて下,くださったのである。","tok":[["わたしたち"],["は"],["神","かみ"],["の"],["作品","さくひん"],["で"],["あって"],["、"],["良い","よい"],["行ない","おこない"],["を"],["する"],["よう"],["に"],["、"],["キリスト"],["・"],["イエス"],["に"],["あって"],["造られた","つくられた"],["ので"],["ある"],["。"],["神","かみ"],["は"],["、"],["わたしたち"],["が"],["、"],["良い","よい"],["行ない","おこない"],["を"],["して"],["日","ひ"],["を"],["過ごす","すごす"],["よう"],["に"],["と"],["、"],["あらかじめ"],["備","そなえ"],["て"],["下さった","くださった"],["ので"],["ある"],["。"]]},{"verse":11,"text":"だから、記憶,きおくしておきなさい。あなたがたは以前,いぜんには、肉,にくによれば異邦人,いほうじんであって、手,てで行,おこなった肉,にくの割礼,かつれいある者,ものと称,しょうせられる人々,ひとびとからは、無,む割礼,かつれいの者,ものと呼,よばれており、","tok":[["だ"],["から"],["、"],["記憶","きおく"],["して"],["おき"],["なさい"],["。"],["あなた"],["がた"],["は"],["以前","いぜん"],["に"],["は"],["、"],["肉","にく"],["に"],["よれば"],["異邦人","いほうじん"],["で"],["あって"],["、"],["手","て"],["で"],["行なった","おこなった"],["肉","にく"],["の"],["割礼","かつれい"],["ある"],["者","もの"],["と"],["称せられる","しょうせられる"],["人々","ひとびと"],["から"],["は"],["、"],["無","む"],["割礼","かつれい"],["の"],["者","もの"],["と"],["呼ばれて","よばれて"],["おり"],["、"]]},{"verse":12,"text":"またその当時,とうじは、キリストを知,しらず、イスラエルの国籍,こくせきがなく、約束,やくそくされたいろいろの契約,けいやくに縁,えんがなく、この世,よの中,なかで希望,きぼうもなく神,かみもない者,ものであった。","tok":[["また"],["その"],["当時","とうじ"],["は"],["、"],["キリスト"],["を"],["知らず","しらず"],["、"],["イスラエル"],["の"],["国籍","こくせき"],["が"],["なく"],["、"],["約束","やくそく"],["された"],["いろいろ"],["の"],["契約","けいやく"],["に"],["縁","えん"],["が"],["なく"],["、"],["この"],["世の中","よのなか"],["で"],["希望","きぼう"],["も"],["なく"],["神","かみ"],["も"],["ない"],["者","もの"],["で"],["あった"],["。"]]},{"verse":13,"text":"ところが、あなたがたは、このように以前,いぜんは遠,とおく離,はなれていたが、今,いまではキリスト・イエスにあって、キリストの血,ちによって近,ちかいものとなったのである。","tok":[["ところ"],["が"],["、"],["あなた"],["がた"],["は"],["、"],["この"],["よう"],["に"],["以前","いぜん"],["は"],["遠く","とおく"],["離れて","はなれて"],["いた"],["が"],["、"],["今","いま"],["で"],["は"],["キリスト"],["・"],["イエス"],["に"],["あって"],["、"],["キリスト"],["の"],["血","ち"],["によって"],["近い","ちかい"],["もの"],["と"],["なった"],["ので"],["ある"],["。"]]},{"verse":14,"text":"キリストはわたしたちの平和,へいわであって、二つのものを一つにし、敵意,てきいという隔,へだての中垣,なかがきを取,とり除,のぞき、ご自分,じぶんの肉,にくによって、","tok":[["キリスト"],["は"],["わたしたち"],["の"],["平和","へいわ"],["で"],["あって"],["、"],["二","ふた"],["つ"],["の"],["もの"],["を"],["一","ひと"],["つ"],["に"],["し"],["、"],["敵意","てきい"],["と"],["いう"],["隔て","へだて"],["の"],["中垣","なかがき"],["を"],["取除き","とりのぞき"],["、"],["ご自分","ごじぶん"],["の"],["肉","にく"],["によって"],["、"]]},{"verse":15,"text":"数々,かずかずの規定,きていから成,なっている戒,いましめの律法,りっぽうを廃棄,はいきしたのである。それは、彼,かれにあって、二つのものをひとりの新,あたらしい人,ひとに造,つくりかえて平和,へいわをきたらせ、","tok":[["数々","かずかず"],["の"],["規定","きてい"],["から"],["成って","なって"],["いる"],["戒しめ","いましめ"],["の"],["律法","りっぽう"],["を"],["廃棄","はいき"],["した"],["ので"],["ある"],["。"],["それ"],["は"],["、"],["彼","かれ"],["に"],["あって"],["、"],["二","ふた"],["つ"],["の"],["もの"],["を"],["ひとり"],["の"],["新らしい","あたらしい"],["人","ひと"],["に"],["造","つくり"],["かえて"],["平和","へいわ"],["を"],["きたらせ"],["、"]]},{"verse":16,"text":"十字架,じゅうじかによって、二つのものを一つのからだとして神,かみと和解,わかいさせ、敵意,てきいを十字架,じゅうじかにかけて滅,ほろぼしてしまったのである。","tok":[["十字架","じゅうじか"],["によって"],["、"],["二","ふた"],["つ"],["の"],["もの"],["を"],["一","ひと"],["つ"],["の"],["からだ"],["として"],["神","かみ"],["と"],["和解","わかい"],["させ"],["、"],["敵意","てきい"],["を"],["十字架","じゅうじか"],["に"],["かけて"],["滅ぼして","ほろぼして"],["しまった"],["ので"],["ある"],["。"]]},{"verse":17,"text":"それから彼,かれは、こられた上,うえで、遠,とおく離,はなれているあなたがたに平和,へいわを宣,のべ伝,つたえ、また近,ちかくにいる者,ものたちにも平和,へいわを宣,のべ伝,つたえられたのである。","tok":[["それ"],["から"],["彼","かれ"],["は"],["、"],["こられた"],["上","うえ"],["で"],["、"],["遠く","とおく"],["離れて","はなれて"],["いる"],["あなた"],["がた"],["に"],["平和","へいわ"],["を"],["宣べ伝え","のべつたえ"],["、"],["また"],["近く","ちかく"],["に"],["いる"],["者","もの"],["たち"],["に"],["も"],["平和","へいわ"],["を"],["宣べ伝えられた","のべつたえられた"],["ので"],["ある"],["。"]]},{"verse":18,"text":"というのは、彼,かれによって、わたしたち両方,りょうほうの者,ものが一つの御霊,みたまの中,なかにあって、父,ちちのみもとに近,ちかづくことができるからである。","tok":[["と"],["いう"],["の"],["は"],["、"],["彼","かれ"],["によって"],["、"],["わたしたち"],["両方","りょうほう"],["の"],["者","もの"],["が"],["一","ひと"],["つ"],["の"],["御霊","みたま"],["の"],["中","なか"],["に"],["あって"],["、"],["父","ちち"],["のみ"],["もと"],["に"],["近づく","ちかづく"],["こと"],["が"],["できる"],["から"],["で"],["ある"],["。"]]},{"verse":19,"text":"そこであなたがたは、もはや異国人,いこくじんでも宿,やどり人,びとでもなく、聖徒,せいとたちと同,おなじ国籍,こくせきの者,ものであり、神,かみの家族,かぞくなのである。","tok":[["そこ"],["で"],["あなた"],["がた"],["は"],["、"],["もはや"],["異国人","いこくじん"],["で"],["も"],["宿り","やどり"],["人","びと"],["で"],["も"],["なく"],["、"],["聖徒","せいと"],["たち"],["と"],["同じ","おなじ"],["国籍","こくせき"],["の"],["者","もの"],["で"],["あり"],["、"],["神","かみ"],["の"],["家族","かぞく"],["な"],["ので"],["ある"],["。"]]},{"verse":20,"text":"またあなたがたは、使徒,しとたちや預言者,よげんしゃたちという土台,どだいの上,うえに建,たてられたものであって、キリスト・イエスご自身,じしんが隅,すみのかしら石,いしである。","tok":[["また"],["あなた"],["がた"],["は"],["、"],["使徒","しと"],["たち"],["や"],["預言者","よげんしゃ"],["たち"],["と"],["いう"],["土台","どだい"],["の"],["上","うえ"],["に"],["建てられた","たてられた"],["もの"],["で"],["あって"],["、"],["キリスト"],["・"],["イエス"],["ご自身","ごじしん"],["が"],["隅","すみ"],["の"],["かしら"],["石","いし"],["で"],["ある"],["。"]]},{"verse":21,"text":"このキリストにあって、建物,たてもの全体,ぜんたいが組,くみ合,あわされ、主,しゅにある聖,せいなる宮,みやに成長,せいちょうし、","tok":[["この"],["キリスト"],["に"],["あって"],["、"],["建物","たてもの"],["全体","ぜんたい"],["が"],["組合わされ","くみあわされ"],["、"],["主に","しゅに"],["ある"],["聖","せい"],["なる"],["宮","みや"],["に"],["成長","せいちょう"],["し"],["、"]]},{"verse":22,"text":"そしてあなたがたも、主,しゅにあって共,ともに建,たてられて、霊,れいなる神,かみのすまいとなるのである。","tok":[["そして"],["あなた"],["がた"],["も"],["、"],["主に","しゅに"],["あって"],["共","とも"],["に"],["建てられて","たてられて"],["、"],["霊","れい"],["なる"],["神","かみ"],["の"],["すまい"],["と"],["なる"],["ので"],["ある"],["。"]]}]
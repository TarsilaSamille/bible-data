[{"verse":1,"text":"こうして、あなたがたは、神,かみに愛,あいされている子供,こどもとして、神,かみにならう者,ものになりなさい。","tok":[["こう"],["して"],["、"],["あなた"],["がた"],["は"],["、"],["神","かみ"],["に"],["愛されて","あいされて"],["いる"],["子供","こども"],["として"],["、"],["神","かみ"],["に"],["ならう"],["者","もの"],["に"],["なり"],["なさい"],["。"]]},{"verse":2,"text":"また愛,あいのうちを歩,あるきなさい。キリストもあなたがたを愛,あいして下,くださって、わたしたちのために、ご自身,じしんを、神,かみへのかんばしいかおりのささげ物,もの、また、いけにえとしてささげられたのである。","tok":[["また"],["愛","あい"],["の"],["うち"],["を"],["歩き","あるき"],["なさい"],["。"],["キリスト"],["も"],["あなた"],["がた"],["を"],["愛して","あいして"],["下さって","くださって"],["、"],["わたしたち"],["の"],["ため"],["に"],["、"],["ご自身","ごじしん"],["を"],["、"],["神","かみ"],["へ"],["の"],["かんばしい"],["かおり"],["の"],["ささげ物","ささげもの"],["、"],["また"],["、"],["いけにえ"],["として"],["ささげられた"],["ので"],["ある"],["。"]]},{"verse":3,"text":"また、不品行,ふひんこうといろいろな汚,けがれや貪欲,どんよくなどを、聖徒,せいとにふさわしく、あなたがたの間,あいだでは、口,くちにすることさえしてはならない。","tok":[["また"],["、"],["不品行","ふひんこう"],["と"],["いろいろ"],["な"],["汚","け"],["がれ"],["や"],["貪欲","どんよく"],["など"],["を"],["、"],["聖徒","せいと"],["に"],["ふさわしく"],["、"],["あなた"],["がた"],["の"],["間","あいだ"],["で"],["は"],["、"],["口","くち"],["に"],["する"],["こと"],["さえ"],["して"],["は"],["ならない"],["。"]]},{"verse":4,"text":"また、卑,いやしい言葉,ことばと愚,おろかな話,はなしやみだらな冗談,じょうだんを避,さけなさい。これらは、よろしくない事,ことである。それよりは、むしろ感謝,かんしゃをささげなさい。","tok":[["また"],["、"],["卑しい","いやしい"],["言葉","ことば"],["と"],["愚か","おろか"],["な"],["話","はなし"],["や"],["みだら"],["な"],["冗談","じょうだん"],["を"],["避け","さけ"],["なさい"],["。"],["これ"],["ら"],["は"],["、"],["よろしく"],["ない"],["事","こと"],["で"],["ある"],["。"],["それ"],["より"],["は"],["、"],["むしろ"],["感謝","かんしゃ"],["を"],["ささげ"],["なさい"],["。"]]},{"verse":5,"text":"あなたがたは、よく知,しっておかねばならない。すべて不品行,ふひんこうな者,もの、汚,けがれたことをする者,もの、貪欲,どんよくな者,もの、すなわち、偶像,ぐうぞうを礼拝,れいはいする者,ものは、キリストと神,かみとの国,くにをつぐことができない。","tok":[["あなた"],["がた"],["は"],["、"],["よく"],["知って","しって"],["おかねば"],["ならない"],["。"],["すべて"],["不品行","ふひんこう"],["な"],["者","もの"],["、"],["汚","けがれたこ"],["と"],["を"],["する"],["者","もの"],["、"],["貪欲","どんよく"],["な"],["者","もの"],["、"],["すなわち"],["、"],["偶像","ぐうぞう"],["を"],["礼拝","れいはい"],["する"],["者","もの"],["は"],["、"],["キリスト"],["と"],["神","かみ"],["と"],["の"],["国","くに"],["を"],["つぐ"],["こと"],["が"],["できない"],["。"]]},{"verse":6,"text":"あなたがたは、だれにも不誠実,ふせいじつな言葉,ことばでだまされてはいけない。これらのことから、神,かみの怒,いかりは不,ふ従順,じゅうじゅんの子,こらに下,くだるのである。","tok":[["あなた"],["がた"],["は"],["、"],["だれ"],["に"],["も"],["不誠実","ふせいじつ"],["な"],["言葉","ことば"],["で"],["だまされて"],["は"],["いけない"],["。"],["これ"],["ら"],["の"],["こと"],["から"],["、"],["神","かみ"],["の"],["怒り","いかり"],["は"],["不","ふ"],["従順","じゅうじゅん"],["の"],["子","こ"],["ら"],["に"],["下る","くだる"],["ので"],["ある"],["。"]]},{"verse":7,"text":"だから、彼,かれらの仲間,なかまになってはいけない。","tok":[["だ"],["から"],["、"],["彼","かれ"],["ら"],["の"],["仲間","なかま"],["に"],["なって"],["は"],["いけない"],["。"]]},{"verse":8,"text":"あなたがたは、以前,いぜんはやみであったが、今,いまは主,しゅにあって光,ひかりとなっている。光,ひかりの子,こらしく歩,あるきなさい――","tok":[["あなた"],["がた"],["は"],["、"],["以前","いぜん"],["は"],["やみ"],["で"],["あった"],["が"],["、"],["今","いま"],["は"],["主に","しゅに"],["あって"],["光","ひかり"],["と"],["なって"],["いる"],["。"],["光","ひかり"],["の"],["子","こ"],["らしく"],["歩き","あるき"],["なさい"],["―"],["―"]]},{"verse":9,"text":"光,ひかりはあらゆる善意,ぜんいと正義,せいぎと真実,しんじつとの実,みを結,むすばせるものである――","tok":[["光","ひかり"],["は"],["あらゆる"],["善意","ぜんい"],["と"],["正義","せいぎ"],["と"],["真実","しんじつ"],["と"],["の"],["実","み"],["を"],["結ばせる","むすばせる"],["もの"],["で"],["ある"],["―"],["―"]]},{"verse":10,"text":"主,しゅに喜,よろこばれるものがなんであるかを、わきまえ知,しりなさい。","tok":[["主に","しゅに"],["喜こばれる","よろこばれる"],["もの"],["が"],["なん"],["で"],["ある"],["か"],["を"],["、"],["わきまえ知り","わきまえしり"],["なさい"],["。"]]},{"verse":11,"text":"実,みを結,むすばないやみのわざに加,くわわらないで、むしろ、それを指摘,してきしてやりなさい。","tok":[["実","み"],["を"],["結ばない","むすばない"],["やみ"],["の"],["わざ"],["に"],["加わわらないで","くわわらないで"],["、"],["むしろ"],["、"],["それ"],["を"],["指摘","してき"],["して"],["やり"],["なさい"],["。"]]},{"verse":12,"text":"彼,かれらが隠,かくれて行,おこなっていることは、口,くちにするだけでも恥,はずかしい事,ことである。","tok":[["彼","かれ"],["ら"],["が"],["隠れて","かくれて"],["行なって","おこなって"],["いる"],["こと"],["は"],["、"],["口","くち"],["に"],["する"],["だけ"],["で"],["も"],["恥ずかしい","はずかしい"],["事","こと"],["で"],["ある"],["。"]]},{"verse":13,"text":"しかし、光,ひかりにさらされる時,とき、すべてのものは、明,あきらかになる。","tok":[["しかし"],["、"],["光","ひかり"],["に"],["さらされる"],["時","とき"],["、"],["すべて"],["の"],["もの"],["は"],["、"],["明か","あきらか"],["に"],["なる"],["。"]]},{"verse":14,"text":"明,あきらかにされたものは皆,みな、光,ひかりとなるのである。だから、こう書,かいてある、「眠,ねむっている者,ものよ、起,おきなさい。死人,しにんのなかから、立,たち上,あがりなさい。そうすれば、キリストがあなたを照,てらすであろう」。","tok":[["明か","あきらか"],["に"],["された"],["もの"],["は"],["皆","みな"],["、"],["光","ひかり"],["と"],["なる"],["ので"],["ある"],["。"],["だ"],["から"],["、"],["こう"],["書いて","かいて"],["ある"],["、"],["「"],["眠って","ねむって"],["いる"],["者","もの"],["よ"],["、"],["起き","おき"],["なさい"],["。"],["死人","しにん"],["の"],["なか"],["から"],["、"],["立ち上がり","たちあがり"],["なさい"],["。"],["そう"],["すれば"],["、"],["キリスト"],["が"],["あなた"],["を"],["照らすで","てらすで"],["あろう"],["」"],["。"]]},{"verse":15,"text":"そこで、あなたがたの歩,あるきかたによく注意,ちゅういして、賢,かしこくない者,もののようにではなく、賢,かしこい者,もののように歩,あるき、","tok":[["そこ"],["で"],["、"],["あなた"],["がた"],["の"],["歩き","あるき"],["かた"],["に"],["よく"],["注意","ちゅうい"],["して"],["、"],["賢しこく","かしこく"],["ない"],["者","もの"],["の"],["よう"],["にで"],["は"],["なく"],["、"],["賢しこい","かしこい"],["者","もの"],["の"],["よう"],["に"],["歩き","あるき"],["、"]]},{"verse":16,"text":"今,いまの時,ときを生,いかして用,もちいなさい。今,いまは悪,わるい時代,じだいなのである。","tok":[["今","いま"],["の"],["時","とき"],["を"],["生かして","いかして"],["用い","もちい"],["なさい"],["。"],["今","いま"],["は"],["悪い","わるい"],["時代","じだい"],["な"],["ので"],["ある"],["。"]]},{"verse":17,"text":"だから、愚,おろかな者,ものにならないで、主,しゅの御旨,みむねがなんであるかを悟,さとりなさい。","tok":[["だ"],["から"],["、"],["愚か","おろか"],["な"],["者","もの"],["に"],["ならないで"],["、"],["主","しゅ"],["の"],["御旨","み"],["むね"],["が"],["なん"],["で"],["ある"],["か"],["を"],["悟り","さとり"],["なさい"],["。"]]},{"verse":18,"text":"酒,さけに酔,よってはいけない。それは乱行,らんぎょうのもとである。むしろ御霊,みたまに満,みたされて、","tok":[["酒","さけ"],["に"],["酔って","よって"],["は"],["いけない"],["。"],["それ"],["は"],["乱行","らんぎょう"],["の"],["もと"],["で"],["ある"],["。"],["むしろ"],["御霊","みたま"],["に"],["満たされて","みたされて"],["、"]]},{"verse":19,"text":"詩,しとさんびと霊,れいの歌,うたとをもって語,かたり合,あい、主,しゅにむかって心,こころからさんびの歌,うたをうたいなさい。","tok":[["詩","し"],["と"],["さん"],["びと"],["霊","れい"],["の"],["歌","うた"],["と"],["を"],["もって"],["語り合い","かたりあい"],["、"],["主に","しゅに"],["むかって"],["心","こころ"],["から"],["さん"],["び"],["の"],["歌","うた"],["を"],["うたい"],["なさい"],["。"]]},{"verse":20,"text":"そしてすべてのことにつき、いつも、わたしたちの主,しゅイエス・キリストの御名,みなによって、父,ちちなる神,かみに感謝,かんしゃし、","tok":[["そして"],["すべて"],["の"],["こと"],["に"],["つき"],["、"],["いつも"],["、"],["わたしたち"],["の"],["主","しゅ"],["イエス"],["・"],["キリスト"],["の"],["御名","みな"],["によって"],["、"],["父","ちち"],["なる"],["神","かみ"],["に"],["感謝","かんしゃ"],["し"],["、"]]},{"verse":21,"text":"キリストに対,たいする恐,おそれの心,こころをもって、互,たがいに仕,つかえ合,あうべきである。","tok":[["キリスト"],["に"],["対する","たいする"],["恐","おそれ"],["の"],["心","こころ"],["を"],["もって"],["、"],["互","たがい"],["に"],["仕え","つかえ"],["合うべきで","あうべきで"],["ある"],["。"]]},{"verse":22,"text":"妻,つまたる者,ものよ。主,しゅに仕,つかえるように自分,じぶんの夫,おっとに仕,つかえなさい。","tok":[["妻","つま"],["たる"],["者","もの"],["よ"],["。"],["主に","しゅに"],["仕える","つかえる"],["よう"],["に"],["自分","じぶん"],["の"],["夫","おっと"],["に"],["仕え","つかえ"],["なさい"],["。"]]},{"verse":23,"text":"キリストが教会,きょうかいのかしらであって、自,みずからは、からだなる教会,きょうかいの救主,すくいぬしであられるように、夫,おっとは妻,つまのかしらである。","tok":[["キリスト"],["が"],["教会","きょうかい"],["の"],["かしら"],["で"],["あって"],["、"],["自から","みずから"],["は"],["、"],["からだ"],["なる"],["教会","きょうかい"],["の"],["救主","す"],["くい"],["ぬし"],["で"],["あられる"],["よう"],["に"],["、"],["夫","おっと"],["は"],["妻","つま"],["の"],["かしら"],["で"],["ある"],["。"]]},{"verse":24,"text":"そして教会,きょうかいがキリストに仕,つかえるように、妻,つまもすべてのことにおいて、夫,おっとに仕,つかえるべきである。","tok":[["そして"],["教会","きょうかい"],["が"],["キリスト"],["に"],["仕える","つかえる"],["よう"],["に"],["、"],["妻","つま"],["も"],["すべて"],["の"],["こと"],["に"],["おいて"],["、"],["夫","おっと"],["に"],["仕えるべきで","つかえるべきで"],["ある"],["。"]]},{"verse":25,"text":"夫,おっとたる者,ものよ。キリストが教会,きょうかいを愛,あいしてそのためにご自身,じしんをささげられたように、妻,つまを愛,あいしなさい。","tok":[["夫","おっと"],["たる"],["者","もの"],["よ"],["。"],["キリスト"],["が"],["教会","きょうかい"],["を"],["愛して","あいして"],["その"],["ため"],["に"],["ご自身","ごじしん"],["を"],["ささげられた"],["よう"],["に"],["、"],["妻","つま"],["を"],["愛し","あいし"],["なさい"],["。"]]},{"verse":26,"text":"キリストがそうなさったのは、水,みずで洗,あらうことにより、言葉,ことばによって、教会,きょうかいをきよめて聖,せいなるものとするためであり、","tok":[["キリスト"],["が"],["そう"],["なさった"],["の"],["は"],["、"],["水","みず"],["で"],["洗う","あらう"],["こと"],["に"],["より"],["、"],["言葉","ことば"],["によって"],["、"],["教会","きょうかい"],["を"],["きよめて"],["聖","せい"],["なる"],["もの"],["と"],["する"],["ため"],["で"],["あり"],["、"]]},{"verse":27,"text":"また、しみも、しわも、そのたぐいのものがいっさいなく、清,きよくて傷,きずのない栄光,えいこうの姿,すがたの教会,きょうかいを、ご自分,じぶんに迎,むかえるためである。","tok":[["また"],["、"],["しみ"],["も"],["、"],["しわ"],["も"],["、"],["その"],["たぐい"],["の"],["もの"],["が"],["いっさい"],["なく"],["、"],["清くて","きよくて"],["傷","きず"],["の"],["ない"],["栄光","えいこう"],["の"],["姿","すがた"],["の"],["教会","きょうかい"],["を"],["、"],["ご自分","ごじぶん"],["に"],["迎","むかえ"],["る"],["ため"],["で"],["ある"],["。"]]},{"verse":28,"text":"それと同,おなじく、夫,おっとも自分,じぶんの妻,つまを、自分,じぶんのからだのように愛,あいさねばならない。自分,じぶんの妻,つまを愛,あいする者,ものは、自分,じぶん自身,じしんを愛,あいするのである。","tok":[["それ"],["と"],["同じく","おなじく"],["、"],["夫","おっと"],["も"],["自分","じぶん"],["の"],["妻","つま"],["を"],["、"],["自分","じぶん"],["の"],["からだ"],["の"],["よう"],["に"],["愛さねば","あいさねば"],["ならない"],["。"],["自分","じぶん"],["の"],["妻","つま"],["を"],["愛する","あいする"],["者","もの"],["は"],["、"],["自分","じぶん"],["自身","じしん"],["を"],["愛する","あいする"],["ので"],["ある"],["。"]]},{"verse":29,"text":"自分,じぶん自身,じしんを憎,にくんだ者,ものは、いまだかつて、ひとりもいない。かえって、キリストが教会,きょうかいになさったようにして、おのれを育,そだて養,やしなうのが常,つねである。","tok":[["自分","じぶん"],["自身","じしん"],["を"],["憎んだ","にくんだ"],["者","もの"],["は"],["、"],["いまだ"],["かつて"],["、"],["ひとり"],["も"],["いない"],["。"],["かえって"],["、"],["キリスト"],["が"],["教会","きょうかい"],["に"],["なさった"],["よう"],["に"],["して"],["、"],["おのれ"],["を"],["育て","そだて"],["養う","やしなう"],["の"],["が"],["常","つね"],["で"],["ある"],["。"]]},{"verse":30,"text":"わたしたちは、キリストのからだの肢体,したいなのである。","tok":[["わたしたち"],["は"],["、"],["キリスト"],["の"],["からだ"],["の"],["肢体","したい"],["な"],["ので"],["ある"],["。"]]},{"verse":31,"text":"「それゆえに、人,ひとは父母,ふぼを離,はなれてその妻,つまと結,むすばれ、ふたりの者,ものは一体,いったいとなるべきである」。","tok":[["「"],["それ"],["ゆえ"],["に"],["、"],["人","ひと"],["は"],["父母","ふぼ"],["を"],["離れて","はなれて"],["その"],["妻","つま"],["と"],["結ばれ","むすばれ"],["、"],["ふたり"],["の"],["者","もの"],["は"],["一体","いったい"],["と"],["なるべきで"],["ある"],["」"],["。"]]},{"verse":32,"text":"この奥義,おくぎは大,おおきい。それは、キリストと教会,きょうかいとをさしている。","tok":[["この"],["奥義","おくぎ"],["は"],["大きい","おおきい"],["。"],["それ"],["は"],["、"],["キリスト"],["と"],["教会","きょうかい"],["と"],["を"],["さして"],["いる"],["。"]]},{"verse":33,"text":"いずれにしても、あなたがたは、それぞれ、自分,じぶんの妻,つまを自分,じぶん自身,じしんのように愛,あいしなさい。妻,つまもまた夫,おっとを敬,うやまいなさい。","tok":[["いずれ"],["に"],["して"],["も"],["、"],["あなた"],["がた"],["は"],["、"],["それぞれ"],["、"],["自分","じぶん"],["の"],["妻","つま"],["を"],["自分","じぶん"],["自身","じしん"],["の"],["よう"],["に"],["愛し","あいし"],["なさい"],["。"],["妻","つま"],["も"],["また"],["夫","おっと"],["を"],["敬い","うやまい"],["なさい"],["。"]]}]
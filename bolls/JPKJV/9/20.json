[{"verse":1,"text":"ダビデはラマのナヨテから逃,にげてきて、ヨナタンに言,いった、「わたしが何,なにをし、どのような悪,わるいことがあり、あなたの父,ちちの前,まえにどんな罪,つみを犯,おかしたので、わたしを殺,ころそうとされるのでしょうか」。","tok":[["ダビデ"],["は"],["ラマ"],["の"],["ナヨテ"],["から"],["逃て","にげて"],["きて"],["、"],["ヨナタン"],["に"],["言った","いった"],["、"],["「"],["わたし"],["が"],["何に","なに"],["を"],["し"],["、"],["どのような"],["悪い","わるい"],["こと"],["が"],["あり"],["、"],["あなた"],["の"],["父","ちち"],["の"],["前","まえ"],["に"],["どんな"],["罪","つみ"],["を"],["犯した","おかした"],["ので"],["、"],["わたし"],["を"],["殺そう","ころそう"],["と"],["される"],["の"],["でしょう"],["か"],["」"],["。"]]},{"verse":2,"text":"ヨナタンは彼,かれに言,いった、「決,けっして殺,ころされることはありません。父,ちちは事,ことの大小,だいしょうを問,とわず、わたしに告,つげないですることはありません。どうして父,ちちがわたしにその事,ことを隠,かくしましょう。そのようなことはありません」。","tok":[["ヨナタン"],["は"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["決っして","けっして"],["殺ろされる","ころされる"],["こと"],["は"],["ありません"],["。"],["父","ちち"],["は"],["事","こと"],["の"],["大小","だいしょう"],["を"],["問わず","とわず"],["、"],["わたし"],["に"],["告","つげ"],["ないで"],["する"],["こと"],["は"],["ありません"],["。"],["どう"],["して"],["父","ちち"],["が"],["わたし"],["に"],["その"],["事","こと"],["を"],["隠しましょう","かくしましょう"],["。"],["その"],["よう"],["な"],["こと"],["は"],["ありません"],["」"],["。"]]},{"verse":3,"text":"しかしダビデは答,こたえた、「あなたの父,ちちは、わたしがあなたの好意,こういをえていることをよく知,しっておられます。それで『ヨナタンが悲,かなしむことのないように、これを知,しらせないでおこう』と思,おもっておられるのです。しかし、主,しゅは生,いきておられ、あなたの魂,たましいは生,いきています。わたしと死,しとの間,あいだは、ただ一歩,ぽです」。","tok":[["しかし"],["ダビデ"],["は"],["答","こたえ"],["た"],["、"],["「"],["あなた"],["の"],["父","ちち"],["は"],["、"],["わたし"],["が"],["あなた"],["の"],["好意","こうい"],["を"],["えて"],["いる"],["こと"],["を"],["よく"],["知って","しって"],["おられます"],["。"],["それ"],["で"],["『"],["ヨナタン"],["が"],["悲しむ","かなしむ"],["こと"],["の"],["ない"],["よう"],["に"],["、"],["これ"],["を"],["知らせないで","しらせないで"],["おこう"],["』"],["と"],["思って","おもって"],["おられる"],["の"],["です"],["。"],["しかし"],["、"],["主","しゅ"],["は"],["生きて","いきて"],["おられ"],["、"],["あなた"],["の"],["魂","たましい"],["は"],["生きて","いきて"],["います"],["。"],["わたし"],["と"],["死","し"],["と"],["の"],["間","あいだ"],["は"],["、"],["ただ"],["一歩","ぽ"],["です"],["」"],["。"]]},{"verse":4,"text":"ヨナタンはダビデに言,いった、「あなたが言,いわれることはなんでもします」。","tok":[["ヨナタン"],["は"],["ダビデ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["が"],["言われる","いわれる"],["こと"],["は"],["なん"],["で"],["も"],["します"],["」"],["。"]]},{"verse":5,"text":"ダビデはヨナタンに言,いった、「あすは、ついたちですから、わたしは王,おうと一緒,いっしょに食事,しょくじをしなければなりません。しかしわたしを行,いかせて三日,か目,めの夕方,ゆうがたまで、野原,のはらに隠,かくれることを許,ゆるしてください。","tok":[["ダビデ"],["は"],["ヨナタン"],["に"],["言った","いった"],["、"],["「"],["あす"],["は"],["、"],["ついた"],["ち"],["です"],["から"],["、"],["わたし"],["は"],["王","おう"],["と"],["一緒","いっしょ"],["に"],["食事","しょくじ"],["を"],["しなければ"],["なりません"],["。"],["しかし"],["わたし"],["を"],["行かせて","いかせて"],["三日目","かめ"],["の"],["夕方","ゆうがた"],["まで"],["、"],["野原","のはら"],["に"],["隠れる","かくれる"],["こと"],["を"],["許して","ゆるして"],["ください"],["。"]]},{"verse":6,"text":"もしあなたの父,ちちがわたしのことを尋,たずねられるならば、その時,とき、言,いってください、『ダビデはふるさとの町,まちベツレヘムへ急,いそいで行,いくことを許,ゆるしてくださいと、しきりにわたしに求,もとめました。そこで全家,ぜんかの年,とし祭,まつりがあるからです』。","tok":[["もし"],["あなた"],["の"],["父","ちち"],["が"],["わたし"],["の"],["こと"],["を"],["尋ねられるならば","たずねられるならば"],["、"],["その"],["時","とき"],["、"],["言って","いって"],["ください"],["、"],["『"],["ダビデ"],["は"],["ふるさと"],["の"],["町","まち"],["ベツレヘム"],["へ"],["急いで","いそいで"],["行く","いく"],["こと"],["を"],["許して","ゆるして"],["ください"],["と"],["、"],["しきり"],["に"],["わたし"],["に"],["求めました","もとめました"],["。"],["そこ"],["で"],["全家","ぜんか"],["の"],["年祭","としまつり"],["が"],["ある"],["から"],["です"],["』"],["。"]]},{"verse":7,"text":"もし彼,かれが「良,よし」と言,いわれるなら、しもべは安全,あんぜんですが、怒,いかられるなら、わたしに害,がいを加,くわえる決心,けっしんでおられるのを知,しってください。","tok":[["もし"],["彼","かれ"],["が"],["「"],["良し","よし"],["」"],["と"],["言われるなら","いわれるなら"],["、"],["しもべ"],["は"],["安全","あんぜん"],["です"],["が"],["、"],["怒","い"],["から"],["れるなら"],["、"],["わたし"],["に"],["害","がい"],["を"],["加える","くわえる"],["決心","けっしん"],["で"],["おられる"],["の"],["を"],["知って","しって"],["ください"],["。"]]},{"verse":8,"text":"あなたは、主,しゅの前,まえで、しもべと契約,けいやくを結,むすんでくださいました。それでどうぞしもべにいつくしみを施,ほどこしてください。しかし、もしわたしに悪,わるいことがあるならば、あなた自,みずからわたしを殺,ころしてください。どうしてあなたの父,ちちのもとへわたしを引,ひいていかなければならないでしょう」。","tok":[["あなた"],["は"],["、"],["主","しゅ"],["の"],["前","まえ"],["で"],["、"],["しもべ"],["と"],["契約","けいやく"],["を"],["結んで","むすんで"],["くださいました"],["。"],["それ"],["で"],["どうぞ"],["しもべ"],["に"],["いつくしみ"],["を"],["施して","ほどこして"],["ください"],["。"],["しかし"],["、"],["もし"],["わたし"],["に"],["悪い","わるい"],["こと"],["が"],["あるならば"],["、"],["あなた"],["自から","みずから"],["わたし"],["を"],["殺ろして","ころして"],["ください"],["。"],["どう"],["して"],["あなた"],["の"],["父","ちち"],["の"],["もと"],["へ"],["わたし"],["を"],["引いて","ひいて"],["いかなければ"],["ならないでしょう"],["」"],["。"]]},{"verse":9,"text":"ヨナタンは言,いった、「そのようなことは決,けっしてありません。父,ちちがあなたに害,がいを加,くわえる決心,けっしんをしていることがわたしにわかっているならば、わたしはそれをあなたに告,つげないでおきましょうか」。","tok":[["ヨナタン"],["は"],["言った","いった"],["、"],["「"],["その"],["よう"],["な"],["こと"],["は"],["決っして","けっして"],["ありません"],["。"],["父","ちち"],["が"],["あなた"],["に"],["害","がい"],["を"],["加える","くわえる"],["決心","けっしん"],["を"],["して"],["いる"],["こと"],["が"],["わたし"],["に"],["わかって"],["いるならば"],["、"],["わたし"],["は"],["それ"],["を"],["あなた"],["に"],["告","つげ"],["ないで"],["おきましょう"],["か"],["」"],["。"]]},{"verse":10,"text":"ダビデはヨナタンに言,いった、「あなたの父,ちちが荒々,あらあらしくあなたに答,こたえられる時,とき、だれがわたしに告,つげるでしょうか」。","tok":[["ダビデ"],["は"],["ヨナタン"],["に"],["言った","いった"],["、"],["「"],["あなた"],["の"],["父","ちち"],["が"],["荒々しく","あらあらしく"],["あなた"],["に"],["答","こたえ"],["られる"],["時","とき"],["、"],["だれ"],["が"],["わたし"],["に"],["告げるでしょう","つげるでしょう"],["か"],["」"],["。"]]},{"verse":11,"text":"ヨナタンはダビデに言,いった、「さあ、野原,のはらへ出,でていこう」。こうしてふたりは野原,のはらへ出,でて行,いった。","tok":[["ヨナタン"],["は"],["ダビデ"],["に"],["言った","いった"],["、"],["「"],["さあ"],["、"],["野原","のはら"],["へ"],["出て","でて"],["いこう"],["」"],["。"],["こう"],["して"],["ふたり"],["は"],["野原","のはら"],["へ"],["出て","でて"],["行った","いった"],["。"]]},{"verse":12,"text":"そしてヨナタンはダビデに言,いった、「イスラエルの神,かみ、主,しゅが、証人,しょうにんです。明日,みょうにちか明後日,みょうごにちの今,いまごろ、わたしが父,ちちの心,こころを探,さぐって、父,ちちがダビデに対,たいして良,よいのを見,みながら、人,ひとをつかわしてあなたに知,しらせないようなことをするでしょうか。","tok":[["そして"],["ヨナタン"],["は"],["ダビデ"],["に"],["言った","いった"],["、"],["「"],["イスラエル"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["、"],["証人","しょうにん"],["です"],["。"],["明日","みょ"],["う"],["にちか"],["明後日","みょうごにち"],["の"],["今ごろ","いまごろ"],["、"],["わたし"],["が"],["父","ちち"],["の"],["心","こころ"],["を"],["探って","さぐって"],["、"],["父","ちち"],["が"],["ダビデ"],["に対して","にたいして"],["良い","よい"],["の"],["を"],["見","み"],["ながら"],["、"],["人","ひと"],["を"],["つかわして"],["あなた"],["に"],["知らせない","しらせない"],["よう"],["な"],["こと"],["を"],["するでしょう"],["か"],["。"]]},{"verse":13,"text":"しかし、もし父,ちちがあなたに害,がいを加,くわえようと思,おもっているのに、それをあなたに知,しらせず、あなたを逃,にがして、安全,あんぜんに去,さらせないならば、主,しゅよ、どうぞ幾重,いくえにも、このヨナタンを罰,ばっしてください。どうぞ主,しゅが父,ちちと共,ともにおられたように、あなたと共,ともにおられますように。","tok":[["しかし"],["、"],["もし"],["父","ちち"],["が"],["あなた"],["に"],["害","がい"],["を"],["加えよう","くわえよう"],["と"],["思って","おもって"],["いる"],["のに"],["、"],["それ"],["を"],["あなた"],["に"],["知らせず","しらせず"],["、"],["あなた"],["を"],["逃がして","にがして"],["、"],["安全","あんぜん"],["に"],["去らせないならば","さらせないならば"],["、"],["主","しゅ"],["よ"],["、"],["どうぞ"],["幾重","いくえ"],["に"],["も"],["、"],["この"],["ヨナタン"],["を"],["罰して","ばっして"],["ください"],["。"],["どうぞ"],["主","しゅ"],["が"],["父","ちち"],["と"],["共","とも"],["に"],["おられた"],["よう"],["に"],["、"],["あなた"],["と"],["共","とも"],["に"],["おられます"],["よう"],["に"],["。"]]},{"verse":14,"text":"もしわたしがなお生,いきながらえているならば、主,しゅのいつくしみをわたしに施,ほどこし、死,しを免,まぬかれさせてください。","tok":[["もし"],["わたし"],["が"],["なお"],["生きながらえて","いきながらえて"],["いるならば"],["、"],["主","しゅ"],["の"],["いつくしみ"],["を"],["わたし"],["に"],["施し","ほどこし"],["、"],["死","し"],["を"],["免かれさせて","まぬかれさせて"],["ください"],["。"]]},{"verse":15,"text":"またわたしの家,いえをも、長,ながくあなたのいつくしみにあずからせてください。主,しゅがダビデの敵,てきをことごとく地,ちのおもてから断,たち滅,ほろぼされる時,とき、","tok":[["また"],["わたし"],["の"],["家","いえ"],["を"],["も"],["、"],["長く","ながく"],["あなた"],["の"],["いつくしみ"],["に"],["あずからせて"],["ください"],["。"],["主","しゅ"],["が"],["ダビデ"],["の"],["敵","てき"],["を"],["ことごとく"],["地","ち"],["の"],["おもて"],["から"],["断ち","たち"],["滅ぼされる","ほろぼされる"],["時","とき"],["、"]]},{"verse":16,"text":"ヨナタンの名,なをダビデの家,いえから絶,たやさないでください。どうぞ主,しゅがダビデの敵,てきに、あだを返,かえされるように」。","tok":[["ヨナタン"],["の"],["名","な"],["を"],["ダビデ"],["の"],["家","いえ"],["から"],["絶やさないで","たやさないで"],["ください"],["。"],["どうぞ"],["主","しゅ"],["が"],["ダビデ"],["の"],["敵","てき"],["に"],["、"],["あだ"],["を"],["返えされる","かえされる"],["よう"],["に"],["」"],["。"]]},{"verse":17,"text":"そしてヨナタンは重,かさねてダビデに誓,ちかわせた。彼,かれを愛,あいしたからである。ヨナタンは自分,じぶんの命,いのちのように彼,かれを愛,あいしていた。","tok":[["そして"],["ヨナタン"],["は"],["重ねて","かさねて"],["ダビデ"],["に"],["誓わせた","ちかわせた"],["。"],["彼","かれ"],["を"],["愛した","あいした"],["から"],["で"],["ある"],["。"],["ヨナタン"],["は"],["自分","じぶん"],["の"],["命","いのち"],["の"],["よう"],["に"],["彼","かれ"],["を"],["愛して","あいして"],["いた"],["。"]]},{"verse":18,"text":"ヨナタンはダビデに言,いった、「あすはついたちです。あなたの席,せきがあいているので、どうしたのかと尋,たずねられるでしょう。","tok":[["ヨナタン"],["は"],["ダビデ"],["に"],["言った","いった"],["、"],["「"],["あす"],["は"],["ついた"],["ち"],["です"],["。"],["あなた"],["の"],["席","せき"],["が"],["あいて"],["いる"],["ので"],["、"],["どう"],["した"],["の"],["か"],["と"],["尋ねられるでしょう","たずねられるでしょう"],["。"]]},{"verse":19,"text":"三日,か目,めには、きびしく尋,たずねられるでしょうから、先,さきにあなたが隠,かくれた場所,ばしょへ行,いって、向,むこうの石塚,いしづかのかたわらにいてください。","tok":[["三日目","かめ"],["に"],["は"],["、"],["きびしく"],["尋ねられるでしょう","たずねられるでしょう"],["から"],["、"],["先","さき"],["に"],["あなた"],["が"],["隠れた","かくれた"],["場所","ばしょ"],["へ"],["行って","いって"],["、"],["向こう","むこう"],["の"],["石塚","いしづか"],["の"],["かたわら"],["に"],["いて"],["ください"],["。"]]},{"verse":20,"text":"わたしは的,まとを射,いるようにして、矢,やを三本,ほん、そのそばに放,はなちます。","tok":[["わたし"],["は"],["的","まと"],["を"],["射る","いる"],["よう"],["に"],["して"],["、"],["矢","や"],["を"],["三本","ほん"],["、"],["その"],["そば"],["に"],["放ちます","はなちます"],["。"]]},{"verse":21,"text":"そして、『行,いって矢,やを捜,さがしてきなさい』と言,いって子供,こどもをつかわしましょう。わたしが子供,こどもに、『矢,やは手前,てまえにある。それを取,とってきなさい』と言,いうならば、その時,ときあなたはきてください。主,しゅが生,いきておられるように、あなたは安全,あんぜんで、何,なにも危険,きけんがないからです。","tok":[["そして"],["、"],["『"],["行って","いって"],["矢","や"],["を"],["捜して","さがして"],["き"],["なさい"],["』"],["と"],["言って","いって"],["子供","こども"],["を"],["つかわしましょう"],["。"],["わたし"],["が"],["子供","こども"],["に"],["、"],["『"],["矢","や"],["は"],["手前","てまえ"],["に"],["ある"],["。"],["それ"],["を"],["取って","とって"],["き"],["なさい"],["』"],["と"],["言うならば","いうならば"],["、"],["その"],["時","とき"],["あなた"],["は"],["きて"],["ください"],["。"],["主","しゅ"],["が"],["生きて","いきて"],["おられる"],["よう"],["に"],["、"],["あなた"],["は"],["安全","あんぜん"],["で"],["、"],["何に","なに"],["も"],["危険","きけん"],["が"],["ない"],["から"],["です"],["。"]]},{"verse":22,"text":"しかしわたしがその子,こ供,ともに、『矢,やは向,むこうにある』と言,いうならば、その時,とき、あなたは去,さって行,いきなさい。主,しゅがあなたを去,さらせられるのです。","tok":[["しかし"],["わたし"],["が"],["その"],["子供","ことも"],["に"],["、"],["『"],["矢","や"],["は"],["向こう","むこう"],["に"],["ある"],["』"],["と"],["言うならば","いうならば"],["、"],["その"],["時","とき"],["、"],["あなた"],["は"],["去て","さって"],["行き","いき"],["なさい"],["。"],["主","しゅ"],["が"],["あなた"],["を"],["去らせられる","さらせられる"],["の"],["です"],["。"]]},{"verse":23,"text":"あなたとわたしとで話,はなしあった事,ことについては、主,しゅが常,つねにあなたとわたしとの間,あいだにおられます」。","tok":[["あなた"],["と"],["わたし"],["と"],["で"],["話","はなし"],["あった"],["事","こと"],["について"],["は"],["、"],["主","しゅ"],["が"],["常","つね"],["に"],["あなた"],["と"],["わたし"],["と"],["の"],["間","あいだ"],["に"],["おられます"],["」"],["。"]]},{"verse":24,"text":"そこでダビデは野原,のはらに身,みを隠,かくした。さて、ついたちになったので、王,おうは食事,しょくじをするため席,せきに着,ついた。","tok":[["そこ"],["で"],["ダビデ"],["は"],["野原","のはら"],["に"],["身","み"],["を"],["隠した","かくした"],["。"],["さて"],["、"],["つい"],["たち"],["に"],["なった"],["ので"],["、"],["王","おう"],["は"],["食事","しょくじ"],["を"],["する"],["ため"],["席","せき"],["に"],["着いた","ついた"],["。"]]},{"verse":25,"text":"王,おうはいつものように壁,かべ寄,よりに席,せきに着,つき、ヨナタンはその向,むかい側,がわの席,せきに着,つき、アブネルはサウルの横,よこの席,せきに着,ついたが、ダビデの場所,ばしょにはだれもいなかった。","tok":[["王","おう"],["は"],["いつも"],["の"],["よう"],["に"],["壁寄り","かべより"],["に"],["席","せき"],["に"],["着き","つき"],["、"],["ヨナタン"],["は"],["その"],["向側","むかいがわ"],["の"],["席","せき"],["に"],["着き","つき"],["、"],["アブネル"],["は"],["サウル"],["の"],["横","よこ"],["の"],["席","せき"],["に"],["着いた","ついた"],["が"],["、"],["ダビデ"],["の"],["場所","ばしょ"],["に"],["は"],["だれ"],["も"],["いなかった"],["。"]]},{"verse":26,"text":"ところがその日,ひサウルは何,なにも言,いわなかった、「彼,かれに何,なにか起,たって汚,けがれたのだろう。きっと汚,けがれたのにちがいない」と思,おもったからである。","tok":[["ところ"],["が"],["その"],["日","ひ"],["サウル"],["は"],["何に","なに"],["も"],["言わなかった","いわなかった"],["、"],["「"],["彼","かれ"],["に"],["何に","なに"],["か"],["起って","たって"],["汚","けがれた"],["の"],["だろう"],["。"],["きっと"],["汚","けがれた"],["のに"],["ちがい"],["ない"],["」"],["と"],["思った","おもった"],["から"],["で"],["ある"],["。"]]},{"verse":27,"text":"しかし、ふつか目,めすなわち、ついたちの明,あくる日,ひも、ダビデの場所,ばしょはあいていたので、サウルは、その子,こヨナタンに言,いった、「どうしてエッサイの子,こは、きのうもきょうも食事,しょくじにこないのか」。","tok":[["しかし"],["、"],["ふ"],["つ"],["か"],["目","め"],["すなわち"],["、"],["ついた"],["ち"],["の"],["明くる日","あくるひ"],["も"],["、"],["ダビデ"],["の"],["場所","ばしょ"],["は"],["あいて"],["いた"],["ので"],["、"],["サウル"],["は"],["、"],["その"],["子","こ"],["ヨナタン"],["に"],["言った","いった"],["、"],["「"],["どう"],["して"],["エッサイ"],["の"],["子","こ"],["は"],["、"],["きのう"],["も"],["きょう"],["も"],["食事","しょくじ"],["に"],["こない"],["の"],["か"],["」"],["。"]]},{"verse":28,"text":"ヨナタンはサウルに答,こたえた、「ダビデは、ベツレヘムへ行,いくことを許,ゆるしてくださいと、しきりにわたしに求,もとめました。","tok":[["ヨナタン"],["は"],["サウル"],["に"],["答","こたえ"],["た"],["、"],["「"],["ダビデ"],["は"],["、"],["ベツレヘム"],["へ"],["行く","いく"],["こと"],["を"],["許して","ゆるして"],["ください"],["と"],["、"],["しきり"],["に"],["わたし"],["に"],["求めました","もとめました"],["。"]]},{"verse":29,"text":"彼,かれは言,いいました、『わたしに行,いかせてください。われわれの一族,いちぞくが町,まちで祭,まつりをするので、兄,あにがわたしに来,くるようにと命,めいじました。それでもし、あなたの前,まえに恵,めぐみを得,えますならば、どうぞ、わたしに行,いくことを許,ゆるし、兄弟,きょうだいたちに会,あわせてください』。それで彼,かれは王,おうの食卓,しょくたくにこなかったのです」。","tok":[["彼","かれ"],["は"],["言いました","いいました"],["、"],["『"],["わたし"],["に"],["行かせて","いかせて"],["ください"],["。"],["われわれ"],["の"],["一族","いちぞく"],["が"],["町","まち"],["で"],["祭","まつり"],["を"],["する"],["ので"],["、"],["兄","あに"],["が"],["わたし"],["に"],["来る","くる"],["よう"],["に"],["と"],["命じました","めいじました"],["。"],["それ"],["で"],["も"],["し"],["、"],["あなた"],["の"],["前","まえ"],["に"],["恵","めぐみ"],["を"],["得ますならば","えますならば"],["、"],["どうぞ"],["、"],["わたし"],["に"],["行く","いく"],["こと"],["を"],["許し","ゆるし"],["、"],["兄弟","きょうだい"],["たち"],["に"],["会わせて","あわせて"],["ください"],["』"],["。"],["それ"],["で"],["彼","かれ"],["は"],["王","おう"],["の"],["食卓","しょくたく"],["に"],["こなかった"],["の"],["です"],["」"],["。"]]},{"verse":30,"text":"その時,ときサウルはヨナタンにむかって怒,いかりを発,はっし、彼,かれに言,いった、「あなたは心,こころの曲,まがった、そむく女,おんなの産,うんだ子,こだ。あなたがエッサイの子,こを選,えらんで、自分,じぶんの身,みをはずかしめ、また母,ははの身,みをはずかしめていることをわたしが知,しらないと思,おもうのか。","tok":[["その"],["時","とき"],["サウル"],["は"],["ヨナタン"],["に"],["むかって"],["怒り","いかり"],["を"],["発し","はっし"],["、"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["は"],["心","こころ"],["の"],["曲がった","まがった"],["、"],["そむく"],["女","おんな"],["の"],["産んだ","うんだ"],["子","こ"],["だ"],["。"],["あなた"],["が"],["エッサイ"],["の"],["子","こ"],["を"],["選らんで","えらんで"],["、"],["自分","じぶん"],["の"],["身","み"],["を"],["はずかしめ"],["、"],["また"],["母","はは"],["の"],["身","み"],["を"],["はずかしめて"],["いる"],["こと"],["を"],["わたし"],["が"],["知らない","しらない"],["と"],["思","おもう"],["の"],["か"],["。"]]},{"verse":31,"text":"エッサイの子,こがこの世,よに生,いきながらえている間,あいだは、あなたも、あなたの王国,おうこくも堅,かたく立,たっていくことはできない。それゆえ今,いま、人,ひとをつかわして、彼,かれをわたしのもとに連,つれてこさせなさい。彼,かれは必,かならず死,しななければならない」。","tok":[["エッサイ"],["の"],["子","こ"],["が"],["この世","このよ"],["に"],["生きながらえて","いきながらえて"],["いる"],["間","あいだ"],["は"],["、"],["あなた"],["も"],["、"],["あなた"],["の"],["王国","おうこく"],["も"],["堅く","かたく"],["立って","たって"],["いく"],["こと"],["は"],["できない"],["。"],["それ"],["ゆえ"],["今","いま"],["、"],["人","ひと"],["を"],["つかわして"],["、"],["彼","かれ"],["を"],["わたし"],["の"],["もと"],["に"],["連れて","つれて"],["こさせ"],["なさい"],["。"],["彼","かれ"],["は"],["必死","かならずし"],["な"],["なければ"],["ならない"],["」"],["。"]]},{"verse":32,"text":"ヨナタンは父,ちちサウルに答,こたえた、「どうして彼,かれは殺,ころされなければならないのですか。彼,かれは何,なにをしたのですか」。","tok":[["ヨナタン"],["は"],["父","ちち"],["サウル"],["に"],["答","こたえ"],["た"],["、"],["「"],["どう"],["して"],["彼","かれ"],["は"],["殺ろされなければ","ころされなければ"],["ならない"],["の"],["です"],["か"],["。"],["彼","かれ"],["は"],["何に","なに"],["を"],["した"],["の"],["です"],["か"],["」"],["。"]]},{"verse":33,"text":"ところがサウルはヨナタンを撃,うとうとして、やりを彼,かれに向,むかって振,ふり上,あげたので、ヨナタンは父,ちちがダビデを殺,ころそうと、心,こころに決,きめているのを知,しった。","tok":[["ところ"],["が"],["サウル"],["は"],["ヨナタン"],["を"],["撃とう","うとう"],["として"],["、"],["やり"],["を"],["彼","かれ"],["に"],["向かって","むかって"],["振り上た","ふりあげた"],["ので"],["、"],["ヨナタン"],["は"],["父","ちち"],["が"],["ダビデ"],["を"],["殺そう","ころそう"],["と"],["、"],["心","こころ"],["に"],["決めて","きめて"],["いる"],["の"],["を"],["知った","しった"],["。"]]},{"verse":34,"text":"ヨナタンは激,はげしく怒,いかって席,せきを立,たち、その月,つきのふつかには食事,しょくじをしなかった。父,ちちがダビデをはずかしめたので、ダビデのために憂,うれえたからである。","tok":[["ヨナタン"],["は"],["激しく","はげしく"],["怒","い"],["か"],["って"],["席","せき"],["を"],["立ち","たち"],["、"],["その"],["月","つき"],["の"],["ふ"],["つ"],["か"],["に"],["は"],["食事","しょくじ"],["を"],["しなかった"],["。"],["父","ちち"],["が"],["ダビデ"],["を"],["はずかしめた"],["ので"],["、"],["ダビデ"],["の"],["ため"],["に"],["憂えた","うれえた"],["から"],["で"],["ある"],["。"]]},{"verse":35,"text":"あくる朝,あさ、ヨナタンは、ひとりの小,ちいさい子供,こどもを連,つれて、ダビデと打,うち合,あわせたように野原,のはらに出,でて行,いった。","tok":[["あくる"],["朝","あさ"],["、"],["ヨナタン"],["は"],["、"],["ひとり"],["の"],["小さい","ちいさい"],["子供","こども"],["を"],["連れて","つれて"],["、"],["ダビデ"],["と"],["打ち","うち"],["合","あわせ"],["た"],["よう"],["に"],["野原","のはら"],["に"],["出て","でて"],["行った","いった"],["。"]]},{"verse":36,"text":"そしてその子,こ供,ともに言,いった、「走,はしって行,いって、わたしの射,いる矢,やを捜,さがしなさい」。子供,こどもが走,はしって行,いく間,あいだに、ヨナタンは矢,やを彼,かれの前,まえの方,ほうに放,はなった。","tok":[["そして"],["その"],["子供","ことも"],["に"],["言った","いった"],["、"],["「"],["走って","はしって"],["行って","いって"],["、"],["わたし"],["の"],["射る","いる"],["矢","や"],["を"],["捜し","さがし"],["なさい"],["」"],["。"],["子供","こども"],["が"],["走って","はしって"],["行く","いく"],["間","あいだ"],["に"],["、"],["ヨナタン"],["は"],["矢","や"],["を"],["彼","かれ"],["の"],["前","まえ"],["の"],["方","ほう"],["に"],["放った","はなった"],["。"]]},{"verse":37,"text":"そして子供,こどもが、ヨナタンの放,はなった矢,やのところへ行,いった時,とき、ヨナタンは子供,こどものうしろから呼,よばわって、「矢,やは向,むこうにあるではないか」と言,いった。","tok":[["そして"],["子供","こども"],["が"],["、"],["ヨナタン"],["の"],["放った","はなった"],["矢","や"],["の"],["ところ"],["へ"],["行った","いった"],["時","とき"],["、"],["ヨナタン"],["は"],["子供","こども"],["の"],["うしろ"],["から"],["呼ばわって","よばわって"],["、"],["「"],["矢","や"],["は"],["向こう","むこう"],["に"],["ある"],["で"],["は"],["ない"],["か"],["」"],["と"],["言った","いった"],["。"]]},{"verse":38,"text":"ヨナタンはまた、その子,こ供,とものうしろから呼,よばわって言,いった、「早,はやくせよ、急,いそげ。とどまるな」。その子,こ供,ともは矢,やを拾,ひろい集,あつめて主人,しゅじんヨナタンのもとにきた。","tok":[["ヨナタン"],["は"],["また"],["、"],["その"],["子供","ことも"],["の"],["うしろ"],["から"],["呼ばわって","よばわって"],["言った","いった"],["、"],["「"],["早く","はやく"],["せよ"],["、"],["急げ","いそげ"],["。"],["とどまる"],["な"],["」"],["。"],["その"],["子供","ことも"],["は"],["矢","や"],["を"],["拾い集めて","ひろいあつめて"],["主人","しゅじん"],["ヨナタン"],["の"],["もと"],["に"],["きた"],["。"]]},{"verse":39,"text":"しかし子供,こどもは何,なにも知,しらず、ヨナタンとダビデだけがそのことを知,しっていた。","tok":[["しかし"],["子供","こども"],["は"],["何に","なに"],["も"],["知らず","しらず"],["、"],["ヨナタン"],["と"],["ダビデ"],["だけ"],["が"],["その"],["こと"],["を"],["知って","しって"],["いた"],["。"]]},{"verse":40,"text":"ヨナタンは自分,じぶんの武器,ぶきをその子,こ供,ともに渡,わたして言,いった、「あなたはこれを町,まちへ運,はこんで行,いきなさい」。","tok":[["ヨナタン"],["は"],["自分","じぶん"],["の"],["武器","ぶき"],["を"],["その"],["子供","ことも"],["に"],["渡","わたし"],["て"],["言った","いった"],["、"],["「"],["あなた"],["は"],["これ"],["を"],["町","まち"],["へ"],["運こんで","はこんで"],["行き","いき"],["なさい"],["」"],["。"]]},{"verse":41,"text":"子供,こどもが行,いってしまうとダビデは石塚,いしづかのかたわらをはなれて立,たちいで、地,ちにひれ伏,ふして三度,ど敬礼,けいれいした。そして、ふたりは互,たがいに口,くちづけし、互,たがいに泣,ないた。やがてダビデは心,こころが落,おち着,ついた。","tok":[["子供","こども"],["が"],["行って","いって"],["しまう"],["と"],["ダビデ"],["は"],["石塚","いしづか"],["の"],["かたわら"],["を"],["はなれて"],["立ちいで","たちいで"],["、"],["地","ち"],["に"],["ひれ伏して","ひれふして"],["三","さん"],["度","ど"],["敬礼","けいれい"],["した"],["。"],["そして"],["、"],["ふたり"],["は"],["互","たがい"],["に"],["口づけ","くちづけ"],["し"],["、"],["互","たがい"],["に"],["泣いた","ないた"],["。"],["やがて"],["ダビデ"],["は"],["心","こころ"],["が"],["落着いた","おちついた"],["。"]]},{"verse":42,"text":"[42a]その時,ときヨナタンはダビデに言,いった、「無事,ぶじに行,いきなさい。われわれふたりは、『主,しゅが常,つねにわたしとあなたの間,あいだにおられ、また、わたしの子孫,しそんとあなたの子孫,しそんの間,あいだにおられる』と言,いって、主,しゅの名,なをさして誓,ちかったのです」。","tok":[["["],["42"],["a"],["]"],["その"],["時","とき"],["ヨナタン"],["は"],["ダビデ"],["に"],["言った","いった"],["、"],["「"],["無事","ぶじ"],["に"],["行き","いき"],["なさい"],["。"],["われわれ"],["ふたり"],["は"],["、"],["『"],["主","しゅ"],["が"],["常","つね"],["に"],["わたし"],["と"],["あなた"],["の"],["間","あいだ"],["に"],["おられ"],["、"],["また"],["、"],["わたし"],["の"],["子孫","しそん"],["と"],["あなた"],["の"],["子孫","しそん"],["の"],["間","あいだ"],["に"],["おられる"],["』"],["と"],["言って","いって"],["、"],["主","しゅ"],["の"],["名","な"],["を"],["さして"],["誓った","ちかった"],["の"],["です"],["」"],["。"]]}]
[{"verse":1,"text":"サムエルは年老,としおいて、その子,こらをイスラエルのさばきづかさとした。","tok":[["サムエル"],["は"],["年老いて","としおいて"],["、"],["その"],["子","こ"],["ら"],["を"],["イスラエル"],["の"],["さばき"],["づかさ"],["と"],["した"],["。"]]},{"verse":2,"text":"長子,ちょうしの名,なはヨエルといい、次,つぎの子,この名,なはアビヤと言,いった。彼,かれらはベエルシバでさばきづかさであった。","tok":[["長子","ちょうし"],["の"],["名","な"],["は"],["ヨエル"],["と"],["いい"],["、"],["次","つぎ"],["の"],["子","こ"],["の"],["名","な"],["は"],["アビヤ"],["と"],["言った","いった"],["。"],["彼","かれ"],["ら"],["は"],["ベエルシバ"],["で"],["さばき"],["づかさ"],["で"],["あった"],["。"]]},{"verse":3,"text":"しかしその子,こらは父,ちちの道,みちを歩,あゆまないで、利,りにむかい、まいないを取,とって、さばきを曲,まげた。","tok":[["しかし"],["その"],["子","こ"],["ら"],["は"],["父","ちち"],["の"],["道","みち"],["を"],["歩まないで","あゆまないで"],["、"],["利","り"],["に"],["むかい"],["、"],["まいない"],["を"],["取って","とって"],["、"],["さばき"],["を"],["曲げた","まげた"],["。"]]},{"verse":4,"text":"この時,とき、イスラエルの長老,ちょうろうたちはみな集,あつまってラマにおるサムエルのもとにきて、","tok":[["この"],["時","とき"],["、"],["イスラエル"],["の"],["長老","ちょうろう"],["たち"],["は"],["みな"],["集まって","あつまって"],["ラマ"],["に"],["おる"],["サムエル"],["の"],["もと"],["に"],["きて"],["、"]]},{"verse":5,"text":"言,いった、「あなたは年老,としおい、あなたの子,こたちはあなたの道,みちを歩,あゆまない。今,いまほかの国々,くにぐにのように、われわれをさばく王,おうを、われわれのために立,たててください」。","tok":[["言った","いった"],["、"],["「"],["あなた"],["は"],["年老い","としおい"],["、"],["あなた"],["の"],["子","こ"],["たち"],["は"],["あなた"],["の"],["道","みち"],["を"],["歩まない","あゆまない"],["。"],["今","いま"],["ほか"],["の"],["国々","くにぐに"],["の"],["よう"],["に"],["、"],["われわれ"],["を"],["さばく"],["王","おう"],["を"],["、"],["われわれ"],["の"],["ため"],["に"],["立てて","たてて"],["ください"],["」"],["。"]]},{"verse":6,"text":"しかし彼,かれらが、「われわれをさばく王,おうを、われわれに与,あたえよ」と言,いうのを聞,きいて、サムエルは喜,よろこばなかった。そしてサムエルが主,しゅに祈,いのると、","tok":[["しかし"],["彼","かれ"],["ら"],["が"],["、"],["「"],["われわれ"],["を"],["さばく"],["王","おう"],["を"],["、"],["われわれ"],["に"],["与","あたえ"],["よ"],["」"],["と"],["言う","いう"],["の"],["を"],["聞いて","きいて"],["、"],["サムエル"],["は"],["喜こばなかった","よろこばなかった"],["。"],["そして"],["サムエル"],["が"],["主に","しゅに"],["祈る","いのる"],["と"],["、"]]},{"verse":7,"text":"主,しゅはサムエルに言,いわれた、「民,たみが、すべてあなたに言,いう所,ところの声,こえに聞,きき従,したがいなさい。彼,かれらが捨,すてるのはあなたではなく、わたしを捨,すてて、彼,かれらの上,うえにわたしが王,おうであることを認,みとめないのである。","tok":[["主","しゅ"],["は"],["サムエル"],["に"],["言われた","いわれた"],["、"],["「"],["民","た"],["み"],["が"],["、"],["すべて"],["あなた"],["に"],["言う","いう"],["所","ところ"],["の"],["声","こえ"],["に"],["聞","きき"],["従い","したがい"],["なさい"],["。"],["彼","かれ"],["ら"],["が"],["捨てる","すてる"],["の"],["は"],["あなた"],["で"],["は"],["なく"],["、"],["わたし"],["を"],["捨てて","すてて"],["、"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["わたし"],["が"],["王","おう"],["で"],["ある"],["こと"],["を"],["認めない","みとめない"],["ので"],["ある"],["。"]]},{"verse":8,"text":"彼,かれらは、わたしがエジプトから連,つれ上,のぼった日,ひから、きょうまで、わたしを捨,すててほかの神々,かみがみに仕,つかえ、さまざまの事,ことをわたしにしたように、あなたにもしているのである。","tok":[["彼","かれ"],["ら"],["は"],["、"],["わたし"],["が"],["エジプト"],["から"],["連れ上った","つれのぼった"],["日","ひ"],["から"],["、"],["きょう"],["まで"],["、"],["わたし"],["を"],["捨てて","すてて"],["ほか"],["の"],["神々","かみがみ"],["に"],["仕え","つかえ"],["、"],["さまざま"],["の"],["事","こと"],["を"],["わたし"],["に"],["した"],["よう"],["に"],["、"],["あなた"],["に"],["も"],["して"],["いる"],["ので"],["ある"],["。"]]},{"verse":9,"text":"今,いまその声,こえに聞,きき従,したがいなさい。ただし、深,ふかく彼,かれらを戒,いましめて、彼,かれらを治,おさめる王,おうのならわしを彼,かれらに示,しめさなければならない」。","tok":[["今","いま"],["その"],["声","こえ"],["に"],["聞","きき"],["従い","したがい"],["なさい"],["。"],["ただし"],["、"],["深く","ふかく"],["彼","かれ"],["ら"],["を"],["戒しめ","いましめ"],["て"],["、"],["彼","かれ"],["ら"],["を"],["治める","おさめる"],["王","おう"],["の"],["ならわし"],["を"],["彼","かれ"],["ら"],["に"],["示めさなければ","しめさなければ"],["ならない"],["」"],["。"]]},{"verse":10,"text":"サムエルは王,おうを立,たてることを求,もとめる民,たみに主,しゅの言葉,ことばをことごとく告,つげて、","tok":[["サムエル"],["は"],["王","おう"],["を"],["立る","たてる"],["こと"],["を"],["求める","もとめる"],["民","たみ"],["に"],["主","しゅ"],["の"],["言葉","ことば"],["を"],["ことごとく"],["告","つげ"],["て"],["、"]]},{"verse":11,"text":"言,いった、「あなたがたを治,おさめる王,おうのならわしは次,つぎのとおりである。彼,かれはあなたがたのむすこを取,とって、戦車,せんしゃ隊,たいに入,いれ、騎兵,きへいとし、自分,じぶんの戦車,せんしゃの前,まえに走,はしらせるであろう。","tok":[["言った","いった"],["、"],["「"],["あなた"],["がた"],["を"],["治める","おさめる"],["王","おう"],["の"],["ならわし"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["彼","かれ"],["は"],["あなた"],["がた"],["の"],["むすこ"],["を"],["取って","とって"],["、"],["戦車隊","せんしゃたい"],["に"],["入れ","いれ"],["、"],["騎兵","きへい"],["と"],["し"],["、"],["自分","じぶん"],["の"],["戦車","せんしゃ"],["の"],["前","まえ"],["に"],["走らせるで","はしらせるで"],["あろう"],["。"]]},{"verse":12,"text":"彼,かれはまたそれを千人,にんの長,ちょう、五十人,にんの長,ちょうに任,にんじ、またその地,ちを耕,たがやさせ、その作物,さくもつを刈,からせ、またその武器,ぶきと戦車,せんしゃの装備,そうびを造,つくらせるであろう。","tok":[["彼","かれ"],["は"],["また"],["それ"],["を"],["千人","にん"],["の"],["長う","ちょう"],["、"],["五","ご"],["十人","じゅうにん"],["の"],["長","ちょう"],["に"],["任じ","にんじ"],["、"],["また"],["その"],["地","ち"],["を"],["耕やさせ","たがやさせ"],["、"],["その"],["作物","さくもつ"],["を"],["刈らせ","からせ"],["、"],["また"],["その"],["武器","ぶき"],["と"],["戦車","せんしゃ"],["の"],["装備","そうび"],["を"],["造らせるで","つくらせるで"],["あろう"],["。"]]},{"verse":13,"text":"また、あなたがたの娘,むすめを取,とって、香,こうをつくる者,ものとし、料理,りょうりをする者,ものとし、パンを焼,やく者,ものとするであろう。","tok":[["また"],["、"],["あなた"],["がた"],["の"],["娘","むすめ"],["を"],["取って","とって"],["、"],["香","こう"],["を"],["つくる"],["者","もの"],["と"],["し"],["、"],["料理","りょうり"],["を"],["する"],["者","もの"],["と"],["し"],["、"],["パン"],["を"],["焼く","やく"],["者","もの"],["と"],["するで"],["あろう"],["。"]]},{"verse":14,"text":"また、あなたがたの畑,はたけとぶどう畑,はたけとオリブ畑,はたけの最,もっとも良,よい物,ものを取,とって、その家来,けらいに与,あたえ、","tok":[["また"],["、"],["あなた"],["がた"],["の"],["畑","はたけ"],["と"],["ぶどう"],["畑","はたけ"],["と"],["オリブ"],["畑","はたけ"],["の"],["最も","もっとも"],["良い","よい"],["物","もの"],["を"],["取って","とって"],["、"],["その"],["家来","けらい"],["に"],["与","あたえ"],["、"]]},{"verse":15,"text":"あなたがたの穀物,こくもつと、ぶどう畑,はたけの、十分,ぶんの一を取,とって、その役人,やくにんと家来,けらいに与,あたえ、","tok":[["あなた"],["がた"],["の"],["穀物","こくもつ"],["と"],["、"],["ぶどう"],["畑","はたけ"],["の"],["、"],["十分","ぶん"],["の"],["一","いち"],["を"],["取って","とって"],["、"],["その"],["役人","やくにん"],["と"],["家来","けらい"],["に"],["与","あたえ"],["、"]]},{"verse":16,"text":"また、あなたがたの男女,だんじょの奴隷,どれいおよび、あなたがたの最,もっとも良,よい牛,うしとろばを取,とって、自分,じぶんのために働,はたらかせ、","tok":[["また"],["、"],["あなた"],["がた"],["の"],["男女","だんじょ"],["の"],["奴隷","どれい"],["および"],["、"],["あなた"],["がた"],["の"],["最も","もっとも"],["良い","よい"],["牛","うし"],["と"],["ろば"],["を"],["取って","とって"],["、"],["自分","じぶん"],["の"],["ため"],["に"],["働かせ","はたらかせ"],["、"]]},{"verse":17,"text":"また、あなたがたの羊,ひつじの十分,ぶんの一を取,とり、あなたがたは、その奴隷,どれいとなるであろう。","tok":[["また"],["、"],["あなた"],["がた"],["の"],["羊","ひつじ"],["の"],["十分","ぶん"],["の"],["一","いち"],["を"],["取","とり"],["、"],["あなた"],["がた"],["は"],["、"],["その"],["奴隷","どれい"],["と"],["なるで"],["あろう"],["。"]]},{"verse":18,"text":"そしてその日,ひあなたがたは自分,じぶんのために選,えらんだ王,おうのゆえに呼,よばわるであろう。しかし主,しゅはその日,ひにあなたがたに答,こたえられないであろう」。","tok":[["そして"],["その"],["日","ひ"],["あなた"],["がた"],["は"],["自分","じぶん"],["の"],["ため"],["に"],["選らんだ","えらんだ"],["王","おう"],["の"],["ゆえ"],["に"],["呼ばわるで","よばわるで"],["あろう"],["。"],["しかし"],["主","しゅ"],["は"],["その"],["日","ひ"],["に"],["あなた"],["がた"],["に"],["答","こたえ"],["られないで"],["あろう"],["」"],["。"]]},{"verse":19,"text":"ところが民,たみはサムエルの声,こえに聞,きき従,したがうことを拒,こばんで言,いった、「いいえ、われわれを治,おさめる王,おうがなければならない。","tok":[["ところ"],["が"],["民","たみ"],["は"],["サムエル"],["の"],["声","こえ"],["に"],["聞","きき"],["従う","したがう"],["こと"],["を"],["拒んで","こばんで"],["言った","いった"],["、"],["「"],["いいえ"],["、"],["われわれ"],["を"],["治める","おさめる"],["王","おう"],["が"],["なければ"],["ならない"],["。"]]},{"verse":20,"text":"われわれも他,たの国々,くにぐにのようになり、王,おうがわれわれをさばき、われわれを率,ひきいて、われわれの戦,たたかいにたたかうのである」。","tok":[["われわれ"],["も"],["他","た"],["の"],["国々","くにぐに"],["の"],["よう"],["に"],["なり"],["、"],["王","おう"],["が"],["われわれ"],["を"],["さばき"],["、"],["われわれ"],["を"],["率いて","ひきいて"],["、"],["われわれ"],["の"],["戦い","たたかい"],["に"],["たたかう"],["ので"],["ある"],["」"],["。"]]},{"verse":21,"text":"サムエルは民,たみの言葉,ことばをことごとく聞,きいて、それを主,しゅの耳,みみに告,つげた。","tok":[["サムエル"],["は"],["民","たみ"],["の"],["言葉","ことば"],["を"],["ことごとく"],["聞いて","きいて"],["、"],["それ"],["を"],["主","しゅ"],["の"],["耳","みみ"],["に"],["告","つげ"],["た"],["。"]]},{"verse":22,"text":"主,しゅはサムエルに言,いわれた、「彼,かれらの声,こえに聞,きき従,したがい、彼,かれらのために王,おうを立,たてよ」。サムエルはイスラエルの人々,ひとびとに言,いった、「あなたがたは、めいめいその町,まちに帰,かえりなさい」。","tok":[["主","しゅ"],["は"],["サムエル"],["に"],["言われた","いわれた"],["、"],["「"],["彼","かれ"],["ら"],["の"],["声","こえ"],["に"],["聞","きき"],["従い","したがい"],["、"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["王","おう"],["を"],["立よ","たてよ"],["」"],["。"],["サムエル"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["、"],["めいめい"],["その"],["町","まち"],["に"],["帰えり","かえり"],["なさい"],["」"],["。"]]}]
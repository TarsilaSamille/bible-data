[{"verse":1,"text":"その時,ときサムエルは油,あぶらのびんを取,とって、サウルの頭,あたまに注,そそぎ、彼,かれに口,くちづけして言,いった、「主,しゅはあなたに油,あぶらを注,そそいで、その民,たみイスラエルの君,きみとされたではありませんか。あなたは主,しゅの民,たみを治,おさめ、周囲,しゅういの敵,てきの手,てから彼,かれらを救,すくわなければならない。主,しゅがあなたに油,あぶらを注,そそいで、その嗣,し業,ぎょうの君,きみとされたことの、しるしは次,つぎのとおりです。","tok":[["その"],["時","とき"],["サムエル"],["は"],["油","あぶら"],["の"],["びん"],["を"],["取って","とって"],["、"],["サウル"],["の"],["頭","あたま"],["に"],["注ぎ","そそぎ"],["、"],["彼","かれ"],["に"],["口づけ","くちづけ"],["して"],["言った","いった"],["、"],["「"],["主","しゅ"],["は"],["あなた"],["に"],["油","あぶら"],["を"],["注いで","そそいで"],["、"],["その"],["民","た"],["みイスラエル"],["の"],["君","きみ"],["と"],["されたで"],["は"],["ありません"],["か"],["。"],["あなた"],["は"],["主","しゅ"],["の"],["民","たみ"],["を"],["治め","おさめ"],["、"],["周囲","しゅうい"],["の"],["敵","てき"],["の"],["手","て"],["から"],["彼","かれ"],["ら"],["を"],["救わなければ","すくわなければ"],["ならない"],["。"],["主","しゅ"],["が"],["あなた"],["に"],["油","あぶら"],["を"],["注いで","そそいで"],["、"],["その"],["嗣業","しぎょう"],["の"],["君","きみ"],["と"],["された"],["こと"],["の"],["、"],["しるし"],["は"],["次","つぎ"],["の"],["とおり"],["です"],["。"]]},{"verse":2,"text":"あなたがきょう、わたしを離,はなれて、去,さって行,いくとき、ベニヤミンの領地,りょうちのゼルザにあるラケルの墓,はかのかたわらで、ふたりの人,ひとに会,あうでしょう。そして彼,かれらはあなたに言,いいます、『あなたが捜,さがしに行,いかれたろばは見,みつかりました。いま父上,ちちうえは、ろばよりもあなたがたの事,ことを心配,しんぱいして、「わが子,このことは、どうしよう」と言,いっておられます』。","tok":[["あなた"],["が"],["きょう"],["、"],["わたし"],["を"],["離れて","はなれて"],["、"],["去て","さって"],["行く","いく"],["とき"],["、"],["ベニヤミン"],["の"],["領地","りょうち"],["の"],["ゼルザ"],["に"],["ある"],["ラケル"],["の"],["墓","はか"],["の"],["かたわら"],["で"],["、"],["ふたり"],["の"],["人","ひと"],["に"],["会うでしょう","あうでしょう"],["。"],["そして"],["彼","かれ"],["ら"],["は"],["あなた"],["に"],["言います","いいます"],["、"],["『"],["あなた"],["が"],["捜し","さがし"],["に"],["行かれた","いかれた"],["ろば"],["は"],["見つかりました","みつかりました"],["。"],["いま"],["父上","ちちうえ"],["は"],["、"],["ろば"],["より"],["も"],["あなた"],["がた"],["の"],["事","こと"],["を"],["心配","しんぱい"],["して"],["、"],["「"],["わが"],["子","こ"],["の"],["こと"],["は"],["、"],["どう"],["しよう"],["」"],["と"],["言って","いって"],["おられます"],["』"],["。"]]},{"verse":3,"text":"あなたが、そこからなお進,すすんで、タボルのかしの木,きの所,ところへ行,いくと、そこでベテルに上,のぼって神,かみを拝,おがもうとする三人,にんの者,ものに会,あうでしょう。ひとりは三頭,とうの子,こやぎを連,つれ、ひとりは三つのパンを携,たずさえ、ひとりは、ぶどう酒,しゅのはいった皮,かわ袋,ぶくろ一つを携,たずさえている。","tok":[["あなた"],["が"],["、"],["そこ"],["から"],["なお"],["進んで","すすんで"],["、"],["タボル"],["の"],["かし"],["の"],["木","き"],["の"],["所","ところ"],["へ"],["行く","いく"],["と"],["、"],["そこ"],["で"],["ベテル"],["に"],["上って","のぼって"],["神","かみ"],["を"],["拝もう","おがもう"],["と"],["する"],["三人","にん"],["の"],["者","もの"],["に"],["会うでしょう","あうでしょう"],["。"],["ひとり"],["は"],["三頭","とう"],["の"],["子やぎ","こやぎ"],["を"],["連れ","つれ"],["、"],["ひとり"],["は"],["三","みっ"],["つ"],["の"],["パン"],["を"],["携え","たずさえ"],["、"],["ひとり"],["は"],["、"],["ぶどう酒","ぶどうしゅ"],["の"],["はいった"],["皮袋","かわぶくろ"],["一","ひと"],["つ"],["を"],["携えて","たずさえて"],["いる"],["。"]]},{"verse":4,"text":"彼,かれらはあなたにあいさつし、二つのパンをくれるでしょう。あなたはそれを、その手,てから受,うけなければならない。","tok":[["彼","かれ"],["ら"],["は"],["あなた"],["に"],["あいさつ"],["し"],["、"],["二","ふた"],["つ"],["の"],["パン"],["を"],["くれるでしょう"],["。"],["あなた"],["は"],["それ"],["を"],["、"],["その"],["手","て"],["から"],["受けなければ","うけなければ"],["ならない"],["。"]]},{"verse":5,"text":"その後,のち、あなたは神,かみのギベアへ行,いく。そこはペリシテびとの守備,しゅび兵,へいのいる所,ところである。あなたはその所,ところへ行,いって、町,まちにはいる時,とき、立琴,たてごと、手,て鼓,つづみ、笛,ふえ、琴,ことを執,とる人々,ひとびとを先,さきに行,いかせて、預言,よげんしながら高,たかき所,ところから降,ふりてくる一群,いちぐんの預言者,よげんしゃに会,あうでしょう。","tok":[["その後","そのの"],["ち"],["、"],["あなた"],["は"],["神","かみ"],["の"],["ギベア"],["へ"],["行く","いく"],["。"],["そこ"],["は"],["ペリシテ"],["びと"],["の"],["守備","しゅび"],["兵","へい"],["の"],["いる"],["所","ところ"],["で"],["ある"],["。"],["あなた"],["は"],["その"],["所","ところ"],["へ"],["行って","いって"],["、"],["町","まち"],["に"],["は"],["いる"],["時","とき"],["、"],["立琴","たてごと"],["、"],["手","て"],["鼓","つづみ"],["、"],["笛","ふえ"],["、"],["琴","こと"],["を"],["執る","とる"],["人々","ひとびと"],["を"],["先","さき"],["に"],["行かせて","いかせて"],["、"],["預言","よげん"],["し"],["ながら"],["高き","たかき"],["所","ところ"],["から"],["降りて","ふりて"],["くる"],["一群","いちぐん"],["の"],["預言者","よげんしゃ"],["に"],["会うでしょう","あうでしょう"],["。"]]},{"verse":6,"text":"その時,とき、主,しゅの霊,れいがあなたの上,うえにもはげしく下,くだって、あなたは彼,かれらと一緒,いっしょに預言,よげんし、変,かわって新,あたらしい人,ひととなるでしょう。","tok":[["その"],["時","とき"],["、"],["主","しゅ"],["の"],["霊","れい"],["が"],["あなた"],["の"],["上","うえ"],["に"],["も"],["はげしく"],["下って","くだって"],["、"],["あなた"],["は"],["彼","かれ"],["ら"],["と"],["一緒","いっしょ"],["に"],["預言","よげん"],["し"],["、"],["変わって","かわって"],["新らしい","あたらしい"],["人","ひと"],["と"],["なるでしょう"],["。"]]},{"verse":7,"text":"これらのしるしが、あなたの身,みに起,たったならば、あなたは手当,てあたりしだいになんでもしなさい。神,かみがあなたと一緒,いっしょにおられるからです。","tok":[["これ"],["ら"],["の"],["しるし"],["が"],["、"],["あなた"],["の"],["身","み"],["に"],["起ったならば","たったならば"],["、"],["あなた"],["は"],["手当たり","てあたり"],["しだい"],["に"],["なん"],["で"],["も"],["し"],["なさい"],["。"],["神","かみ"],["が"],["あなた"],["と"],["一緒","いっしょ"],["に"],["おられる"],["から"],["です"],["。"]]},{"verse":8,"text":"あなたはわたしに先立,さきだってギルガルに下,くだらなければならない。わたしはあなたのもとに下,くだっていって、燔祭,はんさいを供,そなえ、酬恩祭,しゅうおんさいをささげるでしょう。わたしがあなたのもとに行,いって、あなたのしなければならない事,ことをあなたに示,しめすまで、七日,なぬかのあいだ待,またなければならない」。","tok":[["あなた"],["は"],["わたし"],["に"],["先立って","さきだって"],["ギルガル"],["に"],["下らなければ","くだらなければ"],["ならない"],["。"],["わたし"],["は"],["あなた"],["の"],["もと"],["に"],["下って","くだって"],["いって"],["、"],["燔祭","はんさい"],["を"],["供え","そなえ"],["、"],["酬恩祭","しゅうおんさい"],["を"],["ささげるでしょう"],["。"],["わたし"],["が"],["あなた"],["の"],["もと"],["に"],["行って","いって"],["、"],["あなた"],["の"],["しなければ"],["ならない"],["事","こと"],["を"],["あなた"],["に"],["示めす","しめす"],["まで"],["、"],["七日","なぬか"],["の"],["あいだ"],["待たなければ","またなければ"],["ならない"],["」"],["。"]]},{"verse":9,"text":"サウルが背,せをかえしてサムエルを離,はなれたとき、神,かみは彼,かれに新,あたらしい心,こころを与,あたえられた。これらのしるしは皆,みなその日,ひに起,たった。","tok":[["サウル"],["が"],["背","せ"],["を"],["かえして"],["サムエル"],["を"],["離れた","はなれた"],["とき"],["、"],["神","かみ"],["は"],["彼","かれ"],["に"],["新らしい","あたらしい"],["心","こころ"],["を"],["与えられた","あたえられた"],["。"],["これ"],["ら"],["の"],["しるし"],["は"],["皆","みな"],["その"],["日","ひ"],["に"],["起った","たった"],["。"]]},{"verse":10,"text":"彼,かれらはギベアにきた時,とき、預言者,よげんしゃの一群,いちぐんに出会,であった。そして神,かみの霊,れいが、はげしくサウルの上,うえに下,くだり、彼,かれは彼,かれらのうちにいて預言,よげんした。","tok":[["彼","かれ"],["ら"],["は"],["ギベア"],["に"],["きた"],["時","とき"],["、"],["預言者","よげんしゃ"],["の"],["一群","いちぐん"],["に"],["出会った","であった"],["。"],["そして"],["神","かみ"],["の"],["霊","れい"],["が"],["、"],["はげしく"],["サウル"],["の"],["上","うえ"],["に"],["下り","くだり"],["、"],["彼","かれ"],["は"],["彼","かれ"],["ら"],["の"],["うち"],["に"],["いて"],["預言","よげん"],["した"],["。"]]},{"verse":11,"text":"もとからサウルを知,しっていた人々,ひとびとはみな、サウルが預言者,よげんしゃたちと共,ともに預言,よげんするのを見,みて互,たがいに言,いった、「キシの子,こに何事,なにごとが起,たったのか。サウルもまた預言者,よげんしゃたちのうちにいるのか」。","tok":[["もと"],["から"],["サウル"],["を"],["知って","しって"],["いた"],["人々","ひとびと"],["は"],["みな"],["、"],["サウル"],["が"],["預言者","よげんしゃ"],["たち"],["と"],["共","とも"],["に"],["預言","よげん"],["する"],["の"],["を"],["見て","みて"],["互","たがい"],["に"],["言った","いった"],["、"],["「"],["キシ"],["の"],["子","こ"],["に"],["何事","なにごと"],["が"],["起","たった"],["の"],["か"],["。"],["サウル"],["も"],["また"],["預言者","よげんしゃ"],["たち"],["の"],["うち"],["に"],["いる"],["の"],["か"],["」"],["。"]]},{"verse":12,"text":"その所,ところのひとりの者,ものが答,こたえた、「彼,かれらの父,ちちはだれなのか」。それで「サウルもまた預言者,よげんしゃたちのうちにいるのか」というのが、ことわざとなった。","tok":[["その"],["所","ところ"],["の"],["ひとり"],["の"],["者","もの"],["が"],["答","こたえ"],["た"],["、"],["「"],["彼","かれ"],["ら"],["の"],["父","ちち"],["は"],["だれ"],["な"],["の"],["か"],["」"],["。"],["それ"],["で"],["「"],["サウル"],["も"],["また"],["預言者","よげんしゃ"],["たち"],["の"],["うち"],["に"],["いる"],["の"],["か"],["」"],["と"],["いう"],["の"],["が"],["、"],["ことわざ"],["と"],["なった"],["。"]]},{"verse":13,"text":"サウルは預言,よげんすることを終,おえて、高,たかき所,ところへ行,いった。","tok":[["サウル"],["は"],["預言","よげん"],["する"],["こと"],["を"],["終えて","おえて"],["、"],["高き","たかき"],["所","ところ"],["へ"],["行った","いった"],["。"]]},{"verse":14,"text":"サウルのおじが、サウルとそのしもべとに言,いった、「あなたがたは、どこへ行,いったのか」。サウルは言,いった、「ろばを捜,さがしにいったのですが、どこにもいないので、サムエルのもとに行,いきました」。","tok":[["サウル"],["の"],["おじ"],["が"],["、"],["サウル"],["と"],["その"],["しもべ"],["と"],["に"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["、"],["どこ"],["へ"],["行った","いった"],["の"],["か"],["」"],["。"],["サウル"],["は"],["言った","いった"],["、"],["「"],["ろば"],["を"],["捜し","さがし"],["に"],["いった"],["の"],["です"],["が"],["、"],["どこ"],["に"],["も"],["いない"],["ので"],["、"],["サムエル"],["の"],["もと"],["に"],["行きました","いきました"],["」"],["。"]]},{"verse":15,"text":"サウルのおじは言,いった、「サムエルが、どんなことを言,いったか、どうぞ話,はなしてください」。","tok":[["サウル"],["の"],["おじ"],["は"],["言った","いった"],["、"],["「"],["サムエル"],["が"],["、"],["どんな"],["こと"],["を"],["言った","いった"],["か"],["、"],["どうぞ"],["話","はなし"],["て"],["ください"],["」"],["。"]]},{"verse":16,"text":"サウルはおじに言,いった、「ろばが見,みつかったと、はっきり、わたしたちに言,いいました」。しかしサムエルが言,いった王国,おうこくのことについて、おじには何,なにも告,つげなかった。","tok":[["サウル"],["は"],["おじ"],["に"],["言った","いった"],["、"],["「"],["ろば"],["が"],["見つかった","みつかった"],["と"],["、"],["はっきり"],["、"],["わたしたち"],["に"],["言いました","いいました"],["」"],["。"],["しかし"],["サムエル"],["が"],["言った","いった"],["王国","おうこく"],["の"],["こと"],["について"],["、"],["おじ"],["に"],["は"],["何に","なに"],["も"],["告","つげ"],["なかった"],["。"]]},{"verse":17,"text":"さて、サムエルは民,たみをミヅパで主,しゅの前,まえに集,あつめ、","tok":[["さて"],["、"],["サムエル"],["は"],["民","たみ"],["を"],["ミヅパ"],["で"],["主","しゅ"],["の"],["前","まえ"],["に"],["集め","あつめ"],["、"]]},{"verse":18,"text":"イスラエルの人々,ひとびとに言,いった、「イスラエルの神,かみ、主,しゅはこう仰,おおせられる、『わたしはイスラエルをエジプトから導,みちびき出,だし、あなたがたをエジプトびとの手,て、およびすべてあなたがたをしえたげる王国,おうこくの手,てから救,すくい出,だした』。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["に"],["言った","いった"],["、"],["「"],["イスラエル"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["こう"],["仰せられる","おおせられる"],["、"],["『"],["わたし"],["は"],["イスラエル"],["を"],["エジプト"],["から"],["導き出し","みちびきだし"],["、"],["あなた"],["がた"],["を"],["エジプト"],["びと"],["の"],["手","て"],["、"],["および"],["すべて"],["あなた"],["がた"],["を"],["し"],["えたげる"],["王国","おうこく"],["の"],["手","て"],["から"],["救い出した","すくいだした"],["』"],["。"]]},{"verse":19,"text":"しかしあなたがたは、きょう、あなたがたをその悩,なやみと苦,くるしみの中,なかから救,すくわれるあなたがたの神,かみを捨,すて、その上,うえ、『いいえ、われわれの上,うえに王,おうを立,たてよ』と言,いう。それゆえ今,いま、あなたがたは、部族,ぶぞくにしたがい、また氏族,しぞくにしたがって、主,しゅの前,まえに出,でなさい」。","tok":[["しかし"],["あなた"],["がた"],["は"],["、"],["きょう"],["、"],["あなた"],["がた"],["を"],["その"],["悩み","なやみ"],["と"],["苦しみ","くるしみ"],["の"],["中","なか"],["から"],["救われる","すくわれる"],["あなた"],["がた"],["の"],["神","かみ"],["を"],["捨て","すて"],["、"],["その"],["上","うえ"],["、"],["『"],["いいえ"],["、"],["われわれ"],["の"],["上","うえ"],["に"],["王","おう"],["を"],["立よ","たてよ"],["』"],["と"],["言う","いう"],["。"],["それ"],["ゆえ"],["今","いま"],["、"],["あなた"],["がた"],["は"],["、"],["部族","ぶぞく"],["に"],["したがい"],["、"],["また"],["氏族","しぞく"],["に"],["したがって"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["出","で"],["なさい"],["」"],["。"]]},{"verse":20,"text":"こうしてサムエルがイスラエルのすべての部族,ぶぞくを呼,よび寄,よせた時,とき、ベニヤミンの部族,ぶぞくが、くじに当,あたった。","tok":[["こう"],["して"],["サムエル"],["が"],["イスラエル"],["の"],["すべて"],["の"],["部族","ぶぞく"],["を"],["呼び寄せた","よびよせた"],["時","とき"],["、"],["ベニヤミン"],["の"],["部族","ぶぞく"],["が"],["、"],["くじ"],["に"],["当たった","あたった"],["。"]]},{"verse":21,"text":"またベニヤミンの部族,ぶぞくをその氏族,しぞくにしたがって呼,よび寄,よせた時,とき、マテリの氏族,しぞくが、くじに当,あたり、マテリの氏族,しぞくを人,ひとごとに呼,よび寄,よせた時,とき、キシの子,こサウルが、くじに当,あたった。しかし人々,ひとびとが彼,かれを捜,さがした時,とき、見,みつからなかった。","tok":[["また"],["ベニヤミン"],["の"],["部族","ぶぞく"],["を"],["その"],["氏族","しぞく"],["に"],["したがって"],["呼び寄せた","よびよせた"],["時","とき"],["、"],["マテリ"],["の"],["氏族","しぞく"],["が"],["、"],["くじ"],["に"],["当たり","あたり"],["、"],["マテリ"],["の"],["氏族","しぞく"],["を"],["人ごと","ひとごと"],["に"],["呼び寄せた","よびよせた"],["時","とき"],["、"],["キシ"],["の"],["子","こ"],["サウル"],["が"],["、"],["くじ"],["に"],["当たった","あたった"],["。"],["しかし"],["人々","ひとびと"],["が"],["彼","かれ"],["を"],["捜した","さがした"],["時","とき"],["、"],["見つからなかった","みつからなかった"],["。"]]},{"verse":22,"text":"そこでまた主,しゅに「その人,ひとはここにきているのですか」と問,とうと、主,しゅは言,いわれた、「彼,かれは荷物,にもつの間,あいだに隠,かくれている」。","tok":[["そこ"],["で"],["また"],["主に","しゅに"],["「"],["その"],["人","ひと"],["は"],["ここ"],["に"],["きて"],["いる"],["の"],["です"],["か"],["」"],["と"],["問う","とう"],["と"],["、"],["主","しゅ"],["は"],["言われた","いわれた"],["、"],["「"],["彼","かれ"],["は"],["荷物","にもつ"],["の"],["間","あいだ"],["に"],["隠れて","かくれて"],["いる"],["」"],["。"]]},{"verse":23,"text":"人々,ひとびとは走,はしって行,いって、彼,かれをそこから連,つれてきた。彼,かれは民,たみの中,なかに立,たったが、肩,かたから上,うえは、民,たみのどの人,ひとよりも高,たかかった。","tok":[["人々","ひとびと"],["は"],["走って","はしって"],["行って","いって"],["、"],["彼","かれ"],["を"],["そこ"],["から"],["連れて","つれて"],["きた"],["。"],["彼","かれ"],["は"],["民","たみ"],["の"],["中","なか"],["に"],["立った","たった"],["が"],["、"],["肩","かた"],["から"],["上","うえ"],["は"],["、"],["民","たみのど"],["の"],["人","ひと"],["より"],["も"],["高かかった","たかかった"],["。"]]},{"verse":24,"text":"サムエルはすべての民,たみに言,いった、「主,しゅが選,えらばれた人,ひとをごらんなさい。民,たみのうちに彼,かれのような人,ひとはないではありませんか」。民,たみはみな「王,おう万歳,ばんざい」と叫,さけんだ。","tok":[["サムエル"],["は"],["すべて"],["の"],["民","たみ"],["に"],["言った","いった"],["、"],["「"],["主","しゅ"],["が"],["選ら","えら"],["ばれた"],["人","ひと"],["を"],["ごらん"],["なさい"],["。"],["民","たみ"],["の"],["うち"],["に"],["彼","かれ"],["の"],["よう"],["な"],["人","ひと"],["は"],["ないで"],["は"],["ありません"],["か"],["」"],["。"],["民","たみ"],["は"],["みな"],["「"],["王","おう"],["万歳","ばんざい"],["」"],["と"],["叫けんだ","さけんだ"],["。"]]},{"verse":25,"text":"その時,ときサムエルは王国,おうこくのならわしを民,たみに語,かたり、それを書,しょにしるして、主,しゅの前,まえにおさめた。こうしてサムエルはすべての民,たみをそれぞれ家,いえに帰,かえらせた。","tok":[["その"],["時","とき"],["サムエル"],["は"],["王国","おうこく"],["の"],["ならわし"],["を"],["民","たみ"],["に"],["語り","かたり"],["、"],["それ"],["を"],["書","しょ"],["に"],["しるして"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["おさめた"],["。"],["こう"],["して"],["サムエル"],["は"],["すべて"],["の"],["民","たみ"],["を"],["それぞれ"],["家","いえ"],["に"],["帰えらせた","かえらせた"],["。"]]},{"verse":26,"text":"サウルもまたギベアにある彼,かれの家,いえに帰,かえった。そして神,かみにその心,こころを動,うごかされた勇士,ゆうしたちも彼,かれと共,ともに行,いった。","tok":[["サウル"],["も"],["また"],["ギベア"],["に"],["ある"],["彼","かれ"],["の"],["家","いえ"],["に"],["帰えった","かえった"],["。"],["そして"],["神","かみ"],["に"],["その"],["心","こころ"],["を"],["動かされた","うごかされた"],["勇士","ゆうし"],["たち"],["も"],["彼","かれ"],["と"],["共","とも"],["に"],["行った","いった"],["。"]]},{"verse":27,"text":"しかし、よこしまな人々,ひとびとは「この男,おとこがどうしてわれわれを救,すくうことができよう」と言,いって、彼,かれを軽,かろんじ、贈,おくり物,ものをしなかった。しかしサウルは黙,だまっていた。","tok":[["しかし"],["、"],["よこしま"],["な"],["人々","ひとびと"],["は"],["「"],["この"],["男","おとこ"],["が"],["どう"],["して"],["われわれ"],["を"],["救う","すくう"],["こと"],["が"],["できよう"],["」"],["と"],["言って","いって"],["、"],["彼","かれ"],["を"],["軽んじ","かろんじ"],["、"],["贈り物","おくりもの"],["を"],["しなかった"],["。"],["しかし"],["サウル"],["は"],["黙って","だまって"],["いた"],["。"]]}]
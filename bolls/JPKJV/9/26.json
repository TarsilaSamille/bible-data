[{"verse":1,"text":"そのころジフびとがギベアにおるサウルのもとにきて言,いった、「ダビデは荒野,あらのの前,まえにあるハキラの山,やまに隠,かくれているではありませんか」。","tok":[["その"],["ころ"],["ジフ"],["びと"],["が"],["ギベア"],["に"],["おる"],["サウル"],["の"],["もと"],["に"],["きて"],["言った","いった"],["、"],["「"],["ダビデ"],["は"],["荒野","あら"],["の"],["の"],["前","まえ"],["に"],["ある"],["ハキラ"],["の"],["山","やま"],["に"],["隠れて","かくれて"],["いるで"],["は"],["ありません"],["か"],["」"],["。"]]},{"verse":2,"text":"サウルは立,たって、ジフの荒野,あらのでダビデを捜,さがすために、イスラエルのうちから選,えらんだ三千人,にんをひき連,つれて、ジフの荒野,あらのに下,くだった。","tok":[["サウル"],["は"],["立って","たって"],["、"],["ジフ"],["の"],["荒野","あらの"],["で"],["ダビデ"],["を"],["捜す","さがす"],["ため"],["に"],["、"],["イスラエル"],["の"],["うち"],["から"],["選らんだ","えらんだ"],["三千人","にん"],["を"],["ひき連れて","ひきつれて"],["、"],["ジフ"],["の"],["荒野","あらの"],["に"],["下った","くだった"],["。"]]},{"verse":3,"text":"サウルは荒野,あらのの前,まえの道,みちのかたわらにあるハキラの山,やまに陣,じんを取,とった。ダビデは荒野,あらのにとどまっていたが、サウルが自分,じぶんのあとを追,おって荒野,あらのにきたのを見,みて、","tok":[["サウル"],["は"],["荒野","あら"],["の"],["の"],["前","まえ"],["の"],["道","みち"],["の"],["かたわら"],["に"],["ある"],["ハキラ"],["の"],["山","やま"],["に"],["陣","じん"],["を"],["取った","とった"],["。"],["ダビデ"],["は"],["荒野","あら"],["のに"],["とどまって"],["いた"],["が"],["、"],["サウル"],["が"],["自分","じぶん"],["の"],["あと"],["を"],["追って","おって"],["荒野","あら"],["のに"],["きた"],["の"],["を"],["見て","みて"],["、"]]},{"verse":4,"text":"斥候,せっこうを出,だし、サウルが確,たしかにきたのを知,しった。","tok":[["斥候","せっこう"],["を"],["出し","だし"],["、"],["サウル"],["が"],["確か","たしか"],["に"],["きた"],["の"],["を"],["知った","しった"],["。"]]},{"verse":5,"text":"そしてダビデは立,たって、サウルが陣,じんを取,とっている所,ところへ行,いって、サウルとその軍,ぐんの長,ちょう、ネルの子,こアブネルの寝,ねている場所,ばしょを見,みた。サウルは陣所,じんしょのうちに寝,ねていて、民,たみはその周囲,しゅういに宿営,しゅくえいしていた。","tok":[["そして"],["ダビデ"],["は"],["立って","たって"],["、"],["サウル"],["が"],["陣","じん"],["を"],["取って","とって"],["いる"],["所","ところ"],["へ"],["行って","いって"],["、"],["サウル"],["と"],["その"],["軍","ぐん"],["の"],["長う","ちょう"],["、"],["ネル"],["の"],["子","こ"],["アブネル"],["の"],["寝て","ねて"],["いる"],["場所","ばしょ"],["を"],["見た","みた"],["。"],["サウル"],["は"],["陣所","じんしょ"],["の"],["うち"],["に"],["寝て","ねて"],["いて"],["、"],["民","たみ"],["は"],["その"],["周囲","しゅうい"],["に"],["宿営","しゅくえい"],["して"],["いた"],["。"]]},{"verse":6,"text":"ダビデは、ヘテびとアヒメレク、およびゼルヤの子,こで、ヨアブの兄弟,きょうだいであるアビシャイに言,いった、「だれがわたしと共,ともにサウルの陣,じんに下,くだって行,いくか」。アビシャイは言,いった、「わたしが一緒,いっしょに下,くだって行,いきます」。","tok":[["ダビデ"],["は"],["、"],["ヘテ"],["びと"],["アヒメレク"],["、"],["および"],["ゼルヤ"],["の"],["子","こ"],["で"],["、"],["ヨアブ"],["の"],["兄弟","きょうだい"],["で"],["ある"],["アビシャイ"],["に"],["言った","いった"],["、"],["「"],["だれ"],["が"],["わたし"],["と"],["共","とも"],["に"],["サウル"],["の"],["陣","じん"],["に"],["下って","くだって"],["行く","いく"],["か"],["」"],["。"],["アビシャイ"],["は"],["言った","いった"],["、"],["「"],["わたし"],["が"],["一緒","いっしょ"],["に"],["下って","くだって"],["行きます","いきます"],["」"],["。"]]},{"verse":7,"text":"こうしてダビデとアビシャイとが夜,よる、民,たみのところへ行,いってみると、サウルは陣所,じんしょのうちに身,みを横,よこたえて寝,ねており、そのやりは枕,まくらもとに地,ちに突,つきさしてあった。そしてアブネルと民,たみらとはその周囲,しゅういに寝,ねていた。","tok":[["こう"],["して"],["ダビデ"],["と"],["アビシャイ"],["と"],["が"],["夜","よる"],["、"],["民","たみ"],["の"],["ところ"],["へ"],["行って","いって"],["みる"],["と"],["、"],["サウル"],["は"],["陣所","じんしょ"],["の"],["うち"],["に"],["身","み"],["を"],["横たえて","よこたえて"],["寝て","ねて"],["おり"],["、"],["その"],["やり"],["は"],["枕もと","まくらもと"],["に"],["地","ち"],["に"],["突きさして","つきさして"],["あった"],["。"],["そして"],["アブネル"],["と"],["民","たみ"],["ら"],["と"],["は"],["その"],["周囲","しゅうい"],["に"],["寝て","ねて"],["いた"],["。"]]},{"verse":8,"text":"アビシャイはダビデに言,いった、「神,かみはきょう敵,てきをあなたの手,てに渡,わたされました。どうぞわたしに、彼,かれのやりをもってひと突,つきで彼,かれを地,ちに刺,さしとおさせてください。ふたたび突,つくには及,およびません」。","tok":[["アビシャイ"],["は"],["ダビデ"],["に"],["言った","いった"],["、"],["「"],["神","かみ"],["は"],["きょう"],["敵","てき"],["を"],["あなた"],["の"],["手","て"],["に"],["渡されました","わたされました"],["。"],["どうぞ"],["わたし"],["に"],["、"],["彼","かれ"],["の"],["やり"],["を"],["もって"],["ひと"],["突き","つき"],["で"],["彼","かれ"],["を"],["地","ち"],["に"],["刺","さし"],["と"],["おさせて"],["ください"],["。"],["ふたたび"],["突く","つく"],["に"],["は"],["及","および"],["ません"],["」"],["。"]]},{"verse":9,"text":"しかしダビデはアビシャイに言,いった、「彼,かれを殺,ころしてはならない。主,しゅが油,あぶらを注,そそがれた者,ものに向,むかって、手,てをのべ、罪,つみを得,えない者,ものがあろうか」。","tok":[["しかし"],["ダビデ"],["は"],["アビシャイ"],["に"],["言った","いった"],["、"],["「"],["彼","かれ"],["を"],["殺ろし","ころし"],["ては"],["ならない"],["。"],["主","しゅ"],["が"],["油","あぶら"],["を"],["注がれた","そそがれた"],["者","もの"],["に"],["向かって","むかって"],["、"],["手","て"],["を"],["のべ"],["、"],["罪","つみ"],["を"],["得ない","えない"],["者","もの"],["が"],["あろう"],["か"],["」"],["。"]]},{"verse":10,"text":"ダビデはまた言,いった、「主,しゅは生,いきておられる。主,しゅが彼,かれを撃,うたれるであろう。あるいは彼,かれの死,しぬ日,ひが来,くるであろう。あるいは戦,たたかいに下,くだって行,いって滅,ほろびるであろう。","tok":[["ダビデ"],["は"],["また"],["言った","いった"],["、"],["「"],["主","しゅ"],["は"],["生きて","いきて"],["おられる"],["。"],["主","しゅ"],["が"],["彼","かれ"],["を"],["撃たれるで","うたれるで"],["あろう"],["。"],["あるいは"],["彼","かれ"],["の"],["死ぬ","しぬ"],["日","ひ"],["が"],["来るで","くるで"],["あろう"],["。"],["あるいは"],["戦い","たたかい"],["に"],["下って","くだって"],["行って","いって"],["滅びるで","ほろびるで"],["あろう"],["。"]]},{"verse":11,"text":"主,しゅが油,あぶらを注,そそがれた者,ものに向,むかって、わたしが手,てをのべることを主,しゅは禁,きんじられる。しかし今,いま、そのまくらもとにあるやりと水,みずのびんを取,とりなさい。そしてわれわれは去,さろう」。","tok":[["主","しゅ"],["が"],["油","あぶら"],["を"],["注がれた","そそがれた"],["者","もの"],["に"],["向かって","むかって"],["、"],["わたし"],["が"],["手","て"],["を"],["のべる"],["こと"],["を"],["主","しゅ"],["は"],["禁じられる","きんじられる"],["。"],["しかし"],["今","いま"],["、"],["その"],["まくらもと"],["に"],["ある"],["やり"],["と"],["水","みず"],["の"],["びん"],["を"],["取","とり"],["なさい"],["。"],["そして"],["われわれ"],["は"],["去ろう","さろう"],["」"],["。"]]},{"verse":12,"text":"こうしてダビデはサウルの枕,まくらもとから、やりと水,みずのびんを取,とって彼,かれらは去,さったが、だれもそれを見,みず、だれも知,しらず、また、だれも目,めをさまさず、みな眠,ねむっていた。主,しゅが彼,かれらを深,ふかく眠,ねむらされたからである。","tok":[["こう"],["して"],["ダビデ"],["は"],["サウル"],["の"],["枕もと","まくらもと"],["から"],["、"],["やり"],["と"],["水","みず"],["の"],["びん"],["を"],["取って","とって"],["彼","かれ"],["ら"],["は"],["去た","さった"],["が"],["、"],["だれ"],["も"],["それ"],["を"],["見ず","みず"],["、"],["だれ"],["も"],["知らず","しらず"],["、"],["また"],["、"],["だれ"],["も"],["目","め"],["を"],["さまさず"],["、"],["みな"],["眠って","ねむって"],["いた"],["。"],["主","しゅ"],["が"],["彼","かれ"],["ら"],["を"],["深く","ふかく"],["眠らされた","ねむらされた"],["から"],["で"],["ある"],["。"]]},{"verse":13,"text":"ダビデは向,むこう側,がわに渡,わたって行,いって、遠,とおく離,はなれて山,やまの頂,いただきに立,たった。彼,かれらの間,あいだの隔,へだたりは大,おおきかった。","tok":[["ダビデ"],["は"],["向こう側","むこうがわ"],["に"],["渡って","わたって"],["行って","いって"],["、"],["遠く","とおく"],["離れて","はなれて"],["山","やま"],["の"],["頂","いただき"],["に"],["立った","たった"],["。"],["彼","かれ"],["ら"],["の"],["間","あいだ"],["の"],["隔たり","へだたり"],["は"],["大きかった","おおきかった"],["。"]]},{"verse":14,"text":"ダビデは民,たみとネルの子,こアブネルに呼,よばわって言,いった、「アブネルよ、あなたは答,こたえないのか」。アブネルは答,こたえて言,いった、「王,おうを呼,よんでいるあなたはだれか」。","tok":[["ダビデ"],["は"],["民","たみ"],["と"],["ネル"],["の"],["子","こ"],["アブネル"],["に"],["呼ばわって","よばわって"],["言った","いった"],["、"],["「"],["アブネル"],["よ"],["、"],["あなた"],["は"],["答","こたえ"],["ない"],["の"],["か"],["」"],["。"],["アブネル"],["は"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["王","おう"],["を"],["呼んで","よんで"],["いる"],["あなた"],["は"],["だれ"],["か"],["」"],["。"]]},{"verse":15,"text":"ダビデはアブネルに言,いった、「あなたは男,おとこではないか。イスラエルのうちに、あなたに及,およぶ人,ひとがあろうか。それであるのに、どうしてあなたは主君,しゅくんである王,おうを守,まもらなかったのか。民,たみのひとりが、あなたの主君,しゅくんである王,おうを殺,ころそうとして、はいりこんだではないか。","tok":[["ダビデ"],["は"],["アブネル"],["に"],["言った","いった"],["、"],["「"],["あなた"],["は"],["男","おとこ"],["で"],["は"],["ない"],["か"],["。"],["イスラエル"],["の"],["うち"],["に"],["、"],["あなた"],["に"],["及ぶ","およぶ"],["人","ひと"],["が"],["あろう"],["か"],["。"],["それ"],["で"],["ある"],["のに"],["、"],["どう"],["して"],["あなた"],["は"],["主君","しゅくん"],["で"],["ある"],["王","おう"],["を"],["守らなかった","まもらなかった"],["の"],["か"],["。"],["民","たみ"],["の"],["ひとり"],["が"],["、"],["あなた"],["の"],["主君","しゅくん"],["で"],["ある"],["王","おう"],["を"],["殺そう","ころそう"],["として"],["、"],["はいりこんだで"],["は"],["ない"],["か"],["。"]]},{"verse":16,"text":"あなたがしたこの事,ことは良,よくない。主,しゅは生,いきておられる。あなたがたは、まさに死,しに値,あたいする。主,しゅが油,あぶらをそそがれた、あなたの主君,しゅくんを守,まもらなかったからだ。いま王,おうのやりがどこにあるか。その枕,まくらもとにあった水,みずのびんがどこにあるかを見,みなさい」。","tok":[["あなた"],["が"],["した"],["この"],["事","こと"],["は"],["良く","よく"],["ない"],["。"],["主","しゅ"],["は"],["生きて","いきて"],["おられる"],["。"],["あなた"],["がた"],["は"],["、"],["まさに"],["死に","しに"],["値","あたい"],["する"],["。"],["主","しゅ"],["が"],["油","あぶら"],["を"],["そそがれた"],["、"],["あなた"],["の"],["主君","しゅくん"],["を"],["守らなかった","まもらなかった"],["から"],["だ"],["。"],["いま"],["王","おう"],["の"],["やり"],["が"],["どこ"],["に"],["ある"],["か"],["。"],["その"],["枕もと","まくらもと"],["に"],["あった"],["水","みず"],["の"],["びん"],["が"],["どこ"],["に"],["ある"],["か"],["を"],["見","み"],["なさい"],["」"],["。"]]},{"verse":17,"text":"サウルはダビデの声,こえを聞,ききわけて言,いった、「わが子,こダビデよ、これはあなたの声,こえか」。ダビデは言,いった、「王,おう、わが君,きみよ、わたしの声,こえです」。","tok":[["サウル"],["は"],["ダビデ"],["の"],["声","こえ"],["を"],["聞","きき"],["わけて"],["言った","いった"],["、"],["「"],["わが"],["子","こ"],["ダビデ"],["よ"],["、"],["これ"],["は"],["あなた"],["の"],["声","こえ"],["か"],["」"],["。"],["ダビデ"],["は"],["言った","いった"],["、"],["「"],["王","おう"],["、"],["わが"],["君","きみ"],["よ"],["、"],["わたし"],["の"],["声","こえ"],["です"],["」"],["。"]]},{"verse":18,"text":"ダビデはまた言,いった、「わが君,きみはどうしてしもべのあとを追,おわれるのですか。わたしが何,なにをしたのですか。わたしの手,てになんのわるいことがあるのですか。","tok":[["ダビデ"],["は"],["また"],["言った","いった"],["、"],["「"],["わが"],["君","きみ"],["は"],["どう"],["して"],["しもべ"],["の"],["あと"],["を"],["追われる","おわれる"],["の"],["です"],["か"],["。"],["わたし"],["が"],["何に","なに"],["を"],["した"],["の"],["です"],["か"],["。"],["わたし"],["の"],["手","て"],["に"],["なん"],["の"],["わるい"],["こと"],["が"],["ある"],["の"],["です"],["か"],["。"]]},{"verse":19,"text":"王,おう、わが君,きみよ、どうぞ、今,いましもべの言葉,ことばを聞,きいてください。もし主,しゅがあなたを動,うごかして、わたしの敵,てきとされたのであれば、どうぞ主,しゅが供,そなえ物,ものを受,うけて和,やわらいでくださるように。もし、それが人,ひとであるならば、どうぞその人々,ひとびとが主,しゅの前,まえにのろいを受,うけるように。彼,かれらが『おまえは行,いって他,たの神々,かみがみに仕,つかえなさい』と言,いって、きょう、わたしを追,おい出,だし、主,しゅの嗣,し業,ぎょうにあずかることができないようにしたからです。","tok":[["王","おう"],["、"],["わが"],["君","きみ"],["よ"],["、"],["どうぞ"],["、"],["今","いま"],["しもべ"],["の"],["言葉","ことば"],["を"],["聞いて","きいて"],["ください"],["。"],["もし"],["主","しゅ"],["が"],["あなた"],["を"],["動かして","うごかして"],["、"],["わたし"],["の"],["敵","てき"],["と"],["された"],["ので"],["あれば"],["、"],["どうぞ"],["主","しゅ"],["が"],["供え物","そなえもの"],["を"],["受て","うけて"],["和らいで","やわらいで"],["くださる"],["よう"],["に"],["。"],["もし"],["、"],["それ"],["が"],["人","ひと"],["で"],["あるならば"],["、"],["どうぞ"],["その"],["人々","ひとびと"],["が"],["主","しゅ"],["の"],["前","まえ"],["に"],["のろい"],["を"],["受る","うける"],["よう"],["に"],["。"],["彼","かれ"],["ら"],["が"],["『"],["おまえ"],["は"],["行って","いって"],["他","た"],["の"],["神々","かみがみ"],["に"],["仕え","つかえ"],["なさい"],["』"],["と"],["言って","いって"],["、"],["きょう"],["、"],["わたし"],["を"],["追い出し","おいだし"],["、"],["主","しゅ"],["の"],["嗣業","しぎょう"],["に"],["あずかる"],["こと"],["が"],["できない"],["よう"],["に"],["した"],["から"],["です"],["。"]]},{"verse":20,"text":"それゆえ今,いま、主,しゅの前,まえを離,はなれて、わたしの血,ちが地,ちに落,おちることのないようにしてください。イスラエルの王,おうは、人,ひとが山,やまで、しゃこを追,おうように、わたしの命,いのちを取,とろうとして出,でてこられたのです」。","tok":[["それ"],["ゆえ"],["今","いま"],["、"],["主","しゅ"],["の"],["前","まえ"],["を"],["離れて","はなれて"],["、"],["わたし"],["の"],["血","ち"],["が"],["地","ち"],["に"],["落","おち"],["る"],["こと"],["の"],["ない"],["よう"],["に"],["して"],["ください"],["。"],["イスラエル"],["の"],["王","おう"],["は"],["、"],["人","ひと"],["が"],["山","やま"],["で"],["、"],["しゃこ"],["を"],["追う","おう"],["よう"],["に"],["、"],["わたし"],["の"],["命","いのち"],["を"],["取ろう","とろう"],["として"],["出て","でて"],["こられた"],["の"],["です"],["」"],["。"]]},{"verse":21,"text":"その時,とき、サウルは言,いった、「わたしは罪,つみを犯,おかした。わが子,こダビデよ、帰,かえってきてください。きょう、わたしの命,いのちがあなたの目,めに尊,たっとく見,みられたゆえ、わたしは、もはやあなたに害,がいを加,くわえないであろう。わたしは愚,おろかなことをして、非常,ひじょうなまちがいをした」。","tok":[["その"],["時","とき"],["、"],["サウル"],["は"],["言った","いった"],["、"],["「"],["わたし"],["は"],["罪","つみ"],["を"],["犯した","おかした"],["。"],["わが"],["子","こ"],["ダビデ"],["よ"],["、"],["帰えって","かえって"],["きて"],["ください"],["。"],["きょう"],["、"],["わたし"],["の"],["命","いのち"],["が"],["あなた"],["の"],["目","め"],["に"],["尊","た"],["っと"],["く"],["見られた","みられた"],["ゆえ"],["、"],["わたし"],["は"],["、"],["もはや"],["あなた"],["に"],["害","がい"],["を"],["加えないで","くわえないで"],["あろう"],["。"],["わたし"],["は"],["愚か","おろか"],["な"],["こと"],["を"],["して"],["、"],["非常","ひじょう"],["な"],["まちがい"],["を"],["した"],["」"],["。"]]},{"verse":22,"text":"ダビデは答,こたえた、「王,おうのやりは、ここにあります。ひとりの若者,わかものに渡,わたってこさせ、これを持,もちかえらせてください。","tok":[["ダビデ"],["は"],["答","こたえ"],["た"],["、"],["「"],["王","おう"],["の"],["やり"],["は"],["、"],["ここ"],["に"],["あります"],["。"],["ひとり"],["の"],["若者","わかもの"],["に"],["渡って","わたって"],["こさせ"],["、"],["これ"],["を"],["持","もち"],["かえらせて"],["ください"],["。"]]},{"verse":23,"text":"主,しゅは人,ひとおのおのにその義,ぎと真実,しんじつとに従,したがって報,むくいられます。主,しゅがきょう、あなたをわたしの手,てに渡,わたされたのに、わたしは主,しゅが油,あぶらを注,そそがれた者,ものに向,むかって、手,てをのべることをしなかったのです。","tok":[["主","しゅ"],["は"],["人","ひと"],["おのおの"],["に"],["その"],["義","ぎ"],["と"],["真実","しんじつ"],["と"],["に"],["従って","したがって"],["報いられます","むくいられます"],["。"],["主","しゅ"],["が"],["きょう"],["、"],["あなた"],["を"],["わたし"],["の"],["手","て"],["に"],["渡された","わたされた"],["のに"],["、"],["わたし"],["は"],["主","しゅ"],["が"],["油","あぶら"],["を"],["注がれた","そそがれた"],["者","もの"],["に"],["向かって","むかって"],["、"],["手","て"],["を"],["のべる"],["こと"],["を"],["しなかった"],["の"],["です"],["。"]]},{"verse":24,"text":"きょう、わたしがあなたの命,いのちを重,おもんじたように、どうぞ主,しゅがわたしの命,いのちを重,おもんじて、もろもろの苦難,くなんから救,すくい出,だしてくださるように」。","tok":[["きょう"],["、"],["わたし"],["が"],["あなた"],["の"],["命","いのち"],["を"],["重じた","おもんじた"],["よう"],["に"],["、"],["どうぞ"],["主","しゅ"],["が"],["わたし"],["の"],["命","いのち"],["を"],["重じて","おもんじて"],["、"],["もろもろ"],["の"],["苦難","くなん"],["から"],["救い出して","すくいだして"],["くださる"],["よう"],["に"],["」"],["。"]]},{"verse":25,"text":"サウルはダビデに言,いった、「わが子,こダビデよ、あなたはほむべきかな。あなたは多,おおくの事,ことをおこなって、それをなし遂,とげるであろう」。こうしてダビデはその道,みちを行,いき、サウルは自分,じぶんの所,ところへ帰,かえった。","tok":[["サウル"],["は"],["ダビデ"],["に"],["言った","いった"],["、"],["「"],["わが"],["子","こ"],["ダビデ"],["よ"],["、"],["あなた"],["は"],["ほ"],["むべき"],["か"],["な"],["。"],["あなた"],["は"],["多く","おおく"],["の"],["事","こと"],["を"],["おこなって"],["、"],["それ"],["を"],["なし遂げるで","なしとげるで"],["あろう"],["」"],["。"],["こう"],["して"],["ダビデ"],["は"],["その"],["道","みち"],["を"],["行き","いき"],["、"],["サウル"],["は"],["自分","じぶん"],["の"],["所","ところ"],["へ"],["帰えった","かえった"],["。"]]}]
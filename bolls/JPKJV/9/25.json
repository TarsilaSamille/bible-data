[{"verse":1,"text":"さてサムエルが死,しんだので、イスラエルの人々,ひとびとはみな集,あつまって、彼,かれのためにひじょうに悲,かなしみ、ラマにあるその家,いえに彼,かれを葬,ほうむった。そしてダビデは立,たってパランの荒野,あらのに下,くだって行,いった。","tok":[["さて"],["サムエル"],["が"],["死んだ","しんだ"],["ので"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["みな"],["集まって","あつまって"],["、"],["彼","かれ"],["の"],["ため"],["に"],["ひじょう"],["に"],["悲しみ","かなしみ"],["、"],["ラマ"],["に"],["ある"],["その"],["家","いえ"],["に"],["彼","かれ"],["を"],["葬むった","ほうむった"],["。"],["そして"],["ダビデ"],["は"],["立って","たって"],["パラン"],["の"],["荒野","あらの"],["に"],["下って","くだって"],["行った","いった"],["。"]]},{"verse":2,"text":"マオンに、ひとりの人,ひとがあって、カルメルにその所有,しょゆうがあり、ひじょうに裕福,ゆうふくで、羊,ひつじ三千頭,とう、やぎ一千頭,とうを持,もっていた。彼,かれはカルメルで羊,ひつじの毛,けを切,きっていた。","tok":[["マオン"],["に"],["、"],["ひとり"],["の"],["人","ひと"],["が"],["あって"],["、"],["カルメル"],["に"],["その"],["所有","しょゆう"],["が"],["あり"],["、"],["ひじょう"],["に"],["裕福","ゆうふく"],["で"],["、"],["羊","ひつじ"],["三千頭","と"],["う"],["、"],["やぎ"],["一千頭","とう"],["を"],["持って","もって"],["いた"],["。"],["彼","かれ"],["は"],["カルメル"],["で"],["羊","ひつじ"],["の"],["毛","け"],["を"],["切って","きって"],["いた"],["。"]]},{"verse":3,"text":"その人,ひとの名,なはナバルといい、妻,つまの名,なはアビガイルといった。アビガイルは賢,かしこくて美,うつくしかったが、その夫,おっとは剛情,ごうじょうで、粗暴,そぼうであった。彼,かれはカレブびとであった。","tok":[["その"],["人","ひと"],["の"],["名","な"],["は"],["ナバル"],["と"],["いい"],["、"],["妻","つま"],["の"],["名","な"],["は"],["アビガイル"],["と"],["いった"],["。"],["アビガイル"],["は"],["賢しこくて","かしこくて"],["美しかった","うつくしかった"],["が"],["、"],["その"],["夫","おっと"],["は"],["剛","ごう"],["情","じょう"],["で"],["、"],["粗暴","そぼう"],["で"],["あった"],["。"],["彼","かれ"],["は"],["カレブ"],["びと"],["で"],["あった"],["。"]]},{"verse":4,"text":"ダビデは荒野,あらのにいて、ナバルがその羊,ひつじの毛,けを切,きっていることを聞,きいたので、","tok":[["ダビデ"],["は"],["荒野","あら"],["のに"],["いて"],["、"],["ナバル"],["が"],["その"],["羊","ひつじ"],["の"],["毛","け"],["を"],["切って","きって"],["いる"],["こと"],["を"],["聞いた","きいた"],["ので"],["、"]]},{"verse":5,"text":"十人,にんの若者,わかものをつかわし、その若者,わかものたちに言,いった、「カルメルに上,のぼって行,いってナバルの所,ところへ行,いき、わたしの名,なをもって彼,かれにあいさつし、","tok":[["十人","にん"],["の"],["若者","わかもの"],["を"],["つかわし"],["、"],["その"],["若者","わかもの"],["たち"],["に"],["言った","いった"],["、"],["「"],["カルメル"],["に"],["上って","のぼって"],["行って","いって"],["ナバル"],["の"],["所","ところ"],["へ"],["行き","いき"],["、"],["わたし"],["の"],["名","な"],["を"],["もって"],["彼","かれ"],["に"],["あいさつ"],["し"],["、"]]},{"verse":6,"text":"彼,かれにこう言,いいなさい、『どうぞあなたに平安,へいあんがあるように。あなたの家,いえに平安,へいあんがあるように。またあなたのすべての持,もち物,ものに平安,へいあんがあるように。","tok":[["彼","かれ"],["に"],["こう"],["言い","いい"],["なさい"],["、"],["『"],["どうぞ"],["あなた"],["に"],["平安","へいあん"],["が"],["ある"],["よう"],["に"],["。"],["あなた"],["の"],["家","いえ"],["に"],["平安","へいあん"],["が"],["ある"],["よう"],["に"],["。"],["また"],["あなた"],["の"],["すべて"],["の"],["持物","もちもの"],["に"],["平安","へいあん"],["が"],["ある"],["よう"],["に"],["。"]]},{"verse":7,"text":"わたしはあなたが羊,ひつじの毛,けを切,きっておられることを聞,ききました。あなたの羊飼,ひつじかいたちはわれわれと一緒,いっしょにいたのですが、われわれは彼,かれらを少,すこしも害,がいしませんでした。また彼,かれらはカルメルにいる間,あいだに、何,なにひとつ失,うしなったことはありません。","tok":[["わたし"],["は"],["あなた"],["が"],["羊","ひつじ"],["の"],["毛","け"],["を"],["切って","きって"],["おられる"],["こと"],["を"],["聞","きき"],["ました"],["。"],["あなた"],["の"],["羊飼","ひつじかい"],["たち"],["は"],["われわれ"],["と"],["一緒","いっしょ"],["に"],["いた"],["の"],["です"],["が"],["、"],["われわれ"],["は"],["彼","かれ"],["ら"],["を"],["少し","すこし"],["も"],["害しませんでした","がいしませんでした"],["。"],["また"],["彼","かれ"],["ら"],["は"],["カルメル"],["に"],["いる"],["間","あいだ"],["に"],["、"],["何","な"],["に"],["ひと"],["つ"],["失なった","うしなった"],["こと"],["は"],["ありません"],["。"]]},{"verse":8,"text":"あなたの若者,わかものたちに聞,きいてみられるならば、わかります。それゆえ、わたしの若者,わかものたちに、あなたの好意,こういを示,しめしてください。われわれは祝,しゅくの日,ひにきたのです。どうぞ、あなたの手,てもとにあるものを、贈,おくり物,ものとして、しもべどもとあなたの子,こダビデにください』」。","tok":[["あなた"],["の"],["若者","わかもの"],["たち"],["に"],["聞いて","きいて"],["みられるならば"],["、"],["わかります"],["。"],["それ"],["ゆえ"],["、"],["わたし"],["の"],["若者","わかもの"],["たち"],["に"],["、"],["あなた"],["の"],["好意","こうい"],["を"],["示めして","しめして"],["ください"],["。"],["われわれ"],["は"],["祝","しゅく"],["の"],["日","ひ"],["に"],["きた"],["の"],["です"],["。"],["どうぞ"],["、"],["あなた"],["の"],["手もと","てもと"],["に"],["ある"],["もの"],["を"],["、"],["贈り物","おくりもの"],["として"],["、"],["しもべ"],["ども"],["と"],["あなた"],["の"],["子","こ"],["ダビデ"],["に"],["ください"],["』"],["」"],["。"]]},{"verse":9,"text":"ダビデの若者,わかものたちは行,いって、ダビデの名,なをもって、これらの言葉,ことばをナバルに語,かたり、そして待,まっていた。","tok":[["ダビデ"],["の"],["若者","わかもの"],["たち"],["は"],["行って","いって"],["、"],["ダビデ"],["の"],["名","な"],["を"],["もって"],["、"],["これ"],["ら"],["の"],["言葉","ことば"],["を"],["ナバル"],["に"],["語り","かたり"],["、"],["そして"],["待って","まって"],["いた"],["。"]]},{"verse":10,"text":"ナバルはダビデの若者,わかものたちに答,こたえて言,いった、「ダビデとはだれか。エッサイの子,ことはだれか。このごろは、主人,しゅじんを捨,すてて逃,にげるしもべが多,おおい。","tok":[["ナバル"],["は"],["ダビデ"],["の"],["若者","わかもの"],["たち"],["に"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["ダビデ"],["と"],["は"],["だれ"],["か"],["。"],["エッサイ"],["の"],["子","こ"],["と"],["は"],["だれ"],["か"],["。"],["このごろ"],["は"],["、"],["主人","しゅじん"],["を"],["捨てて","すてて"],["逃る","にげる"],["しもべ"],["が"],["多い","おおい"],["。"]]},{"verse":11,"text":"どうしてわたしのパンと水,みず、またわたしの羊,ひつじの毛,けを切,きる人々,ひとびとのためにほふった肉,にくをとって、どこからきたのかわからない人々,ひとびとに与,あたえることができようか」。","tok":[["どう"],["して"],["わたし"],["の"],["パン"],["と"],["水","みず"],["、"],["また"],["わたし"],["の"],["羊","ひつじ"],["の"],["毛","け"],["を"],["切る","きる"],["人々","ひとびと"],["の"],["ため"],["に"],["ほふった"],["肉","にく"],["を"],["とって"],["、"],["どこ"],["から"],["きた"],["の"],["か"],["わからない"],["人々","ひとびと"],["に"],["与える","あたえる"],["こと"],["が"],["できよう"],["か"],["」"],["。"]]},{"verse":12,"text":"ダビデの若者,わかものたちは、そこを去,さり、帰,かえってきて、彼,かれにこのすべての事,ことを告,つげた。","tok":[["ダビデ"],["の"],["若者","わかもの"],["たち"],["は"],["、"],["そこ"],["を"],["去り","さり"],["、"],["帰えって","かえって"],["きて"],["、"],["彼","かれ"],["に"],["この"],["すべて"],["の"],["事","こと"],["を"],["告","つげ"],["た"],["。"]]},{"verse":13,"text":"そこでダビデは従者,じゅうしゃたちに言,いった、「おのおの、つるぎを帯,おびなさい」。彼,かれらはおのおのつるぎを帯,おび、ダビデもまたつるぎを帯,おびた。そしておおよそ四百人,にんがダビデに従,したがって上,のぼっていき、二百人,にんは荷物,にもつのところにとどまった。","tok":[["そこ"],["で"],["ダビデ"],["は"],["従者","じゅうしゃ"],["たち"],["に"],["言った","いった"],["、"],["「"],["おのおの"],["、"],["つるぎ"],["を"],["帯","おび"],["なさい"],["」"],["。"],["彼","かれ"],["ら"],["は"],["おのおの"],["つるぎ"],["を"],["帯","おび"],["、"],["ダビデ"],["も"],["また"],["つるぎ"],["を"],["帯","おび"],["た"],["。"],["そして"],["おおよそ"],["四百人","にん"],["が"],["ダビデ"],["に"],["従って","したがって"],["上って","のぼって"],["いき"],["、"],["二百人","にん"],["は"],["荷物","にもつ"],["の"],["ところ"],["に"],["とどまった"],["。"]]},{"verse":14,"text":"ところで、ひとりの若者,わかものがナバルの妻,つまアビガイルに言,いった、「ダビデが荒野,あらのから使者,ししゃをつかわして、主人,しゅじんにあいさつをしたのに、主人,しゅじんはその使者,ししゃたちをののしられました。","tok":[["ところ"],["で"],["、"],["ひとり"],["の"],["若者","わかもの"],["が"],["ナバル"],["の"],["妻","つま"],["アビガイル"],["に"],["言った","いった"],["、"],["「"],["ダビデ"],["が"],["荒野","あらの"],["から"],["使者","ししゃ"],["を"],["つかわして"],["、"],["主人","しゅじん"],["に"],["あいさつ"],["を"],["した"],["のに"],["、"],["主人","しゅじん"],["は"],["その"],["使者","ししゃ"],["たち"],["を"],["ののしられました"],["。"]]},{"verse":15,"text":"しかし、あの人々,ひとびとはわれわれに大,だいへんよくしてくれて、われわれは少,すこしも害,がいを受,うけず、またわれわれが野,のにいた時,とき、彼,かれらと共,ともにいた間,あいだは、何,なにひとつ失,うしなったことはありませんでした。","tok":[["しかし"],["、"],["あの"],["人々","ひとびと"],["は"],["われわれ"],["に"],["大へん","だいへん"],["よく"],["して"],["くれて"],["、"],["われわれ"],["は"],["少し","すこし"],["も"],["害","がい"],["を"],["受ず","うけず"],["、"],["また"],["われわれ"],["が"],["野","の"],["に"],["いた"],["時","とき"],["、"],["彼","かれ"],["ら"],["と"],["共","とも"],["に"],["いた"],["間","あいだ"],["は"],["、"],["何","な"],["に"],["ひと"],["つ"],["失なった","うしなった"],["こと"],["は"],["ありませんでした"],["。"]]},{"verse":16,"text":"われわれが羊,ひつじを飼,かって彼,かれらと共,ともにいる間,あいだ、彼,かれらは夜,よるも昼,ひるもわれわれのかきとなってくれました。","tok":[["われわれ"],["が"],["羊","ひつじ"],["を"],["飼って","かって"],["彼","かれ"],["ら"],["と"],["共","とも"],["に"],["いる"],["間","あいだ"],["、"],["彼","かれ"],["ら"],["は"],["夜","よる"],["も"],["昼","ひる"],["も"],["われわれ"],["の"],["かき"],["と"],["なって"],["くれました"],["。"]]},{"verse":17,"text":"それで、あなたは今,いまそれを知,しって、自分,じぶんのすることを考,かんがえてください。主人,しゅじんとその一家,いっかに災,わざわいが起,おきるからです。しかも主人,しゅじんはよこしまな人,ひとで、話,はなしかけることもできません」。","tok":[["それ"],["で"],["、"],["あなた"],["は"],["今","いま"],["それ"],["を"],["知って","しって"],["、"],["自分","じぶん"],["の"],["する"],["こと"],["を"],["考","かんがえ"],["て"],["ください"],["。"],["主人","しゅじん"],["と"],["その"],["一家","いっか"],["に"],["災","わざわい"],["が"],["起きる","おきる"],["から"],["です"],["。"],["しかも"],["主人","しゅじん"],["は"],["よこしま"],["な"],["人","ひと"],["で"],["、"],["話かける","はなしかける"],["こと"],["も"],["できません"],["」"],["。"]]},{"verse":18,"text":"その時,とき、アビガイルは急,いそいでパン二百、ぶどう酒,しゅの皮,かわ袋,ぶくろ二つ、調理,ちょうりした羊,ひつじ五頭,とう、いり麦,むぎ五セア、ほしぶどう百ふさ、ほしいちじくのかたまり二百を取,とって、ろばにのせ、","tok":[["その"],["時","とき"],["、"],["アビガイル"],["は"],["急いで","いそいで"],["パン"],["二百","にひゃく"],["、"],["ぶどう酒","ぶどうしゅ"],["の"],["皮袋","かわぶくろ"],["二","ふた"],["つ"],["、"],["調理","ちょうり"],["した"],["羊","ひつじ"],["五頭","と"],["う"],["、"],["いり"],["麦","むぎ"],["五","ご"],["セア"],["、"],["ほし"],["ぶどう"],["百","ひゃく"],["ふ"],["さ"],["、"],["ほし"],["いちじく"],["の"],["かたまり"],["二百","にひゃく"],["を"],["取って","とって"],["、"],["ろば"],["に"],["のせ"],["、"]]},{"verse":19,"text":"若者,わかものたちに言,いった、「わたしのさきに進,すすみなさい。わたしはあなたがたのうしろに、ついて行,いきます」。しかし彼女,かのじょは夫,おっとナバルには告,つげなかった。","tok":[["若者","わかもの"],["たち"],["に"],["言った","いった"],["、"],["「"],["わたし"],["の"],["さき"],["に"],["進み","すすみ"],["なさい"],["。"],["わたし"],["は"],["あなた"],["がた"],["の"],["うしろ"],["に"],["、"],["ついて"],["行きます","いきます"],["」"],["。"],["しかし"],["彼女","かのじょ"],["は"],["夫","おっと"],["ナバル"],["に"],["は"],["告","つげ"],["なかった"],["。"]]},{"verse":20,"text":"アビガイルが、ろばに乗,のって山陰,やまかげを下,くだってきた時,とき、ダビデと従者,じゅうしゃたちは彼女,かのじょの方,ほうに向,むかって降,ふりてきたので、彼女,かのじょはその人々,ひとびとに出会,であった。","tok":[["アビガイル"],["が"],["、"],["ろば"],["に"],["乗って","のって"],["山陰","やまかげ"],["を"],["下って","くだって"],["きた"],["時","とき"],["、"],["ダビデ"],["と"],["従者","じゅうしゃ"],["たち"],["は"],["彼女","かのじょ"],["の"],["方","ほう"],["に"],["向かって","むかって"],["降","ふりてきた"],["ので"],["、"],["彼女","かのじょ"],["は"],["その"],["人々","ひとびと"],["に"],["出会った","であった"],["。"]]},{"verse":21,"text":"さて、ダビデはさきにこう言,いった、「わたしはこの人,ひとが荒野,あらので持,もっている物,ものをみな守,まもって、その人,ひとに属,ぞくする物,ものを何,なにひとつなくならないようにしたが、それは全,まったくむだであった。彼,かれはわたしのした親切,しんせつに悪,あくをもって報,むくいた。","tok":[["さて"],["、"],["ダビデ"],["は"],["さき"],["に"],["こう"],["言った","いった"],["、"],["「"],["わたし"],["は"],["この"],["人","ひと"],["が"],["荒野","あらの"],["で"],["持て","もって"],["いる"],["物","もの"],["を"],["みな"],["守って","まもって"],["、"],["その"],["人","ひと"],["に"],["属する","ぞくする"],["物","もの"],["を"],["何","な"],["に"],["ひと"],["つ"],["なくならない"],["よう"],["に"],["した"],["が"],["、"],["それ"],["は"],["全く","まったく"],["むだ"],["で"],["あった"],["。"],["彼","かれ"],["は"],["わたし"],["の"],["した"],["親切","しんせつ"],["に"],["悪","あく"],["を"],["もって"],["報いた","むくいた"],["。"]]},{"verse":22,"text":"もしわたしがあすの朝,あさまで、ナバルに属,ぞくするすべての者,もののうち、ひとりの男,おとこでも残,のこしておくならば、神,かみが幾重,いくえにもダビデを罰,ばっしてくださるように」。","tok":[["もし"],["わたし"],["が"],["あす"],["の"],["朝","あさ"],["まで"],["、"],["ナバル"],["に"],["属する","ぞくする"],["すべて"],["の"],["者","もの"],["の"],["うち"],["、"],["ひとり"],["の"],["男","おとこ"],["で"],["も"],["残して","のこして"],["おくならば"],["、"],["神","かみ"],["が"],["幾重","いくえ"],["に"],["も"],["ダビデ"],["を"],["罰して","ばっして"],["くださる"],["よう"],["に"],["」"],["。"]]},{"verse":23,"text":"アビガイルはダビデを見,みて、急,いそいで、ろばを降,ふり、ダビデの前,まえで地,ちにひれ伏,ふし、","tok":[["アビガイル"],["は"],["ダビデ"],["を"],["見て","みて"],["、"],["急いで","いそいで"],["、"],["ろば"],["を"],["降り","ふり"],["、"],["ダビデ"],["の"],["前","まえ"],["で"],["地","ち"],["に"],["ひれ伏し","ひれふし"],["、"]]},{"verse":24,"text":"その足,あしもとに伏,ふして言,いった、「わが君,きみよ、このとがをわたしだけに負,おわせてください。しかしどうぞ、はしために、あなたの耳,みみに語,かたることを許,ゆるし、はしための言葉,ことばをお聞,ききください。","tok":[["その"],["足もと","あしもと"],["に"],["伏して","ふして"],["言った","いった"],["、"],["「"],["わが"],["君","きみ"],["よ"],["、"],["この"],["とが"],["を"],["わたし"],["だけ"],["に"],["負わせて","おわせて"],["ください"],["。"],["しかし"],["どうぞ"],["、"],["はし"],["ため"],["に"],["、"],["あなた"],["の"],["耳","みみ"],["に"],["語る","かたる"],["こと"],["を"],["許し","ゆるし"],["、"],["はし"],["ため"],["の"],["言葉","ことば"],["を"],["お聞く","おききく"],["ださい"],["。"]]},{"verse":25,"text":"わが君,きみよ、どうぞ、このよこしまな人,ひとナバルのことを気,きにかけないでください。あの人,ひとはその名,なのとおりです。名,なはナバルで、愚,おろかな者,ものです。あなたのはしためであるわたしは、わが君,きみなるあなたがつかわされた若者,わかものたちを見,みなかったのです。","tok":[["わが"],["君","きみ"],["よ"],["、"],["どうぞ"],["、"],["この"],["よこしま"],["な"],["人","ひと"],["ナバル"],["の"],["こと"],["を"],["気","き"],["に"],["かけないで"],["ください"],["。"],["あの"],["人","ひと"],["は"],["その"],["名","な"],["の"],["とおり"],["です"],["。"],["名","な"],["は"],["ナバル"],["で"],["、"],["愚か","おろか"],["な"],["者","もの"],["です"],["。"],["あなた"],["の"],["はし"],["ため"],["で"],["ある"],["わたし"],["は"],["、"],["わが"],["君","きみ"],["なる"],["あなた"],["が"],["つかわされた"],["若者","わかもの"],["たち"],["を"],["見なかった","みなかった"],["の"],["です"],["。"]]},{"verse":26,"text":"それゆえ今,いま、わが君,きみよ、主,しゅは生,いきておられます。またあなたは生,いきておられます。主,しゅは、あなたがきて血,ちを流,ながし、また手,てずから、あだを報,むくいるのをとどめられました。どうぞ今,いま、あなたの敵,てき、およびわが君,きみに害,がいを加,くわえようとする者,ものは、ナバルのごとくになりますように。","tok":[["それ"],["ゆえ"],["今","いま"],["、"],["わが"],["君","きみ"],["よ"],["、"],["主","しゅ"],["は"],["生きて","いきて"],["おられます"],["。"],["また"],["あなた"],["は"],["生きて","いきて"],["おられます"],["。"],["主","しゅ"],["は"],["、"],["あなた"],["が"],["きて"],["血","ち"],["を"],["流し","ながし"],["、"],["また"],["手ずから","てずから"],["、"],["あだ"],["を"],["報いる","むくいる"],["の"],["を"],["とどめられました"],["。"],["どうぞ"],["今","いま"],["、"],["あなた"],["の"],["敵","てき"],["、"],["および"],["わが"],["君","きみ"],["に"],["害","がい"],["を"],["加えよう","くわえよう"],["と"],["する"],["者","もの"],["は"],["、"],["ナバル"],["の"],["ごとくに"],["なります"],["よう"],["に"],["。"]]},{"verse":27,"text":"今,いま、あなたのつかえめが、わが君,きみに携,たずさえてきた贈,おくり物,ものを、わが君,きみに従,したがう若者,わかものたちに与,あたえてください。","tok":[["今","いま"],["、"],["あなた"],["の"],["つかえ"],["め"],["が"],["、"],["わが"],["君","きみ"],["に"],["携えて","たずさえて"],["きた"],["贈り物","おくりもの"],["を"],["、"],["わが"],["君","きみ"],["に"],["従う","したがう"],["若者","わかもの"],["たち"],["に"],["与","あたえ"],["て"],["ください"],["。"]]},{"verse":28,"text":"どうぞ、はしためのとがを許,ゆるしてください。主,しゅは必,かならずわが君,きみのために確,たしかな家,いえを造,つくられるでしょう。わが君,きみが主,しゅのいくさを戦,たたかい、またこの世,よに生,いきながらえられる間,あいだ、あなたのうちに悪,わるいことが見,みいだされないからです。","tok":[["どうぞ"],["、"],["はし"],["ため"],["の"],["とが"],["を"],["許して","ゆるして"],["ください"],["。"],["主","しゅ"],["は"],["必","かならず"],["わが"],["君","きみ"],["の"],["ため"],["に"],["確か","たしか"],["な"],["家","いえ"],["を"],["造られるでしょう","つくられるでしょう"],["。"],["わが"],["君","きみ"],["が"],["主","しゅ"],["の"],["いくさ"],["を"],["戦い","たたかい"],["、"],["また"],["この世","このよ"],["に"],["生きながらえられる","いきながらえられる"],["間","あ"],["い"],["だ"],["、"],["あなた"],["の"],["うち"],["に"],["悪い","わるい"],["こと"],["が"],["見いだされない","みいだされない"],["から"],["です"],["。"]]},{"verse":29,"text":"たとい人,ひとが立,たってあなたを追,おい、あなたの命,いのちを求,もとめても、わが君,きみの命,いのちは、生,いきている者,ものの束,たばにたばねられて、あなたの神,かみ、主,しゅのもとに守,まもられるでしょう。しかし主,しゅはあなたの敵,てきの命,いのちを、石,いし投,なげの中,なかから投,なげるように、投,なげ捨,すてられるでしょう。","tok":[["たとい"],["人","ひと"],["が"],["立って","たって"],["あなた"],["を"],["追い","おい"],["、"],["あなた"],["の"],["命","いのち"],["を"],["求めて","もとめて"],["も"],["、"],["わが"],["君","きみ"],["の"],["命","いのち"],["は"],["、"],["生きて","いきて"],["いる"],["者","もの"],["の"],["束","たば"],["に"],["たばねられて"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["もと"],["に"],["守られるでしょう","まもられるでしょう"],["。"],["しかし"],["主","しゅ"],["は"],["あなた"],["の"],["敵","てき"],["の"],["命","いのち"],["を"],["、"],["石投","いしなげ"],["の"],["中","なか"],["から"],["投る","なげる"],["よう"],["に"],["、"],["投捨てられるでしょう","なげすてられるでしょう"],["。"]]},{"verse":30,"text":"そして主,しゅがあなたについて語,かたられたすべての良,よいことをわが君,きみに行,おこない、あなたをイスラエルのつかさに任,にんじられる時,とき、","tok":[["そして"],["主","しゅ"],["が"],["あなた"],["について"],["語られた","かたられた"],["すべて"],["の"],["良い","よい"],["こと"],["を"],["わが"],["君","きみ"],["に"],["行ない","おこない"],["、"],["あなた"],["を"],["イスラエル"],["の"],["つかさ"],["に"],["任じられる","にんじられる"],["時","とき"],["、"]]},{"verse":31,"text":"あなたが、ゆえなく血,ちを流,ながし、またわが君,きみがみずからあだを報,むくいたと言,いうことで、それがあなたのつまずきとなり、またわが君,きみの心,こころの責,せめとなることのないようにしてください。主,しゅがわが君,きみを良,よくせられる時,とき、このはしためを思,おもいだしてください」。","tok":[["あなた"],["が"],["、"],["ゆえ"],["なく"],["血","ち"],["を"],["流し","ながし"],["、"],["また"],["わが"],["君","きみ"],["が"],["みずから"],["あだ"],["を"],["報いた","むくいた"],["と"],["言う","いう"],["こと"],["で"],["、"],["それ"],["が"],["あなた"],["の"],["つまずき"],["と"],["なり"],["、"],["また"],["わが"],["君","きみ"],["の"],["心","こころ"],["の"],["責","せめ"],["と"],["なる"],["こと"],["の"],["ない"],["よう"],["に"],["して"],["ください"],["。"],["主","しゅ"],["が"],["わが"],["君","きみ"],["を"],["良く","よく"],["せられる"],["時","とき"],["、"],["この"],["はし"],["ため"],["を"],["思いだして","おもいだして"],["ください"],["」"],["。"]]},{"verse":32,"text":"ダビデはアビガイルに言,いった、「きょう、あなたをつかわして、わたしを迎,むかえさせられたイスラエルの神,かみ、主,しゅはほむべきかな。","tok":[["ダビデ"],["は"],["アビガイル"],["に"],["言った","いった"],["、"],["「"],["きょう"],["、"],["あなた"],["を"],["つかわして"],["、"],["わたし"],["を"],["迎","むかえ"],["させられた"],["イスラエル"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["ほ"],["むべき"],["か"],["な"],["。"]]},{"verse":33,"text":"あなたの知恵,ちえはほむべきかな。またあなたはほむべきかな。あなたは、きょう、わたしがきて血,ちを流,ながし、手,てずからあだを報,むくいることをとどめられたのです。","tok":[["あなた"],["の"],["知恵","ちえ"],["は"],["ほ"],["むべき"],["か"],["な"],["。"],["また"],["あなた"],["は"],["ほ"],["むべき"],["か"],["な"],["。"],["あなた"],["は"],["、"],["きょう"],["、"],["わたし"],["が"],["きて"],["血","ち"],["を"],["流し","ながし"],["、"],["手ずから","てずから"],["あだ"],["を"],["報いる","むくいる"],["こと"],["を"],["とどめられた"],["の"],["です"],["。"]]},{"verse":34,"text":"わたしがあなたを害,がいすることをとどめられたイスラエルの神,かみ、主,しゅはまことに生,いきておられる。もしあなたが急,いそいでわたしに会,あいにこなかったならば、あすの朝,あさまでには、ナバルのところに、ひとりの男,おとこも残,のこらなかったでしょう」。","tok":[["わたし"],["が"],["あなた"],["を"],["害する","がいする"],["こと"],["を"],["とどめられた"],["イスラエル"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["まこと"],["に"],["生きて","いきて"],["おられる"],["。"],["もし"],["あなた"],["が"],["急いで","いそいで"],["わたし"],["に"],["会い","あい"],["に"],["こなかったならば"],["、"],["あす"],["の"],["朝","あさ"],["まで"],["に"],["は"],["、"],["ナバル"],["の"],["ところ"],["に"],["、"],["ひとり"],["の"],["男","おとこ"],["も"],["残らなかったでしょう","のこらなかったでしょう"],["」"],["。"]]},{"verse":35,"text":"ダビデはアビガイルが携,たずさえてきた物,ものをその手,てから受,うけて、彼女,かのじょに言,いった、「あなたは無事,ぶじにのぼって、家,いえに帰,かえりなさい。わたしはあなたの声,こえを聞,ききいれ、あなたの願,ねがいを許,ゆるします」。","tok":[["ダビデ"],["は"],["アビガイル"],["が"],["携えて","たずさえて"],["きた"],["物","もの"],["を"],["その"],["手","て"],["から"],["受けて","うけて"],["、"],["彼女","かのじょ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["は"],["無事","ぶじ"],["に"],["のぼって"],["、"],["家","いえ"],["に"],["帰えり","かえり"],["なさい"],["。"],["わたし"],["は"],["あなた"],["の"],["声","こえ"],["を"],["聞きいれ","ききいれ"],["、"],["あなた"],["の"],["願い","ねがい"],["を"],["許します","ゆるします"],["」"],["。"]]},{"verse":36,"text":"こうしてアビガイルはナバルのもとにきたが、見,みよ、彼,かれはその家,いえで、王,おうの酒宴,しゅえんのような酒宴,しゅえんを開,ひらいていた。ナバルは心,こころに楽,たのしみ、ひじょうに酔,よっていたので、アビガイルは明,あくる朝,あさまで事,ことの大小,だいしょうを問,とわず何,なにをも彼,かれに告,つげなかった。","tok":[["こう"],["して"],["アビガイル"],["は"],["ナバル"],["の"],["もと"],["に"],["きた"],["が"],["、"],["見よ","みよ"],["、"],["彼","かれ"],["は"],["その"],["家","いえ"],["で"],["、"],["王","おう"],["の"],["酒宴","しゅえん"],["の"],["よう"],["な"],["酒宴","しゅえん"],["を"],["開らいて","ひらいて"],["いた"],["。"],["ナバル"],["は"],["心","こころ"],["に"],["楽み","たのしみ"],["、"],["ひじょう"],["に"],["酔って","よって"],["いた"],["ので"],["、"],["アビガイル"],["は"],["明くる","あくる"],["朝","あさ"],["まで"],["事","こと"],["の"],["大小","だいしょう"],["を"],["問わず","とわず"],["何に","なに"],["を"],["も"],["彼","かれ"],["に"],["告","つげ"],["なかった"],["。"]]},{"verse":37,"text":"朝,あさになってナバルの酔,よいがさめたとき、その妻,つまが彼,かれにこれらの事,ことを告,つげると、彼,かれの心,こころはそのうちに死,しんで、彼,かれは石,いしのようになった。","tok":[["朝","あさ"],["に"],["なって"],["ナバル"],["の"],["酔","よい"],["が"],["さめた"],["とき"],["、"],["その"],["妻","つま"],["が"],["彼","かれ"],["に"],["これ"],["ら"],["の"],["事","こと"],["を"],["告げる","つげる"],["と"],["、"],["彼","かれ"],["の"],["心","こころ"],["は"],["その"],["うち"],["に"],["死んで","しんで"],["、"],["彼","かれ"],["は"],["石","いし"],["の"],["よう"],["に"],["なった"],["。"]]},{"verse":38,"text":"十日,かばかりして主,しゅがナバルを撃,うたれたので彼,かれは死,しんだ。","tok":[["十日","か"],["ばかり"],["して"],["主","しゅ"],["が"],["ナバル"],["を"],["撃たれた","うたれた"],["ので"],["彼","かれ"],["は"],["死んだ","しんだ"],["。"]]},{"verse":39,"text":"ダビデはナバルが死,しんだと聞,きいて言,いった、「主,しゅはほむべきかな。主,しゅはわたしがナバルの手,てから受,うけた侮辱,ぶじょくに報,むくいて、しもべが悪,あくをおこなわないようにされた。主,しゅはナバルの悪行,あくぎょうをそのこうべに報,むくいられたのだ」。ダビデはアビガイルを妻,つまにめとろうと、人,ひとをつかわして彼女,かのじょに申,もうし込,こんだ。","tok":[["ダビデ"],["は"],["ナバル"],["が"],["死んだ","しんだ"],["と"],["聞いて","きいて"],["言った","いった"],["、"],["「"],["主","しゅ"],["は"],["ほ"],["むべき"],["か"],["な"],["。"],["主","しゅ"],["は"],["わたし"],["が"],["ナバル"],["の"],["手","て"],["から"],["受けた","うけた"],["侮辱","ぶじょく"],["に"],["報いて","むくいて"],["、"],["しもべ"],["が"],["悪","あく"],["を"],["おこなわない"],["よう"],["に"],["された"],["。"],["主","しゅ"],["は"],["ナバル"],["の"],["悪行","あくぎょう"],["を"],["その"],["こうべ"],["に"],["報いられた","むくいられた"],["の"],["だ"],["」"],["。"],["ダビデ"],["は"],["アビガイル"],["を"],["妻","つま"],["に"],["めとろう"],["と"],["、"],["人","ひと"],["を"],["つかわして"],["彼女","かのじょ"],["に"],["申し込んだ","もうしこんだ"],["。"]]},{"verse":40,"text":"ダビデのしもべたちはカルメルにいるアビガイルの所,ところにきて、彼女,かのじょに言,いった、「ダビデはあなたを妻,つまにめとろうと、われわれをあなたの所,ところへつかわしたのです」。","tok":[["ダビデ"],["の"],["しもべ"],["たち"],["は"],["カルメル"],["に"],["いる"],["アビガイル"],["の"],["所","ところ"],["に"],["きて"],["、"],["彼女","かのじょ"],["に"],["言った","いった"],["、"],["「"],["ダビデ"],["は"],["あなた"],["を"],["妻","つま"],["に"],["めとろう"],["と"],["、"],["われわれ"],["を"],["あなた"],["の"],["所","ところ"],["へ"],["つかわした"],["の"],["です"],["」"],["。"]]},{"verse":41,"text":"アビガイルは立,たち、地,ちにひれ伏,ふし拝,はいして言,いった、「はしためは、わが君,きみのしもべたちの足,あしを洗,あらうつかえめです」。","tok":[["アビガイル"],["は"],["立ち","たち"],["、"],["地","ち"],["に"],["ひれ伏し","ひれふし"],["拝して","はいして"],["言った","いった"],["、"],["「"],["はし"],["ため"],["は"],["、"],["わが"],["君","きみ"],["の"],["しもべ"],["たち"],["の"],["足","あし"],["を"],["洗う","あらう"],["つかえ"],["め"],["です"],["」"],["。"]]},{"verse":42,"text":"アビガイルは急,いそいで立,たち、ろばに乗,のって、五人,にんの侍女,じじょたちを連,つれ、ダビデの使者,ししゃたちに従,したがって行,いき、ダビデの妻,つまとなった。","tok":[["アビガイル"],["は"],["急いで","いそいで"],["立ち","たち"],["、"],["ろば"],["に"],["乗って","のって"],["、"],["五人","にん"],["の"],["侍女","じじょ"],["たち"],["を"],["連れ","つれ"],["、"],["ダビデ"],["の"],["使者","ししゃ"],["たち"],["に"],["従って","したがって"],["行き","いき"],["、"],["ダビデ"],["の"],["妻","つま"],["と"],["なった"],["。"]]},{"verse":43,"text":"ダビデはまたエズレルのアヒノアムをめとった。彼女,かのじょたちはふたりともダビデの妻,つまとなった。","tok":[["ダビデ"],["は"],["また"],["エズレル"],["の"],["アヒノアム"],["を"],["めとった"],["。"],["彼女","かのじょ"],["たち"],["は"],["ふたり"],["とも"],["ダビデ"],["の"],["妻","つま"],["と"],["なった"],["。"]]},{"verse":44,"text":"ところでサウルはその娘,むすめ、ダビデの妻,つまミカルを、ガリムの人,ひとであるライシの子,こパルテに与,あたえた。","tok":[["ところ"],["で"],["サウル"],["は"],["その"],["娘","むすめ"],["、"],["ダビデ"],["の"],["妻","つま"],["ミカル"],["を"],["、"],["ガリム"],["の"],["人","ひと"],["で"],["ある"],["ライシ"],["の"],["子","こ"],["パルテ"],["に"],["与","あたえ"],["た"],["。"]]}]
[{"verse":1,"text":"さてペリシテびとは、軍,ぐんを集,あつめて戦,たたかおうとし、ユダに属,ぞくするソコに集,あつまって、ソコとアゼカの間,あいだにあるエペス・ダミムに陣取,じんどった。","tok":[["さて"],["ペリシテ"],["び"],["と"],["は"],["、"],["軍","ぐん"],["を"],["集めて","あつめて"],["戦おう","たたかおう"],["と"],["し"],["、"],["ユダ"],["に"],["属する","ぞくする"],["ソコ"],["に"],["集まって","あつまって"],["、"],["ソコ"],["と"],["アゼカ"],["の"],["間","あいだ"],["に"],["ある"],["エペス"],["・"],["ダミム"],["に"],["陣取った","じんどった"],["。"]]},{"verse":2,"text":"サウルとイスラエルの人々,ひとびとは集,あつまってエラの谷,たにに陣取,じんどり、ペリシテびとに対,たいして戦列,せんれつをしいた。","tok":[["サウル"],["と"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["集まって","あつまって"],["エラ"],["の"],["谷","たに"],["に"],["陣取り","じんどり"],["、"],["ペリシテ"],["びと"],["に対して","にたいして"],["戦列","せんれつ"],["を"],["しいた"],["。"]]},{"verse":3,"text":"ペリシテびとは向,むこうの山,やまの上,うえに立,たち、イスラエルはこちらの山,やまの上,うえに立,たった。その間,かんに谷,たにがあった。","tok":[["ペリシテ"],["び"],["と"],["は"],["向こう","むこう"],["の"],["山","やま"],["の"],["上","うえ"],["に"],["立ち","たち"],["、"],["イスラエル"],["は"],["こちら"],["の"],["山","やま"],["の"],["上","うえ"],["に"],["立った","たった"],["。"],["その"],["間","かん"],["に"],["谷","たに"],["が"],["あった"],["。"]]},{"verse":4,"text":"時,ときに、ペリシテびとの陣,じんから、ガテのゴリアテという名,なの、戦,たたかいをいどむ者,ものが出,でてきた。身,みのたけは六キュビト半,はん。","tok":[["時","とき"],["に"],["、"],["ペリシテ"],["びと"],["の"],["陣","じん"],["から"],["、"],["ガテ"],["の"],["ゴリアテ"],["と"],["いう"],["名","な"],["の"],["、"],["戦い","たたかい"],["を"],["いどむ"],["者","もの"],["が"],["出て","でて"],["きた"],["。"],["身","み"],["の"],["たけ"],["は"],["六","ろく"],["キュビト"],["半","はん"],["。"]]},{"verse":5,"text":"頭,あたまには青銅,せいどうのかぶとを頂,いただき、身,みには、うろことじのよろいを着,きていた。そのよろいは青銅,せいどうで重,おもさ五千シケル。","tok":[["頭","あたま"],["に"],["は"],["青銅","せいどう"],["の"],["かぶと"],["を"],["頂","いただき"],["、"],["身","み"],["に"],["は"],["、"],["うろこ"],["とじ"],["の"],["よろい"],["を"],["着て","きて"],["いた"],["。"],["その"],["よろい"],["は"],["青銅","せいどう"],["で"],["重さ","おもさ"],["五千","ごせん"],["シケル"],["。"]]},{"verse":6,"text":"また足,あしには青銅,せいどうのすね当,とうを着,つけ、肩,かたには青銅,せいどうの投,なげやりを背負,せおっていた。","tok":[["また"],["足","あし"],["に"],["は"],["青銅","せいどう"],["の"],["すね当","すねとう"],["を"],["着け","つけ"],["、"],["肩","かた"],["に"],["は"],["青銅","せいどう"],["の"],["投","なげ"],["やり"],["を"],["背負って","せおって"],["いた"],["。"]]},{"verse":7,"text":"手,てに持,もっているやりの柄,えは、機,はたの巻棒,まきぼうのようであり、やりの穂,ほの鉄,てつは六百シケルであった。彼,かれの前,まえには、盾,たてを執,とる者,ものが進,すすんだ。","tok":[["手","て"],["に"],["持って","もって"],["いる"],["やり"],["の"],["柄","え"],["は"],["、"],["機","はた"],["の"],["巻","まき"],["棒","ぼう"],["の"],["よう"],["で"],["あり"],["、"],["やり"],["の"],["穂","ほ"],["の"],["鉄","てつ"],["は"],["六百","ろくひゃく"],["シケル"],["で"],["あった"],["。"],["彼","かれ"],["の"],["前","まえ"],["に"],["は"],["、"],["盾","たて"],["を"],["執る","とる"],["者","もの"],["が"],["進んだ","すすんだ"],["。"]]},{"verse":8,"text":"ゴリアテは立,たってイスラエルの戦列,せんれつに向,むかって叫,さけんだ、「なにゆえ戦列,せんれつをつくって出,でてきたのか。わたしはペリシテびと、おまえたちはサウルの家来,けらいではないか。おまえたちから、ひとりを選,えらんで、わたしのところへ下,くだってこさせよ。","tok":[["ゴリアテ"],["は"],["立って","たって"],["イスラエル"],["の"],["戦列","せんれつ"],["に"],["向かって","むかって"],["叫けんだ","さけんだ"],["、"],["「"],["なにゆえ"],["戦列","せんれつ"],["を"],["つくって"],["出て","でて"],["きた"],["の"],["か"],["。"],["わたし"],["は"],["ペリシテ"],["び"],["と"],["、"],["おまえ"],["たち"],["は"],["サウル"],["の"],["家来","けらい"],["で"],["は"],["ない"],["か"],["。"],["おまえ"],["たち"],["から"],["、"],["ひとり"],["を"],["選らんで","えらんで"],["、"],["わたし"],["の"],["ところ"],["へ"],["下って","くだって"],["こさせよ"],["。"]]},{"verse":9,"text":"もしその人,ひとが戦,たたかってわたしを殺,ころすことができたら、われわれはおまえたちの家来,けらいとなる。しかしわたしが勝,かってその人,ひとを殺,ころしたら、おまえたちは、われわれの家来,けらいになって仕,つかえなければならない」。","tok":[["もし"],["その"],["人","ひと"],["が"],["戦って","たたかって"],["わたし"],["を"],["殺ろす","ころす"],["こと"],["が"],["できたら"],["、"],["われわれ"],["は"],["おまえ"],["たち"],["の"],["家来","けらい"],["と"],["なる"],["。"],["しかし"],["わたし"],["が"],["勝って","かって"],["その"],["人","ひと"],["を"],["殺ろしたら","ころしたら"],["、"],["おまえ"],["たち"],["は"],["、"],["われわれ"],["の"],["家来","けらい"],["に"],["なって"],["仕えなければ","つかえなければ"],["ならない"],["」"],["。"]]},{"verse":10,"text":"またこのペリシテびとは言,いった、「わたしは、きょうイスラエルの戦列,せんれつにいどむ。ひとりを出,だして、わたしと戦,たたかわせよ」。","tok":[["また"],["この"],["ペリシテ"],["び"],["と"],["は"],["言った","いった"],["、"],["「"],["わたし"],["は"],["、"],["きょう"],["イスラエル"],["の"],["戦列","せんれつ"],["に"],["いどむ"],["。"],["ひとり"],["を"],["出して","だして"],["、"],["わたし"],["と"],["戦わせよ","たたかわせよ"],["」"],["。"]]},{"verse":11,"text":"サウルとイスラエルのすべての人,ひとは、ペリシテびとのこの言葉,ことばを聞,きいて驚,おどろき、ひじょうに恐,おそれた。","tok":[["サウル"],["と"],["イスラエル"],["の"],["すべて"],["の"],["人","ひと"],["は"],["、"],["ペリシテ"],["びと"],["の"],["この"],["言葉","ことば"],["を"],["聞いて","きいて"],["驚","おどろき"],["、"],["ひじょう"],["に"],["恐れた","おそれた"],["。"]]},{"verse":12,"text":"さて、ダビデはユダのベツレヘムにいたエフラタびとエッサイという名,なの人,ひとの子,こで、この人,ひとに八,はち人,にんの子,こがあったが、サウルの世,よには年,としが進,すすんで、すでに年老,としおいていた。","tok":[["さて"],["、"],["ダビデ"],["は"],["ユダ"],["の"],["ベツレヘム"],["に"],["いた"],["エフラタ"],["び"],["と"],["エッサイ"],["と"],["いう"],["名","な"],["の"],["人","ひと"],["の"],["子","こ"],["で"],["、"],["この"],["人","ひと"],["に"],["八人","はちにん"],["の"],["子","こ"],["が"],["あった"],["が"],["、"],["サウル"],["の"],["世","よ"],["に"],["は"],["年","と"],["し"],["が"],["進んで","すすんで"],["、"],["すでに"],["年老いて","としおいて"],["いた"],["。"]]},{"verse":13,"text":"エッサイの子,こらのうち、上,うえの三人,にんはサウルに従,したがって戦争,せんそうに出,でた。その戦,たたかいに出,でた三人,にんの子,この名,なは、長子,ちょうしをエリアブといい、次,つぎをアビナダブといい、第,だい三をシャンマと言,いった。","tok":[["エッサイ"],["の"],["子","こ"],["ら"],["の"],["うち"],["、"],["上","うえ"],["の"],["三人","にん"],["は"],["サウル"],["に"],["従って","したがって"],["戦争","せんそう"],["に"],["出た","でた"],["。"],["その"],["戦い","たたかい"],["に"],["出た","でた"],["三人","にん"],["の"],["子","こ"],["の"],["名","な"],["は"],["、"],["長子","ちょうし"],["を"],["エリアブ"],["と"],["いい"],["、"],["次","つぎ"],["を"],["アビナダブ"],["と"],["いい"],["、"],["第","だい"],["三","さん"],["を"],["シャンマ"],["と"],["言った","いった"],["。"]]},{"verse":14,"text":"ダビデは末,すえの子,こであって、兄,あに三人,にんはサウルにしたがった。","tok":[["ダビデ"],["は"],["末","すえ"],["の"],["子","こ"],["で"],["あって"],["、"],["兄","あに"],["三人","にん"],["は"],["サウル"],["に"],["したがった"],["。"]]},{"verse":15,"text":"ダビデはサウルの所,ところから行,いったりきたりして、ベツレヘムで父,ちちの羊,ひつじを飼,かっていた。","tok":[["ダビデ"],["は"],["サウル"],["の"],["所","ところ"],["から"],["行っ","いっ"],["たり"],["き"],["たり"],["して"],["、"],["ベツレヘム"],["で"],["父","ちち"],["の"],["羊","ひつじ"],["を"],["飼って","かって"],["いた"],["。"]]},{"verse":16,"text":"あのペリシテびとは四十日,にちの間,あいだ、朝夕,あさゆう出,でてきて、彼,かれらの前,まえに立,たった。","tok":[["あの"],["ペリシテ"],["び"],["と"],["は"],["四十日","にち"],["の"],["間","あいだ"],["、"],["朝夕","あさゆう"],["出て","でて"],["きて"],["、"],["彼","かれ"],["ら"],["の"],["前","まえ"],["に"],["立った","たった"],["。"]]},{"verse":17,"text":"時,ときに、エッサイはその子,こダビデに言,いった、「兄,あにたちのため、このいり麦,むぎ一エパと、この十個,このパンをとって、急,いそいで陣営,じんえいにいる兄,あにの所,ところへ持,もっていきなさい。","tok":[["時","とき"],["に"],["、"],["エッサイ"],["は"],["その"],["子","こ"],["ダビデ"],["に"],["言った","いった"],["、"],["「"],["兄たち","あにたち"],["の"],["ため"],["、"],["この"],["いり"],["麦","むぎ"],["一","いち"],["エパ"],["と"],["、"],["この"],["十個","こ"],["の"],["パン"],["を"],["とって"],["、"],["急いで","いそいで"],["陣営","じんえい"],["に"],["いる"],["兄","あに"],["の"],["所","ところ"],["へ"],["持って","もって"],["いき"],["なさい"],["。"]]},{"verse":18,"text":"またこの十の乾酪,かんらくを取,とって、千人,にんの長,ちょうにもって行,いき、兄,あにたちの安否,あんぴを見,みとどけて、そのしるしをもらってきなさい」。","tok":[["また"],["この"],["十","じゅう"],["の"],["乾酪","かんらく"],["を"],["取って","とって"],["、"],["千人","にん"],["の"],["長","ちょう"],["に"],["もって"],["行き","いき"],["、"],["兄たち","あにたち"],["の"],["安否","あんぴ"],["を"],["見とどけて","みとどけて"],["、"],["その"],["しるし"],["を"],["もらって"],["き"],["なさい"],["」"],["。"]]},{"verse":19,"text":"さてサウルと彼,かれらおよびイスラエルのすべての人,ひとは、エラの谷,たにでペリシテびとと戦,たたかっていた。","tok":[["さて"],["サウル"],["と"],["彼","かれ"],["ら"],["および"],["イスラエル"],["の"],["すべて"],["の"],["人","ひと"],["は"],["、"],["エラ"],["の"],["谷","たに"],["で"],["ペリシテ"],["びと"],["と"],["戦って","たたかって"],["いた"],["。"]]},{"verse":20,"text":"ダビデは朝,あさはやく起,おきて、羊,ひつじを番人,ばんにんに託,たくし、エッサイが命,めいじたように食料,しょくりょう品,ひんを携,たずさえて行,いった。彼,かれが陣営,じんえいに着,ついた時,とき、軍勢,ぐんぜいは、ときの声,こえをあげて戦線,せんせんに出,でようとしていた。","tok":[["ダビデ"],["は"],["朝","あさ"],["はやく"],["起きて","おきて"],["、"],["羊","ひつじ"],["を"],["番人","ばんにん"],["に"],["託し","たくし"],["、"],["エッサイ"],["が"],["命じた","めいじた"],["よう"],["に"],["食料品","しょくりょうひん"],["を"],["携えて","たずさえて"],["行った","いった"],["。"],["彼","かれ"],["が"],["陣営","じんえい"],["に"],["着いた","ついた"],["時","とき"],["、"],["軍勢","ぐんぜい"],["は"],["、"],["とき"],["の"],["声","こえ"],["を"],["あげて"],["戦線","せんせん"],["に"],["出よう","でよう"],["として"],["いた"],["。"]]},{"verse":21,"text":"そしてイスラエルとペリシテびととは戦列,せんれつを敷,しいて、軍,ぐんと軍,ぐんと向,むき合,あった。","tok":[["そして"],["イスラエル"],["と"],["ペリシテ"],["びと"],["と"],["は"],["戦列","せんれつ"],["を"],["敷いて","しいて"],["、"],["軍","ぐん"],["と"],["軍","ぐん"],["と"],["向き合った","むきあった"],["。"]]},{"verse":22,"text":"ダビデは荷物,にもつをおろして、荷物,にもつを守,まもる者,ものにあずけ、戦列,せんれつの方,ほうへ走,はしって、兄,あにたちの所,ところへ行,いき、彼,かれらの安否,あんぴを尋,たずねた。","tok":[["ダビデ"],["は"],["荷物","にもつ"],["を"],["おろして"],["、"],["荷物","にもつ"],["を"],["守者","まもるもの"],["に"],["あずけ"],["、"],["戦列","せんれつ"],["の"],["方","ほう"],["へ"],["走って","はしって"],["、"],["兄たち","あにたち"],["の"],["所","ところ"],["へ"],["行き","いき"],["、"],["彼","かれ"],["ら"],["の"],["安否","あんぴ"],["を"],["尋ねた","たずねた"],["。"]]},{"verse":23,"text":"兄,あにたちと語,かたっている時,とき、ペリシテびとの戦列,せんれつから、ガテのペリシテびとで、名,なをゴリアテという、あの戦,たたかいをいどむ者,ものが上,のぼってきて、前,まえと同,おなじ言葉,ことばを言,いったので、ダビデはそれを聞,きいた。","tok":[["兄たち","あにたち"],["と"],["語って","かたって"],["いる"],["時","とき"],["、"],["ペリシテ"],["びと"],["の"],["戦列","せんれつ"],["から"],["、"],["ガテ"],["の"],["ペリシテ"],["びと"],["で"],["、"],["名","な"],["を"],["ゴリアテ"],["と"],["いう"],["、"],["あの"],["戦い","たたかい"],["を"],["いどむ"],["者","もの"],["が"],["上って","のぼって"],["きて"],["、"],["前","まえ"],["と"],["同じ","おなじ"],["言葉","ことば"],["を"],["言った","いった"],["ので"],["、"],["ダビデ"],["は"],["それ"],["を"],["聞いた","きいた"],["。"]]},{"verse":24,"text":"イスラエルのすべての人,ひとは、その人,ひとを見,みて、避,さけて逃,にげ、ひじょうに恐,おそれた。","tok":[["イスラエル"],["の"],["すべて"],["の"],["人","ひと"],["は"],["、"],["その"],["人","ひと"],["を"],["見て","みて"],["、"],["避けて","さけて"],["逃","にげ"],["、"],["ひじょう"],["に"],["恐れた","おそれた"],["。"]]},{"verse":25,"text":"イスラエルの人々,ひとびとはまた言,いった、「あなたがたは、あの上,のぼってきた人,ひとを見,みたか。確,たしかにイスラエルにいどむために上,のぼってきたのだ。彼,かれを殺,ころす人,ひとは、王,おうが大,おおいなる富,とみを与,あたえて富,とませ、その娘,むすめを与,あたえ、その父,ちちの家,いえにはイスラエルのうちで税,ぜいを免,まぬかれさせるであろう」。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["は"],["また"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["、"],["あの"],["上って","のぼって"],["きた"],["人","ひと"],["を"],["見た","みた"],["か"],["。"],["確か","たしか"],["に"],["イスラエル"],["に"],["いどむ"],["ため"],["に"],["上って","のぼって"],["きた"],["の"],["だ"],["。"],["彼","かれ"],["を"],["殺ろす","ころす"],["人","ひと"],["は"],["、"],["王","おう"],["が"],["大いなる","おおいなる"],["富","とみ"],["を"],["与","あたえ"],["て"],["富ませ","とませ"],["、"],["その"],["娘","むすめ"],["を"],["与","あたえ"],["、"],["その"],["父","ちち"],["の"],["家","いえ"],["に"],["は"],["イスラエル"],["の"],["うち"],["で"],["税","ぜい"],["を"],["免かれさせるで","まぬかれさせるで"],["あろう"],["」"],["。"]]},{"verse":26,"text":"ダビデはかたわらに立,たっている人々,ひとびとに言,いった、「このペリシテびとを殺,ころし、イスラエルの恥,はじをすすぐ人,ひとには、どうされるのですか。この割礼,かつれいなきペリシテびとは何者,なにものなので、生,いける神,かみの軍,ぐんをいどむのか」。","tok":[["ダビデ"],["は"],["かたわら"],["に"],["立って","たって"],["いる"],["人々","ひとびと"],["に"],["言った","いった"],["、"],["「"],["この"],["ペリシテ"],["びと"],["を"],["殺ろし","ころし"],["、"],["イスラエル"],["の"],["恥","はじ"],["を"],["すすぐ"],["人","ひと"],["に"],["は"],["、"],["どう"],["される"],["の"],["です"],["か"],["。"],["この"],["割礼","かつれい"],["なき"],["ペリシテ"],["び"],["と"],["は"],["何者","なにもの"],["な"],["ので"],["、"],["生ける","いける"],["神","かみ"],["の"],["軍","ぐん"],["を"],["いどむ"],["の"],["か"],["」"],["。"]]},{"verse":27,"text":"民,たみは前,まえと同,おなじように、「彼,かれを殺,ころす人,ひとにはこうされるであろう」と答,こたえた。","tok":[["民","たみ"],["は"],["前","まえ"],["と"],["同じ","おなじ"],["よう"],["に"],["、"],["「"],["彼","かれ"],["を"],["殺ろす","ころす"],["人","ひと"],["に"],["は"],["こう"],["されるで"],["あろう"],["」"],["と"],["答","こたえ"],["た"],["。"]]},{"verse":28,"text":"上,うえの兄,あにエリアブはダビデが人々,ひとびとと語,かたるのを聞,きいて、ダビデに向,むかい怒,いかりを発,はっして言,いった、「なんのために下,くだってきたのか。野,のにいるわずかの羊,ひつじはだれに託,たくしたのか。あなたのわがままと悪,わるい心,こころはわかっている。戦,たたかいを見,みるために下,くだってきたのだ」。","tok":[["上","うえ"],["の"],["兄","あに"],["エリアブ"],["は"],["ダビデ"],["が"],["人々","ひとびと"],["と"],["語る","かたる"],["の"],["を"],["聞いて","きいて"],["、"],["ダビデ"],["に"],["向","むかい"],["怒り","いかり"],["を"],["発して","はっして"],["言った","いった"],["、"],["「"],["なん"],["の"],["ため"],["に"],["下って","くだって"],["きた"],["の"],["か"],["。"],["野","の"],["に"],["いる"],["わずか"],["の"],["羊","ひつじ"],["は"],["だれ"],["に"],["託した","たくした"],["の"],["か"],["。"],["あなた"],["の"],["わがまま"],["と"],["悪い","わるい"],["心","こころ"],["は"],["わかって"],["いる"],["。"],["戦い","たたかい"],["を"],["見る","みる"],["ため"],["に"],["下って","くだって"],["きた"],["の"],["だ"],["」"],["。"]]},{"verse":29,"text":"ダビデは言,いった、「わたしが今,いま、何,なにをしたというのですか。ただひと言,こといっただけではありませんか」。","tok":[["ダビデ"],["は"],["言った","いった"],["、"],["「"],["わたし"],["が"],["今","いま"],["、"],["何に","なに"],["を"],["した"],["と"],["いう"],["の"],["です"],["か"],["。"],["ただ"],["ひと言","ひとこと"],["いった"],["だけ"],["で"],["は"],["ありません"],["か"],["」"],["。"]]},{"verse":30,"text":"またふり向,むいて、ほかの人,ひとに前,まえのように語,かたったところ、民,たみはまた同,おなじように答,こたえた。","tok":[["また"],["ふり向いて","ふりむいて"],["、"],["ほか"],["の"],["人","ひと"],["に"],["前","まえ"],["の"],["よう"],["に"],["語った","かたった"],["ところ"],["、"],["民","たみ"],["は"],["また"],["同じ","おなじ"],["よう"],["に"],["答","こたえ"],["た"],["。"]]},{"verse":31,"text":"人々,ひとびとはダビデの語,かたった言葉,ことばを聞,きいて、それをサウルに告,つげたので、サウルは彼,かれを呼,よび寄,よせた。","tok":[["人々","ひとびと"],["は"],["ダビデ"],["の"],["語った","かたった"],["言葉","ことば"],["を"],["聞いて","きいて"],["、"],["それ"],["を"],["サウル"],["に"],["告","つげ"],["た"],["ので"],["、"],["サウル"],["は"],["彼","かれ"],["を"],["呼び寄せた","よびよせた"],["。"]]},{"verse":32,"text":"ダビデはサウルに言,いった、「だれも彼,かれのゆえに気,きを落,おとしてはなりません。しもべが行,いってあのペリシテびとと戦,たたかいましょう」。","tok":[["ダビデ"],["は"],["サウル"],["に"],["言った","いった"],["、"],["「"],["だれ"],["も"],["彼","かれ"],["の"],["ゆえ"],["に"],["気","き"],["を"],["落として","おとして"],["は"],["なりません"],["。"],["しもべ"],["が"],["行って","いって"],["あの"],["ペリシテ"],["びと"],["と"],["戦いましょう","たたかいましょう"],["」"],["。"]]},{"verse":33,"text":"サウルはダビデに言,いった、「行,いって、あのペリシテびとと戦,たたかうことはできない。あなたは年少,ねんしょうだが、彼,かれは若,わかい時,ときからの軍人,ぐんじんだからです」。","tok":[["サウル"],["は"],["ダビデ"],["に"],["言った","いった"],["、"],["「"],["行って","いって"],["、"],["あの"],["ペリシテ"],["びと"],["と"],["戦う","たたかう"],["こと"],["は"],["できない"],["。"],["あなた"],["は"],["年少","ねんしょう"],["だ"],["が"],["、"],["彼","かれ"],["は"],["若い","わかい"],["時","とき"],["から"],["の"],["軍人","ぐんじん"],["だ"],["から"],["です"],["」"],["。"]]},{"verse":34,"text":"しかしダビデはサウルに言,いった、「しもべは父,ちちの羊,ひつじを飼,かっていたのですが、しし、あるいはくまがきて、群,むれの小羊,こひつじを取,とった時,とき、","tok":[["しかし"],["ダビデ"],["は"],["サウル"],["に"],["言った","いった"],["、"],["「"],["しもべ"],["は"],["父","ちち"],["の"],["羊","ひつじ"],["を"],["飼って","かって"],["いた"],["の"],["です"],["が"],["、"],["し"],["し"],["、"],["あるいは"],["くま"],["が"],["きて"],["、"],["群れ","むれ"],["の"],["小羊","こひつじ"],["を"],["取った","とった"],["時","とき"],["、"]]},{"verse":35,"text":"わたしはそのあとを追,おって、これを撃,うち、小羊,こひつじをその口,くちから救,すくいだしました。その獣,けものがわたしにとびかかってきた時,ときは、ひげをつかまえて、それを撃,うち殺,ころしました。","tok":[["わたし"],["は"],["その"],["あと"],["を"],["追って","おって"],["、"],["これ"],["を"],["撃ち","うち"],["、"],["小羊","こひつじ"],["を"],["その"],["口","くち"],["から"],["救いだしました","すくいだしました"],["。"],["その"],["獣","けもの"],["が"],["わたし"],["に"],["とびかかって"],["きた"],["時","とき"],["は"],["、"],["ひげ"],["を"],["つかまえて"],["、"],["それ"],["を"],["撃ち殺しました","うちころしました"],["。"]]},{"verse":36,"text":"しもべはすでに、ししと、くまを殺,ころしました。この割礼,かつれいなきペリシテびとも、生,いける神,かみの軍,ぐんをいどんだのですから、あの獣,けものの一頭,とうのようになるでしょう」。","tok":[["しもべ"],["は"],["すでに"],["、"],["しし"],["と"],["、"],["くま"],["を"],["殺ろしました","ころしました"],["。"],["この"],["割礼","かつれい"],["なき"],["ペリシテ"],["びと"],["も"],["、"],["生ける","いける"],["神","かみ"],["の"],["軍","ぐん"],["を"],["いどんだ"],["の"],["です"],["から"],["、"],["あの"],["獣","けもの"],["の"],["一頭","とう"],["の"],["よう"],["に"],["なるでしょう"],["」"],["。"]]},{"verse":37,"text":"ダビデはまた言,いった、「ししのつめ、くまのつめからわたしを救,すくい出,だされた主,しゅは、またわたしを、このペリシテびとの手,てから救,すくい出,だされるでしょう」。サウルはダビデに言,いった、「行,いきなさい。どうぞ主,しゅがあなたと共,ともにおられるように」。","tok":[["ダビデ"],["は"],["また"],["言った","いった"],["、"],["「"],["しし"],["の"],["つめ"],["、"],["くま"],["の"],["つめ"],["から"],["わたし"],["を"],["救い出された","すくいだされた"],["主","しゅ"],["は"],["、"],["また"],["わたし"],["を"],["、"],["この"],["ペリシテ"],["びと"],["の"],["手","て"],["から"],["救い出されるでしょう","すくいだされるでしょう"],["」"],["。"],["サウル"],["は"],["ダビデ"],["に"],["言った","いった"],["、"],["「"],["行き","いき"],["なさい"],["。"],["どうぞ"],["主","しゅ"],["が"],["あなた"],["と"],["共","とも"],["に"],["おられる"],["よう"],["に"],["」"],["。"]]},{"verse":38,"text":"そしてサウルは自分,じぶんのいくさ衣,ころもをダビデに着,きせ、青銅,せいどうのかぶとを、その頭,あたまにかぶらせ、また、うろことじのよろいを身,みにまとわせた。","tok":[["そして"],["サウル"],["は"],["自分","じぶん"],["の"],["いくさ"],["衣","ころも"],["を"],["ダビデ"],["に"],["着せ","きせ"],["、"],["青銅","せいどう"],["の"],["かぶと"],["を"],["、"],["その"],["頭","あたま"],["に"],["かぶらせ"],["、"],["また"],["、"],["うろこ"],["とじ"],["の"],["よろい"],["を"],["身","み"],["に"],["まとわせた"],["。"]]},{"verse":39,"text":"ダビデは、いくさ衣,ころもの上,うえに、つるぎを帯,おびて行,いこうとしたが、できなかった。それに慣,なれていなかったからである。そこでダビデはサウルに言,いった、「わたしはこれらのものを着,つけていくことはできません。慣,なれていないからです」。","tok":[["ダビデ"],["は"],["、"],["いくさ"],["衣","ころも"],["の"],["上","うえ"],["に"],["、"],["つるぎ"],["を"],["帯","おび"],["て"],["行こう","いこう"],["と"],["した"],["が"],["、"],["できなかった"],["。"],["それ"],["に"],["慣れて","なれて"],["いなかった"],["から"],["で"],["ある"],["。"],["そこ"],["で"],["ダビデ"],["は"],["サウル"],["に"],["言った","いった"],["、"],["「"],["わたし"],["は"],["これ"],["ら"],["の"],["もの"],["を"],["着けて","つけて"],["いく"],["こと"],["は"],["できません"],["。"],["慣れて","なれて"],["いない"],["から"],["です"],["」"],["。"]]},{"verse":40,"text":"ダビデはそれらを脱,ぬぎすて、手,てにつえをとり、谷間,たにまからなめらかな石,いし五個,こを選,えらびとって自分,じぶんの持,もっている羊飼,ひつじかいの袋,ふくろに入,いれ、手,てに石,いし投,なげを執,とって、あのペリシテびとに近,ちかづいた。","tok":[["ダビデ"],["は"],["それ"],["ら"],["を"],["脱ぎすて","ぬぎすて"],["、"],["手","て"],["に"],["つえ"],["を"],["とり"],["、"],["谷間","たにま"],["から"],["なめらか"],["な"],["石","いし"],["五個","こ"],["を"],["選ら","えら"],["び"],["とって"],["自分","じぶん"],["の"],["持って","もって"],["いる"],["羊飼","ひつじかい"],["の"],["袋","ふくろ"],["に"],["入れ","いれ"],["、"],["手","て"],["に"],["石投","いしなげ"],["を"],["執って","とって"],["、"],["あの"],["ペリシテ"],["びと"],["に"],["近づいた","ちかづいた"],["。"]]},{"verse":41,"text":"そのペリシテびとは進,すすんできてダビデに近,ちかづいた。そのたてを執,とる者,ものが彼,かれの前,まえにいた。","tok":[["その"],["ペリシテ"],["び"],["と"],["は"],["進んで","すすんで"],["きて"],["ダビデ"],["に"],["近づいた","ちかづいた"],["。"],["その"],["たて"],["を"],["執る","とる"],["者","もの"],["が"],["彼","かれ"],["の"],["前","まえ"],["に"],["いた"],["。"]]},{"verse":42,"text":"ペリシテびとは見,みまわしてダビデを見,み、これを侮,あなどった。まだ若,わかくて血色,けっしょくがよく、姿,すがたが美,うつくしかったからである。","tok":[["ペリシテ"],["び"],["と"],["は"],["見まわして","みまわして"],["ダビデ"],["を"],["見","み"],["、"],["これ"],["を"],["侮った","あなどった"],["。"],["まだ"],["若くて","わかくて"],["血色","けっしょく"],["が"],["よく"],["、"],["姿","すがた"],["が"],["美しかった","うつくしかった"],["から"],["で"],["ある"],["。"]]},{"verse":43,"text":"ペリシテびとはダビデに言,いった、「つえを持,もって、向,むかってくるが、わたしは犬,いぬなのか」。ペリシテびとは、また神々,かみがみの名,なによってダビデをのろった。","tok":[["ペリシテ"],["び"],["と"],["は"],["ダビデ"],["に"],["言った","いった"],["、"],["「"],["つえ"],["を"],["持って","もって"],["、"],["向かって","むかって"],["くる"],["が"],["、"],["わたし"],["は"],["犬","いぬ"],["な"],["の"],["か"],["」"],["。"],["ペリシテ"],["び"],["と"],["は"],["、"],["また"],["神々","かみがみ"],["の"],["名","な"],["によって"],["ダビデ"],["を"],["のろった"],["。"]]},{"verse":44,"text":"ペリシテびとはダビデに言,いった、「さあ、向,むかってこい。おまえの肉,にくを、空,そらの鳥,とり、野,のの獣,けもののえじきにしてくれよう」。","tok":[["ペリシテ"],["び"],["と"],["は"],["ダビデ"],["に"],["言った","いった"],["、"],["「"],["さあ"],["、"],["向かって","むかって"],["こい"],["。"],["おまえ"],["の"],["肉","にく"],["を"],["、"],["空","そら"],["の"],["鳥","とり"],["、"],["野","の"],["の"],["獣","けもの"],["の"],["えじき"],["に"],["して"],["くれよう"],["」"],["。"]]},{"verse":45,"text":"ダビデはペリシテびとに言,いった、「おまえはつるぎと、やりと、投,なげやりを持,もって、わたしに向,むかってくるが、わたしは万軍,ばんぐんの主,しゅの名,な、すなわち、おまえがいどんだ、イスラエルの軍,ぐんの神,かみの名,なによって、おまえに立,たち向,むかう。","tok":[["ダビデ"],["は"],["ペリシテ"],["びと"],["に"],["言った","いった"],["、"],["「"],["おまえ"],["は"],["つるぎ"],["と"],["、"],["やり"],["と"],["、"],["投","なげ"],["やり"],["を"],["持って","もって"],["、"],["わたし"],["に"],["向かって","むかって"],["くる"],["が"],["、"],["わたし"],["は"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["の"],["名","な"],["、"],["すなわち"],["、"],["おまえ"],["が"],["いどんだ"],["、"],["イスラエル"],["の"],["軍","ぐん"],["の"],["神","かみ"],["の"],["名","な"],["によって"],["、"],["おまえ"],["に"],["立ち向かう","たちむかう"],["。"]]},{"verse":46,"text":"きょう、主,しゅは、おまえをわたしの手,てにわたされるであろう。わたしは、おまえを撃,うって、首,くびをはね、ペリシテびとの軍勢,ぐんぜいの死,しかばねを、きょう、空,そらの鳥,とり、地,ちの野獣,やじゅうのえじきにし、イスラエルに、神,かみがおられることを全,ぜん地,ちに知,しらせよう。","tok":[["きょう"],["、"],["主","しゅ"],["は"],["、"],["おまえ"],["を"],["わたし"],["の"],["手","て"],["に"],["わたされるで"],["あろう"],["。"],["わたし"],["は"],["、"],["おまえ"],["を"],["撃って","うって"],["、"],["首","くび"],["を"],["はね"],["、"],["ペリシテ"],["びと"],["の"],["軍勢","ぐんぜい"],["の"],["死","し"],["かばね"],["を"],["、"],["きょう"],["、"],["空","そら"],["の"],["鳥","とり"],["、"],["地","ち"],["の"],["野獣","やじゅう"],["の"],["えじき"],["に"],["し"],["、"],["イスラエル"],["に"],["、"],["神","かみ"],["が"],["おられる"],["こと"],["を"],["全地","ぜんち"],["に"],["知らせよう","しらせよう"],["。"]]},{"verse":47,"text":"またこの全,ぜん会衆,かいしゅうも、主,しゅは救,すくいを施,ほどこすのに、つるぎとやりを用,もちいられないことを知,しるであろう。この戦,たたかいは主,しゅの戦,たたかいであって、主,しゅがわれわれの手,てにおまえたちを渡,わたされるからである」。","tok":[["また"],["この"],["全","ぜん"],["会衆","かいしゅう"],["も"],["、"],["主","しゅ"],["は"],["救い","すくい"],["を"],["施す","ほどこす"],["のに"],["、"],["つるぎ"],["と"],["やり"],["を"],["用いられない","もちいられない"],["こと"],["を"],["知るで","しるで"],["あろう"],["。"],["この"],["戦い","たたかい"],["は"],["主","しゅ"],["の"],["戦い","たたかい"],["で"],["あって"],["、"],["主","しゅ"],["が"],["われわれ"],["の"],["手","て"],["に"],["おまえ"],["たち"],["を"],["渡される","わたされる"],["から"],["で"],["ある"],["」"],["。"]]},{"verse":48,"text":"そのペリシテびとが立,たち上,あがり、近,ちかづいてきてダビデに立,たち向,むかったので、ダビデは急,いそぎ戦線,せんせんに走,はしり出,でて、ペリシテびとに立,たち向,むかった。","tok":[["その"],["ペリシテ"],["びと"],["が"],["立ち上がり","たちあがり"],["、"],["近づいて","ちかづいて"],["きて"],["ダビデ"],["に"],["立ち向かった","たちむかった"],["ので"],["、"],["ダビデ"],["は"],["急ぎ","いそぎ"],["戦線","せんせん"],["に"],["走り出て","はしりでて"],["、"],["ペリシテ"],["びと"],["に"],["立ち向かった","たちむかった"],["。"]]},{"verse":49,"text":"ダビデは手,てを袋,ふくろに入,いれて、その中,なかから一つの石,いしを取,とり、石,いし投,なげで投,なげて、ペリシテびとの額,ひたいを撃,うったので、石,いしはその額,ひたいに突,つき入,はいり、うつむきに地,ちに倒,たおれた。","tok":[["ダビデ"],["は"],["手","て"],["を"],["袋","ふくろ"],["に"],["入れて","いれて"],["、"],["その"],["中","なか"],["から"],["一","ひと"],["つ"],["の"],["石","いし"],["を"],["取","とり"],["、"],["石投","いしなげ"],["で"],["投て","なげて"],["、"],["ペリシテ"],["びと"],["の"],["額","ひたい"],["を"],["撃った","うった"],["ので"],["、"],["石","いし"],["は"],["その"],["額","ひたい"],["に"],["突き","つき"],["入","は"],["いり"],["、"],["うつむき"],["に"],["地","ち"],["に"],["倒れた","たおれた"],["。"]]},{"verse":50,"text":"こうしてダビデは石,いし投,なげと石,いしをもってペリシテびとに勝,かち、ペリシテびとを撃,うって、これを殺,ころした。ダビデの手,てにつるぎがなかったので、","tok":[["こう"],["して"],["ダビデ"],["は"],["石投","いしなげ"],["と"],["石","いし"],["を"],["もって"],["ペリシテ"],["びと"],["に"],["勝","かち"],["、"],["ペリシテ"],["びと"],["を"],["撃って","うって"],["、"],["これ"],["を"],["殺ろした","ころした"],["。"],["ダビデ"],["の"],["手","て"],["に"],["つるぎ"],["が"],["なかった"],["ので"],["、"]]},{"verse":51,"text":"ダビデは走,はしりよってペリシテびとの上,うえに乗,のり、そのつるぎを取,とって、さやから抜,ぬきはなし、それをもって彼,かれを殺,ころし、その首,くびをはねた。ペリシテの人々,ひとびとは、その勇士,ゆうしが死,しんだのを見,みて逃,にげた。","tok":[["ダビデ"],["は"],["走りよって","はしりよって"],["ペリシテ"],["びと"],["の"],["上","うえ"],["に"],["乗","のり"],["、"],["その"],["つるぎ"],["を"],["取って","とって"],["、"],["さや"],["から"],["抜き","ぬき"],["はなし"],["、"],["それ"],["を"],["もって"],["彼","かれ"],["を"],["殺ろし","ころし"],["、"],["その"],["首","くび"],["を"],["はねた"],["。"],["ペリシテ"],["の"],["人々","ひとびと"],["は"],["、"],["その"],["勇士","ゆうし"],["が"],["死んだ","しんだ"],["の"],["を"],["見て","みて"],["逃た","にげた"],["。"]]},{"verse":52,"text":"イスラエルとユダの人々,ひとびとは立,たちあがり、ときをあげて、ペリシテびとを追撃,ついげきし、ガテおよびエクロンの門,もんにまで及,およんだ。そのためペリシテびとの負傷,ふしょう者,しゃは、シャライムからガテおよびエクロンに行,いく道,みちの上,うえに倒,たおれた。","tok":[["イスラエル"],["と"],["ユダ"],["の"],["人々","ひとびと"],["は"],["立ちあがり","たちあがり"],["、"],["とき"],["を"],["あげて"],["、"],["ペリシテ"],["びと"],["を"],["追撃","ついげき"],["し"],["、"],["ガテ"],["および"],["エクロン"],["の"],["門","もん"],["に"],["まで"],["及んだ","およんだ"],["。"],["その"],["ため"],["ペリシテ"],["びと"],["の"],["負傷者","ふしょうしゃ"],["は"],["、"],["シャライム"],["から"],["ガテ"],["および"],["エクロン"],["に"],["行く","いく"],["道","みち"],["の"],["上","うえ"],["に"],["倒れた","たおれた"],["。"]]},{"verse":53,"text":"イスラエルの人々,ひとびとはペリシテびとの追撃,ついげきを終,おえて帰,かえり、その陣営,じんえいを略奪,りゃくだつした。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["は"],["ペリシテ"],["びと"],["の"],["追撃","ついげき"],["を"],["終えて","おえて"],["帰えり","かえり"],["、"],["その"],["陣営","じんえい"],["を"],["略奪","りゃくだつ"],["した"],["。"]]},{"verse":54,"text":"ダビデは、あのペリシテびとの首,くびを取,とってエルサレムへ持,もって行,いったが、その武器,ぶきは自分,じぶんの天幕,てんまくに置,おいた。","tok":[["ダビデ"],["は"],["、"],["あの"],["ペリシテ"],["びと"],["の"],["首","くび"],["を"],["取って","とって"],["エルサレム"],["へ"],["持って","もって"],["行った","いった"],["が"],["、"],["その"],["武器","ぶき"],["は"],["自分","じぶん"],["の"],["天幕","てんまく"],["に"],["置いた","おいた"],["。"]]},{"verse":55,"text":"サウルはダビデがあのペリシテびとに向,むかって出,でていくのを見,みて、軍,ぐんの長,ちょうアブネルに言,いった、「アブネルよ、この若者,わかものはだれの子,こか」。アブネルは言,いった、「王,おうよ、あなたのいのちにかけて誓,ちかいます。わたしは知,しらないのです」。","tok":[["サウル"],["は"],["ダビデ"],["が"],["あの"],["ペリシテ"],["びと"],["に"],["向かって","むかって"],["出て","でて"],["いく"],["の"],["を"],["見て","みて"],["、"],["軍","ぐん"],["の"],["長う","ちょう"],["アブネル"],["に"],["言った","いった"],["、"],["「"],["アブネル"],["よ"],["、"],["この"],["若者","わかもの"],["は"],["だれ"],["の"],["子","こ"],["か"],["」"],["。"],["アブネル"],["は"],["言った","いった"],["、"],["「"],["王","おう"],["よ"],["、"],["あなた"],["の"],["いのち"],["に"],["かけて"],["誓います","ちかいます"],["。"],["わたし"],["は"],["知らない","しらない"],["の"],["です"],["」"],["。"]]},{"verse":56,"text":"王,おうは言,いった、「この若者,わかものがだれの子,こか、尋,たずねてみよ」。","tok":[["王","おう"],["は"],["言った","いった"],["、"],["「"],["この"],["若者","わかもの"],["が"],["だれ"],["の"],["子","こ"],["か"],["、"],["尋ねて","たずねて"],["み"],["よ"],["」"],["。"]]},{"verse":57,"text":"ダビデが、あのペリシテびとを殺,ころして帰,かえってきた時,とき、アブネルは、ペリシテびとの首,くびを手,てに持,もっている彼,かれを、サウルの前,まえに連,つれて行,いった。","tok":[["ダビデ"],["が"],["、"],["あの"],["ペリシテ"],["びと"],["を"],["殺ろして","ころして"],["帰えって","かえって"],["きた"],["時","とき"],["、"],["アブネル"],["は"],["、"],["ペリシテ"],["びと"],["の"],["首","くび"],["を"],["手","て"],["に"],["持って","もって"],["いる"],["彼","かれ"],["を"],["、"],["サウル"],["の"],["前","まえ"],["に"],["連れて","つれて"],["行った","いった"],["。"]]},{"verse":58,"text":"サウルは彼,かれに言,いった、「若者,わかものよ、あなたはだれの子,こか」。ダビデは答,こたえた、「あなたのしもべ、ベツレヘムびとエッサイの子,こです」。","tok":[["サウル"],["は"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["若者","わかもの"],["よ"],["、"],["あなた"],["は"],["だれ"],["の"],["子","こ"],["か"],["」"],["。"],["ダビデ"],["は"],["答","こたえ"],["た"],["、"],["「"],["あなた"],["の"],["しもべ"],["、"],["ベツレヘム"],["び"],["と"],["エッサイ"],["の"],["子","こ"],["です"],["」"],["。"]]}]
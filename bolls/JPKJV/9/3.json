[{"verse":1,"text":"わらべサムエルは、エリの前,まえで、主,しゅに仕,つかえていた。そのころ、主,しゅの言葉,ことばはまれで、黙示,もくしも常,つねではなかった。","tok":[["わらべ"],["サムエル"],["は"],["、"],["エリ"],["の"],["前","まえ"],["で"],["、"],["主に","しゅに"],["仕えて","つかえて"],["いた"],["。"],["その"],["ころ"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["は"],["まれ"],["で"],["、"],["黙示","もくし"],["も"],["常","つね"],["で"],["は"],["なかった"],["。"]]},{"verse":2,"text":"さてエリは、しだいに目,めがかすんで、見,みることができなくなり、そのとき自分,じぶんのへやで寝,ねていた。","tok":[["さて"],["エリ"],["は"],["、"],["しだい"],["に"],["目","め"],["が"],["かすんで"],["、"],["見る","みる"],["こと"],["が"],["できなく"],["なり"],["、"],["その"],["とき"],["自分","じぶん"],["の"],["へや"],["で"],["寝て","ねて"],["いた"],["。"]]},{"verse":3,"text":"神,かみのともしびはまだ消,きえず、サムエルが神,かみの箱,はこのある主,しゅの神殿,しんでんに寝,ねていた時,とき、","tok":[["神","かみ"],["の"],["ともしび"],["は"],["まだ"],["消えず","きえず"],["、"],["サムエル"],["が"],["神","かみ"],["の"],["箱","はこ"],["の"],["ある"],["主","しゅ"],["の"],["神殿","しんでん"],["に"],["寝て","ねて"],["いた"],["時","とき"],["、"]]},{"verse":4,"text":"主,しゅは「サムエルよ、サムエルよ」と呼,よばれた。彼,かれは「はい、ここにおります」と言,いって、","tok":[["主","しゅ"],["は"],["「"],["サムエル"],["よ"],["、"],["サムエル"],["よ"],["」"],["と"],["呼ばれた","よばれた"],["。"],["彼","かれ"],["は"],["「"],["はい"],["、"],["ここ"],["に"],["おります"],["」"],["と"],["言って","いって"],["、"]]},{"verse":5,"text":"エリの所,ところへ走,はしっていって言,いった、「あなたがお呼,およびになりました。わたしは、ここにおります」。しかしエリは言,いった、「わたしは呼,よばない。帰,かえって寝,ねなさい」。彼,かれは行,いって寝,ねた。","tok":[["エリ"],["の"],["所","ところ"],["へ"],["走って","はしって"],["いって"],["言った","いった"],["、"],["「"],["あなた"],["が"],["お呼","おおよび"],["に"],["なりました"],["。"],["わたし"],["は"],["、"],["ここ"],["に"],["おります"],["」"],["。"],["しかし"],["エリ"],["は"],["言った","いった"],["、"],["「"],["わたし"],["は"],["呼ばない","よばない"],["。"],["帰えって","かえって"],["寝","ね"],["なさい"],["」"],["。"],["彼","かれ"],["は"],["行って","いって"],["寝た","ねた"],["。"]]},{"verse":6,"text":"主,しゅはまたかさねて「サムエルよ、サムエルよ」と呼,よばれた。サムエルは起,おきてエリのもとへ行,いって言,いった、「あなたがお呼,およびになりました。わたしは、ここにおります」。エリは言,いった、「子,こよ、わたしは呼,よばない。もう一度,ど寝,ねなさい」。","tok":[["主","しゅ"],["は"],["また"],["かさねて"],["「"],["サムエル"],["よ"],["、"],["サムエル"],["よ"],["」"],["と"],["呼ばれた","よばれた"],["。"],["サムエル"],["は"],["起きて","おきて"],["エリ"],["の"],["もと"],["へ"],["行って","いって"],["言った","いった"],["、"],["「"],["あなた"],["が"],["お呼","おおよび"],["に"],["なりました"],["。"],["わたし"],["は"],["、"],["ここ"],["に"],["おります"],["」"],["。"],["エリ"],["は"],["言った","いった"],["、"],["「"],["子","こ"],["よ"],["、"],["わたし"],["は"],["呼ばない","よばない"],["。"],["もう"],["一度","ど"],["寝","ね"],["なさい"],["」"],["。"]]},{"verse":7,"text":"サムエルはまだ主,しゅを知,しらず、主,しゅの言葉,ことばがまだ彼,かれに現,あらわされなかった。","tok":[["サムエル"],["は"],["まだ"],["主","しゅ"],["を"],["知らず","しらず"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["が"],["まだ"],["彼","かれ"],["に"],["現わされなかった","あらわされなかった"],["。"]]},{"verse":8,"text":"主,しゅはまた三度目,どめにサムエルを呼,よばれたので、サムエルは起,おきてエリのもとへ行,いって言,いった、「あなたがお呼,およびになりました。わたしは、ここにおります」。その時,とき、エリは主,しゅがわらべを呼,よばれたのであることを悟,さとった。","tok":[["主","しゅ"],["は"],["また"],["三度目","どめ"],["に"],["サムエル"],["を"],["呼ばれた","よばれた"],["ので"],["、"],["サムエル"],["は"],["起きて","おきて"],["エリ"],["の"],["もと"],["へ"],["行って","いって"],["言った","いった"],["、"],["「"],["あなた"],["が"],["お呼","おおよび"],["に"],["なりました"],["。"],["わたし"],["は"],["、"],["ここ"],["に"],["おります"],["」"],["。"],["その"],["時","とき"],["、"],["エリ"],["は"],["主","しゅ"],["が"],["わらべ"],["を"],["呼ばれた","よばれた"],["ので"],["ある"],["こと"],["を"],["悟った","さとった"],["。"]]},{"verse":9,"text":"そしてエリはサムエルに言,いった、「行,いって寝,ねなさい。もしあなたを呼,よばれたら、『しもべは聞,ききます。主,しゅよ、お話,はなしください』と言,いいなさい」。サムエルは行,いって自分,じぶんの所,ところで寝,ねた。","tok":[["そして"],["エリ"],["は"],["サムエル"],["に"],["言った","いった"],["、"],["「"],["行って","いって"],["寝","ね"],["なさい"],["。"],["もし"],["あなた"],["を"],["呼ばれたら","よばれたら"],["、"],["『"],["しもべ"],["は"],["聞","きき"],["ます"],["。"],["主","しゅ"],["よ"],["、"],["お話","おはなし"],["ください"],["』"],["と"],["言い","いい"],["なさい"],["」"],["。"],["サムエル"],["は"],["行って","いって"],["自分","じぶん"],["の"],["所","ところ"],["で"],["寝た","ねた"],["。"]]},{"verse":10,"text":"主,しゅはきて立,たち、前,まえのように、「サムエルよ、サムエルよ」と呼,よばれたので、サムエルは言,いった、「しもべは聞,ききます。お話,はなしください」。","tok":[["主","しゅ"],["は"],["きて"],["立ち","たち"],["、"],["前","まえ"],["の"],["よう"],["に"],["、"],["「"],["サムエル"],["よ"],["、"],["サムエル"],["よ"],["」"],["と"],["呼ばれた","よばれた"],["ので"],["、"],["サムエル"],["は"],["言った","いった"],["、"],["「"],["しもべ"],["は"],["聞","きき"],["ます"],["。"],["お話","おはなし"],["ください"],["」"],["。"]]},{"verse":11,"text":"その時,とき、主,しゅはサムエルに言,いわれた、「見,みよ、わたしはイスラエルのうちに一つの事,ことをする。それを聞,きく者,ものはみな、耳,みみが二つとも鳴,なるであろう。","tok":[["その"],["時","とき"],["、"],["主","しゅ"],["は"],["サムエル"],["に"],["言われた","いわれた"],["、"],["「"],["見よ","みよ"],["、"],["わたし"],["は"],["イスラエル"],["の"],["うち"],["に"],["一","ひと"],["つ"],["の"],["事","こと"],["を"],["する"],["。"],["それ"],["を"],["聞く","きく"],["者","もの"],["は"],["みな"],["、"],["耳","みみ"],["が"],["二","ふた"],["つ"],["とも"],["鳴","なる"],["で"],["あろう"],["。"]]},{"verse":12,"text":"その日,ひには、わたしが、かつてエリの家,いえについて話,はなしたことを、はじめから終,おわりまでことごとく、エリに行,おこなうであろう。","tok":[["その"],["日","ひ"],["に"],["は"],["、"],["わたし"],["が"],["、"],["かつて"],["エリ"],["の"],["家","いえ"],["について"],["話","はなし"],["た"],["こと"],["を"],["、"],["はじめ"],["から"],["終","おわり"],["まで"],["ことごとく"],["、"],["エリ"],["に"],["行なうで","おこなうで"],["あろう"],["。"]]},{"verse":13,"text":"わたしはエリに、彼,かれが知,しっている悪事,あくじのゆえに、その家,いえを永久,えいきゅうに罰,ばっすることを告,つげる。その子,こらが神,かみをけがしているのに、彼,かれがそれをとめなかったからである。","tok":[["わたし"],["は"],["エリ"],["に"],["、"],["彼","かれ"],["が"],["知って","しって"],["いる"],["悪事","あくじ"],["の"],["ゆえ"],["に"],["、"],["その"],["家","いえ"],["を"],["永久","えいきゅう"],["に"],["罰する","ばっする"],["こと"],["を"],["告げる","つげる"],["。"],["その"],["子","こ"],["ら"],["が"],["神","かみ"],["を"],["けがして"],["いる"],["のに"],["、"],["彼","かれ"],["が"],["それ"],["を"],["とめなかった"],["から"],["で"],["ある"],["。"]]},{"verse":14,"text":"それゆえ、わたしはエリの家,いえに誓,ちかう。エリの家,いえの悪,あくは、犠牲,ぎせいや供,そなえ物,ものをもってしても、永久,えいきゅうにあがなわれないであろう」。","tok":[["それ"],["ゆえ"],["、"],["わたし"],["は"],["エリ"],["の"],["家","いえ"],["に"],["誓う","ちかう"],["。"],["エリ"],["の"],["家","いえ"],["の"],["悪","あく"],["は"],["、"],["犠牲","ぎせい"],["や"],["供え物","そなえもの"],["を"],["もって"],["して"],["も"],["、"],["永久","えいきゅう"],["に"],["あがなわれないで"],["あろう"],["」"],["。"]]},{"verse":15,"text":"サムエルは朝,あさまで寝,ねて、主,しゅの宮,みやの戸,とをあけたが、サムエルはその幻,まぼろしのことをエリに語,かたるのを恐,おそれた。","tok":[["サムエル"],["は"],["朝","あさ"],["まで"],["寝て","ねて"],["、"],["主","しゅ"],["の"],["宮","みや"],["の"],["戸","と"],["を"],["あけた"],["が"],["、"],["サムエル"],["は"],["その"],["幻","まぼろし"],["の"],["こと"],["を"],["エリ"],["に"],["語る","かたる"],["の"],["を"],["恐れた","おそれた"],["。"]]},{"verse":16,"text":"しかしエリはサムエルを呼,よんで言,いった、「わが子,こサムエルよ」。サムエルは言,いった、「はい、ここにおります」。","tok":[["しかし"],["エリ"],["は"],["サムエル"],["を"],["呼んで","よんで"],["言った","いった"],["、"],["「"],["わが"],["子","こ"],["サムエル"],["よ"],["」"],["。"],["サムエル"],["は"],["言った","いった"],["、"],["「"],["はい"],["、"],["ここ"],["に"],["おります"],["」"],["。"]]},{"verse":17,"text":"エリは言,いった、「何事,なにごとをお告,つげになったのか。隠,かくさず話,はなしてください。もしお告,つげになったことを一つでも隠,かくして、わたしに言,いわないならば、どうぞ神,かみがあなたを罰,ばっし、さらに重,おもく罰,ばっせられるように」。","tok":[["エリ"],["は"],["言った","いった"],["、"],["「"],["何事","なにごと"],["を"],["お告","おつげ"],["に"],["なった"],["の"],["か"],["。"],["隠さず","かくさず"],["話","はなし"],["て"],["ください"],["。"],["もし"],["お告","おつげ"],["に"],["なった"],["こと"],["を"],["一","ひと"],["つ"],["で"],["も"],["隠して","かくして"],["、"],["わたし"],["に"],["言わないならば","いわないならば"],["、"],["どうぞ"],["神","かみ"],["が"],["あなた"],["を"],["罰し","ばっし"],["、"],["さらに"],["重く","おもく"],["罰せられる","ばっせられる"],["よう"],["に"],["」"],["。"]]},{"verse":18,"text":"そこでサムエルは、その事,ことをことごとく話,はなして、何,なにも彼,かれに隠,かくさなかった。エリは言,いった、「それは主,しゅである。どうぞ主,しゅが、良,よいと思,おもうことを行,おこなわれるように」。","tok":[["そこ"],["で"],["サムエル"],["は"],["、"],["その"],["事","こと"],["を"],["ことごとく"],["話","はなし"],["て"],["、"],["何に","なに"],["も"],["彼","かれ"],["に"],["隠さなかった","かくさなかった"],["。"],["エリ"],["は"],["言った","いった"],["、"],["「"],["それ"],["は"],["主","しゅ"],["で"],["ある"],["。"],["どうぞ"],["主","しゅ"],["が"],["、"],["良い","よい"],["と"],["思う","おもう"],["こと"],["を"],["行なわれる","おこなわれる"],["よう"],["に"],["」"],["。"]]},{"verse":19,"text":"サムエルは育,そだっていった。主,しゅが彼,かれと共,ともにおられて、その言葉,ことばを一つも地,ちに落,おちないようにされたので、","tok":[["サムエル"],["は"],["育って","そだって"],["いった"],["。"],["主","しゅ"],["が"],["彼","かれ"],["と"],["共","とも"],["に"],["おられて"],["、"],["その"],["言葉","ことば"],["を"],["一","ひと"],["つ"],["も"],["地","ち"],["に"],["落","おち"],["ない"],["よう"],["に"],["された"],["ので"],["、"]]},{"verse":20,"text":"ダンからベエルシバまで、イスラエルのすべての人,ひとは、サムエルが主,しゅの預言者,よげんしゃと定,さだめられたことを知,しった。","tok":[["ダン"],["から"],["ベエルシバ"],["まで"],["、"],["イスラエル"],["の"],["すべて"],["の"],["人","ひと"],["は"],["、"],["サムエル"],["が"],["主","しゅ"],["の"],["預言者","よげんしゃ"],["と"],["定められた","さだめられた"],["こと"],["を"],["知った","しった"],["。"]]},{"verse":21,"text":"主,しゅはふたたびシロで現,あらわれられた。すなわち主,しゅはシロで、主,しゅの言葉,ことばによって、サムエルに自,みずからを現,あらわされた。こうしてサムエルの言葉,ことばは、あまねくイスラエルの人々,ひとびとに及,およんだ。","tok":[["主","しゅ"],["は"],["ふたたび"],["シロ"],["で"],["現われられた","あらわれられた"],["。"],["すなわち"],["主","しゅ"],["は"],["シロ"],["で"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["によって"],["、"],["サムエル"],["に"],["自から","みずから"],["を"],["現わされた","あらわされた"],["。"],["こう"],["して"],["サムエル"],["の"],["言葉","ことば"],["は"],["、"],["あまねく"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["及んだ","およんだ"],["。"]]}]
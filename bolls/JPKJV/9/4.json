[{"verse":1,"text":"イスラエルびとは出,でてペリシテびとと戦,たたかおうとして、エベネゼルのほとりに陣,じんをしき、ペリシテびとはアペクに陣,じんをしいた。","tok":[["イスラエル"],["び"],["と"],["は"],["出て","でて"],["ペリシテ"],["びと"],["と"],["戦おう","たたかおう"],["として"],["、"],["エベネゼル"],["の"],["ほとり"],["に"],["陣","じん"],["を"],["しき"],["、"],["ペリシテ"],["び"],["と"],["は"],["アペク"],["に"],["陣","じん"],["を"],["しいた"],["。"]]},{"verse":2,"text":"ペリシテびとはイスラエルびとにむかって陣,じん備,そなえをしたが、戦,たたかうに及,およんで、イスラエルびとはペリシテびとの前,まえに敗,やぶれ、ペリシテびとは戦場,せんじょうにおいて、おおよそ四千人,にんを殺,ころした。","tok":[["ペリシテ"],["び"],["と"],["は"],["イスラエル"],["びと"],["に"],["むかって"],["陣","じん"],["備","そなえ"],["を"],["した"],["が"],["、"],["戦う","たたかう"],["に"],["及んで","およんで"],["、"],["イスラエル"],["び"],["と"],["は"],["ペリシテ"],["びと"],["の"],["前","まえ"],["に"],["敗れ","やぶれ"],["、"],["ペリシテ"],["び"],["と"],["は"],["戦場","せんじょう"],["に"],["おいて"],["、"],["おおよそ"],["四千人","にん"],["を"],["殺ろした","ころした"],["。"]]},{"verse":3,"text":"民,たみが陣営,じんえいに退,しりぞいた時,とき、イスラエルの長老,ちょうろうたちは言,いった、「なにゆえ、主,しゅはきょう、ペリシテびとの前,まえにわれわれを敗,やぶられたのか。シロへ行,いって主,しゅの契約,けいやくの箱,はこをここへ携,たずさえてくることにしよう。そして主,しゅをわれわれのうちに迎,むかえて、敵,てきの手,てから救,すくっていただこう」。","tok":[["民","た"],["み"],["が"],["陣営","じんえい"],["に"],["退ぞいた","しりぞいた"],["時","とき"],["、"],["イスラエル"],["の"],["長老","ちょうろう"],["たち"],["は"],["言った","いった"],["、"],["「"],["なにゆえ"],["、"],["主","しゅ"],["は"],["きょう"],["、"],["ペリシテ"],["びと"],["の"],["前","まえ"],["に"],["われわれ"],["を"],["敗られた","やぶられた"],["の"],["か"],["。"],["シロ"],["へ"],["行って","いって"],["主","しゅ"],["の"],["契約","けいやく"],["の"],["箱","はこ"],["を"],["ここ"],["へ"],["携えて","たずさえて"],["くる"],["こと"],["に"],["しよう"],["。"],["そして"],["主","しゅ"],["を"],["われわれ"],["の"],["うち"],["に"],["迎","むかえ"],["て"],["、"],["敵","てき"],["の"],["手","て"],["から"],["救って","すくって"],["いただこう"],["」"],["。"]]},{"verse":4,"text":"そこで民,たみは人,ひとをシロにつかわし、ケルビムの上,うえに座,ざしておられる万軍,ばんぐんの主,しゅの契約,けいやくの箱,はこを、そこから携,たずさえてこさせた。その時,ときエリのふたりの子,こ、ホフニとピネハスは神,かみの契約,けいやくの箱,はこと共,ともに、その所,ところにいた。","tok":[["そこ"],["で"],["民","たみ"],["は"],["人","ひと"],["を"],["シロ"],["に"],["つかわし"],["、"],["ケルビム"],["の"],["上","うえ"],["に"],["座して","ざして"],["おられる"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["の"],["契約","けいやく"],["の"],["箱","はこ"],["を"],["、"],["そこ"],["から"],["携えて","たずさえて"],["こさせた"],["。"],["その"],["時","とき"],["エリ"],["の"],["ふたり"],["の"],["子","こ"],["、"],["ホフニ"],["と"],["ピネハス"],["は"],["神","かみ"],["の"],["契約","けいやく"],["の"],["箱","はこ"],["と"],["共","とも"],["に"],["、"],["その"],["所","ところ"],["に"],["いた"],["。"]]},{"verse":5,"text":"主,しゅの契約,けいやくの箱,はこが陣営,じんえいについた時,とき、イスラエルびとはみな大声,おおごえで叫,さけんだので、地,ちは鳴,なり響,ひびいた。","tok":[["主","しゅ"],["の"],["契約","けいやく"],["の"],["箱","は"],["こ"],["が"],["陣営","じんえい"],["に"],["ついた"],["時","とき"],["、"],["イスラエル"],["び"],["と"],["は"],["みな"],["大声","おおごえ"],["で"],["叫けんだ","さけんだ"],["ので"],["、"],["地","ち"],["は"],["鳴り響いた","なりひびいた"],["。"]]},{"verse":6,"text":"ペリシテびとは、その叫,さけび声,ごえを聞,きいて言,いった、「ヘブルびとの陣営,じんえいの、この大,おおきな叫,さけび声,ごえは何事,なにごとか」。そして主,しゅの箱,はこが、陣営,じんえいに着,ついたことを知,しった時,とき、","tok":[["ペリシテ"],["び"],["と"],["は"],["、"],["その"],["叫声","さけびごえ"],["を"],["聞いて","きいて"],["言った","いった"],["、"],["「"],["ヘブル"],["びと"],["の"],["陣営","じんえい"],["の"],["、"],["この"],["大きな","おおきな"],["叫声","さけびごえ"],["は"],["何事","なにごと"],["か"],["」"],["。"],["そして"],["主","しゅ"],["の"],["箱","は"],["こ"],["が"],["、"],["陣営","じんえい"],["に"],["着いた","ついた"],["こと"],["を"],["知った","しった"],["時","とき"],["、"]]},{"verse":7,"text":"ペリシテびとは恐,おそれて言,いった、「神々,かみがみが陣営,じんえいにきたのだ」。彼,かれらはまた言,いった、「ああ、われわれはわざわいである。このようなことは今,いままでなかった。","tok":[["ペリシテ"],["び"],["と"],["は"],["恐れて","おそれて"],["言った","いった"],["、"],["「"],["神々","かみがみ"],["が"],["陣営","じんえい"],["に"],["きた"],["の"],["だ"],["」"],["。"],["彼","かれ"],["ら"],["は"],["また"],["言った","いった"],["、"],["「"],["ああ"],["、"],["われわれ"],["は"],["わざわい"],["で"],["ある"],["。"],["この"],["よう"],["な"],["こと"],["は"],["今まで","いままで"],["なかった"],["。"]]},{"verse":8,"text":"ああ、われわれはわざわいである。だれがわれわれをこれらの強,つよい神々,かみがみの手,てから救,すくい出,だすことができようか。これらの神々,かみがみは、もろもろの災,わざわいをもってエジプトびとを荒野,あらので撃,うったのだ。","tok":[["ああ"],["、"],["われわれ"],["は"],["わざわい"],["で"],["ある"],["。"],["だれ"],["が"],["われわれ"],["を"],["これ"],["ら"],["の"],["強い","つよい"],["神々","かみがみ"],["の"],["手","て"],["から"],["救い出す","すくいだす"],["こと"],["が"],["できよう"],["か"],["。"],["これ"],["ら"],["の"],["神々","かみがみ"],["は"],["、"],["もろもろ"],["の"],["災","わざわい"],["を"],["もって"],["エジプト"],["びと"],["を"],["荒野","あらの"],["で"],["撃った","うった"],["の"],["だ"],["。"]]},{"verse":9,"text":"ペリシテびとよ、勇気,ゆうきを出,だして男,おとこらしくせよ。ヘブルびとがあなたがたに仕,つかえたように、あなたがたが彼,かれらに仕,つかえることのないために、男,おとこらしく戦,たたかえ」。","tok":[["ペリシテ"],["びと"],["よ"],["、"],["勇気","ゆうき"],["を"],["出して","だして"],["男","おとこ"],["らしく"],["せよ"],["。"],["ヘブル"],["びと"],["が"],["あなた"],["がた"],["に"],["仕えた","つかえた"],["よう"],["に"],["、"],["あなた"],["がた"],["が"],["彼","かれ"],["ら"],["に"],["仕える","つかえる"],["こと"],["の"],["ない"],["ため"],["に"],["、"],["男","おとこ"],["らしく"],["戦え","たたかえ"],["」"],["。"]]},{"verse":10,"text":"こうしてペリシテびとが戦,たたかったので、イスラエルびとは敗,やぶれて、おのおのその家,いえに逃,にげて帰,かえった。戦死者,せんししゃはひじょうに多,おおく、イスラエルの歩兵,ほへいで倒,たおれたものは三万であった。","tok":[["こう"],["して"],["ペリシテ"],["びと"],["が"],["戦った","たたかった"],["ので"],["、"],["イスラエル"],["び"],["と"],["は"],["敗れて","やぶれて"],["、"],["おのおの"],["その"],["家","いえ"],["に"],["逃て","にげて"],["帰えった","かえった"],["。"],["戦死者","せんししゃ"],["は"],["ひじょう"],["に"],["多く","おおく"],["、"],["イスラエル"],["の"],["歩兵","ほ"],["へい"],["で"],["倒れた","たおれた"],["もの"],["は"],["三万","さんまん"],["で"],["あった"],["。"]]},{"verse":11,"text":"また神,かみの箱,はこは奪,うばわれ、エリのふたりの子,こ、ホフニとピネハスは殺,ころされた。","tok":[["また"],["神","かみ"],["の"],["箱","はこ"],["は"],["奪われ","うばわれ"],["、"],["エリ"],["の"],["ふたり"],["の"],["子","こ"],["、"],["ホフニ"],["と"],["ピネハス"],["は"],["殺ろされた","ころされた"],["。"]]},{"verse":12,"text":"その日,ひひとりのベニヤミンびとが、衣服,いふくを裂,さき、頭,あたまに土,つちをかぶって、戦場,せんじょうから走,はしってシロにきた。","tok":[["その"],["日","ひ"],["ひとり"],["の"],["ベニヤミン"],["びと"],["が"],["、"],["衣服","いふく"],["を"],["裂き","さき"],["、"],["頭","あたま"],["に"],["土","つち"],["を"],["かぶって"],["、"],["戦場","せんじょう"],["から"],["走って","はしって"],["シロ"],["に"],["きた"],["。"]]},{"verse":13,"text":"彼,かれが着,ついたとき、エリは道,みちのかたわらにある自分,じぶんの座,ざにすわって待,まちかまえていた。その心,こころに神,かみの箱,はこの事,ことを気,きづかっていたからである。その人,ひとが町,まちにはいって、情報,じょうほうをつたえたので、町,まちはこぞって叫,さけんだ。","tok":[["彼","かれ"],["が"],["着いた","ついた"],["とき"],["、"],["エリ"],["は"],["道","みち"],["の"],["かたわら"],["に"],["ある"],["自分","じぶん"],["の"],["座","ざ"],["に"],["すわって"],["待","まち"],["かまえて"],["いた"],["。"],["その"],["心","こころ"],["に"],["神","かみ"],["の"],["箱","はこ"],["の"],["事","こと"],["を"],["気づかって","きづかって"],["いた"],["から"],["で"],["ある"],["。"],["その"],["人","ひと"],["が"],["町","まち"],["に"],["はいって"],["、"],["情報","じょうほう"],["を"],["つたえた"],["ので"],["、"],["町","まち"],["は"],["こぞって"],["叫けんだ","さけんだ"],["。"]]},{"verse":14,"text":"エリはその叫,さけび声,ごえを聞,きいて言,いった、「この騒,さわぎ声,こえは何,なにか」。その人,ひとは急,いそいでエリの所,ところへきてエリに告,つげた。","tok":[["エリ"],["は"],["その"],["叫声","さけびごえ"],["を"],["聞いて","きいて"],["言った","いった"],["、"],["「"],["この"],["騒","さわぎ"],["声","こえ"],["は"],["何に","なに"],["か"],["」"],["。"],["その"],["人","ひと"],["は"],["急いで","いそいで"],["エリ"],["の"],["所","ところ"],["へ"],["きて"],["エリ"],["に"],["告","つげ"],["た"],["。"]]},{"verse":15,"text":"その時,ときエリは九十八歳,さいで、その目,めは固,かたまって見,みることができなかった。","tok":[["その"],["時","とき"],["エリ"],["は"],["九十八歳","さ"],["いで"],["、"],["その"],["目","め"],["は"],["固まって","かたまって"],["見る","みる"],["こと"],["が"],["できなかった"],["。"]]},{"verse":16,"text":"その人,ひとはエリに言,いった、「わたしは戦場,せんじょうからきたものです。きょう戦場,せんじょうからのがれたのです」。エリは言,いった、「わが子,こよ、様子,ようすはどうであったか」。","tok":[["その"],["人","ひと"],["は"],["エリ"],["に"],["言った","いった"],["、"],["「"],["わたし"],["は"],["戦場","せんじょう"],["から"],["きた"],["もの"],["です"],["。"],["きょう"],["戦場","せんじょう"],["から"],["のがれた"],["の"],["です"],["」"],["。"],["エリ"],["は"],["言った","いった"],["、"],["「"],["わが"],["子","こ"],["よ"],["、"],["様子","ようす"],["は"],["どう"],["で"],["あった"],["か"],["」"],["。"]]},{"verse":17,"text":"しらせをもたらしたその人,ひとは答,こたえて言,いった、「イスラエルびとは、ペリシテびとの前,まえから逃,にげ、民,たみのうちにはまた多,おおくの戦死者,せんししゃがあり、あなたのふたりの子,こ、ホフニとピネハスも死,しに、神,かみの箱,はこは奪,うばわれました」。","tok":[["しらせ"],["を"],["もたらした"],["その"],["人","ひと"],["は"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["イスラエル"],["び"],["と"],["は"],["、"],["ペリシテ"],["びと"],["の"],["前","まえ"],["から"],["逃","にげ"],["、"],["民","たみ"],["の"],["うち"],["に"],["は"],["また"],["多く","おおく"],["の"],["戦死者","せんししゃ"],["が"],["あり"],["、"],["あなた"],["の"],["ふたり"],["の"],["子","こ"],["、"],["ホフニ"],["と"],["ピネハス"],["も"],["死に","しに"],["、"],["神","かみ"],["の"],["箱","はこ"],["は"],["奪われました","うばわれました"],["」"],["。"]]},{"verse":18,"text":"彼,かれが神,かみの箱,はこのことを言,いったとき、エリはその座,ざから、あおむけに門,もんのかたわらに落,おち、首,くびを折,おって死,しんだ。老,おいて身,みが重,おもかったからである。彼,かれのイスラエルをさばいたのは四十年,ねんであった。","tok":[["彼","かれ"],["が"],["神","かみ"],["の"],["箱","はこ"],["の"],["こと"],["を"],["言った","いった"],["とき"],["、"],["エリ"],["は"],["その"],["座","ざ"],["から"],["、"],["あおむけ"],["に"],["門","もん"],["の"],["かたわら"],["に"],["落","おち"],["、"],["首","くび"],["を"],["折って","おって"],["死んだ","しんだ"],["。"],["老","おい"],["て"],["身","み"],["が"],["重かった","おもかった"],["から"],["で"],["ある"],["。"],["彼","かれ"],["の"],["イスラエル"],["を"],["さばいた"],["の"],["は"],["四十","よんじゅう"],["年","ねん"],["で"],["あった"],["。"]]},{"verse":19,"text":"彼,かれの嫁,よめ、ピネハスの妻,つまはみごもって出産,しゅっさんの時,ときが近,ちかづいていたが、神,かみの箱,はこが奪,うばわれたこと、しゅうとと夫,おっとが死,しんだというしらせを聞,きいたとき、陣痛,じんつうが起,おこり身,みをかがめて子,こを産,うんだ。","tok":[["彼","かれ"],["の"],["嫁","よめ"],["、"],["ピネハス"],["の"],["妻","つま"],["は"],["みごもって"],["出産","しゅっさん"],["の"],["時","とき"],["が"],["近づいて","ちかづいて"],["いた"],["が"],["、"],["神","かみ"],["の"],["箱","は"],["こ"],["が"],["奪われた","うばわれた"],["こと"],["、"],["しゅうと"],["と"],["夫","おっと"],["が"],["死んだ","しんだ"],["と"],["いう"],["しらせ"],["を"],["聞いた","きいた"],["とき"],["、"],["陣痛","じんつう"],["が"],["起こり","おこり"],["身","み"],["を"],["かがめて"],["子","こ"],["を"],["産んだ","うんだ"],["。"]]},{"verse":20,"text":"彼女,かのじょが死,しにかかっている時,とき、世話,せわをしていた女,おんなが彼女,かのじょに言,いった、「恐,おそれることはありません。男,おとこの子,こが生,うまれました」。しかし彼女,かのじょは答,こたえもせず、また顧,かえりみもしなかった。","tok":[["彼女","かのじょ"],["が"],["死にかかって","しにかかって"],["いる"],["時","とき"],["、"],["世話","せわ"],["を"],["して"],["いた"],["女","おんな"],["が"],["彼女","かのじょ"],["に"],["言った","いった"],["、"],["「"],["恐れる","おそれる"],["こと"],["は"],["ありません"],["。"],["男の子","おとこのこ"],["が"],["生まれました","うまれました"],["」"],["。"],["しかし"],["彼女","かのじょ"],["は"],["答","こたえ"],["も"],["せず"],["、"],["また"],["顧りみ","かえりみ"],["も"],["しなかった"],["。"]]},{"verse":21,"text":"ただ彼女,かのじょは「栄光,えいこうはイスラエルを去,さった」と言,いって、その子,こをイカボデと名,なづけた。これは神,かみの箱,はこの奪,うばわれたこと、また彼女,かのじょのしゅうとと夫,おっとのことによるのである。","tok":[["ただ"],["彼女","かのじょ"],["は"],["「"],["栄光","えいこう"],["は"],["イスラエル"],["を"],["去た","さった"],["」"],["と"],["言って","いって"],["、"],["その"],["子","こ"],["を"],["イカボデ"],["と"],["名づけた","なづけた"],["。"],["これ"],["は"],["神","かみ"],["の"],["箱","はこ"],["の"],["奪われた","うばわれた"],["こと"],["、"],["また"],["彼女","かのじょ"],["の"],["しゅうと"],["と"],["夫","おっと"],["の"],["こと"],["に"],["よる"],["ので"],["ある"],["。"]]},{"verse":22,"text":"彼女,かのじょはまた、「栄光,えいこうはイスラエルを去,さった。神,かみの箱,はこが奪,うばわれたからです」と言,いった。","tok":[["彼女","かのじょ"],["は"],["また"],["、"],["「"],["栄光","えいこう"],["は"],["イスラエル"],["を"],["去た","さった"],["。"],["神","かみ"],["の"],["箱","は"],["こ"],["が"],["奪われた","うばわれた"],["から"],["です"],["」"],["と"],["言った","いった"],["。"]]}]
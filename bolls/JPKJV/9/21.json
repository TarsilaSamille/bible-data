[{"verse":1,"text":"[20:42b]こうしてダビデは立,たち去,さり、ヨナタンは町,まちにはいった。","tok":[["["],["20"],[":"],["42"],["b"],["]"],["こう"],["して"],["ダビデ"],["は"],["立ち去り","たちさり"],["、"],["ヨナタン"],["は"],["町","まち"],["に"],["はいった"],["。"]]},{"verse":2,"text":"[1]ダビデはノブに行,いき、祭司,さいしアヒメレクのところへ行,いった。アヒメレクはおののきながらダビデを迎,むかえて言,いった、「どうしてあなたはひとりですか。だれも供,ともがいないのですか」。","tok":[["["],["1"],["]"],["ダビデ"],["は"],["ノブ"],["に"],["行き","いき"],["、"],["祭司","さいし"],["アヒメレク"],["の"],["ところ"],["へ"],["行った","いった"],["。"],["アヒメレク"],["は"],["おののき"],["ながら"],["ダビデ"],["を"],["迎","むかえ"],["て"],["言った","いった"],["、"],["「"],["どう"],["して"],["あなた"],["は"],["ひとり"],["です"],["か"],["。"],["だれ"],["も"],["供","とも"],["が"],["いない"],["の"],["です"],["か"],["」"],["。"]]},{"verse":3,"text":"[2]ダビデは祭司,さいしアヒメレクに言,いった、「王,おうがわたしに一つの事,ことを命,めいじて、『わたしがおまえをつかわしてさせる事,こと、またわたしが命,めいじたことについては、何,なにをも人,ひとに知,しらせてはならない』と言,いわれました。そこでわたしは、ある場所,ばしょに若者,わかものたちを待,またせてあります。","tok":[["["],["2"],["]"],["ダビデ"],["は"],["祭司","さいし"],["アヒメレク"],["に"],["言った","いった"],["、"],["「"],["王","おう"],["が"],["わたし"],["に"],["一","ひと"],["つ"],["の"],["事","こと"],["を"],["命じて","めいじて"],["、"],["『"],["わたし"],["が"],["おまえ"],["を"],["つかわして"],["させる"],["事","こと"],["、"],["また"],["わたし"],["が"],["命じた","めいじた"],["こと"],["について"],["は"],["、"],["何に","なに"],["を"],["も"],["人","ひと"],["に"],["知らせて","しらせて"],["は"],["ならない"],["』"],["と"],["言われました","いわれました"],["。"],["そこ"],["で"],["わたし"],["は"],["、"],["ある"],["場所","ばしょ"],["に"],["若者","わかもの"],["たち"],["を"],["待たせて","またせて"],["あります"],["。"]]},{"verse":4,"text":"[3]ところで今,いまあなたの手,てもとにパン五個,こでもあれば、それをわたしにください。なければなんでも、あるものをください」。","tok":[["["],["3"],["]"],["ところ"],["で"],["今","いま"],["あなた"],["の"],["手もと","てもと"],["に"],["パン"],["五個","こ"],["で"],["も"],["あれば"],["、"],["それ"],["を"],["わたし"],["に"],["ください"],["。"],["なければ"],["なん"],["で"],["も"],["、"],["ある"],["もの"],["を"],["ください"],["」"],["。"]]},{"verse":5,"text":"[4]祭司,さいしはダビデに答,こたえて言,いった、「常,つねのパンはわたしの手,てもとにありません。ただその若者,わかものたちが女,おんなを慎,つつしんでさえいたのでしたら、聖別,せいべつしたパンがあります」。","tok":[["["],["4"],["]"],["祭司","さいし"],["は"],["ダビデ"],["に"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["常","つね"],["の"],["パン"],["は"],["わたし"],["の"],["手もと","てもと"],["に"],["ありません"],["。"],["ただ"],["その"],["若者","わかもの"],["たち"],["が"],["女","おんな"],["を"],["慎しんで","つつしんで"],["さえ"],["いた"],["の"],["でしたら"],["、"],["聖別","せいべつ"],["した"],["パン"],["が"],["あります"],["」"],["。"]]},{"verse":6,"text":"[5]ダビデは祭司,さいしに答,こたえた、「わたしが戦,たたかいに出,でるいつもの時,ときのように、われわれはたしかに女,おんなたちを近,ちかづけていません。若者,わかものたちの器,うつわは、常,つねの旅,たびであったとしても、清,きよいのです。まして、きょう、彼,かれらの器,うつわは清,きよくないでしょうか」。","tok":[["["],["5"],["]"],["ダビデ"],["は"],["祭司","さいし"],["に"],["答","こたえ"],["た"],["、"],["「"],["わたし"],["が"],["戦い","たたかい"],["に"],["出る","でる"],["いつも"],["の"],["時","とき"],["の"],["よう"],["に"],["、"],["われわれ"],["は"],["たしか"],["に"],["女","おんな"],["たち"],["を"],["近づけて","ちかづけて"],["いません"],["。"],["若者","わかもの"],["たち"],["の"],["器","うつわ"],["は"],["、"],["常","つね"],["の"],["旅","たび"],["で"],["あった"],["として"],["も"],["、"],["清い","きよい"],["の"],["です"],["。"],["まして"],["、"],["きょう"],["、"],["彼","かれ"],["ら"],["の"],["器","うつわ"],["は"],["清く","きよく"],["ないでしょう"],["か"],["」"],["。"]]},{"verse":7,"text":"[6]そこで祭司,さいしは彼,かれに聖別,せいべつしたパンを与,あたえた。その所,ところに、供,そなえのパンのほかにパンがなく、このパンは、これを取,とり下,さげる日,ひに、あたたかいパンと置,おきかえるため、主,しゅの前,まえから取,とり下,とりさげたものである。","tok":[["["],["6"],["]"],["そこ"],["で"],["祭司","さいし"],["は"],["彼","かれ"],["に"],["聖別","せいべつ"],["した"],["パン"],["を"],["与","あたえ"],["た"],["。"],["その"],["所","ところ"],["に"],["、"],["供え","そなえ"],["の"],["パン"],["の"],["ほか"],["に"],["パン"],["が"],["なく"],["、"],["この"],["パン"],["は"],["、"],["これ"],["を"],["取下げる","とりさげる"],["日","ひ"],["に"],["、"],["あたたかい"],["パン"],["と"],["置きかえる","おきかえる"],["ため"],["、"],["主","しゅ"],["の"],["前","まえ"],["から"],["取","とり"],["下り","とり"],["さげた"],["もの"],["で"],["ある"],["。"]]},{"verse":8,"text":"[7]その日,ひ、その所,ところに、サウルのしもべのひとりが、主,しゅの前,まえに留,とめ置,おかれていた。その名,なはドエグといい、エドムびとであって、サウルの牧者,ぼくしゃの長,ちょうであった。","tok":[["["],["7"],["]"],["その"],["日","ひ"],["、"],["その"],["所","ところ"],["に"],["、"],["サウル"],["の"],["しもべ"],["の"],["ひとり"],["が"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["留置かれて","とめおかれて"],["いた"],["。"],["その"],["名","な"],["は"],["ドエグ"],["と"],["いい"],["、"],["エドム"],["びと"],["で"],["あって"],["、"],["サウル"],["の"],["牧者","ぼくしゃ"],["の"],["長","ちょう"],["で"],["あった"],["。"]]},{"verse":9,"text":"[8]ダビデはまたアヒメレクに言,いった、「ここに、あなたの手,てもとに、やりかつるぎがありませんか。王,おうの事,ことが急,きゅうを要,ようしたので、わたしはつるぎも武器,ぶきも持,もってこなかったのです」。","tok":[["["],["8"],["]"],["ダビデ"],["は"],["また"],["アヒメレク"],["に"],["言った","いった"],["、"],["「"],["ここ"],["に"],["、"],["あなた"],["の"],["手もと","てもと"],["に"],["、"],["やり"],["か"],["つるぎ"],["が"],["ありません"],["か"],["。"],["王","おう"],["の"],["事","こと"],["が"],["急","きゅう"],["を"],["要した","ようした"],["ので"],["、"],["わたし"],["は"],["つるぎ"],["も"],["武器","ぶき"],["も"],["持って","もって"],["こなかった"],["の"],["です"],["」"],["。"]]},{"verse":10,"text":"[9]祭司,さいしは言,いった、「あなたがエラの谷,たにで殺,ころしたペリシテびとゴリアテのつるぎが、布,ぬのに包,つつんでエポデのうしろにあります。もしあなたがこれを取,とろうとおもわれるなら、お取,とりください。ここにはそのほかにはありません」。ダビデは言,いった、「それにまさるものはありません。それをわたしにください」。","tok":[["["],["9"],["]"],["祭司","さいし"],["は"],["言った","いった"],["、"],["「"],["あなた"],["が"],["エラ"],["の"],["谷","たに"],["で"],["殺ろした","ころした"],["ペリシテ"],["び"],["と"],["ゴリアテ"],["の"],["つるぎ"],["が"],["、"],["布","ぬの"],["に"],["包んで","つつんで"],["エポデ"],["の"],["うしろ"],["に"],["あります"],["。"],["もし"],["あなた"],["が"],["これ"],["を"],["取ろう","とろう"],["と"],["おもわれるなら"],["、"],["お取","おとり"],["ください"],["。"],["ここ"],["に"],["は"],["その"],["ほか"],["に"],["は"],["ありません"],["」"],["。"],["ダビデ"],["は"],["言った","いった"],["、"],["「"],["それ"],["に"],["まさる"],["もの"],["は"],["ありません"],["。"],["それ"],["を"],["わたし"],["に"],["ください"],["」"],["。"]]},{"verse":11,"text":"[10]ダビデはその日,ひサウルを恐,おそれて、立,たってガテの王,おうアキシのところへ逃,にげて行,いった。","tok":[["["],["10"],["]"],["ダビデ"],["は"],["その"],["日","ひ"],["サウル"],["を"],["恐れて","おそれて"],["、"],["立って","たって"],["ガテ"],["の"],["王","おう"],["アキシ"],["の"],["ところ"],["へ"],["逃て","にげて"],["行った","いった"],["。"]]},{"verse":12,"text":"[11]アキシの家来,けらいたちはアキシに言,いった、「これはあの国,くにの王,おうダビデではありませんか。人々,ひとびとが踊,おどりながら、互,たがいに歌,うたいかわして、『サウルは千を撃,うち殺,ころし、ダビデは万,まんを撃,うち殺,ころした』と言,いったのは、この人,ひとのことではありませんか」。","tok":[["["],["11"],["]"],["アキシ"],["の"],["家来","けらい"],["たち"],["は"],["アキシ"],["に"],["言った","いった"],["、"],["「"],["これ"],["は"],["あの"],["国","くに"],["の"],["王","おう"],["ダビデ"],["で"],["は"],["ありません"],["か"],["。"],["人々","ひとびと"],["が"],["踊","おどり"],["ながら"],["、"],["互","たがい"],["に"],["歌い","うたい"],["かわして"],["、"],["『"],["サウル"],["は"],["千","せん"],["を"],["撃ち殺し","うちころし"],["、"],["ダビデ"],["は"],["万","まん"],["を"],["撃ち殺した","うちころした"],["』"],["と"],["言った","いった"],["の"],["は"],["、"],["この"],["人","ひと"],["の"],["こと"],["で"],["は"],["ありません"],["か"],["」"],["。"]]},{"verse":13,"text":"[12]ダビデは、これらの言葉,ことばを心,こころにおき、ガテの王,おうアキシを、ひじょうに恐,おそれたので、","tok":[["["],["12"],["]"],["ダビデ"],["は"],["、"],["これ"],["ら"],["の"],["言葉","ことば"],["を"],["心","こころ"],["に"],["おき"],["、"],["ガテ"],["の"],["王","おう"],["アキシ"],["を"],["、"],["ひじょう"],["に"],["恐れた","おそれた"],["ので"],["、"]]},{"verse":14,"text":"[13]人々,ひとびとの前,まえで、わざと挙動,きょどうを変,かえ、捕,とらえられて気違,きちがいのふりをし、門,もんのとびらを打,うちたたき、よだれを流,ながして、ひげに伝,つたわらせた。","tok":[["["],["13"],["]"],["人々","ひとびと"],["の"],["前","まえ"],["で"],["、"],["わざと"],["挙動","きょどう"],["を"],["変え","かえ"],["、"],["捕らえられて","とらえられて"],["気違","きちがい"],["の"],["ふり"],["を"],["し"],["、"],["門","もん"],["の"],["とびら"],["を"],["打ちたたき","うちたたき"],["、"],["よだれ"],["を"],["流して","ながして"],["、"],["ひげ"],["に"],["伝わらせた","つたわらせた"],["。"]]},{"verse":15,"text":"[14]アキシは家来,けらいたちに言,いった、「あなたがたの見,みるように、この人,ひとは気違,きちがいだ。どうして彼,かれをわたしの所,ところへ連,つれてきたのか。","tok":[["["],["14"],["]"],["アキシ"],["は"],["家来","けらい"],["たち"],["に"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["の"],["見る","みる"],["よう"],["に"],["、"],["この"],["人","ひと"],["は"],["気違","きちがい"],["だ"],["。"],["どう"],["して"],["彼","かれ"],["を"],["わたし"],["の"],["所","ところ"],["へ"],["連れて","つれて"],["きた"],["の"],["か"],["。"]]},{"verse":16,"text":"[15]わたしに気違,きちがいが必要,ひつようなのか。この者,ものを連,つれてきて、わたしの前,まえで狂,くるわせようというのか。この者,ものをわたしの家,いえへ入,いれようとするのか」。","tok":[["["],["15"],["]"],["わたし"],["に"],["気違","きちがい"],["が"],["必要","ひつよう"],["な"],["の"],["か"],["。"],["この"],["者","もの"],["を"],["連れて","つれて"],["きて"],["、"],["わたし"],["の"],["前","まえ"],["で"],["狂わせよう","くるわせよう"],["と"],["いう"],["の"],["か"],["。"],["この"],["者","もの"],["を"],["わたし"],["の"],["家","いえ"],["へ"],["入れよう","いれよう"],["と"],["する"],["の"],["か"],["」"],["。"]]}]
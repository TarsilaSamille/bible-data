[{"verse":1,"text":"こうしてダビデはその所,ところを去,さり、アドラムのほら穴,あなへのがれた。彼,かれの兄弟,きょうだいたちと父,ちちの家,いえの者,ものは皆,みな、これを聞,きき、その所,ところに下,くだって彼,かれのもとにきた。","tok":[["こう"],["して"],["ダビデ"],["は"],["その"],["所","ところ"],["を"],["去り","さり"],["、"],["アドラム"],["の"],["ほら穴","ほらあな"],["へ"],["のがれた"],["。"],["彼","かれ"],["の"],["兄弟","きょうだい"],["たち"],["と"],["父","ちち"],["の"],["家","いえ"],["の"],["者","もの"],["は"],["皆","みな"],["、"],["これ"],["を"],["聞","きき"],["、"],["その"],["所","ところ"],["に"],["下って","くだって"],["彼","かれ"],["の"],["もと"],["に"],["きた"],["。"]]},{"verse":2,"text":"また、しえたげられている人々,ひとびと、負債,ふさいのある人々,ひとびと、心,こころに不満,ふまんのある人々,ひとびとも皆,みな、彼,かれのもとに集,あつまってきて、彼,かれはその長,ちょうとなった。おおよそ四百人,にんの人々,ひとびとが彼,かれと共,ともにあった。","tok":[["また"],["、"],["し"],["えたげられて"],["いる"],["人々","ひとびと"],["、"],["負債","ふさい"],["の"],["ある"],["人々","ひとびと"],["、"],["心","こころ"],["に"],["不満","ふまん"],["の"],["ある"],["人々","ひとびと"],["も"],["皆","みな"],["、"],["彼","かれ"],["の"],["もと"],["に"],["集まって","あつまって"],["きて"],["、"],["彼","かれ"],["は"],["その"],["長","ちょう"],["と"],["なった"],["。"],["おおよそ"],["四百人","にん"],["の"],["人々","ひとびと"],["が"],["彼","かれ"],["と"],["共","とも"],["に"],["あった"],["。"]]},{"verse":3,"text":"ダビデはそこからモアブのミヅパへ行,いき、モアブの王,おうに言,いった、「神,かみがわたしのためにどんなことをされるかわかるまで、どうぞわたしの父母,ふぼをあなたの所,ところにおらせてください」。","tok":[["ダビデ"],["は"],["そこ"],["から"],["モアブ"],["の"],["ミヅパ"],["へ"],["行き","いき"],["、"],["モアブ"],["の"],["王","おう"],["に"],["言った","いった"],["、"],["「"],["神","かみ"],["が"],["わたし"],["の"],["ため"],["に"],["どんな"],["こと"],["を"],["される"],["か"],["わかる"],["まで"],["、"],["どうぞ"],["わたし"],["の"],["父母","ふぼ"],["を"],["あなた"],["の"],["所","ところ"],["に"],["おらせて"],["ください"],["」"],["。"]]},{"verse":4,"text":"そして彼,かれはモアブの王,おうに彼,かれらを託,たくしたので、彼,かれらはダビデが要害,ようがいにおる間,あいだ、王,おうの所,ところにおった。","tok":[["そして"],["彼","かれ"],["は"],["モアブ"],["の"],["王","おう"],["に"],["彼","かれ"],["ら"],["を"],["託した","たくした"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["ダビデ"],["が"],["要害","ようがい"],["に"],["おる"],["間","あ"],["い"],["だ"],["、"],["王","おう"],["の"],["所","ところ"],["に"],["おった"],["。"]]},{"verse":5,"text":"さて、預言者,よげんしゃガドはダビデに言,いった、「要害,ようがいにとどまっていないで、去,さってユダの地,ちへ行,いきなさい」。そこでダビデは去,さって、ハレテの森,もりへ行,いった。","tok":[["さて"],["、"],["預言者","よげんしゃ"],["ガド"],["は"],["ダビデ"],["に"],["言った","いった"],["、"],["「"],["要害","ようがい"],["に"],["とどまって"],["いないで"],["、"],["去て","さって"],["ユダ"],["の"],["地","ち"],["へ"],["行き","いき"],["なさい"],["」"],["。"],["そこ"],["で"],["ダビデ"],["は"],["去て","さって"],["、"],["ハレテ"],["の"],["森","もり"],["へ"],["行った","いった"],["。"]]},{"verse":6,"text":"サウルは、ダビデおよび彼,かれと共,ともにいる人々,ひとびとが見,みつかったということを聞,きいた。サウルはギベアで、やりを手,てにもって、丘,おかのぎょりゅうの木,きの下,したにすわっており、家来,けらいたちはみなそのまわりに立,たっていた。","tok":[["サウル"],["は"],["、"],["ダビデ"],["および"],["彼","かれ"],["と"],["共","とも"],["に"],["いる"],["人々","ひとびと"],["が"],["見つかった","みつかった"],["と"],["いう"],["こと"],["を"],["聞いた","きいた"],["。"],["サウル"],["は"],["ギベア"],["で"],["、"],["やり"],["を"],["手","て"],["に"],["もって"],["、"],["丘","おか"],["のぎ"],["ょ"],["りゅう"],["の"],["木","き"],["の"],["下","した"],["に"],["すわって"],["おり"],["、"],["家来","けらい"],["たち"],["は"],["みな"],["その"],["まわり"],["に"],["立って","たって"],["いた"],["。"]]},{"verse":7,"text":"サウルはまわりに立,たっている家来,けらいたちに言,いった、「あなたがたベニヤミンびとは聞,ききなさい。エッサイの子,こもまた、あなたがたおのおのに畑,はたけやぶどう畑,はたけを与,あたえ、おのおのを千人,にんの長,ちょう、百人,にんの長,ちょうにするであろうか。","tok":[["サウル"],["は"],["まわり"],["に"],["立って","たって"],["いる"],["家来","けらい"],["たち"],["に"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["ベニヤミン"],["び"],["と"],["は"],["聞","きき"],["なさい"],["。"],["エッサイ"],["の"],["子","こ"],["も"],["また"],["、"],["あなた"],["がた"],["おのおの"],["に"],["畑","はたけ"],["や"],["ぶどう"],["畑","はたけ"],["を"],["与","あたえ"],["、"],["おのおの"],["を"],["千人","にん"],["の"],["長う","ちょう"],["、"],["百人","にん"],["の"],["長","ちょう"],["に"],["するで"],["あろう"],["か"],["。"]]},{"verse":8,"text":"あなたがたは皆,みな共,ともにはかってわたしに敵,てきした。わたしの子,こがエッサイの子,こと契約,けいやくを結,むすんでも、それをわたしに告,つげるものはなく、またあなたがたのうち、ひとりもわたしのために憂,うれえず、きょうのように、わたしの子,こがわたしのしもべをそそのかしてわたしに逆,さからわせ、道,みちで彼,かれがわたしを待,まち伏,ぶせするようになっても、わたしに告,つげる者,ものはない」。","tok":[["あなた"],["がた"],["は"],["皆","みな"],["共","とも"],["に"],["はかって"],["わたし"],["に"],["敵した","てきした"],["。"],["わたし"],["の"],["子","こ"],["が"],["エッサイ"],["の"],["子","こ"],["と"],["契約","けいやく"],["を"],["結","むすん"],["で"],["も"],["、"],["それ"],["を"],["わたし"],["に"],["告げる","つげる"],["もの"],["は"],["なく"],["、"],["また"],["あなた"],["がた"],["の"],["うち"],["、"],["ひとり"],["も"],["わたし"],["の"],["ため"],["に"],["憂えず","うれえず"],["、"],["きょう"],["の"],["よう"],["に"],["、"],["わたし"],["の"],["子","こ"],["が"],["わたし"],["の"],["しもべ"],["を"],["そそのかして"],["わたし"],["に"],["逆らわせ","さからわせ"],["、"],["道","みち"],["で"],["彼","かれ"],["が"],["わたし"],["を"],["待ち伏せ","まちぶせ"],["する"],["よう"],["に"],["なって"],["も"],["、"],["わたし"],["に"],["告げる","つげる"],["者","もの"],["は"],["ない"],["」"],["。"]]},{"verse":9,"text":"その時,ときエドムびとドエグは、サウルの家来,けらいたちのそばに立,たっていたが、答,こたえて言,いった、「わたしはエッサイの子,こがノブにいるアヒトブの子,こアヒメレクの所,ところにきたのを見,みました。","tok":[["その"],["時","とき"],["エドム"],["びと"],["ドエグ"],["は"],["、"],["サウル"],["の"],["家来","けらい"],["たち"],["の"],["そば"],["に"],["立って","たって"],["いた"],["が"],["、"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["わたし"],["は"],["エッサイ"],["の"],["子","こ"],["が"],["ノブ"],["に"],["いる"],["アヒトブ"],["の"],["子","こ"],["アヒメレク"],["の"],["所","ところ"],["に"],["きた"],["の"],["を"],["見ました","みました"],["。"]]},{"verse":10,"text":"アヒメレクは彼,かれのために主,しゅに問,とい、また彼,かれに食物,しょくもつを与,あたえ、ペリシテびとゴリアテのつるぎを与,あたえました」。","tok":[["アヒメレク"],["は"],["彼","かれ"],["の"],["ため"],["に"],["主に","しゅに"],["問","とい"],["、"],["また"],["彼","かれ"],["に"],["食物","しょくもつ"],["を"],["与","あたえ"],["、"],["ペリシテ"],["び"],["と"],["ゴリアテ"],["の"],["つるぎ"],["を"],["与","あたえ"],["ました"],["」"],["。"]]},{"verse":11,"text":"そこで王,おうは人,ひとをつかわして、アヒトブの子,こ祭司,さいしアヒメレクとその父,ちちの家,いえのすべての者,もの、すなわちノブの祭司,さいしたちを召,めしたので、みな王,おうの所,ところにきた。","tok":[["そこ"],["で"],["王","おう"],["は"],["人","ひと"],["を"],["つかわして"],["、"],["アヒトブ"],["の"],["子","こ"],["祭司","さいし"],["アヒメレク"],["と"],["その"],["父","ちち"],["の"],["家","いえ"],["の"],["すべて"],["の"],["者","もの"],["、"],["すなわち"],["ノブ"],["の"],["祭司","さいし"],["たち"],["を"],["召","めし"],["た"],["ので"],["、"],["みな"],["王","おう"],["の"],["所","ところ"],["に"],["きた"],["。"]]},{"verse":12,"text":"サウルは言,いった、「アヒトブの子,こよ、聞,ききなさい」。彼,かれは答,こたえた、「わが主,しゅよ、わたしはここにおります」。","tok":[["サウル"],["は"],["言った","いった"],["、"],["「"],["アヒトブ"],["の"],["子","こ"],["よ"],["、"],["聞","きき"],["なさい"],["」"],["。"],["彼","かれ"],["は"],["答","こたえ"],["た"],["、"],["「"],["わが"],["主","しゅ"],["よ"],["、"],["わたし"],["は"],["ここ"],["に"],["おります"],["」"],["。"]]},{"verse":13,"text":"サウルは彼,かれに言,いった、「どうしてあなたはエッサイの子,こと共,ともにはかってわたしに敵,てきし、彼,かれにパンとつるぎを与,あたえ、彼,かれのために神,かみに問,とい、きょうのように彼,かれをわたしに逆,さからって立,たたせ、道,みちで待,まち伏,ぶせさせるのか」。","tok":[["サウル"],["は"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["どう"],["して"],["あなた"],["は"],["エッサイ"],["の"],["子","こ"],["と"],["共","とも"],["に"],["はかって"],["わたし"],["に"],["敵し","てきし"],["、"],["彼","かれ"],["に"],["パン"],["と"],["つるぎ"],["を"],["与","あたえ"],["、"],["彼","かれ"],["の"],["ため"],["に"],["神","かみ"],["に"],["問","とい"],["、"],["きょう"],["の"],["よう"],["に"],["彼","かれ"],["を"],["わたし"],["に"],["逆らって","さからって"],["立たせ","たたせ"],["、"],["道","みち"],["で"],["待伏せ","まちぶせ"],["させる"],["の"],["か"],["」"],["。"]]},{"verse":14,"text":"アヒメレクは王,おうに答,こたえて言,いった、「あなたの家来,けらいのうち、ダビデのように忠義,ちゅうぎな者,ものがほかにありますか。彼,かれは王,おうの娘,むすめ婿,むこであり、近衛,このえ兵,へいの長,ちょうであって、あなたの家,いえで尊,たっとばれる人,ひとではありませんか。","tok":[["アヒメレク"],["は"],["王","おう"],["に"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["あなた"],["の"],["家来","けらい"],["の"],["うち"],["、"],["ダビデ"],["の"],["よう"],["に"],["忠義","ちゅうぎ"],["な"],["者","もの"],["が"],["ほか"],["に"],["あります"],["か"],["。"],["彼","かれ"],["は"],["王","おう"],["の"],["娘婿","むすめむこ"],["で"],["あり"],["、"],["近衛兵","このえへい"],["の"],["長","ちょう"],["で"],["あって"],["、"],["あなた"],["の"],["家","いえ"],["で"],["尊","た"],["っと"],["ばれる"],["人","ひと"],["で"],["は"],["ありません"],["か"],["。"]]},{"verse":15,"text":"彼,かれのために神,かみに問,とうたのは、きょう初,はじめてでしょうか。いいえ、決,けっしてそうではありません。王,おうよ、どうぞ、しもべと父,ちちの全家,ぜんかに罪,つみを負,おわせないでください。しもべは、これについては、事,ことの大小,だいしょうを問,とわず、何,なにをも知,しらなかったのです」。","tok":[["彼","かれ"],["の"],["ため"],["に"],["神","かみ"],["に"],["問うた","とうた"],["の"],["は"],["、"],["きょう"],["初めて","はじめて"],["でしょう"],["か"],["。"],["いいえ"],["、"],["決っして","けっして"],["そう"],["で"],["は"],["ありません"],["。"],["王","おう"],["よ"],["、"],["どうぞ"],["、"],["しもべ"],["と"],["父","ちち"],["の"],["全","ぜん"],["家","いえ"],["に"],["罪","つみ"],["を"],["負わせないで","おわせないで"],["ください"],["。"],["しもべ"],["は"],["、"],["これ"],["について"],["は"],["、"],["事","こと"],["の"],["大小","だいしょう"],["を"],["問わず","とわず"],["、"],["何に","なに"],["を"],["も"],["知らなかった","しらなかった"],["の"],["です"],["」"],["。"]]},{"verse":16,"text":"王,おうは言,いった、「アヒメレクよ、あなたは必,かならず殺,ころされなければならない。あなたの父,ちちの全家,ぜんかも同,おなじである」。","tok":[["王","おう"],["は"],["言った","いった"],["、"],["「"],["アヒメレク"],["よ"],["、"],["あなた"],["は"],["必","かならず"],["殺ろされなければ","ころされなければ"],["ならない"],["。"],["あなた"],["の"],["父","ちち"],["の"],["全","ぜん"],["家","いえ"],["も"],["同じ","おなじ"],["で"],["ある"],["」"],["。"]]},{"verse":17,"text":"そして王,おうはまわりに立,たっている近衛,このえの兵,へいに言,いった、「身,みをひるがえして、主,しゅの祭司,さいしたちを殺,ころしなさい。彼,かれらもダビデと協力,きょうりょくしていて、ダビデの逃,にげたのを知,しりながら、それをわたしに告,つげなかったからです」。ところが王,おうの家来,けらいたちは主,しゅの祭司,さいしたちを殺,ころすために手,てを下,くだそうとはしなかった。","tok":[["そして"],["王","おう"],["は"],["まわり"],["に"],["立って","たって"],["いる"],["近衛","このえ"],["の"],["兵","へい"],["に"],["言った","いった"],["、"],["「"],["身","み"],["を"],["ひるがえして"],["、"],["主","しゅ"],["の"],["祭司","さいし"],["たち"],["を"],["殺ろし","ころし"],["なさい"],["。"],["彼","かれ"],["ら"],["も"],["ダビデ"],["と"],["協力","きょうりょく"],["して"],["いて"],["、"],["ダビデ"],["の"],["逃た","にげた"],["の"],["を"],["知り","しり"],["ながら"],["、"],["それ"],["を"],["わたし"],["に"],["告","つげ"],["なかった"],["から"],["です"],["」"],["。"],["ところ"],["が"],["王","おう"],["の"],["家来","けらい"],["たち"],["は"],["主","しゅ"],["の"],["祭司","さいし"],["たち"],["を"],["殺ろす","ころす"],["ため"],["に"],["手","て"],["を"],["下そう","くだそう"],["と"],["は"],["しなかった"],["。"]]},{"verse":18,"text":"そこで王,おうはドエグに言,いった、「あなたが身,みをひるがえして、祭司,さいしたちを殺,ころしなさい」。エドムびとドエグは身,みをひるがえして祭司,さいしたちを撃,うち、その日,ひ亜麻,あま布,ぬののエポデを身,みにつけている者,もの八十五人,にんを殺,ころした。","tok":[["そこ"],["で"],["王","おう"],["は"],["ドエグ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["が"],["身","み"],["を"],["ひるがえして"],["、"],["祭司","さいし"],["たち"],["を"],["殺ろし","ころし"],["なさい"],["」"],["。"],["エドム"],["びと"],["ドエグ"],["は"],["身","み"],["を"],["ひるがえして"],["祭司","さいし"],["たち"],["を"],["撃ち","うち"],["、"],["その"],["日亜","ひ亜"],["麻布","麻ぬの"],["の"],["エポデ"],["を"],["身","み"],["に"],["つけて"],["いる"],["者","もの"],["八十五人","にん"],["を"],["殺ろした","ころした"],["。"]]},{"verse":19,"text":"彼,かれはまた、つるぎをもって祭司,さいしの町,まちノブを撃,うち、つるぎをもって男,おとこ、女,おんな、幼,おさな子,こ、乳飲,ちのみ子,ご、牛,うし、ろば、羊,ひつじを殺,ころした。","tok":[["彼","かれ"],["は"],["また"],["、"],["つるぎ"],["を"],["もって"],["祭司","さいし"],["の"],["町","まち"],["ノブ"],["を"],["撃ち","うち"],["、"],["つるぎ"],["を"],["もって"],["男","おとこ"],["、"],["女","おんな"],["、"],["幼な子","おさなこ"],["、"],["乳飲み子","ちのみご"],["、"],["牛","うし"],["、"],["ろば"],["、"],["羊","ひつじ"],["を"],["殺ろした","ころした"],["。"]]},{"verse":20,"text":"しかしアヒトブの子,こアヒメレクの子,こたちのひとりで、名,なをアビヤタルという人,ひとは、のがれてダビデの所,ところに走,はしった。","tok":[["しかし"],["アヒトブ"],["の"],["子","こ"],["アヒメレク"],["の"],["子","こ"],["たち"],["の"],["ひとり"],["で"],["、"],["名","な"],["を"],["アビヤタル"],["と"],["いう"],["人","ひと"],["は"],["、"],["のがれて"],["ダビデ"],["の"],["所","ところ"],["に"],["走った","はしった"],["。"]]},{"verse":21,"text":"そしてアビヤタルは、サウルが主,しゅの祭司,さいしたちを殺,ころしたことをダビデに告,つげたので、","tok":[["そして"],["アビヤタル"],["は"],["、"],["サウル"],["が"],["主","しゅ"],["の"],["祭司","さいし"],["たち"],["を"],["殺ろした","ころした"],["こと"],["を"],["ダビデ"],["に"],["告","つげ"],["た"],["ので"],["、"]]},{"verse":22,"text":"ダビデはアビヤタルに言,いった、「あの日,ひ、エドムびとドエグがあそこにいたので、わたしは彼,かれがきっとサウルに告,つげるであろうと思,おもった。わたしがあなたの父,ちちの家,いえの人々,ひとびとの命,いのちを失,うしなわせるもととなったのです。","tok":[["ダビデ"],["は"],["アビヤタル"],["に"],["言った","いった"],["、"],["「"],["あの"],["日","ひ"],["、"],["エドム"],["びと"],["ドエグ"],["が"],["あそこ"],["に"],["いた"],["ので"],["、"],["わたし"],["は"],["彼","かれ"],["が"],["きっと"],["サウル"],["に"],["告げるで","つげるで"],["あろう"],["と"],["思った","おもった"],["。"],["わたし"],["が"],["あなた"],["の"],["父","ちち"],["の"],["家","いえ"],["の"],["人々","ひとびと"],["の"],["命","いのち"],["を"],["失なわせる","うしなわせる"],["もと"],["と"],["なった"],["の"],["です"],["。"]]},{"verse":23,"text":"あなたはわたしの所,ところにとどまってください。恐,おそれることはありません。あなたの命,いのちを求,もとめる者,ものは、わたしの命,いのちをも求,もとめているのです。わたしの所,ところにおられるならば、あなたは安全,あんぜんでしょう」。","tok":[["あなた"],["は"],["わたし"],["の"],["所","ところ"],["に"],["とどまって"],["ください"],["。"],["恐れる","おそれる"],["こと"],["は"],["ありません"],["。"],["あなた"],["の"],["命","いのち"],["を"],["求める","もとめる"],["者","もの"],["は"],["、"],["わたし"],["の"],["命","いのち"],["を"],["も"],["求めて","もとめて"],["いる"],["の"],["です"],["。"],["わたし"],["の"],["所","ところ"],["に"],["おられるならば"],["、"],["あなた"],["は"],["安全","あんぜん"],["でしょう"],["」"],["。"]]}]
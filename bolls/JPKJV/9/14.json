[{"verse":1,"text":"ある日,ひ、サウルの子,こヨナタンは、その武器,ぶきを執,とる若者,わかものに「さあ、われわれは向,むこう側,がわの、ペリシテびとの先陣,せんじんへ渡,わたって行,いこう」と言,いった。しかしヨナタンは父,ちちには告,つげなかった。","tok":[["ある"],["日","ひ"],["、"],["サウル"],["の"],["子","こ"],["ヨナタン"],["は"],["、"],["その"],["武器","ぶき"],["を"],["執る","とる"],["若者","わかもの"],["に"],["「"],["さあ"],["、"],["われわれ"],["は"],["向こう側","むこうがわ"],["の"],["、"],["ペリシテ"],["びと"],["の"],["先陣","せんじん"],["へ"],["渡って","わたって"],["行こう","いこう"],["」"],["と"],["言った","いった"],["。"],["しかし"],["ヨナタン"],["は"],["父","ちち"],["に"],["は"],["告","つげ"],["なかった"],["。"]]},{"verse":2,"text":"サウルはギベアのはずれで、ミグロンにある、ざくろの木,きの下,したにとどまっていたが、共,ともにいた民,たみはおおよそ六百人,にんであった。","tok":[["サウル"],["は"],["ギベア"],["の"],["はずれ"],["で"],["、"],["ミグロン"],["に"],["ある"],["、"],["ざくろ"],["の"],["木","き"],["の"],["下","した"],["に"],["とどまって"],["いた"],["が"],["、"],["共","とも"],["に"],["いた"],["民","たみ"],["は"],["おおよそ"],["六百人","にん"],["で"],["あった"],["。"]]},{"verse":3,"text":"またアヒヤはエポデを身,みに着,つけて共,ともにいた。アヒヤはアヒトブの子,こ、アヒトブはイカボデの兄弟,きょうだい、イカボデはピネハスの子,こ、ピネハスはシロにおいて主,しゅの祭司,さいしであったエリの子,こである。民,たみはヨナタンが出,でかけることを知,しらなかった。","tok":[["また"],["アヒヤ"],["は"],["エポデ"],["を"],["身","み"],["に"],["着けて","つけて"],["共","とも"],["に"],["いた"],["。"],["アヒヤ"],["は"],["アヒトブ"],["の"],["子","こ"],["、"],["アヒトブ"],["は"],["イカボデ"],["の"],["兄弟","きょうだい"],["、"],["イカボデ"],["は"],["ピネハス"],["の"],["子","こ"],["、"],["ピネハス"],["は"],["シロ"],["に"],["おいて"],["主","しゅ"],["の"],["祭司","さいし"],["で"],["あった"],["エリ"],["の"],["子","こ"],["で"],["ある"],["。"],["民","たみ"],["は"],["ヨナタン"],["が"],["出かける","でかける"],["こと"],["を"],["知らなかった","しらなかった"],["。"]]},{"verse":4,"text":"ヨナタンがペリシテびとの先陣,せんじんに渡,わたって行,いこうとする渡,わたりには、一方,いっぽうに険,けわしい岩,いわがあり、他方,たほうにも険,けわしい岩,いわがあり、一方,いっぽうの名,なをボゼヅといい、他方,たほうの名,なをセネといった。","tok":[["ヨナタン"],["が"],["ペリシテ"],["びと"],["の"],["先陣","せんじん"],["に"],["渡って","わたって"],["行こう","いこう"],["と"],["する"],["渡り","わたり"],["に"],["は"],["、"],["一方","いっぽう"],["に"],["険しい","けわしい"],["岩","いわ"],["が"],["あり"],["、"],["他方","たほう"],["に"],["も"],["険しい","けわしい"],["岩","いわ"],["が"],["あり"],["、"],["一方","いっぽう"],["の"],["名","な"],["を"],["ボゼヅ"],["と"],["いい"],["、"],["他方","たほう"],["の"],["名","な"],["を"],["セネ"],["と"],["いった"],["。"]]},{"verse":5,"text":"岩,いわの一つはミクマシの前,まえにあって北,きたにあり、一つはゲバの前,まえにあって南,みなみにあった。","tok":[["岩","いわ"],["の"],["一","ひと"],["つ"],["は"],["ミクマシ"],["の"],["前","まえ"],["に"],["あって"],["北","きた"],["に"],["あり"],["、"],["一","ひと"],["つ"],["は"],["ゲバ"],["の"],["前","まえ"],["に"],["あって"],["南","みなみ"],["に"],["あった"],["。"]]},{"verse":6,"text":"ヨナタンはその武器,ぶきを執,とる若者,わかものに言,いった、「さあ、われわれは、この割礼,かつれいなき者,ものどもの先陣,せんじんへ渡,わたって行,いこう。主,しゅがわれわれのために何,なにか行,おこなわれるであろう。多,おおくの人,ひとをもって救,すくうのも、少,すくない人,ひとをもって救,すくうのも、主,しゅにとっては、なんの妨,さまたげもないからである」。","tok":[["ヨナタン"],["は"],["その"],["武器","ぶき"],["を"],["執る","とる"],["若者","わかもの"],["に"],["言った","いった"],["、"],["「"],["さあ"],["、"],["われわれ"],["は"],["、"],["この"],["割礼","かつれい"],["なき"],["者","もの"],["ども"],["の"],["先陣","せんじん"],["へ"],["渡って","わたって"],["行こう","いこう"],["。"],["主","しゅ"],["が"],["われわれ"],["の"],["ため"],["に"],["何に","なに"],["か"],["行なわれるで","おこなわれるで"],["あろう"],["。"],["多く","おおく"],["の"],["人","ひと"],["を"],["もって"],["救う","すくう"],["の"],["も"],["、"],["少い","すくない"],["人","ひと"],["を"],["もって"],["救う","すくう"],["の"],["も"],["、"],["主に","しゅに"],["とって"],["は"],["、"],["なん"],["の"],["妨げ","さまたげ"],["も"],["ない"],["から"],["で"],["ある"],["」"],["。"]]},{"verse":7,"text":"武器,ぶきを執,とる者,ものは彼,かれに言,いった、「あなたの望,のぞみどおりにしなさい。わたしは一緒,いっしょにいます。わたしはあなたと同,おなじ心,こころです」。","tok":[["武器","ぶき"],["を"],["執る","とる"],["者","もの"],["は"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["の"],["望み","のぞみ"],["どおり"],["に"],["し"],["なさい"],["。"],["わたし"],["は"],["一緒","いっしょ"],["に"],["います"],["。"],["わたし"],["は"],["あなた"],["と"],["同じ","おなじ"],["心","こころ"],["です"],["」"],["。"]]},{"verse":8,"text":"ヨナタンはまた言,いった、「われわれは、あの人々,ひとびとの所,ところに渡,わたっていって、彼,かれらに身,みを現,あらわそう。","tok":[["ヨナタン"],["は"],["また"],["言った","いった"],["、"],["「"],["われわれ"],["は"],["、"],["あの"],["人々","ひとびと"],["の"],["所","ところ"],["に"],["渡って","わたって"],["いって"],["、"],["彼","かれ"],["ら"],["に"],["身","み"],["を"],["現わそう","あらわそう"],["。"]]},{"verse":9,"text":"そして、もし彼,かれらがわれわれに、『こちらから行,いくまで待,まて』と言,いうならば、われわれはその場,ばにとどまり、彼,かれらの所,ところに上,のぼっていかないであろう。","tok":[["そして"],["、"],["もし"],["彼","かれ"],["ら"],["が"],["われわれ"],["に"],["、"],["『"],["こちら"],["から"],["行く","いく"],["まで"],["待て","まて"],["』"],["と"],["言うならば","いうならば"],["、"],["われわれ"],["は"],["その"],["場","ば"],["に"],["とどまり"],["、"],["彼","かれ"],["ら"],["の"],["所","ところ"],["に"],["上って","のぼって"],["いかないで"],["あろう"],["。"]]},{"verse":10,"text":"しかし、もし彼,かれらが『われわれのところへ上,のぼってこい』と言,いうならば、われわれは上,のぼって行,いこう。主,しゅが彼,かれらをわれわれの手,てに渡,わたされるからである。これをもってしるしとしよう」。","tok":[["しかし"],["、"],["もし"],["彼","かれ"],["ら"],["が"],["『"],["われわれ"],["の"],["ところ"],["へ"],["上って","のぼって"],["こい"],["』"],["と"],["言うならば","いうならば"],["、"],["われわれ"],["は"],["上って","のぼって"],["行こう","いこう"],["。"],["主","しゅ"],["が"],["彼","かれ"],["ら"],["を"],["われわれ"],["の"],["手","て"],["に"],["渡される","わたされる"],["から"],["で"],["ある"],["。"],["これ"],["を"],["もって"],["しるし"],["と"],["しよう"],["」"],["。"]]},{"verse":11,"text":"こうしてふたりはペリシテびとの先陣,せんじんに、その身,みを現,あらわしたので、ペリシテびとは言,いった、「見,みよ、ヘブルびとが、隠,かくれていた穴,あなから出,でてくる」。","tok":[["こう"],["して"],["ふたり"],["は"],["ペリシテ"],["びと"],["の"],["先陣","せんじん"],["に"],["、"],["その"],["身","み"],["を"],["現わした","あらわした"],["ので"],["、"],["ペリシテ"],["び"],["と"],["は"],["言った","いった"],["、"],["「"],["見よ","みよ"],["、"],["ヘブル"],["びと"],["が"],["、"],["隠れて","かくれて"],["いた"],["穴","あな"],["から"],["出て","でて"],["くる"],["」"],["。"]]},{"verse":12,"text":"先陣,せんじんの人々,ひとびとはヨナタンと、その武器,ぶきを執,とる者,ものに叫,さけんで言,いった、「われわれのところに上,のぼってこい。目,めに、もの見,みせてくれよう」。ヨナタンは、その武器,ぶきを執,とる者,ものに言,いった、「わたしのあとについて上,のぼってきなさい。主,しゅは彼,かれらをイスラエルの手,てに渡,わたされたのだ」。","tok":[["先陣","せんじん"],["の"],["人々","ひとびと"],["は"],["ヨナタン"],["と"],["、"],["その"],["武器","ぶき"],["を"],["執る","とる"],["者","もの"],["に"],["叫けんで","さけんで"],["言った","いった"],["、"],["「"],["われわれ"],["の"],["ところ"],["に"],["上って","のぼって"],["こい"],["。"],["目","め"],["に"],["、"],["もの"],["見せて","みせて"],["くれよう"],["」"],["。"],["ヨナタン"],["は"],["、"],["その"],["武器","ぶき"],["を"],["執る","とる"],["者","もの"],["に"],["言った","いった"],["、"],["「"],["わたし"],["の"],["あと"],["について"],["上って","のぼって"],["き"],["なさい"],["。"],["主","しゅ"],["は"],["彼","かれ"],["ら"],["を"],["イスラエル"],["の"],["手","て"],["に"],["渡された","わたされた"],["の"],["だ"],["」"],["。"]]},{"verse":13,"text":"そしてヨナタンはよじ登,のぼり、武器,ぶきを執,とる者,ものもそのあとについて登,のぼった。ペリシテびとはヨナタンの前,まえに倒,たおれた。武器,ぶきを執,とる者,ものも、あとについていってペリシテびとを殺,ころした。","tok":[["そして"],["ヨナタン"],["は"],["よじ登り","よじのぼり"],["、"],["武器","ぶき"],["を"],["執る","とる"],["者","もの"],["も"],["その"],["あと"],["について"],["登った","のぼった"],["。"],["ペリシテ"],["び"],["と"],["は"],["ヨナタン"],["の"],["前","まえ"],["に"],["倒れた","たおれた"],["。"],["武器","ぶき"],["を"],["執る","とる"],["者","もの"],["も"],["、"],["あと"],["について"],["いって"],["ペリシテ"],["びと"],["を"],["殺ろした","ころした"],["。"]]},{"verse":14,"text":"ヨナタンとその武器,ぶきを執,とる者,ものとが、手始,てはじめに殺,ころしたものは、おおよそ二十人,にんであって、このことは一くびきの牛,うしの耕,たがやす畑,はたけのおおよそ半分,はんぶんの内,うちで行,おこなわれた。","tok":[["ヨナタン"],["と"],["その"],["武器","ぶき"],["を"],["執る","とる"],["者","もの"],["と"],["が"],["、"],["手","て"],["始","はじめ"],["に"],["殺ろした","ころした"],["もの"],["は"],["、"],["おおよそ"],["二","に"],["十人","じゅうにん"],["で"],["あって"],["、"],["この"],["こと"],["は"],["一","いち"],["く"],["びき"],["の"],["牛","うし"],["の"],["耕やす","たがやす"],["畑","はたけ"],["の"],["おおよそ"],["半分","はんぶん"],["の"],["内","うち"],["で"],["行なわれた","おこなわれた"],["。"]]},{"verse":15,"text":"そして陣営,じんえいにいる者,もの、野,のにいるもの、およびすべての民,たみは恐怖,きょうふに襲,おそわれ、先陣,せんじんのもの、および略奪,りゃくだつ隊,たいまでも、恐,おそれおののいた。また地,ちは震,ふるい動,うごき、非常,ひじょうに大,おおきな恐怖,きょうふとなった。","tok":[["そして"],["陣営","じんえい"],["に"],["いる"],["者","もの"],["、"],["野","の"],["に"],["いる"],["もの"],["、"],["および"],["すべて"],["の"],["民","たみ"],["は"],["恐怖","きょうふ"],["に"],["襲れ","おそわれ"],["、"],["先陣","せんじん"],["の"],["もの"],["、"],["および"],["略奪隊","りゃくだつたい"],["まで"],["も"],["、"],["恐れおののいた","おそれおののいた"],["。"],["また"],["地","ち"],["は"],["震い","ふるい"],["動き","うごき"],["、"],["非常","ひじょう"],["に"],["大きな","おおきな"],["恐怖","きょうふ"],["と"],["なった"],["。"]]},{"verse":16,"text":"ベニヤミンのギベアにいたサウルの番兵,ばんぺいたちが見,みると、ペリシテびとの群衆,ぐんしゅうはくずれて右往左往,うおうさおうしていた。","tok":[["ベニヤミン"],["の"],["ギベア"],["に"],["いた"],["サウル"],["の"],["番兵","ばんぺい"],["たち"],["が"],["見る","みる"],["と"],["、"],["ペリシテ"],["びと"],["の"],["群衆","ぐんしゅう"],["は"],["くずれて"],["右往","うおう"],["左往","さおう"],["して"],["いた"],["。"]]},{"verse":17,"text":"その時,ときサウルは、共,ともにいる民,たみに言,いった、「人数,にんずうを調,しらべて、われわれのうちのだれが出,でて行,いったかを見,みよ」。人数,にんずうを調,しらべたところ、ヨナタンとその武器,ぶきを執,とる者,ものとがそこにいなかった。","tok":[["その"],["時","とき"],["サウル"],["は"],["、"],["共","とも"],["に"],["いる"],["民","たみ"],["に"],["言った","いった"],["、"],["「"],["人数","にんずう"],["を"],["調べて","しらべて"],["、"],["われわれ"],["の"],["うち"],["の"],["だれ"],["が"],["出て","でて"],["行った","いった"],["か"],["を"],["見よ","みよ"],["」"],["。"],["人数","にんずう"],["を"],["調べた","しらべた"],["ところ"],["、"],["ヨナタン"],["と"],["その"],["武器","ぶき"],["を"],["執る","とる"],["者","もの"],["と"],["が"],["そこ"],["に"],["いなかった"],["。"]]},{"verse":18,"text":"サウルはアヒヤに言,いった、「エポデをここに持,もってきなさい」。その時,とき、アヒヤはイスラエルの人々,ひとびとの前,まえでエポデを身,みに着,つけていたからである。","tok":[["サウル"],["は"],["アヒヤ"],["に"],["言った","いった"],["、"],["「"],["エポデ"],["を"],["ここ"],["に"],["持って","もって"],["き"],["なさい"],["」"],["。"],["その"],["時","とき"],["、"],["アヒヤ"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["前","まえ"],["で"],["エポデ"],["を"],["身","み"],["に"],["着けて","つけて"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":19,"text":"サウルが祭司,さいしに語,かたっている間,あいだにも、ペリシテびとの陣営,じんえいの騒,さわぎはますます大,おおきくなったので、サウルは祭司,さいしに言,いった、「手,てを引,ひきなさい」。","tok":[["サウル"],["が"],["祭司","さいし"],["に"],["語って","かたって"],["いる"],["間","あいだ"],["に"],["も"],["、"],["ペリシテ"],["びと"],["の"],["陣営","じんえい"],["の"],["騒","さわぎ"],["は"],["ますます"],["大きく","おおきく"],["なった"],["ので"],["、"],["サウル"],["は"],["祭司","さいし"],["に"],["言った","いった"],["、"],["「"],["手","て"],["を"],["引","ひき"],["なさい"],["」"],["。"]]},{"verse":20,"text":"こうしてサウルおよび共,ともにいる民,たみは皆,みな、集,あつまって戦,たたかいに出,でた。ペリシテびとはつるぎをもって同志,どうし打,うちしたので、非常,ひじょうに大,おおきな混乱,こんらんとなった。","tok":[["こう"],["して"],["サウル"],["および"],["共","とも"],["に"],["いる"],["民","たみ"],["は"],["皆","みな"],["、"],["集まって","あつまって"],["戦い","たたかい"],["に"],["出た","でた"],["。"],["ペリシテ"],["び"],["と"],["は"],["つるぎ"],["を"],["もって"],["同志","どうし"],["打ち","うち"],["した"],["ので"],["、"],["非常","ひじょう"],["に"],["大きな","おおきな"],["混乱","こんらん"],["と"],["なった"],["。"]]},{"verse":21,"text":"また先,さきにペリシテびとと共,ともにいて、彼,かれらと共,ともに陣営,じんえいにきていたヘブルびとたちも、翻,ひるがえってサウルおよびヨナタンと共,ともにいるイスラエルびとにつくようになった。","tok":[["また"],["先","さき"],["に"],["ペリシテ"],["びと"],["と"],["共","とも"],["に"],["いて"],["、"],["彼","かれ"],["ら"],["と"],["共","とも"],["に"],["陣営","じんえい"],["に"],["きて"],["いた"],["ヘブル"],["びと"],["たち"],["も"],["、"],["翻って","ひるがえって"],["サウル"],["および"],["ヨナタン"],["と"],["共","とも"],["に"],["いる"],["イスラエル"],["びと"],["に"],["つく"],["よう"],["に"],["なった"],["。"]]},{"verse":22,"text":"またエフライムの山地,さんちに身,みを隠,かくしていたイスラエルびとたちも皆,みな、ペリシテびとが逃,にげると聞,きいて、彼,かれらもまた戦,たたかいに出,でて、それを追撃,ついげきした。","tok":[["また"],["エフライム"],["の"],["山地","さんち"],["に"],["身","み"],["を"],["隠して","かくして"],["いた"],["イスラエル"],["びと"],["たち"],["も"],["皆","みな"],["、"],["ペリシテ"],["びと"],["が"],["逃る","にげる"],["と"],["聞いて","きいて"],["、"],["彼","かれ"],["ら"],["も"],["また"],["戦い","たたかい"],["に"],["出て","でて"],["、"],["それ"],["を"],["追撃","ついげき"],["した"],["。"]]},{"verse":23,"text":"こうして主,しゅはその日,ひイスラエルを救,すくわれた。そして戦,たたかいはベテアベンに移,うつった。","tok":[["こう"],["して"],["主","しゅ"],["は"],["その"],["日","ひ"],["イスラエル"],["を"],["救われた","すくわれた"],["。"],["そして"],["戦い","たたかい"],["は"],["ベテアベン"],["に"],["移った","うつった"],["。"]]},{"verse":24,"text":"しかしその日,ひイスラエルの人々,ひとびとは苦,くるしんだ。これはサウルが民,たみに誓,ちかわせて「夕方,ゆうがたまで、わたしが敵,てきにあだを返,かえすまで、食物,しょくもつを食,たべる者,ものは、のろわれる」と言,いったからである。それゆえ民,たみのうちには、ひとりも食物,しょくもつを口,くちにしたものはなかった。","tok":[["しかし"],["その"],["日","ひ"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["苦しんだ","くるしんだ"],["。"],["これ"],["は"],["サウル"],["が"],["民","たみ"],["に"],["誓わせて","ちかわせて"],["「"],["夕方","ゆうがた"],["まで"],["、"],["わたし"],["が"],["敵","てき"],["に"],["あだ"],["を"],["返えす","かえす"],["まで"],["、"],["食物","しょくもつ"],["を"],["食べる","たべる"],["者","もの"],["は"],["、"],["のろわれる"],["」"],["と"],["言った","いった"],["から"],["で"],["ある"],["。"],["それ"],["ゆえ民","ゆえたみ"],["の"],["うち"],["に"],["は"],["、"],["ひとり"],["も"],["食物","しょくもつ"],["を"],["口","くち"],["に"],["した"],["もの"],["は"],["なかった"],["。"]]},{"verse":25,"text":"ところで、民,たみがみな森,もりの中,なかにはいると、地,ちのおもてに蜜,みつがあった。","tok":[["ところ"],["で"],["、"],["民","た"],["み"],["が"],["みな"],["森","もり"],["の"],["中","なか"],["に"],["はいる"],["と"],["、"],["地","ち"],["の"],["おもて"],["に"],["蜜","みつ"],["が"],["あった"],["。"]]},{"verse":26,"text":"民,たみは森,もりにはいった時,とき、蜜,みつのしたたっているのを見,みた。しかしだれもそれを手,てに取,とって口,くちにつけるものがなかった。民,たみが誓,ちかいを恐,おそれたからである。","tok":[["民","たみ"],["は"],["森","もり"],["に"],["はいった"],["時","とき"],["、"],["蜜","みつ"],["の"],["したたって"],["いる"],["の"],["を"],["見た","みた"],["。"],["しかし"],["だれ"],["も"],["それ"],["を"],["手","て"],["に"],["取って","とって"],["口","くち"],["に"],["つける"],["もの"],["が"],["なかった"],["。"],["民","た"],["み"],["が"],["誓い","ちかい"],["を"],["恐","おそれ"],["たから"],["で"],["ある"],["。"]]},{"verse":27,"text":"しかしヨナタンは、父,ちちが民,たみに誓,ちかわせたことを聞,きかなかったので、手,てを伸,のべてつえの先,さきを蜜,みつばちの巣,すに浸,ひたし、手,てに取,とって口,くちにつけた。すると彼,かれは目,めがはっきりした。","tok":[["しかし"],["ヨナタン"],["は"],["、"],["父","ちち"],["が"],["民","たみ"],["に"],["誓わせた","ちかわせた"],["こと"],["を"],["聞かなかった","きかなかった"],["ので"],["、"],["手","て"],["を"],["伸べて","のべて"],["つえ"],["の"],["先","さき"],["を"],["蜜","みつ"],["ばち"],["の"],["巣","す"],["に"],["浸し","ひたし"],["、"],["手","て"],["に"],["取って","とって"],["口","くち"],["に"],["つけた"],["。"],["する"],["と"],["彼","かれ"],["は"],["目","め"],["が"],["はっきり"],["した"],["。"]]},{"verse":28,"text":"その時,とき、民,たみのひとりが言,いった、「あなたの父,ちちは、かたく民,たみに誓,ちかわせて『きょう、食物,しょくもつを食,たべる者,ものは、のろわれる』と言,いわれました。それで民,たみは疲,つかれているのです」。","tok":[["その"],["時","とき"],["、"],["民","たみ"],["の"],["ひとり"],["が"],["言った","いった"],["、"],["「"],["あなた"],["の"],["父","ちち"],["は"],["、"],["かたく"],["民","たみ"],["に"],["誓わせて","ちかわせて"],["『"],["きょう"],["、"],["食物","しょくもつ"],["を"],["食べる","たべる"],["者","もの"],["は"],["、"],["のろわれる"],["』"],["と"],["言われました","いわれました"],["。"],["それ"],["で"],["民","たみ"],["は"],["疲れて","つかれて"],["いる"],["の"],["です"],["」"],["。"]]},{"verse":29,"text":"ヨナタンは言,いった、「父,ちちは国,くにを悩,なやませました。ごらんなさい。この蜜,みつをすこしなめたばかりで、わたしの目,めがこんなに、はっきりしたではありませんか。","tok":[["ヨナタン"],["は"],["言った","いった"],["、"],["「"],["父","ちち"],["は"],["国","くに"],["を"],["悩せました","なやませました"],["。"],["ごらん"],["なさい"],["。"],["この"],["蜜","みつ"],["を"],["すこし"],["なめた"],["ばかり"],["で"],["、"],["わたし"],["の"],["目","め"],["が"],["こんな"],["に"],["、"],["はっきり"],["した"],["で"],["は"],["ありません"],["か"],["。"]]},{"verse":30,"text":"まして、民,たみがきょう敵,てきからぶんどった物,ものを、じゅうぶん食,たべていたならば、さらに多,おおくのペリシテびとを殺,ころしていたでしょうに」。","tok":[["まして"],["、"],["民","た"],["み"],["が"],["きょう"],["敵","てき"],["から"],["ぶんどった"],["物","もの"],["を"],["、"],["じゅうぶん"],["食べて","たべて"],["いたならば"],["、"],["さらに"],["多く","おおく"],["の"],["ペリシテ"],["びと"],["を"],["殺ろして","ころして"],["いたでしょう"],["に"],["」"],["。"]]},{"verse":31,"text":"その日,ひイスラエルびとは、ペリシテびとを撃,うって、ミクマシからアヤロンに及,およんだ。そして民,たみは、ひじょうに疲,つかれたので、","tok":[["その"],["日","ひ"],["イスラエル"],["び"],["と"],["は"],["、"],["ペリシテ"],["びと"],["を"],["撃って","うって"],["、"],["ミクマシ"],["から"],["アヤロン"],["に"],["及んだ","およんだ"],["。"],["そして"],["民","たみ"],["は"],["、"],["ひじょう"],["に"],["疲れた","つかれた"],["ので"],["、"]]},{"verse":32,"text":"ぶんどり物,ものに、はせかかって、羊,ひつじ、牛,うし、子,こ牛,うしを取,とって、それを地,ちの上,うえに殺,ころし、血,ちのままでそれを食,たべた。","tok":[["ぶんどり"],["物","もの"],["に"],["、"],["はせ"],["かかって"],["、"],["羊","ひつじ"],["、"],["牛","うし"],["、"],["子牛","こうし"],["を"],["取って","とって"],["、"],["それ"],["を"],["地","ち"],["の"],["上","うえ"],["に"],["殺ろし","ころし"],["、"],["血","ち"],["の"],["まま"],["で"],["それ"],["を"],["食べた","たべた"],["。"]]},{"verse":33,"text":"人々,ひとびとはサウルに言,いった、「民,たみは血,ちのままで食,たべて、主,しゅに罪,つみを犯,おかしています」。サウルは言,いった、「あなたがたはそむいている。この所,ところへ、わたしのもとに大,おおきな石,いしをころがしてきなさい」。","tok":[["人々","ひとびと"],["は"],["サウル"],["に"],["言った","いった"],["、"],["「"],["民","たみ"],["は"],["血","ち"],["の"],["まま"],["で"],["食べて","たべて"],["、"],["主に","しゅに"],["罪","つみ"],["を"],["犯して","おかして"],["います"],["」"],["。"],["サウル"],["は"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["そむいて"],["いる"],["。"],["この"],["所","ところ"],["へ"],["、"],["わたし"],["の"],["もと"],["に"],["大きな","おおきな"],["石","いし"],["を"],["ころがして"],["き"],["なさい"],["」"],["。"]]},{"verse":34,"text":"サウルはまた言,いった、「あなたがたは分,わかれて、民,たみの中,なかにはいって、彼,かれらに言,いいなさい、『おのおの牛,うしまたは、羊,ひつじを引,ひいてきてここでほふって食,たべなさい。血,ちのままで食,たべて、主,しゅに罪,つみを犯,おかしてはならない』」。そこで民,たみは皆,みな、その夜,よる、おのおの牛,うしを引,ひいてきて、それを、その所,ところでほふった。","tok":[["サウル"],["は"],["また"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["分かれて","わかれて"],["、"],["民","たみ"],["の"],["中","なか"],["に"],["はいって"],["、"],["彼","かれ"],["ら"],["に"],["言い","いい"],["なさい"],["、"],["『"],["おのおの"],["牛","うし"],["また"],["は"],["、"],["羊","ひつじ"],["を"],["引いて","ひいて"],["きて"],["ここ"],["で"],["ほふって"],["食べ","たべ"],["なさい"],["。"],["血","ち"],["の"],["まま"],["で"],["食べて","たべて"],["、"],["主に","しゅに"],["罪","つみ"],["を"],["犯して","おかして"],["は"],["ならない"],["』"],["」"],["。"],["そこ"],["で"],["民","たみ"],["は"],["皆","みな"],["、"],["その"],["夜","よる"],["、"],["おのおの"],["牛","うし"],["を"],["引いて","ひいて"],["きて"],["、"],["それ"],["を"],["、"],["その"],["所","ところ"],["で"],["ほふった"],["。"]]},{"verse":35,"text":"こうしてサウルは主,しゅに一つの祭壇,さいだんを築,きずいた。これはサウルが主,しゅのために築,きずいた最初,さいしょの祭壇,さいだんである。","tok":[["こう"],["して"],["サウル"],["は"],["主に","しゅに"],["一","ひと"],["つ"],["の"],["祭壇","さいだん"],["を"],["築いた","きずいた"],["。"],["これ"],["は"],["サウル"],["が"],["主","しゅ"],["の"],["ため"],["に"],["築いた","きずいた"],["最初","さいしょ"],["の"],["祭壇","さいだん"],["で"],["ある"],["。"]]},{"verse":36,"text":"サウルは言,いった、「われわれは夜,よるのうちにペリシテびとを追,おって下,くだり、夜明,よあけまで彼,かれらをかすめて、ひとりも残,のこらぬようにしよう」。人々,ひとびとは言,いった、「良,よいと思,おもわれることを、なんでもしてください」。しかし祭司,さいしは言,いった、「われわれは、ここで、神,かみに尋,たずねましょう」。","tok":[["サウル"],["は"],["言った","いった"],["、"],["「"],["われわれ"],["は"],["夜","よる"],["の"],["うち"],["に"],["ペリシテ"],["びと"],["を"],["追って","おって"],["下り","くだり"],["、"],["夜明","よあけ"],["まで"],["彼","かれ"],["ら"],["を"],["かすめて"],["、"],["ひとり"],["も"],["残らぬ","のこらぬ"],["よう"],["に"],["しよう"],["」"],["。"],["人々","ひとびと"],["は"],["言った","いった"],["、"],["「"],["良い","よい"],["と"],["思われる","おもわれる"],["こと"],["を"],["、"],["なん"],["で"],["も"],["して"],["ください"],["」"],["。"],["しかし"],["祭司","さいし"],["は"],["言った","いった"],["、"],["「"],["われわれ"],["は"],["、"],["ここ"],["で"],["、"],["神","かみ"],["に"],["尋ねましょう","たずねましょう"],["」"],["。"]]},{"verse":37,"text":"そこでサウルは神,かみに伺,うかがった、「わたしはペリシテびとを追,おって下,くだるべきでしょうか。あなたは彼,かれらをイスラエルの手,てに渡,わたされるでしょうか」。しかし神,かみはその日,ひは答,こたえられなかった。","tok":[["そこ"],["で"],["サウル"],["は"],["神","かみ"],["に"],["伺った","うかがった"],["、"],["「"],["わたし"],["は"],["ペリシテ"],["びと"],["を"],["追って","おって"],["下るべきでしょう","くだるべきでしょう"],["か"],["。"],["あなた"],["は"],["彼","かれ"],["ら"],["を"],["イスラエル"],["の"],["手","て"],["に"],["渡されるでしょう","わたされるでしょう"],["か"],["」"],["。"],["しかし"],["神","かみ"],["は"],["その"],["日","ひ"],["は"],["答","こたえ"],["られなかった"],["。"]]},{"verse":38,"text":"そこでサウルは言,いった、「民,たみの長,ちょうたちよ、みなこの所,ところに近,ちかよりなさい。あなたがたは、よく見,みきわめて、きょうのこの罪,つみが起,おきたわけを知,しらなければならない。","tok":[["そこ"],["で"],["サウル"],["は"],["言った","いった"],["、"],["「"],["民","たみ"],["の"],["長","ちょう"],["たち"],["よ"],["、"],["みな"],["この"],["所","ところ"],["に"],["近より","ちかより"],["なさい"],["。"],["あなた"],["がた"],["は"],["、"],["よく"],["見きわめて","みきわめて"],["、"],["きょう"],["の"],["この"],["罪","つみ"],["が"],["起きた","おきた"],["わけ"],["を"],["知らなければ","しらなければ"],["ならない"],["。"]]},{"verse":39,"text":"イスラエルを救,すくう主,しゅは生,いきておられる。たとい、それがわたしの子,こヨナタンであっても、必,かならず死,しななければならない」。しかし民,たみのうちにはひとりも、これに答,こたえるものがいなかった。","tok":[["イスラエル"],["を"],["救う","すくう"],["主","しゅ"],["は"],["生きて","いきて"],["おられる"],["。"],["たとい"],["、"],["それ"],["が"],["わたし"],["の"],["子","こ"],["ヨナタン"],["で"],["あって"],["も"],["、"],["必死","かならずし"],["な"],["なければ"],["ならない"],["」"],["。"],["しかし"],["民","たみ"],["の"],["うち"],["に"],["は"],["ひとり"],["も"],["、"],["これ"],["に"],["答","こたえ"],["る"],["もの"],["が"],["いなかった"],["。"]]},{"verse":40,"text":"サウルはイスラエルのすべての人,ひとに言,いった、「あなたがたは向,むこう側,がわにいなさい。わたしとわたしの子,こヨナタンはこちら側,がわにいましょう」。民,たみはサウルに言,いった、「良,よいと思,おもわれることをしてください」。","tok":[["サウル"],["は"],["イスラエル"],["の"],["すべて"],["の"],["人","ひと"],["に"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["向こう側","むこうがわ"],["に"],["い"],["なさい"],["。"],["わたし"],["と"],["わたし"],["の"],["子","こ"],["ヨナタン"],["は"],["こちら側","こちらがわ"],["に"],["いましょう"],["」"],["。"],["民","たみ"],["は"],["サウル"],["に"],["言った","いった"],["、"],["「"],["良い","よい"],["と"],["思われる","おもわれる"],["こと"],["を"],["して"],["ください"],["」"],["。"]]},{"verse":41,"text":"そこでサウルは言,いった、「イスラエルの神,かみ、主,しゅよ、あなたはきょう、なにゆえしもべに答,こたえられなかったのですか。もしこの罪,つみがわたしにあるか、またはわたしの子,こヨナタンにあるのでしたら、イスラエルの神,かみ、主,しゅよ、ウリムをお与,あたえください。しかし、もしこの罪,つみが、あなたの民,たみイスラエルにあるのでしたらトンミムをお与,あたえください」。こうしてヨナタンとサウルとが、くじに当,あたり、民,たみはのがれた。","tok":[["そこ"],["で"],["サウル"],["は"],["言った","いった"],["、"],["「"],["イスラエル"],["の"],["神","かみ"],["、"],["主","しゅ"],["よ"],["、"],["あなた"],["は"],["きょう"],["、"],["なにゆえ"],["しもべ"],["に"],["答","こたえ"],["られなかった"],["の"],["です"],["か"],["。"],["もし"],["この"],["罪","つみ"],["が"],["わたし"],["に"],["ある"],["か"],["、"],["また"],["は"],["わたし"],["の"],["子","こ"],["ヨナタン"],["に"],["ある"],["の"],["でしたら"],["、"],["イスラエル"],["の"],["神","かみ"],["、"],["主","しゅ"],["よ"],["、"],["ウリム"],["を"],["お与え","おあたえ"],["ください"],["。"],["しかし"],["、"],["もし"],["この"],["罪","つみ"],["が"],["、"],["あなた"],["の"],["民","たみ"],["イスラエル"],["に"],["ある"],["の"],["でしたら"],["トンミム"],["を"],["お与え","おあたえ"],["ください"],["」"],["。"],["こう"],["して"],["ヨナタン"],["と"],["サウル"],["と"],["が"],["、"],["くじ"],["に"],["当たり","あたり"],["、"],["民","たみ"],["は"],["のがれた"],["。"]]},{"verse":42,"text":"サウルは言,いった、「わたしか、わたしの子,こヨナタンかを決,きめるために、くじを引,ひきなさい」。くじはヨナタンに当,あたった。","tok":[["サウル"],["は"],["言った","いった"],["、"],["「"],["わたし"],["か"],["、"],["わたし"],["の"],["子","こ"],["ヨナタン"],["か"],["を"],["決める","きめる"],["ため"],["に"],["、"],["くじ"],["を"],["引","ひき"],["なさい"],["」"],["。"],["くじ"],["は"],["ヨナタン"],["に"],["当たった","あたった"],["。"]]},{"verse":43,"text":"サウルはヨナタンに言,いった、「あなたがしたことを、わたしに言,いいなさい」。ヨナタンは言,いった、「わたしは確,たしかに手,てにあったつえの先,さきに少,すこしばかりの蜜,みつをつけて、なめました。わたしはここにいます。死,しは覚悟,かくごしています」。","tok":[["サウル"],["は"],["ヨナタン"],["に"],["言った","いった"],["、"],["「"],["あなた"],["が"],["した"],["こと"],["を"],["、"],["わたし"],["に"],["言い","いい"],["なさい"],["」"],["。"],["ヨナタン"],["は"],["言った","いった"],["、"],["「"],["わたし"],["は"],["確か","たしか"],["に"],["手","て"],["に"],["あった"],["つえ"],["の"],["先","さき"],["に"],["少し","すこし"],["ばかり"],["の"],["蜜","みつ"],["を"],["つけて"],["、"],["なめました"],["。"],["わたし"],["は"],["ここ"],["に"],["います"],["。"],["死","し"],["は"],["覚悟","かくご"],["して"],["います"],["」"],["。"]]},{"verse":44,"text":"サウルは言,いった、「神,かみがわたしをいくえにも罰,ばっしてくださるように。ヨナタンよ、あなたは必,かならず死,しななければならない」。","tok":[["サウル"],["は"],["言った","いった"],["、"],["「"],["神","かみ"],["が"],["わたし"],["を"],["いく"],["え"],["に"],["も"],["罰して","ばっして"],["くださる"],["よう"],["に"],["。"],["ヨナタン"],["よ"],["、"],["あなた"],["は"],["必死","かならずし"],["な"],["なければ"],["ならない"],["」"],["。"]]},{"verse":45,"text":"その時,とき、民,たみはサウルに言,いった、「イスラエルのうちにこの大,おおいなる勝利,しょうりをもたらしたヨナタンが死,しななければならないのですか。決,けっしてそうではありません。主,しゅは生,いきておられます。ヨナタンの髪,かみの毛,け一すじも地,ちに落,おとしてはなりません。彼,かれは神,かみと共,ともにきょう働,はたらいたのです」。こうして民,たみはヨナタンを救,すくったので彼,かれは死,しを免,まぬかれた。","tok":[["その"],["時","とき"],["、"],["民","たみ"],["は"],["サウル"],["に"],["言った","いった"],["、"],["「"],["イスラエル"],["の"],["うち"],["に"],["この"],["大いなる","おおいなる"],["勝利","しょうり"],["を"],["もたらした"],["ヨナタン"],["が"],["死ななければ","しななければ"],["ならない"],["の"],["です"],["か"],["。"],["決っして","けっして"],["そう"],["で"],["は"],["ありません"],["。"],["主","しゅ"],["は"],["生きて","いきて"],["おられます"],["。"],["ヨナタン"],["の"],["髪の毛","かみのけ"],["一すじ","ひとすじ"],["も"],["地","ち"],["に"],["落として","おとして"],["は"],["なりません"],["。"],["彼","かれ"],["は"],["神","かみ"],["と"],["共","とも"],["に"],["きょう"],["働いた","はたらいた"],["の"],["です"],["」"],["。"],["こう"],["して"],["民","たみ"],["は"],["ヨナタン"],["を"],["救った","すくった"],["ので"],["彼","かれ"],["は"],["死","し"],["を"],["免かれた","まぬかれた"],["。"]]},{"verse":46,"text":"サウルはペリシテびとを追,おうことをやめて引,ひきあげ、ペリシテびとはその国,くにへ帰,かえった。","tok":[["サウル"],["は"],["ペリシテ"],["びと"],["を"],["追う","おう"],["こと"],["を"],["やめて"],["引","ひき"],["あげ"],["、"],["ペリシテ"],["び"],["と"],["は"],["その"],["国","くに"],["へ"],["帰えった","かえった"],["。"]]},{"verse":47,"text":"サウルはイスラエルの王,おうとなって、周囲,しゅういのもろもろの敵,てき、すなわちモアブ、アンモンの人々,ひとびと、エドム、ゾバの王,おうたちおよびペリシテびとと戦,たたかい、すべて向,むかう所,ところで勝利,しょうりを得,えた。","tok":[["サウル"],["は"],["イスラエル"],["の"],["王","おう"],["と"],["なって"],["、"],["周囲","しゅうい"],["の"],["もろもろ"],["の"],["敵","てき"],["、"],["すなわち"],["モアブ"],["、"],["アンモン"],["の"],["人々","ひとびと"],["、"],["エドム"],["、"],["ゾバ"],["の"],["王","おう"],["たち"],["および"],["ペリシテ"],["びと"],["と"],["戦い","たたかい"],["、"],["すべて"],["向かう","むかう"],["所","ところ"],["で"],["勝利","しょうり"],["を"],["得た","えた"],["。"]]},{"verse":48,"text":"サウルは勇,いさましく働,はたらき、アマレクびとを撃,うって、イスラエルびとを略奪者,りゃくだつしゃの手,てから救,すくい出,だした。","tok":[["サウル"],["は"],["勇ましく","いさましく"],["働らき","はたらき"],["、"],["アマレク"],["びと"],["を"],["撃って","うって"],["、"],["イスラエル"],["びと"],["を"],["略奪者","りゃくだつしゃ"],["の"],["手","て"],["から"],["救い出した","すくいだした"],["。"]]},{"verse":49,"text":"さて、サウルのむすこたちはヨナタン、エスイ、およびマルキシュアである。ふたりの娘,むすめの名,なは次,つぎのとおりである。すなわち姉,あねの名,なはメラブ、妹,いもうとの名,なはミカルである。","tok":[["さて"],["、"],["サウル"],["の"],["むすこ"],["たち"],["は"],["ヨナタン"],["、"],["エスイ"],["、"],["および"],["マルキ"],["シュア"],["で"],["ある"],["。"],["ふたり"],["の"],["娘","むすめ"],["の"],["名","な"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["すなわち"],["姉","あね"],["の"],["名","な"],["は"],["メラブ"],["、"],["妹","いもうと"],["の"],["名","な"],["は"],["ミカル"],["で"],["ある"],["。"]]},{"verse":50,"text":"サウルの妻,つまの名,なはアヒノアムといい、アヒマアズの娘,むすめである。また軍,ぐんの長,ちょうの名,なはアブネルといい、サウルのおじネルの子,こである。","tok":[["サウル"],["の"],["妻","つま"],["の"],["名","な"],["は"],["アヒノアム"],["と"],["いい"],["、"],["アヒマアズ"],["の"],["娘","むすめ"],["で"],["ある"],["。"],["また"],["軍","ぐん"],["の"],["長","ちょう"],["の"],["名","な"],["は"],["アブネル"],["と"],["いい"],["、"],["サウル"],["の"],["おじ"],["ネル"],["の"],["子","こ"],["で"],["ある"],["。"]]},{"verse":51,"text":"サウルの父,ちちキシとアブネルの父,ちちネルとは、アビエルの子,こである。","tok":[["サウル"],["の"],["父","ちち"],["キシ"],["と"],["アブネル"],["の"],["父","ちち"],["ネル"],["と"],["は"],["、"],["アビエル"],["の"],["子","こ"],["で"],["ある"],["。"]]},{"verse":52,"text":"サウルの一生,いっしょうの間,あいだ、ペリシテびとと激,はげしい戦,たたかいがあった。サウルは力,ちからの強,つよい人,ひとや勇気,ゆうきのある人,ひとを見,みるごとに、それを召,めしかかえた。","tok":[["サウル"],["の"],["一生","いっしょう"],["の"],["間","あいだ"],["、"],["ペリシテ"],["びと"],["と"],["激しい","はげしい"],["戦い","たたかい"],["が"],["あった"],["。"],["サウル"],["は"],["力","ちから"],["の"],["強い","つよい"],["人","ひと"],["や"],["勇気","ゆうき"],["の"],["ある"],["人","ひと"],["を"],["見る","みる"],["ごと"],["に"],["、"],["それ"],["を"],["召","めし"],["かかえた"],["。"]]}]
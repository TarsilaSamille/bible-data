[{"verse":1,"text":"サムエルはイスラエルの人々,ひとびとに言,いった、「見,みよ、わたしは、あなたがたの言葉,ことばに聞,きき従,したがって、あなたがたの上,うえに王,おうを立,たてた。","tok":[["サムエル"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["言った","いった"],["、"],["「"],["見よ","みよ"],["、"],["わたし"],["は"],["、"],["あなた"],["がた"],["の"],["言葉","ことば"],["に"],["聞","きき"],["従って","したがって"],["、"],["あなた"],["がた"],["の"],["上","うえ"],["に"],["王","おう"],["を"],["立てた","たてた"],["。"]]},{"verse":2,"text":"見,みよ王,おうは今,いま、あなたがたの前,まえに歩,あゆむ。わたしは年老,としおいて髪,かみは白,しろくなった。わたしの子,こらもあなたがたと共,ともにいる。わたしは若,わかい時,ときから、きょうまで、あなたがたの前,まえに歩,あゆんだ。","tok":[["見よ","みよ"],["王","おう"],["は"],["今","いま"],["、"],["あなた"],["がた"],["の"],["前","まえ"],["に"],["歩む","あゆむ"],["。"],["わたし"],["は"],["年老いて","としおいて"],["髪","かみ"],["は"],["白く","しろく"],["なった"],["。"],["わたし"],["の"],["子","こ"],["ら"],["も"],["あなた"],["がた"],["と"],["共","とも"],["に"],["いる"],["。"],["わたし"],["は"],["若い","わかい"],["時","とき"],["から"],["、"],["きょう"],["まで"],["、"],["あなた"],["がた"],["の"],["前","まえ"],["に"],["歩んだ","あゆんだ"],["。"]]},{"verse":3,"text":"わたしはここにいる。主,しゅの前,まえと、その油,あぶらそそがれた者,ものの前,まえに、わたしを訴,うったえよ。わたしが、だれの牛,うしを取,とったか。だれのろばを取,とったか。だれを欺,あざむいたか。だれをしえたげたか。だれの手,てから、まいないを取,とって、自分,じぶんの目,めをくらましたか。もしそのようなことがあれば、わたしはそれを、あなたがたに償,つぐなおう」。","tok":[["わたし"],["は"],["ここ"],["に"],["いる"],["。"],["主","しゅ"],["の"],["前","まえ"],["と"],["、"],["その"],["油","あぶら"],["そそがれた"],["者","もの"],["の"],["前","まえ"],["に"],["、"],["わたし"],["を"],["訴","うったえ"],["よ"],["。"],["わたし"],["が"],["、"],["だれ"],["の"],["牛","うし"],["を"],["取った","とった"],["か"],["。"],["だれ"],["の"],["ろば"],["を"],["取った","とった"],["か"],["。"],["だれ"],["を"],["欺いた","あざむいた"],["か"],["。"],["だれ"],["を"],["し"],["えたげた"],["か"],["。"],["だれ"],["の"],["手","て"],["から"],["、"],["まいない"],["を"],["取って","とって"],["、"],["自分","じぶん"],["の"],["目","め"],["を"],["くらました"],["か"],["。"],["もし"],["その"],["よう"],["な"],["こと"],["が"],["あれば"],["、"],["わたし"],["は"],["それ"],["を"],["、"],["あなた"],["がた"],["に"],["償なおう","つぐなおう"],["」"],["。"]]},{"verse":4,"text":"彼,かれらは言,いった、「あなたは、われわれを欺,あざむいたことも、しえたげたこともありません。また人,ひとの手,てから何,なにも取,とったことはありません」。","tok":[["彼","かれ"],["ら"],["は"],["言った","いった"],["、"],["「"],["あなた"],["は"],["、"],["われわれ"],["を"],["欺いた","あざむいた"],["こと"],["も"],["、"],["し"],["えたげた"],["こと"],["も"],["ありません"],["。"],["また"],["人","ひと"],["の"],["手","て"],["から"],["何に","なに"],["も"],["取った","とった"],["こと"],["は"],["ありません"],["」"],["。"]]},{"verse":5,"text":"サムエルは彼,かれらに言,いった、「あなたがたが、わたしの手,てのうちに、なんの不正,ふせいをも見,みいださないことを、主,しゅはあなたがたにあかしされる。その油,あぶらそそがれた者,ものも、きょうそれをあかしする」。彼,かれらは言,いった、「あかしされます」。","tok":[["サムエル"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["あなた"],["が"],["た"],["が"],["、"],["わたし"],["の"],["手","て"],["の"],["うち"],["に"],["、"],["なん"],["の"],["不正","ふせい"],["を"],["も"],["見いださない","みいださない"],["こと"],["を"],["、"],["主","しゅ"],["は"],["あなた"],["がた"],["に"],["あかし"],["される"],["。"],["その"],["油","あぶら"],["そそがれた"],["者","もの"],["も"],["、"],["きょう"],["それ"],["を"],["あかし"],["する"],["」"],["。"],["彼","かれ"],["ら"],["は"],["言った","いった"],["、"],["「"],["あかし"],["されます"],["」"],["。"]]},{"verse":6,"text":"サムエルは民,たみに言,いった、「モーセとアロンを立,たてて、あなたがたの先祖,せんぞをエジプトの地,ちから導,みちびき出,だされた主,しゅが証人,しょうにんです。","tok":[["サムエル"],["は"],["民","たみ"],["に"],["言った","いった"],["、"],["「"],["モーセ"],["と"],["アロン"],["を"],["立てて","たてて"],["、"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["を"],["エジプト"],["の"],["地","ち"],["から"],["導き出された","みちびきだされた"],["主","しゅ"],["が"],["証人","しょうにん"],["です"],["。"]]},{"verse":7,"text":"それゆえ、あなたがたは今,いま、立,たちなさい。わたしは主,しゅが、あなたがたとあなたがたの先祖,せんぞのために行,おこなわれたすべての救,すくいのわざについて、主,しゅの前,まえに、あなたがたと論,ろんじよう。","tok":[["それ"],["ゆえ"],["、"],["あなた"],["がた"],["は"],["今","いま"],["、"],["立","たち"],["なさい"],["。"],["わたし"],["は"],["主","しゅ"],["が"],["、"],["あなた"],["がた"],["と"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["の"],["ため"],["に"],["行なわれた","おこなわれた"],["すべて"],["の"],["救い","すくい"],["の"],["わざ"],["について"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["、"],["あなた"],["がた"],["と"],["論じよう","ろんじよう"],["。"]]},{"verse":8,"text":"ヤコブがエジプトに行,いって、エジプトびとが、彼,かれらを、しえたげた時,とき、あなたがたの先祖,せんぞは主,しゅに呼,よばわったので、主,しゅはモーセとアロンをつかわされた。そこで彼,かれらは、あなたがたの先祖,せんぞをエジプトから導,みちびき出,だして、この所,ところに住,すまわせた。","tok":[["ヤコブ"],["が"],["エジプト"],["に"],["行って","いって"],["、"],["エジプト"],["びと"],["が"],["、"],["彼","かれ"],["ら"],["を"],["、"],["し"],["えたげた"],["時","とき"],["、"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["は"],["主に","しゅに"],["呼ばわった","よばわった"],["ので"],["、"],["主","しゅ"],["は"],["モーセ"],["と"],["アロン"],["を"],["つかわされた"],["。"],["そこ"],["で"],["彼","かれ"],["ら"],["は"],["、"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["を"],["エジプト"],["から"],["導き出して","みちびきだして"],["、"],["この"],["所","ところ"],["に"],["住まわせた","すまわせた"],["。"]]},{"verse":9,"text":"しかし、彼,かれらがその神,かみ、主,しゅを忘,わすれたので、主,しゅは彼,かれらをハゾルの王,おうヤビンの軍,ぐんの長,ちょうシセラの手,てに渡,わたし、またペリシテびとの手,てとモアブの王,おうの手,てにわたされた。そこで彼,かれらがイスラエルを攻,せめたので、","tok":[["しかし"],["、"],["彼","かれ"],["ら"],["が"],["その"],["神","かみ"],["、"],["主","しゅ"],["を"],["忘た","わすれた"],["ので"],["、"],["主","しゅ"],["は"],["彼","かれ"],["ら"],["を"],["ハゾル"],["の"],["王","おう"],["ヤビン"],["の"],["軍","ぐん"],["の"],["長う","ちょう"],["シセラ"],["の"],["手","て"],["に"],["渡","わたし"],["、"],["また"],["ペリシテ"],["びと"],["の"],["手","て"],["と"],["モアブ"],["の"],["王","おう"],["の"],["手","て"],["に"],["わたされた"],["。"],["そこ"],["で"],["彼","かれ"],["ら"],["が"],["イスラエル"],["を"],["攻めた","せめた"],["ので"],["、"]]},{"verse":10,"text":"民,たみは主,しゅに呼,よばわって言,いった、『われわれは主,しゅを捨,すて、バアルとアシタロテに仕,つかえて、罪,つみを犯,おかしました。今,いま、われわれを敵,てきの手,てから救,すくい出,だしてください。われわれはあなたに仕,つかえます』。","tok":[["民","たみ"],["は"],["主に","しゅに"],["呼ばわって","よばわって"],["言った","いった"],["、"],["『"],["われわれ"],["は"],["主","しゅ"],["を"],["捨て","すて"],["、"],["バアル"],["と"],["アシタロテ"],["に"],["仕えて","つかえて"],["、"],["罪","つみ"],["を"],["犯しました","おかしました"],["。"],["今","いま"],["、"],["われわれ"],["を"],["敵","てき"],["の"],["手","て"],["から"],["救い出して","すくいだして"],["ください"],["。"],["われわれ"],["は"],["あなた"],["に"],["仕えます","つかえます"],["』"],["。"]]},{"verse":11,"text":"主,しゅはエルバアルとバラクとエフタとサムエルをつかわして、あなたがたを周囲,しゅういの敵,てきの手,てから救,すくい出,だされたので、あなたがたは安,やすらかに住,すむことができた。","tok":[["主","しゅ"],["は"],["エルバアル"],["と"],["バラク"],["と"],["エフタ"],["と"],["サムエル"],["を"],["つかわして"],["、"],["あなた"],["がた"],["を"],["周囲","しゅうい"],["の"],["敵","てき"],["の"],["手","て"],["から"],["救い出された","すくいだされた"],["ので"],["、"],["あなた"],["がた"],["は"],["安らか","やすらか"],["に"],["住む","すむ"],["こと"],["が"],["できた"],["。"]]},{"verse":12,"text":"ところが、アンモンびとの王,おうナハシが攻,せめてくるのを見,みたとき、あなたがたの神,かみ、主,しゅがあなたがたの王,おうであるのに、あなたがたはわたしに、『いいえ、われわれを治,おさめる王,おうがなければならない』と言,いった。","tok":[["ところ"],["が"],["、"],["アンモン"],["びと"],["の"],["王","おう"],["ナハシ"],["が"],["攻めて","せめて"],["くる"],["の"],["を"],["見た","みた"],["とき"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["あなた"],["がた"],["の"],["王","おう"],["で"],["ある"],["のに"],["、"],["あなた"],["がた"],["は"],["わたし"],["に"],["、"],["『"],["いいえ"],["、"],["われわれ"],["を"],["治める","おさめる"],["王","おう"],["が"],["なければ"],["ならない"],["』"],["と"],["言った","いった"],["。"]]},{"verse":13,"text":"それゆえ、今,いまあなたがたの選,えらんだ王,おう、あなたがたが求,もとめた王,おうを見,みなさい。主,しゅはあなたがたの上,うえに王,おうを立,たてられた。","tok":[["それ"],["ゆえ"],["、"],["今","いま"],["あなた"],["がた"],["の"],["選らんだ","えらんだ"],["王","おう"],["、"],["あなた"],["がた"],["が"],["求めた","もとめた"],["王","おう"],["を"],["見","み"],["なさい"],["。"],["主","しゅ"],["は"],["あなた"],["がた"],["の"],["上","うえ"],["に"],["王","おう"],["を"],["立られた","たてられた"],["。"]]},{"verse":14,"text":"もし、あなたがたが主,しゅを恐,おそれ、主,しゅに仕,つかえて、その声,こえに聞,きき従,したがい、主,しゅの戒,いましめにそむかず、あなたがたも、あなたがたを治,おさめる王,おうも共,ともに、あなたがたの神,かみ、主,しゅに従,したがうならば、それで良,よい。","tok":[["もし"],["、"],["あなた"],["がた"],["が"],["主","しゅ"],["を"],["恐","おそれ"],["、"],["主に","しゅに"],["仕えて","つかえて"],["、"],["その"],["声","こえ"],["に"],["聞","きき"],["従い","したがい"],["、"],["主","しゅ"],["の"],["戒しめ","いましめ"],["に"],["そむかず"],["、"],["あなた"],["がた"],["も"],["、"],["あなた"],["がた"],["を"],["治める","おさめる"],["王","おう"],["も"],["共","とも"],["に"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主に","しゅに"],["従うならば","したがうならば"],["、"],["それ"],["で"],["良い","よい"],["。"]]},{"verse":15,"text":"しかし、もしあなたがたが主,しゅの声,こえに聞,きき従,したがわず、主,しゅの戒,いましめにそむくならば、主,しゅの手,ては、あなたがたとあなたがたの王,おうを攻,せめるであろう。","tok":[["しかし"],["、"],["もし"],["あなた"],["がた"],["が"],["主","しゅ"],["の"],["声","こえ"],["に"],["聞","きき"],["従わず","したがわず"],["、"],["主","しゅ"],["の"],["戒しめ","いましめ"],["に"],["そむくならば"],["、"],["主","しゅ"],["の"],["手","て"],["は"],["、"],["あなた"],["がた"],["と"],["あなた"],["がた"],["の"],["王","おう"],["を"],["攻めるで","せめるで"],["あろう"],["。"]]},{"verse":16,"text":"それゆえ、今,いま、あなたがたは立,たって、主,しゅが、あなたがたの目,めの前,まえで行,おこなわれる、この大,おおいなる事,ことを見,みなさい。","tok":[["それ"],["ゆえ"],["、"],["今","いま"],["、"],["あなた"],["がた"],["は"],["立って","たって"],["、"],["主","しゅ"],["が"],["、"],["あなた"],["がた"],["の"],["目","め"],["の"],["前","まえ"],["で"],["行なわれる","おこなわれる"],["、"],["この"],["大いなる","おおいなる"],["事","こと"],["を"],["見","み"],["なさい"],["。"]]},{"verse":17,"text":"きょうは小麦,こむぎ刈,かりの時,ときではないか。わたしは主,しゅに呼,よばわるであろう。そのとき主,しゅは雷,かみなりと雨,あめを下,くだして、あなたがたが王,おうを求,もとめて、主,しゅの前,まえに犯,おかした罪,つみの大,おおいなることを見,みさせ、また知,しらせられるであろう」。","tok":[["きょう"],["は"],["小麦刈","こむぎかり"],["の"],["時","とき"],["で"],["は"],["ない"],["か"],["。"],["わたし"],["は"],["主に","しゅに"],["呼ばわるで","よばわるで"],["あろう"],["。"],["その"],["とき"],["主","しゅ"],["は"],["雷","かみなり"],["と"],["雨","あめ"],["を"],["下して","くだして"],["、"],["あなた"],["がた"],["が"],["王","おう"],["を"],["求めて","もとめて"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["犯した","おかした"],["罪","つみ"],["の"],["大いなる","おおいなる"],["こと"],["を"],["見させ","みさせ"],["、"],["また"],["知らせられるで","しらせられるで"],["あろう"],["」"],["。"]]},{"verse":18,"text":"そしてサムエルが主,しゅに呼,よばわったので、主,しゅはその日,ひ、雷,かみなりと雨,あめを下,くだされた。民,たみは皆,みなひじょうに主,しゅとサムエルとを恐,おそれた。","tok":[["そして"],["サムエル"],["が"],["主に","しゅに"],["呼ばわった","よばわった"],["ので"],["、"],["主","しゅ"],["は"],["その"],["日","ひ"],["、"],["雷","かみなり"],["と"],["雨","あめ"],["を"],["下された","くだされた"],["。"],["民","たみ"],["は"],["皆","みな"],["ひじょう"],["に"],["主","しゅ"],["と"],["サムエル"],["と"],["を"],["恐れた","おそれた"],["。"]]},{"verse":19,"text":"民,たみはみなサムエルに言,いった、「しもべらのために、あなたの神,かみ、主,しゅに祈,いのって、われわれの死,しなないようにしてください。われわれは、もろもろの罪,つみを犯,おかした上,うえに、また王,おうを求,もとめて、悪,あくを加,くわえました」。","tok":[["民","たみ"],["は"],["みな"],["サムエル"],["に"],["言った","いった"],["、"],["「"],["しもべ"],["ら"],["の"],["ため"],["に"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主に","しゅに"],["祈って","いのって"],["、"],["われわれ"],["の"],["死なない","しなない"],["よう"],["に"],["して"],["ください"],["。"],["われわれ"],["は"],["、"],["もろもろ"],["の"],["罪","つみ"],["を"],["犯した","おかした"],["上","うえ"],["に"],["、"],["また"],["王","おう"],["を"],["求めて","もとめて"],["、"],["悪","あく"],["を"],["加えました","くわえました"],["」"],["。"]]},{"verse":20,"text":"サムエルは民,たみに言,いった、「恐,おそれることはない。あなたがたは、このすべての悪,あくをおこなった。しかし主,しゅに従,したがうことをやめず、心,こころをつくして主,しゅに仕,つかえなさい。","tok":[["サムエル"],["は"],["民","たみ"],["に"],["言った","いった"],["、"],["「"],["恐れる","おそれる"],["こと"],["は"],["ない"],["。"],["あなた"],["がた"],["は"],["、"],["この"],["すべて"],["の"],["悪","あく"],["を"],["おこなった"],["。"],["しかし"],["主に","しゅに"],["従う","したがう"],["こと"],["を"],["やめず"],["、"],["心","こころ"],["を"],["つくして"],["主に","しゅに"],["仕え","つかえ"],["なさい"],["。"]]},{"verse":21,"text":"むなしい物,ものに迷,まよって行,いってはならない。それは、あなたがたを助,たすけることも救,すくうこともできないむなしいものだからである。","tok":[["むなしい"],["物","もの"],["に"],["迷って","まよって"],["行って","いって"],["は"],["ならない"],["。"],["それ"],["は"],["、"],["あなた"],["がた"],["を"],["助ける","たすける"],["こと"],["も"],["救う","すくう"],["こと"],["も"],["できない"],["むなしい"],["もの"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":22,"text":"主,しゅは、その大,おおいなる名,なのゆえに、その民,たみを捨,すてられないであろう。主,しゅが、あなたがたを自分,じぶんの民,たみとすることを良,よしとされるからである。","tok":[["主","しゅ"],["は"],["、"],["その"],["大いなる","おおいなる"],["名","な"],["の"],["ゆえ"],["に"],["、"],["その"],["民","たみ"],["を"],["捨てられないで","すてられないで"],["あろう"],["。"],["主","しゅ"],["が"],["、"],["あなた"],["がた"],["を"],["自分","じぶん"],["の"],["民","たみ"],["と"],["する"],["こと"],["を"],["良し","よし"],["と"],["される"],["から"],["で"],["ある"],["。"]]},{"verse":23,"text":"また、わたしは、あなたがたのために祈,いのることをやめて主,しゅに罪,つみを犯,おかすことは、けっしてしないであろう。わたしはまた良,よい、正,ただしい道,みちを、あなたがたに教,おしえるであろう。","tok":[["また"],["、"],["わたし"],["は"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["祈る","いのる"],["こと"],["を"],["やめて"],["主に","しゅに"],["罪","つみ"],["を"],["犯す","おかす"],["こと"],["は"],["、"],["けっして"],["しないで"],["あろう"],["。"],["わたし"],["は"],["また"],["良い","よい"],["、"],["正い","ただしい"],["道","みち"],["を"],["、"],["あなた"],["がた"],["に"],["教えるで","おしえるで"],["あろう"],["。"]]},{"verse":24,"text":"あなたがたは、ただ主,しゅを恐,おそれ、心,こころをつくして、誠実,せいじつに主,しゅに仕,つかえなければならない。そして主,しゅがどんなに大,おおきいことをあなたがたのためにされたかを考,かんがえなければならない。","tok":[["あなた"],["がた"],["は"],["、"],["ただ"],["主","しゅ"],["を"],["恐","おそれ"],["、"],["心","こころ"],["を"],["つくして"],["、"],["誠実","せいじつ"],["に"],["主に","しゅに"],["仕えなければ","つかえなければ"],["ならない"],["。"],["そして"],["主","しゅ"],["が"],["どんな"],["に"],["大きい","おおきい"],["こと"],["を"],["あなた"],["がた"],["の"],["ため"],["に"],["された"],["か"],["を"],["考","かんがえ"],["なければ"],["ならない"],["。"]]},{"verse":25,"text":"しかし、あなたがたが、なおも悪,あくを行,おこなうならば、あなたがたも、あなたがたの王,おうも、共,ともに滅,ほろぼされるであろう」。","tok":[["しかし"],["、"],["あなた"],["が"],["た"],["が"],["、"],["なお"],["も"],["悪","あく"],["を"],["行なうならば","おこなうならば"],["、"],["あなた"],["がた"],["も"],["、"],["あなた"],["がた"],["の"],["王","おう"],["も"],["、"],["共","とも"],["に"],["滅ぼされるで","ほろぼされるで"],["あろう"],["」"],["。"]]}]
[{"verse":1,"text":"[23:29]ダビデはそこから上,のぼってエンゲデの要害,ようがいにいた。","tok":[["["],["23"],[":"],["29"],["]"],["ダビデ"],["は"],["そこ"],["から"],["上って","のぼって"],["エンゲデ"],["の"],["要害","ようがい"],["に"],["いた"],["。"]]},{"verse":2,"text":"[1]サウルがペリシテびとを追,おうことをやめて帰,かえってきたとき、人々,ひとびとは彼,かれに告,つげて言,いった、「ダビデはエンゲデの野,のにいます」。","tok":[["["],["1"],["]"],["サウル"],["が"],["ペリシテ"],["びと"],["を"],["追う","おう"],["こと"],["を"],["やめて"],["帰えって","かえって"],["きた"],["とき"],["、"],["人々","ひとびと"],["は"],["彼","かれ"],["に"],["告","つげ"],["て"],["言った","いった"],["、"],["「"],["ダビデ"],["は"],["エンゲデ"],["の"],["野","の"],["に"],["います"],["」"],["。"]]},{"verse":3,"text":"[2]そこでサウルは、全,ぜんイスラエルから選,えらんだ三千の人,ひとを率,ひきい、ダビデとその従者,じゅうしゃたちとを捜,さがすため、「やぎの岩,いわ」の前,まえへ出,でかけた。","tok":[["["],["2"],["]"],["そこ"],["で"],["サウル"],["は"],["、"],["全","ぜん"],["イスラエル"],["から"],["選らんだ","えらんだ"],["三千","さんせん"],["の"],["人","ひと"],["を"],["率い","ひきい"],["、"],["ダビデ"],["と"],["その"],["従者","じゅうしゃ"],["たち"],["と"],["を"],["捜す","さがす"],["ため"],["、"],["「"],["やぎ"],["の"],["岩","いわ"],["」"],["の"],["前","まえ"],["へ"],["出かけた","でかけた"],["。"]]},{"verse":4,"text":"[3]途中,とちゅう、羊,ひつじのおりの所,ところにきたが、そこに、ほら穴,あながあり、サウルは足,あしをおおうために、その中,なかにはいった。その時,とき、ダビデとその従者,じゅうしゃたちは、ほら穴,あなの奥,おくにいた。","tok":[["["],["3"],["]"],["途中","とちゅう"],["、"],["羊","ひつじ"],["の"],["おり"],["の"],["所","ところ"],["に"],["きた"],["が"],["、"],["そこ"],["に"],["、"],["ほら穴","ほらあな"],["が"],["あり"],["、"],["サウル"],["は"],["足","あし"],["を"],["おおう"],["ため"],["に"],["、"],["その"],["中","なか"],["に"],["はいった"],["。"],["その"],["時","とき"],["、"],["ダビデ"],["と"],["その"],["従者","じゅうしゃ"],["たち"],["は"],["、"],["ほら穴","ほらあな"],["の"],["奥","おく"],["に"],["いた"],["。"]]},{"verse":5,"text":"[4]ダビデの従者,じゅうしゃたちは彼,かれに言,いった、「主,しゅがあなたに告,つげて、『わたしはあなたの敵,てきをあなたの手,てに渡,わたす。あなたは自分,じぶんの良,よいと思,おもうことを彼,かれにすることができる』と言,いわれた日,ひがきたのです」。そこでダビデは立,たって、ひそかに、サウルの上着,うわぎのすそを切,きった。","tok":[["["],["4"],["]"],["ダビデ"],["の"],["従者","じゅうしゃ"],["たち"],["は"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["主","しゅ"],["が"],["あなた"],["に"],["告","つげ"],["て"],["、"],["『"],["わたし"],["は"],["あなた"],["の"],["敵","てき"],["を"],["あなた"],["の"],["手","て"],["に"],["渡す","わたす"],["。"],["あなた"],["は"],["自分","じぶん"],["の"],["良い","よい"],["と"],["思う","おもう"],["こと"],["を"],["彼","かれ"],["に"],["する"],["こと"],["が"],["できる"],["』"],["と"],["言われた","いわれた"],["日","ひ"],["が"],["きた"],["の"],["です"],["」"],["。"],["そこ"],["で"],["ダビデ"],["は"],["立って","たって"],["、"],["ひそか"],["に"],["、"],["サウル"],["の"],["上着","うわぎ"],["の"],["すそ"],["を"],["切った","きった"],["。"]]},{"verse":6,"text":"[5]しかし後,のちになって、ダビデはサウルの上着,うわぎのすそを切,きったことに、心,こころの責,せめを感,かんじた。","tok":[["["],["5"],["]"],["しかし"],["後","のち"],["に"],["なって"],["、"],["ダビデ"],["は"],["サウル"],["の"],["上着","うわぎ"],["の"],["すそ"],["を"],["切った","きった"],["こと"],["に"],["、"],["心","こころ"],["の"],["責","せめ"],["を"],["感じた","かんじた"],["。"]]},{"verse":7,"text":"[6]ダビデは従者,じゅうしゃたちに言,いった、「主,しゅが油,あぶらを注,そそがれたわが君,きみに、わたしがこの事,ことをするのを主,しゅは禁,きんじられる。彼,かれは主,しゅが油,あぶらを注,そそがれた者,ものであるから、彼,かれに敵,てきして、わたしの手,てをのべるのは良,よくない」。","tok":[["["],["6"],["]"],["ダビデ"],["は"],["従者","じゅうしゃ"],["たち"],["に"],["言った","いった"],["、"],["「"],["主","しゅ"],["が"],["油","あぶら"],["を"],["注がれた","そそがれた"],["わが"],["君","きみ"],["に"],["、"],["わたし"],["が"],["この"],["事","こと"],["を"],["する"],["の"],["を"],["主","しゅ"],["は"],["禁じられる","きんじられる"],["。"],["彼","かれ"],["は"],["主","しゅ"],["が"],["油","あぶら"],["を"],["注がれた","そそがれた"],["者","もの"],["で"],["ある"],["から"],["、"],["彼","かれ"],["に"],["敵して","てきして"],["、"],["わたし"],["の"],["手","て"],["を"],["のべる"],["の"],["は"],["良く","よく"],["ない"],["」"],["。"]]},{"verse":8,"text":"[7]ダビデはこれらの言葉,ことばをもって従者,じゅうしゃたちを差,さし止,とめ、サウルを撃,うつことを許,ゆるさなかった。サウルは立,たって、ほら穴,あなを去,さり、道,みちを進,すすんだ。","tok":[["["],["7"],["]"],["ダビデ"],["は"],["これ"],["ら"],["の"],["言葉","ことば"],["を"],["もって"],["従者","じゅうしゃ"],["たち"],["を"],["差し","さし"],["止","とめ"],["、"],["サウル"],["を"],["撃つ","うつ"],["こと"],["を"],["許さなかった","ゆるさなかった"],["。"],["サウル"],["は"],["立って","たって"],["、"],["ほら穴","ほらあな"],["を"],["去り","さり"],["、"],["道","みち"],["を"],["進んだ","すすんだ"],["。"]]},{"verse":9,"text":"[8]ダビデもまた、そのあとから立,たち、ほら穴,あなを出,でて、サウルのうしろから呼,よばわって、「わが君,きみ、王,おうよ」と言,いった。サウルがうしろをふり向,むいた時,とき、ダビデは地,ちにひれ伏,ふして拝,はいした。","tok":[["["],["8"],["]"],["ダビデ"],["も"],["また"],["、"],["その"],["あと"],["から"],["立ち","たち"],["、"],["ほら穴","ほらあな"],["を"],["出て","でて"],["、"],["サウル"],["の"],["うしろ"],["から"],["呼ばわって","よばわって"],["、"],["「"],["わが"],["君","きみ"],["、"],["王","おう"],["よ"],["」"],["と"],["言った","いった"],["。"],["サウル"],["が"],["うしろ"],["を"],["ふり向いた","ふりむいた"],["時","とき"],["、"],["ダビデ"],["は"],["地","ち"],["に"],["ひれ伏して","ひれふして"],["拝した","はいした"],["。"]]},{"verse":10,"text":"[9]そしてダビデはサウルに言,いった、「どうして、あなたは『ダビデがあなたを害,がいしようとしている』という人々,ひとびとの言葉,ことばを聞,きかれるのですか。","tok":[["["],["9"],["]"],["そして"],["ダビデ"],["は"],["サウル"],["に"],["言った","いった"],["、"],["「"],["どう"],["して"],["、"],["あなた"],["は"],["『"],["ダビデ"],["が"],["あなた"],["を"],["害しよう","がいしよう"],["として"],["いる"],["』"],["と"],["いう"],["人々","ひとびと"],["の"],["言葉","ことば"],["を"],["聞かれる","きかれる"],["の"],["です"],["か"],["。"]]},{"verse":11,"text":"[10]あなたは、この日,ひ、自分,じぶんの目,めで、主,しゅがあなたをきょう、ほら穴,あなの中,なかでわたしの手,てに渡,わたされたのをごらんになりました。人々,ひとびとはわたしにあなたを殺,ころすことを勧,すすめたのですが、わたしは殺,ころしませんでした。『わが君,きみは主,しゅが油,あぶらを注,そそがれた方,かたであるから、これに敵,てきして手,てをのべることはしない』とわたしは言,いいました。","tok":[["["],["10"],["]"],["あなた"],["は"],["、"],["この"],["日","ひ"],["、"],["自分","じぶん"],["の"],["目","め"],["で"],["、"],["主","しゅ"],["が"],["あなた"],["を"],["きょう"],["、"],["ほら穴","ほらあな"],["の"],["中","なか"],["で"],["わたし"],["の"],["手","て"],["に"],["渡された","わたされた"],["の"],["を"],["ごらん"],["に"],["なりました"],["。"],["人々","ひとびと"],["は"],["わたし"],["に"],["あなた"],["を"],["殺ろす","ころす"],["こと"],["を"],["勧めた","すすめた"],["の"],["です"],["が"],["、"],["わたし"],["は"],["殺ろしませんでした","ころしませんでした"],["。"],["『"],["わが"],["君","きみ"],["は"],["主","しゅ"],["が"],["油","あぶら"],["を"],["注がれた","そそがれた"],["方","か"],["たで"],["ある"],["から"],["、"],["これ"],["に"],["敵して","てきして"],["手","て"],["を"],["のべる"],["こと"],["は"],["しない"],["』"],["と"],["わたし"],["は"],["言いました","いいました"],["。"]]},{"verse":12,"text":"[11]わが父,ちちよ、ごらんなさい。あなたの上着,うわぎのすそは、わたしの手,てにあります。わたしがあなたの上着,うわぎのすそを切,きり、しかも、あなたを殺,ころさなかったことによって、あなたは、わたしの手,てに悪,あくも、とがもないことを見,みて知,しられるでしょう。あなたはわたしの命,いのちを取,とろうと、ねらっておられますが、わたしはあなたに対,たいして罪,つみをおかしたことはないのです。","tok":[["["],["11"],["]"],["わが"],["父","ちち"],["よ"],["、"],["ごらん"],["なさい"],["。"],["あなた"],["の"],["上着","うわぎ"],["の"],["すそ"],["は"],["、"],["わたし"],["の"],["手","て"],["に"],["あります"],["。"],["わたし"],["が"],["あなた"],["の"],["上着","うわぎ"],["の"],["すそ"],["を"],["切り","きり"],["、"],["しかも"],["、"],["あなた"],["を"],["殺ろさなかった","ころさなかった"],["こと"],["によって"],["、"],["あなた"],["は"],["、"],["わたし"],["の"],["手","て"],["に"],["悪も","あくも"],["、"],["とが"],["も"],["ない"],["こと"],["を"],["見て","みて"],["知られるでしょう","しられるでしょう"],["。"],["あなた"],["は"],["わたし"],["の"],["命","いのち"],["を"],["取ろう","とろう"],["と"],["、"],["ねらって"],["おられます"],["が"],["、"],["わたし"],["は"],["あなた"],["に対して","にたいして"],["罪","つみ"],["を"],["おかした"],["こと"],["は"],["ない"],["の"],["です"],["。"]]},{"verse":13,"text":"[12]どうぞ主,しゅがわたしとあなたの間,あいだをさばかれますように。また主,しゅがわたしのために、あなたに報,むくいられますように。しかし、わたしはあなたに手,てをくだすことをしないでしょう。","tok":[["["],["12"],["]"],["どうぞ"],["主","しゅ"],["が"],["わたし"],["と"],["あなた"],["の"],["間","あいだ"],["を"],["さばかれます"],["よう"],["に"],["。"],["また"],["主","しゅ"],["が"],["わたし"],["の"],["ため"],["に"],["、"],["あなた"],["に"],["報いられます","むくいられます"],["よう"],["に"],["。"],["しかし"],["、"],["わたし"],["は"],["あなた"],["に"],["手","て"],["を"],["くだす"],["こと"],["を"],["しないでしょう"],["。"]]},{"verse":14,"text":"[13]昔,むかしから、ことわざに言,いっているように、『悪,あくは悪人,あくにんから出,でる』。しかし、わたしはあなたに手,てをくだすことをしないでしょう。","tok":[["["],["13"],["]"],["昔","むかし"],["から"],["、"],["ことわざ"],["に"],["言って","いって"],["いる"],["よう"],["に"],["、"],["『"],["悪","あく"],["は"],["悪人","あくにん"],["から"],["出る","でる"],["』"],["。"],["しかし"],["、"],["わたし"],["は"],["あなた"],["に"],["手","て"],["を"],["くだす"],["こと"],["を"],["しないでしょう"],["。"]]},{"verse":15,"text":"[14]イスラエルの王,おうは、だれを追,おって出,でてこられたのですか。あなたは、だれを追,おっておられるのですか。死,しんだ犬,いぬを追,おっておられるのです。一匹,ぴきの蚤,のみを追,おっておられるのです。","tok":[["["],["14"],["]"],["イスラエル"],["の"],["王","おう"],["は"],["、"],["だれ"],["を"],["追って","おって"],["出て","でて"],["こられた"],["の"],["です"],["か"],["。"],["あなた"],["は"],["、"],["だれ"],["を"],["追って","おって"],["おられる"],["の"],["です"],["か"],["。"],["死んだ","しんだ"],["犬","いぬ"],["を"],["追って","おって"],["おられる"],["の"],["です"],["。"],["一匹","ぴき"],["の"],["蚤","のみ"],["を"],["追って","おって"],["おられる"],["の"],["です"],["。"]]},{"verse":16,"text":"[15]どうぞ主,しゅがさばきびととなって、わたしとあなたの間,あいだをさばき、かつ見,みて、わたしの訴,うったえを聞,きき、わたしをあなたの手,てから救,すくい出,だしてくださるように」。","tok":[["["],["15"],["]"],["どうぞ"],["主","しゅ"],["が"],["さばき"],["びと"],["と"],["なって"],["、"],["わたし"],["と"],["あなた"],["の"],["間","あいだ"],["を"],["さばき"],["、"],["かつ"],["見て","みて"],["、"],["わたし"],["の"],["訴","うったえ"],["を"],["聞","きき"],["、"],["わたし"],["を"],["あなた"],["の"],["手","て"],["から"],["救い出して","すくいだして"],["くださる"],["よう"],["に"],["」"],["。"]]},{"verse":17,"text":"[16]ダビデがこれらの言葉,ことばをサウルに語,かたり終,おわったとき、サウルは言,いった、「わが子,こダビデよ、これは、あなたの声,こえであるか」。そしてサウルは声,こえをあげて泣,ないた。","tok":[["["],["16"],["]"],["ダビデ"],["が"],["これ"],["ら"],["の"],["言葉","ことば"],["を"],["サウル"],["に"],["語り","かたり"],["終わった","おわった"],["とき"],["、"],["サウル"],["は"],["言った","いった"],["、"],["「"],["わが"],["子","こ"],["ダビデ"],["よ"],["、"],["これ"],["は"],["、"],["あなた"],["の"],["声","こえ"],["で"],["ある"],["か"],["」"],["。"],["そして"],["サウル"],["は"],["声","こえ"],["を"],["あげて"],["泣いた","ないた"],["。"]]},{"verse":18,"text":"[17]サウルはまたダビデに言,いった、「あなたはわたしよりも正,ただしい。わたしがあなたに悪,あくを報,むくいたのに、あなたはわたしに善,ぜんを報,むくいる。","tok":[["["],["17"],["]"],["サウル"],["は"],["また"],["ダビデ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["は"],["わたし"],["より"],["も"],["正い","ただしい"],["。"],["わたし"],["が"],["あなた"],["に"],["悪","あく"],["を"],["報いた","むくいた"],["のに"],["、"],["あなた"],["は"],["わたし"],["に"],["善","ぜん"],["を"],["報いる","むくいる"],["。"]]},{"verse":19,"text":"[18]きょう、あなたはいかに良,よくわたしをあつかったかを明,あきらかにしました。すなわち主,しゅがわたしをあなたの手,てにわたされたのに、あなたはわたしを殺,ころさなかったのです。","tok":[["["],["18"],["]"],["きょう"],["、"],["あなた"],["は"],["いかに"],["良く","よく"],["わたし"],["を"],["あつかった"],["か"],["を"],["明か","あきらか"],["に"],["しました"],["。"],["すなわち"],["主","しゅ"],["が"],["わたし"],["を"],["あなた"],["の"],["手","て"],["に"],["わたされた"],["のに"],["、"],["あなた"],["は"],["わたし"],["を"],["殺ろさなかった","ころさなかった"],["の"],["です"],["。"]]},{"verse":20,"text":"[19]人,ひとは敵,てきに会,あったとき、敵,てきを無事,ぶじに去,さらせるでしょうか。あなたが、きょう、わたしにした事,ことのゆえに、どうぞ主,しゅがあなたに良,よい報,むくいを与,あたえられるように。","tok":[["["],["19"],["]"],["人","ひと"],["は"],["敵","てき"],["に"],["会った","あった"],["とき"],["、"],["敵","てき"],["を"],["無事","ぶじ"],["に"],["去らせるでしょう","さらせるでしょう"],["か"],["。"],["あなた"],["が"],["、"],["きょう"],["、"],["わたし"],["に"],["した"],["事","こと"],["の"],["ゆえ"],["に"],["、"],["どうぞ"],["主","しゅ"],["が"],["あなた"],["に"],["良い","よい"],["報い","むくい"],["を"],["与えられる","あたえられる"],["よう"],["に"],["。"]]},{"verse":21,"text":"[20]今,いまわたしは、あなたがかならず王,おうとなることを知,しりました。またイスラエルの王国,おうこくが、あなたの手,てによって堅,かたく立,たつことを知,しりました。","tok":[["["],["20"],["]"],["今","いま"],["わたし"],["は"],["、"],["あなた"],["が"],["かならず"],["王","おう"],["と"],["なる"],["こと"],["を"],["知りました","しりました"],["。"],["また"],["イスラエル"],["の"],["王国","おうこく"],["が"],["、"],["あなた"],["の"],["手","て"],["によって"],["堅く","かたく"],["立つ","たつ"],["こと"],["を"],["知りました","しりました"],["。"]]},{"verse":22,"text":"[21]それゆえ、あなたはわたしのあとに、わたしの子孫,しそんを断,たたず、またわたしの父,ちちの家,いえから、わたしの名,なを滅,ほろぼし去,さらないと、いま主,しゅをさして、わたしに誓,ちかってください」。","tok":[["["],["21"],["]"],["それ"],["ゆえ"],["、"],["あなた"],["は"],["わたし"],["の"],["あと"],["に"],["、"],["わたし"],["の"],["子孫","しそん"],["を"],["断たず","たたず"],["、"],["また"],["わたし"],["の"],["父","ちち"],["の"],["家","いえ"],["から"],["、"],["わたし"],["の"],["名","な"],["を"],["滅ぼし去らない","ほろぼしさらない"],["と"],["、"],["いま"],["主","しゅ"],["を"],["さして"],["、"],["わたし"],["に"],["誓って","ちかって"],["ください"],["」"],["。"]]},{"verse":23,"text":"[22]そこでダビデはサウルに、そのように誓,ちかった。そしてサウルは家,いえに帰,かえり、ダビデとその従者,じゅうしゃたちは要害,ようがいにのぼって行,いった。","tok":[["["],["22"],["]"],["そこ"],["で"],["ダビデ"],["は"],["サウル"],["に"],["、"],["その"],["よう"],["に"],["誓った","ちかった"],["。"],["そして"],["サウル"],["は"],["家","いえ"],["に"],["帰えり","かえり"],["、"],["ダビデ"],["と"],["その"],["従者","じゅうしゃ"],["たち"],["は"],["要害","ようがい"],["に"],["のぼって"],["行った","いった"],["。"]]}]
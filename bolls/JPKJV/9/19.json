[{"verse":1,"text":"サウルはその子,こヨナタンおよびすべての家来,けらいたちにダビデを殺,ころすようにと言,いった。しかしサウルの子,こヨナタンは深,ふかくダビデを愛,あいしていた。","tok":[["サウル"],["は"],["その"],["子","こ"],["ヨナタン"],["および"],["すべて"],["の"],["家来","けらい"],["たち"],["に"],["ダビデ"],["を"],["殺ろす","ころす"],["よう"],["に"],["と"],["言った","いった"],["。"],["しかし"],["サウル"],["の"],["子","こ"],["ヨナタン"],["は"],["深く","ふかく"],["ダビデ"],["を"],["愛して","あいして"],["いた"],["。"]]},{"verse":2,"text":"ヨナタンはダビデに言,いった、「父,ちちサウルはあなたを殺,ころそうとしています。それゆえあすの朝,あさ、気,きをつけて、わからない場所,ばしょに身,みを隠,かくしていてください。","tok":[["ヨナタン"],["は"],["ダビデ"],["に"],["言った","いった"],["、"],["「"],["父","ちち"],["サウル"],["は"],["あなた"],["を"],["殺そう","ころそう"],["として"],["います"],["。"],["それ"],["ゆえ"],["あす"],["の"],["朝","あさ"],["、"],["気","き"],["を"],["つけて"],["、"],["わからない"],["場所","ばしょ"],["に"],["身","み"],["を"],["隠して","かくして"],["いて"],["ください"],["。"]]},{"verse":3,"text":"わたしは出,でて行,いって、あなたがいる野原,のはらで父,ちちのかたわらに立,たち、父,ちちにあなたのことを話,はなしましょう。そして、何,なにかわたしにわかれば、あなたに告,つげましょう」。","tok":[["わたし"],["は"],["出て","でて"],["行って","いって"],["、"],["あなた"],["が"],["いる"],["野原","のはら"],["で"],["父","ちち"],["の"],["かたわら"],["に"],["立ち","たち"],["、"],["父","ちち"],["に"],["あなた"],["の"],["こと"],["を"],["話","はなし"],["ましょう"],["。"],["そして"],["、"],["何に","なに"],["か"],["わたし"],["に"],["わかれば"],["、"],["あなた"],["に"],["告","つげ"],["ましょう"],["」"],["。"]]},{"verse":4,"text":"ヨナタンは父,ちちサウルにダビデのことをほめて言,いった、「王,おうよ、どうか家来,けらいダビデに対,たいして罪,つみを犯,おかさないでください。彼,かれは、あなたに罪,つみを犯,おかさず、また彼,かれのしたことは、あなたのためになることでした。","tok":[["ヨナタン"],["は"],["父","ちち"],["サウル"],["に"],["ダビデ"],["の"],["こと"],["を"],["ほめて"],["言った","いった"],["、"],["「"],["王","おう"],["よ"],["、"],["どう"],["か"],["家来","けらい"],["ダビデ"],["に対して","にたいして"],["罪","つみ"],["を"],["犯さないで","おかさないで"],["ください"],["。"],["彼","かれ"],["は"],["、"],["あなた"],["に"],["罪","つみ"],["を"],["犯さず","おかさず"],["、"],["また"],["彼","かれ"],["の"],["した"],["こと"],["は"],["、"],["あなた"],["の"],["ため"],["に"],["なる"],["こと"],["でした"],["。"]]},{"verse":5,"text":"彼,かれは命,いのちをかけて、あのペリシテびとを殺,ころし、主,しゅはイスラエルの人々,ひとびとに大,おおいなる勝利,しょうりを与,あたえられたのです。あなたはそれを見,みて喜,よろこばれました。それであるのに、どうしてゆえなくダビデを殺,ころし、罪,つみなき者,ものの血,ちを流,ながして罪,つみを犯,おかそうとされるのですか」。","tok":[["彼","かれ"],["は"],["命","いのち"],["を"],["かけて"],["、"],["あの"],["ペリシテ"],["びと"],["を"],["殺ろし","ころし"],["、"],["主","しゅ"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["大いなる","おおいなる"],["勝利","しょうり"],["を"],["与えられた","あたえられた"],["の"],["です"],["。"],["あなた"],["は"],["それ"],["を"],["見て","みて"],["喜こばれました","よろこばれました"],["。"],["それ"],["で"],["ある"],["のに"],["、"],["どう"],["して"],["ゆえ"],["なく"],["ダビデ"],["を"],["殺ろし","ころし"],["、"],["罪","つみ"],["なき"],["者","もの"],["の"],["血","ち"],["を"],["流して","ながして"],["罪","つみ"],["を"],["犯そう","おかそう"],["と"],["される"],["の"],["です"],["か"],["」"],["。"]]},{"verse":6,"text":"サウルはヨナタンの言葉,ことばを聞,ききいれた。そしてサウルは誓,ちかった、「主,しゅは生,いきておられる。わたしは決,けっして彼,かれを殺,ころさない」。","tok":[["サウル"],["は"],["ヨナタン"],["の"],["言葉","ことば"],["を"],["聞きいれた","ききいれた"],["。"],["そして"],["サウル"],["は"],["誓った","ちかった"],["、"],["「"],["主","しゅ"],["は"],["生きて","いきて"],["おられる"],["。"],["わたし"],["は"],["決っして","けっして"],["彼","かれ"],["を"],["殺ろさない","ころさない"],["」"],["。"]]},{"verse":7,"text":"ヨナタンはダビデを呼,よんでこれらのことをみなダビデに告,つげた。そしてヨナタンがダビデをサウルのもとに連,つれてきたので、ダビデは、もとのようにサウルの前,まえにいた。","tok":[["ヨナタン"],["は"],["ダビデ"],["を"],["呼んで","よんで"],["これ"],["ら"],["の"],["こと"],["を"],["みな"],["ダビデ"],["に"],["告","つげ"],["た"],["。"],["そして"],["ヨナタン"],["が"],["ダビデ"],["を"],["サウル"],["の"],["もと"],["に"],["連れて","つれて"],["きた"],["ので"],["、"],["ダビデ"],["は"],["、"],["もと"],["の"],["よう"],["に"],["サウル"],["の"],["前","まえ"],["に"],["いた"],["。"]]},{"verse":8,"text":"ところがまた戦争,せんそうがおこって、ダビデは出,でてペリシテびとと戦,たたかい、大,おおいに彼,かれらを殺,ころしたので、彼,かれらはその前,まえから逃,にげ去,さった。","tok":[["ところ"],["が"],["また"],["戦争","せんそう"],["が"],["おこって"],["、"],["ダビデ"],["は"],["出て","でて"],["ペリシテ"],["びと"],["と"],["戦い","たたかい"],["、"],["大いに","おおいに"],["彼","かれ"],["ら"],["を"],["殺ろした","ころした"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["その"],["前","まえ"],["から"],["逃去","にげさっ"],["た"],["。"]]},{"verse":9,"text":"さてサウルが家,いえにいて手,てにやりを持,もってすわっていた時,とき、主,しゅから来,くる悪霊,あくれいがサウルに臨,のぞんだので、ダビデは琴,ことをひいていたが、","tok":[["さて"],["サウル"],["が"],["家","いえ"],["に"],["いて"],["手","て"],["に"],["やり"],["を"],["持って","もって"],["すわって"],["いた"],["時","とき"],["、"],["主ら","しゅから"],["来る","くる"],["悪霊","あ"],["く"],["れい"],["が"],["サウル"],["に"],["臨","のぞんだ"],["ので"],["、"],["ダビデ"],["は"],["琴","こと"],["を"],["ひいて"],["いた"],["が"],["、"]]},{"verse":10,"text":"サウルはそのやりをもってダビデを壁,かべに刺,さし通,とおそうとした。しかし彼,かれはサウルの前,まえに身,みをかわしたので、やりは壁,かべにつきささった。そしてダビデは逃,にげ去,さった。","tok":[["サウル"],["は"],["その"],["やり"],["を"],["もって"],["ダビデ"],["を"],["壁","かべ"],["に"],["刺通そう","さしとおそう"],["と"],["した"],["。"],["しかし"],["彼","かれ"],["は"],["サウル"],["の"],["前","まえ"],["に"],["身","み"],["を"],["かわした"],["ので"],["、"],["やり"],["は"],["壁","かべ"],["に"],["つきささった"],["。"],["そして"],["ダビデ"],["は"],["逃去","にげさっ"],["た"],["。"]]},{"verse":11,"text":"その夜,よる、サウルはダビデの家,いえに使者,ししゃたちをつかわして見張,みはりをさせ、朝,あさになって彼,かれを殺,ころさせようとした。しかしダビデの妻,つまミカルはダビデに言,いった、「もし今夜,こんやのうちに、あなたが自分,じぶんの命,いのちを救,すくわないならば、あすは殺,ころされるでしょう」。","tok":[["その"],["夜","よる"],["、"],["サウル"],["は"],["ダビデ"],["の"],["家","いえ"],["に"],["使者","ししゃ"],["たち"],["を"],["つかわして"],["見張","みはり"],["を"],["させ"],["、"],["朝","あさ"],["に"],["なって"],["彼","かれ"],["を"],["殺させよう","ころさせよう"],["と"],["した"],["。"],["しかし"],["ダビデ"],["の"],["妻","つま"],["ミカル"],["は"],["ダビデ"],["に"],["言った","いった"],["、"],["「"],["もし"],["今夜","こんや"],["の"],["うち"],["に"],["、"],["あなた"],["が"],["自分","じぶん"],["の"],["命","いのち"],["を"],["救わないならば","すくわないならば"],["、"],["あす"],["は"],["殺ろされるでしょう","ころされるでしょう"],["」"],["。"]]},{"verse":12,"text":"そしてミカルがダビデを窓,まどからつりおろしたので、彼,かれは逃,にげ去,さった。","tok":[["そして"],["ミカル"],["が"],["ダビデ"],["を"],["窓","まど"],["から"],["つりおろした"],["ので"],["、"],["彼","かれ"],["は"],["逃去","にげさっ"],["た"],["。"]]},{"verse":13,"text":"ミカルは一つの像,ぞうをとって、寝床,ねどこの上,うえに横,よこたえ、その頭,あたまにやぎの毛,けの網,あみをかけ、着物,きものをもってそれをおおった。","tok":[["ミカル"],["は"],["一","ひと"],["つ"],["の"],["像","ぞう"],["を"],["とって"],["、"],["寝床","ねどこ"],["の"],["上","うえ"],["に"],["横たえ","よこたえ"],["、"],["その"],["頭","あたま"],["に"],["やぎ"],["の"],["毛","け"],["の"],["網","あみ"],["を"],["かけ"],["、"],["着物","きもの"],["を"],["もって"],["それ"],["を"],["おおった"],["。"]]},{"verse":14,"text":"サウルはダビデを捕,とらえるため使者,ししゃたちをつかわしたが、彼女,かのじょは言,いった、「あの人,ひとは病気,びょうきです」。","tok":[["サウル"],["は"],["ダビデ"],["を"],["捕らえる","とらえる"],["ため"],["使者","ししゃ"],["たち"],["を"],["つかわした"],["が"],["、"],["彼女","かのじょ"],["は"],["言った","いった"],["、"],["「"],["あの"],["人","ひと"],["は"],["病気","びょうき"],["です"],["」"],["。"]]},{"verse":15,"text":"そこでサウルは、ダビデを見,みさせようと使者,ししゃたちをつかわして言,いった、「彼,かれを寝床,ねどこのまま、わたしの所,ところに連,つれてきなさい。わたしが彼,かれを殺,ころそう」。","tok":[["そこ"],["で"],["サウル"],["は"],["、"],["ダビデ"],["を"],["見させよう","みさせよう"],["と"],["使者","ししゃ"],["たち"],["を"],["つかわして"],["言った","いった"],["、"],["「"],["彼","かれ"],["を"],["寝床","ねどこ"],["の"],["まま"],["、"],["わたし"],["の"],["所","ところ"],["に"],["連れて","つれて"],["き"],["なさい"],["。"],["わたし"],["が"],["彼","かれ"],["を"],["殺そう","ころそう"],["」"],["。"]]},{"verse":16,"text":"使者,ししゃたちがはいって見,みると、寝床,ねどこには像,ぞうが横,よこたえてあって、その頭,あたまには、やぎの毛,けの網,あみがかけてあった。","tok":[["使者","ししゃ"],["たち"],["が"],["はいって"],["見る","みる"],["と"],["、"],["寝床","ねどこ"],["に"],["は"],["像","ぞう"],["が"],["横たえて","よこたえて"],["あって"],["、"],["その"],["頭","あたま"],["に"],["は"],["、"],["やぎ"],["の"],["毛","け"],["の"],["網","あみ"],["が"],["かけて"],["あった"],["。"]]},{"verse":17,"text":"サウルはミカルに言,いった、「あなたはどうして、このようにわたしを欺,あざむいて、わたしの敵,てきを逃,にがしたのか」。ミカルはサウルに答,こたえた、「あの人,ひとはわたしに『逃,にがしてくれ。さもないと、おまえを殺,ころす』と言,いいました」。","tok":[["サウル"],["は"],["ミカル"],["に"],["言った","いった"],["、"],["「"],["あなた"],["は"],["どう"],["して"],["、"],["この"],["よう"],["に"],["わたし"],["を"],["欺いて","あざむいて"],["、"],["わたし"],["の"],["敵","てき"],["を"],["逃がした","にがした"],["の"],["か"],["」"],["。"],["ミカル"],["は"],["サウル"],["に"],["答","こたえ"],["た"],["、"],["「"],["あの"],["人","ひと"],["は"],["わたし"],["に"],["『"],["逃がして","にがして"],["くれ"],["。"],["さも"],["ない"],["と"],["、"],["おまえ"],["を"],["殺ろす","ころす"],["』"],["と"],["言いました","いいました"],["」"],["。"]]},{"verse":18,"text":"ダビデは逃,にげ去,さり、ラマにいるサムエルのもとへ行,いって、サウルが自分,じぶんにしたすべてのことを彼,かれに告,つげた。そしてダビデとサムエルは行,いってナヨテに住,すんだ。","tok":[["ダビデ"],["は"],["逃","にげ"],["去り","さり"],["、"],["ラマ"],["に"],["いる"],["サムエル"],["の"],["もと"],["へ"],["行って","いって"],["、"],["サウル"],["が"],["自分","じぶん"],["に"],["した"],["すべて"],["の"],["こと"],["を"],["彼","かれ"],["に"],["告","つげ"],["た"],["。"],["そして"],["ダビデ"],["と"],["サムエル"],["は"],["行って","いって"],["ナヨテ"],["に"],["住んだ","すんだ"],["。"]]},{"verse":19,"text":"ある人,ひとがサウルに「ダビデはラマのナヨテにいます」と告,つげたので、","tok":[["ある"],["人","ひと"],["が"],["サウル"],["に"],["「"],["ダビデ"],["は"],["ラマ"],["の"],["ナヨテ"],["に"],["います"],["」"],["と"],["告","つげ"],["た"],["ので"],["、"]]},{"verse":20,"text":"サウルは、ダビデを捕,とらえるために、使者,ししゃたちをつかわした。彼,かれらは預言者,よげんしゃの一群,いちぐんが預言,よげんしていて、サムエルが、そのうちの、かしらとなって立,たっているのを見,みたが、その時,とき、神,かみの霊,れいはサウルの使者,ししゃたちにも臨,のぞんで、彼,かれらもまた預言,よげんした。","tok":[["サウル"],["は"],["、"],["ダビデ"],["を"],["捕らえる","とらえる"],["ため"],["に"],["、"],["使者","ししゃ"],["たち"],["を"],["つかわした"],["。"],["彼","かれ"],["ら"],["は"],["預言者","よげんしゃ"],["の"],["一群","いちぐん"],["が"],["預言","よげん"],["して"],["いて"],["、"],["サムエル"],["が"],["、"],["その"],["うち"],["の"],["、"],["かしら"],["と"],["なって"],["立って","たって"],["いる"],["の"],["を"],["見た","みた"],["が"],["、"],["その"],["時","とき"],["、"],["神","かみ"],["の"],["霊","れい"],["は"],["サウル"],["の"],["使者","ししゃ"],["たち"],["に"],["も"],["臨んで","のぞんで"],["、"],["彼","かれ"],["ら"],["も"],["また"],["預言","よげん"],["した"],["。"]]},{"verse":21,"text":"サウルは、このことを聞,きいて、他,たの使者,ししゃたちをつかわしたが、彼,かれらもまた預言,よげんした。サウルは三たび使者,ししゃたちをつかわしたが、彼,かれらもまた預言,よげんした。","tok":[["サウル"],["は"],["、"],["この"],["こと"],["を"],["聞いて","きいて"],["、"],["他","た"],["の"],["使者","ししゃ"],["たち"],["を"],["つかわした"],["が"],["、"],["彼","かれ"],["ら"],["も"],["また"],["預言","よげん"],["した"],["。"],["サウル"],["は"],["三","さん"],["たび"],["使者","ししゃ"],["たち"],["を"],["つかわした"],["が"],["、"],["彼","かれ"],["ら"],["も"],["また"],["預言","よげん"],["した"],["。"]]},{"verse":22,"text":"そこでサウルはみずからラマに行,いき、セクの大井戸,おおいどに着,ついた時,とき、問,とうて言,いった、「サムエルとダビデは、どこにおるか」。ひとりの人,ひとが答,こたえた、「彼,かれらはラマのナヨテにいます」。","tok":[["そこ"],["で"],["サウル"],["は"],["みずから"],["ラマ"],["に"],["行き","いき"],["、"],["セク"],["の"],["大井戸","おおいど"],["に"],["着いた","ついた"],["時","とき"],["、"],["問うて","とうて"],["言った","いった"],["、"],["「"],["サムエル"],["と"],["ダビデ"],["は"],["、"],["どこ"],["に"],["おる"],["か"],["」"],["。"],["ひとり"],["の"],["人","ひと"],["が"],["答","こたえ"],["た"],["、"],["「"],["彼","かれ"],["ら"],["は"],["ラマ"],["の"],["ナヨテ"],["に"],["います"],["」"],["。"]]},{"verse":23,"text":"そこでサウルはそこからラマのナヨテに行,いったが、神,かみの霊,れいはまた彼,かれにも臨,のぞんで、彼,かれはラマのナヨテに着,つくまで歩,あるきながら預言,よげんした。","tok":[["そこ"],["で"],["サウル"],["は"],["そこ"],["から"],["ラマ"],["の"],["ナヨテ"],["に"],["行った","いった"],["が"],["、"],["神","かみ"],["の"],["霊","れい"],["は"],["また"],["彼","かれ"],["に"],["も"],["臨んで","のぞんで"],["、"],["彼","かれ"],["は"],["ラマ"],["の"],["ナヨテ"],["に"],["着く","つく"],["まで"],["歩き","あるき"],["ながら"],["預言","よげん"],["した"],["。"]]},{"verse":24,"text":"そして彼,かれもまた着物,きものを脱,ぬいで、同,おなじようにサムエルの前,まえで預言,よげんし、一日,にち一夜,や、裸,はだかで倒,たおれ伏,ふしていた。人々,ひとびとが「サウルもまた預言者,よげんしゃたちのうちにいるのか」というのはこのためである。","tok":[["そして"],["彼","かれ"],["も"],["また"],["着物","きもの"],["を"],["脱いで","ぬいで"],["、"],["同じ","おなじ"],["よう"],["に"],["サムエル"],["の"],["前","まえ"],["で"],["預言","よげん"],["し"],["、"],["一","いち"],["日","にち"],["ち"],["一夜","や"],["、"],["裸","はだか"],["で"],["倒れ伏して","たおれふして"],["いた"],["。"],["人々","ひとびと"],["が"],["「"],["サウル"],["も"],["また"],["預言者","よげんしゃ"],["たち"],["の"],["うち"],["に"],["いる"],["の"],["か"],["」"],["と"],["いう"],["の"],["は"],["この"],["ため"],["で"],["ある"],["。"]]}]
[{"verse":1,"text":"さて人々,ひとびとはダビデに告,つげて言,いった、「ペリシテびとがケイラを攻,せめて、打,うち場,ばの穀物,こくもつをかすめています」。","tok":[["さて"],["人々","ひとびと"],["は"],["ダビデ"],["に"],["告","つげ"],["て"],["言った","いった"],["、"],["「"],["ペリシテ"],["びと"],["が"],["ケイラ"],["を"],["攻めて","せめて"],["、"],["打ち","うち"],["場","ば"],["の"],["穀物","こくもつ"],["を"],["かすめて"],["います"],["」"],["。"]]},{"verse":2,"text":"そこでダビデは主,しゅに問,とうて言,いった、「わたしが行,いって、このペリシテびとを撃,うちましょうか」。主,しゅはダビデに言,いわれた、「行,いってペリシテびとを撃,うち、ケイラを救,すくいなさい」。","tok":[["そこ"],["で"],["ダビデ"],["は"],["主に","しゅに"],["問うて","とうて"],["言った","いった"],["、"],["「"],["わたし"],["が"],["行って","いって"],["、"],["この"],["ペリシテ"],["びと"],["を"],["撃ちましょう","うちましょう"],["か"],["」"],["。"],["主","しゅ"],["は"],["ダビデ"],["に"],["言われた","いわれた"],["、"],["「"],["行って","いって"],["ペリシテ"],["びと"],["を"],["撃ち","うち"],["、"],["ケイラ"],["を"],["救い","すくい"],["なさい"],["」"],["。"]]},{"verse":3,"text":"しかしダビデの従者,じゅうしゃたちは彼,かれに言,いった、「われわれは、ユダのここにおってさえ、恐,おそれているのに、ましてケイラへ行,いって、ペリシテびとの軍,ぐんに当,あたることができましょうか」。","tok":[["しかし"],["ダビデ"],["の"],["従者","じゅうしゃ"],["たち"],["は"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["われわれ"],["は"],["、"],["ユダ"],["の"],["ここ"],["に"],["おって"],["さえ"],["、"],["恐れて","おそれて"],["いる"],["のに"],["、"],["まして"],["ケイラ"],["へ"],["行って","いって"],["、"],["ペリシテ"],["びと"],["の"],["軍","ぐん"],["に"],["当たる","あたる"],["こと"],["が"],["できましょう"],["か"],["」"],["。"]]},{"verse":4,"text":"ダビデが重,かさねて主,しゅに問,とうたところ、主,しゅは彼,かれに答,こたえて言,いわれた、「立,たって、ケイラへ下,くだりなさい。わたしはペリシテびとをあなたの手,てに渡,わたします」。","tok":[["ダビデ"],["が"],["重ねて","かさねて"],["主に","しゅに"],["問うた","とうた"],["ところ"],["、"],["主","しゅ"],["は"],["彼","かれ"],["に"],["答","こたえ"],["て"],["言われた","いわれた"],["、"],["「"],["立って","たって"],["、"],["ケイラ"],["へ"],["下","く"],["だり"],["なさい"],["。"],["わたし"],["は"],["ペリシテ"],["びと"],["を"],["あなた"],["の"],["手","て"],["に"],["渡","わたし"],["ます"],["」"],["。"]]},{"verse":5,"text":"ダビデとその従者,じゅうしゃたちはケイラへ行,いって、ペリシテびとと戦,たたかい、彼,かれらの家畜,かちくを奪,うばいとり、彼,かれらを多,おおく撃,うち殺,ころした。こうしてダビデはケイラの住民,じゅうみんを救,すくった。","tok":[["ダビデ"],["と"],["その"],["従者","じゅうしゃ"],["たち"],["は"],["ケイラ"],["へ"],["行って","いって"],["、"],["ペリシテ"],["びと"],["と"],["戦い","たたかい"],["、"],["彼","かれ"],["ら"],["の"],["家畜","かちく"],["を"],["奪いとり","うばいとり"],["、"],["彼","かれ"],["ら"],["を"],["多く","おおく"],["撃ち殺した","うちころした"],["。"],["こう"],["して"],["ダビデ"],["は"],["ケイラ"],["の"],["住民","じゅうみん"],["を"],["救った","すくった"],["。"]]},{"verse":6,"text":"アヒメレクの子,こアビヤタルは、ケイラにいるダビデのもとにのがれてきた時,とき、手,てにエポデをもって下,くだってきた。","tok":[["アヒメレク"],["の"],["子","こ"],["アビヤタル"],["は"],["、"],["ケイラ"],["に"],["いる"],["ダビデ"],["の"],["もと"],["に"],["のがれて"],["きた"],["時","とき"],["、"],["手","て"],["に"],["エポデ"],["を"],["もって"],["下って","くだって"],["きた"],["。"]]},{"verse":7,"text":"さてダビデのケイラにきたことがサウルに聞,きこえたので、サウルは言,いった、「神,かみはわたしの手,てに彼,かれをわたされた。彼,かれは門,もんと貫,かんの木,きのある町,まちにはいって、自分,じぶんで身,みを閉,とじこめたからである」。","tok":[["さて"],["ダビデ"],["の"],["ケイラ"],["に"],["きた"],["こと"],["が"],["サウル"],["に"],["聞こえた","きこえた"],["ので"],["、"],["サウル"],["は"],["言った","いった"],["、"],["「"],["神","かみ"],["は"],["わたし"],["の"],["手","て"],["に"],["彼","かれ"],["を"],["わたされた"],["。"],["彼","かれ"],["は"],["門","もん"],["と"],["貫の木","かんのき"],["の"],["ある"],["町","まち"],["に"],["はいって"],["、"],["自分","じぶん"],["で"],["身","み"],["を"],["閉じこめた","とじこめた"],["から"],["で"],["ある"],["」"],["。"]]},{"verse":8,"text":"そこでサウルはすべての民,たみを戦,たたかいに呼,よび集,あつめて、ケイラに下,くだり、ダビデとその従者,じゅうしゃを攻,せめ囲,かこもうとした。","tok":[["そこ"],["で"],["サウル"],["は"],["すべて"],["の"],["民","たみ"],["を"],["戦い","たたかい"],["に"],["呼び集めて","よびあつめて"],["、"],["ケイラ"],["に"],["下り","くだり"],["、"],["ダビデ"],["と"],["その"],["従者","じゅうしゃ"],["を"],["攻め囲もう","せめかこもう"],["と"],["した"],["。"]]},{"verse":9,"text":"ダビデはサウルが自分,じぶんに害,がいを加,くわえようとしているのを知,しって、祭司,さいしアビヤタルに言,いった、「エポデを持,もってきてください」。","tok":[["ダビデ"],["は"],["サウル"],["が"],["自分","じぶん"],["に"],["害","がい"],["を"],["加えよう","くわえよう"],["として"],["いる"],["の"],["を"],["知って","しって"],["、"],["祭司","さいし"],["アビヤタル"],["に"],["言った","いった"],["、"],["「"],["エポデ"],["を"],["持って","もって"],["きて"],["ください"],["」"],["。"]]},{"verse":10,"text":"そしてダビデは言,いった、「イスラエルの神,かみ、主,しゅよ、しもべはサウルがケイラにきて、わたしのために、この町,まちを滅,ほろぼそうとしていることを確,たしかに聞,ききました。","tok":[["そして"],["ダビデ"],["は"],["言った","いった"],["、"],["「"],["イスラエル"],["の"],["神","かみ"],["、"],["主","しゅ"],["よ"],["、"],["しもべ"],["は"],["サウル"],["が"],["ケイラ"],["に"],["きて"],["、"],["わたし"],["の"],["ため"],["に"],["、"],["この"],["町","まち"],["を"],["滅ぼそう","ほろぼそう"],["として"],["いる"],["こと"],["を"],["確か","たしか"],["に"],["聞","きき"],["ました"],["。"]]},{"verse":11,"text":"ケイラの人々,ひとびとはわたしを彼,かれの手,てに渡,わたすでしょうか。しもべの聞,きいたように、サウルは下,くだってくるでしょうか。イスラエルの神,かみ、主,しゅよ、どうぞ、しもべに告,つげてください」。主,しゅは言,いわれた、「彼,かれは下,くだって来,くる」。","tok":[["ケイラ"],["の"],["人々","ひとびと"],["は"],["わたし"],["を"],["彼","かれ"],["の"],["手","て"],["に"],["渡すでしょう","わたすでしょう"],["か"],["。"],["しもべ"],["の"],["聞いた","きいた"],["よう"],["に"],["、"],["サウル"],["は"],["下って","くだって"],["くるでしょう"],["か"],["。"],["イスラエル"],["の"],["神","かみ"],["、"],["主","しゅ"],["よ"],["、"],["どうぞ"],["、"],["しもべ"],["に"],["告","つげ"],["て"],["ください"],["」"],["。"],["主","しゅ"],["は"],["言われた","いわれた"],["、"],["「"],["彼","かれ"],["は"],["下って","くだって"],["来る","くる"],["」"],["。"]]},{"verse":12,"text":"ダビデは言,いった、「ケイラの人々,ひとびとはわたしと従者,じゅうしゃたちをサウルの手,てにわたすでしょうか」。主,しゅは言,いわれた、「彼,かれらはあなたがたを渡,わたすであろう」。","tok":[["ダビデ"],["は"],["言った","いった"],["、"],["「"],["ケイラ"],["の"],["人々","ひとびと"],["は"],["わたし"],["と"],["従者","じゅうしゃ"],["たち"],["を"],["サウル"],["の"],["手","て"],["に"],["わたすでしょう"],["か"],["」"],["。"],["主","しゅ"],["は"],["言われた","いわれた"],["、"],["「"],["彼","かれ"],["ら"],["は"],["あなた"],["がた"],["を"],["渡すで","わたすで"],["あろう"],["」"],["。"]]},{"verse":13,"text":"そこでダビデとその六百人,にんほどの従者,じゅうしゃたちは立,たって、ケイラを去,さり、いずこともなくさまよった。ダビデのケイラから逃,にげ去,さったことがサウルに聞,きこえたので、サウルは戦,たたかいに出,でることをやめた。","tok":[["そこ"],["で"],["ダビデ"],["と"],["その"],["六百人","にんほど"],["の"],["従者","じゅうしゃ"],["たち"],["は"],["立って","たって"],["、"],["ケイラ"],["を"],["去り","さり"],["、"],["いずこ"],["と"],["も"],["なく"],["さまよった"],["。"],["ダビデ"],["の"],["ケイラ"],["から"],["逃去","にげさっ"],["た"],["こと"],["が"],["サウル"],["に"],["聞こえた","きこえた"],["ので"],["、"],["サウル"],["は"],["戦い","たたかい"],["に"],["出る","でる"],["こと"],["を"],["やめた"],["。"]]},{"verse":14,"text":"ダビデは荒野,あらのにある要害,ようがいにおり、またジフの荒野,あらのの山地,さんちにおった。サウルは日々,ひびに彼,かれを尋,たずね求,もとめたが、神,かみは彼,かれをその手,てに渡,わたされなかった。","tok":[["ダビデ"],["は"],["荒野","あら"],["のに"],["ある"],["要害","ようがい"],["に"],["おり"],["、"],["また"],["ジフ"],["の"],["荒野","あらの"],["の"],["山地","さんち"],["に"],["おった"],["。"],["サウル"],["は"],["日々","ひび"],["に"],["彼","かれ"],["を"],["尋ね求めた","たずねもとめた"],["が"],["、"],["神","かみ"],["は"],["彼","かれ"],["を"],["その"],["手","て"],["に"],["渡されなかった","わたされなかった"],["。"]]},{"verse":15,"text":"さてダビデはサウルが自分,じぶんの命,いのちを求,もとめて出,でてきたので恐,おそれた。その時,ときダビデはジフの荒野,あらののホレシにいたが、","tok":[["さて"],["ダビデ"],["は"],["サウル"],["が"],["自分","じぶん"],["の"],["命","いのち"],["を"],["求めて","もとめて"],["出て","でて"],["きた"],["ので"],["恐れた","おそれた"],["。"],["その"],["時","とき"],["ダビデ"],["は"],["ジフ"],["の"],["荒野","あらの"],["の"],["ホレシ"],["に"],["いた"],["が"],["、"]]},{"verse":16,"text":"サウルの子,こヨナタンは立,たって、ホレシにいるダビデのもとに行,いき、神,かみによって彼,かれを力,ちからづけた。","tok":[["サウル"],["の"],["子","こ"],["ヨナタン"],["は"],["立って","たって"],["、"],["ホレシ"],["に"],["いる"],["ダビデ"],["の"],["もと"],["に"],["行き","いき"],["、"],["神","かみ"],["によって"],["彼","かれ"],["を"],["力づけた","ちからづけた"],["。"]]},{"verse":17,"text":"そしてヨナタンは彼,かれに言,いった、「恐,おそれるにはおよびません。父,ちちサウルの手,てはあなたに届,とどかないでしょう。あなたはイスラエルの王,おうとなり、わたしはあなたの次,つぎとなるでしょう。このことは父,ちちサウルも知,しっています」。","tok":[["そして"],["ヨナタン"],["は"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["恐れる","おそれる"],["に"],["は"],["およびません"],["。"],["父","ちち"],["サウル"],["の"],["手","て"],["は"],["あなた"],["に"],["届かないでしょう","とどかないでしょう"],["。"],["あなた"],["は"],["イスラエル"],["の"],["王","おう"],["と"],["なり"],["、"],["わたし"],["は"],["あなた"],["の"],["次","つぎ"],["と"],["なるでしょう"],["。"],["この"],["こと"],["は"],["父","ちち"],["サウル"],["も"],["知って","しって"],["います"],["」"],["。"]]},{"verse":18,"text":"こうして彼,かれらふたりは主,しゅの前,まえで契約,けいやくを結,むすび、ダビデはホレシにとどまり、ヨナタンは家,いえに帰,かえった。","tok":[["こう"],["して"],["彼","かれ"],["ら"],["ふたり"],["は"],["主","しゅ"],["の"],["前","まえ"],["で"],["契約","けいやく"],["を"],["結び","むすび"],["、"],["ダビデ"],["は"],["ホレシ"],["に"],["とどまり"],["、"],["ヨナタン"],["は"],["家","いえ"],["に"],["帰えった","かえった"],["。"]]},{"verse":19,"text":"その時,ときジフびとはギベアにいるサウルのもとに上,のぼって行,いき、そして言,いった、「ダビデは、荒野,あらのの南,みなみにあるハキラの丘,おかの上,うえのホレシの要害,ようがいに隠,かくれて、われわれと共,ともにいるではありませんか。","tok":[["その"],["時","とき"],["ジフ"],["び"],["と"],["は"],["ギベア"],["に"],["いる"],["サウル"],["の"],["もと"],["に"],["上って","のぼって"],["行き","いき"],["、"],["そして"],["言った","いった"],["、"],["「"],["ダビデ"],["は"],["、"],["荒野","あら"],["の"],["の"],["南","みなみ"],["に"],["ある"],["ハキラ"],["の"],["丘","おか"],["の"],["上","うえ"],["の"],["ホレシ"],["の"],["要害","ようがい"],["に"],["隠れて","かくれて"],["、"],["われわれ"],["と"],["共","とも"],["に"],["いるで"],["は"],["ありません"],["か"],["。"]]},{"verse":20,"text":"それゆえ王,おうよ、あなたが下,くだって行,いこうという望,のぞみのとおり、いま下,くだってきてください。われわれは彼,かれを王,おうの手,てに渡,わたします」。","tok":[["それ"],["ゆえ"],["王","おう"],["よ"],["、"],["あなた"],["が"],["下って","くだって"],["行こう","いこう"],["と"],["いう"],["望み","のぞみ"],["の"],["とおり"],["、"],["いま"],["下って","くだって"],["きて"],["ください"],["。"],["われわれ"],["は"],["彼","かれ"],["を"],["王","おう"],["の"],["手","て"],["に"],["渡","わたし"],["ます"],["」"],["。"]]},{"verse":21,"text":"サウルは言,いった、「あなたがたはわたしに同情,どうじょうを寄,よせてくれたのです。どうぞ主,しゅがあなたがたを祝福,しゅくふくされるように。","tok":[["サウル"],["は"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["わたし"],["に"],["同情","どうじょう"],["を"],["寄せて","よせて"],["くれた"],["の"],["です"],["。"],["どうぞ"],["主","しゅ"],["が"],["あなた"],["がた"],["を"],["祝福","しゅくふく"],["される"],["よう"],["に"],["。"]]},{"verse":22,"text":"あなたがたは行,いって、なお確,たしかめてください。彼,かれのよく行,いく所,ところとだれがそこで彼,かれを見,みたかを見,みきわめてください。人,ひとの語,かたるところによると、彼,かれはひじょうに悪賢,わるがしこいそうだ。","tok":[["あなた"],["がた"],["は"],["行って","いって"],["、"],["なお"],["確かめて","たしかめて"],["ください"],["。"],["彼","かれ"],["の"],["よく"],["行く","いく"],["所","ところ"],["と"],["だれ"],["が"],["そこ"],["で"],["彼","かれ"],["を"],["見た","みた"],["か"],["を"],["見きわめて","みきわめて"],["ください"],["。"],["人","ひと"],["の"],["語る","かたる"],["ところ"],["に"],["よる"],["と"],["、"],["彼","かれ"],["は"],["ひじょう"],["に"],["悪賢い","わるがしこい"],["そう"],["だ"],["。"]]},{"verse":23,"text":"それで、あなたがたは彼,かれが隠,かくれる隠,かくれ場所,ばしょをみな見,みきわめ、確,たしかな知,しらせをもってわたしの所,ところに帰,かえってきなさい。その時,ときわたしはあなたがたと共,ともに行,いきます。もし彼,かれがこの地,ちにいるならば、わたしはユダの氏族,しぞくをあまねく尋,たずねて彼,かれを捜,さがしだします」。","tok":[["それ"],["で"],["、"],["あなた"],["がた"],["は"],["彼","かれ"],["が"],["隠れる","かくれる"],["隠れ","かくれ"],["場所","ばしょ"],["を"],["みな"],["見きわめ","みきわめ"],["、"],["確か","たしか"],["な"],["知らせ","しらせ"],["を"],["もって"],["わたし"],["の"],["所","ところ"],["に"],["帰えって","かえって"],["き"],["なさい"],["。"],["その"],["時","とき"],["わたし"],["は"],["あなた"],["がた"],["と"],["共","とも"],["に"],["行きます","いきます"],["。"],["もし"],["彼","かれ"],["が"],["この"],["地","ち"],["に"],["いるならば"],["、"],["わたし"],["は"],["ユダ"],["の"],["氏族","しぞく"],["を"],["あまねく"],["尋ねて","たずねて"],["彼","かれ"],["を"],["捜しだします","さがしだします"],["」"],["。"]]},{"verse":24,"text":"彼,かれらは立,たって、サウルに先立,さきだってジフへ行,いった。さてダビデとその従者,じゅうしゃたちは荒野,あらのの南,みなみのアラバにあるマオンの荒野,あらのにいた。","tok":[["彼","かれ"],["ら"],["は"],["立って","たって"],["、"],["サウル"],["に"],["先立って","さきだって"],["ジフ"],["へ"],["行った","いった"],["。"],["さて"],["ダビデ"],["と"],["その"],["従者","じゅうしゃ"],["たち"],["は"],["荒野","あら"],["の"],["の"],["南","みなみ"],["の"],["アラバ"],["に"],["ある"],["マオン"],["の"],["荒野","あらの"],["に"],["いた"],["。"]]},{"verse":25,"text":"そしてサウルとその従者,じゅうしゃたちはきて彼,かれを捜,さがした。人々,ひとびとがこれをダビデに告,つげたので、ダビデはマオンの荒野,あらのにある岩,いわの所,ところへ下,くだって行,いった。サウルはこれを聞,きいて、マオンの荒野,あらのにきてダビデを追,おった。","tok":[["そして"],["サウル"],["と"],["その"],["従者","じゅうしゃ"],["たち"],["は"],["きて"],["彼","かれ"],["を"],["捜した","さがした"],["。"],["人々","ひとびと"],["が"],["これ"],["を"],["ダビデ"],["に"],["告","つげ"],["た"],["ので"],["、"],["ダビデ"],["は"],["マオン"],["の"],["荒野","あらの"],["に"],["ある"],["岩","いわ"],["の"],["所","ところ"],["へ"],["下って","くだって"],["行った","いった"],["。"],["サウル"],["は"],["これ"],["を"],["聞いて","きいて"],["、"],["マオン"],["の"],["荒野","あらの"],["に"],["きて"],["ダビデ"],["を"],["追った","おった"],["。"]]},{"verse":26,"text":"サウルは山,やまのこちら側,がわを行,いき、ダビデとその従者,じゅうしゃたちとは山,やまのむこう側,がわを行,おこなった。そしてダビデは急,いそいでサウルからのがれようとした。サウルとその従者,じゅうしゃたちが、ダビデとその従者,じゅうしゃたちを囲,かこんで捕,とらえようとしたからである。","tok":[["サウル"],["は"],["山","やま"],["の"],["こちら側","こちらがわ"],["を"],["行き","いき"],["、"],["ダビデ"],["と"],["その"],["従者","じゅうしゃ"],["たち"],["と"],["は"],["山","やま"],["の"],["むこう側","むこうがわ"],["を"],["行なった","おこなった"],["。"],["そして"],["ダビデ"],["は"],["急いで","いそいで"],["サウル"],["から"],["のがれよう"],["と"],["した"],["。"],["サウル"],["と"],["その"],["従者","じゅうしゃ"],["たち"],["が"],["、"],["ダビデ"],["と"],["その"],["従者","じゅうしゃ"],["たち"],["を"],["囲んで","かこんで"],["捕らえよう","とらえよう"],["と"],["した"],["から"],["で"],["ある"],["。"]]},{"verse":27,"text":"その時,とき、サウルの所,ところに、ひとりの使者,ししゃがきて言,いった、「ペリシテびとが国,くにを侵,おかしています。急,いそいできてください」。","tok":[["その"],["時","とき"],["、"],["サウル"],["の"],["所","ところ"],["に"],["、"],["ひとり"],["の"],["使者","ししゃ"],["が"],["きて"],["言った","いった"],["、"],["「"],["ペリシテ"],["びと"],["が"],["国","くに"],["を"],["侵して","おかして"],["います"],["。"],["急いで","いそいで"],["きて"],["ください"],["」"],["。"]]},{"verse":28,"text":"そこでサウルはダビデを追,おうことをやめて帰,かえり、行,いってペリシテびとに当,あたった。それで人々,ひとびとは、その所,ところを「のがれの岩,いわ」と名,なづけた。","tok":[["そこ"],["で"],["サウル"],["は"],["ダビデ"],["を"],["追う","おう"],["こと"],["を"],["やめて"],["帰えり","かえり"],["、"],["行って","いって"],["ペリシテ"],["びと"],["に"],["当たった","あたった"],["。"],["それ"],["で"],["人々","ひとびと"],["は"],["、"],["その"],["所","ところ"],["を"],["「"],["のがれ"],["の"],["岩","いわ"],["」"],["と"],["名づけた","なづけた"],["。"]]}]
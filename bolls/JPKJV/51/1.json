[{"verse":1,"text":"神,かみの御旨,みむねによるキリスト・イエスの使徒,しとパウロと兄弟,きょうだいテモテから、","tok":[["神","かみ"],["の"],["御旨","みむね"],["に"],["よる"],["キリスト"],["・"],["イエス"],["の"],["使徒","しと"],["パウロ"],["と"],["兄弟","きょうだい"],["テモテ"],["から"],["、"]]},{"verse":2,"text":"コロサイにいる、キリストにある聖徒,せいとたち、忠実,ちゅうじつな兄弟,きょうだいたちへ。わたしたちの父,ちちなる神,かみから、恵,めぐみと平安,へいあんとが、あなたがたにあるように。","tok":[["コロサイ"],["に"],["いる"],["、"],["キリスト"],["に"],["ある"],["聖徒","せいと"],["たち"],["、"],["忠実","ちゅうじつ"],["な"],["兄弟","きょうだい"],["たち"],["へ"],["。"],["わたしたち"],["の"],["父","ちち"],["なる"],["神","かみ"],["から"],["、"],["恵","めぐみ"],["と"],["平安","へいあん"],["と"],["が"],["、"],["あなた"],["がた"],["に"],["ある"],["よう"],["に"],["。"]]},{"verse":3,"text":"わたしたちは、いつもあなたがたのために祈,いのり、わたしたちの主,しゅイエス・キリストの父,ちちなる神,かみに感謝,かんしゃしている。","tok":[["わたしたち"],["は"],["、"],["いつも"],["あなた"],["がた"],["の"],["ため"],["に"],["祈","いのり"],["、"],["わたしたち"],["の"],["主","しゅ"],["イエス"],["・"],["キリスト"],["の"],["父","ちち"],["なる"],["神","かみ"],["に"],["感謝","かんしゃ"],["して"],["いる"],["。"]]},{"verse":4,"text":"これは、キリスト・イエスに対,たいするあなたがたの信仰,しんこうと、すべての聖徒,せいとに対,たいしていだいているあなたがたの愛,あいとを、耳,みみにしたからである。","tok":[["これ"],["は"],["、"],["キリスト"],["・"],["イエス"],["に"],["対する","たいする"],["あなた"],["がた"],["の"],["信仰","しんこう"],["と"],["、"],["すべて"],["の"],["聖徒","せいと"],["に対して","にたいして"],["いだいて"],["いる"],["あなた"],["がた"],["の"],["愛","あい"],["と"],["を"],["、"],["耳","みみ"],["に"],["した"],["から"],["で"],["ある"],["。"]]},{"verse":5,"text":"この愛,あいは、あなたがたのために天,てんにたくわえられている望,のぞみに基,もとづくものであり、その望,のぞみについては、あなたがたはすでに、あなたがたのところまで伝,つたえられた福音,ふくいんの真理,しんりの言葉,ことばによって聞,きいている。","tok":[["この"],["愛","あい"],["は"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["天","てん"],["に"],["たくわえられて"],["いる"],["望み","のぞみ"],["に"],["基づく","もとづく"],["もの"],["で"],["あり"],["、"],["その"],["望み","のぞみ"],["について"],["は"],["、"],["あなた"],["がた"],["は"],["すでに"],["、"],["あなた"],["がた"],["の"],["ところ"],["まで"],["伝えられた","つたえられた"],["福音","ふくいん"],["の"],["真理","しんり"],["の"],["言葉","ことば"],["によって"],["聞いて","きいて"],["いる"],["。"]]},{"verse":6,"text":"そして、この福音,ふくいんは、世界中,せかいじゅういたる所,ところでそうであるように、あなたがたのところでも、これを聞,きいて神,かみの恵,めぐみを知,しったとき以来,いらい、実,みを結,むすんで成長,せいちょうしているのである。","tok":[["そして"],["、"],["この"],["福音","ふくいん"],["は"],["、"],["世界中","せかいじゅう"],["いたる"],["所","ところ"],["で"],["そう"],["で"],["ある"],["よう"],["に"],["、"],["あなた"],["がた"],["の"],["ところ"],["で"],["も"],["、"],["これ"],["を"],["聞いて","きいて"],["神","かみ"],["の"],["恵","めぐみ"],["を"],["知った","しった"],["とき"],["以来","いらい"],["、"],["実","み"],["を"],["結んで","むすんで"],["成長","せいちょう"],["して"],["いる"],["ので"],["ある"],["。"]]},{"verse":7,"text":"あなたがたはこの福音,ふくいんを、わたしたちと同,おなじ僕,しもべである、愛,あいするエペフラスから学,まなんだのであった。彼,かれはあなたがたのためのキリストの忠実,ちゅうじつな奉仕者,ほうししゃであって、","tok":[["あなた"],["がた"],["は"],["この"],["福音","ふくいん"],["を"],["、"],["わたしたち"],["と"],["同じ","おなじ"],["僕","し"],["も"],["べ"],["で"],["ある"],["、"],["愛する","あいする"],["エペフラス"],["から"],["学","まなんだ"],["ので"],["あった"],["。"],["彼","かれ"],["は"],["あなた"],["がた"],["の"],["ため"],["の"],["キリスト"],["の"],["忠実","ちゅうじつ"],["な"],["奉仕者","ほうししゃ"],["で"],["あって"],["、"]]},{"verse":8,"text":"あなたがたが御霊,みたまによっていだいている愛,あいを、わたしたちに知,しらせてくれたのである。","tok":[["あなた"],["がた"],["が"],["御霊","みたま"],["によって"],["いだいて"],["いる"],["愛","あい"],["を"],["、"],["わたしたち"],["に"],["知らせて","しらせて"],["くれた"],["ので"],["ある"],["。"]]},{"verse":9,"text":"そういうわけで、これらの事,ことを耳,みみにして以来,いらい、わたしたちも絶,たえずあなたがたのために祈,いのり求,もとめているのは、あなたがたがあらゆる霊的,れいてきな知恵,ちえと理解力,りかいりょくとをもって、神,かみの御旨,みむねを深,ふかく知,しり、","tok":[["そう"],["いう"],["わけ"],["で"],["、"],["これ"],["ら"],["の"],["事","こと"],["を"],["耳","みみ"],["に"],["して"],["以来","いらい"],["、"],["わたしたち"],["も"],["絶えず","たえず"],["あなた"],["がた"],["の"],["ため"],["に"],["祈","いのり"],["求めて","もとめて"],["いる"],["の"],["は"],["、"],["あなた"],["がた"],["が"],["あらゆる"],["霊的","れいてき"],["な"],["知恵","ちえ"],["と"],["理解力","りかいりょく"],["と"],["を"],["もって"],["、"],["神","かみ"],["の"],["御旨","みむね"],["を"],["深く","ふかく"],["知り","しり"],["、"]]},{"verse":10,"text":"主,しゅのみこころにかなった生活,せいかつをして真,しんに主,しゅを喜,よろこばせ、あらゆる良,よいわざを行,おこなって実,みを結,むすび、神,かみを知,しる知識,ちしきをいよいよ増,まし加,くわえるに至,いたることである。","tok":[["主","しゅ"],["のみ"],["こころ"],["に"],["かなった"],["生活","せいかつ"],["を"],["して"],["真","しん"],["に"],["主","しゅ"],["を"],["喜こばせ","よろこばせ"],["、"],["あらゆる"],["良い","よい"],["わざ"],["を"],["行なって","おこなって"],["実","み"],["を"],["結び","むすび"],["、"],["神","かみ"],["を"],["知る","しる"],["知識","ちしき"],["を"],["いよいよ"],["増し加える","ましくわえる"],["に"],["至る","いたる"],["こと"],["で"],["ある"],["。"]]},{"verse":11,"text":"更,さらにまた祈,いのるのは、あなたがたが、神,かみの栄光,えいこうの勢,いきおいにしたがって賜,たまわるすべての力,ちからによって強,つよくされ、何事,なにごとも喜,よろこんで耐,たえかつ忍,しのび、","tok":[["更に","さらに"],["また"],["祈る","いのる"],["の"],["は"],["、"],["あなた"],["が"],["た"],["が"],["、"],["神","かみ"],["の"],["栄光","えいこう"],["の"],["勢い","いきおい"],["に"],["したがって"],["賜わる","たまわる"],["すべて"],["の"],["力","ちから"],["によって"],["強く","つよく"],["され"],["、"],["何事","なにごと"],["も"],["喜こんで","よろこんで"],["耐え","たえ"],["かつ"],["忍び","しのび"],["、"]]},{"verse":12,"text":"光,ひかりのうちにある聖徒,せいとたちの特権,とっけんにあずかるに足,たる者,ものとならせて下,くださった父,ちちなる神,かみに、感謝,かんしゃすることである。","tok":[["光","ひかり"],["の"],["うち"],["に"],["ある"],["聖徒","せいと"],["たち"],["の"],["特権","とっけん"],["に"],["あずかる"],["に"],["足る","たる"],["者","もの"],["と"],["ならせて"],["下さった","くださった"],["父","ちち"],["なる"],["神","かみ"],["に"],["、"],["感謝","かんしゃ"],["する"],["こと"],["で"],["ある"],["。"]]},{"verse":13,"text":"神,かみは、わたしたちをやみの力,ちからから救,すくい出,だして、その愛,あいする御子,みこの支配下,しはいかに移,うつして下,くださった。","tok":[["神","かみ"],["は"],["、"],["わたしたち"],["を"],["やみ"],["の"],["力","ちから"],["から"],["救い出して","すくいだして"],["、"],["その"],["愛する","あいする"],["御子","みこ"],["の"],["支配下","しはいか"],["に"],["移して","うつして"],["下さった","くださった"],["。"]]},{"verse":14,"text":"わたしたちは、この御子,みこによってあがない、すなわち、罪,つみのゆるしを受,うけているのである。","tok":[["わたしたち"],["は"],["、"],["この"],["御子","みこ"],["によって"],["あがない"],["、"],["すなわち"],["、"],["罪","つみ"],["の"],["ゆるし"],["を"],["受て","うけて"],["いる"],["ので"],["ある"],["。"]]},{"verse":15,"text":"御子,みこは、見,みえない神,かみのかたちであって、すべての造,つくられたものに先,さきだって生,うまれたかたである。","tok":[["御子","みこ"],["は"],["、"],["見えない","みえない"],["神","かみ"],["の"],["かたち"],["で"],["あって"],["、"],["すべて"],["の"],["造られた","つくられた"],["もの"],["に"],["先き","さき"],["だ"],["って"],["生まれた","うまれた"],["かた"],["で"],["ある"],["。"]]},{"verse":16,"text":"万物,ばんぶつは、天,てんにあるものも地,ちにあるものも、見,みえるものも見,みえないものも、位,くらいも主権,しゅけんも、支配,しはいも権威,けんいも、みな御子,みこにあって造,つくられたからである。これらいっさいのものは、御子,みこによって造,つくられ、御子,みこのために造,つくられたのである。","tok":[["万物","ばんぶつ"],["は"],["、"],["天","てん"],["に"],["ある"],["もの"],["も"],["地","ち"],["に"],["ある"],["もの"],["も"],["、"],["見える","みえる"],["もの"],["も"],["見えない","みえない"],["もの"],["も"],["、"],["位","くらい"],["も"],["主権","しゅけん"],["も"],["、"],["支配","しはい"],["も"],["権威","けんい"],["も"],["、"],["みな"],["御子","みこ"],["に"],["あって"],["造られた","つくられた"],["から"],["で"],["ある"],["。"],["これ"],["ら"],["いっさい"],["の"],["もの"],["は"],["、"],["御子","みこ"],["によって"],["造られ","つくられ"],["、"],["御子","みこ"],["の"],["ため"],["に"],["造られた","つくられた"],["ので"],["ある"],["。"]]},{"verse":17,"text":"彼,かれは万物,ばんぶつよりも先,さきにあり、万物,ばんぶつは彼,かれにあって成,なり立,たっている。","tok":[["彼","かれ"],["は"],["万物","ばんぶつ"],["より"],["も"],["先","さき"],["に"],["あり"],["、"],["万物","ばんぶつ"],["は"],["彼","かれ"],["に"],["あって"],["成り立って","なりたって"],["いる"],["。"]]},{"verse":18,"text":"そして自,みずからは、そのからだなる教会,きょうかいのかしらである。彼,かれは初,はじめの者,ものであり、死人,しにんの中,なかから最初,さいしょに生,うまれたかたである。それは、ご自身,じしんがすべてのことにおいて第,だい一の者,ものとなるためである。","tok":[["そして"],["自から","みずから"],["は"],["、"],["その"],["からだ"],["なる"],["教会","きょうかい"],["の"],["かしら"],["で"],["ある"],["。"],["彼","かれ"],["は"],["初め","はじめ"],["の"],["者","もの"],["で"],["あり"],["、"],["死人","しにん"],["の"],["中","なか"],["から"],["最初","さいしょ"],["に"],["生まれた","うまれた"],["かた"],["で"],["ある"],["。"],["それ"],["は"],["、"],["ご自身","ごじしん"],["が"],["すべて"],["の"],["こと"],["に"],["おいて"],["第","だい"],["一","いち"],["の"],["者","もの"],["と"],["なる"],["ため"],["で"],["ある"],["。"]]},{"verse":19,"text":"神,かみは、御旨,みむねによって、御子,みこのうちにすべての満,みちみちた徳,とくを宿,やどらせ、","tok":[["神","かみ"],["は"],["、"],["御旨","みむね"],["によって"],["、"],["御子","みこ"],["の"],["うち"],["に"],["すべて"],["の"],["満ちみちた","みちみちた"],["徳","とく"],["を"],["宿らせ","やどらせ"],["、"]]},{"verse":20,"text":"そして、その十字架,じゅうじかの血,ちによって平和,へいわをつくり、万物,ばんぶつ、すなわち、地,ちにあるもの、天,てんにあるものを、ことごとく、彼,かれによってご自分,じぶんと和解,わかいさせて下,くださったのである。","tok":[["そして"],["、"],["その"],["十字架","じゅうじか"],["の"],["血","ち"],["によって"],["平和","へいわ"],["を"],["つくり"],["、"],["万物","ばんぶつ"],["、"],["すなわち"],["、"],["地","ち"],["に"],["ある"],["もの"],["、"],["天","てん"],["に"],["ある"],["もの"],["を"],["、"],["ことごとく"],["、"],["彼","かれ"],["によって"],["ご自分","ごじぶん"],["と"],["和解","わかい"],["させて"],["下さった","くださった"],["ので"],["ある"],["。"]]},{"verse":21,"text":"あなたがたも、かつては悪,わるい行,おこないをして神,かみから離,はなれ、心,こころの中,なかで神,かみに敵対,てきたいしていた。","tok":[["あなた"],["がた"],["も"],["、"],["かつて"],["は"],["悪い","わるい"],["行ない","おこない"],["を"],["して"],["神","かみ"],["から"],["離れ","はなれ"],["、"],["心","こころ"],["の"],["中","なか"],["で"],["神","かみ"],["に"],["敵対","てきたい"],["して"],["いた"],["。"]]},{"verse":22,"text":"しかし今,いまでは、御子,みこはその肉,にくのからだにより、その死,しをとおして、あなたがたを神,かみと和解,わかいさせ、あなたがたを聖,せいなる、傷,きずのない、責,せめられるところのない者,ものとして、みまえに立,たたせて下,くださったのである。","tok":[["しかし"],["今","いま"],["で"],["は"],["、"],["御子","みこ"],["は"],["その"],["肉","にく"],["の"],["からだ"],["に"],["より"],["、"],["その"],["死","し"],["を"],["とおして"],["、"],["あなた"],["がた"],["を"],["神","かみ"],["と"],["和解","わかい"],["させ"],["、"],["あなた"],["がた"],["を"],["聖","せい"],["なる"],["、"],["傷","きず"],["の"],["ない"],["、"],["責","せめ"],["られる"],["ところ"],["の"],["ない"],["者","もの"],["として"],["、"],["みまえ"],["に"],["立たせて","たたせて"],["下さった","くださった"],["ので"],["ある"],["。"]]},{"verse":23,"text":"ただし、あなたがたは、ゆるぐことがなく、しっかりと信仰,しんこうにふみとどまり、すでに聞,きいている福音,ふくいんの望,のぞみから移,うつり行,いくことのないようにすべきである。この福音,ふくいんは、天,てんの下,したにあるすべての造,つくられたものに対,たいして宣,のべ伝,つたえられたものであって、それにこのパウロが奉仕,ほうししているのである。","tok":[["ただし"],["、"],["あなた"],["がた"],["は"],["、"],["ゆるぐ"],["こと"],["が"],["なく"],["、"],["しっかり"],["と"],["信仰","しんこう"],["に"],["ふみとどまり"],["、"],["すでに"],["聞いて","きいて"],["いる"],["福音","ふくいん"],["の"],["望み","のぞみ"],["から"],["移り行く","うつりいく"],["こと"],["の"],["ない"],["よう"],["に"],["すべきで"],["ある"],["。"],["この"],["福音","ふくいん"],["は"],["、"],["天","てん"],["の"],["下","した"],["に"],["ある"],["すべて"],["の"],["造られた","つくられた"],["もの"],["に対して","にたいして"],["宣べ伝えられた","のべつたえられた"],["もの"],["で"],["あって"],["、"],["それ"],["に"],["この"],["パウロ"],["が"],["奉仕","ほうし"],["して"],["いる"],["ので"],["ある"],["。"]]},{"verse":24,"text":"今,いまわたしは、あなたがたのための苦難,くなんを喜,よろこんで受,うけており、キリストのからだなる教会,きょうかいのために、キリストの苦,くるしみのなお足,たりないところを、わたしの肉体,にくたいをもって補,おぎなっている。","tok":[["今","いま"],["わたし"],["は"],["、"],["あなた"],["がた"],["の"],["ため"],["の"],["苦難","くなん"],["を"],["喜こんで","よろこんで"],["受けて","うけて"],["おり"],["、"],["キリスト"],["の"],["からだ"],["なる"],["教会","きょうかい"],["の"],["ため"],["に"],["、"],["キリスト"],["の"],["苦しみ","くるしみ"],["の"],["なお"],["足りない","たりない"],["ところ"],["を"],["、"],["わたし"],["の"],["肉体","にくたい"],["を"],["もって"],["補なって","おぎなって"],["いる"],["。"]]},{"verse":25,"text":"わたしは、神,かみの言,ことばを告,つげひろめる務,つとめを、あなたがたのために神,かみから与,あたえられているが、そのために教会,きょうかいに奉仕,ほうしする者,ものになっているのである。","tok":[["わたし"],["は"],["、"],["神","かみ"],["の"],["言","ことば"],["を"],["告","つげ"],["ひろめる"],["務め","つとめ"],["を"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["神","かみ"],["から"],["与えられて","あたえられて"],["いる"],["が"],["、"],["その"],["ため"],["に"],["教会","きょうかい"],["に"],["奉仕","ほうし"],["する"],["者","もの"],["に"],["なって"],["いる"],["ので"],["ある"],["。"]]},{"verse":26,"text":"その言,ことばの奥義,おくぎは、代々,よよにわたってこの世,よから隠,かくされていたが、今,いまや神,かみの聖徒,せいとたちに明,あきらかにされたのである。","tok":[["その"],["言","ことば"],["の"],["奥義","おくぎ"],["は"],["、"],["代々","よよ"],["に"],["わたって"],["この世","このよ"],["から"],["隠されて","かくされて"],["いた"],["が"],["、"],["今","いま"],["や"],["神","かみ"],["の"],["聖徒","せいと"],["たち"],["に"],["明か","あきらか"],["に"],["された"],["ので"],["ある"],["。"]]},{"verse":27,"text":"神,かみは彼,かれらに、異邦人,いほうじんの受,うくべきこの奥義,おくぎが、いかに栄光,えいこうに富,とんだものであるかを、知,しらせようとされたのである。この奥義,おくぎは、あなたがたのうちにいますキリストであり、栄光,えいこうの望,のぞみである。","tok":[["神","かみ"],["は"],["彼","かれ"],["ら"],["に"],["、"],["異邦人","いほうじん"],["の"],["受","うくべきこ"],["の"],["奥義","お"],["くぎ"],["が"],["、"],["いかに"],["栄光","えいこう"],["に"],["富","とんだも"],["ので"],["ある"],["か"],["を"],["、"],["知らせよう","しらせよう"],["と"],["された"],["ので"],["ある"],["。"],["この"],["奥義","おくぎ"],["は"],["、"],["あなた"],["がた"],["の"],["うち"],["に"],["います"],["キリスト"],["で"],["あり"],["、"],["栄光","えいこう"],["の"],["望み","のぞみ"],["で"],["ある"],["。"]]},{"verse":28,"text":"わたしたちはこのキリストを宣,のべ伝,つたえ、知恵,ちえをつくしてすべての人,ひとを訓戒,くんかいし、また、すべての人,ひとを教,おしえている。それは、彼,かれらがキリストにあって全,まったき者,ものとして立,たつようになるためである。","tok":[["わたしたち"],["は"],["この"],["キリスト"],["を"],["宣べ伝え","のべつたえ"],["、"],["知恵","ちえ"],["を"],["つくして"],["すべて"],["の"],["人","ひと"],["を"],["訓戒","くんかい"],["し"],["、"],["また"],["、"],["すべて"],["の"],["人","ひと"],["を"],["教えて","おしえて"],["いる"],["。"],["それ"],["は"],["、"],["彼","かれ"],["ら"],["が"],["キリスト"],["に"],["あって"],["全","ま"],["っ"],["たき者","たきもの"],["として"],["立つ","たつ"],["よう"],["に"],["なる"],["ため"],["で"],["ある"],["。"]]},{"verse":29,"text":"わたしはこのために、わたしのうちに力強,ちからづよく働,はたらいておられるかたの力,ちからにより、苦闘,くとうしながら努力,どりょくしているのである。","tok":[["わたし"],["は"],["この"],["ため"],["に"],["、"],["わたし"],["の"],["うち"],["に"],["力強く","ちからづよく"],["働いて","はたらいて"],["おられる"],["かた"],["の"],["力","ちから"],["に"],["より"],["、"],["苦闘","くとう"],["し"],["ながら"],["努力","どりょく"],["して"],["いる"],["ので"],["ある"],["。"]]}]
[{"verse":1,"text":"このように、あなたがたはキリストと共,ともによみがえらされたのだから、上,うえにあるものを求,もとめなさい。そこではキリストが神,かみの右,みぎに座,ざしておられるのである。","tok":[["この"],["よう"],["に"],["、"],["あなた"],["がた"],["は"],["キリスト"],["と"],["共","とも"],["に"],["よみがえらされた"],["の"],["だ"],["から"],["、"],["上","うえ"],["に"],["ある"],["もの"],["を"],["求め","もとめ"],["なさい"],["。"],["そこ"],["で"],["は"],["キリスト"],["が"],["神","かみ"],["の"],["右","みぎ"],["に"],["座して","ざして"],["おられる"],["ので"],["ある"],["。"]]},{"verse":2,"text":"あなたがたは上,うえにあるものを思,おもうべきであって、地上,ちじょうのものに心,こころを引,ひかれてはならない。","tok":[["あなた"],["がた"],["は"],["上","うえ"],["に"],["ある"],["もの"],["を"],["思うべきで","おもうべきで"],["あって"],["、"],["地上","ちじょう"],["の"],["もの"],["に"],["心","こころ"],["を"],["引かれて","ひかれて"],["は"],["ならない"],["。"]]},{"verse":3,"text":"あなたがたはすでに死,しんだものであって、あなたがたのいのちは、キリストと共,ともに神,かみのうちに隠,かくされているのである。","tok":[["あなた"],["がた"],["は"],["すでに"],["死んだ","しんだ"],["もの"],["で"],["あって"],["、"],["あなた"],["がた"],["の"],["いのち"],["は"],["、"],["キリスト"],["と"],["共","とも"],["に"],["神","かみ"],["の"],["うち"],["に"],["隠されて","かくされて"],["いる"],["ので"],["ある"],["。"]]},{"verse":4,"text":"わたしたちのいのちなるキリストが現,あらわれる時,ときには、あなたがたも、キリストと共,ともに栄光,えいこうのうちに現,あらわれるであろう。","tok":[["わたしたち"],["の"],["いのち"],["なる"],["キリスト"],["が"],["現われる","あらわれる"],["時","とき"],["に"],["は"],["、"],["あなた"],["がた"],["も"],["、"],["キリスト"],["と"],["共","とも"],["に"],["栄光","えいこう"],["の"],["うち"],["に"],["現われるで","あらわれるで"],["あろう"],["。"]]},{"verse":5,"text":"だから、地上,ちじょうの肢体,したい、すなわち、不品行,ふひんこう、汚,けがれ、情欲,じょうよく、悪,あく欲,よく、また貪欲,どんよくを殺,ころしてしまいなさい。貪欲,どんよくは偶像,ぐうぞう礼拝,れいはいにほかならない。","tok":[["だ"],["から"],["、"],["地上","ちじょう"],["の"],["肢体","したい"],["、"],["すなわち"],["、"],["不品行","ふひんこう"],["、"],["汚","け"],["がれ"],["、"],["情欲","じょうよく"],["、"],["悪く","あく"],["欲","よく"],["、"],["また"],["貪欲","どんよく"],["を"],["殺ろして","ころして"],["しまい"],["なさい"],["。"],["貪欲","どんよく"],["は"],["偶像","ぐうぞう"],["礼拝","れいはい"],["に"],["ほか"],["ならない"],["。"]]},{"verse":6,"text":"これらのことのために、神,かみの怒,いかりが下,くだるのである。","tok":[["これ"],["ら"],["の"],["こと"],["の"],["ため"],["に"],["、"],["神","かみ"],["の"],["怒り","いかり"],["が"],["下る","くだる"],["ので"],["ある"],["。"]]},{"verse":7,"text":"あなたがたも、以前,いぜんこれらのうちに日,ひを過,すごしていた時,ときには、これらのことをして歩,あるいていた。","tok":[["あなた"],["がた"],["も"],["、"],["以前","いぜん"],["これ"],["ら"],["の"],["うち"],["に"],["日","ひ"],["を"],["過ごして","すごして"],["いた"],["時","とき"],["に"],["は"],["、"],["これ"],["ら"],["の"],["こと"],["を"],["して"],["歩いて","あるいて"],["いた"],["。"]]},{"verse":8,"text":"しかし今,いまは、これらいっさいのことを捨,すて、怒,いかり、憤,いきどおり、悪意,あくい、そしり、口,くちから出,でる恥,はずべき言葉,ことばを、捨,すててしまいなさい。","tok":[["しかし"],["今","いま"],["は"],["、"],["これ"],["ら"],["いっさい"],["の"],["こと"],["を"],["捨て","すて"],["、"],["怒り","いかり"],["、"],["憤り","いきどおり"],["、"],["悪意","あくい"],["、"],["そしり"],["、"],["口","くち"],["から"],["出る","でる"],["恥ずべき","はずべき"],["言葉","ことば"],["を"],["、"],["捨てて","すてて"],["しまい"],["なさい"],["。"]]},{"verse":9,"text":"互,たがいにうそを言,いってはならない。あなたがたは、古,ふるき人,ひとをその行,おこないと一緒,いっしょに脱,ぬぎ捨,すて、","tok":[["互","たがい"],["に"],["うそ"],["を"],["言って","いって"],["は"],["ならない"],["。"],["あなた"],["がた"],["は"],["、"],["古き","ふるき"],["人","ひと"],["を"],["その"],["行ない","おこない"],["と"],["一緒","いっしょ"],["に"],["脱ぎ捨て","ぬぎすて"],["、"]]},{"verse":10,"text":"造,つくり主,しゅのかたちに従,したがって新,あたらしくされ、真,しんの知識,ちしきに至,いたる新,あたらしき人,ひとを着,きたのである。","tok":[["造主","つくりしゅ"],["の"],["かたち"],["に"],["従って","したがって"],["新らしく","あたらしく"],["され"],["、"],["真","しん"],["の"],["知識","ちしき"],["に"],["至る","いたる"],["新らしき","あたらしき"],["人","ひと"],["を"],["着た","きた"],["ので"],["ある"],["。"]]},{"verse":11,"text":"そこには、もはやギリシヤ人,じんとユダヤ人,じん、割礼,かつれいと無,む割礼,かつれい、未開,みかいの人,ひと、スクテヤ人,びと、奴隷,どれい、自由人,じゆうじんの差別,さべつはない。キリストがすべてであり、すべてのもののうちにいますのである。","tok":[["そこ"],["に"],["は"],["、"],["もはや"],["ギリシヤ"],["人","じん"],["と"],["ユダヤ人","ゆだやじん"],["、"],["割礼","かつれい"],["と"],["無","む"],["割礼","かつれい"],["、"],["未開","みかい"],["の"],["人","ひと"],["、"],["スクテヤ"],["人","び"],["と"],["、"],["奴隷","どれい"],["、"],["自由人","じゆうじん"],["の"],["差別","さべつ"],["は"],["ない"],["。"],["キリスト"],["が"],["すべて"],["で"],["あり"],["、"],["すべて"],["の"],["もの"],["の"],["うち"],["に"],["います"],["ので"],["ある"],["。"]]},{"verse":12,"text":"だから、あなたがたは、神,かみに選,えらばれた者,もの、聖,せいなる、愛,あいされている者,ものであるから、あわれみの心,こころ、慈愛,じあい、謙,けんそん、柔和,にゅうわ、寛容,かんようを身,みに着,つけなさい。","tok":[["だ"],["から"],["、"],["あなた"],["がた"],["は"],["、"],["神","かみ"],["に"],["選ら","えら"],["ばれた"],["者","もの"],["、"],["聖","せい"],["なる"],["、"],["愛されて","あいされて"],["いる"],["者","もの"],["で"],["ある"],["から"],["、"],["あわれみ"],["の"],["心","こころ"],["、"],["慈愛","じあい"],["、"],["謙そん","けんそん"],["、"],["柔和","にゅうわ"],["、"],["寛容","かんよう"],["を"],["身","み"],["に"],["着け","つけ"],["なさい"],["。"]]},{"verse":13,"text":"互,たがいに忍,しのびあい、もし互,たがいに責,せめむべきことがあれば、ゆるし合,あいなさい。主,しゅもあなたがたをゆるして下,くださったのだから、そのように、あなたがたもゆるし合,あいなさい。","tok":[["互","たがい"],["に"],["忍び","しのび"],["あい"],["、"],["もし"],["互","たがい"],["に"],["責","せめ"],["むべき"],["こと"],["が"],["あれば"],["、"],["ゆるし"],["合い","あい"],["なさい"],["。"],["主","しゅ"],["も"],["あなた"],["がた"],["を"],["ゆるして"],["下さった","くださった"],["の"],["だ"],["から"],["、"],["その"],["よう"],["に"],["、"],["あなた"],["がた"],["も"],["ゆるし"],["合い","あい"],["なさい"],["。"]]},{"verse":14,"text":"これらいっさいのものの上,うえに、愛,あいを加,くわえなさい。愛,あいは、すべてを完全,かんぜんに結,むすぶ帯,おびである。","tok":[["これ"],["ら"],["いっさい"],["の"],["もの"],["の"],["上","うえ"],["に"],["、"],["愛","あい"],["を"],["加え","くわえ"],["なさい"],["。"],["愛","あい"],["は"],["、"],["すべて"],["を"],["完全","かんぜん"],["に"],["結ぶ","むすぶ"],["帯","おび"],["で"],["ある"],["。"]]},{"verse":15,"text":"キリストの平和,へいわが、あなたがたの心,こころを支配,しはいするようにしなさい。あなたがたが召,めされて一体,いったいとなったのは、このためでもある。いつも感謝,かんしゃしていなさい。","tok":[["キリスト"],["の"],["平和","へいわ"],["が"],["、"],["あなた"],["がた"],["の"],["心","こころ"],["を"],["支配","しはい"],["する"],["よう"],["に"],["し"],["なさい"],["。"],["あなた"],["がた"],["が"],["召されて","めされて"],["一体","いったい"],["と"],["なった"],["の"],["は"],["、"],["この"],["ため"],["で"],["も"],["ある"],["。"],["いつも"],["感謝","かんしゃ"],["して"],["い"],["なさい"],["。"]]},{"verse":16,"text":"キリストの言葉,ことばを、あなたがたのうちに豊,ゆたかに宿,やどらせなさい。そして、知恵,ちえをつくして互,たがいに教,おしえまた訓戒,くんかいし、詩,しとさんびと霊,れいの歌,うたとによって、感謝,かんしゃして心,こころから神,かみをほめたたえなさい。","tok":[["キリスト"],["の"],["言葉","ことば"],["を"],["、"],["あなた"],["がた"],["の"],["うち"],["に"],["豊","ゆたか"],["に"],["宿らせ","やどらせ"],["なさい"],["。"],["そして"],["、"],["知恵","ちえ"],["を"],["つくして"],["互","たがい"],["に"],["教え","おしえ"],["また"],["訓戒","くんかい"],["し"],["、"],["詩","し"],["と"],["さん"],["びと"],["霊","れい"],["の"],["歌","うた"],["と"],["によって"],["、"],["感謝","かんしゃ"],["して"],["心","こころ"],["から"],["神","かみ"],["を"],["ほめたたえ"],["なさい"],["。"]]},{"verse":17,"text":"そして、あなたのすることはすべて、言葉,ことばによるとわざによるとを問,とわず、いっさい主,しゅイエスの名,なによってなし、彼,かれによって父,ちちなる神,かみに感謝,かんしゃしなさい。","tok":[["そして"],["、"],["あなた"],["の"],["する"],["こと"],["は"],["すべて"],["、"],["言葉","ことば"],["に"],["よる"],["と"],["わざ"],["に"],["よる"],["と"],["を"],["問わず","とわず"],["、"],["いっさい"],["主","しゅ"],["イエス"],["の"],["名","な"],["によって"],["なし"],["、"],["彼","かれ"],["によって"],["父","ちち"],["なる"],["神","かみ"],["に"],["感謝","かんしゃ"],["し"],["なさい"],["。"]]},{"verse":18,"text":"妻,つまたる者,ものよ、夫,おっとに仕,つかえなさい。それが、主,しゅにある者,ものにふさわしいことである。","tok":[["妻","つま"],["たる"],["者","もの"],["よ"],["、"],["夫","おっと"],["に"],["仕え","つかえ"],["なさい"],["。"],["それ"],["が"],["、"],["主に","しゅに"],["ある"],["者","もの"],["に"],["ふさわしい"],["こと"],["で"],["ある"],["。"]]},{"verse":19,"text":"夫,おっとたる者,ものよ、妻,つまを愛,あいしなさい。つらくあたってはいけない。","tok":[["夫","おっと"],["たる"],["者","もの"],["よ"],["、"],["妻","つま"],["を"],["愛し","あいし"],["なさい"],["。"],["つらく"],["あたって"],["は"],["いけない"],["。"]]},{"verse":20,"text":"子,こたる者,ものよ、何事,なにごとについても両親,りょうしんに従,したがいなさい。これが主,しゅに喜,よろこばれることである。","tok":[["子","こ"],["たる"],["者","もの"],["よ"],["、"],["何事","なにごと"],["について"],["も"],["両親","りょうしん"],["に"],["従い","したがい"],["なさい"],["。"],["これ"],["が"],["主に","しゅに"],["喜こばれる","よろこばれる"],["こと"],["で"],["ある"],["。"]]},{"verse":21,"text":"父,ちちたる者,ものよ、子供,こどもをいらだたせてはいけない。心,こころがいじけるかも知,しれないから。","tok":[["父","ちち"],["たる"],["者","もの"],["よ"],["、"],["子供","こども"],["を"],["いらだたせて"],["は"],["いけない"],["。"],["心","こころ"],["が"],["いじける"],["か"],["も"],["知れない","しれない"],["から"],["。"]]},{"verse":22,"text":"僕,しもべたる者,ものよ、何事,なにごとについても、肉,にくによる主人,しゅじんに従,したがいなさい。人,ひとにへつらおうとして、目先,めさきだけの勤,つとめをするのではなく、真心,まごころをこめて主,しゅを恐,おそれつつ、従,したがいなさい。","tok":[["僕","し"],["も"],["べ"],["たる"],["者","もの"],["よ"],["、"],["何事","なにごと"],["について"],["も"],["、"],["肉","にく"],["に"],["よる"],["主人","しゅじん"],["に"],["従い","したがい"],["なさい"],["。"],["人","ひと"],["に"],["へつらおう"],["として"],["、"],["目先","めさき"],["だけ"],["の"],["勤め","つとめ"],["を"],["する"],["ので"],["は"],["なく"],["、"],["真心","まごころ"],["を"],["こめて"],["主","しゅ"],["を"],["恐れ","おそれ"],["つつ"],["、"],["従い","したがい"],["なさい"],["。"]]},{"verse":23,"text":"何,なにをするにも、人,ひとに対,たいしてではなく、主,しゅに対,たいしてするように、心,こころから働,はたらきなさい。","tok":[["何に","なに"],["を"],["する"],["に"],["も"],["、"],["人","ひと"],["に対して","にたいして"],["で"],["は"],["なく"],["、"],["主に","しゅに"],["対して","たいして"],["する"],["よう"],["に"],["、"],["心","こころ"],["から"],["働らき","はたらき"],["なさい"],["。"]]},{"verse":24,"text":"あなたがたが知,しっているとおり、あなたがたは御国,みくにをつぐことを、報,むくいとして主,しゅから受,うけるであろう。あなたがたは、主,しゅキリストに仕,つかえているのである。","tok":[["あなた"],["がた"],["が"],["知って","しって"],["いる"],["とおり"],["、"],["あなた"],["がた"],["は"],["御国","みくに"],["を"],["つぐ"],["こと"],["を"],["、"],["報い","むくい"],["として"],["主ら","しゅから"],["受るで","うけるで"],["あろう"],["。"],["あなた"],["がた"],["は"],["、"],["主","しゅ"],["キリスト"],["に"],["仕えて","つかえて"],["いる"],["ので"],["ある"],["。"]]},{"verse":25,"text":"不正,ふせいを行,おこなう者,ものは、自分,じぶんの行,おこなった不正,ふせいに対,たいして報,むくいを受,うけるであろう。それには差別,さべつ扱,あつかいはない。","tok":[["不正","ふせい"],["を"],["行なう","おこなう"],["者","もの"],["は"],["、"],["自分","じぶん"],["の"],["行なった","おこなった"],["不正","ふせい"],["に対して","にたいして"],["報い","むくい"],["を"],["受るで","うけるで"],["あろう"],["。"],["それ"],["に"],["は"],["差別","さべつ"],["扱い","あつかい"],["は"],["ない"],["。"]]}]
[{"verse":1,"text":"またアカシヤ材,ざいで燔祭,はんさいの祭壇,さいだんを造,つくった。長,ながさ五キュビト、幅,はば五キュビトの四角,かくで、高,たかさは三キュビトである。","tok":[["また"],["アカシヤ"],["材","ざい"],["で"],["燔祭","はんさい"],["の"],["祭壇","さいだん"],["を"],["造った","つくった"],["。"],["長さ","ながさ"],["五","ご"],["キュビト"],["、"],["幅","はば"],["五","ご"],["キュビト"],["の"],["四角く","かく"],["で"],["、"],["高か","たか"],["さ"],["は"],["三","さん"],["キュビト"],["で"],["ある"],["。"]]},{"verse":2,"text":"その四すみの上,うえに、その一部,いちぶとし、それの角,つのを造,つくり、青銅,せいどうで祭壇,さいだんをおおった。","tok":[["その"],["四","よん"],["すみ"],["の"],["上","うえ"],["に"],["、"],["その"],["一部","いちぶ"],["と"],["し"],["、"],["それ"],["の"],["角","つ"],["の"],["を"],["造","つくり"],["、"],["青銅","せいどう"],["で"],["祭壇","さいだん"],["を"],["おおった"],["。"]]},{"verse":3,"text":"また祭壇,さいだんのもろもろの器,うつわ、すなわち、つぼ、十能,じゅうのう、鉢,はち、肉,にく叉,また、火皿,ひざらを造,つくった。そのすべての器,うつわを青銅,せいどうで造,つくった。","tok":[["また"],["祭壇","さいだん"],["の"],["もろもろ"],["の"],["器","うつわ"],["、"],["すなわち"],["、"],["つぼ"],["、"],["十能","じゅうのう"],["、"],["鉢","は"],["ち"],["、"],["肉叉","にくまた"],["、"],["火皿","ひざら"],["を"],["造った","つくった"],["。"],["その"],["すべて"],["の"],["器","うつわ"],["を"],["青銅","せいどう"],["で"],["造った","つくった"],["。"]]},{"verse":4,"text":"また祭壇,さいだんのために、青銅,せいどうの網,あみ細工,ざいくの格子,こうしを造,つくり、これを祭壇,さいだんの出張,でばりの下,したに取,とりつけて、祭壇,さいだんの高,たかさの半,なかばに達,たっするようにした。","tok":[["また"],["祭壇","さいだん"],["の"],["ため"],["に"],["、"],["青銅","せいどう"],["の"],["網","あみ"],["細工","ざいく"],["の"],["格子","こうし"],["を"],["造","つくり"],["、"],["これ"],["を"],["祭壇","さいだん"],["の"],["出張り","でばり"],["の"],["下","した"],["に"],["取","とり"],["つけて"],["、"],["祭壇","さいだん"],["の"],["高さ","たかさ"],["の"],["半ば","なかば"],["に"],["達する","たっする"],["よう"],["に"],["した"],["。"]]},{"verse":5,"text":"また青銅,せいどうの格子,こうしの四すみのために、環,かん四つを鋳,いて、さおを通,とおす所,ところとした。","tok":[["また"],["青銅","せいどう"],["の"],["格子","こうし"],["の"],["四","よん"],["すみ"],["の"],["ため"],["に"],["、"],["環","かん"],["四","よん"],["つ"],["を"],["鋳て","いて"],["、"],["さお"],["を"],["通す","とおす"],["所","ところ"],["と"],["した"],["。"]]},{"verse":6,"text":"アカシヤ材,ざいで、そのさおを造,つくり、青銅,せいどうでこれをおおい、","tok":[["アカシヤ"],["材","ざい"],["で"],["、"],["その"],["さお"],["を"],["造","つくり"],["、"],["青銅","せいどう"],["で"],["これ"],["を"],["おおい"],["、"]]},{"verse":7,"text":"そのさおを祭壇,さいだんの両側,りょうがわにある環,かんに通,とおして、それをかつぐようにした。祭壇,さいだんは板,いたをもって、空洞,くうどうに造,つくった。","tok":[["その"],["さお"],["を"],["祭壇","さいだん"],["の"],["両側","りょうがわ"],["に"],["ある"],["環","かん"],["に"],["通して","とおして"],["、"],["それ"],["を"],["かつぐ"],["よう"],["に"],["した"],["。"],["祭壇","さいだん"],["は"],["板","いた"],["を"],["もって"],["、"],["空洞","くうどう"],["に"],["造った","つくった"],["。"]]},{"verse":8,"text":"また洗盤,せんばんと、その台,だいを青銅,せいどうで造,つくった。すなわち会見,かいけんの幕屋,まくやの入口,いりぐちで務,つとめをなす女,おんなたちの鏡,かがみをもって造,つくった。","tok":[["また"],["洗","あらい"],["盤","ばん"],["と"],["、"],["その"],["台","だい"],["を"],["青銅","せいどう"],["で"],["造った","つくった"],["。"],["すなわち"],["会見","かいけん"],["の"],["幕屋","まくや"],["の"],["入口","いりぐち"],["で"],["務め","つとめ"],["を"],["なす"],["女","おんな"],["たち"],["の"],["鏡","かがみ"],["を"],["もって"],["造った","つくった"],["。"]]},{"verse":9,"text":"また庭,にわを造,つくった。その南側,みなみがわのために百キュビトの亜麻,あまの撚糸,ねんしの庭,にわのあげばりを設,もうけた。","tok":[["また"],["庭","にわ"],["を"],["造った","つくった"],["。"],["その"],["南側","みなみがわ"],["の"],["ため"],["に"],["百","ひゃく"],["キュビト"],["の"],["亜麻","あま"],["の"],["撚糸","ねんし"],["の"],["庭","にわ"],["の"],["あげ"],["ばり"],["を"],["設けた","もうけた"],["。"]]},{"verse":10,"text":"その柱,はしらは二十、その柱,はしらの二十の座,ざは青銅,せいどうで、その柱,はしらの鉤,こまと桁,けたは銀,ぎんとした。","tok":[["その"],["柱","はしら"],["は"],["二十","にじゅう"],["、"],["その"],["柱","はしら"],["の"],["二十","にじゅう"],["の"],["座","ざ"],["は"],["青銅","せいどう"],["で"],["、"],["その"],["柱","はしら"],["の"],["鉤","こま"],["と"],["桁","けた"],["は"],["銀","ぎん"],["と"],["した"],["。"]]},{"verse":11,"text":"また北側,きたがわのためにも百キュビトのあげばりを設,もうけた。その柱,はしら二十、その柱,はしらの二十の座,ざは青銅,せいどうで、その柱,はしらの鉤,こまと桁,けたは銀,ぎんとした。","tok":[["また"],["北側","きたがわ"],["の"],["ため"],["に"],["も"],["百","ひゃく"],["キュビト"],["の"],["あげ"],["ばり"],["を"],["設けた","もうけた"],["。"],["その"],["柱","はしら"],["二十","にじゅう"],["、"],["その"],["柱","はしら"],["の"],["二十","にじゅう"],["の"],["座","ざ"],["は"],["青銅","せいどう"],["で"],["、"],["その"],["柱","はしら"],["の"],["鉤","こま"],["と"],["桁","けた"],["は"],["銀","ぎん"],["と"],["した"],["。"]]},{"verse":12,"text":"また西側,にしがわのために、五十キュビトのあげばりを設,もうけた。その柱,はしらは十、その座,ざも十で、その柱,はしらの鉤,こまと桁,けたは銀,ぎんとした。","tok":[["また"],["西側","にしがわ"],["の"],["ため"],["に"],["、"],["五十","ごじゅう"],["キュビト"],["の"],["あげ"],["ばり"],["を"],["設けた","もうけた"],["。"],["その"],["柱","はしら"],["は"],["十","じゅう"],["、"],["その"],["座","ざ"],["も"],["十","じゅう"],["で"],["、"],["その"],["柱","はしら"],["の"],["鉤","こま"],["と"],["桁","けた"],["は"],["銀","ぎん"],["と"],["した"],["。"]]},{"verse":13,"text":"また東側,ひがしがわのためにも、五十キュビトのあげばりを設,もうけた。","tok":[["また"],["東側","ひがしがわ"],["の"],["ため"],["に"],["も"],["、"],["五十","ごじゅう"],["キュビト"],["の"],["あげ"],["ばり"],["を"],["設けた","もうけた"],["。"]]},{"verse":14,"text":"その一方,いっぽうに十五キュビトのあげばりを設,もうけた。その柱,はしらは三つ、その座,ざも三つ。","tok":[["その"],["一方","いっぽう"],["に"],["十五","じゅうご"],["キュビト"],["の"],["あげ"],["ばり"],["を"],["設けた","もうけた"],["。"],["その"],["柱","はしら"],["は"],["三","みっ"],["つ"],["、"],["その"],["座","ざ"],["も"],["三","みっ"],["つ"],["。"]]},{"verse":15,"text":"また他,たの一方,いっぽうにも、同,おなじようにした。すなわち庭,にわの門,もんのこなたかなたともに、十五キュビトのあげばりを設,もうけた。その柱,はしらは三つ、その座,ざも三つ。","tok":[["また"],["他","た"],["の"],["一方","いっぽう"],["に"],["も"],["、"],["同じ","おなじ"],["よう"],["に"],["した"],["。"],["すなわち"],["庭","にわ"],["の"],["門","もん"],["の"],["こなた"],["か"],["な"],["た"],["とも"],["に"],["、"],["十五","じゅうご"],["キュビト"],["の"],["あげ"],["ばり"],["を"],["設けた","もうけた"],["。"],["その"],["柱","はしら"],["は"],["三","みっ"],["つ"],["、"],["その"],["座","ざ"],["も"],["三","みっ"],["つ"],["。"]]},{"verse":16,"text":"庭,にわの周囲,しゅういのあげばりはみな亜麻,あまの撚糸,ねんしである。","tok":[["庭","にわ"],["の"],["周囲","しゅうい"],["の"],["あげ"],["ばり"],["は"],["みな"],["亜麻","あま"],["の"],["撚糸","ねんし"],["で"],["ある"],["。"]]},{"verse":17,"text":"柱,はしらの座,ざは青銅,せいどう、柱,はしらの鉤,こまと桁,けたとは銀,ぎん、柱,はしらの頭,あたまのおおいも銀,ぎんである。庭,にわの柱,はしらはみな銀,ぎんの桁,けたで連,つらねた。","tok":[["柱","はしら"],["の"],["座","ざ"],["は"],["青銅","せいどう"],["、"],["柱","はしら"],["の"],["鉤","こま"],["と"],["桁","けた"],["と"],["は"],["銀","ぎん"],["、"],["柱","はしら"],["の"],["頭","あたま"],["の"],["おおい"],["も"],["銀","ぎん"],["で"],["ある"],["。"],["庭","にわ"],["の"],["柱","はしら"],["は"],["みな"],["銀","ぎん"],["の"],["桁","けた"],["で"],["連ねた","つらねた"],["。"]]},{"verse":18,"text":"庭,にわの門,もんのとばりは青,あお糸,いと、紫,むらさき糸,いと、緋,ひ糸,いと、亜麻,あまの撚糸,ねんしで、色,いろとりどりに織,おったものであった。長,ながさは二十キュビト、幅,はばなる高,たかさは五キュビトで、庭,にわのあげばりと等,ひとしかった。","tok":[["庭","にわ"],["の"],["門","もん"],["の"],["とばり"],["は"],["青糸","あおいと"],["、"],["紫糸","むらさきいと"],["、"],["緋","ひ"],["糸","いと"],["、"],["亜麻","あま"],["の"],["撚糸","ねんし"],["で"],["、"],["色","いろ"],["とりどり"],["に"],["織った","おった"],["もの"],["で"],["あった"],["。"],["長さ","ながさ"],["は"],["二十","にじゅう"],["キュビト"],["、"],["幅","はば"],["なる"],["高か","たか"],["さ"],["は"],["五","ご"],["キュビト"],["で"],["、"],["庭","にわ"],["の"],["あげ"],["ばり"],["と"],["等かった","ひとしかった"],["。"]]},{"verse":19,"text":"その柱,はしらは四つ、その座,ざも四つで、ともに青銅,せいどう。その鉤,こまは銀,ぎん、柱,はしらの頭,あたまのおおいと桁,けたは銀,ぎんである。","tok":[["その"],["柱","はしら"],["は"],["四","よん"],["つ"],["、"],["その"],["座","ざ"],["も"],["四","よん"],["つ"],["で"],["、"],["とも"],["に"],["青銅","せいどう"],["。"],["その"],["鉤","こま"],["は"],["銀","ぎん"],["、"],["柱","はしら"],["の"],["頭","あたま"],["の"],["おおい"],["と"],["桁","けた"],["は"],["銀","ぎん"],["で"],["ある"],["。"]]},{"verse":20,"text":"ただし、幕屋,まくやおよび、その周囲,しゅういの庭,にわの釘,くぎはみな青銅,せいどうであった。","tok":[["ただし"],["、"],["幕屋","まくや"],["および"],["、"],["その"],["周囲","しゅうい"],["の"],["庭","にわ"],["の"],["釘","くぎ"],["は"],["みな"],["青銅","せいどう"],["で"],["あった"],["。"]]},{"verse":21,"text":"幕屋,まくや、すなわちあかしの幕屋,まくやに用,もちいた物,ものの総計,そうけいは次,つぎのとおりである。すなわちモーセの命,いのちに従,したがい、祭司,さいしアロンの子,こイタマルがレビびとを用,もちいて量,はかったものである。","tok":[["幕屋","まくや"],["、"],["すなわち"],["あかし"],["の"],["幕屋","まくや"],["に"],["用いた","もちいた"],["物","もの"],["の"],["総計","そうけい"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["すなわち"],["モーセ"],["の"],["命","いのち"],["に"],["従い","したがい"],["、"],["祭司","さいし"],["アロン"],["の"],["子","こ"],["イタマル"],["が"],["レビ"],["びと"],["を"],["用いて","もちいて"],["量った","はかった"],["もの"],["で"],["ある"],["。"]]},{"verse":22,"text":"ユダの部族,ぶぞくに属,ぞくするホルの子,こなるウリの子,こベザレルは、主,しゅがモーセに命,めいじられた事,ことをことごとくした。","tok":[["ユダ"],["の"],["部族","ぶぞく"],["に"],["属する","ぞくする"],["ホル"],["の"],["子","こ"],["なる"],["ウリ"],["の"],["子","こ"],["ベザレル"],["は"],["、"],["主","しゅ"],["が"],["モーセ"],["に"],["命じられた","めいじられた"],["事","こと"],["を"],["ことごとく"],["した"],["。"]]},{"verse":23,"text":"ダンの部族,ぶぞくに属,ぞくするアヒサマクの子,こアホリアブは彼,かれと共,ともにあって彫刻,ちょうこく、浮,うき織,おりをなし、また青,あお糸,いと、紫,むらさき糸,いと、緋,ひ糸,いと、亜麻,あま糸,いとで、縫取,ぬいとりをする者,ものであった。","tok":[["ダン"],["の"],["部族","ぶぞく"],["に"],["属する","ぞくする"],["アヒサマク"],["の"],["子","こ"],["アホリアブ"],["は"],["彼","かれ"],["と"],["共","とも"],["に"],["あって"],["彫刻","ちょうこく"],["、"],["浮織","うきおり"],["を"],["なし"],["、"],["また"],["青糸","あおいと"],["、"],["紫糸","むらさきいと"],["、"],["緋","ひ"],["糸","いと"],["、"],["亜麻","あま"],["糸","いと"],["で"],["、"],["縫","ぬい"],["取","とり"],["を"],["する"],["者","もの"],["で"],["あった"],["。"]]},{"verse":24,"text":"聖所,せいじょのもろもろの工作,こうさくに用,もちいたすべての金,きん、すなわち、ささげ物,ものなる金,きんは聖所,せいじょのシケルで、二十九タラント七百三十シケルであった。","tok":[["聖","せい"],["所","しょ"],["の"],["もろもろ"],["の"],["工作","こうさく"],["に"],["用いた","もちいた"],["すべて"],["の"],["金","きん"],["、"],["すなわち"],["、"],["ささげ物","ささげもの"],["なる"],["金","きん"],["は"],["聖","せい"],["所","しょ"],["の"],["シケル"],["で"],["、"],["二十九","にじゅうきゅう"],["タラント"],["七百三十","ななひゃくさんじゅう"],["シケル"],["で"],["あった"],["。"]]},{"verse":25,"text":"会衆,かいしゅうのうちの数,かぞえられた者,もののささげた銀,ぎんは聖所,せいじょのシケルで、百タラント千七百七十五シケルであった。","tok":[["会衆","かいしゅう"],["の"],["うち"],["の"],["数えられた","かぞえられた"],["者","もの"],["の"],["ささげた"],["銀","ぎん"],["は"],["聖","せい"],["所","しょ"],["の"],["シケル"],["で"],["、"],["百","ひゃく"],["タラント"],["千七百七十五","せんななひゃくななじゅうご"],["シケル"],["で"],["あった"],["。"]]},{"verse":26,"text":"これはひとり当,あたり一ベカ、すなわち聖所,せいじょのシケルの半,はんシケルであって、すべて二十歳,さい以上,いじょうで数,かぞえられた者,ものが六十万三千五百五十人,にんであったからである。","tok":[["これ"],["は"],["ひとり"],["当たり","あたり"],["一","いち"],["ベカ"],["、"],["すなわち"],["聖","せい"],["所","しょ"],["の"],["シケル"],["の"],["半","はん"],["シケル"],["で"],["あって"],["、"],["すべて"],["二十歳","さ"],["い"],["以上","いじょう"],["で"],["数えられた","かぞえられた"],["者","もの"],["が"],["六十万三千五百五","ろくじゅうまんさんせんごひゃくご"],["十人","じゅうにん"],["ら"],["で"],["ある"],["。"]]},{"verse":27,"text":"聖所,せいじょの座,ざと垂幕,たれまくの座,ざとを鋳,いるために用,もちいた銀,ぎんは百タラントであった。すなわち百座,ざにつき百タラント、一座,ざにつき一タラントである。","tok":[["聖","せい"],["所","しょ"],["の"],["座","ざ"],["と"],["垂幕","たれまく"],["の"],["座","ざ"],["と"],["を"],["鋳る","いる"],["ため"],["に"],["用いた","もちいた"],["銀","ぎん"],["は"],["百","ひゃく"],["タラント"],["で"],["あった"],["。"],["すなわち"],["百座","ざ"],["に"],["つき"],["百","ひゃく"],["タラント"],["、"],["一座","ざ"],["に"],["つき"],["一","いち"],["タラント"],["で"],["ある"],["。"]]},{"verse":28,"text":"また千七百七十五シケルで柱,はしらの鉤,こまを造,つくり、また柱,はしらの頭,あたまをおおい、柱,はしらのために桁,けたを造,つくった。","tok":[["また"],["千七百七十五","せんななひゃくななじゅうご"],["シケル"],["で"],["柱","はしら"],["の"],["鉤","こま"],["を"],["造","つくり"],["、"],["また"],["柱","はしら"],["の"],["頭","あたま"],["を"],["おおい"],["、"],["柱","はしら"],["の"],["ため"],["に"],["桁","けた"],["を"],["造った","つくった"],["。"]]},{"verse":29,"text":"ささげ物,ものなる青銅,せいどうは七十タラント二千四百シケルであった。","tok":[["ささげ物","ささげもの"],["なる"],["青銅","せいどう"],["は"],["七十","ななじゅう"],["タラント"],["二千四百","にせんよんひゃく"],["シケル"],["で"],["あった"],["。"]]},{"verse":30,"text":"これを用,もちいて会見,かいけんの幕屋,まくやの入口,いりぐちの座,ざ、青銅,せいどうの祭壇,さいだんと、それにつく青銅,せいどうの格子,こうし、および祭壇,さいだんのもろもろの器,うつわを造,つくった。","tok":[["これ"],["を"],["用いて","もちいて"],["会見","かいけん"],["の"],["幕屋","まくや"],["の"],["入口","いりぐち"],["の"],["座","ざ"],["、"],["青銅","せいどう"],["の"],["祭壇","さいだん"],["と"],["、"],["それ"],["に"],["つく"],["青銅","せいどう"],["の"],["格子","こうし"],["、"],["および"],["祭壇","さいだん"],["の"],["もろもろ"],["の"],["器","うつわ"],["を"],["造った","つくった"],["。"]]},{"verse":31,"text":"また庭,にわの周囲,しゅういの座,ざ、庭,にわの門,もんの座,ざ、および幕屋,まくやのもろもろの釘,くぎと、庭,にわの周囲,しゅういのもろもろの釘,くぎを造,つくった。","tok":[["また"],["庭","にわ"],["の"],["周囲","しゅうい"],["の"],["座","ざ"],["、"],["庭","にわ"],["の"],["門","もん"],["の"],["座","ざ"],["、"],["および"],["幕屋","まくや"],["の"],["もろもろ"],["の"],["釘","くぎ"],["と"],["、"],["庭","にわ"],["の"],["周囲","しゅうい"],["の"],["もろもろ"],["の"],["釘","くぎ"],["を"],["造った","つくった"],["。"]]}]
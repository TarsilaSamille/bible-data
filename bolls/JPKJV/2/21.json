[{"verse":1,"text":"これはあなたが彼,かれらの前,まえに示,しめすべきおきてである。","tok":[["これ"],["は"],["あなた"],["が"],["彼","かれ"],["ら"],["の"],["前","まえ"],["に"],["示めすべき","しめすべき"],["おきて"],["で"],["ある"],["。"]]},{"verse":2,"text":"あなたがヘブルびとである奴隷,どれいを買,かう時,ときは、六年,ねんのあいだ仕,つかえさせ、七年,ねん目,めには無償,むしょうで自由,じゆうの身,みとして去,さらせなければならない。","tok":[["あなた"],["が"],["ヘブル"],["びと"],["で"],["ある"],["奴隷","どれい"],["を"],["買う","かう"],["時","とき"],["は"],["、"],["六","ろく"],["年","ねん"],["の"],["あいだ"],["仕えさせ","つかえさせ"],["、"],["七","なな"],["年目","年め"],["に"],["は"],["無償","むしょう"],["で"],["自由","じゆう"],["の"],["身","み"],["として"],["去らせなければ","さらせなければ"],["ならない"],["。"]]},{"verse":3,"text":"彼,かれがもし独身,どくしんできたならば、独身,どくしんで去,さらなければならない。もし妻,つまを持,もっていたならば、その妻,つまは彼,かれと共,ともに去,さらなければならない。","tok":[["彼","かれ"],["が"],["もし"],["独身","どくしん"],["できたならば"],["、"],["独身","どくしん"],["で"],["去らなければ","さらなければ"],["ならない"],["。"],["もし"],["妻","つま"],["を"],["持って","もって"],["いたならば"],["、"],["その"],["妻","つま"],["は"],["彼","かれ"],["と"],["共","とも"],["に"],["去らなければ","さらなければ"],["ならない"],["。"]]},{"verse":4,"text":"もしその主人,しゅじんが彼,かれに妻,つまを与,あたえて、彼,かれに男,おとこの子,こまた女,おんなの子,こを産,うんだならば、妻,つまとその子,こ供,ともは主人,しゅじんのものとなり、彼,かれは独身,どくしんで去,さらなければならない。","tok":[["もし"],["その"],["主人","しゅじん"],["が"],["彼","かれ"],["に"],["妻","つま"],["を"],["与","あたえ"],["て"],["、"],["彼","かれ"],["に"],["男の子","おとこのこ"],["また"],["女の子","おんなのこ"],["を"],["産んだならば","うんだならば"],["、"],["妻","つま"],["と"],["その"],["子供","ことも"],["は"],["主人","しゅじん"],["の"],["もの"],["と"],["なり"],["、"],["彼","かれ"],["は"],["独身","どくしん"],["で"],["去らなければ","さらなければ"],["ならない"],["。"]]},{"verse":5,"text":"奴隷,どれいがもし『わたしは、わたしの主人,しゅじんと、わたしの妻,つまと子供,こどもを愛,あいします。わたしは自由,じゆうの身,みとなって去,さることを好,このみません』と明言,めいげんするならば、","tok":[["奴隷","どれい"],["が"],["もし"],["『"],["わたし"],["は"],["、"],["わたし"],["の"],["主人","しゅじん"],["と"],["、"],["わたし"],["の"],["妻","つま"],["と"],["子供","こども"],["を"],["愛します","あいします"],["。"],["わたし"],["は"],["自由","じゆう"],["の"],["身","み"],["と"],["なって"],["去る","さる"],["こと"],["を"],["好みません","このみません"],["』"],["と"],["明言","めいげん"],["するならば"],["、"]]},{"verse":6,"text":"その主人,しゅじんは彼,かれを神,かみのもとに連,つれて行,いき、戸,とあるいは柱,はしらのところに連,つれて行,いって、主人,しゅじんは、きりで彼,かれの耳,みみを刺,さし通,とおさなければならない。そうすれば彼,かれはいつまでもこれに仕,つかえるであろう。","tok":[["その"],["主人","しゅじん"],["は"],["彼","かれ"],["を"],["神","かみ"],["の"],["もと"],["に"],["連れて","つれて"],["行き","いき"],["、"],["戸","と"],["あるいは"],["柱","はしら"],["の"],["ところ"],["に"],["連れて","つれて"],["行って","いって"],["、"],["主人","しゅじん"],["は"],["、"],["きり"],["で"],["彼","かれ"],["の"],["耳","みみ"],["を"],["刺通さなければ","さしとおさなければ"],["ならない"],["。"],["そう"],["すれば"],["彼","かれ"],["は"],["いつ"],["まで"],["も"],["これ"],["に"],["仕えるで","つかえるで"],["あろう"],["。"]]},{"verse":7,"text":"もし人,ひとがその娘,むすめを女,おんな奴隷,どれいとして売,うるならば、その娘,むすめは男,おとこ奴隷,どれいが去,さるように去,さってはならない。","tok":[["もし"],["人","ひと"],["が"],["その"],["娘","むすめ"],["を"],["女","おんな"],["奴隷","どれい"],["として"],["売るならば","うるならば"],["、"],["その"],["娘","むすめ"],["は"],["男","おとこ"],["奴隷","どれい"],["が"],["去る","さる"],["よう"],["に"],["去て","さって"],["は"],["ならない"],["。"]]},{"verse":8,"text":"彼女,かのじょがもし彼女,かのじょを自分,じぶんのものと定,さだめた主人,しゅじんの気,きにいらない時,ときは、その主人,しゅじんは彼女,かのじょが、あがなわれることを、これに許,ゆるさなければならない。彼,かれはこれを欺,あざむいたのであるから、これを他国,たこくの民,たみに売,うる権利,けんりはない。","tok":[["彼女","かのじょ"],["が"],["もし"],["彼女","かのじょ"],["を"],["自分","じぶん"],["の"],["もの"],["と"],["定めた","さだめた"],["主人","しゅじん"],["の"],["気","き"],["に"],["いらない"],["時","とき"],["は"],["、"],["その"],["主人","しゅじん"],["は"],["彼女","かのじょ"],["が"],["、"],["あがなわれる"],["こと"],["を"],["、"],["これ"],["に"],["許さなければ","ゆるさなければ"],["ならない"],["。"],["彼","かれ"],["は"],["これ"],["を"],["欺いた","あざむいた"],["ので"],["ある"],["から"],["、"],["これ"],["を"],["他国","たこく"],["の"],["民","たみ"],["に"],["売る","うる"],["権利","けんり"],["は"],["ない"],["。"]]},{"verse":9,"text":"彼,かれがもし彼女,かのじょを自分,じぶんの子,このものと定,さだめるならば、これを娘,むすめのように扱,あつかわなければならない。","tok":[["彼","かれ"],["が"],["もし"],["彼女","かのじょ"],["を"],["自分","じぶん"],["の"],["子","こ"],["の"],["もの"],["と"],["定めるならば","さだめるならば"],["、"],["これ"],["を"],["娘","むすめ"],["の"],["よう"],["に"],["扱わなければ","あつかわなければ"],["ならない"],["。"]]},{"verse":10,"text":"彼,かれが、たとい、ほかに女,おんなをめとることがあっても、前,まえの女,おんなに食物,しょくもつと衣服,いふくを与,あたえることと、その夫婦,ふうふの道,みちとを絶,たえさせてはならない。","tok":[["彼","かれ"],["が"],["、"],["たとい"],["、"],["ほか"],["に"],["女","おんな"],["を"],["めとる"],["こと"],["が"],["あって"],["も"],["、"],["前","まえ"],["の"],["女","おんな"],["に"],["食物","しょくもつ"],["と"],["衣服","いふく"],["を"],["与える","あたえる"],["こと"],["と"],["、"],["その"],["夫婦","ふうふ"],["の"],["道","みち"],["と"],["を"],["絶えさせて","たえさせて"],["は"],["ならない"],["。"]]},{"verse":11,"text":"彼,かれがもしこの三つを行,おこなわないならば、彼女,かのじょは金,かねを償,つぐなわずに去,さることができる。","tok":[["彼","かれ"],["が"],["もし"],["この"],["三","みっ"],["つ"],["を"],["行なわないならば","おこなわないならば"],["、"],["彼女","かのじょ"],["は"],["金","かね"],["を"],["償なわず","つぐなわず"],["に"],["去る","さる"],["こと"],["が"],["できる"],["。"]]},{"verse":12,"text":"人,ひとを撃,うって死,しなせた者,ものは、必,かならず殺,ころされなければならない。","tok":[["人","ひと"],["を"],["撃って","うって"],["死なせた","しなせた"],["者","もの"],["は"],["、"],["必","かならず"],["殺ろされなければ","ころされなければ"],["ならない"],["。"]]},{"verse":13,"text":"しかし、人,ひとがたくむことをしないのに、神,かみが彼,かれの手,てに人,ひとをわたされることのある時,ときは、わたしはあなたのために一つの所,ところを定,さだめよう。彼,かれはその所,ところへのがれることができる。","tok":[["しかし"],["、"],["人","ひと"],["が"],["たくむ"],["こと"],["を"],["しない"],["のに"],["、"],["神","かみ"],["が"],["彼","かれ"],["の"],["手","て"],["に"],["人","ひと"],["を"],["わたされる"],["こと"],["の"],["ある"],["時","とき"],["は"],["、"],["わたし"],["は"],["あなた"],["の"],["ため"],["に"],["一","ひと"],["つ"],["の"],["所","ところ"],["を"],["定めよう","さだめよう"],["。"],["彼","かれ"],["は"],["その"],["所","ところ"],["へ"],["のがれる"],["こと"],["が"],["できる"],["。"]]},{"verse":14,"text":"しかし人,ひとがもし、ことさらにその隣人,りんじんを欺,あざむいて殺,ころす時,ときは、その者,ものをわたしの祭壇,さいだんからでも、捕,とらえて行,いって殺,ころさなければならない。","tok":[["しかし"],["人","ひと"],["が"],["もし"],["、"],["こと"],["さらに"],["その"],["隣人","りんじん"],["を"],["欺いて","あざむいて"],["殺ろす","ころす"],["時","とき"],["は"],["、"],["その"],["者","もの"],["を"],["わたし"],["の"],["祭壇","さいだん"],["から"],["で"],["も"],["、"],["捕らえて","とらえて"],["行って","いって"],["殺ろさなければ","ころさなければ"],["ならない"],["。"]]},{"verse":15,"text":"自分,じぶんの父,ちちまたは母,ははを撃,うつ者,ものは、必,かならず殺,ころされなければならない。","tok":[["自分","じぶん"],["の"],["父","ちち"],["また"],["は"],["母","はは"],["を"],["撃つ","うつ"],["者","もの"],["は"],["、"],["必","かならず"],["殺ろされなければ","ころされなければ"],["ならない"],["。"]]},{"verse":16,"text":"人,ひとをかどわかした者,ものは、これを売,うっていても、なお彼,かれの手,てにあっても、必,かならず殺,ころされなければならない。","tok":[["人","ひと"],["を"],["かどわかした"],["者","もの"],["は"],["、"],["これ"],["を"],["売って","うって"],["いて"],["も"],["、"],["なお"],["彼","かれ"],["の"],["手","て"],["に"],["あって"],["も"],["、"],["必","かならず"],["殺ろされなければ","ころされなければ"],["ならない"],["。"]]},{"verse":17,"text":"自分,じぶんの父,ちちまたは母,ははをのろう者,ものは、必,かならず殺,ころされなければならない。","tok":[["自分","じぶん"],["の"],["父","ちち"],["また"],["は"],["母","はは"],["を"],["の"],["ろう者","ろうもの"],["は"],["、"],["必","かならず"],["殺ろされなければ","ころされなければ"],["ならない"],["。"]]},{"verse":18,"text":"人,ひとが互,たがいに争,あらそい、そのひとりが石,いしまたは、こぶしで相手,あいてを撃,うった時,とき、これが死,しなないで床,とこにつき、","tok":[["人","ひと"],["が"],["互","たがい"],["に"],["争い","あらそい"],["、"],["その"],["ひとり"],["が"],["石","いし"],["また"],["は"],["、"],["こぶし"],["で"],["相手","あいて"],["を"],["撃った","うった"],["時","とき"],["、"],["これ"],["が"],["死なないで","しなないで"],["床","とこ"],["に"],["つき"],["、"]]},{"verse":19,"text":"再,ふたたび起,おきあがって、つえにすがり、外,そとを歩,あるくようになるならば、これを撃,うった者,ものは、ゆるされるであろう。ただその仕事,しごとを休,やすんだ損失,そんしつを償,つぐない、かつこれにじゅうぶん治療,ちりょうさせなければならない。","tok":[["再び","ふたたび"],["起きあがって","おきあがって"],["、"],["つえ"],["に"],["すがり"],["、"],["外","そと"],["を"],["歩く","あるく"],["よう"],["に"],["なるならば"],["、"],["これ"],["を"],["撃った","うった"],["者","もの"],["は"],["、"],["ゆるされるで"],["あろう"],["。"],["ただ"],["その"],["仕事","しごと"],["を"],["休んだ","やすんだ"],["損失","そんしつ"],["を"],["償ない","つぐない"],["、"],["かつ"],["これ"],["に"],["じゅうぶん"],["治療","ちりょう"],["させなければ"],["ならない"],["。"]]},{"verse":20,"text":"もし人,ひとがつえをもって、自分,じぶんの男,おとこ奴隷,どれいまたは女,おんな奴隷,どれいを撃,うち、その手,ての下,したに死,しぬならば、必,かならず罰,ばっせられなければならない。","tok":[["もし"],["人","ひと"],["が"],["つえ"],["を"],["もって"],["、"],["自分","じぶん"],["の"],["男","おとこ"],["奴隷","どれい"],["また"],["は"],["女","おんな"],["奴隷","どれい"],["を"],["撃ち","うち"],["、"],["その"],["手","て"],["の"],["下","した"],["に"],["死ぬならば","しぬならば"],["、"],["必罰","かならずばっ"],["せられなければ"],["ならない"],["。"]]},{"verse":21,"text":"しかし、彼,かれがもし一日,にちか、ふつか生,いき延,のびるならば、その人,ひとは罰,ばっせられない。奴隷,どれいは彼,かれの財産,ざいさんだからである。","tok":[["しかし"],["、"],["彼","かれ"],["が"],["もし"],["一","いち"],["日","にち"],["ちか"],["、"],["ふ"],["つ"],["か"],["生き延びるならば","いきのびるならば"],["、"],["その"],["人","ひと"],["は"],["罰せられない","ばっせられない"],["。"],["奴隷","どれい"],["は"],["彼","かれ"],["の"],["財産","ざいさん"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":22,"text":"もし人,ひとが互,たがいに争,あらそって、身,みごもった女,おんなを撃,うち、これに流産,りゅうざんさせるならば、ほかの害,がいがなくとも、彼,かれは必,かならずその女,おんなの夫,おっとの求,もとめる罰金,ばっきんを課,かせられ、裁判人,さいばんにんの定,さだめるとおりに支払,しはらわなければならない。","tok":[["もし"],["人","ひと"],["が"],["互","たがい"],["に"],["争って","あらそって"],["、"],["身ごもった","みごもった"],["女","おんな"],["を"],["撃ち","うち"],["、"],["これ"],["に"],["流産","りゅうざん"],["させるならば"],["、"],["ほか"],["の"],["害","がい"],["が"],["なく"],["とも"],["、"],["彼","かれ"],["は"],["必","かならず"],["その"],["女","おんな"],["の"],["夫","おっと"],["の"],["求める","もとめる"],["罰金","ばっきん"],["を"],["課せられ","かせられ"],["、"],["裁判人","さいばんにん"],["の"],["定める","さだめる"],["とおり"],["に"],["支払わなければ","しはらわなければ"],["ならない"],["。"]]},{"verse":23,"text":"しかし、ほかの害,がいがある時,ときは、命,いのちには命,いのち、","tok":[["しかし"],["、"],["ほか"],["の"],["害","がい"],["が"],["ある"],["時","とき"],["は"],["、"],["命","いのち"],["に"],["は"],["命","いのち"],["、"]]},{"verse":24,"text":"目,めには目,め、歯,はには歯,は、手,てには手,て、足,あしには足,あし、","tok":[["目","め"],["に"],["は"],["目","め"],["、"],["歯","は"],["に"],["は"],["歯","は"],["、"],["手","て"],["に"],["は"],["手","て"],["、"],["足","あし"],["に"],["は"],["足","あし"],["、"]]},{"verse":25,"text":"焼,やき傷,きずには焼,やき傷,きず、傷,きずには傷,きず、打,うち傷,きずには打,うち傷,きずをもって償,つぐなわなければならない。","tok":[["焼き","やき"],["傷","きず"],["に"],["は"],["焼き","やき"],["傷","きず"],["、"],["傷","きず"],["に"],["は"],["傷","きず"],["、"],["打ち傷","うちきず"],["に"],["は"],["打ち傷","うちきず"],["を"],["もって"],["償なわなければ","つぐなわなければ"],["ならない"],["。"]]},{"verse":26,"text":"もし人,ひとが自分,じぶんの男,おとこ奴隷,どれいの片目,かため、または女,おんな奴隷,どれいの片目,かためを撃,うち、これをつぶすならば、その目,めのためにこれを自由,じゆうの身,みとして去,さらせなければならない。","tok":[["もし"],["人","ひと"],["が"],["自分","じぶん"],["の"],["男","おとこ"],["奴隷","どれい"],["の"],["片目","かため"],["、"],["また"],["は"],["女","おんな"],["奴隷","どれい"],["の"],["片目","かため"],["を"],["撃ち","うち"],["、"],["これ"],["を"],["つぶすならば"],["、"],["その"],["目","め"],["の"],["ため"],["に"],["これ"],["を"],["自由","じゆう"],["の"],["身","み"],["として"],["去らせなければ","さらせなければ"],["ならない"],["。"]]},{"verse":27,"text":"また、もしその男,おとこ奴隷,どれいの一本,ぽんの歯,は、またはその女,おんな奴隷,どれいの一本,ぽんの歯,はを撃,うち落,おとすならば、その歯,はのためにこれを自由,じゆうの身,みとして去,さらせなければならない。","tok":[["また"],["、"],["もし"],["その"],["男","おとこ"],["奴隷","どれい"],["の"],["一本","ぽん"],["の"],["歯","は"],["、"],["また"],["は"],["その"],["女","おんな"],["奴隷","どれい"],["の"],["一本","ぽん"],["の"],["歯","は"],["を"],["撃ち落とすならば","うちおとすならば"],["、"],["その"],["歯","は"],["の"],["ため"],["に"],["これ"],["を"],["自由","じゆう"],["の"],["身","み"],["として"],["去らせなければ","さらせなければ"],["ならない"],["。"]]},{"verse":28,"text":"もし牛,うしが男,おとこまたは女,おんなを突,ついて殺,ころすならば、その牛,うしは必,かならず石,いしで撃,うち殺,ころされなければならない。その肉,にくは食,たべてはならない。しかし、その牛,うしの持,もち主,ぬしは罪,つみがない。","tok":[["もし"],["牛","うし"],["が"],["男","おとこ"],["また"],["は"],["女","おんな"],["を"],["突いて","ついて"],["殺ろすならば","ころすならば"],["、"],["その"],["牛","うし"],["は"],["必","かならず"],["石","いし"],["で"],["撃ち","うち"],["殺ろされなければ","ころされなければ"],["ならない"],["。"],["その"],["肉","にく"],["は"],["食べて","たべて"],["は"],["ならない"],["。"],["しかし"],["、"],["その"],["牛","うし"],["の"],["持主","もちぬし"],["は"],["罪","つみ"],["が"],["ない"],["。"]]},{"verse":29,"text":"牛,うしがもし以前,いぜんから突,つく癖,くせがあって、その持,もち主,ぬしが注意,ちゅういされても、これを守,まもりおかなかったために、男,おとこまたは女,おんなを殺,ころしたならば、その牛,うしは石,いしで撃,うち殺,ころされ、その持,もち主,ぬしもまた殺,ころされなければならない。","tok":[["牛","うし"],["が"],["もし"],["以前","いぜん"],["から"],["突く","つく"],["癖","くせ"],["が"],["あって"],["、"],["その"],["持主","もちぬし"],["が"],["注意","ちゅうい"],["されて"],["も"],["、"],["これ"],["を"],["守り","まもり"],["おかなかった"],["ため"],["に"],["、"],["男","おとこ"],["また"],["は"],["女","おんな"],["を"],["殺ろしたならば","ころしたならば"],["、"],["その"],["牛","うし"],["は"],["石","いし"],["で"],["撃ち","うち"],["殺ろ","ころ"],["され"],["、"],["その"],["持主","もちぬし"],["も"],["また"],["殺ろされなければ","ころされなければ"],["ならない"],["。"]]},{"verse":30,"text":"彼,かれがもし、あがないの金,かねを課,かせられたならば、すべて課,かせられたほどのものを、命,いのちの償,つぐないに支払,しはらわなければならない。","tok":[["彼","かれ"],["が"],["もし"],["、"],["あがない"],["の"],["金","かね"],["を"],["課せられたならば","かせられたならば"],["、"],["すべて"],["課せられた","かせられた"],["ほど"],["の"],["もの"],["を"],["、"],["命","いのち"],["の"],["償ない","つぐない"],["に"],["支払わなければ","しはらわなければ"],["ならない"],["。"]]},{"verse":31,"text":"男,おとこの子,こを突,ついても、女,おんなの子,こを突,ついても、この定,さだめに従,したがって処置,しょちされなければならない。","tok":[["男の子","おとこのこ"],["を"],["突いて","ついて"],["も"],["、"],["女の子","おんなのこ"],["を"],["突いて","ついて"],["も"],["、"],["この"],["定め","さだめ"],["に"],["従って","したがって"],["処置","しょち"],["されなければ"],["ならない"],["。"]]},{"verse":32,"text":"牛,うしがもし男,おとこ奴隷,どれいまたは女,おんな奴隷,どれいを突,つくならば、その主人,しゅじんに銀,ぎん三十シケルを支払,しはらわなければならない。またその牛,うしは石,いしで撃,うち殺,ころされなければならない。","tok":[["牛","うし"],["が"],["もし"],["男","おとこ"],["奴隷","どれい"],["また"],["は"],["女","おんな"],["奴隷","どれい"],["を"],["突くならば","つくならば"],["、"],["その"],["主人","しゅじん"],["に"],["銀","ぎん"],["三十","さんじゅう"],["シケル"],["を"],["支払わなければ","しはらわなければ"],["ならない"],["。"],["また"],["その"],["牛","うし"],["は"],["石","いし"],["で"],["撃ち","うち"],["殺ろされなければ","ころされなければ"],["ならない"],["。"]]},{"verse":33,"text":"もし人,ひとが穴,あなをあけたままに置,おき、あるいは穴,あなを掘,ほってこれにおおいをしないために、牛,うしまたは、ろばがこれに落,おち込,こむことがあれば、","tok":[["もし"],["人","ひと"],["が"],["穴","あな"],["を"],["あけた"],["まま"],["に"],["置き","おき"],["、"],["あるいは"],["穴","あな"],["を"],["掘って","ほって"],["これ"],["に"],["おおい"],["を"],["しない"],["ため"],["に"],["、"],["牛","うし"],["また"],["は"],["、"],["ろば"],["が"],["これ"],["に"],["落込む","おちこむ"],["こと"],["が"],["あれば"],["、"]]},{"verse":34,"text":"穴,あなの持,もち主,ぬしはこれを償,つぐない、金,かねをその持,もち主,ぬしに支払,しはらわなければならない。しかし、その死,しんだ獣,けものは彼,かれのものとなるであろう。","tok":[["穴","あな"],["の"],["持主","もちぬし"],["は"],["これ"],["を"],["償ない","つぐない"],["、"],["金","かね"],["を"],["その"],["持主","もちぬし"],["に"],["支払わなければ","しはらわなければ"],["ならない"],["。"],["しかし"],["、"],["その"],["死んだ","しんだ"],["獣","けもの"],["は"],["彼","かれ"],["の"],["もの"],["と"],["なるで"],["あろう"],["。"]]},{"verse":35,"text":"ある人,ひとの牛,うしが、もし他人,たにんの牛,うしを突,ついて殺,ころすならば、彼,かれらはその生,いきている牛,うしを売,うって、その価,あたいを分,わけ、またその死,しんだものをも分,わけなければならない。","tok":[["ある"],["人","ひと"],["の"],["牛","うし"],["が"],["、"],["もし"],["他人","たにん"],["の"],["牛","うし"],["を"],["突いて","ついて"],["殺ろすならば","ころすならば"],["、"],["彼","かれ"],["ら"],["は"],["その"],["生きて","いきて"],["いる"],["牛","うし"],["を"],["売って","うって"],["、"],["その"],["価","あたい"],["を"],["分け","わけ"],["、"],["また"],["その"],["死んだ","しんだ"],["もの"],["を"],["も"],["分けなければ","わけなければ"],["ならない"],["。"]]},{"verse":36,"text":"あるいはその牛,うしが以前,いぜんから突,つく癖,くせのあることが知,しられているのに、その持,もち主,ぬしがこれを守,まもりおかなかったならば、その人,ひとは必,かならずその牛,うしのために牛,うしをもって償,つぐなわなければならない。しかし、その死,しんだ獣,けものは彼,かれのものとなるであろう。","tok":[["あるいは"],["その"],["牛","うし"],["が"],["以前","いぜん"],["から"],["突く","つく"],["癖","くせ"],["の"],["ある"],["こと"],["が"],["知られて","しられて"],["いる"],["のに"],["、"],["その"],["持主","もちぬし"],["が"],["これ"],["を"],["守り","まもり"],["おかなかったならば"],["、"],["その"],["人","ひと"],["は"],["必","かならず"],["その"],["牛","うし"],["の"],["ため"],["に"],["牛","うし"],["を"],["もって"],["償なわなければ","つぐなわなければ"],["ならない"],["。"],["しかし"],["、"],["その"],["死んだ","しんだ"],["獣","けもの"],["は"],["彼","かれ"],["の"],["もの"],["と"],["なるで"],["あろう"],["。"]]},{"verse":37,"text":"[22:1]もし人,ひとが牛,うしまたは羊,ひつじを盗,ぬすんで、これを殺,ころし、あるいはこれを売,うるならば、彼,かれは一頭,とうの牛,うしのために五頭,とうの牛,うしをもって、一頭,とうの羊,ひつじのために四頭,とうの羊,ひつじをもって償,つぐなわなければならない。","tok":[["["],["22"],[":"],["1"],["]"],["もし"],["人","ひと"],["が"],["牛","うし"],["また"],["は"],["羊","ひつじ"],["を"],["盗んで","ぬすんで"],["、"],["これ"],["を"],["殺ろし","ころし"],["、"],["あるいは"],["これ"],["を"],["売るならば","うるならば"],["、"],["彼","かれ"],["は"],["一頭","とう"],["の"],["牛","うし"],["の"],["ため"],["に"],["五頭","とう"],["の"],["牛","うし"],["を"],["もって"],["、"],["一頭","とう"],["の"],["羊","ひつじ"],["の"],["ため"],["に"],["四頭","とう"],["の"],["羊","ひつじ"],["を"],["もって"],["償なわなければ","つぐなわなければ"],["ならない"],["。"]]}]
[{"verse":1,"text":"あなたは偽,いつわりのうわさを言,いいふらしてはならない。あなたは悪人,あくにんと手,てを携,たずさえて、悪意,あくいのある証人,しょうにんになってはならない。","tok":[["あなた"],["は"],["偽わり","いつわり"],["の"],["うわさ"],["を"],["言いふらして","いいふらして"],["は"],["ならない"],["。"],["あなた"],["は"],["悪人","あくにん"],["と"],["手","て"],["を"],["携えて","たずさえて"],["、"],["悪意","あくい"],["の"],["ある"],["証人","しょうにん"],["に"],["なって"],["は"],["ならない"],["。"]]},{"verse":2,"text":"あなたは多数,たすうに従,したがって悪,あくをおこなってはならない。あなたは訴訟,そしょうにおいて、多数,たすうに従,したがって片寄,かたより、正義,せいぎを曲,まげるような証言,しょうげんをしてはならない。","tok":[["あなた"],["は"],["多数","たすう"],["に"],["従って","したがって"],["悪","あく"],["を"],["おこなって"],["は"],["ならない"],["。"],["あなた"],["は"],["訴訟","そしょう"],["に"],["おいて"],["、"],["多数","たすう"],["に"],["従って","したがって"],["片寄り","かたより"],["、"],["正義","せいぎ"],["を"],["曲げる","まげる"],["よう"],["な"],["証言","しょうげん"],["を"],["して"],["は"],["ならない"],["。"]]},{"verse":3,"text":"また貧,まずしい人,ひとをその訴訟,そしょうにおいて、曲,まげてかばってはならない。","tok":[["また"],["貧しい","まずしい"],["人","ひと"],["を"],["その"],["訴訟","そしょう"],["に"],["おいて"],["、"],["曲げて","まげて"],["かばって"],["は"],["ならない"],["。"]]},{"verse":4,"text":"もし、あなたが敵,てきの牛,うしまたは、ろばの迷,まよっているのに会,あう時,ときは、必,かならずこれを彼,かれの所,ところに連,つれて行,いって、帰,きさなければならない。","tok":[["もし"],["、"],["あなた"],["が"],["敵","てき"],["の"],["牛","うし"],["また"],["は"],["、"],["ろば"],["の"],["迷って","まよって"],["いる"],["のに"],["会う","あう"],["時","とき"],["は"],["、"],["必","かならず"],["これ"],["を"],["彼","かれ"],["の"],["所","ところ"],["に"],["連れて","つれて"],["行って","いって"],["、"],["帰さなければ","きさなければ"],["ならない"],["。"]]},{"verse":5,"text":"もしあなたを憎,にくむ者,もののろばが、その荷物,にもつの下,したに倒,たおれ伏,ふしているのを見,みる時,ときは、これを見捨,みすてて置,おかないように気,きをつけ、必,かならずその人,ひとに手,てを貸,かして、これを起,おこさなければならない。","tok":[["もし"],["あなた"],["を"],["憎む","にくむ"],["者","もの"],["の"],["ろば"],["が"],["、"],["その"],["荷物","にもつ"],["の"],["下","した"],["に"],["倒れ伏して","たおれふして"],["いる"],["の"],["を"],["見る","みる"],["時","とき"],["は"],["、"],["これ"],["を"],["見捨てて","みすてて"],["置かない","おかない"],["よう"],["に"],["気","き"],["を"],["つけ"],["、"],["必","かならず"],["その"],["人","ひと"],["に"],["手","て"],["を"],["貸","かし"],["て"],["、"],["これ"],["を"],["起こさなければ","おこさなければ"],["ならない"],["。"]]},{"verse":6,"text":"あなたは貧,まずしい者,ものの訴訟,そしょうにおいて、裁判,さいばんを曲,まげてはならない。","tok":[["あなた"],["は"],["貧しい","まずしい"],["者","もの"],["の"],["訴訟","そしょう"],["に"],["おいて"],["、"],["裁判","さいばん"],["を"],["曲げて","まげて"],["は"],["ならない"],["。"]]},{"verse":7,"text":"あなたは偽,いつわり事,ことに遠,とおざからなければならない。あなたは罪,つみのない者,ものと正,ただしい者,ものとを殺,ころしてはならない。わたしは悪人,あくにんを義,ぎとすることはないからである。","tok":[["あなた"],["は"],["偽わり","いつわり"],["事","こと"],["に"],["遠ざからなければ","とおざからなければ"],["ならない"],["。"],["あなた"],["は"],["罪","つみ"],["の"],["ない"],["者","もの"],["と"],["正い","ただしい"],["者","もの"],["と"],["を"],["殺ろし","ころし"],["ては"],["ならない"],["。"],["わたし"],["は"],["悪人","あくにん"],["を"],["義","ぎ"],["と"],["する"],["こと"],["は"],["ない"],["から"],["で"],["ある"],["。"]]},{"verse":8,"text":"あなたは賄賂,わいろを取,とってはならない。賄賂,わいろは人,ひとの目,めをくらまし、正,ただしい者,ものの事件,じけんをも曲,まげさせるからである。","tok":[["あなた"],["は"],["賄賂","わいろ"],["を"],["取って","とって"],["は"],["ならない"],["。"],["賄賂","わいろ"],["は"],["人","ひと"],["の"],["目","め"],["を"],["くらまし"],["、"],["正い","ただしい"],["者","もの"],["の"],["事件","じけん"],["を"],["も"],["曲げ","まげ"],["させる"],["から"],["で"],["ある"],["。"]]},{"verse":9,"text":"あなたは寄留,きりゅうの他国,たこく人,じんをしえたげてはならない。あなたがたはエジプトの国,くにで寄留,きりゅうの他国,たこく人,じんであったので、寄留,きりゅうの他国,たこく人,じんの心,こころを知,しっているからである。","tok":[["あなた"],["は"],["寄留","きりゅう"],["の"],["他国人","たこくじん"],["を"],["し"],["えたげて"],["は"],["ならない"],["。"],["あなた"],["がた"],["は"],["エジプト"],["の"],["国","くに"],["で"],["寄留","きりゅう"],["の"],["他国人","たこくじん"],["で"],["あった"],["ので"],["、"],["寄留","きりゅう"],["の"],["他国人","たこくじん"],["の"],["心","こころ"],["を"],["知って","しって"],["いる"],["から"],["で"],["ある"],["。"]]},{"verse":10,"text":"あなたは六年,ねんのあいだ、地,ちに種,たねをまき、その産物,さんぶつを取,とり入,いれることができる。","tok":[["あなた"],["は"],["六","ろく"],["年","ねん"],["の"],["あいだ"],["、"],["地","ち"],["に"],["種","たね"],["を"],["まき"],["、"],["その"],["産物","さんぶつ"],["を"],["取入れる","とりいれる"],["こと"],["が"],["できる"],["。"]]},{"verse":11,"text":"しかし、七年,ねん目,めには、これを休,やすませて、耕,たがやさずに置,おかなければならない。そうすれば、あなたの民,たみの貧,まずしい者,ものがこれを食,たべ、その残,のこりは野,のの獣,けものが食,たべることができる。あなたのぶどう畑,はたけも、オリブ畑,はたけも同様,どうようにしなければならない。","tok":[["しかし"],["、"],["七","なな"],["年目","年め"],["に"],["は"],["、"],["これ"],["を"],["休ませて","やすませて"],["、"],["耕やさず","たがやさず"],["に"],["置かなければ","おかなければ"],["ならない"],["。"],["そう"],["すれば"],["、"],["あなた"],["の"],["民","たみ"],["の"],["貧しい","まずしい"],["者","もの"],["が"],["これ"],["を"],["食べ","たべ"],["、"],["その"],["残り","のこり"],["は"],["野","の"],["の"],["獣","けもの"],["が"],["食べる","たべる"],["こと"],["が"],["できる"],["。"],["あなた"],["の"],["ぶどう"],["畑","はたけ"],["も"],["、"],["オリブ"],["畑","はたけ"],["も"],["同様","どうよう"],["に"],["しなければ"],["ならない"],["。"]]},{"verse":12,"text":"あなたは六日,かのあいだ、仕事,しごとをし、七日,なぬか目,めには休,やすまなければならない。これはあなたの牛,うしおよび、ろばが休,やすみを得,え、またあなたのはしための子,こおよび寄留,きりゅうの他国,たこく人,じんを休,やすませるためである。","tok":[["あなた"],["は"],["六日","か"],["の"],["あいだ"],["、"],["仕事","しごと"],["を"],["し"],["、"],["七日","な"],["ぬか目","ぬかめ"],["に"],["は"],["休まなければ","やすまなければ"],["ならない"],["。"],["これ"],["は"],["あなた"],["の"],["牛","うし"],["および"],["、"],["ろば"],["が"],["休み","やすみ"],["を"],["得","え"],["、"],["また"],["あなた"],["の"],["はし"],["ため"],["の"],["子","こ"],["および"],["寄留","きりゅう"],["の"],["他国人","たこくじん"],["を"],["休ませる","やすませる"],["ため"],["で"],["ある"],["。"]]},{"verse":13,"text":"わたしが、あなたがたに言,いったすべての事,ことに心,こころを留,とめなさい。他,たの神々,かみがみの名,なを唱,となえてはならない。また、これをあなたのくちびるから聞,きこえさせてはならない。","tok":[["わたし"],["が"],["、"],["あなた"],["がた"],["に"],["言った","いった"],["すべて"],["の"],["事","こと"],["に"],["心","こころ"],["を"],["留","とめ"],["なさい"],["。"],["他","た"],["の"],["神々","かみがみ"],["の"],["名","な"],["を"],["唱えて","となえて"],["は"],["ならない"],["。"],["また"],["、"],["これ"],["を"],["あなた"],["の"],["くちびる"],["から"],["聞こえさせて","きこえさせて"],["は"],["ならない"],["。"]]},{"verse":14,"text":"あなたは年,ねんに三度,ど、わたしのために祭,まつりを行,おこなわなければならない。","tok":[["あなた"],["は"],["年","ねん"],["に"],["三","さん"],["度","ど"],["、"],["わたし"],["の"],["ため"],["に"],["祭","まつり"],["を"],["行なわなければ","おこなわなければ"],["ならない"],["。"]]},{"verse":15,"text":"あなたは種,たね入,いれぬパンの祭,まつりを守,まもらなければならない。わたしが、あなたに命,めいじたように、アビブの月,つきの定,さだめの時,ときに七日,なぬかのあいだ、種,たね入,いれぬパンを食,たべなければならない。それはその月,つきにあなたがエジプトから出,でたからである。だれも、むなし手,てでわたしの前,まえに出,でてはならない。","tok":[["あなた"],["は"],["種","た"],["ね"],["入れぬ","いれぬ"],["パン"],["の"],["祭","まつり"],["を"],["守らなければ","まもらなければ"],["ならない"],["。"],["わたし"],["が"],["、"],["あなた"],["に"],["命じた","めいじた"],["よう"],["に"],["、"],["アビブ"],["の"],["月","つき"],["の"],["定め","さだめ"],["の"],["時","とき"],["に"],["七","しち"],["日","にち"],["の"],["あいだ"],["、"],["種","た"],["ね"],["入れぬ","いれぬ"],["パン"],["を"],["食べなければ","たべなければ"],["ならない"],["。"],["それ"],["は"],["その"],["月","つき"],["に"],["あなた"],["が"],["エジプト"],["から"],["出た","でた"],["から"],["で"],["ある"],["。"],["だれ"],["も"],["、"],["むなし"],["手","て"],["で"],["わたし"],["の"],["前","まえ"],["に"],["出て","でて"],["は"],["ならない"],["。"]]},{"verse":16,"text":"また、あなたが畑,はたけにまいて獲,えた物,ものの勤労,きんろうの初穂,はつほをささげる刈入,かりいれの祭,まつりと、あなたの勤労,きんろうの実,みを畑,はたけから取,とり入,いれる年,ねんの終,おわりに、取入,とりいれの祭,まつりを行,おこなわなければならない。","tok":[["また"],["、"],["あなた"],["が"],["畑","はたけ"],["に"],["まいて"],["獲た","えた"],["物","もの"],["の"],["勤労","きんろう"],["の"],["初穂","はつほ"],["を"],["ささげる"],["刈入れ","かりいれ"],["の"],["祭","まつり"],["と"],["、"],["あなた"],["の"],["勤労","きんろう"],["の"],["実","み"],["を"],["畑","はたけ"],["から"],["取入れる","とりいれる"],["年","ねん"],["の"],["終わり","おわり"],["に"],["、"],["取入","とりいれ"],["の"],["祭","まつり"],["を"],["行なわなければ","おこなわなければ"],["ならない"],["。"]]},{"verse":17,"text":"男子,だんしはみな、年,ねんに三度,ど、主,しゅなる神,かみの前,まえに出,でなければならない。","tok":[["男子","だんし"],["は"],["みな"],["、"],["年","ねん"],["に"],["三","さん"],["度","ど"],["、"],["主","しゅ"],["なる"],["神","かみ"],["の"],["前","まえ"],["に"],["出なければ","でなければ"],["ならない"],["。"]]},{"verse":18,"text":"あなたはわたしの犠牲,ぎせいの血,ちを、種,たねを入,いれたパンと共,ともにささげてはならない。また、わたしの祭,まつりの脂肪,しぼうを翌朝,よくあさまで残,のこして置,おいてはならない。","tok":[["あなた"],["は"],["わたし"],["の"],["犠牲","ぎせい"],["の"],["血","ち"],["を"],["、"],["種","たね"],["を"],["入れた","いれた"],["パン"],["と"],["共","とも"],["に"],["ささげて"],["は"],["ならない"],["。"],["また"],["、"],["わたし"],["の"],["祭","まつり"],["の"],["脂肪","しぼう"],["を"],["翌朝","よくあさ"],["まで"],["残して","のこして"],["置いて","おいて"],["は"],["ならない"],["。"]]},{"verse":19,"text":"あなたの土地,とちの初穂,はつほの最,もっとも良,よい物,ものを、あなたの神,かみ、主,しゅの家,いえに携,たずさえてこなければならない。あなたは子,こやぎを、その母,ははの乳,ちちで煮,にてはならない。","tok":[["あなた"],["の"],["土地","とち"],["の"],["初穂","はつほ"],["の"],["最も","もっとも"],["良い","よい"],["物","もの"],["を"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["家","いえ"],["に"],["携えて","たずさえて"],["こなければ"],["ならない"],["。"],["あなた"],["は"],["子やぎ","こやぎ"],["を"],["、"],["その"],["母","はは"],["の"],["乳","ちち"],["で"],["煮て","にて"],["は"],["ならない"],["。"]]},{"verse":20,"text":"見,みよ、わたしは使,つかいをあなたの前,まえにつかわし、あなたを道,みちで守,まもらせ、わたしが備,そなえた所,ところに導,みちびかせるであろう。","tok":[["見よ","みよ"],["、"],["わたし"],["は"],["使","つかい"],["を"],["あなた"],["の"],["前","まえ"],["に"],["つかわし"],["、"],["あなた"],["を"],["道","みち"],["で"],["守らせ","まもらせ"],["、"],["わたし"],["が"],["備","そなえ"],["た"],["所","ところ"],["に"],["導かせるで","みちびかせるで"],["あろう"],["。"]]},{"verse":21,"text":"あなたはその前,まえに慎,つつしみ、その言葉,ことばに聞,きき従,したがい、彼,かれにそむいてはならない。わたしの名,なが彼,かれのうちにあるゆえに、彼,かれはあなたがたのとがをゆるさないであろう。","tok":[["あなた"],["は"],["その"],["前","まえ"],["に"],["慎しみ","つつしみ"],["、"],["その"],["言葉","ことば"],["に"],["聞","きき"],["従い","したがい"],["、"],["彼","かれ"],["に"],["そむいて"],["は"],["ならない"],["。"],["わたし"],["の"],["名","な"],["が"],["彼","かれ"],["の"],["うち"],["に"],["ある"],["ゆえ"],["に"],["、"],["彼","かれ"],["は"],["あなた"],["がた"],["の"],["とが"],["を"],["ゆるさないで"],["あろう"],["。"]]},{"verse":22,"text":"しかし、もしあなたが彼,かれの声,こえによく聞,きき従,したがい、すべてわたしが語,かたることを行,おこなうならば、わたしはあなたの敵,てきを敵,てきとし、あなたのあだをあだとするであろう。","tok":[["しかし"],["、"],["もし"],["あなた"],["が"],["彼","かれ"],["の"],["声","こえ"],["に"],["よく"],["聞","きき"],["従い","したがい"],["、"],["すべて"],["わたし"],["が"],["語る","かたる"],["こと"],["を"],["行なうならば","おこなうならば"],["、"],["わたし"],["は"],["あなた"],["の"],["敵","てき"],["を"],["敵","てき"],["と"],["し"],["、"],["あなた"],["の"],["あだ"],["を"],["あだ"],["と"],["するで"],["あろう"],["。"]]},{"verse":23,"text":"わたしの使,つかいはあなたの前,まえに行,いって、あなたをアモリびと、ヘテびと、ペリジびと、カナンびと、ヒビびと、およびエブスびとの所,ところに導,みちびき、わたしは彼,かれらを滅,ほろぼすであろう。","tok":[["わたし"],["の"],["使い","つかい"],["は"],["あなた"],["の"],["前","まえ"],["に"],["行って","いって"],["、"],["あなた"],["を"],["アモリ"],["び"],["と"],["、"],["ヘテ"],["び"],["と"],["、"],["ペリジ"],["び"],["と"],["、"],["カナン"],["び"],["と"],["、"],["ヒビ"],["び"],["と"],["、"],["および"],["エブス"],["びと"],["の"],["所","ところ"],["に"],["導き","みちびき"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["滅ぼすで","ほろぼすで"],["あろう"],["。"]]},{"verse":24,"text":"あなたは彼,かれらの神々,かみがみを拝,おがんではならない。これに仕,つかえてはならない。また彼,かれらのおこないにならってはならない。あなたは彼,かれらを全,まったく打,うち倒,たおし、その石,いしの柱,はしらを打,うち砕,くだかなければならない。","tok":[["あなた"],["は"],["彼","かれ"],["ら"],["の"],["神々","かみがみ"],["を"],["拝","おがん"],["で"],["は"],["ならない"],["。"],["これ"],["に"],["仕えて","つかえて"],["は"],["ならない"],["。"],["また"],["彼","かれ"],["ら"],["の"],["おこない"],["に"],["ならって"],["は"],["ならない"],["。"],["あなた"],["は"],["彼","かれ"],["ら"],["を"],["全く","まったく"],["打ち倒し","うちたおし"],["、"],["その"],["石","いし"],["の"],["柱","はしら"],["を"],["打ち砕かなければ","うちくだかなければ"],["ならない"],["。"]]},{"verse":25,"text":"あなたがたの神,かみ、主,しゅに仕,つかえなければならない。そうすれば、わたしはあなたがたのパンと水,みずを祝,しゅくし、あなたがたのうちから病,やまいを除,のぞき去,さるであろう。","tok":[["あなた"],["がた"],["の"],["神","かみ"],["、"],["主に","しゅに"],["仕えなければ","つかえなければ"],["ならない"],["。"],["そう"],["すれば"],["、"],["わたし"],["は"],["あなた"],["がた"],["の"],["パン"],["と"],["水","みず"],["を"],["祝し","しゅくし"],["、"],["あなた"],["がた"],["の"],["うち"],["から"],["病","やまい"],["を"],["除き去るで","のぞきさるで"],["あろう"],["。"]]},{"verse":26,"text":"あなたの国,くにのうちには流産,りゅうざんする女,おんなもなく、不妊,ふにんの女,おんなもなく、わたしはあなたの日,ひの数,かずを満,みち足,たらせるであろう。","tok":[["あなた"],["の"],["国","くに"],["の"],["うち"],["に"],["は"],["流産","りゅうざん"],["する"],["女","おんな"],["も"],["なく"],["、"],["不妊","ふにん"],["の"],["女","おんな"],["も"],["なく"],["、"],["わたし"],["は"],["あなた"],["の"],["日","ひ"],["の"],["数","かず"],["を"],["満ち","みち"],["足らせるで","たらせるで"],["あろう"],["。"]]},{"verse":27,"text":"わたしはあなたの先,さきに、わたしの恐,おそれをつかわし、あなたが行,いく所,ところの民,たみを、ことごとく打,うち敗,やぶり、すべての敵,てきに、その背,せをあなたの方,ほうへ向,むけさせるであろう。","tok":[["わたし"],["は"],["あなた"],["の"],["先","さき"],["に"],["、"],["わたし"],["の"],["恐","おそれ"],["を"],["つかわし"],["、"],["あなた"],["が"],["行く","いく"],["所","ところ"],["の"],["民","たみ"],["を"],["、"],["ことごとく"],["打ち","うち"],["敗り","やぶり"],["、"],["すべて"],["の"],["敵","てき"],["に"],["、"],["その"],["背","せ"],["を"],["あなた"],["の"],["方","ほう"],["へ"],["向けさせるで","むけさせるで"],["あろう"],["。"]]},{"verse":28,"text":"わたしはまた、くまばちをあなたの先,さきにつかわすであろう。これはヒビびと、カナンびと、およびヘテびとをあなたの前,まえから追,おい払,はらうであろう。","tok":[["わたし"],["は"],["また"],["、"],["くまばち"],["を"],["あなた"],["の"],["先","さき"],["に"],["つかわすで"],["あろう"],["。"],["これ"],["は"],["ヒビ"],["び"],["と"],["、"],["カナン"],["び"],["と"],["、"],["および"],["ヘテ"],["びと"],["を"],["あなた"],["の"],["前","まえ"],["から"],["追い払うで","おいはらうで"],["あろう"],["。"]]},{"verse":29,"text":"しかし、わたしは彼,かれらを一年,ねんのうちには、あなたの前,まえから追,おい払,はらわないであろう。土地,とちが荒,あれすたれ、野,のの獣,けものが増,まして、あなたを害,がいすることのないためである。","tok":[["しかし"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["一","いち"],["年","ねん"],["の"],["うち"],["に"],["は"],["、"],["あなた"],["の"],["前","まえ"],["から"],["追い払わないで","おいはらわないで"],["あろう"],["。"],["土地","とち"],["が"],["荒れ","あれ"],["すたれ"],["、"],["野","の"],["の"],["獣","けもの"],["が"],["増して","まして"],["、"],["あなた"],["を"],["害する","がいする"],["こと"],["の"],["ない"],["ため"],["で"],["ある"],["。"]]},{"verse":30,"text":"わたしは徐々,じょじょに彼,かれらをあなたの前,まえから追,おい払,はらうであろう。あなたは、ついにふえひろがって、この地,ちを継,つぐようになるであろう。","tok":[["わたし"],["は"],["徐々","じょじょ"],["に"],["彼","かれ"],["ら"],["を"],["あなた"],["の"],["前","まえ"],["から"],["追い払うで","おいはらうで"],["あろう"],["。"],["あなた"],["は"],["、"],["ついに"],["ふえ"],["ひろがって"],["、"],["この"],["地","ち"],["を"],["継ぐ","つぐ"],["よう"],["に"],["なるで"],["あろう"],["。"]]},{"verse":31,"text":"わたしは紅海,こうかいからペリシテびとの海,うみに至,いたるまでと、荒野,あらのからユフラテ川,かわに至,いたるまでを、あなたの領域,りょういきとし、この地,ちに住,すんでいる者,ものをあなたの手,てにわたすであろう。あなたは彼,かれらをあなたの前,まえから追,おい払,はらうであろう。","tok":[["わたし"],["は"],["紅海","こうかい"],["から"],["ペリシテ"],["びと"],["の"],["海","うみ"],["に"],["至る","いたる"],["まで"],["と"],["、"],["荒野","あら"],["の"],["から"],["ユフラテ"],["川","かわ"],["に"],["至る","いたる"],["まで"],["を"],["、"],["あなた"],["の"],["領域","りょういき"],["と"],["し"],["、"],["この"],["地","ち"],["に"],["住んで","すんで"],["いる"],["者","もの"],["を"],["あなた"],["の"],["手","て"],["に"],["わたすで"],["あろう"],["。"],["あなた"],["は"],["彼","かれ"],["ら"],["を"],["あなた"],["の"],["前","まえ"],["から"],["追い払うで","おいはらうで"],["あろう"],["。"]]},{"verse":32,"text":"あなたは彼,かれら、および彼,かれらの神々,かみがみと契約,けいやくを結,むすんではならない。","tok":[["あなた"],["は"],["彼","かれ"],["ら"],["、"],["および"],["彼","かれ"],["ら"],["の"],["神々","かみがみ"],["と"],["契約","けいやく"],["を"],["結","むすん"],["で"],["は"],["ならない"],["。"]]},{"verse":33,"text":"彼,かれらはあなたの国,くにに住,すんではならない。彼,かれらがあなたをいざなって、わたしに対,たいして罪,つみを犯,おかさせることのないためである。もし、あなたが彼,かれらの神,かみに仕,つかえるならば、それは必,かならずあなたのわなとなるであろう」。","tok":[["彼","かれ"],["ら"],["は"],["あなた"],["の"],["国","くに"],["に"],["住","すん"],["で"],["は"],["ならない"],["。"],["彼","かれ"],["ら"],["が"],["あなた"],["を"],["いざなって"],["、"],["わたし"],["に対して","にたいして"],["罪","つみ"],["を"],["犯させる","おかさせる"],["こと"],["の"],["ない"],["ため"],["で"],["ある"],["。"],["もし"],["、"],["あなた"],["が"],["彼","かれ"],["ら"],["の"],["神","かみ"],["に"],["仕えるならば","つかえるならば"],["、"],["それ"],["は"],["必","かならず"],["あなた"],["の"],["わな"],["と"],["なるで"],["あろう"],["」"],["。"]]}]
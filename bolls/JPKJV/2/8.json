[{"verse":1,"text":"[5]主,しゅはモーセに言,いわれた、「あなたはアロンに言,いいなさい、『つえを持,もって、手,てを川,かわの上,うえ、流,ながれの上,うえ、、池,いけの上,うえにさし伸,のべ、かえるをエジプトの地,ちにのぼらせなさい』と」。","tok":[["["],["5"],["]"],["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["は"],["アロン"],["に"],["言い","いい"],["なさい"],["、"],["『"],["つえ"],["を"],["持って","もって"],["、"],["手","て"],["を"],["川","かわ"],["の"],["上","うえ"],["、"],["流れ","ながれ"],["の"],["上","うえ"],["、"],["、"],["池の上","いけのうえ"],["に"],["さし伸べ","さしのべ"],["、"],["かえる"],["を"],["エジプト"],["の"],["地","ち"],["に"],["のぼらせ"],["なさい"],["』"],["と"],["」"],["。"]]},{"verse":2,"text":"[6]アロンが手,てをエジプトの水,みずの上,うえにさし伸,のべたので、かえるはのぼってエジプトの地,ちをおおった。","tok":[["["],["6"],["]"],["アロン"],["が"],["手","て"],["を"],["エジプト"],["の"],["水","みず"],["の"],["上","うえ"],["に"],["さし伸べた","さしのべた"],["ので"],["、"],["かえる"],["は"],["のぼって"],["エジプト"],["の"],["地","ち"],["を"],["おおった"],["。"]]},{"verse":3,"text":"[7]魔術,まじゅつ師,しらも秘術,ひじゅつをもって同,おなじように行,おこない、かえるをエジプトの地,ちにのぼらせた。","tok":[["["],["7"],["]"],["魔術師","まじゅつし"],["ら"],["も"],["秘術","ひじゅつ"],["を"],["もって"],["同じ","おなじ"],["よう"],["に"],["行ない","おこない"],["、"],["かえる"],["を"],["エジプト"],["の"],["地","ち"],["に"],["のぼらせた"],["。"]]},{"verse":4,"text":"[8]パロはモーセとアロンを召,めして言,いった、「かえるをわたしと、わたしの民,たみから取,とり去,さるように主,しゅに願,ねがってください。そのときわたしはこの民,たみを去,さらせて、主,しゅに犠牲,ぎせいをささげさせるでしょう」。","tok":[["["],["8"],["]"],["パロ"],["は"],["モーセ"],["と"],["アロン"],["を"],["召","めし"],["て"],["言った","いった"],["、"],["「"],["かえる"],["を"],["わたし"],["と"],["、"],["わたし"],["の"],["民","たみ"],["から"],["取去る","とりさる"],["よう"],["に"],["主に","しゅに"],["願って","ねがって"],["ください"],["。"],["その"],["とき"],["わたし"],["は"],["この"],["民","たみ"],["を"],["去らせて","さらせて"],["、"],["主に","しゅに"],["犠牲","ぎせい"],["を"],["ささげさせるでしょう"],["」"],["。"]]},{"verse":5,"text":"[9]モーセはパロに言,いった、「あなたと、あなたの家来,けらいと、あなたの民,たみのために、わたしがいつ願,ねがって、このかえるを、あなたとあなたの家,いえから断,たって、ナイル川,かわだけにとどまらせるべきか、きめてください」。","tok":[["["],["9"],["]"],["モーセ"],["は"],["パロ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["と"],["、"],["あなた"],["の"],["家来","けらい"],["と"],["、"],["あなた"],["の"],["民","たみ"],["の"],["ため"],["に"],["、"],["わたし"],["が"],["いつ"],["願って","ねがって"],["、"],["この"],["かえる"],["を"],["、"],["あなた"],["と"],["あなた"],["の"],["家","いえ"],["から"],["断って","たって"],["、"],["ナイル"],["川","かわ"],["だけ"],["に"],["とどまらせるべき"],["か"],["、"],["きめて"],["ください"],["」"],["。"]]},{"verse":6,"text":"[10]パロは言,いった、「明日,みょうにち」。モーセは言,いった、「仰,おおせのとおりになって、わたしたちの神,かみ、主,しゅに並,ならぶもののないことを、あなたが知,しられますように。","tok":[["["],["10"],["]"],["パロ"],["は"],["言った","いった"],["、"],["「"],["明日","みょ"],["う"],["にち"],["」"],["。"],["モーセ"],["は"],["言った","いった"],["、"],["「"],["仰せ","おおせ"],["の"],["とおり"],["に"],["なって"],["、"],["わたしたち"],["の"],["神","かみ"],["、"],["主に","しゅに"],["並ぶ","ならぶ"],["もの"],["の"],["ない"],["こと"],["を"],["、"],["あなた"],["が"],["知られます","しられます"],["よう"],["に"],["。"]]},{"verse":7,"text":"[11]そして、かえるはあなたと、あなたの家,いえと、あなたの家来,けらいと、あなたの民,たみを離,はなれてナイル川,かわにだけとどまるでしょう」。","tok":[["["],["11"],["]"],["そして"],["、"],["かえる"],["は"],["あなた"],["と"],["、"],["あなた"],["の"],["家","いえ"],["と"],["、"],["あなた"],["の"],["家来","けらい"],["と"],["、"],["あなた"],["の"],["民","たみ"],["を"],["離れて","はなれて"],["ナイル"],["川","かわ"],["に"],["だけ"],["とどまるでしょう"],["」"],["。"]]},{"verse":8,"text":"[12]こうしてモーセとアロンはパロを離,はなれて出,でた。モーセは主,しゅがパロにつかわされたかえるの事,ことについて、主,しゅに呼,よび求,もとめたので、","tok":[["["],["12"],["]"],["こう"],["して"],["モーセ"],["と"],["アロン"],["は"],["パロ"],["を"],["離れて","はなれて"],["出た","でた"],["。"],["モーセ"],["は"],["主","しゅ"],["が"],["パロ"],["に"],["つかわされた"],["かえる"],["の"],["事","こと"],["について"],["、"],["主に","しゅに"],["呼び求めた","よびもとめた"],["ので"],["、"]]},{"verse":9,"text":"[13]主,しゅはモーセのことばのようにされ、かえるは家,いえから、庭,にわから、また畑,はたけから死,しに絶,たえた。","tok":[["["],["13"],["]"],["主","しゅ"],["は"],["モーセ"],["の"],["ことば"],["の"],["よう"],["に"],["され"],["、"],["かえる"],["は"],["家","いえ"],["から"],["、"],["庭","にわ"],["から"],["、"],["また"],["畑","はたけ"],["から"],["死に絶えた","しにたえた"],["。"]]},{"verse":10,"text":"[14]これをひと山,やまひと山,やまに積,つんだので、地,ちは臭,くさくなった。","tok":[["["],["14"],["]"],["これ"],["を"],["ひと"],["山","やま"],["ひと"],["山","やま"],["に"],["積","つんだ"],["ので"],["、"],["地","ち"],["は"],["臭く","くさく"],["なった"],["。"]]},{"verse":11,"text":"[15]ところがパロは息,いきつくひまのできたのを見,みて、主,しゅが言,いわれたように、その心,こころをかたくなにして彼,かれらの言,いうことを聞,きかなかった。","tok":[["["],["15"],["]"],["ところ"],["が"],["パロ"],["は"],["息","いき"],["つく"],["ひま"],["の"],["できた"],["の"],["を"],["見て","みて"],["、"],["主","しゅ"],["が"],["言われた","いわれた"],["よう"],["に"],["、"],["その"],["心","こころ"],["を"],["かたくな"],["に"],["して"],["彼","かれ"],["ら"],["の"],["言う","いう"],["こと"],["を"],["聞かなかった","きかなかった"],["。"]]},{"verse":12,"text":"[16]主,しゅはモーセに言,いわれた、「あなたはアロンに言,いいなさい、『あなたのつえをさし伸,のべて地,ちのちりを打,うち、それをエジプトの全国,ぜんこくにわたって、ぶよとならせなさい』と」。","tok":[["["],["16"],["]"],["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["は"],["アロン"],["に"],["言い","いい"],["なさい"],["、"],["『"],["あなた"],["の"],["つえ"],["を"],["さし伸べて","さしのべて"],["地","ち"],["の"],["ちり"],["を"],["打ち","うち"],["、"],["それ"],["を"],["エジプト"],["の"],["全国","ぜんこく"],["に"],["わたって"],["、"],["ぶよ"],["と"],["ならせ"],["なさい"],["』"],["と"],["」"],["。"]]},{"verse":13,"text":"[17]彼,かれらはそのように行,おこなった。すなわちアロンはそのつえをとって手,てをさし伸,のべ、地,ちのちりを打,うったので、ぶよは人,ひとと家畜,かちくについた。すなわち、地,ちのちりはみなエジプトの全国,ぜんこくにわたって、ぶよとなった。","tok":[["["],["17"],["]"],["彼","かれ"],["ら"],["は"],["その"],["よう"],["に"],["行なった","おこなった"],["。"],["すなわち"],["アロン"],["は"],["その"],["つえ"],["を"],["とって"],["手","て"],["を"],["さし伸べ","さしのべ"],["、"],["地","ち"],["の"],["ちり"],["を"],["打った","うった"],["ので"],["、"],["ぶよ"],["は"],["人","ひと"],["と"],["家畜","かちく"],["に"],["ついた"],["。"],["すなわち"],["、"],["地","ち"],["の"],["ちり"],["は"],["みな"],["エジプト"],["の"],["全国","ぜんこく"],["に"],["わたって"],["、"],["ぶよ"],["と"],["なった"],["。"]]},{"verse":14,"text":"[18]魔術,まじゅつ師,しらも秘術,ひじゅつをもって同,おなじように行,おこない、ぶよを出,だそうとしたが、彼,かれらにはできなかった。ぶよが人,ひとと家畜,かちくについたので、","tok":[["["],["18"],["]"],["魔術師","まじゅつし"],["ら"],["も"],["秘術","ひじゅつ"],["を"],["もって"],["同じ","おなじ"],["よう"],["に"],["行ない","おこない"],["、"],["ぶよ"],["を"],["出そう","だそう"],["と"],["した"],["が"],["、"],["彼","かれ"],["ら"],["に"],["は"],["できなかった"],["。"],["ぶよ"],["が"],["人","ひと"],["と"],["家畜","かちく"],["に"],["ついた"],["ので"],["、"]]},{"verse":15,"text":"[19]魔術,まじゅつ師,しらはパロに言,いった、「これは神,かみの指,ゆびです」。しかし主,しゅの言,いわれたように、パロの心,こころはかたくなになって、彼,かれらのいうことを聞,きかなかった。","tok":[["["],["19"],["]"],["魔術師","まじゅつし"],["ら"],["は"],["パロ"],["に"],["言った","いった"],["、"],["「"],["これ"],["は"],["神","かみ"],["の"],["指","ゆび"],["です"],["」"],["。"],["しかし"],["主","しゅ"],["の"],["言われた","いわれた"],["よう"],["に"],["、"],["パロ"],["の"],["心","こころ"],["は"],["かたくな"],["に"],["なって"],["、"],["彼","かれ"],["ら"],["の"],["いう"],["こと"],["を"],["聞かなかった","きかなかった"],["。"]]},{"verse":16,"text":"[20]主,しゅはモーセに言,いわれた、「あなたは朝,あさ早,はやく起,おきてパロの前,まえに立,たちなさい。ちょうど彼,かれは水,みずのところに出,でているから彼,かれに言,いいなさい、『主,しゅはこう仰,おおせられる、「わたしの民,たみを去,さらせて、わたしに仕,つかえさせなさい。","tok":[["["],["20"],["]"],["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["は"],["朝","あさ"],["早く","はやく"],["起きて","おきて"],["パロ"],["の"],["前","まえ"],["に"],["立","たち"],["なさい"],["。"],["ちょうど"],["彼","かれ"],["は"],["水","みず"],["の"],["ところ"],["に"],["出て","でて"],["いる"],["から"],["彼","かれ"],["に"],["言い","いい"],["なさい"],["、"],["『"],["主","しゅ"],["は"],["こう"],["仰せられる","おおせられる"],["、"],["「"],["わたし"],["の"],["民","たみ"],["を"],["去らせて","さらせて"],["、"],["わたし"],["に"],["仕えさせ","つかえさせ"],["なさい"],["。"]]},{"verse":17,"text":"[21]あなたがわたしの民,たみを去,さらせないならば、わたしは、あなたとあなたの家来,けらいと、あなたの民,たみとあなたの家,いえとに、あぶの群,むれをつかわすであろう。エジプトびとの家々,いえいえは、あぶの群,むれで満,みち、彼,かれらの踏,ふむ地,ちもまた、そうなるであろう。","tok":[["["],["21"],["]"],["あなた"],["が"],["わたし"],["の"],["民","たみ"],["を"],["去らせないならば","さらせないならば"],["、"],["わたし"],["は"],["、"],["あなた"],["と"],["あなた"],["の"],["家来","けらい"],["と"],["、"],["あなた"],["の"],["民","たみ"],["と"],["あなた"],["の"],["家","いえ"],["と"],["に"],["、"],["あぶ"],["の"],["群れ","むれ"],["を"],["つかわすで"],["あろう"],["。"],["エジプト"],["びと"],["の"],["家々","いえいえ"],["は"],["、"],["あぶ"],["の"],["群れ","むれ"],["で"],["満ち","みち"],["、"],["彼","かれ"],["ら"],["の"],["踏む","ふむ"],["地","ち"],["も"],["また"],["、"],["そう"],["なるで"],["あろう"],["。"]]},{"verse":18,"text":"[22]その日,ひわたしは、わたしの民,たみの住,すむゴセンの地,ちを区,く別,べっして、そこにあぶの群,むれを入,いれないであろう。国,くにの中,なかでわたしが主,しゅであることをあなたが知,しるためである。","tok":[["["],["22"],["]"],["その"],["日","ひ"],["わたし"],["は"],["、"],["わたし"],["の"],["民","たみ"],["の"],["住む","すむ"],["ゴセン"],["の"],["地","ち"],["を"],["区別","くべっ"],["して"],["、"],["そこ"],["に"],["あぶ"],["の"],["群れ","むれ"],["を"],["入れないで","いれないで"],["あろう"],["。"],["国","くに"],["の"],["中","なか"],["で"],["わたし"],["が"],["主","しゅ"],["で"],["ある"],["こと"],["を"],["あなた"],["が"],["知る","しる"],["ため"],["で"],["ある"],["。"]]},{"verse":19,"text":"[23]わたしはわたしの民,たみとあなたの民,たみの間,あいだに区別,くべつをおく。このしるしは、あす起,おこるであろう」と』」。","tok":[["["],["23"],["]"],["わたし"],["は"],["わたし"],["の"],["民","たみ"],["と"],["あなた"],["の"],["民","たみ"],["の"],["間","あいだ"],["に"],["区別","くべつ"],["を"],["おく"],["。"],["この"],["しるし"],["は"],["、"],["あす"],["起こるで","おこるで"],["あろう"],["」"],["と"],["』"],["」"],["。"]]},{"verse":20,"text":"[24]主,しゅはそのようにされたので、おびただしいあぶが、パロの家,いえと、その家来,けらいの家,いえと、エジプトの全国,ぜんこくにはいってきて、地,ちはあぶの群,むれのために害,がいをうけた。","tok":[["["],["24"],["]"],["主","しゅ"],["は"],["その"],["よう"],["に"],["された"],["ので"],["、"],["おびただしい"],["あぶ"],["が"],["、"],["パロ"],["の"],["家","いえ"],["と"],["、"],["その"],["家来","けらい"],["の"],["家","いえ"],["と"],["、"],["エジプト"],["の"],["全国","ぜんこく"],["に"],["はいって"],["きて"],["、"],["地","ち"],["は"],["あぶ"],["の"],["群れ","むれ"],["の"],["ため"],["に"],["害","がい"],["を"],["うけた"],["。"]]},{"verse":21,"text":"[25]そこで、パロはモーセとアロンを召,めして言,いった、「あなたがたは行,いってこの国,くにの内,うちで、あなたがたの神,かみに犠牲,ぎせいをささげなさい」。","tok":[["["],["25"],["]"],["そこ"],["で"],["、"],["パロ"],["は"],["モーセ"],["と"],["アロン"],["を"],["召","めし"],["て"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["行って","いって"],["この"],["国","くに"],["の"],["内","うち"],["で"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["に"],["犠牲","ぎせい"],["を"],["ささげ"],["なさい"],["」"],["。"]]},{"verse":22,"text":"[26]モーセは言,いった、「そうすることはできません。わたしたちはエジプトびとの忌,いむものを犠牲,ぎせいとして、わたしたちの神,かみ、主,しゅにささげるからです。もし、エジプトびとの目,めの前,まえで、彼,かれらの忌,いむものを犠牲,ぎせいにささげるならば、彼,かれらはわたしたちを石,いしで打,うたないでしょうか。","tok":[["["],["26"],["]"],["モーセ"],["は"],["言った","いった"],["、"],["「"],["そう"],["する"],["こと"],["は"],["できません"],["。"],["わたしたち"],["は"],["エジプト"],["びと"],["の"],["忌む","いむ"],["もの"],["を"],["犠牲","ぎせい"],["として"],["、"],["わたしたち"],["の"],["神","かみ"],["、"],["主に","しゅに"],["ささげる"],["から"],["です"],["。"],["もし"],["、"],["エジプト"],["びと"],["の"],["目","め"],["の"],["前","まえ"],["で"],["、"],["彼","かれ"],["ら"],["の"],["忌む","いむ"],["もの"],["を"],["犠牲","ぎせい"],["に"],["ささげるならば"],["、"],["彼","かれ"],["ら"],["は"],["わたしたち"],["を"],["石","いし"],["で"],["打たないでしょう","うたないでしょう"],["か"],["。"]]},{"verse":23,"text":"[27]わたしたちは三日,かの道,みちのりほど、荒野,あらのにはいって、わたしたちの神,かみ、主,しゅに犠牲,ぎせいをささげ、主,しゅがわたしたちに命,めいじられるようにしなければなりません」。","tok":[["["],["27"],["]"],["わたしたち"],["は"],["三日","か"],["の"],["道のり","みちのり"],["ほど"],["、"],["荒野","あら"],["のに"],["はいって"],["、"],["わたしたち"],["の"],["神","かみ"],["、"],["主に","しゅに"],["犠牲","ぎせい"],["を"],["ささげ"],["、"],["主","しゅ"],["が"],["わたしたち"],["に"],["命じられる","めいじられる"],["よう"],["に"],["しなければ"],["なりません"],["」"],["。"]]},{"verse":24,"text":"[28]パロは言,いった、「わたしはあなたがたを去,さらせ、荒野,あらので、あなたがたの神,かみ、主,しゅに犠牲,ぎせいをささげさせよう。ただあまり遠,とおくへ行,いってはならない。わたしのために祈願,きがんしなさい」。","tok":[["["],["28"],["]"],["パロ"],["は"],["言った","いった"],["、"],["「"],["わたし"],["は"],["あなた"],["がた"],["を"],["去らせ","さらせ"],["、"],["荒野","あらの"],["で"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主に","しゅに"],["犠牲","ぎせい"],["を"],["ささげさせよう"],["。"],["ただ"],["あまり"],["遠く","とおく"],["へ"],["行って","いって"],["は"],["ならない"],["。"],["わたし"],["の"],["ため"],["に"],["祈願","きがん"],["し"],["なさい"],["」"],["。"]]},{"verse":25,"text":"[29]モーセは言,いった、「わたしはあなたのもとから出,でて行,いって主,しゅに祈願,きがんしましょう。あすあぶの群,むれがパロと、その家来,けらいと、その民,たみから離,はなれるでしょう。ただパロはまた欺,あざむいて、民,たみが主,しゅに犠牲,ぎせいをささげに行,いくのをとめないようにしてください」。","tok":[["["],["29"],["]"],["モーセ"],["は"],["言った","いった"],["、"],["「"],["わたし"],["は"],["あなた"],["の"],["もと"],["から"],["出て","でて"],["行って","いって"],["主に","しゅに"],["祈願","きがん"],["しましょう"],["。"],["あす"],["あぶ"],["の"],["群れ","むれ"],["が"],["パロ"],["と"],["、"],["その"],["家来","けらい"],["と"],["、"],["その"],["民","たみ"],["から"],["離れるでしょう","はなれるでしょう"],["。"],["ただ"],["パロ"],["は"],["また"],["欺いて","あざむいて"],["、"],["民","た"],["み"],["が"],["主に","しゅに"],["犠牲","ぎせい"],["を"],["ささげ"],["に"],["行く","いく"],["の"],["を"],["とめない"],["よう"],["に"],["して"],["ください"],["」"],["。"]]},{"verse":26,"text":"[30]こうしてモーセはパロのもとを出,でて、主,しゅに祈願,きがんしたので、","tok":[["["],["30"],["]"],["こう"],["して"],["モーセ"],["は"],["パロ"],["の"],["もと"],["を"],["出て","でて"],["、"],["主に","しゅに"],["祈願","きがん"],["した"],["ので"],["、"]]},{"verse":27,"text":"[31]主,しゅはモーセの言葉,ことばのようにされた。すなわち、あぶの群,むれをパロと、その家来,けらいと、その民,たみから取,とり去,さられたので、一つも残,のこらなかった。","tok":[["["],["31"],["]"],["主","しゅ"],["は"],["モーセ"],["の"],["言葉","ことば"],["の"],["よう"],["に"],["された"],["。"],["すなわち"],["、"],["あぶ"],["の"],["群れ","むれ"],["を"],["パロ"],["と"],["、"],["その"],["家来","けらい"],["と"],["、"],["その"],["民","たみ"],["から"],["取去られた","とりさられた"],["ので"],["、"],["一","ひと"],["つ"],["も"],["残らなかった","のこらなかった"],["。"]]},{"verse":28,"text":"[32]しかしパロはこんどもまた、その心,こころをかたくなにして民,たみを去,さらせなかった。","tok":[["["],["32"],["]"],["しかし"],["パロ"],["は"],["こんど"],["も"],["また"],["、"],["その"],["心","こころ"],["を"],["かたくな"],["に"],["して"],["民","たみ"],["を"],["去らせなかった","さらせなかった"],["。"]]}]
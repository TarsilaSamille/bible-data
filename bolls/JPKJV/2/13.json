[{"verse":1,"text":"主,しゅはモーセに言,いわれた、","tok":[["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":2,"text":"「イスラエルの人々,ひとびとのうちで、すべてのういご、すなわちすべて初,はじめに胎,たいを開,ひらいたものを、人,ひとであれ、獣,けものであれ、みな、わたしのために聖別,せいべつしなければならない。それはわたしのものである」。","tok":[["「"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["うち"],["で"],["、"],["すべて"],["の"],["うい"],["ご"],["、"],["すなわち"],["すべて"],["初め","はじめ"],["に"],["胎","たい"],["を"],["開らいた","ひらいた"],["もの"],["を"],["、"],["人","ひと"],["で"],["あれ"],["、"],["獣","けもの"],["で"],["あれ"],["、"],["みな"],["、"],["わたし"],["の"],["ため"],["に"],["聖別","せいべつ"],["しなければ"],["ならない"],["。"],["それ"],["は"],["わたし"],["の"],["もの"],["で"],["ある"],["」"],["。"]]},{"verse":3,"text":"モーセは民,たみに言,いった、「あなたがたは、エジプトから、奴隷,どれいの家,いえから出,でるこの日,ひを覚,おぼえなさい。主,しゅが強,つよい手,てをもって、あなたがたをここから導,みちびき出,だされるからである。種,たねを入,いれたパンを食,たべてはならない。","tok":[["モーセ"],["は"],["民","たみ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["、"],["エジプト"],["から"],["、"],["奴隷","どれい"],["の"],["家","いえ"],["から"],["出る","でる"],["この"],["日","ひ"],["を"],["覚え","おぼえ"],["なさい"],["。"],["主","しゅ"],["が"],["強い","つよい"],["手","て"],["を"],["もって"],["、"],["あなた"],["がた"],["を"],["ここ"],["から"],["導き出される","みちびきだされる"],["から"],["で"],["ある"],["。"],["種","たね"],["を"],["入れた","いれた"],["パン"],["を"],["食べて","たべて"],["は"],["ならない"],["。"]]},{"verse":4,"text":"あなたがたはアビブの月,つきのこの日,ひに出,でるのである。","tok":[["あなた"],["がた"],["は"],["アビブ"],["の"],["月","つき"],["の"],["この"],["日","ひ"],["に"],["出る","でる"],["ので"],["ある"],["。"]]},{"verse":5,"text":"主,しゅがあなたに与,あたえると、あなたの先祖,せんぞたちに誓,ちかわれたカナンびと、ヘテびと、アモリびと、ヒビびと、エブスびとの地,ち、乳,ちちと蜜,みつとの流,ながれる地,ちに、導,みちびき入,いれられる時,とき、あなたはこの月,つきにこの儀式,ぎしきを守,まもらなければならない。","tok":[["主","しゅ"],["が"],["あなた"],["に"],["与える","あたえる"],["と"],["、"],["あなた"],["の"],["先祖","せんぞ"],["たち"],["に"],["誓われた","ちかわれた"],["カナン"],["び"],["と"],["、"],["ヘテ"],["び"],["と"],["、"],["アモリ"],["び"],["と"],["、"],["ヒビ"],["び"],["と"],["、"],["エブス"],["びと"],["の"],["地","ち"],["、"],["乳","ちち"],["と"],["蜜","みつ"],["と"],["の"],["流れる","ながれる"],["地","ち"],["に"],["、"],["導き入れられる","みちびきいれられる"],["時","とき"],["、"],["あなた"],["は"],["この"],["月","つき"],["に"],["この"],["儀式","ぎしき"],["を"],["守らなければ","まもらなければ"],["ならない"],["。"]]},{"verse":6,"text":"七日,なぬかのあいだ種,たね入,いれぬパンを食,たべ、七日,なぬか目,めには主,しゅに祭,まつりをしなければならない。","tok":[["七日","なぬか"],["の"],["あいだ"],["種","た"],["ね"],["入れぬ","いれぬ"],["パン"],["を"],["食べ","たべ"],["、"],["七日","な"],["ぬか目","ぬかめ"],["に"],["は"],["主に","しゅに"],["祭","まつり"],["を"],["しなければ"],["ならない"],["。"]]},{"verse":7,"text":"種,たね入,いれぬパンを七日,なぬかのあいだ食,たべなければならない。種,たねを入,いれたパンをあなたの所,ところに置,おいてはならない。また、あなたの地区,ちくのどこでも、あなたの所,ところにパン種,だねを置,おいてはならない。","tok":[["種","た"],["ね"],["入れぬ","いれぬ"],["パン"],["を"],["七","しち"],["日","にち"],["の"],["あいだ"],["食べなければ","たべなければ"],["ならない"],["。"],["種","たね"],["を"],["入れた","いれた"],["パン"],["を"],["あなた"],["の"],["所","ところ"],["に"],["置いて","おいて"],["は"],["ならない"],["。"],["また"],["、"],["あなた"],["の"],["地区","ちく"],["の"],["どこ"],["で"],["も"],["、"],["あなた"],["の"],["所","ところ"],["に"],["パン種","ぱんだね"],["を"],["置いて","おいて"],["は"],["ならない"],["。"]]},{"verse":8,"text":"その日,ひ、あなたの子,こに告,つげて言,いいなさい、『これはわたしがエジプトから出,でるときに、主,しゅがわたしになされたことのためである』。","tok":[["その"],["日","ひ"],["、"],["あなた"],["の"],["子","こ"],["に"],["告","つげ"],["て"],["言い","いい"],["なさい"],["、"],["『"],["これ"],["は"],["わたし"],["が"],["エジプト"],["から"],["出る","でる"],["とき"],["に"],["、"],["主","しゅ"],["が"],["わたし"],["に"],["なされた"],["こと"],["の"],["ため"],["で"],["ある"],["』"],["。"]]},{"verse":9,"text":"そして、これを、手,てにつけて、しるしとし、目,めの間,あいだに置,おいて記念,きねんとし、主,しゅの律法,りっぽうをあなたの口,くちに置,おかなければならない。主,しゅが強,つよい手,てをもって、あなたをエジプトから導,みちびき出,だされるからである。","tok":[["そして"],["、"],["これ"],["を"],["、"],["手","て"],["に"],["つけて"],["、"],["しるし"],["と"],["し"],["、"],["目","め"],["の"],["間","あいだ"],["に"],["置いて","おいて"],["記念","きねん"],["と"],["し"],["、"],["主","しゅ"],["の"],["律法","りっぽう"],["を"],["あなた"],["の"],["口","くち"],["に"],["置かなければ","おかなければ"],["ならない"],["。"],["主","しゅ"],["が"],["強い","つよい"],["手","て"],["を"],["もって"],["、"],["あなた"],["を"],["エジプト"],["から"],["導き出される","みちびきだされる"],["から"],["で"],["ある"],["。"]]},{"verse":10,"text":"それゆえ、あなたはこの定,さだめを年々,ねんねんその期節,きせつに守,まもらなければならない。","tok":[["それ"],["ゆえ"],["、"],["あなた"],["は"],["この"],["定め","さだめ"],["を"],["年々","ねんねん"],["その"],["期","き"],["節","せつ"],["に"],["守らなければ","まもらなければ"],["ならない"],["。"]]},{"verse":11,"text":"主,しゅがあなたとあなたの先祖,せんぞたちに誓,ちかわれたように、あなたをカナンびとの地,ちに導,みちびいて、それをあなたに賜,たまわる時,とき、","tok":[["主","しゅ"],["が"],["あなた"],["と"],["あなた"],["の"],["先祖","せんぞ"],["たち"],["に"],["誓われた","ちかわれた"],["よう"],["に"],["、"],["あなた"],["を"],["カナン"],["びと"],["の"],["地","ち"],["に"],["導いて","みちびいて"],["、"],["それ"],["を"],["あなた"],["に"],["賜わる","たまわる"],["時","とき"],["、"]]},{"verse":12,"text":"あなたは、すべて初,はじめに胎,たいを開,ひらいた者,もの、およびあなたの家畜,かちくの産,うむういごは、ことごとく主,しゅにささげなければならない。すなわち、それらの男性,だんせいのものは主,しゅに帰,きせしめなければならない。","tok":[["あなた"],["は"],["、"],["すべて"],["初め","はじめ"],["に"],["胎","たい"],["を"],["開らいた","ひらいた"],["者","もの"],["、"],["および"],["あなた"],["の"],["家畜","かちく"],["の"],["産む","うむ"],["うい"],["ご"],["は"],["、"],["ことごとく"],["主に","しゅに"],["ささげなければ"],["ならない"],["。"],["すなわち"],["、"],["それ"],["ら"],["の"],["男性","だんせい"],["の"],["もの"],["は"],["主に","しゅに"],["帰せしめなければ","きせしめなければ"],["ならない"],["。"]]},{"verse":13,"text":"また、すべて、ろばの、初,はじめて胎,たいを開,ひらいたものは、小羊,こひつじをもって、あがなわなければならない。もし、あがなわないならば、その首,くびを折,おらなければならない。あなたの子,こらのうち、すべて、男,おとこのういごは、あがなわなければならない。","tok":[["また"],["、"],["すべて"],["、"],["ろば"],["の"],["、"],["初めて","はじめて"],["胎","たい"],["を"],["開らいた","ひらいた"],["もの"],["は"],["、"],["小羊","こひつじ"],["を"],["もって"],["、"],["あがなわなければ"],["ならない"],["。"],["もし"],["、"],["あがなわないならば"],["、"],["その"],["首","くび"],["を"],["折らなければ","おらなければ"],["ならない"],["。"],["あなた"],["の"],["子","こ"],["ら"],["の"],["うち"],["、"],["すべて"],["、"],["男","おとこ"],["の"],["うい"],["ご"],["は"],["、"],["あがなわなければ"],["ならない"],["。"]]},{"verse":14,"text":"後,のちになって、あなたの子,こが『これはどんな意味,いみですか』と問,とうならば、これに言,いわなければならない、『主,しゅが強,つよい手,てをもって、われわれをエジプトから、奴隷,どれいの家,いえから導,みちびき出,だされた。","tok":[["後","のち"],["に"],["なって"],["、"],["あなた"],["の"],["子","こ"],["が"],["『"],["これ"],["は"],["どんな"],["意味","いみ"],["です"],["か"],["』"],["と"],["問うならば","とうならば"],["、"],["これ"],["に"],["言わなければ","いわなければ"],["ならない"],["、"],["『"],["主","しゅ"],["が"],["強い","つよい"],["手","て"],["を"],["もって"],["、"],["われわれ"],["を"],["エジプト"],["から"],["、"],["奴隷","どれい"],["の"],["家","いえ"],["から"],["導き出された","みちびきだされた"],["。"]]},{"verse":15,"text":"そのときパロが、かたくなで、われわれを去,さらせなかったため、主,しゅはエジプトの国,くにのういごを、人,ひとのういごも家畜,かちくのういごも、ことごとく殺,ころされた。それゆえ、初,はじめて胎,たいを開,ひらく男性,だんせいのものはみな、主,しゅに犠牲,ぎせいとしてささげるが、わたしの子供,こどものうちのういごは、すべてあがなうのである』。","tok":[["その"],["とき"],["パロ"],["が"],["、"],["かたくな"],["で"],["、"],["われわれ"],["を"],["去らせなかった","さらせなかった"],["ため"],["、"],["主","しゅ"],["は"],["エジプト"],["の"],["国","くに"],["の"],["うい"],["ご"],["を"],["、"],["人","ひと"],["の"],["うい"],["ご"],["も"],["家畜","かちく"],["の"],["うい"],["ご"],["も"],["、"],["ことごとく"],["殺ろされた","ころされた"],["。"],["それ"],["ゆえ"],["、"],["初めて","はじめて"],["胎","たい"],["を"],["開らく","ひらく"],["男性","だんせい"],["の"],["もの"],["は"],["みな"],["、"],["主に","しゅに"],["犠牲","ぎせい"],["として"],["ささげる"],["が"],["、"],["わたし"],["の"],["子供","こども"],["の"],["うち"],["の"],["うい"],["ご"],["は"],["、"],["すべて"],["あがなう"],["ので"],["ある"],["』"],["。"]]},{"verse":16,"text":"そして、これを手,てにつけて、しるしとし、目,めの間,あいだに置,おいて覚,おぼえとしなければならない。主,しゅが強,つよい手,てをもって、われわれをエジプトから導,みちびき出,だされたからである」。","tok":[["そして"],["、"],["これ"],["を"],["手","て"],["に"],["つけて"],["、"],["しるし"],["と"],["し"],["、"],["目","め"],["の"],["間","あいだ"],["に"],["置いて","おいて"],["覚え","おぼえ"],["と"],["しなければ"],["ならない"],["。"],["主","しゅ"],["が"],["強い","つよい"],["手","て"],["を"],["もって"],["、"],["われわれ"],["を"],["エジプト"],["から"],["導き出された","みちびきだされた"],["から"],["で"],["ある"],["」"],["。"]]},{"verse":17,"text":"さて、パロが民,たみを去,さらせた時,とき、ペリシテびとの国,くにの道,みちは近,ちかかったが、神,かみは彼,かれらをそれに導,みちびかれなかった。民,たみが戦,たたかいを見,みれば悔,くいてエジプトに帰,かえるであろうと、神,かみは思,おもわれたからである。","tok":[["さて"],["、"],["パロ"],["が"],["民","たみ"],["を"],["去らせた","さらせた"],["時","とき"],["、"],["ペリシテ"],["びと"],["の"],["国","くに"],["の"],["道","みち"],["は"],["近かった","ちかかった"],["が"],["、"],["神","かみ"],["は"],["彼","かれ"],["ら"],["を"],["それ"],["に"],["導かれなかった","みちびかれなかった"],["。"],["民","た"],["み"],["が"],["戦い","たたかい"],["を"],["見れば","みれば"],["悔いて","くいて"],["エジプト"],["に"],["帰えるで","かえるで"],["あろう"],["と"],["、"],["神","かみ"],["は"],["思われた","おもわれた"],["から"],["で"],["ある"],["。"]]},{"verse":18,"text":"神,かみは紅海,こうかいに沿,そう荒野,あらのの道,みちに、民,たみを回,まわらされた。イスラエルの人々,ひとびとは武装,ぶそうしてエジプトの国,くにを出,でて、上,のぼった。","tok":[["神","かみ"],["は"],["紅海","こうかい"],["に"],["沿う","そう"],["荒野","あらの"],["の"],["道","みち"],["に"],["、"],["民","たみ"],["を"],["回わら","まわら"],["された"],["。"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["武装","ぶそう"],["して"],["エジプト"],["の"],["国","くに"],["を"],["出て","でて"],["、"],["上った","のぼった"],["。"]]},{"verse":19,"text":"そのときモーセはヨセフの遺骸,いがいを携,たずさえていた。ヨセフが、「神,かみは必,かならずあなたがたを顧,かえりみられるであろう。そのとき、あなたがたは、わたしの遺骸,いがいを携,たずさえて、ここから上,のぼって行,いかなければならない」と言,いって、イスラエルの人々,ひとびとに固,かたく誓,ちかわせたからである。","tok":[["その"],["とき"],["モーセ"],["は"],["ヨセフ"],["の"],["遺骸","いがい"],["を"],["携えて","たずさえて"],["いた"],["。"],["ヨセフ"],["が"],["、"],["「"],["神","かみ"],["は"],["必","かならず"],["あなた"],["がた"],["を"],["顧られるで","かえりみられるで"],["あろう"],["。"],["その"],["とき"],["、"],["あなた"],["がた"],["は"],["、"],["わたし"],["の"],["遺骸","いがい"],["を"],["携えて","たずさえて"],["、"],["ここ"],["から"],["上って","のぼって"],["行かなければ","いかなければ"],["ならない"],["」"],["と"],["言って","いって"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["固く","かたく"],["誓わせた","ちかわせた"],["から"],["で"],["ある"],["。"]]},{"verse":20,"text":"こうして彼,かれらは更,さらにスコテから進,すすんで、荒野,あらのの端,はしにあるエタムに宿営,しゅくえいした。","tok":[["こう"],["して"],["彼","かれ"],["ら"],["は"],["更に","さらに"],["スコテ"],["から"],["進んで","すすんで"],["、"],["荒野","あら"],["の"],["の"],["端","はし"],["に"],["ある"],["エタム"],["に"],["宿営","しゅくえい"],["した"],["。"]]},{"verse":21,"text":"主,しゅは彼,かれらの前,まえに行,いかれ、昼,ひるは雲,くもの柱,はしらをもって彼,かれらを導,みちびき、夜,よるは火,ひの柱,はしらをもって彼,かれらを照,てらし、昼,ひるも夜,よるも彼,かれらを進,すすみ行,いかせられた。","tok":[["主","しゅ"],["は"],["彼","かれ"],["ら"],["の"],["前","まえ"],["に"],["行かれ","いかれ"],["、"],["昼","ひる"],["は"],["雲","くも"],["の"],["柱","はしら"],["を"],["もって"],["彼","かれ"],["ら"],["を"],["導き","みちびき"],["、"],["夜","よる"],["は"],["火","ひ"],["の"],["柱","はしら"],["を"],["もって"],["彼","かれ"],["ら"],["を"],["照","てらし"],["、"],["昼","ひる"],["も"],["夜","よる"],["も"],["彼","かれ"],["ら"],["を"],["進み","すすみ"],["行かせられた","いかせられた"],["。"]]},{"verse":22,"text":"昼,ひるは雲,くもの柱,はしら、夜,よるは火,ひの柱,はしらが、民,たみの前,まえから離,はなれなかった。","tok":[["昼","ひる"],["は"],["雲","くも"],["の"],["柱","はしら"],["、"],["夜","よる"],["は"],["火","ひ"],["の"],["柱","はしら"],["が"],["、"],["民","たみ"],["の"],["前","まえ"],["から"],["離れなかった","はなれなかった"],["。"]]}]
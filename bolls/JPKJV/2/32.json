[{"verse":1,"text":"民,たみはモーセが山,やまを下,くだることのおそいのを見,みて、アロンのもとに集,あつまって彼,かれに言,いった、「さあ、わたしたちに先立,さきだって行,ゆく神,かみを、わたしたちのために造,つくってください。わたしたちをエジプトの国,くにから導,みちびきのぼった人,ひと、あのモーセはどうなったのかわからないからです」。","tok":[["民","たみ"],["は"],["モーセ"],["が"],["山","やま"],["を"],["下る","くだる"],["こと"],["の"],["おそい"],["の"],["を"],["見て","みて"],["、"],["アロン"],["の"],["もと"],["に"],["集まって","あつまって"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["さあ"],["、"],["わたしたち"],["に"],["先立って","さきだって"],["行く","ゆく"],["神","かみ"],["を"],["、"],["わたしたち"],["の"],["ため"],["に"],["造って","つくって"],["ください"],["。"],["わたしたち"],["を"],["エジプト"],["の"],["国","くに"],["から"],["導き","みちびき"],["のぼった"],["人","ひと"],["、"],["あの"],["モーセ"],["は"],["どう"],["なった"],["の"],["か"],["わからない"],["から"],["です"],["」"],["。"]]},{"verse":2,"text":"アロンは彼,かれらに言,いった、「あなたがたの妻,つま、むすこ、娘,むすめらの金,きんの耳輪,みみわをはずしてわたしに持,もってきなさい」。","tok":[["アロン"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["の"],["妻","つま"],["、"],["むすこ"],["、"],["娘","むすめ"],["ら"],["の"],["金","きん"],["の"],["耳輪","みみわ"],["を"],["はずして"],["わたし"],["に"],["持って","もって"],["き"],["なさい"],["」"],["。"]]},{"verse":3,"text":"そこで民,たみは皆,みなその金,きんの耳輪,みみわをはずしてアロンのもとに持,もってきた。","tok":[["そこ"],["で"],["民","たみ"],["は"],["皆","みな"],["その"],["金","きん"],["の"],["耳輪","みみわ"],["を"],["はずして"],["アロン"],["の"],["もと"],["に"],["持って","もって"],["きた"],["。"]]},{"verse":4,"text":"アロンがこれを彼,かれらの手,てから受,うけ取,とり、工具,こうぐで型,かたを造,つくり、鋳,いて子,こ牛,うしとしたので、彼,かれらは言,いった、「イスラエルよ、これはあなたをエジプトの国,くにから導,みちびきのぼったあなたの神,かみである」。","tok":[["アロン"],["が"],["これ"],["を"],["彼","かれ"],["ら"],["の"],["手","て"],["から"],["受け","うけ"],["取","とり"],["、"],["工具","こうぐ"],["で"],["型","かた"],["を"],["造","つくり"],["、"],["鋳て","いて"],["子牛","こうし"],["と"],["した"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["言った","いった"],["、"],["「"],["イスラエル"],["よ"],["、"],["これ"],["は"],["あなた"],["を"],["エジプト"],["の"],["国","くに"],["から"],["導き","みちびき"],["のぼった"],["あなた"],["の"],["神","かみ"],["で"],["ある"],["」"],["。"]]},{"verse":5,"text":"アロンはこれを見,みて、その前,まえに祭壇,さいだんを築,きずいた。そしてアロンは布告,ふこくして言,いった、「あすは主,しゅの祭,まつりである」。","tok":[["アロン"],["は"],["これ"],["を"],["見て","みて"],["、"],["その"],["前","まえ"],["に"],["祭壇","さいだん"],["を"],["築いた","きずいた"],["。"],["そして"],["アロン"],["は"],["布告","ふこく"],["して"],["言った","いった"],["、"],["「"],["あす"],["は"],["主","しゅ"],["の"],["祭","まつり"],["で"],["ある"],["」"],["。"]]},{"verse":6,"text":"そこで人々,ひとびとはあくる朝,あさ早,はやく起,おきて燔祭,はんさいをささげ、酬恩祭,しゅうおんさいを供,そなえた。民,たみは座,ざして食,くい飲,のみし、立,たって戯,ざれた。","tok":[["そこ"],["で"],["人々","ひとびと"],["は"],["あくる"],["朝","あさ"],["早く","はやく"],["起きて","おきて"],["燔祭","はんさい"],["を"],["ささげ"],["、"],["酬恩祭","しゅうおんさい"],["を"],["供えた","そなえた"],["。"],["民","たみ"],["は"],["座して","ざして"],["食い","くい"],["飲み","のみ"],["し"],["、"],["立って","たって"],["戯れた","ざれた"],["。"]]},{"verse":7,"text":"主,しゅはモーセに言,いわれた、「急,いそいで下,くだりなさい。あなたがエジプトの国,くにから導,みちびきのぼったあなたの民,たみは悪,わるいことをした。","tok":[["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"],["「"],["急いで","いそいで"],["下","く"],["だり"],["なさい"],["。"],["あなた"],["が"],["エジプト"],["の"],["国","くに"],["から"],["導き","みちびき"],["のぼった"],["あなた"],["の"],["民","たみ"],["は"],["悪い","わるい"],["こと"],["を"],["した"],["。"]]},{"verse":8,"text":"彼,かれらは早,はやくもわたしが命,めいじた道,みちを離,はなれ、自分,じぶんのために鋳物,いものの子,こ牛,うしを造,つくり、これを拝,おがみ、これに犠牲,ぎせいをささげて、『イスラエルよ、これはあなたをエジプトの国,くにから導,みちびきのぼったあなたの神,かみである』と言,いっている」。","tok":[["彼","かれ"],["ら"],["は"],["早く","はやく"],["も"],["わたし"],["が"],["命じた","めいじた"],["道","みち"],["を"],["離れ","はなれ"],["、"],["自分","じぶん"],["の"],["ため"],["に"],["鋳物","いもの"],["の"],["子牛","こうし"],["を"],["造","つくり"],["、"],["これ"],["を"],["拝み","おがみ"],["、"],["これ"],["に"],["犠牲","ぎせい"],["を"],["ささげて"],["、"],["『"],["イスラエル"],["よ"],["、"],["これ"],["は"],["あなた"],["を"],["エジプト"],["の"],["国","くに"],["から"],["導き","みちびき"],["のぼった"],["あなた"],["の"],["神","かみ"],["で"],["ある"],["』"],["と"],["言って","いって"],["いる"],["」"],["。"]]},{"verse":9,"text":"主,しゅはまたモーセに言,いわれた、「わたしはこの民,たみを見,みた。これはかたくなな民,たみである。","tok":[["主","しゅ"],["は"],["また"],["モーセ"],["に"],["言われた","いわれた"],["、"],["「"],["わたし"],["は"],["この"],["民","たみ"],["を"],["見た","みた"],["。"],["これ"],["は"],["かたくな"],["な"],["民","たみ"],["で"],["ある"],["。"]]},{"verse":10,"text":"それで、わたしをとめるな。わたしの怒,いかりは彼,かれらにむかって燃,もえ、彼,かれらを滅,ほろぼしつくすであろう。しかし、わたしはあなたを大,おおいなる国民,こくみんとするであろう」。","tok":[["それ"],["で"],["、"],["わたし"],["を"],["とめる"],["な"],["。"],["わたし"],["の"],["怒り","いかり"],["は"],["彼","かれ"],["ら"],["に"],["むかって"],["燃え","もえ"],["、"],["彼","かれ"],["ら"],["を"],["滅ぼし","ほろぼし"],["つくすで"],["あろう"],["。"],["しかし"],["、"],["わたし"],["は"],["あなた"],["を"],["大いなる","おおいなる"],["国民","こくみん"],["と"],["するで"],["あろう"],["」"],["。"]]},{"verse":11,"text":"モーセはその神,かみ、主,しゅをなだめて言,いった、「主,しゅよ、大,おおいなる力,ちからと強,つよき手,てをもって、エジプトの国,くにから導,みちびき出,だされたあなたの民,たみにむかって、なぜあなたの怒,いかりが燃,もえるのでしょうか。","tok":[["モーセ"],["は"],["その"],["神","かみ"],["、"],["主","しゅ"],["を"],["なだめて"],["言った","いった"],["、"],["「"],["主","しゅ"],["よ"],["、"],["大いなる","おおいなる"],["力","ちから"],["と"],["強き手","つよきて"],["を"],["もって"],["、"],["エジプト"],["の"],["国","くに"],["から"],["導き出された","みちびきだされた"],["あなた"],["の"],["民","たみ"],["に"],["むかって"],["、"],["なぜ"],["あなた"],["の"],["怒り","いかり"],["が"],["燃える","もえる"],["の"],["でしょう"],["か"],["。"]]},{"verse":12,"text":"どうしてエジプトびとに『彼,かれは悪意,あくいをもって彼,かれらを導,みちびき出,だし、彼,かれらを山地,さんちで殺,ころし、地,ちの面,めんから断,たち滅,ほろぼすのだ』と言,いわせてよいでしょうか。どうかあなたの激,はげしい怒,いかりをやめ、あなたの民,たみに下,くだそうとされるこの災,わざわいを思,おもい直,なおし、","tok":[["どう"],["して"],["エジプト"],["びと"],["に"],["『"],["彼","かれ"],["は"],["悪意","あくい"],["を"],["もって"],["彼","かれ"],["ら"],["を"],["導き出し","みちびきだし"],["、"],["彼","かれ"],["ら"],["を"],["山地","さんち"],["で"],["殺ろし","ころし"],["、"],["地","ち"],["の"],["面","めん"],["から"],["断ち","たち"],["滅ぼす","ほろぼす"],["の"],["だ"],["』"],["と"],["言わせて","いわせて"],["よいでしょう"],["か"],["。"],["どう"],["か"],["あなた"],["の"],["激しい","はげしい"],["怒り","いかり"],["を"],["やめ"],["、"],["あなた"],["の"],["民","たみ"],["に"],["下そう","くだそう"],["と"],["される"],["この"],["災","わざわい"],["を"],["思い直し","おもいなおし"],["、"]]},{"verse":13,"text":"あなたのしもべアブラハム、イサク、イスラエルに、あなたが御,ご自身,じしんをさして誓,ちかい、『わたしは天,てんの星,ほしのように、あなたがたの子孫,しそんを増,まし、わたしが約束,やくそくしたこの地,ちを皆,みなあなたがたの子孫,しそんに与,あたえて、長,ながくこれを所有,しょゆうさせるであろう』と彼,かれらに仰,おおせられたことを覚,おぼえてください」。","tok":[["あなた"],["の"],["しもべ"],["アブラハム"],["、"],["イサク"],["、"],["イスラエル"],["に"],["、"],["あなた"],["が"],["御自身","ごじしん"],["を"],["さして"],["誓い","ちかい"],["、"],["『"],["わたし"],["は"],["天","てん"],["の"],["星","ほし"],["の"],["よう"],["に"],["、"],["あなた"],["がた"],["の"],["子孫","しそん"],["を"],["増し","まし"],["、"],["わたし"],["が"],["約束","やくそく"],["した"],["この"],["地","ち"],["を"],["皆","みな"],["あなた"],["がた"],["の"],["子孫","しそん"],["に"],["与","あたえ"],["て"],["、"],["長く","ながく"],["これ"],["を"],["所有","しょゆう"],["させるで"],["あろう"],["』"],["と"],["彼","かれ"],["ら"],["に"],["仰せられた","おおせられた"],["こと"],["を"],["覚えて","おぼえて"],["ください"],["」"],["。"]]},{"verse":14,"text":"それで、主,しゅはその民,たみに下,くだすと言,いわれた災,わざわいについて思,おもい直,なおされた。","tok":[["それ"],["で"],["、"],["主","しゅ"],["は"],["その"],["民","たみ"],["に"],["下す","くだす"],["と"],["言われた","いわれた"],["災","わざわい"],["について"],["思い直された","おもいなおされた"],["。"]]},{"verse":15,"text":"モーセは身,みを転,てんじて山,やまを下,くだった。彼,かれの手,てには、かの二枚,まいのあかしの板,いたがあった。板,いたはその両面,りょうめんに文字,もじがあった。すなわち、この面,めんにも、かの面,めんにも文字,もじがあった。","tok":[["モーセ"],["は"],["身","み"],["を"],["転じて","てんじて"],["山","やま"],["を"],["下った","くだった"],["。"],["彼","かれ"],["の"],["手","て"],["に"],["は"],["、"],["かの"],["二枚","まい"],["の"],["あかし"],["の"],["板","いた"],["が"],["あった"],["。"],["板","いた"],["は"],["その"],["両面","りょうめん"],["に"],["文字","もじ"],["が"],["あった"],["。"],["すなわち"],["、"],["この"],["面","めん"],["に"],["も"],["、"],["かの"],["面","めん"],["に"],["も"],["文字","もじ"],["が"],["あった"],["。"]]},{"verse":16,"text":"その板,いたは神,かみの作,さく、その文字,もじは神,かみの文字,もじであって、板,いたに彫,ほったものである。","tok":[["その"],["板","いた"],["は"],["神","かみ"],["の"],["作","さく"],["、"],["その"],["文字","もじ"],["は"],["神","かみ"],["の"],["文字","もじ"],["で"],["あって"],["、"],["板","いた"],["に"],["彫った","ほった"],["もの"],["で"],["ある"],["。"]]},{"verse":17,"text":"ヨシュアは民,たみの呼,よばわる声,こえを聞,きいて、モーセに言,いった、「宿営,しゅくえいの中,なかに戦,たたかいの声,こえがします」。","tok":[["ヨシュア"],["は"],["民","たみ"],["の"],["呼ばわる","よばわる"],["声","こえ"],["を"],["聞いて","きいて"],["、"],["モーセ"],["に"],["言った","いった"],["、"],["「"],["宿営","しゅくえい"],["の"],["中","なか"],["に"],["戦い","たたかい"],["の"],["声","こえ"],["が"],["します"],["」"],["。"]]},{"verse":18,"text":"しかし、モーセは言,いった、「勝,かちどきの声,こえでなく、敗北,はいぼくの叫,さけび声,ごえでもない。わたしの聞,きくのは歌,うたの声,こえである」。","tok":[["しかし"],["、"],["モーセ"],["は"],["言った","いった"],["、"],["「"],["勝どき","かちどき"],["の"],["声","こえ"],["で"],["なく"],["、"],["敗北","はいぼく"],["の"],["叫声","さけびごえ"],["で"],["も"],["ない"],["。"],["わたし"],["の"],["聞く","きく"],["の"],["は"],["歌","うた"],["の"],["声","こえ"],["で"],["ある"],["」"],["。"]]},{"verse":19,"text":"モーセが宿営,しゅくえいに近,ちかづくと、子,こ牛,うしと踊,おどりとを見,みたので、彼,かれは怒,いかりに燃,もえ、手,てからかの板,いたを投,なげうち、これを山,やまのふもとで砕,くだいた。","tok":[["モーセ"],["が"],["宿営","しゅくえい"],["に"],["近づく","ちかづく"],["と"],["、"],["子牛","こうし"],["と"],["踊","おどり"],["と"],["を"],["見た","みた"],["ので"],["、"],["彼","かれ"],["は"],["怒り","いかり"],["に"],["燃え","もえ"],["、"],["手","て"],["から"],["か"],["の"],["板","いた"],["を"],["投","なげ"],["うち"],["、"],["これ"],["を"],["山","やま"],["の"],["ふもと"],["で"],["砕いた","くだいた"],["。"]]},{"verse":20,"text":"また彼,かれらが造,つくった子,こ牛,うしを取,とって火,ひに焼,やき、こなごなに砕,くだき、これを水,みずの上,うえにまいて、イスラエルの人々,ひとびとに飲,のませた。","tok":[["また"],["彼","かれ"],["ら"],["が"],["造った","つくった"],["子牛","こうし"],["を"],["取って","とって"],["火","ひ"],["に"],["焼き","やき"],["、"],["こなごな"],["に"],["砕き","くだき"],["、"],["これ"],["を"],["水","みず"],["の"],["上","うえ"],["に"],["まいて"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["飲ませた","のませた"],["。"]]},{"verse":21,"text":"モーセはアロンに言,いった、「この民,たみがあなたに何,なにをしたので、あなたは彼,かれらに大,おおいなる罪,つみを犯,おかさせたのですか」。","tok":[["モーセ"],["は"],["アロン"],["に"],["言った","いった"],["、"],["「"],["この"],["民","たみ"],["が"],["あなた"],["に"],["何に","なに"],["を"],["した"],["ので"],["、"],["あなた"],["は"],["彼","かれ"],["ら"],["に"],["大いなる","おおいなる"],["罪","つみ"],["を"],["犯させた","おかさせた"],["の"],["です"],["か"],["」"],["。"]]},{"verse":22,"text":"アロンは言,いった、「わが主,しゅよ、激,はげしく怒,いからないでください。この民,たみの悪,わるいのは、あなたがごぞんじです。","tok":[["アロン"],["は"],["言った","いった"],["、"],["「"],["わが"],["主","しゅ"],["よ"],["、"],["激しく","はげしく"],["怒らないで","いからないで"],["ください"],["。"],["この"],["民","たみ"],["の"],["悪い","わるい"],["の"],["は"],["、"],["あなた"],["が"],["ごぞんじ"],["です"],["。"]]},{"verse":23,"text":"彼,かれらはわたしに言,いいました、『わたしたちに先立,さきだって行,いく神,かみを、わたしたちのために造,つくってください。わたしたちをエジプトの国,くにから導,みちびきのぼった人,ひと、あのモーセは、どうなったのかわからないからです』。","tok":[["彼","かれ"],["ら"],["は"],["わたし"],["に"],["言いました","いいました"],["、"],["『"],["わたしたち"],["に"],["先立って","さきだって"],["行く","いく"],["神","かみ"],["を"],["、"],["わたしたち"],["の"],["ため"],["に"],["造って","つくって"],["ください"],["。"],["わたしたち"],["を"],["エジプト"],["の"],["国","くに"],["から"],["導き","みちびき"],["のぼった"],["人","ひと"],["、"],["あの"],["モーセ"],["は"],["、"],["どう"],["なった"],["の"],["か"],["わからない"],["から"],["です"],["』"],["。"]]},{"verse":24,"text":"そこでわたしは『だれでも、金,きんを持,もっている者,ものは、それを取,とりはずしなさい』と彼,かれらに言,いいました。彼,かれらがそれをわたしに渡,わたしたので、わたしがこれを火,ひに投,なげ入,いれると、この子,こ牛,うしが出,でてきたのです」。","tok":[["そこ"],["で"],["わたし"],["は"],["『"],["だれ"],["で"],["も"],["、"],["金","きん"],["を"],["持って","もって"],["いる"],["者","もの"],["は"],["、"],["それ"],["を"],["取","とり"],["はずし"],["なさい"],["』"],["と"],["彼","かれ"],["ら"],["に"],["言いました","いいました"],["。"],["彼","かれ"],["ら"],["が"],["それ"],["を"],["わたし"],["に"],["渡","わたし"],["た"],["ので"],["、"],["わたし"],["が"],["これ"],["を"],["火","ひ"],["に"],["投入れる","なげいれる"],["と"],["、"],["この"],["子牛","こうし"],["が"],["出て","でて"],["きた"],["の"],["です"],["」"],["。"]]},{"verse":25,"text":"モーセは民,たみがほしいままにふるまったのを見,みた。アロンは彼,かれらがほしいままにふるまうに任,まかせ、敵,てきの中,なかに物笑,ものわらいとなったからである。","tok":[["モーセ"],["は"],["民","たみ"],["が"],["ほしいまま"],["に"],["ふるまった"],["の"],["を"],["見た","みた"],["。"],["アロン"],["は"],["彼","かれ"],["ら"],["が"],["ほしいまま"],["に"],["ふるまう"],["に"],["任せ","まかせ"],["、"],["敵","てき"],["の"],["中","なか"],["に"],["物","もの"],["笑","わらい"],["と"],["なった"],["から"],["で"],["ある"],["。"]]},{"verse":26,"text":"モーセは宿営,しゅくえいの門,もんに立,たって言,いった、「すべて主,しゅにつく者,ものはわたしのもとにきなさい」。レビの子,こたちはみな彼,かれのもとに集,あつまった。","tok":[["モーセ"],["は"],["宿営","しゅくえい"],["の"],["門","もん"],["に"],["立って","たって"],["言った","いった"],["、"],["「"],["すべて"],["主に","しゅに"],["つく"],["者","もの"],["は"],["わたし"],["の"],["もと"],["に"],["き"],["なさい"],["」"],["。"],["レビ"],["の"],["子","こ"],["たち"],["は"],["みな"],["彼","かれ"],["の"],["もと"],["に"],["集まった","あつまった"],["。"]]},{"verse":27,"text":"そこでモーセは彼,かれらに言,いった、「イスラエルの神,かみ、主,しゅはこう言,いわれる、『あなたがたは、おのおの腰,こしにつるぎを帯,おび、宿営,しゅくえいの中,なかを門,もんから門,もんへ行,いき巡,めぐって、おのおのその兄弟,きょうだい、その友,とも、その隣人,りんじんを殺,ころせ』」。","tok":[["そこ"],["で"],["モーセ"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["イスラエル"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["『"],["あなた"],["がた"],["は"],["、"],["おのおの"],["腰","こし"],["に"],["つるぎ"],["を"],["帯","おび"],["、"],["宿営","しゅくえい"],["の"],["中","なか"],["を"],["門","もん"],["から"],["門","もん"],["へ"],["行き","いき"],["巡って","めぐって"],["、"],["おのおの"],["その"],["兄弟","きょうだい"],["、"],["その"],["友","とも"],["、"],["その"],["隣人","りんじん"],["を"],["殺ろせ","ころせ"],["』"],["」"],["。"]]},{"verse":28,"text":"レビの子,こたちはモーセの言葉,ことばどおりにしたので、その日,ひ、民,たみのうち、おおよそ三千人,にんが倒,たおれた。","tok":[["レビ"],["の"],["子","こ"],["たち"],["は"],["モーセ"],["の"],["言葉","ことば"],["どおり"],["に"],["した"],["ので"],["、"],["その"],["日","ひ"],["、"],["民","たみ"],["の"],["うち"],["、"],["おおよそ"],["三千人","にん"],["が"],["倒れた","たおれた"],["。"]]},{"verse":29,"text":"そこで、モーセは言,いった、「あなたがたは、おのおのその子,こ、その兄弟,きょうだいに逆,さからって、きょう、主,しゅに身,みをささげた。それで主,しゅは、きょう、あなたがたに祝福,しゅくふくを与,あたえられるであろう」。","tok":[["そこ"],["で"],["、"],["モーセ"],["は"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["、"],["おのおの"],["その"],["子","こ"],["、"],["その"],["兄弟","きょうだい"],["に"],["逆らって","さからって"],["、"],["きょう"],["、"],["主に","しゅに"],["身","み"],["を"],["ささげた"],["。"],["それ"],["で"],["主","しゅ"],["は"],["、"],["きょう"],["、"],["あなた"],["がた"],["に"],["祝福","しゅくふく"],["を"],["与えられるで","あたえられるで"],["あろう"],["」"],["。"]]},{"verse":30,"text":"あくる日,ひ、モーセは民,たみに言,いった、「あなたがたは大,おおいなる罪,つみを犯,おかした。それで今,いま、わたしは主,しゅのもとに上,のぼって行,いく。あなたがたの罪,つみを償,つぐなうことが、できるかも知,しれない」。","tok":[["あくる日","あくるひ"],["、"],["モーセ"],["は"],["民","たみ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["大いなる","おおいなる"],["罪","つみ"],["を"],["犯した","おかした"],["。"],["それ"],["で"],["今","いま"],["、"],["わたし"],["は"],["主","しゅ"],["の"],["もと"],["に"],["上って","のぼって"],["行く","いく"],["。"],["あなた"],["がた"],["の"],["罪","つみ"],["を"],["償なう","つぐなう"],["こと"],["が"],["、"],["できる"],["か"],["も"],["知れない","しれない"],["」"],["。"]]},{"verse":31,"text":"モーセは主,しゅのもとに帰,かえって、そして言,いった、「ああ、この民,たみは大,おおいなる罪,つみを犯,おかし、自分,じぶんのために金,きんの神,かみを造,つくりました。","tok":[["モーセ"],["は"],["主","しゅ"],["の"],["もと"],["に"],["帰えって","かえって"],["、"],["そして"],["言った","いった"],["、"],["「"],["ああ"],["、"],["この"],["民","たみ"],["は"],["大いなる","おおいなる"],["罪","つみ"],["を"],["犯し","おかし"],["、"],["自分","じぶん"],["の"],["ため"],["に"],["金","きん"],["の"],["神","かみ"],["を"],["造","つくり"],["ました"],["。"]]},{"verse":32,"text":"今,いまもしあなたが、彼,かれらの罪,つみをゆるされますならば――。しかし、もしかなわなければ、どうぞあなたが書,かきしるされたふみから、わたしの名,なを消,けし去,さってください」。","tok":[["今","いま"],["もし"],["あなた"],["が"],["、"],["彼","かれ"],["ら"],["の"],["罪","つみ"],["を"],["ゆるされますならば"],["―"],["―"],["。"],["しかし"],["、"],["もし"],["かなわなければ"],["、"],["どうぞ"],["あなた"],["が"],["書きしるされた","かきしるされた"],["ふみ"],["から"],["、"],["わたし"],["の"],["名","な"],["を"],["消し","けし"],["去て","さって"],["ください"],["」"],["。"]]},{"verse":33,"text":"主,しゅはモーセに言,いわれた、「すべてわたしに罪,つみを犯,おかした者,ものは、これをわたしのふみから消,けし去,さるであろう。","tok":[["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"],["「"],["すべて"],["わたし"],["に"],["罪","つみ"],["を"],["犯した","おかした"],["者","もの"],["は"],["、"],["これ"],["を"],["わたし"],["の"],["ふみ"],["から"],["消し去るで","けしさるで"],["あろう"],["。"]]},{"verse":34,"text":"しかし、今,いまあなたは行,いって、わたしがあなたに告,つげたところに民,たみを導,みちびきなさい。見,みよ、わたしの使,つかいはあなたに先立,さきだって行,いくであろう。ただし刑罰,けいばつの日,ひに、わたしは彼,かれらの罪,つみを罰,ばっするであろう」。","tok":[["しかし"],["、"],["今","いま"],["あなた"],["は"],["行って","いって"],["、"],["わたし"],["が"],["あなた"],["に"],["告","つげ"],["た"],["ところ"],["に"],["民","たみ"],["を"],["導き","みちびき"],["なさい"],["。"],["見よ","みよ"],["、"],["わたし"],["の"],["使い","つかい"],["は"],["あなた"],["に"],["先立って","さきだって"],["行くで","いくで"],["あろう"],["。"],["ただし"],["刑罰","けいばつ"],["の"],["日","ひ"],["に"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["罪","つみ"],["を"],["罰するで","ばっするで"],["あろう"],["」"],["。"]]},{"verse":35,"text":"そして主,しゅは民,たみを撃,うたれた。彼,かれらが子,こ牛,うしを造,つくったからである。それはアロンが造,つくったのである。","tok":[["そして"],["主","しゅ"],["は"],["民","たみ"],["を"],["撃たれた","うたれた"],["。"],["彼","かれ"],["ら"],["が"],["子牛","こうし"],["を"],["造った","つくった"],["から"],["で"],["ある"],["。"],["それ"],["は"],["アロン"],["が"],["造った","つくった"],["ので"],["ある"],["。"]]}]
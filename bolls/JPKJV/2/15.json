[{"verse":1,"text":"そこでモーセとイスラエルの人々,ひとびとは、この歌,うたを主,しゅにむかって歌,うたった。彼,かれらは歌,うたって言,いった、「主,しゅにむかってわたしは歌,うたおう、彼,かれは輝,かがやかしくも勝,かちを得,えられた、彼,かれは馬,うまと乗,のり手,てを海,うみに投,なげ込,こまれた。","tok":[["そこ"],["で"],["モーセ"],["と"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["、"],["この"],["歌","うた"],["を"],["主に","しゅに"],["むか"],["って"],["歌った","うたった"],["。"],["彼","かれ"],["ら"],["は"],["歌","うた"],["って"],["言った","いった"],["、"],["「"],["主に","しゅに"],["むかって"],["わたし"],["は"],["歌おう","うたおう"],["、"],["彼","かれ"],["は"],["輝やかしく","かがやかしく"],["も"],["勝","かち"],["を"],["得られた","えられた"],["、"],["彼","かれ"],["は"],["馬","うま"],["と"],["乗手","のりて"],["を"],["海","うみ"],["に"],["投込まれた","なげこまれた"],["。"]]},{"verse":2,"text":"主,しゅはわたしの力,ちからまた歌,うた、わたしの救,すくいとなられた、彼,かれこそわたしの神,かみ、わたしは彼,かれをたたえる、彼,かれはわたしの父,ちちの神,かみ、わたしは彼,かれをあがめる。","tok":[["主","しゅ"],["は"],["わたし"],["の"],["力また","ちからまた"],["歌","うた"],["、"],["わたし"],["の"],["救い","すくい"],["と"],["なられた"],["、"],["彼","かれ"],["こそ"],["わたし"],["の"],["神","かみ"],["、"],["わたし"],["は"],["彼","かれ"],["を"],["たたえる"],["、"],["彼","かれ"],["は"],["わたし"],["の"],["父","ちち"],["の"],["神","かみ"],["、"],["わたし"],["は"],["彼","かれ"],["を"],["あがめる"],["。"]]},{"verse":3,"text":"主,しゅはいくさびと、その名,なは主,しゅ。","tok":[["主","しゅ"],["は"],["いく"],["さび"],["と"],["、"],["その"],["名","な"],["は"],["主","しゅ"],["。"]]},{"verse":4,"text":"彼,かれはパロの戦車,せんしゃとその軍勢,ぐんぜいとを海,うみに投,なげ込,こまれた、そのすぐれた指揮者,しきしゃたちは紅海,こうかいに沈,しずんだ。","tok":[["彼","かれ"],["は"],["パロ"],["の"],["戦車","せんしゃ"],["と"],["その"],["軍勢","ぐんぜい"],["と"],["を"],["海","うみ"],["に"],["投込まれた","なげこまれた"],["、"],["その"],["すぐれた"],["指揮者","しきしゃ"],["たち"],["は"],["紅海","こうかい"],["に"],["沈んだ","しずんだ"],["。"]]},{"verse":5,"text":"大水,おおみずは彼,かれらをおおい、彼,かれらは石,いしのように淵,ふちに下,くだった。","tok":[["大水","おおみず"],["は"],["彼","かれ"],["ら"],["を"],["おおい"],["、"],["彼","かれ"],["ら"],["は"],["石","いし"],["の"],["よう"],["に"],["淵","ふち"],["に"],["下った","くだった"],["。"]]},{"verse":6,"text":"主,しゅよ、あなたの右,みぎの手,ては力,ちからをもって栄光,えいこうにかがやく、主,しゅよ、あなたの右,みぎの手,ては敵,てきを打,うち砕,くだく。","tok":[["主","しゅ"],["よ"],["、"],["あなた"],["の"],["右","みぎ"],["の"],["手","て"],["は"],["力","ちから"],["を"],["もって"],["栄光","えいこう"],["に"],["かがやく"],["、"],["主","しゅ"],["よ"],["、"],["あなた"],["の"],["右","みぎ"],["の"],["手","て"],["は"],["敵","てき"],["を"],["打ち砕く","うちくだく"],["。"]]},{"verse":7,"text":"あなたは大,おおいなる威光,いこうをもって、あなたに立,たちむかう者,ものを打,うち破,やぶられた。あなたが怒,いかりを発,はっせられると、彼,かれらは、わらのように焼,やきつくされた。","tok":[["あなた"],["は"],["大いなる","おおいなる"],["威光","いこう"],["を"],["もって"],["、"],["あなた"],["に"],["立ちむかう","たちむかう"],["者","もの"],["を"],["打ち破られた","うちやぶられた"],["。"],["あなた"],["が"],["怒り","いかり"],["を"],["発せられる","はっせられる"],["と"],["、"],["彼","かれ"],["ら"],["は"],["、"],["わら"],["の"],["よう"],["に"],["焼き","やき"],["つくされた"],["。"]]},{"verse":8,"text":"あなたの鼻,はなの息,いきによって水,みずは積,つみかさなり、流,ながれは堤,つつみとなって立,たち、大水,おおみずは海,うみのもなかに凝,こり固,かたまった。","tok":[["あなた"],["の"],["鼻","はな"],["の"],["息","いき"],["によって"],["水","みず"],["は"],["積みかさなり","つみかさなり"],["、"],["流れ","ながれ"],["は"],["堤","つつみ"],["と"],["なって"],["立ち","たち"],["、"],["大水","おおみず"],["は"],["海","うみ"],["の"],["もなか"],["に"],["凝り固まった","こりかたまった"],["。"]]},{"verse":9,"text":"敵,てきは言,いった、『わたしは追,おい行,いき、追,おい着,ついて、分,ぶん捕物,とりものを分,わかち取,とろう、わたしの欲望,よくぼうを彼,かれらによって満,みたそう、つるぎを抜,ぬこう、わたしの手,ては彼,かれらを滅,ほろぼそう』。","tok":[["敵","てき"],["は"],["言った","いった"],["、"],["『"],["わたし"],["は"],["追い","おい"],["行き","いき"],["、"],["追い着いて","おいついて"],["、"],["分","ぶん"],["捕物","とりもの"],["を"],["分かち","わかち"],["取ろう","とろう"],["、"],["わたし"],["の"],["欲望","よくぼう"],["を"],["彼","かれ"],["ら"],["によって"],["満たそう","みたそう"],["、"],["つるぎ"],["を"],["抜こう","ぬこう"],["、"],["わたし"],["の"],["手","て"],["は"],["彼","かれ"],["ら"],["を"],["滅ぼそう","ほろぼそう"],["』"],["。"]]},{"verse":10,"text":"あなたが息,いきを吹,ふかれると、海,うみは彼,かれらをおおい、彼,かれらは鉛,なまりのように、大水,おおみずの中,なかに沈,しずんだ。","tok":[["あなた"],["が"],["息","いき"],["を"],["吹かれる","ふかれる"],["と"],["、"],["海","うみ"],["は"],["彼","かれ"],["ら"],["を"],["おおい"],["、"],["彼","かれ"],["ら"],["は"],["鉛","なまり"],["の"],["よう"],["に"],["、"],["大水","おおみず"],["の"],["中","なか"],["に"],["沈んだ","しずんだ"],["。"]]},{"verse":11,"text":"主,しゅよ、神々,かみがみのうち、だれがあなたに比,くらべられようか、だれがあなたのように、聖,せいにして栄,さかえあるもの、ほむべくして恐,おそるべきもの、くすしきわざを行,おこなうものであろうか。","tok":[["主","しゅ"],["よ"],["、"],["神々","かみがみ"],["の"],["うち"],["、"],["だれ"],["が"],["あなた"],["に"],["比べられよう","くらべられよう"],["か"],["、"],["だれ"],["が"],["あなた"],["の"],["よう"],["に"],["、"],["聖","せい"],["に"],["して"],["栄","さかえ"],["ある"],["もの"],["、"],["ほ"],["むべく"],["して"],["恐るべき","おそるべき"],["もの"],["、"],["くす"],["しき"],["わざ"],["を"],["行なう","おこなう"],["もの"],["で"],["あろう"],["か"],["。"]]},{"verse":12,"text":"あなたが右,みぎの手,てを伸,のべられると、地,ちは彼,かれらをのんだ。","tok":[["あなた"],["が"],["右","みぎ"],["の"],["手","て"],["を"],["伸べられる","のべられる"],["と"],["、"],["地","ち"],["は"],["彼","かれ"],["ら"],["を"],["のんだ"],["。"]]},{"verse":13,"text":"あなたは、あがなわれた民,たみを恵,めぐみをもって導,みちびき、み力,ちからをもって、あなたの聖,せいなるすまいに伴,ともなわれた。","tok":[["あなた"],["は"],["、"],["あがなわれた"],["民","たみ"],["を"],["恵","めぐみ"],["を"],["もって"],["導き","みちびき"],["、"],["み力","みちから"],["を"],["もって"],["、"],["あなた"],["の"],["聖","せい"],["なる"],["すまい"],["に"],["伴なわれた","ともなわれた"],["。"]]},{"verse":14,"text":"もろもろの民,たみは聞,きいて震,ふるえ、ペリシテの住民,じゅうみんは苦,くるしみに襲,おそわれた。","tok":[["もろもろ"],["の"],["民","たみ"],["は"],["聞いて","きいて"],["震え","ふるえ"],["、"],["ペリシテ"],["の"],["住民","じゅうみん"],["は"],["苦しみ","くるしみ"],["に"],["襲れた","おそわれた"],["。"]]},{"verse":15,"text":"エドムの族長,ぞくちょうらは、おどろき、モアブの首長,しゅちょうらは、わななき、カナンの住民,じゅうみんは、みな溶,とけ去,さった。","tok":[["エドム"],["の"],["族長","ぞくちょう"],["ら"],["は"],["、"],["おどろき"],["、"],["モアブ"],["の"],["首長","しゅちょう"],["ら"],["は"],["、"],["わななき"],["、"],["カナン"],["の"],["住民","じゅうみん"],["は"],["、"],["みな"],["溶け","とけ"],["去た","さった"],["。"]]},{"verse":16,"text":"恐,おそれと、おののきとは彼,かれらに臨,のぞみ、み腕,うでの大,おおいなるゆえに、彼,かれらは石,いしのように黙,もくした、主,しゅよ、あなたの民,たみの通,とおりすぎるまで、あなたが買,かいとられた民,たみの通,とおりすぎるまで。","tok":[["恐","おそれ"],["と"],["、"],["おののき"],["と"],["は"],["彼","かれ"],["ら"],["に"],["臨み","のぞみ"],["、"],["み腕","みうで"],["の"],["大いなる","おおいなる"],["ゆえ"],["に"],["、"],["彼","かれ"],["ら"],["は"],["石","いし"],["の"],["よう"],["に"],["黙した","もくした"],["、"],["主","しゅ"],["よ"],["、"],["あなた"],["の"],["民","たみ"],["の"],["通","とおり"],["すぎる"],["まで"],["、"],["あなた"],["が"],["買","かい"],["とられた"],["民","たみ"],["の"],["通","とおり"],["すぎる"],["まで"],["。"]]},{"verse":17,"text":"あなたは彼,かれらを導,みちびいて、あなたの嗣,し業,ぎょうの山,やまに植,うえられる。主,しゅよ、これこそあなたのすまいとして、みずから造,つくられた所,ところ、主,しゅよ、み手,てによって建,たてられた聖所,せいじょ。","tok":[["あなた"],["は"],["彼","かれ"],["ら"],["を"],["導いて","みちびいて"],["、"],["あなた"],["の"],["嗣業","しぎょう"],["の"],["山","やま"],["に"],["植えられる","うえられる"],["。"],["主","しゅ"],["よ"],["、"],["これ"],["こそ"],["あなた"],["の"],["すまい"],["として"],["、"],["みずから"],["造られた","つくられた"],["所","ところ"],["、"],["主","しゅ"],["よ"],["、"],["み手","みて"],["によって"],["建てられた","たてられた"],["聖所","せ"],["い"],["じょ"],["。"]]},{"verse":18,"text":"主,しゅは永遠,えいえんに統,すべ治,おさめられる」。","tok":[["主","しゅ"],["は"],["永遠","えいえん"],["に"],["統べ治められる","すべおさめられる"],["」"],["。"]]},{"verse":19,"text":"パロの馬,うまが、その戦車,せんしゃおよび騎兵,きへいと共,ともに海,うみにはいると、主,しゅは海,うみの水,みずを彼,かれらの上,うえに流,ながれ返,かえらされたが、イスラエルの人々,ひとびとは海,うみの中,なかのかわいた地,ちを行,おこなった。","tok":[["パロ"],["の"],["馬","うま"],["が"],["、"],["その"],["戦車","せんしゃ"],["および"],["騎兵","きへい"],["と"],["共","とも"],["に"],["海","うみ"],["に"],["はいる"],["と"],["、"],["主","しゅ"],["は"],["海","うみ"],["の"],["水","みず"],["を"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["流れ","ながれ"],["返ら","かえら"],["された"],["が"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["海","うみ"],["の"],["中","なか"],["の"],["かわいた"],["地","ち"],["を"],["行なった","おこなった"],["。"]]},{"verse":20,"text":"そのとき、アロンの姉,あね、女,おんな預言者,よげんしゃミリアムはタンバリンを手,てに取,とり、女,おんなたちも皆,みなタンバリンを取,とって、踊,おどりながら、そのあとに従,したがって出,でてきた。","tok":[["その"],["とき"],["、"],["アロン"],["の"],["姉","あね"],["、"],["女","おんな"],["預言者","よげんしゃ"],["ミリアム"],["は"],["タンバリン"],["を"],["手","て"],["に"],["取","とり"],["、"],["女","おんな"],["たち"],["も"],["皆","みな"],["タンバリン"],["を"],["取って","とって"],["、"],["踊","おどり"],["ながら"],["、"],["その"],["あと"],["に"],["従って","したがって"],["出て","でて"],["きた"],["。"]]},{"verse":21,"text":"そこでミリアムは彼,かれらに和,わして歌,うたった、「主,しゅにむかって歌,うたえ、彼,かれは輝,かがやかしくも勝,かちを得,えられた、彼,かれは馬,うまと乗,のり手,てを海,うみに投,なげ込,こまれた」。","tok":[["そこ"],["で"],["ミリアム"],["は"],["彼","かれ"],["ら"],["に"],["和して","わして"],["歌った","うたった"],["、"],["「"],["主に","しゅに"],["むかって"],["歌え","うたえ"],["、"],["彼","かれ"],["は"],["輝やかしく","かがやかしく"],["も"],["勝","かち"],["を"],["得られた","えられた"],["、"],["彼","かれ"],["は"],["馬","うま"],["と"],["乗手","のりて"],["を"],["海","うみ"],["に"],["投込まれた","なげこまれた"],["」"],["。"]]},{"verse":22,"text":"さて、モーセはイスラエルを紅海,こうかいから旅立,たびだたせた。彼,かれらはシュルの荒野,あらのに入,いり、三日,かのあいだ荒野,あらのを歩,あるいたが、水,みずを得,えなかった。","tok":[["さて"],["、"],["モーセ"],["は"],["イスラエル"],["を"],["紅海","こうかい"],["から"],["旅立たせた","たびだたせた"],["。"],["彼","かれ"],["ら"],["は"],["シュル"],["の"],["荒野","あらの"],["に"],["入","いり"],["、"],["三日","か"],["の"],["あいだ"],["荒野","あらの"],["を"],["歩いた","あるいた"],["が"],["、"],["水","みず"],["を"],["得なかった","えなかった"],["。"]]},{"verse":23,"text":"彼,かれらはメラに着,ついたが、メラの水,みずは苦,にがくて飲,のむことができなかった。それで、その所,ところの名,なはメラと呼,よばれた。","tok":[["彼","かれ"],["ら"],["は"],["メラ"],["に"],["着いた","ついた"],["が"],["、"],["メラ"],["の"],["水","みず"],["は"],["苦くて","にがくて"],["飲む","のむ"],["こと"],["が"],["できなかった"],["。"],["それ"],["で"],["、"],["その"],["所","ところ"],["の"],["名","な"],["は"],["メラ"],["と"],["呼ばれた","よばれた"],["。"]]},{"verse":24,"text":"ときに、民,たみはモーセにつぶやいて言,いった、「わたしたちは何,なにを飲,のむのですか」。","tok":[["とき"],["に"],["、"],["民","たみ"],["は"],["モーセ"],["に"],["つぶやいて"],["言った","いった"],["、"],["「"],["わたしたち"],["は"],["何に","なに"],["を"],["飲む","のむ"],["の"],["です"],["か"],["」"],["。"]]},{"verse":25,"text":"モーセは主,しゅに叫,さけんだ。主,しゅは彼,かれに一本,ぽんの木,きを示,しめされたので、それを水,みずに投,なげ入,いれると、水,みずは甘,あまくなった。その所,ところで主,しゅは民,たみのために定,さだめと、おきてを立,たてられ、彼,かれらを試,こころみて、","tok":[["モーセ"],["は"],["主に","しゅに"],["叫けんだ","さけんだ"],["。"],["主","しゅ"],["は"],["彼","かれ"],["に"],["一本","ぽん"],["の"],["木","き"],["を"],["示めされた","しめされた"],["ので"],["、"],["それ"],["を"],["水","みず"],["に"],["投入れる","なげいれる"],["と"],["、"],["水","みず"],["は"],["甘く","あまく"],["なった"],["。"],["その"],["所","ところ"],["で"],["主","しゅ"],["は"],["民","たみ"],["の"],["ため"],["に"],["定め","さだめ"],["と"],["、"],["おきて"],["を"],["立られ","たてられ"],["、"],["彼","かれ"],["ら"],["を"],["試みて","こころみて"],["、"]]},{"verse":26,"text":"言,いわれた、「あなたが、もしあなたの神,かみ、主,しゅの声,こえに良,よく聞,きき従,したがい、その目,めに正,ただしいと見,みられることを行,おこない、その戒,いましめに耳,みみを傾,かたむけ、すべての定,さだめを守,まもるならば、わたしは、かつてエジプトびとに下,くだした病,やまいを一つもあなたに下,くださないであろう。わたしは主,しゅであって、あなたをいやすものである」。","tok":[["言われた","いわれた"],["、"],["「"],["あなた"],["が"],["、"],["もし"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["声","こえ"],["に"],["良く","よく"],["聞","きき"],["従い","したがい"],["、"],["その"],["目","め"],["に"],["正い","ただしい"],["と"],["見られる","みられる"],["こと"],["を"],["行ない","おこない"],["、"],["その"],["戒しめ","いましめ"],["に"],["耳","みみ"],["を"],["傾むけ","かたむけ"],["、"],["すべて"],["の"],["定め","さだめ"],["を"],["守","まもる"],["ならば"],["、"],["わたし"],["は"],["、"],["かつて"],["エジプト"],["びと"],["に"],["下した","くだした"],["病","やまい"],["を"],["一","ひと"],["つ"],["も"],["あなた"],["に"],["下さないで","くださないで"],["あろう"],["。"],["わたし"],["は"],["主","しゅ"],["で"],["あって"],["、"],["あなた"],["を"],["いやす"],["もの"],["で"],["ある"],["」"],["。"]]},{"verse":27,"text":"こうして彼,かれらはエリムに着,ついた。そこには水,みずの泉,いずみ十二と、なつめやしの木,き七十本,ぽんがあった。その所,ところで彼,かれらは水,みずのほとりに宿営,しゅくえいした。","tok":[["こう"],["して"],["彼","かれ"],["ら"],["は"],["エリム"],["に"],["着いた","ついた"],["。"],["そこ"],["に"],["は"],["水","みず"],["の"],["泉","いずみ"],["十二","じゅうに"],["と"],["、"],["なつめやし"],["の"],["木","き"],["七十本","ぽん"],["が"],["あった"],["。"],["その"],["所","ところ"],["で"],["彼","かれ"],["ら"],["は"],["水","みず"],["の"],["ほとり"],["に"],["宿営","しゅくえい"],["した"],["。"]]}]
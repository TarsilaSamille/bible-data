[{"verse":1,"text":"イスラエルの人々,ひとびとの全,ぜん会衆,かいしゅうはエリムを出発,しゅっぱつし、エジプトの地,ちを出,でて二か月,げつ目,めの十五日,にちに、エリムとシナイとの間,あいだにあるシンの荒野,あらのにきたが、","tok":[["イスラエル"],["の"],["人々","ひとびと"],["の"],["全","ぜん"],["会衆","かいしゅう"],["は"],["エリム"],["を"],["出発","しゅっぱつ"],["し"],["、"],["エジプト"],["の"],["地","ち"],["を"],["出て","でて"],["二","に"],["か月目","かげつめ"],["の"],["十五","じゅうご"],["日","にち"],["に"],["、"],["エリム"],["と"],["シナイ"],["と"],["の"],["間","あいだ"],["に"],["ある"],["シン"],["の"],["荒野","あらの"],["に"],["きた"],["が"],["、"]]},{"verse":2,"text":"その荒野,あらのでイスラエルの人々,ひとびとの全,ぜん会衆,かいしゅうは、モーセとアロンにつぶやいた。","tok":[["その"],["荒野","あらの"],["で"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["全","ぜん"],["会衆","かいしゅう"],["は"],["、"],["モーセ"],["と"],["アロン"],["に"],["つぶやいた"],["。"]]},{"verse":3,"text":"イスラエルの人々,ひとびとは彼,かれらに言,いった、「われわれはエジプトの地,ちで、肉,にくのなべのかたわらに座,ざし、飽,あきるほどパンを食,たべていた時,ときに、主,しゅの手,てにかかって死,しんでいたら良,よかった。あなたがたは、われわれをこの荒野,あらのに導,みちびき出,だして、全,ぜん会衆,かいしゅうを餓死,がしさせようとしている」。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["われわれ"],["は"],["エジプト"],["の"],["地","ち"],["で"],["、"],["肉","にく"],["の"],["なべ"],["の"],["かたわら"],["に"],["座し","ざし"],["、"],["飽きる","あきる"],["ほど"],["パン"],["を"],["食べて","たべて"],["いた"],["時","とき"],["に"],["、"],["主","しゅ"],["の"],["手","て"],["に"],["かかって"],["死んで","しんで"],["いたら"],["良かった","よかった"],["。"],["あなた"],["がた"],["は"],["、"],["われわれ"],["を"],["この"],["荒野","あら"],["のに"],["導き出して","みちびきだして"],["、"],["全","ぜん"],["会衆","かいしゅう"],["を"],["餓死","がし"],["させよう"],["として"],["いる"],["」"],["。"]]},{"verse":4,"text":"そのとき主,しゅはモーセに言,いわれた、「見,みよ、わたしはあなたがたのために、天,てんからパンを降,ふらせよう。民,たみは出,でて日々,ひびの分,ぶんを日,ひごとに集,あつめなければならない。こうして彼,かれらがわたしの律法,りっぽうに従,したがうかどうかを試,こころみよう。","tok":[["その"],["とき"],["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"],["「"],["見よ","みよ"],["、"],["わたし"],["は"],["あなた"],["がた"],["の"],["ため"],["に"],["、"],["天","てん"],["から"],["パン"],["を"],["降らせよう","ふらせよう"],["。"],["民","たみ"],["は"],["出て","でて"],["日々","ひび"],["の"],["分","ぶん"],["を"],["日ごと","ひごと"],["に"],["集めなければ","あつめなければ"],["ならない"],["。"],["こう"],["して"],["彼","かれ"],["ら"],["が"],["わたし"],["の"],["律法","りっぽう"],["に"],["従う","したがう"],["か"],["どう"],["か"],["を"],["試みよう","こころみよう"],["。"]]},{"verse":5,"text":"六日,か目,めには、彼,かれらが取,とり入,いれたものを調理,ちょうりすると、それは日,ひごとに集,あつめるものの二倍,ばいあるであろう」。","tok":[["六日目","かめ"],["に"],["は"],["、"],["彼","かれ"],["ら"],["が"],["取入","とりいれ"],["た"],["もの"],["を"],["調理","ちょうり"],["する"],["と"],["、"],["それ"],["は"],["日ごと","ひごと"],["に"],["集める","あつめる"],["もの"],["の"],["二","に"],["倍","ばい"],["い"],["あるで"],["あろう"],["」"],["。"]]},{"verse":6,"text":"モーセとアロンは、イスラエルのすべての人々,ひとびとに言,いった、「夕暮,ゆうぐれには、あなたがたは、エジプトの地,ちからあなたがたを導,みちびき出,だされたのが、主,しゅであることを知,しるであろう。","tok":[["モーセ"],["と"],["アロン"],["は"],["、"],["イスラエル"],["の"],["すべて"],["の"],["人々","ひとびと"],["に"],["言った","いった"],["、"],["「"],["夕暮","ゆうぐれ"],["に"],["は"],["、"],["あなた"],["がた"],["は"],["、"],["エジプト"],["の"],["地","ち"],["から"],["あなた"],["がた"],["を"],["導き出された","みちびきだされた"],["の"],["が"],["、"],["主","しゅ"],["で"],["ある"],["こと"],["を"],["知るで","しるで"],["あろう"],["。"]]},{"verse":7,"text":"また、朝,あさには、あなたがたは主,しゅの栄光,えいこうを見,みるであろう。主,しゅはあなたがたが主,しゅにむかってつぶやくのを聞,きかれたからである。あなたがたは、いったいわれわれを何者,なにものとして、われわれにむかってつぶやくのか」。","tok":[["また"],["、"],["朝","あさ"],["に"],["は"],["、"],["あなた"],["がた"],["は"],["主","しゅ"],["の"],["栄光","えいこう"],["を"],["見るで","みるで"],["あろう"],["。"],["主","しゅ"],["は"],["あなた"],["がた"],["が"],["主に","しゅに"],["むかって"],["つぶやく"],["の"],["を"],["聞かれた","きかれた"],["から"],["で"],["ある"],["。"],["あなた"],["がた"],["は"],["、"],["いったい"],["われわれ"],["を"],["何者","なにもの"],["として"],["、"],["われわれ"],["に"],["むかって"],["つぶやく"],["の"],["か"],["」"],["。"]]},{"verse":8,"text":"モーセはまた言,いった、「主,しゅは夕暮,ゆうぐれにはあなたがたに肉,にくを与,あたえて食,たべさせ、朝,あさにはパンを与,あたえて飽,あき足,たらせられるであろう。主,しゅはあなたがたが、主,しゅにむかってつぶやくつぶやきを聞,きかれたからである。いったいわれわれは何者,なにものなのか。あなたがたのつぶやくのは、われわれにむかってでなく、主,しゅにむかってである」。","tok":[["モーセ"],["は"],["また"],["言った","いった"],["、"],["「"],["主","しゅ"],["は"],["夕暮","ゆうぐれ"],["に"],["は"],["あなた"],["がた"],["に"],["肉","にく"],["を"],["与","あたえ"],["て"],["食べさせ","たべさせ"],["、"],["朝","あさ"],["に"],["は"],["パン"],["を"],["与","あたえ"],["て"],["飽き足らせられるで","あきたらせられるで"],["あろう"],["。"],["主","しゅ"],["は"],["あなた"],["が"],["た"],["が"],["、"],["主に","しゅに"],["むかって"],["つぶやく"],["つぶやき"],["を"],["聞かれた","きかれた"],["から"],["で"],["ある"],["。"],["いったい"],["われわれ"],["は"],["何者","なにもの"],["な"],["の"],["か"],["。"],["あなた"],["がた"],["の"],["つぶやく"],["の"],["は"],["、"],["われわれ"],["に"],["むかって"],["で"],["なく"],["、"],["主に","しゅに"],["むかって"],["で"],["ある"],["」"],["。"]]},{"verse":9,"text":"モーセはアロンに言,いった、「イスラエルの人々,ひとびとの全,ぜん会衆,かいしゅうに言,いいなさい、『あなたがたは主,しゅの前,まえに近,ちかづきなさい。主,しゅがあなたがたのつぶやきを聞,きかれたからである』と」。","tok":[["モーセ"],["は"],["アロン"],["に"],["言った","いった"],["、"],["「"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["全","ぜん"],["会衆","かいしゅう"],["に"],["言い","いい"],["なさい"],["、"],["『"],["あなた"],["がた"],["は"],["主","しゅ"],["の"],["前","まえ"],["に"],["近づき","ちかづき"],["なさい"],["。"],["主","しゅ"],["が"],["あなた"],["がた"],["の"],["つぶやき"],["を"],["聞かれた","きかれた"],["から"],["で"],["ある"],["』"],["と"],["」"],["。"]]},{"verse":10,"text":"それでアロンがイスラエルの人々,ひとびとの全,ぜん会衆,かいしゅうに語,かたったとき、彼,かれらが荒野,あらのの方,ほうを望,のぞむと、見,みよ、主,しゅの栄光,えいこうが雲,くものうちに現,あらわれていた。","tok":[["それ"],["で"],["アロン"],["が"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["全","ぜん"],["会衆","かいしゅう"],["に"],["語った","かたった"],["とき"],["、"],["彼","かれ"],["ら"],["が"],["荒野","あらの"],["の"],["方","ほう"],["を"],["望む","のぞむ"],["と"],["、"],["見よ","みよ"],["、"],["主","しゅ"],["の"],["栄光","えいこう"],["が"],["雲","くも"],["の"],["うち"],["に"],["現われて","あらわれて"],["いた"],["。"]]},{"verse":11,"text":"主,しゅはモーセに言,いわれた、","tok":[["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":12,"text":"「わたしはイスラエルの人々,ひとびとのつぶやきを聞,きいた。彼,かれらに言,いいなさい、『あなたがたは夕,ゆうには肉,にくを食,たべ、朝,あさにはパンに飽,あき足,たりるであろう。そうしてわたしがあなたがたの神,かみ、主,しゅであることを知,しるであろう』と」。","tok":[["「"],["わたし"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["つぶやき"],["を"],["聞いた","きいた"],["。"],["彼","かれ"],["ら"],["に"],["言い","いい"],["なさい"],["、"],["『"],["あなた"],["がた"],["は"],["夕","ゆう"],["に"],["は"],["肉","にく"],["を"],["食べ","たべ"],["、"],["朝","あさ"],["に"],["は"],["パン"],["に"],["飽き足りるで","あきたりるで"],["あろう"],["。"],["そう"],["して"],["わたし"],["が"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["で"],["ある"],["こと"],["を"],["知るで","しるで"],["あろう"],["』"],["と"],["」"],["。"]]},{"verse":13,"text":"夕,ゆうべになると、うずらが飛,とんできて宿営,しゅくえいをおおった。また、朝,あさになると、宿営,しゅくえいの周囲,しゅういに露,つゆが降,ふりた。","tok":[["夕べ","ゆうべ"],["に"],["なる"],["と"],["、"],["うずら"],["が"],["飛んで","とんで"],["きて"],["宿営","しゅくえい"],["を"],["おおった"],["。"],["また"],["、"],["朝","あさ"],["に"],["なる"],["と"],["、"],["宿営","しゅくえい"],["の"],["周囲","しゅうい"],["に"],["露","つ"],["ゆ"],["が"],["降りた","ふりた"],["。"]]},{"verse":14,"text":"その降,ふりた露,つゆがかわくと、荒野,あらのの面,めんには、薄,うすいうろこのようなものがあり、ちょうど地,ちに結,むすぶ薄,うすい霜,しものようであった。","tok":[["その"],["降りた","ふりた"],["露","つゆ"],["が"],["かわく"],["と"],["、"],["荒野","あら"],["の"],["の"],["面","めん"],["に"],["は"],["、"],["薄い","うすい"],["うろこ"],["の"],["よう"],["な"],["もの"],["が"],["あり"],["、"],["ちょうど"],["地","ち"],["に"],["結ぶ","むすぶ"],["薄い","うすい"],["霜","しも"],["の"],["よう"],["で"],["あった"],["。"]]},{"verse":15,"text":"イスラエルの人々,ひとびとはそれを見,みて互,たがいに言,いった、「これはなんであろう」。彼,かれらはそれがなんであるのか知,しらなかったからである。モーセは彼,かれらに言,いった、「これは主,しゅがあなたがたの食物,しょくもつとして賜,たまわるパンである。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["は"],["それ"],["を"],["見て","みて"],["互","たがい"],["に"],["言った","いった"],["、"],["「"],["これ"],["は"],["なん"],["で"],["あろう"],["」"],["。"],["彼","かれ"],["ら"],["は"],["それ"],["が"],["なん"],["で"],["ある"],["の"],["か"],["知らなかった","しらなかった"],["から"],["で"],["ある"],["。"],["モーセ"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["これ"],["は"],["主","しゅ"],["が"],["あなた"],["がた"],["の"],["食物","しょくもつ"],["として"],["賜わる","たまわる"],["パン"],["で"],["ある"],["。"]]},{"verse":16,"text":"主,しゅが命,めいじられるのはこうである、『あなたがたは、おのおのその食,たべるところに従,したがってそれを集,あつめ、あなたがたの人数,にんずうに従,したがって、ひとり一オメルずつ、おのおのその天幕,てんまくにおるもののためにそれを取,とりなさい』と」。","tok":[["主","しゅ"],["が"],["命じられる","めいじられる"],["の"],["は"],["こう"],["で"],["ある"],["、"],["『"],["あなた"],["がた"],["は"],["、"],["おのおの"],["その"],["食べる","たべる"],["ところ"],["に"],["従って","したがって"],["それ"],["を"],["集め","あつめ"],["、"],["あなた"],["がた"],["の"],["人数","にんずう"],["に"],["従って","したがって"],["、"],["ひとり"],["一","いち"],["オメル"],["ずつ"],["、"],["おのおの"],["その"],["天幕","てんまく"],["に"],["おる"],["もの"],["の"],["ため"],["に"],["それ"],["を"],["取","とり"],["なさい"],["』"],["と"],["」"],["。"]]},{"verse":17,"text":"イスラエルの人々,ひとびとはそのようにして、ある者,ものは多,おおく、ある者,ものは少,すくなく集,あつめた。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["は"],["その"],["よう"],["に"],["して"],["、"],["ある"],["者","もの"],["は"],["多く","おおく"],["、"],["ある"],["者","もの"],["は"],["少く","すくなく"],["集めた","あつめた"],["。"]]},{"verse":18,"text":"しかし、オメルでそれを計,はかってみると、多,おおく集,あつめた者,ものにも余,あまらず、少,すくなく集,あつめた者,ものにも不足,ふそくしなかった。おのおのその食,たべるところに従,したがって集,あつめていた。","tok":[["しかし"],["、"],["オメル"],["で"],["それ"],["を"],["計って","はかって"],["みる"],["と"],["、"],["多く","おおく"],["集めた","あつめた"],["者","もの"],["に"],["も"],["余らず","あまらず"],["、"],["少く","すくなく"],["集めた","あつめた"],["者","もの"],["に"],["も"],["不足","ふそく"],["しなかった"],["。"],["おのおの"],["その"],["食べる","たべる"],["ところ"],["に"],["従って","したがって"],["集めて","あつめて"],["いた"],["。"]]},{"verse":19,"text":"モーセは彼,かれらに言,いった、「だれも朝,あさまでそれを残,のこしておいてはならない」。","tok":[["モーセ"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["だれ"],["も"],["朝","あさ"],["まで"],["それ"],["を"],["残して","のこして"],["おいて"],["は"],["ならない"],["」"],["。"]]},{"verse":20,"text":"しかし彼,かれらはモーセに聞,きき従,したがわないで、ある者,ものは朝,あさまでそれを残,のこしておいたが、虫,むしがついて臭,くさくなった。モーセは彼,かれらにむかって怒,いかった。","tok":[["しかし"],["彼","かれ"],["ら"],["は"],["モーセ"],["に"],["聞","きき"],["従わないで","したがわないで"],["、"],["ある"],["者","もの"],["は"],["朝","あさ"],["まで"],["それ"],["を"],["残して","のこして"],["おいた"],["が"],["、"],["虫","むし"],["が"],["ついて"],["臭く","くさく"],["なった"],["。"],["モーセ"],["は"],["彼","かれ"],["ら"],["に"],["むかって"],["怒","い"],["かった"],["。"]]},{"verse":21,"text":"彼,かれらは、おのおのその食,たべるところに従,したがって、朝,あさごとにそれを集,あつめたが、日,ひが熱,あつくなるとそれは溶,とけた。","tok":[["彼","かれ"],["ら"],["は"],["、"],["おのおの"],["その"],["食べる","たべる"],["ところ"],["に"],["従って","したがって"],["、"],["朝","あさ"],["ごと"],["に"],["それ"],["を"],["集めた","あつめた"],["が"],["、"],["日","ひ"],["が"],["熱く","あつく"],["なる"],["と"],["それ"],["は"],["溶けた","とけた"],["。"]]},{"verse":22,"text":"六日,か目,めには、彼,かれらは二倍,ばいのパン、すなわちひとりに二オメルを集,あつめた。そこで、会衆,かいしゅうの長,ちょうたちは皆,みなきて、モーセに告,つげたが、","tok":[["六日目","かめ"],["に"],["は"],["、"],["彼","かれ"],["ら"],["は"],["二","に"],["倍","ばい"],["の"],["パン"],["、"],["すなわち"],["ひとり"],["に"],["二","に"],["オメル"],["を"],["集めた","あつめた"],["。"],["そこ"],["で"],["、"],["会衆","かいしゅう"],["の"],["長","ちょう"],["たち"],["は"],["皆","みな"],["きて"],["、"],["モーセ"],["に"],["告","つげ"],["た"],["が"],["、"]]},{"verse":23,"text":"モーセは彼,かれらに言,いった、「主,しゅの語,かたられたのはこうである、『あすは主,しゅの聖,せい安息日,あんそくにちで休,やすみである。きょう、焼,やこうとするものを焼,やき、煮,にようとするものを煮,になさい。残,のこったものはみな朝,あさまでたくわえて保存,ほぞんしなさい』と」。","tok":[["モーセ"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["主","しゅ"],["の"],["語られた","かたられた"],["の"],["は"],["こう"],["で"],["ある"],["、"],["『"],["あす"],["は"],["主","しゅ"],["の"],["聖","せい"],["安息日","あん"],["そ"],["く"],["にち"],["で"],["休み","やすみ"],["で"],["ある"],["。"],["きょう"],["、"],["焼こう","やこう"],["と"],["する"],["もの"],["を"],["焼き","やき"],["、"],["煮よう","によう"],["と"],["する"],["もの"],["を"],["煮","に"],["なさい"],["。"],["残った","のこった"],["もの"],["は"],["みな"],["朝","あさ"],["まで"],["たくわえて"],["保存","ほぞん"],["し"],["なさい"],["』"],["と"],["」"],["。"]]},{"verse":24,"text":"彼,かれらはモーセの命,めいじたように、それを朝,あさまで保存,ほぞんしたが、臭,くさくならず、また虫,むしもつかなかった。","tok":[["彼","かれ"],["ら"],["は"],["モーセ"],["の"],["命じた","めいじた"],["よう"],["に"],["、"],["それ"],["を"],["朝","あさ"],["まで"],["保存","ほぞん"],["した"],["が"],["、"],["臭く","くさく"],["ならず"],["、"],["また"],["虫","むし"],["も"],["つかなかった"],["。"]]},{"verse":25,"text":"モーセは言,いった、「きょう、それを食,たべなさい。きょうは主,しゅの安息日,あんそくにちであるから、きょうは野,のでそれを獲,えられないであろう。","tok":[["モーセ"],["は"],["言った","いった"],["、"],["「"],["きょう"],["、"],["それ"],["を"],["食べ","たべ"],["なさい"],["。"],["きょう"],["は"],["主","しゅ"],["の"],["安息日","あんそくにちであるか"],["ら"],["、"],["きょう"],["は"],["野","の"],["で"],["それ"],["を"],["獲られないで","えられないで"],["あろう"],["。"]]},{"verse":26,"text":"六日,かの間,あいだはそれを集,あつめなければならない。七日,なぬか目,めは安息日,あんそくにちであるから、その日,ひには無,ないであろう」。","tok":[["六日","か"],["の"],["間","あいだ"],["は"],["それ"],["を"],["集めなければ","あつめなければ"],["ならない"],["。"],["七日","な"],["ぬか目","ぬかめ"],["は"],["安息日","あんそくにちであるか"],["ら"],["、"],["その"],["日","ひ"],["に"],["は"],["無いで","ないで"],["あろう"],["」"],["。"]]},{"verse":27,"text":"ところが民,たみのうちには、七日,なぬか目,めに出,でて集,あつめようとした者,ものがあったが、獲,えられなかった。","tok":[["ところ"],["が"],["民","たみ"],["の"],["うち"],["に"],["は"],["、"],["七日","な"],["ぬか目","ぬかめ"],["に"],["出て","でて"],["集めよう","あつめよう"],["と"],["した"],["者","もの"],["が"],["あった"],["が"],["、"],["獲られなかった","えられなかった"],["。"]]},{"verse":28,"text":"そこで主,しゅはモーセに言,いわれた、「あなたがたは、いつまでわたしの戒,いましめと、律法,りっぽうとを守,まもることを拒,こばむのか。","tok":[["そこ"],["で"],["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["がた"],["は"],["、"],["いつ"],["まで"],["わたし"],["の"],["戒しめ","いましめ"],["と"],["、"],["律法","りっぽう"],["と"],["を"],["守","まもる"],["こと"],["を"],["拒む","こばむ"],["の"],["か"],["。"]]},{"verse":29,"text":"見,みよ、主,しゅはあなたがたに安息日,あんそくにちを与,あたえられた。ゆえに六日,か目,めには、ふつか分,ぶんのパンをあなたがたに賜,たまわるのである。おのおのその所,ところにとどまり、七日,なぬか目,めにはその所,ところから出,でてはならない」。","tok":[["見よ","みよ"],["、"],["主","しゅ"],["は"],["あなた"],["がた"],["に"],["安息日","あんそくにち"],["を"],["与えられた","あたえられた"],["。"],["ゆえ"],["に"],["六日目","かめ"],["に"],["は"],["、"],["ふ"],["つ"],["か"],["分","ぶん"],["の"],["パン"],["を"],["あなた"],["がた"],["に"],["賜わる","たまわる"],["ので"],["ある"],["。"],["おのおの"],["その"],["所","ところ"],["に"],["とどまり"],["、"],["七日","な"],["ぬか目","ぬかめ"],["に"],["は"],["その"],["所","ところ"],["から"],["出て","でて"],["は"],["ならない"],["」"],["。"]]},{"verse":30,"text":"こうして民,たみは七日,なぬか目,めに休,やすんだ。","tok":[["こう"],["して"],["民","たみ"],["は"],["七日","な"],["ぬか目","ぬかめ"],["に"],["休んだ","やすんだ"],["。"]]},{"verse":31,"text":"イスラエルの家,いえはその物,ものの名,なをマナと呼,よんだ。それはコエンドロの実,みのようで白,しろく、その味,あじは蜜,みつを入,いれたせんべいのようであった。","tok":[["イスラエル"],["の"],["家","いえ"],["は"],["その"],["物","もの"],["の"],["名","な"],["を"],["マナ"],["と"],["呼んだ","よんだ"],["。"],["それ"],["は"],["コエンドロ"],["の"],["実","み"],["の"],["よう"],["で"],["白く","しろく"],["、"],["その"],["味","あじ"],["は"],["蜜","みつ"],["を"],["入れた","いれた"],["せんべい"],["の"],["よう"],["で"],["あった"],["。"]]},{"verse":32,"text":"モーセは言,いった、「主,しゅの命,めいじられることはこうである、『それを一オメルあなたがたの子孫,しそんのためにたくわえておきなさい。それはわたしが、あなたがたをエジプトの地,ちから導,みちびき出,だした時,とき、荒野,あらのであなたがたに食,たべさせたパンを彼,かれらに見,みさせるためである』と」。","tok":[["モーセ"],["は"],["言った","いった"],["、"],["「"],["主","しゅ"],["の"],["命じられる","めいじられる"],["こと"],["は"],["こう"],["で"],["ある"],["、"],["『"],["それ"],["を"],["一","いち"],["オメル"],["あなた"],["がた"],["の"],["子孫","しそん"],["の"],["ため"],["に"],["たくわえて"],["おき"],["なさい"],["。"],["それ"],["は"],["わたし"],["が"],["、"],["あなた"],["がた"],["を"],["エジプト"],["の"],["地","ち"],["から"],["導き出した","みちびきだした"],["時","とき"],["、"],["荒野","あら"],["ので"],["あなた"],["がた"],["に"],["食べさせた","たべさせた"],["パン"],["を"],["彼","かれ"],["ら"],["に"],["見させる","みさせる"],["ため"],["で"],["ある"],["』"],["と"],["」"],["。"]]},{"verse":33,"text":"そしてモーセはアロンに言,いった「一つのつぼを取,とり、マナ一オメルをその中,なかに入,いれ、それを主,しゅの前,まえに置,おいて、子孫,しそんのためにたくわえなさい」。","tok":[["そして"],["モーセ"],["は"],["アロン"],["に"],["言った","いった"],["「"],["一","ひと"],["つ"],["の"],["つぼ"],["を"],["取","とり"],["、"],["マナ"],["一","いち"],["オメル"],["を"],["その"],["中","なか"],["に"],["入れ","いれ"],["、"],["それ"],["を"],["主","しゅ"],["の"],["前","まえ"],["に"],["置いて","おいて"],["、"],["子孫","しそん"],["の"],["ため"],["に"],["たくわえ"],["なさい"],["」"],["。"]]},{"verse":34,"text":"そこで主,しゅがモーセに命,めいじられたように、アロンはそれをあかしの箱,はこの前,まえに置,おいてたくわえた。","tok":[["そこ"],["で"],["主","しゅ"],["が"],["モーセ"],["に"],["命じられた","めいじられた"],["よう"],["に"],["、"],["アロン"],["は"],["それ"],["を"],["あかし"],["の"],["箱","はこ"],["の"],["前","まえ"],["に"],["置いて","おいて"],["たくわえた"],["。"]]},{"verse":35,"text":"イスラエルの人々,ひとびとは人,ひとの住,すむ地,ちに着,つくまで四十年,ねんの間,あいだマナを食,たべた。すなわち、彼,かれらはカナンの地,ちの境,さかいに至,いたるまでマナを食,たべた。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["は"],["人","ひと"],["の"],["住む","すむ"],["地","ち"],["に"],["着く","つく"],["まで"],["四十","よんじゅう"],["年","ねん"],["の"],["間","あいだ"],["マナ"],["を"],["食べた","たべた"],["。"],["すなわち"],["、"],["彼","かれ"],["ら"],["は"],["カナン"],["の"],["地","ち"],["の"],["境","さかい"],["に"],["至る","いたる"],["まで"],["マナ"],["を"],["食べた","たべた"],["。"]]},{"verse":36,"text":"一オメルは一エパの十分,ぶんの一である。","tok":[["一","いち"],["オメル"],["は"],["一","いち"],["エパ"],["の"],["十分","ぶん"],["の"],["一","いち"],["で"],["ある"],["。"]]}]
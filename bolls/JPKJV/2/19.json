[{"verse":1,"text":"イスラエルの人々,ひとびとは、エジプトの地,ちを出,でて後,のち三月,つき目,めのその日,ひに、シナイの荒野,あらのにはいった。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["は"],["、"],["エジプト"],["の"],["地","ち"],["を"],["出て","でて"],["後","の"],["ち"],["三","さん"],["月","がつ"],["き目","きめ"],["の"],["その"],["日","ひ"],["に"],["、"],["シナイ"],["の"],["荒野","あらの"],["に"],["はいった"],["。"]]},{"verse":2,"text":"すなわち彼,かれらはレピデムを出立,しゅったつしてシナイの荒野,あらのに入,いり、荒野,あらのに宿営,しゅくえいした。イスラエルはその所,ところで山,やまの前,まえに宿営,しゅくえいした。","tok":[["すなわち"],["彼","かれ"],["ら"],["は"],["レピデム"],["を"],["出立","しゅったつ"],["して"],["シナイ"],["の"],["荒野","あらの"],["に"],["入","いり"],["、"],["荒野","あら"],["のに"],["宿営","しゅくえい"],["した"],["。"],["イスラエル"],["は"],["その"],["所","ところ"],["で"],["山","やま"],["の"],["前","まえ"],["に"],["宿営","しゅくえい"],["した"],["。"]]},{"verse":3,"text":"さて、モーセが神,かみのもとに登,のぼると、主,しゅは山,やまから彼,かれを呼,よんで言,いわれた、「このように、ヤコブの家,いえに言,いい、イスラエルの人々,ひとびとに告,つげなさい、","tok":[["さて"],["、"],["モーセ"],["が"],["神","かみ"],["の"],["もと"],["に"],["登","のぼる"],["と"],["、"],["主","しゅ"],["は"],["山","やま"],["から"],["彼","かれ"],["を"],["呼んで","よんで"],["言われた","いわれた"],["、"],["「"],["この"],["よう"],["に"],["、"],["ヤコブ"],["の"],["家","いえ"],["に"],["言い","いい"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["告","つげ"],["なさい"],["、"]]},{"verse":4,"text":"『あなたがたは、わたしがエジプトびとにした事,ことと、あなたがたを鷲,わしの翼,つばさに載,のせてわたしの所,ところにこさせたことを見,みた。","tok":[["『"],["あなた"],["がた"],["は"],["、"],["わたし"],["が"],["エジプト"],["びと"],["に"],["した"],["事","こと"],["と"],["、"],["あなた"],["がた"],["を"],["鷲","わし"],["の"],["翼","つばさ"],["に"],["載せて","のせて"],["わたし"],["の"],["所","ところ"],["に"],["こさせた"],["こと"],["を"],["見た","みた"],["。"]]},{"verse":5,"text":"それで、もしあなたがたが、まことにわたしの声,こえに聞,きき従,したがい、わたしの契約,けいやくを守,まもるならば、あなたがたはすべての民,たみにまさって、わたしの宝,たからとなるであろう。全,ぜん地,ちはわたしの所有,しょゆうだからである。","tok":[["それ"],["で"],["、"],["もし"],["あなた"],["が"],["た"],["が"],["、"],["まこと"],["に"],["わたし"],["の"],["声","こえ"],["に"],["聞","きき"],["従い","したがい"],["、"],["わたし"],["の"],["契約","けいやく"],["を"],["守","まもる"],["ならば"],["、"],["あなた"],["がた"],["は"],["すべて"],["の"],["民","たみ"],["に"],["まさって"],["、"],["わたし"],["の"],["宝","たから"],["と"],["なるで"],["あろう"],["。"],["全地","ぜんち"],["は"],["わたし"],["の"],["所有","しょゆう"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":6,"text":"あなたがたはわたしに対,たいして祭司,さいしの国,くにとなり、また聖,せいなる民,たみとなるであろう』。これがあなたのイスラエルの人々,ひとびとに語,かたるべき言葉,ことばである」。","tok":[["あなた"],["がた"],["は"],["わたし"],["に対して","にたいして"],["祭司","さいし"],["の"],["国","くに"],["と"],["なり"],["、"],["また"],["聖","せい"],["なる"],["民","たみ"],["と"],["なるで"],["あろう"],["』"],["。"],["これ"],["が"],["あなた"],["の"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["語るべき","かたるべき"],["言葉","ことば"],["で"],["ある"],["」"],["。"]]},{"verse":7,"text":"それでモーセは行,いって民,たみの長老,ちょうろうたちを呼,よび、主,しゅが命,めいじられたこれらの言葉,ことばを、すべてその前,まえに述,のべたので、","tok":[["それ"],["で"],["モーセ"],["は"],["行って","いって"],["民","たみ"],["の"],["長老","ちょうろう"],["たち"],["を"],["呼び","よび"],["、"],["主","しゅ"],["が"],["命じられた","めいじられた"],["これ"],["ら"],["の"],["言葉","ことば"],["を"],["、"],["すべて"],["その"],["前","まえ"],["に"],["述べた","のべた"],["ので"],["、"]]},{"verse":8,"text":"民,たみはみな共,ともに答,こたえて言,いった、「われわれは主,しゅが言,いわれたことを、みな行,おこないます」。モーセは民,たみの言葉,ことばを主,しゅに告,つげた。","tok":[["民","たみ"],["は"],["みな"],["共","とも"],["に"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["われわれ"],["は"],["主","しゅ"],["が"],["言われた","いわれた"],["こと"],["を"],["、"],["みな"],["行ないます","おこないます"],["」"],["。"],["モーセ"],["は"],["民","たみ"],["の"],["言葉","ことば"],["を"],["主に","しゅに"],["告","つげ"],["た"],["。"]]},{"verse":9,"text":"主,しゅはモーセに言,いわれた、「見,みよ、わたしは濃,こい雲,くものうちにあって、あなたに臨,のぞむであろう。それはわたしがあなたと語,かたるのを民,たみに聞,きかせて、彼,かれらに長,ながくあなたを信,しんじさせるためである」。モーセは民,たみの言葉,ことばを主,しゅに告,つげた。","tok":[["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"],["「"],["見よ","みよ"],["、"],["わたし"],["は"],["濃い","こい"],["雲","くも"],["の"],["うち"],["に"],["あって"],["、"],["あなた"],["に"],["臨むで","のぞむで"],["あろう"],["。"],["それ"],["は"],["わたし"],["が"],["あなた"],["と"],["語る","かたる"],["の"],["を"],["民","たみ"],["に"],["聞かせて","きかせて"],["、"],["彼","かれ"],["ら"],["に"],["長く","ながく"],["あなた"],["を"],["信じさせる","しんじさせる"],["ため"],["で"],["ある"],["」"],["。"],["モーセ"],["は"],["民","たみ"],["の"],["言葉","ことば"],["を"],["主に","しゅに"],["告","つげ"],["た"],["。"]]},{"verse":10,"text":"主,しゅはモーセに言,いわれた、「あなたは民,たみのところに行,いって、きょうとあす、彼,かれらをきよめ、彼,かれらにその衣服,いふくを洗,あらわせ、","tok":[["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["は"],["民","たみ"],["の"],["ところ"],["に"],["行って","いって"],["、"],["きょう"],["と"],["あす"],["、"],["彼","かれ"],["ら"],["を"],["きよめ"],["、"],["彼","かれ"],["ら"],["に"],["その"],["衣服","いふく"],["を"],["洗わせ","あらわせ"],["、"]]},{"verse":11,"text":"三日,か目,めまでに備,そなえさせなさい。三日,か目,めに主,しゅが、すべての民,たみの目,めの前,まえで、シナイ山,さんに下,くだるからである。","tok":[["三日目","かめ"],["まで"],["に"],["備","そなえ"],["させ"],["なさい"],["。"],["三日目","かめ"],["に"],["主","しゅ"],["が"],["、"],["すべて"],["の"],["民","たみ"],["の"],["目","め"],["の"],["前","まえ"],["で"],["、"],["シナイ"],["山","さん"],["に"],["下る","くだる"],["から"],["で"],["ある"],["。"]]},{"verse":12,"text":"あなたは民,たみのために、周囲,しゅういに境,さかいを設,もうけて言,いいなさい、『あなたがたは注意,ちゅういして、山,やまに上,のぼらず、また、その境界,きょうかいに触,ふれないようにしなさい。山,やまに触,ふれる者,ものは必,かならず殺,ころされるであろう。","tok":[["あなた"],["は"],["民","たみ"],["の"],["ため"],["に"],["、"],["周囲","しゅうい"],["に"],["境","さかい"],["を"],["設けて","もうけて"],["言い","いい"],["なさい"],["、"],["『"],["あなた"],["がた"],["は"],["注意","ちゅうい"],["して"],["、"],["山","やま"],["に"],["上らず","のぼらず"],["、"],["また"],["、"],["その"],["境界","きょうかい"],["に"],["触","ふれ"],["ない"],["よう"],["に"],["し"],["なさい"],["。"],["山","やま"],["に"],["触れる","ふれる"],["者","もの"],["は"],["必","かならず"],["殺ろされるで","ころされるで"],["あろう"],["。"]]},{"verse":13,"text":"手,てをそれに触,ふれてはならない。触,ふれる者,ものは必,かならず石,いしで打,うち殺,ころされるか、射殺,しゃさつされるであろう。獣,けものでも人,ひとでも生,いきることはできない』。ラッパが長,ながく響,ひびいた時,とき、彼,かれらは山,やまに登,のぼることができる」と。","tok":[["手","て"],["を"],["それ"],["に"],["触","ふれ"],["ては"],["ならない"],["。"],["触れる","ふれる"],["者","もの"],["は"],["必","かならず"],["石","いし"],["で"],["打ち","うち"],["殺ろ","ころ"],["される"],["か"],["、"],["射殺","しゃさつ"],["されるで"],["あろう"],["。"],["獣","けもの"],["で"],["も"],["人","ひと"],["で"],["も"],["生きる","いきる"],["こと"],["は"],["できない"],["』"],["。"],["ラッパ"],["が"],["長く","ながく"],["響いた","ひびいた"],["時","とき"],["、"],["彼","かれ"],["ら"],["は"],["山","やま"],["に"],["登","のぼる"],["こと"],["が"],["できる"],["」"],["と"],["。"]]},{"verse":14,"text":"そこでモーセは山,やまから民,たみのところに下,くだり、民,たみをきよめた。彼,かれらはその衣服,いふくを洗,あらった。","tok":[["そこ"],["で"],["モーセ"],["は"],["山","やま"],["から"],["民","たみ"],["の"],["ところ"],["に"],["下り","くだり"],["、"],["民","たみ"],["を"],["きよめた"],["。"],["彼","かれ"],["ら"],["は"],["その"],["衣服","いふく"],["を"],["洗った","あらった"],["。"]]},{"verse":15,"text":"モーセは民,たみに言,いった、「三日,か目,めまでに備,そなえをしなさい。女,おんなに近,ちかづいてはならない」。","tok":[["モーセ"],["は"],["民","たみ"],["に"],["言った","いった"],["、"],["「"],["三日目","かめ"],["まで"],["に"],["備","そなえ"],["を"],["し"],["なさい"],["。"],["女","おんな"],["に"],["近づいて","ちかづいて"],["は"],["ならない"],["」"],["。"]]},{"verse":16,"text":"三日,か目,めの朝,あさとなって、かみなりと、いなずまと厚,あつい雲,くもとが、山,やまの上,うえにあり、ラッパの音,おとが、はなはだ高,たかく響,ひびいたので、宿営,しゅくえいにおる民,たみはみな震,ふるえた。","tok":[["三日目","かめ"],["の"],["朝","あさ"],["と"],["なって"],["、"],["かみなり"],["と"],["、"],["いなずま"],["と"],["厚い","あつい"],["雲","くも"],["と"],["が"],["、"],["山","やま"],["の"],["上","うえ"],["に"],["あり"],["、"],["ラッパ"],["の"],["音","おと"],["が"],["、"],["はなはだ"],["高く","たかく"],["響いた","ひびいた"],["ので"],["、"],["宿営","しゅくえい"],["に"],["おる"],["民","たみ"],["は"],["みな"],["震えた","ふるえた"],["。"]]},{"verse":17,"text":"モーセが民,たみを神,かみに会,あわせるために、宿営,しゅくえいから導,みちびき出,だしたので、彼,かれらは山,やまのふもとに立,たった。","tok":[["モーセ"],["が"],["民","たみ"],["を"],["神","かみ"],["に"],["会わせる","あわせる"],["ため"],["に"],["、"],["宿営","しゅくえい"],["から"],["導き出した","みちびきだした"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["山","やま"],["の"],["ふもと"],["に"],["立った","たった"],["。"]]},{"verse":18,"text":"シナイ山,さんは全,ぜん山,ざん煙,けむった。主,しゅが火,ひのなかにあって、その上,うえに下,くだられたからである。その煙,けむりは、かまどの煙,けむりのように立,たち上,のぼり、全,ぜん山,ざんはげしく震,ふるえた。","tok":[["シナイ"],["山","さん"],["は"],["全山","ぜんざん"],["煙った","けむった"],["。"],["主","しゅ"],["が"],["火","ひ"],["の"],["なか"],["に"],["あって"],["、"],["その"],["上","うえ"],["に"],["下られた","くだられた"],["から"],["で"],["ある"],["。"],["その"],["煙","けむり"],["は"],["、"],["かまど"],["の"],["煙","けむり"],["の"],["よう"],["に"],["立ち上り","たちのぼり"],["、"],["全山","ぜんざん"],["はげしく"],["震えた","ふるえた"],["。"]]},{"verse":19,"text":"ラッパの音,おとが、いよいよ高,たかくなったとき、モーセは語,かたり、神,かみは、かみなりをもって、彼,かれに答,こたえられた。","tok":[["ラッパ"],["の"],["音","おと"],["が"],["、"],["いよいよ"],["高く","たかく"],["なった"],["とき"],["、"],["モーセ"],["は"],["語り","かたり"],["、"],["神","かみ"],["は"],["、"],["かみなり"],["を"],["もって"],["、"],["彼","かれ"],["に"],["答","こたえ"],["られた"],["。"]]},{"verse":20,"text":"主,しゅはシナイ山,さんの頂,いただきに下,くだられた。そして主,しゅがモーセを山,やまの頂,いただきに召,めされたので、モーセは登,のぼった。","tok":[["主","しゅ"],["は"],["シナイ"],["山","さん"],["の"],["頂","いただき"],["に"],["下られた","くだられた"],["。"],["そして"],["主","しゅ"],["が"],["モーセ"],["を"],["山","やま"],["の"],["頂","いただき"],["に"],["召された","めされた"],["ので"],["、"],["モーセ"],["は"],["登った","のぼった"],["。"]]},{"verse":21,"text":"主,しゅはモーセに言,いわれた、「下,くだって行,いって民,たみを戒,いましめなさい。民,たみが押,おし破,やぶって、主,しゅのところにきて、見,みようとし、多,おおくのものが死,しぬことのないようにするためである。","tok":[["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"],["「"],["下","くだ"],["って"],["行って","いって"],["民","たみ"],["を"],["戒しめ","いましめ"],["なさい"],["。"],["民","た"],["み"],["が"],["押","おし"],["破って","やぶって"],["、"],["主","しゅ"],["の"],["ところ"],["に"],["きて"],["、"],["見よう","みよう"],["と"],["し"],["、"],["多く","おおく"],["の"],["もの"],["が"],["死ぬ","しぬ"],["こと"],["の"],["ない"],["よう"],["に"],["する"],["ため"],["で"],["ある"],["。"]]},{"verse":22,"text":"主,しゅに近,ちかづく祭司,さいしたちにもまた、その身,みをきよめさせなさい。主,しゅが彼,かれらを打,うつことのないようにするためである」。","tok":[["主に","しゅに"],["近づく","ちかづく"],["祭司","さいし"],["たち"],["に"],["も"],["また"],["、"],["その"],["身","み"],["を"],["きよめさせ"],["なさい"],["。"],["主","しゅ"],["が"],["彼","かれ"],["ら"],["を"],["打つ","うつ"],["こと"],["の"],["ない"],["よう"],["に"],["する"],["ため"],["で"],["ある"],["」"],["。"]]},{"verse":23,"text":"モーセは主,しゅに言,いった、「民,たみはシナイ山,さんに登,のぼることはできないでしょう。あなたがわたしたちを戒,いましめて『山,やまのまわりに境,さかいを設,もうけ、それをきよめよ』と言,いわれたからです」。","tok":[["モーセ"],["は"],["主に","しゅに"],["言った","いった"],["、"],["「"],["民","たみ"],["は"],["シナイ"],["山","さん"],["に"],["登","のぼる"],["こと"],["は"],["できないでしょう"],["。"],["あなた"],["が"],["わたしたち"],["を"],["戒しめ","いましめ"],["て"],["『"],["山","やま"],["の"],["まわり"],["に"],["境","さかい"],["を"],["設け","もうけ"],["、"],["それ"],["を"],["きよめよ"],["』"],["と"],["言われた","いわれた"],["から"],["です"],["」"],["。"]]},{"verse":24,"text":"主,しゅは彼,かれに言,いわれた、「行,いけ、下,くだれ。そしてあなたはアロンと共,ともに登,のぼってきなさい。ただし、祭司,さいしたちと民,たみとが、押,おし破,やぶって主,しゅのところに登,のぼることのないようにしなさい。主,しゅが彼,かれらを打,うつことのないようにするためである」。","tok":[["主","しゅ"],["は"],["彼","かれ"],["に"],["言われた","いわれた"],["、"],["「"],["行け","いけ"],["、"],["下れ","くだれ"],["。"],["そして"],["あなた"],["は"],["アロン"],["と"],["共","とも"],["に"],["登って","のぼって"],["き"],["なさい"],["。"],["ただし"],["、"],["祭司","さいし"],["たち"],["と"],["民","たみ"],["と"],["が"],["、"],["押","おし"],["破って","やぶって"],["主","しゅ"],["の"],["ところ"],["に"],["登","のぼる"],["こと"],["の"],["ない"],["よう"],["に"],["し"],["なさい"],["。"],["主","しゅ"],["が"],["彼","かれ"],["ら"],["を"],["打つ","うつ"],["こと"],["の"],["ない"],["よう"],["に"],["する"],["ため"],["で"],["ある"],["」"],["。"]]},{"verse":25,"text":"モーセは民,たみの所,ところに下,くだって行,いって彼,かれらに告,つげた。","tok":[["モーセ"],["は"],["民","たみ"],["の"],["所","ところ"],["に"],["下って","くだって"],["行って","いって"],["彼","かれ"],["ら"],["に"],["告","つげ"],["た"],["。"]]}]
[{"verse":1,"text":"主,しゅはモーセに言,いわれた、","tok":[["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":2,"text":"「イスラエルの人々,ひとびとに告,つげ、引,ひき返,かえして、ミグドルと海,うみとの間,あいだにあるピハヒロテの前,まえ、バアルゼポンの前,まえに宿営,しゅくえいさせなさい。あなたがたはそれにむかって、海,うみのかたわらに宿営,しゅくえいしなければならない。","tok":[["「"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["告","つげ"],["、"],["引","ひき"],["返","かえし"],["て"],["、"],["ミグドル"],["と"],["海","うみ"],["と"],["の"],["間","あいだ"],["に"],["ある"],["ピハヒロテ"],["の"],["前","まえ"],["、"],["バアルゼポン"],["の"],["前","まえ"],["に"],["宿営","しゅくえい"],["させ"],["なさい"],["。"],["あなた"],["がた"],["は"],["それ"],["に"],["むかって"],["、"],["海","うみ"],["の"],["かたわら"],["に"],["宿営","しゅくえい"],["しなければ"],["ならない"],["。"]]},{"verse":3,"text":"パロはイスラエルの人々,ひとびとについて、『彼,かれらはその地,ちで迷,まよっている。荒野,あらのは彼,かれらを閉,とじ込,こめてしまった』と言,いうであろう。","tok":[["パロ"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["について"],["、"],["『"],["彼","かれ"],["ら"],["は"],["その"],["地","ち"],["で"],["迷って","まよって"],["いる"],["。"],["荒野","あら"],["の"],["は"],["彼","かれ"],["ら"],["を"],["閉じ込めて","とじこめて"],["しまった"],["』"],["と"],["言うで","いうで"],["あろう"],["。"]]},{"verse":4,"text":"わたしがパロの心,こころをかたくなにするから、パロは彼,かれらのあとを追,おうであろう。わたしはパロとそのすべての軍勢,ぐんぜいを破,やぶって誉,ほまれを得,え、エジプトびとにわたしが主,しゅであることを知,しらせるであろう」。彼,かれらはそのようにした。","tok":[["わたし"],["が"],["パロ"],["の"],["心","こころ"],["を"],["かたくな"],["に"],["する"],["から"],["、"],["パロ"],["は"],["彼","かれ"],["ら"],["の"],["あと"],["を"],["追うで","おうで"],["あろう"],["。"],["わたし"],["は"],["パロ"],["と"],["その"],["すべて"],["の"],["軍勢","ぐんぜい"],["を"],["破って","やぶって"],["誉","ほまれ"],["を"],["得","え"],["、"],["エジプト"],["びと"],["に"],["わたし"],["が"],["主","しゅ"],["で"],["ある"],["こと"],["を"],["知らせるで","しらせるで"],["あろう"],["」"],["。"],["彼","かれ"],["ら"],["は"],["その"],["よう"],["に"],["した"],["。"]]},{"verse":5,"text":"民,たみの逃,にげ去,さったことが、エジプトの王,おうに伝,つたえられたので、パロとその家来,けらいたちとは、民,たみに対,たいする考,かんがえを変,かえて言,いった、「われわれはなぜこのようにイスラエルを去,さらせて、われわれに仕,つかえさせないようにしたのであろう」。","tok":[["民","たみ"],["の"],["逃去","にげさっ"],["た"],["こと"],["が"],["、"],["エジプト"],["の"],["王","おう"],["に"],["伝えられた","つたえられた"],["ので"],["、"],["パロ"],["と"],["その"],["家来","けらい"],["たち"],["と"],["は"],["、"],["民","たみ"],["に"],["対する","たいする"],["考","かんがえ"],["を"],["変えて","かえて"],["言った","いった"],["、"],["「"],["われわれ"],["は"],["なぜ"],["この"],["よう"],["に"],["イスラエル"],["を"],["去らせて","さらせて"],["、"],["われわれ"],["に"],["仕えさせない","つかえさせない"],["よう"],["に"],["した"],["ので"],["あろう"],["」"],["。"]]},{"verse":6,"text":"それでパロは戦車,せんしゃを整,ととのえ、みずからその民,たみを率,ひきい、","tok":[["それ"],["で"],["パロ"],["は"],["戦車","せんしゃ"],["を"],["整え","ととのえ"],["、"],["みずから"],["その"],["民","たみ"],["を"],["率い","ひきい"],["、"]]},{"verse":7,"text":"また、えり抜,ぬきの戦車,せんしゃ六百と、エジプトのすべての戦車,せんしゃおよびすべての指揮者,しきしゃたちを率,ひきいた。","tok":[["また"],["、"],["えり抜き","えりぬき"],["の"],["戦車","せんしゃ"],["六百","ろくひゃく"],["と"],["、"],["エジプト"],["の"],["すべて"],["の"],["戦車","せんしゃ"],["および"],["すべて"],["の"],["指揮者","しきしゃ"],["たち"],["を"],["率いた","ひきいた"],["。"]]},{"verse":8,"text":"主,しゅがエジプトの王,おうパロの心,こころをかたくなにされたので、彼,かれはイスラエルの人々,ひとびとのあとを追,おった。イスラエルの人々,ひとびとは意気揚々,いきようようと出,でたのである。","tok":[["主","しゅ"],["が"],["エジプト"],["の"],["王","おう"],["パロ"],["の"],["心","こころ"],["を"],["かたくな"],["に"],["された"],["ので"],["、"],["彼","かれ"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["あと"],["を"],["追った","おった"],["。"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["意気","いき"],["揚々","ようよう"],["と"],["出た","でた"],["ので"],["ある"],["。"]]},{"verse":9,"text":"エジプトびとは彼,かれらのあとを追,おい、パロのすべての馬,うまと戦車,せんしゃおよびその騎兵,きへいと軍勢,ぐんぜいとは、バアルゼポンの前,まえにあるピハヒロテのあたりで、海,うみのかたわらに宿営,しゅくえいしている彼,かれらに追,おいついた。","tok":[["エジプト"],["び"],["と"],["は"],["彼","かれ"],["ら"],["の"],["あと"],["を"],["追い","おい"],["、"],["パロ"],["の"],["すべて"],["の"],["馬","うま"],["と"],["戦車","せんしゃ"],["および"],["その"],["騎兵","きへい"],["と"],["軍勢","ぐんぜい"],["と"],["は"],["、"],["バアルゼポン"],["の"],["前","まえ"],["に"],["ある"],["ピハヒロテ"],["の"],["あたり"],["で"],["、"],["海","うみ"],["の"],["かたわら"],["に"],["宿営","しゅくえい"],["して"],["いる"],["彼","かれ"],["ら"],["に"],["追いついた","おいついた"],["。"]]},{"verse":10,"text":"パロが近寄,ちかよった時,とき、イスラエルの人々,ひとびとは目,めを上,あげてエジプトびとが彼,かれらのあとに進,すすんできているのを見,みて、非常,ひじょうに恐,おそれた。そしてイスラエルの人々,ひとびとは主,しゅにむかって叫,さけび、","tok":[["パロ"],["が"],["近寄った","ちかよった"],["時","とき"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["目","め"],["を"],["上げて","あげて"],["エジプト"],["びと"],["が"],["彼","かれ"],["ら"],["の"],["あと"],["に"],["進んで","すすんで"],["きて"],["いる"],["の"],["を"],["見て","みて"],["、"],["非常","ひじょう"],["に"],["恐れた","おそれた"],["。"],["そして"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["主に","しゅに"],["むかって"],["叫","さけび"],["、"]]},{"verse":11,"text":"かつモーセに言,いった、「エジプトに墓,はかがないので、荒野,あらので死,しなせるために、わたしたちを携,たずさえ出,だしたのですか。なぜわたしたちをエジプトから導,みちびき出,だして、こんなにするのですか。","tok":[["かつ"],["モーセ"],["に"],["言った","いった"],["、"],["「"],["エジプト"],["に"],["墓","はか"],["が"],["ない"],["ので"],["、"],["荒野","あらの"],["で"],["死なせる","しなせる"],["ため"],["に"],["、"],["わたしたち"],["を"],["携え","たずさえ"],["出した","だした"],["の"],["です"],["か"],["。"],["なぜ"],["わたしたち"],["を"],["エジプト"],["から"],["導き出して","みちびきだして"],["、"],["こんな"],["に"],["する"],["の"],["です"],["か"],["。"]]},{"verse":12,"text":"わたしたちがエジプトであなたに告,つげて、『わたしたちを捨,すてておいて、エジプトびとに仕,つかえさせてください』と言,いったのは、このことではありませんか。荒野,あらので死,しぬよりもエジプトびとに仕,つかえる方,ほうが、わたしたちにはよかったのです」。","tok":[["わたしたち"],["が"],["エジプト"],["で"],["あなた"],["に"],["告","つげ"],["て"],["、"],["『"],["わたしたち"],["を"],["捨てて","すてて"],["おいて"],["、"],["エジプト"],["びと"],["に"],["仕えさせて","つかえさせて"],["ください"],["』"],["と"],["言った","いった"],["の"],["は"],["、"],["この"],["こと"],["で"],["は"],["ありません"],["か"],["。"],["荒野","あらの"],["で"],["死ぬ","しぬ"],["より"],["も"],["エジプト"],["びと"],["に"],["仕える","つかえる"],["方","ほう"],["が"],["、"],["わたしたち"],["に"],["は"],["よかった"],["の"],["です"],["」"],["。"]]},{"verse":13,"text":"モーセは民,たみに言,いった、「あなたがたは恐,おそれてはならない。かたく立,たって、主,しゅがきょう、あなたがたのためになされる救,すくいを見,みなさい。きょう、あなたがたはエジプトびとを見,みるが、もはや永久,えいきゅうに、二度,どと彼,かれらを見,みないであろう。","tok":[["モーセ"],["は"],["民","たみ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["恐れて","おそれて"],["は"],["ならない"],["。"],["かたく"],["立って","たって"],["、"],["主","しゅ"],["が"],["きょう"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["なされる"],["救い","すくい"],["を"],["見","み"],["なさい"],["。"],["きょう"],["、"],["あなた"],["がた"],["は"],["エジプト"],["びと"],["を"],["見る","みる"],["が"],["、"],["もはや"],["永久","えいきゅう"],["に"],["、"],["二","に"],["度","ど"],["と"],["彼","かれ"],["ら"],["を"],["見ないで","みないで"],["あろう"],["。"]]},{"verse":14,"text":"主,しゅがあなたがたのために戦,たたかわれるから、あなたがたは黙,もくしていなさい」。","tok":[["主","しゅ"],["が"],["あなた"],["がた"],["の"],["ため"],["に"],["戦われる","たたかわれる"],["から"],["、"],["あなた"],["がた"],["は"],["黙して","もくして"],["い"],["なさい"],["」"],["。"]]},{"verse":15,"text":"主,しゅはモーセに言,いわれた、「あなたは、なぜわたしにむかって叫,さけぶのか。イスラエルの人々,ひとびとに語,かたって彼,かれらを進,すすみ行,いかせなさい。","tok":[["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["は"],["、"],["なぜ"],["わたし"],["に"],["むかって"],["叫けぶ","さけぶ"],["の"],["か"],["。"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["語って","かたって"],["彼","かれ"],["ら"],["を"],["進み","すすみ"],["行かせ","いかせ"],["なさい"],["。"]]},{"verse":16,"text":"あなたはつえを上,あげ、手,てを海,うみの上,うえにさし伸,のべてそれを分,わけ、イスラエルの人々,ひとびとに海,うみの中,なかのかわいた地,ちを行,いかせなさい。","tok":[["あなた"],["は"],["つえ"],["を"],["上げ","あげ"],["、"],["手","て"],["を"],["海","うみ"],["の"],["上","うえ"],["に"],["さし伸べて","さしのべて"],["それ"],["を"],["分け","わけ"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["海","うみ"],["の"],["中","なか"],["の"],["かわいた"],["地","ち"],["を"],["行かせ","いかせ"],["なさい"],["。"]]},{"verse":17,"text":"わたしがエジプトびとの心,こころをかたくなにするから、彼,かれらはそのあとを追,おってはいるであろう。こうしてわたしはパロとそのすべての軍勢,ぐんぜいおよび戦車,せんしゃと騎兵,きへいとを打,うち破,やぶって誉,ほまれを得,えよう。","tok":[["わたし"],["が"],["エジプト"],["びと"],["の"],["心","こころ"],["を"],["かたくな"],["に"],["する"],["から"],["、"],["彼","かれ"],["ら"],["は"],["その"],["あと"],["を"],["追っ","おっ"],["ては"],["いるで"],["あろう"],["。"],["こう"],["して"],["わたし"],["は"],["パロ"],["と"],["その"],["すべて"],["の"],["軍勢","ぐんぜい"],["および"],["戦車","せんしゃ"],["と"],["騎兵","きへい"],["と"],["を"],["打ち破って","うちやぶって"],["誉","ほまれ"],["を"],["得よう","えよう"],["。"]]},{"verse":18,"text":"わたしがパロとその戦車,せんしゃとその騎兵,きへいとを打,うち破,やぶって誉,ほまれを得,えるとき、エジプトびとはわたしが主,しゅであることを知,しるであろう」。","tok":[["わたし"],["が"],["パロ"],["と"],["その"],["戦車","せんしゃ"],["と"],["その"],["騎兵","きへい"],["と"],["を"],["打ち破って","うちやぶって"],["誉","ほまれ"],["を"],["得る","える"],["とき"],["、"],["エジプト"],["び"],["と"],["は"],["わたし"],["が"],["主","しゅ"],["で"],["ある"],["こと"],["を"],["知るで","しるで"],["あろう"],["」"],["。"]]},{"verse":19,"text":"このとき、イスラエルの部隊,ぶたいの前,まえに行,いく神,かみの使,つかいは移,うつって彼,かれらのうしろに行,いった。雲,くもの柱,はしらも彼,かれらの前,まえから移,うつって彼,かれらのうしろに立,たち、","tok":[["この"],["とき"],["、"],["イスラエル"],["の"],["部隊","ぶたい"],["の"],["前","まえ"],["に"],["行く","いく"],["神","かみ"],["の"],["使い","つかい"],["は"],["移って","うつって"],["彼","かれ"],["ら"],["の"],["うしろ"],["に"],["行った","いった"],["。"],["雲","くも"],["の"],["柱","はしら"],["も"],["彼","かれ"],["ら"],["の"],["前","まえ"],["から"],["移って","うつって"],["彼","かれ"],["ら"],["の"],["うしろ"],["に"],["立ち","たち"],["、"]]},{"verse":20,"text":"エジプトびとの部隊,ぶたいとイスラエルびとの部隊,ぶたいとの間,あいだにきたので、そこに雲,くもとやみがあり夜,よもすがら、かれとこれと近,ちかづくことなく、夜,よるがすぎた。","tok":[["エジプト"],["びと"],["の"],["部隊","ぶたい"],["と"],["イスラエル"],["びと"],["の"],["部隊","ぶたい"],["と"],["の"],["間","あいだ"],["に"],["きた"],["ので"],["、"],["そこ"],["に"],["雲","くも"],["と"],["やみ"],["が"],["あり"],["夜もすがら","よもすがら"],["、"],["かれ"],["と"],["これ"],["と"],["近づく","ちかづく"],["こと"],["なく"],["、"],["夜","よる"],["が"],["すぎた"],["。"]]},{"verse":21,"text":"モーセが手,てを海,うみの上,うえにさし伸,のべたので、主,しゅは夜,よもすがら強,つよい東風,ひがしかぜをもって海,うみを退,しりぞかせ、海,うみを陸地,りくちとされ、水,みずは分,わかれた。","tok":[["モーセ"],["が"],["手","て"],["を"],["海","うみ"],["の"],["上","うえ"],["に"],["さし伸べた","さしのべた"],["ので"],["、"],["主","しゅ"],["は"],["夜もすがら","よもすがら"],["強い","つよい"],["東風","ひ"],["が"],["し"],["かぜ"],["を"],["もって"],["海","うみ"],["を"],["退ぞかせ","しりぞかせ"],["、"],["海","うみ"],["を"],["陸地","りくち"],["と"],["され"],["、"],["水","みず"],["は"],["分かれた","わかれた"],["。"]]},{"verse":22,"text":"イスラエルの人々,ひとびとは海,うみの中,なかのかわいた地,ちを行,おこなったが、水,みずは彼,かれらの右,みぎと左,ひだりに、かきとなった。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["は"],["海","うみ"],["の"],["中","なか"],["の"],["かわいた"],["地","ち"],["を"],["行なった","おこなった"],["が"],["、"],["水","みず"],["は"],["彼","かれ"],["ら"],["の"],["右","みぎ"],["と"],["左","ひだり"],["に"],["、"],["かき"],["と"],["なった"],["。"]]},{"verse":23,"text":"エジプトびとは追,おってきて、パロのすべての馬,うまと戦車,せんしゃと騎兵,きへいとは、彼,かれらのあとについて海,うみの中,なかにはいった。","tok":[["エジプト"],["び"],["と"],["は"],["追って","おって"],["きて"],["、"],["パロ"],["の"],["すべて"],["の"],["馬","うま"],["と"],["戦車","せんしゃ"],["と"],["騎兵","きへい"],["と"],["は"],["、"],["彼","かれ"],["ら"],["の"],["あと"],["について"],["海","うみ"],["の"],["中","なか"],["に"],["はいった"],["。"]]},{"verse":24,"text":"暁,あかつきの更,さらに、主,しゅは火,ひと雲,くもの柱,はしらのうちからエジプトびとの軍勢,ぐんぜいを見,みおろして、エジプトびとの軍勢,ぐんぜいを乱,みだし、","tok":[["暁","あかつき"],["の"],["更に","さらに"],["、"],["主","しゅ"],["は"],["火","ひ"],["と"],["雲","くも"],["の"],["柱","はしら"],["の"],["うち"],["から"],["エジプト"],["びと"],["の"],["軍勢","ぐんぜい"],["を"],["見おろして","みおろして"],["、"],["エジプト"],["びと"],["の"],["軍勢","ぐんぜい"],["を"],["乱し","みだし"],["、"]]},{"verse":25,"text":"その戦車,せんしゃの輪,わをきしらせて、進,すすむのに重,おもくされたので、エジプトびとは言,いった、「われわれはイスラエルを離,はなれて逃,にげよう。主,しゅが彼,かれらのためにエジプトびとと戦,たたかう」。","tok":[["その"],["戦車","せんしゃ"],["の"],["輪","わ"],["を"],["きしらせて"],["、"],["進","すすむ"],["のに"],["重く","おもく"],["された"],["ので"],["、"],["エジプト"],["び"],["と"],["は"],["言った","いった"],["、"],["「"],["われわれ"],["は"],["イスラエル"],["を"],["離れて","はなれて"],["逃よう","にげよう"],["。"],["主","しゅ"],["が"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["エジプト"],["びと"],["と"],["戦う","たたかう"],["」"],["。"]]},{"verse":26,"text":"そのとき主,しゅはモーセに言,いわれた、「あなたの手,てを海,うみの上,うえにさし伸,のべて、水,みずをエジプトびとと、その戦車,せんしゃと騎兵,きへいとの上,うえに流,ながれ返,かえらせなさい」。","tok":[["その"],["とき"],["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["の"],["手","て"],["を"],["海","うみ"],["の"],["上","うえ"],["に"],["さし伸べて","さしのべて"],["、"],["水","みず"],["を"],["エジプト"],["びと"],["と"],["、"],["その"],["戦車","せんしゃ"],["と"],["騎兵","きへい"],["と"],["の"],["上","うえ"],["に"],["流れ","ながれ"],["返らせ","かえらせ"],["なさい"],["」"],["。"]]},{"verse":27,"text":"モーセが手,てを海,うみの上,うえにさし伸,のべると、夜明,よあけになって海,うみはいつもの流,ながれに返,かえり、エジプトびとはこれにむかって逃,にげたが、主,しゅはエジプトびとを海,うみの中,なかに投,なげ込,こまれた。","tok":[["モーセ"],["が"],["手","て"],["を"],["海","うみ"],["の"],["上","うえ"],["に"],["さし伸べる","さしのべる"],["と"],["、"],["夜明","よあけ"],["に"],["なって"],["海","うみ"],["は"],["いつも"],["の"],["流れ","ながれ"],["に"],["返り","かえり"],["、"],["エジプト"],["び"],["と"],["は"],["これ"],["に"],["むかって"],["逃た","にげた"],["が"],["、"],["主","しゅ"],["は"],["エジプト"],["びと"],["を"],["海","うみ"],["の"],["中","なか"],["に"],["投込まれた","なげこまれた"],["。"]]},{"verse":28,"text":"水,みずは流,ながれ返,かえり、イスラエルのあとを追,おって海,うみにはいった戦車,せんしゃと騎兵,きへいおよびパロのすべての軍勢,ぐんぜいをおおい、ひとりも残,のこらなかった。","tok":[["水","みず"],["は"],["流れ","ながれ"],["返り","かえり"],["、"],["イスラエル"],["の"],["あと"],["を"],["追って","おって"],["海","うみ"],["に"],["はいった"],["戦車","せんしゃ"],["と"],["騎兵","きへい"],["および"],["パロ"],["の"],["すべて"],["の"],["軍勢","ぐんぜい"],["を"],["おおい"],["、"],["ひとり"],["も"],["残らなかった","のこらなかった"],["。"]]},{"verse":29,"text":"しかし、イスラエルの人々,ひとびとは海,うみの中,なかのかわいた地,ちを行,おこなったが、水,みずは彼,かれらの右,みぎと左,ひだりに、かきとなった。","tok":[["しかし"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["海","うみ"],["の"],["中","なか"],["の"],["かわいた"],["地","ち"],["を"],["行なった","おこなった"],["が"],["、"],["水","みず"],["は"],["彼","かれ"],["ら"],["の"],["右","みぎ"],["と"],["左","ひだり"],["に"],["、"],["かき"],["と"],["なった"],["。"]]},{"verse":30,"text":"このように、主,しゅはこの日,ひイスラエルをエジプトびとの手,てから救,すくわれた。イスラエルはエジプトびとが海,うみべに死,しんでいるのを見,みた。","tok":[["この"],["よう"],["に"],["、"],["主","しゅ"],["は"],["この"],["日","ひ"],["イスラエル"],["を"],["エジプト"],["びと"],["の"],["手","て"],["から"],["救われた","すくわれた"],["。"],["イスラエル"],["は"],["エジプト"],["びと"],["が"],["海べ","うみべ"],["に"],["死んで","しんで"],["いる"],["の"],["を"],["見た","みた"],["。"]]},{"verse":31,"text":"イスラエルはまた、主,しゅがエジプトびとに行,おこなわれた大,おおいなるみわざを見,みた。それで民,たみは主,しゅを恐,おそれ、主,しゅとそのしもべモーセとを信,しんじた。","tok":[["イスラエル"],["は"],["また"],["、"],["主","しゅ"],["が"],["エジプト"],["びと"],["に"],["行なわれた","おこなわれた"],["大いなる","おおいなる"],["みわざ"],["を"],["見た","みた"],["。"],["それ"],["で"],["民","たみ"],["は"],["主","しゅ"],["を"],["恐","おそれ"],["、"],["主","しゅとそ"],["の"],["しもべ"],["モーセ"],["と"],["を"],["信じた","しんじた"],["。"]]}]
[{"verse":1,"text":"主,しゅはモーセに言,いわれた、「あなたは前,まえのような石,いしの板,いた二枚,まいを、切,きって造,つくりなさい。わたしはあなたが砕,くだいた初,はじめの板,いたにあった言葉,ことばを、その板,いたに書,かくであろう。","tok":[["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["は"],["前","まえ"],["の"],["よう"],["な"],["石","いし"],["の"],["板","いた"],["二枚","まい"],["を"],["、"],["切って","きって"],["造","つくり"],["なさい"],["。"],["わたし"],["は"],["あなた"],["が"],["砕いた","くだいた"],["初め","はじめ"],["の"],["板","いた"],["に"],["あった"],["言葉","ことば"],["を"],["、"],["その"],["板","いた"],["に"],["書くで","かくで"],["あろう"],["。"]]},{"verse":2,"text":"あなたは朝,あさまでに備,そなえをし、朝,あさのうちにシナイ山,さんに登,のぼって、山,やまの頂,いただきでわたしの前,まえに立,たちなさい。","tok":[["あなた"],["は"],["朝","あさ"],["まで"],["に"],["備","そなえ"],["を"],["し"],["、"],["朝","あさ"],["の"],["うち"],["に"],["シナイ"],["山","さん"],["に"],["登って","のぼって"],["、"],["山","やま"],["の"],["頂","いただき"],["で"],["わたし"],["の"],["前","まえ"],["に"],["立","たち"],["なさい"],["。"]]},{"verse":3,"text":"だれもあなたと共,ともに登,のぼってはならない。また、だれも山,やまの中,なかにいてはならない。また山,やまの前,まえで羊,ひつじや牛,うしを飼,かっていてはならない」。","tok":[["だれ"],["も"],["あなた"],["と"],["共","とも"],["に"],["登って","のぼって"],["は"],["ならない"],["。"],["また"],["、"],["だれ"],["も"],["山","やま"],["の"],["中","なか"],["に"],["いて"],["は"],["ならない"],["。"],["また"],["山","やま"],["の"],["前","まえ"],["で"],["羊","ひつじ"],["や"],["牛","うし"],["を"],["飼って","かって"],["いて"],["は"],["ならない"],["」"],["。"]]},{"verse":4,"text":"そこでモーセは前,まえのような石,いしの板,いた二枚,まいを、切,きって造,つくり、朝,あさ早,はやく起,おきて、主,しゅが彼,かれに命,めいじられたようにシナイ山,さんに登,のぼった。彼,かれはその手,てに石,いしの板,いた二枚,まいをとった。","tok":[["そこ"],["で"],["モーセ"],["は"],["前","まえ"],["の"],["よう"],["な"],["石","いし"],["の"],["板","いた"],["二枚","まい"],["を"],["、"],["切って","きって"],["造","つくり"],["、"],["朝","あさ"],["早く","はやく"],["起きて","おきて"],["、"],["主","しゅ"],["が"],["彼","かれ"],["に"],["命じられた","めいじられた"],["よう"],["に"],["シナイ"],["山","さん"],["に"],["登った","のぼった"],["。"],["彼","かれ"],["は"],["その"],["手","て"],["に"],["石","いし"],["の"],["板","いた"],["二枚","まい"],["を"],["とった"],["。"]]},{"verse":5,"text":"ときに主,しゅは雲,くもの中,なかにあって下,くだり、彼,かれと共,ともにそこに立,たって主,しゅの名,なを宣,のべられた。","tok":[["とき"],["に"],["主","しゅ"],["は"],["雲","くも"],["の"],["中","なか"],["に"],["あって"],["下り","くだり"],["、"],["彼","かれ"],["と"],["共","とも"],["に"],["そこ"],["に"],["立って","たって"],["主","しゅ"],["の"],["名","な"],["を"],["宣べられた","のべられた"],["。"]]},{"verse":6,"text":"主,しゅは彼,かれの前,まえを過,すぎて宣,のべられた。「主,しゅ、主,しゅ、あわれみあり、恵,めぐみあり、怒,いかることおそく、いつくしみと、まこととの豊,ゆたかなる神,かみ、","tok":[["主","しゅ"],["は"],["彼","かれ"],["の"],["前","まえ"],["を"],["過て","すぎて"],["宣べられた","のべられた"],["。"],["「"],["主","しゅ"],["、"],["主","しゅ"],["、"],["あわれみ"],["あり"],["、"],["恵","めぐみ"],["あり"],["、"],["怒","いかるこ"],["と"],["おそく"],["、"],["いつくしみ"],["と"],["、"],["まこと"],["と"],["の"],["豊","ゆたか"],["なる"],["神","かみ"],["、"]]},{"verse":7,"text":"いつくしみを千代,だいまでも施,ほどこし、悪,あくと、とがと、罪,つみとをゆるす者,もの、しかし、罰,ばつすべき者,ものをば決,けっしてゆるさず、父,ちちの罪,つみを子,こに報,むくい、子,この子,こに報,むくいて、三、四代,だいにおよぼす者,もの」。","tok":[["いつくしみ"],["を"],["千代","だいま"],["で"],["も"],["施し","ほどこし"],["、"],["悪","あく"],["と"],["、"],["とが"],["と"],["、"],["罪","つみ"],["と"],["を"],["ゆるす"],["者","もの"],["、"],["しかし"],["、"],["罰すべき","ばつすべき"],["者","もの"],["をば"],["決っして","けっして"],["ゆるさず"],["、"],["父","ちち"],["の"],["罪","つみ"],["を"],["子","こ"],["に"],["報い","むくい"],["、"],["子","こ"],["の"],["子","こ"],["に"],["報いて","むくいて"],["、"],["三","さん"],["、"],["四","よん"],["代","だい"],["に"],["およぼす"],["者","もの"],["」"],["。"]]},{"verse":8,"text":"モーセは急,いそぎ地,ちに伏,ふして拝,はいし、","tok":[["モーセ"],["は"],["急ぎ","いそぎ"],["地","ち"],["に"],["伏して","ふして"],["拝し","はいし"],["、"]]},{"verse":9,"text":"そして言,いった、「ああ主,しゅよ、わたしがもし、あなたの前,まえに恵,めぐみを得,えますならば、かたくなな民,たみですけれども、どうか主,しゅがわたしたちのうちにあって一緒,いっしょに行,いってください。そしてわたしたちの悪,あくと罪,つみとをゆるし、わたしたちをあなたのものとしてください」。","tok":[["そして"],["言った","いった"],["、"],["「"],["ああ"],["主","しゅ"],["よ"],["、"],["わたし"],["が"],["もし"],["、"],["あなた"],["の"],["前","まえ"],["に"],["恵","めぐみ"],["を"],["得ますならば","えますならば"],["、"],["かたくな"],["な"],["民","たみ"],["です"],["けれど"],["も"],["、"],["どう"],["か"],["主","しゅ"],["が"],["わたしたち"],["の"],["うち"],["に"],["あって"],["一緒","いっしょ"],["に"],["行って","いって"],["ください"],["。"],["そして"],["わたしたち"],["の"],["悪","あく"],["と"],["罪","つみ"],["と"],["を"],["ゆるし"],["、"],["わたしたち"],["を"],["あなた"],["の"],["もの"],["として"],["ください"],["」"],["。"]]},{"verse":10,"text":"主,しゅは言,いわれた、「見,みよ、わたしは契約,けいやくを結,むすぶ。わたしは地,ちのいずこにも、いかなる民,たみのうちにも、いまだ行,おこなわれたことのない不思議,ふしぎを、あなたのすべての民,たみの前,まえに行,おこなうであろう。あなたが共,ともに住,すむ民,たみはみな、主,しゅのわざを見,みるであろう。わたしがあなたのためになそうとすることは、恐,おそるべきものだからである。","tok":[["主","しゅ"],["は"],["言われた","いわれた"],["、"],["「"],["見よ","みよ"],["、"],["わたし"],["は"],["契約","けいやく"],["を"],["結ぶ","むすぶ"],["。"],["わたし"],["は"],["地","ち"],["の"],["いずこ"],["に"],["も"],["、"],["いかなる"],["民","たみ"],["の"],["うち"],["に"],["も"],["、"],["いまだ"],["行なわれた","おこなわれた"],["こと"],["の"],["ない"],["不思議","ふしぎ"],["を"],["、"],["あなた"],["の"],["すべて"],["の"],["民","たみ"],["の"],["前","まえ"],["に"],["行なうで","おこなうで"],["あろう"],["。"],["あなた"],["が"],["共","とも"],["に"],["住む","すむ"],["民","たみ"],["は"],["みな"],["、"],["主","しゅ"],["の"],["わざ"],["を"],["見るで","みるで"],["あろう"],["。"],["わたし"],["が"],["あなた"],["の"],["ため"],["に"],["なそう"],["と"],["する"],["こと"],["は"],["、"],["恐るべき","おそるべき"],["もの"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":11,"text":"わたしが、きょう、あなたに命,めいじることを守,まもりなさい。見,みよ、わたしはアモリびと、カナンびと、ヘテびと、ペリジびと、ヒビびと、エブスびとを、あなたの前,まえから追,おい払,はらうであろう。","tok":[["わたし"],["が"],["、"],["きょう"],["、"],["あなた"],["に"],["命じる","めいじる"],["こと"],["を"],["守り","まもり"],["なさい"],["。"],["見よ","みよ"],["、"],["わたし"],["は"],["アモリ"],["び"],["と"],["、"],["カナン"],["び"],["と"],["、"],["ヘテ"],["び"],["と"],["、"],["ペリジ"],["び"],["と"],["、"],["ヒビ"],["び"],["と"],["、"],["エブス"],["びと"],["を"],["、"],["あなた"],["の"],["前","まえ"],["から"],["追い払うで","おいはらうで"],["あろう"],["。"]]},{"verse":12,"text":"あなたが行,ゆく国,くにに住,すんでいる者,ものと、契約,けいやくを結,むすばないように、気,きをつけなければならない。おそらく彼,かれらはあなたのうちにあって、わなとなるであろう。","tok":[["あなた"],["が"],["行く","ゆく"],["国","くに"],["に"],["住んで","すんで"],["いる"],["者","もの"],["と"],["、"],["契約","けいやく"],["を"],["結ばない","むすばない"],["よう"],["に"],["、"],["気","き"],["を"],["つけなければ"],["ならない"],["。"],["おそらく"],["彼","かれ"],["ら"],["は"],["あなた"],["の"],["うち"],["に"],["あって"],["、"],["わな"],["と"],["なるで"],["あろう"],["。"]]},{"verse":13,"text":"むしろあなたがたは、彼,かれらの祭壇,さいだんを倒,たおし、石,いしの柱,はしらを砕,くだき、アシラ像,ぞうを切,きり倒,たおさなければならない。","tok":[["むしろ"],["あなた"],["がた"],["は"],["、"],["彼","かれ"],["ら"],["の"],["祭壇","さいだん"],["を"],["倒し","たおし"],["、"],["石","いし"],["の"],["柱","はしら"],["を"],["砕き","くだき"],["、"],["アシラ"],["像","ぞう"],["を"],["切り倒さなければ","きりたおさなければ"],["ならない"],["。"]]},{"verse":14,"text":"あなたは他,たの神,かみを拝,おがんではならない。主,しゅはその名,なを『ねたみ』と言,いって、ねたむ神,かみだからである。","tok":[["あなた"],["は"],["他","た"],["の"],["神","かみ"],["を"],["拝","おがん"],["で"],["は"],["ならない"],["。"],["主","しゅ"],["は"],["その"],["名","な"],["を"],["『"],["ねたみ"],["』"],["と"],["言って","いって"],["、"],["ねたむ"],["神","かみ"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":15,"text":"おそらくあなたはその国,くにに住,すむ者,ものと契約,けいやくを結,むすび、彼,かれらの神々,かみがみを慕,したって姦淫,かんいんを行,おこない、その神々,かみがみに犠牲,ぎせいをささげ、招,まねかれて彼,かれらの犠牲,ぎせいを食,たべ、","tok":[["おそらく"],["あなた"],["は"],["その"],["国","くに"],["に"],["住む","すむ"],["者","もの"],["と"],["契約","けいやく"],["を"],["結び","むすび"],["、"],["彼","かれ"],["ら"],["の"],["神々","かみがみ"],["を"],["慕って","したって"],["姦淫","かんいん"],["を"],["行ない","おこない"],["、"],["その"],["神々","かみがみ"],["に"],["犠牲","ぎせい"],["を"],["ささげ"],["、"],["招かれて","まねかれて"],["彼","かれ"],["ら"],["の"],["犠牲","ぎせい"],["を"],["食べ","たべ"],["、"]]},{"verse":16,"text":"またその娘,むすめたちを、あなたのむすこたちにめとり、その娘,むすめたちが自分,じぶんたちの神々,かみがみを慕,したって姦淫,かんいんを行,おこない、また、あなたのむすこたちをして、彼,かれらの神々,かみがみを慕,したわせ、姦淫,かんいんを行,おこなわせるに至,いたるであろう。","tok":[["また"],["その"],["娘","むすめ"],["たち"],["を"],["、"],["あなた"],["の"],["むすこ"],["たち"],["に"],["めとり"],["、"],["その"],["娘","むすめ"],["たち"],["が"],["自分","じぶん"],["たち"],["の"],["神々","かみがみ"],["を"],["慕って","したって"],["姦淫","かんいん"],["を"],["行ない","おこない"],["、"],["また"],["、"],["あなた"],["の"],["むすこ"],["たち"],["を"],["して"],["、"],["彼","かれ"],["ら"],["の"],["神々","かみがみ"],["を"],["慕わせ","したわせ"],["、"],["姦淫","かんいん"],["を"],["行なわせる","おこなわせる"],["に"],["至るで","いたるで"],["あろう"],["。"]]},{"verse":17,"text":"あなたは自分,じぶんのために鋳物,いものの神々,かみがみを造,つくってはならない。","tok":[["あなた"],["は"],["自分","じぶん"],["の"],["ため"],["に"],["鋳物","いもの"],["の"],["神々","かみがみ"],["を"],["造って","つくって"],["は"],["ならない"],["。"]]},{"verse":18,"text":"あなたは種,たね入,いれぬパンの祭,まつりを守,まもらなければならない。すなわち、わたしがあなたに命,めいじたように、アビブの月,つきの定,さだめの時,ときに、七日,なぬかのあいだ、種,たね入,いれぬパンを食,たべなければならない。あなたがアビブの月,つきにエジプトを出,でたからである。","tok":[["あなた"],["は"],["種","た"],["ね"],["入れぬ","いれぬ"],["パン"],["の"],["祭","まつり"],["を"],["守らなければ","まもらなければ"],["ならない"],["。"],["すなわち"],["、"],["わたし"],["が"],["あなた"],["に"],["命じた","めいじた"],["よう"],["に"],["、"],["アビブ"],["の"],["月","つき"],["の"],["定め","さだめ"],["の"],["時","とき"],["に"],["、"],["七日","なぬか"],["の"],["あいだ"],["、"],["種","た"],["ね"],["入れぬ","いれぬ"],["パン"],["を"],["食べなければ","たべなければ"],["ならない"],["。"],["あなた"],["が"],["アビブ"],["の"],["月","つき"],["に"],["エジプト"],["を"],["出た","でた"],["から"],["で"],["ある"],["。"]]},{"verse":19,"text":"すべて初,はじめに生,うまれる者,ものは、わたしのものである。すべてあなたの家畜,かちくのういごの雄,おすは、牛,うしも羊,ひつじもそうである。","tok":[["すべて"],["初め","はじめ"],["に"],["生まれる","うまれる"],["者","もの"],["は"],["、"],["わたし"],["の"],["もの"],["で"],["ある"],["。"],["すべて"],["あなた"],["の"],["家畜","かちく"],["の"],["うい"],["ご"],["の"],["雄","おす"],["は"],["、"],["牛","うし"],["も"],["羊","ひつじ"],["も"],["そう"],["で"],["ある"],["。"]]},{"verse":20,"text":"ただし、ろばのういごは小羊,こひつじであがなわなければならない。もしあがなわないならば、その首,くびを折,おらなければならない。あなたのむすこのうちのういごは、みなあがなわなければならない。むなし手,てでわたしの前,まえに出,でてはならない。","tok":[["ただし"],["、"],["ろば"],["の"],["うい"],["ご"],["は"],["小羊","こひつじ"],["で"],["あがなわなければ"],["ならない"],["。"],["もし"],["あがなわないならば"],["、"],["その"],["首","くび"],["を"],["折らなければ","おらなければ"],["ならない"],["。"],["あなた"],["の"],["むすこ"],["の"],["うち"],["の"],["うい"],["ご"],["は"],["、"],["みな"],["あがなわなければ"],["ならない"],["。"],["むなし"],["手","て"],["で"],["わたし"],["の"],["前","まえ"],["に"],["出て","でて"],["は"],["ならない"],["。"]]},{"verse":21,"text":"あなたは六日,かのあいだ働,はたらき、七日,なぬか目,めには休,やすまなければならない。耕,たがやし時,どきにも、刈入,かりいれ時,どきにも休,やすまなければならない。","tok":[["あなた"],["は"],["六日","か"],["の"],["あいだ"],["働らき","はたらき"],["、"],["七日","な"],["ぬか目","ぬかめ"],["に"],["は"],["休まなければ","やすまなければ"],["ならない"],["。"],["耕やし","たがやし"],["時","どき"],["に"],["も"],["、"],["刈入れ","かりいれ"],["時","どき"],["に"],["も"],["休まなければ","やすまなければ"],["ならない"],["。"]]},{"verse":22,"text":"あなたは七週,しゅうの祭,まつり、すなわち小麦,こむぎ刈,かりの初穂,はつほの祭,まつりを行,おこなわなければならない。また年,ねんの終,おわりに取,とり入,いれの祭,まつりを行,おこなわなければならない。","tok":[["あなた"],["は"],["七","なな"],["週","しゅう"],["の"],["祭","まつり"],["、"],["すなわち"],["小","こ"],["麦刈","麦かり"],["の"],["初穂","はつほ"],["の"],["祭","まつり"],["を"],["行なわなければ","おこなわなければ"],["ならない"],["。"],["また"],["年","ねん"],["の"],["終わり","おわり"],["に"],["取入","とりいれ"],["の"],["祭","まつり"],["を"],["行なわなければ","おこなわなければ"],["ならない"],["。"]]},{"verse":23,"text":"年,ねんに三度,ど、男子,だんしはみな主,しゅなる神,かみ、イスラエルの神,かみの前,まえに出,でなければならない。","tok":[["年","ねん"],["に"],["三","さん"],["度","ど"],["、"],["男子","だんし"],["は"],["みな"],["主","しゅ"],["なる"],["神","かみ"],["、"],["イスラエル"],["の"],["神","かみ"],["の"],["前","まえ"],["に"],["出なければ","でなければ"],["ならない"],["。"]]},{"verse":24,"text":"わたしは国々,くにぐにの民,たみをあなたの前,まえから追,おい払,はらって、あなたの境,さかいを広,ひろくするであろう。あなたが年,ねんに三度,どのぼって、あなたの神,かみ、主,しゅの前,まえに出,でる時,ときには、だれもあなたの国,くにを侵,おかすことはないであろう。","tok":[["わたし"],["は"],["国々","くにぐに"],["の"],["民","たみ"],["を"],["あなた"],["の"],["前","まえ"],["から"],["追い払って","おいはらって"],["、"],["あなた"],["の"],["境","さかい"],["を"],["広く","ひろく"],["するで"],["あろう"],["。"],["あなた"],["が"],["年","ねん"],["に"],["三","さん"],["度","ど"],["のぼって"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["出る","でる"],["時","とき"],["に"],["は"],["、"],["だれ"],["も"],["あなた"],["の"],["国","くに"],["を"],["侵す","おかす"],["こと"],["は"],["ないで"],["あろう"],["。"]]},{"verse":25,"text":"あなたは犠牲,ぎせいの血,ちを、種,たねを入,いれたパンと共,ともに供,そなえてはならない。また過越,すぎこしの祭,まつりの犠牲,ぎせいを、翌朝,よくあさまで残,のこして置,おいてはならない。","tok":[["あなた"],["は"],["犠牲","ぎせい"],["の"],["血","ち"],["を"],["、"],["種","たね"],["を"],["入れた","いれた"],["パン"],["と"],["共","とも"],["に"],["供えて","そなえて"],["は"],["ならない"],["。"],["また"],["過越","すぎこし"],["の"],["祭","まつり"],["の"],["犠牲","ぎせい"],["を"],["、"],["翌朝","よくあさ"],["まで"],["残して","のこして"],["置いて","おいて"],["は"],["ならない"],["。"]]},{"verse":26,"text":"あなたの土地,とちの初穂,はつほの最,もっとも良,よいものを、あなたの神,かみ、主,しゅの家,いえに携,たずさえてこなければならない。あなたは子,こやぎをその母,ははの乳,ちちで煮,にてはならない」。","tok":[["あなた"],["の"],["土地","とち"],["の"],["初穂","はつほ"],["の"],["最も","もっとも"],["良い","よい"],["もの"],["を"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["家","いえ"],["に"],["携えて","たずさえて"],["こなければ"],["ならない"],["。"],["あなた"],["は"],["子やぎ","こやぎ"],["を"],["その"],["母","はは"],["の"],["乳","ちち"],["で"],["煮て","にて"],["は"],["ならない"],["」"],["。"]]},{"verse":27,"text":"また主,しゅはモーセに言,いわれた、「これらの言葉,ことばを書,かきしるしなさい。わたしはこれらの言葉,ことばに基,もとづいて、あなたおよびイスラエルと契約,けいやくを結,むすんだからである」。","tok":[["また"],["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"],["「"],["これ"],["ら"],["の"],["言葉","ことば"],["を"],["書きしるし","かきしるし"],["なさい"],["。"],["わたし"],["は"],["これ"],["ら"],["の"],["言葉","ことば"],["に"],["基づいて","もとづいて"],["、"],["あなた"],["および"],["イスラエル"],["と"],["契約","けいやく"],["を"],["結んだ","むすんだ"],["から"],["で"],["ある"],["」"],["。"]]},{"verse":28,"text":"モーセは主,しゅと共,ともに、四十日,にち四十夜,や、そこにいたが、パンも食,たべず、水,みずも飲,のまなかった。そして彼,かれは契約,けいやくの言葉,ことば、十誡,じっかいを板,いたの上,うえに書,かいた。","tok":[["モーセ"],["は"],["主","しゅ"],["と"],["共","とも"],["に"],["、"],["四十日","に"],["ち"],["四十","よんじゅう"],["夜","よる"],["、"],["そこ"],["に"],["いた"],["が"],["、"],["パン"],["も"],["食べず","たべず"],["、"],["水","みず"],["も"],["飲まなかった","のまなかった"],["。"],["そして"],["彼","かれ"],["は"],["契約","けいやく"],["の"],["言葉","ことば"],["、"],["十","じゅう"],["誡","かい"],["を"],["板","いた"],["の"],["上","うえ"],["に"],["書いた","かいた"],["。"]]},{"verse":29,"text":"モーセはそのあかしの板,いた二枚,まいを手,てにして、シナイ山,さんから下,くだったが、その山,やまを下,くだったとき、モーセは、さきに主,しゅと語,かたったゆえに、顔,かおの皮,かわが光,ひかりを放,はなっているのを知,しらなかった。","tok":[["モーセ"],["は"],["その"],["あかし"],["の"],["板","いた"],["二枚","まい"],["を"],["手","て"],["に"],["して"],["、"],["シナイ"],["山","さんか"],["ら"],["下った","くだった"],["が"],["、"],["その"],["山","やま"],["を"],["下った","くだった"],["とき"],["、"],["モーセ"],["は"],["、"],["さき"],["に"],["主","しゅ"],["と"],["語った","かたった"],["ゆえ"],["に"],["、"],["顔","かお"],["の"],["皮","かわ"],["が"],["光","ひかり"],["を"],["放って","はなって"],["いる"],["の"],["を"],["知らなかった","しらなかった"],["。"]]},{"verse":30,"text":"アロンとイスラエルの人々,ひとびととがみな、モーセを見,みると、彼,かれの顔,かおの皮,かわが光,ひかりを放,はなっていたので、彼,かれらは恐,おそれてこれに近,ちかづかなかった。","tok":[["アロン"],["と"],["イスラエル"],["の"],["人々","ひとびと"],["と"],["が"],["みな"],["、"],["モーセ"],["を"],["見る","みる"],["と"],["、"],["彼","かれ"],["の"],["顔","かお"],["の"],["皮","かわ"],["が"],["光","ひかり"],["を"],["放って","はなって"],["いた"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["恐れて","おそれて"],["これ"],["に"],["近づかなかった","ちかづかなかった"],["。"]]},{"verse":31,"text":"モーセは彼,かれらを呼,よんだ。アロンと会衆,かいしゅうのかしらたちとがみな、モーセのもとに帰,かえってきたので、モーセは彼,かれらと語,かたった。","tok":[["モーセ"],["は"],["彼","かれ"],["ら"],["を"],["呼んだ","よんだ"],["。"],["アロン"],["と"],["会衆","かいしゅう"],["の"],["かしら"],["たち"],["と"],["が"],["みな"],["、"],["モーセ"],["の"],["もと"],["に"],["帰えって","かえって"],["きた"],["ので"],["、"],["モーセ"],["は"],["彼","かれ"],["ら"],["と"],["語った","かたった"],["。"]]},{"verse":32,"text":"その後,のち、イスラエルの人々,ひとびとがみな近,ちかよったので、モーセは主,しゅがシナイ山,さんで彼,かれに語,かたられたことを、ことごとく彼,かれらにさとした。","tok":[["その後","そのの"],["ち"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["が"],["みな"],["近よった","ちかよった"],["ので"],["、"],["モーセ"],["は"],["主","しゅ"],["が"],["シナイ"],["山","さん"],["で"],["彼","かれ"],["に"],["語られた","かたられた"],["こと"],["を"],["、"],["ことごとく"],["彼","かれ"],["ら"],["に"],["さとした"],["。"]]},{"verse":33,"text":"モーセは彼,かれらと語,かたり終,おえた時,とき、顔,かおおおいを顔,かおに当,あてた。","tok":[["モーセ"],["は"],["彼","かれ"],["ら"],["と"],["語り","かたり"],["終えた","おえた"],["時","とき"],["、"],["顔","かお"],["おおい"],["を"],["顔","かお"],["に"],["当てた","あてた"],["。"]]},{"verse":34,"text":"しかしモーセは主,しゅの前,まえに行,いって主,しゅと語,かたる時,ときは、出,でるまで顔,かおおおいを取,とり除,のぞいていた。そして出,でて来,くると、その命,めいじられた事,ことをイスラエルの人,ひと人,ひとに告,つげた。","tok":[["しかし"],["モーセ"],["は"],["主","しゅ"],["の"],["前","まえ"],["に"],["行って","いって"],["主","しゅ"],["と"],["語る","かたる"],["時","とき"],["は"],["、"],["出る","でる"],["まで"],["顔","かお"],["おおい"],["を"],["取除いて","とりのぞいて"],["いた"],["。"],["そして"],["出て","でて"],["来る","くる"],["と"],["、"],["その"],["命じられた","めいじられた"],["事","こと"],["を"],["イスラエル"],["の"],["人人","ひとひと"],["に"],["告","つげ"],["た"],["。"]]},{"verse":35,"text":"イスラエルの人々,ひとびとはモーセの顔,かおを見,みると、モーセの顔,かおの皮,かわが光,ひかりを放,はなっていた。モーセは行,いって主,しゅと語,かたるまで、また顔,かおおおいを顔,かおに当,あてた。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["は"],["モーセ"],["の"],["顔","かお"],["を"],["見る","みる"],["と"],["、"],["モーセ"],["の"],["顔","かお"],["の"],["皮","かわ"],["が"],["光","ひかり"],["を"],["放って","はなって"],["いた"],["。"],["モーセ"],["は"],["行って","いって"],["主","しゅ"],["と"],["語る","かたる"],["まで"],["、"],["また"],["顔","かお"],["おおい"],["を"],["顔","かお"],["に"],["当てた","あてた"],["。"]]}]
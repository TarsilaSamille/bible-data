],["しかし"],["日","ひ"],["が"],["のぼって"],["後","の"],["ち"],["ならば"],["、"],["その"],["人","ひと"],["に"],["血","ち"],["を"],["流した","ながした"],["罪","つみ"],["が"],["ある"],["。"]]},{"verse":4,"text":"[5]もし人,ひとが畑,はたけまたはぶどう畑,はたけのものを食,くわせ、その家畜,かちくを放,はなって他人,たにんの畑,はたけのものを食,くわせた時,ときは、自分,じぶんの畑,はたけの最,もっとも良,よい物,ものと、ぶどう畑,はたけの最,もっとも良,よい物,ものをもって、これを償,つぐなわなければならない。","tok":[["["],["5"],["]"],["もし"],["人","ひと"],["が"],["畑","はたけ"],["また"],["は"],["ぶどう"],["畑","はたけ"],["の"],["もの"],["を"],["食わせ","くわせ"],["、"],["その"],["家畜","かちく"],["を"],["放って","はなって"],["他人","たにん"],["の"],["畑","はたけ"],["の"],["もの"],["を"],["食わせた","くわせた"],["時","とき"],["は"],["、"],["自分","じぶん"],["の"],["畑","はたけ"],["の"],["最も","もっとも"],["良い","よい"],["物","もの"],["と"],["、"],["ぶどう"],["畑","はたけ"],["の"],["最も","もっとも"],["良い","よい"],["物","もの"],["を"],["もって"],["、"],["これ"],["を"],["償なわなければ","つぐなわなければ"],["ならない"],["。"]]},{"verse":5,"text":"[6]もし火,ひが出,でて、いばらに移,うつり、積,つみあげた麦,むぎ束,たば、または立,た穂,ほ、または畑,はたけを焼,やいたならば、その火,ひを燃,もやした者,ものは、必,かならずこれを償,つぐなわなければならない。","tok":[["["],["6"],["]"],["もし"],["火","ひ"],["が"],["出て","でて"],["、"],["いばら"],["に"],["移り","うつり"],["、"],["積みあげた","つみあげた"],["麦","むぎ"],["束","たば"],["、"],["また"],["は"],["立穂","たほ"],["、"],["また"],["は"],["畑","はたけ"],["を"],["焼いたならば","やいたならば"],["、"],["その"],["火","ひ"],["を"],["燃やした","もやした"],["者","もの"],["は"],["、"],["必","かならず"],["これ"],["を"],["償なわなければ","つぐなわなければ"],["ならない"],["。"]]},{"verse":6,"text":"[7]もし人,ひとが金銭,きんせんまたは物品,ぶっぴんの保管,ほかんを隣人,りんじんに託,たくし、それが隣人,りんじんの家,いえから盗,ぬすまれた時,とき、その盗,ぬすびとが見,みつけられたならば、これを二倍,ばいにして償,つぐなわせなければならない。","tok":[["["],["7"],["]"],["もし"],["人","ひと"],["が"],["金銭","きんせん"],["また"],["は"],["物品","ぶっぴん"],["の"],["保管","ほかん"],["を"],["隣人","りんじん"],["に"],["託し","たくし"],["、"],["それ"],["が"],["隣人","りんじん"],["の"],["家","いえ"],["から"],["盗まれた","ぬすまれた"],["時","とき"],["、"],["その"],["盗","ぬすび"],["と"],["が"],["見つけられたならば","みつけられたならば"],["、"],["これ"],["を"],["二","に"],["倍","ばい"],["に"],["して"],["償なわせなければ","つぐなわせなければ"],["ならない"],["。"]]},{"verse":7,"text":"[8]もし盗,ぬすびとが見,みつけられなければ、家,いえの主人,しゅじんを神,かみの前,まえに連,つれてきて、彼,かれが隣人,りんじんの持,もち物,ものに手,てをかけたかどうかを、確,たしかめなければならない。","tok":[["["],["8"],["]"],["も"],["し"],["盗","ぬすび"],["と"],["が"],["見つけられなければ","みつけられなければ"],["、"],["家","いえ"],["の"],["主人","しゅじん"],["を"],["神","かみ"],["の"],["前","まえ"],["に"],["連れて","つれて"],["きて"],["、"],["彼","かれ"],["が"],["隣人","りんじん"],["の"],["持物","もちもの"],["に"],["手","て"],["を"],["かけた"],["か"],["どう"],["か"],["を"],["、"],["確かめなければ","たしかめなければ"],["ならない"],["。"]]},{"verse":8,"text":"[9]牛,うしであれ、ろばであれ、羊,ひつじであれ、衣服,いふくであれ、あるいはどんな失,うしなった物,ものであれ、それについて言,いい争,あらそいが起,おこり『これがそれです』と言,いう者,ものがあれば、その双方,そうほうの言,いい分,ぶんを、神,かみの前,まえに持,もち出,ださなければならない。そして神,かみが有罪,ゆうざいと定,さだめられる者,ものは、それを二倍,ばいにしてその相手,あいてに償,つぐなわなければならない。","tok":[["["],["9"],["]"],["牛","うし"],["で"],["あれ"],["、"],["ろば"],["で"],["あれ"],["、"],["羊","ひつじ"],["で"],["あれ"],["、"],["衣服","いふく"],["で"],["あれ"],["、"],["あるいは"],["どんな"],["失なった","うしなった"],["物","もの"],["で"],["あれ"],["、"],["それ"],["について"],["言い争い","いいあらそい"],["が"],["起こり","おこり"],["『"],["これ"],["が"],["それ"],["です"],["』"],["と"],["言う","いう"],["者","もの"],["が"],["あれば"],["、"],["その"],["双方","そうほう"],["の"],["言い分","いいぶん"],["を"],["、"],["神","かみ"],["の"],["前","まえ"],["に"],["持出さなければ","もちださなければ"],["ならない"],["。"],["そして"],["神","かみ"],["が"],["有罪","ゆうざい"],["と"],["定められる","さだめられる"],["者","もの"],["は"],["、"],["それ"],["を"],["二","に"],["倍","ばい"],["に"],["して"],["その"],["相手","あいて"],["に"],["償なわなければ","つぐなわなければ"],["ならない"],["。"]]},{"verse":9,"text":"[10]もし人,ひとが、ろば、または牛,うし、または羊,ひつじ、またはどんな家畜,かちくでも、それを隣人,りんじんに預,あづけて、それが死,しぬか、傷,きずつくか、あるいは奪,うばい去,さられても、それを見,みた者,ものがなければ、","tok":[["["],["10"],["]"],["もし"],["人","ひと"],["が"],["、"],["ろば"],["、"],["また"],["は"],["牛","うし"],["、"],["また"],["は"],["羊","ひつじ"],["、"],["また"],["は"],["どんな"],["家畜","かちく"],["で"],["も"],["、"],["それ"],["を"],["隣人","りんじん"],["に"],["預","あ"],["づけて"],["、"],["それ"],["が"],["死ぬ","しぬ"],["か"],["、"],["傷つく","きずつく"],["か"],["、"],["あるいは"],["奪い去られて","うばいさられて"],["も"],["、"],["それ"],["を"],["見た","みた"],["者","もの"],["が"],["なければ"],["、"]]},{"verse":10,"text":"[11]双方,そうほうの間,あいだに、隣人,りんじんの持,もち物,ものに手,てをかけなかったという誓,ちかいが、主,しゅの前,まえになされなければならない。そうすれば、持,もち主,ぬしはこれを受,うけ入,いれ、隣人,りんじんは償,つぐなうに及,およばない。","tok":[["["],["11"],["]"],["双方","そうほう"],["の"],["間","あいだ"],["に"],["、"],["隣人","りんじん"],["の"],["持物","もちもの"],["に"],["手","て"],["を"],["かけなかった"],["と"],["いう"],["誓い","ちかい"],["が"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["なされなければ"],["ならない"],["。"],["そう"],["すれば"],["、"],["持主","もちぬし"],["は"],["これ"],["を"],["受け入れ","うけいれ"],["、"],["隣人","りんじん"],["は"],["償なう","つぐなう"],["に"],["及ばない","およばない"],["。"]]},{"verse":11,"text":"[12]けれども、それがまさしく自分,じぶんの所,ところから盗,ぬすまれた時,ときは、その持,もち主,ぬしに償,つぐなわなければならない。","tok":[["["],["12"],["]"],["けれど"],["も"],["、"],["それ"],["が"],["まさしく"],["自分","じぶん"],["の"],["所","ところ"],["から"],["盗まれた","ぬすまれた"],["時","とき"],["は"],["、"],["その"],["持主","もちぬし"],["に"],["償なわなければ","つぐなわなければ"],["ならない"],["。"]]},{"verse":12,"text":"[13]もしそれが裂,さき殺,ころされた時,ときは、それを証拠,しょうことして持,もって来,くるならば、その裂,さき殺,ころされたものは償,つぐなうに及,およばない。","tok":[["["],["13"],["]"],["もし"],["それ"],["が"],["裂き","さき"],["殺された","ころされた"],["時","とき"],["は"],["、"],["それ"],["を"],["証拠","しょうこ"],["として"],["持って","もって"],["来るならば","くるならば"],["、"],["その"],["裂き","さき"],["殺された","ころされた"],["もの"],["は"],["償なう","つぐなう"],["に"],["及ばない","およばない"],["。"]]},{"verse":13,"text":"[14]もし人,ひとが隣人,りんじんから家畜,かちくを借,かりて、それが傷,きずつき、または死,しぬ場合,ばあい、その持,もち主,ぬしがそれと共,ともにいない時,ときは、必,かならずこれを償,つぐなわなければならない。","tok":[["["],["14"],["]"],["もし"],["人","ひと"],["が"],["隣人","りんじん"],["から"],["家畜","かちく"],["を"],["借","かり"],["て"],["、"],["それ"],["が"],["傷つき","きずつき"],["、"],["また"],["は"],["死ぬ","しぬ"],["場合","ばあい"],["、"],["その"],["持主","もちぬし"],["が"],["それ"],["と"],["共","とも"],["に"],["いない"],["時","とき"],["は"],["、"],["必","かならず"],["これ"],["を"],["償なわなければ","つぐなわなければ"],["ならない"],["。"]]},{"verse":14,"text":"[15]もしその持,もち主,ぬしがそれと共,ともにおれば、それを償,つぐなうに及,およばない。もしそれが賃借,ちんがりしたものならば、その借,か賃,ちんをそれに当,あてなければならない。","tok":[["["],["15"],["]"],["もし"],["その"],["持主","もちぬし"],["が"],["それ"],["と"],["共","とも"],["に"],["おれば"],["、"],["それ"],["を"],["償なう","つぐなう"],["に"],["及ばない","およばない"],["。"],["もし"],["それ"],["が"],["賃借り","ちんがり"],["した"],["もの"],["ならば"],["、"],["その"],["借","か"],["賃","ちん"],["を"],["それ"],["に"],["当てなければ","あてなければ"],["ならない"],["。"]]},{"verse":15,"text":"[16]もし人,ひとがまだ婚約,こんやくしない処女,しょじょを誘,さそって、これと寝,ねたならば、彼,かれは必,かならずこれに花嫁,はなよめ料,りょうを払,はらって、妻,つまとしなければならない。","tok":[["["],["16"],["]"],["もし"],["人","ひと"],["が"],["まだ"],["婚約","こんやく"],["しない"],["処女","しょじょ"],["を"],["誘って","さそって"],["、"],["これ"],["と"],["寝たならば","ねたならば"],["、"],["彼","かれ"],["は"],["必","かならず"],["これ"],["に"],["花嫁料","はなよめりょう"],["を"],["払って","はらって"],["、"],["妻","つま"],["と"],["しなければ"],["ならない"],["。"]]},{"verse":16,"text":"[17]もしその父,ちちがこれをその人,ひとに与,あたえることをかたく拒,こばむならば、彼,かれは処女,しょじょの花嫁,はなよめ料,りょうに当,あたるほどの金,かねを払,はらわなければならない。","tok":[["["],["17"],["]"],["もし"],["その"],["父","ちち"],["が"],["これ"],["を"],["その"],["人","ひと"],["に"],["与える","あたえる"],["こと"],["を"],["かたく"],["拒むならば","こばむならば"],["、"],["彼","かれ"],["は"],["処女","しょじょ"],["の"],["花嫁料","はなよめりょう"],["に"],["当たる","あたる"],["ほど"],["の"],["金","かね"],["を"],["払わなければ","はらわなければ"],["ならない"],["。"]]},{"verse":17,"text":"[18]魔法使,まほうつかいの女,おんなは、これを生,いかしておいてはならない。","tok":[["["],["18"],["]"],["魔法","まほう"],["使い","つかい"],["の"],["女","おんな"],["は"],["、"],["これ"],["を"],["生かして","いかして"],["おいて"],["は"],["ならない"],["。"]]},{"verse":18,"text":"[19]すべて獣,けものを犯,おかす者,ものは、必,かならず殺,ころされなければならない。","tok":[["["],["19"],["]"],["すべて"],["獣","けもの"],["を"],["犯す","おかす"],["者","もの"],["は"],["、"],["必","かならず"],["殺ろされなければ","ころされなければ"],["ならない"],["。"]]},{"verse":19,"text":"[20]主,しゅのほか、他,たの神々,かみがみに犠牲,ぎせいをささげる者,ものは、断,たち滅,ほろぼされなければならない。","tok":[["["],["20"],["]"],["主","しゅ"],["の"],["ほか"],["、"],["他","た"],["の"],["神々","かみがみ"],["に"],["犠牲","ぎせい"],["を"],["ささげる"],["者","もの"],["は"],["、"],["断ち","たち"],["滅ぼされなければ","ほろぼされなければ"],["ならない"],["。"]]},{"verse":20,"text":"[21]あなたは寄留,きりゅうの他国,たこく人,じんを苦,くるしめてはならない。また、これをしえたげてはならない。あなたがたも、かつてエジプトの国,くにで、寄留,きりゅうの他国,たこく人,じんであったからである。","tok":[["["],["21"],["]"],["あなた"],["は"],["寄留","きりゅう"],["の"],["他国人","たこくじん"],["を"],["苦しめて","くるしめて"],["は"],["ならない"],["。"],["また"],["、"],["これ"],["を"],["し"],["えたげて"],["は"],["ならない"],["。"],["あなた"],["がた"],["も"],["、"],["かつて"],["エジプト"],["の"],["国","くに"],["で"],["、"],["寄留","きりゅう"],["の"],["他国人","たこくじん"],["で"],["あった"],["から"],["で"],["ある"],["。"]]},{"verse":21,"text":"[22]あなたがたはすべて寡婦,かふ、または孤児,こじを悩,なやましてはならない。","tok":[["["],["22"],["]"],["あなた"],["がた"],["は"],["すべて"],["寡婦","かふ"],["、"],["また"],["は"],["孤児","こじ"],["を"],["悩して","なやまして"],["は"],["ならない"],["。"]]},{"verse":22,"text":"[23]もしあなたが彼,かれらを悩,なやまして、彼,かれらがわたしにむかって叫,さけぶならば、わたしは必,かならずその叫,さけびを聞,きくであろう。","tok":[["["],["23"],["]"],["もし"],["あなた"],["が"],["彼","かれ"],["ら"],["を"],["悩して","なやまして"],["、"],["彼","かれ"],["ら"],["が"],["わたし"],["に"],["むかって"],["叫けぶならば","さけぶならば"],["、"],["わたし"],["は"],["必","かならず"],["その"],["叫","さけび"],["を"],["聞くで","きくで"],["あろう"],["。"]]},{"verse":23,"text":"[24]そしてわたしの怒,いかりは燃,もえたち、つるぎをもってあなたがたを殺,ころすであろう。あなたがたの妻,つまは寡婦,かふとなり、あなたがたの子供,こどもたちは孤児,こじとなるであろう。","tok":[["["],["24"],["]"],["そして"],["わたし"],["の"],["怒り","いかり"],["は"],["燃えたち","もえたち"],["、"],["つるぎ"],["を"],["もって"],["あなた"],["がた"],["を"],["殺ろすで","ころすで"],["あろう"],["。"],["あなた"],["がた"],["の"],["妻","つま"],["は"],["寡婦","かふ"],["と"],["なり"],["、"],["あなた"],["がた"],["の"],["子供","こども"],["たち"],["は"],["孤児","こじ"],["と"],["なるで"],["あろう"],["。"]]},{"verse":24,"text":"[25]あなたが、共,ともにおるわたしの民,たみの貧,まずしい者,ものに金,かねを貸,かす時,ときは、これに対,たいして金貸,かねかしのようになってはならない。これから利子,りしを取,とってはならない。","tok":[["["],["25"],["]"],["あなた"],["が"],["、"],["共","とも"],["に"],["おる"],["わたし"],["の"],["民","たみ"],["の"],["貧しい","まずしい"],["者","もの"],["に"],["金","かね"],["を"],["貸す","かす"],["時","とき"],["は"],["、"],["これ"],["に対して","にたいして"],["金貸","かねかし"],["の"],["よう"],["に"],["なって"],["は"],["ならない"],["。"],["これ"],["から"],["利子","りし"],["を"],["取って","とって"],["は"],["ならない"],["。"]]},{"verse":25,"text":"[26]もし隣人,りんじんの上着,うわぎを質,しつに取,とるならば、日,ひの入,いるまでにそれを返,かえさなければならない。","tok":[["["],["26"],["]"],["もし"],["隣人","りんじん"],["の"],["上着","うわぎ"],["を"],["質","しつ"],["に"],["取るならば","とるならば"],["、"],["日","ひ"],["の"],["入","いる"],["まで"],["に"],["それ"],["を"],["返えさなければ","かえさなければ"],["ならない"],["。"]]},{"verse":26,"text":"[27]これは彼,かれの身,みをおおう、ただ一つの物,もの、彼,かれの膚,はだのための着物,きものだからである。彼,かれは何,なにを着,きて寝,ねることができよう。彼,かれがわたしにむかって叫,さけぶならば、わたしはこれに聞,きくであろう。わたしはあわれみ深,ふかいからである。","tok":[["["],["27"],["]"],["これ"],["は"],["彼","かれ"],["の"],["身","み"],["を"],["おおう"],["、"],["ただ"],["一","ひと"],["つ"],["の"],["物","もの"],["、"],["彼","かれ"],["の"],["膚","はだ"],["の"],["ため"],["の"],["着物","きもの"],["だ"],["から"],["で"],["ある"],["。"],["彼","かれ"],["は"],["何に","なに"],["を"],["着て","きて"],["寝る","ねる"],["こと"],["が"],["できよう"],["。"],["彼","かれ"],["が"],["わたし"],["に"],["むかって"],["叫けぶならば","さけぶならば"],["、"],["わたし"],["は"],["これ"],["に"],["聞くで","きくで"],["あろう"],["。"],["わたし"],["は"],["あわれみ"],["深","ふかいか"],["ら"],["で"],["ある"],["。"]]},{"verse":27,"text":"[28]あなたは神,かみをののしってはならない。また民,たみの司,つかさをのろってはならない。","tok":[["["],["28"],["]"],["あなた"],["は"],["神","かみ"],["を"],["ののしって"],["は"],["ならない"],["。"],["また"],["民","たみ"],["の"],["司","つかさ"],["を"],["のろって"],["は"],["ならない"],["。"]]},{"verse":28,"text":"[29]あなたの豊,ゆたかな穀物,こくもつと、あふれる酒,さけとをささげるに、ためらってはならない。あなたのういごを、わたしにささげなければならない。","tok":[["["],["29"],["]"],["あなた"],["の"],["豊","ゆたか"],["な"],["穀物","こくもつ"],["と"],["、"],["あふれる"],["酒","さけ"],["と"],["を"],["ささげる"],["に"],["、"],["ためらって"],["は"],["ならない"],["。"],["あなた"],["の"],["うい"],["ご"],["を"],["、"],["わたし"],["に"],["ささげなければ"],["ならない"],["。"]]},{"verse":29,"text":"[30]あなたはまた、あなたの牛,うしと羊,ひつじをも同様,どうようにしなければならない。七日,なぬかの間,あいだその母,ははと共,ともに置,おいて、八日,か目,めにそれをわたしに、ささげなければならない。","tok":[["["],["30"],["]"],["あなた"],["は"],["また"],["、"],["あなた"],["の"],["牛","うし"],["と"],["羊","ひつじ"],["を"],["も"],["同様","どうよう"],["に"],["しなければ"],["ならない"],["。"],["七日","なぬか"],["の"],["間","あいだ"],["その"],["母","はは"],["と"],["共","とも"],["に"],["置いて","おいて"],["、"],["八日目","かめ"],["に"],["それ"],["を"],["わたし"],["に"],["、"],["ささげなければ"],["ならない"],["。"]]},{"verse":30,"text":"[31]あなたがたは、わたしに対,たいして聖,せいなる民,たみとならなければならない。あなたがたは、野,ので裂,さき殺,ころされたものの肉,にくを食,たべてはならない。それは犬,いぬに投,なげ与,あたえなければならない。","tok":[["["],["31"],["]"],["あなた"],["がた"],["は"],["、"],["わたし"],["に対して","にたいして"],["聖","せい"],["なる"],["民","たみ"],["と"],["ならなければ"],["ならない"],["。"],["あなた"],["がた"],["は"],["、"],["野","の"],["で"],["裂き","さき"],["殺された","ころされた"],["もの"],["の"],["肉","にく"],["を"],["食べて","たべて"],["は"],["ならない"],["。"],["それ"],["は"],["犬","いぬ"],["に"],["投与","なげあた"],["えなければ"],["ならない"],["。"]]}]
[{"verse":1,"text":"その後,のち、モーセとアロンは行,いってパロに言,いった、「イスラエルの神,かみ、主,しゅはこう言,いわれる、『わたしの民,たみを去,さらせ、荒野,あらので、わたしのために祭,まつりをさせなさい』と」。","tok":[["その後","そのの"],["ち"],["、"],["モーセ"],["と"],["アロン"],["は"],["行って","いって"],["パロ"],["に"],["言った","いった"],["、"],["「"],["イスラエル"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["『"],["わたし"],["の"],["民","たみ"],["を"],["去らせ","さらせ"],["、"],["荒野","あらの"],["で"],["、"],["わたし"],["の"],["ため"],["に"],["祭","まつり"],["を"],["させ"],["なさい"],["』"],["と"],["」"],["。"]]},{"verse":2,"text":"パロは言,いった、「主,しゅとはいったい何者,なにものか。わたしがその声,こえに聞,きき従,したがってイスラエルを去,さらせなければならないのか。わたしは主,しゅを知,しらない。またイスラエルを去,さらせはしない」。","tok":[["パロ"],["は"],["言った","いった"],["、"],["「"],["主","しゅ"],["と"],["は"],["いったい"],["何者","なにもの"],["か"],["。"],["わたし"],["が"],["その"],["声","こえ"],["に"],["聞","きき"],["従って","したがって"],["イスラエル"],["を"],["去らせなければ","さらせなければ"],["ならない"],["の"],["か"],["。"],["わたし"],["は"],["主","しゅ"],["を"],["知らない","しらない"],["。"],["また"],["イスラエル"],["を"],["去らせ","さらせ"],["は"],["しない"],["」"],["。"]]},{"verse":3,"text":"彼,かれらは言,いった、「ヘブルびとの神,かみがわたしたちに現,あらわれました。どうか、わたしたちを三日,かの道,みちのりほど荒野,あらのに行,いかせ、わたしたちの神,かみ、主,しゅに犠牲,ぎせいをささげさせてください。そうしなければ主,しゅは疫病,えきびょうか、つるぎをもって、わたしたちを悩,なやまされるからです」。","tok":[["彼","かれ"],["ら"],["は"],["言った","いった"],["、"],["「"],["ヘブル"],["びと"],["の"],["神","かみ"],["が"],["わたしたち"],["に"],["現われました","あらわれました"],["。"],["どう"],["か"],["、"],["わたしたち"],["を"],["三日","か"],["の"],["道のり","みちのり"],["ほど"],["荒野","あら"],["のに"],["行かせ","いかせ"],["、"],["わたしたち"],["の"],["神","かみ"],["、"],["主に","しゅに"],["犠牲","ぎせい"],["を"],["ささげさせて"],["ください"],["。"],["そう"],["しなければ"],["主","しゅ"],["は"],["疫病","え"],["き"],["びょう"],["か"],["、"],["つるぎ"],["を"],["もって"],["、"],["わたしたち"],["を"],["悩される","なやまされる"],["から"],["です"],["」"],["。"]]},{"verse":4,"text":"エジプトの王,おうは彼,かれらに言,いった、「モーセとアロンよ、あなたがたは、なぜ民,たみに働,はたらきをやめさせようとするのか。自分,じぶんの労役,ろうえきにつくがよい」。","tok":[["エジプト"],["の"],["王","おう"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["モーセ"],["と"],["アロン"],["よ"],["、"],["あなた"],["がた"],["は"],["、"],["なぜ"],["民","たみ"],["に"],["働らき","はたらき"],["を"],["やめさせよう"],["と"],["する"],["の"],["か"],["。"],["自分","じぶん"],["の"],["労役","ろうえき"],["に"],["つく"],["が"],["よい"],["」"],["。"]]},{"verse":5,"text":"パロはまた言,いった、「見,みよ、今,いまや土民,どみんの数,かずは多,おおい。しかも、あなたがたは彼,かれらに労役,ろうえきを休,やすませようとするのか」。","tok":[["パロ"],["は"],["また"],["言った","いった"],["、"],["「"],["見よ","みよ"],["、"],["今","いま"],["や"],["土民","どみん"],["の"],["数","かず"],["は"],["多い","おおい"],["。"],["しかも"],["、"],["あなた"],["がた"],["は"],["彼","かれ"],["ら"],["に"],["労役","ろうえき"],["を"],["休ませよう","やすませよう"],["と"],["する"],["の"],["か"],["」"],["。"]]},{"verse":6,"text":"その日,ひ、パロは民,たみを追,おい使,つかう者,ものと、民,たみのかしらたちに命,めいじて言,いった、","tok":[["その"],["日","ひ"],["、"],["パロ"],["は"],["民","たみ"],["を"],["追い使う","おいつかう"],["者","もの"],["と"],["、"],["民","たみ"],["の"],["かしら"],["たち"],["に"],["命じて","めいじて"],["言った","いった"],["、"]]},{"verse":7,"text":"「あなたがたは、れんがを作,つくるためのわらを、もはや、今,いままでのように、この民,たみに与,あたえてはならない。彼,かれらに自分,じぶんで行,いって、わらを集,あつめさせなさい。","tok":[["「"],["あなた"],["がた"],["は"],["、"],["れんが"],["を"],["作る","つくる"],["ため"],["の"],["わら"],["を"],["、"],["もはや"],["、"],["今まで","いままで"],["の"],["よう"],["に"],["、"],["この"],["民","たみ"],["に"],["与","あたえ"],["ては"],["ならない"],["。"],["彼","かれ"],["ら"],["に"],["自分","じぶん"],["で"],["行って","いって"],["、"],["わら"],["を"],["集めさせ","あつめさせ"],["なさい"],["。"]]},{"verse":8,"text":"また前,まえに作,つくっていた、れんがの数,かずどおりに彼,かれらに作,つくらせ、それを減,へらしてはならない。彼,かれらはなまけ者,ものだ。それだから、彼,かれらは叫,さけんで、『行,いってわたしたちの神,かみに犠牲,ぎせいをささげさせよ』と言,いうのだ。","tok":[["また"],["前","まえ"],["に"],["作って","つくって"],["いた"],["、"],["れんが"],["の"],["数","かず"],["どおり"],["に"],["彼","かれ"],["ら"],["に"],["作らせ","つくらせ"],["、"],["それ"],["を"],["減らして","へらして"],["は"],["ならない"],["。"],["彼","かれ"],["ら"],["は"],["なまけ者","なまけもの"],["だ"],["。"],["それ"],["だ"],["から"],["、"],["彼","かれ"],["ら"],["は"],["叫けんで","さけんで"],["、"],["『"],["行って","いって"],["わたしたち"],["の"],["神","かみ"],["に"],["犠牲","ぎせい"],["を"],["ささげさせよ"],["』"],["と"],["言う","いう"],["の"],["だ"],["。"]]},{"verse":9,"text":"この人々,ひとびとの労役,ろうえきを重,おもくして、働,はたらかせ、偽,いつわりの言葉,ことばに心,こころを寄,よせさせぬようにしなさい」。","tok":[["この"],["人々","ひとびと"],["の"],["労役","ろうえき"],["を"],["重く","おもく"],["して"],["、"],["働かせ","はたらかせ"],["、"],["偽わり","いつわり"],["の"],["言葉","ことば"],["に"],["心","こころ"],["を"],["寄せさせぬ","よせさせぬ"],["よう"],["に"],["し"],["なさい"],["」"],["。"]]},{"verse":10,"text":"そこで民,たみを追,おい使,つかう者,ものたちと、民,たみのかしらたちは出,でて行,いって、民,たみに言,いった、「パロはこう仰,おおせられる、『あなたがたに、わらは与,あたえない。","tok":[["そこ"],["で"],["民","たみ"],["を"],["追い使う","おいつかう"],["者","もの"],["たち"],["と"],["、"],["民","たみ"],["の"],["かしら"],["たち"],["は"],["出て","でて"],["行って","いって"],["、"],["民","たみ"],["に"],["言った","いった"],["、"],["「"],["パロ"],["は"],["こう"],["仰せられる","おおせられる"],["、"],["『"],["あなた"],["がた"],["に"],["、"],["わら"],["は"],["与えない","あたえない"],["。"]]},{"verse":11,"text":"自分,じぶんで行,いって、見,みつかる所,ところから、わらを取,とって来,くるがよい。しかし働,はたらきは少,すこしも減,へらしてはならない』と」。","tok":[["自分","じぶん"],["で"],["行って","いって"],["、"],["見つかる","みつかる"],["所","ところ"],["から"],["、"],["わら"],["を"],["取って","とって"],["来る","くる"],["が"],["よい"],["。"],["しかし"],["働らき","はたらき"],["は"],["少し","すこし"],["も"],["減らして","へらして"],["は"],["ならない"],["』"],["と"],["」"],["。"]]},{"verse":12,"text":"そこで民,たみはエジプトの全,ぜん地,ちに散,ちって、わらのかわりに、刈,かり株,かぶを集,あつめた。","tok":[["そこ"],["で"],["民","たみ"],["は"],["エジプト"],["の"],["全地","ぜんち"],["に"],["散って","ちって"],["、"],["わら"],["の"],["かわり"],["に"],["、"],["刈株","かりかぶ"],["を"],["集めた","あつめた"],["。"]]},{"verse":13,"text":"追,おい使,つかう者,ものたちは、彼,かれらをせき立,たてて言,いった、「わらがあった時,ときと同,おなじように、あなたがたの働,はたらきの、日,ひごとの分,ぶんを仕上,しあげなければならない」。","tok":[["追い使う","おいつかう"],["者","もの"],["たち"],["は"],["、"],["彼","かれ"],["ら"],["を"],["せき立てて","せきたてて"],["言った","いった"],["、"],["「"],["わら"],["が"],["あった"],["時","とき"],["と"],["同じ","おなじ"],["よう"],["に"],["、"],["あなた"],["がた"],["の"],["働らき","はたらき"],["の"],["、"],["日ごと","ひごと"],["の"],["分","ぶん"],["を"],["仕上","しあげ"],["なければ"],["ならない"],["」"],["。"]]},{"verse":14,"text":"パロの追,おい使,つかう者,ものたちがイスラエルの人々,ひとびとの上,うえに立,たてたかしらたちは、打,うたれて、「なぜ、あなたがたは、れんが作,つくりの仕事,しごとを、きょうも、前,まえのように仕上,しあげないのか」と言,いわれた。","tok":[["パロ"],["の"],["追い使う","おいつかう"],["者","もの"],["たち"],["が"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["上","うえ"],["に"],["立てた","たてた"],["かしら"],["たち"],["は"],["、"],["打たれて","うたれて"],["、"],["「"],["なぜ"],["、"],["あなた"],["がた"],["は"],["、"],["れんが"],["作り","つくり"],["の"],["仕事","しごと"],["を"],["、"],["きょう"],["も"],["、"],["前","まえ"],["の"],["よう"],["に"],["仕上","しあげ"],["ない"],["の"],["か"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":15,"text":"そこで、イスラエルの人々,ひとびとのかしらたちはパロのところに行,いき、叫,さけんで言,いった、「あなたはなぜ、しもべどもにこんなことをなさるのですか。","tok":[["そこ"],["で"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["かしら"],["たち"],["は"],["パロ"],["の"],["ところ"],["に"],["行き","いき"],["、"],["叫けんで","さけんで"],["言った","いった"],["、"],["「"],["あなた"],["は"],["なぜ"],["、"],["しもべ"],["ども"],["に"],["こんな"],["こと"],["を"],["なさる"],["の"],["です"],["か"],["。"]]},{"verse":16,"text":"しもべどもは、わらを与,あたえられず、しかも彼,かれらはわたしたちに、『れんがは作,つくれ』と言,いうのです。その上,うえ、しもべどもは打,うたれています。罪,つみはあなたの民,たみにあるのです」。","tok":[["しもべ"],["ども"],["は"],["、"],["わら"],["を"],["与えられず","あたえられず"],["、"],["しかも"],["彼","かれ"],["ら"],["は"],["わたしたち"],["に"],["、"],["『"],["れんが"],["は"],["作れ","つくれ"],["』"],["と"],["言う","いう"],["の"],["です"],["。"],["その"],["上","うえ"],["、"],["しもべ"],["ども"],["は"],["打たれて","うたれて"],["います"],["。"],["罪","つみ"],["は"],["あなた"],["の"],["民","たみ"],["に"],["ある"],["の"],["です"],["」"],["。"]]},{"verse":17,"text":"パロは言,いった、「あなたがたは、なまけ者,ものだ、なまけ者,ものだ。それだから、『行,いって、主,しゅに犠牲,ぎせいをささげさせよ』と言,いうのだ。","tok":[["パロ"],["は"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["、"],["なまけ者","なまけもの"],["だ"],["、"],["なまけ者","なまけもの"],["だ"],["。"],["それ"],["だ"],["から"],["、"],["『"],["行って","いって"],["、"],["主に","しゅに"],["犠牲","ぎせい"],["を"],["ささげさせよ"],["』"],["と"],["言う","いう"],["の"],["だ"],["。"]]},{"verse":18,"text":"さあ、行,いって働,はたらきなさい。わらは与,あたえないが、なおあなたがたは定,さだめた数,かずのれんがを納,おさめなければならない」。","tok":[["さあ"],["、"],["行って","いって"],["働らき","はたらき"],["なさい"],["。"],["わら"],["は"],["与えない","あたえない"],["が"],["、"],["なお"],["あなた"],["がた"],["は"],["定めた","さだめた"],["数","かず"],["の"],["れんが"],["を"],["納","おさめ"],["なければ"],["ならない"],["」"],["。"]]},{"verse":19,"text":"イスラエルの人々,ひとびとのかしらたちは、「れんがの日,ひごとの分,ぶんを減,へらしてはならない」と言,いわれたので、悪,わるい事態,じたいになったことを知,しった。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["の"],["かしら"],["たち"],["は"],["、"],["「"],["れんが"],["の"],["日ごと","ひごと"],["の"],["分","ぶん"],["を"],["減らして","へらして"],["は"],["ならない"],["」"],["と"],["言われた","いわれた"],["ので"],["、"],["悪い","わるい"],["事態","じたい"],["に"],["なった"],["こと"],["を"],["知った","しった"],["。"]]},{"verse":20,"text":"彼,かれらがパロを離,はなれて出,でてきた時,とき、彼,かれらに会,あおうとして立,たっていたモーセとアロンに会,あったので、","tok":[["彼","かれ"],["ら"],["が"],["パロ"],["を"],["離れて","はなれて"],["出て","でて"],["きた"],["時","とき"],["、"],["彼","かれ"],["ら"],["に"],["会おう","あおう"],["として"],["立って","たって"],["いた"],["モーセ"],["と"],["アロン"],["に"],["会った","あった"],["ので"],["、"]]},{"verse":21,"text":"彼,かれらに言,いった、「主,しゅがあなたがたをごらんになって、さばかれますように。あなたがたは、わたしたちをパロとその家来,けらいたちにきらわせ、つるぎを彼,かれらの手,てに渡,わたして、殺,ころさせようとしておられるのです」。","tok":[["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["主","しゅ"],["が"],["あなた"],["がた"],["を"],["ごらん"],["に"],["なって"],["、"],["さばかれます"],["よう"],["に"],["。"],["あなた"],["がた"],["は"],["、"],["わたしたち"],["を"],["パロ"],["と"],["その"],["家来","けらい"],["たち"],["に"],["きらわせ"],["、"],["つるぎ"],["を"],["彼","かれ"],["ら"],["の"],["手","て"],["に"],["渡","わたし"],["て"],["、"],["殺させよう","ころさせよう"],["として"],["おられる"],["の"],["です"],["」"],["。"]]},{"verse":22,"text":"モーセは主,しゅのもとに帰,かえって言,いった、「主,しゅよ、あなたは、なぜこの民,たみをひどい目,めにあわされるのですか。なんのためにわたしをつかわされたのですか。","tok":[["モーセ"],["は"],["主","しゅ"],["の"],["もと"],["に"],["帰えって","かえって"],["言った","いった"],["、"],["「"],["主","しゅ"],["よ"],["、"],["あなた"],["は"],["、"],["なぜ"],["この"],["民","たみ"],["を"],["ひどい"],["目","め"],["に"],["あわされる"],["の"],["です"],["か"],["。"],["なん"],["の"],["ため"],["に"],["わたし"],["を"],["つかわされた"],["の"],["です"],["か"],["。"]]},{"verse":23,"text":"わたしがパロのもとに行,いって、あなたの名,なによって語,かたってからこのかた、彼,かれはこの民,たみをひどい目,めにあわせるばかりです。また、あなたは、すこしもあなたの民,たみを救,すくおうとなさいません」。","tok":[["わたし"],["が"],["パロ"],["の"],["もと"],["に"],["行って","いって"],["、"],["あなた"],["の"],["名","な"],["によって"],["語って","かたって"],["から"],["このかた"],["、"],["彼","かれ"],["は"],["この"],["民","たみ"],["を"],["ひどい"],["目","め"],["に"],["あわせる"],["ばかり"],["です"],["。"],["また"],["、"],["あなた"],["は"],["、"],["すこし"],["も"],["あなた"],["の"],["民","たみ"],["を"],["救おう","すくおう"],["と"],["なさいません"],["」"],["。"]]}]
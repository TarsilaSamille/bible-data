[{"verse":1,"text":"神,かみはこのすべての言葉,ことばを語,かたって言,いわれた。","tok":[["神","かみ"],["は"],["この"],["すべて"],["の"],["言葉","ことば"],["を"],["語って","かたって"],["言われた","いわれた"],["。"]]},{"verse":2,"text":"「わたしはあなたの神,かみ、主,しゅであって、あなたをエジプトの地,ち、奴隷,どれいの家,いえから導,みちびき出,だした者,ものである。","tok":[["「"],["わたし"],["は"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["で"],["あって"],["、"],["あなた"],["を"],["エジプト"],["の"],["地","ち"],["、"],["奴隷","どれい"],["の"],["家","いえ"],["から"],["導き出した","みちびきだした"],["者","もの"],["で"],["ある"],["。"]]},{"verse":3,"text":"あなたはわたしのほかに、なにものをも神,かみとしてはならない。","tok":[["あなた"],["は"],["わたし"],["の"],["ほか"],["に"],["、"],["なにもの"],["を"],["も"],["神","かみ"],["として"],["は"],["ならない"],["。"]]},{"verse":4,"text":"あなたは自分,じぶんのために、刻,きざんだ像,ぞうを造,つくってはならない。上,うえは天,てんにあるもの、下,したは地,ちにあるもの、また地,ちの下,したの水,みずのなかにあるものの、どんな形,かたちをも造,つくってはならない。","tok":[["あなた"],["は"],["自分","じぶん"],["の"],["ため"],["に"],["、"],["刻","き"],["ざ"],["ん"],["だ"],["像","ぞう"],["を"],["造って","つくって"],["は"],["ならない"],["。"],["上","うえ"],["は"],["天","てん"],["に"],["ある"],["もの"],["、"],["下","した"],["は"],["地","ち"],["に"],["ある"],["もの"],["、"],["また"],["地","ち"],["の"],["下","した"],["の"],["水","みず"],["の"],["なか"],["に"],["ある"],["もの"],["の"],["、"],["どんな"],["形","かたち"],["を"],["も"],["造って","つくって"],["は"],["ならない"],["。"]]},{"verse":5,"text":"それにひれ伏,ふしてはならない。それに仕,つかえてはならない。あなたの神,かみ、主,しゅであるわたしは、ねたむ神,かみであるから、わたしを憎,にくむものは、父,ちちの罪,つみを子,こに報,むくいて、三四代,だいに及,およぼし、","tok":[["それ"],["に"],["ひれ伏して","ひれふして"],["は"],["ならない"],["。"],["それ"],["に"],["仕えて","つかえて"],["は"],["ならない"],["。"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["で"],["ある"],["わたし"],["は"],["、"],["ねたむ"],["神","かみ"],["で"],["ある"],["から"],["、"],["わたし"],["を"],["憎む","にくむ"],["もの"],["は"],["、"],["父","ちち"],["の"],["罪","つみ"],["を"],["子","こ"],["に"],["報いて","むくいて"],["、"],["三四","さんし"],["代","だい"],["に"],["及ぼし","およぼし"],["、"]]},{"verse":6,"text":"わたしを愛,あいし、わたしの戒,いましめを守,まもるものには、恵,めぐみを施,ほどこして、千代,だいに至,いたるであろう。","tok":[["わたし"],["を"],["愛し","あいし"],["、"],["わたし"],["の"],["戒しめ","いましめ"],["を"],["守る","まもる"],["もの"],["に"],["は"],["、"],["恵","めぐみ"],["を"],["施して","ほどこして"],["、"],["千代","だい"],["に"],["至るで","いたるで"],["あろう"],["。"]]},{"verse":7,"text":"あなたは、あなたの神,かみ、主,しゅの名,なを、みだりに唱,となえてはならない。主,しゅは、み名,なをみだりに唱,となえるものを、罰,ばっしないでは置,おかないであろう。","tok":[["あなた"],["は"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["名","な"],["を"],["、"],["みだり"],["に"],["唱えて","となえて"],["は"],["ならない"],["。"],["主","しゅ"],["は"],["、"],["み名","みな"],["を"],["みだり"],["に"],["唱える","となえる"],["もの"],["を"],["、"],["罰しないで","ばっしないで"],["は"],["置かないで","おかないで"],["あろう"],["。"]]},{"verse":8,"text":"安息日,あんそくにちを覚,おぼえて、これを聖,せいとせよ。","tok":[["安息日","あんそくにち"],["を"],["覚えて","おぼえて"],["、"],["これ"],["を"],["聖","せい"],["と"],["せよ"],["。"]]},{"verse":9,"text":"六日,かのあいだ働,はたらいてあなたのすべてのわざをせよ。","tok":[["六日","か"],["の"],["あいだ"],["働いて","はたらいて"],["あなた"],["の"],["すべて"],["の"],["わざ"],["を"],["せよ"],["。"]]},{"verse":10,"text":"七日,なぬか目,めはあなたの神,かみ、主,しゅの安息,あんそくであるから、なんのわざをもしてはならない。あなたもあなたのむすこ、娘,むすめ、しもべ、はしため、家畜,かちく、またあなたの門,もんのうちにいる他国,たこくの人,ひともそうである。","tok":[["七日","な"],["ぬか目","ぬかめ"],["は"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["安息","あんそく"],["で"],["ある"],["から"],["、"],["なん"],["の"],["わざ"],["を"],["も"],["して"],["は"],["ならない"],["。"],["あなた"],["も"],["あなた"],["の"],["むすこ"],["、"],["娘","むすめ"],["、"],["しもべ"],["、"],["はし"],["ため"],["、"],["家畜","かちく"],["、"],["また"],["あなた"],["の"],["門","もん"],["の"],["うち"],["に"],["いる"],["他国","たこく"],["の"],["人","ひと"],["も"],["そう"],["で"],["ある"],["。"]]},{"verse":11,"text":"主,しゅは六日,かのうちに、天,てんと地,ちと海,うみと、その中,なかのすべてのものを造,つくって、七日,なぬか目,めに休,やすまれたからである。それで主,しゅは安息日,あんそくにちを祝福,しゅくふくして聖,せいとされた。","tok":[["主","しゅ"],["は"],["六日","か"],["の"],["うち"],["に"],["、"],["天","てん"],["と"],["地","ち"],["と"],["海","うみ"],["と"],["、"],["その"],["中","なか"],["の"],["すべて"],["の"],["もの"],["を"],["造って","つくって"],["、"],["七日","な"],["ぬか目","ぬかめ"],["に"],["休まれた","やすまれた"],["から"],["で"],["ある"],["。"],["それ"],["で"],["主","しゅ"],["は"],["安息日","あんそくにち"],["を"],["祝福","しゅくふく"],["して"],["聖","せい"],["と"],["された"],["。"]]},{"verse":12,"text":"あなたの父,ちちと母,ははを敬,うやまえ。これは、あなたの神,かみ、主,しゅが賜,たまわる地,ちで、あなたが長,ながく生,いきるためである。","tok":[["あなた"],["の"],["父","ちち"],["と"],["母","はは"],["を"],["敬え","うやまえ"],["。"],["これ"],["は"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["賜わる","たまわる"],["地","ち"],["で"],["、"],["あなた"],["が"],["長く","ながく"],["生きる","いきる"],["ため"],["で"],["ある"],["。"]]},{"verse":13,"text":"あなたは殺,ころしてはならない。","tok":[["あなた"],["は"],["殺ろし","ころし"],["ては"],["ならない"],["。"]]},{"verse":14,"text":"あなたは姦淫,かんいんしてはならない。","tok":[["あなた"],["は"],["姦淫","かんいん"],["して"],["は"],["ならない"],["。"]]},{"verse":15,"text":"あなたは盗,ぬすんではならない。","tok":[["あなた"],["は"],["盗","ぬすん"],["で"],["は"],["ならない"],["。"]]},{"verse":16,"text":"あなたは隣人,りんじんについて、偽証,ぎしょうしてはならない。","tok":[["あなた"],["は"],["隣人","りんじん"],["について"],["、"],["偽証","ぎしょう"],["して"],["は"],["ならない"],["。"]]},{"verse":17,"text":"あなたは隣人,りんじんの家,いえをむさぼってはならない。隣人,りんじんの妻,つま、しもべ、はしため、牛,うし、ろば、またすべて隣人,りんじんのものをむさぼってはならない」。","tok":[["あなた"],["は"],["隣人","りんじん"],["の"],["家","いえ"],["を"],["むさぼって"],["は"],["ならない"],["。"],["隣人","りんじん"],["の"],["妻","つま"],["、"],["しもべ"],["、"],["はし"],["ため"],["、"],["牛","うし"],["、"],["ろば"],["、"],["また"],["すべて"],["隣人","りんじん"],["の"],["もの"],["を"],["むさぼって"],["は"],["ならない"],["」"],["。"]]},{"verse":18,"text":"民,たみは皆,みな、かみなりと、いなずまと、ラッパの音,おとと、山,やまの煙,けむっているのとを見,みた。民,たみは恐,おそれおののき、遠,とおく離,はなれて立,たった。","tok":[["民","たみ"],["は"],["皆","みな"],["、"],["かみなり"],["と"],["、"],["いなずま"],["と"],["、"],["ラッパ"],["の"],["音","おと"],["と"],["、"],["山","やま"],["の"],["煙って","けむって"],["いる"],["の"],["と"],["を"],["見た","みた"],["。"],["民","たみ"],["は"],["恐れおののき","おそれおののき"],["、"],["遠く","とおく"],["離れて","はなれて"],["立った","たった"],["。"]]},{"verse":19,"text":"彼,かれらはモーセに言,いった、「あなたがわたしたちに語,かたってください。わたしたちは聞,きき従,したがいます。神,かみがわたしたちに語,かたられぬようにしてください。それでなければ、わたしたちは死,しぬでしょう」。","tok":[["彼","かれ"],["ら"],["は"],["モーセ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["が"],["わたしたち"],["に"],["語って","かたって"],["ください"],["。"],["わたしたち"],["は"],["聞","きき"],["従います","したがいます"],["。"],["神","かみ"],["が"],["わたしたち"],["に"],["語られぬ","かたられぬ"],["よう"],["に"],["して"],["ください"],["。"],["それ"],["で"],["なければ"],["、"],["わたしたち"],["は"],["死ぬでしょう","しぬでしょう"],["」"],["。"]]},{"verse":20,"text":"モーセは民,たみに言,いった、「恐,おそれてはならない。神,かみはあなたがたを試,こころみるため、またその恐,おそれをあなたがたの目,めの前,まえにおいて、あなたがたが罪,つみを犯,おかさないようにするために臨,のぞまれたのである」。","tok":[["モーセ"],["は"],["民","たみ"],["に"],["言った","いった"],["、"],["「"],["恐れて","おそれて"],["は"],["ならない"],["。"],["神","かみ"],["は"],["あなた"],["がた"],["を"],["試みる","こころみる"],["ため"],["、"],["また"],["その"],["恐","おそれ"],["を"],["あなた"],["がた"],["の"],["目","め"],["の"],["前","まえ"],["に"],["おいて"],["、"],["あなた"],["がた"],["が"],["罪","つみ"],["を"],["犯さない","おかさない"],["よう"],["に"],["する"],["ため"],["に"],["臨まれた","のぞまれた"],["ので"],["ある"],["」"],["。"]]},{"verse":21,"text":"そこで、民,たみは遠,とおく離,はなれて立,たったが、モーセは神,かみのおられる濃,こい雲,くもに近,ちかづいて行,いった。","tok":[["そこ"],["で"],["、"],["民","たみ"],["は"],["遠く","とおく"],["離れて","はなれて"],["立った","たった"],["が"],["、"],["モーセ"],["は"],["神","かみ"],["の"],["おられる"],["濃い","こい"],["雲","くも"],["に"],["近づいて","ちかづいて"],["行った","いった"],["。"]]},{"verse":22,"text":"主,しゅはモーセに言,いわれた、「あなたはイスラエルの人々,ひとびとにこう言,いいなさい、『あなたがたは、わたしが天,てんからあなたがたと語,かたるのを見,みた。","tok":[["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["こう"],["言い","いい"],["なさい"],["、"],["『"],["あなた"],["がた"],["は"],["、"],["わたし"],["が"],["天","てん"],["から"],["あなた"],["がた"],["と"],["語る","かたる"],["の"],["を"],["見た","みた"],["。"]]},{"verse":23,"text":"あなたがたはわたしと並,ならべて、何,なにをも造,つくってはならない。銀,ぎんの神々,かみがみも、金,きんの神々,かみがみも、あなたがたのために、造,つくってはならない。","tok":[["あなた"],["がた"],["は"],["わたし"],["と"],["並べて","ならべて"],["、"],["何に","なに"],["を"],["も"],["造って","つくって"],["は"],["ならない"],["。"],["銀","ぎん"],["の"],["神々","かみがみ"],["も"],["、"],["金","きん"],["の"],["神々","かみがみ"],["も"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["、"],["造って","つくって"],["は"],["ならない"],["。"]]},{"verse":24,"text":"あなたはわたしのために土,つちの祭壇,さいだんを築,きずき、その上,うえにあなたの燔祭,はんさい、酬恩祭,しゅうおんさい、羊,ひつじ、牛,うしをささげなければならない。わたしの名,なを覚,おぼえさせるすべての所,ところで、わたしはあなたに臨,のぞんで、あなたを祝福,しゅくふくするであろう。","tok":[["あなた"],["は"],["わたし"],["の"],["ため"],["に"],["土","つち"],["の"],["祭壇","さいだん"],["を"],["築き","きずき"],["、"],["その"],["上","うえ"],["に"],["あなた"],["の"],["燔祭","はんさい"],["、"],["酬恩祭","しゅうおんさい"],["、"],["羊","ひつじ"],["、"],["牛","うし"],["を"],["ささげなければ"],["ならない"],["。"],["わたし"],["の"],["名","な"],["を"],["覚えさせる","おぼえさせる"],["すべて"],["の"],["所","ところ"],["で"],["、"],["わたし"],["は"],["あなた"],["に"],["臨んで","のぞんで"],["、"],["あなた"],["を"],["祝福","しゅくふく"],["するで"],["あろう"],["。"]]},{"verse":25,"text":"あなたがもしわたしに石,いしの祭壇,さいだんを造,つくるならば、切,きり石,いしで築,きずいてはならない。あなたがもし、のみをそれに当,あてるならば、それをけがすからである。","tok":[["あなた"],["が"],["もし"],["わたし"],["に"],["石","いし"],["の"],["祭壇","さいだん"],["を"],["造るならば","つくるならば"],["、"],["切り石","きりいし"],["で"],["築いて","きずいて"],["は"],["ならない"],["。"],["あなた"],["が"],["もし"],["、"],["のみ"],["を"],["それ"],["に"],["当てるならば","あてるならば"],["、"],["それ"],["を"],["けがす"],["から"],["で"],["ある"],["。"]]},{"verse":26,"text":"あなたは階段,かいだんによって、わたしの祭壇,さいだんに登,のぼってはならない。あなたの隠,かくし所,ところが、その上,うえにあらわれることのないようにするためである』。","tok":[["あなた"],["は"],["階段","かいだん"],["によって"],["、"],["わたし"],["の"],["祭壇","さいだん"],["に"],["登って","のぼって"],["は"],["ならない"],["。"],["あなた"],["の"],["隠し所","かくしところ"],["が"],["、"],["その"],["上","うえ"],["に"],["あらわれる"],["こと"],["の"],["ない"],["よう"],["に"],["する"],["ため"],["で"],["ある"],["』"],["。"]]}]
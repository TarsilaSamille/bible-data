[{"verse":1,"text":"主,しゅはモーセに言,いわれた、","tok":[["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":2,"text":"「イスラエルの人々,ひとびとに告,つげて、わたしのためにささげ物,ものを携,たずさえてこさせなさい。すべて、心,こころから喜,よろこんでする者,ものから、わたしにささげる物,ものを受,うけ取,とりなさい。","tok":[["「"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["告","つげ"],["て"],["、"],["わたし"],["の"],["ため"],["に"],["ささげ物","ささげもの"],["を"],["携えて","たずさえて"],["こさせ"],["なさい"],["。"],["すべて"],["、"],["心","こころ"],["から"],["喜こんで","よろこんで"],["する"],["者","もの"],["から"],["、"],["わたし"],["に"],["ささげる"],["物","もの"],["を"],["受け","うけ"],["取","とり"],["なさい"],["。"]]},{"verse":3,"text":"あなたがたが彼,かれらから受,うけ取,とるべきささげ物,ものはこれである。すなわち金,きん、銀,ぎん、青銅,せいどう、","tok":[["あなた"],["がた"],["が"],["彼","かれ"],["ら"],["から"],["受け取るべき","うけとるべき"],["ささげ物","ささげもの"],["は"],["これ"],["で"],["ある"],["。"],["すなわち"],["金","きん"],["、"],["銀","ぎん"],["、"],["青銅","せいどう"],["、"]]},{"verse":4,"text":"青,あお糸,いと、紫,むらさき糸,いと、緋,ひ糸,いと、亜麻,あまの撚糸,ねんし、やぎの毛糸,けいと、","tok":[["青糸","あおいと"],["、"],["紫糸","むらさきいと"],["、"],["緋","ひ"],["糸","いと"],["、"],["亜麻","あま"],["の"],["撚糸","ねんし"],["、"],["やぎ"],["の"],["毛糸","けいと"],["、"]]},{"verse":5,"text":"あかね染,そめの雄羊,おひつじの皮,かわ、じゅごんの皮,かわ、アカシヤ材,ざい、","tok":[["あかね"],["染","そめ"],["の"],["雄羊","おひつじ"],["の"],["皮","かわ"],["、"],["じゅごん"],["の"],["皮","かわ"],["、"],["アカシヤ"],["材","ざい"],["、"]]},{"verse":6,"text":"ともし油,あぶら、注,そそぎ油,あぶらと香,こうばしい薫香,くんこうのための香料,こうりょう、","tok":[["ともし"],["油","あぶら"],["、"],["注ぎ","そそぎ"],["油","あぶら"],["と"],["香ばしい","こうばしい"],["薫香","くんこう"],["の"],["ため"],["の"],["香料","こうりょう"],["、"]]},{"verse":7,"text":"縞,しまめのう、エポデと胸当,むねあてにはめる宝石,ほうせき。","tok":[["縞","しま"],["めのう"],["、"],["エポデ"],["と"],["胸当","むねあて"],["に"],["はめる"],["宝石","ほうせき"],["。"]]},{"verse":8,"text":"また、彼,かれらにわたしのために聖所,せいじょを造,つくらせなさい。わたしが彼,かれらのうちに住,すむためである。","tok":[["また"],["、"],["彼","かれ"],["ら"],["に"],["わたし"],["の"],["ため"],["に"],["聖","せい"],["所","しょ"],["を"],["造らせ","つくらせ"],["なさい"],["。"],["わたし"],["が"],["彼","かれ"],["ら"],["の"],["うち"],["に"],["住む","すむ"],["ため"],["で"],["ある"],["。"]]},{"verse":9,"text":"すべてあなたに示,しめす幕屋,まくやの型,かたおよび、そのもろもろの器,うつわの型,かたに従,したがって、これを造,つくらなければならない。","tok":[["すべて"],["あなた"],["に"],["示めす","しめす"],["幕屋","まくや"],["の"],["型","かた"],["および"],["、"],["その"],["もろもろ"],["の"],["器","うつわ"],["の"],["型","かた"],["に"],["従って","したがって"],["、"],["これ"],["を"],["造らなければ","つくらなければ"],["ならない"],["。"]]},{"verse":10,"text":"彼,かれらはアカシヤ材,ざいで箱,はこを造,つくらなければならない。長,ながさは二キュビト半,はん、幅,はばは一キュビト半,はん、高,たかさは一キュビト半,はん。","tok":[["彼","かれ"],["ら"],["は"],["アカシヤ"],["材","ざい"],["で"],["箱","はこ"],["を"],["造らなければ","つくらなければ"],["ならない"],["。"],["長さ","ながさ"],["は"],["二","に"],["キュビト"],["半","はん"],["、"],["幅","はば"],["は"],["一","いち"],["キュビト"],["半","はん"],["、"],["高か","たか"],["さ"],["は"],["一","いち"],["キュビト"],["半","はん"],["。"]]},{"verse":11,"text":"あなたは純金,じゅんきんでこれをおおわなければならない。すなわち内外,ないがいともにこれをおおい、その上,うえの周囲,しゅういに金,きんの飾,かざり縁,ふちを造,つくらなければならない。","tok":[["あなた"],["は"],["純金","じゅんきん"],["で"],["これ"],["を"],["おおわなければ"],["ならない"],["。"],["すなわち"],["内外","ないがい"],["とも"],["に"],["これ"],["を"],["おおい"],["、"],["その"],["上","うえ"],["の"],["周囲","しゅうい"],["に"],["金","きん"],["の"],["飾","かざり"],["縁","ふち"],["を"],["造らなければ","つくらなければ"],["ならない"],["。"]]},{"verse":12,"text":"また金,きんの環,かん四つを鋳,いて、その四すみに取,とり付,つけなければならない。すなわち二つの環,かんをこちら側,がわに、二つの環,かんをあちら側,がわに付,つけなければならない。","tok":[["また"],["金","きん"],["の"],["環","かん"],["四","よん"],["つ"],["を"],["鋳て","いて"],["、"],["その"],["四","よん"],["すみ"],["に"],["取付","とりつけ"],["なければ"],["ならない"],["。"],["すなわち"],["二","ふた"],["つ"],["の"],["環","かん"],["を"],["こちら側","こちらがわ"],["に"],["、"],["二","ふた"],["つ"],["の"],["環","かん"],["を"],["あちら側","あちらがわ"],["に"],["付なければ","つけなければ"],["ならない"],["。"]]},{"verse":13,"text":"またアカシヤ材,ざいのさおを造,つくり、金,きんでこれをおおわなければならない。","tok":[["また"],["アカシヤ"],["材","ざい"],["の"],["さお"],["を"],["造","つくり"],["、"],["金","きん"],["で"],["これ"],["を"],["おおわなければ"],["ならない"],["。"]]},{"verse":14,"text":"そしてそのさおを箱,はこの側面,そくめんの環,かんに通,とおし、それで箱,はこをかつがなければならない。","tok":[["そして"],["その"],["さお"],["を"],["箱","はこ"],["の"],["側面","そくめん"],["の"],["環","かん"],["に"],["通し","とおし"],["、"],["それ"],["で"],["箱","はこ"],["を"],["かつがなければ"],["ならない"],["。"]]},{"verse":15,"text":"さおは箱,はこの環,かんに差,さして置,おき、それを抜,ぬき放,はなしてはならない。","tok":[["さお"],["は"],["箱","はこ"],["の"],["環","かん"],["に"],["差して","さして"],["置き","おき"],["、"],["それ"],["を"],["抜き放して","ぬきはなして"],["は"],["ならない"],["。"]]},{"verse":16,"text":"そしてその箱,はこに、わたしがあなたに与,あたえるあかしの板,いたを納,おさめなければならない。","tok":[["そして"],["その"],["箱","はこ"],["に"],["、"],["わたし"],["が"],["あなた"],["に"],["与える","あたえる"],["あかし"],["の"],["板","いた"],["を"],["納","おさめ"],["なければ"],["ならない"],["。"]]},{"verse":17,"text":"また純金,じゅんきんの贖罪所,しょくざいしょを造,つくらなければならない。長,ながさは二キュビト半,はん、幅,はばは一キュビト半,はん。","tok":[["また"],["純金","じゅんきん"],["の"],["贖罪所","しょくざいしょ"],["を"],["造らなければ","つくらなければ"],["ならない"],["。"],["長さ","ながさ"],["は"],["二","に"],["キュビト"],["半","はん"],["、"],["幅","はば"],["は"],["一","いち"],["キュビト"],["半","はん"],["。"]]},{"verse":18,"text":"また二つの金,きんのケルビムを造,つくらなければならない。これを打物,うちもの造,つくりとし、贖罪所,しょくざいしょの両端,りょうはしに置,おかなければならない。","tok":[["また"],["二","ふた"],["つ"],["の"],["金","きん"],["の"],["ケルビム"],["を"],["造らなければ","つくらなければ"],["ならない"],["。"],["これ"],["を"],["打物造","うちものつくり"],["と"],["し"],["、"],["贖罪所","しょくざいしょ"],["の"],["両端","りょうはし"],["に"],["置かなければ","おかなければ"],["ならない"],["。"]]},{"verse":19,"text":"一つのケルブをこの端,はしに、一つのケルブをかの端,はしに造,つくり、ケルビムを贖罪所,しょくざいしょの一部,いちぶとしてその両端,りょうはしに造,つくらなければならない。","tok":[["一","ひと"],["つ"],["の"],["ケルブ"],["を"],["この"],["端","はし"],["に"],["、"],["一","ひと"],["つ"],["の"],["ケルブ"],["を"],["かの"],["端","はし"],["に"],["造","つくり"],["、"],["ケルビム"],["を"],["贖罪所","しょくざいしょ"],["の"],["一部","いちぶ"],["として"],["その"],["両端","りょうはし"],["に"],["造らなければ","つくらなければ"],["ならない"],["。"]]},{"verse":20,"text":"ケルビムは翼,つばさを高,たかく伸,のべ、その翼,つばさをもって贖罪所,しょくざいしょをおおい、顔,かおは互,たがいにむかい合,あい、ケルビムの顔,かおは贖罪所,しょくざいしょにむかわなければならない。","tok":[["ケルビム"],["は"],["翼","つばさ"],["を"],["高かく","たかく"],["伸べ","のべ"],["、"],["その"],["翼","つばさ"],["を"],["もって"],["贖罪所","しょくざいしょ"],["を"],["おおい"],["、"],["顔","かお"],["は"],["互","たがい"],["に"],["むかい合い","むかいあい"],["、"],["ケルビム"],["の"],["顔","かお"],["は"],["贖罪所","しょくざいしょ"],["に"],["むかわなければ"],["ならない"],["。"]]},{"verse":21,"text":"あなたは贖罪所,しょくざいしょを箱,はこの上,うえに置,おき、箱,はこの中,なかにはわたしが授,さづけるあかしの板,いたを納,おさめなければならない。","tok":[["あなた"],["は"],["贖罪所","しょくざいしょ"],["を"],["箱","はこ"],["の"],["上","うえ"],["に"],["置き","おき"],["、"],["箱","はこ"],["の"],["中","なか"],["に"],["は"],["わたし"],["が"],["授","さ"],["づける"],["あかし"],["の"],["板","いた"],["を"],["納","おさめ"],["なければ"],["ならない"],["。"]]},{"verse":22,"text":"その所,ところでわたしはあなたに会,あい、贖罪所,しょくざいしょの上,うえから、あかしの箱,はこの上,うえにある二つのケルビムの間,あいだから、イスラエルの人々,ひとびとのために、わたしが命,めいじようとするもろもろの事,ことを、あなたに語,かたるであろう。","tok":[["その"],["所","ところ"],["で"],["わたし"],["は"],["あなた"],["に"],["会い","あい"],["、"],["贖罪所","しょくざいしょ"],["の"],["上","うえ"],["から"],["、"],["あかし"],["の"],["箱","はこ"],["の"],["上","うえ"],["に"],["ある"],["二","ふた"],["つ"],["の"],["ケルビム"],["の"],["間","あいだ"],["から"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["ため"],["に"],["、"],["わたし"],["が"],["命じよう","めいじよう"],["と"],["する"],["もろもろ"],["の"],["事","こと"],["を"],["、"],["あなた"],["に"],["語るで","かたるで"],["あろう"],["。"]]},{"verse":23,"text":"あなたはまたアカシヤ材,ざいの机,つくえを造,つくらなければならない。長,ながさは二キュビト、幅,はばは一キュビト、高,たかさは一キュビト半,はん。","tok":[["あなた"],["は"],["また"],["アカシヤ"],["材","ざい"],["の"],["机","つくえ"],["を"],["造らなければ","つくらなければ"],["ならない"],["。"],["長さ","ながさ"],["は"],["二","に"],["キュビト"],["、"],["幅","はば"],["は"],["一","いち"],["キュビト"],["、"],["高か","たか"],["さ"],["は"],["一","いち"],["キュビト"],["半","はん"],["。"]]},{"verse":24,"text":"純金,じゅんきんでこれをおおい、周囲,しゅういに金,きんの飾,かざり縁,ふちを造,つくり、","tok":[["純金","じゅんきん"],["で"],["これ"],["を"],["おおい"],["、"],["周囲","しゅうい"],["に"],["金","きん"],["の"],["飾","かざり"],["縁","ふち"],["を"],["造","つくり"],["、"]]},{"verse":25,"text":"またその周囲,しゅういに手,て幅,はばの棧,さんを造,つくり、その棧,さんの周囲,しゅういに金,きんの飾,かざり縁,ふちを造,つくらなければならない。","tok":[["また"],["その"],["周囲","しゅうい"],["に"],["手幅","てはば"],["の"],["棧","さん"],["を"],["造","つくり"],["、"],["その"],["棧","さん"],["の"],["周囲","しゅうい"],["に"],["金","きん"],["の"],["飾","かざり"],["縁","ふち"],["を"],["造らなければ","つくらなければ"],["ならない"],["。"]]},{"verse":26,"text":"また、そのために金,きんの環,かん四つを造,つくり、その四つの足,あしのすみ四か所,しょにその環,かんを取,とり付,つけなければならない。","tok":[["また"],["、"],["その"],["ため"],["に"],["金","きん"],["の"],["環","かん"],["四","よん"],["つ"],["を"],["造","つくり"],["、"],["その"],["四","よん"],["つ"],["の"],["足","あし"],["の"],["すみ"],["四","よん"],["か所","かしょ"],["に"],["その"],["環","かん"],["を"],["取付","とりつけ"],["なければ"],["ならない"],["。"]]},{"verse":27,"text":"環,かんは棧,さんのわきに付,つけて、机,つくえをかつぐさおを入,いれる所,ところとしなければならない。","tok":[["環","かん"],["は"],["棧","さん"],["の"],["わき"],["に"],["付て","つけて"],["、"],["机","つくえ"],["を"],["かつぐ"],["さお"],["を"],["入れる","いれる"],["所","ところ"],["と"],["しなければ"],["ならない"],["。"]]},{"verse":28,"text":"またアカシヤ材,ざいのさおを造,つくり、金,きんでこれをおおい、それをもって、机,つくえをかつがなければならない。","tok":[["また"],["アカシヤ"],["材","ざい"],["の"],["さお"],["を"],["造","つくり"],["、"],["金","きん"],["で"],["これ"],["を"],["おおい"],["、"],["それ"],["を"],["もって"],["、"],["机","つくえ"],["を"],["かつがなければ"],["ならない"],["。"]]},{"verse":29,"text":"また、その皿,さら、乳香,にゅうこうを盛,もる杯,はいおよび灌祭,かんさいを注,そそぐための瓶,びんと鉢,はちを造,つくり、これらは純金,じゅんきんで造,つくらなければならない。","tok":[["また"],["、"],["その"],["皿","さら"],["、"],["乳香","にゅうこう"],["を"],["盛る","もる"],["杯","は"],["い"],["および"],["灌祭","かんさい"],["を"],["注ぐ","そそぐ"],["ため"],["の"],["瓶","びん"],["と"],["鉢","はち"],["を"],["造","つくり"],["、"],["これ"],["ら"],["は"],["純金","じゅんきん"],["で"],["造らなければ","つくらなければ"],["ならない"],["。"]]},{"verse":30,"text":"そして机,つくえの上,うえには供,そなえのパンを置,おいて、常,つねにわたしの前,まえにあるようにしなければならない。","tok":[["そして"],["机","つくえ"],["の"],["上","うえ"],["に"],["は"],["供え","そなえ"],["の"],["パン"],["を"],["置いて","おいて"],["、"],["常","つね"],["に"],["わたし"],["の"],["前","まえ"],["に"],["ある"],["よう"],["に"],["しなければ"],["ならない"],["。"]]},{"verse":31,"text":"また純金,じゅんきんの燭台,しょくだいを造,つくらなければならない。燭台,しょくだいは打物,うちもの造,つくりとし、その台,だい、幹,みき、萼,がく、節,ふし、花,はなを一つに連,つらならせなければならない。","tok":[["また"],["純金","じゅんきん"],["の"],["燭台","しょくだい"],["を"],["造らなければ","つくらなければ"],["ならない"],["。"],["燭台","しょくだい"],["は"],["打物造","うちものつくり"],["と"],["し"],["、"],["その"],["台","だい"],["、"],["幹","みき"],["、"],["萼","がく"],["、"],["節","ふし"],["、"],["花","はな"],["を"],["一","ひと"],["つ"],["に"],["連ならせなければ","つらならせなければ"],["ならない"],["。"]]},{"verse":32,"text":"また六つの枝,えだをそのわきから出,ださせ、燭台,しょくだいの三つの枝,えだをこの側,がわから、燭台,しょくだいの三つの枝,えだをかの側,がわから出,ださせなければならない。","tok":[["また"],["六","むい"],["つ"],["の"],["枝","えだ"],["を"],["その"],["わき"],["から"],["出させ","ださせ"],["、"],["燭台","しょくだい"],["の"],["三","みっ"],["つ"],["の"],["枝","えだ"],["を"],["この"],["側","がわ"],["から"],["、"],["燭台","しょくだい"],["の"],["三","みっ"],["つ"],["の"],["枝","えだ"],["を"],["かの"],["側","がわ"],["から"],["出させなければ","ださせなければ"],["ならない"],["。"]]},{"verse":33,"text":"あめんどうの花,はなの形,かたちをした三つの萼,がくが、それぞれ節,ふしと花,はなをもって一つの枝,えだにあり、また、あめんどうの花,はなの形,かたちをした三つの萼,がくが、それぞれ節,ふしと花,はなをもってほかの枝,えだにあるようにし、燭台,しょくだいから出,でる六つの枝,えだを、みなそのようにしなければならない。","tok":[["あ"],["めんどう"],["の"],["花","はな"],["の"],["形","かたち"],["を"],["した"],["三","みっ"],["つ"],["の"],["萼","がく"],["が"],["、"],["それぞれ"],["節","ふし"],["と"],["花","はな"],["を"],["もって"],["一","ひと"],["つ"],["の"],["枝","えだ"],["に"],["あり"],["、"],["また"],["、"],["あ"],["めんどう"],["の"],["花","はな"],["の"],["形","かたち"],["を"],["した"],["三","みっ"],["つ"],["の"],["萼","がく"],["が"],["、"],["それぞれ"],["節","ふし"],["と"],["花","はな"],["を"],["もって"],["ほか"],["の"],["枝","えだ"],["に"],["ある"],["よう"],["に"],["し"],["、"],["燭台","しょくだい"],["から"],["出る","でる"],["六","むい"],["つ"],["の"],["枝","えだ"],["を"],["、"],["みな"],["その"],["よう"],["に"],["しなければ"],["ならない"],["。"]]},{"verse":34,"text":"また、燭台,しょくだいの幹,みきには、あめんどうの花,はなの形,かたちをした四つの萼,がくを付,つけ、その萼,がくにはそれぞれ節,ふしと花,はなをもたせなさい。","tok":[["また"],["、"],["燭台","しょくだい"],["の"],["幹","みき"],["に"],["は"],["、"],["あ"],["めんどう"],["の"],["花","はな"],["の"],["形","かたち"],["を"],["した"],["四","よん"],["つ"],["の"],["萼","がく"],["を"],["付け","つけ"],["、"],["その"],["萼","がく"],["に"],["は"],["それぞれ"],["節","ふし"],["と"],["花","はな"],["を"],["もたせ"],["なさい"],["。"]]},{"verse":35,"text":"すなわち二つの枝,えだの下,したに一つの節,ふしを取,とり付,つけ、次,つぎの二つの枝,えだの下,したに一つの節,ふしを取,とり付,つけ、更,さらに次,つぎの二つの枝,えだの下,したに一つの節,ふしを取,とり付,つけ、燭台,しょくだいの幹,みきから出,でる六つの枝,えだに、みなそのようにしなければならない。","tok":[["すなわち"],["二","ふた"],["つ"],["の"],["枝","えだ"],["の"],["下","した"],["に"],["一","ひと"],["つ"],["の"],["節","ふし"],["を"],["取付け","とりつけ"],["、"],["次","つぎ"],["の"],["二","ふた"],["つ"],["の"],["枝","えだ"],["の"],["下","した"],["に"],["一","ひと"],["つ"],["の"],["節","ふし"],["を"],["取付け","とりつけ"],["、"],["更に","さらに"],["次","つぎ"],["の"],["二","ふた"],["つ"],["の"],["枝","えだ"],["の"],["下","した"],["に"],["一","ひと"],["つ"],["の"],["節","ふし"],["を"],["取付け","とりつけ"],["、"],["燭台","しょくだい"],["の"],["幹","みき"],["から"],["出る","でる"],["六","むい"],["つ"],["の"],["枝","えだ"],["に"],["、"],["みな"],["その"],["よう"],["に"],["しなければ"],["ならない"],["。"]]},{"verse":36,"text":"それらの節,ふしと枝,えだを一つに連,つらね、ことごとく純金,じゅんきんの打物,うちもの造,つくりにしなければならない。","tok":[["それ"],["ら"],["の"],["節","ふし"],["と"],["枝","えだ"],["を"],["一","ひと"],["つ"],["に"],["連ね","つらね"],["、"],["ことごとく"],["純金","じゅんきん"],["の"],["打物造","うちものつくり"],["に"],["しなければ"],["ならない"],["。"]]},{"verse":37,"text":"また、それのともしび皿,ざらを七つ造,つくり、そのともしび皿,ざらに火,ひをともして、その前方,ぜんぽうを照,てらさせなければならない。","tok":[["また"],["、"],["それ"],["の"],["ともしび"],["皿","ざら"],["を"],["七","なな"],["つ"],["造","つくり"],["、"],["その"],["ともしび"],["皿","ざら"],["に"],["火","ひ"],["を"],["ともして"],["、"],["その"],["前方","ぜんぽう"],["を"],["照らさせなければ","てらさせなければ"],["ならない"],["。"]]},{"verse":38,"text":"その芯,しん切,きりばさみと、芯,しん取,とり皿,ざらは純金,じゅんきんで造,つくらなければならない。","tok":[["その"],["芯切り","しんきり"],["ばさみ"],["と"],["、"],["芯","しん"],["取皿","とりざら"],["は"],["純金","じゅんきん"],["で"],["造らなければ","つくらなければ"],["ならない"],["。"]]},{"verse":39,"text":"すなわち純金,じゅんきん一タラントで燭台,しょくだいと、これらのもろもろの器,うつわとが造,つくられなければならない。","tok":[["すなわち"],["純金","じゅんきん"],["一","いち"],["タラント"],["で"],["燭台","しょくだい"],["と"],["、"],["これ"],["ら"],["の"],["もろもろ"],["の"],["器","うつわ"],["と"],["が"],["造られなければ","つくられなければ"],["ならない"],["。"]]},{"verse":40,"text":"そしてあなたが山,やまで示,しめされた型,かたに従,したがい、注意,ちゅういしてこれを造,つくらなければならない。","tok":[["そして"],["あなた"],["が"],["山","やま"],["で"],["示めされた","しめされた"],["型","かた"],["に"],["従い","したがい"],["、"],["注意","ちゅうい"],["して"],["これ"],["を"],["造らなければ","つくらなければ"],["ならない"],["。"]]}]
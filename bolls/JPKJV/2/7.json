[{"verse":1,"text":"主,しゅはモーセに言,いわれた、「見,みよ、わたしはあなたをパロに対,たいして神,かみのごときものとする。あなたの兄弟,きょうだいアロンはあなたの預言者,よげんしゃとなるであろう。","tok":[["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"],["「"],["見よ","みよ"],["、"],["わたし"],["は"],["あなた"],["を"],["パロ"],["に対して","にたいして"],["神","かみ"],["の"],["ごとき"],["もの"],["と"],["する"],["。"],["あなた"],["の"],["兄弟","きょうだい"],["アロン"],["は"],["あなた"],["の"],["預言者","よげんしゃ"],["と"],["なるで"],["あろう"],["。"]]},{"verse":2,"text":"あなたはわたしが命,めいじることを、ことごとく彼,かれに告,つげなければならない。そしてあなたの兄弟,きょうだいアロンはパロに告,つげて、イスラエルの人々,ひとびとをその国,くにから去,さらせるようにさせなければならない。","tok":[["あなた"],["は"],["わたし"],["が"],["命じる","めいじる"],["こと"],["を"],["、"],["ことごとく"],["彼","かれ"],["に"],["告","つげ"],["なければ"],["ならない"],["。"],["そして"],["あなた"],["の"],["兄弟","きょうだい"],["アロン"],["は"],["パロ"],["に"],["告","つげ"],["て"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["を"],["その"],["国","くに"],["から"],["去らせる","さらせる"],["よう"],["に"],["させなければ"],["ならない"],["。"]]},{"verse":3,"text":"しかし、わたしはパロの心,こころをかたくなにするので、わたしのしるしと不思議,ふしぎをエジプトの国,くにに多,おおく行,おこなっても、","tok":[["しかし"],["、"],["わたし"],["は"],["パロ"],["の"],["心","こころ"],["を"],["かたくな"],["に"],["する"],["ので"],["、"],["わたし"],["の"],["しるし"],["と"],["不思議","ふしぎ"],["を"],["エジプト"],["の"],["国","くに"],["に"],["多く","おおく"],["行なって","おこなって"],["も"],["、"]]},{"verse":4,"text":"パロはあなたがたの言,いうことを聞,きかないであろう。それでわたしは手,てをエジプトの上,うえに加,くわえ、大,おおいなるさばきをくだして、わたしの軍団,ぐんだん、わたしの民,たみイスラエルの人々,ひとびとを、エジプトの国,くにから導,みちびき出,だすであろう。","tok":[["パロ"],["は"],["あなた"],["がた"],["の"],["言う","いう"],["こと"],["を"],["聞かないで","きかないで"],["あろう"],["。"],["それ"],["で"],["わたし"],["は"],["手","て"],["を"],["エジプト"],["の"],["上","うえ"],["に"],["加え","くわえ"],["、"],["大いなる","おおいなる"],["さばき"],["を"],["くだして"],["、"],["わたし"],["の"],["軍団","ぐんだん"],["、"],["わたし"],["の"],["民","たみ"],["イスラエル"],["の"],["人々","ひとびと"],["を"],["、"],["エジプト"],["の"],["国","くに"],["から"],["導き出すで","みちびきだすで"],["あろう"],["。"]]},{"verse":5,"text":"わたしが手,てをエジプトの上,うえにさし伸,のべて、イスラエルの人々,ひとびとを彼,かれらのうちから導,みちびき出,だす時,とき、エジプトびとはわたしが主,しゅであることを知,しるようになるであろう」。","tok":[["わたし"],["が"],["手","て"],["を"],["エジプト"],["の"],["上","うえ"],["に"],["さし伸べて","さしのべて"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["を"],["彼","かれ"],["ら"],["の"],["うち"],["から"],["導き出す","みちびきだす"],["時","とき"],["、"],["エジプト"],["び"],["と"],["は"],["わたし"],["が"],["主","しゅ"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なるで"],["あろう"],["」"],["。"]]},{"verse":6,"text":"モーセとアロンはそのように行,おこなった。すなわち主,しゅが彼,かれらに命,めいじられたように行,おこなった。","tok":[["モーセ"],["と"],["アロン"],["は"],["その"],["よう"],["に"],["行なった","おこなった"],["。"],["すなわち"],["主","しゅ"],["が"],["彼","かれ"],["ら"],["に"],["命じられた","めいじられた"],["よう"],["に"],["行なった","おこなった"],["。"]]},{"verse":7,"text":"彼,かれらがパロと語,かたった時,とき、モーセは八十歳,さい、アロンは八十三歳,さいであった。","tok":[["彼","かれ"],["ら"],["が"],["パロ"],["と"],["語った","かたった"],["時","とき"],["、"],["モーセ"],["は"],["八十歳","さ"],["い"],["、"],["アロン"],["は"],["八十三歳","さ"],["いで"],["あった"],["。"]]},{"verse":8,"text":"主,しゅはモーセとアロンに言,いわれた、","tok":[["主","しゅ"],["は"],["モーセ"],["と"],["アロン"],["に"],["言われた","いわれた"],["、"]]},{"verse":9,"text":"「パロがあなたがたに、『不思議,ふしぎをおこなって証拠,しょうこを示,しめせ』と言,いう時,とき、あなたはアロンに言,いいなさい、『あなたのつえを取,とって、パロの前,まえに投,なげなさい』と。するとそれはへびになるであろう」。","tok":[["「"],["パロ"],["が"],["あなた"],["がた"],["に"],["、"],["『"],["不思議","ふしぎ"],["を"],["おこなって"],["証拠","しょうこ"],["を"],["示","しめせ"],["』"],["と"],["言う","いう"],["時","とき"],["、"],["あなた"],["は"],["アロン"],["に"],["言い","いい"],["なさい"],["、"],["『"],["あなた"],["の"],["つえ"],["を"],["取って","とって"],["、"],["パロ"],["の"],["前","まえ"],["に"],["投","なげ"],["なさい"],["』"],["と"],["。"],["する"],["と"],["それ"],["は"],["へび"],["に"],["なるで"],["あろう"],["」"],["。"]]},{"verse":10,"text":"それで、モーセとアロンはパロのところに行,いき、主,しゅの命,めいじられたとおりにおこなった。すなわちアロンはそのつえを、パロとその家来,けらいたちの前,まえに投,なげると、それはへびになった。","tok":[["それ"],["で"],["、"],["モーセ"],["と"],["アロン"],["は"],["パロ"],["の"],["ところ"],["に"],["行き","いき"],["、"],["主","しゅ"],["の"],["命じられた","めいじられた"],["とおり"],["に"],["おこなった"],["。"],["すなわち"],["アロン"],["は"],["その"],["つえ"],["を"],["、"],["パロ"],["と"],["その"],["家来","けらい"],["たち"],["の"],["前","まえ"],["に"],["投る","なげる"],["と"],["、"],["それ"],["は"],["へび"],["に"],["なった"],["。"]]},{"verse":11,"text":"そこでパロもまた知者,ちしゃと魔法使,まほうつかいを召,めし寄,よせた。これらのエジプトの魔術,まじゅつ師,しらもまた、その秘術,ひじゅつをもって同,おなじように行,おこなった。","tok":[["そこ"],["で"],["パロ"],["も"],["また"],["知者","ちしゃ"],["と"],["魔法","まほう"],["使い","つかい"],["を"],["召寄せた","めしよせた"],["。"],["これ"],["ら"],["の"],["エジプト"],["の"],["魔術師","まじゅつし"],["ら"],["も"],["また"],["、"],["その"],["秘術","ひじゅつ"],["を"],["もって"],["同じ","おなじ"],["よう"],["に"],["行なった","おこなった"],["。"]]},{"verse":12,"text":"すなわち彼,かれらは、おのおのそのつえを投,なげたが、それらはへびになった。しかし、アロンのつえは彼,かれらのつえを、のみつくした。","tok":[["すなわち"],["彼","かれ"],["ら"],["は"],["、"],["おのおの"],["その"],["つえ"],["を"],["投た","なげた"],["が"],["、"],["それ"],["ら"],["は"],["へび"],["に"],["なった"],["。"],["しかし"],["、"],["アロン"],["の"],["つえ"],["は"],["彼","かれ"],["ら"],["の"],["つえ"],["を"],["、"],["のみ"],["つくした"],["。"]]},{"verse":13,"text":"けれども、パロの心,こころはかたくなになって、主,しゅの言,いわれたように、彼,かれらの言,いうことを聞,きかなかった。","tok":[["けれど"],["も"],["、"],["パロ"],["の"],["心","こころ"],["は"],["かたくな"],["に"],["なって"],["、"],["主","しゅ"],["の"],["言われた","いわれた"],["よう"],["に"],["、"],["彼","かれ"],["ら"],["の"],["言う","いう"],["こと"],["を"],["聞かなかった","きかなかった"],["。"]]},{"verse":14,"text":"主,しゅはモーセに言,いわれた、「パロの心,こころはかたくなで、彼,かれは民,たみを去,さらせることを拒,こばんでいる。","tok":[["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"],["「"],["パロ"],["の"],["心","こころ"],["は"],["かたくな"],["で"],["、"],["彼","かれ"],["は"],["民","たみ"],["を"],["去らせる","さらせる"],["こと"],["を"],["拒んで","こばんで"],["いる"],["。"]]},{"verse":15,"text":"あなたは、あすの朝,あさ、パロのところに行,いきなさい。見,みよ、彼,かれは水,みずのところに出,でている。あなたは、へびに変,かわったあのつえを手,てに執,とり、ナイル川,かわの岸,きしに立,たって彼,かれに会,あい、","tok":[["あなた"],["は"],["、"],["あす"],["の"],["朝","あさ"],["、"],["パロ"],["の"],["ところ"],["に"],["行き","いき"],["なさい"],["。"],["見よ","みよ"],["、"],["彼","かれ"],["は"],["水","みず"],["の"],["ところ"],["に"],["出て","でて"],["いる"],["。"],["あなた"],["は"],["、"],["へび"],["に"],["変わった","かわった"],["あの"],["つえ"],["を"],["手","て"],["に"],["執り","とり"],["、"],["ナイル"],["川","かわ"],["の"],["岸","きし"],["に"],["立って","たって"],["彼","かれ"],["に"],["会い","あい"],["、"]]},{"verse":16,"text":"そして彼,かれに言,いいなさい、『ヘブルびとの神,かみ、主,しゅがわたしをあなたにつかわして言,いわれます、「わたしの民,たみを去,さらせ、荒野,あらので、わたしに仕,つかえるようにさせよ」と。しかし今,いまもなお、あなたが聞,ききいれようとされないので、","tok":[["そして"],["彼","かれ"],["に"],["言い","いい"],["なさい"],["、"],["『"],["ヘブル"],["びと"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["わたし"],["を"],["あなた"],["に"],["つかわして"],["言われます","いわれます"],["、"],["「"],["わたし"],["の"],["民","たみ"],["を"],["去らせ","さらせ"],["、"],["荒野","あらの"],["で"],["、"],["わたし"],["に"],["仕える","つかえる"],["よう"],["に"],["させ"],["よ"],["」"],["と"],["。"],["しかし"],["今","いま"],["も"],["なお"],["、"],["あなた"],["が"],["聞きいれよう","ききいれよう"],["と"],["されない"],["ので"],["、"]]},{"verse":17,"text":"主,しゅはこう仰,おおせられます、「これによってわたしが主,しゅであることを、あなたは知,しるでしょう。見,みよ、わたしが手,てにあるつえでナイル川,かわの水,みずを打,うつと、それは血,ちに変,かわるであろう。","tok":[["主","しゅ"],["は"],["こう"],["仰せられます","おおせられます"],["、"],["「"],["これ"],["によって"],["わたし"],["が"],["主","しゅ"],["で"],["ある"],["こと"],["を"],["、"],["あなた"],["は"],["知るでしょう","しるでしょう"],["。"],["見よ","みよ"],["、"],["わたし"],["が"],["手","て"],["に"],["ある"],["つえ"],["で"],["ナイル"],["川","かわ"],["の"],["水","みず"],["を"],["打つ","うつ"],["と"],["、"],["それ"],["は"],["血","ち"],["に"],["変わるで","かわるで"],["あろう"],["。"]]},{"verse":18,"text":"そして川,かわの魚,うおは死,しに、川,かわは臭,くさくなり、エジプトびとは川,かわの水,みずを飲,のむことをいとうであろう」』と」。","tok":[["そして"],["川","かわ"],["の"],["魚","うお"],["は"],["死に","しに"],["、"],["川","かわ"],["は"],["臭く","くさく"],["なり"],["、"],["エジプト"],["び"],["と"],["は"],["川","かわ"],["の"],["水","みず"],["を"],["飲む","のむ"],["こと"],["を"],["いとうで"],["あろう"],["」"],["』"],["と"],["」"],["。"]]},{"verse":19,"text":"主,しゅはまたモーセに言,いわれた、「あなたはアロンに言,いいなさい、『あなたのつえを執,とって、手,てをエジプトの水,みずの上,うえ、川,かわの上,うえ、流,ながれの上,うえ、池,いけの上,うえ、またそのすべての水,みずたまりの上,うえにさし伸,のべて、それを血,ちにならせなさい。エジプト全国,ぜんこくにわたって、木,きの器,うつわ、石,いしの器,うつわにも、血,ちがあるようになるでしょう』と」。","tok":[["主","しゅ"],["は"],["また"],["モーセ"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["は"],["アロン"],["に"],["言い","いい"],["なさい"],["、"],["『"],["あなた"],["の"],["つえ"],["を"],["執って","とって"],["、"],["手","て"],["を"],["エジプト"],["の"],["水","みず"],["の"],["上","うえ"],["、"],["川","かわ"],["の"],["上","うえ"],["、"],["流れ","ながれ"],["の"],["上","うえ"],["、"],["池の上","いけのうえ"],["、"],["また"],["その"],["すべて"],["の"],["水たまり","みずたまり"],["の"],["上","うえ"],["に"],["さし伸べて","さしのべて"],["、"],["それ"],["を"],["血","ち"],["に"],["ならせ"],["なさい"],["。"],["エジプト"],["全国","ぜんこく"],["に"],["わたって"],["、"],["木","き"],["の"],["器","うつわ"],["、"],["石","いし"],["の"],["器","うつわ"],["に"],["も"],["、"],["血","ち"],["が"],["ある"],["よう"],["に"],["なるでしょう"],["』"],["と"],["」"],["。"]]},{"verse":20,"text":"モーセとアロンは主,しゅの命,めいじられたようにおこなった。すなわち、彼,かれはパロとその家来,けらいたちの目,めの前,まえで、つえをあげてナイル川,かわの水,みずを打,うつと、川,かわの水,みずは、ことごとく血,ちに変,かわった。","tok":[["モーセ"],["と"],["アロン"],["は"],["主","しゅ"],["の"],["命じられた","めいじられた"],["よう"],["に"],["おこなった"],["。"],["すなわち"],["、"],["彼","かれ"],["は"],["パロ"],["と"],["その"],["家来","けらい"],["たち"],["の"],["目","め"],["の"],["前","まえ"],["で"],["、"],["つえ"],["を"],["あげて"],["ナイル"],["川","かわ"],["の"],["水","みず"],["を"],["打つ","うつ"],["と"],["、"],["川","かわ"],["の"],["水","みず"],["は"],["、"],["ことごとく"],["血","ち"],["に"],["変わった","かわった"],["。"]]},{"verse":21,"text":"それで川,かわの魚,うおは死,しに、川,かわは臭,くさくなり、エジプトびとは川,かわの水,みずを飲,のむことができなくなった。そしてエジプト全国,ぜんこくにわたって血,ちがあった。","tok":[["それ"],["で"],["川","かわ"],["の"],["魚","うお"],["は"],["死に","しに"],["、"],["川","かわ"],["は"],["臭く","くさく"],["なり"],["、"],["エジプト"],["び"],["と"],["は"],["川","かわ"],["の"],["水","みず"],["を"],["飲む","のむ"],["こと"],["が"],["できなく"],["なった"],["。"],["そして"],["エジプト"],["全国","ぜんこく"],["に"],["わたって"],["血","ち"],["が"],["あった"],["。"]]},{"verse":22,"text":"エジプトの魔術,まじゅつ師,しらも秘術,ひじゅつをもって同,おなじようにおこなった。しかし、主,しゅの言,いわれたように、パロの心,こころはかたくなになり、彼,かれらの言,いうことを聞,きかなかった。","tok":[["エジプト"],["の"],["魔術師","まじゅつし"],["ら"],["も"],["秘術","ひじゅつ"],["を"],["もって"],["同じ","おなじ"],["よう"],["に"],["おこなった"],["。"],["しかし"],["、"],["主","しゅ"],["の"],["言われた","いわれた"],["よう"],["に"],["、"],["パロ"],["の"],["心","こころ"],["は"],["かたくな"],["に"],["なり"],["、"],["彼","かれ"],["ら"],["の"],["言う","いう"],["こと"],["を"],["聞かなかった","きかなかった"],["。"]]},{"verse":23,"text":"パロは身,みをめぐらして家,いえに入,いり、またこのことをも心,こころに留,とめなかった。","tok":[["パロ"],["は"],["身","み"],["を"],["めぐらして"],["家","いえ"],["に"],["入","いり"],["、"],["また"],["この"],["こと"],["を"],["も"],["心","こころ"],["に"],["留","とめ"],["なかった"],["。"]]},{"verse":24,"text":"すべてのエジプトびとはナイル川,かわの水,みずが飲,のめなかったので、飲,のむ水,みずを得,えようと、川,かわのまわりを掘,ほった。","tok":[["すべて"],["の"],["エジプト"],["び"],["と"],["は"],["ナイル"],["川","かわ"],["の"],["水","みず"],["が"],["飲めなかった","のめなかった"],["ので"],["、"],["飲む","のむ"],["水","みず"],["を"],["得よう","えよう"],["と"],["、"],["川","かわ"],["の"],["まわり"],["を"],["掘った","ほった"],["。"]]},{"verse":25,"text":"主,しゅがナイル川,かわを打,うたれてのち七日,なぬかを経,へた。","tok":[["主","しゅ"],["が"],["ナイル"],["川","かわ"],["を"],["打たれて","うたれて"],["のち"],["七","しち"],["日","にち"],["を"],["経た","へた"],["。"]]},{"verse":26,"text":"[8:1]主,しゅはモーセに言,いわれた、「あなたはパロのところに行,いって言,いいなさい、『主,しゅはこう仰,おおせられます、「わたしの民,たみを去,さらせて、わたしに仕,つかえさせなさい。","tok":[["["],["8"],[":"],["1"],["]"],["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["は"],["パロ"],["の"],["ところ"],["に"],["行って","いって"],["言い","いい"],["なさい"],["、"],["『"],["主","しゅ"],["は"],["こう"],["仰せられます","おおせられます"],["、"],["「"],["わたし"],["の"],["民","たみ"],["を"],["去らせて","さらせて"],["、"],["わたし"],["に"],["仕えさせ","つかえさせ"],["なさい"],["。"]]},{"verse":27,"text":"[8:2]しかし、去,さらせることを拒,こばむならば、見,みよ、わたしは、かえるをもって、あなたの領土,りょうどを、ことごとく撃,うつであろう。","tok":[["["],["8"],[":"],["2"],["]"],["しかし"],["、"],["去らせる","さらせる"],["こと"],["を"],["拒むならば","こばむならば"],["、"],["見よ","みよ"],["、"],["わたし"],["は"],["、"],["かえる"],["を"],["もって"],["、"],["あなた"],["の"],["領土","りょうど"],["を"],["、"],["ことごとく"],["撃つで","うつで"],["あろう"],["。"]]},{"verse":28,"text":"[8:3]ナイル川,かわにかえるが群,むらがり、のぼって、あなたの家,いえ、あなたの寝室,しんしつにはいり、寝台,しんだいにのぼり、あなたの家来,けらいと民,たみの家,いえにはいり、またあなたのかまどや、こね鉢,はちにはいり、","tok":[["["],["8"],[":"],["3"],["]"],["ナイル"],["川","かわ"],["に"],["かえる"],["が"],["群らがり","むらがり"],["、"],["のぼって"],["、"],["あなた"],["の"],["家","いえ"],["、"],["あなた"],["の"],["寝室","しんしつ"],["に"],["はいり"],["、"],["寝台","しんだい"],["に"],["のぼり"],["、"],["あなた"],["の"],["家来","けらい"],["と"],["民","たみ"],["の"],["家","いえ"],["に"],["はいり"],["、"],["また"],["あなた"],["の"],["かまど"],["や"],["、"],["こね鉢","こねはち"],["に"],["はいり"],["、"]]},{"verse":29,"text":"[8:4]あなたと、あなたの民,たみと、すべての家来,けらいのからだに、はい上,あがるであろう」と』」。","tok":[["["],["8"],[":"],["4"],["]"],["あなた"],["と"],["、"],["あなた"],["の"],["民","たみ"],["と"],["、"],["すべて"],["の"],["家来","けらい"],["の"],["からだ"],["に"],["、"],["はい上がるで","はいあがるで"],["あろう"],["」"],["と"],["』"],["」"],["。"]]}]
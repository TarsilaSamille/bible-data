[{"verse":1,"text":"主,しゅはモーセに言,いわれた。","tok":[["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["。"]]},{"verse":2,"text":"「正月,しょうがつの元日,がんじつにあなたは会見,かいけんの天幕,てんまくなる幕屋,まくやを建,たてなければならない。","tok":[["「"],["正月","しょうがつ"],["の"],["元日","がんじつ"],["に"],["あなた"],["は"],["会見","かいけん"],["の"],["天幕","てんまく"],["なる"],["幕屋","まくや"],["を"],["建てなければ","たてなければ"],["ならない"],["。"]]},{"verse":3,"text":"そして、その中,なかにあかしの箱,はこを置,おき、垂幕,たれまくで、箱,はこを隔,へだて隠,かくし、","tok":[["そして"],["、"],["その"],["中","なか"],["に"],["あかし"],["の"],["箱","はこ"],["を"],["置き","おき"],["、"],["垂幕","たれまく"],["で"],["、"],["箱","はこ"],["を"],["隔て","へだて"],["隠し","かくし"],["、"]]},{"verse":4,"text":"また、机,つくえを携,たずさえ入,いれ、それに並,ならべるものを並,ならべ、燭台,しょくだいを携,たずさえ入,いれて、そのともしびをともさなければならない。","tok":[["また"],["、"],["机","つくえ"],["を"],["携え","たずさえ"],["入れ","いれ"],["、"],["それ"],["に"],["並べる","ならべる"],["もの"],["を"],["並べ","ならべ"],["、"],["燭台","しょくだい"],["を"],["携え","たずさえ"],["入れて","いれて"],["、"],["その"],["ともしび"],["を"],["ともさなければ"],["ならない"],["。"]]},{"verse":5,"text":"あなたはまた金,きんの香,こうの祭壇,さいだんを、あかしの箱,はこの前,まえにすえ、とばりを幕屋,まくやの入口,いりぐちにかけなければならない。","tok":[["あなた"],["は"],["また"],["金","きん"],["の"],["香","こう"],["の"],["祭壇","さいだん"],["を"],["、"],["あかし"],["の"],["箱","はこ"],["の"],["前","まえ"],["に"],["すえ"],["、"],["とばり"],["を"],["幕屋","まくや"],["の"],["入口","いりぐち"],["に"],["かけなければ"],["ならない"],["。"]]},{"verse":6,"text":"また燔祭,はんさいの祭壇,さいだんを会見,かいけんの天幕,てんまくなる幕屋,まくやの入口,いりぐちの前,まえにすえ、","tok":[["また"],["燔祭","はんさい"],["の"],["祭壇","さいだん"],["を"],["会見","かいけん"],["の"],["天幕","てんまく"],["なる"],["幕屋","まくや"],["の"],["入口","いりぐち"],["の"],["前","まえ"],["に"],["すえ"],["、"]]},{"verse":7,"text":"洗盤,せんばんを会見,かいけんの天幕,てんまくと祭壇,さいだんとの間,あいだにすえて、これに水,みずを入,いれなければならない。","tok":[["洗","あらい"],["盤","ばん"],["を"],["会見","かいけん"],["の"],["天幕","てんまく"],["と"],["祭壇","さいだん"],["と"],["の"],["間","あいだ"],["に"],["すえて"],["、"],["これ"],["に"],["水","みず"],["を"],["入れなければ","いれなければ"],["ならない"],["。"]]},{"verse":8,"text":"また周囲,しゅういに庭,にわを設,もうけ、庭,にわの門,もんにとばりをかけなければならない。","tok":[["また"],["周囲","しゅうい"],["に"],["庭","にわ"],["を"],["設け","もうけ"],["、"],["庭","にわ"],["の"],["門","もん"],["に"],["とばり"],["を"],["かけなければ"],["ならない"],["。"]]},{"verse":9,"text":"そして注,そそぎ油,あぶらをとって、幕屋,まくやとその中,なかのすべてのものに注,そそぎ、それとそのもろもろの器,うつわとを聖別,せいべつしなければならない、こうして、それは聖,せいとなるであろう。","tok":[["そして"],["注ぎ","そそぎ"],["油","あぶら"],["を"],["とって"],["、"],["幕屋","まくや"],["と"],["その"],["中","なか"],["の"],["すべて"],["の"],["もの"],["に"],["注ぎ","そそぎ"],["、"],["それ"],["と"],["その"],["もろもろ"],["の"],["器","うつわ"],["と"],["を"],["聖別","せいべつ"],["しなければ"],["ならない"],["、"],["こう"],["して"],["、"],["それ"],["は"],["聖","せい"],["と"],["なるで"],["あろう"],["。"]]},{"verse":10,"text":"あなたはまた燔祭,はんさいの祭壇,さいだんと、そのすべての器,うつわに油,あぶらを注,そそいで、その祭壇,さいだんを聖別,せいべつしなければならない。こうして祭壇,さいだんは、いと聖,せいなるものとなるであろう。","tok":[["あなた"],["は"],["また"],["燔祭","はんさい"],["の"],["祭壇","さいだん"],["と"],["、"],["その"],["すべて"],["の"],["器","うつわ"],["に"],["油","あぶら"],["を"],["注いで","そそいで"],["、"],["その"],["祭壇","さいだん"],["を"],["聖別","せいべつ"],["しなければ"],["ならない"],["。"],["こう"],["して"],["祭壇","さいだん"],["は"],["、"],["いと"],["聖","せい"],["なる"],["もの"],["と"],["なるで"],["あろう"],["。"]]},{"verse":11,"text":"また洗盤,せんばんと、その台,だいとに油,あぶらを注,そそいで、これを聖別,せいべつし、","tok":[["また"],["洗","あらい"],["盤","ばん"],["と"],["、"],["その"],["台","だい"],["と"],["に"],["油","あぶら"],["を"],["注いで","そそいで"],["、"],["これ"],["を"],["聖別","せいべつ"],["し"],["、"]]},{"verse":12,"text":"アロンとその子,こたちを会見,かいけんの幕屋,まくやの入口,いりぐちに連,つれてきて、水,みずで彼,かれらを洗,あらい、","tok":[["アロン"],["と"],["その"],["子","こ"],["たち"],["を"],["会見","かいけん"],["の"],["幕屋","まくや"],["の"],["入口","いりぐち"],["に"],["連れて","つれて"],["きて"],["、"],["水","みず"],["で"],["彼","かれ"],["ら"],["を"],["洗","あらい"],["、"]]},{"verse":13,"text":"アロンに聖,せいなる服,ふくを着,きせ、これに油,あぶらを注,そそいで聖別,せいべつし、祭司,さいしの務,つとめをさせなければならない。","tok":[["アロン"],["に"],["聖","せい"],["なる"],["服","ふく"],["を"],["着せ","きせ"],["、"],["これ"],["に"],["油","あぶら"],["を"],["注いで","そそいで"],["聖別","せいべつ"],["し"],["、"],["祭司","さいし"],["の"],["務め","つとめ"],["を"],["させなければ"],["ならない"],["。"]]},{"verse":14,"text":"また彼,かれの子,こたちを連,つれてきて、これに服,ふくを着,きせ、","tok":[["また"],["彼","かれ"],["の"],["子","こ"],["たち"],["を"],["連れて","つれて"],["きて"],["、"],["これ"],["に"],["服","ふく"],["を"],["着せ","きせ"],["、"]]},{"verse":15,"text":"その父,ちちに油,あぶらを注,そそいだように、彼,かれらにも油,あぶらを注,そそいで、祭司,さいしの務,つとめをさせなければならない。彼,かれらが油,あぶらそそがれることは、代々,よよながく祭司,さいし職,しょくのためになすべきことである」。","tok":[["その"],["父","ちち"],["に"],["油","あぶら"],["を"],["注いだ","そそいだ"],["よう"],["に"],["、"],["彼","かれ"],["ら"],["に"],["も"],["油","あぶら"],["を"],["注いで","そそいで"],["、"],["祭司","さいし"],["の"],["務め","つとめ"],["を"],["させなければ"],["ならない"],["。"],["彼","かれ"],["ら"],["が"],["油","あぶら"],["そそがれる"],["こと"],["は"],["、"],["代々","よ"],["よ"],["ながく"],["祭司","さいし"],["職","しょく"],["の"],["ため"],["に"],["なすべき"],["こと"],["で"],["ある"],["」"],["。"]]},{"verse":16,"text":"モーセはそのように行,おこなった。すなわち主,しゅが彼,かれに命,めいじられたように行,おこなった。","tok":[["モーセ"],["は"],["その"],["よう"],["に"],["行なった","おこなった"],["。"],["すなわち"],["主","しゅ"],["が"],["彼","かれ"],["に"],["命じられた","めいじられた"],["よう"],["に"],["行なった","おこなった"],["。"]]},{"verse":17,"text":"第,だい二年,ねんの正月,しょうがつになって、その月,つきの元日,がんじつに幕屋,まくやは建,たった。","tok":[["第","だい"],["二","に"],["年","ねん"],["の"],["正月","しょうがつ"],["に"],["なって"],["、"],["その"],["月","つき"],["の"],["元日","がんじつ"],["に"],["幕屋","まくや"],["は"],["建った","たった"],["。"]]},{"verse":18,"text":"すなわちモーセは幕屋,まくやを建,たて、その座,ざをすえ、その枠,わくを立,たて、その横木,よこぎをさし込,こみ、その柱,はしらを立,たて、","tok":[["すなわち"],["モーセ"],["は"],["幕屋","まくや"],["を"],["建て","たて"],["、"],["その"],["座","ざ"],["を"],["すえ"],["、"],["その"],["枠","わく"],["を"],["立て","たて"],["、"],["その"],["横木","よこぎ"],["を"],["さし"],["込","こみ"],["、"],["その"],["柱","はしら"],["を"],["立て","たて"],["、"]]},{"verse":19,"text":"幕屋,まくやの上,うえに天幕,てんまくをひろげ、その上,うえに天幕,てんまくのおおいをかけた。主,しゅがモーセに命,めいじられたとおりである。","tok":[["幕屋","まくや"],["の"],["上","うえ"],["に"],["天幕","てんまく"],["を"],["ひろげ"],["、"],["その"],["上","うえ"],["に"],["天幕","てんまく"],["の"],["おおい"],["を"],["かけた"],["。"],["主","しゅ"],["が"],["モーセ"],["に"],["命じられた","めいじられた"],["とおり"],["で"],["ある"],["。"]]},{"verse":20,"text":"彼,かれはまたあかしの板,いたをとって箱,はこに納,おさめ、さおを箱,はこにつけ、贖罪所,しょくざいしょを箱,はこの上,うえに置,おき、","tok":[["彼","かれ"],["は"],["また"],["あかし"],["の"],["板","いた"],["を"],["とって"],["箱","はこ"],["に"],["納","おさめ"],["、"],["さお"],["を"],["箱","は"],["こ"],["に"],["つけ"],["、"],["贖罪所","しょくざいしょ"],["を"],["箱","はこ"],["の"],["上","うえ"],["に"],["置き","おき"],["、"]]},{"verse":21,"text":"箱,はこを幕屋,まくやに携,たずさえ入,いれ、隔,へだての垂幕,たれまくをかけて、あかしの箱,はこを隠,かくした。主,しゅがモーセに命,めいじられたとおりである。","tok":[["箱","はこ"],["を"],["幕屋","まくや"],["に"],["携え","たずさえ"],["入れ","いれ"],["、"],["隔て","へだて"],["の"],["垂幕","たれまく"],["を"],["かけて"],["、"],["あかし"],["の"],["箱","はこ"],["を"],["隠した","かくした"],["。"],["主","しゅ"],["が"],["モーセ"],["に"],["命じられた","めいじられた"],["とおり"],["で"],["ある"],["。"]]},{"verse":22,"text":"彼,かれはまた会見,かいけんの天幕,てんまくなる幕屋,まくやの内部,ないぶの北側,きたがわ、垂幕,たれまくの外,そとに机,つくえをすえ、","tok":[["彼","かれ"],["は"],["また"],["会見","かいけん"],["の"],["天幕","てんまく"],["なる"],["幕屋","まくや"],["の"],["内部","ないぶ"],["の"],["北側","きたがわ"],["、"],["垂幕","たれまく"],["の"],["外","そと"],["に"],["机","つくえ"],["を"],["すえ"],["、"]]},{"verse":23,"text":"その上,うえにパンを列,れつに並,ならべて、主,しゅの前,まえに供,そなえた。主,しゅがモーセに命,めいじられたとおりである。","tok":[["その"],["上","うえ"],["に"],["パン"],["を"],["列","れつ"],["に"],["並べて","ならべて"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["供えた","そなえた"],["。"],["主","しゅ"],["が"],["モーセ"],["に"],["命じられた","めいじられた"],["とおり"],["で"],["ある"],["。"]]},{"verse":24,"text":"彼,かれはまた会見,かいけんの天幕,てんまくなる幕屋,まくやの内部,ないぶの南側,みなみがわに、机,つくえにむかい合,あわせて燭台,しょくだいをすえ、","tok":[["彼","かれ"],["は"],["また"],["会見","かいけん"],["の"],["天幕","てんまく"],["なる"],["幕屋","まくや"],["の"],["内部","ないぶ"],["の"],["南側","みなみがわ"],["に"],["、"],["机","つくえ"],["に"],["むかい"],["合","あわせ"],["て"],["燭台","しょくだい"],["を"],["すえ"],["、"]]},{"verse":25,"text":"主,しゅの前,まえにともしびをともした。主,しゅがモーセに命,めいじられたとおりである。","tok":[["主","しゅ"],["の"],["前","まえ"],["に"],["ともしび"],["を"],["ともした"],["。"],["主","しゅ"],["が"],["モーセ"],["に"],["命じられた","めいじられた"],["とおり"],["で"],["ある"],["。"]]},{"verse":26,"text":"彼,かれは会見,かいけんの幕屋,まくやの中,なか、垂幕,たれまくの前,まえに金,きんの祭壇,さいだんをすえ、","tok":[["彼","かれ"],["は"],["会見","かいけん"],["の"],["幕屋","まくや"],["の"],["中","なか"],["、"],["垂幕","たれまく"],["の"],["前","まえ"],["に"],["金","きん"],["の"],["祭壇","さいだん"],["を"],["すえ"],["、"]]},{"verse":27,"text":"その上,うえに香,こうばしい薫香,くんこうをたいた。主,しゅがモーセに命,めいじられたとおりである。","tok":[["その"],["上","うえ"],["に"],["香ばしい","こうばしい"],["薫香","くんこう"],["を"],["たいた"],["。"],["主","しゅ"],["が"],["モーセ"],["に"],["命じられた","めいじられた"],["とおり"],["で"],["ある"],["。"]]},{"verse":28,"text":"彼,かれはまた幕屋,まくやの入口,いりぐちにとばりをかけ、","tok":[["彼","かれ"],["は"],["また"],["幕屋","まくや"],["の"],["入口","いりぐち"],["に"],["とばり"],["を"],["かけ"],["、"]]},{"verse":29,"text":"燔祭,はんさいの祭壇,さいだんを会見,かいけんの天幕,てんまくなる幕屋,まくやの入口,いりぐちにすえ、その上,うえに燔祭,はんさいと素祭,そさいをささげた。主,しゅがモーセに命,めいじられたとおりである。","tok":[["燔祭","はんさい"],["の"],["祭壇","さいだん"],["を"],["会見","かいけん"],["の"],["天幕","てんまく"],["なる"],["幕屋","まくや"],["の"],["入口","いりぐち"],["に"],["すえ"],["、"],["その"],["上","うえ"],["に"],["燔祭","はんさい"],["と"],["素","す"],["祭","まつり"],["を"],["ささげた"],["。"],["主","しゅ"],["が"],["モーセ"],["に"],["命じられた","めいじられた"],["とおり"],["で"],["ある"],["。"]]},{"verse":30,"text":"彼,かれはまた会見,かいけんの天幕,てんまくと祭壇,さいだんとの間,あいだに洗盤,せんばんを置,おき、洗,あらうためにそれに水,みずを入,いれた。","tok":[["彼","かれ"],["は"],["また"],["会見","かいけん"],["の"],["天幕","てんまく"],["と"],["祭壇","さいだん"],["と"],["の"],["間","あいだ"],["に"],["洗","あらい"],["盤","ばん"],["を"],["置き","おき"],["、"],["洗う","あらう"],["ため"],["に"],["それ"],["に"],["水","みず"],["を"],["入れた","いれた"],["。"]]},{"verse":31,"text":"モーセとアロンおよびその子,こたちは、それで手,てと足,あしを洗,あらった。","tok":[["モーセ"],["と"],["アロン"],["および"],["その"],["子","こ"],["たち"],["は"],["、"],["それ"],["で"],["手","て"],["と"],["足","あし"],["を"],["洗った","あらった"],["。"]]},{"verse":32,"text":"すなわち会見,かいけんの天幕,てんまくにはいるとき、また祭壇,さいだんに近,ちかづくとき、そこで洗,あらった。主,しゅがモーセに命,めいじられたとおりである。","tok":[["すなわち"],["会見","かいけん"],["の"],["天幕","てんまく"],["に"],["は"],["いる"],["とき"],["、"],["また"],["祭壇","さいだん"],["に"],["近づく","ちかづく"],["とき"],["、"],["そこ"],["で"],["洗った","あらった"],["。"],["主","しゅ"],["が"],["モーセ"],["に"],["命じられた","めいじられた"],["とおり"],["で"],["ある"],["。"]]},{"verse":33,"text":"また幕屋,まくやと祭壇,さいだんの周囲,しゅういに庭,にわを設,もうけ、庭,にわの門,もんにとばりをかけた。このようにしてモーセはその工事,こうじを終,おえた。","tok":[["また"],["幕屋","まくや"],["と"],["祭壇","さいだん"],["の"],["周囲","しゅうい"],["に"],["庭","にわ"],["を"],["設け","もうけ"],["、"],["庭","にわ"],["の"],["門","もん"],["に"],["とばり"],["を"],["かけた"],["。"],["この"],["よう"],["に"],["して"],["モーセ"],["は"],["その"],["工事","こうじ"],["を"],["終えた","おえた"],["。"]]},{"verse":34,"text":"そのとき、雲,くもは会見,かいけんの天幕,てんまくをおおい、主,しゅの栄光,えいこうが幕屋,まくやに満,みちた。","tok":[["その"],["とき"],["、"],["雲","くも"],["は"],["会見","かいけん"],["の"],["天幕","てんまく"],["を"],["おおい"],["、"],["主","しゅ"],["の"],["栄光","えいこう"],["が"],["幕屋","まくや"],["に"],["満ちた","みちた"],["。"]]},{"verse":35,"text":"モーセは会見,かいけんの幕屋,まくやに、はいることができなかった。雲,くもがその上,うえにとどまり、主,しゅの栄光,えいこうが幕屋,まくやに満,みちていたからである。","tok":[["モーセ"],["は"],["会見","かいけん"],["の"],["幕屋","まくや"],["に"],["、"],["はいる"],["こと"],["が"],["できなかった"],["。"],["雲","くも"],["が"],["その"],["上","うえ"],["に"],["とどまり"],["、"],["主","しゅ"],["の"],["栄光","えいこう"],["が"],["幕屋","まくや"],["に"],["満ちて","みちて"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":36,"text":"雲,くもが幕屋,まくやの上,うえからのぼる時,とき、イスラエルの人々,ひとびとは道,みちに進,すすんだ。彼,かれらはその旅路,たびじにおいて常,つねにそうした。","tok":[["雲","くも"],["が"],["幕屋","まくや"],["の"],["上","うえ"],["から"],["のぼる"],["時","とき"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["道","みち"],["に"],["進んだ","すすんだ"],["。"],["彼","かれ"],["ら"],["は"],["その"],["旅路","たびじ"],["に"],["おいて"],["常","つね"],["に"],["そう"],["した"],["。"]]},{"verse":37,"text":"しかし、雲,くもがのぼらない時,ときは、そののぼる日,ひまで道,みちに進,すすまなかった。","tok":[["しかし"],["、"],["雲","くも"],["が"],["のぼらない"],["時","とき"],["は"],["、"],["その"],["のぼる"],["日","ひ"],["まで"],["道","みち"],["に"],["進まなかった","すすまなかった"],["。"]]},{"verse":38,"text":"すなわちイスラエルの家,いえのすべての者,ものの前,まえに、昼,ひるは幕屋,まくやの上,うえに主,しゅの雲,くもがあり、夜,よるは雲,くもの中,なかに火,ひがあった。彼,かれらの旅路,たびじにおいて常,つねにそうであった。","tok":[["すなわち"],["イスラエル"],["の"],["家","いえ"],["の"],["すべて"],["の"],["者","もの"],["の"],["前","まえ"],["に"],["、"],["昼","ひる"],["は"],["幕屋","まくや"],["の"],["上","うえ"],["に"],["主","しゅ"],["の"],["雲","くも"],["が"],["あり"],["、"],["夜","よる"],["は"],["雲","くも"],["の"],["中","なか"],["に"],["火","ひ"],["が"],["あった"],["。"],["彼","かれ"],["ら"],["の"],["旅路","たびじ"],["に"],["おいて"],["常","つね"],["に"],["そう"],["で"],["あった"],["。"]]}]
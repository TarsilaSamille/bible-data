[{"verse":1,"text":"モーセは言,いった、「しかし、彼,かれらはわたしを信,しんぜず、またわたしの声,こえに聞,きき従,したがわないで言,いうでしょう、『主,しゅはあなたに現,あらわれなかった』と」。","tok":[["モーセ"],["は"],["言った","いった"],["、"],["「"],["しかし"],["、"],["彼","かれ"],["ら"],["は"],["わたし"],["を"],["信ぜず","しんぜず"],["、"],["また"],["わたし"],["の"],["声","こえ"],["に"],["聞","きき"],["従わないで","したがわないで"],["言うでしょう","いうでしょう"],["、"],["『"],["主","しゅ"],["は"],["あなた"],["に"],["現われなかった","あらわれなかった"],["』"],["と"],["」"],["。"]]},{"verse":2,"text":"主,しゅは彼,かれに言,いわれた、「あなたの手,てにあるそれは何,なにか」。彼,かれは言,いった、「つえです」。","tok":[["主","しゅ"],["は"],["彼","かれ"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["の"],["手","て"],["に"],["ある"],["それ"],["は"],["何に","なに"],["か"],["」"],["。"],["彼","かれ"],["は"],["言った","いった"],["、"],["「"],["つえ"],["です"],["」"],["。"]]},{"verse":3,"text":"また言,いわれた、「それを地,ちに投,なげなさい」。彼,かれがそれを地,ちに投,なげると、へびになったので、モーセはその前,まえから身,みを避,さけた。","tok":[["また"],["言われた","いわれた"],["、"],["「"],["それ"],["を"],["地","ち"],["に"],["投","なげ"],["なさい"],["」"],["。"],["彼","かれ"],["が"],["それ"],["を"],["地","ち"],["に"],["投る","なげる"],["と"],["、"],["へび"],["に"],["なった"],["ので"],["、"],["モーセ"],["は"],["その"],["前","まえ"],["から"],["身","み"],["を"],["避けた","さけた"],["。"]]},{"verse":4,"text":"主,しゅはモーセに言,いわれた、「あなたの手,てを伸,のばして、その尾,おを取,とりなさい。――そこで手,てを伸,のばしてそれを取,とると、手,てのなかでつえとなった。――","tok":[["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["の"],["手","て"],["を"],["伸ばして","のばして"],["、"],["その"],["尾","お"],["を"],["取","とり"],["なさい"],["。"],["―"],["―"],["そこ"],["で"],["手","て"],["を"],["伸ばして","のばして"],["それ"],["を"],["取る","とる"],["と"],["、"],["手","て"],["の"],["なか"],["で"],["つえ"],["と"],["なった"],["。"],["―"],["―"]]},{"verse":5,"text":"これは、彼,かれらの先祖,せんぞたちの神,かみ、アブラハムの神,かみ、イサクの神,かみ、ヤコブの神,かみである主,しゅが、あなたに現,あらわれたのを、彼,かれらに信,しんじさせるためである」。","tok":[["これ"],["は"],["、"],["彼","かれ"],["ら"],["の"],["先祖","せんぞ"],["たち"],["の"],["神","かみ"],["、"],["アブラハム"],["の"],["神","かみ"],["、"],["イサク"],["の"],["神","かみ"],["、"],["ヤコブ"],["の"],["神","かみ"],["で"],["ある"],["主","しゅ"],["が"],["、"],["あなた"],["に"],["現われた","あらわれた"],["の"],["を"],["、"],["彼","かれ"],["ら"],["に"],["信じさせる","しんじさせる"],["ため"],["で"],["ある"],["」"],["。"]]},{"verse":6,"text":"主,しゅはまた彼,かれに言,いわれた、「あなたの手,てをふところに入,いれなさい」。彼,かれが手,てをふところに入,いれ、それを出,だすと、手,ては、らい病,びょうにかかって、雪,ゆきのように白,しろくなっていた。","tok":[["主","しゅ"],["は"],["また"],["彼","かれ"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["の"],["手","て"],["を"],["ふところ"],["に"],["入れ","いれ"],["なさい"],["」"],["。"],["彼","かれ"],["が"],["手","て"],["を"],["ふところ"],["に"],["入れ","いれ"],["、"],["それ"],["を"],["出す","だす"],["と"],["、"],["手","て"],["は"],["、"],["らい病","らいびょう"],["に"],["かかって"],["、"],["雪","ゆき"],["の"],["よう"],["に"],["白く","しろく"],["なって"],["いた"],["。"]]},{"verse":7,"text":"主,しゅは言,いわれた、「手,てをふところにもどしなさい」。彼,かれは手,てをふところにもどし、それをふところから出,だして見,みると、回復,かいふくして、もとの肉,にくのようになっていた。","tok":[["主","しゅ"],["は"],["言われた","いわれた"],["、"],["「"],["手","て"],["を"],["ふところ"],["に"],["もどし"],["なさい"],["」"],["。"],["彼","かれ"],["は"],["手","て"],["を"],["ふところ"],["に"],["もどし"],["、"],["それ"],["を"],["ふところ"],["から"],["出して","だして"],["見る","みる"],["と"],["、"],["回復","かいふく"],["して"],["、"],["もと"],["の"],["肉","にく"],["の"],["よう"],["に"],["なって"],["いた"],["。"]]},{"verse":8,"text":"主,しゅは言,いわれた、「彼,かれらがもしあなたを信,しんぜず、また初,はじめのしるしを認,みとめないならば、後,のちのしるしは信,しんじるであろう。","tok":[["主","しゅ"],["は"],["言われた","いわれた"],["、"],["「"],["彼","かれ"],["ら"],["が"],["もし"],["あなた"],["を"],["信ぜず","しんぜず"],["、"],["また"],["初め","はじめ"],["の"],["しるし"],["を"],["認めないならば","みとめないならば"],["、"],["後","のち"],["の"],["しるし"],["は"],["信じるで","しんじるで"],["あろう"],["。"]]},{"verse":9,"text":"彼,かれらがもしこの二つのしるしをも信,しんぜず、あなたの声,こえに聞,きき従,したがわないならば、あなたはナイル川,かわの水,みずを取,とって、かわいた地,ちに注,そそぎなさい。あなたがナイル川,かわから取,とった水,みずは、かわいた地,ちで血,ちとなるであろう」。","tok":[["彼","かれ"],["ら"],["が"],["もし"],["この"],["二","ふた"],["つ"],["の"],["しるし"],["を"],["も"],["信ぜず","しんぜず"],["、"],["あなた"],["の"],["声","こえ"],["に"],["聞","きき"],["従わないならば","したがわないならば"],["、"],["あなた"],["は"],["ナイル"],["川","かわ"],["の"],["水","みず"],["を"],["取って","とって"],["、"],["かわいた"],["地","ち"],["に"],["注ぎ","そそぎ"],["なさい"],["。"],["あなた"],["が"],["ナイル"],["川","かわ"],["から"],["取った","とった"],["水","みず"],["は"],["、"],["かわいた"],["地","ち"],["で"],["血","ち"],["と"],["なるで"],["あろう"],["」"],["。"]]},{"verse":10,"text":"モーセは主,しゅに言,いった、「ああ主,しゅよ、わたしは以前,いぜんにも、またあなたが、しもべに語,かたられてから後,のちも、言葉,ことばの人,ひとではありません。わたしは口,くちも重,おもく、舌,したも重,おもいのです」。","tok":[["モーセ"],["は"],["主に","しゅに"],["言った","いった"],["、"],["「"],["ああ"],["主","しゅ"],["よ"],["、"],["わたし"],["は"],["以前","いぜん"],["に"],["も"],["、"],["また"],["あなた"],["が"],["、"],["しもべ"],["に"],["語られて","かたられて"],["から"],["後","のち"],["も"],["、"],["言葉","ことば"],["の"],["人","ひと"],["で"],["は"],["ありません"],["。"],["わたし"],["は"],["口","くち"],["も"],["重く","おもく"],["、"],["舌","した"],["も"],["重い","おもい"],["の"],["です"],["」"],["。"]]},{"verse":11,"text":"主,しゅは彼,かれに言,いわれた、「だれが人,ひとに口,くちを授,さづけたのか。おし、耳,みみしい、目,めあき、目,めしいにだれがするのか。主,しゅなるわたしではないか。","tok":[["主","しゅ"],["は"],["彼","かれ"],["に"],["言われた","いわれた"],["、"],["「"],["だれ"],["が"],["人","ひと"],["に"],["口","くち"],["を"],["授","さづけた"],["の"],["か"],["。"],["おし"],["、"],["耳","みみ"],["しい"],["、"],["目あき","めあき"],["、"],["目","め"],["しい"],["に"],["だれ"],["が"],["する"],["の"],["か"],["。"],["主","しゅ"],["なる"],["わたし"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":12,"text":"それゆえ行,いきなさい。わたしはあなたの口,くちと共,ともにあって、あなたの言,いうべきことを教,おしえるであろう」。","tok":[["それ"],["ゆえ"],["行き","いき"],["なさい"],["。"],["わたし"],["は"],["あなた"],["の"],["口","くち"],["と"],["共","とも"],["に"],["あって"],["、"],["あなた"],["の"],["言","いうべきこ"],["と"],["を"],["教えるで","おしえるで"],["あろう"],["」"],["。"]]},{"verse":13,"text":"モーセは言,いった、「ああ、主,しゅよ、どうか、ほかの適当,てきとうな人,ひとをおつかわしください」。","tok":[["モーセ"],["は"],["言った","いった"],["、"],["「"],["ああ"],["、"],["主","しゅ"],["よ"],["、"],["どう"],["か"],["、"],["ほか"],["の"],["適当","てきとう"],["な"],["人","ひと"],["を"],["おつかわし"],["ください"],["」"],["。"]]},{"verse":14,"text":"そこで、主,しゅはモーセにむかって怒,いかりを発,はっして言,いわれた、「あなたの兄弟,きょうだいレビびとアロンがいるではないか。わたしは彼,かれが言葉,ことばにすぐれているのを知,しっている。見,みよ、彼,かれはあなたに会,あおうとして出,でてきている。彼,かれはあなたを見,みて心,こころに喜,よろこぶであろう。","tok":[["そこ"],["で"],["、"],["主","しゅ"],["は"],["モーセ"],["に"],["むかって"],["怒り","いかり"],["を"],["発して","はっして"],["言われた","いわれた"],["、"],["「"],["あなた"],["の"],["兄弟","きょうだい"],["レビ"],["び"],["と"],["アロン"],["が"],["いるで"],["は"],["ない"],["か"],["。"],["わたし"],["は"],["彼","かれ"],["が"],["言葉","ことば"],["に"],["すぐれて"],["いる"],["の"],["を"],["知って","しって"],["いる"],["。"],["見よ","みよ"],["、"],["彼","かれ"],["は"],["あなた"],["に"],["会おう","あおう"],["として"],["出て","でて"],["きて"],["いる"],["。"],["彼","かれ"],["は"],["あなた"],["を"],["見て","みて"],["心","こころ"],["に"],["喜こぶで","よろこぶで"],["あろう"],["。"]]},{"verse":15,"text":"あなたは彼,かれに語,かたって言葉,ことばをその口,くちに授,さづけなさい。わたしはあなたの口,くちと共,ともにあり、彼,かれの口,くちと共,ともにあって、あなたがたのなすべきことを教,おしえ、","tok":[["あなた"],["は"],["彼","かれ"],["に"],["語って","かたって"],["言葉","ことば"],["を"],["その"],["口","くち"],["に"],["授","さ"],["づけ"],["なさい"],["。"],["わたし"],["は"],["あなた"],["の"],["口","くち"],["と"],["共","とも"],["に"],["あり"],["、"],["彼","かれ"],["の"],["口","くち"],["と"],["共","とも"],["に"],["あって"],["、"],["あなた"],["がた"],["の"],["なすべき"],["こと"],["を"],["教え","おしえ"],["、"]]},{"verse":16,"text":"彼,かれはあなたに代,かわって民,たみに語,かたるであろう。彼,かれはあなたの口,くちとなり、あなたは彼,かれのために、神,かみに代,かわるであろう。","tok":[["彼","かれ"],["は"],["あなた"],["に"],["代わって","かわって"],["民","たみ"],["に"],["語るで","かたるで"],["あろう"],["。"],["彼","かれ"],["は"],["あなた"],["の"],["口","くち"],["と"],["なり"],["、"],["あなた"],["は"],["彼","かれ"],["の"],["ため"],["に"],["、"],["神","かみ"],["に"],["代わるで","かわるで"],["あろう"],["。"]]},{"verse":17,"text":"あなたはそのつえを手,てに執,とり、それをもって、しるしを行,おこないなさい」。","tok":[["あなた"],["は"],["その"],["つえ"],["を"],["手","て"],["に"],["執り","とり"],["、"],["それ"],["を"],["もって"],["、"],["しるし"],["を"],["行ない","おこない"],["なさい"],["」"],["。"]]},{"verse":18,"text":"モーセは妻,つまの父,ちちエテロのところに帰,かえって彼,かれに言,いった、「どうかわたしを、エジプトにいる身,みうちの者,もののところに帰,かえらせ、彼,かれらがまだ生,いきながらえているか、どうかを見,みさせてください」。エテロはモーセに言,いった、「安,やすんじて行,いきなさい」。","tok":[["モーセ"],["は"],["妻","つま"],["の"],["父","ちち"],["エテロ"],["の"],["ところ"],["に"],["帰えって","かえって"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["どう"],["か"],["わたし"],["を"],["、"],["エジプト"],["に"],["いる"],["身うち","みうち"],["の"],["者","もの"],["の"],["ところ"],["に"],["帰えらせ","かえらせ"],["、"],["彼","かれ"],["ら"],["が"],["まだ"],["生きながらえて","いきながらえて"],["いる"],["か"],["、"],["どう"],["か"],["を"],["見させて","みさせて"],["ください"],["」"],["。"],["エテロ"],["は"],["モーセ"],["に"],["言った","いった"],["、"],["「"],["安","や"],["すんじて"],["行き","いき"],["なさい"],["」"],["。"]]},{"verse":19,"text":"主,しゅはミデヤンでモーセに言,いわれた、「エジプトに帰,かえって行,いきなさい。あなたの命,いのちを求,もとめた人々,ひとびとはみな死,しんだ」。","tok":[["主","しゅ"],["は"],["ミデヤン"],["で"],["モーセ"],["に"],["言われた","いわれた"],["、"],["「"],["エジプト"],["に"],["帰えって","かえって"],["行き","いき"],["なさい"],["。"],["あなた"],["の"],["命","いのち"],["を"],["求めた","もとめた"],["人々","ひとびと"],["は"],["みな"],["死んだ","しんだ"],["」"],["。"]]},{"verse":20,"text":"そこでモーセは妻,つまと子供,こどもたちをとり、ろばに乗,のせて、エジプトの地,ちに帰,かえった。モーセは手,てに神,かみのつえを執,とった。","tok":[["そこ"],["で"],["モーセ"],["は"],["妻","つま"],["と"],["子供","こども"],["たち"],["を"],["とり"],["、"],["ろば"],["に"],["乗せて","のせて"],["、"],["エジプト"],["の"],["地","ち"],["に"],["帰えった","かえった"],["。"],["モーセ"],["は"],["手","て"],["に"],["神","かみ"],["の"],["つえ"],["を"],["執った","とった"],["。"]]},{"verse":21,"text":"主,しゅはモーセに言,いわれた、「あなたがエジプトに帰,かえったとき、わたしがあなたの手,てに授,さづけた不思議,ふしぎを、みなパロの前,まえで行,おこないなさい。しかし、わたしが彼,かれの心,こころをかたくなにするので、彼,かれは民,たみを去,さらせないであろう。","tok":[["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["が"],["エジプト"],["に"],["帰えった","かえった"],["とき"],["、"],["わたし"],["が"],["あなた"],["の"],["手","て"],["に"],["授","さ"],["づけた"],["不思議","ふしぎ"],["を"],["、"],["みな"],["パロ"],["の"],["前","まえ"],["で"],["行ない","おこない"],["なさい"],["。"],["しかし"],["、"],["わたし"],["が"],["彼","かれ"],["の"],["心","こころ"],["を"],["かたくな"],["に"],["する"],["ので"],["、"],["彼","かれ"],["は"],["民","たみ"],["を"],["去らせないで","さらせないで"],["あろう"],["。"]]},{"verse":22,"text":"あなたはパロに言,いいなさい、『主,しゅはこう仰,おおせられる。イスラエルはわたしの子,こ、わたしの長子,ちょうしである。","tok":[["あなた"],["は"],["パロ"],["に"],["言い","いい"],["なさい"],["、"],["『"],["主","しゅ"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["イスラエル"],["は"],["わたし"],["の"],["子","こ"],["、"],["わたし"],["の"],["長子","ちょうし"],["で"],["ある"],["。"]]},{"verse":23,"text":"わたしはあなたに言,いう。わたしの子,こを去,さらせて、わたしに仕,つかえさせなさい。もし彼,かれを去,さらせるのを拒,こばむならば、わたしはあなたの子,こ、あなたの長子,ちょうしを殺,ころすであろう』と」。","tok":[["わたし"],["は"],["あなた"],["に"],["言う","いう"],["。"],["わたし"],["の"],["子","こ"],["を"],["去らせて","さらせて"],["、"],["わたし"],["に"],["仕えさせ","つかえさせ"],["なさい"],["。"],["もし"],["彼","かれ"],["を"],["去らせる","さらせる"],["の"],["を"],["拒むならば","こばむならば"],["、"],["わたし"],["は"],["あなた"],["の"],["子","こ"],["、"],["あなた"],["の"],["長子","ちょうし"],["を"],["殺ろすで","ころすで"],["あろう"],["』"],["と"],["」"],["。"]]},{"verse":24,"text":"さてモーセが途中,とちゅうで宿,やどっている時,とき、主,しゅは彼,かれに会,あって彼,かれを殺,ころそうとされた。","tok":[["さて"],["モーセ"],["が"],["途中","とちゅう"],["で"],["宿って","やどって"],["いる"],["時","とき"],["、"],["主","しゅ"],["は"],["彼","かれ"],["に"],["会って","あって"],["彼","かれ"],["を"],["殺そう","ころそう"],["と"],["された"],["。"]]},{"verse":25,"text":"その時,ときチッポラは火打,ひうち石,いしの小刀,こがたなを取,とって、その男,おとこの子,この前,まえの皮,かわを切,きり、それをモーセの足,あしにつけて言,いった、「あなたはまことに、わたしにとって血,ちの花婿,はなむこです」。","tok":[["その"],["時","とき"],["チッポラ"],["は"],["火打石","ひうちいし"],["の"],["小刀","こがたな"],["を"],["取って","とって"],["、"],["その"],["男の子","おとこのこ"],["の"],["前","まえ"],["の"],["皮","かわ"],["を"],["切り","きり"],["、"],["それ"],["を"],["モーセ"],["の"],["足","あし"],["に"],["つけて"],["言った","いった"],["、"],["「"],["あなた"],["は"],["まこと"],["に"],["、"],["わたし"],["にとって"],["血","ち"],["の"],["花婿","はなむこ"],["です"],["」"],["。"]]},{"verse":26,"text":"そこで、主,しゅはモーセをゆるされた。この時,とき「血,ちの花婿,はなむこです」とチッポラが言,いったのは割礼,かつれいのゆえである。","tok":[["そこ"],["で"],["、"],["主","しゅ"],["は"],["モーセ"],["を"],["ゆるされた"],["。"],["この"],["時","とき"],["「"],["血","ち"],["の"],["花婿","はなむこ"],["です"],["」"],["と"],["チッポラ"],["が"],["言った","いった"],["の"],["は"],["割礼","かつれい"],["の"],["ゆえ"],["で"],["ある"],["。"]]},{"verse":27,"text":"主,しゅはアロンに言,いわれた、「荒野,あらのに行,いってモーセに会,あいなさい」。彼,かれは行,いって神,かみの山,やまでモーセに会,あい、これに口,くちづけした。","tok":[["主","しゅ"],["は"],["アロン"],["に"],["言われた","いわれた"],["、"],["「"],["荒野","あら"],["のに"],["行って","いって"],["モーセ"],["に"],["会い","あい"],["なさい"],["」"],["。"],["彼","かれ"],["は"],["行って","いって"],["神","かみ"],["の"],["山","やま"],["で"],["モーセ"],["に"],["会い","あい"],["、"],["これ"],["に"],["口づけ","くちづけ"],["した"],["。"]]},{"verse":28,"text":"モーセは自分,じぶんをつかわされた主,しゅのすべての言葉,ことばと、命,めいじられたすべてのしるしをアロンに告,つげた。","tok":[["モーセ"],["は"],["自分","じぶん"],["を"],["つかわされた"],["主","しゅ"],["の"],["すべて"],["の"],["言葉","ことば"],["と"],["、"],["命じられた","めいじられた"],["すべて"],["の"],["しるし"],["を"],["アロン"],["に"],["告","つげ"],["た"],["。"]]},{"verse":29,"text":"そこでモーセとアロンは行,いってイスラエルの人々,ひとびとの長老,ちょうろうたちをみな集,あつめた。","tok":[["そこ"],["で"],["モーセ"],["と"],["アロン"],["は"],["行って","いって"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["長老","ちょうろう"],["たち"],["を"],["みな"],["集めた","あつめた"],["。"]]},{"verse":30,"text":"そしてアロンは主,しゅがモーセに語,かたられた言葉,ことばを、ことごとく告,つげた。また彼,かれは民,たみの前,まえでしるしを行,おこなったので、","tok":[["そして"],["アロン"],["は"],["主","しゅ"],["が"],["モーセ"],["に"],["語られた","かたられた"],["言葉","ことば"],["を"],["、"],["ことごとく"],["告","つげ"],["た"],["。"],["また"],["彼","かれ"],["は"],["民","たみ"],["の"],["前","まえ"],["で"],["しるし"],["を"],["行なった","おこなった"],["ので"],["、"]]},{"verse":31,"text":"民,たみは信,しんじた。彼,かれらは主,しゅがイスラエルの人々,ひとびとを顧,かえりみ、その苦,くるしみを見,みられたのを聞,きき、伏,ふして礼拝,れいはいした。","tok":[["民","たみ"],["は"],["信じた","しんじた"],["。"],["彼","かれ"],["ら"],["は"],["主","しゅ"],["が"],["イスラエル"],["の"],["人々","ひとびと"],["を"],["顧りみ","かえりみ"],["、"],["その"],["苦しみ","くるしみ"],["を"],["見られた","みられた"],["の"],["を"],["聞","きき"],["、"],["伏して","ふして"],["礼拝","れいはい"],["した"],["。"]]}]
[{"verse":1,"text":"さて、モーセのしゅうと、ミデアンの祭司,さいしエテロは、神,かみがモーセと、み民,たみイスラエルとにされたすべての事,こと、主,しゅがイスラエルをエジプトから導,みちびき出,だされたことを聞,きいた。","tok":[["さて"],["、"],["モーセ"],["の"],["しゅうと"],["、"],["ミデアン"],["の"],["祭司","さいし"],["エテロ"],["は"],["、"],["神","かみ"],["が"],["モーセ"],["と"],["、"],["み民","みたみ"],["イスラエル"],["と"],["に"],["された"],["すべて"],["の"],["事","こと"],["、"],["主","しゅ"],["が"],["イスラエル"],["を"],["エジプト"],["から"],["導き出された","みちびきだされた"],["こと"],["を"],["聞いた","きいた"],["。"]]},{"verse":2,"text":"それでモーセのしゅうと、エテロは、さきに送,おくり返,かえされていたモーセの妻,つまチッポラと、","tok":[["それ"],["で"],["モーセ"],["の"],["しゅうと"],["、"],["エテロ"],["は"],["、"],["さき"],["に"],["送り","おくり"],["返えされて","かえされて"],["いた"],["モーセ"],["の"],["妻","つま"],["チッポラ"],["と"],["、"]]},{"verse":3,"text":"そのふたりの子,ことを連,つれてきた。そのひとりの名,なはゲルショムといった。モーセが、「わたしは外国,がいこくで寄留者,きりゅうしゃとなっている」と言,いったからである。","tok":[["その"],["ふたり"],["の"],["子","こ"],["と"],["を"],["連れて","つれて"],["きた"],["。"],["その"],["ひとり"],["の"],["名","な"],["は"],["ゲルショム"],["と"],["いった"],["。"],["モーセ"],["が"],["、"],["「"],["わたし"],["は"],["外国","がいこく"],["で"],["寄留者","きりゅうしゃ"],["と"],["なって"],["いる"],["」"],["と"],["言った","いった"],["から"],["で"],["ある"],["。"]]},{"verse":4,"text":"ほかのひとりの名,なはエリエゼルといった。「わたしの父,ちちの神,かみはわたしの助,たすけであって、パロのつるぎからわたしを救,すくわれた」と言,いったからである。","tok":[["ほか"],["の"],["ひとり"],["の"],["名","な"],["は"],["エリエゼル"],["と"],["いった"],["。"],["「"],["わたし"],["の"],["父","ちち"],["の"],["神","かみ"],["は"],["わたし"],["の"],["助け","たすけ"],["で"],["あって"],["、"],["パロ"],["の"],["つるぎ"],["から"],["わたし"],["を"],["救われた","すくわれた"],["」"],["と"],["言った","いった"],["から"],["で"],["ある"],["。"]]},{"verse":5,"text":"こうしてモーセのしゅうと、エテロは、モーセの妻子,さいしを伴,ともなって、荒野,あらのに行,いき、神,かみの山,やまに宿営,しゅくえいしているモーセの所,ところにきた。","tok":[["こう"],["して"],["モーセ"],["の"],["しゅうと"],["、"],["エテロ"],["は"],["、"],["モーセ"],["の"],["妻子","さいし"],["を"],["伴なって","ともなって"],["、"],["荒野","あら"],["のに"],["行き","いき"],["、"],["神","かみ"],["の"],["山","やま"],["に"],["宿営","しゅくえい"],["して"],["いる"],["モーセ"],["の"],["所","ところ"],["に"],["きた"],["。"]]},{"verse":6,"text":"その時,とき、ある人,ひとがモーセに言,いった、「ごらんなさい。あなたのしゅうと、エテロは、あなたの妻,つまとそのふたりの子,こを連,つれて、あなたの所,ところにこられます」。","tok":[["その"],["時","とき"],["、"],["ある"],["人","ひと"],["が"],["モーセ"],["に"],["言った","いった"],["、"],["「"],["ごらん"],["なさい"],["。"],["あなた"],["の"],["しゅうと"],["、"],["エテロ"],["は"],["、"],["あなた"],["の"],["妻","つま"],["と"],["その"],["ふたり"],["の"],["子","こ"],["を"],["連れて","つれて"],["、"],["あなた"],["の"],["所","ところ"],["に"],["こられます"],["」"],["。"]]},{"verse":7,"text":"そこでモーセはしゅうとを出迎,でむかえて、身,みをかがめ、彼,かれに口,くちづけして、互,たがいに安否,あんぴを問,とい、共,ともに天幕,てんまくにはいった。","tok":[["そこ"],["で"],["モーセ"],["は"],["しゅうと"],["を"],["出迎","でむかえ"],["て"],["、"],["身","み"],["を"],["かがめ"],["、"],["彼","かれ"],["に"],["口づけ","くちづけ"],["して"],["、"],["互","たがい"],["に"],["安否","あんぴ"],["を"],["問","とい"],["、"],["共","とも"],["に"],["天幕","てんまく"],["に"],["はいった"],["。"]]},{"verse":8,"text":"そしてモーセは、主,しゅがイスラエルのために、パロとエジプトびととにされたすべての事,こと、道,みちで出会,であったすべての苦,くるしみ、また主,しゅが彼,かれらを救,すくわれたことを、しゅうとに物語,ものがたったので、","tok":[["そして"],["モーセ"],["は"],["、"],["主","しゅ"],["が"],["イスラエル"],["の"],["ため"],["に"],["、"],["パロ"],["と"],["エジプト"],["びと"],["と"],["に"],["された"],["すべて"],["の"],["事","こと"],["、"],["道","みち"],["で"],["出会った","であった"],["すべて"],["の"],["苦しみ","くるしみ"],["、"],["また"],["主","しゅ"],["が"],["彼","かれ"],["ら"],["を"],["救われた","すくわれた"],["こと"],["を"],["、"],["しゅうと"],["に"],["物語った","ものがたった"],["ので"],["、"]]},{"verse":9,"text":"エテロは主,しゅがイスラエルをエジプトびとの手,てから救,すくい出,だして、もろもろの恵,めぐみを賜,たまわったことを喜,よろこんだ。","tok":[["エテロ"],["は"],["主","しゅ"],["が"],["イスラエル"],["を"],["エジプト"],["びと"],["の"],["手","て"],["から"],["救い出して","すくいだして"],["、"],["もろもろ"],["の"],["恵","めぐみ"],["を"],["賜わった","たまわった"],["こと"],["を"],["喜こんだ","よろこんだ"],["。"]]},{"verse":10,"text":"そしてエテロは言,いった、「主,しゅはほむべきかな。主,しゅはあなたがたをエジプトびとの手,てと、パロの手,てから救,すくい出,だし、民,たみをエジプトびとの手,ての下,したから救,すくい出,だされた。","tok":[["そして"],["エテロ"],["は"],["言った","いった"],["、"],["「"],["主","しゅ"],["は"],["ほ"],["むべき"],["か"],["な"],["。"],["主","しゅ"],["は"],["あなた"],["がた"],["を"],["エジプト"],["びと"],["の"],["手","て"],["と"],["、"],["パロ"],["の"],["手","て"],["から"],["救い出し","すくいだし"],["、"],["民","たみ"],["を"],["エジプト"],["びと"],["の"],["手","て"],["の"],["下","した"],["から"],["救い出された","すくいだされた"],["。"]]},{"verse":11,"text":"今,いまこそわたしは知,しった。実,じつに彼,かれらはイスラエルびとにむかって高慢,こうまんにふるまったが、主,しゅはあらゆる神々,かみがみにまさって大,おおいにいますことを」。","tok":[["今","いま"],["こそ"],["わたし"],["は"],["知った","しった"],["。"],["実","じつ"],["に"],["彼","かれ"],["ら"],["は"],["イスラエル"],["びと"],["に"],["むかって"],["高慢","こうまん"],["に"],["ふるまった"],["が"],["、"],["主","しゅ"],["は"],["あらゆる"],["神々","かみがみ"],["に"],["まさって"],["大いに","おおいに"],["います"],["こと"],["を"],["」"],["。"]]},{"verse":12,"text":"そしてモーセのしゅうとエテロは燔祭,はんさいと犠牲,ぎせいを神,かみに供,そなえ、アロンとイスラエルの長老,ちょうろうたちもみなきて、モーセのしゅうとと共,ともに神,かみの前,まえで食事,しょくじをした。","tok":[["そして"],["モーセ"],["の"],["しゅうと"],["エテロ"],["は"],["燔祭","はんさい"],["と"],["犠牲","ぎせい"],["を"],["神","かみ"],["に"],["供え","そなえ"],["、"],["アロン"],["と"],["イスラエル"],["の"],["長老","ちょうろう"],["たち"],["も"],["み"],["なきて"],["、"],["モーセ"],["の"],["しゅうと"],["と"],["共","とも"],["に"],["神","かみ"],["の"],["前","まえ"],["で"],["食事","しょくじ"],["を"],["した"],["。"]]},{"verse":13,"text":"あくる日,ひモーセは座,ざして民,たみをさばいたが、民,たみは朝,あさから晩,ばんまで、モーセのまわりに立,たっていた。","tok":[["あくる日","あくるひ"],["モーセ"],["は"],["座して","ざして"],["民","たみ"],["を"],["さばいた"],["が"],["、"],["民","たみ"],["は"],["朝","あさ"],["から"],["晩","ばん"],["まで"],["、"],["モーセ"],["の"],["まわり"],["に"],["立って","たって"],["いた"],["。"]]},{"verse":14,"text":"モーセのしゅうとは、彼,かれがすべて民,たみにしていることを見,みて、言,いった、「あなたが民,たみにしているこのことはなんですか。あなたひとりが座,ざし、民,たみはみな朝,あさから晩,ばんまで、あなたのまわりに立,たっているのはなぜですか」。","tok":[["モーセ"],["の"],["しゅうと"],["は"],["、"],["彼","かれ"],["が"],["すべて民","すべてたみ"],["に"],["して"],["いる"],["こと"],["を"],["見て","みて"],["、"],["言った","いった"],["、"],["「"],["あなた"],["が"],["民","たみ"],["に"],["して"],["いる"],["この"],["こと"],["は"],["なん"],["です"],["か"],["。"],["あなた"],["ひとり"],["が"],["座し","ざし"],["、"],["民","たみ"],["は"],["みな"],["朝","あさ"],["から"],["晩","ばん"],["まで"],["、"],["あなた"],["の"],["まわり"],["に"],["立って","たって"],["いる"],["の"],["は"],["なぜ"],["です"],["か"],["」"],["。"]]},{"verse":15,"text":"モーセはしゅうとに言,いった、「民,たみが神,かみに伺,うかがおうとして、わたしの所,ところに来,くるからです。","tok":[["モーセ"],["は"],["しゅうと"],["に"],["言った","いった"],["、"],["「"],["民","た"],["み"],["が"],["神","かみ"],["に"],["伺おう","うかがおう"],["として"],["、"],["わたし"],["の"],["所","ところ"],["に"],["来る","くる"],["から"],["です"],["。"]]},{"verse":16,"text":"彼,かれらは事,ことがあれば、わたしの所,ところにきます。わたしは相互,そうごの間,あいだをさばいて、神,かみの定,さだめと判決,はんけつを知,しらせるのです」。","tok":[["彼","かれ"],["ら"],["は"],["事","こと"],["が"],["あれば"],["、"],["わたし"],["の"],["所","ところ"],["に"],["きます"],["。"],["わたし"],["は"],["相互","そうご"],["の"],["間","あいだ"],["を"],["さばいて"],["、"],["神","かみ"],["の"],["定め","さだめ"],["と"],["判決","はんけつ"],["を"],["知らせる","しらせる"],["の"],["です"],["」"],["。"]]},{"verse":17,"text":"モーセのしゅうとは彼,かれに言,いった、「あなたのしていることは良,よくない。","tok":[["モーセ"],["の"],["しゅうと"],["は"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["の"],["して"],["いる"],["こと"],["は"],["良く","よく"],["ない"],["。"]]},{"verse":18,"text":"あなたも、あなたと一緒,いっしょにいるこの民,たみも、必,かならず疲,つかれ果,はてるであろう。このことはあなたに重,おも過,すぎるから、ひとりですることができない。","tok":[["あなた"],["も"],["、"],["あなた"],["と"],["一緒","いっしょ"],["に"],["いる"],["この"],["民","たみ"],["も"],["、"],["必","かならず"],["疲れ","つかれ"],["果てるで","はてるで"],["あろう"],["。"],["この"],["こと"],["は"],["あなた"],["に"],["重","お"],["も"],["過る","すぎる"],["から"],["、"],["ひとり"],["で"],["する"],["こと"],["が"],["できない"],["。"]]},{"verse":19,"text":"今,いまわたしの言,いうことを聞,ききなさい。わたしはあなたに助言,じょげんする。どうか神,かみがあなたと共,ともにいますように。あなたは民,たみのために神,かみの前,まえにいて、事件,じけんを神,かみに述,のべなさい。","tok":[["今","いま"],["わたし"],["の"],["言う","いう"],["こと"],["を"],["聞","きき"],["なさい"],["。"],["わたし"],["は"],["あなた"],["に"],["助言","じょげん"],["する"],["。"],["どう"],["か"],["神","かみ"],["が"],["あなた"],["と"],["共","とも"],["に"],["います"],["よう"],["に"],["。"],["あなた"],["は"],["民","たみ"],["の"],["ため"],["に"],["神","かみ"],["の"],["前","まえ"],["に"],["いて"],["、"],["事件","じけん"],["を"],["神","かみ"],["に"],["述べ","のべ"],["なさい"],["。"]]},{"verse":20,"text":"あなたは彼,かれらに定,さだめと判決,はんけつを教,おしえ、彼,かれらの歩,あゆむべき道,みちと、なすべき事,ことを彼,かれらに知,しらせなさい。","tok":[["あなた"],["は"],["彼","かれ"],["ら"],["に"],["定め","さだめ"],["と"],["判決","はんけつ"],["を"],["教え","おしえ"],["、"],["彼","かれ"],["ら"],["の"],["歩むべき","あゆむべき"],["道","みち"],["と"],["、"],["なすべき"],["事","こと"],["を"],["彼","かれ"],["ら"],["に"],["知らせ","しらせ"],["なさい"],["。"]]},{"verse":21,"text":"また、すべての民,たみのうちから、有能,ゆうのうな人,ひとで、神,かみを恐,おそれ、誠実,せいじつで不義,ふぎの利,りを憎,にくむ人,ひとを選,えらび、それを民,たみの上,うえに立,たてて、千人,にんの長,ちょう、百人,にんの長,ちょう、五十人,にんの長,ちょう、十人,にんの長,ちょうとしなさい。","tok":[["また"],["、"],["すべて"],["の"],["民","たみ"],["の"],["うち"],["から"],["、"],["有能","ゆうのう"],["な"],["人","ひと"],["で"],["、"],["神","かみ"],["を"],["恐","おそれ"],["、"],["誠実","せいじつ"],["で"],["不義","ふぎ"],["の"],["利","り"],["を"],["憎む","にくむ"],["人","ひと"],["を"],["選ら","えら"],["び"],["、"],["それ"],["を"],["民","たみ"],["の"],["上","うえ"],["に"],["立てて","たてて"],["、"],["千人","にん"],["の"],["長う","ちょう"],["、"],["百人","にん"],["の"],["長う","ちょう"],["、"],["五","ご"],["十人","じゅうにん"],["の"],["長う","ちょう"],["、"],["十人","にん"],["の"],["長","ちょう"],["と"],["し"],["なさい"],["。"]]},{"verse":22,"text":"平素,へいそは彼,かれらに民,たみをさばかせ、大事,だいじ件はすべてあなたの所,ところに持,もってこさせ、小,しょう事件,じけんはすべて彼,かれらにさばかせなさい。こうしてあなたを身軽,みがるにし、あなたと共,ともに彼,かれらに、荷,にを負,おわせなさい。","tok":[["平素","へいそ"],["は"],["彼","かれ"],["ら"],["に"],["民","たみ"],["を"],["さばかせ"],["、"],["大事件","だいじ件"],["は"],["すべて"],["あなた"],["の"],["所","ところ"],["に"],["持って","もって"],["こさせ"],["、"],["小","しょう"],["事件","じけん"],["は"],["すべて"],["彼","かれ"],["ら"],["に"],["さばかせ"],["なさい"],["。"],["こう"],["して"],["あなた"],["を"],["身軽","みがる"],["に"],["し"],["、"],["あなた"],["と"],["共","とも"],["に"],["彼","かれ"],["ら"],["に"],["、"],["荷","に"],["を"],["負わせ","おわせ"],["なさい"],["。"]]},{"verse":23,"text":"あなたが、もしこの事,ことを行,おこない、神,かみもまたあなたに命,めいじられるならば、あなたは耐,たえることができ、この民,たみもまた、みな安,やすんじてその所,ところに帰,かえることができよう」。","tok":[["あなた"],["が"],["、"],["もし"],["この"],["事","こと"],["を"],["行ない","おこない"],["、"],["神","かみ"],["も"],["また"],["あなた"],["に"],["命じられるならば","めいじられるならば"],["、"],["あなた"],["は"],["耐える","たえる"],["こと"],["が"],["でき"],["、"],["この"],["民","たみ"],["も"],["また"],["、"],["みな"],["安んじて","やすんじて"],["その"],["所","ところ"],["に"],["帰える","かえる"],["こと"],["が"],["できよう"],["」"],["。"]]},{"verse":24,"text":"モーセはしゅうとの言葉,ことばに従,したがい、すべて言,いわれたようにした。","tok":[["モーセ"],["は"],["しゅうと"],["の"],["言葉","ことば"],["に"],["従い","したがい"],["、"],["すべて"],["言われた","いわれた"],["よう"],["に"],["した"],["。"]]},{"verse":25,"text":"すなわち、モーセはすべてのイスラエルのうちから有能,ゆうのうな人,ひとを選,えらんで、民,たみの上,うえに長,ちょうとして立,たて、千人,にんの長,ちょう、百人,にんの長,ちょう、五十人,にんの長,ちょう、十人,にんの長,ちょうとした。","tok":[["すなわち"],["、"],["モーセ"],["は"],["すべて"],["の"],["イスラエル"],["の"],["うち"],["から"],["有能","ゆうのう"],["な"],["人","ひと"],["を"],["選らんで","えらんで"],["、"],["民","たみ"],["の"],["上","うえ"],["に"],["長","ちょう"],["として"],["立","たて"],["、"],["千人","にん"],["の"],["長う","ちょう"],["、"],["百人","にん"],["の"],["長う","ちょう"],["、"],["五","ご"],["十人","じゅうにん"],["の"],["長う","ちょう"],["、"],["十人","にん"],["の"],["長","ちょう"],["と"],["した"],["。"]]},{"verse":26,"text":"平素,へいそは彼,かれらが民,たみをさばき、むずかしい事件,じけんはモーセに持,もってきたが、小,ちいさい事件,じけんはすべて彼,かれらみずからさばいた。","tok":[["平素","へいそ"],["は"],["彼","かれ"],["ら"],["が"],["民","たみ"],["を"],["さばき"],["、"],["むずかしい"],["事件","じけん"],["は"],["モーセ"],["に"],["持って","もって"],["きた"],["が"],["、"],["小さい","ちいさい"],["事件","じけん"],["は"],["すべて"],["彼","かれ"],["ら"],["みずから"],["さばいた"],["。"]]},{"verse":27,"text":"こうしてモーセはしゅうとを送,おくり返,かえしたので、その国,くにに帰,かえって行,いった。","tok":[["こう"],["して"],["モーセ"],["は"],["しゅうと"],["を"],["送り","おくり"],["返","かえし"],["た"],["ので"],["、"],["その"],["国","くに"],["に"],["帰えって","かえって"],["行った","いった"],["。"]]}]
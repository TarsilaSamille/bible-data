[{"verse":1,"text":"主,しゅはモーセに言,いわれた、「今,いま、あなたは、わたしがパロに何,なにをしようとしているかを見,みるであろう。すなわちパロは強,つよい手,てにしいられて、彼,かれらを去,さらせるであろう。否,いな、彼,かれは強,つよい手,てにしいられて、彼,かれらを国,くにから追,おい出,だすであろう」。","tok":[["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"],["「"],["今","いま"],["、"],["あなた"],["は"],["、"],["わたし"],["が"],["パロ"],["に"],["何に","なに"],["を"],["しよう"],["として"],["いる"],["か"],["を"],["見るで","みるで"],["あろう"],["。"],["すなわち"],["パロ"],["は"],["強い","つよい"],["手","て"],["に"],["し"],["いられて"],["、"],["彼","かれ"],["ら"],["を"],["去らせるで","さらせるで"],["あろう"],["。"],["否","いな"],["、"],["彼","かれ"],["は"],["強い","つよい"],["手","て"],["に"],["し"],["いられて"],["、"],["彼","かれ"],["ら"],["を"],["国","くに"],["から"],["追い出すで","おいだすで"],["あろう"],["」"],["。"]]},{"verse":2,"text":"神,かみはモーセに言,いわれた、「わたしは主,しゅである。","tok":[["神","かみ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"],["「"],["わたし"],["は"],["主","しゅ"],["で"],["ある"],["。"]]},{"verse":3,"text":"わたしはアブラハム、イサク、ヤコブには全能,ぜんのうの神,かみとして現,あらわれたが、主,しゅという名,なでは、自分,じぶんを彼,かれらに知,しらせなかった。","tok":[["わたし"],["は"],["アブラハム"],["、"],["イサク"],["、"],["ヤコブ"],["に"],["は"],["全能","ぜんのう"],["の"],["神","かみ"],["として"],["現われた","あらわれた"],["が"],["、"],["主","しゅ"],["と"],["いう"],["名","な"],["で"],["は"],["、"],["自分","じぶん"],["を"],["彼","かれ"],["ら"],["に"],["知らせなかった","しらせなかった"],["。"]]},{"verse":4,"text":"わたしはまたカナンの地,ち、すなわち彼,かれらが寄留,きりゅうしたその寄留,きりゅうの地,ちを、彼,かれらに与,あたえるという契約,けいやくを彼,かれらと立,たてた。","tok":[["わたし"],["は"],["また"],["カナン"],["の"],["地","ち"],["、"],["すなわち"],["彼","かれ"],["ら"],["が"],["寄留","きりゅう"],["した"],["その"],["寄留","きりゅう"],["の"],["地","ち"],["を"],["、"],["彼","かれ"],["ら"],["に"],["与える","あたえる"],["と"],["いう"],["契約","けいやく"],["を"],["彼","かれ"],["ら"],["と"],["立てた","たてた"],["。"]]},{"verse":5,"text":"わたしはまた、エジプトびとが奴隷,どれいとしているイスラエルの人々,ひとびとのうめきを聞,きいて、わたしの契約,けいやくを思,おもい出,だした。","tok":[["わたし"],["は"],["また"],["、"],["エジプト"],["びと"],["が"],["奴隷","どれい"],["として"],["いる"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["うめき"],["を"],["聞いて","きいて"],["、"],["わたし"],["の"],["契約","けいやく"],["を"],["思い出した","おもいだした"],["。"]]},{"verse":6,"text":"それゆえ、イスラエルの人々,ひとびとに言,いいなさい、『わたしは主,しゅである。わたしはあなたがたをエジプトびとの労役,ろうえきの下,したから導,みちびき出,だし、奴隷,どれいの務,つとめから救,すくい、また伸,のべた腕,うでと大,おおいなるさばきをもって、あなたがたをあがなうであろう。","tok":[["それ"],["ゆえ"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["言い","いい"],["なさい"],["、"],["『"],["わたし"],["は"],["主","しゅ"],["で"],["ある"],["。"],["わたし"],["は"],["あなた"],["がた"],["を"],["エジプト"],["びと"],["の"],["労役","ろうえき"],["の"],["下","した"],["から"],["導き出し","みちびきだし"],["、"],["奴隷","どれい"],["の"],["務め","つとめ"],["から"],["救い","すくい"],["、"],["また"],["伸べた","のべた"],["腕","うで"],["と"],["大いなる","おおいなる"],["さばき"],["を"],["もって"],["、"],["あなた"],["がた"],["を"],["あがなうで"],["あろう"],["。"]]},{"verse":7,"text":"わたしはあなたがたを取,とってわたしの民,たみとし、わたしはあなたがたの神,かみとなる。わたしがエジプトびとの労役,ろうえきの下,したからあなたがたを導,みちびき出,だすあなたがたの神,かみ、主,しゅであることを、あなたがたは知,しるであろう。","tok":[["わたし"],["は"],["あなた"],["がた"],["を"],["取って","とって"],["わたし"],["の"],["民","たみ"],["と"],["し"],["、"],["わたし"],["は"],["あなた"],["がた"],["の"],["神","かみ"],["と"],["なる"],["。"],["わたし"],["が"],["エジプト"],["びと"],["の"],["労役","ろうえき"],["の"],["下","した"],["から"],["あなた"],["がた"],["を"],["導き出す","みちびきだす"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["で"],["ある"],["こと"],["を"],["、"],["あなた"],["がた"],["は"],["知るで","しるで"],["あろう"],["。"]]},{"verse":8,"text":"わたしはアブラハム、イサク、ヤコブに与,あたえると手,てを挙,あげて誓,ちかったその地,ちにあなたがたをはいらせ、それを所有,しょゆうとして、与,あたえるであろう。わたしは主,しゅである』と」。","tok":[["わたし"],["は"],["アブラハム"],["、"],["イサク"],["、"],["ヤコブ"],["に"],["与える","あたえる"],["と"],["手","て"],["を"],["挙げて","あげて"],["誓った","ちかった"],["その"],["地","ち"],["に"],["あなた"],["がた"],["を"],["はいらせ"],["、"],["それ"],["を"],["所有","しょゆう"],["として"],["、"],["与えるで","あたえるで"],["あろう"],["。"],["わたし"],["は"],["主","しゅ"],["で"],["ある"],["』"],["と"],["」"],["。"]]},{"verse":9,"text":"モーセはこのようにイスラエルの人々,ひとびとに語,かたったが、彼,かれらは心,こころの痛,いたみと、きびしい奴隷,どれいの務,つとめのゆえに、モーセに聞,きき従,したがわなかった。","tok":[["モーセ"],["は"],["この"],["よう"],["に"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["語った","かたった"],["が"],["、"],["彼","かれ"],["ら"],["は"],["心","こころ"],["の"],["痛み","いたみ"],["と"],["、"],["きびしい"],["奴隷","どれい"],["の"],["務め","つとめ"],["の"],["ゆえ"],["に"],["、"],["モーセ"],["に"],["聞","きき"],["従わなかった","したがわなかった"],["。"]]},{"verse":10,"text":"さて主,しゅはモーセに言,いわれた、","tok":[["さて"],["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":11,"text":"「エジプトの王,おうパロのところに行,いって、彼,かれがイスラエルの人々,ひとびとをその国,くにから去,さらせるように話,はなしなさい」。","tok":[["「"],["エジプト"],["の"],["王","おう"],["パロ"],["の"],["ところ"],["に"],["行って","いって"],["、"],["彼","かれ"],["が"],["イスラエル"],["の"],["人々","ひとびと"],["を"],["その"],["国","くに"],["から"],["去らせる","さらせる"],["よう"],["に"],["話","はなし"],["なさい"],["」"],["。"]]},{"verse":12,"text":"モーセは主,しゅにむかって言,いった、「イスラエルの人々,ひとびとでさえ、わたしの言,いうことを聞,きかなかったのに、どうして、くちびるに割礼,かつれいのないわたしの言,いうことを、パロが聞,きき入,いれましょうか」。","tok":[["モーセ"],["は"],["主に","しゅに"],["むか"],["って"],["言った","いった"],["、"],["「"],["イスラエル"],["の"],["人々","ひとびと"],["で"],["さえ"],["、"],["わたし"],["の"],["言う","いう"],["こと"],["を"],["聞かなかった","きかなかった"],["のに"],["、"],["どう"],["して"],["、"],["くちびる"],["に"],["割礼","かつれい"],["の"],["ない"],["わたし"],["の"],["言う","いう"],["こと"],["を"],["、"],["パロ"],["が"],["聞入れましょう","ききいれましょう"],["か"],["」"],["。"]]},{"verse":13,"text":"しかし、主,しゅはモーセとアロンに語,かたって、イスラエルの人々,ひとびとと、エジプトの王,おうパロのもとに行,いかせ、イスラエルの人々,ひとびとをエジプトの地,ちから導,みちびき出,だせと命,めいじられた。","tok":[["しかし"],["、"],["主","しゅ"],["は"],["モーセ"],["と"],["アロン"],["に"],["語って","かたって"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["と"],["、"],["エジプト"],["の"],["王","おう"],["パロ"],["の"],["もと"],["に"],["行かせ","いかせ"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["を"],["エジプト"],["の"],["地","ち"],["から"],["導き出せ","みちびきだせ"],["と"],["命じられた","めいじられた"],["。"]]},{"verse":14,"text":"彼,かれらの先祖,せんぞの家,いえの首長,しゅちょうたちは次,つぎのとおりである。すなわちイスラエルの長子,ちょうしルベンの子,こらはハノク、パル、ヘヅロン、カルミで、これらはルベンの一族,いちぞくである。","tok":[["彼","かれ"],["ら"],["の"],["先祖","せんぞ"],["の"],["家","いえ"],["の"],["首長","しゅちょう"],["たち"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["すなわち"],["イスラエル"],["の"],["長子","ちょうし"],["ルベン"],["の"],["子","こ"],["ら"],["は"],["ハノク"],["、"],["パル"],["、"],["ヘヅロン"],["、"],["カルミ"],["で"],["、"],["これ"],["ら"],["は"],["ルベン"],["の"],["一族","いちぞく"],["で"],["ある"],["。"]]},{"verse":15,"text":"シメオンの子,こらはエムエル、ヤミン、オハデ、ヤキン、ゾハル、およびカナンの女,おんなから生,うまれたシャウルで、これらはシメオンの一族,いちぞくである。","tok":[["シメオン"],["の"],["子","こ"],["ら"],["は"],["エムエル"],["、"],["ヤミン"],["、"],["オハデ"],["、"],["ヤキン"],["、"],["ゾハル"],["、"],["および"],["カナン"],["の"],["女","おんな"],["から"],["生まれた","うまれた"],["シャウル"],["で"],["、"],["これ"],["ら"],["は"],["シメオン"],["の"],["一族","いちぞく"],["で"],["ある"],["。"]]},{"verse":16,"text":"レビの子,こらの名,なは、その世代,せだいに従,したがえば、ゲルション、コハテ、メラリで、レビの一生,いっしょうは百三十七年,ねんであった。","tok":[["レビ"],["の"],["子","こ"],["ら"],["の"],["名","な"],["は"],["、"],["その"],["世代","せだい"],["に"],["従えば","したがえば"],["、"],["ゲルション"],["、"],["コハテ"],["、"],["メラリ"],["で"],["、"],["レビ"],["の"],["一生","いっしょう"],["は"],["百三十七","ひゃくさんじゅうなな"],["年","ねん"],["で"],["あった"],["。"]]},{"verse":17,"text":"ゲルションの子,こらの一族,いちぞくはリブニとシメイである。","tok":[["ゲルション"],["の"],["子","こ"],["ら"],["の"],["一族","いちぞく"],["は"],["リブニ"],["と"],["シメイ"],["で"],["ある"],["。"]]},{"verse":18,"text":"コハテの子,こらはアムラム、イヅハル、ヘブロン、ウジエルで、コハテの一生,いっしょうは百三十三年,ねんであった。","tok":[["コハテ"],["の"],["子","こ"],["ら"],["は"],["アムラム"],["、"],["イヅハル"],["、"],["ヘブロン"],["、"],["ウジエル"],["で"],["、"],["コハテ"],["の"],["一生","いっしょう"],["は"],["百三十三","ひゃくさんじゅうさん"],["年","ねん"],["で"],["あった"],["。"]]},{"verse":19,"text":"メラリの子,こらはマヘリとムシである。これらはその世代,せだいによるレビの一族,いちぞくである。","tok":[["メラリ"],["の"],["子","こ"],["ら"],["は"],["マヘリ"],["と"],["ムシ"],["で"],["ある"],["。"],["これ"],["ら"],["は"],["その"],["世代","せだい"],["に"],["よる"],["レビ"],["の"],["一族","いちぞく"],["で"],["ある"],["。"]]},{"verse":20,"text":"アムラムは父,ちちの妹,いもうとヨケベデを妻,つまとしたが、彼女,かのじょはアロンとモーセを彼,かれに産,うんだ。アムラムの一生,いっしょうは百三十七年,ねんであった。","tok":[["アムラム"],["は"],["父","ちち"],["の"],["妹","いもうと"],["ヨケベデ"],["を"],["妻","つま"],["と"],["した"],["が"],["、"],["彼女","かのじょ"],["は"],["アロン"],["と"],["モーセ"],["を"],["彼","かれ"],["に"],["産んだ","うんだ"],["。"],["アムラム"],["の"],["一生","いっしょう"],["は"],["百三十七","ひゃくさんじゅうなな"],["年","ねん"],["で"],["あった"],["。"]]},{"verse":21,"text":"イヅハルの子,こらはコラ、ネペグ、ジクリである。","tok":[["イヅハル"],["の"],["子","こ"],["ら"],["は"],["コラ"],["、"],["ネペグ"],["、"],["ジクリ"],["で"],["ある"],["。"]]},{"verse":22,"text":"ウジエルの子,こらはミサエル、エルザパン、シテリである。","tok":[["ウジエル"],["の"],["子","こ"],["ら"],["は"],["ミサエル"],["、"],["エルザパン"],["、"],["シテリ"],["で"],["ある"],["。"]]},{"verse":23,"text":"アロンはナションの姉妹,しまい、アミナダブの娘,むすめエリセバを妻,つまとした。エリセバは彼,かれにナダブ、アビウ、エレアザル、イタマルを産,うんだ。","tok":[["アロン"],["は"],["ナション"],["の"],["姉妹","しまい"],["、"],["アミナダブ"],["の"],["娘","むすめ"],["エリセバ"],["を"],["妻","つま"],["と"],["した"],["。"],["エリセバ"],["は"],["彼","かれ"],["に"],["ナダブ"],["、"],["アビウ"],["、"],["エレアザル"],["、"],["イタマル"],["を"],["産んだ","うんだ"],["。"]]},{"verse":24,"text":"コラの子,こらはアッシル、エルカナ、アビアサフで、これらはコラびとの一族,いちぞくである。","tok":[["コラ"],["の"],["子","こ"],["ら"],["は"],["アッシル"],["、"],["エルカナ"],["、"],["アビアサフ"],["で"],["、"],["これ"],["ら"],["は"],["コラ"],["びと"],["の"],["一族","いちぞく"],["で"],["ある"],["。"]]},{"verse":25,"text":"アロンの子,こエレアザルはプテエルの娘,むすめのひとりを妻,つまとした。彼女,かのじょはピネハスを彼,かれに産,うんだ。これらは、その一族,いちぞくによるレビびとの先祖,せんぞの家,いえの首長,しゅちょうたちである。","tok":[["アロン"],["の"],["子","こ"],["エレアザル"],["は"],["プテエル"],["の"],["娘","むすめ"],["の"],["ひとり"],["を"],["妻","つま"],["と"],["した"],["。"],["彼女","かのじょ"],["は"],["ピネハス"],["を"],["彼","かれ"],["に"],["産んだ","うんだ"],["。"],["これ"],["ら"],["は"],["、"],["その"],["一族","いちぞく"],["に"],["よる"],["レビ"],["びと"],["の"],["先祖","せんぞ"],["の"],["家","いえ"],["の"],["首長","しゅちょう"],["たち"],["で"],["ある"],["。"]]},{"verse":26,"text":"主,しゅが、「イスラエルの人々,ひとびとをその軍団,ぐんだんに従,したがって、エジプトの地,ちから導,みちびき出,だしなさい」と言,いわれたのは、このアロンとモーセである。","tok":[["主","しゅ"],["が"],["、"],["「"],["イスラエル"],["の"],["人々","ひとびと"],["を"],["その"],["軍団","ぐんだん"],["に"],["従って","したがって"],["、"],["エジプト"],["の"],["地","ち"],["から"],["導き出し","みちびきだし"],["なさい"],["」"],["と"],["言われた","いわれた"],["の"],["は"],["、"],["この"],["アロン"],["と"],["モーセ"],["で"],["ある"],["。"]]},{"verse":27,"text":"彼,かれらはイスラエルの人々,ひとびとをエジプトから導,みちびき出,だすことについて、エジプトの王,おうパロに語,かたったもので、すなわちこのモーセとアロンである。","tok":[["彼","かれ"],["ら"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["を"],["エジプト"],["から"],["導き出す","みちびきだす"],["こと"],["について"],["、"],["エジプト"],["の"],["王","おう"],["パロ"],["に"],["語った","かたった"],["もの"],["で"],["、"],["すなわち"],["この"],["モーセ"],["と"],["アロン"],["で"],["ある"],["。"]]},{"verse":28,"text":"主,しゅがエジプトの地,ちでモーセに語,かたられた日,ひに、","tok":[["主","しゅ"],["が"],["エジプト"],["の"],["地","ち"],["で"],["モーセ"],["に"],["語られた","かたられた"],["日","ひ"],["に"],["、"]]},{"verse":29,"text":"主,しゅはモーセに言,いわれた、「わたしは主,しゅである。わたしがあなたに語,かたることは、みなエジプトの王,おうパロに語,かたりなさい」。","tok":[["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"],["「"],["わたし"],["は"],["主","しゅ"],["で"],["ある"],["。"],["わたし"],["が"],["あなた"],["に"],["語る","かたる"],["こと"],["は"],["、"],["みな"],["エジプト"],["の"],["王","おう"],["パロ"],["に"],["語り","かたり"],["なさい"],["」"],["。"]]},{"verse":30,"text":"しかしモーセは主,しゅにむかって言,いった、「ごらんのとおり、わたしは、くちびるに割礼,かつれいのない者,ものです。パロがどうしてわたしの言,いうことを聞,ききいれましょうか」。","tok":[["しかし"],["モーセ"],["は"],["主に","しゅに"],["むか"],["って"],["言った","いった"],["、"],["「"],["ごらん"],["の"],["とおり"],["、"],["わたし"],["は"],["、"],["くちびる"],["に"],["割礼","かつれい"],["の"],["ない"],["者","もの"],["です"],["。"],["パロ"],["が"],["どう"],["して"],["わたし"],["の"],["言う","いう"],["こと"],["を"],["聞きいれましょう","ききいれましょう"],["か"],["」"],["。"]]}]
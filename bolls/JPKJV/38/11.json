[{"verse":1,"text":"レバノンよ、おまえの門,もんを開,ひらき、おまえの香柏,こうはくを火,ひに焼,やき滅,ほろぼさせよ。","tok":[["レバノン"],["よ"],["、"],["おまえ"],["の"],["門","もん"],["を"],["開らき","ひらき"],["、"],["おまえ"],["の"],["香","こう"],["柏","かしわ"],["を"],["火","ひ"],["に"],["焼き滅ぼさせ","やきほろぼさせ"],["よ"],["。"]]},{"verse":2,"text":"いとすぎよ、泣,なき叫,さけべ。香柏,こうはくは倒,たおれ、みごとな木,きは、そこなわれたからである。バシャンのかしよ、泣,なき叫,さけべ。茂,しげった林,はやしは倒,たおれたからである。","tok":[["いと"],["すぎよ"],["、"],["泣","なき"],["叫けべ","さけべ"],["。"],["香","こう"],["柏","かしわ"],["は"],["倒れ","たおれ"],["、"],["みごと"],["な"],["木","き"],["は"],["、"],["そこなわれた"],["から"],["で"],["ある"],["。"],["バシャン"],["の"],["かし"],["よ"],["、"],["泣","なき"],["叫けべ","さけべ"],["。"],["茂った","しげった"],["林","はやし"],["は"],["倒れた","たおれた"],["から"],["で"],["ある"],["。"]]},{"verse":3,"text":"聞,きけ、牧者,ぼくしゃの泣,なき叫,さけぶ声,こえを。彼,かれらの栄,さかえが消,きえ去,さったからである。聞,きけ、ししのほえる声,こえを。ヨルダンの草,くさむらが荒,あれ果,はてたからである。","tok":[["聞け","きけ"],["、"],["牧者","ぼくしゃ"],["の"],["泣","なき"],["叫けぶ","さけぶ"],["声","こえ"],["を"],["。"],["彼","かれ"],["ら"],["の"],["栄","さかえ"],["が"],["消え","きえ"],["去た","さった"],["から"],["で"],["ある"],["。"],["聞け","きけ"],["、"],["しし"],["の"],["ほえる"],["声","こえ"],["を"],["。"],["ヨルダン"],["の"],["草むら","くさむら"],["が"],["荒れ果てた","あれはてた"],["から"],["で"],["ある"],["。"]]},{"verse":4,"text":"わが神,かみ、主,しゅはこう仰,おおせられた、「ほふらるべき羊,ひつじの群,むれの牧者,ぼくしゃとなれ。","tok":[["わが"],["神","かみ"],["、"],["主","しゅ"],["は"],["こう"],["仰せられた","おおせられた"],["、"],["「"],["ほふらるべき"],["羊","ひつじ"],["の"],["群れ","むれ"],["の"],["牧者","ぼくしゃ"],["と"],["なれ"],["。"]]},{"verse":5,"text":"これを買,かう者,ものは、これをほふっても罰,ばっせられない。これを売,うる者,ものは言,いう、『主,しゅはほむべきかな、わたしは富,とんだ』と。そしてその牧者,ぼくしゃは、これをあわれまない。","tok":[["これ"],["を"],["買う","かう"],["者","もの"],["は"],["、"],["これ"],["を"],["ほふって"],["も"],["罰せられない","ばっせられない"],["。"],["これ"],["を"],["売る","うる"],["者","もの"],["は"],["言う","いう"],["、"],["『"],["主","しゅ"],["は"],["ほ"],["むべき"],["か"],["な"],["、"],["わたし"],["は"],["富んだ","とんだ"],["』"],["と"],["。"],["そして"],["その"],["牧者","ぼくしゃ"],["は"],["、"],["これ"],["を"],["あわれまない"],["。"]]},{"verse":6,"text":"わたしは、もはやこの地,ちの住民,じゅうみんをあわれまないと、主,しゅは言,いわれる。見,みよ、わたしは人,ひとをおのおのその牧者,ぼくしゃの手,てに渡,わたし、おのおのその王,おうの手,てに渡,わたす。彼,かれらは地,ちを荒,あらす。わたしは彼,かれらの手,てからこれを救,すくい出,ださない」。","tok":[["わたし"],["は"],["、"],["もはや"],["この"],["地","ち"],["の"],["住民","じゅうみん"],["を"],["あわれまない"],["と"],["、"],["主","しゅ"],["は"],["言われる","いわれる"],["。"],["見よ","みよ"],["、"],["わたし"],["は"],["人","ひと"],["を"],["おのおの"],["その"],["牧者","ぼくしゃ"],["の"],["手","て"],["に"],["渡","わたし"],["、"],["おのおの"],["その"],["王","おう"],["の"],["手","て"],["に"],["渡す","わたす"],["。"],["彼","かれ"],["ら"],["は"],["地","ち"],["を"],["荒す","あらす"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["手","て"],["から"],["これ"],["を"],["救い出さない","すくいださない"],["」"],["。"]]},{"verse":7,"text":"わたしは羊,ひつじの商人,しょうにんのために、ほふらるべき羊,ひつじの群,むれの牧者,ぼくしゃとなった。わたしは二本,ほんのつえを取,とり、その一本,ぽんを恵,めぐみと名,なづけ、一本,ぽんを結,むすびと名,なづけて、その羊,ひつじを牧,ぼくした。","tok":[["わたし"],["は"],["羊","ひつじ"],["の"],["商人","しょうにん"],["の"],["ため"],["に"],["、"],["ほふらるべき"],["羊","ひつじ"],["の"],["群れ","むれ"],["の"],["牧者","ぼくしゃ"],["と"],["なった"],["。"],["わたし"],["は"],["二本","ほん"],["の"],["つえ"],["を"],["取","とり"],["、"],["その"],["一本","ぽん"],["を"],["恵","めぐみ"],["と"],["名づけ","なづけ"],["、"],["一本","ぽん"],["を"],["結び","むすび"],["と"],["名づけて","なづけて"],["、"],["その"],["羊","ひつじ"],["を"],["牧","ぼ"],["くし"],["た"],["。"]]},{"verse":8,"text":"わたしは一か月,げつに牧者,ぼくしゃ三人,にんを滅,ほろぼした。わたしは彼,かれらに、がまんしきれなくなったが、彼,かれらもまた、わたしを忌,いみきらった。","tok":[["わたし"],["は"],["一","いち"],["か月","かげつ"],["に"],["牧者","ぼくしゃ"],["三人","にん"],["を"],["滅ぼした","ほろぼした"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["に"],["、"],["がまん"],["し"],["きれなく"],["なった"],["が"],["、"],["彼","かれ"],["ら"],["も"],["また"],["、"],["わたし"],["を"],["忌","いみ"],["きらった"],["。"]]},{"verse":9,"text":"それでわたしは言,いった、「わたしはあなたがたの牧者,ぼくしゃとならない。死,しぬ者,ものは死,しに、滅,ほろびる者,ものは滅,ほろび、残,のこった者,ものはたがいにその肉,にくを食,くいあうがよい」。","tok":[["それ"],["で"],["わたし"],["は"],["言った","いった"],["、"],["「"],["わたし"],["は"],["あなた"],["がた"],["の"],["牧者","ぼくしゃ"],["と"],["ならない"],["。"],["死ぬ","しぬ"],["者","もの"],["は"],["死に","しに"],["、"],["滅びる","ほろびる"],["者","もの"],["は"],["滅び","ほろび"],["、"],["残った","のこった"],["者","もの"],["は"],["たがい"],["に"],["その"],["肉","にく"],["を"],["食いあう","くいあう"],["が"],["よい"],["」"],["。"]]},{"verse":10,"text":"わたしは恵,めぐみというつえを取,とって、これを折,おった。これはわたしがもろもろの民,たみと結,むすんだ契約,けいやくを、廃,はいするためであった。","tok":[["わたし"],["は"],["恵","めぐみ"],["と"],["いう"],["つえ"],["を"],["取って","とって"],["、"],["これ"],["を"],["折った","おった"],["。"],["これ"],["は"],["わたし"],["が"],["もろもろ"],["の"],["民","たみ"],["と"],["結んだ","むすんだ"],["契約","けいやく"],["を"],["、"],["廃する","はいする"],["ため"],["で"],["あった"],["。"]]},{"verse":11,"text":"そしてこれは、その日,ひに廃,はいされた。そこで、わたしに目,めを注,そそいでいた羊,ひつじの商人,しょうにんらは、これが主,しゅの言葉,ことばであったことを知,しった。","tok":[["そして"],["これ"],["は"],["、"],["その"],["日","ひ"],["に"],["廃された","はいされた"],["。"],["そこ"],["で"],["、"],["わたし"],["に"],["目","め"],["を"],["注いで","そそいで"],["いた"],["羊","ひつじ"],["の"],["商人","しょうにん"],["ら"],["は"],["、"],["これ"],["が"],["主","しゅ"],["の"],["言葉","ことば"],["で"],["あった"],["こと"],["を"],["知った","しった"],["。"]]},{"verse":12,"text":"わたしは彼,かれらに向,むかって、「あなたがたがもし、よいと思,おもうならば、わたしに賃銀,ちんぎんを払,はらいなさい。もし、いけなければやめなさい」と言,いったので、彼,かれらはわたしの賃銀,ちんぎんとして、銀,ぎん三十シケルを量,はかった。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["に"],["向かって","むかって"],["、"],["「"],["あなた"],["がた"],["が"],["もし"],["、"],["よい"],["と"],["思うならば","おもうならば"],["、"],["わたし"],["に"],["賃銀","ちんぎん"],["を"],["払","はらい"],["なさい"],["。"],["もし"],["、"],["いけなければ"],["やめ"],["なさい"],["」"],["と"],["言った","いった"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["わたし"],["の"],["賃銀","ちんぎん"],["として"],["、"],["銀","ぎん"],["三十","さんじゅう"],["シケル"],["を"],["量った","はかった"],["。"]]},{"verse":13,"text":"主,しゅはわたしに言,いわれた、「彼,かれらによって、わたしが値,ね積,つられたその尊,たっとい価,あたいを、宮,みやのさいせん箱,はこに投,なげ入,いれよ」。わたしは銀,ぎん三十シケルを取,とって、これを主,しゅの宮,みやのさいせん箱,はこに投,なげ入,いれた。","tok":[["主","しゅ"],["は"],["わたし"],["に"],["言われた","いわれた"],["、"],["「"],["彼","かれ"],["ら"],["によって"],["、"],["わたし"],["が"],["値","ね"],["積","つられたそ"],["の"],["尊","た"],["っと"],["い"],["価","あたい"],["を"],["、"],["宮","みや"],["の"],["さいせん"],["箱","はこ"],["に"],["投入れよ","なげいれよ"],["」"],["。"],["わたし"],["は"],["銀","ぎん"],["三十","さんじゅう"],["シケル"],["を"],["取って","とって"],["、"],["これ"],["を"],["主","しゅ"],["の"],["宮","みや"],["の"],["さいせん"],["箱","はこ"],["に"],["投入れた","なげいれた"],["。"]]},{"verse":14,"text":"そしてわたしは結,むすびという第,だい二のつえを折,おった。これはユダとイスラエルの間,あいだの、兄弟,きょうだい関係,かんけいを廃,はいするためであった。","tok":[["そして"],["わたし"],["は"],["結び","むすび"],["と"],["いう"],["第","だい"],["二","に"],["の"],["つえ"],["を"],["折った","おった"],["。"],["これ"],["は"],["ユダ"],["と"],["イスラエル"],["の"],["間","あいだ"],["の"],["、"],["兄弟","きょうだい"],["関係","かんけい"],["を"],["廃する","はいする"],["ため"],["で"],["あった"],["。"]]},{"verse":15,"text":"主,しゅはわたしに言,いわれた、「おまえはまた愚,おろかな牧者,ぼくしゃの器,うつわを取,とれ。","tok":[["主","しゅ"],["は"],["わたし"],["に"],["言われた","いわれた"],["、"],["「"],["おまえ"],["は"],["また"],["愚か","おろか"],["な"],["牧者","ぼくしゃ"],["の"],["器","うつわ"],["を"],["取れ","とれ"],["。"]]},{"verse":16,"text":"見,みよ、わたしは地,ちにひとりの牧者,ぼくしゃを起,おこす。彼,かれは滅,ほろぼされる者,ものを顧,かえりみず、迷,まよえる者,ものを尋,たずねず、傷,きずついた者,ものをいやさず、健,すこやかな者,ものを養,やしなわず、肥,こえた者,ものの肉,にくを食,くらい、そのひずめをさえ裂,さく者,ものである。","tok":[["見よ","みよ"],["、"],["わたし"],["は"],["地","ち"],["に"],["ひとり"],["の"],["牧者","ぼくしゃ"],["を"],["起こす","おこす"],["。"],["彼","かれ"],["は"],["滅ぼされる","ほろぼされる"],["者","もの"],["を"],["顧ず","かえりみず"],["、"],["迷える","まよえる"],["者","もの"],["を"],["尋ねず","たずねず"],["、"],["傷ついた","きずついた"],["者","もの"],["を"],["いやさず"],["、"],["健やか","すこやか"],["な"],["者","もの"],["を"],["養わず","やしなわず"],["、"],["肥","こえ"],["た"],["者","もの"],["の"],["肉","にく"],["を"],["食らい","くらい"],["、"],["その"],["ひずめ"],["を"],["さえ"],["裂く","さく"],["者","もの"],["で"],["ある"],["。"]]},{"verse":17,"text":"その羊,ひつじの群,むれを捨,すてる愚,おろかな牧者,ぼくしゃはわざわいだ。どうか、つるぎがその腕,うでを撃,うち、その右,みぎの目,めを撃,うつように。その腕,うでは全,まったく衰,おとろえ、その右,みぎの目,めは全,まったく見,みえなくなるように」。","tok":[["その"],["羊","ひつじ"],["の"],["群れ","むれ"],["を"],["捨てる","すてる"],["愚か","おろか"],["な"],["牧者","ぼくしゃ"],["は"],["わざわい"],["だ"],["。"],["どう"],["か"],["、"],["つるぎ"],["が"],["その"],["腕","うで"],["を"],["撃ち","うち"],["、"],["その"],["右","みぎ"],["の"],["目","め"],["を"],["撃つ","うつ"],["よう"],["に"],["。"],["その"],["腕","うで"],["は"],["全く","まったく"],["衰え","おとろえ"],["、"],["その"],["右","みぎ"],["の"],["目","め"],["は"],["全く","まったく"],["見えなく","みえなく"],["なる"],["よう"],["に"],["」"],["。"]]}]
[{"verse":1,"text":"わたしと語,かたった天,てんの使,つかいがまた来,きて、わたしを呼,よびさました。わたしは眠,ねむりから呼,よびさまされた人,ひとのようであった。","tok":[["わたし"],["と"],["語った","かたった"],["天","てん"],["の"],["使","つかい"],["が"],["また"],["来て","きて"],["、"],["わたし"],["を"],["呼びさました","よびさました"],["。"],["わたし"],["は"],["眠","ねむり"],["から"],["呼びさまされた","よびさまされた"],["人","ひと"],["の"],["よう"],["で"],["あった"],["。"]]},{"verse":2,"text":"彼,かれがわたしに向,むかって「何,なにを見,みるか」と言,いったので、わたしは言,いった、「わたしが見,みていると、すべて金,きんで造,つくられた燭台,しょくだいが一つあって、その上,うえに油,あぶらを入,いれる器,うつわがあり、また燭台,しょくだいの上,うえに七つのともしび皿,さらがあり、そのともしび皿,さらは燭台,しょくだいの上,うえにあって、これにおのおの七本,ほんずつの管,かんがあります。","tok":[["彼","かれ"],["が"],["わたし"],["に"],["向かって","むかって"],["「"],["何に","なに"],["を"],["見る","みる"],["か"],["」"],["と"],["言った","いった"],["ので"],["、"],["わたし"],["は"],["言った","いった"],["、"],["「"],["わたし"],["が"],["見て","みて"],["いる"],["と"],["、"],["すべて"],["金","きん"],["で"],["造られた","つくられた"],["燭台","しょくだい"],["が"],["一","ひと"],["つ"],["あって"],["、"],["その"],["上","うえ"],["に"],["油","あぶら"],["を"],["入れる","いれる"],["器","うつわ"],["が"],["あり"],["、"],["また"],["燭台","しょくだい"],["の"],["上","うえ"],["に"],["七","なな"],["つ"],["の"],["ともしび"],["皿","さら"],["が"],["あり"],["、"],["その"],["ともしび"],["皿","さら"],["は"],["燭台","しょくだい"],["の"],["上","うえ"],["に"],["あって"],["、"],["これ"],["に"],["おのおの"],["七本","ほんずつ"],["の"],["管","かん"],["が"],["あります"],["。"]]},{"verse":3,"text":"また燭台,しょくだいのかたわらに、オリブの木,きが二本,ほんあって、一本,ぽんは油,あぶらをいれる器,うつわの右,みぎにあり、一本,ぽんはその左,ひだりにあります」。","tok":[["また"],["燭台","しょくだい"],["の"],["かたわら"],["に"],["、"],["オリブ"],["の"],["木","き"],["が"],["二本","ほん"],["あって"],["、"],["一本","ぽん"],["は"],["油","あぶら"],["を"],["いれる"],["器","うつわ"],["の"],["右","みぎ"],["に"],["あり"],["、"],["一本","ぽん"],["は"],["その"],["左","ひだり"],["に"],["あります"],["」"],["。"]]},{"verse":4,"text":"わたしはまたわたしと語,かたる天,てんの使,つかいに言,いった、「わが主,しゅよ、これらはなんですか」。","tok":[["わたし"],["は"],["また"],["わたし"],["と"],["語る","かたる"],["天","てん"],["の"],["使","つかい"],["に"],["言った","いった"],["、"],["「"],["わが"],["主","しゅ"],["よ"],["、"],["これ"],["ら"],["は"],["なん"],["です"],["か"],["」"],["。"]]},{"verse":5,"text":"わたしと語,かたる天,てんの使,つかいは答,こたえて、「あなたはそれがなんであるか知,しらないのですか」と言,いったので、わたしは「わが主,しゅよ、知,しりません」と言,いった。","tok":[["わたし"],["と"],["語る","かたる"],["天","てん"],["の"],["使い","つかい"],["は"],["答","こたえ"],["て"],["、"],["「"],["あなた"],["は"],["それ"],["が"],["なん"],["で"],["ある"],["か"],["知らない","しらない"],["の"],["です"],["か"],["」"],["と"],["言った","いった"],["ので"],["、"],["わたし"],["は"],["「"],["わが"],["主","しゅ"],["よ"],["、"],["知りません","しりません"],["」"],["と"],["言った","いった"],["。"]]},{"verse":6,"text":"すると彼,かれはわたしに言,いった、「ゼルバベルに、主,しゅがお告,つげになる言葉,ことばはこれです。万軍,ばんぐんの主,しゅは仰,おおせられる、これは権勢,けんせいによらず、能力,のうりょくによらず、わたしの霊,れいによるのである。","tok":[["する"],["と"],["彼","かれ"],["は"],["わたし"],["に"],["言った","いった"],["、"],["「"],["ゼルバベル"],["に"],["、"],["主","しゅ"],["が"],["お告","おつげ"],["に"],["なる"],["言葉","ことば"],["は"],["これ"],["です"],["。"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["仰せられる","おおせられる"],["、"],["これ"],["は"],["権勢","けんせい"],["に"],["よらず"],["、"],["能力","のうりょく"],["に"],["よらず"],["、"],["わたし"],["の"],["霊","れい"],["に"],["よる"],["ので"],["ある"],["。"]]},{"verse":7,"text":"大,おおいなる山,やまよ、おまえは何者,なにものか。おまえはゼルバベルの前,まえに平地,へいちとなる。彼,かれは『恵,めぐみあれ、これに恵,めぐみあれ』と呼,よばわりながら、かしら石,いしを引,ひき出,だすであろう」。","tok":[["大いなる","おおいなる"],["山","やま"],["よ"],["、"],["おまえ"],["は"],["何者","なにもの"],["か"],["。"],["おまえ"],["は"],["ゼルバベル"],["の"],["前","まえ"],["に"],["平地","へいち"],["と"],["なる"],["。"],["彼","かれ"],["は"],["『"],["恵","めぐみ"],["あれ"],["、"],["これ"],["に"],["恵","めぐみ"],["あれ"],["』"],["と"],["呼ばわり","よばわり"],["ながら"],["、"],["かしら"],["石","いし"],["を"],["引出すで","ひきだすで"],["あろう"],["」"],["。"]]},{"verse":8,"text":"主,しゅの言葉,ことばがわたしに臨,のぞんで言,いうには、","tok":[["主","しゅ"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んで","のぞんで"],["言","いう"],["に"],["は"],["、"]]},{"verse":9,"text":"「ゼルバベルの手,てはこの宮,みやの礎,いしずえをすえた。彼,かれの手,てはこれを完成,かんせいする。その時,ときあなたがたは万軍,ばんぐんの主,しゅが、わたしをあなたがたにつかわされたことを知,しる。","tok":[["「"],["ゼルバベル"],["の"],["手","て"],["は"],["この"],["宮","みや"],["の"],["礎","いしずえ"],["を"],["すえた"],["。"],["彼","かれ"],["の"],["手","て"],["は"],["これ"],["を"],["完成","かんせい"],["する"],["。"],["その"],["時","とき"],["あなた"],["がた"],["は"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["が"],["、"],["わたし"],["を"],["あなた"],["がた"],["に"],["つかわされた"],["こと"],["を"],["知る","しる"],["。"]]},{"verse":10,"text":"だれでも小,ちいさい事,ことの日,ひをいやしめた者,ものは、ゼルバベルの手,てに、下,さげ振,ふりのあるのを見,みて、喜,よろこぶ。これらの七つのものは、あまねく全,ぜん地,ちを行,いき来,きする主,しゅの目,めである」。","tok":[["だれ"],["で"],["も"],["小さい","ちいさい"],["事","こと"],["の"],["日","ひ"],["を"],["いやしめた"],["者","もの"],["は"],["、"],["ゼルバベル"],["の"],["手","て"],["に"],["、"],["下げ振り","さげふり"],["の"],["ある"],["の"],["を"],["見て","みて"],["、"],["喜こぶ","よろこぶ"],["。"],["これ"],["ら"],["の"],["七","なな"],["つ"],["の"],["もの"],["は"],["、"],["あまねく"],["全地","ぜんち"],["を"],["行き来","いきき"],["する"],["主","しゅ"],["の"],["目","め"],["で"],["ある"],["」"],["。"]]},{"verse":11,"text":"わたしはまた彼,かれに尋,たずねて、「燭台,しょくだいの左右,さゆうにある、この二本,ほんのオリブの木,きはなんですか」と言,いい、","tok":[["わたし"],["は"],["また"],["彼","かれ"],["に"],["尋ねて","たずねて"],["、"],["「"],["燭台","しょくだい"],["の"],["左右","さゆう"],["に"],["ある"],["、"],["この"],["二本","ほん"],["の"],["オリブ"],["の"],["木","き"],["は"],["なん"],["です"],["か"],["」"],["と"],["言い","いい"],["、"]]},{"verse":12,"text":"重,かさねてまた「この二本,ほんの金,きんの管,くだによって、油,あぶらをそれから注,そそぎ出,だすオリブの二枝,えだはなんですか」と言,いうと、","tok":[["重ねて","かさねて"],["また"],["「"],["この"],["二本","ほん"],["の"],["金","きん"],["の"],["管","くだ"],["によって"],["、"],["油","あぶら"],["を"],["それ"],["から"],["注ぎ","そそぎ"],["出す","だす"],["オリブ"],["の"],["二枝","えだ"],["は"],["なん"],["です"],["か"],["」"],["と"],["言","いう"],["と"],["、"]]},{"verse":13,"text":"彼,かれはわたしに答,こたえて、「あなたはそれがなんであるか知,しらないのですか」と言,いったので、「わが主,しゅよ、知,しりません」と言,いった。","tok":[["彼","かれ"],["は"],["わたし"],["に"],["答","こたえ"],["て"],["、"],["「"],["あなた"],["は"],["それ"],["が"],["なん"],["で"],["ある"],["か"],["知らない","しらない"],["の"],["です"],["か"],["」"],["と"],["言った","いった"],["ので"],["、"],["「"],["わが"],["主","しゅ"],["よ"],["、"],["知りません","しりません"],["」"],["と"],["言った","いった"],["。"]]},{"verse":14,"text":"すると彼,かれは言,いった、「これらはふたりの油,あぶらそそがれた者,もので、全,ぜん地,ちの主,しゅのかたわらに立,たつ者,ものです」。","tok":[["する"],["と"],["彼","かれ"],["は"],["言った","いった"],["、"],["「"],["これ"],["ら"],["は"],["ふたり"],["の"],["油","あぶら"],["そそがれた"],["者","もの"],["で"],["、"],["全地","ぜんち"],["の"],["主","しゅ"],["の"],["かたわら"],["に"],["立つ","たつ"],["者","もの"],["です"],["」"],["。"]]}]
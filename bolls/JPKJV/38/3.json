[{"verse":1,"text":"時,ときに主,しゅは大,だい祭司,さいしヨシュアが、主,しゅの使,つかいの前,まえに立,たち、サタンがその右,みぎに立,たって、これを訴,うったえているのをわたしに示,しめされた。","tok":[["時","とき"],["に"],["主","しゅ"],["は"],["大","だい"],["祭司","さいし"],["ヨシュア"],["が"],["、"],["主","しゅ"],["の"],["使","つかい"],["の"],["前","まえ"],["に"],["立ち","たち"],["、"],["サタン"],["が"],["その"],["右","みぎ"],["に"],["立って","たって"],["、"],["これ"],["を"],["訴て","うったえて"],["いる"],["の"],["を"],["わたし"],["に"],["示めされた","しめされた"],["。"]]},{"verse":2,"text":"主,しゅはサタンに言,いわれた、「サタンよ、主,しゅはあなたを責,せめるのだ。すなわちエルサレムを選,えらんだ主,しゅはあなたを責,せめるのだ。これは火,ひの中,なかから取,とり出,だした燃,もえさしではないか」。","tok":[["主","しゅ"],["は"],["サタン"],["に"],["言われた","いわれた"],["、"],["「"],["サタン"],["よ"],["、"],["主","しゅ"],["は"],["あなた"],["を"],["責","せめ"],["る"],["の"],["だ"],["。"],["すなわち"],["エルサレム"],["を"],["選らんだ","えらんだ"],["主","しゅ"],["は"],["あなた"],["を"],["責","せめ"],["る"],["の"],["だ"],["。"],["これ"],["は"],["火","ひ"],["の"],["中","なか"],["から"],["取出した","とりだした"],["燃えさし","もえさし"],["で"],["は"],["ない"],["か"],["」"],["。"]]},{"verse":3,"text":"ヨシュアは汚,けがれた衣,ころもを着,きて、み使,つかいの前,まえに立,たっていたが、","tok":[["ヨシュア"],["は"],["汚","け"],["がれ"],["た"],["衣","ころも"],["を"],["着て","きて"],["、"],["み使","みつかい"],["の"],["前","まえ"],["に"],["立って","たって"],["いた"],["が"],["、"]]},{"verse":4,"text":"み使,つかいは自分,じぶんの前,まえに立,たっている者,ものどもに言,いった、「彼,かれの汚,けがれた衣,ころもを脱,ぬがせなさい」。またヨシュアに向,むかって言,いった、「見,みよ、わたしはあなたの罪,つみを取,とり除,のぞいた。あなたに祭服,さいふくを着,きせよう」。","tok":[["み使い","みつかい"],["は"],["自分","じぶん"],["の"],["前","まえ"],["に"],["立って","たって"],["いる"],["者","もの"],["ども"],["に"],["言った","いった"],["、"],["「"],["彼","かれ"],["の"],["汚","け"],["がれ"],["た"],["衣","ころも"],["を"],["脱がせ","ぬがせ"],["なさい"],["」"],["。"],["また"],["ヨシュア"],["に"],["向かって","むかって"],["言った","いった"],["、"],["「"],["見よ","みよ"],["、"],["わたし"],["は"],["あなた"],["の"],["罪","つみ"],["を"],["取除いた","とりのぞいた"],["。"],["あなた"],["に"],["祭服","さいふく"],["を"],["着せよう","きせよう"],["」"],["。"]]},{"verse":5,"text":"わたしは言,いった、「清,きよい帽子,ぼうしを頭,あたまにかぶらせなさい」。そこで清,きよい帽子,ぼうしを頭,あたまにかぶらせ、衣,ころもを彼,かれに着,きせた。主,しゅの使,つかいはかたわらに立,たっていた。","tok":[["わたし"],["は"],["言った","いった"],["、"],["「"],["清い","きよい"],["帽子","ぼうし"],["を"],["頭","あたま"],["に"],["かぶらせ"],["なさい"],["」"],["。"],["そこ"],["で"],["清い","きよい"],["帽子","ぼうし"],["を"],["頭","あたま"],["に"],["かぶらせ"],["、"],["衣","ころも"],["を"],["彼","かれ"],["に"],["着せた","きせた"],["。"],["主","しゅ"],["の"],["使い","つかい"],["は"],["かたわら"],["に"],["立って","たって"],["いた"],["。"]]},{"verse":6,"text":"主,しゅの使,つかいは、ヨシュアを戒,いましめて言,いった、","tok":[["主","しゅ"],["の"],["使い","つかい"],["は"],["、"],["ヨシュア"],["を"],["戒しめ","いましめ"],["て"],["言った","いった"],["、"]]},{"verse":7,"text":"「万軍,ばんぐんの主,しゅは、こう仰,おおせられる、あなたがもし、わたしの道,みちに歩,あゆみ、わたしの務,つとめを守,まもるならば、わたしの家,いえをつかさどり、わたしの庭,にわを守,まもることができる。わたしはまた、ここに立,たっている者,ものどもの中,なかに行,いき来,きすることを得,えさせる。","tok":[["「"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["、"],["こう"],["仰せられる","おおせられる"],["、"],["あなた"],["が"],["もし"],["、"],["わたし"],["の"],["道","みち"],["に"],["歩み","あゆみ"],["、"],["わたし"],["の"],["務め","つとめ"],["を"],["守","まもる"],["ならば"],["、"],["わたし"],["の"],["家","いえ"],["を"],["つかさどり"],["、"],["わたし"],["の"],["庭","にわ"],["を"],["守","まもる"],["こと"],["が"],["できる"],["。"],["わたし"],["は"],["また"],["、"],["ここ"],["に"],["立って","たって"],["いる"],["者","もの"],["ども"],["の"],["中","なか"],["に"],["行き来","いきき"],["する"],["こと"],["を"],["得させる","えさせる"],["。"]]},{"verse":8,"text":"大,だい祭司,さいしヨシュアよ、あなたも、あなたの前,まえにすわっている同僚,どうりょうたちも聞,ききなさい。彼,かれらはよいしるしとなるべき人々,ひとびとだからである。見,みよ、わたしはわたしのしもべなる枝,えだを生,しょうじさせよう。","tok":[["大","だい"],["祭司","さいし"],["ヨシュア"],["よ"],["、"],["あなた"],["も"],["、"],["あなた"],["の"],["前","まえ"],["に"],["すわって"],["いる"],["同僚","どうりょう"],["たち"],["も"],["聞","きき"],["なさい"],["。"],["彼","かれ"],["ら"],["は"],["よい"],["しるし"],["と"],["なるべき"],["人々","ひとびと"],["だ"],["から"],["で"],["ある"],["。"],["見よ","みよ"],["、"],["わたし"],["は"],["わたし"],["の"],["しもべ"],["なる"],["枝","えだ"],["を"],["生じさせよう","しょうじさせよう"],["。"]]},{"verse":9,"text":"万軍,ばんぐんの主,しゅは言,いわれる、見,みよ、ヨシュアの前,まえにわたしが置,おいた石,いしの上,うえに、すなわち七つの目,めをもっているこの一つの石,いしの上,うえに、わたしはみずから文字,もじを彫刻,ちょうこくする。そしてわたしはこの地,ちの罪,つみを、一日,にちの内,うちに取,とり除,のぞく。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["言われる","いわれる"],["、"],["見よ","みよ"],["、"],["ヨシュア"],["の"],["前","まえ"],["に"],["わたし"],["が"],["置いた","おいた"],["石","いし"],["の"],["上","うえ"],["に"],["、"],["すなわち"],["七","なな"],["つ"],["の"],["目","め"],["を"],["もって"],["いる"],["この"],["一","ひと"],["つ"],["の"],["石","いし"],["の"],["上","うえ"],["に"],["、"],["わたし"],["は"],["みずから"],["文字","もじ"],["を"],["彫刻","ちょうこく"],["する"],["。"],["そして"],["わたし"],["は"],["この"],["地","ち"],["の"],["罪","つみ"],["を"],["、"],["一","いち"],["日","にち"],["の"],["内","うち"],["に"],["取除く","とりのぞく"],["。"]]},{"verse":10,"text":"万軍,ばんぐんの主,しゅは言,いわれる、その日,ひには、あなたがたはめいめいその隣,となり人,びとを招,まねいて、ぶどうの木,きの下,した、いちじくの木,きの下,したに座,ざすのである」。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["言われる","いわれる"],["、"],["その"],["日","ひ"],["に"],["は"],["、"],["あなた"],["がた"],["は"],["めいめい"],["その"],["隣人","となりびと"],["を"],["招いて","まねいて"],["、"],["ぶどう"],["の"],["木","き"],["の"],["下","した"],["、"],["いちじく"],["の"],["木","き"],["の"],["下","した"],["に"],["座す","ざす"],["ので"],["ある"],["」"],["。"]]}]
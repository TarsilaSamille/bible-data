[{"verse":1,"text":"ダリヨスの第,だい二年,ねんの八月,がつに、主,しゅの言葉,ことばがイドの子,こベレキヤの子,こである預言者,よげんしゃゼカリヤに臨,のぞんだ、","tok":[["ダリヨス"],["の"],["第","だい"],["二","に"],["年","ねん"],["の"],["八","はち"],["月","がつ"],["に"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["が"],["イド"],["の"],["子","こ"],["ベレキヤ"],["の"],["子","こ"],["で"],["ある"],["預言者","よげんしゃ"],["ゼカリヤ"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":2,"text":"「主,しゅはあなたがたの先祖,せんぞたちに対,たいして、いたくお怒,いかりになった。","tok":[["「"],["主","しゅ"],["は"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["たち"],["に対して","にたいして"],["、"],["いたく"],["お怒り","おいかり"],["に"],["なった"],["。"]]},{"verse":3,"text":"それゆえ、万軍,ばんぐんの主,しゅはこう仰,おおせられると、彼,かれらに告,つげよ。万軍,ばんぐんの主,しゅは仰,おおせられる、わたしに帰,かえれ、そうすれば、わたしもあなたがたに帰,かえろうと、万軍,ばんぐんの主,しゅは仰,おおせられる。","tok":[["それ"],["ゆえ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["こう"],["仰せられる","おおせられる"],["と"],["、"],["彼","かれ"],["ら"],["に"],["告","つげ"],["よ"],["。"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["仰せられる","おおせられる"],["、"],["わたし"],["に"],["帰えれ","かえれ"],["、"],["そう"],["すれば"],["、"],["わたし"],["も"],["あなた"],["がた"],["に"],["帰えろう","かえろう"],["と"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["仰せられる","おおせられる"],["。"]]},{"verse":4,"text":"あなたがたの先祖,せんぞたちのようであってはならない。先,さきの預言者,よげんしゃたちは、彼,かれらにむかって叫,さけんで言,いった、『万軍,ばんぐんの主,しゅはこう仰,おおせられる、悪,わるい道,みちを離,はなれ、悪,わるいおこないを捨,すてて帰,かえれ』と。しかし彼,かれらは聞,ききいれず、耳,みみをわたしに傾,かたむけなかったと主,しゅは言,いわれる。","tok":[["あなた"],["がた"],["の"],["先祖","せんぞ"],["たち"],["の"],["よう"],["で"],["あって"],["は"],["ならない"],["。"],["先","さき"],["の"],["預言者","よげんしゃ"],["たち"],["は"],["、"],["彼","かれ"],["ら"],["に"],["むかって"],["叫けんで","さけんで"],["言った","いった"],["、"],["『"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["こう"],["仰せられる","おおせられる"],["、"],["悪い","わるい"],["道","みち"],["を"],["離れ","はなれ"],["、"],["悪い","わるい"],["おこない"],["を"],["捨てて","すてて"],["帰えれ","かえれ"],["』"],["と"],["。"],["しかし"],["彼","かれ"],["ら"],["は"],["聞きいれず","ききいれず"],["、"],["耳","みみ"],["を"],["わたし"],["に"],["傾むけなかった","かたむけなかった"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":5,"text":"あなたがたの先祖,せんぞたち、彼,かれらはどこにいるか。預言者,よげんしゃたち、彼,かれらは永遠,えいえんに生,いきているのか。","tok":[["あなた"],["がた"],["の"],["先祖","せんぞ"],["たち"],["、"],["彼","かれ"],["ら"],["は"],["どこ"],["に"],["いる"],["か"],["。"],["預言者","よげんしゃ"],["たち"],["、"],["彼","かれ"],["ら"],["は"],["永遠","えいえん"],["に"],["生きて","いきて"],["いる"],["の"],["か"],["。"]]},{"verse":6,"text":"しかしわたしのしもべである預言者,よげんしゃたちに命,めいじたわが言葉,ことばと、わが定,さだめとは、あなたがたの先祖,せんぞたちに及,およんだではないか。それで彼,かれらは立,たち返,かえって言,いった、『万軍,ばんぐんの主,しゅがわれわれの道,みちにしたがい、おこないに従,したがって、われわれに、なそうと思,おもい定,さだめられたように、そのとおりされたのだ』と」。","tok":[["しかし"],["わたし"],["の"],["しもべ"],["で"],["ある"],["預言者","よげんしゃ"],["たち"],["に"],["命じた","めいじた"],["わが"],["言葉","ことば"],["と"],["、"],["わが"],["定め","さだめ"],["と"],["は"],["、"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["たち"],["に"],["及","およんだ"],["で"],["は"],["ない"],["か"],["。"],["それ"],["で"],["彼","かれ"],["ら"],["は"],["立ち返って","たちかえって"],["言った","いった"],["、"],["『"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["が"],["われわれ"],["の"],["道","みち"],["に"],["したがい"],["、"],["おこない"],["に"],["従って","したがって"],["、"],["われわれ"],["に"],["、"],["なそう"],["と"],["思い定められた","おもいさだめられた"],["よう"],["に"],["、"],["その"],["とおり"],["された"],["の"],["だ"],["』"],["と"],["」"],["。"]]},{"verse":7,"text":"ダリヨスの第,だい二年,ねんの十一月,がつ、すなわちセバテという月,つきの二十四日,かに、主,しゅの言葉,ことばがイドの子,こベレキヤの子,こである預言者,よげんしゃゼカリヤに臨,のぞんだ。そしてゼカリヤは言,いった、","tok":[["ダリヨス"],["の"],["第","だい"],["二","に"],["年","ねん"],["の"],["十一","じゅういち"],["月","がつ"],["つ"],["、"],["すなわち"],["セバテ"],["と"],["いう"],["月","つき"],["の"],["二十四日","か"],["に"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["が"],["イド"],["の"],["子","こ"],["ベレキヤ"],["の"],["子","こ"],["で"],["ある"],["預言者","よげんしゃ"],["ゼカリヤ"],["に"],["臨んだ","のぞんだ"],["。"],["そして"],["ゼカリヤ"],["は"],["言った","いった"],["、"]]},{"verse":8,"text":"「わたしは夜,よる、見,みていると、ひとりの人,ひとが赤,あか馬,うまに乗,のって、谷間,たにまにあるミルトスの木,きの中,なかに立,たち、その後,うしろに赤,あか馬,うま、栗毛,くりげの馬,うま、白馬,しろうまがいた。","tok":[["「"],["わたし"],["は"],["夜","よる"],["、"],["見て","みて"],["いる"],["と"],["、"],["ひとり"],["の"],["人","ひと"],["が"],["赤馬","あかうま"],["に"],["乗って","のって"],["、"],["谷間","たにま"],["に"],["ある"],["ミルトス"],["の"],["木","き"],["の"],["中","なか"],["に"],["立ち","たち"],["、"],["その"],["後ろ","うしろ"],["に"],["赤馬","あかうま"],["、"],["栗毛","くりげ"],["の"],["馬","うま"],["、"],["白馬","しろうま"],["が"],["いた"],["。"]]},{"verse":9,"text":"その時,ときわたしが『わが主,しゅよ、これらはなんですか』と尋,たずねると、わたしと語,かたる天,てんの使,つかいは言,いった、『これがなんであるか、あなたに示,しめしましょう』。","tok":[["その"],["時","とき"],["わたし"],["が"],["『"],["わが"],["主","しゅ"],["よ"],["、"],["これ"],["ら"],["は"],["なん"],["です"],["か"],["』"],["と"],["尋ねる","たずねる"],["と"],["、"],["わたし"],["と"],["語る","かたる"],["天","てん"],["の"],["使い","つかい"],["は"],["言った","いった"],["、"],["『"],["これ"],["が"],["なん"],["で"],["ある"],["か"],["、"],["あなた"],["に"],["示めしましょう","しめしましょう"],["』"],["。"]]},{"verse":10,"text":"すると、ミルトスの木,きの中,なかに立,たっている人,ひとが答,こたえて、『これらは地,ちを見回,みまわらせるために、主,しゅがつかわされた者,ものです』と言,いうと、","tok":[["する"],["と"],["、"],["ミルトス"],["の"],["木","き"],["の"],["中","なか"],["に"],["立って","たって"],["いる"],["人","ひと"],["が"],["答","こたえ"],["て"],["、"],["『"],["これ"],["ら"],["は"],["地","ち"],["を"],["見","み"],["回わらせる","まわらせる"],["ため"],["に"],["、"],["主","しゅ"],["が"],["つかわされた"],["者","もの"],["です"],["』"],["と"],["言","いう"],["と"],["、"]]},{"verse":11,"text":"彼,かれらは答,こたえて、ミルトスの中,なかに立,たっている主,しゅの使,つかいに言,いった、『われわれは地,ちを見回,みまわったが、全,ぜん地,ちはすべて平穏,へいおんです』。","tok":[["彼","かれ"],["ら"],["は"],["答","こたえ"],["て"],["、"],["ミルトス"],["の"],["中","なか"],["に"],["立って","たって"],["いる"],["主","しゅ"],["の"],["使","つかい"],["に"],["言った","いった"],["、"],["『"],["われわれ"],["は"],["地","ち"],["を"],["見","み"],["回わった","まわった"],["が"],["、"],["全地","ぜんち"],["は"],["すべて"],["平穏","へいおん"],["です"],["』"],["。"]]},{"verse":12,"text":"すると主,しゅの使,つかいは言,いった、『万軍,ばんぐんの主,しゅよ、あなたは、いつまでエルサレムとユダの町々,まちまちとを、あわれんで下,くださらないのですか。あなたはお怒,いかりになって、すでに七十年,ねんになりました』。","tok":[["する"],["と"],["主","しゅ"],["の"],["使い","つかい"],["は"],["言った","いった"],["、"],["『"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["よ"],["、"],["あなた"],["は"],["、"],["いつ"],["まで"],["エルサレム"],["と"],["ユダ"],["の"],["町々","まちまち"],["と"],["を"],["、"],["あわれんで"],["下さらない","くださらない"],["の"],["です"],["か"],["。"],["あなた"],["は"],["お怒り","おいかり"],["に"],["なって"],["、"],["すでに"],["七十","ななじゅう"],["年","ねん"],["に"],["なりました"],["』"],["。"]]},{"verse":13,"text":"主,しゅはわたしと語,かたる天,てんの使,つかいに、ねんごろな慰,なぐさめの言葉,ことばをもって答,こたえられた。","tok":[["主","しゅ"],["は"],["わたし"],["と"],["語る","かたる"],["天","てん"],["の"],["使","つかい"],["に"],["、"],["ねんごろ"],["な"],["慰さめ","なぐさめ"],["の"],["言葉","ことば"],["を"],["もって"],["答","こたえ"],["られた"],["。"]]},{"verse":14,"text":"そこで、わたしと語,かたる天,てんの使,つかいは言,いった、『あなたは呼,よばわって言,いいなさい。万軍,ばんぐんの主,しゅはこう仰,おおせられます、わたしはエルサレムのため、シオンのために、大,おおいなるねたみを起,おこし、","tok":[["そこ"],["で"],["、"],["わたし"],["と"],["語る","かたる"],["天","てん"],["の"],["使い","つかい"],["は"],["言った","いった"],["、"],["『"],["あなた"],["は"],["呼ばわって","よばわって"],["言い","いい"],["なさい"],["。"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["こう"],["仰せられます","おおせられます"],["、"],["わたし"],["は"],["エルサレム"],["の"],["ため"],["、"],["シオン"],["の"],["ため"],["に"],["、"],["大いなる","おおいなる"],["ねたみ"],["を"],["起こし","おこし"],["、"]]},{"verse":15,"text":"安,やすらかにいる国々,くにぐにの民,たみに対,たいして、大,おおいに怒,いかる。なぜなら、わたしが少,すこしばかり怒,いかったのに、彼,かれらは、大,おおいにこれを悩,なやましたからであると。","tok":[["安らか","やすらか"],["に"],["いる"],["国々","くにぐに"],["の"],["民","たみ"],["に対して","にたいして"],["、"],["大いに","おおいに"],["怒","い"],["かる"],["。"],["なぜ"],["なら"],["、"],["わたし"],["が"],["少し","すこし"],["ばかり"],["怒","いかった"],["のに"],["、"],["彼","かれ"],["ら"],["は"],["、"],["大いに","おおいに"],["これ"],["を"],["悩した","なやました"],["から"],["で"],["ある"],["と"],["。"]]},{"verse":16,"text":"それゆえ、主,しゅはこう仰,おおせられます、わたしはあわれみをもってエルサレムに帰,かえる。わたしの家,いえはその中,なかに建,たてられ、測,はかりなわはエルサレムに張,はられると、万軍,ばんぐんの主,しゅは仰,おおせられます。","tok":[["それ"],["ゆえ"],["、"],["主","しゅ"],["は"],["こう"],["仰せられます","おおせられます"],["、"],["わたし"],["は"],["あわれみ"],["を"],["もって"],["エルサレム"],["に"],["帰える","かえる"],["。"],["わたし"],["の"],["家","いえ"],["は"],["その"],["中","なか"],["に"],["建てられ","たてられ"],["、"],["測り","はかり"],["なわ"],["は"],["エルサレム"],["に"],["張られる","はられる"],["と"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["仰せられます","おおせられます"],["。"]]},{"verse":17,"text":"あなたはまた呼,よばわって言,いいなさい。万軍,ばんぐんの主,しゅはこう仰,おおせられます、わが町々,まちまちは再,ふたたび良,よい物,もので満,みちあふれ、主,しゅは再,ふたたびシオンを慰,なぐさめ、再,ふたたびエルサレムを選,えらぶ』と」。","tok":[["あなた"],["は"],["また"],["呼ばわって","よばわって"],["言い","いい"],["なさい"],["。"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["こう"],["仰せられます","おおせられます"],["、"],["わが"],["町々","まちまち"],["は"],["再び","ふたたび"],["良い","よい"],["物","もの"],["で"],["満ちあふれ","みちあふれ"],["、"],["主","しゅ"],["は"],["再び","ふたたび"],["シオン"],["を"],["慰さめ","なぐさめ"],["、"],["再び","ふたたび"],["エルサレム"],["を"],["選ぶ","えらぶ"],["』"],["と"],["」"],["。"]]}]
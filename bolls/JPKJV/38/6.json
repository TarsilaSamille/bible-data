[{"verse":1,"text":"わたしがまた目,めをあげて見,みていると、四両,りょうの戦車,せんしゃが二つの山,やまの間,あいだから出,でてきた。その山,やまは青銅,せいどうの山,やまであった。","tok":[["わたし"],["が"],["また"],["目","め"],["を"],["あげて"],["見て","みて"],["いる"],["と"],["、"],["四","よん"],["両","りょう"],["の"],["戦車","せんしゃ"],["が"],["二","ふた"],["つ"],["の"],["山","やま"],["の"],["間","あいだ"],["から"],["出て","でて"],["きた"],["。"],["その"],["山","やま"],["は"],["青銅","せいどう"],["の"],["山","やま"],["で"],["あった"],["。"]]},{"verse":2,"text":"第,だい一の戦車,せんしゃには赤,あか馬,うまを着,つけ、第,だい二の戦車,せんしゃには黒,くろ馬,うまを着,つけ、","tok":[["第","だい"],["一","いち"],["の"],["戦車","せんしゃ"],["に"],["は"],["赤馬","あかうま"],["を"],["着け","つけ"],["、"],["第","だい"],["二","に"],["の"],["戦車","せんしゃ"],["に"],["は"],["黒馬","くろうま"],["を"],["着け","つけ"],["、"]]},{"verse":3,"text":"第,だい三の戦車,せんしゃには白馬,しろうまを着,つけ、第,だい四の戦車,せんしゃには、まだらのねずみ色,いろの馬,うまを着,つけていた。","tok":[["第","だい"],["三","さん"],["の"],["戦車","せんしゃ"],["に"],["は"],["白馬","しろうま"],["を"],["着け","つけ"],["、"],["第","だい"],["四","よん"],["の"],["戦車","せんしゃ"],["に"],["は"],["、"],["まだら"],["の"],["ねずみ色","ねずみいろ"],["の"],["馬","うま"],["を"],["着けて","つけて"],["いた"],["。"]]},{"verse":4,"text":"わたしは、わたしと語,かたるみ使,つかいに尋,たずねた、「わが主,しゅよ、これらはなんですか」。","tok":[["わたし"],["は"],["、"],["わたし"],["と"],["語る","かたる"],["み使","みつかい"],["に"],["尋ねた","たずねた"],["、"],["「"],["わが"],["主","しゅ"],["よ"],["、"],["これ"],["ら"],["は"],["なん"],["です"],["か"],["」"],["。"]]},{"verse":5,"text":"天,てんの使,つかいは答,こたえて、わたしに言,いった、「これらは全,ぜん地,ちの主,しゅの前,まえに現,あらわれて後,のち、天,てんの四方,しほうに出,でて行,いくものです。","tok":[["天","てん"],["の"],["使い","つかい"],["は"],["答","こたえ"],["て"],["、"],["わたし"],["に"],["言った","いった"],["、"],["「"],["これ"],["ら"],["は"],["全地","ぜんち"],["の"],["主","しゅ"],["の"],["前","まえ"],["に"],["現われて","あらわれて"],["後","の"],["ち"],["、"],["天","てん"],["の"],["四方","しほう"],["に"],["出て","でて"],["行く","いく"],["もの"],["です"],["。"]]},{"verse":6,"text":"黒,くろ馬,うまを着,つけた戦車,せんしゃは、北,きたの国,くにをさして出,でて行,いき、白馬,しろうまは西,にしの国,くにをさして出,でて行,いき、まだらの馬,うまは南,みなみの国,くにをさして出,でて行,いくのです」。","tok":[["黒馬","くろうま"],["を"],["着けた","つけた"],["戦車","せんしゃ"],["は"],["、"],["北","きた"],["の"],["国","くに"],["を"],["さして"],["出て","でて"],["行き","いき"],["、"],["白馬","しろうま"],["は"],["西","にし"],["の"],["国","くに"],["を"],["さして"],["出て","でて"],["行き","いき"],["、"],["まだら"],["の"],["馬","うま"],["は"],["南","みなみ"],["の"],["国","くに"],["を"],["さして"],["出て","でて"],["行く","いく"],["の"],["です"],["」"],["。"]]},{"verse":7,"text":"馬,うまが出,でてくると、彼,かれらは、地,ちをあまねくめぐるために、しきりに出,でたがるのであった。それで彼,かれが「行,いって、地,ちをあまねくめぐれ」と言,いうと、彼,かれらは地,ちを行,いきめぐった。","tok":[["馬","うま"],["が"],["出て","でて"],["くる"],["と"],["、"],["彼","かれ"],["ら"],["は"],["、"],["地","ち"],["を"],["あまねく"],["めぐる"],["ため"],["に"],["、"],["しきり"],["に"],["出たがる","でたがる"],["ので"],["あった"],["。"],["それ"],["で"],["彼","かれ"],["が"],["「"],["行って","いって"],["、"],["地","ち"],["を"],["あまねく"],["めぐれ"],["」"],["と"],["言","いう"],["と"],["、"],["彼","かれ"],["ら"],["は"],["地","ち"],["を"],["行き","いき"],["めぐった"],["。"]]},{"verse":8,"text":"すると彼,かれはわたしを呼,よんで、「北,きたの国,くにをさして行,いく者,ものどもは、北,きたの国,くにでわたしの心,こころを静,しずまらせてくれた」と言,いった。","tok":[["する"],["と"],["彼","かれ"],["は"],["わたし"],["を"],["呼んで","よんで"],["、"],["「"],["北","きた"],["の"],["国","くに"],["を"],["さして"],["行く","いく"],["者","もの"],["ども"],["は"],["、"],["北","きた"],["の"],["国","くに"],["で"],["わたし"],["の"],["心","こころ"],["を"],["静まらせて","しずまらせて"],["くれた"],["」"],["と"],["言った","いった"],["。"]]},{"verse":9,"text":"主,しゅの言葉,ことばがまたわたしに臨,のぞんだ、","tok":[["主","しゅ"],["の"],["言葉","ことば"],["が"],["また"],["わたし"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":10,"text":"「バビロンから帰,かえってきたかの捕囚,ほしゅうの中,なかから、ヘルダイ、トビヤおよびエダヤを連,つれて、その日,ひにゼパニヤの子,こヨシヤの家,いえに行,いき、","tok":[["「"],["バビロン"],["から"],["帰えって","かえって"],["きた"],["か"],["の"],["捕囚","ほしゅう"],["の"],["中","なか"],["から"],["、"],["ヘルダイ"],["、"],["トビヤ"],["および"],["エダヤ"],["を"],["連れて","つれて"],["、"],["その"],["日","ひ"],["に"],["ゼパニヤ"],["の"],["子","こ"],["ヨシヤ"],["の"],["家","いえ"],["に"],["行き","いき"],["、"]]},{"verse":11,"text":"彼,かれらから金銀,きんぎんを受,うけ取,とって、一つの冠,かんむりを造,つくり、それをヨザダクの子,こである大,だい祭司,さいしヨシュアの頭,あたまにかぶらせて、","tok":[["彼","かれ"],["ら"],["から"],["金銀","きんぎん"],["を"],["受け取って","うけとって"],["、"],["一","ひと"],["つ"],["の"],["冠","かんむり"],["を"],["造","つくり"],["、"],["それ"],["を"],["ヨザダク"],["の"],["子","こ"],["で"],["ある"],["大","だい"],["祭司","さいし"],["ヨシュア"],["の"],["頭","あたま"],["に"],["かぶらせて"],["、"]]},{"verse":12,"text":"彼,かれに言,いいなさい、『万軍,ばんぐんの主,しゅは、こう仰,おおせられる、見,みよ、その名,なを枝,えだという人,ひとがある。彼,かれは自分,じぶんの場所,ばしょで成長,せいちょうして、主,しゅの宮,みやを建,たてる。","tok":[["彼","かれ"],["に"],["言い","いい"],["なさい"],["、"],["『"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["、"],["こう"],["仰せられる","おおせられる"],["、"],["見よ","みよ"],["、"],["その"],["名","な"],["を"],["枝","えだ"],["と"],["いう"],["人","ひと"],["が"],["ある"],["。"],["彼","かれ"],["は"],["自分","じぶん"],["の"],["場所","ばしょ"],["で"],["成長","せいちょう"],["して"],["、"],["主","しゅ"],["の"],["宮","みや"],["を"],["建てる","たてる"],["。"]]},{"verse":13,"text":"すなわち彼,かれは主,しゅの宮,みやを建,たて、王,おうとしての光栄,こうえいを帯,おび、その位,くらいに座,ざして治,おさめる。その位,くらいのかたわらに、ひとりの祭司,さいしがいて、このふたりの間,あいだに平和,へいわの一致,いっちがある』。","tok":[["すなわち"],["彼","かれ"],["は"],["主","しゅ"],["の"],["宮","みや"],["を"],["建て","たて"],["、"],["王","おう"],["として"],["の"],["光栄","こうえい"],["を"],["帯","おび"],["、"],["その"],["位","くらい"],["に"],["座して","ざして"],["治める","おさめる"],["。"],["その"],["位","くらい"],["の"],["かたわら"],["に"],["、"],["ひとり"],["の"],["祭司","さいし"],["が"],["いて"],["、"],["この"],["ふたり"],["の"],["間","あいだ"],["に"],["平和","へいわ"],["の"],["一致","いっち"],["が"],["ある"],["』"],["。"]]},{"verse":14,"text":"またその冠,かんむりはヘルダイ、トビヤ、エダヤおよびゼパニヤの子,こヨシヤの記念,きねんとして、主,しゅの宮,みやに納,おさめられる。","tok":[["また"],["その"],["冠","かんむり"],["は"],["ヘルダイ"],["、"],["トビヤ"],["、"],["エダヤ"],["および"],["ゼパニヤ"],["の"],["子","こ"],["ヨシヤ"],["の"],["記念","きねん"],["として"],["、"],["主","しゅ"],["の"],["宮","みや"],["に"],["納められる","おさめられる"],["。"]]},{"verse":15,"text":"また遠,とおい所,ところの者,ものどもが来,きて、主,しゅの宮,みやを建,たてることを助,たすける。そしてあなたがたは万軍,ばんぐんの主,しゅが、わたしをつかわされたことを知,しるようになる。あなたがたがもし励,はげんで、あなたがたの神,かみ、主,しゅの声,こえに聞,きき従,したがうならば、このようになる」。","tok":[["また"],["遠い","とおい"],["所","ところ"],["の"],["者","もの"],["ども"],["が"],["来て","きて"],["、"],["主","しゅ"],["の"],["宮","みや"],["を"],["建てる","たてる"],["こと"],["を"],["助ける","たすける"],["。"],["そして"],["あなた"],["がた"],["は"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["が"],["、"],["わたし"],["を"],["つかわされた"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"],["あなた"],["がた"],["が"],["もし"],["励んで","はげんで"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["声","こえ"],["に"],["聞","きき"],["従うならば","したがうならば"],["、"],["この"],["よう"],["に"],["なる"],["」"],["。"]]}]
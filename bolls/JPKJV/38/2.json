[{"verse":1,"text":"[1:18]わたしが目,めをあげて見,みていると、見,みよ、四つの角,つのがあった。","tok":[["["],["1"],[":"],["18"],["]"],["わたし"],["が"],["目","め"],["を"],["あげて"],["見て","みて"],["いる"],["と"],["、"],["見よ","みよ"],["、"],["四","よん"],["つ"],["の"],["角","つ"],["の"],["が"],["あった"],["。"]]},{"verse":2,"text":"[1:19]わたしと語,かたる天,てんの使,つかいに「これらはなんですか」と言,いうと、彼,かれは答,こたえて言,いった、「これらはユダ、イスラエルおよびエルサレムを散,ちらした角,つのです」。","tok":[["["],["1"],[":"],["19"],["]"],["わたし"],["と"],["語る","かたる"],["天","てん"],["の"],["使","つかい"],["に"],["「"],["これ"],["ら"],["は"],["なん"],["です"],["か"],["」"],["と"],["言","いう"],["と"],["、"],["彼","かれ"],["は"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["これ"],["ら"],["は"],["ユダ"],["、"],["イスラエル"],["および"],["エルサレム"],["を"],["散らした","ちらした"],["角","つ"],["の"],["です"],["」"],["。"]]},{"verse":3,"text":"[1:20]その時,とき、主,しゅは四人,にんの鍛冶,かじをわたしに示,しめされた。","tok":[["["],["1"],[":"],["20"],["]"],["その"],["時","とき"],["、"],["主","しゅ"],["は"],["四人","にん"],["の"],["鍛冶","かじ"],["を"],["わたし"],["に"],["示めされた","しめされた"],["。"]]},{"verse":4,"text":"[1:21]わたしが「これらは何,なにをするために来,きたのですか」と言,いうと、彼,かれは答,こたえた、「これらの角,つのはユダを散,ちらして、人,ひとにその頭,あたまをあげさせなかったものですが、この四人,にんの者,ものが来,きたのは彼,かれらをおどし、かのユダの地,ちにむかって角,つのをあげ、これを散,ちらした国々,くにぐにの民,たみの角,つのを投,なげうつためです」。","tok":[["["],["1"],[":"],["21"],["]"],["わたし"],["が"],["「"],["これ"],["ら"],["は"],["何に","なに"],["を"],["する"],["ため"],["に"],["来た","きた"],["の"],["です"],["か"],["」"],["と"],["言","いう"],["と"],["、"],["彼","かれ"],["は"],["答","こたえ"],["た"],["、"],["「"],["これ"],["ら"],["の"],["角","つ"],["の"],["は"],["ユダ"],["を"],["散らして","ちらして"],["、"],["人","ひと"],["に"],["その"],["頭","あたま"],["を"],["あげさせなかった"],["もの"],["です"],["が"],["、"],["この"],["四人","にん"],["の"],["者","もの"],["が"],["来た","きた"],["の"],["は"],["彼","かれ"],["ら"],["を"],["おどし"],["、"],["かの"],["ユダ"],["の"],["地","ち"],["に"],["むかって"],["角","つ"],["の"],["を"],["あげ"],["、"],["これ"],["を"],["散らした","ちらした"],["国々","くにぐに"],["の"],["民","たみ"],["の"],["角","つ"],["の"],["を"],["投","なげ"],["うつ"],["ため"],["です"],["」"],["。"]]},{"verse":5,"text":"[1]またわたしが目,めをあげて見,みていると、見,みよ、ひとりの人,ひとが、測,はかりなわを手,てに持,もっているので、","tok":[["["],["1"],["]"],["また"],["わたし"],["が"],["目","め"],["を"],["あげて"],["見て","みて"],["いる"],["と"],["、"],["見よ","みよ"],["、"],["ひとり"],["の"],["人","ひと"],["が"],["、"],["測り","はかり"],["なわ"],["を"],["手","て"],["に"],["持って","もって"],["いる"],["ので"],["、"]]},{"verse":6,"text":"[2]「あなたはどこへ行,いくのですか」と尋,たずねると、その人,ひとはわたしに言,いった、「エルサレムを測,はかって、その広,ひろさと、長,ながさを見,みようとするのです」。","tok":[["["],["2"],["]"],["「"],["あなた"],["は"],["どこ"],["へ"],["行く","いく"],["の"],["です"],["か"],["」"],["と"],["尋ねる","たずねる"],["と"],["、"],["その"],["人","ひと"],["は"],["わたし"],["に"],["言った","いった"],["、"],["「"],["エルサレム"],["を"],["測って","はかって"],["、"],["その"],["広さ","ひろさ"],["と"],["、"],["長さ","ながさ"],["を"],["見よう","みよう"],["と"],["する"],["の"],["です"],["」"],["。"]]},{"verse":7,"text":"[3]すると見,みよ、わたしと語,かたる天,てんの使,つかいが出,でて行,いくと、またひとりの天,てんの使,つかいが出,でてきて、これに出会,であって、","tok":[["["],["3"],["]"],["する"],["と"],["見よ","みよ"],["、"],["わたし"],["と"],["語る","かたる"],["天","てん"],["の"],["使","つかい"],["が"],["出て","でて"],["行く","いく"],["と"],["、"],["また"],["ひとり"],["の"],["天","てん"],["の"],["使","つかい"],["が"],["出て","でて"],["きて"],["、"],["これ"],["に"],["出会って","であって"],["、"]]},{"verse":8,"text":"[4]言,いった、「走,はしって行,いって、あの若,わかい人,ひとに言,いいなさい、『エルサレムはその中,なかに、人,ひとと家畜,かちくが多,おおくなるので、城壁,じょうへきのない村里,むらざとのように、人,ひとの住,すむ所,ところとなるでしょう。","tok":[["["],["4"],["]"],["言った","いった"],["、"],["「"],["走って","はしって"],["行って","いって"],["、"],["あの"],["若い","わかい"],["人","ひと"],["に"],["言い","いい"],["なさい"],["、"],["『"],["エルサレム"],["は"],["その"],["中","なか"],["に"],["、"],["人","ひと"],["と"],["家畜","かちく"],["が"],["多く","おおく"],["なる"],["ので"],["、"],["城壁","じょうへき"],["の"],["ない"],["村里","むらざと"],["の"],["よう"],["に"],["、"],["人","ひと"],["の"],["住む","すむ"],["所","ところ"],["と"],["なるでしょう"],["。"]]},{"verse":9,"text":"[5]主,しゅは仰,おおせられます、わたしはその周囲,しゅういで火,ひの城壁,じょうへきとなり、その中,なかで栄光,えいこうとなる』と」。","tok":[["["],["5"],["]"],["主","しゅ"],["は"],["仰せられます","おおせられます"],["、"],["わたし"],["は"],["その"],["周囲","しゅうい"],["で"],["火","ひ"],["の"],["城壁","じょうへき"],["と"],["なり"],["、"],["その"],["中","なか"],["で"],["栄光","えいこう"],["と"],["なる"],["』"],["と"],["」"],["。"]]},{"verse":10,"text":"[6]主,しゅは仰,おおせられる、さあ、北,きたの地,ちから逃,にげて来,きなさい。わたしはあなたがたを、天,てんの四方,しほうの風,かぜのように散,ちらしたからである。","tok":[["["],["6"],["]"],["主","しゅ"],["は"],["仰せられる","おおせられる"],["、"],["さあ"],["、"],["北","きた"],["の"],["地","ち"],["から"],["逃て","にげて"],["来","き"],["なさい"],["。"],["わたし"],["は"],["あなた"],["がた"],["を"],["、"],["天","てん"],["の"],["四方","しほう"],["の"],["風","かぜ"],["の"],["よう"],["に"],["散らした","ちらした"],["から"],["で"],["ある"],["。"]]},{"verse":11,"text":"[7]さあ、バビロンの娘,むすめと共,ともにいる者,ものよ、シオンにのがれなさい。","tok":[["["],["7"],["]"],["さあ"],["、"],["バビロン"],["の"],["娘","むすめ"],["と"],["共","とも"],["に"],["いる"],["者","もの"],["よ"],["、"],["シオン"],["に"],["のがれ"],["なさい"],["。"]]},{"verse":12,"text":"[8]あなたがたにさわる者,ものは、彼,かれの目,めの玉,たまにさわるのであるから、あなたがたを捕,とらえていった国々,くにぐにの民,たみに、その栄光,えいこうにしたがって、わたしをつかわされた万軍,ばんぐんの主,しゅは、こう仰,おおせられる、","tok":[["["],["8"],["]"],["あなた"],["がた"],["に"],["さわる"],["者","もの"],["は"],["、"],["彼","かれ"],["の"],["目の玉","めのたま"],["に"],["さわる"],["ので"],["ある"],["から"],["、"],["あなた"],["がた"],["を"],["捕らえて","とらえて"],["いった"],["国々","くにぐに"],["の"],["民","たみ"],["に"],["、"],["その"],["栄光","えいこう"],["に"],["したがって"],["、"],["わたし"],["を"],["つかわされた"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["、"],["こう"],["仰せられる","おおせられる"],["、"]]},{"verse":13,"text":"[9]「見,みよ、わたしは彼,かれらの上,うえに手,てを振,ふる。彼,かれらは自分,じぶんに仕,つかえた者,もののとりことなる。その時,ときあなたがたは万軍,ばんぐんの主,しゅが、わたしをつかわされたことを知,しる。","tok":[["["],["9"],["]"],["「"],["見よ","みよ"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["手","て"],["を"],["振る","ふる"],["。"],["彼","かれ"],["ら"],["は"],["自分","じぶん"],["に"],["仕えた","つかえた"],["者","もの"],["の"],["とりこ"],["と"],["なる"],["。"],["その"],["時","とき"],["あなた"],["がた"],["は"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["が"],["、"],["わたし"],["を"],["つかわされた"],["こと"],["を"],["知る","しる"],["。"]]},{"verse":14,"text":"[10]主,しゅは言,いわれる、シオンの娘,むすめよ、喜,よろこび歌,うたえ。わたしが来,きて、あなたの中,なかに住,すむからである。","tok":[["["],["10"],["]"],["主","しゅ"],["は"],["言われる","いわれる"],["、"],["シオン"],["の"],["娘","むすめ"],["よ"],["、"],["喜こび","よろこび"],["歌え","うたえ"],["。"],["わたし"],["が"],["来て","きて"],["、"],["あなた"],["の"],["中","なか"],["に"],["住む","すむ"],["から"],["で"],["ある"],["。"]]},{"verse":15,"text":"[11]その日,ひには、多,おおくの国民,こくみんが主,しゅに連,つらなって、わたしの民,たみとなる。わたしはあなたの中,なかに住,すむ。","tok":[["["],["11"],["]"],["その"],["日","ひ"],["に"],["は"],["、"],["多く","おおく"],["の"],["国民","こくみん"],["が"],["主に","しゅに"],["連なって","つらなって"],["、"],["わたし"],["の"],["民","たみ"],["と"],["なる"],["。"],["わたし"],["は"],["あなた"],["の"],["中","なか"],["に"],["住む","すむ"],["。"]]},{"verse":16,"text":"[12]あなたは万軍,ばんぐんの主,しゅが、わたしをあなたにつかわされたことを知,しる。主,しゅは聖地,せいちで、ユダを自分,じぶんの分,ぶんとして取,とり、エルサレムを再,ふたたび選,えらばれるであろう」。","tok":[["["],["12"],["]"],["あなた"],["は"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["が"],["、"],["わたし"],["を"],["あなた"],["に"],["つかわされた"],["こと"],["を"],["知る","しる"],["。"],["主","しゅ"],["は"],["聖地","せいち"],["で"],["、"],["ユダ"],["を"],["自分","じぶん"],["の"],["分","ぶん"],["として"],["取","とり"],["、"],["エルサレム"],["を"],["再び","ふたたび"],["選ら","えら"],["ばれるで"],["あろう"],["」"],["。"]]},{"verse":17,"text":"[13]すべて肉,にくなる者,ものよ、主,しゅの前,まえに静,しずまれ。主,しゅはその聖,せいなるすみかから立,たちあがられたからである。","tok":[["["],["13"],["]"],["すべて"],["肉","にく"],["なる"],["者","もの"],["よ"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["静まれ","しずまれ"],["。"],["主","しゅ"],["は"],["その"],["聖","せい"],["なる"],["すみか"],["から"],["立ちあがられた","たちあがられた"],["から"],["で"],["ある"],["。"]]}]
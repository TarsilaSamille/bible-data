[{"verse":1,"text":"万軍,ばんぐんの主,しゅの言葉,ことばがわたしに臨,のぞんだ、","tok":[["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":2,"text":"「万軍,ばんぐんの主,しゅは、こう仰,おおせられる、『わたしはシオンのために、大,おおいなるねたみを起,おこし、またこれがために、大,おおいなる憤,いきどおりをもってねたむ』。","tok":[["「"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["、"],["こう"],["仰せられる","おおせられる"],["、"],["『"],["わたし"],["は"],["シオン"],["の"],["ため"],["に"],["、"],["大いなる","おおいなる"],["ねたみ"],["を"],["起こし","おこし"],["、"],["また"],["これ"],["が"],["ため"],["に"],["、"],["大いなる","おおいなる"],["憤り","いきどおり"],["を"],["もって"],["ねたむ"],["』"],["。"]]},{"verse":3,"text":"主,しゅはこう仰,おおせられる、『わたしはシオンに帰,かえって、エルサレムの中,なかに住,すむ。エルサレムは忠信,ちゅうしんな町,まちととなえられ、万軍,ばんぐんの主,しゅの山,やまは聖,せいなる山,やまと、となえられる』。","tok":[["主","しゅ"],["は"],["こう"],["仰せられる","おおせられる"],["、"],["『"],["わたし"],["は"],["シオン"],["に"],["帰えって","かえって"],["、"],["エルサレム"],["の"],["中","なか"],["に"],["住む","すむ"],["。"],["エルサレム"],["は"],["忠信","ちゅうしん"],["な"],["町","まち"],["と"],["となえられ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["の"],["山","やま"],["は"],["聖","せい"],["なる"],["山","やま"],["と"],["、"],["となえられる"],["』"],["。"]]},{"verse":4,"text":"万軍,ばんぐんの主,しゅは、こう仰,おおせられる、『エルサレムの街路,がいろには再,ふたたび老,おいた男,おとこ、老,おいた女,おんなが座,ざするようになる。みな年寄,としよりの人々,ひとびとで、おのおのつえを手,てに持,もつ。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["、"],["こう"],["仰せられる","おおせられる"],["、"],["『"],["エルサレム"],["の"],["街路","がいろ"],["に"],["は"],["再び","ふたたび"],["老","おい"],["た"],["男","おとこ"],["、"],["老","おい"],["た"],["女","おんな"],["が"],["座する","ざする"],["よう"],["に"],["なる"],["。"],["みな"],["年寄","としより"],["の"],["人々","ひとびと"],["で"],["、"],["おのおの"],["つえ"],["を"],["手","て"],["に"],["持つ","もつ"],["。"]]},{"verse":5,"text":"またその町,まちの街路,がいろには、男,おとこの子,こ、女,おんなの子,こが満,みちて、街路,がいろに遊,あそび戯,たわむれる』。","tok":[["また"],["その"],["町","まち"],["の"],["街路","がいろ"],["に"],["は"],["、"],["男の子","おとこのこ"],["、"],["女の子","おんなのこ"],["が"],["満ちて","みちて"],["、"],["街路","がいろ"],["に"],["遊び","あそび"],["戯","たわむれ"],["る"],["』"],["。"]]},{"verse":6,"text":"万軍,ばんぐんの主,しゅは、こう仰,おおせられる、『その日,ひには、たとい、この民,たみの残,のこれる者,ものの目,めに、不思議,ふしぎな事,ことであっても、それはわたしの目,めにも、不思議,ふしぎな事,ことであろうか』と万軍,ばんぐんの主,しゅは言,いわれる。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["、"],["こう"],["仰せられる","おおせられる"],["、"],["『"],["その"],["日","ひ"],["に"],["は"],["、"],["たとい"],["、"],["この"],["民","たみ"],["の"],["残れる","のこれる"],["者","もの"],["の"],["目","め"],["に"],["、"],["不思議","ふしぎ"],["な"],["事","こと"],["で"],["あって"],["も"],["、"],["それ"],["は"],["わたし"],["の"],["目","め"],["に"],["も"],["、"],["不思議","ふしぎ"],["な"],["事","こと"],["で"],["あろう"],["か"],["』"],["と"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":7,"text":"万軍,ばんぐんの主,しゅは、こう仰,おおせられる、『見,みよ、わが民,たみを東,ひがしの国,くにから、また西,にしの国,くにから救,すくい出,だし、","tok":[["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["、"],["こう"],["仰せられる","おおせられる"],["、"],["『"],["見よ","みよ"],["、"],["わが"],["民","たみ"],["を"],["東","ひがし"],["の"],["国","くに"],["から"],["、"],["また"],["西","にし"],["の"],["国","くに"],["から"],["救い出し","すくいだし"],["、"]]},{"verse":8,"text":"彼,かれらを連,つれてきて、エルサレムに住,すまわせ、彼,かれらはわが民,たみとなり、わたしは彼,かれらの神,かみとなって、共,ともに真実,しんじつと正義,せいぎとをもって立,たつ』」。","tok":[["彼","かれ"],["ら"],["を"],["連れて","つれて"],["きて"],["、"],["エルサレム"],["に"],["住まわせ","すまわせ"],["、"],["彼","かれ"],["ら"],["は"],["わが"],["民","たみ"],["と"],["なり"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["神","かみ"],["と"],["なって"],["、"],["共","とも"],["に"],["真実","しんじつ"],["と"],["正義","せいぎと"],["を"],["もって"],["立つ","たつ"],["』"],["」"],["。"]]},{"verse":9,"text":"万軍,ばんぐんの主,しゅは、こう仰,おおせられる、「万軍,ばんぐんの主,しゅの家,いえである宮,みやを建,たてるために、その礎,いしずえをすえた日,ひからこのかた、預言者,よげんしゃたちの口,くちから出,でたこれらの言葉,ことばを、きょう聞,きく者,ものよ、あなたがたの手,てを強,つよくせよ。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["、"],["こう"],["仰せられる","おおせられる"],["、"],["「"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["の"],["家","いえ"],["で"],["ある"],["宮","みや"],["を"],["建てる","たてる"],["ため"],["に"],["、"],["その"],["礎","いしずえ"],["を"],["すえた"],["日","ひ"],["から"],["このかた"],["、"],["預言者","よげんしゃ"],["たち"],["の"],["口","くち"],["から"],["出た","でた"],["これ"],["ら"],["の"],["言葉","ことば"],["を"],["、"],["きょう"],["聞く","きく"],["者","もの"],["よ"],["、"],["あなた"],["がた"],["の"],["手","て"],["を"],["強く","つよく"],["せよ"],["。"]]},{"verse":10,"text":"この日,ひの以前,いぜんには、人,ひとも働,はたらきの価,あたいを得,えず、獣,けものも働,はたらきの価,あたいを得,えず、また出,でる者,ものもはいる者,ものも、あだのために安全,あんぜんではなかった。わたしはまた人々,ひとびとを相,あいたがいにそむかせた。","tok":[["この"],["日","ひ"],["の"],["以前","いぜん"],["に"],["は"],["、"],["人","ひと"],["も"],["働らき","はたらき"],["の"],["価","あたい"],["を"],["得ず","えず"],["、"],["獣","けもの"],["も"],["働らき","はたらき"],["の"],["価","あたい"],["を"],["得ず","えず"],["、"],["また"],["出る","でる"],["者","もの"],["も"],["はいる"],["者","もの"],["も"],["、"],["あだ"],["の"],["ため"],["に"],["安全","あんぜん"],["で"],["は"],["なかった"],["。"],["わたし"],["は"],["また"],["人々","ひとびと"],["を"],["相","あい"],["たがい"],["に"],["そむかせた"],["。"]]},{"verse":11,"text":"しかし今,いまは、わたしのこの民,たみの残,のこれる者,ものに対,たいすることは、さきの日,ひのようではないと、万軍,ばんぐんの主,しゅは言,いわれる。","tok":[["しかし"],["今","いま"],["は"],["、"],["わたし"],["の"],["この"],["民","たみ"],["の"],["残れる","のこれる"],["者","もの"],["に"],["対する","たいする"],["こと"],["は"],["、"],["さき"],["の"],["日","ひ"],["の"],["よう"],["で"],["は"],["ない"],["と"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":12,"text":"そこには、平和,へいわと繁栄,はんえいとの種,たねがまかれるからである。すなわちぶどうの木,きは実,みを結,むすび、地,ちは産物,さんぶつを出,だし、天,てんは露,つゆを与,あたえる。わたしはこの民,たみの残,のこれる者,ものに、これをことごとく与,あたえる。","tok":[["そこ"],["に"],["は"],["、"],["平和","へいわ"],["と"],["繁栄","はんえい"],["と"],["の"],["種","たね"],["が"],["まかれる"],["から"],["で"],["ある"],["。"],["すなわち"],["ぶどう"],["の"],["木","き"],["は"],["実","み"],["を"],["結び","むすび"],["、"],["地","ち"],["は"],["産物","さんぶつ"],["を"],["出し","だし"],["、"],["天","てん"],["は"],["露","つゆ"],["を"],["与える","あたえる"],["。"],["わたし"],["は"],["この"],["民","たみ"],["の"],["残れる","のこれる"],["者","もの"],["に"],["、"],["これ"],["を"],["ことごとく"],["与える","あたえる"],["。"]]},{"verse":13,"text":"ユダの家,いえおよびイスラエルの家,いえよ、あなたがたが、国々,くにぐにの民,たみの中,なかに、のろいとなっていたように、わたしはあなたがたを救,すくって祝福,しゅくふくとする。恐,おそれてはならない。あなたがたの手,てを強,つよくせよ」。","tok":[["ユダ"],["の"],["家","いえ"],["および"],["イスラエル"],["の"],["家","いえ"],["よ"],["、"],["あなた"],["が"],["た"],["が"],["、"],["国々","くにぐに"],["の"],["民","たみ"],["の"],["中","なか"],["に"],["、"],["のろい"],["と"],["なって"],["いた"],["よう"],["に"],["、"],["わたし"],["は"],["あなた"],["がた"],["を"],["救って","すくって"],["祝福","しゅくふく"],["と"],["する"],["。"],["恐れて","おそれて"],["は"],["ならない"],["。"],["あなた"],["がた"],["の"],["手","て"],["を"],["強く","つよく"],["せよ"],["」"],["。"]]},{"verse":14,"text":"万軍,ばんぐんの主,しゅは、こう仰,おおせられる、「あなたがたの先祖,せんぞが、わたしを怒,いからせた時,ときに、災,わざわいを下,くだそうと思,おもって、これをやめなかったように、――万軍,ばんぐんの主,しゅは言,いわれる――","tok":[["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["、"],["こう"],["仰せられる","おおせられる"],["、"],["「"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["が"],["、"],["わたし"],["を"],["怒らせた","いからせた"],["時","とき"],["に"],["、"],["災","わざわい"],["を"],["下そう","くだそう"],["と"],["思って","おもって"],["、"],["これ"],["を"],["やめなかった"],["よう"],["に"],["、"],["―"],["―"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["言われる","いわれる"],["―"],["―"]]},{"verse":15,"text":"そのように、わたしはまた今日,こんにち、エルサレムとユダの家,いえに恵,めぐみを与,あたえよう。恐,おそれてはならない。","tok":[["その"],["よう"],["に"],["、"],["わたし"],["は"],["また"],["今日","こん"],["に"],["ち"],["、"],["エルサレム"],["と"],["ユダ"],["の"],["家","いえ"],["に"],["恵","めぐみ"],["を"],["与","あたえ"],["よう"],["。"],["恐れて","おそれて"],["は"],["ならない"],["。"]]},{"verse":16,"text":"あなたがたのなすべき事,ことはこれである。あなたがたは互,たがいに真実,しんじつを語,かたり、またあなたがたの門,もんで、真実,しんじつと平和,へいわのさばきとを、行,おこなわなければならない。","tok":[["あなた"],["がた"],["の"],["なすべき"],["事","こと"],["は"],["これ"],["で"],["ある"],["。"],["あなた"],["がた"],["は"],["互","たがい"],["に"],["真実","しんじつ"],["を"],["語り","かたり"],["、"],["また"],["あなた"],["がた"],["の"],["門","もん"],["で"],["、"],["真実","しんじつ"],["と"],["平和","へいわ"],["の"],["さばき"],["と"],["を"],["、"],["行なわなければ","おこなわなければ"],["ならない"],["。"]]},{"verse":17,"text":"あなたがたは、互,たがいに人,ひとを害,がいすることを、心,こころに図,はかってはならない。偽,いつわりの誓,ちかいを好,このんではならない。わたしはこれらの事,ことを憎,にくむからであると、主,しゅは言,いわれる」。","tok":[["あなた"],["がた"],["は"],["、"],["互","たがい"],["に"],["人","ひと"],["を"],["害する","がいする"],["こと"],["を"],["、"],["心","こころ"],["に"],["図って","はかって"],["は"],["ならない"],["。"],["偽わり","いつわり"],["の"],["誓い","ちかい"],["を"],["好","このん"],["で"],["は"],["ならない"],["。"],["わたし"],["は"],["これ"],["ら"],["の"],["事","こと"],["を"],["憎む","にくむ"],["から"],["で"],["ある"],["と"],["、"],["主","しゅ"],["は"],["言われる","いわれる"],["」"],["。"]]},{"verse":18,"text":"万軍,ばんぐんの主,しゅの言葉,ことばがわたしに臨,のぞんだ、","tok":[["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":19,"text":"「万軍,ばんぐんの主,しゅは、こう仰,おおせられる、四月,がつの断食,だんじきと、五月,がつの断食,だんじきと、七月,がつの断食,だんじきと、十月,がつの断食,だんじきとは、ユダの家,いえの喜,よろこび楽,たのしみの時,ときとなり、よき祝,いわいの時,ときとなる。ゆえにあなたがたは、真実,しんじつと平和,へいわとを愛,あいせよ。","tok":[["「"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["、"],["こう"],["仰せられる","おおせられる"],["、"],["四","よん"],["月","がつ"],["の"],["断食","だんじき"],["と"],["、"],["五","ご"],["月","がつ"],["の"],["断食","だんじき"],["と"],["、"],["七","なな"],["月","がつ"],["の"],["断食","だんじき"],["と"],["、"],["十","じゅう"],["月","がつ"],["の"],["断食","だんじき"],["と"],["は"],["、"],["ユダ"],["の"],["家","いえ"],["の"],["喜こび","よろこび"],["楽み","たのしみ"],["の"],["時","とき"],["と"],["なり"],["、"],["よき"],["祝い","いわい"],["の"],["時","とき"],["と"],["なる"],["。"],["ゆえ"],["に"],["あなた"],["がた"],["は"],["、"],["真実","しんじつ"],["と"],["平和","へいわ"],["と"],["を"],["愛せよ","あいせよ"],["。"]]},{"verse":20,"text":"万軍,ばんぐんの主,しゅは、こう仰,おおせられる、もろもろの民,たみおよび多,おおくの町,まちの住民,じゅうみん、すなわち、一つの町,まちの住民,じゅうみんは、他,たの町,まちの人々,ひとびとのところに行,いき、","tok":[["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["、"],["こう"],["仰せられる","おおせられる"],["、"],["もろもろ"],["の"],["民","たみ"],["および"],["多く","おおく"],["の"],["町","まち"],["の"],["住民","じゅうみん"],["、"],["すなわち"],["、"],["一","ひと"],["つ"],["の"],["町","まち"],["の"],["住民","じゅうみん"],["は"],["、"],["他","た"],["の"],["町","まち"],["の"],["人々","ひとびと"],["の"],["ところ"],["に"],["行き","いき"],["、"]]},{"verse":21,"text":"『われわれは、ただちに行,いって、主,しゅの恵,めぐみを請,こい、万軍,ばんぐんの主,しゅに呼,よび求,もとめよう』と言,いうと、『わたしも行,いこう』と言,いう。","tok":[["『"],["われわれ"],["は"],["、"],["ただちに"],["行って","いって"],["、"],["主","しゅ"],["の"],["恵","めぐみ"],["を"],["請い","こい"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["に"],["呼び求めよう","よびもとめよう"],["』"],["と"],["言","いう"],["と"],["、"],["『"],["わたし"],["も"],["行こう","いこう"],["』"],["と"],["言う","いう"],["。"]]},{"verse":22,"text":"多,おおくの民,たみおよび強,つよい国民,こくみんはエルサレムに来,きて、万軍,ばんぐんの主,しゅを求,もとめ、主,しゅの恵,めぐみを請,こう。","tok":[["多く","おおく"],["の"],["民","たみ"],["および"],["強い","つよい"],["国民","こくみん"],["は"],["エルサレム"],["に"],["来て","きて"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["を"],["求め","もとめ"],["、"],["主","しゅ"],["の"],["恵","めぐみ"],["を"],["請う","こう"],["。"]]},{"verse":23,"text":"万軍,ばんぐんの主,しゅは、こう仰,おおせられる、その日,ひには、もろもろの国,くにことばの民,たみの中,なかから十人,にんの者,ものが、ひとりのユダヤ人,ひとの衣,ころものすそをつかまえて、『あなたがたと一緒,いっしょに行,いこう。神,かみがあなたがたと共,ともにいますことを聞,きいたから』と言,いう」。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["、"],["こう"],["仰せられる","おおせられる"],["、"],["その"],["日","ひ"],["に"],["は"],["、"],["もろもろ"],["の"],["国","くに"],["ことば"],["の"],["民","たみ"],["の"],["中","なか"],["から"],["十人","にん"],["の"],["者","もの"],["が"],["、"],["ひとり"],["の"],["ユダヤ人","ゆだやひと"],["の"],["衣","ころも"],["の"],["すそ"],["を"],["つかまえて"],["、"],["『"],["あなた"],["がた"],["と"],["一緒","いっしょ"],["に"],["行こう","いこう"],["。"],["神","かみ"],["が"],["あなた"],["がた"],["と"],["共","とも"],["に"],["います"],["こと"],["を"],["聞いた","きいた"],["から"],["』"],["と"],["言う","いう"],["」"],["。"]]}]
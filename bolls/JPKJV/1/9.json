[{"verse":1,"text":"神,かみはノアとその子,こらとを祝福,しゅくふくして彼,かれらに言,いわれた、「生,うめよ、ふえよ、地,ちに満,みちよ。","tok":[["神","かみ"],["は"],["ノア"],["と"],["その"],["子","こ"],["ら"],["と"],["を"],["祝福","しゅくふく"],["して"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["生めよ","うめよ"],["、"],["ふえ"],["よ"],["、"],["地","ち"],["に"],["満ち","みち"],["よ"],["。"]]},{"verse":2,"text":"地,ちのすべての獣,けもの、空,そらのすべての鳥,とり、地,ちに這,はうすべてのもの、海,うみのすべての魚,うおは恐,おそれおののいて、あなたがたの支配,しはいに服,ふくし、","tok":[["地","ち"],["の"],["すべて"],["の"],["獣","けもの"],["、"],["空","そら"],["の"],["すべて"],["の"],["鳥","とり"],["、"],["地","ち"],["に"],["這う","はう"],["すべて"],["の"],["もの"],["、"],["海","うみ"],["の"],["すべて"],["の"],["魚","うお"],["は"],["恐れおののいて","おそれおののいて"],["、"],["あなた"],["がた"],["の"],["支配","しはい"],["に"],["服し","ふくし"],["、"]]},{"verse":3,"text":"すべて生,いきて動,うごくものはあなたがたの食物,しょくもつとなるであろう。さきに青草,あおくさをあなたがたに与,あたえたように、わたしはこれらのものを皆,みなあなたがたに与,あたえる。","tok":[["すべて"],["生きて","いきて"],["動く","うごく"],["もの"],["は"],["あなた"],["がた"],["の"],["食物","しょくもつ"],["と"],["なるで"],["あろう"],["。"],["さき"],["に"],["青草","あおくさ"],["を"],["あなた"],["がた"],["に"],["与","あたえ"],["た"],["よう"],["に"],["、"],["わたし"],["は"],["これ"],["ら"],["の"],["もの"],["を"],["皆","みな"],["あなた"],["がた"],["に"],["与える","あたえる"],["。"]]},{"verse":4,"text":"しかし肉,にくを、その命,いのちである血,ちのままで、食,たべてはならない。","tok":[["しかし"],["肉","にく"],["を"],["、"],["その"],["命","いのち"],["で"],["ある"],["血","ち"],["の"],["まま"],["で"],["、"],["食べて","たべて"],["は"],["ならない"],["。"]]},{"verse":5,"text":"あなたがたの命,いのちの血,ちを流,ながすものには、わたしは必,かならず報復,ほうふくするであろう。いかなる獣,けものにも報復,ほうふくする。兄弟,きょうだいである人,ひとにも、わたしは人,ひとの命,いのちのために、報復,ほうふくするであろう。","tok":[["あなた"],["がた"],["の"],["命","いのち"],["の"],["血","ち"],["を"],["流す","ながす"],["もの"],["に"],["は"],["、"],["わたし"],["は"],["必","かならず"],["報復","ほうふく"],["するで"],["あろう"],["。"],["いかなる"],["獣","けもの"],["に"],["も"],["報復","ほうふく"],["する"],["。"],["兄弟","きょうだい"],["で"],["ある"],["人","ひと"],["に"],["も"],["、"],["わたし"],["は"],["人","ひと"],["の"],["命","いのち"],["の"],["ため"],["に"],["、"],["報復","ほうふく"],["するで"],["あろう"],["。"]]},{"verse":6,"text":"人,ひとの血,ちを流,ながすものは、人,ひとに血,ちを流,ながされる、神,かみが自分,じぶんのかたちに人,ひとを造,つくられたゆえに。","tok":[["人","ひと"],["の"],["血","ち"],["を"],["流す","ながす"],["もの"],["は"],["、"],["人","ひと"],["に"],["血","ち"],["を"],["流される","ながされる"],["、"],["神","かみ"],["が"],["自分","じぶん"],["の"],["かたち"],["に"],["人","ひと"],["を"],["造られた","つくられた"],["ゆえ"],["に"],["。"]]},{"verse":7,"text":"あなたがたは、生,うめよ、ふえよ、地,ちに群,むらがり、地,ちの上,うえにふえよ」。","tok":[["あなた"],["がた"],["は"],["、"],["生めよ","うめよ"],["、"],["ふえ"],["よ"],["、"],["地","ち"],["に"],["群らがり","むらがり"],["、"],["地","ち"],["の"],["上","うえ"],["に"],["ふえ"],["よ"],["」"],["。"]]},{"verse":8,"text":"神,かみはノアおよび共,ともにいる子,こらに言,いわれた、","tok":[["神","かみ"],["は"],["ノア"],["および"],["共","とも"],["に"],["いる"],["子","こ"],["ら"],["に"],["言われた","いわれた"],["、"]]},{"verse":9,"text":"「わたしはあなたがた及,およびあなたがたの後,のちの子孫,しそんと契約,けいやくを立,たてる。","tok":[["「"],["わたし"],["は"],["あなた"],["がた"],["及","および"],["あなた"],["がた"],["の"],["後","のち"],["の"],["子孫","しそん"],["と"],["契約","けいやく"],["を"],["立る","たてる"],["。"]]},{"verse":10,"text":"またあなたがたと共,ともにいるすべての生,いき物,もの、あなたがたと共,ともにいる鳥,とり、家畜,かちく、地,ちのすべての獣,けもの、すなわち、すべて箱舟,はこぶねから出,でたものは、地,ちのすべての獣,けものにいたるまで、わたしはそれと契約,けいやくを立,たてよう。","tok":[["また"],["あなた"],["がた"],["と"],["共","とも"],["に"],["いる"],["すべて"],["の"],["生き物","いきもの"],["、"],["あなた"],["がた"],["と"],["共","とも"],["に"],["いる"],["鳥","とり"],["、"],["家畜","かちく"],["、"],["地","ち"],["の"],["すべて"],["の"],["獣","けもの"],["、"],["すなわち"],["、"],["すべて"],["箱舟","はこぶね"],["から"],["出た","でた"],["もの"],["は"],["、"],["地","ち"],["の"],["すべて"],["の"],["獣","けもの"],["に"],["いたる"],["まで"],["、"],["わたし"],["は"],["それ"],["と"],["契約","けいやく"],["を"],["立よう","たてよう"],["。"]]},{"verse":11,"text":"わたしがあなたがたと立,たてるこの契約,けいやくにより、すべて肉,にくなる者,ものは、もはや洪水,こうずいによって滅,ほろぼされることはなく、また地,ちを滅,ほろぼす洪水,こうずいは、再,ふたたび起,おこらないであろう」。","tok":[["わたし"],["が"],["あなた"],["がた"],["と"],["立る","たてる"],["この"],["契約","けいやく"],["に"],["より"],["、"],["すべて"],["肉","にく"],["なる"],["者","もの"],["は"],["、"],["もはや"],["洪水","こうずい"],["によって"],["滅ぼされる","ほろぼされる"],["こと"],["は"],["なく"],["、"],["また"],["地","ち"],["を"],["滅ぼす","ほろぼす"],["洪水","こうずい"],["は"],["、"],["再び","ふたたび"],["起こらないで","おこらないで"],["あろう"],["」"],["。"]]},{"verse":12,"text":"さらに神,かみは言,いわれた、「これはわたしと、あなたがた及,およびあなたがたと共,ともにいるすべての生,いき物,ものとの間,あいだに代々,よよかぎりなく、わたしが立,たてる契約,けいやくのしるしである。","tok":[["さらに"],["神","かみ"],["は"],["言われた","いわれた"],["、"],["「"],["これ"],["は"],["わたし"],["と"],["、"],["あなた"],["がた"],["及","および"],["あなた"],["がた"],["と"],["共","とも"],["に"],["いる"],["すべて"],["の"],["生き物","いきもの"],["と"],["の"],["間","あいだ"],["に"],["代々","よ"],["よ"],["かぎりなく"],["、"],["わたし"],["が"],["立る","たてる"],["契約","けいやく"],["の"],["しるし"],["で"],["ある"],["。"]]},{"verse":13,"text":"すなわち、わたしは雲,くもの中,なかに、にじを置,おく。これがわたしと地,ちとの間,あいだの契約,けいやくのしるしとなる。","tok":[["すなわち"],["、"],["わたし"],["は"],["雲","くも"],["の"],["中","なか"],["に"],["、"],["にじ"],["を"],["置く","おく"],["。"],["これ"],["が"],["わたし"],["と"],["地","ち"],["と"],["の"],["間","あいだ"],["の"],["契約","けいやく"],["の"],["しるし"],["と"],["なる"],["。"]]},{"verse":14,"text":"わたしが雲,くもを地,ちの上,うえに起,おこすとき、にじは雲,くもの中,なかに現,あらわれる。","tok":[["わたし"],["が"],["雲","くも"],["を"],["地","ち"],["の"],["上","うえ"],["に"],["起こす","おこす"],["とき"],["、"],["にじ"],["は"],["雲","くも"],["の"],["中","なか"],["に"],["現われる","あらわれる"],["。"]]},{"verse":15,"text":"こうして、わたしは、わたしとあなたがた、及,およびすべて肉,にくなるあらゆる生,いき物,ものとの間,あいだに立,たてた契約,けいやくを思,おもいおこすゆえ、水,みずはふたたび、すべて肉,にくなる者,ものを滅,ほろぼす洪水,こうずいとはならない。","tok":[["こう"],["して"],["、"],["わたし"],["は"],["、"],["わたし"],["と"],["あなた"],["がた"],["、"],["及","および"],["すべて"],["肉","にく"],["なる"],["あらゆる"],["生き物","いきもの"],["と"],["の"],["間","あいだ"],["に"],["立てた","たてた"],["契約","けいやく"],["を"],["思いおこす","おもいおこす"],["ゆえ"],["、"],["水","みず"],["は"],["ふたたび"],["、"],["すべて"],["肉","にく"],["なる"],["者","もの"],["を"],["滅ぼす","ほろぼす"],["洪水","こうずい"],["と"],["は"],["ならない"],["。"]]},{"verse":16,"text":"にじが雲,くもの中,なかに現,あらわれるとき、わたしはこれを見,みて、神,かみが地上,ちじょうにあるすべて肉,にくなるあらゆる生,いき物,ものとの間,あいだに立,たてた永遠,えいえんの契約,けいやくを思,おもいおこすであろう」。","tok":[["にじ"],["が"],["雲","くも"],["の"],["中","なか"],["に"],["現われる","あらわれる"],["とき"],["、"],["わたし"],["は"],["これ"],["を"],["見て","みて"],["、"],["神","かみ"],["が"],["地上","ちじょう"],["に"],["ある"],["すべて"],["肉","にく"],["なる"],["あらゆる"],["生き物","いきもの"],["と"],["の"],["間","あいだ"],["に"],["立てた","たてた"],["永遠","えいえん"],["の"],["契約","けいやく"],["を"],["思いおこすで","おもいおこすで"],["あろう"],["」"],["。"]]},{"verse":17,"text":"そして神,かみはノアに言,いわれた、「これがわたしと地,ちにあるすべて肉,にくなるものとの間,あいだに、わたしが立,たてた契約,けいやくのしるしである」。","tok":[["そして"],["神","かみ"],["は"],["ノア"],["に"],["言われた","いわれた"],["、"],["「"],["これ"],["が"],["わたし"],["と"],["地","ち"],["に"],["ある"],["すべて"],["肉","にく"],["なる"],["もの"],["と"],["の"],["間","あいだ"],["に"],["、"],["わたし"],["が"],["立てた","たてた"],["契約","けいやく"],["の"],["しるし"],["で"],["ある"],["」"],["。"]]},{"verse":18,"text":"箱舟,はこぶねから出,でたノアの子,こらはセム、ハム、ヤペテであった。ハムはカナンの父,ちちである。","tok":[["箱舟","はこぶね"],["から"],["出た","でた"],["ノア"],["の"],["子","こ"],["ら"],["は"],["セム"],["、"],["ハム"],["、"],["ヤペテ"],["で"],["あった"],["。"],["ハム"],["は"],["カナン"],["の"],["父","ちち"],["で"],["ある"],["。"]]},{"verse":19,"text":"この三人,にんはノアの子,こらで、全,ぜん地,ちの民,たみは彼,かれらから出,でて、広,ひろがったのである。","tok":[["この"],["三人","にん"],["は"],["ノア"],["の"],["子","こ"],["ら"],["で"],["、"],["全地","ぜんち"],["の"],["民","たみ"],["は"],["彼","かれ"],["ら"],["から"],["出て","でて"],["、"],["広がった","ひろがった"],["ので"],["ある"],["。"]]},{"verse":20,"text":"さてノアは農夫,のうふとなり、ぶどう畑,はたけをつくり始,はじめたが、","tok":[["さて"],["ノア"],["は"],["農夫","のうふ"],["と"],["なり"],["、"],["ぶどう"],["畑","はたけ"],["を"],["つくり"],["始めた","はじめた"],["が"],["、"]]},{"verse":21,"text":"彼,かれはぶどう酒,しゅを飲,のんで酔,よい、天幕,てんまくの中,なかで裸,はだかになっていた。","tok":[["彼","かれ"],["は"],["ぶどう酒","ぶどうしゅ"],["を"],["飲んで","のんで"],["酔","よい"],["、"],["天幕","てんまく"],["の"],["中","なか"],["で"],["裸","はだか"],["に"],["なって"],["いた"],["。"]]},{"verse":22,"text":"カナンの父,ちちハムは父,ちちの裸,はだかを見,みて、外,そとにいるふたりの兄弟,きょうだいに告,つげた。","tok":[["カナン"],["の"],["父","ちち"],["ハム"],["は"],["父","ちち"],["の"],["裸","はだか"],["を"],["見て","みて"],["、"],["外","そと"],["に"],["いる"],["ふたり"],["の"],["兄弟","きょうだい"],["に"],["告","つげ"],["た"],["。"]]},{"verse":23,"text":"セムとヤペテとは着物,きものを取,とって、肩,かたにかけ、うしろ向,むきに歩,あゆみ寄,よって、父,ちちの裸,はだかをおおい、顔,かおをそむけて父,ちちの裸,はだかを見,みなかった。","tok":[["セム"],["と"],["ヤペテ"],["と"],["は"],["着物","きもの"],["を"],["取って","とって"],["、"],["肩","かた"],["に"],["かけ"],["、"],["うしろ向き","うしろむき"],["に"],["歩み寄って","あゆみよって"],["、"],["父","ちち"],["の"],["裸","はだか"],["を"],["おおい"],["、"],["顔","かお"],["を"],["そむけて"],["父","ちち"],["の"],["裸","はだか"],["を"],["見なかった","みなかった"],["。"]]},{"verse":24,"text":"やがてノアは酔,よいがさめて、末,すえの子,こが彼,かれにした事,ことを知,しったとき、","tok":[["やがて"],["ノア"],["は"],["酔","よい"],["が"],["さめて"],["、"],["末","すえ"],["の"],["子","こ"],["が"],["彼","かれ"],["に"],["した"],["事","こと"],["を"],["知った","しった"],["とき"],["、"]]},{"verse":25,"text":"彼,かれは言,いった、「カナンはのろわれよ。彼,かれはしもべのしもべとなって、その兄弟,きょうだいたちに仕,つかえる」。","tok":[["彼","かれ"],["は"],["言った","いった"],["、"],["「"],["カナン"],["は"],["のろわれ"],["よ"],["。"],["彼","かれ"],["は"],["しもべ"],["の"],["しもべ"],["と"],["なって"],["、"],["その"],["兄弟","きょうだい"],["たち"],["に"],["仕える","つかえる"],["」"],["。"]]},{"verse":26,"text":"また言,いった、「セムの神,かみ、主,しゅはほむべきかな、カナンはそのしもべとなれ。","tok":[["また"],["言った","いった"],["、"],["「"],["セム"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["ほ"],["むべき"],["か"],["な"],["、"],["カナン"],["は"],["その"],["しもべ"],["と"],["なれ"],["。"]]},{"verse":27,"text":"神,かみはヤペテを大,おおいならしめ、セムの天幕,てんまくに彼,かれを住,すまわせられるように。カナンはそのしもべとなれ」。","tok":[["神","かみ"],["は"],["ヤペテ"],["を"],["大","お"],["おい"],["ならしめ"],["、"],["セム"],["の"],["天幕","てんまく"],["に"],["彼","かれ"],["を"],["住まわせられる","すまわせられる"],["よう"],["に"],["。"],["カナン"],["は"],["その"],["しもべ"],["と"],["なれ"],["」"],["。"]]},{"verse":28,"text":"ノアは洪水,こうずいの後,のち、なお三百五十年,ねん生,いきた。","tok":[["ノア"],["は"],["洪水","こうずい"],["の"],["後","の"],["ち"],["、"],["なお"],["三百五十","さんひゃくごじゅう"],["年","ねん"],["生きた","いきた"],["。"]]},{"verse":29,"text":"ノアの年,としは合,あわせて九百五十歳,さいであった。そして彼,かれは死,しんだ。","tok":[["ノア"],["の"],["年","とし"],["は"],["合","あわせ"],["て"],["九百五十","きゅうひゃくごじゅう"],["歳","さい"],["いで"],["あった"],["。"],["そして"],["彼","かれ"],["は"],["死んだ","しんだ"],["。"]]}]
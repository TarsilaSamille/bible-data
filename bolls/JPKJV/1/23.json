[{"verse":1,"text":"サラの一生,いっしょうは百二十七年,ねんであった。これがサラの生,いきながらえた年,としである。","tok":[["サラ"],["の"],["一生","いっしょう"],["は"],["百二十七","ひゃくにじゅうなな"],["年","ねん"],["で"],["あった"],["。"],["これ"],["が"],["サラ"],["の"],["生きながらえた","いきながらえた"],["年","とし"],["で"],["ある"],["。"]]},{"verse":2,"text":"サラはカナンの地,ちのキリアテ・アルバすなわちヘブロンで死,しんだ。アブラハムは中,なかにはいってサラのために悲,かなしみ泣,ないた。","tok":[["サラ"],["は"],["カナン"],["の"],["地","ち"],["の"],["キリアテ"],["・"],["アルバ"],["すなわち"],["ヘブロン"],["で"],["死んだ","しんだ"],["。"],["アブラハム"],["は"],["中","なか"],["に"],["はいって"],["サラ"],["の"],["ため"],["に"],["悲しみ","かなしみ"],["泣いた","ないた"],["。"]]},{"verse":3,"text":"アブラハムは死人,しにんのそばから立,たって、ヘテの人々,ひとびとに言,いった、","tok":[["アブラハム"],["は"],["死人","しにん"],["の"],["そば"],["から"],["立って","たって"],["、"],["ヘテ"],["の"],["人々","ひとびと"],["に"],["言った","いった"],["、"]]},{"verse":4,"text":"「わたしはあなたがたのうちの旅,たびの者,もので寄留者,きりゅうしゃですが、わたしの死人,しにんを出,だして葬,ほうむるため、あなたがたのうちにわたしの所有,しょゆうとして一つの墓地,ぼちをください」。","tok":[["「"],["わたし"],["は"],["あなた"],["がた"],["の"],["うち"],["の"],["旅","たび"],["の"],["者","もの"],["で"],["寄留者","きりゅうしゃ"],["です"],["が"],["、"],["わたし"],["の"],["死人","しにん"],["を"],["出して","だして"],["葬むる","ほうむる"],["ため"],["、"],["あなた"],["がた"],["の"],["うち"],["に"],["わたし"],["の"],["所有","しょゆう"],["として"],["一","ひと"],["つ"],["の"],["墓地","ぼち"],["を"],["ください"],["」"],["。"]]},{"verse":5,"text":"ヘテの人々,ひとびとはアブラハムに答,こたえて言,いった、","tok":[["ヘテ"],["の"],["人々","ひとびと"],["は"],["アブラハム"],["に"],["答","こたえ"],["て"],["言った","いった"],["、"]]},{"verse":6,"text":"「わが主,しゅよ、お聞,ききなさい。あなたはわれわれのうちにおられて、神,かみのような主君,しゅくんです。われわれの墓地,ぼちの最,もっとも良,よい所,ところにあなたの死人,しにんを葬,ほうむりなさい。その墓地,ぼちを拒,こばんで、あなたにその死人,しにんを葬,ほうむらせない者,ものはわれわれのうちには、ひとりもないでしょう」。","tok":[["「"],["わが"],["主","しゅ"],["よ"],["、"],["お聞","おきき"],["なさい"],["。"],["あなた"],["は"],["われわれ"],["の"],["うち"],["に"],["おられて"],["、"],["神","かみ"],["の"],["よう"],["な"],["主君","しゅくん"],["です"],["。"],["われわれ"],["の"],["墓地","ぼち"],["の"],["最も","もっとも"],["良い","よい"],["所","ところ"],["に"],["あなた"],["の"],["死人","しにん"],["を"],["葬むり","ほうむり"],["なさい"],["。"],["その"],["墓地","ぼち"],["を"],["拒んで","こばんで"],["、"],["あなた"],["に"],["その"],["死人","しにん"],["を"],["葬むらせない","ほうむらせない"],["者","もの"],["は"],["われわれ"],["の"],["うち"],["に"],["は"],["、"],["ひとり"],["も"],["ないでしょう"],["」"],["。"]]},{"verse":7,"text":"アブラハムは立,たちあがり、その地,ちの民,たみヘテの人々,ひとびとに礼,れいをして、","tok":[["アブラハム"],["は"],["立ちあがり","たちあがり"],["、"],["その"],["地","ち"],["の"],["民","たみ"],["ヘテ"],["の"],["人々","ひとびと"],["に"],["礼","れい"],["を"],["して"],["、"]]},{"verse":8,"text":"彼,かれらに言,いった、「もしわたしの死人,しにんを葬,ほうむるのに同意,どういされるなら、わたしの願,ねがいをいれて、わたしのためにゾハルの子,こエフロンに頼,たのみ、","tok":[["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["もし"],["わたし"],["の"],["死人","しにん"],["を"],["葬むる","ほうむる"],["のに"],["同意","どうい"],["されるなら"],["、"],["わたし"],["の"],["願い","ねがい"],["を"],["いれて"],["、"],["わたし"],["の"],["ため"],["に"],["ゾハル"],["の"],["子","こ"],["エフロン"],["に"],["頼み","たのみ"],["、"]]},{"verse":9,"text":"彼,かれが持,もっている畑,はたけの端,はしのマクペラのほら穴,あなをじゅうぶんな代価,だいかでわたしに与,あたえ、あなたがたのうちに墓地,ぼちを持,もたせてください」。","tok":[["彼","かれ"],["が"],["持って","もって"],["いる"],["畑","はたけ"],["の"],["端","はし"],["の"],["マクペラ"],["の"],["ほら穴","ほらあな"],["を"],["じゅうぶん"],["な"],["代価","だいか"],["で"],["わたし"],["に"],["与","あたえ"],["、"],["あなた"],["がた"],["の"],["うち"],["に"],["墓地","ぼち"],["を"],["持たせて","もたせて"],["ください"],["」"],["。"]]},{"verse":10,"text":"時,ときにエフロンはヘテの人々,ひとびとのうちにすわっていた。そこでヘテびとエフロンはヘテの人々,ひとびと、すなわちすべてその町,まちの門,もんにはいる人々,ひとびとの聞,きいているところで、アブラハムに答,こたえて言,いった、","tok":[["時","とき"],["に"],["エフロン"],["は"],["ヘテ"],["の"],["人々","ひとびと"],["の"],["うち"],["に"],["すわって"],["いた"],["。"],["そこ"],["で"],["ヘテ"],["びと"],["エフロン"],["は"],["ヘテ"],["の"],["人々","ひとびと"],["、"],["すなわち"],["すべて"],["その"],["町","まち"],["の"],["門","もん"],["に"],["はいる"],["人々","ひとびと"],["の"],["聞いて","きいて"],["いる"],["ところ"],["で"],["、"],["アブラハム"],["に"],["答","こたえ"],["て"],["言った","いった"],["、"]]},{"verse":11,"text":"「いいえ、わが主,しゅよ、お聞,ききなさい。わたしはあの畑,はたけをあなたにさしあげます。またその中,なかにあるほら穴,あなもさしあげます。わたしの民,たみの人々,ひとびとの前,まえで、それをさしあげます。あなたの死人,しにんを葬,ほうむりなさい」。","tok":[["「"],["いいえ"],["、"],["わが"],["主","しゅ"],["よ"],["、"],["お聞","おきき"],["なさい"],["。"],["わたし"],["は"],["あの"],["畑","はたけ"],["を"],["あなた"],["に"],["さしあげます"],["。"],["また"],["その"],["中","なか"],["に"],["ある"],["ほら穴","ほらあな"],["も"],["さしあげます"],["。"],["わたし"],["の"],["民","たみ"],["の"],["人々","ひとびと"],["の"],["前","まえ"],["で"],["、"],["それ"],["を"],["さしあげます"],["。"],["あなた"],["の"],["死人","しにん"],["を"],["葬むり","ほうむり"],["なさい"],["」"],["。"]]},{"verse":12,"text":"アブラハムはその地,ちの民,たみの前,まえで礼,れいをし、","tok":[["アブラハム"],["は"],["その"],["地","ち"],["の"],["民","たみ"],["の"],["前","まえ"],["で"],["礼","れい"],["を"],["し"],["、"]]},{"verse":13,"text":"その地,ちの民,たみの聞,きいているところでエフロンに言,いった、「あなたがそれを承諾,しょうだくされるなら、お聞,ききなさい。わたしはその畑,はたけの代価,だいかを払,はらいます。お受,うけ取,とりください。わたしの死人,しにんをそこに葬,ほうむりましょう」。","tok":[["その"],["地","ち"],["の"],["民","たみ"],["の"],["聞いて","きいて"],["いる"],["ところ"],["で"],["エフロン"],["に"],["言った","いった"],["、"],["「"],["あなた"],["が"],["それ"],["を"],["承諾","しょうだく"],["されるなら"],["、"],["お聞","おきき"],["なさい"],["。"],["わたし"],["は"],["その"],["畑","はたけ"],["の"],["代価","だいか"],["を"],["払います","はらいます"],["。"],["お受け","おうけ"],["取","とり"],["ください"],["。"],["わたし"],["の"],["死人","しにん"],["を"],["そこ"],["に"],["葬むりましょう","ほうむりましょう"],["」"],["。"]]},{"verse":14,"text":"エフロンはアブラハムに答,こたえて言,いった、","tok":[["エフロン"],["は"],["アブラハム"],["に"],["答","こたえ"],["て"],["言った","いった"],["、"]]},{"verse":15,"text":"「わが主,しゅよ、お聞,ききなさい。あの地,ちは銀,ぎん四百シケルですが、これはわたしとあなたの間,あいだで、なにほどのことでしょう。あなたの死人,しにんを葬,ほうむりなさい」。","tok":[["「"],["わが"],["主","しゅ"],["よ"],["、"],["お聞","おきき"],["なさい"],["。"],["あの"],["地","ち"],["は"],["銀","ぎん"],["四百","よんひゃく"],["シケル"],["です"],["が"],["、"],["これ"],["は"],["わたし"],["と"],["あなた"],["の"],["間","あいだ"],["で"],["、"],["なに"],["ほど"],["の"],["こと"],["でしょう"],["。"],["あなた"],["の"],["死人","しにん"],["を"],["葬むり","ほうむり"],["なさい"],["」"],["。"]]},{"verse":16,"text":"そこでアブラハムはエフロンの言葉,ことばにしたがい、エフロンがヘテの人々,ひとびとの聞,きいているところで言,いった銀,ぎん、すなわち商人,しょうにんの通用,つうよう銀,ぎん四百シケルを量,はかってエフロンに与,あたえた。","tok":[["そこ"],["で"],["アブラハム"],["は"],["エフロン"],["の"],["言葉","ことば"],["に"],["したがい"],["、"],["エフロン"],["が"],["ヘテ"],["の"],["人々","ひとびと"],["の"],["聞いて","きいて"],["いる"],["ところ"],["で"],["言った","いった"],["銀","ぎん"],["、"],["すなわち"],["商人","しょうにん"],["の"],["通用","つうよう"],["銀","ぎん"],["四百","よんひゃく"],["シケル"],["を"],["量って","はかって"],["エフロン"],["に"],["与","あたえ"],["た"],["。"]]},{"verse":17,"text":"こうしてマムレの前,まえのマクペラにあるエフロンの畑,はたけは、畑,はたけも、その中,なかのほら穴,あなも、畑,はたけの中,なかおよびその周囲,しゅういの境,さかいにあるすべての木,きも皆,みな、","tok":[["こう"],["して"],["マムレ"],["の"],["前","まえ"],["の"],["マクペラ"],["に"],["ある"],["エフロン"],["の"],["畑","はたけ"],["は"],["、"],["畑","はたけ"],["も"],["、"],["その"],["中","なか"],["の"],["ほら穴","ほらあな"],["も"],["、"],["畑","はたけ"],["の"],["中","なか"],["および"],["その"],["周囲","しゅうい"],["の"],["境","さかい"],["に"],["ある"],["すべて"],["の"],["木","き"],["も"],["皆","みな"],["、"]]},{"verse":18,"text":"ヘテの人々,ひとびとの前,まえ、すなわちその町,まちの門,もんにはいるすべての人々,ひとびとの前,まえで、アブラハムの所有,しょゆうと決,きまった。","tok":[["ヘテ"],["の"],["人々","ひとびと"],["の"],["前","まえ"],["、"],["すなわち"],["その"],["町","まち"],["の"],["門","もん"],["に"],["は"],["いる"],["すべて"],["の"],["人々","ひとびと"],["の"],["前","まえ"],["で"],["、"],["アブラハム"],["の"],["所有","しょゆう"],["と"],["決まった","きまった"],["。"]]},{"verse":19,"text":"その後,のち、アブラハムはその妻,つまサラをカナンの地,ちにあるマムレ、すなわちヘブロンの前,まえのマクペラの畑,はたけのほら穴,あなに葬,ほうむった。","tok":[["その後","そのの"],["ち"],["、"],["アブラハム"],["は"],["その"],["妻","つま"],["サラ"],["を"],["カナン"],["の"],["地","ち"],["に"],["ある"],["マムレ"],["、"],["すなわち"],["ヘブロン"],["の"],["前","まえ"],["の"],["マクペラ"],["の"],["畑","はたけ"],["の"],["ほら穴","ほらあな"],["に"],["葬むった","ほうむった"],["。"]]},{"verse":20,"text":"このように畑,はたけとその中,なかにあるほら穴,あなとはヘテの人々,ひとびとによってアブラハムの所有,しょゆうの墓地,ぼちと定,さだめられた。","tok":[["この"],["よう"],["に"],["畑","はたけ"],["と"],["その"],["中","なか"],["に"],["ある"],["ほら穴","ほらあな"],["と"],["は"],["ヘテ"],["の"],["人々","ひとびと"],["によって"],["アブラハム"],["の"],["所有","しょゆう"],["の"],["墓地","ぼち"],["と"],["定められた","さだめられた"],["。"]]}]
[{"verse":1,"text":"そこでヨセフはそばに立,たっているすべての人,ひとの前,まえで、自分,じぶんを制,せいしきれなくなったので、「人,ひとは皆,みなここから出,でてください」と呼,よばわった。それゆえヨセフが兄弟,きょうだいたちに自分,じぶんのことを明,あかした時,とき、ひとりも彼,かれのそばに立,たっている者,ものはなかった。","tok":[["そこ"],["で"],["ヨセフ"],["は"],["そば"],["に"],["立って","たって"],["いる"],["すべて"],["の"],["人","ひと"],["の"],["前","まえ"],["で"],["、"],["自分","じぶん"],["を"],["制し","せいし"],["きれなく"],["なった"],["ので"],["、"],["「"],["人","ひと"],["は"],["皆","みな"],["ここ"],["から"],["出て","でて"],["ください"],["」"],["と"],["呼ばわった","よばわった"],["。"],["それ"],["ゆえ"],["ヨセフ"],["が"],["兄弟","きょうだい"],["たち"],["に"],["自分","じぶん"],["の"],["こと"],["を"],["明かした","あかした"],["時","とき"],["、"],["ひとり"],["も"],["彼","かれ"],["の"],["そば"],["に"],["立って","たって"],["いる"],["者","もの"],["は"],["なかった"],["。"]]},{"verse":2,"text":"ヨセフは声,こえをあげて泣,ないた。エジプトびとはこれを聞,きき、パロの家,いえもこれを聞,きいた。","tok":[["ヨセフ"],["は"],["声","こえ"],["を"],["あげて"],["泣いた","ないた"],["。"],["エジプト"],["び"],["と"],["は"],["これ"],["を"],["聞","きき"],["、"],["パロ"],["の"],["家","いえ"],["も"],["これ"],["を"],["聞いた","きいた"],["。"]]},{"verse":3,"text":"ヨセフは兄弟,きょうだいたちに言,いった、「わたしはヨセフです。父,ちちはまだ生,いきながらえていますか」。兄弟,きょうだいたちは答,こたえることができなかった。彼,かれらは驚,おどろき恐,おそれたからである。","tok":[["ヨセフ"],["は"],["兄弟","きょうだい"],["たち"],["に"],["言った","いった"],["、"],["「"],["わたし"],["は"],["ヨセフ"],["です"],["。"],["父","ちち"],["は"],["まだ"],["生きながらえて","いきながらえて"],["います"],["か"],["」"],["。"],["兄弟","きょうだい"],["たち"],["は"],["答","こたえ"],["る"],["こと"],["が"],["できなかった"],["。"],["彼","かれ"],["ら"],["は"],["驚","おどろき"],["恐","おそれ"],["たから"],["で"],["ある"],["。"]]},{"verse":4,"text":"ヨセフは兄弟,きょうだいたちに言,いった、「わたしに近寄,ちかよってください」。彼,かれらが近寄,ちかよったので彼,かれは言,いった、「わたしはあなたがたの弟,おとうとヨセフです。あなたがたがエジプトに売,うった者,ものです。","tok":[["ヨセフ"],["は"],["兄弟","きょうだい"],["たち"],["に"],["言った","いった"],["、"],["「"],["わたし"],["に"],["近寄って","ちかよって"],["ください"],["」"],["。"],["彼","かれ"],["ら"],["が"],["近寄った","ちかよった"],["ので"],["彼","かれ"],["は"],["言った","いった"],["、"],["「"],["わたし"],["は"],["あなた"],["がた"],["の"],["弟","おとうと"],["ヨセフ"],["です"],["。"],["あなた"],["がた"],["が"],["エジプト"],["に"],["売った","うった"],["者","もの"],["です"],["。"]]},{"verse":5,"text":"しかしわたしをここに売,うったのを嘆,なげくことも、悔,くやむこともいりません。神,かみは命,いのちを救,すくうために、あなたがたよりさきにわたしをつかわされたのです。","tok":[["しかし"],["わたし"],["を"],["ここ"],["に"],["売った","うった"],["の"],["を"],["嘆く","なげく"],["こと"],["も"],["、"],["悔やむ","くやむ"],["こと"],["も"],["いりません"],["。"],["神","かみ"],["は"],["命","いのち"],["を"],["救う","すくう"],["ため"],["に"],["、"],["あなた"],["が"],["たより"],["さき"],["に"],["わたし"],["を"],["つかわされた"],["の"],["です"],["。"]]},{"verse":6,"text":"この二年,ねんの間,あいだ、国中,くにぢゅうにききんがあったが、なお五年,ねんの間,あいだは耕,たがやすことも刈,かり入,いれることもないでしょう。","tok":[["この"],["二","に"],["年","ねん"],["の"],["間","あいだ"],["、"],["国中","く"],["に"],["ぢゅう"],["に"],["ききん"],["が"],["あった"],["が"],["、"],["なお"],["五","ご"],["年","ねん"],["の"],["間","あいだ"],["は"],["耕やす","たがやす"],["こと"],["も"],["刈入れる","かりいれる"],["こと"],["も"],["ないでしょう"],["。"]]},{"verse":7,"text":"神,かみは、あなたがたのすえを地,ちに残,のこすため、また大,おおいなる救,すくいをもってあなたがたの命,いのちを助,たすけるために、わたしをあなたがたよりさきにつかわされたのです。","tok":[["神","かみ"],["は"],["、"],["あなた"],["がた"],["の"],["すえ"],["を"],["地","ち"],["に"],["残す","のこす"],["ため"],["、"],["また"],["大いなる","おおいなる"],["救い","すくい"],["を"],["もって"],["あなた"],["がた"],["の"],["命","いのち"],["を"],["助ける","たすける"],["ため"],["に"],["、"],["わたし"],["を"],["あなた"],["が"],["たより"],["さき"],["に"],["つかわされた"],["の"],["です"],["。"]]},{"verse":8,"text":"それゆえわたしをここにつかわしたのはあなたがたではなく、神,かみです。神,かみはわたしをパロの父,ちちとし、その全家,ぜんかの主,しゅとし、またエジプト全国,ぜんこくのつかさとされました。","tok":[["それ"],["ゆえ"],["わたし"],["を"],["ここ"],["に"],["つかわした"],["の"],["は"],["あなた"],["がた"],["で"],["は"],["なく"],["、"],["神","かみ"],["です"],["。"],["神","かみ"],["は"],["わたし"],["を"],["パロ"],["の"],["父","ちち"],["と"],["し"],["、"],["その"],["全","ぜん"],["家","いえ"],["の"],["主","しゅ"],["と"],["し"],["、"],["また"],["エジプト"],["全国","ぜんこく"],["の"],["つかさ"],["と"],["されました"],["。"]]},{"verse":9,"text":"あなたがたは父,ちちのもとに急,いそぎ上,のぼって言,いいなさい、『あなたの子,こヨセフが、こう言,いいました。神,かみがわたしをエジプト全国,ぜんこくの主,しゅとされたから、ためらわずにわたしの所,ところへ下,くだってきなさい。","tok":[["あなた"],["がた"],["は"],["父","ちち"],["の"],["もと"],["に"],["急ぎ","いそぎ"],["上って","のぼって"],["言い","いい"],["なさい"],["、"],["『"],["あなた"],["の"],["子","こ"],["ヨセフ"],["が"],["、"],["こう"],["言いました","いいました"],["。"],["神","かみ"],["が"],["わたし"],["を"],["エジプト"],["全国","ぜんこく"],["の"],["主","しゅ"],["と"],["された"],["から"],["、"],["ためらわず"],["に"],["わたし"],["の"],["所","ところ"],["へ"],["下って","くだって"],["き"],["なさい"],["。"]]},{"verse":10,"text":"あなたはゴセンの地,ちに住,すみ、あなたも、あなたの子,こらも、孫,まごたちも、羊,ひつじも牛,うしも、その他,たのものもみな、わたしの近,ちかくにおらせます。","tok":[["あなた"],["は"],["ゴセン"],["の"],["地","ち"],["に"],["住み","すみ"],["、"],["あなた"],["も"],["、"],["あなた"],["の"],["子","こ"],["ら"],["も"],["、"],["孫","まご"],["たち"],["も"],["、"],["羊","ひつじ"],["も"],["牛","うし"],["も"],["、"],["その"],["他","た"],["の"],["もの"],["も"],["みな"],["、"],["わたし"],["の"],["近く","ちかく"],["に"],["おらせます"],["。"]]},{"verse":11,"text":"ききんはなお五年,ねんつづきますから、あなたも、家族,かぞくも、その他,たのものも、みな困,こまらないように、わたしはそこで養,やしないましょう』。","tok":[["ききん"],["は"],["なお"],["五","ご"],["年","ねん"],["ら"],["、"],["あなた"],["も"],["、"],["家族","かぞく"],["も"],["、"],["その"],["他","た"],["の"],["もの"],["も"],["、"],["みな"],["困まらない","こまらない"],["よう"],["に"],["、"],["わたし"],["は"],["そこ"],["で"],["養いましょう","やしないましょう"],["』"],["。"]]},{"verse":12,"text":"あなたがたと弟,おとうとベニヤミンが目,めに見,みるとおり、あなたがたに口,くちずから語,かたっているのはこのわたしです。","tok":[["あなた"],["がた"],["と"],["弟","おとうと"],["ベニヤミン"],["が"],["目","め"],["に"],["見る","みる"],["と"],["おり"],["、"],["あなた"],["がた"],["に"],["口ずから","くちずから"],["語って","かたって"],["いる"],["の"],["は"],["この"],["わたし"],["です"],["。"]]},{"verse":13,"text":"あなたがたはエジプトでの、わたしのいっさいの栄,さかえと、あなたがたが見,みるいっさいの事,ことをわたしの父,ちちに告,つげ、急,いそいでわたしの父,ちちをここへ連,つれ下,くだりなさい」。","tok":[["あなた"],["がた"],["は"],["エジプト"],["で"],["の"],["、"],["わたし"],["の"],["いっさい"],["の"],["栄","さかえ"],["と"],["、"],["あなた"],["がた"],["が"],["見る","みる"],["いっさい"],["の"],["事","こと"],["を"],["わたし"],["の"],["父","ちち"],["に"],["告","つげ"],["、"],["急いで","いそいで"],["わたし"],["の"],["父","ちち"],["を"],["ここ"],["へ"],["連れ","つれ"],["下","く"],["だり"],["なさい"],["」"],["。"]]},{"verse":14,"text":"そしてヨセフは弟,おとうとベニヤミンのくびを抱,だいて泣,なき、ベニヤミンも彼,かれのくびを抱,だいて泣,ないた。","tok":[["そして"],["ヨセフ"],["は"],["弟","おとうと"],["ベニヤミン"],["の"],["くび"],["を"],["抱いて","だいて"],["泣","なき"],["、"],["ベニヤミン"],["も"],["彼","かれ"],["の"],["くび"],["を"],["抱いて","だいて"],["泣いた","ないた"],["。"]]},{"verse":15,"text":"またヨセフはすべての兄弟,きょうだいたちに口,くちづけし、彼,かれらを抱,だいて泣,ないた。そして後,のち、兄弟,きょうだいたちは彼,かれと語,かたった。","tok":[["また"],["ヨセフ"],["は"],["すべて"],["の"],["兄弟","きょうだい"],["たち"],["に"],["口づけ","くちづけ"],["し"],["、"],["彼","かれ"],["ら"],["を"],["抱いて","だいて"],["泣いた","ないた"],["。"],["そして"],["後","の"],["ち"],["、"],["兄弟","きょうだい"],["たち"],["は"],["彼","かれ"],["と"],["語った","かたった"],["。"]]},{"verse":16,"text":"時,ときに、「ヨセフの兄弟,きょうだいたちがきた」と言,いううわさがパロの家,いえに聞,きこえたので、パロとその家来,けらいたちとは喜,よろこんだ。","tok":[["時","とき"],["に"],["、"],["「"],["ヨセフ"],["の"],["兄弟","きょうだい"],["たち"],["が"],["きた"],["」"],["と"],["言う","いう"],["うわさ"],["が"],["パロ"],["の"],["家","いえ"],["に"],["聞こえた","きこえた"],["ので"],["、"],["パロ"],["と"],["その"],["家来","けらい"],["たち"],["と"],["は"],["喜こんだ","よろこんだ"],["。"]]},{"verse":17,"text":"パロはヨセフに言,いった、「兄弟,きょうだいたちに言,いいなさい、『あなたがたは、こうしなさい。獣,けものに荷,にを負,おわせてカナンの地,ちへ行,いき、","tok":[["パロ"],["は"],["ヨセフ"],["に"],["言った","いった"],["、"],["「"],["兄弟","きょうだい"],["たち"],["に"],["言い","いい"],["なさい"],["、"],["『"],["あなた"],["がた"],["は"],["、"],["こう"],["し"],["なさい"],["。"],["獣","けもの"],["に"],["荷","に"],["を"],["負わせて","おわせて"],["カナン"],["の"],["地","ち"],["へ"],["行き","いき"],["、"]]},{"verse":18,"text":"父,ちちと家族,かぞくとを連,つれてわたしのもとへきなさい。わたしはあなたがたに、エジプトの地,ちの良,よい物,ものを与,あたえます。あなたがたは、この国,くにの最,もっとも良,よいものを食,たべるでしょう』。","tok":[["父","ちち"],["と"],["家族","かぞく"],["と"],["を"],["連れて","つれて"],["わたし"],["の"],["もと"],["へ"],["き"],["なさい"],["。"],["わたし"],["は"],["あなた"],["がた"],["に"],["、"],["エジプト"],["の"],["地","ち"],["の"],["良い","よい"],["物","もの"],["を"],["与えます","あたえます"],["。"],["あなた"],["がた"],["は"],["、"],["この"],["国","くに"],["の"],["最も","もっとも"],["良い","よい"],["もの"],["を"],["食べるでしょう","たべるでしょう"],["』"],["。"]]},{"verse":19,"text":"また彼,かれらに命,めいじなさい、『あなたがたは、こうしなさい。幼,おさな子,こたちと妻,つまたちのためにエジプトの地,ちから車,くるまをもって行,いき、父,ちちを連,つれてきなさい。","tok":[["また"],["彼","かれ"],["ら"],["に"],["命じ","めいじ"],["なさい"],["、"],["『"],["あなた"],["がた"],["は"],["、"],["こう"],["し"],["なさい"],["。"],["幼な子","おさなこ"],["たち"],["と"],["妻たち","つまたち"],["の"],["ため"],["に"],["エジプト"],["の"],["地","ち"],["から"],["車","くるま"],["を"],["もって"],["行き","いき"],["、"],["父","ちち"],["を"],["連れて","つれて"],["き"],["なさい"],["。"]]},{"verse":20,"text":"家財,かざいに心,こころを引,ひかれてはなりません。エジプト全国,ぜんこくの良,よい物,ものは、あなたがたのものだからです』」。","tok":[["家財","かざい"],["に"],["心","こころ"],["を"],["引かれて","ひかれて"],["は"],["なりません"],["。"],["エジプト"],["全国","ぜんこく"],["の"],["良い","よい"],["物","もの"],["は"],["、"],["あなた"],["がた"],["の"],["もの"],["だ"],["から"],["です"],["』"],["」"],["。"]]},{"verse":21,"text":"イスラエルの子,こらはそのようにした。ヨセフはパロの命,いのちに従,したがって彼,かれらに車,くるまを与,あたえ、また途中,とちゅうの食料,しょくりょうをも与,あたえた。","tok":[["イスラエル"],["の"],["子","こ"],["ら"],["は"],["その"],["よう"],["に"],["した"],["。"],["ヨセフ"],["は"],["パロ"],["の"],["命","いのち"],["に"],["従って","したがって"],["彼","かれ"],["ら"],["に"],["車","くるま"],["を"],["与","あたえ"],["、"],["また"],["途中","とちゅう"],["の"],["食料","しょくりょう"],["を"],["も"],["与","あたえ"],["た"],["。"]]},{"verse":22,"text":"まためいめいに晴着,はれぎを与,あたえたが、ベニヤミンには銀,ぎん三百シケルと晴着,はれぎ五着,ちゃくとを与,あたえた。","tok":[["また"],["めいめい"],["に"],["晴着","はれぎ"],["を"],["与えた","あたえた"],["が"],["、"],["ベニヤミン"],["に"],["は"],["銀","ぎん"],["三百","さんひゃく"],["シケル"],["と"],["晴着","はれぎ"],["五","ご"],["着","ちゃく"],["を"],["与","あたえ"],["た"],["。"]]},{"verse":23,"text":"また彼,かれは父,ちちに次,つぎのようなものを贈,おくった。すなわちエジプトの良,よい物,ものを負,おわせたろば十頭,とうと、穀物,こくもつ、パン及,および父,ちちの道中,どうちゅうの食料,しょくりょうを負,おわせた雌,めろば十頭,とう。","tok":[["また"],["彼","かれ"],["は"],["父","ちち"],["に"],["次","つぎ"],["の"],["よう"],["な"],["もの"],["を"],["贈った","おくった"],["。"],["すなわち"],["エジプト"],["の"],["良い","よい"],["物","もの"],["を"],["負わせたろば","おわせたろば"],["十頭","とう"],["と"],["、"],["穀物","こくもつ"],["、"],["パン"],["及","および"],["父","ちち"],["の"],["道中","どうちゅう"],["の"],["食料","しょくりょう"],["を"],["負わせた","おわせた"],["雌","め"],["ろば"],["十頭","と"],["う"],["。"]]},{"verse":24,"text":"こうしてヨセフは兄弟,きょうだいたちを送,おくり去,さらせ、彼,かれらに言,いった、「途中,とちゅうで争,あらそってはなりません」。","tok":[["こう"],["して"],["ヨセフ"],["は"],["兄弟","きょうだい"],["たち"],["を"],["送り","おくり"],["去らせ","さらせ"],["、"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["途中","とちゅう"],["で"],["争って","あらそって"],["は"],["なりません"],["」"],["。"]]},{"verse":25,"text":"彼,かれらはエジプトから上,のぼってカナンの地,ちに入,いり、父,ちちヤコブのもとへ行,いって、","tok":[["彼","かれ"],["ら"],["は"],["エジプト"],["から"],["上って","のぼって"],["カナン"],["の"],["地","ち"],["に"],["入","いり"],["、"],["父","ちち"],["ヤコブ"],["の"],["もと"],["へ"],["行って","いって"],["、"]]},{"verse":26,"text":"彼,かれに言,いった、「ヨセフはなお生,いきていてエジプト全国,ぜんこくのつかさです」。ヤコブは気,きが遠,とおくなった。彼,かれらの言,いうことが信,しんじられなかったからである。","tok":[["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["ヨセフ"],["は"],["なお"],["生きて","いきて"],["いて"],["エジプト"],["全国","ぜんこく"],["の"],["つかさ"],["です"],["」"],["。"],["ヤコブ"],["は"],["気","き"],["が"],["遠く","とおく"],["なった"],["。"],["彼","かれ"],["ら"],["の"],["言う","いう"],["こと"],["が"],["信じられなかった","しんじられなかった"],["から"],["で"],["ある"],["。"]]},{"verse":27,"text":"そこで彼,かれらはヨセフが語,かたった言葉,ことばを残,のこらず彼,かれに告,つげた。父,ちちヤコブはヨセフが自分,じぶんを乗,のせるために送,おくった車,くるまを見,みて元,もと気,きづいた。","tok":[["そこ"],["で"],["彼","かれ"],["ら"],["は"],["ヨセフ"],["が"],["語った","かたった"],["言葉","ことば"],["を"],["残らず","のこらず"],["彼","かれ"],["に"],["告","つげ"],["た"],["。"],["父","ちち"],["ヤコブ"],["は"],["ヨセフ"],["が"],["自分","じぶん"],["を"],["乗せる","のせる"],["ため"],["に"],["送った","おくった"],["車","くるま"],["を"],["見て","みて"],["元気","もとき"],["づいた"],["。"]]},{"verse":28,"text":"そしてイスラエルは言,いった、「満足,まんぞくだ。わが子,こヨセフがまだ生,いきている。わたしは死,しぬ前,まえに行,いって彼,かれを見,みよう」。","tok":[["そして"],["イスラエル"],["は"],["言った","いった"],["、"],["「"],["満足","まんぞく"],["だ"],["。"],["わが"],["子","こ"],["ヨセフ"],["が"],["まだ"],["生きて","いきて"],["いる"],["。"],["わたし"],["は"],["死ぬ","しぬ"],["前","まえ"],["に"],["行って","いって"],["彼","かれ"],["を"],["見よう","みよう"],["」"],["。"]]}]
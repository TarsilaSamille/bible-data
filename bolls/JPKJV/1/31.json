[{"verse":1,"text":"さてヤコブはラバンの子,こらが、「ヤコブはわれわれの父,ちちの物,ものをことごとく奪,うばい、父,ちちの物,ものによってあのすべての富,とみを獲,えたのだ」と言,いっているのを聞,きいた。","tok":[["さて"],["ヤコブ"],["は"],["ラバン"],["の"],["子","こ"],["ら"],["が"],["、"],["「"],["ヤコブ"],["は"],["われわれ"],["の"],["父","ちち"],["の"],["物","もの"],["を"],["ことごとく"],["奪い","うばい"],["、"],["父","ちち"],["の"],["物","もの"],["によって"],["あの"],["すべて"],["の"],["富","とみ"],["を"],["獲た","えた"],["の"],["だ"],["」"],["と"],["言って","いって"],["いる"],["の"],["を"],["聞いた","きいた"],["。"]]},{"verse":2,"text":"またヤコブがラバンの顔,かおを見,みるのに、それは自分,じぶんに対,たいして以前,いぜんのようではなかった。","tok":[["また"],["ヤコブ"],["が"],["ラバン"],["の"],["顔","かお"],["を"],["見る","みる"],["のに"],["、"],["それ"],["は"],["自分","じぶん"],["に対して","にたいして"],["以前","いぜん"],["の"],["よう"],["で"],["は"],["なかった"],["。"]]},{"verse":3,"text":"主,しゅはヤコブに言,いわれた、「あなたの先祖,せんぞの国,くにへ帰,かえり、親族,しんぞくのもとに行,いきなさい。わたしはあなたと共,ともにいるであろう」。","tok":[["主","しゅ"],["は"],["ヤコブ"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["の"],["先祖","せんぞ"],["の"],["国","くに"],["へ"],["帰えり","かえり"],["、"],["親族","しんぞく"],["の"],["もと"],["に"],["行き","いき"],["なさい"],["。"],["わたし"],["は"],["あなた"],["と"],["共","とも"],["に"],["いるで"],["あろう"],["」"],["。"]]},{"verse":4,"text":"そこでヤコブは人,ひとをやって、ラケルとレアとを、野,のにいる自分,じぶんの群,むれのところに招,まねき、","tok":[["そこ"],["で"],["ヤコブ"],["は"],["人","ひと"],["を"],["やって"],["、"],["ラケル"],["と"],["レア"],["と"],["を"],["、"],["野","の"],["に"],["いる"],["自分","じぶん"],["の"],["群れ","むれ"],["の"],["ところ"],["に"],["招き","まねき"],["、"]]},{"verse":5,"text":"彼女,かのじょらに言,いった、「わたしがあなたがたの父,ちちの顔,かおを見,みるのに、わたしに対,たいして以前,いぜんのようではない。しかし、わたしの父,ちちの神,かみはわたしと共,ともにおられる。","tok":[["彼女","かのじょ"],["ら"],["に"],["言った","いった"],["、"],["「"],["わたし"],["が"],["あなた"],["がた"],["の"],["父","ちち"],["の"],["顔","かお"],["を"],["見る","みる"],["のに"],["、"],["わたし"],["に対して","にたいして"],["以前","いぜん"],["の"],["よう"],["で"],["は"],["ない"],["。"],["しかし"],["、"],["わたし"],["の"],["父","ちち"],["の"],["神","かみ"],["は"],["わたし"],["と"],["共","とも"],["に"],["おられる"],["。"]]},{"verse":6,"text":"あなたがたが知,しっているように、わたしは力,ちからのかぎり、あなたがたの父,ちちに仕,つかえてきた。","tok":[["あなた"],["がた"],["が"],["知って","しって"],["いる"],["よう"],["に"],["、"],["わたし"],["は"],["力","ちから"],["の"],["かぎり"],["、"],["あなた"],["がた"],["の"],["父","ちち"],["に"],["仕えて","つかえて"],["きた"],["。"]]},{"verse":7,"text":"しかし、あなたがたの父,ちちはわたしを欺,あざむいて、十度,どもわたしの報酬,ほうしゅうを変,かえた。けれども神,かみは彼,かれがわたしに害,がいを加,くわえることをお許,おゆるしにならなかった。","tok":[["しかし"],["、"],["あなた"],["がた"],["の"],["父","ちち"],["は"],["わたし"],["を"],["欺いて","あざむいて"],["、"],["十","じゅう"],["度","ど"],["も"],["わたし"],["の"],["報酬","ほうしゅう"],["を"],["変えた","かえた"],["。"],["けれど"],["も"],["神","かみ"],["は"],["彼","かれ"],["が"],["わたし"],["に"],["害","がい"],["を"],["加える","くわえる"],["こと"],["を"],["お"],["許","おゆるし"],["に"],["ならなかった"],["。"]]},{"verse":8,"text":"もし彼,かれが、『ぶちのものはあなたの報酬,ほうしゅうだ』と言,いえば、群,むれは皆,みなぶちのものを産,うんだ。もし彼,かれが、『しまのあるものはあなたの報酬,ほうしゅうだ』と言,いえば、群,むれは皆,みなしまのあるものを産,うんだ。","tok":[["もし"],["彼","かれ"],["が"],["、"],["『"],["ぶち"],["の"],["もの"],["は"],["あなた"],["の"],["報酬","ほうしゅう"],["だ"],["』"],["と"],["言えば","いえば"],["、"],["群れ","むれ"],["は"],["皆","みな"],["ぶち"],["の"],["もの"],["を"],["産んだ","うんだ"],["。"],["もし"],["彼","かれ"],["が"],["、"],["『"],["しま"],["の"],["ある"],["もの"],["は"],["あなた"],["の"],["報酬","ほうしゅう"],["だ"],["』"],["と"],["言えば","いえば"],["、"],["群れ","むれ"],["は"],["皆","みな"],["しま"],["の"],["ある"],["もの"],["を"],["産んだ","うんだ"],["。"]]},{"verse":9,"text":"こうして神,かみはあなたがたの父,ちちの家畜,かちくをとってわたしに与,あたえられた。","tok":[["こう"],["して"],["神","かみ"],["は"],["あなた"],["がた"],["の"],["父","ちち"],["の"],["家畜","かちく"],["を"],["とって"],["わたし"],["に"],["与えられた","あたえられた"],["。"]]},{"verse":10,"text":"また群,むれが発情,はつじょうした時,とき、わたしが夢,ゆめに目,めをあげて見,みると、群,むれの上,うえに乗,のっている雄,おやぎは皆,みなしまのあるもの、ぶちのもの、霜,しもふりのものであった。","tok":[["また"],["群れ","むれ"],["が"],["発情","はつじょう"],["した"],["時","とき"],["、"],["わたし"],["が"],["夢","ゆめ"],["に"],["目","め"],["を"],["あげて"],["見る","みる"],["と"],["、"],["群れ","むれ"],["の"],["上","うえ"],["に"],["乗って","のって"],["いる"],["雄","おやぎ"],["は"],["皆","みな"],["しま"],["の"],["ある"],["もの"],["、"],["ぶち"],["の"],["もの"],["、"],["霜ふり","しもふり"],["の"],["もの"],["で"],["あった"],["。"]]},{"verse":11,"text":"その時,とき、神,かみの使,つかいが夢,ゆめの中,なかでわたしに言,いった、『ヤコブよ』。わたしは答,こたえた、『ここにおります』。","tok":[["その"],["時","とき"],["、"],["神","かみ"],["の"],["使","つかい"],["が"],["夢","ゆめ"],["の"],["中","なか"],["で"],["わたし"],["に"],["言った","いった"],["、"],["『"],["ヤコブ"],["よ"],["』"],["。"],["わたし"],["は"],["答","こたえ"],["た"],["、"],["『"],["ここ"],["に"],["おります"],["』"],["。"]]},{"verse":12,"text":"神,かみの使,つかいは言,いった、『目,めを上,あげて見,みてごらん。群,むれの上,うえに乗,のっている雄,おやぎは皆,みなしまのあるもの、ぶちのもの、霜,しもふりのものです。わたしはラバンがあなたにしたことをみな見,みています。","tok":[["神","かみ"],["の"],["使い","つかい"],["は"],["言った","いった"],["、"],["『"],["目","め"],["を"],["上げて","あげて"],["見て","みて"],["ごらん"],["。"],["群れ","むれ"],["の"],["上","うえ"],["に"],["乗って","のって"],["いる"],["雄","おやぎ"],["は"],["皆","みな"],["しま"],["の"],["ある"],["もの"],["、"],["ぶち"],["の"],["もの"],["、"],["霜ふり","しもふり"],["の"],["もの"],["です"],["。"],["わたし"],["は"],["ラバン"],["が"],["あなた"],["に"],["した"],["こと"],["を"],["みな"],["見て","みて"],["います"],["。"]]},{"verse":13,"text":"わたしはベテルの神,かみです。かつてあなたはあそこで柱,はしらに油,あぶらを注,そそいで、わたしに誓,ちかいを立,たてましたが、いま立,たってこの地,ちを出,でて、あなたの生,うまれた国,くにへ帰,かえりなさい』」。","tok":[["わたし"],["は"],["ベテル"],["の"],["神","かみ"],["です"],["。"],["かつて"],["あなた"],["は"],["あそこ"],["で"],["柱","はしら"],["に"],["油","あぶら"],["を"],["注いで","そそいで"],["、"],["わたし"],["に"],["誓い","ちかい"],["を"],["立てました","たてました"],["が"],["、"],["いま"],["立って","たって"],["この"],["地","ち"],["を"],["出て","でて"],["、"],["あなた"],["の"],["生まれた","うまれた"],["国","くに"],["へ"],["帰えり","かえり"],["なさい"],["』"],["」"],["。"]]},{"verse":14,"text":"ラケルとレアは答,こたえて言,いった、「わたしたちの父,ちちの家,いえに、なおわたしたちの受,うくべき分,ぶん、また嗣,し業,ぎょうがありましょうか。","tok":[["ラケル"],["と"],["レア"],["は"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["わたしたち"],["の"],["父","ちち"],["の"],["家","いえ"],["に"],["、"],["なお"],["わたしたち"],["の"],["受","う"],["くべき"],["分","ぶん"],["、"],["また"],["嗣業","しぎょう"],["が"],["ありましょう"],["か"],["。"]]},{"verse":15,"text":"わたしたちは父,ちちに他人,たにんのように思,おもわれているではありませんか。彼,かれはわたしたちを売,うったばかりでなく、わたしたちのその金,かねをさえ使,つかい果,はたしたのです。","tok":[["わたしたち"],["は"],["父","ちち"],["に"],["他人","たにん"],["の"],["よう"],["に"],["思われて","おもわれて"],["いるで"],["は"],["ありません"],["か"],["。"],["彼","かれ"],["は"],["わたしたち"],["を"],["売った","うった"],["ばかり"],["で"],["なく"],["、"],["わたしたち"],["の"],["その"],["金","かね"],["を"],["さえ"],["使い果たした","つかいはたした"],["の"],["です"],["。"]]},{"verse":16,"text":"神,かみがわたしたちの父,ちちから取,とりあげられた富,とみは、みなわたしたちとわたしたちの子,こどものものです。だから何事,なにごとでも神,かみがあなたにお告,つげになった事,ことをしてください」。","tok":[["神","かみ"],["が"],["わたしたち"],["の"],["父","ちち"],["から"],["取","とり"],["あげられた"],["富","とみ"],["は"],["、"],["みな"],["わたしたち"],["と"],["わたしたち"],["の"],["子ども","こども"],["の"],["もの"],["です"],["。"],["だ"],["から"],["何事","なにごと"],["で"],["も"],["神","かみ"],["が"],["あなた"],["に"],["お告","おつげ"],["に"],["なった"],["事","こと"],["を"],["して"],["ください"],["」"],["。"]]},{"verse":17,"text":"そこでヤコブは立,たって、子,こらと妻,つまたちをらくだに乗,のせ、","tok":[["そこ"],["で"],["ヤコブ"],["は"],["立って","たって"],["、"],["子","こ"],["ら"],["と"],["妻たち","つまたち"],["を"],["らくだ"],["に"],["乗せ","のせ"],["、"]]},{"verse":18,"text":"またすべての家畜,かちく、すなわち彼,かれがパダンアラムで獲,えた家畜,かちくと、すべての財産,ざいさんを携,たずさえて、カナンの地,ちにおる父,ちちイサクのもとへ赴,おもむいた。","tok":[["また"],["すべて"],["の"],["家畜","かちく"],["、"],["すなわち"],["彼","かれ"],["が"],["パダン"],["アラム"],["で"],["獲た","えた"],["家畜","かちく"],["と"],["、"],["すべて"],["の"],["財産","ざいさん"],["を"],["携えて","たずさえて"],["、"],["カナン"],["の"],["地","ち"],["に"],["おる"],["父","ちち"],["イサク"],["の"],["もと"],["へ"],["赴いた","おもむいた"],["。"]]},{"verse":19,"text":"その時,ときラバンは羊,ひつじの毛,けを切,きるために出,でていたので、ラケルは父,ちちの所有,しょゆうのテラピムを盗,ぬすみ出,だした。","tok":[["その"],["時","とき"],["ラバン"],["は"],["羊","ひつじ"],["の"],["毛","け"],["を"],["切る","きる"],["ため"],["に"],["出て","でて"],["いた"],["ので"],["、"],["ラケル"],["は"],["父","ちち"],["の"],["所有","しょゆう"],["の"],["テラピム"],["を"],["盗み出した","ぬすみだした"],["。"]]},{"verse":20,"text":"またヤコブはアラムびとラバンを欺,あざむき、自分,じぶんの逃,にげ去,さるのを彼,かれに告,つげなかった。","tok":[["また"],["ヤコブ"],["は"],["アラム"],["びと"],["ラバン"],["を"],["欺き","あざむき"],["、"],["自分","じぶん"],["の"],["逃","にげ"],["去る","さる"],["の"],["を"],["彼","かれ"],["に"],["告","つげ"],["なかった"],["。"]]},{"verse":21,"text":"こうして彼,かれはすべての持,もち物,ものを携,たずさえて逃,にげ、立,たって川,かわを渡,わたり、ギレアデの山地,さんちへ向,むかった。","tok":[["こう"],["して"],["彼","かれ"],["は"],["すべて"],["の"],["持物","もちもの"],["を"],["携えて","たずさえて"],["逃","にげ"],["、"],["立って","たって"],["川","かわ"],["を"],["渡り","わたり"],["、"],["ギレアデ"],["の"],["山地","さんち"],["へ"],["向かった","むかった"],["。"]]},{"verse":22,"text":"三日,か目,めになって、ヤコブの逃,にげ去,さったことが、ラバンに聞,きこえたので、","tok":[["三日目","かめ"],["に"],["なって"],["、"],["ヤコブ"],["の"],["逃去","にげさっ"],["た"],["こと"],["が"],["、"],["ラバン"],["に"],["聞こえた","きこえた"],["ので"],["、"]]},{"verse":23,"text":"彼,かれは一族,いちぞくを率,ひきいて、七日,なぬかの間,あいだそのあとを追,おい、ギレアデの山地,さんちで追,おいついた。","tok":[["彼","かれ"],["は"],["一族","いちぞく"],["を"],["率いて","ひきいて"],["、"],["七日","なぬか"],["の"],["間","あいだ"],["その"],["あと"],["を"],["追い","おい"],["、"],["ギレアデ"],["の"],["山地","さんち"],["で"],["追いついた","おいついた"],["。"]]},{"verse":24,"text":"しかし、神,かみは夜,よの夢,ゆめにアラムびとラバンに現,あらわれて言,いわれた、「あなたは心,こころしてヤコブに、よしあしを言,いってはなりません」。","tok":[["しかし"],["、"],["神","かみ"],["は"],["夜","よ"],["の"],["夢","ゆめ"],["に"],["アラム"],["びと"],["ラバン"],["に"],["現われて","あらわれて"],["言われた","いわれた"],["、"],["「"],["あなた"],["は"],["心","こころ"],["して"],["ヤコブ"],["に"],["、"],["よしあし"],["を"],["言って","いって"],["は"],["なりません"],["」"],["。"]]},{"verse":25,"text":"ラバンはついにヤコブに追,おいついたが、ヤコブが山,やまに天幕,てんまくを張,はっていたので、ラバンも一族,いちぞくと共,ともにギレアデの山,やまに天幕,てんまくを張,はった。","tok":[["ラバン"],["は"],["ついに"],["ヤコブ"],["に"],["追いついた","おいついた"],["が"],["、"],["ヤコブ"],["が"],["山","やま"],["に"],["天幕","てんまく"],["を"],["張って","はって"],["いた"],["ので"],["、"],["ラバン"],["も"],["一族","いちぞく"],["と"],["共","とも"],["に"],["ギレアデ"],["の"],["山","やま"],["に"],["天幕","てんまく"],["を"],["張った","はった"],["。"]]},{"verse":26,"text":"ラバンはヤコブに言,いった、「あなたはなんという事,ことをしたのですか。あなたはわたしを欺,あざむいてわたしの娘,むすめたちをいくさのとりこのように引,ひいて行,いきました。","tok":[["ラバン"],["は"],["ヤコブ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["は"],["なん"],["と"],["いう"],["事","こと"],["を"],["した"],["の"],["です"],["か"],["。"],["あなた"],["は"],["わたし"],["を"],["欺いて","あざむいて"],["わたし"],["の"],["娘","むすめ"],["たち"],["を"],["いくさ"],["の"],["とりこ"],["の"],["よう"],["に"],["引いて","ひいて"],["行きました","いきました"],["。"]]},{"verse":27,"text":"なぜあなたはわたしに告,つげずに、ひそかに逃,にげ去,さってわたしを欺,あざむいたのですか。わたしは手,て鼓,つづみや琴,ことで喜,よろこび歌,うたってあなたを送,おくりだそうとしていたのに。","tok":[["なぜ"],["あなた"],["は"],["わたし"],["に"],["告","つげ"],["ず"],["に"],["、"],["ひそか"],["に"],["逃去","にげさっ"],["て"],["わたし"],["を"],["欺いた","あざむいた"],["の"],["です"],["か"],["。"],["わたし"],["は"],["手","て"],["鼓","つづみ"],["や"],["琴","こと"],["で"],["喜こび","よろこび"],["歌って","うたって"],["あなた"],["を"],["送りだそう","おくりだそう"],["として"],["いた"],["のに"],["。"]]},{"verse":28,"text":"なぜわたしの孫,まごや娘,むすめにわたしが口,くちづけするのを許,ゆるさなかったのですか。あなたは愚,おろかな事,ことをしました。","tok":[["なぜ"],["わたし"],["の"],["孫","まご"],["や"],["娘","むすめ"],["に"],["わたし"],["が"],["口づけ","くちづけ"],["する"],["の"],["を"],["許さなかった","ゆるさなかった"],["の"],["です"],["か"],["。"],["あなた"],["は"],["愚か","おろか"],["な"],["事","こと"],["を"],["しました"],["。"]]},{"verse":29,"text":"わたしはあなたがたに害,がいを加,くわえる力,ちからをもっているが、あなたがたの父,ちちの神,かみが昨夜,さくやわたしに告,つげて、『おまえは心,こころして、ヤコブによしあしを言,いうな』と言,いわれました。","tok":[["わたし"],["は"],["あなた"],["がた"],["に"],["害","がい"],["を"],["加える","くわえる"],["力","ちから"],["を"],["もって"],["いる"],["が"],["、"],["あなた"],["がた"],["の"],["父","ちち"],["の"],["神","かみ"],["が"],["昨夜","さくや"],["わたし"],["に"],["告","つげ"],["て"],["、"],["『"],["おまえ"],["は"],["心","こころ"],["して"],["、"],["ヤコブ"],["に"],["よしあし"],["を"],["言う","いう"],["な"],["』"],["と"],["言われました","いわれました"],["。"]]},{"verse":30,"text":"今,いまあなたが逃,にげ出,だしたのは父,ちちの家,いえが非常,ひじょうに恋,こいしくなったからでしょうが、なぜあなたはわたしの神,かみを盗,ぬすんだのですか」。","tok":[["今","いま"],["あなた"],["が"],["逃出した","にげだした"],["の"],["は"],["父","ちち"],["の"],["家","いえ"],["が"],["非常","ひじょう"],["に"],["恋しく","こいしく"],["なった"],["から"],["でしょう"],["が"],["、"],["なぜ"],["あなた"],["は"],["わたし"],["の"],["神","かみ"],["を"],["盗","ぬすんだ"],["の"],["です"],["か"],["」"],["。"]]},{"verse":31,"text":"ヤコブはラバンに答,こたえた、「たぶんあなたが娘,むすめたちをわたしから奪,うばいとるだろうと思,おもってわたしは恐,おそれたからです。","tok":[["ヤコブ"],["は"],["ラバン"],["に"],["答","こたえ"],["た"],["、"],["「"],["たぶん"],["あなた"],["が"],["娘","むすめ"],["たち"],["を"],["わたし"],["から"],["奪いとるだろう","うばいとるだろう"],["と"],["思って","おもって"],["わたし"],["は"],["恐れた","おそれた"],["から"],["です"],["。"]]},{"verse":32,"text":"だれの所,ところにでもあなたの神,かみが見,みつかったら、その者,ものを生,いかしてはおきません。何,なにかあなたの物,ものがわたしのところにあるか、われわれの一族,いちぞくの前,まえで、調,しらべてみて、それをお取,とりください」。ラケルが神,かみを盗,ぬすんだことをヤコブは知,しらなかったからである。","tok":[["だれ"],["の"],["所","ところ"],["に"],["で"],["も"],["あなた"],["の"],["神","かみ"],["が"],["見つかったら","みつかったら"],["、"],["その"],["者","もの"],["を"],["生かして","いかして"],["は"],["おきません"],["。"],["何に","なに"],["か"],["あなた"],["の"],["物","もの"],["が"],["わたし"],["の"],["ところ"],["に"],["ある"],["か"],["、"],["われわれ"],["の"],["一族","いちぞく"],["の"],["前","まえ"],["で"],["、"],["調べて","しらべて"],["みて"],["、"],["それ"],["を"],["お取","おとり"],["ください"],["」"],["。"],["ラケル"],["が"],["神","かみ"],["を"],["盗んだ","ぬすんだ"],["こと"],["を"],["ヤコブ"],["は"],["知らなかった","しらなかった"],["から"],["で"],["ある"],["。"]]},{"verse":33,"text":"そこでラバンはヤコブの天幕,てんまくにはいり、またレアの天幕,てんまくにはいり、更,さらにふたりのはしための天幕,てんまくにはいってみたが、見,みつからなかったので、レアの天幕,てんまくを出,でてラケルの天幕,てんまくにはいった。","tok":[["そこ"],["で"],["ラバン"],["は"],["ヤコブ"],["の"],["天幕","てんまく"],["に"],["はいり"],["、"],["また"],["レア"],["の"],["天幕","てんまく"],["に"],["はいり"],["、"],["更に","さらに"],["ふたり"],["の"],["はし"],["ため"],["の"],["天幕","てんまく"],["に"],["はいって"],["みた"],["が"],["、"],["見つからなかった","みつからなかった"],["ので"],["、"],["レア"],["の"],["天幕","てんまく"],["を"],["出て","でて"],["ラケル"],["の"],["天幕","てんまく"],["に"],["はいった"],["。"]]},{"verse":34,"text":"しかし、ラケルはすでにテラピムを取,とって、らくだのくらの下,したに入,いれ、その上,うえにすわっていたので、ラバンは、くまなく天幕,てんまくの中,なかを捜,さがしたが、見,みつからなかった。","tok":[["しかし"],["、"],["ラケル"],["は"],["すでに"],["テラピム"],["を"],["取って","とって"],["、"],["らくだ"],["の"],["くら"],["の"],["下","した"],["に"],["入れ","いれ"],["、"],["その"],["上","うえ"],["に"],["すわって"],["いた"],["ので"],["、"],["ラバン"],["は"],["、"],["くまなく"],["天幕","てんまく"],["の"],["中","なか"],["を"],["捜した","さがした"],["が"],["、"],["見つからなかった","みつからなかった"],["。"]]},{"verse":35,"text":"その時,ときラケルは父,ちちに言,いった、「わたしは女,おんなの常,つねのことがあって、あなたの前,まえに立,たち上,あがることができません。わが主,しゅよ、どうかお怒,いかりにならぬよう」。彼,かれは捜,さがしたがテラピムは見,みつからなかった。","tok":[["その"],["時","とき"],["ラケル"],["は"],["父","ちち"],["に"],["言った","いった"],["、"],["「"],["わたし"],["は"],["女","おんな"],["の"],["常","つね"],["の"],["こと"],["が"],["あって"],["、"],["あなた"],["の"],["前","まえ"],["に"],["立ち上がる","たちあがる"],["こと"],["が"],["できません"],["。"],["わが"],["主","しゅ"],["よ"],["、"],["どう"],["か"],["お怒り","おいかり"],["に"],["ならぬ"],["よう"],["」"],["。"],["彼","かれ"],["は"],["捜した","さがした"],["が"],["テラピム"],["は"],["見つからなかった","みつからなかった"],["。"]]},{"verse":36,"text":"そこでヤコブは怒,いかってラバンを責,せめた。そしてヤコブはラバンに言,いった、「わたしにどんなあやまちがあり、どんな罪,つみがあって、あなたはわたしのあとを激,はげしく追,おったのですか。","tok":[["そこ"],["で"],["ヤコブ"],["は"],["怒","い"],["か"],["って"],["ラバン"],["を"],["責","せめ"],["た"],["。"],["そして"],["ヤコブ"],["は"],["ラバン"],["に"],["言った","いった"],["、"],["「"],["わたし"],["に"],["どんな"],["あやまち"],["が"],["あり"],["、"],["どんな"],["罪","つみ"],["が"],["あって"],["、"],["あなた"],["は"],["わたし"],["の"],["あと"],["を"],["激しく","はげしく"],["追った","おった"],["の"],["です"],["か"],["。"]]},{"verse":37,"text":"あなたはわたしの物,ものをことごとく探,さぐられたが、何,なにかあなたの家,いえの物,ものが見,みつかりましたか。それを、ここに、わたしの一族,いちぞくと、あなたの一族,いちぞくの前,まえに置,おいて、われわれふたりの間,あいだをさばかせましょう。","tok":[["あなた"],["は"],["わたし"],["の"],["物","もの"],["を"],["ことごとく"],["探ぐられた","さぐられた"],["が"],["、"],["何に","なに"],["か"],["あなた"],["の"],["家","いえ"],["の"],["物","もの"],["が"],["見つかりました","みつかりました"],["か"],["。"],["それ"],["を"],["、"],["ここ"],["に"],["、"],["わたし"],["の"],["一族","いちぞく"],["と"],["、"],["あなた"],["の"],["一族","いちぞく"],["の"],["前","まえ"],["に"],["置いて","おいて"],["、"],["われわれ"],["ふたり"],["の"],["間","あいだ"],["を"],["さばかせましょう"],["。"]]},{"verse":38,"text":"わたしはこの二十年,ねん、あなたと一緒,いっしょにいましたが、その間,かんあなたの雌,め羊,ひつじも雌,めやぎも子,こを産,うみそこねたことはなく、またわたしはあなたの群,むれの雄羊,おひつじを食,たべたこともありませんでした。","tok":[["わたし"],["は"],["この"],["二十","にじゅう"],["年","ねん"],["、"],["あなた"],["と"],["一緒","いっしょ"],["に"],["いました"],["が"],["、"],["その"],["間","かんあなた"],["の"],["雌羊","めひつじ"],["も"],["雌","めやぎ"],["も"],["子","こ"],["を"],["産み","うみ"],["そこねた"],["こと"],["は"],["なく"],["、"],["また"],["わたし"],["は"],["あなた"],["の"],["群れ","むれ"],["の"],["雄羊","おひつじ"],["を"],["食べた","たべた"],["こと"],["も"],["ありませんでした"],["。"]]},{"verse":39,"text":"また野獣,やじゅうが、かみ裂,さいたものは、あなたのもとに持,もってこないで、自分,じぶんでそれを償,つぐないました。また昼,ひる盗,ぬすまれたものも、夜,よる盗,ぬすまれたものも、あなたはわたしにその償,つぐないを求,もとめられました。","tok":[["また"],["野獣","やじゅう"],["が"],["、"],["かみ"],["裂いた","さいた"],["もの"],["は"],["、"],["あなた"],["の"],["もと"],["に"],["持って","もって"],["こないで"],["、"],["自分","じぶん"],["で"],["それ"],["を"],["償ないました","つぐないました"],["。"],["また"],["昼","ひる"],["盗まれた","ぬすまれた"],["もの"],["も"],["、"],["夜","よる"],["盗まれた","ぬすまれた"],["もの"],["も"],["、"],["あなた"],["は"],["わたし"],["に"],["その"],["償ない","つぐない"],["を"],["求められました","もとめられました"],["。"]]},{"verse":40,"text":"わたしのことを言,いえば、昼,ひるは暑,あつさに、夜,よるは寒,さむさに悩,なやまされて、眠,ねむることもできませんでした。","tok":[["わたし"],["の"],["こと"],["を"],["言えば","いえば"],["、"],["昼","ひる"],["は"],["暑さ","あつさ"],["に"],["、"],["夜","よる"],["は"],["寒さ","さむさ"],["に"],["悩されて","なやまされて"],["、"],["眠る","ねむる"],["こと"],["も"],["できませんでした"],["。"]]},{"verse":41,"text":"わたしはこの二十年,ねんあなたの家族,かぞくのひとりでありました。わたしはあなたのふたりの娘,むすめのために十四年,ねん、またあなたの群,むれのために六年,ねん、あなたに仕,つかえましたが、あなたは十,じゅう度,どもわたしの報酬,ほうしゅうを変,かえられました。","tok":[["わたし"],["は"],["この"],["二十","にじゅう"],["年","ねん"],["の"],["家族","かぞく"],["の"],["ひとり"],["で"],["ありました"],["。"],["わたし"],["は"],["あなた"],["の"],["ふたり"],["の"],["娘","むすめ"],["の"],["ため"],["に"],["十四","じゅうよん"],["年","ねん"],["、"],["また"],["あなた"],["の"],["群れ","むれ"],["の"],["ため"],["に"],["六","ろく"],["年","ねん"],["、"],["あなた"],["に"],["仕えました","つかえました"],["が"],["、"],["あなた"],["は"],["十","じゅう"],["度","ど"],["も"],["わたし"],["の"],["報酬","ほうしゅう"],["を"],["変えられました","かえられました"],["。"]]},{"verse":42,"text":"もし、わたしの父,ちちの神,かみ、アブラハムの神,かみ、イサクのかしこむ者,ものがわたしと共,ともにおられなかったなら、あなたはきっとわたしを、から手,てで去,さらせたでしょう。神,かみはわたしの悩,なやみと、わたしの労苦,ろうくとを顧,かえりみられて昨夜,さくやあなたを戒,いましめられたのです」。","tok":[["もし"],["、"],["わたし"],["の"],["父","ちち"],["の"],["神","かみ"],["、"],["アブラハム"],["の"],["神","かみ"],["、"],["イサク"],["の"],["かしこむ"],["者","もの"],["が"],["わたし"],["と"],["共","とも"],["に"],["おられなかったなら"],["、"],["あなた"],["は"],["きっと"],["わたし"],["を"],["、"],["から"],["手","て"],["で"],["去らせたでしょう","さらせたでしょう"],["。"],["神","かみ"],["は"],["わたし"],["の"],["悩み","なやみ"],["と"],["、"],["わたし"],["の"],["労苦","ろうく"],["と"],["を"],["顧られて","かえりみられて"],["昨夜","さくや"],["あなた"],["を"],["戒しめ","いましめ"],["られた"],["の"],["です"],["」"],["。"]]},{"verse":43,"text":"ラバンは答,こたえてヤコブに言,いった、「娘,むすめたちはわたしの娘,むすめ、子,こどもたちはわたしの孫,まごです。また群,むれはわたしの群,むれ、あなたの見,みるものはみなわたしのものです。これらのわたしの娘,むすめたちのため、また彼,かれらが産,うんだ子,こどもたちのため、きょうわたしは何,なにをすることができましょうか。","tok":[["ラバン"],["は"],["答","こたえ"],["て"],["ヤコブ"],["に"],["言った","いった"],["、"],["「"],["娘","むすめ"],["たち"],["は"],["わたし"],["の"],["娘","むすめ"],["、"],["子ども","こども"],["たち"],["は"],["わたし"],["の"],["孫","まご"],["です"],["。"],["また"],["群れ","むれ"],["は"],["わたし"],["の"],["群れ","むれ"],["、"],["あなた"],["の"],["見る","みる"],["もの"],["は"],["みな"],["わたし"],["の"],["もの"],["です"],["。"],["これ"],["ら"],["の"],["わたし"],["の"],["娘","むすめ"],["たち"],["の"],["ため"],["、"],["また"],["彼","かれ"],["ら"],["が"],["産んだ","うんだ"],["子ども","こども"],["たち"],["の"],["ため"],["、"],["きょう"],["わたし"],["は"],["何に","なに"],["を"],["する"],["こと"],["が"],["できましょう"],["か"],["。"]]},{"verse":44,"text":"さあ、それではわたしとあなたと契約,けいやくを結,むすんで、これをわたしとあなたとの間,あいだの証拠,しょうことしましょう」。","tok":[["さあ"],["、"],["それ"],["で"],["は"],["わたし"],["と"],["あなた"],["と"],["契約","けいやく"],["を"],["結んで","むすんで"],["、"],["これ"],["を"],["わたし"],["と"],["あなた"],["と"],["の"],["間","あいだ"],["の"],["証拠","しょうこ"],["と"],["しましょう"],["」"],["。"]]},{"verse":45,"text":"そこでヤコブは石,いしを取,とり、それを立,たてて柱,はしらとした。","tok":[["そこ"],["で"],["ヤコブ"],["は"],["石","いし"],["を"],["取","とり"],["、"],["それ"],["を"],["立てて","たてて"],["柱","はしら"],["と"],["した"],["。"]]},{"verse":46,"text":"ヤコブはまた一族,いちぞくの者,ものに言,いった、「石,いしを集,あつめてください」。彼,かれらは石,いしを取,とって、一つの石塚,いしづかを造,つくった。こうして彼,かれらはその石塚,いしづかのかたわらで食事,しょくじをした。","tok":[["ヤコブ"],["は"],["また"],["一族","いちぞく"],["の"],["者","もの"],["に"],["言った","いった"],["、"],["「"],["石","いし"],["を"],["集めて","あつめて"],["ください"],["」"],["。"],["彼","かれ"],["ら"],["は"],["石","いし"],["を"],["取って","とって"],["、"],["一","ひと"],["つ"],["の"],["石塚","いしづか"],["を"],["造った","つくった"],["。"],["こう"],["して"],["彼","かれ"],["ら"],["は"],["その"],["石塚","いしづか"],["の"],["かたわら"],["で"],["食事","しょくじ"],["を"],["した"],["。"]]},{"verse":47,"text":"ラバンはこれをエガル・サハドタと名,なづけ、ヤコブはこれをガルエドと名,なづけた。","tok":[["ラバン"],["は"],["これ"],["を"],["エガル"],["・"],["サハドタ"],["と"],["名づけ","なづけ"],["、"],["ヤコブ"],["は"],["これ"],["を"],["ガルエド"],["と"],["名づけた","なづけた"],["。"]]},{"verse":48,"text":"そしてラバンは言,いった、「この石塚,いしづかはきょうわたしとあなたとの間,あいだの証拠,しょうことなります」。それでその名,なはガルエドと呼,よばれた。","tok":[["そして"],["ラバン"],["は"],["言った","いった"],["、"],["「"],["この"],["石塚","いしづか"],["は"],["きょう"],["わたし"],["と"],["あなた"],["と"],["の"],["間","あいだ"],["の"],["証拠","しょうこ"],["と"],["なります"],["」"],["。"],["それ"],["で"],["その"],["名","な"],["は"],["ガルエド"],["と"],["呼ばれた","よばれた"],["。"]]},{"verse":49,"text":"またミズパとも呼,よばれた。彼,かれがこう言,いったからである、「われわれが互,たがいに別,わかれたのちも、どうか主,しゅがわたしとあなたとの間,あいだを見守,みまもられるように。","tok":[["また"],["ミズパ"],["と"],["も"],["呼ばれた","よばれた"],["。"],["彼","かれ"],["が"],["こう"],["言った","いった"],["から"],["で"],["ある"],["、"],["「"],["われわれ"],["が"],["互","たがい"],["に"],["別かれた","わかれた"],["のち"],["も"],["、"],["どう"],["か"],["主","しゅ"],["が"],["わたし"],["と"],["あなた"],["と"],["の"],["間","あいだ"],["を"],["見守られる","みまもられる"],["よう"],["に"],["。"]]},{"verse":50,"text":"もしあなたがわたしの娘,むすめを虐待,ぎゃくたいしたり、わたしの娘,むすめのほかに妻,つまをめとることがあれば、たといそこにだれひとりいなくても、神,かみはわたしとあなたとの間,あいだの証人,しょうにんでいらせられる」。","tok":[["もし"],["あなた"],["が"],["わたし"],["の"],["娘","むすめ"],["を"],["虐待","ぎゃくたい"],["し"],["たり"],["、"],["わたし"],["の"],["娘","むすめ"],["の"],["ほか"],["に"],["妻","つま"],["を"],["めとる"],["こと"],["が"],["あれば"],["、"],["たとい"],["そこ"],["に"],["だれ"],["ひとり"],["いなくて"],["も"],["、"],["神","かみ"],["は"],["わたし"],["と"],["あなた"],["と"],["の"],["間","あいだ"],["の"],["証人","しょうにん"],["で"],["いらせられる"],["」"],["。"]]},{"verse":51,"text":"更,さらにラバンはヤコブに言,いった、「あなたとわたしとの間,あいだにわたしが建,たてたこの石塚,いしづかをごらんなさい、この柱,はしらをごらんなさい。","tok":[["更に","さらに"],["ラバン"],["は"],["ヤコブ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["と"],["わたし"],["と"],["の"],["間","あいだ"],["に"],["わたし"],["が"],["建てた","たてた"],["この"],["石塚","いしづか"],["を"],["ごらん"],["なさい"],["、"],["この"],["柱","はしら"],["を"],["ごらん"],["なさい"],["。"]]},{"verse":52,"text":"この石塚,いしづかを越,こえてわたしがあなたに害,がいを加,くわえず、またこの石塚,いしづかとこの柱,はしらを越,こえてあなたがわたしに害,がいを加,くわえないように、どうかこの石塚,いしづかがあかしとなり、この柱,はしらがあかしとなるように。","tok":[["この"],["石塚","いしづか"],["を"],["越えて","こえて"],["わたし"],["が"],["あなた"],["に"],["害","がい"],["を"],["加えず","くわえず"],["、"],["また"],["この"],["石塚","いしづか"],["と"],["この"],["柱","はしら"],["を"],["越えて","こえて"],["あなた"],["が"],["わたし"],["に"],["害","がい"],["を"],["加えない","くわえない"],["よう"],["に"],["、"],["どう"],["か"],["この"],["石塚","いしづか"],["が"],["あかし"],["と"],["なり"],["、"],["この"],["柱","はしら"],["が"],["あかし"],["と"],["なる"],["よう"],["に"],["。"]]},{"verse":53,"text":"どうかアブラハムの神,かみ、ナホルの神,かみ、彼,かれらの父,ちちの神,かみがわれわれの間,あいだをさばかれるように」。ヤコブは父,ちちイサクのかしこむ者,ものによって誓,ちかった。","tok":[["どう"],["か"],["アブラハム"],["の"],["神","かみ"],["、"],["ナホル"],["の"],["神","かみ"],["、"],["彼","かれ"],["ら"],["の"],["父","ちち"],["の"],["神","かみ"],["が"],["われわれ"],["の"],["間","あいだ"],["を"],["さばかれる"],["よう"],["に"],["」"],["。"],["ヤコブ"],["は"],["父","ちち"],["イサク"],["の"],["かしこむ"],["者","もの"],["によって"],["誓った","ちかった"],["。"]]},{"verse":54,"text":"そしてヤコブは山,やまで犠牲,ぎせいをささげ、一族,いちぞくを招,まねいて、食事,しょくじをした。彼,かれらは食事,しょくじをして山,やまに宿,やどった。","tok":[["そして"],["ヤコブ"],["は"],["山","やま"],["で"],["犠牲","ぎせい"],["を"],["ささげ"],["、"],["一族","いちぞく"],["を"],["招いて","まねいて"],["、"],["食事","しょくじ"],["を"],["した"],["。"],["彼","かれ"],["ら"],["は"],["食事","しょくじ"],["を"],["して"],["山","やま"],["に"],["宿った","やどった"],["。"]]}]
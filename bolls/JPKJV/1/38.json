[{"verse":1,"text":"そのころユダは兄弟,きょうだいたちを離,はなれて下,くだり、アドラムびとで、名,なをヒラという者,ものの所,ところへ行,いった。","tok":[["その"],["ころ"],["ユダ"],["は"],["兄弟","きょうだい"],["たち"],["を"],["離れて","はなれて"],["下り","くだり"],["、"],["アドラム"],["びと"],["で"],["、"],["名","な"],["を"],["ヒラ"],["と"],["いう"],["者","もの"],["の"],["所","ところ"],["へ"],["行った","いった"],["。"]]},{"verse":2,"text":"ユダはその所,ところで、名,なをシュアというカナンびとの娘,むすめを見,みて、これをめとり、その所,ところにはいった。","tok":[["ユダ"],["は"],["その"],["所","ところ"],["で"],["、"],["名","な"],["を"],["シュア"],["と"],["いう"],["カナン"],["びと"],["の"],["娘","むすめ"],["を"],["見て","みて"],["、"],["これ"],["を"],["めとり"],["、"],["その"],["所","ところ"],["に"],["はいった"],["。"]]},{"verse":3,"text":"彼女,かのじょはみごもって男,おとこの子,こを産,うんだので、ユダは名,なをエルと名,なづけた。","tok":[["彼女","かのじょ"],["は"],["みごもって"],["男の子","おとこのこ"],["を"],["産","うんだ"],["ので"],["、"],["ユダ"],["は"],["名","な"],["を"],["エル"],["と"],["名づけた","なづけた"],["。"]]},{"verse":4,"text":"彼女,かのじょは再,ふたたびみごもって男,おとこの子,こを産,うみ、名,なをオナンと名,なづけた。","tok":[["彼女","かのじょ"],["は"],["再び","ふたたび"],["みごもって"],["男の子","おとこのこ"],["を"],["産み","うみ"],["、"],["名","な"],["を"],["オナン"],["と"],["名づけた","なづけた"],["。"]]},{"verse":5,"text":"また重,かさねて、男,おとこの子,こを産,うみ、名,なをシラと名,なづけた。彼女,かのじょはこの男,おとこの子,こを産,うんだとき、クジブにおった。","tok":[["また"],["重ねて","かさねて"],["、"],["男の子","おとこのこ"],["を"],["産み","うみ"],["、"],["名","な"],["を"],["シラ"],["と"],["名づけた","なづけた"],["。"],["彼女","かのじょ"],["は"],["この"],["男の子","おとこのこ"],["を"],["産んだ","うんだ"],["とき"],["、"],["クジブ"],["に"],["おった"],["。"]]},{"verse":6,"text":"ユダは長子,ちょうしエルのために、名,なをタマルという妻,つまを迎,むかえた。","tok":[["ユダ"],["は"],["長子","ちょうし"],["エル"],["の"],["ため"],["に"],["、"],["名","な"],["を"],["タマル"],["と"],["いう"],["妻","つま"],["を"],["迎","むかえ"],["た"],["。"]]},{"verse":7,"text":"しかしユダの長子,ちょうしエルは主,しゅの前,まえに悪,わるい者,ものであったので、主,しゅは彼,かれを殺,ころされた。","tok":[["しかし"],["ユダ"],["の"],["長子","ちょうし"],["エル"],["は"],["主","しゅ"],["の"],["前","まえ"],["に"],["悪い","わるい"],["者","もの"],["で"],["あった"],["ので"],["、"],["主","しゅ"],["は"],["彼","かれ"],["を"],["殺ろされた","ころされた"],["。"]]},{"verse":8,"text":"そこでユダはオナンに言,いった、「兄,あにの妻,つまの所,ところにはいって、彼女,かのじょをめとり、兄,あにに子供,こどもを得,えさせなさい」。","tok":[["そこ"],["で"],["ユダ"],["は"],["オナン"],["に"],["言った","いった"],["、"],["「"],["兄","あに"],["の"],["妻","つま"],["の"],["所","ところ"],["に"],["はいって"],["、"],["彼女","かのじょ"],["を"],["めとり"],["、"],["兄","あに"],["に"],["子供","こども"],["を"],["得させ","えさせ"],["なさい"],["」"],["。"]]},{"verse":9,"text":"しかしオナンはその子,こが自分,じぶんのものとならないのを知,しっていたので、兄,あにの妻,つまの所,ところにはいった時,とき、兄,あにに子,こを得,えさせないために地,ちに洩,もらした。","tok":[["しかし"],["オナン"],["は"],["その"],["子","こ"],["が"],["自分","じぶん"],["の"],["もの"],["と"],["ならない"],["の"],["を"],["知って","しって"],["いた"],["ので"],["、"],["兄","あに"],["の"],["妻","つま"],["の"],["所","ところ"],["に"],["はいった"],["時","とき"],["、"],["兄","あに"],["に"],["子","こ"],["を"],["得させない","えさせない"],["ため"],["に"],["地","ち"],["に"],["洩らした","もらした"],["。"]]},{"verse":10,"text":"彼,かれのした事,ことは主,しゅの前,まえに悪,わるかったので、主,しゅは彼,かれをも殺,ころされた。","tok":[["彼","かれ"],["の"],["した"],["事","こと"],["は"],["主","しゅ"],["の"],["前","まえ"],["に"],["悪かった","わるかった"],["ので"],["、"],["主","しゅ"],["は"],["彼","かれ"],["を"],["も"],["殺ろされた","ころされた"],["。"]]},{"verse":11,"text":"そこでユダはその子,この妻,つまタマルに言,いった、「わたしの子,こシラが成人,せいじんするまで、寡婦,かふのままで、あなたの父,ちちの家,いえにいなさい」。彼,かれは、シラもまた兄弟,きょうだいたちのように死,しぬかもしれないと、思,おもったからである。それでタマルは行,いって父,ちちの家,いえにおった。","tok":[["そこ"],["で"],["ユダ"],["は"],["その"],["子","こ"],["の"],["妻","つま"],["タマル"],["に"],["言った","いった"],["、"],["「"],["わたし"],["の"],["子","こ"],["シラ"],["が"],["成人","せいじん"],["する"],["まで"],["、"],["寡婦","かふ"],["の"],["まま"],["で"],["、"],["あなた"],["の"],["父","ちち"],["の"],["家","いえ"],["に"],["い"],["なさい"],["」"],["。"],["彼","かれ"],["は"],["、"],["シラ"],["も"],["また"],["兄弟","きょうだい"],["たち"],["の"],["よう"],["に"],["死ぬ","しぬ"],["か"],["も"],["しれない"],["と"],["、"],["思った","おもった"],["から"],["で"],["ある"],["。"],["それ"],["で"],["タマル"],["は"],["行って","いって"],["父","ちち"],["の"],["家","いえ"],["に"],["おった"],["。"]]},{"verse":12,"text":"日,ひがたってシュアの娘,むすめユダの妻,つまは死,しんだ。その後,のち、ユダは喪,もを終,おわってその友,ともアドラムびとヒラと共,ともにテムナに上,のぼり、自分,じぶんの羊,ひつじの毛,けを切,きる者,もののところへ行,いった。","tok":[["日","ひ"],["が"],["たって"],["シュア"],["の"],["娘","むすめ"],["ユダ"],["の"],["妻","つま"],["は"],["死んだ","しんだ"],["。"],["その後","そのの"],["ち"],["、"],["ユダ"],["は"],["喪","も"],["を"],["終わって","おわって"],["その"],["友","とも"],["アドラム"],["びと"],["ヒラ"],["と"],["共","とも"],["に"],["テムナ"],["に"],["上り","のぼり"],["、"],["自分","じぶん"],["の"],["羊","ひつじ"],["の"],["毛","け"],["を"],["切る","きる"],["者","もの"],["の"],["ところ"],["へ"],["行った","いった"],["。"]]},{"verse":13,"text":"時,ときに、ひとりの人,ひとがタマルに告,つげて、「あなたのしゅうとが羊,ひつじの毛,けを切,きるためにテムナに上,のぼって来,くる」と言,いったので、","tok":[["時","とき"],["に"],["、"],["ひとり"],["の"],["人","ひと"],["が"],["タマル"],["に"],["告","つげ"],["て"],["、"],["「"],["あなた"],["の"],["しゅうと"],["が"],["羊","ひつじ"],["の"],["毛","け"],["を"],["切る","きる"],["ため"],["に"],["テムナ"],["に"],["上って","のぼって"],["来る","くる"],["」"],["と"],["言った","いった"],["ので"],["、"]]},{"verse":14,"text":"彼女,かのじょは寡婦,かふの衣服,いふくを脱,ぬぎすて、被衣,かずきで身,みをおおい隠,かくして、テムナへ行,いく道,みちのかたわらにあるエナイムの入口,いりぐちにすわっていた。彼女,かのじょはシラが成人,せいじんしたのに、自分,じぶんがその妻,つまにされないのを知,しったからである。","tok":[["彼女","かのじょ"],["は"],["寡婦","かふ"],["の"],["衣服","いふく"],["を"],["脱ぎすて","ぬぎすて"],["、"],["被衣","か"],["ずき"],["で"],["身","み"],["を"],["おおい隠して","おおいかくして"],["、"],["テムナ"],["へ"],["行く","いく"],["道","みち"],["の"],["かたわら"],["に"],["ある"],["エナイム"],["の"],["入口","いりぐち"],["に"],["すわって"],["いた"],["。"],["彼女","かのじょ"],["は"],["シラ"],["が"],["成人","せいじん"],["した"],["のに"],["、"],["自分","じぶん"],["が"],["その"],["妻","つま"],["に"],["されない"],["の"],["を"],["知った","しった"],["から"],["で"],["ある"],["。"]]},{"verse":15,"text":"ユダは彼女,かのじょを見,みたとき、彼女,かのじょが顔,かおをおおっていたため、遊女,ゆうじょだと思,おもい、","tok":[["ユダ"],["は"],["彼女","かのじょ"],["を"],["見た","みた"],["とき"],["、"],["彼女","かのじょ"],["が"],["顔","かお"],["を"],["おおって"],["いた"],["ため"],["、"],["遊女","ゆうじょ"],["だ"],["と"],["思い","おもい"],["、"]]},{"verse":16,"text":"道,みちのかたわらで彼女,かのじょに向,むかって言,いった、「さあ、あなたの所,ところにはいらせておくれ」。彼,かれはこの女,おんながわが子,この妻,つまであることを知,しらなかったからである。彼女,かのじょは言,いった、「わたしの所,ところにはいるため、何,なにをくださいますか」。","tok":[["道","みち"],["の"],["かたわら"],["で"],["彼女","かのじょ"],["に"],["向かって","むかって"],["言った","いった"],["、"],["「"],["さあ"],["、"],["あなた"],["の"],["所","ところ"],["に"],["はいらせて"],["おくれ"],["」"],["。"],["彼","かれ"],["は"],["この"],["女","おんな"],["が"],["わが"],["子","こ"],["の"],["妻","つま"],["で"],["ある"],["こと"],["を"],["知らなかった","しらなかった"],["から"],["で"],["ある"],["。"],["彼女","かのじょ"],["は"],["言った","いった"],["、"],["「"],["わたし"],["の"],["所","ところ"],["に"],["は"],["いる"],["ため"],["、"],["何に","なに"],["を"],["くださいます"],["か"],["」"],["。"]]},{"verse":17,"text":"ユダは言,いった、「群,むれのうちのやぎの子,こをあなたにあげよう」。彼女,かのじょは言,いった、「それをくださるまで、しるしをわたしにくださいますか」。","tok":[["ユダ"],["は"],["言った","いった"],["、"],["「"],["群れ","むれ"],["の"],["うち"],["の"],["やぎ"],["の"],["子","こ"],["を"],["あなた"],["に"],["あげよう"],["」"],["。"],["彼女","かのじょ"],["は"],["言った","いった"],["、"],["「"],["それ"],["を"],["くださる"],["まで"],["、"],["しるし"],["を"],["わたし"],["に"],["くださいます"],["か"],["」"],["。"]]},{"verse":18,"text":"ユダは言,いった、「どんなしるしをあげようか」。彼女,かのじょは言,いった、「あなたの印,いんと紐,ひもと、あなたの手,てにあるつえとを」。彼,かれはこれらを与,あたえて彼女,かのじょの所,ところにはいった。彼女,かのじょはユダによってみごもった。","tok":[["ユダ"],["は"],["言った","いった"],["、"],["「"],["どんな"],["しるし"],["を"],["あげよう"],["か"],["」"],["。"],["彼女","かのじょ"],["は"],["言った","いった"],["、"],["「"],["あなた"],["の"],["印","いん"],["と"],["紐","ひも"],["と"],["、"],["あなた"],["の"],["手","て"],["に"],["あるつえ"],["と"],["を"],["」"],["。"],["彼","かれ"],["は"],["これ"],["ら"],["を"],["与","あたえ"],["て"],["彼女","かのじょ"],["の"],["所","ところ"],["に"],["はいった"],["。"],["彼女","かのじょ"],["は"],["ユダ"],["によって"],["みごもった"],["。"]]},{"verse":19,"text":"彼女,かのじょは起,おきて去,さり、被衣,かずきを脱,ぬいで寡婦,かふの衣服,いふくを着,きた。","tok":[["彼女","かのじょ"],["は"],["起きて","おきて"],["去り","さり"],["、"],["被衣","かずき"],["を"],["脱いで","ぬいで"],["寡婦","かふ"],["の"],["衣服","いふく"],["を"],["着た","きた"],["。"]]},{"verse":20,"text":"やがてユダはその女,おんなからしるしを取,とりもどそうと、その友,ともアドラムびとに託,たくしてやぎの子,こを送,おくったけれども、その女,おんなを見,みいだせなかった。","tok":[["やがて"],["ユダ"],["は"],["その"],["女","おんな"],["から"],["しるし"],["を"],["取","とり"],["もどそう"],["と"],["、"],["その"],["友","とも"],["アドラム"],["びと"],["に"],["託して","たくして"],["やぎ"],["の"],["子","こ"],["を"],["送った","おくった"],["けれど"],["も"],["、"],["その"],["女","おんな"],["を"],["見いだせなかった","みいだせなかった"],["。"]]},{"verse":21,"text":"そこで彼,かれはその所,ところの人々,ひとびとに尋,たずねて言,いった、「エナイムで道,みちのかたわらにいた遊女,ゆうじょはどこにいますか」。彼,かれらは言,いった、「ここには遊女,ゆうじょはいません」。","tok":[["そこ"],["で"],["彼","かれ"],["は"],["その"],["所","ところ"],["の"],["人々","ひとびと"],["に"],["尋ねて","たずねて"],["言った","いった"],["、"],["「"],["エナイム"],["で"],["道","みち"],["の"],["かたわら"],["に"],["いた"],["遊女","ゆうじょ"],["は"],["どこ"],["に"],["います"],["か"],["」"],["。"],["彼","かれ"],["ら"],["は"],["言った","いった"],["、"],["「"],["ここ"],["に"],["は"],["遊女","ゆうじょ"],["は"],["いません"],["」"],["。"]]},{"verse":22,"text":"彼,かれはユダのもとに帰,かえって言,いった、「わたしは彼女,かのじょを見,みいだせませんでした。またその所,ところの人々,ひとびとは、『ここには遊女,ゆうじょはいない』と言,いいました」。","tok":[["彼","かれ"],["は"],["ユダ"],["の"],["もと"],["に"],["帰えって","かえって"],["言った","いった"],["、"],["「"],["わたし"],["は"],["彼女","かのじょ"],["を"],["見いだせませんでした","みいだせませんでした"],["。"],["また"],["その"],["所","ところ"],["の"],["人々","ひとびと"],["は"],["、"],["『"],["ここ"],["に"],["は"],["遊女","ゆうじょ"],["は"],["いない"],["』"],["と"],["言いました","いいました"],["」"],["。"]]},{"verse":23,"text":"そこでユダは言,いった、「女,おんなに持,もたせておこう。わたしたちは恥,はじをかくといけないから。とにかく、わたしはこのやぎの子,こを送,おくったが、あなたは彼女,かのじょを見,みいだせなかったのだ」。","tok":[["そこ"],["で"],["ユダ"],["は"],["言った","いった"],["、"],["「"],["女","おんな"],["に"],["持たせて","もたせて"],["おこう"],["。"],["わたしたち"],["は"],["恥","はじ"],["を"],["かく"],["と"],["いけない"],["から"],["。"],["とにかく"],["、"],["わたし"],["は"],["この"],["やぎ"],["の"],["子","こ"],["を"],["送った","おくった"],["が"],["、"],["あなた"],["は"],["彼女","かのじょ"],["を"],["見いだせなかった","みいだせなかった"],["の"],["だ"],["」"],["。"]]},{"verse":24,"text":"ところが三月,がつほどたって、ひとりの人,ひとがユダに言,いった、「あなたの嫁,よめタマルは姦淫,かんいんしました。そのうえ、彼女,かのじょは姦淫,かんいんによってみごもりました」。ユダは言,いった、「彼女,かのじょを引,ひき出,だして焼,やいてしまえ」。","tok":[["ところ"],["が"],["三","さん"],["月","がつ"],["つ"],["ほど"],["たって"],["、"],["ひとり"],["の"],["人","ひと"],["が"],["ユダ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["の"],["嫁","よめ"],["タマル"],["は"],["姦淫","かんいん"],["しました"],["。"],["その"],["うえ"],["、"],["彼女","かのじょ"],["は"],["姦淫","かんいん"],["によって"],["みごもりました"],["」"],["。"],["ユダ"],["は"],["言った","いった"],["、"],["「"],["彼女","かのじょ"],["を"],["引出して","ひきだして"],["焼いて","やいて"],["しまえ"],["」"],["。"]]},{"verse":25,"text":"彼女,かのじょは引,ひき出,だされた時,とき、そのしゅうとに人,ひとをつかわして言,いった、「わたしはこれをもっている人,ひとによって、みごもりました」。彼女,かのじょはまた言,いった、「どうか、この印,いんと、紐,ひもと、つえとはだれのものか、見定,みさだめてください」。","tok":[["彼女","かのじょ"],["は"],["引出された","ひきだされた"],["時","とき"],["、"],["その"],["しゅうと"],["に"],["人","ひと"],["を"],["つかわして"],["言った","いった"],["、"],["「"],["わたし"],["は"],["これ"],["を"],["もって"],["いる"],["人","ひと"],["によって"],["、"],["みごもりました"],["」"],["。"],["彼女","かのじょ"],["は"],["また"],["言った","いった"],["、"],["「"],["どう"],["か"],["、"],["この"],["印","いん"],["と"],["、"],["紐","ひも"],["と"],["、"],["つえ"],["と"],["は"],["だれ"],["の"],["もの"],["か"],["、"],["見定て","みさだめて"],["ください"],["」"],["。"]]},{"verse":26,"text":"ユダはこれを見定,みさだめて言,いった、「彼女,かのじょはわたしよりも正,ただしい。わたしが彼女,かのじょをわが子,こシラに与,あたえなかったためである」。彼,かれは再,ふたたび彼女,かのじょを知,しらなかった。","tok":[["ユダ"],["は"],["これ"],["を"],["見定て","みさだめて"],["言った","いった"],["、"],["「"],["彼女","かのじょ"],["は"],["わたし"],["より"],["も"],["正い","ただしい"],["。"],["わたし"],["が"],["彼女","かのじょ"],["を"],["わが"],["子","こ"],["シラ"],["に"],["与えなかった","あたえなかった"],["ため"],["で"],["ある"],["」"],["。"],["彼","かれ"],["は"],["再び","ふたたび"],["彼女","かのじょ"],["を"],["知らなかった","しらなかった"],["。"]]},{"verse":27,"text":"さて彼女,かのじょの出産,しゅっさんの時,ときがきたが、胎内,たいないには、ふたごがあった。","tok":[["さて"],["彼女","かのじょ"],["の"],["出産","しゅっさん"],["の"],["時","とき"],["が"],["きた"],["が"],["、"],["胎内","たいない"],["に"],["は"],["、"],["ふたご"],["が"],["あった"],["。"]]},{"verse":28,"text":"出産,しゅっさんの時,ときに、ひとりの子,こが手,てを出,だしたので、産婆,さんばは、「これがさきに出,でた」と言,いい、緋,ひの糸,いとを取,とって、その手,てに結,むすんだ。","tok":[["出産","しゅっさん"],["の"],["時","とき"],["に"],["、"],["ひとり"],["の"],["子","こ"],["が"],["手","て"],["を"],["出した","だした"],["ので"],["、"],["産婆","さんば"],["は"],["、"],["「"],["これ"],["が"],["さき"],["に"],["出た","でた"],["」"],["と"],["言い","いい"],["、"],["緋","ひ"],["の"],["糸","いと"],["を"],["取って","とって"],["、"],["その"],["手","て"],["に"],["結んだ","むすんだ"],["。"]]},{"verse":29,"text":"そして、その子,こが手,てをひっこめると、その弟,おとうとが出,でたので、「どうしてあなたは自分,じぶんで破,やぶって出,でるのか」と言,いった。これによって名,なはペレヅと呼,よばれた。","tok":[["そして"],["、"],["その"],["子","こ"],["が"],["手","て"],["を"],["ひっこめる"],["と"],["、"],["その"],["弟","おとうと"],["が"],["出た","でた"],["ので"],["、"],["「"],["どう"],["して"],["あなた"],["は"],["自分","じぶん"],["で"],["破って","やぶって"],["出る","でる"],["の"],["か"],["」"],["と"],["言った","いった"],["。"],["これ"],["によって"],["名","な"],["は"],["ペレヅ"],["と"],["呼ばれた","よばれた"],["。"]]},{"verse":30,"text":"その後,のち、手,てに緋,ひの糸,いとのある兄,あにが出,でたので、名,なはゼラと呼,よばれた。","tok":[["その後","そのの"],["ち"],["、"],["手","て"],["に"],["緋","ひ"],["の"],["糸","いと"],["の"],["ある"],["兄","あに"],["が"],["出た","でた"],["ので"],["、"],["名","な"],["は"],["ゼラ"],["と"],["呼ばれた","よばれた"],["。"]]}]
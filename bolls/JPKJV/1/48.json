[{"verse":1,"text":"これらの事,ことの後,のちに、「あなたの父,ちちは、いま病気,びょうきです」とヨセフに告,つげる者,ものがあったので、彼,かれはふたりの子,こ、マナセとエフライムとを連,つれて行,いった。","tok":[["これ"],["ら"],["の"],["事","こと"],["の"],["後","のち"],["に"],["、"],["「"],["あなた"],["の"],["父","ちち"],["は"],["、"],["いま"],["病気","びょうき"],["です"],["」"],["と"],["ヨセフ"],["に"],["告げる","つげる"],["者","もの"],["が"],["あった"],["ので"],["、"],["彼","かれ"],["は"],["ふたり"],["の"],["子","こ"],["、"],["マナセ"],["と"],["エフライム"],["と"],["を"],["連れて","つれて"],["行った","いった"],["。"]]},{"verse":2,"text":"時,ときに人,ひとがヤコブに告,つげて、「あなたの子,こヨセフがあなたのもとにきました」と言,いったので、イスラエルは努,つとめて床,とこの上,うえにすわった。","tok":[["時","とき"],["に"],["人","ひと"],["が"],["ヤコブ"],["に"],["告","つげ"],["て"],["、"],["「"],["あなた"],["の"],["子","こ"],["ヨセフ"],["が"],["あなた"],["の"],["もと"],["に"],["きました"],["」"],["と"],["言った","いった"],["ので"],["、"],["イスラエル"],["は"],["努めて","つとめて"],["床","とこ"],["の"],["上","うえ"],["に"],["すわった"],["。"]]},{"verse":3,"text":"そしてヤコブはヨセフに言,いった、「先,さきに全能,ぜんのうの神,かみがカナンの地,ちルズでわたしに現,あらわれ、わたしを祝福,しゅくふくして、","tok":[["そして"],["ヤコブ"],["は"],["ヨセフ"],["に"],["言った","いった"],["、"],["「"],["先","さき"],["に"],["全能","ぜんのう"],["の"],["神","かみ"],["が"],["カナン"],["の"],["地","ち"],["ルズ"],["で"],["わたし"],["に"],["現われ","あらわれ"],["、"],["わたし"],["を"],["祝福","しゅくふく"],["して"],["、"]]},{"verse":4,"text":"言,いわれた、『わたしはおまえに多,おおくの子,こを得,えさせ、おまえをふやし、おまえを多,おおくの国民,こくみんとしよう。また、この地,ちをおまえの後,のちの子孫,しそんに与,あたえて永久,えいきゅうの所有,しょゆうとさせる』。","tok":[["言われた","いわれた"],["、"],["『"],["わたし"],["は"],["おまえ"],["に"],["多く","おおく"],["の"],["子","こ"],["を"],["得させ","えさせ"],["、"],["おまえ"],["を"],["ふやし"],["、"],["おまえ"],["を"],["多く","おおく"],["の"],["国民","こくみん"],["と"],["しよう"],["。"],["また"],["、"],["この"],["地","ち"],["を"],["おまえ"],["の"],["後","のち"],["の"],["子孫","しそん"],["に"],["与","あたえ"],["て"],["永久","えいきゅう"],["の"],["所有","しょゆう"],["と"],["させる"],["』"],["。"]]},{"verse":5,"text":"エジプトにいるあなたの所,ところにわたしが来,くる前,まえに、エジプトの国,くにで生,うまれたあなたのふたりの子,こはいまわたしの子,ことします。すなわちエフライムとマナセとはルベンとシメオンと同,おなじようにわたしの子,ことします。","tok":[["エジプト"],["に"],["いる"],["あなた"],["の"],["所","ところ"],["に"],["わたし"],["が"],["来る","くる"],["前","まえ"],["に"],["、"],["エジプト"],["の"],["国","くに"],["で"],["生まれた","うまれた"],["あなた"],["の"],["ふたり"],["の"],["子","こ"],["は"],["いま"],["わたし"],["の"],["子","こ"],["と"],["します"],["。"],["すなわち"],["エフライム"],["と"],["マナセ"],["と"],["は"],["ルベン"],["と"],["シメオン"],["と"],["同じ","おなじ"],["よう"],["に"],["わたし"],["の"],["子","こ"],["と"],["します"],["。"]]},{"verse":6,"text":"ただし彼,かれらの後,のちにあなたに生,うまれた子,こらはあなたのものとなります。しかし、その嗣,し業,ぎょうはその兄弟,きょうだいの名,なで呼,よばれるでしょう。","tok":[["ただし"],["彼","かれ"],["ら"],["の"],["後","のち"],["に"],["あなた"],["に"],["生まれた","うまれた"],["子","こ"],["ら"],["は"],["あなた"],["の"],["もの"],["と"],["なります"],["。"],["しかし"],["、"],["その"],["嗣業","しぎょう"],["は"],["その"],["兄弟","きょうだい"],["の"],["名","な"],["で"],["呼ばれるでしょう","よばれるでしょう"],["。"]]},{"verse":7,"text":"わたしがパダンから帰,かえって来,くる途中,とちゅうラケルはカナンの地,ちで死,しに、わたしは悲,かなしんだ。そこはエフラタに行,いくまでには、なお隔,へだたりがあった。わたしはエフラタ、すなわちベツレヘムへ行,いく道,みちのかたわらに彼女,かのじょを葬,ほうむった」。","tok":[["わたし"],["が"],["パダン"],["から"],["帰えって","かえって"],["来る","くる"],["途中","とちゅう"],["ラケル"],["は"],["カナン"],["の"],["地","ち"],["で"],["死に","しに"],["、"],["わたし"],["は"],["悲しんだ","かなしんだ"],["。"],["そこ"],["は"],["エフラタ"],["に"],["行く","いく"],["まで"],["に"],["は"],["、"],["なお"],["隔たり","へだたり"],["が"],["あった"],["。"],["わたし"],["は"],["エフラタ"],["、"],["すなわち"],["ベツレヘム"],["へ"],["行く","いく"],["道","みち"],["の"],["かたわら"],["に"],["彼女","かのじょ"],["を"],["葬むった","ほうむった"],["」"],["。"]]},{"verse":8,"text":"ところで、イスラエルはヨセフの子,こらを見,みて言,いった、「これはだれですか」。","tok":[["ところ"],["で"],["、"],["イスラエル"],["は"],["ヨセフ"],["の"],["子","こ"],["ら"],["を"],["見て","みて"],["言った","いった"],["、"],["「"],["これ"],["は"],["だれ"],["です"],["か"],["」"],["。"]]},{"verse":9,"text":"ヨセフは父,ちちに言,いった、「神,かみがここでわたしにくださった子,こどもです」。父,ちちは言,いった、「彼,かれらをわたしの所,ところに連,つれてきて、わたしに祝福,しゅくふくさせてください」。","tok":[["ヨセフ"],["は"],["父","ちち"],["に"],["言った","いった"],["、"],["「"],["神","かみ"],["が"],["ここ"],["で"],["わたし"],["に"],["くださった"],["子ども","こども"],["です"],["」"],["。"],["父","ちち"],["は"],["言った","いった"],["、"],["「"],["彼","かれ"],["ら"],["を"],["わたし"],["の"],["所","ところ"],["に"],["連れて","つれて"],["きて"],["、"],["わたし"],["に"],["祝福","しゅくふく"],["させて"],["ください"],["」"],["。"]]},{"verse":10,"text":"イスラエルの目,めは老齢,ろうれいのゆえに、かすんで見,みえなかったが、ヨセフが彼,かれらを父,ちちの所,ところに近寄,ちかよらせたので、父,ちちは彼,かれらに口,くちづけし、彼,かれらを抱,だいた。","tok":[["イスラエル"],["の"],["目","め"],["は"],["老齢","ろうれい"],["の"],["ゆえ"],["に"],["、"],["かすんで"],["見えなかった","みえなかった"],["が"],["、"],["ヨセフ"],["が"],["彼","かれ"],["ら"],["を"],["父","ちち"],["の"],["所","ところ"],["に"],["近寄らせた","ちかよらせた"],["ので"],["、"],["父","ちち"],["は"],["彼","かれ"],["ら"],["に"],["口づけ","くちづけ"],["し"],["、"],["彼","かれ"],["ら"],["を"],["抱いた","だいた"],["。"]]},{"verse":11,"text":"そしてイスラエルはヨセフに言,いった、「あなたの顔,かおが見,みられようとは思,おもわなかったのに、神,かみはあなたの子,こらをもわたしに見,みさせてくださった」。","tok":[["そして"],["イスラエル"],["は"],["ヨセフ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["の"],["顔","かお"],["が"],["見られよう","みられよう"],["と"],["は"],["思わなかった","おもわなかった"],["のに"],["、"],["神","かみ"],["は"],["あなた"],["の"],["子","こ"],["ら"],["を"],["も"],["わたし"],["に"],["見させて","みさせて"],["くださった"],["」"],["。"]]},{"verse":12,"text":"そこでヨセフは彼,かれらをヤコブのひざの間,あいだから取,とり出,だし、地,ちに伏,ふして拝,はいした。","tok":[["そこ"],["で"],["ヨセフ"],["は"],["彼","かれ"],["ら"],["を"],["ヤコブ"],["の"],["ひざ"],["の"],["間","あいだ"],["から"],["取出し","とりだし"],["、"],["地","ち"],["に"],["伏して","ふして"],["拝した","はいした"],["。"]]},{"verse":13,"text":"ヨセフはエフライムを右,みぎの手,てに取,とってイスラエルの左,ひだりの手,てに向,むかわせ、マナセを左,ひだりの手,てに取,とってイスラエルの右,みぎの手,てに向,むかわせ、ふたりを近寄,ちかよらせた。","tok":[["ヨセフ"],["は"],["エフライム"],["を"],["右","みぎ"],["の"],["手","て"],["に"],["取って","とって"],["イスラエル"],["の"],["左","ひだり"],["の"],["手","て"],["に"],["向かわせ","むかわせ"],["、"],["マナセ"],["を"],["左","ひだり"],["の"],["手","て"],["に"],["取って","とって"],["イスラエル"],["の"],["右","みぎ"],["の"],["手","て"],["に"],["向かわせ","むかわせ"],["、"],["ふたり"],["を"],["近寄らせた","ちかよらせた"],["。"]]},{"verse":14,"text":"すると、イスラエルは右,みぎの手,てを伸,のべて弟,おとうとエフライムの頭,あたまに置,おき、左,ひだりの手,てをマナセの頭,あたまに置,おいた。マナセは長子,ちょうしであるが、ことさらそのように手,てを置,おいたのである。","tok":[["する"],["と"],["、"],["イスラエル"],["は"],["右","みぎ"],["の"],["手","て"],["を"],["伸べて","のべて"],["弟","おとうと"],["エフライム"],["の"],["頭","あたま"],["に"],["置き","おき"],["、"],["左","ひだり"],["の"],["手","て"],["を"],["マナセ"],["の"],["頭","あたま"],["に"],["置いた","おいた"],["。"],["マナセ"],["は"],["長子","ちょうし"],["で"],["ある"],["が"],["、"],["ことさら"],["その"],["よう"],["に"],["手","て"],["を"],["置いた","おいた"],["ので"],["ある"],["。"]]},{"verse":15,"text":"そしてヨセフを祝福,しゅくふくして言,いった、「わが先祖,せんぞアブラハムとイサクの仕,つかえた神,かみ、生,うまれてからきょうまでわたしを養,やしなわれた神,かみ、","tok":[["そして"],["ヨセフ"],["を"],["祝福","しゅくふく"],["して"],["言った","いった"],["、"],["「"],["わが"],["先祖","せんぞ"],["アブラハム"],["と"],["イサク"],["の"],["仕えた","つかえた"],["神","かみ"],["、"],["生まれて","うまれて"],["から"],["きょう"],["まで"],["わたし"],["を"],["養われた","やしなわれた"],["神","かみ"],["、"]]},{"verse":16,"text":"すべての災,わざわいからわたしをあがなわれたみ使,つかいよ、この子供,こどもたちを祝福,しゅくふくしてください。またわが名,なと先祖,せんぞアブラハムとイサクの名,なとが、彼,かれらによって唱,となえられますように、また彼,かれらが地,ちの上,うえにふえひろがりますように」。","tok":[["すべて"],["の"],["災","わざわい"],["から"],["わたし"],["を"],["あがなわれた"],["み使","みつかい"],["よ"],["、"],["この"],["子供","こども"],["たち"],["を"],["祝福","しゅくふく"],["して"],["ください"],["。"],["また"],["わが"],["名","な"],["と"],["先祖","せんぞ"],["アブラハム"],["と"],["イサク"],["の"],["名","な"],["と"],["が"],["、"],["彼","かれ"],["ら"],["によって"],["唱えられます","となえられます"],["よう"],["に"],["、"],["また"],["彼","かれ"],["ら"],["が"],["地","ち"],["の"],["上","うえ"],["に"],["ふえ"],["ひろがります"],["よう"],["に"],["」"],["。"]]},{"verse":17,"text":"ヨセフは父,ちちが右,みぎの手,てをエフライムの頭,あたまに置,おいているのを見,みて不満,ふまんに思,おもい、父,ちちの手,てを取,とってエフライムの頭,あたまからマナセの頭,あたまへ移,うつそうとした。","tok":[["ヨセフ"],["は"],["父","ちち"],["が"],["右","みぎ"],["の"],["手","て"],["を"],["エフライム"],["の"],["頭","あたま"],["に"],["置いて","おいて"],["いる"],["の"],["を"],["見て","みて"],["不満","ふまん"],["に"],["思い","おもい"],["、"],["父","ちち"],["の"],["手","て"],["を"],["取って","とって"],["エフライム"],["の"],["頭","あたま"],["から"],["マナセ"],["の"],["頭","あたま"],["へ"],["移そう","うつそう"],["と"],["した"],["。"]]},{"verse":18,"text":"そしてヨセフは父,ちちに言,いった、「父,ちちよ、そうではありません。こちらが長子,ちょうしです。その頭,あたまに右,みぎの手,てを置,おいてください」。","tok":[["そして"],["ヨセフ"],["は"],["父","ちち"],["に"],["言った","いった"],["、"],["「"],["父","ちち"],["よ"],["、"],["そう"],["で"],["は"],["ありません"],["。"],["こちら"],["が"],["長子","ちょうし"],["です"],["。"],["その"],["頭","あたま"],["に"],["右","みぎ"],["の"],["手","て"],["を"],["置いて","おいて"],["ください"],["」"],["。"]]},{"verse":19,"text":"父,ちちは拒,こばんで言,いった、「わかっている。子,こよ、わたしにはわかっている。彼,かれもまた一つの民,たみとなり、また大,おおいなる者,ものとなるであろう。しかし弟,おとうとは彼,かれよりも大,おおいなる者,ものとなり、その子孫,しそんは多,おおくの国民,こくみんとなるであろう」。","tok":[["父","ちち"],["は"],["拒んで","こばんで"],["言った","いった"],["、"],["「"],["わかって"],["いる"],["。"],["子","こ"],["よ"],["、"],["わたし"],["に"],["は"],["わかって"],["いる"],["。"],["彼","かれ"],["も"],["また"],["一","ひと"],["つ"],["の"],["民","たみ"],["と"],["なり"],["、"],["また"],["大いなる","おおいなる"],["者","もの"],["と"],["なるで"],["あろう"],["。"],["しかし"],["弟","おとうと"],["は"],["彼","かれ"],["より"],["も"],["大いなる","おおいなる"],["者","もの"],["と"],["なり"],["、"],["その"],["子孫","しそん"],["は"],["多く","おおく"],["の"],["国民","こくみん"],["と"],["なるで"],["あろう"],["」"],["。"]]},{"verse":20,"text":"こうして彼,かれはこの日,ひ、彼,かれらを祝福,しゅくふくして言,いった、「あなたを指,さして、イスラエルは、人,ひとを祝福,しゅくふくして言,いうであろう、『神,かみがあなたをエフライムのごとく、またマナセのごとくにせられるように』」。このように、彼,かれはエフライムをマナセの先,さきに立,たてた。","tok":[["こう"],["して"],["彼","かれ"],["は"],["この"],["日","ひ"],["、"],["彼","かれ"],["ら"],["を"],["祝福","しゅくふく"],["して"],["言った","いった"],["、"],["「"],["あなた"],["を"],["指して","さして"],["、"],["イスラエル"],["は"],["、"],["人","ひと"],["を"],["祝福","しゅくふく"],["して"],["言うで","いうで"],["あろう"],["、"],["『"],["神","かみ"],["が"],["あなた"],["を"],["エフライム"],["の"],["ごとく"],["、"],["また"],["マナセ"],["の"],["ごとくに"],["せられる"],["よう"],["に"],["』"],["」"],["。"],["この"],["よう"],["に"],["、"],["彼","かれ"],["は"],["エフライム"],["を"],["マナセ"],["の"],["先","さき"],["に"],["立てた","たてた"],["。"]]},{"verse":21,"text":"イスラエルはまたヨセフに言,いった、「わたしはやがて死,しにます。しかし、神,かみはあなたがたと共,ともにおられて、あなたがたを先祖,せんぞの国,くにに導,みちびき返,かえされるであろう。","tok":[["イスラエル"],["は"],["また"],["ヨセフ"],["に"],["言った","いった"],["、"],["「"],["わたし"],["は"],["やがて"],["死にます","しにます"],["。"],["しかし"],["、"],["神","かみ"],["は"],["あなた"],["がた"],["と"],["共","とも"],["に"],["おられて"],["、"],["あなた"],["がた"],["を"],["先祖","せんぞ"],["の"],["国","くに"],["に"],["導き","みちびき"],["返えされるで","かえされるで"],["あろう"],["。"]]},{"verse":22,"text":"なおわたしは一つの分,ぶんを兄弟,きょうだいよりも多,おおくあなたに与,あたえる。これはわたしがつるぎと弓,ゆみとを持,もってアモリびとの手,てから取,とったものである」。","tok":[["なお"],["わたし"],["は"],["一","ひと"],["つ"],["の"],["分","ぶん"],["を"],["兄弟","きょうだい"],["より"],["も"],["多く","おおく"],["あなた"],["に"],["与える","あたえる"],["。"],["これ"],["は"],["わたし"],["が"],["つるぎ"],["と"],["弓","ゆみ"],["と"],["を"],["持って","もって"],["アモリ"],["びと"],["の"],["手","て"],["から"],["取った","とった"],["もの"],["で"],["ある"],["」"],["。"]]}]
[{"verse":1,"text":"イスラエルはその持,もち物,ものをことごとく携,たずさえて旅立,たびだち、ベエルシバに行,いって、父,ちちイサクの神,かみに犠牲,ぎせいをささげた。","tok":[["イスラエル"],["は"],["その"],["持物","もちもの"],["を"],["ことごとく"],["携えて","たずさえて"],["旅立ち","たびだち"],["、"],["ベエルシバ"],["に"],["行って","いって"],["、"],["父","ちち"],["イサク"],["の"],["神","かみ"],["に"],["犠牲","ぎせい"],["を"],["ささげた"],["。"]]},{"verse":2,"text":"この時,とき、神,かみは夜,よの幻,まぼろしのうちにイスラエルに語,かたって言,いわれた、「ヤコブよ、ヤコブよ」。彼,かれは言,いった、「ここにいます」。","tok":[["この"],["時","とき"],["、"],["神","かみ"],["は"],["夜","よ"],["の"],["幻","まぼろし"],["の"],["うち"],["に"],["イスラエル"],["に"],["語って","かたって"],["言われた","いわれた"],["、"],["「"],["ヤコブ"],["よ"],["、"],["ヤコブ"],["よ"],["」"],["。"],["彼","かれ"],["は"],["言った","いった"],["、"],["「"],["ここ"],["に"],["います"],["」"],["。"]]},{"verse":3,"text":"神,かみは言,いわれた、「わたしは神,かみ、あなたの父,ちちの神,かみである。エジプトに下,くだるのを恐,おそれてはならない。わたしはあそこであなたを大,おおいなる国民,こくみんにする。","tok":[["神","かみ"],["は"],["言われた","いわれた"],["、"],["「"],["わたし"],["は"],["神","かみ"],["、"],["あなた"],["の"],["父","ちち"],["の"],["神","かみ"],["で"],["ある"],["。"],["エジプト"],["に"],["下る","くだる"],["の"],["を"],["恐れて","おそれて"],["は"],["ならない"],["。"],["わたし"],["は"],["あそこ"],["で"],["あなた"],["を"],["大いなる","おおいなる"],["国民","こくみん"],["に"],["する"],["。"]]},{"verse":4,"text":"わたしはあなたと一緒,いっしょにエジプトに下,くだり、また必,かならずあなたを導,みちびき上,のぼるであろう。ヨセフが手,てずからあなたの目,めを閉,とじるであろう」。","tok":[["わたし"],["は"],["あなた"],["と"],["一緒","いっしょ"],["に"],["エジプト"],["に"],["下り","くだり"],["、"],["また"],["必","かならず"],["あなた"],["を"],["導き","みちびき"],["上るで","のぼるで"],["あろう"],["。"],["ヨセフ"],["が"],["手ずから","てずから"],["あなた"],["の"],["目","め"],["を"],["閉じるで","とじるで"],["あろう"],["」"],["。"]]},{"verse":5,"text":"そしてヤコブはベエルシバを立,たった。イスラエルの子,こらはヤコブを乗,のせるためにパロの送,おくった車,くるまに、父,ちちヤコブと幼,おさな子,こたちと妻,つまたちを乗,のせ、","tok":[["そして"],["ヤコブ"],["は"],["ベエルシバ"],["を"],["立った","たった"],["。"],["イスラエル"],["の"],["子","こ"],["ら"],["は"],["ヤコブ"],["を"],["乗せる","のせる"],["ため"],["に"],["パロ"],["の"],["送った","おくった"],["車","くるま"],["に"],["、"],["父","ちち"],["ヤコブ"],["と"],["幼な子","おさなこ"],["たち"],["と"],["妻たち","つまたち"],["を"],["乗せ","のせ"],["、"]]},{"verse":6,"text":"またその家畜,かちくとカナンの地,ちで得,えた財産,ざいさんを携,たずさえ、ヤコブとその子孫,しそんは皆,みなともにエジプトへ行,いった。","tok":[["また"],["その"],["家畜","かちく"],["と"],["カナン"],["の"],["地","ち"],["で"],["得た","えた"],["財産","ざいさん"],["を"],["携え","たずさえ"],["、"],["ヤコブ"],["と"],["その"],["子孫","しそん"],["は"],["皆","みな"],["とも"],["に"],["エジプト"],["へ"],["行った","いった"],["。"]]},{"verse":7,"text":"こうしてヤコブはその子,こと、孫,まごおよび娘,むすめと孫娘,まごむすめなどその子孫,しそんをみな連,つれて、エジプトへ行,いった。","tok":[["こう"],["して"],["ヤコブ"],["は"],["その"],["子","こ"],["と"],["、"],["孫","まご"],["および"],["娘","むすめ"],["と"],["孫娘","まごむすめ"],["など"],["その"],["子孫","しそん"],["を"],["みな"],["連れて","つれて"],["、"],["エジプト"],["へ"],["行った","いった"],["。"]]},{"verse":8,"text":"イスラエルの子,こらでエジプトへ行,いった者,ものの名,なは次,つぎのとおりである。すなわちヤコブとその子,こらであるが、ヤコブの長子,ちょうしはルベン。","tok":[["イスラエル"],["の"],["子","こ"],["ら"],["で"],["エジプト"],["へ"],["行った","いった"],["者","もの"],["の"],["名","な"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["すなわち"],["ヤコブ"],["と"],["その"],["子","こ"],["ら"],["で"],["ある"],["が"],["、"],["ヤコブ"],["の"],["長子","ちょうし"],["は"],["ルベン"],["。"]]},{"verse":9,"text":"ルベンの子,こらはハノク、パル、ヘヅロン、カルミ。","tok":[["ルベン"],["の"],["子","こ"],["ら"],["は"],["ハノク"],["、"],["パル"],["、"],["ヘヅロン"],["、"],["カルミ"],["。"]]},{"verse":10,"text":"シメオンの子,こらはエムエル、ヤミン、オハデ、ヤキン、ゾハル及,およびカナンの女,おんなの産,うんだ子,こシャウル。","tok":[["シメオン"],["の"],["子","こ"],["ら"],["は"],["エムエル"],["、"],["ヤミン"],["、"],["オハデ"],["、"],["ヤキン"],["、"],["ゾハル"],["及","および"],["カナン"],["の"],["女","おんな"],["の"],["産んだ","うんだ"],["子","こ"],["シャウル"],["。"]]},{"verse":11,"text":"レビの子,こらはゲルション、コハテ、メラリ。","tok":[["レビ"],["の"],["子","こ"],["ら"],["は"],["ゲルション"],["、"],["コハテ"],["、"],["メラリ"],["。"]]},{"verse":12,"text":"ユダの子,こらはエル、オナン、シラ、ペレヅ、ゼラ。エルとオナンはカナンの地,ちで死,しんだ。ペレヅの子,こらはヘヅロンとハムル。","tok":[["ユダ"],["の"],["子","こ"],["ら"],["は"],["エル"],["、"],["オナン"],["、"],["シラ"],["、"],["ペレヅ"],["、"],["ゼラ"],["。"],["エル"],["と"],["オナン"],["は"],["カナン"],["の"],["地","ち"],["で"],["死んだ","しんだ"],["。"],["ペレヅ"],["の"],["子","こ"],["ら"],["は"],["ヘヅロン"],["と"],["ハムル"],["。"]]},{"verse":13,"text":"イッサカルの子,こらはトラ、プワ、ヨブ、シムロン。","tok":[["イッサカル"],["の"],["子","こ"],["ら"],["は"],["トラ"],["、"],["プワ"],["、"],["ヨブ"],["、"],["シムロン"],["。"]]},{"verse":14,"text":"ゼブルンの子,こらはセレデ、エロン、ヤリエル。","tok":[["ゼブルン"],["の"],["子","こ"],["ら"],["は"],["セレデ"],["、"],["エロン"],["、"],["ヤリエル"],["。"]]},{"verse":15,"text":"これらと娘,むすめデナとはレアがパダンアラムでヤコブに産,うんだ子,こらである。その子,こらと娘,むすめらは合,あわせて三十三人,にん。","tok":[["これ"],["ら"],["と"],["娘","むすめ"],["デナ"],["と"],["は"],["レア"],["が"],["パダン"],["アラム"],["で"],["ヤコブ"],["に"],["産んだ","うんだ"],["子","こ"],["ら"],["で"],["ある"],["。"],["その"],["子","こ"],["ら"],["と"],["娘","むすめ"],["ら"],["は"],["合","あわせ"],["て"],["三十三人","にん"],["。"]]},{"verse":16,"text":"ガドの子,こらはゼポン、ハギ、シュニ、エヅボン、エリ、アロデ、アレリ。","tok":[["ガド"],["の"],["子","こ"],["ら"],["は"],["ゼポン"],["、"],["ハギ"],["、"],["シュニ"],["、"],["エヅボン"],["、"],["エリ"],["、"],["アロデ"],["、"],["アレリ"],["。"]]},{"verse":17,"text":"アセルの子,こらはエムナ、イシワ、イスイ、ベリアおよび妹,いもうとサラ。ベリアの子,こらはヘベルとマルキエル。","tok":[["アセル"],["の"],["子","こ"],["ら"],["は"],["エムナ"],["、"],["イシワ"],["、"],["イスイ"],["、"],["ベリア"],["および"],["妹","いもうと"],["サラ"],["。"],["ベリア"],["の"],["子","こ"],["ら"],["は"],["ヘベル"],["と"],["マルキエル"],["。"]]},{"verse":18,"text":"これらはラバンが娘,むすめレアに与,あたえたジルパの子,こらである。彼女,かのじょはこれらをヤコブに産,うんだ。合,あわせて十六人,にん。","tok":[["これ"],["ら"],["は"],["ラバン"],["が"],["娘","むすめ"],["レア"],["に"],["与","あたえ"],["た"],["ジルパ"],["の"],["子","こ"],["ら"],["で"],["ある"],["。"],["彼女","かのじょ"],["は"],["これ"],["ら"],["を"],["ヤコブ"],["に"],["産んだ","うんだ"],["。"],["合","あわせ"],["て"],["十六人","にん"],["。"]]},{"verse":19,"text":"ヤコブの妻,つまラケルの子,こらはヨセフとベニヤミンとである。","tok":[["ヤコブ"],["の"],["妻","つま"],["ラケル"],["の"],["子","こ"],["ら"],["は"],["ヨセフ"],["と"],["ベニヤミン"],["と"],["で"],["ある"],["。"]]},{"verse":20,"text":"エジプトの国,くにでヨセフにマナセとエフライムとが生,うまれた。これはオンの祭司,さいしポテペラの娘,むすめアセナテが彼,かれに産,うんだ者,ものである。","tok":[["エジプト"],["の"],["国","くに"],["で"],["ヨセフ"],["に"],["マナセ"],["と"],["エフライム"],["と"],["が"],["生まれた","うまれた"],["。"],["これ"],["は"],["オン"],["の"],["祭司","さいし"],["ポテペラ"],["の"],["娘","むすめ"],["アセナテ"],["が"],["彼","かれ"],["に"],["産んだ","うんだ"],["者","もの"],["で"],["ある"],["。"]]},{"verse":21,"text":"ベニヤミンの子,こらはベラ、ベケル、アシベル、ゲラ、ナアマン、エヒ、ロシ、ムッピム、ホパム、アルデ。","tok":[["ベニヤミン"],["の"],["子","こ"],["ら"],["は"],["ベラ"],["、"],["ベケル"],["、"],["アシベル"],["、"],["ゲラ"],["、"],["ナアマン"],["、"],["エヒ"],["、"],["ロシ"],["、"],["ムッピム"],["、"],["ホパム"],["、"],["アルデ"],["。"]]},{"verse":22,"text":"これらはラケルがヤコブに産,うんだ子,こらである。合,あわせて十四人,にん。","tok":[["これ"],["ら"],["は"],["ラケル"],["が"],["ヤコブ"],["に"],["産んだ","うんだ"],["子","こ"],["ら"],["で"],["ある"],["。"],["合","あわせ"],["て"],["十四人","にん"],["。"]]},{"verse":23,"text":"ダンの子,こはホシム。","tok":[["ダン"],["の"],["子","こ"],["は"],["ホシム"],["。"]]},{"verse":24,"text":"ナフタリの子,こらはヤジエル、グニ、エゼル、シレム。","tok":[["ナフタリ"],["の"],["子","こ"],["ら"],["は"],["ヤジエル"],["、"],["グニ"],["、"],["エゼル"],["、"],["シレム"],["。"]]},{"verse":25,"text":"これらはラバンが娘,むすめラケルに与,あたえたビルハの子,こらである。彼女,かのじょはこれらをヤコブに産,うんだ。合,あわせて七人,にん。","tok":[["これ"],["ら"],["は"],["ラバン"],["が"],["娘","むすめ"],["ラケル"],["に"],["与","あたえ"],["た"],["ビルハ"],["の"],["子","こ"],["ら"],["で"],["ある"],["。"],["彼女","かのじょ"],["は"],["これ"],["ら"],["を"],["ヤコブ"],["に"],["産んだ","うんだ"],["。"],["合","あわせ"],["て"],["七人","にん"],["。"]]},{"verse":26,"text":"ヤコブと共,ともにエジプトへ行,いったすべての者,もの、すなわち彼,かれの身,みから出,でた者,ものはヤコブの子,こらの妻,つまをのぞいて、合,あわせて六十六人,にんであった。","tok":[["ヤコブ"],["と"],["共","とも"],["に"],["エジプト"],["へ"],["行った","いった"],["すべて"],["の"],["者","もの"],["、"],["すなわち"],["彼","かれ"],["の"],["身","み"],["から"],["出た","でた"],["者","もの"],["は"],["ヤコブ"],["の"],["子","こ"],["ら"],["の"],["妻","つま"],["を"],["のぞいて"],["、"],["合","あわせ"],["て"],["六十六人","にん"],["で"],["あった"],["。"]]},{"verse":27,"text":"エジプトでヨセフに生,うまれた子,こがふたりあった。エジプトへ行,いったヤコブの家,いえの者,ものは合,あわせて七十人,にんであった。","tok":[["エジプト"],["で"],["ヨセフ"],["に"],["生まれた","うまれた"],["子","こ"],["が"],["ふたり"],["あった"],["。"],["エジプト"],["へ"],["行った","いった"],["ヤコブ"],["の"],["家","いえ"],["の"],["者","もの"],["は"],["合","あわせ"],["て"],["七","なな"],["十人","じゅうにん"],["で"],["あった"],["。"]]},{"verse":28,"text":"さてヤコブはユダをさきにヨセフにつかわして、ゴセンで会,あおうと言,いわせた。そして彼,かれらはゴセンの地,ちへ行,いった。","tok":[["さて"],["ヤコブ"],["は"],["ユダ"],["を"],["さき"],["に"],["ヨセフ"],["に"],["つかわして"],["、"],["ゴセン"],["で"],["会おう","あおう"],["と"],["言わせた","いわせた"],["。"],["そして"],["彼","かれ"],["ら"],["は"],["ゴセン"],["の"],["地","ち"],["へ"],["行った","いった"],["。"]]},{"verse":29,"text":"ヨセフは車,くるまを整,ととのえて、父,ちちイスラエルを迎,むかえるためにゴセンに上,のぼり、父,ちちに会,あい、そのくびを抱,だき、くびをかかえて久,ひさしく泣,ないた。","tok":[["ヨセフ"],["は"],["車","くるま"],["を"],["整えて","ととのえて"],["、"],["父","ちち"],["イスラエル"],["を"],["迎","むかえ"],["る"],["ため"],["に"],["ゴセン"],["に"],["上り","のぼり"],["、"],["父","ちち"],["に"],["会い","あい"],["、"],["その"],["くび"],["を"],["抱き","だき"],["、"],["くび"],["を"],["かかえて"],["久く","ひさしく"],["泣いた","ないた"],["。"]]},{"verse":30,"text":"時,ときに、イスラエルはヨセフに言,いった、「あなたがなお生,いきていて、わたしはあなたの顔,かおを見,みたので今,いまは死,しんでもよい」。","tok":[["時","とき"],["に"],["、"],["イスラエル"],["は"],["ヨセフ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["が"],["なお"],["生きて","いきて"],["いて"],["、"],["わたし"],["は"],["あなた"],["の"],["顔","かお"],["を"],["見た","みた"],["ので"],["今","いま"],["は"],["死んで","しんで"],["も"],["よい"],["」"],["。"]]},{"verse":31,"text":"ヨセフは兄弟,きょうだいたちと父,ちちの家族,かぞくとに言,いった、「わたしは上,のぼってパロに言,いおう、『カナンの地,ちにいたわたしの兄弟,きょうだいたちと父,ちちの家族,かぞくとがわたしの所,ところへきました。","tok":[["ヨセフ"],["は"],["兄弟","きょうだい"],["たち"],["と"],["父","ちち"],["の"],["家族","かぞく"],["と"],["に"],["言った","いった"],["、"],["「"],["わたし"],["は"],["上って","のぼって"],["パロ"],["に"],["言おう","いおう"],["、"],["『"],["カナン"],["の"],["地","ち"],["に"],["いた"],["わたし"],["の"],["兄弟","きょうだい"],["たち"],["と"],["父","ちち"],["の"],["家族","かぞく"],["と"],["が"],["わたし"],["の"],["所","ところ"],["へ"],["きました"],["。"]]},{"verse":32,"text":"この者,ものらは羊,ひつじを飼,かう者,もの、家畜,かちくの牧者,ぼくしゃで、その羊,ひつじ、牛,うしおよび持,もち物,ものをみな携,たずさえてきました』。","tok":[["この"],["者","もの"],["ら"],["は"],["羊","ひつじ"],["を"],["飼う","かう"],["者","もの"],["、"],["家畜","かちく"],["の"],["牧者","ぼくしゃ"],["で"],["、"],["その"],["羊","ひつじ"],["、"],["牛","うし"],["および"],["持物","もちもの"],["を"],["みな"],["携えて","たずさえて"],["きました"],["』"],["。"]]},{"verse":33,"text":"もしパロがあなたがたを召,めして、『あなたがたの職業,しょくぎょうは何,なにか』と言,いわれたら、","tok":[["もし"],["パロ"],["が"],["あなた"],["がた"],["を"],["召","めし"],["て"],["、"],["『"],["あなた"],["がた"],["の"],["職業","しょくぎょう"],["は"],["何に","なに"],["か"],["』"],["と"],["言われたら","いわれたら"],["、"]]},{"verse":34,"text":"『しもべらは幼,おさない時,ときから、ずっと家畜,かちくの牧者,ぼくしゃです。われわれも、われわれの先祖,せんぞもそうです』と言,いいなさい。そうすればあなたがたはゴセンの地,ちに住,すむことができましょう。羊飼,ひつじかいはすべて、エジプトびとの忌,いむ者,ものだからです」。","tok":[["『"],["しもべ"],["ら"],["は"],["幼ない","おさない"],["時","とき"],["から"],["、"],["ずっと"],["家畜","かちく"],["の"],["牧者","ぼくしゃ"],["です"],["。"],["われわれ"],["も"],["、"],["われわれ"],["の"],["先祖","せんぞ"],["も"],["そう"],["です"],["』"],["と"],["言い","いい"],["なさい"],["。"],["そう"],["すれば"],["あなた"],["がた"],["は"],["ゴセン"],["の"],["地","ち"],["に"],["住む","すむ"],["こと"],["が"],["できましょう"],["。"],["羊飼","ひつじかい"],["は"],["すべて"],["、"],["エジプト"],["びと"],["の"],["忌む","いむ"],["者","もの"],["だ"],["から"],["です"],["」"],["。"]]}]
[{"verse":1,"text":"ときに神,かみはヤコブに言,いわれた、「あなたは立,たってベテルに上,のぼり、そこに住,すんで、あなたがさきに兄,あにエサウの顔,かおを避,さけてのがれる時,とき、あなたに現,あらわれた神,かみに祭壇,さいだんを造,つくりなさい」。","tok":[["とき"],["に"],["神","かみ"],["は"],["ヤコブ"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["は"],["立って","たって"],["ベテル"],["に"],["上り","のぼり"],["、"],["そこ"],["に"],["住んで","すんで"],["、"],["あなた"],["が"],["さき"],["に"],["兄","あに"],["エサウ"],["の"],["顔","かお"],["を"],["避けて","さけて"],["のがれる"],["時","とき"],["、"],["あなた"],["に"],["現われた","あらわれた"],["神","かみ"],["に"],["祭壇","さいだん"],["を"],["造","つくり"],["なさい"],["」"],["。"]]},{"verse":2,"text":"ヤコブは、その家族,かぞくおよび共,ともにいるすべての者,ものに言,いった、「あなたがたのうちにある異,ことなる神々,かみがみを捨,すて、身,みを清,きよめて着物,きものを着替,きがえなさい。","tok":[["ヤコブ"],["は"],["、"],["その"],["家族","かぞく"],["および"],["共","とも"],["に"],["いる"],["すべて"],["の"],["者","もの"],["に"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["の"],["うち"],["に"],["ある"],["異なる","ことなる"],["神々","かみがみ"],["を"],["捨て","すて"],["、"],["身","み"],["を"],["清めて","きよめて"],["着物","きもの"],["を"],["着替","きがえ"],["なさい"],["。"]]},{"verse":3,"text":"われわれは立,たってベテルに上,のぼり、その所,ところでわたしの苦難,くなんの日,ひにわたしにこたえ、かつわたしの行,いく道,みちで共,ともにおられた神,かみに祭壇,さいだんを造,つくろう」。","tok":[["われわれ"],["は"],["立って","たって"],["ベテル"],["に"],["上り","のぼり"],["、"],["その"],["所","ところ"],["で"],["わたし"],["の"],["苦難","くなん"],["の"],["日","ひ"],["に"],["わたし"],["に"],["こたえ"],["、"],["かつ"],["わたし"],["の"],["行く","いく"],["道","みち"],["で"],["共","とも"],["に"],["おられた"],["神","かみ"],["に"],["祭壇","さいだん"],["を"],["造ろう","つくろう"],["」"],["。"]]},{"verse":4,"text":"そこで彼,かれらは持,もっている異,ことなる神々,かみがみと、耳,みみにつけている耳輪,みみわをことごとくヤコブに与,あたえたので、ヤコブはこれをシケムのほとりにあるテレビンの木,きの下,したに埋,うめた。","tok":[["そこ"],["で"],["彼","かれ"],["ら"],["は"],["持って","もって"],["いる"],["異なる","ことなる"],["神々","かみがみ"],["と"],["、"],["耳","みみ"],["に"],["つけて"],["いる"],["耳輪","みみわ"],["を"],["ことごとく"],["ヤコブ"],["に"],["与","あたえ"],["た"],["ので"],["、"],["ヤコブ"],["は"],["これ"],["を"],["シケム"],["の"],["ほとり"],["に"],["ある"],["テレビン"],["の"],["木","き"],["の"],["下","した"],["に"],["埋めた","うめた"],["。"]]},{"verse":5,"text":"そして彼,かれらは、いで立,たったが、大,おおいなる恐,おそれが周囲,しゅういの町々,まちまちに起,たったので、ヤコブの子,こらのあとを追,おう者,ものはなかった。","tok":[["そして"],["彼","かれ"],["ら"],["は"],["、"],["いで立った","いでたった"],["が"],["、"],["大いなる","おおいなる"],["恐","おそれ"],["が"],["周囲","しゅうい"],["の"],["町々","まちまち"],["に"],["起","たった"],["ので"],["、"],["ヤコブ"],["の"],["子","こ"],["ら"],["の"],["あと"],["を"],["追う","おう"],["者","もの"],["は"],["なかった"],["。"]]},{"verse":6,"text":"こうしてヤコブは共,ともにいたすべての人々,ひとびとと一緒,いっしょにカナンの地,ちにあるルズ、すなわちベテルにきた。","tok":[["こう"],["して"],["ヤコブ"],["は"],["共","とも"],["に"],["いた"],["すべて"],["の"],["人々","ひとびと"],["と"],["一緒","いっしょ"],["に"],["カナン"],["の"],["地","ち"],["に"],["ある"],["ルズ"],["、"],["すなわち"],["ベテル"],["に"],["きた"],["。"]]},{"verse":7,"text":"彼,かれはそこに祭壇,さいだんを築,きずき、その所,ところをエル・ベテルと名,なづけた。彼,かれが兄,あにの顔,かおを避,さけてのがれる時,とき、神,かみがそこで彼,かれに現,あらわれたからである。","tok":[["彼","かれ"],["は"],["そこ"],["に"],["祭壇","さいだん"],["を"],["築き","きずき"],["、"],["その"],["所","ところ"],["を"],["エル"],["・"],["ベテル"],["と"],["名づけた","なづけた"],["。"],["彼","かれ"],["が"],["兄","あに"],["の"],["顔","かお"],["を"],["避けて","さけて"],["のがれる"],["時","とき"],["、"],["神","かみ"],["が"],["そこ"],["で"],["彼","かれ"],["に"],["現われた","あらわれた"],["から"],["で"],["ある"],["。"]]},{"verse":8,"text":"時,ときにリベカのうばデボラが死,しんで、ベテルのしもの、かしの木,きの下,したに葬,ほうむられた。これによってその木,きの名,なをアロン・バクテと呼,よばれた。","tok":[["時","とき"],["に"],["リベカ"],["の"],["うば"],["デボラ"],["が"],["死んで","しんで"],["、"],["ベテル"],["の"],["し"],["もの"],["、"],["かし"],["の"],["木","き"],["の"],["下","した"],["に"],["葬むられた","ほうむられた"],["。"],["これ"],["によって"],["その"],["木","き"],["の"],["名","な"],["を"],["アロン"],["・"],["バクテ"],["と"],["呼ばれた","よばれた"],["。"]]},{"verse":9,"text":"さてヤコブがパダンアラムから帰,かえってきた時,とき、神,かみは再,ふたたび彼,かれに現,あらわれて彼,かれを祝福,しゅくふくされた。","tok":[["さて"],["ヤコブ"],["が"],["パダン"],["アラム"],["から"],["帰えって","かえって"],["きた"],["時","とき"],["、"],["神","かみ"],["は"],["再び","ふたたび"],["彼","かれ"],["に"],["現われて","あらわれて"],["彼","かれ"],["を"],["祝福","しゅくふく"],["された"],["。"]]},{"verse":10,"text":"神,かみは彼,かれに言,いわれた、「あなたの名,なはヤコブである。しかしあなたの名,なをもはやヤコブと呼,よんではならない。あなたの名,なをイスラエルとしなさい」。こうして彼,かれをイスラエルと名,なづけられた。","tok":[["神","かみ"],["は"],["彼","かれ"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["の"],["名","な"],["は"],["ヤコブ"],["で"],["ある"],["。"],["しかし"],["あなた"],["の"],["名","な"],["を"],["もはや"],["ヤコブ"],["と"],["呼","よん"],["で"],["は"],["ならない"],["。"],["あなた"],["の"],["名","な"],["を"],["イスラエル"],["と"],["し"],["なさい"],["」"],["。"],["こう"],["して"],["彼","かれ"],["を"],["イスラエル"],["と"],["名づけられた","なづけられた"],["。"]]},{"verse":11,"text":"神,かみはまた彼,かれに言,いわれた、「わたしは全能,ぜんのうの神,かみである。あなたは生,うめよ、またふえよ。一つの国民,こくみん、また多,おおくの国民,こくみんがあなたから出,でて、王,おうたちがあなたの身,みから出,でるであろう。","tok":[["神","かみ"],["は"],["また"],["彼","かれ"],["に"],["言われた","いわれた"],["、"],["「"],["わたし"],["は"],["全能","ぜんのう"],["の"],["神","かみ"],["で"],["ある"],["。"],["あなた"],["は"],["生めよ","うめよ"],["、"],["また"],["ふえ"],["よ"],["。"],["一","ひと"],["つ"],["の"],["国民","こくみん"],["、"],["また"],["多く","おおく"],["の"],["国民","こくみん"],["が"],["あなた"],["から"],["出て","でて"],["、"],["王","おう"],["たち"],["が"],["あなた"],["の"],["身","み"],["から"],["出るで","でるで"],["あろう"],["。"]]},{"verse":12,"text":"わたしはアブラハムとイサクとに与,あたえた地,ちを、あなたに与,あたえよう。またあなたの後,のちの子孫,しそんにその地,ちを与,あたえよう」。","tok":[["わたし"],["は"],["アブラハム"],["と"],["イサク"],["と"],["に"],["与","あたえ"],["た"],["地","ち"],["を"],["、"],["あなた"],["に"],["与","あたえ"],["よう"],["。"],["また"],["あなた"],["の"],["後","のち"],["の"],["子孫","しそん"],["に"],["その"],["地","ち"],["を"],["与","あたえ"],["よう"],["」"],["。"]]},{"verse":13,"text":"神,かみは彼,かれと語,かたっておられたその場所,ばしょから彼,かれを離,はなれてのぼられた。","tok":[["神","かみ"],["は"],["彼","かれ"],["と"],["語って","かたって"],["おられた"],["その"],["場所","ばしょ"],["から"],["彼","かれ"],["を"],["離れて","はなれて"],["のぼられた"],["。"]]},{"verse":14,"text":"そこでヤコブは神,かみが自分,じぶんと語,かたられたその場所,ばしょに、一本,ぽんの石,いしの柱,はしらを立,たて、その上,うえに灌祭,かんさいをささげ、また油,あぶらを注,そそいだ。","tok":[["そこ"],["で"],["ヤコブ"],["は"],["神","かみ"],["が"],["自分","じぶん"],["と"],["語られた","かたられた"],["その"],["場所","ばしょ"],["に"],["、"],["一本","ぽん"],["の"],["石","いし"],["の"],["柱","はしら"],["を"],["立て","たて"],["、"],["その"],["上","うえ"],["に"],["灌祭","かんさい"],["を"],["ささげ"],["、"],["また"],["油","あぶら"],["を"],["注いだ","そそいだ"],["。"]]},{"verse":15,"text":"そしてヤコブは神,かみが自分,じぶんと語,かたられたその場所,ばしょをベテルと名,なづけた。","tok":[["そして"],["ヤコブ"],["は"],["神","かみ"],["が"],["自分","じぶん"],["と"],["語られた","かたられた"],["その"],["場所","ばしょ"],["を"],["ベテル"],["と"],["名づけた","なづけた"],["。"]]},{"verse":16,"text":"こうして彼,かれらはベテルを立,たったが、エフラタに行,いき着,つくまでに、なお隔,へだたりのある所,ところでラケルは産気,さんけづき、その産,さんは重,おもかった。","tok":[["こう"],["して"],["彼","かれ"],["ら"],["は"],["ベテル"],["を"],["立った","たった"],["が"],["、"],["エフラタ"],["に"],["行き着く","いきつく"],["まで"],["に"],["、"],["なお"],["隔たり","へだたり"],["の"],["ある"],["所","ところ"],["で"],["ラケル"],["は"],["産気","さんけ"],["づき"],["、"],["その"],["産","さん"],["は"],["重かった","おもかった"],["。"]]},{"verse":17,"text":"その難産,なんざんに当,あたって、産婆,さんばは彼女,かのじょに言,いった、「心配,しんぱいすることはありません。今度,こんども男,おとこの子,こです」。","tok":[["その"],["難産","なんざん"],["に"],["当たって","あたって"],["、"],["産婆","さんば"],["は"],["彼女","かのじょ"],["に"],["言った","いった"],["、"],["「"],["心配","しんぱい"],["する"],["こと"],["は"],["ありません"],["。"],["今度","こんど"],["も"],["男の子","おとこのこ"],["です"],["」"],["。"]]},{"verse":18,"text":"彼女,かのじょは死,しにのぞみ、魂,たましいの去,さろうとする時,とき、子,この名,なをベノニと呼,よんだ。しかし、父,ちちはこれをベニヤミンと名,なづけた。","tok":[["彼女","かのじょ"],["は"],["死","し"],["に"],["のぞみ"],["、"],["魂","たましい"],["の"],["去ろう","さろう"],["と"],["する"],["時","とき"],["、"],["子","こ"],["の"],["名","な"],["を"],["ベノニ"],["と"],["呼んだ","よんだ"],["。"],["しかし"],["、"],["父","ちち"],["は"],["これ"],["を"],["ベニヤミン"],["と"],["名づけた","なづけた"],["。"]]},{"verse":19,"text":"ラケルは死,しんでエフラタ、すなわちベツレヘムの道,みちに葬,ほうむられた。","tok":[["ラケル"],["は"],["死んで","しんで"],["エフラタ"],["、"],["すなわち"],["ベツレヘム"],["の"],["道","みち"],["に"],["葬むられた","ほうむられた"],["。"]]},{"verse":20,"text":"ヤコブはその墓,はかに柱,はしらを立,たてた。これはラケルの墓,はかの柱,はしらであって、今日,こんにちに至,いたっている。","tok":[["ヤコブ"],["は"],["その"],["墓","はか"],["に"],["柱","はしら"],["を"],["立てた","たてた"],["。"],["これ"],["は"],["ラケル"],["の"],["墓","はか"],["の"],["柱","はしら"],["で"],["あって"],["、"],["今日","こんにち"],["に"],["至って","いたって"],["いる"],["。"]]},{"verse":21,"text":"イスラエルはまた、いで立,たってミグダル・エダルの向,むこうに天幕,てんまくを張,はった。","tok":[["イスラエル"],["は"],["また"],["、"],["いで立って","いでたって"],["ミグダル"],["・"],["エダル"],["の"],["向こう","むこう"],["に"],["天幕","てんまく"],["を"],["張った","はった"],["。"]]},{"verse":22,"text":"イスラエルがその地,ちに住,すんでいた時,とき、ルベンは父,ちちのそばめビルハのところへ行,いって、これと寝,ねた。イスラエルはこれを聞,きいた。さてヤコブの子,こらは十二人,にんであった。","tok":[["イスラエル"],["が"],["その"],["地","ち"],["に"],["住んで","すんで"],["いた"],["時","とき"],["、"],["ルベン"],["は"],["父","ちち"],["の"],["そばめ"],["ビルハ"],["の"],["ところ"],["へ"],["行って","いって"],["、"],["これ"],["と"],["寝た","ねた"],["。"],["イスラエル"],["は"],["これ"],["を"],["聞いた","きいた"],["。"],["さて"],["ヤコブ"],["の"],["子","こ"],["ら"],["は"],["十二人","にん"],["で"],["あった"],["。"]]},{"verse":23,"text":"すなわちレアの子,こらはヤコブの長子,ちょうしルベンとシメオン、レビ、ユダ、イッサカル、ゼブルン。","tok":[["すなわち"],["レア"],["の"],["子","こ"],["ら"],["は"],["ヤコブ"],["の"],["長子","ちょうし"],["ルベン"],["と"],["シメオン"],["、"],["レビ"],["、"],["ユダ"],["、"],["イッサカル"],["、"],["ゼブルン"],["。"]]},{"verse":24,"text":"ラケルの子,こらはヨセフとベニヤミン。","tok":[["ラケル"],["の"],["子","こ"],["ら"],["は"],["ヨセフ"],["と"],["ベニヤミン"],["。"]]},{"verse":25,"text":"ラケルのつかえめビルハの子,こらはダンとナフタリ。","tok":[["ラケル"],["の"],["つかえ"],["め"],["ビルハ"],["の"],["子","こ"],["ら"],["は"],["ダン"],["と"],["ナフタリ"],["。"]]},{"verse":26,"text":"レアのつかえめジルパの子,こらはガドとアセル。これらはヤコブの子,こらであって、パダンアラムで彼,かれに生,うまれた者,ものである。","tok":[["レア"],["の"],["つかえ"],["め"],["ジルパ"],["の"],["子","こ"],["ら"],["は"],["ガド"],["と"],["アセル"],["。"],["これ"],["ら"],["は"],["ヤコブ"],["の"],["子","こ"],["ら"],["で"],["あって"],["、"],["パダン"],["アラム"],["で"],["彼","かれ"],["に"],["生まれた","うまれた"],["者","もの"],["で"],["ある"],["。"]]},{"verse":27,"text":"ヤコブはキリアテ・アルバ、すなわちヘブロンのマムレにいる父,ちちイサクのもとへ行,いった。ここはアブラハムとイサクとが寄留,きりゅうした所,ところである。","tok":[["ヤコブ"],["は"],["キリアテ"],["・"],["アルバ"],["、"],["すなわち"],["ヘブロン"],["の"],["マムレ"],["に"],["いる"],["父","ちち"],["イサク"],["の"],["もと"],["へ"],["行った","いった"],["。"],["ここ"],["は"],["アブラハム"],["と"],["イサク"],["と"],["が"],["寄留","きりゅう"],["した"],["所","ところ"],["で"],["ある"],["。"]]},{"verse":28,"text":"イサクの年,としは百八十歳,さいであった。","tok":[["イサク"],["の"],["年","とし"],["は"],["百八十歳","さ"],["いで"],["あった"],["。"]]},{"verse":29,"text":"イサクは年老,としおい、日,ひ満,みちて息,いき絶,たえ、死,しんで、その民,たみに加,くわえられた。その子,こエサウとヤコブとは、これを葬,ほうむった。","tok":[["イサク"],["は"],["年老い","としおい"],["、"],["日","ひ"],["満ちて","みちて"],["息","いき"],["絶え","たえ"],["、"],["死んで","しんで"],["、"],["その"],["民","たみ"],["に"],["加えられた","くわえられた"],["。"],["その"],["子","こ"],["エサウ"],["と"],["ヤコブ"],["と"],["は"],["、"],["これ"],["を"],["葬むった","ほうむった"],["。"]]}]
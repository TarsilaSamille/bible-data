[{"verse":1,"text":"主,しゅはノアに言,いわれた、「あなたと家族,かぞくとはみな箱舟,はこぶねにはいりなさい。あなたがこの時代,じだいの人々,ひとびとの中,なかで、わたしの前,まえに正,ただしい人,ひとであるとわたしは認,みとめたからである。","tok":[["主","しゅ"],["は"],["ノア"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["と"],["家族","かぞく"],["と"],["は"],["みな"],["箱舟","はこぶね"],["に"],["はいり"],["なさい"],["。"],["あなた"],["が"],["この"],["時代","じだい"],["の"],["人々","ひとびと"],["の"],["中","なか"],["で"],["、"],["わたし"],["の"],["前","まえ"],["に"],["正い","ただしい"],["人","ひと"],["で"],["ある"],["と"],["わたし"],["は"],["認めた","みとめた"],["から"],["で"],["ある"],["。"]]},{"verse":2,"text":"あなたはすべての清,きよい獣,けものの中,なかから雄,おすと雌,めすとを七つずつ取,とり、清,きよくない獣,けものの中,なかから雄,おすと雌,めすとを二つずつ取,とり、","tok":[["あなた"],["は"],["すべて"],["の"],["清い","きよい"],["獣","けもの"],["の"],["中","なか"],["から"],["雄","おす"],["と"],["雌","めす"],["と"],["を"],["七","なな"],["つ"],["ずつ"],["取","とり"],["、"],["清く","きよく"],["ない"],["獣","けもの"],["の"],["中","なか"],["から"],["雄","おす"],["と"],["雌","めす"],["と"],["を"],["二","ふた"],["つ"],["ずつ"],["取","とり"],["、"]]},{"verse":3,"text":"また空,そらの鳥,とりの中,なかから雄,おすと雌,めすとを七つずつ取,とって、その種類,しゅるいが全,ぜん地,ちのおもてに生,いき残,のこるようにしなさい。","tok":[["また"],["空","そら"],["の"],["鳥","とり"],["の"],["中","なか"],["から"],["雄","おす"],["と"],["雌","めす"],["と"],["を"],["七","なな"],["つ"],["ずつ"],["取って","とって"],["、"],["その"],["種類","しゅるい"],["が"],["全地","ぜんち"],["の"],["おもて"],["に"],["生き残る","いきのこる"],["よう"],["に"],["し"],["なさい"],["。"]]},{"verse":4,"text":"七日,なぬかの後,のち、わたしは四十日,にち四十夜,や、地,ちに雨,あめを降,ふらせて、わたしの造,つくったすべての生,いき物,ものを、地,ちのおもてからぬぐい去,さります」。","tok":[["七日","なぬか"],["の"],["後","の"],["ち"],["、"],["わたし"],["は"],["四十日","に"],["ち"],["四十","よんじゅう"],["夜","よる"],["、"],["地","ち"],["に"],["雨","あめ"],["を"],["降らせて","ふらせて"],["、"],["わたし"],["の"],["造った","つくった"],["すべて"],["の"],["生き物","いきもの"],["を"],["、"],["地","ち"],["の"],["おもて"],["から"],["ぬぐい去ります","ぬぐいさります"],["」"],["。"]]},{"verse":5,"text":"ノアはすべて主,しゅが命,めいじられたようにした。","tok":[["ノア"],["は"],["すべて"],["主","しゅ"],["が"],["命じられた","めいじられた"],["よう"],["に"],["した"],["。"]]},{"verse":6,"text":"さて洪水,こうずいが地,ちに起,たった時,とき、ノアは六百歳,さいであった。","tok":[["さて"],["洪水","こうずい"],["が"],["地","ち"],["に"],["起った","たった"],["時","とき"],["、"],["ノア"],["は"],["六百歳","さ"],["いで"],["あった"],["。"]]},{"verse":7,"text":"ノアは子,こらと、妻,つまと、子,こらの妻,つまたちと共,ともに洪水,こうずいを避,さけて箱舟,はこぶねにはいった。","tok":[["ノア"],["は"],["子","こ"],["ら"],["と"],["、"],["妻","つま"],["と"],["、"],["子","こ"],["ら"],["の"],["妻たち","つまたち"],["と"],["共","とも"],["に"],["洪水","こうずい"],["を"],["避けて","さけて"],["箱舟","はこぶね"],["に"],["はいった"],["。"]]},{"verse":8,"text":"また清,きよい獣,けものと、清,きよくない獣,けものと、鳥,とりと、地,ちに這,はうすべてのものとの、","tok":[["また"],["清い","きよい"],["獣","けもの"],["と"],["、"],["清く","きよく"],["ない"],["獣","けもの"],["と"],["、"],["鳥","とり"],["と"],["、"],["地","ち"],["に"],["這う","はう"],["すべて"],["の"],["もの"],["と"],["の"],["、"]]},{"verse":9,"text":"雄,おすと雌,めすとが、二つずつノアのもとにきて、神,かみがノアに命,めいじられたように箱舟,はこぶねにはいった。","tok":[["雄","おす"],["と"],["雌","めす"],["と"],["が"],["、"],["二","ふた"],["つ"],["ずつ"],["ノア"],["の"],["もと"],["に"],["きて"],["、"],["神","かみ"],["が"],["ノア"],["に"],["命じられた","めいじられた"],["よう"],["に"],["箱舟","はこぶね"],["に"],["はいった"],["。"]]},{"verse":10,"text":"こうして七日,なぬかの後,のち、洪水,こうずいが地,ちに起,たった。","tok":[["こう"],["して"],["七日","なぬか"],["の"],["後","の"],["ち"],["、"],["洪水","こうずい"],["が"],["地","ち"],["に"],["起った","たった"],["。"]]},{"verse":11,"text":"それはノアの六百歳,さいの二月,がつ十七日,にちであって、その日,ひに大,おおいなる淵,ふちの源,みなもとは、ことごとく破,やぶれ、天,てんの窓,まどが開,ひらけて、","tok":[["それ"],["は"],["ノア"],["の"],["六百歳","さい"],["の"],["二","に"],["月","がつ"],["つ"],["十七日","に"],["ち"],["で"],["あって"],["、"],["その"],["日","ひ"],["に"],["大いなる","おおいなる"],["淵","ふち"],["の"],["源","みなもと"],["は"],["、"],["ことごとく"],["破れ","やぶれ"],["、"],["天","てん"],["の"],["窓","まど"],["が"],["開て","ひらけて"],["、"]]},{"verse":12,"text":"雨,あめは四十日,にち四十夜,や、地,ちに降,ふり注,そそいだ。","tok":[["雨","あめ"],["は"],["四十日","に"],["ち"],["四十","よんじゅう"],["夜","よる"],["、"],["地","ち"],["に"],["降り注いだ","ふりそそいだ"],["。"]]},{"verse":13,"text":"その同,おなじ日,ひに、ノアと、ノアの子,こセム、ハム、ヤペテと、ノアの妻,つまと、その子,こらの三人,にんの妻,つまとは共,ともに箱舟,はこぶねにはいった。","tok":[["その"],["同じ","おなじ"],["日","ひ"],["に"],["、"],["ノア"],["と"],["、"],["ノア"],["の"],["子","こ"],["セム"],["、"],["ハム"],["、"],["ヤペテ"],["と"],["、"],["ノア"],["の"],["妻","つま"],["と"],["、"],["その"],["子","こ"],["ら"],["の"],["三人","にん"],["の"],["妻","つま"],["と"],["は"],["共","とも"],["に"],["箱舟","はこぶね"],["に"],["はいった"],["。"]]},{"verse":14,"text":"またすべての種類,しゅるいの獣,けものも、すべての種類,しゅるいの家畜,かちくも、地,ちのすべての種類,しゅるいの這,はうものも、すべての種類,しゅるいの鳥,とりも、すべての翼,つばさあるものも、皆,みなはいった。","tok":[["また"],["すべて"],["の"],["種類","しゅるい"],["の"],["獣","けもの"],["も"],["、"],["すべて"],["の"],["種類","しゅるい"],["の"],["家畜","かちく"],["も"],["、"],["地","ち"],["の"],["すべて"],["の"],["種類","しゅるい"],["の"],["這う","はう"],["もの"],["も"],["、"],["すべて"],["の"],["種類","しゅるい"],["の"],["鳥","とり"],["も"],["、"],["すべて"],["の"],["翼","つばさ"],["ある"],["もの"],["も"],["、"],["皆","みな"],["は"],["いった"],["。"]]},{"verse":15,"text":"すなわち命,いのちの息,いきのあるすべての肉,にくなるものが、二つずつノアのもとにきて、箱舟,はこぶねにはいった。","tok":[["すなわち"],["命","いのち"],["の"],["息","いき"],["の"],["ある"],["すべて"],["の"],["肉","にく"],["なる"],["もの"],["が"],["、"],["二","ふた"],["つ"],["ずつ"],["ノア"],["の"],["もと"],["に"],["きて"],["、"],["箱舟","はこぶね"],["に"],["はいった"],["。"]]},{"verse":16,"text":"そのはいったものは、すべて肉,にくなるものの雄,おすと雌,めすとであって、神,かみが彼,かれに命,めいじられたようにはいった。そこで主,しゅは彼,かれのうしろの戸,とを閉,とざされた。","tok":[["その"],["はいった"],["もの"],["は"],["、"],["すべて"],["肉","にく"],["なる"],["もの"],["の"],["雄","おす"],["と"],["雌","めす"],["と"],["であって"],["、"],["神","かみ"],["が"],["彼","かれ"],["に"],["命じられた","めいじられた"],["よう"],["に"],["はいった"],["。"],["そこ"],["で"],["主","しゅ"],["は"],["彼","かれ"],["の"],["うしろ"],["の"],["戸","と"],["を"],["閉ざされた","とざされた"],["。"]]},{"verse":17,"text":"洪水,こうずいは四十日,にちのあいだ地上,ちじょうにあった。水,みずが増,まして箱舟,はこぶねを浮,うかべたので、箱舟,はこぶねは地,ちから高,たかく上,あがった。","tok":[["洪水","こうずい"],["は"],["四十日","にち"],["の"],["あいだ"],["地上","ちじょう"],["に"],["あった"],["。"],["水","みず"],["が"],["増して","まして"],["箱舟","はこぶね"],["を"],["浮かべた","うかべた"],["ので"],["、"],["箱舟","はこぶね"],["は"],["地","ち"],["から"],["高かく","たかく"],["上がった","あがった"],["。"]]},{"verse":18,"text":"また水,みずがみなぎり、地,ちに増,ましたので、箱舟,はこぶねは水,みずのおもてに漂,ただよった。","tok":[["また"],["水","みず"],["が"],["みなぎり"],["、"],["地","ち"],["に"],["増した","ました"],["ので"],["、"],["箱舟","はこぶね"],["は"],["水","みず"],["の"],["おもて"],["に"],["漂よった","ただよった"],["。"]]},{"verse":19,"text":"水,みずはまた、ますます地,ちにみなぎり、天,てんの下,したの高,たかい山々,やまやまは皆,みなおおわれた。","tok":[["水","みず"],["は"],["また"],["、"],["ますます"],["地","ち"],["に"],["みなぎり"],["、"],["天","てん"],["の"],["下","した"],["の"],["高い","たかい"],["山々","やまやま"],["は"],["皆","みな"],["おおわれた"],["。"]]},{"verse":20,"text":"水,みずはその上,うえ、さらに十五キュビトみなぎって、山々,やまやまは全,まったくおおわれた。","tok":[["水","みず"],["は"],["その"],["上","うえ"],["、"],["さらに"],["十五","じゅうご"],["キュビト"],["みなぎって"],["、"],["山々","やまやま"],["は"],["全く","まったく"],["おおわれた"],["。"]]},{"verse":21,"text":"地,ちの上,うえに動,うごくすべて肉,にくなるものは、鳥,とりも家畜,かちくも獣,けものも、地,ちに群,むらがるすべての這,はうものも、すべての人,ひともみな滅,ほろびた。","tok":[["地","ち"],["の"],["上","うえ"],["に"],["動く","うごく"],["すべて"],["肉","にく"],["なる"],["もの"],["は"],["、"],["鳥","とり"],["も"],["家畜","かちく"],["も"],["獣","けもの"],["も"],["、"],["地","ち"],["に"],["群らがる","むらがる"],["すべて"],["の"],["這う","はう"],["もの"],["も"],["、"],["すべて"],["の"],["人","ひと"],["も"],["みな"],["滅びた","ほろびた"],["。"]]},{"verse":22,"text":"すなわち鼻,はなに命,いのちの息,いきのあるすべてのもの、陸,りくにいたすべてのものは死,しんだ。","tok":[["すなわち"],["鼻","はな"],["に"],["命","いのち"],["の"],["息","いき"],["の"],["ある"],["すべて"],["の"],["もの"],["、"],["陸","りく"],["に"],["いた"],["すべて"],["の"],["もの"],["は"],["死んだ","しんだ"],["。"]]},{"verse":23,"text":"地,ちのおもてにいたすべての生,いき物,ものは、人,ひとも家畜,かちくも、這,はうものも、空,そらの鳥,とりもみな地,ちからぬぐい去,さられて、ただノアと、彼,かれと共,ともに箱舟,はこぶねにいたものだけが残,のこった。","tok":[["地","ち"],["の"],["おもて"],["に"],["いた"],["すべて"],["の"],["生き物","いきもの"],["は"],["、"],["人","ひと"],["も"],["家畜","かちく"],["も"],["、"],["這う","はう"],["もの"],["も"],["、"],["空","そら"],["の"],["鳥","とり"],["も"],["みな"],["地","ち"],["から"],["ぬぐい去られて","ぬぐいさられて"],["、"],["ただ"],["ノア"],["と"],["、"],["彼","かれ"],["と"],["共","とも"],["に"],["箱舟","はこぶね"],["に"],["いた"],["もの"],["だけ"],["が"],["残った","のこった"],["。"]]},{"verse":24,"text":"水,みずは百五十日,にちのあいだ地上,ちじょうにみなぎった。","tok":[["水","みず"],["は"],["百五十日","にち"],["の"],["あいだ"],["地上","ちじょう"],["に"],["みなぎった"],["。"]]}]
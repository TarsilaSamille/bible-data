[{"verse":1,"text":"ノアの子,こセム、ハム、ヤペテの系図,けいずは次,つぎのとおりである。洪水,こうずいの後,のち、彼,かれらに子,こが生,うまれた。","tok":[["ノア"],["の"],["子","こ"],["セム"],["、"],["ハム"],["、"],["ヤペテ"],["の"],["系図","けいず"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["洪水","こうずい"],["の"],["後","の"],["ち"],["、"],["彼","かれ"],["ら"],["に"],["子","こ"],["が"],["生まれた","うまれた"],["。"]]},{"verse":2,"text":"ヤペテの子孫,しそんはゴメル、マゴグ、マダイ、ヤワン、トバル、メセク、テラスであった。","tok":[["ヤペテ"],["の"],["子孫","しそん"],["は"],["ゴメル"],["、"],["マゴグ"],["、"],["マダイ"],["、"],["ヤワン"],["、"],["トバル"],["、"],["メセク"],["、"],["テラス"],["で"],["あった"],["。"]]},{"verse":3,"text":"ゴメルの子孫,しそんはアシケナズ、リパテ、トガルマ。","tok":[["ゴメル"],["の"],["子孫","しそん"],["は"],["アシケナズ"],["、"],["リパテ"],["、"],["トガルマ"],["。"]]},{"verse":4,"text":"ヤワンの子孫,しそんはエリシャ、タルシシ、キッテム、ドダニムであった。","tok":[["ヤワン"],["の"],["子孫","しそん"],["は"],["エリシャ"],["、"],["タルシシ"],["、"],["キッテム"],["、"],["ドダニム"],["で"],["あった"],["。"]]},{"verse":5,"text":"これらから海沿,うみぞいの地,ちの国民,こくみんが分,わかれて、おのおのその土地,とちにおり、その言語,げんごにしたがい、その氏族,しぞくにしたがって、その国々,くにぐにに住,すんだ。","tok":[["これ"],["ら"],["から"],["海沿い","うみぞい"],["の"],["地","ち"],["の"],["国民","こくみん"],["が"],["分かれて","わかれて"],["、"],["おのおの"],["その"],["土地","とち"],["に"],["おり"],["、"],["その"],["言語","げんご"],["に"],["したがい"],["、"],["その"],["氏族","しぞく"],["に"],["したがって"],["、"],["その"],["国々","くにぐに"],["に"],["住んだ","すんだ"],["。"]]},{"verse":6,"text":"ハムの子孫,しそんはクシ、ミツライム、プテ、カナンであった。","tok":[["ハム"],["の"],["子孫","しそん"],["は"],["クシ"],["、"],["ミツライム"],["、"],["プテ"],["、"],["カナン"],["で"],["あった"],["。"]]},{"verse":7,"text":"クシの子孫,しそんはセバ、ハビラ、サブタ、ラアマ、サブテカであり、ラアマの子孫,しそんはシバとデダンであった。","tok":[["クシ"],["の"],["子孫","しそん"],["は"],["セバ"],["、"],["ハビラ"],["、"],["サブタ"],["、"],["ラアマ"],["、"],["サブテカ"],["で"],["あり"],["、"],["ラアマ"],["の"],["子孫","しそん"],["は"],["シバ"],["と"],["デダン"],["で"],["あった"],["。"]]},{"verse":8,"text":"クシの子,こはニムロデであって、このニムロデは世,よの権力者,けんりょくしゃとなった最初,さいしょの人,ひとである。","tok":[["クシ"],["の"],["子","こ"],["は"],["ニムロデ"],["で"],["あって"],["、"],["この"],["ニムロデ"],["は"],["世","よ"],["の"],["権力者","けんりょくしゃ"],["と"],["なった"],["最初","さいしょ"],["の"],["人","ひと"],["で"],["ある"],["。"]]},{"verse":9,"text":"彼,かれは主,しゅの前,まえに力,ちからある狩猟者,しゅりょうしゃであった。これから「主,しゅの前,まえに力,ちからある狩猟者,しゅりょうしゃニムロデのごとし」ということわざが起,たった。","tok":[["彼","かれ"],["は"],["主","しゅ"],["の"],["前","まえ"],["に"],["力","ちから"],["ある"],["狩猟者","しゅりょうしゃ"],["で"],["あった"],["。"],["これ"],["から"],["「"],["主","しゅ"],["の"],["前","まえ"],["に"],["力","ちから"],["ある"],["狩猟者","しゅりょうしゃ"],["ニムロデ"],["の"],["ごとし"],["」"],["と"],["いう"],["ことわざ"],["が"],["起った","たった"],["。"]]},{"verse":10,"text":"彼,かれの国,くには最初,さいしょシナルの地,ちにあるバベル、エレク、アカデ、カルネであった。","tok":[["彼","かれ"],["の"],["国","くに"],["は"],["最初","さいしょ"],["シナル"],["の"],["地","ち"],["に"],["ある"],["バベル"],["、"],["エレク"],["、"],["アカデ"],["、"],["カルネ"],["で"],["あった"],["。"]]},{"verse":11,"text":"彼,かれはその地,ちからアッスリヤに出,でて、ニネベ、レホボテイリ、カラ、","tok":[["彼","かれ"],["は"],["その"],["地","ち"],["から"],["アッスリヤ"],["に"],["出て","でて"],["、"],["ニネベ"],["、"],["レホボテイリ"],["、"],["カラ"],["、"]]},{"verse":12,"text":"およびニネベとカラとの間,あいだにある大,おおいなる町,まちレセンを建,たてた。","tok":[["および"],["ニネベ"],["と"],["カラ"],["と"],["の"],["間","あいだ"],["に"],["ある"],["大いなる","おおいなる"],["町","まち"],["レセン"],["を"],["建てた","たてた"],["。"]]},{"verse":13,"text":"ミツライムからルデ族,ぞく、アナミ族,ぞく、レハビ族,ぞく、ナフト族,ぞく、","tok":[["ミツライム"],["から"],["ルデ族","るでぞく"],["、"],["アナミ族","あなみぞく"],["、"],["レハビ族","れはびぞく"],["、"],["ナフト族","なふとぞく"],["、"]]},{"verse":14,"text":"パテロス族,ぞく、カスル族,ぞく、カフトリ族,ぞくが出,でた。カフトリ族,ぞくからペリシテ族,ぞくが出,でた。","tok":[["パテロス"],["族","ぞく"],["、"],["カスル族","かするぞく"],["、"],["カフトリ"],["族","ぞく"],["が"],["出た","でた"],["。"],["カフトリ"],["族","ぞく"],["から"],["ペリシテ"],["族","ぞく"],["が"],["出た","でた"],["。"]]},{"verse":15,"text":"カナンからその長子,ちょうしシドンが出,でて、またヘテが出,でた。","tok":[["カナン"],["から"],["その"],["長子","ちょうし"],["シドン"],["が"],["出て","でて"],["、"],["また"],["ヘテ"],["が"],["出た","でた"],["。"]]},{"verse":16,"text":"その他,たエブスびと、アモリびと、ギルガシびと、","tok":[["その"],["他","た"],["エブス"],["び"],["と"],["、"],["アモリ"],["び"],["と"],["、"],["ギルガシ"],["び"],["と"],["、"]]},{"verse":17,"text":"ヒビびと、アルキびと、セニびと、","tok":[["ヒビ"],["び"],["と"],["、"],["アルキ"],["び"],["と"],["、"],["セニ"],["び"],["と"],["、"]]},{"verse":18,"text":"アルワデびと、ゼマリびと、ハマテびとが出,でた。後,のちになってカナンびとの氏族,しぞくがひろがった。","tok":[["アルワデ"],["び"],["と"],["、"],["ゼマリ"],["び"],["と"],["、"],["ハマテ"],["びと"],["が"],["出た","でた"],["。"],["後","のち"],["に"],["なって"],["カナン"],["びと"],["の"],["氏族","しぞく"],["が"],["ひろがった"],["。"]]},{"verse":19,"text":"カナンびとの境,さかいはシドンからゲラルを経,へてガザに至,いたり、ソドム、ゴモラ、アデマ、ゼボイムを経,へて、レシャに及,およんだ。","tok":[["カナン"],["びと"],["の"],["境","さかい"],["は"],["シドン"],["から"],["ゲラル"],["を"],["経て","へて"],["ガザ"],["に"],["至","いたり"],["、"],["ソドム"],["、"],["ゴモラ"],["、"],["アデマ"],["、"],["ゼボイム"],["を"],["経て","へて"],["、"],["レシャ"],["に"],["及んだ","およんだ"],["。"]]},{"verse":20,"text":"これらはハムの子孫,しそんであって、その氏族,しぞくとその言語,げんごとにしたがって、その土地,とちと、その国々,くにぐににいた。","tok":[["これ"],["ら"],["は"],["ハム"],["の"],["子孫","しそん"],["で"],["あって"],["、"],["その"],["氏族","しぞく"],["と"],["その"],["言語","げんご"],["と"],["に"],["したがって"],["、"],["その"],["土地","とち"],["と"],["、"],["その"],["国々","くにぐに"],["に"],["いた"],["。"]]},{"verse":21,"text":"セムにも子,こが生,うまれた。セムはエベルのすべての子孫,しそんの先祖,せんぞであって、ヤペテの兄,あにであった。","tok":[["セム"],["に"],["も"],["子","こ"],["が"],["生まれた","うまれた"],["。"],["セム"],["は"],["エベル"],["の"],["すべて"],["の"],["子孫","しそん"],["の"],["先祖","せんぞ"],["で"],["あって"],["、"],["ヤペテ"],["の"],["兄","あに"],["で"],["あった"],["。"]]},{"verse":22,"text":"セムの子孫,しそんはエラム、アシュル、アルパクサデ、ルデ、アラムであった。","tok":[["セム"],["の"],["子孫","しそん"],["は"],["エラム"],["、"],["アシュル"],["、"],["アルパクサデ"],["、"],["ルデ"],["、"],["アラム"],["で"],["あった"],["。"]]},{"verse":23,"text":"アラムの子孫,しそんはウヅ、ホル、ゲテル、マシであった。","tok":[["アラム"],["の"],["子孫","しそん"],["は"],["ウヅ"],["、"],["ホル"],["、"],["ゲテル"],["、"],["マシ"],["で"],["あった"],["。"]]},{"verse":24,"text":"アルパクサデの子,こはシラ、シラの子,こはエベルである。","tok":[["アルパクサデ"],["の"],["子","こ"],["は"],["シラ"],["、"],["シラ"],["の"],["子","こ"],["は"],["エベル"],["で"],["ある"],["。"]]},{"verse":25,"text":"エベルにふたりの子,こが生,うまれた。そのひとりの名,なをペレグといった。これは彼,かれの代,よに地,ちの民,たみが分,わかれたからである。その弟,おとうとの名,なをヨクタンといった。","tok":[["エベル"],["に"],["ふたり"],["の"],["子","こ"],["が"],["生まれた","うまれた"],["。"],["その"],["ひとり"],["の"],["名","な"],["を"],["ペレグ"],["と"],["いった"],["。"],["これ"],["は"],["彼","かれ"],["の"],["代","よ"],["に"],["地","ち"],["の"],["民","たみ"],["が"],["分かれた","わかれた"],["から"],["で"],["ある"],["。"],["その"],["弟","おとうと"],["の"],["名","な"],["を"],["ヨクタン"],["と"],["いった"],["。"]]},{"verse":26,"text":"ヨクタンにアルモダデ、シャレフ、ハザルマウテ、エラ、","tok":[["ヨクタン"],["に"],["アルモダデ"],["、"],["シャレフ"],["、"],["ハザルマウテ"],["、"],["エラ"],["、"]]},{"verse":27,"text":"ハドラム、ウザル、デクラ、","tok":[["ハドラム"],["、"],["ウザル"],["、"],["デクラ"],["、"]]},{"verse":28,"text":"オバル、アビマエル、シバ、","tok":[["オバル"],["、"],["アビマエル"],["、"],["シバ"],["、"]]},{"verse":29,"text":"オフル、ハビラ、ヨバブが生,うまれた。これらは皆,みなヨクタンの子,こであった。","tok":[["オフル"],["、"],["ハビラ"],["、"],["ヨバブ"],["が"],["生まれた","うまれた"],["。"],["これ"],["ら"],["は"],["皆","みな"],["ヨクタン"],["の"],["子","こ"],["で"],["あった"],["。"]]},{"verse":30,"text":"彼,かれらが住,すんだ所,ところはメシャから東,ひがしの山地,さんちセパルに及,およんだ。","tok":[["彼","かれ"],["ら"],["が"],["住んだ","すんだ"],["所","ところ"],["は"],["メシャ"],["から"],["東","ひがし"],["の"],["山地","さんち"],["セパル"],["に"],["及んだ","およんだ"],["。"]]},{"verse":31,"text":"これらはセムの子孫,しそんであって、その氏族,しぞくとその言語,げんごとにしたがって、その土地,とちと、その国々,くにぐににいた。","tok":[["これ"],["ら"],["は"],["セム"],["の"],["子孫","しそん"],["で"],["あって"],["、"],["その"],["氏族","しぞく"],["と"],["その"],["言語","げんご"],["と"],["に"],["したがって"],["、"],["その"],["土地","とち"],["と"],["、"],["その"],["国々","くにぐに"],["に"],["いた"],["。"]]},{"verse":32,"text":"これらはノアの子,こらの氏族,しぞくであって、血統,けっとうにしたがって国々,くにぐにに住,すんでいたが、洪水,こうずいの後,のち、これらから地上,ちじょうの諸,しょ国民,こくみんが分,わかれたのである。","tok":[["これ"],["ら"],["は"],["ノア"],["の"],["子","こ"],["ら"],["の"],["氏族","しぞく"],["で"],["あって"],["、"],["血統","けっとう"],["に"],["したがって"],["国々","くにぐに"],["に"],["住んで","すんで"],["いた"],["が"],["、"],["洪水","こうずい"],["の"],["後","の"],["ち"],["、"],["これ"],["ら"],["から"],["地上","ちじょう"],["の"],["諸","しょ"],["国民","こくみん"],["が"],["分かれた","わかれた"],["ので"],["ある"],["。"]]}]
[{"verse":1,"text":"はじめに神,かみは天,てんと地,ちとを創造,そうぞうされた。","tok":[["はじめ"],["に"],["神","かみ"],["は"],["天","てん"],["と"],["地","ち"],["と"],["を"],["創造","そうぞう"],["された"],["。"]]},{"verse":2,"text":"地,ちは形,かたちなく、むなしく、やみが淵,ふちのおもてにあり、神,かみの霊,れいが水,みずのおもてをおおっていた。","tok":[["地","ち"],["は"],["形","かたち"],["なく"],["、"],["むなしく"],["、"],["やみ"],["が"],["淵","ふち"],["の"],["おもて"],["に"],["あり"],["、"],["神","かみ"],["の"],["霊","れい"],["が"],["水","みず"],["の"],["おもて"],["を"],["おおって"],["いた"],["。"]]},{"verse":3,"text":"神,かみは「光,ひかりあれ」と言,いわれた。すると光,ひかりがあった。","tok":[["神","かみ"],["は"],["「"],["光","ひかり"],["あれ"],["」"],["と"],["言われた","いわれた"],["。"],["する"],["と"],["光","ひかり"],["が"],["あった"],["。"]]},{"verse":4,"text":"神,かみはその光,ひかりを見,みて、良,よしとされた。神,かみはその光,ひかりとやみとを分,わけられた。","tok":[["神","かみ"],["は"],["その"],["光","ひかり"],["を"],["見て","みて"],["、"],["良し","よし"],["と"],["された"],["。"],["神","かみ"],["は"],["その"],["光","ひかり"],["と"],["やみ"],["と"],["を"],["分けられた","わけられた"],["。"]]},{"verse":5,"text":"神,かみは光,ひかりを昼,ひると名,なづけ、やみを夜,よると名,なづけられた。夕,ゆうとなり、また朝,あさとなった。第,だい一日,にちである。","tok":[["神","かみ"],["は"],["光","ひかり"],["を"],["昼","ひる"],["と"],["名づけ","なづけ"],["、"],["やみ"],["を"],["夜","よる"],["と"],["名づけられた","なづけられた"],["。"],["夕","ゆう"],["と"],["なり"],["、"],["また"],["朝","あさ"],["と"],["なった"],["。"],["第","だい"],["一","いち"],["日","にち"],["ち"],["で"],["ある"],["。"]]},{"verse":6,"text":"神,かみはまた言,いわれた、「水,みずの間,あいだにおおぞらがあって、水,みずと水,みずとを分,わけよ」。","tok":[["神","かみ"],["は"],["また"],["言われた","いわれた"],["、"],["「"],["水","みず"],["の"],["間","あいだ"],["に"],["おおぞら"],["が"],["あって"],["、"],["水","みず"],["と"],["水","みず"],["と"],["を"],["分けよ","わけよ"],["」"],["。"]]},{"verse":7,"text":"そのようになった。神,かみはおおぞらを造,つくって、おおぞらの下,したの水,みずとおおぞらの上,うえの水,みずとを分,わけられた。","tok":[["その"],["よう"],["に"],["なった"],["。"],["神","かみ"],["は"],["おおぞら"],["を"],["造って","つくって"],["、"],["おおぞら"],["の"],["下","した"],["の"],["水","みず"],["と"],["おおぞら"],["の"],["上","うえ"],["の"],["水","みず"],["と"],["を"],["分けられた","わけられた"],["。"]]},{"verse":8,"text":"神,かみはそのおおぞらを天,てんと名,なづけられた。夕,ゆうとなり、また朝,あさとなった。第,だい二日,にちである。","tok":[["神","かみ"],["は"],["その"],["おおぞら"],["を"],["天","てん"],["と"],["名づけられた","なづけられた"],["。"],["夕","ゆう"],["と"],["なり"],["、"],["また"],["朝","あさ"],["と"],["なった"],["。"],["第","だい"],["二","に"],["日","にち"],["ち"],["で"],["ある"],["。"]]},{"verse":9,"text":"神,かみはまた言,いわれた、「天,てんの下,したの水,みずは一つ所,ところに集,あつまり、かわいた地,ちが現,あらわれよ」。そのようになった。","tok":[["神","かみ"],["は"],["また"],["言われた","いわれた"],["、"],["「"],["天","てん"],["の"],["下","した"],["の"],["水","みず"],["は"],["一","ひと"],["つ"],["所","ところ"],["に"],["集まり","あつまり"],["、"],["かわいた"],["地","ち"],["が"],["現われよ","あらわれよ"],["」"],["。"],["その"],["よう"],["に"],["なった"],["。"]]},{"verse":10,"text":"神,かみはそのかわいた地,ちを陸,りくと名,なづけ、水,みずの集,あつまった所,ところを海,うみと名,なづけられた。神,かみは見,みて、良,よしとされた。","tok":[["神","かみ"],["は"],["その"],["かわいた"],["地","ち"],["を"],["陸","りく"],["と"],["名づけ","なづけ"],["、"],["水","みず"],["の"],["集まった","あつまった"],["所","ところ"],["を"],["海","うみ"],["と"],["名づけられた","なづけられた"],["。"],["神","かみ"],["は"],["見て","みて"],["、"],["良し","よし"],["と"],["された"],["。"]]},{"verse":11,"text":"神,かみはまた言,いわれた、「地,ちは青草,あおくさと、種,たねをもつ草,くさと、種類,しゅるいにしたがって種,たねのある実,みを結,むすぶ果樹,かじゅとを地,ちの上,うえにはえさせよ」。そのようになった。","tok":[["神","かみ"],["は"],["また"],["言われた","いわれた"],["、"],["「"],["地","ち"],["は"],["青草","あおくさ"],["と"],["、"],["種","たね"],["を"],["もつ"],["草","くさ"],["と"],["、"],["種類","しゅるい"],["に"],["したがって"],["種","たね"],["の"],["ある"],["実","み"],["を"],["結ぶ","むすぶ"],["果樹","かじゅ"],["と"],["を"],["地","ち"],["の"],["上","うえ"],["に"],["は"],["えさ"],["せよ"],["」"],["。"],["その"],["よう"],["に"],["なった"],["。"]]},{"verse":12,"text":"地,ちは青草,あおくさと、種類,しゅるいにしたがって種,たねをもつ草,くさと、種類,しゅるいにしたがって種,たねのある実,みを結,むすぶ木,きとをはえさせた。神,かみは見,みて、良,よしとされた。","tok":[["地","ち"],["は"],["青草","あおくさ"],["と"],["、"],["種類","しゅるい"],["に"],["したがって"],["種","たね"],["を"],["もつ"],["草","くさ"],["と"],["、"],["種類","しゅるい"],["に"],["したがって"],["種","たね"],["の"],["ある"],["実","み"],["を"],["結ぶ","むすぶ"],["木","き"],["と"],["を"],["はえさせた"],["。"],["神","かみ"],["は"],["見て","みて"],["、"],["良し","よし"],["と"],["された"],["。"]]},{"verse":13,"text":"夕,ゆうとなり、また朝,あさとなった。第,だい三日,にちである。","tok":[["夕","ゆう"],["と"],["なり"],["、"],["また"],["朝","あさ"],["と"],["なった"],["。"],["第","だい"],["三日","に"],["ち"],["で"],["ある"],["。"]]},{"verse":14,"text":"神,かみはまた言,いわれた、「天,てんのおおぞらに光,ひかりがあって昼,ひると夜,よるとを分,わけ、しるしのため、季節,きせつのため、日,ひのため、年,としのためになり、","tok":[["神","かみ"],["は"],["また"],["言われた","いわれた"],["、"],["「"],["天","てん"],["の"],["おおぞら"],["に"],["光","ひかり"],["が"],["あって"],["昼","ひる"],["と"],["夜","よる"],["と"],["を"],["分け","わけ"],["、"],["しるし"],["の"],["ため"],["、"],["季節","きせつ"],["の"],["ため"],["、"],["日","ひ"],["の"],["ため"],["、"],["年","とし"],["の"],["ため"],["に"],["なり"],["、"]]},{"verse":15,"text":"天,てんのおおぞらにあって地,ちを照,てらす光,ひかりとなれ」。そのようになった。","tok":[["天","てん"],["の"],["おおぞら"],["に"],["あって"],["地","ち"],["を"],["照らす","てらす"],["光","ひかり"],["と"],["なれ"],["」"],["。"],["その"],["よう"],["に"],["なった"],["。"]]},{"verse":16,"text":"神,かみは二つの大,おおきな光,ひかりを造,つくり、大,おおきい光,ひかりに昼,ひるをつかさどらせ、小,ちいさい光,ひかりに夜,よるをつかさどらせ、また星,ほしを造,つくられた。","tok":[["神","かみ"],["は"],["二","ふた"],["つ"],["の"],["大きな","おおきな"],["光","ひかり"],["を"],["造","つくり"],["、"],["大きい","おおきい"],["光","ひかり"],["に"],["昼","ひる"],["を"],["つかさどらせ"],["、"],["小さい","ちいさい"],["光","ひかり"],["に"],["夜","よる"],["を"],["つかさどらせ"],["、"],["また"],["星","ほし"],["を"],["造られた","つくられた"],["。"]]},{"verse":17,"text":"神,かみはこれらを天,てんのおおぞらに置,おいて地,ちを照,てらさせ、","tok":[["神","かみ"],["は"],["これ"],["ら"],["を"],["天","てん"],["の"],["おおぞら"],["に"],["置いて","おいて"],["地","ち"],["を"],["照らさせ","てらさせ"],["、"]]},{"verse":18,"text":"昼,ひると夜,よるとをつかさどらせ、光,ひかりとやみとを分,わけさせられた。神,かみは見,みて、良,よしとされた。","tok":[["昼","ひる"],["と"],["夜","よる"],["と"],["を"],["つかさどらせ"],["、"],["光","ひかり"],["と"],["やみ"],["と"],["を"],["分けさせられた","わけさせられた"],["。"],["神","かみ"],["は"],["見て","みて"],["、"],["良し","よし"],["と"],["された"],["。"]]},{"verse":19,"text":"夕,ゆうとなり、また朝,あさとなった。第,だい四日,にちである。","tok":[["夕","ゆう"],["と"],["なり"],["、"],["また"],["朝","あさ"],["と"],["なった"],["。"],["第","だい"],["四日","に"],["ち"],["で"],["ある"],["。"]]},{"verse":20,"text":"神,かみはまた言,いわれた、「水,みずは生,いき物,ものの群,むれで満,みち、鳥,とりは地,ちの上,うえ、天,てんのおおぞらを飛,とべ」。","tok":[["神","かみ"],["は"],["また"],["言われた","いわれた"],["、"],["「"],["水","みず"],["は"],["生き物","いきもの"],["の"],["群れ","むれ"],["で"],["満ち","みち"],["、"],["鳥","とり"],["は"],["地","ち"],["の"],["上","うえ"],["、"],["天","てん"],["の"],["おおぞら"],["を"],["飛べ","とべ"],["」"],["。"]]},{"verse":21,"text":"神,かみは海,うみの大,おおいなる獣,けものと、水,みずに群,むらがるすべての動,うごく生,いき物,ものとを、種類,しゅるいにしたがって創造,そうぞうし、また翼,つばさのあるすべての鳥,とりを、種類,しゅるいにしたがって創造,そうぞうされた。神,かみは見,みて、良,よしとされた。","tok":[["神","かみ"],["は"],["海","うみ"],["の"],["大いなる","おおいなる"],["獣","けもの"],["と"],["、"],["水","みず"],["に"],["群らがる","むらがる"],["すべて"],["の"],["動く","うごく"],["生き物","いきもの"],["と"],["を"],["、"],["種類","しゅるい"],["に"],["したがって"],["創造","そうぞう"],["し"],["、"],["また"],["翼","つばさ"],["の"],["ある"],["すべて"],["の"],["鳥","とり"],["を"],["、"],["種類","しゅるい"],["に"],["したがって"],["創造","そうぞう"],["された"],["。"],["神","かみ"],["は"],["見て","みて"],["、"],["良し","よし"],["と"],["された"],["。"]]},{"verse":22,"text":"神,かみはこれらを祝福,しゅくふくして言,いわれた、「生,うめよ、ふえよ、海,うみの水,みずに満,みちよ、また鳥,とりは地,ちにふえよ」。","tok":[["神","かみ"],["は"],["これ"],["ら"],["を"],["祝福","しゅくふく"],["して"],["言われた","いわれた"],["、"],["「"],["生めよ","うめよ"],["、"],["ふえ"],["よ"],["、"],["海","うみ"],["の"],["水","みず"],["に"],["満ちよ","みちよ"],["、"],["また"],["鳥","とり"],["は"],["地","ち"],["に"],["ふえ"],["よ"],["」"],["。"]]},{"verse":23,"text":"夕,ゆうとなり、また朝,あさとなった。第,だい五日,にちである。","tok":[["夕","ゆう"],["と"],["なり"],["、"],["また"],["朝","あさ"],["と"],["なった"],["。"],["第","だい"],["五日","に"],["ち"],["で"],["ある"],["。"]]},{"verse":24,"text":"神,かみはまた言,いわれた、「地,ちは生,いき物,ものを種類,しゅるいにしたがっていだせ。家畜,かちくと、這,はうものと、地,ちの獣,けものとを種類,しゅるいにしたがっていだせ」。そのようになった。","tok":[["神","かみ"],["は"],["また"],["言われた","いわれた"],["、"],["「"],["地","ち"],["は"],["生き物","いきもの"],["を"],["種類","しゅるい"],["に"],["したがって"],["いだせ"],["。"],["家畜","かちく"],["と"],["、"],["這う","はう"],["もの"],["と"],["、"],["地","ち"],["の"],["獣","けもの"],["と"],["を"],["種類","しゅるい"],["に"],["したがって"],["いだせ"],["」"],["。"],["その"],["よう"],["に"],["なった"],["。"]]},{"verse":25,"text":"神,かみは地,ちの獣,けものを種類,しゅるいにしたがい、家畜,かちくを種類,しゅるいにしたがい、また地,ちに這,はうすべての物,ものを種類,しゅるいにしたがって造,つくられた。神,かみは見,みて、良,よしとされた。","tok":[["神","かみ"],["は"],["地","ち"],["の"],["獣","けもの"],["を"],["種類","しゅるい"],["に"],["したがい"],["、"],["家畜","かちく"],["を"],["種類","しゅるい"],["に"],["したがい"],["、"],["また"],["地","ち"],["に"],["這う","はう"],["すべて"],["の"],["物","もの"],["を"],["種類","しゅるい"],["に"],["したがって"],["造られた","つくられた"],["。"],["神","かみ"],["は"],["見て","みて"],["、"],["良し","よし"],["と"],["された"],["。"]]},{"verse":26,"text":"神,かみはまた言,いわれた、「われわれのかたちに、われわれにかたどって人,ひとを造,つくり、これに海,うみの魚,うおと、空,そらの鳥,とりと、家畜,かちくと、地,ちのすべての獣,けものと、地,ちのすべての這,はうものとを治,おさめさせよう」。","tok":[["神","かみ"],["は"],["また"],["言われた","いわれた"],["、"],["「"],["われわれ"],["の"],["かたち"],["に"],["、"],["われわれ"],["に"],["かたどって"],["人","ひと"],["を"],["造","つくり"],["、"],["これ"],["に"],["海","うみ"],["の"],["魚","うお"],["と"],["、"],["空","そら"],["の"],["鳥","とり"],["と"],["、"],["家畜","かちく"],["と"],["、"],["地","ち"],["の"],["すべて"],["の"],["獣","けもの"],["と"],["、"],["地","ち"],["の"],["すべて"],["の"],["這う","はう"],["もの"],["と"],["を"],["治めさせよう","おさめさせよう"],["」"],["。"]]},{"verse":27,"text":"神,かみは自分,じぶんのかたちに人,ひとを創造,そうぞうされた。すなわち、神,かみのかたちに創造,そうぞうし、男,おとこと女,おんなとに創造,そうぞうされた。","tok":[["神","かみ"],["は"],["自分","じぶん"],["の"],["かたち"],["に"],["人","ひと"],["を"],["創造","そうぞう"],["された"],["。"],["すなわち"],["、"],["神","かみ"],["の"],["かたち"],["に"],["創造","そうぞう"],["し"],["、"],["男","おとこ"],["と"],["女","おんな"],["と"],["に"],["創造","そうぞう"],["された"],["。"]]},{"verse":28,"text":"神,かみは彼,かれらを祝福,しゅくふくして言,いわれた、「生,うめよ、ふえよ、地,ちに満,みちよ、地,ちを従,したがわせよ。また海,うみの魚,うおと、空,そらの鳥,とりと、地,ちに動,うごくすべての生,いき物,ものとを治,おさめよ」。","tok":[["神","かみ"],["は"],["彼","かれ"],["ら"],["を"],["祝福","しゅくふく"],["して"],["言われた","いわれた"],["、"],["「"],["生めよ","うめよ"],["、"],["ふえ"],["よ"],["、"],["地","ち"],["に"],["満ちよ","みちよ"],["、"],["地","ち"],["を"],["従わせ","したがわせ"],["よ"],["。"],["また"],["海","うみ"],["の"],["魚","うお"],["と"],["、"],["空","そら"],["の"],["鳥","とり"],["と"],["、"],["地","ち"],["に"],["動く","うごく"],["すべて"],["の"],["生き物","いきもの"],["と"],["を"],["治めよ","おさめよ"],["」"],["。"]]},{"verse":29,"text":"神,かみはまた言,いわれた、「わたしは全,ぜん地,ちのおもてにある種,たねをもつすべての草,くさと、種,たねのある実,みを結,むすぶすべての木,きとをあなたがたに与,あたえる。これはあなたがたの食物,しょくもつとなるであろう。","tok":[["神","かみ"],["は"],["また"],["言われた","いわれた"],["、"],["「"],["わたし"],["は"],["全地","ぜんち"],["の"],["おもて"],["に"],["ある"],["種","たね"],["を"],["もつ"],["すべて"],["の"],["草","くさ"],["と"],["、"],["種","たね"],["の"],["ある"],["実","み"],["を"],["結ぶ","むすぶ"],["すべて"],["の"],["木","き"],["と"],["を"],["あなた"],["がた"],["に"],["与える","あたえる"],["。"],["これ"],["は"],["あなた"],["がた"],["の"],["食物","しょくもつ"],["と"],["なるで"],["あろう"],["。"]]},{"verse":30,"text":"また地,ちのすべての獣,けもの、空,そらのすべての鳥,とり、地,ちを這,はうすべてのもの、すなわち命,いのちあるものには、食物,しょくもつとしてすべての青草,あおくさを与,あたえる」。そのようになった。","tok":[["また"],["地","ち"],["の"],["すべて"],["の"],["獣","けもの"],["、"],["空","そら"],["の"],["すべて"],["の"],["鳥","とり"],["、"],["地","ち"],["を"],["這う","はう"],["すべて"],["の"],["もの"],["、"],["すなわち"],["命","いのち"],["ある"],["もの"],["に"],["は"],["、"],["食物","しょくもつ"],["として"],["すべて"],["の"],["青草","あおくさ"],["を"],["与える","あたえる"],["」"],["。"],["その"],["よう"],["に"],["なった"],["。"]]},{"verse":31,"text":"神,かみが造,つくったすべての物,ものを見,みられたところ、それは、はなはだ良,よかった。夕,ゆうとなり、また朝,あさとなった。第,だい六日,にちである。","tok":[["神","かみ"],["が"],["造った","つくった"],["すべて"],["の"],["物","もの"],["を"],["見られた","みられた"],["ところ"],["、"],["それ"],["は"],["、"],["はなはだ"],["良かった","よかった"],["。"],["夕","ゆう"],["と"],["なり"],["、"],["また"],["朝","あさ"],["と"],["なった"],["。"],["第","だい"],["六","ろく"],["日","にち"],["ち"],["で"],["ある"],["。"]]}]
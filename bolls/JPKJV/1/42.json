[{"verse":1,"text":"ヤコブはエジプトに穀物,こくもつがあると知,しって、むすこたちに言,いった、「あなたがたはなぜ顔,かおを見合,みあわせているのですか」。","tok":[["ヤコブ"],["は"],["エジプト"],["に"],["穀物","こくもつ"],["が"],["ある"],["と"],["知って","しって"],["、"],["むすこ"],["たち"],["に"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["なぜ"],["顔","かお"],["を"],["見合わせて","みあわせて"],["いる"],["の"],["です"],["か"],["」"],["。"]]},{"verse":2,"text":"また言,いった、「エジプトに穀物,こくもつがあるということだが、あなたがたはそこへ下,くだって行,いって、そこから、われわれのため穀物,こくもつを買,かってきなさい。そうすれば、われわれは生,いきながらえて、死,しを免,まぬかれるであろう」。","tok":[["また"],["言った","いった"],["、"],["「"],["エジプト"],["に"],["穀物","こくもつ"],["が"],["ある"],["と"],["いう"],["こと"],["だ"],["が"],["、"],["あなた"],["がた"],["は"],["そこ"],["へ"],["下って","くだって"],["行って","いって"],["、"],["そこ"],["から"],["、"],["われわれ"],["の"],["ため"],["穀物","こくもつ"],["を"],["買って","かって"],["き"],["なさい"],["。"],["そう"],["すれば"],["、"],["われわれ"],["は"],["生きながらえて","いきながらえて"],["、"],["死","し"],["を"],["免かれるで","まぬかれるで"],["あろう"],["」"],["。"]]},{"verse":3,"text":"そこでヨセフの十人,にんの兄弟,きょうだいは穀物,こくもつを買,かうためにエジプトへ下,くだった。","tok":[["そこ"],["で"],["ヨセフ"],["の"],["十人","にん"],["の"],["兄弟","きょうだい"],["は"],["穀物","こくもつ"],["を"],["買う","かう"],["ため"],["に"],["エジプト"],["へ"],["下った","くだった"],["。"]]},{"verse":4,"text":"しかし、ヤコブはヨセフの弟,おとうとベニヤミンを兄弟,きょうだいたちと一緒,いっしょにやらなかった。彼,かれが災,わざわいに会,あうのを恐,おそれたからである。","tok":[["しかし"],["、"],["ヤコブ"],["は"],["ヨセフ"],["の"],["弟","おとうと"],["ベニヤミン"],["を"],["兄弟","きょうだい"],["たち"],["と"],["一緒","いっしょ"],["に"],["やらなかった"],["。"],["彼","かれ"],["が"],["災","わざわい"],["に"],["会う","あう"],["の"],["を"],["恐","おそれ"],["たから"],["で"],["ある"],["。"]]},{"verse":5,"text":"こうしてイスラエルの子,こらは穀物,こくもつを買,かおうと人々,ひとびとに交,まじってやってきた。カナンの地,ちにききんがあったからである。","tok":[["こう"],["して"],["イスラエル"],["の"],["子","こ"],["ら"],["は"],["穀物","こくもつ"],["を"],["買おう","かおう"],["と"],["人々","ひとびと"],["に"],["交じって","まじって"],["やって"],["きた"],["。"],["カナン"],["の"],["地","ち"],["に"],["ききん"],["が"],["あった"],["から"],["で"],["ある"],["。"]]},{"verse":6,"text":"ときにヨセフは国,くにのつかさであって、国,くにのすべての民,たみに穀物,こくもつを売,うることをしていた。ヨセフの兄弟,きょうだいたちはきて、地,ちにひれ伏,ふし、彼,かれを拝,はいした。","tok":[["とき"],["に"],["ヨセフ"],["は"],["国","くに"],["の"],["つかさ"],["で"],["あって"],["、"],["国","くに"],["の"],["すべて"],["の"],["民","たみ"],["に"],["穀物","こくもつ"],["を"],["売る","うる"],["こと"],["を"],["して"],["いた"],["。"],["ヨセフ"],["の"],["兄弟","きょうだい"],["たち"],["は"],["きて"],["、"],["地","ち"],["に"],["ひれ伏し","ひれふし"],["、"],["彼","かれ"],["を"],["拝した","はいした"],["。"]]},{"verse":7,"text":"ヨセフは兄弟,きょうだいたちを見,みて、それと知,しったが、彼,かれらに向,むかっては知,しらぬ者,もののようにし、荒々,あらあらしく語,かたった。すなわち彼,かれらに言,いった、「あなたがたはどこからきたのか」。彼,かれらは答,こたえた、「食糧,しょくりょうを買,かうためにカナンの地,ちからきました」。","tok":[["ヨセフ"],["は"],["兄弟","きょうだい"],["たち"],["を"],["見て","みて"],["、"],["それ"],["と"],["知った","しった"],["が"],["、"],["彼","かれ"],["ら"],["に"],["向かって","むかって"],["は"],["知らぬ","しらぬ"],["者","もの"],["の"],["よう"],["に"],["し"],["、"],["荒々しく","あらあらしく"],["語った","かたった"],["。"],["すなわち"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["どこ"],["から"],["きた"],["の"],["か"],["」"],["。"],["彼","かれ"],["ら"],["は"],["答","こたえ"],["た"],["、"],["「"],["食糧","しょくりょう"],["を"],["買う","かう"],["ため"],["に"],["カナン"],["の"],["地","ち"],["から"],["きました"],["」"],["。"]]},{"verse":8,"text":"ヨセフは、兄弟,きょうだいたちであるのを知,しっていたが、彼,かれらはヨセフとは知,しらなかった。","tok":[["ヨセフ"],["は"],["、"],["兄弟","きょうだい"],["たち"],["で"],["ある"],["の"],["を"],["知って","しって"],["いた"],["が"],["、"],["彼","かれ"],["ら"],["は"],["ヨセフ"],["と"],["は"],["知らなかった","しらなかった"],["。"]]},{"verse":9,"text":"ヨセフはかつて彼,かれらについて見,みた夢,ゆめを思,おもい出,だして、彼,かれらに言,いった、「あなたがたは回,まわし者,もので、この国,くにのすきをうかがうためにきたのです」。","tok":[["ヨセフ"],["は"],["かつて"],["彼","かれ"],["ら"],["について"],["見た","みた"],["夢","ゆめ"],["を"],["思い出して","おもいだして"],["、"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["回わし","まわし"],["者","もの"],["で"],["、"],["この"],["国","くに"],["の"],["すき"],["を"],["うかがう"],["ため"],["に"],["きた"],["の"],["です"],["」"],["。"]]},{"verse":10,"text":"彼,かれらはヨセフに答,こたえた、「いいえ、わが主,しゅよ、しもべらはただ食糧,しょくりょうを買,かうためにきたのです。","tok":[["彼","かれ"],["ら"],["は"],["ヨセフ"],["に"],["答","こたえ"],["た"],["、"],["「"],["いいえ"],["、"],["わが"],["主","しゅ"],["よ"],["、"],["しもべ"],["ら"],["は"],["ただ"],["食糧","しょくりょう"],["を"],["買う","かう"],["ため"],["に"],["きた"],["の"],["です"],["。"]]},{"verse":11,"text":"われわれは皆,みな、ひとりの人,ひとの子,こで、真実,しんじつな者,ものです。しもべらは回,まわし者,ものではありません」。","tok":[["われわれ"],["は"],["皆","みな"],["、"],["ひとり"],["の"],["人","ひと"],["の"],["子","こ"],["で"],["、"],["真実","しんじつ"],["な"],["者","もの"],["です"],["。"],["しもべ"],["ら"],["は"],["回わし","まわし"],["者","もの"],["で"],["は"],["ありません"],["」"],["。"]]},{"verse":12,"text":"ヨセフは彼,かれらに言,いった、「いや、あなたがたはこの国,くにのすきをうかがうためにきたのです」。","tok":[["ヨセフ"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["いや"],["、"],["あなた"],["がた"],["は"],["この"],["国","くに"],["の"],["すき"],["を"],["うかがう"],["ため"],["に"],["きた"],["の"],["です"],["」"],["。"]]},{"verse":13,"text":"彼,かれらは言,いった、「しもべらは十二人,にん兄弟,きょうだいで、カナンの地,ちにいるひとりの人,ひとの子,こです。末,すえの弟,おとうとは今,いま、父,ちちと一緒,いっしょにいますが、他,たのひとりはいなくなりました」。","tok":[["彼","かれ"],["ら"],["は"],["言った","いった"],["、"],["「"],["しもべ"],["ら"],["は"],["十二人","にん"],["兄弟","きょうだい"],["で"],["、"],["カナン"],["の"],["地","ち"],["に"],["いる"],["ひとり"],["の"],["人","ひと"],["の"],["子","こ"],["です"],["。"],["末","すえ"],["の"],["弟","おとうと"],["は"],["今","いま"],["、"],["父","ちち"],["と"],["一緒","いっしょ"],["に"],["います"],["が"],["、"],["他","た"],["の"],["ひとり"],["は"],["いなく"],["なりました"],["」"],["。"]]},{"verse":14,"text":"ヨセフは彼,かれらに言,いった、「わたしが言,いったとおり、あなたがたは回,まわし者,ものです。","tok":[["ヨセフ"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["わたし"],["が"],["言った","いった"],["とおり"],["、"],["あなた"],["がた"],["は"],["回わし","まわし"],["者","もの"],["です"],["。"]]},{"verse":15,"text":"あなたがたをこうしてためしてみよう。パロのいのちにかけて誓,ちかいます。末,すえの弟,おとうとがここにこなければ、あなたがたはここを出,でることはできません。","tok":[["あなた"],["がた"],["を"],["こう"],["して"],["ためして"],["みよう"],["。"],["パロ"],["の"],["いのち"],["に"],["かけて"],["誓います","ちかいます"],["。"],["末","すえ"],["の"],["弟","おとうと"],["が"],["ここ"],["に"],["こなければ"],["、"],["あなた"],["がた"],["は"],["ここ"],["を"],["出る","でる"],["こと"],["は"],["できません"],["。"]]},{"verse":16,"text":"あなたがたのひとりをやって弟,おとうとを連,つれてこさせなさい。それまであなたがたをつないでおいて、あなたがたに誠実,せいじつがあるかどうか、あなたがたの言葉,ことばをためしてみよう。パロのいのちにかけて誓,ちかいます。あなたがたは確,たしかに回,まわし者,ものです」。","tok":[["あなた"],["がた"],["の"],["ひとり"],["を"],["やって"],["弟","おとうと"],["を"],["連れて","つれて"],["こさせ"],["なさい"],["。"],["それ"],["まで"],["あなた"],["がた"],["を"],["つないで"],["おいて"],["、"],["あなた"],["がた"],["に"],["誠実","せいじつ"],["が"],["ある"],["か"],["どう"],["か"],["、"],["あなた"],["がた"],["の"],["言葉","ことば"],["を"],["ためして"],["みよう"],["。"],["パロ"],["の"],["いのち"],["に"],["かけて"],["誓います","ちかいます"],["。"],["あなた"],["がた"],["は"],["確か","たしか"],["に"],["回わし","まわし"],["者","もの"],["です"],["」"],["。"]]},{"verse":17,"text":"ヨセフは彼,かれらをみな一緒,いっしょに三日,かの間,あいだ、監禁所,かんきんじょに入,いれた。","tok":[["ヨセフ"],["は"],["彼","かれ"],["ら"],["を"],["みな"],["一緒","いっしょ"],["に"],["三日","か"],["の"],["間","あいだ"],["、"],["監禁所","かんきんじょ"],["に"],["入れた","いれた"],["。"]]},{"verse":18,"text":"三日,か目,めにヨセフは彼,かれらに言,いった、「こうすればあなたがたは助,たすかるでしょう。わたしは神,かみを恐,おそれます。","tok":[["三日目","かめ"],["に"],["ヨセフ"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["こう"],["すれば"],["あなた"],["がた"],["は"],["助かるでしょう","たすかるでしょう"],["。"],["わたし"],["は"],["神","かみ"],["を"],["恐れます","おそれます"],["。"]]},{"verse":19,"text":"もしあなたがたが真実,しんじつな者,ものなら、兄弟,きょうだいのひとりをあなたがたのいる監禁所,かんきんじょに残,のこし、あなたがたは穀物,こくもつを携,たずさえて行,いって、家族,かぞくの飢,うえを救,すくいなさい。","tok":[["もし"],["あなた"],["がた"],["が"],["真実","しんじつ"],["な"],["者","もの"],["なら"],["、"],["兄弟","きょうだい"],["の"],["ひとり"],["を"],["あなた"],["がた"],["の"],["いる"],["監禁所","かんきんじょ"],["に"],["残し","のこし"],["、"],["あなた"],["がた"],["は"],["穀物","こくもつ"],["を"],["携えて","たずさえて"],["行って","いって"],["、"],["家族","かぞく"],["の"],["飢","うえ"],["を"],["救い","すくい"],["なさい"],["。"]]},{"verse":20,"text":"そして末,すえの弟,おとうとをわたしのもとに連,つれてきなさい。そうすればあなたがたの言葉,ことばのほんとうであることがわかって、死,しを免,まぬかれるでしょう」。彼,かれらはそのようにした。","tok":[["そして"],["末","すえ"],["の"],["弟","おとうと"],["を"],["わたし"],["の"],["もと"],["に"],["連れて","つれて"],["き"],["なさい"],["。"],["そう"],["すれば"],["あなた"],["がた"],["の"],["言葉","ことば"],["の"],["ほんとう"],["で"],["ある"],["こと"],["が"],["わかって"],["、"],["死","し"],["を"],["免かれるでしょう","まぬかれるでしょう"],["」"],["。"],["彼","かれ"],["ら"],["は"],["その"],["よう"],["に"],["した"],["。"]]},{"verse":21,"text":"彼,かれらは互,たがいに言,いった、「確,たしかにわれわれは弟,おとうとの事,ことで罪,つみがある。彼,かれがしきりに願,ねがった時,とき、その心,こころの苦,くるしみを見,みながら、われわれは聞,きき入,いれなかった。それでこの苦,くるしみに会,あうのだ」。","tok":[["彼","かれ"],["ら"],["は"],["互","たがい"],["に"],["言った","いった"],["、"],["「"],["確か","たしか"],["に"],["われわれ"],["は"],["弟","おとうと"],["の"],["事","こと"],["で"],["罪","つみ"],["が"],["ある"],["。"],["彼","かれ"],["が"],["しきり"],["に"],["願った","ねがった"],["時","とき"],["、"],["その"],["心","こころ"],["の"],["苦しみ","くるしみ"],["を"],["見","み"],["ながら"],["、"],["われわれ"],["は"],["聞入れなかった","ききいれなかった"],["。"],["それ"],["で"],["この"],["苦しみ","くるしみ"],["に"],["会う","あう"],["の"],["だ"],["」"],["。"]]},{"verse":22,"text":"ルベンが彼,かれらに答,こたえて言,いった、「わたしはあなたがたに、この子供,こどもに罪,つみを犯,おかすなと言,いったではないか。それにもかかわらず、あなたがたは聞,きき入,いれなかった。それで彼,かれの血,ちの報,むくいを受,うけるのです」。","tok":[["ルベン"],["が"],["彼","かれ"],["ら"],["に"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["わたし"],["は"],["あなた"],["がた"],["に"],["、"],["この"],["子供","こども"],["に"],["罪","つみ"],["を"],["犯す","おかす"],["な"],["と"],["言ったで","いったで"],["は"],["ない"],["か"],["。"],["それ"],["に"],["も"],["かかわらず"],["、"],["あなた"],["がた"],["は"],["聞入れなかった","ききいれなかった"],["。"],["それ"],["で"],["彼","かれ"],["の"],["血","ち"],["の"],["報い","むくい"],["を"],["受る","うける"],["の"],["です"],["」"],["。"]]},{"verse":23,"text":"彼,かれらはヨセフが聞,ききわけているのを知,しらなかった。相互,そうごの間,あいだに通訳者,つうやくしゃがいたからである。","tok":[["彼","かれ"],["ら"],["は"],["ヨセフ"],["が"],["聞","きき"],["わけて"],["いる"],["の"],["を"],["知らなかった","しらなかった"],["。"],["相互","そうご"],["の"],["間","あいだ"],["に"],["通訳者","つうやくしゃ"],["が"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":24,"text":"ヨセフは彼,かれらを離,はなれて行,いって泣,なき、また帰,かえってきて彼,かれらと語,かたり、そのひとりシメオンを捕,とらえて、彼,かれらの目,めの前,まえで縛,しばった。","tok":[["ヨセフ"],["は"],["彼","かれ"],["ら"],["を"],["離れて","はなれて"],["行って","いって"],["泣","なき"],["、"],["また"],["帰えって","かえって"],["きて"],["彼","かれ"],["ら"],["と"],["語り","かたり"],["、"],["その"],["ひとり"],["シメオン"],["を"],["捕らえて","とらえて"],["、"],["彼","かれ"],["ら"],["の"],["目","め"],["の"],["前","まえ"],["で"],["縛った","しばった"],["。"]]},{"verse":25,"text":"そしてヨセフは人々,ひとびとに命,めいじて、彼,かれらの袋,ふくろに穀物,こくもつを満,みたし、めいめいの銀,ぎんを袋,ふくろに返,かえし、道中,どうちゅうの食料,しょくりょうを与,あたえさせた。ヨセフはこのように彼,かれらにした。","tok":[["そして"],["ヨセフ"],["は"],["人々","ひとびと"],["に"],["命じて","めいじて"],["、"],["彼","かれ"],["ら"],["の"],["袋","ふくろ"],["に"],["穀物","こくもつ"],["を"],["満たし","みたし"],["、"],["めいめい"],["の"],["銀","ぎん"],["を"],["袋","ふくろ"],["に"],["返","かえし"],["、"],["道中","どうちゅう"],["の"],["食料","しょくりょう"],["を"],["与えさせた","あたえさせた"],["。"],["ヨセフ"],["は"],["この"],["よう"],["に"],["彼","かれ"],["ら"],["に"],["した"],["。"]]},{"verse":26,"text":"彼,かれらは穀物,こくもつをろばに負,おわせてそこを去,さった。","tok":[["彼","かれ"],["ら"],["は"],["穀物","こくもつ"],["を"],["ろば"],["に"],["負わせて","おわせて"],["そこ"],["を"],["去た","さった"],["。"]]},{"verse":27,"text":"そのひとりが宿,やどで、ろばに飼葉,かいばをやるため袋,ふくろをあけて見,みると、袋,ふくろの口,くちに自分,じぶんの銀,ぎんがあった。","tok":[["その"],["ひとり"],["が"],["宿","やど"],["で"],["、"],["ろば"],["に"],["飼葉","かいば"],["を"],["やる"],["ため"],["袋","ふくろ"],["を"],["あけて"],["見る","みる"],["と"],["、"],["袋","ふくろ"],["の"],["口","くち"],["に"],["自分","じぶん"],["の"],["銀","ぎん"],["が"],["あった"],["。"]]},{"verse":28,"text":"彼,かれは兄弟,きょうだいたちに言,いった、「わたしの銀,ぎんは返,かえしてある。しかも見,みよ、それは袋,ふくろの中,なかにある」。そこで彼,かれらは非常,ひじょうに驚,おどろき、互,たがいに震,ふるえながら言,いった、「神,かみがわれわれにされたこのことは何事,なにごとだろう」。","tok":[["彼","かれ"],["は"],["兄弟","きょうだい"],["たち"],["に"],["言った","いった"],["、"],["「"],["わたし"],["の"],["銀","ぎん"],["は"],["返","かえし"],["て"],["ある"],["。"],["しかも"],["見よ","みよ"],["、"],["それ"],["は"],["袋","ふくろ"],["の"],["中","なか"],["に"],["ある"],["」"],["。"],["そこ"],["で"],["彼","かれ"],["ら"],["は"],["非常","ひじょう"],["に"],["驚","おどろき"],["、"],["互","たがい"],["に"],["震え","ふるえ"],["ながら"],["言った","いった"],["、"],["「"],["神","かみ"],["が"],["われわれ"],["に"],["された"],["この"],["こと"],["は"],["何事","なにごと"],["だろう"],["」"],["。"]]},{"verse":29,"text":"こうして彼,かれらはカナンの地,ちにいる父,ちちヤコブのもとに帰,かえり、その身,みに起,たった事,ことをことごとく告,つげて言,いった、","tok":[["こう"],["して"],["彼","かれ"],["ら"],["は"],["カナン"],["の"],["地","ち"],["に"],["いる"],["父","ちち"],["ヤコブ"],["の"],["もと"],["に"],["帰えり","かえり"],["、"],["その"],["身","み"],["に"],["起った","たった"],["事","こと"],["を"],["ことごとく"],["告","つげ"],["て"],["言った","いった"],["、"]]},{"verse":30,"text":"「あの国,くにの君,きみは、われわれに荒々,あらあらしく語,かたり、国,くにをうかがう回,まわし者,ものだと言,いいました。","tok":[["「"],["あの"],["国","くに"],["の"],["君","きみ"],["は"],["、"],["われわれ"],["に"],["荒々しく","あらあらしく"],["語り","かたり"],["、"],["国","くに"],["を"],["うかがう"],["回わし","まわし"],["者","もの"],["だ"],["と"],["言いました","いいました"],["。"]]},{"verse":31,"text":"われわれは彼,かれに答,こたえました、『われわれは真実,しんじつな者,ものであって回,まわし者,ものではない。","tok":[["われわれ"],["は"],["彼","かれ"],["に"],["答","こたえ"],["ました"],["、"],["『"],["われわれ"],["は"],["真実","しんじつ"],["な"],["者","もの"],["で"],["あって"],["回わし","まわし"],["者","もの"],["で"],["は"],["ない"],["。"]]},{"verse":32,"text":"われわれは十二人,にん兄弟,きょうだいで、同,おなじ父,ちちの子,こである。ひとりはいなくなり、末,すえの弟,おとうとは今,いま父,ちちと共,ともにカナンの地,ちにいる』。","tok":[["われわれ"],["は"],["十二人","にん"],["兄弟","きょうだい"],["で"],["、"],["同じ","おなじ"],["父","ちち"],["の"],["子","こ"],["で"],["ある"],["。"],["ひとり"],["は"],["いなく"],["なり"],["、"],["末","すえ"],["の"],["弟","おとうと"],["は"],["今","いま"],["父","ちち"],["と"],["共","とも"],["に"],["カナン"],["の"],["地","ち"],["に"],["いる"],["』"],["。"]]},{"verse":33,"text":"その国,くにの君,きみであるその人,ひとはわれわれに言,いいました、『わたしはこうしてあなたがたの真実,しんじつな者,ものであるのを知,しろう。あなたがたは兄弟,きょうだいのひとりをわたしのもとに残,のこし、穀物,こくもつを携,たずさえて行,いって、家族,かぞくの飢,うえを救,すくいなさい。","tok":[["その"],["国","くに"],["の"],["君","きみ"],["で"],["ある"],["その"],["人","ひと"],["は"],["われわれ"],["に"],["言いました","いいました"],["、"],["『"],["わたし"],["は"],["こう"],["して"],["あなた"],["がた"],["の"],["真実","しんじつ"],["な"],["者","もの"],["で"],["ある"],["の"],["を"],["知ろう","しろう"],["。"],["あなた"],["がた"],["は"],["兄弟","きょうだい"],["の"],["ひとり"],["を"],["わたし"],["の"],["もと"],["に"],["残し","のこし"],["、"],["穀物","こくもつ"],["を"],["携えて","たずさえて"],["行って","いって"],["、"],["家族","かぞく"],["の"],["飢","うえ"],["を"],["救い","すくい"],["なさい"],["。"]]},{"verse":34,"text":"そして末,すえの弟,おとうとをわたしのもとに連,つれてきなさい。そうすればあなたがたが回,まわし者,ものではなく、真実,しんじつな者,ものであるのを知,しって、あなたがたの兄弟,きょうだいを返,かえし、この国,くにであなたがたに取引,とりひきさせましょう』」。","tok":[["そして"],["末","すえ"],["の"],["弟","おとうと"],["を"],["わたし"],["の"],["もと"],["に"],["連れて","つれて"],["き"],["なさい"],["。"],["そう"],["すれば"],["あなた"],["がた"],["が"],["回わし","まわし"],["者","もの"],["で"],["は"],["なく"],["、"],["真実","しんじつ"],["な"],["者","もの"],["で"],["ある"],["の"],["を"],["知って","しって"],["、"],["あなた"],["がた"],["の"],["兄弟","きょうだい"],["を"],["返","かえし"],["、"],["この"],["国","くに"],["で"],["あなた"],["がた"],["に"],["取引","とりひき"],["させましょう"],["』"],["」"],["。"]]},{"verse":35,"text":"彼,かれらが袋,ふくろのものを出,だして見,みると、めいめいの金,かね包,つつみが袋,ふくろの中,なかにあったので、彼,かれらも父,ちちも金,かね包,つつみを見,みて恐,おそれた。","tok":[["彼","かれ"],["ら"],["が"],["袋","ふくろ"],["の"],["もの"],["を"],["出して","だして"],["見る","みる"],["と"],["、"],["めいめい"],["の"],["金","か"],["ね"],["包","つつみ"],["が"],["袋","ふくろ"],["の"],["中","なか"],["に"],["あった"],["ので"],["、"],["彼","かれ"],["ら"],["も"],["父","ちち"],["も"],["金","か"],["ね"],["包","つつみ"],["を"],["見て","みて"],["恐れた","おそれた"],["。"]]},{"verse":36,"text":"父,ちちヤコブは彼,かれらに言,いった、「あなたがたはわたしに子,こを失,うしなわせた。ヨセフはいなくなり、シメオンもいなくなった。今度,こんどはベニヤミンをも取,とり去,さる。これらはみなわたしの身,みにふりかかって来,くるのだ」。","tok":[["父","ちち"],["ヤコブ"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["わたし"],["に"],["子","こ"],["を"],["失なわせた","うしなわせた"],["。"],["ヨセフ"],["は"],["いなく"],["なり"],["、"],["シメオン"],["も"],["いなく"],["なった"],["。"],["今度","こんど"],["は"],["ベニヤミン"],["を"],["も"],["取去る","とりさる"],["。"],["これ"],["ら"],["は"],["みな"],["わたし"],["の"],["身","み"],["に"],["ふりかかって"],["来る","くる"],["の"],["だ"],["」"],["。"]]},{"verse":37,"text":"ルベンは父,ちちに言,いった、「もしわたしが彼,かれをあなたのもとに連,つれて帰,かえらなかったら、わたしのふたりの子,こを殺,ころしてください。ただ彼,かれをわたしの手,てにまかせてください。わたしはきっと、あなたのもとに彼,かれを連,つれて帰,かえります」。","tok":[["ルベン"],["は"],["父","ちち"],["に"],["言った","いった"],["、"],["「"],["もし"],["わたし"],["が"],["彼","かれ"],["を"],["あなた"],["の"],["もと"],["に"],["連れて","つれて"],["帰えらなかったら","かえらなかったら"],["、"],["わたし"],["の"],["ふたり"],["の"],["子","こ"],["を"],["殺ろして","ころして"],["ください"],["。"],["ただ"],["彼","かれ"],["を"],["わたし"],["の"],["手","て"],["に"],["まかせて"],["ください"],["。"],["わたし"],["は"],["きっと"],["、"],["あなた"],["の"],["もと"],["に"],["彼","かれ"],["を"],["連れて","つれて"],["帰えります","かえります"],["」"],["。"]]},{"verse":38,"text":"ヤコブは言,いった、「わたしの子,こはあなたがたと共,ともに下,くだって行,いってはならない。彼,かれの兄,あには死,しに、ただひとり彼,かれが残,のこっているのだから。もしあなたがたの行,いく道,みちで彼,かれが災,わざわいに会,あえば、あなたがたは、しらがのわたしを悲,かなしんで陰府,よみに下,くだらせるであろう」。","tok":[["ヤコブ"],["は"],["言った","いった"],["、"],["「"],["わたし"],["の"],["子","こ"],["は"],["あなた"],["がた"],["と"],["共","とも"],["に"],["下って","くだって"],["行って","いって"],["は"],["ならない"],["。"],["彼","かれ"],["の"],["兄","あに"],["は"],["死に","しに"],["、"],["ただ"],["ひとり"],["彼","かれ"],["が"],["残って","のこって"],["いる"],["の"],["だ"],["から"],["。"],["もし"],["あなた"],["がた"],["の"],["行く","いく"],["道","みち"],["で"],["彼","かれ"],["が"],["災","わざわい"],["に"],["会えば","あえば"],["、"],["あなた"],["がた"],["は"],["、"],["しらが"],["の"],["わたし"],["を"],["悲しんで","かなしんで"],["陰府","よみ"],["に"],["下らせるで","くだらせるで"],["あろう"],["」"],["。"]]}]
[{"verse":1,"text":"そのふたりのみ使,つかいは夕暮,ゆうぐれにソドムに着,ついた。そのときロトはソドムの門,もんにすわっていた。ロトは彼,かれらを見,みて、立,たって迎,むかえ、地,ちに伏,ふして、","tok":[["その"],["ふたり"],["のみ"],["使い","つかい"],["は"],["夕暮","ゆうぐれ"],["に"],["ソドム"],["に"],["着いた","ついた"],["。"],["その"],["とき"],["ロト"],["は"],["ソドム"],["の"],["門","もん"],["に"],["すわって"],["いた"],["。"],["ロト"],["は"],["彼","かれ"],["ら"],["を"],["見て","みて"],["、"],["立って","たって"],["迎","むかえ"],["、"],["地","ち"],["に"],["伏して","ふして"],["、"]]},{"verse":2,"text":"言,いった、「わが主,しゅよ、どうぞしもべの家,いえに立寄,たちよって足,あしを洗,あらい、お泊,とまりください。そして朝,あさ早,はやく起,おきてお立,たちください」。彼,かれらは言,いった、「いや、われわれは広場,ひろばで夜,よを過,すごします」。","tok":[["言った","いった"],["、"],["「"],["わが"],["主","しゅ"],["よ"],["、"],["どうぞ"],["しもべ"],["の"],["家","いえ"],["に"],["立寄って","たちよって"],["足","あし"],["を"],["洗","あらい"],["、"],["お泊まり","おとまり"],["ください"],["。"],["そして"],["朝","あさ"],["早く","はやく"],["起きて","おきて"],["お立","おたち"],["ください"],["」"],["。"],["彼","かれ"],["ら"],["は"],["言った","いった"],["、"],["「"],["いや"],["、"],["われわれ"],["は"],["広場","ひろば"],["で"],["夜","よ"],["を"],["過ごします","すごします"],["」"],["。"]]},{"verse":3,"text":"しかしロトがしいて勧,すすめたので、彼,かれらはついに彼,かれの所,ところに寄,より、家,いえにはいった。ロトは彼,かれらのためにふるまいを設,もうけ、種,たね入,いれぬパンを焼,やいて食,たべさせた。","tok":[["しかし"],["ロト"],["が"],["しいて"],["勧めた","すすめた"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["ついに"],["彼","かれ"],["の"],["所","ところ"],["に"],["寄り","より"],["、"],["家","いえ"],["に"],["はいった"],["。"],["ロト"],["は"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["ふるまい"],["を"],["設け","もうけ"],["、"],["種","た"],["ね"],["入れぬ","いれぬ"],["パン"],["を"],["焼いて","やいて"],["食べさせた","たべさせた"],["。"]]},{"verse":4,"text":"ところが彼,かれらの寝,ねないうちに、ソドムの町,まちの人々,ひとびとは、若,わかい者,ものも老人,ろうじんも、民,たみがみな四方,しほうからきて、その家,いえを囲,かこみ、","tok":[["ところ"],["が"],["彼","かれ"],["ら"],["の"],["寝ない","ねない"],["うち"],["に"],["、"],["ソドム"],["の"],["町","まち"],["の"],["人々","ひとびと"],["は"],["、"],["若い","わかい"],["者","もの"],["も"],["老人","ろうじん"],["も"],["、"],["民","た"],["み"],["が"],["みな"],["四方","しほう"],["から"],["きて"],["、"],["その"],["家","いえ"],["を"],["囲み","かこみ"],["、"]]},{"verse":5,"text":"ロトに叫,さけんで言,いった、「今夜,こんやおまえの所,ところにきた人々,ひとびとはどこにいるか。それをここに出,だしなさい。われわれは彼,かれらを知,しるであろう」。","tok":[["ロト"],["に"],["叫けんで","さけんで"],["言った","いった"],["、"],["「"],["今夜","こんや"],["おまえ"],["の"],["所","ところ"],["に"],["きた"],["人々","ひとびと"],["は"],["どこ"],["に"],["いる"],["か"],["。"],["それ"],["を"],["ここ"],["に"],["出し","だし"],["なさい"],["。"],["われわれ"],["は"],["彼","かれ"],["ら"],["を"],["知るで","しるで"],["あろう"],["」"],["。"]]},{"verse":6,"text":"ロトは入口,いりぐちにおる彼,かれらの所,ところに出,でて行,いき、うしろの戸,とを閉,とじて、","tok":[["ロト"],["は"],["入口","いりぐち"],["に"],["おる"],["彼","かれ"],["ら"],["の"],["所","ところ"],["に"],["出て","でて"],["行き","いき"],["、"],["うしろ"],["の"],["戸","と"],["を"],["閉じて","とじて"],["、"]]},{"verse":7,"text":"言,いった、「兄弟,きょうだいたちよ、どうか悪,わるい事,ことはしないでください。","tok":[["言った","いった"],["、"],["「"],["兄弟","きょうだい"],["たち"],["よ"],["、"],["どう"],["か"],["悪い","わるい"],["事","こと"],["は"],["しないで"],["ください"],["。"]]},{"verse":8,"text":"わたしにまだ男,おとこを知,しらない娘,むすめがふたりあります。わたしはこれをあなたがたに、さし出,だしますから、好,すきなようにしてください。ただ、わたしの屋根,やねの下,したにはいったこの人,ひとたちには、何,なにもしないでください」。","tok":[["わたし"],["に"],["まだ"],["男","おとこ"],["を"],["知らない","しらない"],["娘","むすめ"],["が"],["ふたり"],["あります"],["。"],["わたし"],["は"],["これ"],["を"],["あなた"],["がた"],["に"],["、"],["さし出します","さしだします"],["から"],["、"],["好き","すき"],["な"],["よう"],["に"],["して"],["ください"],["。"],["ただ"],["、"],["わたし"],["の"],["屋根","やね"],["の"],["下","した"],["に"],["はいった"],["この"],["人","ひと"],["たち"],["に"],["は"],["、"],["何に","なに"],["も"],["しないで"],["ください"],["」"],["。"]]},{"verse":9,"text":"彼,かれらは言,いった、「退,しりぞけ」。また言,いった、「この男,おとこは渡,わたってきたよそ者,ものであるのに、いつも、さばきびとになろうとする。それで、われわれは彼,かれらに加,くわえるよりも、おまえに多,おおくの害,がいを加,くわえよう」。彼,かれらはロトの身,みに激,はげしく迫,せまり、進,すすみ寄,よって戸,とを破,やぶろうとした。","tok":[["彼","かれ"],["ら"],["は"],["言った","いった"],["、"],["「"],["退ぞけ","しりぞけ"],["」"],["。"],["また"],["言った","いった"],["、"],["「"],["この"],["男","おとこ"],["は"],["渡って","わたって"],["きた"],["よそ者","よそもの"],["で"],["ある"],["のに"],["、"],["いつも"],["、"],["さばき"],["びと"],["に"],["なろう"],["と"],["する"],["。"],["それ"],["で"],["、"],["われわれ"],["は"],["彼","かれ"],["ら"],["に"],["加える","くわえる"],["より"],["も"],["、"],["おまえ"],["に"],["多く","おおく"],["の"],["害","がい"],["を"],["加えよう","くわえよう"],["」"],["。"],["彼","かれ"],["ら"],["は"],["ロト"],["の"],["身","み"],["に"],["激しく","はげしく"],["迫まり","せまり"],["、"],["進み寄って","すすみよって"],["戸","と"],["を"],["破ろう","やぶろう"],["と"],["した"],["。"]]},{"verse":10,"text":"その時,とき、かのふたりは手,てを伸,のべてロトを家,いえの内,うちに引,ひき入,いれ、戸,とを閉,とじた。","tok":[["その"],["時","とき"],["、"],["かの"],["ふたり"],["は"],["手","て"],["を"],["伸べて","のべて"],["ロト"],["を"],["家","いえ"],["の"],["内","うち"],["に"],["引入れ","ひきいれ"],["、"],["戸","と"],["を"],["閉じた","とじた"],["。"]]},{"verse":11,"text":"そして家,いえの入口,いりぐちにおる人々,ひとびとを、老若,ろうにゃくの別,べつなく打,うって目,めをくらましたので、彼,かれらは入口,いりぐちを捜,さがすのに疲,つかれた。","tok":[["そして"],["家","いえ"],["の"],["入口","いりぐち"],["に"],["おる"],["人々","ひとびと"],["を"],["、"],["老若","ろうにゃく"],["の"],["別","べつ"],["なく"],["打って","うって"],["目","め"],["を"],["くらました"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["入口","いりぐち"],["を"],["捜す","さがす"],["のに"],["疲れた","つかれた"],["。"]]},{"verse":12,"text":"ふたりはロトに言,いった、「ほかにあなたの身内,みうちの者,ものがここにおりますか。あなたのむこ、むすこ、娘,むすめおよびこの町,まちにおるあなたの身内,みうちの者,ものを、皆,みなここから連,つれ出,だしなさい。","tok":[["ふたり"],["は"],["ロト"],["に"],["言った","いった"],["、"],["「"],["ほか"],["に"],["あなた"],["の"],["身内","みうち"],["の"],["者","もの"],["が"],["ここ"],["に"],["おります"],["か"],["。"],["あなた"],["の"],["むこ"],["、"],["むすこ"],["、"],["娘","むすめ"],["および"],["この"],["町","まち"],["に"],["おる"],["あなた"],["の"],["身内","みうち"],["の"],["者","もの"],["を"],["、"],["皆","みな"],["ここ"],["から"],["連れ出し","つれだし"],["なさい"],["。"]]},{"verse":13,"text":"われわれがこの所,ところを滅,ほろぼそうとしているからです。人々,ひとびとの叫,さけびが主,しゅの前,まえに大,おおきくなり、主,しゅはこの所,ところを滅,ほろぼすために、われわれをつかわされたのです」。","tok":[["われわれ"],["が"],["この"],["所","ところ"],["を"],["滅ぼそう","ほろぼそう"],["として"],["いる"],["から"],["です"],["。"],["人々","ひとびと"],["の"],["叫","さけび"],["が"],["主","しゅ"],["の"],["前","まえ"],["に"],["大きく","おおきく"],["なり"],["、"],["主","しゅ"],["は"],["この"],["所","ところ"],["を"],["滅ぼす","ほろぼす"],["ため"],["に"],["、"],["われわれ"],["を"],["つかわされた"],["の"],["です"],["」"],["。"]]},{"verse":14,"text":"そこでロトは出,でて行,いって、その娘,むすめたちをめとるむこたちに告,つげて言,いった、「立,たってこの所,ところから出,でなさい。主,しゅがこの町,まちを滅,ほろぼされます」。しかしそれはむこたちには戯,たわむむれごとに思,おもえた。","tok":[["そこ"],["で"],["ロト"],["は"],["出て","でて"],["行って","いって"],["、"],["その"],["娘","むすめ"],["たち"],["を"],["めとる"],["むこ"],["たち"],["に"],["告","つげ"],["て"],["言った","いった"],["、"],["「"],["立って","たって"],["この"],["所","ところ"],["から"],["出","で"],["なさい"],["。"],["主","しゅがこ"],["の"],["町","まち"],["を"],["滅ぼされます","ほろぼされます"],["」"],["。"],["しかし"],["それ"],["は"],["むこ"],["たち"],["に"],["は"],["戯","た"],["わ"],["むむ"],["れ"],["ごと"],["に"],["思た","おもえた"],["。"]]},{"verse":15,"text":"夜,よが明,あけて、み使,つかいたちはロトを促,うながして言,いった 「立,たって、ここにいるあなたの妻,つまとふたりの娘,むすめとを連,つれ出,だしなさい。そうしなければ、あなたもこの町,まちの不義,ふぎのために滅,ほろぼされるでしょう」。","tok":[["夜","よ"],["が"],["明けて","あけて"],["、"],["み使","みつかい"],["たち"],["は"],["ロト"],["を"],["促がして","うながして"],["言った","いった"],[" "],["「"],["立って","たって"],["、"],["ここ"],["に"],["いる"],["あなた"],["の"],["妻","つま"],["と"],["ふたり"],["の"],["娘","むすめ"],["と"],["を"],["連れ出し","つれだし"],["なさい"],["。"],["そう"],["しなければ"],["、"],["あなた"],["も"],["この"],["町","まち"],["の"],["不義","ふぎ"],["の"],["ため"],["に"],["滅ぼされるでしょう","ほろぼされるでしょう"],["」"],["。"]]},{"verse":16,"text":"彼,かれはためらっていたが、主,しゅは彼,かれにあわれみを施,ほどこされたので、かのふたりは彼,かれの手,てと、その妻,つまの手,てと、ふたりの娘,むすめの手,てを取,とって連,つれ出,だし、町,まちの外,そとに置,おいた。","tok":[["彼","かれ"],["は"],["ためらって"],["いた"],["が"],["、"],["主","しゅ"],["は"],["彼","かれ"],["に"],["あわれみ"],["を"],["施された","ほどこされた"],["ので"],["、"],["かの"],["ふたり"],["は"],["彼","かれ"],["の"],["手","て"],["と"],["、"],["その"],["妻","つま"],["の"],["手","て"],["と"],["、"],["ふたり"],["の"],["娘","むすめ"],["の"],["手","て"],["を"],["取って","とって"],["連れ出し","つれだし"],["、"],["町","まち"],["の"],["外","そと"],["に"],["置いた","おいた"],["。"]]},{"verse":17,"text":"彼,かれらを外,そとに連,つれ出,だした時,ときそのひとりは言,いった、「のがれて、自分,じぶんの命,いのちを救,すくいなさい。うしろをふりかえって見,みてはならない。低地,ていちにはどこにも立,たち止,どまってはならない。山,やまにのがれなさい。そうしなければ、あなたは滅,ほろびます」。","tok":[["彼","かれ"],["ら"],["を"],["外","そと"],["に"],["連れ出した","つれだした"],["時","とき"],["その"],["ひとり"],["は"],["言った","いった"],["、"],["「"],["のがれて"],["、"],["自分","じぶん"],["の"],["命","いのち"],["を"],["救い","すくい"],["なさい"],["。"],["うしろ"],["を"],["ふりかえって"],["見て","みて"],["は"],["ならない"],["。"],["低地","ていち"],["に"],["は"],["どこ"],["に"],["も"],["立ち止まって","たちどまって"],["は"],["ならない"],["。"],["山","やま"],["に"],["のがれ"],["なさい"],["。"],["そう"],["しなければ"],["、"],["あなた"],["は"],["滅びます","ほろびます"],["」"],["。"]]},{"verse":18,"text":"ロトは彼,かれらに言,いった、「わが主,しゅよ、どうか、そうさせないでください。","tok":[["ロト"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["わが"],["主","しゅ"],["よ"],["、"],["どう"],["か"],["、"],["そう"],["させないで"],["ください"],["。"]]},{"verse":19,"text":"しもべはすでにあなたの前,まえに恵,めぐみを得,えました。あなたはわたしの命,いのちを救,すくって、大,おおいなるいつくしみを施,ほどこされました。しかしわたしは山,やままではのがれる事,ことができません。災,わざわいが身,みに追,おい迫,せまってわたしは死,しぬでしょう。","tok":[["しもべ"],["は"],["すでに"],["あなた"],["の"],["前","まえ"],["に"],["恵","めぐみ"],["を"],["得ました","えました"],["。"],["あなた"],["は"],["わたし"],["の"],["命","いのち"],["を"],["救って","すくって"],["、"],["大いなる","おおいなる"],["いつくしみ"],["を"],["施されました","ほどこされました"],["。"],["しかし"],["わたし"],["は"],["山","やま"],["まで"],["は"],["のがれる"],["事","こと"],["が"],["できません"],["。"],["災","わざわい"],["が"],["身","み"],["に"],["追い","おい"],["迫まって","せまって"],["わたし"],["は"],["死ぬでしょう","しぬでしょう"],["。"]]},{"verse":20,"text":"あの町,まちをごらんなさい。逃,にげていくのに近,ちかく、また小,ちいさい町,まちです。どうかわたしをそこにのがれさせてください。それは小,ちいさいではありませんか。そうすればわたしの命,いのちは助,たすかるでしょう」。","tok":[["あの"],["町","まち"],["を"],["ごらん"],["なさい"],["。"],["逃て","にげて"],["いく"],["のに"],["近く","ちかく"],["、"],["また"],["小さい","ちいさい"],["町","まち"],["です"],["。"],["どう"],["か"],["わたし"],["を"],["そこ"],["に"],["のがれさせて"],["ください"],["。"],["それ"],["は"],["小さいで","ちいさいで"],["は"],["ありません"],["か"],["。"],["そう"],["すれば"],["わたし"],["の"],["命","いのち"],["は"],["助かるでしょう","たすかるでしょう"],["」"],["。"]]},{"verse":21,"text":"み使,つかいは彼,かれに言,いった、「わたしはこの事,ことでもあなたの願,ねがいをいれて、あなたの言,いうその町,まちは滅,ほろぼしません。","tok":[["み使い","みつかい"],["は"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["わたし"],["は"],["この"],["事","こと"],["で"],["も"],["あなた"],["の"],["願い","ねがい"],["を"],["いれて"],["、"],["あなた"],["の"],["言う","いう"],["その"],["町","まち"],["は"],["滅ぼしません","ほろぼしません"],["。"]]},{"verse":22,"text":"急,いそいでそこへのがれなさい。あなたがそこに着,つくまでは、わたしは何事,なにごともすることができません」。これによって、その町,まちの名,なはゾアルと呼,よばれた。","tok":[["急いで","いそいで"],["そこ"],["へ"],["のがれ"],["なさい"],["。"],["あなた"],["が"],["そこ"],["に"],["着く","つく"],["まで"],["は"],["、"],["わたし"],["は"],["何事","なにごと"],["も"],["する"],["こと"],["が"],["できません"],["」"],["。"],["これ"],["によって"],["、"],["その"],["町","まち"],["の"],["名","な"],["は"],["ゾアル"],["と"],["呼ばれた","よばれた"],["。"]]},{"verse":23,"text":"ロトがゾアルに着,ついた時,とき、日,ひは地,ちの上,うえにのぼった。","tok":[["ロト"],["が"],["ゾアル"],["に"],["着いた","ついた"],["時","とき"],["、"],["日","ひ"],["は"],["地","ち"],["の"],["上","うえ"],["に"],["のぼった"],["。"]]},{"verse":24,"text":"主,しゅは硫黄,いおうと火,ひとを主,しゅの所,ところすなわち天,てんからソドムとゴモラの上,うえに降,ふらせて、","tok":[["主","しゅ"],["は"],["硫黄","いおう"],["と"],["火","ひ"],["と"],["を"],["主","しゅ"],["の"],["所","ところ"],["すなわち"],["天","てん"],["から"],["ソドム"],["と"],["ゴモラ"],["の"],["上","うえ"],["に"],["降らせて","ふらせて"],["、"]]},{"verse":25,"text":"これらの町,まちと、すべての低地,ていちと、その町々,まちまちのすべての住民,じゅうみんと、その地,ちにはえている物,ものを、ことごとく滅,ほろぼされた。","tok":[["これ"],["ら"],["の"],["町","まち"],["と"],["、"],["すべて"],["の"],["低地","ていち"],["と"],["、"],["その"],["町々","まちまち"],["の"],["すべて"],["の"],["住民","じゅうみん"],["と"],["、"],["その"],["地","ち"],["に"],["はえて"],["いる"],["物","もの"],["を"],["、"],["ことごとく"],["滅ぼされた","ほろぼされた"],["。"]]},{"verse":26,"text":"しかしロトの妻,つまはうしろを顧,かえりみたので塩,しおの柱,はしらになった。","tok":[["しかし"],["ロト"],["の"],["妻","つま"],["は"],["うしろ"],["を"],["顧た","かえりみた"],["ので"],["塩","しお"],["の"],["柱","はしら"],["に"],["なった"],["。"]]},{"verse":27,"text":"アブラハムは朝,あさ早,はやく起,おき、さきに主,しゅの前,まえに立,たった所,ところに行,いって、","tok":[["アブラハム"],["は"],["朝","あさ"],["早く","はやく"],["起き","おき"],["、"],["さき"],["に"],["主","しゅ"],["の"],["前","まえ"],["に"],["立った","たった"],["所","ところ"],["に"],["行って","いって"],["、"]]},{"verse":28,"text":"ソドムとゴモラの方,ほう、および低地,ていちの全面,ぜんめんをながめると、その地,ちの煙,けむりが、かまどの煙,けむりのように立,たちのぼっていた。","tok":[["ソドム"],["と"],["ゴモラ"],["の"],["方","ほう"],["、"],["および"],["低地","ていち"],["の"],["全面","ぜんめん"],["を"],["ながめる"],["と"],["、"],["その"],["地","ち"],["の"],["煙","けむり"],["が"],["、"],["かまど"],["の"],["煙","けむり"],["の"],["よう"],["に"],["立ちのぼって","たちのぼって"],["いた"],["。"]]},{"verse":29,"text":"こうして神,かみが低地,ていちの町々,まちまちをこぼたれた時,とき、すなわちロトの住,すんでいた町々,まちまちを滅,ほろぼされた時,とき、神,かみはアブラハムを覚,おぼえて、その滅,ほろびの中,なかからロトを救,すくい出,だされた。","tok":[["こう"],["して"],["神","かみ"],["が"],["低地","ていち"],["の"],["町々","まちまち"],["を"],["こ"],["ぼた"],["れた"],["時","とき"],["、"],["すなわち"],["ロト"],["の"],["住んで","すんで"],["いた"],["町々","まちまち"],["を"],["滅ぼされた","ほろぼされた"],["時","とき"],["、"],["神","かみ"],["は"],["アブラハム"],["を"],["覚えて","おぼえて"],["、"],["その"],["滅び","ほろび"],["の"],["中","なか"],["から"],["ロト"],["を"],["救い出された","すくいだされた"],["。"]]},{"verse":30,"text":"ロトはゾアルを出,でて上,のぼり、ふたりの娘,むすめと共,ともに山,やまに住,すんだ。ゾアルに住,すむのを恐,おそれたからである。彼,かれはふたりの娘,むすめと共,ともに、ほら穴,あなの中,なかに住,すんだ。","tok":[["ロト"],["は"],["ゾアル"],["を"],["出て","でて"],["上り","のぼり"],["、"],["ふたり"],["の"],["娘","むすめ"],["と"],["共","とも"],["に"],["山","やま"],["に"],["住んだ","すんだ"],["。"],["ゾアル"],["に"],["住む","すむ"],["の"],["を"],["恐","おそれ"],["たから"],["で"],["ある"],["。"],["彼","かれ"],["は"],["ふたり"],["の"],["娘","むすめ"],["と"],["共","とも"],["に"],["、"],["ほら穴","ほらあな"],["の"],["中","なか"],["に"],["住んだ","すんだ"],["。"]]},{"verse":31,"text":"時,ときに姉,あねが妹,いもうとに言,いった、「わたしたちの父,ちちは老,おい、またこの地,ちには世,よのならわしのように、わたしたちの所,ところに来,くる男,おとこはいません。","tok":[["時","とき"],["に"],["姉","あね"],["が"],["妹","いもうと"],["に"],["言った","いった"],["、"],["「"],["わたしたち"],["の"],["父","ちち"],["は"],["老","おい"],["、"],["また"],["この"],["地","ち"],["に"],["は"],["世","よ"],["の"],["ならわし"],["の"],["よう"],["に"],["、"],["わたしたち"],["の"],["所","ところ"],["に"],["来る","くる"],["男","おとこ"],["は"],["いません"],["。"]]},{"verse":32,"text":"さあ、父,ちちに酒,さけを飲,のませ、共,ともに寝,ねて、父,ちちによって子,こを残,のこしましょう」。","tok":[["さあ"],["、"],["父","ちち"],["に"],["酒","さけ"],["を"],["飲ませ","のませ"],["、"],["共","とも"],["に"],["寝て","ねて"],["、"],["父","ちち"],["によって"],["子","こ"],["を"],["残しましょう","のこしましょう"],["」"],["。"]]},{"verse":33,"text":"彼女,かのじょたちはその夜,よ、父,ちちに酒,さけを飲,のませ、姉,あねがはいって父,ちちと共,ともに寝,ねた。ロトは娘,むすめが寝,ねたのも、起,おきたのも知,しらなかった。","tok":[["彼女","かのじょ"],["たち"],["は"],["その"],["夜","よ"],["、"],["父","ちち"],["に"],["酒","さけ"],["を"],["飲ませ","のませ"],["、"],["姉","あね"],["が"],["はい"],["って"],["父","ちち"],["と"],["共","とも"],["に"],["寝た","ねた"],["。"],["ロト"],["は"],["娘","むすめ"],["が"],["寝た","ねた"],["の"],["も"],["、"],["起きた","おきた"],["の"],["も"],["知らなかった","しらなかった"],["。"]]},{"verse":34,"text":"あくる日,ひ、姉,あねは妹,いもうとに言,いった、「わたしは昨夜,さくや、父,ちちと寝,ねました。わたしたちは今夜,こんやもまた父,ちちに酒,さけを飲,のませましょう。そしてあなたがはいって共,ともに寝,ねなさい。わたしたちは父,ちちによって子,こを残,のこしましょう」。","tok":[["あくる日","あくるひ"],["、"],["姉","あね"],["は"],["妹","いもうと"],["に"],["言った","いった"],["、"],["「"],["わたし"],["は"],["昨夜","さくや"],["、"],["父","ちち"],["と"],["寝ました","ねました"],["。"],["わたしたち"],["は"],["今夜","こんや"],["も"],["また"],["父","ちち"],["に"],["酒","さけ"],["を"],["飲ませましょう","のませましょう"],["。"],["そして"],["あなた"],["が"],["はい"],["って"],["共","とも"],["に"],["寝","ね"],["なさい"],["。"],["わたしたち"],["は"],["父","ちち"],["によって"],["子","こ"],["を"],["残しましょう","のこしましょう"],["」"],["。"]]},{"verse":35,"text":"彼,かれらはその夜,よもまた父,ちちに酒,さけを飲,のませ、妹,いもうとが行,いって父,ちちと共,ともに寝,ねた。ロトは娘,むすめの寝,ねたのも、起,おきたのも知,しらなかった。","tok":[["彼","かれ"],["ら"],["は"],["その"],["夜","よ"],["も"],["また"],["父","ちち"],["に"],["酒","さけ"],["を"],["飲ませ","のませ"],["、"],["妹","いもうと"],["が"],["行って","いって"],["父","ちち"],["と"],["共","とも"],["に"],["寝た","ねた"],["。"],["ロト"],["は"],["娘","むすめ"],["の"],["寝た","ねた"],["の"],["も"],["、"],["起きた","おきた"],["の"],["も"],["知らなかった","しらなかった"],["。"]]},{"verse":36,"text":"こうしてロトのふたりの娘,むすめたちは父,ちちによってはらんだ。","tok":[["こう"],["して"],["ロト"],["の"],["ふたり"],["の"],["娘","むすめ"],["たち"],["は"],["父","ちち"],["によって"],["はらんだ"],["。"]]},{"verse":37,"text":"姉,あね娘,むすめは子,こを産,うみ、その名,なをモアブと名,なづけた。これは今,いまのモアブびとの先祖,せんぞである。","tok":[["姉娘","あねむすめ"],["は"],["子","こ"],["を"],["産み","うみ"],["、"],["その"],["名","な"],["を"],["モアブ"],["と"],["名づけた","なづけた"],["。"],["これ"],["は"],["今","いま"],["の"],["モアブ"],["びと"],["の"],["先祖","せんぞ"],["で"],["ある"],["。"]]},{"verse":38,"text":"妹,いもうともまた子,こを産,うんで、その名,なをベニアンミと名,なづけた。これは今,いまのアンモンびとの先祖,せんぞである。","tok":[["妹","いもうと"],["も"],["また子","またこ"],["を"],["産んで","うんで"],["、"],["その"],["名","な"],["を"],["ベニアンミ"],["と"],["名づけた","なづけた"],["。"],["これ"],["は"],["今","いま"],["の"],["アンモン"],["びと"],["の"],["先祖","せんぞ"],["で"],["ある"],["。"]]}]
[{"verse":1,"text":"これらの事,ことの後,のち、神,かみはアブラハムを試,こころみて彼,かれに言,いわれた、「アブラハムよ」。彼,かれは言,いった、「ここにおります」。","tok":[["これ"],["ら"],["の"],["事","こと"],["の"],["後","の"],["ち"],["、"],["神","かみ"],["は"],["アブラハム"],["を"],["試みて","こころみて"],["彼","かれ"],["に"],["言われた","いわれた"],["、"],["「"],["アブラハム"],["よ"],["」"],["。"],["彼","かれ"],["は"],["言った","いった"],["、"],["「"],["ここ"],["に"],["おります"],["」"],["。"]]},{"verse":2,"text":"神,かみは言,いわれた、「あなたの子,こ、あなたの愛,あいするひとり子,こイサクを連,つれてモリヤの地,ちに行,いき、わたしが示,しめす山,やまで彼,かれを燔祭,はんさいとしてささげなさい」。","tok":[["神","かみ"],["は"],["言われた","いわれた"],["、"],["「"],["あなた"],["の"],["子","こ"],["、"],["あなた"],["の"],["愛する","あいする"],["ひとり子","ひとりこ"],["イサク"],["を"],["連れて","つれて"],["モリヤ"],["の"],["地","ち"],["に"],["行き","いき"],["、"],["わたし"],["が"],["示めす","しめす"],["山","やま"],["で"],["彼","かれ"],["を"],["燔祭","はんさい"],["として"],["ささげ"],["なさい"],["」"],["。"]]},{"verse":3,"text":"アブラハムは朝,あさはやく起,おきて、ろばにくらを置,おき、ふたりの若者,わかものと、その子,こイサクとを連,つれ、また燔祭,はんさいのたきぎを割,わり、立,たって神,かみが示,しめされた所,ところに出,でかけた。","tok":[["アブラハム"],["は"],["朝","あさ"],["はやく"],["起きて","おきて"],["、"],["ろば"],["に"],["くら"],["を"],["置き","おき"],["、"],["ふたり"],["の"],["若者","わかもの"],["と"],["、"],["その"],["子","こ"],["イサク"],["と"],["を"],["連れ","つれ"],["、"],["また"],["燔祭","はんさい"],["の"],["たきぎ"],["を"],["割","わり"],["、"],["立って","たって"],["神","かみ"],["が"],["示めされた","しめされた"],["所","ところ"],["に"],["出かけた","でかけた"],["。"]]},{"verse":4,"text":"三日,か目,めに、アブラハムは目,めをあげて、はるかにその場所,ばしょを見,みた。","tok":[["三日目","かめ"],["に"],["、"],["アブラハム"],["は"],["目","め"],["を"],["あげて"],["、"],["はるか"],["に"],["その"],["場所","ばしょ"],["を"],["見た","みた"],["。"]]},{"verse":5,"text":"そこでアブラハムは若者,わかものたちに言,いった、「あなたがたは、ろばと一緒,いっしょにここにいなさい。わたしとわらべは向,むこうへ行,いって礼拝,れいはいし、そののち、あなたがたの所,ところに帰,かえってきます」。","tok":[["そこ"],["で"],["アブラハム"],["は"],["若者","わかもの"],["たち"],["に"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["、"],["ろば"],["と"],["一緒","いっしょ"],["に"],["ここ"],["に"],["い"],["なさい"],["。"],["わたし"],["と"],["わらべ"],["は"],["向こう","むこう"],["へ"],["行って","いって"],["礼拝","れいはい"],["し"],["、"],["その"],["のち"],["、"],["あなた"],["がた"],["の"],["所","ところ"],["に"],["帰えって","かえって"],["きます"],["」"],["。"]]},{"verse":6,"text":"アブラハムは燔祭,はんさいのたきぎを取,とって、その子,こイサクに負,おわせ、手,てに火,ひと刃物,はものとを執,とって、ふたり一緒,いっしょに行,いった。","tok":[["アブラハム"],["は"],["燔祭","はんさい"],["の"],["たきぎ"],["を"],["取って","とって"],["、"],["その"],["子","こ"],["イサク"],["に"],["負わせ","おわせ"],["、"],["手","て"],["に"],["火","ひ"],["と"],["刃物","はもの"],["と"],["を"],["執って","とって"],["、"],["ふたり"],["一緒","いっしょ"],["に"],["行った","いった"],["。"]]},{"verse":7,"text":"やがてイサクは父,ちちアブラハムに言,いった、「父,ちちよ」。彼,かれは答,こたえた、「子,こよ、わたしはここにいます」。イサクは言,いった、「火,ひとたきぎとはありますが、燔祭,はんさいの小羊,こひつじはどこにありますか」。","tok":[["やがて"],["イサク"],["は"],["父","ちち"],["アブラハム"],["に"],["言った","いった"],["、"],["「"],["父","ちち"],["よ"],["」"],["。"],["彼","かれ"],["は"],["答","こたえ"],["た"],["、"],["「"],["子","こ"],["よ"],["、"],["わたし"],["は"],["ここ"],["に"],["います"],["」"],["。"],["イサク"],["は"],["言った","いった"],["、"],["「"],["火","ひ"],["と"],["たきぎ"],["と"],["は"],["あります"],["が"],["、"],["燔祭","はんさい"],["の"],["小羊","こひつじ"],["は"],["どこ"],["に"],["あります"],["か"],["」"],["。"]]},{"verse":8,"text":"アブラハムは言,いった、「子,こよ、神,かみみずから燔祭,はんさいの小羊,こひつじを備,そなえてくださるであろう」。こうしてふたりは一緒,いっしょに行,いった。","tok":[["アブラハム"],["は"],["言った","いった"],["、"],["「"],["子","こ"],["よ"],["、"],["神","かみ"],["みずから"],["燔祭","はんさい"],["の"],["小羊","こひつじ"],["を"],["備","そなえ"],["て"],["くださるで"],["あろう"],["」"],["。"],["こう"],["して"],["ふたり"],["は"],["一緒","いっしょ"],["に"],["行った","いった"],["。"]]},{"verse":9,"text":"彼,かれらが神,かみの示,しめされた場所,ばしょにきたとき、アブラハムはそこに祭壇,さいだんを築,きずき、たきぎを並,ならべ、その子,こイサクを縛,しばって祭壇,さいだんのたきぎの上,うえに載,のせた。","tok":[["彼","かれ"],["ら"],["が"],["神","かみ"],["の"],["示めされた","しめされた"],["場所","ばしょ"],["に"],["きた"],["とき"],["、"],["アブラハム"],["は"],["そこ"],["に"],["祭壇","さいだん"],["を"],["築き","きずき"],["、"],["たきぎ"],["を"],["並べ","ならべ"],["、"],["その"],["子","こ"],["イサク"],["を"],["縛って","しばって"],["祭壇","さいだん"],["の"],["たきぎ"],["の"],["上","うえ"],["に"],["載せた","のせた"],["。"]]},{"verse":10,"text":"そしてアブラハムが手,てを差,さし伸,のべ、刃物,はものを執,とってその子,こを殺,ころそうとした時,とき、","tok":[["そして"],["アブラハム"],["が"],["手","て"],["を"],["差し伸べ","さしのべ"],["、"],["刃物","はもの"],["を"],["執って","とって"],["その"],["子","こ"],["を"],["殺そう","ころそう"],["と"],["した"],["時","とき"],["、"]]},{"verse":11,"text":"主,しゅの使,つかいが天,てんから彼,かれを呼,よんで言,いった、「アブラハムよ、アブラハムよ」。彼,かれは答,こたえた、「はい、ここにおります」。","tok":[["主","しゅ"],["の"],["使","つかい"],["が"],["天","てん"],["から"],["彼","かれ"],["を"],["呼んで","よんで"],["言った","いった"],["、"],["「"],["アブラハム"],["よ"],["、"],["アブラハム"],["よ"],["」"],["。"],["彼","かれ"],["は"],["答","こたえ"],["た"],["、"],["「"],["はい"],["、"],["ここ"],["に"],["おります"],["」"],["。"]]},{"verse":12,"text":"み使,つかいが言,いった、「わらべを手,てにかけてはならない。また何,なにも彼,かれにしてはならない。あなたの子,こ、あなたのひとり子,こをさえ、わたしのために惜,おしまないので、あなたが神,かみを恐,おそれる者,ものであることをわたしは今,いま知,しった」。","tok":[["み使","みつかい"],["が"],["言った","いった"],["、"],["「"],["わらべ"],["を"],["手","て"],["に"],["かけて"],["は"],["ならない"],["。"],["また"],["何に","なに"],["も"],["彼","かれ"],["に"],["して"],["は"],["ならない"],["。"],["あなた"],["の"],["子","こ"],["、"],["あなた"],["の"],["ひとり"],["子","こ"],["を"],["さえ"],["、"],["わたし"],["の"],["ため"],["に"],["惜まない","おしまない"],["ので"],["、"],["あなた"],["が"],["神","かみ"],["を"],["恐れる","おそれる"],["者","もの"],["で"],["ある"],["こと"],["を"],["わたし"],["は"],["今","いま"],["知った","しった"],["」"],["。"]]},{"verse":13,"text":"この時,ときアブラハムが目,めをあげて見,みると、うしろに、角,つのをやぶに掛,かけている一頭,とうの雄羊,おひつじがいた。アブラハムは行,いってその雄羊,おひつじを捕,とらえ、それをその子,このかわりに燔祭,はんさいとしてささげた。","tok":[["この"],["時","とき"],["アブラハム"],["が"],["目","め"],["を"],["あげて"],["見る","みる"],["と"],["、"],["うしろ"],["に"],["、"],["角","つ"],["の"],["を"],["やぶ"],["に"],["掛て","かけて"],["いる"],["一頭","とう"],["の"],["雄羊","おひつじ"],["が"],["いた"],["。"],["アブラハム"],["は"],["行って","いって"],["その"],["雄羊","おひつじ"],["を"],["捕らえ","とらえ"],["、"],["それ"],["を"],["その"],["子","こ"],["の"],["かわり"],["に"],["燔祭","はんさい"],["として"],["ささげた"],["。"]]},{"verse":14,"text":"それでアブラハムはその所,ところの名,なをアドナイ・エレと呼,よんだ。これにより、人々,ひとびとは今日,こんにちもなお「主,しゅの山,やまに備,そなえあり」と言,いう。","tok":[["それ"],["で"],["アブラハム"],["は"],["その"],["所","ところ"],["の"],["名","な"],["を"],["アドナイ"],["・"],["エレ"],["と"],["呼んだ","よんだ"],["。"],["これ"],["に"],["より"],["、"],["人々","ひとびと"],["は"],["今日","こんにち"],["も"],["なお"],["「"],["主","しゅ"],["の"],["山","やま"],["に"],["備","そなえ"],["あり"],["」"],["と"],["言う","いう"],["。"]]},{"verse":15,"text":"主,しゅの使,つかいは再,ふたたび天,てんからアブラハムを呼,よんで、","tok":[["主","しゅ"],["の"],["使い","つかい"],["は"],["再び","ふたたび"],["天","てん"],["から"],["アブラハム"],["を"],["呼んで","よんで"],["、"]]},{"verse":16,"text":"言,いった、「主,しゅは言,いわれた、『わたしは自分,じぶんをさして誓,ちかう。あなたがこの事,ことをし、あなたの子,こ、あなたのひとり子,こをも惜,おしまなかったので、","tok":[["言った","いった"],["、"],["「"],["主","しゅ"],["は"],["言われた","いわれた"],["、"],["『"],["わたし"],["は"],["自分","じぶん"],["を"],["さして"],["誓う","ちかう"],["。"],["あなた"],["が"],["この"],["事","こと"],["を"],["し"],["、"],["あなた"],["の"],["子","こ"],["、"],["あなた"],["の"],["ひとり"],["子","こ"],["を"],["も"],["惜まなかった","おしまなかった"],["ので"],["、"]]},{"verse":17,"text":"わたしは大,おおいにあなたを祝福,しゅくふくし、大,おおいにあなたの子孫,しそんをふやして、天,てんの星,ほしのように、浜,はまべの砂,すなのようにする。あなたの子孫,しそんは敵,てきの門,もんを打,うち取,とり、","tok":[["わたし"],["は"],["大いに","おおいに"],["あなた"],["を"],["祝福","しゅくふく"],["し"],["、"],["大いに","おおいに"],["あなた"],["の"],["子孫","しそん"],["を"],["ふやして"],["、"],["天","てん"],["の"],["星","ほし"],["の"],["よう"],["に"],["、"],["浜べ","はまべ"],["の"],["砂","すな"],["の"],["よう"],["に"],["する"],["。"],["あなた"],["の"],["子孫","しそん"],["は"],["敵","てき"],["の"],["門","もん"],["を"],["打ち","うち"],["取","とり"],["、"]]},{"verse":18,"text":"また地,ちのもろもろの国民,こくみんはあなたの子孫,しそんによって祝福,しゅくふくを得,えるであろう。あなたがわたしの言葉,ことばに従,したがったからである』」。","tok":[["また"],["地","ち"],["の"],["もろもろ"],["の"],["国民","こくみん"],["は"],["あなた"],["の"],["子孫","しそん"],["によって"],["祝福","しゅくふく"],["を"],["得るで","えるで"],["あろう"],["。"],["あなた"],["が"],["わたし"],["の"],["言葉","ことば"],["に"],["従った","したがった"],["から"],["で"],["ある"],["』"],["」"],["。"]]},{"verse":19,"text":"アブラハムは若者,わかものたちの所,ところに帰,かえり、みな立,たって、共,ともにベエルシバへ行,いった。そしてアブラハムはベエルシバに住,すんだ。","tok":[["アブラハム"],["は"],["若者","わかもの"],["たち"],["の"],["所","ところ"],["に"],["帰えり","かえり"],["、"],["みな"],["立って","たって"],["、"],["共","とも"],["に"],["ベエルシバ"],["へ"],["行った","いった"],["。"],["そして"],["アブラハム"],["は"],["ベエルシバ"],["に"],["住んだ","すんだ"],["。"]]},{"verse":20,"text":"これらの事,ことの後,のち、ある人,ひとがアブラハムに告,つげて言,いった、「ミルカもまたあなたの兄弟,きょうだいナホルに子,こどもを産,うみました。","tok":[["これ"],["ら"],["の"],["事","こと"],["の"],["後","の"],["ち"],["、"],["ある"],["人","ひと"],["が"],["アブラハム"],["に"],["告","つげ"],["て"],["言った","いった"],["、"],["「"],["ミルカ"],["も"],["また"],["あなた"],["の"],["兄弟","きょうだい"],["ナホル"],["に"],["子ども","こども"],["を"],["産みました","うみました"],["。"]]},{"verse":21,"text":"長男,ちょうなんはウヅ、弟,おとうとはブズ、次,つぎはアラムの父,ちちケムエル、","tok":[["長男","ちょうなん"],["は"],["ウヅ"],["、"],["弟","おとうと"],["は"],["ブズ"],["、"],["次","つぎ"],["は"],["アラム"],["の"],["父","ちち"],["ケムエル"],["、"]]},{"verse":22,"text":"次,つぎはケセデ、ハゾ、ピルダシ、エデラフ、ベトエルです」。","tok":[["次","つぎ"],["は"],["ケセデ"],["、"],["ハゾ"],["、"],["ピルダシ"],["、"],["エデラフ"],["、"],["ベトエル"],["です"],["」"],["。"]]},{"verse":23,"text":"ベトエルの子,こはリベカであって、これら八人,にんはミルカがアブラハムの兄弟,きょうだいナホルに産,うんだのである。","tok":[["ベトエル"],["の"],["子","こ"],["は"],["リベカ"],["で"],["あって"],["、"],["これ"],["ら"],["八人","にん"],["は"],["ミルカ"],["が"],["アブラハム"],["の"],["兄弟","きょうだい"],["ナホル"],["に"],["産","うんだ"],["ので"],["ある"],["。"]]},{"verse":24,"text":"ナホルのそばめで、名,なをルマという女,おんなもまたテバ、ガハム、タハシおよびマアカを産,うんだ。","tok":[["ナホル"],["の"],["そばめ"],["で"],["、"],["名","な"],["を"],["ルマ"],["と"],["いう"],["女","おんな"],["も"],["また"],["テバ"],["、"],["ガハム"],["、"],["タハシ"],["および"],["マアカ"],["を"],["産んだ","うんだ"],["。"]]}]
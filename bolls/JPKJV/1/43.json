[{"verse":1,"text":"ききんはその地,ちに激,はげしかった。","tok":[["ききん"],["は"],["その"],["地","ち"],["に"],["激しかった","はげしかった"],["。"]]},{"verse":2,"text":"彼,かれらがエジプトから携,たずさえてきた穀物,こくもつを食,くい尽,つくした時,とき、父,ちちは彼,かれらに言,いった、「また行,いって、われわれのために少,すこしの食糧,しょくりょうを買,かってきなさい」。","tok":[["彼","かれ"],["ら"],["が"],["エジプト"],["から"],["携えて","たずさえて"],["きた"],["穀物","こくもつ"],["を"],["食い","くい"],["尽くした","つくした"],["時","とき"],["、"],["父","ちち"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["また"],["行って","いって"],["、"],["われわれ"],["の"],["ため"],["に"],["少し","すこし"],["の"],["食糧","しょくりょう"],["を"],["買って","かって"],["き"],["なさい"],["」"],["。"]]},{"verse":3,"text":"ユダは父,ちちに答,こたえて言,いった、「あの人,ひとはわれわれをきびしく戒,いましめて、弟,おとうとが一緒,いっしょでなければ、わたしの顔,かおを見,みてはならないと言,いいました。","tok":[["ユダ"],["は"],["父","ちち"],["に"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["あの"],["人","ひと"],["は"],["われわれ"],["を"],["きびしく"],["戒しめ","いましめ"],["て"],["、"],["弟","おとうと"],["が"],["一緒","いっしょ"],["で"],["なければ"],["、"],["わたし"],["の"],["顔","かお"],["を"],["見て","みて"],["は"],["ならない"],["と"],["言いました","いいました"],["。"]]},{"verse":4,"text":"もしあなたが弟,おとうとをわれわれと一緒,いっしょにやってくださるなら、われわれは下,くだって行,いって、あなたのために食糧,しょくりょうを買,かってきましょう。","tok":[["もし"],["あなた"],["が"],["弟","おとうと"],["を"],["われわれ"],["と"],["一緒","いっしょ"],["に"],["やって"],["くださるなら"],["、"],["われわれ"],["は"],["下って","くだって"],["行って","いって"],["、"],["あなた"],["の"],["ため"],["に"],["食糧","しょくりょう"],["を"],["買って","かって"],["きましょう"],["。"]]},{"verse":5,"text":"しかし、もし彼,かれをやられないなら、われわれは下,くだって行,いきません。あの人,ひとがわれわれに、弟,おとうとが一緒,いっしょでなければわたしの顔,かおを見,みてはならないと言,いったのですから」。","tok":[["しかし"],["、"],["もし"],["彼","かれ"],["を"],["やられないなら"],["、"],["われわれ"],["は"],["下って","くだって"],["行きません","いきません"],["。"],["あの"],["人","ひと"],["が"],["われわれ"],["に"],["、"],["弟","おとうと"],["が"],["一緒","いっしょ"],["で"],["なければ"],["わたし"],["の"],["顔","かお"],["を"],["見て","みて"],["は"],["ならない"],["と"],["言った","いった"],["の"],["です"],["から"],["」"],["。"]]},{"verse":6,"text":"イスラエルは言,いった、「なぜ、もうひとりの弟,おとうとがあるとあの人,ひとに言,いって、わたしを苦,くるしめるのか」。","tok":[["イスラエル"],["は"],["言った","いった"],["、"],["「"],["なぜ"],["、"],["もう"],["ひとり"],["の"],["弟","おとうと"],["が"],["ある"],["と"],["あの"],["人","ひと"],["に"],["言って","いって"],["、"],["わたし"],["を"],["苦しめる","くるしめる"],["の"],["か"],["」"],["。"]]},{"verse":7,"text":"彼,かれらは言,いった、「あの人,ひとがわれわれと一族,いちぞくとのことを問,といただして、父,ちちはまだ生,いきているか、もうひとりの弟,おとうとがあるかと言,いったので、問,とわれるままに答,こたえましたが、その人,ひとが、弟,おとうとを連,つれてこいと言,いおうとは、どうして知,しることができたでしょう」。","tok":[["彼","かれ"],["ら"],["は"],["言った","いった"],["、"],["「"],["あの"],["人","ひと"],["が"],["われわれ"],["と"],["一族","いちぞく"],["と"],["の"],["こと"],["を"],["問","とい"],["ただして"],["、"],["父","ちち"],["は"],["まだ"],["生きて","いきて"],["いる"],["か"],["、"],["もう"],["ひとり"],["の"],["弟","おとうと"],["が"],["ある"],["か"],["と"],["言った","いった"],["ので"],["、"],["問われる","とわれる"],["まま"],["に"],["答","こたえ"],["ました"],["が"],["、"],["その"],["人","ひと"],["が"],["、"],["弟","おとうと"],["を"],["連れて","つれて"],["こい"],["と"],["言おう","いおう"],["と"],["は"],["、"],["どう"],["して"],["知る","しる"],["こと"],["が"],["できたでしょう"],["」"],["。"]]},{"verse":8,"text":"ユダは父,ちちイスラエルに言,いった、「あの子,こをわたしと一緒,いっしょにやってくだされば、われわれは立,たって行,いきましょう。そしてわれわれもあなたも、われわれの子供,こどもらも生,いきながらえ、死,しを免,まぬかれましょう。","tok":[["ユダ"],["は"],["父","ちち"],["イスラエル"],["に"],["言った","いった"],["、"],["「"],["あの"],["子","こ"],["を"],["わたし"],["と"],["一緒","いっしょ"],["に"],["やって"],["くだされば"],["、"],["われわれ"],["は"],["立って","たって"],["行きましょう","いきましょう"],["。"],["そして"],["われわれ"],["も"],["あなた"],["も"],["、"],["われわれ"],["の"],["子供","こども"],["ら"],["も"],["生きながらえ","いきながらえ"],["、"],["死","し"],["を"],["免かれましょう","まぬかれましょう"],["。"]]},{"verse":9,"text":"わたしが彼,かれの身,みを請,うけ合,あいます。わたしの手,てから彼,かれを求,もとめなさい。もしわたしが彼,かれをあなたのもとに連,つれ帰,かえって、あなたの前,まえに置,おかなかったら、わたしはあなたに対,たいして永久,えいきゅうに罪,つみを負,おいましょう。","tok":[["わたし"],["が"],["彼","かれ"],["の"],["身","み"],["を"],["請合います","うけあいます"],["。"],["わたし"],["の"],["手","て"],["から"],["彼","かれ"],["を"],["求め","もとめ"],["なさい"],["。"],["もし"],["わたし"],["が"],["彼","かれ"],["を"],["あなた"],["の"],["もと"],["に"],["連れ","つれ"],["帰えって","かえって"],["、"],["あなた"],["の"],["前","まえ"],["に"],["置かなかったら","おかなかったら"],["、"],["わたし"],["は"],["あなた"],["に対して","にたいして"],["永久","えいきゅう"],["に"],["罪","つみ"],["を"],["負いましょう","おいましょう"],["。"]]},{"verse":10,"text":"もしわれわれがこんなにためらわなかったら、今,いまごろは二度,ども行,いってきたでしょう」。","tok":[["もし"],["われわれ"],["が"],["こんな"],["に"],["ためらわなかったら"],["、"],["今ごろ","いまごろ"],["は"],["二","に"],["度","ど"],["も"],["行って","いって"],["きたでしょう"],["」"],["。"]]},{"verse":11,"text":"父,ちちイスラエルは彼,かれらに言,いった、「それではこうしなさい。この国,くにの名産,めいさんを器,うつわに入,いれ、携,たずさえ下,くだってその人,ひとに贈,おくり物,ものにしなさい。すなわち少,すこしの乳香,にゅうこう、少,すこしの蜜,みつ、香料,こうりょう、もつやく、ふすだしう、あめんどう。","tok":[["父","ちち"],["イスラエル"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["それ"],["で"],["は"],["こう"],["し"],["なさい"],["。"],["この"],["国","くに"],["の"],["名産","めいさん"],["を"],["器","うつわ"],["に"],["入れ","いれ"],["、"],["携え","たずさえ"],["下って","くだって"],["その"],["人","ひと"],["に"],["贈り物","おくりもの"],["に"],["し"],["なさい"],["。"],["すなわち"],["少し","すこし"],["の"],["乳香","にゅうこう"],["、"],["少し","すこし"],["の"],["蜜","みつ"],["、"],["香料","こうりょう"],["、"],["もつ"],["やく"],["、"],["ふす"],["だし"],["う"],["、"],["あ"],["めんどう"],["。"]]},{"verse":12,"text":"そしてその上,うえに、倍額,ばいがくの銀,ぎんを手,てに持,もって行,いきなさい。また袋,ふくろの口,くちに返,かえしてあった銀,ぎんは持,もって行,いって返,かえしなさい。たぶんそれは誤,あやまりであったのでしょう。","tok":[["そして"],["その"],["上","うえ"],["に"],["、"],["倍額","ばいがく"],["の"],["銀","ぎん"],["を"],["手","て"],["に"],["持って","もって"],["行き","いき"],["なさい"],["。"],["また"],["袋","ふくろ"],["の"],["口","くち"],["に"],["返","かえし"],["て"],["あった"],["銀","ぎん"],["は"],["持って","もって"],["行って","いって"],["返","かえし"],["なさい"],["。"],["たぶん"],["それ"],["は"],["誤り","あやまり"],["で"],["あった"],["の"],["でしょう"],["。"]]},{"verse":13,"text":"弟,おとうとも連,つれ、立,たって、またその人,ひとの所,ところへ行,いきなさい。","tok":[["弟","おとうと"],["も"],["連れ","つれ"],["、"],["立って","たって"],["、"],["また"],["その"],["人","ひと"],["の"],["所","ところ"],["へ"],["行き","いき"],["なさい"],["。"]]},{"verse":14,"text":"どうか全能,ぜんのうの神,かみがその人,ひとの前,まえであなたがたをあわれみ、もうひとりの兄弟,きょうだいとベニヤミンとを、返,かえさせてくださるように。もしわたしが子,こを失,うしなわなければならないのなら、失,うしなってもよい」。","tok":[["どう"],["か"],["全能","ぜんのう"],["の"],["神","かみ"],["が"],["その"],["人","ひと"],["の"],["前","まえ"],["で"],["あなた"],["がた"],["を"],["あわれみ"],["、"],["もう"],["ひとり"],["の"],["兄弟","きょうだい"],["と"],["ベニヤミン"],["と"],["を"],["、"],["返えさせて","かえさせて"],["くださる"],["よう"],["に"],["。"],["もし"],["わたし"],["が"],["子","こ"],["を"],["失なわなければ","うしなわなければ"],["ならない"],["の"],["なら"],["、"],["失なって","うしなって"],["も"],["よい"],["」"],["。"]]},{"verse":15,"text":"そこでその人々,ひとびとは贈,おくり物,ものを取,とり、また倍額,ばいがくの銀,ぎんを携,たずさえ、ベニヤミンを連,つれ、立,たってエジプトへ下,くだり、ヨセフの前,まえに立,たった。","tok":[["そこ"],["で"],["その"],["人々","ひとびと"],["は"],["贈り物","おくりもの"],["を"],["取","とり"],["、"],["また"],["倍額","ばいがく"],["の"],["銀","ぎん"],["を"],["携え","たずさえ"],["、"],["ベニヤミン"],["を"],["連れ","つれ"],["、"],["立って","たって"],["エジプト"],["へ"],["下り","くだり"],["、"],["ヨセフ"],["の"],["前","まえ"],["に"],["立った","たった"],["。"]]},{"verse":16,"text":"ヨセフはベニヤミンが彼,かれらと共,ともにいるのを見,みて、家,いえづかさに言,いった、「この人々,ひとびとを家,いえに連,つれて行,いき、獣,けものをほふって、したくするように。この人々,ひとびとは昼,ひる、わたしと一緒,いっしょに食事,しょくじをします」。","tok":[["ヨセフ"],["は"],["ベニヤミン"],["が"],["彼","かれ"],["ら"],["と"],["共","とも"],["に"],["いる"],["の"],["を"],["見て","みて"],["、"],["家","いえ"],["づかさ"],["に"],["言った","いった"],["、"],["「"],["この"],["人々","ひとびと"],["を"],["家","いえ"],["に"],["連れて","つれて"],["行き","いき"],["、"],["獣","けもの"],["を"],["ほふって"],["、"],["したく"],["する"],["よう"],["に"],["。"],["この"],["人々","ひとびと"],["は"],["昼","ひる"],["、"],["わたし"],["と"],["一緒","いっしょ"],["に"],["食事","しょくじ"],["を"],["します"],["」"],["。"]]},{"verse":17,"text":"その人,ひとはヨセフの言,いったようにして、この人々,ひとびとをヨセフの家,いえへ連,つれて行,いった。","tok":[["その"],["人","ひと"],["は"],["ヨセフ"],["の"],["言った","いった"],["よう"],["に"],["して"],["、"],["この"],["人々","ひとびと"],["を"],["ヨセフ"],["の"],["家","いえ"],["へ"],["連れて","つれて"],["行った","いった"],["。"]]},{"verse":18,"text":"ところがこの人々,ひとびとはヨセフの家,いえへ連,つれて行,いかれたので恐,おそれて言,いった、「初,はじめの時,ときに袋,ふくろに返,かえしてあったあの銀,ぎんのゆえに、われわれを引,ひき入,いれたのです。そしてわれわれを襲,おそい、攻,せめ、捕,とらえて奴隷,どれいとし、われわれのろばをも奪,うばうのです」。","tok":[["ところ"],["が"],["この"],["人々","ひとびと"],["は"],["ヨセフ"],["の"],["家","いえ"],["へ"],["連れて","つれて"],["行かれた","いかれた"],["ので"],["恐れて","おそれて"],["言った","いった"],["、"],["「"],["初め","はじめ"],["の"],["時","とき"],["に"],["袋","ふくろ"],["に"],["返","かえし"],["て"],["あった"],["あの"],["銀","ぎん"],["の"],["ゆえ"],["に"],["、"],["われわれ"],["を"],["引入れた","ひきいれた"],["の"],["です"],["。"],["そして"],["われわれ"],["を"],["襲い","おそい"],["、"],["攻め","せめ"],["、"],["捕らえて","とらえて"],["奴隷","どれい"],["と"],["し"],["、"],["われわれ"],["の"],["ろば"],["を"],["も"],["奪う","うばう"],["の"],["です"],["」"],["。"]]},{"verse":19,"text":"彼,かれらはヨセフの家,いえづかさに近,ちかづいて、家,いえの入口,いりぐちで、言,いった、","tok":[["彼","かれ"],["ら"],["は"],["ヨセフ"],["の"],["家","いえ"],["づかさ"],["に"],["近づいて","ちかづいて"],["、"],["家","いえ"],["の"],["入口","いりぐち"],["で"],["、"],["言った","いった"],["、"]]},{"verse":20,"text":"「ああ、わが主,しゅよ、われわれは最初,さいしょ、食糧,しょくりょうを買,かうために下,くだってきたのです。","tok":[["「"],["ああ"],["、"],["わが"],["主","しゅ"],["よ"],["、"],["われわれ"],["は"],["最初","さいしょ"],["、"],["食糧","しょくりょう"],["を"],["買う","かう"],["ため"],["に"],["下って","くだって"],["きた"],["の"],["です"],["。"]]},{"verse":21,"text":"ところが宿,やどに行,いって袋,ふくろをあけて見,みると、めいめいの銀,ぎんは袋,ふくろの口,くちにあって、銀,ぎんの重,おもさは元,もとのままでした。それでわれわれはそれを持,もって参,まいりました。","tok":[["ところ"],["が"],["宿","やど"],["に"],["行って","いって"],["袋","ふくろ"],["を"],["あけて"],["見る","みる"],["と"],["、"],["めいめい"],["の"],["銀","ぎん"],["は"],["袋","ふくろ"],["の"],["口","くち"],["に"],["あって"],["、"],["銀","ぎん"],["の"],["重さ","おもさ"],["は"],["元","もと"],["の"],["まま"],["でした"],["。"],["それ"],["で"],["われわれ"],["は"],["それ"],["を"],["持って","もって"],["参りました","まいりました"],["。"]]},{"verse":22,"text":"そして食糧,しょくりょうを買,かうために、ほかの銀,ぎんをも持,もって下,くだってきました。われわれの銀,ぎんを袋,ふくろに入,いれた者,ものが、だれであるかは分,わかりません」。","tok":[["そして"],["食糧","しょくりょう"],["を"],["買う","かう"],["ため"],["に"],["、"],["ほか"],["の"],["銀","ぎん"],["を"],["も"],["持って","もって"],["下って","くだって"],["きました"],["。"],["われわれ"],["の"],["銀","ぎん"],["を"],["袋","ふくろ"],["に"],["入れた","いれた"],["者","もの"],["が"],["、"],["だれ"],["で"],["ある"],["か"],["は"],["分かりません","わかりません"],["」"],["。"]]},{"verse":23,"text":"彼,かれは言,いった、「安心,あんしんしなさい。恐,おそれてはいけません。その宝,たからはあなたがたの神,かみ、あなたがたの父,ちちの神,かみが、あなたがたの袋,ふくろに入,いれてあなたがたに賜,たまわったのです。あなたがたの銀,ぎんはわたしが受,うけ取,とりました」。そして彼,かれはシメオンを彼,かれらの所,ところへ連,つれてきた。","tok":[["彼","かれ"],["は"],["言った","いった"],["、"],["「"],["安心","あんしん"],["し"],["なさい"],["。"],["恐れて","おそれて"],["は"],["いけません"],["。"],["その"],["宝","たから"],["は"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["あなた"],["がた"],["の"],["父","ちち"],["の"],["神","かみ"],["が"],["、"],["あなた"],["がた"],["の"],["袋","ふくろ"],["に"],["入れて","いれて"],["あなた"],["がた"],["に"],["賜わった","たまわった"],["の"],["です"],["。"],["あなた"],["がた"],["の"],["銀","ぎん"],["は"],["わたし"],["が"],["受け","うけ"],["取","とり"],["ました"],["」"],["。"],["そして"],["彼","かれ"],["は"],["シメオン"],["を"],["彼","かれ"],["ら"],["の"],["所","ところ"],["へ"],["連れて","つれて"],["きた"],["。"]]},{"verse":24,"text":"こうしてその人,ひとはこの人々,ひとびとをヨセフの家,いえへ導,みちびき、水,みずを与,あたえて足,あしを洗,あらわせ、また、ろばに飼葉,かいばを与,あたえた。","tok":[["こう"],["して"],["その"],["人","ひと"],["は"],["この"],["人々","ひとびと"],["を"],["ヨセフ"],["の"],["家","いえ"],["へ"],["導き","みちびき"],["、"],["水","みず"],["を"],["与","あたえ"],["て"],["足","あし"],["を"],["洗わせ","あらわせ"],["、"],["また"],["、"],["ろば"],["に"],["飼葉","かいば"],["を"],["与","あたえ"],["た"],["。"]]},{"verse":25,"text":"彼,かれらはその所,ところで食事,しょくじをするのだと聞,きき、贈,おくり物,ものを整,ととのえて、昼,ひるにヨセフの来,くるのを待,まった。","tok":[["彼","かれ"],["ら"],["は"],["その"],["所","ところ"],["で"],["食事","しょくじ"],["を"],["する"],["の"],["だ"],["と"],["聞","きき"],["、"],["贈り物","おくりもの"],["を"],["整えて","ととのえて"],["、"],["昼","ひる"],["に"],["ヨセフ"],["の"],["来る","くる"],["の"],["を"],["待った","まった"],["。"]]},{"verse":26,"text":"さてヨセフが家,いえに帰,かえってきたので、彼,かれらはその家,いえに携,たずさえてきた贈,おくり物,ものをヨセフにささげ、地,ちに伏,ふして、彼,かれを拝,はいした。","tok":[["さて"],["ヨセフ"],["が"],["家","いえ"],["に"],["帰えって","かえって"],["きた"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["その"],["家","いえ"],["に"],["携えて","たずさえて"],["きた"],["贈り物","おくりもの"],["を"],["ヨセフ"],["に"],["ささげ"],["、"],["地","ち"],["に"],["伏して","ふして"],["、"],["彼","かれ"],["を"],["拝した","はいした"],["。"]]},{"verse":27,"text":"ヨセフは彼,かれらの安否,あんぴを問,とうて言,いった、「あなたがたの父,ちち、あなたがたがさきに話,はなしていたその老人,ろうじんは無事,ぶじですか。なお生,いきながらえておられますか」。","tok":[["ヨセフ"],["は"],["彼","かれ"],["ら"],["の"],["安否","あんぴ"],["を"],["問うて","とうて"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["の"],["父","ちち"],["、"],["あなた"],["がた"],["が"],["さき"],["に"],["話","はなし"],["て"],["いた"],["その"],["老人","ろうじん"],["は"],["無事","ぶじ"],["です"],["か"],["。"],["なお"],["生きながらえて","いきながらえて"],["おられます"],["か"],["」"],["。"]]},{"verse":28,"text":"彼,かれらは答,こたえた、「あなたのしもべ、われわれの父,ちちは無事,ぶじで、なお生,いきながらえています」。そして彼,かれらは、頭,とうをさげて拝,はいした。","tok":[["彼","かれ"],["ら"],["は"],["答","こたえ"],["た"],["、"],["「"],["あなた"],["の"],["しもべ"],["、"],["われわれ"],["の"],["父","ちち"],["は"],["無事","ぶじ"],["で"],["、"],["なお"],["生きながらえて","いきながらえて"],["います"],["」"],["。"],["そして"],["彼","かれ"],["ら"],["は"],["、"],["頭","とう"],["を"],["さげて"],["拝した","はいした"],["。"]]},{"verse":29,"text":"ヨセフは目,めをあげて同,おなじ母,ははの子,こである弟,おとうとベニヤミンを見,みて言,いった、「これはあなたがたが前,まえにわたしに話,はなした末,すえの弟,おとうとですか」。また言,いった、「わが子,こよ、どうか神,かみがあなたを恵,めぐまれるように」。","tok":[["ヨセフ"],["は"],["目","め"],["を"],["あげて"],["同じ","おなじ"],["母","はは"],["の"],["子","こ"],["で"],["ある"],["弟","おとうと"],["ベニヤミン"],["を"],["見て","みて"],["言った","いった"],["、"],["「"],["これ"],["は"],["あなた"],["がた"],["が"],["前","まえ"],["に"],["わたし"],["に"],["話","はなし"],["た"],["末","すえ"],["の"],["弟","おとうと"],["です"],["か"],["」"],["。"],["また"],["言った","いった"],["、"],["「"],["わが"],["子","こ"],["よ"],["、"],["どう"],["か"],["神","かみ"],["が"],["あなた"],["を"],["恵れる","めぐまれる"],["よう"],["に"],["」"],["。"]]},{"verse":30,"text":"ヨセフは弟,おとうとなつかしさに心,こころがせまり、急,いそいで泣,なく場所,ばしょをたずね、へやにはいって泣,ないた。","tok":[["ヨセフ"],["は"],["弟","おとうと"],["なつかし"],["さ"],["に"],["心","こころ"],["が"],["せまり"],["、"],["急いで","いそいで"],["泣く","なく"],["場所","ばしょ"],["を"],["たずね"],["、"],["へや"],["に"],["はいって"],["泣いた","ないた"],["。"]]},{"verse":31,"text":"やがて彼,かれは顔,かおを洗,あらって出,でてきた。そして自分,じぶんを制,せいして言,いった、「食事,しょくじにしよう」。","tok":[["やがて"],["彼","かれ"],["は"],["顔","かお"],["を"],["洗って","あらって"],["出て","でて"],["きた"],["。"],["そして"],["自分","じぶん"],["を"],["制して","せいして"],["言った","いった"],["、"],["「"],["食事","しょくじ"],["に"],["しよう"],["」"],["。"]]},{"verse":32,"text":"そこでヨセフはヨセフ、彼,かれらは彼,かれら、陪食,ばいしょくのエジプトびとはエジプトびと、と別々,べつべつに席,せきに着,ついた。エジプトびとはヘブルびとと共,ともに食事,しょくじすることができなかった。それはエジプトびとの忌,いむところであったからである。","tok":[["そこ"],["で"],["ヨセフ"],["は"],["ヨセフ"],["、"],["彼","かれ"],["ら"],["は"],["彼","かれ"],["ら"],["、"],["陪食","ばいしょく"],["の"],["エジプト"],["び"],["と"],["は"],["エジプト"],["び"],["と"],["、"],["と"],["別々","べつべつ"],["に"],["席","せき"],["に"],["着いた","ついた"],["。"],["エジプト"],["び"],["と"],["は"],["ヘブル"],["びと"],["と"],["共","とも"],["に"],["食事","しょくじ"],["する"],["こと"],["が"],["できなかった"],["。"],["それ"],["は"],["エジプト"],["びと"],["の"],["忌む","いむ"],["ところ"],["で"],["あった"],["から"],["で"],["ある"],["。"]]},{"verse":33,"text":"こうして彼,かれらはヨセフの前,まえに、長子,ちょうしは長子,ちょうしとして、弟,おとうとは弟,おとうととしてすわらせられたので、その人々,ひとびとは互,たがいに驚,おどろいた。","tok":[["こう"],["して"],["彼","かれ"],["ら"],["は"],["ヨセフ"],["の"],["前","まえ"],["に"],["、"],["長子","ちょうし"],["は"],["長子","ちょうし"],["として"],["、"],["弟","おとうと"],["は"],["弟","おとうと"],["として"],["すわらせられた"],["ので"],["、"],["その"],["人々","ひとびと"],["は"],["互","たがい"],["に"],["驚ろいた","おどろいた"],["。"]]},{"verse":34,"text":"またヨセフの前,まえから、めいめいの分,ぶんが運,はこばれたが、ベニヤミンの分,ぶんは他,たのいずれの者,ものの分,ぶんよりも五倍,ばい多,おおかった。こうして彼,かれらは飲,のみ、ヨセフと共,ともに楽,たのしんだ。","tok":[["また"],["ヨセフ"],["の"],["前","まえ"],["から"],["、"],["めいめい"],["の"],["分","ぶん"],["が"],["運こばれた","はこばれた"],["が"],["、"],["ベニヤミン"],["の"],["分","ぶん"],["は"],["他","た"],["の"],["いずれ"],["の"],["者","もの"],["の"],["分","ぶん"],["より"],["も"],["五","ご"],["倍","ばい"],["い"],["多かった","おおかった"],["。"],["こう"],["して"],["彼","かれ"],["ら"],["は"],["飲み","のみ"],["、"],["ヨセフ"],["と"],["共","とも"],["に"],["楽しんだ","たのしんだ"],["。"]]}]
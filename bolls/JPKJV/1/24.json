[{"verse":1,"text":"アブラハムは年,としが進,すすんで老人,ろうじんとなった。主,しゅはすべての事,ことにアブラハムを恵,めぐまれた。","tok":[["アブラハム"],["は"],["年","と"],["し"],["が"],["進んで","すすんで"],["老人","ろうじん"],["と"],["なった"],["。"],["主","しゅ"],["は"],["すべて"],["の"],["事","こと"],["に"],["アブラハム"],["を"],["恵れた","めぐまれた"],["。"]]},{"verse":2,"text":"さてアブラハムは所有,しょゆうのすべてを管理,かんりさせていた家,いえの年長,ねんちょうのしもべに言,いった、「あなたの手,てをわたしのももの下,したに入,いれなさい。","tok":[["さて"],["アブラハム"],["は"],["所有","しょゆう"],["の"],["すべて"],["を"],["管理","かんり"],["させて"],["いた"],["家","いえ"],["の"],["年長","ねんちょう"],["の"],["しもべ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["の"],["手","て"],["を"],["わたし"],["の"],["もも"],["の"],["下","した"],["に"],["入れ","いれ"],["なさい"],["。"]]},{"verse":3,"text":"わたしはあなたに天地,てんちの神,かみ、主,しゅをさして誓,ちかわせる。あなたはわたしが今,いま一緒,いっしょに住,すんでいるカナンびとのうちから、娘,むすめをわたしの子,この妻,つまにめとってはならない。","tok":[["わたし"],["は"],["あなた"],["に"],["天地","てんち"],["の"],["神","かみ"],["、"],["主","しゅ"],["を"],["さして"],["誓わせる","ちかわせる"],["。"],["あなた"],["は"],["わたし"],["が"],["今","いま"],["一緒","いっしょ"],["に"],["住んで","すんで"],["いる"],["カナン"],["びと"],["の"],["うち"],["から"],["、"],["娘","むすめ"],["を"],["わたし"],["の"],["子","こ"],["の"],["妻","つま"],["に"],["めとって"],["は"],["ならない"],["。"]]},{"verse":4,"text":"あなたはわたしの国,くにへ行,いき、親族,しんぞくの所,ところへ行,いって、わたしの子,こイサクのために妻,つまをめとらなければならない」。","tok":[["あなた"],["は"],["わたし"],["の"],["国","くに"],["へ"],["行き","いき"],["、"],["親族","しんぞく"],["の"],["所","ところ"],["へ"],["行って","いって"],["、"],["わたし"],["の"],["子","こ"],["イサク"],["の"],["ため"],["に"],["妻","つま"],["を"],["めとらなければ"],["ならない"],["」"],["。"]]},{"verse":5,"text":"しもべは彼,かれに言,いった、「もしその女,おんながわたしについてこの地,ちに来,くることを好,このまない時,ときは、わたしはあなたの子,こをあなたの出身,しゅっしん地,ちに連,つれ帰,かえるべきでしょうか」。","tok":[["しもべ"],["は"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["もし"],["その"],["女","おんな"],["が"],["わたし"],["について"],["この"],["地","ち"],["に"],["来る","くる"],["こと"],["を"],["好まない","このまない"],["時","とき"],["は"],["、"],["わたし"],["は"],["あなた"],["の"],["子","こ"],["を"],["あなた"],["の"],["出身地","しゅっしんち"],["に"],["連れ","つれ"],["帰えるべきでしょう","かえるべきでしょう"],["か"],["」"],["。"]]},{"verse":6,"text":"アブラハムは彼,かれに言,いった、「わたしの子,こは決,けっして向,むこうへ連,つれ帰,かえってはならない。","tok":[["アブラハム"],["は"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["わたし"],["の"],["子","こ"],["は"],["決っして","けっして"],["向こう","むこう"],["へ"],["連れ","つれ"],["帰えって","かえって"],["は"],["ならない"],["。"]]},{"verse":7,"text":"天,てんの神,かみ、主,しゅはわたしを父,ちちの家,いえ、親族,しんぞくの地,ちから導,みちびき出,だしてわたしに語,かたり、わたしに誓,ちかって、おまえの子孫,しそんにこの地,ちを与,あたえると言,いわれた。主,しゅは、み使,つかいをあなたの前,まえにつかわされるであろう。あなたはあそこからわたしの子,こに妻,つまをめとらねばならない。","tok":[["天","てん"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["わたし"],["を"],["父","ちち"],["の"],["家","いえ"],["、"],["親族","しんぞく"],["の"],["地","ち"],["から"],["導き出して","みちびきだして"],["わたし"],["に"],["語り","かたり"],["、"],["わたし"],["に"],["誓って","ちかって"],["、"],["おまえ"],["の"],["子孫","しそん"],["に"],["この"],["地","ち"],["を"],["与える","あたえる"],["と"],["言われた","いわれた"],["。"],["主","しゅ"],["は"],["、"],["み使","みつかい"],["を"],["あなた"],["の"],["前","まえ"],["に"],["つかわされるで"],["あろう"],["。"],["あなた"],["は"],["あそこ"],["から"],["わたし"],["の"],["子","こ"],["に"],["妻","つま"],["を"],["めとらねば"],["ならない"],["。"]]},{"verse":8,"text":"けれどもその女,おんながあなたについて来,くることを好,このまないなら、あなたはこの誓,ちかいを解,とかれる。ただわたしの子,こを向,むこうへ連,つれ帰,かえってはならない」。","tok":[["けれど"],["も"],["その"],["女","おんな"],["が"],["あなた"],["について"],["来る","くる"],["こと"],["を"],["好まないなら","このまないなら"],["、"],["あなた"],["は"],["この"],["誓い","ちかい"],["を"],["解かれる","とかれる"],["。"],["ただ"],["わたし"],["の"],["子","こ"],["を"],["向こう","むこう"],["へ"],["連れ","つれ"],["帰えって","かえって"],["は"],["ならない"],["」"],["。"]]},{"verse":9,"text":"そこでしもべは手,てを主人,しゅじんアブラハムのももの下,したに入,いれ、この事,ことについて彼,かれに誓,ちかった。","tok":[["そこ"],["で"],["しもべ"],["は"],["手","て"],["を"],["主人","しゅじん"],["アブラハム"],["の"],["もも"],["の"],["下","した"],["に"],["入れ","いれ"],["、"],["この"],["事","こと"],["について"],["彼","かれ"],["に"],["誓った","ちかった"],["。"]]},{"verse":10,"text":"しもべは主人,しゅじんのらくだのうちから十頭,とうのらくだを取,とって出,でかけた。すなわち主人,しゅじんのさまざまの良,よい物,ものを携,たずさえ、立,たってアラム・ナハライムにむかい、ナホルの町,まちへ行,いった。","tok":[["しもべ"],["は"],["主人","しゅじん"],["の"],["らくだ"],["の"],["うち"],["から"],["十頭","とう"],["の"],["らくだ"],["を"],["取って","とって"],["出かけた","でかけた"],["。"],["すなわち"],["主人","しゅじん"],["の"],["さまざま"],["の"],["良い","よい"],["物","もの"],["を"],["携え","たずさえ"],["、"],["立って","たって"],["アラム"],["・"],["ナハライム"],["に"],["むかい"],["、"],["ナホル"],["の"],["町","まち"],["へ"],["行った","いった"],["。"]]},{"verse":11,"text":"彼,かれはらくだを町,まちの外,そとの、水,みずの井戸,いどのそばに伏,ふさせた。時,ときは夕暮,ゆうぐれで、女,おんなたちが水,みずをくみに出,でる時刻,じこくであった。","tok":[["彼","かれ"],["は"],["らくだ"],["を"],["町","まち"],["の"],["外","そと"],["の"],["、"],["水","みず"],["の"],["井戸","いど"],["の"],["そば"],["に"],["伏させた","ふさせた"],["。"],["時","とき"],["は"],["夕暮","ゆうぐれ"],["で"],["、"],["女","おんな"],["たち"],["が"],["水","みず"],["を"],["くみ"],["に"],["出る","でる"],["時刻","じこく"],["で"],["あった"],["。"]]},{"verse":12,"text":"彼,かれは言,いった、「主人,しゅじんアブラハムの神,かみ、主,しゅよ、どうか、きょう、わたしにしあわせを授,さづけ、主人,しゅじんアブラハムに恵,めぐみを施,ほどこしてください。","tok":[["彼","かれ"],["は"],["言った","いった"],["、"],["「"],["主人","しゅじん"],["アブラハム"],["の"],["神","かみ"],["、"],["主","しゅ"],["よ"],["、"],["どう"],["か"],["、"],["きょう"],["、"],["わたし"],["に"],["しあわせ"],["を"],["授","さ"],["づけ"],["、"],["主人","しゅじん"],["アブラハム"],["に"],["恵","めぐみ"],["を"],["施して","ほどこして"],["ください"],["。"]]},{"verse":13,"text":"わたしは泉,いずみのそばに立,たっています。町,まちの人々,ひとびとの娘,むすめたちが水,みずをくみに出,でてきたとき、","tok":[["わたし"],["は"],["泉","いずみ"],["の"],["そば"],["に"],["立って","たって"],["います"],["。"],["町","まち"],["の"],["人々","ひとびと"],["の"],["娘","むすめ"],["たち"],["が"],["水","みず"],["を"],["くみ"],["に"],["出て","でて"],["きた"],["とき"],["、"]]},{"verse":14,"text":"娘,むすめに向,むかって『お願,ねがいです、あなたの水,みずがめを傾,かたむけてわたしに飲,のませてください』と言,いい、娘,むすめが答,こたえて、『お飲,のみください。あなたのらくだにも飲,のませましょう』と言,いったなら、その者,ものこそ、あなたがしもべイサクのために定,さだめられた者,ものということにしてください。わたしはこれによって、あなたがわたしの主人,しゅじんに恵,めぐみを施,ほどこされることを知,しりましょう」。","tok":[["娘","むすめ"],["に"],["向かって","むかって"],["『"],["お願い","おねがい"],["です"],["、"],["あなた"],["の"],["水がめ","みずがめ"],["を"],["傾むけて","かたむけて"],["わたし"],["に"],["飲ませて","のませて"],["ください"],["』"],["と"],["言い","いい"],["、"],["娘","むすめ"],["が"],["答","こたえ"],["て"],["、"],["『"],["お飲み","おのみ"],["ください"],["。"],["あなた"],["の"],["らくだ"],["に"],["も"],["飲ませましょう","のませましょう"],["』"],["と"],["言ったなら","いったなら"],["、"],["その"],["者","もの"],["こそ"],["、"],["あなた"],["が"],["しもべ"],["イサク"],["の"],["ため"],["に"],["定められた","さだめられた"],["者","もの"],["と"],["いう"],["こと"],["に"],["して"],["ください"],["。"],["わたし"],["は"],["これ"],["によって"],["、"],["あなた"],["が"],["わたし"],["の"],["主人","しゅじん"],["に"],["恵","めぐみ"],["を"],["施される","ほどこされる"],["こと"],["を"],["知りましょう","しりましょう"],["」"],["。"]]},{"verse":15,"text":"彼,かれがまだ言,いい終,おわらないうちに、アブラハムの兄弟,きょうだいナホルの妻,つまミルカの子,こベトエルの娘,むすめリベカが、水,みずがめを肩,かたに載,のせて出,でてきた。","tok":[["彼","かれ"],["が"],["まだ"],["言い","いい"],["終わらない","おわらない"],["うち"],["に"],["、"],["アブラハム"],["の"],["兄弟","きょうだい"],["ナホル"],["の"],["妻","つま"],["ミルカ"],["の"],["子","こ"],["ベトエル"],["の"],["娘","むすめ"],["リベカ"],["が"],["、"],["水がめ","みずがめ"],["を"],["肩","かた"],["に"],["載せて","のせて"],["出て","でて"],["きた"],["。"]]},{"verse":16,"text":"その娘,むすめは非常,ひじょうに美,うつくしく、男,おとこを知,しらぬ処女,しょじょであった。彼女,かのじょが泉,いずみに降,ふりて、水,みずがめを満,みたし、上,あがってきた時,とき、","tok":[["その"],["娘","むすめ"],["は"],["非常","ひじょう"],["に"],["美しく","うつくしく"],["、"],["男","おとこ"],["を"],["知らぬ","しらぬ"],["処女","しょじょ"],["で"],["あった"],["。"],["彼女","かのじょ"],["が"],["泉","いずみ"],["に"],["降りて","ふりて"],["、"],["水がめ","みずがめ"],["を"],["満たし","みたし"],["、"],["上がって","あがって"],["きた"],["時","とき"],["、"]]},{"verse":17,"text":"しもべは走,はしり寄,よって、彼女,かのじょに会,あって言,いった、「お願,ねがいです。あなたの水,みずがめの水,みずを少,すこし飲,のませてください」。","tok":[["しもべ"],["は"],["走り寄って","はしりよって"],["、"],["彼女","かのじょ"],["に"],["会って","あって"],["言った","いった"],["、"],["「"],["お願い","おねがい"],["です"],["。"],["あなた"],["の"],["水がめ","みずがめ"],["の"],["水","みず"],["を"],["少し","すこし"],["飲ませて","のませて"],["ください"],["」"],["。"]]},{"verse":18,"text":"すると彼女,かのじょは「わが主,しゅよ、お飲,のみください」と言,いって、急,いそいで水,みずがめを自分,じぶんの手,てに取,とりおろして彼,かれに飲,のませた。","tok":[["する"],["と"],["彼女","かのじょ"],["は"],["「"],["わが"],["主","しゅ"],["よ"],["、"],["お飲み","おのみ"],["ください"],["」"],["と"],["言って","いって"],["、"],["急いで","いそいで"],["水がめ","みずがめ"],["を"],["自分","じぶん"],["の"],["手","て"],["に"],["取","とり"],["おろして"],["彼","かれ"],["に"],["飲ませた","のませた"],["。"]]},{"verse":19,"text":"飲,のませ終,おわって、彼女,かのじょは言,いった、「あなたのらくだもみな飲,のみ終,おわるまで、わたしは水,みずをくみましょう」。","tok":[["飲ませ","のませ"],["終わって","おわって"],["、"],["彼女","かのじょ"],["は"],["言った","いった"],["、"],["「"],["あなた"],["の"],["らくだ"],["も"],["みな"],["飲み","のみ"],["終わる","おわる"],["まで"],["、"],["わたし"],["は"],["水","みず"],["を"],["くみましょう"],["」"],["。"]]},{"verse":20,"text":"彼女,かのじょは急,いそいでかめの水,みずを水,みずぶねにあけ、再,ふたたび水,みずをくみに井戸,いどに走,はしって行,いって、すべてのらくだのために水,みずをくんだ。","tok":[["彼女","かのじょ"],["は"],["急いで","いそいで"],["かめ"],["の"],["水","みず"],["を"],["水","みず"],["ぶね"],["に"],["あけ"],["、"],["再び","ふたたび"],["水","みず"],["を"],["くみ"],["に"],["井戸","いど"],["に"],["走って","はしって"],["行って","いって"],["、"],["すべて"],["の"],["らくだ"],["の"],["ため"],["に"],["水","みず"],["を"],["くんだ"],["。"]]},{"verse":21,"text":"その間,かんその人,ひとは主,しゅが彼,かれの旅,たびの祝福,しゅくふくされるか、どうかを知,しろうと、黙,だまって彼女,かのじょを見,みつめていた。","tok":[["その"],["間","かんそ"],["の"],["人","ひと"],["は"],["主","しゅ"],["が"],["彼","かれ"],["の"],["旅","たび"],["の"],["祝福","しゅくふく"],["される"],["か"],["、"],["どう"],["か"],["を"],["知ろう","しろう"],["と"],["、"],["黙って","だまって"],["彼女","かのじょ"],["を"],["見つめて","みつめて"],["いた"],["。"]]},{"verse":22,"text":"らくだが飲,のみ終,おわったとき、その人,ひとは重,おもさ半,はんシケルの金,きんの鼻輪,はなわ一つと、重,おもさ十シケルの金,きんの腕輪,うでわ二つを取,とって、","tok":[["らくだ"],["が"],["飲み","のみ"],["終わった","おわった"],["とき"],["、"],["その"],["人","ひと"],["は"],["重さ","おもさ"],["半","はん"],["シケル"],["の"],["金","きん"],["の"],["鼻輪","はなわ"],["一","ひと"],["つ"],["と"],["、"],["重さ","おもさ"],["十","じゅう"],["シケル"],["の"],["金","きん"],["の"],["腕輪","うでわ"],["二","ふた"],["つ"],["を"],["取って","とって"],["、"]]},{"verse":23,"text":"言,いった、「あなたはだれの娘,むすめか、わたしに話,はなしてください。あなたの父,ちちの家,いえにわたしどもの泊,とまる場所,ばしょがありましょうか」。","tok":[["言った","いった"],["、"],["「"],["あなた"],["は"],["だれ"],["の"],["娘","むすめ"],["か"],["、"],["わたし"],["に"],["話","はなし"],["て"],["ください"],["。"],["あなた"],["の"],["父","ちち"],["の"],["家","いえ"],["に"],["わたし"],["ども"],["の"],["泊まる","とまる"],["場所","ばしょ"],["が"],["ありましょう"],["か"],["」"],["。"]]},{"verse":24,"text":"彼女,かのじょは彼,かれに言,いった、「わたしはナホルの妻,つまミルカの子,こベトエルの娘,むすめです」。","tok":[["彼女","かのじょ"],["は"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["わたし"],["は"],["ナホル"],["の"],["妻","つま"],["ミルカ"],["の"],["子","こ"],["ベトエル"],["の"],["娘","むすめ"],["です"],["」"],["。"]]},{"verse":25,"text":"また彼,かれに言,いった、「わたしどもには、わらも、飼葉,かいばもたくさんあります。また泊,とまる場所,ばしょもあります」。","tok":[["また"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["わたし"],["ども"],["に"],["は"],["、"],["わら"],["も"],["、"],["飼葉","かいば"],["も"],["たくさん"],["あります"],["。"],["また"],["泊まる","とまる"],["場所","ばしょ"],["も"],["あります"],["」"],["。"]]},{"verse":26,"text":"その人,ひとは頭,とうを下,さげ、主,しゅを拝,はいして、","tok":[["その"],["人","ひと"],["は"],["頭","とう"],["を"],["下げ","さげ"],["、"],["主","しゅ"],["を"],["拝して","はいして"],["、"]]},{"verse":27,"text":"言,いった、「主人,しゅじんアブラハムの神,かみ、主,しゅはほむべきかな。主,しゅはわたしの主人,しゅじんにいつくしみと、まこととを惜,おしまれなかった。そして主,しゅは旅,たびにあるわたしを主人,しゅじんの兄弟,きょうだいの家,いえに導,みちびかれた」。","tok":[["言った","いった"],["、"],["「"],["主人","しゅじん"],["アブラハム"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["ほ"],["むべき"],["か"],["な"],["。"],["主","しゅ"],["は"],["わたし"],["の"],["主人","しゅじん"],["に"],["いつくしみ"],["と"],["、"],["まこと"],["と"],["を"],["惜まれなかった","おしまれなかった"],["。"],["そして"],["主","しゅ"],["は"],["旅","たび"],["に"],["ある"],["わたし"],["を"],["主人","しゅじん"],["の"],["兄弟","きょうだい"],["の"],["家","いえ"],["に"],["導かれた","みちびかれた"],["」"],["。"]]},{"verse":28,"text":"娘,むすめは走,はしって行,いって、母,ははの家,いえのものにこれらの事,ことを告,つげた。","tok":[["娘","むすめ"],["は"],["走って","はしって"],["行って","いって"],["、"],["母","はは"],["の"],["家","いえ"],["の"],["もの"],["に"],["これ"],["ら"],["の"],["事","こと"],["を"],["告","つげ"],["た"],["。"]]},{"verse":29,"text":"リベカにひとりの兄,あにがあって、名,なをラバンといった。ラバンは泉,いずみのそばにいるその人,ひとの所,ところへ走,はしって行,いった。","tok":[["リベカ"],["に"],["ひとり"],["の"],["兄","あに"],["が"],["あって"],["、"],["名","な"],["を"],["ラバン"],["と"],["いった"],["。"],["ラバン"],["は"],["泉","いずみ"],["の"],["そば"],["に"],["いる"],["その"],["人","ひと"],["の"],["所","ところ"],["へ"],["走って","はしって"],["行った","いった"],["。"]]},{"verse":30,"text":"彼,かれは鼻輪,はなわと妹,いもうとの手,てにある腕輪,うでわとを見,み、また妹,いもうとリベカが「その人,ひとはわたしにこう言,いった」というのを聞,きいて、その人,ひとの所,ところへ行,いってみると、その人,ひとは泉,いずみのほとりで、らくだのそばに立,たっていた。","tok":[["彼","かれ"],["は"],["鼻輪","はなわ"],["と"],["妹","いもうと"],["の"],["手","て"],["に"],["ある"],["腕輪","うでわ"],["と"],["を"],["見","み"],["、"],["また"],["妹","いもうと"],["リベカ"],["が"],["「"],["その"],["人","ひと"],["は"],["わたし"],["に"],["こう"],["言った","いった"],["」"],["と"],["いう"],["の"],["を"],["聞いて","きいて"],["、"],["その"],["人","ひと"],["の"],["所","ところ"],["へ"],["行って","いって"],["みる"],["と"],["、"],["その"],["人","ひと"],["は"],["泉","いずみ"],["の"],["ほとり"],["で"],["、"],["らくだ"],["の"],["そば"],["に"],["立って","たって"],["いた"],["。"]]},{"verse":31,"text":"そこでその人,ひとに言,いった、「主,しゅに祝福,しゅくふくされた人,ひとよ、おはいりください。なぜ外,そとに立,たっておられますか。わたしは家,いえを準備,じゅんびし、らくだのためにも場所,ばしょを準備,じゅんびしておきました」。","tok":[["そこ"],["で"],["その"],["人","ひと"],["に"],["言った","いった"],["、"],["「"],["主に","しゅに"],["祝福","しゅくふく"],["された"],["人","ひと"],["よ"],["、"],["おはいり"],["ください"],["。"],["なぜ"],["外","そと"],["に"],["立って","たって"],["おられます"],["か"],["。"],["わたし"],["は"],["家","いえ"],["を"],["準備","じゅんび"],["し"],["、"],["らくだ"],["の"],["ため"],["に"],["も"],["場所","ばしょ"],["を"],["準備","じゅんび"],["して"],["おきました"],["」"],["。"]]},{"verse":32,"text":"その人,ひとは家,いえにはいった。ラバンはらくだの荷,にを解,といて、わらと飼葉,かいばをらくだに与,あたえ、また水,みずを与,あたえてその人,ひとの足,あしと、その従者,じゅうしゃたちの足,あしを洗,あらわせた。","tok":[["その"],["人","ひと"],["は"],["家","いえ"],["に"],["はいった"],["。"],["ラバン"],["は"],["らくだ"],["の"],["荷","に"],["を"],["解いて","といて"],["、"],["わら"],["と"],["飼葉","かいば"],["を"],["らくだ"],["に"],["与","あたえ"],["、"],["また"],["水","みず"],["を"],["与","あたえ"],["て"],["その"],["人","ひと"],["の"],["足","あし"],["と"],["、"],["その"],["従者","じゅうしゃ"],["たち"],["の"],["足","あし"],["を"],["洗わせた","あらわせた"],["。"]]},{"verse":33,"text":"そして彼,かれの前,まえに食物,しょくもつを供,そなえたが、彼,かれは言,いった、「わたしは用向,ようむきを話,はなすまでは食,たべません」。ラバンは言,いった、「お話,はなしください」。","tok":[["そして"],["彼","かれ"],["の"],["前","まえ"],["に"],["食物","しょくもつ"],["を"],["供えた","そなえた"],["が"],["、"],["彼","かれ"],["は"],["言った","いった"],["、"],["「"],["わたし"],["は"],["用向","ようむき"],["を"],["話す","はなす"],["まで"],["は"],["食べません","たべません"],["」"],["。"],["ラバン"],["は"],["言った","いった"],["、"],["「"],["お話","おはなし"],["ください"],["」"],["。"]]},{"verse":34,"text":"そこで彼,かれは言,いった、「わたしはアブラハムのしもべです。","tok":[["そこ"],["で"],["彼","かれ"],["は"],["言った","いった"],["、"],["「"],["わたし"],["は"],["アブラハム"],["の"],["しもべ"],["です"],["。"]]},{"verse":35,"text":"主,しゅはわたしの主人,しゅじんを大,おおいに祝福,しゅくふくして、大,おおいなる者,ものとされました。主,しゅはまた彼,かれに羊,ひつじ、牛,うし、銀,ぎん、金,きん、男女,だんじょの奴隷,どれい、らくだ、ろばを与,あたえられました。","tok":[["主","しゅ"],["は"],["わたし"],["の"],["主人","しゅじん"],["を"],["大いに","おおいに"],["祝福","しゅくふく"],["して"],["、"],["大いなる","おおいなる"],["者","もの"],["と"],["されました"],["。"],["主","しゅ"],["は"],["また"],["彼","かれ"],["に"],["羊","ひつじ"],["、"],["牛","うし"],["、"],["銀","ぎん"],["、"],["金","きん"],["、"],["男女","だんじょ"],["の"],["奴隷","どれい"],["、"],["らく"],["だ"],["、"],["ろば"],["を"],["与えられました","あたえられました"],["。"]]},{"verse":36,"text":"主人,しゅじんの妻,つまサラは年老,としおいてから、主人,しゅじんに男,おとこの子,こを産,うみました。主人,しゅじんはその所有,しょゆうを皆,みなこれに与,あたえました。","tok":[["主人","しゅじん"],["の"],["妻","つま"],["サラ"],["は"],["年老いて","としおいて"],["から"],["、"],["主人","しゅじん"],["に"],["男の子","おとこのこ"],["を"],["産みました","うみました"],["。"],["主人","しゅじん"],["は"],["その"],["所有","しょゆう"],["を"],["皆","みな"],["これ"],["に"],["与","あたえ"],["ました"],["。"]]},{"verse":37,"text":"ところで主人,しゅじんはわたしに誓,ちかわせて言,いいました、『わたしの住,すんでいる地,ちのカナンびとの娘,むすめを、わたしの子,この妻,つまにめとってはならない。","tok":[["ところ"],["で"],["主人","しゅじん"],["は"],["わたし"],["に"],["誓わせて","ちかわせて"],["言いました","いいました"],["、"],["『"],["わたし"],["の"],["住んで","すんで"],["いる"],["地","ち"],["の"],["カナン"],["びと"],["の"],["娘","むすめ"],["を"],["、"],["わたし"],["の"],["子","こ"],["の"],["妻","つま"],["に"],["めとって"],["は"],["ならない"],["。"]]},{"verse":38,"text":"おまえはわたしの父,ちちの家,いえ、親族,しんぞくの所,ところへ行,いって、わたしの子,こに妻,つまをめとらなければならない』。","tok":[["おまえ"],["は"],["わたし"],["の"],["父","ちち"],["の"],["家","いえ"],["、"],["親族","しんぞく"],["の"],["所","ところ"],["へ"],["行って","いって"],["、"],["わたし"],["の"],["子","こ"],["に"],["妻","つま"],["を"],["めとらなければ"],["ならない"],["』"],["。"]]},{"verse":39,"text":"わたしは主人,しゅじんに言,いいました、『もしその女,おんながわたしについてこない時,ときはどういたしましょうか』。","tok":[["わたし"],["は"],["主人","しゅじん"],["に"],["言いました","いいました"],["、"],["『"],["もし"],["その"],["女","おんな"],["が"],["わたし"],["について"],["こない"],["時","とき"],["は"],["どう"],["いたしましょう"],["か"],["』"],["。"]]},{"verse":40,"text":"主人,しゅじんはわたしに言,いいました、『わたしの仕,つかえている主,しゅは、み使,つかいをおまえと一緒,いっしょにつかわして、おまえの旅,たびにさいわいを与,あたえられるであろう。おまえはわたしの親族,しんぞく、わたしの父,ちちの家,いえからわたしの子,こに妻,つまをめとらなければならない。","tok":[["主人","しゅじん"],["は"],["わたし"],["に"],["言いました","いいました"],["、"],["『"],["わたし"],["の"],["仕えて","つかえて"],["いる"],["主","しゅ"],["は"],["、"],["み使","みつかい"],["を"],["おまえ"],["と"],["一緒","いっしょ"],["に"],["つかわして"],["、"],["おまえ"],["の"],["旅","たび"],["に"],["さいわい"],["を"],["与えられるで","あたえられるで"],["あろう"],["。"],["おまえ"],["は"],["わたし"],["の"],["親族","しんぞく"],["、"],["わたし"],["の"],["父","ちち"],["の"],["家","いえ"],["から"],["わたし"],["の"],["子","こ"],["に"],["妻","つま"],["を"],["めとらなければ"],["ならない"],["。"]]},{"verse":41,"text":"そのとき、おまえはわたしにした誓,ちかいから解,とかれるであろう。またおまえがわたしの親族,しんぞくに行,いく時,とき、彼,かれらがおまえにその娘,むすめを与,あたえないなら、おまえはわたしにした誓,ちかいから解,とかれるであろう』。","tok":[["その"],["とき"],["、"],["おまえ"],["は"],["わたし"],["に"],["した"],["誓い","ちかい"],["から"],["解かれるで","とかれるで"],["あろう"],["。"],["また"],["おまえ"],["が"],["わたし"],["の"],["親族","しんぞく"],["に"],["行く","いく"],["時","とき"],["、"],["彼","かれ"],["ら"],["が"],["おまえ"],["に"],["その"],["娘","むすめ"],["を"],["与えないなら","あたえないなら"],["、"],["おまえ"],["は"],["わたし"],["に"],["した"],["誓い","ちかい"],["から"],["解かれるで","とかれるで"],["あろう"],["』"],["。"]]},{"verse":42,"text":"わたしはきょう、泉,いずみのところにきて言,いいました、『主人,しゅじんアブラハムの神,かみ、主,しゅよ、どうか今,いまわたしのゆく道,みちにさいわいを与,あたえてください。","tok":[["わたし"],["は"],["きょう"],["、"],["泉","いずみ"],["の"],["ところ"],["に"],["きて"],["言いました","いいました"],["、"],["『"],["主人","しゅじん"],["アブラハム"],["の"],["神","かみ"],["、"],["主","しゅ"],["よ"],["、"],["どう"],["か"],["今","いま"],["わたし"],["の"],["ゆく"],["道","みち"],["に"],["さいわい"],["を"],["与","あたえ"],["て"],["ください"],["。"]]},{"verse":43,"text":"わたしはこの泉,いずみのそばに立,たっていますが、水,みずをくみに出,でてくる娘,むすめに向,むかって、「お願,ねがいです。あなたの水,みずがめの水,みずを少,すこし飲,のませてください」と言,いい、","tok":[["わたし"],["は"],["この"],["泉","いずみ"],["の"],["そば"],["に"],["立って","たって"],["います"],["が"],["、"],["水","みず"],["を"],["くみ"],["に"],["出て","でて"],["くる"],["娘","むすめ"],["に"],["向かって","むかって"],["、"],["「"],["お願い","おねがい"],["です"],["。"],["あなた"],["の"],["水がめ","みずがめ"],["の"],["水","みず"],["を"],["少し","すこし"],["飲ませて","のませて"],["ください"],["」"],["と"],["言い","いい"],["、"]]},{"verse":44,"text":"「お飲,のみください。あなたのらくだのためにも、くみましょう」とわたしに言,いうなら、その娘,むすめこそ、主,しゅがわたしの主人,しゅじんの子,このために定,さだめられた女,おんなということにしてください』。","tok":[["「"],["お飲み","おのみ"],["ください"],["。"],["あなた"],["の"],["らくだ"],["の"],["ため"],["に"],["も"],["、"],["くみましょう"],["」"],["と"],["わたし"],["に"],["言","いうな"],["ら"],["、"],["その"],["娘","むすめ"],["こそ"],["、"],["主","しゅ"],["が"],["わたし"],["の"],["主人","しゅじん"],["の"],["子","こ"],["の"],["ため"],["に"],["定められた","さだめられた"],["女","おんな"],["と"],["いう"],["こと"],["に"],["して"],["ください"],["』"],["。"]]},{"verse":45,"text":"わたしが心,こころのうちでそう言,いい終,おわらないうちに、リベカが水,みずがめを肩,かたに載,のせて出,でてきて、水,みずをくみに泉,いずみに降,ふりたので、わたしは『お願,ねがいです、飲,のませてください』と言,いいますと、","tok":[["わたし"],["が"],["心","こころ"],["の"],["うち"],["で"],["そう"],["言い","いい"],["終わらない","おわらない"],["うち"],["に"],["、"],["リベカ"],["が"],["水がめ","みずがめ"],["を"],["肩","かた"],["に"],["載せて","のせて"],["出て","でて"],["きて"],["、"],["水","みず"],["を"],["くみ"],["に"],["泉","いずみ"],["に"],["降","ふりた"],["ので"],["、"],["わたし"],["は"],["『"],["お願い","おねがい"],["です"],["、"],["飲ませて","のませて"],["ください"],["』"],["と"],["言います","いいます"],["と"],["、"]]},{"verse":46,"text":"彼女,かのじょは急,いそいで水,みずがめを肩,かたからおろし、『お飲,のみください。わたしはあなたのらくだにも飲,のませましょう』と言,いいました。それでわたしは飲,のみましたが、彼女,かのじょはらくだにも飲,のませました。","tok":[["彼女","かのじょ"],["は"],["急いで","いそいで"],["水がめ","みずがめ"],["を"],["肩","かた"],["から"],["おろし"],["、"],["『"],["お飲み","おのみ"],["ください"],["。"],["わたし"],["は"],["あなた"],["の"],["らくだ"],["に"],["も"],["飲ませましょう","のませましょう"],["』"],["と"],["言いました","いいました"],["。"],["それ"],["で"],["わたし"],["は"],["飲みました","のみました"],["が"],["、"],["彼女","かのじょ"],["は"],["らくだ"],["に"],["も"],["飲ませました","のませました"],["。"]]},{"verse":47,"text":"わたしは彼女,かのじょに尋,たずねて、『あなたはだれの娘,むすめですか』と言,いいますと、『ナホルとその妻,つまミルカの子,こベトエルの娘,むすめです』と答,こたえました。そこでわたしは彼女,かのじょの鼻,はなに鼻輪,はなわをつけ、手,てに腕輪,うでわをつけました。","tok":[["わたし"],["は"],["彼女","かのじょ"],["に"],["尋ねて","たずねて"],["、"],["『"],["あなた"],["は"],["だれ"],["の"],["娘","むすめ"],["です"],["か"],["』"],["と"],["言います","いいます"],["と"],["、"],["『"],["ナホル"],["と"],["その"],["妻","つま"],["ミルカ"],["の"],["子","こ"],["ベトエル"],["の"],["娘","むすめ"],["です"],["』"],["と"],["答","こたえ"],["ました"],["。"],["そこ"],["で"],["わたし"],["は"],["彼女","かのじょ"],["の"],["鼻","はな"],["に"],["鼻輪","はなわ"],["を"],["つけ"],["、"],["手","て"],["に"],["腕輪","うでわ"],["を"],["つけました"],["。"]]},{"verse":48,"text":"そしてわたしは頭,あたまをさげて主,しゅを拝,はいし、主人,しゅじんアブラハムの神,かみ、主,しゅをほめたたえました。主,しゅは主人,しゅじんの兄弟,きょうだいの娘,むすめを子,こにめとらせようと、わたしを正,ただしい道,みちに導,みちびかれたからです。","tok":[["そして"],["わたし"],["は"],["頭","あたま"],["を"],["さげて"],["主","しゅ"],["を"],["拝し","はいし"],["、"],["主人","しゅじん"],["アブラハム"],["の"],["神","かみ"],["、"],["主","しゅ"],["を"],["ほめたたえました"],["。"],["主","しゅ"],["は"],["主人","しゅじん"],["の"],["兄弟","きょうだい"],["の"],["娘","むすめ"],["を"],["子","こ"],["に"],["めとらせよう"],["と"],["、"],["わたし"],["を"],["正い","ただしい"],["道","みち"],["に"],["導かれた","みちびかれた"],["から"],["です"],["。"]]},{"verse":49,"text":"あなたがたが、もしわたしの主人,しゅじんにいつくしみと、まことを尽,つくそうと思,おもわれるなら、そうとわたしにお話,はなしください。そうでなければ、そうでないとお話,はなしください。それによってわたしは右,みぎか左,ひだりに決,きめましょう」。","tok":[["あなた"],["が"],["た"],["が"],["、"],["もし"],["わたし"],["の"],["主人","しゅじん"],["に"],["いつくしみ"],["と"],["、"],["まこと"],["を"],["尽くそう","つくそう"],["と"],["思われるなら","おもわれるなら"],["、"],["そう"],["と"],["わたし"],["に"],["お話","おはなし"],["ください"],["。"],["そう"],["で"],["なければ"],["、"],["そう"],["で"],["ない"],["と"],["お話","おはなし"],["ください"],["。"],["それ"],["によって"],["わたし"],["は"],["右","みぎ"],["か"],["左","ひだり"],["に"],["決めましょう","きめましょう"],["」"],["。"]]},{"verse":50,"text":"ラバンとベトエルは答,こたえて言,いった、「この事,ことは主,しゅから出,でたことですから、わたしどもはあなたによしあしを言,いうことができません。","tok":[["ラバン"],["と"],["ベトエル"],["は"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["この"],["事","こと"],["は"],["主ら","しゅから"],["出た","でた"],["こと"],["です"],["から"],["、"],["わたし"],["ども"],["は"],["あなた"],["に"],["よしあし"],["を"],["言う","いう"],["こと"],["が"],["できません"],["。"]]},{"verse":51,"text":"リベカがここにおりますから連,つれて行,いって、主,しゅが言,いわれたように、あなたの主人,しゅじんの子,この妻,つまにしてください」。","tok":[["リベカ"],["が"],["ここ"],["に"],["おります"],["から"],["連れて","つれて"],["行って","いって"],["、"],["主","しゅ"],["が"],["言われた","いわれた"],["よう"],["に"],["、"],["あなた"],["の"],["主人","しゅじん"],["の"],["子","こ"],["の"],["妻","つま"],["に"],["して"],["ください"],["」"],["。"]]},{"verse":52,"text":"アブラハムのしもべは彼,かれらの言葉,ことばを聞,きいて、地,ちに伏,ふし、主,しゅを拝,はいした。","tok":[["アブラハム"],["の"],["しもべ"],["は"],["彼","かれ"],["ら"],["の"],["言葉","ことば"],["を"],["聞いて","きいて"],["、"],["地","ち"],["に"],["伏し","ふし"],["、"],["主","しゅ"],["を"],["拝した","はいした"],["。"]]},{"verse":53,"text":"そしてしもべは銀,ぎんの飾,かざりと、金,きんの飾,かざり、および衣服,いふくを取,とり出,だしてリベカに与,あたえ、その兄,あにと母,ははとにも価,あたいの高,たかい品々,しなじなを与,あたえた。","tok":[["そして"],["しもべ"],["は"],["銀","ぎん"],["の"],["飾","かざり"],["と"],["、"],["金","きん"],["の"],["飾","かざり"],["、"],["および"],["衣服","いふく"],["を"],["取出して","とりだして"],["リベカ"],["に"],["与","あたえ"],["、"],["その"],["兄","あに"],["と"],["母","はは"],["と"],["に"],["も"],["価","あたい"],["の"],["高い","たかい"],["品々","しなじな"],["を"],["与","あたえ"],["た"],["。"]]},{"verse":54,"text":"彼,かれと従者,じゅうしゃたちは飲,のみ食,くいして宿,やどったが、あくる朝,あさ彼,かれらが起,おきた時,とき、しもべは言,いった、「わたしを主人,しゅじんのもとに帰,かえらせてください」。","tok":[["彼","かれ"],["と"],["従者","じゅうしゃ"],["たち"],["は"],["飲み食い","のみくい"],["して"],["宿った","やどった"],["が"],["、"],["あくる"],["朝","あさ"],["彼","かれ"],["ら"],["が"],["起きた","おきた"],["時","とき"],["、"],["しもべ"],["は"],["言った","いった"],["、"],["「"],["わたし"],["を"],["主人","しゅじん"],["の"],["もと"],["に"],["帰えらせて","かえらせて"],["ください"],["」"],["。"]]},{"verse":55,"text":"リベカの兄,あにと母,ははとは言,いった、「娘,むすめは数日,すうじつ、少,すくなくとも十日,か、わたしどもと共,ともにいて、それから行,いかせましょう」。","tok":[["リベカ"],["の"],["兄","あに"],["と"],["母","はは"],["と"],["は"],["言った","いった"],["、"],["「"],["娘","むすめ"],["は"],["数日","すうじつ"],["、"],["少く","すくなく"],["とも"],["十日","か"],["、"],["わたし"],["ども"],["と"],["共","とも"],["に"],["いて"],["、"],["それ"],["から"],["行かせましょう","いかせましょう"],["」"],["。"]]},{"verse":56,"text":"しもべは彼,かれらに言,いった、「主,しゅはわたしの道,みちにさいわいを与,あたえられましたから、わたしを引,ひきとめずに、主人,しゅじんのもとに帰,かえらせてください」。","tok":[["しもべ"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["主","しゅ"],["は"],["わたし"],["の"],["道","みち"],["に"],["さいわい"],["を"],["与えられました","あたえられました"],["から"],["、"],["わたし"],["を"],["引","ひき"],["とめず"],["に"],["、"],["主人","しゅじん"],["の"],["もと"],["に"],["帰えらせて","かえらせて"],["ください"],["」"],["。"]]},{"verse":57,"text":"彼,かれらは言,いった、「娘,むすめを呼,よんで聞,きいてみましょう」。","tok":[["彼","かれ"],["ら"],["は"],["言った","いった"],["、"],["「"],["娘","むすめ"],["を"],["呼んで","よんで"],["聞いて","きいて"],["みましょう"],["」"],["。"]]},{"verse":58,"text":"彼,かれらはリベカを呼,よんで言,いった、「あなたはこの人,ひとと一緒,いっしょに行,いきますか」。彼女,かのじょは言,いった、「行,いきます」。","tok":[["彼","かれ"],["ら"],["は"],["リベカ"],["を"],["呼んで","よんで"],["言った","いった"],["、"],["「"],["あなた"],["は"],["この"],["人","ひと"],["と"],["一緒","いっしょ"],["に"],["行きます","いきます"],["か"],["」"],["。"],["彼女","かのじょ"],["は"],["言った","いった"],["、"],["「"],["行きます","いきます"],["」"],["。"]]},{"verse":59,"text":"そこで彼,かれらは妹,いもうとリベカと、そのうばと、アブラハムのしもべと、その従者,じゅうしゃとを送,おくり去,さらせた。","tok":[["そこ"],["で"],["彼","かれ"],["ら"],["は"],["妹","いもうと"],["リベカ"],["と"],["、"],["その"],["うば"],["と"],["、"],["アブラハム"],["の"],["しもべ"],["と"],["、"],["その"],["従者","じゅうしゃ"],["と"],["を"],["送り","おくり"],["去らせた","さらせた"],["。"]]},{"verse":60,"text":"彼,かれらはリベカを祝福,しゅくふくして彼女,かのじょに言,いった、「妹,いもうとよ、あなたは、ちよろずの人,ひとの母,ははとなれ。あなたの子孫,しそんはその敵,てきの門,もんを打,うち取,とれ」。","tok":[["彼","かれ"],["ら"],["は"],["リベカ"],["を"],["祝福","しゅくふく"],["して"],["彼女","かのじょ"],["に"],["言った","いった"],["、"],["「"],["妹","いもうと"],["よ"],["、"],["あなた"],["は"],["、"],["ち"],["よろず"],["の"],["人","ひと"],["の"],["母","はは"],["と"],["なれ"],["。"],["あなた"],["の"],["子孫","しそん"],["は"],["その"],["敵","てき"],["の"],["門","もん"],["を"],["打ち取れ","うちとれ"],["」"],["。"]]},{"verse":61,"text":"リベカは立,たって侍女,じじょたちと共,ともにらくだに乗,のり、その人,ひとに従,したがって行,いった。しもべはリベカを連,つれて立,たち去,さった。","tok":[["リベカ"],["は"],["立って","たって"],["侍女","じじょ"],["たち"],["と"],["共","とも"],["に"],["らくだ"],["に"],["乗","のり"],["、"],["その"],["人","ひと"],["に"],["従って","したがって"],["行った","いった"],["。"],["しもべ"],["は"],["リベカ"],["を"],["連れて","つれて"],["立ち","たち"],["去た","さった"],["。"]]},{"verse":62,"text":"さてイサクはベエル・ラハイ・ロイからきて、ネゲブの地,ちに住,すんでいた。","tok":[["さて"],["イサク"],["は"],["ベエル"],["・"],["ラハイ"],["・"],["ロイ"],["から"],["きて"],["、"],["ネゲブ"],["の"],["地","ち"],["に"],["住んで","すんで"],["いた"],["。"]]},{"verse":63,"text":"イサクは夕暮,ゆうぐれ、野,のに出,でて歩,あるいていたが、目,めをあげて、らくだの来,くるのを見,みた。","tok":[["イサク"],["は"],["夕暮","ゆうぐれ"],["、"],["野","の"],["に"],["出て","でて"],["歩いて","あるいて"],["いた"],["が"],["、"],["目","め"],["を"],["あげて"],["、"],["らくだ"],["の"],["来る","くる"],["の"],["を"],["見た","みた"],["。"]]},{"verse":64,"text":"リベカは目,めをあげてイサクを見,み、らくだからおりて、","tok":[["リベカ"],["は"],["目","め"],["を"],["あげて"],["イサク"],["を"],["見","み"],["、"],["らく"],["だ"],["から"],["おりて"],["、"]]},{"verse":65,"text":"しもべに言,いった、「わたしたちに向,むかって、野,のを歩,あるいて来,くるあの人,ひとはだれでしょう」。しもべは言,いった、「あれはわたしの主人,しゅじんです」。するとリベカは、被衣,かずきで身,みをおおった。","tok":[["しもべ"],["に"],["言った","いった"],["、"],["「"],["わたしたち"],["に"],["向かって","むかって"],["、"],["野","の"],["を"],["歩いて","あるいて"],["来る","くる"],["あの"],["人","ひと"],["は"],["だれ"],["でしょう"],["」"],["。"],["しもべ"],["は"],["言った","いった"],["、"],["「"],["あれ"],["は"],["わたし"],["の"],["主人","しゅじん"],["です"],["」"],["。"],["する"],["と"],["リベカ"],["は"],["、"],["被衣","か"],["ずき"],["で"],["身","み"],["を"],["おおった"],["。"]]},{"verse":66,"text":"しもべは自分,じぶんがしたことのすべてをイサクに話,はなした。","tok":[["しもべ"],["は"],["自分","じぶん"],["が"],["した"],["こと"],["の"],["すべて"],["を"],["イサク"],["に"],["話","はなし"],["た"],["。"]]},{"verse":67,"text":"イサクはリベカを天幕,てんまくに連,つれて行,いき、リベカをめとって妻,つまとし、彼女,かのじょを愛,あいした。こうしてイサクは母,ははの死後,しご、慰,なぐさめを得,えた。","tok":[["イサク"],["は"],["リベカ"],["を"],["天幕","てんまく"],["に"],["連れて","つれて"],["行き","いき"],["、"],["リベカ"],["を"],["めとって"],["妻","つま"],["と"],["し"],["、"],["彼女","かのじょ"],["を"],["愛した","あいした"],["。"],["こう"],["して"],["イサク"],["は"],["母","はは"],["の"],["死後","しご"],["、"],["慰さめ","なぐさめ"],["を"],["得た","えた"],["。"]]}]
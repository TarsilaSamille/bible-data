[{"verse":1,"text":"これらの事,ことの後,のち、エジプト王,おうの給仕,きゅうじ役,やくと料理,りょうり役,やくとがその主君,しゅくんエジプト王,おうに罪,つみを犯,おかした。","tok":[["これ"],["ら"],["の"],["事","こと"],["の"],["後","の"],["ち"],["、"],["エジプト"],["王","おう"],["の"],["給仕","きゅうじ"],["役","やく"],["と"],["料理","りょうり"],["役","やく"],["と"],["が"],["その"],["主君","しゅくん"],["エジプト"],["王","おう"],["に"],["罪","つみ"],["を"],["犯した","おかした"],["。"]]},{"verse":2,"text":"パロはふたりの役人,やくにん、すなわち給仕,きゅうじ役,やくの長,ちょうと料理,りょうり役,やくの長,ちょうに向,むかって憤,いきどおり、","tok":[["パロ"],["は"],["ふたり"],["の"],["役人","やくにん"],["、"],["すなわち"],["給仕","きゅうじ"],["役","やく"],["の"],["長","ちょう"],["と"],["料理","りょうり"],["役","やく"],["の"],["長","ちょう"],["に"],["向かって","むかって"],["憤り","いきどおり"],["、"]]},{"verse":3,"text":"侍衛,じえい長,ちょうの家,いえの監禁所,かんきんじょ、すなわちヨセフがつながれている獄屋,ごくやに入,いれた。","tok":[["侍衛長","じえいちょう"],["の"],["家","いえ"],["の"],["監禁所","かん"],["きん"],["じょ"],["、"],["すなわち"],["ヨセフ"],["が"],["つながれて"],["いる"],["獄屋","ごくや"],["に"],["入れた","いれた"],["。"]]},{"verse":4,"text":"侍衛,じえい長,ちょうはヨセフに命,めいじて彼,かれらと共,ともにおらせたので、ヨセフは彼,かれらに仕,つかえた。こうして彼,かれらは監禁所,かんきんじょで幾日,いくにちかを過,すごした。","tok":[["侍衛長","じえいちょう"],["は"],["ヨセフ"],["に"],["命じて","めいじて"],["彼","かれ"],["ら"],["と"],["共","とも"],["に"],["おらせた"],["ので"],["、"],["ヨセフ"],["は"],["彼","かれ"],["ら"],["に"],["仕えた","つかえた"],["。"],["こう"],["して"],["彼","かれ"],["ら"],["は"],["監禁所","かん"],["きん"],["じょ"],["で"],["幾日","いくにちか"],["を"],["過ごした","すごした"],["。"]]},{"verse":5,"text":"さて獄屋,ごくやにつながれたエジプト王,おうの給仕,きゅうじ役,やくと料理,りょうり役,やくのふたりは一夜,いちやのうちにそれぞれ意味,いみのある夢,ゆめを見,みた。","tok":[["さて"],["獄屋","ごくや"],["に"],["つながれた"],["エジプト"],["王","おう"],["の"],["給仕","きゅうじ"],["役","やく"],["と"],["料理","りょうり"],["役","やく"],["の"],["ふたり"],["は"],["一夜","いちや"],["の"],["うち"],["に"],["それぞれ"],["意味","いみ"],["の"],["ある"],["夢","ゆめ"],["を"],["見た","みた"],["。"]]},{"verse":6,"text":"ヨセフが朝,あさ、彼,かれらのところへ行,いって見,みると、彼,かれらは悲,かなしみに沈,しずんでいた。","tok":[["ヨセフ"],["が"],["朝","あさ"],["、"],["彼","かれ"],["ら"],["の"],["ところ"],["へ"],["行って","いって"],["見る","みる"],["と"],["、"],["彼","かれ"],["ら"],["は"],["悲しみ","かなしみ"],["に"],["沈んで","しずんで"],["いた"],["。"]]},{"verse":7,"text":"そこでヨセフは自分,じぶんと一緒,いっしょに主人,しゅじんの家,いえの監禁所,かんきんじょにいるパロの役人,やくにんたちに尋,たずねて言,いった、「どうして、きょう、あなたがたの顔色,かおいろが悪,わるいのですか」。","tok":[["そこ"],["で"],["ヨセフ"],["は"],["自分","じぶん"],["と"],["一緒","いっしょ"],["に"],["主人","しゅじん"],["の"],["家","いえ"],["の"],["監禁所","かんきんじょ"],["に"],["いる"],["パロ"],["の"],["役人","やくにん"],["たち"],["に"],["尋ねて","たずねて"],["言った","いった"],["、"],["「"],["どう"],["して"],["、"],["きょう"],["、"],["あなた"],["がた"],["の"],["顔色","かおいろ"],["が"],["悪い","わるい"],["の"],["です"],["か"],["」"],["。"]]},{"verse":8,"text":"彼,かれらは言,いった、「わたしたちは夢,ゆめを見,みましたが、解,といてくれる者,ものがいません」。ヨセフは彼,かれらに言,いった、「解,とくことは神,かみによるのではありませんか。どうぞ、わたしに話,はなしてください」。","tok":[["彼","かれ"],["ら"],["は"],["言った","いった"],["、"],["「"],["わたしたち"],["は"],["夢","ゆめ"],["を"],["見ました","みました"],["が"],["、"],["解いて","といて"],["くれる"],["者","もの"],["が"],["いません"],["」"],["。"],["ヨセフ"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["解く","とく"],["こと"],["は"],["神","かみ"],["に"],["よる"],["ので"],["は"],["ありません"],["か"],["。"],["どうぞ"],["、"],["わたし"],["に"],["話","はなし"],["て"],["ください"],["」"],["。"]]},{"verse":9,"text":"給仕,きゅうじ役,やくの長,ちょうはその夢,ゆめをヨセフに話,はなして言,いった、「わたしが見,みた夢,ゆめで、わたしの前,まえに一本,ぽんのぶどうの木,きがありました。","tok":[["給仕","きゅうじ"],["役","やく"],["の"],["長","ちょう"],["は"],["その"],["夢","ゆめ"],["を"],["ヨセフ"],["に"],["話","はなし"],["て"],["言った","いった"],["、"],["「"],["わたし"],["が"],["見た","みた"],["夢","ゆめ"],["で"],["、"],["わたし"],["の"],["前","まえ"],["に"],["一本","ぽん"],["の"],["ぶどう"],["の"],["木","き"],["が"],["ありました"],["。"]]},{"verse":10,"text":"そのぶどうの木,きに三つの枝,えだがあって、芽,めを出,だし、花,はなが咲,さき、ぶどうのふさが熟,じゅくしました。","tok":[["その"],["ぶどう"],["の"],["木","き"],["に"],["三","みっ"],["つ"],["の"],["枝","えだ"],["が"],["あって"],["、"],["芽","め"],["を"],["出し","だし"],["、"],["花","はな"],["が"],["咲","さき"],["、"],["ぶどう"],["の"],["ふさ"],["が"],["熟しました","じゅくしました"],["。"]]},{"verse":11,"text":"時,ときにわたしの手,てに、パロの杯,さかずきがあって、わたしはそのぶどうを取,とり、それをパロの杯,さかずきにしぼり、その杯,さかずきをパロの手,てにささげました」。","tok":[["時","とき"],["に"],["わたし"],["の"],["手","て"],["に"],["、"],["パロ"],["の"],["杯","さかずき"],["が"],["あって"],["、"],["わたし"],["は"],["その"],["ぶどう"],["を"],["取","とり"],["、"],["それ"],["を"],["パロ"],["の"],["杯","さかずき"],["に"],["しぼり"],["、"],["その"],["杯","さかずき"],["を"],["パロ"],["の"],["手","て"],["に"],["ささげました"],["」"],["。"]]},{"verse":12,"text":"ヨセフは言,いった、「その解,とき明,あかしはこうです。三つの枝,えだは三日,かです。","tok":[["ヨセフ"],["は"],["言った","いった"],["、"],["「"],["その"],["解き明かし","ときあかし"],["は"],["こう"],["です"],["。"],["三","みっ"],["つ"],["の"],["枝","えだ"],["は"],["三日","か"],["です"],["。"]]},{"verse":13,"text":"今,いまから三日,かのうちにパロはあなたの頭,あたまを上,あげて、あなたを元,もとの役目,やくめに返,かえすでしょう。あなたはさきに給仕,きゅうじ役,やくだった時,ときにされたように、パロの手,てに杯,さかずきをささげられるでしょう。","tok":[["今","いま"],["から"],["三日","か"],["の"],["うち"],["に"],["パロ"],["は"],["あなた"],["の"],["頭","あたま"],["を"],["上げて","あげて"],["、"],["あなた"],["を"],["元","もと"],["の"],["役目","やくめ"],["に"],["返えすでしょう","かえすでしょう"],["。"],["あなた"],["は"],["さき"],["に"],["給仕","きゅうじ"],["役","やく"],["だった"],["時","とき"],["に"],["された"],["よう"],["に"],["、"],["パロ"],["の"],["手","て"],["に"],["杯","さかずき"],["を"],["ささげられるでしょう"],["。"]]},{"verse":14,"text":"それで、あなたがしあわせになられたら、わたしを覚,おぼえていて、どうかわたしに恵,めぐみを施,ほどこし、わたしの事,ことをパロに話,はなして、この家,いえからわたしを出,だしてください。","tok":[["それ"],["で"],["、"],["あなた"],["が"],["しあわせ"],["に"],["なられたら"],["、"],["わたし"],["を"],["覚えて","おぼえて"],["いて"],["、"],["どう"],["か"],["わたし"],["に"],["恵","めぐみ"],["を"],["施し","ほどこし"],["、"],["わたし"],["の"],["事","こと"],["を"],["パロ"],["に"],["話","はなし"],["て"],["、"],["この"],["家","いえ"],["から"],["わたし"],["を"],["出して","だして"],["ください"],["。"]]},{"verse":15,"text":"わたしは、実,みはヘブルびとの地,ちからさらわれてきた者,ものです。またここでもわたしは地下,ちかの獄屋,ごくやに入,いれられるような事,ことはしなかったのです」。","tok":[["わたし"],["は"],["、"],["実","み"],["は"],["ヘブル"],["びと"],["の"],["地","ち"],["から"],["さらわれて"],["きた"],["者","もの"],["です"],["。"],["また"],["ここ"],["で"],["も"],["わたし"],["は"],["地下","ちか"],["の"],["獄屋","ごくや"],["に"],["入れられる","いれられる"],["よう"],["な"],["事","こと"],["は"],["しなかった"],["の"],["です"],["」"],["。"]]},{"verse":16,"text":"料理,りょうり役,やくの長,ちょうはその解,とき明,あかしの良,よかったのを見,みて、ヨセフに言,いった、「わたしも夢,ゆめを見,みたが、白,しろいパンのかごが三つ、わたしの頭,あたまの上,うえにあった。","tok":[["料理","りょうり"],["役","やく"],["の"],["長","ちょう"],["は"],["その"],["解き明かし","ときあかし"],["の"],["良かった","よかった"],["の"],["を"],["見て","みて"],["、"],["ヨセフ"],["に"],["言った","いった"],["、"],["「"],["わたし"],["も"],["夢","ゆめ"],["を"],["見た","みた"],["が"],["、"],["白い","しろい"],["パン"],["の"],["かご"],["が"],["三","みっ"],["つ"],["、"],["わたし"],["の"],["頭","あたま"],["の"],["上","うえ"],["に"],["あった"],["。"]]},{"verse":17,"text":"一番,ばん上,うえのかごには料理,りょうり役,やくがパロのために作,つくったさまざまの食物,しょくもつがあったが、鳥,とりがわたしの頭,あたまの上,うえのかごからそれを食,たべていた」。","tok":[["一番","ばん"],["上","うえ"],["の"],["かご"],["に"],["は"],["料理","りょうり"],["役","やく"],["が"],["パロ"],["の"],["ため"],["に"],["作った","つくった"],["さまざま"],["の"],["食物","しょくもつ"],["が"],["あった"],["が"],["、"],["鳥","とり"],["が"],["わたし"],["の"],["頭","あたま"],["の"],["上","うえ"],["の"],["かご"],["から"],["それ"],["を"],["食べて","たべて"],["いた"],["」"],["。"]]},{"verse":18,"text":"ヨセフは答,こたえて言,いった、「その解,とき明,あかしはこうです。三つのかごは三日,かです。","tok":[["ヨセフ"],["は"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["その"],["解き明かし","ときあかし"],["は"],["こう"],["です"],["。"],["三","みっ"],["つ"],["の"],["かご"],["は"],["三日","か"],["です"],["。"]]},{"verse":19,"text":"今,いまから三日,かのうちにパロはあなたの頭,あたまを上,あげ離,はなして、あなたを木,きに掛,かけるでしょう。そして鳥,とりがあなたの肉,にくを食,くい取,とるでしょう」。","tok":[["今","いま"],["から"],["三日","か"],["の"],["うち"],["に"],["パロ"],["は"],["あなた"],["の"],["頭","あたま"],["を"],["上げ","あげ"],["離して","はなして"],["、"],["あなた"],["を"],["木","き"],["に"],["掛けるでしょう","かけるでしょう"],["。"],["そして"],["鳥","とり"],["が"],["あなた"],["の"],["肉","にく"],["を"],["食い","くい"],["取るでしょう","とるでしょう"],["」"],["。"]]},{"verse":20,"text":"さて三日,か目,めはパロの誕生,たんじょう日,ひであったので、パロはすべての家来,けらいのためにふるまいを設,もうけ、家来,けらいのうちの給仕,きゅうじ役,やくの長,ちょうの頭,あたまと、料理,りょうり役,やくの長,ちょうの頭,あたまを上,あげた。","tok":[["さて"],["三日目","かめ"],["は"],["パロ"],["の"],["誕生日","たんじょうひ"],["で"],["あった"],["ので"],["、"],["パロ"],["は"],["すべて"],["の"],["家来","けらい"],["の"],["ため"],["に"],["ふるまい"],["を"],["設け","もうけ"],["、"],["家来","けらい"],["の"],["うち"],["の"],["給仕","きゅうじ"],["役","やく"],["の"],["長","ちょう"],["の"],["頭","あたま"],["と"],["、"],["料理","りょうり"],["役","やく"],["の"],["長","ちょう"],["の"],["頭","あたま"],["を"],["上げた","あげた"],["。"]]},{"verse":21,"text":"すなわちパロは給仕,きゅうじ役,やくの長,ちょうを給仕,きゅうじ役,やくの職,しょくに返,かえしたので、彼,かれはパロの手,てに杯,さかずきをささげた。","tok":[["すなわち"],["パロ"],["は"],["給仕","きゅうじ"],["役","やく"],["の"],["長","ちょう"],["を"],["給仕","きゅうじ"],["役","やく"],["の"],["職","しょく"],["に"],["返","かえし"],["た"],["ので"],["、"],["彼","かれ"],["は"],["パロ"],["の"],["手","て"],["に"],["杯","さかずき"],["を"],["ささげた"],["。"]]},{"verse":22,"text":"しかしパロは料理,りょうり役,やくの長,ちょうを木,きに掛,かけた。ヨセフが彼,かれらに解,とき明,あかしたとおりである。","tok":[["しかし"],["パロ"],["は"],["料理","りょうり"],["役","やく"],["の"],["長","ちょう"],["を"],["木","き"],["に"],["掛た","かけた"],["。"],["ヨセフ"],["が"],["彼","かれ"],["ら"],["に"],["解き明かした","ときあかした"],["とおり"],["で"],["ある"],["。"]]},{"verse":23,"text":"ところが、給仕,きゅうじ役,やくの長,ちょうはヨセフを思,おもい出,ださず、忘,わすれてしまった。","tok":[["ところ"],["が"],["、"],["給仕","きゅうじ"],["役","やく"],["の"],["長","ちょう"],["は"],["ヨセフ"],["を"],["思い出さず","おもいださず"],["、"],["忘て","わすれて"],["しまった"],["。"]]}]
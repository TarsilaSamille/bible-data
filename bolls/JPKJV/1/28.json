[{"verse":1,"text":"イサクはヤコブを呼,よんで、これを祝福,しゅくふくし、命,めいじて言,いった、「あなたはカナンの娘,むすめを妻,つまにめとってはならない。","tok":[["イサク"],["は"],["ヤコブ"],["を"],["呼んで","よんで"],["、"],["これ"],["を"],["祝福","しゅくふく"],["し"],["、"],["命じて","めいじて"],["言った","いった"],["、"],["「"],["あなた"],["は"],["カナン"],["の"],["娘","むすめ"],["を"],["妻","つま"],["に"],["めとって"],["は"],["ならない"],["。"]]},{"verse":2,"text":"立,たってパダンアラムへ行,いき、あなたの母,ははの父,ちちベトエルの家,いえに行,いって、そこであなたの母,ははの兄,あにラバンの娘,むすめを妻,つまにめとりなさい。","tok":[["立って","たって"],["パダン"],["アラム"],["へ"],["行き","いき"],["、"],["あなた"],["の"],["母","はは"],["の"],["父","ちち"],["ベトエル"],["の"],["家","いえ"],["に"],["行って","いって"],["、"],["そこ"],["で"],["あなた"],["の"],["母","はは"],["の"],["兄","あに"],["ラバン"],["の"],["娘","むすめ"],["を"],["妻","つま"],["に"],["めとり"],["なさい"],["。"]]},{"verse":3,"text":"全能,ぜんのうの神,かみが、あなたを祝福,しゅくふくし、多,おおくの子,こを得,えさせ、かつふえさせて、多,おおくの国民,こくみんとし、","tok":[["全能","ぜんのう"],["の"],["神","かみ"],["が"],["、"],["あなた"],["を"],["祝福","しゅくふく"],["し"],["、"],["多く","おおく"],["の"],["子","こ"],["を"],["得させ","えさせ"],["、"],["かつ"],["ふえ"],["させて"],["、"],["多く","おおく"],["の"],["国民","こくみん"],["と"],["し"],["、"]]},{"verse":4,"text":"またアブラハムの祝福,しゅくふくをあなたと子孫,しそんとに与,あたえて、神,かみがアブラハムに授,さづけられたあなたの寄留,きりゅうの地,ちを継,つがせてくださるように」。","tok":[["また"],["アブラハム"],["の"],["祝福","しゅくふく"],["を"],["あなた"],["と"],["子孫","しそん"],["と"],["に"],["与","あたえ"],["て"],["、"],["神","かみ"],["が"],["アブラハム"],["に"],["授","さ"],["づけられた"],["あなた"],["の"],["寄留","きりゅう"],["の"],["地","ち"],["を"],["継がせて","つがせて"],["くださる"],["よう"],["に"],["」"],["。"]]},{"verse":5,"text":"こうしてイサクはヤコブを送,おくり出,だした。ヤコブはパダンアラムに向,むかい、アラムびとベトエルの子,こで、ヤコブとエサウとの母,ははリベカの兄,あにラバンのもとへ行,いった。","tok":[["こう"],["して"],["イサク"],["は"],["ヤコブ"],["を"],["送り出した","おくりだした"],["。"],["ヤコブ"],["は"],["パダン"],["アラム"],["に"],["向","むかい"],["、"],["アラム"],["び"],["と"],["ベトエル"],["の"],["子","こ"],["で"],["、"],["ヤコブ"],["と"],["エサウ"],["と"],["の"],["母","はは"],["リベカ"],["の"],["兄","あに"],["ラバン"],["の"],["もと"],["へ"],["行った","いった"],["。"]]},{"verse":6,"text":"さてエサウは、イサクがヤコブを祝福,しゅくふくして、パダンアラムにつかわし、そこから妻,つまをめとらせようとしたこと、彼,かれを祝福,しゅくふくし、命,めいじて「あなたはカナンの娘,むすめを妻,つまにめとってはならない」と言,いったこと、","tok":[["さて"],["エサウ"],["は"],["、"],["イサク"],["が"],["ヤコブ"],["を"],["祝福","しゅくふく"],["して"],["、"],["パダン"],["アラム"],["に"],["つかわし"],["、"],["そこ"],["から"],["妻","つま"],["を"],["めとらせよう"],["と"],["した"],["こと"],["、"],["彼","かれ"],["を"],["祝福","しゅくふく"],["し"],["、"],["命じて","めいじて"],["「"],["あなた"],["は"],["カナン"],["の"],["娘","むすめ"],["を"],["妻","つま"],["に"],["めとって"],["は"],["ならない"],["」"],["と"],["言った","いった"],["こと"],["、"]]},{"verse":7,"text":"そしてヤコブが父母,ふぼの言葉,ことばに従,したがって、パダンアラムへ行,いったことを知,しったとき、","tok":[["そして"],["ヤコブ"],["が"],["父母","ふぼ"],["の"],["言葉","ことば"],["に"],["従って","したがって"],["、"],["パダン"],["アラム"],["へ"],["行った","いった"],["こと"],["を"],["知った","しった"],["とき"],["、"]]},{"verse":8,"text":"彼,かれはカナンの娘,むすめが父,ちちイサクの心,こころにかなわないのを見,みた。","tok":[["彼","かれ"],["は"],["カナン"],["の"],["娘","むすめ"],["が"],["父","ちち"],["イサク"],["の"],["心","こころ"],["に"],["かなわない"],["の"],["を"],["見た","みた"],["。"]]},{"verse":9,"text":"そこでエサウはイシマエルの所,ところに行,いき、すでにある妻,つまたちのほかにアブラハムの子,こイシマエルの娘,むすめで、ネバヨテの妹,いもうとマハラテを妻,つまにめとった。","tok":[["そこ"],["で"],["エサウ"],["は"],["イシマエル"],["の"],["所","ところ"],["に"],["行き","いき"],["、"],["すでに"],["ある"],["妻たち","つまたち"],["の"],["ほか"],["に"],["アブラハム"],["の"],["子","こ"],["イシマエル"],["の"],["娘","むすめ"],["で"],["、"],["ネバヨテ"],["の"],["妹","いもうと"],["マハラテ"],["を"],["妻","つま"],["に"],["めとった"],["。"]]},{"verse":10,"text":"さてヤコブはベエルシバを立,たって、ハランへ向,むかったが、","tok":[["さて"],["ヤコブ"],["は"],["ベエルシバ"],["を"],["立って","たって"],["、"],["ハラン"],["へ"],["向かった","むかった"],["が"],["、"]]},{"verse":11,"text":"一つの所,ところに着,ついた時,とき、日,ひが暮,くれたので、そこに一夜,やを過,すごし、その所,ところの石,いしを取,とってまくらとし、そこに伏,ふして寝,ねた。","tok":[["一","ひと"],["つ"],["の"],["所","ところ"],["に"],["着いた","ついた"],["時","とき"],["、"],["日","ひ"],["が"],["暮","くれ"],["た"],["ので"],["、"],["そこ"],["に"],["一夜","や"],["を"],["過ごし","すごし"],["、"],["その"],["所","ところ"],["の"],["石","いし"],["を"],["取って","とって"],["まくら"],["と"],["し"],["、"],["そこ"],["に"],["伏して","ふして"],["寝た","ねた"],["。"]]},{"verse":12,"text":"時,ときに彼,かれは夢,ゆめをみた。一つのはしごが地,ちの上,うえに立,たっていて、その頂,いただきは天,てんに達,たっし、神,かみの使,つかいたちがそれを上,のぼり下,くだりしているのを見,みた。","tok":[["時","とき"],["に"],["彼","かれ"],["は"],["夢","ゆめ"],["を"],["みた"],["。"],["一","ひと"],["つ"],["の"],["はしご"],["が"],["地","ち"],["の"],["上","うえ"],["に"],["立って","たって"],["いて"],["、"],["その"],["頂","いただき"],["は"],["天","てん"],["に"],["達し","たっし"],["、"],["神","かみ"],["の"],["使","つかい"],["たち"],["が"],["それ"],["を"],["上り下り","のぼりくだり"],["して"],["いる"],["の"],["を"],["見た","みた"],["。"]]},{"verse":13,"text":"そして主,しゅは彼,かれのそばに立,たって言,いわれた、「わたしはあなたの父,ちちアブラハムの神,かみ、イサクの神,かみ、主,しゅである。あなたが伏,ふしている地,ちを、あなたと子孫,しそんとに与,あたえよう。","tok":[["そして"],["主","しゅ"],["は"],["彼","かれ"],["の"],["そば"],["に"],["立って","たって"],["言われた","いわれた"],["、"],["「"],["わたし"],["は"],["あなた"],["の"],["父","ちち"],["アブラハム"],["の"],["神","かみ"],["、"],["イサク"],["の"],["神","かみ"],["、"],["主","しゅ"],["で"],["ある"],["。"],["あなた"],["が"],["伏して","ふして"],["いる"],["地","ち"],["を"],["、"],["あなた"],["と"],["子孫","しそん"],["と"],["に"],["与","あたえ"],["よう"],["。"]]},{"verse":14,"text":"あなたの子孫,しそんは地,ちのちりのように多,おおくなって、西,にし、東,ひがし、北,きた、南,みなみにひろがり、地,ちの諸,しょ族,ぞくはあなたと子孫,しそんとによって祝福,しゅくふくをうけるであろう。","tok":[["あなた"],["の"],["子孫","しそん"],["は"],["地","ち"],["の"],["ちり"],["の"],["よう"],["に"],["多く","おおく"],["なって"],["、"],["西","にし"],["、"],["東","ひがし"],["、"],["北","きた"],["、"],["南","みなみ"],["に"],["ひろがり"],["、"],["地","ち"],["の"],["諸族","しょぞく"],["は"],["あなた"],["と"],["子孫","しそん"],["と"],["によって"],["祝福","しゅくふく"],["を"],["うけるで"],["あろう"],["。"]]},{"verse":15,"text":"わたしはあなたと共,ともにいて、あなたがどこへ行,いくにもあなたを守,まもり、あなたをこの地,ちに連,つれ帰,かえるであろう。わたしは決,けっしてあなたを捨,すてず、あなたに語,かたった事,ことを行,おこなうであろう」。","tok":[["わたし"],["は"],["あなた"],["と"],["共","とも"],["に"],["いて"],["、"],["あなた"],["が"],["どこ"],["へ"],["行く","いく"],["に"],["も"],["あなた"],["を"],["守り","まもり"],["、"],["あなた"],["を"],["この"],["地","ち"],["に"],["連れ","つれ"],["帰えるで","かえるで"],["あろう"],["。"],["わたし"],["は"],["決っして","けっして"],["あなた"],["を"],["捨てず","すてず"],["、"],["あなた"],["に"],["語った","かたった"],["事","こと"],["を"],["行なうで","おこなうで"],["あろう"],["」"],["。"]]},{"verse":16,"text":"ヤコブは眠,ねむりからさめて言,いった、「まことに主,しゅがこの所,ところにおられるのに、わたしは知,しらなかった」。","tok":[["ヤコブ"],["は"],["眠","ねむり"],["から"],["さめて"],["言った","いった"],["、"],["「"],["まこと"],["に"],["主","しゅがこ"],["の"],["所","ところ"],["に"],["おられる"],["のに"],["、"],["わたし"],["は"],["知らなかった","しらなかった"],["」"],["。"]]},{"verse":17,"text":"そして彼,かれは恐,おそれて言,いった、「これはなんという恐,おそるべき所,ところだろう。これは神,かみの家,いえである。これは天,てんの門,もんだ」。","tok":[["そして"],["彼","かれ"],["は"],["恐れて","おそれて"],["言った","いった"],["、"],["「"],["これ"],["は"],["なん"],["と"],["いう"],["恐るべき","おそるべき"],["所","ところ"],["だろう"],["。"],["これ"],["は"],["神","かみ"],["の"],["家","いえ"],["で"],["ある"],["。"],["これ"],["は"],["天","てん"],["の"],["門","もん"],["だ"],["」"],["。"]]},{"verse":18,"text":"ヤコブは朝,あさはやく起,おきて、まくらとしていた石,いしを取,とり、それを立,たてて柱,はしらとし、その頂,いただきに油,あぶらを注,そそいで、","tok":[["ヤコブ"],["は"],["朝","あさ"],["はやく"],["起きて","おきて"],["、"],["まくら"],["として"],["いた"],["石","いし"],["を"],["取","とり"],["、"],["それ"],["を"],["立てて","たてて"],["柱","はしら"],["と"],["し"],["、"],["その"],["頂","いただき"],["に"],["油","あぶら"],["を"],["注いで","そそいで"],["、"]]},{"verse":19,"text":"その所,ところの名,なをベテルと名,なづけた。その町,まちの名,なは初,はじめはルズといった。","tok":[["その"],["所","ところ"],["の"],["名","な"],["を"],["ベテル"],["と"],["名づけた","なづけた"],["。"],["その"],["町","まち"],["の"],["名","な"],["は"],["初め","はじめ"],["は"],["ルズ"],["と"],["いった"],["。"]]},{"verse":20,"text":"ヤコブは誓,ちかいを立,たてて言,いった、「神,かみがわたしと共,ともにいまし、わたしの行,いくこの道,みちでわたしを守,まもり、食,たべるパンと着,きる着物,きものを賜,たまい、","tok":[["ヤコブ"],["は"],["誓い","ちかい"],["を"],["立てて","たてて"],["言った","いった"],["、"],["「"],["神","かみ"],["が"],["わたし"],["と"],["共","とも"],["に"],["いまし"],["、"],["わたし"],["の"],["行く","いく"],["この"],["道","みち"],["で"],["わたし"],["を"],["守り","まもり"],["、"],["食べる","たべる"],["パン"],["と"],["着る","きる"],["着物","きもの"],["を"],["賜い","たまい"],["、"]]},{"verse":21,"text":"安,やすらかに父,ちちの家,いえに帰,かえらせてくださるなら、主,しゅをわたしの神,かみといたしましょう。","tok":[["安らか","やすらか"],["に"],["父","ちち"],["の"],["家","いえ"],["に"],["帰えらせて","かえらせて"],["くださるなら"],["、"],["主","しゅ"],["を"],["わたし"],["の"],["神","かみ"],["と"],["いたしましょう"],["。"]]},{"verse":22,"text":"またわたしが柱,はしらに立,たてたこの石,いしを神,かみの家,いえといたしましょう。そしてあなたがくださるすべての物,ものの十分,ぶんの一を、わたしは必,かならずあなたにささげます」。","tok":[["また"],["わたし"],["が"],["柱","はしら"],["に"],["立てた","たてた"],["この"],["石","いし"],["を"],["神","かみ"],["の"],["家","いえ"],["と"],["いたしましょう"],["。"],["そして"],["あなた"],["が"],["くださる"],["すべて"],["の"],["物","もの"],["の"],["十分","ぶん"],["の"],["一","いち"],["を"],["、"],["わたし"],["は"],["必","かならず"],["あなた"],["に"],["ささげます"],["」"],["。"]]}]
[{"verse":1,"text":"[31:55]あくる朝,あさラバンは早,はやく起,おき、孫,まごと娘,むすめたちに口,くちづけして彼,かれらを祝福,しゅくふくし、去,さって家,いえに帰,かえった。","tok":[["["],["31"],[":"],["55"],["]"],["あくる"],["朝","あさ"],["ラバン"],["は"],["早く","はやく"],["起き","おき"],["、"],["孫","まご"],["と"],["娘","むすめ"],["たち"],["に"],["口づけ","くちづけ"],["して"],["彼","かれ"],["ら"],["を"],["祝福","しゅくふく"],["し"],["、"],["去て","さって"],["家","いえ"],["に"],["帰えった","かえった"],["。"]]},{"verse":2,"text":"[1]さて、ヤコブが旅路,たびじに進,すすんだとき、神,かみの使,つかいたちが彼,かれに会,あった。","tok":[["["],["1"],["]"],["さて"],["、"],["ヤコブ"],["が"],["旅路","たびじ"],["に"],["進んだ","すすんだ"],["とき"],["、"],["神","かみ"],["の"],["使","つかい"],["たち"],["が"],["彼","かれ"],["に"],["会った","あった"],["。"]]},{"verse":3,"text":"[2]ヤコブは彼,かれらを見,みて、「これは神,かみの陣営,じんえいです」と言,いって、その所,ところの名,なをマハナイムと名,なづけた。","tok":[["["],["2"],["]"],["ヤコブ"],["は"],["彼","かれ"],["ら"],["を"],["見て","みて"],["、"],["「"],["これ"],["は"],["神","かみ"],["の"],["陣営","じんえい"],["です"],["」"],["と"],["言って","いって"],["、"],["その"],["所","ところ"],["の"],["名","な"],["を"],["マハナイム"],["と"],["名づけた","なづけた"],["。"]]},{"verse":4,"text":"[3]ヤコブはセイルの地,ち、エドムの野,のに住,すむ兄,あにエサウのもとに、さきだって使者,ししゃをつかわした。","tok":[["["],["3"],["]"],["ヤコブ"],["は"],["セイル"],["の"],["地","ち"],["、"],["エドム"],["の"],["野","の"],["に"],["住む","すむ"],["兄","あに"],["エサウ"],["の"],["もと"],["に"],["、"],["さきだって"],["使者","ししゃ"],["を"],["つかわした"],["。"]]},{"verse":5,"text":"[4]すなわちそれに命,めいじて言,いった、「あなたがたはわたしの主人,しゅじんエサウにこう言,いいなさい、『あなたのしもべヤコブはこう言,いいました。わたしはラバンのもとに寄留,きりゅうして今,いままでとどまりました。","tok":[["["],["4"],["]"],["すなわち"],["それ"],["に"],["命じて","めいじて"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["わたし"],["の"],["主人","しゅじん"],["エサウ"],["に"],["こう"],["言い","いい"],["なさい"],["、"],["『"],["あなた"],["の"],["しもべ"],["ヤコブ"],["は"],["こう"],["言いました","いいました"],["。"],["わたし"],["は"],["ラバン"],["の"],["もと"],["に"],["寄留","きりゅう"],["して"],["今まで","いままで"],["とどまりました"],["。"]]},{"verse":6,"text":"[5]わたしは牛,うし、ろば、羊,ひつじ、男女,だんじょの奴隷,どれいを持,もっています。それでわが主,しゅに申,もうし上,あげて、あなたの前,まえに恵,めぐみを得,えようと人,ひとをつかわしたのです』」。","tok":[["["],["5"],["]"],["わたし"],["は"],["牛","うし"],["、"],["ろば"],["、"],["羊","ひつじ"],["、"],["男女","だんじょ"],["の"],["奴隷","どれい"],["を"],["持って","もって"],["います"],["。"],["それ"],["で"],["わが"],["主に","しゅに"],["申し上げて","もうしあげて"],["、"],["あなた"],["の"],["前","まえ"],["に"],["恵","めぐみ"],["を"],["得よう","えよう"],["と"],["人","ひと"],["を"],["つかわした"],["の"],["です"],["』"],["」"],["。"]]},{"verse":7,"text":"[6]使者,ししゃはヤコブのもとに帰,かえって言,いった、「わたしたちはあなたの兄,あにエサウのもとへ行,いきました。彼,かれもまたあなたを迎,むかえようと四百人,にんを率,ひきいてきます」。","tok":[["["],["6"],["]"],["使者","ししゃ"],["は"],["ヤコブ"],["の"],["もと"],["に"],["帰えって","かえって"],["言った","いった"],["、"],["「"],["わたしたち"],["は"],["あなた"],["の"],["兄","あに"],["エサウ"],["の"],["もと"],["へ"],["行きました","いきました"],["。"],["彼","かれ"],["も"],["また"],["あなた"],["を"],["迎","むかえ"],["よう"],["と"],["四百人","にん"],["を"],["率いて","ひきいて"],["きます"],["」"],["。"]]},{"verse":8,"text":"[7]そこでヤコブは大,おおいに恐,おそれ、苦,くるしみ、共,ともにいる民,たみおよび羊,ひつじ、牛,うし、らくだを二つの組,くみに分,わけて、","tok":[["["],["7"],["]"],["そこ"],["で"],["ヤコブ"],["は"],["大いに","おおいに"],["恐","おそれ"],["、"],["苦しみ","くるしみ"],["、"],["共","とも"],["に"],["いる"],["民","たみ"],["および"],["羊","ひつじ"],["、"],["牛","うし"],["、"],["らくだ"],["を"],["二","ふた"],["つ"],["の"],["組","くみ"],["に"],["分けて","わけて"],["、"]]},{"verse":9,"text":"[8]言,いった、「たとい、エサウがきて、一つの組,くみを撃,うっても、残,のこりの組,くみはのがれるであろう」。","tok":[["["],["8"],["]"],["言った","いった"],["、"],["「"],["たとい"],["、"],["エサウ"],["が"],["きて"],["、"],["一","ひと"],["つ"],["の"],["組","くみ"],["を"],["撃って","うって"],["も"],["、"],["残り","のこり"],["の"],["組","くみ"],["は"],["の"],["がれる"],["で"],["あろう"],["」"],["。"]]},{"verse":10,"text":"[9]ヤコブはまた言,いった、「父,ちちアブラハムの神,かみ、父,ちちイサクの神,かみよ、かつてわたしに『おまえの国,くにへ帰,かえり、おまえの親族,しんぞくに行,いけ。わたしはおまえを恵,めぐもう』と言,いわれた主,しゅよ、","tok":[["["],["9"],["]"],["ヤコブ"],["は"],["また"],["言った","いった"],["、"],["「"],["父","ちち"],["アブラハム"],["の"],["神","かみ"],["、"],["父","ちち"],["イサク"],["の"],["神","かみ"],["よ"],["、"],["かつて"],["わたし"],["に"],["『"],["おまえ"],["の"],["国","くに"],["へ"],["帰えり","かえり"],["、"],["おまえ"],["の"],["親族","しんぞく"],["に"],["行け","いけ"],["。"],["わたし"],["は"],["おまえ"],["を"],["恵もう","めぐもう"],["』"],["と"],["言われた","いわれた"],["主","しゅ"],["よ"],["、"]]},{"verse":11,"text":"[10]あなたがしもべに施,ほどこされたすべての恵,めぐみとまことをわたしは受,うけるに足,たりない者,ものです。わたしは、つえのほか何,なにも持,もたないでこのヨルダンを渡,わたりましたが、今,いまは二つの組,くみにもなりました。","tok":[["["],["10"],["]"],["あなた"],["が"],["しもべ"],["に"],["施された","ほどこされた"],["すべて"],["の"],["恵","めぐみ"],["と"],["まこと"],["を"],["わたし"],["は"],["受ける","うける"],["に"],["足りない","たりない"],["者","もの"],["です"],["。"],["わたし"],["は"],["、"],["つえ"],["の"],["ほか"],["何に","なに"],["も"],["持たないで","もたないで"],["この"],["ヨルダン"],["を"],["渡りました","わたりました"],["が"],["、"],["今","いま"],["は"],["二","ふた"],["つ"],["の"],["組","くみ"],["に"],["も"],["なりました"],["。"]]},{"verse":12,"text":"[11]どうぞ、兄,あにエサウの手,てからわたしをお救,すくいください。わたしは彼,かれがきて、わたしを撃,うち、母,ははや子供,こどもたちにまで及,およぶのを恐,おそれます。","tok":[["["],["11"],["]"],["どうぞ"],["、"],["兄","あに"],["エサウ"],["の"],["手","て"],["から"],["わたし"],["を"],["お救い","おすくい"],["ください"],["。"],["わたし"],["は"],["彼","かれ"],["が"],["きて"],["、"],["わたし"],["を"],["撃ち","うち"],["、"],["母","はは"],["や"],["子供","こども"],["たち"],["に"],["まで"],["及ぶ","およぶ"],["の"],["を"],["恐れます","おそれます"],["。"]]},{"verse":13,"text":"[12]あなたは、かつて、『わたしは必,かならずおまえを恵,めぐみ、おまえの子孫,しそんを海,うみの砂,すなの数,かぞえがたいほど多,おおくしよう』と言,いわれました」。","tok":[["["],["12"],["]"],["あなた"],["は"],["、"],["かつて"],["、"],["『"],["わたし"],["は"],["必","かならず"],["おまえ"],["を"],["恵み","めぐみ"],["、"],["おまえ"],["の"],["子孫","しそん"],["を"],["海","うみ"],["の"],["砂","すな"],["の"],["数え","かぞえ"],["がたい"],["ほど"],["多く","おおく"],["しよう"],["』"],["と"],["言われました","いわれました"],["」"],["。"]]},{"verse":14,"text":"[13]彼,かれはその夜,よそこに宿,やどり、持,もち物,もののうちから兄,あにエサウへの贈,おくり物,ものを選,えらんだ。","tok":[["["],["13"],["]"],["彼","かれ"],["は"],["その"],["夜","よそこ"],["に"],["宿り","やどり"],["、"],["持物","もちもの"],["の"],["うち"],["から"],["兄","あに"],["エサウ"],["へ"],["の"],["贈り物","おくりもの"],["を"],["選らんだ","えらんだ"],["。"]]},{"verse":15,"text":"[14]すなわち雌,めやぎ二百、雄,おやぎ二十、雌,め羊,ひつじ二百、雄羊,おひつじ二十、","tok":[["["],["14"],["]"],["すなわち"],["雌","め"],["やぎ"],["二百","にひゃく"],["、"],["雄","お"],["やぎ"],["二十","にじゅう"],["、"],["雌羊","めひつじ"],["二百","にひゃく"],["、"],["雄羊","おひつじ"],["二十","にじゅう"],["、"]]},{"verse":16,"text":"[15]乳,ちちらくだ三十とその子,こ、雌牛,めうし四十、雄牛,おうし十、雌,めろば二十、雄,おろば十。","tok":[["["],["15"],["]"],["乳","ちち"],["らくだ"],["三十","さんじゅう"],["と"],["その"],["子","こ"],["、"],["雌牛","めうし"],["四十","よんじゅう"],["、"],["雄牛","おうし"],["十","じゅう"],["、"],["雌","め"],["ろば"],["二十","にじゅう"],["、"],["雄","お"],["ろば"],["十","じゅう"],["。"]]},{"verse":17,"text":"[16]彼,かれはこれらをそれぞれの群,むれに分,わけて、しもべたちの手,てにわたし、しもべたちに言,いった、「あなたがたはわたしの先,さきに進,すすみなさい、そして群,むれと群,むれとの間,あいだには隔,へだたりをおきなさい」。","tok":[["["],["16"],["]"],["彼","かれ"],["は"],["これ"],["ら"],["を"],["それぞれ"],["の"],["群れ","むれ"],["に"],["分けて","わけて"],["、"],["しもべ"],["たち"],["の"],["手","て"],["に"],["わたし"],["、"],["しもべ"],["たち"],["に"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["わたし"],["の"],["先","さき"],["に"],["進み","すすみ"],["なさい"],["、"],["そして"],["群れ","むれ"],["と"],["群れ","むれ"],["と"],["の"],["間","あいだ"],["に"],["は"],["隔たり","へだたり"],["を"],["おき"],["なさい"],["」"],["。"]]},{"verse":18,"text":"[17]また先頭,せんとうの者,ものに命,めいじて言,いった、「もし、兄,あにエサウがあなたに会,あって『だれのしもべで、どこへ行,いくのか。あなたの前,まえにあるこれらのものはだれの物,ものか』と尋,たずねたら、","tok":[["["],["17"],["]"],["また"],["先頭","せんとう"],["の"],["者","もの"],["に"],["命じて","めいじて"],["言った","いった"],["、"],["「"],["もし"],["、"],["兄","あに"],["エサウ"],["が"],["あなた"],["に"],["会って","あって"],["『"],["だれ"],["の"],["しもべ"],["で"],["、"],["どこ"],["へ"],["行く","いく"],["の"],["か"],["。"],["あなた"],["の"],["前","まえ"],["に"],["ある"],["これ"],["ら"],["の"],["もの"],["は"],["だれ"],["の"],["物","もの"],["か"],["』"],["と"],["尋ねたら","たずねたら"],["、"]]},{"verse":19,"text":"[18]『あなたのしもべヤコブの物,もので、わが主,しゅエサウにおくる贈,おくり物,ものです。彼,かれもわたしたちのうしろにおります』と言,いいなさい」。","tok":[["["],["18"],["]"],["『"],["あなた"],["の"],["しもべ"],["ヤコブ"],["の"],["物","もの"],["で"],["、"],["わが"],["主","しゅ"],["エサウ"],["に"],["おくる"],["贈り物","おくりもの"],["です"],["。"],["彼","かれ"],["も"],["わたしたち"],["の"],["うしろ"],["に"],["おります"],["』"],["と"],["言い","いい"],["なさい"],["」"],["。"]]},{"verse":20,"text":"[19]彼,かれは第,だい二の者,ものにも、第,だい三の者,ものにも、また群,むれ群,むれについて行,いくすべての者,ものにも命,めいじて言,いった、「あなたがたがエサウに会,あうときは、同,おなじように彼,かれに告,つげて、","tok":[["["],["19"],["]"],["彼","かれ"],["は"],["第","だい"],["二","に"],["の"],["者","もの"],["に"],["も"],["、"],["第","だい"],["三","さん"],["の"],["者","もの"],["に"],["も"],["、"],["また"],["群れ","むれ"],["群れ","むれ"],["について"],["行く","いく"],["すべて"],["の"],["者","もの"],["に"],["も"],["命じて","めいじて"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["が"],["エサウ"],["に"],["会う","あう"],["とき"],["は"],["、"],["同じ","おなじ"],["よう"],["に"],["彼","かれ"],["に"],["告","つげ"],["て"],["、"]]},{"verse":21,"text":"[20]『あなたのしもべヤコブもわれわれのうしろにおります』と言,いいなさい」。ヤコブは、「わたしがさきに送,おくる贈,おくり物,ものをもってまず彼,かれをなだめ、それから、彼,かれの顔,かおを見,みよう。そうすれば、彼,かれはわたしを迎,むかえてくれるであろう」と思,おもったからである。","tok":[["["],["20"],["]"],["『"],["あなた"],["の"],["しもべ"],["ヤコブ"],["も"],["われわれ"],["の"],["うしろ"],["に"],["おります"],["』"],["と"],["言い","いい"],["なさい"],["」"],["。"],["ヤコブ"],["は"],["、"],["「"],["わたし"],["が"],["さき"],["に"],["送る","おくる"],["贈り物","おくりもの"],["を"],["もって"],["まず"],["彼","かれ"],["を"],["なだめ"],["、"],["それ"],["から"],["、"],["彼","かれ"],["の"],["顔","かお"],["を"],["見よう","みよう"],["。"],["そう"],["すれば"],["、"],["彼","かれ"],["は"],["わたし"],["を"],["迎","むかえ"],["て"],["くれるで"],["あろう"],["」"],["と"],["思った","おもった"],["から"],["で"],["ある"],["。"]]},{"verse":22,"text":"[21]こうして贈,おくり物,ものは彼,かれに先立,さきだって渡,わたり、彼,かれはその夜,よ、宿営,しゅくえいにやどった。","tok":[["["],["21"],["]"],["こう"],["して"],["贈り物","おくりもの"],["は"],["彼","かれ"],["に"],["先立って","さきだって"],["渡り","わたり"],["、"],["彼","かれ"],["は"],["その"],["夜","よ"],["、"],["宿営","しゅくえい"],["に"],["やどった"],["。"]]},{"verse":23,"text":"[22]彼,かれはその夜,よ起,おきて、ふたりの妻,つまとふたりのつかえめと十一人,にんの子,こどもとを連,つれてヤボクの渡,わたしをわたった。","tok":[["["],["22"],["]"],["彼","かれ"],["は"],["その"],["夜","よ"],["起きて","おきて"],["、"],["ふたり"],["の"],["妻","つま"],["と"],["ふたり"],["の"],["つかえ"],["め"],["と"],["十一人","にん"],["の"],["子ども","こども"],["と"],["を"],["連れて","つれて"],["ヤボク"],["の"],["渡","わたし"],["を"],["わたった"],["。"]]},{"verse":24,"text":"[23]すなわち彼,かれらを導,みちびいて川,かわを渡,わたらせ、また彼,かれの持,もち物,ものを渡,わたらせた。","tok":[["["],["23"],["]"],["すなわち"],["彼","かれ"],["ら"],["を"],["導いて","みちびいて"],["川","かわ"],["を"],["渡らせ","わたらせ"],["、"],["また"],["彼","かれ"],["の"],["持物","もちもの"],["を"],["渡らせた","わたらせた"],["。"]]},{"verse":25,"text":"[24]ヤコブはひとりあとに残,のこったが、ひとりの人,ひとが、夜明,よあけまで彼,かれと組打,くみうちした。","tok":[["["],["24"],["]"],["ヤコブ"],["は"],["ひとり"],["あと"],["に"],["残った","のこった"],["が"],["、"],["ひとり"],["の"],["人","ひと"],["が"],["、"],["夜明","よあけ"],["まで"],["彼","かれ"],["と"],["組打","くみうち"],["した"],["。"]]},{"verse":26,"text":"[25]ところでその人,ひとはヤコブに勝,かてないのを見,みて、ヤコブのもものつがいにさわったので、ヤコブのもものつがいが、その人,ひとと組打,くみうちするあいだにはずれた。","tok":[["["],["25"],["]"],["ところ"],["で"],["その"],["人","ひと"],["は"],["ヤコブ"],["に"],["勝てない","かてない"],["の"],["を"],["見て","みて"],["、"],["ヤコブ"],["の"],["もも"],["の"],["つがい"],["に"],["さわった"],["ので"],["、"],["ヤコブ"],["の"],["もも"],["の"],["つがい"],["が"],["、"],["その"],["人","ひと"],["と"],["組打","くみうち"],["する"],["あいだ"],["に"],["はずれた"],["。"]]},{"verse":27,"text":"[26]その人,ひとは言,いった、「夜,よが明,あけるからわたしを去,さらせてください」。ヤコブは答,こたえた、「わたしを祝福,しゅくふくしてくださらないなら、あなたを去,さらせません」。","tok":[["["],["26"],["]"],["その"],["人","ひと"],["は"],["言った","いった"],["、"],["「"],["夜","よ"],["が"],["明ける","あける"],["から"],["わたし"],["を"],["去らせて","さらせて"],["ください"],["」"],["。"],["ヤコブ"],["は"],["答","こたえ"],["た"],["、"],["「"],["わたし"],["を"],["祝福","しゅくふく"],["して"],["くださらないなら"],["、"],["あなた"],["を"],["去らせません","さらせません"],["」"],["。"]]},{"verse":28,"text":"[27]その人,ひとは彼,かれに言,いった、「あなたの名,なはなんと言,いいますか」。彼,かれは答,こたえた、「ヤコブです」。","tok":[["["],["27"],["]"],["その"],["人","ひと"],["は"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["の"],["名","な"],["は"],["なん"],["と"],["言います","いいます"],["か"],["」"],["。"],["彼","かれ"],["は"],["答","こたえ"],["た"],["、"],["「"],["ヤコブ"],["です"],["」"],["。"]]},{"verse":29,"text":"[28]その人,ひとは言,いった、「あなたはもはや名,なをヤコブと言,いわず、イスラエルと言,いいなさい。あなたが神,かみと人,ひととに、力,ちからを争,あらそって勝,かったからです」。","tok":[["["],["28"],["]"],["その"],["人","ひと"],["は"],["言った","いった"],["、"],["「"],["あなた"],["は"],["もはや"],["名","な"],["を"],["ヤコブ"],["と"],["言わず","いわず"],["、"],["イスラエル"],["と"],["言い","いい"],["なさい"],["。"],["あなた"],["が"],["神","かみ"],["と"],["人","ひと"],["と"],["に"],["、"],["力","ちから"],["を"],["争って","あらそって"],["勝った","かった"],["から"],["です"],["」"],["。"]]},{"verse":30,"text":"[29]ヤコブは尋,たずねて言,いった、「どうかわたしにあなたの名,なを知,しらせてください」。するとその人,ひとは、「なぜあなたはわたしの名,なをきくのですか」と言,いったが、その所,ところで彼,かれを祝福,しゅくふくした。","tok":[["["],["29"],["]"],["ヤコブ"],["は"],["尋ねて","たずねて"],["言った","いった"],["、"],["「"],["どう"],["か"],["わたし"],["に"],["あなた"],["の"],["名","な"],["を"],["知らせて","しらせて"],["ください"],["」"],["。"],["する"],["と"],["その"],["人","ひと"],["は"],["、"],["「"],["なぜ"],["あなた"],["は"],["わたし"],["の"],["名","な"],["を"],["きく"],["の"],["です"],["か"],["」"],["と"],["言った","いった"],["が"],["、"],["その"],["所","ところ"],["で"],["彼","かれ"],["を"],["祝福","しゅくふく"],["した"],["。"]]},{"verse":31,"text":"[30]そこでヤコブはその所,ところの名,なをペニエルと名,なづけて言,いった、「わたしは顔,かおと顔,かおをあわせて神,かみを見,みたが、なお生,いきている」。","tok":[["["],["30"],["]"],["そこ"],["で"],["ヤコブ"],["は"],["その"],["所","ところ"],["の"],["名","な"],["を"],["ペニエル"],["と"],["名づけて","なづけて"],["言った","いった"],["、"],["「"],["わたし"],["は"],["顔","かお"],["と"],["顔","かお"],["を"],["あわせて"],["神","かみ"],["を"],["見た","みた"],["が"],["、"],["なお"],["生きて","いきて"],["いる"],["」"],["。"]]},{"verse":32,"text":"[31]こうして彼,かれがペニエルを過,すぎる時,とき、日,ひは彼,かれの上,うえにのぼったが、彼,かれはそのもものゆえにびっこを引,ひいていた。","tok":[["["],["31"],["]"],["こう"],["して"],["彼","かれ"],["が"],["ペニエル"],["を"],["過ぎる","すぎる"],["時","とき"],["、"],["日","ひ"],["は"],["彼","かれ"],["の"],["上","うえ"],["に"],["のぼった"],["が"],["、"],["彼","かれ"],["は"],["その"],["もも"],["の"],["ゆえ"],["に"],["びっこ"],["を"],["引いて","ひいて"],["いた"],["。"]]},{"verse":33,"text":"[32]そのため、イスラエルの子,こらは今日,こんにちまで、もものつがいの上,うえにある腰,こしの筋,すじを食,たべない。かの人,ひとがヤコブのもものつがい、すなわち腰,こしの筋,すじにさわったからである。","tok":[["["],["32"],["]"],["その"],["ため"],["、"],["イスラエル"],["の"],["子","こ"],["ら"],["は"],["今日","こん"],["に"],["ち"],["まで"],["、"],["もも"],["の"],["つがい"],["の"],["上","うえ"],["に"],["ある"],["腰","こし"],["の"],["筋","すじ"],["を"],["食べない","たべない"],["。"],["かの"],["人","ひと"],["が"],["ヤコブ"],["の"],["もも"],["の"],["つがい"],["、"],["すなわち"],["腰","こし"],["の"],["筋","すじ"],["に"],["さわった"],["から"],["で"],["ある"],["。"]]}]
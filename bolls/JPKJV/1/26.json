[{"verse":1,"text":"アブラハムの時,ときにあった初,はじめのききんのほか、またききんがその国,くににあったので、イサクはゲラルにいるペリシテびとの王,おうアビメレクの所,ところへ行,いった。","tok":[["アブラハム"],["の"],["時","とき"],["に"],["あった"],["初め","はじめ"],["の"],["ききん"],["の"],["ほか"],["、"],["また"],["ききん"],["が"],["その"],["国","くに"],["に"],["あった"],["ので"],["、"],["イサク"],["は"],["ゲラル"],["に"],["いる"],["ペリシテ"],["びと"],["の"],["王","おう"],["アビメレク"],["の"],["所","ところ"],["へ"],["行った","いった"],["。"]]},{"verse":2,"text":"その時,とき、主,しゅは彼,かれに現,あらわれて言,いわれた、「エジプトへ下,くだってはならない。わたしがあなたに示,しめす地,ちにとどまりなさい。","tok":[["その"],["時","とき"],["、"],["主","しゅ"],["は"],["彼","かれ"],["に"],["現われて","あらわれて"],["言われた","いわれた"],["、"],["「"],["エジプト"],["へ"],["下って","くだって"],["は"],["ならない"],["。"],["わたし"],["が"],["あなた"],["に"],["示めす","しめす"],["地","ち"],["に"],["とどまり"],["なさい"],["。"]]},{"verse":3,"text":"あなたがこの地,ちにとどまるなら、わたしはあなたと共,ともにいて、あなたを祝福,しゅくふくし、これらの国,くにをことごとくあなたと、あなたの子孫,しそんとに与,あたえ、わたしがあなたの父,ちちアブラハムに誓,ちかった誓,ちかいを果,はたそう。","tok":[["あなた"],["が"],["この"],["地","ち"],["に"],["とどまるなら"],["、"],["わたし"],["は"],["あなた"],["と"],["共","とも"],["に"],["いて"],["、"],["あなた"],["を"],["祝福","しゅくふく"],["し"],["、"],["これ"],["ら"],["の"],["国","くに"],["を"],["ことごとく"],["あなた"],["と"],["、"],["あなた"],["の"],["子孫","しそん"],["と"],["に"],["与","あたえ"],["、"],["わたし"],["が"],["あなた"],["の"],["父","ちち"],["アブラハム"],["に"],["誓った","ちかった"],["誓い","ちかい"],["を"],["果たそう","はたそう"],["。"]]},{"verse":4,"text":"またわたしはあなたの子孫,しそんを増,まして天,てんの星,ほしのようにし、あなたの子孫,しそんにこれらの地,ちをみな与,あたえよう。そして地,ちのすべての国民,こくみんはあなたの子孫,しそんによって祝福,しゅくふくをえるであろう。","tok":[["また"],["わたし"],["は"],["あなた"],["の"],["子孫","しそん"],["を"],["増して","まして"],["天","てん"],["の"],["星","ほし"],["の"],["よう"],["に"],["し"],["、"],["あなた"],["の"],["子孫","しそん"],["に"],["これ"],["ら"],["の"],["地","ち"],["を"],["みな"],["与","あたえ"],["よう"],["。"],["そして"],["地","ち"],["の"],["すべて"],["の"],["国民","こくみん"],["は"],["あなた"],["の"],["子孫","しそん"],["によって"],["祝福","しゅくふく"],["を"],["えるで"],["あろう"],["。"]]},{"verse":5,"text":"アブラハムがわたしの言葉,ことばにしたがってわたしのさとしと、いましめと、さだめと、おきてとを守,まもったからである」。","tok":[["アブラハム"],["が"],["わたし"],["の"],["言葉","ことば"],["に"],["したがって"],["わたし"],["の"],["さとし"],["と"],["、"],["いましめ"],["と"],["、"],["さだめ"],["と"],["、"],["おきて"],["と"],["を"],["守った","まもった"],["から"],["で"],["ある"],["」"],["。"]]},{"verse":6,"text":"こうしてイサクはゲラルに住,すんだ。","tok":[["こう"],["して"],["イサク"],["は"],["ゲラル"],["に"],["住んだ","すんだ"],["。"]]},{"verse":7,"text":"その所,ところの人々,ひとびとが彼,かれの妻,つまのことを尋,たずねたとき、「彼女,かのじょはわたしの妹,いもうとです」と彼,かれは言,いった。リベカは美,うつくしかったので、その所,ところの人々,ひとびとがリベカのゆえに自分,じぶんを殺,ころすかもしれないと思,おもって、「わたしの妻,つまです」と言,いうのを恐,おそれたからである。","tok":[["その"],["所","ところ"],["の"],["人々","ひとびと"],["が"],["彼","かれ"],["の"],["妻","つま"],["の"],["こと"],["を"],["尋ねた","たずねた"],["とき"],["、"],["「"],["彼女","かのじょ"],["は"],["わたし"],["の"],["妹","いもうと"],["です"],["」"],["と"],["彼","かれ"],["は"],["言った","いった"],["。"],["リベカ"],["は"],["美しかった","うつくしかった"],["ので"],["、"],["その"],["所","ところ"],["の"],["人々","ひとびと"],["が"],["リベカ"],["の"],["ゆえ"],["に"],["自分","じぶん"],["を"],["殺ろす","ころす"],["か"],["も"],["しれない"],["と"],["思って","おもって"],["、"],["「"],["わたし"],["の"],["妻","つま"],["です"],["」"],["と"],["言う","いう"],["の"],["を"],["恐","おそれ"],["たから"],["で"],["ある"],["。"]]},{"verse":8,"text":"イサクは長,ながらくそこにいたが、ある日,ひペリシテびとの王,おうアビメレクは窓,まどから外,そとをながめていて、イサクがその妻,つまリベカと戯,たわむれているのを見,みた。","tok":[["イサク"],["は"],["長らく","ながらく"],["そこ"],["に"],["いた"],["が"],["、"],["ある"],["日","ひ"],["ペリシテ"],["びと"],["の"],["王","おう"],["アビメレク"],["は"],["窓","まど"],["から"],["外","そと"],["を"],["ながめて"],["いて"],["、"],["イサク"],["が"],["その"],["妻","つま"],["リベカ"],["と"],["戯","たわむれ"],["て"],["いる"],["の"],["を"],["見た","みた"],["。"]]},{"verse":9,"text":"そこでアビメレクはイサクを召,めして言,いった、「彼女,かのじょは確,たしかにあなたの妻,つまです。あなたはどうして『彼女,かのじょはわたしの妹,いもうとです』と言,いわれたのですか」。イサクは彼,かれに言,いった、「わたしは彼女,かのじょのゆえに殺,ころされるかもしれないと思,おもったからです」。","tok":[["そこ"],["で"],["アビメレク"],["は"],["イサク"],["を"],["召","めし"],["て"],["言った","いった"],["、"],["「"],["彼女","かのじょ"],["は"],["確か","たしか"],["に"],["あなた"],["の"],["妻","つま"],["です"],["。"],["あなた"],["は"],["どう"],["して"],["『"],["彼女","かのじょ"],["は"],["わたし"],["の"],["妹","いもうと"],["です"],["』"],["と"],["言われた","いわれた"],["の"],["です"],["か"],["」"],["。"],["イサク"],["は"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["わたし"],["は"],["彼女","かのじょ"],["の"],["ゆえ"],["に"],["殺ろされる","ころされる"],["か"],["も"],["しれない"],["と"],["思った","おもった"],["から"],["です"],["」"],["。"]]},{"verse":10,"text":"アビメレクは言,いった、「あなたはどうしてこんな事,ことをわれわれにされたのですか。民,たみのひとりが軽々,かるがるしくあなたの妻,つまと寝,ねるような事,ことがあれば、その時,ときあなたはわれわれに罪,つみを負,おわせるでしょう」。","tok":[["アビメレク"],["は"],["言った","いった"],["、"],["「"],["あなた"],["は"],["どう"],["して"],["こんな"],["事","こと"],["を"],["われわれ"],["に"],["された"],["の"],["です"],["か"],["。"],["民","たみ"],["の"],["ひとり"],["が"],["軽々しく","かるがるしく"],["あなた"],["の"],["妻","つま"],["と"],["寝る","ねる"],["よう"],["な"],["事","こと"],["が"],["あれば"],["、"],["その"],["時","とき"],["あなた"],["は"],["われわれ"],["に"],["罪","つみ"],["を"],["負わせるでしょう","おわせるでしょう"],["」"],["。"]]},{"verse":11,"text":"それでアビメレクはすべての民,たみに命,めいじて言,いった、「この人,ひと、またはその妻,つまにさわる者,ものは必,かならず死,しななければならない」。","tok":[["それ"],["で"],["アビメレク"],["は"],["すべて"],["の"],["民","たみ"],["に"],["命じて","めいじて"],["言った","いった"],["、"],["「"],["この"],["人","ひと"],["、"],["また"],["は"],["その"],["妻","つま"],["に"],["さわる"],["者","もの"],["は"],["必死","かならずし"],["な"],["なければ"],["ならない"],["」"],["。"]]},{"verse":12,"text":"イサクはその地,ちに種,たねをまいて、その年,としに百倍,ばいの収穫,しゅうかくを得,えた。このように主,しゅが彼,かれを祝福,しゅくふくされたので、","tok":[["イサク"],["は"],["その"],["地","ち"],["に"],["種","たね"],["を"],["まいて"],["、"],["その"],["年","とし"],["に"],["百","ひゃく"],["倍","ばい"],["の"],["収穫","しゅうかく"],["を"],["得た","えた"],["。"],["この"],["よう"],["に"],["主","しゅ"],["が"],["彼","かれ"],["を"],["祝福","しゅくふく"],["された"],["ので"],["、"]]},{"verse":13,"text":"彼,かれは富,とみ、またますます栄,さかえて非常,ひじょうに裕福,ゆうふくになり、","tok":[["彼","かれ"],["は"],["富","とみ"],["、"],["また"],["ますます"],["栄","さかえ"],["て"],["非常","ひじょう"],["に"],["裕福","ゆうふく"],["に"],["なり"],["、"]]},{"verse":14,"text":"羊,ひつじの群,むれ、牛,うしの群,むれ及,および多,おおくのしもべを持,もつようになったので、ペリシテびとは彼,かれをねたんだ。","tok":[["羊","ひつじ"],["の"],["群れ","むれ"],["、"],["牛","うし"],["の"],["群れ","むれ"],["及","および"],["多く","おおく"],["の"],["しもべ"],["を"],["持つ","もつ"],["よう"],["に"],["なった"],["ので"],["、"],["ペリシテ"],["び"],["と"],["は"],["彼","かれ"],["を"],["ねたんだ"],["。"]]},{"verse":15,"text":"またペリシテびとは彼,かれの父,ちちアブラハムの時,ときに、父,ちちのしもべたちが掘,ほったすべての井戸,いどをふさぎ、土,つちで埋,うめた。","tok":[["また"],["ペリシテ"],["び"],["と"],["は"],["彼","かれ"],["の"],["父","ちち"],["アブラハム"],["の"],["時","とき"],["に"],["、"],["父","ちち"],["の"],["しもべ"],["たち"],["が"],["掘った","ほった"],["すべて"],["の"],["井戸","いど"],["を"],["ふさぎ"],["、"],["土","つち"],["で"],["埋めた","うめた"],["。"]]},{"verse":16,"text":"アビメレクはイサクに言,いった、「あなたはわれわれよりも、はるかに強,つよくなられたから、われわれの所,ところを去,さってください」。","tok":[["アビメレク"],["は"],["イサク"],["に"],["言った","いった"],["、"],["「"],["あなた"],["は"],["われわれ"],["より"],["も"],["、"],["はるか"],["に"],["強く","つよく"],["なられた"],["から"],["、"],["われわれ"],["の"],["所","ところ"],["を"],["去て","さって"],["ください"],["」"],["。"]]},{"verse":17,"text":"イサクはそこを去,さり、ゲラルの谷,たにに天幕,てんまくを張,はってその所,ところに住,すんだ。","tok":[["イサク"],["は"],["そこ"],["を"],["去り","さり"],["、"],["ゲラル"],["の"],["谷","たに"],["に"],["天幕","てんまく"],["を"],["張って","はって"],["その"],["所","ところ"],["に"],["住んだ","すんだ"],["。"]]},{"verse":18,"text":"そしてイサクは父,ちちアブラハムの時,ときに人々,ひとびとの掘,ほった水,みずの井戸,いどを再,ふたたび掘,ほった。アブラハムの死後,しご、ペリシテびとがふさいだからである。イサクは父,ちちがつけた名,なにしたがってそれらに名,なをつけた。","tok":[["そして"],["イサク"],["は"],["父","ちち"],["アブラハム"],["の"],["時","とき"],["に"],["人々","ひとびと"],["の"],["掘った","ほった"],["水","みず"],["の"],["井戸","いど"],["を"],["再び","ふたたび"],["掘った","ほった"],["。"],["アブラハム"],["の"],["死後","しご"],["、"],["ペリシテ"],["びと"],["が"],["ふさいだ"],["から"],["で"],["ある"],["。"],["イサク"],["は"],["父","ちち"],["が"],["つけた"],["名","な"],["に"],["したがって"],["それ"],["ら"],["に"],["名","な"],["を"],["つけた"],["。"]]},{"verse":19,"text":"しかしイサクのしもべたちが谷,たにの中,なかを掘,ほって、そこにわき出,でる水,みずの井戸,いどを見,みつけたとき、","tok":[["しかし"],["イサク"],["の"],["しもべ"],["たち"],["が"],["谷","たに"],["の"],["中","なか"],["を"],["掘って","ほって"],["、"],["そこ"],["に"],["わき出る","わきでる"],["水","みず"],["の"],["井戸","いど"],["を"],["見つけた","みつけた"],["とき"],["、"]]},{"verse":20,"text":"ゲラルの羊飼,ひつじかいたちは、「この水,みずはわれわれのものだ」と言,いって、イサクの羊飼,ひつじかいたちと争,あらそったので、イサクはその井戸,いどの名,なをエセクと名,なづけた。彼,かれらが彼,かれと争,あらそったからである。","tok":[["ゲラル"],["の"],["羊飼","ひつじかい"],["たち"],["は"],["、"],["「"],["この"],["水","みず"],["は"],["われわれ"],["の"],["もの"],["だ"],["」"],["と"],["言って","いって"],["、"],["イサク"],["の"],["羊飼","ひつじかい"],["たち"],["と"],["争った","あらそった"],["ので"],["、"],["イサク"],["は"],["その"],["井戸","いど"],["の"],["名","な"],["を"],["エセク"],["と"],["名づけた","なづけた"],["。"],["彼","かれ"],["ら"],["が"],["彼","かれ"],["と"],["争った","あらそった"],["から"],["で"],["ある"],["。"]]},{"verse":21,"text":"彼,かれらはまた一つの井戸,いどを掘,ほったが、これをも争,あらそったので、名,なをシテナと名,なづけた。","tok":[["彼","かれ"],["ら"],["は"],["また"],["一","ひと"],["つ"],["の"],["井戸","いど"],["を"],["掘った","ほった"],["が"],["、"],["これ"],["を"],["も"],["争った","あらそった"],["ので"],["、"],["名","な"],["を"],["シテナ"],["と"],["名づけた","なづけた"],["。"]]},{"verse":22,"text":"イサクはそこから移,うつってまた一つの井戸,いどを掘,ほったが、彼,かれらはこれを争,あらそわなかったので、その名,なをレホボテと名,なづけて言,いった、「いま主,しゅがわれわれの場所,ばしょを広,ひろげられたから、われわれはこの地,ちにふえるであろう」。","tok":[["イサク"],["は"],["そこ"],["から"],["移って","うつって"],["また"],["一","ひと"],["つ"],["の"],["井戸","いど"],["を"],["掘った","ほった"],["が"],["、"],["彼","かれ"],["ら"],["は"],["これ"],["を"],["争わなかった","あらそわなかった"],["ので"],["、"],["その"],["名","な"],["を"],["レホボテ"],["と"],["名づけて","なづけて"],["言った","いった"],["、"],["「"],["いま"],["主","しゅ"],["が"],["われわれ"],["の"],["場所","ばしょ"],["を"],["広げられた","ひろげられた"],["から"],["、"],["われわれ"],["は"],["この"],["地","ち"],["に"],["ふえるで"],["あろう"],["」"],["。"]]},{"verse":23,"text":"彼,かれはそこからベエルシバに上,のぼった。","tok":[["彼","かれ"],["は"],["そこ"],["から"],["ベエルシバ"],["に"],["上った","のぼった"],["。"]]},{"verse":24,"text":"その夜,よ、主,しゅは彼,かれに現,あらわれて言,いわれた、「わたしはあなたの父,ちちアブラハムの神,かみである。あなたは恐,おそれてはならない。わたしはあなたと共,ともにおって、あなたを祝福,しゅくふくし、わたしのしもべアブラハムのゆえにあなたの子孫,しそんを増,ますであろう」。","tok":[["その"],["夜","よ"],["、"],["主","しゅ"],["は"],["彼","かれ"],["に"],["現われて","あらわれて"],["言われた","いわれた"],["、"],["「"],["わたし"],["は"],["あなた"],["の"],["父","ちち"],["アブラハム"],["の"],["神","かみ"],["で"],["ある"],["。"],["あなた"],["は"],["恐れて","おそれて"],["は"],["ならない"],["。"],["わたし"],["は"],["あなた"],["と"],["共","とも"],["に"],["おって"],["、"],["あなた"],["を"],["祝福","しゅくふく"],["し"],["、"],["わたし"],["の"],["しもべ"],["アブラハム"],["の"],["ゆえ"],["に"],["あなた"],["の"],["子孫","しそん"],["を"],["増すで","ますで"],["あろう"],["」"],["。"]]},{"verse":25,"text":"それで彼,かれはその所,ところに祭壇,さいだんを築,きずいて、主,しゅの名,なを呼,よび、そこに天幕,てんまくを張,はった。またイサクのしもべたちはそこに一つの井戸,いどを掘,ほった。","tok":[["それ"],["で"],["彼","かれ"],["は"],["その"],["所","ところ"],["に"],["祭壇","さいだん"],["を"],["築いて","きずいて"],["、"],["主","しゅ"],["の"],["名","な"],["を"],["呼び","よび"],["、"],["そこ"],["に"],["天幕","てんまく"],["を"],["張った","はった"],["。"],["また"],["イサク"],["の"],["しもべ"],["たち"],["は"],["そこ"],["に"],["一","ひと"],["つ"],["の"],["井戸","いど"],["を"],["掘った","ほった"],["。"]]},{"verse":26,"text":"時,ときにアビメレクがその友,ともアホザテと、軍勢,ぐんぜいの長,ちょうピコルと共,ともにゲラルからイサクのもとにきたので、","tok":[["時","とき"],["に"],["アビメレク"],["が"],["その"],["友","とも"],["アホザテ"],["と"],["、"],["軍勢","ぐんぜい"],["の"],["長う","ちょう"],["ピコル"],["と"],["共","とも"],["に"],["ゲラル"],["から"],["イサク"],["の"],["もと"],["に"],["きた"],["ので"],["、"]]},{"verse":27,"text":"イサクは彼,かれらに言,いった、「あなたがたはわたしを憎,にくんで、あなたがたの中,なかからわたしを追,おい出,だされたのに、どうしてわたしの所,ところにこられたのですか」。","tok":[["イサク"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["わたし"],["を"],["憎んで","にくんで"],["、"],["あなた"],["がた"],["の"],["中","なか"],["から"],["わたし"],["を"],["追い出された","おいだされた"],["のに"],["、"],["どう"],["して"],["わたし"],["の"],["所","ところ"],["に"],["こられた"],["の"],["です"],["か"],["」"],["。"]]},{"verse":28,"text":"彼,かれらは言,いった、「われわれは主,しゅがあなたと共,ともにおられるのを、はっきり見,みましたので、いまわれわれの間,あいだ、すなわちわれわれとあなたとの間,あいだに一つの誓,ちかいを立,たてて、あなたと契約,けいやくを結ぼ,むすぼうと思,おもいます。","tok":[["彼","かれ"],["ら"],["は"],["言った","いった"],["、"],["「"],["われわれ"],["は"],["主","しゅ"],["が"],["あなた"],["と"],["共","とも"],["に"],["おられる"],["の"],["を"],["、"],["はっきり"],["見ました","みました"],["ので"],["、"],["いま"],["われわれ"],["の"],["間","あいだ"],["、"],["すなわち"],["われわれ"],["と"],["あなた"],["と"],["の"],["間","あいだ"],["に"],["一","ひと"],["つ"],["の"],["誓い","ちかい"],["を"],["立てて","たてて"],["、"],["あなた"],["と"],["契約","けいやく"],["を"],["結ぼ","むすぼ"],[","],["むすぼう"],["と"],["思います","おもいます"],["。"]]},{"verse":29,"text":"われわれはあなたに害,がいを加,くわえたことはなく、ただ良,よい事,ことだけをして、安,やすらかに去,さらせたのですから、あなたはわれわれに悪,わるい事,ことをしてはなりません。まことにあなたは主,しゅに祝福,しゅくふくされたかたです」。","tok":[["われわれ"],["は"],["あなた"],["に"],["害","がい"],["を"],["加えた","くわえた"],["こと"],["は"],["なく"],["、"],["ただ"],["良い","よい"],["事","こと"],["だけ"],["を"],["して"],["、"],["安らか","やすらか"],["に"],["去らせた","さらせた"],["の"],["です"],["から"],["、"],["あなた"],["は"],["われわれ"],["に"],["悪い","わるい"],["事","こと"],["を"],["して"],["は"],["なりません"],["。"],["まこと"],["に"],["あなた"],["は"],["主に","しゅに"],["祝福","しゅくふく"],["された"],["かた"],["です"],["」"],["。"]]},{"verse":30,"text":"そこでイサクは彼,かれらのためにふるまいを設,もうけた。彼,かれらは飲,のみ食,くいし、","tok":[["そこ"],["で"],["イサク"],["は"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["ふるまい"],["を"],["設けた","もうけた"],["。"],["彼","かれ"],["ら"],["は"],["飲み食い","のみくい"],["し"],["、"]]},{"verse":31,"text":"あくる朝,あさ、はやく起,おきて互,たがいに誓,ちかった。こうしてイサクは彼,かれらを去,さらせたので、彼,かれらはイサクのもとから穏,おだやかに去,さった。","tok":[["あくる"],["朝","あさ"],["、"],["はやく"],["起きて","おきて"],["互","たがい"],["に"],["誓った","ちかった"],["。"],["こう"],["して"],["イサク"],["は"],["彼","かれ"],["ら"],["を"],["去らせた","さらせた"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["イサク"],["の"],["もと"],["から"],["穏","おだやか"],["に"],["去た","さった"],["。"]]},{"verse":32,"text":"その日,ひ、イサクのしもべたちがきて、自分,じぶんたちが掘,ほった井戸,いどについて彼,かれに告,つげて言,いった、「わたしたちは水,みずを見,みつけました」。","tok":[["その"],["日","ひ"],["、"],["イサク"],["の"],["しもべ"],["たち"],["が"],["きて"],["、"],["自分","じぶん"],["たち"],["が"],["掘った","ほった"],["井戸","いど"],["について"],["彼","かれ"],["に"],["告","つげ"],["て"],["言った","いった"],["、"],["「"],["わたしたち"],["は"],["水","みず"],["を"],["見つけました","みつけました"],["」"],["。"]]},{"verse":33,"text":"イサクはそれをシバと名,なづけた。これによってその町,まちの名,なは今日,こんにちにいたるまでベエルシバといわれている。","tok":[["イサク"],["は"],["それ"],["を"],["シバ"],["と"],["名づけた","なづけた"],["。"],["これ"],["によって"],["その"],["町","まち"],["の"],["名","な"],["は"],["今日","こんにち"],["に"],["いたる"],["まで"],["ベエルシバ"],["と"],["いわれて"],["いる"],["。"]]},{"verse":34,"text":"エサウは四十歳,さいの時,とき、ヘテびとベエリの娘,むすめユデテとヘテびとエロンの娘,むすめバスマテとを妻,つまにめとった。","tok":[["エサウ"],["は"],["四十歳","さい"],["の"],["時","とき"],["、"],["ヘテ"],["びと"],["ベエリ"],["の"],["娘","むすめ"],["ユデテ"],["と"],["ヘテ"],["びと"],["エロン"],["の"],["娘","むすめ"],["バスマテ"],["と"],["を"],["妻","つま"],["に"],["めとった"],["。"]]},{"verse":35,"text":"彼女,かのじょたちはイサクとリベカにとって心,こころの痛,いたみとなった。","tok":[["彼女","かのじょ"],["たち"],["は"],["イサク"],["と"],["リベカ"],["にとって"],["心","こころ"],["の"],["痛み","いたみ"],["と"],["なった"],["。"]]}]
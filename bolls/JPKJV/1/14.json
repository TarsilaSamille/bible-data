[{"verse":1,"text":"シナルの王,おうアムラペル、エラサルの王,おうアリオク、エラムの王,おうケダラオメルおよびゴイムの王,おうテダルの世,よに、","tok":[["シナル"],["の"],["王","おう"],["アムラペル"],["、"],["エラサル"],["の"],["王","おう"],["アリオク"],["、"],["エラム"],["の"],["王","おう"],["ケダラオメル"],["および"],["ゴイム"],["の"],["王","おう"],["テダル"],["の"],["世","よ"],["に"],["、"]]},{"verse":2,"text":"これらの王,おうはソドムの王,おうベラ、ゴモラの王,おうビルシャ、アデマの王,おうシナブ、ゼボイムの王,おうセメベル、およびベラすなわちゾアルの王,おうと戦,たたかった。","tok":[["これ"],["ら"],["の"],["王","おう"],["は"],["ソドム"],["の"],["王","おう"],["ベラ"],["、"],["ゴモラ"],["の"],["王","おう"],["ビルシャ"],["、"],["アデマ"],["の"],["王","おう"],["シナブ"],["、"],["ゼボイム"],["の"],["王","おう"],["セメベル"],["、"],["および"],["ベラ"],["すなわち"],["ゾアル"],["の"],["王","おう"],["と"],["戦った","たたかった"],["。"]]},{"verse":3,"text":"これら五人,にんの王,おうはみな同盟,どうめいしてシデムの谷,たに、すなわち塩,しおの海,うみに向,むかって行,いった。","tok":[["これ"],["ら"],["五人","にん"],["の"],["王","おう"],["は"],["みな"],["同盟","どうめい"],["して"],["シデム"],["の"],["谷","たに"],["、"],["すなわち"],["塩","しお"],["の"],["海","うみ"],["に"],["向かって","むかって"],["行った","いった"],["。"]]},{"verse":4,"text":"すなわち彼,かれらは十二年,ねんの間,あいだケダラオメルに仕,つかえたが、十三年,ねん目,めにそむいたので、","tok":[["すなわち"],["彼","かれ"],["ら"],["は"],["十二","じゅうに"],["年","ねん"],["の"],["間","あいだ"],["ケダラオメル"],["に"],["仕えた","つかえた"],["が"],["、"],["十三","じゅうさん"],["年目","年め"],["に"],["そむいた"],["ので"],["、"]]},{"verse":5,"text":"十四年,ねん目,めにケダラオメルは彼,かれと連合,れんごうした王,おうたちと共,ともにきて、アシタロテ・カルナイムでレパイムびとを、ハムでズジびとを、シャベ・キリアタイムでエミびとを撃,うち、","tok":[["十四","じゅうよん"],["年目","年め"],["に"],["ケダラオメル"],["は"],["彼","かれ"],["と"],["連合","れんごう"],["した"],["王","おう"],["たち"],["と"],["共","とも"],["に"],["きて"],["、"],["アシタロテ"],["・"],["カルナイム"],["で"],["レパイム"],["びと"],["を"],["、"],["ハム"],["で"],["ズジ"],["びと"],["を"],["、"],["シャベ"],["・"],["キリアタイム"],["で"],["エミ"],["びと"],["を"],["撃ち","うち"],["、"]]},{"verse":6,"text":"セイルの山地,さんちでホリびとを撃,うって、荒野,あらののほとりにあるエル・パランに及,およんだ。","tok":[["セイル"],["の"],["山地","さんち"],["で"],["ホリ"],["びと"],["を"],["撃って","うって"],["、"],["荒野","あら"],["の"],["の"],["ほとり"],["に"],["ある"],["エル"],["・"],["パラン"],["に"],["及んだ","およんだ"],["。"]]},{"verse":7,"text":"彼,かれらは引,ひき返,かえしてエン・ミシパテすなわちカデシへ行,いって、アマレクびとの国,くにをことごとく撃,うち、またハザゾン・タマルに住,すむアモリびとをも撃,うった。","tok":[["彼","かれ"],["ら"],["は"],["引","ひき"],["返","かえし"],["て"],["エン"],["・"],["ミシパテ"],["すなわち"],["カデシ"],["へ"],["行って","いって"],["、"],["アマレク"],["びと"],["の"],["国","くに"],["を"],["ことごとく"],["撃ち","うち"],["、"],["また"],["ハザゾン"],["・"],["タマル"],["に"],["住む","すむ"],["アモリ"],["びと"],["を"],["も"],["撃った","うった"],["。"]]},{"verse":8,"text":"そこでソドムの王,おう、ゴモラの王,おう、アデマの王,おう、ゼボイムの王,おうおよびベラすなわちゾアルの王,おうは出,でてシデムの谷,たにで彼,かれらに向,むかい、戦,たたかいの陣,じんをしいた。","tok":[["そこ"],["で"],["ソドム"],["の"],["王","おう"],["、"],["ゴモラ"],["の"],["王","おう"],["、"],["アデマ"],["の"],["王","おう"],["、"],["ゼボイム"],["の"],["王","おう"],["および"],["ベラ"],["すなわち"],["ゾアル"],["の"],["王","おう"],["は"],["出て","でて"],["シデム"],["の"],["谷","たに"],["で"],["彼","かれ"],["ら"],["に"],["向","むかい"],["、"],["戦い","たたかい"],["の"],["陣","じん"],["を"],["しいた"],["。"]]},{"verse":9,"text":"すなわちエラムの王,おうケダラオメル、ゴイムの王,おうテダル、シナルの王,おうアムラペル、エラサルの王,おうアリオクの四人,にんの王,おうに対,たいする五人,にんの王,おうであった。","tok":[["すなわち"],["エラム"],["の"],["王","おう"],["ケダラオメル"],["、"],["ゴイム"],["の"],["王","おう"],["テダル"],["、"],["シナル"],["の"],["王","おう"],["アムラペル"],["、"],["エラサル"],["の"],["王","おう"],["アリオク"],["の"],["四人","にん"],["の"],["王","おう"],["に"],["対する","たいする"],["五人","にん"],["の"],["王","おう"],["で"],["あった"],["。"]]},{"verse":10,"text":"シデムの谷,たににはアスファルトの穴,あなが多,おおかったので、ソドムの王,おうとゴモラの王,おうは逃,にげてそこに落,おちたが、残,のこりの者,ものは山,やまにのがれた。","tok":[["シデム"],["の"],["谷","たに"],["に"],["は"],["アスファルト"],["の"],["穴","あな"],["が"],["多かった","おおかった"],["ので"],["、"],["ソドム"],["の"],["王","おう"],["と"],["ゴモラ"],["の"],["王","おう"],["は"],["逃て","にげて"],["そこ"],["に"],["落","おち"],["た"],["が"],["、"],["残り","のこり"],["の"],["者","もの"],["は"],["山","やま"],["に"],["のがれた"],["。"]]},{"verse":11,"text":"そこで彼,かれらはソドムとゴモラの財産,ざいさんと食料,しょくりょうとをことごとく奪,うばって去,さり、","tok":[["そこ"],["で"],["彼","かれ"],["ら"],["は"],["ソドム"],["と"],["ゴモラ"],["の"],["財産","ざいさん"],["と"],["食料","しょくりょう"],["と"],["を"],["ことごとく"],["奪って","うばって"],["去り","さり"],["、"]]},{"verse":12,"text":"またソドムに住,すんでいたアブラムの弟,おとうとの子,こロトとその財産,ざいさんを奪,うばって去,さった。","tok":[["また"],["ソドム"],["に"],["住んで","すんで"],["いた"],["アブラム"],["の"],["弟","おとうと"],["の"],["子","こ"],["ロト"],["と"],["その"],["財産","ざいさん"],["を"],["奪って","うばって"],["去た","さった"],["。"]]},{"verse":13,"text":"時,ときに、ひとりの人,ひとがのがれてきて、ヘブルびとアブラムに告,つげた。この時,ときアブラムはエシコルの兄弟,きょうだい、またアネルの兄弟,きょうだいであるアモリびとマムレのテレビンの木,きのかたわらに住,すんでいた。彼,かれらはアブラムと同盟,どうめいしていた。","tok":[["時","とき"],["に"],["、"],["ひとり"],["の"],["人","ひと"],["が"],["のがれて"],["きて"],["、"],["ヘブル"],["び"],["と"],["アブラム"],["に"],["告","つげ"],["た"],["。"],["この"],["時","とき"],["アブラム"],["は"],["エシコル"],["の"],["兄弟","きょうだい"],["、"],["また"],["アネル"],["の"],["兄弟","きょうだい"],["で"],["ある"],["アモリ"],["び"],["と"],["マムレ"],["の"],["テレビン"],["の"],["木","き"],["の"],["かたわら"],["に"],["住んで","すんで"],["いた"],["。"],["彼","かれ"],["ら"],["は"],["アブラム"],["と"],["同盟","どうめい"],["して"],["いた"],["。"]]},{"verse":14,"text":"アブラムは身内,みうちの者,ものが捕虜,ほりょになったのを聞,きき、訓練,くんれんした家,いえの子,こ三百十八人,にんを引,ひき連,つれてダンまで追,おって行,いき、","tok":[["アブラム"],["は"],["身内","みうち"],["の"],["者","もの"],["が"],["捕虜","ほりょ"],["に"],["なった"],["の"],["を"],["聞","きき"],["、"],["訓練","くんれん"],["した"],["家の子","いえのこ"],["三百十八","さんひゃくじゅうはち"],["人","にん"],["を"],["引連れて","ひきつれて"],["ダン"],["まで"],["追って","おって"],["行き","いき"],["、"]]},{"verse":15,"text":"そのしもべたちを分,わけて、夜,よるかれらを攻,せめ、これを撃,うってダマスコの北,きた、ホバまで彼,かれらを追,おった。","tok":[["その"],["しもべ"],["たち"],["を"],["分けて","わけて"],["、"],["夜","よる"],["かれ"],["ら"],["を"],["攻め","せめ"],["、"],["これ"],["を"],["撃って","うって"],["ダマスコ"],["の"],["北","きた"],["、"],["ホバ"],["まで"],["彼","かれ"],["ら"],["を"],["追った","おった"],["。"]]},{"verse":16,"text":"そして彼,かれはすべての財産,ざいさんを取,とり返,かえし、また身内,みうちの者,ものロトとその財産,ざいさんおよび女,おんなたちと民,たみとを取,とり返,かえした。","tok":[["そして"],["彼","かれ"],["は"],["すべて"],["の"],["財産","ざいさん"],["を"],["取","とり"],["返","かえし"],["、"],["また"],["身内","みうち"],["の"],["者","もの"],["ロト"],["と"],["その"],["財産","ざいさん"],["および"],["女","おんな"],["たち"],["と"],["民","たみ"],["と"],["を"],["取","とり"],["返","かえし"],["た"],["。"]]},{"verse":17,"text":"アブラムがケダラオメルとその連合,れんごうの王,おうたちを撃,うち破,やぶって帰,かえった時,とき、ソドムの王,おうはシャベの谷,たに、すなわち王,おうの谷,たにに出,でて彼,かれを迎,むかえた。","tok":[["アブラム"],["が"],["ケダラオメル"],["と"],["その"],["連合","れんごう"],["の"],["王","おう"],["たち"],["を"],["撃ち破って","うちやぶって"],["帰えった","かえった"],["時","とき"],["、"],["ソドム"],["の"],["王","おう"],["は"],["シャベ"],["の"],["谷","たに"],["、"],["すなわち"],["王","おう"],["の"],["谷","たに"],["に"],["出て","でて"],["彼","かれ"],["を"],["迎","むかえ"],["た"],["。"]]},{"verse":18,"text":"その時,とき、サレムの王,おうメルキゼデクはパンとぶどう酒,しゅとを持,もってきた。彼,かれはいと高,たかき神,かみの祭司,さいしである。","tok":[["その"],["時","とき"],["、"],["サレム"],["の"],["王","おう"],["メルキゼデク"],["は"],["パン"],["と"],["ぶどう酒","ぶどうしゅ"],["と"],["を"],["持って","もって"],["きた"],["。"],["彼","かれ"],["はい"],["と"],["高き","たかき"],["神","かみ"],["の"],["祭司","さいし"],["で"],["ある"],["。"]]},{"verse":19,"text":"彼,かれはアブラムを祝福,しゅくふくして言,いった、「願,ねがわくは天地,てんちの主,しゅなるいと高,たかき神,かみが、アブラムを祝福,しゅくふくされるように。","tok":[["彼","かれ"],["は"],["アブラム"],["を"],["祝福","しゅくふく"],["して"],["言った","いった"],["、"],["「"],["願わく","ねがわく"],["は"],["天地","てんち"],["の"],["主","しゅなるい"],["と"],["高き","たかき"],["神","かみ"],["が"],["、"],["アブラム"],["を"],["祝福","しゅくふく"],["される"],["よう"],["に"],["。"]]},{"verse":20,"text":"願,ねがわくはあなたの敵,てきをあなたの手,てに渡,わたされたいと高,たかき神,かみがあがめられるように」。アブラムは彼,かれにすべての物,ものの十分,ぶんの一を贈,おくった。","tok":[["願わく","ねがわく"],["は"],["あなた"],["の"],["敵","てき"],["を"],["あなた"],["の"],["手","て"],["に"],["渡されたい","わたされたい"],["と"],["高き","たかき"],["神","かみ"],["が"],["あがめられる"],["よう"],["に"],["」"],["。"],["アブラム"],["は"],["彼","かれ"],["に"],["すべて"],["の"],["物","もの"],["の"],["十分","ぶん"],["の"],["一","いち"],["を"],["贈った","おくった"],["。"]]},{"verse":21,"text":"時,ときにソドムの王,おうはアブラムに言,いった、「わたしには人,ひとをください。財産,ざいさんはあなたが取,とりなさい」。","tok":[["時","とき"],["に"],["ソドム"],["の"],["王","おう"],["は"],["アブラム"],["に"],["言った","いった"],["、"],["「"],["わたし"],["に"],["は"],["人","ひと"],["を"],["ください"],["。"],["財産","ざいさん"],["は"],["あなた"],["が"],["取","とり"],["なさい"],["」"],["。"]]},{"verse":22,"text":"アブラムはソドムの王,おうに言,いった、「天地,てんちの主,しゅなるいと高,たかき神,かみ、主,しゅに手,てをあげて、わたしは誓,ちかいます。","tok":[["アブラム"],["は"],["ソドム"],["の"],["王","おう"],["に"],["言った","いった"],["、"],["「"],["天地","てんち"],["の"],["主","しゅなるい"],["と"],["高き","たかき"],["神","かみ"],["、"],["主に","しゅに"],["手","て"],["を"],["あげて"],["、"],["わたし"],["は"],["誓います","ちかいます"],["。"]]},{"verse":23,"text":"わたしは糸,いと一本,ぽんでも、くつひも一本,ぽんでも、あなたのものは何,なににも受,うけません。アブラムを富,とませたのはわたしだと、あなたが言,いわないように。","tok":[["わたし"],["は"],["糸","いと"],["一本","ぽん"],["で"],["も"],["、"],["くつ"],["ひも"],["一本","ぽん"],["で"],["も"],["、"],["あなた"],["の"],["もの"],["は"],["何に","なに"],["に"],["も"],["受ません","うけません"],["。"],["アブラム"],["を"],["富ませた","とませた"],["の"],["は"],["わたし"],["だ"],["と"],["、"],["あなた"],["が"],["言わない","いわない"],["よう"],["に"],["。"]]},{"verse":24,"text":"ただし若者,わかものたちがすでに食,たべた物,ものは別,べつです。そしてわたしと共,ともに行,いった人々,ひとびとアネルとエシコルとマムレとにはその分,ぶんを取,とらせなさい」。","tok":[["ただし"],["若者","わかもの"],["たち"],["が"],["すでに"],["食べた","たべた"],["物","もの"],["は"],["別","べつ"],["です"],["。"],["そして"],["わたし"],["と"],["共","とも"],["に"],["行った","いった"],["人々","ひとびと"],["アネル"],["と"],["エシコル"],["と"],["マムレ"],["と"],["に"],["は"],["その"],["分","ぶん"],["を"],["取らせ","とらせ"],["なさい"],["」"],["。"]]}]
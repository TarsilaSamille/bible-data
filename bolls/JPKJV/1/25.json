[{"verse":1,"text":"アブラハムは再,ふたたび妻,つまをめとった。名,なをケトラという。","tok":[["アブラハム"],["は"],["再び","ふたたび"],["妻","つま"],["を"],["めとった"],["。"],["名","な"],["を"],["ケトラ"],["と"],["いう"],["。"]]},{"verse":2,"text":"彼女,かのじょはジムラン、ヨクシャン、メダン、ミデアン、イシバクおよびシュワを産,うんだ。","tok":[["彼女","かのじょ"],["は"],["ジムラン"],["、"],["ヨクシャン"],["、"],["メダン"],["、"],["ミデアン"],["、"],["イシバク"],["および"],["シュワ"],["を"],["産んだ","うんだ"],["。"]]},{"verse":3,"text":"ヨクシャンの子,こはシバとデダン。デダンの子孫,しそんはアシュリびと、レトシびと、レウミびとである。","tok":[["ヨクシャン"],["の"],["子","こ"],["は"],["シバ"],["と"],["デダン"],["。"],["デダン"],["の"],["子孫","しそん"],["は"],["アシュリ"],["び"],["と"],["、"],["レトシ"],["び"],["と"],["、"],["レウミ"],["びと"],["で"],["ある"],["。"]]},{"verse":4,"text":"ミデアンの子孫,しそんはエパ、エペル、ヘノク、アビダ、エルダアであって、これらは皆,みなケトラの子孫,しそんであった。","tok":[["ミデアン"],["の"],["子孫","しそん"],["は"],["エパ"],["、"],["エペル"],["、"],["ヘノク"],["、"],["アビダ"],["、"],["エルダア"],["で"],["あって"],["、"],["これ"],["ら"],["は"],["皆","みな"],["ケトラ"],["の"],["子孫","しそん"],["で"],["あった"],["。"]]},{"verse":5,"text":"アブラハムはその所有,しょゆうをことごとくイサクに与,あたえた。","tok":[["アブラハム"],["は"],["その"],["所有","しょゆう"],["を"],["ことごとく"],["イサク"],["に"],["与","あたえ"],["た"],["。"]]},{"verse":6,"text":"またそのそばめたちの子,こらにもアブラハムは物,ものを与,あたえ、なお生,いきている間,あいだに彼,かれらをその子,こイサクから離,はなして、東,ひがしの方,ほう、東,ひがしの国,くにに移,うつらせた。","tok":[["また"],["その"],["そばめ"],["たち"],["の"],["子","こ"],["ら"],["に"],["も"],["アブラハム"],["は"],["物","もの"],["を"],["与","あたえ"],["、"],["なお"],["生きて","いきて"],["いる"],["間","あいだ"],["に"],["彼","かれ"],["ら"],["を"],["その"],["子","こ"],["イサク"],["から"],["離して","はなして"],["、"],["東","ひがし"],["の"],["方","ほう"],["、"],["東","ひがし"],["の"],["国","くに"],["に"],["移らせた","うつらせた"],["。"]]},{"verse":7,"text":"アブラハムの生,いきながらえた年,としは百七十五年,ねんである。","tok":[["アブラハム"],["の"],["生きながらえた","いきながらえた"],["年","とし"],["は"],["百七十五","ひゃくななじゅうご"],["年","ねん"],["で"],["ある"],["。"]]},{"verse":8,"text":"アブラハムは高齢,こうれいに達,たっし、老人,ろうじんとなり、年,としが満,みちて息,いき絶,たえ、死,しんでその民,たみに加,くわえられた。","tok":[["アブラハム"],["は"],["高齢","こうれい"],["に"],["達し","たっし"],["、"],["老人","ろうじん"],["と"],["なり"],["、"],["年","と"],["し"],["が"],["満ちて","みちて"],["息","いき"],["絶え","たえ"],["、"],["死","しんでそ"],["の"],["民","たみ"],["に"],["加えられた","くわえられた"],["。"]]},{"verse":9,"text":"その子,こイサクとイシマエルは彼,かれをヘテびとゾハルの子,こエフロンの畑,はたけにあるマクペラのほら穴,あなに葬,ほうむった。これはマムレの向,むかいにあり、","tok":[["その"],["子","こ"],["イサク"],["と"],["イシマエル"],["は"],["彼","かれ"],["を"],["ヘテ"],["びと"],["ゾハル"],["の"],["子","こ"],["エフロン"],["の"],["畑","はたけ"],["に"],["ある"],["マクペラ"],["の"],["ほら穴","ほらあな"],["に"],["葬むった","ほうむった"],["。"],["これ"],["は"],["マムレ"],["の"],["向","むかい"],["に"],["あり"],["、"]]},{"verse":10,"text":"アブラハムがヘテの人々,ひとびとから、買,かい取,とった畑,はたけであって、そこにアブラハムとその妻,つまサラが葬,ほうむられた。","tok":[["アブラハム"],["が"],["ヘテ"],["の"],["人々","ひとびと"],["から"],["、"],["買取った","かいとった"],["畑","はたけ"],["で"],["あって"],["、"],["そこ"],["に"],["アブラハム"],["と"],["その"],["妻","つま"],["サラ"],["が"],["葬むられた","ほうむられた"],["。"]]},{"verse":11,"text":"アブラハムが死,しんだ後,のち、神,かみはその子,こイサクを祝福,しゅくふくされた。イサクはベエル・ラハイ・ロイのほとりに住,すんだ。","tok":[["アブラハム"],["が"],["死んだ","しんだ"],["後","の"],["ち"],["、"],["神","かみ"],["は"],["その"],["子","こ"],["イサク"],["を"],["祝福","しゅくふく"],["された"],["。"],["イサク"],["は"],["ベエル"],["・"],["ラハイ"],["・"],["ロイ"],["の"],["ほとり"],["に"],["住んだ","すんだ"],["。"]]},{"verse":12,"text":"サラのつかえめエジプトびとハガルがアブラハムに産,うんだアブラハムの子,こイシマエルの系図,けいずは次,つぎのとおりである。","tok":[["サラ"],["の"],["つかえ"],["め"],["エジプト"],["び"],["と"],["ハガル"],["が"],["アブラハム"],["に"],["産んだ","うんだ"],["アブラハム"],["の"],["子","こ"],["イシマエル"],["の"],["系図","けいず"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"]]},{"verse":13,"text":"イシマエルの子,こらの名,なを世代,せだいにしたがって、その名,なをいえば次,つぎのとおりである。すなわちイシマエルの長子,ちょうしはネバヨテ、次,つぎはケダル、アデビエル、ミブサム、","tok":[["イシマエル"],["の"],["子","こ"],["ら"],["の"],["名","な"],["を"],["世代","せだい"],["に"],["したがって"],["、"],["その"],["名","な"],["を"],["いえば"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["すなわち"],["イシマエル"],["の"],["長子","ちょうし"],["は"],["ネバヨテ"],["、"],["次","つぎ"],["は"],["ケダル"],["、"],["アデビエル"],["、"],["ミブサム"],["、"]]},{"verse":14,"text":"ミシマ、ドマ、マッサ、","tok":[["ミシマ"],["、"],["ドマ"],["、"],["マッサ"],["、"]]},{"verse":15,"text":"ハダデ、テマ、エトル、ネフシ、ケデマ。","tok":[["ハダデ"],["、"],["テマ"],["、"],["エトル"],["、"],["ネフシ"],["、"],["ケデマ"],["。"]]},{"verse":16,"text":"これはイシマエルの子,こらであり、村,むらと宿営,しゅくえいとによる名,なであって、その氏族,しぞくによる十二人,にんの君,きみたちである。","tok":[["これ"],["は"],["イシマエル"],["の"],["子","こ"],["ら"],["で"],["あり"],["、"],["村","むら"],["と"],["宿営","しゅくえい"],["と"],["に"],["よる"],["名","な"],["で"],["あって"],["、"],["その"],["氏族","しぞく"],["に"],["よる"],["十二人","にん"],["の"],["君","きみ"],["たち"],["で"],["ある"],["。"]]},{"verse":17,"text":"イシマエルのよわいは百三十七年,ねんである。彼,かれは息,いき絶,たえて死,しに、その民,たみに加,くわえられた。","tok":[["イシマエル"],["の"],["よわい"],["は"],["百三十七","ひゃくさんじゅうなな"],["年","ねん"],["で"],["ある"],["。"],["彼","かれ"],["は"],["息","いき"],["絶えて","たえて"],["死に","しに"],["、"],["その"],["民","たみ"],["に"],["加えられた","くわえられた"],["。"]]},{"verse":18,"text":"イシマエルの子,こらはハビラからエジプトの東,ひがし、シュルまでの間,あいだに住,すんで、アシュルに及,およんだ。イシマエルはすべての兄弟,きょうだいの東,ひがしに住,すんだ。","tok":[["イシマエル"],["の"],["子","こ"],["ら"],["は"],["ハビラ"],["から"],["エジプト"],["の"],["東","ひがし"],["、"],["シュル"],["まで"],["の"],["間","あいだ"],["に"],["住んで","すんで"],["、"],["アシュル"],["に"],["及んだ","およんだ"],["。"],["イシマエル"],["は"],["すべて"],["の"],["兄弟","きょうだい"],["の"],["東","ひがし"],["に"],["住んだ","すんだ"],["。"]]},{"verse":19,"text":"アブラハムの子,こイサクの系図,けいずは次,つぎのとおりである。アブラハムの子,こはイサクであって、","tok":[["アブラハム"],["の"],["子","こ"],["イサク"],["の"],["系図","けいず"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["アブラハム"],["の"],["子","こ"],["は"],["イサク"],["で"],["あって"],["、"]]},{"verse":20,"text":"イサクは四十歳,さいの時,とき、パダンアラムのアラムびとベトエルの娘,むすめで、アラムびとラバンの妹,いもうとリベカを妻,つまにめとった。","tok":[["イサク"],["は"],["四十歳","さい"],["の"],["時","とき"],["、"],["パダン"],["アラム"],["の"],["アラム"],["び"],["と"],["ベトエル"],["の"],["娘","むすめ"],["で"],["、"],["アラム"],["びと"],["ラバン"],["の"],["妹","いもうと"],["リベカ"],["を"],["妻","つま"],["に"],["めとった"],["。"]]},{"verse":21,"text":"イサクは妻,つまが子,こを産,うまなかったので、妻,つまのために主,しゅに祈,いのり願,ねがった。主,しゅはその願,ねがいを聞,きかれ、妻,つまリベカはみごもった。","tok":[["イサク"],["は"],["妻","つま"],["が"],["子","こ"],["を"],["産まなかった","うまなかった"],["ので"],["、"],["妻","つま"],["の"],["ため"],["に"],["主に","しゅに"],["祈","いのり"],["願った","ねがった"],["。"],["主","しゅ"],["は"],["その"],["願い","ねがい"],["を"],["聞かれ","きかれ"],["、"],["妻","つま"],["リベカ"],["は"],["みごもった"],["。"]]},{"verse":22,"text":"ところがその子,こらが胎内,たいないで押,おし合,あったので、リベカは言,いった、「こんなことでは、わたしはどうなるでしょう」。彼女,かのじょは行,いって主,しゅに尋,たずねた。","tok":[["ところ"],["が"],["その"],["子","こ"],["ら"],["が"],["胎内","たいない"],["で"],["押","おし"],["合った","あった"],["ので"],["、"],["リベカ"],["は"],["言った","いった"],["、"],["「"],["こんな"],["こと"],["で"],["は"],["、"],["わたし"],["は"],["どう"],["なるでしょう"],["」"],["。"],["彼女","かのじょ"],["は"],["行って","いって"],["主に","しゅに"],["尋ねた","たずねた"],["。"]]},{"verse":23,"text":"主,しゅは彼女,かのじょに言,いわれた、「二つの国民,こくみんがあなたの胎内,たいないにあり、二つの民,たみがあなたの腹,はらから別,わかれて出,でる。一つの民,たみは他,たの民,たみよりも強,つよく、兄,あには弟,おとうとに仕,つかえるであろう」。","tok":[["主","しゅ"],["は"],["彼女","かのじょ"],["に"],["言われた","いわれた"],["、"],["「"],["二","ふた"],["つ"],["の"],["国民","こくみん"],["が"],["あなた"],["の"],["胎内","たいない"],["に"],["あり"],["、"],["二","ふた"],["つ"],["の"],["民","たみ"],["が"],["あなた"],["の"],["腹","はら"],["から"],["別かれて","わかれて"],["出る","でる"],["。"],["一","ひと"],["つ"],["の"],["民","たみ"],["は"],["他","た"],["の"],["民","たみ"],["より"],["も"],["強く","つよく"],["、"],["兄","あに"],["は"],["弟","おとうと"],["に"],["仕えるで","つかえるで"],["あろう"],["」"],["。"]]},{"verse":24,"text":"彼女,かのじょの出産,しゅっさんの日,ひがきたとき、胎内,たいないにはふたごがあった。","tok":[["彼女","かのじょ"],["の"],["出産","しゅっさん"],["の"],["日","ひ"],["が"],["きた"],["とき"],["、"],["胎内","たいない"],["に"],["は"],["ふたご"],["が"],["あった"],["。"]]},{"verse":25,"text":"さきに出,でたのは赤,あかくて全身,ぜんしん毛,けごろものようであった。それで名,なをエサウと名,なづけた。","tok":[["さき"],["に"],["出た","でた"],["の"],["は"],["赤くて","あかくて"],["全身","ぜんしん"],["毛ごろも","けごろも"],["の"],["よう"],["で"],["あった"],["。"],["それ"],["で"],["名","な"],["を"],["エサウ"],["と"],["名づけた","なづけた"],["。"]]},{"verse":26,"text":"その後,のちに弟,おとうとが出,でた。その手,てはエサウのかかとをつかんでいた。それで名,なをヤコブと名,なづけた。リベカが彼,かれらを産,うんだ時,とき、イサクは六十歳,さいであった。","tok":[["その後","そののち"],["に"],["弟","おとうと"],["が"],["出た","でた"],["。"],["その"],["手","て"],["は"],["エサウ"],["の"],["かかと"],["を"],["つかんで"],["いた"],["。"],["それ"],["で"],["名","な"],["を"],["ヤコブ"],["と"],["名づけた","なづけた"],["。"],["リベカ"],["が"],["彼","かれ"],["ら"],["を"],["産んだ","うんだ"],["時","とき"],["、"],["イサク"],["は"],["六十歳","さ"],["いで"],["あった"],["。"]]},{"verse":27,"text":"さてその子,こらは成長,せいちょうし、エサウは巧,たくみな狩猟者,しゅりょうしゃとなり、野,のの人,ひととなったが、ヤコブは穏,おだやかな人,ひとで、天幕,てんまくに住,すんでいた。","tok":[["さて"],["その"],["子","こ"],["ら"],["は"],["成長","せいちょう"],["し"],["、"],["エサウ"],["は"],["巧み","たくみ"],["な"],["狩猟者","しゅりょうしゃ"],["と"],["なり"],["、"],["野","の"],["の"],["人","ひと"],["と"],["なった"],["が"],["、"],["ヤコブ"],["は"],["穏","おだやか"],["な"],["人","ひと"],["で"],["、"],["天幕","てんまく"],["に"],["住んで","すんで"],["いた"],["。"]]},{"verse":28,"text":"イサクは、しかの肉,にくが好,すきだったので、エサウを愛,あいしたが、リベカはヤコブを愛,あいした。","tok":[["イサク"],["は"],["、"],["しか"],["の"],["肉","にく"],["が"],["好き","すき"],["だった"],["ので"],["、"],["エサウ"],["を"],["愛した","あいした"],["が"],["、"],["リベカ"],["は"],["ヤコブ"],["を"],["愛した","あいした"],["。"]]},{"verse":29,"text":"ある日,ひヤコブが、あつものを煮,にていた時,とき、エサウは飢,うえ疲,つかれて野,のから帰,かえってきた。","tok":[["ある"],["日","ひ"],["ヤコブ"],["が"],["、"],["あつもの"],["を"],["煮て","にて"],["いた"],["時","とき"],["、"],["エサウ"],["は"],["飢","うえ"],["疲れて","つかれて"],["野","の"],["から"],["帰えって","かえって"],["きた"],["。"]]},{"verse":30,"text":"エサウはヤコブに言,いった、「わたしは飢,うえ疲,つかれた。お願,ねがいだ。赤,あかいもの、その赤,あかいものをわたしに食,たべさせてくれ」。彼,かれが名,なをエドムと呼,よばれたのはこのためである。","tok":[["エサウ"],["は"],["ヤコブ"],["に"],["言った","いった"],["、"],["「"],["わたし"],["は"],["飢","うえ"],["疲れた","つかれた"],["。"],["お願い","おねがい"],["だ"],["。"],["赤い","あかい"],["もの"],["、"],["その"],["赤い","あかい"],["もの"],["を"],["わたし"],["に"],["食べさせて","たべさせて"],["くれ"],["」"],["。"],["彼","かれ"],["が"],["名","な"],["を"],["エドム"],["と"],["呼ばれた","よばれた"],["の"],["は"],["この"],["ため"],["で"],["ある"],["。"]]},{"verse":31,"text":"ヤコブは言,いった、「まずあなたの長子,ちょうしの特権,とっけんをわたしに売,うりなさい」。","tok":[["ヤコブ"],["は"],["言った","いった"],["、"],["「"],["まず"],["あなた"],["の"],["長子","ちょうし"],["の"],["特権","とっけん"],["を"],["わたし"],["に"],["売","うり"],["なさい"],["」"],["。"]]},{"verse":32,"text":"エサウは言,いった、「わたしは死,しにそうだ。長子,ちょうしの特権,とっけんなどわたしに何,なにになろう」。","tok":[["エサウ"],["は"],["言った","いった"],["、"],["「"],["わたし"],["は"],["死に","しに"],["そう"],["だ"],["。"],["長子","ちょうし"],["の"],["特権","とっけん"],["など"],["わたし"],["に"],["何に","なに"],["に"],["なろう"],["」"],["。"]]},{"verse":33,"text":"ヤコブはまた言,いった、「まずわたしに誓,ちかいなさい」。彼,かれは誓,ちかって長子,ちょうしの特権,とっけんをヤコブに売,うった。","tok":[["ヤコブ"],["は"],["また"],["言った","いった"],["、"],["「"],["まず"],["わたし"],["に"],["誓い","ちかい"],["なさい"],["」"],["。"],["彼","かれ"],["は"],["誓って","ちかって"],["長子","ちょうし"],["の"],["特権","とっけん"],["を"],["ヤコブ"],["に"],["売った","うった"],["。"]]},{"verse":34,"text":"そこでヤコブはパンとレンズ豆,まめのあつものとをエサウに与,あたえたので、彼,かれは飲,のみ食,くいして、立,たち去,さった。このようにしてエサウは長子,ちょうしの特権,とっけんを軽,かろんじた。","tok":[["そこ"],["で"],["ヤコブ"],["は"],["パン"],["と"],["レンズ"],["豆","まめ"],["の"],["あつもの"],["と"],["を"],["エサウ"],["に"],["与","あたえ"],["た"],["ので"],["、"],["彼","かれ"],["は"],["飲み食い","のみくい"],["して"],["、"],["立ち","たち"],["去た","さった"],["。"],["この"],["よう"],["に"],["して"],["エサウ"],["は"],["長子","ちょうし"],["の"],["特権","とっけん"],["を"],["軽んじた","かろんじた"],["。"]]}]
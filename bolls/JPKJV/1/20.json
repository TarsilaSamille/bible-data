[{"verse":1,"text":"アブラハムはそこからネゲブの地,ちに移,うつって、カデシとシュルの間,あいだに住,すんだ。彼,かれがゲラルにとどまっていた時,とき、","tok":[["アブラハム"],["は"],["そこ"],["から"],["ネゲブ"],["の"],["地","ち"],["に"],["移って","うつって"],["、"],["カデシ"],["と"],["シュル"],["の"],["間","あいだ"],["に"],["住んだ","すんだ"],["。"],["彼","かれ"],["が"],["ゲラル"],["に"],["とどまって"],["いた"],["時","とき"],["、"]]},{"verse":2,"text":"アブラハムは妻,つまサラのことを、「これはわたしの妹,いもうとです」と言,いったので、ゲラルの王,おうアビメレクは、人,ひとをつかわしてサラを召,めし入,いれた。","tok":[["アブラハム"],["は"],["妻","つま"],["サラ"],["の"],["こと"],["を"],["、"],["「"],["これ"],["は"],["わたし"],["の"],["妹","いもうと"],["です"],["」"],["と"],["言った","いった"],["ので"],["、"],["ゲラル"],["の"],["王","おう"],["アビメレク"],["は"],["、"],["人","ひと"],["を"],["つかわして"],["サラ"],["を"],["召","めし"],["入れた","いれた"],["。"]]},{"verse":3,"text":"ところが神,かみは夜,よの夢,ゆめにアビメレクに臨,のぞんで言,いわれた、「あなたは召,めし入,いれたあの女,おんなのゆえに死,しなねばならない。彼女,かのじょは夫,おっとのある身,みである」。","tok":[["ところ"],["が"],["神","かみ"],["は"],["夜","よ"],["の"],["夢","ゆめ"],["に"],["アビメレク"],["に"],["臨んで","のぞんで"],["言われた","いわれた"],["、"],["「"],["あなた"],["は"],["召","めし"],["入れた","いれた"],["あの"],["女","おんな"],["の"],["ゆえ"],["に"],["死なねば","しなねば"],["ならない"],["。"],["彼女","かのじょ"],["は"],["夫","おっと"],["の"],["ある"],["身","み"],["で"],["ある"],["」"],["。"]]},{"verse":4,"text":"アビメレクはまだ彼女,かのじょに近,ちかづいていなかったので言,いった、「主,しゅよ、あなたは正,ただしい民,たみでも殺,ころされるのですか。","tok":[["アビメレク"],["は"],["まだ"],["彼女","かのじょ"],["に"],["近づいて","ちかづいて"],["いなかった"],["ので"],["言った","いった"],["、"],["「"],["主","しゅ"],["よ"],["、"],["あなた"],["は"],["正い","ただしい"],["民","たみ"],["で"],["も"],["殺ろされる","ころされる"],["の"],["です"],["か"],["。"]]},{"verse":5,"text":"彼,かれはわたしに、これはわたしの妹,いもうとですと言,いったではありませんか。また彼女,かのじょも自分,じぶんで、彼,かれはわたしの兄,あにですと言,いいました。わたしは心,こころも清,きよく、手,てもいさぎよく、このことをしました」。","tok":[["彼","かれ"],["は"],["わたし"],["に"],["、"],["これ"],["は"],["わたし"],["の"],["妹","いもうと"],["です"],["と"],["言ったで","いったで"],["は"],["ありません"],["か"],["。"],["また"],["彼女","かのじょ"],["も"],["自分","じぶん"],["で"],["、"],["彼","かれ"],["は"],["わたし"],["の"],["兄","あに"],["です"],["と"],["言いました","いいました"],["。"],["わたし"],["は"],["心","こころ"],["も"],["清く","きよく"],["、"],["手","て"],["も"],["いさぎよく"],["、"],["この"],["こと"],["を"],["しました"],["」"],["。"]]},{"verse":6,"text":"神,かみはまた夢,ゆめで彼,かれに言,いわれた、「そうです、あなたが清,きよい心,こころをもってこのことをしたのを知,しっていたから、わたしもあなたを守,まもって、わたしに対,たいして罪,つみを犯,おかさせず、彼女,かのじょにふれることを許,ゆるさなかったのです。","tok":[["神","かみ"],["は"],["また"],["夢","ゆめ"],["で"],["彼","かれ"],["に"],["言われた","いわれた"],["、"],["「"],["そう"],["です"],["、"],["あなた"],["が"],["清い","きよい"],["心","こころ"],["を"],["もって"],["この"],["こと"],["を"],["した"],["の"],["を"],["知って","しって"],["いた"],["から"],["、"],["わたし"],["も"],["あなた"],["を"],["守って","まもって"],["、"],["わたし"],["に対して","にたいして"],["罪","つみ"],["を"],["犯させず","おかさせず"],["、"],["彼女","かのじょ"],["に"],["ふれる"],["こと"],["を"],["許さなかった","ゆるさなかった"],["の"],["です"],["。"]]},{"verse":7,"text":"いま彼,かれの妻,つまを返,かえしなさい。彼,かれは預言者,よげんしゃですから、あなたのために祈,いのって、命,いのちを保,たもたせるでしょう。もし返,かえさないなら、あなたも身内,みうちの者,ものもみな必,かならず死,しぬと知,しらなければなりません」。","tok":[["いま"],["彼","かれ"],["の"],["妻","つま"],["を"],["返","かえし"],["なさい"],["。"],["彼","かれ"],["は"],["預言者","よげんしゃ"],["です"],["から"],["、"],["あなた"],["の"],["ため"],["に"],["祈って","いのって"],["、"],["命","いのち"],["を"],["保たせるでしょう","たもたせるでしょう"],["。"],["もし"],["返えさないなら","かえさないなら"],["、"],["あなた"],["も"],["身内","みうち"],["の"],["者","もの"],["も"],["みな"],["必死","かならずし"],["ぬ"],["と"],["知らなければ","しらなければ"],["なりません"],["」"],["。"]]},{"verse":8,"text":"そこでアビメレクは朝,あさ早,はやく起,おき、しもべたちをことごとく召,めし集,あつめて、これらの事,ことをみな語,かたり聞,きかせたので、人々,ひとびとは非常,ひじょうに恐,おそれた。","tok":[["そこ"],["で"],["アビメレク"],["は"],["朝","あさ"],["早く","はやく"],["起き","おき"],["、"],["しもべ"],["たち"],["を"],["ことごとく"],["召","めし"],["集めて","あつめて"],["、"],["これ"],["ら"],["の"],["事","こと"],["を"],["みな"],["語り聞かせた","かたりきかせた"],["ので"],["、"],["人々","ひとびと"],["は"],["非常","ひじょう"],["に"],["恐れた","おそれた"],["。"]]},{"verse":9,"text":"そしてアビメレクはアブラハムを召,めして言,いった、「あなたはわれわれに何,なにをするのですか。あなたに対,たいしてわたしがどんな罪,つみを犯,おかしたために、あなたはわたしとわたしの国,くにとに、大,おおきな罪,つみを負,おわせるのですか。あなたはしてはならぬことをわたしにしたのです」。","tok":[["そして"],["アビメレク"],["は"],["アブラハム"],["を"],["召","めし"],["て"],["言った","いった"],["、"],["「"],["あなた"],["は"],["われわれ"],["に"],["何に","なに"],["を"],["する"],["の"],["です"],["か"],["。"],["あなた"],["に対して","にたいして"],["わたし"],["が"],["どんな"],["罪","つみ"],["を"],["犯した","おかした"],["ため"],["に"],["、"],["あなた"],["は"],["わたし"],["と"],["わたし"],["の"],["国","くに"],["と"],["に"],["、"],["大きな","おおきな"],["罪","つみ"],["を"],["負わせる","おわせる"],["の"],["です"],["か"],["。"],["あなた"],["は"],["して"],["は"],["ならぬ"],["こと"],["を"],["わたし"],["に"],["した"],["の"],["です"],["」"],["。"]]},{"verse":10,"text":"アビメレクはまたアブラハムに言,いった、「あなたはなんと思,おもって、この事,ことをしたのですか」。","tok":[["アビメレク"],["は"],["また"],["アブラハム"],["に"],["言った","いった"],["、"],["「"],["あなた"],["は"],["なん"],["と"],["思って","おもって"],["、"],["この"],["事","こと"],["を"],["した"],["の"],["です"],["か"],["」"],["。"]]},{"verse":11,"text":"アブラハムは言,いった、「この所,ところには神,かみを恐,おそれるということが、まったくないので、わたしの妻,つまのゆえに人々,ひとびとがわたしを殺,ころすと思,おもったからです。","tok":[["アブラハム"],["は"],["言った","いった"],["、"],["「"],["この"],["所","ところ"],["に"],["は"],["神","かみ"],["を"],["恐れる","おそれる"],["と"],["いう"],["こと"],["が"],["、"],["まったく"],["ない"],["ので"],["、"],["わたし"],["の"],["妻","つま"],["の"],["ゆえ"],["に"],["人々","ひとびと"],["が"],["わたし"],["を"],["殺ろす","ころす"],["と"],["思った","おもった"],["から"],["です"],["。"]]},{"verse":12,"text":"また彼女,かのじょはほんとうにわたしの妹,いもうとなのです。わたしの父,ちちの娘,むすめですが、母,ははの娘,むすめではありません。そして、わたしの妻,つまになったのです。","tok":[["また"],["彼女","かのじょ"],["は"],["ほんとう"],["に"],["わたし"],["の"],["妹","いもうと"],["な"],["の"],["です"],["。"],["わたし"],["の"],["父","ちち"],["の"],["娘","むすめ"],["です"],["が"],["、"],["母","はは"],["の"],["娘","むすめ"],["で"],["は"],["ありません"],["。"],["そして"],["、"],["わたし"],["の"],["妻","つま"],["に"],["なった"],["の"],["です"],["。"]]},{"verse":13,"text":"神,かみがわたしに父,ちちの家,いえを離,はなれて、行,いき巡,めぐらせた時,とき、わたしは彼女,かのじょに、あなたはわたしたちの行,いくさきざきでわたしを兄,あにであると言,いってください。これはあなたがわたしに施,ほどこす恵,めぐみであると言,いいました」。","tok":[["神","かみ"],["が"],["わたし"],["に"],["父","ちち"],["の"],["家","いえ"],["を"],["離れて","はなれて"],["、"],["行き","いき"],["巡らせた","めぐらせた"],["時","とき"],["、"],["わたし"],["は"],["彼女","かのじょ"],["に"],["、"],["あなた"],["は"],["わたしたち"],["の"],["行く","いく"],["さきざき"],["で"],["わたし"],["を"],["兄","あに"],["で"],["ある"],["と"],["言って","いって"],["ください"],["。"],["これ"],["は"],["あなた"],["が"],["わたし"],["に"],["施す","ほどこす"],["恵","めぐみ"],["で"],["ある"],["と"],["言いました","いいました"],["」"],["。"]]},{"verse":14,"text":"そこでアビメレクは羊,ひつじ、牛,うしおよび男女,だんじょの奴隷,どれいを取,とってアブラハムに与,あたえ、その妻,つまサラを彼,かれに返,かえした。","tok":[["そこ"],["で"],["アビメレク"],["は"],["羊","ひつじ"],["、"],["牛","うし"],["および"],["男女","だんじょ"],["の"],["奴隷","どれい"],["を"],["取って","とって"],["アブラハム"],["に"],["与","あたえ"],["、"],["その"],["妻","つま"],["サラ"],["を"],["彼","かれ"],["に"],["返","かえし"],["た"],["。"]]},{"verse":15,"text":"そしてアビメレクは言,いった、「わたしの地,ちはあなたの前,まえにあります。あなたの好,すきな所,ところに住,すみなさい」。","tok":[["そして"],["アビメレク"],["は"],["言った","いった"],["、"],["「"],["わたし"],["の"],["地","ち"],["は"],["あなた"],["の"],["前","まえ"],["に"],["あります"],["。"],["あなた"],["の"],["好き","すき"],["な"],["所","ところ"],["に"],["住み","すみ"],["なさい"],["」"],["。"]]},{"verse":16,"text":"またサラに言,いった、「わたしはあなたの兄,あにに銀,ぎん千,せんシケルを与,あたえました。これはあなたの身,みに起,たったすべての事,ことについて、あなたに償,つぐないをするものです。こうしてすべての人,ひとにあなたは正,ただしいと認,みとめられます」。","tok":[["また"],["サラ"],["に"],["言った","いった"],["、"],["「"],["わたし"],["は"],["あなた"],["の"],["兄","あに"],["に"],["銀","ぎん"],["千","せん"],["シケル"],["を"],["与","あたえ"],["ました"],["。"],["これ"],["は"],["あなた"],["の"],["身","み"],["に"],["起った","たった"],["すべて"],["の"],["事","こと"],["について"],["、"],["あなた"],["に"],["償ない","つぐない"],["を"],["する"],["もの"],["です"],["。"],["こう"],["して"],["すべて"],["の"],["人","ひと"],["に"],["あなた"],["は"],["正い","ただしい"],["と"],["認められます","みとめられます"],["」"],["。"]]},{"verse":17,"text":"そこでアブラハムは神,かみに祈,いのった。神,かみはアビメレクとその妻,つまおよび、はしためたちをいやされたので、彼,かれらは子,こを産,うむようになった。","tok":[["そこ"],["で"],["アブラハム"],["は"],["神","かみ"],["に"],["祈った","いのった"],["。"],["神","かみ"],["は"],["アビメレク"],["と"],["その"],["妻","つま"],["および"],["、"],["はし"],["ため"],["たち"],["を"],["いやされた"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["子","こ"],["を"],["産む","うむ"],["よう"],["に"],["なった"],["。"]]},{"verse":18,"text":"これは主,しゅがさきにアブラハムの妻,つまサラのゆえに、アビメレクの家,いえのすべての者,ものの胎,たいを、かたく閉,とざされたからである。","tok":[["これ"],["は"],["主に","しゅがさきに"],["アブラハム"],["の"],["妻","つま"],["サラ"],["の"],["ゆえ"],["に"],["、"],["アビメレク"],["の"],["家","いえ"],["の"],["すべて"],["の"],["者","もの"],["の"],["胎","たい"],["を"],["、"],["かたく"],["閉ざされた","とざされた"],["から"],["で"],["ある"],["。"]]}]
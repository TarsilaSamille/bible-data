[{"verse":1,"text":"アブラムの妻,つまサライは子,こを産,うまなかった。彼女,かのじょにひとりのつかえめがあった。エジプトの女,おんなで名,なをハガルといった。","tok":[["アブラム"],["の"],["妻","つま"],["サライ"],["は"],["子","こ"],["を"],["産まなかった","うまなかった"],["。"],["彼女","かのじょ"],["に"],["ひとり"],["の"],["つかえ"],["め"],["が"],["あった"],["。"],["エジプト"],["の"],["女","おんな"],["で"],["名","な"],["を"],["ハガル"],["と"],["いった"],["。"]]},{"verse":2,"text":"サライはアブラムに言,いった、「主,しゅはわたしに子,こをお授,さづけになりません。どうぞ、わたしのつかえめの所,ところにおはいりください。彼女,かのじょによってわたしは子,こをもつことになるでしょう」。アブラムはサライの言葉,ことばを聞,ききいれた。","tok":[["サライ"],["は"],["アブラム"],["に"],["言った","いった"],["、"],["「"],["主","しゅ"],["は"],["わたし"],["に"],["子","こ"],["を"],["お"],["授","さづけ"],["に"],["なりません"],["。"],["どうぞ"],["、"],["わたし"],["の"],["つかえ"],["め"],["の"],["所","ところ"],["に"],["おはいり"],["ください"],["。"],["彼女","かのじょ"],["によって"],["わたし"],["は"],["子","こ"],["を"],["もつ"],["こと"],["に"],["なるでしょう"],["」"],["。"],["アブラム"],["は"],["サライ"],["の"],["言葉","ことば"],["を"],["聞きいれた","ききいれた"],["。"]]},{"verse":3,"text":"アブラムの妻,つまサライはそのつかえめエジプトの女,おんなハガルをとって、夫,おっとアブラムに妻,つまとして与,あたえた。これはアブラムがカナンの地,ちに十年,ねん住,すんだ後,のちであった。","tok":[["アブラム"],["の"],["妻","つま"],["サライ"],["は"],["その"],["つかえ"],["め"],["エジプト"],["の"],["女","おんな"],["ハガル"],["を"],["とって"],["、"],["夫","おっと"],["アブラム"],["に"],["妻","つま"],["として"],["与","あたえ"],["た"],["。"],["これ"],["は"],["アブラム"],["が"],["カナン"],["の"],["地","ち"],["に"],["十","じゅう"],["年","ねん"],["住んだ","すんだ"],["後","の"],["ち"],["で"],["あった"],["。"]]},{"verse":4,"text":"彼,かれはハガルの所,ところにはいり、ハガルは子,こをはらんだ。彼女,かのじょは自分,じぶんのはらんだのを見,みて、女,おんな主人,しゅじんを見下,みさげるようになった。","tok":[["彼","かれ"],["は"],["ハガル"],["の"],["所","ところ"],["に"],["はいり"],["、"],["ハガル"],["は"],["子","こ"],["を"],["はらんだ"],["。"],["彼女","かのじょ"],["は"],["自分","じぶん"],["の"],["はらんだ"],["の"],["を"],["見て","みて"],["、"],["女","おんな"],["主人","しゅじん"],["を"],["見下げる","みさげる"],["よう"],["に"],["なった"],["。"]]},{"verse":5,"text":"そこでサライはアブラムに言,いった、「わたしが受,うけた害,がいはあなたの責任,せきにんです。わたしのつかえめをあなたのふところに与,あたえたのに、彼女,かのじょは自分,じぶんのはらんだのを見,みて、わたしを見下,みさげます。どうか、主,しゅがあなたとわたしの間,あいだをおさばきになるように」。","tok":[["そこ"],["で"],["サライ"],["は"],["アブラム"],["に"],["言った","いった"],["、"],["「"],["わたし"],["が"],["受た","うけた"],["害","がい"],["は"],["あなた"],["の"],["責任","せきにん"],["です"],["。"],["わたし"],["の"],["つかえ"],["め"],["を"],["あなた"],["の"],["ふところ"],["に"],["与","あたえ"],["た"],["のに"],["、"],["彼女","かのじょ"],["は"],["自分","じぶん"],["の"],["はらんだ"],["の"],["を"],["見て","みて"],["、"],["わたし"],["を"],["見下げます","みさげます"],["。"],["どう"],["か"],["、"],["主","しゅ"],["が"],["あなた"],["と"],["わたし"],["の"],["間","あいだ"],["を"],["おさばき"],["に"],["なる"],["よう"],["に"],["」"],["。"]]},{"verse":6,"text":"アブラムはサライに言,いった、「あなたのつかえめはあなたの手,てのうちにある。あなたの好,すきなように彼女,かのじょにしなさい」。そしてサライが彼女,かのじょを苦,くるしめたので、彼女,かのじょはサライの顔,かおを避,さけて逃,にげた。","tok":[["アブラム"],["は"],["サライ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["の"],["つかえ"],["め"],["は"],["あなた"],["の"],["手","て"],["の"],["うち"],["に"],["ある"],["。"],["あなた"],["の"],["好き","すき"],["な"],["よう"],["に"],["彼女","かのじょ"],["に"],["し"],["なさい"],["」"],["。"],["そして"],["サライ"],["が"],["彼女","かのじょ"],["を"],["苦しめた","くるしめた"],["ので"],["、"],["彼女","かのじょ"],["は"],["サライ"],["の"],["顔","かお"],["を"],["避けて","さけて"],["逃た","にげた"],["。"]]},{"verse":7,"text":"主,しゅの使,つかいは荒野,あらのにある泉,いずみのほとり、すなわちシュルの道,みちにある泉,いずみのほとりで、彼女,かのじょに会,あい、","tok":[["主","しゅ"],["の"],["使い","つかい"],["は"],["荒野","あら"],["のに"],["ある"],["泉","いずみ"],["の"],["ほとり"],["、"],["すなわち"],["シュル"],["の"],["道","みち"],["に"],["ある"],["泉","いずみ"],["の"],["ほとり"],["で"],["、"],["彼女","かのじょ"],["に"],["会い","あい"],["、"]]},{"verse":8,"text":"そして言,いった、「サライのつかえめハガルよ、あなたはどこからきたのですか、またどこへ行,いくのですか」。彼女,かのじょは言,いった、「わたしは女,おんな主人,しゅじんサライの顔,かおを避,さけて逃,にげているのです」。","tok":[["そして"],["言った","いった"],["、"],["「"],["サライ"],["の"],["つかえ"],["め"],["ハガル"],["よ"],["、"],["あなた"],["は"],["どこ"],["から"],["きた"],["の"],["です"],["か"],["、"],["また"],["どこ"],["へ"],["行く","いく"],["の"],["です"],["か"],["」"],["。"],["彼女","かのじょ"],["は"],["言った","いった"],["、"],["「"],["わたし"],["は"],["女","おんな"],["主人","しゅじん"],["サライ"],["の"],["顔","かお"],["を"],["避けて","さけて"],["逃て","にげて"],["いる"],["の"],["です"],["」"],["。"]]},{"verse":9,"text":"主,しゅの使,つかいは彼女,かのじょに言,いった、「あなたは女,おんな主人,しゅじんのもとに帰,かえって、その手,てに身,みを任,まかせなさい」。","tok":[["主","しゅ"],["の"],["使い","つかい"],["は"],["彼女","かのじょ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["は"],["女","おんな"],["主人","しゅじん"],["の"],["もと"],["に"],["帰えって","かえって"],["、"],["その"],["手","て"],["に"],["身","み"],["を"],["任せ","まかせ"],["なさい"],["」"],["。"]]},{"verse":10,"text":"主,しゅの使,つかいはまた彼女,かのじょに言,いった、「わたしは大,おおいにあなたの子孫,しそんを増,まして、数,かぞえきれないほどに多,おおくしましょう」。","tok":[["主","しゅ"],["の"],["使い","つかい"],["は"],["また"],["彼女","かのじょ"],["に"],["言った","いった"],["、"],["「"],["わたし"],["は"],["大いに","おおいに"],["あなた"],["の"],["子孫","しそん"],["を"],["増して","まして"],["、"],["数え","かぞえ"],["きれない"],["ほど"],["に"],["多く","おおく"],["しましょう"],["」"],["。"]]},{"verse":11,"text":"主,しゅの使,つかいはまた彼女,かのじょに言,いった、「あなたは、みごもっています。あなたは男,おとこの子,こを産,うむでしょう。名,なをイシマエルと名,なづけなさい。主,しゅがあなたの苦,くるしみを聞,きかれたのです。","tok":[["主","しゅ"],["の"],["使い","つかい"],["は"],["また"],["彼女","かのじょ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["は"],["、"],["みごもって"],["います"],["。"],["あなた"],["は"],["男の子","おとこのこ"],["を"],["産むでしょう","うむでしょう"],["。"],["名","な"],["を"],["イシマエル"],["と"],["名づけ","なづけ"],["なさい"],["。"],["主","しゅ"],["が"],["あなた"],["の"],["苦しみ","くるしみ"],["を"],["聞かれた","きかれた"],["の"],["です"],["。"]]},{"verse":12,"text":"彼,かれは野,のろばのような人,ひととなり、その手,てはすべての人,ひとに逆,さからい、すべての人,ひとの手,ては彼,かれに逆,さからい、彼,かれはすべての兄弟,きょうだいに敵,てきして住,すむでしょう」。","tok":[["彼","かれ"],["は"],["野","の"],["ろば"],["の"],["よう"],["な"],["人となり","ひととなり"],["、"],["その"],["手","て"],["は"],["すべて"],["の"],["人","ひと"],["に"],["逆らい","さからい"],["、"],["すべて"],["の"],["人","ひと"],["の"],["手","て"],["は"],["彼","かれ"],["に"],["逆らい","さからい"],["、"],["彼","かれ"],["は"],["すべて"],["の"],["兄弟","きょうだい"],["に"],["敵して","てきして"],["住むでしょう","すむでしょう"],["」"],["。"]]},{"verse":13,"text":"そこで、ハガルは自分,じぶんに語,かたられた主,しゅの名,なを呼,よんで、「あなたはエル・ロイです」と言,いった。彼女,かのじょが「ここでも、わたしを見,みていられるかたのうしろを拝,おがめたのか」と言,いったことによる。","tok":[["そこ"],["で"],["、"],["ハガル"],["は"],["自分","じぶん"],["に"],["語られた","かたられた"],["主","しゅ"],["の"],["名","な"],["を"],["呼んで","よんで"],["、"],["「"],["あなた"],["は"],["エル"],["・"],["ロイ"],["です"],["」"],["と"],["言った","いった"],["。"],["彼女","かのじょ"],["が"],["「"],["ここ"],["で"],["も"],["、"],["わたし"],["を"],["見て","みて"],["いられる"],["かた"],["の"],["うしろ"],["を"],["拝めた","おがめた"],["の"],["か"],["」"],["と"],["言った","いった"],["こと"],["に"],["よる"],["。"]]},{"verse":14,"text":"それでその井戸,いどは「ベエル・ラハイ・ロイ」と呼,よばれた。これはカデシとベレデの間,あいだにある。","tok":[["それ"],["で"],["その"],["井戸","いど"],["は"],["「"],["ベエル"],["・"],["ラハイ"],["・"],["ロイ"],["」"],["と"],["呼ばれた","よばれた"],["。"],["これ"],["は"],["カデシ"],["と"],["ベレデ"],["の"],["間","あいだ"],["に"],["ある"],["。"]]},{"verse":15,"text":"ハガルはアブラムに男,おとこの子,こを産,うんだ。アブラムはハガルが産,うんだ子,この名,なをイシマエルと名,なづけた。","tok":[["ハガル"],["は"],["アブラム"],["に"],["男の子","おとこのこ"],["を"],["産んだ","うんだ"],["。"],["アブラム"],["は"],["ハガル"],["が"],["産んだ","うんだ"],["子","こ"],["の"],["名","な"],["を"],["イシマエル"],["と"],["名づけた","なづけた"],["。"]]},{"verse":16,"text":"ハガルがイシマエルをアブラムに産,うんだ時,とき、アブラムは八十六歳,さいであった。","tok":[["ハガル"],["が"],["イシマエル"],["を"],["アブラム"],["に"],["産んだ","うんだ"],["時","とき"],["、"],["アブラム"],["は"],["八十六歳","さ"],["いで"],["あった"],["。"]]}]
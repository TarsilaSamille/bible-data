[{"verse":1,"text":"アダムの系図,けいずは次,つぎのとおりである。神,かみが人,ひとを創造,そうぞうされた時,とき、神,かみをかたどって造,つくり、","tok":[["アダム"],["の"],["系図","けいず"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["神","かみ"],["が"],["人","ひと"],["を"],["創造","そうぞう"],["された"],["時","とき"],["、"],["神","かみ"],["を"],["かたどって"],["造","つくり"],["、"]]},{"verse":2,"text":"彼,かれらを男,おとこと女,おんなとに創造,そうぞうされた。彼,かれらが創造,そうぞうされた時,とき、神,かみは彼,かれらを祝福,しゅくふくして、その名,なをアダムと名,なづけられた。","tok":[["彼","かれ"],["ら"],["を"],["男","おとこ"],["と"],["女","おんな"],["と"],["に"],["創造","そうぞう"],["された"],["。"],["彼","かれ"],["ら"],["が"],["創造","そうぞう"],["された"],["時","とき"],["、"],["神","かみ"],["は"],["彼","かれ"],["ら"],["を"],["祝福","しゅくふく"],["して"],["、"],["その"],["名","な"],["を"],["アダム"],["と"],["名づけられた","なづけられた"],["。"]]},{"verse":3,"text":"アダムは百三十歳,さいになって、自分,じぶんにかたどり、自分,じぶんのかたちのような男,おとこの子,こを生,うみ、その名,なをセツと名,なづけた。","tok":[["アダム"],["は"],["百三十歳","さい"],["に"],["なって"],["、"],["自分","じぶん"],["に"],["かたどり"],["、"],["自分","じぶん"],["の"],["かたち"],["の"],["よう"],["な"],["男の子","おとこのこ"],["を"],["生み","うみ"],["、"],["その"],["名","な"],["を"],["セツ"],["と"],["名づけた","なづけた"],["。"]]},{"verse":4,"text":"アダムがセツを生,うんで後,のち、生,いきた年,としは八百年,ねんであって、ほかに男子,だんしと女子,じょしを生,うんだ。","tok":[["アダム"],["が"],["セツ"],["を"],["生んで","うんで"],["後","の"],["ち"],["、"],["生きた","いきた"],["年","とし"],["は"],["八百","はちひゃく"],["年","ねん"],["で"],["あって"],["、"],["ほか"],["に"],["男子","だんし"],["と"],["女子","じょし"],["を"],["生んだ","うんだ"],["。"]]},{"verse":5,"text":"アダムの生,いきた年,としは合,あわせて九百三十歳,さいであった。そして彼,かれは死,しんだ。","tok":[["アダム"],["の"],["生きた","いきた"],["年","とし"],["は"],["合","あわせ"],["て"],["九百三十","きゅうひゃくさんじゅう"],["歳","さい"],["いで"],["あった"],["。"],["そして"],["彼","かれ"],["は"],["死んだ","しんだ"],["。"]]},{"verse":6,"text":"セツは百五歳,さいになって、エノスを生,うんだ。","tok":[["セツ"],["は"],["百五歳","さい"],["に"],["なって"],["、"],["エノス"],["を"],["生んだ","うんだ"],["。"]]},{"verse":7,"text":"セツはエノスを生,うんだ後,のち、八百七年,ねん生,いきて、男子,だんしと女子,じょしを生,うんだ。","tok":[["セツ"],["は"],["エノス"],["を"],["生んだ","うんだ"],["後","の"],["ち"],["、"],["八百七","はちひゃくなな"],["年","ねん"],["生きて","いきて"],["、"],["男子","だんし"],["と"],["女子","じょし"],["を"],["生んだ","うんだ"],["。"]]},{"verse":8,"text":"セツの年,としは合,あわせて九百十二歳,さいであった。そして彼,かれは死,しんだ。","tok":[["セツ"],["の"],["年","とし"],["は"],["合","あわせ"],["て"],["九百十二","きゅうひゃくじゅうに"],["歳","さい"],["いで"],["あった"],["。"],["そして"],["彼","かれ"],["は"],["死んだ","しんだ"],["。"]]},{"verse":9,"text":"エノスは九十歳,さいになって、カイナンを生,うんだ。","tok":[["エノス"],["は"],["九十歳","さい"],["に"],["なって"],["、"],["カイナン"],["を"],["生んだ","うんだ"],["。"]]},{"verse":10,"text":"エノスはカイナンを生,うんだ後,のち、八百十五年,ねん生,いきて、男子,だんしと女子,じょしを生,うんだ。","tok":[["エノス"],["は"],["カイナン"],["を"],["生んだ","うんだ"],["後","の"],["ち"],["、"],["八百十五","はちひゃくじゅうご"],["年","ねん"],["生きて","いきて"],["、"],["男子","だんし"],["と"],["女子","じょし"],["を"],["生んだ","うんだ"],["。"]]},{"verse":11,"text":"エノスの年,としは合,あわせて九百五歳,さいであった。そして彼,かれは死,しんだ。","tok":[["エノス"],["の"],["年","とし"],["は"],["合","あわせ"],["て"],["九百五歳","さ"],["いで"],["あった"],["。"],["そして"],["彼","かれ"],["は"],["死んだ","しんだ"],["。"]]},{"verse":12,"text":"カイナンは七十歳,さいになって、マハラレルを生,うんだ。","tok":[["カイナン"],["は"],["七十歳","さい"],["に"],["なって"],["、"],["マハラレル"],["を"],["生んだ","うんだ"],["。"]]},{"verse":13,"text":"カイナンはマハラレルを生,うんだ後,のち、八百四十年,ねん生,いきて、男子,だんしと女子,じょしを生,うんだ。","tok":[["カイナン"],["は"],["マハラレル"],["を"],["生んだ","うんだ"],["後","の"],["ち"],["、"],["八百四十","はちひゃくよんじゅう"],["年","ねん"],["生きて","いきて"],["、"],["男子","だんし"],["と"],["女子","じょし"],["を"],["生んだ","うんだ"],["。"]]},{"verse":14,"text":"カイナンの年,としは合,あわせて九百十歳,さいであった。そして彼,かれは死,しんだ。","tok":[["カイナン"],["の"],["年","とし"],["は"],["合","あわせ"],["て"],["九百十歳","さ"],["いで"],["あった"],["。"],["そして"],["彼","かれ"],["は"],["死んだ","しんだ"],["。"]]},{"verse":15,"text":"マハラレルは六十五歳,さいになって、ヤレドを生,うんだ。","tok":[["マハラレル"],["は"],["六十五歳","さい"],["に"],["なって"],["、"],["ヤレド"],["を"],["生んだ","うんだ"],["。"]]},{"verse":16,"text":"マハラレルはヤレドを生,うんだ後,のち、八百三十年,ねん生,いきて、男子,だんしと女子,じょしを生,うんだ。","tok":[["マハラレル"],["は"],["ヤレド"],["を"],["生んだ","うんだ"],["後","の"],["ち"],["、"],["八百三十","はちひゃくさんじゅう"],["年","ねん"],["生きて","いきて"],["、"],["男子","だんし"],["と"],["女子","じょし"],["を"],["生んだ","うんだ"],["。"]]},{"verse":17,"text":"マハラレルの年,としは合,あわせて八百九十五歳,さいであった。そして彼,かれは死,しんだ。","tok":[["マハラレル"],["の"],["年","とし"],["は"],["合","あわせ"],["て"],["八百九十五","はちひゃくきゅうじゅうご"],["歳","さい"],["いで"],["あった"],["。"],["そして"],["彼","かれ"],["は"],["死んだ","しんだ"],["。"]]},{"verse":18,"text":"ヤレドは百六十二歳,さいになって、エノクを生,うんだ。","tok":[["ヤレド"],["は"],["百六十二","ひゃくろくじゅうに"],["歳","さい"],["に"],["なって"],["、"],["エノク"],["を"],["生んだ","うんだ"],["。"]]},{"verse":19,"text":"ヤレドはエノクを生,うんだ後,のち、八百年,ねん生,いきて、男子,だんしと女子,じょしを生,うんだ。","tok":[["ヤレド"],["は"],["エノク"],["を"],["生んだ","うんだ"],["後","の"],["ち"],["、"],["八百","はちひゃく"],["年","ねん"],["生きて","いきて"],["、"],["男子","だんし"],["と"],["女子","じょし"],["を"],["生んだ","うんだ"],["。"]]},{"verse":20,"text":"ヤレドの年,としは合,あわせて九百六十二歳,さいであった。そして彼,かれは死,しんだ。","tok":[["ヤレド"],["の"],["年","とし"],["は"],["合","あわせ"],["て"],["九百六十二","きゅうひゃくろくじゅうに"],["歳","さい"],["いで"],["あった"],["。"],["そして"],["彼","かれ"],["は"],["死んだ","しんだ"],["。"]]},{"verse":21,"text":"エノクは六十五歳,さいになって、メトセラを生,うんだ。","tok":[["エノク"],["は"],["六十五歳","さい"],["に"],["なって"],["、"],["メトセラ"],["を"],["生んだ","うんだ"],["。"]]},{"verse":22,"text":"エノクはメトセラを生,うんだ後,のち、三百年,ねん、神,かみとともに歩,あゆみ、男子,だんしと女子,じょしを生,うんだ。","tok":[["エノク"],["は"],["メトセラ"],["を"],["生んだ","うんだ"],["後","の"],["ち"],["、"],["三百","さんひゃく"],["年","ねん"],["、"],["神","かみ"],["と"],["とも"],["に"],["歩み","あゆみ"],["、"],["男子","だんし"],["と"],["女子","じょし"],["を"],["生んだ","うんだ"],["。"]]},{"verse":23,"text":"エノクの年,としは合,あわせて三百六十五歳,さいであった。","tok":[["エノク"],["の"],["年","とし"],["は"],["合","あわせ"],["て"],["三百六十五","さんひゃくろくじゅうご"],["歳","さい"],["いで"],["あった"],["。"]]},{"verse":24,"text":"エノクは神,かみとともに歩,あゆみ、神,かみが彼,かれを取,とられたので、いなくなった。","tok":[["エノク"],["は"],["神","かみ"],["と"],["とも"],["に"],["歩み","あゆみ"],["、"],["神","かみ"],["が"],["彼","かれ"],["を"],["取られた","とられた"],["ので"],["、"],["いなく"],["なった"],["。"]]},{"verse":25,"text":"メトセラは百八十七歳,さいになって、レメクを生,うんだ。","tok":[["メトセラ"],["は"],["百八十七","ひゃくはちじゅうなな"],["歳","さい"],["に"],["なって"],["、"],["レメク"],["を"],["生んだ","うんだ"],["。"]]},{"verse":26,"text":"メトセラはレメクを生,うんだ後,のち、七百八十二年,ねん生,いきて、男子,だんしと女子,じょしを生,うんだ。","tok":[["メトセラ"],["は"],["レメク"],["を"],["生んだ","うんだ"],["後","の"],["ち"],["、"],["七百八十二","ななひゃくはちじゅうに"],["年","ねん"],["生きて","いきて"],["、"],["男子","だんし"],["と"],["女子","じょし"],["を"],["生んだ","うんだ"],["。"]]},{"verse":27,"text":"メトセラの年,としは合,あわせて九百六十九歳,さいであった。そして彼,かれは死,しんだ。","tok":[["メトセラ"],["の"],["年","とし"],["は"],["合","あわせ"],["て"],["九百六十九","きゅうひゃくろくじゅうきゅう"],["歳","さい"],["いで"],["あった"],["。"],["そして"],["彼","かれ"],["は"],["死んだ","しんだ"],["。"]]},{"verse":28,"text":"レメクは百八十二歳,さいになって、男,おとこの子,こを生,うみ、","tok":[["レメク"],["は"],["百八十二","ひゃくはちじゅうに"],["歳","さい"],["に"],["なって"],["、"],["男の子","おとこのこ"],["を"],["生み","うみ"],["、"]]},{"verse":29,"text":"「この子,ここそ、主,しゅが地,ちをのろわれたため、骨折,ほねおり働,はたらくわれわれを慰,なぐさめるもの」と言,いって、その名,なをノアと名,なづけた。","tok":[["「"],["この"],["子","こ"],["こそ"],["、"],["主","しゅ"],["が"],["地","ち"],["を"],["のろわれた"],["ため"],["、"],["骨折り","ほねおり"],["働く","はたらく"],["われわれ"],["を"],["慰さめる","なぐさめる"],["もの"],["」"],["と"],["言って","いって"],["、"],["その"],["名","な"],["を"],["ノア"],["と"],["名づけた","なづけた"],["。"]]},{"verse":30,"text":"レメクはノアを生,うんだ後,のち、五百九十五年,ねん生,いきて、男子,だんしと女子,じょしを生,うんだ。","tok":[["レメク"],["は"],["ノア"],["を"],["生んだ","うんだ"],["後","の"],["ち"],["、"],["五百九十五","ごひゃくきゅうじゅうご"],["年","ねん"],["生きて","いきて"],["、"],["男子","だんし"],["と"],["女子","じょし"],["を"],["生んだ","うんだ"],["。"]]},{"verse":31,"text":"レメクの年,としは合,あわせて七百七十七歳,さいであった。そして彼,かれは死,しんだ。","tok":[["レメク"],["の"],["年","とし"],["は"],["合","あわせ"],["て"],["七百七十七","ななひゃくななじゅうなな"],["歳","さい"],["いで"],["あった"],["。"],["そして"],["彼","かれ"],["は"],["死んだ","しんだ"],["。"]]},{"verse":32,"text":"ノアは五百歳,さいになって、セム、ハム、ヤペテを生,うんだ。","tok":[["ノア"],["は"],["五百歳","さい"],["に"],["なって"],["、"],["セム"],["、"],["ハム"],["、"],["ヤペテ"],["を"],["生んだ","うんだ"],["。"]]}]
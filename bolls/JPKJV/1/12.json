[{"verse":1,"text":"時,ときに主,しゅはアブラムに言,いわれた、「あなたは国,くにを出,でて、親族,しんぞくに別,わかれ、父,ちちの家,いえを離,はなれ、わたしが示,しめす地,ちに行,いきなさい。","tok":[["時","とき"],["に"],["主","しゅ"],["は"],["アブラム"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["は"],["国","くに"],["を"],["出て","でて"],["、"],["親族","しんぞく"],["に"],["別かれ","わかれ"],["、"],["父","ちち"],["の"],["家","いえ"],["を"],["離れ","はなれ"],["、"],["わたし"],["が"],["示めす","しめす"],["地","ち"],["に"],["行き","いき"],["なさい"],["。"]]},{"verse":2,"text":"わたしはあなたを大,おおいなる国民,こくみんとし、あなたを祝福,しゅくふくし、あなたの名,なを大,おおきくしよう。あなたは祝福,しゅくふくの基,もといとなるであろう。","tok":[["わたし"],["は"],["あなた"],["を"],["大いなる","おおいなる"],["国民","こくみん"],["と"],["し"],["、"],["あなた"],["を"],["祝福","しゅくふく"],["し"],["、"],["あなた"],["の"],["名","な"],["を"],["大きく","おおきく"],["しよう"],["。"],["あなた"],["は"],["祝福","しゅくふく"],["の"],["基い","もとい"],["と"],["なるで"],["あろう"],["。"]]},{"verse":3,"text":"あなたを祝福,しゅくふくする者,ものをわたしは祝福,しゅくふくし、あなたをのろう者,ものをわたしはのろう。地,ちのすべてのやからは、あなたによって祝福,しゅくふくされる」。","tok":[["あなた"],["を"],["祝福","しゅくふく"],["する"],["者","もの"],["を"],["わたし"],["は"],["祝福","しゅくふく"],["し"],["、"],["あなた"],["を"],["の"],["ろう者","ろうもの"],["を"],["わたし"],["は"],["のろう"],["。"],["地","ち"],["の"],["すべて"],["の"],["やから"],["は"],["、"],["あなた"],["によって"],["祝福","しゅくふく"],["される"],["」"],["。"]]},{"verse":4,"text":"アブラムは主,しゅが言,いわれたようにいで立,たった。ロトも彼,かれと共,ともに行,いった。アブラムはハランを出,でたとき七十五歳,さいであった。","tok":[["アブラム"],["は"],["主","しゅ"],["が"],["言われた","いわれた"],["よう"],["に"],["いで立った","いでたった"],["。"],["ロト"],["も"],["彼","かれ"],["と"],["共","とも"],["に"],["行った","いった"],["。"],["アブラム"],["は"],["ハラン"],["を"],["出た","でた"],["とき"],["七十五歳","さ"],["いで"],["あった"],["。"]]},{"verse":5,"text":"アブラムは妻,つまサライと、弟,おとうとの子,こロトと、集,あつめたすべての財産,ざいさんと、ハランで獲,えた人々,ひとびととを携,たずさえてカナンに行,いこうとしていで立,たち、カナンの地,ちにきた。","tok":[["アブラム"],["は"],["妻","つま"],["サライ"],["と"],["、"],["弟","おとうと"],["の"],["子","こ"],["ロト"],["と"],["、"],["集めた","あつめた"],["すべて"],["の"],["財産","ざいさん"],["と"],["、"],["ハラン"],["で"],["獲た","えた"],["人々","ひとびと"],["と"],["を"],["携えて","たずさえて"],["カナン"],["に"],["行こう","いこう"],["として"],["いで立ち","いでたち"],["、"],["カナン"],["の"],["地","ち"],["に"],["きた"],["。"]]},{"verse":6,"text":"アブラムはその地,ちを通,とおってシケムの所,ところ、モレのテレビンの木,きのもとに着,ついた。そのころカナンびとがその地,ちにいた。","tok":[["アブラム"],["は"],["その"],["地","ち"],["を"],["通って","とおって"],["シケム"],["の"],["所","ところ"],["、"],["モレ"],["の"],["テレビン"],["の"],["木","き"],["の"],["もと"],["に"],["着いた","ついた"],["。"],["その"],["ころ"],["カナン"],["びと"],["が"],["その"],["地","ち"],["に"],["いた"],["。"]]},{"verse":7,"text":"時,ときに主,しゅはアブラムに現,あらわれて言,いわれた、「わたしはあなたの子孫,しそんにこの地,ちを与,あたえます」。アブラムは彼,かれに現,あらわれた主,しゅのために、そこに祭壇,さいだんを築,きずいた。","tok":[["時","とき"],["に"],["主","しゅ"],["は"],["アブラム"],["に"],["現われて","あらわれて"],["言われた","いわれた"],["、"],["「"],["わたし"],["は"],["あなた"],["の"],["子孫","しそん"],["に"],["この"],["地","ち"],["を"],["与えます","あたえます"],["」"],["。"],["アブラム"],["は"],["彼","かれ"],["に"],["現われた","あらわれた"],["主","しゅ"],["の"],["ため"],["に"],["、"],["そこ"],["に"],["祭壇","さいだん"],["を"],["築いた","きずいた"],["。"]]},{"verse":8,"text":"彼,かれはそこからベテルの東,ひがしの山,やまに移,うつって天幕,てんまくを張,はった。西,にしにはベテル、東,ひがしにはアイがあった。そこに彼,かれは主,しゅのために祭壇,さいだんを築,きずいて、主,しゅの名,なを呼,よんだ。","tok":[["彼","かれ"],["は"],["そこ"],["から"],["ベテル"],["の"],["東","ひがし"],["の"],["山","やま"],["に"],["移って","うつって"],["天幕","てんまく"],["を"],["張った","はった"],["。"],["西","にし"],["に"],["は"],["ベテル"],["、"],["東","ひがし"],["に"],["は"],["アイ"],["が"],["あった"],["。"],["そこ"],["に"],["彼","かれ"],["は"],["主","しゅ"],["の"],["ため"],["に"],["祭壇","さいだん"],["を"],["築いて","きずいて"],["、"],["主","しゅ"],["の"],["名","な"],["を"],["呼んだ","よんだ"],["。"]]},{"verse":9,"text":"アブラムはなお進,すすんでネゲブに移,うつった。","tok":[["アブラム"],["は"],["なお"],["進んで","すすんで"],["ネゲブ"],["に"],["移った","うつった"],["。"]]},{"verse":10,"text":"さて、その地,ちにききんがあったのでアブラムはエジプトに寄留,きりゅうしようと、そこに下,くだった。ききんがその地,ちに激,はげしかったからである。","tok":[["さて"],["、"],["その"],["地","ち"],["に"],["ききん"],["が"],["あった"],["ので"],["アブラム"],["は"],["エジプト"],["に"],["寄留","きりゅう"],["しよう"],["と"],["、"],["そこ"],["に"],["下った","くだった"],["。"],["ききん"],["が"],["その"],["地","ち"],["に"],["激しかった","はげしかった"],["から"],["で"],["ある"],["。"]]},{"verse":11,"text":"エジプトにはいろうとして、そこに近,ちかづいたとき、彼,かれは妻,つまサライに言,いった、「わたしはあなたが美,うつくしい女,おんなであるのを知,しっています。","tok":[["エジプト"],["に"],["はいろう"],["として"],["、"],["そこ"],["に"],["近づいた","ちかづいた"],["とき"],["、"],["彼","かれ"],["は"],["妻","つま"],["サライ"],["に"],["言った","いった"],["、"],["「"],["わたし"],["は"],["あなた"],["が"],["美しい","うつくしい"],["女","おんな"],["で"],["ある"],["の"],["を"],["知って","しって"],["います"],["。"]]},{"verse":12,"text":"それでエジプトびとがあなたを見,みる時,とき、これは彼,かれの妻,つまであると言,いってわたしを殺,ころし、あなたを生,いかしておくでしょう。","tok":[["それ"],["で"],["エジプト"],["びと"],["が"],["あなた"],["を"],["見る","みる"],["時","とき"],["、"],["これ"],["は"],["彼","かれ"],["の"],["妻","つま"],["で"],["ある"],["と"],["言って","いって"],["わたし"],["を"],["殺ろし","ころし"],["、"],["あなた"],["を"],["生かして","いかして"],["おくでしょう"],["。"]]},{"verse":13,"text":"どうかあなたは、わたしの妹,いもうとだと言,いってください。そうすればわたしはあなたのおかげで無事,ぶじであり、わたしの命,いのちはあなたによって助,たすかるでしょう」。","tok":[["どう"],["か"],["あなた"],["は"],["、"],["わたし"],["の"],["妹","いもうと"],["だ"],["と"],["言って","いって"],["ください"],["。"],["そう"],["すれば"],["わたし"],["は"],["あなた"],["の"],["おかげ"],["で"],["無事","ぶじ"],["で"],["あり"],["、"],["わたし"],["の"],["命","いのち"],["は"],["あなた"],["によって"],["助かるでしょう","たすかるでしょう"],["」"],["。"]]},{"verse":14,"text":"アブラムがエジプトにはいった時,ときエジプトびとはこの女,おんなを見,みて、たいそう美,うつくしい人,ひとであるとし、","tok":[["アブラム"],["が"],["エジプト"],["に"],["はいった"],["時","とき"],["エジプト"],["び"],["と"],["は"],["この"],["女","おんな"],["を"],["見て","みて"],["、"],["たいそう"],["美しい","うつくしい"],["人","ひと"],["で"],["ある"],["と"],["し"],["、"]]},{"verse":15,"text":"またパロの高官,こうかんたちも彼女,かのじょを見,みてパロの前,まえでほめたので、女,おんなはパロの家,いえに召,めし入,いれられた。","tok":[["また"],["パロ"],["の"],["高官","こうかん"],["たち"],["も"],["彼女","かのじょ"],["を"],["見て","みて"],["パロ"],["の"],["前","まえ"],["で"],["ほめた"],["ので"],["、"],["女","おんな"],["は"],["パロ"],["の"],["家","いえ"],["に"],["召","めし"],["入れられた","いれられた"],["。"]]},{"verse":16,"text":"パロは彼女,かのじょのゆえにアブラムを厚,あつくもてなしたので、アブラムは多,おおくの羊,ひつじ、牛,うし、雌雄,しゆうのろば、男女,だんじょの奴隷,どれいおよび、らくだを得,えた。","tok":[["パロ"],["は"],["彼女","かのじょ"],["の"],["ゆえ"],["に"],["アブラム"],["を"],["厚く","あつく"],["もてなした"],["ので"],["、"],["アブラム"],["は"],["多く","おおく"],["の"],["羊","ひつじ"],["、"],["牛","うし"],["、"],["雌雄","しゆう"],["の"],["ろば"],["、"],["男女","だんじょ"],["の"],["奴隷","どれい"],["および"],["、"],["らくだ"],["を"],["得た","えた"],["。"]]},{"verse":17,"text":"ところで主,しゅはアブラムの妻,つまサライのゆえに、激,はげしい疫病,えきびょうをパロとその家,いえに下,くだされた。","tok":[["ところ"],["で"],["主","しゅ"],["は"],["アブラム"],["の"],["妻","つま"],["サライ"],["の"],["ゆえ"],["に"],["、"],["激しい","はげしい"],["疫病","えきびょう"],["を"],["パロ"],["と"],["その"],["家","いえ"],["に"],["下された","くだされた"],["。"]]},{"verse":18,"text":"パロはアブラムを召,めし寄,よせて言,いった、「あなたはわたしになんという事,ことをしたのですか。なぜ彼女,かのじょが妻,つまであるのをわたしに告,つげなかったのですか。","tok":[["パロ"],["は"],["アブラム"],["を"],["召寄せて","めしよせて"],["言った","いった"],["、"],["「"],["あなた"],["は"],["わたし"],["に"],["なん"],["と"],["いう"],["事","こと"],["を"],["した"],["の"],["です"],["か"],["。"],["なぜ"],["彼女","かのじょ"],["が"],["妻","つま"],["で"],["ある"],["の"],["を"],["わたし"],["に"],["告","つげ"],["なかった"],["の"],["です"],["か"],["。"]]},{"verse":19,"text":"あなたはなぜ、彼女,かのじょはわたしの妹,いもうとですと言,いったのですか。わたしは彼女,かのじょを妻,つまにしようとしていました。さあ、あなたの妻,つまはここにいます。連,つれて行,いってください」。","tok":[["あなた"],["は"],["なぜ"],["、"],["彼女","かのじょ"],["は"],["わたし"],["の"],["妹","いもうと"],["です"],["と"],["言った","いった"],["の"],["です"],["か"],["。"],["わたし"],["は"],["彼女","かのじょ"],["を"],["妻","つま"],["に"],["しよう"],["として"],["いました"],["。"],["さあ"],["、"],["あなた"],["の"],["妻","つま"],["は"],["ここ"],["に"],["います"],["。"],["連れて","つれて"],["行って","いって"],["ください"],["」"],["。"]]},{"verse":20,"text":"パロは彼,かれの事,ことについて人々,ひとびとに命,めいじ、彼,かれとその妻,つまおよびそのすべての持,もち物,ものを送,おくり去,さらせた。","tok":[["パロ"],["は"],["彼","かれ"],["の"],["事","こと"],["について"],["人々","ひとびと"],["に"],["命じ","めいじ"],["、"],["彼","かれ"],["と"],["その"],["妻","つま"],["および"],["その"],["すべて"],["の"],["持物","もちもの"],["を"],["送り","おくり"],["去らせた","さらせた"],["。"]]}]
[{"verse":1,"text":"イサクは年老,としおい、目,めがかすんで見,みえなくなった時,とき、長子,ちょうしエサウを呼,よんで言,いった、「子,こよ」。彼,かれは答,こたえて言,いった、「ここにおります」。","tok":[["イサク"],["は"],["年老い","としおい"],["、"],["目","め"],["が"],["かすんで"],["見えなく","みえなく"],["なった"],["時","とき"],["、"],["長子","ちょうし"],["エサウ"],["を"],["呼んで","よんで"],["言った","いった"],["、"],["「"],["子","こ"],["よ"],["」"],["。"],["彼","かれ"],["は"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["ここ"],["に"],["おります"],["」"],["。"]]},{"verse":2,"text":"イサクは言,いった。「わたしは年老,としおいて、いつ死,しぬかも知,しれない。","tok":[["イサク"],["は"],["言った","いった"],["。"],["「"],["わたし"],["は"],["年老いて","としおいて"],["、"],["いつ"],["死ぬ","しぬ"],["か"],["も"],["知れない","しれない"],["。"]]},{"verse":3,"text":"それであなたの武器,ぶき、弓矢,ゆみやをもって野,のに出,でかけ、わたしのために、しかの肉,にくをとってきて、","tok":[["それ"],["で"],["あなた"],["の"],["武器","ぶき"],["、"],["弓矢","ゆみや"],["を"],["もって"],["野","の"],["に"],["出かけ","でかけ"],["、"],["わたし"],["の"],["ため"],["に"],["、"],["しか"],["の"],["肉","にく"],["を"],["とって"],["きて"],["、"]]},{"verse":4,"text":"わたしの好,すきなおいしい食,たべ物,ものを作,つくり、持,もってきて食,たべさせよ。わたしは死,しぬ前,まえにあなたを祝福,しゅくふくしよう」。","tok":[["わたし"],["の"],["好き","すき"],["な"],["おいしい"],["食べ物","たべもの"],["を"],["作り","つくり"],["、"],["持って","もって"],["きて"],["食べさせ","たべさせ"],["よ"],["。"],["わたし"],["は"],["死ぬ","しぬ"],["前","まえ"],["に"],["あなた"],["を"],["祝福","しゅくふく"],["しよう"],["」"],["。"]]},{"verse":5,"text":"イサクがその子,こエサウに語,かたるのをリベカは聞,きいていた。やがてエサウが、しかの肉,にくを獲,えようと野,のに出,でかけたとき、","tok":[["イサク"],["が"],["その"],["子","こ"],["エサウ"],["に"],["語る","かたる"],["の"],["を"],["リベカ"],["は"],["聞いて","きいて"],["いた"],["。"],["やがて"],["エサウ"],["が"],["、"],["しか"],["の"],["肉","にく"],["を"],["獲よう","えよう"],["と"],["野","の"],["に"],["出かけた","でかけた"],["とき"],["、"]]},{"verse":6,"text":"リベカはその子,こヤコブに言,いった、「わたしは聞,きいていましたが、父,ちちは兄,あにエサウに、","tok":[["リベカ"],["は"],["その"],["子","こ"],["ヤコブ"],["に"],["言った","いった"],["、"],["「"],["わたし"],["は"],["聞いて","きいて"],["いました"],["が"],["、"],["父","ちち"],["は"],["兄","あに"],["エサウ"],["に"],["、"]]},{"verse":7,"text":"『わたしのために、しかの肉,にくをとってきて、おいしい食,たべ物,ものを作,つくり、わたしに食,たべさせよ。わたしは死,しぬ前,まえに、主,しゅの前,まえであなたを祝福,しゅくふくしよう』と言,いいました。","tok":[["『"],["わたし"],["の"],["ため"],["に"],["、"],["しか"],["の"],["肉","にく"],["を"],["とって"],["きて"],["、"],["おいしい"],["食べ物","たべもの"],["を"],["作り","つくり"],["、"],["わたし"],["に"],["食べさせ","たべさせ"],["よ"],["。"],["わたし"],["は"],["死ぬ","しぬ"],["前","まえ"],["に"],["、"],["主","しゅ"],["の"],["前","まえ"],["で"],["あなた"],["を"],["祝福","しゅくふく"],["しよう"],["』"],["と"],["言いました","いいました"],["。"]]},{"verse":8,"text":"それで、子,こよ、わたしの言葉,ことばにしたがい、わたしの言,いうとおりにしなさい。","tok":[["それ"],["で"],["、"],["子","こ"],["よ"],["、"],["わたし"],["の"],["言葉","ことば"],["に"],["したがい"],["、"],["わたし"],["の"],["言う","いう"],["とおり"],["に"],["し"],["なさい"],["。"]]},{"verse":9,"text":"群,むれの所,ところへ行,いって、そこからやぎの子,この良,よいのを二頭,とうわたしの所,ところに取,とってきなさい。わたしはそれで父,ちちのために、父,ちちの好,すきなおいしい食,たべ物,ものを作,つくりましょう。","tok":[["群れ","むれ"],["の"],["所","ところ"],["へ"],["行って","いって"],["、"],["そこ"],["から"],["やぎ"],["の"],["子","こ"],["の"],["良い","よい"],["の"],["を"],["二頭","とうわたし"],["の"],["所","ところ"],["に"],["取って","とって"],["き"],["なさい"],["。"],["わたし"],["は"],["それ"],["で"],["父","ちち"],["の"],["ため"],["に"],["、"],["父","ちち"],["の"],["好き","すき"],["な"],["おいしい"],["食べ物","たべもの"],["を"],["作りましょう","つくりましょう"],["。"]]},{"verse":10,"text":"あなたはそれを持,もって行,いって父,ちちに食,たべさせなさい。父,ちちは死,しぬ前,まえにあなたを祝福,しゅくふくするでしょう」。","tok":[["あなた"],["は"],["それ"],["を"],["持って","もって"],["行って","いって"],["父","ちち"],["に"],["食べさせ","たべさせ"],["なさい"],["。"],["父","ちち"],["は"],["死ぬ","しぬ"],["前","まえ"],["に"],["あなた"],["を"],["祝福","しゅくふく"],["するでしょう"],["」"],["。"]]},{"verse":11,"text":"ヤコブは母,ははリベカに言,いった、「兄,あにエサウは毛深,けぶかい人,ひとですが、わたしはなめらかです。","tok":[["ヤコブ"],["は"],["母","はは"],["リベカ"],["に"],["言った","いった"],["、"],["「"],["兄","あに"],["エサウ"],["は"],["毛深い","けぶかい"],["人","ひと"],["です"],["が"],["、"],["わたし"],["は"],["なめらか"],["です"],["。"]]},{"verse":12,"text":"おそらく父,ちちはわたしにさわってみるでしょう。そうすればわたしは父,ちちを欺,あざむく者,ものと思,おもわれ、祝福,しゅくふくを受,うけず、かえってのろいを受,うけるでしょう」。","tok":[["おそらく"],["父","ちち"],["は"],["わたし"],["に"],["さわって"],["みるでしょう"],["。"],["そう"],["すれば"],["わたし"],["は"],["父","ちち"],["を"],["欺く","あざむく"],["者","もの"],["と"],["思われ","おもわれ"],["、"],["祝福","しゅくふく"],["を"],["受ず","うけず"],["、"],["かえって"],["のろい"],["を"],["受るでしょう","うけるでしょう"],["」"],["。"]]},{"verse":13,"text":"母,ははは彼,かれに言,いった、「子,こよ、あなたがうけるのろいはわたしが受,うけます。ただ、わたしの言葉,ことばに従,したがい、行,いって取,とってきなさい」。","tok":[["母","はは"],["は"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["子","こ"],["よ"],["、"],["あなた"],["が"],["うける"],["のろい"],["は"],["わたし"],["が"],["受ます","うけます"],["。"],["ただ"],["、"],["わたし"],["の"],["言葉","ことば"],["に"],["従い","したがい"],["、"],["行って","いって"],["取って","とって"],["き"],["なさい"],["」"],["。"]]},{"verse":14,"text":"そこで彼,かれは行,いってやぎの子,こを取,とり、母,ははの所,ところに持,もってきたので、母,ははは父,ちちの好,すきなおいしい食,たべ物,ものを作,つくった。","tok":[["そこ"],["で"],["彼","かれ"],["は"],["行って","いって"],["やぎ"],["の"],["子","こ"],["を"],["取","とり"],["、"],["母","はは"],["の"],["所","ところ"],["に"],["持って","もって"],["きた"],["ので"],["、"],["母","はは"],["は"],["父","ちち"],["の"],["好き","すき"],["な"],["おいしい"],["食べ物","たべもの"],["を"],["作った","つくった"],["。"]]},{"verse":15,"text":"リベカは家,いえにあった長子,ちょうしエサウの晴着,はれぎを取,とって、弟,おとうとヤコブに着,きせ、","tok":[["リベカ"],["は"],["家","いえ"],["に"],["あった"],["長子","ちょうし"],["エサウ"],["の"],["晴着","はれぎ"],["を"],["取って","とって"],["、"],["弟","おとうと"],["ヤコブ"],["に"],["着せ","きせ"],["、"]]},{"verse":16,"text":"また子,こやぎの皮,かわを手,てと首,くびのなめらかな所,ところとにつけさせ、","tok":[["また"],["子やぎ","こやぎ"],["の"],["皮","かわ"],["を"],["手","て"],["と"],["首","くび"],["の"],["なめらか"],["な"],["所","ところ"],["と"],["に"],["つけさせ"],["、"]]},{"verse":17,"text":"彼女,かのじょが作,つくったおいしい食,たべ物,ものとパンとをその子,こヤコブの手,てにわたした。","tok":[["彼女","かのじょ"],["が"],["作った","つくった"],["おいしい"],["食べ物","たべもの"],["と"],["パン"],["と"],["を"],["その"],["子","こ"],["ヤコブ"],["の"],["手","て"],["に"],["わたした"],["。"]]},{"verse":18,"text":"そこでヤコブは父,ちちの所,ところへ行,いって言,いった、「父,ちちよ」。すると父,ちちは言,いった、「わたしはここにいる。子,こよ、あなたはだれか」。","tok":[["そこ"],["で"],["ヤコブ"],["は"],["父","ちち"],["の"],["所","ところ"],["へ"],["行って","いって"],["言った","いった"],["、"],["「"],["父","ちち"],["よ"],["」"],["。"],["する"],["と"],["父","ちち"],["は"],["言った","いった"],["、"],["「"],["わたし"],["は"],["ここ"],["に"],["いる"],["。"],["子","こ"],["よ"],["、"],["あなた"],["は"],["だれ"],["か"],["」"],["。"]]},{"verse":19,"text":"ヤコブは父,ちちに言,いった、「長子,ちょうしエサウです。あなたがわたしに言,いわれたとおりにいたしました。どうぞ起,おきて、すわってわたしのしかの肉,にくを食,たべ、あなたみずからわたしを祝福,しゅくふくしてください」。","tok":[["ヤコブ"],["は"],["父","ちち"],["に"],["言った","いった"],["、"],["「"],["長子","ちょうし"],["エサウ"],["です"],["。"],["あなた"],["が"],["わたし"],["に"],["言われた","いわれた"],["とおり"],["に"],["いたしました"],["。"],["どうぞ"],["起きて","おきて"],["、"],["すわって"],["わたし"],["の"],["しか"],["の"],["肉","にく"],["を"],["食べ","たべ"],["、"],["あなた"],["みずから"],["わたし"],["を"],["祝福","しゅくふく"],["して"],["ください"],["」"],["。"]]},{"verse":20,"text":"イサクはその子,こに言,いった、「子,こよ、どうしてあなたはこんなに早,はやく手,てに入,いれたのか」。彼,かれは言,いった、「あなたの神,かみ、主,しゅがわたしにしあわせを授,さづけられたからです」。","tok":[["イサク"],["は"],["その"],["子","こ"],["に"],["言った","いった"],["、"],["「"],["子","こ"],["よ"],["、"],["どう"],["して"],["あなた"],["は"],["こんな"],["に"],["早く","はやく"],["手","て"],["に"],["入れた","いれた"],["の"],["か"],["」"],["。"],["彼","かれ"],["は"],["言った","いった"],["、"],["「"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["わたし"],["に"],["しあわせ"],["を"],["授","さ"],["づけられた"],["から"],["です"],["」"],["。"]]},{"verse":21,"text":"イサクはヤコブに言,いった、「子,こよ、近寄,ちかよりなさい。わたしは、さわってみて、あなたが確,たしかにわが子,こエサウであるかどうかをみよう」。","tok":[["イサク"],["は"],["ヤコブ"],["に"],["言った","いった"],["、"],["「"],["子","こ"],["よ"],["、"],["近寄り","ちかより"],["なさい"],["。"],["わたし"],["は"],["、"],["さわって"],["みて"],["、"],["あなた"],["が"],["確か","たしか"],["に"],["わが"],["子","こ"],["エサウ"],["で"],["ある"],["か"],["どう"],["か"],["を"],["みよう"],["」"],["。"]]},{"verse":22,"text":"ヤコブが、父,ちちイサクに近寄,ちかよったので、イサクは彼,かれにさわってみて言,いった、「声,こえはヤコブの声,こえだが、手,てはエサウの手,てだ」。","tok":[["ヤコブ"],["が"],["、"],["父","ちち"],["イサク"],["に"],["近寄った","ちかよった"],["ので"],["、"],["イサク"],["は"],["彼","かれ"],["に"],["さわって"],["みて"],["言った","いった"],["、"],["「"],["声","こえ"],["は"],["ヤコブ"],["の"],["声","こえ"],["だ"],["が"],["、"],["手","て"],["は"],["エサウ"],["の"],["手","て"],["だ"],["」"],["。"]]},{"verse":23,"text":"ヤコブの手,てが兄,あにエサウの手,てのように毛深,けぶかかったため、イサクはヤコブを見,みわけることができなかったので、彼,かれを祝福,しゅくふくした。","tok":[["ヤコブ"],["の"],["手","て"],["が"],["兄","あに"],["エサウ"],["の"],["手","て"],["の"],["よう"],["に"],["毛深かった","けぶかかった"],["ため"],["、"],["イサク"],["は"],["ヤコブ"],["を"],["見わける","みわける"],["こと"],["が"],["できなかった"],["ので"],["、"],["彼","かれ"],["を"],["祝福","しゅくふく"],["した"],["。"]]},{"verse":24,"text":"イサクは言,いった、「あなたは確,たしかにわが子,こエサウですか」。彼,かれは言,いった、「そうです」。","tok":[["イサク"],["は"],["言った","いった"],["、"],["「"],["あなた"],["は"],["確か","たしか"],["に"],["わが"],["子","こ"],["エサウ"],["です"],["か"],["」"],["。"],["彼","かれ"],["は"],["言った","いった"],["、"],["「"],["そう"],["です"],["」"],["。"]]},{"verse":25,"text":"イサクは言,いった、「わたしの所,ところへ持,もってきなさい。わが子,このしかの肉,にくを食,たべて、わたしみずから、あなたを祝福,しゅくふくしよう」。ヤコブがそれを彼,かれの所,ところに持,もってきたので、彼,かれは食,たべた。またぶどう酒,しゅを持,もってきたので、彼,かれは飲,のんだ。","tok":[["イサク"],["は"],["言った","いった"],["、"],["「"],["わたし"],["の"],["所","ところ"],["へ"],["持って","もって"],["き"],["なさい"],["。"],["わが"],["子","こ"],["の"],["しか"],["の"],["肉","にく"],["を"],["食べて","たべて"],["、"],["わたし"],["みずから"],["、"],["あなた"],["を"],["祝福","しゅくふく"],["しよう"],["」"],["。"],["ヤコブ"],["が"],["それ"],["を"],["彼","かれ"],["の"],["所","ところ"],["に"],["持って","もって"],["きた"],["ので"],["、"],["彼","かれ"],["は"],["食べた","たべた"],["。"],["また"],["ぶどう酒","ぶどうしゅ"],["を"],["持って","もって"],["きた"],["ので"],["、"],["彼","かれ"],["は"],["飲んだ","のんだ"],["。"]]},{"verse":26,"text":"そして父,ちちイサクは彼,かれに言,いった、「子,こよ、さあ、近寄,ちかよってわたしに口,くちづけしなさい」。","tok":[["そして"],["父","ちち"],["イサク"],["は"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["子","こ"],["よ"],["、"],["さあ"],["、"],["近寄って","ちかよって"],["わたし"],["に"],["口づけ","くちづけ"],["し"],["なさい"],["」"],["。"]]},{"verse":27,"text":"彼,かれが近寄,ちかよって口,くちづけした時,とき、イサクはその着物,きもののかおりをかぎ、彼,かれを祝福,しゅくふくして言,いった、「ああ、わが子,このかおりは、主,しゅが祝福,しゅくふくされた野,ののかおりのようだ。","tok":[["彼","かれ"],["が"],["近寄って","ちかよって"],["口づけ","くちづけ"],["した"],["時","とき"],["、"],["イサク"],["は"],["その"],["着物","きもの"],["の"],["かおり"],["を"],["かぎ"],["、"],["彼","かれ"],["を"],["祝福","しゅくふく"],["して"],["言った","いった"],["、"],["「"],["ああ"],["、"],["わが"],["子","こ"],["の"],["かおり"],["は"],["、"],["主","しゅ"],["が"],["祝福","しゅくふく"],["された"],["野","の"],["の"],["かおり"],["の"],["よう"],["だ"],["。"]]},{"verse":28,"text":"どうか神,かみが、天,てんの露,つゆと、地,ちの肥,こえたところと、多,おおくの穀物,こくもつと、新,あたらしいぶどう酒,しゅとをあなたに賜,たまわるように。","tok":[["どう"],["か"],["神","かみ"],["が"],["、"],["天","てん"],["の"],["露","つゆ"],["と"],["、"],["地","ち"],["の"],["肥","こえ"],["た"],["ところ"],["と"],["、"],["多く","おおく"],["の"],["穀物","こくもつ"],["と"],["、"],["新らしい","あたらしい"],["ぶどう酒","ぶどうしゅ"],["と"],["を"],["あなた"],["に"],["賜わる","たまわる"],["よう"],["に"],["。"]]},{"verse":29,"text":"もろもろの民,たみはあなたに仕,つかえ、もろもろの国,くにはあなたに身,みをかがめる。あなたは兄弟,きょうだいたちの主,しゅとなり、あなたの母,ははの子,こらは、あなたに身,みをかがめるであろう。あなたをのろう者,ものはのろわれ、あなたを祝福,しゅくふくする者,ものは祝福,しゅくふくされる」。","tok":[["もろもろ"],["の"],["民","たみ"],["は"],["あなた"],["に"],["仕え","つかえ"],["、"],["もろもろ"],["の"],["国","くに"],["は"],["あなた"],["に"],["身","み"],["を"],["かがめる"],["。"],["あなた"],["は"],["兄弟","きょうだい"],["たち"],["の"],["主","しゅ"],["と"],["なり"],["、"],["あなた"],["の"],["母","はは"],["の"],["子","こ"],["ら"],["は"],["、"],["あなた"],["に"],["身","み"],["を"],["かがめるで"],["あろう"],["。"],["あなた"],["を"],["の"],["ろう者","ろうもの"],["は"],["のろわれ"],["、"],["あなた"],["を"],["祝福","しゅくふく"],["する"],["者","もの"],["は"],["祝福","しゅくふく"],["される"],["」"],["。"]]},{"verse":30,"text":"イサクがヤコブを祝福,しゅくふくし終,おわって、ヤコブが父,ちちイサクの前,まえから出,でて行,いくとすぐ、兄,あにエサウが狩,かりから帰,かえってきた。","tok":[["イサク"],["が"],["ヤコブ"],["を"],["祝福","しゅくふく"],["し終わって","しおわって"],["、"],["ヤコブ"],["が"],["父","ちち"],["イサク"],["の"],["前","まえ"],["から"],["出て","でて"],["行く","いく"],["と"],["すぐ"],["、"],["兄","あに"],["エサウ"],["が"],["狩","かり"],["から"],["帰えって","かえって"],["きた"],["。"]]},{"verse":31,"text":"彼,かれもまたおいしい食,たべ物,ものを作,つくって、父,ちちの所,ところに持,もってきて、言,いった、「父,ちちよ、起,おきてあなたの子,このしかの肉,にくを食,たべ、あなたみずから、わたしを祝福,しゅくふくしてください」。","tok":[["彼","かれ"],["も"],["また"],["おいしい"],["食べ物","たべもの"],["を"],["作って","つくって"],["、"],["父","ちち"],["の"],["所","ところ"],["に"],["持って","もって"],["きて"],["、"],["言った","いった"],["、"],["「"],["父","ちち"],["よ"],["、"],["起きて","おきて"],["あなた"],["の"],["子","こ"],["の"],["しか"],["の"],["肉","にく"],["を"],["食べ","たべ"],["、"],["あなた"],["みずから"],["、"],["わたし"],["を"],["祝福","しゅくふく"],["して"],["ください"],["」"],["。"]]},{"verse":32,"text":"父,ちちイサクは彼,かれに言,いった、「あなたは、だれか」。彼,かれは言,いった、「わたしはあなたの子,こ、長子,ちょうしエサウです」。","tok":[["父","ちち"],["イサク"],["は"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["は"],["、"],["だれ"],["か"],["」"],["。"],["彼","かれ"],["は"],["言った","いった"],["、"],["「"],["わたし"],["は"],["あなた"],["の"],["子","こ"],["、"],["長子","ちょうし"],["エサウ"],["です"],["」"],["。"]]},{"verse":33,"text":"イサクは激,はげしくふるえて言,いった、「それでは、あのしかの肉,にくを取,とって、わたしに持,もってきた者,ものはだれか。わたしはあなたが来,くる前,まえに、みんな食,たべて彼,かれを祝福,しゅくふくした。ゆえに彼,かれが祝福,しゅくふくを得,えるであろう」。","tok":[["イサク"],["は"],["激しく","はげしく"],["ふるえて"],["言った","いった"],["、"],["「"],["それ"],["で"],["は"],["、"],["あの"],["しか"],["の"],["肉","にく"],["を"],["取って","とって"],["、"],["わたし"],["に"],["持って","もって"],["きた"],["者","もの"],["は"],["だれ"],["か"],["。"],["わたし"],["は"],["あなた"],["が"],["来る","くる"],["前","まえ"],["に"],["、"],["みんな"],["食べて","たべて"],["彼","かれ"],["を"],["祝福","しゅくふく"],["した"],["。"],["ゆえ"],["に"],["彼","かれ"],["が"],["祝福","しゅくふく"],["を"],["得るで","えるで"],["あろう"],["」"],["。"]]},{"verse":34,"text":"エサウは父,ちちの言葉,ことばを聞,きいた時,とき、大声,おおごえをあげ、激,はげしく叫,さけんで、父,ちちに言,いった、「父,ちちよ、わたしを、わたしをも祝福,しゅくふくしてください」。","tok":[["エサウ"],["は"],["父","ちち"],["の"],["言葉","ことば"],["を"],["聞いた","きいた"],["時","とき"],["、"],["大声","おおごえ"],["を"],["あげ"],["、"],["激しく","はげしく"],["叫けんで","さけんで"],["、"],["父","ちち"],["に"],["言った","いった"],["、"],["「"],["父","ちち"],["よ"],["、"],["わたし"],["を"],["、"],["わたし"],["を"],["も"],["祝福","しゅくふく"],["して"],["ください"],["」"],["。"]]},{"verse":35,"text":"イサクは言,いった、「あなたの弟,おとうとが偽,いつわってやってきて、あなたの祝福,しゅくふくを奪,うばってしまった」。","tok":[["イサク"],["は"],["言った","いった"],["、"],["「"],["あなた"],["の"],["弟","おとうと"],["が"],["偽わって","いつわって"],["やって"],["きて"],["、"],["あなた"],["の"],["祝福","しゅくふく"],["を"],["奪って","うばって"],["しまった"],["」"],["。"]]},{"verse":36,"text":"エサウは言,いった、「よくもヤコブと名,なづけたものだ。彼,かれは二度,どまでもわたしをおしのけた。さきには、わたしの長子,ちょうしの特権,とっけんを奪,うばい、こんどはわたしの祝福,しゅくふくを奪,うばった」。また言,いった、「あなたはわたしのために祝福,しゅくふくを残,のこしておかれませんでしたか」。","tok":[["エサウ"],["は"],["言った","いった"],["、"],["「"],["よく"],["も"],["ヤコブ"],["と"],["名づけた","なづけた"],["もの"],["だ"],["。"],["彼","かれ"],["は"],["二","に"],["度","ど"],["で"],["も"],["わたし"],["を"],["おしのけた"],["。"],["さき"],["に"],["は"],["、"],["わたし"],["の"],["長子","ちょうし"],["の"],["特権","とっけん"],["を"],["奪い","うばい"],["、"],["こんど"],["は"],["わたし"],["の"],["祝福","しゅくふく"],["を"],["奪った","うばった"],["」"],["。"],["また"],["言った","いった"],["、"],["「"],["あなた"],["は"],["わたし"],["の"],["ため"],["に"],["祝福","しゅくふく"],["を"],["残して","のこして"],["おかれませんでした"],["か"],["」"],["。"]]},{"verse":37,"text":"イサクは答,こたえてエサウに言,いった、「わたしは彼,かれをあなたの主人,しゅじんとし、兄弟,きょうだいたちを皆,みなしもべとして彼,かれに与,あたえ、また穀物,こくもつとぶどう酒,しゅを彼,かれに授,さづけた。わが子,こよ、今,いまとなっては、あなたのために何,なにができようか」。","tok":[["イサク"],["は"],["答","こたえ"],["て"],["エサウ"],["に"],["言った","いった"],["、"],["「"],["わたし"],["は"],["彼","かれ"],["を"],["あなた"],["の"],["主人","しゅじん"],["と"],["し"],["、"],["兄弟","きょうだい"],["たち"],["を"],["皆","みな"],["しもべ"],["として"],["彼","かれ"],["に"],["与","あたえ"],["、"],["また"],["穀物","こくもつ"],["と"],["ぶどう酒","ぶどうしゅ"],["を"],["彼","かれ"],["に"],["授","さ"],["づけた"],["。"],["わが"],["子","こ"],["よ"],["、"],["今","いま"],["と"],["なって"],["は"],["、"],["あなた"],["の"],["ため"],["に"],["何に","なに"],["が"],["できよう"],["か"],["」"],["。"]]},{"verse":38,"text":"エサウは父,ちちに言,いった、「父,ちちよ、あなたの祝福,しゅくふくはただ一つだけですか。父,ちちよ、わたしを、わたしをも祝福,しゅくふくしてください」。エサウは声,こえをあげて泣,ないた。","tok":[["エサウ"],["は"],["父","ちち"],["に"],["言った","いった"],["、"],["「"],["父","ちち"],["よ"],["、"],["あなた"],["の"],["祝福","しゅくふく"],["は"],["ただ"],["一","ひと"],["つ"],["だけ"],["です"],["か"],["。"],["父","ちち"],["よ"],["、"],["わたし"],["を"],["、"],["わたし"],["を"],["も"],["祝福","しゅくふく"],["して"],["ください"],["」"],["。"],["エサウ"],["は"],["声","こえ"],["を"],["あげて"],["泣いた","ないた"],["。"]]},{"verse":39,"text":"父,ちちイサクは答,こたえて彼,かれに言,いった、「あなたのすみかは地,ちの肥,こえた所,ところから離,はなれ、また上,うえなる天,てんの露,つゆから離,はなれるであろう。","tok":[["父","ちち"],["イサク"],["は"],["答","こたえ"],["て"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["の"],["すみか"],["は"],["地","ち"],["の"],["肥","こえ"],["た"],["所","ところ"],["から"],["離れ","はなれ"],["、"],["また上","またうえ"],["なる"],["天","てん"],["の"],["露","つゆか"],["ら"],["離れるで","はなれるで"],["あろう"],["。"]]},{"verse":40,"text":"あなたはつるぎをもって世,よを渡,わたり、あなたの弟,おとうとに仕,つかえるであろう。しかし、あなたが勇,いさみ立,たつ時,とき、首,くびから、そのくびきを振,ふり落,おとすであろう」。","tok":[["あなた"],["は"],["つるぎ"],["を"],["もって"],["世","よ"],["を"],["渡り","わたり"],["、"],["あなた"],["の"],["弟","おとうと"],["に"],["仕えるで","つかえるで"],["あろう"],["。"],["しかし"],["、"],["あなた"],["が"],["勇み立つ","いさみたつ"],["時","とき"],["、"],["首","くび"],["から"],["、"],["その"],["くびき"],["を"],["振り落とすで","ふりおとすで"],["あろう"],["」"],["。"]]},{"verse":41,"text":"こうしてエサウは父,ちちがヤコブに与,あたえた祝福,しゅくふくのゆえにヤコブを憎,にくんだ。エサウは心,こころの内,うちで言,いった、「父,ちちの喪,もの日,ひも遠,とおくはないであろう。その時,とき、弟,おとうとヤコブを殺,ころそう」。","tok":[["こう"],["して"],["エサウ"],["は"],["父","ちち"],["が"],["ヤコブ"],["に"],["与","あたえ"],["た"],["祝福","しゅくふく"],["の"],["ゆえ"],["に"],["ヤコブ"],["を"],["憎んだ","にくんだ"],["。"],["エサウ"],["は"],["心","こころ"],["の"],["内","うち"],["で"],["言った","いった"],["、"],["「"],["父","ちち"],["の"],["喪","も"],["の"],["日","ひ"],["も"],["遠く","とおく"],["は"],["ないで"],["あろう"],["。"],["その"],["時","とき"],["、"],["弟","おとうと"],["ヤコブ"],["を"],["殺そう","ころそう"],["」"],["。"]]},{"verse":42,"text":"しかしリベカは長子,ちょうしエサウのこの言葉,ことばを人,ひとづてに聞,きいたので、人,ひとをやり、弟,おとうとヤコブを呼,よんで言,いった、「兄,あにエサウはあなたを殺,ころそうと考,かんがえて、みずから慰,なぐさめています。","tok":[["しかし"],["リベカ"],["は"],["長子","ちょうし"],["エサウ"],["の"],["この"],["言葉","ことば"],["を"],["人づて","ひとづて"],["に"],["聞いた","きいた"],["ので"],["、"],["人","ひと"],["を"],["やり"],["、"],["弟","おとうと"],["ヤコブ"],["を"],["呼んで","よんで"],["言った","いった"],["、"],["「"],["兄","あに"],["エサウ"],["は"],["あなた"],["を"],["殺そう","ころそう"],["と"],["考","かんがえ"],["て"],["、"],["みずから"],["慰さめて","なぐさめて"],["います"],["。"]]},{"verse":43,"text":"子,こよ、今,いまわたしの言葉,ことばに従,したがって、すぐハランにいるわたしの兄,あにラバンのもとにのがれ、","tok":[["子","こ"],["よ"],["、"],["今","いま"],["わたし"],["の"],["言葉","ことば"],["に"],["従って","したがって"],["、"],["すぐ"],["ハラン"],["に"],["いる"],["わたし"],["の"],["兄","あに"],["ラバン"],["の"],["もと"],["に"],["のがれ"],["、"]]},{"verse":44,"text":"あなたの兄,あにの怒,いかりが解,とけるまで、しばらく彼,かれの所,ところにいなさい。","tok":[["あなた"],["の"],["兄","あに"],["の"],["怒り","いかり"],["が"],["解ける","とける"],["まで"],["、"],["しばらく"],["彼","かれ"],["の"],["所","ところ"],["に"],["い"],["なさい"],["。"]]},{"verse":45,"text":"兄,あにの憤,いきどおりが解,とけて、あなたのした事,ことを兄,あにが忘,わすれるようになったならば、わたしは人,ひとをやって、あなたをそこから迎,むかえましょう。どうして、わたしは一日,にちのうちにあなたがたふたりを失,うしなってよいでしょうか」。","tok":[["兄","あに"],["の"],["憤り","いきどおり"],["が"],["解けて","とけて"],["、"],["あなた"],["の"],["した"],["事","こと"],["を"],["兄","あに"],["が"],["忘る","わすれる"],["よう"],["に"],["なったならば"],["、"],["わたし"],["は"],["人","ひと"],["を"],["やって"],["、"],["あなた"],["を"],["そこ"],["から"],["迎","むかえ"],["ましょう"],["。"],["どう"],["して"],["、"],["わたし"],["は"],["一","いち"],["日","にち"],["の"],["うち"],["に"],["あなた"],["がた"],["ふたり"],["を"],["失なって","うしなって"],["よいでしょう"],["か"],["」"],["。"]]},{"verse":46,"text":"リベカはイサクに言,いった、「わたしはヘテびとの娘,むすめどものことで、生,いきているのがいやになりました。もしヤコブがこの地,ちの、あの娘,むすめどものようなヘテびとの娘,むすめを妻,つまにめとるなら、わたしは生,いきていて、何,なにになりましょう」。","tok":[["リベカ"],["は"],["イサク"],["に"],["言った","いった"],["、"],["「"],["わたし"],["は"],["ヘテ"],["びと"],["の"],["娘","むすめ"],["ども"],["の"],["こと"],["で"],["、"],["生きて","いきて"],["いる"],["の"],["が"],["いや"],["に"],["なりました"],["。"],["もし"],["ヤコブ"],["が"],["この"],["地","ち"],["の"],["、"],["あの"],["娘","むすめ"],["ども"],["の"],["よう"],["な"],["ヘテ"],["びと"],["の"],["娘","むすめ"],["を"],["妻","つま"],["に"],["めとるなら"],["、"],["わたし"],["は"],["生きて","いきて"],["いて"],["、"],["何に","なに"],["に"],["なりましょう"],["」"],["。"]]}]
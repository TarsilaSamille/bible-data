[{"verse":1,"text":"さてヤコブは目,めをあげ、エサウが四百人,にんを率,ひきいて来,くるのを見,みた。そこで彼,かれは子供,こどもたちを分,わけてレアとラケルとふたりのつかえめとにわたし、","tok":[["さて"],["ヤコブ"],["は"],["目","め"],["を"],["あげ"],["、"],["エサウ"],["が"],["四百人","にん"],["を"],["率いて","ひきいて"],["来る","くる"],["の"],["を"],["見た","みた"],["。"],["そこ"],["で"],["彼","かれ"],["は"],["子供","こども"],["たち"],["を"],["分けて","わけて"],["レア"],["と"],["ラケル"],["と"],["ふたり"],["の"],["つかえ"],["め"],["と"],["に"],["わたし"],["、"]]},{"verse":2,"text":"つかえめとその子,こ供,ともたちをまっ先,さきに置,おき、レアとその子,こ供,ともたちを次,つぎに置,おき、ラケルとヨセフを最後,さいごに置,おいて、","tok":[["つかえ"],["め"],["と"],["その"],["子供","ことも"],["たち"],["を"],["まっ先","まっさき"],["に"],["置き","おき"],["、"],["レア"],["と"],["その"],["子供","ことも"],["たち"],["を"],["次","つぎ"],["に"],["置き","おき"],["、"],["ラケル"],["と"],["ヨセフ"],["を"],["最後","さいご"],["に"],["置いて","おいて"],["、"]]},{"verse":3,"text":"みずから彼,かれらの前,まえに進,すすみ、七たび身,みを地,ちにかがめて、兄,あにに近,ちかづいた。","tok":[["みずから"],["彼","かれ"],["ら"],["の"],["前","まえ"],["に"],["進み","すすみ"],["、"],["七","なな"],["たび"],["身","み"],["を"],["地","ち"],["に"],["かがめて"],["、"],["兄","あに"],["に"],["近づいた","ちかづいた"],["。"]]},{"verse":4,"text":"するとエサウは走,はしってきて迎,むかえ、彼,かれを抱,だき、そのくびをかかえて口,くちづけし、共,ともに泣,ないた。","tok":[["する"],["と"],["エサウ"],["は"],["走って","はしって"],["きて"],["迎","むかえ"],["、"],["彼","かれ"],["を"],["抱き","だき"],["、"],["その"],["くび"],["を"],["かかえて"],["口づけ","くちづけ"],["し"],["、"],["共","とも"],["に"],["泣いた","ないた"],["。"]]},{"verse":5,"text":"エサウは目,めをあげて女,おんなと子供,こどもたちを見,みて言,いった、「あなたと一緒,いっしょにいるこれらの者,ものはだれですか」。ヤコブは言,いった、「神,かみがしもべに授,さづけられた子供,こどもたちです」。","tok":[["エサウ"],["は"],["目","め"],["を"],["あげて"],["女","おんな"],["と"],["子供","こども"],["たち"],["を"],["見て","みて"],["言った","いった"],["、"],["「"],["あなた"],["と"],["一緒","いっしょ"],["に"],["いる"],["これ"],["ら"],["の"],["者","もの"],["は"],["だれ"],["です"],["か"],["」"],["。"],["ヤコブ"],["は"],["言った","いった"],["、"],["「"],["神","かみ"],["が"],["しもべ"],["に"],["授","さ"],["づけられた"],["子供","こども"],["たち"],["です"],["」"],["。"]]},{"verse":6,"text":"そこでつかえめたちはその子,こ供,ともたちと共,ともに近寄,ちかよってお辞儀,じぎした。","tok":[["そこ"],["で"],["つかえ"],["め"],["たち"],["は"],["その"],["子供","ことも"],["たち"],["と"],["共","とも"],["に"],["近寄って","ちかよって"],["お辞儀","おじぎ"],["した"],["。"]]},{"verse":7,"text":"レアもまたその子,こ供,ともたちと共,ともに近寄,ちかよってお辞儀,じぎし、それからヨセフとラケルが近寄,ちかよってお辞儀,じぎした。","tok":[["レア"],["も"],["また"],["その"],["子供","ことも"],["たち"],["と"],["共","とも"],["に"],["近寄って","ちかよって"],["お辞儀","おじぎ"],["し"],["、"],["それ"],["から"],["ヨセフ"],["と"],["ラケル"],["が"],["近寄って","ちかよって"],["お辞儀","おじぎ"],["した"],["。"]]},{"verse":8,"text":"するとエサウは言,いった、「わたしが出会,であったあのすべての群,むれはどうしたのですか」。ヤコブは言,いった、「わが主,しゅの前,まえに恵,めぐみを得,えるためです」。","tok":[["する"],["と"],["エサウ"],["は"],["言った","いった"],["、"],["「"],["わたし"],["が"],["出会った","であった"],["あの"],["すべて"],["の"],["群れ","むれ"],["は"],["どう"],["した"],["の"],["です"],["か"],["」"],["。"],["ヤコブ"],["は"],["言った","いった"],["、"],["「"],["わが"],["主","しゅ"],["の"],["前","まえ"],["に"],["恵","めぐみ"],["を"],["得る","える"],["ため"],["です"],["」"],["。"]]},{"verse":9,"text":"エサウは言,いった、「弟,おとうとよ、わたしはじゅうぶんもっている。あなたの物,ものはあなたのものにしなさい」。","tok":[["エサウ"],["は"],["言った","いった"],["、"],["「"],["弟","おとうと"],["よ"],["、"],["わたし"],["は"],["じゅうぶん"],["もって"],["いる"],["。"],["あなた"],["の"],["物","もの"],["は"],["あなた"],["の"],["もの"],["に"],["し"],["なさい"],["」"],["。"]]},{"verse":10,"text":"ヤコブは言,いった、「いいえ、もしわたしがあなたの前,まえに恵,めぐみを得,えるなら、どうか、わたしの手,てから贈,おくり物,ものを受,うけてください。あなたが喜,よろこんでわたしを迎,むかえてくださるので、あなたの顔,かおを見,みて、神,かみの顔,かおを見,みるように思,おもいます。","tok":[["ヤコブ"],["は"],["言った","いった"],["、"],["「"],["いいえ"],["、"],["もし"],["わたし"],["が"],["あなた"],["の"],["前","まえ"],["に"],["恵","めぐみ"],["を"],["得るなら","えるなら"],["、"],["どう"],["か"],["、"],["わたし"],["の"],["手","て"],["から"],["贈り物","おくりもの"],["を"],["受て","うけて"],["ください"],["。"],["あなた"],["が"],["喜こんで","よろこんで"],["わたし"],["を"],["迎","むかえ"],["て"],["くださる"],["ので"],["、"],["あなた"],["の"],["顔","かお"],["を"],["見て","みて"],["、"],["神","かみ"],["の"],["顔","かお"],["を"],["見る","みる"],["よう"],["に"],["思います","おもいます"],["。"]]},{"verse":11,"text":"どうかわたしが持,もってきた贈,おくり物,ものを受,うけてください。神,かみがわたしを恵,めぐまれたので、わたしはじゅうぶんもっていますから」。こうして彼,かれがしいたので、彼,かれは受,うけ取,とった。","tok":[["どう"],["か"],["わたし"],["が"],["持って","もって"],["きた"],["贈り物","おくりもの"],["を"],["受て","うけて"],["ください"],["。"],["神","かみ"],["が"],["わたし"],["を"],["恵れた","めぐまれた"],["ので"],["、"],["わたし"],["は"],["じゅうぶん"],["もって"],["います"],["から"],["」"],["。"],["こう"],["して"],["彼","かれ"],["が"],["し"],["いた"],["ので"],["、"],["彼","かれ"],["は"],["受け取った","うけとった"],["。"]]},{"verse":12,"text":"そしてエサウは言,いった、「さあ、立,たって行,いこう。わたしが先,さきに行,いく」。","tok":[["そして"],["エサウ"],["は"],["言った","いった"],["、"],["「"],["さあ"],["、"],["立って","たって"],["行こう","いこう"],["。"],["わたし"],["が"],["先","さき"],["に"],["行く","いく"],["」"],["。"]]},{"verse":13,"text":"ヤコブは彼,かれに言,いった、「ごぞんじのように、子供,こどもたちは、かよわく、また乳,ちちを飲,のませている羊,ひつじや牛,うしをわたしが世話,せわをしています。もし一日,にちでも歩,あるかせ過,すぎたら群,むれはみな死,しんでしまいます。","tok":[["ヤコブ"],["は"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["ごぞんじ"],["の"],["よう"],["に"],["、"],["子供","こども"],["たち"],["は"],["、"],["かよわく"],["、"],["また"],["乳","ちち"],["を"],["飲ませて","のませて"],["いる"],["羊","ひつじ"],["や"],["牛","うし"],["を"],["わたし"],["が"],["世話","せわ"],["を"],["して"],["います"],["。"],["もし"],["一","いち"],["日","にち"],["で"],["も"],["歩かせ","あるかせ"],["過たら","すぎたら"],["群れ","むれ"],["は"],["みな"],["死んで","しんで"],["しまいます"],["。"]]},{"verse":14,"text":"わが主,しゅよ、どうか、しもべの先,さきにおいでください。わたしはわたしの前,まえにいる家畜,かちくと子供,こどもたちの歩,あゆみに合,あわせて、ゆっくり歩,あるいて行,いき、セイルでわが主,しゅと一緒,いっしょになりましょう」。","tok":[["わが"],["主","しゅ"],["よ"],["、"],["どう"],["か"],["、"],["しもべ"],["の"],["先","さき"],["に"],["おいで"],["ください"],["。"],["わたし"],["は"],["わたし"],["の"],["前","まえ"],["に"],["いる"],["家畜","かちく"],["と"],["子供","こども"],["たち"],["の"],["歩み","あゆみ"],["に"],["合","あわせ"],["て"],["、"],["ゆっくり"],["歩いて","あるいて"],["行き","いき"],["、"],["セイル"],["で"],["わが"],["主","しゅ"],["と"],["一緒","いっしょ"],["に"],["なりましょう"],["」"],["。"]]},{"verse":15,"text":"エサウは言,いった、「それならわたしが連,つれている者,ものどものうち幾,いく人,ひとかをあなたのもとに残,のこしましょう」。ヤコブは言,いった、「いいえ、それには及,およびません。わが主,しゅの前,まえに恵,めぐみを得,えさせてください」。","tok":[["エサウ"],["は"],["言った","いった"],["、"],["「"],["それ"],["なら"],["わたし"],["が"],["連れて","つれて"],["いる"],["者","もの"],["ども"],["の"],["うち"],["幾人","いくひと"],["か"],["を"],["あなた"],["の"],["もと"],["に"],["残しましょう","のこしましょう"],["」"],["。"],["ヤコブ"],["は"],["言った","いった"],["、"],["「"],["いいえ"],["、"],["それ"],["に"],["は"],["及","および"],["ません"],["。"],["わが"],["主","しゅ"],["の"],["前","まえ"],["に"],["恵","めぐみ"],["を"],["得させて","えさせて"],["ください"],["」"],["。"]]},{"verse":16,"text":"その日,ひエサウはセイルへの帰途,きとについた。","tok":[["その"],["日","ひ"],["エサウ"],["は"],["セイル"],["へ"],["の"],["帰途","きと"],["に"],["ついた"],["。"]]},{"verse":17,"text":"ヤコブは立,たってスコテに行,いき、自分,じぶんのために家,いえを建,たて、また家畜,かちくのために小屋,こやを造,つくった。これによってその所,ところの名,なはスコテと呼,よばれている。","tok":[["ヤコブ"],["は"],["立って","たって"],["スコテ"],["に"],["行き","いき"],["、"],["自分","じぶん"],["の"],["ため"],["に"],["家","いえ"],["を"],["建て","たて"],["、"],["また"],["家畜","かちく"],["の"],["ため"],["に"],["小屋","こや"],["を"],["造った","つくった"],["。"],["これ"],["によって"],["その"],["所","ところ"],["の"],["名","な"],["は"],["スコテ"],["と"],["呼ばれて","よばれて"],["いる"],["。"]]},{"verse":18,"text":"こうしてヤコブはパダンアラムからきて、無事,ぶじカナンの地,ちのシケムの町,まちに着,つき、町,まちの前,まえに宿営,しゅくえいした。","tok":[["こう"],["して"],["ヤコブ"],["は"],["パダン"],["アラム"],["から"],["きて"],["、"],["無事","ぶじ"],["カナン"],["の"],["地","ち"],["の"],["シケム"],["の"],["町","まち"],["に"],["着き","つき"],["、"],["町","まち"],["の"],["前","まえ"],["に"],["宿営","しゅくえい"],["した"],["。"]]},{"verse":19,"text":"彼,かれは天幕,てんまくを張,はった野,のの一部,いちぶをシケムの父,ちちハモルの子,こらの手,てから百ケシタで買,かい取,とり、","tok":[["彼","かれ"],["は"],["天幕","てんまく"],["を"],["張った","はった"],["野","の"],["の"],["一部","いちぶ"],["を"],["シケム"],["の"],["父","ちち"],["ハモル"],["の"],["子","こ"],["ら"],["の"],["手","て"],["から"],["百","ひゃく"],["ケシタ"],["で"],["買取","かいとり"],["、"]]},{"verse":20,"text":"そこに祭壇,さいだんを建,たてて、これをエル・エロヘ・イスラエルと名,なづけた。","tok":[["そこ"],["に"],["祭壇","さいだん"],["を"],["建てて","たてて"],["、"],["これ"],["を"],["エル"],["・"],["エロヘ"],["・"],["イスラエル"],["と"],["名づけた","なづけた"],["。"]]}]
[{"verse":1,"text":"ヨセフは行,いって、パロに言,いった、「わたしの父,ちちと兄弟,きょうだいたち、その羊,ひつじ、牛,うしおよびすべての持,もち物,ものがカナンの地,ちからきて、今,いまゴセンの地,ちにおります」。","tok":[["ヨセフ"],["は"],["行って","いって"],["、"],["パロ"],["に"],["言った","いった"],["、"],["「"],["わたし"],["の"],["父","ちち"],["と"],["兄弟","きょうだい"],["たち"],["、"],["その"],["羊","ひつじ"],["、"],["牛","うし"],["および"],["すべて"],["の"],["持物","もちもの"],["が"],["カナン"],["の"],["地","ち"],["から"],["きて"],["、"],["今","いま"],["ゴセン"],["の"],["地","ち"],["に"],["おります"],["」"],["。"]]},{"verse":2,"text":"そしてその兄弟,きょうだいのうちの五人,にんを連,つれて行,いって、パロに会,あわせた。","tok":[["そして"],["その"],["兄弟","きょうだい"],["の"],["うち"],["の"],["五人","にん"],["を"],["連れて","つれて"],["行って","いって"],["、"],["パロ"],["に"],["会わせた","あわせた"],["。"]]},{"verse":3,"text":"パロはヨセフの兄弟,きょうだいたちに言,いった、「あなたがたの職業,しょくぎょうは何,なにか」。彼,かれらはパロに言,いった、「しもべらは羊,ひつじを飼,かう者,ものです。われわれも、われわれの先祖,せんぞもそうです」。","tok":[["パロ"],["は"],["ヨセフ"],["の"],["兄弟","きょうだい"],["たち"],["に"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["の"],["職業","しょくぎょう"],["は"],["何に","なに"],["か"],["」"],["。"],["彼","かれ"],["ら"],["は"],["パロ"],["に"],["言った","いった"],["、"],["「"],["しもべ"],["ら"],["は"],["羊","ひつじ"],["を"],["飼う","かう"],["者","もの"],["です"],["。"],["われわれ"],["も"],["、"],["われわれ"],["の"],["先祖","せんぞ"],["も"],["そう"],["です"],["」"],["。"]]},{"verse":4,"text":"彼,かれらはまたパロに言,いった、「この国,くにに寄留,きりゅうしようとしてきました。カナンの地,ちはききんが激,はげしく、しもべらの群,むれのための牧草,ぼくそうがないのです。どうかしもべらをゴセンの地,ちに住,すませてください」。","tok":[["彼","かれ"],["ら"],["は"],["また"],["パロ"],["に"],["言った","いった"],["、"],["「"],["この"],["国","くに"],["に"],["寄留","きりゅう"],["しよう"],["として"],["きました"],["。"],["カナン"],["の"],["地","ち"],["は"],["ききん"],["が"],["激しく","はげしく"],["、"],["しもべ"],["ら"],["の"],["群れ","むれ"],["の"],["ため"],["の"],["牧草","ぼくそう"],["が"],["ない"],["の"],["です"],["。"],["どう"],["か"],["しもべ"],["ら"],["を"],["ゴセン"],["の"],["地","ち"],["に"],["住ませて","すませて"],["ください"],["」"],["。"]]},{"verse":5,"text":"パロはヨセフに言,いった、「あなたの父,ちちと兄弟,きょうだいたちとがあなたのところにきた。","tok":[["パロ"],["は"],["ヨセフ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["の"],["父","ちち"],["と"],["兄弟","きょうだい"],["たち"],["と"],["が"],["あなた"],["の"],["ところ"],["に"],["きた"],["。"]]},{"verse":6,"text":"エジプトの地,ちはあなたの前,まえにある。地,ちの最,もっとも良,よい所,ところにあなたの父,ちちと兄弟,きょうだいたちとを住,すませなさい。ゴセンの地,ちに彼,かれらを住,すませなさい。もしあなたが彼,かれらのうちに有能,ゆうのうな者,ものがあるのを知,しっているなら、その者,ものにわたしの家畜,かちくをつかさどらせなさい」。","tok":[["エジプト"],["の"],["地","ち"],["は"],["あなた"],["の"],["前","まえ"],["に"],["ある"],["。"],["地","ち"],["の"],["最も","もっとも"],["良い","よい"],["所","ところ"],["に"],["あなた"],["の"],["父","ちち"],["と"],["兄弟","きょうだい"],["たち"],["と"],["を"],["住ませ","すませ"],["なさい"],["。"],["ゴセン"],["の"],["地","ち"],["に"],["彼","かれ"],["ら"],["を"],["住ませ","すませ"],["なさい"],["。"],["もし"],["あなた"],["が"],["彼","かれ"],["ら"],["の"],["うち"],["に"],["有能","ゆうのう"],["な"],["者","もの"],["が"],["ある"],["の"],["を"],["知って","しって"],["いるなら"],["、"],["その"],["者","もの"],["に"],["わたし"],["の"],["家畜","かちく"],["を"],["つかさどらせ"],["なさい"],["」"],["。"]]},{"verse":7,"text":"そこでヨセフは父,ちちヤコブを導,みちびいてパロの前,まえに立,たたせた。ヤコブはパロを祝福,しゅくふくした。","tok":[["そこ"],["で"],["ヨセフ"],["は"],["父","ちち"],["ヤコブ"],["を"],["導いて","みちびいて"],["パロ"],["の"],["前","まえ"],["に"],["立たせた","たたせた"],["。"],["ヤコブ"],["は"],["パロ"],["を"],["祝福","しゅくふく"],["した"],["。"]]},{"verse":8,"text":"パロはヤコブに言,いった、「あなたの年,としはいくつか」。","tok":[["パロ"],["は"],["ヤコブ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["の"],["年","とし"],["は"],["いくつ"],["か"],["」"],["。"]]},{"verse":9,"text":"ヤコブはパロに言,いった、「わたしの旅路,たびじのとしつきは、百三十年,ねんです。わたしのよわいの日,ひはわずかで、ふしあわせで、わたしの先祖,せんぞたちのよわいの日,ひと旅路,たびじの日,ひには及,およびません」。","tok":[["ヤコブ"],["は"],["パロ"],["に"],["言った","いった"],["、"],["「"],["わたし"],["の"],["旅路","たびじ"],["の"],["としつき"],["は"],["、"],["百三十","ひゃくさんじゅう"],["年","ねん"],["です"],["。"],["わたし"],["の"],["よわい"],["の"],["日","ひ"],["は"],["わずか"],["で"],["、"],["ふしあわせ"],["で"],["、"],["わたし"],["の"],["先祖","せんぞ"],["たち"],["の"],["よわい"],["の"],["日","ひ"],["と"],["旅路","たびじ"],["の"],["日","ひ"],["に"],["は"],["及","および"],["ません"],["」"],["。"]]},{"verse":10,"text":"ヤコブはパロを祝福,しゅくふくし、パロの前,まえを去,さった。","tok":[["ヤコブ"],["は"],["パロ"],["を"],["祝福","しゅくふく"],["し"],["、"],["パロ"],["の"],["前","まえ"],["を"],["去た","さった"],["。"]]},{"verse":11,"text":"ヨセフはパロの命,めいじたように、父,ちちと兄弟,きょうだいたちとのすまいを定,さだめ、彼,かれらにエジプトの国,くにで最,もっとも良,よい地,ち、ラメセスの地,ちを所有,しょゆうとして与,あたえた。","tok":[["ヨセフ"],["は"],["パロ"],["の"],["命じた","めいじた"],["よう"],["に"],["、"],["父","ちち"],["と"],["兄弟","きょうだい"],["たち"],["と"],["の"],["すまい"],["を"],["定め","さだめ"],["、"],["彼","かれ"],["ら"],["に"],["エジプト"],["の"],["国","くに"],["で"],["最も","もっとも"],["良い","よい"],["地","ち"],["、"],["ラメセス"],["の"],["地","ち"],["を"],["所有","しょゆう"],["として"],["与","あたえ"],["た"],["。"]]},{"verse":12,"text":"またヨセフは父,ちちと兄弟,きょうだいたちと父,ちちの全家,ぜんかとに、家族,かぞくの数,かずにしたがい、食物,しょくもつを与,あたえて養,やしなった。","tok":[["また"],["ヨセフ"],["は"],["父","ちち"],["と"],["兄弟","きょうだい"],["たち"],["と"],["父","ちち"],["の"],["全家","ぜんか"],["と"],["に"],["、"],["家族","かぞく"],["の"],["数","かず"],["に"],["したがい"],["、"],["食物","しょくもつ"],["を"],["与","あたえ"],["て"],["養った","やしなった"],["。"]]},{"verse":13,"text":"さて、ききんが非常,ひじょうに激,はげしかったので、全,ぜん地,ちに食物,しょくもつがなく、エジプトの国,くにもカナンの国,くにも、ききんのために衰,おとろえた。","tok":[["さて"],["、"],["ききん"],["が"],["非常","ひじょう"],["に"],["激しかった","はげしかった"],["ので"],["、"],["全地","ぜんち"],["に"],["食物","しょくもつ"],["が"],["なく"],["、"],["エジプト"],["の"],["国","くに"],["も"],["カナン"],["の"],["国","くに"],["も"],["、"],["ききん"],["の"],["ため"],["に"],["衰えた","おとろえた"],["。"]]},{"verse":14,"text":"それでヨセフは人々,ひとびとが買,かった穀物,こくもつの代金,だいきんとしてエジプトの国,くにとカナンの国,くににあった銀,ぎんをみな集,あつめ、その銀,ぎんをパロの家,いえに納,おさめた。","tok":[["それ"],["で"],["ヨセフ"],["は"],["人々","ひとびと"],["が"],["買った","かった"],["穀物","こくもつ"],["の"],["代金","だいきん"],["として"],["エジプト"],["の"],["国","くに"],["と"],["カナン"],["の"],["国","くに"],["に"],["あった"],["銀","ぎん"],["を"],["みな"],["集め","あつめ"],["、"],["その"],["銀","ぎん"],["を"],["パロ"],["の"],["家","いえ"],["に"],["納","おさめ"],["た"],["。"]]},{"verse":15,"text":"こうしてエジプトの国,くにとカナンの国,くにに銀,ぎんが尽,つきたとき、エジプトびとはみなヨセフのもとにきて言,いった、「食物,しょくもつをください。銀,ぎんが尽,つきたからとて、どうしてあなたの前,まえで死,しんでよいでしょう」。","tok":[["こう"],["して"],["エジプト"],["の"],["国","くに"],["と"],["カナン"],["の"],["国","くに"],["に"],["銀","ぎん"],["が"],["尽た","つきた"],["とき"],["、"],["エジプト"],["び"],["と"],["は"],["みな"],["ヨセフ"],["の"],["もと"],["に"],["きて"],["言った","いった"],["、"],["「"],["食物","しょくもつ"],["を"],["ください"],["。"],["銀","ぎん"],["が"],["尽た","つきた"],["から"],["とて"],["、"],["どう"],["して"],["あなた"],["の"],["前","まえ"],["で"],["死んで","しんで"],["よいでしょう"],["」"],["。"]]},{"verse":16,"text":"ヨセフは言,いった、「あなたがたの家畜,かちくを出,だしなさい。銀,ぎんが尽,つきたのなら、あなたがたの家畜,かちくと引,ひき替,かえで食物,しょくもつをわたそう」。","tok":[["ヨセフ"],["は"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["の"],["家畜","かちく"],["を"],["出し","だし"],["なさい"],["。"],["銀","ぎん"],["が"],["尽た","つきた"],["の"],["なら"],["、"],["あなた"],["がた"],["の"],["家畜","かちく"],["と"],["引替","ひきかえ"],["で"],["食物","しょくもつ"],["を"],["わたそう"],["」"],["。"]]},{"verse":17,"text":"彼,かれらはヨセフの所,ところへ家畜,かちくをひいてきたので、ヨセフは馬,うまと羊,ひつじの群,むれと牛,うしの群,むれ及,およびろばと引,ひき替,かえで、食物,しょくもつを彼,かれらにわたした。こうして彼,かれはその年,とし、すべての家畜,かちくと引,ひき替,かえた食物,しょくもつで彼,かれらを養,やしなった。","tok":[["彼","かれ"],["ら"],["は"],["ヨセフ"],["の"],["所","ところ"],["へ"],["家畜","かちく"],["を"],["ひいて"],["きた"],["ので"],["、"],["ヨセフ"],["は"],["馬","うま"],["と"],["羊","ひつじ"],["の"],["群れ","むれ"],["と"],["牛","うし"],["の"],["群れ","むれ"],["及","および"],["ろば"],["と"],["引替","ひきかえ"],["で"],["、"],["食物","しょくもつ"],["を"],["彼","かれ"],["ら"],["に"],["わたした"],["。"],["こう"],["して"],["彼","かれ"],["は"],["その"],["年","とし"],["、"],["すべて"],["の"],["家畜","かちく"],["と"],["引替","ひきかえ"],["た"],["食物","しょくもつ"],["で"],["彼","かれ"],["ら"],["を"],["養った","やしなった"],["。"]]},{"verse":18,"text":"やがてその年,としは暮,くれ、次,つぎの年,とし、人々,ひとびとはまたヨセフの所,ところへきて言,いった、「わが主,しゅには何事,なにごとも隠,かくしません。われわれの銀,ぎんは尽,つき、獣,けものの群,むれもわが主,しゅのものになって、われわれのからだと田地,でんちのほかはわが主,しゅの前,まえに何,なにも残,のこっていません。","tok":[["やがて"],["その"],["年","とし"],["は"],["暮","くれ"],["、"],["次","つぎ"],["の"],["年","とし"],["、"],["人々","ひとびと"],["は"],["また"],["ヨセフ"],["の"],["所","ところ"],["へ"],["きて"],["言った","いった"],["、"],["「"],["わが"],["主","しゅ"],["に"],["は"],["何事","なにごと"],["も"],["隠しません","かくしません"],["。"],["われわれ"],["の"],["銀","ぎん"],["は"],["尽き","つき"],["、"],["獣","けもの"],["の"],["群れ","むれ"],["も"],["わが"],["主","しゅ"],["の"],["もの"],["に"],["なって"],["、"],["われわれ"],["の"],["からだ"],["と"],["田地","でんち"],["の"],["ほか"],["は"],["わが"],["主","しゅ"],["の"],["前","まえ"],["に"],["何に","なに"],["も"],["残って","のこって"],["いません"],["。"]]},{"verse":19,"text":"われわれはどうして田地,でんちと一緒,いっしょに、あなたの目,めの前,まえで滅,ほろんでよいでしょう。われわれと田地,でんちとを食物,しょくもつと引,ひき替,かえで買,かってください。われわれは田地,でんちと一緒,いっしょにパロの奴隷,どれいとなりましょう。また種,たねをください。そうすればわれわれは生,いきながらえ、死,しを免,まぬかれて、田地,でんちも荒,あれないでしょう」。","tok":[["われわれ"],["は"],["どう"],["して"],["田地","でんち"],["と"],["一緒","いっしょ"],["に"],["、"],["あなた"],["の"],["目","め"],["の"],["前","まえ"],["で"],["滅","ほろん"],["で"],["よいでしょう"],["。"],["われわれ"],["と"],["田地","でんちと"],["を"],["食物","しょくもつ"],["と"],["引替","ひきかえ"],["で"],["買って","かって"],["ください"],["。"],["われわれ"],["は"],["田地","でんち"],["と"],["一緒","いっしょ"],["に"],["パロ"],["の"],["奴隷","どれい"],["と"],["なりましょう"],["。"],["また"],["種","たね"],["を"],["ください"],["。"],["そう"],["すれば"],["われわれ"],["は"],["生きながらえ","いきながらえ"],["、"],["死","し"],["を"],["免かれて","まぬかれて"],["、"],["田地","でんち"],["も"],["荒れないでしょう","あれないでしょう"],["」"],["。"]]},{"verse":20,"text":"そこでヨセフはエジプトの田地,でんちをみなパロのために買,かい取,とった。ききんがエジプトびとに、きびしかったので、めいめいその田畑,たはたを売,うったからである。こうして地,ちはパロのものとなった。","tok":[["そこ"],["で"],["ヨセフ"],["は"],["エジプト"],["の"],["田地","でんち"],["を"],["みな"],["パロ"],["の"],["ため"],["に"],["買取った","かいとった"],["。"],["ききん"],["が"],["エジプト"],["びと"],["に"],["、"],["きびしかった"],["ので"],["、"],["めいめい"],["その"],["田畑","たはた"],["を"],["売った","うった"],["から"],["で"],["ある"],["。"],["こう"],["して"],["地","ち"],["は"],["パロ"],["の"],["もの"],["と"],["なった"],["。"]]},{"verse":21,"text":"そしてヨセフはエジプトの国境,こっきょうのこの端,はしからかの端,はしまで民,たみを奴隷,どれいとした。","tok":[["そして"],["ヨセフ"],["は"],["エジプト"],["の"],["国境","こっきょう"],["の"],["この"],["端","はし"],["から"],["か"],["の"],["端","はし"],["まで"],["民","たみ"],["を"],["奴隷","どれい"],["と"],["した"],["。"]]},{"verse":22,"text":"ただ祭司,さいしの田地,でんちは買,かい取,とらなかった。祭司,さいしにはパロの給与,きゅうよがあって、パロが与,あたえる給与,きゅうよで生活,せいかつしていたので、その田地,でんちを売,うらなかったからである。","tok":[["ただ"],["祭司","さいし"],["の"],["田地","でんち"],["は"],["買取らなかった","かいとらなかった"],["。"],["祭司","さいし"],["に"],["は"],["パロ"],["の"],["給与","きゅうよ"],["が"],["あって"],["、"],["パロ"],["が"],["与える","あたえる"],["給与","きゅうよ"],["で"],["生活","せいかつ"],["して"],["いた"],["ので"],["、"],["その"],["田地","でんち"],["を"],["売らなかった","うらなかった"],["から"],["で"],["ある"],["。"]]},{"verse":23,"text":"ヨセフは民,たみに言,いった、「わたしはきょう、あなたがたとその田地,でんちとを買,かい取,とって、パロのものとした。あなたがたに種,たねをあげるから地,ちにまきなさい。","tok":[["ヨセフ"],["は"],["民","たみ"],["に"],["言った","いった"],["、"],["「"],["わたし"],["は"],["きょう"],["、"],["あなた"],["がた"],["と"],["その"],["田地","でんちと"],["を"],["買取って","かいとって"],["、"],["パロ"],["の"],["もの"],["と"],["した"],["。"],["あなた"],["がた"],["に"],["種","たね"],["を"],["あげる"],["から"],["地","ち"],["に"],["まき"],["なさい"],["。"]]},{"verse":24,"text":"収穫,しゅうかくの時,ときは、その五分,ぶんの一をパロに納,おさめ、五分,ぶんの四を自分,じぶんのものとして田畑,たはたの種,たねとし、自分,じぶんと家族,かぞくの食糧,しょくりょうとし、また子供,こどもの食糧,しょくりょうとしなさい」。","tok":[["収穫","しゅうかく"],["の"],["時","とき"],["は"],["、"],["その"],["五分","ぶん"],["の"],["一","いち"],["を"],["パロ"],["に"],["納","おさめ"],["、"],["五分","ぶん"],["の"],["四","よん"],["を"],["自分","じぶん"],["の"],["もの"],["として"],["田畑","たはた"],["の"],["種","たね"],["と"],["し"],["、"],["自分","じぶん"],["と"],["家族","かぞく"],["の"],["食糧","しょくりょう"],["と"],["し"],["、"],["また"],["子供","こども"],["の"],["食糧","しょくりょう"],["と"],["し"],["なさい"],["」"],["。"]]},{"verse":25,"text":"彼,かれらは言,いった、「あなたはわれわれの命,いのちをお救,すくいくださった。どうかわが主,しゅの前,まえに恵,めぐみを得,えさせてください。われわれはパロの奴隷,どれいになりましょう」。","tok":[["彼","かれ"],["ら"],["は"],["言った","いった"],["、"],["「"],["あなた"],["は"],["われわれ"],["の"],["命","いのち"],["を"],["お救い","おすくい"],["くださった"],["。"],["どう"],["か"],["わが"],["主","しゅ"],["の"],["前","まえ"],["に"],["恵","めぐみ"],["を"],["得させて","えさせて"],["ください"],["。"],["われわれ"],["は"],["パロ"],["の"],["奴隷","どれい"],["に"],["なりましょう"],["」"],["。"]]},{"verse":26,"text":"ヨセフはエジプトの田地,でんちについて、収穫,しゅうかくの五分,ぶんの一をパロに納,おさめることをおきてとしたが、それは今日,こんにちに及,およんでいる。ただし祭司,さいしの田地,でんちだけはパロのものとならなかった。","tok":[["ヨセフ"],["は"],["エジプト"],["の"],["田地","でんち"],["について"],["、"],["収穫","しゅうかく"],["の"],["五分","ぶん"],["の"],["一","いち"],["を"],["パロ"],["に"],["納める","おさめる"],["こと"],["を"],["おきて"],["と"],["した"],["が"],["、"],["それ"],["は"],["今日","こんにち"],["に"],["及んで","およんで"],["いる"],["。"],["ただし"],["祭司","さいし"],["の"],["田地","でんちだけ"],["は"],["パロ"],["の"],["もの"],["と"],["ならなかった"],["。"]]},{"verse":27,"text":"さてイスラエルはエジプトの国,くにでゴセンの地,ちに住,すみ、そこで財産,ざいさんを得,え、子,こを生,うみ、大,おおいにふえた。","tok":[["さて"],["イスラエル"],["は"],["エジプト"],["の"],["国","くに"],["で"],["ゴセン"],["の"],["地","ち"],["に"],["住み","すみ"],["、"],["そこ"],["で"],["財産","ざいさん"],["を"],["得","え"],["、"],["子","こ"],["を"],["生み","うみ"],["、"],["大いに","おおいに"],["ふえた"],["。"]]},{"verse":28,"text":"ヤコブはエジプトの国,くにで十七年,ねん生,いきながらえた。ヤコブのよわいの日,ひは百四十七年,ねんであった。","tok":[["ヤコブ"],["は"],["エジプト"],["の"],["国","くに"],["で"],["十七","じゅうなな"],["年","ねん"],["生きながらえた","いきながらえた"],["。"],["ヤコブ"],["の"],["よわい"],["の"],["日","ひ"],["は"],["百四十七","ひゃくよんじゅうなな"],["年","ねん"],["で"],["あった"],["。"]]},{"verse":29,"text":"イスラエルは死,しぬ時,ときが近,ちかづいたので、その子,こヨセフを呼,よんで言,いった、「もしわたしがあなたの前,まえに恵,めぐみを得,えるなら、どうか手,てをわたしのももの下,したに入,いれて誓,ちかい、親切,しんせつと誠実,せいじつとをもってわたしを取,とり扱,あつかってください。どうかわたしをエジプトには葬,ほうむらないでください。","tok":[["イスラエル"],["は"],["死ぬ","しぬ"],["時","とき"],["が"],["近づいた","ちかづいた"],["ので"],["、"],["その"],["子","こ"],["ヨセフ"],["を"],["呼んで","よんで"],["言った","いった"],["、"],["「"],["もし"],["わたし"],["が"],["あなた"],["の"],["前","まえ"],["に"],["恵","めぐみ"],["を"],["得るなら","えるなら"],["、"],["どう"],["か"],["手","て"],["を"],["わたし"],["の"],["もも"],["の"],["下","した"],["に"],["入れて","いれて"],["誓い","ちかい"],["、"],["親切","しんせつ"],["と"],["誠実","せいじつ"],["と"],["を"],["もって"],["わたし"],["を"],["取扱って","とりあつかって"],["ください"],["。"],["どう"],["か"],["わたし"],["を"],["エジプト"],["に"],["は"],["葬むらないで","ほうむらないで"],["ください"],["。"]]},{"verse":30,"text":"わたしが先祖,せんぞたちと共,ともに眠,ねむるときには、わたしをエジプトから運,はこび出,だして先祖,せんぞたちの墓,はかに葬,ほうむってください」。ヨセフは言,いった、「あなたの言,いわれたようにいたします」。","tok":[["わたし"],["が"],["先祖","せんぞ"],["たち"],["と"],["共","とも"],["に"],["眠る","ねむる"],["とき"],["に"],["は"],["、"],["わたし"],["を"],["エジプト"],["から"],["運こび","はこび"],["出して","だして"],["先祖","せんぞ"],["たち"],["の"],["墓","はか"],["に"],["葬むって","ほうむって"],["ください"],["」"],["。"],["ヨセフ"],["は"],["言った","いった"],["、"],["「"],["あなた"],["の"],["言われた","いわれた"],["よう"],["に"],["いたします"],["」"],["。"]]},{"verse":31,"text":"ヤコブがまた、「わたしに誓,ちかってください」と言,いったので、彼,かれは誓,ちかった。イスラエルは床,とこのかしらで拝,おがんだ。","tok":[["ヤコブ"],["が"],["また"],["、"],["「"],["わたし"],["に"],["誓って","ちかって"],["ください"],["」"],["と"],["言った","いった"],["ので"],["、"],["彼","かれ"],["は"],["誓った","ちかった"],["。"],["イスラエル"],["は"],["床","とこ"],["の"],["かしら"],["で"],["拝んだ","おがんだ"],["。"]]}]
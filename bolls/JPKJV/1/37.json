[{"verse":1,"text":"ヤコブは父,ちちの寄留,きりゅうの地,ち、すなわちカナンの地,ちに住,すんだ。","tok":[["ヤコブ"],["は"],["父","ちち"],["の"],["寄留","きりゅう"],["の"],["地","ち"],["、"],["すなわち"],["カナン"],["の"],["地","ち"],["に"],["住んだ","すんだ"],["。"]]},{"verse":2,"text":"ヤコブの子孫,しそんは次,つぎのとおりである。ヨセフは十七歳,さいの時,とき、兄弟,きょうだいたちと共,ともに羊,ひつじの群,むれを飼,かっていた。彼,かれはまだ子供,こどもで、父,ちちの妻,つまたちビルハとジルパとの子,こらと共,ともにいたが、ヨセフは彼,かれらの悪,わるいうわさを父,ちちに告,つげた。","tok":[["ヤコブ"],["の"],["子孫","しそん"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["ヨセフ"],["は"],["十七歳","さい"],["の"],["時","とき"],["、"],["兄弟","きょうだい"],["たち"],["と"],["共","とも"],["に"],["羊","ひつじ"],["の"],["群れ","むれ"],["を"],["飼って","かって"],["いた"],["。"],["彼","かれ"],["は"],["まだ"],["子供","こども"],["で"],["、"],["父","ちち"],["の"],["妻たち","つまたち"],["ビルハ"],["と"],["ジルパ"],["と"],["の"],["子","こ"],["ら"],["と"],["共","とも"],["に"],["いた"],["が"],["、"],["ヨセフ"],["は"],["彼","かれ"],["ら"],["の"],["悪い","わるい"],["うわさ"],["を"],["父","ちち"],["に"],["告","つげ"],["た"],["。"]]},{"verse":3,"text":"ヨセフは年寄,としより子,こであったから、イスラエルは他,たのどの子,こよりも彼,かれを愛,あいして、彼,かれのために長,ながそでの着物,きものをつくった。","tok":[["ヨセフ"],["は"],["年寄","としより"],["子","こ"],["で"],["あった"],["から"],["、"],["イスラエル"],["は"],["他","た"],["の"],["どの"],["子","こ"],["より"],["も"],["彼","かれ"],["を"],["愛して","あいして"],["、"],["彼","かれ"],["の"],["ため"],["に"],["長そで","ながそで"],["の"],["着物","きもの"],["を"],["つくった"],["。"]]},{"verse":4,"text":"兄弟,きょうだいたちは父,ちちがどの兄弟,きょうだいよりも彼,かれを愛,あいするのを見,みて、彼,かれを憎,にくみ、穏,おだやかに彼,かれに語,かたることができなかった。","tok":[["兄弟","きょうだい"],["たち"],["は"],["父","ちち"],["が"],["どの"],["兄弟","きょうだい"],["より"],["も"],["彼","かれ"],["を"],["愛する","あいする"],["の"],["を"],["見て","みて"],["、"],["彼","かれ"],["を"],["憎み","にくみ"],["、"],["穏","おだやか"],["に"],["彼","かれ"],["に"],["語る","かたる"],["こと"],["が"],["できなかった"],["。"]]},{"verse":5,"text":"ある時,とき、ヨセフは夢,ゆめを見,みて、それを兄弟,きょうだいたちに話,はなしたので、彼,かれらは、ますます彼,かれを憎,にくんだ。","tok":[["ある"],["時","とき"],["、"],["ヨセフ"],["は"],["夢","ゆめ"],["を"],["見て","みて"],["、"],["それ"],["を"],["兄弟","きょうだい"],["たち"],["に"],["話","はなし"],["た"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["、"],["ますます"],["彼","かれ"],["を"],["憎んだ","にくんだ"],["。"]]},{"verse":6,"text":"ヨセフは彼,かれらに言,いった、「どうぞわたしが見,みた夢,ゆめを聞,きいてください。","tok":[["ヨセフ"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["どうぞ"],["わたし"],["が"],["見た","みた"],["夢","ゆめ"],["を"],["聞いて","きいて"],["ください"],["。"]]},{"verse":7,"text":"わたしたちが畑,はたけの中,なかで束,たばを結,ゆわえていたとき、わたしの束,たばが起,おきて立,たつと、あなたがたの束,たばがまわりにきて、わたしの束,たばを拝,おがみました」。","tok":[["わたしたち"],["が"],["畑","はたけ"],["の"],["中","なか"],["で"],["束","たば"],["を"],["結わえて","ゆわえて"],["いた"],["とき"],["、"],["わたし"],["の"],["束","たば"],["が"],["起きて","おきて"],["立つ","たつ"],["と"],["、"],["あなた"],["がた"],["の"],["束","たば"],["が"],["まわり"],["に"],["きて"],["、"],["わたし"],["の"],["束","たば"],["を"],["拝みました","おがみました"],["」"],["。"]]},{"verse":8,"text":"すると兄弟,きょうだいたちは彼,かれに向,むかって、「あなたはほんとうにわたしたちの王,おうになるのか。あなたは実際,じっさいわたしたちを治,おさめるのか」と言,いって、彼,かれの夢,ゆめとその言葉,ことばのゆえにますます彼,かれを憎,にくんだ。","tok":[["する"],["と"],["兄弟","きょうだい"],["たち"],["は"],["彼","かれ"],["に"],["向かって","むかって"],["、"],["「"],["あなた"],["は"],["ほんとう"],["に"],["わたしたち"],["の"],["王","おう"],["に"],["なる"],["の"],["か"],["。"],["あなた"],["は"],["実際","じっさい"],["わたしたち"],["を"],["治める","おさめる"],["の"],["か"],["」"],["と"],["言って","いって"],["、"],["彼","かれ"],["の"],["夢","ゆめ"],["と"],["その"],["言葉","ことば"],["の"],["ゆえ"],["に"],["ますます"],["彼","かれ"],["を"],["憎んだ","にくんだ"],["。"]]},{"verse":9,"text":"ヨセフはまた一つの夢,ゆめを見,みて、それを兄弟,きょうだいたちに語,かたって言,いった、「わたしはまた夢,ゆめを見,みました。日,ひと月,つきと十一の星,ほしとがわたしを拝,おがみました」。","tok":[["ヨセフ"],["は"],["また"],["一","ひと"],["つ"],["の"],["夢","ゆめ"],["を"],["見て","みて"],["、"],["それ"],["を"],["兄弟","きょうだい"],["たち"],["に"],["語って","かたって"],["言った","いった"],["、"],["「"],["わたし"],["は"],["また"],["夢","ゆめ"],["を"],["見ました","みました"],["。"],["日","ひ"],["と"],["月","つき"],["と"],["十一","じゅういち"],["の"],["星","ほし"],["と"],["が"],["わたし"],["を"],["拝みました","おがみました"],["」"],["。"]]},{"verse":10,"text":"彼,かれはこれを父,ちちと兄弟,きょうだいたちに語,かたったので、父,ちちは彼,かれをとがめて言,いった、「あなたが見,みたその夢,ゆめはどういうのか。ほんとうにわたしとあなたの母,ははと、兄弟,きょうだいたちとが行,いって地,ちに伏,ふし、あなたを拝,おがむのか」。","tok":[["彼","かれ"],["は"],["これ"],["を"],["父","ちち"],["と"],["兄弟","きょうだい"],["たち"],["に"],["語った","かたった"],["ので"],["、"],["父","ちち"],["は"],["彼","かれ"],["を"],["とがめて"],["言った","いった"],["、"],["「"],["あなた"],["が"],["見た","みた"],["その"],["夢","ゆめ"],["は"],["どういう"],["の"],["か"],["。"],["ほんとう"],["に"],["わたし"],["と"],["あなた"],["の"],["母","はは"],["と"],["、"],["兄弟","きょうだい"],["たち"],["と"],["が"],["行って","いって"],["地","ち"],["に"],["伏し","ふし"],["、"],["あなた"],["を"],["拝む","おがむ"],["の"],["か"],["」"],["。"]]},{"verse":11,"text":"兄弟,きょうだいたちは彼,かれをねたんだ。しかし父,ちちはこの言葉,ことばを心,こころにとめた。","tok":[["兄弟","きょうだい"],["たち"],["は"],["彼","かれ"],["を"],["ねたんだ"],["。"],["しかし"],["父","ちち"],["は"],["この"],["言葉","ことば"],["を"],["心","こころ"],["に"],["とめた"],["。"]]},{"verse":12,"text":"さて兄弟,きょうだいたちがシケムに行,いって、父,ちちの羊,ひつじの群,むれを飼,かっていたとき、","tok":[["さて"],["兄弟","きょうだい"],["たち"],["が"],["シケム"],["に"],["行って","いって"],["、"],["父","ちち"],["の"],["羊","ひつじ"],["の"],["群れ","むれ"],["を"],["飼って","かって"],["いた"],["とき"],["、"]]},{"verse":13,"text":"イスラエルはヨセフに言,いった、「あなたの兄弟,きょうだいたちはシケムで羊,ひつじを飼,かっているではないか。さあ、あなたを彼,かれらの所,ところへつかわそう」。ヨセフは父,ちちに言,いった、「はい、行,いきます」。","tok":[["イスラエル"],["は"],["ヨセフ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["の"],["兄弟","きょうだい"],["たち"],["は"],["シケム"],["で"],["羊","ひつじ"],["を"],["飼って","かって"],["いるで"],["は"],["ない"],["か"],["。"],["さあ"],["、"],["あなた"],["を"],["彼","かれ"],["ら"],["の"],["所","ところ"],["へ"],["つかわそう"],["」"],["。"],["ヨセフ"],["は"],["父","ちち"],["に"],["言った","いった"],["、"],["「"],["はい"],["、"],["行きます","いきます"],["」"],["。"]]},{"verse":14,"text":"父,ちちは彼,かれに言,いった、「どうか、行,いって、あなたの兄弟,きょうだいたちは無事,ぶじであるか、また群,むれは無事,ぶじであるか見,みてきて、わたしに知,しらせてください」。父,ちちが彼,かれをヘブロンの谷,たにからつかわしたので、彼,かれはシケムに行,いった。","tok":[["父","ちち"],["は"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["どう"],["か"],["、"],["行って","いって"],["、"],["あなた"],["の"],["兄弟","きょうだい"],["たち"],["は"],["無事","ぶじ"],["で"],["ある"],["か"],["、"],["また"],["群れ","むれ"],["は"],["無事","ぶじ"],["で"],["ある"],["か"],["見て","みて"],["きて"],["、"],["わたし"],["に"],["知らせて","しらせて"],["ください"],["」"],["。"],["父","ちち"],["が"],["彼","かれ"],["を"],["ヘブロン"],["の"],["谷","たに"],["から"],["つかわした"],["ので"],["、"],["彼","かれ"],["は"],["シケム"],["に"],["行った","いった"],["。"]]},{"verse":15,"text":"ひとりの人,ひとが彼,かれに会,あい、彼,かれが野,のをさまよっていたので、その人,ひとは彼,かれに尋,たずねて言,いった、「あなたは何,なにを捜,さがしているのですか」。","tok":[["ひとり"],["の"],["人","ひと"],["が"],["彼","かれ"],["に"],["会い","あい"],["、"],["彼","かれ"],["が"],["野","の"],["を"],["さまよって"],["いた"],["ので"],["、"],["その"],["人","ひと"],["は"],["彼","かれ"],["に"],["尋ねて","たずねて"],["言った","いった"],["、"],["「"],["あなた"],["は"],["何に","なに"],["を"],["捜して","さがして"],["いる"],["の"],["です"],["か"],["」"],["。"]]},{"verse":16,"text":"彼,かれは言,いった、「兄弟,きょうだいたちを捜,さがしているのです。彼,かれらが、どこで羊,ひつじを飼,かっているのか、どうぞわたしに知,しらせてください」。","tok":[["彼","かれ"],["は"],["言った","いった"],["、"],["「"],["兄弟","きょうだい"],["たち"],["を"],["捜して","さがして"],["いる"],["の"],["です"],["。"],["彼","かれ"],["ら"],["が"],["、"],["どこ"],["で"],["羊","ひつじ"],["を"],["飼って","かって"],["いる"],["の"],["か"],["、"],["どうぞ"],["わたし"],["に"],["知らせて","しらせて"],["ください"],["」"],["。"]]},{"verse":17,"text":"その人,ひとは言,いった、「彼,かれらはここを去,さりました。彼,かれらが『ドタンへ行,いこう』と言,いうのをわたしは聞,ききました」。そこでヨセフは兄弟,きょうだいたちのあとを追,おって行,いって、ドタンで彼,かれらに会,あった。","tok":[["その"],["人","ひと"],["は"],["言った","いった"],["、"],["「"],["彼","かれ"],["ら"],["は"],["ここ"],["を"],["去りました","さりました"],["。"],["彼","かれ"],["ら"],["が"],["『"],["ドタン"],["へ"],["行こう","いこう"],["』"],["と"],["言う","いう"],["の"],["を"],["わたし"],["は"],["聞","きき"],["ました"],["」"],["。"],["そこ"],["で"],["ヨセフ"],["は"],["兄弟","きょうだい"],["たち"],["の"],["あと"],["を"],["追って","おって"],["行って","いって"],["、"],["ドタン"],["で"],["彼","かれ"],["ら"],["に"],["会った","あった"],["。"]]},{"verse":18,"text":"ヨセフが彼,かれらに近,ちかづかないうちに、彼,かれらははるかにヨセフを見,みて、これを殺,ころそうと計,はかり、","tok":[["ヨセフ"],["が"],["彼","かれ"],["ら"],["に"],["近づかない","ちかづかない"],["うち"],["に"],["、"],["彼","かれ"],["ら"],["は"],["はるか"],["に"],["ヨセフ"],["を"],["見て","みて"],["、"],["これ"],["を"],["殺そう","ころそう"],["と"],["計り","はかり"],["、"]]},{"verse":19,"text":"互,たがいに言,いった、「あの夢見,ゆめみる者,ものがやって来,くる。","tok":[["互","たがい"],["に"],["言った","いった"],["、"],["「"],["あの"],["夢","ゆめ"],["見る","みる"],["者","もの"],["が"],["やって"],["来る","くる"],["。"]]},{"verse":20,"text":"さあ、彼,かれを殺,ころして穴,あなに投,なげ入,いれ、悪,わるい獣,けものが彼,かれを食,くったと言,いおう。そして彼,かれの夢,ゆめがどうなるか見,みよう」。","tok":[["さあ"],["、"],["彼","かれ"],["を"],["殺ろして","ころして"],["穴","あな"],["に"],["投入れ","なげいれ"],["、"],["悪い","わるい"],["獣","けもの"],["が"],["彼","かれ"],["を"],["食った","くった"],["と"],["言おう","いおう"],["。"],["そして"],["彼","かれ"],["の"],["夢","ゆめ"],["が"],["どう"],["なる"],["か"],["見よう","みよう"],["」"],["。"]]},{"verse":21,"text":"ルベンはこれを聞,きいて、ヨセフを彼,かれらの手,てから救,すくい出,だそうとして言,いった、「われわれは彼,かれの命,いのちを取,とってはならない」。","tok":[["ルベン"],["は"],["これ"],["を"],["聞いて","きいて"],["、"],["ヨセフ"],["を"],["彼","かれ"],["ら"],["の"],["手","て"],["から"],["救い出そう","すくいだそう"],["として"],["言った","いった"],["、"],["「"],["われわれ"],["は"],["彼","かれ"],["の"],["命","いのち"],["を"],["取って","とって"],["は"],["ならない"],["」"],["。"]]},{"verse":22,"text":"ルベンはまた彼,かれらに言,いった、「血,ちを流,ながしてはいけない。彼,かれを荒野,あらののこの穴,あなに投,なげ入,いれよう。彼,かれに手,てをくだしてはならない」。これはヨセフを彼,かれらの手,てから救,すくいだして父,ちちに返,かえすためであった。","tok":[["ルベン"],["は"],["また"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["血","ち"],["を"],["流して","ながして"],["は"],["いけない"],["。"],["彼","かれ"],["を"],["荒野","あらの"],["の"],["この"],["穴","あな"],["に"],["投入れよう","なげいれよう"],["。"],["彼","かれ"],["に"],["手","て"],["を"],["くだして"],["は"],["ならない"],["」"],["。"],["これ"],["は"],["ヨセフ"],["を"],["彼","かれ"],["ら"],["の"],["手","て"],["から"],["救いだして","すくいだして"],["父","ちち"],["に"],["返えす","かえす"],["ため"],["で"],["あった"],["。"]]},{"verse":23,"text":"さて、ヨセフが兄弟,きょうだいたちのもとへ行,いくと、彼,かれらはヨセフの着物,きもの、彼,かれが着,きていた長,ながそでの着物,きものをはぎとり、","tok":[["さて"],["、"],["ヨセフ"],["が"],["兄弟","きょうだい"],["たち"],["の"],["もと"],["へ"],["行く","いく"],["と"],["、"],["彼","かれ"],["ら"],["は"],["ヨセフ"],["の"],["着物","きもの"],["、"],["彼","かれ"],["が"],["着て","きて"],["いた"],["長そで","ながそで"],["の"],["着物","きもの"],["を"],["はぎとり"],["、"]]},{"verse":24,"text":"彼,かれを捕,とらえて穴,あなに投,なげ入,いれた。その穴,あなはからで、その中,なかに水,みずはなかった。","tok":[["彼","かれ"],["を"],["捕らえて","とらえて"],["穴","あな"],["に"],["投入れた","なげいれた"],["。"],["その"],["穴","あな"],["は"],["から"],["で"],["、"],["その"],["中","なか"],["に"],["水","みず"],["は"],["なかった"],["。"]]},{"verse":25,"text":"こうして彼,かれらはすわってパンを食,たべた。時,ときに彼,かれらが目,めをあげて見,みると、イシマエルびとの隊商,たいしょうが、らくだに香料,こうりょうと、乳香,にゅうこうと、もつやくとを負,おわせてエジプトへ下,くだり行,いこうとギレアデからやってきた。","tok":[["こう"],["して"],["彼","かれ"],["ら"],["は"],["すわって"],["パン"],["を"],["食べた","たべた"],["。"],["時","とき"],["に"],["彼","かれ"],["ら"],["が"],["目","め"],["を"],["あげて"],["見る","みる"],["と"],["、"],["イシマエル"],["びと"],["の"],["隊商","たいしょう"],["が"],["、"],["らくだ"],["に"],["香料","こうりょう"],["と"],["、"],["乳香","にゅうこう"],["と"],["、"],["もつ"],["やく"],["と"],["を"],["負わせて","おわせて"],["エジプト"],["へ"],["下り","くだり"],["行こう","いこう"],["と"],["ギレアデ"],["から"],["やって"],["きた"],["。"]]},{"verse":26,"text":"そこでユダは兄弟,きょうだいたちに言,いった、「われわれが弟,おとうとを殺,ころし、その血,ちを隠,かくして何,なにの益,えきがあろう。","tok":[["そこ"],["で"],["ユダ"],["は"],["兄弟","きょうだい"],["たち"],["に"],["言った","いった"],["、"],["「"],["われわれ"],["が"],["弟","おとうと"],["を"],["殺ろし","ころし"],["、"],["その"],["血","ち"],["を"],["隠して","かくして"],["何","なに"],["の"],["益","えき"],["が"],["あろう"],["。"]]},{"verse":27,"text":"さあ、われわれは彼,かれをイシマエルびとに売,うろう。彼,かれはわれわれの兄弟,きょうだい、われわれの肉,にく身,みだから、彼,かれに手,てを下,くだしてはならない」。兄弟,きょうだいたちはこれを聞,きき入,いれた。","tok":[["さあ"],["、"],["われわれ"],["は"],["彼","かれ"],["を"],["イシマエル"],["びと"],["に"],["売ろう","うろう"],["。"],["彼","かれ"],["は"],["われわれ"],["の"],["兄弟","きょうだい"],["、"],["われわれ"],["の"],["肉","にく"],["身","み"],["だ"],["から"],["、"],["彼","かれ"],["に"],["手","て"],["を"],["下して","くだして"],["は"],["ならない"],["」"],["。"],["兄弟","きょうだい"],["たち"],["は"],["これ"],["を"],["聞入れた","ききいれた"],["。"]]},{"verse":28,"text":"時,ときにミデアンびとの商人,しょうにんたちが通,とおりかかったので、彼,かれらはヨセフを穴,あなから引,ひき上,あげ、銀,ぎん二十シケルでヨセフをイシマエルびとに売,うった。彼,かれらはヨセフをエジプトへ連,つれて行,いった。","tok":[["時","とき"],["に"],["ミデアン"],["びと"],["の"],["商人","しょうにん"],["たち"],["が"],["通りかかった","とおりかかった"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["ヨセフ"],["を"],["穴","あな"],["から"],["引上げ","ひきあげ"],["、"],["銀","ぎん"],["二十","にじゅう"],["シケル"],["で"],["ヨセフ"],["を"],["イシマエル"],["びと"],["に"],["売った","うった"],["。"],["彼","かれ"],["ら"],["は"],["ヨセフ"],["を"],["エジプト"],["へ"],["連れて","つれて"],["行った","いった"],["。"]]},{"verse":29,"text":"さてルベンは穴,あなに帰,かえって見,みたが、ヨセフが穴,あなの中,なかにいなかったので、彼,かれは衣服,いふくを裂,さき、","tok":[["さて"],["ルベン"],["は"],["穴","あな"],["に"],["帰えって","かえって"],["見た","みた"],["が"],["、"],["ヨセフ"],["が"],["穴","あな"],["の"],["中","なか"],["に"],["いなかった"],["ので"],["、"],["彼","かれ"],["は"],["衣服","いふく"],["を"],["裂き","さき"],["、"]]},{"verse":30,"text":"兄弟,きょうだいたちのもとに帰,かえって言,いった、「あの子,こはいない。ああ、わたしはどこへ行,いくことができよう」。","tok":[["兄弟","きょうだい"],["たち"],["の"],["もと"],["に"],["帰えって","かえって"],["言った","いった"],["、"],["「"],["あの"],["子","こ"],["は"],["いない"],["。"],["ああ"],["、"],["わたし"],["は"],["どこ"],["へ"],["行く","いく"],["こと"],["が"],["できよう"],["」"],["。"]]},{"verse":31,"text":"彼,かれらはヨセフの着物,きものを取,とり、雄,おやぎを殺,ころして、着物,きものをその血,ちに浸,ひたし、","tok":[["彼","かれ"],["ら"],["は"],["ヨセフ"],["の"],["着物","きもの"],["を"],["取","とり"],["、"],["雄","おやぎ"],["を"],["殺ろして","ころして"],["、"],["着物","きもの"],["を"],["その"],["血","ち"],["に"],["浸し","ひたし"],["、"]]},{"verse":32,"text":"その長,ながそでの着物,きものを父,ちちに持,もち帰,かえって言,いった、「わたしたちはこれを見,みつけましたが、これはあなたの子,この着物,きものか、どうか見,みさだめてください」。","tok":[["その"],["長そで","ながそで"],["の"],["着物","きもの"],["を"],["父","ちち"],["に"],["持","もち"],["帰えって","かえって"],["言った","いった"],["、"],["「"],["わたしたち"],["は"],["これ"],["を"],["見つけました","みつけました"],["が"],["、"],["これ"],["は"],["あなた"],["の"],["子","こ"],["の"],["着物","きもの"],["か"],["、"],["どう"],["か"],["見さだめて","みさだめて"],["ください"],["」"],["。"]]},{"verse":33,"text":"父,ちちはこれを見,みさだめて言,いった、「わが子,この着物,きものだ。悪,わるい獣,けものが彼,かれを食,くったのだ。確,たしかにヨセフはかみ裂,さかれたのだ」。","tok":[["父","ちち"],["は"],["これ"],["を"],["見さだめて","みさだめて"],["言った","いった"],["、"],["「"],["わが"],["子","こ"],["の"],["着物","きもの"],["だ"],["。"],["悪い","わるい"],["獣","けもの"],["が"],["彼","かれ"],["を"],["食った","くった"],["の"],["だ"],["。"],["確か","たしか"],["に"],["ヨセフ"],["は"],["かみ"],["裂かれた","さかれた"],["の"],["だ"],["」"],["。"]]},{"verse":34,"text":"そこでヤコブは衣服,いふくを裂,さき、荒布,あらぬのを腰,こしにまとって、長,ながい間,あいだその子,このために嘆,なげいた。","tok":[["そこ"],["で"],["ヤコブ"],["は"],["衣服","いふく"],["を"],["裂き","さき"],["、"],["荒布","あらぬ"],["の"],["を"],["腰","こし"],["に"],["まとって"],["、"],["長い","ながい"],["間","あいだ"],["その"],["子","こ"],["の"],["ため"],["に"],["嘆いた","なげいた"],["。"]]},{"verse":35,"text":"子,こらと娘,むすめらとは皆,みな立,たって彼,かれを慰,なぐさめようとしたが、彼,かれは慰,なぐさめられるのを拒,こばんで言,いった、「いや、わたしは嘆,なげきながら陰府,よみに下,くだって、わが子,このもとへ行,いこう」。こうして父,ちちは彼,かれのために泣,ないた。","tok":[["子","こ"],["ら"],["と"],["娘","むすめ"],["ら"],["と"],["は"],["皆","みな"],["立って","たって"],["彼","かれ"],["を"],["慰さめよう","なぐさめよう"],["と"],["した"],["が"],["、"],["彼","かれ"],["は"],["慰さめられる","なぐさめられる"],["の"],["を"],["拒んで","こばんで"],["言った","いった"],["、"],["「"],["いや"],["、"],["わたし"],["は"],["嘆き","なげき"],["ながら"],["陰府","よみ"],["に"],["下って","くだって"],["、"],["わが"],["子","こ"],["の"],["もと"],["へ"],["行こう","いこう"],["」"],["。"],["こう"],["して"],["父","ちち"],["は"],["彼","かれ"],["の"],["ため"],["に"],["泣いた","ないた"],["。"]]},{"verse":36,"text":"さて、かのミデアンびとらはエジプトでパロの役人,やくにん、侍衛,じえい長,ちょうポテパルにヨセフを売,うった。","tok":[["さて"],["、"],["かの"],["ミデアン"],["びと"],["ら"],["は"],["エジプト"],["で"],["パロ"],["の"],["役人","やくにん"],["、"],["侍衛長","じえいちょう"],["ポテパル"],["に"],["ヨセフ"],["を"],["売った","うった"],["。"]]}]
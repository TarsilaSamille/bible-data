[{"verse":1,"text":"アブラムの九十九歳,さいの時,とき、主,しゅはアブラムに現,あらわれて言,いわれた、「わたしは全能,ぜんのうの神,かみである。あなたはわたしの前,まえに歩,あゆみ、全,まったき者,ものであれ。","tok":[["アブラム"],["の"],["九十九歳","さい"],["の"],["時","とき"],["、"],["主","しゅ"],["は"],["アブラム"],["に"],["現われて","あらわれて"],["言われた","いわれた"],["、"],["「"],["わたし"],["は"],["全能","ぜんのう"],["の"],["神","かみ"],["で"],["ある"],["。"],["あなた"],["は"],["わたし"],["の"],["前","まえ"],["に"],["歩み","あゆみ"],["、"],["全","ま"],["っ"],["たき者","たきもの"],["で"],["あれ"],["。"]]},{"verse":2,"text":"わたしはあなたと契約,けいやくを結,むすび、大,おおいにあなたの子孫,しそんを増,ますであろう」。","tok":[["わたし"],["は"],["あなた"],["と"],["契約","けいやく"],["を"],["結び","むすび"],["、"],["大いに","おおいに"],["あなた"],["の"],["子孫","しそん"],["を"],["増すで","ますで"],["あろう"],["」"],["。"]]},{"verse":3,"text":"アブラムは、ひれ伏,ふした。神,かみはまた彼,かれに言,いわれた、","tok":[["アブラム"],["は"],["、"],["ひれ伏した","ひれふした"],["。"],["神","かみ"],["は"],["また"],["彼","かれ"],["に"],["言われた","いわれた"],["、"]]},{"verse":4,"text":"「わたしはあなたと契約,けいやくを結,むすぶ。あなたは多,おおくの国民,こくみんの父,ちちとなるであろう。","tok":[["「"],["わたし"],["は"],["あなた"],["と"],["契約","けいやく"],["を"],["結ぶ","むすぶ"],["。"],["あなた"],["は"],["多く","おおく"],["の"],["国民","こくみん"],["の"],["父","ちち"],["と"],["なるで"],["あろう"],["。"]]},{"verse":5,"text":"あなたの名,なは、もはやアブラムとは言,いわれず、あなたの名,なはアブラハムと呼,よばれるであろう。わたしはあなたを多,おおくの国民,こくみんの父,ちちとするからである。","tok":[["あなた"],["の"],["名","な"],["は"],["、"],["もはや"],["アブラム"],["と"],["は"],["言われず","いわれず"],["、"],["あなた"],["の"],["名","な"],["は"],["アブラハム"],["と"],["呼ばれるで","よばれるで"],["あろう"],["。"],["わたし"],["は"],["あなた"],["を"],["多く","おおく"],["の"],["国民","こくみん"],["の"],["父","ちち"],["と"],["する"],["から"],["で"],["ある"],["。"]]},{"verse":6,"text":"わたしはあなたに多,おおくの子孫,しそんを得,えさせ、国々,くにぐにの民,たみをあなたから起,おこそう。また、王,おうたちもあなたから出,でるであろう。","tok":[["わたし"],["は"],["あなた"],["に"],["多く","おおく"],["の"],["子孫","しそん"],["を"],["得させ","えさせ"],["、"],["国々","くにぐに"],["の"],["民","たみ"],["を"],["あなた"],["から"],["起こそう","おこそう"],["。"],["また"],["、"],["王","おう"],["たち"],["も"],["あなた"],["から"],["出るで","でるで"],["あろう"],["。"]]},{"verse":7,"text":"わたしはあなた及,および後,のちの代々,よよの子孫,しそんと契約,けいやくを立,たてて、永遠,えいえんの契約,けいやくとし、あなたと後,のちの子孫,しそんとの神,かみとなるであろう。","tok":[["わたし"],["は"],["あなた"],["及","および"],["後","のち"],["の"],["代々","よよ"],["の"],["子孫","しそん"],["と"],["契約","けいやく"],["を"],["立てて","たてて"],["、"],["永遠","えいえん"],["の"],["契約","けいやく"],["と"],["し"],["、"],["あなた"],["と"],["後","のち"],["の"],["子孫","しそん"],["と"],["の"],["神","かみ"],["と"],["なるで"],["あろう"],["。"]]},{"verse":8,"text":"わたしはあなたと後,のちの子孫,しそんとにあなたの宿,やどっているこの地,ち、すなわちカナンの全,ぜん地,ちを永久,えいきゅうの所有,しょゆうとして与,あたえる。そしてわたしは彼,かれらの神,かみとなるであろう」。","tok":[["わたし"],["は"],["あなた"],["と"],["後","のち"],["の"],["子孫","しそん"],["と"],["に"],["あなた"],["の"],["宿って","やどって"],["いる"],["この"],["地","ち"],["、"],["すなわち"],["カナン"],["の"],["全地","ぜんち"],["を"],["永久","えいきゅう"],["の"],["所有","しょゆう"],["として"],["与える","あたえる"],["。"],["そして"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["神","かみ"],["と"],["なるで"],["あろう"],["」"],["。"]]},{"verse":9,"text":"神,かみはまたアブラハムに言,いわれた、「あなたと後,のちの子孫,しそんとは共,ともに代々,よよわたしの契約,けいやくを守,まもらなければならない。あなたがたのうち","tok":[["神","かみ"],["は"],["また"],["アブラハム"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["と"],["後","のち"],["の"],["子孫","しそん"],["と"],["は"],["共","とも"],["に"],["代々","よよわたし"],["の"],["契約","けいやく"],["を"],["守らなければ","まもらなければ"],["ならない"],["。"],["あなた"],["がた"],["の"],["うち"]]},{"verse":10,"text":"男子,だんしはみな割礼,かつれいをうけなければならない。これはわたしとあなたがた及,および後,のちの子孫,しそんとの間,あいだのわたしの契約,けいやくであって、あなたがたの守,まもるべきものである。","tok":[["男子","だんし"],["は"],["みな"],["割礼","かつれい"],["を"],["うけなければ"],["ならない"],["。"],["これ"],["は"],["わたし"],["と"],["あなた"],["がた"],["及","および"],["後","のち"],["の"],["子孫","しそん"],["と"],["の"],["間","あいだ"],["の"],["わたし"],["の"],["契約","けいやく"],["で"],["あって"],["、"],["あなた"],["がた"],["の"],["守","まもる"],["べき"],["もの"],["で"],["ある"],["。"]]},{"verse":11,"text":"あなたがたは前,まえの皮,かわに割礼,かつれいを受,うけなければならない。それがわたしとあなたがたとの間,あいだの契約,けいやくのしるしとなるであろう。","tok":[["あなた"],["がた"],["は"],["前","まえ"],["の"],["皮","かわ"],["に"],["割礼","かつれい"],["を"],["受なければ","うけなければ"],["ならない"],["。"],["それ"],["が"],["わたし"],["と"],["あなた"],["がた"],["と"],["の"],["間","あいだ"],["の"],["契約","けいやく"],["の"],["しるし"],["と"],["なるで"],["あろう"],["。"]]},{"verse":12,"text":"あなたがたのうちの男子,だんしはみな代々,よよ、家,いえに生,うまれた者,ものも、また異邦人,いほうじんから銀,ぎんで買,かい取,とった、あなたの子孫,しそんでない者,ものも、生,うまれて八日,か目,めに割礼,かつれいを受,うけなければならない。","tok":[["あなた"],["がた"],["の"],["うち"],["の"],["男子","だんし"],["は"],["みな"],["代々","よ"],["よ"],["、"],["家","いえ"],["に"],["生まれた","うまれた"],["者","もの"],["も"],["、"],["また"],["異邦人","いほうじん"],["から"],["銀","ぎん"],["で"],["買取った","かいとった"],["、"],["あなた"],["の"],["子孫","しそん"],["で"],["ない"],["者","もの"],["も"],["、"],["生まれて","うまれて"],["八日目","かめ"],["に"],["割礼","かつれい"],["を"],["受なければ","うけなければ"],["ならない"],["。"]]},{"verse":13,"text":"あなたの家,いえに生,うまれた者,ものも、あなたが銀,ぎんで買,かい取,とった者,ものも必,かならず割礼,かつれいを受,うけなければならない。こうしてわたしの契約,けいやくはあなたがたの身,みにあって永遠,えいえんの契約,けいやくとなるであろう。","tok":[["あなた"],["の"],["家","いえ"],["に"],["生まれた","うまれた"],["者","もの"],["も"],["、"],["あなた"],["が"],["銀","ぎん"],["で"],["買取った","かいとった"],["者","もの"],["も"],["必","かならず"],["割礼","かつれい"],["を"],["受なければ","うけなければ"],["ならない"],["。"],["こう"],["して"],["わたし"],["の"],["契約","けいやく"],["は"],["あなた"],["がた"],["の"],["身","み"],["に"],["あって"],["永遠","えいえん"],["の"],["契約","けいやく"],["と"],["なるで"],["あろう"],["。"]]},{"verse":14,"text":"割礼,かつれいを受,うけない男子,だんし、すなわち前,まえの皮,かわを切,きらない者,ものはわたしの契約,けいやくを破,やぶるゆえ、その人,ひとは民,たみのうちから断,たたれるであろう」。","tok":[["割礼","かつれい"],["を"],["受ない","うけない"],["男子","だんし"],["、"],["すなわち"],["前","まえ"],["の"],["皮","かわ"],["を"],["切らない","きらない"],["者","もの"],["は"],["わたし"],["の"],["契約","けいやく"],["を"],["破る","やぶる"],["ゆえ"],["、"],["その"],["人","ひと"],["は"],["民","たみ"],["の"],["うち"],["から"],["断たれるで","たたれるで"],["あろう"],["」"],["。"]]},{"verse":15,"text":"神,かみはまたアブラハムに言,いわれた、「あなたの妻,つまサライは、もはや名,なをサライといわず、名,なをサラと言,いいなさい。","tok":[["神","かみ"],["は"],["また"],["アブラハム"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["の"],["妻","つま"],["サライ"],["は"],["、"],["もはや"],["名","な"],["を"],["サライ"],["と"],["いわず"],["、"],["名","な"],["を"],["サラ"],["と"],["言い","いい"],["なさい"],["。"]]},{"verse":16,"text":"わたしは彼女,かのじょを祝福,しゅくふくし、また彼女,かのじょによって、あなたにひとりの男,おとこの子,こを授,さづけよう。わたしは彼女,かのじょを祝福,しゅくふくし、彼女,かのじょを国々,くにぐにの民,たみの母,ははとしよう。彼女,かのじょから、もろもろの民,たみの王,おうたちが出,でるであろう」。","tok":[["わたし"],["は"],["彼女","かのじょ"],["を"],["祝福","しゅくふく"],["し"],["、"],["また"],["彼女","かのじょ"],["によって"],["、"],["あなた"],["に"],["ひとり"],["の"],["男の子","おとこのこ"],["を"],["授","さ"],["づけよう"],["。"],["わたし"],["は"],["彼女","かのじょ"],["を"],["祝福","しゅくふく"],["し"],["、"],["彼女","かのじょ"],["を"],["国々","くにぐに"],["の"],["民","たみ"],["の"],["母","はは"],["と"],["しよう"],["。"],["彼女","かのじょ"],["から"],["、"],["もろもろ"],["の"],["民","たみ"],["の"],["王","おう"],["たち"],["が"],["出るで","でるで"],["あろう"],["」"],["。"]]},{"verse":17,"text":"アブラハムはひれ伏,ふして笑,わらい、心,こころの中,なかで言,いった、「百歳,さいの者,ものにどうして子,こが生,うまれよう。サラはまた九十歳,さいにもなって、どうして産,うむことができようか」。","tok":[["アブラハム"],["は"],["ひれ伏して","ひれふして"],["笑","わらい"],["、"],["心","こころ"],["の"],["中","なか"],["で"],["言った","いった"],["、"],["「"],["百歳","さい"],["の"],["者","もの"],["に"],["どう"],["して"],["子","こ"],["が"],["生まれよう","うまれよう"],["。"],["サラ"],["は"],["また"],["九十歳","さい"],["に"],["も"],["なって"],["、"],["どう"],["して"],["産む","うむ"],["こと"],["が"],["できよう"],["か"],["」"],["。"]]},{"verse":18,"text":"そしてアブラハムは神,かみに言,いった、「どうかイシマエルがあなたの前,まえに生,いきながらえますように」。","tok":[["そして"],["アブラハム"],["は"],["神","かみ"],["に"],["言った","いった"],["、"],["「"],["どう"],["か"],["イシマエル"],["が"],["あなた"],["の"],["前","まえ"],["に"],["生きながらえます","いきながらえます"],["よう"],["に"],["」"],["。"]]},{"verse":19,"text":"神,かみは言,いわれた、「いや、あなたの妻,つまサラはあなたに男,おとこの子,こを産,うむでしょう。名,なをイサクと名,なづけなさい。わたしは彼,かれと契約,けいやくを立,たてて、後,のちの子孫,しそんのために永遠,えいえんの契約,けいやくとしよう。","tok":[["神","かみ"],["は"],["言われた","いわれた"],["、"],["「"],["いや"],["、"],["あなた"],["の"],["妻","つま"],["サラ"],["は"],["あなた"],["に"],["男の子","おとこのこ"],["を"],["産むでしょう","うむでしょう"],["。"],["名","な"],["を"],["イサク"],["と"],["名づけ","なづけ"],["なさい"],["。"],["わたし"],["は"],["彼","かれ"],["と"],["契約","けいやく"],["を"],["立てて","たてて"],["、"],["後","のち"],["の"],["子孫","しそん"],["の"],["ため"],["に"],["永遠","えいえん"],["の"],["契約","けいやく"],["と"],["しよう"],["。"]]},{"verse":20,"text":"またイシマエルについてはあなたの願,ねがいを聞,きいた。わたしは彼,かれを祝福,しゅくふくして多,おおくの子孫,しそんを得,えさせ、大,おおいにそれを増,ますであろう。彼,かれは十二人,にんの君,きみたちを生,うむであろう。わたしは彼,かれを大,おおいなる国民,こくみんとしよう。","tok":[["また"],["イシマエル"],["について"],["は"],["あなた"],["の"],["願い","ねがい"],["を"],["聞いた","きいた"],["。"],["わたし"],["は"],["彼","かれ"],["を"],["祝福","しゅくふく"],["して"],["多く","おおく"],["の"],["子孫","しそん"],["を"],["得させ","えさせ"],["、"],["大いに","おおいに"],["それ"],["を"],["増すで","ますで"],["あろう"],["。"],["彼","かれ"],["は"],["十二人","にん"],["の"],["君","きみ"],["たち"],["を"],["生むで","うむで"],["あろう"],["。"],["わたし"],["は"],["彼","かれ"],["を"],["大いなる","おおいなる"],["国民","こくみん"],["と"],["しよう"],["。"]]},{"verse":21,"text":"しかしわたしは来年,らいねんの今,いまごろサラがあなたに産,うむイサクと、わたしの契約,けいやくを立,たてるであろう」。","tok":[["しかし"],["わたし"],["は"],["来年","らいねん"],["の"],["今ごろ","いまごろ"],["サラ"],["が"],["あなた"],["に"],["産む","うむ"],["イサク"],["と"],["、"],["わたし"],["の"],["契約","けいやく"],["を"],["立るで","たてるで"],["あろう"],["」"],["。"]]},{"verse":22,"text":"神,かみはアブラハムと語,かたり終,おえ、彼,かれを離,はなれて、のぼられた。","tok":[["神","かみ"],["は"],["アブラハム"],["と"],["語り","かたり"],["終え","おえ"],["、"],["彼","かれ"],["を"],["離れて","はなれて"],["、"],["のぼられた"],["。"]]},{"verse":23,"text":"アブラハムは神,かみが自分,じぶんに言,いわれたように、この日,ひその子,こイシマエルと、すべて家,いえに生,うまれた者,ものおよびすべて銀,ぎんで買,かい取,とった者,もの、すなわちアブラハムの家,いえの人々,ひとびとのうち、すべての男子,だんしを連,つれてきて、前,まえの皮,かわに割礼,かつれいを施,ほどこした。","tok":[["アブラハム"],["は"],["神","かみ"],["が"],["自分","じぶん"],["に"],["言われた","いわれた"],["よう"],["に"],["、"],["この"],["日","ひ"],["その"],["子","こ"],["イシマエル"],["と"],["、"],["すべて"],["家","いえ"],["に"],["生まれた","うまれた"],["者","もの"],["および"],["すべて"],["銀","ぎん"],["で"],["買取った","かいとった"],["者","もの"],["、"],["すなわち"],["アブラハム"],["の"],["家","いえ"],["の"],["人々","ひとびと"],["の"],["うち"],["、"],["すべて"],["の"],["男子","だんし"],["を"],["連れて","つれて"],["きて"],["、"],["前","まえ"],["の"],["皮","かわ"],["に"],["割礼","かつれい"],["を"],["施した","ほどこした"],["。"]]},{"verse":24,"text":"アブラハムが前,まえの皮,かわに割礼,かつれいを受,うけた時,ときは九十九歳,さい、","tok":[["アブラハム"],["が"],["前","まえ"],["の"],["皮","かわ"],["に"],["割礼","かつれい"],["を"],["受た","うけた"],["時","とき"],["は"],["九十九歳","さ"],["い"],["、"]]},{"verse":25,"text":"その子,こイシマエルが前,まえの皮,かわに割礼,かつれいを受,うけた時,ときは十三歳,さいであった。","tok":[["その"],["子","こ"],["イシマエル"],["が"],["前","まえ"],["の"],["皮","かわ"],["に"],["割礼","かつれい"],["を"],["受た","うけた"],["時","とき"],["は"],["十三歳","さ"],["いで"],["あった"],["。"]]},{"verse":26,"text":"この日,ひアブラハムとその子,こイシマエルは割礼,かつれいを受,うけた。","tok":[["この"],["日","ひ"],["アブラハム"],["と"],["その"],["子","こ"],["イシマエル"],["は"],["割礼","かつれい"],["を"],["受た","うけた"],["。"]]},{"verse":27,"text":"またその家,いえの人々,ひとびとは家,いえに生,うまれた者,ものも、銀,ぎんで異邦人,いほうじんから買,かい取,とった者,ものも皆,みな、彼,かれと共,ともに割礼,かつれいを受,うけた。","tok":[["また"],["その"],["家","いえ"],["の"],["人々","ひとびと"],["は"],["家","いえ"],["に"],["生まれた","うまれた"],["者","もの"],["も"],["、"],["銀","ぎん"],["で"],["異邦人","いほうじん"],["から"],["買取った","かいとった"],["者","もの"],["も"],["皆","みな"],["、"],["彼","かれ"],["と"],["共","とも"],["に"],["割礼","かつれい"],["を"],["受た","うけた"],["。"]]}]
[{"verse":1,"text":"主,しゅはマムレのテレビンの木,きのかたわらでアブラハムに現,あらわれられた。それは昼,ひるの暑,あついころで、彼,かれは天幕,てんまくの入口,いりぐちにすわっていたが、","tok":[["主","しゅ"],["は"],["マムレ"],["の"],["テレビン"],["の"],["木","き"],["の"],["かたわら"],["で"],["アブラハム"],["に"],["現われられた","あらわれられた"],["。"],["それ"],["は"],["昼","ひる"],["の"],["暑い","あつい"],["ころ"],["で"],["、"],["彼","かれ"],["は"],["天幕","てんまく"],["の"],["入口","いりぐち"],["に"],["すわって"],["いた"],["が"],["、"]]},{"verse":2,"text":"目,めを上,あげて見,みると、三人,にんの人,ひとが彼,かれに向,むかって立,たっていた。彼,かれはこれを見,みて、天幕,てんまくの入口,いりぐちから走,はしって行,いって彼,かれらを迎,むかえ、地,ちに身,みをかがめて、","tok":[["目","め"],["を"],["上げて","あげて"],["見る","みる"],["と"],["、"],["三人","にん"],["の"],["人","ひと"],["が"],["彼","かれ"],["に"],["向かって","むかって"],["立って","たって"],["いた"],["。"],["彼","かれ"],["は"],["これ"],["を"],["見て","みて"],["、"],["天幕","てんまく"],["の"],["入口","いりぐち"],["から"],["走って","はしって"],["行って","いって"],["彼","かれ"],["ら"],["を"],["迎","むかえ"],["、"],["地","ち"],["に"],["身","み"],["を"],["かがめて"],["、"]]},{"verse":3,"text":"言,いった、「わが主,しゅよ、もしわたしがあなたの前,まえに恵,めぐみを得,えているなら、どうぞしもべを通,とおり過,すごさないでください。","tok":[["言った","いった"],["、"],["「"],["わが"],["主","しゅ"],["よ"],["、"],["もし"],["わたし"],["が"],["あなた"],["の"],["前","まえ"],["に"],["恵","めぐみ"],["を"],["得て","えて"],["いるなら"],["、"],["どうぞ"],["しもべ"],["を"],["通り過ごさないで","とおりすごさないで"],["ください"],["。"]]},{"verse":4,"text":"水,みずをすこし取,とってこさせますから、あなたがたは足,あしを洗,あらって、この木,きの下,したでお休,やすみください。","tok":[["水","みず"],["を"],["すこし"],["取って","とって"],["こさせます"],["から"],["、"],["あなた"],["がた"],["は"],["足","あし"],["を"],["洗って","あらって"],["、"],["この"],["木","き"],["の"],["下","した"],["で"],["お休み","おやすみ"],["ください"],["。"]]},{"verse":5,"text":"わたしは一口,ひとくちのパンを取,とってきます。元気,げんきをつけて、それからお出,でかけください。せっかくしもべの所,ところにおいでになったのですから」。彼,かれらは言,いった、「お言葉,ことばどおりにしてください」。","tok":[["わたし"],["は"],["一口","ひとくち"],["の"],["パン"],["を"],["取って","とって"],["きます"],["。"],["元気","げんき"],["を"],["つけて"],["、"],["それ"],["から"],["お出かけ","おでかけ"],["ください"],["。"],["せっかく"],["しもべ"],["の"],["所","ところ"],["に"],["おいで"],["に"],["なった"],["の"],["です"],["から"],["」"],["。"],["彼","かれ"],["ら"],["は"],["言った","いった"],["、"],["「"],["お言葉","おことば"],["どおり"],["に"],["して"],["ください"],["」"],["。"]]},{"verse":6,"text":"そこでアブラハムは急,いそいで天幕,てんまくに入,いり、サラの所,ところに行,いって言,いった、「急,いそいで細,こまかい麦粉,むぎこ三セヤをとり、こねてパンを造,つくりなさい」。","tok":[["そこ"],["で"],["アブラハム"],["は"],["急いで","いそいで"],["天幕","てんまく"],["に"],["入","いり"],["、"],["サラ"],["の"],["所","ところ"],["に"],["行って","いって"],["言った","いった"],["、"],["「"],["急いで","いそいで"],["細かい","こまかい"],["麦粉","むぎこ"],["三","さん"],["セヤ"],["を"],["とり"],["、"],["こねて"],["パン"],["を"],["造","つくり"],["なさい"],["」"],["。"]]},{"verse":7,"text":"アブラハムは牛,うしの群,むれに走,はしって行,いき、柔,やわらかな良,よい子,こ牛,うしを取,とって若者,わかものに渡,わたしたので、急,いそいで調理,ちょうりした。","tok":[["アブラハム"],["は"],["牛","うし"],["の"],["群れ","むれ"],["に"],["走って","はしって"],["行き","いき"],["、"],["柔らか","やわらか"],["な"],["良い","よい"],["子牛","こうし"],["を"],["取って","とって"],["若者","わかもの"],["に"],["渡","わたし"],["た"],["ので"],["、"],["急いで","いそいで"],["調理","ちょうり"],["した"],["。"]]},{"verse":8,"text":"そしてアブラハムは凝乳,ぎょうにゅうと牛乳,ぎゅうにゅうおよび子,こ牛,うしの調理,ちょうりしたものを取,とって、彼,かれらの前,まえに供,そなえ、木,きの下,したで彼,かれらのかたわらに立,たって給仕,きゅうじし、彼,かれらは食事,しょくじした。","tok":[["そして"],["アブラハム"],["は"],["凝乳","ぎょうにゅう"],["と"],["牛乳","ぎゅうにゅう"],["および"],["子牛","こうし"],["の"],["調理","ちょうり"],["した"],["もの"],["を"],["取って","とって"],["、"],["彼","かれ"],["ら"],["の"],["前","まえ"],["に"],["供え","そなえ"],["、"],["木","き"],["の"],["下","した"],["で"],["彼","かれ"],["ら"],["の"],["かたわら"],["に"],["立って","たって"],["給仕","きゅうじ"],["し"],["、"],["彼","かれ"],["ら"],["は"],["食事","しょくじ"],["した"],["。"]]},{"verse":9,"text":"彼,かれらはアブラハムに言,いった、「あなたの妻,つまサラはどこにおられますか」。彼,かれは言,いった、「天幕,てんまくの中,なかです」。","tok":[["彼","かれ"],["ら"],["は"],["アブラハム"],["に"],["言った","いった"],["、"],["「"],["あなた"],["の"],["妻","つま"],["サラ"],["は"],["どこ"],["に"],["おられます"],["か"],["」"],["。"],["彼","かれ"],["は"],["言った","いった"],["、"],["「"],["天幕","てんまく"],["の"],["中","なか"],["です"],["」"],["。"]]},{"verse":10,"text":"そのひとりが言,いった、「来年,らいねんの春,はる、わたしはかならずあなたの所,ところに帰,かえってきましょう。その時,とき、あなたの妻,つまサラには男,おとこの子,こが生,うまれているでしょう」。サラはうしろの方,ほうの天幕,てんまくの入口,いりぐちで聞,きいていた。","tok":[["その"],["ひとり"],["が"],["言った","いった"],["、"],["「"],["来年","らいねん"],["の"],["春","はる"],["、"],["わたし"],["は"],["かならず"],["あなた"],["の"],["所","ところ"],["に"],["帰えって","かえって"],["きましょう"],["。"],["その"],["時","とき"],["、"],["あなた"],["の"],["妻","つま"],["サラ"],["に"],["は"],["男の子","おとこのこ"],["が"],["生まれて","うまれて"],["いるでしょう"],["」"],["。"],["サラ"],["は"],["うしろ"],["の"],["方","ほう"],["の"],["天幕","てんまく"],["の"],["入口","いりぐち"],["で"],["聞いて","きいて"],["いた"],["。"]]},{"verse":11,"text":"さてアブラハムとサラとは年,としがすすみ、老人,ろうじんとなり、サラは女,おんなの月,つきのものが、すでに止,とまっていた。","tok":[["さて"],["アブラハム"],["と"],["サラ"],["と"],["は"],["年","とし"],["が"],["すすみ"],["、"],["老人","ろうじん"],["と"],["なり"],["、"],["サラ"],["は"],["女","おんな"],["の"],["月","つき"],["の"],["もの"],["が"],["、"],["すでに"],["止まって","とまって"],["いた"],["。"]]},{"verse":12,"text":"それでサラは心,こころの中,なかで笑,わらって言,いった、「わたしは衰,おとろえ、主人,しゅじんもまた老人,ろうじんであるのに、わたしに楽,たのしみなどありえようか」。","tok":[["それ"],["で"],["サラ"],["は"],["心","こころ"],["の"],["中","なか"],["で"],["笑って","わらって"],["言った","いった"],["、"],["「"],["わたし"],["は"],["衰え","おとろえ"],["、"],["主人","しゅじん"],["も"],["また"],["老人","ろうじん"],["で"],["ある"],["のに"],["、"],["わたし"],["に"],["楽み","たのしみ"],["など"],["あり"],["えよう"],["か"],["」"],["。"]]},{"verse":13,"text":"主,しゅはアブラハムに言,いわれた、「なぜサラは、わたしは老人,ろうじんであるのに、どうして子,こを産,うむことができようかと言,いって笑,わらったのか。","tok":[["主","しゅ"],["は"],["アブラハム"],["に"],["言われた","いわれた"],["、"],["「"],["なぜ"],["サラ"],["は"],["、"],["わたし"],["は"],["老人","ろうじん"],["で"],["ある"],["のに"],["、"],["どう"],["して"],["子","こ"],["を"],["産む","うむ"],["こと"],["が"],["できよう"],["か"],["と"],["言って","いって"],["笑った","わらった"],["の"],["か"],["。"]]},{"verse":14,"text":"主,しゅにとって不可能,ふかのうなことがありましょうか。来年,らいねんの春,はる、定,さだめの時,ときに、わたしはあなたの所,ところに帰,かえってきます。そのときサラには男,おとこの子,こが生,うまれているでしょう」。","tok":[["主に","しゅに"],["とって"],["不可能","ふかのう"],["な"],["こと"],["が"],["ありましょう"],["か"],["。"],["来年","らいねん"],["の"],["春","はる"],["、"],["定め","さだめ"],["の"],["時","とき"],["に"],["、"],["わたし"],["は"],["あなた"],["の"],["所","ところ"],["に"],["帰えって","かえって"],["きます"],["。"],["その"],["とき"],["サラ"],["に"],["は"],["男の子","おとこのこ"],["が"],["生まれて","うまれて"],["いるでしょう"],["」"],["。"]]},{"verse":15,"text":"サラは恐,おそれたので、これを打,うち消,けして言,いった、「わたしは笑,わらいません」。主,しゅは言,いわれた、「いや、あなたは笑,わらいました」。","tok":[["サラ"],["は"],["恐れた","おそれた"],["ので"],["、"],["これ"],["を"],["打ち消して","うちけして"],["言った","いった"],["、"],["「"],["わたし"],["は"],["笑いません","わらいません"],["」"],["。"],["主","しゅ"],["は"],["言われた","いわれた"],["、"],["「"],["いや"],["、"],["あなた"],["は"],["笑","わらい"],["ました"],["」"],["。"]]},{"verse":16,"text":"その人々,ひとびとはそこを立,たってソドムの方,ほうに向,むかったので、アブラハムは彼,かれらを見送,みおくって共,ともに行,いった。","tok":[["その"],["人々","ひとびと"],["は"],["そこ"],["を"],["立って","たって"],["ソドム"],["の"],["方","ほう"],["に"],["向かった","むかった"],["ので"],["、"],["アブラハム"],["は"],["彼","かれ"],["ら"],["を"],["見送って","みおくって"],["共","とも"],["に"],["行った","いった"],["。"]]},{"verse":17,"text":"時,ときに主,しゅは言,いわれた、「わたしのしようとする事,ことをアブラハムに隠,かくしてよいであろうか。","tok":[["時","とき"],["に"],["主","しゅ"],["は"],["言われた","いわれた"],["、"],["「"],["わたし"],["の"],["しよう"],["と"],["する"],["事","こと"],["を"],["アブラハム"],["に"],["隠して","かくして"],["よいで"],["あろう"],["か"],["。"]]},{"verse":18,"text":"アブラハムは必,かならず大,おおきな強,つよい国民,こくみんとなって、地,ちのすべての民,たみがみな、彼,かれによって祝福,しゅくふくを受,うけるのではないか。","tok":[["アブラハム"],["は"],["必","かならず"],["大きな","おおきな"],["強い","つよい"],["国民","こくみん"],["と"],["なって"],["、"],["地","ち"],["の"],["すべて"],["の"],["民","たみ"],["が"],["みな"],["、"],["彼","かれ"],["によって"],["祝福","しゅくふく"],["を"],["受る","うける"],["ので"],["は"],["ない"],["か"],["。"]]},{"verse":19,"text":"わたしは彼,かれが後,のちの子,こらと家族,かぞくとに命,めいじて主,しゅの道,みちを守,まもらせ、正義,せいぎと公道,こうどうとを行,おこなわせるために彼,かれを知,しったのである。これは主,しゅがかつてアブラハムについて言,いった事,ことを彼,かれの上,うえに臨,のぞませるためである」。","tok":[["わたし"],["は"],["彼","かれ"],["が"],["後","のち"],["の"],["子","こ"],["ら"],["と"],["家族","かぞく"],["と"],["に"],["命じて","めいじて"],["主","しゅ"],["の"],["道","みち"],["を"],["守らせ","まもらせ"],["、"],["正義","せいぎ"],["と"],["公道","こうどう"],["と"],["を"],["行なわせる","おこなわせる"],["ため"],["に"],["彼","かれ"],["を"],["知った","しった"],["ので"],["ある"],["。"],["これ"],["は"],["主","しゅ"],["が"],["かつて"],["アブラハム"],["について"],["言った","いった"],["事","こと"],["を"],["彼","かれ"],["の"],["上","うえ"],["に"],["臨ませる","のぞませる"],["ため"],["で"],["ある"],["」"],["。"]]},{"verse":20,"text":"主,しゅはまた言,いわれた、「ソドムとゴモラの叫,さけびは大,おおきく、またその罪,つみは非常,ひじょうに重,おもいので、","tok":[["主","しゅ"],["は"],["また"],["言われた","いわれた"],["、"],["「"],["ソドム"],["と"],["ゴモラ"],["の"],["叫","さけび"],["は"],["大きく","おおきく"],["、"],["また"],["その"],["罪","つみ"],["は"],["非常","ひじょう"],["に"],["重い","おもい"],["ので"],["、"]]},{"verse":21,"text":"わたしはいま下,くだって、わたしに届,とどいた叫,さけびのとおりに、すべて彼,かれらがおこなっているかどうかを見,みて、それを知,しろう」。","tok":[["わたし"],["は"],["いま"],["下って","くだって"],["、"],["わたし"],["に"],["届いた","とどいた"],["叫","さけび"],["の"],["とおり"],["に"],["、"],["すべて"],["彼","かれ"],["ら"],["が"],["おこなって"],["いる"],["か"],["どう"],["か"],["を"],["見て","みて"],["、"],["それ"],["を"],["知ろう","しろう"],["」"],["。"]]},{"verse":22,"text":"その人々,ひとびとはそこから身,みを巡,めぐらしてソドムの方,ほうに行,いったが、アブラハムはなお、主,しゅの前,まえに立,たっていた。","tok":[["その"],["人々","ひとびと"],["は"],["そこ"],["から"],["身","み"],["を"],["巡らして","めぐらして"],["ソドム"],["の"],["方","ほう"],["に"],["行った","いった"],["が"],["、"],["アブラハム"],["は"],["なお"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["立って","たって"],["いた"],["。"]]},{"verse":23,"text":"アブラハムは近寄,ちかよって言,いった、「まことにあなたは正,ただしい者,ものを、悪,わるい者,ものと一緒,いっしょに滅,ほろぼされるのですか。","tok":[["アブラハム"],["は"],["近寄って","ちかよって"],["言った","いった"],["、"],["「"],["まこと"],["に"],["あなた"],["は"],["正い","ただしい"],["者","もの"],["を"],["、"],["悪い","わるい"],["者","もの"],["と"],["一緒","いっしょ"],["に"],["滅ぼされる","ほろぼされる"],["の"],["です"],["か"],["。"]]},{"verse":24,"text":"たとい、あの町,まちに五十人,にんの正,ただしい者,ものがあっても、あなたはなお、その所,ところを滅,ほろぼし、その中,なかにいる五十人,にんの正,ただしい者,もののためにこれをゆるされないのですか。","tok":[["たとい"],["、"],["あの"],["町","まち"],["に"],["五","ご"],["十人","じゅうにん"],["の"],["正い","ただしい"],["者","もの"],["が"],["あって"],["も"],["、"],["あなた"],["は"],["なお"],["、"],["その"],["所","ところ"],["を"],["滅ぼし","ほろぼし"],["、"],["その"],["中","なか"],["に"],["いる"],["五","ご"],["十人","じゅうにん"],["の"],["正い","ただしい"],["者","もの"],["の"],["ため"],["に"],["これ"],["を"],["ゆるされない"],["の"],["です"],["か"],["。"]]},{"verse":25,"text":"正,ただしい者,ものと悪,わるい者,ものとを一緒,いっしょに殺,ころすようなことを、あなたは決,けっしてなさらないでしょう。正,ただしい者,ものと悪,わるい者,ものとを同,おなじようにすることも、あなたは決,けっしてなさらないでしょう。全,ぜん地,ちをさばく者,ものは公義,こうぎを行,おこなうべきではありませんか」。","tok":[["正い","ただしい"],["者","もの"],["と"],["悪い","わるい"],["者","もの"],["と"],["を"],["一緒","いっしょ"],["に"],["殺ろす","ころす"],["よう"],["な"],["こと"],["を"],["、"],["あなた"],["は"],["決っして","けっして"],["なさらないでしょう"],["。"],["正い","ただしい"],["者","もの"],["と"],["悪い","わるい"],["者","もの"],["と"],["を"],["同じ","おなじ"],["よう"],["に"],["する"],["こと"],["も"],["、"],["あなた"],["は"],["決っして","けっして"],["なさらないでしょう"],["。"],["全地","ぜんち"],["を"],["さばく"],["者","もの"],["は"],["公義","こうぎ"],["を"],["行なうべきで","おこなうべきで"],["は"],["ありません"],["か"],["」"],["。"]]},{"verse":26,"text":"主,しゅは言,いわれた、「もしソドムで町,まちの中,なかに五十人,にんの正,ただしい者,ものがあったら、その人々,ひとびとのためにその所,ところをすべてゆるそう」。","tok":[["主","しゅ"],["は"],["言われた","いわれた"],["、"],["「"],["もし"],["ソドム"],["で"],["町","まち"],["の"],["中","なか"],["に"],["五","ご"],["十人","じゅうにん"],["の"],["正い","ただしい"],["者","もの"],["が"],["あったら"],["、"],["その"],["人々","ひとびと"],["の"],["ため"],["に"],["その"],["所","ところ"],["を"],["すべて"],["ゆる"],["そう"],["」"],["。"]]},{"verse":27,"text":"アブラハムは答,こたえて言,いった、「わたしはちり灰,はいに過,すぎませんが、あえてわが主,しゅに申,もうします。","tok":[["アブラハム"],["は"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["わたし"],["は"],["ちり"],["灰","はい"],["に"],["過ません","すぎません"],["が"],["、"],["あえて"],["わが"],["主に","しゅに"],["申します","もうします"],["。"]]},{"verse":28,"text":"もし五十人,にんの正,ただしい者,もののうち五人,にん欠,かけたなら、その五人,にん欠,かけたために町,まちを全,まったく滅,ほろぼされますか」。主,しゅは言,いわれた、「もしそこに四十五人,にんいたら、滅,ほろぼさないであろう」。","tok":[["もし"],["五","ご"],["十人","じゅうにん"],["の"],["正い","ただしい"],["者","もの"],["の"],["うち"],["五人","にん"],["欠けたなら","かけたなら"],["、"],["その"],["五人","にん"],["欠けた","かけた"],["ため"],["に"],["町","まち"],["を"],["全く","まったく"],["滅ぼされます","ほろぼされます"],["か"],["」"],["。"],["主","しゅ"],["は"],["言われた","いわれた"],["、"],["「"],["もし"],["そこ"],["に"],["四十五人","にんいた"],["ら"],["、"],["滅ぼさないで","ほろぼさないで"],["あろう"],["」"],["。"]]},{"verse":29,"text":"アブラハムはまた重,かさねて主,しゅに言,いった、「もしそこに四十人,にんいたら」。主,しゅは言,いわれた、「その四十人,にんのために、これをしないであろう」。","tok":[["アブラハム"],["は"],["また"],["重ねて","かさねて"],["主に","しゅに"],["言った","いった"],["、"],["「"],["もし"],["そこ"],["に"],["四","よん"],["十人","じゅうにん"],["ら"],["」"],["。"],["主","しゅ"],["は"],["言われた","いわれた"],["、"],["「"],["その"],["四","よん"],["十人","じゅうにん"],["の"],["ため"],["に"],["、"],["これ"],["を"],["しないで"],["あろう"],["」"],["。"]]},{"verse":30,"text":"アブラハムは言,いった、「わが主,しゅよ、どうかお怒,いかりにならぬよう。わたしは申,もうします。もしそこに三十人,にんいたら」。主,しゅは言,いわれた、「そこに三十人,にんいたら、これをしないであろう」。","tok":[["アブラハム"],["は"],["言った","いった"],["、"],["「"],["わが"],["主","しゅ"],["よ"],["、"],["どう"],["か"],["お怒り","おいかり"],["に"],["ならぬ"],["よう"],["。"],["わたし"],["は"],["申します","もうします"],["。"],["もし"],["そこ"],["に"],["三","さん"],["十人","じゅうにん"],["ら"],["」"],["。"],["主","しゅ"],["は"],["言われた","いわれた"],["、"],["「"],["そこ"],["に"],["三","さん"],["十人","じゅうにん"],["ら"],["、"],["これ"],["を"],["しないで"],["あろう"],["」"],["。"]]},{"verse":31,"text":"アブラハムは言,いった、「いまわたしはあえてわが主,しゅに申,もうします。もしそこに二十人,にんいたら」。主,しゅは言,いわれた、「わたしはその二十人,にんのために滅,ほろぼさないであろう」。","tok":[["アブラハム"],["は"],["言った","いった"],["、"],["「"],["いま"],["わたし"],["は"],["あえて"],["わが"],["主に","しゅに"],["申します","もうします"],["。"],["もし"],["そこ"],["に"],["二","に"],["十人","じゅうにん"],["ら"],["」"],["。"],["主","しゅ"],["は"],["言われた","いわれた"],["、"],["「"],["わたし"],["は"],["その"],["二","に"],["十人","じゅうにん"],["の"],["ため"],["に"],["滅ぼさないで","ほろぼさないで"],["あろう"],["」"],["。"]]},{"verse":32,"text":"アブラハムは言,いった、「わが主,しゅよ、どうかお怒,いかりにならぬよう。わたしはいま一度,ど申,もうします、もしそこに十人,にんいたら」。主,しゅは言,いわれた、「わたしはその十人,にんのために滅,ほろぼさないであろう」。","tok":[["アブラハム"],["は"],["言った","いった"],["、"],["「"],["わが"],["主","しゅ"],["よ"],["、"],["どう"],["か"],["お怒り","おいかり"],["に"],["ならぬ"],["よう"],["。"],["わたし"],["は"],["いま"],["一度","ど"],["申します","もうします"],["、"],["もし"],["そこ"],["に"],["十人","にんいた"],["ら"],["」"],["。"],["主","しゅ"],["は"],["言われた","いわれた"],["、"],["「"],["わたし"],["は"],["その"],["十人","にん"],["の"],["ため"],["に"],["滅ぼさないで","ほろぼさないで"],["あろう"],["」"],["。"]]},{"verse":33,"text":"主,しゅはアブラハムと語,かたり終,おわり、去,さって行,いかれた。アブラハムは自分,じぶんの所,ところに帰,かえった。","tok":[["主","しゅ"],["は"],["アブラハム"],["と"],["語り","かたり"],["終","おわり"],["、"],["去て","さって"],["行かれた","いかれた"],["。"],["アブラハム"],["は"],["自分","じぶん"],["の"],["所","ところ"],["に"],["帰えった","かえった"],["。"]]}]
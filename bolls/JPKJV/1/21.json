[{"verse":1,"text":"主,しゅは、さきに言,いわれたようにサラを顧,かえりみ、告,つげられたようにサラに行,おこなわれた。","tok":[["主","しゅ"],["は"],["、"],["さき"],["に"],["言われた","いわれた"],["よう"],["に"],["サラ"],["を"],["顧りみ","かえりみ"],["、"],["告げられた","つげられた"],["よう"],["に"],["サラ"],["に"],["行なわれた","おこなわれた"],["。"]]},{"verse":2,"text":"サラはみごもり、神,かみがアブラハムに告,つげられた時,ときになって、年老,としおいたアブラハムに男,おとこの子,こを産,うんだ。","tok":[["サラ"],["は"],["みごもり"],["、"],["神","かみ"],["が"],["アブラハム"],["に"],["告げられた","つげられた"],["時","とき"],["に"],["なって"],["、"],["年老いた","としおいた"],["アブラハム"],["に"],["男の子","おとこのこ"],["を"],["産んだ","うんだ"],["。"]]},{"verse":3,"text":"アブラハムは生,うまれた子,こ、サラが産,うんだ男,おとこの子,この名,なをイサクと名,なづけた。","tok":[["アブラハム"],["は"],["生まれた","うまれた"],["子","こ"],["、"],["サラ"],["が"],["産んだ","うんだ"],["男の子","おとこのこ"],["の"],["名","な"],["を"],["イサク"],["と"],["名づけた","なづけた"],["。"]]},{"verse":4,"text":"アブラハムは神,かみが命,めいじられたように八日,か目,めにその子,こイサクに割礼,かつれいを施,ほどこした。","tok":[["アブラハム"],["は"],["神","かみ"],["が"],["命じられた","めいじられた"],["よう"],["に"],["八日目","かめ"],["に"],["その"],["子","こ"],["イサク"],["に"],["割礼","かつれい"],["を"],["施した","ほどこした"],["。"]]},{"verse":5,"text":"アブラハムはその子,こイサクが生,うまれた時,とき百歳,さいであった。","tok":[["アブラハム"],["は"],["その"],["子","こ"],["イサク"],["が"],["生まれた","うまれた"],["時","とき"],["百歳","さ"],["いで"],["あった"],["。"]]},{"verse":6,"text":"そしてサラは言,いった、「神,かみはわたしを笑,わらわせてくださった。聞,きく者,ものは皆,みなわたしのことで笑,わらうでしょう」。","tok":[["そして"],["サラ"],["は"],["言った","いった"],["、"],["「"],["神","かみ"],["は"],["わたし"],["を"],["笑わせて","わらわせて"],["くださった"],["。"],["聞く","きく"],["者","もの"],["は"],["皆","みな"],["わたし"],["の"],["こと"],["で"],["笑うでしょう","わらうでしょう"],["」"],["。"]]},{"verse":7,"text":"また言,いった、「サラが子,こに乳,ちちを飲,のませるだろうと、だれがアブラハムに言,いい得,えたであろう。それなのに、わたしは彼,かれが年,としとってから、子,こを産,うんだ」。","tok":[["また"],["言った","いった"],["、"],["「"],["サラ"],["が"],["子","こ"],["に"],["乳","ちち"],["を"],["飲ませるだろう","のませるだろう"],["と"],["、"],["だれ"],["が"],["アブラハム"],["に"],["言い","いい"],["得たで","えたで"],["あろう"],["。"],["それ"],["な"],["のに"],["、"],["わたし"],["は"],["彼","かれ"],["が"],["年","とし"],["とって"],["から"],["、"],["子","こ"],["を"],["産んだ","うんだ"],["」"],["。"]]},{"verse":8,"text":"さて、おさなごは育,そだって乳離,ちばなれした。イサクが乳離,ちばなれした日,ひにアブラハムは盛,さかんなふるまいを設,もうけた。","tok":[["さて"],["、"],["おさな"],["ご"],["は"],["育って","そだって"],["乳離れ","ちばなれ"],["した"],["。"],["イサク"],["が"],["乳離れ","ちばなれ"],["した"],["日","ひ"],["に"],["アブラハム"],["は"],["盛","さかん"],["な"],["ふるまい"],["を"],["設けた","もうけた"],["。"]]},{"verse":9,"text":"サラはエジプトの女,おんなハガルのアブラハムに産,うんだ子,こが、自分,じぶんの子,こイサクと遊,あそぶのを見,みて、","tok":[["サラ"],["は"],["エジプト"],["の"],["女","おんな"],["ハガル"],["の"],["アブラハム"],["に"],["産んだ","うんだ"],["子","こ"],["が"],["、"],["自分","じぶん"],["の"],["子","こ"],["イサク"],["と"],["遊ぶ","あそぶ"],["の"],["を"],["見て","みて"],["、"]]},{"verse":10,"text":"アブラハムに言,いった、「このはしためとその子,こを追,おい出,だしてください。このはしための子,こはわたしの子,こイサクと共,ともに、世継,よつぎとなるべき者,ものではありません」。","tok":[["アブラハム"],["に"],["言った","いった"],["、"],["「"],["この"],["はし"],["ため"],["と"],["その"],["子","こ"],["を"],["追い出して","おいだして"],["ください"],["。"],["この"],["はし"],["ため"],["の"],["子","こ"],["は"],["わたし"],["の"],["子","こ"],["イサク"],["と"],["共","とも"],["に"],["、"],["世継","よつぎ"],["と"],["なるべき"],["者","もの"],["で"],["は"],["ありません"],["」"],["。"]]},{"verse":11,"text":"この事,ことで、アブラハムはその子,このために非常,ひじょうに心配,しんぱいした。","tok":[["この"],["事","こと"],["で"],["、"],["アブラハム"],["は"],["その"],["子","こ"],["の"],["ため"],["に"],["非常","ひじょう"],["に"],["心配","しんぱい"],["した"],["。"]]},{"verse":12,"text":"神,かみはアブラハムに言,いわれた、「あのわらべのため、またあなたのはしためのために心配,しんぱいすることはない。サラがあなたに言,いうことはすべて聞,ききいれなさい。イサクに生,うまれる者,ものが、あなたの子孫,しそんと唱,となえられるからです。","tok":[["神","かみ"],["は"],["アブラハム"],["に"],["言われた","いわれた"],["、"],["「"],["あの"],["わらべ"],["の"],["ため"],["、"],["また"],["あなた"],["の"],["はし"],["ため"],["の"],["ため"],["に"],["心配","しんぱい"],["する"],["こと"],["は"],["ない"],["。"],["サラ"],["が"],["あなた"],["に"],["言う","いう"],["こと"],["は"],["すべて"],["聞きいれ","ききいれ"],["なさい"],["。"],["イサク"],["に"],["生まれる","うまれる"],["者","もの"],["が"],["、"],["あなた"],["の"],["子孫","しそん"],["と"],["唱えられる","となえられる"],["から"],["です"],["。"]]},{"verse":13,"text":"しかし、はしための子,こもあなたの子,こですから、これをも、一つの国民,こくみんとします」。","tok":[["しかし"],["、"],["はし"],["ため"],["の"],["子","こ"],["も"],["あなた"],["の"],["子","こ"],["です"],["から"],["、"],["これ"],["を"],["も"],["、"],["一","ひと"],["つ"],["の"],["国民","こくみん"],["と"],["します"],["」"],["。"]]},{"verse":14,"text":"そこでアブラハムは明,あくる朝,あさはやく起,おきて、パンと水,みずの皮,かわ袋,ぶくろとを取,とり、ハガルに与,あたえて、肩,かたに負,おわせ、その子,こを連,つれて去,さらせた。ハガルは去,さってベエルシバの荒野,あらのにさまよった。","tok":[["そこ"],["で"],["アブラハム"],["は"],["明くる","あくる"],["朝","あさ"],["はやく"],["起きて","おきて"],["、"],["パン"],["と"],["水","みず"],["の"],["皮袋","かわぶくろ"],["と"],["を"],["取","とり"],["、"],["ハガル"],["に"],["与","あたえ"],["て"],["、"],["肩","かた"],["に"],["負わせ","おわせ"],["、"],["その"],["子","こ"],["を"],["連れて","つれて"],["去らせた","さらせた"],["。"],["ハガル"],["は"],["去て","さって"],["ベエルシバ"],["の"],["荒野","あらの"],["に"],["さまよった"],["。"]]},{"verse":15,"text":"やがて皮,かわ袋,ぶくろの水,みずが尽,つきたので、彼女,かのじょはその子,こを木,きの下,したにおき、","tok":[["やがて"],["皮袋","かわぶくろ"],["の"],["水","みず"],["が"],["尽た","つきた"],["ので"],["、"],["彼女","かのじょ"],["は"],["その"],["子","こ"],["を"],["木","き"],["の"],["下","した"],["に"],["おき"],["、"]]},{"verse":16,"text":"「わたしはこの子,この死,しぬのを見,みるに忍,しのびない」と言,いって、矢,やの届,とどくほど離,はなれて行,いき、子供,こどもの方,ほうに向,むいてすわった。彼女,かのじょが子供,こどもの方,ほうに向,むいてすわったとき、子供,こどもは声,こえをあげて泣,ないた。","tok":[["「"],["わたし"],["は"],["この"],["子","こ"],["の"],["死ぬ","しぬ"],["の"],["を"],["見る","みる"],["に"],["忍びない","しのびない"],["」"],["と"],["言って","いって"],["、"],["矢","や"],["の"],["届く","とどく"],["ほど"],["離れて","はなれて"],["行き","いき"],["、"],["子供","こども"],["の"],["方","ほう"],["に"],["向いて","むいて"],["すわった"],["。"],["彼女","かのじょ"],["が"],["子供","こども"],["の"],["方","ほう"],["に"],["向いて","むいて"],["すわった"],["とき"],["、"],["子供","こども"],["は"],["声","こえ"],["を"],["あげて"],["泣いた","ないた"],["。"]]},{"verse":17,"text":"神,かみはわらべの声,こえを聞,きかれ、神,かみの使,つかいは天,てんからハガルを呼,よんで言,いった、「ハガルよ、どうしたのか。恐,おそれてはいけない。神,かみはあそこにいるわらべの声,こえを聞,きかれた。","tok":[["神","かみ"],["は"],["わらべ"],["の"],["声","こえ"],["を"],["聞かれ","きかれ"],["、"],["神","かみ"],["の"],["使い","つかい"],["は"],["天","てん"],["から"],["ハガル"],["を"],["呼んで","よんで"],["言った","いった"],["、"],["「"],["ハガル"],["よ"],["、"],["どう"],["した"],["の"],["か"],["。"],["恐れて","おそれて"],["は"],["いけない"],["。"],["神","かみ"],["は"],["あそこ"],["に"],["いる"],["わらべ"],["の"],["声","こえ"],["を"],["聞かれた","きかれた"],["。"]]},{"verse":18,"text":"立,たって行,いき、わらべを取,とり上,あげてあなたの手,てに抱,だきなさい。わたしは彼,かれを大,おおいなる国民,こくみんとするであろう」。","tok":[["立って","たって"],["行き","いき"],["、"],["わらべ"],["を"],["取上","とりあげ"],["て"],["あなた"],["の"],["手","て"],["に"],["抱き","だき"],["なさい"],["。"],["わたし"],["は"],["彼","かれ"],["を"],["大いなる","おおいなる"],["国民","こくみん"],["と"],["するで"],["あろう"],["」"],["。"]]},{"verse":19,"text":"神,かみがハガルの目,めを開,ひらかれたので、彼女,かのじょは水,みずの井戸,いどのあるのを見,みた。彼女,かのじょは行,いって皮,かわ袋,ぶくろに水,みずを満,みたし、わらべに飲,のませた。","tok":[["神","かみ"],["が"],["ハガル"],["の"],["目","め"],["を"],["開らかれた","ひらかれた"],["ので"],["、"],["彼女","かのじょ"],["は"],["水","みず"],["の"],["井戸","いど"],["の"],["ある"],["の"],["を"],["見た","みた"],["。"],["彼女","かのじょ"],["は"],["行って","いって"],["皮袋","かわぶくろ"],["に"],["水","みず"],["を"],["満たし","みたし"],["、"],["わらべ"],["に"],["飲ませた","のませた"],["。"]]},{"verse":20,"text":"神,かみはわらべと共,ともにいまし、わらべは成長,せいちょうした。彼,かれは荒野,あらのに住,すんで弓,ゆみを射,いる者,ものとなった。","tok":[["神","かみ"],["は"],["わらべ"],["と"],["共","とも"],["に"],["いまし"],["、"],["わらべ"],["は"],["成長","せいちょう"],["した"],["。"],["彼","かれ"],["は"],["荒野","あら"],["のに"],["住んで","すんで"],["弓","ゆみ"],["を"],["射る","いる"],["者","もの"],["と"],["なった"],["。"]]},{"verse":21,"text":"彼,かれはパランの荒野,あらのに住,すんだ。母,ははは彼,かれのためにエジプトの国,くにから妻,つまを迎,むかえた。","tok":[["彼","かれ"],["は"],["パラン"],["の"],["荒野","あらの"],["に"],["住んだ","すんだ"],["。"],["母","はは"],["は"],["彼","かれ"],["の"],["ため"],["に"],["エジプト"],["の"],["国","くに"],["から"],["妻","つま"],["を"],["迎","むかえ"],["た"],["。"]]},{"verse":22,"text":"そのころアビメレクとその軍勢,ぐんぜいの長,ちょうピコルはアブラハムに言,いった、「あなたが何事,なにごとをなさっても、神,かみはあなたと共,ともにおられる。","tok":[["その"],["ころ"],["アビメレク"],["と"],["その"],["軍勢","ぐんぜい"],["の"],["長う","ちょう"],["ピコル"],["は"],["アブラハム"],["に"],["言った","いった"],["、"],["「"],["あなた"],["が"],["何事","なにごと"],["を"],["なさって"],["も"],["、"],["神","かみ"],["は"],["あなた"],["と"],["共","とも"],["に"],["おられる"],["。"]]},{"verse":23,"text":"それゆえ、今,いまここでわたしをも、わたしの子,こをも、孫,まごをも欺,あざむかないと、神,かみをさしてわたしに誓,ちかってください。わたしがあなたに親切,しんせつにしたように、あなたもわたしと、このあなたの寄留,きりゅうの地,ちとに、しなければなりません」。","tok":[["それ"],["ゆえ"],["、"],["今","いま"],["ここ"],["で"],["わたし"],["を"],["も"],["、"],["わたし"],["の"],["子","こ"],["を"],["も"],["、"],["孫","まご"],["を"],["も"],["欺かない","あざむかない"],["と"],["、"],["神","かみ"],["を"],["さして"],["わたし"],["に"],["誓って","ちかって"],["ください"],["。"],["わたし"],["が"],["あなた"],["に"],["親切","しんせつ"],["に"],["した"],["よう"],["に"],["、"],["あなた"],["も"],["わたし"],["と"],["、"],["この"],["あなた"],["の"],["寄留","きりゅう"],["の"],["地","ち"],["と"],["に"],["、"],["しなければ"],["なりません"],["」"],["。"]]},{"verse":24,"text":"アブラハムは言,いった、「わたしは誓,ちかいます」。","tok":[["アブラハム"],["は"],["言った","いった"],["、"],["「"],["わたし"],["は"],["誓います","ちかいます"],["」"],["。"]]},{"verse":25,"text":"アブラハムはアビメレクの家来,けらいたちが、水,みずの井戸,いどを奪,うばい取,とったことについてアビメルクを責,せめた。","tok":[["アブラハム"],["は"],["アビメレク"],["の"],["家来","けらい"],["たち"],["が"],["、"],["水","みず"],["の"],["井戸","いど"],["を"],["奪い取った","うばいとった"],["こと"],["について"],["アビメルク"],["を"],["責","せめ"],["た"],["。"]]},{"verse":26,"text":"しかしアビメレクは言,いった、「だれがこの事,ことをしたかわたしは知,しりません。あなたもわたしに告,つげたことはなく、わたしもきょうまで聞,ききませんでした」。","tok":[["しかし"],["アビメレク"],["は"],["言った","いった"],["、"],["「"],["だれ"],["が"],["この"],["事","こと"],["を"],["した"],["か"],["わたし"],["は"],["知りません","しりません"],["。"],["あなた"],["も"],["わたし"],["に"],["告","つげ"],["た"],["こと"],["は"],["なく"],["、"],["わたし"],["も"],["きょう"],["まで"],["聞","きき"],["ませんでした"],["」"],["。"]]},{"verse":27,"text":"そこでアブラハムは羊,ひつじと牛,うしとを取,とってアビメレクに与,あたえ、ふたりは契約,けいやくを結,むすんだ。","tok":[["そこ"],["で"],["アブラハム"],["は"],["羊","ひつじ"],["と"],["牛","うし"],["と"],["を"],["取って","とって"],["アビメレク"],["に"],["与","あたえ"],["、"],["ふたり"],["は"],["契約","けいやく"],["を"],["結んだ","むすんだ"],["。"]]},{"verse":28,"text":"アブラハムが雌,めすの小羊,こひつじ七頭,とうを分,わけて置,おいたところ、","tok":[["アブラハム"],["が"],["雌","めす"],["の"],["小羊","こひつじ"],["七頭","とう"],["を"],["分けて","わけて"],["置いた","おいた"],["ところ"],["、"]]},{"verse":29,"text":"アビメレクはアブラハムに言,いった、「あなたがこれらの雌,めすの小羊,こひつじ七頭,とうを分,わけて置,おいたのは、なんのためですか」。","tok":[["アビメレク"],["は"],["アブラハム"],["に"],["言った","いった"],["、"],["「"],["あなた"],["が"],["これ"],["ら"],["の"],["雌","めす"],["の"],["小羊","こひつじ"],["七頭","とう"],["を"],["分けて","わけて"],["置いた","おいた"],["の"],["は"],["、"],["なん"],["の"],["ため"],["です"],["か"],["」"],["。"]]},{"verse":30,"text":"アブラハムは言,いった、「あなたはわたしの手,てからこれらの雌,めすの小羊,こひつじ七頭,とうを受,うけ取,とって、わたしがこの井戸,いどを掘,ほったことの証拠,しょうことしてください」。","tok":[["アブラハム"],["は"],["言った","いった"],["、"],["「"],["あなた"],["は"],["わたし"],["の"],["手","て"],["から"],["これ"],["ら"],["の"],["雌","めす"],["の"],["小羊","こひつじ"],["七頭","とう"],["を"],["受け取って","うけとって"],["、"],["わたし"],["が"],["この"],["井戸","いど"],["を"],["掘った","ほった"],["こと"],["の"],["証拠","しょうこ"],["として"],["ください"],["」"],["。"]]},{"verse":31,"text":"これによってその所,ところをベエルシバと名,なづけた。彼,かれらがふたりそこで誓,ちかいをしたからである。","tok":[["これ"],["によって"],["その"],["所","ところ"],["を"],["ベエルシバ"],["と"],["名づけた","なづけた"],["。"],["彼","かれ"],["ら"],["が"],["ふたり"],["そこ"],["で"],["誓い","ちかい"],["を"],["した"],["から"],["で"],["ある"],["。"]]},{"verse":32,"text":"このように彼,かれらはベエルシバで契約,けいやくを結,むすび、アビメレクとその軍勢,ぐんぜいの長,ちょうピコルは立,たってペリシテの地,ちに帰,かえった。","tok":[["この"],["よう"],["に"],["彼","かれ"],["ら"],["は"],["ベエルシバ"],["で"],["契約","けいやく"],["を"],["結び","むすび"],["、"],["アビメレク"],["と"],["その"],["軍勢","ぐんぜい"],["の"],["長う","ちょう"],["ピコル"],["は"],["立って","たって"],["ペリシテ"],["の"],["地","ち"],["に"],["帰えった","かえった"],["。"]]},{"verse":33,"text":"アブラハムはベエルシバに一本,ぽんのぎょりゅうの木,きを植,うえ、その所,ところで永遠,えいえんの神,かみ、主,しゅの名,なを呼,よんだ。","tok":[["アブラハム"],["は"],["ベエルシバ"],["に"],["一本","ぽんのぎょりゅう"],["の"],["木","き"],["を"],["植え","うえ"],["、"],["その"],["所","ところ"],["で"],["永遠","えいえん"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["名","な"],["を"],["呼んだ","よんだ"],["。"]]},{"verse":34,"text":"こうしてアブラハムは長,ながい間,あいだペリシテびとの地,ちにとどまった。","tok":[["こう"],["して"],["アブラハム"],["は"],["長い","ながい"],["間","あいだ"],["ペリシテ"],["びと"],["の"],["地","ち"],["に"],["とどまった"],["。"]]}]
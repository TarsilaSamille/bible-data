[{"verse":1,"text":"アブラムは妻,つまとすべての持,もち物,ものを携,たずさえ、エジプトを出,でて、ネゲブに上,のぼった。ロトも彼,かれと共,ともに上,のぼった。","tok":[["アブラム"],["は"],["妻","つま"],["と"],["すべて"],["の"],["持物","もちもの"],["を"],["携え","たずさえ"],["、"],["エジプト"],["を"],["出て","でて"],["、"],["ネゲブ"],["に"],["上った","のぼった"],["。"],["ロト"],["も"],["彼","かれ"],["と"],["共","とも"],["に"],["上った","のぼった"],["。"]]},{"verse":2,"text":"アブラムは家畜,かちくと金銀,きんぎんに非常,ひじょうに富,とんでいた。","tok":[["アブラム"],["は"],["家畜","かちく"],["と"],["金銀","きんぎん"],["に"],["非常","ひじょう"],["に"],["富んで","とんで"],["いた"],["。"]]},{"verse":3,"text":"彼,かれはネゲブから旅路,たびじを進,すすめてベテルに向,むかい、ベテルとアイの間,あいだの、さきに天幕,てんまくを張,はった所,ところに行,いった。","tok":[["彼","かれ"],["は"],["ネゲブ"],["から"],["旅路","たびじ"],["を"],["進めて","すすめて"],["ベテル"],["に"],["向","むかい"],["、"],["ベテル"],["と"],["アイ"],["の"],["間","あいだ"],["の"],["、"],["さき"],["に"],["天幕","てんまく"],["を"],["張った","はった"],["所","ところ"],["に"],["行った","いった"],["。"]]},{"verse":4,"text":"すなわち彼,かれが初,はじめに築,きずいた祭壇,さいだんの所,ところに行,いき、その所,ところでアブラムは主,しゅの名,なを呼,よんだ。","tok":[["すなわち"],["彼","かれ"],["が"],["初め","はじめ"],["に"],["築いた","きずいた"],["祭壇","さいだん"],["の"],["所","ところ"],["に"],["行き","いき"],["、"],["その"],["所","ところ"],["で"],["アブラム"],["は"],["主","しゅ"],["の"],["名","な"],["を"],["呼んだ","よんだ"],["。"]]},{"verse":5,"text":"アブラムと共,ともに行,いったロトも羊,ひつじ、牛,うしおよび天幕,てんまくを持,もっていた。","tok":[["アブラム"],["と"],["共","とも"],["に"],["行った","いった"],["ロト"],["も"],["羊","ひつじ"],["、"],["牛","うし"],["および"],["天幕","てんまく"],["を"],["持って","もって"],["いた"],["。"]]},{"verse":6,"text":"その地,ちは彼,かれらをささえて共,ともに住,すませることができなかった。彼,かれらの財産,ざいさんが多,おおかったため、共,ともに住,すめなかったのである。","tok":[["その"],["地","ち"],["は"],["彼","かれ"],["ら"],["を"],["ささえて"],["共","とも"],["に"],["住ませる","すませる"],["こと"],["が"],["できなかった"],["。"],["彼","かれ"],["ら"],["の"],["財産","ざいさん"],["が"],["多かった","おおかった"],["ため"],["、"],["共","とも"],["に"],["住めなかった","すめなかった"],["ので"],["ある"],["。"]]},{"verse":7,"text":"アブラムの家畜,かちくの牧者,ぼくしゃたちとロトの家畜,かちくの牧者,ぼくしゃたちの間,あいだに争,あらそいがあった。そのころカナンびととペリジびとがその地,ちに住,すんでいた。","tok":[["アブラム"],["の"],["家畜","かちく"],["の"],["牧者","ぼくしゃ"],["たち"],["と"],["ロト"],["の"],["家畜","かちく"],["の"],["牧者","ぼくしゃ"],["たち"],["の"],["間","あいだ"],["に"],["争い","あらそい"],["が"],["あった"],["。"],["その"],["ころ"],["カナン"],["びと"],["と"],["ペリジ"],["びと"],["が"],["その"],["地","ち"],["に"],["住んで","すんで"],["いた"],["。"]]},{"verse":8,"text":"アブラムはロトに言,いった、「わたしたちは身内,みうちの者,ものです。わたしとあなたの間,あいだにも、わたしの牧者,ぼくしゃたちとあなたの牧者,ぼくしゃたちの間,あいだにも争,あらそいがないようにしましょう。","tok":[["アブラム"],["は"],["ロト"],["に"],["言った","いった"],["、"],["「"],["わたしたち"],["は"],["身内","みうち"],["の"],["者","もの"],["です"],["。"],["わたし"],["と"],["あなた"],["の"],["間","あいだ"],["に"],["も"],["、"],["わたし"],["の"],["牧者","ぼくしゃ"],["たち"],["と"],["あなた"],["の"],["牧者","ぼくしゃ"],["たち"],["の"],["間","あいだ"],["に"],["も"],["争い","あらそい"],["が"],["ない"],["よう"],["に"],["しましょう"],["。"]]},{"verse":9,"text":"全,ぜん地,ちはあなたの前,まえにあるではありませんか。どうかわたしと別,わかれてください。あなたが左,ひだりに行,いけばわたしは右,みぎに行,いきます。あなたが右,みぎに行,いけばわたしは左,ひだりに行,いきましょう」。","tok":[["全地","ぜんち"],["は"],["あなた"],["の"],["前","まえ"],["に"],["ある"],["で"],["は"],["ありません"],["か"],["。"],["どう"],["か"],["わたし"],["と"],["別かれて","わかれて"],["ください"],["。"],["あなた"],["が"],["左","ひだり"],["に"],["行けば","いけば"],["わたし"],["は"],["右","みぎ"],["に"],["行きます","いきます"],["。"],["あなた"],["が"],["右","みぎ"],["に"],["行けば","いけば"],["わたし"],["は"],["左","ひだり"],["に"],["行きましょう","いきましょう"],["」"],["。"]]},{"verse":10,"text":"ロトが目,めを上,あげてヨルダンの低地,ていちをあまねく見,みわたすと、主,しゅがソドムとゴモラを滅,ほろぼされる前,まえであったから、ゾアルまで主,しゅの園,そののように、またエジプトの地,ちのように、すみずみまでよく潤,うるおっていた。","tok":[["ロト"],["が"],["目","め"],["を"],["上げて","あげて"],["ヨルダン"],["の"],["低地","ていち"],["を"],["あまねく"],["見わたす","みわたす"],["と"],["、"],["主","しゅ"],["が"],["ソドム"],["と"],["ゴモラ"],["を"],["滅ぼされる","ほろぼされる"],["前","まえ"],["で"],["あった"],["から"],["、"],["ゾアル"],["まで"],["主","しゅ"],["の"],["園","その"],["の"],["よう"],["に"],["、"],["また"],["エジプト"],["の"],["地","ち"],["の"],["よう"],["に"],["、"],["すみずみ"],["まで"],["よく"],["潤って","うるおって"],["いた"],["。"]]},{"verse":11,"text":"そこでロトはヨルダンの低地,ていちをことごとく選,えらびとって東,ひがしに移,うつった。こうして彼,かれらは互,たがいに別,わかれた。","tok":[["そこ"],["で"],["ロト"],["は"],["ヨルダン"],["の"],["低地","ていち"],["を"],["ことごとく"],["選ら","えら"],["び"],["とって"],["東","ひがし"],["に"],["移った","うつった"],["。"],["こう"],["して"],["彼","かれ"],["ら"],["は"],["互","たがい"],["に"],["別かれた","わかれた"],["。"]]},{"verse":12,"text":"アブラムはカナンの地,ちに住,すんだが、ロトは低地,ていちの町々,まちまちに住,すみ、天幕,てんまくをソドムに移,うつした。","tok":[["アブラム"],["は"],["カナン"],["の"],["地","ち"],["に"],["住んだ","すんだ"],["が"],["、"],["ロト"],["は"],["低地","ていち"],["の"],["町々","まちまち"],["に"],["住み","すみ"],["、"],["天幕","てんまく"],["を"],["ソドム"],["に"],["移した","うつした"],["。"]]},{"verse":13,"text":"ソドムの人々,ひとびとはわるく、主,しゅに対,たいして、はなはだしい罪,つみびとであった。","tok":[["ソドム"],["の"],["人々","ひとびと"],["は"],["わるく"],["、"],["主に","しゅに"],["対して","たいして"],["、"],["はなはだしい"],["罪びと","つみびと"],["で"],["あった"],["。"]]},{"verse":14,"text":"ロトがアブラムに別,わかれた後,のちに、主,しゅはアブラムに言,いわれた、「目,めをあげてあなたのいる所,ところから北,きた、南,みなみ、東,ひがし、西,にしを見,みわたしなさい。","tok":[["ロト"],["が"],["アブラム"],["に"],["別かれた","わかれた"],["後","のち"],["に"],["、"],["主","しゅ"],["は"],["アブラム"],["に"],["言われた","いわれた"],["、"],["「"],["目","め"],["を"],["あげて"],["あなた"],["の"],["いる"],["所","ところ"],["から"],["北","きた"],["、"],["南","みなみ"],["、"],["東","ひがし"],["、"],["西","にし"],["を"],["見わたし","みわたし"],["なさい"],["。"]]},{"verse":15,"text":"すべてあなたが見,みわたす地,ちは、永久,えいきゅうにあなたとあなたの子孫,しそんに与,あたえます。","tok":[["すべて"],["あなた"],["が"],["見わたす","みわたす"],["地","ち"],["は"],["、"],["永久","えいきゅう"],["に"],["あなた"],["と"],["あなた"],["の"],["子孫","しそん"],["に"],["与えます","あたえます"],["。"]]},{"verse":16,"text":"わたしはあなたの子孫,しそんを地,ちのちりのように多,おおくします。もし人,ひとが地,ちのちりを数,かぞえることができるなら、あなたの子孫,しそんも数,かぞえられることができましょう。","tok":[["わたし"],["は"],["あなた"],["の"],["子孫","しそん"],["を"],["地","ち"],["の"],["ちり"],["の"],["よう"],["に"],["多く","おおく"],["します"],["。"],["もし"],["人","ひと"],["が"],["地","ち"],["の"],["ちり"],["を"],["数える","かぞえる"],["こと"],["が"],["できるなら"],["、"],["あなた"],["の"],["子孫","しそん"],["も"],["数えられる","かぞえられる"],["こと"],["が"],["できましょう"],["。"]]},{"verse":17,"text":"あなたは立,たって、その地,ちをたてよこに行,いき巡,めぐりなさい。わたしはそれをあなたに与,あたえます」。","tok":[["あなた"],["は"],["立って","たって"],["、"],["その"],["地","ち"],["を"],["たてよこ"],["に"],["行き","いき"],["巡り","めぐり"],["なさい"],["。"],["わたし"],["は"],["それ"],["を"],["あなた"],["に"],["与えます","あたえます"],["」"],["。"]]},{"verse":18,"text":"アブラムは天幕,てんまくを移,うつしてヘブロンにあるマムレのテレビンの木,きのかたわらに住,すみ、その所,ところで主,しゅに祭壇,さいだんを築,きずいた。","tok":[["アブラム"],["は"],["天幕","てんまく"],["を"],["移して","うつして"],["ヘブロン"],["に"],["ある"],["マムレ"],["の"],["テレビン"],["の"],["木","き"],["の"],["かたわら"],["に"],["住み","すみ"],["、"],["その"],["所","ところ"],["で"],["主に","しゅに"],["祭壇","さいだん"],["を"],["築いた","きずいた"],["。"]]}]
[{"verse":1,"text":"全,ぜん地,ちは同,おなじ発音,はつおん、同,おなじ言葉,ことばであった。","tok":[["全地","ぜんち"],["は"],["同じ","おなじ"],["発音","はつおん"],["、"],["同じ","おなじ"],["言葉","ことば"],["で"],["あった"],["。"]]},{"verse":2,"text":"時,ときに人々,ひとびとは東,ひがしに移,うつり、シナルの地,ちに平野,へいやを得,えて、そこに住,すんだ。","tok":[["時","とき"],["に"],["人々","ひとびと"],["は"],["東","ひがし"],["に"],["移り","うつり"],["、"],["シナル"],["の"],["地","ち"],["に"],["平野","へいや"],["を"],["得て","えて"],["、"],["そこ"],["に"],["住んだ","すんだ"],["。"]]},{"verse":3,"text":"彼,かれらは互,たがいに言,いった、「さあ、れんがを造,つくって、よく焼,やこう」。こうして彼,かれらは石,いしの代,かわりに、れんがを得,え、しっくいの代,かわりに、アスファルトを得,えた。","tok":[["彼","かれ"],["ら"],["は"],["互","たがい"],["に"],["言った","いった"],["、"],["「"],["さあ"],["、"],["れんが"],["を"],["造って","つくって"],["、"],["よく"],["焼こう","やこう"],["」"],["。"],["こう"],["して"],["彼","かれ"],["ら"],["は"],["石","いし"],["の"],["代わり","かわり"],["に"],["、"],["れんが"],["を"],["得","え"],["、"],["しっくい"],["の"],["代わり","かわり"],["に"],["、"],["アスファルト"],["を"],["得た","えた"],["。"]]},{"verse":4,"text":"彼,かれらはまた言,いった、「さあ、町,まちと塔,とうとを建,たてて、その頂,いただきを天,てんに届,とどかせよう。そしてわれわれは名,なを上,あげて、全,ぜん地,ちのおもてに散,ちるのを免,まぬかれよう」。","tok":[["彼","かれ"],["ら"],["は"],["また"],["言った","いった"],["、"],["「"],["さあ"],["、"],["町","まち"],["と"],["塔","とう"],["と"],["を"],["建てて","たてて"],["、"],["その"],["頂","いただき"],["を"],["天","てん"],["に"],["届かせよう","とどかせよう"],["。"],["そして"],["われわれ"],["は"],["名","な"],["を"],["上げて","あげて"],["、"],["全地","ぜんち"],["の"],["おもて"],["に"],["散る","ちる"],["の"],["を"],["免かれよう","まぬかれよう"],["」"],["。"]]},{"verse":5,"text":"時,ときに主,しゅは下,くだって、人,ひとの子,こたちの建,たてる町,まちと塔,とうとを見,みて、","tok":[["時","とき"],["に"],["主","しゅ"],["は"],["下って","くだって"],["、"],["人","ひと"],["の"],["子","こ"],["たち"],["の"],["建てる","たてる"],["町","まち"],["と"],["塔","とう"],["と"],["を"],["見て","みて"],["、"]]},{"verse":6,"text":"言,いわれた、「民,たみは一つで、みな同,おなじ言葉,ことばである。彼,かれらはすでにこの事,ことをしはじめた。彼,かれらがしようとする事,ことは、もはや何事,なにごともとどめ得,えないであろう。","tok":[["言われた","いわれた"],["、"],["「"],["民","たみ"],["は"],["一","ひと"],["つ"],["で"],["、"],["みな"],["同じ","おなじ"],["言葉","ことば"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["すでに"],["この"],["事","こと"],["を"],["し"],["はじめた"],["。"],["彼","かれ"],["ら"],["が"],["しよう"],["と"],["する"],["事","こと"],["は"],["、"],["もはや"],["何事","なにごと"],["も"],["とどめ"],["得ないで","えないで"],["あろう"],["。"]]},{"verse":7,"text":"さあ、われわれは下,くだって行,いって、そこで彼,かれらの言葉,ことばを乱,みだし、互,たがいに言葉,ことばが通,つうじないようにしよう」。","tok":[["さあ"],["、"],["われわれ"],["は"],["下って","くだって"],["行って","いって"],["、"],["そこ"],["で"],["彼","かれ"],["ら"],["の"],["言葉","ことば"],["を"],["乱し","みだし"],["、"],["互","たがい"],["に"],["言葉","ことば"],["が"],["通じない","つうじない"],["よう"],["に"],["しよう"],["」"],["。"]]},{"verse":8,"text":"こうして主,しゅが彼,かれらをそこから全,ぜん地,ちのおもてに散,ちらされたので、彼,かれらは町,まちを建,たてるのをやめた。","tok":[["こう"],["して"],["主","しゅ"],["が"],["彼","かれ"],["ら"],["を"],["そこ"],["から"],["全地","ぜんち"],["の"],["おもて"],["に"],["散らされた","ちらされた"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["町","まち"],["を"],["建てる","たてる"],["の"],["を"],["やめた"],["。"]]},{"verse":9,"text":"これによってその町,まちの名,なはバベルと呼,よばれた。主,しゅがそこで全,ぜん地,ちの言葉,ことばを乱,みだされたからである。主,しゅはそこから彼,かれらを全,ぜん地,ちのおもてに散,ちらされた。","tok":[["これ"],["によって"],["その"],["町","まち"],["の"],["名","な"],["は"],["バベル"],["と"],["呼ばれた","よばれた"],["。"],["主","しゅ"],["が"],["そこ"],["で"],["全地","ぜんち"],["の"],["言葉","ことば"],["を"],["乱された","みだされた"],["から"],["で"],["ある"],["。"],["主","しゅ"],["は"],["そこ"],["から"],["彼","かれ"],["ら"],["を"],["全地","ぜんち"],["の"],["おもて"],["に"],["散らされた","ちらされた"],["。"]]},{"verse":10,"text":"セムの系図,けいずは次,つぎのとおりである。セムは百歳,さいになって洪水,こうずいの二年,ねんの後,のちにアルパクサデを生,うんだ。","tok":[["セム"],["の"],["系図","けいず"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["セム"],["は"],["百歳","さい"],["に"],["なって"],["洪水","こうずい"],["の"],["二","に"],["年","ねん"],["の"],["後","のち"],["に"],["アルパクサデ"],["を"],["生んだ","うんだ"],["。"]]},{"verse":11,"text":"セムはアルパクサデを生,うんで後,のち、五百年,ねん生,いきて、男子,だんしと女子,じょしを生,うんだ。","tok":[["セム"],["は"],["アルパクサデ"],["を"],["生んで","うんで"],["後","の"],["ち"],["、"],["五百","ごひゃく"],["年","ねん"],["生きて","いきて"],["、"],["男子","だんし"],["と"],["女子","じょし"],["を"],["生んだ","うんだ"],["。"]]},{"verse":12,"text":"アルパクサデは三十五歳,さいになってシラを生,うんだ。","tok":[["アルパクサデ"],["は"],["三十五歳","さい"],["に"],["なって"],["シラ"],["を"],["生んだ","うんだ"],["。"]]},{"verse":13,"text":"アルパクサデはシラを生,うんで後,のち、四百三年,ねん生,いきて、男子,だんしと女子,じょしを生,うんだ。","tok":[["アルパクサデ"],["は"],["シラ"],["を"],["生んで","うんで"],["後","の"],["ち"],["、"],["四百三","よんひゃくさん"],["年","ねん"],["生きて","いきて"],["、"],["男子","だんし"],["と"],["女子","じょし"],["を"],["生んだ","うんだ"],["。"]]},{"verse":14,"text":"シラは三十歳,さいになってエベルを生,うんだ。","tok":[["シラ"],["は"],["三十歳","さい"],["に"],["なって"],["エベル"],["を"],["生んだ","うんだ"],["。"]]},{"verse":15,"text":"シラはエベルを生,うんで後,のち、四百三年,ねん生,いきて、男子,だんしと女子,じょしを生,うんだ。","tok":[["シラ"],["は"],["エベル"],["を"],["生んで","うんで"],["後","の"],["ち"],["、"],["四百三","よんひゃくさん"],["年","ねん"],["生きて","いきて"],["、"],["男子","だんし"],["と"],["女子","じょし"],["を"],["生んだ","うんだ"],["。"]]},{"verse":16,"text":"エベルは三十四歳,さいになってペレグを生,うんだ。","tok":[["エベル"],["は"],["三十四歳","さい"],["に"],["なって"],["ペレグ"],["を"],["生んだ","うんだ"],["。"]]},{"verse":17,"text":"エベルはペレグを生,うんで後,のち、四百三十年,ねん生,いきて、男子,だんしと女子,じょしを生,うんだ。","tok":[["エベル"],["は"],["ペレグ"],["を"],["生んで","うんで"],["後","の"],["ち"],["、"],["四百三十","よんひゃくさんじゅう"],["年","ねん"],["生きて","いきて"],["、"],["男子","だんし"],["と"],["女子","じょし"],["を"],["生んだ","うんだ"],["。"]]},{"verse":18,"text":"ペレグは三十歳,さいになってリウを生,うんだ。","tok":[["ペレグ"],["は"],["三十歳","さい"],["に"],["なって"],["リウ"],["を"],["生んだ","うんだ"],["。"]]},{"verse":19,"text":"ペレグはリウを生,うんで後,のち、二百九年,ねん生,いきて、男子,だんしと女子,じょしを生,うんだ。","tok":[["ペレグ"],["は"],["リウ"],["を"],["生んで","うんで"],["後","の"],["ち"],["、"],["二百九","にひゃくきゅう"],["年","ねん"],["生きて","いきて"],["、"],["男子","だんし"],["と"],["女子","じょし"],["を"],["生んだ","うんだ"],["。"]]},{"verse":20,"text":"リウは三十二歳,さいになってセルグを生,うんだ。","tok":[["リウ"],["は"],["三十二歳","さい"],["に"],["なって"],["セルグ"],["を"],["生んだ","うんだ"],["。"]]},{"verse":21,"text":"リウはセルグを生,うんで後,のち、二百七年,ねん生,いきて、男子,だんしと女子,じょしを生,うんだ。","tok":[["リウ"],["は"],["セルグ"],["を"],["生んで","うんで"],["後","の"],["ち"],["、"],["二百七","にひゃくなな"],["年","ねん"],["生きて","いきて"],["、"],["男子","だんし"],["と"],["女子","じょし"],["を"],["生んだ","うんだ"],["。"]]},{"verse":22,"text":"セルグは三十歳,さいになってナホルを生,うんだ。","tok":[["セルグ"],["は"],["三十歳","さい"],["に"],["なって"],["ナホル"],["を"],["生んだ","うんだ"],["。"]]},{"verse":23,"text":"セルグはナホルを生,うんで後,のち、二百年,ねん生,いきて、男子,だんしと女子,じょしを生,うんだ。","tok":[["セルグ"],["は"],["ナホル"],["を"],["生んで","うんで"],["後","の"],["ち"],["、"],["二百","にひゃく"],["年","ねん"],["生きて","いきて"],["、"],["男子","だんし"],["と"],["女子","じょし"],["を"],["生んだ","うんだ"],["。"]]},{"verse":24,"text":"ナホルは二十九歳,さいになってテラを生,うんだ。","tok":[["ナホル"],["は"],["二十九歳","さい"],["に"],["なって"],["テラ"],["を"],["生んだ","うんだ"],["。"]]},{"verse":25,"text":"ナホルはテラを生,うんで後,のち、百十九年,ねん生,いきて、男子,だんしと女子,じょしを生,うんだ。","tok":[["ナホル"],["は"],["テラ"],["を"],["生んで","うんで"],["後","の"],["ち"],["、"],["百十九","ひゃくじゅうきゅう"],["年","ねん"],["生きて","いきて"],["、"],["男子","だんし"],["と"],["女子","じょし"],["を"],["生んだ","うんだ"],["。"]]},{"verse":26,"text":"テラは七十歳,さいになってアブラム、ナホルおよびハランを生,うんだ。","tok":[["テラ"],["は"],["七十歳","さい"],["に"],["なって"],["アブラム"],["、"],["ナホル"],["および"],["ハラン"],["を"],["生んだ","うんだ"],["。"]]},{"verse":27,"text":"テラの系図,けいずは次,つぎのとおりである。テラはアブラム、ナホルおよびハランを生,うみ、ハランはロトを生,うんだ。","tok":[["テラ"],["の"],["系図","けいず"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["テラ"],["は"],["アブラム"],["、"],["ナホル"],["および"],["ハラン"],["を"],["生み","うみ"],["、"],["ハラン"],["は"],["ロト"],["を"],["生んだ","うんだ"],["。"]]},{"verse":28,"text":"ハランは父,ちちテラにさきだって、その生,うまれた地,ち、カルデヤのウルで死,しんだ。","tok":[["ハラン"],["は"],["父","ちち"],["テラ"],["に"],["さきだって"],["、"],["その"],["生まれた","うまれた"],["地","ち"],["、"],["カルデヤ"],["の"],["ウル"],["で"],["死んだ","しんだ"],["。"]]},{"verse":29,"text":"アブラムとナホルは妻,つまをめとった。アブラムの妻,つまの名,なはサライといい、ナホルの妻,つまの名,なはミルカといってハランの娘,むすめである。ハランはミルカの父,ちち、またイスカの父,ちちである。","tok":[["アブラム"],["と"],["ナホル"],["は"],["妻","つま"],["を"],["めとった"],["。"],["アブラム"],["の"],["妻","つま"],["の"],["名","な"],["は"],["サライ"],["と"],["いい"],["、"],["ナホル"],["の"],["妻","つま"],["の"],["名","な"],["は"],["ミルカ"],["と"],["いって"],["ハラン"],["の"],["娘","むすめ"],["で"],["ある"],["。"],["ハラン"],["は"],["ミルカ"],["の"],["父","ちち"],["、"],["また"],["イスカ"],["の"],["父","ちち"],["で"],["ある"],["。"]]},{"verse":30,"text":"サライはうまずめで、子,こがなかった。","tok":[["サライ"],["は"],["うまずめ"],["で"],["、"],["子","こ"],["が"],["なかった"],["。"]]},{"verse":31,"text":"テラはその子,こアブラムと、ハランの子,こである孫,まごロトと、子,こアブラムの妻,つまである嫁,よめサライとを連,つれて、カナンの地,ちへ行,いこうとカルデヤのウルを出,でたが、ハランに着,ついてそこに住,すんだ。","tok":[["テラ"],["は"],["その"],["子","こ"],["アブラム"],["と"],["、"],["ハラン"],["の"],["子","こ"],["で"],["ある"],["孫","まご"],["ロト"],["と"],["、"],["子","こ"],["アブラム"],["の"],["妻","つま"],["で"],["ある"],["嫁","よめ"],["サライ"],["と"],["を"],["連れて","つれて"],["、"],["カナン"],["の"],["地","ち"],["へ"],["行こう","いこう"],["と"],["カルデヤ"],["の"],["ウル"],["を"],["出た","でた"],["が"],["、"],["ハラン"],["に"],["着いて","ついて"],["そこ"],["に"],["住んだ","すんだ"],["。"]]},{"verse":32,"text":"テラの年,としは二百五歳,さいであった。テラはハランで死,しんだ。","tok":[["テラ"],["の"],["年","とし"],["は"],["二百五歳","さ"],["いで"],["あった"],["。"],["テラ"],["は"],["ハラン"],["で"],["死んだ","しんだ"],["。"]]}]
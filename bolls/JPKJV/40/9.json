[{"verse":1,"text":"さて、イエスは舟,ふねに乗,のって海,うみを渡,わたり、自分,じぶんの町,まちに帰,かえられた。","tok":[["さて"],["、"],["イエス"],["は"],["舟","ふね"],["に"],["乗って","のって"],["海","うみ"],["を"],["渡り","わたり"],["、"],["自分","じぶん"],["の"],["町","まち"],["に"],["帰えられた","かえられた"],["。"]]},{"verse":2,"text":"すると、人々,ひとびとが中風,ちゅうぶの者,ものを床,とこの上,うえに寝,ねかせたままでみもとに運,はこんできた。イエスは彼,かれらの信仰,しんこうを見,みて、中風,ちゅうぶの者,ものに、「子,こよ、しっかりしなさい。あなたの罪,つみはゆるされたのだ」と言,いわれた。","tok":[["する"],["と"],["、"],["人々","ひとびと"],["が"],["中風","ちゅうぶ"],["の"],["者","もの"],["を"],["床","とこ"],["の"],["上","うえ"],["に"],["寝かせた","ねかせた"],["まま"],["で"],["みもと"],["に"],["運こんで","はこんで"],["きた"],["。"],["イエス"],["は"],["彼","かれ"],["ら"],["の"],["信仰","しんこう"],["を"],["見て","みて"],["、"],["中風","ちゅうぶ"],["の"],["者","もの"],["に"],["、"],["「"],["子","こ"],["よ"],["、"],["しっかり"],["し"],["なさい"],["。"],["あなた"],["の"],["罪","つみ"],["は"],["ゆるされた"],["の"],["だ"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":3,"text":"すると、ある律法,りっぽう学者,がくしゃたちが心,こころの中,なかで言,いった、「この人,ひとは神,かみを汚,けがしている」。","tok":[["する"],["と"],["、"],["ある"],["律法学者","りっぽうがくしゃ"],["たち"],["が"],["心","こころ"],["の"],["中","なか"],["で"],["言った","いった"],["、"],["「"],["この"],["人","ひと"],["は"],["神","かみ"],["を"],["汚","け"],["がして"],["いる"],["」"],["。"]]},{"verse":4,"text":"イエスは彼,かれらの考,かんがえを見抜,みぬいて、「なぜ、あなたがたは心,こころの中,なかで悪,わるいことを考,かんがえているのか。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["の"],["考","かんがえ"],["を"],["見抜いて","みぬいて"],["、"],["「"],["なぜ"],["、"],["あなた"],["がた"],["は"],["心","こころ"],["の"],["中","なか"],["で"],["悪い","わるい"],["こと"],["を"],["考","かんがえ"],["て"],["いる"],["の"],["か"],["。"]]},{"verse":5,"text":"あなたの罪,つみはゆるされた、と言,いうのと、起,おきて歩,あるけ、と言,いうのと、どちらがたやすいか。","tok":[["あなた"],["の"],["罪","つみ"],["は"],["ゆるされた"],["、"],["と"],["言う","いう"],["の"],["と"],["、"],["起きて","おきて"],["歩け","あるけ"],["、"],["と"],["言う","いう"],["の"],["と"],["、"],["どちら"],["が"],["たやすい"],["か"],["。"]]},{"verse":6,"text":"しかし、人,ひとの子,こは地上,ちじょうで罪,つみをゆるす権威,けんいをもっていることが、あなたがたにわかるために」と言,いい、中風,ちゅうぶの者,ものにむかって、「起,おきよ、床,とこを取,とりあげて家,いえに帰,かえれ」と言,いわれた。","tok":[["しかし"],["、"],["人","ひと"],["の"],["子","こ"],["は"],["地上","ちじょう"],["で"],["罪","つみ"],["を"],["ゆるす"],["権威","けんい"],["を"],["もって"],["いる"],["こと"],["が"],["、"],["あなた"],["がた"],["に"],["わかる"],["ため"],["に"],["」"],["と"],["言い","いい"],["、"],["中風","ちゅうぶ"],["の"],["者","もの"],["に"],["むかって"],["、"],["「"],["起きよ","おきよ"],["、"],["床","とこ"],["を"],["取","とり"],["あげて"],["家","いえ"],["に"],["帰えれ","かえれ"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":7,"text":"すると彼,かれは起,おきあがり、家,いえに帰,かえって行,いった。","tok":[["する"],["と"],["彼","かれ"],["は"],["起きあがり","おきあがり"],["、"],["家","いえ"],["に"],["帰えって","かえって"],["行った","いった"],["。"]]},{"verse":8,"text":"群衆,ぐんしゅうはそれを見,みて恐,おそれ、こんな大,おおきな権威,けんいを人,ひとにお与,あたえになった神,かみをあがめた。","tok":[["群衆","ぐんしゅう"],["は"],["それ"],["を"],["見て","みて"],["恐","おそれ"],["、"],["こんな"],["大きな","おおきな"],["権威","けんい"],["を"],["人","ひと"],["に"],["お"],["与","あたえ"],["に"],["なった"],["神","かみ"],["を"],["あがめた"],["。"]]},{"verse":9,"text":"さてイエスはそこから進,すすんで行,いかれ、マタイという人,ひとが収税所,しゅうぜいしょにすわっているのを見,みて、「わたしに従,したがってきなさい」と言,いわれた。すると彼,かれは立,たちあがって、イエスに従,したがった。","tok":[["さて"],["イエス"],["は"],["そこ"],["から"],["進んで","すすんで"],["行かれ","いかれ"],["、"],["マタイ"],["と"],["いう"],["人","ひと"],["が"],["収税所","しゅうぜいしょ"],["に"],["すわって"],["いる"],["の"],["を"],["見て","みて"],["、"],["「"],["わたし"],["に"],["従って","したがって"],["き"],["なさい"],["」"],["と"],["言われた","いわれた"],["。"],["する"],["と"],["彼","かれ"],["は"],["立ちあがって","たちあがって"],["、"],["イエス"],["に"],["従った","したがった"],["。"]]},{"verse":10,"text":"それから、イエスが家,いえで食事,しょくじの席,せきについておられた時,ときのことである。多,おおくの取税人,しゅぜいにんや罪人,つみびとたちがきて、イエスや弟子,でしたちと共,ともにその席,せきに着,ついていた。","tok":[["それ"],["から"],["、"],["イエス"],["が"],["家","いえ"],["で"],["食事","しょくじ"],["の"],["席","せき"],["について"],["おられた"],["時","とき"],["の"],["こと"],["で"],["ある"],["。"],["多く","おおく"],["の"],["取","とり"],["税人","ぜいにん"],["ぜ"],["い"],["に"],["ん"],["や"],["罪人","つみびとたち"],["が"],["きて"],["、"],["イエス"],["や"],["弟子","でし"],["たち"],["と"],["共","とも"],["に"],["その"],["席","せき"],["に"],["着いて","ついて"],["いた"],["。"]]},{"verse":11,"text":"パリサイ人,びとたちはこれを見,みて、弟子,でしたちに言,いった、「なぜ、あなたがたの先生,せんせいは、取税人,しゅぜいにんや罪人,つみびとなどと食事,しょくじを共,ともにするのか」。","tok":[["パリサイ"],["人","びとたち"],["は"],["これ"],["を"],["見て","みて"],["、"],["弟子","でし"],["たち"],["に"],["言った","いった"],["、"],["「"],["なぜ"],["、"],["あなた"],["がた"],["の"],["先生","せんせい"],["は"],["、"],["取","とり"],["税人","ぜいにん"],["ぜ"],["い"],["に"],["ん"],["や"],["罪人","つみび"],["と"],["など"],["と"],["食事","しょくじ"],["を"],["共","とも"],["に"],["する"],["の"],["か"],["」"],["。"]]},{"verse":12,"text":"イエスはこれを聞,きいて言,いわれた、「丈夫,じょうぶな人,ひとには医者,いしゃはいらない。いるのは病人,びょうにんである。","tok":[["イエス"],["は"],["これ"],["を"],["聞いて","きいて"],["言われた","いわれた"],["、"],["「"],["丈夫","じょうぶ"],["な"],["人","ひと"],["に"],["は"],["医者","いしゃ"],["は"],["いらない"],["。"],["いる"],["の"],["は"],["病人","びょうにん"],["で"],["ある"],["。"]]},{"verse":13,"text":"『わたしが好,このむのは、あわれみであって、いけにえではない』とはどういう意味,いみか、学,まなんできなさい。わたしがきたのは、義人,ぎじんを招,まねくためではなく、罪人,つみびとを招,まねくためである」。","tok":[["『"],["わたし"],["が"],["好む","このむ"],["の"],["は"],["、"],["あわれみ"],["で"],["あって"],["、"],["いけにえ"],["で"],["は"],["ない"],["』"],["と"],["は"],["どういう"],["意味","いみ"],["か"],["、"],["学","ま"],["なん"],["でき"],["なさい"],["。"],["わたし"],["が"],["きた"],["の"],["は"],["、"],["義人","ぎじん"],["を"],["招く","まねく"],["ため"],["で"],["は"],["なく"],["、"],["罪人","つみびと"],["を"],["招く","まねく"],["ため"],["で"],["ある"],["」"],["。"]]},{"verse":14,"text":"そのとき、ヨハネの弟子,でしたちがイエスのところにきて言,いった、「わたしたちとパリサイ人,びとたちとが断食,だんじきをしているのに、あなたの弟子,でしたちは、なぜ断食,だんじきをしないのですか」。","tok":[["その"],["とき"],["、"],["ヨハネ"],["の"],["弟子","でし"],["たち"],["が"],["イエス"],["の"],["ところ"],["に"],["きて"],["言った","いった"],["、"],["「"],["わたしたち"],["と"],["パリサイ"],["人","びと"],["たち"],["と"],["が"],["断食","だんじき"],["を"],["して"],["いる"],["のに"],["、"],["あなた"],["の"],["弟子","でし"],["たち"],["は"],["、"],["なぜ"],["断食","だんじき"],["を"],["しない"],["の"],["です"],["か"],["」"],["。"]]},{"verse":15,"text":"するとイエスは言,いわれた、「婚礼,こんれいの客,きゃくは、花婿,はなむこが一緒,いっしょにいる間,あいだは、悲,かなしんでおられようか。しかし、花婿,はなむこが奪,うばい去,さられる日,ひが来,くる。その時,ときには断食,だんじきをするであろう。","tok":[["する"],["と"],["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["婚礼","こんれい"],["の"],["客","きゃく"],["は"],["、"],["花婿","はなむこ"],["が"],["一緒","いっしょ"],["に"],["いる"],["間","あいだ"],["は"],["、"],["悲しんで","かなしんで"],["おられよう"],["か"],["。"],["しかし"],["、"],["花婿","はなむこ"],["が"],["奪い去られる","うばいさられる"],["日","ひ"],["が"],["来る","くる"],["。"],["その"],["時","とき"],["に"],["は"],["断食","だんじき"],["を"],["するで"],["あろう"],["。"]]},{"verse":16,"text":"だれも、真新,まあたらしい布,ぬのぎれで、古,ふるい着物,きものにつぎを当,あてはしない。そのつぎきれは着物,きものを引,ひき破,やぶり、そして、破,やぶれがもっとひどくなるから。","tok":[["だれ"],["も"],["、"],["真","ま"],["新らしい","あたらしい"],["布ぎれ","ぬのぎれ"],["で"],["、"],["古い","ふるい"],["着物","きもの"],["に"],["つぎ"],["を"],["当て","あて"],["は"],["しない"],["。"],["その"],["つぎ"],["きれ"],["は"],["着物","きもの"],["を"],["引","ひき"],["破り","やぶり"],["、"],["そして"],["、"],["破れ","やぶれ"],["が"],["もっと"],["ひどく"],["なる"],["から"],["。"]]},{"verse":17,"text":"だれも、新,あたらしいぶどう酒,しゅを古,ふるい皮,かわ袋,ぶくろに入,いれはしない。もしそんなことをしたら、その皮,かわ袋,ぶくろは張,はり裂,さけ、酒,さけは流,ながれ出,でるし、皮,かわ袋,ぶくろもむだになる。だから、新,あたらしいぶどう酒,しゅは新,あたらしい皮,かわ袋,ぶくろに入,いれるべきである。そうすれば両方,りょうほうとも長,ながもちがするであろう」。","tok":[["だれ"],["も"],["、"],["新らしい","あたらしい"],["ぶどう酒","ぶどうしゅ"],["を"],["古い","ふるい"],["皮袋","かわぶくろ"],["に"],["入れ","いれ"],["は"],["しない"],["。"],["もし"],["そんな"],["こと"],["を"],["したら"],["、"],["その"],["皮袋","かわぶくろ"],["は"],["張り裂け","はりさけ"],["、"],["酒","さけ"],["は"],["流れ出る","ながれでる"],["し"],["、"],["皮袋","かわぶくろ"],["も"],["むだ"],["に"],["なる"],["。"],["だ"],["から"],["、"],["新らしい","あたらしい"],["ぶどう酒","ぶどうしゅ"],["は"],["新らしい","あたらしい"],["皮袋","かわぶくろ"],["に"],["入れるべきで","いれるべきで"],["ある"],["。"],["そう"],["すれば"],["両方","りょうほう"],["と"],["も"],["長もち","ながもち"],["が"],["するで"],["あろう"],["」"],["。"]]},{"verse":18,"text":"これらのことを彼,かれらに話,はなしておられると、そこにひとりの会堂司,かいどうづかさがきて、イエスを拝,はいして言,いった、「わたしの娘,むすめがただ今,いま死,しにました。しかしおいでになって手,てをその上,うえにおいてやって下,ください。そうしたら、娘,むすめは生,いき返,かえるでしょう」。","tok":[["これ"],["ら"],["の"],["こと"],["を"],["彼","かれ"],["ら"],["に"],["話","はなし"],["て"],["おられる"],["と"],["、"],["そこ"],["に"],["ひとり"],["の"],["会堂司","かいどうづかさ"],["が"],["きて"],["、"],["イエス"],["を"],["拝して","はいして"],["言った","いった"],["、"],["「"],["わたし"],["の"],["娘","むすめ"],["が"],["ただ今","ただいま"],["死にました","しにました"],["。"],["しかし"],["おいで"],["に"],["なって"],["手","て"],["を"],["その"],["上","うえ"],["に"],["おいて"],["やって"],["下さい","ください"],["。"],["そう"],["したら"],["、"],["娘","むすめ"],["は"],["生き返るでしょう","いきかえるでしょう"],["」"],["。"]]},{"verse":19,"text":"そこで、イエスが立,たって彼,かれについて行,いかれると、弟子,でしたちも一緒,いっしょに行,いった。","tok":[["そこ"],["で"],["、"],["イエス"],["が"],["立って","たって"],["彼","かれ"],["について"],["行かれる","いかれる"],["と"],["、"],["弟子","でし"],["たち"],["も"],["一緒","いっしょ"],["に"],["行った","いった"],["。"]]},{"verse":20,"text":"するとそのとき、十二年間,ねんかんも長,なが血,ちをわずらっている女,おんなが近寄,ちかよってきて、イエスのうしろからみ衣,ころものふさにさわった。","tok":[["する"],["と"],["その"],["とき"],["、"],["十二","じゅうに"],["年間","ねんかん"],["も"],["長","なが"],["血","ち"],["を"],["わずらって"],["いる"],["女","おんな"],["が"],["近寄って","ちかよって"],["きて"],["、"],["イエス"],["の"],["うしろ"],["から"],["み衣","みころも"],["の"],["ふさ"],["に"],["さわった"],["。"]]},{"verse":21,"text":"み衣,ころもにさわりさえすれば、なおしていただけるだろう、と心,こころの中,なかで思,おもっていたからである。","tok":[["み衣","みころも"],["に"],["さわり"],["さえ"],["すれば"],["、"],["なお"],["して"],["いただけるだろう"],["、"],["と"],["心","こころ"],["の"],["中","なか"],["で"],["思って","おもって"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":22,"text":"イエスは振,ふり向,むいて、この女,おんなを見,みて言,いわれた、「娘,むすめよ、しっかりしなさい。あなたの信仰,しんこうがあなたを救,すくったのです」。するとこの女,おんなはその時,ときに、いやされた。","tok":[["イエス"],["は"],["振り向いて","ふりむいて"],["、"],["この"],["女","おんな"],["を"],["見て","みて"],["言われた","いわれた"],["、"],["「"],["娘","むすめ"],["よ"],["、"],["しっかり"],["し"],["なさい"],["。"],["あなた"],["の"],["信仰","しんこう"],["が"],["あなた"],["を"],["救った","すくった"],["の"],["です"],["」"],["。"],["する"],["と"],["この"],["女","おんな"],["は"],["その"],["時","とき"],["に"],["、"],["いやされた"],["。"]]},{"verse":23,"text":"それからイエスは司,つかさの家,いえに着,つき、笛,ふえ吹,ふきどもや騒,さわいでいる群衆,ぐんしゅうを見,みて言,いわれた。","tok":[["それ"],["から"],["イエス"],["は"],["司","つかさ"],["の"],["家","いえ"],["に"],["着き","つき"],["、"],["笛吹","ふえふき"],["ども"],["や"],["騒いで","さわいで"],["いる"],["群衆","ぐんしゅう"],["を"],["見て","みて"],["言われた","いわれた"],["。"]]},{"verse":24,"text":"「あちらへ行,いっていなさい。少女,しょうじょは死,しんだのではない。眠,ねむっているだけである」。すると人々,ひとびとはイエスをあざ笑,わらった。","tok":[["「"],["あちら"],["へ"],["行って","いって"],["い"],["なさい"],["。"],["少女","しょうじょ"],["は"],["死んだ","しんだ"],["ので"],["は"],["ない"],["。"],["眠って","ねむって"],["いる"],["だけ"],["で"],["ある"],["」"],["。"],["する"],["と"],["人々","ひとびと"],["は"],["イエス"],["を"],["あざ笑った","あざわらった"],["。"]]},{"verse":25,"text":"しかし、群衆,ぐんしゅうを外,そとへ出,だしたのち、イエスは内,うちへはいって、少女,しょうじょの手,てをお取,とりになると、少女,しょうじょは起,おきあがった。","tok":[["しかし"],["、"],["群衆","ぐんしゅう"],["を"],["外","そと"],["へ"],["出した","だした"],["のち"],["、"],["イエス"],["は"],["内","うち"],["へ"],["はいって"],["、"],["少女","しょうじょ"],["の"],["手","て"],["を"],["お取","おとり"],["に"],["なる"],["と"],["、"],["少女","しょうじょ"],["は"],["起きあがった","おきあがった"],["。"]]},{"verse":26,"text":"そして、そのうわさがこの地方,ちほう全体,ぜんたいにひろまった。","tok":[["そして"],["、"],["その"],["うわさ"],["が"],["この"],["地方","ちほう"],["全体","ぜんたい"],["に"],["ひろまった"],["。"]]},{"verse":27,"text":"そこから進,すすんで行,いかれると、ふたりの盲人,もうじんが、「ダビデの子,こよ、わたしたちをあわれんで下,ください」と叫,さけびながら、イエスについてきた。","tok":[["そこ"],["から"],["進んで","すすんで"],["行かれる","いかれる"],["と"],["、"],["ふたり"],["の"],["盲人","もうじん"],["が"],["、"],["「"],["ダビデ"],["の"],["子","こ"],["よ"],["、"],["わたしたち"],["を"],["あわれんで"],["下さい","ください"],["」"],["と"],["叫","さけび"],["ながら"],["、"],["イエス"],["について"],["きた"],["。"]]},{"verse":28,"text":"そしてイエスが家,いえにはいられると、盲人,もうじんたちがみもとにきたので、彼,かれらに「わたしにそれができると信,しんじるか」と言,いわれた。彼,かれらは言,いった、「主,しゅよ、信,しんじます」。","tok":[["そして"],["イエス"],["が"],["家","いえ"],["に"],["は"],["いられる"],["と"],["、"],["盲人","もうじん"],["たち"],["が"],["みもと"],["に"],["きた"],["ので"],["、"],["彼","かれ"],["ら"],["に"],["「"],["わたし"],["に"],["それ"],["が"],["できる"],["と"],["信じる","しんじる"],["か"],["」"],["と"],["言われた","いわれた"],["。"],["彼","かれ"],["ら"],["は"],["言った","いった"],["、"],["「"],["主","しゅ"],["よ"],["、"],["信じます","しんじます"],["」"],["。"]]},{"verse":29,"text":"そこで、イエスは彼,かれらの目,めにさわって言,いわれた、「あなたがたの信仰,しんこうどおり、あなたがたの身,みになるように」。","tok":[["そこ"],["で"],["、"],["イエス"],["は"],["彼","かれ"],["ら"],["の"],["目","め"],["に"],["さわって"],["言われた","いわれた"],["、"],["「"],["あなた"],["がた"],["の"],["信仰","しんこう"],["どおり"],["、"],["あなた"],["がた"],["の"],["身","み"],["に"],["なる"],["よう"],["に"],["」"],["。"]]},{"verse":30,"text":"すると彼,かれらの目,めが開,ひらかれた。イエスは彼,かれらをきびしく戒,いましめて言,いわれた、「だれにも知,しれないように気,きをつけなさい」。","tok":[["する"],["と"],["彼","かれ"],["ら"],["の"],["目","め"],["が"],["開らかれた","ひらかれた"],["。"],["イエス"],["は"],["彼","かれ"],["ら"],["を"],["きびしく"],["戒しめ","いましめ"],["て"],["言われた","いわれた"],["、"],["「"],["だれ"],["に"],["も"],["知れない","しれない"],["よう"],["に"],["気","き"],["を"],["つけ"],["なさい"],["」"],["。"]]},{"verse":31,"text":"しかし、彼,かれらは出,でて行,いって、その地方,ちほう全体,ぜんたいにイエスのことを言,いいひろめた。","tok":[["しかし"],["、"],["彼","かれ"],["ら"],["は"],["出て","でて"],["行って","いって"],["、"],["その"],["地方","ちほう"],["全体","ぜんたい"],["に"],["イエス"],["の"],["こと"],["を"],["言い","いい"],["ひろめた"],["。"]]},{"verse":32,"text":"彼,かれらが出,でて行,いくと、人々,ひとびとは悪霊,あくれいにつかれたおしをイエスのところに連,つれてきた。","tok":[["彼","かれ"],["ら"],["が"],["出て","でて"],["行く","いく"],["と"],["、"],["人々","ひとびと"],["は"],["悪霊","あくれい"],["に"],["つかれた"],["おし"],["を"],["イエス"],["の"],["ところ"],["に"],["連れて","つれて"],["きた"],["。"]]},{"verse":33,"text":"すると、悪霊,あくれいは追,おい出,だされて、おしが物,ものを言,いうようになった。群衆,ぐんしゅうは驚,おどろいて、「このようなことがイスラエルの中,なかで見,みられたことは、これまで一度,いちどもなかった」と言,いった。","tok":[["する"],["と"],["、"],["悪霊","あくれい"],["は"],["追い出されて","おいだされて"],["、"],["おし"],["が"],["物","もの"],["を"],["言う","いう"],["よう"],["に"],["なった"],["。"],["群衆","ぐんしゅう"],["は"],["驚ろいて","おどろいて"],["、"],["「"],["この"],["よう"],["な"],["こと"],["が"],["イスラエル"],["の"],["中","なか"],["で"],["見られた","みられた"],["こと"],["は"],["、"],["これ"],["まで"],["一度","いちど"],["も"],["なかった"],["」"],["と"],["言った","いった"],["。"]]},{"verse":34,"text":"しかし、パリサイ人,びとたちは言,いった、「彼,かれは、悪霊,あくれいどものかしらによって悪霊,あくれいどもを追,おい出,だしているのだ」。","tok":[["しかし"],["、"],["パリサイ"],["人","びとたち"],["は"],["言った","いった"],["、"],["「"],["彼","かれ"],["は"],["、"],["悪霊","あくれいども"],["の"],["かしら"],["によって"],["悪霊","あくれいども"],["を"],["追い出して","おいだして"],["いる"],["の"],["だ"],["」"],["。"]]},{"verse":35,"text":"イエスは、すべての町々,まちまち村々,むらむらを巡,めぐり歩,あるいて、諸,しょ会堂,かいどうで教,おしえ、御国,みくにの福音,ふくいんを宣,のべ伝,つたえ、あらゆる病気,びょうき、あらゆるわずらいをおいやしになった。","tok":[["イエス"],["は"],["、"],["すべて"],["の"],["町々","まちまち"],["村々","むらむら"],["を"],["巡り歩いて","めぐりあるいて"],["、"],["諸","しょ"],["会堂","かいどう"],["で"],["教え","おしえ"],["、"],["御国","みくに"],["の"],["福音","ふくいん"],["を"],["宣べ伝え","のべつたえ"],["、"],["あらゆる"],["病気","びょうき"],["、"],["あらゆる"],["わずらい"],["を"],["おいやし"],["に"],["なった"],["。"]]},{"verse":36,"text":"また群衆,ぐんしゅうが飼,かう者,もののない羊,ひつじのように弱,よわり果,はてて、倒,たおれているのをごらんになって、彼,かれらを深,ふかくあわれまれた。","tok":[["また"],["群衆","ぐんしゅう"],["が"],["飼う","かう"],["者","もの"],["の"],["ない"],["羊","ひつじ"],["の"],["よう"],["に"],["弱り","よわり"],["果てて","はてて"],["、"],["倒れて","たおれて"],["いる"],["の"],["を"],["ごらん"],["に"],["なって"],["、"],["彼","かれ"],["ら"],["を"],["深く","ふかく"],["あわれまれた"],["。"]]},{"verse":37,"text":"そして弟子,でしたちに言,いわれた、「収穫,しゅうかくは多,おおいが、働,はたらき人,びとが少,すくない。","tok":[["そして"],["弟子","でし"],["たち"],["に"],["言われた","いわれた"],["、"],["「"],["収穫","しゅうかく"],["は"],["多い","おおい"],["が"],["、"],["働らき人","はたらきび"],["と"],["が"],["少い","すくない"],["。"]]},{"verse":38,"text":"だから、収穫,しゅうかくの主,しゅに願,ねがって、その収穫,しゅうかくのために働,はたらき人,びとを送,おくり出,だすようにしてもらいなさい」。","tok":[["だ"],["から"],["、"],["収穫","しゅうかく"],["の"],["主","しゅ"],["に"],["願って","ねがって"],["、"],["その"],["収穫","しゅうかく"],["の"],["ため"],["に"],["働らき人","はたらきびと"],["を"],["送り出す","おくりだす"],["よう"],["に"],["して"],["もらい"],["なさい"],["」"],["。"]]}]
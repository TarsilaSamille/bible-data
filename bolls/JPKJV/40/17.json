[{"verse":1,"text":"六日,むいかののち、イエスはペテロ、ヤコブ、ヤコブの兄弟,きょうだいヨハネだけを連,つれて、高,たかい山,やまに登,のぼられた。","tok":[["六日","むいか"],["の"],["のち"],["、"],["イエス"],["は"],["ペテロ"],["、"],["ヤコブ"],["、"],["ヤコブ"],["の"],["兄弟","きょうだい"],["ヨハネ"],["だけ"],["を"],["連れて","つれて"],["、"],["高かい","たかい"],["山","やま"],["に"],["登られた","のぼられた"],["。"]]},{"verse":2,"text":"ところが、彼,かれらの目,めの前,まえでイエスの姿,すがたが変,かわり、その顔,かおは日,ひのように輝,かがやき、その衣,ころもは光,ひかりのように白,しろくなった。","tok":[["ところ"],["が"],["、"],["彼","かれ"],["ら"],["の"],["目","め"],["の"],["前","まえ"],["で"],["イエス"],["の"],["姿","すがた"],["が"],["変わり","かわり"],["、"],["その"],["顔","かお"],["は"],["日","ひ"],["の"],["よう"],["に"],["輝やき","かがやき"],["、"],["その"],["衣","ころも"],["は"],["光","ひかり"],["の"],["よう"],["に"],["白く","しろく"],["なった"],["。"]]},{"verse":3,"text":"すると、見,みよ、モーセとエリヤが彼,かれらに現,あらわれて、イエスと語,かたり合,あっていた。","tok":[["する"],["と"],["、"],["見よ","みよ"],["、"],["モーセ"],["と"],["エリヤ"],["が"],["彼","かれ"],["ら"],["に"],["現われて","あらわれて"],["、"],["イエス"],["と"],["語り合って","かたりあって"],["いた"],["。"]]},{"verse":4,"text":"ペテロはイエスにむかって言,いった、「主,しゅよ、わたしたちがここにいるのは、すばらしいことです。もし、おさしつかえなければ、わたしはここに小屋,こやを三つ建,たてましょう。一つはあなたのために、一つはモーセのために、一つはエリヤのために」。","tok":[["ペテロ"],["は"],["イエス"],["に"],["むかって"],["言った","いった"],["、"],["「"],["主","しゅ"],["よ"],["、"],["わたしたち"],["が"],["ここ"],["に"],["いる"],["の"],["は"],["、"],["すばらしい"],["こと"],["です"],["。"],["もし"],["、"],["おさしつかえなければ"],["、"],["わたし"],["は"],["ここ"],["に"],["小屋","こや"],["を"],["三","みっ"],["つ"],["建てましょう","たてましょう"],["。"],["一","ひと"],["つ"],["は"],["あなた"],["の"],["ため"],["に"],["、"],["一","ひと"],["つ"],["は"],["モーセ"],["の"],["ため"],["に"],["、"],["一","ひと"],["つ"],["は"],["エリヤ"],["の"],["ため"],["に"],["」"],["。"]]},{"verse":5,"text":"彼,かれがまだ話,はなし終,おえないうちに、たちまち、輝,かがやく雲,くもが彼,かれらをおおい、そして雲,くもの中,なかから声,こえがした、「これはわたしの愛,あいする子,こ、わたしの心,こころにかなう者,ものである。これに聞,きけ」。","tok":[["彼","かれ"],["が"],["まだ"],["話","はなし"],["終えない","おえない"],["うち"],["に"],["、"],["たちまち"],["、"],["輝やく","かがやく"],["雲","くも"],["が"],["彼","かれ"],["ら"],["を"],["おおい"],["、"],["そして"],["雲","くも"],["の"],["中","なか"],["から"],["声","こえ"],["が"],["した"],["、"],["「"],["これ"],["は"],["わたし"],["の"],["愛する","あいする"],["子","こ"],["、"],["わたし"],["の"],["心","こころ"],["に"],["かなう"],["者","もの"],["で"],["ある"],["。"],["これ"],["に"],["聞け","きけ"],["」"],["。"]]},{"verse":6,"text":"弟子,でしたちはこれを聞,きいて非常,ひじょうに恐,おそれ、顔,かおを地,ちに伏,ふせた。","tok":[["弟子","でし"],["たち"],["は"],["これ"],["を"],["聞いて","きいて"],["非常","ひじょう"],["に"],["恐","おそれ"],["、"],["顔","かお"],["を"],["地","ち"],["に"],["伏せた","ふせた"],["。"]]},{"verse":7,"text":"イエスは近,ちかづいてきて、手,てを彼,かれらにおいて言,いわれた、「起,おきなさい、恐,おそれることはない」。","tok":[["イエス"],["は"],["近づいて","ちかづいて"],["きて"],["、"],["手","て"],["を"],["彼","かれ"],["ら"],["に"],["おいて"],["言われた","いわれた"],["、"],["「"],["起き","おき"],["なさい"],["、"],["恐れる","おそれる"],["こと"],["は"],["ない"],["」"],["。"]]},{"verse":8,"text":"彼,かれらが目,めをあげると、イエスのほかには、だれも見,みえなかった。","tok":[["彼","かれ"],["ら"],["が"],["目","め"],["を"],["あげる"],["と"],["、"],["イエス"],["の"],["ほか"],["に"],["は"],["、"],["だれ"],["も"],["見えなかった","みえなかった"],["。"]]},{"verse":9,"text":"一同,いちどうが山,やまを下,くだって来,くるとき、イエスは「人,ひとの子,こが死人,しにんの中,なかからよみがえるまでは、いま見,みたことをだれにも話,はなしてはならない」と、彼,かれらに命,めいじられた。","tok":[["一同","いちどう"],["が"],["山","やま"],["を"],["下って","くだって"],["来る","くる"],["とき"],["、"],["イエス"],["は"],["「"],["人","ひと"],["の"],["子","こ"],["が"],["死人","しにん"],["の"],["中","なか"],["から"],["よみがえる"],["まで"],["は"],["、"],["いま"],["見た","みた"],["こと"],["を"],["だれ"],["に"],["も"],["話","はなし"],["ては"],["ならない"],["」"],["と"],["、"],["彼","かれ"],["ら"],["に"],["命じられた","めいじられた"],["。"]]},{"verse":10,"text":"弟子,でしたちはイエスにお尋,たずねして言,いった、「いったい、律法,りっぽう学者,がくしゃたちは、なぜ、エリヤが先,さきに来,くるはずだと言,いっているのですか」。","tok":[["弟子","でし"],["たち"],["は"],["イエス"],["に"],["お尋ね","おたずね"],["して"],["言った","いった"],["、"],["「"],["いったい"],["、"],["律法学者","りっぽうがくしゃ"],["たち"],["は"],["、"],["なぜ"],["、"],["エリヤ"],["が"],["先","さき"],["に"],["来る","くる"],["はず"],["だ"],["と"],["言って","いって"],["いる"],["の"],["です"],["か"],["」"],["。"]]},{"verse":11,"text":"答,こたえて言,いわれた、「確,たしかに、エリヤがきて、万事,ばんじを元,もとどおりに改,あらためるであろう。","tok":[["答","こたえ"],["て"],["言われた","いわれた"],["、"],["「"],["確か","たしか"],["に"],["、"],["エリヤ"],["が"],["きて"],["、"],["万事","ばんじ"],["を"],["元どおり","もとどおり"],["に"],["改めるで","あらためるで"],["あろう"],["。"]]},{"verse":12,"text":"しかし、あなたがたに言,いっておく。エリヤはすでにきたのだ。しかし人々,ひとびとは彼,かれを認,みとめず、自分,じぶんかってに彼,かれをあしらった。人,ひとの子,こもまた、そのように彼,かれらから苦,くるしみを受,うけることになろう」。","tok":[["しかし"],["、"],["あなた"],["がた"],["に"],["言って","いって"],["おく"],["。"],["エリヤ"],["は"],["すでに"],["きた"],["の"],["だ"],["。"],["しかし"],["人々","ひとびと"],["は"],["彼","かれ"],["を"],["認めず","みとめず"],["、"],["自分","じぶん"],["かって"],["に"],["彼","かれ"],["を"],["あしらった"],["。"],["人","ひと"],["の"],["子","こ"],["も"],["また"],["、"],["その"],["よう"],["に"],["彼","かれ"],["ら"],["から"],["苦しみ","くるしみ"],["を"],["受る","うける"],["こと"],["に"],["なろう"],["」"],["。"]]},{"verse":13,"text":"そのとき、弟子,でしたちは、イエスがバプテスマのヨハネのことを言,いわれたのだと悟,さとった。","tok":[["その"],["とき"],["、"],["弟子","でし"],["たち"],["は"],["、"],["イエス"],["が"],["バプテスマ"],["の"],["ヨハネ"],["の"],["こと"],["を"],["言われた","いわれた"],["の"],["だ"],["と"],["悟った","さとった"],["。"]]},{"verse":14,"text":"さて彼,かれらが群衆,ぐんしゅうのところに帰,かえると、ひとりの人,ひとがイエスに近寄,ちかよってきて、ひざまずいて、言,いった、","tok":[["さて"],["彼","かれ"],["ら"],["が"],["群衆","ぐんしゅう"],["の"],["ところ"],["に"],["帰える","かえる"],["と"],["、"],["ひとり"],["の"],["人","ひと"],["が"],["イエス"],["に"],["近寄って","ちかよって"],["きて"],["、"],["ひざまずいて"],["、"],["言った","いった"],["、"]]},{"verse":15,"text":"「主,しゅよ、わたしの子,こをあわれんでください。てんかんで苦,くるしんでおります。何,なん度,ども何,なん度,ども火,ひの中,なかや水,みずの中,なかに倒,たおれるのです。","tok":[["「"],["主","しゅ"],["よ"],["、"],["わたし"],["の"],["子","こ"],["を"],["あわれんで"],["ください"],["。"],["てんかん"],["で"],["苦しんで","くるしんで"],["おります"],["。"],["何度","なんど"],["も"],["何度","なんど"],["も"],["火","ひ"],["の"],["中","なか"],["や"],["水","みず"],["の"],["中","なか"],["に"],["倒れる","たおれる"],["の"],["です"],["。"]]},{"verse":16,"text":"それで、その子,こをお弟子,でしたちのところに連,つれてきましたが、なおしていただけませんでした」。","tok":[["それ"],["で"],["、"],["その"],["子","こ"],["を"],["お"],["弟子","でし"],["たち"],["の"],["ところ"],["に"],["連れて","つれて"],["きました"],["が"],["、"],["なお"],["して"],["いただけませんでした"],["」"],["。"]]},{"verse":17,"text":"イエスは答,こたえて言,いわれた、「ああ、なんという不,ふ信仰,しんこうな、曲,まがった時代,じだいであろう。いつまで、わたしはあなたがたと一緒,いっしょにおられようか。いつまであなたがたに我慢,がまんができようか。その子,こをここに、わたしのところに連,つれてきなさい」。","tok":[["イエス"],["は"],["答","こたえ"],["て"],["言われた","いわれた"],["、"],["「"],["ああ"],["、"],["なん"],["と"],["いう"],["不","ふ"],["信仰","しんこう"],["な"],["、"],["曲がった","まがった"],["時代","じだい"],["で"],["あろう"],["。"],["いつ"],["まで"],["、"],["わたし"],["は"],["あなた"],["がた"],["と"],["一緒","いっしょ"],["に"],["おられよう"],["か"],["。"],["いつ"],["まで"],["あなた"],["がた"],["に"],["我慢","がまん"],["が"],["できよう"],["か"],["。"],["その"],["子","こ"],["を"],["ここ"],["に"],["、"],["わたし"],["の"],["ところ"],["に"],["連れて","つれて"],["き"],["なさい"],["」"],["。"]]},{"verse":18,"text":"イエスがおしかりになると、悪霊,あくれいはその子,こから出,でて行,いった。そして子,こはその時,ときいやされた。","tok":[["イエス"],["が"],["おしかり"],["に"],["なる"],["と"],["、"],["悪霊","あくれい"],["は"],["その"],["子","こ"],["から"],["出て","でて"],["行った","いった"],["。"],["そして"],["子","こ"],["は"],["その"],["時","とき"],["いやされた"],["。"]]},{"verse":19,"text":"それから、弟子,でしたちがひそかにイエスのもとにきて言,いった、「わたしたちは、どうして霊,れいを追,おい出,だせなかったのですか」。","tok":[["それ"],["から"],["、"],["弟子","でし"],["たち"],["が"],["ひそか"],["に"],["イエス"],["の"],["もと"],["に"],["きて"],["言った","いった"],["、"],["「"],["わたしたち"],["は"],["、"],["どう"],["して"],["霊","れい"],["を"],["追い出せなかった","おいだせなかった"],["の"],["です"],["か"],["」"],["。"]]},{"verse":20,"text":"するとイエスは言,いわれた、「あなたがたの信仰,しんこうが足,たりないからである。よく言,いい聞,きかせておくが、もし、からし種,だね一粒,つぶほどの信仰,しんこうがあるなら、この山,やまにむかって『ここからあそこに移,うつれ』と言,いえば、移,うつるであろう。このように、あなたがたにできない事,ことは、何,なにもないであろう。〔","tok":[["する"],["と"],["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["あなた"],["がた"],["の"],["信仰","しんこう"],["が"],["足りない","たりない"],["から"],["で"],["ある"],["。"],["よく"],["言い聞かせて","いいきかせて"],["おく"],["が"],["、"],["もし"],["、"],["からし"],["種","だ"],["ね"],["一","いち"],["粒","つぶ"],["の"],["信仰","しんこう"],["が"],["あるなら"],["、"],["この"],["山","やま"],["に"],["むかって"],["『"],["ここ"],["から"],["あそこ"],["に"],["移れ","うつれ"],["』"],["と"],["言えば","いえば"],["、"],["移るで","うつるで"],["あろう"],["。"],["この"],["よう"],["に"],["、"],["あなた"],["がた"],["に"],["できない"],["事","こと"],["は"],["、"],["何に","なに"],["も"],["ないで"],["あろう"],["。"],["〔"]]},{"verse":21,"text":"しかし、このたぐいは、祈,いのりと断食,だんじきとによらなければ、追,おい出,だすことはできない〕」。","tok":[["しかし"],["、"],["この"],["たぐい"],["は"],["、"],["祈","いのり"],["と"],["断食","だんじき"],["と"],["に"],["よらなければ"],["、"],["追い出す","おいだす"],["こと"],["は"],["できない"],["〕"],["」"],["。"]]},{"verse":22,"text":"彼,かれらがガリラヤで集,あつまっていた時,とき、イエスは言,いわれた、「人,ひとの子,こは人々,ひとびとの手,てにわたされ、","tok":[["彼","かれ"],["ら"],["が"],["ガリラヤ"],["で"],["集まって","あつまって"],["いた"],["時","とき"],["、"],["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["人","ひと"],["の"],["子","こ"],["は"],["人々","ひとびと"],["の"],["手","て"],["に"],["わたされ"],["、"]]},{"verse":23,"text":"彼,かれらに殺,ころされ、そして三日,か目,めによみがえるであろう」。弟子,でしたちは非常,ひじょうに心,こころをいためた。","tok":[["彼","かれ"],["ら"],["に"],["殺ろされ","ころされ"],["、"],["そして"],["三日目","かめ"],["に"],["よみがえるで"],["あろう"],["」"],["。"],["弟子","でし"],["たち"],["は"],["非常","ひじょう"],["に"],["心","こころ"],["を"],["いためた"],["。"]]},{"verse":24,"text":"彼,かれらがカペナウムにきたとき、宮,みやの納入,のうにゅう金,きんを集,あつめる人,ひとたちがペテロのところにきて言,いった、「あなたがたの先生,せんせいは宮,みやの納入,のうにゅう金,きんを納,おさめないのか」。","tok":[["彼","かれ"],["ら"],["が"],["カペナウム"],["に"],["きた"],["とき"],["、"],["宮","みや"],["の"],["納入金","のうにゅうきん"],["を"],["集める","あつめる"],["人","ひと"],["たち"],["が"],["ペテロ"],["の"],["ところ"],["に"],["きて"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["の"],["先生","せんせい"],["は"],["宮","みや"],["の"],["納入金","のうにゅうきん"],["を"],["納","おさめ"],["ない"],["の"],["か"],["」"],["。"]]},{"verse":25,"text":"ペテロは「納,おさめておられます」と言,いった。そして彼,かれが家,いえにはいると、イエスから先,さきに話,はなしかけて言,いわれた、「シモン、あなたはどう思,おもうか。この世,よの王,おうたちは税,ぜいや貢,みつぎをだれから取,とるのか。自分,じぶんの子,こからか、それとも、ほかの人,ひとたちからか」。","tok":[["ペテロ"],["は"],["「"],["納","おさめ"],["て"],["おられます"],["」"],["と"],["言った","いった"],["。"],["そして"],["彼","かれ"],["が"],["家","いえ"],["に"],["はいる"],["と"],["、"],["イエス"],["から"],["先","さき"],["に"],["話かけて","はなしかけて"],["言われた","いわれた"],["、"],["「"],["シモン"],["、"],["あなた"],["は"],["どう"],["思","おもう"],["か"],["。"],["この世","このよ"],["の"],["王","おう"],["たち"],["は"],["税","ぜい"],["や"],["貢","みつぎ"],["を"],["だれ"],["から"],["取る","とる"],["の"],["か"],["。"],["自分","じぶん"],["の"],["子","こ"],["から"],["か"],["、"],["それ"],["と"],["も"],["、"],["ほか"],["の"],["人","ひと"],["たち"],["から"],["か"],["」"],["。"]]},{"verse":26,"text":"ペテロが「ほかの人,ひとたちからです」と答,こたえると、イエスは言,いわれた、「それでは、子,こは納,おさめなくてもよいわけである。","tok":[["ペテロ"],["が"],["「"],["ほか"],["の"],["人","ひと"],["たち"],["から"],["です"],["」"],["と"],["答","こたえ"],["る"],["と"],["、"],["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["それ"],["で"],["は"],["、"],["子","こ"],["は"],["納","おさめ"],["なくて"],["も"],["よい"],["わけ"],["で"],["ある"],["。"]]},{"verse":27,"text":"しかし、彼,かれらをつまずかせないために、海,うみに行,いって、つり針,はりをたれなさい。そして最初,さいしょにつれた魚,うおをとって、その口,くちをあけると、銀貨,ぎんか一枚,まいが見,みつかるであろう。それをとり出,だして、わたしとあなたのために納,おさめなさい」。","tok":[["しかし"],["、"],["彼","かれ"],["ら"],["を"],["つまずかせない"],["ため"],["に"],["、"],["海","うみ"],["に"],["行って","いって"],["、"],["つり針","つりはり"],["を"],["たれ"],["なさい"],["。"],["そして"],["最初","さいしょ"],["に"],["つれた"],["魚","うお"],["を"],["とって"],["、"],["その"],["口","くち"],["を"],["あける"],["と"],["、"],["銀貨","ぎんか"],["一枚","ま"],["い"],["が"],["見つかるで","みつかるで"],["あろう"],["。"],["それ"],["を"],["とり出して","とりだして"],["、"],["わたし"],["と"],["あなた"],["の"],["ため"],["に"],["納","おさめ"],["なさい"],["」"],["。"]]}]
[{"verse":1,"text":"イエスはこれらの言葉,ことばをすべて語,かたり終,おえてから、弟子,でしたちに言,いわれた。","tok":[["イエス"],["は"],["これ"],["ら"],["の"],["言葉","ことば"],["を"],["すべて"],["語り","かたり"],["終えて","おえて"],["から"],["、"],["弟子","でし"],["たち"],["に"],["言われた","いわれた"],["。"]]},{"verse":2,"text":"「あなたがたが知,しっているとおり、ふつかの後,のちには過越,すぎこしの祭,まつりになるが、人,ひとの子,こは十字架,じゅうじかにつけられるために引,ひき渡,わたされる」。","tok":[["「"],["あなた"],["がた"],["が"],["知って","しって"],["いる"],["とおり"],["、"],["ふ"],["つ"],["か"],["の"],["後","のち"],["に"],["は"],["過越","すぎこし"],["の"],["祭","まつり"],["に"],["なる"],["が"],["、"],["人","ひと"],["の"],["子","こ"],["は"],["十字架","じゅうじか"],["に"],["つけられる"],["ため"],["に"],["引渡される","ひきわたされる"],["」"],["。"]]},{"verse":3,"text":"そのとき、祭司長,さいしちょうたちや民,たみの長老,ちょうろうたちが、カヤパという大祭司,だいさいしの中庭,なかにわに集,あつまり、","tok":[["その"],["とき"],["、"],["祭司長","さいしちょう"],["たち"],["や"],["民","たみ"],["の"],["長老","ちょうろう"],["たち"],["が"],["、"],["カヤパ"],["と"],["いう"],["大","だい"],["祭司","さいし"],["の"],["中庭","なかにわ"],["に"],["集まり","あつまり"],["、"]]},{"verse":4,"text":"策略,さくりゃくをもってイエスを捕,とらえて殺,ころそうと相談,そうだんした。","tok":[["策略","さくりゃく"],["を"],["もって"],["イエス"],["を"],["捕らえて","とらえて"],["殺そう","ころそう"],["と"],["相談","そうだん"],["した"],["。"]]},{"verse":5,"text":"しかし彼,かれらは言,いった、「祭,まつりの間,あいだはいけない。民衆,みんしゅうの中,なかに騒,さわぎが起,おこるかも知,しれない」。","tok":[["しかし"],["彼","かれ"],["ら"],["は"],["言った","いった"],["、"],["「"],["祭","まつり"],["の"],["間","あいだ"],["は"],["いけない"],["。"],["民衆","みんしゅう"],["の"],["中","なか"],["に"],["騒ぎ","さわぎ"],["が"],["起こる","おこる"],["か"],["も"],["知れない","しれない"],["」"],["。"]]},{"verse":6,"text":"さて、イエスがベタニヤで、らい病人,びょうにんシモンの家,いえにおられたとき、","tok":[["さて"],["、"],["イエス"],["が"],["ベタニヤ"],["で"],["、"],["らい病人","らいびょうにん"],["シモン"],["の"],["家","いえ"],["に"],["おられた"],["とき"],["、"]]},{"verse":7,"text":"ひとりの女,おんなが、高価,こうかな香油,こうゆが入,いれてある石膏,せっこうのつぼを持,もってきて、イエスに近寄,ちかより、食事,しょくじの席,せきについておられたイエスの頭,あたまに香油,こうゆを注,そそぎかけた。","tok":[["ひとり"],["の"],["女","おんな"],["が"],["、"],["高価","こうか"],["な"],["香油","こうゆ"],["が"],["入れて","いれて"],["ある"],["石膏","せっこう"],["の"],["つぼ"],["を"],["持って","もって"],["きて"],["、"],["イエス"],["に"],["近寄り","ちかより"],["、"],["食事","しょくじ"],["の"],["席","せき"],["について"],["おられた"],["イエス"],["の"],["頭","あたま"],["に"],["香油","こうゆ"],["を"],["注ぎ","そそぎ"],["かけた"],["。"]]},{"verse":8,"text":"すると、弟子,でしたちはこれを見,みて憤,いきどおって言,いった、「なんのためにこんなむだ使,づかいをするのか。","tok":[["する"],["と"],["、"],["弟子","でし"],["たち"],["は"],["これ"],["を"],["見て","みて"],["憤って","いきどおって"],["言った","いった"],["、"],["「"],["なん"],["の"],["ため"],["に"],["こんな"],["むだ使い","むだづかい"],["を"],["する"],["の"],["か"],["。"]]},{"verse":9,"text":"それを高,たかく売,うって、貧,まずしい人,ひとたちに施,ほどこすことができたのに」。","tok":[["それ"],["を"],["高かく","たかく"],["売って","うって"],["、"],["貧しい","まずしい"],["人","ひと"],["たち"],["に"],["施す","ほどこす"],["こと"],["が"],["できた"],["のに"],["」"],["。"]]},{"verse":10,"text":"イエスはそれを聞,きいて彼,かれらに言,いわれた、「なぜ、女,おんなを困,こまらせるのか。わたしによい事,ことをしてくれたのだ。","tok":[["イエス"],["は"],["それ"],["を"],["聞いて","きいて"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["なぜ"],["、"],["女","おんな"],["を"],["困まらせる","こまらせる"],["の"],["か"],["。"],["わたし"],["に"],["よい"],["事","こと"],["を"],["して"],["くれた"],["の"],["だ"],["。"]]},{"verse":11,"text":"貧,まずしい人,ひとたちはいつもあなたがたと一緒,いっしょにいるが、わたしはいつも一緒,いっしょにいるわけではない。","tok":[["貧しい","まずしい"],["人","ひと"],["たち"],["は"],["いつも"],["あなた"],["がた"],["と"],["一緒","いっしょ"],["に"],["いる"],["が"],["、"],["わたし"],["は"],["いつも"],["一緒","いっしょ"],["に"],["いる"],["わけ"],["で"],["は"],["ない"],["。"]]},{"verse":12,"text":"この女,おんながわたしのからだにこの香油,こうゆを注,そそいだのは、わたしの葬,ほうむりの用意,よういをするためである。","tok":[["この"],["女","おんな"],["が"],["わたし"],["の"],["からだ"],["に"],["この"],["香油","こうゆ"],["を"],["注いだ","そそいだ"],["の"],["は"],["、"],["わたし"],["の"],["葬むり","ほうむり"],["の"],["用意","ようい"],["を"],["する"],["ため"],["で"],["ある"],["。"]]},{"verse":13,"text":"よく聞,ききなさい。全,ぜん世界,せかいのどこででも、この福音,ふくいんが宣,のべ伝,つたえられる所,ところでは、この女,おんなのした事,ことも記念,きねんとして語,かたられるであろう」。","tok":[["よく"],["聞","きき"],["なさい"],["。"],["全","ぜん"],["世界","せかい"],["の"],["どこ"],["で"],["で"],["も"],["、"],["この"],["福音","ふくいん"],["が"],["宣べ伝えられる","のべつたえられる"],["所","ところ"],["で"],["は"],["、"],["この"],["女","おんな"],["の"],["した"],["事","こと"],["も"],["記念","きねん"],["として"],["語られるで","かたられるで"],["あろう"],["」"],["。"]]},{"verse":14,"text":"時,ときに、十二弟子,でしのひとりイスカリオテのユダという者,ものが、祭司長,さいしちょうたちのところに行,いって","tok":[["時","とき"],["に"],["、"],["十二","じゅうに"],["弟子","でし"],["の"],["ひとり"],["イスカリオテ"],["の"],["ユダ"],["と"],["いう"],["者","もの"],["が"],["、"],["祭司長","さいしちょう"],["たち"],["の"],["ところ"],["に"],["行って","いって"]]},{"verse":15,"text":"言,いった、「彼,かれをあなたがたに引,ひき渡,わたせば、いくらくださいますか」。すると、彼,かれらは銀貨,ぎんか三十枚,まいを彼,かれに支払,しはらった。","tok":[["言った","いった"],["、"],["「"],["彼","かれ"],["を"],["あなた"],["がた"],["に"],["引渡せば","ひきわたせば"],["、"],["いくら"],["くださいます"],["か"],["」"],["。"],["する"],["と"],["、"],["彼","かれ"],["ら"],["は"],["銀貨","ぎんか"],["三十枚","まい"],["を"],["彼","かれ"],["に"],["支払った","しはらった"],["。"]]},{"verse":16,"text":"その時,ときから、ユダはイエスを引,ひきわたそうと、機会,きかいをねらっていた。","tok":[["その"],["時","とき"],["から"],["、"],["ユダ"],["は"],["イエス"],["を"],["引","ひき"],["わたそう"],["と"],["、"],["機会","きかい"],["を"],["ねらって"],["いた"],["。"]]},{"verse":17,"text":"さて、除酵祭,じょこうさいの第,だい一日,にちに、弟子,でしたちはイエスのもとにきて言,いった、「過越,すぎこしの食事,しょくじをなさるために、わたしたちはどこに用意,よういをしたらよいでしょうか」。","tok":[["さて"],["、"],["除","じょ"],["酵祭"],["の"],["第","だい"],["一","いち"],["日","にち"],["に"],["、"],["弟子","でし"],["たち"],["は"],["イエス"],["の"],["もと"],["に"],["きて"],["言った","いった"],["、"],["「"],["過越","すぎこし"],["の"],["食事","しょくじ"],["を"],["なさる"],["ため"],["に"],["、"],["わたしたち"],["は"],["どこ"],["に"],["用意","ようい"],["を"],["したら"],["よいでしょう"],["か"],["」"],["。"]]},{"verse":18,"text":"イエスは言,いわれた、「市内,しないにはいり、かねて話,はなしてある人,ひとの所,ところに行,いって言,いいなさい、『先生,せんせいが、わたしの時,ときが近,ちかづいた、あなたの家,いえで弟子,でしたちと一緒,いっしょに過越,すぎこしを守,まもろうと、言,いっておられます』」。","tok":[["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["市内","しない"],["に"],["はいり"],["、"],["かねて"],["話","はなし"],["て"],["ある"],["人","ひと"],["の"],["所","ところ"],["に"],["行って","いって"],["言い","いい"],["なさい"],["、"],["『"],["先生","せんせい"],["が"],["、"],["わたし"],["の"],["時","とき"],["が"],["近づいた","ちかづいた"],["、"],["あなた"],["の"],["家","いえ"],["で"],["弟子","でし"],["たち"],["と"],["一緒","いっしょ"],["に"],["過越","すぎこし"],["を"],["守ろう","まもろう"],["と"],["、"],["言って","いって"],["おられます"],["』"],["」"],["。"]]},{"verse":19,"text":"弟子,でしたちはイエスが命,めいじられたとおりにして、過越,すぎこしの用意,よういをした。","tok":[["弟子","でし"],["たち"],["は"],["イエス"],["が"],["命じられた","めいじられた"],["とおり"],["に"],["して"],["、"],["過越","すぎこし"],["の"],["用意","ようい"],["を"],["した"],["。"]]},{"verse":20,"text":"夕方,ゆうがたになって、イエスは十二弟子,でしと一緒,いっしょに食事,しょくじの席,せきにつかれた。","tok":[["夕方","ゆうがた"],["に"],["なって"],["、"],["イエス"],["は"],["十二","じゅうに"],["弟子","でし"],["と"],["一緒","いっしょ"],["に"],["食事","しょくじ"],["の"],["席","せき"],["に"],["つかれた"],["。"]]},{"verse":21,"text":"そして、一同,いちどうが食事,しょくじをしているとき言,いわれた、「特,とくにあなたがたに言,いっておくが、あなたがたのうちのひとりが、わたしを裏切,うらぎろうとしている」。","tok":[["そして"],["、"],["一同","いちどう"],["が"],["食事","しょくじ"],["を"],["して"],["いる"],["とき"],["言われた","いわれた"],["、"],["「"],["特に","とくに"],["あなた"],["がた"],["に"],["言って","いって"],["おく"],["が"],["、"],["あなた"],["がた"],["の"],["うち"],["の"],["ひとり"],["が"],["、"],["わたし"],["を"],["裏切ろう","うらぎろう"],["として"],["いる"],["」"],["。"]]},{"verse":22,"text":"弟子,でしたちは非常,ひじょうに心配,しんぱいして、つぎつぎに「主,しゅよ、まさか、わたしではないでしょう」と言,いい出,だした。","tok":[["弟子","でし"],["たち"],["は"],["非常","ひじょう"],["に"],["心配","しんぱい"],["して"],["、"],["つぎつぎ"],["に"],["「"],["主","しゅ"],["よ"],["、"],["まさか"],["、"],["わたし"],["で"],["は"],["ないでしょう"],["」"],["と"],["言い","いい"],["出した","だした"],["。"]]},{"verse":23,"text":"イエスは答,こたえて言,いわれた、「わたしと一緒,いっしょに同,おなじ鉢,はちに手,てを入,いれている者,ものが、わたしを裏切,うらぎろうとしている。","tok":[["イエス"],["は"],["答","こたえ"],["て"],["言われた","いわれた"],["、"],["「"],["わたし"],["と"],["一緒","いっしょ"],["に"],["同じ","おなじ"],["鉢","はち"],["に"],["手","て"],["を"],["入れて","いれて"],["いる"],["者","もの"],["が"],["、"],["わたし"],["を"],["裏切ろう","うらぎろう"],["として"],["いる"],["。"]]},{"verse":24,"text":"たしかに人,ひとの子,こは、自分,じぶんについて書,かいてあるとおりに去,さって行,いく。しかし、人,ひとの子,こを裏切,うらぎるその人,ひとは、わざわいである。その人,ひとは生,うまれなかった方,ほうが、彼,かれのためによかったであろう」。","tok":[["たしか"],["に"],["人","ひと"],["の"],["子","こ"],["は"],["、"],["自分","じぶん"],["について"],["書いて","かいて"],["ある"],["とおり"],["に"],["去て","さって"],["行く","いく"],["。"],["しかし"],["、"],["人","ひと"],["の"],["子","こ"],["を"],["裏切る","うらぎる"],["その"],["人","ひと"],["は"],["、"],["わざわい"],["で"],["ある"],["。"],["その"],["人","ひと"],["は"],["生まれなかった","うまれなかった"],["方","ほう"],["が"],["、"],["彼","かれ"],["の"],["ため"],["に"],["よかったで"],["あろう"],["」"],["。"]]},{"verse":25,"text":"イエスを裏切,うらぎったユダが答,こたえて言,いった、「先生,せんせい、まさか、わたしではないでしょう」。イエスは言,いわれた、「いや、あなただ」。","tok":[["イエス"],["を"],["裏切った","うらぎった"],["ユダ"],["が"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["先生","せんせい"],["、"],["まさか"],["、"],["わたし"],["で"],["は"],["ないでしょう"],["」"],["。"],["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["いや"],["、"],["あなた"],["だ"],["」"],["。"]]},{"verse":26,"text":"一同,いちどうが食事,しょくじをしているとき、イエスはパンを取,とり、祝福,しゅくふくしてこれをさき、弟子,でしたちに与,あたえて言,いわれた、「取,とって食,たべよ、これはわたしのからだである」。","tok":[["一同","いちどう"],["が"],["食事","しょくじ"],["を"],["して"],["いる"],["とき"],["、"],["イエス"],["は"],["パン"],["を"],["取","とり"],["、"],["祝福","しゅくふく"],["して"],["これ"],["を"],["さき"],["、"],["弟子","でし"],["たち"],["に"],["与","あたえ"],["て"],["言われた","いわれた"],["、"],["「"],["取って","とって"],["食べよ","たべよ"],["、"],["これ"],["は"],["わたし"],["の"],["からだ"],["で"],["ある"],["」"],["。"]]},{"verse":27,"text":"また杯,さかずきを取,とり、感謝,かんしゃして彼,かれらに与,あたえて言,いわれた、「みな、この杯,さかずきから飲,のめ。","tok":[["また"],["杯","さかずき"],["を"],["取","とり"],["、"],["感謝","かんしゃ"],["して"],["彼","かれ"],["ら"],["に"],["与","あたえ"],["て"],["言われた","いわれた"],["、"],["「"],["みな"],["、"],["この"],["杯","さかずき"],["から"],["飲め","のめ"],["。"]]},{"verse":28,"text":"これは、罪,つみのゆるしを得,えさせるようにと、多,おおくの人,ひとのために流,ながすわたしの契約,けいやくの血,ちである。","tok":[["これ"],["は"],["、"],["罪","つみ"],["の"],["ゆるし"],["を"],["得させる","えさせる"],["よう"],["に"],["と"],["、"],["多く","おおく"],["の"],["人","ひと"],["の"],["ため"],["に"],["流す","ながす"],["わたし"],["の"],["契約","けいやく"],["の"],["血","ち"],["で"],["ある"],["。"]]},{"verse":29,"text":"あなたがたに言,いっておく。わたしの父,ちちの国,くにであなたがたと共,ともに、新,あたらしく飲,のむその日,ひまでは、わたしは今後,こんご決,けっして、ぶどうの実,みから造,つくったものを飲,のむことをしない」。","tok":[["あなた"],["がた"],["に"],["言って","いって"],["おく"],["。"],["わたし"],["の"],["父","ちち"],["の"],["国","くに"],["で"],["あなた"],["がた"],["と"],["共","とも"],["に"],["、"],["新らしく","あたらしく"],["飲む","のむ"],["その"],["日","ひ"],["まで"],["は"],["、"],["わたし"],["は"],["今後","こんご"],["決っして","けっして"],["、"],["ぶどう"],["の"],["実ら","みから"],["造った","つくった"],["もの"],["を"],["飲む","のむ"],["こと"],["を"],["しない"],["」"],["。"]]},{"verse":30,"text":"彼,かれらは、さんびを歌,うたった後,のち、オリブ山,やまへ出,でかけて行,いった。","tok":[["彼","かれ"],["ら"],["は"],["、"],["さん"],["び"],["を"],["歌った","うたった"],["後","の"],["ち"],["、"],["オリブ山","おりぶやま"],["へ"],["出かけて","でかけて"],["行った","いった"],["。"]]},{"verse":31,"text":"そのとき、イエスは弟子,でしたちに言,いわれた、「今夜,こんや、あなたがたは皆,みなわたしにつまずくであろう。『わたしは羊飼,ひつじかいを打,うつ。そして、羊,ひつじの群,むれは散,ちらされるであろう』と、書,かいてあるからである。","tok":[["その"],["とき"],["、"],["イエス"],["は"],["弟子","でし"],["たち"],["に"],["言われた","いわれた"],["、"],["「"],["今夜","こんや"],["、"],["あなた"],["がた"],["は"],["皆","みな"],["わたし"],["に"],["つまずくで"],["あろう"],["。"],["『"],["わたし"],["は"],["羊飼","ひつじかい"],["を"],["打つ","うつ"],["。"],["そして"],["、"],["羊","ひつじ"],["の"],["群れ","むれ"],["は"],["散らされるで","ちらされるで"],["あろう"],["』"],["と"],["、"],["書いて","かいて"],["ある"],["から"],["で"],["ある"],["。"]]},{"verse":32,"text":"しかしわたしは、よみがえってから、あなたがたより先,さきにガリラヤへ行,いくであろう」。","tok":[["しかし"],["わたし"],["は"],["、"],["よみがえって"],["から"],["、"],["あなた"],["が"],["たより"],["先","さき"],["に"],["ガリラヤ"],["へ"],["行くで","いくで"],["あろう"],["」"],["。"]]},{"verse":33,"text":"するとペテロはイエスに答,こたえて言,いった、「たとい、みんなの者,ものがあなたにつまずいても、わたしは決,けっしてつまずきません」。","tok":[["する"],["と"],["ペテロ"],["は"],["イエス"],["に"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["たとい"],["、"],["みんな"],["の"],["者","もの"],["が"],["あなた"],["に"],["つまずいて"],["も"],["、"],["わたし"],["は"],["決っして","けっして"],["つまずきません"],["」"],["。"]]},{"verse":34,"text":"イエスは言,いわれた、「よくあなたに言,いっておく。今夜,こんや、鶏,にわとりが鳴,なく前,まえに、あなたは三度,どわたしを知,しらないと言,いうだろう」。","tok":[["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["よく"],["あなた"],["に"],["言って","いって"],["おく"],["。"],["今夜","こんや"],["、"],["鶏","にわとり"],["が"],["鳴く","なく"],["前","まえ"],["に"],["、"],["あなた"],["は"],["三","さん"],["度","ど"],["を"],["知らない","しらない"],["と"],["言うだろう","いうだろう"],["」"],["。"]]},{"verse":35,"text":"ペテロは言,いった、「たといあなたと一緒,いっしょに死,しなねばならなくなっても、あなたを知,しらないなどとは、決,けっして申,もうしません」。弟子,でしたちもみな同,おなじように言,いった。","tok":[["ペテロ"],["は"],["言った","いった"],["、"],["「"],["たとい"],["あなた"],["と"],["一緒","いっしょ"],["に"],["死なねば","しなねば"],["ならなく"],["なって"],["も"],["、"],["あなた"],["を"],["知らない","しらない"],["など"],["と"],["は"],["、"],["決っして","けっして"],["申しません","もうしません"],["」"],["。"],["弟子","でし"],["たち"],["も"],["みな"],["同じ","おなじ"],["よう"],["に"],["言った","いった"],["。"]]},{"verse":36,"text":"それから、イエスは彼,かれらと一緒,いっしょに、ゲツセマネという所,ところへ行,いかれた。そして弟子,でしたちに言,いわれた、「わたしが向,むこうへ行,いって祈,いのっている間,あいだ、ここにすわっていなさい」。","tok":[["それ"],["から"],["、"],["イエス"],["は"],["彼","かれ"],["ら"],["と"],["一緒","いっしょ"],["に"],["、"],["ゲツセマネ"],["と"],["いう"],["所","ところ"],["へ"],["行かれた","いかれた"],["。"],["そして"],["弟子","でし"],["たち"],["に"],["言われた","いわれた"],["、"],["「"],["わたし"],["が"],["向こう","むこう"],["へ"],["行って","いって"],["祈って","いのって"],["いる"],["間","あいだ"],["、"],["ここ"],["に"],["すわって"],["い"],["なさい"],["」"],["。"]]},{"verse":37,"text":"そしてペテロとゼベダイの子,こふたりとを連,つれて行,いかれたが、悲,かなしみを催,もよおしまた悩,なやみはじめられた。","tok":[["そして"],["ペテロ"],["と"],["ゼベダイ"],["の"],["子","こ"],["ふたり"],["と"],["を"],["連れて","つれて"],["行かれた","いかれた"],["が"],["、"],["悲しみ","かなしみ"],["を"],["催","もよおし"],["また"],["悩み","なやみ"],["はじめられた"],["。"]]},{"verse":38,"text":"そのとき、彼,かれらに言,いわれた、「わたしは悲,かなしみのあまり死,しぬほどである。ここに待,まっていて、わたしと一緒,いっしょに目,めをさましていなさい」。","tok":[["その"],["とき"],["、"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["わたし"],["は"],["悲しみ","かなしみ"],["の"],["あまり"],["死ぬ","しぬ"],["ほど"],["で"],["ある"],["。"],["ここ"],["に"],["待って","まって"],["いて"],["、"],["わたし"],["と"],["一緒","いっしょ"],["に"],["目","め"],["を"],["さまして"],["い"],["なさい"],["」"],["。"]]},{"verse":39,"text":"そして少,すこし進,すすんで行,いき、うつぶしになり、祈,いのって言,いわれた、「わが父,ちちよ、もしできることでしたらどうか、この杯,さかずきをわたしから過,すぎ去,さらせてください。しかし、わたしの思,おもいのままにではなく、みこころのままになさって下,ください」。","tok":[["そして"],["少し","すこし"],["進んで","すすんで"],["行き","いき"],["、"],["うつぶし"],["に"],["なり"],["、"],["祈って","いのって"],["言われた","いわれた"],["、"],["「"],["わが"],["父","ちち"],["よ"],["、"],["もし"],["できる"],["こと"],["でしたら"],["どう"],["か"],["、"],["この"],["杯","さかずき"],["を"],["わたし"],["から"],["過去らせて","すぎさらせて"],["ください"],["。"],["しかし"],["、"],["わたし"],["の"],["思い","おもい"],["の"],["まま"],["に"],["で"],["は"],["なく"],["、"],["みこころ"],["の"],["まま"],["に"],["なさって"],["下さい","ください"],["」"],["。"]]},{"verse":40,"text":"それから、弟子,でしたちの所,ところにきてごらんになると、彼,かれらが眠,ねむっていたので、ペテロに言,いわれた、「あなたがたはそんなに、ひと時,ときもわたしと一緒,いっしょに目,めをさましていることが、できなかったのか。","tok":[["それ"],["から"],["、"],["弟子","でし"],["たち"],["の"],["所","ところ"],["に"],["きて"],["ごらん"],["に"],["なる"],["と"],["、"],["彼","かれ"],["ら"],["が"],["眠って","ねむって"],["いた"],["ので"],["、"],["ペテロ"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["がた"],["は"],["そんな"],["に"],["、"],["ひと時","ひととき"],["も"],["わたし"],["と"],["一緒","いっしょ"],["に"],["目","め"],["を"],["さまして"],["いる"],["こと"],["が"],["、"],["できなかった"],["の"],["か"],["。"]]},{"verse":41,"text":"誘惑,ゆうわくに陥,おちいらないように、目,めをさまして祈,いのっていなさい。心,こころは熱,ねっしているが、肉体,にくたいが弱,よわいのである」。","tok":[["誘惑","ゆうわく"],["に"],["陥ち","おち"],["いらない"],["よう"],["に"],["、"],["目","め"],["を"],["さまして"],["祈って","いのって"],["い"],["なさい"],["。"],["心","こころ"],["は"],["熱して","ねっして"],["いる"],["が"],["、"],["肉体","にくたい"],["が"],["弱い","よわい"],["ので"],["ある"],["」"],["。"]]},{"verse":42,"text":"また二度目,どめに行,いって、祈,いのって言,いわれた、「わが父,ちちよ、この杯,さかずきを飲,のむほかに道,みちがないのでしたら、どうか、みこころが行,おこなわれますように」。","tok":[["また"],["二度目","どめ"],["に"],["行って","いって"],["、"],["祈って","いのって"],["言われた","いわれた"],["、"],["「"],["わが"],["父","ちち"],["よ"],["、"],["この"],["杯","さかずき"],["を"],["飲む","のむ"],["ほか"],["に"],["道","みち"],["が"],["ない"],["の"],["でしたら"],["、"],["どう"],["か"],["、"],["みこころ"],["が"],["行なわれます","おこなわれます"],["よう"],["に"],["」"],["。"]]},{"verse":43,"text":"またきてごらんになると、彼,かれらはまた眠,ねむっていた。その目,めが重,おもくなっていたのである。","tok":[["また"],["きて"],["ごらん"],["に"],["なる"],["と"],["、"],["彼","かれ"],["ら"],["は"],["また"],["眠って","ねむって"],["いた"],["。"],["その"],["目","め"],["が"],["重く","おもく"],["なって"],["いた"],["ので"],["ある"],["。"]]},{"verse":44,"text":"それで彼,かれらをそのままにして、また行,いって、三度目,どめに同,おなじ言葉,ことばで祈,いのられた。","tok":[["それ"],["で"],["彼","かれ"],["ら"],["を"],["そのまま"],["に"],["して"],["、"],["また"],["行って","いって"],["、"],["三度目","どめ"],["に"],["同じ","おなじ"],["言葉","ことば"],["で"],["祈られた","いのられた"],["。"]]},{"verse":45,"text":"それから弟子,でしたちの所,ところに帰,かえってきて、言,いわれた、「まだ眠,ねむっているのか、休,やすんでいるのか。見,みよ、時,ときが迫,せまった。人,ひとの子,こは罪人,つみびとらの手,てに渡,わたされるのだ。","tok":[["それ"],["から"],["弟子","でし"],["たち"],["の"],["所","ところ"],["に"],["帰えって","かえって"],["きて"],["、"],["言われた","いわれた"],["、"],["「"],["まだ"],["眠って","ねむって"],["いる"],["の"],["か"],["、"],["休す","やす"],["ん"],["で"],["いる"],["の"],["か"],["。"],["見よ","みよ"],["、"],["時","とき"],["が"],["迫まった","せまった"],["。"],["人","ひと"],["の"],["子","こ"],["は"],["罪人","つみびとら"],["の"],["手","て"],["に"],["渡される","わたされる"],["の"],["だ"],["。"]]},{"verse":46,"text":"立,たて、さあ行,いこう。見,みよ、わたしを裏切,うらぎる者,ものが近,ちかづいてきた」。","tok":[["立","たて"],["、"],["さあ"],["行こう","いこう"],["。"],["見よ","みよ"],["、"],["わたし"],["を"],["裏切る","うらぎる"],["者","もの"],["が"],["近づいて","ちかづいて"],["きた"],["」"],["。"]]},{"verse":47,"text":"そして、イエスがまだ話,はなしておられるうちに、そこに、十二弟子,でしのひとりのユダがきた。また祭司長,さいしちょう、民,たみの長老,ちょうろうたちから送,おくられた大,おおぜいの群衆,ぐんしゅうも、剣,けんと棒,ぼうとを持,もって彼,かれについてきた。","tok":[["そして"],["、"],["イエス"],["が"],["まだ"],["話","はなし"],["て"],["おられる"],["うち"],["に"],["、"],["そこ"],["に"],["、"],["十二","じゅうに"],["弟子","でし"],["の"],["ひとり"],["の"],["ユダ"],["が"],["きた"],["。"],["また"],["祭司長","さいしちょう"],["、"],["民","たみ"],["の"],["長老","ちょうろう"],["たち"],["から"],["送られた","おくられた"],["大ぜい","おおぜい"],["の"],["群衆","ぐんしゅう"],["も"],["、"],["剣","けん"],["と"],["棒","ぼう"],["と"],["を"],["持って","もって"],["彼","かれ"],["について"],["きた"],["。"]]},{"verse":48,"text":"イエスを裏切,うらぎった者,ものが、あらかじめ彼,かれらに、「わたしの接吻,せっぷんする者,ものが、その人,ひとだ。その人,ひとをつかまえろ」と合図,あいずをしておいた。","tok":[["イエス"],["を"],["裏切った","うらぎった"],["者","もの"],["が"],["、"],["あらかじめ"],["彼","かれ"],["ら"],["に"],["、"],["「"],["わたし"],["の"],["接吻","せっぷん"],["する"],["者","もの"],["が"],["、"],["その"],["人","ひと"],["だ"],["。"],["その"],["人","ひと"],["を"],["つかまえろ"],["」"],["と"],["合図","あいず"],["を"],["して"],["おいた"],["。"]]},{"verse":49,"text":"彼,かれはすぐイエスに近寄,ちかより、「先生,せんせい、いかがですか」と言,いって、イエスに接吻,せっぷんした。","tok":[["彼","かれ"],["は"],["すぐ"],["イエス"],["に"],["近寄り","ちかより"],["、"],["「"],["先生","せんせい"],["、"],["いかが"],["です"],["か"],["」"],["と"],["言って","いって"],["、"],["イエス"],["に"],["接吻","せっぷん"],["した"],["。"]]},{"verse":50,"text":"しかし、イエスは彼,かれに言,いわれた、「友,ともよ、なんのためにきたのか」。このとき、人々,ひとびとが進,すすみ寄,よって、イエスに手,てをかけてつかまえた。","tok":[["しかし"],["、"],["イエス"],["は"],["彼","かれ"],["に"],["言われた","いわれた"],["、"],["「"],["友","とも"],["よ"],["、"],["なん"],["の"],["ため"],["に"],["きた"],["の"],["か"],["」"],["。"],["この"],["とき"],["、"],["人々","ひとびと"],["が"],["進み寄って","すすみよって"],["、"],["イエス"],["に"],["手","て"],["を"],["かけて"],["つかまえた"],["。"]]},{"verse":51,"text":"すると、イエスと一緒,いっしょにいた者,もののひとりが、手,てを伸,のばして剣,けんを抜,ぬき、そして大祭司,だいさいしの僕,しもべに切,きりかかって、その片耳,かたみみを切,きり落,おとした。","tok":[["する"],["と"],["、"],["イエス"],["と"],["一緒","いっしょ"],["に"],["いた"],["者","もの"],["の"],["ひとり"],["が"],["、"],["手","て"],["を"],["伸ばして","のばして"],["剣","けん"],["を"],["抜き","ぬき"],["、"],["そして"],["大","だい"],["祭司","さいし"],["の"],["僕","し"],["も"],["べ"],["に"],["切り","きり"],["かかって"],["、"],["その"],["片耳","かたみみ"],["を"],["切り落とした","きりおとした"],["。"]]},{"verse":52,"text":"そこで、イエスは彼,かれに言,いわれた、「あなたの剣,けんをもとの所,ところにおさめなさい。剣,けんをとる者,ものはみな、剣,けんで滅,ほろびる。","tok":[["そこ"],["で"],["、"],["イエス"],["は"],["彼","かれ"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["の"],["剣","けん"],["を"],["もと"],["の"],["所","ところ"],["に"],["おさめ"],["なさい"],["。"],["剣","けん"],["を"],["とる"],["者","もの"],["は"],["みな"],["、"],["剣","けん"],["で"],["滅びる","ほろびる"],["。"]]},{"verse":53,"text":"それとも、わたしが父,ちちに願,ねがって、天,てんの使,つかいたちを十二軍団,ぐんだん以上,いじょうも、今,いまつかわしていただくことができないと、あなたは思,おもうのか。","tok":[["それ"],["と"],["も"],["、"],["わたし"],["が"],["父","ちち"],["に"],["願って","ねがって"],["、"],["天","てん"],["の"],["使","つかい"],["たち"],["を"],["十二","じゅうに"],["軍団","ぐんだん"],["だん"],["以上","いじょう"],["も"],["、"],["今","いま"],["つかわして"],["いただく"],["こと"],["が"],["できない"],["と"],["、"],["あなた"],["は"],["思","おもう"],["の"],["か"],["。"]]},{"verse":54,"text":"しかし、それでは、こうならねばならないと書,かいてある聖書,せいしょの言葉,ことばは、どうして成就,じょうじゅされようか」。","tok":[["しかし"],["、"],["それ"],["で"],["は"],["、"],["こう"],["ならねば"],["ならない"],["と"],["書いて","かいて"],["ある"],["聖書","せいしょ"],["の"],["言葉","ことば"],["は"],["、"],["どう"],["して"],["成就","じょうじゅ"],["されよう"],["か"],["」"],["。"]]},{"verse":55,"text":"そのとき、イエスは群衆,ぐんしゅうに言,いわれた、「あなたがたは強盗,ごうとうにむかうように、剣,けんや棒,ぼうを持,もってわたしを捕,とらえにきたのか。わたしは毎日,まいにち、宮,みやですわって教,おしえていたのに、わたしをつかまえはしなかった。","tok":[["その"],["とき"],["、"],["イエス"],["は"],["群衆","ぐんしゅう"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["がた"],["は"],["強盗","ごうとう"],["に"],["むかう"],["よう"],["に"],["、"],["剣","けん"],["や"],["棒","ぼう"],["を"],["持って","もって"],["わたし"],["を"],["捕らえ","とらえ"],["に"],["きた"],["の"],["か"],["。"],["わたし"],["は"],["毎日","まいにち"],["、"],["宮","みや"],["で"],["すわって"],["教えて","おしえて"],["いた"],["のに"],["、"],["わたし"],["を"],["つかまえ"],["は"],["しなかった"],["。"]]},{"verse":56,"text":"しかし、すべてこうなったのは、預言者,よげんしゃたちの書,かいたことが、成就,じょうじゅするためである」。そのとき、弟子,でしたちは皆,みなイエスを見捨,みすてて逃,にげ去,さった。","tok":[["しかし"],["、"],["すべて"],["こう"],["なった"],["の"],["は"],["、"],["預言者","よげんしゃ"],["たち"],["の"],["書いた","かいた"],["こと"],["が"],["、"],["成就","じょうじゅ"],["する"],["ため"],["で"],["ある"],["」"],["。"],["その"],["とき"],["、"],["弟子","でし"],["たち"],["は"],["皆","みな"],["イエス"],["を"],["見捨てて","みすてて"],["逃去","にげさっ"],["た"],["。"]]},{"verse":57,"text":"さて、イエスをつかまえた人,ひとたちは、大祭司,だいさいしカヤパのところにイエスを連,つれて行,いった。そこには律法,りっぽう学者,がくしゃ、長老,ちょうろうたちが集,あつまっていた。","tok":[["さて"],["、"],["イエス"],["を"],["つかまえた"],["人","ひと"],["たち"],["は"],["、"],["大","だい"],["祭司","さいし"],["カヤパ"],["の"],["ところ"],["に"],["イエス"],["を"],["連れて","つれて"],["行った","いった"],["。"],["そこ"],["に"],["は"],["律法学者","りっぽうがくしゃ"],["、"],["長老","ちょうろう"],["たち"],["が"],["集まって","あつまって"],["いた"],["。"]]},{"verse":58,"text":"ペテロは遠,とおくからイエスについて、大祭司,だいさいしの中庭,なかにわまで行,いき、そのなりゆきを見,みとどけるために、中,なかにはいって下役,したやくどもと一緒,いっしょにすわっていた。","tok":[["ペテロ"],["は"],["遠く","とおく"],["から"],["イエス"],["について"],["、"],["大","だい"],["祭司","さいし"],["の"],["中庭","なかにわ"],["まで"],["行き","いき"],["、"],["その"],["なりゆき"],["を"],["見とどける","みとどける"],["ため"],["に"],["、"],["中","なか"],["に"],["はいって"],["下役","したやく"],["ども"],["と"],["一緒","いっしょ"],["に"],["すわって"],["いた"],["。"]]},{"verse":59,"text":"さて、祭司長,さいしちょうたちと全,ぜん議会,ぎかいとは、イエスを死刑,しけいにするため、イエスに不利,ふりな偽証,ぎしょうを求,もとめようとしていた。","tok":[["さて"],["、"],["祭司長","さいしちょう"],["たち"],["と"],["全","ぜん"],["議会","ぎかい"],["と"],["は"],["、"],["イエス"],["を"],["死刑","しけい"],["に"],["する"],["ため"],["、"],["イエス"],["に"],["不利","ふり"],["な"],["偽証","ぎしょう"],["を"],["求めよう","もとめよう"],["として"],["いた"],["。"]]},{"verse":60,"text":"そこで多,おおくの偽証者,ぎしょうしゃが出,でてきたが、証拠,しょうこがあがらなかった。しかし、最後,さいごにふたりの者,ものが出,でてきて","tok":[["そこ"],["で"],["多く","おおく"],["の"],["偽証者","ぎしょうしゃ"],["が"],["出て","でて"],["きた"],["が"],["、"],["証拠","しょうこ"],["が"],["あがらなかった"],["。"],["しかし"],["、"],["最後","さいご"],["に"],["ふたり"],["の"],["者","もの"],["が"],["出て","でて"],["きて"]]},{"verse":61,"text":"言,いった、「この人,ひとは、わたしは神,かみの宮,みやを打,うちこわし、三日,かの後,のちに建,たてることができる、と言,いいました」。","tok":[["言った","いった"],["、"],["「"],["この"],["人","ひと"],["は"],["、"],["わたし"],["は"],["神","かみ"],["の"],["宮","みや"],["を"],["打ちこわし","うちこわし"],["、"],["三日","か"],["の"],["後","のち"],["に"],["建てる","たてる"],["こと"],["が"],["できる"],["、"],["と"],["言いました","いいました"],["」"],["。"]]},{"verse":62,"text":"すると、大祭司,だいさいしが立,たち上,あがってイエスに言,いった、「何,なにも答,こたえないのか。これらの人々,ひとびとがあなたに対,たいして不利,ふりな証言,しょうげんを申,もうし立,たてているが、どうなのか」。","tok":[["する"],["と"],["、"],["大","だい"],["祭司","さいし"],["が"],["立ち上がって","たちあがって"],["イエス"],["に"],["言った","いった"],["、"],["「"],["何に","なに"],["も"],["答","こたえ"],["ない"],["の"],["か"],["。"],["これ"],["ら"],["の"],["人々","ひとびと"],["が"],["あなた"],["に対して","にたいして"],["不利","ふり"],["な"],["証言","しょうげん"],["を"],["申し立て","もうしたてて"],["いる"],["が"],["、"],["どう"],["な"],["の"],["か"],["」"],["。"]]},{"verse":63,"text":"しかし、イエスは黙,だまっておられた。そこで大祭司,だいさいしは言,いった、「あなたは神,かみの子,こキリストなのかどうか、生,いける神,かみに誓,ちかってわれわれに答,こたえよ」。","tok":[["しかし"],["、"],["イエス"],["は"],["黙って","だまって"],["おられた"],["。"],["そこ"],["で"],["大","だい"],["祭司","さいし"],["は"],["言った","いった"],["、"],["「"],["あなた"],["は"],["神","かみ"],["の"],["子","こ"],["キリスト"],["な"],["の"],["か"],["どう"],["か"],["、"],["生ける","いける"],["神","かみ"],["に"],["誓って","ちかって"],["われわれ"],["に"],["答","こたえ"],["よ"],["」"],["。"]]},{"verse":64,"text":"イエスは彼,かれに言,いわれた、「あなたの言,いうとおりである。しかし、わたしは言,いっておく。あなたがたは、間,まもなく、人,ひとの子,こが力,ちからある者,ものの右,みぎに座,ざし、天,てんの雲,くもに乗,のって来,くるのを見,みるであろう」。","tok":[["イエス"],["は"],["彼","かれ"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["の"],["言う","いう"],["とおり"],["で"],["ある"],["。"],["しかし"],["、"],["わたし"],["は"],["言って","いって"],["おく"],["。"],["あなた"],["がた"],["は"],["、"],["間","ま"],["も"],["なく"],["、"],["人","ひと"],["の"],["子","こ"],["が"],["力","ちから"],["ある"],["者","もの"],["の"],["右","みぎ"],["に"],["座し","ざし"],["、"],["天","てん"],["の"],["雲","くも"],["に"],["乗って","のって"],["来る","くる"],["の"],["を"],["見るで","みるで"],["あろう"],["」"],["。"]]},{"verse":65,"text":"すると、大祭司,だいさいしはその衣,ころもを引,ひき裂,さいて言,いった、「彼,かれは神,かみを汚,けがした。どうしてこれ以上,いじょう、証人,しょうにんの必要,ひつようがあろう。あなたがたは今,いまこのけがし言,ごとを聞,きいた。","tok":[["する"],["と"],["、"],["大","だい"],["祭司","さいし"],["は"],["その"],["衣","ころも"],["を"],["引裂いて","ひきさいて"],["言った","いった"],["、"],["「"],["彼","かれ"],["は"],["神","かみ"],["を"],["汚","け"],["がした"],["。"],["どう"],["して"],["これ"],["以上","いじょう"],["、"],["証人","しょうにん"],["の"],["必要","ひつよう"],["が"],["あろう"],["。"],["あなた"],["がた"],["は"],["今","いま"],["この"],["けが"],["し"],["言","ごと"],["を"],["聞いた","きいた"],["。"]]},{"verse":66,"text":"あなたがたの意見,いけんはどうか」。すると、彼,かれらは答,こたえて言,いった、「彼,かれは死,しに当,あたるものだ」。","tok":[["あなた"],["がた"],["の"],["意見","いけん"],["は"],["どう"],["か"],["」"],["。"],["する"],["と"],["、"],["彼","かれ"],["ら"],["は"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["彼","かれ"],["は"],["死","し"],["に"],["当たる","あたる"],["もの"],["だ"],["」"],["。"]]},{"verse":67,"text":"それから、彼,かれらはイエスの顔,かおにつばきをかけて、こぶしで打,うち、またある人,ひとは手,てのひらでたたいて言,いった、","tok":[["それ"],["から"],["、"],["彼","かれ"],["ら"],["は"],["イエス"],["の"],["顔","かお"],["に"],["つばき"],["を"],["かけて"],["、"],["こぶし"],["で"],["打ち","うち"],["、"],["また"],["ある"],["人","ひと"],["は"],["手のひら","てのひら"],["で"],["たたいて"],["言った","いった"],["、"]]},{"verse":68,"text":"「キリストよ、言,いいあててみよ、打,うったのはだれか」。","tok":[["「"],["キリスト"],["よ"],["、"],["言いあてて","いいあてて"],["みよ"],["、"],["打った","うった"],["の"],["は"],["だれ"],["か"],["」"],["。"]]},{"verse":69,"text":"ペテロは外,そとで中庭,なかにわにすわっていた。するとひとりの女中,じょちゅうが彼,かれのところにきて、「あなたもあのガリラヤ人,びとイエスと一緒,いっしょだった」と言,いった。","tok":[["ペテロ"],["は"],["外","そと"],["で"],["中庭","なかにわ"],["に"],["すわって"],["いた"],["。"],["する"],["と"],["ひとり"],["の"],["女中","じょちゅう"],["が"],["彼","かれ"],["の"],["ところ"],["に"],["きて"],["、"],["「"],["あなた"],["も"],["あの"],["ガリラヤ"],["人","び"],["と"],["イエス"],["と"],["一緒","いっしょ"],["だった"],["」"],["と"],["言った","いった"],["。"]]},{"verse":70,"text":"するとペテロは、みんなの前,まえでそれを打,うち消,けして言,いった、「あなたが何,なにを言,いっているのか、わからない」。","tok":[["する"],["と"],["ペテロ"],["は"],["、"],["みんな"],["の"],["前","まえ"],["で"],["それ"],["を"],["打ち消して","うちけして"],["言った","いった"],["、"],["「"],["あなた"],["が"],["何に","なに"],["を"],["言って","いって"],["いる"],["の"],["か"],["、"],["わからない"],["」"],["。"]]},{"verse":71,"text":"そう言,いって入口,いりぐちの方,ほうに出,でて行,いくと、ほかの女中,じょちゅうが彼,かれを見,みて、そこにいる人々,ひとびとにむかって、「この人,ひとはナザレ人,びとイエスと一緒,いっしょだった」と言,いった。","tok":[["そう"],["言って","いって"],["入口","いりぐち"],["の"],["方","ほう"],["に"],["出て","でて"],["行く","いく"],["と"],["、"],["ほか"],["の"],["女中","じょちゅう"],["が"],["彼","かれ"],["を"],["見て","みて"],["、"],["そこ"],["に"],["いる"],["人々","ひとびと"],["に"],["むかって"],["、"],["「"],["この"],["人","ひと"],["は"],["ナザレ人","なざれび"],["と"],["イエス"],["と"],["一緒","いっしょ"],["だった"],["」"],["と"],["言った","いった"],["。"]]},{"verse":72,"text":"そこで彼,かれは再,ふたたびそれを打,うち消,けして、「そんな人,ひとは知,しらない」と誓,ちかって言,いった。","tok":[["そこ"],["で"],["彼","かれ"],["は"],["再び","ふたたび"],["それ"],["を"],["打ち消して","うちけして"],["、"],["「"],["そんな"],["人","ひと"],["は"],["知らない","しらない"],["」"],["と"],["誓って","ちかって"],["言った","いった"],["。"]]},{"verse":73,"text":"しばらくして、そこに立,たっていた人々,ひとびとが近寄,ちかよってきて、ペテロに言,いった、「確,たしかにあなたも彼,かれらの仲間,なかまだ。言葉,ことばづかいであなたのことがわかる」。","tok":[["しばらく"],["して"],["、"],["そこ"],["に"],["立って","たって"],["いた"],["人々","ひとびと"],["が"],["近寄って","ちかよって"],["きて"],["、"],["ペテロ"],["に"],["言った","いった"],["、"],["「"],["確か","たしか"],["に"],["あなた"],["も"],["彼","かれ"],["ら"],["の"],["仲間","なかま"],["だ"],["。"],["言葉づかい","ことばづかい"],["で"],["あなた"],["の"],["こと"],["が"],["わかる"],["」"],["。"]]},{"verse":74,"text":"彼,かれは「その人,ひとのことは何,なにも知,しらない」と言,いって、激,はげしく誓,ちかいはじめた。するとすぐ鶏,にわとりが鳴,ないた。","tok":[["彼","かれ"],["は"],["「"],["その"],["人","ひと"],["の"],["こと"],["は"],["何に","なに"],["も"],["知らない","しらない"],["」"],["と"],["言って","いって"],["、"],["激しく","はげしく"],["誓い","ちかい"],["はじめた"],["。"],["する"],["と"],["すぐ"],["鶏","にわとり"],["が"],["鳴いた","ないた"],["。"]]},{"verse":75,"text":"ペテロは「鶏,にわとりが鳴,なく前,まえに、三度,どわたしを知,しらないと言,いうであろう」と言,いわれたイエスの言葉,ことばを思,おもい出,だし、外,そとに出,でて激,はげしく泣,ないた。","tok":[["ペテロ"],["は"],["「"],["鶏","にわとり"],["が"],["鳴く","なく"],["前","まえ"],["に"],["、"],["三","さん"],["度","ど"],["を"],["知らない","しらない"],["と"],["言うで","いうで"],["あろう"],["」"],["と"],["言われた","いわれた"],["イエス"],["の"],["言葉","ことば"],["を"],["思い出し","おもいだし"],["、"],["外","そと"],["に"],["出て","でて"],["激しく","はげしく"],["泣いた","ないた"],["。"]]}]
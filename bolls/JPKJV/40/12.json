[{"verse":1,"text":"そのころ、ある安息日,あんそくにちに、イエスは麦畑,むぎばたけの中,なかを通,とおられた。すると弟子,でしたちは、空腹,くうふくであったので、穂,ほを摘,つんで食,たべはじめた。","tok":[["その"],["ころ"],["、"],["ある"],["安息日","あんそくにち"],["に"],["、"],["イエス"],["は"],["麦畑","むぎばたけ"],["の"],["中","なか"],["を"],["通られた","とおられた"],["。"],["する"],["と"],["弟子","でし"],["たち"],["は"],["、"],["空腹","くうふく"],["で"],["あった"],["ので"],["、"],["穂","ほ"],["を"],["摘んで","つんで"],["食べ","たべ"],["はじめた"],["。"]]},{"verse":2,"text":"パリサイ人,びとたちがこれを見,みて、イエスに言,いった、「ごらんなさい、あなたの弟子,でしたちが、安息日,あんそくにちにしてはならないことをしています」。","tok":[["パリサイ"],["人","びと"],["たち"],["が"],["これ"],["を"],["見て","みて"],["、"],["イエス"],["に"],["言った","いった"],["、"],["「"],["ごらん"],["なさい"],["、"],["あなた"],["の"],["弟子","でし"],["たち"],["が"],["、"],["安息日","あんそくにち"],["に"],["して"],["は"],["ならない"],["こと"],["を"],["して"],["います"],["」"],["。"]]},{"verse":3,"text":"そこでイエスは彼,かれらに言,いわれた、「あなたがたは、ダビデとその供,ともの者,ものたちとが飢,うえたとき、ダビデが何,なにをしたか読,よんだことがないのか。","tok":[["そこ"],["で"],["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["がた"],["は"],["、"],["ダビデ"],["と"],["その"],["供","とも"],["の"],["者","もの"],["たち"],["と"],["が"],["飢","うえ"],["た"],["とき"],["、"],["ダビデ"],["が"],["何に","なに"],["を"],["した"],["か"],["読","よんだこ"],["と"],["が"],["ない"],["の"],["か"],["。"]]},{"verse":4,"text":"すなわち、神,かみの家,いえにはいって、祭司,さいしたちのほか、自分,じぶんも供,ともの者,ものたちも食,たべてはならぬ供,そなえのパンを食,たべたのである。","tok":[["すなわち"],["、"],["神","かみ"],["の"],["家","いえ"],["に"],["はいって"],["、"],["祭司","さいし"],["たち"],["の"],["ほか"],["、"],["自分","じぶん"],["も"],["供","とも"],["の"],["者","もの"],["たち"],["も"],["食べて","たべて"],["は"],["ならぬ"],["供え","そなえ"],["の"],["パン"],["を"],["食べた","たべた"],["ので"],["ある"],["。"]]},{"verse":5,"text":"また、安息日,あんそくにちに宮仕,みやづかえをしている祭司,さいしたちは安息日,あんそくにちを破,やぶっても罪,つみにはならないことを、律法,りっぽうで読,よんだことがないのか。","tok":[["また"],["、"],["安息日","あんそくにち"],["に"],["宮仕え","みやづかえ"],["を"],["して"],["いる"],["祭司","さいし"],["たち"],["は"],["安息日","あんそくにち"],["を"],["破って","やぶって"],["も"],["罪","つみ"],["に"],["は"],["ならない"],["こと"],["を"],["、"],["律法","りっぽう"],["で"],["読","よんだこ"],["と"],["が"],["ない"],["の"],["か"],["。"]]},{"verse":6,"text":"あなたがたに言,いっておく。宮,みやよりも大,おおいなる者,ものがここにいる。","tok":[["あなた"],["がた"],["に"],["言って","いって"],["おく"],["。"],["宮","みや"],["より"],["も"],["大いなる","おおいなる"],["者","もの"],["が"],["ここ"],["に"],["いる"],["。"]]},{"verse":7,"text":"『わたしが好,このむのは、あわれみであって、いけにえではない』とはどういう意味,いみか知,しっていたなら、あなたがたは罪,つみのない者,ものをとがめなかったであろう。","tok":[["『"],["わたし"],["が"],["好む","このむ"],["の"],["は"],["、"],["あわれみ"],["で"],["あって"],["、"],["いけにえ"],["で"],["は"],["ない"],["』"],["と"],["は"],["どういう"],["意味","いみ"],["か"],["知って","しって"],["いたなら"],["、"],["あなた"],["がた"],["は"],["罪","つみ"],["の"],["ない"],["者","もの"],["を"],["とがめなかったで"],["あろう"],["。"]]},{"verse":8,"text":"人,ひとの子,こは安息日,あんそくにちの主,しゅである」。","tok":[["人","ひと"],["の"],["子","こ"],["は"],["安息日","あんそくにち"],["の"],["主","しゅ"],["で"],["ある"],["」"],["。"]]},{"verse":9,"text":"イエスはそこを去,さって、彼,かれらの会堂,かいどうにはいられた。","tok":[["イエス"],["は"],["そこ"],["を"],["去て","さって"],["、"],["彼","かれ"],["ら"],["の"],["会堂","かいどう"],["に"],["は"],["いられた"],["。"]]},{"verse":10,"text":"すると、そのとき、片手,かたてのなえた人,ひとがいた。人々,ひとびとはイエスを訴,うったえようと思,おもって、「安息日,あんそくにちに人,ひとをいやしても、さしつかえないか」と尋,たずねた。","tok":[["する"],["と"],["、"],["その"],["とき"],["、"],["片手","かたて"],["の"],["なえた"],["人","ひと"],["が"],["いた"],["。"],["人々","ひとびと"],["は"],["イエス"],["を"],["訴よう","うったえよう"],["と"],["思って","おもって"],["、"],["「"],["安息日","あんそくにち"],["に"],["人","ひと"],["を"],["いやして"],["も"],["、"],["さしつかえない"],["か"],["」"],["と"],["尋ねた","たずねた"],["。"]]},{"verse":11,"text":"イエスは彼,かれらに言,いわれた、「あなたがたのうちに、一匹,ぴきの羊,ひつじを持,もっている人,ひとがあるとして、もしそれが安息日,あんそくにちに穴,あなに落,おちこんだなら、手,てをかけて引,ひき上,あげてやらないだろうか。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["がた"],["の"],["うち"],["に"],["、"],["一匹","ぴき"],["の"],["羊","ひつじ"],["を"],["持って","もって"],["いる"],["人","ひと"],["が"],["ある"],["として"],["、"],["もし"],["それ"],["が"],["安息日","あんそくにち"],["に"],["穴","あな"],["に"],["落","おち"],["こん"],["だなら"],["、"],["手","て"],["を"],["かけて"],["引上げて","ひきあげて"],["やらないだろう"],["か"],["。"]]},{"verse":12,"text":"人,ひとは羊,ひつじよりも、はるかにすぐれているではないか。だから、安息日,あんそくにちに良,よいことをするのは、正,ただしいことである」。","tok":[["人","ひと"],["は"],["羊","ひつじ"],["より"],["も"],["、"],["はるか"],["に"],["すぐれて"],["いるで"],["は"],["ない"],["か"],["。"],["だ"],["から"],["、"],["安息日","あんそくにち"],["に"],["良い","よい"],["こと"],["を"],["する"],["の"],["は"],["、"],["正い","ただしい"],["こと"],["で"],["ある"],["」"],["。"]]},{"verse":13,"text":"そしてイエスはその人,ひとに、「手,てを伸,のばしなさい」と言,いわれた。そこで手,てを伸,のばすと、ほかの手,てのように良,よくなった。","tok":[["そして"],["イエス"],["は"],["その"],["人","ひと"],["に"],["、"],["「"],["手","て"],["を"],["伸ばし","のばし"],["なさい"],["」"],["と"],["言われた","いわれた"],["。"],["そこ"],["で"],["手","て"],["を"],["伸ばす","のばす"],["と"],["、"],["ほか"],["の"],["手","て"],["の"],["よう"],["に"],["良く","よく"],["なった"],["。"]]},{"verse":14,"text":"パリサイ人,びとたちは出,でて行,いって、なんとかしてイエスを殺,ころそうと相談,そうだんした。","tok":[["パリサイ"],["人","びとたち"],["は"],["出て","でて"],["行って","いって"],["、"],["なん"],["と"],["か"],["して"],["イエス"],["を"],["殺そう","ころそう"],["と"],["相談","そうだん"],["した"],["。"]]},{"verse":15,"text":"イエスはこれを知,しって、そこを去,さって行,いかれた。ところが多,おおくの人々,ひとびとがついてきたので、彼,かれらを皆,みないやし、","tok":[["イエス"],["は"],["これ"],["を"],["知って","しって"],["、"],["そこ"],["を"],["去て","さって"],["行かれた","いかれた"],["。"],["ところ"],["が"],["多く","おおく"],["の"],["人々","ひとびと"],["が"],["ついて"],["きた"],["ので"],["、"],["彼","かれ"],["ら"],["を"],["皆","みな"],["いやし"],["、"]]},{"verse":16,"text":"そして自分,じぶんのことを人々,ひとびとにあらわさないようにと、彼,かれらを戒,いましめられた。","tok":[["そして"],["自分","じぶん"],["の"],["こと"],["を"],["人々","ひとびと"],["に"],["あらわさない"],["よう"],["に"],["と"],["、"],["彼","かれ"],["ら"],["を"],["戒しめ","いましめ"],["られた"],["。"]]},{"verse":17,"text":"これは預言者,よげんしゃイザヤの言,いった言葉,ことばが、成就,じょうじゅするためである、","tok":[["これ"],["は"],["預言者","よげんしゃ"],["イザヤ"],["の"],["言った","いった"],["言葉","ことば"],["が"],["、"],["成就","じょうじゅ"],["する"],["ため"],["で"],["ある"],["、"]]},{"verse":18,"text":"「見,みよ、わたしが選,えらんだ僕,しもべ、わたしの心,こころにかなう、愛,あいする者,もの。わたしは彼,かれにわたしの霊,れいを授,さづけ、そして彼,かれは正義,せいぎを異邦人,いほうじんに宣,のべ伝,つたえるであろう。","tok":[["「"],["見よ","みよ"],["、"],["わたし"],["が"],["選らんだ","えらんだ"],["僕","し"],["も"],["べ"],["、"],["わたし"],["の"],["心","こころ"],["に"],["かなう"],["、"],["愛する","あいする"],["者","もの"],["。"],["わたし"],["は"],["彼","かれ"],["に"],["わたし"],["の"],["霊","れい"],["を"],["授","さ"],["づけ"],["、"],["そして"],["彼","かれ"],["は"],["正義","せいぎ"],["を"],["異邦人","いほうじん"],["に"],["宣べ伝えるで","のべつたえるで"],["あろう"],["。"]]},{"verse":19,"text":"彼,かれは争,あらそわず、叫,さけばず、またその声,こえを大路,おおじで聞,きく者,ものはない。","tok":[["彼","かれ"],["は"],["争わず","あらそわず"],["、"],["叫けばず","さけばず"],["、"],["また"],["その"],["声","こえ"],["を"],["大路","おおじ"],["で"],["聞く","きく"],["者","もの"],["は"],["ない"],["。"]]},{"verse":20,"text":"彼,かれが正義,せいぎに勝,かちを得,えさせる時,ときまで、いためられた葦,あしを折,おることがなく、煙,けむっている燈心,とうしんを消,けすこともない。","tok":[["彼","かれ"],["が"],["正義","せいぎ"],["に"],["勝","かち"],["を"],["得させる","えさせる"],["時","とき"],["まで"],["、"],["いためられた"],["葦","あし"],["を"],["折る","おる"],["こと"],["が"],["なく"],["、"],["煙って","けむって"],["いる"],["燈心","とうしん"],["を"],["消す","けす"],["こと"],["も"],["ない"],["。"]]},{"verse":21,"text":"異邦人,いほうじんは彼,かれの名,なに望,のぞみを置,おくであろう」。","tok":[["異邦人","いほうじん"],["は"],["彼","かれ"],["の"],["名","な"],["に"],["望み","のぞみ"],["を"],["置くで","おくで"],["あろう"],["」"],["。"]]},{"verse":22,"text":"そのとき、人々,ひとびとが悪霊,あくれいにつかれた盲人,もうじんのおしを連,つれてきたので、イエスは彼,かれをいやして、物,ものを言,いい、また目,めが見,みえるようにされた。","tok":[["その"],["とき"],["、"],["人々","ひとびと"],["が"],["悪霊","あくれい"],["に"],["つかれた"],["盲人","もうじん"],["の"],["おし"],["を"],["連れて","つれて"],["きた"],["ので"],["、"],["イエス"],["は"],["彼","かれ"],["を"],["いやして"],["、"],["物","もの"],["を"],["言い","いい"],["、"],["また"],["目","め"],["が"],["見える","みえる"],["よう"],["に"],["された"],["。"]]},{"verse":23,"text":"すると群衆,ぐんしゅうはみな驚,おどろいて言,いった、「この人,ひとが、あるいはダビデの子,こではあるまいか」。","tok":[["する"],["と"],["群衆","ぐんしゅう"],["は"],["みな"],["驚ろいて","おどろいて"],["言った","いった"],["、"],["「"],["この"],["人","ひと"],["が"],["、"],["あるいは"],["ダビデ"],["の"],["子","こ"],["で"],["は"],["あるまい"],["か"],["」"],["。"]]},{"verse":24,"text":"しかし、パリサイ人,びとたちは、これを聞,きいて言,いった、「この人,ひとが悪霊,あくれいを追,おい出,だしているのは、まったく悪霊,あくれいのかしらベルゼブルによるのだ」。","tok":[["しかし"],["、"],["パリサイ"],["人","びとたち"],["は"],["、"],["これ"],["を"],["聞いて","きいて"],["言った","いった"],["、"],["「"],["この"],["人","ひと"],["が"],["悪霊","あくれい"],["を"],["追い出して","おいだして"],["いる"],["の"],["は"],["、"],["まったく"],["悪霊","あくれい"],["の"],["かしら"],["ベルゼブル"],["に"],["よる"],["の"],["だ"],["」"],["。"]]},{"verse":25,"text":"イエスは彼,かれらの思,おもいを見抜,みぬいて言,いわれた、「おおよそ、内部,ないぶで分,わかれ争,あらそう国,くには自滅,じめつし、内,うちわで分,わかれ争,あらそう町,まちや家,いえは立,たち行,いかない。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["の"],["思い","おもい"],["を"],["見抜いて","みぬいて"],["言われた","いわれた"],["、"],["「"],["おおよそ"],["、"],["内部","ないぶ"],["で"],["分かれ","わかれ"],["争う","あらそう"],["国","くに"],["は"],["自滅","じめつ"],["し"],["、"],["内","うち"],["わ"],["で"],["分かれ","わかれ"],["争う","あらそう"],["町","まち"],["や"],["家","いえ"],["は"],["立ち行かない","たちいかない"],["。"]]},{"verse":26,"text":"もしサタンがサタンを追,おい出,だすならば、それは内,うちわで分,わかれ争,あらそうことになる。それでは、その国,くにはどうして立,たち行,いけよう。","tok":[["もし"],["サタン"],["が"],["サタン"],["を"],["追い出すならば","おいだすならば"],["、"],["それ"],["は"],["内","うち"],["わ"],["で"],["分かれ","わかれ"],["争う","あらそう"],["こと"],["に"],["なる"],["。"],["それ"],["で"],["は"],["、"],["その"],["国","くに"],["は"],["どう"],["して"],["立ち","たち"],["行けよう","いけよう"],["。"]]},{"verse":27,"text":"もしわたしがベルゼブルによって悪霊,あくれいを追,おい出,だすとすれば、あなたがたの仲間,なかまはだれによって追,おい出,だすのであろうか。だから、彼,かれらがあなたがたをさばく者,ものとなるであろう。","tok":[["もし"],["わたし"],["が"],["ベルゼブル"],["によって"],["悪霊","あくれい"],["を"],["追い出す","おいだす"],["と"],["すれば"],["、"],["あなた"],["がた"],["の"],["仲間","なかま"],["は"],["だれ"],["によって"],["追い出す","おいだす"],["ので"],["あろう"],["か"],["。"],["だ"],["から"],["、"],["彼","かれ"],["ら"],["が"],["あなた"],["がた"],["を"],["さばく"],["者","もの"],["と"],["なるで"],["あろう"],["。"]]},{"verse":28,"text":"しかし、わたしが神,かみの霊,れいによって悪霊,あくれいを追,おい出,だしているのなら、神,かみの国,くにはすでにあなたがたのところにきたのである。","tok":[["しかし"],["、"],["わたし"],["が"],["神","かみ"],["の"],["霊","れい"],["によって"],["悪霊","あくれい"],["を"],["追い出して","おいだして"],["いる"],["の"],["なら"],["、"],["神","かみ"],["の"],["国","くに"],["は"],["すでに"],["あなた"],["がた"],["の"],["ところ"],["に"],["きた"],["ので"],["ある"],["。"]]},{"verse":29,"text":"まただれでも、まず強,つよい人,ひとを縛,しばりあげなければ、どうして、その人,ひとの家,いえに押,おし入,いって家財,かざいを奪,うばい取,とることができようか。縛,しばってから、はじめてその家,いえを掠奪,りゃくだつすることができる。","tok":[["また"],["だれ"],["で"],["も"],["、"],["まず"],["強い","つよい"],["人","ひと"],["を"],["縛りあげなければ","しばりあげなければ"],["、"],["どう"],["して"],["、"],["その"],["人","ひと"],["の"],["家","いえ"],["に"],["押入って","おしいって"],["家財","かざい"],["を"],["奪い取る","うばいとる"],["こと"],["が"],["できよう"],["か"],["。"],["縛って","しばって"],["から"],["、"],["はじめて"],["その"],["家","いえ"],["を"],["掠奪","りゃくだつ"],["する"],["こと"],["が"],["できる"],["。"]]},{"verse":30,"text":"わたしの味方,みかたでない者,ものは、わたしに反対,はんたいするものであり、わたしと共,ともに集,あつめない者,ものは、散,ちらすものである。","tok":[["わたし"],["の"],["味方","みかた"],["で"],["ない"],["者","もの"],["は"],["、"],["わたし"],["に"],["反対","はんたい"],["する"],["もの"],["で"],["あり"],["、"],["わたし"],["と"],["共","とも"],["に"],["集めない","あつめない"],["者","もの"],["は"],["、"],["散らす","ちらす"],["もの"],["で"],["ある"],["。"]]},{"verse":31,"text":"だから、あなたがたに言,いっておく。人,ひとには、その犯,おかすすべての罪,つみも神,かみを汚,けがす言葉,ことばも、ゆるされる。しかし、聖霊,せいれいを汚,けがす言葉,ことばは、ゆるされることはない。","tok":[["だ"],["から"],["、"],["あなた"],["がた"],["に"],["言って","いって"],["おく"],["。"],["人","ひと"],["に"],["は"],["、"],["その"],["犯す","おかす"],["すべて"],["の"],["罪","つみ"],["も"],["神","かみ"],["を"],["汚","け"],["がす"],["言葉","ことば"],["も"],["、"],["ゆるされる"],["。"],["しかし"],["、"],["聖霊","せいれい"],["を"],["汚","け"],["がす"],["言葉","ことば"],["は"],["、"],["ゆるされる"],["こと"],["は"],["ない"],["。"]]},{"verse":32,"text":"また人,ひとの子,こに対,たいして言,いい逆,さからう者,ものは、ゆるされるであろう。しかし、聖霊,せいれいに対,たいして言,いい逆,さからう者,ものは、この世,よでも、きたるべき世,よでも、ゆるされることはない。","tok":[["また"],["人","ひと"],["の"],["子","こ"],["に対して","にたいして"],["言い","いい"],["逆らう","さからう"],["者","もの"],["は"],["、"],["ゆるされるで"],["あろう"],["。"],["しかし"],["、"],["聖霊","せいれい"],["に対して","にたいして"],["言い","いい"],["逆らう","さからう"],["者","もの"],["は"],["、"],["この世","このよ"],["で"],["も"],["、"],["きたるべき"],["世","よ"],["で"],["も"],["、"],["ゆるされる"],["こと"],["は"],["ない"],["。"]]},{"verse":33,"text":"木,きが良,よければ、その実,みも良,よいとし、木,きが悪,わるければ、その実,みも悪,わるいとせよ。木,きはその実,みでわかるからである。","tok":[["木","き"],["が"],["良ければ","よければ"],["、"],["その"],["実","み"],["も"],["良い","よい"],["と"],["し"],["、"],["木","き"],["が"],["悪ければ","わるければ"],["、"],["その"],["実","み"],["も"],["悪い","わるい"],["と"],["せよ"],["。"],["木","き"],["は"],["その"],["実","み"],["で"],["わかる"],["から"],["で"],["ある"],["。"]]},{"verse":34,"text":"まむしの子,こらよ。あなたがたは悪,わるい者,ものであるのに、どうして良,よいことを語,かたることができようか。おおよそ、心,こころからあふれることを、口,くちが語,かたるものである。","tok":[["まむし"],["の"],["子","こ"],["ら"],["よ"],["。"],["あなた"],["がた"],["は"],["悪い","わるい"],["者","もの"],["で"],["ある"],["のに"],["、"],["どう"],["して"],["良い","よい"],["こと"],["を"],["語る","かたる"],["こと"],["が"],["できよう"],["か"],["。"],["おおよそ"],["、"],["心","こころ"],["から"],["あふれる"],["こと"],["を"],["、"],["口","くち"],["が"],["語る","かたる"],["もの"],["で"],["ある"],["。"]]},{"verse":35,"text":"善人,ぜんにんはよい倉,くらから良,よい物,ものを取,とり出,だし、悪人,あくにんは悪,わるい倉,くらから悪,わるい物,ものを取,とり出,だす。","tok":[["善人","ぜんにん"],["は"],["よい"],["倉","くら"],["から"],["良い","よい"],["物","もの"],["を"],["取出し","とりだし"],["、"],["悪人","あくにん"],["は"],["悪い","わるい"],["倉","くら"],["から"],["悪い","わるい"],["物","もの"],["を"],["取出す","とりだす"],["。"]]},{"verse":36,"text":"あなたがたに言,いうが、審判,しんぱんの日,ひには、人,ひとはその語,かたる無益,むえきな言葉,ことばに対,たいして、言,いい開,ひらきをしなければならないであろう。","tok":[["あなた"],["がた"],["に"],["言う","いう"],["が"],["、"],["審判","しんぱん"],["の"],["日","ひ"],["に"],["は"],["、"],["人","ひと"],["は"],["その"],["語る","かたる"],["無益","むえき"],["な"],["言葉","ことば"],["に対して","にたいして"],["、"],["言い","いい"],["開らき","ひらき"],["を"],["しなければ"],["ならないで"],["あろう"],["。"]]},{"verse":37,"text":"あなたは、自分,じぶんの言葉,ことばによって正,ただしいとされ、また自分,じぶんの言葉,ことばによって罪,つみありとされるからである」。","tok":[["あなた"],["は"],["、"],["自分","じぶん"],["の"],["言葉","ことば"],["によって"],["正い","ただしい"],["と"],["され"],["、"],["また"],["自分","じぶん"],["の"],["言葉","ことば"],["によって"],["罪","つみ"],["あり"],["と"],["される"],["から"],["で"],["ある"],["」"],["。"]]},{"verse":38,"text":"そのとき、律法,りっぽう学者,がくしゃ、パリサイ人,びとのうちのある人々,ひとびとがイエスにむかって言,いった、「先生,せんせい、わたしたちはあなたから、しるしを見,みせていただきとうございます」。","tok":[["その"],["とき"],["、"],["律法学者","りっぽうがくしゃ"],["、"],["パリサイ"],["人","びと"],["の"],["うち"],["の"],["ある"],["人々","ひとびと"],["が"],["イエス"],["に"],["むかって"],["言った","いった"],["、"],["「"],["先生","せんせい"],["、"],["わたしたち"],["は"],["あなた"],["から"],["、"],["しるし"],["を"],["見せて","みせて"],["いただきとう"],["ございます"],["」"],["。"]]},{"verse":39,"text":"すると、彼,かれらに答,こたえて言,いわれた、「邪悪,じゃあくで不義,ふぎな時代,じだいは、しるしを求,もとめる。しかし、預言者,よげんしゃヨナのしるしのほかには、なんのしるしも与,あたえられないであろう。","tok":[["する"],["と"],["、"],["彼","かれ"],["ら"],["に"],["答","こたえ"],["て"],["言われた","いわれた"],["、"],["「"],["邪悪","じゃあく"],["で"],["不義","ふぎ"],["な"],["時代","じだい"],["は"],["、"],["しるし"],["を"],["求める","もとめる"],["。"],["しかし"],["、"],["預言者","よげんしゃ"],["ヨナ"],["の"],["しるし"],["の"],["ほか"],["に"],["は"],["、"],["なん"],["の"],["しるし"],["も"],["与えられないで","あたえられないで"],["あろう"],["。"]]},{"verse":40,"text":"すなわち、ヨナが三日,か三晩,ばん、大魚,たいぎょの腹,はらの中,うちにいたように、人,ひとの子,こも三日,か三晩,ばん、地,ちの中,なかにいるであろう。","tok":[["すなわち"],["、"],["ヨナ"],["が"],["三日","か"],["三","さん"],["晩","ばん"],["、"],["大魚","たいぎょ"],["の"],["腹","はら"],["の"],["中","うち"],["に"],["いた"],["よう"],["に"],["、"],["人","ひと"],["の"],["子","こ"],["も"],["三日","か"],["三","さん"],["晩","ばん"],["、"],["地","ち"],["の"],["中","なか"],["に"],["いるで"],["あろう"],["。"]]},{"verse":41,"text":"ニネベの人々,ひとびとが、今,いまの時代,じだいの人々,ひとびとと共,ともにさばきの場,ばに立,たって、彼,かれらを罪,つみに定,さだめるであろう。なぜなら、ニネベの人々,ひとびとはヨナの宣教,せんきょうによって悔,くい改,あらためたからである。しかし見,みよ、ヨナにまさる者,ものがここにいる。","tok":[["ニネベ"],["の"],["人々","ひとびと"],["が"],["、"],["今","いま"],["の"],["時代","じだい"],["の"],["人々","ひとびと"],["と"],["共","とも"],["に"],["さばき"],["の"],["場","ば"],["に"],["立って","たって"],["、"],["彼","かれ"],["ら"],["を"],["罪","つみ"],["に"],["定めるで","さだめるで"],["あろう"],["。"],["なぜ"],["なら"],["、"],["ニネベ"],["の"],["人々","ひとびと"],["は"],["ヨナ"],["の"],["宣教","せんきょう"],["によって"],["悔い改めた","くいあらためた"],["から"],["で"],["ある"],["。"],["しかし"],["見よ","みよ"],["、"],["ヨナ"],["に"],["まさる"],["者","もの"],["が"],["ここ"],["に"],["いる"],["。"]]},{"verse":42,"text":"南,みなみの女王,じょおうが、今,いまの時代,じだいの人々,ひとびとと共,ともにさばきの場,ばに立,たって、彼,かれらを罪,つみに定,さだめるであろう。なぜなら、彼女,かのじょはソロモンの知恵,ちえを聞,きくために地,ちの果,はてから、はるばるきたからである。しかし見,みよ、ソロモンにまさる者,ものがここにいる。","tok":[["南","みなみ"],["の"],["女王","じょおう"],["が"],["、"],["今","いま"],["の"],["時代","じだい"],["の"],["人々","ひとびと"],["と"],["共","とも"],["に"],["さばき"],["の"],["場","ば"],["に"],["立って","たって"],["、"],["彼","かれ"],["ら"],["を"],["罪","つみ"],["に"],["定めるで","さだめるで"],["あろう"],["。"],["なぜ"],["なら"],["、"],["彼女","かのじょ"],["は"],["ソロモン"],["の"],["知恵","ちえ"],["を"],["聞く","きく"],["ため"],["に"],["地","ち"],["の"],["果て","はて"],["から"],["、"],["はるばる"],["きた"],["から"],["で"],["ある"],["。"],["しかし"],["見よ","みよ"],["、"],["ソロモン"],["に"],["まさる"],["者","もの"],["が"],["ここ"],["に"],["いる"],["。"]]},{"verse":43,"text":"汚,けがれた霊,れいが人,ひとから出,でると、休,やすみ場,ばを求,もとめて水,みずの無,ない所,ところを歩,あるきまわるが、見,みつからない。","tok":[["汚","け"],["がれ"],["た"],["霊","れい"],["が"],["人","ひと"],["から"],["出る","でる"],["と"],["、"],["休み場","やすみば"],["を"],["求めて","もとめて"],["水","みず"],["の"],["無い","ない"],["所","ところ"],["を"],["歩き","あるき"],["まわる"],["が"],["、"],["見つからない","みつからない"],["。"]]},{"verse":44,"text":"そこで、出,でてきた元,もとの家,いえに帰,かえろうと言,いって帰,かえって見,みると、その家,いえはあいていて、そうじがしてある上,うえ、飾,かざりつけがしてあった。","tok":[["そこ"],["で"],["、"],["出て","でて"],["きた"],["元","もと"],["の"],["家","いえ"],["に"],["帰えろう","かえろう"],["と"],["言って","いって"],["帰えって","かえって"],["見る","みる"],["と"],["、"],["その"],["家","いえ"],["は"],["あいて"],["いて"],["、"],["そうじ"],["が"],["して"],["ある"],["上","うえ"],["、"],["飾","かざり"],["つけ"],["が"],["して"],["あった"],["。"]]},{"verse":45,"text":"そこでまた出,でて行,いって、自分,じぶん以上,いじょうに悪,わるい他,たの七つの霊,れいを一緒,いっしょに引,ひき連,つれてきて中,なかにはいり、そこに住,すみ込,こむ。そうすると、その人,ひとののちの状態,じょうたいは初,はじめよりももっと悪,わるくなるのである。よこしまな今,いまの時代,じだいも、このようになるであろう」。","tok":[["そこ"],["で"],["また"],["出て","でて"],["行って","いって"],["、"],["自分","じぶん"],["以上","いじょう"],["に"],["悪い","わるい"],["他","た"],["の"],["七","なな"],["つ"],["の"],["霊","れい"],["を"],["一緒","いっしょ"],["に"],["引連れて","ひきつれて"],["きて"],["中","なか"],["に"],["はいり"],["、"],["そこ"],["に"],["住み込む","すみこむ"],["。"],["そう"],["する"],["と"],["、"],["その"],["人","ひと"],["の"],["のち"],["の"],["状態","じょうたい"],["は"],["初め","はじめ"],["より"],["も"],["もっと"],["悪く","わるく"],["なる"],["ので"],["ある"],["。"],["よこしま"],["な"],["今","いま"],["の"],["時代","じだい"],["も"],["、"],["この"],["よう"],["に"],["なるで"],["あろう"],["」"],["。"]]},{"verse":46,"text":"イエスがまだ群衆,ぐんしゅうに話,はなしておられるとき、その母,ははと兄弟,きょうだいたちとが、イエスに話,はなそうと思,おもって外,そとに立,たっていた。","tok":[["イエス"],["が"],["まだ"],["群衆","ぐんしゅう"],["に"],["話","はなし"],["て"],["おられる"],["とき"],["、"],["その"],["母","はは"],["と"],["兄弟","きょうだい"],["たち"],["と"],["が"],["、"],["イエス"],["に"],["話そう","はなそう"],["と"],["思って","おもって"],["外","そと"],["に"],["立って","たって"],["いた"],["。"]]},{"verse":47,"text":"それで、ある人,ひとがイエスに言,いった、「ごらんなさい。あなたの母上,ははうえと兄弟,きょうだいがたが、あなたに話,はなそうと思,おもって、外,そとに立,たっておられます」。","tok":[["それ"],["で"],["、"],["ある"],["人","ひと"],["が"],["イエス"],["に"],["言った","いった"],["、"],["「"],["ごらん"],["なさい"],["。"],["あなた"],["の"],["母","はは"],["上","うえ"],["と"],["兄弟","きょうだい"],["がた"],["が"],["、"],["あなた"],["に"],["話そう","はなそう"],["と"],["思って","おもって"],["、"],["外","そと"],["に"],["立って","たって"],["おられます"],["」"],["。"]]},{"verse":48,"text":"イエスは知,しらせてくれた者,ものに答,こたえて言,いわれた、「わたしの母,ははとは、だれのことか。わたしの兄弟,きょうだいとは、だれのことか」。","tok":[["イエス"],["は"],["知らせて","しらせて"],["くれた"],["者","もの"],["に"],["答","こたえ"],["て"],["言われた","いわれた"],["、"],["「"],["わたし"],["の"],["母","はは"],["と"],["は"],["、"],["だれ"],["の"],["こと"],["か"],["。"],["わたし"],["の"],["兄弟","きょうだい"],["と"],["は"],["、"],["だれ"],["の"],["こと"],["か"],["」"],["。"]]},{"verse":49,"text":"そして、弟子,でしたちの方,ほうに手,てをさし伸,のべて言,いわれた、「ごらんなさい。ここにわたしの母,はは、わたしの兄弟,きょうだいがいる。","tok":[["そして"],["、"],["弟子","でし"],["たち"],["の"],["方","ほう"],["に"],["手","て"],["を"],["さし伸べて","さしのべて"],["言われた","いわれた"],["、"],["「"],["ごらん"],["なさい"],["。"],["ここ"],["に"],["わたし"],["の"],["母","はは"],["、"],["わたし"],["の"],["兄弟","きょうだい"],["が"],["いる"],["。"]]},{"verse":50,"text":"天,てんにいますわたしの父,ちちのみこころを行,おこなう者,ものはだれでも、わたしの兄弟,きょうだい、また姉妹,しまい、また母,ははなのである」。","tok":[["天","てん"],["に"],["います"],["わたし"],["の"],["父","ちち"],["のみ"],["こころ"],["を"],["行なう","おこなう"],["者","もの"],["は"],["だれ"],["で"],["も"],["、"],["わたし"],["の"],["兄弟","きょうだい"],["、"],["また"],["姉妹","しまい"],["、"],["また"],["母","はは"],["な"],["ので"],["ある"],["」"],["。"]]}]
[{"verse":1,"text":"イエスはまた、譬,たとえで彼,かれらに語,かたって言,いわれた、","tok":[["イエス"],["は"],["また"],["、"],["譬","たとえ"],["で"],["彼","かれ"],["ら"],["に"],["語って","かたって"],["言われた","いわれた"],["、"]]},{"verse":2,"text":"「天国,てんごくは、ひとりの王,おうがその王子,おうじのために、婚,こん宴,えんを催,もよおすようなものである。","tok":[["「"],["天国","てんごく"],["は"],["、"],["ひとり"],["の"],["王","おう"],["が"],["その"],["王子","おうじ"],["の"],["ため"],["に"],["、"],["婚","こん"],["宴","えん"],["を"],["催おす","もよおす"],["よう"],["な"],["もの"],["で"],["ある"],["。"]]},{"verse":3,"text":"王,おうはその僕,しもべたちをつかわして、この婚,こん宴,えんに招,まねかれていた人,ひとたちを呼,よばせたが、その人,ひとたちはこようとはしなかった。","tok":[["王","おう"],["は"],["その"],["僕","し"],["も"],["べ"],["たち"],["を"],["つかわして"],["、"],["この"],["婚","こん"],["宴","えん"],["に"],["招かれて","まねかれて"],["いた"],["人","ひと"],["たち"],["を"],["呼ばせた","よばせた"],["が"],["、"],["その"],["人","ひと"],["たち"],["は"],["こよう"],["と"],["は"],["しなかった"],["。"]]},{"verse":4,"text":"そこでまた、ほかの僕,しもべたちをつかわして言,いった、『招,まねかれた人,ひとたちに言,いいなさい。食事,しょくじの用意,よういができました。牛,うしも肥,こえた獣,けものもほふられて、すべての用意,よういができました。さあ、婚,こん宴,えんにおいでください』。","tok":[["そこ"],["で"],["また"],["、"],["ほか"],["の"],["僕","し"],["も"],["べ"],["たち"],["を"],["つかわして"],["言った","いった"],["、"],["『"],["招かれた","まねかれた"],["人","ひと"],["たち"],["に"],["言い","いい"],["なさい"],["。"],["食事","しょくじ"],["の"],["用意","ようい"],["が"],["できました"],["。"],["牛","うし"],["も"],["肥","こえ"],["た"],["獣","けもの"],["も"],["ほふられて"],["、"],["すべて"],["の"],["用意","ようい"],["が"],["できました"],["。"],["さあ"],["、"],["婚","こん"],["宴","えん"],["に"],["おいで"],["ください"],["』"],["。"]]},{"verse":5,"text":"しかし、彼,かれらは知,しらぬ顔,かおをして、ひとりは自分,じぶんの畑,はたけに、ひとりは自分,じぶんの商売,しょうばいに出,でて行,いき、","tok":[["しかし"],["、"],["彼","かれ"],["ら"],["は"],["知らぬ","しらぬ"],["顔","かお"],["を"],["して"],["、"],["ひとり"],["は"],["自分","じぶん"],["の"],["畑","はたけ"],["に"],["、"],["ひとり"],["は"],["自分","じぶん"],["の"],["商売","しょうばい"],["に"],["出て","でて"],["行き","いき"],["、"]]},{"verse":6,"text":"またほかの人々,ひとびとは、この僕,しもべたちをつかまえて侮辱,ぶじょくを加,くわえた上,うえ、殺,ころしてしまった。","tok":[["また"],["ほか"],["の"],["人々","ひとびと"],["は"],["、"],["この"],["僕","し"],["も"],["べ"],["たち"],["を"],["つかまえて"],["侮辱","ぶじょく"],["を"],["加えた","くわえた"],["上","うえ"],["、"],["殺ろして","ころして"],["しまった"],["。"]]},{"verse":7,"text":"そこで王,おうは立腹,りっぷくし、軍隊,ぐんたいを送,おくってそれらの人殺,ひとごろしどもを滅,ほろぼし、その町,まちを焼,やき払,はらった。","tok":[["そこ"],["で"],["王","おう"],["は"],["立腹","りっぷく"],["し"],["、"],["軍隊","ぐんたい"],["を"],["送って","おくって"],["それ"],["ら"],["の"],["人殺し","ひとごろし"],["ども"],["を"],["滅ぼし","ほろぼし"],["、"],["その"],["町","まち"],["を"],["焼き払った","やきはらった"],["。"]]},{"verse":8,"text":"それから僕,しもべたちに言,いった、『婚,こん宴,えんの用意,よういはできているが、招,まねかれていたのは、ふさわしくない人々,ひとびとであった。","tok":[["それ"],["から"],["僕","し"],["も"],["べ"],["たち"],["に"],["言った","いった"],["、"],["『"],["婚","こん"],["宴","えん"],["の"],["用意","ようい"],["は"],["できて"],["いる"],["が"],["、"],["招かれて","まねかれて"],["いた"],["の"],["は"],["、"],["ふさわしく"],["ない"],["人々","ひとびと"],["で"],["あった"],["。"]]},{"verse":9,"text":"だから、町,まちの大通,おおどおりに出,でて行,いって、出会,であった人,ひとはだれでも婚,こん宴,えんに連,つれてきなさい』。","tok":[["だ"],["から"],["、"],["町","まち"],["の"],["大通り","おおどおり"],["に"],["出て","でて"],["行って","いって"],["、"],["出会った","であった"],["人","ひと"],["は"],["だれ"],["で"],["も"],["婚","こん"],["宴","えん"],["に"],["連れて","つれて"],["き"],["なさい"],["』"],["。"]]},{"verse":10,"text":"そこで、僕,しもべたちは道,みちに出,でて行,いって、出会,であう人,ひとは、悪人,あくにんでも善人,ぜんにんでもみな集,あつめてきたので、婚,こん宴,えんの席,せきは客,きゃくでいっぱいになった。","tok":[["そこ"],["で"],["、"],["僕","し"],["も"],["べ"],["たち"],["は"],["道","みち"],["に"],["出て","でて"],["行って","いって"],["、"],["出会う","であう"],["人","ひと"],["は"],["、"],["悪人","あくにん"],["で"],["も"],["善人","ぜんにん"],["で"],["も"],["みな"],["集めて","あつめて"],["きた"],["ので"],["、"],["婚","こん"],["宴","えん"],["の"],["席","せき"],["は"],["客","きゃく"],["で"],["いっぱい"],["に"],["なった"],["。"]]},{"verse":11,"text":"王,おうは客,きゃくを迎,むかえようとしてはいってきたが、そこに礼服,れいふくをつけていないひとりの人,ひとを見,みて、","tok":[["王","おう"],["は"],["客","きゃく"],["を"],["迎","むかえ"],["よう"],["と"],["し"],["ては"],["いって"],["きた"],["が"],["、"],["そこ"],["に"],["礼服","れいふく"],["を"],["つけて"],["いない"],["ひとり"],["の"],["人","ひと"],["を"],["見て","みて"],["、"]]},{"verse":12,"text":"彼,かれに言,いった、『友,ともよ、どうしてあなたは礼服,れいふくをつけないで、ここにはいってきたのですか』。しかし、彼,かれは黙,だまっていた。","tok":[["彼","かれ"],["に"],["言った","いった"],["、"],["『"],["友","とも"],["よ"],["、"],["どう"],["して"],["あなた"],["は"],["礼服","れいふく"],["を"],["つけないで"],["、"],["ここ"],["に"],["はいって"],["きた"],["の"],["です"],["か"],["』"],["。"],["しかし"],["、"],["彼","かれ"],["は"],["黙って","だまって"],["いた"],["。"]]},{"verse":13,"text":"そこで、王,おうはそばの者,ものたちに言,いった、『この者,ものの手足,てあしをしばって、外,そとの暗,くらやみにほうり出,だせ。そこで泣,なき叫,さけんだり、歯,はがみをしたりするであろう』。","tok":[["そこ"],["で"],["、"],["王","おう"],["は"],["そば"],["の"],["者","もの"],["たち"],["に"],["言った","いった"],["、"],["『"],["この"],["者","もの"],["の"],["手足","てあし"],["を"],["しばって"],["、"],["外","そと"],["の"],["暗やみ","くらやみ"],["に"],["ほうり出せ","ほうりだせ"],["。"],["そこ"],["で"],["泣","なき"],["叫けん","さけん"],["だり"],["、"],["歯がみ","はがみ"],["を"],["し"],["たり"],["するで"],["あろう"],["』"],["。"]]},{"verse":14,"text":"招,まねかれる者,ものは多,おおいが、選,えらばれる者,ものは少,すくない」。","tok":[["招かれる","まねかれる"],["者","もの"],["は"],["多い","おおい"],["が"],["、"],["選ら","えら"],["ばれる"],["者","もの"],["は"],["少い","すくない"],["」"],["。"]]},{"verse":15,"text":"そのときパリサイ人,びとたちがきて、どうかしてイエスを言葉,ことばのわなにかけようと、相談,そうだんをした。","tok":[["その"],["とき"],["パリサイ"],["人","びとたち"],["が"],["きて"],["、"],["どう"],["か"],["して"],["イエス"],["を"],["言葉","ことば"],["の"],["わな"],["に"],["かけよう"],["と"],["、"],["相談","そうだん"],["を"],["した"],["。"]]},{"verse":16,"text":"そして、彼,かれらの弟子,でしを、ヘロデ党,とうの者,ものたちと共,ともに、イエスのもとにつかわして言,いわせた、「先生,せんせい、わたしたちはあなたが真実,しんじつなかたであって、真理,しんりに基,もとづいて神,かみの道,みちを教,おしえ、また、人,ひとに分,わけ隔,へだてをしないで、だれをもはばかられないことを知,しっています。","tok":[["そして"],["、"],["彼","かれ"],["ら"],["の"],["弟子","でし"],["を"],["、"],["ヘロデ党","へろでとう"],["の"],["者","もの"],["たち"],["と"],["共","とも"],["に"],["、"],["イエス"],["の"],["もと"],["に"],["つかわして"],["言わせた","いわせた"],["、"],["「"],["先生","せんせい"],["、"],["わたしたち"],["は"],["あなた"],["が"],["真実","しんじつ"],["な"],["かた"],["で"],["あって"],["、"],["真理","しんり"],["に"],["基づいて","もとづいて"],["神","かみ"],["の"],["道","みち"],["を"],["教え","おしえ"],["、"],["また"],["、"],["人","ひと"],["に"],["分け隔て","わけへだて"],["を"],["しないで"],["、"],["だれ"],["を"],["も"],["はばかられない"],["こと"],["を"],["知って","しって"],["います"],["。"]]},{"verse":17,"text":"それで、あなたはどう思,おもわれますか、答,こたえてください。カイザルに税金,ぜいきんを納,おさめてよいでしょうか、いけないでしょうか」。","tok":[["それ"],["で"],["、"],["あなた"],["は"],["どう"],["思われます","おもわれます"],["か"],["、"],["答","こたえ"],["て"],["ください"],["。"],["カイザル"],["に"],["税金","ぜいきん"],["を"],["納","おさめ"],["て"],["よいでしょう"],["か"],["、"],["いけないでしょう"],["か"],["」"],["。"]]},{"verse":18,"text":"イエスは彼,かれらの悪意,あくいを知,しって言,いわれた、「偽善者,ぎぜんしゃたちよ、なぜわたしをためそうとするのか。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["の"],["悪意","あくい"],["を"],["知って","しって"],["言われた","いわれた"],["、"],["「"],["偽善者","ぎぜんしゃ"],["たち"],["よ"],["、"],["なぜ"],["わたし"],["を"],["ためそう"],["と"],["する"],["の"],["か"],["。"]]},{"verse":19,"text":"税,ぜいに納,おさめる貨幣,かへいを見,みせなさい」。彼,かれらはデナリ一つを持,もってきた。","tok":[["税","ぜい"],["に"],["納める","おさめる"],["貨幣","かへい"],["を"],["見せ","みせ"],["なさい"],["」"],["。"],["彼","かれ"],["ら"],["は"],["デナリ"],["一","ひと"],["つ"],["を"],["持って","もって"],["きた"],["。"]]},{"verse":20,"text":"そこでイエスは言,いわれた、「これは、だれの肖像,しょうぞう、だれの記号,きごうか」。","tok":[["そこ"],["で"],["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["これ"],["は"],["、"],["だれ"],["の"],["肖像","しょうぞう"],["、"],["だれ"],["の"],["記号","きごう"],["か"],["」"],["。"]]},{"verse":21,"text":"彼,かれらは「カイザルのです」と答,こたえた。するとイエスは言,いわれた、「それでは、カイザルのものはカイザルに、神,かみのものは神,かみに返,かえしなさい」。","tok":[["彼","かれ"],["ら"],["は"],["「"],["カイザル"],["の"],["です"],["」"],["と"],["答","こたえ"],["た"],["。"],["する"],["と"],["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["それ"],["で"],["は"],["、"],["カイザル"],["の"],["もの"],["は"],["カイザル"],["に"],["、"],["神","かみ"],["の"],["もの"],["は"],["神","かみ"],["に"],["返","かえし"],["なさい"],["」"],["。"]]},{"verse":22,"text":"彼,かれらはこれを聞,きいて驚嘆,きょうたんし、イエスを残,のこして立,たち去,さった。","tok":[["彼","かれ"],["ら"],["は"],["これ"],["を"],["聞いて","きいて"],["驚嘆","きょうたん"],["し"],["、"],["イエス"],["を"],["残して","のこして"],["立ち","たち"],["去た","さった"],["。"]]},{"verse":23,"text":"復活,ふっかつということはないと主張,しゅちょうしていたサドカイ人,びとたちが、その日,ひ、イエスのもとにきて質問,しつもんした、","tok":[["復活","ふっかつ"],["と"],["いう"],["こと"],["は"],["ない"],["と"],["主張","しゅちょう"],["して"],["いた"],["サドカイ"],["人","びと"],["たち"],["が"],["、"],["その"],["日","ひ"],["、"],["イエス"],["の"],["もと"],["に"],["きて"],["質問","しつもん"],["した"],["、"]]},{"verse":24,"text":"「先生,せんせい、モーセはこう言,いっています、『もし、ある人,ひとが子,こがなくて死,しんだなら、その弟,おとうとは兄,あにの妻,つまをめとって、兄,あにのために子,こをもうけねばならない』。","tok":[["「"],["先生","せんせい"],["、"],["モーセ"],["は"],["こう"],["言って","いって"],["います"],["、"],["『"],["もし"],["、"],["ある"],["人","ひと"],["が"],["子","こ"],["が"],["なくて"],["死んだなら","しんだなら"],["、"],["その"],["弟","おとうと"],["は"],["兄","あに"],["の"],["妻","つま"],["を"],["めとって"],["、"],["兄","あに"],["の"],["ため"],["に"],["子","こ"],["を"],["もうけねば"],["ならない"],["』"],["。"]]},{"verse":25,"text":"さて、わたしたちのところに七人,にんの兄弟,きょうだいがありました。長男,ちょうなんは妻,つまをめとったが死,しんでしまい、そして子,こがなかったので、その妻,つまを弟,おとうとに残,のこしました。","tok":[["さて"],["、"],["わたしたち"],["の"],["ところ"],["に"],["七人","にん"],["の"],["兄弟","きょうだい"],["が"],["ありました"],["。"],["長男","ちょうなん"],["は"],["妻","つま"],["を"],["めとった"],["が"],["死んで","しんで"],["しまい"],["、"],["そして"],["子","こ"],["が"],["なかった"],["ので"],["、"],["その"],["妻","つま"],["を"],["弟","おとうと"],["に"],["残しました","のこしました"],["。"]]},{"verse":26,"text":"次男,じなんも三男,さんなんも、ついに七人,にんとも同,おなじことになりました。","tok":[["次男","じなん"],["も"],["三男","さんなん"],["も"],["、"],["ついに"],["七人","にんと"],["も"],["同じ","おなじ"],["こと"],["に"],["なりました"],["。"]]},{"verse":27,"text":"最後,さいごに、その女,おんなも死,しにました。","tok":[["最後","さいご"],["に"],["、"],["その"],["女","おんな"],["も"],["死にました","しにました"],["。"]]},{"verse":28,"text":"すると復活,ふっかつの時,ときには、この女,おんなは、七人,にんのうちだれの妻,つまなのでしょうか。みんながこの女,おんなを妻,つまにしたのですが」。","tok":[["する"],["と"],["復活","ふっかつ"],["の"],["時","とき"],["に"],["は"],["、"],["この"],["女","おんな"],["は"],["、"],["七人","にん"],["の"],["うち"],["だれ"],["の"],["妻","つま"],["な"],["の"],["でしょう"],["か"],["。"],["みんな"],["が"],["この"],["女","おんな"],["を"],["妻","つま"],["に"],["した"],["の"],["です"],["が"],["」"],["。"]]},{"verse":29,"text":"イエスは答,こたえて言,いわれた、「あなたがたは聖書,せいしょも神,かみの力,ちからも知,しらないから、思,おもい違,ちがいをしている。","tok":[["イエス"],["は"],["答","こたえ"],["て"],["言われた","いわれた"],["、"],["「"],["あなた"],["がた"],["は"],["聖書","せいしょ"],["も"],["神","かみ"],["の"],["力","ちから"],["も"],["知らない","しらない"],["から"],["、"],["思い違い","おもいちがい"],["を"],["して"],["いる"],["。"]]},{"verse":30,"text":"復活,ふっかつの時,ときには、彼,かれらはめとったり、とついだりすることはない。彼,かれらは天,てんにいる御使,みつかいのようなものである。","tok":[["復活","ふっかつ"],["の"],["時","とき"],["に"],["は"],["、"],["彼","かれ"],["ら"],["は"],["めとっ"],["たり"],["、"],["と"],["つい"],["だり"],["する"],["こと"],["は"],["ない"],["。"],["彼","かれ"],["ら"],["は"],["天","てん"],["に"],["いる"],["御使","みつかい"],["の"],["よう"],["な"],["もの"],["で"],["ある"],["。"]]},{"verse":31,"text":"また、死人,しにんの復活,ふっかつについては、神,かみがあなたがたに言,いわれた言葉,ことばを読,よんだことがないのか。","tok":[["また"],["、"],["死人","しにん"],["の"],["復活","ふっかつ"],["について"],["は"],["、"],["神","かみ"],["が"],["あなた"],["がた"],["に"],["言われた","いわれた"],["言葉","ことば"],["を"],["読","よんだこ"],["と"],["が"],["ない"],["の"],["か"],["。"]]},{"verse":32,"text":"『わたしはアブラハムの神,かみ、イサクの神,かみ、ヤコブの神,かみである』と書,かいてある。神,かみは死,しんだ者,ものの神,かみではなく、生,いきている者,ものの神,かみである」。","tok":[["『"],["わたし"],["は"],["アブラハム"],["の"],["神","かみ"],["、"],["イサク"],["の"],["神","かみ"],["、"],["ヤコブ"],["の"],["神","かみ"],["で"],["ある"],["』"],["と"],["書いて","かいて"],["ある"],["。"],["神","かみ"],["は"],["死んだ","しんだ"],["者","もの"],["の"],["神","かみ"],["で"],["は"],["なく"],["、"],["生きて","いきて"],["いる"],["者","もの"],["の"],["神","かみ"],["で"],["ある"],["」"],["。"]]},{"verse":33,"text":"群衆,ぐんしゅうはこれを聞,きいて、イエスの教,おしえに驚,おどろいた。","tok":[["群衆","ぐんしゅう"],["は"],["これ"],["を"],["聞いて","きいて"],["、"],["イエス"],["の"],["教え","おしえ"],["に"],["驚ろいた","おどろいた"],["。"]]},{"verse":34,"text":"さて、パリサイ人,びとたちは、イエスがサドカイ人,びとたちを言,いいこめられたと聞,きいて、一緒,いっしょに集,あつまった。","tok":[["さて"],["、"],["パリサイ"],["人","びとたち"],["は"],["、"],["イエス"],["が"],["サドカイ"],["人","びとたち"],["を"],["言いこめられた","いいこめられた"],["と"],["聞いて","きいて"],["、"],["一緒","いっしょ"],["に"],["集まった","あつまった"],["。"]]},{"verse":35,"text":"そして彼,かれらの中,なかのひとりの律法,りっぽう学者,がくしゃが、イエスをためそうとして質問,しつもんした、","tok":[["そして"],["彼","かれ"],["ら"],["の"],["中","なか"],["の"],["ひとり"],["の"],["律法学者","りっぽうがくしゃ"],["が"],["、"],["イエス"],["を"],["ためそう"],["として"],["質問","しつもん"],["した"],["、"]]},{"verse":36,"text":"「先生,せんせい、律法,りっぽうの中,なかで、どのいましめがいちばん大切,たいせつなのですか」。","tok":[["「"],["先生","せんせい"],["、"],["律法","りっぽう"],["の"],["中","なか"],["で"],["、"],["どの"],["いましめ"],["が"],["いちばん"],["大切","たいせつ"],["な"],["の"],["です"],["か"],["」"],["。"]]},{"verse":37,"text":"イエスは言,いわれた、「『心,こころをつくし、精神,せいしんをつくし、思,おもいをつくして、主,しゅなるあなたの神,かみを愛,あいせよ』。","tok":[["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["『"],["心","こころ"],["を"],["つくし"],["、"],["精神","せいしん"],["を"],["つくし"],["、"],["思い","おもい"],["を"],["つくして"],["、"],["主","しゅ"],["なる"],["あなた"],["の"],["神","かみ"],["を"],["愛せよ","あいせよ"],["』"],["。"]]},{"verse":38,"text":"これがいちばん大切,たいせつな、第,だい一のいましめである。","tok":[["これ"],["が"],["いちばん"],["大切","たいせつ"],["な"],["、"],["第","だい"],["一","いち"],["の"],["いましめ"],["で"],["ある"],["。"]]},{"verse":39,"text":"第,だい二もこれと同様,どうようである、『自分,じぶんを愛,あいするようにあなたの隣,となり人,びとを愛,あいせよ』。","tok":[["第","だい"],["二","に"],["も"],["これ"],["と"],["同様","どうよう"],["で"],["ある"],["、"],["『"],["自分","じぶん"],["を"],["愛する","あいする"],["よう"],["に"],["あなた"],["の"],["隣人","となりびと"],["を"],["愛せよ","あいせよ"],["』"],["。"]]},{"verse":40,"text":"これらの二つのいましめに、律法,りっぽう全体,ぜんたいと預言者,よげんしゃとが、かかっている」。","tok":[["これ"],["ら"],["の"],["二","ふた"],["つ"],["の"],["いましめ"],["に"],["、"],["律法","りっぽう"],["全体","ぜんたい"],["と"],["預言者","よげんしゃ"],["と"],["が"],["、"],["かかって"],["いる"],["」"],["。"]]},{"verse":41,"text":"パリサイ人,びとたちが集,あつまっていたとき、イエスは彼,かれらにお尋,たずねになった、","tok":[["パリサイ"],["人","びと"],["たち"],["が"],["集まって","あつまって"],["いた"],["とき"],["、"],["イエス"],["は"],["彼","かれ"],["ら"],["に"],["お尋ね","おたずね"],["に"],["なった"],["、"]]},{"verse":42,"text":"「あなたがたはキリストをどう思,おもうか。だれの子,こなのか」。彼,かれらは「ダビデの子,こです」と答,こたえた。","tok":[["「"],["あなた"],["がた"],["は"],["キリスト"],["を"],["どう"],["思","おもう"],["か"],["。"],["だれ"],["の"],["子","こ"],["な"],["の"],["か"],["」"],["。"],["彼","かれ"],["ら"],["は"],["「"],["ダビデ"],["の"],["子","こ"],["です"],["」"],["と"],["答","こたえ"],["た"],["。"]]},{"verse":43,"text":"イエスは言,いわれた、「それではどうして、ダビデが御霊,みたまに感,かんじてキリストを主,しゅと呼,よんでいるのか。","tok":[["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["それ"],["で"],["は"],["どう"],["して"],["、"],["ダビデ"],["が"],["御霊","みたま"],["に"],["感じて","かんじて"],["キリスト"],["を"],["主","しゅ"],["と"],["呼","よんでいる"],["の"],["か"],["。"]]},{"verse":44,"text":"すなわち『主,しゅはわが主,しゅに仰,おおせになった、あなたの敵,てきをあなたの足,あしもとに置,おくときまでは、わたしの右,みぎに座,ざしていなさい』。","tok":[["すなわち"],["『"],["主","しゅ"],["は"],["わが"],["主に","しゅに"],["仰せ","おおせ"],["に"],["なった"],["、"],["あなた"],["の"],["敵","てき"],["を"],["あなた"],["の"],["足もと","あしもと"],["に"],["置く","おく"],["とき"],["まで"],["は"],["、"],["わたし"],["の"],["右","みぎ"],["に"],["座して","ざして"],["い"],["なさい"],["』"],["。"]]},{"verse":45,"text":"このように、ダビデ自身,じしんがキリストを主,しゅと呼,よんでいるなら、キリストはどうしてダビデの子,こであろうか」。","tok":[["この"],["よう"],["に"],["、"],["ダビデ"],["自身","じしん"],["が"],["キリスト"],["を"],["主","しゅ"],["と"],["呼んで","よんで"],["いるなら"],["、"],["キリスト"],["は"],["どう"],["して"],["ダビデ"],["の"],["子","こ"],["で"],["あろう"],["か"],["」"],["。"]]},{"verse":46,"text":"イエスにひと言,ことでも答,こたえうる者,ものは、なかったし、その日,ひからもはや、進,すすんでイエスに質問,しつもんする者,ものも、いなくなった。","tok":[["イエス"],["に"],["ひと言","ひとこと"],["で"],["も"],["答","こたえ"],["うる"],["者","もの"],["は"],["、"],["なかった"],["し"],["、"],["その"],["日","ひ"],["から"],["もはや"],["、"],["進","す"],["すんで"],["イエス"],["に"],["質問","しつもん"],["する"],["者","もの"],["も"],["、"],["いなく"],["なった"],["。"]]}]
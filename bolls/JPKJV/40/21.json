[{"verse":1,"text":"さて、彼,かれらがエルサレムに近,ちかづき、オリブ山,やま沿,ぞいのベテパゲに着,ついたとき、イエスはふたりの弟子,でしをつかわして言,いわれた、","tok":[["さて"],["、"],["彼","かれ"],["ら"],["が"],["エルサレム"],["に"],["近づき","ちかづき"],["、"],["オリブ"],["山沿い","やまぞい"],["の"],["ベテパゲ"],["に"],["着いた","ついた"],["とき"],["、"],["イエス"],["は"],["ふたり"],["の"],["弟子","でし"],["を"],["つかわして"],["言われた","いわれた"],["、"]]},{"verse":2,"text":"「向,むこうの村,むらへ行,いきなさい。するとすぐ、ろばがつながれていて、子,ころばがそばにいるのを見,みるであろう。それを解,といてわたしのところに引,ひいてきなさい。","tok":[["「"],["向こう","むこう"],["の"],["村","むら"],["へ"],["行き","いき"],["なさい"],["。"],["する"],["と"],["すぐ"],["、"],["ろば"],["が"],["つながれて"],["いて"],["、"],["子","こ"],["ろば"],["が"],["そば"],["に"],["いる"],["の"],["を"],["見るで","みるで"],["あろう"],["。"],["それ"],["を"],["解いて","といて"],["わたし"],["の"],["ところ"],["に"],["引いて","ひいて"],["き"],["なさい"],["。"]]},{"verse":3,"text":"もしだれかが、あなたがたに何,なにか言,いったなら、主,しゅがお入,いり用,ようなのです、と言,いいなさい。そう言,いえば、すぐ渡,わたしてくれるであろう」。","tok":[["もし"],["だれ"],["か"],["が"],["、"],["あなた"],["がた"],["に"],["何に","なに"],["か"],["言ったなら","いったなら"],["、"],["主","しゅ"],["が"],["お入用","おいりよう"],["な"],["の"],["です"],["、"],["と"],["言い","いい"],["なさい"],["。"],["そう"],["言えば","いえば"],["、"],["すぐ"],["渡","わたし"],["て"],["くれるで"],["あろう"],["」"],["。"]]},{"verse":4,"text":"こうしたのは、預言者,よげんしゃによって言,いわれたことが、成就,じょうじゅするためである。","tok":[["こう"],["した"],["の"],["は"],["、"],["預言者","よげんしゃ"],["によって"],["言われた","いわれた"],["こと"],["が"],["、"],["成就","じょうじゅ"],["する"],["ため"],["で"],["ある"],["。"]]},{"verse":5,"text":"すなわち、「シオンの娘,むすめに告,つげよ、見,みよ、あなたの王,おうがおいでになる、柔和,にゅうわなおかたで、ろばに乗,のって、くびきを負,おうろばの子,こに乗,のって」。","tok":[["すなわち"],["、"],["「"],["シオン"],["の"],["娘","むすめ"],["に"],["告","つげ"],["よ"],["、"],["見よ","みよ"],["、"],["あなた"],["の"],["王","おう"],["が"],["おいで"],["に"],["なる"],["、"],["柔和","にゅうわ"],["な"],["おかた"],["で"],["、"],["ろば"],["に"],["乗って","のって"],["、"],["くびき"],["を"],["負う","おう"],["ろば"],["の"],["子","こ"],["に"],["乗って","のって"],["」"],["。"]]},{"verse":6,"text":"弟子,でしたちは出,でて行,いって、イエスがお命,めいじになったとおりにし、","tok":[["弟子","でし"],["たち"],["は"],["出て","でて"],["行って","いって"],["、"],["イエス"],["が"],["お命じ","おめいじ"],["に"],["なった"],["とおり"],["に"],["し"],["、"]]},{"verse":7,"text":"ろばと子,ころばとを引,ひいてきた。そしてその上,うえに自分,じぶんたちの上着,うわぎをかけると、イエスはそれにお乗,のりになった。","tok":[["ろば"],["と"],["子","こ"],["ろば"],["と"],["を"],["引いて","ひいて"],["きた"],["。"],["そして"],["その"],["上","うえ"],["に"],["自分","じぶん"],["たち"],["の"],["上着","うわぎ"],["を"],["かける"],["と"],["、"],["イエス"],["は"],["それ"],["に"],["お乗","おのり"],["に"],["なった"],["。"]]},{"verse":8,"text":"群衆,ぐんしゅうのうち多,おおくの者,ものは自分,じぶんたちの上着,うわぎを道,みちに敷,しき、また、ほかの者,ものたちは木,きの枝,えだを切,きってきて道,みちに敷,しいた。","tok":[["群衆","ぐんしゅう"],["の"],["うち"],["多く","おおく"],["の"],["者","もの"],["は"],["自分","じぶん"],["たち"],["の"],["上着","うわぎ"],["を"],["道","みち"],["に"],["敷","しき"],["、"],["また"],["、"],["ほか"],["の"],["者","もの"],["たち"],["は"],["木","き"],["の"],["枝","えだ"],["を"],["切って","きって"],["きて"],["道","みち"],["に"],["敷いた","しいた"],["。"]]},{"verse":9,"text":"そして群衆,ぐんしゅうは、前,まえに行,ゆく者,ものも、あとに従,したがう者,ものも、共,ともに叫,さけびつづけた、「ダビデの子,こに、ホサナ。主,しゅの御名,みなによってきたる者,ものに、祝福,しゅくふくあれ。いと高,たかき所,ところに、ホサナ」。","tok":[["そして"],["群衆","ぐんしゅう"],["は"],["、"],["前","まえ"],["に"],["行く","ゆく"],["者","もの"],["も"],["、"],["あと"],["に"],["従う","したがう"],["者","もの"],["も"],["、"],["共","とも"],["に"],["叫","さけび"],["つづけた"],["、"],["「"],["ダビデ"],["の"],["子","こ"],["に"],["、"],["ホサナ"],["。"],["主","しゅ"],["の"],["御名","みな"],["によって"],["きたる"],["者","もの"],["に"],["、"],["祝福","しゅくふく"],["あれ"],["。"],["いと"],["高き","たかき"],["所","ところ"],["に"],["、"],["ホサナ"],["」"],["。"]]},{"verse":10,"text":"イエスがエルサレムにはいって行,いかれたとき、町中,まちじゅうがこぞって騒,さわぎ立,たち、「これは、いったい、どなただろう」と言,いった。","tok":[["イエス"],["が"],["エルサレム"],["に"],["はいって"],["行かれた","いかれた"],["とき"],["、"],["町中","まちじゅう"],["が"],["こぞって"],["騒立ち","さわぎたち"],["、"],["「"],["これ"],["は"],["、"],["いったい"],["、"],["どなた"],["だろう"],["」"],["と"],["言った","いった"],["。"]]},{"verse":11,"text":"そこで群衆,ぐんしゅうは、「この人,ひとはガリラヤのナザレから出,でた預言者,よげんしゃイエスである」と言,いった。","tok":[["そこ"],["で"],["群衆","ぐんしゅう"],["は"],["、"],["「"],["この"],["人","ひと"],["は"],["ガリラヤ"],["の"],["ナザレ"],["から"],["出た","でた"],["預言者","よげんしゃ"],["イエス"],["で"],["ある"],["」"],["と"],["言った","いった"],["。"]]},{"verse":12,"text":"それから、イエスは宮,みやにはいられた。そして、宮,みやの庭,にわで売,うり買,かいしていた人々,ひとびとをみな追,おい出,だし、また両替人,りょうがえにんの台,だいや、はとを売,うる者,ものの腰掛,こしかけをくつがえされた。","tok":[["それ"],["から"],["、"],["イエス"],["は"],["宮","みや"],["に"],["は"],["いられた"],["。"],["そして"],["、"],["宮","みや"],["の"],["庭","にわ"],["で"],["売買","うりかい"],["して"],["いた"],["人々","ひとびと"],["を"],["みな"],["追い出し","おいだし"],["、"],["また"],["両替人","りょうがえにん"],["の"],["台","だい"],["や"],["、"],["はと"],["を"],["売る","うる"],["者","もの"],["の"],["腰掛","こしかけ"],["を"],["くつがえされた"],["。"]]},{"verse":13,"text":"そして彼,かれらに言,いわれた、「『わたしの家,いえは、祈,いのりの家,いえととなえらるべきである』と書,かいてある。それだのに、あなたがたはそれを強盗,ごうとうの巣,すにしている」。","tok":[["そして"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["『"],["わたし"],["の"],["家","いえ"],["は"],["、"],["祈","いのり"],["の"],["家","いえ"],["と"],["となえらるべきで"],["ある"],["』"],["と"],["書いて","かいて"],["ある"],["。"],["それ"],["だ"],["のに"],["、"],["あなた"],["がた"],["は"],["それ"],["を"],["強盗","ごうとう"],["の"],["巣","す"],["に"],["して"],["いる"],["」"],["。"]]},{"verse":14,"text":"そのとき宮,みやの庭,にわで、盲人,もうじんや足,あしなえがみもとにきたので、彼,かれらをおいやしになった。","tok":[["その"],["とき"],["宮","みや"],["の"],["庭","にわ"],["で"],["、"],["盲人","もうじん"],["や"],["足","あし"],["な"],["えがみ"],["もと"],["に"],["きた"],["ので"],["、"],["彼","かれ"],["ら"],["を"],["おいやし"],["に"],["なった"],["。"]]},{"verse":15,"text":"しかし、祭司長,さいしちょう、律法,りっぽう学者,がくしゃたちは、イエスがなされた不思議,ふしぎなわざを見,み、また宮,みやの庭,にわで「ダビデの子,こに、ホサナ」と叫,さけんでいる子供,こどもたちを見,みて立腹,りっぷくし、","tok":[["しかし"],["、"],["祭司長","さいしちょう"],["、"],["律法学者","りっぽうがくしゃ"],["たち"],["は"],["、"],["イエス"],["が"],["なされた"],["不思議","ふしぎ"],["な"],["わざ"],["を"],["見","み"],["、"],["また"],["宮","みや"],["の"],["庭","にわ"],["で"],["「"],["ダビデ"],["の"],["子","こ"],["に"],["、"],["ホサナ"],["」"],["と"],["叫けんで","さけんで"],["いる"],["子供","こども"],["たち"],["を"],["見て","みて"],["立腹","りっぷく"],["し"],["、"]]},{"verse":16,"text":"イエスに言,いった、「あの子,こたちが何,なにを言,いっているのか、お聞,ききですか」。イエスは彼,かれらに言,いわれた、「そうだ、聞,きいている。あなたがたは『幼,おさな子,ご、乳,ちのみ子,ごたちの口,くちにさんびを備,そなえられた』とあるのを読,よんだことがないのか」。","tok":[["イエス"],["に"],["言った","いった"],["、"],["「"],["あの"],["子","こ"],["たち"],["が"],["何に","なに"],["を"],["言って","いって"],["いる"],["の"],["か"],["、"],["お聞","おきき"],["です"],["か"],["」"],["。"],["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["そう"],["だ"],["、"],["聞いて","きいて"],["いる"],["。"],["あなた"],["がた"],["は"],["『"],["幼な子","おさなご"],["、"],["乳","ち"],["のみ"],["子","ごたち"],["の"],["口","くち"],["に"],["さん"],["び"],["を"],["備","そなえ"],["られた"],["』"],["と"],["ある"],["の"],["を"],["読","よんだこ"],["と"],["が"],["ない"],["の"],["か"],["」"],["。"]]},{"verse":17,"text":"それから、イエスは彼,かれらをあとに残,のこし、都,みやこを出,でてベタニヤに行,いき、そこで夜,よを過,すごされた。","tok":[["それ"],["から"],["、"],["イエス"],["は"],["彼","かれ"],["ら"],["を"],["あと"],["に"],["残し","のこし"],["、"],["都","みやこ"],["を"],["出て","でて"],["ベタニヤ"],["に"],["行き","いき"],["、"],["そこ"],["で"],["夜","よ"],["を"],["過ごされた","すごされた"],["。"]]},{"verse":18,"text":"朝,あさはやく都,みやこに帰,かえるとき、イエスは空腹,くうふくをおぼえられた。","tok":[["朝","あさ"],["は"],["やく"],["都","みやこ"],["に"],["帰える","かえる"],["とき"],["、"],["イエス"],["は"],["空腹","くうふく"],["を"],["おぼえられた"],["。"]]},{"verse":19,"text":"そして、道,みちのかたわらに一本,ぽんのいちじくの木,きがあるのを見,みて、そこに行,いかれたが、ただ葉,はのほかは何,なにも見当,みあたらなかった。そこでその木,きにむかって、「今,いまから後,のちいつまでも、おまえには実,みがならないように」と言,いわれた。すると、いちじくの木,きはたちまち枯,かれた。","tok":[["そして"],["、"],["道","みち"],["の"],["かたわら"],["に"],["一本","ぽん"],["の"],["いちじく"],["の"],["木","き"],["が"],["ある"],["の"],["を"],["見て","みて"],["、"],["そこ"],["に"],["行かれた","いかれた"],["が"],["、"],["ただ"],["葉","は"],["の"],["ほか"],["は"],["何に","なに"],["も"],["見当たらなかった","みあたらなかった"],["。"],["そこ"],["で"],["その"],["木","き"],["に"],["むかって"],["、"],["「"],["今","いま"],["から"],["後","のちいつま"],["で"],["も"],["、"],["おまえ"],["に"],["は"],["実らない","みがならない"],["よう"],["に"],["」"],["と"],["言われた","いわれた"],["。"],["する"],["と"],["、"],["いちじく"],["の"],["木","き"],["は"],["たちまち"],["枯た","かれた"],["。"]]},{"verse":20,"text":"弟子,でしたちはこれを見,みて、驚,おどろいて言,いった、「いちじくがどうして、こうすぐに枯,かれたのでしょう」。","tok":[["弟子","でし"],["たち"],["は"],["これ"],["を"],["見て","みて"],["、"],["驚ろいて","おどろいて"],["言った","いった"],["、"],["「"],["いちじく"],["が"],["どう"],["して"],["、"],["こう"],["すぐ"],["に"],["枯た","かれた"],["の"],["でしょう"],["」"],["。"]]},{"verse":21,"text":"イエスは答,こたえて言,いわれた、「よく聞,きいておくがよい。もしあなたがたが信,しんじて疑,うたがわないならば、このいちじくにあったようなことが、できるばかりでなく、この山,やまにむかって、動,うごき出,だして海,うみの中,なかにはいれと言,いっても、そのとおりになるであろう。","tok":[["イエス"],["は"],["答","こたえ"],["て"],["言われた","いわれた"],["、"],["「"],["よく"],["聞いて","きいて"],["おく"],["が"],["よい"],["。"],["もし"],["あなた"],["がた"],["が"],["信じて","しんじて"],["疑がわないならば","うたがわないならば"],["、"],["この"],["いちじく"],["に"],["あった"],["よう"],["な"],["こと"],["が"],["、"],["できる"],["ばかり"],["で"],["なく"],["、"],["この"],["山","やま"],["に"],["むかって"],["、"],["動き","うごき"],["出して","だして"],["海","うみ"],["の"],["中","なか"],["に"],["はいれ"],["と"],["言って","いって"],["も"],["、"],["その"],["とおり"],["に"],["なるで"],["あろう"],["。"]]},{"verse":22,"text":"また、祈,いのりのとき、信,しんじて求,もとめるものは、みな与,あたえられるであろう」。","tok":[["また"],["、"],["祈","いのり"],["の"],["とき"],["、"],["信じて","しんじて"],["求める","もとめる"],["もの"],["は"],["、"],["みな"],["与えられるで","あたえられるで"],["あろう"],["」"],["。"]]},{"verse":23,"text":"イエスが宮,みやにはいられたとき、祭司長,さいしちょうたちや民,たみの長老,ちょうろうたちが、その教,おしえておられる所,ところにきて言,いった、「何,なにの権威,けんいによって、これらの事,ことをするのですか。だれが、そうする権威,けんいを授,さづけたのですか」。","tok":[["イエス"],["が"],["宮","みや"],["に"],["は"],["いられた"],["とき"],["、"],["祭司長","さいしちょう"],["たち"],["や"],["民","たみ"],["の"],["長老","ちょうろう"],["たち"],["が"],["、"],["その"],["教えて","おしえて"],["おられる"],["所","ところ"],["に"],["きて"],["言った","いった"],["、"],["「"],["何","なに"],["の"],["権威","けんい"],["によって"],["、"],["これ"],["ら"],["の"],["事","こと"],["を"],["する"],["の"],["です"],["か"],["。"],["だれ"],["が"],["、"],["そう"],["する"],["権威","けんい"],["を"],["授","さづけた"],["の"],["です"],["か"],["」"],["。"]]},{"verse":24,"text":"そこでイエスは彼,かれらに言,いわれた、「わたしも一つだけ尋,たずねよう。あなたがたがそれに答,こたえてくれたなら、わたしも、何,なにの権威,けんいによってこれらの事,ことをするのか、あなたがたに言,いおう。","tok":[["そこ"],["で"],["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["わたし"],["も"],["一","ひと"],["つ"],["だけ"],["尋ねよう","たずねよう"],["。"],["あなた"],["がた"],["が"],["それ"],["に"],["答","こたえ"],["て"],["くれたなら"],["、"],["わたし"],["も"],["、"],["何","なに"],["の"],["権威","けんい"],["によって"],["これ"],["ら"],["の"],["事","こと"],["を"],["する"],["の"],["か"],["、"],["あなた"],["がた"],["に"],["言おう","いおう"],["。"]]},{"verse":25,"text":"ヨハネのバプテスマはどこからきたのであったか。天,てんからであったか、人,ひとからであったか」。すると、彼,かれらは互,たがいに論,ろんじて言,いった、「もし天,てんからだと言,いえば、では、なぜ彼,かれを信,しんじなかったのか、とイエスは言,いうだろう。","tok":[["ヨハネ"],["の"],["バプテスマ"],["は"],["どこ"],["から"],["きた"],["ので"],["あった"],["か"],["。"],["天","てん"],["から"],["で"],["あった"],["か"],["、"],["人","ひと"],["から"],["で"],["あった"],["か"],["」"],["。"],["する"],["と"],["、"],["彼","かれ"],["ら"],["は"],["互","たがい"],["に"],["論じて","ろんじて"],["言った","いった"],["、"],["「"],["もし"],["天","てん"],["から"],["だ"],["と"],["言えば","いえば"],["、"],["で"],["は"],["、"],["なぜ"],["彼","かれ"],["を"],["信じなかった","しんじなかった"],["の"],["か"],["、"],["と"],["イエス"],["は"],["言うだろう","いうだろう"],["。"]]},{"verse":26,"text":"しかし、もし人,ひとからだと言,いえば、群衆,ぐんしゅうが恐,おそろしい。人々,ひとびとがみなヨハネを預言者,よげんしゃと思,おもっているのだから」。","tok":[["しかし"],["、"],["もし"],["人","ひと"],["から"],["だ"],["と"],["言えば","いえば"],["、"],["群衆","ぐんしゅう"],["が"],["恐ろしい","おそろしい"],["。"],["人々","ひとびと"],["が"],["みな"],["ヨハネ"],["を"],["預言者","よげんしゃ"],["と"],["思って","おもって"],["いる"],["の"],["だ"],["から"],["」"],["。"]]},{"verse":27,"text":"そこで彼,かれらは、「わたしたちにはわかりません」と答,こたえた。すると、イエスが言,いわれた、「わたしも何,なにの権威,けんいによってこれらの事,ことをするのか、あなたがたに言,いうまい。","tok":[["そこ"],["で"],["彼","かれ"],["ら"],["は"],["、"],["「"],["わたしたち"],["に"],["は"],["わかりません"],["」"],["と"],["答","こたえ"],["た"],["。"],["する"],["と"],["、"],["イエス"],["が"],["言われた","いわれた"],["、"],["「"],["わたし"],["も"],["何","なに"],["の"],["権威","けんい"],["によって"],["これ"],["ら"],["の"],["事","こと"],["を"],["する"],["の"],["か"],["、"],["あなた"],["がた"],["に"],["言うまい","いうまい"],["。"]]},{"verse":28,"text":"あなたがたはどう思,おもうか。ある人,ひとにふたりの子,こがあったが、兄,あにのところに行,いって言,いった、『子,こよ、きょう、ぶどう園,えんへ行,いって働,はたらいてくれ』。","tok":[["あなた"],["がた"],["は"],["どう"],["思","おもう"],["か"],["。"],["ある"],["人","ひと"],["に"],["ふたり"],["の"],["子","こ"],["が"],["あった"],["が"],["、"],["兄","あに"],["の"],["ところ"],["に"],["行って","いって"],["言った","いった"],["、"],["『"],["子","こ"],["よ"],["、"],["きょう"],["、"],["ぶどう園","ぶどうえん"],["へ"],["行って","いって"],["働いて","はたらいて"],["くれ"],["』"],["。"]]},{"verse":29,"text":"すると彼,かれは『おとうさん、参,まいります』と答,こたえたが、行,いかなかった。","tok":[["する"],["と"],["彼","かれ"],["は"],["『"],["おとうさん"],["、"],["参ります","まいります"],["』"],["と"],["答","こたえ"],["た"],["が"],["、"],["行かなかった","いかなかった"],["。"]]},{"verse":30,"text":"また弟,おとうとのところにきて同,おなじように言,いった。彼,かれは『いやです』と答,こたえたが、あとから心,こころを変,かえて、出,でかけた。","tok":[["また"],["弟","おとうと"],["の"],["ところ"],["に"],["きて"],["同じ","おなじ"],["よう"],["に"],["言った","いった"],["。"],["彼","かれ"],["は"],["『"],["いや"],["です"],["』"],["と"],["答","こたえ"],["た"],["が"],["、"],["あと"],["から"],["心","こころ"],["を"],["変えて","かえて"],["、"],["出かけた","でかけた"],["。"]]},{"verse":31,"text":"このふたりのうち、どちらが父,ちちの望,のぞみどおりにしたのか」。彼,かれらは言,いった、「あとの者,ものです」。イエスは言,いわれた、「よく聞,ききなさい。取税人,しゅぜいにんや遊女,ゆうじょは、あなたがたより先,さきに神,かみの国,くににはいる。","tok":[["この"],["ふたり"],["の"],["うち"],["、"],["どちら"],["が"],["父","ちち"],["の"],["望み","のぞみ"],["どおり"],["に"],["した"],["の"],["か"],["」"],["。"],["彼","かれ"],["ら"],["は"],["言った","いった"],["、"],["「"],["あと"],["の"],["者","もの"],["です"],["」"],["。"],["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["よく"],["聞","きき"],["なさい"],["。"],["取","とり"],["税人","ぜいにん"],["ぜ"],["い"],["に"],["ん"],["や"],["遊女","ゆうじょ"],["は"],["、"],["あなた"],["が"],["たより"],["先","さき"],["に"],["神","かみ"],["の"],["国","くに"],["に"],["はいる"],["。"]]},{"verse":32,"text":"というのは、ヨハネがあなたがたのところにきて、義,ぎの道,みちを説,といたのに、あなたがたは彼,かれを信,しんじなかった。ところが、取税人,しゅぜいにんや遊女,ゆうじょは彼,かれを信,しんじた。あなたがたはそれを見,みたのに、あとになっても、心,こころをいれ変,かえて彼,かれを信,しんじようとしなかった。","tok":[["と"],["いう"],["の"],["は"],["、"],["ヨハネ"],["が"],["あなた"],["がた"],["の"],["ところ"],["に"],["きて"],["、"],["義","ぎ"],["の"],["道","みち"],["を"],["説いた","といた"],["のに"],["、"],["あなた"],["がた"],["は"],["彼","かれ"],["を"],["信じなかった","しんじなかった"],["。"],["ところ"],["が"],["、"],["取","とり"],["税人","ぜいにん"],["ぜ"],["い"],["に"],["ん"],["や"],["遊女","ゆうじょ"],["は"],["彼","かれ"],["を"],["信じた","しんじた"],["。"],["あなた"],["がた"],["は"],["それ"],["を"],["見た","みた"],["のに"],["、"],["あと"],["に"],["なって"],["も"],["、"],["心","こころ"],["を"],["いれ"],["変えて","かえて"],["彼","かれ"],["を"],["信じよう","しんじよう"],["と"],["しなかった"],["。"]]},{"verse":33,"text":"もう一つの譬,たとえを聞,ききなさい。ある所,ところに、ひとりの家,いえの主人,しゅじんがいたが、ぶどう園,えんを造,つくり、かきをめぐらし、その中,なかに酒,さかぶねの穴,あなを掘,ほり、やぐらを立,たて、それを農夫,のうふたちに貸,かして、旅,たびに出,でかけた。","tok":[["もう"],["一","ひと"],["つ"],["の"],["譬","たとえ"],["を"],["聞","きき"],["なさい"],["。"],["ある"],["所","ところ"],["に"],["、"],["ひとり"],["の"],["家","いえ"],["の"],["主人","しゅじん"],["が"],["いた"],["が"],["、"],["ぶどう園","ぶどうえん"],["を"],["造","つくり"],["、"],["かき"],["を"],["めぐらし"],["、"],["その"],["中","なか"],["に"],["酒","さかぶね"],["の"],["穴","あな"],["を"],["掘","ほり"],["、"],["やぐら"],["を"],["立て","たて"],["、"],["それ"],["を"],["農夫","のうふ"],["たち"],["に"],["貸","かし"],["て"],["、"],["旅","たび"],["に"],["出かけた","でかけた"],["。"]]},{"verse":34,"text":"収穫,しゅうかくの季節,きせつがきたので、その分,わけ前,まえを受,うけ取,とろうとして、僕,しもべたちを農夫,のうふのところへ送,おくった。","tok":[["収穫","しゅうかく"],["の"],["季節","きせつ"],["が"],["きた"],["ので"],["、"],["その"],["分け前","わけまえ"],["を"],["受け取ろう","うけとろう"],["として"],["、"],["僕","し"],["も"],["べ"],["たち"],["を"],["農夫","のうふ"],["の"],["ところ"],["へ"],["送った","おくった"],["。"]]},{"verse":35,"text":"すると、農夫,のうふたちは、その僕,しもべたちをつかまえて、ひとりを袋,ふくろだたきにし、ひとりを殺,ころし、もうひとりを石,いしで打,うち殺,ころした。","tok":[["する"],["と"],["、"],["農夫","のうふ"],["たち"],["は"],["、"],["その"],["僕","し"],["も"],["べ"],["たち"],["を"],["つかまえて"],["、"],["ひとり"],["を"],["袋だたき","ふくろだたき"],["に"],["し"],["、"],["ひとり"],["を"],["殺ろし","ころし"],["、"],["もう"],["ひとり"],["を"],["石","いし"],["で"],["打ち","うち"],["殺ろ","ころ"],["した"],["。"]]},{"verse":36,"text":"また別,べつに、前,まえよりも多,おおくの僕,しもべたちを送,おくったが、彼,かれらをも同,おなじようにあしらった。","tok":[["また"],["別","べつ"],["に"],["、"],["前","まえ"],["より"],["も"],["多く","おおく"],["の"],["僕","し"],["も"],["べ"],["たち"],["を"],["送った","おくった"],["が"],["、"],["彼","かれ"],["ら"],["を"],["も"],["同じ","おなじ"],["よう"],["に"],["あしらった"],["。"]]},{"verse":37,"text":"しかし、最後,さいごに、わたしの子,こは敬,うやまってくれるだろうと思,おもって、主人,しゅじんはその子,こを彼,かれらの所,ところにつかわした。","tok":[["しかし"],["、"],["最後","さいご"],["に"],["、"],["わたし"],["の"],["子","こ"],["は"],["敬って","うやまって"],["くれるだろう"],["と"],["思って","おもって"],["、"],["主人","しゅじん"],["は"],["その"],["子","こ"],["を"],["彼","かれ"],["ら"],["の"],["所","ところ"],["に"],["つかわした"],["。"]]},{"verse":38,"text":"すると農夫,のうふたちは、その子,こを見,みて互,たがいに言,いった、『あれはあと取,とりだ。さあ、これを殺,ころして、その財産,ざいさんを手,てに入,いれよう』。","tok":[["する"],["と"],["農夫","のうふ"],["たち"],["は"],["、"],["その"],["子","こ"],["を"],["見て","みて"],["互","たがい"],["に"],["言った","いった"],["、"],["『"],["あれ"],["は"],["あと"],["取","とり"],["だ"],["。"],["さあ"],["、"],["これ"],["を"],["殺ろして","ころして"],["、"],["その"],["財産","ざいさん"],["を"],["手","て"],["に"],["入れよう","いれよう"],["』"],["。"]]},{"verse":39,"text":"そして彼,かれをつかまえて、ぶどう園,えんの外,そとに引,ひき出,だして殺,ころした。","tok":[["そして"],["彼","かれ"],["を"],["つかまえて"],["、"],["ぶどう園","ぶどうえん"],["の"],["外","そと"],["に"],["引出して","ひきだして"],["殺ろした","ころした"],["。"]]},{"verse":40,"text":"このぶどう園,えんの主人,しゅじんが帰,かえってきたら、この農夫,のうふたちをどうするだろうか」。","tok":[["この"],["ぶどう園","ぶどうえん"],["の"],["主人","しゅじん"],["が"],["帰えって","かえって"],["きたら"],["、"],["この"],["農夫","のうふ"],["たち"],["を"],["どう"],["するだろう"],["か"],["」"],["。"]]},{"verse":41,"text":"彼,かれらはイエスに言,いった、「悪人,あくにんどもを、皆殺,みなごろしにして、季節,きせつごとに収穫,しゅうかくを納,おさめるほかの農夫,のうふたちに、そのぶどう園,えんを貸,かし与,あたえるでしょう」。","tok":[["彼","かれ"],["ら"],["は"],["イエス"],["に"],["言った","いった"],["、"],["「"],["悪人","あくにん"],["ども"],["を"],["、"],["皆殺し","みなごろし"],["に"],["して"],["、"],["季節","きせつ"],["ごと"],["に"],["収穫","しゅうかく"],["を"],["納める","おさめる"],["ほか"],["の"],["農夫","のうふ"],["たち"],["に"],["、"],["その"],["ぶどう園","ぶどうえん"],["を"],["貸与","かしあた"],["えるでしょう"],["」"],["。"]]},{"verse":42,"text":"イエスは彼,かれらに言,いわれた、「あなたがたは、聖書,せいしょでまだ読,よんだことがないのか、『家,いえ造,つくりらの捨,すてた石,いしが隅,すみのかしら石,いしになった。これは主,しゅがなされたことで、わたしたちの目,めには不思議,ふしぎに見,みえる』。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["がた"],["は"],["、"],["聖書","せいしょ"],["で"],["まだ"],["読","よんだこ"],["と"],["が"],["ない"],["の"],["か"],["、"],["『"],["家造","いえつくり"],["ら"],["の"],["捨てた","すてた"],["石","いし"],["が"],["隅","すみ"],["の"],["かしら"],["石","いし"],["に"],["なった"],["。"],["これ"],["は"],["主","しゅ"],["が"],["なされた"],["こと"],["で"],["、"],["わたしたち"],["の"],["目","め"],["に"],["は"],["不思議","ふしぎ"],["に"],["見える","みえる"],["』"],["。"]]},{"verse":43,"text":"それだから、あなたがたに言,いうが、神,かみの国,くにはあなたがたから取,とり上,あげられて、御国,みくににふさわしい実,みを結,むすぶような異邦人,いほうじんに与,あたえられるであろう。","tok":[["それ"],["だ"],["から"],["、"],["あなた"],["がた"],["に"],["言う","いう"],["が"],["、"],["神","かみ"],["の"],["国","くに"],["は"],["あなた"],["がた"],["から"],["取上げられて","とりあげられて"],["、"],["御国","みくに"],["に"],["ふさわしい"],["実","み"],["を"],["結ぶ","むすぶ"],["よう"],["な"],["異邦人","いほうじん"],["に"],["与えられるで","あたえられるで"],["あろう"],["。"]]},{"verse":44,"text":"またその石,いしの上,うえに落,おちる者,ものは打,うち砕,くだかれ、それがだれかの上,うえに落,おちかかるなら、その人,ひとはこなみじんにされるであろう」。","tok":[["また"],["その"],["石","いし"],["の"],["上","うえ"],["に"],["落","おち"],["る"],["者","もの"],["は"],["打ち砕かれ","うちくだかれ"],["、"],["それ"],["が"],["だれ"],["か"],["の"],["上","うえ"],["に"],["落","おち"],["かかるなら"],["、"],["その"],["人","ひと"],["は"],["こな"],["みじん"],["に"],["されるで"],["あろう"],["」"],["。"]]},{"verse":45,"text":"祭司長,さいしちょうたちやパリサイ人,びとたちがこの譬,たとえを聞,きいたとき、自分,じぶんたちのことをさして言,いっておられることを悟,さとったので、","tok":[["祭司長","さいしちょう"],["たち"],["や"],["パリサイ"],["人","びと"],["たち"],["が"],["この"],["譬","たとえ"],["を"],["聞いた","きいた"],["とき"],["、"],["自分","じぶん"],["たち"],["の"],["こと"],["を"],["さして"],["言って","いって"],["おられる"],["こと"],["を"],["悟った","さとった"],["ので"],["、"]]},{"verse":46,"text":"イエスを捕,とらえようとしたが、群衆,ぐんしゅうを恐,おそれた。群衆,ぐんしゅうはイエスを預言者,よげんしゃだと思,おもっていたからである。","tok":[["イエス"],["を"],["捕らえよう","とらえよう"],["と"],["した"],["が"],["、"],["群衆","ぐんしゅう"],["を"],["恐れた","おそれた"],["。"],["群衆","ぐんしゅう"],["は"],["イエス"],["を"],["預言者","よげんしゃ"],["だ"],["と"],["思って","おもって"],["いた"],["から"],["で"],["ある"],["。"]]}]
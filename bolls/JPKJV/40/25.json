[{"verse":1,"text":"そこで天国,てんごくは、十人,にんのおとめがそれぞれあかりを手,てにして、花婿,はなむこを迎,むかえに出,でて行,いくのに似,にている。","tok":[["そこ"],["で"],["天国","てんごく"],["は"],["、"],["十人","にん"],["の"],["おとめ"],["が"],["それぞれ"],["あかり"],["を"],["手","て"],["に"],["して"],["、"],["花婿","はなむこ"],["を"],["迎","むかえ"],["に"],["出て","でて"],["行く","いく"],["のに"],["似て","にて"],["いる"],["。"]]},{"verse":2,"text":"その中,なかの五人,にんは思慮,しりょが浅,あさく、五人,にんは思慮,しりょ深,ぶかい者,ものであった。","tok":[["その"],["中","なか"],["の"],["五人","にん"],["は"],["思慮","しりょ"],["が"],["浅く","あさく"],["、"],["五人","にん"],["は"],["思慮","しりょ"],["深い","ぶかい"],["者","もの"],["で"],["あった"],["。"]]},{"verse":3,"text":"思慮,しりょの浅,あさい者,ものたちは、あかりは持,もっていたが、油,あぶらを用意,よういしていなかった。","tok":[["思慮","しりょ"],["の"],["浅い","あさい"],["者","もの"],["たち"],["は"],["、"],["あかり"],["は"],["持って","もって"],["いた"],["が"],["、"],["油","あぶら"],["を"],["用意","ようい"],["して"],["いなかった"],["。"]]},{"verse":4,"text":"しかし、思慮,しりょ深,ぶかい者,ものたちは、自分,じぶんたちのあかりと一緒,いっしょに、入,いれものの中,なかに油,あぶらを用意,よういしていた。","tok":[["しかし"],["、"],["思慮","しりょ"],["深い","ぶかい"],["者","もの"],["たち"],["は"],["、"],["自分","じぶん"],["たち"],["の"],["あかり"],["と"],["一緒","いっしょ"],["に"],["、"],["入れもの","いれもの"],["の"],["中","なか"],["に"],["油","あぶら"],["を"],["用意","ようい"],["して"],["いた"],["。"]]},{"verse":5,"text":"花婿,はなむこの来,くるのがおくれたので、彼,かれらはみな居眠,いねむりをして、寝,ねてしまった。","tok":[["花婿","はなむこ"],["の"],["来る","くる"],["の"],["が"],["おくれた"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["みな"],["居眠","いねむり"],["を"],["して"],["、"],["寝て","ねて"],["しまった"],["。"]]},{"verse":6,"text":"夜中,よなかに、『さあ、花婿,はなむこだ、迎,むかえに出,でなさい』と呼,よぶ声,こえがした。","tok":[["夜中","よなか"],["に"],["、"],["『"],["さあ"],["、"],["花婿","はなむこ"],["だ"],["、"],["迎","むかえ"],["に"],["出","で"],["なさい"],["』"],["と"],["呼ぶ","よぶ"],["声","こえ"],["が"],["した"],["。"]]},{"verse":7,"text":"そのとき、おとめたちはみな起,おきて、それぞれあかりを整,ととのえた。","tok":[["その"],["とき"],["、"],["おとめ"],["たち"],["は"],["みな"],["起きて","おきて"],["、"],["それぞれ"],["あかり"],["を"],["整えた","ととのえた"],["。"]]},{"verse":8,"text":"ところが、思慮,しりょの浅,あさい女,おんなたちが、思慮,しりょ深,ぶかい女,おんなたちに言,いった、『あなたがたの油,あぶらをわたしたちにわけてください。わたしたちのあかりが消,きえかかっていますから』。","tok":[["ところ"],["が"],["、"],["思慮","しりょ"],["の"],["浅い","あさい"],["女","おんな"],["たち"],["が"],["、"],["思慮","しりょ"],["深い","ぶかい"],["女","おんな"],["たち"],["に"],["言った","いった"],["、"],["『"],["あなた"],["がた"],["の"],["油","あぶら"],["を"],["わたしたち"],["に"],["わけて"],["ください"],["。"],["わたしたち"],["の"],["あかり"],["が"],["消え","きえ"],["かかって"],["います"],["から"],["』"],["。"]]},{"verse":9,"text":"すると、思慮,しりょ深,ぶかい女,おんなたちは答,こたえて言,いった、『わたしたちとあなたがたとに足,たりるだけは、多分,たぶんないでしょう。店,みせに行,いって、あなたがたの分,ふんをお買,かいになる方,ほうがよいでしょう』。","tok":[["する"],["と"],["、"],["思慮","しりょ"],["深い","ぶかい"],["女","おんな"],["たち"],["は"],["答","こたえ"],["て"],["言った","いった"],["、"],["『"],["わたしたち"],["と"],["あなた"],["が"],["たと"],["に"],["足りる","たりる"],["だけ"],["は"],["、"],["多分","たぶん"],["ないでしょう"],["。"],["店","みせ"],["に"],["行って","いって"],["、"],["あなた"],["がた"],["の"],["分","ふん"],["を"],["お買","おかい"],["に"],["なる"],["方","ほう"],["が"],["よいでしょう"],["』"],["。"]]},{"verse":10,"text":"彼,かれらが買,かいに出,でているうちに、花婿,はなむこが着,ついた。そこで、用意,よういのできていた女,おんなたちは、花婿,はなむこと一緒,いっしょに婚,こん宴,えんのへやにはいり、そして戸,とがしめられた。","tok":[["彼","かれ"],["ら"],["が"],["買","かい"],["に"],["出て","でて"],["いる"],["うち"],["に"],["、"],["花婿","はなむこ"],["が"],["着いた","ついた"],["。"],["そこ"],["で"],["、"],["用意","ようい"],["の"],["できて"],["いた"],["女","おんな"],["たち"],["は"],["、"],["花婿","はなむこ"],["と"],["一緒","いっしょ"],["に"],["婚","こん"],["宴","えん"],["の"],["へや"],["に"],["はいり"],["、"],["そして"],["戸","と"],["が"],["しめられた"],["。"]]},{"verse":11,"text":"そのあとで、ほかのおとめたちもきて、『ご主人様,しゅじんさま、ご主人様,しゅじんさま、どうぞ、あけてください』と言,いった。","tok":[["その"],["あと"],["で"],["、"],["ほか"],["の"],["おとめ"],["たち"],["も"],["きて"],["、"],["『"],["ご主人様","ごしゅじんさま"],["、"],["ご主人様","ごしゅじんさま"],["、"],["どうぞ"],["、"],["あけて"],["ください"],["』"],["と"],["言った","いった"],["。"]]},{"verse":12,"text":"しかし彼,かれは答,こたえて、『はっきり言,いうが、わたしはあなたがたを知,しらない』と言,いった。","tok":[["しかし"],["彼","かれ"],["は"],["答","こたえ"],["て"],["、"],["『"],["はっきり"],["言う","いう"],["が"],["、"],["わたし"],["は"],["あなた"],["がた"],["を"],["知らない","しらない"],["』"],["と"],["言った","いった"],["。"]]},{"verse":13,"text":"だから、目,めをさましていなさい。その日,ひその時,ときが、あなたがたにはわからないからである。","tok":[["だ"],["から"],["、"],["目","め"],["を"],["さまして"],["い"],["なさい"],["。"],["その"],["日","ひ"],["その"],["時","とき"],["が"],["、"],["あなた"],["がた"],["に"],["は"],["わからない"],["から"],["で"],["ある"],["。"]]},{"verse":14,"text":"また天国,てんごくは、ある人,ひとが旅,たびに出,でるとき、その僕,しもべどもを呼,よんで、自分,じぶんの財産,ざいさんを預,あづけるようなものである。","tok":[["また"],["天国","てんごく"],["は"],["、"],["ある"],["人","ひと"],["が"],["旅","たび"],["に"],["出る","でる"],["とき"],["、"],["その"],["僕","し"],["も"],["べ"],["ども"],["を"],["呼んで","よんで"],["、"],["自分","じぶん"],["の"],["財産","ざいさん"],["を"],["預","あ"],["づける"],["よう"],["な"],["もの"],["で"],["ある"],["。"]]},{"verse":15,"text":"すなわち、それぞれの能力,のうりょくに応,おうじて、ある者,ものには五タラント、ある者,ものには二タラント、ある者,ものには一タラントを与,あたえて、旅,たびに出,でた。","tok":[["すなわち"],["、"],["それぞれ"],["の"],["能力","のうりょく"],["に"],["応じて","おうじて"],["、"],["ある"],["者","もの"],["に"],["は"],["五","ご"],["タラント"],["、"],["ある"],["者","もの"],["に"],["は"],["二","に"],["タラント"],["、"],["ある"],["者","もの"],["に"],["は"],["一","いち"],["タラント"],["を"],["与","あたえ"],["て"],["、"],["旅","たび"],["に"],["出た","でた"],["。"]]},{"verse":16,"text":"五タラントを渡,わたされた者,ものは、すぐに行,いって、それで商売,しょうばいをして、ほかに五タラントをもうけた。","tok":[["五","ご"],["タラント"],["を"],["渡された","わたされた"],["者","もの"],["は"],["、"],["すぐ"],["に"],["行って","いって"],["、"],["それ"],["で"],["商売","しょうばい"],["を"],["して"],["、"],["ほか"],["に"],["五","ご"],["タラント"],["を"],["もうけた"],["。"]]},{"verse":17,"text":"二タラントの者,ものも同様,どうようにして、ほかに二タラントをもうけた。","tok":[["二","に"],["タラント"],["の"],["者","もの"],["も"],["同様","どうよう"],["に"],["して"],["、"],["ほか"],["に"],["二","に"],["タラント"],["を"],["もうけた"],["。"]]},{"verse":18,"text":"しかし、一タラントを渡,わたされた者,ものは、行,いって地,ちを掘,ほり、主人,しゅじんの金,かねを隠,かくしておいた。","tok":[["しかし"],["、"],["一","いち"],["タラント"],["を"],["渡された","わたされた"],["者","もの"],["は"],["、"],["行って","いって"],["地","ち"],["を"],["掘","ほり"],["、"],["主人","しゅじん"],["の"],["金","かね"],["を"],["隠して","かくして"],["おいた"],["。"]]},{"verse":19,"text":"だいぶ時,ときがたってから、これらの僕,しもべの主人,しゅじんが帰,かえってきて、彼,かれらと計算,けいさんをしはじめた。","tok":[["だいぶ"],["時","とき"],["が"],["たって"],["から"],["、"],["これ"],["ら"],["の"],["僕","し"],["も"],["べ"],["の"],["主人","しゅじん"],["が"],["帰えって","かえって"],["きて"],["、"],["彼","かれ"],["ら"],["と"],["計算","けいさん"],["を"],["し"],["はじめた"],["。"]]},{"verse":20,"text":"すると五タラントを渡,わたされた者,ものが進,すすみ出,でて、ほかの五タラントをさし出,だして言,いった、『ご主人様,しゅじんさま、あなたはわたしに五タラントをお預,あづけになりましたが、ごらんのとおり、ほかに五タラントをもうけました』。","tok":[["する"],["と"],["五","ご"],["タラント"],["を"],["渡された","わたされた"],["者","もの"],["が"],["進み出て","すすみでて"],["、"],["ほか"],["の"],["五","ご"],["タラント"],["を"],["さし出して","さしだして"],["言った","いった"],["、"],["『"],["ご主人様","ごしゅじんさま"],["、"],["あなた"],["は"],["わたし"],["に"],["五","ご"],["タラント"],["を"],["お預","おあづけ"],["に"],["なりました"],["が"],["、"],["ごらん"],["の"],["とおり"],["、"],["ほか"],["に"],["五","ご"],["タラント"],["を"],["もうけました"],["』"],["。"]]},{"verse":21,"text":"主人,しゅじんは彼,かれに言,いった、『良,よい忠実,ちゅうじつな僕,しもべよ、よくやった。あなたはわずかなものに忠実,ちゅうじつであったから、多,おおくのものを管理,かんりさせよう。主人,しゅじんと一緒,いっしょに喜,よろこんでくれ』。","tok":[["主人","しゅじん"],["は"],["彼","かれ"],["に"],["言った","いった"],["、"],["『"],["良い","よい"],["忠実","ちゅうじつ"],["な"],["僕","し"],["も"],["べ"],["よ"],["、"],["よく"],["やった"],["。"],["あなた"],["は"],["わずか"],["な"],["もの"],["に"],["忠実","ちゅうじつ"],["で"],["あった"],["から"],["、"],["多く","おおく"],["の"],["もの"],["を"],["管理","かんり"],["させよう"],["。"],["主人","しゅじん"],["と"],["一緒","いっしょ"],["に"],["喜こんで","よろこんで"],["くれ"],["』"],["。"]]},{"verse":22,"text":"二タラントの者,ものも進,すすみ出,でて言,いった、『ご主人様,しゅじんさま、あなたはわたしに二タラントをお預,あづけになりましたが、ごらんのとおり、ほかに二タラントをもうけました』。","tok":[["二","に"],["タラント"],["の"],["者","もの"],["も"],["進み出て","すすみでて"],["言った","いった"],["、"],["『"],["ご主人様","ごしゅじんさま"],["、"],["あなた"],["は"],["わたし"],["に"],["二","に"],["タラント"],["を"],["お預","おあづけ"],["に"],["なりました"],["が"],["、"],["ごらん"],["の"],["とおり"],["、"],["ほか"],["に"],["二","に"],["タラント"],["を"],["もうけました"],["』"],["。"]]},{"verse":23,"text":"主人,しゅじんは彼,かれに言,いった、『良,よい忠実,ちゅうじつな僕,しもべよ、よくやった。あなたはわずかなものに忠実,ちゅうじつであったから、多,おおくのものを管理,かんりさせよう。主人,しゅじんと一緒,いっしょに喜,よろこんでくれ』。","tok":[["主人","しゅじん"],["は"],["彼","かれ"],["に"],["言った","いった"],["、"],["『"],["良い","よい"],["忠実","ちゅうじつ"],["な"],["僕","し"],["も"],["べ"],["よ"],["、"],["よく"],["やった"],["。"],["あなた"],["は"],["わずか"],["な"],["もの"],["に"],["忠実","ちゅうじつ"],["で"],["あった"],["から"],["、"],["多く","おおく"],["の"],["もの"],["を"],["管理","かんり"],["させよう"],["。"],["主人","しゅじん"],["と"],["一緒","いっしょ"],["に"],["喜こんで","よろこんで"],["くれ"],["』"],["。"]]},{"verse":24,"text":"一タラントを渡,わたされた者,ものも進,すすみ出,でて言,いった、『ご主人様,しゅじんさま、わたしはあなたが、まかない所,ところから刈,かり、散,ちらさない所,ところから集,あつめる酷,こくな人,ひとであることを承知,しょうちしていました。","tok":[["一","いち"],["タラント"],["を"],["渡された","わたされた"],["者","もの"],["も"],["進み出て","すすみでて"],["言った","いった"],["、"],["『"],["ご主人様","ごしゅじんさま"],["、"],["わたし"],["は"],["あなた"],["が"],["、"],["まかない"],["所","ところ"],["から"],["刈","かり"],["、"],["散らさない","ちらさない"],["所","ところ"],["から"],["集める","あつめる"],["酷","こく"],["な"],["人","ひと"],["で"],["ある"],["こと"],["を"],["承知","しょうち"],["して"],["いました"],["。"]]},{"verse":25,"text":"そこで恐,おそろしさのあまり、行,いって、あなたのタラントを地,ちの中,なかに隠,かくしておきました。ごらんください。ここにあなたのお金,かねがございます』。","tok":[["そこ"],["で"],["恐ろし","おそろし"],["さ"],["の"],["あまり"],["、"],["行って","いって"],["、"],["あなた"],["の"],["タラント"],["を"],["地","ち"],["の"],["中","なか"],["に"],["隠して","かくして"],["おきました"],["。"],["ごらん"],["ください"],["。"],["ここ"],["に"],["あなた"],["の"],["お金","おかね"],["が"],["ございます"],["』"],["。"]]},{"verse":26,"text":"すると、主人,しゅじんは彼,かれに答,こたえて言,いった、『悪,わるい怠惰,たいだな僕,しもべよ、あなたはわたしが、まかない所,ところから刈,かり、散,ちらさない所,ところから集,あつめることを知,しっているのか。","tok":[["する"],["と"],["、"],["主人","しゅじん"],["は"],["彼","かれ"],["に"],["答","こたえ"],["て"],["言った","いった"],["、"],["『"],["悪い","わるい"],["怠惰","たいだ"],["な"],["僕","し"],["も"],["べ"],["よ"],["、"],["あなた"],["は"],["わたし"],["が"],["、"],["まかない"],["所","ところ"],["から"],["刈","かり"],["、"],["散らさない","ちらさない"],["所","ところ"],["から"],["集める","あつめる"],["こと"],["を"],["知って","しって"],["いる"],["の"],["か"],["。"]]},{"verse":27,"text":"それなら、わたしの金,かねを銀行,ぎんこうに預,あづけておくべきであった。そうしたら、わたしは帰,かえってきて、利子,りしと一緒,いっしょにわたしの金,かねを返,かえしてもらえたであろうに。","tok":[["それ"],["なら"],["、"],["わたし"],["の"],["金","かね"],["を"],["銀行","ぎんこう"],["に"],["預","あ"],["づけて"],["おくべきで"],["あった"],["。"],["そう"],["したら"],["、"],["わたし"],["は"],["帰えって","かえって"],["きて"],["、"],["利子","りし"],["と"],["一緒","いっしょ"],["に"],["わたし"],["の"],["金","かね"],["を"],["返","かえし"],["て"],["もらえたで"],["あろう"],["に"],["。"]]},{"verse":28,"text":"さあ、そのタラントをこの者,ものから取,とりあげて、十タラントを持,もっている者,ものにやりなさい。","tok":[["さあ"],["、"],["その"],["タラント"],["を"],["この"],["者","もの"],["から"],["取","とり"],["あげて"],["、"],["十","じゅう"],["タラント"],["を"],["持って","もって"],["いる"],["者","もの"],["に"],["やり"],["なさい"],["。"]]},{"verse":29,"text":"おおよそ、持,もっている人,ひとは与,あたえられて、いよいよ豊,ゆたかになるが、持,もっていない人,ひとは、持,もっているものまでも取,とり上,あげられるであろう。","tok":[["おおよそ"],["、"],["持て","もって"],["いる"],["人","ひと"],["は"],["与えられて","あたえられて"],["、"],["いよいよ"],["豊","ゆたか"],["に"],["なる"],["が"],["、"],["持て","もって"],["いない"],["人","ひと"],["は"],["、"],["持て","もって"],["いる"],["もの"],["まで"],["も"],["取上げられるで","とりあげられるで"],["あろう"],["。"]]},{"verse":30,"text":"この役,やくに立,たたない僕,しもべを外,そとの暗,くらい所,ところに追,おい出,だすがよい。彼,かれは、そこで泣,なき叫,さけんだり、歯,はがみをしたりするであろう』。","tok":[["この"],["役","やく"],["に"],["立たない","たたない"],["僕","し"],["も"],["べ"],["を"],["外","そと"],["の"],["暗い","くらい"],["所","ところ"],["に"],["追い出す","おいだす"],["が"],["よい"],["。"],["彼","かれ"],["は"],["、"],["そこ"],["で"],["泣","なき"],["叫けん","さけん"],["だり"],["、"],["歯がみ","はがみ"],["を"],["し"],["たり"],["するで"],["あろう"],["』"],["。"]]},{"verse":31,"text":"人,ひとの子,こが栄光,えいこうの中,なかにすべての御使,みつかいたちを従,したがえて来,くるとき、彼,かれはその栄光,えいこうの座,ざにつくであろう。","tok":[["人","ひと"],["の"],["子","こ"],["が"],["栄光","えいこう"],["の"],["中","なか"],["に"],["すべて"],["の"],["御使","みつかいたち"],["を"],["従えて","したがえて"],["来る","くる"],["とき"],["、"],["彼","かれ"],["は"],["その"],["栄光","えいこう"],["の"],["座","ざ"],["に"],["つくで"],["あろう"],["。"]]},{"verse":32,"text":"そして、すべての国民,こくみんをその前,まえに集,あつめて、羊飼,ひつじかいが羊,ひつじとやぎとを分,わけるように、彼,かれらをより分,わけ、","tok":[["そして"],["、"],["すべて"],["の"],["国民","こくみん"],["を"],["その"],["前","まえ"],["に"],["集めて","あつめて"],["、"],["羊飼","ひつじかい"],["が"],["羊","ひつじ"],["と"],["やぎ"],["と"],["を"],["分ける","わける"],["よう"],["に"],["、"],["彼","かれ"],["ら"],["を"],["より分け","よりわけ"],["、"]]},{"verse":33,"text":"羊,ひつじを右,みぎに、やぎを左,ひだりにおくであろう。","tok":[["羊","ひつじ"],["を"],["右","みぎ"],["に"],["、"],["やぎ"],["を"],["左","ひだり"],["に"],["おく"],["で"],["あろう"],["。"]]},{"verse":34,"text":"そのとき、王,おうは右,みぎにいる人々,ひとびとに言,いうであろう、『わたしの父,ちちに祝福,しゅくふくされた人,ひとたちよ、さあ、世,よの初,はじめからあなたがたのために用意,よういされている御国,みくにを受,うけつぎなさい。","tok":[["その"],["とき"],["、"],["王","おう"],["は"],["右","みぎ"],["に"],["いる"],["人々","ひとびと"],["に"],["言うで","いうで"],["あろう"],["、"],["『"],["わたし"],["の"],["父","ちち"],["に"],["祝福","しゅくふく"],["された"],["人","ひと"],["たち"],["よ"],["、"],["さあ"],["、"],["世","よ"],["の"],["初め","はじめ"],["から"],["あなた"],["がた"],["の"],["ため"],["に"],["用意","ようい"],["されて"],["いる"],["御国","みくに"],["を"],["受","うけ"],["つぎ"],["なさい"],["。"]]},{"verse":35,"text":"あなたがたは、わたしが空腹,くうふくのときに食,たべさせ、かわいていたときに飲,のませ、旅人,たびびとであったときに宿,やどを貸,かし、","tok":[["あなた"],["がた"],["は"],["、"],["わたし"],["が"],["空腹","くうふく"],["の"],["とき"],["に"],["食べさせ","たべさせ"],["、"],["かわいて"],["いた"],["とき"],["に"],["飲ませ","のませ"],["、"],["旅人","たびびと"],["で"],["あった"],["とき"],["に"],["宿","やど"],["を"],["貸","かし"],["、"]]},{"verse":36,"text":"裸,はだかであったときに着,きせ、病気,びょうきのときに見舞,みまい、獄,ごくにいたときに尋,たずねてくれたからである』。","tok":[["裸","はだか"],["で"],["あった"],["とき"],["に"],["着せ","きせ"],["、"],["病気","びょうき"],["の"],["とき"],["に"],["見舞","みまい"],["、"],["獄","ごく"],["に"],["いた"],["とき"],["に"],["尋ねて","たずねて"],["くれた"],["から"],["で"],["ある"],["』"],["。"]]},{"verse":37,"text":"そのとき、正,ただしい者,ものたちは答,こたえて言,いうであろう、『主,しゅよ、いつ、わたしたちは、あなたが空腹,くうふくであるのを見,みて食物,しょくもつをめぐみ、かわいているのを見,みて飲,のませましたか。","tok":[["その"],["とき"],["、"],["正い","ただしい"],["者","もの"],["たち"],["は"],["答","こたえ"],["て"],["言うで","いうで"],["あろう"],["、"],["『"],["主","しゅ"],["よ"],["、"],["いつ"],["、"],["わたしたち"],["は"],["、"],["あなた"],["が"],["空腹","くうふく"],["で"],["ある"],["の"],["を"],["見て","みて"],["食物","しょくもつ"],["を"],["めぐみ"],["、"],["かわいて"],["いる"],["の"],["を"],["見て","みて"],["飲ませました","のませました"],["か"],["。"]]},{"verse":38,"text":"いつあなたが旅人,たびびとであるのを見,みて宿,やどを貸,かし、裸,はだかなのを見,みて着,きせましたか。","tok":[["いつ"],["あなた"],["が"],["旅人","たびびと"],["で"],["ある"],["の"],["を"],["見て","みて"],["宿","やど"],["を"],["貸","かし"],["、"],["裸","はだか"],["な"],["の"],["を"],["見て","みて"],["着せました","きせました"],["か"],["。"]]},{"verse":39,"text":"また、いつあなたが病気,びょうきをし、獄,ごくにいるのを見,みて、あなたの所,ところに参,まいりましたか』。","tok":[["また"],["、"],["いつ"],["あなた"],["が"],["病気","びょうき"],["を"],["し"],["、"],["獄","ごく"],["に"],["いる"],["の"],["を"],["見て","みて"],["、"],["あなた"],["の"],["所","ところ"],["に"],["参りました","まいりました"],["か"],["』"],["。"]]},{"verse":40,"text":"すると、王,おうは答,こたえて言,いうであろう、『あなたがたによく言,いっておく。わたしの兄弟,きょうだいであるこれらの最,もっとも小,ちいさい者,もののひとりにしたのは、すなわち、わたしにしたのである』。","tok":[["する"],["と"],["、"],["王","おう"],["は"],["答","こたえ"],["て"],["言うで","いうで"],["あろう"],["、"],["『"],["あなた"],["がた"],["に"],["よく"],["言って","いって"],["おく"],["。"],["わたし"],["の"],["兄弟","きょうだい"],["で"],["ある"],["これ"],["ら"],["の"],["最も","もっとも"],["小さい","ちいさい"],["者","もの"],["の"],["ひとり"],["に"],["した"],["の"],["は"],["、"],["すなわち"],["、"],["わたし"],["に"],["した"],["ので"],["ある"],["』"],["。"]]},{"verse":41,"text":"それから、左,ひだりにいる人々,ひとびとにも言,いうであろう、『のろわれた者,ものどもよ、わたしを離,はなれて、悪魔,あくまとその使,つかいたちとのために用意,よういされている永遠,えいえんの火,ひにはいってしまえ。","tok":[["それ"],["から"],["、"],["左","ひだり"],["に"],["いる"],["人々","ひとびと"],["に"],["も"],["言うで","いうで"],["あろう"],["、"],["『"],["のろわれた"],["者","もの"],["ども"],["よ"],["、"],["わたし"],["を"],["離れて","はなれて"],["、"],["悪魔","あくま"],["と"],["その"],["使","つかい"],["たち"],["と"],["の"],["ため"],["に"],["用意","ようい"],["されて"],["いる"],["永遠","えいえん"],["の"],["火","ひ"],["に"],["はいって"],["しまえ"],["。"]]},{"verse":42,"text":"あなたがたは、わたしが空腹,くうふくのときに食,たべさせず、かわいていたときに飲,のませず、","tok":[["あなた"],["がた"],["は"],["、"],["わたし"],["が"],["空腹","くうふく"],["の"],["とき"],["に"],["食べさせず","たべさせず"],["、"],["かわいて"],["いた"],["とき"],["に"],["飲ませず","のませず"],["、"]]},{"verse":43,"text":"旅人,たびびとであったときに宿,やどを貸,かさず、裸,はだかであったときに着,きせず、また病気,びょうきのときや、獄,ごくにいたときに、わたしを尋,たずねてくれなかったからである』。","tok":[["旅人","たびびと"],["で"],["あった"],["とき"],["に"],["宿","やど"],["を"],["貸さず","かさず"],["、"],["裸","はだか"],["で"],["あった"],["とき"],["に"],["着せず","きせず"],["、"],["また"],["病気","びょうき"],["の"],["とき"],["や"],["、"],["獄","ごく"],["に"],["いた"],["とき"],["に"],["、"],["わたし"],["を"],["尋ねて","たずねて"],["くれなかった"],["から"],["で"],["ある"],["』"],["。"]]},{"verse":44,"text":"そのとき、彼,かれらもまた答,こたえて言,いうであろう、『主,しゅよ、いつ、あなたが空腹,くうふくであり、かわいておられ、旅人,たびびとであり、裸,はだかであり、病気,びょうきであり、獄,ごくにおられたのを見,みて、わたしたちはお世話,せわをしませんでしたか』。","tok":[["その"],["とき"],["、"],["彼","かれ"],["ら"],["も"],["また"],["答","こたえ"],["て"],["言うで","いうで"],["あろう"],["、"],["『"],["主","しゅ"],["よ"],["、"],["いつ"],["、"],["あなた"],["が"],["空腹","くうふく"],["で"],["あり"],["、"],["かわいて"],["おられ"],["、"],["旅人","たびびと"],["で"],["あり"],["、"],["裸","はだか"],["で"],["あり"],["、"],["病気","びょうき"],["で"],["あり"],["、"],["獄","ごく"],["に"],["おられた"],["の"],["を"],["見て","みて"],["、"],["わたしたち"],["は"],["お世話","おせわ"],["を"],["しませんでした"],["か"],["』"],["。"]]},{"verse":45,"text":"そのとき、彼,かれは答,こたえて言,いうであろう、『あなたがたによく言,いっておく。これらの最,もっとも小,ちいさい者,もののひとりにしなかったのは、すなわち、わたしにしなかったのである』。","tok":[["その"],["とき"],["、"],["彼","かれ"],["は"],["答","こたえ"],["て"],["言うで","いうで"],["あろう"],["、"],["『"],["あなた"],["がた"],["に"],["よく"],["言って","いって"],["おく"],["。"],["これ"],["ら"],["の"],["最も","もっとも"],["小さい","ちいさい"],["者","もの"],["の"],["ひとり"],["に"],["しなかった"],["の"],["は"],["、"],["すなわち"],["、"],["わたし"],["に"],["しなかった"],["ので"],["ある"],["』"],["。"]]},{"verse":46,"text":"そして彼,かれらは永遠,えいえんの刑罰,けいばつを受,うけ、正,ただしい者,ものは永遠,えいえんの生命,せいめいに入,いるであろう」。","tok":[["そして"],["彼","かれ"],["ら"],["は"],["永遠","えいえん"],["の"],["刑罰","けいばつ"],["を"],["受け","うけ"],["、"],["正い","ただしい"],["者","もの"],["は"],["永遠","えいえん"],["の"],["生命","せいめい"],["に"],["入るで","いるで"],["あろう"],["」"],["。"]]}]
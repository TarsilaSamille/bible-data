[{"verse":1,"text":"そのときイエスは、群衆,ぐんしゅうと弟子,でしたちとに語,かたって言,いわれた、","tok":[["その"],["とき"],["イエス"],["は"],["、"],["群衆","ぐんしゅう"],["と"],["弟子","でし"],["たち"],["と"],["に"],["語って","かたって"],["言われた","いわれた"],["、"]]},{"verse":2,"text":"「律法,りっぽう学者,がくしゃとパリサイ人,びととは、モーセの座,ざにすわっている。","tok":[["「"],["律法学者","りっぽうがくしゃ"],["と"],["パリサイ"],["人","びとと"],["は"],["、"],["モーセ"],["の"],["座","ざ"],["に"],["すわって"],["いる"],["。"]]},{"verse":3,"text":"だから、彼,かれらがあなたがたに言,いうことは、みな守,まもって実行,じっこうしなさい。しかし、彼,かれらのすることには、ならうな。彼,かれらは言,いうだけで、実行,じっこうしないから。","tok":[["だ"],["から"],["、"],["彼","かれ"],["ら"],["が"],["あなた"],["がた"],["に"],["言う","いう"],["こと"],["は"],["、"],["みな"],["守って","まもって"],["実行","じっこう"],["し"],["なさい"],["。"],["しかし"],["、"],["彼","かれ"],["ら"],["の"],["する"],["こと"],["に"],["は"],["、"],["ならう"],["な"],["。"],["彼","かれ"],["ら"],["は"],["言う","いう"],["だけ"],["で"],["、"],["実行","じっこう"],["しない"],["から"],["。"]]},{"verse":4,"text":"また、重,おもい荷物,にもつをくくって人々,ひとびとの肩,かたにのせるが、それを動,うごかすために、自分,じぶんでは指,ゆび一本,ぽんも貸,かそうとはしない。","tok":[["また"],["、"],["重い","おもい"],["荷物","にもつ"],["を"],["くくって"],["人々","ひとびと"],["の"],["肩","かた"],["に"],["のせる"],["が"],["、"],["それ"],["を"],["動かす","うごかす"],["ため"],["に"],["、"],["自分","じぶん"],["で"],["は"],["指","ゆび"],["一本","ぽん"],["も"],["貸そう","かそう"],["と"],["は"],["しない"],["。"]]},{"verse":5,"text":"そのすることは、すべて人,ひとに見,みせるためである。すなわち、彼,かれらは経札,きょうふだを幅広,はばひろくつくり、その衣,ころものふさを大,おおきくし、","tok":[["その"],["する"],["こと"],["は"],["、"],["すべて"],["人","ひと"],["に"],["見せる","みせる"],["ため"],["で"],["ある"],["。"],["すなわち"],["、"],["彼","かれ"],["ら"],["は"],["経","けい"],["札","さつ"],["を"],["幅広く","はばひろく"],["つくり"],["、"],["その"],["衣","ころも"],["の"],["ふさ"],["を"],["大きく","おおきく"],["し"],["、"]]},{"verse":6,"text":"また、宴会,えんかいの上座,じょうざ、会堂,かいどうの上席,じょうせきを好,このみ、","tok":[["また"],["、"],["宴会","えんかい"],["の"],["上座","じょ"],["うざ"],["、"],["会堂","かいどう"],["の"],["上席","じょうせき"],["を"],["好み","このみ"],["、"]]},{"verse":7,"text":"広場,ひろばであいさつされることや、人々,ひとびとから先生,せんせいと呼,よばれることを好,このんでいる。","tok":[["広場","ひろば"],["で"],["あいさつ"],["される"],["こと"],["や"],["、"],["人々","ひとびと"],["から"],["先生","せんせい"],["と"],["呼ばれる","よばれる"],["こと"],["を"],["好んで","このんで"],["いる"],["。"]]},{"verse":8,"text":"しかし、あなたがたは先生,せんせいと呼,よばれてはならない。あなたがたの先生,せんせいは、ただひとりであって、あなたがたはみな兄弟,きょうだいなのだから。","tok":[["しかし"],["、"],["あなた"],["がた"],["は"],["先生","せんせい"],["と"],["呼ばれて","よばれて"],["は"],["ならない"],["。"],["あなた"],["がた"],["の"],["先生","せんせい"],["は"],["、"],["ただ"],["ひとり"],["で"],["あって"],["、"],["あなた"],["がた"],["は"],["みな"],["兄弟","きょうだい"],["な"],["の"],["だ"],["から"],["。"]]},{"verse":9,"text":"また、地上,ちじょうのだれをも、父,ちちと呼,よんではならない。あなたがたの父,ちちはただひとり、すなわち、天,てんにいます父,ちちである。","tok":[["また"],["、"],["地上","ちじょう"],["の"],["だれ"],["を"],["も"],["、"],["父","ちち"],["と"],["呼","よん"],["で"],["は"],["ならない"],["。"],["あなた"],["がた"],["の"],["父","ちち"],["は"],["ただ"],["ひとり"],["、"],["すなわち"],["、"],["天","てん"],["に"],["います"],["父","ちち"],["で"],["ある"],["。"]]},{"verse":10,"text":"また、あなたがたは教師,きょうしと呼,よばれてはならない。あなたがたの教師,きょうしはただひとり、すなわち、キリストである。","tok":[["また"],["、"],["あなた"],["がた"],["は"],["教師","きょうし"],["と"],["呼ばれて","よばれて"],["は"],["ならない"],["。"],["あなた"],["がた"],["の"],["教師","きょうし"],["は"],["ただ"],["ひとり"],["、"],["すなわち"],["、"],["キリスト"],["で"],["ある"],["。"]]},{"verse":11,"text":"そこで、あなたがたのうちでいちばん偉,えらい者,ものは、仕,つかえる人,ひとでなければならない。","tok":[["そこ"],["で"],["、"],["あなた"],["がた"],["の"],["うち"],["で"],["いちばん"],["偉い","えらい"],["者","もの"],["は"],["、"],["仕える","つかえる"],["人","ひと"],["で"],["なければ"],["ならない"],["。"]]},{"verse":12,"text":"だれでも自分,じぶんを高,たかくする者,ものは低,ひくくされ、自分,じぶんを低,ひくくする者,ものは高,たかくされるであろう。","tok":[["だれ"],["で"],["も"],["自分","じぶん"],["を"],["高かく","たかく"],["する"],["者","もの"],["は"],["低く","ひくく"],["され"],["、"],["自分","じぶん"],["を"],["低く","ひくく"],["する"],["者","もの"],["は"],["高かく","たかく"],["されるで"],["あろう"],["。"]]},{"verse":13,"text":"偽善,ぎぜんな律法,りっぽう学者,がくしゃ、パリサイ人,びとたちよ。あなたがたは、わざわいである。あなたがたは、天国,てんごくを閉,とざして人々,ひとびとをはいらせない。自分,じぶんもはいらないし、はいろうとする人,ひとをはいらせもしない。〔","tok":[["偽善","ぎぜん"],["な"],["律法学者","りっぽうがくしゃ"],["、"],["パリサイ"],["人","びと"],["たち"],["よ"],["。"],["あなた"],["がた"],["は"],["、"],["わざわい"],["で"],["ある"],["。"],["あなた"],["がた"],["は"],["、"],["天国","てんごく"],["を"],["閉ざして","とざして"],["人々","ひとびと"],["を"],["はいらせない"],["。"],["自分","じぶん"],["も"],["はいらない"],["し"],["、"],["はいろう"],["と"],["する"],["人","ひと"],["を"],["はいらせ"],["も"],["しない"],["。"],["〔"]]},{"verse":14,"text":"偽善,ぎぜんな律法,りっぽう学者,がくしゃ、パリサイ人,びとたちよ。あなたがたは、わざわいである。あなたがたは、やもめたちの家,いえを食,くい倒,たおし、見,みえのために長,ながい祈,いのりをする。だから、もっときびしいさばきを受,うけるに違,ちがいない。〕","tok":[["偽善","ぎぜん"],["な"],["律法学者","りっぽうがくしゃ"],["、"],["パリサイ"],["人","びと"],["たち"],["よ"],["。"],["あなた"],["がた"],["は"],["、"],["わざわい"],["で"],["ある"],["。"],["あなた"],["がた"],["は"],["、"],["やもめ"],["たち"],["の"],["家","いえ"],["を"],["食い倒し","くいたおし"],["、"],["見え","みえ"],["の"],["ため"],["に"],["長い","ながい"],["祈","いのり"],["を"],["する"],["。"],["だ"],["から"],["、"],["もっと"],["きびしい"],["さばき"],["を"],["受る","うける"],["に"],["違い","ちがい"],["ない"],["。"],["〕"]]},{"verse":15,"text":"偽善,ぎぜんな律法,りっぽう学者,がくしゃ、パリサイ人,びとたちよ。あなたがたは、わざわいである。あなたがたはひとりの改宗者,かいしゅうしゃをつくるために、海,うみと陸,りくとを巡,めぐり歩,あるく。そして、つくったなら、彼,かれを自分,じぶんより倍,ばいもひどい地獄,じごくの子,こにする。","tok":[["偽善","ぎぜん"],["な"],["律法学者","りっぽうがくしゃ"],["、"],["パリサイ"],["人","びと"],["たち"],["よ"],["。"],["あなた"],["がた"],["は"],["、"],["わざわい"],["で"],["ある"],["。"],["あなた"],["がた"],["は"],["ひとり"],["の"],["改宗者","かいしゅうしゃ"],["を"],["つくる"],["ため"],["に"],["、"],["海","うみ"],["と"],["陸","りく"],["と"],["を"],["巡り歩く","めぐりあるく"],["。"],["そして"],["、"],["つくったなら"],["、"],["彼","かれ"],["を"],["自分","じぶん"],["より"],["倍","ばい"],["も"],["ひどい"],["地獄","じごく"],["の"],["子","こ"],["に"],["する"],["。"]]},{"verse":16,"text":"盲目,もうもくな案内,あんない者,しゃたちよ。あなたがたは、わざわいである。あなたがたは言,いう、『神殿,しんでんをさして誓,ちかうなら、そのままでよいが、神殿,しんでんの黄金,こがねをさして誓,ちかうなら、果,はたす責任,せきにんがある』と。","tok":[["盲目","もうもく"],["な"],["案内者","あんないしゃ"],["たち"],["よ"],["。"],["あなた"],["がた"],["は"],["、"],["わざわい"],["で"],["ある"],["。"],["あなた"],["がた"],["は"],["言う","いう"],["、"],["『"],["神殿","しんでん"],["を"],["さして"],["誓うなら","ちかうなら"],["、"],["そのまま"],["で"],["よい"],["が"],["、"],["神殿","しんでん"],["の"],["黄金","こがね"],["を"],["さして"],["誓うなら","ちかうなら"],["、"],["果たす","はたす"],["責任","せきにん"],["が"],["ある"],["』"],["と"],["。"]]},{"verse":17,"text":"愚,おろかな盲目,もうもくな人,ひとたちよ。黄金,こがねと、黄金,こがねを神聖,しんせいにする神殿,しんでんと、どちらが大事,だいじなのか。","tok":[["愚か","おろか"],["な"],["盲目","もうもく"],["な"],["人","ひと"],["たち"],["よ"],["。"],["黄金","こがね"],["と"],["、"],["黄金","こがね"],["を"],["神聖","しんせい"],["に"],["する"],["神殿","しんでん"],["と"],["、"],["どちら"],["が"],["大事","だいじ"],["な"],["の"],["か"],["。"]]},{"verse":18,"text":"また、あなたがたは言,いう、『祭壇,さいだんをさして誓,ちかうなら、そのままでよいが、その上,うえの供,そなえ物,ものをさして誓,ちかうなら、果,はたす責任,せきにんがある』と。","tok":[["また"],["、"],["あなた"],["がた"],["は"],["言う","いう"],["、"],["『"],["祭壇","さいだん"],["を"],["さして"],["誓うなら","ちかうなら"],["、"],["そのまま"],["で"],["よい"],["が"],["、"],["その"],["上","うえ"],["の"],["供え物","そなえもの"],["を"],["さして"],["誓うなら","ちかうなら"],["、"],["果たす","はたす"],["責任","せきにん"],["が"],["ある"],["』"],["と"],["。"]]},{"verse":19,"text":"盲目,もうもくな人,ひとたちよ。供,そなえ物,ものと供,そなえ物,ものを神聖,しんせいにする祭壇,さいだんとどちらが大事,だいじなのか。","tok":[["盲目","もうもく"],["な"],["人","ひと"],["たち"],["よ"],["。"],["供え物","そなえもの"],["と"],["供え物","そなえもの"],["を"],["神聖","しんせい"],["に"],["する"],["祭壇","さいだん"],["と"],["どちら"],["が"],["大事","だいじ"],["な"],["の"],["か"],["。"]]},{"verse":20,"text":"祭壇,さいだんをさして誓,ちかう者,ものは、祭壇,さいだんと、その上,うえにあるすべての物,ものとをさして誓,ちかうのである。","tok":[["祭壇","さいだん"],["を"],["さして"],["誓う","ちかう"],["者","もの"],["は"],["、"],["祭壇","さいだん"],["と"],["、"],["その"],["上","うえ"],["に"],["ある"],["すべて"],["の"],["物","もの"],["と"],["を"],["さして"],["誓う","ちかう"],["ので"],["ある"],["。"]]},{"verse":21,"text":"神殿,しんでんをさして誓,ちかう者,ものは、神殿,しんでんとその中,なかに住,すんでおられるかたとをさして誓,ちかうのである。","tok":[["神殿","しんでん"],["を"],["さして"],["誓う","ちかう"],["者","もの"],["は"],["、"],["神殿","しんでん"],["と"],["その"],["中","なか"],["に"],["住んで","すんで"],["おられる"],["かた"],["と"],["を"],["さして"],["誓う","ちかう"],["ので"],["ある"],["。"]]},{"verse":22,"text":"また、天,てんをさして誓,ちかう者,ものは、神,かみの御座,みざとその上,うえにすわっておられるかたとをさして誓,ちかうのである。","tok":[["また"],["、"],["天","てん"],["を"],["さして"],["誓う","ちかう"],["者","もの"],["は"],["、"],["神","かみ"],["の"],["御座","みざとそ"],["の"],["上","うえ"],["に"],["すわって"],["おられる"],["かた"],["と"],["を"],["さして"],["誓う","ちかう"],["ので"],["ある"],["。"]]},{"verse":23,"text":"偽善,ぎぜんな律法,りっぽう学者,がくしゃ、パリサイ人,びとたちよ。あなたがたは、わざわいである。はっか、いのんど、クミンなどの薬味,やくみの十分,ぶんの一を宮,みやに納,おさめておりながら、律法,りっぽうの中,なかでもっと重要,じゅうような、公平,こうへいとあわれみと忠実,ちゅうじつとを見,みのがしている。それもしなければならないが、これも見,みのがしてはならない。","tok":[["偽善","ぎぜん"],["な"],["律法学者","りっぽうがくしゃ"],["、"],["パリサイ"],["人","びと"],["たち"],["よ"],["。"],["あなた"],["がた"],["は"],["、"],["わざわい"],["で"],["ある"],["。"],["はっか"],["、"],["いのん"],["ど"],["、"],["クミン"],["など"],["の"],["薬味","やくみ"],["の"],["十分","ぶん"],["の"],["一","いち"],["を"],["宮","みや"],["に"],["納","おさめ"],["て"],["おり"],["ながら"],["、"],["律法","りっぽう"],["の"],["中","なか"],["で"],["もっと"],["重要","じゅうよう"],["な"],["、"],["公平","こうへい"],["と"],["あわれみ"],["と"],["忠実","ちゅうじつ"],["と"],["を"],["見のがして","みのがして"],["いる"],["。"],["それ"],["も"],["しなければ"],["ならない"],["が"],["、"],["これ"],["も"],["見のがして","みのがして"],["は"],["ならない"],["。"]]},{"verse":24,"text":"盲目,もうもくな案内,あんない者,しゃたちよ。あなたがたは、ぶよはこしているが、らくだはのみこんでいる。","tok":[["盲目","もうもく"],["な"],["案内者","あんないしゃ"],["たち"],["よ"],["。"],["あなた"],["がた"],["は"],["、"],["ぶよ"],["は"],["こして"],["いる"],["が"],["、"],["らくだ"],["は"],["のみこんで"],["いる"],["。"]]},{"verse":25,"text":"偽善,ぎぜんな律法,りっぽう学者,がくしゃ、パリサイ人,びとたちよ。あなたがたは、わざわいである。杯,さかずきと皿,さらとの外側,そとがわはきよめるが、内側,うちがわは貪欲,どんよくと放縦,ほうじゅうとで満,みちている。","tok":[["偽善","ぎぜん"],["な"],["律法学者","りっぽうがくしゃ"],["、"],["パリサイ"],["人","びと"],["たち"],["よ"],["。"],["あなた"],["がた"],["は"],["、"],["わざわい"],["で"],["ある"],["。"],["杯","さかずき"],["と"],["皿","さら"],["と"],["の"],["外側","そとがわ"],["は"],["きよめる"],["が"],["、"],["内側","うちがわ"],["は"],["貪欲","どんよく"],["と"],["放縦","ほ"],["う"],["じゅう"],["と"],["で"],["満ちて","みちて"],["いる"],["。"]]},{"verse":26,"text":"盲目,もうもくなパリサイ人,びとよ。まず、杯,さかずきの内側,うちがわをきよめるがよい。そうすれば、外側,そとがわも清,きよくなるであろう。","tok":[["盲目","もうもく"],["な"],["パリサイ"],["人","び"],["と"],["よ"],["。"],["まず"],["、"],["杯","さかずき"],["の"],["内側","うちがわ"],["を"],["きよめる"],["が"],["よい"],["。"],["そう"],["すれば"],["、"],["外側","そとがわ"],["も"],["清く","きよく"],["なるで"],["あろう"],["。"]]},{"verse":27,"text":"偽善,ぎぜんな律法,りっぽう学者,がくしゃ、パリサイ人,びとたちよ。あなたがたは、わざわいである。あなたがたは白,しろく塗,ぬった墓,はかに似,にている。外側,そとがわは美,うつくしく見,みえるが、内側,うちがわは死人,しにんの骨,ほねや、あらゆる不潔,ふけつなものでいっぱいである。","tok":[["偽善","ぎぜん"],["な"],["律法学者","りっぽうがくしゃ"],["、"],["パリサイ"],["人","びと"],["たち"],["よ"],["。"],["あなた"],["がた"],["は"],["、"],["わざわい"],["で"],["ある"],["。"],["あなた"],["がた"],["は"],["白く","しろく"],["塗った","ぬった"],["墓","はか"],["に"],["似て","にて"],["いる"],["。"],["外側","そとがわ"],["は"],["美しく","うつくしく"],["見える","みえる"],["が"],["、"],["内側","うちがわ"],["は"],["死人","しにん"],["の"],["骨","ほね"],["や"],["、"],["あらゆる"],["不潔","ふけつ"],["な"],["もの"],["で"],["いっぱい"],["で"],["ある"],["。"]]},{"verse":28,"text":"このようにあなたがたも、外側,そとがわは人,ひとに正,ただしく見,みえるが、内側,うちがわは偽善,ぎぜんと不法,ふほうとでいっぱいである。","tok":[["この"],["よう"],["に"],["あなた"],["がた"],["も"],["、"],["外側","そとがわ"],["は"],["人","ひと"],["に"],["正く","ただしく"],["見える","みえる"],["が"],["、"],["内側","うちがわ"],["は"],["偽善","ぎぜん"],["と"],["不法","ふほう"],["と"],["で"],["いっぱい"],["で"],["ある"],["。"]]},{"verse":29,"text":"偽善,ぎぜんな律法,りっぽう学者,がくしゃ、パリサイ人,びとたちよ。あなたがたは、わざわいである。あなたがたは預言者,よげんしゃの墓,はかを建,たて、義人,ぎじんの碑,ひを飾,かざり立,たてて、こう言,いっている、","tok":[["偽善","ぎぜん"],["な"],["律法学者","りっぽうがくしゃ"],["、"],["パリサイ"],["人","びと"],["たち"],["よ"],["。"],["あなた"],["がた"],["は"],["、"],["わざわい"],["で"],["ある"],["。"],["あなた"],["がた"],["は"],["預言者","よげんしゃ"],["の"],["墓","はか"],["を"],["建て","たて"],["、"],["義人","ぎじん"],["の"],["碑","ひ"],["を"],["飾","かざり"],["立てて","たてて"],["、"],["こう"],["言って","いって"],["いる"],["、"]]},{"verse":30,"text":"『もしわたしたちが先祖,せんぞの時代,じだいに生,いきていたなら、預言者,よげんしゃの血,ちを流,ながすことに加,くわわってはいなかっただろう』と。","tok":[["『"],["もし"],["わたしたち"],["が"],["先祖","せんぞ"],["の"],["時代","じだい"],["に"],["生きて","いきて"],["いたなら"],["、"],["預言者","よげんしゃ"],["の"],["血","ち"],["を"],["流す","ながす"],["こと"],["に"],["加わわって","くわわって"],["は"],["いなかっただろう"],["』"],["と"],["。"]]},{"verse":31,"text":"このようにして、あなたがたは預言者,よげんしゃを殺,ころした者,ものの子孫,しそんであることを、自分,じぶんで証明,しょうめいしている。","tok":[["この"],["よう"],["に"],["して"],["、"],["あなた"],["がた"],["は"],["預言者","よげんしゃ"],["を"],["殺ろした","ころした"],["者","もの"],["の"],["子孫","しそん"],["で"],["ある"],["こと"],["を"],["、"],["自分","じぶん"],["で"],["証明","しょうめい"],["して"],["いる"],["。"]]},{"verse":32,"text":"あなたがたもまた先祖,せんぞたちがした悪,あくの枡目,ますめを満,みたすがよい。","tok":[["あなた"],["がた"],["も"],["また"],["先祖","せんぞ"],["たち"],["が"],["した"],["悪","あく"],["の"],["枡目","ますめ"],["を"],["満たす","みたす"],["が"],["よい"],["。"]]},{"verse":33,"text":"へびよ、まむしの子,こらよ、どうして地獄,じごくの刑罰,けいばつをのがれることができようか。","tok":[["へび"],["よ"],["、"],["まむし"],["の"],["子","こ"],["ら"],["よ"],["、"],["どう"],["して"],["地獄","じごく"],["の"],["刑罰","けいばつ"],["を"],["のがれる"],["こと"],["が"],["できよう"],["か"],["。"]]},{"verse":34,"text":"それだから、わたしは、預言者,よげんしゃ、知者,ちしゃ、律法,りっぽう学者,がくしゃたちをあなたがたにつかわすが、そのうちのある者,ものを殺,ころし、また十字架,じゅうじかにつけ、そのある者,ものを会堂,かいどうでむち打,うち、また町,まちから町,まちへと迫害,はくがいして行,いくであろう。","tok":[["それ"],["だ"],["から"],["、"],["わたし"],["は"],["、"],["預言者","よげんしゃ"],["、"],["知者","ちしゃ"],["、"],["律法学者","りっぽうがくしゃ"],["たち"],["を"],["あなた"],["がた"],["に"],["つかわす"],["が"],["、"],["その"],["うち"],["の"],["ある"],["者","もの"],["を"],["殺ろし","ころし"],["、"],["また"],["十字架","じゅうじか"],["に"],["つけ"],["、"],["その"],["ある"],["者","もの"],["を"],["会堂","かいどう"],["で"],["むち打ち","むちうち"],["、"],["また"],["町","まち"],["から"],["町","まち"],["へ"],["と"],["迫害","はくがい"],["して"],["行くで","いくで"],["あろう"],["。"]]},{"verse":35,"text":"こうして義人,ぎじんアベルの血,ちから、聖所,せいじょと祭壇,さいだんとの間,あいだであなたがたが殺,ころしたバラキヤの子,こザカリヤの血,ちに至,いたるまで、地上,ちじょうに流,ながされた義人,ぎじんの血,ちの報,むくいが、ことごとくあなたがたに及,およぶであろう。","tok":[["こう"],["して"],["義人","ぎじん"],["アベル"],["の"],["血","ち"],["から"],["、"],["聖","せい"],["所","しょ"],["と"],["祭壇","さいだん"],["と"],["の"],["間","あいだ"],["で"],["あなた"],["がた"],["が"],["殺ろした","ころした"],["バラキヤ"],["の"],["子","こ"],["ザカリヤ"],["の"],["血","ち"],["に"],["至る","いたる"],["まで"],["、"],["地上","ちじょう"],["に"],["流された","ながされた"],["義人","ぎじん"],["の"],["血","ち"],["の"],["報い","むくい"],["が"],["、"],["ことごとく"],["あなた"],["がた"],["に"],["及ぶで","およぶで"],["あろう"],["。"]]},{"verse":36,"text":"よく言,いっておく。これらのことの報,むくいは、みな今,いまの時代,じだいに及,およぶであろう。","tok":[["よく"],["言って","いって"],["おく"],["。"],["これ"],["ら"],["の"],["こと"],["の"],["報い","むくい"],["は"],["、"],["みな"],["今","いま"],["の"],["時代","じだい"],["に"],["及ぶで","およぶで"],["あろう"],["。"]]},{"verse":37,"text":"ああ、エルサレム、エルサレム、預言者,よげんしゃたちを殺,ころし、おまえにつかわされた人,ひとたちを石,いしで打,うち殺,ころす者,ものよ。ちょうど、めんどりが翼,つばさの下,したにそのひなを集,あつめるように、わたしはおまえの子,こらを幾,いくたび集,あつめようとしたことであろう。それだのに、おまえたちは応,おうじようとしなかった。","tok":[["ああ"],["、"],["エルサレム"],["、"],["エルサレム"],["、"],["預言者","よげんしゃ"],["たち"],["を"],["殺ろし","ころし"],["、"],["おまえ"],["に"],["つかわされた"],["人","ひと"],["たち"],["を"],["石","いし"],["で"],["打ち","うち"],["殺ろす","ころす"],["者","もの"],["よ"],["。"],["ちょうど"],["、"],["めんどり"],["が"],["翼","つばさ"],["の"],["下","した"],["に"],["その"],["ひな"],["を"],["集める","あつめる"],["よう"],["に"],["、"],["わたし"],["は"],["おまえ"],["の"],["子","こ"],["ら"],["を"],["幾","いく"],["たび"],["集めよう","あつめよう"],["と"],["した"],["こと"],["で"],["あろう"],["。"],["それ"],["だ"],["のに"],["、"],["おまえ"],["たち"],["は"],["応じよう","おうじよう"],["と"],["しなかった"],["。"]]},{"verse":38,"text":"見,みよ、おまえたちの家,いえは見捨,みすてられてしまう。","tok":[["見よ","みよ"],["、"],["おまえ"],["たち"],["の"],["家","いえ"],["は"],["見捨てられて","みすてられて"],["しまう"],["。"]]},{"verse":39,"text":"わたしは言,いっておく、『主,しゅの御名,みなによってきたる者,ものに、祝福,しゅくふくあれ』とおまえたちが言,いう時,ときまでは、今後,こんごふたたび、わたしに会,あうことはないであろう」。","tok":[["わたし"],["は"],["言って","いって"],["おく"],["、"],["『"],["主","しゅ"],["の"],["御名","みな"],["によって"],["きたる"],["者","もの"],["に"],["、"],["祝福","しゅくふく"],["あれ"],["』"],["と"],["おまえ"],["たち"],["が"],["言う","いう"],["時","とき"],["まで"],["は"],["、"],["今後","こんご"],["ふたたび"],["、"],["わたし"],["に"],["会う","あう"],["こと"],["は"],["ないで"],["あろう"],["」"],["。"]]}]
[{"verse":1,"text":"イエスはこれらのことを語,かたり終,おえられてから、ガリラヤを去,さってヨルダンの向,むこうのユダヤの地方,ちほうへ行,いかれた。","tok":[["イエス"],["は"],["これ"],["ら"],["の"],["こと"],["を"],["語り","かたり"],["終えられて","おえられて"],["から"],["、"],["ガリラヤ"],["を"],["去て","さって"],["ヨルダン"],["の"],["向こう","むこう"],["の"],["ユダヤ"],["の"],["地方","ちほう"],["へ"],["行かれた","いかれた"],["。"]]},{"verse":2,"text":"すると大,おおぜいの群衆,ぐんしゅうがついてきたので、彼,かれらをそこでおいやしになった。","tok":[["する"],["と"],["大ぜい","おおぜい"],["の"],["群衆","ぐんしゅう"],["が"],["ついて"],["きた"],["ので"],["、"],["彼","かれ"],["ら"],["を"],["そこ"],["で"],["おいやし"],["に"],["なった"],["。"]]},{"verse":3,"text":"さてパリサイ人,びとたちが近,ちかづいてきて、イエスを試,こころみようとして言,いった、「何,なにかの理由,りゆうで、夫,おっとがその妻,つまを出,だすのは、さしつかえないでしょうか」。","tok":[["さて"],["パリサイ"],["人","びと"],["たち"],["が"],["近づいて","ちかづいて"],["きて"],["、"],["イエス"],["を"],["試みよう","こころみよう"],["として"],["言った","いった"],["、"],["「"],["何に","なに"],["か"],["の"],["理由","りゆう"],["で"],["、"],["夫","おっと"],["が"],["その"],["妻","つま"],["を"],["出す","だす"],["の"],["は"],["、"],["さしつかえないでしょう"],["か"],["」"],["。"]]},{"verse":4,"text":"イエスは答,こたえて言,いわれた、「あなたがたはまだ読,よんだことがないのか。『創造者,そうぞうしゃは初,はじめから人,ひとを男,おとこと女,おんなとに造,つくられ、","tok":[["イエス"],["は"],["答","こたえ"],["て"],["言われた","いわれた"],["、"],["「"],["あなた"],["がた"],["は"],["まだ"],["読","よんだこ"],["と"],["が"],["ない"],["の"],["か"],["。"],["『"],["創造者","そうぞうしゃ"],["は"],["初め","はじめ"],["から"],["人","ひと"],["を"],["男","おとこ"],["と"],["女","おんな"],["と"],["に"],["造られ","つくられ"],["、"]]},{"verse":5,"text":"そして言,いわれた、それゆえに、人,ひとは父母,ふぼを離,はなれ、その妻,つまと結,むすばれ、ふたりの者,ものは一体,いったいとなるべきである』。","tok":[["そして"],["言われた","いわれた"],["、"],["それ"],["ゆえ"],["に"],["、"],["人","ひと"],["は"],["父母","ふぼ"],["を"],["離れ","はなれ"],["、"],["その"],["妻","つま"],["と"],["結ばれ","むすばれ"],["、"],["ふたり"],["の"],["者","もの"],["は"],["一体","いったい"],["と"],["なるべきで"],["ある"],["』"],["。"]]},{"verse":6,"text":"彼,かれらはもはや、ふたりではなく一体,いったいである。だから、神,かみが合,あわせられたものを、人,ひとは離,はなしてはならない」。","tok":[["彼","かれ"],["ら"],["は"],["もはや"],["、"],["ふたり"],["で"],["は"],["なく"],["一","いち"],["体","たい"],["で"],["ある"],["。"],["だ"],["から"],["、"],["神","かみ"],["が"],["合","あわせ"],["られた"],["もの"],["を"],["、"],["人","ひと"],["は"],["離して","はなして"],["は"],["ならない"],["」"],["。"]]},{"verse":7,"text":"彼,かれらはイエスに言,いった、「それでは、なぜモーセは、妻,つまを出,だす場合,ばあいには離縁,りえん状,じょうを渡,わたせ、と定,さだめたのですか」。","tok":[["彼","かれ"],["ら"],["は"],["イエス"],["に"],["言った","いった"],["、"],["「"],["それ"],["で"],["は"],["、"],["なぜ"],["モーセ"],["は"],["、"],["妻","つま"],["を"],["出す","だす"],["場合","ばあい"],["に"],["は"],["離縁状","りえんじょう"],["を"],["渡せ","わたせ"],["、"],["と"],["定めた","さだめた"],["の"],["です"],["か"],["」"],["。"]]},{"verse":8,"text":"イエスが言,いわれた、「モーセはあなたがたの心,こころが、かたくななので、妻,つまを出,だすことを許,ゆるしたのだが、初,はじめからそうではなかった。","tok":[["イエス"],["が"],["言われた","いわれた"],["、"],["「"],["モーセ"],["は"],["あなた"],["がた"],["の"],["心","こころ"],["が"],["、"],["かたくな"],["な"],["ので"],["、"],["妻","つま"],["を"],["出す","だす"],["こと"],["を"],["許した","ゆるした"],["の"],["だ"],["が"],["、"],["初め","はじめ"],["から"],["そう"],["で"],["は"],["なかった"],["。"]]},{"verse":9,"text":"そこでわたしはあなたがたに言,いう。不品行,ふひんこうのゆえでなくて、自分,じぶんの妻,つまを出,だして他,たの女,おんなをめとる者,ものは、姦淫,かんいんを行,おこなうのである」。","tok":[["そこ"],["で"],["わたし"],["は"],["あなた"],["がた"],["に"],["言う","いう"],["。"],["不品行","ふひんこう"],["の"],["ゆえ"],["で"],["なくて"],["、"],["自分","じぶん"],["の"],["妻","つま"],["を"],["出して","だして"],["他","た"],["の"],["女","おんな"],["を"],["めとる"],["者","もの"],["は"],["、"],["姦淫","かんいん"],["を"],["行なう","おこなう"],["ので"],["ある"],["」"],["。"]]},{"verse":10,"text":"弟子,でしたちは言,いった、「もし妻,つまに対,たいする夫,おっとの立場,たちばがそうだとすれば、結婚,けっこんしない方,ほうがましです」。","tok":[["弟子","でし"],["たち"],["は"],["言った","いった"],["、"],["「"],["もし"],["妻","つま"],["に"],["対する","たいする"],["夫","おっと"],["の"],["立場","たちば"],["が"],["そう"],["だ"],["と"],["すれば"],["、"],["結婚","けっこん"],["しない"],["方","ほう"],["が"],["まし"],["です"],["」"],["。"]]},{"verse":11,"text":"するとイエスは彼,かれらに言,いわれた、「その言葉,ことばを受,うけいれることができるのはすべての人,ひとではなく、ただそれを授,さづけられている人々,ひとびとだけである。","tok":[["する"],["と"],["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["その"],["言葉","ことば"],["を"],["受","うけ"],["いれる"],["こと"],["が"],["できる"],["の"],["は"],["すべて"],["の"],["人","ひと"],["で"],["は"],["なく"],["、"],["ただ"],["それ"],["を"],["授","さ"],["づけられて"],["いる"],["人々","ひとびと"],["だけ"],["で"],["ある"],["。"]]},{"verse":12,"text":"というのは、母,ははの胎内,たいないから独身者,どくしんしゃに生,うまれついているものがあり、また他,ほかから独身者,どくしんしゃにされたものもあり、また天国,てんごくのために、みずから進,すすんで独身者,どくしんしゃとなったものもある。この言葉,ことばを受,うけられる者,ものは、受,うけいれるがよい」。","tok":[["と"],["いう"],["の"],["は"],["、"],["母","はは"],["の"],["胎内","たいない"],["から"],["独身者","どくしんしゃ"],["に"],["生まれついて","うまれついて"],["いる"],["もの"],["が"],["あり"],["、"],["また"],["他","ほか"],["から"],["独身者","どくしんしゃ"],["に"],["された"],["もの"],["も"],["あり"],["、"],["また"],["天国","てんごく"],["の"],["ため"],["に"],["、"],["みずから"],["進んで","すすんで"],["独身者","どくしんしゃ"],["と"],["なった"],["もの"],["も"],["ある"],["。"],["この"],["言葉","ことば"],["を"],["受られる","うけられる"],["者","もの"],["は"],["、"],["受","うけ"],["いれる"],["が"],["よい"],["」"],["。"]]},{"verse":13,"text":"そのとき、イエスに手,てをおいて祈,いのっていただくために、人々,ひとびとが幼,おさな子,ごらをみもとに連,つれてきた。ところが、弟子,でしたちは彼,かれらをたしなめた。","tok":[["その"],["とき"],["、"],["イエス"],["に"],["手","て"],["を"],["おいて"],["祈って","いのって"],["いただく"],["ため"],["に"],["、"],["人々","ひとびと"],["が"],["幼な子","おさなご"],["ら"],["を"],["みもと"],["に"],["連れて","つれて"],["きた"],["。"],["ところ"],["が"],["、"],["弟子","でし"],["たち"],["は"],["彼","かれ"],["ら"],["を"],["たしなめた"],["。"]]},{"verse":14,"text":"するとイエスは言,いわれた、「幼,おさな子,ごらをそのままにしておきなさい。わたしのところに来,くるのをとめてはならない。天国,てんごくはこのような者,ものの国,くにである」。","tok":[["する"],["と"],["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["幼な子","おさなご"],["ら"],["を"],["そのまま"],["に"],["して"],["おき"],["なさい"],["。"],["わたし"],["の"],["ところ"],["に"],["来る","くる"],["の"],["を"],["とめて"],["は"],["ならない"],["。"],["天国","てんごく"],["は"],["この"],["よう"],["な"],["者","もの"],["の"],["国","くに"],["で"],["ある"],["」"],["。"]]},{"verse":15,"text":"そして手,てを彼,かれらの上,うえにおいてから、そこを去,さって行,いかれた。","tok":[["そして"],["手","て"],["を"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["おいて"],["から"],["、"],["そこ"],["を"],["去て","さって"],["行かれた","いかれた"],["。"]]},{"verse":16,"text":"すると、ひとりの人,ひとがイエスに近寄,ちかよってきて言,いった、「先生,せんせい、永遠,えいえんの生命,せいめいを得,えるためには、どんなよいことをしたらいいでしょうか」。","tok":[["する"],["と"],["、"],["ひとり"],["の"],["人","ひと"],["が"],["イエス"],["に"],["近寄って","ちかよって"],["きて"],["言った","いった"],["、"],["「"],["先生","せんせい"],["、"],["永遠","えいえん"],["の"],["生命","せいめい"],["を"],["得る","える"],["ため"],["に"],["は"],["、"],["どんな"],["よい"],["こと"],["を"],["したら"],["いいでしょう"],["か"],["」"],["。"]]},{"verse":17,"text":"イエスは言,いわれた、「なぜよい事,ことについてわたしに尋,たずねるのか。よいかたはただひとりだけである。もし命,いのちに入,はいりたいと思,おもうなら、いましめを守,まもりなさい」。","tok":[["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["なぜ"],["よい"],["事","こと"],["について"],["わたし"],["に"],["尋ねる","たずねる"],["の"],["か"],["。"],["よい"],["かた"],["は"],["ただ"],["ひとり"],["だけ"],["で"],["ある"],["。"],["もし"],["命","いのち"],["に"],["入りたい","はいりたい"],["と"],["思うなら","おもうなら"],["、"],["いましめ"],["を"],["守り","まもり"],["なさい"],["」"],["。"]]},{"verse":18,"text":"彼,かれは言,いった、「どのいましめですか」。イエスは言,いわれた、「『殺,ころすな、姦淫,かんいんするな、盗,ぬすむな、偽証,ぎしょうを立,たてるな。","tok":[["彼","かれ"],["は"],["言った","いった"],["、"],["「"],["どの"],["いましめ"],["です"],["か"],["」"],["。"],["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["『"],["殺ろす","ころす"],["な"],["、"],["姦淫","かんいん"],["する"],["な"],["、"],["盗む","ぬすむ"],["な"],["、"],["偽証","ぎしょう"],["を"],["立る","たてる"],["な"],["。"]]},{"verse":19,"text":"父,ちちと母,ははとを敬,うやまえ』。また『自分,じぶんを愛,あいするように、あなたの隣,となり人,ひとを愛,あいせよ』」。","tok":[["父","ちち"],["と"],["母","はは"],["と"],["を"],["敬え","うやまえ"],["』"],["。"],["また"],["『"],["自分","じぶん"],["を"],["愛する","あいする"],["よう"],["に"],["、"],["あなた"],["の"],["隣人","となりひと"],["を"],["愛せよ","あいせよ"],["』"],["」"],["。"]]},{"verse":20,"text":"この青年,せいねんはイエスに言,いった、「それはみな守,まもってきました。ほかに何,なにが足,たりないのでしょう」。","tok":[["この"],["青年","せいねん"],["は"],["イエス"],["に"],["言った","いった"],["、"],["「"],["それ"],["は"],["みな"],["守って","まもって"],["きました"],["。"],["ほか"],["に"],["何に","なに"],["が"],["足りない","たりない"],["の"],["でしょう"],["」"],["。"]]},{"verse":21,"text":"イエスは彼,かれに言,いわれた、「もしあなたが完全,かんぜんになりたいと思,おもうなら、帰,かえってあなたの持,もち物,ものを売,うり払,はらい、貧,まずしい人々,ひとびとに施,ほどこしなさい。そうすれば、天,てんに宝,たからを持,もつようになろう。そして、わたしに従,したがってきなさい」。","tok":[["イエス"],["は"],["彼","かれ"],["に"],["言われた","いわれた"],["、"],["「"],["もし"],["あなた"],["が"],["完全","かんぜん"],["に"],["なりたい"],["と"],["思うなら","おもうなら"],["、"],["帰えって","かえって"],["あなた"],["の"],["持物","もちもの"],["を"],["売払","うりはらい"],["、"],["貧しい","まずしい"],["人々","ひとびと"],["に"],["施し","ほどこし"],["なさい"],["。"],["そう"],["すれば"],["、"],["天","てん"],["に"],["宝","たから"],["を"],["持つ","もつ"],["よう"],["に"],["なろう"],["。"],["そして"],["、"],["わたし"],["に"],["従って","したがって"],["き"],["なさい"],["」"],["。"]]},{"verse":22,"text":"この言葉,ことばを聞,きいて、青年,せいねんは悲,かなしみながら立,たち去,さった。たくさんの資産,しさんを持,もっていたからである。","tok":[["この"],["言葉","ことば"],["を"],["聞いて","きいて"],["、"],["青年","せいねん"],["は"],["悲しみ","かなしみ"],["ながら"],["立ち","たち"],["去た","さった"],["。"],["たくさん"],["の"],["資産","しさん"],["を"],["持って","もって"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":23,"text":"それからイエスは弟子,でしたちに言,いわれた、「よく聞,ききなさい。富,とんでいる者,ものが天国,てんごくにはいるのは、むずかしいものである。","tok":[["それ"],["から"],["イエス"],["は"],["弟子","でし"],["たち"],["に"],["言われた","いわれた"],["、"],["「"],["よく"],["聞","きき"],["なさい"],["。"],["富","とん"],["で"],["いる"],["者","もの"],["が"],["天国","てんごく"],["に"],["は"],["いる"],["の"],["は"],["、"],["むずかしい"],["もの"],["で"],["ある"],["。"]]},{"verse":24,"text":"また、あなたがたに言,いうが、富,とんでいる者,ものが神,かみの国,くににはいるよりは、らくだが針,はりの穴,あなを通,とおる方,ほうが、もっとやさしい」。","tok":[["また"],["、"],["あなた"],["がた"],["に"],["言う","いう"],["が"],["、"],["富","とん"],["で"],["いる"],["者","もの"],["が"],["神","かみ"],["の"],["国","くに"],["に"],["は"],["いる"],["より"],["は"],["、"],["らくだ"],["が"],["針","はり"],["の"],["穴","あな"],["を"],["通る","とおる"],["方","ほう"],["が"],["、"],["もっと"],["やさしい"],["」"],["。"]]},{"verse":25,"text":"弟子,でしたちはこれを聞,きいて非常,ひじょうに驚,おどろいて言,いった、「では、だれが救,すくわれることができるのだろう」。","tok":[["弟子","でし"],["たち"],["は"],["これ"],["を"],["聞いて","きいて"],["非常","ひじょう"],["に"],["驚ろいて","おどろいて"],["言った","いった"],["、"],["「"],["で"],["は"],["、"],["だれ"],["が"],["救われる","すくわれる"],["こと"],["が"],["できる"],["の"],["だろう"],["」"],["。"]]},{"verse":26,"text":"イエスは彼,かれらを見,みつめて言,いわれた、「人,ひとにはそれはできないが、神,かみにはなんでもできない事,ことはない」。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["を"],["見つめて","みつめて"],["言われた","いわれた"],["、"],["「"],["人","ひと"],["に"],["は"],["それ"],["は"],["できない"],["が"],["、"],["神","かみ"],["に"],["は"],["なん"],["で"],["も"],["できない"],["事","こと"],["は"],["ない"],["」"],["。"]]},{"verse":27,"text":"そのとき、ペテロがイエスに答,こたえて言,いった、「ごらんなさい、わたしたちはいっさいを捨,すてて、あなたに従,したがいました。ついては、何,なにがいただけるでしょうか」。","tok":[["その"],["とき"],["、"],["ペテロ"],["が"],["イエス"],["に"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["ごらん"],["なさい"],["、"],["わたしたち"],["は"],["いっさい"],["を"],["捨てて","すてて"],["、"],["あなた"],["に"],["従いました","したがいました"],["。"],["ついて"],["は"],["、"],["何に","なに"],["が"],["いただけるでしょう"],["か"],["」"],["。"]]},{"verse":28,"text":"イエスは彼,かれらに言,いわれた、「よく聞,きいておくがよい。世,よが改,あらたまって、人,ひとの子,こがその栄光,えいこうの座,ざにつく時,ときには、わたしに従,したがってきたあなたがたもまた、十二の位,くらいに座,ざしてイスラエルの十二の部族,ぶぞくをさばくであろう。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["よく"],["聞いて","きいて"],["おく"],["が"],["よい"],["。"],["世","よ"],["が"],["改まって","あらたまって"],["、"],["人","ひと"],["の"],["子","こ"],["が"],["その"],["栄光","えいこう"],["の"],["座","ざ"],["に"],["つく"],["時","とき"],["に"],["は"],["、"],["わたし"],["に"],["従って","したがって"],["きた"],["あなた"],["がた"],["も"],["また"],["、"],["十二","じゅうに"],["の"],["位","くらい"],["に"],["座して","ざして"],["イスラエル"],["の"],["十二","じゅうに"],["の"],["部族","ぶぞく"],["を"],["さばくで"],["あろう"],["。"]]},{"verse":29,"text":"おおよそ、わたしの名,なのために、家,いえ、兄弟,きょうだい、姉妹,しまい、父,ちち、母,はは、子,こ、もしくは畑,はたけを捨,すてた者,ものは、その幾,いく倍,ばいもを受,うけ、また永遠,えいえんの生命,せいめいを受,うけつぐであろう。","tok":[["おおよそ"],["、"],["わたし"],["の"],["名","な"],["の"],["ため"],["に"],["、"],["家","いえ"],["、"],["兄弟","きょうだい"],["、"],["姉妹","しまい"],["、"],["父","ちち"],["、"],["母","はは"],["、"],["子","こ"],["、"],["もしくは"],["畑","はたけ"],["を"],["捨てた","すてた"],["者","もの"],["は"],["、"],["その"],["幾","いく"],["倍","ばい"],["も"],["を"],["受け","うけ"],["、"],["また"],["永遠","えいえん"],["の"],["生命","せいめい"],["を"],["受","うけ"],["つぐで"],["あろう"],["。"]]},{"verse":30,"text":"しかし、多,おおくの先,さきの者,ものはあとになり、あとの者,ものは先,さきになるであろう。","tok":[["しかし"],["、"],["多く","おおく"],["の"],["先","さき"],["の"],["者","もの"],["は"],["あと"],["に"],["なり"],["、"],["あと"],["の"],["者","もの"],["は"],["先","さき"],["に"],["なるで"],["あろう"],["。"]]}]
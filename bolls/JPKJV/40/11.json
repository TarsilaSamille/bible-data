[{"verse":1,"text":"イエスは十二弟子,でしにこのように命,めいじ終,おえてから、町々,まちまちで教,おしえまた宣,のべ伝,つたえるために、そこを立,たち去,さられた。","tok":[["イエス"],["は"],["十二","じゅうに"],["弟子","でし"],["に"],["この"],["よう"],["に"],["命じ","めいじ"],["終えて","おえて"],["から"],["、"],["町々","まちまち"],["で"],["教え","おしえ"],["また"],["宣べ伝える","のべつたえる"],["ため"],["に"],["、"],["そこ"],["を"],["立ち去られた","たちさられた"],["。"]]},{"verse":2,"text":"さて、ヨハネは獄中,ごくちゅうでキリストのみわざについて伝,つたえ聞,きき、自分,じぶんの弟子,でしたちをつかわして、","tok":[["さて"],["、"],["ヨハネ"],["は"],["獄中","ごくちゅう"],["で"],["キリスト"],["の"],["みわざ"],["について"],["伝え","つたえ"],["聞","きき"],["、"],["自分","じぶん"],["の"],["弟子","でし"],["たち"],["を"],["つかわして"],["、"]]},{"verse":3,"text":"イエスに言,いわせた、「『きたるべきかた』はあなたなのですか。それとも、ほかにだれかを待,まつべきでしょうか」。","tok":[["イエス"],["に"],["言わせた","いわせた"],["、"],["「"],["『"],["きたるべき"],["かた"],["』"],["は"],["あなた"],["な"],["の"],["です"],["か"],["。"],["それ"],["と"],["も"],["、"],["ほか"],["に"],["だれ"],["か"],["を"],["待つべきでしょう","まつべきでしょう"],["か"],["」"],["。"]]},{"verse":4,"text":"イエスは答,こたえて言,いわれた、「行,いって、あなたがたが見聞,みききしていることをヨハネに報告,ほうこくしなさい。","tok":[["イエス"],["は"],["答","こたえ"],["て"],["言われた","いわれた"],["、"],["「"],["行って","いって"],["、"],["あなた"],["がた"],["が"],["見聞き","みきき"],["して"],["いる"],["こと"],["を"],["ヨハネ"],["に"],["報告","ほうこく"],["し"],["なさい"],["。"]]},{"verse":5,"text":"盲人,もうじんは見,みえ、足,あしなえは歩,あるき、らい病人,びょうにんはきよまり、耳,みみしいは聞,きこえ、死人,しにんは生,いきかえり、貧,まずしい人々,ひとびとは福音,ふくいんを聞,きかされている。","tok":[["盲人","もうじん"],["は"],["見え","みえ"],["、"],["足","あし"],["なえ"],["は"],["歩き","あるき"],["、"],["らい病人","らいびょうにん"],["は"],["きよまり"],["、"],["耳","みみ"],["しい"],["は"],["聞こえ","きこえ"],["、"],["死人","しにん"],["は"],["生きかえり","いきかえり"],["、"],["貧しい","まずしい"],["人々","ひとびと"],["は"],["福音","ふくいん"],["を"],["聞かされて","きかされて"],["いる"],["。"]]},{"verse":6,"text":"わたしにつまずかない者,ものは、さいわいである」。","tok":[["わたし"],["に"],["つまずかない"],["者","もの"],["は"],["、"],["さいわい"],["で"],["ある"],["」"],["。"]]},{"verse":7,"text":"彼,かれらが帰,かえってしまうと、イエスはヨハネのことを群衆,ぐんしゅうに語,かたりはじめられた、「あなたがたは、何,なにを見,みに荒野,あらのに出,でてきたのか。風,かぜに揺,ゆらぐ葦,あしであるか。","tok":[["彼","かれ"],["ら"],["が"],["帰えって","かえって"],["しまう"],["と"],["、"],["イエス"],["は"],["ヨハネ"],["の"],["こと"],["を"],["群衆","ぐんしゅう"],["に"],["語り","かたり"],["はじめられた"],["、"],["「"],["あなた"],["がた"],["は"],["、"],["何に","なに"],["を"],["見","み"],["に"],["荒野","あらの"],["に"],["出て","でて"],["きた"],["の"],["か"],["。"],["風","かぜ"],["に"],["揺らぐ","ゆらぐ"],["葦","あし"],["で"],["ある"],["か"],["。"]]},{"verse":8,"text":"では、何,なにを見,みに出,でてきたのか。柔,やわらかい着物,きものをまとった人,ひとか。柔,やわらかい着物,きものをまとった人々,ひとびとなら、王,おうの家,いえにいる。","tok":[["で"],["は"],["、"],["何に","なに"],["を"],["見","み"],["に"],["出て","でて"],["きた"],["の"],["か"],["。"],["柔らかい","やわらかい"],["着物","きもの"],["を"],["まとった"],["人","ひと"],["か"],["。"],["柔らかい","やわらかい"],["着物","きもの"],["を"],["まとった"],["人々","ひとびと"],["なら"],["、"],["王","おう"],["の"],["家","いえ"],["に"],["いる"],["。"]]},{"verse":9,"text":"では、なんのために出,でてきたのか。預言者,よげんしゃを見,みるためか。そうだ、あなたがたに言,いうが、預言者,よげんしゃ以上,いじょうの者,ものである。","tok":[["で"],["は"],["、"],["なん"],["の"],["ため"],["に"],["出て","でて"],["きた"],["の"],["か"],["。"],["預言者","よげんしゃ"],["を"],["見る","みる"],["ため"],["か"],["。"],["そう"],["だ"],["、"],["あなた"],["がた"],["に"],["言う","いう"],["が"],["、"],["預言者","よげんしゃ"],["以上","いじょう"],["の"],["者","もの"],["で"],["ある"],["。"]]},{"verse":10,"text":"『見,みよ、わたしは使,つかいをあなたの先,さきにつかわし、あなたの前,まえに、道,みちを整,ととのえさせるであろう』と書,かいてあるのは、この人,ひとのことである。","tok":[["『"],["見よ","みよ"],["、"],["わたし"],["は"],["使","つかい"],["を"],["あなた"],["の"],["先","さき"],["に"],["つかわし"],["、"],["あなた"],["の"],["前","まえ"],["に"],["、"],["道","みち"],["を"],["整えさせるで","ととのえさせるで"],["あろう"],["』"],["と"],["書いて","かいて"],["ある"],["の"],["は"],["、"],["この"],["人","ひと"],["の"],["こと"],["で"],["ある"],["。"]]},{"verse":11,"text":"あなたがたによく言,いっておく。女,おんなの産,うんだ者,ものの中,なかで、バプテスマのヨハネより大,おおきい人物,じんぶつは起,おこらなかった。しかし、天国,てんごくで最,もっとも小,ちいさい者,ものも、彼,かれよりは大,おおきい。","tok":[["あなた"],["がた"],["に"],["よく"],["言って","いって"],["おく"],["。"],["女","おんな"],["の"],["産んだ","うんだ"],["者","もの"],["の"],["中","なか"],["で"],["、"],["バプテスマ"],["の"],["ヨハネ"],["より"],["大きい","おおきい"],["人物","じんぶつ"],["は"],["起こらなかった","おこらなかった"],["。"],["しかし"],["、"],["天国","てんごく"],["で"],["最も","もっとも"],["小さい","ちいさい"],["者","もの"],["も"],["、"],["彼","かれ"],["より"],["は"],["大きい","おおきい"],["。"]]},{"verse":12,"text":"バプテスマのヨハネの時,ときから今,いまに至,いたるまで、天国,てんごくは激,はげしく襲,おそわれている。そして激,はげしく襲,おそう者,ものたちがそれを奪,うばい取,とっている。","tok":[["バプテスマ"],["の"],["ヨハネ"],["の"],["時","とき"],["から"],["今","いま"],["に"],["至る","いたる"],["まで"],["、"],["天国","てんごく"],["は"],["激しく","はげしく"],["襲われて","おそわれて"],["いる"],["。"],["そして"],["激しく","はげしく"],["襲う","おそう"],["者","もの"],["たち"],["が"],["それ"],["を"],["奪い取って","うばいとって"],["いる"],["。"]]},{"verse":13,"text":"すべての預言者,よげんしゃと律法,りっぽうとが預言,よげんしたのは、ヨハネの時,ときまでである。","tok":[["すべて"],["の"],["預言者","よげんしゃ"],["と"],["律法","りっぽう"],["と"],["が"],["預言","よげん"],["した"],["の"],["は"],["、"],["ヨハネ"],["の"],["時","とき"],["まで"],["で"],["ある"],["。"]]},{"verse":14,"text":"そして、もしあなたがたが受,うけいれることを望,のぞめば、この人,ひとこそは、きたるべきエリヤなのである。","tok":[["そして"],["、"],["もし"],["あなた"],["がた"],["が"],["受","うけ"],["いれる"],["こと"],["を"],["望めば","のぞめば"],["、"],["この"],["人","ひと"],["こそ"],["は"],["、"],["きたるべき"],["エリヤ"],["な"],["ので"],["ある"],["。"]]},{"verse":15,"text":"耳,みみのある者,ものは聞,きくがよい。","tok":[["耳","みみ"],["の"],["ある"],["者","もの"],["は"],["聞く","きく"],["が"],["よい"],["。"]]},{"verse":16,"text":"今,いまの時代,じだいを何,なにに比,くらべようか。それは子供,こどもたちが広場,ひろばにすわって、ほかの子供,こどもたちに呼,よびかけ、","tok":[["今","いま"],["の"],["時代","じだい"],["を"],["何に","なに"],["に"],["比べよう","くらべよう"],["か"],["。"],["それ"],["は"],["子供","こども"],["たち"],["が"],["広場","ひろば"],["に"],["すわって"],["、"],["ほか"],["の"],["子供","こども"],["たち"],["に"],["呼びかけ","よびかけ"],["、"]]},{"verse":17,"text":"『わたしたちが笛,ふえを吹,ふいたのに、あなたたちは踊,おどってくれなかった。弔,とむらいの歌,うたを歌,うたったのに、胸,むねを打,うってくれなかった』と言,いうのに似,にている。","tok":[["『"],["わたしたち"],["が"],["笛","ふえ"],["を"],["吹いた","ふいた"],["のに"],["、"],["あなた"],["たち"],["は"],["踊って","おどって"],["くれなかった"],["。"],["弔","とむらい"],["の"],["歌","うた"],["を"],["歌った","うたった"],["のに"],["、"],["胸","むね"],["を"],["打って","うって"],["くれなかった"],["』"],["と"],["言う","いう"],["のに"],["似て","にて"],["いる"],["。"]]},{"verse":18,"text":"なぜなら、ヨハネがきて、食,たべることも、飲,のむこともしないと、あれは悪霊,あくれいにつかれているのだ、と言,いい、","tok":[["なぜ"],["なら"],["、"],["ヨハネ"],["が"],["きて"],["、"],["食べる","たべる"],["こと"],["も"],["、"],["飲む","のむ"],["こと"],["も"],["しない"],["と"],["、"],["あれ"],["は"],["悪霊","あくれい"],["に"],["つかれて"],["いる"],["の"],["だ"],["、"],["と"],["言い","いい"],["、"]]},{"verse":19,"text":"また人,ひとの子,こがきて、食,たべたり飲,のんだりしていると、見,みよ、あれは食,しょくをむさぼる者,もの、大酒,おおざけを飲,のむ者,もの、また取税人,しゅぜいにん、罪人,つみびとの仲間,なかまだ、と言,いう。しかし、知恵,ちえの正,ただしいことは、その働,はたらきが証明,しょうめいする」。","tok":[["また"],["人","ひと"],["の"],["子","こ"],["が"],["きて"],["、"],["食べ","たべ"],["たり"],["飲ん","のん"],["だり"],["して"],["いる"],["と"],["、"],["見よ","みよ"],["、"],["あれ"],["は"],["食","しょく"],["を"],["むさぼる"],["者","もの"],["、"],["大酒","おおざけ"],["を"],["飲む","のむ"],["者","もの"],["、"],["また"],["取","とり"],["税人","ぜいにん"],["ぜ"],["い"],["にん"],["、"],["罪人","つみびと"],["の"],["仲間","なかま"],["だ"],["、"],["と"],["言う","いう"],["。"],["しかし"],["、"],["知恵","ちえ"],["の"],["正い","ただしい"],["こと"],["は"],["、"],["その"],["働らき","はたらき"],["が"],["証明","しょうめい"],["する"],["」"],["。"]]},{"verse":20,"text":"それからイエスは、数々,かずかずの力,ちからあるわざがなされたのに、悔,くい改,あらためることをしなかった町々,まちまちを、責,せめはじめられた。","tok":[["それ"],["から"],["イエス"],["は"],["、"],["数々","かずかず"],["の"],["力","ちから"],["ある"],["わざ"],["が"],["なされた"],["のに"],["、"],["悔い改める","くいあらためる"],["こと"],["を"],["しなかった"],["町々","まちまち"],["を"],["、"],["責","せめ"],["はじめられた"],["。"]]},{"verse":21,"text":"「わざわいだ、コラジンよ。わざわいだ、ベツサイダよ。おまえたちのうちでなされた力,ちからあるわざが、もしツロとシドンでなされたなら、彼,かれらはとうの昔,むかしに、荒布,あらぬのをまとい灰,はいをかぶって、悔,くい改,あらためたであろう。","tok":[["「"],["わざわい"],["だ"],["、"],["コラジン"],["よ"],["。"],["わざわい"],["だ"],["、"],["ベツサイダ"],["よ"],["。"],["おまえ"],["たち"],["の"],["うち"],["で"],["なされた"],["力","ちから"],["ある"],["わざ"],["が"],["、"],["もし"],["ツロ"],["と"],["シドン"],["で"],["なされたなら"],["、"],["彼","かれ"],["ら"],["は"],["とう"],["の"],["昔","むかし"],["に"],["、"],["荒布","あらぬ"],["の"],["を"],["まとい"],["灰","はい"],["を"],["かぶって"],["、"],["悔い","くい"],["改","あらため"],["たで"],["あろう"],["。"]]},{"verse":22,"text":"しかし、おまえたちに言,いっておく。さばきの日,ひには、ツロとシドンの方,ほうがおまえたちよりも、耐,たえやすいであろう。","tok":[["しかし"],["、"],["おまえ"],["たち"],["に"],["言って","いって"],["おく"],["。"],["さばき"],["の"],["日","ひ"],["に"],["は"],["、"],["ツロ"],["と"],["シドン"],["の"],["方","ほう"],["が"],["おまえ"],["たち"],["より"],["も"],["、"],["耐え","たえ"],["やすい"],["で"],["あろう"],["。"]]},{"verse":23,"text":"ああ、カペナウムよ、おまえは天,てんにまで上,あげられようとでもいうのか。黄泉,よみにまで落,おとされるであろう。おまえの中,なかでなされた力,ちからあるわざが、もしソドムでなされたなら、その町,まちは今日,きょうまでも残,のこっていたであろう。","tok":[["ああ"],["、"],["カペナウム"],["よ"],["、"],["おまえ"],["は"],["天","てん"],["に"],["まで"],["上げられよう","あげられよう"],["と"],["で"],["も"],["いう"],["の"],["か"],["。"],["黄泉","よみ"],["に"],["まで"],["落とされるで","おとされるで"],["あろう"],["。"],["おまえ"],["の"],["中","なか"],["で"],["なされた"],["力","ちから"],["ある"],["わざ"],["が"],["、"],["もし"],["ソドム"],["で"],["なされたなら"],["、"],["その"],["町","まち"],["は"],["今日","きょう"],["まで"],["も"],["残って","のこって"],["いたで"],["あろう"],["。"]]},{"verse":24,"text":"しかし、あなたがたに言,いう。さばきの日,ひには、ソドムの地,ちの方,ほうがおまえよりは耐,たえやすいであろう」。","tok":[["しかし"],["、"],["あなた"],["がた"],["に"],["言う","いう"],["。"],["さばき"],["の"],["日","ひ"],["に"],["は"],["、"],["ソドム"],["の"],["地","ち"],["の"],["方","ほう"],["が"],["おまえ"],["より"],["は"],["耐え","たえ"],["やすい"],["で"],["あろう"],["」"],["。"]]},{"verse":25,"text":"そのときイエスは声,こえをあげて言,いわれた、「天地,てんちの主,しゅなる父,ちちよ。あなたをほめたたえます。これらの事,ことを知恵,ちえのある者,ものや賢,かしこい者,ものに隠,かくして、幼,おさな子,ごにあらわしてくださいました。","tok":[["その"],["とき"],["イエス"],["は"],["声","こえ"],["を"],["あげて"],["言われた","いわれた"],["、"],["「"],["天地","てんち"],["の"],["主","しゅ"],["なる"],["父","ちち"],["よ"],["。"],["あなた"],["を"],["ほめたたえます"],["。"],["これ"],["ら"],["の"],["事","こと"],["を"],["知恵","ちえ"],["の"],["ある"],["者","もの"],["や"],["賢しこい","かしこい"],["者","もの"],["に"],["隠して","かくして"],["、"],["幼な子","おさなご"],["に"],["あらわして"],["くださいました"],["。"]]},{"verse":26,"text":"父,ちちよ、これはまことにみこころにかなった事,ことでした。","tok":[["父","ちち"],["よ"],["、"],["これ"],["は"],["まこと"],["に"],["みこころ"],["に"],["かなった"],["事","こと"],["でした"],["。"]]},{"verse":27,"text":"すべての事,ことは父,ちちからわたしに任,まかせられています。そして、子,こを知,しる者,ものは父,ちちのほかにはなく、父,ちちを知,しる者,ものは、子,こと、父,ちちをあらわそうとして子,こが選,えらんだ者,ものとのほかに、だれもありません。","tok":[["すべて"],["の"],["事","こと"],["は"],["父","ちち"],["から"],["わたし"],["に"],["任せられて","まかせられて"],["います"],["。"],["そして"],["、"],["子","こ"],["を"],["知る","しる"],["者","もの"],["は"],["父","ちち"],["の"],["ほか"],["に"],["は"],["なく"],["、"],["父","ちち"],["を"],["知る","しる"],["者","もの"],["は"],["、"],["子","こ"],["と"],["、"],["父","ちち"],["を"],["あらわそう"],["として"],["子","こ"],["が"],["選らんだ","えらんだ"],["者","もの"],["と"],["の"],["ほか"],["に"],["、"],["だれ"],["も"],["ありません"],["。"]]},{"verse":28,"text":"すべて重荷,おもにを負,おうて苦労,くろうしている者,ものは、わたしのもとにきなさい。あなたがたを休,やすませてあげよう。","tok":[["すべて"],["重荷","おもに"],["を"],["負うて","おうて"],["苦労","くろう"],["して"],["いる"],["者","もの"],["は"],["、"],["わたし"],["の"],["もと"],["に"],["き"],["なさい"],["。"],["あなた"],["がた"],["を"],["休ませて","やすませて"],["あげよう"],["。"]]},{"verse":29,"text":"わたしは柔和,にゅうわで心,こころのへりくだった者,ものであるから、わたしのくびきを負,おうて、わたしに学,まなびなさい。そうすれば、あなたがたの魂,たましいに休,やすみが与,あたえられるであろう。","tok":[["わたし"],["は"],["柔和","にゅうわ"],["で"],["心","こころ"],["の"],["へりくだった"],["者","もの"],["で"],["ある"],["から"],["、"],["わたし"],["の"],["くびき"],["を"],["負うて","おうて"],["、"],["わたし"],["に"],["学び","まなび"],["なさい"],["。"],["そう"],["すれば"],["、"],["あなた"],["がた"],["の"],["魂","たましい"],["に"],["休み","やすみ"],["が"],["与えられるで","あたえられるで"],["あろう"],["。"]]},{"verse":30,"text":"わたしのくびきは負,おいやすく、わたしの荷,には軽,かるいからである」。","tok":[["わたし"],["の"],["くびき"],["は"],["負い","おい"],["やすく"],["、"],["わたし"],["の"],["荷","に"],["は"],["軽い","かるい"],["から"],["で"],["ある"],["」"],["。"]]}]
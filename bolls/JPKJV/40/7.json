[{"verse":1,"text":"人,ひとをさばくな。自分,じぶんがさばかれないためである。","tok":[["人","ひと"],["を"],["さばく"],["な"],["。"],["自分","じぶん"],["が"],["さばかれない"],["ため"],["で"],["ある"],["。"]]},{"verse":2,"text":"あなたがたがさばくそのさばきで、自分,じぶんもさばかれ、あなたがたの量,はかるそのはかりで、自分,じぶんにも量,はかり与,あたえられるであろう。","tok":[["あなた"],["がた"],["が"],["さばく"],["その"],["さばき"],["で"],["、"],["自分","じぶん"],["も"],["さばかれ"],["、"],["あなた"],["がた"],["の"],["量る","はかる"],["その"],["はかり"],["で"],["、"],["自分","じぶん"],["に"],["も"],["量り","はかり"],["与えられるで","あたえられるで"],["あろう"],["。"]]},{"verse":3,"text":"なぜ、兄弟,きょうだいの目,めにあるちりを見,みながら、自分,じぶんの目,めにある梁,はりを認,みとめないのか。","tok":[["なぜ"],["、"],["兄弟","きょうだい"],["の"],["目","め"],["に"],["ある"],["ちり"],["を"],["見","み"],["ながら"],["、"],["自分","じぶん"],["の"],["目","め"],["に"],["ある"],["梁","はり"],["を"],["認めない","みとめない"],["の"],["か"],["。"]]},{"verse":4,"text":"自分,じぶんの目,めには梁,はりがあるのに、どうして兄弟,きょうだいにむかって、あなたの目,めからちりを取,とらせてください、と言,いえようか。","tok":[["自分","じぶん"],["の"],["目","め"],["に"],["は"],["梁","はり"],["が"],["ある"],["のに"],["、"],["どう"],["して"],["兄弟","きょうだい"],["に"],["むかって"],["、"],["あなた"],["の"],["目","め"],["から"],["ちり"],["を"],["取らせて","とらせて"],["ください"],["、"],["と"],["言えよう","いえよう"],["か"],["。"]]},{"verse":5,"text":"偽善者,ぎぜんしゃよ、まず自分,じぶんの目,めから梁,はりを取,とりのけるがよい。そうすれば、はっきり見,みえるようになって、兄弟,きょうだいの目,めからちりを取,とりのけることができるだろう。","tok":[["偽善者","ぎぜんしゃ"],["よ"],["、"],["まず"],["自分","じぶん"],["の"],["目","め"],["から"],["梁","はり"],["を"],["取","とり"],["の"],["ける"],["が"],["よい"],["。"],["そう"],["すれば"],["、"],["はっきり"],["見える","みえる"],["よう"],["に"],["なって"],["、"],["兄弟","きょうだい"],["の"],["目","め"],["から"],["ちり"],["を"],["取","とり"],["の"],["ける"],["こと"],["が"],["できるだろう"],["。"]]},{"verse":6,"text":"聖,せいなるものを犬,いぬにやるな。また真珠,しんじゅを豚,ぶたに投,なげてやるな。恐,おそらく彼,かれらはそれらを足,あしで踏,ふみつけ、向,むきなおってあなたがたにかみついてくるであろう。","tok":[["聖","せい"],["なる"],["もの"],["を"],["犬","いぬ"],["に"],["やる"],["な"],["。"],["また"],["真珠","しんじゅ"],["を"],["豚","ぶた"],["に"],["投て","なげて"],["やる"],["な"],["。"],["恐らく","おそらく"],["彼","かれ"],["ら"],["は"],["それ"],["ら"],["を"],["足","あし"],["で"],["踏みつけ","ふみつけ"],["、"],["向きなおって","むきなおって"],["あなた"],["がた"],["に"],["かみついて"],["くるで"],["あろう"],["。"]]},{"verse":7,"text":"求,もとめよ、そうすれば、与,あたえられるであろう。捜,さがせ、そうすれば、見,みいだすであろう。門,もんをたたけ、そうすれば、あけてもらえるであろう。","tok":[["求めよ","もとめよ"],["、"],["そう"],["すれば"],["、"],["与えられるで","あたえられるで"],["あろう"],["。"],["捜","さがせ"],["、"],["そう"],["すれば"],["、"],["見いだすで","みいだすで"],["あろう"],["。"],["門","もん"],["を"],["たたけ"],["、"],["そう"],["すれば"],["、"],["あけて"],["もらえるで"],["あろう"],["。"]]},{"verse":8,"text":"すべて求,もとめる者,ものは得,え、捜,さがす者,ものは見,みいだし、門,もんをたたく者,ものはあけてもらえるからである。","tok":[["すべて"],["求める","もとめる"],["者","もの"],["は"],["得","え"],["、"],["捜す","さがす"],["者","もの"],["は"],["見いだし","みいだし"],["、"],["門","もん"],["を"],["たたく"],["者","もの"],["は"],["あけて"],["もらえる"],["から"],["で"],["ある"],["。"]]},{"verse":9,"text":"あなたがたのうちで、自分,じぶんの子,こがパンを求,もとめるのに、石,いしを与,あたえる者,ものがあろうか。","tok":[["あなた"],["がた"],["の"],["うち"],["で"],["、"],["自分","じぶん"],["の"],["子","こ"],["が"],["パン"],["を"],["求める","もとめる"],["のに"],["、"],["石","いし"],["を"],["与える","あたえる"],["者","もの"],["が"],["あろう"],["か"],["。"]]},{"verse":10,"text":"魚,うおを求,もとめるのに、へびを与,あたえる者,ものがあろうか。","tok":[["魚","うお"],["を"],["求める","もとめる"],["のに"],["、"],["へび"],["を"],["与える","あたえる"],["者","もの"],["が"],["あろう"],["か"],["。"]]},{"verse":11,"text":"このように、あなたがたは悪,わるい者,ものであっても、自分,じぶんの子供,こどもには、良,よい贈,おくり物,ものをすることを知,しっているとすれば、天,てんにいますあなたがたの父,ちちはなおさら、求,もとめてくる者,ものに良,よいものを下,くださらないことがあろうか。","tok":[["この"],["よう"],["に"],["、"],["あなた"],["がた"],["は"],["悪い","わるい"],["者","もの"],["で"],["あって"],["も"],["、"],["自分","じぶん"],["の"],["子供","こども"],["に"],["は"],["、"],["良い","よい"],["贈り物","おくりもの"],["を"],["する"],["こと"],["を"],["知って","しって"],["いる"],["と"],["すれば"],["、"],["天","てん"],["に"],["います"],["あなた"],["がた"],["の"],["父","ちち"],["は"],["なおさら"],["、"],["求めて","もとめて"],["くる"],["者","もの"],["に"],["良い","よい"],["もの"],["を"],["下さらない","くださらない"],["こと"],["が"],["あろう"],["か"],["。"]]},{"verse":12,"text":"だから、何事,なにごとでも人々,ひとびとからしてほしいと望,のぞむことは、人々,ひとびとにもそのとおりにせよ。これが律法,りっぽうであり預言者,よげんしゃである。","tok":[["だ"],["から"],["、"],["何事","なにごと"],["で"],["も"],["人々","ひとびと"],["から"],["して"],["ほしい"],["と"],["望む","のぞむ"],["こと"],["は"],["、"],["人々","ひとびと"],["に"],["も"],["その"],["とおり"],["に"],["せよ"],["。"],["これ"],["が"],["律法","りっぽう"],["で"],["あり"],["預言者","よげんしゃ"],["で"],["ある"],["。"]]},{"verse":13,"text":"狭,せまい門,もんからはいれ。滅,ほろびにいたる門,もんは大,おおきく、その道,みちは広,ひろい。そして、そこからはいって行,いく者,ものが多,おおい。","tok":[["狭い","せまい"],["門","もん"],["から"],["は"],["いれ"],["。"],["滅び","ほろび"],["に"],["いたる"],["門","もん"],["は"],["大きく","おおきく"],["、"],["その"],["道","みち"],["は"],["広い","ひろい"],["。"],["そして"],["、"],["そこ"],["から"],["はい"],["って"],["行く","いく"],["者","もの"],["が"],["多い","おおい"],["。"]]},{"verse":14,"text":"命,いのちにいたる門,もんは狭,せまく、その道,みちは細,ほそい。そして、それを見,みいだす者,ものが少,すくない。","tok":[["命","いのち"],["に"],["いたる"],["門","もん"],["は"],["狭く","せまく"],["、"],["その"],["道","みち"],["は"],["細い","ほそい"],["。"],["そして"],["、"],["それ"],["を"],["見いだす","みいだす"],["者","もの"],["が"],["少い","すくない"],["。"]]},{"verse":15,"text":"にせ預言者,よげんしゃを警戒,けいかいせよ。彼,かれらは、羊,ひつじの衣,ころもを着,きてあなたがたのところに来,くるが、その内側,うちがわは強欲,ごうよくなおおかみである。","tok":[["にせ"],["預言者","よげんしゃ"],["を"],["警戒","けいかい"],["せよ"],["。"],["彼","かれ"],["ら"],["は"],["、"],["羊","ひつじ"],["の"],["衣","ころも"],["を"],["着て","きて"],["あなた"],["がた"],["の"],["ところ"],["に"],["来る","くる"],["が"],["、"],["その"],["内側","うちがわ"],["は"],["強欲","ごうよく"],["な"],["おおかみ"],["で"],["ある"],["。"]]},{"verse":16,"text":"あなたがたは、その実,みによって彼,かれらを見,みわけるであろう。茨,いばらからぶどうを、あざみからいちじくを集,あつめる者,ものがあろうか。","tok":[["あなた"],["がた"],["は"],["、"],["その"],["実","み"],["によって"],["彼","かれ"],["ら"],["を"],["見わけるで","みわけるで"],["あろう"],["。"],["茨","いば"],["ら"],["から"],["ぶどう"],["を"],["、"],["あざみ"],["から"],["いちじく"],["を"],["集める","あつめる"],["者","もの"],["が"],["あろう"],["か"],["。"]]},{"verse":17,"text":"そのように、すべて良,よい木,きは良,よい実,みを結,むすび、悪,わるい木,きは悪,わるい実,みを結,むすぶ。","tok":[["その"],["よう"],["に"],["、"],["すべて"],["良い","よい"],["木","き"],["は"],["良い","よい"],["実","み"],["を"],["結び","むすび"],["、"],["悪い","わるい"],["木","き"],["は"],["悪い","わるい"],["実","み"],["を"],["結ぶ","むすぶ"],["。"]]},{"verse":18,"text":"良,よい木,きが悪,わるい実,みをならせることはないし、悪,わるい木,きが良,よい実,みをならせることはできない。","tok":[["良い","よい"],["木","き"],["が"],["悪い","わるい"],["実","み"],["を"],["ならせる"],["こと"],["は"],["ない"],["し"],["、"],["悪い","わるい"],["木","き"],["が"],["良い","よい"],["実","み"],["を"],["ならせる"],["こと"],["は"],["できない"],["。"]]},{"verse":19,"text":"良,よい実,みを結,むすばない木,きはことごとく切,きられて、火,ひの中,なかに投,なげ込,こまれる。","tok":[["良い","よい"],["実","み"],["を"],["結ばない","むすばない"],["木","き"],["は"],["ことごとく"],["切られて","きられて"],["、"],["火","ひ"],["の"],["中","なか"],["に"],["投込まれる","なげこまれる"],["。"]]},{"verse":20,"text":"このように、あなたがたはその実,みによって彼,かれらを見,みわけるのである。","tok":[["この"],["よう"],["に"],["、"],["あなた"],["がた"],["は"],["その"],["実","み"],["によって"],["彼","かれ"],["ら"],["を"],["見わける","みわける"],["ので"],["ある"],["。"]]},{"verse":21,"text":"わたしにむかって『主,しゅよ、主,しゅよ』と言,いう者,ものが、みな天国,てんごくにはいるのではなく、ただ、天,てんにいますわが父,ちちの御旨,みむねを行,おこなう者,ものだけが、はいるのである。","tok":[["わたし"],["に"],["むかって"],["『"],["主","しゅ"],["よ"],["、"],["主","しゅ"],["よ"],["』"],["と"],["言う","いう"],["者","もの"],["が"],["、"],["みな"],["天国","てんごく"],["に"],["は"],["いる"],["ので"],["は"],["なく"],["、"],["ただ"],["、"],["天","てん"],["に"],["います"],["わが"],["父","ちち"],["の"],["御旨","みむね"],["を"],["行なう","おこなう"],["者","もの"],["だけ"],["が"],["、"],["はいる"],["ので"],["ある"],["。"]]},{"verse":22,"text":"その日,ひには、多,おおくの者,ものが、わたしにむかって『主,しゅよ、主,しゅよ、わたしたちはあなたの名,なによって預言,よげんしたではありませんか。また、あなたの名,なによって悪霊,あくれいを追,おい出,だし、あなたの名,なによって多,おおくの力,ちからあるわざを行,おこなったではありませんか』と言,いうであろう。","tok":[["その"],["日","ひ"],["に"],["は"],["、"],["多く","おおく"],["の"],["者","もの"],["が"],["、"],["わたし"],["に"],["むかって"],["『"],["主","しゅ"],["よ"],["、"],["主","しゅ"],["よ"],["、"],["わたしたち"],["は"],["あなた"],["の"],["名","な"],["によって"],["預言","よげん"],["したで"],["は"],["ありません"],["か"],["。"],["また"],["、"],["あなた"],["の"],["名","な"],["によって"],["悪霊","あくれい"],["を"],["追い出し","おいだし"],["、"],["あなた"],["の"],["名","な"],["によって"],["多く","おおく"],["の"],["力","ちから"],["ある"],["わざ"],["を"],["行なったで","おこなったで"],["は"],["ありません"],["か"],["』"],["と"],["言うで","いうで"],["あろう"],["。"]]},{"verse":23,"text":"そのとき、わたしは彼,かれらにはっきり、こう言,いおう、『あなたがたを全,まったく知,しらない。不法,ふほうを働,はたらく者,ものどもよ、行,いってしまえ』。","tok":[["その"],["とき"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["に"],["はっきり"],["、"],["こう"],["言おう","いおう"],["、"],["『"],["あなた"],["がた"],["を"],["全く","まったく"],["知らない","しらない"],["。"],["不法","ふほう"],["を"],["働く","はたらく"],["者","もの"],["ども"],["よ"],["、"],["行って","いって"],["しまえ"],["』"],["。"]]},{"verse":24,"text":"それで、わたしのこれらの言葉,ことばを聞,きいて行,おこなうものを、岩,いわの上,うえに自分,じぶんの家,いえを建,たてた賢,かしこい人,ひとに比,くらべることができよう。","tok":[["それ"],["で"],["、"],["わたし"],["の"],["これ"],["ら"],["の"],["言葉","ことば"],["を"],["聞いて","きいて"],["行なう","おこなう"],["もの"],["を"],["、"],["岩","いわ"],["の"],["上","うえ"],["に"],["自分","じぶん"],["の"],["家","いえ"],["を"],["建てた","たてた"],["賢しこい","かしこい"],["人","ひと"],["に"],["比べる","くらべる"],["こと"],["が"],["できよう"],["。"]]},{"verse":25,"text":"雨,あめが降,ふり、洪水,こうずいが押,おし寄,よせ、風,かぜが吹,ふいてその家,いえに打,うちつけても、倒,たおれることはない。岩,いわを土台,どだいとしているからである。","tok":[["雨","あめ"],["が"],["降り","ふり"],["、"],["洪水","こうずい"],["が"],["押寄せ","おしよせ"],["、"],["風","かぜ"],["が"],["吹いて","ふいて"],["その"],["家","いえ"],["に"],["打ちつけて","うちつけて"],["も"],["、"],["倒れる","たおれる"],["こと"],["は"],["ない"],["。"],["岩","いわ"],["を"],["土台","どだい"],["として"],["いる"],["から"],["で"],["ある"],["。"]]},{"verse":26,"text":"また、わたしのこれらの言葉,ことばを聞,きいても行,おこなわない者,ものを、砂,すなの上,うえに自分,じぶんの家,いえを建,たてた愚,おろかな人,ひとに比,くらべることができよう。","tok":[["また"],["、"],["わたし"],["の"],["これ"],["ら"],["の"],["言葉","ことば"],["を"],["聞いて","きいて"],["も"],["行なわない","おこなわない"],["者","もの"],["を"],["、"],["砂","すな"],["の"],["上","うえ"],["に"],["自分","じぶん"],["の"],["家","いえ"],["を"],["建てた","たてた"],["愚か","おろか"],["な"],["人","ひと"],["に"],["比べる","くらべる"],["こと"],["が"],["できよう"],["。"]]},{"verse":27,"text":"雨,あめが降,ふり、洪水,こうずいが押,おし寄,よせ、風,かぜが吹,ふいてその家,いえに打,うちつけると、倒,たおれてしまう。そしてその倒,たおれ方,かたはひどいのである」。","tok":[["雨","あめ"],["が"],["降り","ふり"],["、"],["洪水","こうずい"],["が"],["押寄せ","おしよせ"],["、"],["風","かぜ"],["が"],["吹いて","ふいて"],["その"],["家","いえ"],["に"],["打ちつける","うちつける"],["と"],["、"],["倒れて","たおれて"],["しまう"],["。"],["そして"],["その"],["倒れ","たおれ"],["方","かた"],["は"],["ひどい"],["ので"],["ある"],["」"],["。"]]},{"verse":28,"text":"イエスがこれらの言,ことばを語,かたり終,おえられると、群衆,ぐんしゅうはその教,おしえにひどく驚,おどろいた。","tok":[["イエス"],["が"],["これ"],["ら"],["の"],["言","ことば"],["を"],["語り","かたり"],["終えられる","おえられる"],["と"],["、"],["群衆","ぐんしゅう"],["は"],["その"],["教え","おしえ"],["に"],["ひどく"],["驚ろいた","おどろいた"],["。"]]},{"verse":29,"text":"それは律法,りっぽう学者,がくしゃたちのようにではなく、権威,けんいある者,もののように、教,おしえられたからである。","tok":[["それ"],["は"],["律法学者","りっぽうがくしゃ"],["たち"],["の"],["よう"],["にで"],["は"],["なく"],["、"],["権威","けんい"],["ある"],["者","もの"],["の"],["よう"],["に"],["、"],["教られた","おしえられた"],["から"],["で"],["ある"],["。"]]}]
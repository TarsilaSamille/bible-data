[{"verse":1,"text":"イエスが宮,みやから出,でて行,いこうとしておられると、弟子,でしたちは近寄,ちかよってきて、宮,みやの建物,たてものにイエスの注意,ちゅういを促,うながした。","tok":[["イエス"],["が"],["宮","みや"],["から"],["出て","でて"],["行こう","いこう"],["として"],["おられる"],["と"],["、"],["弟子","でし"],["たち"],["は"],["近寄って","ちかよって"],["きて"],["、"],["宮","みや"],["の"],["建物","たてもの"],["に"],["イエス"],["の"],["注意","ちゅうい"],["を"],["促がした","うながした"],["。"]]},{"verse":2,"text":"そこでイエスは彼,かれらにむかって言,いわれた、「あなたがたは、これらすべてのものを見,みないか。よく言,いっておく。その石,いし一つでもくずされずに、そこに他,たの石,いしの上,うえに残,のこることもなくなるであろう」。","tok":[["そこ"],["で"],["イエス"],["は"],["彼","かれ"],["ら"],["に"],["むかって"],["言われた","いわれた"],["、"],["「"],["あなた"],["がた"],["は"],["、"],["これ"],["ら"],["すべて"],["の"],["もの"],["を"],["見ない","みない"],["か"],["。"],["よく"],["言って","いって"],["おく"],["。"],["その"],["石","いし"],["一","ひと"],["つ"],["で"],["も"],["くずされず"],["に"],["、"],["そこ"],["に"],["他","た"],["の"],["石","いし"],["の"],["上","うえ"],["に"],["残る","のこる"],["こと"],["も"],["なくなるで"],["あろう"],["」"],["。"]]},{"verse":3,"text":"またオリブ山,やまですわっておられると、弟子,でしたちが、ひそかにみもとにきて言,いった、「どうぞお話,はなしください。いつ、そんなことが起,おこるのでしょうか。あなたがまたおいでになる時,ときや、世,よの終,おわりには、どんな前兆,ぜんちょうがありますか」。","tok":[["また"],["オリブ山","おりぶやま"],["で"],["すわって"],["おられる"],["と"],["、"],["弟子","でし"],["たち"],["が"],["、"],["ひそか"],["に"],["みもと"],["に"],["きて"],["言った","いった"],["、"],["「"],["どうぞ"],["お話","おはなし"],["ください"],["。"],["いつ"],["、"],["そんな"],["こと"],["が"],["起こる","おこる"],["の"],["でしょう"],["か"],["。"],["あなた"],["が"],["また"],["おいで"],["に"],["なる"],["時","とき"],["や"],["、"],["世","よ"],["の"],["終","おわり"],["に"],["は"],["、"],["どんな"],["前兆","ぜんちょう"],["が"],["あります"],["か"],["」"],["。"]]},{"verse":4,"text":"そこでイエスは答,こたえて言,いわれた、「人,ひとに惑,まどわされないように気,きをつけなさい。","tok":[["そこ"],["で"],["イエス"],["は"],["答","こたえ"],["て"],["言われた","いわれた"],["、"],["「"],["人","ひと"],["に"],["惑わされない","まどわされない"],["よう"],["に"],["気","き"],["を"],["つけ"],["なさい"],["。"]]},{"verse":5,"text":"多,おおくの者,ものがわたしの名,なを名,なのって現,あらわれ、自分,じぶんがキリストだと言,いって、多,おおくの人,ひとを惑,まどわすであろう。","tok":[["多く","おおく"],["の"],["者","もの"],["が"],["わたし"],["の"],["名","な"],["を"],["名のって","なのって"],["現われ","あらわれ"],["、"],["自分","じぶん"],["が"],["キリスト"],["だ"],["と"],["言って","いって"],["、"],["多く","おおく"],["の"],["人","ひと"],["を"],["惑わすで","まどわすで"],["あろう"],["。"]]},{"verse":6,"text":"また、戦争,せんそうと戦争,せんそうのうわさとを聞,きくであろう。注意,ちゅういしていなさい、あわててはいけない。それは起,おこらねばならないが、まだ終,おわりではない。","tok":[["また"],["、"],["戦争","せんそう"],["と"],["戦争","せんそう"],["の"],["うわさ"],["と"],["を"],["聞くで","きくで"],["あろう"],["。"],["注意","ちゅうい"],["して"],["い"],["なさい"],["、"],["あわてて"],["は"],["いけない"],["。"],["それ"],["は"],["起こらねば","おこらねば"],["ならない"],["が"],["、"],["まだ"],["終","おわり"],["で"],["は"],["ない"],["。"]]},{"verse":7,"text":"民,たみは民,たみに、国,くには国,くにに敵対,てきたいして立,たち上,あがるであろう。またあちこちに、ききんが起,おこり、また地震,じしんがあるであろう。","tok":[["民","たみ"],["は"],["民","たみ"],["に"],["、"],["国","くに"],["は"],["国","くに"],["に"],["敵対","てきたい"],["して"],["立ち上がるで","たちあがるで"],["あろう"],["。"],["また"],["あちこち"],["に"],["、"],["ききん"],["が"],["起こり","おこり"],["、"],["また"],["地震","じしん"],["が"],["あるで"],["あろう"],["。"]]},{"verse":8,"text":"しかし、すべてこれらは産,うみの苦,くるしみの初,はじめである。","tok":[["しかし"],["、"],["すべて"],["これ"],["ら"],["は"],["産み","うみ"],["の"],["苦しみ","くるしみ"],["の"],["初め","はじめ"],["で"],["ある"],["。"]]},{"verse":9,"text":"そのとき人々,ひとびとは、あなたがたを苦,くるしみにあわせ、また殺,ころすであろう。またあなたがたは、わたしの名,なのゆえにすべての民,たみに憎,にくまれるであろう。","tok":[["その"],["とき"],["人々","ひとびと"],["は"],["、"],["あなた"],["がた"],["を"],["苦しみ","くるしみ"],["に"],["あわせ"],["、"],["また"],["殺ろすで","ころすで"],["あろう"],["。"],["また"],["あなた"],["がた"],["は"],["、"],["わたし"],["の"],["名","な"],["の"],["ゆえ"],["に"],["すべて"],["の"],["民","たみ"],["に"],["憎まれるで","にくまれるで"],["あろう"],["。"]]},{"verse":10,"text":"そのとき、多,おおくの人,ひとがつまずき、また互,たがいに裏切,うらぎり、憎,にくみ合,あうであろう。","tok":[["その"],["とき"],["、"],["多く","おおく"],["の"],["人","ひと"],["が"],["つまずき"],["、"],["また"],["互","たがい"],["に"],["裏切","うらぎり"],["、"],["憎み合うで","にくみあうで"],["あろう"],["。"]]},{"verse":11,"text":"また多,おおくのにせ預言者,よげんしゃが起,おこって、多,おおくの人,ひとを惑,まどわすであろう。","tok":[["また"],["多く","おおく"],["の"],["にせ"],["預言者","よげんしゃ"],["が"],["起こって","おこって"],["、"],["多く","おおく"],["の"],["人","ひと"],["を"],["惑わすで","まどわすで"],["あろう"],["。"]]},{"verse":12,"text":"また不法,ふほうがはびこるので、多,おおくの人,ひとの愛,あいが冷,ひえるであろう。","tok":[["また"],["不法","ふほう"],["が"],["はびこる"],["ので"],["、"],["多く","おおく"],["の"],["人","ひと"],["の"],["愛","あい"],["が"],["冷えるで","ひえるで"],["あろう"],["。"]]},{"verse":13,"text":"しかし、最後,さいごまで耐,たえ忍,しのぶ者,ものは救,すくわれる。","tok":[["しかし"],["、"],["最後","さいご"],["まで"],["耐え","たえ"],["忍者","しのぶもの"],["は"],["救われる","すくわれる"],["。"]]},{"verse":14,"text":"そしてこの御国,みくにの福音,ふくいんは、すべての民,たみに対,たいしてあかしをするために、全,ぜん世界,せかいに宣,のべ伝,つたえられるであろう。そしてそれから最後,さいごが来,くるのである。","tok":[["そして"],["この"],["御国","みくに"],["の"],["福音","ふくいん"],["は"],["、"],["すべて"],["の"],["民","たみ"],["に対して","にたいして"],["あかし"],["を"],["する"],["ため"],["に"],["、"],["全","ぜん"],["世界","せかい"],["に"],["宣べ伝えられるで","のべつたえられるで"],["あろう"],["。"],["そして"],["それ"],["から"],["最後","さいご"],["が"],["来る","くる"],["ので"],["ある"],["。"]]},{"verse":15,"text":"預言者,よげんしゃダニエルによって言,いわれた荒,あらす憎,にくむべき者,ものが、聖,せいなる場所,ばしょに立,たつのを見,みたならば（読者,どくしゃよ、悟,さとれ）、","tok":[["預言者","よげんしゃ"],["ダニエル"],["によって"],["言われた","いわれた"],["荒す","あらす"],["憎むべき","にくむべき"],["者","もの"],["が"],["、"],["聖","せい"],["なる"],["場所","ばしょ"],["に"],["立つ","たつ"],["の"],["を"],["見たならば","みたならば"],["（"],["読者","どくしゃ"],["よ"],["、"],["悟れ","さとれ"],["）"],["、"]]},{"verse":16,"text":"そのとき、ユダヤにいる人々,ひとびとは山,やまへ逃,にげよ。","tok":[["その"],["とき"],["、"],["ユダヤ"],["に"],["いる"],["人々","ひとびと"],["は"],["山","やま"],["へ"],["逃","にげ"],["よ"],["。"]]},{"verse":17,"text":"屋上,おくじょうにいる者,ものは、家,いえからものを取,とり出,だそうとして下,したにおりるな。","tok":[["屋上","おくじょう"],["に"],["いる"],["者","もの"],["は"],["、"],["家","いえ"],["から"],["もの"],["を"],["取出そう","とりだそう"],["として"],["下","した"],["に"],["おりる"],["な"],["。"]]},{"verse":18,"text":"畑,はたけにいる者,ものは、上着,うわぎを取,とりにあとへもどるな。","tok":[["畑","はたけ"],["に"],["いる"],["者","もの"],["は"],["、"],["上着","うわぎ"],["を"],["取","とり"],["に"],["あと"],["へ"],["もどる"],["な"],["。"]]},{"verse":19,"text":"その日,ひには、身重,みおもの女,おんなと乳飲,ちのみ子,ごをもつ女,おんなとは、不幸,ふこうである。","tok":[["その"],["日","ひ"],["に"],["は"],["、"],["身重","みおも"],["の"],["女","おんな"],["と"],["乳飲み子","ちのみご"],["を"],["もつ"],["女","おんな"],["と"],["は"],["、"],["不幸","ふこう"],["で"],["ある"],["。"]]},{"verse":20,"text":"あなたがたの逃,にげるのが、冬,ふゆまたは安息日,あんそくにちにならないように祈,いのれ。","tok":[["あなた"],["がた"],["の"],["逃る","にげる"],["の"],["が"],["、"],["冬","ふゆ"],["また"],["は"],["安息日","あんそくにち"],["に"],["ならない"],["よう"],["に"],["祈れ","いのれ"],["。"]]},{"verse":21,"text":"その時,ときには、世,よの初,はじめから現在,げんざいに至,いたるまで、かつてなく今後,こんごもないような大,おおきな患難,かんなんが起,おこるからである。","tok":[["その"],["時","とき"],["に"],["は"],["、"],["世","よ"],["の"],["初め","はじめ"],["から"],["現在","げんざい"],["に"],["至る","いたる"],["まで"],["、"],["かつて"],["なく"],["今後","こんご"],["も"],["ない"],["よう"],["な"],["大きな","おおきな"],["患難","かんなん"],["が"],["起こる","おこる"],["から"],["で"],["ある"],["。"]]},{"verse":22,"text":"もしその期間,きかんが縮,ちぢめられないなら、救,すくわれる者,ものはひとりもないであろう。しかし、選民,せんみんのためには、その期間,きかんが縮,ちぢめられるであろう。","tok":[["もし"],["その"],["期間","きかん"],["が"],["縮められないなら","ちぢめられないなら"],["、"],["救われる","すくわれる"],["者","もの"],["は"],["ひとり"],["も"],["ないで"],["あろう"],["。"],["しかし"],["、"],["選民","せんみん"],["の"],["ため"],["に"],["は"],["、"],["その"],["期間","きかん"],["が"],["縮められるで","ちぢめられるで"],["あろう"],["。"]]},{"verse":23,"text":"そのとき、だれかがあなたがたに『見,みよ、ここにキリストがいる』、また、『あそこにいる』と言,いっても、それを信,しんじるな。","tok":[["その"],["とき"],["、"],["だれ"],["か"],["が"],["あなた"],["がた"],["に"],["『"],["見よ","みよ"],["、"],["ここ"],["に"],["キリスト"],["が"],["いる"],["』"],["、"],["また"],["、"],["『"],["あそこ"],["に"],["いる"],["』"],["と"],["言って","いって"],["も"],["、"],["それ"],["を"],["信じる","しんじる"],["な"],["。"]]},{"verse":24,"text":"にせキリストたちや、にせ預言者,よげんしゃたちが起,おこって、大,おおいなるしるしと奇跡,きせきとを行,おこない、できれば、選民,せんみんをも惑,まどわそうとするであろう。","tok":[["にせ"],["キリスト"],["たち"],["や"],["、"],["にせ"],["預言者","よげんしゃ"],["たち"],["が"],["起こって","おこって"],["、"],["大いなる","おおいなる"],["しるし"],["と"],["奇跡","きせき"],["と"],["を"],["行ない","おこない"],["、"],["できれば"],["、"],["選民","せんみん"],["を"],["も"],["惑わそう","まどわそう"],["と"],["するで"],["あろう"],["。"]]},{"verse":25,"text":"見,みよ、あなたがたに前,まえもって言,いっておく。","tok":[["見よ","みよ"],["、"],["あなた"],["がた"],["に"],["前もって","まえもって"],["言って","いって"],["おく"],["。"]]},{"verse":26,"text":"だから、人々,ひとびとが『見,みよ、彼,かれは荒野,あらのにいる』と言,いっても、出,でて行,いくな。また『見,みよ、へやの中,なかにいる』と言,いっても、信,しんじるな。","tok":[["だ"],["から"],["、"],["人々","ひとびと"],["が"],["『"],["見よ","みよ"],["、"],["彼","かれ"],["は"],["荒野","あら"],["のに"],["いる"],["』"],["と"],["言って","いって"],["も"],["、"],["出て","でて"],["行く","いく"],["な"],["。"],["また"],["『"],["見よ","みよ"],["、"],["へや"],["の"],["中","なか"],["に"],["いる"],["』"],["と"],["言って","いって"],["も"],["、"],["信じる","しんじる"],["な"],["。"]]},{"verse":27,"text":"ちょうど、いなずまが東,ひがしから西,にしにひらめき渡,わたるように、人,ひとの子,こも現,あらわれるであろう。","tok":[["ちょうど"],["、"],["いなずま"],["が"],["東","ひがし"],["から"],["西","にし"],["に"],["ひらめき"],["渡る","わたる"],["よう"],["に"],["、"],["人","ひと"],["の"],["子","こ"],["も"],["現われるで","あらわれるで"],["あろう"],["。"]]},{"verse":28,"text":"死体,したいのあるところには、はげたかが集,あつまるものである。","tok":[["死体","したい"],["の"],["ある"],["ところ"],["に"],["は"],["、"],["はげたか"],["が"],["集まる","あつまる"],["もの"],["で"],["ある"],["。"]]},{"verse":29,"text":"しかし、その時,ときに起,おこる患難,かんなんの後,のち、たちまち日,ひは暗,くらくなり、月,つきはその光,ひかりを放,はなつことをやめ、星,ほしは空,そらから落,おち、天体,てんたいは揺,ゆり動,うごかされるであろう。","tok":[["しかし"],["、"],["その"],["時","とき"],["に"],["起こる","おこる"],["患難","かんなん"],["の"],["後","の"],["ち"],["、"],["たちまち"],["日","ひ"],["は"],["暗く","くらく"],["なり"],["、"],["月","つき"],["は"],["その"],["光","ひかり"],["を"],["放つ","はなつ"],["こと"],["を"],["やめ"],["、"],["星","ほし"],["は"],["空","そら"],["から"],["落","おち"],["、"],["天体","てんたい"],["は"],["揺り動かされるで","ゆりうごかされるで"],["あろう"],["。"]]},{"verse":30,"text":"そのとき、人,ひとの子,このしるしが天,てんに現,あらわれるであろう。またそのとき、地,ちのすべての民族,みんぞくは嘆,なげき、そして力,ちからと大,おおいなる栄光,えいこうとをもって、人,ひとの子,こが天,てんの雲,くもに乗,のって来,くるのを、人々,ひとびとは見,みるであろう。","tok":[["その"],["とき"],["、"],["人","ひと"],["の"],["子","こ"],["の"],["しるし"],["が"],["天","てん"],["に"],["現われるで","あらわれるで"],["あろう"],["。"],["また"],["その"],["とき"],["、"],["地","ち"],["の"],["すべて"],["の"],["民族","みんぞく"],["は"],["嘆き","なげき"],["、"],["そして"],["力","ちから"],["と"],["大いなる","おおいなる"],["栄光","えいこう"],["と"],["を"],["もって"],["、"],["人","ひと"],["の"],["子","こ"],["が"],["天","てん"],["の"],["雲","くも"],["に"],["乗って","のって"],["来る","くる"],["の"],["を"],["、"],["人々","ひとびと"],["は"],["見るで","みるで"],["あろう"],["。"]]},{"verse":31,"text":"また、彼,かれは大,おおいなるラッパの音,おとと共,ともに御使,みつかいたちをつかわして、天,てんのはてからはてに至,いたるまで、四方,しほうからその選民,せんみんを呼,よび集,あつめるであろう。","tok":[["また"],["、"],["彼","かれ"],["は"],["大いなる","おおいなる"],["ラッパ"],["の"],["音","おと"],["と"],["共","とも"],["に"],["御使","みつかいたち"],["を"],["つかわして"],["、"],["天","てん"],["の"],["はて"],["から"],["はて"],["に"],["至る","いたる"],["まで"],["、"],["四方","しほう"],["から"],["その"],["選民","せんみん"],["を"],["呼び集めるで","よびあつめるで"],["あろう"],["。"]]},{"verse":32,"text":"いちじくの木,きからこの譬,たとえを学,まなびなさい。その枝,えだが柔,やわらかになり、葉,はが出,でるようになると、夏,なつの近,ちかいことがわかる。","tok":[["いちじく"],["の"],["木","き"],["から"],["この"],["譬","たとえ"],["を"],["学び","まなび"],["なさい"],["。"],["その"],["枝","えだ"],["が"],["柔らか","やわらか"],["に"],["なり"],["、"],["葉","は"],["が"],["出る","でる"],["よう"],["に"],["なる"],["と"],["、"],["夏","なつ"],["の"],["近い","ちかい"],["こと"],["が"],["わかる"],["。"]]},{"verse":33,"text":"そのように、すべてこれらのことを見,みたならば、人,ひとの子,こが戸口,とぐちまで近,ちかづいていると知,しりなさい。","tok":[["その"],["よう"],["に"],["、"],["すべて"],["これ"],["ら"],["の"],["こと"],["を"],["見たならば","みたならば"],["、"],["人","ひと"],["の"],["子","こ"],["が"],["戸口","とぐち"],["まで"],["近づいて","ちかづいて"],["いる"],["と"],["知り","しり"],["なさい"],["。"]]},{"verse":34,"text":"よく聞,きいておきなさい。これらの事,ことが、ことごとく起,おこるまでは、この時代,じだいは滅,ほろびることがない。","tok":[["よく"],["聞いて","きいて"],["おき"],["なさい"],["。"],["これ"],["ら"],["の"],["事","こと"],["が"],["、"],["ことごとく"],["起こる","おこる"],["まで"],["は"],["、"],["この"],["時代","じだい"],["は"],["滅びる","ほろびる"],["こと"],["が"],["ない"],["。"]]},{"verse":35,"text":"天地,てんちは滅,ほろびるであろう。しかしわたしの言葉,ことばは滅,ほろびることがない。","tok":[["天地","てんち"],["は"],["滅びるで","ほろびるで"],["あろう"],["。"],["しかし"],["わたし"],["の"],["言葉","ことば"],["は"],["滅びる","ほろびる"],["こと"],["が"],["ない"],["。"]]},{"verse":36,"text":"その日,ひ、その時,ときは、だれも知,しらない。天,てんの御使,みつかいたちも、また子,こも知,しらない、ただ父,ちちだけが知,しっておられる。","tok":[["その"],["日","ひ"],["、"],["その"],["時","とき"],["は"],["、"],["だれ"],["も"],["知らない","しらない"],["。"],["天","てん"],["の"],["御使","みつかいたち"],["も"],["、"],["また子","またこ"],["も"],["知らない","しらない"],["、"],["ただ"],["父","ちち"],["だけ"],["が"],["知って","しって"],["おられる"],["。"]]},{"verse":37,"text":"人,ひとの子,この現,あらわれるのも、ちょうどノアの時,ときのようであろう。","tok":[["人","ひと"],["の"],["子","こ"],["の"],["現われる","あらわれる"],["の"],["も"],["、"],["ちょうど"],["ノア"],["の"],["時","とき"],["の"],["よう"],["で"],["あろう"],["。"]]},{"verse":38,"text":"すなわち、洪水,こうずいの出,でる前,まえ、ノアが箱舟,はこぶねにはいる日,ひまで、人々,ひとびとは食,くい、飲,のみ、めとり、とつぎなどしていた。","tok":[["すなわち"],["、"],["洪水","こうずい"],["の"],["出る","でる"],["前","まえ"],["、"],["ノア"],["が"],["箱舟","はこぶね"],["に"],["は"],["いる"],["日","ひ"],["まで"],["、"],["人々","ひとびと"],["は"],["食い","くい"],["、"],["飲み","のみ"],["、"],["めとり"],["、"],["と"],["つぎ"],["など"],["して"],["いた"],["。"]]},{"verse":39,"text":"そして洪水,こうずいが襲,おそってきて、いっさいのものをさらって行,いくまで、彼,かれらは気,きがつかなかった。人,ひとの子,この現,あらわれるのも、そのようであろう。","tok":[["そして"],["洪水","こうずい"],["が"],["襲って","おそって"],["きて"],["、"],["いっさい"],["の"],["もの"],["を"],["さらって"],["行く","いく"],["まで"],["、"],["彼","かれ"],["ら"],["は"],["気","き"],["が"],["つかなかった"],["。"],["人","ひと"],["の"],["子","こ"],["の"],["現われる","あらわれる"],["の"],["も"],["、"],["その"],["よう"],["で"],["あろう"],["。"]]},{"verse":40,"text":"そのとき、ふたりの者,ものが畑,はたけにいると、ひとりは取,とり去,さられ、ひとりは取,とり残,のこされるであろう。","tok":[["その"],["とき"],["、"],["ふたり"],["の"],["者","もの"],["が"],["畑","はたけ"],["に"],["いる"],["と"],["、"],["ひとり"],["は"],["取去られ","とりさられ"],["、"],["ひとり"],["は"],["取残されるで","とりのこされるで"],["あろう"],["。"]]},{"verse":41,"text":"ふたりの女,おんながうすをひいていると、ひとりは取,とり去,さられ、ひとりは残,のこされるであろう。","tok":[["ふたり"],["の"],["女","おんな"],["が"],["うす"],["を"],["ひいて"],["いる"],["と"],["、"],["ひとり"],["は"],["取去られ","とりさられ"],["、"],["ひとり"],["は"],["残されるで","のこされるで"],["あろう"],["。"]]},{"verse":42,"text":"だから、目,めをさましていなさい。いつの日,ひにあなたがたの主,しゅがこられるのか、あなたがたには、わからないからである。","tok":[["だ"],["から"],["、"],["目","め"],["を"],["さまして"],["い"],["なさい"],["。"],["いつ"],["の"],["日","ひ"],["に"],["あなた"],["がた"],["の"],["主","しゅ"],["が"],["こられる"],["の"],["か"],["、"],["あなた"],["がた"],["に"],["は"],["、"],["わからない"],["から"],["で"],["ある"],["。"]]},{"verse":43,"text":"このことをわきまえているがよい。家,いえの主人,しゅじんは、盗賊,とうぞくがいつごろ来,くるかわかっているなら、目,めをさましていて、自分,じぶんの家,いえに押,おし入,いることを許,ゆるさないであろう。","tok":[["この"],["こと"],["を"],["わきまえて"],["いる"],["が"],["よい"],["。"],["家","いえ"],["の"],["主人","しゅじん"],["は"],["、"],["盗賊","とうぞく"],["が"],["いつごろ"],["来る","くる"],["か"],["わかって"],["いるなら"],["、"],["目","め"],["を"],["さまして"],["いて"],["、"],["自分","じぶん"],["の"],["家","いえ"],["に"],["押入る","おしいる"],["こと"],["を"],["許さないで","ゆるさないで"],["あろう"],["。"]]},{"verse":44,"text":"だから、あなたがたも用意,よういをしていなさい。思,おもいがけない時,ときに人,ひとの子,こが来,くるからである。","tok":[["だ"],["から"],["、"],["あなた"],["がた"],["も"],["用意","ようい"],["を"],["して"],["い"],["なさい"],["。"],["思いがけない","おもいがけない"],["時","とき"],["に"],["人","ひと"],["の"],["子","こ"],["が"],["来る","くる"],["から"],["で"],["ある"],["。"]]},{"verse":45,"text":"主人,しゅじんがその家,いえの僕,しもべたちの上,うえに立,たてて、時,ときに応,おうじて食物,しょくもつをそなえさせる忠実,ちゅうじつな思慮,しりょ深,ぶかい僕,しもべは、いったい、だれであろう。","tok":[["主人","しゅじん"],["が"],["その"],["家","いえ"],["の"],["僕","し"],["も"],["べ"],["たち"],["の"],["上","うえ"],["に"],["立てて","たてて"],["、"],["時","とき"],["に"],["応じて","おうじて"],["食物","しょくもつ"],["を"],["そなえさせる"],["忠実","ちゅうじつ"],["な"],["思慮","しりょ"],["深い","ぶかい"],["僕","し"],["も"],["べ"],["は"],["、"],["いったい"],["、"],["だれ"],["で"],["あろう"],["。"]]},{"verse":46,"text":"主人,しゅじんが帰,かえってきたとき、そのようにつとめているのを見,みられる僕,しもべは、さいわいである。","tok":[["主人","しゅじん"],["が"],["帰えって","かえって"],["きた"],["とき"],["、"],["その"],["よう"],["に"],["つとめて"],["いる"],["の"],["を"],["見られる","みられる"],["僕","し"],["も"],["べ"],["は"],["、"],["さいわい"],["で"],["ある"],["。"]]},{"verse":47,"text":"よく言,いっておくが、主人,しゅじんは彼,かれを立,たてて自分,じぶんの全,ぜん財産,ざいさんを管理,かんりさせるであろう。","tok":[["よく"],["言って","いって"],["おく"],["が"],["、"],["主人","しゅじん"],["は"],["彼","かれ"],["を"],["立てて","たてて"],["自分","じぶん"],["の"],["全","ぜん"],["財産","ざいさん"],["を"],["管理","かんり"],["させるで"],["あろう"],["。"]]},{"verse":48,"text":"もしそれが悪,わるい僕,しもべであって、自分,じぶんの主人,しゅじんは帰,かえりがおそいと心,こころの中,なかで思,おもい、","tok":[["もし"],["それ"],["が"],["悪い","わるい"],["僕","し"],["も"],["べ"],["で"],["あって"],["、"],["自分","じぶん"],["の"],["主人","しゅじん"],["は"],["帰えり","かえり"],["が"],["おそい"],["と"],["心","こころ"],["の"],["中","なか"],["で"],["思い","おもい"],["、"]]},{"verse":49,"text":"その僕,しもべ仲間,なかまをたたきはじめ、また酒飲,さけのみ仲間,なかまと一緒,いっしょに食,たべたり飲,のんだりしているなら、","tok":[["その"],["僕","し"],["も"],["べ"],["仲間","なかま"],["を"],["たたき"],["はじめ"],["、"],["また"],["酒飲み","さけのみ"],["仲間","なかま"],["と"],["一緒","いっしょ"],["に"],["食べ","たべ"],["たり"],["飲ん","のん"],["だり"],["して"],["いるなら"],["、"]]},{"verse":50,"text":"その僕,しもべの主人,しゅじんは思,おもいがけない日,ひ、気,きがつかない時,ときに帰,かえってきて、","tok":[["その"],["僕","し"],["も"],["べ"],["の"],["主人","しゅじん"],["は"],["思いがけない","おもいがけない"],["日","ひ"],["、"],["気","き"],["が"],["つかない"],["時","とき"],["に"],["帰えって","かえって"],["きて"],["、"]]},{"verse":51,"text":"彼,かれを厳罰,げんばつに処,しょし、偽善者,ぎぜんしゃたちと同,おなじ目,めにあわせるであろう。彼,かれはそこで泣,なき叫,さけんだり、歯,はがみをしたりするであろう。","tok":[["彼","かれ"],["を"],["厳罰","げんばつ"],["に"],["処し","しょし"],["、"],["偽善者","ぎぜんしゃ"],["たち"],["と"],["同じ","おなじ"],["目","め"],["に"],["あわせるで"],["あろう"],["。"],["彼","かれ"],["は"],["そこ"],["で"],["泣","なき"],["叫けん","さけん"],["だり"],["、"],["歯がみ","はがみ"],["を"],["し"],["たり"],["するで"],["あろう"],["。"]]}]
[{"verse":1,"text":"さて、イエスは御霊,みたまによって荒野,あらのに導,みちびかれた。悪魔,あくまに試,こころみられるためである。","tok":[["さて"],["、"],["イエス"],["は"],["御霊","みたま"],["によって"],["荒野","あら"],["のに"],["導かれた","みちびかれた"],["。"],["悪魔","あくま"],["に"],["試みられる","こころみられる"],["ため"],["で"],["ある"],["。"]]},{"verse":2,"text":"そして、四十日,にち四十夜,や、断食,だんじきをし、そののち空腹,くうふくになられた。","tok":[["そして"],["、"],["四十日","に"],["ち"],["四十","よんじゅう"],["夜","よる"],["、"],["断食","だんじき"],["を"],["し"],["、"],["その"],["のち"],["空腹","くうふく"],["に"],["なられた"],["。"]]},{"verse":3,"text":"すると試,こころみる者,ものがきて言,いった、「もしあなたが神,かみの子,こであるなら、これらの石,いしがパンになるように命,めいじてごらんなさい」。","tok":[["する"],["と"],["試みる","こころみる"],["者","もの"],["が"],["きて"],["言った","いった"],["、"],["「"],["もし"],["あなた"],["が"],["神","かみ"],["の"],["子","こ"],["で"],["あるなら"],["、"],["これ"],["ら"],["の"],["石","いし"],["が"],["パン"],["に"],["なる"],["よう"],["に"],["命じて","めいじて"],["ごらん"],["なさい"],["」"],["。"]]},{"verse":4,"text":"イエスは答,こたえて言,いわれた、「『人,ひとはパンだけで生,いきるものではなく、神,かみの口,くちから出,でる一つ一つの言,ことばで生,いきるものである』と書,かいてある」。","tok":[["イエス"],["は"],["答","こたえ"],["て"],["言われた","いわれた"],["、"],["「"],["『"],["人","ひと"],["は"],["パン"],["だけ"],["で"],["生きる","いきる"],["もの"],["で"],["は"],["なく"],["、"],["神","かみ"],["の"],["口","くち"],["から"],["出る","でる"],["一","ひと"],["つ"],["一","ひと"],["つ"],["の"],["言","こ"],["と"],["ば"],["で"],["生きる","いきる"],["もの"],["で"],["ある"],["』"],["と"],["書いて","かいて"],["ある"],["」"],["。"]]},{"verse":5,"text":"それから悪魔,あくまは、イエスを聖,せいなる都,みやこに連,つれて行,いき、宮,みやの頂上,ちょうじょうに立,たたせて","tok":[["それ"],["から"],["悪魔","あくま"],["は"],["、"],["イエス"],["を"],["聖","せい"],["なる"],["都","みやこ"],["に"],["連れて","つれて"],["行き","いき"],["、"],["宮","みや"],["の"],["頂上","ちょうじょう"],["に"],["立たせて","たたせて"]]},{"verse":6,"text":"言,いった、「もしあなたが神,かみの子,こであるなら、下,したへ飛,とびおりてごらんなさい。『神,かみはあなたのために御使,みつかいたちにお命,めいじになると、あなたの足,あしが石,いしに打,うちつけられないように、彼,かれらはあなたを手,てでささえるであろう』と書,かいてありますから」。","tok":[["言った","いった"],["、"],["「"],["もし"],["あなた"],["が"],["神","かみ"],["の"],["子","こ"],["で"],["あるなら"],["、"],["下","した"],["へ"],["飛びおりて","とびおりて"],["ごらん"],["なさい"],["。"],["『"],["神","かみ"],["は"],["あなた"],["の"],["ため"],["に"],["御使","みつかいたち"],["に"],["お命じ","おめいじ"],["に"],["なる"],["と"],["、"],["あなた"],["の"],["足","あし"],["が"],["石","いし"],["に"],["打ちつけられない","うちつけられない"],["よう"],["に"],["、"],["彼","かれ"],["ら"],["は"],["あなた"],["を"],["手","て"],["で"],["ささえるで"],["あろう"],["』"],["と"],["書いて","かいて"],["あります"],["から"],["」"],["。"]]},{"verse":7,"text":"イエスは彼,かれに言,いわれた、「『主,しゅなるあなたの神,かみを試,こころみてはならない』とまた書,かいてある」。","tok":[["イエス"],["は"],["彼","かれ"],["に"],["言われた","いわれた"],["、"],["「"],["『"],["主","しゅ"],["なる"],["あなた"],["の"],["神","かみ"],["を"],["試みて","こころみて"],["は"],["ならない"],["』"],["と"],["また"],["書いて","かいて"],["ある"],["」"],["。"]]},{"verse":8,"text":"次,つぎに悪魔,あくまは、イエスを非常,ひじょうに高,たかい山,やまに連,つれて行,いき、この世,よのすべての国々,くにぐにとその栄華,えいがとを見,みせて","tok":[["次","つぎ"],["に"],["悪魔","あくま"],["は"],["、"],["イエス"],["を"],["非常","ひじょう"],["に"],["高い","たかい"],["山","やま"],["に"],["連れて","つれて"],["行き","いき"],["、"],["この世","このよ"],["の"],["すべて"],["の"],["国々","くにぐに"],["と"],["その"],["栄華","えいが"],["と"],["を"],["見せて","みせて"]]},{"verse":9,"text":"言,いった、「もしあなたが、ひれ伏,ふしてわたしを拝,おがむなら、これらのものを皆,みなあなたにあげましょう」。","tok":[["言った","いった"],["、"],["「"],["もし"],["あなた"],["が"],["、"],["ひれ伏して","ひれふして"],["わたし"],["を"],["拝むなら","おがむなら"],["、"],["これ"],["ら"],["の"],["もの"],["を"],["皆","みな"],["あなた"],["に"],["あげましょう"],["」"],["。"]]},{"verse":10,"text":"するとイエスは彼,かれに言,いわれた、「サタンよ、退,しりぞけ。『主,しゅなるあなたの神,かみを拝,はいし、ただ神,かみにのみ仕,つかえよ』と書,かいてある」。","tok":[["する"],["と"],["イエス"],["は"],["彼","かれ"],["に"],["言われた","いわれた"],["、"],["「"],["サタン"],["よ"],["、"],["退ぞけ","しりぞけ"],["。"],["『"],["主","しゅ"],["なる"],["あなた"],["の"],["神","かみ"],["を"],["拝し","はいし"],["、"],["ただ"],["神","かみ"],["に"],["のみ"],["仕え","つかえ"],["よ"],["』"],["と"],["書いて","かいて"],["ある"],["」"],["。"]]},{"verse":11,"text":"そこで、悪魔,あくまはイエスを離,はなれ去,さり、そして、御使,みつかいたちがみもとにきて仕,つかえた。","tok":[["そこ"],["で"],["、"],["悪魔","あくま"],["は"],["イエス"],["を"],["離れ去り","はなれさり"],["、"],["そして"],["、"],["御使","みつかいたち"],["が"],["みもと"],["に"],["きて"],["仕えた","つかえた"],["。"]]},{"verse":12,"text":"さて、イエスはヨハネが捕,とらえられたと聞,きいて、ガリラヤへ退,しりぞかれた。","tok":[["さて"],["、"],["イエス"],["は"],["ヨハネ"],["が"],["捕らえられた","とらえられた"],["と"],["聞いて","きいて"],["、"],["ガリラヤ"],["へ"],["退ぞかれた","しりぞかれた"],["。"]]},{"verse":13,"text":"そしてナザレを去,さり、ゼブルンとナフタリとの地方,ちほうにある海,うみべの町,まちカペナウムに行,いって住,すまわれた。","tok":[["そして"],["ナザレ"],["を"],["去り","さり"],["、"],["ゼブルン"],["と"],["ナフタリ"],["と"],["の"],["地方","ちほう"],["に"],["ある"],["海べ","うみべ"],["の"],["町","まち"],["カペナウム"],["に"],["行って","いって"],["住まわれた","すまわれた"],["。"]]},{"verse":14,"text":"これは預言者,よげんしゃイザヤによって言,いわれた言,ことばが、成就,じょうじゅするためである。","tok":[["これ"],["は"],["預言者","よげんしゃ"],["イザヤ"],["によって"],["言われた","いわれた"],["言","こ"],["と"],["ば"],["が"],["、"],["成就","じょうじゅ"],["する"],["ため"],["で"],["ある"],["。"]]},{"verse":15,"text":"「ゼブルンの地,ち、ナフタリの地,ち、海,うみに沿,そう地方,ちほう、ヨルダンの向,むこうの地,ち、異邦人,いほうじんのガリラヤ、","tok":[["「"],["ゼブルン"],["の"],["地","ち"],["、"],["ナフタリ"],["の"],["地","ち"],["、"],["海","うみ"],["に"],["沿う","そう"],["地方","ちほう"],["、"],["ヨルダン"],["の"],["向こう","むこう"],["の"],["地","ち"],["、"],["異邦人","いほうじん"],["の"],["ガリラヤ"],["、"]]},{"verse":16,"text":"暗黒,あんこくの中,なかに住,すんでいる民,たみは大,おおいなる光,ひかりを見,み、死,しの地,ち、死,しの陰,かげに住,すんでいる人々,ひとびとに、光,ひかりがのぼった」。","tok":[["暗黒","あんこく"],["の"],["中","なか"],["に"],["住んで","すんで"],["いる"],["民","たみ"],["は"],["大いなる","おおいなる"],["光","ひかり"],["を"],["見","み"],["、"],["死","し"],["の"],["地","ち"],["、"],["死","し"],["の"],["陰","かげ"],["に"],["住んで","すんで"],["いる"],["人々","ひとびと"],["に"],["、"],["光","ひかり"],["が"],["のぼった"],["」"],["。"]]},{"verse":17,"text":"この時,ときからイエスは教,おしえを宣,のべはじめて言,いわれた、「悔,くい改,あらためよ、天国,てんごくは近,ちかづいた」。","tok":[["この"],["時","とき"],["から"],["イエス"],["は"],["教え","おしえ"],["を"],["宣べ","のべ"],["はじめて"],["言われた","いわれた"],["、"],["「"],["悔い","くい"],["改","あらため"],["よ"],["、"],["天国","てんごく"],["は"],["近づいた","ちかづいた"],["」"],["。"]]},{"verse":18,"text":"さて、イエスがガリラヤの海,うみべを歩,あるいておられると、ふたりの兄弟,きょうだい、すなわち、ペテロと呼,よばれたシモンとその兄弟,きょうだいアンデレとが、海,うみに網,あみを打,うっているのをごらんになった。彼,かれらは漁師,りょうしであった。","tok":[["さて"],["、"],["イエス"],["が"],["ガリラヤ"],["の"],["海べ","うみべ"],["を"],["歩いて","あるいて"],["おられる"],["と"],["、"],["ふたり"],["の"],["兄弟","きょうだい"],["、"],["すなわち"],["、"],["ペテロ"],["と"],["呼ばれた","よばれた"],["シモン"],["と"],["その"],["兄弟","きょうだい"],["アンデレ"],["と"],["が"],["、"],["海","うみ"],["に"],["網","あみ"],["を"],["打って","うって"],["いる"],["の"],["を"],["ごらん"],["に"],["なった"],["。"],["彼","かれ"],["ら"],["は"],["漁師","りょうし"],["で"],["あった"],["。"]]},{"verse":19,"text":"イエスは彼,かれらに言,いわれた、「わたしについてきなさい。あなたがたを、人間,にんげんをとる漁師,りょうしにしてあげよう」。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["わたし"],["について"],["き"],["なさい"],["。"],["あなた"],["がた"],["を"],["、"],["人間","にんげん"],["を"],["とる"],["漁師","りょうし"],["に"],["して"],["あげよう"],["」"],["。"]]},{"verse":20,"text":"すると、彼,かれらはすぐに網,あみを捨,すてて、イエスに従,したがった。","tok":[["する"],["と"],["、"],["彼","かれ"],["ら"],["は"],["すぐ"],["に"],["網","あみ"],["を"],["捨てて","すてて"],["、"],["イエス"],["に"],["従った","したがった"],["。"]]},{"verse":21,"text":"そこから進,すすんで行,いかれると、ほかのふたりの兄弟,きょうだい、すなわち、ゼベダイの子,こヤコブとその兄弟,きょうだいヨハネとが、父,ちちゼベダイと一緒,いっしょに、舟,ふねの中,なかで網,あみを繕,つくろっているのをごらんになった。そこで彼,かれらをお招,まねきになると、","tok":[["そこ"],["から"],["進んで","すすんで"],["行かれる","いかれる"],["と"],["、"],["ほか"],["の"],["ふたり"],["の"],["兄弟","きょうだい"],["、"],["すなわち"],["、"],["ゼベダイ"],["の"],["子","こ"],["ヤコブ"],["と"],["その"],["兄弟","きょうだい"],["ヨハネ"],["と"],["が"],["、"],["父","ちち"],["ゼベダイ"],["と"],["一緒","いっしょ"],["に"],["、"],["舟","ふね"],["の"],["中","なか"],["で"],["網","あみ"],["を"],["繕って","つくろって"],["いる"],["の"],["を"],["ごらん"],["に"],["なった"],["。"],["そこ"],["で"],["彼","かれ"],["ら"],["を"],["お招き","おまねき"],["に"],["なる"],["と"],["、"]]},{"verse":22,"text":"すぐ舟,ふねと父,ちちとをおいて、イエスに従,したがって行,いった。","tok":[["すぐ"],["舟","ふね"],["と"],["父","ちち"],["と"],["を"],["おいて"],["、"],["イエス"],["に"],["従って","したがって"],["行った","いった"],["。"]]},{"verse":23,"text":"イエスはガリラヤの全,ぜん地,ちを巡,めぐり歩,あるいて、諸,しょ会堂,かいどうで教,おしえ、御国,みくにの福音,ふくいんを宣,のべ伝,つたえ、民,たみの中,なかのあらゆる病気,びょうき、あらゆるわずらいをおいやしになった。","tok":[["イエス"],["は"],["ガリラヤ"],["の"],["全地","ぜんち"],["を"],["巡り歩いて","めぐりあるいて"],["、"],["諸","しょ"],["会堂","かいどう"],["で"],["教え","おしえ"],["、"],["御国","みくに"],["の"],["福音","ふくいん"],["を"],["宣べ伝え","のべつたえ"],["、"],["民","たみ"],["の"],["中","なか"],["の"],["あらゆる"],["病気","びょうき"],["、"],["あらゆる"],["わずらい"],["を"],["おいやし"],["に"],["なった"],["。"]]},{"verse":24,"text":"そこで、その評判,ひょうばんはシリヤ全,ぜん地,ちにひろまり、人々,ひとびとがあらゆる病,やまいにかかっている者,もの、すなわち、いろいろの病気,びょうきと苦,くるしみとに悩,なやんでいる者,もの、悪霊,あくれいにつかれている者,もの、てんかん、中風,ちゅうぶの者,ものなどをイエスのところに連,つれてきたので、これらの人々,ひとびとをおいやしになった。","tok":[["そこ"],["で"],["、"],["その"],["評判","ひょうばん"],["は"],["シリヤ"],["全地","ぜんち"],["に"],["ひろまり"],["、"],["人々","ひとびと"],["が"],["あらゆる"],["病","やまい"],["に"],["かかって"],["いる"],["者","もの"],["、"],["すなわち"],["、"],["いろいろ"],["の"],["病気","びょうき"],["と"],["苦しみ","くるしみ"],["と"],["に"],["悩んで","なやんで"],["いる"],["者","もの"],["、"],["悪霊","あくれい"],["に"],["つかれて"],["いる"],["者","もの"],["、"],["てんかん"],["、"],["中風","ちゅうぶ"],["の"],["者","もの"],["など"],["を"],["イエス"],["の"],["ところ"],["に"],["連れて","つれて"],["きた"],["ので"],["、"],["これ"],["ら"],["の"],["人々","ひとびと"],["を"],["おいやし"],["に"],["なった"],["。"]]},{"verse":25,"text":"こうして、ガリラヤ、デカポリス、エルサレム、ユダヤ及,およびヨルダンの向,むこうから、おびただしい群衆,ぐんしゅうがきてイエスに従,したがった。","tok":[["こう"],["して"],["、"],["ガリラヤ"],["、"],["デカポリス"],["、"],["エルサレム"],["、"],["ユダヤ"],["及","および"],["ヨルダン"],["の"],["向こう","むこう"],["から"],["、"],["おびただしい"],["群衆","ぐんしゅう"],["が"],["きて"],["イエス"],["に"],["従った","したがった"],["。"]]}]
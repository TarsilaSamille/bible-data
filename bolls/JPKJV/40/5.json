[{"verse":1,"text":"イエスはこの群衆,ぐんしゅうを見,みて、山,やまに登,のぼり、座,ざにつかれると、弟子,でしたちがみもとに近寄,ちかよってきた。","tok":[["イエス"],["は"],["この"],["群衆","ぐんしゅう"],["を"],["見て","みて"],["、"],["山","やま"],["に"],["登り","のぼり"],["、"],["座","ざ"],["に"],["つかれる"],["と"],["、"],["弟子","でし"],["たち"],["が"],["みもと"],["に"],["近寄って","ちかよって"],["きた"],["。"]]},{"verse":2,"text":"そこで、イエスは口,くちを開,ひらき、彼,かれらに教,おしえて言,いわれた。","tok":[["そこ"],["で"],["、"],["イエス"],["は"],["口","くち"],["を"],["開らき","ひらき"],["、"],["彼","かれ"],["ら"],["に"],["教えて","おしえて"],["言われた","いわれた"],["。"]]},{"verse":3,"text":"「こころの貧,まずしい人,ひとたちは、さいわいである、天国,てんごくは彼,かれらのものである。","tok":[["「"],["こころ"],["の"],["貧しい","まずしい"],["人","ひと"],["たち"],["は"],["、"],["さいわい"],["で"],["ある"],["、"],["天国","てんごく"],["は"],["彼","かれ"],["ら"],["の"],["もの"],["で"],["ある"],["。"]]},{"verse":4,"text":"悲,かなしんでいる人,ひとたちは、さいわいである、彼,かれらは慰,なぐさめられるであろう。","tok":[["悲しんで","かなしんで"],["いる"],["人","ひと"],["たち"],["は"],["、"],["さいわい"],["で"],["ある"],["、"],["彼","かれ"],["ら"],["は"],["慰さめられるで","なぐさめられるで"],["あろう"],["。"]]},{"verse":5,"text":"柔和,にゅうわな人,ひとたちは、さいわいである、彼,かれらは地,ちを受,うけつぐであろう。","tok":[["柔和","にゅうわ"],["な"],["人","ひと"],["たち"],["は"],["、"],["さいわい"],["で"],["ある"],["、"],["彼","かれ"],["ら"],["は"],["地","ち"],["を"],["受","うけ"],["つぐで"],["あろう"],["。"]]},{"verse":6,"text":"義,ぎに飢,うえかわいている人,ひとたちは、さいわいである、彼,かれらは飽,あき足,たりるようになるであろう。","tok":[["義","ぎ"],["に"],["飢","うえ"],["かわいて"],["いる"],["人","ひと"],["たち"],["は"],["、"],["さいわい"],["で"],["ある"],["、"],["彼","かれ"],["ら"],["は"],["飽き足りる","あきたりる"],["よう"],["に"],["なるで"],["あろう"],["。"]]},{"verse":7,"text":"あわれみ深,ぶかい人,ひとたちは、さいわいである、彼,かれらはあわれみを受,うけるであろう。","tok":[["あわれみ"],["深い","ぶかい"],["人","ひと"],["たち"],["は"],["、"],["さいわい"],["で"],["ある"],["、"],["彼","かれ"],["ら"],["は"],["あわれみ"],["を"],["受るで","うけるで"],["あろう"],["。"]]},{"verse":8,"text":"心,こころの清,きよい人,ひとたちは、さいわいである、彼,かれらは神,かみを見,みるであろう。","tok":[["心","こころ"],["の"],["清い","きよい"],["人","ひと"],["たち"],["は"],["、"],["さいわい"],["で"],["ある"],["、"],["彼","かれ"],["ら"],["は"],["神","かみ"],["を"],["見るで","みるで"],["あろう"],["。"]]},{"verse":9,"text":"平和,へいわをつくり出,だす人,ひとたちは、さいわいである、彼,かれらは神,かみの子,こと呼,よばれるであろう。","tok":[["平和","へいわ"],["を"],["つくり出す","つくりだす"],["人","ひと"],["たち"],["は"],["、"],["さいわい"],["で"],["ある"],["、"],["彼","かれ"],["ら"],["は"],["神","かみ"],["の"],["子","こ"],["と"],["呼ばれるで","よばれるで"],["あろう"],["。"]]},{"verse":10,"text":"義,ぎのために迫害,はくがいされてきた人,ひとたちは、さいわいである、天国,てんごくは彼,かれらのものである。","tok":[["義","ぎ"],["の"],["ため"],["に"],["迫害","はくがい"],["されて"],["きた"],["人","ひと"],["たち"],["は"],["、"],["さいわい"],["で"],["ある"],["、"],["天国","てんごく"],["は"],["彼","かれ"],["ら"],["の"],["もの"],["で"],["ある"],["。"]]},{"verse":11,"text":"わたしのために人々,ひとびとがあなたがたをののしり、また迫害,はくがいし、あなたがたに対,たいし偽,いつわって様々,さまざまの悪口,あっこうを言,いう時,ときには、あなたがたは、さいわいである。","tok":[["わたし"],["の"],["ため"],["に"],["人々","ひとびと"],["が"],["あなた"],["がた"],["を"],["ののしり"],["、"],["また"],["迫害","はくがい"],["し"],["、"],["あなた"],["がた"],["に"],["対し","たいし"],["偽わって","いつわって"],["様々","さまざま"],["の"],["悪口","あっこう"],["を"],["言う","いう"],["時","とき"],["に"],["は"],["、"],["あなた"],["がた"],["は"],["、"],["さいわい"],["で"],["ある"],["。"]]},{"verse":12,"text":"喜,よろこび、よろこべ、天,てんにおいてあなたがたの受,うける報,むくいは大,おおきい。あなたがたより前,まえの預言者,よげんしゃたちも、同,おなじように迫害,はくがいされたのである。","tok":[["喜こび","よろこび"],["、"],["よろこべ"],["、"],["天","てん"],["に"],["おいて"],["あなた"],["がた"],["の"],["受ける","うける"],["報い","むくい"],["は"],["大きい","おおきい"],["。"],["あなた"],["が"],["たより"],["前","まえ"],["の"],["預言者","よげんしゃ"],["たち"],["も"],["、"],["同じ","おなじ"],["よう"],["に"],["迫害","はくがい"],["された"],["ので"],["ある"],["。"]]},{"verse":13,"text":"あなたがたは、地,ちの塩,しおである。もし塩,しおのききめがなくなったら、何,なにによってその味,あじが取,とりもどされようか。もはや、なんの役,やくにも立,たたず、ただ外,そとに捨,すてられて、人々,ひとびとにふみつけられるだけである。","tok":[["あなた"],["がた"],["は"],["、"],["地","ち"],["の"],["塩","しお"],["で"],["ある"],["。"],["もし"],["塩","しお"],["の"],["きき"],["め"],["が"],["なくなったら"],["、"],["何に","なに"],["によって"],["その"],["味","あじ"],["が"],["取","とり"],["もどされよう"],["か"],["。"],["もはや"],["、"],["なん"],["の"],["役","やく"],["に"],["も"],["立たず","たたず"],["、"],["ただ"],["外","そと"],["に"],["捨てられて","すてられて"],["、"],["人々","ひとびと"],["に"],["ふみつけられる"],["だけ"],["で"],["ある"],["。"]]},{"verse":14,"text":"あなたがたは、世,よの光,ひかりである。山,やまの上,うえにある町,まちは隠,かくれることができない。","tok":[["あなた"],["がた"],["は"],["、"],["世","よ"],["の"],["光","ひかり"],["で"],["ある"],["。"],["山","やま"],["の"],["上","うえ"],["に"],["ある"],["町","まち"],["は"],["隠れる","かくれる"],["こと"],["が"],["できない"],["。"]]},{"verse":15,"text":"また、あかりをつけて、それを枡,ますの下,したにおく者,ものはいない。むしろ燭台,しょくだいの上,うえにおいて、家,いえの中,なかのすべてのものを照,てらさせるのである。","tok":[["また"],["、"],["あかり"],["を"],["つけて"],["、"],["それ"],["を"],["枡","ます"],["の"],["下","した"],["に"],["おく"],["者","もの"],["は"],["いない"],["。"],["むしろ"],["燭台","しょくだい"],["の"],["上","うえ"],["に"],["おいて"],["、"],["家","いえ"],["の"],["中","なか"],["の"],["すべて"],["の"],["もの"],["を"],["照らさせる","てらさせる"],["ので"],["ある"],["。"]]},{"verse":16,"text":"そのように、あなたがたの光,ひかりを人々,ひとびとの前,まえに輝,かがやかし、そして、人々,ひとびとがあなたがたのよいおこないを見,みて、天,てんにいますあなたがたの父,ちちをあがめるようにしなさい。","tok":[["その"],["よう"],["に"],["、"],["あなた"],["がた"],["の"],["光","ひかり"],["を"],["人々","ひとびと"],["の"],["前","まえ"],["に"],["輝やかし","かがやかし"],["、"],["そして"],["、"],["人々","ひとびと"],["が"],["あなた"],["がた"],["の"],["よい"],["おこない"],["を"],["見て","みて"],["、"],["天","てん"],["に"],["います"],["あなた"],["がた"],["の"],["父","ちち"],["を"],["あがめる"],["よう"],["に"],["し"],["なさい"],["。"]]},{"verse":17,"text":"わたしが律法,りっぽうや預言者,よげんしゃを廃,はいするためにきた、と思,おもってはならない。廃,はいするためではなく、成就,じょうじゅするためにきたのである。","tok":[["わたし"],["が"],["律法","りっぽう"],["や"],["預言者","よげんしゃ"],["を"],["廃する","はいする"],["ため"],["に"],["きた"],["、"],["と"],["思って","おもって"],["は"],["ならない"],["。"],["廃する","はいする"],["ため"],["で"],["は"],["なく"],["、"],["成就","じょうじゅ"],["する"],["ため"],["に"],["きた"],["ので"],["ある"],["。"]]},{"verse":18,"text":"よく言,いっておく。天地,てんちが滅,ほろび行,ゆくまでは、律法,りっぽうの一点,てん、一画,いっかくもすたることはなく、ことごとく全,まっとうされるのである。","tok":[["よく"],["言って","いって"],["おく"],["。"],["天地","てんち"],["が"],["滅び","ほろび"],["行","ゆくま"],["で"],["は"],["、"],["律法","りっぽう"],["の"],["一","いち"],["点","てん"],["、"],["一画","いっかく"],["も"],["すたる"],["こと"],["は"],["なく"],["、"],["ことごとく"],["全う","まっとう"],["される"],["ので"],["ある"],["。"]]},{"verse":19,"text":"それだから、これらの最,もっとも小,ちいさいいましめの一つでも破,やぶり、またそうするように人,ひとに教,おしえたりする者,ものは、天国,てんごくで最,もっとも小,ちいさい者,ものと呼,よばれるであろう。しかし、これをおこないまたそう教,おしえる者,ものは、天国,てんごくで大,おおいなる者,ものと呼,よばれるであろう。","tok":[["それ"],["だ"],["から"],["、"],["これ"],["ら"],["の"],["最も","もっとも"],["小さい","ちいさい"],["いましめ"],["の"],["一","ひと"],["つ"],["で"],["も"],["破り","やぶり"],["、"],["また"],["そう"],["する"],["よう"],["に"],["人","ひと"],["に"],["教え","おしえ"],["たり"],["する"],["者","もの"],["は"],["、"],["天国","てんごく"],["で"],["最も","もっとも"],["小さい","ちいさい"],["者","もの"],["と"],["呼ばれるで","よばれるで"],["あろう"],["。"],["しかし"],["、"],["これ"],["を"],["おこない"],["また"],["そう"],["教える","おしえる"],["者","もの"],["は"],["、"],["天国","てんごく"],["で"],["大いなる","おおいなる"],["者","もの"],["と"],["呼ばれるで","よばれるで"],["あろう"],["。"]]},{"verse":20,"text":"わたしは言,いっておく。あなたがたの義,ぎが律法,りっぽう学者,がくしゃやパリサイ人,びとの義,ぎにまさっていなければ、決,けっして天国,てんごくに、はいることはできない。","tok":[["わたし"],["は"],["言って","いって"],["おく"],["。"],["あなた"],["がた"],["の"],["義","ぎ"],["が"],["律法学者","りっぽうがくしゃ"],["や"],["パリサイ"],["人","びと"],["の"],["義","ぎ"],["に"],["まさって"],["いなければ"],["、"],["決っして","けっして"],["天国","てんごく"],["に"],["、"],["はいる"],["こと"],["は"],["できない"],["。"]]},{"verse":21,"text":"昔,むかしの人々,ひとびとに『殺,ころすな。殺,ころす者,ものは裁判,さいばんを受,うけねばならない』と言,いわれていたことは、あなたがたの聞,きいているところである。","tok":[["昔","むかし"],["の"],["人々","ひとびと"],["に"],["『"],["殺ろす","ころす"],["な"],["。"],["殺ろす","ころす"],["者","もの"],["は"],["裁判","さいばん"],["を"],["受ねば","うけねば"],["ならない"],["』"],["と"],["言われて","いわれて"],["いた"],["こと"],["は"],["、"],["あなた"],["がた"],["の"],["聞いて","きいて"],["いる"],["ところ"],["で"],["ある"],["。"]]},{"verse":22,"text":"しかし、わたしはあなたがたに言,いう。兄弟,きょうだいに対,たいして怒,いかる者,ものは、だれでも裁判,さいばんを受,うけねばならない。兄弟,きょうだいにむかって愚,おろか者,ものと言,いう者,ものは、議会,ぎかいに引,ひきわたされるであろう。また、ばか者,ものと言,いう者,ものは、地獄,じごくの火,ひに投,なげ込,こまれるであろう。","tok":[["しかし"],["、"],["わたし"],["は"],["あなた"],["がた"],["に"],["言う","いう"],["。"],["兄弟","きょうだい"],["に対して","にたいして"],["怒","い"],["かる"],["者","もの"],["は"],["、"],["だれ"],["で"],["も"],["裁判","さいばん"],["を"],["受ねば","うけねば"],["ならない"],["。"],["兄弟","きょうだい"],["に"],["むかって"],["愚か者","おろかもの"],["と"],["言う","いう"],["者","もの"],["は"],["、"],["議会","ぎかい"],["に"],["引","ひき"],["わたされるで"],["あろう"],["。"],["また"],["、"],["ばか者","ばかもの"],["と"],["言う","いう"],["者","もの"],["は"],["、"],["地獄","じごく"],["の"],["火","ひ"],["に"],["投込まれるで","なげこまれるで"],["あろう"],["。"]]},{"verse":23,"text":"だから、祭壇,さいだんに供,そなえ物,ものをささげようとする場合,ばあい、兄弟,きょうだいが自分,じぶんに対,たいして何,なにかうらみをいだいていることを、そこで思,おもい出,だしたなら、","tok":[["だ"],["から"],["、"],["祭壇","さいだん"],["に"],["供え物","そなえもの"],["を"],["ささげよう"],["と"],["する"],["場合","ばあい"],["、"],["兄弟","きょうだい"],["が"],["自分","じぶん"],["に対して","にたいして"],["何に","なに"],["か"],["うらみ"],["を"],["いだいて"],["いる"],["こと"],["を"],["、"],["そこ"],["で"],["思い出したなら","おもいだしたなら"],["、"]]},{"verse":24,"text":"その供,そなえ物,ものを祭壇,さいだんの前,まえに残,のこしておき、まず行,いってその兄弟,きょうだいと和解,わかいし、それから帰,かえってきて、供,そなえ物,ものをささげることにしなさい。","tok":[["その"],["供え物","そなえもの"],["を"],["祭壇","さいだん"],["の"],["前","まえ"],["に"],["残して","のこして"],["おき"],["、"],["まず"],["行って","いって"],["その"],["兄弟","きょうだい"],["と"],["和解","わかい"],["し"],["、"],["それ"],["から"],["帰えって","かえって"],["きて"],["、"],["供え物","そなえもの"],["を"],["ささげる"],["こと"],["に"],["し"],["なさい"],["。"]]},{"verse":25,"text":"あなたを訴,うったえる者,ものと一緒,いっしょに道,みちを行,いく時,ときには、その途中,とちゅうで早,はやく仲直,なかなおりをしなさい。そうしないと、その訴,うったえる者,ものはあなたを裁判官,さいばんかんにわたし、裁判官,さいばんかんは下役,したやくにわたし、そして、あなたは獄,ごくに入,いれられるであろう。","tok":[["あなた"],["を"],["訴る","うったえる"],["者","もの"],["と"],["一緒","いっしょ"],["に"],["道","みち"],["を"],["行く","いく"],["時","とき"],["に"],["は"],["、"],["その"],["途中","とちゅう"],["で"],["早く","はやく"],["仲直り","なかなおり"],["を"],["し"],["なさい"],["。"],["そう"],["しない"],["と"],["、"],["その"],["訴る","うったえる"],["者","もの"],["は"],["あなた"],["を"],["裁判官","さいばんかん"],["に"],["わたし"],["、"],["裁判官","さいばんかん"],["は"],["下役","したやく"],["に"],["わたし"],["、"],["そして"],["、"],["あなた"],["は"],["獄","ごく"],["に"],["入れられるで","いれられるで"],["あろう"],["。"]]},{"verse":26,"text":"よくあなたに言,いっておく。最後,さいごの一コドラントを支払,しはらってしまうまでは、決,けっしてそこから出,でてくることはできない。","tok":[["よく"],["あなた"],["に"],["言って","いって"],["おく"],["。"],["最後","さいご"],["の"],["一","いち"],["コドラント"],["を"],["支払って","しはらって"],["しまう"],["まで"],["は"],["、"],["決っして","けっして"],["そこ"],["から"],["出て","でて"],["くる"],["こと"],["は"],["できない"],["。"]]},{"verse":27,"text":"『姦淫,かんいんするな』と言,いわれていたことは、あなたがたの聞,きいているところである。","tok":[["『"],["姦淫","かんいん"],["する"],["な"],["』"],["と"],["言われて","いわれて"],["いた"],["こと"],["は"],["、"],["あなた"],["がた"],["の"],["聞いて","きいて"],["いる"],["ところ"],["で"],["ある"],["。"]]},{"verse":28,"text":"しかし、わたしはあなたがたに言,いう。だれでも、情欲,じょうよくをいだいて女,おんなを見,みる者,ものは、心,こころの中,なかですでに姦淫,かんいんをしたのである。","tok":[["しかし"],["、"],["わたし"],["は"],["あなた"],["がた"],["に"],["言う","いう"],["。"],["だれ"],["で"],["も"],["、"],["情欲","じょうよく"],["を"],["いだいて"],["女","おんな"],["を"],["見る","みる"],["者","もの"],["は"],["、"],["心","こころ"],["の"],["中","なか"],["で"],["すでに"],["姦淫","かんいん"],["を"],["した"],["ので"],["ある"],["。"]]},{"verse":29,"text":"もしあなたの右,みぎの目,めが罪,つみを犯,おかさせるなら、それを抜,ぬき出,だして捨,すてなさい。五体,ごたいの一部,いちぶを失,うしなっても、全身,ぜんしんが地獄,じごくに投,なげ入,いれられない方,ほうが、あなたにとって益,えきである。","tok":[["もし"],["あなた"],["の"],["右","みぎ"],["の"],["目","め"],["が"],["罪","つみ"],["を"],["犯させるなら","おかさせるなら"],["、"],["それ"],["を"],["抜き出して","ぬきだして"],["捨て","すて"],["なさい"],["。"],["五体","ごたい"],["の"],["一部","いちぶ"],["を"],["失なって","うしなって"],["も"],["、"],["全身","ぜんしん"],["が"],["地獄","じごく"],["に"],["投入れられない","なげいれられない"],["方","ほう"],["が"],["、"],["あなた"],["にとって"],["益","えき"],["で"],["ある"],["。"]]},{"verse":30,"text":"もしあなたの右,みぎの手,てが罪,つみを犯,おかさせるなら、それを切,きって捨,すてなさい。五体,ごたいの一部,いちぶを失,うしなっても、全身,ぜんしんが地獄,じごくに落,おち込,こまない方,ほうが、あなたにとって益,えきである。","tok":[["もし"],["あなた"],["の"],["右","みぎ"],["の"],["手","て"],["が"],["罪","つみ"],["を"],["犯させるなら","おかさせるなら"],["、"],["それ"],["を"],["切って","きって"],["捨て","すて"],["なさい"],["。"],["五体","ごたい"],["の"],["一部","いちぶ"],["を"],["失なって","うしなって"],["も"],["、"],["全身","ぜんしん"],["が"],["地獄","じごく"],["に"],["落込まない","おちこまない"],["方","ほう"],["が"],["、"],["あなた"],["にとって"],["益","えき"],["で"],["ある"],["。"]]},{"verse":31,"text":"また『妻,つまを出,だす者,ものは離縁,りえん状,じょうを渡,わたせ』と言,いわれている。","tok":[["また"],["『"],["妻","つま"],["を"],["出す","だす"],["者","もの"],["は"],["離縁状","りえんじょう"],["を"],["渡せ","わたせ"],["』"],["と"],["言われて","いわれて"],["いる"],["。"]]},{"verse":32,"text":"しかし、わたしはあなたがたに言,いう。だれでも、不品行,ふひんこう以外,いがいの理由,りゆうで自分,じぶんの妻,つまを出,だす者,ものは、姦淫,かんいんを行,おこなわせるのである。また出,だされた女,おんなをめとる者,ものも、姦淫,かんいんを行,おこなうのである。","tok":[["しかし"],["、"],["わたし"],["は"],["あなた"],["がた"],["に"],["言う","いう"],["。"],["だれ"],["で"],["も"],["、"],["不品行","ふひんこう"],["以外","いがい"],["の"],["理由","りゆう"],["で"],["自分","じぶん"],["の"],["妻","つま"],["を"],["出す","だす"],["者","もの"],["は"],["、"],["姦淫","かんいん"],["を"],["行なわせる","おこなわせる"],["ので"],["ある"],["。"],["また"],["出された","だされた"],["女","おんな"],["を"],["めとる"],["者","もの"],["も"],["、"],["姦淫","かんいん"],["を"],["行なう","おこなう"],["ので"],["ある"],["。"]]},{"verse":33,"text":"また昔,むかしの人々,ひとびとに『いつわり誓,ちかうな、誓,ちかったことは、すべて主,しゅに対,たいして果,はたせ』と言,いわれていたことは、あなたがたの聞,きいているところである。","tok":[["また"],["昔","むかし"],["の"],["人々","ひとびと"],["に"],["『"],["いつわり"],["誓う","ちかう"],["な"],["、"],["誓った","ちかった"],["こと"],["は"],["、"],["すべて"],["主","しゅ"],["に対して","にたいして"],["果たせ","はたせ"],["』"],["と"],["言われて","いわれて"],["いた"],["こと"],["は"],["、"],["あなた"],["がた"],["の"],["聞いて","きいて"],["いる"],["ところ"],["で"],["ある"],["。"]]},{"verse":34,"text":"しかし、わたしはあなたがたに言,いう。いっさい誓,ちかってはならない。天,てんをさして誓,ちかうな。そこは神,かみの御座,みざであるから。","tok":[["しかし"],["、"],["わたし"],["は"],["あなた"],["がた"],["に"],["言う","いう"],["。"],["いっさい"],["誓って","ちかって"],["は"],["ならない"],["。"],["天","てん"],["を"],["さして"],["誓う","ちかう"],["な"],["。"],["そこ"],["は"],["神","かみ"],["の"],["御座ら","みざであるから"],["。"]]},{"verse":35,"text":"また地,ちをさして誓,ちかうな。そこは神,かみの足,あし台,だいであるから。またエルサレムをさして誓,ちかうな。それは『大王,だいおうの都,みやこ』であるから。","tok":[["また"],["地","ち"],["を"],["さして"],["誓う","ちかう"],["な"],["。"],["そこ"],["は"],["神","かみ"],["の"],["足台","あしだい"],["で"],["ある"],["から"],["。"],["また"],["エルサレム"],["を"],["さして"],["誓う","ちかう"],["な"],["。"],["それ"],["は"],["『"],["大王","だいおう"],["の"],["都","み"],["や"],["こ"],["』"],["で"],["ある"],["から"],["。"]]},{"verse":36,"text":"また、自分,じぶんの頭,あたまをさして誓,ちかうな。あなたは髪,かみの毛,け一,ひとすじさえ、白,しろくも黒,くろくもすることができない。","tok":[["また"],["、"],["自分","じぶん"],["の"],["頭","あたま"],["を"],["さして"],["誓う","ちかう"],["な"],["。"],["あなた"],["は"],["髪の毛","かみのけ"],["一すじ","ひとすじ"],["さえ"],["、"],["白くも","しろくも"],["黒く","くろく"],["も"],["する"],["こと"],["が"],["できない"],["。"]]},{"verse":37,"text":"あなたがたの言葉,ことばは、ただ、しかり、しかり、否,いな、否,いな、であるべきだ。それ以上,いじょうに出,でることは、悪,あくから来,くるのである。","tok":[["あなた"],["がた"],["の"],["言葉","ことば"],["は"],["、"],["ただ"],["、"],["しかり"],["、"],["しかり"],["、"],["否","いな"],["、"],["否","いな"],["、"],["で"],["あるべきだ"],["。"],["それ"],["以上","いじょう"],["に"],["出る","でる"],["こと"],["は"],["、"],["悪","あく"],["から"],["来る","くる"],["ので"],["ある"],["。"]]},{"verse":38,"text":"『目,めには目,めを、歯,はには歯,はを』と言,いわれていたことは、あなたがたの聞,きいているところである。","tok":[["『"],["目","め"],["に"],["は"],["目","め"],["を"],["、"],["歯","は"],["に"],["は"],["歯","は"],["を"],["』"],["と"],["言われて","いわれて"],["いた"],["こと"],["は"],["、"],["あなた"],["がた"],["の"],["聞いて","きいて"],["いる"],["ところ"],["で"],["ある"],["。"]]},{"verse":39,"text":"しかし、わたしはあなたがたに言,いう。悪人,あくにんに手向,てむかうな。もし、だれかがあなたの右,みぎの頬,ほおを打,うつなら、ほかの頬,ほおをも向,むけてやりなさい。","tok":[["しかし"],["、"],["わたし"],["は"],["あなた"],["がた"],["に"],["言う","いう"],["。"],["悪人","あくにん"],["に"],["手向かう","てむかう"],["な"],["。"],["もし"],["、"],["だれ"],["か"],["が"],["あなた"],["の"],["右","みぎ"],["の"],["頬","ほお"],["を"],["打つなら","うつなら"],["、"],["ほか"],["の"],["頬","ほお"],["を"],["も"],["向けて","むけて"],["やり"],["なさい"],["。"]]},{"verse":40,"text":"あなたを訴,うったえて、下着,したぎを取,とろうとする者,ものには、上着,うわぎをも与,あたえなさい。","tok":[["あなた"],["を"],["訴て","うったえて"],["、"],["下着","したぎ"],["を"],["取ろう","とろう"],["と"],["する"],["者","もの"],["に"],["は"],["、"],["上着","うわぎ"],["を"],["も"],["与え","あたえ"],["なさい"],["。"]]},{"verse":41,"text":"もし、だれかが、あなたをしいて一マイル行,いかせようとするなら、その人,ひとと共,ともに二マイル行,いきなさい。","tok":[["もし"],["、"],["だれ"],["か"],["が"],["、"],["あなた"],["を"],["しいて"],["一","いち"],["マイル"],["行かせよう","いかせよう"],["と"],["するなら"],["、"],["その"],["人","ひと"],["と"],["共","とも"],["に"],["二","に"],["マイル"],["行き","いき"],["なさい"],["。"]]},{"verse":42,"text":"求,もとめる者,ものには与,あたえ、借,かりようとする者,ものを断,ことわるな。","tok":[["求める","もとめる"],["者","もの"],["に"],["は"],["与","あたえ"],["、"],["借","かり"],["よう"],["と"],["する"],["者","もの"],["を"],["断る","ことわる"],["な"],["。"]]},{"verse":43,"text":"『隣,となり人,びとを愛,あいし、敵,てきを憎,にくめ』と言,いわれていたことは、あなたがたの聞,きいているところである。","tok":[["『"],["隣人","となりびと"],["を"],["愛し","あいし"],["、"],["敵","てき"],["を"],["憎め","にくめ"],["』"],["と"],["言われて","いわれて"],["いた"],["こと"],["は"],["、"],["あなた"],["がた"],["の"],["聞いて","きいて"],["いる"],["ところ"],["で"],["ある"],["。"]]},{"verse":44,"text":"しかし、わたしはあなたがたに言,いう。敵,てきを愛,あいし、迫害,はくがいする者,もののために祈,いのれ。","tok":[["しかし"],["、"],["わたし"],["は"],["あなた"],["がた"],["に"],["言う","いう"],["。"],["敵","てき"],["を"],["愛し","あいし"],["、"],["迫害","はくがい"],["する"],["者","もの"],["の"],["ため"],["に"],["祈れ","いのれ"],["。"]]},{"verse":45,"text":"こうして、天,てんにいますあなたがたの父,ちちの子,ことなるためである。天,てんの父,ちちは、悪,わるい者,ものの上,うえにも良,よい者,ものの上,うえにも、太陽,たいようをのぼらせ、正,ただしい者,ものにも正,ただしくない者,ものにも、雨,あめを降,ふらして下,くださるからである。","tok":[["こう"],["して"],["、"],["天","てん"],["に"],["います"],["あなた"],["がた"],["の"],["父","ちち"],["の"],["子","こ"],["と"],["なる"],["ため"],["で"],["ある"],["。"],["天","てん"],["の"],["父","ちち"],["は"],["、"],["悪い","わるい"],["者","もの"],["の"],["上","うえ"],["に"],["も"],["良い","よい"],["者","もの"],["の"],["上","うえ"],["に"],["も"],["、"],["太陽","たいよう"],["を"],["のぼらせ"],["、"],["正い","ただしい"],["者","もの"],["に"],["も"],["正く","ただしく"],["ない"],["者","もの"],["に"],["も"],["、"],["雨","あめ"],["を"],["降らして","ふらして"],["下さる","くださる"],["から"],["で"],["ある"],["。"]]},{"verse":46,"text":"あなたがたが自分,じぶんを愛,あいする者,ものを愛,あいしたからとて、なんの報,むくいがあろうか。そのようなことは取税人,しゅぜいにんでもするではないか。","tok":[["あなた"],["がた"],["が"],["自分","じぶん"],["を"],["愛する","あいする"],["者","もの"],["を"],["愛した","あいした"],["から"],["とて"],["、"],["なん"],["の"],["報い","むくい"],["が"],["あろう"],["か"],["。"],["その"],["よう"],["な"],["こと"],["は"],["取","とり"],["税人","ぜいにん"],["で"],["も"],["するで"],["は"],["ない"],["か"],["。"]]},{"verse":47,"text":"兄弟,きょうだいだけにあいさつをしたからとて、なんのすぐれた事,ことをしているだろうか。そのようなことは異邦人,いほうじんでもしているではないか。","tok":[["兄弟","きょうだい"],["だけ"],["に"],["あいさつ"],["を"],["した"],["から"],["とて"],["、"],["なん"],["の"],["すぐれた"],["事","こと"],["を"],["して"],["いるだろう"],["か"],["。"],["その"],["よう"],["な"],["こと"],["は"],["異邦人","いほうじん"],["で"],["も"],["して"],["いるで"],["は"],["ない"],["か"],["。"]]},{"verse":48,"text":"それだから、あなたがたの天,てんの父,ちちが完全,かんぜんであられるように、あなたがたも完全,かんぜんな者,ものとなりなさい。","tok":[["それ"],["だ"],["から"],["、"],["あなた"],["がた"],["の"],["天","てん"],["の"],["父","ちち"],["が"],["完全","かんぜん"],["で"],["あられる"],["よう"],["に"],["、"],["あなた"],["がた"],["も"],["完全","かんぜん"],["な"],["者","もの"],["と"],["なり"],["なさい"],["。"]]}]
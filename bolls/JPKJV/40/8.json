[{"verse":1,"text":"イエスが山,やまをお降,おりになると、おびただしい群衆,ぐんしゅうがついてきた。","tok":[["イエス"],["が"],["山","やま"],["を"],["お"],["降","おり"],["に"],["なる"],["と"],["、"],["おびただしい"],["群衆","ぐんしゅう"],["が"],["ついて"],["きた"],["。"]]},{"verse":2,"text":"すると、そのとき、ひとりのらい病人,びょうにんがイエスのところにきて、ひれ伏,ふして言,いった、「主,しゅよ、みこころでしたら、きよめていただけるのですが」。","tok":[["する"],["と"],["、"],["その"],["とき"],["、"],["ひとり"],["の"],["らい病人","らいびょうにん"],["が"],["イエス"],["の"],["ところ"],["に"],["きて"],["、"],["ひれ伏して","ひれふして"],["言った","いった"],["、"],["「"],["主","しゅ"],["よ"],["、"],["みこころ"],["でしたら"],["、"],["きよめて"],["いただける"],["の"],["です"],["が"],["」"],["。"]]},{"verse":3,"text":"イエスは手,てを伸,のばして、彼,かれにさわり、「そうしてあげよう、きよくなれ」と言,いわれた。すると、らい病,びょうは直,ただちにきよめられた。","tok":[["イエス"],["は"],["手","て"],["を"],["伸ばして","のばして"],["、"],["彼","かれ"],["に"],["さわり"],["、"],["「"],["そう"],["して"],["あげよう"],["、"],["きよく"],["なれ"],["」"],["と"],["言われた","いわれた"],["。"],["する"],["と"],["、"],["らい病","らいびょう"],["は"],["直ちに","ただちに"],["きよめられた"],["。"]]},{"verse":4,"text":"イエスは彼,かれに言,いわれた、「だれにも話,はなさないように、注意,ちゅういしなさい。ただ行,いって、自分,じぶんのからだを祭司,さいしに見,みせ、それから、モーセが命,めいじた供,そなえ物,ものをささげて、人々,ひとびとに証明,しょうめいしなさい」。","tok":[["イエス"],["は"],["彼","かれ"],["に"],["言われた","いわれた"],["、"],["「"],["だれ"],["に"],["も"],["話さない","はなさない"],["よう"],["に"],["、"],["注意","ちゅうい"],["し"],["なさい"],["。"],["ただ"],["行って","いって"],["、"],["自分","じぶん"],["の"],["からだ"],["を"],["祭司","さいし"],["に"],["見せ","みせ"],["、"],["それ"],["から"],["、"],["モーセ"],["が"],["命じた","めいじた"],["供え物","そなえもの"],["を"],["ささげて"],["、"],["人々","ひとびと"],["に"],["証明","しょうめい"],["し"],["なさい"],["」"],["。"]]},{"verse":5,"text":"さて、イエスがカペナウムに帰,かえってこられたとき、ある百卒長,ひゃくそつちょうがみもとにきて訴,うったえて言,いった、","tok":[["さて"],["、"],["イエス"],["が"],["カペナウム"],["に"],["帰えって","かえって"],["こられた"],["とき"],["、"],["ある"],["百卒長","ひゃくそつちょう"],["が"],["みもと"],["に"],["きて"],["訴て","うったえて"],["言った","いった"],["、"]]},{"verse":6,"text":"「主,しゅよ、わたしの僕,しもべが中風,ちゅうぶでひどく苦,くるしんで、家,いえに寝,ねています」。","tok":[["「"],["主","しゅ"],["よ"],["、"],["わたし"],["の"],["僕","し"],["も"],["べ"],["が"],["中風","ちゅうぶ"],["で"],["ひどく"],["苦しんで","くるしんで"],["、"],["家","いえ"],["に"],["寝て","ねて"],["います"],["」"],["。"]]},{"verse":7,"text":"イエスは彼,かれに、「わたしが行,いってなおしてあげよう」と言,いわれた。","tok":[["イエス"],["は"],["彼","かれ"],["に"],["、"],["「"],["わたし"],["が"],["行って","いって"],["なおして"],["あげよう"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":8,"text":"そこで百卒長,ひゃくそつちょうは答,こたえて言,いった、「主,しゅよ、わたしの屋根,やねの下,したにあなたをお入,いれする資格,しかくは、わたしにはございません。ただ、お言葉,ことばを下,ください。そうすれば僕,しもべはなおります。","tok":[["そこ"],["で"],["百卒長","ひゃくそつちょう"],["は"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["主","しゅ"],["よ"],["、"],["わたし"],["の"],["屋根","やね"],["の"],["下","した"],["に"],["あなた"],["を"],["お入れ","おいれ"],["する"],["資格","しかく"],["は"],["、"],["わたし"],["に"],["は"],["ございません"],["。"],["ただ"],["、"],["お言葉","おことば"],["を"],["下さい","ください"],["。"],["そう"],["すれば"],["僕","し"],["も"],["べ"],["は"],["なおります"],["。"]]},{"verse":9,"text":"わたしも権威,けんいの下,したにある者,ものですが、わたしの下,したにも兵卒,へいそつがいまして、ひとりの者,ものに『行,いけ』と言,いえば行,いき、ほかの者,ものに『こい』と言,いえばきますし、また、僕,しもべに『これをせよ』と言,いえば、してくれるのです」。","tok":[["わたし"],["も"],["権威","けんい"],["の"],["下","した"],["に"],["ある"],["者","もの"],["です"],["が"],["、"],["わたし"],["の"],["下","した"],["に"],["も"],["兵卒","へいそつ"],["が"],["いまして"],["、"],["ひとり"],["の"],["者","もの"],["に"],["『"],["行け","いけ"],["』"],["と"],["言えば","いえば"],["行き","いき"],["、"],["ほか"],["の"],["者","もの"],["に"],["『"],["こい"],["』"],["と"],["言えば","いえば"],["きます"],["し"],["、"],["また"],["、"],["僕","し"],["も"],["べ"],["に"],["『"],["これ"],["を"],["せよ"],["』"],["と"],["言えば","いえば"],["、"],["して"],["くれる"],["の"],["です"],["」"],["。"]]},{"verse":10,"text":"イエスはこれを聞,きいて非常,ひじょうに感心,かんしんされ、ついてきた人々,ひとびとに言,いわれた、「よく聞,ききなさい。イスラエル人,ひとの中,なかにも、これほどの信仰,しんこうを見,みたことがない。","tok":[["イエス"],["は"],["これ"],["を"],["聞いて","きいて"],["非常","ひじょう"],["に"],["感心","かんしん"],["され"],["、"],["ついて"],["きた"],["人々","ひとびと"],["に"],["言われた","いわれた"],["、"],["「"],["よく"],["聞","きき"],["なさい"],["。"],["イスラエル"],["人","ひと"],["の"],["中","なか"],["に"],["も"],["、"],["これ"],["ほど"],["の"],["信仰","しんこう"],["を"],["見た","みた"],["こと"],["が"],["ない"],["。"]]},{"verse":11,"text":"なお、あなたがたに言,いうが、多,おおくの人,ひとが東,ひがしから西,にしからきて、天国,てんごくで、アブラハム、イサク、ヤコブと共,ともに宴会,えんかいの席,せきにつくが、","tok":[["なお"],["、"],["あなた"],["がた"],["に"],["言う","いう"],["が"],["、"],["多く","おおく"],["の"],["人","ひと"],["が"],["東","ひがし"],["から"],["西","にし"],["から"],["きて"],["、"],["天国","てんごく"],["で"],["、"],["アブラハム"],["、"],["イサク"],["、"],["ヤコブ"],["と"],["共","とも"],["に"],["宴会","えんかい"],["の"],["席","せき"],["に"],["つく"],["が"],["、"]]},{"verse":12,"text":"この国,くにの子,こらは外,そとのやみに追,おい出,だされ、そこで泣,なき叫,さけんだり、歯,はがみをしたりするであろう」。","tok":[["この"],["国","くに"],["の"],["子","こ"],["ら"],["は"],["外","そと"],["の"],["やみ"],["に"],["追い出され","おいだされ"],["、"],["そこ"],["で"],["泣","なき"],["叫けん","さけん"],["だり"],["、"],["歯がみ","はがみ"],["を"],["し"],["たり"],["するで"],["あろう"],["」"],["。"]]},{"verse":13,"text":"それからイエスは百卒長,ひゃくそつちょうに「行,いけ、あなたの信,しんじたとおりになるように」と言,いわれた。すると、ちょうどその時,ときに、僕,しもべはいやされた。","tok":[["それ"],["から"],["イエス"],["は"],["百卒長","ひゃくそつちょう"],["に"],["「"],["行け","いけ"],["、"],["あなた"],["の"],["信じた","しんじた"],["とおり"],["に"],["なる"],["よう"],["に"],["」"],["と"],["言われた","いわれた"],["。"],["する"],["と"],["、"],["ちょうど"],["その"],["時","とき"],["に"],["、"],["僕","し"],["も"],["べ"],["は"],["いやされた"],["。"]]},{"verse":14,"text":"それから、イエスはペテロの家,いえにはいって行,いかれ、そのしゅうとめが熱病,ねつびょうで、床,とこについているのをごらんになった。","tok":[["それ"],["から"],["、"],["イエス"],["は"],["ペテロ"],["の"],["家","いえ"],["に"],["はいって"],["行かれ","いかれ"],["、"],["その"],["しゅうとめ"],["が"],["熱病","ねつびょう"],["で"],["、"],["床","とこ"],["について"],["いる"],["の"],["を"],["ごらん"],["に"],["なった"],["。"]]},{"verse":15,"text":"そこで、その手,てにさわられると、熱,ねつが引,ひいた。そして女,おんなは起,おきあがってイエスをもてなした。","tok":[["そこ"],["で"],["、"],["その"],["手","て"],["に"],["さわられる"],["と"],["、"],["熱","ねつ"],["が"],["引いた","ひいた"],["。"],["そして"],["女","おんな"],["は"],["起きあがって","おきあがって"],["イエス"],["を"],["もてなした"],["。"]]},{"verse":16,"text":"夕暮,ゆうぐれになると、人々,ひとびとは悪霊,あくれいにつかれた者,ものを大,おおぜい、みもとに連,つれてきたので、イエスはみ言葉,ことばをもって霊,れいどもを追,おい出,だし、病人,びょうにんをことごとくおいやしになった。","tok":[["夕暮","ゆうぐれ"],["に"],["なる"],["と"],["、"],["人々","ひとびと"],["は"],["悪霊","あくれい"],["に"],["つかれた"],["者","もの"],["を"],["大ぜい","おおぜい"],["、"],["みもと"],["に"],["連れて","つれて"],["きた"],["ので"],["、"],["イエス"],["は"],["み言葉","みことば"],["を"],["もって"],["霊","れい"],["ども"],["を"],["追い出し","おいだし"],["、"],["病人","びょうにん"],["を"],["ことごとく"],["おいやし"],["に"],["なった"],["。"]]},{"verse":17,"text":"これは、預言者,よげんしゃイザヤによって「彼,かれは、わたしたちのわずらいを身,みに受,うけ、わたしたちの病,やまいを負,おうた」と言,いわれた言葉,ことばが成就,じょうじゅするためである。","tok":[["これ"],["は"],["、"],["預言者","よげんしゃ"],["イザヤ"],["によって"],["「"],["彼","かれ"],["は"],["、"],["わたしたち"],["の"],["わずらい"],["を"],["身","み"],["に"],["受け","うけ"],["、"],["わたしたち"],["の"],["病","やまい"],["を"],["負うた","おうた"],["」"],["と"],["言われた","いわれた"],["言葉","ことば"],["が"],["成就","じょうじゅ"],["する"],["ため"],["で"],["ある"],["。"]]},{"verse":18,"text":"イエスは、群衆,ぐんしゅうが自分,じぶんのまわりに群,むらがっているのを見,みて、向,むこう岸,ぎしに行,いくようにと弟子,でしたちにお命,めいじになった。","tok":[["イエス"],["は"],["、"],["群衆","ぐんしゅう"],["が"],["自分","じぶん"],["の"],["まわり"],["に"],["群らがって","むらがって"],["いる"],["の"],["を"],["見て","みて"],["、"],["向こう岸","むこうぎし"],["に"],["行く","いく"],["よう"],["に"],["と"],["弟子","でし"],["たち"],["に"],["お命じ","おめいじ"],["に"],["なった"],["。"]]},{"verse":19,"text":"するとひとりの律法,りっぽう学者,がくしゃが近,ちかづいてきて言,いった、「先生,せんせい、あなたがおいでになる所,ところなら、どこへでも従,したがってまいります」。","tok":[["する"],["と"],["ひとり"],["の"],["律法学者","りっぽうがくしゃ"],["が"],["近づいて","ちかづいて"],["きて"],["言った","いった"],["、"],["「"],["先生","せんせい"],["、"],["あなた"],["が"],["おいで"],["に"],["なる"],["所","ところ"],["なら"],["、"],["どこ"],["へ"],["で"],["も"],["従って","したがって"],["まいります"],["」"],["。"]]},{"verse":20,"text":"イエスはその人,ひとに言,いわれた、「きつねには穴,あながあり、空,そらの鳥,とりには巣,すがある。しかし、人,ひとの子,こにはまくらする所,ところがない」。","tok":[["イエス"],["は"],["その"],["人","ひと"],["に"],["言われた","いわれた"],["、"],["「"],["きつね"],["に"],["は"],["穴","あな"],["が"],["あり"],["、"],["空","そら"],["の"],["鳥","とり"],["に"],["は"],["巣","す"],["が"],["ある"],["。"],["しかし"],["、"],["人","ひと"],["の"],["子","こ"],["に"],["は"],["まくら"],["する"],["所","ところ"],["が"],["ない"],["」"],["。"]]},{"verse":21,"text":"また弟子,でしのひとりが言,いった、「主,しゅよ、まず、父,ちちを葬,ほうむりに行,いかせて下,ください」。","tok":[["また"],["弟子","でし"],["の"],["ひとり"],["が"],["言った","いった"],["、"],["「"],["主","しゅ"],["よ"],["、"],["まず"],["、"],["父","ちち"],["を"],["葬むり","ほうむり"],["に"],["行かせて","いかせて"],["下さい","ください"],["」"],["。"]]},{"verse":22,"text":"イエスは彼,かれに言,いわれた、「わたしに従,したがってきなさい。そして、その死人,しにんを葬,ほうむることは、死人,しにんに任,まかせておくがよい」。","tok":[["イエス"],["は"],["彼","かれ"],["に"],["言われた","いわれた"],["、"],["「"],["わたし"],["に"],["従って","したがって"],["き"],["なさい"],["。"],["そして"],["、"],["その"],["死人","しにん"],["を"],["葬むる","ほうむる"],["こと"],["は"],["、"],["死人","しにん"],["に"],["任せて","まかせて"],["おく"],["が"],["よい"],["」"],["。"]]},{"verse":23,"text":"それから、イエスが舟,ふねに乗,のり込,こまれると、弟子,でしたちも従,したがった。","tok":[["それ"],["から"],["、"],["イエス"],["が"],["舟","ふね"],["に"],["乗込まれる","のりこまれる"],["と"],["、"],["弟子","でし"],["たち"],["も"],["従った","したがった"],["。"]]},{"verse":24,"text":"すると突然,とつぜん、海上,かいじょうに激,はげしい暴風,ぼうふうが起,おこって、舟,ふねは波,なみにのまれそうになった。ところが、イエスは眠,ねむっておられた。","tok":[["する"],["と"],["突然","とつぜん"],["、"],["海上","かいじょう"],["に"],["激しい","はげしい"],["暴風","ぼうふう"],["が"],["起こって","おこって"],["、"],["舟","ふね"],["は"],["波","なみ"],["に"],["のまれ"],["そう"],["に"],["なった"],["。"],["ところ"],["が"],["、"],["イエス"],["は"],["眠って","ねむって"],["おられた"],["。"]]},{"verse":25,"text":"そこで弟子,でしたちはみそばに寄,よってきてイエスを起,おこし、「主,しゅよ、お助,たすけください、わたしたちは死,しにそうです」と言,いった。","tok":[["そこ"],["で"],["弟子","でし"],["たち"],["は"],["みそば"],["に"],["寄って","よって"],["きて"],["イエス"],["を"],["起こし","おこし"],["、"],["「"],["主","しゅ"],["よ"],["、"],["お助け","おたすけ"],["ください"],["、"],["わたしたち"],["は"],["死に","しに"],["そう"],["です"],["」"],["と"],["言った","いった"],["。"]]},{"verse":26,"text":"するとイエスは彼,かれらに言,いわれた、「なぜこわがるのか、信仰,しんこうの薄,うすい者,ものたちよ」。それから起,おきあがって、風,かぜと海,うみとをおしかりになると、大,おおなぎになった。","tok":[["する"],["と"],["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["なぜ"],["こわ"],["がる"],["の"],["か"],["、"],["信仰","しんこう"],["の"],["薄い","うすい"],["者","もの"],["たち"],["よ"],["」"],["。"],["それ"],["から"],["起きあがって","おきあがって"],["、"],["風","かぜ"],["と"],["海","うみ"],["と"],["を"],["おしかり"],["に"],["なる"],["と"],["、"],["大なぎ","おおなぎ"],["に"],["なった"],["。"]]},{"verse":27,"text":"彼,かれらは驚,おどろいて言,いった、「このかたはどういう人,ひとなのだろう。風,かぜも海,うみも従,したがわせるとは」。","tok":[["彼","かれ"],["ら"],["は"],["驚ろいて","おどろいて"],["言った","いった"],["、"],["「"],["このかた"],["は"],["どういう"],["人","ひと"],["な"],["の"],["だろう"],["。"],["風","かぜ"],["も"],["海","うみ"],["も"],["従わせる","したがわせる"],["と"],["は"],["」"],["。"]]},{"verse":28,"text":"それから、向,むこう岸,ぎし、ガダラ人,びとの地,ちに着,つかれると、悪霊,あくれいにつかれたふたりの者,ものが、墓場,はかばから出,でてきてイエスに出会,であった。彼,かれらは手,てに負,おえない乱暴,らんぼう者,もので、だれもその辺,へんの道,みちを通,とおることができないほどであった。","tok":[["それ"],["から"],["、"],["向こう岸","むこうぎし"],["、"],["ガダラ人","がだらびと"],["の"],["地","ち"],["に"],["着かれる","つかれる"],["と"],["、"],["悪霊","あくれい"],["に"],["つかれた"],["ふたり"],["の"],["者","もの"],["が"],["、"],["墓場","はかば"],["から"],["出て","でて"],["きて"],["イエス"],["に"],["出会った","であった"],["。"],["彼","かれ"],["ら"],["は"],["手","て"],["に"],["負えない","おえない"],["乱暴者","らんぼうもの"],["で"],["、"],["だれ"],["も"],["その"],["辺","へん"],["の"],["道","みち"],["を"],["通る","とおる"],["こと"],["が"],["できない"],["ほど"],["で"],["あった"],["。"]]},{"verse":29,"text":"すると突然,とつぜん、彼,かれらは叫,さけんで言,いった、「神,かみの子,こよ、あなたはわたしどもとなんの係,かかわりがあるのです。まだその時,ときではないのに、ここにきて、わたしどもを苦,くるしめるのですか」。","tok":[["する"],["と"],["突然","とつぜん"],["、"],["彼","かれ"],["ら"],["は"],["叫けんで","さけんで"],["言った","いった"],["、"],["「"],["神","かみ"],["の"],["子","こ"],["よ"],["、"],["あなた"],["は"],["わたし"],["ども"],["と"],["なん"],["の"],["係わり","かかわり"],["が"],["ある"],["の"],["です"],["。"],["まだ"],["その"],["時","とき"],["で"],["は"],["ない"],["のに"],["、"],["ここ"],["に"],["きて"],["、"],["わたし"],["ども"],["を"],["苦しめる","くるしめる"],["の"],["です"],["か"],["」"],["。"]]},{"verse":30,"text":"さて、そこからはるか離,はなれた所,ところに、おびただしい豚,ぶたの群,むれが飼,かってあった。","tok":[["さて"],["、"],["そこ"],["から"],["はるか"],["離れた","はなれた"],["所","ところ"],["に"],["、"],["おびただしい"],["豚","ぶた"],["の"],["群れ","むれ"],["が"],["飼って","かって"],["あった"],["。"]]},{"verse":31,"text":"悪霊,あくれいどもはイエスに願,ねがって言,いった、「もしわたしどもを追,おい出,だされるのなら、あの豚,ぶたの群,むれの中,なかにつかわして下,ください」。","tok":[["悪霊","あくれいど"],["も"],["は"],["イエス"],["に"],["願って","ねがって"],["言った","いった"],["、"],["「"],["もし"],["わたし"],["ども"],["を"],["追い出される","おいだされる"],["の"],["なら"],["、"],["あの"],["豚","ぶた"],["の"],["群れ","むれ"],["の"],["中","なか"],["に"],["つかわして"],["下さい","ください"],["」"],["。"]]},{"verse":32,"text":"そこで、イエスが「行,いけ」と言,いわれると、彼,かれらは出,でて行,いって、豚,ぶたの中,なかへはいり込,こんだ。すると、その群,むれ全体,ぜんたいが、がけから海,うみへなだれを打,うって駆,かけ下,くだり、水,みずの中,なかで死,しんでしまった。","tok":[["そこ"],["で"],["、"],["イエス"],["が"],["「"],["行け","いけ"],["」"],["と"],["言われる","いわれる"],["と"],["、"],["彼","かれ"],["ら"],["は"],["出て","でて"],["行って","いって"],["、"],["豚","ぶた"],["の"],["中","なか"],["へ"],["はいり込んだ","はいりこんだ"],["。"],["する"],["と"],["、"],["その"],["群れ","むれ"],["全体","ぜんたい"],["が"],["、"],["がけ"],["から"],["海","うみ"],["へ"],["なだれ"],["を"],["打って","うって"],["駆け下り","かけくだり"],["、"],["水","みず"],["の"],["中","なか"],["で"],["死んで","しんで"],["しまった"],["。"]]},{"verse":33,"text":"飼,かう者,ものたちは逃,にげて町,まちに行,いき、悪霊,あくれいにつかれた者,ものたちのことなど、いっさいを知,しらせた。","tok":[["飼う","かう"],["者","もの"],["たち"],["は"],["逃て","にげて"],["町","まち"],["に"],["行き","いき"],["、"],["悪霊","あくれい"],["に"],["つかれた"],["者","もの"],["たち"],["の"],["こと"],["など"],["、"],["いっさい"],["を"],["知らせた","しらせた"],["。"]]},{"verse":34,"text":"すると、町中,まちじゅうの者,ものがイエスに会,あいに出,でてきた。そして、イエスに会,あうと、この地方,ちほうから去,さってくださるようにと頼,たのんだ。","tok":[["する"],["と"],["、"],["町中","まちじゅう"],["の"],["者","もの"],["が"],["イエス"],["に"],["会い","あい"],["に"],["出て","でて"],["きた"],["。"],["そして"],["、"],["イエス"],["に"],["会う","あう"],["と"],["、"],["この"],["地方","ちほう"],["から"],["去て","さって"],["くださる"],["よう"],["に"],["と"],["頼んだ","たのんだ"],["。"]]}]
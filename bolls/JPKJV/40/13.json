[{"verse":1,"text":"その日,ひ、イエスは家,いえを出,でて、海,うみべにすわっておられた。","tok":[["その"],["日","ひ"],["、"],["イエス"],["は"],["家","いえ"],["を"],["出て","でて"],["、"],["海べ","うみべ"],["に"],["すわって"],["おられた"],["。"]]},{"verse":2,"text":"ところが、大,おおぜいの群衆,ぐんしゅうがみもとに集,あつまったので、イエスは舟,ふねに乗,のってすわられ、群衆,ぐんしゅうはみな岸,きしに立,たっていた。","tok":[["ところ"],["が"],["、"],["大ぜい","おおぜい"],["の"],["群衆","ぐんしゅう"],["が"],["みもと"],["に"],["集まった","あつまった"],["ので"],["、"],["イエス"],["は"],["舟","ふね"],["に"],["乗って","のって"],["すわられ"],["、"],["群衆","ぐんしゅう"],["は"],["みな岸","みなきし"],["に"],["立って","たって"],["いた"],["。"]]},{"verse":3,"text":"イエスは譬,たとえで多,おおくの事,ことを語,かたり、こう言,いわれた、「見,みよ、種,たねまきが種,たねをまきに出,でて行,いった。","tok":[["イエス"],["は"],["譬","たとえ"],["で"],["多く","おおく"],["の"],["事","こと"],["を"],["語り","かたり"],["、"],["こう"],["言われた","いわれた"],["、"],["「"],["見よ","みよ"],["、"],["種まき","たねまき"],["が"],["種","たね"],["を"],["まき"],["に"],["出て","でて"],["行った","いった"],["。"]]},{"verse":4,"text":"まいているうちに、道,みちばたに落,おちた種,たねがあった。すると、鳥,とりがきて食,たべてしまった。","tok":[["ま"],["いて"],["いる"],["うち"],["に"],["、"],["道ばた","みちばた"],["に"],["落","おち"],["た"],["種","たね"],["が"],["あった"],["。"],["する"],["と"],["、"],["鳥","とり"],["が"],["きて"],["食べて","たべて"],["しまった"],["。"]]},{"verse":5,"text":"ほかの種,たねは土,つちの薄,うすい石地,いしじに落,おちた。そこは土,つちが深,ふかくないので、すぐ芽,めを出,だしたが、","tok":[["ほか"],["の"],["種","たね"],["は"],["土","つち"],["の"],["薄い","うすい"],["石地","いしじ"],["に"],["落","おち"],["た"],["。"],["そこ"],["は"],["土","つち"],["が"],["深く","ふかく"],["ない"],["ので"],["、"],["すぐ"],["芽","め"],["を"],["出した","だした"],["が"],["、"]]},{"verse":6,"text":"日,ひが上,のぼると焼,やけて、根,ねがないために枯,かれてしまった。","tok":[["日","ひ"],["が"],["上る","のぼる"],["と"],["焼","やけ"],["て"],["、"],["根","ね"],["が"],["ない"],["ため"],["に"],["枯て","かれて"],["しまった"],["。"]]},{"verse":7,"text":"ほかの種,たねはいばらの地,ちに落,おちた。すると、いばらが伸,のびて、ふさいでしまった。","tok":[["ほか"],["の"],["種","たね"],["は"],["いばら"],["の"],["地","ち"],["に"],["落","おち"],["た"],["。"],["する"],["と"],["、"],["いばら"],["が"],["伸びて","のびて"],["、"],["ふさいで"],["しまった"],["。"]]},{"verse":8,"text":"ほかの種,たねは良,よい地,ちに落,おちて実,みを結,むすび、あるものは百倍,ばい、あるものは六十倍,ばい、あるものは三十倍,ばいにもなった。","tok":[["ほか"],["の"],["種","たね"],["は"],["良い","よい"],["地","ち"],["に"],["落","おち"],["て"],["実","み"],["を"],["結び","むすび"],["、"],["ある"],["もの"],["は"],["百","ひゃく"],["倍","ばい"],["い"],["、"],["ある"],["もの"],["は"],["六十","ろくじゅう"],["倍","ばい"],["い"],["、"],["ある"],["もの"],["は"],["三十","さんじゅう"],["倍","ばい"],["に"],["も"],["なった"],["。"]]},{"verse":9,"text":"耳,みみのある者,ものは聞,きくがよい」。","tok":[["耳","みみ"],["の"],["ある"],["者","もの"],["は"],["聞く","きく"],["が"],["よい"],["」"],["。"]]},{"verse":10,"text":"それから、弟子,でしたちがイエスに近寄,ちかよってきて言,いった、「なぜ、彼,かれらに譬,たとえでお話,はなしになるのですか」。","tok":[["それ"],["から"],["、"],["弟子","でし"],["たち"],["が"],["イエス"],["に"],["近寄って","ちかよって"],["きて"],["言った","いった"],["、"],["「"],["なぜ"],["、"],["彼","かれ"],["ら"],["に"],["譬","たとえ"],["で"],["お話","おはなし"],["に"],["なる"],["の"],["です"],["か"],["」"],["。"]]},{"verse":11,"text":"そこでイエスは答,こたえて言,いわれた、「あなたがたには、天国,てんごくの奥義,おくぎを知,しることが許,ゆるされているが、彼,かれらには許,ゆるされていない。","tok":[["そこ"],["で"],["イエス"],["は"],["答","こたえ"],["て"],["言われた","いわれた"],["、"],["「"],["あなた"],["がた"],["に"],["は"],["、"],["天国","てんごく"],["の"],["奥義","おくぎ"],["を"],["知る","しる"],["こと"],["が"],["許されて","ゆるされて"],["いる"],["が"],["、"],["彼","かれ"],["ら"],["に"],["は"],["許されて","ゆるされて"],["いない"],["。"]]},{"verse":12,"text":"おおよそ、持,もっている人,ひとは与,あたえられて、いよいよ豊,ゆたかになるが、持,もっていない人,ひとは、持,もっているものまでも取,とり上,あげられるであろう。","tok":[["おおよそ"],["、"],["持て","もって"],["いる"],["人","ひと"],["は"],["与えられて","あたえられて"],["、"],["いよいよ"],["豊","ゆたか"],["に"],["なる"],["が"],["、"],["持て","もって"],["いない"],["人","ひと"],["は"],["、"],["持て","もって"],["いる"],["もの"],["まで"],["も"],["取上げられるで","とりあげられるで"],["あろう"],["。"]]},{"verse":13,"text":"だから、彼,かれらには譬,たとえで語,かたるのである。それは彼,かれらが、見,みても見,みず、聞,きいても聞,きかず、また悟,さとらないからである。","tok":[["だ"],["から"],["、"],["彼","かれ"],["ら"],["に"],["は"],["譬","たとえ"],["で"],["語る","かたる"],["ので"],["ある"],["。"],["それ"],["は"],["彼","かれ"],["ら"],["が"],["、"],["見て","みて"],["も"],["見ず","みず"],["、"],["聞いて","きいて"],["も"],["聞かず","きかず"],["、"],["また"],["悟らない","さとらない"],["から"],["で"],["ある"],["。"]]},{"verse":14,"text":"こうしてイザヤの言,いった預言,よげんが、彼,かれらの上,うえに成就,じょうじゅしたのである。『あなたがたは聞,きくには聞,きくが、決,けっして悟,さとらない。見,みるには見,みるが、決,けっして認,みとめない。","tok":[["こう"],["して"],["イザヤ"],["の"],["言った","いった"],["預言","よげん"],["が"],["、"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["成就","じょうじゅ"],["した"],["ので"],["ある"],["。"],["『"],["あなた"],["がた"],["は"],["聞く","きく"],["に"],["は"],["聞く","きく"],["が"],["、"],["決っして","けっして"],["悟らない","さとらない"],["。"],["見る","みる"],["に"],["は"],["見る","みる"],["が"],["、"],["決っして","けっして"],["認めない","みとめない"],["。"]]},{"verse":15,"text":"この民,たみの心,こころは鈍,にぶくなり、その耳,みみは聞,きこえにくく、その目,めは閉,とじている。それは、彼,かれらが目,めで見,みず、耳,みみで聞,きかず、心,こころで悟,さとらず、悔,くい改,あらためていやされることがないためである』。","tok":[["この"],["民","たみ"],["の"],["心","こころ"],["は"],["鈍く","にぶく"],["なり"],["、"],["その"],["耳","みみ"],["は"],["聞こえ","きこえ"],["にくく"],["、"],["その"],["目","め"],["は"],["閉じて","とじて"],["いる"],["。"],["それ"],["は"],["、"],["彼","かれ"],["ら"],["が"],["目","め"],["で"],["見ず","みず"],["、"],["耳","みみ"],["で"],["聞かず","きかず"],["、"],["心","こころ"],["で"],["悟らず","さとらず"],["、"],["悔い","くい"],["改","あらため"],["て"],["いやされる"],["こと"],["が"],["ない"],["ため"],["で"],["ある"],["』"],["。"]]},{"verse":16,"text":"しかし、あなたがたの目,めは見,みており、耳,みみは聞,きいているから、さいわいである。","tok":[["しかし"],["、"],["あなた"],["がた"],["の"],["目","め"],["は"],["見て","みて"],["おり"],["、"],["耳","みみ"],["は"],["聞いて","きいて"],["いる"],["から"],["、"],["さいわい"],["で"],["ある"],["。"]]},{"verse":17,"text":"あなたがたによく言,いっておく。多,おおくの預言者,よげんしゃや義人,ぎじんは、あなたがたの見,みていることを見,みようと熱心,ねっしんに願,ねがったが、見,みることができず、またあなたがたの聞,きいていることを聞,きこうとしたが、聞,きけなかったのである。","tok":[["あなた"],["がた"],["に"],["よく"],["言って","いって"],["おく"],["。"],["多く","おおく"],["の"],["預言者","よげんしゃ"],["や"],["義人","ぎじん"],["は"],["、"],["あなた"],["がた"],["の"],["見て","みて"],["いる"],["こと"],["を"],["見よう","みよう"],["と"],["熱心","ねっしん"],["に"],["願った","ねがった"],["が"],["、"],["見る","みる"],["こと"],["が"],["できず"],["、"],["また"],["あなた"],["がた"],["の"],["聞いて","きいて"],["いる"],["こと"],["を"],["聞こう","きこう"],["と"],["した"],["が"],["、"],["聞けなかった","きけなかった"],["ので"],["ある"],["。"]]},{"verse":18,"text":"そこで、種,たねまきの譬,たとえを聞,ききなさい。","tok":[["そこ"],["で"],["、"],["種まき","たねまき"],["の"],["譬","たとえ"],["を"],["聞","きき"],["なさい"],["。"]]},{"verse":19,"text":"だれでも御国,みくにの言,ことばを聞,きいて悟,さとらないならば、悪,わるい者,ものがきて、その人,ひとの心,こころにまかれたものを奪,うばいとって行,いく。道,みちばたにまかれたものというのは、そういう人,ひとのことである。","tok":[["だれ"],["で"],["も"],["御国","みくに"],["の"],["言","ことば"],["を"],["聞いて","きいて"],["悟らないならば","さとらないならば"],["、"],["悪い","わるい"],["者","もの"],["が"],["きて"],["、"],["その"],["人","ひと"],["の"],["心","こころ"],["に"],["まかれた"],["もの"],["を"],["奪いとって","うばいとって"],["行く","いく"],["。"],["道ばた","みちばた"],["に"],["まかれた"],["もの"],["と"],["いう"],["の"],["は"],["、"],["そう"],["いう"],["人","ひと"],["の"],["こと"],["で"],["ある"],["。"]]},{"verse":20,"text":"石地,いしじにまかれたものというのは、御言,みことばを聞,きくと、すぐに喜,よろこんで受,うける人,ひとのことである。","tok":[["石地","いしじ"],["に"],["まかれた"],["もの"],["と"],["いう"],["の"],["は"],["、"],["御言","みこと"],["ば"],["を"],["聞く","きく"],["と"],["、"],["すぐ"],["に"],["喜こんで","よろこんで"],["受ける","うける"],["人","ひと"],["の"],["こと"],["で"],["ある"],["。"]]},{"verse":21,"text":"その中,なかに根,ねがないので、しばらく続,つづくだけであって、御言,みことばのために困難,こんなんや迫害,はくがいが起,おこってくると、すぐつまずいてしまう。","tok":[["その"],["中","なか"],["に"],["根","ね"],["が"],["ない"],["ので"],["、"],["しばらく"],["続","つづく"],["だけ"],["で"],["あって"],["、"],["御言","みこと"],["ば"],["の"],["ため"],["に"],["困難","こんなん"],["や"],["迫害","はくがい"],["が"],["起こって","おこって"],["くる"],["と"],["、"],["すぐ"],["つまずいて"],["しまう"],["。"]]},{"verse":22,"text":"また、いばらの中,なかにまかれたものとは、御言,みことばを聞,きくが、世,よの心,こころづかいと富,とみの惑,まどわしとが御言,みことばをふさぐので、実,みを結,むすばなくなる人,ひとのことである。","tok":[["また"],["、"],["いばら"],["の"],["中","なか"],["に"],["まかれた"],["もの"],["と"],["は"],["、"],["御言","みこと"],["ば"],["を"],["聞く","きく"],["が"],["、"],["世","よ"],["の"],["心づかい","こころづかい"],["と"],["富","とみ"],["の"],["惑わし","まどわし"],["と"],["が"],["御言","みこと"],["ば"],["を"],["ふさぐ"],["ので"],["、"],["実","み"],["を"],["結ばなく","むすばなく"],["なる"],["人","ひと"],["の"],["こと"],["で"],["ある"],["。"]]},{"verse":23,"text":"また、良,よい地,ちにまかれたものとは、御言,みことばを聞,きいて悟,さとる人,ひとのことであって、そういう人,ひとが実,みを結,むすび、百倍,ばい、あるいは六十倍,ばい、あるいは三十倍,ばいにもなるのである」。","tok":[["また"],["、"],["良い","よい"],["地","ち"],["に"],["まかれた"],["もの"],["と"],["は"],["、"],["御言","みこと"],["ば"],["を"],["聞いて","きいて"],["悟人","さとるひと"],["の"],["こと"],["で"],["あって"],["、"],["そう"],["いう"],["人","ひと"],["が"],["実","み"],["を"],["結び","むすび"],["、"],["百","ひゃく"],["倍","ばい"],["い"],["、"],["あるいは"],["六十","ろくじゅう"],["倍","ばい"],["い"],["、"],["あるいは"],["三十","さんじゅう"],["倍","ばい"],["に"],["も"],["なる"],["ので"],["ある"],["」"],["。"]]},{"verse":24,"text":"また、ほかの譬,たとえを彼,かれらに示,しめして言,いわれた、「天国,てんごくは、良,よい種,たねを自分,じぶんの畑,はたけにまいておいた人,ひとのようなものである。","tok":[["また"],["、"],["ほか"],["の"],["譬","たとえ"],["を"],["彼","かれ"],["ら"],["に"],["示めして","しめして"],["言われた","いわれた"],["、"],["「"],["天国","てんごく"],["は"],["、"],["良い","よい"],["種","たね"],["を"],["自分","じぶん"],["の"],["畑","はたけ"],["に"],["まいて"],["おいた"],["人","ひと"],["の"],["よう"],["な"],["もの"],["で"],["ある"],["。"]]},{"verse":25,"text":"人々,ひとびとが眠,ねむっている間,あいだに敵,てきがきて、麦,むぎの中,なかに毒,どく麦,むぎをまいて立,たち去,さった。","tok":[["人々","ひとびと"],["が"],["眠って","ねむって"],["いる"],["間","あいだ"],["に"],["敵","てき"],["が"],["きて"],["、"],["麦","むぎ"],["の"],["中","なか"],["に"],["毒麦","どくむぎ"],["を"],["まいて"],["立ち","たち"],["去た","さった"],["。"]]},{"verse":26,"text":"芽,めがはえ出,でて実,みを結,むすぶと、同時,どうじに毒,どく麦,むぎもあらわれてきた。","tok":[["芽","め"],["が"],["は"],["え"],["出て","でて"],["実","み"],["を"],["結ぶ","むすぶ"],["と"],["、"],["同時","どうじ"],["に"],["毒麦","どくむぎ"],["も"],["あらわれて"],["きた"],["。"]]},{"verse":27,"text":"僕,しもべたちがきて、家,いえの主人,しゅじんに言,いった、『ご主人様,しゅじんさま、畑,はたけにおまきになったのは、良,よい種,たねではありませんでしたか。どうして毒,どく麦,むぎがはえてきたのですか』。","tok":[["僕","し"],["も"],["べ"],["たち"],["が"],["きて"],["、"],["家","いえ"],["の"],["主人","しゅじん"],["に"],["言った","いった"],["、"],["『"],["ご主人様","ごしゅじんさま"],["、"],["畑","はたけ"],["に"],["おまき"],["に"],["なった"],["の"],["は"],["、"],["良い","よい"],["種","たね"],["で"],["は"],["ありませんでした"],["か"],["。"],["どう"],["して"],["毒麦","どくむぎ"],["が"],["はえて"],["きた"],["の"],["です"],["か"],["』"],["。"]]},{"verse":28,"text":"主人,しゅじんは言,いった、『それは敵,てきのしわざだ』。すると僕,しもべたちが言,いった『では行,いって、それを抜,ぬき集,あつめましょうか』。","tok":[["主人","しゅじん"],["は"],["言った","いった"],["、"],["『"],["それ"],["は"],["敵","てき"],["の"],["しわざ"],["だ"],["』"],["。"],["する"],["と"],["僕","し"],["も"],["べ"],["たち"],["が"],["言った","いった"],["『"],["で"],["は"],["行って","いって"],["、"],["それ"],["を"],["抜き集めましょう","ぬきあつめましょう"],["か"],["』"],["。"]]},{"verse":29,"text":"彼,かれは言,いった、『いや、毒,どく麦,むぎを集,あつめようとして、麦,むぎも一緒,いっしょに抜,ぬくかも知,しれない。","tok":[["彼","かれ"],["は"],["言った","いった"],["、"],["『"],["いや"],["、"],["毒麦","どくむぎ"],["を"],["集めよう","あつめよう"],["として"],["、"],["麦","むぎ"],["も"],["一緒","いっしょ"],["に"],["抜く","ぬく"],["か"],["も"],["知れない","しれない"],["。"]]},{"verse":30,"text":"収穫,しゅうかくまで、両方,りょうほうとも育,そだつままにしておけ。収穫,しゅうかくの時,ときになったら、刈,かる者,ものに、まず毒,どく麦,むぎを集,あつめて束,たばにして焼,やき、麦,むぎの方,ほうは集,あつめて倉,くらに入,いれてくれ、と言,いいつけよう』」。","tok":[["収穫","しゅうかく"],["まで"],["、"],["両方","りょうほう"],["と"],["も"],["育つ","そだつ"],["まま"],["に"],["して"],["おけ"],["。"],["収穫","しゅうかく"],["の"],["時","とき"],["に"],["なったら"],["、"],["刈る","かる"],["者","もの"],["に"],["、"],["まず"],["毒麦","どくむぎ"],["を"],["集めて","あつめて"],["束","たば"],["に"],["して"],["焼き","やき"],["、"],["麦","むぎ"],["の"],["方","ほう"],["は"],["集めて","あつめて"],["倉","くら"],["に"],["入れて","いれて"],["くれ"],["、"],["と"],["言いつけよう","いいつけよう"],["』"],["」"],["。"]]},{"verse":31,"text":"また、ほかの譬,たとえを彼,かれらに示,しめして言,いわれた、「天国,てんごくは、一粒,つぶのからし種,だねのようなものである。ある人,ひとがそれをとって畑,はたけにまくと、","tok":[["また"],["、"],["ほか"],["の"],["譬","たとえ"],["を"],["彼","かれ"],["ら"],["に"],["示めして","しめして"],["言われた","いわれた"],["、"],["「"],["天国","てんごく"],["は"],["、"],["一","いち"],["粒","つぶ"],["の"],["からし"],["種","だね"],["の"],["よう"],["な"],["もの"],["で"],["ある"],["。"],["ある"],["人","ひと"],["が"],["それ"],["を"],["とって"],["畑","はたけ"],["に"],["まく"],["と"],["、"]]},{"verse":32,"text":"それはどんな種,たねよりも小,ちいさいが、成長,せいちょうすると、野菜,やさいの中,なかでいちばん大,おおきくなり、空,そらの鳥,とりがきて、その枝,えだに宿,やどるほどの木,きになる」。","tok":[["それ"],["は"],["どんな"],["種","たね"],["より"],["も"],["小さい","ちいさい"],["が"],["、"],["成長","せいちょう"],["する"],["と"],["、"],["野菜","やさい"],["の"],["中","なか"],["で"],["いちばん"],["大きく","おおきく"],["なり"],["、"],["空","そら"],["の"],["鳥","とり"],["が"],["きて"],["、"],["その"],["枝","えだ"],["に"],["宿る","やどる"],["ほど"],["の"],["木","き"],["に"],["なる"],["」"],["。"]]},{"verse":33,"text":"またほかの譬,たとえを彼,かれらに語,かたられた、「天国,てんごくは、パン種,たねのようなものである。女,おんながそれを取,とって三斗,との粉,こなの中,なかに混,まぜると、全体,ぜんたいがふくらんでくる」。","tok":[["また"],["ほか"],["の"],["譬","たとえ"],["を"],["彼","かれ"],["ら"],["に"],["語られた","かたられた"],["、"],["「"],["天国","てんごく"],["は"],["、"],["パン種","ぱんたね"],["の"],["よう"],["な"],["もの"],["で"],["ある"],["。"],["女","おんな"],["が"],["それ"],["を"],["取って","とって"],["三","さん"],["斗","と"],["の"],["粉","こな"],["の"],["中","なか"],["に"],["混ぜる","まぜる"],["と"],["、"],["全体","ぜんたい"],["が"],["ふくらんで"],["くる"],["」"],["。"]]},{"verse":34,"text":"イエスはこれらのことをすべて、譬,たとえで群衆,ぐんしゅうに語,かたられた。譬,たとえによらないでは何事,なにごとも彼,かれらに語,かたられなかった。","tok":[["イエス"],["は"],["これ"],["ら"],["の"],["こと"],["を"],["すべて"],["、"],["譬","たとえ"],["で"],["群衆","ぐんしゅう"],["に"],["語られた","かたられた"],["。"],["譬","たとえ"],["に"],["よらないで"],["は"],["何事","なにごと"],["も"],["彼","かれ"],["ら"],["に"],["語られなかった","かたられなかった"],["。"]]},{"verse":35,"text":"これは預言者,よげんしゃによって言,いわれたことが、成就,じょうじゅするためである、「わたしは口,くちを開,ひらいて譬,たとえを語,かたり、世,よの初,はじめから隠,かくされていることを語,かたり出,だそう」。","tok":[["これ"],["は"],["預言者","よげんしゃ"],["によって"],["言われた","いわれた"],["こと"],["が"],["、"],["成就","じょうじゅ"],["する"],["ため"],["で"],["ある"],["、"],["「"],["わたし"],["は"],["口","くち"],["を"],["開らいて","ひらいて"],["譬","たとえ"],["を"],["語り","かたり"],["、"],["世","よ"],["の"],["初め","はじめ"],["から"],["隠されて","かくされて"],["いる"],["こと"],["を"],["語り出","かたりだ"],["そう"],["」"],["。"]]},{"verse":36,"text":"それからイエスは、群衆,ぐんしゅうをあとに残,のこして家,いえにはいられた。すると弟子,でしたちは、みもとにきて言,いった、「畑,はたけの毒,どく麦,むぎの譬,たとえを説明,せつめいしてください」。","tok":[["それ"],["から"],["イエス"],["は"],["、"],["群衆","ぐんしゅう"],["を"],["あと"],["に"],["残して","のこして"],["家","いえ"],["に"],["は"],["いられた"],["。"],["する"],["と"],["弟子","でし"],["たち"],["は"],["、"],["みもと"],["に"],["きて"],["言った","いった"],["、"],["「"],["畑","はたけ"],["の"],["毒麦","どくむぎ"],["の"],["譬","たとえ"],["を"],["説明","せつめい"],["して"],["ください"],["」"],["。"]]},{"verse":37,"text":"イエスは答,こたえて言,いわれた、「良,よい種,たねをまく者,ものは、人,ひとの子,こである。","tok":[["イエス"],["は"],["答","こたえ"],["て"],["言われた","いわれた"],["、"],["「"],["良い","よい"],["種","たね"],["を"],["まく"],["者","もの"],["は"],["、"],["人","ひと"],["の"],["子","こ"],["で"],["ある"],["。"]]},{"verse":38,"text":"畑,はたけは世界,せかいである。良,よい種,たねと言,いうのは御国,みくにの子,こたちで、毒,どく麦,むぎは悪,わるい者,ものの子,こたちである。","tok":[["畑","はたけ"],["は"],["世界","せかい"],["で"],["ある"],["。"],["良い","よい"],["種","たね"],["と"],["言う","いう"],["の"],["は"],["御国","みくに"],["の"],["子","こ"],["たち"],["で"],["、"],["毒麦","どくむぎ"],["は"],["悪い","わるい"],["者","もの"],["の"],["子","こ"],["たち"],["で"],["ある"],["。"]]},{"verse":39,"text":"それをまいた敵,てきは悪魔,あくまである。収穫,しゅうかくとは世,よの終,おわりのことで、刈,かる者,ものは御使,みつかいたちである。","tok":[["それ"],["を"],["まいた"],["敵","てき"],["は"],["悪魔","あくま"],["で"],["ある"],["。"],["収穫","しゅうかく"],["と"],["は"],["世","よ"],["の"],["終","おわり"],["の"],["こと"],["で"],["、"],["刈る","かる"],["者","もの"],["は"],["御使","みつかい"],["たち"],["で"],["ある"],["。"]]},{"verse":40,"text":"だから、毒,どく麦,むぎが集,あつめられて火,ひで焼,やかれるように、世,よの終,おわりにもそのとおりになるであろう。","tok":[["だ"],["から"],["、"],["毒麦","どくむぎ"],["が"],["集められて","あつめられて"],["火","ひ"],["で"],["焼かれる","やかれる"],["よう"],["に"],["、"],["世","よ"],["の"],["終わり","おわり"],["に"],["も"],["その"],["とおり"],["に"],["なるで"],["あろう"],["。"]]},{"verse":41,"text":"人,ひとの子,こはその使,つかいたちをつかわし、つまずきとなるものと不法,ふほうを行,おこなう者,ものとを、ことごとく御国,みくにからとり集,あつめて、","tok":[["人","ひと"],["の"],["子","こ"],["は"],["その"],["使","つかい"],["たち"],["を"],["つかわし"],["、"],["つまずき"],["と"],["なる"],["もの"],["と"],["不法","ふほう"],["を"],["行なう","おこなう"],["者","もの"],["と"],["を"],["、"],["ことごとく"],["御国","みくに"],["から"],["とり集めて","とりあつめて"],["、"]]},{"verse":42,"text":"炉,ろの火,ひに投,なげ入,いれさせるであろう。そこでは泣,なき叫,さけんだり、歯,はがみをしたりするであろう。","tok":[["炉","ろ"],["の"],["火","ひ"],["に"],["投入れ","なげいれ"],["させるで"],["あろう"],["。"],["そこ"],["で"],["は"],["泣","なき"],["叫けん","さけん"],["だり"],["、"],["歯がみ","はがみ"],["を"],["し"],["たり"],["するで"],["あろう"],["。"]]},{"verse":43,"text":"そのとき、義人,ぎじんたちは彼,かれらの父,ちちの御国,みくにで、太陽,たいようのように輝,かがやきわたるであろう。耳,みみのある者,ものは聞,きくがよい。","tok":[["その"],["とき"],["、"],["義人","ぎじん"],["たち"],["は"],["彼","かれ"],["ら"],["の"],["父","ちち"],["の"],["御国","みくに"],["で"],["、"],["太陽","たいよう"],["の"],["よう"],["に"],["輝やき","かがやき"],["わたるで"],["あろう"],["。"],["耳","みみ"],["の"],["ある"],["者","もの"],["は"],["聞く","きく"],["が"],["よい"],["。"]]},{"verse":44,"text":"天国,てんごくは、畑,はたけに隠,かくしてある宝,たからのようなものである。人,ひとがそれを見,みつけると隠,かくしておき、喜,よろこびのあまり、行,いって持,もち物,ものをみな売,うりはらい、そしてその畑,はたけを買,かうのである。","tok":[["天国","てんごく"],["は"],["、"],["畑","はたけ"],["に"],["隠して","かくして"],["ある"],["宝","たから"],["の"],["よう"],["な"],["もの"],["で"],["ある"],["。"],["人","ひと"],["が"],["それ"],["を"],["見つける","みつける"],["と"],["隠して","かくして"],["おき"],["、"],["喜こび","よろこび"],["の"],["あまり"],["、"],["行って","いって"],["持物","もちもの"],["を"],["みな"],["売","うり"],["はらい"],["、"],["そして"],["その"],["畑","はたけ"],["を"],["買う","かう"],["ので"],["ある"],["。"]]},{"verse":45,"text":"また天国,てんごくは、良,よい真珠,しんじゅを捜,さがしている商人,しょうにんのようなものである。","tok":[["また"],["天国","てんごく"],["は"],["、"],["良い","よい"],["真珠","しんじゅ"],["を"],["捜して","さがして"],["いる"],["商人","しょうにん"],["の"],["よう"],["な"],["もの"],["で"],["ある"],["。"]]},{"verse":46,"text":"高価,こうかな真珠,しんじゅ一個,こを見,みいだすと、行,いって持,もち物,ものをみな売,うりはらい、そしてこれを買,かうのである。","tok":[["高価","こうか"],["な"],["真珠","しんじゅ"],["一個","こ"],["を"],["見いだす","みいだす"],["と"],["、"],["行って","いって"],["持物","もちもの"],["を"],["みな"],["売","うり"],["はらい"],["、"],["そして"],["これ"],["を"],["買う","かう"],["ので"],["ある"],["。"]]},{"verse":47,"text":"また天国,てんごくは、海,うみにおろして、あらゆる種類,しゅるいの魚,うおを囲,かこみいれる網,あみのようなものである。","tok":[["また"],["天国","てんごく"],["は"],["、"],["海","うみ"],["に"],["おろして"],["、"],["あらゆる"],["種類","しゅるい"],["の"],["魚","うお"],["を"],["囲み","かこみ"],["いれる"],["網","あみ"],["の"],["よう"],["な"],["もの"],["で"],["ある"],["。"]]},{"verse":48,"text":"それがいっぱいになると岸,きしに引,ひき上,あげ、そしてすわって、良,よいのを器,うつわに入,いれ、悪,わるいのを外,そとへ捨,すてるのである。","tok":[["それ"],["が"],["いっぱい"],["に"],["なる"],["と"],["岸","きし"],["に"],["引上げ","ひきあげ"],["、"],["そして"],["すわって"],["、"],["良い","よい"],["の"],["を"],["器","うつわ"],["に"],["入れ","いれ"],["、"],["悪い","わるい"],["の"],["を"],["外","そと"],["へ"],["捨てる","すてる"],["ので"],["ある"],["。"]]},{"verse":49,"text":"世,よの終,おわりにも、そのとおりになるであろう。すなわち、御使,みつかいたちがきて、義人,ぎじんのうちから悪人,あくにんをえり分,わけ、","tok":[["世","よ"],["の"],["終わり","おわり"],["に"],["も"],["、"],["その"],["とおり"],["に"],["なるで"],["あろう"],["。"],["すなわち"],["、"],["御使","みつかいたち"],["が"],["きて"],["、"],["義人","ぎじん"],["の"],["うち"],["から"],["悪人","あくにん"],["を"],["えり分け","えりわけ"],["、"]]},{"verse":50,"text":"そして炉,ろの火,ひに投,なげこむであろう。そこでは泣,なき叫,さけんだり、歯,はがみをしたりするであろう。","tok":[["そして"],["炉","ろ"],["の"],["火","ひ"],["に"],["投","なげ"],["こむで"],["あろう"],["。"],["そこ"],["で"],["は"],["泣","なき"],["叫けん","さけん"],["だり"],["、"],["歯がみ","はがみ"],["を"],["し"],["たり"],["するで"],["あろう"],["。"]]},{"verse":51,"text":"あなたがたは、これらのことが皆,みなわかったか」。彼,かれらは「わかりました」と答,こたえた。","tok":[["あなた"],["がた"],["は"],["、"],["これ"],["ら"],["の"],["こと"],["が"],["皆","みな"],["わかった"],["か"],["」"],["。"],["彼","かれ"],["ら"],["は"],["「"],["わかりました"],["」"],["と"],["答","こたえ"],["た"],["。"]]},{"verse":52,"text":"そこで、イエスは彼,かれらに言,いわれた、「それだから、天国,てんごくのことを学,まなんだ学者,がくしゃは、新,あたらしいものと古,ふるいものとを、その倉,くらから取,とり出,だす一家,いっかの主人,しゅじんのようなものである」。","tok":[["そこ"],["で"],["、"],["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["それ"],["だ"],["から"],["、"],["天国","てんごく"],["の"],["こと"],["を"],["学んだ","まなんだ"],["学者","がくしゃ"],["は"],["、"],["新らしい","あたらしい"],["もの"],["と"],["古い","ふるい"],["もの"],["と"],["を"],["、"],["その"],["倉","くら"],["から"],["取出す","とりだす"],["一家","いっか"],["の"],["主人","しゅじん"],["の"],["よう"],["な"],["もの"],["で"],["ある"],["」"],["。"]]},{"verse":53,"text":"イエスはこれらの譬,たとえを語,かたり終,おえてから、そこを立,たち去,さられた。","tok":[["イエス"],["は"],["これ"],["ら"],["の"],["譬","たとえ"],["を"],["語り","かたり"],["終えて","おえて"],["から"],["、"],["そこ"],["を"],["立ち去られた","たちさられた"],["。"]]},{"verse":54,"text":"そして郷里,きょうりに行,いき、会堂,かいどうで人々,ひとびとを教,おしえられたところ、彼,かれらは驚,おどろいて言,いった、「この人,ひとは、この知恵,ちえとこれらの力,ちからあるわざとを、どこで習,ならってきたのか。","tok":[["そして"],["郷里","きょうり"],["に"],["行き","いき"],["、"],["会堂","かいどう"],["で"],["人々","ひとびと"],["を"],["教えられた","おしえられた"],["ところ"],["、"],["彼","かれ"],["ら"],["は"],["驚ろいて","おどろいて"],["言った","いった"],["、"],["「"],["この"],["人","ひと"],["は"],["、"],["この"],["知恵","ちえ"],["と"],["これ"],["ら"],["の"],["力","ちから"],["ある"],["わざと"],["を"],["、"],["どこ"],["で"],["習らって","ならって"],["きた"],["の"],["か"],["。"]]},{"verse":55,"text":"この人,ひとは大工,だいくの子,こではないか。母,はははマリヤといい、兄弟,きょうだいたちは、ヤコブ、ヨセフ、シモン、ユダではないか。","tok":[["この"],["人","ひと"],["は"],["大工","だいく"],["の"],["子","こ"],["で"],["は"],["ない"],["か"],["。"],["母","はは"],["は"],["マリヤ"],["と"],["いい"],["、"],["兄弟","きょうだい"],["たち"],["は"],["、"],["ヤコブ"],["、"],["ヨセフ"],["、"],["シモン"],["、"],["ユダ"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":56,"text":"またその姉妹,しまいたちもみな、わたしたちと一緒,いっしょにいるではないか。こんな数々,かずかずのことを、いったい、どこで習,ならってきたのか」。","tok":[["また"],["その"],["姉妹","しまい"],["たち"],["も"],["みな"],["、"],["わたしたち"],["と"],["一緒","いっしょ"],["に"],["いるで"],["は"],["ない"],["か"],["。"],["こんな"],["数々","かずかず"],["の"],["こと"],["を"],["、"],["いったい"],["、"],["どこ"],["で"],["習らって","ならって"],["きた"],["の"],["か"],["」"],["。"]]},{"verse":57,"text":"こうして人々,ひとびとはイエスにつまずいた。しかし、イエスは言,いわれた、「預言者,よげんしゃは、自分,じぶんの郷里,きょうりや自分,じぶんの家,いえ以外,いがいでは、どこででも敬,うやまわれないことはない」。","tok":[["こう"],["して"],["人々","ひとびと"],["は"],["イエス"],["に"],["つまずいた"],["。"],["しかし"],["、"],["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["預言者","よげんしゃ"],["は"],["、"],["自分","じぶん"],["の"],["郷里","きょうり"],["や"],["自分","じぶん"],["の"],["家","いえ"],["以外","いがい"],["で"],["は"],["、"],["どこ"],["で"],["で"],["も"],["敬われない","うやまわれない"],["こと"],["は"],["ない"],["」"],["。"]]},{"verse":58,"text":"そして彼,かれらの不,ふ信仰,しんこうのゆえに、そこでは力,ちからあるわざを、あまりなさらなかった。","tok":[["そして"],["彼","かれ"],["ら"],["の"],["不","ふ"],["信仰","しんこう"],["の"],["ゆえ"],["に"],["、"],["そこ"],["で"],["は"],["力","ちから"],["ある"],["わざ"],["を"],["、"],["あまり"],["なさらなかった"],["。"]]}]
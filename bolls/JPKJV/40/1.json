[{"verse":1,"text":"アブラハムの子,こであるダビデの子,こ、イエス・キリストの系図,けいず。","tok":[["アブラハム"],["の"],["子","こ"],["で"],["ある"],["ダビデ"],["の"],["子","こ"],["、"],["イエス"],["・"],["キリスト"],["の"],["系図","けいず"],["。"]]},{"verse":2,"text":"アブラハムはイサクの父,ちちであり、イサクはヤコブの父,ちち、ヤコブはユダとその兄弟,きょうだいたちとの父,ちち、","tok":[["アブラハム"],["は"],["イサク"],["の"],["父","ちち"],["で"],["あり"],["、"],["イサク"],["は"],["ヤコブ"],["の"],["父","ちち"],["、"],["ヤコブ"],["は"],["ユダ"],["と"],["その"],["兄弟","きょうだい"],["たち"],["と"],["の"],["父","ちち"],["、"]]},{"verse":3,"text":"ユダはタマルによるパレスとザラとの父,ちち、パレスはエスロンの父,ちち、エスロンはアラムの父,ちち、","tok":[["ユダ"],["は"],["タマル"],["に"],["よる"],["パレス"],["と"],["ザラ"],["と"],["の"],["父","ちち"],["、"],["パレス"],["は"],["エスロン"],["の"],["父","ちち"],["、"],["エスロン"],["は"],["アラム"],["の"],["父","ちち"],["、"]]},{"verse":4,"text":"アラムはアミナダブの父,ちち、アミナダブはナアソンの父,ちち、ナアソンはサルモンの父,ちち、","tok":[["アラム"],["は"],["アミナダブ"],["の"],["父","ちち"],["、"],["アミナダブ"],["は"],["ナアソン"],["の"],["父","ちち"],["、"],["ナアソン"],["は"],["サルモン"],["の"],["父","ちち"],["、"]]},{"verse":5,"text":"サルモンはラハブによるボアズの父,ちち、ボアズはルツによるオベデの父,ちち、オベデはエッサイの父,ちち、","tok":[["サルモン"],["は"],["ラハブ"],["に"],["よる"],["ボアズ"],["の"],["父","ちち"],["、"],["ボアズ"],["は"],["ルツ"],["に"],["よる"],["オベデ"],["の"],["父","ちち"],["、"],["オベデ"],["は"],["エッサイ"],["の"],["父","ちち"],["、"]]},{"verse":6,"text":"エッサイはダビデ王,おうの父,ちちであった。ダビデはウリヤの妻,つまによるソロモンの父,ちちであり、","tok":[["エッサイ"],["は"],["ダビデ"],["王","おう"],["の"],["父","ちち"],["で"],["あった"],["。"],["ダビデ"],["は"],["ウリヤ"],["の"],["妻","つま"],["に"],["よる"],["ソロモン"],["の"],["父","ちち"],["で"],["あり"],["、"]]},{"verse":7,"text":"ソロモンはレハベアムの父,ちち、レハベアムはアビヤの父,ちち、アビヤはアサの父,ちち、","tok":[["ソロモン"],["は"],["レハベアム"],["の"],["父","ちち"],["、"],["レハベアム"],["は"],["アビヤ"],["の"],["父","ちち"],["、"],["アビヤ"],["は"],["アサ"],["の"],["父","ちち"],["、"]]},{"verse":8,"text":"アサはヨサパテの父,ちち、ヨサパテはヨラムの父,ちち、ヨラムはウジヤの父,ちち、","tok":[["アサ"],["は"],["ヨサパテ"],["の"],["父","ちち"],["、"],["ヨサパテ"],["は"],["ヨラム"],["の"],["父","ちち"],["、"],["ヨラム"],["は"],["ウジヤ"],["の"],["父","ちち"],["、"]]},{"verse":9,"text":"ウジヤはヨタムの父,ちち、ヨタムはアハズの父,ちち、アハズはヒゼキヤの父,ちち、","tok":[["ウジヤ"],["は"],["ヨタム"],["の"],["父","ちち"],["、"],["ヨタム"],["は"],["アハズ"],["の"],["父","ちち"],["、"],["アハズ"],["は"],["ヒゼキヤ"],["の"],["父","ちち"],["、"]]},{"verse":10,"text":"ヒゼキヤはマナセの父,ちち、マナセはアモンの父,ちち、アモンはヨシヤの父,ちち、","tok":[["ヒゼキヤ"],["は"],["マナセ"],["の"],["父","ちち"],["、"],["マナセ"],["は"],["アモン"],["の"],["父","ちち"],["、"],["アモン"],["は"],["ヨシヤ"],["の"],["父","ちち"],["、"]]},{"verse":11,"text":"ヨシヤはバビロンへ移,うつされたころ、エコニヤとその兄弟,きょうだいたちとの父,ちちとなった。","tok":[["ヨシヤ"],["は"],["バビロン"],["へ"],["移された","うつされた"],["ころ"],["、"],["エコニヤ"],["と"],["その"],["兄弟","きょうだい"],["たち"],["と"],["の"],["父","ちち"],["と"],["なった"],["。"]]},{"verse":12,"text":"バビロンへ移,うつされたのち、エコニヤはサラテルの父,ちちとなった。サラテルはゾロバベルの父,ちち、","tok":[["バビロン"],["へ"],["移された","うつされた"],["のち"],["、"],["エコニヤ"],["は"],["サラテル"],["の"],["父","ちち"],["と"],["なった"],["。"],["サラテル"],["は"],["ゾロバベル"],["の"],["父","ちち"],["、"]]},{"verse":13,"text":"ゾロバベルはアビウデの父,ちち、アビウデはエリヤキムの父,ちち、エリヤキムはアゾルの父,ちち、","tok":[["ゾロバベル"],["は"],["アビウデ"],["の"],["父","ちち"],["、"],["アビウデ"],["は"],["エリヤキム"],["の"],["父","ちち"],["、"],["エリヤキム"],["は"],["アゾル"],["の"],["父","ちち"],["、"]]},{"verse":14,"text":"アゾルはサドクの父,ちち、サドクはアキムの父,ちち、アキムはエリウデの父,ちち、","tok":[["アゾル"],["は"],["サドク"],["の"],["父","ちち"],["、"],["サドク"],["は"],["アキム"],["の"],["父","ちち"],["、"],["アキム"],["は"],["エリウデ"],["の"],["父","ちち"],["、"]]},{"verse":15,"text":"エリウデはエレアザルの父,ちち、エレアザルはマタンの父,ちち、マタンはヤコブの父,ちち、","tok":[["エリウデ"],["は"],["エレアザル"],["の"],["父","ちち"],["、"],["エレアザル"],["は"],["マタン"],["の"],["父","ちち"],["、"],["マタン"],["は"],["ヤコブ"],["の"],["父","ちち"],["、"]]},{"verse":16,"text":"ヤコブはマリヤの夫,おっとヨセフの父,ちちであった。このマリヤからキリストといわれるイエスがお生,うまれになった。","tok":[["ヤコブ"],["は"],["マリヤ"],["の"],["夫","おっと"],["ヨセフ"],["の"],["父","ちち"],["で"],["あった"],["。"],["この"],["マリヤ"],["から"],["キリスト"],["と"],["いわれる"],["イエス"],["が"],["お生まれ","おうまれ"],["に"],["なった"],["。"]]},{"verse":17,"text":"だから、アブラハムからダビデまでの代,だいは合,あわせて十四代,だい、ダビデからバビロンへ移,うつされるまでは十四代,だい、そして、バビロンへ移,うつされてからキリストまでは十四代,だいである。","tok":[["だ"],["から"],["、"],["アブラハム"],["から"],["ダビデ"],["まで"],["の"],["代","だい"],["は"],["合","あわせ"],["て"],["十四","じゅうよん"],["代","だい"],["い"],["、"],["ダビデ"],["から"],["バビロン"],["へ"],["移される","うつされる"],["まで"],["は"],["十四","じゅうよん"],["代","だい"],["い"],["、"],["そして"],["、"],["バビロン"],["へ"],["移されて","うつされて"],["から"],["キリスト"],["まで"],["は"],["十四","じゅうよん"],["代","だい"],["いで"],["ある"],["。"]]},{"verse":18,"text":"イエス・キリストの誕生,たんじょうの次第,しだいはこうであった。母,ははマリヤはヨセフと婚約,こんやくしていたが、まだ一緒,いっしょにならない前,まえに、聖霊,せいれいによって身重,みおもになった。","tok":[["イエス"],["・"],["キリスト"],["の"],["誕生","たんじょう"],["の"],["次第","しだい"],["は"],["こう"],["で"],["あった"],["。"],["母","はは"],["マリヤ"],["は"],["ヨセフ"],["と"],["婚約","こんやく"],["して"],["いた"],["が"],["、"],["まだ"],["一緒","いっしょ"],["に"],["ならない"],["前","まえ"],["に"],["、"],["聖霊","せいれい"],["によって"],["身重","みおも"],["に"],["なった"],["。"]]},{"verse":19,"text":"夫,おっとヨセフは正,ただしい人,ひとであったので、彼女,かのじょのことが公,おおやけになることを好,このまず、ひそかに離縁,りえんしようと決心,けっしんした。","tok":[["夫","おっと"],["ヨセフ"],["は"],["正い","ただしい"],["人","ひと"],["で"],["あった"],["ので"],["、"],["彼女","かのじょ"],["の"],["こと"],["が"],["公け","おおやけ"],["に"],["なる"],["こと"],["を"],["好まず","このまず"],["、"],["ひそか"],["に"],["離縁","りえん"],["しよう"],["と"],["決心","けっしん"],["した"],["。"]]},{"verse":20,"text":"彼,かれがこのことを思,おもいめぐらしていたとき、主,しゅの使,つかいが夢,ゆめに現,あらわれて言,いった、「ダビデの子,こヨセフよ、心配,しんぱいしないでマリヤを妻,つまとして迎,むかえるがよい。その胎内,たいないに宿,やどっているものは聖霊,せいれいによるのである。","tok":[["彼","かれ"],["が"],["この"],["こと"],["を"],["思いめぐらして","おもいめぐらして"],["いた"],["とき"],["、"],["主","しゅ"],["の"],["使","つかい"],["が"],["夢","ゆめ"],["に"],["現われて","あらわれて"],["言った","いった"],["、"],["「"],["ダビデ"],["の"],["子","こ"],["ヨセフ"],["よ"],["、"],["心配","しんぱい"],["しないで"],["マリヤ"],["を"],["妻","つま"],["として"],["迎","むかえ"],["る"],["が"],["よい"],["。"],["その"],["胎内","たいない"],["に"],["宿って","やどって"],["いる"],["もの"],["は"],["聖霊","せいれい"],["に"],["よる"],["ので"],["ある"],["。"]]},{"verse":21,"text":"彼女,かのじょは男,おとこの子,こを産,うむであろう。その名,なをイエスと名,なづけなさい。彼,かれは、おのれの民,たみをそのもろもろの罪,つみから救,すくう者,ものとなるからである」。","tok":[["彼女","かのじょ"],["は"],["男の子","おとこのこ"],["を"],["産むで","うむで"],["あろう"],["。"],["その"],["名","な"],["を"],["イエス"],["と"],["名づけ","なづけ"],["なさい"],["。"],["彼","かれ"],["は"],["、"],["おのれ"],["の"],["民","たみ"],["を"],["その"],["もろもろ"],["の"],["罪","つみ"],["から"],["救う","すくう"],["者","もの"],["と"],["なる"],["から"],["で"],["ある"],["」"],["。"]]},{"verse":22,"text":"すべてこれらのことが起,おこったのは、主,しゅが預言者,よげんしゃによって言,いわれたことの成就,じょうじゅするためである。すなわち、","tok":[["すべて"],["これ"],["ら"],["の"],["こと"],["が"],["起こった","おこった"],["の"],["は"],["、"],["主","しゅ"],["が"],["預言者","よげんしゃ"],["によって"],["言われた","いわれた"],["こと"],["の"],["成就","じょうじゅ"],["する"],["ため"],["で"],["ある"],["。"],["すなわち"],["、"]]},{"verse":23,"text":"「見,みよ、おとめがみごもって男,おとこの子,こを産,うむであろう。その名,なはインマヌエルと呼,よばれるであろう」。これは、「神,かみわれらと共,ともにいます」という意味,いみである。","tok":[["「"],["見よ","みよ"],["、"],["おとめ"],["が"],["みごもって"],["男の子","おとこのこ"],["を"],["産むで","うむで"],["あろう"],["。"],["その"],["名","な"],["は"],["インマヌエル"],["と"],["呼ばれるで","よばれるで"],["あろう"],["」"],["。"],["これ"],["は"],["、"],["「"],["神","かみ"],["われ"],["ら"],["と"],["共","とも"],["に"],["います"],["」"],["と"],["いう"],["意味","いみ"],["で"],["ある"],["。"]]},{"verse":24,"text":"ヨセフは眠,ねむりからさめた後,のちに、主,しゅの使,つかいが命,めいじたとおりに、マリヤを妻,つまに迎,むかえた。","tok":[["ヨセフ"],["は"],["眠","ねむり"],["から"],["さめた"],["後","のち"],["に"],["、"],["主","しゅ"],["の"],["使","つかい"],["が"],["命じた","めいじた"],["とおり"],["に"],["、"],["マリヤ"],["を"],["妻","つま"],["に"],["迎","むかえ"],["た"],["。"]]},{"verse":25,"text":"しかし、子,こが生,うまれるまでは、彼女,かのじょを知,しることはなかった。そして、その子,こをイエスと名,なづけた。","tok":[["しかし"],["、"],["子","こ"],["が"],["生まれる","うまれる"],["まで"],["は"],["、"],["彼女","かのじょ"],["を"],["知る","しる"],["こと"],["は"],["なかった"],["。"],["そして"],["、"],["その"],["子","こ"],["を"],["イエス"],["と"],["名づけた","なづけた"],["。"]]}]
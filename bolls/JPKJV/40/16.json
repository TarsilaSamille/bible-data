[{"verse":1,"text":"パリサイ人,びととサドカイ人,びととが近寄,ちかよってきて、イエスを試,こころみ、天,てんからのしるしを見,みせてもらいたいと言,いった。","tok":[["パリサイ"],["人","び"],["と"],["と"],["サドカイ"],["人","び"],["と"],["と"],["が"],["近寄って","ちかよって"],["きて"],["、"],["イエス"],["を"],["試み","こころみ"],["、"],["天","てん"],["から"],["の"],["しるし"],["を"],["見せて","みせて"],["もらいたい"],["と"],["言った","いった"],["。"]]},{"verse":2,"text":"イエスは彼,かれらに言,いわれた、「あなたがたは夕方,ゆうがたになると、『空,そらがまっかだから、晴,はれだ』と言,いい、","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["がた"],["は"],["夕方","ゆうがた"],["に"],["なる"],["と"],["、"],["『"],["空","そら"],["が"],["まっか"],["だ"],["から"],["、"],["晴","はれ"],["だ"],["』"],["と"],["言い","いい"],["、"]]},{"verse":3,"text":"また明,あけ方,がたには『空,そらが曇,くもってまっかだから、きょうは荒,あれだ』と言,いう。あなたがたは空,そらの模様,もようを見分,みわけることを知,しりながら、時,ときのしるしを見分,みわけることができないのか。","tok":[["また"],["明け方","あけがた"],["に"],["は"],["『"],["空","そら"],["が"],["曇って","くもって"],["まっか"],["だ"],["から"],["、"],["きょう"],["は"],["荒れだ","あれだ"],["』"],["と"],["言う","いう"],["。"],["あなた"],["がた"],["は"],["空","そら"],["の"],["模様","もよう"],["を"],["見分ける","みわける"],["こと"],["を"],["知り","しり"],["ながら"],["、"],["時","とき"],["の"],["しるし"],["を"],["見分ける","みわける"],["こと"],["が"],["できない"],["の"],["か"],["。"]]},{"verse":4,"text":"邪悪,じゃあくで不義,ふぎな時代,じだいは、しるしを求,もとめる。しかし、ヨナのしるしのほかには、なんのしるしも与,あたえられないであろう」。そして、イエスは彼,かれらをあとに残,のこして立,たち去,さられた。","tok":[["邪悪","じゃあく"],["で"],["不義","ふぎ"],["な"],["時代","じだい"],["は"],["、"],["しるし"],["を"],["求める","もとめる"],["。"],["しかし"],["、"],["ヨナ"],["の"],["しるし"],["の"],["ほか"],["に"],["は"],["、"],["なん"],["の"],["しるし"],["も"],["与えられないで","あたえられないで"],["あろう"],["」"],["。"],["そして"],["、"],["イエス"],["は"],["彼","かれ"],["ら"],["を"],["あと"],["に"],["残して","のこして"],["立ち去られた","たちさられた"],["。"]]},{"verse":5,"text":"弟子,でしたちは向,むこう岸,ぎしに行,いったが、パンを持,もって来,くるのを忘,わすれていた。","tok":[["弟子","でし"],["たち"],["は"],["向こう岸","むこうぎし"],["に"],["行った","いった"],["が"],["、"],["パン"],["を"],["持って","もって"],["来る","くる"],["の"],["を"],["忘て","わすれて"],["いた"],["。"]]},{"verse":6,"text":"そこでイエスは言,いわれた、「パリサイ人,びととサドカイ人,びととのパン種,だねを、よくよく警戒,けいかいせよ」。","tok":[["そこ"],["で"],["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["パリサイ"],["人","び"],["と"],["と"],["サドカイ"],["人","びとと"],["の"],["パン種","ぱんだね"],["を"],["、"],["よくよく"],["警戒","けいかい"],["せよ"],["」"],["。"]]},{"verse":7,"text":"弟子,でしたちは、これは自分,じぶんたちがパンを持,もってこなかったためであろうと言,いって、互,たがいに論,ろんじ合,あった。","tok":[["弟子","でし"],["たち"],["は"],["、"],["これ"],["は"],["自分","じぶん"],["たち"],["が"],["パン"],["を"],["持って","もって"],["こなかった"],["ため"],["で"],["あろう"],["と"],["言って","いって"],["、"],["互","たがい"],["に"],["論じ合った","ろんじあった"],["。"]]},{"verse":8,"text":"イエスはそれと知,しって言,いわれた、「信仰,しんこうの薄,うすい者,ものたちよ、なぜパンがないからだと互,たがいに論,ろんじ合,あっているのか。","tok":[["イエス"],["は"],["それ"],["と"],["知って","しって"],["言われた","いわれた"],["、"],["「"],["信仰","しんこう"],["の"],["薄い","うすい"],["者","もの"],["たち"],["よ"],["、"],["なぜ"],["パン"],["が"],["ない"],["から"],["だ"],["と"],["互","たがい"],["に"],["論じ合って","ろんじあって"],["いる"],["の"],["か"],["。"]]},{"verse":9,"text":"まだわからないのか。覚,おぼえていないのか。五つのパンを五千人,にんに分,わけたとき、幾,いくかご拾,ひろったか。","tok":[["まだ"],["わからない"],["の"],["か"],["。"],["覚えて","おぼえて"],["いない"],["の"],["か"],["。"],["五","いつ"],["つ"],["の"],["パン"],["を"],["五千人","にん"],["に"],["分けた","わけた"],["とき"],["、"],["幾","いく"],["かご"],["拾った","ひろった"],["か"],["。"]]},{"verse":10,"text":"また、七つのパンを四千人,にんに分,わけたとき、幾,いくかご拾,ひろったか。","tok":[["また"],["、"],["七","なな"],["つ"],["の"],["パン"],["を"],["四千人","にん"],["に"],["分けた","わけた"],["とき"],["、"],["幾","いく"],["かご"],["拾った","ひろった"],["か"],["。"]]},{"verse":11,"text":"わたしが言,いったのは、パンについてではないことを、どうして悟,さとらないのか。ただ、パリサイ人,びととサドカイ人,びととのパン種,だねを警戒,けいかいしなさい」。","tok":[["わたし"],["が"],["言った","いった"],["の"],["は"],["、"],["パン"],["について"],["で"],["は"],["ない"],["こと"],["を"],["、"],["どう"],["して"],["悟らない","さとらない"],["の"],["か"],["。"],["ただ"],["、"],["パリサイ"],["人","び"],["と"],["と"],["サドカイ"],["人","びとと"],["の"],["パン種","ぱんだね"],["を"],["警戒","けいかい"],["し"],["なさい"],["」"],["。"]]},{"verse":12,"text":"そのとき彼,かれらは、イエスが警戒,けいかいせよと言,いわれたのは、パン種,だねのことではなく、パリサイ人,びととサドカイ人,びととの教,おしえのことであると悟,さとった。","tok":[["その"],["とき"],["彼","かれ"],["ら"],["は"],["、"],["イエス"],["が"],["警戒","けいかい"],["せよ"],["と"],["言われた","いわれた"],["の"],["は"],["、"],["パン種","ぱんだね"],["の"],["こと"],["で"],["は"],["なく"],["、"],["パリサイ"],["人","び"],["と"],["と"],["サドカイ"],["人","びとと"],["の"],["教え","おしえ"],["の"],["こと"],["で"],["ある"],["と"],["悟った","さとった"],["。"]]},{"verse":13,"text":"イエスがピリポ・カイザリヤの地方,ちほうに行,いかれたとき、弟子,でしたちに尋,たずねて言,いわれた、「人々,ひとびとは人,ひとの子,こをだれと言,いっているか」。","tok":[["イエス"],["が"],["ピリポ"],["・"],["カイザリヤ"],["の"],["地方","ちほう"],["に"],["行かれた","いかれた"],["とき"],["、"],["弟子","でし"],["たち"],["に"],["尋ねて","たずねて"],["言われた","いわれた"],["、"],["「"],["人々","ひとびと"],["は"],["人","ひと"],["の"],["子","こ"],["を"],["だれ"],["と"],["言って","いって"],["いる"],["か"],["」"],["。"]]},{"verse":14,"text":"彼,かれらは言,いった、「ある人々,ひとびとはバプテスマのヨハネだと言,いっています。しかし、ほかの人,ひとたちは、エリヤだと言,いい、また、エレミヤあるいは預言者,よげんしゃのひとりだ、と言,いっている者,ものもあります」。","tok":[["彼","かれ"],["ら"],["は"],["言った","いった"],["、"],["「"],["ある"],["人々","ひとびと"],["は"],["バプテスマ"],["の"],["ヨハネ"],["だ"],["と"],["言って","いって"],["います"],["。"],["しかし"],["、"],["ほか"],["の"],["人","ひと"],["たち"],["は"],["、"],["エリヤ"],["だ"],["と"],["言い","いい"],["、"],["また"],["、"],["エレミヤ"],["あるいは"],["預言者","よげんしゃ"],["の"],["ひとり"],["だ"],["、"],["と"],["言って","いって"],["いる"],["者","もの"],["も"],["あります"],["」"],["。"]]},{"verse":15,"text":"そこでイエスは彼,かれらに言,いわれた、「それでは、あなたがたはわたしをだれと言,いうか」。","tok":[["そこ"],["で"],["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["それ"],["で"],["は"],["、"],["あなた"],["がた"],["は"],["わたし"],["を"],["だれ"],["と"],["言う","いう"],["か"],["」"],["。"]]},{"verse":16,"text":"シモン・ペテロが答,こたえて言,いった、「あなたこそ、生,いける神,かみの子,こキリストです」。","tok":[["シモン"],["・"],["ペテロ"],["が"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["あなた"],["こそ"],["、"],["生ける","いける"],["神","かみ"],["の"],["子","こ"],["キリスト"],["です"],["」"],["。"]]},{"verse":17,"text":"すると、イエスは彼,かれにむかって言,いわれた、「バルヨナ・シモン、あなたはさいわいである。あなたにこの事,ことをあらわしたのは、血肉,けつにくではなく、天,てんにいますわたしの父,ちちである。","tok":[["する"],["と"],["、"],["イエス"],["は"],["彼","かれ"],["に"],["むかって"],["言われた","いわれた"],["、"],["「"],["バルヨナ"],["・"],["シモン"],["、"],["あなた"],["は"],["さいわい"],["で"],["ある"],["。"],["あなた"],["に"],["この"],["事","こと"],["を"],["あらわした"],["の"],["は"],["、"],["血肉","けつにく"],["で"],["は"],["なく"],["、"],["天","てん"],["に"],["います"],["わたし"],["の"],["父","ちち"],["で"],["ある"],["。"]]},{"verse":18,"text":"そこで、わたしもあなたに言,いう。あなたはペテロである。そして、わたしはこの岩,いわの上,うえにわたしの教会,きょうかいを建,たてよう。黄泉,よみの力,ちからもそれに打,うち勝,かつことはない。","tok":[["そこ"],["で"],["、"],["わたし"],["も"],["あなた"],["に"],["言う","いう"],["。"],["あなた"],["は"],["ペテロ"],["で"],["ある"],["。"],["そして"],["、"],["わたし"],["は"],["この"],["岩","いわ"],["の"],["上","うえ"],["に"],["わたし"],["の"],["教会","きょうかい"],["を"],["建てよう","たてよう"],["。"],["黄泉","よみ"],["の"],["力","ちから"],["も"],["それ"],["に"],["打ち勝つ","うちかつ"],["こと"],["は"],["ない"],["。"]]},{"verse":19,"text":"わたしは、あなたに天国,てんごくのかぎを授,さづけよう。そして、あなたが地上,ちじょうでつなぐことは、天,てんでもつながれ、あなたが地上,ちじょうで解,とくことは天,てんでも解,とかれるであろう」。","tok":[["わたし"],["は"],["、"],["あなた"],["に"],["天国","てんごく"],["の"],["かぎ"],["を"],["授","さ"],["づけよう"],["。"],["そして"],["、"],["あなた"],["が"],["地上","ちじょう"],["で"],["つなぐ"],["こと"],["は"],["、"],["天","てん"],["で"],["も"],["つながれ"],["、"],["あなた"],["が"],["地上","ちじょう"],["で"],["解く","とく"],["こと"],["は"],["天","てん"],["で"],["も"],["解かれるで","とかれるで"],["あろう"],["」"],["。"]]},{"verse":20,"text":"そのとき、イエスは、自分,じぶんがキリストであることをだれにも言,いってはいけないと、弟子,でしたちを戒,いましめられた。","tok":[["その"],["とき"],["、"],["イエス"],["は"],["、"],["自分","じぶん"],["が"],["キリスト"],["で"],["ある"],["こと"],["を"],["だれ"],["に"],["も"],["言って","いって"],["は"],["いけない"],["と"],["、"],["弟子","でし"],["たち"],["を"],["戒しめ","いましめ"],["られた"],["。"]]},{"verse":21,"text":"この時,ときから、イエス・キリストは、自分,じぶんが必,かならずエルサレムに行,いき、長老,ちょうろう、祭司長,さいしちょう、律法,りっぽう学者,がくしゃたちから多,おおくの苦,くるしみを受,うけ、殺,ころされ、そして三日,か目,めによみがえるべきことを、弟子,でしたちに示,しめしはじめられた。","tok":[["この"],["時","とき"],["から"],["、"],["イエス"],["・"],["キリスト"],["は"],["、"],["自分","じぶん"],["が"],["必","かならず"],["エルサレム"],["に"],["行き","いき"],["、"],["長老","ちょうろう"],["、"],["祭司長","さいしちょう"],["、"],["律法学者","りっぽうがくしゃ"],["たち"],["から"],["多く","おおく"],["の"],["苦しみ","くるしみ"],["を"],["受け","うけ"],["、"],["殺ろされ","ころされ"],["、"],["そして"],["三日目","かめ"],["に"],["よみがえるべき"],["こと"],["を"],["、"],["弟子","でし"],["たち"],["に"],["示めし","しめし"],["はじめられた"],["。"]]},{"verse":22,"text":"すると、ペテロはイエスをわきへ引,ひき寄,よせて、いさめはじめ、「主,しゅよ、とんでもないことです。そんなことがあるはずはございません」と言,いった。","tok":[["する"],["と"],["、"],["ペテロ"],["は"],["イエス"],["を"],["わき"],["へ"],["引寄せて","ひきよせて"],["、"],["いさめ"],["はじめ"],["、"],["「"],["主","しゅ"],["よ"],["、"],["とんでも"],["ない"],["こと"],["です"],["。"],["そんな"],["こと"],["が"],["ある"],["はず"],["は"],["ございません"],["」"],["と"],["言った","いった"],["。"]]},{"verse":23,"text":"イエスは振,ふり向,むいて、ペテロに言,いわれた、「サタンよ、引,ひきさがれ。わたしの邪魔,じゃまをする者,ものだ。あなたは神,かみのことを思,おもわないで、人,ひとのことを思,おもっている」。","tok":[["イエス"],["は"],["振り向いて","ふりむいて"],["、"],["ペテロ"],["に"],["言われた","いわれた"],["、"],["「"],["サタン"],["よ"],["、"],["引","ひき"],["さがれ"],["。"],["わたし"],["の"],["邪魔","じゃま"],["を"],["する"],["者","もの"],["だ"],["。"],["あなた"],["は"],["神","かみ"],["の"],["こと"],["を"],["思わないで","おもわないで"],["、"],["人","ひと"],["の"],["こと"],["を"],["思って","おもって"],["いる"],["」"],["。"]]},{"verse":24,"text":"それからイエスは弟子,でしたちに言,いわれた、「だれでもわたしについてきたいと思,おもうなら、自分,じぶんを捨,すて、自分,じぶんの十字架,じゅうじかを負,おうて、わたしに従,したがってきなさい。","tok":[["それ"],["から"],["イエス"],["は"],["弟子","でし"],["たち"],["に"],["言われた","いわれた"],["、"],["「"],["だれ"],["で"],["も"],["わたし"],["について"],["きたい"],["と"],["思うなら","おもうなら"],["、"],["自分","じぶん"],["を"],["捨て","すて"],["、"],["自分","じぶん"],["の"],["十字架","じゅうじか"],["を"],["負うて","おうて"],["、"],["わたし"],["に"],["従って","したがって"],["き"],["なさい"],["。"]]},{"verse":25,"text":"自分,じぶんの命,いのちを救,すくおうと思,おもう者,ものはそれを失,うしない、わたしのために自分,じぶんの命,いのちを失,うしなう者,ものは、それを見,みいだすであろう。","tok":[["自分","じぶん"],["の"],["命","いのち"],["を"],["救おう","すくおう"],["と"],["思う","おもう"],["者","もの"],["は"],["それ"],["を"],["失ない","うしない"],["、"],["わたし"],["の"],["ため"],["に"],["自分","じぶん"],["の"],["命","いのち"],["を"],["失なう","うしなう"],["者","もの"],["は"],["、"],["それ"],["を"],["見いだすで","みいだすで"],["あろう"],["。"]]},{"verse":26,"text":"たとい人,ひとが全,ぜん世界,せかいをもうけても、自分,じぶんの命,いのちを損,そんしたら、なんの得,とくになろうか。また、人,ひとはどんな代価,だいかを払,はらって、その命,いのちを買,かいもどすことができようか。","tok":[["たとい"],["人","ひと"],["が"],["全","ぜん"],["世界","せかい"],["を"],["もうけて"],["も"],["、"],["自分","じぶん"],["の"],["命","いのち"],["を"],["損したら","そんしたら"],["、"],["なん"],["の"],["得","とく"],["に"],["なろう"],["か"],["。"],["また"],["、"],["人","ひと"],["は"],["どんな"],["代価","だいか"],["を"],["払って","はらって"],["、"],["その"],["命","いのち"],["を"],["買","かい"],["も"],["どす"],["こと"],["が"],["できよう"],["か"],["。"]]},{"verse":27,"text":"人,ひとの子,こは父,ちちの栄光,えいこうのうちに、御使,みつかいたちを従,したがえて来,くるが、その時,ときには、実際,じっさいのおこないに応,おうじて、それぞれに報,むくいるであろう。","tok":[["人","ひと"],["の"],["子","こ"],["は"],["父","ちち"],["の"],["栄光","えいこう"],["の"],["うち"],["に"],["、"],["御使","みつかいたち"],["を"],["従えて","したがえて"],["来る","くる"],["が"],["、"],["その"],["時","とき"],["に"],["は"],["、"],["実際","じっさい"],["の"],["おこない"],["に"],["応じて","おうじて"],["、"],["それぞれ"],["に"],["報いるで","むくいるで"],["あろう"],["。"]]},{"verse":28,"text":"よく聞,きいておくがよい、人,ひとの子,こが御国,みくにの力,ちからをもって来,くるのを見,みるまでは、死,しを味,あじわわない者,ものが、ここに立,たっている者,ものの中,なかにいる」。","tok":[["よく"],["聞いて","きいて"],["おく"],["が"],["よい"],["、"],["人","ひと"],["の"],["子","こ"],["が"],["御国","みくに"],["の"],["力","ちから"],["を"],["もって"],["来る","くる"],["の"],["を"],["見る","みる"],["まで"],["は"],["、"],["死","し"],["を"],["味わわない","あじわわない"],["者","もの"],["が"],["、"],["ここ"],["に"],["立って","たって"],["いる"],["者","もの"],["の"],["中","なか"],["に"],["いる"],["」"],["。"]]}]
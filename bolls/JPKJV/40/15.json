[{"verse":1,"text":"ときに、パリサイ人,びとと律法,りっぽう学者,がくしゃたちとが、エルサレムからイエスのもとにきて言,いった、","tok":[["とき"],["に"],["、"],["パリサイ"],["人","び"],["と"],["と"],["律法学者","りっぽうがくしゃ"],["たち"],["と"],["が"],["、"],["エルサレム"],["から"],["イエス"],["の"],["もと"],["に"],["きて"],["言った","いった"],["、"]]},{"verse":2,"text":"「あなたの弟子,でしたちは、なぜ昔,むかしの人々,ひとびとの言伝,いいつたえを破,やぶるのですか。彼,かれらは食事,しょくじの時,ときに手,てを洗,あらっていません」。","tok":[["「"],["あなた"],["の"],["弟子","でし"],["たち"],["は"],["、"],["なぜ"],["昔","むかし"],["の"],["人々","ひとびと"],["の"],["言伝え","いいつたえ"],["を"],["破る","やぶる"],["の"],["です"],["か"],["。"],["彼","かれ"],["ら"],["は"],["食事","しょくじ"],["の"],["時","とき"],["に"],["手","て"],["を"],["洗って","あらって"],["いません"],["」"],["。"]]},{"verse":3,"text":"イエスは答,こたえて言,いわれた、「なぜ、あなたがたも自分,じぶんたちの言伝,いいつたえによって、神,かみのいましめを破,やぶっているのか。","tok":[["イエス"],["は"],["答","こたえ"],["て"],["言われた","いわれた"],["、"],["「"],["なぜ"],["、"],["あなた"],["がた"],["も"],["自分","じぶん"],["たち"],["の"],["言伝え","いいつたえ"],["によって"],["、"],["神","かみ"],["の"],["いましめ"],["を"],["破って","やぶって"],["いる"],["の"],["か"],["。"]]},{"verse":4,"text":"神,かみは言,いわれた、『父,ちちと母,ははとを敬,うやまえ』、また『父,ちちまたは母,ははをののしる者,ものは、必,かならず死,しに定,さだめられる』と。","tok":[["神","かみ"],["は"],["言われた","いわれた"],["、"],["『"],["父","ちち"],["と"],["母","はは"],["と"],["を"],["敬え","うやまえ"],["』"],["、"],["また"],["『"],["父","ちち"],["また"],["は"],["母","はは"],["を"],["ののしる"],["者","もの"],["は"],["、"],["必死","かならずし"],["に"],["定められる","さだめられる"],["』"],["と"],["。"]]},{"verse":5,"text":"それだのに、あなたがたは『だれでも父,ちちまたは母,ははにむかって、あなたにさしあげるはずのこのものは供,そなえ物,ものです、と言,いえば、","tok":[["それ"],["だ"],["のに"],["、"],["あなた"],["がた"],["は"],["『"],["だれ"],["で"],["も"],["父","ちち"],["また"],["は"],["母","はは"],["に"],["むかって"],["、"],["あなた"],["に"],["さしあげる"],["はず"],["の"],["この"],["もの"],["は"],["供え物","そなえもの"],["です"],["、"],["と"],["言えば","いえば"],["、"]]},{"verse":6,"text":"父,ちちまたは母,ははを敬,うやまわなくてもよろしい』と言,いっている。こうしてあなたがたは自分,じぶんたちの言伝,いいつたえによって、神,かみの言,ことばを無,むにしている。","tok":[["父","ちち"],["また"],["は"],["母","はは"],["を"],["敬わなくて","うやまわなくて"],["も"],["よろしい"],["』"],["と"],["言って","いって"],["いる"],["。"],["こう"],["して"],["あなた"],["がた"],["は"],["自分","じぶん"],["たち"],["の"],["言伝え","いいつたえ"],["によって"],["、"],["神","かみ"],["の"],["言","ことば"],["を"],["無","む"],["に"],["して"],["いる"],["。"]]},{"verse":7,"text":"偽善者,ぎぜんしゃたちよ、イザヤがあなたがたについて、こういう適切,てきせつな預言,よげんをしている、","tok":[["偽善者","ぎぜんしゃ"],["たち"],["よ"],["、"],["イザヤ"],["が"],["あなた"],["がた"],["について"],["、"],["こう"],["いう"],["適切","てきせつ"],["な"],["預言","よげん"],["を"],["して"],["いる"],["、"]]},{"verse":8,"text":"『この民,たみは、口,くちさきではわたしを敬,うやまうが、その心,こころはわたしから遠,とおく離,はなれている。","tok":[["『"],["この"],["民","たみ"],["は"],["、"],["口さき","くちさき"],["で"],["は"],["わたし"],["を"],["敬う","うやまう"],["が"],["、"],["その"],["心","こころ"],["は"],["わたし"],["から"],["遠く","とおく"],["離れて","はなれて"],["いる"],["。"]]},{"verse":9,"text":"人間,にんげんのいましめを教,おしえとして教,おしえ、無意味,むいみにわたしを拝,おがんでいる』」。","tok":[["人間","にんげん"],["の"],["いましめ"],["を"],["教え","おしえ"],["として"],["教え","おしえ"],["、"],["無意味","むいみ"],["に"],["わたし"],["を"],["拝んで","おがんで"],["いる"],["』"],["」"],["。"]]},{"verse":10,"text":"それからイエスは群衆,ぐんしゅうを呼,よび寄,よせて言,いわれた、「聞,きいて悟,さとるがよい。","tok":[["それ"],["から"],["イエス"],["は"],["群衆","ぐんしゅう"],["を"],["呼び寄せて","よびよせて"],["言われた","いわれた"],["、"],["「"],["聞いて","きいて"],["悟","さとる"],["が"],["よい"],["。"]]},{"verse":11,"text":"口,くちにはいるものは人,ひとを汚,けがすことはない。かえって、口,くちから出,でるものが人,ひとを汚,けがすのである」。","tok":[["口","くち"],["に"],["は"],["いる"],["もの"],["は"],["人","ひと"],["を"],["汚す","けがす"],["こと"],["は"],["ない"],["。"],["かえって"],["、"],["口","くち"],["から"],["出る","でる"],["もの"],["が"],["人","ひと"],["を"],["汚す","けがす"],["ので"],["ある"],["」"],["。"]]},{"verse":12,"text":"そのとき、弟子,でしたちが近寄,ちかよってきてイエスに言,いった、「パリサイ人,びとたちが御言,みことばを聞,きいてつまずいたことを、ご存,ぞんじですか」。","tok":[["その"],["とき"],["、"],["弟子","でし"],["たち"],["が"],["近寄って","ちかよって"],["きて"],["イエス"],["に"],["言った","いった"],["、"],["「"],["パリサイ"],["人","びと"],["たち"],["が"],["御言","みこと"],["ば"],["を"],["聞いて","きいて"],["つまずいた"],["こと"],["を"],["、"],["ご存じ","ごぞんじ"],["です"],["か"],["」"],["。"]]},{"verse":13,"text":"イエスは答,こたえて言,いわれた、「わたしの天,てんの父,ちちがお植,うえにならなかったものは、みな抜,ぬき取,とられるであろう。","tok":[["イエス"],["は"],["答","こたえ"],["て"],["言われた","いわれた"],["、"],["「"],["わたし"],["の"],["天","てん"],["の"],["父","ちち"],["が"],["お植え","おうえ"],["に"],["ならなかった"],["もの"],["は"],["、"],["みな"],["抜き取られるで","ぬきとられるで"],["あろう"],["。"]]},{"verse":14,"text":"彼,かれらをそのままにしておけ。彼,かれらは盲人,もうじんを手引,てびきする盲人,もうじんである。もし盲人,もうじんが盲人,もうじんを手引,てびきするなら、ふたりとも穴,あなに落,おち込,こむであろう」。","tok":[["彼","かれ"],["ら"],["を"],["そのまま"],["に"],["して"],["おけ"],["。"],["彼","かれ"],["ら"],["は"],["盲人","もうじん"],["を"],["手引","てびき"],["する"],["盲人","もうじん"],["で"],["ある"],["。"],["もし"],["盲人","もうじん"],["が"],["盲人","もうじん"],["を"],["手引","てびき"],["するなら"],["、"],["ふたり"],["とも"],["穴","あな"],["に"],["落込むで","おちこむで"],["あろう"],["」"],["。"]]},{"verse":15,"text":"ペテロが答,こたえて言,いった、「その譬,たとえを説明,せつめいしてください」。","tok":[["ペテロ"],["が"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["その"],["譬","たとえ"],["を"],["説明","せつめい"],["して"],["ください"],["」"],["。"]]},{"verse":16,"text":"イエスは言,いわれた、「あなたがたも、まだわからないのか。","tok":[["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["あなた"],["がた"],["も"],["、"],["まだ"],["わからない"],["の"],["か"],["。"]]},{"verse":17,"text":"口,くちにはいってくるものは、みな腹,はらの中,なかにはいり、そして、外,そとに出,でて行,いくことを知,しらないのか。","tok":[["口","くち"],["に"],["はいって"],["くる"],["もの"],["は"],["、"],["みな"],["腹","はら"],["の"],["中","なか"],["に"],["はいり"],["、"],["そして"],["、"],["外","そと"],["に"],["出て","でて"],["行く","いく"],["こと"],["を"],["知らない","しらない"],["の"],["か"],["。"]]},{"verse":18,"text":"しかし、口,くちから出,でて行,いくものは、心,こころの中,なかから出,でてくるのであって、それが人,ひとを汚,けがすのである。","tok":[["しかし"],["、"],["口","くち"],["から"],["出て","でて"],["行く","いく"],["もの"],["は"],["、"],["心","こころ"],["の"],["中","なか"],["から"],["出て","でて"],["くる"],["ので"],["あって"],["、"],["それ"],["が"],["人","ひと"],["を"],["汚す","けがす"],["ので"],["ある"],["。"]]},{"verse":19,"text":"というのは、悪,わるい思,おもい、すなわち、殺人,さつじん、姦淫,かんいん、不品行,ふひんこう、盗,ぬすみ、偽証,ぎしょう、誹,そしりは、心,こころの中,なかから出,でてくるのであって、","tok":[["と"],["いう"],["の"],["は"],["、"],["悪い","わるい"],["思い","おもい"],["、"],["すなわち"],["、"],["殺人","さつじん"],["、"],["姦淫","かんいん"],["、"],["不品行","ふひんこう"],["、"],["盗み","ぬすみ"],["、"],["偽証","ぎしょう"],["、"],["誹り","そしり"],["は"],["、"],["心","こころ"],["の"],["中","なか"],["から"],["出て","でて"],["くる"],["ので"],["あって"],["、"]]},{"verse":20,"text":"これらのものが人,ひとを汚,けがすのである。しかし、洗,あらわない手,てで食事,しょくじすることは、人,ひとを汚,けがすのではない」。","tok":[["これ"],["ら"],["の"],["もの"],["が"],["人","ひと"],["を"],["汚す","けがす"],["ので"],["ある"],["。"],["しかし"],["、"],["洗わない","あらわない"],["手","て"],["で"],["食事","しょくじ"],["する"],["こと"],["は"],["、"],["人","ひと"],["を"],["汚す","けがす"],["ので"],["は"],["ない"],["」"],["。"]]},{"verse":21,"text":"さて、イエスはそこを出,でて、ツロとシドンとの地方,ちほうへ行,いかれた。","tok":[["さて"],["、"],["イエス"],["は"],["そこ"],["を"],["出て","でて"],["、"],["ツロ"],["と"],["シドン"],["と"],["の"],["地方","ちほう"],["へ"],["行かれた","いかれた"],["。"]]},{"verse":22,"text":"すると、そこへ、その地方,ちほう出,でのカナンの女,おんなが出,でてきて、「主,しゅよ、ダビデの子,こよ、わたしをあわれんでください。娘,むすめが悪霊,あくれいにとりつかれて苦,くるしんでいます」と言,いって叫,さけびつづけた。","tok":[["する"],["と"],["、"],["そこ"],["へ"],["、"],["その"],["地方出","ちほうで"],["の"],["カナン"],["の"],["女","おんな"],["が"],["出て","でて"],["きて"],["、"],["「"],["主","しゅ"],["よ"],["、"],["ダビデ"],["の"],["子","こ"],["よ"],["、"],["わたし"],["を"],["あわれんで"],["ください"],["。"],["娘","むすめ"],["が"],["悪霊","あくれい"],["に"],["とりつかれて"],["苦しんで","くるしんで"],["います"],["」"],["と"],["言って","いって"],["叫","さけび"],["つづけた"],["。"]]},{"verse":23,"text":"しかし、イエスはひと言,こともお答,こたえにならなかった。そこで弟子,でしたちがみもとにきて願,ねがって言,いった、「この女,おんなを追,おい払,はらってください。叫,さけびながらついてきていますから」。","tok":[["しかし"],["、"],["イエス"],["は"],["ひと言","ひとこと"],["も"],["お答","おこたえ"],["に"],["ならなかった"],["。"],["そこ"],["で"],["弟子","でし"],["たち"],["が"],["みもと"],["に"],["きて"],["願って","ねがって"],["言った","いった"],["、"],["「"],["この"],["女","おんな"],["を"],["追い払って","おいはらって"],["ください"],["。"],["叫","さけび"],["ながら"],["ついて"],["きて"],["います"],["から"],["」"],["。"]]},{"verse":24,"text":"するとイエスは答,こたえて言,いわれた、「わたしは、イスラエルの家,いえの失,うしなわれた羊,ひつじ以外,いがいの者,ものには、つかわされていない」。","tok":[["する"],["と"],["イエス"],["は"],["答","こたえ"],["て"],["言われた","いわれた"],["、"],["「"],["わたし"],["は"],["、"],["イスラエル"],["の"],["家","いえ"],["の"],["失なわれた","うしなわれた"],["羊","ひつじ"],["以外","いがい"],["の"],["者","もの"],["に"],["は"],["、"],["つかわされて"],["いない"],["」"],["。"]]},{"verse":25,"text":"しかし、女,おんなは近寄,ちかよりイエスを拝,はいして言,いった、「主,しゅよ、わたしをお助,たすけください」。","tok":[["しかし"],["、"],["女","おんな"],["は"],["近寄り","ちかより"],["イエス"],["を"],["拝して","はいして"],["言った","いった"],["、"],["「"],["主","しゅ"],["よ"],["、"],["わたし"],["を"],["お助け","おたすけ"],["ください"],["」"],["。"]]},{"verse":26,"text":"イエスは答,こたえて言,いわれた、「子供,こどもたちのパンを取,とって小犬,こいぬに投,なげてやるのは、よろしくない」。","tok":[["イエス"],["は"],["答","こたえ"],["て"],["言われた","いわれた"],["、"],["「"],["子供","こども"],["たち"],["の"],["パン"],["を"],["取って","とって"],["小犬","こいぬ"],["に"],["投て","なげて"],["やる"],["の"],["は"],["、"],["よろしく"],["ない"],["」"],["。"]]},{"verse":27,"text":"すると女,おんなは言,いった、「主,しゅよ、お言葉,ことばどおりです。でも、小犬,こいぬもその主人,しゅじんの食卓,しょくたくから落,おちるパンくずは、いただきます」。","tok":[["する"],["と"],["女","おんな"],["は"],["言った","いった"],["、"],["「"],["主","しゅ"],["よ"],["、"],["お言葉","おことば"],["どおり"],["です"],["。"],["で"],["も"],["、"],["小犬","こいぬ"],["も"],["その"],["主人","しゅじん"],["の"],["食卓","しょくたく"],["から"],["落","おち"],["る"],["パン"],["くず"],["は"],["、"],["いただきます"],["」"],["。"]]},{"verse":28,"text":"そこでイエスは答,こたえて言,いわれた、「女,おんなよ、あなたの信仰,しんこうは見,みあげたものである。あなたの願,ねがいどおりになるように」。その時,ときに、娘,むすめはいやされた。","tok":[["そこ"],["で"],["イエス"],["は"],["答","こたえ"],["て"],["言われた","いわれた"],["、"],["「"],["女","おんな"],["よ"],["、"],["あなた"],["の"],["信仰","しんこう"],["は"],["見あげた","みあげた"],["もの"],["で"],["ある"],["。"],["あなた"],["の"],["願い","ねがい"],["どおり"],["に"],["なる"],["よう"],["に"],["」"],["。"],["その"],["時","とき"],["に"],["、"],["娘","むすめ"],["は"],["いやされた"],["。"]]},{"verse":29,"text":"イエスはそこを去,さって、ガリラヤの海,うみべに行,いき、それから山,やまに登,のぼってそこにすわられた。","tok":[["イエス"],["は"],["そこ"],["を"],["去て","さって"],["、"],["ガリラヤ"],["の"],["海べ","うみべ"],["に"],["行き","いき"],["、"],["それ"],["から"],["山","やま"],["に"],["登って","のぼって"],["そこ"],["に"],["すわられた"],["。"]]},{"verse":30,"text":"すると大,おおぜいの群衆,ぐんしゅうが、足,あしなえ、不具者,ふぐしゃ、盲人,もうじん、おし、そのほか多,おおくの人々,ひとびとを連,つれてきて、イエスの足,あしもとに置,おいたので、彼,かれらをおいやしになった。","tok":[["する"],["と"],["大ぜい","おおぜい"],["の"],["群衆","ぐんしゅう"],["が"],["、"],["足","あし"],["なえ"],["、"],["不具者","ふぐしゃ"],["、"],["盲人","もうじん"],["、"],["おし"],["、"],["その"],["ほか"],["多く","おおく"],["の"],["人々","ひとびと"],["を"],["連れて","つれて"],["きて"],["、"],["イエス"],["の"],["足もと","あしもと"],["に"],["置いた","おいた"],["ので"],["、"],["彼","かれ"],["ら"],["を"],["おいやし"],["に"],["なった"],["。"]]},{"verse":31,"text":"群衆,ぐんしゅうは、おしが物,ものを言,いい、不具者,ふぐしゃが直,なおり、足,あしなえが歩,あるき、盲人,もうじんが見,みえるようになったのを見,みて驚,おどろき、そしてイスラエルの神,かみをほめたたえた。","tok":[["群衆","ぐんしゅう"],["は"],["、"],["おし"],["が"],["物","もの"],["を"],["言い","いい"],["、"],["不具者","ふぐしゃ"],["が"],["直り","なおり"],["、"],["足","あし"],["なえ"],["が"],["歩き","あるき"],["、"],["盲人","もうじん"],["が"],["見える","みえる"],["よう"],["に"],["なった"],["の"],["を"],["見て","みて"],["驚","おどろき"],["、"],["そして"],["イスラエル"],["の"],["神","かみ"],["を"],["ほめたたえた"],["。"]]},{"verse":32,"text":"イエスは弟子,でしたちを呼,よび寄,よせて言,いわれた、「この群衆,ぐんしゅうがかわいそうである。もう三日間,かかんもわたしと一緒,いっしょにいるのに、何,なにも食,たべるものがない。しかし、彼,かれらを空腹,くうふくのままで帰,かえらせたくはない。恐,おそらく途中,とちゅうで弱,よわり切,きってしまうであろう」。","tok":[["イエス"],["は"],["弟子","でし"],["たち"],["を"],["呼び寄せて","よびよせて"],["言われた","いわれた"],["、"],["「"],["この"],["群衆","ぐんしゅう"],["が"],["かわいそう"],["で"],["ある"],["。"],["もう"],["三","みっ"],["日間","かかん"],["も"],["わたし"],["と"],["一緒","いっしょ"],["に"],["いる"],["のに"],["、"],["何に","なに"],["も"],["食べる","たべる"],["もの"],["が"],["ない"],["。"],["しかし"],["、"],["彼","かれ"],["ら"],["を"],["空腹","くうふく"],["の"],["まま"],["で"],["帰えらせたく","かえらせたく"],["は"],["ない"],["。"],["恐らく","おそらく"],["途中","とちゅう"],["で"],["弱り","よわり"],["切って","きって"],["しまうで"],["あろう"],["」"],["。"]]},{"verse":33,"text":"弟子,でしたちは言,いった、「荒野,あらのの中,なかで、こんなに大,おおぜいの群衆,ぐんしゅうにじゅうぶん食,たべさせるほどたくさんのパンを、どこで手,てに入,いれましょうか」。","tok":[["弟子","でし"],["たち"],["は"],["言った","いった"],["、"],["「"],["荒野","あら"],["の"],["の"],["中","なか"],["で"],["、"],["こんな"],["に"],["大ぜい","おおぜい"],["の"],["群衆","ぐんしゅう"],["に"],["じゅうぶん"],["食べさせる","たべさせる"],["ほど"],["たくさん"],["の"],["パン"],["を"],["、"],["どこ"],["で"],["手","て"],["に"],["入れましょう","いれましょう"],["か"],["」"],["。"]]},{"verse":34,"text":"イエスは弟子,でしたちに「パンはいくつあるか」と尋,たずねられると、「七つあります。また小,ちいさい魚,うおが少,すこしあります」と答,こたえた。","tok":[["イエス"],["は"],["弟子","でし"],["たち"],["に"],["「"],["パン"],["は"],["いくつ"],["ある"],["か"],["」"],["と"],["尋ねられる","たずねられる"],["と"],["、"],["「"],["七","なな"],["つ"],["あります"],["。"],["また"],["小さい","ちいさい"],["魚","う"],["お"],["が"],["少し","すこし"],["あります"],["」"],["と"],["答","こたえ"],["た"],["。"]]},{"verse":35,"text":"そこでイエスは群衆,ぐんしゅうに、地,ちにすわるようにと命,めいじ、","tok":[["そこ"],["で"],["イエス"],["は"],["群衆","ぐんしゅう"],["に"],["、"],["地","ち"],["に"],["すわる"],["よう"],["に"],["と"],["命じ","めいじ"],["、"]]},{"verse":36,"text":"七つのパンと魚,うおとを取,とり、感謝,かんしゃしてこれをさき、弟子,でしたちにわたされ、弟子,でしたちはこれを群衆,ぐんしゅうにわけた。","tok":[["七","なな"],["つ"],["の"],["パン"],["と"],["魚","うおと"],["を"],["取","とり"],["、"],["感謝","かんしゃ"],["して"],["これ"],["を"],["さき"],["、"],["弟子","でし"],["たち"],["に"],["わたされ"],["、"],["弟子","でし"],["たち"],["は"],["これ"],["を"],["群衆","ぐんしゅう"],["に"],["わけた"],["。"]]},{"verse":37,"text":"一同,いちどうの者,ものは食,たべて満腹,まんぷくした。そして残,のこったパンくずを集,あつめると、七つのかごにいっぱいになった。","tok":[["一同","いちどう"],["の"],["者","もの"],["は"],["食べて","たべて"],["満腹","まんぷく"],["した"],["。"],["そして"],["残った","のこった"],["パン"],["くず"],["を"],["集める","あつめる"],["と"],["、"],["七","なな"],["つ"],["の"],["かご"],["に"],["いっぱい"],["に"],["なった"],["。"]]},{"verse":38,"text":"食,たべた者,ものは、女,おんなと子供,こどもとを除,のぞいて四千人,にんであった。","tok":[["食べた","たべた"],["者","もの"],["は"],["、"],["女","おんな"],["と"],["子供","こども"],["と"],["を"],["除いて","のぞいて"],["四千人","にん"],["で"],["あった"],["。"]]},{"verse":39,"text":"そこでイエスは群衆,ぐんしゅうを解散,かいさんさせ、舟,ふねに乗,のってマガダンの地方,ちほうへ行,いかれた。","tok":[["そこ"],["で"],["イエス"],["は"],["群衆","ぐんしゅう"],["を"],["解散","かいさん"],["させ"],["、"],["舟","ふね"],["に"],["乗って","のって"],["マガダン"],["の"],["地方","ちほう"],["へ"],["行かれた","いかれた"],["。"]]}]
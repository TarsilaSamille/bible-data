[{"verse":1,"text":"そこで、イエスは十二弟子,でしを呼,よび寄,よせて、汚,けがれた霊,れいを追,おい出,だし、あらゆる病気,びょうき、あらゆるわずらいをいやす権威,けんいをお授,さづけになった。","tok":[["そこ"],["で"],["、"],["イエス"],["は"],["十二","じゅうに"],["弟子","でし"],["を"],["呼び寄せて","よびよせて"],["、"],["汚","け"],["がれ"],["た"],["霊","れい"],["を"],["追い出し","おいだし"],["、"],["あらゆる"],["病気","びょうき"],["、"],["あらゆる"],["わずらい"],["を"],["いやす"],["権威","けんい"],["を"],["お"],["授","さづけ"],["に"],["なった"],["。"]]},{"verse":2,"text":"十二使徒,しとの名,なは、次,つぎのとおりである。まずペテロと呼,よばれたシモンとその兄弟,きょうだいアンデレ、それからゼベダイの子,こヤコブとその兄弟,きょうだいヨハネ、","tok":[["十二","じゅうに"],["使徒","しと"],["の"],["名","な"],["は"],["、"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["まず"],["ペテロ"],["と"],["呼ばれた","よばれた"],["シモン"],["と"],["その"],["兄弟","きょうだい"],["アンデレ"],["、"],["それ"],["から"],["ゼベダイ"],["の"],["子","こ"],["ヤコブ"],["と"],["その"],["兄弟","きょうだい"],["ヨハネ"],["、"]]},{"verse":3,"text":"ピリポとバルトロマイ、トマスと取税人,しゅぜいにんマタイ、アルパヨの子,こヤコブとタダイ、","tok":[["ピリポ"],["と"],["バルトロマイ"],["、"],["トマス"],["と"],["取","とり"],["税人","ぜいにん"],["ぜ"],["い"],["に"],["ん"],["マタイ"],["、"],["アルパヨ"],["の"],["子","こ"],["ヤコブ"],["と"],["タダイ"],["、"]]},{"verse":4,"text":"熱心,ねっしん党,とうのシモンとイスカリオテのユダ。このユダはイエスを裏切,うらぎった者,ものである。","tok":[["熱心","ねっしん"],["党","とう"],["の"],["シモン"],["と"],["イスカリオテ"],["の"],["ユダ"],["。"],["この"],["ユダ"],["は"],["イエス"],["を"],["裏切った","うらぎった"],["者","もの"],["で"],["ある"],["。"]]},{"verse":5,"text":"イエスはこの十二人,にんをつかわすに当,あたり、彼,かれらに命,めいじて言,いわれた、「異邦人,いほうじんの道,みちに行,いくな。またサマリヤ人,びとの町,まちにはいるな。","tok":[["イエス"],["は"],["この"],["十二人","にん"],["を"],["つかわす"],["に"],["当たり","あたり"],["、"],["彼","かれ"],["ら"],["に"],["命じて","めいじて"],["言われた","いわれた"],["、"],["「"],["異邦人","いほうじん"],["の"],["道","みち"],["に"],["行く","いく"],["な"],["。"],["また"],["サマリヤ"],["人","びと"],["の"],["町","まち"],["に"],["はいる"],["な"],["。"]]},{"verse":6,"text":"むしろ、イスラエルの家,いえの失,うしなわれた羊,ひつじのところに行,いけ。","tok":[["むしろ"],["、"],["イスラエル"],["の"],["家","いえ"],["の"],["失なわれた","うしなわれた"],["羊","ひつじ"],["の"],["ところ"],["に"],["行け","いけ"],["。"]]},{"verse":7,"text":"行,いって、『天国,てんごくが近,ちかづいた』と宣,のべ伝,つたえよ。","tok":[["行って","いって"],["、"],["『"],["天国","てんごく"],["が"],["近づいた","ちかづいた"],["』"],["と"],["宣べ伝え","のべつたえ"],["よ"],["。"]]},{"verse":8,"text":"病人,びょうにんをいやし、死人,しにんをよみがえらせ、らい病人,びょうにんをきよめ、悪霊,あくれいを追,おい出,だせ。ただで受,うけたのだから、ただで与,あたえるがよい。","tok":[["病人","びょうにん"],["を"],["いやし"],["、"],["死人","しにん"],["を"],["よみがえらせ"],["、"],["らい病人","らいびょうにん"],["を"],["きよめ"],["、"],["悪霊","あくれい"],["を"],["追い出せ","おいだせ"],["。"],["ただ"],["で"],["受た","うけた"],["の"],["だ"],["から"],["、"],["ただ"],["で"],["与える","あたえる"],["が"],["よい"],["。"]]},{"verse":9,"text":"財布,さいふの中,なかに金,きん、銀,ぎんまたは銭,ぜにを入,いれて行,いくな。","tok":[["財布","さいふ"],["の"],["中","なか"],["に"],["金","きん"],["、"],["銀","ぎん"],["また"],["は"],["銭","ぜに"],["を"],["入れて","いれて"],["行く","いく"],["な"],["。"]]},{"verse":10,"text":"旅行,りょこうのための袋,ふくろも、二枚,まいの下着,したぎも、くつも、つえも持,もって行,いくな。働,はたらき人,びとがその食物,しょくもつを得,えるのは当然,とうぜんである。","tok":[["旅行","りょこう"],["の"],["ため"],["の"],["袋","ふくろ"],["も"],["、"],["二枚","まい"],["の"],["下着","したぎ"],["も"],["、"],["くつ"],["も"],["、"],["つえ"],["も"],["持って","もって"],["行く","いく"],["な"],["。"],["働らき人","はたらきびとがそ"],["の"],["食物","しょくもつ"],["を"],["得る","える"],["の"],["は"],["当然","とうぜん"],["で"],["ある"],["。"]]},{"verse":11,"text":"どの町,まち、どの村,むらにはいっても、その中,なかでだれがふさわしい人,ひとか、たずね出,だして、立,たち去,さるまではその人,ひとのところにとどまっておれ。","tok":[["どの"],["町","まち"],["、"],["どの"],["村","むら"],["に"],["はいって"],["も"],["、"],["その"],["中","なか"],["で"],["だれ"],["が"],["ふさわしい"],["人","ひと"],["か"],["、"],["たずね"],["出して","だして"],["、"],["立ち去る","たちさる"],["まで"],["は"],["その"],["人","ひと"],["の"],["ところ"],["に"],["とどまって"],["おれ"],["。"]]},{"verse":12,"text":"その家,いえにはいったなら、平安,へいあんを祈,いのってあげなさい。","tok":[["その"],["家","いえ"],["に"],["はいったなら"],["、"],["平安","へいあん"],["を"],["祈って","いのって"],["あげ"],["なさい"],["。"]]},{"verse":13,"text":"もし平安,へいあんを受,うけるにふさわしい家,いえであれば、あなたがたの祈,いのる平安,へいあんはその家,いえに来,くるであろう。もしふさわしくなければ、その平安,へいあんはあなたがたに帰,かえって来,くるであろう。","tok":[["もし"],["平安","へいあん"],["を"],["受る","うける"],["に"],["ふさわしい"],["家","いえ"],["で"],["あれば"],["、"],["あなた"],["がた"],["の"],["祈る","いのる"],["平安","へいあん"],["は"],["その"],["家","いえ"],["に"],["来るで","くるで"],["あろう"],["。"],["もし"],["ふさわしく"],["なければ"],["、"],["その"],["平安","へいあん"],["は"],["あなた"],["がた"],["に"],["帰えって","かえって"],["来るで","くるで"],["あろう"],["。"]]},{"verse":14,"text":"もしあなたがたを迎,むかえもせず、またあなたがたの言葉,ことばを聞,ききもしない人,ひとがあれば、その家,いえや町,まちを立,たち去,さる時,ときに、足,あしのちりを払,はらい落,おとしなさい。","tok":[["もし"],["あなた"],["がた"],["を"],["迎","むかえ"],["も"],["せず"],["、"],["また"],["あなた"],["がた"],["の"],["言葉","ことば"],["を"],["聞","きき"],["も"],["しない"],["人","ひと"],["が"],["あれば"],["、"],["その"],["家","いえ"],["や"],["町","まち"],["を"],["立ち去る","たちさる"],["時","とき"],["に"],["、"],["足","あし"],["の"],["ちり"],["を"],["払","はらい"],["落とし","おとし"],["なさい"],["。"]]},{"verse":15,"text":"あなたがたによく言,いっておく。さばきの日,ひには、ソドム、ゴモラの地,ちの方,ほうが、その町,まちよりは耐,たえやすいであろう。","tok":[["あなた"],["がた"],["に"],["よく"],["言って","いって"],["おく"],["。"],["さばき"],["の"],["日","ひ"],["に"],["は"],["、"],["ソドム"],["、"],["ゴモラ"],["の"],["地","ち"],["の"],["方","ほう"],["が"],["、"],["その"],["町","まち"],["より"],["は"],["耐え","たえ"],["やすい"],["で"],["あろう"],["。"]]},{"verse":16,"text":"わたしがあなたがたをつかわすのは、羊,ひつじをおおかみの中,なかに送,おくるようなものである。だから、へびのように賢,かしこく、はとのように素直,すなおであれ。","tok":[["わたし"],["が"],["あなた"],["がた"],["を"],["つかわす"],["の"],["は"],["、"],["羊","ひつじ"],["を"],["おおかみ"],["の"],["中","なか"],["に"],["送る","おくる"],["よう"],["な"],["もの"],["で"],["ある"],["。"],["だ"],["から"],["、"],["へび"],["の"],["よう"],["に"],["賢しこく","かしこく"],["、"],["はと"],["の"],["よう"],["に"],["素直","すなお"],["で"],["あれ"],["。"]]},{"verse":17,"text":"人々,ひとびとに注意,ちゅういしなさい。彼,かれらはあなたがたを衆議所,しゅうぎしょに引,ひき渡,わたし、会堂,かいどうでむち打,うつであろう。","tok":[["人々","ひとびと"],["に"],["注意","ちゅうい"],["し"],["なさい"],["。"],["彼","かれ"],["ら"],["は"],["あなた"],["がた"],["を"],["衆議所","しゅうぎしょ"],["に"],["引渡","ひきわたし"],["、"],["会堂","かいどう"],["で"],["むち打つで","むちうつで"],["あろう"],["。"]]},{"verse":18,"text":"またあなたがたは、わたしのために長官,ちょうかんたちや王,おうたちの前,まえに引,ひき出,だされるであろう。それは、彼,かれらと異邦人,いほうじんとに対,たいしてあかしをするためである。","tok":[["また"],["あなた"],["がた"],["は"],["、"],["わたし"],["の"],["ため"],["に"],["長官","ちょうかん"],["たち"],["や"],["王","おう"],["たち"],["の"],["前","まえ"],["に"],["引出されるで","ひきだされるで"],["あろう"],["。"],["それ"],["は"],["、"],["彼","かれ"],["ら"],["と"],["異邦人","いほうじん"],["と"],["に対して","にたいして"],["あかし"],["を"],["する"],["ため"],["で"],["ある"],["。"]]},{"verse":19,"text":"彼,かれらがあなたがたを引,ひき渡,わたしたとき、何,なにをどう言,いおうかと心配,しんぱいしないがよい。言,いうべきことは、その時,ときに授,さづけられるからである。","tok":[["彼","かれ"],["ら"],["が"],["あなた"],["がた"],["を"],["引渡","ひきわたし"],["た"],["とき"],["、"],["何に","なに"],["を"],["どう"],["言おう","いおう"],["か"],["と"],["心配","しんぱい"],["しない"],["が"],["よい"],["。"],["言","いうべきこ"],["と"],["は"],["、"],["その"],["時","とき"],["に"],["授","さ"],["づけられる"],["から"],["で"],["ある"],["。"]]},{"verse":20,"text":"語,かたる者,ものは、あなたがたではなく、あなたがたの中,なかにあって語,かたる父,ちちの霊,れいである。","tok":[["語る","かたる"],["者","もの"],["は"],["、"],["あなた"],["がた"],["で"],["は"],["なく"],["、"],["あなた"],["がた"],["の"],["中","なか"],["に"],["あって"],["語る","かたる"],["父","ちち"],["の"],["霊","れい"],["で"],["ある"],["。"]]},{"verse":21,"text":"兄弟,きょうだいは兄弟,きょうだいを、父,ちちは子,こを殺,ころすために渡,わたし、また子,こは親,おやに逆,さからって立,たち、彼,かれらを殺,ころさせるであろう。","tok":[["兄弟","きょうだい"],["は"],["兄弟","きょうだい"],["を"],["、"],["父","ちち"],["は"],["子","こ"],["を"],["殺ろす","ころす"],["ため"],["に"],["渡","わたし"],["、"],["また子","またこ"],["は"],["親","おや"],["に"],["逆らって","さからって"],["立ち","たち"],["、"],["彼","かれ"],["ら"],["を"],["殺させるで","ころさせるで"],["あろう"],["。"]]},{"verse":22,"text":"またあなたがたは、わたしの名,なのゆえにすべての人,ひとに憎,にくまれるであろう。しかし、最後,さいごまで耐,たえ忍,しのぶ者,ものは救,すくわれる。","tok":[["また"],["あなた"],["がた"],["は"],["、"],["わたし"],["の"],["名","な"],["の"],["ゆえ"],["に"],["すべて"],["の"],["人","ひと"],["に"],["憎まれるで","にくまれるで"],["あろう"],["。"],["しかし"],["、"],["最後","さいご"],["まで"],["耐え","たえ"],["忍者","しのぶもの"],["は"],["救われる","すくわれる"],["。"]]},{"verse":23,"text":"一つの町,まちで迫害,はくがいされたなら、他,たの町,まちへ逃,にげなさい。よく言,いっておく。あなたがたがイスラエルの町々,まちまちを回,まわり終,おわらないうちに、人,ひとの子,こは来,くるであろう。","tok":[["一","ひと"],["つ"],["の"],["町","まち"],["で"],["迫害","はくがい"],["されたなら"],["、"],["他","た"],["の"],["町","まち"],["へ"],["逃","にげ"],["なさい"],["。"],["よく"],["言って","いって"],["おく"],["。"],["あなた"],["がた"],["が"],["イスラエル"],["の"],["町々","まちまち"],["を"],["回わり","まわり"],["終わらない","おわらない"],["うち"],["に"],["、"],["人","ひと"],["の"],["子","こ"],["は"],["来るで","くるで"],["あろう"],["。"]]},{"verse":24,"text":"弟子,でしはその師,し以上,いじょうのものではなく、僕,しもべはその主人,しゅじん以上,いじょうの者,ものではない。","tok":[["弟子","でし"],["は"],["その"],["師","し"],["以上","いじょう"],["の"],["もの"],["で"],["は"],["なく"],["、"],["僕","し"],["も"],["べ"],["は"],["その"],["主人","しゅじん"],["以上","いじょう"],["の"],["者","もの"],["で"],["は"],["ない"],["。"]]},{"verse":25,"text":"弟子,でしがその師,しのようであり、僕,しもべがその主人,しゅじんのようであれば、それで十分,じゅうぶんである。もし家,いえの主人,しゅじんがベルゼブルと言,いわれるならば、その家,いえの者,ものどもはなおさら、どんなにか悪,わるく言,いわれることであろう。","tok":[["弟子","でし"],["が"],["その"],["師","し"],["の"],["よう"],["で"],["あり"],["、"],["僕","し"],["も"],["べ"],["が"],["その"],["主人","しゅじん"],["の"],["よう"],["で"],["あれば"],["、"],["それ"],["で"],["十分","じゅうぶん"],["で"],["ある"],["。"],["もし"],["家","いえ"],["の"],["主人","しゅじん"],["が"],["ベルゼブル"],["と"],["言われるならば","いわれるならば"],["、"],["その"],["家","いえ"],["の"],["者","もの"],["ども"],["は"],["なおさら"],["、"],["どんな"],["に"],["か"],["悪く","わるく"],["言われる","いわれる"],["こと"],["で"],["あろう"],["。"]]},{"verse":26,"text":"だから彼,かれらを恐,おそれるな。おおわれたもので、現,あらわれてこないものはなく、隠,かくれているもので、知,しられてこないものはない。","tok":[["だ"],["から"],["彼","かれ"],["ら"],["を"],["恐れる","おそれる"],["な"],["。"],["おおわれた"],["もの"],["で"],["、"],["現われて","あらわれて"],["こない"],["もの"],["は"],["なく"],["、"],["隠れて","かくれて"],["いる"],["もの"],["で"],["、"],["知られて","しられて"],["こない"],["もの"],["は"],["ない"],["。"]]},{"verse":27,"text":"わたしが暗,くらやみであなたがたに話,はなすことを、明,あかるみで言,いえ。耳,みみにささやかれたことを、屋根,やねの上,うえで言,いいひろめよ。","tok":[["わたし"],["が"],["暗やみ","くらやみ"],["で"],["あなた"],["がた"],["に"],["話す","はなす"],["こと"],["を"],["、"],["明かるみ","あかるみ"],["で"],["言え","いえ"],["。"],["耳","みみ"],["に"],["ささやかれた"],["こと"],["を"],["、"],["屋根","やね"],["の"],["上","うえ"],["で"],["言い","いい"],["ひろめよ"],["。"]]},{"verse":28,"text":"また、からだを殺,ころしても、魂,たましいを殺,ころすことのできない者,ものどもを恐,おそれるな。むしろ、からだも魂,たましいも地獄,じごくで滅,ほろぼす力,ちからのあるかたを恐,おそれなさい。","tok":[["また"],["、"],["からだ"],["を"],["殺ろして","ころして"],["も"],["、"],["魂","たましい"],["を"],["殺ろす","ころす"],["こと"],["の"],["できない"],["者","もの"],["ども"],["を"],["恐れる","おそれる"],["な"],["。"],["むしろ"],["、"],["からだ"],["も"],["魂","たましい"],["も"],["地獄","じごく"],["で"],["滅ぼす","ほろぼす"],["力","ちから"],["の"],["ある"],["かた"],["を"],["恐れ","おそれ"],["なさい"],["。"]]},{"verse":29,"text":"二羽,わのすずめは一アサリオンで売,うられているではないか。しかもあなたがたの父,ちちの許,ゆるしがなければ、その一羽,わも地,ちに落,おちることはない。","tok":[["二羽","わ"],["の"],["すずめ"],["は"],["一","いち"],["アサリオン"],["で"],["売られて","うられて"],["いるで"],["は"],["ない"],["か"],["。"],["しかも"],["あなた"],["がた"],["の"],["父","ちち"],["の"],["許し","ゆるし"],["が"],["なければ"],["、"],["その"],["一羽","わ"],["も"],["地","ち"],["に"],["落","おち"],["る"],["こと"],["は"],["ない"],["。"]]},{"verse":30,"text":"またあなたがたの頭,あたまの毛,けまでも、みな数,かぞえられている。","tok":[["また"],["あなた"],["がた"],["の"],["頭","あたま"],["の"],["毛","け"],["まで"],["も"],["、"],["みな"],["数えられて","かぞえられて"],["いる"],["。"]]},{"verse":31,"text":"それだから、恐,おそれることはない。あなたがたは多,おおくのすずめよりも、まさった者,ものである。","tok":[["それ"],["だ"],["から"],["、"],["恐れる","おそれる"],["こと"],["は"],["ない"],["。"],["あなた"],["がた"],["は"],["多く","おおく"],["の"],["すずめ"],["より"],["も"],["、"],["まさった"],["者","もの"],["で"],["ある"],["。"]]},{"verse":32,"text":"だから人,ひとの前,まえでわたしを受,うけいれる者,ものを、わたしもまた、天,てんにいますわたしの父,ちちの前,まえで受,うけいれるであろう。","tok":[["だ"],["から"],["人","ひと"],["の"],["前","まえ"],["で"],["わたし"],["を"],["受","うけ"],["いれる"],["者","もの"],["を"],["、"],["わたし"],["も"],["また"],["、"],["天","てん"],["に"],["います"],["わたし"],["の"],["父","ちち"],["の"],["前","まえ"],["で"],["受","うけ"],["いれるで"],["あろう"],["。"]]},{"verse":33,"text":"しかし、人,ひとの前,まえでわたしを拒,こばむ者,ものを、わたしも天,てんにいますわたしの父,ちちの前,まえで拒,こばむであろう。","tok":[["しかし"],["、"],["人","ひと"],["の"],["前","まえ"],["で"],["わたし"],["を"],["拒む","こばむ"],["者","もの"],["を"],["、"],["わたし"],["も"],["天","てん"],["に"],["います"],["わたし"],["の"],["父","ちち"],["の"],["前","まえ"],["で"],["拒むで","こばむで"],["あろう"],["。"]]},{"verse":34,"text":"地上,ちじょうに平和,へいわをもたらすために、わたしがきたと思,おもうな。平和,へいわではなく、つるぎを投,なげ込,こむためにきたのである。","tok":[["地上","ちじょう"],["に"],["平和","へいわ"],["を"],["もたらす"],["ため"],["に"],["、"],["わたし"],["が"],["きた"],["と"],["思う","おもう"],["な"],["。"],["平和","へいわ"],["で"],["は"],["なく"],["、"],["つるぎ"],["を"],["投込む","なげこむ"],["ため"],["に"],["きた"],["ので"],["ある"],["。"]]},{"verse":35,"text":"わたしがきたのは、人,ひとをその父,ちちと、娘,むすめをその母,ははと、嫁,よめをそのしゅうとめと仲,なかたがいさせるためである。","tok":[["わたし"],["が"],["きた"],["の"],["は"],["、"],["人","ひと"],["を"],["その"],["父","ちち"],["と"],["、"],["娘","むすめ"],["を"],["その"],["母","はは"],["と"],["、"],["嫁","よめ"],["を"],["その"],["しゅうとめ"],["と"],["仲たがい","なかたがい"],["させる"],["ため"],["で"],["ある"],["。"]]},{"verse":36,"text":"そして家,いえの者,ものが、その人,ひとの敵,てきとなるであろう。","tok":[["そして"],["家","いえ"],["の"],["者","もの"],["が"],["、"],["その"],["人","ひと"],["の"],["敵","てき"],["と"],["なるで"],["あろう"],["。"]]},{"verse":37,"text":"わたしよりも父,ちちまたは母,ははを愛,あいする者,ものは、わたしにふさわしくない。わたしよりもむすこや娘,むすめを愛,あいする者,ものは、わたしにふさわしくない。","tok":[["わたし"],["より"],["も"],["父","ちち"],["また"],["は"],["母","はは"],["を"],["愛する","あいする"],["者","もの"],["は"],["、"],["わたし"],["に"],["ふさわしく"],["ない"],["。"],["わたし"],["より"],["も"],["むすこ"],["や"],["娘","むすめ"],["を"],["愛する","あいする"],["者","もの"],["は"],["、"],["わたし"],["に"],["ふさわしく"],["ない"],["。"]]},{"verse":38,"text":"また自分,じぶんの十字架,じゅうじかをとってわたしに従,したがってこない者,ものはわたしにふさわしくない。","tok":[["また"],["自分","じぶん"],["の"],["十字架","じゅうじか"],["を"],["とって"],["わたし"],["に"],["従って","したがって"],["こない"],["者","もの"],["は"],["わたし"],["に"],["ふさわしく"],["ない"],["。"]]},{"verse":39,"text":"自分,じぶんの命,いのちを得,えている者,ものはそれを失,うしない、わたしのために自分,じぶんの命,いのちを失,うしなっている者,ものは、それを得,えるであろう。","tok":[["自分","じぶん"],["の"],["命","いのち"],["を"],["得て","えて"],["いる"],["者","もの"],["は"],["それ"],["を"],["失ない","うしない"],["、"],["わたし"],["の"],["ため"],["に"],["自分","じぶん"],["の"],["命","いのち"],["を"],["失なって","うしなって"],["いる"],["者","もの"],["は"],["、"],["それ"],["を"],["得るで","えるで"],["あろう"],["。"]]},{"verse":40,"text":"あなたがたを受,うけいれる者,ものは、わたしを受,うけいれるのである。わたしを受,うけいれる者,ものは、わたしをおつかわしになったかたを受,うけいれるのである。","tok":[["あなた"],["がた"],["を"],["受","うけ"],["いれる"],["者","もの"],["は"],["、"],["わたし"],["を"],["受","うけ"],["いれる"],["ので"],["ある"],["。"],["わたし"],["を"],["受","うけ"],["いれる"],["者","もの"],["は"],["、"],["わたし"],["を"],["おつかわし"],["に"],["なった"],["かた"],["を"],["受","うけ"],["いれる"],["ので"],["ある"],["。"]]},{"verse":41,"text":"預言者,よげんしゃの名,なのゆえに預言者,よげんしゃを受,うけいれる者,ものは、預言者,よげんしゃの報,むくいを受,うけ、義人,ぎじんの名,なのゆえに義人,ぎじんを受,うけいれる者,ものは、義人,ぎじんの報,むくいを受,うけるであろう。","tok":[["預言者","よげんしゃ"],["の"],["名","な"],["の"],["ゆえ"],["に"],["預言者","よげんしゃ"],["を"],["受","うけ"],["いれる"],["者","もの"],["は"],["、"],["預言者","よげんしゃ"],["の"],["報い","むくい"],["を"],["受け","うけ"],["、"],["義人","ぎじん"],["の"],["名","な"],["の"],["ゆえ"],["に"],["義人","ぎじん"],["を"],["受","うけ"],["いれる"],["者","もの"],["は"],["、"],["義人","ぎじん"],["の"],["報い","むくい"],["を"],["受るで","うけるで"],["あろう"],["。"]]},{"verse":42,"text":"わたしの弟子,でしであるという名,なのゆえに、この小,ちいさい者,もののひとりに冷,つめたい水,みず一杯,ぱいでも飲,のませてくれる者,ものは、よく言,いっておくが、決,けっしてその報,むくいからもれることはない」。","tok":[["わたし"],["の"],["弟子","でし"],["で"],["ある"],["と"],["いう"],["名","な"],["の"],["ゆえ"],["に"],["、"],["この"],["小さい","ちいさい"],["者","もの"],["の"],["ひとり"],["に"],["冷たい","つめたい"],["水","みず"],["一杯","ぱい"],["で"],["も"],["飲ませて","のませて"],["くれる"],["者","もの"],["は"],["、"],["よく"],["言って","いって"],["おく"],["が"],["、"],["決っして","けっして"],["その"],["報い","むくい"],["から"],["もれる"],["こと"],["は"],["ない"],["」"],["。"]]}]
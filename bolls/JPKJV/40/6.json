[{"verse":1,"text":"自分,じぶんの義,ぎを、見,みられるために人,ひとの前,まえで行,おこなわないように、注意,ちゅういしなさい。もし、そうしないと、天,てんにいますあなたがたの父,ちちから報,むくいを受,うけることがないであろう。","tok":[["自分","じぶん"],["の"],["義","ぎ"],["を"],["、"],["見られる","みられる"],["ため"],["に"],["人","ひと"],["の"],["前","まえ"],["で"],["行なわない","おこなわない"],["よう"],["に"],["、"],["注意","ちゅうい"],["し"],["なさい"],["。"],["もし"],["、"],["そう"],["しない"],["と"],["、"],["天","てん"],["に"],["います"],["あなた"],["がた"],["の"],["父","ちち"],["から"],["報い","むくい"],["を"],["受る","うける"],["こと"],["が"],["ないで"],["あろう"],["。"]]},{"verse":2,"text":"だから、施,ほどこしをする時,ときには、偽善者,ぎぜんしゃたちが人,ひとにほめられるため会堂,かいどうや町,まちの中,なかでするように、自分,じぶんの前,まえでラッパを吹,ふきならすな。よく言,いっておくが、彼,かれらはその報,むくいを受,うけてしまっている。","tok":[["だ"],["から"],["、"],["施し","ほどこし"],["を"],["する"],["時","とき"],["に"],["は"],["、"],["偽善者","ぎぜんしゃ"],["たち"],["が"],["人","ひと"],["に"],["ほめられる"],["ため"],["会堂","かいどう"],["や"],["町","まち"],["の"],["中","なか"],["で"],["する"],["よう"],["に"],["、"],["自分","じぶん"],["の"],["前","まえ"],["で"],["ラッパ"],["を"],["吹","ふき"],["ならす"],["な"],["。"],["よく"],["言って","いって"],["おく"],["が"],["、"],["彼","かれ"],["ら"],["は"],["その"],["報い","むくい"],["を"],["受て","うけて"],["しまって"],["いる"],["。"]]},{"verse":3,"text":"あなたは施,ほどこしをする場合,ばあい、右,みぎの手,てのしていることを左,ひだりの手,てに知,しらせるな。","tok":[["あなた"],["は"],["施し","ほどこし"],["を"],["する"],["場合","ばあい"],["、"],["右","みぎ"],["の"],["手","て"],["の"],["して"],["いる"],["こと"],["を"],["左","ひだり"],["の"],["手","て"],["に"],["知らせる","しらせる"],["な"],["。"]]},{"verse":4,"text":"それは、あなたのする施,ほどこしが隠,かくれているためである。すると、隠,かくれた事,ことを見,みておられるあなたの父,ちちは、報,むくいてくださるであろう。","tok":[["それ"],["は"],["、"],["あなた"],["の"],["する"],["施し","ほどこし"],["が"],["隠れて","かくれて"],["いる"],["ため"],["で"],["ある"],["。"],["する"],["と"],["、"],["隠れた","かくれた"],["事","こと"],["を"],["見て","みて"],["おられる"],["あなた"],["の"],["父","ちち"],["は"],["、"],["報いて","むくいて"],["くださるで"],["あろう"],["。"]]},{"verse":5,"text":"また祈,いのる時,ときには、偽善者,ぎぜんしゃたちのようにするな。彼,かれらは人,ひとに見,みせようとして、会堂,かいどうや大通,おおどおりのつじに立,たって祈,いのることを好,このむ。よく言,いっておくが、彼,かれらはその報,むくいを受,うけてしまっている。","tok":[["また"],["祈る","いのる"],["時","とき"],["に"],["は"],["、"],["偽善者","ぎぜんしゃ"],["たち"],["の"],["よう"],["に"],["する"],["な"],["。"],["彼","かれ"],["ら"],["は"],["人","ひと"],["に"],["見せよう","みせよう"],["として"],["、"],["会堂","かいどう"],["や"],["大通り","おおどおり"],["の"],["つじ"],["に"],["立って","たって"],["祈る","いのる"],["こと"],["を"],["好む","このむ"],["。"],["よく"],["言って","いって"],["おく"],["が"],["、"],["彼","かれ"],["ら"],["は"],["その"],["報い","むくい"],["を"],["受て","うけて"],["しまって"],["いる"],["。"]]},{"verse":6,"text":"あなたは祈,いのる時,とき、自分,じぶんのへやにはいり、戸,とを閉,とじて、隠,かくれた所,ところにおいでになるあなたの父,ちちに祈,いのりなさい。すると、隠,かくれた事,ことを見,みておられるあなたの父,ちちは、報,むくいてくださるであろう。","tok":[["あなた"],["は"],["祈る","いのる"],["時","とき"],["、"],["自分","じぶん"],["の"],["へや"],["に"],["はいり"],["、"],["戸","と"],["を"],["閉じて","とじて"],["、"],["隠れた","かくれた"],["所","ところ"],["に"],["おいで"],["に"],["なる"],["あなた"],["の"],["父","ちち"],["に"],["祈","いのり"],["なさい"],["。"],["する"],["と"],["、"],["隠れた","かくれた"],["事","こと"],["を"],["見て","みて"],["おられる"],["あなた"],["の"],["父","ちち"],["は"],["、"],["報いて","むくいて"],["くださるで"],["あろう"],["。"]]},{"verse":7,"text":"また、祈,いのる場合,ばあい、異邦人,いほうじんのように、くどくどと祈,いのるな。彼,かれらは言葉,ことばかずが多,おおければ、聞,ききいれられるものと思,おもっている。","tok":[["また"],["、"],["祈る","いのる"],["場合","ばあい"],["、"],["異邦人","いほうじん"],["の"],["よう"],["に"],["、"],["くどくど"],["と"],["祈る","いのる"],["な"],["。"],["彼","かれ"],["ら"],["は"],["言葉","ことば"],["かず"],["が"],["多ければ","おおければ"],["、"],["聞きいれられる","ききいれられる"],["もの"],["と"],["思って","おもって"],["いる"],["。"]]},{"verse":8,"text":"だから、彼,かれらのまねをするな。あなたがたの父,ちちなる神,かみは、求,もとめない先,さきから、あなたがたに必要,ひつようなものはご存,ぞんじなのである。","tok":[["だ"],["から"],["、"],["彼","かれ"],["ら"],["の"],["まね"],["を"],["する"],["な"],["。"],["あなた"],["がた"],["の"],["父","ちち"],["なる"],["神","かみ"],["は"],["、"],["求めない","もとめない"],["先","さき"],["から"],["、"],["あなた"],["がた"],["に"],["必要","ひつよう"],["な"],["もの"],["は"],["ご存じ","ごぞんじ"],["な"],["ので"],["ある"],["。"]]},{"verse":9,"text":"だから、あなたがたはこう祈,いのりなさい、天,てんにいますわれらの父,ちちよ、御名,みながあがめられますように。","tok":[["だ"],["から"],["、"],["あなた"],["がた"],["は"],["こう"],["祈","いのり"],["なさい"],["、"],["天","てん"],["に"],["います"],["われ"],["ら"],["の"],["父","ちち"],["よ"],["、"],["御名","みな"],["が"],["あがめられます"],["よう"],["に"],["。"]]},{"verse":10,"text":"御国,みくにがきますように。みこころが天,てんに行,おこなわれるとおり、地,ちにも行,おこなわれますように。","tok":[["御国","みくに"],["が"],["きます"],["よう"],["に"],["。"],["みこころ"],["が"],["天","てん"],["に"],["行なわれる","おこなわれる"],["とおり"],["、"],["地","ち"],["に"],["も"],["行なわれます","おこなわれます"],["よう"],["に"],["。"]]},{"verse":11,"text":"わたしたちの日,ひごとの食物,しょくもつを、きょうもお与,あたえください。","tok":[["わたしたち"],["の"],["日ごと","ひごと"],["の"],["食物","しょくもつ"],["を"],["、"],["きょう"],["も"],["お与え","おあたえ"],["ください"],["。"]]},{"verse":12,"text":"わたしたちに負債,ふさいのある者,ものをゆるしましたように、わたしたちの負債,ふさいをもおゆるしください。","tok":[["わたしたち"],["に"],["負債","ふさい"],["の"],["ある"],["者","もの"],["を"],["ゆるしました"],["よう"],["に"],["、"],["わたしたち"],["の"],["負債","ふさい"],["を"],["も"],["おゆるし"],["ください"],["。"]]},{"verse":13,"text":"わたしたちを試,こころみに会,あわせないで、悪,あしき者,ものからお救,すくいください。","tok":[["わたしたち"],["を"],["試み","こころみ"],["に"],["会わせないで","あわせないで"],["、"],["悪しき","あしき"],["者","もの"],["から"],["お救い","おすくい"],["ください"],["。"]]},{"verse":14,"text":"もしも、あなたがたが、人々,ひとびとのあやまちをゆるすならば、あなたがたの天,てんの父,ちちも、あなたがたをゆるして下,くださるであろう。","tok":[["もし"],["も"],["、"],["あなた"],["が"],["た"],["が"],["、"],["人々","ひとびと"],["の"],["あやまち"],["を"],["ゆるすならば"],["、"],["あなた"],["がた"],["の"],["天","てん"],["の"],["父","ちち"],["も"],["、"],["あなた"],["がた"],["を"],["ゆるして"],["下さるで","くださるで"],["あろう"],["。"]]},{"verse":15,"text":"もし人,ひとをゆるさないならば、あなたがたの父,ちちも、あなたがたのあやまちをゆるして下,くださらないであろう。","tok":[["もし"],["人","ひと"],["を"],["ゆるさないならば"],["、"],["あなた"],["がた"],["の"],["父","ちち"],["も"],["、"],["あなた"],["がた"],["の"],["あやまち"],["を"],["ゆるして"],["下さらないで","くださらないで"],["あろう"],["。"]]},{"verse":16,"text":"また断食,だんじきをする時,ときには、偽善者,ぎぜんしゃがするように、陰気,いんきな顔,かおつきをするな。彼,かれらは断食,だんじきをしていることを人,ひとに見,みせようとして、自分,じぶんの顔,かおを見苦,みぐるしくするのである。よく言,いっておくが、彼,かれらはその報,むくいを受,うけてしまっている。","tok":[["また"],["断食","だんじき"],["を"],["する"],["時","とき"],["に"],["は"],["、"],["偽善者","ぎぜんしゃ"],["が"],["する"],["よう"],["に"],["、"],["陰気","いんき"],["な"],["顔つき","かおつき"],["を"],["する"],["な"],["。"],["彼","かれ"],["ら"],["は"],["断食","だんじき"],["を"],["して"],["いる"],["こと"],["を"],["人","ひと"],["に"],["見せよう","みせよう"],["として"],["、"],["自分","じぶん"],["の"],["顔","かお"],["を"],["見苦しく","みぐるしく"],["する"],["ので"],["ある"],["。"],["よく"],["言って","いって"],["おく"],["が"],["、"],["彼","かれ"],["ら"],["は"],["その"],["報い","むくい"],["を"],["受て","うけて"],["しまって"],["いる"],["。"]]},{"verse":17,"text":"あなたがたは断食,だんじきをする時,ときには、自分,じぶんの頭,あたまに油,あぶらを塗,ぬり、顔,かおを洗,あらいなさい。","tok":[["あなた"],["がた"],["は"],["断食","だんじき"],["を"],["する"],["時","とき"],["に"],["は"],["、"],["自分","じぶん"],["の"],["頭","あたま"],["に"],["油","あぶら"],["を"],["塗","ぬり"],["、"],["顔","かお"],["を"],["洗","あらい"],["なさい"],["。"]]},{"verse":18,"text":"それは断食,だんじきをしていることが人,ひとに知,しれないで、隠,かくれた所,ところにおいでになるあなたの父,ちちに知,しられるためである。すると、隠,かくれた事,ことを見,みておられるあなたの父,ちちは、報,むくいて下,くださるであろう。","tok":[["それ"],["は"],["断食","だんじき"],["を"],["して"],["いる"],["こと"],["が"],["人","ひと"],["に"],["知れないで","しれないで"],["、"],["隠れた","かくれた"],["所","ところ"],["に"],["おいで"],["に"],["なる"],["あなた"],["の"],["父","ちち"],["に"],["知られる","しられる"],["ため"],["で"],["ある"],["。"],["する"],["と"],["、"],["隠れた","かくれた"],["事","こと"],["を"],["見て","みて"],["おられる"],["あなた"],["の"],["父","ちち"],["は"],["、"],["報いて","むくいて"],["下さるで","くださるで"],["あろう"],["。"]]},{"verse":19,"text":"あなたがたは自分,じぶんのために、虫,むしが食,くい、さびがつき、また、盗人,ぬすびとらが押,おし入,いって盗,ぬすみ出,だすような地上,ちじょうに、宝,たからをたくわえてはならない。","tok":[["あなた"],["がた"],["は"],["自分","じぶん"],["の"],["ため"],["に"],["、"],["虫","むし"],["が"],["食い","くい"],["、"],["さび"],["が"],["つき"],["、"],["また"],["、"],["盗人","ぬすびと"],["ら"],["が"],["押入って","おしいって"],["盗み出す","ぬすみだす"],["よう"],["な"],["地上","ちじょう"],["に"],["、"],["宝","たから"],["を"],["たくわえて"],["は"],["ならない"],["。"]]},{"verse":20,"text":"むしろ自分,じぶんのため、虫,むしも食,くわず、さびもつかず、また、盗人,ぬすびとらが押,おし入,いって盗,ぬすみ出,だすこともない天,てんに、宝,たからをたくわえなさい。","tok":[["むしろ"],["自分","じぶん"],["の"],["ため"],["、"],["虫","むし"],["も"],["食わず","くわず"],["、"],["さび"],["も"],["つかず"],["、"],["また"],["、"],["盗人","ぬすびと"],["ら"],["が"],["押入って","おしいって"],["盗み出す","ぬすみだす"],["こと"],["も"],["ない"],["天","てん"],["に"],["、"],["宝","たから"],["を"],["たくわえ"],["なさい"],["。"]]},{"verse":21,"text":"あなたの宝,たからのある所,ところには、心,こころもあるからである。","tok":[["あなた"],["の"],["宝","たから"],["の"],["ある"],["所","ところ"],["に"],["は"],["、"],["心","こころ"],["も"],["ある"],["から"],["で"],["ある"],["。"]]},{"verse":22,"text":"目,めはからだのあかりである。だから、あなたの目,めが澄,すんでおれば、全身,ぜんしんも明,あかるいだろう。","tok":[["目","め"],["は"],["からだ"],["の"],["あかり"],["で"],["ある"],["。"],["だ"],["から"],["、"],["あなた"],["の"],["目","め"],["が"],["澄んで","すんで"],["おれば"],["、"],["全身","ぜんしん"],["も"],["明かるいだろう","あかるいだろう"],["。"]]},{"verse":23,"text":"しかし、あなたの目,めが悪,わるければ、全身,ぜんしんも暗,くらいだろう。だから、もしあなたの内,うちなる光,ひかりが暗,くらければ、その暗,くらさは、どんなであろう。","tok":[["しかし"],["、"],["あなた"],["の"],["目","め"],["が"],["悪ければ","わるければ"],["、"],["全身","ぜんしん"],["も"],["暗いだろう","くらいだろう"],["。"],["だ"],["から"],["、"],["もし"],["あなた"],["の"],["内","うち"],["なる"],["光","ひかり"],["が"],["暗ければ","くらければ"],["、"],["その"],["暗","くら"],["さ"],["は"],["、"],["どんな"],["で"],["あろう"],["。"]]},{"verse":24,"text":"だれも、ふたりの主人,しゅじんに兼,かね仕,つかえることはできない。一方,いっぽうを憎,にくんで他方,たほうを愛,あいし、あるいは、一方,いっぽうに親,したしんで他方,たほうをうとんじるからである。あなたがたは、神,かみと富,とみとに兼,かね仕,つかえることはできない。","tok":[["だれ"],["も"],["、"],["ふたり"],["の"],["主人","しゅじん"],["に"],["兼ね仕える","かねつかえる"],["こと"],["は"],["できない"],["。"],["一方","いっぽう"],["を"],["憎んで","にくんで"],["他方","たほう"],["を"],["愛し","あいし"],["、"],["あるいは"],["、"],["一方","いっぽう"],["に"],["親しんで","したしんで"],["他方","たほう"],["を"],["うとんじる"],["から"],["で"],["ある"],["。"],["あなた"],["がた"],["は"],["、"],["神","かみ"],["と"],["富","とみ"],["と"],["に"],["兼ね仕える","かねつかえる"],["こと"],["は"],["できない"],["。"]]},{"verse":25,"text":"それだから、あなたがたに言,いっておく。何,なにを食,たべようか、何,なにを飲,のもうかと、自分,じぶんの命,いのちのことで思,おもいわずらい、何,なにを着,きようかと自分,じぶんのからだのことで思,おもいわずらうな。命,いのちは食物,しょくもつにまさり、からだは着物,きものにまさるではないか。","tok":[["それ"],["だ"],["から"],["、"],["あなた"],["がた"],["に"],["言って","いって"],["おく"],["。"],["何に","なに"],["を"],["食べよう","たべよう"],["か"],["、"],["何に","なに"],["を"],["飲もう","のもう"],["か"],["と"],["、"],["自分","じぶん"],["の"],["命","いのち"],["の"],["こと"],["で"],["思いわずらい","おもいわずらい"],["、"],["何に","なに"],["を"],["着よう","きよう"],["か"],["と"],["自分","じぶん"],["の"],["からだ"],["の"],["こと"],["で"],["思いわずらう","おもいわずらう"],["な"],["。"],["命","いのち"],["は"],["食物","しょくもつ"],["に"],["まさり"],["、"],["からだ"],["は"],["着物","きもの"],["に"],["まさる"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":26,"text":"空,そらの鳥,とりを見,みるがよい。まくことも、刈,かることもせず、倉,くらに取,とりいれることもしない。それだのに、あなたがたの天,てんの父,ちちは彼,かれらを養,やしなっていて下,くださる。あなたがたは彼,かれらよりも、はるかにすぐれた者,ものではないか。","tok":[["空","そら"],["の"],["鳥","とり"],["を"],["見る","みる"],["が"],["よい"],["。"],["まく"],["こと"],["も"],["、"],["刈る","かる"],["こと"],["も"],["せず"],["、"],["倉","くら"],["に"],["取","とり"],["いれる"],["こと"],["も"],["しない"],["。"],["それ"],["だ"],["のに"],["、"],["あなた"],["がた"],["の"],["天","てん"],["の"],["父","ちち"],["は"],["彼","かれ"],["ら"],["を"],["養って","やしなって"],["いて"],["下さる","くださる"],["。"],["あなた"],["がた"],["は"],["彼","かれ"],["ら"],["より"],["も"],["、"],["はるか"],["に"],["すぐれた"],["者","もの"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":27,"text":"あなたがたのうち、だれが思,おもいわずらったからとて、自分,じぶんの寿命,じゅみょうをわずかでも延,のばすことができようか。","tok":[["あなた"],["がた"],["の"],["うち"],["、"],["だれ"],["が"],["思いわずらった","おもいわずらった"],["から"],["とて"],["、"],["自分","じぶん"],["の"],["寿命","じゅみょう"],["を"],["わずか"],["で"],["も"],["延ばす","のばす"],["こと"],["が"],["できよう"],["か"],["。"]]},{"verse":28,"text":"また、なぜ、着物,きもののことで思,おもいわずらうのか。野,のの花,はながどうして育,そだっているか、考,かんがえて見,みるがよい。働,はたらきもせず、紡,つむぎもしない。","tok":[["また"],["、"],["なぜ"],["、"],["着物","きもの"],["の"],["こと"],["で"],["思いわずらう","おもいわずらう"],["の"],["か"],["。"],["野","の"],["の"],["花","はな"],["が"],["どう"],["して"],["育って","そだって"],["いる"],["か"],["、"],["考","かんがえ"],["て"],["見る","みる"],["が"],["よい"],["。"],["働らき","はたらき"],["も"],["せず"],["、"],["紡ぎ","つむぎ"],["も"],["しない"],["。"]]},{"verse":29,"text":"しかし、あなたがたに言,いうが、栄華,えいがをきわめた時,ときのソロモンでさえ、この花,はなの一つほどにも着飾,きかざってはいなかった。","tok":[["しかし"],["、"],["あなた"],["がた"],["に"],["言う","いう"],["が"],["、"],["栄華","えいが"],["を"],["きわめた"],["時","とき"],["の"],["ソロモン"],["で"],["さえ"],["、"],["この"],["花","はな"],["の"],["一","ひと"],["つ"],["ほど"],["に"],["も"],["着飾って","きかざって"],["は"],["いなかった"],["。"]]},{"verse":30,"text":"きょうは生,はえていて、あすは炉,ろに投,なげ入,いれられる野,のの草,くさでさえ、神,かみはこのように装,よそおって下,くださるのなら、あなたがたに、それ以上,いじょうよくしてくださらないはずがあろうか。ああ、信仰,しんこうの薄,うすい者,ものたちよ。","tok":[["きょう"],["は"],["生えて","はえて"],["いて"],["、"],["あす"],["は"],["炉","ろ"],["に"],["投入れられる","なげいれられる"],["野","の"],["の"],["草","くさ"],["で"],["さえ"],["、"],["神","かみ"],["は"],["この"],["よう"],["に"],["装って","よそおって"],["下さる","くださる"],["の"],["なら"],["、"],["あなた"],["がた"],["に"],["、"],["それ"],["以上","いじょう"],["よく"],["して"],["くださらない"],["はず"],["が"],["あろう"],["か"],["。"],["ああ"],["、"],["信仰","しんこう"],["の"],["薄い","うすい"],["者","もの"],["たち"],["よ"],["。"]]},{"verse":31,"text":"だから、何,なにを食,たべようか、何,なにを飲,のもうか、あるいは何,なにを着,きようかと言,いって思,おもいわずらうな。","tok":[["だ"],["から"],["、"],["何に","なに"],["を"],["食べよう","たべよう"],["か"],["、"],["何に","なに"],["を"],["飲もう","のもう"],["か"],["、"],["あるいは"],["何に","なに"],["を"],["着よう","きよう"],["か"],["と"],["言って","いって"],["思いわずらう","おもいわずらう"],["な"],["。"]]},{"verse":32,"text":"これらのものはみな、異邦人,いほうじんが切,せつに求,もとめているものである。あなたがたの天,てんの父,ちちは、これらのものが、ことごとくあなたがたに必要,ひつようであることをご存,ぞんじである。","tok":[["これ"],["ら"],["の"],["もの"],["は"],["みな"],["、"],["異邦人","いほうじん"],["が"],["切に","せつに"],["求めて","もとめて"],["いる"],["もの"],["で"],["ある"],["。"],["あなた"],["がた"],["の"],["天","てん"],["の"],["父","ちち"],["は"],["、"],["これ"],["ら"],["の"],["もの"],["が"],["、"],["ことごとく"],["あなた"],["がた"],["に"],["必要","ひつよう"],["で"],["ある"],["こと"],["を"],["ご存じ","ごぞんじ"],["で"],["ある"],["。"]]},{"verse":33,"text":"まず神,かみの国,くにと神,かみの義,ぎとを求,もとめなさい。そうすれば、これらのものは、すべて添,そえて与,あたえられるであろう。","tok":[["まず"],["神","かみ"],["の"],["国","くに"],["と"],["神","かみ"],["の"],["義","ぎ"],["と"],["を"],["求め","もとめ"],["なさい"],["。"],["そう"],["すれば"],["、"],["これ"],["ら"],["の"],["もの"],["は"],["、"],["すべて"],["添えて","そえて"],["与えられるで","あたえられるで"],["あろう"],["。"]]},{"verse":34,"text":"だから、あすのことを思,おもいわずらうな。あすのことは、あす自身,じしんが思,おもいわずらうであろう。一日,にちの苦労,くろうは、その日,ひ一日,にちだけで十分,じゅうぶんである。","tok":[["だ"],["から"],["、"],["あす"],["の"],["こと"],["を"],["思いわずらう","おもいわずらう"],["な"],["。"],["あす"],["の"],["こと"],["は"],["、"],["あす"],["自身","じしん"],["が"],["思いわずらうで","おもいわずらうで"],["あろう"],["。"],["一","いち"],["日","にち"],["の"],["苦労","くろう"],["は"],["、"],["その"],["日","ひ"],["一","いち"],["日","にち"],["ち"],["だけ"],["で"],["十分","じゅうぶん"],["で"],["ある"],["。"]]}]
[{"verse":1,"text":"そのとき、弟子,でしたちがイエスのもとにきて言,いった、「いったい、天国,てんごくではだれがいちばん偉,えらいのですか」。","tok":[["その"],["とき"],["、"],["弟子","でし"],["たち"],["が"],["イエス"],["の"],["もと"],["に"],["きて"],["言った","いった"],["、"],["「"],["いったい"],["、"],["天国","てんごく"],["で"],["は"],["だれ"],["が"],["いちばん"],["偉い","えらい"],["の"],["です"],["か"],["」"],["。"]]},{"verse":2,"text":"すると、イエスは幼,おさな子,ごを呼,よび寄,よせ、彼,かれらのまん中,なかに立,たたせて言,いわれた、","tok":[["する"],["と"],["、"],["イエス"],["は"],["幼な子","おさなご"],["を"],["呼び寄せ","よびよせ"],["、"],["彼","かれ"],["ら"],["の"],["まん中","まんなか"],["に"],["立たせて","たたせて"],["言われた","いわれた"],["、"]]},{"verse":3,"text":"「よく聞,ききなさい。心,こころをいれかえて幼,おさな子,ごのようにならなければ、天国,てんごくにはいることはできないであろう。","tok":[["「"],["よく"],["聞","きき"],["なさい"],["。"],["心","こころ"],["を"],["いれかえて"],["幼な子","おさなご"],["の"],["よう"],["に"],["ならなければ"],["、"],["天国","てんごく"],["に"],["はいる"],["こと"],["は"],["できないで"],["あろう"],["。"]]},{"verse":4,"text":"この幼,おさな子,ごのように自分,じぶんを低,ひくくする者,ものが、天国,てんごくでいちばん偉,えらいのである。","tok":[["この"],["幼な子","おさなご"],["の"],["よう"],["に"],["自分","じぶん"],["を"],["低く","ひくく"],["する"],["者","もの"],["が"],["、"],["天国","てんごく"],["で"],["いちばん"],["偉い","えらい"],["ので"],["ある"],["。"]]},{"verse":5,"text":"また、だれでも、このようなひとりの幼,おさな子,ごを、わたしの名,なのゆえに受,うけいれる者,ものは、わたしを受,うけいれるのである。","tok":[["また"],["、"],["だれ"],["で"],["も"],["、"],["この"],["よう"],["な"],["ひとり"],["の"],["幼な子","おさなご"],["を"],["、"],["わたし"],["の"],["名","な"],["の"],["ゆえ"],["に"],["受","うけ"],["いれる"],["者","もの"],["は"],["、"],["わたし"],["を"],["受","うけ"],["いれる"],["ので"],["ある"],["。"]]},{"verse":6,"text":"しかし、わたしを信,しんずるこれらの小,ちいさい者,もののひとりをつまずかせる者,ものは、大,おおきなひきうすを首,くびにかけられて海,うみの深,ふかみに沈,しずめられる方,ほうが、その人,ひとの益,えきになる。","tok":[["しかし"],["、"],["わたし"],["を"],["信ずる","しんずる"],["これ"],["ら"],["の"],["小さい","ちいさい"],["者","もの"],["の"],["ひとり"],["を"],["つまずかせる"],["者","もの"],["は"],["、"],["大きな","おおきな"],["ひきうす"],["を"],["首","くび"],["に"],["かけられて"],["海","うみ"],["の"],["深み","ふかみ"],["に"],["沈められる","しずめられる"],["方","ほう"],["が"],["、"],["その"],["人","ひと"],["の"],["益","えき"],["に"],["なる"],["。"]]},{"verse":7,"text":"この世,よは、罪,つみの誘惑,ゆうわくがあるから、わざわいである。罪,つみの誘惑,ゆうわくは必,かならず来,くる。しかし、それをきたらせる人,ひとは、わざわいである。","tok":[["この世","このよ"],["は"],["、"],["罪","つみ"],["の"],["誘惑","ゆうわく"],["が"],["ある"],["から"],["、"],["わざわい"],["で"],["ある"],["。"],["罪","つみ"],["の"],["誘惑","ゆうわく"],["は"],["必","かならず"],["来る","くる"],["。"],["しかし"],["、"],["それ"],["を"],["きたらせる"],["人","ひと"],["は"],["、"],["わざわい"],["で"],["ある"],["。"]]},{"verse":8,"text":"もしあなたの片手,かたてまたは片足,かたあしが、罪,つみを犯,おかさせるなら、それを切,きって捨,すてなさい。両手,りょうて、両足,りょうあしがそろったままで、永遠,えいえんの火,ひに投,なげ込,こまれるよりは、片手,かたて、片足,かたあしになって命,いのちに入,はいる方,ほうがよい。","tok":[["もし"],["あなた"],["の"],["片手","かたて"],["また"],["は"],["片足","かたあし"],["が"],["、"],["罪","つみ"],["を"],["犯させるなら","おかさせるなら"],["、"],["それ"],["を"],["切って","きって"],["捨て","すて"],["なさい"],["。"],["両手","りょうて"],["、"],["両足","りょうあし"],["が"],["そろった"],["まま"],["で"],["、"],["永遠","えいえん"],["の"],["火","ひ"],["に"],["投込まれる","なげこまれる"],["より"],["は"],["、"],["片手","かたて"],["、"],["片足","かたあし"],["に"],["なって"],["命","いのち"],["に"],["入る","はいる"],["方","ほう"],["が"],["よい"],["。"]]},{"verse":9,"text":"もしあなたの片目,かためが罪,つみを犯,おかさせるなら、それを抜,ぬき出,だして捨,すてなさい。両,りょう眼,がんがそろったままで地獄,じごくの火,ひに投,なげ入,いれられるよりは、片目,かためになって命,いのちに入,はいる方,ほうがよい。","tok":[["もし"],["あなた"],["の"],["片目","かため"],["が"],["罪","つみ"],["を"],["犯させるなら","おかさせるなら"],["、"],["それ"],["を"],["抜き出して","ぬきだして"],["捨て","すて"],["なさい"],["。"],["両眼","りょうがん"],["が"],["そろった"],["まま"],["で"],["地獄","じごく"],["の"],["火","ひ"],["に"],["投入れられる","なげいれられる"],["より"],["は"],["、"],["片目","かため"],["に"],["なって"],["命","いのち"],["に"],["入る","はいる"],["方","ほう"],["が"],["よい"],["。"]]},{"verse":10,"text":"あなたがたは、これらの小,ちいさい者,もののひとりをも軽,かろんじないように、気,きをつけなさい。あなたがたに言,いうが、彼,かれらの御使,みつかいたちは天,てんにあって、天,てんにいますわたしの父,ちちのみ顔,かおをいつも仰,あおいでいるのである。〔","tok":[["あなた"],["がた"],["は"],["、"],["これ"],["ら"],["の"],["小さい","ちいさい"],["者","もの"],["の"],["ひとり"],["を"],["も"],["軽んじない","かろんじない"],["よう"],["に"],["、"],["気","き"],["を"],["つけ"],["なさい"],["。"],["あなた"],["がた"],["に"],["言う","いう"],["が"],["、"],["彼","かれ"],["ら"],["の"],["御使","みつかいたち"],["は"],["天","てん"],["に"],["あって"],["、"],["天","てん"],["に"],["います"],["わたし"],["の"],["父","ちち"],["のみ"],["顔","かお"],["を"],["いつも"],["仰いで","あおいで"],["いる"],["ので"],["ある"],["。"],["〔"]]},{"verse":11,"text":"人,ひとの子,こは、滅,ほろびる者,ものを救,すくうためにきたのである。〕","tok":[["人","ひと"],["の"],["子","こ"],["は"],["、"],["滅びる","ほろびる"],["者","もの"],["を"],["救う","すくう"],["ため"],["に"],["きた"],["ので"],["ある"],["。"],["〕"]]},{"verse":12,"text":"あなたがたはどう思,おもうか。ある人,ひとに百匹,ぴきの羊,ひつじがあり、その中,なかの一匹,ぴきが迷,まよい出,でたとすれば、九十九匹,ひきを山,やまに残,のこしておいて、その迷,まよい出,でている羊,ひつじを捜,さがしに出,でかけないであろうか。","tok":[["あなた"],["がた"],["は"],["どう"],["思","おもう"],["か"],["。"],["ある"],["人","ひと"],["に"],["百匹","ぴき"],["の"],["羊","ひつじ"],["が"],["あり"],["、"],["その"],["中","なか"],["の"],["一匹","ぴ"],["き"],["が"],["迷い出た","まよいでた"],["と"],["すれば"],["、"],["九十九匹","ひき"],["を"],["山","やま"],["に"],["残して","のこして"],["おいて"],["、"],["その"],["迷い出て","まよいでて"],["いる"],["羊","ひつじ"],["を"],["捜し","さがし"],["に"],["出かけないで","でかけないで"],["あろう"],["か"],["。"]]},{"verse":13,"text":"もしそれを見,みつけたなら、よく聞,ききなさい、迷,まよわないでいる九十九匹,ひきのためよりも、むしろその一匹,ぴきのために喜,よろこぶであろう。","tok":[["もし"],["それ"],["を"],["見つけたなら","みつけたなら"],["、"],["よく"],["聞","きき"],["なさい"],["、"],["迷わないで","まよわないで"],["いる"],["九十九匹","ひき"],["の"],["ため"],["より"],["も"],["、"],["むしろ"],["その"],["一匹","ぴき"],["の"],["ため"],["に"],["喜こぶで","よろこぶで"],["あろう"],["。"]]},{"verse":14,"text":"そのように、これらの小,ちいさい者,もののひとりが滅,ほろびることは、天,てんにいますあなたがたの父,ちちのみこころではない。","tok":[["その"],["よう"],["に"],["、"],["これ"],["ら"],["の"],["小さい","ちいさい"],["者","もの"],["の"],["ひとり"],["が"],["滅びる","ほろびる"],["こと"],["は"],["、"],["天","てん"],["に"],["います"],["あなた"],["がた"],["の"],["父","ちち"],["のみ"],["こころ"],["で"],["は"],["ない"],["。"]]},{"verse":15,"text":"もしあなたの兄弟,きょうだいが罪,つみを犯,おかすなら、行,いって、彼,かれとふたりだけの所,ところで忠告,ちゅうこくしなさい。もし聞,きいてくれたら、あなたの兄弟,きょうだいを得,えたことになる。","tok":[["もし"],["あなた"],["の"],["兄弟","きょうだい"],["が"],["罪","つみ"],["を"],["犯すなら","おかすなら"],["、"],["行って","いって"],["、"],["彼","かれ"],["と"],["ふたり"],["だけ"],["の"],["所","ところ"],["で"],["忠告","ちゅうこく"],["し"],["なさい"],["。"],["もし"],["聞いて","きいて"],["くれたら"],["、"],["あなた"],["の"],["兄弟","きょうだい"],["を"],["得た","えた"],["こと"],["に"],["なる"],["。"]]},{"verse":16,"text":"もし聞,きいてくれないなら、ほかにひとりふたりを、一緒,いっしょに連,つれて行,いきなさい。それは、ふたりまたは三人,にんの証人,しょうにんの口,くちによって、すべてのことがらが確,たしかめられるためである。","tok":[["もし"],["聞いて","きいて"],["くれないなら"],["、"],["ほか"],["に"],["ひとり"],["ふたり"],["を"],["、"],["一緒","いっしょ"],["に"],["連れて","つれて"],["行き","いき"],["なさい"],["。"],["それ"],["は"],["、"],["ふたり"],["また"],["は"],["三人","にん"],["の"],["証人","しょうにん"],["の"],["口","くち"],["によって"],["、"],["すべて"],["の"],["ことがら"],["が"],["確かめられる","たしかめられる"],["ため"],["で"],["ある"],["。"]]},{"verse":17,"text":"もし彼,かれらの言,いうことを聞,きかないなら、教会,きょうかいに申,もうし出,でなさい。もし教会,きょうかいの言,いうことも聞,きかないなら、その人,ひとを異邦人,いほうじんまたは取税人,しゅぜいにん同様,どうように扱,あつかいなさい。","tok":[["もし"],["彼","かれ"],["ら"],["の"],["言う","いう"],["こと"],["を"],["聞かないなら","きかないなら"],["、"],["教会","きょうかい"],["に"],["申し出","もうしで"],["なさい"],["。"],["もし"],["教会","きょうかい"],["の"],["言う","いう"],["こと"],["も"],["聞かないなら","きかないなら"],["、"],["その"],["人","ひと"],["を"],["異邦人","いほうじん"],["また"],["は"],["取","とり"],["税人","ぜいにん"],["ぜ"],["い"],["に"],["ん"],["同様","どうよう"],["に"],["扱い","あつかい"],["なさい"],["。"]]},{"verse":18,"text":"よく言,いっておく。あなたがたが地上,ちじょうでつなぐことは、天,てんでも皆,みなつながれ、あなたがたが地上,ちじょうで解,とくことは、天,てんでもみな解,とかれるであろう。","tok":[["よく"],["言って","いって"],["おく"],["。"],["あなた"],["がた"],["が"],["地上","ちじょう"],["で"],["つなぐ"],["こと"],["は"],["、"],["天","てん"],["で"],["も"],["皆","みな"],["つながれ"],["、"],["あなた"],["がた"],["が"],["地上","ちじょう"],["で"],["解く","とく"],["こと"],["は"],["、"],["天","てん"],["で"],["も"],["みな"],["解かれるで","とかれるで"],["あろう"],["。"]]},{"verse":19,"text":"また、よく言,いっておく。もしあなたがたのうちのふたりが、どんな願,ねがい事,ごとについても地上,ちじょうで心,こころを合,あわせるなら、天,てんにいますわたしの父,ちちはそれをかなえて下,くださるであろう。","tok":[["また"],["、"],["よく"],["言って","いって"],["おく"],["。"],["もし"],["あなた"],["がた"],["の"],["うち"],["の"],["ふたり"],["が"],["、"],["どんな"],["願い事","ねがいごと"],["について"],["も"],["地上","ちじょう"],["で"],["心","こころ"],["を"],["合","あわせ"],["るなら"],["、"],["天","てん"],["に"],["います"],["わたし"],["の"],["父","ちち"],["は"],["それ"],["を"],["かなえて"],["下さるで","くださるで"],["あろう"],["。"]]},{"verse":20,"text":"ふたりまたは三人,にんが、わたしの名,なによって集,あつまっている所,ところには、わたしもその中,なかにいるのである」。","tok":[["ふたり"],["また"],["は"],["三人","にん"],["が"],["、"],["わたし"],["の"],["名","な"],["によって"],["集まって","あつまって"],["いる"],["所","ところ"],["に"],["は"],["、"],["わたし"],["も"],["その"],["中","なか"],["に"],["いる"],["ので"],["ある"],["」"],["。"]]},{"verse":21,"text":"そのとき、ペテロがイエスのもとにきて言,いった、「主,しゅよ、兄弟,きょうだいがわたしに対,たいして罪,つみを犯,おかした場合,ばあい、幾,いくたびゆるさねばなりませんか。七たびまでですか」。","tok":[["その"],["とき"],["、"],["ペテロ"],["が"],["イエス"],["の"],["もと"],["に"],["きて"],["言った","いった"],["、"],["「"],["主","しゅ"],["よ"],["、"],["兄弟","きょうだい"],["が"],["わたし"],["に対して","にたいして"],["罪","つみ"],["を"],["犯した","おかした"],["場合","ばあい"],["、"],["幾","いく"],["たび"],["ゆるさねば"],["なりません"],["か"],["。"],["七","なな"],["たび"],["まで"],["です"],["か"],["」"],["。"]]},{"verse":22,"text":"イエスは彼,かれに言,いわれた、「わたしは七たびまでとは言,いわない。七たびを七十倍,ばいするまでにしなさい。","tok":[["イエス"],["は"],["彼","かれ"],["に"],["言われた","いわれた"],["、"],["「"],["わたし"],["は"],["七","なな"],["たび"],["まで"],["と"],["は"],["言わない","いわない"],["。"],["七","なな"],["たび"],["を"],["七十","ななじゅう"],["倍","ばい"],["まで"],["に"],["し"],["なさい"],["。"]]},{"verse":23,"text":"それだから、天国,てんごくは王,おうが僕,しもべたちと決算,けっさんをするようなものだ。","tok":[["それ"],["だ"],["から"],["、"],["天国","てんごく"],["は"],["王","おう"],["が"],["僕","し"],["も"],["べた"],["ちと"],["決算","けっさん"],["を"],["する"],["よう"],["な"],["もの"],["だ"],["。"]]},{"verse":24,"text":"決算,けっさんが始,はじまると、一万タラントの負債,ふさいのある者,ものが、王,おうのところに連,つれられてきた。","tok":[["決算","けっさん"],["が"],["始まる","はじまる"],["と"],["、"],["一万","いちまん"],["タラント"],["の"],["負債","ふさい"],["の"],["ある"],["者","もの"],["が"],["、"],["王","おう"],["の"],["ところ"],["に"],["連れられて","つれられて"],["きた"],["。"]]},{"verse":25,"text":"しかし、返,かえせなかったので、主人,しゅじんは、その人,ひと自身,じしんとその妻子,さいしと持,もち物,もの全部,ぜんぶとを売,うって返,かえすように命,めいじた。","tok":[["しかし"],["、"],["返えせなかった","かえせなかった"],["ので"],["、"],["主人","しゅじん"],["は"],["、"],["その"],["人","ひと"],["自身","じしん"],["と"],["その"],["妻子","さいし"],["と"],["持物","もちもの"],["全部","ぜんぶ"],["と"],["を"],["売って","うって"],["返えす","かえす"],["よう"],["に"],["命じた","めいじた"],["。"]]},{"verse":26,"text":"そこで、この僕,しもべはひれ伏,ふして哀願,あいがんした、『どうぞお待,まちください。全部,ぜんぶお返,かえしいたしますから』。","tok":[["そこ"],["で"],["、"],["この"],["僕","し"],["も"],["べ"],["は"],["ひれ伏して","ひれふして"],["哀願","あいがん"],["した"],["、"],["『"],["どうぞ"],["お待ち","おまち"],["ください"],["。"],["全部","ぜんぶ"],["お返","おかえし"],["いたします"],["から"],["』"],["。"]]},{"verse":27,"text":"僕,しもべの主人,しゅじんはあわれに思,おもって、彼,かれをゆるし、その負債,ふさいを免,めんじてやった。","tok":[["僕","し"],["も"],["べ"],["の"],["主人","しゅじん"],["は"],["あわれ"],["に"],["思って","おもって"],["、"],["彼","かれ"],["を"],["ゆるし"],["、"],["その"],["負債","ふさい"],["を"],["免じて","めんじて"],["やった"],["。"]]},{"verse":28,"text":"その僕,しもべが出,でて行,いくと、百デナリを貸,かしているひとりの仲間,なかまに出会,であい、彼,かれをつかまえ、首,くびをしめて『借金,しゃっきんを返,かえせ』と言,いった。","tok":[["その"],["僕","し"],["も"],["べ"],["が"],["出て","でて"],["行く","いく"],["と"],["、"],["百","ひゃく"],["デナリ"],["を"],["貸","かし"],["て"],["いる"],["ひとり"],["の"],["仲間","なかま"],["に"],["出会","であい"],["、"],["彼","かれ"],["を"],["つかまえ"],["、"],["首","くび"],["を"],["しめて"],["『"],["借金","しゃっきん"],["を"],["返えせ","かえせ"],["』"],["と"],["言った","いった"],["。"]]},{"verse":29,"text":"そこでこの仲間,なかまはひれ伏,ふし、『どうか待,まってくれ。返,かえすから』と言,いって頼,たのんだ。","tok":[["そこ"],["で"],["この"],["仲間","なかま"],["は"],["ひれ伏し","ひれふし"],["、"],["『"],["どう"],["か"],["待って","まって"],["くれ"],["。"],["返えす","かえす"],["から"],["』"],["と"],["言って","いって"],["頼んだ","たのんだ"],["。"]]},{"verse":30,"text":"しかし承知,しょうちせずに、その人,ひとをひっぱって行,いって、借金,しゃっきんを返,かえすまで獄,ごくに入,いれた。","tok":[["しかし"],["承知","しょうち"],["せず"],["に"],["、"],["その"],["人","ひと"],["を"],["ひっぱって"],["行って","いって"],["、"],["借金","しゃっきん"],["を"],["返えす","かえす"],["まで"],["獄","ごく"],["に"],["入れた","いれた"],["。"]]},{"verse":31,"text":"その人,ひとの仲間,なかまたちは、この様子,ようすを見,みて、非常,ひじょうに心,こころをいため、行,いってそのことをのこらず主人,しゅじんに話,はなした。","tok":[["その"],["人","ひと"],["の"],["仲間","なかま"],["たち"],["は"],["、"],["この"],["様子","ようす"],["を"],["見て","みて"],["、"],["非常","ひじょう"],["に"],["心","こころ"],["を"],["いため"],["、"],["行って","いって"],["その"],["こと"],["を"],["のこらず"],["主人","しゅじん"],["に"],["話","はなし"],["た"],["。"]]},{"verse":32,"text":"そこでこの主人,しゅじんは彼,かれを呼,よびつけて言,いった、『悪,わるい僕,しもべ、わたしに願,ねがったからこそ、あの負債,ふさいを全部,ぜんぶゆるしてやったのだ。","tok":[["そこ"],["で"],["この"],["主人","しゅじん"],["は"],["彼","かれ"],["を"],["呼びつけて","よびつけて"],["言った","いった"],["、"],["『"],["悪い","わるい"],["僕","し"],["も"],["べ"],["、"],["わたし"],["に"],["願った","ねがった"],["から"],["こそ"],["、"],["あの"],["負債","ふさい"],["を"],["全部","ぜんぶ"],["ゆるして"],["やった"],["の"],["だ"],["。"]]},{"verse":33,"text":"わたしがあわれんでやったように、あの仲間,なかまをあわれんでやるべきではなかったか』。","tok":[["わたし"],["が"],["あわれんで"],["やった"],["よう"],["に"],["、"],["あの"],["仲間","なかま"],["を"],["あわれんで"],["やるべきで"],["は"],["なかった"],["か"],["』"],["。"]]},{"verse":34,"text":"そして主人,しゅじんは立腹,りっぷくして、負債,ふさい全部,ぜんぶを返,かえしてしまうまで、彼,かれを獄吏,ごくりに引,ひきわたした。","tok":[["そして"],["主人","しゅじん"],["は"],["立腹","りっぷく"],["して"],["、"],["負債","ふさい"],["全部","ぜんぶ"],["を"],["返","かえし"],["て"],["しまう"],["まで"],["、"],["彼","かれ"],["を"],["獄吏","ごくり"],["に"],["引","ひき"],["わたした"],["。"]]},{"verse":35,"text":"あなたがためいめいも、もし心,こころから兄弟,きょうだいをゆるさないならば、わたしの天,てんの父,ちちもまたあなたがたに対,たいして、そのようになさるであろう」。","tok":[["あなた"],["がた"],["めいめい"],["も"],["、"],["もし"],["心","こころ"],["から"],["兄弟","きょうだい"],["を"],["ゆるさないならば"],["、"],["わたし"],["の"],["天","てん"],["の"],["父","ちち"],["も"],["また"],["あなた"],["がた"],["に対して","にたいして"],["、"],["その"],["よう"],["に"],["なさるで"],["あろう"],["」"],["。"]]}]
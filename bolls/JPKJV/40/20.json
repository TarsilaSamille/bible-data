[{"verse":1,"text":"天国,てんごくは、ある家,いえの主人,しゅじんが、自分,じぶんのぶどう園,えんに労働者,ろうどうしゃを雇,やとうために、夜,よが明,あけると同時,どうじに、出,でかけて行,いくようなものである。","tok":[["天国","てんごく"],["は"],["、"],["ある"],["家","いえ"],["の"],["主人","しゅじん"],["が"],["、"],["自分","じぶん"],["の"],["ぶどう園","ぶどうえん"],["に"],["労働者","ろうどうしゃ"],["を"],["雇う","やとう"],["ため"],["に"],["、"],["夜","よ"],["が"],["明ける","あける"],["と"],["同時","どうじ"],["に"],["、"],["出かけて","でかけて"],["行く","いく"],["よう"],["な"],["もの"],["で"],["ある"],["。"]]},{"verse":2,"text":"彼,かれは労働者,ろうどうしゃたちと、一日,にち一デナリの約束,やくそくをして、彼,かれらをぶどう園,えんに送,おくった。","tok":[["彼","かれ"],["は"],["労働者","ろうどうしゃ"],["たち"],["と"],["、"],["一","いち"],["日","にち"],["ち"],["一","いち"],["デナリ"],["の"],["約束","やくそく"],["を"],["して"],["、"],["彼","かれ"],["ら"],["を"],["ぶどう園","ぶどうえん"],["に"],["送った","おくった"],["。"]]},{"verse":3,"text":"それから九時,じごろに出,でて行,いって、他,たの人々,ひとびとが市場,いちばで何,なにもせずに立,たっているのを見,みた。","tok":[["それ"],["から"],["九","きゅう"],["時","じ"],["に"],["出て","でて"],["行って","いって"],["、"],["他","た"],["の"],["人々","ひとびと"],["が"],["市場","い"],["ちば"],["で"],["何に","なに"],["も"],["せず"],["に"],["立って","たって"],["いる"],["の"],["を"],["見た","みた"],["。"]]},{"verse":4,"text":"そして、その人,ひとたちに言,いった、『あなたがたも、ぶどう園,えんに行,いきなさい。相当,そうとうな賃銀,ちんぎんを払,はらうから』。","tok":[["そして"],["、"],["その"],["人","ひと"],["たち"],["に"],["言った","いった"],["、"],["『"],["あなた"],["がた"],["も"],["、"],["ぶどう園","ぶどうえん"],["に"],["行き","いき"],["なさい"],["。"],["相当","そうとう"],["な"],["賃銀","ちんぎん"],["を"],["払う","はらう"],["から"],["』"],["。"]]},{"verse":5,"text":"そこで、彼,かれらは出,でかけて行,いった。主人,しゅじんはまた、十二時,じごろと三時,じごろとに出,でて行,いって、同,おなじようにした。","tok":[["そこ"],["で"],["、"],["彼","かれ"],["ら"],["は"],["出かけて","でかけて"],["行った","いった"],["。"],["主人","しゅじん"],["は"],["また"],["、"],["十二","じゅうに"],["時","じ"],["と"],["三","さん"],["時","じ"],["に"],["出て","でて"],["行って","いって"],["、"],["同じ","おなじ"],["よう"],["に"],["した"],["。"]]},{"verse":6,"text":"五時,ときごろまた出,でて行,いくと、まだ立,たっている人々,ひとびとを見,みたので、彼,かれらに言,いった、『なぜ、何,なにもしないで、一日,にち中,ぢゅうここに立,たっていたのか』。","tok":[["五","ご"],["時","じ"],["き"],["ごろ"],["また"],["出て","でて"],["行く","いく"],["と"],["、"],["まだ"],["立って","たって"],["いる"],["人々","ひとびと"],["を"],["見た","みた"],["ので"],["、"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["『"],["なぜ"],["、"],["何に","なに"],["も"],["しないで"],["、"],["一","いち"],["日","にち"],["ち中","ちぢゅうここ"],["に"],["立って","たって"],["いた"],["の"],["か"],["』"],["。"]]},{"verse":7,"text":"彼,かれらが『だれもわたしたちを雇,やとってくれませんから』と答,こたえたので、その人々,ひとびとに言,いった、『あなたがたも、ぶどう園,えんに行,いきなさい』。","tok":[["彼","かれ"],["ら"],["が"],["『"],["だれ"],["も"],["わたしたち"],["を"],["雇って","やとって"],["くれません"],["から"],["』"],["と"],["答","こたえ"],["た"],["ので"],["、"],["その"],["人々","ひとびと"],["に"],["言った","いった"],["、"],["『"],["あなた"],["がた"],["も"],["、"],["ぶどう園","ぶどうえん"],["に"],["行き","いき"],["なさい"],["』"],["。"]]},{"verse":8,"text":"さて、夕方,ゆうがたになって、ぶどう園,えんの主人,しゅじんは管理人,かんりにんに言,いった、『労働者,ろうどうしゃたちを呼,よびなさい。そして、最後,さいごにきた人々,ひとびとからはじめて順々,じゅんじゅんに最初,さいしょにきた人々,ひとびとにわたるように、賃銀,ちんぎんを払,はらってやりなさい』。","tok":[["さて"],["、"],["夕方","ゆうがた"],["に"],["なって"],["、"],["ぶどう園","ぶどうえん"],["の"],["主人","しゅじん"],["は"],["管理人","かんりにん"],["に"],["言った","いった"],["、"],["『"],["労働者","ろうどうしゃ"],["たち"],["を"],["呼び","よび"],["なさい"],["。"],["そして"],["、"],["最後","さいご"],["に"],["きた"],["人々","ひとびと"],["から"],["はじめて"],["順々","じゅんじゅん"],["に"],["最初","さいしょ"],["に"],["きた"],["人々","ひとびと"],["に"],["わたる"],["よう"],["に"],["、"],["賃銀","ちんぎん"],["を"],["払って","はらって"],["やり"],["なさい"],["』"],["。"]]},{"verse":9,"text":"そこで、五時,ときごろに雇,やとわれた人々,ひとびとがきて、それぞれ一デナリずつもらった。","tok":[["そこ"],["で"],["、"],["五","ご"],["時","じ"],["に"],["雇われた","やとわれた"],["人々","ひとびと"],["が"],["きて"],["、"],["それぞれ"],["一","いち"],["デナリ"],["ずつ"],["もらった"],["。"]]},{"verse":10,"text":"ところが、最初,さいしょの人々,ひとびとがきて、もっと多,おおくもらえるだろうと思,おもっていたのに、彼,かれらも一デナリずつもらっただけであった。","tok":[["ところ"],["が"],["、"],["最初","さいしょ"],["の"],["人々","ひとびと"],["が"],["きて"],["、"],["もっと"],["多く","おおく"],["もらえるだろう"],["と"],["思って","おもって"],["いた"],["のに"],["、"],["彼","かれ"],["ら"],["も"],["一","いち"],["デナリ"],["ずつ"],["もらった"],["だけ"],["で"],["あった"],["。"]]},{"verse":11,"text":"もらったとき、家,いえの主人,しゅじんにむかって不平,ふへいをもらして","tok":[["もらった"],["とき"],["、"],["家","いえ"],["の"],["主人","しゅじん"],["に"],["むかって"],["不平","ふへい"],["を"],["もらして"]]},{"verse":12,"text":"言,いった、『この最後,さいごの者,ものたちは一時間,じかんしか働,はたらかなかったのに、あなたは一日,にちじゅう、労苦,ろうくと暑,あつさを辛抱,しんぼうしたわたしたちと同,おなじ扱,あつかいをなさいました』。","tok":[["言った","いった"],["、"],["『"],["この"],["最後","さいご"],["の"],["者","もの"],["たち"],["は"],["一","いち"],["時間","じかん"],["かん"],["しか"],["働かなかった","はたらかなかった"],["のに"],["、"],["あなた"],["は"],["一","いち"],["日","にち"],["ち"],["じゅう"],["、"],["労苦","ろうく"],["と"],["暑さ","あつさ"],["を"],["辛抱","しんぼう"],["した"],["わたしたち"],["と"],["同じ","おなじ"],["扱い","あつかい"],["を"],["なさいました"],["』"],["。"]]},{"verse":13,"text":"そこで彼,かれはそのひとりに答,こたえて言,いった、『友,ともよ、わたしはあなたに対,たいして不正,ふせいをしてはいない。あなたはわたしと一デナリの約束,やくそくをしたではないか。","tok":[["そこ"],["で"],["彼","かれ"],["は"],["その"],["ひとり"],["に"],["答","こたえ"],["て"],["言った","いった"],["、"],["『"],["友","とも"],["よ"],["、"],["わたし"],["は"],["あなた"],["に対して","にたいして"],["不正","ふせい"],["を"],["して"],["は"],["いない"],["。"],["あなた"],["は"],["わたし"],["と"],["一","いち"],["デナリ"],["の"],["約束","やくそく"],["を"],["した"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":14,"text":"自分,じぶんの賃銀,ちんぎんをもらって行,いきなさい。わたしは、この最後,さいごの者,ものにもあなたと同様,どうように払,はらってやりたいのだ。","tok":[["自分","じぶん"],["の"],["賃銀","ちんぎん"],["を"],["もらって"],["行き","いき"],["なさい"],["。"],["わたし"],["は"],["、"],["この"],["最後","さいご"],["の"],["者","もの"],["に"],["も"],["あなた"],["と"],["同様","どうよう"],["に"],["払って","はらって"],["やりたい"],["の"],["だ"],["。"]]},{"verse":15,"text":"自分,じぶんの物,ものを自分,じぶんがしたいようにするのは、当,あたりまえではないか。それともわたしが気前,きまえよくしているので、ねたましく思,おもうのか』。","tok":[["自分","じぶん"],["の"],["物","もの"],["を"],["自分","じぶん"],["が"],["したい"],["よう"],["に"],["する"],["の"],["は"],["、"],["当たりまえ","あたりまえ"],["で"],["は"],["ない"],["か"],["。"],["それ"],["と"],["も"],["わたし"],["が"],["気前","きまえ"],["よく"],["して"],["いる"],["ので"],["、"],["ねたましく"],["思","おもう"],["の"],["か"],["』"],["。"]]},{"verse":16,"text":"このように、あとの者,ものは先,さきになり、先,さきの者,ものはあとになるであろう」。","tok":[["この"],["よう"],["に"],["、"],["あと"],["の"],["者","もの"],["は"],["先","さき"],["に"],["なり"],["、"],["先","さき"],["の"],["者","もの"],["は"],["あと"],["に"],["なるで"],["あろう"],["」"],["。"]]},{"verse":17,"text":"さて、イエスはエルサレムへ上,のぼるとき、十二弟子,でしをひそかに呼,よびよせ、その途中,とちゅうで彼,かれらに言,いわれた、","tok":[["さて"],["、"],["イエス"],["は"],["エルサレム"],["へ"],["上る","のぼる"],["とき"],["、"],["十二","じゅうに"],["弟子","でし"],["を"],["ひそか"],["に"],["呼びよせ","よびよせ"],["、"],["その"],["途中","とちゅう"],["で"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"]]},{"verse":18,"text":"「見,みよ、わたしたちはエルサレムへ上,のぼって行,いくが、人,ひとの子,こは祭司長,さいしちょう、律法,りっぽう学者,がくしゃたちの手,てに渡,わたされるであろう。彼,かれらは彼,かれに死刑,しけいを宣告,せんこくし、","tok":[["「"],["見よ","みよ"],["、"],["わたしたち"],["は"],["エルサレム"],["へ"],["上って","のぼって"],["行く","いく"],["が"],["、"],["人","ひと"],["の"],["子","こ"],["は"],["祭司長","さいしちょう"],["、"],["律法学者","りっぽうがくしゃ"],["たち"],["の"],["手","て"],["に"],["渡されるで","わたされるで"],["あろう"],["。"],["彼","かれ"],["ら"],["は"],["彼","かれ"],["に"],["死刑","しけい"],["を"],["宣告","せんこく"],["し"],["、"]]},{"verse":19,"text":"そして彼,かれをあざけり、むち打,うち、十字架,じゅうじかにつけさせるために、異邦人,いほうじんに引,ひきわたすであろう。そして彼,かれは三日,か目,めによみがえるであろう」。","tok":[["そして"],["彼","かれ"],["を"],["あざけり"],["、"],["むち打ち","むちうち"],["、"],["十字架","じゅうじか"],["に"],["つけ"],["させる"],["ため"],["に"],["、"],["異邦人","いほうじん"],["に"],["引","ひき"],["わたすで"],["あろう"],["。"],["そして"],["彼","かれ"],["は"],["三日目","かめ"],["に"],["よみがえるで"],["あろう"],["」"],["。"]]},{"verse":20,"text":"そのとき、ゼベダイの子,こらの母,ははが、その子,こらと一緒,いっしょにイエスのもとにきてひざまずき、何事,なにごとかをお願,ねがいした。","tok":[["その"],["とき"],["、"],["ゼベダイ"],["の"],["子","こ"],["ら"],["の"],["母","はは"],["が"],["、"],["その"],["子","こ"],["ら"],["と"],["一緒","いっしょ"],["に"],["イエス"],["の"],["もと"],["に"],["きて"],["ひざまずき"],["、"],["何事","なにごと"],["か"],["を"],["お願い","おねがい"],["した"],["。"]]},{"verse":21,"text":"そこでイエスは彼女,かのじょに言,いわれた、「何,なにをしてほしいのか」。彼女,かのじょは言,いった、「わたしのこのふたりのむすこが、あなたの御国,みくにで、ひとりはあなたの右,みぎに、ひとりは左,ひだりにすわれるように、お言葉,ことばをください」。","tok":[["そこ"],["で"],["イエス"],["は"],["彼女","かのじょ"],["に"],["言われた","いわれた"],["、"],["「"],["何に","なに"],["を"],["して"],["ほしい"],["の"],["か"],["」"],["。"],["彼女","かのじょ"],["は"],["言った","いった"],["、"],["「"],["わたし"],["の"],["この"],["ふたり"],["の"],["むすこ"],["が"],["、"],["あなた"],["の"],["御国","みくに"],["で"],["、"],["ひとり"],["は"],["あなた"],["の"],["右","みぎ"],["に"],["、"],["ひとり"],["は"],["左","ひだり"],["に"],["すわれる"],["よう"],["に"],["、"],["お言葉","おことば"],["を"],["ください"],["」"],["。"]]},{"verse":22,"text":"イエスは答,こたえて言,いわれた、「あなたがたは、自分,じぶんが何,なにを求,もとめているのか、わかっていない。わたしの飲,のもうとしている杯,さかずきを飲,のむことができるか」。彼,かれらは「できます」と答,こたえた。","tok":[["イエス"],["は"],["答","こたえ"],["て"],["言われた","いわれた"],["、"],["「"],["あなた"],["がた"],["は"],["、"],["自分","じぶん"],["が"],["何に","なに"],["を"],["求めて","もとめて"],["いる"],["の"],["か"],["、"],["わかって"],["いない"],["。"],["わたし"],["の"],["飲もう","のもう"],["として"],["いる"],["杯","さかずき"],["を"],["飲む","のむ"],["こと"],["が"],["できる"],["か"],["」"],["。"],["彼","かれ"],["ら"],["は"],["「"],["できます"],["」"],["と"],["答","こたえ"],["た"],["。"]]},{"verse":23,"text":"イエスは彼,かれらに言,いわれた、「確,たしかに、あなたがたはわたしの杯,さかずきを飲,のむことになろう。しかし、わたしの右,みぎ、左,ひだりにすわらせることは、わたしのすることではなく、わたしの父,ちちによって備,そなえられている人々,ひとびとだけに許,ゆるされることである」。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["確か","たしか"],["に"],["、"],["あなた"],["がた"],["は"],["わたし"],["の"],["杯","さかずき"],["を"],["飲む","のむ"],["こと"],["に"],["なろう"],["。"],["しかし"],["、"],["わたし"],["の"],["右","みぎ"],["、"],["左","ひだり"],["に"],["すわらせる"],["こと"],["は"],["、"],["わたし"],["の"],["する"],["こと"],["で"],["は"],["なく"],["、"],["わたし"],["の"],["父","ちち"],["によって"],["備","そなえ"],["られて"],["いる"],["人々","ひとびと"],["だけ"],["に"],["許される","ゆるされる"],["こと"],["で"],["ある"],["」"],["。"]]},{"verse":24,"text":"十人,にんの者,ものはこれを聞,きいて、このふたりの兄弟,きょうだいたちのことで憤慨,ふんがいした。","tok":[["十人","にん"],["の"],["者","もの"],["は"],["これ"],["を"],["聞いて","きいて"],["、"],["この"],["ふたり"],["の"],["兄弟","きょうだい"],["たち"],["の"],["こと"],["で"],["憤慨","ふんがい"],["した"],["。"]]},{"verse":25,"text":"そこで、イエスは彼,かれらを呼,よび寄,よせて言,いわれた、「あなたがたの知,しっているとおり、異邦人,いほうじんの支配者,しはいしゃたちはその民,たみを治め,おさめ、また偉,えらい人,ひとたちは、その民,たみの上,うえに権力,けんりょくをふるっている。","tok":[["そこ"],["で"],["、"],["イエス"],["は"],["彼","かれ"],["ら"],["を"],["呼び寄せて","よびよせて"],["言われた","いわれた"],["、"],["「"],["あなた"],["がた"],["の"],["知って","しって"],["いる"],["とおり"],["、"],["異邦人","いほうじん"],["の"],["支配者","しはいしゃ"],["たち"],["は"],["その"],["民","たみ"],["を"],["治め","おさめ"],[","],["おさめ"],["、"],["また"],["偉い","えらい"],["人","ひと"],["たち"],["は"],["、"],["その"],["民","たみ"],["の"],["上","うえ"],["に"],["権力","けんりょく"],["を"],["ふるって"],["いる"],["。"]]},{"verse":26,"text":"あなたがたの間,あいだではそうであってはならない。かえって、あなたがたの間,あいだで偉,えらくなりたいと思,おもう者,ものは、仕,つかえる人,ひととなり、","tok":[["あなた"],["がた"],["の"],["間","あいだ"],["で"],["は"],["そう"],["で"],["あって"],["は"],["ならない"],["。"],["かえって"],["、"],["あなた"],["がた"],["の"],["間","あいだ"],["で"],["偉く","えらく"],["なりたい"],["と"],["思う","おもう"],["者","もの"],["は"],["、"],["仕える","つかえる"],["人となり","ひととなり"],["、"]]},{"verse":27,"text":"あなたがたの間,あいだでかしらになりたいと思,おもう者,ものは、僕,しもべとならねばならない。","tok":[["あなた"],["がた"],["の"],["間","あいだ"],["で"],["かしら"],["に"],["なりたい"],["と"],["思う","おもう"],["者","もの"],["は"],["、"],["僕","し"],["も"],["べ"],["と"],["ならねば"],["ならない"],["。"]]},{"verse":28,"text":"それは、人,ひとの子,こがきたのも、仕,つかえられるためではなく、仕,つかえるためであり、また多,おおくの人,ひとのあがないとして、自分,じぶんの命,いのちを与,あたえるためであるのと、ちょうど同,おなじである」。","tok":[["それ"],["は"],["、"],["人","ひと"],["の"],["子","こ"],["が"],["きた"],["の"],["も"],["、"],["仕えられる","つかえられる"],["ため"],["で"],["は"],["なく"],["、"],["仕える","つかえる"],["ため"],["で"],["あり"],["、"],["また"],["多く","おおく"],["の"],["人","ひと"],["の"],["あ"],["が"],["ない"],["として"],["、"],["自分","じぶん"],["の"],["命","いのち"],["を"],["与える","あたえる"],["ため"],["で"],["ある"],["の"],["と"],["、"],["ちょうど"],["同じ","おなじ"],["で"],["ある"],["」"],["。"]]},{"verse":29,"text":"それから、彼,かれらがエリコを出,でて行,いったとき、大,おおぜいの群衆,ぐんしゅうがイエスに従,したがってきた。","tok":[["それ"],["から"],["、"],["彼","かれ"],["ら"],["が"],["エリコ"],["を"],["出て","でて"],["行った","いった"],["とき"],["、"],["大ぜい","おおぜい"],["の"],["群衆","ぐんしゅう"],["が"],["イエス"],["に"],["従って","したがって"],["きた"],["。"]]},{"verse":30,"text":"すると、ふたりの盲人,もうじんが道,みちばたにすわっていたが、イエスがとおって行,いかれると聞,きいて、叫,さけんで言,いった、「主,しゅよ、ダビデの子,こよ、わたしたちをあわれんで下,ください」。","tok":[["する"],["と"],["、"],["ふたり"],["の"],["盲人","もうじん"],["が"],["道ばた","みちばた"],["に"],["すわって"],["いた"],["が"],["、"],["イエス"],["が"],["とおって"],["行かれる","いかれる"],["と"],["聞いて","きいて"],["、"],["叫けんで","さけんで"],["言った","いった"],["、"],["「"],["主","しゅ"],["よ"],["、"],["ダビデ"],["の"],["子","こ"],["よ"],["、"],["わたしたち"],["を"],["あわれんで"],["下さい","ください"],["」"],["。"]]},{"verse":31,"text":"群衆,ぐんしゅうは彼,かれらをしかって黙,だまらせようとしたが、彼,かれらはますます叫,さけびつづけて言,いった、「主,しゅよ、ダビデの子,こよ、わたしたちをあわれんで下,ください」。","tok":[["群衆","ぐんしゅう"],["は"],["彼","かれ"],["ら"],["を"],["しかって"],["黙らせよう","だまらせよう"],["と"],["した"],["が"],["、"],["彼","かれ"],["ら"],["は"],["ますます"],["叫","さけび"],["つづけて"],["言った","いった"],["、"],["「"],["主","しゅ"],["よ"],["、"],["ダビデ"],["の"],["子","こ"],["よ"],["、"],["わたしたち"],["を"],["あわれんで"],["下さい","ください"],["」"],["。"]]},{"verse":32,"text":"イエスは立,たちどまり、彼,かれらを呼,よんで言,いわれた、「わたしに何,なにをしてほしいのか」。","tok":[["イエス"],["は"],["立ちどまり","たちどまり"],["、"],["彼","かれ"],["ら"],["を"],["呼んで","よんで"],["言われた","いわれた"],["、"],["「"],["わたし"],["に"],["何に","なに"],["を"],["して"],["ほしい"],["の"],["か"],["」"],["。"]]},{"verse":33,"text":"彼,かれらは言,いった、「主,しゅよ、目,めをあけていただくことです」。","tok":[["彼","かれ"],["ら"],["は"],["言った","いった"],["、"],["「"],["主","しゅ"],["よ"],["、"],["目","め"],["を"],["あけて"],["いただく"],["こと"],["です"],["」"],["。"]]},{"verse":34,"text":"イエスは深,ふかくあわれんで、彼,かれらの目,めにさわられた。すると彼,かれらは、たちまち見,みえるようになり、イエスに従,したがって行,いった。","tok":[["イエス"],["は"],["深く","ふかく"],["あわれんで"],["、"],["彼","かれ"],["ら"],["の"],["目","め"],["に"],["さわられた"],["。"],["する"],["と"],["彼","かれ"],["ら"],["は"],["、"],["たちまち"],["見える","みえる"],["よう"],["に"],["なり"],["、"],["イエス"],["に"],["従って","したがって"],["行った","いった"],["。"]]}]
[{"verse":1,"text":"夜,よが明,あけると、祭司長,さいしちょうたち、民,たみの長老,ちょうろうたち一同,いちどうは、イエスを殺,ころそうとして協議,きょうぎをこらした上,うえ、","tok":[["夜","よ"],["が"],["明ける","あける"],["と"],["、"],["祭司長","さいしちょう"],["たち"],["、"],["民","たみ"],["の"],["長老","ちょうろう"],["たち"],["一同","いちどう"],["は"],["、"],["イエス"],["を"],["殺そう","ころそう"],["として"],["協議","きょうぎ"],["を"],["こらした"],["上","うえ"],["、"]]},{"verse":2,"text":"イエスを縛,しばって引,ひき出,だし、総督,そうとくピラトに渡,わたした。","tok":[["イエス"],["を"],["縛って","しばって"],["引出し","ひきだし"],["、"],["総督","そうとく"],["ピラト"],["に"],["渡","わたし"],["た"],["。"]]},{"verse":3,"text":"そのとき、イエスを裏切,うらぎったユダは、イエスが罪,つみに定,さだめられたのを見,みて後悔,こうかいし、銀貨,ぎんか三十枚,まいを祭司長,さいしちょう、長老,ちょうろうたちに返,かえして","tok":[["その"],["とき"],["、"],["イエス"],["を"],["裏切った","うらぎった"],["ユダ"],["は"],["、"],["イエス"],["が"],["罪","つみ"],["に"],["定められた","さだめられた"],["の"],["を"],["見て","みて"],["後悔","こうかい"],["し"],["、"],["銀貨","ぎんか"],["三十枚","まい"],["を"],["祭司長","さいしちょう"],["、"],["長老","ちょうろう"],["たち"],["に"],["返","かえし"],["て"]]},{"verse":4,"text":"言,いった、「わたしは罪,つみのない人,ひとの血,ちを売,うるようなことをして、罪,つみを犯,おかしました」。しかし彼,かれらは言,いった、「それは、われわれの知,しったことか。自分,じぶんで始末,しまつするがよい」。","tok":[["言った","いった"],["、"],["「"],["わたし"],["は"],["罪","つみ"],["の"],["ない"],["人","ひと"],["の"],["血","ち"],["を"],["売る","うる"],["よう"],["な"],["こと"],["を"],["して"],["、"],["罪","つみ"],["を"],["犯しました","おかしました"],["」"],["。"],["しかし"],["彼","かれ"],["ら"],["は"],["言った","いった"],["、"],["「"],["それ"],["は"],["、"],["われわれ"],["の"],["知った","しった"],["こと"],["か"],["。"],["自分","じぶん"],["で"],["始末","しまつ"],["する"],["が"],["よい"],["」"],["。"]]},{"verse":5,"text":"そこで、彼,かれは銀貨,ぎんかを聖所,せいじょに投,なげ込,こんで出,でて行,いき、首,くびをつって死,しんだ。","tok":[["そこ"],["で"],["、"],["彼","かれ"],["は"],["銀貨","ぎんか"],["を"],["聖","せい"],["所","しょ"],["に"],["投込んで","なげこんで"],["出て","でて"],["行き","いき"],["、"],["首","くび"],["を"],["つって"],["死んだ","しんだ"],["。"]]},{"verse":6,"text":"祭司長,さいしちょうたちは、その銀貨,ぎんかを拾,ひろいあげて言,いった、「これは血,ちの代価,だいかだから、宮,みやの金庫,きんこに入,いれるのはよくない」。","tok":[["祭司長","さいしちょう"],["たち"],["は"],["、"],["その"],["銀貨","ぎんか"],["を"],["拾いあげて","ひろいあげて"],["言った","いった"],["、"],["「"],["これ"],["は"],["血","ち"],["の"],["代価","だいか"],["だ"],["から"],["、"],["宮","みや"],["の"],["金庫","きんこ"],["に"],["入れる","いれる"],["の"],["は"],["よく"],["ない"],["」"],["。"]]},{"verse":7,"text":"そこで彼,かれらは協議,きょうぎの上,うえ、外国,がいこく人,ひとの墓地,ぼちにするために、その金,かねで陶器,とうき師,しの畑,はたけを買,かった。","tok":[["そこ"],["で"],["彼","かれ"],["ら"],["は"],["協議","きょうぎ"],["の"],["上","うえ"],["、"],["外国人","がいこくひと"],["の"],["墓地","ぼち"],["に"],["する"],["ため"],["に"],["、"],["その"],["金","かね"],["で"],["陶器師","とうきし"],["の"],["畑","はたけ"],["を"],["買った","かった"],["。"]]},{"verse":8,"text":"そのために、この畑,はたけは今日,きょうまで血,ちの畑,はたけと呼,よばれている。","tok":[["その"],["ため"],["に"],["、"],["この"],["畑","はたけ"],["は"],["今日","きょう"],["まで"],["血","ち"],["の"],["畑","はたけ"],["と"],["呼ばれて","よばれて"],["いる"],["。"]]},{"verse":9,"text":"こうして預言者,よげんしゃエレミヤによって言,いわれた言葉,ことばが、成就,じょうじゅしたのである。すなわち、「彼,かれらは、値,ねをつけられたもの、すなわち、イスラエルの子,こらが値,ねをつけたものの代価,だいか、銀貨,ぎんか三十を取,とって、","tok":[["こう"],["して"],["預言者","よげんしゃ"],["エレミヤ"],["によって"],["言われた","いわれた"],["言葉","ことば"],["が"],["、"],["成就","じょうじゅ"],["した"],["ので"],["ある"],["。"],["すなわち"],["、"],["「"],["彼","かれ"],["ら"],["は"],["、"],["値","ね"],["を"],["つけられた"],["もの"],["、"],["すなわち"],["、"],["イスラエル"],["の"],["子","こ"],["ら"],["が"],["値","ね"],["を"],["つけた"],["もの"],["の"],["代価","だいか"],["、"],["銀貨","ぎんか"],["三十","さんじゅう"],["を"],["取って","とって"],["、"]]},{"verse":10,"text":"主,しゅがお命,めいじになったように、陶器,とうき師,しの畑,はたけの代価,だいかとして、その金,かねを与,あたえた」。","tok":[["主","しゅ"],["が"],["お命じ","おめいじ"],["に"],["なった"],["よう"],["に"],["、"],["陶器師","とうきし"],["の"],["畑","はたけ"],["の"],["代価","だいか"],["として"],["、"],["その"],["金","かね"],["を"],["与","あたえ"],["た"],["」"],["。"]]},{"verse":11,"text":"さて、イエスは総督,そうとくの前,まえに立,たたれた。すると総督,そうとくはイエスに尋,たずねて言,いった、「あなたがユダヤ人,じんの王,おうであるか」。イエスは「そのとおりである」と言,いわれた。","tok":[["さて"],["、"],["イエス"],["は"],["総督","そうとく"],["の"],["前","まえ"],["に"],["立たれた","たたれた"],["。"],["する"],["と"],["総督","そうとく"],["は"],["イエス"],["に"],["尋ねて","たずねて"],["言った","いった"],["、"],["「"],["あなた"],["が"],["ユダヤ人","ゆだやじん"],["の"],["王","おう"],["で"],["ある"],["か"],["」"],["。"],["イエス"],["は"],["「"],["その"],["とおり"],["で"],["ある"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":12,"text":"しかし、祭司長,さいしちょう、長老,ちょうろうたちが訴,うったえている間,あいだ、イエスはひと言,こともお答,こたえにならなかった。","tok":[["しかし"],["、"],["祭司長","さいしちょう"],["、"],["長老","ちょうろう"],["たち"],["が"],["訴て","うったえて"],["いる"],["間","あいだ"],["、"],["イエス"],["は"],["ひと言","ひとこと"],["も"],["お答","おこたえ"],["に"],["ならなかった"],["。"]]},{"verse":13,"text":"するとピラトは言,いった、「あんなにまで次々,つぎつぎに、あなたに不利,ふりな証言,しょうげんを立,たてているのが、あなたには聞,きこえないのか」。","tok":[["する"],["と"],["ピラト"],["は"],["言った","いった"],["、"],["「"],["あんな"],["に"],["まで"],["次々","つぎつぎ"],["に"],["、"],["あなた"],["に"],["不利","ふり"],["な"],["証言","しょうげん"],["を"],["立て","たてて"],["いる"],["の"],["が"],["、"],["あなた"],["に"],["は"],["聞こえない","きこえない"],["の"],["か"],["」"],["。"]]},{"verse":14,"text":"しかし、総督,そうとくが非常,ひじょうに不思議,ふしぎに思,おもったほどに、イエスは何,なにを言,いわれても、ひと言,こともお答,こたえにならなかった。","tok":[["しかし"],["、"],["総督","そうとく"],["が"],["非常","ひじょう"],["に"],["不思議","ふしぎ"],["に"],["思った","おもった"],["ほど"],["に"],["、"],["イエス"],["は"],["何に","なに"],["を"],["言われて","いわれて"],["も"],["、"],["ひと言","ひとこと"],["も"],["お答","おこたえ"],["に"],["ならなかった"],["。"]]},{"verse":15,"text":"さて、祭,まつりのたびごとに、総督,そうとくは群衆,ぐんしゅうが願,ねがい出,でる囚人,しゅうじんひとりを、ゆるしてやる慣例,かんれいになっていた。","tok":[["さて"],["、"],["祭","まつり"],["の"],["たび"],["ごと"],["に"],["、"],["総督","そうとく"],["は"],["群衆","ぐんしゅう"],["が"],["願い出る","ねがいでる"],["囚人","しゅうじん"],["ひとり"],["を"],["、"],["ゆるして"],["やる"],["慣例","かんれい"],["に"],["なって"],["いた"],["。"]]},{"verse":16,"text":"ときに、バラバという評判,ひょうばんの囚人,しゅうじんがいた。","tok":[["とき"],["に"],["、"],["バラバ"],["と"],["いう"],["評判","ひょうばん"],["の"],["囚人","しゅうじん"],["が"],["いた"],["。"]]},{"verse":17,"text":"それで、彼,かれらが集,あつまったとき、ピラトは言,いった、「おまえたちは、だれをゆるしてほしいのか。バラバか、それとも、キリストといわれるイエスか」。","tok":[["それ"],["で"],["、"],["彼","かれ"],["ら"],["が"],["集まった","あつまった"],["とき"],["、"],["ピラト"],["は"],["言った","いった"],["、"],["「"],["おまえ"],["たち"],["は"],["、"],["だれ"],["を"],["ゆるして"],["ほしい"],["の"],["か"],["。"],["バラバ"],["か"],["、"],["それ"],["と"],["も"],["、"],["キリスト"],["と"],["いわれる"],["イエス"],["か"],["」"],["。"]]},{"verse":18,"text":"彼,かれらがイエスを引,ひきわたしたのは、ねたみのためであることが、ピラトにはよくわかっていたからである。","tok":[["彼","かれ"],["ら"],["が"],["イエス"],["を"],["引","ひき"],["わたした"],["の"],["は"],["、"],["ねたみ"],["の"],["ため"],["で"],["ある"],["こと"],["が"],["、"],["ピラト"],["に"],["は"],["よく"],["わかって"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":19,"text":"また、ピラトが裁判,さいばんの席,せきについていたとき、その妻,つまが人,ひとを彼,かれのもとにつかわして、「あの義人,ぎじんには関係,かんけいしないでください。わたしはきょう夢,ゆめで、あの人,ひとのためにさんざん苦,くるしみましたから」と言,いわせた。","tok":[["また"],["、"],["ピラト"],["が"],["裁判","さいばん"],["の"],["席","せき"],["について"],["いた"],["とき"],["、"],["その"],["妻","つま"],["が"],["人","ひと"],["を"],["彼","かれ"],["の"],["もと"],["に"],["つかわして"],["、"],["「"],["あの"],["義人","ぎじん"],["に"],["は"],["関係","かんけい"],["しないで"],["ください"],["。"],["わたし"],["は"],["きょう"],["夢","ゆめ"],["で"],["、"],["あの"],["人","ひと"],["の"],["ため"],["に"],["さんざん"],["苦しみました","くるしみました"],["から"],["」"],["と"],["言わせた","いわせた"],["。"]]},{"verse":20,"text":"しかし、祭司長,さいしちょう、長老,ちょうろうたちは、バラバをゆるして、イエスを殺,ころしてもらうようにと、群衆,ぐんしゅうを説,とき伏,ふせた。","tok":[["しかし"],["、"],["祭司長","さいしちょう"],["、"],["長老","ちょうろう"],["たち"],["は"],["、"],["バラバ"],["を"],["ゆるして"],["、"],["イエス"],["を"],["殺ろして","ころして"],["もらう"],["よう"],["に"],["と"],["、"],["群衆","ぐんしゅう"],["を"],["説き伏せた","ときふせた"],["。"]]},{"verse":21,"text":"総督,そうとくは彼,かれらにむかって言,いった、「ふたりのうち、どちらをゆるしてほしいのか」。彼,かれらは「バラバの方,ほうを」と言,いった。","tok":[["総督","そうとく"],["は"],["彼","かれ"],["ら"],["に"],["むかって"],["言った","いった"],["、"],["「"],["ふたり"],["の"],["うち"],["、"],["どちら"],["を"],["ゆるして"],["ほしい"],["の"],["か"],["」"],["。"],["彼","かれ"],["ら"],["は"],["「"],["バラバ"],["の"],["方","ほう"],["を"],["」"],["と"],["言った","いった"],["。"]]},{"verse":22,"text":"ピラトは言,いった、「それではキリストといわれるイエスは、どうしたらよいか」。彼,かれらはいっせいに「十字架,じゅうじかにつけよ」と言,いった。","tok":[["ピラト"],["は"],["言った","いった"],["、"],["「"],["それ"],["で"],["は"],["キリスト"],["と"],["いわれる"],["イエス"],["は"],["、"],["どう"],["したら"],["よい"],["か"],["」"],["。"],["彼","かれ"],["ら"],["は"],["いっせい"],["に"],["「"],["十字架","じゅうじか"],["に"],["つけよ"],["」"],["と"],["言った","いった"],["。"]]},{"verse":23,"text":"しかし、ピラトは言,いった、「あの人,ひとは、いったい、どんな悪事,あくじをしたのか」。すると彼,かれらはいっそう激,はげしく叫,さけんで、「十字架,じゅうじかにつけよ」と言,いった。","tok":[["しかし"],["、"],["ピラト"],["は"],["言った","いった"],["、"],["「"],["あの"],["人","ひと"],["は"],["、"],["いったい"],["、"],["どんな"],["悪事","あくじ"],["を"],["した"],["の"],["か"],["」"],["。"],["する"],["と"],["彼","かれ"],["ら"],["は"],["いっそう"],["激しく","はげしく"],["叫けんで","さけんで"],["、"],["「"],["十字架","じゅうじか"],["に"],["つけよ"],["」"],["と"],["言った","いった"],["。"]]},{"verse":24,"text":"ピラトは手,てのつけようがなく、かえって暴動,ぼうどうになりそうなのを見,みて、水,みずを取,とり、群衆,ぐんしゅうの前,まえで手,てを洗,あらって言,いった、「この人,ひとの血,ちについて、わたしには責任,せきにんがない。おまえたちが自分,じぶんで始末,しまつをするがよい」。","tok":[["ピラト"],["は"],["手","て"],["の"],["つけ"],["よう"],["が"],["なく"],["、"],["かえって"],["暴動","ぼうどう"],["に"],["なり"],["そう"],["な"],["の"],["を"],["見て","みて"],["、"],["水","みず"],["を"],["取","とり"],["、"],["群衆","ぐんしゅう"],["の"],["前","まえ"],["で"],["手","て"],["を"],["洗って","あらって"],["言った","いった"],["、"],["「"],["この"],["人","ひと"],["の"],["血","ち"],["について"],["、"],["わたし"],["に"],["は"],["責任","せきにん"],["が"],["ない"],["。"],["おまえ"],["たち"],["が"],["自分","じぶん"],["で"],["始末","しまつ"],["を"],["する"],["が"],["よい"],["」"],["。"]]},{"verse":25,"text":"すると、民衆,みんしゅう全体,ぜんたいが答,こたえて言,いった、「その血,ちの責任,せきにんは、われわれとわれわれの子孫,しそんの上,うえにかかってもよい」。","tok":[["する"],["と"],["、"],["民衆","みんしゅう"],["全体","ぜんたい"],["が"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["その"],["血","ち"],["の"],["責任","せきにん"],["は"],["、"],["われわれ"],["と"],["われわれ"],["の"],["子孫","しそん"],["の"],["上","うえ"],["に"],["かかって"],["も"],["よい"],["」"],["。"]]},{"verse":26,"text":"そこで、ピラトはバラバをゆるしてやり、イエスをむち打,うったのち、十字架,じゅうじかにつけるために引,ひきわたした。","tok":[["そこ"],["で"],["、"],["ピラト"],["は"],["バラバ"],["を"],["ゆるして"],["やり"],["、"],["イエス"],["を"],["むち打った","むちうった"],["のち"],["、"],["十字架","じゅうじか"],["に"],["つける"],["ため"],["に"],["引","ひき"],["わたした"],["。"]]},{"verse":27,"text":"それから総督,そうとくの兵士,へいしたちは、イエスを官邸,かんていに連,つれて行,いって、全,ぜん部隊,ぶたいをイエスのまわりに集,あつめた。","tok":[["それ"],["から"],["総督","そうとく"],["の"],["兵士","へいし"],["たち"],["は"],["、"],["イエス"],["を"],["官邸","かんてい"],["に"],["連れて","つれて"],["行って","いって"],["、"],["全","ぜん"],["部隊","ぶたい"],["を"],["イエス"],["の"],["まわり"],["に"],["集めた","あつめた"],["。"]]},{"verse":28,"text":"そしてその上着,うわぎをぬがせて、赤,あかい外套,がいとうを着,きせ、","tok":[["そして"],["その"],["上着","うわぎ"],["を"],["ぬがせて"],["、"],["赤い","あかい"],["外套","がいとう"],["を"],["着せ","きせ"],["、"]]},{"verse":29,"text":"また、いばらで冠,かんむりを編,あんでその頭,あたまにかぶらせ、右,みぎの手,てには葦,あしの棒,ぼうを持,もたせ、それからその前,まえにひざまずき、嘲弄,ちょうろうして、「ユダヤ人,じんの王,おう、ばんざい」と言,いった。","tok":[["また"],["、"],["いばら"],["で"],["冠","かんむり"],["を"],["編","あんでそ"],["の"],["頭","あたま"],["に"],["かぶらせ"],["、"],["右","みぎ"],["の"],["手","て"],["に"],["は"],["葦","あし"],["の"],["棒","ぼう"],["を"],["持たせ","もたせ"],["、"],["それ"],["から"],["その"],["前","まえ"],["に"],["ひざまずき"],["、"],["嘲弄","ちょうろう"],["して"],["、"],["「"],["ユダヤ人","ゆだやじん"],["の"],["王","おう"],["、"],["ばんざい"],["」"],["と"],["言った","いった"],["。"]]},{"verse":30,"text":"また、イエスにつばきをかけ、葦,あしの棒,ぼうを取,とりあげてその頭,あたまをたたいた。","tok":[["また"],["、"],["イエス"],["に"],["つばき"],["を"],["かけ"],["、"],["葦","あし"],["の"],["棒","ぼう"],["を"],["取","とり"],["あげて"],["その"],["頭","あたま"],["を"],["たたいた"],["。"]]},{"verse":31,"text":"こうしてイエスを嘲弄,ちょうろうしたあげく、外套,がいとうをはぎ取,とって元,もとの上着,うわぎを着,きせ、それから十字架,じゅうじかにつけるために引,ひき出,だした。","tok":[["こう"],["して"],["イエス"],["を"],["嘲弄","ちょうろう"],["した"],["あげく"],["、"],["外套","がいとう"],["を"],["はぎ取って","はぎとって"],["元","もと"],["の"],["上着","うわぎ"],["を"],["着せ","きせ"],["、"],["それ"],["から"],["十字架","じゅうじか"],["に"],["つける"],["ため"],["に"],["引出した","ひきだした"],["。"]]},{"verse":32,"text":"彼,かれらが出,でて行,いくと、シモンという名,なのクレネ人,びとに出会,であったので、イエスの十字架,じゅうじかを無理,むりに負,おわせた。","tok":[["彼","かれ"],["ら"],["が"],["出て","でて"],["行く","いく"],["と"],["、"],["シモン"],["と"],["いう"],["名","な"],["の"],["クレネ人","くれねびと"],["に"],["出会った","であった"],["ので"],["、"],["イエス"],["の"],["十字架","じゅうじか"],["を"],["無理","むり"],["に"],["負わせた","おわせた"],["。"]]},{"verse":33,"text":"そして、ゴルゴタ、すなわち、されこうべの場,ば、という所,ところにきたとき、","tok":[["そして"],["、"],["ゴルゴタ"],["、"],["すなわち"],["、"],["されこうべ"],["の"],["場","ば"],["、"],["と"],["いう"],["所","ところ"],["に"],["きた"],["とき"],["、"]]},{"verse":34,"text":"彼,かれらはにがみをまぜたぶどう酒,しゅを飲,のませようとしたが、イエスはそれをなめただけで、飲,のもうとされなかった。","tok":[["彼","かれ"],["ら"],["は"],["にがみ"],["を"],["まぜた"],["ぶどう酒","ぶどうしゅ"],["を"],["飲ませよう","のませよう"],["と"],["した"],["が"],["、"],["イエス"],["は"],["それ"],["を"],["なめた"],["だけ"],["で"],["、"],["飲もう","のもう"],["と"],["されなかった"],["。"]]},{"verse":35,"text":"彼,かれらはイエスを十字架,じゅうじかにつけてから、くじを引,ひいて、その着物,きものを分,わけ、","tok":[["彼","かれ"],["ら"],["は"],["イエス"],["を"],["十字架","じゅうじか"],["に"],["つけて"],["から"],["、"],["くじ"],["を"],["引いて","ひいて"],["、"],["その"],["着物","きもの"],["を"],["分け","わけ"],["、"]]},{"verse":36,"text":"そこにすわってイエスの番,ばんをしていた。","tok":[["そこ"],["に"],["すわって"],["イエス"],["の"],["番","ばん"],["を"],["して"],["いた"],["。"]]},{"verse":37,"text":"そしてその頭,あたまの上,うえの方,ほうに、「これはユダヤ人,じんの王,おうイエス」と書,かいた罪状,ざいじょう書,がきをかかげた。","tok":[["そして"],["その"],["頭","あたま"],["の"],["上","うえ"],["の"],["方","ほう"],["に"],["、"],["「"],["これ"],["は"],["ユダヤ人","ゆだやじん"],["の"],["王","おう"],["イエス"],["」"],["と"],["書いた","かいた"],["罪状書","ざいじょうがき"],["を"],["かかげた"],["。"]]},{"verse":38,"text":"同時,どうじに、ふたりの強盗,ごうとうがイエスと一緒,いっしょに、ひとりは右,みぎに、ひとりは左,ひだりに、十字架,じゅうじかにつけられた。","tok":[["同時","どうじ"],["に"],["、"],["ふたり"],["の"],["強盗","ごうとう"],["が"],["イエス"],["と"],["一緒","いっしょ"],["に"],["、"],["ひとり"],["は"],["右","みぎ"],["に"],["、"],["ひとり"],["は"],["左","ひだり"],["に"],["、"],["十字架","じゅうじか"],["に"],["つけられた"],["。"]]},{"verse":39,"text":"そこを通,とおりかかった者,ものたちは、頭,あたまを振,ふりながら、イエスをののしって","tok":[["そこ"],["を"],["通りかかった","とおりかかった"],["者","もの"],["たち"],["は"],["、"],["頭","あたま"],["を"],["振り","ふり"],["ながら"],["、"],["イエス"],["を"],["ののしって"]]},{"verse":40,"text":"言,いった、「神殿,しんでんを打,うちこわして三日,かのうちに建,たてる者,ものよ。もし神,かみの子,こなら、自分,じぶんを救,すくえ。そして十字架,じゅうじかからおりてこい」。","tok":[["言った","いった"],["、"],["「"],["神殿","しんでん"],["を"],["打ちこわして","うちこわして"],["三日","か"],["の"],["うち"],["に"],["建てる","たてる"],["者","もの"],["よ"],["。"],["もし"],["神","かみ"],["の"],["子","こ"],["なら"],["、"],["自分","じぶん"],["を"],["救え","すくえ"],["。"],["そして"],["十字架","じゅうじか"],["から"],["おりて"],["こい"],["」"],["。"]]},{"verse":41,"text":"祭司長,さいしちょうたちも同,おなじように、律法,りっぽう学者,がくしゃ、長老,ちょうろうたちと一緒,いっしょになって、嘲弄,ちょうろうして言,いった、","tok":[["祭司長","さいしちょう"],["たち"],["も"],["同じ","おなじ"],["よう"],["に"],["、"],["律法学者","りっぽうがくしゃ"],["、"],["長老","ちょうろう"],["たち"],["と"],["一緒","いっしょ"],["に"],["なって"],["、"],["嘲弄","ちょうろう"],["して"],["言った","いった"],["、"]]},{"verse":42,"text":"「他人,たにんを救,すくったが、自分,じぶん自身,じしんを救,すくうことができない。あれがイスラエルの王,おうなのだ。いま十字架,じゅうじかからおりてみよ。そうしたら信,しんじよう。","tok":[["「"],["他人","たにん"],["を"],["救った","すくった"],["が"],["、"],["自分","じぶん"],["自身","じしん"],["を"],["救う","すくう"],["こと"],["が"],["できない"],["。"],["あれ"],["が"],["イスラエル"],["の"],["王","おう"],["な"],["の"],["だ"],["。"],["いま"],["十字架","じゅうじか"],["から"],["おりて"],["み"],["よ"],["。"],["そう"],["したら"],["信じよう","しんじよう"],["。"]]},{"verse":43,"text":"彼,かれは神,かみにたよっているが、神,かみのおぼしめしがあれば、今,いま、救,すくってもらうがよい。自分,じぶんは神,かみの子,こだと言,いっていたのだから」。","tok":[["彼","かれ"],["は"],["神","かみ"],["に"],["たよって"],["いる"],["が"],["、"],["神","かみ"],["の"],["おぼしめし"],["が"],["あれば"],["、"],["今","いま"],["、"],["救って","すくって"],["もらう"],["が"],["よい"],["。"],["自分","じぶん"],["は"],["神","かみ"],["の"],["子","こ"],["だ"],["と"],["言って","いって"],["いた"],["の"],["だ"],["から"],["」"],["。"]]},{"verse":44,"text":"一緒,いっしょに十字架,じゅうじかにつけられた強盗,ごうとうどもまでも、同,おなじようにイエスをののしった。","tok":[["一緒","いっしょ"],["に"],["十字架","じゅうじか"],["に"],["つけられた"],["強盗","ごうとう"],["ども"],["まで"],["も"],["、"],["同じ","おなじ"],["よう"],["に"],["イエス"],["を"],["ののしった"],["。"]]},{"verse":45,"text":"さて、昼,ひるの十二時,じから地上,ちじょうの全面,ぜんめんが暗,くらくなって、三時,じに及,およんだ。","tok":[["さて"],["、"],["昼","ひる"],["の"],["十二","じゅうに"],["時","じ"],["ら"],["地上","ちじょう"],["の"],["全面","ぜんめん"],["が"],["暗く","くらく"],["なって"],["、"],["三","さん"],["時","じ"],["に"],["及んだ","およんだ"],["。"]]},{"verse":46,"text":"そして三時,じごろに、イエスは大声,おおごえで叫,さけんで、「エリ、エリ、レマ、サバクタニ」と言,いわれた。それは「わが神,かみ、わが神,かみ、どうしてわたしをお見捨,みすてになったのですか」という意味,いみである。","tok":[["そして"],["三","さん"],["時","じ"],["に"],["、"],["イエス"],["は"],["大声","おおごえ"],["で"],["叫けんで","さけんで"],["、"],["「"],["エリ"],["、"],["エリ"],["、"],["レマ"],["、"],["サバクタニ"],["」"],["と"],["言われた","いわれた"],["。"],["それ"],["は"],["「"],["わが"],["神","かみ"],["、"],["わが"],["神","かみ"],["、"],["どう"],["して"],["わたし"],["を"],["お見捨て","おみすて"],["に"],["なった"],["の"],["です"],["か"],["」"],["と"],["いう"],["意味","いみ"],["で"],["ある"],["。"]]},{"verse":47,"text":"すると、そこに立,たっていたある人々,ひとびとが、これを聞,きいて言,いった、「あれはエリヤを呼,よんでいるのだ」。","tok":[["する"],["と"],["、"],["そこ"],["に"],["立って","たって"],["いた"],["ある"],["人々","ひとびと"],["が"],["、"],["これ"],["を"],["聞いて","きいて"],["言った","いった"],["、"],["「"],["あれ"],["は"],["エリヤ"],["を"],["呼","よんでいる"],["の"],["だ"],["」"],["。"]]},{"verse":48,"text":"するとすぐ、彼,かれらのうちのひとりが走,はしり寄,よって、海綿,かいめんを取,とり、それに酢,すいぶどう酒,しゅを含,ふくませて葦,あしの棒,ぼうにつけ、イエスに飲,のませようとした。","tok":[["する"],["と"],["すぐ"],["、"],["彼","かれ"],["ら"],["の"],["うち"],["の"],["ひとり"],["が"],["走り寄って","はしりよって"],["、"],["海綿","かいめん"],["を"],["取","とり"],["、"],["それ"],["に"],["酢","す"],["い"],["ぶどう酒","ぶどうしゅ"],["を"],["含ませて","ふくませて"],["葦","あし"],["の"],["棒","ぼう"],["に"],["つけ"],["、"],["イエス"],["に"],["飲ませよう","のませよう"],["と"],["した"],["。"]]},{"verse":49,"text":"ほかの人々,ひとびとは言,いった、「待,まて、エリヤが彼,かれを救,すくいに来,くるかどうか、見,みていよう」。","tok":[["ほか"],["の"],["人々","ひとびと"],["は"],["言った","いった"],["、"],["「"],["待て","まて"],["、"],["エリヤ"],["が"],["彼","かれ"],["を"],["救い","すくい"],["に"],["来る","くる"],["か"],["どう"],["か"],["、"],["見て","みて"],["いよう"],["」"],["。"]]},{"verse":50,"text":"イエスはもう一度,いちど大声,おおごえで叫,さけんで、ついに息,いきをひきとられた。","tok":[["イエス"],["は"],["もう"],["一度","いちど"],["大声","おおごえ"],["で"],["叫けんで","さけんで"],["、"],["ついに"],["息","いき"],["を"],["ひきとられた"],["。"]]},{"verse":51,"text":"すると見,みよ、神殿,しんでんの幕,まくが上,うえから下,したまで真二,まっぷたつに裂,さけた。また地震,じしんがあり、岩,いわが裂,さけ、","tok":[["する"],["と"],["見よ","みよ"],["、"],["神殿","しんでん"],["の"],["幕","まく"],["が"],["上","うえ"],["から"],["下","した"],["まで"],["真二","まっぷたつ"],["に"],["裂けた","さけた"],["。"],["また"],["地震","じしん"],["が"],["あり"],["、"],["岩","いわ"],["が"],["裂け","さけ"],["、"]]},{"verse":52,"text":"また墓,はかが開,あけ、眠,ねむっている多,おおくの聖徒,せいとたちの死体,したいが生,いき返,かえった。","tok":[["また"],["墓","はか"],["が"],["開け","あけ"],["、"],["眠って","ねむって"],["いる"],["多く","おおく"],["の"],["聖徒","せいと"],["たち"],["の"],["死体","したい"],["が"],["生き返った","いきかえった"],["。"]]},{"verse":53,"text":"そしてイエスの復活,ふっかつののち、墓,はかから出,でてきて、聖,せいなる都,みやこにはいり、多,おおくの人,ひとに現,あらわれた。","tok":[["そして"],["イエス"],["の"],["復活","ふっかつ"],["の"],["のち"],["、"],["墓","はか"],["から"],["出て","でて"],["きて"],["、"],["聖","せい"],["なる"],["都","みやこ"],["に"],["はいり"],["、"],["多く","おおく"],["の"],["人","ひと"],["に"],["現われた","あらわれた"],["。"]]},{"verse":54,"text":"百卒長,ひゃくそつちょう、および彼,かれと一緒,いっしょにイエスの番,ばんをしていた人々,ひとびとは、地震,じしんや、いろいろのできごとを見,みて非常,ひじょうに恐,おそれ、「まことに、この人,ひとは神,かみの子,こであった」と言,いった。","tok":[["百卒長","ひゃくそつちょう"],["、"],["および"],["彼","かれ"],["と"],["一緒","いっしょ"],["に"],["イエス"],["の"],["番","ばん"],["を"],["して"],["いた"],["人々","ひとびと"],["は"],["、"],["地震","じしん"],["や"],["、"],["いろいろ"],["の"],["できごと"],["を"],["見て","みて"],["非常","ひじょう"],["に"],["恐","おそれ"],["、"],["「"],["まこと"],["に"],["、"],["この"],["人","ひと"],["は"],["神","かみ"],["の"],["子","こ"],["で"],["あった"],["」"],["と"],["言った","いった"],["。"]]},{"verse":55,"text":"また、そこには遠,とおくの方,ほうから見,みている女,おんなたちも多,おおくいた。彼,かれらはイエスに仕,つかえて、ガリラヤから従,したがってきた人,ひとたちであった。","tok":[["また"],["、"],["そこ"],["に"],["は"],["遠く","とおく"],["の"],["方","ほう"],["から"],["見て","みて"],["いる"],["女","おんな"],["たち"],["も"],["多く","おおく"],["いた"],["。"],["彼","かれ"],["ら"],["は"],["イエス"],["に"],["仕えて","つかえて"],["、"],["ガリラヤ"],["から"],["従って","したがって"],["きた"],["人","ひと"],["たち"],["で"],["あった"],["。"]]},{"verse":56,"text":"その中,なかには、マグダラのマリヤ、ヤコブとヨセフとの母,ははマリヤ、またゼベダイの子,こたちの母,ははがいた。","tok":[["その"],["中","なか"],["に"],["は"],["、"],["マグダラ"],["の"],["マリヤ"],["、"],["ヤコブ"],["と"],["ヨセフ"],["と"],["の"],["母","はは"],["マリヤ"],["、"],["また"],["ゼベダイ"],["の"],["子","こ"],["たち"],["の"],["母","はは"],["が"],["いた"],["。"]]},{"verse":57,"text":"夕方,ゆうがたになってから、アリマタヤの金持,かねもちで、ヨセフという名,なの人,ひとがきた。彼,かれもまたイエスの弟子,でしであった。","tok":[["夕方","ゆうがた"],["に"],["なって"],["から"],["、"],["アリマタヤ"],["の"],["金持","かねもち"],["で"],["、"],["ヨセフ"],["と"],["いう"],["名","な"],["の"],["人","ひと"],["が"],["きた"],["。"],["彼","かれ"],["も"],["また"],["イエス"],["の"],["弟子","でし"],["で"],["あった"],["。"]]},{"verse":58,"text":"この人,ひとがピラトの所,ところへ行,いって、イエスのからだの引取,ひきとりかたを願,ねがった。そこで、ピラトはそれを渡,わたすように命,めいじた。","tok":[["この"],["人","ひと"],["が"],["ピラト"],["の"],["所","ところ"],["へ"],["行って","いって"],["、"],["イエス"],["の"],["からだ"],["の"],["引取","ひきとり"],["かた"],["を"],["願った","ねがった"],["。"],["そこ"],["で"],["、"],["ピラト"],["は"],["それ"],["を"],["渡す","わたす"],["よう"],["に"],["命じた","めいじた"],["。"]]},{"verse":59,"text":"ヨセフは死体,したいを受,うけ取,とって、きれいな亜麻布,あまぬのに包,つつみ、","tok":[["ヨセフ"],["は"],["死体","したい"],["を"],["受け取って","うけとって"],["、"],["きれい"],["な"],["亜","あ"],["麻布","あざぶ"],["のに"],["包","つつみ"],["、"]]},{"verse":60,"text":"岩,いわを掘,ほって造,つくった彼,かれの新,あたらしい墓,はかに納,おさめ、そして墓,はかの入口,いりぐちに大,おおきい石,いしをころがしておいて、帰,かえった。","tok":[["岩","いわ"],["を"],["掘って","ほって"],["造った","つくった"],["彼","かれ"],["の"],["新らしい","あたらしい"],["墓","はか"],["に"],["納","おさめ"],["、"],["そして"],["墓","はか"],["の"],["入口","いりぐち"],["に"],["大きい","おおきい"],["石","いし"],["を"],["ころがして"],["おいて"],["、"],["帰えった","かえった"],["。"]]},{"verse":61,"text":"マグダラのマリヤとほかのマリヤとが、墓,はかにむかってそこにすわっていた。","tok":[["マグダラ"],["の"],["マリヤ"],["と"],["ほか"],["の"],["マリヤ"],["と"],["が"],["、"],["墓","はか"],["に"],["むかって"],["そこ"],["に"],["すわって"],["いた"],["。"]]},{"verse":62,"text":"あくる日,ひは準備,じゅんびの日,ひの翌日,よくじつであったが、その日,ひに、祭司長,さいしちょう、パリサイ人,びとたちは、ピラトのもとに集,あつまって言,いった、","tok":[["あくる日","あくるひ"],["は"],["準備","じゅんび"],["の"],["日","ひ"],["の"],["翌日","よくじつ"],["で"],["あった"],["が"],["、"],["その"],["日","ひ"],["に"],["、"],["祭司長","さいしちょう"],["、"],["パリサイ"],["人","びとたち"],["は"],["、"],["ピラト"],["の"],["もと"],["に"],["集まって","あつまって"],["言った","いった"],["、"]]},{"verse":63,"text":"「長官,ちょうかん、あの偽,いつわり者,ものがまだ生,いきていたとき、『三日,かの後,のちに自分,じぶんはよみがえる』と言,いったのを、思,おもい出,だしました。","tok":[["「"],["長官","ちょうかん"],["、"],["あの"],["偽わり","いつわり"],["者","もの"],["が"],["まだ"],["生きて","いきて"],["いた"],["とき"],["、"],["『"],["三日","か"],["の"],["後","のち"],["に"],["自分","じぶん"],["は"],["よみがえる"],["』"],["と"],["言った","いった"],["の"],["を"],["、"],["思い出しました","おもいだしました"],["。"]]},{"verse":64,"text":"ですから、三日,か目,めまで墓,はかの番,ばんをするように、さしずをして下,ください。そうしないと、弟子,でしたちがきて彼,かれを盗,ぬすみ出,だし、『イエスは死人,しにんの中,なかから、よみがえった』と、民衆,みんしゅうに言,いいふらすかも知,しれません。そうなると、みんなが前,まえよりも、もっとひどくだまされることになりましょう」。","tok":[["です"],["から"],["、"],["三日目","かめ"],["まで"],["墓","はか"],["の"],["番","ばん"],["を"],["する"],["よう"],["に"],["、"],["さしず"],["を"],["して"],["下さい","ください"],["。"],["そう"],["しない"],["と"],["、"],["弟子","でし"],["たち"],["が"],["きて"],["彼","かれ"],["を"],["盗み出し","ぬすみだし"],["、"],["『"],["イエス"],["は"],["死人","しにん"],["の"],["中","なか"],["から"],["、"],["よみがえった"],["』"],["と"],["、"],["民衆","みんしゅう"],["に"],["言いふらす","いいふらす"],["か"],["も"],["知れません","しれません"],["。"],["そう"],["なる"],["と"],["、"],["みんな"],["が"],["前","まえ"],["より"],["も"],["、"],["もっと"],["ひどく"],["だまされる"],["こと"],["に"],["なりましょう"],["」"],["。"]]},{"verse":65,"text":"ピラトは彼,かれらに言,いった、「番人,ばんにんがいるから、行,いってできる限,かぎり、番,ばんをさせるがよい」。","tok":[["ピラト"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["番人","ばんにん"],["が"],["いる"],["から"],["、"],["行って","いって"],["できる"],["限","かぎり"],["、"],["番","ばん"],["を"],["させる"],["が"],["よい"],["」"],["。"]]},{"verse":66,"text":"そこで、彼,かれらは行,いって石,いしに封印,ふういんをし、番人,ばんにんを置,おいて墓,はかの番,ばんをさせた。","tok":[["そこ"],["で"],["、"],["彼","かれ"],["ら"],["は"],["行って","いって"],["石","いし"],["に"],["封印","ふういん"],["を"],["し"],["、"],["番人","ばんにん"],["を"],["置いて","おいて"],["墓","はか"],["の"],["番","ばん"],["を"],["させた"],["。"]]}]
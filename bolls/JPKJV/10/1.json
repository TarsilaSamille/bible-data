[{"verse":1,"text":"サウルが死,しんだ後,のち、ダビデはアマレクびとを撃,うって帰,かえり、ふつかの間,あいだチクラグにとどまっていたが、","tok":[["サウル"],["が"],["死んだ","しんだ"],["後","の"],["ち"],["、"],["ダビデ"],["は"],["アマレク"],["びと"],["を"],["撃って","うって"],["帰えり","かえり"],["、"],["ふ"],["つかの間","つかのあ"],["い"],["だ"],["チクラグ"],["に"],["とどまって"],["いた"],["が"],["、"]]},{"verse":2,"text":"三日,か目,めとなって、ひとりの人,ひとが、その着物,きものを裂,さき、頭,あたまに土,つちをかぶって、サウルの陣営,じんえいからきた。そしてダビデのもとにきて、地,ちに伏,ふして拝,はいした。","tok":[["三日目","かめ"],["と"],["なって"],["、"],["ひとり"],["の"],["人","ひと"],["が"],["、"],["その"],["着物","きもの"],["を"],["裂き","さき"],["、"],["頭","あたま"],["に"],["土","つち"],["を"],["かぶって"],["、"],["サウル"],["の"],["陣営","じんえい"],["から"],["きた"],["。"],["そして"],["ダビデ"],["の"],["もと"],["に"],["きて"],["、"],["地","ち"],["に"],["伏して","ふして"],["拝した","はいした"],["。"]]},{"verse":3,"text":"ダビデは彼,かれに言,いった、「あなたはどこからきたのか」。彼,かれはダビデに言,いった、「わたしはイスラエルの陣営,じんえいから、のがれてきたのです」。","tok":[["ダビデ"],["は"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["は"],["どこ"],["から"],["きた"],["の"],["か"],["」"],["。"],["彼","かれ"],["は"],["ダビデ"],["に"],["言った","いった"],["、"],["「"],["わたし"],["は"],["イスラエル"],["の"],["陣営","じんえい"],["から"],["、"],["のがれて"],["きた"],["の"],["です"],["」"],["。"]]},{"verse":4,"text":"ダビデは彼,かれに言,いった、「様子,ようすはどうであったか話,はなしなさい」。彼,かれは答,こたえた、「民,たみは戦,たたかいから逃,にげ、民,たみの多,おおくは倒,たおれて死,しに、サウルとその子,こヨナタンもまた死,しにました」。","tok":[["ダビデ"],["は"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["様子","ようす"],["は"],["どう"],["で"],["あった"],["か"],["話","はなし"],["なさい"],["」"],["。"],["彼","かれ"],["は"],["答","こたえ"],["た"],["、"],["「"],["民","たみ"],["は"],["戦い","たたかい"],["から"],["逃","にげ"],["、"],["民","たみ"],["の"],["多く","おおく"],["は"],["倒れて","たおれて"],["死に","しに"],["、"],["サウル"],["と"],["その"],["子","こ"],["ヨナタン"],["も"],["また"],["死にました","しにました"],["」"],["。"]]},{"verse":5,"text":"ダビデは自分,じぶんと話,はなしている若者,わかものに言,いった、「あなたはサウルとその子,こヨナタンが死,しんだのを、どうして知,しったのか」。","tok":[["ダビデ"],["は"],["自分","じぶん"],["と"],["話","はなし"],["て"],["いる"],["若者","わかもの"],["に"],["言った","いった"],["、"],["「"],["あなた"],["は"],["サウル"],["と"],["その"],["子","こ"],["ヨナタン"],["が"],["死んだ","しんだ"],["の"],["を"],["、"],["どう"],["して"],["知った","しった"],["の"],["か"],["」"],["。"]]},{"verse":6,"text":"彼,かれに話,はなしている若者,わかものは言,いった、「わたしは、はからずも、ギルボア山,やまにいましたが、サウルはそのやりによりかかっており、戦車,せんしゃと騎兵,きへいとが彼,かれに攻,せめ寄,よろうとしていました。","tok":[["彼","かれ"],["に"],["話","はなし"],["て"],["いる"],["若者","わかもの"],["は"],["言った","いった"],["、"],["「"],["わたし"],["は"],["、"],["はからず"],["も"],["、"],["ギルボア"],["山","やま"],["に"],["いました"],["が"],["、"],["サウル"],["は"],["その"],["やり"],["に"],["より"],["かかって"],["おり"],["、"],["戦車","せんしゃ"],["と"],["騎兵","きへい"],["と"],["が"],["彼","かれ"],["に"],["攻め寄ろう","せめよろう"],["として"],["いました"],["。"]]},{"verse":7,"text":"その時,とき、彼,かれはうしろを振,ふり向,むいてわたしを見,み、わたしを呼,よびましたので、『ここにいます』とわたしは答,こたえました。","tok":[["その"],["時","とき"],["、"],["彼","かれ"],["は"],["うしろ"],["を"],["振り向いて","ふりむいて"],["わたし"],["を"],["見","み"],["、"],["わたし"],["を"],["呼びました","よびました"],["ので"],["、"],["『"],["ここ"],["に"],["います"],["』"],["と"],["わたし"],["は"],["答","こたえ"],["ました"],["。"]]},{"verse":8,"text":"彼,かれは『おまえはだれか』と言,いいましたので、『アマレクびとです』と答,こたえました。","tok":[["彼","かれ"],["は"],["『"],["おまえ"],["は"],["だれ"],["か"],["』"],["と"],["言いました","いいました"],["ので"],["、"],["『"],["アマレク"],["びと"],["です"],["』"],["と"],["答","こたえ"],["ました"],["。"]]},{"verse":9,"text":"彼,かれはまたわたしに言,いいました、『そばにきて殺,ころしてください。わたしは苦,くるしみに耐,たえない。まだ命,いのちがあるからです』。","tok":[["彼","かれ"],["は"],["また"],["わたし"],["に"],["言いました","いいました"],["、"],["『"],["そば"],["に"],["きて"],["殺ろして","ころして"],["ください"],["。"],["わたし"],["は"],["苦しみ","くるしみ"],["に"],["耐えない","たえない"],["。"],["まだ"],["命","いのち"],["が"],["ある"],["から"],["です"],["』"],["。"]]},{"verse":10,"text":"そこで、わたしはそのそばにいって彼,かれを殺,ころしました。彼,かれがすでに倒,たおれて、生,いきることのできないのを知,しったからです。そしてわたしは彼,かれの頭,あたまにあった冠,かんむりと、腕,うでにつけていた腕輪,うでわとを取,とって、それをわが主,しゅのもとに携,たずさえてきたのです」。","tok":[["そこ"],["で"],["、"],["わたし"],["は"],["その"],["そば"],["に"],["いって"],["彼","かれ"],["を"],["殺ろしました","ころしました"],["。"],["彼","かれ"],["が"],["すでに"],["倒れて","たおれて"],["、"],["生きる","いきる"],["こと"],["の"],["できない"],["の"],["を"],["知った","しった"],["から"],["です"],["。"],["そして"],["わたし"],["は"],["彼","かれ"],["の"],["頭","あたま"],["に"],["あった"],["冠","かんむり"],["と"],["、"],["腕","うで"],["に"],["つけて"],["いた"],["腕輪","うでわ"],["と"],["を"],["取って","とって"],["、"],["それ"],["を"],["わが"],["主","しゅ"],["の"],["もと"],["に"],["携えて","たずさえて"],["きた"],["の"],["です"],["」"],["。"]]},{"verse":11,"text":"そのときダビデは自分,じぶんの着物,きものをつかんでそれを裂,さき、彼,かれと共,ともにいた人々,ひとびとも皆,みな同,おなじようにした。","tok":[["その"],["とき"],["ダビデ"],["は"],["自分","じぶん"],["の"],["着物","きもの"],["を"],["つかんで"],["それ"],["を"],["裂き","さき"],["、"],["彼","かれ"],["と"],["共","とも"],["に"],["いた"],["人々","ひとびと"],["も"],["皆","みな"],["同じ","おなじ"],["よう"],["に"],["した"],["。"]]},{"verse":12,"text":"彼,かれらはサウルのため、またその子,こヨナタンのため、また主,しゅの民,たみのため、またイスラエルの家,いえのために悲,かなしみ泣,ないて、夕暮,ゆうぐれまで食,しょくを断,たった。それは彼,かれらがつるぎに倒,たおれたからである。","tok":[["彼","かれ"],["ら"],["は"],["サウル"],["の"],["ため"],["、"],["また"],["その"],["子","こ"],["ヨナタン"],["の"],["ため"],["、"],["また"],["主","しゅ"],["の"],["民","たみ"],["の"],["ため"],["、"],["また"],["イスラエル"],["の"],["家","いえ"],["の"],["ため"],["に"],["悲しみ","かなしみ"],["泣いて","ないて"],["、"],["夕暮","ゆうぐれ"],["まで"],["食","しょく"],["を"],["断った","たった"],["。"],["それ"],["は"],["彼","かれ"],["ら"],["が"],["つるぎ"],["に"],["倒れた","たおれた"],["から"],["で"],["ある"],["。"]]},{"verse":13,"text":"ダビデは自分,じぶんと話,はなしていた若者,わかものに言,いった、「あなたはどこの人,ひとですか」。彼,かれは言,いった、「アマレクびとで、寄留,きりゅうの他国,たこく人,じんの子,こです」。","tok":[["ダビデ"],["は"],["自分","じぶん"],["と"],["話","はなし"],["て"],["いた"],["若者","わかもの"],["に"],["言った","いった"],["、"],["「"],["あなた"],["は"],["どこ"],["の"],["人","ひと"],["です"],["か"],["」"],["。"],["彼","かれ"],["は"],["言った","いった"],["、"],["「"],["アマレク"],["びと"],["で"],["、"],["寄留","きりゅう"],["の"],["他国人","たこくじん"],["の"],["子","こ"],["です"],["」"],["。"]]},{"verse":14,"text":"ダビデはまた彼,かれに言,いった、「どうしてあなたは手,てを伸,のべて主,しゅの油,あぶらを注,そそがれた者,ものを殺,ころすことを恐,おそれなかったのですか」。","tok":[["ダビデ"],["は"],["また"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["どう"],["して"],["あなた"],["は"],["手","て"],["を"],["伸べて","のべて"],["主","しゅ"],["の"],["油","あぶら"],["を"],["注がれた","そそがれた"],["者","もの"],["を"],["殺ろす","ころす"],["こと"],["を"],["恐れなかった","おそれなかった"],["の"],["です"],["か"],["」"],["。"]]},{"verse":15,"text":"ダビデはひとりの若者,わかものを呼,よび、「近寄,ちかよって彼,かれを撃,うて」と言,いった。そこで彼,かれを撃,うったので死,しんだ。","tok":[["ダビデ"],["は"],["ひとり"],["の"],["若者","わかもの"],["を"],["呼び","よび"],["、"],["「"],["近寄って","ちかよって"],["彼","かれ"],["を"],["撃て","うて"],["」"],["と"],["言った","いった"],["。"],["そこ"],["で"],["彼","かれ"],["を"],["撃った","うった"],["ので"],["死んだ","しんだ"],["。"]]},{"verse":16,"text":"ダビデは彼,かれに言,いった、「あなたの流,ながした血,ちの責,せめはあなたに帰,きする。あなたが自分,じぶんの口,くちから、『わたしは主,しゅの油,あぶらを注,そそがれた者,ものを殺,ころした』と言,いって、自身,じしんにむかって証拠,しょうこを立,たてたからである」。","tok":[["ダビデ"],["は"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["の"],["流した","ながした"],["血","ち"],["の"],["責","せめ"],["は"],["あなた"],["に"],["帰する","きする"],["。"],["あなた"],["が"],["自分","じぶん"],["の"],["口","くち"],["から"],["、"],["『"],["わたし"],["は"],["主","しゅ"],["の"],["油","あぶら"],["を"],["注がれた","そそがれた"],["者","もの"],["を"],["殺ろした","ころした"],["』"],["と"],["言って","いって"],["、"],["自身","じしん"],["に"],["むかって"],["証拠","しょうこ"],["を"],["立てた","たてた"],["から"],["で"],["ある"],["」"],["。"]]},{"verse":17,"text":"ダビデはこの悲,かなしみの歌,うたをもって、サウルとその子,こヨナタンのために哀悼,あいとうした。――","tok":[["ダビデ"],["は"],["この"],["悲しみ","かなしみ"],["の"],["歌","うた"],["を"],["もって"],["、"],["サウル"],["と"],["その"],["子","こ"],["ヨナタン"],["の"],["ため"],["に"],["哀悼","あいとう"],["した"],["。"],["―"],["―"]]},{"verse":18,"text":"これは、ユダの人々,ひとびとに教,おしえるための弓,ゆみの歌,うたで、ヤシャルの書,しょにしるされている。――彼,かれは言,いった、","tok":[["これ"],["は"],["、"],["ユダ"],["の"],["人々","ひとびと"],["に"],["教える","おしえる"],["ため"],["の"],["弓","ゆみ"],["の"],["歌","うた"],["で"],["、"],["ヤシャル"],["の"],["書","しょ"],["に"],["しるされて"],["いる"],["。"],["―"],["―"],["彼","かれ"],["は"],["言った","いった"],["、"]]},{"verse":19,"text":"「イスラエルよ、あなたの栄光,えいこうは、あなたの高,たかき所,ところで殺,ころされた。ああ、勇士,ゆうしたちは、ついに倒,たおれた。","tok":[["「"],["イスラエル"],["よ"],["、"],["あなた"],["の"],["栄光","えいこう"],["は"],["、"],["あなた"],["の"],["高き","たかき"],["所","ところ"],["で"],["殺ろされた","ころされた"],["。"],["ああ"],["、"],["勇士","ゆうし"],["たち"],["は"],["、"],["ついに"],["倒れた","たおれた"],["。"]]},{"verse":20,"text":"ガテにこの事,ことを告,つげてはいけない。アシケロンのちまたに伝,つたえてはならない。おそらくはペリシテびとの娘,むすめたちが喜,よろこび、割礼,かつれいなき者,ものの娘,むすめたちが勝,かちほこるであろう。","tok":[["ガテ"],["に"],["この"],["事","こと"],["を"],["告","つげ"],["ては"],["いけない"],["。"],["アシケロン"],["の"],["ちまた"],["に"],["伝えて","つたえて"],["は"],["ならない"],["。"],["おそらく"],["は"],["ペリシテ"],["びと"],["の"],["娘","むすめ"],["たち"],["が"],["喜こび","よろこび"],["、"],["割礼","かつれい"],["なき"],["者","もの"],["の"],["娘","むすめ"],["たち"],["が"],["勝","かち"],["ほこるで"],["あろう"],["。"]]},{"verse":21,"text":"ギルボアの山,やまよ、露,つゆはおまえの上,うえにおりるな。死,しの野,のよ、雨,あめもおまえの上,うえに降,ふるな。その所,ところに勇士,ゆうしたちの盾,たては捨,すてられ、サウルの盾,たては油,あぶらを塗,ぬらずに捨,すてられた。","tok":[["ギルボア"],["の"],["山","やま"],["よ"],["、"],["露","つゆ"],["は"],["おまえ"],["の"],["上","うえ"],["に"],["おりる"],["な"],["。"],["死","し"],["の"],["野","の"],["よ"],["、"],["雨","あめ"],["も"],["おまえ"],["の"],["上","うえ"],["に"],["降る","ふる"],["な"],["。"],["その"],["所","ところ"],["に"],["勇士","ゆうし"],["たち"],["の"],["盾","たて"],["は"],["捨てられ","すてられ"],["、"],["サウル"],["の"],["盾","たて"],["は"],["油","あぶら"],["を"],["塗らず","ぬらず"],["に"],["捨てられた","すてられた"],["。"]]},{"verse":22,"text":"殺,ころした者,ものの血,ちを飲,のまずには、ヨナタンの弓,ゆみは退,しりぞかず、勇士,ゆうしの脂肪,しぼうを食,たべないでは、サウルのつるぎは、むなしくは帰,かえらなかった。","tok":[["殺ろした","ころした"],["者","もの"],["の"],["血","ち"],["を"],["飲まず","のまず"],["に"],["は"],["、"],["ヨナタン"],["の"],["弓","ゆみ"],["は"],["退ぞかず","しりぞかず"],["、"],["勇士","ゆうし"],["の"],["脂肪","しぼう"],["を"],["食べないで","たべないで"],["は"],["、"],["サウル"],["の"],["つるぎ"],["は"],["、"],["むなしく"],["は"],["帰えらなかった","かえらなかった"],["。"]]},{"verse":23,"text":"サウルとヨナタンとは、愛,あいされ、かつ喜,よろこばれた。彼,かれらは生,いきるにも、死,しぬにも離,はなれず、わしよりも早,はやく、ししよりも強,つよかった。","tok":[["サウル"],["と"],["ヨナタン"],["と"],["は"],["、"],["愛され","あいされ"],["、"],["かつ"],["喜こばれた","よろこばれた"],["。"],["彼","かれ"],["ら"],["は"],["生きる","いきる"],["に"],["も"],["、"],["死ぬ","しぬ"],["に"],["も"],["離れず","はなれず"],["、"],["わし"],["より"],["も"],["早く","はやく"],["、"],["しし"],["より"],["も"],["強かった","つよかった"],["。"]]},{"verse":24,"text":"イスラエルの娘,むすめたちよ、サウルのために泣,なけ。彼,かれは緋色,ひいろの着物,きものをもって、はなやかにあなたがたを装,よそおい、あなたがたの着物,きものに金,きんの飾,かざりをつけた。","tok":[["イスラエル"],["の"],["娘","むすめ"],["たち"],["よ"],["、"],["サウル"],["の"],["ため"],["に"],["泣け","なけ"],["。"],["彼","かれ"],["は"],["緋色","ひいろ"],["の"],["着物","きもの"],["を"],["もって"],["、"],["はなやか"],["に"],["あなた"],["がた"],["を"],["装い","よそおい"],["、"],["あなた"],["がた"],["の"],["着物","きもの"],["に"],["金","きん"],["の"],["飾","かざり"],["を"],["つけた"],["。"]]},{"verse":25,"text":"ああ、勇士,ゆうしたちは戦,たたかいのさなかに倒,たおれた。ヨナタンは、あなたの高,たかき所,ところで殺,ころされた。","tok":[["ああ"],["、"],["勇士","ゆうし"],["たち"],["は"],["戦い","たたかい"],["の"],["さなか"],["に"],["倒れた","たおれた"],["。"],["ヨナタン"],["は"],["、"],["あなた"],["の"],["高き","たかき"],["所","ところ"],["で"],["殺ろされた","ころされた"],["。"]]},{"verse":26,"text":"わが兄弟,きょうだいヨナタンよ、あなたのためわたしは悲,かなしむ。あなたはわたしにとって、いとも楽,たのしい者,ものであった。あなたがわたしを愛,あいするのは世,よの常,つねのようでなく、女,おんなの愛,あいにもまさっていた。","tok":[["わが"],["兄弟","きょうだい"],["ヨナタン"],["よ"],["、"],["あなた"],["の"],["ため"],["わたし"],["は"],["悲しむ","かなしむ"],["。"],["あなた"],["は"],["わたし"],["にとって"],["、"],["いとも"],["楽い","たのしい"],["者","もの"],["で"],["あった"],["。"],["あなた"],["が"],["わたし"],["を"],["愛する","あいする"],["の"],["は"],["世","よ"],["の"],["常","つね"],["の"],["よう"],["で"],["なく"],["、"],["女","おんな"],["の"],["愛","あい"],["に"],["も"],["まさって"],["いた"],["。"]]},{"verse":27,"text":"ああ、勇士,ゆうしたちは倒,たおれた。戦,たたかいの器,うつわはうせた」。","tok":[["ああ"],["、"],["勇士","ゆうし"],["たち"],["は"],["倒れた","たおれた"],["。"],["戦い","たたかい"],["の"],["器","うつわ"],["は"],["うせた"],["」"],["。"]]}]
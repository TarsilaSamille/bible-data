[{"verse":1,"text":"ゼルヤの子,こヨアブは王,おうの心,こころがアブサロムに向,むかっているのを知,しった。","tok":[["ゼルヤ"],["の"],["子","こ"],["ヨアブ"],["は"],["王","おう"],["の"],["心","こころ"],["が"],["アブサロム"],["に"],["向かって","むかって"],["いる"],["の"],["を"],["知った","しった"],["。"]]},{"verse":2,"text":"そこでヨアブはテコアに人,ひとをつかわして、そこからひとりの賢,かしこい女,おんなを連,つれてこさせ、その女,おんなに言,いった、「あなたは悲,かなしみのうちにある人,ひとをよそおって、喪服,もふくを着,き、油,あぶらを身,みに塗,ぬらず、死,しんだ人,ひとのために長,ながいあいだ悲,かなしんでいる女,おんなのように、よそおって、","tok":[["そこ"],["で"],["ヨアブ"],["は"],["テコア"],["に"],["人","ひと"],["を"],["つかわして"],["、"],["そこ"],["から"],["ひとり"],["の"],["賢しこい","かしこい"],["女","おんな"],["を"],["連れて","つれて"],["こさせ"],["、"],["その"],["女","おんな"],["に"],["言った","いった"],["、"],["「"],["あなた"],["は"],["悲しみ","かなしみ"],["の"],["うち"],["に"],["ある"],["人","ひと"],["を"],["よそおって"],["、"],["喪服","もふく"],["を"],["着","き"],["、"],["油","あぶら"],["を"],["身","み"],["に"],["塗らず","ぬらず"],["、"],["死んだ","しんだ"],["人","ひと"],["の"],["ため"],["に"],["長い","ながい"],["あいだ"],["悲しんで","かなしんで"],["いる"],["女","おんな"],["の"],["よう"],["に"],["、"],["よそおって"],["、"]]},{"verse":3,"text":"王,おうのもとに行,いき、しかじかと彼,かれに語,かたりなさい」。こうしてヨアブはその言葉,ことばを彼女,かのじょの口,くちに授,さづけた。","tok":[["王","おう"],["の"],["もと"],["に"],["行き","いき"],["、"],["しかじか"],["と"],["彼","かれ"],["に"],["語り","かたり"],["なさい"],["」"],["。"],["こう"],["して"],["ヨアブ"],["は"],["その"],["言葉","ことば"],["を"],["彼女","かのじょ"],["の"],["口","くち"],["に"],["授","さ"],["づけた"],["。"]]},{"verse":4,"text":"テコアの女,おんなは王,おうのもとに行,いき、地,ちに伏,ふして拝,はいし、「王,おうよ、お助,たすけください」と言,いった。","tok":[["テコア"],["の"],["女","おんな"],["は"],["王","おう"],["の"],["もと"],["に"],["行き","いき"],["、"],["地","ち"],["に"],["伏して","ふして"],["拝し","はいし"],["、"],["「"],["王","おう"],["よ"],["、"],["お助け","おたすけ"],["ください"],["」"],["と"],["言った","いった"],["。"]]},{"verse":5,"text":"王,おうは女,おんなに言,いった、「どうしたのか」。女,おんなは言,いった、「まことにわたしは寡婦,かふでありまして、夫,おっとは死,しにました。","tok":[["王","おう"],["は"],["女","おんな"],["に"],["言った","いった"],["、"],["「"],["どう"],["した"],["の"],["か"],["」"],["。"],["女","おんな"],["は"],["言った","いった"],["、"],["「"],["まこと"],["に"],["わたし"],["は"],["寡婦","かふ"],["で"],["ありまして"],["、"],["夫","おっと"],["は"],["死にました","しにました"],["。"]]},{"verse":6,"text":"つかえめにはふたりの子,こどもがあり、ふたりは野,ので争,あらそいましたが、だれも彼,かれらを引,ひき分,わける者,ものがなかったので、ひとりはついに他,たの者,ものを撃,うって殺,ころしました。","tok":[["つかえ"],["め"],["に"],["は"],["ふたり"],["の"],["子ども","こども"],["が"],["あり"],["、"],["ふたり"],["は"],["野","の"],["で"],["争いました","あらそいました"],["が"],["、"],["だれ"],["も"],["彼","かれ"],["ら"],["を"],["引分ける","ひきわける"],["者","もの"],["が"],["なかった"],["ので"],["、"],["ひとり"],["は"],["ついに"],["他","た"],["の"],["者","もの"],["を"],["撃って","うって"],["殺ろしました","ころしました"],["。"]]},{"verse":7,"text":"すると全家,ぜんか族,ぞくがつかえめに逆,さからい立,たって、『兄弟,きょうだいを撃,うち殺,ころした者,ものを引,ひき渡,わたすがよい。われわれは彼,かれが殺,ころしたその兄弟,きょうだいの命,いのちのために彼,かれを殺,ころそう』と言,いい、彼,かれらは世継,よつぎをも殺,ころそうとしました。こうして彼,かれらは残,のこっているわたしの炭火,すみびを消,けして、わたしの夫,おっとの名,なをも、跡,あと継,つぎをも、地,ちのおもてにとどめないようにしようとしています」。","tok":[["する"],["と"],["全","ぜん"],["家族","家ぞく"],["が"],["つかえ"],["め"],["に"],["逆らい","さからい"],["立って","たって"],["、"],["『"],["兄弟","きょうだい"],["を"],["撃ち殺した","うちころした"],["者","もの"],["を"],["引渡す","ひきわたす"],["が"],["よい"],["。"],["われわれ"],["は"],["彼","かれ"],["が"],["殺ろした","ころした"],["その"],["兄弟","きょうだい"],["の"],["命","いのち"],["の"],["ため"],["に"],["彼","かれ"],["を"],["殺そう","ころそう"],["』"],["と"],["言い","いい"],["、"],["彼","かれ"],["ら"],["は"],["世継","よつぎ"],["を"],["も"],["殺そう","ころそう"],["と"],["しました"],["。"],["こう"],["して"],["彼","かれ"],["ら"],["は"],["残って","のこって"],["いる"],["わたし"],["の"],["炭火","すみび"],["を"],["消して","けして"],["、"],["わたし"],["の"],["夫","おっと"],["の"],["名","な"],["を"],["も"],["、"],["跡継","あとつぎ"],["を"],["も"],["、"],["地","ち"],["の"],["おもて"],["に"],["とどめない"],["よう"],["に"],["しよう"],["として"],["います"],["」"],["。"]]},{"verse":8,"text":"王,おうは女,おんなに言,いった、「家,いえに帰,かえりなさい。わたしはあなたのことについて命令,めいれいを下,くだします」。","tok":[["王","おう"],["は"],["女","おんな"],["に"],["言った","いった"],["、"],["「"],["家","いえ"],["に"],["帰えり","かえり"],["なさい"],["。"],["わたし"],["は"],["あなた"],["の"],["こと"],["について"],["命令","めいれい"],["を"],["下します","くだします"],["」"],["。"]]},{"verse":9,"text":"テコアの女,おんなは王,おうに言,いった、「わが主,しゅ、王,おうよ、わたしとわたしの父,ちちの家,いえにその罪,つみを帰,きしてください。どうぞ王,おうと王,おうの位,くらいには罪,つみがありませんように」。","tok":[["テコア"],["の"],["女","おんな"],["は"],["王","おう"],["に"],["言った","いった"],["、"],["「"],["わが"],["主","しゅ"],["、"],["王","おう"],["よ"],["、"],["わたし"],["と"],["わたし"],["の"],["父","ちち"],["の"],["家","いえ"],["に"],["その"],["罪","つみ"],["を"],["帰して","きして"],["ください"],["。"],["どうぞ"],["王","おう"],["と"],["王","おう"],["の"],["位","くらい"],["に"],["は"],["罪","つみ"],["が"],["ありません"],["よう"],["に"],["」"],["。"]]},{"verse":10,"text":"王,おうは言,いった、「もしあなたに何,なにか言,いう者,ものがあれば、わたしの所,ところに連,つれてきなさい。そうすれば、その人,ひとは重,かさねてあなたに触,ふれることはないでしょう」。","tok":[["王","おう"],["は"],["言った","いった"],["、"],["「"],["もし"],["あなた"],["に"],["何に","なに"],["か"],["言う","いう"],["者","もの"],["が"],["あれば"],["、"],["わたし"],["の"],["所","ところ"],["に"],["連れて","つれて"],["き"],["なさい"],["。"],["そう"],["すれば"],["、"],["その"],["人","ひと"],["は"],["重ねて","かさねて"],["あなた"],["に"],["触れる","ふれる"],["こと"],["は"],["ないでしょう"],["」"],["。"]]},{"verse":11,"text":"女,おんなは言,いった、「どうぞ王,おうが、あなたの神,かみ、主,しゅをおぼえて、血,ちの報復,ほうふくをする者,ものに重,かさねて滅,ほろぼすことをさせず、わたしの子,この殺,ころされることのないようにしてください」。王,おうは言,いった、「主,しゅは生,いきておられる。あなたの子,この髪,かみの毛,け一筋,すじも地,ちに落,おちることはないでしょう」。","tok":[["女","おんな"],["は"],["言った","いった"],["、"],["「"],["どうぞ"],["王","おう"],["が"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["を"],["おぼえて"],["、"],["血","ち"],["の"],["報復","ほうふく"],["を"],["する"],["者","もの"],["に"],["重ねて","かさねて"],["滅ぼす","ほろぼす"],["こと"],["を"],["させず"],["、"],["わたし"],["の"],["子","こ"],["の"],["殺ろされる","ころされる"],["こと"],["の"],["ない"],["よう"],["に"],["して"],["ください"],["」"],["。"],["王","おう"],["は"],["言った","いった"],["、"],["「"],["主","しゅ"],["は"],["生きて","いきて"],["おられる"],["。"],["あなた"],["の"],["子","こ"],["の"],["髪の毛","かみのけ"],["一筋","すじ"],["も"],["地","ち"],["に"],["落","おち"],["る"],["こと"],["は"],["ないでしょう"],["」"],["。"]]},{"verse":12,"text":"女,おんなは言,いった、「どうぞ、つかえめにひと言,こと、わが主,しゅ、王,おうに言,いわせてください」。ダビデは言,いった、「言,いいなさい」。","tok":[["女","おんな"],["は"],["言った","いった"],["、"],["「"],["どうぞ"],["、"],["つかえ"],["め"],["に"],["ひと言","ひとこと"],["、"],["わが"],["主","しゅ"],["、"],["王","おう"],["に"],["言わせて","いわせて"],["ください"],["」"],["。"],["ダビデ"],["は"],["言った","いった"],["、"],["「"],["言い","いい"],["なさい"],["」"],["。"]]},{"verse":13,"text":"女,おんなは言,いった、「あなたは、それならばどうして、神,かみの民,たみに向,むかってこのような事,ことを図,はかられたのですか。王,おうは今,いまこの事,ことを言,いわれたことによって自分,じぶんを罪,つみある者,ものとされています。それは王,おうが追放,ついほうされた者,ものを帰,かえらせられないからです。","tok":[["女","おんな"],["は"],["言った","いった"],["、"],["「"],["あなた"],["は"],["、"],["それ"],["ならば"],["どう"],["して"],["、"],["神","かみ"],["の"],["民","たみ"],["に"],["向かって","むかって"],["この"],["よう"],["な"],["事","こと"],["を"],["図られた","はかられた"],["の"],["です"],["か"],["。"],["王","おう"],["は"],["今","いま"],["この"],["事","こと"],["を"],["言われた","いわれた"],["こと"],["によって"],["自分","じぶん"],["を"],["罪","つみ"],["ある"],["者","もの"],["と"],["されて"],["います"],["。"],["それ"],["は"],["王","おう"],["が"],["追放","ついほう"],["された"],["者","もの"],["を"],["帰えらせられない","かえらせられない"],["から"],["です"],["。"]]},{"verse":14,"text":"わたしたちはみな死,しななければなりません。地,ちにこぼれた水,みずの再,ふたたび集,あつめることのできないのと同,おなじです。しかし神,かみは、追放,ついほうされた者,ものが捨,すてられないように、てだてを設,もうける人,ひとの命,いのちを取,とることはなさいません。","tok":[["わたしたち"],["は"],["みな"],["死ななければ","しななければ"],["なりません"],["。"],["地","ち"],["に"],["こぼれた"],["水","みず"],["の"],["再び","ふたたび"],["集める","あつめる"],["こと"],["の"],["できない"],["の"],["と"],["同じ","おなじ"],["です"],["。"],["しかし"],["神","かみ"],["は"],["、"],["追放","ついほう"],["された"],["者","もの"],["が"],["捨てられない","すてられない"],["よう"],["に"],["、"],["てだて"],["を"],["設ける","もうける"],["人","ひと"],["の"],["命","いのち"],["を"],["取る","とる"],["こと"],["は"],["なさいません"],["。"]]},{"verse":15,"text":"わたしがこの事,ことを王,おう、わが主,しゅに言,いおうとして来,きたのは、わたしが民,たみを恐,おそれたからです。つかえめは、こう思,おもったのです、『王,おうに申,もうし上,あげよう。王,おうは、はしための願,ねがいのようにしてくださるかもしれない。","tok":[["わたし"],["が"],["この"],["事","こと"],["を"],["王","おう"],["、"],["わが"],["主","しゅ"],["に"],["言おう","いおう"],["として"],["来た","きた"],["の"],["は"],["、"],["わたし"],["が"],["民","たみ"],["を"],["恐れた","おそれた"],["から"],["です"],["。"],["つかえ"],["め"],["は"],["、"],["こう"],["思った","おもった"],["の"],["です"],["、"],["『"],["王","おう"],["に"],["申し上げよう","もうしあげよう"],["。"],["王","おう"],["は"],["、"],["はし"],["ため"],["の"],["願い","ねがい"],["の"],["よう"],["に"],["して"],["くださる"],["か"],["も"],["しれない"],["。"]]},{"verse":16,"text":"王,おうは聞,きいてくださる。わたしとわたしの子,こを共,ともに滅,ほろぼして神,かみの嗣,し業,ぎょうから離,はなれさせようとする人,ひとの手,てから、はしためを救,すくい出,だしてくださるのだから』。","tok":[["王","おう"],["は"],["聞いて","きいて"],["くださる"],["。"],["わたし"],["と"],["わたし"],["の"],["子","こ"],["を"],["共","とも"],["に"],["滅ぼして","ほろぼして"],["神","かみ"],["の"],["嗣業","しぎょうか"],["ら"],["離れ","はなれ"],["させよう"],["と"],["する"],["人","ひと"],["の"],["手","て"],["から"],["、"],["はし"],["ため"],["を"],["救い出して","すくいだして"],["くださる"],["の"],["だ"],["から"],["』"],["。"]]},{"verse":17,"text":"つかえめはまた、こう思,おもったのです、『王,おう、わが主,しゅの言葉,ことばはわたしを安心,あんしんさせるであろう』と。それは王,おう、わが主,しゅは神,かみの使,つかいのように善,ぜんと悪,あくを聞,ききわけられるからです。どうぞあなたの神,かみ、主,しゅがあなたと共,ともにおられますように」。","tok":[["つかえ"],["め"],["は"],["また"],["、"],["こう"],["思った","おもった"],["の"],["です"],["、"],["『"],["王","おう"],["、"],["わが"],["主","しゅ"],["の"],["言葉","ことば"],["は"],["わたし"],["を"],["安心","あんしん"],["させるで"],["あろう"],["』"],["と"],["。"],["それ"],["は"],["王","おう"],["、"],["わが"],["主","しゅ"],["は"],["神","かみ"],["の"],["使","つかい"],["の"],["よう"],["に"],["善","ぜん"],["と"],["悪","あく"],["を"],["聞","きき"],["わけられる"],["から"],["です"],["。"],["どうぞ"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["あなた"],["と"],["共","とも"],["に"],["おられます"],["よう"],["に"],["」"],["。"]]},{"verse":18,"text":"王,おうは女,おんなに答,こたえて言,いった、「わたしが問,とうことに隠,かくさず答,こたえてください」。女,おんなは言,いった、「王,おう、わが主,しゅよ、どうぞ言,いってください」。","tok":[["王","おう"],["は"],["女","おんな"],["に"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["わたし"],["が"],["問う","とう"],["こと"],["に"],["隠さず","かくさず"],["答","こたえ"],["て"],["ください"],["」"],["。"],["女","おんな"],["は"],["言った","いった"],["、"],["「"],["王","おう"],["、"],["わが"],["主","しゅ"],["よ"],["、"],["どうぞ"],["言って","いって"],["ください"],["」"],["。"]]},{"verse":19,"text":"王,おうは言,いった、「このすべての事,ことにおいて、ヨアブの手,てがあなたと共,ともにありますか」。女,おんなは答,こたえた、「あなたはたしかに生,いきておられます。王,おう、わが主,しゅよ、すべて王,おう、わが主,しゅの言,いわれた事,ことから人,ひとは右,みぎにも左,ひだりにも曲,まがることはできません。わたしに命,めいじたのは、あなたのしもべヨアブです。彼,かれがつかえめの口,くちに、これらの言葉,ことばをことごとく授,さづけたのです。","tok":[["王","おう"],["は"],["言った","いった"],["、"],["「"],["この"],["すべて"],["の"],["事","こと"],["に"],["おいて"],["、"],["ヨアブ"],["の"],["手","て"],["が"],["あなた"],["と"],["共","とも"],["に"],["あります"],["か"],["」"],["。"],["女","おんな"],["は"],["答","こたえ"],["た"],["、"],["「"],["あなた"],["は"],["たしか"],["に"],["生きて","いきて"],["おられます"],["。"],["王","おう"],["、"],["わが"],["主","しゅ"],["よ"],["、"],["すべて"],["王","おう"],["、"],["わが"],["主","しゅ"],["の"],["言われた","いわれた"],["事","こと"],["から"],["人","ひと"],["は"],["右","みぎ"],["に"],["も"],["左","ひだり"],["に"],["も"],["曲がる","まがる"],["こと"],["は"],["できません"],["。"],["わたし"],["に"],["命じた","めいじた"],["の"],["は"],["、"],["あなた"],["の"],["しもべ"],["ヨアブ"],["です"],["。"],["彼","かれ"],["が"],["つかえ"],["め"],["の"],["口","くち"],["に"],["、"],["これ"],["ら"],["の"],["言葉","ことば"],["を"],["ことごとく"],["授","さづけた"],["の"],["です"],["。"]]},{"verse":20,"text":"事,ことのなりゆきを変,かえるため、あなたのしもべヨアブがこの事,ことをしたのです。わが君,きみには神,かみの使,つかいの知恵,ちえのような知恵,ちえがあって、地,ちの上,うえのすべてのことを知,しっておられます」。","tok":[["事","こと"],["の"],["なりゆき"],["を"],["変える","かえる"],["ため"],["、"],["あなた"],["の"],["しもべ"],["ヨアブ"],["が"],["この"],["事","こと"],["を"],["した"],["の"],["です"],["。"],["わが"],["君","きみ"],["に"],["は"],["神","かみ"],["の"],["使","つかい"],["の"],["知恵","ちえ"],["の"],["よう"],["な"],["知恵","ちえ"],["が"],["あって"],["、"],["地","ち"],["の"],["上","うえ"],["の"],["すべて"],["の"],["こと"],["を"],["知って","しって"],["おられます"],["」"],["。"]]},{"verse":21,"text":"そこで王,おうはヨアブに言,いった、「この事,ことを許,ゆるす。行,いって、若者,わかものアブサロムを連,つれ帰,かえるがよい」。","tok":[["そこ"],["で"],["王","おう"],["は"],["ヨアブ"],["に"],["言った","いった"],["、"],["「"],["この"],["事","こと"],["を"],["許す","ゆるす"],["。"],["行って","いって"],["、"],["若者","わかもの"],["アブサロム"],["を"],["連れ","つれ"],["帰える","かえる"],["が"],["よい"],["」"],["。"]]},{"verse":22,"text":"ヨアブは地,ちにひれ伏,ふして拝,はいし、王,おうを祝福,しゅくふくした。そしてヨアブは言,いった、「わが主,しゅ、王,おうよ、王,おうがしもべの願,ねがいを許,ゆるされたので、きょうしもべは、あなたの前,まえに恵,めぐみを得,えたことを知,しりました」。","tok":[["ヨアブ"],["は"],["地","ち"],["に"],["ひれ伏して","ひれふして"],["拝し","はいし"],["、"],["王","おう"],["を"],["祝福","しゅくふく"],["した"],["。"],["そして"],["ヨアブ"],["は"],["言った","いった"],["、"],["「"],["わが"],["主","しゅ"],["、"],["王","おう"],["よ"],["、"],["王","おう"],["が"],["しもべ"],["の"],["願い","ねがい"],["を"],["許された","ゆるされた"],["ので"],["、"],["きょう"],["しもべ"],["は"],["、"],["あなた"],["の"],["前","まえ"],["に"],["恵","めぐみ"],["を"],["得た","えた"],["こと"],["を"],["知りました","しりました"],["」"],["。"]]},{"verse":23,"text":"そこでヨアブは立,たってゲシュルに行,いき、アブサロムをエルサレムに連,つれてきた。","tok":[["そこ"],["で"],["ヨアブ"],["は"],["立って","たって"],["ゲシュル"],["に"],["行き","いき"],["、"],["アブサロム"],["を"],["エルサレム"],["に"],["連れて","つれて"],["きた"],["。"]]},{"verse":24,"text":"王,おうは言,いった、「彼,かれを自分,じぶんの家,いえに引,ひきこもらせるがよい。わたしの顔,かおを見,みてはならない」。こうしてアブサロムは自分,じぶんの家,いえに引,ひきこもり、王,おうの顔,かおを見,みなかった。","tok":[["王","おう"],["は"],["言った","いった"],["、"],["「"],["彼","かれ"],["を"],["自分","じぶん"],["の"],["家","いえ"],["に"],["引","ひき"],["こもらせる"],["が"],["よい"],["。"],["わたし"],["の"],["顔","かお"],["を"],["見て","みて"],["は"],["ならない"],["」"],["。"],["こう"],["して"],["アブサロム"],["は"],["自分","じぶん"],["の"],["家","いえ"],["に"],["引","ひき"],["こもり"],["、"],["王","おう"],["の"],["顔","かお"],["を"],["見なかった","みなかった"],["。"]]},{"verse":25,"text":"さて全,ぜんイスラエルのうちにアブサロムのように、美,うつくしさのためほめられた人,ひとはなかった。その足,あしの裏,うらから頭,あたまの頂,いただきまで彼,かれには傷,きずがなかった。","tok":[["さて"],["全","ぜん"],["イスラエル"],["の"],["うち"],["に"],["アブサロム"],["の"],["よう"],["に"],["、"],["美し","うつくし"],["さ"],["の"],["ため"],["ほめられた"],["人","ひと"],["は"],["なかった"],["。"],["その"],["足","あし"],["の"],["裏","うら"],["から"],["頭","あたま"],["の"],["頂","いただき"],["まで"],["彼","かれ"],["に"],["は"],["傷","きず"],["が"],["なかった"],["。"]]},{"verse":26,"text":"アブサロムがその頭,あたまを刈,かる時,とき、その髪,かみの毛,けをはかったが、王,おうのはかりで二百シケルあった。毎年,まいねんの終,おわりにそれを刈,かるのを常,つねとした。それが重,おもくなると、彼,かれはそれを刈,かったのである。","tok":[["アブサロム"],["が"],["その"],["頭","あたま"],["を"],["刈る","かる"],["時","とき"],["、"],["その"],["髪の毛","かみのけ"],["を"],["はかった"],["が"],["、"],["王","おう"],["の"],["はかり"],["で"],["二百","にひゃく"],["シケル"],["あった"],["。"],["毎年","まいねん"],["の"],["終わり","おわり"],["に"],["それ"],["を"],["刈る","かる"],["の"],["を"],["常","つね"],["と"],["した"],["。"],["それ"],["が"],["重く","おもく"],["なる"],["と"],["、"],["彼","かれ"],["は"],["それ"],["を"],["刈った","かった"],["ので"],["ある"],["。"]]},{"verse":27,"text":"アブサロムに三人,にんのむすこと、タマルという名,なのひとりの娘,むすめが生,うまれた。タマルは美,うつくしい女,おんなであった。","tok":[["アブサロム"],["に"],["三人","にん"],["の"],["むすこ"],["と"],["、"],["タマル"],["と"],["いう"],["名","な"],["の"],["ひとり"],["の"],["娘","むすめ"],["が"],["生まれた","うまれた"],["。"],["タマル"],["は"],["美しい","うつくしい"],["女","おんな"],["で"],["あった"],["。"]]},{"verse":28,"text":"こうしてアブサロムは満,まん二年,ねんの間,あいだエルサレムに住,すんだが、王,おうの顔,かおを見,みなかった。","tok":[["こう"],["して"],["アブサロム"],["は"],["満","まん"],["二","に"],["年","ねん"],["の"],["間","あいだ"],["エルサレム"],["に"],["住んだ","すんだ"],["が"],["、"],["王","おう"],["の"],["顔","かお"],["を"],["見なかった","みなかった"],["。"]]},{"verse":29,"text":"そこでアブサロムはヨアブを王,おうのもとにつかわそうとして、ヨアブの所,ところに人,ひとをつかわしたが、ヨアブは彼,かれの所,ところにこようとはしなかった。彼,かれは再,ふたたび人,ひとをつかわしたがヨアブはこようとはしなかった。","tok":[["そこ"],["で"],["アブサロム"],["は"],["ヨアブ"],["を"],["王","おう"],["の"],["もと"],["に"],["つかわそう"],["として"],["、"],["ヨアブ"],["の"],["所","ところ"],["に"],["人","ひと"],["を"],["つかわした"],["が"],["、"],["ヨアブ"],["は"],["彼","かれ"],["の"],["所","ところ"],["に"],["こよう"],["と"],["は"],["しなかった"],["。"],["彼","かれ"],["は"],["再び","ふたたび"],["人","ひと"],["を"],["つかわした"],["が"],["ヨアブ"],["は"],["こよう"],["と"],["は"],["しなかった"],["。"]]},{"verse":30,"text":"そこでアブサロムはその家来,けらいに言,いった、「ヨアブの畑,はたけはわたしの畑,はたけの隣,となりにあって、そこに大麦,おおむぎがある。行,いってそれに火,ひを放,はなちなさい」。アブサロムの家来,けらいたちはその畑,はたけに火,ひを放,はなった。","tok":[["そこ"],["で"],["アブサロム"],["は"],["その"],["家来","けらい"],["に"],["言った","いった"],["、"],["「"],["ヨアブ"],["の"],["畑","はたけ"],["は"],["わたし"],["の"],["畑","はたけ"],["の"],["隣","となり"],["に"],["あって"],["、"],["そこ"],["に"],["大麦","おおむぎ"],["が"],["ある"],["。"],["行って","いって"],["それ"],["に"],["火","ひ"],["を"],["放ち","はなち"],["なさい"],["」"],["。"],["アブサロム"],["の"],["家来","けらい"],["たち"],["は"],["その"],["畑","はたけ"],["に"],["火","ひ"],["を"],["放った","はなった"],["。"]]},{"verse":31,"text":"ヨアブは立,たってアブサロムの家,いえにきて彼,かれに言,いった、「どうしてあなたの家来,けらいたちはわたしの畑,はたけに火,ひを放,はなったのですか」。","tok":[["ヨアブ"],["は"],["立って","たって"],["アブサロム"],["の"],["家","いえ"],["に"],["きて"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["どう"],["して"],["あなた"],["の"],["家来","けらい"],["たち"],["は"],["わたし"],["の"],["畑","はたけ"],["に"],["火","ひ"],["を"],["放った","はなった"],["の"],["です"],["か"],["」"],["。"]]},{"verse":32,"text":"アブサロムはヨアブに言,いった、「わたしはあなたに人,ひとをつかわして、ここへ来,くるようにと言,いったのです。あなたを王,おうのもとにつかわし、『なんのためにわたしはゲシュルからきたのですか。なおあそこにいたならば良,よかったでしょうに』と言,いわせようとしたのです。それゆえ今,いまわたしに王,おうの顔,かおを見,みさせてください。もしわたしに罪,つみがあるなら王,おうにわたしを殺,ころさせてください」。","tok":[["アブサロム"],["は"],["ヨアブ"],["に"],["言った","いった"],["、"],["「"],["わたし"],["は"],["あなた"],["に"],["人","ひと"],["を"],["つかわして"],["、"],["ここ"],["へ"],["来る","くる"],["よう"],["に"],["と"],["言った","いった"],["の"],["です"],["。"],["あなた"],["を"],["王","おう"],["の"],["もと"],["に"],["つかわし"],["、"],["『"],["なん"],["の"],["ため"],["に"],["わたし"],["は"],["ゲシュル"],["から"],["きた"],["の"],["です"],["か"],["。"],["なお"],["あそこ"],["に"],["いたならば"],["良かったでしょう","よかったでしょう"],["に"],["』"],["と"],["言わせよう","いわせよう"],["と"],["した"],["の"],["です"],["。"],["それ"],["ゆえ"],["今","いま"],["わたし"],["に"],["王","おう"],["の"],["顔","かお"],["を"],["見させて","みさせて"],["ください"],["。"],["もし"],["わたし"],["に"],["罪","つみ"],["が"],["あるなら"],["王","おう"],["に"],["わたし"],["を"],["殺させて","ころさせて"],["ください"],["」"],["。"]]},{"verse":33,"text":"そこでヨアブは王,おうのもとへ行,いって告,つげたので、王,おうはアブサロムを召,めしよせた。彼,かれは王,おうのもとにきて、王,おうの前,まえに地,ちにひれ伏,ふして拝,はいした。王,おうはアブサロムに口,くちづけした。","tok":[["そこ"],["で"],["ヨアブ"],["は"],["王","おう"],["の"],["もと"],["へ"],["行って","いって"],["告","つげ"],["た"],["ので"],["、"],["王","おう"],["は"],["アブサロム"],["を"],["召","めし"],["よせた"],["。"],["彼","かれ"],["は"],["王","おう"],["の"],["もと"],["に"],["きて"],["、"],["王","おう"],["の"],["前","まえ"],["に"],["地","ち"],["に"],["ひれ伏して","ひれふして"],["拝した","はいした"],["。"],["王","おう"],["は"],["アブサロム"],["に"],["口づけ","くちづけ"],["した"],["。"]]}]
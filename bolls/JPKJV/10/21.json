[{"verse":1,"text":"ダビデの世,よに、年,としまた年,としと三年,ねん、ききんがあったので、ダビデが主,しゅに尋,たずねたところ、主,しゅは言,いわれた、「サウルとその家,いえとに、血,ちを流,ながした罪,つみがある。それはかつて彼,かれがギベオンびとを殺,ころしたためである」。","tok":[["ダビデ"],["の"],["世","よ"],["に"],["、"],["年","と"],["し"],["また"],["年","とし"],["と"],["三","さん"],["年","ねん"],["、"],["ききん"],["が"],["あった"],["ので"],["、"],["ダビデ"],["が"],["主に","しゅに"],["尋ねた","たずねた"],["ところ"],["、"],["主","しゅ"],["は"],["言われた","いわれた"],["、"],["「"],["サウル"],["と"],["その"],["家","いえ"],["と"],["に"],["、"],["血","ち"],["を"],["流した","ながした"],["罪","つみ"],["が"],["ある"],["。"],["それ"],["は"],["かつて"],["彼","かれ"],["が"],["ギベオン"],["びと"],["を"],["殺ろした","ころした"],["ため"],["で"],["ある"],["」"],["。"]]},{"verse":2,"text":"そこで王,おうはギベオンびとを召,めしよせた。ギベオンびとはイスラエルの子孫,しそんではなく、アモリびとの残,のこりであって、イスラエルの人々,ひとびとは彼,かれらと誓,ちかいを立,たてて、その命,いのちを助,たすけた。ところがサウルはイスラエルとユダの人々,ひとびとのために熱心,ねっしんであったので、彼,かれらを殺,ころそうとしたのである。","tok":[["そこ"],["で"],["王","おう"],["は"],["ギベオン"],["びと"],["を"],["召","めし"],["よせた"],["。"],["ギベオン"],["びと"],["は"],["イスラエル"],["の"],["子孫","しそん"],["で"],["は"],["なく"],["、"],["アモリ"],["びと"],["の"],["残り","のこり"],["で"],["あって"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["彼","かれ"],["ら"],["と"],["誓い","ちかい"],["を"],["立てて","たてて"],["、"],["その"],["命","いのち"],["を"],["助けた","たすけた"],["。"],["ところ"],["が"],["サウル"],["は"],["イスラエル"],["と"],["ユダ"],["の"],["人々","ひとびと"],["の"],["ため"],["に"],["熱心","ねっしん"],["で"],["あった"],["ので"],["、"],["彼","かれ"],["ら"],["を"],["殺そう","ころそう"],["と"],["した"],["ので"],["ある"],["。"]]},{"verse":3,"text":"それでダビデはギベオンびとに言,いった、「わたしはあなたがたのために、何,なにをすればよいのですか。どんな償,つぐないをすれば、あなたがたは主,しゅの嗣,し業,ぎょうを祝福,しゅくふくするのですか」。","tok":[["それ"],["で"],["ダビデ"],["は"],["ギベオン"],["びと"],["に"],["言った","いった"],["、"],["「"],["わたし"],["は"],["あなた"],["がた"],["の"],["ため"],["に"],["、"],["何に","なに"],["を"],["すれば"],["よい"],["の"],["です"],["か"],["。"],["どんな"],["償ない","つぐない"],["を"],["すれば"],["、"],["あなた"],["がた"],["は"],["主","しゅ"],["の"],["嗣業","しぎょう"],["を"],["祝福","しゅくふく"],["する"],["の"],["です"],["か"],["」"],["。"]]},{"verse":4,"text":"ギベオンびとは彼,かれに言,いった、「これはわれわれと、サウルまたはその家,いえとの間,あいだの金銀,きんぎんの問題,もんだいではありません。またイスラエルのうちのひとりでも、われわれが殺,ころそうというのでもありません」。ダビデは言,いった、「わたしがあなたがたのために何,なにをすればよいと言,いうのですか」。","tok":[["ギベオン"],["びと"],["は"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["これ"],["は"],["われわれ"],["と"],["、"],["サウル"],["また"],["は"],["その"],["家","いえ"],["と"],["の"],["間","あいだ"],["の"],["金銀","きんぎん"],["の"],["問題","もんだい"],["で"],["は"],["ありません"],["。"],["また"],["イスラエル"],["の"],["うち"],["の"],["ひとり"],["で"],["も"],["、"],["われわれ"],["が"],["殺そう","ころそう"],["と"],["いう"],["ので"],["も"],["ありません"],["」"],["。"],["ダビデ"],["は"],["言った","いった"],["、"],["「"],["わたし"],["が"],["あなた"],["がた"],["の"],["ため"],["に"],["何に","なに"],["を"],["すれば"],["よい"],["と"],["言う","いう"],["の"],["です"],["か"],["」"],["。"]]},{"verse":5,"text":"かれらは王,おうに言,いった、「われわれを滅,ほろぼした人,ひと、われわれを滅,ほろぼしてイスラエルの領域,りょういきのどこにもおらせないようにと、たくらんだ人,ひと、","tok":[["かれ"],["ら"],["は"],["王","おう"],["に"],["言った","いった"],["、"],["「"],["われわれ"],["を"],["滅ぼした","ほろぼした"],["人","ひと"],["、"],["われわれ"],["を"],["滅ぼして","ほろぼして"],["イスラエル"],["の"],["領域","りょういき"],["の"],["どこ"],["に"],["も"],["おらせない"],["よう"],["に"],["と"],["、"],["たくらんだ"],["人","ひと"],["、"]]},{"verse":6,"text":"その人,ひとの子孫,しそん七人,にんを引,ひき渡,わたしてください。われわれは主,しゅの山,やまにあるギベオンで、彼,かれらを主,しゅの前,まえに木,きにかけましょう」。王,おうは言,いった、「引,ひき渡,わたしましょう」。","tok":[["その"],["人","ひと"],["の"],["子孫","しそん"],["七人","にん"],["を"],["引渡","ひきわたし"],["て"],["ください"],["。"],["われわれ"],["は"],["主","しゅ"],["の"],["山","やま"],["に"],["ある"],["ギベオン"],["で"],["、"],["彼","かれ"],["ら"],["を"],["主","しゅ"],["の"],["前","まえ"],["に"],["木","き"],["に"],["かけましょう"],["」"],["。"],["王","おう"],["は"],["言った","いった"],["、"],["「"],["引渡","ひきわたし"],["ましょう"],["」"],["。"]]},{"verse":7,"text":"しかし王,おうはサウルの子,こヨナタンの子,こであるメピボセテを惜,おしんだ。彼,かれらの間,あいだ、すなわちダビデとサウルの子,こヨナタンとの間,あいだに、主,しゅをさして立,たてた誓,ちかいがあったからである。","tok":[["しかし"],["王","おう"],["は"],["サウル"],["の"],["子","こ"],["ヨナタン"],["の"],["子","こ"],["で"],["ある"],["メピボセテ"],["を"],["惜しんだ","おしんだ"],["。"],["彼","かれ"],["ら"],["の"],["間","あいだ"],["、"],["すなわち"],["ダビデ"],["と"],["サウル"],["の"],["子","こ"],["ヨナタン"],["と"],["の"],["間","あいだ"],["に"],["、"],["主","しゅ"],["を"],["さして"],["立てた","たてた"],["誓い","ちかい"],["が"],["あった"],["から"],["で"],["ある"],["。"]]},{"verse":8,"text":"王,おうはアヤの娘,むすめリヅパがサウルに産,うんだふたりの子,こアルモニとメピボセテ、およびサウルの娘,むすめメラブがメホラびとバルジライの子,こアデリエルに産,うんだ五人,にんの子,こを取,とって、","tok":[["王","おう"],["は"],["アヤ"],["の"],["娘","むすめ"],["リヅパ"],["が"],["サウル"],["に"],["産んだ","うんだ"],["ふたり"],["の"],["子","こ"],["アルモニ"],["と"],["メピボセテ"],["、"],["および"],["サウル"],["の"],["娘","むすめ"],["メラブ"],["が"],["メホラ"],["びと"],["バルジライ"],["の"],["子","こ"],["アデリエル"],["に"],["産んだ","うんだ"],["五人","にん"],["の"],["子","こ"],["を"],["取って","とって"],["、"]]},{"verse":9,"text":"彼,かれらをギベオンびとの手,てに引,ひき渡,わたしたので、ギベオンびとは彼,かれらを山,やまで主,しゅの前,まえに木,きにかけた。彼,かれら七人,にんは共,ともに倒,たおれた。彼,かれらは刈入,かりいれの初,はじめの日,ひ、すなわち大麦,おおむぎ刈,かりの初,はじめに殺,ころされた。","tok":[["彼","かれ"],["ら"],["を"],["ギベオン"],["びと"],["の"],["手","て"],["に"],["引渡","ひきわたし"],["た"],["ので"],["、"],["ギベオン"],["びと"],["は"],["彼","かれ"],["ら"],["を"],["山","やま"],["で"],["主","しゅ"],["の"],["前","まえ"],["に"],["木","き"],["に"],["かけた"],["。"],["彼","かれ"],["ら"],["七人","にん"],["は"],["共","とも"],["に"],["倒れた","たおれた"],["。"],["彼","かれ"],["ら"],["は"],["刈入れ","かりいれ"],["の"],["初め","はじめ"],["の"],["日","ひ"],["、"],["すなわち"],["大","だい"],["麦刈","麦かり"],["の"],["初め","はじめ"],["に"],["殺ろされた","ころされた"],["。"]]},{"verse":10,"text":"アヤの娘,むすめリヅパは荒布,あらぬのをとって、それを自分,じぶんのために岩,いわの上,うえに敷,しき、刈入,かりいれの初,はじめから、その人々,ひとびとの死体,したいの上,うえに天,てんから雨,あめが降,ふるまで、昼,ひるは空,そらの鳥,とりが死体,したいの上,うえにこないようにし、夜,よるは野,のの獣,けものを近寄,ちかよらせなかった。","tok":[["アヤ"],["の"],["娘","むすめ"],["リヅパ"],["は"],["荒布","あらぬ"],["の"],["を"],["とって"],["、"],["それ"],["を"],["自分","じぶん"],["の"],["ため"],["に"],["岩","いわ"],["の"],["上","うえ"],["に"],["敷","しき"],["、"],["刈入れ","かりいれ"],["の"],["初め","はじめ"],["から"],["、"],["その"],["人々","ひとびと"],["の"],["死体","したい"],["の"],["上","うえ"],["に"],["天","てん"],["から"],["雨","あめ"],["が"],["降る","ふる"],["まで"],["、"],["昼","ひる"],["は"],["空","そら"],["の"],["鳥","とり"],["が"],["死体","したい"],["の"],["上","うえ"],["に"],["こない"],["よう"],["に"],["し"],["、"],["夜","よる"],["は"],["野","の"],["の"],["獣","けもの"],["を"],["近寄らせなかった","ちかよらせなかった"],["。"]]},{"verse":11,"text":"アヤの娘,むすめでサウルのめかけであったリヅパのしたことがダビデに聞,きこえたので、","tok":[["アヤ"],["の"],["娘","むすめ"],["で"],["サウル"],["の"],["めかけ"],["で"],["あった"],["リヅパ"],["の"],["した"],["こと"],["が"],["ダビデ"],["に"],["聞こえた","きこえた"],["ので"],["、"]]},{"verse":12,"text":"ダビデは行,いってサウルの骨,ほねとその子,こヨナタンの骨,ほねを、ヤベシギレアデの人々,ひとびとの所,ところから取,とってきた。これはペリシテびとがサウルをギルボアで殺,ころした日,ひに、木,きにかけたベテシャンの広場,ひろばから、彼,かれらが盗,ぬすんでいたものである。","tok":[["ダビデ"],["は"],["行って","いって"],["サウル"],["の"],["骨","ほね"],["と"],["その"],["子","こ"],["ヨナタン"],["の"],["骨","ほね"],["を"],["、"],["ヤベシギレアデ"],["の"],["人々","ひとびと"],["の"],["所","ところ"],["から"],["取って","とって"],["きた"],["。"],["これ"],["は"],["ペリシテ"],["びと"],["が"],["サウル"],["を"],["ギルボア"],["で"],["殺ろした","ころした"],["日","ひ"],["に"],["、"],["木","き"],["に"],["かけた"],["ベテシャン"],["の"],["広場","ひろば"],["から"],["、"],["彼","かれ"],["ら"],["が"],["盗んで","ぬすんで"],["いた"],["もの"],["で"],["ある"],["。"]]},{"verse":13,"text":"ダビデはそこからサウルの骨,ほねと、その子,こヨナタンの骨,ほねを携,たずさえて上,のぼった。また人々,ひとびとはそのかけられた者,ものどもの骨,ほねを集,あつめた。","tok":[["ダビデ"],["は"],["そこ"],["から"],["サウル"],["の"],["骨","ほね"],["と"],["、"],["その"],["子","こ"],["ヨナタン"],["の"],["骨","ほね"],["を"],["携えて","たずさえて"],["上った","のぼった"],["。"],["また"],["人々","ひとびと"],["は"],["その"],["かけられた"],["者","もの"],["ども"],["の"],["骨","ほね"],["を"],["集めた","あつめた"],["。"]]},{"verse":14,"text":"こうして彼,かれらはサウルとその子,こヨナタンの骨,ほねを、ベニヤミンの地,ちのゼラにあるその父,ちちキシの墓,はかに葬,ほうむり、すべて王,おうの命,めいじたようにした。この後,のち、神,かみはその地,ちのために、祈,いのりを聞,きかれた。","tok":[["こう"],["して"],["彼","かれ"],["ら"],["は"],["サウル"],["と"],["その"],["子","こ"],["ヨナタン"],["の"],["骨","ほね"],["を"],["、"],["ベニヤミン"],["の"],["地","ち"],["の"],["ゼラ"],["に"],["ある"],["その"],["父","ちち"],["キシ"],["の"],["墓","はか"],["に"],["葬むり","ほうむり"],["、"],["すべて"],["王","おう"],["の"],["命じた","めいじた"],["よう"],["に"],["した"],["。"],["この"],["後","の"],["ち"],["、"],["神","かみ"],["は"],["その"],["地","ち"],["の"],["ため"],["に"],["、"],["祈","いのり"],["を"],["聞かれた","きかれた"],["。"]]},{"verse":15,"text":"ペリシテびとはまたイスラエルと戦争,せんそうをした。ダビデはその家来,けらいたちと共,ともに下,くだってペリシテびとと戦,たたかったが、ダビデは疲,つかれていた。","tok":[["ペリシテ"],["び"],["と"],["は"],["また"],["イスラエル"],["と"],["戦争","せんそう"],["を"],["した"],["。"],["ダビデ"],["は"],["その"],["家来","けらい"],["たち"],["と"],["共","とも"],["に"],["下って","くだって"],["ペリシテ"],["びと"],["と"],["戦った","たたかった"],["が"],["、"],["ダビデ"],["は"],["疲れて","つかれて"],["いた"],["。"]]},{"verse":16,"text":"時,ときにイシビベノブはダビデを殺,ころそうと思,おもった。イシビベノブは巨人,きょじんの子孫,しそんで、そのやりは青銅,せいどうで重,おもさ三百シケルあり、彼,かれは新,あたらしいつるぎを帯,おびていた。","tok":[["時","とき"],["に"],["イシビベノブ"],["は"],["ダビデ"],["を"],["殺そう","ころそう"],["と"],["思った","おもった"],["。"],["イシビベノブ"],["は"],["巨人","きょじん"],["の"],["子孫","しそん"],["で"],["、"],["その"],["やり"],["は"],["青銅","せいどう"],["で"],["重さ","おもさ"],["三百","さんひゃく"],["シケル"],["あり"],["、"],["彼","かれ"],["は"],["新らしい","あたらしい"],["つるぎ"],["を"],["帯","おび"],["て"],["いた"],["。"]]},{"verse":17,"text":"しかしゼルヤの子,こアビシャイはダビデを助,たすけて、そのペリシテびとを撃,うち殺,ころした。そこでダビデの従者,じゅうしゃたちは彼,かれに誓,ちかって言,いった、「あなたはわれわれと共,ともに、重,かさねて戦争,せんそうに出,でてはなりません。さもないと、あなたはイスラエルのともし火,ひを消,けすでしょう」。","tok":[["しかし"],["ゼルヤ"],["の"],["子","こ"],["アビシャイ"],["は"],["ダビデ"],["を"],["助けて","たすけて"],["、"],["その"],["ペリシテ"],["びと"],["を"],["撃ち殺した","うちころした"],["。"],["そこ"],["で"],["ダビデ"],["の"],["従者","じゅうしゃ"],["たち"],["は"],["彼","かれ"],["に"],["誓って","ちかって"],["言った","いった"],["、"],["「"],["あなた"],["は"],["われわれ"],["と"],["共","とも"],["に"],["、"],["重ねて","かさねて"],["戦争","せんそう"],["に"],["出て","でて"],["は"],["なりません"],["。"],["さも"],["ない"],["と"],["、"],["あなた"],["は"],["イスラエル"],["の"],["ともし火","ともしひ"],["を"],["消すでしょう","けすでしょう"],["」"],["。"]]},{"verse":18,"text":"この後,のち、再,ふたたびゴブでペリシテびととの戦,たたかいがあった。時,ときにホシャびとシベカイは巨人,きょじんの子孫,しそんのひとりサフを殺,ころした。","tok":[["この"],["後","の"],["ち"],["、"],["再び","ふたたび"],["ゴブ"],["で"],["ペリシテ"],["びと"],["と"],["の"],["戦い","たたかい"],["が"],["あった"],["。"],["時","とき"],["に"],["ホシャ"],["びと"],["シベカイ"],["は"],["巨人","きょじん"],["の"],["子孫","しそん"],["の"],["ひとり"],["サフ"],["を"],["殺ろした","ころした"],["。"]]},{"verse":19,"text":"ここにまたゴブで、ペリシテびととの戦,たたかいがあったが、そこではベツレヘムびとヤレオレギムの子,こエルハナンは、ガテびとゴリアテを殺,ころした。そのやりの柄,えは機,はたの巻棒,まきぼうのようであった。","tok":[["ここ"],["に"],["また"],["ゴブ"],["で"],["、"],["ペリシテ"],["びと"],["と"],["の"],["戦い","たたかい"],["が"],["あった"],["が"],["、"],["そこ"],["で"],["は"],["ベツレヘム"],["びと"],["ヤレオレギム"],["の"],["子","こ"],["エルハナン"],["は"],["、"],["ガテ"],["びと"],["ゴリアテ"],["を"],["殺ろした","ころした"],["。"],["その"],["やり"],["の"],["柄","え"],["は"],["機","はた"],["の"],["巻","まき"],["棒","ぼう"],["の"],["よう"],["で"],["あった"],["。"]]},{"verse":20,"text":"またガテで再,ふたたび戦,たたかいがあったが、そこにひとりの背,せの高,たかい人,ひとがあり、その手,ての指,ゆびと足,あしの指,ゆびは六本,ぽんずつで、その数,かずは合,あわせて二十四本,ほんであった。彼,かれもまた巨人,きょじんから生,うまれた者,ものであった。","tok":[["また"],["ガテ"],["で"],["再び","ふたたび"],["戦い","たたかい"],["が"],["あった"],["が"],["、"],["そこ"],["に"],["ひとり"],["の"],["背","せ"],["の"],["高い","たかい"],["人","ひと"],["が"],["あり"],["、"],["その"],["手","て"],["の"],["指","ゆび"],["と"],["足","あし"],["の"],["指","ゆび"],["は"],["六本","ぽん"],["ずつ"],["で"],["、"],["その"],["数","かず"],["は"],["合","あわせ"],["て"],["二十四本","ほん"],["で"],["あった"],["。"],["彼","かれ"],["も"],["また"],["巨人","きょじん"],["から"],["生まれた","うまれた"],["者","もの"],["で"],["あった"],["。"]]},{"verse":21,"text":"彼,かれはイスラエルをののしったので、ダビデの兄弟,きょうだいシメアの子,こヨナタンが彼,かれを殺,ころした。","tok":[["彼","かれ"],["は"],["イスラエル"],["を"],["ののしった"],["ので"],["、"],["ダビデ"],["の"],["兄弟","きょうだい"],["シメア"],["の"],["子","こ"],["ヨナタン"],["が"],["彼","かれ"],["を"],["殺ろした","ころした"],["。"]]},{"verse":22,"text":"これらの四人,にんはガテで巨人,きょじんから生,うまれた者,ものであったが、ダビデの手,てとその家来,けらいたちの手,てに倒,たおれた。","tok":[["これ"],["ら"],["の"],["四人","にん"],["は"],["ガテ"],["で"],["巨人","きょじん"],["から"],["生まれた","うまれた"],["者","もの"],["で"],["あった"],["が"],["、"],["ダビデ"],["の"],["手","て"],["と"],["その"],["家来","けらい"],["たち"],["の"],["手","て"],["に"],["倒れた","たおれた"],["。"]]}]
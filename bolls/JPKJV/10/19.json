[{"verse":1,"text":"[18:33]王,おうはひじょうに悲,かなしみ、門,もんの上,うえのへやに上,のぼって泣,ないた。彼,かれは行,いきながらこのように言,いった、「わが子,こアブサロムよ。わが子,こ、わが子,こアブサロムよ。ああ、わたしが代,かわって死,しねばよかったのに。アブサロム、わが子,こよ、わが子,こよ」。","tok":[["["],["18"],[":"],["33"],["]"],["王","おう"],["は"],["ひじょう"],["に"],["悲しみ","かなしみ"],["、"],["門","もん"],["の"],["上","うえ"],["の"],["へや"],["に"],["上って","のぼって"],["泣いた","ないた"],["。"],["彼","かれ"],["は"],["行き","いき"],["ながら"],["この"],["よう"],["に"],["言った","いった"],["、"],["「"],["わが"],["子","こ"],["アブサロム"],["よ"],["。"],["わが"],["子","こ"],["、"],["わが"],["子","こ"],["アブサロム"],["よ"],["。"],["ああ"],["、"],["わたし"],["が"],["代わって","かわって"],["死ねば","しねば"],["よかった"],["のに"],["。"],["アブサロム"],["、"],["わが"],["子","こ"],["よ"],["、"],["わが"],["子","こ"],["よ"],["」"],["。"]]},{"verse":2,"text":"[1]時,ときにヨアブに告,つげる者,ものがあって、「見,みよ、王,おうはアブサロムのために泣,なき悲,かなしんでいる」と言,いった。","tok":[["["],["1"],["]"],["時","とき"],["に"],["ヨアブ"],["に"],["告げる","つげる"],["者","もの"],["が"],["あって"],["、"],["「"],["見よ","みよ"],["、"],["王","おう"],["は"],["アブサロム"],["の"],["ため"],["に"],["泣","なき"],["悲しんで","かなしんで"],["いる"],["」"],["と"],["言った","いった"],["。"]]},{"verse":3,"text":"[2]こうしてその日,ひの勝利,しょうりはすべての民,たみの悲,かなしみとなった。それはその日,ひ、民,たみが、「王,おうはその子,このために悲,かなしんでいる」と人,ひとの言,いうのを聞,きいたからである。","tok":[["["],["2"],["]"],["こう"],["して"],["その"],["日","ひ"],["の"],["勝利","しょうり"],["は"],["すべて"],["の"],["民","たみ"],["の"],["悲しみ","かなしみ"],["と"],["なった"],["。"],["それ"],["は"],["その"],["日","ひ"],["、"],["民","た"],["み"],["が"],["、"],["「"],["王","おう"],["は"],["その"],["子","こ"],["の"],["ため"],["に"],["悲しんで","かなしんで"],["いる"],["」"],["と"],["人","ひと"],["の"],["言う","いう"],["の"],["を"],["聞いた","きいた"],["から"],["で"],["ある"],["。"]]},{"verse":4,"text":"[3]そして民,たみはその日,ひ、戦,たたかいに逃,にげて恥,はじている民,たみがひそかに、はいるように、ひそかに町,まちにはいった。","tok":[["["],["3"],["]"],["そして"],["民","たみ"],["は"],["その"],["日","ひ"],["、"],["戦い","たたかい"],["に"],["逃て","にげて"],["恥","はじ"],["て"],["いる"],["民","たみ"],["が"],["ひそか"],["に"],["、"],["はいる"],["よう"],["に"],["、"],["ひそか"],["に"],["町","まち"],["に"],["はいった"],["。"]]},{"verse":5,"text":"[4]王,おうは顔,かおをおおった。そして王,おうは大声,おおごえに叫,さけんで、「わが子,こアブサロムよ。アブサロム、わが子,こよ、わが子,こよ」と言,いった。","tok":[["["],["4"],["]"],["王","おう"],["は"],["顔","かお"],["を"],["おおった"],["。"],["そして"],["王","おう"],["は"],["大声","おおごえ"],["に"],["叫けんで","さけんで"],["、"],["「"],["わが"],["子","こ"],["アブサロム"],["よ"],["。"],["アブサロム"],["、"],["わが"],["子","こ"],["よ"],["、"],["わが"],["子","こ"],["よ"],["」"],["と"],["言った","いった"],["。"]]},{"verse":6,"text":"[5]時,ときにヨアブは家,いえにはいり、王,おうのもとにきて言,いった、「あなたは、きょう、あなたの命,いのちと、あなたのむすこ娘,むすめたちの命,いのち、およびあなたの妻,つまたちの命,いのちと、めかけたちの命,いのちを救,すくったすべての家来,けらいの顔,かおをはずかしめられました。","tok":[["["],["5"],["]"],["時","とき"],["に"],["ヨアブ"],["は"],["家","いえ"],["に"],["はいり"],["、"],["王","おう"],["の"],["もと"],["に"],["きて"],["言った","いった"],["、"],["「"],["あなた"],["は"],["、"],["きょう"],["、"],["あなた"],["の"],["命","いのち"],["と"],["、"],["あなた"],["の"],["むすこ"],["娘","むすめ"],["たち"],["の"],["命","いのち"],["、"],["および"],["あなた"],["の"],["妻たち","つまたち"],["の"],["命","いのち"],["と"],["、"],["めかけ"],["たち"],["の"],["命","いのち"],["を"],["救った","すくった"],["すべて"],["の"],["家来","けらい"],["の"],["顔","かお"],["を"],["はずかしめられました"],["。"]]},{"verse":7,"text":"[6]それはあなたが自分,じぶんを憎,にくむ者,ものを愛,あいし、自分,じぶんを愛,あいする者,ものを憎,にくまれるからです。あなたは、きょう、軍,ぐんの長,ちょうたちをも、しもべたちをも顧,かえりみないことを示,しめされました。きょう、わたしは知,しりました。もし、アブサロムが生,いきていて、われわれが皆,みなきょう死,しんでいたら、あなたの目,めにかなったでしょう。","tok":[["["],["6"],["]"],["それ"],["は"],["あなた"],["が"],["自分","じぶん"],["を"],["憎む","にくむ"],["者","もの"],["を"],["愛し","あいし"],["、"],["自分","じぶん"],["を"],["愛する","あいする"],["者","もの"],["を"],["憎まれる","にくまれる"],["から"],["です"],["。"],["あなた"],["は"],["、"],["きょう"],["、"],["軍","ぐん"],["の"],["長","ちょう"],["たち"],["を"],["も"],["、"],["しもべ"],["たち"],["を"],["も"],["顧ない","かえりみない"],["こと"],["を"],["示めされました","しめされました"],["。"],["きょう"],["、"],["わたし"],["は"],["知りました","しりました"],["。"],["もし"],["、"],["アブサロム"],["が"],["生きて","いきて"],["いて"],["、"],["われわれ"],["が"],["皆","みな"],["きょう"],["死んで","しんで"],["いたら"],["、"],["あなた"],["の"],["目","め"],["に"],["かなったでしょう"],["。"]]},{"verse":8,"text":"[7]今,いま立,たって出,でて行,いって、しもべたちにねんごろに語,かたってください。わたしは主,しゅをさして誓,ちかいます。もしあなたが出,でられないならば、今夜,こんやあなたと共,ともにとどまる者,ものはひとりもないでしょう。これはあなたが若,わかい時,ときから今,いままでにこうむられたすべての災,わざわいよりも、あなたにとって悪,わるいでしょう」。","tok":[["["],["7"],["]"],["今","いま"],["立って","たって"],["出て","でて"],["行って","いって"],["、"],["しもべ"],["たち"],["に"],["ねんごろ"],["に"],["語って","かたって"],["ください"],["。"],["わたし"],["は"],["主","しゅ"],["を"],["さして"],["誓います","ちかいます"],["。"],["もし"],["あなた"],["が"],["出られないならば","でられないならば"],["、"],["今夜","こんや"],["あなた"],["と"],["共","とも"],["に"],["とどまる"],["者","もの"],["は"],["ひとり"],["も"],["ないでしょう"],["。"],["これ"],["は"],["あなた"],["が"],["若い","わかい"],["時","とき"],["から"],["今まで","いままで"],["に"],["こうむられた"],["すべて"],["の"],["災","わざわい"],["より"],["も"],["、"],["あなた"],["にとって"],["悪いでしょう","わるいでしょう"],["」"],["。"]]},{"verse":9,"text":"[8]そこで王,おうは立,たって門,もんのうちの座,ざについた。人々,ひとびとはすべての民,たみに、「見,みよ、王,おうは門,もんに座,ざしている」と告,つげたので、民,たみはみな王,おうの前,まえにきた。さてイスラエルはおのおのその天幕,てんまくに逃,にげ帰,かえった。","tok":[["["],["8"],["]"],["そこ"],["で"],["王","おう"],["は"],["立って","たって"],["門","もん"],["の"],["うち"],["の"],["座","ざ"],["に"],["ついた"],["。"],["人々","ひとびと"],["は"],["すべて"],["の"],["民","たみ"],["に"],["、"],["「"],["見よ","みよ"],["、"],["王","おう"],["は"],["門","もん"],["に"],["座して","ざして"],["いる"],["」"],["と"],["告","つげ"],["た"],["ので"],["、"],["民","たみ"],["は"],["みな"],["王","おう"],["の"],["前","まえ"],["に"],["きた"],["。"],["さて"],["イスラエル"],["は"],["おのおの"],["その"],["天幕","てんまく"],["に"],["逃","にげ"],["帰えった","かえった"],["。"]]},{"verse":10,"text":"[9]そしてイスラエルのもろもろの部族,ぶぞくの中,なかで民,たみはみな争,あらそって言,いった、「王,おうはわれわれを敵,てきの手,てから救,すくい出,だし、またわれわれをペリシテびとの手,てから助,たすけ出,だされた。しかし今,いまはアブサロムのために国,くにのそとに逃,にげておられる。","tok":[["["],["9"],["]"],["そして"],["イスラエル"],["の"],["もろもろ"],["の"],["部族","ぶぞく"],["の"],["中","なか"],["で"],["民","たみ"],["は"],["みな"],["争って","あらそって"],["言った","いった"],["、"],["「"],["王","おう"],["は"],["われわれ"],["を"],["敵","てき"],["の"],["手","て"],["から"],["救い出し","すくいだし"],["、"],["また"],["われわれ"],["を"],["ペリシテ"],["びと"],["の"],["手","て"],["から"],["助け出された","たすけだされた"],["。"],["しかし"],["今","いま"],["は"],["アブサロム"],["の"],["ため"],["に"],["国","くに"],["の"],["そと"],["に"],["逃て","にげて"],["おられる"],["。"]]},{"verse":11,"text":"[10]またわれわれが油,あぶらを注,そそいで、われわれの上,うえに立,たてたアブサロムは戦,たたかいで死,しんだ。それであるのに、どうしてあなたがたは王,おうを導,みちびきかえることについて、何,なにをも言,いわないのか」。","tok":[["["],["10"],["]"],["また"],["われわれ"],["が"],["油","あぶら"],["を"],["注いで","そそいで"],["、"],["われわれ"],["の"],["上","うえ"],["に"],["立てた","たてた"],["アブサロム"],["は"],["戦い","たたかい"],["で"],["死んだ","しんだ"],["。"],["それ"],["で"],["ある"],["のに"],["、"],["どう"],["して"],["あなた"],["がた"],["は"],["王","おう"],["を"],["導き","みちびき"],["かえる"],["こと"],["について"],["、"],["何に","なに"],["を"],["も"],["言わない","いわない"],["の"],["か"],["」"],["。"]]},{"verse":12,"text":"[11]ダビデ王,おうは祭司,さいしたちザドクとアビヤタルとに人,ひとをつかわして言,いった、「ユダの長老,ちょうろうたちに言,いいなさい、『全,ぜんイスラエルの言葉,ことばが王,おうに達,たっしたのに、どうしてあなたがたは王,おうをその家,いえに導,みちびきかえる最後,さいごの者,ものとなるのですか。","tok":[["["],["11"],["]"],["ダビデ"],["王","おう"],["は"],["祭司","さいし"],["たち"],["ザドク"],["と"],["アビヤタル"],["と"],["に"],["人","ひと"],["を"],["つかわして"],["言った","いった"],["、"],["「"],["ユダ"],["の"],["長老","ちょうろう"],["たち"],["に"],["言い","いい"],["なさい"],["、"],["『"],["全","ぜん"],["イスラエル"],["の"],["言葉","ことば"],["が"],["王","おう"],["に"],["達した","たっした"],["のに"],["、"],["どう"],["して"],["あなた"],["がた"],["は"],["王","おう"],["を"],["その"],["家","いえ"],["に"],["導き","みちびき"],["かえる"],["最後","さいご"],["の"],["者","もの"],["と"],["なる"],["の"],["です"],["か"],["。"]]},{"verse":13,"text":"[12]あなたがたはわたしの兄弟,きょうだい、わたしの骨肉,こつにくです。それにどうして王,おうを導,みちびきかえる最後,さいごの者,ものとなるのですか』。","tok":[["["],["12"],["]"],["あなた"],["がた"],["は"],["わたし"],["の"],["兄弟","きょうだい"],["、"],["わたし"],["の"],["骨肉","こつにく"],["です"],["。"],["それ"],["に"],["どう"],["して"],["王","おう"],["を"],["導き","みちびき"],["かえる"],["最後","さいご"],["の"],["者","もの"],["と"],["なる"],["の"],["です"],["か"],["』"],["。"]]},{"verse":14,"text":"[13]またアマサに言,いいなさい、『あなたはわたしの骨肉,こつにくではありませんか。これから後,のちあなたをヨアブに代,かえて、わたしの軍,ぐんの長,ちょうとします。もしそうしないときは、神,かみが幾重,いくえにもわたしを罰,ばっしてくださるように』」。","tok":[["["],["13"],["]"],["また"],["アマサ"],["に"],["言い","いい"],["なさい"],["、"],["『"],["あなた"],["は"],["わたし"],["の"],["骨肉","こつにく"],["で"],["は"],["ありません"],["か"],["。"],["これ"],["から"],["後","のちあなた"],["を"],["ヨアブ"],["に"],["代えて","かえて"],["、"],["わたし"],["の"],["軍","ぐん"],["の"],["長","ちょう"],["と"],["します"],["。"],["もし"],["そう"],["しない"],["とき"],["は"],["、"],["神","かみ"],["が"],["幾重","いくえ"],["に"],["も"],["わたし"],["を"],["罰して","ばっして"],["くださる"],["よう"],["に"],["』"],["」"],["。"]]},{"verse":15,"text":"[14]こうしてダビデはユダのすべての人,ひとの心,こころを、ひとりのように自分,じぶんに傾,かたむけさせたので、彼,かれらは王,おうに、「どうぞあなたも、すべての家来,けらいたちも帰,かえってきてください」と言,いいおくった。","tok":[["["],["14"],["]"],["こう"],["して"],["ダビデ"],["は"],["ユダ"],["の"],["すべて"],["の"],["人","ひと"],["の"],["心","こころ"],["を"],["、"],["ひとり"],["の"],["よう"],["に"],["自分","じぶん"],["に"],["傾むけさせた","かたむけさせた"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["王","おう"],["に"],["、"],["「"],["どうぞ"],["あなた"],["も"],["、"],["すべて"],["の"],["家来","けらい"],["たち"],["も"],["帰えって","かえって"],["きて"],["ください"],["」"],["と"],["言い","いい"],["おくった"],["。"]]},{"verse":16,"text":"[15]そこで王,おうは帰,かえってきてヨルダンまで来,くると、ユダの人,ひと人,ひとは王,おうを迎,むかえるためギルガルにきて、王,おうにヨルダンを渡,わたらせた。","tok":[["["],["15"],["]"],["そこ"],["で"],["王","おう"],["は"],["帰えって","かえって"],["きて"],["ヨルダン"],["まで"],["来る","くる"],["と"],["、"],["ユダ"],["の"],["人人","ひとひと"],["は"],["王","おう"],["を"],["迎","むかえ"],["る"],["ため"],["ギルガル"],["に"],["きて"],["、"],["王","おう"],["に"],["ヨルダン"],["を"],["渡らせた","わたらせた"],["。"]]},{"verse":17,"text":"[16]バホリムのベニヤミンびと、ゲラの子,こシメイは、急,いそいでユダの人々,ひとびとと共,ともに下,くだってきて、ダビデ王,おうを迎,むかえた。","tok":[["["],["16"],["]"],["バホリム"],["の"],["ベニヤミン"],["び"],["と"],["、"],["ゲラ"],["の"],["子","こ"],["シメイ"],["は"],["、"],["急いで","いそいで"],["ユダ"],["の"],["人々","ひとびと"],["と"],["共","とも"],["に"],["下って","くだって"],["きて"],["、"],["ダビデ"],["王","おう"],["を"],["迎","むかえ"],["た"],["。"]]},{"verse":18,"text":"[17]一千人,にんのベニヤミンびとが彼,かれと共,ともにいた。またサウルの家,いえのしもべヂバもその十五人,にんのむすこと、二十人,にんのしもべを従,したがえて、王,おうの前,まえにヨルダンに駆,かけ下,くだった。","tok":[["["],["17"],["]"],["一千人","にん"],["の"],["ベニヤミン"],["びと"],["が"],["彼","かれ"],["と"],["共","とも"],["に"],["いた"],["。"],["また"],["サウル"],["の"],["家","いえ"],["の"],["しもべ"],["ヂバ"],["も"],["その"],["十五人","にん"],["の"],["むすこ"],["と"],["、"],["二","に"],["十人","じゅうにん"],["の"],["しもべ"],["を"],["従えて","したがえて"],["、"],["王","おう"],["の"],["前","まえ"],["に"],["ヨルダン"],["に"],["駆け下った","かけくだった"],["。"]]},{"verse":19,"text":"[18]そして王,おうの家族,かぞくを渡,わたし、王,おうの心,こころにかなうことをしようと渡,わたし場,ばを渡,わたった。ゲラの子,こシメイはヨルダンを渡,わたろうとする時,とき、王,おうの前,まえにひれ伏,ふし、","tok":[["["],["18"],["]"],["そして"],["王","おう"],["の"],["家族","かぞく"],["を"],["渡","わたし"],["、"],["王","おう"],["の"],["心","こころ"],["に"],["かなう"],["こと"],["を"],["しよう"],["と"],["渡場","わたしば"],["を"],["渡った","わたった"],["。"],["ゲラ"],["の"],["子","こ"],["シメイ"],["は"],["ヨルダン"],["を"],["渡ろう","わたろう"],["と"],["する"],["時","とき"],["、"],["王","おう"],["の"],["前","まえ"],["に"],["ひれ伏し","ひれふし"],["、"]]},{"verse":20,"text":"[19]王,おうに言,いった、「どうぞわが君,きみが、罪,つみをわたしに帰,きしられないように。またわが君,きみ、王,おうのエルサレムを出,でられた日,ひに、しもべがおこなった悪,わるい事,ことを思,おもい出,だされないように。どうぞ王,おうがそれを心,こころに留,とめられないように。","tok":[["["],["19"],["]"],["王","おう"],["に"],["言った","いった"],["、"],["「"],["どうぞ"],["わが"],["君","きみ"],["が"],["、"],["罪","つみ"],["を"],["わたし"],["に"],["帰しられない","きしられない"],["よう"],["に"],["。"],["また"],["わが"],["君","きみ"],["、"],["王","おう"],["の"],["エルサレム"],["を"],["出られた","でられた"],["日","ひ"],["に"],["、"],["しもべ"],["が"],["おこなった"],["悪い","わるい"],["事","こと"],["を"],["思い出されない","おもいだされない"],["よう"],["に"],["。"],["どうぞ"],["王","おう"],["が"],["それ"],["を"],["心","こころ"],["に"],["留められない","とめられない"],["よう"],["に"],["。"]]},{"verse":21,"text":"[20]しもべは自分,じぶんが罪,つみを犯,おかしたことを知,しっています。それゆえ、見,みよ、わたしはきょう、ヨセフの全家,ぜんかのまっ先,さきに下,くだってきて、わが主,しゅ、王,おうを迎,むかえるのです」。","tok":[["["],["20"],["]"],["しもべ"],["は"],["自分","じぶん"],["が"],["罪","つみ"],["を"],["犯した","おかした"],["こと"],["を"],["知って","しって"],["います"],["。"],["それ"],["ゆえ"],["、"],["見よ","みよ"],["、"],["わたし"],["は"],["きょう"],["、"],["ヨセフ"],["の"],["全","ぜん"],["家","いえ"],["の"],["まっ先","まっさき"],["に"],["下って","くだって"],["きて"],["、"],["わが"],["主","しゅ"],["、"],["王","おう"],["を"],["迎","むかえ"],["る"],["の"],["です"],["」"],["。"]]},{"verse":22,"text":"[21]ゼルヤの子,こアビシャイは答,こたえて言,いった、「シメイは主,しゅが油,あぶらを注,そそがれた者,ものをのろったので、そのために殺,ころされるべきではありませんか」。","tok":[["["],["21"],["]"],["ゼルヤ"],["の"],["子","こ"],["アビシャイ"],["は"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["シメイ"],["は"],["主","しゅ"],["が"],["油","あぶら"],["を"],["注がれた","そそがれた"],["者","もの"],["を"],["のろった"],["ので"],["、"],["その"],["ため"],["に"],["殺ろされるべきで","ころされるべきで"],["は"],["ありません"],["か"],["」"],["。"]]},{"verse":23,"text":"[22]ダビデは言,いった、「あなたがたゼルヤの子,こたちよ、あなたがたとなにのかかわりがあって、あなたがたはきょうわたしに敵対,てきたいするのか。きょう、イスラエルのうちで人,ひとを殺,ころして良,よかろうか。わたしが、きょうイスラエルの王,おうとなったことを、どうして自分,じぶんで知,しらないことがあろうか」。","tok":[["["],["22"],["]"],["ダビデ"],["は"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["ゼルヤ"],["の"],["子","こ"],["たち"],["よ"],["、"],["あなた"],["がた"],["と"],["なに"],["の"],["かかわり"],["が"],["あって"],["、"],["あなた"],["がた"],["は"],["きょう"],["わたし"],["に"],["敵対","てきたい"],["する"],["の"],["か"],["。"],["きょう"],["、"],["イスラエル"],["の"],["うち"],["で"],["人","ひと"],["を"],["殺ろして","ころして"],["良かろう","よかろう"],["か"],["。"],["わたし"],["が"],["、"],["きょう"],["イスラエル"],["の"],["王","おう"],["と"],["なった"],["こと"],["を"],["、"],["どう"],["して"],["自分","じぶん"],["で"],["知らない","しらない"],["こと"],["が"],["あろう"],["か"],["」"],["。"]]},{"verse":24,"text":"[23]こうして王,おうはシメイに、「あなたを殺,ころさない」と言,いって、王,おうは彼,かれに誓,ちかった。","tok":[["["],["23"],["]"],["こう"],["して"],["王","おう"],["は"],["シメイ"],["に"],["、"],["「"],["あなた"],["を"],["殺ろさない","ころさない"],["」"],["と"],["言って","いって"],["、"],["王","おう"],["は"],["彼","かれ"],["に"],["誓った","ちかった"],["。"]]},{"verse":25,"text":"[24]サウルの子,こメピボセテは下,くだってきて王,おうを迎,むかえた。彼,かれは王,おうが去,さった日,ひから安,やすらかに帰,かえる日,ひまで、その足,あしを飾,かざらず、そのひげを整,ととのえず、またその着物,きものを洗,あらわなかった。","tok":[["["],["24"],["]"],["サウル"],["の"],["子","こ"],["メピボセテ"],["は"],["下って","くだって"],["きて"],["王","おう"],["を"],["迎","むかえ"],["た"],["。"],["彼","かれ"],["は"],["王","おう"],["が"],["去た","さった"],["日","ひ"],["から"],["安らか","やすらか"],["に"],["帰える","かえる"],["日","ひ"],["まで"],["、"],["その"],["足","あし"],["を"],["飾らず","かざらず"],["、"],["その"],["ひげ"],["を"],["整えず","ととのえず"],["、"],["また"],["その"],["着物","きもの"],["を"],["洗わなかった","あらわなかった"],["。"]]},{"verse":26,"text":"[25]彼,かれがエルサレムからきて王,おうを迎,むかえた時,とき、王,おうは彼,かれに言,いった、「メピボセテよ、あなたはどうしてわたしと共,ともに行,いかなかったのか」。","tok":[["["],["25"],["]"],["彼","かれ"],["が"],["エルサレム"],["から"],["きて"],["王","おう"],["を"],["迎","むかえ"],["た"],["時","とき"],["、"],["王","おう"],["は"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["メピボセテ"],["よ"],["、"],["あなた"],["は"],["どう"],["して"],["わたし"],["と"],["共","とも"],["に"],["行かなかった","いかなかった"],["の"],["か"],["」"],["。"]]},{"verse":27,"text":"[26]彼,かれは答,こたえた、「わが主,しゅ、王,おうよ、わたしの家来,けらいがわたしを欺,あざむいたのです。しもべは彼,かれに、『わたしのために、ろばにくらを置,おけ。わたしはそれに乗,のって王,おうと共,ともに行,いく』と言,いったのです。しもべは足,あしなえだからです。","tok":[["["],["26"],["]"],["彼","かれ"],["は"],["答","こたえ"],["た"],["、"],["「"],["わが"],["主","しゅ"],["、"],["王","おう"],["よ"],["、"],["わたし"],["の"],["家来","けらい"],["が"],["わたし"],["を"],["欺いた","あざむいた"],["の"],["です"],["。"],["しもべ"],["は"],["彼","かれ"],["に"],["、"],["『"],["わたし"],["の"],["ため"],["に"],["、"],["ろば"],["に"],["くら"],["を"],["置","おけ"],["。"],["わたし"],["は"],["それ"],["に"],["乗って","のって"],["王","おう"],["と"],["共","とも"],["に"],["行く","いく"],["』"],["と"],["言った","いった"],["の"],["です"],["。"],["しもべ"],["は"],["足","あし"],["なえ"],["だ"],["から"],["です"],["。"]]},{"verse":28,"text":"[27]ところが彼,かれはしもべのことをわが主,しゅ、王,おうの前,まえに、あしざまに言,いったのです。しかし、わが主,しゅ、王,おうは神,かみの使,つかいのようでいらせられます。それで、あなたの良,よいと思,おもわれることをしてください。","tok":[["["],["27"],["]"],["ところ"],["が"],["彼","かれ"],["は"],["しもべ"],["の"],["こと"],["を"],["わが"],["主","しゅ"],["、"],["王","おう"],["の"],["前","まえ"],["に"],["、"],["あしざま"],["に"],["言った","いった"],["の"],["です"],["。"],["しかし"],["、"],["わが"],["主","しゅ"],["、"],["王","おう"],["は"],["神","かみ"],["の"],["使","つかい"],["の"],["よう"],["で"],["いらせられます"],["。"],["それ"],["で"],["、"],["あなた"],["の"],["良い","よい"],["と"],["思われる","おもわれる"],["こと"],["を"],["して"],["ください"],["。"]]},{"verse":29,"text":"[28]わたしの父,ちちの全家,ぜんかはわが主,しゅ、王,おうの前,まえにはみな死,しんだ人,ひとにすぎないのに、あなたはしもべを、あなたの食卓,しょくたくで食事,しょくじをする人々,ひとびとのうちに置,おかれました。わたしになんの権利,けんりがあって、重,かさねて王,おうに訴,うったえることができましょう」。","tok":[["["],["28"],["]"],["わたし"],["の"],["父","ちち"],["の"],["全","ぜん"],["家","いえ"],["は"],["わが"],["主","しゅ"],["、"],["王","おう"],["の"],["前","まえ"],["に"],["は"],["みな"],["死んだ","しんだ"],["人","ひと"],["に"],["すぎない"],["のに"],["、"],["あなた"],["は"],["しもべ"],["を"],["、"],["あなた"],["の"],["食卓","しょくたく"],["で"],["食事","しょくじ"],["を"],["する"],["人々","ひとびと"],["の"],["うち"],["に"],["置かれました","おかれました"],["。"],["わたし"],["に"],["なん"],["の"],["権利","けんり"],["が"],["あって"],["、"],["重ねて","かさねて"],["王","おう"],["に"],["訴る","うったえる"],["こと"],["が"],["できましょう"],["」"],["。"]]},{"verse":30,"text":"[29]王,おうは彼,かれに言,いった、「あなたはどうしてなおも自分,じぶんのことを言,いうのですか。わたしは決,きめました。あなたとヂバとはその土地,とちを分,わけなさい」。","tok":[["["],["29"],["]"],["王","おう"],["は"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["は"],["どう"],["して"],["なお"],["も"],["自分","じぶん"],["の"],["こと"],["を"],["言う","いう"],["の"],["です"],["か"],["。"],["わたし"],["は"],["決めました","きめました"],["。"],["あなた"],["と"],["ヂバ"],["と"],["は"],["その"],["土地","とち"],["を"],["分け","わけ"],["なさい"],["」"],["。"]]},{"verse":31,"text":"[30]メピボセテは王,おうに言,いった、「わが主,しゅ、王,おうが安,やすらかに家,いえに帰,かえられたのですから、彼,かれにそれをみな取,とらせてください」。","tok":[["["],["30"],["]"],["メピボセテ"],["は"],["王","おう"],["に"],["言った","いった"],["、"],["「"],["わが"],["主","しゅ"],["、"],["王","おう"],["が"],["安らか","やすらか"],["に"],["家","いえ"],["に"],["帰えられた","かえられた"],["の"],["です"],["から"],["、"],["彼","かれ"],["に"],["それ"],["を"],["みな"],["取らせて","とらせて"],["ください"],["」"],["。"]]},{"verse":32,"text":"[31]さてギレアデびとバルジライはロゲリムから下,くだってきて、ヨルダンで王,おうを見送,みおくるため、王,おうと共,ともにヨルダンに進,すすんだ。","tok":[["["],["31"],["]"],["さて"],["ギレアデ"],["びと"],["バルジライ"],["は"],["ロゲリム"],["から"],["下って","くだって"],["きて"],["、"],["ヨルダン"],["で"],["王","おう"],["を"],["見送る","みおくる"],["ため"],["、"],["王","おう"],["と"],["共","とも"],["に"],["ヨルダン"],["に"],["進んだ","すすんだ"],["。"]]},{"verse":33,"text":"[32]バルジライは、ひじょうに年老,としおいた人,ひとで八十歳,さいであった。彼,かれはまた、ひじょうに裕福,ゆうふくな人,ひとであったので、王,おうがマハナイムにとどまっている間,あいだ、王,おうを養,やしなった。","tok":[["["],["32"],["]"],["バルジライ"],["は"],["、"],["ひじょう"],["に"],["年老いた","としおいた"],["人","ひと"],["で"],["八十歳","さ"],["いで"],["あった"],["。"],["彼","かれ"],["は"],["また"],["、"],["ひじょう"],["に"],["裕福","ゆうふく"],["な"],["人","ひと"],["で"],["あった"],["ので"],["、"],["王","おう"],["が"],["マハナイム"],["に"],["とどまって"],["いる"],["間","あいだ"],["、"],["王","おう"],["を"],["養った","やしなった"],["。"]]},{"verse":34,"text":"[33]王,おうはバルジライに言,いった、「わたしと一緒,いっしょに渡,わたって行,いきなさい。わたしはエルサレムであなたをわたしと共,ともにおらせて養,やしないましょう」。","tok":[["["],["33"],["]"],["王","おう"],["は"],["バルジライ"],["に"],["言った","いった"],["、"],["「"],["わたし"],["と"],["一緒","いっしょ"],["に"],["渡って","わたって"],["行き","いき"],["なさい"],["。"],["わたし"],["は"],["エルサレム"],["で"],["あなた"],["を"],["わたし"],["と"],["共","とも"],["に"],["おらせて"],["養いましょう","やしないましょう"],["」"],["。"]]},{"verse":35,"text":"[34]バルジライは王,おうに言,いった、「わたしは、なお何,なに年,ねんいきながらえるので、王,おうと共,ともにエルサレムに上,のぼるのですか。","tok":[["["],["34"],["]"],["バルジライ"],["は"],["王","おう"],["に"],["言った","いった"],["、"],["「"],["わたし"],["は"],["、"],["なお"],["何","な"],["に"],["年","ねん"],["いきながらえる"],["ので"],["、"],["王","おう"],["と"],["共","とも"],["に"],["エルサレム"],["に"],["上る","のぼる"],["の"],["です"],["か"],["。"]]},{"verse":36,"text":"[35]わたしは今日,こんにち八十歳,さいです。わたしに、良,よいこと悪,わるいことがわきまえられるでしょうか。しもべは食,たべるもの、飲,のむものを味,あじわうことができましょうか。わたしは歌,うたう男,おとこや歌,うたう女,おんなの声,こえをまだ聞,きくことができましょうか。それであるのに、しもべはどうしてなおわが主,しゅ、王,おうの重荷,おもにとなってよろしいでしょうか。","tok":[["["],["35"],["]"],["わたし"],["は"],["今日","こん"],["に"],["ち"],["八十歳","さ"],["いです"],["。"],["わたし"],["に"],["、"],["良い","よい"],["こと"],["悪い","わるい"],["こと"],["が"],["わきまえられるでしょう"],["か"],["。"],["しもべ"],["は"],["食べる","たべる"],["もの"],["、"],["飲む","のむ"],["もの"],["を"],["味わう","あじわう"],["こと"],["が"],["できましょう"],["か"],["。"],["わたし"],["は"],["歌う","うたう"],["男","おとこ"],["や"],["歌う","うたう"],["女","おんな"],["の"],["声","こえ"],["を"],["まだ"],["聞く","きく"],["こと"],["が"],["できましょう"],["か"],["。"],["それ"],["で"],["ある"],["のに"],["、"],["しもべ"],["は"],["どう"],["して"],["なお"],["わが"],["主","しゅ"],["、"],["王","おう"],["の"],["重荷","おもに"],["と"],["なって"],["よろしいでしょう"],["か"],["。"]]},{"verse":37,"text":"[36]しもべは王,おうと共,ともにヨルダンを渡,わたって、ただ少,すこし行,いきましょう。どうして王,おうはこのような報,むくいをわたしに報,むくいられなければならないのでしょうか。","tok":[["["],["36"],["]"],["しもべ"],["は"],["王","おう"],["と"],["共","とも"],["に"],["ヨルダン"],["を"],["渡って","わたって"],["、"],["ただ"],["少し","すこし"],["行きましょう","いきましょう"],["。"],["どう"],["して"],["王","おう"],["は"],["この"],["よう"],["な"],["報い","むくい"],["を"],["わたし"],["に"],["報いられなければ","むくいられなければ"],["ならない"],["の"],["でしょう"],["か"],["。"]]},{"verse":38,"text":"[37]どうぞしもべを帰,かえらせてください。わたしは自分,じぶんの町,まちで、父母,ふぼの墓,はかの近,ちかくで死,しにます。ただし、あなたのしもべキムハムがここにおります。わが主,しゅ、王,おうと共,ともに彼,かれを渡,わたって行,いかせてください。またあなたが良,よいと思,おもわれる事,ことを彼,かれにしてください」。","tok":[["["],["37"],["]"],["どうぞ"],["しもべ"],["を"],["帰えらせて","かえらせて"],["ください"],["。"],["わたし"],["は"],["自分","じぶん"],["の"],["町","まち"],["で"],["、"],["父母","ふぼ"],["の"],["墓","はか"],["の"],["近く","ちかく"],["で"],["死にます","しにます"],["。"],["ただし"],["、"],["あなた"],["の"],["しもべ"],["キムハム"],["が"],["ここ"],["に"],["おります"],["。"],["わが"],["主","しゅ"],["、"],["王","おう"],["と"],["共","とも"],["に"],["彼","かれ"],["を"],["渡って","わたって"],["行かせて","いかせて"],["ください"],["。"],["また"],["あなた"],["が"],["良い","よい"],["と"],["思われる","おもわれる"],["事","こと"],["を"],["彼","かれ"],["に"],["して"],["ください"],["」"],["。"]]},{"verse":39,"text":"[38]王,おうは答,こたえた、「キムハムはわたしと共,ともに渡,わたって行,いかせます。わたしは、あなたが良,よいと思,おもわれる事,ことを彼,かれにしましょう。またあなたが望,のぞまれることはみな、あなたのためにいたします」。","tok":[["["],["38"],["]"],["王","おう"],["は"],["答","こたえ"],["た"],["、"],["「"],["キムハム"],["は"],["わたし"],["と"],["共","とも"],["に"],["渡って","わたって"],["行かせます","いかせます"],["。"],["わたし"],["は"],["、"],["あなた"],["が"],["良い","よい"],["と"],["思われる","おもわれる"],["事","こと"],["を"],["彼","かれ"],["に"],["しましょう"],["。"],["また"],["あなた"],["が"],["望まれる","のぞまれる"],["こと"],["は"],["みな"],["、"],["あなた"],["の"],["ため"],["に"],["いたします"],["」"],["。"]]},{"verse":40,"text":"[39]こうして民,たみはみなヨルダンを渡,わたった。王,おうは渡,わたった時,とき、バルジライに口,くちづけして、祝福,しゅくふくしたので、彼,かれは自分,じぶんの家,いえに帰,かえっていった。","tok":[["["],["39"],["]"],["こう"],["して"],["民","たみ"],["は"],["みな"],["ヨルダン"],["を"],["渡った","わたった"],["。"],["王","おう"],["は"],["渡った","わたった"],["時","とき"],["、"],["バルジライ"],["に"],["口づけ","くちづけ"],["して"],["、"],["祝福","しゅくふく"],["した"],["ので"],["、"],["彼","かれ"],["は"],["自分","じぶん"],["の"],["家","いえ"],["に"],["帰えって","かえって"],["いった"],["。"]]},{"verse":41,"text":"[40]王,おうはギルガルに進,すすんだ。キムハムも彼,かれと共,ともに進,すすんだ。ユダの民,たみはみな王,おうを送,おくり、イスラエルの民,たみの半,なかばもまたそうした。","tok":[["["],["40"],["]"],["王","おう"],["は"],["ギルガル"],["に"],["進んだ","すすんだ"],["。"],["キムハム"],["も"],["彼","かれ"],["と"],["共","とも"],["に"],["進んだ","すすんだ"],["。"],["ユダ"],["の"],["民","たみ"],["は"],["みな"],["王","おう"],["を"],["送り","おくり"],["、"],["イスラエル"],["の"],["民","たみ"],["の"],["半ば","なかば"],["も"],["また"],["そう"],["した"],["。"]]},{"verse":42,"text":"[41]さてイスラエルの人々,ひとびとはみな王,おうの所,ところにきて、王,おうに言,いった、「われわれの兄弟,きょうだいであるユダの人々,ひとびとは、何,なにゆえにあなたを盗,ぬすみ去,さって、王,おうとその家族,かぞく、およびダビデに伴,ともなっているすべての従者,じゅうしゃにヨルダンを渡,わたらせたのですか」。","tok":[["["],["41"],["]"],["さて"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["みな"],["王","おう"],["の"],["所","ところ"],["に"],["きて"],["、"],["王","おう"],["に"],["言った","いった"],["、"],["「"],["われわれ"],["の"],["兄弟","きょうだい"],["で"],["ある"],["ユダ"],["の"],["人々","ひとびと"],["は"],["、"],["何ゆえ","なにゆえ"],["に"],["あなた"],["を"],["盗み","ぬすみ"],["去て","さって"],["、"],["王","おう"],["と"],["その"],["家族","かぞく"],["、"],["および"],["ダビデ"],["に"],["伴なって","ともなって"],["いる"],["すべて"],["の"],["従者","じゅうしゃ"],["に"],["ヨルダン"],["を"],["渡らせた","わたらせた"],["の"],["です"],["か"],["」"],["。"]]},{"verse":43,"text":"[42]ユダの人々,ひとびとはみなイスラエルの人々,ひとびとに答,こたえた、「王,おうはわれわれの近親,きんしんだからです。あなたがたはどうしてこの事,ことで怒,いかられるのですか。われわれが少,すこしでも王,おうの物,ものを食,たべたことがありますか。王,おうが何,なにか賜物,たまものをわれわれに与,あたえたことがありますか」。","tok":[["["],["42"],["]"],["ユダ"],["の"],["人々","ひとびと"],["は"],["みな"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["答","こたえ"],["た"],["、"],["「"],["王","おう"],["は"],["われわれ"],["の"],["近親","きんしん"],["だ"],["から"],["です"],["。"],["あなた"],["がた"],["は"],["どう"],["して"],["この"],["事","こと"],["で"],["怒","いかられる"],["の"],["です"],["か"],["。"],["われわれ"],["が"],["少し","すこし"],["で"],["も"],["王","おう"],["の"],["物","もの"],["を"],["食べた","たべた"],["こと"],["が"],["あります"],["か"],["。"],["王","おう"],["が"],["何に","なに"],["か"],["賜物","たまもの"],["を"],["われわれ"],["に"],["与","あたえ"],["た"],["こと"],["が"],["あります"],["か"],["」"],["。"]]},{"verse":44,"text":"[43]イスラエルの人々,ひとびとはユダの人々,ひとびとに答,こたえた、「われわれは王,おうのうちに十の分,ぶんを持,もっています。またダビデのうちにもわれわれはあなたがたよりも多,おおくを持,もっています。それであるのに、どうしてあなたがたはわれわれを軽,かろんじたのですか。われらの王,おうを導,みちびき帰,かえろうと最初,さいしょに言,いったのはわれわれではないのですか」。しかしユダの人々,ひとびとの言葉,ことばはイスラエルの人々,ひとびとの言葉,ことばよりも激,はげしかった。","tok":[["["],["43"],["]"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["ユダ"],["の"],["人々","ひとびと"],["に"],["答","こたえ"],["た"],["、"],["「"],["われわれ"],["は"],["王","おう"],["の"],["うち"],["に"],["十","じゅう"],["の"],["分","ぶん"],["を"],["持って","もって"],["います"],["。"],["また"],["ダビデ"],["の"],["うち"],["に"],["も"],["われわれ"],["は"],["あなた"],["が"],["たより"],["も"],["多く","おおく"],["を"],["持って","もって"],["います"],["。"],["それ"],["で"],["ある"],["のに"],["、"],["どう"],["して"],["あなた"],["がた"],["は"],["われわれ"],["を"],["軽","かろんじた"],["の"],["です"],["か"],["。"],["われ"],["ら"],["の"],["王","おう"],["を"],["導き","みちびき"],["帰えろう","かえろう"],["と"],["最初","さいしょ"],["に"],["言った","いった"],["の"],["は"],["われわれ"],["で"],["は"],["ない"],["の"],["です"],["か"],["」"],["。"],["しかし"],["ユダ"],["の"],["人々","ひとびと"],["の"],["言葉","ことば"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["言葉","ことば"],["より"],["も"],["激しかった","はげしかった"],["。"]]}]
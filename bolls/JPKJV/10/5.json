[{"verse":1,"text":"イスラエルのすべての部族,ぶぞくはヘブロンにいるダビデのもとにきて言,いった、「われわれは、あなたの骨肉,こつにくです。","tok":[["イスラエル"],["の"],["すべて"],["の"],["部族","ぶぞく"],["は"],["ヘブロン"],["に"],["いる"],["ダビデ"],["の"],["もと"],["に"],["きて"],["言った","いった"],["、"],["「"],["われわれ"],["は"],["、"],["あなた"],["の"],["骨肉","こつにく"],["です"],["。"]]},{"verse":2,"text":"先,さきにサウルがわれわれの王,おうであった時,ときにも、あなたはイスラエルを率,ひきいて出入,でいりされました。そして主,しゅはあなたに、『あなたはわたしの民,たみイスラエルを牧,ぼくするであろう。またあなたはイスラエルの君,きみとなるであろう』と言,いわれました」。","tok":[["先","さき"],["に"],["サウル"],["が"],["われわれ"],["の"],["王","おう"],["で"],["あった"],["時","とき"],["に"],["も"],["、"],["あなた"],["は"],["イスラエル"],["を"],["率いて","ひきいて"],["出入","でいり"],["されました"],["。"],["そして"],["主","しゅ"],["は"],["あなた"],["に"],["、"],["『"],["あなた"],["は"],["わたし"],["の"],["民","たみ"],["イスラエル"],["を"],["牧","ぼ"],["く"],["するで"],["あろう"],["。"],["また"],["あなた"],["は"],["イスラエル"],["の"],["君","きみ"],["と"],["なるで"],["あろう"],["』"],["と"],["言われました","いわれました"],["」"],["。"]]},{"verse":3,"text":"このようにイスラエルの長老,ちょうろうたちが皆,みな、ヘブロンにいる王,おうのもとにきたので、ダビデ王,おうはヘブロンで主,しゅの前,まえに彼,かれらと契約,けいやくを結,むすんだ。そして彼,かれらはダビデに油,あぶらを注,そそいでイスラエルの王,おうとした。","tok":[["この"],["よう"],["に"],["イスラエル"],["の"],["長老","ちょうろう"],["たち"],["が"],["皆","みな"],["、"],["ヘブロン"],["に"],["いる"],["王","おう"],["の"],["もと"],["に"],["きた"],["ので"],["、"],["ダビデ"],["王","おう"],["は"],["ヘブロン"],["で"],["主","しゅ"],["の"],["前","まえ"],["に"],["彼","かれ"],["ら"],["と"],["契約","けいやく"],["を"],["結んだ","むすんだ"],["。"],["そして"],["彼","かれ"],["ら"],["は"],["ダビデ"],["に"],["油","あぶら"],["を"],["注いで","そそいで"],["イスラエル"],["の"],["王","おう"],["と"],["した"],["。"]]},{"verse":4,"text":"ダビデは王,おうとなったとき三十歳,さいで、四十年,ねんの間,あいだ、世,よを治,おさめた。","tok":[["ダビデ"],["は"],["王","おう"],["と"],["なった"],["とき"],["三十歳","さ"],["いで"],["、"],["四十","よんじゅう"],["年","ねん"],["の"],["間","あいだ"],["、"],["世","よ"],["を"],["治めた","おさめた"],["。"]]},{"verse":5,"text":"すなわちヘブロンで七年,ねん六か月,げつユダを治,おさめ、またエルサレムで三十三年,ねん、全,ぜんイスラエルとユダを治,おさめた。","tok":[["すなわち"],["ヘブロン"],["で"],["七","なな"],["年","ねん"],["六","ろく"],["か月","かげつ"],["ユダ"],["を"],["治め","おさめ"],["、"],["また"],["エルサレム"],["で"],["三十三","さんじゅうさん"],["年","ねん"],["、"],["全","ぜん"],["イスラエル"],["と"],["ユダ"],["を"],["治めた","おさめた"],["。"]]},{"verse":6,"text":"王,おうとその従者,じゅうしゃたちとはエルサレムへ行,いって、その地,ちの住民,じゅうみんエブスびとを攻,せめた。エブスびとはダビデに言,いった、「あなたはけっして、ここに攻,せめ入,いることはできない。かえって、めしいや足,あしなえでも、あなたを追,おい払,はらうであろう」。彼,かれらが「ダビデはここに攻,せめ入,いることはできない」と思,おもったからである。","tok":[["王","おう"],["と"],["その"],["従者","じゅうしゃ"],["たち"],["と"],["は"],["エルサレム"],["へ"],["行って","いって"],["、"],["その"],["地","ち"],["の"],["住民","じゅうみん"],["エブス"],["びと"],["を"],["攻めた","せめた"],["。"],["エブス"],["びと"],["は"],["ダビデ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["は"],["けっして"],["、"],["ここ"],["に"],["攻め入る","せめいる"],["こと"],["は"],["できない"],["。"],["かえって"],["、"],["めし"],["いや"],["足","あし"],["な"],["え"],["で"],["も"],["、"],["あなた"],["を"],["追い払うで","おいはらうで"],["あろう"],["」"],["。"],["彼","かれ"],["ら"],["が"],["「"],["ダビデ"],["は"],["ここ"],["に"],["攻め入る","せめいる"],["こと"],["は"],["できない"],["」"],["と"],["思った","おもった"],["から"],["で"],["ある"],["。"]]},{"verse":7,"text":"ところがダビデはシオンの要害,ようがいを取,とった。これがダビデの町,まちである。","tok":[["ところ"],["が"],["ダビデ"],["は"],["シオン"],["の"],["要害","ようがい"],["を"],["取った","とった"],["。"],["これ"],["が"],["ダビデ"],["の"],["町","まち"],["で"],["ある"],["。"]]},{"verse":8,"text":"その日,ひダビデは、「だれでもエブスびとを撃,うとうとする人,ひとは、水,みずをくみ上,あげる縦穴,たてあなを上,のぼって行,いって、ダビデが心,こころに憎,にくんでいる足,あしなえやめしいを撃,うて」と言,いった。それゆえに人々,ひとびとは、「めしいや足,あしなえは、宮,みやにはいってはならない」と言,いいならわしている。","tok":[["その"],["日","ひ"],["ダビデ"],["は"],["、"],["「"],["だれ"],["で"],["も"],["エブス"],["びと"],["を"],["撃とう","うとう"],["と"],["する"],["人","ひと"],["は"],["、"],["水","みず"],["を"],["くみ上げる","くみあげる"],["縦穴","たてあな"],["を"],["上って","のぼって"],["行って","いって"],["、"],["ダビデ"],["が"],["心","こころ"],["に"],["憎んで","にくんで"],["いる"],["足","あし"],["な"],["え"],["やめ"],["しい"],["を"],["撃て","うて"],["」"],["と"],["言った","いった"],["。"],["それ"],["ゆえ"],["に"],["人々","ひとびと"],["は"],["、"],["「"],["めし"],["いや"],["足","あし"],["なえ"],["は"],["、"],["宮","みや"],["に"],["はいって"],["は"],["ならない"],["」"],["と"],["言いならわして","いいならわして"],["いる"],["。"]]},{"verse":9,"text":"ダビデはその要害,ようがいに住,すんで、これをダビデの町,まちと名,なづけた。またダビデはミロから内,うちの周囲,しゅういに城壁,じょうへきを築,きずいた。","tok":[["ダビデ"],["は"],["その"],["要害","ようがい"],["に"],["住んで","すんで"],["、"],["これ"],["を"],["ダビデ"],["の"],["町","まち"],["と"],["名づけた","なづけた"],["。"],["また"],["ダビデ"],["は"],["ミロ"],["から"],["内","うち"],["の"],["周囲","しゅうい"],["に"],["城壁","じょうへき"],["を"],["築いた","きずいた"],["。"]]},{"verse":10,"text":"こうしてダビデはますます大,おおいなる者,ものとなり、かつ万軍,ばんぐんの神,かみ、主,しゅが彼,かれと共,ともにおられた。","tok":[["こう"],["して"],["ダビデ"],["は"],["ますます"],["大いなる","おおいなる"],["者","もの"],["と"],["なり"],["、"],["かつ"],["万","まん"],["軍","ぐん"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["彼","かれ"],["と"],["共","とも"],["に"],["おられた"],["。"]]},{"verse":11,"text":"ツロの王,おうヒラムはダビデに使者,ししゃをつかわして、香柏,こうはくおよび大工,だいくと石工,いしくを送,おくった。彼,かれらはダビデのために家,いえを建,たてた。","tok":[["ツロ"],["の"],["王","おう"],["ヒラム"],["は"],["ダビデ"],["に"],["使者","ししゃ"],["を"],["つかわして"],["、"],["香","こう"],["柏","かしわ"],["う"],["はく"],["および"],["大工","だいく"],["と"],["石工","いしく"],["を"],["送った","おくった"],["。"],["彼","かれ"],["ら"],["は"],["ダビデ"],["の"],["ため"],["に"],["家","いえ"],["を"],["建てた","たてた"],["。"]]},{"verse":12,"text":"そしてダビデは主,しゅが自分,じぶんを堅,かたく立,たててイスラエルの王,おうとされたこと、主,しゅがその民,たみイスラエルのためにその王国,おうこくを興,おこされたことを悟,さとった。","tok":[["そして"],["ダビデ"],["は"],["主","しゅ"],["が"],["自分","じぶん"],["を"],["堅く","かたく"],["立てて","たてて"],["イスラエル"],["の"],["王","おう"],["と"],["された"],["こと"],["、"],["主","しゅがそ"],["の"],["民","たみ"],["イスラエル"],["の"],["ため"],["に"],["その"],["王国","おうこく"],["を"],["興された","おこされた"],["こと"],["を"],["悟った","さとった"],["。"]]},{"verse":13,"text":"ダビデはヘブロンからきて後,のち、さらにエルサレムで妻,つまとそばめを入,いれたので、むすこと娘,むすめがまたダビデに生,うまれた。","tok":[["ダビデ"],["は"],["ヘブロン"],["から"],["きて"],["後","の"],["ち"],["、"],["さらに"],["エルサレム"],["で"],["妻","つま"],["と"],["そばめ"],["を"],["入れた","いれた"],["ので"],["、"],["むすこ"],["と"],["娘","むすめ"],["が"],["また"],["ダビデ"],["に"],["生まれた","うまれた"],["。"]]},{"verse":14,"text":"エルサレムで彼,かれに生,うまれた者,ものの名,なは次,つぎのとおりである。シャンムア、ショバブ、ナタン、ソロモン、","tok":[["エルサレム"],["で"],["彼","かれ"],["に"],["生まれた","うまれた"],["者","もの"],["の"],["名","な"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["シャンムア"],["、"],["ショバブ"],["、"],["ナタン"],["、"],["ソロモン"],["、"]]},{"verse":15,"text":"イブハル、エリシュア、ネペグ、ヤピア、","tok":[["イブハル"],["、"],["エリシュア"],["、"],["ネペグ"],["、"],["ヤピア"],["、"]]},{"verse":16,"text":"エリシャマ、エリアダ、およびエリペレテ。","tok":[["エリシャマ"],["、"],["エリアダ"],["、"],["および"],["エリペレテ"],["。"]]},{"verse":17,"text":"さてペリシテびとは、ダビデが油,あぶらを注,そそがれてイスラエルの王,おうになったことを聞,きき、みな上,のぼってきてダビデを捜,さがしたが、ダビデはそれを聞,きいて要害,ようがいに下,くだって行,いった。","tok":[["さて"],["ペリシテ"],["び"],["と"],["は"],["、"],["ダビデ"],["が"],["油","あぶら"],["を"],["注がれて","そそがれて"],["イスラエル"],["の"],["王","おう"],["に"],["なった"],["こと"],["を"],["聞","きき"],["、"],["みな"],["上って","のぼって"],["きて"],["ダビデ"],["を"],["捜した","さがした"],["が"],["、"],["ダビデ"],["は"],["それ"],["を"],["聞いて","きいて"],["要害","ようがい"],["に"],["下って","くだって"],["行った","いった"],["。"]]},{"verse":18,"text":"ペリシテびとはきて、レパイムの谷,たにに広,ひろがっていた。","tok":[["ペリシテ"],["び"],["と"],["は"],["きて"],["、"],["レパイム"],["の"],["谷","たに"],["に"],["広がって","ひろがって"],["いた"],["。"]]},{"verse":19,"text":"ダビデは主,しゅに問,とうて言,いった、「ペリシテびとに向,むかって上,のぼるべきでしょうか。あなたは彼,かれらをわたしの手,てに渡,わたされるでしょうか」。主,しゅはダビデに言,いわれた、「上,のぼるがよい。わたしはかならずペリシテびとをあなたの手,てに渡,わたすであろう」。","tok":[["ダビデ"],["は"],["主に","しゅに"],["問うて","とうて"],["言った","いった"],["、"],["「"],["ペリシテ"],["びと"],["に"],["向かって","むかって"],["上るべきでしょう","のぼるべきでしょう"],["か"],["。"],["あなた"],["は"],["彼","かれ"],["ら"],["を"],["わたし"],["の"],["手","て"],["に"],["渡されるでしょう","わたされるでしょう"],["か"],["」"],["。"],["主","しゅ"],["は"],["ダビデ"],["に"],["言われた","いわれた"],["、"],["「"],["上る","のぼる"],["が"],["よい"],["。"],["わたし"],["は"],["かならず"],["ペリシテ"],["びと"],["を"],["あなた"],["の"],["手","て"],["に"],["渡すで","わたすで"],["あろう"],["」"],["。"]]},{"verse":20,"text":"そこでダビデはバアル・ペラジムへ行,いって、彼,かれらをその所,ところで撃,うち破,やぶり、そして言,いった、「主,しゅは、破,やぶり出,でる水,みずのように、敵,てきをわたしの前,まえに破,やぶられた」。それゆえにその所,ところの名,なはバアル・ペラジムと呼,よばれている。","tok":[["そこ"],["で"],["ダビデ"],["は"],["バアル"],["・"],["ペラジム"],["へ"],["行って","いって"],["、"],["彼","かれ"],["ら"],["を"],["その"],["所","ところ"],["で"],["撃ち破り","うちやぶり"],["、"],["そして"],["言った","いった"],["、"],["「"],["主","しゅ"],["は"],["、"],["破り","やぶり"],["出る","でる"],["水","みず"],["の"],["よう"],["に"],["、"],["敵","てき"],["を"],["わたし"],["の"],["前","まえ"],["に"],["破られた","やぶられた"],["」"],["。"],["それ"],["ゆえ"],["に"],["その"],["所","ところ"],["の"],["名","な"],["は"],["バアル"],["・"],["ペラジム"],["と"],["呼ばれて","よばれて"],["いる"],["。"]]},{"verse":21,"text":"ペリシテびとはその所,ところに彼,かれらの偶像,ぐうぞうを捨,すてて行,いったので、ダビデとその従者,じゅうしゃたちはそれを運,はこび去,さった。","tok":[["ペリシテ"],["び"],["と"],["は"],["その"],["所","ところ"],["に"],["彼","かれ"],["ら"],["の"],["偶像","ぐうぞう"],["を"],["捨てて","すてて"],["行った","いった"],["ので"],["、"],["ダビデ"],["と"],["その"],["従者","じゅうしゃ"],["たち"],["は"],["それ"],["を"],["運こび","はこび"],["去た","さった"],["。"]]},{"verse":22,"text":"ペリシテびとが、ふたたび上,のぼってきて、レパイムの谷,たにに広,ひろがったので、","tok":[["ペリシテ"],["びと"],["が"],["、"],["ふたたび"],["上って","のぼって"],["きて"],["、"],["レパイム"],["の"],["谷","たに"],["に"],["広がった","ひろがった"],["ので"],["、"]]},{"verse":23,"text":"ダビデは主,しゅに問,とうたが、主,しゅは言,いわれた、「上,のぼってはならない。彼,かれらのうしろに回,まわり、バルサムの木,きの前,まえから彼,かれらを襲,おそいなさい。","tok":[["ダビデ"],["は"],["主に","しゅに"],["問うた","とうた"],["が"],["、"],["主","しゅ"],["は"],["言われた","いわれた"],["、"],["「"],["上って","のぼって"],["は"],["ならない"],["。"],["彼","かれ"],["ら"],["の"],["うしろ"],["に"],["回わり","まわり"],["、"],["バルサム"],["の"],["木","き"],["の"],["前","まえ"],["から"],["彼","かれ"],["ら"],["を"],["襲い","おそい"],["なさい"],["。"]]},{"verse":24,"text":"バルサムの木,きの上,うえに行進,こうしんの音,おとが聞,きこえたならば、あなたは奮,ふるい立,たたなければならない。その時,とき、主,しゅがあなたの前,まえに出,でて、ペリシテびとの軍勢,ぐんぜいを撃,うたれるからである」。","tok":[["バルサム"],["の"],["木","き"],["の"],["上","うえ"],["に"],["行進","こうしん"],["の"],["音","おと"],["が"],["聞こえたならば","きこえたならば"],["、"],["あなた"],["は"],["奮い立たなければ","ふるいたたなければ"],["ならない"],["。"],["その"],["時","とき"],["、"],["主","しゅ"],["が"],["あなた"],["の"],["前","まえ"],["に"],["出て","でて"],["、"],["ペリシテ"],["びと"],["の"],["軍勢","ぐんぜい"],["を"],["撃たれる","うたれる"],["から"],["で"],["ある"],["」"],["。"]]},{"verse":25,"text":"ダビデは、主,しゅが命,めいじられたようにして、ペリシテびとを撃,うち、ゲバからゲゼルに及,およんだ。","tok":[["ダビデ"],["は"],["、"],["主","しゅ"],["が"],["命じられた","めいじられた"],["よう"],["に"],["して"],["、"],["ペリシテ"],["びと"],["を"],["撃ち","うち"],["、"],["ゲバ"],["から"],["ゲゼル"],["に"],["及んだ","およんだ"],["。"]]}]
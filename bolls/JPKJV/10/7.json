[{"verse":1,"text":"さて、王,おうが自分,じぶんの家,いえに住,すみ、また主,しゅが周囲,しゅういの敵,てきをことごとく打,うち退,しりぞけて彼,かれに安息,あんそくを賜,たまわった時,とき、","tok":[["さて"],["、"],["王","おう"],["が"],["自分","じぶん"],["の"],["家","いえ"],["に"],["住み","すみ"],["、"],["また"],["主","しゅ"],["が"],["周囲","しゅうい"],["の"],["敵","てき"],["を"],["ことごとく"],["打ち","うち"],["退ぞけて","しりぞけて"],["彼","かれ"],["に"],["安息","あんそく"],["を"],["賜わった","たまわった"],["時","とき"],["、"]]},{"verse":2,"text":"王,おうは預言者,よげんしゃナタンに言,いった、「見,みよ、今,いまわたしは、香柏,こうはくの家,いえに住,すんでいるが、神,かみの箱,はこはなお幕屋,まくやのうちにある」。","tok":[["王","おう"],["は"],["預言者","よげんしゃ"],["ナタン"],["に"],["言った","いった"],["、"],["「"],["見よ","みよ"],["、"],["今","いま"],["わたし"],["は"],["、"],["香","こう"],["柏","かしわ"],["の"],["家","いえ"],["に"],["住んで","すんで"],["いる"],["が"],["、"],["神","かみ"],["の"],["箱","は"],["こ"],["は"],["なお"],["幕屋","まくや"],["の"],["うち"],["に"],["ある"],["」"],["。"]]},{"verse":3,"text":"ナタンは王,おうに言,いった、「主,しゅがあなたと共,ともにおられますから、行,いって、すべてあなたの心,こころにあるところを行,おこないなさい」。","tok":[["ナタン"],["は"],["王","おう"],["に"],["言った","いった"],["、"],["「"],["主","しゅ"],["が"],["あなた"],["と"],["共","とも"],["に"],["おられます"],["から"],["、"],["行って","いって"],["、"],["すべて"],["あなた"],["の"],["心","こころ"],["に"],["ある"],["ところ"],["を"],["行ない","おこない"],["なさい"],["」"],["。"]]},{"verse":4,"text":"その夜,よる、主,しゅの言葉,ことばがナタンに臨,のぞんで言,いった、","tok":[["その"],["夜","よる"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["が"],["ナタン"],["に"],["臨んで","のぞんで"],["言った","いった"],["、"]]},{"verse":5,"text":"「行,いって、わたしのしもべダビデに言,いいなさい、『主,しゅはこう仰,おおせられる。あなたはわたしの住,すむ家,いえを建,たてようとするのか。","tok":[["「"],["行って","いって"],["、"],["わたし"],["の"],["しもべ"],["ダビデ"],["に"],["言い","いい"],["なさい"],["、"],["『"],["主","しゅ"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["あなた"],["は"],["わたし"],["の"],["住む","すむ"],["家","いえ"],["を"],["建てよう","たてよう"],["と"],["する"],["の"],["か"],["。"]]},{"verse":6,"text":"わたしはイスラエルの人々,ひとびとをエジプトから導,みちびき出,だした日,ひから今日,こんにちまで、家,いえに住,すまわず、天幕,てんまくをすまいとして歩,あゆんできた。","tok":[["わたし"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["を"],["エジプト"],["から"],["導き出した","みちびきだした"],["日","ひ"],["から"],["今日","こん"],["に"],["ち"],["まで"],["、"],["家","いえ"],["に"],["住まわず","すまわず"],["、"],["天幕","てんまく"],["を"],["すまい"],["として"],["歩んで","あゆんで"],["きた"],["。"]]},{"verse":7,"text":"わたしがイスラエルのすべての人々,ひとびとと共,ともに歩,あゆんだすべての所,ところで、わたしがわたしの民,たみイスラエルを牧,ぼくすることを命,めいじたイスラエルのさばきづかさのひとりに、ひと言,ことでも「どうしてあなたがたはわたしのために香柏,こうはくの家,いえを建,たてないのか」と、言,いったことがあるであろうか』。","tok":[["わたし"],["が"],["イスラエル"],["の"],["すべて"],["の"],["人々","ひとびと"],["と"],["共","とも"],["に"],["歩んだ","あゆんだ"],["すべて"],["の"],["所","ところ"],["で"],["、"],["わたし"],["が"],["わたし"],["の"],["民","たみ"],["イスラエル"],["を"],["牧","ぼくするこ"],["と"],["を"],["命じた","めいじた"],["イスラエル"],["の"],["さばき"],["づかさ"],["の"],["ひとり"],["に"],["、"],["ひと言","ひとこと"],["で"],["も"],["「"],["どう"],["して"],["あなた"],["がた"],["は"],["わたし"],["の"],["ため"],["に"],["香","こう"],["柏","かしわ"],["の"],["家","いえ"],["を"],["建てない","たてない"],["の"],["か"],["」"],["と"],["、"],["言った","いった"],["こと"],["が"],["あるで"],["あろう"],["か"],["』"],["。"]]},{"verse":8,"text":"それゆえ、今,いまあなたは、わたしのしもべダビデにこう言,いいなさい、『万軍,ばんぐんの主,しゅはこう仰,おおせられる。わたしはあなたを牧場,まきばから、羊,ひつじに従,したがっている所,ところから取,とって、わたしの民,たみイスラエルの君,きみとし、","tok":[["それ"],["ゆえ"],["、"],["今","いま"],["あなた"],["は"],["、"],["わたし"],["の"],["しもべ"],["ダビデ"],["に"],["こう"],["言い","いい"],["なさい"],["、"],["『"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["わたし"],["は"],["あなた"],["を"],["牧場","まきばか"],["ら"],["、"],["羊","ひつじ"],["に"],["従って","したがって"],["いる"],["所","ところ"],["から"],["取って","とって"],["、"],["わたし"],["の"],["民","たみ"],["イスラエル"],["の"],["君","きみ"],["と"],["し"],["、"]]},{"verse":9,"text":"あなたがどこへ行,いくにも、あなたと共,ともにおり、あなたのすべての敵,てきをあなたの前,まえから断,たち去,さった。わたしはまた地上,ちじょうの大,おおいなる者,ものの名,なのような大,おおいなる名,なをあなたに得,えさせよう。","tok":[["あなた"],["が"],["どこ"],["へ"],["行く","いく"],["に"],["も"],["、"],["あなた"],["と"],["共","とも"],["に"],["おり"],["、"],["あなた"],["の"],["すべて"],["の"],["敵","てき"],["を"],["あなた"],["の"],["前","まえ"],["から"],["断ち","たち"],["去た","さった"],["。"],["わたし"],["は"],["また"],["地上","ちじょう"],["の"],["大いなる","おおいなる"],["者","もの"],["の"],["名","な"],["の"],["よう"],["な"],["大いなる","おおいなる"],["名","な"],["を"],["あなた"],["に"],["得させよう","えさせよう"],["。"]]},{"verse":10,"text":"そしてわたしの民,たみイスラエルのために一つの所,ところを定,さだめて、彼,かれらを植,うえつけ、彼,かれらを自分,じぶんの所,ところに住,すませ、重,かさねて動,うごくことのないようにするであろう。","tok":[["そして"],["わたし"],["の"],["民","たみ"],["イスラエル"],["の"],["ため"],["に"],["一","ひと"],["つ"],["の"],["所","ところ"],["を"],["定めて","さだめて"],["、"],["彼","かれ"],["ら"],["を"],["植えつけ","うえつけ"],["、"],["彼","かれ"],["ら"],["を"],["自分","じぶん"],["の"],["所","ところ"],["に"],["住ませ","すませ"],["、"],["重ねて","かさねて"],["動く","うごく"],["こと"],["の"],["ない"],["よう"],["に"],["するで"],["あろう"],["。"]]},{"verse":11,"text":"また前,まえのように、わたしがわたしの民,たみイスラエルの上,うえにさばきづかさを立,たてた日,ひからこのかたのように、悪人,あくにんが重,かさねてこれを悩,なやますことはない。わたしはあなたのもろもろの敵,てきを打,うち退,しりぞけて、あなたに安息,あんそくを与,あたえるであろう。主,しゅはまた「あなたのために家,いえを造,つくる」と仰,おおせられる。","tok":[["また"],["前","まえ"],["の"],["よう"],["に"],["、"],["わたし"],["が"],["わたし"],["の"],["民","たみ"],["イスラエル"],["の"],["上","うえ"],["に"],["さばき"],["づかさ"],["を"],["立てた","たてた"],["日","ひ"],["から"],["このかた"],["の"],["よう"],["に"],["、"],["悪人","あくにん"],["が"],["重ねて","かさねて"],["これ"],["を"],["悩す","なやます"],["こと"],["は"],["ない"],["。"],["わたし"],["は"],["あなた"],["の"],["もろもろ"],["の"],["敵","てき"],["を"],["打ち","うち"],["退ぞけて","しりぞけて"],["、"],["あなた"],["に"],["安息","あんそく"],["を"],["与えるで","あたえるで"],["あろう"],["。"],["主","しゅ"],["は"],["また"],["「"],["あなた"],["の"],["ため"],["に"],["家","いえ"],["を"],["造る","つくる"],["」"],["と"],["仰せられる","おおせられる"],["。"]]},{"verse":12,"text":"あなたが日,ひが満,みちて、先祖,せんぞたちと共,ともに眠,ねむる時,とき、わたしはあなたの身,みから出,でる子,こを、あなたのあとに立,たてて、その王国,おうこくを堅,かたくするであろう。","tok":[["あなた"],["が"],["日","ひ"],["が"],["満ちて","みちて"],["、"],["先祖","せんぞ"],["たち"],["と"],["共","とも"],["に"],["眠る","ねむる"],["時","とき"],["、"],["わたし"],["は"],["あなた"],["の"],["身","み"],["から"],["出る","でる"],["子","こ"],["を"],["、"],["あなた"],["の"],["あと"],["に"],["立てて","たてて"],["、"],["その"],["王国","おうこく"],["を"],["堅く","かたく"],["するで"],["あろう"],["。"]]},{"verse":13,"text":"彼,かれはわたしの名,なのために家,いえを建,たてる。わたしは長,ながくその国,くにの位,くらいを堅,かたくしよう。","tok":[["彼","かれ"],["は"],["わたし"],["の"],["名","な"],["の"],["ため"],["に"],["家","いえ"],["を"],["建てる","たてる"],["。"],["わたし"],["は"],["長く","ながく"],["その"],["国","くに"],["の"],["位","くらい"],["を"],["堅く","かたく"],["しよう"],["。"]]},{"verse":14,"text":"わたしは彼,かれの父,ちちとなり、彼,かれはわたしの子,ことなるであろう。もし彼,かれが罪,つみを犯,おかすならば、わたしは人,ひとのつえと人,ひとの子,このむちをもって彼,かれを懲,こらす。","tok":[["わたし"],["は"],["彼","かれ"],["の"],["父","ちち"],["と"],["なり"],["、"],["彼","かれ"],["は"],["わたし"],["の"],["子","こ"],["と"],["なるで"],["あろう"],["。"],["もし"],["彼","かれ"],["が"],["罪","つみ"],["を"],["犯すならば","おかすならば"],["、"],["わたし"],["は"],["人","ひと"],["の"],["つえ"],["と"],["人","ひと"],["の"],["子","こ"],["の"],["むち"],["を"],["もって"],["彼","かれ"],["を"],["懲らす","こらす"],["。"]]},{"verse":15,"text":"しかしわたしはわたしのいつくしみを、わたしがあなたの前,まえから除,のぞいたサウルから取,とり去,さったように、彼,かれからは取,とり去,さらない。","tok":[["しかし"],["わたし"],["は"],["わたし"],["の"],["いつくしみ"],["を"],["、"],["わたし"],["が"],["あなた"],["の"],["前","まえ"],["から"],["除いた","のぞいた"],["サウル"],["から"],["取","とり"],["去た","さった"],["よう"],["に"],["、"],["彼","かれ"],["から"],["は"],["取去らない","とりさらない"],["。"]]},{"verse":16,"text":"あなたの家,いえと王国,おうこくはわたしの前,まえに長,ながく保,たもつであろう。あなたの位,くらいは長,ながく堅,かとうせられる』」。","tok":[["あなた"],["の"],["家","いえ"],["と"],["王国","おうこく"],["は"],["わたし"],["の"],["前","まえ"],["に"],["長く","ながく"],["保つで","たもつで"],["あろう"],["。"],["あなた"],["の"],["位","くらい"],["は"],["長く","ながく"],["堅う","かとう"],["せられる"],["』"],["」"],["。"]]},{"verse":17,"text":"ナタンはすべてこれらの言葉,ことばのように、またすべてこの幻,まぼろしのようにダビデに語,かたった。","tok":[["ナタン"],["は"],["すべて"],["これ"],["ら"],["の"],["言葉","ことば"],["の"],["よう"],["に"],["、"],["また"],["すべて"],["この"],["幻","まぼろし"],["の"],["よう"],["に"],["ダビデ"],["に"],["語った","かたった"],["。"]]},{"verse":18,"text":"その時,ときダビデ王,おうは、はいって主,しゅの前,まえに座,ざして言,いった、「主,しゅなる神,かみよ、わたしがだれ、わたしの家,いえが何,なにであるので、あなたはこれまでわたしを導,みちびかれたのですか。","tok":[["その"],["時","とき"],["ダビデ"],["王","おう"],["は"],["、"],["はい"],["って"],["主","しゅ"],["の"],["前","まえ"],["に"],["座して","ざして"],["言った","いった"],["、"],["「"],["主","しゅ"],["なる"],["神","かみ"],["よ"],["、"],["わたし"],["が"],["だれ"],["、"],["わたし"],["の"],["家","いえ"],["が"],["何","な"],["に"],["で"],["ある"],["ので"],["、"],["あなた"],["は"],["これ"],["まで"],["わたし"],["を"],["導かれた","みちびかれた"],["の"],["です"],["か"],["。"]]},{"verse":19,"text":"主,しゅなる神,かみよ、これはなおあなたの目,めには小,ちいさい事,ことです。主,しゅなる神,かみよ、あなたはまたしもべの家,いえの、はるか後,のちの事,ことを語,かたって、きたるべき代々,よよのことを示,しめされました。","tok":[["主","しゅ"],["なる"],["神","かみ"],["よ"],["、"],["これ"],["は"],["なお"],["あなた"],["の"],["目","め"],["に"],["は"],["小さい","ちいさい"],["事","こと"],["です"],["。"],["主","しゅ"],["なる"],["神","かみ"],["よ"],["、"],["あなた"],["は"],["また"],["しもべ"],["の"],["家","いえ"],["の"],["、"],["はるか"],["後","のち"],["の"],["事","こと"],["を"],["語って","かたって"],["、"],["きたるべき"],["代々","よよ"],["の"],["こと"],["を"],["示めされました","しめされました"],["。"]]},{"verse":20,"text":"ダビデはこの上,うえなにをあなたに申,もうしあげることができましょう。主,しゅなる神,かみよ、あなたはしもべを知,しっておられるのです。","tok":[["ダビデ"],["は"],["この"],["上","うえ"],["なに"],["を"],["あなた"],["に"],["申しあげる","もうしあげる"],["こと"],["が"],["できましょう"],["。"],["主","しゅ"],["なる"],["神","かみ"],["よ"],["、"],["あなた"],["は"],["しもべ"],["を"],["知って","しって"],["おられる"],["の"],["です"],["。"]]},{"verse":21,"text":"あなたの約束,やくそくのゆえに、またあなたの心,こころに従,したがって、あなたはこのもろもろの大,おおいなる事,ことを行,おこない、しもべにそれを知,しらせられました。","tok":[["あなた"],["の"],["約束","やくそく"],["の"],["ゆえ"],["に"],["、"],["また"],["あなた"],["の"],["心","こころ"],["に"],["従って","したがって"],["、"],["あなた"],["は"],["この"],["もろもろ"],["の"],["大いなる","おおいなる"],["事","こと"],["を"],["行ない","おこない"],["、"],["しもべ"],["に"],["それ"],["を"],["知らせられました","しらせられました"],["。"]]},{"verse":22,"text":"主,しゅなる神,かみよ、あなたは偉大,いだいです。それは、われわれがすべて耳,みみに聞,きいたところによれば、あなたのような者,ものはなく、またあなたのほかに神,かみはないからです。","tok":[["主","しゅ"],["なる"],["神","かみ"],["よ"],["、"],["あなた"],["は"],["偉大","いだい"],["です"],["。"],["それ"],["は"],["、"],["われわれ"],["が"],["すべて"],["耳","みみ"],["に"],["聞いた","きいた"],["ところ"],["に"],["よれば"],["、"],["あなた"],["の"],["よう"],["な"],["者","もの"],["は"],["なく"],["、"],["また"],["あなた"],["の"],["ほか"],["に"],["神","かみ"],["は"],["ない"],["から"],["です"],["。"]]},{"verse":23,"text":"地,ちのどの国民,こくみんが、あなたの民,たみイスラエルのようでありましょうか。これは神,かみが行,いって、自分,じぶんのためにあがなって民,たみとし、自,みずからの名,なをあげられたもの、また彼,かれらのために大,おおいなる恐,おそるべきことをなし、その民,たみの前,まえから国,くにびととその神々,かみがみとを追,おい出,だされたものです。","tok":[["地","ち"],["の"],["どの"],["国民","こくみん"],["が"],["、"],["あなた"],["の"],["民","たみ"],["イスラエル"],["の"],["よう"],["で"],["ありましょう"],["か"],["。"],["これ"],["は"],["神","かみ"],["が"],["行って","いって"],["、"],["自分","じぶん"],["の"],["ため"],["に"],["あがなって"],["民","た"],["み"],["と"],["し"],["、"],["自から","みずから"],["の"],["名","な"],["を"],["あげられた"],["もの"],["、"],["また"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["大いなる","おおいなる"],["恐るべき","おそるべき"],["こと"],["を"],["なし"],["、"],["その"],["民","たみ"],["の"],["前","まえ"],["から"],["国びと","くにびと"],["と"],["その"],["神々","かみがみ"],["と"],["を"],["追い出された","おいだされた"],["もの"],["です"],["。"]]},{"verse":24,"text":"そしてあなたの民,たみイスラエルを永遠,えいえんにあなたの民,たみとして、自分,じぶんのために、定,さだめられました。主,しゅよ、あなたは彼,かれらの神,かみとなられたのです。","tok":[["そして"],["あなた"],["の"],["民","たみ"],["イスラエル"],["を"],["永遠","えいえん"],["に"],["あなた"],["の"],["民","たみ"],["として"],["、"],["自分","じぶん"],["の"],["ため"],["に"],["、"],["定められました","さだめられました"],["。"],["主","しゅ"],["よ"],["、"],["あなた"],["は"],["彼","かれ"],["ら"],["の"],["神","かみ"],["と"],["なられた"],["の"],["です"],["。"]]},{"verse":25,"text":"主,しゅなる神,かみよ、今,いまあなたが、しもべとしもべの家,いえとについて語,かたられた言葉,ことばを長,ながく堅,かとうして、あなたの言,いわれたとおりにしてください。","tok":[["主","しゅ"],["なる"],["神","かみ"],["よ"],["、"],["今","いま"],["あなた"],["が"],["、"],["しもべ"],["と"],["しもべ"],["の"],["家","いえ"],["と"],["について"],["語られた","かたられた"],["言葉","ことば"],["を"],["長く","ながく"],["堅う","かとう"],["して"],["、"],["あなた"],["の"],["言われた","いわれた"],["とおり"],["に"],["して"],["ください"],["。"]]},{"verse":26,"text":"そうすれば、あなたの名,なはとこしえにあがめられて、『万軍,ばんぐんの主,しゅはイスラエルの神,かみである』と言,いわれ、あなたのしもべダビデの家,いえは、あなたの前,まえに堅,かたく立,たつことができましょう。","tok":[["そう"],["すれば"],["、"],["あなた"],["の"],["名","な"],["は"],["とこしえ"],["に"],["あがめられて"],["、"],["『"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["イスラエル"],["の"],["神","かみ"],["で"],["ある"],["』"],["と"],["言われ","いわれ"],["、"],["あなた"],["の"],["しもべ"],["ダビデ"],["の"],["家","いえ"],["は"],["、"],["あなた"],["の"],["前","まえ"],["に"],["堅く","かたく"],["立つ","たつ"],["こと"],["が"],["できましょう"],["。"]]},{"verse":27,"text":"万軍,ばんぐんの主,しゅ、イスラエルの神,かみよ、あなたはしもべに示,しめして、『おまえのために家,いえを建,たてよう』と言,いわれました。それゆえ、しもべはこの祈,いのりをあなたにささげる勇気,ゆうきを得,えたのです。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["、"],["イスラエル"],["の"],["神","かみ"],["よ"],["、"],["あなた"],["は"],["しもべ"],["に"],["示めして","しめして"],["、"],["『"],["おまえ"],["の"],["ため"],["に"],["家","いえ"],["を"],["建てよう","たてよう"],["』"],["と"],["言われました","いわれました"],["。"],["それ"],["ゆえ"],["、"],["しもべ"],["は"],["この"],["祈","いのり"],["を"],["あなた"],["に"],["ささげる"],["勇気","ゆうき"],["を"],["得た","えた"],["の"],["です"],["。"]]},{"verse":28,"text":"主,しゅなる神,かみよ、あなたは神,かみにましまし、あなたの言葉,ことばは真実,しんじつです。あなたはこの良,よき事,ことをしもべに約束,やくそくされました。","tok":[["主","しゅ"],["なる"],["神","かみ"],["よ"],["、"],["あなた"],["は"],["神","かみ"],["に"],["ましまし"],["、"],["あなた"],["の"],["言葉","ことば"],["は"],["真実","しんじつ"],["です"],["。"],["あなた"],["は"],["この"],["良き","よき"],["事","こと"],["を"],["しもべ"],["に"],["約束","やくそく"],["されました"],["。"]]},{"verse":29,"text":"どうぞ今,いま、しもべの家,いえを祝福,しゅくふくし、あなたの前,まえに長,ながくつづかせてくださるように。主,しゅなる神,かみよ、あなたがそれを言,いわれたのです。どうぞあなたの祝福,しゅくふくによって、しもべの家,いえがながく祝福,しゅくふくされますように」。","tok":[["どうぞ"],["今","いま"],["、"],["しもべ"],["の"],["家","いえ"],["を"],["祝福","しゅくふく"],["し"],["、"],["あなた"],["の"],["前","まえ"],["に"],["長く","ながく"],["つづかせて"],["くださる"],["よう"],["に"],["。"],["主","しゅ"],["なる"],["神","かみ"],["よ"],["、"],["あなた"],["が"],["それ"],["を"],["言われた","いわれた"],["の"],["です"],["。"],["どうぞ"],["あなた"],["の"],["祝福","しゅくふく"],["によって"],["、"],["しもべ"],["の"],["家","いえ"],["が"],["ながく"],["祝福","しゅくふく"],["されます"],["よう"],["に"],["」"],["。"]]}]
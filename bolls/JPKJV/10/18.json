[{"verse":1,"text":"さてダビデは自分,じぶんと共,ともにいる民,たみを調,しらべて、その上,うえに千人,にんの長,ちょう、百人,にんの長,ちょうを立,たてた。","tok":[["さて"],["ダビデ"],["は"],["自分","じぶん"],["と"],["共","とも"],["に"],["いる"],["民","たみ"],["を"],["調べて","しらべて"],["、"],["その"],["上","うえ"],["に"],["千人","にん"],["の"],["長う","ちょう"],["、"],["百人","にん"],["の"],["長","ちょう"],["を"],["立てた","たてた"],["。"]]},{"verse":2,"text":"そしてダビデは民,たみをつかわし、三分,ぶんの一をヨアブの手,てに、三分,ぶんの一をゼルヤの子,こヨアブの兄弟,きょうだいアビシャイの手,てに、三分,ぶんの一をガテびとイッタイの手,てにあずけた。こうして王,おうは民,たみに言,いった、「わたしもまた必,かならずあなたがたと一緒,いっしょに出,でます」。","tok":[["そして"],["ダビデ"],["は"],["民","たみ"],["を"],["つかわし"],["、"],["三分","ぶん"],["の"],["一","いち"],["を"],["ヨアブ"],["の"],["手","て"],["に"],["、"],["三分","ぶん"],["の"],["一","いち"],["を"],["ゼルヤ"],["の"],["子","こ"],["ヨアブ"],["の"],["兄弟","きょうだい"],["アビシャイ"],["の"],["手","て"],["に"],["、"],["三分","ぶん"],["の"],["一","いち"],["を"],["ガテ"],["びと"],["イッタイ"],["の"],["手","て"],["に"],["あずけた"],["。"],["こう"],["して"],["王","おう"],["は"],["民","たみ"],["に"],["言った","いった"],["、"],["「"],["わたし"],["も"],["また"],["必","かならず"],["あなた"],["がた"],["と"],["一緒","いっしょ"],["に"],["出ます","でます"],["」"],["。"]]},{"verse":3,"text":"しかし民,たみは言,いった、「あなたは出,でてはなりません。それはわれわれがどんなに逃,にげても、彼,かれらはわれわれに心,こころをとめず、われわれの半,なかばが死,しんでも、われわれに心,こころをとめないからです。しかしあなたはわれわれの一万に等,ひとしいのです。それゆえあなたは町,まちの中,なかからわれわれを助,たすけてくださる方,ほうがよろしい」。","tok":[["しかし"],["民","たみ"],["は"],["言った","いった"],["、"],["「"],["あなた"],["は"],["出て","でて"],["は"],["なりません"],["。"],["それ"],["は"],["われわれ"],["が"],["どんな"],["に"],["逃て","にげて"],["も"],["、"],["彼","かれ"],["ら"],["は"],["われわれ"],["に"],["心","こころ"],["を"],["とめず"],["、"],["われわれ"],["の"],["半ば","なかば"],["が"],["死んで","しんで"],["も"],["、"],["われわれ"],["に"],["心","こころ"],["を"],["とめない"],["から"],["です"],["。"],["しかし"],["あなた"],["は"],["われわれ"],["の"],["一万","いちまん"],["に"],["等い","ひとしい"],["の"],["です"],["。"],["それ"],["ゆえ"],["あなた"],["は"],["町","まち"],["の"],["中","なか"],["から"],["われわれ"],["を"],["助けて","たすけて"],["くださる"],["方","ほう"],["が"],["よろしい"],["」"],["。"]]},{"verse":4,"text":"王,おうは彼,かれらに言,いった、「あなたがたの最,もっとも良,よいと思,おもうことをわたしはしましょう」。こうして王,おうは門,もんのかたわらに立,たち、民,たみは皆,みなあるいは百人,にん、あるいは千人,にんとなって出,でて行,いった。","tok":[["王","おう"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["の"],["最も","もっとも"],["良い","よい"],["と"],["思う","おもう"],["こと"],["を"],["わたし"],["は"],["しましょう"],["」"],["。"],["こう"],["して"],["王","おう"],["は"],["門","もん"],["の"],["かたわら"],["に"],["立ち","たち"],["、"],["民","たみ"],["は"],["皆","みな"],["あるいは"],["百人","にん"],["、"],["あるいは"],["千人","にん"],["と"],["なって"],["出て","でて"],["行った","いった"],["。"]]},{"verse":5,"text":"王,おうはヨアブ、アビシャイおよびイッタイに命,めいじて、「わたしのため、若者,わかものアブサロムをおだやかに扱,あつかうように」と言,いった。王,おうがアブサロムの事,ことについてすべての長,ちょうたちに命,めいじている時,とき、民,たみは皆,みな聞,きいていた。","tok":[["王","おう"],["は"],["ヨアブ"],["、"],["アビシャイ"],["および"],["イッタイ"],["に"],["命じて","めいじて"],["、"],["「"],["わたし"],["の"],["ため"],["、"],["若者","わかもの"],["アブサロム"],["を"],["おだやか"],["に"],["扱う","あつかう"],["よう"],["に"],["」"],["と"],["言った","いった"],["。"],["王","おう"],["が"],["アブサロム"],["の"],["事","こと"],["について"],["すべて"],["の"],["長","ちょう"],["たち"],["に"],["命じて","めいじて"],["いる"],["時","とき"],["、"],["民","たみ"],["は"],["皆","みな"],["聞いて","きいて"],["いた"],["。"]]},{"verse":6,"text":"こうして民,たみはイスラエルに向,むかって野,のに出,でて行,いき、エフライムの森,もりで戦,たたかったが、","tok":[["こう"],["して"],["民","たみ"],["は"],["イスラエル"],["に"],["向かって","むかって"],["野","の"],["に"],["出て","でて"],["行き","いき"],["、"],["エフライム"],["の"],["森","もり"],["で"],["戦った","たたかった"],["が"],["、"]]},{"verse":7,"text":"イスラエルの民,たみはその所,ところでダビデの家来,けらいたちの前,まえに敗,やぶれた。その日,ひその所,ところに戦死者,せんししゃが多,おおく、二万に及,およんだ。","tok":[["イスラエル"],["の"],["民","たみ"],["は"],["その"],["所","ところ"],["で"],["ダビデ"],["の"],["家来","けらい"],["たち"],["の"],["前","まえ"],["に"],["敗れた","やぶれた"],["。"],["その"],["日","ひ"],["その"],["所","ところ"],["に"],["戦死者","せんししゃ"],["が"],["多く","おおく"],["、"],["二万","にまん"],["に"],["及んだ","およんだ"],["。"]]},{"verse":8,"text":"そして戦,たたかいはあまねくその地,ちのおもてに広,ひろがった。この日,ひ、森,もりの滅,ほろぼした者,ものは、つるぎの滅,ほろぼした者,ものよりも多,おおかった。","tok":[["そして"],["戦い","たたかい"],["は"],["あまねく"],["その"],["地","ち"],["の"],["おもて"],["に"],["広がった","ひろがった"],["。"],["この"],["日","ひ"],["、"],["森","もり"],["の"],["滅ぼした","ほろぼした"],["者","もの"],["は"],["、"],["つるぎ"],["の"],["滅ぼした","ほろぼした"],["者","もの"],["より"],["も"],["多かった","おおかった"],["。"]]},{"verse":9,"text":"さてアブサロムはダビデの家来,けらいたちに行,いき会,あった。その時,ときアブサロムは騾馬,らばに乗,のっていたが、騾馬,らばは大,おおきいかしの木,きの、茂,しげった枝,えだの下,したを通,とおったので、アブサロムの頭,あたまがそのかしの木,きにかかって、彼,かれは天地,てんちの間,あいだにつりさがった。騾馬,らばは彼,かれを捨,すてて過,すぎて行,いった。","tok":[["さて"],["アブサロム"],["は"],["ダビデ"],["の"],["家来","けらい"],["たち"],["に"],["行き会った","いきあった"],["。"],["その"],["時","とき"],["アブサロム"],["は"],["騾馬","らば"],["に"],["乗って","のって"],["いた"],["が"],["、"],["騾馬","らば"],["は"],["大きい","おおきい"],["かし"],["の"],["木","き"],["の"],["、"],["茂った","しげった"],["枝","えだ"],["の"],["下","した"],["を"],["通った","とおった"],["ので"],["、"],["アブサロム"],["の"],["頭","あたま"],["が"],["その"],["かし"],["の"],["木","き"],["に"],["かかって"],["、"],["彼","かれ"],["は"],["天地","てんち"],["の"],["間","あいだ"],["に"],["つりさがった"],["。"],["騾馬","らば"],["は"],["彼","かれ"],["を"],["捨てて","すてて"],["過て","すぎて"],["行った","いった"],["。"]]},{"verse":10,"text":"ひとりの人,ひとがそれを見,みてヨアブに告,つげて言,いった、「わたしはアブサロムが、かしの木,きにかかっているのを見,みました」。","tok":[["ひとり"],["の"],["人","ひと"],["が"],["それ"],["を"],["見て","みて"],["ヨアブ"],["に"],["告","つげ"],["て"],["言った","いった"],["、"],["「"],["わたし"],["は"],["アブサロム"],["が"],["、"],["かし"],["の"],["木","き"],["に"],["かかって"],["いる"],["の"],["を"],["見ました","みました"],["」"],["。"]]},{"verse":11,"text":"ヨアブはそれを告,つげた人,ひとに言,いった、「あなたはそれを見,みたというのか。それなら、どうしてあなたは彼,かれをその所,ところで、地,ちに撃,うち落,おとさなかったのか。わたしはあなたに銀,ぎん十シケルと帯,おび一筋,すじを与,あたえたであろうに」。","tok":[["ヨアブ"],["は"],["それ"],["を"],["告","つげ"],["た"],["人","ひと"],["に"],["言った","いった"],["、"],["「"],["あなた"],["は"],["それ"],["を"],["見た","みた"],["と"],["いう"],["の"],["か"],["。"],["それ"],["なら"],["、"],["どう"],["して"],["あなた"],["は"],["彼","かれ"],["を"],["その"],["所","ところ"],["で"],["、"],["地","ち"],["に"],["撃ち落とさなかった","うちおとさなかった"],["の"],["か"],["。"],["わたし"],["は"],["あなた"],["に"],["銀","ぎん"],["十","じゅう"],["シケル"],["と"],["帯","おび"],["一筋","すじ"],["を"],["与","あたえ"],["たで"],["あろう"],["に"],["」"],["。"]]},{"verse":12,"text":"その人,ひとはヨアブに言,いった、「たといわたしの手,てに銀,ぎん千シケルを受,うけても、手,てを出,だして王,おうの子,こに敵,てきすることはしません。王,おうはわれわれが聞,きいているところで、あなたとアビシャイとイッタイに、『わたしのため若者,わかものアブサロムを保護,ほごせよ』と命,めいじられたからです。","tok":[["その"],["人","ひと"],["は"],["ヨアブ"],["に"],["言った","いった"],["、"],["「"],["たとい"],["わたし"],["の"],["手","て"],["に"],["銀","ぎん"],["千","せん"],["シケル"],["を"],["受て","うけて"],["も"],["、"],["手","て"],["を"],["出して","だして"],["王","おう"],["の"],["子","こ"],["に"],["敵する","てきする"],["こと"],["は"],["しません"],["。"],["王","おう"],["は"],["われわれ"],["が"],["聞いて","きいて"],["いる"],["ところ"],["で"],["、"],["あなた"],["と"],["アビシャイ"],["と"],["イッタイ"],["に"],["、"],["『"],["わたし"],["の"],["ため"],["若者","わかもの"],["アブサロム"],["を"],["保護","ほご"],["せよ"],["』"],["と"],["命じられた","めいじられた"],["から"],["です"],["。"]]},{"verse":13,"text":"もしわたしがそむいて彼,かれの命,いのちをそこなったのであれば、何事,なにごとも王,おうに隠,かくれることはありませんから、あなたはみずから立,たってわたしを責,せめられたでしょう」。","tok":[["もし"],["わたし"],["が"],["そむいて"],["彼","かれ"],["の"],["命","いのち"],["を"],["そこなった"],["ので"],["あれば"],["、"],["何事","なにごと"],["も"],["王","おう"],["に"],["隠れる","かくれる"],["こと"],["は"],["ありません"],["から"],["、"],["あなた"],["は"],["みずから"],["立って","たって"],["わたし"],["を"],["責","せめ"],["られたでしょう"],["」"],["。"]]},{"verse":14,"text":"そこで、ヨアブは「こうしてあなたと共,ともにとどまってはおられない」と言,いって、手,てに三筋,すじの投,なげやりを取,とり、あのかしの木,きにかかって、なお生,いきているアブサロムの心臓,しんぞうにこれを突,つき通,とおした。","tok":[["そこ"],["で"],["、"],["ヨアブ"],["は"],["「"],["こう"],["して"],["あなた"],["と"],["共","とも"],["に"],["とどまって"],["は"],["おられない"],["」"],["と"],["言って","いって"],["、"],["手","て"],["に"],["三筋","すじ"],["の"],["投","なげ"],["やり"],["を"],["取","とり"],["、"],["あの"],["かし"],["の"],["木","き"],["に"],["かかって"],["、"],["なお"],["生きて","いきて"],["いる"],["アブサロム"],["の"],["心臓","しんぞう"],["に"],["これ"],["を"],["突き通した","つきとおした"],["。"]]},{"verse":15,"text":"ヨアブの武器,ぶきを執,とる十人,にんの若者,わかものたちは取,とり巻,まいて、アブサロムを撃,うち殺,ころした。","tok":[["ヨアブ"],["の"],["武器","ぶき"],["を"],["執る","とる"],["十人","にん"],["の"],["若者","わかもの"],["たち"],["は"],["取巻いて","とりまいて"],["、"],["アブサロム"],["を"],["撃ち殺した","うちころした"],["。"]]},{"verse":16,"text":"こうしてヨアブがラッパを吹,ふいたので、民,たみはイスラエルのあとを追,おうことをやめて帰,かえった。ヨアブが民,たみを引,ひきとめたからである。","tok":[["こう"],["して"],["ヨアブ"],["が"],["ラッパ"],["を"],["吹いた","ふいた"],["ので"],["、"],["民","たみ"],["は"],["イスラエル"],["の"],["あと"],["を"],["追う","おう"],["こと"],["を"],["やめて"],["帰えった","かえった"],["。"],["ヨアブ"],["が"],["民","たみ"],["を"],["引","ひき"],["とめた"],["から"],["で"],["ある"],["。"]]},{"verse":17,"text":"人々,ひとびとはアブサロムを取,とって、森,もりの中,なかの大,おおきな穴,あなに投,なげいれ、その上,うえにひじょうに大,おおきい石塚,いしづかを積,つみ上,あげた。そしてイスラエルはみなおのおのその天幕,てんまくに逃,にげ帰,かえった。","tok":[["人々","ひとびと"],["は"],["アブサロム"],["を"],["取って","とって"],["、"],["森","もり"],["の"],["中","なか"],["の"],["大きな","おおきな"],["穴","あな"],["に"],["投","なげ"],["いれ"],["、"],["その"],["上","うえ"],["に"],["ひじょう"],["に"],["大きい","おおきい"],["石塚","いしづか"],["を"],["積み上げた","つみあげた"],["。"],["そして"],["イスラエル"],["は"],["みな"],["おのおの"],["その"],["天幕","てんまく"],["に"],["逃","にげ"],["帰えった","かえった"],["。"]]},{"verse":18,"text":"さてアブサロムは生,いきている間,あいだに、王,おうの谷,たにに自分,じぶんのために一つの柱,はしらを建,たてた。それは彼,かれが、「わたしは自分,じぶんの名,なを伝,つたえる子,こがない」と思,おもったからである。彼,かれはその柱,はしらに自分,じぶんの名,なをつけた。その柱,はしらは今日,こんにちまでアブサロムの碑,いしぶみととなえられている。","tok":[["さて"],["アブサロム"],["は"],["生きて","いきて"],["いる"],["間","あいだ"],["に"],["、"],["王","おう"],["の"],["谷","たに"],["に"],["自分","じぶん"],["の"],["ため"],["に"],["一","ひと"],["つ"],["の"],["柱","はしら"],["を"],["建てた","たてた"],["。"],["それ"],["は"],["彼","かれ"],["が"],["、"],["「"],["わたし"],["は"],["自分","じぶん"],["の"],["名","な"],["を"],["伝える","つたえる"],["子","こ"],["が"],["ない"],["」"],["と"],["思った","おもった"],["から"],["で"],["ある"],["。"],["彼","かれ"],["は"],["その"],["柱","はしら"],["に"],["自分","じぶん"],["の"],["名","な"],["を"],["つけた"],["。"],["その"],["柱","はしら"],["は"],["今日","こん"],["に"],["ち"],["まで"],["アブサロム"],["の"],["碑","いしぶみ"],["と"],["となえられて"],["いる"],["。"]]},{"verse":19,"text":"さてザドクの子,こアヒマアズは言,いった、「わたしは走,はしって行,いって、主,しゅが王,おうを敵,てきの手,てから救,すくい出,だされたおとずれを王,おうに伝,つたえましょう」。","tok":[["さて"],["ザドク"],["の"],["子","こ"],["アヒマアズ"],["は"],["言った","いった"],["、"],["「"],["わたし"],["は"],["走って","はしって"],["行って","いって"],["、"],["主","しゅ"],["が"],["王","おう"],["を"],["敵","てき"],["の"],["手","て"],["から"],["救い出された","すくいだされた"],["おとずれ"],["を"],["王","おう"],["に"],["伝えましょう","つたえましょう"],["」"],["。"]]},{"verse":20,"text":"ヨアブは彼,かれに言,いった、「きょうは、おとずれを伝,つたえてはならない。おとずれを伝,つたえるのは、ほかの日,ひにしなさい。きょうは王,おうの子,こが死,しんだので、おとずれを伝,つたえてはならない」。","tok":[["ヨアブ"],["は"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["きょう"],["は"],["、"],["おとずれ"],["を"],["伝えて","つたえて"],["は"],["ならない"],["。"],["おとずれ"],["を"],["伝える","つたえる"],["の"],["は"],["、"],["ほか"],["の"],["日","ひ"],["に"],["し"],["なさい"],["。"],["きょう"],["は"],["王","おう"],["の"],["子","こ"],["が"],["死んだ","しんだ"],["ので"],["、"],["おとずれ"],["を"],["伝えて","つたえて"],["は"],["ならない"],["」"],["。"]]},{"verse":21,"text":"ヨアブはクシびとに言,いった、「行,いって、あなたの見,みた事,ことを王,おうに告,つげなさい」。クシびとはヨアブに礼,れいをして走,はしって行,いった。","tok":[["ヨアブ"],["は"],["クシ"],["びと"],["に"],["言った","いった"],["、"],["「"],["行って","いって"],["、"],["あなた"],["の"],["見た","みた"],["事","こと"],["を"],["王","おう"],["に"],["告","つげ"],["なさい"],["」"],["。"],["クシ"],["び"],["と"],["は"],["ヨアブ"],["に"],["礼","れい"],["を"],["して"],["走って","はしって"],["行った","いった"],["。"]]},{"verse":22,"text":"ザドクの子,こアヒマアズは重,かさねてヨアブに言,いった、「何事,なにごとがあろうとも、わたしにもクシびとのあとから走,はしって行,いかせてください」。ヨアブは言,いった、「子,こよ、おとずれの報,むくいを得,えられないのに、どうしてあなたは走,はしって行,いこうとするのか」。","tok":[["ザドク"],["の"],["子","こ"],["アヒマアズ"],["は"],["重ねて","かさねて"],["ヨアブ"],["に"],["言った","いった"],["、"],["「"],["何事","なにごと"],["が"],["あろう"],["とも"],["、"],["わたし"],["に"],["も"],["クシ"],["びと"],["の"],["あと"],["から"],["走って","はしって"],["行かせて","いかせて"],["ください"],["」"],["。"],["ヨアブ"],["は"],["言った","いった"],["、"],["「"],["子","こ"],["よ"],["、"],["おとずれ"],["の"],["報い","むくい"],["を"],["得られない","えられない"],["のに"],["、"],["どう"],["して"],["あなた"],["は"],["走って","はしって"],["行こう","いこう"],["と"],["する"],["の"],["か"],["」"],["。"]]},{"verse":23,"text":"彼,かれは言,いった、「何事,なにごとがあろうとも、わたしは走,はしって行,いきます」。ヨアブは彼,かれに言,いった、「走,はしって行,いきなさい」。そこでアヒマアズは低地,ていちの道,みちを走,はしって行,いき、クシびとを追,おい越,こした。","tok":[["彼","かれ"],["は"],["言った","いった"],["、"],["「"],["何事","なにごと"],["が"],["あろう"],["とも"],["、"],["わたし"],["は"],["走って","はしって"],["行きます","いきます"],["」"],["。"],["ヨアブ"],["は"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["走って","はしって"],["行き","いき"],["なさい"],["」"],["。"],["そこ"],["で"],["アヒマアズ"],["は"],["低地","ていち"],["の"],["道","みち"],["を"],["走って","はしって"],["行き","いき"],["、"],["クシ"],["びと"],["を"],["追い","おい"],["越","こし"],["た"],["。"]]},{"verse":24,"text":"時,ときにダビデは二つの門,もんの間,あいだにすわっていた。そして見張,みはりの者,ものが城壁,じょうへきの門,もんの屋根,やねにのぼり、目,めをあげて見,みていると、ただひとりで走,はしってくる者,ものがあった。","tok":[["時","とき"],["に"],["ダビデ"],["は"],["二","ふた"],["つ"],["の"],["門","もん"],["の"],["間","あいだ"],["に"],["すわって"],["いた"],["。"],["そして"],["見張","みはり"],["の"],["者","もの"],["が"],["城壁","じょうへき"],["の"],["門","もん"],["の"],["屋根","やね"],["に"],["のぼり"],["、"],["目","め"],["を"],["あげて"],["見て","みて"],["いる"],["と"],["、"],["ただ"],["ひとり"],["で"],["走って","はしって"],["くる"],["者","もの"],["が"],["あった"],["。"]]},{"verse":25,"text":"見張,みはりの者,ものが呼,よばわって王,おうに告,つげたので、王,おうは言,いった、「もしひとりならば、その口,くちにおとずれがあるであろう」。その人,ひとは急,いそいできて近,ちかづいた。","tok":[["見張","みはり"],["の"],["者","もの"],["が"],["呼ばわって","よばわって"],["王","おう"],["に"],["告","つげ"],["た"],["ので"],["、"],["王","おう"],["は"],["言った","いった"],["、"],["「"],["もし"],["ひとり"],["ならば"],["、"],["その"],["口","くち"],["に"],["おとずれ"],["が"],["あるで"],["あろう"],["」"],["。"],["その"],["人","ひと"],["は"],["急いで","いそいで"],["きて"],["近づいた","ちかづいた"],["。"]]},{"verse":26,"text":"見張,みはりの者,ものは、ほかにまたひとり走,はしってくるのを見,みたので、門,もんの方,ほうに呼,よばわって言,いった、「見,みよ、ほかにただひとりで走,はしって来,くる者,ものがあります」。王,おうは言,いった、「彼,かれもまたおとずれを持,もってくるのだ」。","tok":[["見張","みはり"],["の"],["者","もの"],["は"],["、"],["ほか"],["に"],["また"],["ひとり"],["走って","はしって"],["くる"],["の"],["を"],["見た","みた"],["ので"],["、"],["門","もん"],["の"],["方","ほう"],["に"],["呼ばわって","よばわって"],["言った","いった"],["、"],["「"],["見よ","みよ"],["、"],["ほか"],["に"],["ただ"],["ひとり"],["で"],["走って","はしって"],["来る","くる"],["者","もの"],["が"],["あります"],["」"],["。"],["王","おう"],["は"],["言った","いった"],["、"],["「"],["彼","かれ"],["も"],["また"],["おとずれ"],["を"],["持って","もって"],["くる"],["の"],["だ"],["」"],["。"]]},{"verse":27,"text":"見張,みはりの者,ものは言,いった、「まっ先,さきに走,はしって来,くる人,ひとはザドクの子,こアヒマアズのようです」。王,おうは言,いった、「彼,かれは良,よい人,ひとだ。良,よいおとずれを持,もってくるであろう」。","tok":[["見張","みはり"],["の"],["者","もの"],["は"],["言った","いった"],["、"],["「"],["まっ先","まっさき"],["に"],["走って","はしって"],["来る","くる"],["人","ひと"],["は"],["ザドク"],["の"],["子","こ"],["アヒマアズ"],["の"],["よう"],["です"],["」"],["。"],["王","おう"],["は"],["言った","いった"],["、"],["「"],["彼","かれ"],["は"],["良い","よい"],["人","ひと"],["だ"],["。"],["良い","よい"],["おとずれ"],["を"],["持って","もって"],["くるで"],["あろう"],["」"],["。"]]},{"verse":28,"text":"時,ときにアヒマアズは呼,よばわって王,おうに言,いった、「平安,へいあんでいらせられますように」。そして王,おうの前,まえに地,ちにひれ伏,ふして言,いった、「あなたの神,かみ、主,しゅはほむべきかな。主,しゅは王,おう、わが君,きみに敵,てきして手,てをあげた人々,ひとびとを引,ひき渡,わたされました」。","tok":[["時","とき"],["に"],["アヒマアズ"],["は"],["呼ばわって","よばわって"],["王","おう"],["に"],["言った","いった"],["、"],["「"],["平安","へいあん"],["で"],["いらせられます"],["よう"],["に"],["」"],["。"],["そして"],["王","おう"],["の"],["前","まえ"],["に"],["地","ち"],["に"],["ひれ伏して","ひれふして"],["言った","いった"],["、"],["「"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["ほ"],["むべき"],["か"],["な"],["。"],["主","しゅ"],["は"],["王","おう"],["、"],["わが"],["君","きみ"],["に"],["敵して","てきして"],["手","て"],["を"],["あげた"],["人々","ひとびと"],["を"],["引渡されました","ひきわたされました"],["」"],["。"]]},{"verse":29,"text":"王,おうは言,いった、「若者,わかものアブサロムは平安,へいあんですか」。アヒマアズは答,こたえた、「ヨアブがしもべをつかわす時,とき、わたしは大,おおきな騒,さわぎを見,みましたが、何事,なにごとであったか知,しりません」。","tok":[["王","おう"],["は"],["言った","いった"],["、"],["「"],["若者","わかもの"],["アブサロム"],["は"],["平安","へいあん"],["です"],["か"],["」"],["。"],["アヒマアズ"],["は"],["答","こたえ"],["た"],["、"],["「"],["ヨアブ"],["が"],["しもべ"],["を"],["つかわす"],["時","とき"],["、"],["わたし"],["は"],["大きな","おおきな"],["騒","さわぎ"],["を"],["見ました","みました"],["が"],["、"],["何事","なにごと"],["で"],["あった"],["か"],["知りません","しりません"],["」"],["。"]]},{"verse":30,"text":"王,おうは言,いった、「わきへ行,いって、そこに立,たっていなさい」。彼,かれはわきへ行,いって立,たった。","tok":[["王","おう"],["は"],["言った","いった"],["、"],["「"],["わき"],["へ"],["行って","いって"],["、"],["そこ"],["に"],["立って","たって"],["い"],["なさい"],["」"],["。"],["彼","かれ"],["は"],["わき"],["へ"],["行って","いって"],["立った","たった"],["。"]]},{"verse":31,"text":"その時,ときクシびとがきた。そしてそのクシびとは言,いった、「わが君,きみ、王,おうが良,よいおとずれをお受,うけくださるよう。主,しゅはきょう、すべてあなたに敵,てきして立,たった者,ものどもの手,てから、あなたを救,すくい出,だされたのです」。","tok":[["その"],["時","とき"],["クシ"],["びと"],["が"],["きた"],["。"],["そして"],["その"],["クシ"],["び"],["と"],["は"],["言った","いった"],["、"],["「"],["わが"],["君","きみ"],["、"],["王","おう"],["が"],["良い","よい"],["おとずれ"],["を"],["お受","おうけ"],["くださる"],["よう"],["。"],["主","しゅ"],["は"],["きょう"],["、"],["すべて"],["あなた"],["に"],["敵して","てきして"],["立った","たった"],["者","もの"],["ども"],["の"],["手","て"],["から"],["、"],["あなた"],["を"],["救い出された","すくいだされた"],["の"],["です"],["」"],["。"]]},{"verse":32,"text":"王,おうはクシびとに言,いった、「若者,わかものアブサロムは平安,へいあんですか」。クシびとは答,こたえた、「王,おう、わが君,きみの敵,てき、およびすべてあなたに敵,てきして立,たち、害,がいをしようとする者,ものは、あの若者,わかもののようになりますように」。","tok":[["王","おう"],["は"],["クシ"],["びと"],["に"],["言った","いった"],["、"],["「"],["若者","わかもの"],["アブサロム"],["は"],["平安","へいあん"],["です"],["か"],["」"],["。"],["クシ"],["び"],["と"],["は"],["答","こたえ"],["た"],["、"],["「"],["王","おう"],["、"],["わが"],["君","きみ"],["の"],["敵","てき"],["、"],["および"],["すべて"],["あなた"],["に"],["敵して","てきして"],["立ち","たち"],["、"],["害","がい"],["を"],["しよう"],["と"],["する"],["者","もの"],["は"],["、"],["あの"],["若者","わかもの"],["の"],["よう"],["に"],["なります"],["よう"],["に"],["」"],["。"]]}]
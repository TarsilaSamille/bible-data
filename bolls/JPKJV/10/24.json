[{"verse":1,"text":"主,しゅは再,ふたたびイスラエルに向,むかって怒,いかりを発,はっし、ダビデを感動,かんどうして彼,かれらに逆,さからわせ、「行,いってイスラエルとユダとを数,かぞえよ」と言,いわれた。","tok":[["主","しゅ"],["は"],["再び","ふたたび"],["イスラエル"],["に"],["向かって","むかって"],["怒り","いかり"],["を"],["発し","はっし"],["、"],["ダビデ"],["を"],["感動","かんどう"],["して"],["彼","かれ"],["ら"],["に"],["逆らわせ","さからわせ"],["、"],["「"],["行って","いって"],["イスラエル"],["と"],["ユダ"],["と"],["を"],["数えよ","かぞえよ"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":2,"text":"そこで王,おうはヨアブおよびヨアブと共,ともにいる軍,ぐんの長,ちょうたちに言,いった、「イスラエルのすべての部族,ぶぞくのうちを、ダンからベエルシバまで行,いき巡,めぐって民,たみを数,かぞえ、わたしに民,たみの数,かずを知,しらせなさい」。","tok":[["そこ"],["で"],["王","おう"],["は"],["ヨアブ"],["および"],["ヨアブ"],["と"],["共","とも"],["に"],["いる"],["軍","ぐん"],["の"],["長","ちょう"],["たち"],["に"],["言った","いった"],["、"],["「"],["イスラエル"],["の"],["すべて"],["の"],["部族","ぶぞく"],["の"],["うち"],["を"],["、"],["ダン"],["から"],["ベエルシバ"],["まで"],["行き","いき"],["巡って","めぐって"],["民","たみ"],["を"],["数え","かぞえ"],["、"],["わたし"],["に"],["民","たみ"],["の"],["数","かず"],["を"],["知らせ","しらせ"],["なさい"],["」"],["。"]]},{"verse":3,"text":"ヨアブは王,おうに言,いった、「どうぞあなたの神,かみ、主,しゅが、民,たみを今,いまよりも百倍,ばいに増,ましてくださいますように。そして王,おう、わが主,しゅがまのあたり、それを見,みられますように。しかし王,おう、わが主,しゅは何,なにゆえにこの事,ことを喜,よろこばれるのですか」。","tok":[["ヨアブ"],["は"],["王","おう"],["に"],["言った","いった"],["、"],["「"],["どうぞ"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["、"],["民","たみ"],["を"],["今","いま"],["より"],["も"],["百","ひゃく"],["倍","ばい"],["に"],["増して","まして"],["くださいます"],["よう"],["に"],["。"],["そして"],["王","おう"],["、"],["わが"],["主","しゅがま"],["の"],["あたり"],["、"],["それ"],["を"],["見られます","みられます"],["よう"],["に"],["。"],["しかし"],["王","おう"],["、"],["わが"],["主","しゅ"],["は"],["何ゆえ","なにゆえ"],["に"],["この"],["事","こと"],["を"],["喜こばれる","よろこばれる"],["の"],["です"],["か"],["」"],["。"]]},{"verse":4,"text":"しかし王,おうの言葉,ことばがヨアブと軍,ぐんの長,ちょうたちとに勝,かったので、ヨアブと軍,ぐんの長,ちょうたちとは王,おうの前,まえを退,しりぞき、イスラエルの民,たみを数,かぞえるために出,でて行,いった。","tok":[["しかし"],["王","おう"],["の"],["言葉","ことば"],["が"],["ヨアブ"],["と"],["軍","ぐん"],["の"],["長","ちょう"],["たち"],["と"],["に"],["勝った","かった"],["ので"],["、"],["ヨアブ"],["と"],["軍","ぐん"],["の"],["長","ちょう"],["たち"],["と"],["は"],["王","おう"],["の"],["前","まえ"],["を"],["退ぞき","しりぞき"],["、"],["イスラエル"],["の"],["民","たみ"],["を"],["数える","かぞえる"],["ため"],["に"],["出て","でて"],["行った","いった"],["。"]]},{"verse":5,"text":"彼,かれらはヨルダンを渡,わたり、アロエルから、すなわち谷,たにの中,なかにある町,まちから始,はじめて、ガドに向,むかい、ヤゼルに進,すすんだ。","tok":[["彼","かれ"],["ら"],["は"],["ヨルダン"],["を"],["渡り","わたり"],["、"],["アロエル"],["から"],["、"],["すなわち"],["谷","たに"],["の"],["中","なか"],["に"],["ある"],["町","まち"],["から"],["始","はじめ"],["て"],["、"],["ガド"],["に"],["向","むかい"],["、"],["ヤゼル"],["に"],["進んだ","すすんだ"],["。"]]},{"verse":6,"text":"それからギレアデに行,いき、またヘテびとの地,ちにあるカデシに行,いき、それからダンに至,いたり、ダンからシドンにまわり、","tok":[["それ"],["から"],["ギレアデ"],["に"],["行き","いき"],["、"],["また"],["ヘテ"],["びと"],["の"],["地","ち"],["に"],["ある"],["カデシ"],["に"],["行き","いき"],["、"],["それ"],["から"],["ダン"],["に"],["至","いたり"],["、"],["ダン"],["から"],["シドン"],["に"],["まわり"],["、"]]},{"verse":7,"text":"またツロの要害,ようがいに行,いき、ヒビびと、およびカナンびとのすべての町,まちに行,いき、ユダのネゲブに出,でてベエルシバへ行,いった。","tok":[["また"],["ツロ"],["の"],["要害","ようがい"],["に"],["行き","いき"],["、"],["ヒビ"],["び"],["と"],["、"],["および"],["カナン"],["びと"],["の"],["すべて"],["の"],["町","まち"],["に"],["行き","いき"],["、"],["ユダ"],["の"],["ネゲブ"],["に"],["出て","でて"],["ベエルシバ"],["へ"],["行った","いった"],["。"]]},{"verse":8,"text":"こうして彼,かれらは国,くにをあまねく行,いき巡,めぐって、九か月,げつと二十日,にちを経,へてエルサレムにきた。","tok":[["こう"],["して"],["彼","かれ"],["ら"],["は"],["国","くに"],["を"],["あまねく"],["行き","いき"],["巡って","めぐって"],["、"],["九","きゅう"],["か月","かげつ"],["と"],["二十日","にち"],["を"],["経て","へて"],["エルサレム"],["に"],["きた"],["。"]]},{"verse":9,"text":"そしてヨアブは民,たみの総数,そうすうを王,おうに告,つげた。すなわちイスラエルには、つるぎを抜,ぬく勇士,ゆうしたちが八十万あった。ただしユダの人々,ひとびとは五十万であった。","tok":[["そして"],["ヨアブ"],["は"],["民","たみ"],["の"],["総数","そうすう"],["を"],["王","おう"],["に"],["告","つげ"],["た"],["。"],["すなわち"],["イスラエル"],["に"],["は"],["、"],["つるぎ"],["を"],["抜く","ぬく"],["勇士","ゆうし"],["たち"],["が"],["八十万","はちじゅうまん"],["あった"],["。"],["ただし"],["ユダ"],["の"],["人々","ひとびと"],["は"],["五十万","ごじゅうまん"],["で"],["あった"],["。"]]},{"verse":10,"text":"しかしダビデは民,たみを数,かぞえた後,のち、心,こころに責,せめられた。そこでダビデは主,しゅに言,いった、「わたしはこれをおこなって大,おおきな罪,つみを犯,おかしました。しかし主,しゅよ、今,いまどうぞしもべの罪,つみを取,とり去,さってください。わたしはひじょうに愚,おろかなことをいたしました」。","tok":[["しかし"],["ダビデ"],["は"],["民","たみ"],["を"],["数えた","かぞえた"],["後","の"],["ち"],["、"],["心","こころ"],["に"],["責","せめ"],["られた"],["。"],["そこ"],["で"],["ダビデ"],["は"],["主に","しゅに"],["言った","いった"],["、"],["「"],["わたし"],["は"],["これ"],["を"],["おこなって"],["大きな","おおきな"],["罪","つみ"],["を"],["犯しました","おかしました"],["。"],["しかし"],["主","しゅ"],["よ"],["、"],["今","いま"],["どうぞ"],["しもべ"],["の"],["罪","つみ"],["を"],["取","とり"],["去て","さって"],["ください"],["。"],["わたし"],["は"],["ひじょう"],["に"],["愚か","おろか"],["な"],["こと"],["を"],["いたしました"],["」"],["。"]]},{"verse":11,"text":"ダビデが朝,あさ起,おきたとき、主,しゅの言葉,ことばはダビデの先見者,せんけんしゃである預言者,よげんしゃガデに臨,のぞんで言,いった、","tok":[["ダビデ"],["が"],["朝","あさ"],["起きた","おきた"],["とき"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["は"],["ダビデ"],["の"],["先見者","せんけんしゃ"],["で"],["ある"],["預言者","よげんしゃ"],["ガデ"],["に"],["臨んで","のぞんで"],["言った","いった"],["、"]]},{"verse":12,"text":"「行,いってダビデに言,いいなさい、『主,しゅはこう仰,おおせられる、「わたしは三つのことを示,しめす。あなたはその一つを選,えらぶがよい。わたしはそれをあなたに行,おこなうであろう」と』」。","tok":[["「"],["行って","いって"],["ダビデ"],["に"],["言い","いい"],["なさい"],["、"],["『"],["主","しゅ"],["は"],["こう"],["仰せられる","おおせられる"],["、"],["「"],["わたし"],["は"],["三","みっ"],["つ"],["の"],["こと"],["を"],["示めす","しめす"],["。"],["あなた"],["は"],["その"],["一","ひと"],["つ"],["を"],["選ぶ","えらぶ"],["が"],["よい"],["。"],["わたし"],["は"],["それ"],["を"],["あなた"],["に"],["行なうで","おこなうで"],["あろう"],["」"],["と"],["』"],["」"],["。"]]},{"verse":13,"text":"ガデはダビデのもとにきて、彼,かれに言,いった、「あなたの国,くにに三年,ねんのききんをこさせようか。あなたが敵,てきに追,おわれて三か月,げつ敵,てきの前,まえに逃,にげるようにしようか。それとも、あなたの国,くにに三日,かの疫病,えきびょうをおくろうか。あなたは考,かんがえて、わたしがどの答,こたえを、わたしをつかわされた方,かたになすべきかを決,きめなさい」。","tok":[["ガデ"],["は"],["ダビデ"],["の"],["もと"],["に"],["きて"],["、"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["の"],["国","くに"],["に"],["三","さん"],["年","ねん"],["の"],["ききん"],["を"],["こさせよう"],["か"],["。"],["あなた"],["が"],["敵","てき"],["に"],["追われて","おわれて"],["三","さん"],["か月","かげつ"],["敵","てき"],["の"],["前","まえ"],["に"],["逃る","にげる"],["よう"],["に"],["しよう"],["か"],["。"],["それ"],["と"],["も"],["、"],["あなた"],["の"],["国","くに"],["に"],["三日","か"],["の"],["疫病","えきびょう"],["を"],["おくろう"],["か"],["。"],["あなた"],["は"],["考","かんがえ"],["て"],["、"],["わたし"],["が"],["どの"],["答","こたえ"],["を"],["、"],["わたし"],["を"],["つかわされた"],["方","かた"],["に"],["なすべき"],["か"],["を"],["決め","きめ"],["なさい"],["」"],["。"]]},{"verse":14,"text":"ダビデはガデに言,いった、「わたしはひじょうに悩,なやんでいますが、主,しゅのあわれみは大,おおきいゆえ、われわれを主,しゅの手,てに陥,おちいらせてください。わたしを人,ひとの手,てには陥,おちいらせないでください」。","tok":[["ダビデ"],["は"],["ガデ"],["に"],["言った","いった"],["、"],["「"],["わたし"],["は"],["ひじょう"],["に"],["悩んで","なやんで"],["います"],["が"],["、"],["主","しゅ"],["の"],["あわれみ"],["は"],["大きい","おおきい"],["ゆえ"],["、"],["われわれ"],["を"],["主","しゅ"],["の"],["手","て"],["に"],["陥ち","おち"],["いらせて"],["ください"],["。"],["わたし"],["を"],["人","ひと"],["の"],["手","て"],["に"],["は"],["陥ち","おち"],["いらせないで"],["ください"],["」"],["。"]]},{"verse":15,"text":"そこで主,しゅは朝,あさから定,さだめの時,ときまで疫病,えきびょうをイスラエルに下,くだされた。ダンからベエルシバまでに民,たみの死,しんだ者,ものは七万人,にんあった。","tok":[["そこ"],["で"],["主","しゅ"],["は"],["朝","あさ"],["から"],["定め","さだめ"],["の"],["時","とき"],["まで"],["疫病","えきびょう"],["を"],["イスラエル"],["に"],["下された","くだされた"],["。"],["ダン"],["から"],["ベエルシバ"],["まで"],["に"],["民","たみ"],["の"],["死んだ","しんだ"],["者","もの"],["は"],["七万人","にん"],["あった"],["。"]]},{"verse":16,"text":"天,てんの使,つかいが手,てをエルサレムに伸,のべてこれを滅,ほろぼそうとしたが、主,しゅはこの害悪,がいあくを悔,くい、民,たみを滅,ほろぼしている天,てんの使,つかいに言,いわれた、「もはや、じゅうぶんである。今,いまあなたの手,てをとどめるがよい」。その時,とき、主,しゅの使,つかいはエブスびとアラウナの打,うち場,ばのかたわらにいた。","tok":[["天","てん"],["の"],["使","つかい"],["が"],["手","て"],["を"],["エルサレム"],["に"],["伸べて","のべて"],["これ"],["を"],["滅ぼそう","ほろぼそう"],["と"],["した"],["が"],["、"],["主","しゅ"],["は"],["この"],["害悪","がいあく"],["を"],["悔い","くい"],["、"],["民","たみ"],["を"],["滅ぼして","ほろぼして"],["いる"],["天","てん"],["の"],["使","つかい"],["に"],["言われた","いわれた"],["、"],["「"],["もはや"],["、"],["じゅうぶん"],["で"],["ある"],["。"],["今","いま"],["あなた"],["の"],["手","て"],["を"],["とどめる"],["が"],["よい"],["」"],["。"],["その"],["時","とき"],["、"],["主","しゅ"],["の"],["使い","つかい"],["は"],["エブス"],["びと"],["アラウナ"],["の"],["打ち","うち"],["場","ば"],["の"],["かたわら"],["に"],["いた"],["。"]]},{"verse":17,"text":"ダビデは民,たみを撃,うっている天,てんの使,つかいを見,みた時,とき、主,しゅに言,いった、「わたしは罪,つみを犯,おかしました。わたしは悪,あくを行,おこないました。しかしこれらの羊,ひつじたちは何,なにをしたのですか。どうぞあなたの手,てをわたしとわたしの父,ちちの家,いえに向,むけてください」。","tok":[["ダビデ"],["は"],["民","たみ"],["を"],["撃って","うって"],["いる"],["天","てん"],["の"],["使","つかい"],["を"],["見た","みた"],["時","とき"],["、"],["主に","しゅに"],["言った","いった"],["、"],["「"],["わたし"],["は"],["罪","つみ"],["を"],["犯しました","おかしました"],["。"],["わたし"],["は"],["悪","あく"],["を"],["行ないました","おこないました"],["。"],["しかし"],["これ"],["ら"],["の"],["羊","ひつじ"],["たち"],["は"],["何に","なに"],["を"],["した"],["の"],["です"],["か"],["。"],["どうぞ"],["あなた"],["の"],["手","て"],["を"],["わたし"],["と"],["わたし"],["の"],["父","ちち"],["の"],["家","いえ"],["に"],["向けて","むけて"],["ください"],["」"],["。"]]},{"verse":18,"text":"その日,ひガデはダビデのところにきて彼,かれに言,いった、「上,のぼって行,いってエブスびとアラウナの打,うち場,ばで主,しゅに祭壇,さいだんを建,たてなさい」。","tok":[["その"],["日","ひ"],["ガデ"],["は"],["ダビデ"],["の"],["ところ"],["に"],["きて"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["上って","のぼって"],["行って","いって"],["エブス"],["びと"],["アラウナ"],["の"],["打ち","うち"],["場","ば"],["で"],["主に","しゅに"],["祭壇","さいだん"],["を"],["建て","たて"],["なさい"],["」"],["。"]]},{"verse":19,"text":"ダビデはガデの言葉,ことばに従,したがい、主,しゅの命,めいじられたように上,のぼって行,いった。","tok":[["ダビデ"],["は"],["ガデ"],["の"],["言葉","ことば"],["に"],["従い","したがい"],["、"],["主","しゅ"],["の"],["命じられた","めいじられた"],["よう"],["に"],["上って","のぼって"],["行った","いった"],["。"]]},{"verse":20,"text":"アラウナは見,みおろして、王,おうとそのしもべたちが自分,じぶんの方,ほうに進,すすんでくるのを見,みたので、アラウナは出,でてきて王,おうの前,まえに地,ちにひれ伏,ふして拝,はいした。","tok":[["アラウナ"],["は"],["見おろして","みおろして"],["、"],["王","おう"],["と"],["その"],["しもべ"],["たち"],["が"],["自分","じぶん"],["の"],["方","ほう"],["に"],["進","すすん"],["で"],["くる"],["の"],["を"],["見た","みた"],["ので"],["、"],["アラウナ"],["は"],["出て","でて"],["きて"],["王","おう"],["の"],["前","まえ"],["に"],["地","ち"],["に"],["ひれ伏して","ひれふして"],["拝した","はいした"],["。"]]},{"verse":21,"text":"そしてアラウナは言,いった、「どうして王,おうわが主,しゅは、しもべの所,ところにこられましたか」。ダビデは言,いった、「あなたから打,うち場,ばを買,かい取,とり、主,しゅに祭壇,さいだんを築,きずいて民,たみに下,くだる災,わざわいをとどめるためです」。","tok":[["そして"],["アラウナ"],["は"],["言った","いった"],["、"],["「"],["どう"],["して"],["王","おう"],["わが"],["主","しゅ"],["は"],["、"],["しもべ"],["の"],["所","ところ"],["に"],["こられました"],["か"],["」"],["。"],["ダビデ"],["は"],["言った","いった"],["、"],["「"],["あなた"],["から"],["打ち","うち"],["場","ば"],["を"],["買取","かいとり"],["、"],["主に","しゅに"],["祭壇","さいだん"],["を"],["築いて","きずいて"],["民","たみ"],["に"],["下る","くだる"],["災","わざわい"],["を"],["とどめる"],["ため"],["です"],["」"],["。"]]},{"verse":22,"text":"アラウナはダビデに言,いった、「どうぞ王,おう、わが主,しゅのよいと思,おもわれる物,ものを取,とってささげてください。燔祭,はんさいにする牛,うしもあります。たきぎにする打,だ穀,こく機,はたも牛,うしのくびきもあります。","tok":[["アラウナ"],["は"],["ダビデ"],["に"],["言った","いった"],["、"],["「"],["どうぞ"],["王","おう"],["、"],["わが"],["主","しゅ"],["の"],["よい"],["と"],["思われる","おもわれる"],["物","もの"],["を"],["取って","とって"],["ささげて"],["ください"],["。"],["燔祭","はんさい"],["に"],["する"],["牛","うし"],["も"],["あります"],["。"],["たきぎ"],["に"],["する"],["打","だ"],["穀","こく"],["機","はた"],["も"],["牛","うし"],["の"],["くびき"],["も"],["あります"],["。"]]},{"verse":23,"text":"王,おうよ、アラウナはこれをことごとく王,おうにささげます」。アラウナはまた王,おうに、「あなたの神,かみ、主,しゅがあなたを受,うけいれられますように」と言,いった。","tok":[["王","おう"],["よ"],["、"],["アラウナ"],["は"],["これ"],["を"],["ことごとく"],["王","おう"],["に"],["ささげます"],["」"],["。"],["アラウナ"],["は"],["また"],["王","おう"],["に"],["、"],["「"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["あなた"],["を"],["受","うけ"],["いれられます"],["よう"],["に"],["」"],["と"],["言った","いった"],["。"]]},{"verse":24,"text":"しかし王,おうはアラウナに言,いった、「いいえ、代価,だいかを支払,しはらってそれをあなたから買,かい取,とります。わたしは費用,ひようをかけずに燔祭,はんさいをわたしの神,かみ、主,しゅにささげることはしません」。こうしてダビデは銀,ぎん五十シケルで打,うち場,ばと牛,うしとを買,かい取,とった。","tok":[["しかし"],["王","おう"],["は"],["アラウナ"],["に"],["言った","いった"],["、"],["「"],["いいえ"],["、"],["代価","だいか"],["を"],["支払って","しはらって"],["それ"],["を"],["あなた"],["から"],["買取","かいとり"],["ます"],["。"],["わたし"],["は"],["費用","ひよう"],["を"],["かけず"],["に"],["燔祭","はんさい"],["を"],["わたし"],["の"],["神","かみ"],["、"],["主に","しゅに"],["ささげる"],["こと"],["は"],["しません"],["」"],["。"],["こう"],["して"],["ダビデ"],["は"],["銀","ぎん"],["五十","ごじゅう"],["シケル"],["で"],["打ち","うち"],["場","ば"],["と"],["牛","うし"],["と"],["を"],["買取った","かいとった"],["。"]]},{"verse":25,"text":"ダビデはその所,ところで主,しゅに祭壇,さいだんを築,きずき、燔祭,はんさいと酬恩祭,しゅうおんさいをささげた。そこで主,しゅはその地,ちのために祈,いのりを聞,きかれたので、災,わざわいがイスラエルに下,くだることはとどまった。","tok":[["ダビデ"],["は"],["その"],["所","ところ"],["で"],["主に","しゅに"],["祭壇","さいだん"],["を"],["築き","きずき"],["、"],["燔祭","はんさい"],["と"],["酬恩祭","しゅうおんさい"],["を"],["ささげた"],["。"],["そこ"],["で"],["主","しゅ"],["は"],["その"],["地","ち"],["の"],["ため"],["に"],["祈","いのり"],["を"],["聞かれた","きかれた"],["ので"],["、"],["災","わざわい"],["が"],["イスラエル"],["に"],["下る","くだる"],["こと"],["は"],["とどまった"],["。"]]}]
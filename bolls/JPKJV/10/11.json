[{"verse":1,"text":"春,はるになって、王,おうたちが戦,たたかいに出,でるに及,およんで、ダビデはヨアブおよび自分,じぶんと共,ともにいる家来,けらいたち、並,ならびにイスラエルの全,ぜん軍,ぐんをつかわした。彼,かれらはアンモンの人々,ひとびとを滅,ほろぼし、ラバを包囲,ほういした。しかしダビデはエルサレムにとどまっていた。","tok":[["春","はる"],["に"],["なって"],["、"],["王","おう"],["たち"],["が"],["戦い","たたかい"],["に"],["出る","でる"],["に"],["及んで","およんで"],["、"],["ダビデ"],["は"],["ヨアブ"],["および"],["自分","じぶん"],["と"],["共","とも"],["に"],["いる"],["家来","けらい"],["たち"],["、"],["並びに","ならびに"],["イスラエル"],["の"],["全軍","ぜんぐん"],["を"],["つかわした"],["。"],["彼","かれ"],["ら"],["は"],["アンモン"],["の"],["人々","ひとびと"],["を"],["滅ぼし","ほろぼし"],["、"],["ラバ"],["を"],["包囲","ほうい"],["した"],["。"],["しかし"],["ダビデ"],["は"],["エルサレム"],["に"],["とどまって"],["いた"],["。"]]},{"verse":2,"text":"さて、ある日,ひの夕暮,ゆうぐれ、ダビデは床,ゆかから起,おき出,でて、王,おうの家,いえの屋上,おくじょうを歩,あるいていたが、屋上,おくじょうから、ひとりの女,おんながからだを洗,あらっているのを見,みた。その女,おんなは非常,ひじょうに美,うつくしかった。","tok":[["さて"],["、"],["ある"],["日","ひ"],["の"],["夕暮","ゆうぐれ"],["、"],["ダビデ"],["は"],["床","ゆか"],["から"],["起き出て","おきでて"],["、"],["王","おう"],["の"],["家","いえ"],["の"],["屋上","おくじょう"],["を"],["歩いて","あるいて"],["いた"],["が"],["、"],["屋上","おくじょう"],["から"],["、"],["ひとり"],["の"],["女","おんな"],["が"],["からだ"],["を"],["洗って","あらって"],["いる"],["の"],["を"],["見た","みた"],["。"],["その"],["女","おんな"],["は"],["非常","ひじょう"],["に"],["美しかった","うつくしかった"],["。"]]},{"verse":3,"text":"ダビデは人,ひとをつかわしてその女,おんなのことを探,さぐらせたが、ある人,ひとは言,いった、「これはエリアムの娘,むすめで、ヘテびとウリヤの妻,つまバテシバではありませんか」。","tok":[["ダビデ"],["は"],["人","ひと"],["を"],["つかわして"],["その"],["女","おんな"],["の"],["こと"],["を"],["探ぐらせた","さぐらせた"],["が"],["、"],["ある"],["人","ひと"],["は"],["言った","いった"],["、"],["「"],["これ"],["は"],["エリアム"],["の"],["娘","むすめ"],["で"],["、"],["ヘテ"],["びと"],["ウリヤ"],["の"],["妻","つま"],["バテシバ"],["で"],["は"],["ありません"],["か"],["」"],["。"]]},{"verse":4,"text":"そこでダビデは使者,ししゃをつかわして、その女,おんなを連,つれてきた。女,おんなは彼,かれの所,ところにきて、彼,かれはその女,おんなと寝,ねた。（女,おんなは身,みの汚,けがれを清,きよめていたのである。）こうして女,おんなはその家,いえに帰,かえった。","tok":[["そこ"],["で"],["ダビデ"],["は"],["使者","ししゃ"],["を"],["つかわして"],["、"],["その"],["女","おんな"],["を"],["連れて","つれて"],["きた"],["。"],["女","おんな"],["は"],["彼","かれ"],["の"],["所","ところ"],["に"],["きて"],["、"],["彼","かれ"],["は"],["その"],["女","おんな"],["と"],["寝た","ねた"],["。"],["（"],["女","おんな"],["は"],["身","み"],["の"],["汚","けがれ"],["を"],["清めて","きよめて"],["いた"],["ので"],["ある"],["。"],["）"],["こう"],["して"],["女","おんな"],["は"],["その"],["家","いえ"],["に"],["帰えった","かえった"],["。"]]},{"verse":5,"text":"女,おんなは妊娠,にんしんしたので、人,ひとをつかわしてダビデに告,つげて言,いった、「わたしは子,こをはらみました」。","tok":[["女","おんな"],["は"],["妊娠","にんしん"],["した"],["ので"],["、"],["人","ひと"],["を"],["つかわして"],["ダビデ"],["に"],["告","つげ"],["て"],["言った","いった"],["、"],["「"],["わたし"],["は"],["子","こ"],["を"],["はらみました"],["」"],["。"]]},{"verse":6,"text":"そこでダビデはヨアブに、「ヘテびとウリヤをわたしの所,ところにつかわせ」と言,いってやったので、ヨアブはウリヤをダビデの所,ところにつかわした。","tok":[["そこ"],["で"],["ダビデ"],["は"],["ヨアブ"],["に"],["、"],["「"],["ヘテ"],["びと"],["ウリヤ"],["を"],["わたし"],["の"],["所","ところ"],["に"],["つかわせ"],["」"],["と"],["言って","いって"],["やった"],["ので"],["、"],["ヨアブ"],["は"],["ウリヤ"],["を"],["ダビデ"],["の"],["所","ところ"],["に"],["つかわした"],["。"]]},{"verse":7,"text":"ウリヤがダビデの所,ところにきたので、ダビデは、ヨアブはどうしているか、民,たみはどうしているか、戦,たたかいはうまくいっているかとたずねた。","tok":[["ウリヤ"],["が"],["ダビデ"],["の"],["所","ところ"],["に"],["きた"],["ので"],["、"],["ダビデ"],["は"],["、"],["ヨアブ"],["は"],["どう"],["して"],["いる"],["か"],["、"],["民","たみ"],["は"],["どう"],["して"],["いる"],["か"],["、"],["戦い","たたかい"],["は"],["うまく"],["いって"],["いる"],["か"],["と"],["たずねた"],["。"]]},{"verse":8,"text":"そしてダビデはウリヤに言,いった、「あなたの家,いえに行,いって、足,あしを洗,あらいなさい」。ウリヤは王,おうの家,いえを出,でていったが、王,おうの贈,おくり物,ものが彼,かれの後,のちに従,したがった。","tok":[["そして"],["ダビデ"],["は"],["ウリヤ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["の"],["家","いえ"],["に"],["行って","いって"],["、"],["足","あし"],["を"],["洗","あらい"],["なさい"],["」"],["。"],["ウリヤ"],["は"],["王","おう"],["の"],["家","いえ"],["を"],["出て","でて"],["いった"],["が"],["、"],["王","おう"],["の"],["贈り物","おくりもの"],["が"],["彼","かれ"],["の"],["後","のち"],["に"],["従った","したがった"],["。"]]},{"verse":9,"text":"しかしウリヤは王,おうの家,いえの入口,いりぐちで主君,しゅくんの家来,けらいたちと共,ともに寝,ねて、自分,じぶんの家,いえに帰,かえらなかった。","tok":[["しかし"],["ウリヤ"],["は"],["王","おう"],["の"],["家","いえ"],["の"],["入口","いりぐち"],["で"],["主君","しゅくん"],["の"],["家来","けらい"],["たち"],["と"],["共","とも"],["に"],["寝て","ねて"],["、"],["自分","じぶん"],["の"],["家","いえ"],["に"],["帰えらなかった","かえらなかった"],["。"]]},{"verse":10,"text":"人々,ひとびとがダビデに、「ウリヤは自分,じぶんの家,いえに帰,かえりませんでした」と告,つげたので、ダビデはウリヤに言,いった、「旅,たびから帰,かえってきたのではないか。どうして家,いえに帰,かえらなかったのか」。","tok":[["人々","ひとびと"],["が"],["ダビデ"],["に"],["、"],["「"],["ウリヤ"],["は"],["自分","じぶん"],["の"],["家","いえ"],["に"],["帰えりませんでした","かえりませんでした"],["」"],["と"],["告","つげ"],["た"],["ので"],["、"],["ダビデ"],["は"],["ウリヤ"],["に"],["言った","いった"],["、"],["「"],["旅","たび"],["から"],["帰えって","かえって"],["きた"],["ので"],["は"],["ない"],["か"],["。"],["どう"],["して"],["家","いえ"],["に"],["帰えらなかった","かえらなかった"],["の"],["か"],["」"],["。"]]},{"verse":11,"text":"ウリヤはダビデに言,いった、「神,かみの箱,はこも、イスラエルも、ユダも、小屋,こやの中,なかに住,すみ、わたしの主人,しゅじんヨアブと、わが主君,しゅくんの家来,けらいたちが野,ののおもてに陣,じんを取,とっているのに、わたしはどうして家,いえに帰,かえって食,くい飲,のみし、妻,つまと寝,ねることができましょう。あなたは生,いきておられます。あなたの魂,たましいは生,いきています。わたしはこの事,ことをいたしません」。","tok":[["ウリヤ"],["は"],["ダビデ"],["に"],["言った","いった"],["、"],["「"],["神","かみ"],["の"],["箱","はこ"],["も"],["、"],["イスラエル"],["も"],["、"],["ユダ"],["も"],["、"],["小屋","こや"],["の"],["中","なか"],["に"],["住み","すみ"],["、"],["わたし"],["の"],["主人","しゅじん"],["ヨアブ"],["と"],["、"],["わが"],["主君","しゅくん"],["の"],["家来","けらい"],["たち"],["が"],["野","の"],["の"],["おもて"],["に"],["陣","じん"],["を"],["取って","とって"],["いる"],["のに"],["、"],["わたし"],["は"],["どう"],["して"],["家","いえ"],["に"],["帰えって","かえって"],["食い","くい"],["飲み","のみ"],["し"],["、"],["妻","つま"],["と"],["寝る","ねる"],["こと"],["が"],["できましょう"],["。"],["あなた"],["は"],["生きて","いきて"],["おられます"],["。"],["あなた"],["の"],["魂","たましい"],["は"],["生きて","いきて"],["います"],["。"],["わたし"],["は"],["この"],["事","こと"],["を"],["いたしません"],["」"],["。"]]},{"verse":12,"text":"ダビデはウリヤに言,いった、「きょうも、ここにとどまりなさい。わたしはあす、あなたを去,さらせましょう」。そこでウリヤはその日,ひと次,つぎの日,ひエルサレムにとどまった。","tok":[["ダビデ"],["は"],["ウリヤ"],["に"],["言った","いった"],["、"],["「"],["きょう"],["も"],["、"],["ここ"],["に"],["とどまり"],["なさい"],["。"],["わたし"],["は"],["あす"],["、"],["あなた"],["を"],["去らせましょう","さらせましょう"],["」"],["。"],["そこ"],["で"],["ウリヤ"],["は"],["その"],["日","ひ"],["と"],["次","つぎ"],["の"],["日","ひ"],["エルサレム"],["に"],["とどまった"],["。"]]},{"verse":13,"text":"ダビデは彼,かれを招,まねいて自分,じぶんの前,まえで食,くい飲,のみさせ、彼,かれを酔,よわせた。夕暮,ゆうぐれになって彼,かれは出,でていって、その床,ゆかに、主君,しゅくんの家来,けらいたちと共,ともに寝,ねた。そして自分,じぶんの家,いえには下,くだって行,いかなかった。","tok":[["ダビデ"],["は"],["彼","かれ"],["を"],["招いて","まねいて"],["自分","じぶん"],["の"],["前","まえ"],["で"],["食い","くい"],["飲みさせ","のみさせ"],["、"],["彼","かれ"],["を"],["酔わせた","よわせた"],["。"],["夕暮","ゆうぐれ"],["に"],["なって"],["彼","かれ"],["は"],["出て","でて"],["いって"],["、"],["その"],["床","ゆか"],["に"],["、"],["主君","しゅくん"],["の"],["家来","けらい"],["たち"],["と"],["共","とも"],["に"],["寝た","ねた"],["。"],["そして"],["自分","じぶん"],["の"],["家","いえ"],["に"],["は"],["下って","くだって"],["行かなかった","いかなかった"],["。"]]},{"verse":14,"text":"朝,あさになってダビデはヨアブにあてた手紙,てがみを書,かき、ウリヤの手,てに託,たくしてそれを送,おくった。","tok":[["朝","あさ"],["に"],["なって"],["ダビデ"],["は"],["ヨアブ"],["に"],["あてた"],["手紙","てがみ"],["を"],["書き","かき"],["、"],["ウリヤ"],["の"],["手","て"],["に"],["託して","たくして"],["それ"],["を"],["送った","おくった"],["。"]]},{"verse":15,"text":"彼,かれはその手紙,てがみに、「あなたがたはウリヤを激,はげしい戦,たたかいの最前線,さいぜんせんに出,だし、彼,かれの後,うしろから退,しりぞいて、彼,かれを討死,うちじにさせよ」と書,かいた。","tok":[["彼","かれ"],["は"],["その"],["手紙","てがみ"],["に"],["、"],["「"],["あなた"],["がた"],["は"],["ウリヤ"],["を"],["激しい","はげしい"],["戦い","たたかい"],["の"],["最前線","さいぜんせん"],["に"],["出し","だし"],["、"],["彼","かれ"],["の"],["後ろ","うしろ"],["から"],["退ぞいて","しりぞいて"],["、"],["彼","かれ"],["を"],["討死","うちじに"],["させよ"],["」"],["と"],["書いた","かいた"],["。"]]},{"verse":16,"text":"ヨアブは町,まちを囲,かこんでいたので、勇士,ゆうしたちがいると知,しっていた場所,ばしょにウリヤを置,おいた。","tok":[["ヨアブ"],["は"],["町","まち"],["を"],["囲んで","かこんで"],["いた"],["ので"],["、"],["勇士","ゆうし"],["たち"],["が"],["いる"],["と"],["知って","しって"],["いた"],["場所","ばしょ"],["に"],["ウリヤ"],["を"],["置いた","おいた"],["。"]]},{"verse":17,"text":"町,まちの人々,ひとびとが出,でてきてヨアブと戦,たたかったので、民,たみのうち、ダビデの家来,けらいたちにも、倒,たおれるものがあり、ヘテびとウリヤも死,しんだ。","tok":[["町","まち"],["の"],["人々","ひとびと"],["が"],["出て","でて"],["きて"],["ヨアブ"],["と"],["戦った","たたかった"],["ので"],["、"],["民","たみ"],["の"],["うち"],["、"],["ダビデ"],["の"],["家来","けらい"],["たち"],["に"],["も"],["、"],["倒れる","たおれる"],["もの"],["が"],["あり"],["、"],["ヘテ"],["びと"],["ウリヤ"],["も"],["死んだ","しんだ"],["。"]]},{"verse":18,"text":"ヨアブは人,ひとをつかわして戦,たたかいのことをつぶさにダビデに告,つげた。","tok":[["ヨアブ"],["は"],["人","ひと"],["を"],["つかわして"],["戦い","たたかい"],["の"],["こと"],["を"],["つぶさに"],["ダビデ"],["に"],["告","つげ"],["た"],["。"]]},{"verse":19,"text":"ヨアブはその使者,ししゃに命,めいじて言,いった、「あなたが戦,たたかいのことをつぶさに王,おうに語,かたり終,おわったとき、","tok":[["ヨアブ"],["は"],["その"],["使者","ししゃ"],["に"],["命じて","めいじて"],["言った","いった"],["、"],["「"],["あなた"],["が"],["戦い","たたかい"],["の"],["こと"],["を"],["つぶさに"],["王","おう"],["に"],["語り","かたり"],["終わった","おわった"],["とき"],["、"]]},{"verse":20,"text":"もし王,おうが怒,いかりを起,おこして、『あなたがたはなぜ戦,たたかおうとしてそんなに町,まちに近,ちかづいたのか。彼,かれらが城壁,じょうへきの上,うえから射,いるのを知,しらなかったのか。","tok":[["もし"],["王","おう"],["が"],["怒り","いかり"],["を"],["起こして","おこして"],["、"],["『"],["あなた"],["がた"],["は"],["なぜ"],["戦おう","たたかおう"],["として"],["そんな"],["に"],["町","まち"],["に"],["近づいた","ちかづいた"],["の"],["か"],["。"],["彼","かれ"],["ら"],["が"],["城壁","じょうへき"],["の"],["上","うえ"],["から"],["射る","いる"],["の"],["を"],["知らなかった","しらなかった"],["の"],["か"],["。"]]},{"verse":21,"text":"エルベセテの子,こアビメレクを撃,うったのはだれか。ひとりの女,おんなが城壁,じょうへきの上,うえから石,いしうすの上石,うわいしを投,なげて彼,かれをテベツで殺,ころしたのではなかったか。あなたがたはなぜそんなに城壁,じょうへきに近,ちかづいたのか』と言,いわれたならば、その時,ときあなたは、『あなたのしもべ、ヘテびとウリヤもまた死,しにました』と言,いいなさい」。","tok":[["エルベセテ"],["の"],["子","こ"],["アビメレク"],["を"],["撃った","うった"],["の"],["は"],["だれ"],["か"],["。"],["ひとり"],["の"],["女","おんな"],["が"],["城壁","じょうへき"],["の"],["上","うえ"],["から"],["石うす","いしうす"],["の"],["上","うえ"],["石","いし"],["を"],["投て","なげて"],["彼","かれ"],["を"],["テベツ"],["で"],["殺ろした","ころした"],["ので"],["は"],["なかった"],["か"],["。"],["あなた"],["がた"],["は"],["なぜ"],["そんな"],["に"],["城壁","じょうへき"],["に"],["近づいた","ちかづいた"],["の"],["か"],["』"],["と"],["言われたならば","いわれたならば"],["、"],["その"],["時","とき"],["あなた"],["は"],["、"],["『"],["あなた"],["の"],["しもべ"],["、"],["ヘテ"],["びと"],["ウリヤ"],["も"],["また"],["死にました","しにました"],["』"],["と"],["言い","いい"],["なさい"],["」"],["。"]]},{"verse":22,"text":"こうして使者,ししゃは行,いき、ダビデのもとにきて、ヨアブが言,いいつかわしたことをことごとく告,つげた。","tok":[["こう"],["して"],["使者","ししゃ"],["は"],["行き","いき"],["、"],["ダビデ"],["の"],["もと"],["に"],["きて"],["、"],["ヨアブ"],["が"],["言い","いい"],["つかわした"],["こと"],["を"],["ことごとく"],["告","つげ"],["た"],["。"]]},{"verse":23,"text":"使者,ししゃはダビデに言,いった、「敵,てきはわれわれよりも有利,ゆうりな位置,いちを占,しめ、出,でてきてわれわれを野,ので攻,せめましたが、われわれは町,まちの入口,いりぐちまで彼,かれらを追,おい返,かえしました。","tok":[["使者","ししゃ"],["は"],["ダビデ"],["に"],["言った","いった"],["、"],["「"],["敵","てき"],["は"],["われわれ"],["より"],["も"],["有利","ゆうり"],["な"],["位置","いち"],["を"],["占め","しめ"],["、"],["出て","でて"],["きて"],["われわれ"],["を"],["野","の"],["で"],["攻めました","せめました"],["が"],["、"],["われわれ"],["は"],["町","まち"],["の"],["入口","いりぐち"],["まで"],["彼","かれ"],["ら"],["を"],["追い","おい"],["返","かえし"],["ました"],["。"]]},{"verse":24,"text":"その時,とき、射手,しゃしゅどもは城壁,じょうへきからあなたの家来,けらいたちを射,いましたので、王,おうの家来,けらいのある者,ものは死,しに、また、あなたの家来,けらいヘテびとウリヤも死,しにました」。","tok":[["その"],["時","とき"],["、"],["射手","しゃしゅど"],["も"],["は"],["城壁","じょうへき"],["から"],["あなた"],["の"],["家来","けらい"],["たち"],["を"],["射ました","いました"],["ので"],["、"],["王","おう"],["の"],["家来","けらい"],["の"],["ある"],["者","もの"],["は"],["死に","しに"],["、"],["また"],["、"],["あなた"],["の"],["家来","けらい"],["ヘテ"],["びと"],["ウリヤ"],["も"],["死にました","しにました"],["」"],["。"]]},{"verse":25,"text":"ダビデは使者,ししゃに言,いった、「あなたはヨアブにこう言,いいなさい、『この事,ことで心配,しんぱいすることはない。つるぎはこれをも彼,かれをも同,おなじく滅,ほろぼすからである。強,つよく町,まちを攻,せめて戦,たたかい、それを攻,せめ落,おとしなさい』と。そしてヨアブを励,はげましなさい」。","tok":[["ダビデ"],["は"],["使者","ししゃ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["は"],["ヨアブ"],["に"],["こう"],["言い","いい"],["なさい"],["、"],["『"],["この"],["事","こと"],["で"],["心配","しんぱい"],["する"],["こと"],["は"],["ない"],["。"],["つるぎ"],["は"],["これ"],["を"],["も"],["彼","かれ"],["を"],["も"],["同じく","おなじく"],["滅ぼす","ほろぼす"],["から"],["で"],["ある"],["。"],["強く","つよく"],["町","まち"],["を"],["攻めて","せめて"],["戦い","たたかい"],["、"],["それ"],["を"],["攻め落とし","せめおとし"],["なさい"],["』"],["と"],["。"],["そして"],["ヨアブ"],["を"],["励まし","はげまし"],["なさい"],["」"],["。"]]},{"verse":26,"text":"ウリヤの妻,つまは夫,おっとウリヤが死,しんだことを聞,きいて、夫,おっとのために悲,かなしんだ。","tok":[["ウリヤ"],["の"],["妻","つま"],["は"],["夫","おっと"],["ウリヤ"],["が"],["死んだ","しんだ"],["こと"],["を"],["聞いて","きいて"],["、"],["夫","おっと"],["の"],["ため"],["に"],["悲しんだ","かなしんだ"],["。"]]},{"verse":27,"text":"その喪,もが過,すぎた時,とき、ダビデは人,ひとをつかわして彼女,かのじょを自分,じぶんの家,いえに召,めし入,いれた。彼女,かのじょは彼,かれの妻,つまとなって男,おとこの子,こを産,うんだ。しかしダビデがしたこの事,ことは主,しゅを怒,いからせた。","tok":[["その"],["喪","も"],["が"],["過た","すぎた"],["時","とき"],["、"],["ダビデ"],["は"],["人","ひと"],["を"],["つかわして"],["彼女","かのじょ"],["を"],["自分","じぶん"],["の"],["家","いえ"],["に"],["召","めし"],["入れた","いれた"],["。"],["彼女","かのじょ"],["は"],["彼","かれ"],["の"],["妻","つま"],["と"],["なって"],["男の子","おとこのこ"],["を"],["産んだ","うんだ"],["。"],["しかし"],["ダビデ"],["が"],["した"],["この"],["事","こと"],["は"],["主","しゅ"],["を"],["怒らせた","いからせた"],["。"]]}]
[{"verse":1,"text":"主,しゅはこう言,いわれる、「モアブの三つのとが、四つのとがのために、わたしはこれを罰,ばっしてゆるさない。これは彼,かれがエドムの王,おうの骨,ほねを焼,やいて灰,はいにしたからである。","tok":[["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["「"],["モアブ"],["の"],["三","みっ"],["つ"],["の"],["と"],["が"],["、"],["四","よん"],["つ"],["の"],["とが"],["の"],["ため"],["に"],["、"],["わたし"],["は"],["これ"],["を"],["罰して","ばっして"],["ゆるさない"],["。"],["これ"],["は"],["彼","かれ"],["が"],["エドム"],["の"],["王","おう"],["の"],["骨","ほね"],["を"],["焼いて","やいて"],["灰","はい"],["に"],["した"],["から"],["で"],["ある"],["。"]]},{"verse":2,"text":"それゆえ、わたしはモアブに火,ひを送,おくり、ケリオテのもろもろの宮殿,きゅうでんを焼,やき滅,ほろぼす。モアブは騒,さわぎと、ときの声,こえと、ラッパの音,おとの中,なかに死,しぬ。","tok":[["それ"],["ゆえ"],["、"],["わたし"],["は"],["モアブ"],["に"],["火","ひ"],["を"],["送り","おくり"],["、"],["ケリオテ"],["の"],["もろもろ"],["の"],["宮殿","きゅうでん"],["を"],["焼き滅ぼす","やきほろぼす"],["。"],["モアブ"],["は"],["騒","さわぎ"],["と"],["、"],["とき"],["の"],["声","こえ"],["と"],["、"],["ラッパ"],["の"],["音","おと"],["の"],["中","なか"],["に"],["死ぬ","しぬ"],["。"]]},{"verse":3,"text":"わたしはそのうちから、支配者,しはいしゃを断,たち、そのすべてのつかさを彼,かれと共,ともに殺,ころす」と主,しゅは言,いわれる。","tok":[["わたし"],["は"],["その"],["うち"],["から"],["、"],["支配者","しはいしゃ"],["を"],["断ち","たち"],["、"],["その"],["すべて"],["の"],["つかさ"],["を"],["彼","かれ"],["と"],["共","とも"],["に"],["殺ろす","ころす"],["」"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":4,"text":"主,しゅはこう言,いわれる、「ユダの三つのとが、四つのとがのために、わたしはこれを罰,ばっしてゆるさない。これは彼,かれらが主,しゅの律法,りっぽうを捨,すて、その定,さだめを守,まもらず、その先祖,せんぞたちが従,したがい歩,あるいた偽,いつわりの物,ものに惑,まどわされたからである。","tok":[["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["「"],["ユダ"],["の"],["三","みっ"],["つ"],["の"],["と"],["が"],["、"],["四","よん"],["つ"],["の"],["とが"],["の"],["ため"],["に"],["、"],["わたし"],["は"],["これ"],["を"],["罰して","ばっして"],["ゆるさない"],["。"],["これ"],["は"],["彼","かれ"],["ら"],["が"],["主","しゅ"],["の"],["律法","りっぽう"],["を"],["捨て","すて"],["、"],["その"],["定め","さだめ"],["を"],["守らず","まもらず"],["、"],["その"],["先祖","せんぞ"],["たち"],["が"],["従い","したがい"],["歩いた","あるいた"],["偽わり","いつわり"],["の"],["物","もの"],["に"],["惑わされた","まどわされた"],["から"],["で"],["ある"],["。"]]},{"verse":5,"text":"それゆえ、わたしはユダに火,ひを送,おくり、エルサレムのもろもろの宮殿,きゅうでんを焼,やき滅,ほろぼす」。","tok":[["それ"],["ゆえ"],["、"],["わたし"],["は"],["ユダ"],["に"],["火","ひ"],["を"],["送り","おくり"],["、"],["エルサレム"],["の"],["もろもろ"],["の"],["宮殿","きゅうでん"],["を"],["焼き滅ぼす","やきほろぼす"],["」"],["。"]]},{"verse":6,"text":"主,しゅはこう言,いわれる、「イスラエルの三つのとが、四つのとがのために、わたしはこれを罰,ばっしてゆるさない。これは彼,かれらが正,ただしい者,ものを金,かねのために売,うり、貧,まずしい者,ものをくつ一足,そくのために売,うるからである。","tok":[["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["「"],["イスラエル"],["の"],["三","みっ"],["つ"],["の"],["と"],["が"],["、"],["四","よん"],["つ"],["の"],["とが"],["の"],["ため"],["に"],["、"],["わたし"],["は"],["これ"],["を"],["罰して","ばっして"],["ゆるさない"],["。"],["これ"],["は"],["彼","かれ"],["ら"],["が"],["正い","ただしい"],["者","もの"],["を"],["金","かね"],["の"],["ため"],["に"],["売","うり"],["、"],["貧しい","まずしい"],["者","もの"],["を"],["くつ"],["一足","そく"],["の"],["ため"],["に"],["売る","うる"],["から"],["で"],["ある"],["。"]]},{"verse":7,"text":"彼,かれらは弱,よわい者,ものの頭,あたまを地,ちのちりに踏,ふみつけ、苦,くるしむ者,ものの道,みちをまげ、また父子,ふしともにひとりの女,おんなのところへ行,いって、わが聖,せいなる名,なを汚,けがす。","tok":[["彼","かれ"],["ら"],["は"],["弱い","よわい"],["者","もの"],["の"],["頭","あたま"],["を"],["地","ち"],["の"],["ちり"],["に"],["踏みつけ","ふみつけ"],["、"],["苦しむ","くるしむ"],["者","もの"],["の"],["道","みち"],["を"],["まげ"],["、"],["また"],["父子","ふし"],["とも"],["に"],["ひとり"],["の"],["女","おんな"],["の"],["ところ"],["へ"],["行って","いって"],["、"],["わが"],["聖","せい"],["なる"],["名","な"],["を"],["汚","け"],["がす"],["。"]]},{"verse":8,"text":"彼,かれらはすべての祭壇,さいだんのかたわらに質,しちに取,とった衣服,いふくを敷,しいて、その上,うえに伏,ふし、罰金,ばっきんをもって得,えた酒,さけを、その神,かみの家,いえで飲,のむ。","tok":[["彼","かれ"],["ら"],["は"],["すべて"],["の"],["祭壇","さいだん"],["の"],["かたわら"],["に"],["質","しち"],["に"],["取った","とった"],["衣服","いふく"],["を"],["敷いて","しいて"],["、"],["その"],["上","うえ"],["に"],["伏し","ふし"],["、"],["罰金","ばっきん"],["を"],["もって"],["得た","えた"],["酒","さけ"],["を"],["、"],["その"],["神","かみ"],["の"],["家","いえ"],["で"],["飲む","のむ"],["。"]]},{"verse":9,"text":"さきにわたしはアモリびとを彼,かれらの前,まえから滅,ほろぼした。これはその高,たかきこと、香柏,こうはくのごとく、その強,つよきこと、かしの木,きのようであったが、わたしはその上,うえの実,みと、下,したの根,ねとを滅,ほろぼした。","tok":[["さき"],["に"],["わたし"],["は"],["アモリ"],["びと"],["を"],["彼","かれ"],["ら"],["の"],["前","まえ"],["から"],["滅ぼした","ほろぼした"],["。"],["これ"],["は"],["その"],["高き","たかき"],["こと"],["、"],["香","こう"],["柏","かしわ"],["の"],["ごとく"],["、"],["その"],["強き","つよき"],["こと"],["、"],["かし"],["の"],["木","き"],["の"],["よう"],["で"],["あった"],["が"],["、"],["わたし"],["は"],["その"],["上","うえ"],["の"],["実","み"],["と"],["、"],["下","した"],["の"],["根","ね"],["と"],["を"],["滅ぼした","ほろぼした"],["。"]]},{"verse":10,"text":"わたしはまた、あなたがたをエジプトの地,ちから連,つれ上,のぼり、四十年,ねんのあいだ荒野,あらので、あなたがたを導,みちびき、アモリびとの地,ちを獲,えさせた。","tok":[["わたし"],["は"],["また"],["、"],["あなた"],["がた"],["を"],["エジプト"],["の"],["地","ち"],["から"],["連れ上り","つれのぼり"],["、"],["四十","よんじゅう"],["年","ねん"],["の"],["あいだ"],["荒野","あらの"],["で"],["、"],["あなた"],["がた"],["を"],["導き","みちびき"],["、"],["アモリ"],["びと"],["の"],["地","ち"],["を"],["獲させた","えさせた"],["。"]]},{"verse":11,"text":"わたしはあなたがたの子,こらのうちから預言者,よげんしゃを起,おこし、あなたがたの若者,わかもののうちからナジルびとを起,おこした。イスラエルの人々,ひとびとよ、そうではないか」と主,しゅは言,いわれる。","tok":[["わたし"],["は"],["あなた"],["がた"],["の"],["子","こ"],["ら"],["の"],["うち"],["から"],["預言者","よげんしゃ"],["を"],["起こし","おこし"],["、"],["あなた"],["がた"],["の"],["若者","わかもの"],["の"],["うち"],["から"],["ナジル"],["びと"],["を"],["起こした","おこした"],["。"],["イスラエル"],["の"],["人々","ひとびと"],["よ"],["、"],["そう"],["で"],["は"],["ない"],["か"],["」"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":12,"text":"「ところがあなたがたはナジルびとに酒,さけを飲,のませ、預言者,よげんしゃに命,めいじて『預言,よげんするな』と言,いう。","tok":[["「"],["ところ"],["が"],["あなた"],["がた"],["は"],["ナジル"],["びと"],["に"],["酒","さけ"],["を"],["飲ませ","のませ"],["、"],["預言者","よげんしゃ"],["に"],["命じて","めいじて"],["『"],["預言","よげん"],["する"],["な"],["』"],["と"],["言う","いう"],["。"]]},{"verse":13,"text":"見,みよ、わたしは麦,むぎ束,たばをいっぱい積,つんだ車,くるまが物,ものを圧,あっするように、あなたがたをその所,ところで圧,あっする。","tok":[["見よ","みよ"],["、"],["わたし"],["は"],["麦","むぎ"],["束","たば"],["を"],["いっぱい"],["積んだ","つんだ"],["車","くるま"],["が"],["物","もの"],["を"],["圧する","あっする"],["よう"],["に"],["、"],["あなた"],["がた"],["を"],["その"],["所","ところ"],["で"],["圧する","あっする"],["。"]]},{"verse":14,"text":"速,はやく走,はしる者,ものも逃,にげ場,ばを失,うしない、強,つよい者,ものもその力,ちからをふるうことができず、勇士,ゆうしもその命,いのちを救,すくうことができない。","tok":[["速く","はやく"],["走る","はしる"],["者","もの"],["も"],["逃","にげ"],["場","ば"],["を"],["失ない","うしない"],["、"],["強い","つよい"],["者","もの"],["も"],["その"],["力","ちから"],["を"],["ふるう"],["こと"],["が"],["できず"],["、"],["勇士","ゆうし"],["も"],["その"],["命","いのち"],["を"],["救う","すくう"],["こと"],["が"],["できない"],["。"]]},{"verse":15,"text":"弓,ゆみをとる者,ものも立,たつことができず、足早,あしばやの者,ものも自分,じぶんを救,すくうことができず、馬,うまに乗,のる者,ものもその命,いのちを救,すくうことができない。","tok":[["弓","ゆみ"],["を"],["とる"],["者","もの"],["も"],["立つ","たつ"],["こと"],["が"],["できず"],["、"],["足早","あしばや"],["の"],["者","もの"],["も"],["自分","じぶん"],["を"],["救う","すくう"],["こと"],["が"],["できず"],["、"],["馬","うま"],["に"],["乗る","のる"],["者","もの"],["も"],["その"],["命","いのち"],["を"],["救う","すくう"],["こと"],["が"],["できない"],["。"]]},{"verse":16,"text":"勇士,ゆうしのうちの雄々,おおしい心,こころの者,ものもその日,ひには裸,はだかで逃,にげる」と主,しゅは言,いわれる。","tok":[["勇士","ゆうし"],["の"],["うち"],["の"],["雄々しい","おおしい"],["心","こころ"],["の"],["者","もの"],["も"],["その"],["日","ひ"],["に"],["は"],["裸","はだか"],["で"],["逃る","にげる"],["」"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]}]
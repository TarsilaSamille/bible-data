[{"verse":1,"text":"「バシャンの雌牛,めうしどもよ、この言葉,ことばを聞,きけ。あなたがたはサマリヤの山,やまにおり、弱,よわい者,ものをしえたげ、貧,まずしい者,ものを圧迫,あっぱくし、またその主人,しゅじんに向,むかって、『持,もってきて、わたしたちに飲,のませよ』と言,いう。","tok":[["「"],["バシャン"],["の"],["雌牛","めうし"],["ども"],["よ"],["、"],["この"],["言葉","ことば"],["を"],["聞け","きけ"],["。"],["あなた"],["がた"],["は"],["サマリヤ"],["の"],["山","やま"],["に"],["おり"],["、"],["弱い","よわい"],["者","もの"],["を"],["し"],["えたげ"],["、"],["貧しい","まずしい"],["者","もの"],["を"],["圧迫","あっぱく"],["し"],["、"],["また"],["その"],["主人","しゅじん"],["に"],["向かって","むかって"],["、"],["『"],["持って","もって"],["きて"],["、"],["わたしたち"],["に"],["飲ませ","のませ"],["よ"],["』"],["と"],["言う","いう"],["。"]]},{"verse":2,"text":"主,しゅなる神,かみはご自分,じぶんの聖,せいなることによって誓,ちかわれた、見,みよ、あなたがたの上,うえにこのような時,ときが来,くる。その時,とき、人々,ひとびとはあなたがたをつり針,はりにかけ、あなたがたの残,のこりの者,ものを魚,うおつり針,ばりにかけて引,ひいて行,いく。","tok":[["主","しゅ"],["なる"],["神","かみ"],["は"],["ご自分","ごじぶん"],["の"],["聖","せい"],["なる"],["こと"],["によって"],["誓われた","ちかわれた"],["、"],["見よ","みよ"],["、"],["あなた"],["がた"],["の"],["上","うえ"],["に"],["この"],["よう"],["な"],["時","とき"],["が"],["来る","くる"],["。"],["その"],["時","とき"],["、"],["人々","ひとびと"],["は"],["あなた"],["がた"],["を"],["つり針","つりはり"],["に"],["かけ"],["、"],["あなた"],["がた"],["の"],["残り","のこり"],["の"],["者","もの"],["を"],["魚","う"],["おつり針","おつりばり"],["に"],["かけて"],["引いて","ひいて"],["行く","いく"],["。"]]},{"verse":3,"text":"あなたがたはおのおのまっすぐに石,いしがきの破,やぶれた所,ところを出,でて、ハルモンに追,おいやられる」と主,しゅは言,いわれる。","tok":[["あなた"],["がた"],["は"],["おのおの"],["まっすぐ"],["に"],["石がき","いしがき"],["の"],["破れた","やぶれた"],["所","ところ"],["を"],["出て","でて"],["、"],["ハルモン"],["に"],["追いやられる","おいやられる"],["」"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":4,"text":"「あなたがたはベテルへ行,いって罪,つみを犯,おかし、ギルガルへ行,いって、とがを増,まし加,くわえよ。朝,あさごとに、あなたがたの犠牲,ぎせいを携,たずさえて行,いけ、三日,かごとに、あなたがたの十分,ぶんの一を携,たずさえて行,いけ。","tok":[["「"],["あなた"],["がた"],["は"],["ベテル"],["へ"],["行って","いって"],["罪","つみ"],["を"],["犯し","おかし"],["、"],["ギルガル"],["へ"],["行って","いって"],["、"],["とが"],["を"],["増し加え","ましくわえ"],["よ"],["。"],["朝","あさ"],["ごと"],["に"],["、"],["あなた"],["がた"],["の"],["犠牲","ぎせい"],["を"],["携えて","たずさえて"],["行け","いけ"],["、"],["三日","かごと"],["に"],["、"],["あなた"],["がた"],["の"],["十分","ぶん"],["の"],["一","いち"],["を"],["携えて","たずさえて"],["行け","いけ"],["。"]]},{"verse":5,"text":"種,たねを入,いれたパンの感謝祭,かんしゃさいをささげ、心,こころよりの供,そなえ物,ものをふれ示,しめせ。イスラエルの人々,ひとびとよ、あなたがたはこのようにするのを好,このんでいる」と主,しゅなる神,かみは言,いわれる。","tok":[["種","たね"],["を"],["入れた","いれた"],["パン"],["の"],["感謝祭","かんしゃさい"],["を"],["ささげ"],["、"],["心","こころ"],["より"],["の"],["供え物","そなえもの"],["を"],["ふれ"],["示","しめせ"],["。"],["イスラエル"],["の"],["人々","ひとびと"],["よ"],["、"],["あなた"],["がた"],["は"],["この"],["よう"],["に"],["する"],["の"],["を"],["好んで","このんで"],["いる"],["」"],["と"],["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"]]},{"verse":6,"text":"「わたしはまた、あなたがたのすべての町,まちであなたがたの歯,はを清,きよくし、あなたがたのすべての所,ところでパンを乏,とぼしくした。それでも、あなたがたはわたしに帰,かえらなかった」と主,しゅは言,いわれる。","tok":[["「"],["わたし"],["は"],["また"],["、"],["あなた"],["がた"],["の"],["すべて"],["の"],["町","まち"],["で"],["あなた"],["がた"],["の"],["歯","は"],["を"],["清く","きよく"],["し"],["、"],["あなた"],["がた"],["の"],["すべて"],["の"],["所","ところ"],["で"],["パン"],["を"],["乏く","とぼしく"],["した"],["。"],["それ"],["で"],["も"],["、"],["あなた"],["がた"],["は"],["わたし"],["に"],["帰えらなかった","かえらなかった"],["」"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":7,"text":"「わたしはまた、刈入,かりいれまでなお三月,つきあるのに雨,あめをとどめて、あなたがたの上,うえにくださず、この町,まちには雨,あめを降,ふらし、かの町,まちには雨,あめを降,ふらさず、この畑,はたけは雨,あめをえ、かの畑,はたけは雨,あめをえないで枯,かれた。","tok":[["「"],["わたし"],["は"],["また"],["、"],["刈入れ","かりいれ"],["まで"],["なお"],["三","さん"],["月","がつ"],["のに"],["雨","あめ"],["を"],["とどめて"],["、"],["あなた"],["がた"],["の"],["上","うえ"],["に"],["くださず"],["、"],["この"],["町","まち"],["に"],["は"],["雨","あめ"],["を"],["降らし","ふらし"],["、"],["かの"],["町","まち"],["に"],["は"],["雨","あめ"],["を"],["降らさず","ふらさず"],["、"],["この"],["畑","はたけ"],["は"],["雨","あめ"],["を"],["え"],["、"],["かの"],["畑","はたけ"],["は"],["雨","あめ"],["を"],["えないで"],["枯た","かれた"],["。"]]},{"verse":8,"text":"そこで二つ三つの町,まちが一つの町,まちによろめいて行,いって、水,みずを飲,のんでも、飽,あくことができなかった。それでも、あなたがたはわたしに帰,かえらなかった」と主,しゅは言,いわれる。","tok":[["そこ"],["で"],["二","ふた"],["つ"],["三","みっ"],["つ"],["の"],["町","まち"],["が"],["一","ひと"],["つ"],["の"],["町","まち"],["に"],["よろめいて"],["行って","いって"],["、"],["水","みず"],["を"],["飲","のん"],["で"],["も"],["、"],["飽く","あく"],["こと"],["が"],["できなかった"],["。"],["それ"],["で"],["も"],["、"],["あなた"],["がた"],["は"],["わたし"],["に"],["帰えらなかった","かえらなかった"],["」"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":9,"text":"「わたしは立,たち枯,がれと腐,くさり穂,ほとをもってあなたがたを撃,うち、あなたがたの園,そのと、ぶどう畑,はたけとを荒,あらした。いちじくの木,きとオリブの木,きとは、いなごが食,くった。それでも、あなたがたはわたしに帰,かえらなかった」と主,しゅは言,いわれる。","tok":[["「"],["わたし"],["は"],["立ち枯れ","たちがれ"],["と"],["腐り","くさり"],["穂","ほ"],["と"],["を"],["もって"],["あなた"],["がた"],["を"],["撃ち","うち"],["、"],["あなた"],["がた"],["の"],["園","その"],["と"],["、"],["ぶどう"],["畑","はたけ"],["と"],["を"],["荒した","あらした"],["。"],["いちじく"],["の"],["木","き"],["と"],["オリブ"],["の"],["木","き"],["と"],["は"],["、"],["いなご"],["が"],["食った","くった"],["。"],["それ"],["で"],["も"],["、"],["あなた"],["がた"],["は"],["わたし"],["に"],["帰えらなかった","かえらなかった"],["」"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":10,"text":"「わたしはエジプトにしたようにあなたがたのうちに疫病,えきびょうを送,おくり、つるぎをもってあなたがたの若者,わかものを殺,ころし、あなたがたの馬,うまを奪,うばい去,さり、あなたがたの宿営,しゅくえいの臭気,しゅうきを上,のぼらせて、あなたがたの鼻,はなをつかせた。それでも、あなたがたはわたしに帰,かえらなかった」と主,しゅは言,いわれる。","tok":[["「"],["わたし"],["は"],["エジプト"],["に"],["した"],["よう"],["に"],["あなた"],["がた"],["の"],["うち"],["に"],["疫病","えきびょう"],["を"],["送り","おくり"],["、"],["つるぎ"],["を"],["もって"],["あなた"],["がた"],["の"],["若者","わかもの"],["を"],["殺ろし","ころし"],["、"],["あなた"],["がた"],["の"],["馬","うま"],["を"],["奪い去り","うばいさり"],["、"],["あなた"],["がた"],["の"],["宿営","しゅくえい"],["の"],["臭気","しゅうき"],["を"],["上らせて","のぼらせて"],["、"],["あなた"],["がた"],["の"],["鼻","はな"],["を"],["つかせた"],["。"],["それ"],["で"],["も"],["、"],["あなた"],["がた"],["は"],["わたし"],["に"],["帰えらなかった","かえらなかった"],["」"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":11,"text":"「わたしはあなたがたのうちの町,まちを神,かみがソドムとゴモラを滅,ほろぼされた時,ときのように滅,ほろぼしたので、あなたがたは炎,ほのおの中,なかから取,とり出,だされた燃,もえさしのようであった。それでも、あなたがたはわたしに帰,かえらなかった」と主,しゅは言,いわれる。","tok":[["「"],["わたし"],["は"],["あなた"],["がた"],["の"],["うち"],["の"],["町","まち"],["を"],["神","かみ"],["が"],["ソドム"],["と"],["ゴモラ"],["を"],["滅ぼされた","ほろぼされた"],["時","とき"],["の"],["よう"],["に"],["滅ぼした","ほろぼした"],["ので"],["、"],["あなた"],["がた"],["は"],["炎","ほのお"],["の"],["中","なか"],["から"],["取出された","とりだされた"],["燃えさし","もえさし"],["の"],["よう"],["で"],["あった"],["。"],["それ"],["で"],["も"],["、"],["あなた"],["がた"],["は"],["わたし"],["に"],["帰えらなかった","かえらなかった"],["」"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":12,"text":"「それゆえイスラエルよ、わたしはこのようにあなたに行,おこなう。わたしはこれを行,おこなうゆえ、イスラエルよ、あなたの神,かみに会,あう備,そなえをせよ」。","tok":[["「"],["それ"],["ゆえ"],["イスラエル"],["よ"],["、"],["わたし"],["は"],["この"],["よう"],["に"],["あなた"],["に"],["行なう","おこなう"],["。"],["わたし"],["は"],["これ"],["を"],["行なう","おこなう"],["ゆえ"],["、"],["イスラエル"],["よ"],["、"],["あなた"],["の"],["神","かみ"],["に"],["会う","あう"],["備","そなえ"],["を"],["せよ"],["」"],["。"]]},{"verse":13,"text":"見,みよ、彼,かれは山,やまを造,つくり、風,かぜを創造,そうぞうし、人,ひとにその思,おもいのいかなるかを示,しめし、また、あけぼのを変,かえて暗,くらやみとなし、地,ちの高,たかい所,ところを踏,ふまれる者,もの、その名,なを万軍,ばんぐんの神,かみ、主,しゅと言,いう。","tok":[["見よ","みよ"],["、"],["彼","かれ"],["は"],["山","やま"],["を"],["造","つくり"],["、"],["風","かぜ"],["を"],["創造","そうぞう"],["し"],["、"],["人","ひと"],["に"],["その"],["思い","おもい"],["の"],["いかなる"],["か"],["を"],["示めし","しめし"],["、"],["また"],["、"],["あけぼの"],["を"],["変えて","かえて"],["暗やみ","くらやみ"],["と"],["なし"],["、"],["地","ち"],["の"],["高い","たかい"],["所","ところ"],["を"],["踏まれる","ふまれる"],["者","もの"],["、"],["その"],["名","な"],["を"],["万","まん"],["軍","ぐん"],["の"],["神","かみ"],["、"],["主","しゅ"],["と"],["言う","いう"],["。"]]}]
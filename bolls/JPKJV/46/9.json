[{"verse":1,"text":"わたしは自由,じゆうな者,ものではないか。使徒,しとではないか。わたしたちの主,しゅイエスを見,みたではないか。あなたがたは、主,しゅにあるわたしの働,はたらきの実,みではないか。","tok":[["わたし"],["は"],["自由","じゆう"],["な"],["者","もの"],["で"],["は"],["ない"],["か"],["。"],["使徒","しと"],["で"],["は"],["ない"],["か"],["。"],["わたしたち"],["の"],["主","しゅ"],["イエス"],["を"],["見たで","みたで"],["は"],["ない"],["か"],["。"],["あなた"],["がた"],["は"],["、"],["主に","しゅに"],["ある"],["わたし"],["の"],["働らき","はたらき"],["の"],["実","み"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":2,"text":"わたしは、ほかの人,ひとに対,たいしては使徒,しとでないとしても、あなたがたには使徒,しとである。あなたがたが主,しゅにあることは、わたしの使徒,しと職,しょくの印,しるしなのである。","tok":[["わたし"],["は"],["、"],["ほか"],["の"],["人","ひと"],["に対して","にたいして"],["は"],["使徒","しと"],["で"],["ない"],["として"],["も"],["、"],["あなた"],["がた"],["に"],["は"],["使徒","しと"],["で"],["ある"],["。"],["あなた"],["がた"],["が"],["主に","しゅに"],["ある"],["こと"],["は"],["、"],["わたし"],["の"],["使徒","しと"],["職","しょく"],["の"],["印","しるし"],["な"],["ので"],["ある"],["。"]]},{"verse":3,"text":"わたしの批判者,ひはんしゃたちに対,たいする弁明,べんめいは、これである。","tok":[["わたし"],["の"],["批判者","ひはんしゃ"],["たち"],["に"],["対する","たいする"],["弁明","べんめい"],["は"],["、"],["これ"],["で"],["ある"],["。"]]},{"verse":4,"text":"わたしたちには、飲,のみ食,くいをする権利,けんりがないのか。","tok":[["わたしたち"],["に"],["は"],["、"],["飲み食い","のみくい"],["を"],["する"],["権利","けんり"],["が"],["ない"],["の"],["か"],["。"]]},{"verse":5,"text":"わたしたちには、ほかの使徒,しとたちや主,しゅの兄弟,きょうだいたちやケパのように、信者,しんじゃである妻,つまを連,つれて歩,あるく権利,けんりがないのか。","tok":[["わたしたち"],["に"],["は"],["、"],["ほか"],["の"],["使徒","しと"],["たち"],["や"],["主","しゅ"],["の"],["兄弟","きょうだい"],["たち"],["や"],["ケパ"],["の"],["よう"],["に"],["、"],["信者","しんじゃ"],["で"],["ある"],["妻","つま"],["を"],["連れて","つれて"],["歩く","あるく"],["権利","けんり"],["が"],["ない"],["の"],["か"],["。"]]},{"verse":6,"text":"それとも、わたしとバルナバとだけには、労働,ろうどうをせずにいる権利,けんりがないのか。","tok":[["それ"],["と"],["も"],["、"],["わたし"],["と"],["バルナバ"],["と"],["だけ"],["に"],["は"],["、"],["労働","ろうどう"],["を"],["せず"],["に"],["いる"],["権利","けんり"],["が"],["ない"],["の"],["か"],["。"]]},{"verse":7,"text":"いったい、自分,じぶんで費用,ひようを出,だして軍隊,ぐんたいに加,くわわる者,ものがあろうか。ぶどう畑,はたけを作,つくっていて、その実,みを食,たべない者,ものがあろうか。また、羊,ひつじを飼,かっていて、その乳,ちちを飲,のまない者,ものがあろうか。","tok":[["いったい"],["、"],["自分","じぶん"],["で"],["費用","ひよう"],["を"],["出して","だして"],["軍隊","ぐんたい"],["に"],["加わわる","くわわる"],["者","もの"],["が"],["あろう"],["か"],["。"],["ぶどう"],["畑","はたけ"],["を"],["作って","つくって"],["いて"],["、"],["その"],["実","み"],["を"],["食べない","たべない"],["者","もの"],["が"],["あろう"],["か"],["。"],["また"],["、"],["羊","ひつじ"],["を"],["飼って","かって"],["いて"],["、"],["その"],["乳","ちち"],["を"],["飲まない","のまない"],["者","もの"],["が"],["あろう"],["か"],["。"]]},{"verse":8,"text":"わたしは、人間,にんげんの考,かんがえでこう言,いうのではない。律法,りっぽうもまた、そのように言,いっているではないか。","tok":[["わたし"],["は"],["、"],["人間","にんげん"],["の"],["考","かんがえ"],["で"],["こう"],["言う","いう"],["ので"],["は"],["ない"],["。"],["律法","りっぽう"],["も"],["また"],["、"],["その"],["よう"],["に"],["言って","いって"],["いるで"],["は"],["ない"],["か"],["。"]]},{"verse":9,"text":"すなわち、モーセの律法,りっぽうに、「穀物,こくもつをこなしている牛,うしに、くつこをかけてはならない」と書,かいてある。神,かみは、牛,うしのことを心,こころにかけておられるのだろうか。","tok":[["すなわち"],["、"],["モーセ"],["の"],["律法","りっぽう"],["に"],["、"],["「"],["穀物","こくもつ"],["を"],["こなして"],["いる"],["牛","うし"],["に"],["、"],["くつ"],["こ"],["を"],["かけて"],["は"],["ならない"],["」"],["と"],["書いて","かいて"],["ある"],["。"],["神","かみ"],["は"],["、"],["牛","うし"],["の"],["こと"],["を"],["心","こころ"],["に"],["かけて"],["おられる"],["の"],["だろう"],["か"],["。"]]},{"verse":10,"text":"それとも、もっぱら、わたしたちのために言,いっておられるのか。もちろん、それはわたしたちのためにしるされたのである。すなわち、耕,たがやす者,ものは望,のぞみをもって耕,たがやし、穀物,こくもつをこなす者,ものは、その分,わけ前,まえをもらう望,のぞみをもってこなすのである。","tok":[["それ"],["と"],["も"],["、"],["もっぱら"],["、"],["わたしたち"],["の"],["ため"],["に"],["言って","いって"],["おられる"],["の"],["か"],["。"],["もちろん"],["、"],["それ"],["は"],["わたしたち"],["の"],["ため"],["に"],["しるされた"],["ので"],["ある"],["。"],["すなわち"],["、"],["耕やす","たがやす"],["者","もの"],["は"],["望み","のぞみ"],["を"],["もって"],["耕やし","たがやし"],["、"],["穀物","こくもつ"],["を"],["こなす"],["者","もの"],["は"],["、"],["その"],["分け前","わけまえ"],["を"],["もらう"],["望み","のぞみ"],["を"],["もって"],["こなす"],["ので"],["ある"],["。"]]},{"verse":11,"text":"もしわたしたちが、あなたがたのために霊,れいのものをまいたのなら、肉,にくのものをあなたがたから刈,かりとるのは、行,ゆき過,すぎだろうか。","tok":[["もし"],["わたしたち"],["が"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["霊","れい"],["の"],["もの"],["を"],["まいた"],["の"],["なら"],["、"],["肉","にく"],["の"],["もの"],["を"],["あなた"],["がた"],["から"],["刈","かり"],["とる"],["の"],["は"],["、"],["行き","ゆき"],["過だろう","すぎだろう"],["か"],["。"]]},{"verse":12,"text":"もしほかの人々,ひとびとが、あなたがたに対,たいするこの権利,けんりにあずかっているとすれば、わたしたちはなおさらのことではないか。しかしわたしたちは、この権利,けんりを利,り用,ようせず、かえってキリストの福音,ふくいんの妨,さまたげにならないようにと、すべてのことを忍,しのんでいる。","tok":[["もし"],["ほか"],["の"],["人々","ひとびと"],["が"],["、"],["あなた"],["がた"],["に"],["対する","たいする"],["この"],["権利","けんり"],["に"],["あずかって"],["いる"],["と"],["すれば"],["、"],["わたしたち"],["は"],["なおさら"],["の"],["こと"],["で"],["は"],["ない"],["か"],["。"],["しかし"],["わたしたち"],["は"],["、"],["この"],["権利","けんり"],["を"],["利用","りよう"],["せず"],["、"],["かえって"],["キリスト"],["の"],["福音","ふくいん"],["の"],["妨げ","さまたげ"],["に"],["ならない"],["よう"],["に"],["と"],["、"],["すべて"],["の"],["こと"],["を"],["忍んで","しのんで"],["いる"],["。"]]},{"verse":13,"text":"あなたがたは、宮仕,みやづかえをしている人,ひとたちは宮,みやから下,さがる物,ものを食,たべ、祭壇,さいだんに奉仕,ほうししている人,ひとたちは祭壇,さいだんの供,そなえ物,ものの分,わけ前,まえにあずかることを、知,しらないのか。","tok":[["あなた"],["がた"],["は"],["、"],["宮仕え","みやづかえ"],["を"],["して"],["いる"],["人","ひと"],["たち"],["は"],["宮","みや"],["から"],["下がる","さがる"],["物","もの"],["を"],["食べ","たべ"],["、"],["祭壇","さいだん"],["に"],["奉仕","ほうし"],["して"],["いる"],["人","ひと"],["たち"],["は"],["祭壇","さいだん"],["の"],["供え物","そなえもの"],["の"],["分け前","わけまえ"],["に"],["あずかる"],["こと"],["を"],["、"],["知らない","しらない"],["の"],["か"],["。"]]},{"verse":14,"text":"それと同様,どうように、主,しゅは、福音,ふくいんを宣,のべ伝,つたえている者,ものたちが福音,ふくいんによって生活,せいかつすべきことを、定,さだめられたのである。","tok":[["それ"],["と"],["同様","どうよう"],["に"],["、"],["主","しゅ"],["は"],["、"],["福音","ふくいん"],["を"],["宣べ伝えて","のべつたえて"],["いる"],["者","もの"],["たち"],["が"],["福音","ふくいん"],["によって"],["生活","せいかつ"],["すべき"],["こと"],["を"],["、"],["定められた","さだめられた"],["ので"],["ある"],["。"]]},{"verse":15,"text":"しかしわたしは、これらの権利,けんりを一つも利,り用,ようしなかった。また、自分,じぶんがそうしてもらいたいから、このように書,かくのではない。そうされるよりは、死,しぬ方,ほうがましである。わたしのこの誇,ほこりは、何者,なにものにも奪,うばい去,さられてはならないのだ。","tok":[["しかし"],["わたし"],["は"],["、"],["これ"],["ら"],["の"],["権利","けんり"],["を"],["一","ひと"],["つ"],["も"],["利用","りよう"],["しなかった"],["。"],["また"],["、"],["自分","じぶん"],["が"],["そう"],["して"],["もらいたい"],["から"],["、"],["この"],["よう"],["に"],["書く","かく"],["ので"],["は"],["ない"],["。"],["そう"],["される"],["より"],["は"],["、"],["死ぬ","しぬ"],["方","ほう"],["が"],["まし"],["で"],["ある"],["。"],["わたし"],["の"],["この"],["誇","ほこり"],["は"],["、"],["何者","なにもの"],["に"],["も"],["奪い去られて","うばいさられて"],["は"],["ならない"],["の"],["だ"],["。"]]},{"verse":16,"text":"わたしが福音,ふくいんを宣,のべ伝,つたえても、それは誇,ほこりにはならない。なぜなら、わたしは、そうせずにはおれないからである。もし福音,ふくいんを宣,のべ伝,つたえないなら、わたしはわざわいである。","tok":[["わたし"],["が"],["福音","ふくいん"],["を"],["宣べ伝えて","のべつたえて"],["も"],["、"],["それ"],["は"],["誇","ほこり"],["に"],["は"],["ならない"],["。"],["なぜ"],["なら"],["、"],["わたし"],["は"],["、"],["そう"],["せず"],["に"],["は"],["おれない"],["から"],["で"],["ある"],["。"],["もし"],["福音","ふくいん"],["を"],["宣べ伝えないなら","のべつたえないなら"],["、"],["わたし"],["は"],["わざわい"],["で"],["ある"],["。"]]},{"verse":17,"text":"進,すすんでそれをすれば、報酬,ほうしゅうを受,うけるであろう。しかし、進,すすんでしないとしても、それは、わたしにゆだねられた務,つとめなのである。","tok":[["進","す"],["すんで"],["それ"],["を"],["すれば"],["、"],["報酬","ほうしゅう"],["を"],["受るで","うけるで"],["あろう"],["。"],["しかし"],["、"],["進","す"],["すんで"],["しない"],["として"],["も"],["、"],["それ"],["は"],["、"],["わたし"],["に"],["ゆだねられた"],["務め","つとめ"],["な"],["ので"],["ある"],["。"]]},{"verse":18,"text":"それでは、その報酬,ほうしゅうはなんであるか。福音,ふくいんを宣,のべ伝,つたえるのにそれを無,む代価,だいかで提供,ていきょうし、わたしが宣教者,せんきょうしゃとして持,もつ権利,けんりを利,り用,ようしないことである。","tok":[["それ"],["で"],["は"],["、"],["その"],["報酬","ほうしゅう"],["は"],["なん"],["で"],["ある"],["か"],["。"],["福音","ふくいん"],["を"],["宣べ伝える","のべつたえる"],["のに"],["それ"],["を"],["無","む"],["代価","だいか"],["で"],["提供","ていきょう"],["し"],["、"],["わたし"],["が"],["宣教者","せんきょうしゃ"],["として"],["持つ","もつ"],["権利","けんり"],["を"],["利用","りよう"],["しない"],["こと"],["で"],["ある"],["。"]]},{"verse":19,"text":"わたしは、すべての人,ひとに対,たいして自由,じゆうであるが、できるだけ多,おおくの人,ひとを得,えるために、自,みずから進,すすんですべての人,ひとの奴隷,どれいになった。","tok":[["わたし"],["は"],["、"],["すべて"],["の"],["人","ひと"],["に対して","にたいして"],["自由","じゆう"],["で"],["ある"],["が"],["、"],["できる"],["だけ"],["多く","おおく"],["の"],["人","ひと"],["を"],["得る","える"],["ため"],["に"],["、"],["自から","みずから"],["進んで","すすんで"],["すべて"],["の"],["人","ひと"],["の"],["奴隷","どれい"],["に"],["なった"],["。"]]},{"verse":20,"text":"ユダヤ人,じんには、ユダヤ人,じんのようになった。ユダヤ人,じんを得,えるためである。律法,りっぽうの下,もとにある人,ひとには、わたし自身,じしんは律法,りっぽうの下,もとにはないが、律法,りっぽうの下,もとにある者,もののようになった。律法,りっぽうの下,もとにある人,ひとを得,えるためである。","tok":[["ユダヤ人","ゆだやじん"],["に"],["は"],["、"],["ユダヤ人","ゆだやじん"],["の"],["よう"],["に"],["なった"],["。"],["ユダヤ人","ゆだやじん"],["を"],["得る","える"],["ため"],["で"],["ある"],["。"],["律法","りっぽう"],["の"],["下","もと"],["に"],["ある"],["人","ひと"],["に"],["は"],["、"],["わたし"],["自身","じしん"],["は"],["律法","りっぽう"],["の"],["下","もと"],["に"],["は"],["ない"],["が"],["、"],["律法","りっぽう"],["の"],["下","もと"],["に"],["ある"],["者","もの"],["の"],["よう"],["に"],["なった"],["。"],["律法","りっぽう"],["の"],["下","もと"],["に"],["ある"],["人","ひと"],["を"],["得る","える"],["ため"],["で"],["ある"],["。"]]},{"verse":21,"text":"律法,りっぽうのない人,ひとには――わたしは神,かみの律法,りっぽうの外,そとにあるのではなく、キリストの律法,りっぽうの中,なかにあるのだが――律法,りっぽうのない人,ひとのようになった。律法,りっぽうのない人,ひとを得,えるためである。","tok":[["律法","りっぽう"],["の"],["ない"],["人","ひと"],["に"],["は"],["―"],["―"],["わたし"],["は"],["神","かみ"],["の"],["律法","りっぽう"],["の"],["外","そと"],["に"],["ある"],["ので"],["は"],["なく"],["、"],["キリスト"],["の"],["律法","りっぽう"],["の"],["中","なか"],["に"],["ある"],["の"],["だ"],["が"],["―"],["―"],["律法","りっぽう"],["の"],["ない"],["人","ひと"],["の"],["よう"],["に"],["なった"],["。"],["律法","りっぽう"],["の"],["ない"],["人","ひと"],["を"],["得る","える"],["ため"],["で"],["ある"],["。"]]},{"verse":22,"text":"弱,よわい人,ひとには弱,よわい者,ものになった。弱,よわい人,ひとを得,えるためである。すべての人,ひとに対,たいしては、すべての人,ひとのようになった。なんとかして幾人,いくにんかを救,すくうためである。","tok":[["弱い","よわい"],["人","ひと"],["に"],["は"],["弱い","よわい"],["者","もの"],["に"],["なった"],["。"],["弱い","よわい"],["人","ひと"],["を"],["得る","える"],["ため"],["で"],["ある"],["。"],["すべて"],["の"],["人","ひと"],["に"],["対し","たいし"],["ては"],["、"],["すべて"],["の"],["人","ひと"],["の"],["よう"],["に"],["なった"],["。"],["なん"],["と"],["か"],["して"],["幾人","いくにん"],["か"],["を"],["救う","すくう"],["ため"],["で"],["ある"],["。"]]},{"verse":23,"text":"福音,ふくいんのために、わたしはどんな事,ことでもする。わたしも共,ともに福音,ふくいんにあずかるためである。","tok":[["福音","ふくいん"],["の"],["ため"],["に"],["、"],["わたし"],["は"],["どんな"],["事","こと"],["で"],["も"],["する"],["。"],["わたし"],["も"],["共","とも"],["に"],["福音","ふくいん"],["に"],["あずかる"],["ため"],["で"],["ある"],["。"]]},{"verse":24,"text":"あなたがたは知,しらないのか。競技場,きょうぎじょうで走,はしる者,ものは、みな走,はしりはするが、賞,しょうを得,える者,ものはひとりだけである。あなたがたも、賞,しょうを得,えるように走,はしりなさい。","tok":[["あなた"],["がた"],["は"],["知らない","しらない"],["の"],["か"],["。"],["競技場","きょうぎじょう"],["で"],["走る","はしる"],["者","もの"],["は"],["、"],["みな"],["走り","はしり"],["は"],["する"],["が"],["、"],["賞","しょう"],["を"],["得る","える"],["者","もの"],["は"],["ひとり"],["だけ"],["で"],["ある"],["。"],["あなた"],["がた"],["も"],["、"],["賞","しょう"],["を"],["得る","える"],["よう"],["に"],["走り","はしり"],["なさい"],["。"]]},{"verse":25,"text":"しかし、すべて競技,きょうぎをする者,ものは、何,なにごとにも節制,せっせいをする。彼,かれらは朽,くちる冠,かんむりを得,えるためにそうするが、わたしたちは朽,くちない冠,かんむりを得,えるためにそうするのである。","tok":[["しかし"],["、"],["すべて"],["競技","きょうぎ"],["を"],["する"],["者","もの"],["は"],["、"],["何ごと","なにごと"],["に"],["も"],["節制","せっせい"],["を"],["する"],["。"],["彼","かれ"],["ら"],["は"],["朽ちる","くちる"],["冠","かんむり"],["を"],["得る","える"],["ため"],["に"],["そう"],["する"],["が"],["、"],["わたしたち"],["は"],["朽ちない","くちない"],["冠","かんむり"],["を"],["得る","える"],["ため"],["に"],["そう"],["する"],["ので"],["ある"],["。"]]},{"verse":26,"text":"そこで、わたしは目標,もくひょうのはっきりしないような走,はしり方,かたをせず、空,くうを打,うつような拳闘,けんとうはしない。","tok":[["そこ"],["で"],["、"],["わたし"],["は"],["目標","もくひょう"],["の"],["はっきり"],["しない"],["よう"],["な"],["走り","はしり"],["方","かた"],["を"],["せず"],["、"],["空","くう"],["を"],["打つ","うつ"],["よう"],["な"],["拳闘","けんとう"],["は"],["しない"],["。"]]},{"verse":27,"text":"すなわち、自分,じぶんのからだを打,うちたたいて服従,ふくじゅうさせるのである。そうしないと、ほかの人,ひとに宣,のべ伝,つたえておきながら、自分,じぶんは失格者,しっかくしゃになるかも知,しれない。","tok":[["すなわち"],["、"],["自分","じぶん"],["の"],["からだ"],["を"],["打ちたたいて","うちたたいて"],["服従","ふくじゅう"],["させる"],["ので"],["ある"],["。"],["そう"],["しない"],["と"],["、"],["ほか"],["の"],["人","ひと"],["に"],["宣べ伝えて","のべつたえて"],["おき"],["ながら"],["、"],["自分","じぶん"],["は"],["失格者","しっかくしゃ"],["に"],["なる"],["か"],["も"],["知れない","しれない"],["。"]]}]
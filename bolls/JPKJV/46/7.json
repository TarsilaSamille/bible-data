[{"verse":1,"text":"さて、あなたがたが書,かいてよこした事,ことについて答,こたえると、男子,だんしは婦人,ふじんにふれないがよい。","tok":[["さて"],["、"],["あなた"],["がた"],["が"],["書いて","かいて"],["よこした"],["事","こと"],["について"],["答","こたえ"],["る"],["と"],["、"],["男子","だんし"],["は"],["婦人","ふじん"],["に"],["ふれない"],["が"],["よい"],["。"]]},{"verse":2,"text":"しかし、不品行,ふひんこうに陥,おちいることのないために、男子,だんしはそれぞれ自分,じぶんの妻,つまを持,もち、婦人,ふじんもそれぞれ自分,じぶんの夫,おっとを持,もつがよい。","tok":[["しかし"],["、"],["不品行","ふひんこう"],["に"],["陥ち","おち"],["いる"],["こと"],["の"],["ない"],["ため"],["に"],["、"],["男子","だんし"],["は"],["それぞれ"],["自分","じぶん"],["の"],["妻","つま"],["を"],["持","もち"],["、"],["婦人","ふじん"],["も"],["それぞれ"],["自分","じぶん"],["の"],["夫","おっと"],["を"],["持つ","もつ"],["が"],["よい"],["。"]]},{"verse":3,"text":"夫,おっとは妻,つまにその分,ぶんを果,はたし、妻,つまも同様,どうように夫,おっとにその分,ぶんを果,はたすべきである。","tok":[["夫","おっと"],["は"],["妻","つま"],["に"],["その"],["分","ぶん"],["を"],["果たし","はたし"],["、"],["妻","つま"],["も"],["同様","どうよう"],["に"],["夫","おっと"],["に"],["その"],["分","ぶん"],["を"],["果たすべきで","はたすべきで"],["ある"],["。"]]},{"verse":4,"text":"妻,つまは自分,じぶんのからだを自由,じゆうにすることはできない。それができるのは夫,おっとである。夫,おっとも同様,どうように自分,じぶんのからだを自由,じゆうにすることはできない。それができるのは妻,つまである。","tok":[["妻","つま"],["は"],["自分","じぶん"],["の"],["からだ"],["を"],["自由","じゆう"],["に"],["する"],["こと"],["は"],["できない"],["。"],["それ"],["が"],["できる"],["の"],["は"],["夫","おっと"],["で"],["ある"],["。"],["夫","おっと"],["も"],["同様","どうよう"],["に"],["自分","じぶん"],["の"],["からだ"],["を"],["自由","じゆう"],["に"],["する"],["こと"],["は"],["できない"],["。"],["それ"],["が"],["できる"],["の"],["は"],["妻","つま"],["で"],["ある"],["。"]]},{"verse":5,"text":"互,たがいに拒,こばんではいけない。ただし、合意,ごういの上,うえで祈,いのりに専心,せんしんするために、しばらく相別,あいわかれ、それからまた一緒,いっしょになることは、さしつかえない。そうでないと、自制力,じせいりょくのないのに乗,じょうじて、サタンがあなたがたを誘惑,ゆうわくするかも知,しれない。","tok":[["互","たがい"],["に"],["拒","こばん"],["で"],["は"],["いけない"],["。"],["ただし"],["、"],["合意","ごうい"],["の"],["上","うえ"],["で"],["祈","いのり"],["に"],["専心","せんしん"],["する"],["ため"],["に"],["、"],["しばらく"],["相","あい"],["別かれ","わかれ"],["、"],["それ"],["から"],["また"],["一緒","いっしょ"],["に"],["なる"],["こと"],["は"],["、"],["さしつかえない"],["。"],["そう"],["で"],["ない"],["と"],["、"],["自制力","じせいりょく"],["の"],["ない"],["のに"],["乗じて","じょうじて"],["、"],["サタン"],["が"],["あなた"],["がた"],["を"],["誘惑","ゆうわく"],["する"],["か"],["も"],["知れない","しれない"],["。"]]},{"verse":6,"text":"以上,いじょうのことは、譲歩,じょうほのつもりで言,いうのであって、命令,めいれいするのではない。","tok":[["以上","いじょう"],["の"],["こと"],["は"],["、"],["譲歩","じょうほ"],["の"],["つもり"],["で"],["言う","いう"],["ので"],["あって"],["、"],["命令","めいれい"],["する"],["ので"],["は"],["ない"],["。"]]},{"verse":7,"text":"わたしとしては、みんなの者,ものがわたし自身,じしんのようになってほしい。しかし、ひとりびとり神,かみからそれぞれの賜物,たまものをいただいていて、ある人,ひとはこうしており、他,たの人,ひとはそうしている。","tok":[["わたし"],["として"],["は"],["、"],["みんな"],["の"],["者","もの"],["が"],["わたし"],["自身","じしん"],["の"],["よう"],["に"],["なって"],["ほしい"],["。"],["しかし"],["、"],["ひとりびとり"],["神","かみ"],["から"],["それぞれ"],["の"],["賜物","たまもの"],["を"],["いただいて"],["いて"],["、"],["ある"],["人","ひと"],["は"],["こう"],["して"],["おり"],["、"],["他","た"],["の"],["人","ひと"],["は"],["そう"],["して"],["いる"],["。"]]},{"verse":8,"text":"次,つぎに、未婚者,みこんしゃたちとやもめたちとに言,いうが、わたしのように、ひとりでおれば、それがいちばんよい。","tok":[["次","つぎ"],["に"],["、"],["未婚者","みこんしゃ"],["たち"],["と"],["やもめ"],["たち"],["と"],["に"],["言う","いう"],["が"],["、"],["わたし"],["の"],["よう"],["に"],["、"],["ひとり"],["で"],["おれば"],["、"],["それ"],["が"],["いちばん"],["よい"],["。"]]},{"verse":9,"text":"しかし、もし自,じ制,せいすることができないなら、結婚,けっこんするがよい。情,じょうの燃,もえるよりは、結婚,けっこんする方,ほうが、よいからである。","tok":[["しかし"],["、"],["もし"],["自制","じせい"],["する"],["こと"],["が"],["できないなら"],["、"],["結婚","けっこん"],["する"],["が"],["よい"],["。"],["情","じょう"],["の"],["燃える","もえる"],["より"],["は"],["、"],["結婚","けっこん"],["する"],["方","ほう"],["が"],["、"],["よい"],["から"],["で"],["ある"],["。"]]},{"verse":10,"text":"更,さらに、結婚,けっこんしている者,ものたちに命,めいじる。命,めいじるのは、わたしではなく主,しゅであるが、妻,つまは夫,おっとから別,わかれてはいけない。","tok":[["更に","さらに"],["、"],["結婚","けっこん"],["して"],["いる"],["者","もの"],["たち"],["に"],["命じる","めいじる"],["。"],["命じる","めいじる"],["の"],["は"],["、"],["わたし"],["で"],["は"],["なく"],["主","しゅ"],["で"],["ある"],["が"],["、"],["妻","つま"],["は"],["夫","おっと"],["から"],["別かれて","わかれて"],["は"],["いけない"],["。"]]},{"verse":11,"text":"（しかし、万一,まんいち別,わかれているなら、結婚,けっこんしないでいるか、それとも夫,おっとと和解,わかいするかしなさい）。また夫,おっとも妻,つまと離婚,りこんしてはならない。","tok":[["（"],["しかし"],["、"],["万一","まんいち"],["別かれて","わかれて"],["いるなら"],["、"],["結婚","けっこん"],["しないで"],["いる"],["か"],["、"],["それ"],["と"],["も"],["夫","おっと"],["と"],["和解","わかい"],["する"],["か"],["し"],["なさい"],["）"],["。"],["また"],["夫","おっと"],["も"],["妻","つま"],["と"],["離婚","りこん"],["して"],["は"],["ならない"],["。"]]},{"verse":12,"text":"そのほかの人々,ひとびとに言,いう。これを言,いうのは、主,しゅではなく、わたしである。ある兄弟,きょうだいに不信者,ふしんじゃの妻,つまがあり、そして共,ともにいることを喜,よろこんでいる場合,ばあいには、離婚,りこんしてはいけない。","tok":[["その"],["ほか"],["の"],["人々","ひとびと"],["に"],["言う","いう"],["。"],["これ"],["を"],["言う","いう"],["の"],["は"],["、"],["主","しゅ"],["で"],["は"],["なく"],["、"],["わたし"],["で"],["ある"],["。"],["ある"],["兄弟","きょうだい"],["に"],["不","ふ"],["信者","しんじゃ"],["の"],["妻","つま"],["が"],["あり"],["、"],["そして"],["共","とも"],["に"],["いる"],["こと"],["を"],["喜こんで","よろこんで"],["いる"],["場合","ばあい"],["に"],["は"],["、"],["離婚","りこん"],["して"],["は"],["いけない"],["。"]]},{"verse":13,"text":"また、ある婦人,ふじんの夫,おっとが不信者,ふしんじゃであり、そして共,ともにいることを喜,よろこんでいる場合,ばあいには、離婚,りこんしてはいけない。","tok":[["また"],["、"],["ある"],["婦人","ふじん"],["の"],["夫","おっと"],["が"],["不信者","ふ"],["しん"],["じゃ"],["で"],["あり"],["、"],["そして"],["共","とも"],["に"],["いる"],["こと"],["を"],["喜こんで","よろこんで"],["いる"],["場合","ばあい"],["に"],["は"],["、"],["離婚","りこん"],["して"],["は"],["いけない"],["。"]]},{"verse":14,"text":"なぜなら、不信者,ふしんじゃの夫,おっとは妻,つまによってきよめられており、また、不信者,ふしんじゃの妻,つまも夫,おっとによってきよめられているからである。もしそうでなければ、あなたがたの子,こは汚,けがれていることになるが、実際,じっさいはきよいではないか。","tok":[["なぜ"],["なら"],["、"],["不信者","ふしんじゃ"],["の"],["夫","おっと"],["は"],["妻","つま"],["によって"],["きよめられて"],["おり"],["、"],["また"],["、"],["不信者","ふしんじゃ"],["の"],["妻","つま"],["も"],["夫","おっと"],["によって"],["きよめられて"],["いる"],["から"],["で"],["ある"],["。"],["もし"],["そう"],["で"],["なければ"],["、"],["あなた"],["がた"],["の"],["子","こ"],["は"],["汚","け"],["がれ"],["て"],["いる"],["こと"],["に"],["なる"],["が"],["、"],["実際","じっさい"],["は"],["きよいで"],["は"],["ない"],["か"],["。"]]},{"verse":15,"text":"しかし、もし不信者,ふしんじゃの方,ほうが離,はなれて行,いくのなら、離,はなれるままにしておくがよい。兄弟,きょうだいも姉妹,しまいも、こうした場合,ばあいには、束縛,そくばくされてはいない。神,かみは、あなたがたを平和,へいわに暮,くらさせるために、召,めされたのである。","tok":[["しかし"],["、"],["もし"],["不","ふ"],["信者","しんじゃ"],["の"],["方","ほう"],["が"],["離れて","はなれて"],["行く","いく"],["の"],["なら"],["、"],["離れる","はなれる"],["まま"],["に"],["して"],["おく"],["が"],["よい"],["。"],["兄弟","きょうだい"],["も"],["姉妹","しまい"],["も"],["、"],["こう"],["した"],["場合","ばあい"],["に"],["は"],["、"],["束縛","そくばく"],["されて"],["は"],["いない"],["。"],["神","かみ"],["は"],["、"],["あなた"],["がた"],["を"],["平和","へいわ"],["に"],["暮らさせる","くらさせる"],["ため"],["に"],["、"],["召された","めされた"],["ので"],["ある"],["。"]]},{"verse":16,"text":"なぜなら、妻,つまよ、あなたが夫,おっとを救,すくいうるかどうか、どうしてわかるか。また、夫,おっとよ、あなたも妻,つまを救,すくいうるかどうか、どうしてわかるか。","tok":[["なぜ"],["なら"],["、"],["妻","つま"],["よ"],["、"],["あなた"],["が"],["夫","おっと"],["を"],["救い","すくい"],["うる"],["か"],["どう"],["か"],["、"],["どう"],["して"],["わかる"],["か"],["。"],["また"],["、"],["夫","おっと"],["よ"],["、"],["あなた"],["も"],["妻","つま"],["を"],["救い","すくい"],["うる"],["か"],["どう"],["か"],["、"],["どう"],["して"],["わかる"],["か"],["。"]]},{"verse":17,"text":"ただ、各自,かくじは、主,しゅから賜,たまわった分,ぶんに応,おうじ、また神,かみに召,めされたままの状態,じょうたいにしたがって、歩,あゆむべきである。これが、すべての教会,きょうかいに対,たいしてわたしの命,めいじるところである。","tok":[["ただ"],["、"],["各自","かくじ"],["は"],["、"],["主ら","しゅから"],["賜わった","たまわった"],["分","ぶん"],["に"],["応じ","おうじ"],["、"],["また"],["神","かみ"],["に"],["召された","めされた"],["まま"],["の"],["状態","じょうたい"],["に"],["したがって"],["、"],["歩むべきで","あゆむべきで"],["ある"],["。"],["これ"],["が"],["、"],["すべて"],["の"],["教会","きょうかい"],["に対して","にたいして"],["わたし"],["の"],["命じる","めいじる"],["ところ"],["で"],["ある"],["。"]]},{"verse":18,"text":"召,めされたとき割礼,かつれいを受,うけていたら、その跡,あとをなくそうとしないがよい。また、召,めされたとき割礼,かつれいを受,うけていなかったら、割礼,かつれいを受,うけようとしないがよい。","tok":[["召された","めされた"],["とき"],["割礼","かつれい"],["を"],["受て","うけて"],["いたら"],["、"],["その"],["跡","あと"],["を"],["なくそう"],["と"],["しない"],["が"],["よい"],["。"],["また"],["、"],["召された","めされた"],["とき"],["割礼","かつれい"],["を"],["受て","うけて"],["いなかったら"],["、"],["割礼","かつれい"],["を"],["受よう","うけよう"],["と"],["しない"],["が"],["よい"],["。"]]},{"verse":19,"text":"割礼,かつれいがあってもなくても、それは問題,もんだいではない。大事,だいじなのは、ただ神,かみの戒,いましめを守,まもることである。","tok":[["割礼","かつれい"],["が"],["あって"],["も"],["なくて"],["も"],["、"],["それ"],["は"],["問題","もんだい"],["で"],["は"],["ない"],["。"],["大事","だいじ"],["な"],["の"],["は"],["、"],["ただ"],["神","かみ"],["の"],["戒しめ","いましめ"],["を"],["守","まもる"],["こと"],["で"],["ある"],["。"]]},{"verse":20,"text":"各自,かくじは、召,めされたままの状態,じょうたいにとどまっているべきである。","tok":[["各自","かくじ"],["は"],["、"],["召された","めされた"],["まま"],["の"],["状態","じょうたい"],["に"],["とどまって"],["いるべきで"],["ある"],["。"]]},{"verse":21,"text":"召,めされたとき奴隷,どれいであっても、それを気,きにしないがよい。しかし、もし自由,じゆうの身,みになりうるなら、むしろ自由,じゆうになりなさい。","tok":[["召された","めされた"],["とき"],["奴隷","どれい"],["で"],["あって"],["も"],["、"],["それ"],["を"],["気","き"],["に"],["しない"],["が"],["よい"],["。"],["しかし"],["、"],["もし"],["自由","じゆう"],["の"],["身","み"],["に"],["なり"],["うるなら"],["、"],["むしろ"],["自由","じゆう"],["に"],["なり"],["なさい"],["。"]]},{"verse":22,"text":"主,しゅにあって召,めされた奴隷,どれいは、主,しゅによって自由人,じゆうじんとされた者,ものであり、また、召,めされた自由人,じゆうじんはキリストの奴隷,どれいなのである。","tok":[["主に","しゅに"],["あって"],["召された","めされた"],["奴隷","どれい"],["は"],["、"],["主に","しゅに"],["よって"],["自由人","じゆうじん"],["と"],["された"],["者","もの"],["で"],["あり"],["、"],["また"],["、"],["召された","めされた"],["自由人","じゆうじん"],["は"],["キリスト"],["の"],["奴隷","どれい"],["な"],["ので"],["ある"],["。"]]},{"verse":23,"text":"あなたがたは、代価,だいかを払,はらって買,かいとられたのだ。人,ひとの奴隷,どれいとなってはいけない。","tok":[["あなた"],["がた"],["は"],["、"],["代価","だいか"],["を"],["払って","はらって"],["買","かい"],["とられた"],["の"],["だ"],["。"],["人","ひと"],["の"],["奴隷","どれい"],["と"],["なって"],["は"],["いけない"],["。"]]},{"verse":24,"text":"兄弟,きょうだいたちよ。各自,かくじは、その召,めされたままの状態,じょうたいで、神,かみのみまえにいるべきである。","tok":[["兄弟","きょうだい"],["たち"],["よ"],["。"],["各自","かくじ"],["は"],["、"],["その"],["召された","めされた"],["まま"],["の"],["状態","じょうたい"],["で"],["、"],["神","かみ"],["のみ"],["まえ"],["に"],["いるべきで"],["ある"],["。"]]},{"verse":25,"text":"おとめのことについては、わたしは主,しゅの命令,めいれいを受,うけてはいないが、主,しゅのあわれみにより信,しん任,にんを受,うけている者,ものとして、意見,いけんを述,のべよう。","tok":[["おとめ"],["の"],["こと"],["について"],["は"],["、"],["わたし"],["は"],["主","しゅ"],["の"],["命令","めいれい"],["を"],["受て","うけて"],["は"],["いない"],["が"],["、"],["主","しゅ"],["の"],["あわれみ"],["に"],["より"],["信任","しんにん"],["を"],["受て","うけて"],["いる"],["者","もの"],["として"],["、"],["意見","いけん"],["を"],["述べよう","のべよう"],["。"]]},{"verse":26,"text":"わたしはこう考,かんがえる。現在,げんざい迫,せまっている危機,ききのゆえに、人,ひとは現状,げんじょうにとどまっているがよい。","tok":[["わたし"],["は"],["こう"],["考","かんがえ"],["る"],["。"],["現在","げんざい"],["迫まって","せまって"],["いる"],["危機","きき"],["の"],["ゆえ"],["に"],["、"],["人","ひと"],["は"],["現状","げんじょう"],["に"],["とどまって"],["いる"],["が"],["よい"],["。"]]},{"verse":27,"text":"もし妻,つまに結,むすばれているなら、解,とこうとするな。妻,つまに結,むすばれていないなら、妻,つまを迎,むかえようとするな。","tok":[["もし"],["妻","つま"],["に"],["結ばれて","むすばれて"],["いるなら"],["、"],["解こう","とこう"],["と"],["する"],["な"],["。"],["妻","つま"],["に"],["結ばれて","むすばれて"],["いないなら"],["、"],["妻","つま"],["を"],["迎","むかえ"],["よう"],["と"],["する"],["な"],["。"]]},{"verse":28,"text":"しかし、たとい結婚,けっこんしても、罪,つみを犯,おかすのではない。また、おとめが結婚,けっこんしても、罪,つみを犯,おかすのではない。ただ、それらの人々,ひとびとはその身,みに苦難,くなんを受,うけるであろう。わたしは、あなたがたを、それからのがれさせたいのだ。","tok":[["しかし"],["、"],["たとい"],["結婚","けっこん"],["して"],["も"],["、"],["罪","つみ"],["を"],["犯す","おかす"],["ので"],["は"],["ない"],["。"],["また"],["、"],["おとめ"],["が"],["結婚","けっこん"],["して"],["も"],["、"],["罪","つみ"],["を"],["犯す","おかす"],["ので"],["は"],["ない"],["。"],["ただ"],["、"],["それ"],["ら"],["の"],["人々","ひとびと"],["は"],["その"],["身","み"],["に"],["苦難","くなん"],["を"],["受るで","うけるで"],["あろう"],["。"],["わたし"],["は"],["、"],["あなた"],["がた"],["を"],["、"],["それ"],["から"],["のがれさせたい"],["の"],["だ"],["。"]]},{"verse":29,"text":"兄弟,きょうだいたちよ。わたしの言,いうことを聞,きいてほしい。時,ときは縮,ちぢまっている。今,いまからは妻,つまのある者,ものはないもののように、","tok":[["兄弟","きょうだい"],["たち"],["よ"],["。"],["わたし"],["の"],["言う","いう"],["こと"],["を"],["聞いて","きいて"],["ほしい"],["。"],["時","とき"],["は"],["縮まって","ちぢまって"],["いる"],["。"],["今","いま"],["から"],["は"],["妻","つま"],["の"],["ある"],["者","もの"],["は"],["ない"],["もの"],["の"],["よう"],["に"],["、"]]},{"verse":30,"text":"泣,なく者,ものは泣,なかないもののように、喜,よろこぶ者,ものは喜,よろこばないもののように、買,かう者,ものは持,もたないもののように、","tok":[["泣く","なく"],["者","もの"],["は"],["泣かない","なかない"],["もの"],["の"],["よう"],["に"],["、"],["喜こぶ","よろこぶ"],["者","もの"],["は"],["喜こばない","よろこばない"],["もの"],["の"],["よう"],["に"],["、"],["買う","かう"],["者","もの"],["は"],["持たない","もたない"],["もの"],["の"],["よう"],["に"],["、"]]},{"verse":31,"text":"世,よと交渉,こうしょうのある者,ものは、それに深,ふか入,いりしないようにすべきである。なぜなら、この世,よの有様,ありさまは過,すぎ去,さるからである。","tok":[["世","よ"],["と"],["交渉","こうしょう"],["の"],["ある"],["者","もの"],["は"],["、"],["それ"],["に"],["深","ふ"],["か"],["入","いり"],["しない"],["よう"],["に"],["すべきで"],["ある"],["。"],["なぜ"],["なら"],["、"],["この世","このよ"],["の"],["有様","ありさま"],["は"],["過去る","すぎさる"],["から"],["で"],["ある"],["。"]]},{"verse":32,"text":"わたしはあなたがたが、思,おもい煩,わずらわないようにしていてほしい。未婚,みこんの男子,だんしは主,しゅのことに心,こころをくばって、どうかして主,しゅを喜,よろこばせようとするが、","tok":[["わたし"],["は"],["あなた"],["が"],["た"],["が"],["、"],["思い煩わない","おもいわずらわない"],["よう"],["に"],["して"],["いて"],["ほしい"],["。"],["未婚","みこん"],["の"],["男子","だんし"],["は"],["主","しゅ"],["の"],["こと"],["に"],["心","こころ"],["を"],["くばって"],["、"],["どう"],["か"],["して"],["主","しゅ"],["を"],["喜こばせよう","よろこばせよう"],["と"],["する"],["が"],["、"]]},{"verse":33,"text":"結婚,けっこんしている男子,だんしはこの世,よのことに心,こころをくばって、どうかして妻,つまを喜,よろこばせようとして、その心,こころが分,わかれるのである。","tok":[["結婚","けっこん"],["して"],["いる"],["男子","だんし"],["は"],["この世","このよ"],["の"],["こと"],["に"],["心","こころ"],["を"],["くばって"],["、"],["どう"],["か"],["して"],["妻","つま"],["を"],["喜こばせよう","よろこばせよう"],["として"],["、"],["その"],["心","こころ"],["が"],["分かれる","わかれる"],["ので"],["ある"],["。"]]},{"verse":34,"text":"未婚,みこんの婦人,ふじんとおとめとは、主,しゅのことに心,こころをくばって、身,みも魂,たましいもきよくなろうとするが、結婚,けっこんした婦人,ふじんはこの世,よのことに心,こころをくばって、どうかして夫,おっとを喜,よろこばせようとする。","tok":[["未婚","みこん"],["の"],["婦人","ふじん"],["と"],["おとめ"],["と"],["は"],["、"],["主","しゅ"],["の"],["こと"],["に"],["心","こころ"],["を"],["くばって"],["、"],["身","み"],["も"],["魂","たましい"],["も"],["きよく"],["なろう"],["と"],["する"],["が"],["、"],["結婚","けっこん"],["した"],["婦人","ふじん"],["は"],["この世","このよ"],["の"],["こと"],["に"],["心","こころ"],["を"],["くばって"],["、"],["どう"],["か"],["して"],["夫","おっと"],["を"],["喜こばせよう","よろこばせよう"],["と"],["する"],["。"]]},{"verse":35,"text":"わたしがこう言,いうのは、あなたがたの利益,りえきになると思,おもうからであって、あなたがたを束縛,そくばくするためではない。そうではなく、正,ただしい生活,せいかつを送,おくって、余念,よねんなく主,しゅに奉仕,ほうしさせたいからである。","tok":[["わたし"],["が"],["こう"],["言う","いう"],["の"],["は"],["、"],["あなた"],["がた"],["の"],["利益","りえき"],["に"],["なる"],["と"],["思","おもう"],["から"],["で"],["あって"],["、"],["あなた"],["がた"],["を"],["束縛","そくばく"],["する"],["ため"],["で"],["は"],["ない"],["。"],["そう"],["で"],["は"],["なく"],["、"],["正い","ただしい"],["生活","せいかつ"],["を"],["送って","おくって"],["、"],["余念","よねん"],["なく"],["主に","しゅに"],["奉仕","ほうし"],["させたい"],["から"],["で"],["ある"],["。"]]},{"verse":36,"text":"もしある人,ひとが、相手,あいてのおとめに対,たいして、情,じょう熱,ねつをいだくようになった場合,ばあい、それは適当,てきとうでないと思,おもいつつも、やむを得,えなければ、望,のぞみどおりにしてもよい。それは罪,つみを犯,おかすことではない。ふたりは結婚,けっこんするがよい。","tok":[["もし"],["ある"],["人","ひと"],["が"],["、"],["相手","あいて"],["の"],["おとめ"],["に対して","にたいして"],["、"],["情熱","じょうねつ"],["を"],["いだく"],["よう"],["に"],["なった"],["場合","ばあい"],["、"],["それ"],["は"],["適当","てきとう"],["で"],["ない"],["と"],["思い","おもい"],["つつ"],["も"],["、"],["やむ"],["を"],["得なければ","えなければ"],["、"],["望み","のぞみ"],["どおり"],["に"],["して"],["も"],["よい"],["。"],["それ"],["は"],["罪","つみ"],["を"],["犯す","おかす"],["こと"],["で"],["は"],["ない"],["。"],["ふたり"],["は"],["結婚","けっこん"],["する"],["が"],["よい"],["。"]]},{"verse":37,"text":"しかし、彼,かれが心,こころの内,うちで堅,かたく決心,けっしんしていて、無理,むりをしないで自分,じぶんの思,おもいを制,せいすることができ、その上,うえで、相手,あいてのおとめをそのままにしておこうと、心,こころの中,なかで決,きめたなら、そうしてもよい。","tok":[["しかし"],["、"],["彼","かれ"],["が"],["心","こころ"],["の"],["内","うち"],["で"],["堅く","かたく"],["決心","けっしん"],["して"],["いて"],["、"],["無理","むり"],["を"],["しないで"],["自分","じぶん"],["の"],["思い","おもい"],["を"],["制する","せいする"],["こと"],["が"],["でき"],["、"],["その"],["上","うえ"],["で"],["、"],["相手","あいて"],["の"],["おとめ"],["を"],["そのまま"],["に"],["して"],["おこう"],["と"],["、"],["心","こころ"],["の"],["中","なか"],["で"],["決めたなら","きめたなら"],["、"],["そう"],["して"],["も"],["よい"],["。"]]},{"verse":38,"text":"だから、相手,あいてのおとめと結婚,けっこんすることはさしつかえないが、結婚,けっこんしない方,ほうがもっとよい。","tok":[["だ"],["から"],["、"],["相手","あいて"],["の"],["おとめ"],["と"],["結婚","けっこん"],["する"],["こと"],["は"],["さしつかえない"],["が"],["、"],["結婚","けっこん"],["しない"],["方","ほう"],["が"],["もっと"],["よい"],["。"]]},{"verse":39,"text":"妻,つまは夫,おっとが生,いきている間,あいだは、その夫,おっとにつながれている。夫,おっとが死,しねば、望,のぞむ人,ひとと結婚,けっこんしてもさしつかえないが、それは主,しゅにある者,ものとに限,かぎる。","tok":[["妻","つま"],["は"],["夫","おっと"],["が"],["生きて","いきて"],["いる"],["間","あいだ"],["は"],["、"],["その"],["夫","おっと"],["に"],["つながれて"],["いる"],["。"],["夫","おっと"],["が"],["死ねば","しねば"],["、"],["望む","のぞむ"],["人","ひと"],["と"],["結婚","けっこん"],["して"],["も"],["さしつかえない"],["が"],["、"],["それ"],["は"],["主に","しゅに"],["ある"],["者","もの"],["と"],["に"],["限ぎる","かぎる"],["。"]]},{"verse":40,"text":"しかし、わたしの意見,いけんでは、そのままでいたなら、もっと幸福,こうふくである。わたしも神,かみの霊,れいを受,うけていると思,おもう。","tok":[["しかし"],["、"],["わたし"],["の"],["意見","いけん"],["で"],["は"],["、"],["そのまま"],["で"],["いたなら"],["、"],["もっと"],["幸福","こうふく"],["で"],["ある"],["。"],["わたし"],["も"],["神","かみ"],["の"],["霊","れい"],["を"],["受て","うけて"],["いる"],["と"],["思う","おもう"],["。"]]}]
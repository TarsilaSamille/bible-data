[{"verse":1,"text":"あなたがたの中,なかのひとりが、仲間,なかまの者,ものと何,なにか争,あらそいを起,おこした場合,ばあい、それを聖徒,せいとに訴,うったえないで、正,ただしくない者,ものに訴,うったえ出,でるようなことをするのか。","tok":[["あなた"],["がた"],["の"],["中","なか"],["の"],["ひとり"],["が"],["、"],["仲間","なかま"],["の"],["者","もの"],["と"],["何に","なに"],["か"],["争い","あらそい"],["を"],["起こした","おこした"],["場合","ばあい"],["、"],["それ"],["を"],["聖徒","せいと"],["に"],["訴ないで","うったえないで"],["、"],["正く","ただしく"],["ない"],["者","もの"],["に"],["訴","うったえ"],["出る","でる"],["よう"],["な"],["こと"],["を"],["する"],["の"],["か"],["。"]]},{"verse":2,"text":"それとも、聖徒,せいとは世,よをさばくものであることを、あなたがたは知,しらないのか。そして、世,よがあなたがたによってさばかれるべきであるのに、きわめて小,ちいさい事件,じけんでもさばく力,ちからがないのか。","tok":[["それ"],["と"],["も"],["、"],["聖徒","せいと"],["は"],["世","よ"],["を"],["さばく"],["もの"],["で"],["ある"],["こと"],["を"],["、"],["あなた"],["がた"],["は"],["知らない","しらない"],["の"],["か"],["。"],["そして"],["、"],["世","よ"],["が"],["あなた"],["がた"],["によって"],["さばかれるべきで"],["ある"],["のに"],["、"],["きわめて"],["小さい","ちいさい"],["事件","じけん"],["で"],["も"],["さばく力","さばくちから"],["が"],["ない"],["の"],["か"],["。"]]},{"verse":3,"text":"あなたがたは知,しらないのか、わたしたちは御使,みつかいをさえさばく者,ものである。ましてこの世,よの事件,じけんなどは、いうまでもないではないか。","tok":[["あなた"],["がた"],["は"],["知らない","しらない"],["の"],["か"],["、"],["わたしたち"],["は"],["御使","みつかい"],["を"],["さえ"],["さばく"],["者","もの"],["で"],["ある"],["。"],["まして"],["この世","このよ"],["の"],["事件","じけん"],["など"],["は"],["、"],["いう"],["まで"],["も"],["ないで"],["は"],["ない"],["か"],["。"]]},{"verse":4,"text":"それだのに、この世,よの事件,じけんが起,おこると、教会,きょうかいで軽,かろんじられている人,ひとたちを、裁判,さいばんの席,せきにつかせるのか。","tok":[["それ"],["だ"],["のに"],["、"],["この世","このよ"],["の"],["事件","じけん"],["が"],["起こる","おこる"],["と"],["、"],["教会","きょうかい"],["で"],["軽んじられて","かろんじられて"],["いる"],["人","ひと"],["たち"],["を"],["、"],["裁判","さいばん"],["の"],["席","せき"],["に"],["つかせる"],["の"],["か"],["。"]]},{"verse":5,"text":"わたしがこう言,いうのは、あなたがたをはずかしめるためである。いったい、あなたがたの中,なかには、兄弟,きょうだいの間,あいだの争,あらそいを仲裁,ちゅうさいすることができるほどの知者,ちしゃは、ひとりもいないのか。","tok":[["わたし"],["が"],["こう"],["言う","いう"],["の"],["は"],["、"],["あなた"],["がた"],["を"],["はずかしめる"],["ため"],["で"],["ある"],["。"],["いったい"],["、"],["あなた"],["がた"],["の"],["中","なか"],["に"],["は"],["、"],["兄弟","きょうだい"],["の"],["間","あいだ"],["の"],["争い","あらそい"],["を"],["仲裁","ちゅうさい"],["する"],["こと"],["が"],["できる"],["ほど"],["の"],["知者","ちしゃ"],["は"],["、"],["ひとり"],["も"],["いない"],["の"],["か"],["。"]]},{"verse":6,"text":"しかるに、兄弟,きょうだいが兄弟,きょうだいを訴,うったえ、しかもそれを不信者,ふしんじゃの前,まえに持,もち出,だすのか。","tok":[["しかる"],["に"],["、"],["兄弟","きょうだい"],["が"],["兄弟","きょうだい"],["を"],["訴","うったえ"],["、"],["しかも"],["それ"],["を"],["不信者","ふしんじゃ"],["の"],["前","まえ"],["に"],["持出す","もちだす"],["の"],["か"],["。"]]},{"verse":7,"text":"そもそも、互,たがいに訴,うったえ合,あうこと自体,じたいが、すでにあなたがたの敗北,はいぼくなのだ。なぜ、むしろ不義,ふぎを受,うけないのか。なぜ、むしろだまされていないのか。","tok":[["そもそも"],["、"],["互","たがい"],["に"],["訴","うったえ"],["合う","あう"],["こと"],["自体","じたい"],["が"],["、"],["すでに"],["あなた"],["がた"],["の"],["敗北","はいぼく"],["な"],["の"],["だ"],["。"],["なぜ"],["、"],["むしろ"],["不義","ふぎ"],["を"],["受ない","うけない"],["の"],["か"],["。"],["なぜ"],["、"],["むしろ"],["だまされて"],["いない"],["の"],["か"],["。"]]},{"verse":8,"text":"しかるに、あなたがたは不義,ふぎを働,はたらき、だまし取,とり、しかも兄弟,きょうだいに対,たいしてそうしているのである。","tok":[["しかる"],["に"],["、"],["あなた"],["がた"],["は"],["不義","ふぎ"],["を"],["働らき","はたらき"],["、"],["だまし"],["取","とり"],["、"],["しかも"],["兄弟","きょうだい"],["に対して","にたいして"],["そう"],["して"],["いる"],["ので"],["ある"],["。"]]},{"verse":9,"text":"それとも、正,ただしくない者,ものが神,かみの国,くにをつぐことはないのを、知,しらないのか。まちがってはいけない。不品行,ふひんこうな者,もの、偶像,ぐうぞうを礼拝,れいはいする者,もの、姦淫,かんいんをする者,もの、男娼,だんしょうとなる者,もの、男色,なんしょくをする者,もの、盗,ぬすむ者,もの、","tok":[["それ"],["と"],["も"],["、"],["正く","ただしく"],["ない"],["者","もの"],["が"],["神","かみ"],["の"],["国","くに"],["を"],["つぐ"],["こと"],["は"],["ない"],["の"],["を"],["、"],["知らない","しらない"],["の"],["か"],["。"],["まちがって"],["は"],["いけない"],["。"],["不品行","ふひんこう"],["な"],["者","もの"],["、"],["偶像","ぐうぞう"],["を"],["礼拝","れいはい"],["する"],["者","もの"],["、"],["姦淫","かんいん"],["を"],["する"],["者","もの"],["、"],["男娼","だんしょう"],["と"],["なる"],["者","もの"],["、"],["男色","なんしょく"],["を"],["する"],["者","もの"],["、"],["盗む","ぬすむ"],["者","もの"],["、"]]},{"verse":10,"text":"貪欲,どんよくな者,もの、酒,さけに酔,よう者,もの、そしる者,もの、略奪,りゃくだつする者,ものは、いずれも神,かみの国,くにをつぐことはないのである。","tok":[["貪欲","どんよく"],["な"],["者","もの"],["、"],["酒","さけ"],["に"],["酔う","よう"],["者","もの"],["、"],["そしる"],["者","もの"],["、"],["略奪","りゃくだつ"],["する"],["者","もの"],["は"],["、"],["いずれ"],["も"],["神","かみ"],["の"],["国","くに"],["を"],["つぐ"],["こと"],["は"],["ない"],["ので"],["ある"],["。"]]},{"verse":11,"text":"あなたがたの中,なかには、以前,いぜんはそんな人,ひともいた。しかし、あなたがたは、主,しゅイエス・キリストの名,なによって、またわたしたちの神,かみの霊,れいによって、洗,あらわれ、きよめられ、義,ぎとされたのである。","tok":[["あなた"],["がた"],["の"],["中","なか"],["に"],["は"],["、"],["以前","いぜん"],["は"],["そんな"],["人","ひと"],["も"],["いた"],["。"],["しかし"],["、"],["あなた"],["がた"],["は"],["、"],["主","しゅ"],["イエス"],["・"],["キリスト"],["の"],["名","な"],["によって"],["、"],["また"],["わたしたち"],["の"],["神","かみ"],["の"],["霊","れい"],["によって"],["、"],["洗われ","あらわれ"],["、"],["きよめられ"],["、"],["義","ぎ"],["と"],["された"],["ので"],["ある"],["。"]]},{"verse":12,"text":"すべてのことは、わたしに許,ゆるされている。しかし、すべてのことが益,えきになるわけではない。すべてのことは、わたしに許,ゆるされている。しかし、わたしは何,なにものにも支配,しはいされることはない。","tok":[["すべて"],["の"],["こと"],["は"],["、"],["わたし"],["に"],["許されて","ゆるされて"],["いる"],["。"],["しかし"],["、"],["すべて"],["の"],["こと"],["が"],["益","えき"],["に"],["なる"],["わけ"],["で"],["は"],["ない"],["。"],["すべて"],["の"],["こと"],["は"],["、"],["わたし"],["に"],["許されて","ゆるされて"],["いる"],["。"],["しかし"],["、"],["わたし"],["は"],["何もの","なにもの"],["に"],["も"],["支配","しはい"],["される"],["こと"],["は"],["ない"],["。"]]},{"verse":13,"text":"食物,しょくもつは腹,はらのため、腹,はらは食物,しょくもつのためである。しかし神,かみは、それもこれも滅,ほろぼすであろう。からだは不品行,ふひんこうのためではなく、主,しゅのためであり、主,しゅはからだのためである。","tok":[["食物","しょくもつ"],["は"],["腹","はら"],["の"],["ため"],["、"],["腹","はら"],["は"],["食物","しょくもつ"],["の"],["ため"],["で"],["ある"],["。"],["しかし"],["神","かみ"],["は"],["、"],["それ"],["も"],["これ"],["も"],["滅ぼすで","ほろぼすで"],["あろう"],["。"],["から"],["だ"],["は"],["不品行","ふひんこう"],["の"],["ため"],["で"],["は"],["なく"],["、"],["主","しゅ"],["の"],["ため"],["で"],["あり"],["、"],["主","しゅ"],["は"],["からだ"],["の"],["ため"],["で"],["ある"],["。"]]},{"verse":14,"text":"そして、神,かみは主,しゅをよみがえらせたが、その力,ちからで、わたしたちをもよみがえらせて下,くださるであろう。","tok":[["そして"],["、"],["神","かみ"],["は"],["主","しゅ"],["を"],["よみがえらせた"],["が"],["、"],["その"],["力","ちから"],["で"],["、"],["わたしたち"],["を"],["も"],["よみがえらせて"],["下さるで","くださるで"],["あろう"],["。"]]},{"verse":15,"text":"あなたがたは自分,じぶんのからだがキリストの肢体,したいであることを、知,しらないのか。それだのに、キリストの肢体,したいを取,とって遊女,ゆうじょの肢体,したいとしてよいのか。断,だんじていけない。","tok":[["あなた"],["がた"],["は"],["自分","じぶん"],["の"],["からだ"],["が"],["キリスト"],["の"],["肢体","したい"],["で"],["ある"],["こと"],["を"],["、"],["知らない","しらない"],["の"],["か"],["。"],["それ"],["だ"],["のに"],["、"],["キリスト"],["の"],["肢体","したい"],["を"],["取って","とって"],["遊女","ゆうじょ"],["の"],["肢体","したい"],["として"],["よい"],["の"],["か"],["。"],["断じて","だんじて"],["いけない"],["。"]]},{"verse":16,"text":"それとも、遊女,ゆうじょにつく者,ものはそれと一つのからだになることを、知,しらないのか。「ふたりの者,ものは一体,いったいとなるべきである」とあるからである。","tok":[["それ"],["と"],["も"],["、"],["遊女","ゆうじょ"],["に"],["つく"],["者","もの"],["は"],["それ"],["と"],["一","ひと"],["つ"],["の"],["からだ"],["に"],["なる"],["こと"],["を"],["、"],["知らない","しらない"],["の"],["か"],["。"],["「"],["ふたり"],["の"],["者","もの"],["は"],["一体","いったい"],["と"],["なるべきで"],["ある"],["」"],["と"],["ある"],["から"],["で"],["ある"],["。"]]},{"verse":17,"text":"しかし主,しゅにつく者,ものは、主,しゅと一つの霊,れいになるのである。","tok":[["しかし"],["主に","しゅに"],["つく"],["者","もの"],["は"],["、"],["主","しゅ"],["と"],["一","ひと"],["つ"],["の"],["霊","れい"],["に"],["なる"],["ので"],["ある"],["。"]]},{"verse":18,"text":"不品行,ふひんこうを避,さけなさい。人,ひとの犯,おかすすべての罪,つみは、からだの外,そとにある。しかし不品行,ふひんこうをする者,ものは、自分,じぶんのからだに対,たいして罪,つみを犯,おかすのである。","tok":[["不品行","ふひんこう"],["を"],["避け","さけ"],["なさい"],["。"],["人","ひと"],["の"],["犯す","おかす"],["すべて"],["の"],["罪","つみ"],["は"],["、"],["からだ"],["の"],["外","そと"],["に"],["ある"],["。"],["しかし"],["不品行","ふひんこう"],["を"],["する"],["者","もの"],["は"],["、"],["自分","じぶん"],["の"],["からだ"],["に対して","にたいして"],["罪","つみ"],["を"],["犯す","おかす"],["ので"],["ある"],["。"]]},{"verse":19,"text":"あなたがたは知,しらないのか。自分,じぶんのからだは、神,かみから受,うけて自分,じぶんの内,うちに宿,やどっている聖霊,せいれいの宮,みやであって、あなたがたは、もはや自分,じぶん自身,じしんのものではないのである。","tok":[["あなた"],["がた"],["は"],["知らない","しらない"],["の"],["か"],["。"],["自分","じぶん"],["の"],["からだ"],["は"],["、"],["神","かみ"],["から"],["受けて","うけて"],["自分","じぶん"],["の"],["内","うち"],["に"],["宿って","やどって"],["いる"],["聖霊","せいれい"],["の"],["宮","みや"],["で"],["あって"],["、"],["あなた"],["がた"],["は"],["、"],["もはや"],["自分","じぶん"],["自身","じしん"],["の"],["もの"],["で"],["は"],["ない"],["ので"],["ある"],["。"]]},{"verse":20,"text":"あなたがたは、代価,だいかを払,はらって買,かいとられたのだ。それだから、自分,じぶんのからだをもって、神,かみの栄光,えいこうをあらわしなさい。","tok":[["あなた"],["がた"],["は"],["、"],["代価","だいか"],["を"],["払って","はらって"],["買","かい"],["とられた"],["の"],["だ"],["。"],["それ"],["だ"],["から"],["、"],["自分","じぶん"],["の"],["からだ"],["を"],["もって"],["、"],["神","かみ"],["の"],["栄光","えいこう"],["を"],["あらわし"],["なさい"],["。"]]}]
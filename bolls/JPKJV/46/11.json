[{"verse":1,"text":"わたしがキリストにならう者,ものであるように、あなたがたもわたしにならう者,ものになりなさい。","tok":[["わたし"],["が"],["キリスト"],["に"],["ならう"],["者","もの"],["で"],["ある"],["よう"],["に"],["、"],["あなた"],["がた"],["も"],["わたし"],["に"],["ならう"],["者","もの"],["に"],["なり"],["なさい"],["。"]]},{"verse":2,"text":"あなたがたが、何,なにかにつけわたしを覚,おぼえていて、あなたがたに伝,つたえたとおりに言伝,いいつたえを守,まもっているので、わたしは満足,まんぞくに思,おもう。","tok":[["あなた"],["が"],["た"],["が"],["、"],["何に","なに"],["か"],["に"],["つけ"],["わたし"],["を"],["覚えて","おぼえて"],["いて"],["、"],["あなた"],["がた"],["に"],["伝えた","つたえた"],["とおり"],["に"],["言伝え","いいつたえ"],["を"],["守って","まもって"],["いる"],["ので"],["、"],["わたし"],["は"],["満足","まんぞく"],["に"],["思う","おもう"],["。"]]},{"verse":3,"text":"しかし、あなたがたに知,しっていてもらいたい。すべての男,おとこのかしらはキリストであり、女,おんなのかしらは男,おとこであり、キリストのかしらは神,かみである。","tok":[["しかし"],["、"],["あなた"],["がた"],["に"],["知って","しって"],["いて"],["もらいたい"],["。"],["すべて"],["の"],["男","おとこ"],["の"],["かしら"],["は"],["キリスト"],["で"],["あり"],["、"],["女","おんな"],["の"],["かしら"],["は"],["男","おとこ"],["で"],["あり"],["、"],["キリスト"],["の"],["かしら"],["は"],["神","かみ"],["で"],["ある"],["。"]]},{"verse":4,"text":"祈,いのりをしたり預言,よげんをしたりする時,とき、かしらに物,ものをかぶる男,おとこは、そのかしらをはずかしめる者,ものである。","tok":[["祈","いのり"],["を"],["し"],["たり"],["預言","よげん"],["を"],["し"],["たり"],["する"],["時","とき"],["、"],["かしら"],["に"],["物","もの"],["を"],["かぶる"],["男","おとこ"],["は"],["、"],["その"],["かしら"],["を"],["はずかしめる"],["者","もの"],["で"],["ある"],["。"]]},{"verse":5,"text":"祈,いのりをしたり預言,よげんをしたりする時,とき、かしらにおおいをかけない女,おんなは、そのかしらをはずかしめる者,ものである。それは、髪,かみをそったのとまったく同,おなじだからである。","tok":[["祈","いのり"],["を"],["し"],["たり"],["預言","よげん"],["を"],["し"],["たり"],["する"],["時","とき"],["、"],["かしら"],["に"],["おおい"],["を"],["かけない"],["女","おんな"],["は"],["、"],["その"],["かしら"],["を"],["はずかしめる"],["者","もの"],["で"],["ある"],["。"],["それ"],["は"],["、"],["髪","かみ"],["を"],["そった"],["の"],["と"],["まったく"],["同じ","おなじ"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":6,"text":"もし女,おんながおおいをかけないなら、髪,かみを切,きってしまうがよい。髪,かみを切,きったりそったりするのが、女,おんなにとって恥,はずべきことであるなら、おおいをかけるべきである。","tok":[["もし"],["女","おんな"],["が"],["おおい"],["を"],["かけないなら"],["、"],["髪","かみ"],["を"],["切って","きって"],["しまう"],["が"],["よい"],["。"],["髪","かみ"],["を"],["切っ","きっ"],["たり"],["そっ"],["たり"],["する"],["の"],["が"],["、"],["女","おんな"],["にとって"],["恥ずべき","はずべき"],["こと"],["で"],["あるなら"],["、"],["おおい"],["を"],["かけるべきで"],["ある"],["。"]]},{"verse":7,"text":"男,おとこは、神,かみのかたちであり栄光,えいこうであるから、かしらに物,ものをかぶるべきではない。女,おんなは、また男,おとこの光栄,こうえいである。","tok":[["男","おとこ"],["は"],["、"],["神","かみ"],["の"],["かたち"],["で"],["あり"],["栄光","えいこう"],["で"],["ある"],["から"],["、"],["かしら"],["に"],["物","もの"],["を"],["かぶるべきで"],["は"],["ない"],["。"],["女","おんな"],["は"],["、"],["また"],["男","おとこ"],["の"],["光栄","こうえい"],["で"],["ある"],["。"]]},{"verse":8,"text":"なぜなら、男,おとこが女,おんなから出,でたのではなく、女,おんなが男,おとこから出,でたのだからである。","tok":[["なぜ"],["なら"],["、"],["男","おとこ"],["が"],["女","おんな"],["から"],["出た","でた"],["ので"],["は"],["なく"],["、"],["女","おんな"],["が"],["男","おとこ"],["から"],["出た","でた"],["の"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":9,"text":"また、男,おとこは女,おんなのために造,つくられたのではなく、女,おんなが男,おとこのために造,つくられたのである。","tok":[["また"],["、"],["男","おとこ"],["は"],["女","おんな"],["の"],["ため"],["に"],["造られた","つくられた"],["ので"],["は"],["なく"],["、"],["女","おんな"],["が"],["男","おとこ"],["の"],["ため"],["に"],["造られた","つくられた"],["ので"],["ある"],["。"]]},{"verse":10,"text":"それだから、女,おんなは、かしらに権威,けんいのしるしをかぶるべきである。それは天使,てんしたちのためでもある。","tok":[["それ"],["だ"],["から"],["、"],["女","おんな"],["は"],["、"],["かしら"],["に"],["権威","けんい"],["の"],["しるし"],["を"],["かぶるべきで"],["ある"],["。"],["それ"],["は"],["天使","てんし"],["たち"],["の"],["ため"],["で"],["も"],["ある"],["。"]]},{"verse":11,"text":"ただ、主,しゅにあっては、男,おとこなしには女,おんなはないし、女,おんななしには男,おとこはない。","tok":[["ただ"],["、"],["主に","しゅに"],["あって"],["は"],["、"],["男","おとこ"],["なし"],["に"],["は"],["女","おんな"],["は"],["ない"],["し"],["、"],["女","おんな"],["なし"],["に"],["は"],["男","おとこ"],["は"],["ない"],["。"]]},{"verse":12,"text":"それは、女,おんなが男,おとこから出,でたように、男,おとこもまた女,おんなから生,うまれたからである。そして、すべてのものは神,かみから出,でたのである。","tok":[["それ"],["は"],["、"],["女","おんな"],["が"],["男","おとこ"],["から"],["出た","でた"],["よう"],["に"],["、"],["男","おとこ"],["も"],["また"],["女","おんな"],["から"],["生まれた","うまれた"],["から"],["で"],["ある"],["。"],["そして"],["、"],["すべて"],["の"],["もの"],["は"],["神","かみ"],["から"],["出た","でた"],["ので"],["ある"],["。"]]},{"verse":13,"text":"あなたがた自身,じしんで判断,はんだんしてみるがよい。女,おんながおおいをかけずに神,かみに祈,いのるのは、ふさわしいことだろうか。","tok":[["あなた"],["がた"],["自身","じしん"],["で"],["判断","はんだん"],["して"],["みる"],["が"],["よい"],["。"],["女","おんな"],["が"],["おおい"],["を"],["かけず"],["に"],["神","かみ"],["に"],["祈る","いのる"],["の"],["は"],["、"],["ふさわしい"],["こと"],["だろう"],["か"],["。"]]},{"verse":14,"text":"自然,しぜんそのものが教,おしえているではないか。男,おとこに長,ながい髪,かみがあれば彼,かれの恥,はじになり、","tok":[["自然","しぜん"],["その"],["もの"],["が"],["教えて","おしえて"],["いるで"],["は"],["ない"],["か"],["。"],["男","おとこ"],["に"],["長い","ながい"],["髪","かみ"],["が"],["あれば"],["彼","かれ"],["の"],["恥","はじ"],["に"],["なり"],["、"]]},{"verse":15,"text":"女,おんなに長,ながい髪,かみがあれば彼女,かのじょの光栄,こうえいになるのである。長,ながい髪,かみはおおいの代,かわりに女,おんなに与,あたえられているものだからである。","tok":[["女","おんな"],["に"],["長い","ながい"],["髪","かみ"],["が"],["あれば"],["彼女","かのじょ"],["の"],["光栄","こうえい"],["に"],["なる"],["ので"],["ある"],["。"],["長い","ながい"],["髪","かみ"],["は"],["おおい"],["の"],["代わり","かわり"],["に"],["女","おんな"],["に"],["与えられて","あたえられて"],["いる"],["もの"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":16,"text":"しかし、だれかがそれに反対,はんたいの意見,いけんを持,もっていても、そんな風習,ふうしゅうはわたしたちにはなく、神,かみの諸,しょ教会,きょうかいにもない。","tok":[["しかし"],["、"],["だれ"],["か"],["が"],["それ"],["に"],["反対","はんたい"],["の"],["意見","いけん"],["を"],["持って","もって"],["いて"],["も"],["、"],["そんな"],["風習","ふうしゅう"],["は"],["わたしたち"],["に"],["は"],["なく"],["、"],["神","かみ"],["の"],["諸教","しょ教"],["会","かい"],["に"],["も"],["ない"],["。"]]},{"verse":17,"text":"ところで、次,つぎのことを命,めいじるについては、あなたがたをほめるわけにはいかない。というのは、あなたがたの集,あつまりが利益,りえきにならないで、かえって損失,そんしつになっているからである。","tok":[["ところ"],["で"],["、"],["次","つぎ"],["の"],["こと"],["を"],["命じる","めいじる"],["について"],["は"],["、"],["あなた"],["がた"],["を"],["ほめる"],["わけ"],["に"],["は"],["いかない"],["。"],["と"],["いう"],["の"],["は"],["、"],["あなた"],["がた"],["の"],["集まり","あつまり"],["が"],["利益","りえき"],["に"],["ならないで"],["、"],["かえって"],["損失","そんしつ"],["に"],["なって"],["いる"],["から"],["で"],["ある"],["。"]]},{"verse":18,"text":"まず、あなたがたが教会,きょうかいに集,あつまる時,とき、お互,たがいの間,あいだに分争,ぶんそうがあることを、わたしは耳,みみにしており、そしていくぶんか、それを信,しんじている。","tok":[["まず"],["、"],["あなた"],["がた"],["が"],["教会","きょうかい"],["に"],["集まる","あつまる"],["時","とき"],["、"],["お互","おたがい"],["の"],["間","あいだ"],["に"],["分争","ぶんそう"],["が"],["ある"],["こと"],["を"],["、"],["わたし"],["は"],["耳","みみ"],["に"],["して"],["おり"],["、"],["そして"],["いくぶん"],["か"],["、"],["それ"],["を"],["信じて","しんじて"],["いる"],["。"]]},{"verse":19,"text":"たしかに、あなたがたの中,なかでほんとうの者,ものが明,あきらかにされるためには、分派,ぶんぱもなければなるまい。","tok":[["たしか"],["に"],["、"],["あなた"],["がた"],["の"],["中","なか"],["で"],["ほんとう"],["の"],["者","もの"],["が"],["明か","あきらか"],["に"],["される"],["ため"],["に"],["は"],["、"],["分派","ぶんぱ"],["も"],["なければ"],["なるまい"],["。"]]},{"verse":20,"text":"そこで、あなたがたが一緒,いっしょに集,あつまるとき、主,しゅの晩餐,ばんさんを守,まもることができないでいる。","tok":[["そこ"],["で"],["、"],["あなた"],["がた"],["が"],["一緒","いっしょ"],["に"],["集まる","あつまる"],["とき"],["、"],["主","しゅ"],["の"],["晩餐","ばんさん"],["を"],["守","まもる"],["こと"],["が"],["できないで"],["いる"],["。"]]},{"verse":21,"text":"というのは、食事,しょくじの際,さい、各自,かくじが自分,じぶんの晩餐,ばんさんをかってに先,さきに食,たべるので、飢,うえている人,ひとがあるかと思,おもえば、酔,よっている人,ひとがある始末,しまつである。","tok":[["と"],["いう"],["の"],["は"],["、"],["食事","しょくじ"],["の"],["際","さい"],["、"],["各自","かくじ"],["が"],["自分","じぶん"],["の"],["晩餐","ばんさん"],["を"],["かって"],["に"],["先","さき"],["に"],["食べる","たべる"],["ので"],["、"],["飢","うえ"],["て"],["いる"],["人","ひと"],["が"],["ある"],["か"],["と"],["思ば","おもえば"],["、"],["酔って","よって"],["いる"],["人","ひと"],["が"],["ある"],["始末","しまつ"],["で"],["ある"],["。"]]},{"verse":22,"text":"あなたがたには、飲,のみ食,くいをする家,いえがないのか。それとも、神,かみの教会,きょうかいを軽,かろんじ、貧,まずしい人々,ひとびとをはずかしめるのか。わたしはあなたがたに対,たいして、なんと言,いおうか。あなたがたを、ほめようか。この事,ことでは、ほめるわけにはいかない。","tok":[["あなた"],["がた"],["に"],["は"],["、"],["飲み食い","のみくい"],["を"],["する"],["家","いえ"],["が"],["ない"],["の"],["か"],["。"],["それ"],["と"],["も"],["、"],["神","かみ"],["の"],["教会","きょうかい"],["を"],["軽んじ","かろんじ"],["、"],["貧しい","まずしい"],["人々","ひとびと"],["を"],["はずかしめる"],["の"],["か"],["。"],["わたし"],["は"],["あなた"],["がた"],["に対して","にたいして"],["、"],["なん"],["と"],["言おう","いおう"],["か"],["。"],["あなた"],["がた"],["を"],["、"],["ほめよう"],["か"],["。"],["この"],["事","こと"],["で"],["は"],["、"],["ほめる"],["わけ"],["に"],["は"],["いかない"],["。"]]},{"verse":23,"text":"わたしは、主,しゅから受,うけたことを、また、あなたがたに伝,つたえたのである。すなわち、主,しゅイエスは、渡,わたされる夜,よ、パンをとり、","tok":[["わたし"],["は"],["、"],["主ら","しゅから"],["受た","うけた"],["こと"],["を"],["、"],["また"],["、"],["あなた"],["がた"],["に"],["伝えた","つたえた"],["ので"],["ある"],["。"],["すなわち"],["、"],["主","しゅ"],["イエス"],["は"],["、"],["渡される","わたされる"],["夜","よ"],["、"],["パン"],["を"],["とり"],["、"]]},{"verse":24,"text":"感謝,かんしゃしてこれをさき、そして言,いわれた、「これはあなたがたのための、わたしのからだである。わたしを記念,きねんするため、このように行,おこないなさい」。","tok":[["感謝","かんしゃ"],["して"],["これ"],["を"],["さき"],["、"],["そして"],["言われた","いわれた"],["、"],["「"],["これ"],["は"],["あなた"],["がた"],["の"],["ため"],["の"],["、"],["わたし"],["の"],["からだ"],["で"],["ある"],["。"],["わたし"],["を"],["記念","きねん"],["する"],["ため"],["、"],["この"],["よう"],["に"],["行ない","おこない"],["なさい"],["」"],["。"]]},{"verse":25,"text":"食事,しょくじののち、杯,さかずきをも同,おなじようにして言,いわれた、「この杯,さかずきは、わたしの血,ちによる新,あたらしい契約,けいやくである。飲,のむたびに、わたしの記念,きねんとして、このように行,おこないなさい」。","tok":[["食事","しょくじ"],["の"],["のち"],["、"],["杯","さかずき"],["を"],["も"],["同じ","おなじ"],["よう"],["に"],["して"],["言われた","いわれた"],["、"],["「"],["この"],["杯","さかずき"],["は"],["、"],["わたし"],["の"],["血","ち"],["に"],["よる"],["新らしい","あたらしい"],["契約","けいやく"],["で"],["ある"],["。"],["飲む","のむ"],["たび"],["に"],["、"],["わたし"],["の"],["記念","きねん"],["として"],["、"],["この"],["よう"],["に"],["行ない","おこない"],["なさい"],["」"],["。"]]},{"verse":26,"text":"だから、あなたがたは、このパンを食,しょくし、この杯,さかずきを飲,のむごとに、それによって、主,しゅがこられる時,ときに至,いたるまで、主,しゅの死,しを告,つげ知,しらせるのである。","tok":[["だ"],["から"],["、"],["あなた"],["がた"],["は"],["、"],["この"],["パン"],["を"],["食し","しょくし"],["、"],["この"],["杯","さかずき"],["を"],["飲む","のむ"],["ごと"],["に"],["、"],["それ"],["によって"],["、"],["主","しゅ"],["が"],["こられる"],["時","とき"],["に"],["至る","いたる"],["まで"],["、"],["主","しゅ"],["の"],["死","し"],["を"],["告","つげ"],["知らせる","しらせる"],["ので"],["ある"],["。"]]},{"verse":27,"text":"だから、ふさわしくないままでパンを食,しょくし主,しゅの杯,さかずきを飲,のむ者,ものは、主,しゅのからだと血,ちとを犯,おかすのである。","tok":[["だ"],["から"],["、"],["ふさわしく"],["ない"],["まま"],["で"],["パン"],["を"],["食し","しょくし"],["主","しゅ"],["の"],["杯","さかずき"],["を"],["飲む","のむ"],["者","もの"],["は"],["、"],["主","しゅ"],["の"],["からだ"],["と"],["血","ち"],["と"],["を"],["犯す","おかす"],["ので"],["ある"],["。"]]},{"verse":28,"text":"だれでもまず自分,じぶんを吟味,ぎんみし、それからパンを食,たべ杯,さかずきを飲,のむべきである。","tok":[["だれ"],["で"],["も"],["まず"],["自分","じぶん"],["を"],["吟味","ぎんみ"],["し"],["、"],["それ"],["から"],["パン"],["を"],["食べ","たべ"],["杯","さかずき"],["を"],["飲むべきで","のむべきで"],["ある"],["。"]]},{"verse":29,"text":"主,しゅのからだをわきまえないで飲,のみ食,くいする者,ものは、その飲,のみ食,くいによって自分,じぶんにさばきを招,まねくからである。","tok":[["主","しゅ"],["の"],["からだ"],["を"],["わきまえないで"],["飲み食い","のみくい"],["する"],["者","もの"],["は"],["、"],["その"],["飲み食い","のみくい"],["によって"],["自分","じぶん"],["に"],["さばき"],["を"],["招く","まねく"],["から"],["で"],["ある"],["。"]]},{"verse":30,"text":"あなたがたの中,なかに、弱,よわい者,ものや病人,びょうにんが大,おおぜいおり、また眠,ねむった者,ものも少,すくなくないのは、そのためである。","tok":[["あなた"],["がた"],["の"],["中","なか"],["に"],["、"],["弱い","よわい"],["者","もの"],["や"],["病人","びょうにん"],["が"],["大ぜい","おおぜい"],["おり"],["、"],["また"],["眠った","ねむった"],["者","もの"],["も"],["少く","すくなく"],["ない"],["の"],["は"],["、"],["その"],["ため"],["で"],["ある"],["。"]]},{"verse":31,"text":"しかし、自分,じぶんをよくわきまえておくならば、わたしたちはさばかれることはないであろう。","tok":[["しかし"],["、"],["自分","じぶん"],["を"],["よく"],["わきまえて"],["おくならば"],["、"],["わたしたち"],["は"],["さばかれる"],["こと"],["は"],["ないで"],["あろう"],["。"]]},{"verse":32,"text":"しかし、さばかれるとすれば、それは、この世,よと共,ともに罪,つみに定,さだめられないために、主,しゅの懲,こらしめを受,うけることなのである。","tok":[["しかし"],["、"],["さばかれる"],["と"],["すれば"],["、"],["それ"],["は"],["、"],["この世","このよ"],["と"],["共","とも"],["に"],["罪","つみ"],["に"],["定められない","さだめられない"],["ため"],["に"],["、"],["主","しゅ"],["の"],["懲らしめ","こらしめ"],["を"],["受る","うける"],["こと"],["な"],["ので"],["ある"],["。"]]},{"verse":33,"text":"それだから、兄弟,きょうだいたちよ。食事,しょくじのために集,あつまる時,ときには、互,たがいに待,まち合,あわせなさい。","tok":[["それ"],["だ"],["から"],["、"],["兄弟","きょうだい"],["たち"],["よ"],["。"],["食事","しょくじ"],["の"],["ため"],["に"],["集まる","あつまる"],["時","とき"],["に"],["は"],["、"],["互","たがい"],["に"],["待合","まちあわせ"],["なさい"],["。"]]},{"verse":34,"text":"もし空腹,くうふくであったら、さばきを受,うけに集,あつまることにならないため、家,いえで食,たべるがよい。そのほかの事,ことは、わたしが行,いった時,ときに、定,さだめることにしよう。","tok":[["もし"],["空腹","くうふく"],["で"],["あったら"],["、"],["さばき"],["を"],["受け","うけ"],["に"],["集まる","あつまる"],["こと"],["に"],["ならない"],["ため"],["、"],["家","いえ"],["で"],["食べる","たべる"],["が"],["よい"],["。"],["その"],["ほか"],["の"],["事","こと"],["は"],["、"],["わたし"],["が"],["行った","いった"],["時","とき"],["に"],["、"],["定める","さだめる"],["こと"],["に"],["しよう"],["。"]]}]
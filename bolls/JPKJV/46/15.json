[{"verse":1,"text":"兄弟,きょうだいたちよ。わたしが以前,いぜんあなたがたに伝,つたえた福音,ふくいん、あなたがたが受,うけいれ、それによって立,たってきたあの福音,ふくいんを、思,おもい起,おこしてもらいたい。","tok":[["兄弟","きょうだい"],["たち"],["よ"],["。"],["わたし"],["が"],["以前","いぜん"],["あなた"],["がた"],["に"],["伝えた","つたえた"],["福音","ふくいん"],["、"],["あなた"],["がた"],["が"],["受","うけ"],["いれ"],["、"],["それ"],["によって"],["立って","たって"],["きた"],["あの"],["福音","ふくいん"],["を"],["、"],["思い起こして","おもいおこして"],["もらいたい"],["。"]]},{"verse":2,"text":"もしあなたがたが、いたずらに信,しんじないで、わたしの宣,のべ伝,つたえたとおりの言葉,ことばを固,かたく守,まもっておれば、この福音,ふくいんによって救,すくわれるのである。","tok":[["もし"],["あなた"],["が"],["た"],["が"],["、"],["いたずら"],["に"],["信じないで","しんじないで"],["、"],["わたし"],["の"],["宣べ伝えた","のべつたえた"],["とおり"],["の"],["言葉","ことば"],["を"],["固く","かたく"],["守って","まもって"],["おれば"],["、"],["この"],["福音","ふくいん"],["によって"],["救われる","すくわれる"],["ので"],["ある"],["。"]]},{"verse":3,"text":"わたしが最,もっとも大事,だいじなこととしてあなたがたに伝,つたえたのは、わたし自身,じしんも受,うけたことであった。すなわちキリストが、聖書,せいしょに書,かいてあるとおり、わたしたちの罪,つみのために死,しんだこと、","tok":[["わたし"],["が"],["最も","もっとも"],["大事","だいじ"],["な"],["こと"],["として"],["あなた"],["がた"],["に"],["伝えた","つたえた"],["の"],["は"],["、"],["わたし"],["自身","じしん"],["も"],["受た","うけた"],["こと"],["で"],["あった"],["。"],["すなわち"],["キリスト"],["が"],["、"],["聖書","せいしょ"],["に"],["書いて","かいて"],["ある"],["と"],["おり"],["、"],["わたしたち"],["の"],["罪","つみ"],["の"],["ため"],["に"],["死んだ","しんだ"],["こと"],["、"]]},{"verse":4,"text":"そして葬,ほうむられたこと、聖書,せいしょに書,かいてあるとおり、三日,か目,めによみがえったこと、","tok":[["そして"],["葬むられた","ほうむられた"],["こと"],["、"],["聖書","せいしょ"],["に"],["書いて","かいて"],["ある"],["と"],["おり"],["、"],["三日目","かめ"],["に"],["よみがえった"],["こと"],["、"]]},{"verse":5,"text":"ケパに現,あらわれ、次,つぎに、十二人,にんに現,あらわれたことである。","tok":[["ケパ"],["に"],["現われ","あらわれ"],["、"],["次","つぎ"],["に"],["、"],["十二人","にん"],["に"],["現われた","あらわれた"],["こと"],["で"],["ある"],["。"]]},{"verse":6,"text":"そののち、五百人,にん以上,いじょうの兄弟,きょうだいたちに、同時,どうじに現,あらわれた。その中,なかにはすでに眠,ねむった者,ものたちもいるが、大多数,だいたすうはいまなお生存,せいぞんしている。","tok":[["その"],["のち"],["、"],["五百人","にん"],["以上","いじょう"],["の"],["兄弟","きょうだい"],["たち"],["に"],["、"],["同時","どうじ"],["に"],["現われた","あらわれた"],["。"],["その"],["中","なか"],["に"],["は"],["すでに"],["眠った","ねむった"],["者","もの"],["たち"],["も"],["いる"],["が"],["、"],["大多数","だいたすう"],["は"],["いま"],["なお"],["生存","せいぞん"],["して"],["いる"],["。"]]},{"verse":7,"text":"そののち、ヤコブに現,あらわれ、次,つぎに、すべての使徒,しとたちに現,あらわれ、","tok":[["その"],["のち"],["、"],["ヤコブ"],["に"],["現われ","あらわれ"],["、"],["次","つぎ"],["に"],["、"],["すべて"],["の"],["使徒","しと"],["たち"],["に"],["現われ","あらわれ"],["、"]]},{"verse":8,"text":"そして最後,さいごに、いわば、月,つき足,たらずに生,うまれたようなわたしにも、現,あらわれたのである。","tok":[["そして"],["最後","さいご"],["に"],["、"],["いわば"],["、"],["月足らず","つきたらず"],["に"],["生まれた","うまれた"],["よう"],["な"],["わたし"],["に"],["も"],["、"],["現われた","あらわれた"],["ので"],["ある"],["。"]]},{"verse":9,"text":"実際,じっさいわたしは、神,かみの教会,きょうかいを迫害,はくがいしたのであるから、使徒,しとたちの中,なかでいちばん小,ちいさい者,ものであって、使徒,しとと呼,よばれる値,ねうちのない者,ものである。","tok":[["実際","じっさい"],["わたし"],["は"],["、"],["神","かみ"],["の"],["教会","きょうかい"],["を"],["迫害","はくがい"],["した"],["ので"],["ある"],["から"],["、"],["使徒","しと"],["たち"],["の"],["中","なか"],["で"],["いちばん"],["小さい","ちいさい"],["者","もの"],["で"],["あって"],["、"],["使徒","しと"],["と"],["呼ばれる","よばれる"],["値うち","ねうち"],["の"],["ない"],["者","もの"],["で"],["ある"],["。"]]},{"verse":10,"text":"しかし、神,かみの恵,めぐみによって、わたしは今日,こんにちあるを得,えているのである。そして、わたしに賜,たまわった神,かみの恵,めぐみはむだにならず、むしろ、わたしは彼,かれらの中,なかのだれよりも多,おおく働,はたらいてきた。しかしそれは、わたし自身,じしんではなく、わたしと共,ともにあった神,かみの恵,めぐみである。","tok":[["しかし"],["、"],["神","かみ"],["の"],["恵","めぐみ"],["によって"],["、"],["わたし"],["は"],["今日","こんにちある"],["を"],["得て","えて"],["いる"],["ので"],["ある"],["。"],["そして"],["、"],["わたし"],["に"],["賜わった","たまわった"],["神","かみ"],["の"],["恵","めぐみ"],["は"],["むだ"],["に"],["ならず"],["、"],["むしろ"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["中","なか"],["の"],["だれ"],["より"],["も"],["多く","おおく"],["働いて","はたらいて"],["きた"],["。"],["しかし"],["それ"],["は"],["、"],["わたし"],["自身","じしん"],["で"],["は"],["なく"],["、"],["わたし"],["と"],["共","とも"],["に"],["あった"],["神","かみ"],["の"],["恵","めぐみ"],["で"],["ある"],["。"]]},{"verse":11,"text":"とにかく、わたしにせよ彼,かれらにせよ、そのように、わたしたちは宣,のべ伝,つたえており、そのように、あなたがたは信,しんじたのである。","tok":[["とにかく"],["、"],["わたし"],["に"],["せよ"],["彼","かれ"],["ら"],["に"],["せよ"],["、"],["その"],["よう"],["に"],["、"],["わたしたち"],["は"],["宣べ伝えて","のべつたえて"],["おり"],["、"],["その"],["よう"],["に"],["、"],["あなた"],["がた"],["は"],["信じた","しんじた"],["ので"],["ある"],["。"]]},{"verse":12,"text":"さて、キリストは死人,しにんの中,なかからよみがえったのだと宣,のべ伝,つたえられているのに、あなたがたの中,なかのある者,ものが、死人,しにんの復活,ふっかつなどはないと言,いっているのは、どうしたことか。","tok":[["さて"],["、"],["キリスト"],["は"],["死人","しにん"],["の"],["中","なか"],["から"],["よみがえった"],["の"],["だ"],["と"],["宣べ伝えられて","のべつたえられて"],["いる"],["のに"],["、"],["あなた"],["がた"],["の"],["中","なか"],["の"],["ある"],["者","もの"],["が"],["、"],["死人","しにん"],["の"],["復活","ふっかつ"],["など"],["は"],["ない"],["と"],["言って","いって"],["いる"],["の"],["は"],["、"],["どう"],["した"],["こと"],["か"],["。"]]},{"verse":13,"text":"もし死人,しにんの復活,ふっかつがないならば、キリストもよみがえらなかったであろう。","tok":[["もし"],["死人","しにん"],["の"],["復活","ふっかつ"],["が"],["ないならば"],["、"],["キリスト"],["も"],["よみがえらなかったで"],["あろう"],["。"]]},{"verse":14,"text":"もしキリストがよみがえらなかったとしたら、わたしたちの宣教,せんきょうはむなしく、あなたがたの信仰,しんこうもまたむなしい。","tok":[["もし"],["キリスト"],["が"],["よみがえらなかった"],["と"],["したら"],["、"],["わたしたち"],["の"],["宣教","せんきょう"],["は"],["むなしく"],["、"],["あなた"],["がた"],["の"],["信仰","しんこう"],["も"],["また"],["むなしい"],["。"]]},{"verse":15,"text":"すると、わたしたちは神,かみにそむく偽証人,ぎしょうにんにさえなるわけだ。なぜなら、万一,まんいち死人,しにんがよみがえらないとしたら、わたしたちは神,かみが実際,じっさいよみがえらせなかったはずのキリストを、よみがえらせたと言,いって、神,かみに反,はんするあかしを立,たてたことになるからである。","tok":[["する"],["と"],["、"],["わたしたち"],["は"],["神","かみ"],["に"],["そむく"],["偽証人","ぎしょうにん"],["に"],["さえ"],["なる"],["わけ"],["だ"],["。"],["なぜ"],["なら"],["、"],["万一","まんいち"],["死人","しにん"],["が"],["よみがえらない"],["と"],["したら"],["、"],["わたしたち"],["は"],["神","かみ"],["が"],["実際","じっさい"],["よみがえらせなかった"],["はず"],["の"],["キリスト"],["を"],["、"],["よみがえらせた"],["と"],["言って","いって"],["、"],["神","かみ"],["に"],["反する","はんする"],["あかし"],["を"],["立てた","たてた"],["こと"],["に"],["なる"],["から"],["で"],["ある"],["。"]]},{"verse":16,"text":"もし死人,しにんがよみがえらないなら、キリストもよみがえらなかったであろう。","tok":[["もし"],["死人","しにん"],["が"],["よみがえらないなら"],["、"],["キリスト"],["も"],["よみがえらなかったで"],["あろう"],["。"]]},{"verse":17,"text":"もしキリストがよみがえらなかったとすれば、あなたがたの信仰,しんこうは空虚,くうきょなものとなり、あなたがたは、いまなお罪,つみの中,なかにいることになろう。","tok":[["もし"],["キリスト"],["が"],["よみがえらなかった"],["と"],["すれば"],["、"],["あなた"],["がた"],["の"],["信仰","しんこう"],["は"],["空虚","くうきょ"],["な"],["もの"],["と"],["なり"],["、"],["あなた"],["がた"],["は"],["、"],["いま"],["な"],["お罪","おつみ"],["の"],["中","なか"],["に"],["いる"],["こと"],["に"],["なろう"],["。"]]},{"verse":18,"text":"そうだとすると、キリストにあって眠,ねむった者,ものたちは、滅,ほろんでしまったのである。","tok":[["そう"],["だ"],["と"],["する"],["と"],["、"],["キリスト"],["に"],["あって"],["眠った","ねむった"],["者","もの"],["たち"],["は"],["、"],["滅","ほ"],["ろん"],["で"],["しまった"],["ので"],["ある"],["。"]]},{"verse":19,"text":"もしわたしたちが、この世,よの生活,せいかつでキリストにあって単,たんなる望,のぞみをいだいているだけだとすれば、わたしたちは、すべての人,ひとの中,なかで最,もっともあわれむべき存在,そんざいとなる。","tok":[["もし"],["わたしたち"],["が"],["、"],["この世","このよ"],["の"],["生活","せいかつ"],["で"],["キリスト"],["に"],["あって"],["単なる","たんなる"],["望み","のぞみ"],["を"],["いだいて"],["いる"],["だけ"],["だ"],["と"],["すれば"],["、"],["わたしたち"],["は"],["、"],["すべて"],["の"],["人","ひと"],["の"],["中","なか"],["で"],["最も","もっとも"],["あわれむべき"],["存在","そんざい"],["と"],["なる"],["。"]]},{"verse":20,"text":"しかし事実,じじつ、キリストは眠,ねむっている者,ものの初穂,はつほとして、死人,しにんの中,なかからよみがえったのである。","tok":[["しかし"],["事実","じじつ"],["、"],["キリスト"],["は"],["眠って","ねむって"],["いる"],["者","もの"],["の"],["初穂","はつほ"],["として"],["、"],["死人","しにん"],["の"],["中","なか"],["から"],["よみがえった"],["ので"],["ある"],["。"]]},{"verse":21,"text":"それは、死,しがひとりの人,ひとによってきたのだから、死人,しにんの復活,ふっかつもまた、ひとりの人,ひとによってこなければならない。","tok":[["それ"],["は"],["、"],["死","し"],["が"],["ひとり"],["の"],["人","ひと"],["によって"],["きた"],["の"],["だ"],["から"],["、"],["死人","しにん"],["の"],["復活","ふっかつ"],["も"],["また"],["、"],["ひとり"],["の"],["人","ひと"],["によって"],["こなければ"],["ならない"],["。"]]},{"verse":22,"text":"アダムにあってすべての人,ひとが死,しんでいるのと同,おなじように、キリストにあってすべての人,ひとが生,いかされるのである。","tok":[["アダム"],["に"],["あって"],["すべて"],["の"],["人","ひと"],["が"],["死んで","しんで"],["いる"],["の"],["と"],["同じ","おなじ"],["よう"],["に"],["、"],["キリスト"],["に"],["あって"],["すべて"],["の"],["人","ひと"],["が"],["生かされる","いかされる"],["ので"],["ある"],["。"]]},{"verse":23,"text":"ただ、各自,かくじはそれぞれの順序,じゅんじょに従,したがわねばならない。最初,さいしょはキリスト、次,つぎに、主,しゅの来臨,らいりんに際,さいしてキリストに属,ぞくする者,ものたち、","tok":[["ただ"],["、"],["各自","かくじ"],["は"],["それぞれ"],["の"],["順序","じゅんじょ"],["に"],["従わねば","したがわねば"],["ならない"],["。"],["最初","さいしょ"],["は"],["キリスト"],["、"],["次","つぎ"],["に"],["、"],["主","しゅ"],["の"],["来臨","らいりん"],["に"],["際して","さいして"],["キリスト"],["に"],["属する","ぞくする"],["者","もの"],["たち"],["、"]]},{"verse":24,"text":"それから終末,しゅうまつとなって、その時,ときに、キリストはすべての君,きみたち、すべての権威,けんいと権力,けんりょくとを打,うち滅,ほろぼして、国,くにを父,ちちなる神,かみに渡,わたされるのである。","tok":[["それ"],["から"],["終末","しゅうまつ"],["と"],["なって"],["、"],["その"],["時","とき"],["に"],["、"],["キリスト"],["は"],["すべて"],["の"],["君","きみ"],["たち"],["、"],["すべて"],["の"],["権威","けんい"],["と"],["権力","けんりょく"],["と"],["を"],["打ち滅ぼして","うちほろぼして"],["、"],["国","くに"],["を"],["父","ちち"],["なる"],["神","かみ"],["に"],["渡される","わたされる"],["ので"],["ある"],["。"]]},{"verse":25,"text":"なぜなら、キリストはあらゆる敵,てきをその足,あしもとに置,おく時,ときまでは、支配,しはいを続,つづけることになっているからである。","tok":[["なぜ"],["なら"],["、"],["キリスト"],["は"],["あらゆる"],["敵","てき"],["を"],["その"],["足もと","あしもと"],["に"],["置く","おく"],["時","とき"],["まで"],["は"],["、"],["支配","しはい"],["を"],["続ける","つづける"],["こと"],["に"],["なって"],["いる"],["から"],["で"],["ある"],["。"]]},{"verse":26,"text":"最後,さいごの敵,てきとして滅,ほろぼされるのが、死,しである。","tok":[["最後","さいご"],["の"],["敵","てき"],["として"],["滅ぼされる","ほろぼされる"],["の"],["が"],["、"],["死","し"],["で"],["ある"],["。"]]},{"verse":27,"text":"「神,かみは万物,ばんぶつを彼,かれの足,あしもとに従,したがわせた」からである。ところが、万物,ばんぶつを従,したがわせたと言,いわれる時,とき、万物,ばんぶつを従,したがわせたかたがそれに含,ふくまれていないことは、明,あきらかである。","tok":[["「"],["神","かみ"],["は"],["万物","ばんぶつ"],["を"],["彼","かれ"],["の"],["足もと","あしもと"],["に"],["従わせた","したがわせた"],["」"],["から"],["で"],["ある"],["。"],["ところ"],["が"],["、"],["万物","ばんぶつ"],["を"],["従わせた","したがわせた"],["と"],["言われる","いわれる"],["時","とき"],["、"],["万物","ばんぶつ"],["を"],["従わせた","したがわせた"],["かた"],["が"],["それ"],["に"],["含まれて","ふくまれて"],["いない"],["こと"],["は"],["、"],["明か","あきらか"],["で"],["ある"],["。"]]},{"verse":28,"text":"そして、万物,ばんぶつが神,かみに従,したがう時,ときには、御子,みこ自身,じしんもまた、万物,ばんぶつを従,したがわせたそのかたに従,したがうであろう。それは、神,かみがすべての者,ものにあって、すべてとなられるためである。","tok":[["そして"],["、"],["万物","ばんぶつ"],["が"],["神","かみ"],["に"],["従う","したがう"],["時","とき"],["に"],["は"],["、"],["御子","みこ"],["自身","じしん"],["も"],["また"],["、"],["万物","ばんぶつ"],["を"],["従わせた","したがわせた"],["その"],["かた"],["に"],["従うで","したがうで"],["あろう"],["。"],["それ"],["は"],["、"],["神","かみ"],["が"],["すべて"],["の"],["者","もの"],["に"],["あって"],["、"],["すべて"],["と"],["なられる"],["ため"],["で"],["ある"],["。"]]},{"verse":29,"text":"そうでないとすれば、死者,ししゃのためにバプテスマを受,うける人々,ひとびとは、なぜそれをするのだろうか。もし死者,ししゃが全,まったくよみがえらないとすれば、なぜ人々,ひとびとが死者,ししゃのためにバプテスマを受,うけるのか。","tok":[["そう"],["で"],["ない"],["と"],["すれば"],["、"],["死者","ししゃ"],["の"],["ため"],["に"],["バプテスマ"],["を"],["受る","うける"],["人々","ひとびと"],["は"],["、"],["なぜ"],["それ"],["を"],["する"],["の"],["だろう"],["か"],["。"],["もし"],["死者","ししゃ"],["が"],["全く","まったく"],["よみがえらない"],["と"],["すれば"],["、"],["なぜ"],["人々","ひとびと"],["が"],["死者","ししゃ"],["の"],["ため"],["に"],["バプテスマ"],["を"],["受る","うける"],["の"],["か"],["。"]]},{"verse":30,"text":"また、なんのために、わたしたちはいつも危険,きけんを冒,おかしているのか。","tok":[["また"],["、"],["なん"],["の"],["ため"],["に"],["、"],["わたしたち"],["は"],["いつも"],["危険","きけん"],["を"],["冒して","おかして"],["いる"],["の"],["か"],["。"]]},{"verse":31,"text":"兄弟,きょうだいたちよ。わたしたちの主,しゅキリスト・イエスにあって、わたしがあなたがたにつき持,もっている誇,ほこりにかけて言,いうが、わたしは日々,ひび死,しんでいるのである。","tok":[["兄弟","きょうだい"],["たち"],["よ"],["。"],["わたしたち"],["の"],["主","しゅ"],["キリスト"],["・"],["イエス"],["に"],["あって"],["、"],["わたし"],["が"],["あなた"],["がた"],["に"],["つき"],["持って","もって"],["いる"],["誇","ほこり"],["に"],["かけて"],["言う","いう"],["が"],["、"],["わたし"],["は"],["日々","ひび"],["死んで","しんで"],["いる"],["ので"],["ある"],["。"]]},{"verse":32,"text":"もし、わたしが人間,にんげんの考,かんがえによってエペソで獣,けものと戦,たたかったとすれば、それはなんの役,やくに立,たつのか。もし死人,しにんがよみがえらないのなら、「わたしたちは飲,のみ食,くいしようではないか。あすもわからぬいのちなのだ」。","tok":[["もし"],["、"],["わたし"],["が"],["人間","にんげん"],["の"],["考","かんがえ"],["によって"],["エペソ"],["で"],["獣","けもの"],["と"],["戦った","たたかった"],["と"],["すれば"],["、"],["それ"],["は"],["なん"],["の"],["役","やく"],["に"],["立つ","たつ"],["の"],["か"],["。"],["もし"],["死人","しにん"],["が"],["よみがえらない"],["の"],["なら"],["、"],["「"],["わたしたち"],["は"],["飲み食い","のみくい"],["しようで"],["は"],["ない"],["か"],["。"],["あす"],["も"],["わからぬ"],["いのち"],["な"],["の"],["だ"],["」"],["。"]]},{"verse":33,"text":"まちがってはいけない。「悪,わるい交,まじわりは、良,よいならわしをそこなう」。","tok":[["まちがって"],["は"],["いけない"],["。"],["「"],["悪い","わるい"],["交じわり","まじわり"],["は"],["、"],["良い","よい"],["ならわし"],["を"],["そこなう"],["」"],["。"]]},{"verse":34,"text":"目,めざめて身,みを正,ただし、罪,つみを犯,おかさないようにしなさい。あなたがたのうちには、神,かみについて無知,むちな人々,ひとびとがいる。あなたがたをはずかしめるために、わたしはこう言,いうのだ。","tok":[["目ざめて","めざめて"],["身","み"],["を"],["正し","ただし"],["、"],["罪","つみ"],["を"],["犯さない","おかさない"],["よう"],["に"],["し"],["なさい"],["。"],["あなた"],["がた"],["の"],["うち"],["に"],["は"],["、"],["神","かみ"],["について"],["無知","むち"],["な"],["人々","ひとびと"],["が"],["いる"],["。"],["あなた"],["がた"],["を"],["はずかしめる"],["ため"],["に"],["、"],["わたし"],["は"],["こう"],["言う","いう"],["の"],["だ"],["。"]]},{"verse":35,"text":"しかし、ある人,ひとは言,いうだろう。「どんなふうにして、死人,しにんがよみがえるのか。どんなからだをして来,くるのか」。","tok":[["しかし"],["、"],["ある"],["人","ひと"],["は"],["言うだろう","いうだろう"],["。"],["「"],["どんな"],["ふう"],["に"],["して"],["、"],["死人","しにん"],["が"],["よみがえる"],["の"],["か"],["。"],["どんな"],["からだ"],["を"],["して"],["来る","くる"],["の"],["か"],["」"],["。"]]},{"verse":36,"text":"おろかな人,ひとである。あなたのまくものは、死,しななければ、生,いかされないではないか。","tok":[["おろか"],["な"],["人","ひと"],["で"],["ある"],["。"],["あなた"],["の"],["まく"],["もの"],["は"],["、"],["死ななければ","しななければ"],["、"],["生かされないで","いかされないで"],["は"],["ない"],["か"],["。"]]},{"verse":37,"text":"また、あなたのまくのは、やがて成,なるべきからだをまくのではない。麦,むぎであっても、ほかの種,たねであっても、ただの種,たね粒,つぶにすぎない。","tok":[["また"],["、"],["あなた"],["の"],["まく"],["の"],["は"],["、"],["やがて"],["成るべき","なるべき"],["からだ"],["を"],["まく"],["ので"],["は"],["ない"],["。"],["麦","むぎ"],["で"],["あって"],["も"],["、"],["ほか"],["の"],["種","たね"],["で"],["あって"],["も"],["、"],["ただ"],["の"],["種粒","たねつぶ"],["に"],["すぎない"],["。"]]},{"verse":38,"text":"ところが、神,かみはみこころのままに、これにからだを与,あたえ、その一つ一つの種,たねにそれぞれのからだをお与,あたえになる。","tok":[["ところ"],["が"],["、"],["神","かみ"],["は"],["みこころ"],["の"],["まま"],["に"],["、"],["これ"],["に"],["からだ"],["を"],["与","あたえ"],["、"],["その"],["一","ひと"],["つ"],["一","ひと"],["つ"],["の"],["種","たね"],["に"],["それぞれ"],["の"],["からだ"],["を"],["お"],["与","あたえ"],["に"],["なる"],["。"]]},{"verse":39,"text":"すべての肉,にくが、同,おなじ肉,にくなのではない。人,ひとの肉,にくがあり、獣,けものの肉,にくがあり、鳥,とりの肉,にくがあり、魚,さかなの肉,にくがある。","tok":[["すべて"],["の"],["肉","にく"],["が"],["、"],["同じ","おなじ"],["肉","にく"],["な"],["ので"],["は"],["ない"],["。"],["人","ひと"],["の"],["肉","にく"],["が"],["あり"],["、"],["獣","けもの"],["の"],["肉","にく"],["が"],["あり"],["、"],["鳥","とり"],["の"],["肉","にく"],["が"],["あり"],["、"],["魚","さかな"],["の"],["肉","にく"],["が"],["ある"],["。"]]},{"verse":40,"text":"天,てんに属,ぞくするからだもあれば、地,ちに属,ぞくするからだもある。天,てんに属,ぞくするものの栄光,えいこうは、地,ちに属,ぞくするものの栄光,えいこうと違,ちがっている。","tok":[["天","てん"],["に"],["属する","ぞくする"],["からだ"],["も"],["あれば"],["、"],["地","ち"],["に"],["属する","ぞくする"],["からだ"],["も"],["ある"],["。"],["天","てん"],["に"],["属する","ぞくする"],["もの"],["の"],["栄光","えいこう"],["は"],["、"],["地","ち"],["に"],["属する","ぞくする"],["もの"],["の"],["栄光","えいこう"],["と"],["違って","ちがって"],["いる"],["。"]]},{"verse":41,"text":"日,ひの栄光,えいこうがあり、月,つきの栄光,えいこうがあり、星,ほしの栄光,えいこうがある。また、この星,ほしとあの星,ほしとの間,あいだに、栄光,えいこうの差,さがある。","tok":[["日","ひ"],["の"],["栄光","えいこう"],["が"],["あり"],["、"],["月","つき"],["の"],["栄光","えいこう"],["が"],["あり"],["、"],["星","ほし"],["の"],["栄光","えいこう"],["が"],["ある"],["。"],["また"],["、"],["この"],["星","ほし"],["と"],["あの"],["星","ほし"],["と"],["の"],["間","あいだ"],["に"],["、"],["栄光","えいこう"],["の"],["差","さ"],["が"],["ある"],["。"]]},{"verse":42,"text":"死人,しにんの復活,ふっかつも、また同様,どうようである。朽,くちるものでまかれ、朽,くちないものによみがえり、","tok":[["死人","しにん"],["の"],["復活","ふっかつ"],["も"],["、"],["また"],["同様","どうよう"],["で"],["ある"],["。"],["朽ちる","くちる"],["もの"],["で"],["まかれ"],["、"],["朽ちない","くちない"],["もの"],["に"],["よみがえり"],["、"]]},{"verse":43,"text":"卑,いやしいものでまかれ、栄光,えいこうあるものによみがえり、弱,よわいものでまかれ、強,つよいものによみがえり、","tok":[["卑しい","いやしい"],["もの"],["で"],["まかれ"],["、"],["栄光","えいこう"],["ある"],["もの"],["に"],["よみがえり"],["、"],["弱い","よわい"],["もの"],["で"],["まかれ"],["、"],["強い","つよい"],["もの"],["に"],["よみがえり"],["、"]]},{"verse":44,"text":"肉,にくのからだでまかれ、霊,れいのからだによみがえるのである。肉,にくのからだがあるのだから、霊,れいのからだもあるわけである。","tok":[["肉","にく"],["の"],["からだ"],["で"],["まかれ"],["、"],["霊","れい"],["の"],["からだ"],["に"],["よみがえる"],["ので"],["ある"],["。"],["肉","にく"],["の"],["からだ"],["が"],["ある"],["の"],["だ"],["から"],["、"],["霊","れい"],["の"],["からだ"],["も"],["ある"],["わけ"],["で"],["ある"],["。"]]},{"verse":45,"text":"聖書,せいしょに「最初,さいしょの人,ひとアダムは生,いきたものとなった」と書,かいてあるとおりである。しかし最後,さいごのアダムは命,いのちを与,あたえる霊,れいとなった。","tok":[["聖書","せいしょ"],["に"],["「"],["最初","さいしょ"],["の"],["人","ひと"],["アダム"],["は"],["生きた","いきた"],["もの"],["と"],["なった"],["」"],["と"],["書いて","かいて"],["ある"],["とおり"],["で"],["ある"],["。"],["しかし"],["最後","さいご"],["の"],["アダム"],["は"],["命","いのち"],["を"],["与える","あたえる"],["霊","れい"],["と"],["なった"],["。"]]},{"verse":46,"text":"最初,さいしょにあったのは、霊,れいのものではなく肉,にくのものであって、その後,のちに霊,れいのものが来,くるのである。","tok":[["最初","さいしょ"],["に"],["あった"],["の"],["は"],["、"],["霊","れい"],["の"],["もの"],["で"],["は"],["なく"],["肉","にく"],["の"],["もの"],["で"],["あって"],["、"],["その後","そののち"],["に"],["霊","れい"],["の"],["もの"],["が"],["来る","くる"],["ので"],["ある"],["。"]]},{"verse":47,"text":"第,だい一の人,ひとは地,ちから出,でて土,つちに属,ぞくし、第,だい二の人,ひとは天,てんから来,くる。","tok":[["第","だい"],["一","いち"],["の"],["人","ひと"],["は"],["地","ち"],["から"],["出て","でて"],["土","つち"],["に"],["属し","ぞくし"],["、"],["第","だい"],["二","に"],["の"],["人","ひと"],["は"],["天","てん"],["から"],["来る","くる"],["。"]]},{"verse":48,"text":"この土,つちに属,ぞくする人,ひとに、土,つちに属,ぞくしている人々,ひとびとは等,ひとしく、この天,てんに属,ぞくする人,ひとに、天,てんに属,ぞくしている人々,ひとびとは等,ひとしいのである。","tok":[["この"],["土","つち"],["に"],["属する","ぞくする"],["人","ひと"],["に"],["、"],["土","つち"],["に"],["属して","ぞくして"],["いる"],["人々","ひとびと"],["は"],["等く","ひとしく"],["、"],["この"],["天","てん"],["に"],["属する","ぞくする"],["人","ひと"],["に"],["、"],["天","てん"],["に"],["属して","ぞくして"],["いる"],["人々","ひとびと"],["は"],["等い","ひとしい"],["ので"],["ある"],["。"]]},{"verse":49,"text":"すなわち、わたしたちは、土,つちに属,ぞくしている形,かたちをとっているのと同様,どうように、また天,てんに属,ぞくしている形,かたちをとるであろう。","tok":[["すなわち"],["、"],["わたしたち"],["は"],["、"],["土","つち"],["に"],["属して","ぞくして"],["いる"],["形","かたち"],["を"],["とって"],["いる"],["の"],["と"],["同様","どうよう"],["に"],["、"],["また"],["天","てん"],["に"],["属して","ぞくして"],["いる"],["形","かたち"],["を"],["とるで"],["あろう"],["。"]]},{"verse":50,"text":"兄弟,きょうだいたちよ。わたしはこの事,ことを言,いっておく。肉,にくと血,ちとは神,かみの国,くにを継,つぐことができないし、朽,くちるものは朽,くちないものを継,つぐことがない。","tok":[["兄弟","きょうだい"],["たち"],["よ"],["。"],["わたし"],["は"],["この"],["事","こと"],["を"],["言って","いって"],["おく"],["。"],["肉","にく"],["と"],["血","ち"],["と"],["は"],["神","かみ"],["の"],["国","くに"],["を"],["継ぐ","つぐ"],["こと"],["が"],["できない"],["し"],["、"],["朽ちる","くちる"],["もの"],["は"],["朽ちない","くちない"],["もの"],["を"],["継ぐ","つぐ"],["こと"],["が"],["ない"],["。"]]},{"verse":51,"text":"ここで、あなたがたに奥義,おくぎを告,つげよう。わたしたちすべては、眠,ねむり続,つづけるのではない。終,おわりのラッパの響,ひびきと共,ともに、またたく間,あいだに、一瞬,いっしゅんにして変,かえられる。","tok":[["ここ"],["で"],["、"],["あなた"],["がた"],["に"],["奥義","おくぎ"],["を"],["告","つげ"],["よう"],["。"],["わたしたち"],["すべて"],["は"],["、"],["眠","ねむり"],["続ける","つづける"],["ので"],["は"],["ない"],["。"],["終","おわり"],["の"],["ラッパ"],["の"],["響","ひびき"],["と"],["共","とも"],["に"],["、"],["またたく"],["間","あいだ"],["に"],["、"],["一瞬","いっしゅん"],["に"],["して"],["変えられる","かえられる"],["。"]]},{"verse":52,"text":"というのは、ラッパが響,ひびいて、死人,しにんは朽,くちない者,ものによみがえらされ、わたしたちは変,かえられるのである。","tok":[["と"],["いう"],["の"],["は"],["、"],["ラッパ"],["が"],["響いて","ひびいて"],["、"],["死人","しにん"],["は"],["朽ちない","くちない"],["者","もの"],["に"],["よみがえらされ"],["、"],["わたしたち"],["は"],["変えられる","かえられる"],["ので"],["ある"],["。"]]},{"verse":53,"text":"なぜなら、この朽,くちるものは必,かならず朽,くちないものを着,き、この死,しぬものは必,かならず死,しなないものを着,きることになるからである。","tok":[["なぜ"],["なら"],["、"],["この"],["朽ちる","くちる"],["もの"],["は"],["必","かならず"],["朽ちない","くちない"],["もの"],["を"],["着","き"],["、"],["この"],["死ぬ","しぬ"],["もの"],["は"],["必死","かならずし"],["な"],["ない"],["もの"],["を"],["着る","きる"],["こと"],["に"],["なる"],["から"],["で"],["ある"],["。"]]},{"verse":54,"text":"この朽,くちるものが朽,くちないものを着,き、この死,しぬものが死,しなないものを着,きるとき、聖書,せいしょに書,かいてある言葉,ことばが成就,じょうじゅするのである。","tok":[["この"],["朽ちる","くちる"],["もの"],["が"],["朽ちない","くちない"],["もの"],["を"],["着","き"],["、"],["この"],["死ぬ","しぬ"],["もの"],["が"],["死なない","しなない"],["もの"],["を"],["着る","きる"],["とき"],["、"],["聖書","せいしょ"],["に"],["書いて","かいて"],["ある"],["言葉","ことば"],["が"],["成就","じょうじゅ"],["する"],["ので"],["ある"],["。"]]},{"verse":55,"text":"「死,しは勝利,しょうりにのまれてしまった。死,しよ、おまえの勝利,しょうりは、どこにあるのか。死,しよ、おまえのとげは、どこにあるのか」。","tok":[["「"],["死","し"],["は"],["勝利","しょうり"],["に"],["のまれて"],["しまった"],["。"],["死","し"],["よ"],["、"],["おまえ"],["の"],["勝利","しょうり"],["は"],["、"],["どこ"],["に"],["ある"],["の"],["か"],["。"],["死","し"],["よ"],["、"],["おまえ"],["の"],["とげ"],["は"],["、"],["どこ"],["に"],["ある"],["の"],["か"],["」"],["。"]]},{"verse":56,"text":"死,しのとげは罪,つみである。罪,つみの力,ちからは律法,りっぽうである。","tok":[["死","し"],["の"],["とげ"],["は"],["罪","つみ"],["で"],["ある"],["。"],["罪","つみ"],["の"],["力","ちから"],["は"],["律法","りっぽう"],["で"],["ある"],["。"]]},{"verse":57,"text":"しかし感謝,かんしゃすべきことには、神,かみはわたしたちの主,しゅイエス・キリストによって、わたしたちに勝利,しょうりを賜,たまわったのである。","tok":[["しかし"],["感謝","かんしゃ"],["すべき"],["こと"],["に"],["は"],["、"],["神","かみ"],["は"],["わたしたち"],["の"],["主","しゅ"],["イエス"],["・"],["キリスト"],["によって"],["、"],["わたしたち"],["に"],["勝利","しょうり"],["を"],["賜わった","たまわった"],["ので"],["ある"],["。"]]},{"verse":58,"text":"だから、愛,あいする兄弟,きょうだいたちよ。堅,かたく立,たって動,うごかされず、いつも全,ぜん力,りょくを注,そそいで主,しゅのわざに励,はげみなさい。主,しゅにあっては、あなたがたの労苦,ろうくがむだになることはないと、あなたがたは知,しっているからである。","tok":[["だ"],["から"],["、"],["愛する","あいする"],["兄弟","きょうだい"],["たち"],["よ"],["。"],["堅く","かたく"],["立って","たって"],["動かされず","うごかされず"],["、"],["いつも"],["全力","ぜんりょく"],["を"],["注いで","そそいで"],["主","しゅ"],["の"],["わざ"],["に"],["励み","はげみ"],["なさい"],["。"],["主に","しゅに"],["あって"],["は"],["、"],["あなた"],["がた"],["の"],["労苦","ろうく"],["が"],["むだ"],["に"],["なる"],["こと"],["は"],["ない"],["と"],["、"],["あなた"],["がた"],["は"],["知って","しって"],["いる"],["から"],["で"],["ある"],["。"]]}]
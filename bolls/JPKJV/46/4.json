[{"verse":1,"text":"このようなわけだから、人,ひとはわたしたちを、キリストに仕,つかえる者,もの、神,かみの奥義,おくぎを管理,かんりしている者,ものと見,みるがよい。","tok":[["この"],["よう"],["な"],["わけ"],["だ"],["から"],["、"],["人","ひと"],["は"],["わたしたち"],["を"],["、"],["キリスト"],["に"],["仕える","つかえる"],["者","もの"],["、"],["神","かみ"],["の"],["奥義","おくぎ"],["を"],["管理","かんり"],["して"],["いる"],["者","もの"],["と"],["見る","みる"],["が"],["よい"],["。"]]},{"verse":2,"text":"この場合,ばあい、管理者,かんりしゃに要求,ようきゅうされているのは、忠実,ちゅうじつであることである。","tok":[["この"],["場合","ばあい"],["、"],["管理者","かんりしゃ"],["に"],["要求","ようきゅう"],["されて"],["いる"],["の"],["は"],["、"],["忠実","ちゅうじつ"],["で"],["ある"],["こと"],["で"],["ある"],["。"]]},{"verse":3,"text":"わたしはあなたがたにさばかれたり、人間,にんげんの裁判,さいばんにかけられたりしても、なんら意,いに介,かいしない。いや、わたしは自分,じぶんをさばくこともしない。","tok":[["わたし"],["は"],["あなた"],["がた"],["に"],["さばかれ"],["たり"],["、"],["人間","にんげん"],["の"],["裁判","さいばん"],["に"],["かけられ"],["たり"],["して"],["も"],["、"],["なん"],["ら"],["意","い"],["に"],["介しない","かいしない"],["。"],["いや"],["、"],["わたし"],["は"],["自分","じぶん"],["を"],["さばく"],["こと"],["も"],["しない"],["。"]]},{"verse":4,"text":"わたしは自,みずから省,かえりみて、なんらやましいことはないが、それで義,ぎとされているわけではない。わたしをさばくかたは、主,しゅである。","tok":[["わたし"],["は"],["自から","みずから"],["省りみて","かえりみて"],["、"],["なん"],["ら"],["やましい"],["こと"],["は"],["ない"],["が"],["、"],["それ"],["で"],["義","ぎ"],["と"],["されて"],["いる"],["わけ"],["で"],["は"],["ない"],["。"],["わたし"],["を"],["さばく"],["かた"],["は"],["、"],["主","しゅ"],["で"],["ある"],["。"]]},{"verse":5,"text":"だから、主,しゅがこられるまでは、何事,なにごとについても、先,さき走,ばしりをしてさばいてはいけない。主,しゅは暗,くらい中,なかに隠,かくれていることを明,あかるみに出,だし、心,こころの中,なかで企,くわだてられていることを、あらわにされるであろう。その時,ときには、神,かみからそれぞれほまれを受,うけるであろう。","tok":[["だ"],["から"],["、"],["主","しゅ"],["が"],["こられる"],["まで"],["は"],["、"],["何事","なにごと"],["について"],["も"],["、"],["先走り","さきばしり"],["を"],["して"],["さばいて"],["は"],["いけない"],["。"],["主","しゅ"],["は"],["暗い","くらい"],["中","なか"],["に"],["隠れて","かくれて"],["いる"],["こと"],["を"],["明かるみ","あかるみ"],["に"],["出し","だし"],["、"],["心","こころ"],["の"],["中","なか"],["で"],["企だてられて","くわだてられて"],["いる"],["こと"],["を"],["、"],["あらわ"],["に"],["されるで"],["あろう"],["。"],["その"],["時","とき"],["に"],["は"],["、"],["神","かみ"],["から"],["それぞれ"],["ほまれ"],["を"],["受るで","うけるで"],["あろう"],["。"]]},{"verse":6,"text":"兄弟,きょうだいたちよ。これらのことをわたし自身,じしんとアポロとに当,あてはめて言,いって聞,きかせたが、それはあなたがたが、わたしたちを例,れいにとって、「しるされている定,さだめを越,こえない」ことを学,まなび、ひとりの人,ひとをあがめ、ほかの人,ひとを見,みさげて高,たかぶることのないためである。","tok":[["兄弟","きょうだい"],["たち"],["よ"],["。"],["これ"],["ら"],["の"],["こと"],["を"],["わたし"],["自身","じしん"],["と"],["アポロ"],["と"],["に"],["当てはめて","あてはめて"],["言って","いって"],["聞かせた","きかせた"],["が"],["、"],["それ"],["は"],["あなた"],["が"],["た"],["が"],["、"],["わたしたち"],["を"],["例","れい"],["にとって"],["、"],["「"],["しるされて"],["いる"],["定め","さだめ"],["を"],["越えない","こえない"],["」"],["こと"],["を"],["学び","まなび"],["、"],["ひとり"],["の"],["人","ひと"],["を"],["あがめ"],["、"],["ほか"],["の"],["人","ひと"],["を"],["見さげて","みさげて"],["高か","たか"],["ぶる"],["こと"],["の"],["ない"],["ため"],["で"],["ある"],["。"]]},{"verse":7,"text":"いったい、あなたを偉,えらくしているのは、だれなのか。あなたの持,もっているもので、もらっていないものがあるか。もしもらっているなら、なぜもらっていないもののように誇,ほこるのか。","tok":[["いったい"],["、"],["あなた"],["を"],["偉く","えらく"],["して"],["いる"],["の"],["は"],["、"],["だれ"],["な"],["の"],["か"],["。"],["あなた"],["の"],["持って","もって"],["いる"],["もの"],["で"],["、"],["もらって"],["いない"],["もの"],["が"],["ある"],["か"],["。"],["もし"],["もらって"],["いるなら"],["、"],["なぜ"],["もらって"],["いない"],["もの"],["の"],["よう"],["に"],["誇る","ほこる"],["の"],["か"],["。"]]},{"verse":8,"text":"あなたがたは、すでに満腹,まんぷくしているのだ。すでに富,とみ栄,さかえているのだ。わたしたちを差,さしおいて、王,おうになっているのだ。ああ、王,おうになっていてくれたらと思,おもう。そうであったなら、わたしたちも、あなたがたと共,ともに王,おうになれたであろう。","tok":[["あなた"],["がた"],["は"],["、"],["すでに"],["満腹","まんぷく"],["して"],["いる"],["の"],["だ"],["。"],["すでに"],["富栄","とみさかえ"],["て"],["いる"],["の"],["だ"],["。"],["わたしたち"],["を"],["差し","さし"],["おいて"],["、"],["王","おう"],["に"],["なって"],["いる"],["の"],["だ"],["。"],["ああ"],["、"],["王","おう"],["に"],["なって"],["いて"],["くれたら"],["と"],["思う","おもう"],["。"],["そう"],["で"],["あったなら"],["、"],["わたしたち"],["も"],["、"],["あなた"],["がた"],["と"],["共","とも"],["に"],["王","おう"],["に"],["なれたで"],["あろう"],["。"]]},{"verse":9,"text":"わたしはこう考,かんがえる。神,かみはわたしたち使徒,しとを死刑囚,しけいしゅうのように、最後,さいごに出場,しゅつじょうする者,ものとして引,ひき出,だし、こうしてわたしたちは、全,ぜん世界,せかいに、天使,てんしにも人々,ひとびとにも見,みせ物,ものにされたのだ。","tok":[["わたし"],["は"],["こう"],["考","かんがえ"],["る"],["。"],["神","かみ"],["は"],["わたしたち"],["使徒","しと"],["を"],["死刑囚","しけいしゅう"],["の"],["よう"],["に"],["、"],["最後","さいご"],["に"],["出場","しゅつじょう"],["する"],["者","もの"],["として"],["引出し","ひきだし"],["、"],["こう"],["して"],["わたしたち"],["は"],["、"],["全","ぜん"],["世界","せかい"],["に"],["、"],["天使","てんし"],["に"],["も"],["人々","ひとびと"],["に"],["も"],["見せ物","みせもの"],["に"],["された"],["の"],["だ"],["。"]]},{"verse":10,"text":"わたしたちはキリストのゆえに愚,おろかな者,ものとなり、あなたがたはキリストにあって賢,かしこい者,ものとなっている。わたしたちは弱,よわいが、あなたがたは強,つよい。あなたがたは尊,たっとばれ、わたしたちは卑,いやしめられている。","tok":[["わたしたち"],["は"],["キリスト"],["の"],["ゆえ"],["に"],["愚か","おろか"],["な"],["者","もの"],["と"],["なり"],["、"],["あなた"],["がた"],["は"],["キリスト"],["に"],["あって"],["賢しこい","かしこい"],["者","もの"],["と"],["なって"],["いる"],["。"],["わたしたち"],["は"],["弱い","よわい"],["が"],["、"],["あなた"],["がた"],["は"],["強い","つよい"],["。"],["あなた"],["がた"],["は"],["尊","た"],["っと"],["ばれ"],["、"],["わたしたち"],["は"],["卑しめられて","いやしめられて"],["いる"],["。"]]},{"verse":11,"text":"今,いまの今,いままで、わたしたちは飢,うえ、かわき、裸,はだかにされ、打,うたれ、宿,やどなしであり、","tok":[["今","いま"],["の"],["今まで","いままで"],["、"],["わたしたち"],["は"],["飢","うえ"],["、"],["かわき"],["、"],["裸","はだか"],["に"],["され"],["、"],["打たれ","うたれ"],["、"],["宿","やど"],["なし"],["で"],["あり"],["、"]]},{"verse":12,"text":"苦労,くろうして自分,じぶんの手,てで働,はたらいている。はずかしめられては祝福,しゅくふくし、迫害,はくがいされては耐,たえ忍,しのび、","tok":[["苦労","くろう"],["して"],["自分","じぶん"],["の"],["手","て"],["で"],["働いて","はたらいて"],["いる"],["。"],["はずかしめられて"],["は"],["祝福","しゅくふく"],["し"],["、"],["迫害","はくがい"],["されて"],["は"],["耐え忍び","たえしのび"],["、"]]},{"verse":13,"text":"ののしられては優,やさしい言葉,ことばをかけている。わたしたちは今,いまに至,いたるまで、この世,よのちりのように、人間,にんげんのくずのようにされている。","tok":[["ののしられて"],["は"],["優しい","やさしい"],["言葉","ことば"],["を"],["かけて"],["いる"],["。"],["わたしたち"],["は"],["今","いま"],["に"],["至る","いたる"],["まで"],["、"],["この世","このよ"],["の"],["ちり"],["の"],["よう"],["に"],["、"],["人間","にんげん"],["の"],["くず"],["の"],["よう"],["に"],["されて"],["いる"],["。"]]},{"verse":14,"text":"わたしがこのようなことを書,かくのは、あなたがたをはずかしめるためではなく、むしろ、わたしの愛児,あいじとしてさとすためである。","tok":[["わたし"],["が"],["この"],["よう"],["な"],["こと"],["を"],["書く","かく"],["の"],["は"],["、"],["あなた"],["がた"],["を"],["はずかしめる"],["ため"],["で"],["は"],["なく"],["、"],["むしろ"],["、"],["わたし"],["の"],["愛児","あいじ"],["として"],["さとす"],["ため"],["で"],["ある"],["。"]]},{"verse":15,"text":"たといあなたがたに、キリストにある養育掛,よういくがかりが一万人,にんあったとしても、父,ちちが多,おおくあるのではない。キリスト・イエスにあって、福音,ふくいんによりあなたがたを生,うんだのは、わたしなのである。","tok":[["たとい"],["あなた"],["がた"],["に"],["、"],["キリスト"],["に"],["ある"],["養育","よういく"],["掛かり","がかり"],["が"],["一万人","にんあったとして"],["も"],["、"],["父","ちち"],["が"],["多く","おおく"],["ある"],["ので"],["は"],["ない"],["。"],["キリスト"],["・"],["イエス"],["に"],["あって"],["、"],["福音","ふくいん"],["に"],["より"],["あなた"],["がた"],["を"],["生","うんだ"],["の"],["は"],["、"],["わたし"],["な"],["ので"],["ある"],["。"]]},{"verse":16,"text":"そこで、あなたがたに勧,すすめる。わたしにならう者,ものとなりなさい。","tok":[["そこ"],["で"],["、"],["あなた"],["がた"],["に"],["勧める","すすめる"],["。"],["わたし"],["に"],["ならう"],["者","もの"],["と"],["なり"],["なさい"],["。"]]},{"verse":17,"text":"このことのために、わたしは主,しゅにあって愛,あいする忠実,ちゅうじつなわたしの子,こテモテを、あなたがたの所,ところにつかわした。彼,かれは、キリスト・イエスにおけるわたしの生活,せいかつのしかたを、わたしが至,いたる所,ところの教会,きょうかいで教,おしえているとおりに、あなたがたに思,おもい起,おこさせてくれるであろう。","tok":[["この"],["こと"],["の"],["ため"],["に"],["、"],["わたし"],["は"],["主に","しゅに"],["あって"],["愛する","あいする"],["忠実","ちゅうじつ"],["な"],["わたし"],["の"],["子","こ"],["テモテ"],["を"],["、"],["あなた"],["がた"],["の"],["所","ところ"],["に"],["つかわした"],["。"],["彼","かれ"],["は"],["、"],["キリスト"],["・"],["イエス"],["に"],["おける"],["わたし"],["の"],["生活","せいかつ"],["の"],["しかた"],["を"],["、"],["わたし"],["が"],["至る所","いたるところ"],["の"],["教会","きょうかい"],["で"],["教えて","おしえて"],["いる"],["とおり"],["に"],["、"],["あなた"],["がた"],["に"],["思い起こさせて","おもいおこさせて"],["くれるで"],["あろう"],["。"]]},{"verse":18,"text":"しかしある人々,ひとびとは、わたしがあなたがたの所,ところに来,くることはあるまいとみて、高,たかぶっているということである。","tok":[["しかし"],["ある"],["人々","ひとびと"],["は"],["、"],["わたし"],["が"],["あなた"],["がた"],["の"],["所","ところ"],["に"],["来る","くる"],["こと"],["は"],["あるまい"],["と"],["みて"],["、"],["高か","たか"],["ぶっ"],["て"],["いる"],["と"],["いう"],["こと"],["で"],["ある"],["。"]]},{"verse":19,"text":"しかし主,しゅのみこころであれば、わたしはすぐにでもあなたがたの所,ところに行,いって、高,たかぶっている者,ものたちの言葉,ことばではなく、その力,ちからを見,みせてもらおう。","tok":[["しかし"],["主","しゅ"],["のみ"],["こころ"],["で"],["あれば"],["、"],["わたし"],["は"],["すぐ"],["に"],["で"],["も"],["あなた"],["がた"],["の"],["所","ところ"],["に"],["行って","いって"],["、"],["高か","たか"],["ぶっ"],["て"],["いる"],["者","もの"],["たち"],["の"],["言葉","ことば"],["で"],["は"],["なく"],["、"],["その"],["力","ちから"],["を"],["見せて","みせて"],["もらおう"],["。"]]},{"verse":20,"text":"神,かみの国,くには言葉,ことばではなく、力,ちからである。","tok":[["神","かみ"],["の"],["国","くに"],["は"],["言葉","ことば"],["で"],["は"],["なく"],["、"],["力","ちから"],["で"],["ある"],["。"]]},{"verse":21,"text":"あなたがたは、どちらを望,のぞむのか。わたしがむちをもって、あなたがたの所,ところに行,ゆくことか、それとも、愛,あいと柔和,にゅうわな心,こころとをもって行,ゆくことであるか。","tok":[["あなた"],["がた"],["は"],["、"],["どちら"],["を"],["望む","のぞむ"],["の"],["か"],["。"],["わたし"],["が"],["むち"],["を"],["もって"],["、"],["あなた"],["がた"],["の"],["所","ところ"],["に"],["行","ゆくこ"],["と"],["か"],["、"],["それ"],["と"],["も"],["、"],["愛","あい"],["と"],["柔和","にゅうわ"],["な"],["心","こころ"],["と"],["を"],["もって"],["行","ゆくこ"],["と"],["で"],["ある"],["か"],["。"]]}]
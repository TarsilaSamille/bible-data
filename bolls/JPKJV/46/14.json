[{"verse":1,"text":"愛,あいを追,おい求,もとめなさい。また、霊,れいの賜物,たまものを、ことに預言,よげんすることを、熱心,ねっしんに求,もとめなさい。","tok":[["愛","あい"],["を"],["追い求め","おいもとめ"],["なさい"],["。"],["また"],["、"],["霊","れい"],["の"],["賜物","たまもの"],["を"],["、"],["こと"],["に"],["預言","よげん"],["する"],["こと"],["を"],["、"],["熱心","ねっしん"],["に"],["求め","もとめ"],["なさい"],["。"]]},{"verse":2,"text":"異言,いげんを語,かたる者,ものは、人,ひとにむかって語,かたるのではなく、神,かみにむかって語,かたるのである。それはだれにもわからない。彼,かれはただ、霊,れいによって奥義,おくぎを語,かたっているだけである。","tok":[["異言","いげん"],["を"],["語る","かたる"],["者","もの"],["は"],["、"],["人","ひと"],["に"],["むかって"],["語る","かたる"],["ので"],["は"],["なく"],["、"],["神","かみ"],["に"],["むかって"],["語る","かたる"],["ので"],["ある"],["。"],["それ"],["は"],["だれ"],["に"],["も"],["わからない"],["。"],["彼","かれ"],["は"],["ただ"],["、"],["霊","れい"],["によって"],["奥義","おくぎ"],["を"],["語って","かたって"],["いる"],["だけ"],["で"],["ある"],["。"]]},{"verse":3,"text":"しかし預言,よげんをする者,ものは、人,ひとに語,かたってその徳,とくを高,たかめ、彼,かれを励,はげまし、慰,なぐさめるのである。","tok":[["しかし"],["預言","よげん"],["を"],["する"],["者","もの"],["は"],["、"],["人","ひと"],["に"],["語って","かたって"],["その"],["徳","とく"],["を"],["高め","たかめ"],["、"],["彼","かれ"],["を"],["励まし","はげまし"],["、"],["慰さめる","なぐさめる"],["ので"],["ある"],["。"]]},{"verse":4,"text":"異言,いげんを語,かたる者,ものは自分,じぶんだけの徳,とくを高,たかめるが、預言,よげんをする者,ものは教会,きょうかいの徳,とくを高,たかめる。","tok":[["異言","いげん"],["を"],["語る","かたる"],["者","もの"],["は"],["自分","じぶん"],["だけ"],["の"],["徳","とく"],["を"],["高める","たかめる"],["が"],["、"],["預言","よげん"],["を"],["する"],["者","もの"],["は"],["教会","きょうかい"],["の"],["徳","とく"],["を"],["高める","たかめる"],["。"]]},{"verse":5,"text":"わたしは実際,じっさい、あなたがたがひとり残,のこらず異言,いげんを語,かたることを望,のぞむが、特,とくに預言,よげんをしてもらいたい。教会,きょうかいの徳,とくを高,たかめるように異言,いげんを解,とかない限,かぎり、異言,いげんを語,かたる者,ものよりも、預言,よげんをする者,ものの方,ほうがまさっている。","tok":[["わたし"],["は"],["実際","じっさい"],["、"],["あなた"],["がた"],["が"],["ひとり"],["残らず","のこらず"],["異言","いげん"],["を"],["語る","かたる"],["こと"],["を"],["望む","のぞむ"],["が"],["、"],["特に","とくに"],["預言","よげん"],["を"],["して"],["もらいたい"],["。"],["教会","きょうかい"],["の"],["徳","とく"],["を"],["高める","たかめる"],["よう"],["に"],["異言","いげん"],["を"],["解かない","とかない"],["限","かぎり"],["、"],["異言","いげん"],["を"],["語る","かたる"],["者","もの"],["より"],["も"],["、"],["預言","よげん"],["を"],["する"],["者","もの"],["の"],["方","ほう"],["が"],["まさって"],["いる"],["。"]]},{"verse":6,"text":"だから、兄弟,きょうだいたちよ。たといわたしがあなたがたの所,ところに行,いって異言,いげんを語,かたるとしても、啓示,けいじか知識,ちしきか預言,よげんか教,おしえかを語,かたらなければ、あなたがたに、なんの役,やくに立,たつだろうか。","tok":[["だ"],["から"],["、"],["兄弟","きょうだい"],["たち"],["よ"],["。"],["たとい"],["わたし"],["が"],["あなた"],["がた"],["の"],["所","ところ"],["に"],["行って","いって"],["異言","いげん"],["を"],["語る","かたる"],["として"],["も"],["、"],["啓示","けいじ"],["か"],["知識","ちしき"],["か"],["預言","よげん"],["か"],["教え","おしえ"],["か"],["を"],["語らなければ","かたらなければ"],["、"],["あなた"],["がた"],["に"],["、"],["なん"],["の"],["役","やく"],["に"],["立つだろう","たつだろう"],["か"],["。"]]},{"verse":7,"text":"また、笛,ふえや立琴,たてごとのような楽器,がっきでも、もしその音,おとに変化,へんかがなければ、何,なにを吹,ふいているのか、弾,ひいているのか、どうして知,しることができようか。","tok":[["また"],["、"],["笛","ふえ"],["や"],["立琴","たてごと"],["の"],["よう"],["な"],["楽器","がっき"],["で"],["も"],["、"],["もし"],["その"],["音","おと"],["に"],["変化","へんか"],["が"],["なければ"],["、"],["何に","なに"],["を"],["吹いて","ふいて"],["いる"],["の"],["か"],["、"],["弾いて","ひいて"],["いる"],["の"],["か"],["、"],["どう"],["して"],["知る","しる"],["こと"],["が"],["できよう"],["か"],["。"]]},{"verse":8,"text":"また、もしラッパがはっきりした音,おとを出,ださないなら、だれが戦闘,せんとうの準備,じゅんびをするだろうか。","tok":[["また"],["、"],["もし"],["ラッパ"],["が"],["はっきり"],["した"],["音","おと"],["を"],["出さないなら","ださないなら"],["、"],["だれ"],["が"],["戦闘","せんとう"],["の"],["準備","じゅんび"],["を"],["するだろう"],["か"],["。"]]},{"verse":9,"text":"それと同様,どうように、もしあなたがたが異言,いげんではっきりしない言葉,ことばを語,かたれば、どうしてその語,かたることがわかるだろうか。それでは、空,くうにむかって語,かたっていることになる。","tok":[["それ"],["と"],["同様","どうよう"],["に"],["、"],["もし"],["あなた"],["がた"],["が"],["異言","いげん"],["で"],["はっきり"],["しない"],["言葉","ことば"],["を"],["語れば","かたれば"],["、"],["どう"],["して"],["その"],["語る","かたる"],["こと"],["が"],["わかるだろう"],["か"],["。"],["それ"],["で"],["は"],["、"],["空","くう"],["に"],["むかって"],["語って","かたって"],["いる"],["こと"],["に"],["なる"],["。"]]},{"verse":10,"text":"世,よには多種,たしゅ多様,たようの言葉,ことばがあるだろうが、意味,いみのないものは一つもない。","tok":[["世","よ"],["に"],["は"],["多種","たしゅ"],["多様","たよう"],["の"],["言葉","ことば"],["が"],["あるだろう"],["が"],["、"],["意味","いみ"],["の"],["ない"],["もの"],["は"],["一","ひと"],["つ"],["も"],["ない"],["。"]]},{"verse":11,"text":"もしその言葉,ことばの意味,いみがわからないなら、語,かたっている人,ひとにとっては、わたしは異国人,いこくじんであり、語,かたっている人,ひとも、わたしにとっては異国人,いこくじんである。","tok":[["もし"],["その"],["言葉","ことば"],["の"],["意味","いみ"],["が"],["わからないなら"],["、"],["語って","かたって"],["いる"],["人","ひと"],["にとって"],["は"],["、"],["わたし"],["は"],["異国人","い"],["こく"],["じん"],["で"],["あり"],["、"],["語って","かたって"],["いる"],["人","ひと"],["も"],["、"],["わたし"],["にとって"],["は"],["異国人","い"],["こく"],["じん"],["で"],["ある"],["。"]]},{"verse":12,"text":"だから、あなたがたも、霊,れいの賜物,たまものを熱心,ねっしんに求,もとめている以上,いじょうは、教会,きょうかいの徳,とくを高,たかめるために、それを豊,ゆたかにいただくように励,はげむがよい。","tok":[["だ"],["から"],["、"],["あなた"],["がた"],["も"],["、"],["霊","れい"],["の"],["賜物","たまもの"],["を"],["熱心","ねっしん"],["に"],["求めて","もとめて"],["いる"],["以上","いじょう"],["は"],["、"],["教会","きょうかい"],["の"],["徳","とく"],["を"],["高める","たかめる"],["ため"],["に"],["、"],["それ"],["を"],["豊","ゆたか"],["に"],["いただく"],["よう"],["に"],["励む","はげむ"],["が"],["よい"],["。"]]},{"verse":13,"text":"このようなわけであるから、異言,いげんを語,かたる者,ものは、自分,じぶんでそれを解,とくことができるように祈,いのりなさい。","tok":[["この"],["よう"],["な"],["わけ"],["で"],["ある"],["から"],["、"],["異言","いげん"],["を"],["語る","かたる"],["者","もの"],["は"],["、"],["自分","じぶん"],["で"],["それ"],["を"],["解く","とく"],["こと"],["が"],["できる"],["よう"],["に"],["祈","いのり"],["なさい"],["。"]]},{"verse":14,"text":"もしわたしが異言,いげんをもって祈,いのるなら、わたしの霊,れいは祈,いのるが、知性,ちせいは実,みを結,むすばないからである。","tok":[["もし"],["わたし"],["が"],["異言","いげん"],["を"],["もって"],["祈るなら","いのるなら"],["、"],["わたし"],["の"],["霊","れい"],["は"],["祈る","いのる"],["が"],["、"],["知性","ちせい"],["は"],["実","み"],["を"],["結ばない","むすばない"],["から"],["で"],["ある"],["。"]]},{"verse":15,"text":"すると、どうしたらよいのか。わたしは霊,れいで祈,いのると共,ともに、知性,ちせいでも祈,いのりろう。霊,れいでさんびを歌,うたうと共,ともに、知性,ちせいでも歌,うたおう。","tok":[["する"],["と"],["、"],["どう"],["したら"],["よい"],["の"],["か"],["。"],["わたし"],["は"],["霊","れい"],["で"],["祈る","いのる"],["と"],["共","とも"],["に"],["、"],["知性","ちせい"],["で"],["も"],["祈り","いのり"],["ろう"],["。"],["霊","れい"],["で"],["さん"],["び"],["を"],["歌う","うたう"],["と"],["共","とも"],["に"],["、"],["知性","ちせい"],["で"],["も"],["歌おう","うたおう"],["。"]]},{"verse":16,"text":"そうでないと、もしあなたが霊,れいで祝福,しゅくふくの言葉,ことばを唱,となえても、初心者,しょしんじゃの席,せきにいる者,ものは、あなたの感謝,かんしゃに対,たいして、どうしてアァメンと言,いえようか。あなたが何,なにを言,いっているのか、彼,かれには通,つうじない。","tok":[["そう"],["で"],["ない"],["と"],["、"],["もし"],["あなた"],["が"],["霊","れい"],["で"],["祝福","しゅくふく"],["の"],["言葉","ことば"],["を"],["唱えて","となえて"],["も"],["、"],["初心者","しょしんじゃ"],["の"],["席","せき"],["に"],["いる"],["者","もの"],["は"],["、"],["あなた"],["の"],["感謝","かんしゃ"],["に対して","にたいして"],["、"],["どう"],["して"],["アァメン"],["と"],["言えよう","いえよう"],["か"],["。"],["あなた"],["が"],["何に","なに"],["を"],["言って","いって"],["いる"],["の"],["か"],["、"],["彼","かれ"],["に"],["は"],["通じない","つうじない"],["。"]]},{"verse":17,"text":"感謝,かんしゃするのは結構,けっこうだが、それで、ほかの人,ひとの徳,とくを高,たかめることにはならない。","tok":[["感謝","かんしゃ"],["する"],["の"],["は"],["結構","けっこう"],["だ"],["が"],["、"],["それ"],["で"],["、"],["ほか"],["の"],["人","ひと"],["の"],["徳","とく"],["を"],["高める","たかめる"],["こと"],["に"],["は"],["ならない"],["。"]]},{"verse":18,"text":"わたしは、あなたがたのうちのだれよりも多,おおく異言,いげんが語,かたれることを、神,かみに感謝,かんしゃする。","tok":[["わたし"],["は"],["、"],["あなた"],["がた"],["の"],["うち"],["の"],["だれ"],["より"],["も"],["多く","おおく"],["異言","いげん"],["が"],["語れる","かたれる"],["こと"],["を"],["、"],["神","かみ"],["に"],["感謝","かんしゃ"],["する"],["。"]]},{"verse":19,"text":"しかし教会,きょうかいでは、一万の言葉,ことばを異言,いげんで語,かたるよりも、ほかの人,ひとたちをも教,おしえるために、むしろ五つの言葉,ことばを知性,ちせいによって語,かたる方,ほうが願,ねがわしい。","tok":[["しかし"],["教会","きょうかい"],["で"],["は"],["、"],["一万","いちまん"],["の"],["言葉","ことば"],["を"],["異言","いげん"],["で"],["語る","かたる"],["より"],["も"],["、"],["ほか"],["の"],["人","ひと"],["たち"],["を"],["も"],["教える","おしえる"],["ため"],["に"],["、"],["むしろ"],["五","いつ"],["つ"],["の"],["言葉","ことば"],["を"],["知性","ちせい"],["によって"],["語る","かたる"],["方","ほう"],["が"],["願しい","ねがわしい"],["。"]]},{"verse":20,"text":"兄弟,きょうだいたちよ。物,ものの考,かんがえかたでは、子供,こどもとなってはいけない。悪事,あくじについては幼,おさな子,ごとなるのはよいが、考,かんがえかたでは、おとなとなりなさい。","tok":[["兄弟","きょうだい"],["たち"],["よ"],["。"],["物","もの"],["の"],["考","かんがえ"],["かた"],["で"],["は"],["、"],["子供","こども"],["と"],["なって"],["は"],["いけない"],["。"],["悪事","あくじ"],["について"],["は"],["幼な子","おさなご"],["と"],["なる"],["の"],["は"],["よい"],["が"],["、"],["考","かんがえ"],["かた"],["で"],["は"],["、"],["おとな"],["と"],["なり"],["なさい"],["。"]]},{"verse":21,"text":"律法,りっぽうにこう書,かいてある、「わたしは、異国,いこくの舌,したと異国,いこくのくちびるとで、この民,たみに語,かたるが、それでも、彼,かれらはわたしに耳,みみを傾,かたむけない、と主,しゅが仰,おおせになる」。","tok":[["律法","りっぽう"],["に"],["こう"],["書いて","かいて"],["ある"],["、"],["「"],["わたし"],["は"],["、"],["異国","いこく"],["の"],["舌","した"],["と"],["異国","いこく"],["の"],["くちびる"],["と"],["で"],["、"],["この"],["民","たみ"],["に"],["語る","かたる"],["が"],["、"],["それ"],["で"],["も"],["、"],["彼","かれ"],["ら"],["は"],["わたし"],["に"],["耳","みみ"],["を"],["傾むけない","かたむけない"],["、"],["と"],["主","しゅ"],["が"],["仰せ","おおせ"],["に"],["なる"],["」"],["。"]]},{"verse":22,"text":"このように、異言,いげんは信者,しんじゃのためではなく未信者,みしんじゃのためのしるしであるが、預言,よげんは未信者,みしんじゃのためではなく信者,しんじゃのためのしるしである。","tok":[["この"],["よう"],["に"],["、"],["異言","いげん"],["は"],["信者","しんじゃ"],["の"],["ため"],["で"],["は"],["なく"],["未","み"],["信者","しんじゃ"],["の"],["ため"],["の"],["しるし"],["で"],["ある"],["が"],["、"],["預言","よげん"],["は"],["未","み"],["信者","しんじゃ"],["の"],["ため"],["で"],["は"],["なく"],["信者","しんじゃ"],["の"],["ため"],["の"],["しるし"],["で"],["ある"],["。"]]},{"verse":23,"text":"もし全,ぜん教会,きょうかいが一緒,いっしょに集,あつまって、全員,ぜんいんが異言,いげんを語,かたっているところに、初心者,しょしんじゃか不信者,ふしんじゃかがはいってきたら、彼,かれらはあなたがたを気違,きちがいだと言,いうだろう。","tok":[["もし"],["全教","ぜん教"],["会","かい"],["が"],["一緒","いっしょ"],["に"],["集まって","あつまって"],["、"],["全員","ぜんいん"],["が"],["異言","いげん"],["を"],["語って","かたって"],["いる"],["ところ"],["に"],["、"],["初心者","しょ"],["しん"],["じゃ"],["か"],["不","ふ"],["信者","しんじゃ"],["か"],["が"],["はいって"],["きたら"],["、"],["彼","かれ"],["ら"],["は"],["あなた"],["がた"],["を"],["気違","きちがい"],["だ"],["と"],["言うだろう","いうだろう"],["。"]]},{"verse":24,"text":"しかし、全員,ぜんいんが預言,よげんをしているところに、不信者,ふしんじゃか初心者,しょしんじゃがはいってきたら、彼,かれの良心,りょうしんはみんなの者,ものに責,せめられ、みんなの者,ものにさばかれ、","tok":[["しかし"],["、"],["全員","ぜんいん"],["が"],["預言","よげん"],["を"],["して"],["いる"],["ところ"],["に"],["、"],["不","ふ"],["信者","しんじゃ"],["か"],["初心者","しょしんじゃ"],["が"],["はいって"],["きたら"],["、"],["彼","かれ"],["の"],["良心","りょうしん"],["は"],["みんな"],["の"],["者","もの"],["に"],["責","せめ"],["られ"],["、"],["みんな"],["の"],["者","もの"],["に"],["さばかれ"],["、"]]},{"verse":25,"text":"その心,こころの秘密,ひみつがあばかれ、その結果,けっか、ひれ伏,ふして神,かみを拝,おがみ、「まことに、神,かみがあなたがたのうちにいます」と告白,こくはくするに至,いたるであろう。","tok":[["その"],["心","こころ"],["の"],["秘密","ひみつ"],["が"],["あばかれ"],["、"],["その"],["結果","けっか"],["、"],["ひれ伏して","ひれふして"],["神","かみ"],["を"],["拝み","おがみ"],["、"],["「"],["まこと"],["に"],["、"],["神","かみ"],["が"],["あなた"],["がた"],["の"],["うち"],["に"],["います"],["」"],["と"],["告白","こくはく"],["する"],["に"],["至るで","いたるで"],["あろう"],["。"]]},{"verse":26,"text":"すると、兄弟,きょうだいたちよ。どうしたらよいのか。あなたがたが一緒,いっしょに集,あつまる時,とき、各自,かくじはさんびを歌,うたい、教,おしえをなし、啓示,けいじを告,つげ、異言,いげんを語,かたり、それを解,とくのであるが、すべては徳,とくを高,たかめるためにすべきである。","tok":[["する"],["と"],["、"],["兄弟","きょうだい"],["たち"],["よ"],["。"],["どう"],["したら"],["よい"],["の"],["か"],["。"],["あなた"],["がた"],["が"],["一緒","いっしょ"],["に"],["集まる","あつまる"],["時","とき"],["、"],["各自","かくじ"],["は"],["さん"],["び"],["を"],["歌い","うたい"],["、"],["教え","おしえ"],["を"],["なし"],["、"],["啓示","けいじ"],["を"],["告","つげ"],["、"],["異言","いげん"],["を"],["語り","かたり"],["、"],["それ"],["を"],["解く","とく"],["ので"],["ある"],["が"],["、"],["すべて"],["は"],["徳","とく"],["を"],["高める","たかめる"],["ため"],["に"],["すべきで"],["ある"],["。"]]},{"verse":27,"text":"もし異言,いげんを語,かたる者,ものがあれば、ふたりか、多,おおくて三人,にんの者,ものが、順々,じゅんじゅんに語,かたり、そして、ひとりがそれを解,とくべきである。","tok":[["もし"],["異言","いげん"],["を"],["語る","かたる"],["者","もの"],["が"],["あれば"],["、"],["ふたり"],["か"],["、"],["多くて","おおくて"],["三人","にん"],["の"],["者","もの"],["が"],["、"],["順々","じゅんじゅん"],["に"],["語り","かたり"],["、"],["そして"],["、"],["ひとり"],["が"],["それ"],["を"],["解くべきで","とくべきで"],["ある"],["。"]]},{"verse":28,"text":"もし解,とく者,ものがいない時,ときには、教会,きょうかいでは黙,だまっていて、自分,じぶんに対,たいしまた神,かみに対,たいして語,かたっているべきである。","tok":[["もし"],["解く","とく"],["者","もの"],["が"],["いない"],["時","とき"],["に"],["は"],["、"],["教会","きょうかい"],["で"],["は"],["黙って","だまって"],["いて"],["、"],["自分","じぶん"],["に"],["対し","たいし"],["また"],["神","かみ"],["に対して","にたいして"],["語って","かたって"],["いるべきで"],["ある"],["。"]]},{"verse":29,"text":"預言,よげんをする者,ものの場合,ばあいにも、ふたりか三人,にんかが語,かたり、ほかの者,ものはそれを吟味,ぎんみすべきである。","tok":[["預言","よげん"],["を"],["する"],["者","もの"],["の"],["場合","ばあい"],["に"],["も"],["、"],["ふたり"],["か"],["三人","にん"],["か"],["が"],["語り","かたり"],["、"],["ほか"],["の"],["者","もの"],["は"],["それ"],["を"],["吟味","ぎんみ"],["すべきで"],["ある"],["。"]]},{"verse":30,"text":"しかし、席,せきにいる他,たの者,ものが啓示,けいじを受,うけた場合,ばあいには、初,はじめの者,ものは黙,だまるがよい。","tok":[["しかし"],["、"],["席","せき"],["に"],["いる"],["他","た"],["の"],["者","もの"],["が"],["啓示","けいじ"],["を"],["受た","うけた"],["場合","ばあい"],["に"],["は"],["、"],["初め","はじめ"],["の"],["者","もの"],["は"],["黙る","だまる"],["が"],["よい"],["。"]]},{"verse":31,"text":"あなたがたは、みんなが学,まなびみんなが勧,すすめを受,うけるために、ひとりずつ残,のこらず預言,よげんをすることができるのだから。","tok":[["あなた"],["がた"],["は"],["、"],["みんな"],["が"],["学び","まなび"],["みんな"],["が"],["勧め","すすめ"],["を"],["受る","うける"],["ため"],["に"],["、"],["ひとり"],["ずつ"],["残らず","のこらず"],["預言","よげん"],["を"],["する"],["こと"],["が"],["できる"],["の"],["だ"],["から"],["。"]]},{"verse":32,"text":"かつ、預言者,よげんしゃの霊,れいは預言者,よげんしゃに服従,ふくじゅうするものである。","tok":[["かつ"],["、"],["預言者","よげんしゃ"],["の"],["霊","れい"],["は"],["預言者","よげんしゃ"],["に"],["服従","ふくじゅう"],["する"],["もの"],["で"],["ある"],["。"]]},{"verse":33,"text":"神,かみは無,む秩序,ちつじょの神,かみではなく、平和,へいわの神,かみである。聖徒,せいとたちのすべての教会,きょうかいで行,おこなわれているように、","tok":[["神","かみ"],["は"],["無秩序","むちつじょ"],["の"],["神","かみ"],["で"],["は"],["なく"],["、"],["平和","へいわ"],["の"],["神","かみ"],["で"],["ある"],["。"],["聖徒","せいと"],["たち"],["の"],["すべて"],["の"],["教会","きょうかい"],["で"],["行なわれて","おこなわれて"],["いる"],["よう"],["に"],["、"]]},{"verse":34,"text":"婦人,ふじんたちは教会,きょうかいでは黙,だまっていなければならない。彼,かれらは語,かたることが許,ゆるされていない。だから、律法,りっぽうも命,めいじているように、服従,ふくじゅうすべきである。","tok":[["婦人","ふじん"],["たち"],["は"],["教会","きょうかい"],["で"],["は"],["黙って","だまって"],["いなければ"],["ならない"],["。"],["彼","かれ"],["ら"],["は"],["語る","かたる"],["こと"],["が"],["許されて","ゆるされて"],["いない"],["。"],["だ"],["から"],["、"],["律法","りっぽう"],["も"],["命じて","めいじて"],["いる"],["よう"],["に"],["、"],["服従","ふくじゅう"],["すべきで"],["ある"],["。"]]},{"verse":35,"text":"もし何,なにか学,まなびたいことがあれば、家,いえで自分,じぶんの夫,おっとに尋,たずねるがよい。教会,きょうかいで語,かたるのは、婦人,ふじんにとっては恥,はずべきことである。","tok":[["もし"],["何に","なに"],["か"],["学びたい","まなびたい"],["こと"],["が"],["あれば"],["、"],["家","いえ"],["で"],["自分","じぶん"],["の"],["夫","おっと"],["に"],["尋ねる","たずねる"],["が"],["よい"],["。"],["教会","きょうかい"],["で"],["語る","かたる"],["の"],["は"],["、"],["婦人","ふじん"],["にとって"],["は"],["恥ずべき","はずべき"],["こと"],["で"],["ある"],["。"]]},{"verse":36,"text":"それとも、神,かみの言,ことばはあなたがたのところから出,でたのか。あるいは、あなたがただけにきたのか。","tok":[["それ"],["と"],["も"],["、"],["神","かみ"],["の"],["言","ことば"],["は"],["あなた"],["がた"],["の"],["ところ"],["から"],["出た","でた"],["の"],["か"],["。"],["あるいは"],["、"],["あなた"],["がた"],["だけ"],["に"],["きた"],["の"],["か"],["。"]]},{"verse":37,"text":"もしある人,ひとが、自分,じぶんは預言者,よげんしゃか霊,れいの人,ひとであると思,おもっているなら、わたしがあなたがたに書,かいていることは、主,しゅの命令,めいれいだと認,みとめるべきである。","tok":[["もし"],["ある"],["人","ひと"],["が"],["、"],["自分","じぶん"],["は"],["預言者","よげんしゃ"],["か"],["霊","れい"],["の"],["人","ひと"],["で"],["ある"],["と"],["思って","おもって"],["いるなら"],["、"],["わたし"],["が"],["あなた"],["がた"],["に"],["書いて","かいて"],["いる"],["こと"],["は"],["、"],["主","しゅ"],["の"],["命令","めいれい"],["だ"],["と"],["認めるべきで","みとめるべきで"],["ある"],["。"]]},{"verse":38,"text":"もしそれを無視,むしする者,ものがあれば、その人,ひともまた無視,むしされる。","tok":[["もし"],["それ"],["を"],["無視","むし"],["する"],["者","もの"],["が"],["あれば"],["、"],["その"],["人","ひと"],["も"],["また"],["無視","むし"],["される"],["。"]]},{"verse":39,"text":"わたしの兄弟,きょうだいたちよ。このようなわけだから、預言,よげんすることを熱心,ねっしんに求,もとめなさい。また、異言,いげんを語,かたることを妨,さまたげてはならない。","tok":[["わたし"],["の"],["兄弟","きょうだい"],["たち"],["よ"],["。"],["この"],["よう"],["な"],["わけ"],["だ"],["から"],["、"],["預言","よげん"],["する"],["こと"],["を"],["熱心","ねっしん"],["に"],["求め","もとめ"],["なさい"],["。"],["また"],["、"],["異言","いげん"],["を"],["語る","かたる"],["こと"],["を"],["妨げて","さまたげて"],["は"],["ならない"],["。"]]},{"verse":40,"text":"しかし、すべてのことを適宜,てきぎに、かつ秩序,ちつじょを正,ただして行,おこなうがよい。","tok":[["しかし"],["、"],["すべて"],["の"],["こと"],["を"],["適宜","てきぎ"],["に"],["、"],["かつ"],["秩序","ちつじょ"],["を"],["正","ただし"],["て"],["行なう","おこなう"],["が"],["よい"],["。"]]}]
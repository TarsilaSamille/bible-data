[{"verse":1,"text":"神,かみの御旨,みむねにより召,めされてキリスト・イエスの使徒,しととなったパウロと、兄弟,きょうだいソステネから、","tok":[["神","かみ"],["の"],["御旨","みむね"],["に"],["より"],["召されて","めされて"],["キリスト"],["・"],["イエス"],["の"],["使徒","しと"],["と"],["なった"],["パウロ"],["と"],["、"],["兄弟","きょうだい"],["ソステネ"],["から"],["、"]]},{"verse":2,"text":"コリントにある神,かみの教会,きょうかい、すなわち、わたしたちの主,しゅイエス・キリストの御名,みなを至,いたる所,ところで呼,よび求,もとめているすべての人々,ひとびとと共,ともに、キリスト・イエスにあってきよめられ、聖徒,せいととして召,めされたかたがたへ。このキリストは、わたしたちの主,しゅであり、また彼,かれらの主,しゅであられる。","tok":[["コリント"],["に"],["ある"],["神","かみ"],["の"],["教会","きょうかい"],["、"],["すなわち"],["、"],["わたしたち"],["の"],["主","しゅ"],["イエス"],["・"],["キリスト"],["の"],["御名","みな"],["を"],["至る所","いたるところ"],["で"],["呼び求めて","よびもとめて"],["いる"],["すべて"],["の"],["人々","ひとびと"],["と"],["共","とも"],["に"],["、"],["キリスト"],["・"],["イエス"],["に"],["あって"],["きよめられ"],["、"],["聖徒","せいと"],["として"],["召された","めされた"],["かたがた"],["へ"],["。"],["この"],["キリスト"],["は"],["、"],["わたしたち"],["の"],["主","しゅ"],["で"],["あり"],["、"],["また"],["彼","かれ"],["ら"],["の"],["主","しゅ"],["で"],["あられる"],["。"]]},{"verse":3,"text":"わたしたちの父,ちちなる神,かみと主,しゅイエス・キリストから、恵,めぐみと平安,へいあんとが、あなたがたにあるように。","tok":[["わたしたち"],["の"],["父","ちち"],["なる"],["神","かみ"],["と"],["主","しゅ"],["イエス"],["・"],["キリスト"],["から"],["、"],["恵","めぐみ"],["と"],["平安","へいあん"],["と"],["が"],["、"],["あなた"],["がた"],["に"],["ある"],["よう"],["に"],["。"]]},{"verse":4,"text":"わたしは、あなたがたがキリスト・イエスにあって与,あたえられた神,かみの恵,めぐみを思,おもって、いつも神,かみに感謝,かんしゃしている。","tok":[["わたし"],["は"],["、"],["あなた"],["がた"],["が"],["キリスト"],["・"],["イエス"],["に"],["あって"],["与えられた","あたえられた"],["神","かみ"],["の"],["恵","めぐみ"],["を"],["思って","おもって"],["、"],["いつも"],["神","かみ"],["に"],["感謝","かんしゃ"],["して"],["いる"],["。"]]},{"verse":5,"text":"あなたがたはキリストにあって、すべてのことに、すなわち、すべての言葉,ことばにもすべての知識,ちしきにも恵,めぐまれ、","tok":[["あなた"],["がた"],["は"],["キリスト"],["に"],["あって"],["、"],["すべて"],["の"],["こと"],["に"],["、"],["すなわち"],["、"],["すべて"],["の"],["言葉","ことば"],["に"],["も"],["すべて"],["の"],["知識","ちしき"],["に"],["も"],["恵まれ","めぐまれ"],["、"]]},{"verse":6,"text":"キリストのためのあかしが、あなたがたのうちに確,たしかなものとされ、","tok":[["キリスト"],["の"],["ため"],["の"],["あかし"],["が"],["、"],["あなた"],["がた"],["の"],["うち"],["に"],["確か","たしか"],["な"],["もの"],["と"],["され"],["、"]]},{"verse":7,"text":"こうして、あなたがたは恵,めぐみの賜物,たまものにいささかも欠,かけることがなく、わたしたちの主,しゅイエス・キリストの現,あらわれるのを待,まち望,のぞんでいる。","tok":[["こう"],["して"],["、"],["あなた"],["がた"],["は"],["恵","めぐみ"],["の"],["賜物","たまもの"],["に"],["いささか"],["も"],["欠ける","かける"],["こと"],["が"],["なく"],["、"],["わたしたち"],["の"],["主","しゅ"],["イエス"],["・"],["キリスト"],["の"],["現われる","あらわれる"],["の"],["を"],["待ち望んで","まちのぞんで"],["いる"],["。"]]},{"verse":8,"text":"主,しゅもまた、あなたがたを最後,さいごまで堅,かたくささえて、わたしたちの主,しゅイエス・キリストの日,ひに、責,せめられるところのない者,ものにして下,くださるであろう。","tok":[["主","しゅ"],["も"],["また"],["、"],["あなた"],["がた"],["を"],["最後","さいご"],["まで"],["堅く","かたく"],["ささえて"],["、"],["わたしたち"],["の"],["主","しゅ"],["イエス"],["・"],["キリスト"],["の"],["日","ひ"],["に"],["、"],["責","せめ"],["られる"],["ところ"],["の"],["ない"],["者","もの"],["に"],["して"],["下さるで","くださるで"],["あろう"],["。"]]},{"verse":9,"text":"神,かみは真実,しんじつなかたである。あなたがたは神,かみによって召,めされ、御子,みこ、わたしたちの主,しゅイエス・キリストとの交,まじわりに、はいらせていただいたのである。","tok":[["神","かみ"],["は"],["真実","しんじつ"],["な"],["かた"],["で"],["ある"],["。"],["あなた"],["がた"],["は"],["神","かみ"],["によって"],["召され","めされ"],["、"],["御子","みこ"],["、"],["わたしたち"],["の"],["主","しゅ"],["イエス"],["・"],["キリスト"],["と"],["の"],["交じわり","まじわり"],["に"],["、"],["はいらせて"],["いただいた"],["ので"],["ある"],["。"]]},{"verse":10,"text":"さて兄弟,きょうだいたちよ。わたしたちの主,しゅイエス・キリストの名,なによって、あなたがたに勧,すすめる。みな語,かたることを一つにし、お互,たがいの間,あいだに分争,ぶんそうがないようにし、同,おなじ心,こころ、同,おなじ思,おもいになって、堅,かたく結,むすび合,あっていてほしい。","tok":[["さて"],["兄弟","きょうだい"],["たち"],["よ"],["。"],["わたしたち"],["の"],["主","しゅ"],["イエス"],["・"],["キリスト"],["の"],["名","な"],["によって"],["、"],["あなた"],["がた"],["に"],["勧める","すすめる"],["。"],["みな"],["語る","かたる"],["こと"],["を"],["一","ひと"],["つ"],["に"],["し"],["、"],["お互","おたがい"],["の"],["間","あいだ"],["に"],["分争","ぶんそう"],["が"],["ない"],["よう"],["に"],["し"],["、"],["同じ","おなじ"],["心","こころ"],["、"],["同じ","おなじ"],["思い","おもい"],["に"],["なって"],["、"],["堅く","かたく"],["結び合って","むすびあって"],["いて"],["ほしい"],["。"]]},{"verse":11,"text":"わたしの兄弟,きょうだいたちよ。実,じつは、クロエの家,いえの者,ものたちから、あなたがたの間,あいだに争,あらそいがあると聞,きかされている。","tok":[["わたし"],["の"],["兄弟","きょうだい"],["たち"],["よ"],["。"],["実","じつ"],["は"],["、"],["クロエ"],["の"],["家","いえ"],["の"],["者","もの"],["たち"],["から"],["、"],["あなた"],["がた"],["の"],["間","あいだ"],["に"],["争い","あらそい"],["が"],["ある"],["と"],["聞かされて","きかされて"],["いる"],["。"]]},{"verse":12,"text":"はっきり言,いうと、あなたがたがそれぞれ、「わたしはパウロにつく」「わたしはアポロに」「わたしはケパに」「わたしはキリストに」と言,いい合,あっていることである。","tok":[["はっきり"],["言","いう"],["と"],["、"],["あなた"],["がた"],["が"],["それぞれ"],["、"],["「"],["わたし"],["は"],["パウロ"],["に"],["つく"],["」"],["「"],["わたし"],["は"],["アポロ"],["に"],["」"],["「"],["わたし"],["は"],["ケパ"],["に"],["」"],["「"],["わたし"],["は"],["キリスト"],["に"],["」"],["と"],["言い合って","いいあって"],["いる"],["こと"],["で"],["ある"],["。"]]},{"verse":13,"text":"キリストは、いくつにも分,わけられたのか。パウロは、あなたがたのために十字架,じゅうじかにつけられたことがあるのか。それとも、あなたがたは、パウロの名,なによってバプテスマを受,うけたのか。","tok":[["キリスト"],["は"],["、"],["いくつ"],["に"],["も"],["分けられた","わけられた"],["の"],["か"],["。"],["パウロ"],["は"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["十字架","じゅうじか"],["に"],["つけられた"],["こと"],["が"],["ある"],["の"],["か"],["。"],["それ"],["と"],["も"],["、"],["あなた"],["がた"],["は"],["、"],["パウロ"],["の"],["名","な"],["によって"],["バプテスマ"],["を"],["受た","うけた"],["の"],["か"],["。"]]},{"verse":14,"text":"わたしは感謝,かんしゃしているが、クリスポとガイオ以外,いがいには、あなたがたのうちのだれにも、バプテスマを授,さづけたことがない。","tok":[["わたし"],["は"],["感謝","かんしゃ"],["して"],["いる"],["が"],["、"],["クリスポ"],["と"],["ガイオ"],["以外","いがい"],["に"],["は"],["、"],["あなた"],["がた"],["の"],["うち"],["の"],["だれ"],["に"],["も"],["、"],["バプテスマ"],["を"],["授","さづけたこ"],["と"],["が"],["ない"],["。"]]},{"verse":15,"text":"それはあなたがたがわたしの名,なによってバプテスマを受,うけたのだと、だれにも言,いわれることのないためである。","tok":[["それ"],["は"],["あなた"],["がた"],["が"],["わたし"],["の"],["名","な"],["によって"],["バプテスマ"],["を"],["受た","うけた"],["の"],["だ"],["と"],["、"],["だれ"],["に"],["も"],["言われる","いわれる"],["こと"],["の"],["ない"],["ため"],["で"],["ある"],["。"]]},{"verse":16,"text":"もっとも、ステパナの家,いえの者,ものたちには、バプテスマを授,さづけたことがある。しかし、そのほかには、だれにも授,さづけた覚,おぼえがない。","tok":[["もっとも"],["、"],["ステパナ"],["の"],["家","いえ"],["の"],["者","もの"],["たち"],["に"],["は"],["、"],["バプテスマ"],["を"],["授","さづけたこ"],["と"],["が"],["ある"],["。"],["しかし"],["、"],["その"],["ほか"],["に"],["は"],["、"],["だれ"],["に"],["も"],["授","さ"],["づけた"],["覚え","おぼえ"],["が"],["ない"],["。"]]},{"verse":17,"text":"いったい、キリストがわたしをつかわされたのは、バプテスマを授,さづけるためではなく、福音,ふくいんを宣,のべ伝,つたえるためであり、しかも知恵,ちえの言葉,ことばを用,もちいずに宣,のべ伝,つたえるためであった。それは、キリストの十字架,じゅうじかが無力,むりょくなものになってしまわないためなのである。","tok":[["いったい"],["、"],["キリスト"],["が"],["わたし"],["を"],["つかわされた"],["の"],["は"],["、"],["バプテスマ"],["を"],["授","さ"],["づける"],["ため"],["で"],["は"],["なく"],["、"],["福音","ふくいん"],["を"],["宣べ伝える","のべつたえる"],["ため"],["で"],["あり"],["、"],["しかも"],["知恵","ちえ"],["の"],["言葉","ことば"],["を"],["用いず","もちいず"],["に"],["宣べ伝える","のべつたえる"],["ため"],["で"],["あった"],["。"],["それ"],["は"],["、"],["キリスト"],["の"],["十字架","じゅうじか"],["が"],["無力","むりょく"],["な"],["もの"],["に"],["なって"],["しまわない"],["ため"],["な"],["ので"],["ある"],["。"]]},{"verse":18,"text":"十字架,じゅうじかの言,ことばは、滅,ほろび行,いく者,ものには愚,おろかであるが、救,すくいにあずかるわたしたちには、神,かみの力,ちからである。","tok":[["十字架","じゅうじか"],["の"],["言","ことば"],["は"],["、"],["滅び","ほろび"],["行く","いく"],["者","もの"],["に"],["は"],["愚か","おろか"],["で"],["ある"],["が"],["、"],["救い","すくい"],["に"],["あずかる"],["わたしたち"],["に"],["は"],["、"],["神","かみ"],["の"],["力","ちから"],["で"],["ある"],["。"]]},{"verse":19,"text":"すなわち、聖書,せいしょに、「わたしは知者,ちしゃの知恵,ちえを滅,ほろぼし、賢,かしこい者,ものの賢,かしこさをむなしいものにする」と書,かいてある。","tok":[["すなわち"],["、"],["聖書","せいしょ"],["に"],["、"],["「"],["わたし"],["は"],["知者","ちしゃ"],["の"],["知恵","ちえ"],["を"],["滅ぼし","ほろぼし"],["、"],["賢しこい","かしこい"],["者","もの"],["の"],["賢こ","かしこ"],["さ"],["を"],["むなしい"],["もの"],["に"],["する"],["」"],["と"],["書いて","かいて"],["ある"],["。"]]},{"verse":20,"text":"知者,ちしゃはどこにいるか。学者,がくしゃはどこにいるか。この世,よの論者,ろんしゃはどこにいるか。神,かみはこの世,よの知恵,ちえを、愚,おろかにされたではないか。","tok":[["知者","ちしゃ"],["は"],["どこ"],["に"],["いる"],["か"],["。"],["学者","がくしゃ"],["は"],["どこ"],["に"],["いる"],["か"],["。"],["この世","このよ"],["の"],["論者","ろんしゃ"],["は"],["どこ"],["に"],["いる"],["か"],["。"],["神","かみ"],["は"],["この世","このよ"],["の"],["知恵","ちえ"],["を"],["、"],["愚か","おろか"],["に"],["されたで"],["は"],["ない"],["か"],["。"]]},{"verse":21,"text":"この世,よは、自分,じぶんの知恵,ちえによって神,かみを認,みとめるに至,いたらなかった。それは、神,かみの知恵,ちえにかなっている。そこで神,かみは、宣教,せんきょうの愚,おろかさによって、信,しんじる者,ものを救,すくうこととされたのである。","tok":[["この世","このよ"],["は"],["、"],["自分","じぶん"],["の"],["知恵","ちえ"],["によって"],["神","かみ"],["を"],["認める","みとめる"],["に"],["至らなかった","いたらなかった"],["。"],["それ"],["は"],["、"],["神","かみ"],["の"],["知恵","ちえ"],["に"],["かなって"],["いる"],["。"],["そこ"],["で"],["神","かみ"],["は"],["、"],["宣教","せんきょう"],["の"],["愚か","おろか"],["さ"],["によって"],["、"],["信じる","しんじる"],["者","もの"],["を"],["救う","すくう"],["こと"],["と"],["された"],["ので"],["ある"],["。"]]},{"verse":22,"text":"ユダヤ人,じんはしるしを請,こい、ギリシヤ人,じんは知恵,ちえを求,もとめる。","tok":[["ユダヤ人","ゆだやじん"],["は"],["しるし"],["を"],["請い","こい"],["、"],["ギリシヤ"],["人","じん"],["は"],["知恵","ちえ"],["を"],["求める","もとめる"],["。"]]},{"verse":23,"text":"しかしわたしたちは、十字架,じゅうじかにつけられたキリストを宣,のべ伝,つたえる。このキリストは、ユダヤ人,じんにはつまずかせるもの、異邦人,いほうじんには愚,おろかなものであるが、","tok":[["しかし"],["わたしたち"],["は"],["、"],["十字架","じゅうじか"],["に"],["つけられた"],["キリスト"],["を"],["宣べ伝える","のべつたえる"],["。"],["この"],["キリスト"],["は"],["、"],["ユダヤ人","ゆだやじん"],["に"],["は"],["つまずかせる"],["もの"],["、"],["異邦人","いほうじん"],["に"],["は"],["愚か","おろか"],["な"],["もの"],["で"],["ある"],["が"],["、"]]},{"verse":24,"text":"召,めされた者,もの自身,じしんにとっては、ユダヤ人,じんにもギリシヤ人,じんにも、神,かみの力,ちから、神,かみの知恵,ちえたるキリストなのである。","tok":[["召された","めされた"],["者","もの"],["自身","じしん"],["にとって"],["は"],["、"],["ユダヤ人","ゆだやじん"],["に"],["も"],["ギリシヤ"],["人","じん"],["に"],["も"],["、"],["神","かみ"],["の"],["力","ちから"],["、"],["神","かみ"],["の"],["知恵","ちえ"],["たる"],["キリスト"],["な"],["ので"],["ある"],["。"]]},{"verse":25,"text":"神,かみの愚,おろかさは人,ひとよりも賢,かしこく、神,かみの弱,よわさは人,ひとよりも強,つよいからである。","tok":[["神","かみ"],["の"],["愚か","おろか"],["さ"],["は"],["人","ひと"],["より"],["も"],["賢しこく","かしこく"],["、"],["神","かみ"],["の"],["弱","よわ"],["さ"],["は"],["人","ひと"],["より"],["も"],["強い","つよい"],["から"],["で"],["ある"],["。"]]},{"verse":26,"text":"兄弟,きょうだいたちよ。あなたがたが召,めされた時,ときのことを考,かんがえてみるがよい。人間,にんげん的,てきには、知恵,ちえのある者,ものが多,おおくはなく、権力,けんりょくのある者,ものも多,おおくはなく、身分,みぶんの高,たかい者,ものも多,おおくはいない。","tok":[["兄弟","きょうだい"],["たち"],["よ"],["。"],["あなた"],["がた"],["が"],["召された","めされた"],["時","とき"],["の"],["こと"],["を"],["考","かんがえ"],["て"],["みる"],["が"],["よい"],["。"],["人間的","にんげんてき"],["に"],["は"],["、"],["知恵","ちえ"],["の"],["ある"],["者","もの"],["が"],["多く","おおく"],["は"],["なく"],["、"],["権力","けんりょく"],["の"],["ある"],["者","もの"],["も"],["多く","おおく"],["は"],["なく"],["、"],["身分","みぶん"],["の"],["高い","たかい"],["者","もの"],["も"],["多く","おおく"],["は"],["いない"],["。"]]},{"verse":27,"text":"それだのに神,かみは、知者,ちしゃをはずかしめるために、この世,よの愚,おろかな者,ものを選,えらび、強,つよい者,ものをはずかしめるために、この世,よの弱,よわい者,ものを選,えらび、","tok":[["それ"],["だ"],["のに"],["神","かみ"],["は"],["、"],["知者","ちしゃ"],["を"],["はずかしめる"],["ため"],["に"],["、"],["この世","このよ"],["の"],["愚か","おろか"],["な"],["者","もの"],["を"],["選ら","えら"],["び"],["、"],["強い","つよい"],["者","もの"],["を"],["はずかしめる"],["ため"],["に"],["、"],["この世","このよ"],["の"],["弱い","よわい"],["者","もの"],["を"],["選ら","えら"],["び"],["、"]]},{"verse":28,"text":"有力,ゆうりょくな者,ものを無力,むりょくな者,ものにするために、この世,よで身分,みぶんの低,ひくい者,ものや軽,かろんじられている者,もの、すなわち、無,なきに等,ひとしい者,ものを、あえて選,えらばれたのである。","tok":[["有力","ゆうりょく"],["な"],["者","もの"],["を"],["無力","むりょく"],["な"],["者","もの"],["に"],["する"],["ため"],["に"],["、"],["この世","このよ"],["で"],["身分","みぶん"],["の"],["低い","ひくい"],["者","もの"],["や"],["軽んじられて","かろんじられて"],["いる"],["者","もの"],["、"],["すなわち"],["、"],["無き","なき"],["に"],["等い","ひとしい"],["者","もの"],["を"],["、"],["あえて"],["選ら","えら"],["ばれた"],["ので"],["ある"],["。"]]},{"verse":29,"text":"それは、どんな人間,にんげんでも、神,かみのみまえに誇,ほこることがないためである。","tok":[["それ"],["は"],["、"],["どんな"],["人間","にんげん"],["で"],["も"],["、"],["神","かみ"],["のみ"],["まえ"],["に"],["誇る","ほこる"],["こと"],["が"],["ない"],["ため"],["で"],["ある"],["。"]]},{"verse":30,"text":"あなたがたがキリスト・イエスにあるのは、神,かみによるのである。キリストは神,かみに立,たてられて、わたしたちの知恵,ちえとなり、義,ぎと聖,せいとあがないとになられたのである。","tok":[["あなた"],["がた"],["が"],["キリスト"],["・"],["イエス"],["に"],["ある"],["の"],["は"],["、"],["神","かみ"],["に"],["よる"],["ので"],["ある"],["。"],["キリスト"],["は"],["神","かみ"],["に"],["立られて","たてられて"],["、"],["わたしたち"],["の"],["知恵","ちえ"],["と"],["なり"],["、"],["義","ぎ"],["と"],["聖","せい"],["と"],["あ"],["が"],["ない"],["と"],["に"],["なられた"],["ので"],["ある"],["。"]]},{"verse":31,"text":"それは、「誇,ほこる者,ものは主,しゅを誇,ほこれ」と書,かいてあるとおりである。","tok":[["それ"],["は"],["、"],["「"],["誇る","ほこる"],["者","もの"],["は"],["主","しゅ"],["を"],["誇れ","ほこれ"],["」"],["と"],["書いて","かいて"],["ある"],["とおり"],["で"],["ある"],["。"]]}]
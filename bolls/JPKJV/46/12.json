[{"verse":1,"text":"兄弟,きょうだいたちよ。霊,れいの賜物,たまものについては、次,つぎのことを知,しらずにいてもらいたくない。","tok":[["兄弟","きょうだい"],["たち"],["よ"],["。"],["霊","れい"],["の"],["賜物","たまもの"],["について"],["は"],["、"],["次","つぎ"],["の"],["こと"],["を"],["知らず","しらず"],["に"],["いて"],["もらいたく"],["ない"],["。"]]},{"verse":2,"text":"あなたがたがまだ異邦人,いほうじんであった時,とき、誘,さそわれるまま、物,ものの言,いえない偶像,ぐうぞうのところに引,ひかれて行,いったことは、あなたがたの承知,しょうちしているとおりである。","tok":[["あなた"],["がた"],["が"],["まだ"],["異邦人","いほうじん"],["で"],["あった"],["時","とき"],["、"],["誘われる","さそわれる"],["まま"],["、"],["物","もの"],["の"],["言えない","いえない"],["偶像","ぐうぞう"],["の"],["ところ"],["に"],["引かれて","ひかれて"],["行った","いった"],["こと"],["は"],["、"],["あなた"],["がた"],["の"],["承知","しょうち"],["して"],["いる"],["とおり"],["で"],["ある"],["。"]]},{"verse":3,"text":"そこで、あなたがたに言,いっておくが、神,かみの霊,れいによって語,かたる者,ものはだれも「イエスはのろわれよ」とは言,いわないし、また、聖霊,せいれいによらなければ、だれも「イエスは主,しゅである」と言,いうことができない。","tok":[["そこ"],["で"],["、"],["あなた"],["がた"],["に"],["言って","いって"],["おく"],["が"],["、"],["神","かみ"],["の"],["霊","れい"],["によって"],["語る","かたる"],["者","もの"],["は"],["だれ"],["も"],["「"],["イエス"],["は"],["のろわれよ"],["」"],["と"],["は"],["言わない","いわない"],["し"],["、"],["また"],["、"],["聖霊","せいれい"],["に"],["よらなければ"],["、"],["だれ"],["も"],["「"],["イエス"],["は"],["主","しゅ"],["で"],["ある"],["」"],["と"],["言う","いう"],["こと"],["が"],["できない"],["。"]]},{"verse":4,"text":"霊,れいの賜物,たまものは種々,しゅじゅあるが、御霊,みたまは同,おなじである。","tok":[["霊","れい"],["の"],["賜物","たまもの"],["は"],["種々","しゅじゅ"],["ある"],["が"],["、"],["御霊","みたま"],["は"],["同じ","おなじ"],["で"],["ある"],["。"]]},{"verse":5,"text":"務,つとめは種々,しゅじゅあるが、主,しゅは同,おなじである。","tok":[["務め","つとめ"],["は"],["種々","しゅじゅ"],["ある"],["が"],["、"],["主","しゅ"],["は"],["同じ","おなじ"],["で"],["ある"],["。"]]},{"verse":6,"text":"働,はたらきは種々,しゅじゅあるが、すべてのものの中,なかに働,はたらいてすべてのことをなさる神,かみは、同,おなじである。","tok":[["働らき","はたらき"],["は"],["種々","しゅじゅ"],["ある"],["が"],["、"],["すべて"],["の"],["もの"],["の"],["中","なか"],["に"],["働いて","はたらいて"],["すべて"],["の"],["こと"],["を"],["なさる"],["神","かみ"],["は"],["、"],["同じ","おなじ"],["で"],["ある"],["。"]]},{"verse":7,"text":"各自,かくじが御霊,みたまの現,あらわれを賜,たまわっているのは、全体,ぜんたいの益,えきになるためである。","tok":[["各自","かくじ"],["が"],["御霊","みたま"],["の"],["現われ","あらわれ"],["を"],["賜わって","たまわって"],["いる"],["の"],["は"],["、"],["全体","ぜんたい"],["の"],["益","えき"],["に"],["なる"],["ため"],["で"],["ある"],["。"]]},{"verse":8,"text":"すなわち、ある人,ひとには御霊,みたまによって知恵,ちえの言葉,ことばが与,あたえられ、ほかの人,ひとには、同,おなじ御霊,みたまによって知識,ちしきの言,ことば、","tok":[["すなわち"],["、"],["ある"],["人","ひと"],["に"],["は"],["御霊","みたま"],["によって"],["知恵","ちえ"],["の"],["言葉","ことば"],["が"],["与えられ","あたえられ"],["、"],["ほか"],["の"],["人","ひと"],["に"],["は"],["、"],["同じ","おなじ"],["御霊","みたま"],["によって"],["知識","ちしき"],["の"],["言","こ"],["と"],["ば"],["、"]]},{"verse":9,"text":"またほかの人,ひとには、同,おなじ御霊,みたまによって信仰,しんこう、またほかの人,ひとには、一つの御霊,みたまによっていやしの賜物,たまもの、","tok":[["また"],["ほか"],["の"],["人","ひと"],["に"],["は"],["、"],["同じ","おなじ"],["御霊","みたま"],["によって"],["信仰","しんこう"],["、"],["また"],["ほか"],["の"],["人","ひと"],["に"],["は"],["、"],["一","ひと"],["つ"],["の"],["御霊","みたま"],["によって"],["いやし"],["の"],["賜物","たまもの"],["、"]]},{"verse":10,"text":"またほかの人,ひとには力,ちからあるわざ、またほかの人,ひとには預言,よげん、またほかの人,ひとには霊,れいを見,みわける力,ちから、またほかの人,ひとには種々,しゅじゅの異言,いげん、またほかの人,ひとには異言,いげんを解,とく力,ちからが、与,あたえられている。","tok":[["また"],["ほか"],["の"],["人","ひと"],["に"],["は"],["力","ちから"],["ある"],["わざ"],["、"],["また"],["ほか"],["の"],["人","ひと"],["に"],["は"],["預言","よげん"],["、"],["また"],["ほか"],["の"],["人","ひと"],["に"],["は"],["霊","れい"],["を"],["見わける","みわける"],["力","ちから"],["、"],["また"],["ほか"],["の"],["人","ひと"],["に"],["は"],["種々","しゅじゅ"],["の"],["異言","いげん"],["、"],["また"],["ほか"],["の"],["人","ひと"],["に"],["は"],["異言","いげん"],["を"],["解く","とく"],["力","ちから"],["が"],["、"],["与えられて","あたえられて"],["いる"],["。"]]},{"verse":11,"text":"すべてこれらのものは、一つの同,おなじ御霊,みたまの働,はたらきであって、御霊,みたまは思,おもいのままに、それらを各自,かくじに分,わけ与,あたえられるのである。","tok":[["すべて"],["これ"],["ら"],["の"],["もの"],["は"],["、"],["一","ひと"],["つ"],["の"],["同じ","おなじ"],["御霊","みたま"],["の"],["働らき","はたらき"],["で"],["あって"],["、"],["御霊","みたま"],["は"],["思い","おもい"],["の"],["まま"],["に"],["、"],["それ"],["ら"],["を"],["各自","かくじ"],["に"],["分け与えられる","わけあたえられる"],["ので"],["ある"],["。"]]},{"verse":12,"text":"からだが一つであっても肢体,したいは多,おおくあり、また、からだのすべての肢体,したいが多,おおくあっても、からだは一つであるように、キリストの場合,ばあいも同様,どうようである。","tok":[["からだ"],["が"],["一","ひと"],["つ"],["で"],["あって"],["も"],["肢体","したい"],["は"],["多く","おおく"],["あり"],["、"],["また"],["、"],["からだ"],["の"],["すべて"],["の"],["肢体","したい"],["が"],["多く","おおく"],["あって"],["も"],["、"],["からだ"],["は"],["一","ひと"],["つ"],["で"],["ある"],["よう"],["に"],["、"],["キリスト"],["の"],["場合","ばあい"],["も"],["同様","どうよう"],["で"],["ある"],["。"]]},{"verse":13,"text":"なぜなら、わたしたちは皆,みな、ユダヤ人,じんもギリシヤ人,じんも、奴隷,どれいも自由人,じゆうじんも、一つの御霊,みたまによって、一つのからだとなるようにバプテスマを受,うけ、そして皆,みな一つの御霊,みたまを飲,のんだからである。","tok":[["なぜ"],["なら"],["、"],["わたしたち"],["は"],["皆","みな"],["、"],["ユダヤ人","ゆだやじん"],["も"],["ギリシヤ"],["人","じん"],["も"],["、"],["奴隷","どれい"],["も"],["自由人","じゆうじん"],["も"],["、"],["一","ひと"],["つ"],["の"],["御霊","みたま"],["によって"],["、"],["一","ひと"],["つ"],["の"],["からだ"],["と"],["なる"],["よう"],["に"],["バプテスマ"],["を"],["受け","うけ"],["、"],["そして"],["皆","みな"],["一","ひと"],["つ"],["の"],["御霊","みたま"],["を"],["飲らで","のんだからで"],["ある"],["。"]]},{"verse":14,"text":"実際,じっさい、からだは一つの肢体,したいだけではなく、多,おおくのものからできている。","tok":[["実際","じっさい"],["、"],["からだ"],["は"],["一","ひと"],["つ"],["の"],["肢体","したい"],["だけ"],["で"],["は"],["なく"],["、"],["多く","おおく"],["の"],["もの"],["から"],["できて"],["いる"],["。"]]},{"verse":15,"text":"もし足,あしが、わたしは手,てではないから、からだに属,ぞくしていないと言,いっても、それで、からだに属,ぞくさないわけではない。","tok":[["もし"],["足","あし"],["が"],["、"],["わたし"],["は"],["手","て"],["で"],["は"],["ない"],["から"],["、"],["からだ"],["に"],["属して","ぞくして"],["いない"],["と"],["言って","いって"],["も"],["、"],["それ"],["で"],["、"],["からだ"],["に"],["属さない","ぞくさない"],["わけ"],["で"],["は"],["ない"],["。"]]},{"verse":16,"text":"また、もし耳,みみが、わたしは目,めではないから、からだに属,ぞくしていないと言,いっても、それで、からだに属,ぞくさないわけではない。","tok":[["また"],["、"],["もし"],["耳","みみ"],["が"],["、"],["わたし"],["は"],["目","め"],["で"],["は"],["ない"],["から"],["、"],["からだ"],["に"],["属して","ぞくして"],["いない"],["と"],["言って","いって"],["も"],["、"],["それ"],["で"],["、"],["からだ"],["に"],["属さない","ぞくさない"],["わけ"],["で"],["は"],["ない"],["。"]]},{"verse":17,"text":"もしからだ全体,ぜんたいが目,めだとすれば、どこで聞,きくのか。もし、からだ全体,ぜんたいが耳,みみだとすれば、どこでかぐのか。","tok":[["もし"],["からだ"],["全体","ぜんたい"],["が"],["目","め"],["だ"],["と"],["すれば"],["、"],["どこ"],["で"],["聞く","きく"],["の"],["か"],["。"],["もし"],["、"],["からだ"],["全体","ぜんたい"],["が"],["耳","みみ"],["だ"],["と"],["すれば"],["、"],["どこ"],["で"],["かぐ"],["の"],["か"],["。"]]},{"verse":18,"text":"そこで神,かみは御旨,みむねのままに、肢体,したいをそれぞれ、からだに備,そなえられたのである。","tok":[["そこ"],["で"],["神","かみ"],["は"],["御旨","みむね"],["の"],["まま"],["に"],["、"],["肢体","したい"],["を"],["それぞれ"],["、"],["からだ"],["に"],["備","そなえ"],["られた"],["ので"],["ある"],["。"]]},{"verse":19,"text":"もし、すべてのものが一つの肢体,したいなら、どこにからだがあるのか。","tok":[["もし"],["、"],["すべて"],["の"],["もの"],["が"],["一","ひと"],["つ"],["の"],["肢体","したい"],["なら"],["、"],["どこ"],["に"],["からだ"],["が"],["ある"],["の"],["か"],["。"]]},{"verse":20,"text":"ところが実際,じっさい、肢体,したいは多,おおくあるが、からだは一つなのである。","tok":[["ところ"],["が"],["実際","じっさい"],["、"],["肢体","したい"],["は"],["多く","おおく"],["ある"],["が"],["、"],["からだ"],["は"],["一","ひと"],["つ"],["な"],["ので"],["ある"],["。"]]},{"verse":21,"text":"目,めは手,てにむかって、「おまえはいらない」とは言,いえず、また頭,あたまは足,あしにむかって、「おまえはいらない」とも言,いえない。","tok":[["目","め"],["は"],["手","て"],["に"],["むかって"],["、"],["「"],["おまえ"],["は"],["いらない"],["」"],["と"],["は"],["言えず","いえず"],["、"],["また"],["頭","あたま"],["は"],["足","あし"],["に"],["むかって"],["、"],["「"],["おまえ"],["は"],["いらない"],["」"],["と"],["も"],["言えない","いえない"],["。"]]},{"verse":22,"text":"そうではなく、むしろ、からだのうちで他,ほかよりも弱,よわく見,みえる肢体,したいが、かえって必要,ひつようなのであり、","tok":[["そう"],["で"],["は"],["なく"],["、"],["むしろ"],["、"],["からだ"],["の"],["うち"],["で"],["他","ほか"],["より"],["も"],["弱く","よわく"],["見える","みえる"],["肢体","したい"],["が"],["、"],["かえって"],["必要","ひつよう"],["な"],["ので"],["あり"],["、"]]},{"verse":23,"text":"からだのうちで、他,ほかよりも見,み劣,おとりがすると思,おもえるところに、ものを着,きせていっそう見,みよくする。麗,うるわしくない部分,ぶぶんはいっそう麗,うるわしくするが、","tok":[["からだ"],["の"],["うち"],["で"],["、"],["他","ほか"],["より"],["も"],["見劣り","みおとり"],["が"],["する"],["と"],["思る","おもえる"],["ところ"],["に"],["、"],["もの"],["を"],["着せて","きせて"],["いっそう"],["見","み"],["よく"],["する"],["。"],["麗わしく","うるわしく"],["ない"],["部分","ぶぶん"],["は"],["いっそう"],["麗わしく","うるわしく"],["する"],["が"],["、"]]},{"verse":24,"text":"麗,うるわしい部分,ぶぶんはそうする必要,ひつようがない。神,かみは劣,おとっている部分,ぶぶんをいっそう見,みよくして、からだに調和,ちょうわをお与,あたえになったのである。","tok":[["麗わしい","うるわしい"],["部分","ぶぶん"],["は"],["そう"],["する"],["必要","ひつよう"],["が"],["ない"],["。"],["神","かみ"],["は"],["劣って","おとって"],["いる"],["部分","ぶぶん"],["を"],["いっそう"],["見","み"],["よく"],["して"],["、"],["からだ"],["に"],["調和","ちょうわ"],["を"],["お"],["与","あたえ"],["に"],["なった"],["ので"],["ある"],["。"]]},{"verse":25,"text":"それは、からだの中,なかに分裂,ぶんれつがなく、それぞれの肢体,したいが互,たがいにいたわり合,あうためなのである。","tok":[["それ"],["は"],["、"],["からだ"],["の"],["中","なか"],["に"],["分裂","ぶんれつ"],["が"],["なく"],["、"],["それぞれ"],["の"],["肢体","したい"],["が"],["互","たがい"],["に"],["いたわり合う","いたわりあう"],["ため"],["な"],["ので"],["ある"],["。"]]},{"verse":26,"text":"もし一つの肢体,したいが悩,なやめば、ほかの肢体,したいもみな共,ともに悩,なやみ、一つの肢体,したいが尊,たっとばれると、ほかの肢体,したいもみな共,ともに喜,よろこぶ。","tok":[["もし"],["一","ひと"],["つ"],["の"],["肢体","したい"],["が"],["悩めば","なやめば"],["、"],["ほか"],["の"],["肢体","したい"],["も"],["みな"],["共","とも"],["に"],["悩み","なやみ"],["、"],["一","ひと"],["つ"],["の"],["肢体","したい"],["が"],["尊","たっ"],["と"],["ばれる"],["と"],["、"],["ほか"],["の"],["肢体","したい"],["も"],["みな"],["共","とも"],["に"],["喜こぶ","よろこぶ"],["。"]]},{"verse":27,"text":"あなたがたはキリストのからだであり、ひとりびとりはその肢体,したいである。","tok":[["あなた"],["がた"],["は"],["キリスト"],["の"],["からだ"],["で"],["あり"],["、"],["ひとりびとり"],["は"],["その"],["肢体","したい"],["で"],["ある"],["。"]]},{"verse":28,"text":"そして、神,かみは教会,きょうかいの中,なかで、人々,ひとびとを立,たてて、第,だい一に使徒,しと、第,だい二に預言者,よげんしゃ、第,だい三に教師,きょうしとし、次,つぎに力,ちからあるわざを行,おこなう者,もの、次,つぎにいやしの賜物,たまものを持,もつ者,もの、また補助者,ほじょしゃ、管理者,かんりしゃ、種々,しゅじゅの異言,いげんを語,かたる者,ものをおかれた。","tok":[["そして"],["、"],["神","かみ"],["は"],["教会","きょうかい"],["の"],["中","なか"],["で"],["、"],["人々","ひとびと"],["を"],["立てて","たてて"],["、"],["第","だい"],["一","いち"],["に"],["使徒","しと"],["、"],["第","だい"],["二","に"],["に"],["預言者","よげんしゃ"],["、"],["第","だい"],["三","さん"],["に"],["教師","きょうし"],["と"],["し"],["、"],["次","つぎ"],["に"],["力","ちから"],["ある"],["わざ"],["を"],["行なう","おこなう"],["者","もの"],["、"],["次","つぎ"],["に"],["いやし"],["の"],["賜物","たまもの"],["を"],["持つ","もつ"],["者","もの"],["、"],["また"],["補助者","ほじょしゃ"],["、"],["管理者","かんりしゃ"],["、"],["種々","しゅじゅ"],["の"],["異言","いげん"],["を"],["語る","かたる"],["者","もの"],["を"],["おかれた"],["。"]]},{"verse":29,"text":"みんなが使徒,しとだろうか。みんなが預言者,よげんしゃだろうか。みんなが教師,きょうしだろうか。みんなが力,ちからあるわざを行,おこなう者,ものだろうか。","tok":[["みんな"],["が"],["使徒","しと"],["だろう"],["か"],["。"],["みんな"],["が"],["預言者","よげんしゃ"],["だろう"],["か"],["。"],["みんな"],["が"],["教師","きょうし"],["だろう"],["か"],["。"],["みんな"],["が"],["力","ちから"],["ある"],["わざ"],["を"],["行なう","おこなう"],["者","もの"],["だろう"],["か"],["。"]]},{"verse":30,"text":"みんながいやしの賜物,たまものを持,もっているのだろうか。みんなが異言,いげんを語,かたるのだろうか。みんなが異言,いげんを解,とくのだろうか。","tok":[["みんな"],["が"],["いやし"],["の"],["賜物","たまもの"],["を"],["持って","もって"],["いる"],["の"],["だろう"],["か"],["。"],["みんな"],["が"],["異言","いげん"],["を"],["語る","かたる"],["の"],["だろう"],["か"],["。"],["みんな"],["が"],["異言","いげん"],["を"],["解く","とく"],["の"],["だろう"],["か"],["。"]]},{"verse":31,"text":"だが、あなたがたは、更,さらに大,おおいなる賜物,たまものを得,えようと熱心,ねっしんに努,つとめなさい。そこで、わたしは最,もっともすぐれた道,みちをあなたがたに示,しめそう。","tok":[["だ"],["が"],["、"],["あなた"],["がた"],["は"],["、"],["更に","さらに"],["大いなる","おおいなる"],["賜物","たまもの"],["を"],["得よう","えよう"],["と"],["熱心","ねっしん"],["に"],["努め","つとめ"],["なさい"],["。"],["そこ"],["で"],["、"],["わたし"],["は"],["最も","もっとも"],["すぐれた"],["道","みち"],["を"],["あなた"],["がた"],["に"],["示めそう","しめそう"],["。"]]}]
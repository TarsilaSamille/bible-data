[{"verse":1,"text":"兄弟,きょうだいたちよ。わたしはあなたがたには、霊,れいの人,ひとに対,たいするように話,はなすことができず、むしろ、肉,にくに属,ぞくする者,もの、すなわち、キリストにある幼,おさな子,ごに話,はなすように話,はなした。","tok":[["兄弟","きょうだい"],["たち"],["よ"],["。"],["わたし"],["は"],["あなた"],["がた"],["に"],["は"],["、"],["霊","れい"],["の"],["人","ひと"],["に"],["対する","たいする"],["よう"],["に"],["話す","はなす"],["こと"],["が"],["できず"],["、"],["むしろ"],["、"],["肉","にく"],["に"],["属する","ぞくする"],["者","もの"],["、"],["すなわち"],["、"],["キリスト"],["に"],["ある"],["幼な子","おさなご"],["に"],["話す","はなす"],["よう"],["に"],["話","はなし"],["た"],["。"]]},{"verse":2,"text":"あなたがたに乳,ちちを飲,のませて、堅,かたい食物,しょくもつは与,あたえなかった。食,たべる力,ちからが、まだあなたがたになかったからである。今,いまになってもその力,ちからがない。","tok":[["あなた"],["がた"],["に"],["乳","ちち"],["を"],["飲ませて","のませて"],["、"],["堅い","かたい"],["食物","しょくもつ"],["は"],["与えなかった","あたえなかった"],["。"],["食べる","たべる"],["力","ちから"],["が"],["、"],["まだ"],["あなた"],["がた"],["に"],["なかった"],["から"],["で"],["ある"],["。"],["今","いま"],["に"],["なって"],["も"],["その"],["力","ちから"],["が"],["ない"],["。"]]},{"verse":3,"text":"あなたがたはまだ、肉,にくの人,ひとだからである。あなたがたの間,あいだに、ねたみや争,あらそいがあるのは、あなたがたが肉,にくの人,ひとであって、普通,ふつうの人間,にんげんのように歩,あるいているためではないか。","tok":[["あなた"],["がた"],["は"],["まだ"],["、"],["肉","にく"],["の"],["人","ひと"],["だ"],["から"],["で"],["ある"],["。"],["あなた"],["がた"],["の"],["間","あいだ"],["に"],["、"],["ねたみ"],["や"],["争い","あらそい"],["が"],["ある"],["の"],["は"],["、"],["あなた"],["がた"],["が"],["肉","にく"],["の"],["人","ひと"],["で"],["あって"],["、"],["普通","ふつう"],["の"],["人間","にんげん"],["の"],["よう"],["に"],["歩いて","あるいて"],["いる"],["ため"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":4,"text":"すなわち、ある人,ひとは「わたしはパウロに」と言,いい、ほかの人,ひとは「わたしはアポロに」と言,いっているようでは、あなたがたは普通,ふつうの人間,にんげんではないか。","tok":[["すなわち"],["、"],["ある"],["人","ひと"],["は"],["「"],["わたし"],["は"],["パウロ"],["に"],["」"],["と"],["言い","いい"],["、"],["ほか"],["の"],["人","ひと"],["は"],["「"],["わたし"],["は"],["アポロ"],["に"],["」"],["と"],["言って","いって"],["いる"],["よう"],["で"],["は"],["、"],["あなた"],["がた"],["は"],["普通","ふつう"],["の"],["人間","にんげん"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":5,"text":"アポロは、いったい、何者,なにものか。また、パウロは何者,なにものか。あなたがたを信仰,しんこうに導,みちびいた人,ひとにすぎない。しかもそれぞれ、主,しゅから与,あたえられた分,ぶんに応,おうじて仕,つかえているのである。","tok":[["アポロ"],["は"],["、"],["いったい"],["、"],["何者","なにもの"],["か"],["。"],["また"],["、"],["パウロ"],["は"],["何者","なにもの"],["か"],["。"],["あなた"],["がた"],["を"],["信仰","しんこう"],["に"],["導いた","みちびいた"],["人","ひと"],["に"],["すぎない"],["。"],["しかも"],["それぞれ"],["、"],["主ら","しゅから"],["与えられた","あたえられた"],["分","ぶん"],["に"],["応じて","おうじて"],["仕えて","つかえて"],["いる"],["ので"],["ある"],["。"]]},{"verse":6,"text":"わたしは植,うえ、アポロは水,みずをそそいだ。しかし成長,せいちょうさせて下,くださるのは、神,かみである。","tok":[["わたし"],["は"],["植え","うえ"],["、"],["アポロ"],["は"],["水","みず"],["を"],["そそいだ"],["。"],["しかし"],["成長","せいちょう"],["させて"],["下さる","くださる"],["の"],["は"],["、"],["神","かみ"],["で"],["ある"],["。"]]},{"verse":7,"text":"だから、植,うえる者,ものも水,みずをそそぐ者,ものも、ともに取,とるに足,たりない。大事,だいじなのは、成長,せいちょうさせて下,くださる神,かみのみである。","tok":[["だ"],["から"],["、"],["植える","うえる"],["者","もの"],["も"],["水","みず"],["を"],["そそぐ"],["者","もの"],["も"],["、"],["とも"],["に"],["取る","とる"],["に"],["足りない","たりない"],["。"],["大事","だいじ"],["な"],["の"],["は"],["、"],["成長","せいちょう"],["させて"],["下さる","くださる"],["神","かみ"],["のみ"],["で"],["ある"],["。"]]},{"verse":8,"text":"植,うえる者,ものと水,みずをそそぐ者,ものとは一つであって、それぞれその働,はたらきに応,おうじて報酬,ほうしゅうを得,えるであろう。","tok":[["植える","うえる"],["者","もの"],["と"],["水","みず"],["を"],["そそぐ"],["者","もの"],["と"],["は"],["一","ひと"],["つ"],["で"],["あって"],["、"],["それぞれ"],["その"],["働らき","はたらき"],["に"],["応じて","おうじて"],["報酬","ほうしゅう"],["を"],["得るで","えるで"],["あろう"],["。"]]},{"verse":9,"text":"わたしたちは神,かみの同労者,どうろうしゃである。あなたがたは神,かみの畑,はたけであり、神,かみの建物,たてものである。","tok":[["わたしたち"],["は"],["神","かみ"],["の"],["同労者","どうろうしゃ"],["で"],["ある"],["。"],["あなた"],["がた"],["は"],["神","かみ"],["の"],["畑","はたけ"],["で"],["あり"],["、"],["神","かみ"],["の"],["建物","たてもの"],["で"],["ある"],["。"]]},{"verse":10,"text":"神,かみから賜,たまわった恵,めぐみによって、わたしは熟練,じゅくれんした建築,けんちく師,しのように、土台,どだいをすえた。そして他,たの人,ひとがその上,うえに家,いえを建,たてるのである。しかし、どういうふうに建,たてるか、それぞれ気,きをつけるがよい。","tok":[["神","かみ"],["から"],["賜わった","たまわった"],["恵","めぐみ"],["によって"],["、"],["わたし"],["は"],["熟練","じゅくれん"],["した"],["建築師","けんちくし"],["の"],["よう"],["に"],["、"],["土台","どだい"],["を"],["すえた"],["。"],["そして"],["他","た"],["の"],["人","ひと"],["が"],["その"],["上","うえ"],["に"],["家","いえ"],["を"],["建てる","たてる"],["ので"],["ある"],["。"],["しかし"],["、"],["どう"],["いう"],["ふう"],["に"],["建てる","たてる"],["か"],["、"],["それぞれ"],["気","き"],["を"],["つける"],["が"],["よい"],["。"]]},{"verse":11,"text":"なぜなら、すでにすえられている土台,どだい以外,いがいのものをすえることは、だれにもできない。そして、この土台,どだいはイエス・キリストである。","tok":[["なぜ"],["なら"],["、"],["すでに"],["すえられて"],["いる"],["土台","どだい"],["以外","いがい"],["の"],["もの"],["を"],["すえる"],["こと"],["は"],["、"],["だれ"],["に"],["も"],["できない"],["。"],["そして"],["、"],["この"],["土台","どだい"],["は"],["イエス"],["・"],["キリスト"],["で"],["ある"],["。"]]},{"verse":12,"text":"この土台,どだいの上,うえに、だれかが金,きん、銀,ぎん、宝石,ほうせき、木,き、草,くさ、または、わらを用,もちいて建,たてるならば、","tok":[["この"],["土台","どだい"],["の"],["上","うえ"],["に"],["、"],["だれ"],["か"],["が"],["金","きん"],["、"],["銀","ぎん"],["、"],["宝石","ほうせき"],["、"],["木","き"],["、"],["草","くさ"],["、"],["また"],["は"],["、"],["わら"],["を"],["用いて","もちいて"],["建てるならば","たてるならば"],["、"]]},{"verse":13,"text":"それぞれの仕事,しごとは、はっきりとわかってくる。すなわち、かの日,ひは火,ひの中,なかに現,あらわれて、それを明,あきらかにし、またその火,ひは、それぞれの仕事,しごとがどんなものであるかを、ためすであろう。","tok":[["それぞれ"],["の"],["仕事","しごと"],["は"],["、"],["はっきり"],["と"],["わかって"],["くる"],["。"],["すなわち"],["、"],["かの"],["日","ひ"],["は"],["火","ひ"],["の"],["中","なか"],["に"],["現われて","あらわれて"],["、"],["それ"],["を"],["明か","あきらか"],["に"],["し"],["、"],["また"],["その"],["火","ひ"],["は"],["、"],["それぞれ"],["の"],["仕事","しごと"],["が"],["どんな"],["もの"],["で"],["ある"],["か"],["を"],["、"],["ためすで"],["あろう"],["。"]]},{"verse":14,"text":"もしある人,ひとの建,たてた仕事,しごとがそのまま残れば、その人,ひとは報酬,ほうしゅうを受,うけるが、","tok":[["もし"],["ある"],["人","ひと"],["の"],["建てた","たてた"],["仕事","しごと"],["が"],["そのまま"],["残れば","のこれば"],["、"],["その"],["人","ひと"],["は"],["報酬","ほうしゅう"],["を"],["受る","うける"],["が"],["、"]]},{"verse":15,"text":"その仕事,しごとが焼,やけてしまえば、損失,そんしつを被,こうむるであろう。しかし彼,かれ自身,じしんは、火,ひの中,なかをくぐってきた者,もののようにではあるが、救,すくわれるであろう。","tok":[["その"],["仕事","しごと"],["が"],["焼","やけ"],["て"],["しまえば"],["、"],["損失","そんしつ"],["を"],["被うむるで","こうむるで"],["あろう"],["。"],["しかし"],["彼","かれ"],["自身","じしん"],["は"],["、"],["火","ひ"],["の"],["中","なか"],["を"],["くぐって"],["きた"],["者","もの"],["の"],["よう"],["にで"],["は"],["ある"],["が"],["、"],["救われるで","すくわれるで"],["あろう"],["。"]]},{"verse":16,"text":"あなたがたは神,かみの宮,みやであって、神,かみの御霊,みたまが自分,じぶんのうちに宿,やどっていることを知,しらないのか。","tok":[["あなた"],["がた"],["は"],["神","かみ"],["の"],["宮","みや"],["で"],["あって"],["、"],["神","かみ"],["の"],["御霊","み"],["たま"],["が"],["自分","じぶん"],["の"],["うち"],["に"],["宿って","やどって"],["いる"],["こと"],["を"],["知らない","しらない"],["の"],["か"],["。"]]},{"verse":17,"text":"もし人,ひとが、神,かみの宮,みやを破壊,はかいするなら、神,かみはその人,ひとを滅,ほろぼすであろう。なぜなら、神,かみの宮,みやは聖,せいなるものであり、そして、あなたがたはその宮,みやなのだからである。","tok":[["もし"],["人","ひと"],["が"],["、"],["神","かみ"],["の"],["宮","みや"],["を"],["破壊","はかい"],["するなら"],["、"],["神","かみ"],["は"],["その"],["人","ひと"],["を"],["滅ぼすで","ほろぼすで"],["あろう"],["。"],["なぜ"],["なら"],["、"],["神","かみ"],["の"],["宮","みや"],["は"],["聖","せい"],["なる"],["もの"],["で"],["あり"],["、"],["そして"],["、"],["あなた"],["がた"],["は"],["その"],["宮","みや"],["な"],["の"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":18,"text":"だれも自分,じぶんを欺,あざむいてはならない。もしあなたがたのうちに、自分,じぶんがこの世,よの知者,ちしゃだと思,おもう人,ひとがいるなら、その人,ひとは知者,ちしゃになるために愚,おろかになるがよい。","tok":[["だれ"],["も"],["自分","じぶん"],["を"],["欺いて","あざむいて"],["は"],["ならない"],["。"],["もし"],["あなた"],["がた"],["の"],["うち"],["に"],["、"],["自分","じぶん"],["が"],["この世","このよ"],["の"],["知者","ちしゃ"],["だ"],["と"],["思う","おもう"],["人","ひと"],["が"],["いるなら"],["、"],["その"],["人","ひと"],["は"],["知者","ちしゃ"],["に"],["なる"],["ため"],["に"],["愚か","おろか"],["に"],["なる"],["が"],["よい"],["。"]]},{"verse":19,"text":"なぜなら、この世,よの知恵,ちえは、神,かみの前,まえでは愚,おろかなものだからである。「神,かみは、知者,ちしゃたちをその悪知恵,わるぢえによって捕,とらえる」と書,かいてあり、","tok":[["なぜ"],["なら"],["、"],["この世","このよ"],["の"],["知恵","ちえ"],["は"],["、"],["神","かみ"],["の"],["前","まえ"],["で"],["は"],["愚か","おろか"],["な"],["もの"],["だ"],["から"],["で"],["ある"],["。"],["「"],["神","かみ"],["は"],["、"],["知者","ちしゃ"],["たち"],["を"],["その"],["悪知恵","わるぢえ"],["によって"],["捕らえる","とらえる"],["」"],["と"],["書いて","かいて"],["あり"],["、"]]},{"verse":20,"text":"更,さらにまた、「主,しゅは、知者,ちしゃたちの論議,ろんぎのむなしいことをご存,ぞんじである」と書,かいてある。","tok":[["更に","さらに"],["また"],["、"],["「"],["主","しゅ"],["は"],["、"],["知者","ちしゃ"],["たち"],["の"],["論議","ろんぎ"],["の"],["むなしい"],["こと"],["を"],["ご存じ","ごぞんじ"],["で"],["ある"],["」"],["と"],["書いて","かいて"],["ある"],["。"]]},{"verse":21,"text":"だから、だれも人間,にんげんを誇,ほこってはいけない。すべては、あなたがたのものなのである。","tok":[["だ"],["から"],["、"],["だれ"],["も"],["人間","にんげん"],["を"],["誇って","ほこって"],["は"],["いけない"],["。"],["すべて"],["は"],["、"],["あなた"],["がた"],["の"],["もの"],["な"],["ので"],["ある"],["。"]]},{"verse":22,"text":"パウロも、アポロも、ケパも、世界,せかいも、生,せいも、死,しも、現在,げんざいのものも、将来,しょうらいのものも、ことごとく、あなたがたのものである。","tok":[["パウロ"],["も"],["、"],["アポロ"],["も"],["、"],["ケパ"],["も"],["、"],["世界","せかい"],["も"],["、"],["生","せい"],["も"],["、"],["死","し"],["も"],["、"],["現在","げんざい"],["の"],["もの"],["も"],["、"],["将来","しょうらい"],["の"],["もの"],["も"],["、"],["ことごとく"],["、"],["あなた"],["がた"],["の"],["もの"],["で"],["ある"],["。"]]},{"verse":23,"text":"そして、あなたがたはキリストのもの、キリストは神,かみのものである。","tok":[["そして"],["、"],["あなた"],["がた"],["は"],["キリスト"],["の"],["もの"],["、"],["キリスト"],["は"],["神","かみ"],["の"],["もの"],["で"],["ある"],["。"]]}]
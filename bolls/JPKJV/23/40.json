[{"verse":1,"text":"あなたがたの神,かみは言,いわれる、「慰,なぐさめよ、わが民,たみを慰,なぐさめよ、","tok":[["あなた"],["がた"],["の"],["神","かみ"],["は"],["言われる","いわれる"],["、"],["「"],["慰さめよ","なぐさめよ"],["、"],["わが"],["民","たみ"],["を"],["慰さめよ","なぐさめよ"],["、"]]},{"verse":2,"text":"ねんごろにエルサレムに語,かたり、これに呼,よばわれ、その服役,ふくえきの期,きは終,おわり、そのとがはすでにゆるされ、そのもろもろの罪,つみのために二倍,ばいの刑罰,けいばつを主,しゅの手,てから受,うけた」。","tok":[["ねんごろ"],["に"],["エルサレム"],["に"],["語り","かたり"],["、"],["これ"],["に"],["呼ばわれ","よばわれ"],["、"],["その"],["服役","ふくえき"],["の"],["期","き"],["は"],["終","おわり"],["、"],["その"],["とが"],["は"],["すでに"],["ゆるされ"],["、"],["その"],["もろもろ"],["の"],["罪","つみ"],["の"],["ため"],["に"],["二","に"],["倍","ばい"],["の"],["刑罰","けいばつ"],["を"],["主","しゅ"],["の"],["手","て"],["から"],["受けた","うけた"],["」"],["。"]]},{"verse":3,"text":"呼,よばわる者,ものの声,こえがする、「荒野,あらのに主,しゅの道,みちを備,そなえ、さばくに、われわれの神,かみのために、大路,おおじをまっすぐにせよ。","tok":[["呼ばわる","よばわる"],["者","もの"],["の"],["声","こえ"],["が"],["する"],["、"],["「"],["荒野","あら"],["のに"],["主","しゅ"],["の"],["道","みち"],["を"],["備","そなえ"],["、"],["さばく"],["に"],["、"],["われわれ"],["の"],["神","かみ"],["の"],["ため"],["に"],["、"],["大路","おおじ"],["を"],["まっすぐ"],["に"],["せよ"],["。"]]},{"verse":4,"text":"もろもろの谷,たには高,たかくせられ、もろもろの山,やまと丘,おかとは低,ひくくせられ、高,たか底,そこのある地,ちは平,たいらになり、険,けわしい所,ところは平地,へいちとなる。","tok":[["もろもろ"],["の"],["谷","たに"],["は"],["高かく","たかく"],["せられ"],["、"],["もろもろ"],["の"],["山","やま"],["と"],["丘","おか"],["と"],["は"],["低く","ひくく"],["せられ"],["、"],["高か","たか"],["底","そこ"],["の"],["ある"],["地","ち"],["は"],["平","たいら"],["に"],["なり"],["、"],["険しい","けわしい"],["所","ところ"],["は"],["平地","へいち"],["と"],["なる"],["。"]]},{"verse":5,"text":"こうして主,しゅの栄光,えいこうがあらわれ、人,ひとは皆,みなともにこれを見,みる。これは主,しゅの口,くちが語,かたられたのである」。","tok":[["こう"],["して"],["主","しゅ"],["の"],["栄光","えいこう"],["が"],["あらわれ"],["、"],["人","ひと"],["は"],["皆","みな"],["とも"],["に"],["これ"],["を"],["見る","みる"],["。"],["これ"],["は"],["主","しゅ"],["の"],["口","くち"],["が"],["語られた","かたられた"],["ので"],["ある"],["」"],["。"]]},{"verse":6,"text":"声,こえが聞,きこえる、「呼,よばわれ」。わたしは言,いった、「なんと呼,よばわりましょうか」。「人,ひとはみな草,くさだ。その麗,うるわしさは、すべて野,のの花,はなのようだ。","tok":[["声","こえ"],["が"],["聞こえる","きこえる"],["、"],["「"],["呼ばわれ","よばわれ"],["」"],["。"],["わたし"],["は"],["言った","いった"],["、"],["「"],["なん"],["と"],["呼ばわりましょう","よばわりましょう"],["か"],["」"],["。"],["「"],["人","ひと"],["は"],["みな"],["草","くさ"],["だ"],["。"],["その"],["麗わし","うるわし"],["さ"],["は"],["、"],["すべて"],["野","の"],["の"],["花","はな"],["の"],["よう"],["だ"],["。"]]},{"verse":7,"text":"主,しゅの息,いきがその上,うえに吹,ふけば、草,くさは枯,かれ、花,はなはしぼむ。たしかに人,ひとは草,くさだ。","tok":[["主","しゅ"],["の"],["息","いき"],["が"],["その"],["上","うえ"],["に"],["吹けば","ふけば"],["、"],["草","くさ"],["は"],["枯","かれ"],["、"],["花","はな"],["は"],["しぼむ"],["。"],["たしか"],["に"],["人","ひと"],["は"],["草","くさ"],["だ"],["。"]]},{"verse":8,"text":"草,くさは枯,かれ、花,はなはしぼむ。しかし、われわれの神,かみの言葉,ことばはとこしえに変,かわることはない」。","tok":[["草","くさ"],["は"],["枯","かれ"],["、"],["花","はな"],["は"],["しぼむ"],["。"],["しかし"],["、"],["われわれ"],["の"],["神","かみ"],["の"],["言葉","ことば"],["は"],["とこしえ"],["に"],["変わる","かわる"],["こと"],["は"],["ない"],["」"],["。"]]},{"verse":9,"text":"よきおとずれをシオンに伝,つたえる者,ものよ、高,たかい山,やまにのぼれ。よきおとずれをエルサレムに伝,つたえる者,ものよ、強,つよく声,こえをあげよ、声,こえをあげて恐,おそれるな。ユダのもろもろの町,まちに言,いえ、「あなたがたの神,かみを見,みよ」と。","tok":[["よき"],["おとずれ"],["を"],["シオン"],["に"],["伝える","つたえる"],["者","もの"],["よ"],["、"],["高かい","たかい"],["山","やま"],["に"],["のぼれ"],["。"],["よき"],["おとずれ"],["を"],["エルサレム"],["に"],["伝える","つたえる"],["者","もの"],["よ"],["、"],["強く","つよく"],["声","こえ"],["を"],["あげよ"],["、"],["声","こえ"],["を"],["あげて"],["恐れる","おそれる"],["な"],["。"],["ユダ"],["の"],["もろもろ"],["の"],["町","まち"],["に"],["言え","いえ"],["、"],["「"],["あなた"],["がた"],["の"],["神","かみ"],["を"],["見よ","みよ"],["」"],["と"],["。"]]},{"verse":10,"text":"見,みよ、主,しゅなる神,かみは大能,たいのうをもってこられ、その腕,うでは世,よを治,おさめる。見,みよ、その報,むくいは主,しゅと共,ともにあり、そのはたらきの報,むくいは、そのみ前,まえにある。","tok":[["見よ","みよ"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["大能","たいのう"],["を"],["もって"],["こられ"],["、"],["その"],["腕","うで"],["は"],["世","よ"],["を"],["治める","おさめる"],["。"],["見よ","みよ"],["、"],["その"],["報い","むくい"],["は"],["主","しゅ"],["と"],["共","とも"],["に"],["あり"],["、"],["その"],["はたらき"],["の"],["報い","むくい"],["は"],["、"],["その"],["み前","みまえ"],["に"],["ある"],["。"]]},{"verse":11,"text":"主,しゅは牧者,ぼくしゃのようにその群,むれを養,やしない、そのかいなに小羊,こひつじをいだき、そのふところに入,いれて携,たずさえゆき、乳,ちちを飲,のませているものをやさしく導,みちびかれる。","tok":[["主","しゅ"],["は"],["牧者","ぼくしゃ"],["の"],["よう"],["に"],["その"],["群れ","むれ"],["を"],["養い","やしない"],["、"],["その"],["かいな"],["に"],["小羊","こひつじ"],["を"],["いだき"],["、"],["その"],["ふところ"],["に"],["入れて","いれて"],["携え","たずさえ"],["ゆき"],["、"],["乳","ちち"],["を"],["飲ませて","のませて"],["いる"],["もの"],["を"],["やさしく"],["導かれる","みちびかれる"],["。"]]},{"verse":12,"text":"だれが、たなごころをもって海,うみをはかり、指,ゆびを伸,のばして天,てんをはかり、地,ちのちりを枡,ますに盛,もり、てんびんをもって、もろもろの山,やまをはかり、はかりをもって、もろもろの丘,おかをはかったか。","tok":[["だれ"],["が"],["、"],["たなごころ"],["を"],["もって"],["海","うみ"],["を"],["はかり"],["、"],["指","ゆび"],["を"],["伸ばして","のばして"],["天","てん"],["を"],["はかり"],["、"],["地","ち"],["の"],["ちり"],["を"],["枡","ます"],["に"],["盛り","もり"],["、"],["てんびん"],["を"],["もって"],["、"],["もろもろ"],["の"],["山","やま"],["を"],["はかり"],["、"],["はかり"],["を"],["もって"],["、"],["もろもろ"],["の"],["丘","おか"],["を"],["はかった"],["か"],["。"]]},{"verse":13,"text":"だれが、主,しゅの霊,れいを導,みちびき、その相談役,そうだんやくとなって主,しゅを教,おしえたか。","tok":[["だれ"],["が"],["、"],["主","しゅ"],["の"],["霊","れい"],["を"],["導き","みちびき"],["、"],["その"],["相談役","そうだんやく"],["と"],["なって"],["主","しゅ"],["を"],["教えた","おしえた"],["か"],["。"]]},{"verse":14,"text":"主,しゅはだれと相談,そうだんして悟,さとりを得,えたか。だれが主,しゅに公義,こうぎの道,みちを教,おしえ、知識,ちしきを教,おしえ、悟,さとりの道,みちを示,しめしたか。","tok":[["主","しゅ"],["は"],["だれ"],["と"],["相談","そうだん"],["して"],["悟り","さとり"],["を"],["得た","えた"],["か"],["。"],["だれ"],["が"],["主に","しゅに"],["公義","こうぎ"],["の"],["道","みち"],["を"],["教え","おしえ"],["、"],["知識","ちしき"],["を"],["教え","おしえ"],["、"],["悟り","さとり"],["の"],["道","みち"],["を"],["示めした","しめした"],["か"],["。"]]},{"verse":15,"text":"見,みよ、もろもろの国民,こくみんは、おけの一,ひとしずくのように、はかりの上,うえのちりのように思,おもわれる。見,みよ、主,しゅは島々,しまじまを、ほこりのようにあげられる。","tok":[["見よ","みよ"],["、"],["もろもろ"],["の"],["国民","こくみん"],["は"],["、"],["おけ"],["の"],["一","ひ"],["と"],["しずく"],["の"],["よう"],["に"],["、"],["はかり"],["の"],["上","うえ"],["の"],["ちり"],["の"],["よう"],["に"],["思われる","おもわれる"],["。"],["見よ","みよ"],["、"],["主","しゅ"],["は"],["島々","しまじま"],["を"],["、"],["ほこり"],["の"],["よう"],["に"],["あげられる"],["。"]]},{"verse":16,"text":"レバノンは、たきぎに足,たりない、またその獣,けものは、燔祭,はんさいに足,たりない。","tok":[["レバノン"],["は"],["、"],["たきぎ"],["に"],["足りない","たりない"],["、"],["また"],["その"],["獣","けもの"],["は"],["、"],["燔祭","はんさい"],["に"],["足りない","たりない"],["。"]]},{"verse":17,"text":"主,しゅのみ前,まえには、もろもろの国民,こくみんは無,なきにひとしい。彼,かれらは主,しゅによって、無,なきもののように、むなしいもののように思,おもわれる。","tok":[["主","しゅ"],["のみ"],["前","まえ"],["に"],["は"],["、"],["もろもろ"],["の"],["国民","こくみん"],["は"],["無き","なき"],["に"],["ひとしい"],["。"],["彼","かれ"],["ら"],["は"],["主に","しゅに"],["よって"],["、"],["無き","なき"],["もの"],["の"],["よう"],["に"],["、"],["むなしい"],["もの"],["の"],["よう"],["に"],["思われる","おもわれる"],["。"]]},{"verse":18,"text":"それで、あなたがたは神,かみをだれとくらべ、どんな像,ぞうと比較,ひかくしようとするのか。","tok":[["それ"],["で"],["、"],["あなた"],["がた"],["は"],["神","かみ"],["を"],["だれ"],["と"],["くらべ"],["、"],["どんな"],["像","ぞう"],["と"],["比較","ひかく"],["しよう"],["と"],["する"],["の"],["か"],["。"]]},{"verse":19,"text":"偶像,ぐうぞうは細工人,さいくにんが鋳,いて造,つくり、鍛冶,かじが、金,きんをもって、それをおおい、また、これがために銀,ぎんの鎖,くさりを造,つくる。","tok":[["偶像","ぐうぞう"],["は"],["細工人","さいくにん"],["が"],["鋳て","いて"],["造","つくり"],["、"],["鍛冶","か"],["じ"],["が"],["、"],["金","きん"],["を"],["もって"],["、"],["それ"],["を"],["おおい"],["、"],["また"],["、"],["これ"],["が"],["ため"],["に"],["銀","ぎん"],["の"],["鎖","くさり"],["を"],["造る","つくる"],["。"]]},{"verse":20,"text":"貧,まずしい者,ものは、ささげ物,ものとして朽,くちることのない木,きを選,えらび、巧,たくみな細工人,さいくにんを求,もとめて、動,うごくことのない像,ぞうを立,たたせる。","tok":[["貧しい","まずしい"],["者","もの"],["は"],["、"],["ささげ物","ささげもの"],["として"],["朽ちる","くちる"],["こと"],["の"],["ない"],["木","き"],["を"],["選ら","えら"],["び"],["、"],["巧み","たくみ"],["な"],["細工人","さいくにん"],["を"],["求めて","もとめて"],["、"],["動く","うごく"],["こと"],["の"],["ない"],["像","ぞう"],["を"],["立たせる","たたせる"],["。"]]},{"verse":21,"text":"あなたがたは知,しらなかったか。あなたがたは聞,きかなかったか。初,はじめから、あなたがたに伝,つたえられなかったか。地,ちの基,もといをおいた時,ときから、あなたがたは悟,さとらなかったか。","tok":[["あなた"],["がた"],["は"],["知らなかった","しらなかった"],["か"],["。"],["あなた"],["がた"],["は"],["聞かなかった","きかなかった"],["か"],["。"],["初め","はじめ"],["から"],["、"],["あなた"],["がた"],["に"],["伝えられなかった","つたえられなかった"],["か"],["。"],["地","ち"],["の"],["基い","もとい"],["を"],["おいた"],["時","とき"],["から"],["、"],["あなた"],["がた"],["は"],["悟らなかった","さとらなかった"],["か"],["。"]]},{"verse":22,"text":"主,しゅは地球,ちきゅうのはるか上,うえに座,ざして、地,ちに住,すむ者,ものをいなごのように見,みられる。主,しゅは天,てんを幕,まくのようにひろげ、これを住,すむべき天幕,てんまくのように張,はり、","tok":[["主","しゅ"],["は"],["地球","ちきゅう"],["の"],["はるか"],["上","うえ"],["に"],["座して","ざして"],["、"],["地","ち"],["に"],["住む","すむ"],["者","もの"],["を"],["いなご"],["の"],["よう"],["に"],["見られる","みられる"],["。"],["主","しゅ"],["は"],["天","てん"],["を"],["幕","まく"],["の"],["よう"],["に"],["ひろげ"],["、"],["これ"],["を"],["住むべき","すむべき"],["天幕","てんまく"],["の"],["よう"],["に"],["張り","はり"],["、"]]},{"verse":23,"text":"また、もろもろの君,きみを無,なきものとせられ、地,ちのつかさたちを、むなしくされる。","tok":[["また"],["、"],["もろもろ"],["の"],["君","きみ"],["を"],["無き","なき"],["もの"],["と"],["せられ"],["、"],["地","ち"],["の"],["つかさ"],["たち"],["を"],["、"],["むなしく"],["される"],["。"]]},{"verse":24,"text":"彼,かれらは、かろうじて植,うえられ、かろうじてまかれ、その幹,みきがかろうじて地,ちに根,ねをおろしたとき、神,かみがその上,うえを吹,ふかれると、彼,かれらは枯,かれて、わらのように、つむじ風,かぜにまき去,さられる。","tok":[["彼","かれ"],["ら"],["は"],["、"],["かろうじて"],["植えられ","うえられ"],["、"],["かろうじて"],["まかれ"],["、"],["その"],["幹","みき"],["が"],["かろうじて"],["地","ち"],["に"],["根","ね"],["を"],["おろした"],["とき"],["、"],["神","かみ"],["が"],["その"],["上","うえ"],["を"],["吹かれる","ふかれる"],["と"],["、"],["彼","かれ"],["ら"],["は"],["枯て","かれて"],["、"],["わら"],["の"],["よう"],["に"],["、"],["つむじ風","つむじかぜ"],["に"],["まき"],["去られる","さられる"],["。"]]},{"verse":25,"text":"聖者,せいじゃは言,いわれる、「それで、あなたがたは、わたしをだれにくらべ、わたしは、だれにひとしいというのか」。","tok":[["聖者","せいじゃ"],["は"],["言われる","いわれる"],["、"],["「"],["それ"],["で"],["、"],["あなた"],["がた"],["は"],["、"],["わたし"],["を"],["だれ"],["に"],["くらべ"],["、"],["わたし"],["は"],["、"],["だれ"],["に"],["ひとしい"],["と"],["いう"],["の"],["か"],["」"],["。"]]},{"verse":26,"text":"目,めを高,たかくあげて、だれが、これらのものを創造,そうぞうしたかを見,みよ。主,しゅは数,かずをしらべて万軍,ばんぐんをひきいだし、おのおのをその名,なで呼,よばれる。その勢,いきおいの大,おおいなるにより、またその力,ちからの強,つよきがゆえに、一つも欠,かけることはない。","tok":[["目","め"],["を"],["高かく","たかく"],["あげて"],["、"],["だれ"],["が"],["、"],["これ"],["ら"],["の"],["もの"],["を"],["創造","そうぞう"],["した"],["か"],["を"],["見よ","みよ"],["。"],["主","しゅ"],["は"],["数","かず"],["を"],["しらべて"],["万","まん"],["軍","ぐん"],["を"],["ひきい"],["だし"],["、"],["おのおの"],["を"],["その"],["名","な"],["で"],["呼ばれる","よばれる"],["。"],["その"],["勢い","いきおい"],["の"],["大いなる","おおいなる"],["に"],["より"],["、"],["また"],["その"],["力","ちから"],["の"],["強き","つよき"],["が"],["ゆえ"],["に"],["、"],["一","ひと"],["つ"],["も"],["欠ける","かける"],["こと"],["は"],["ない"],["。"]]},{"verse":27,"text":"ヤコブよ、何,なにゆえあなたは、「わが道,みちは主,しゅに隠,かくれている」と言,いうか。イスラエルよ、何,なにゆえあなたは、「わが訴,うったえはわが神,かみに顧,かえりみられない」と言,いうか。","tok":[["ヤコブ"],["よ"],["、"],["何ゆえ","なにゆえ"],["あなた"],["は"],["、"],["「"],["わが"],["道","みち"],["は"],["主に","しゅに"],["隠れて","かくれて"],["いる"],["」"],["と"],["言う","いう"],["か"],["。"],["イスラエル"],["よ"],["、"],["何ゆえ","なにゆえ"],["あなた"],["は"],["、"],["「"],["わが"],["訴","うったえ"],["は"],["わが"],["神","かみ"],["に"],["顧られない","かえりみられない"],["」"],["と"],["言う","いう"],["か"],["。"]]},{"verse":28,"text":"あなたは知,しらなかったか、あなたは聞,きかなかったか。主,しゅはとこしえの神,かみ、地,ちの果,はての創造者,そうぞうしゃであって、弱,よわることなく、また疲,つかれることなく、その知恵,ちえははかりがたい。","tok":[["あなた"],["は"],["知らなかった","しらなかった"],["か"],["、"],["あなた"],["は"],["聞かなかった","きかなかった"],["か"],["。"],["主","しゅ"],["は"],["とこしえ"],["の"],["神","かみ"],["、"],["地","ち"],["の"],["果て","はて"],["の"],["創造者","そうぞうしゃ"],["で"],["あって"],["、"],["弱る","よわる"],["こと"],["なく"],["、"],["また"],["疲れる","つかれる"],["こと"],["なく"],["、"],["その"],["知恵","ちえ"],["は"],["はかり"],["がたい"],["。"]]},{"verse":29,"text":"弱,よわった者,ものには力,ちからを与,あたえ、勢,いきおいのない者,ものには強,つよさを増,まし加,くわえられる。","tok":[["弱った","よわった"],["者","もの"],["に"],["は"],["力","ちから"],["を"],["与","あたえ"],["、"],["勢い","いきおい"],["の"],["ない"],["者","もの"],["に"],["は"],["強さ","つよさ"],["を"],["増し加えられる","ましくわえられる"],["。"]]},{"verse":30,"text":"年,ねん若,わかい者,ものも弱,よわり、かつ疲,つかれ、壮年,そうねんの者,ものも疲,つかれはてて倒,たおれる。","tok":[["年","ねん"],["若い","わかい"],["者","もの"],["も"],["弱り","よわり"],["、"],["かつ"],["疲れ","つかれ"],["、"],["壮年","そうねん"],["の"],["者","もの"],["も"],["疲れ","つかれ"],["はてて"],["倒れる","たおれる"],["。"]]},{"verse":31,"text":"しかし主,しゅを待,まち望,のぞむ者,ものは新,あらたなる力,ちからを得,え、わしのように翼,つばさをはって、のぼることができる。走,はしっても疲,つかれることなく、歩,あるいても弱,よわることはない。","tok":[["しかし"],["主","しゅ"],["を"],["待ち望む","まちのぞむ"],["者","もの"],["は"],["新らた","あらた"],["なる"],["力","ちから"],["を"],["得","え"],["、"],["わし"],["の"],["よう"],["に"],["翼","つばさ"],["を"],["はって"],["、"],["のぼる"],["こと"],["が"],["できる"],["。"],["走って","はしって"],["も"],["疲れる","つかれる"],["こと"],["なく"],["、"],["歩いて","あるいて"],["も"],["弱る","よわる"],["こと"],["は"],["ない"],["。"]]}]
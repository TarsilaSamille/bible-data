[{"verse":1,"text":"その日,ひあなたは言,いう、「主,しゅよ、わたしはあなたに感謝,かんしゃします。あなたは、さきにわたしにむかって怒,いかられたが、その怒,いかりはやんで、わたしを慰,なぐさめられたからです。","tok":[["その"],["日","ひ"],["あなた"],["は"],["言う","いう"],["、"],["「"],["主","しゅ"],["よ"],["、"],["わたし"],["は"],["あなた"],["に"],["感謝","かんしゃ"],["します"],["。"],["あなた"],["は"],["、"],["さき"],["に"],["わたし"],["に"],["むかって"],["怒","い"],["から"],["れた"],["が"],["、"],["その"],["怒り","いかり"],["は"],["やんで"],["、"],["わたし"],["を"],["慰さめられた","なぐさめられた"],["から"],["です"],["。"]]},{"verse":2,"text":"見,みよ、神,かみはわが救,すくいである。わたしは信頼,しんらいして恐,おそれることはない。主,しゅなる神,かみはわが力,ちから、わが歌,うたであり、わが救,すくいとなられたからである」。","tok":[["見よ","みよ"],["、"],["神","かみ"],["は"],["わが"],["救い","すくい"],["で"],["ある"],["。"],["わたし"],["は"],["信頼","しんらい"],["して"],["恐れる","おそれる"],["こと"],["は"],["ない"],["。"],["主","しゅ"],["なる"],["神","かみ"],["は"],["わが"],["力","ちから"],["、"],["わが"],["歌","うた"],["で"],["あり"],["、"],["わが"],["救い","すくい"],["と"],["なられた"],["から"],["で"],["ある"],["」"],["。"]]},{"verse":3,"text":"あなたがたは喜,よろこびをもって、救,すくいの井戸,いどから水,みずをくむ。","tok":[["あなた"],["がた"],["は"],["喜こび","よろこび"],["を"],["もって"],["、"],["救い","すくい"],["の"],["井戸","いど"],["から"],["水","みず"],["を"],["くむ"],["。"]]},{"verse":4,"text":"その日,ひ、あなたがたは言,いう、「主,しゅに感謝,かんしゃせよ。そのみ名,なを呼,よべ。そのみわざをもろもろの民,たみの中,なかにつたえよ。そのみ名,なのあがむべきことを語,かたりつげよ。","tok":[["その"],["日","ひ"],["、"],["あなた"],["がた"],["は"],["言う","いう"],["、"],["「"],["主に","しゅに"],["感謝","かんしゃ"],["せよ"],["。"],["その"],["み名","みな"],["を"],["呼べ","よべ"],["。"],["その"],["みわざ"],["を"],["もろもろ"],["の"],["民","たみ"],["の"],["中","なか"],["に"],["つたえ"],["よ"],["。"],["その"],["み名","みな"],["の"],["あ"],["が"],["むべき"],["こと"],["を"],["語りつげ","かたりつげ"],["よ"],["。"]]},{"verse":5,"text":"主,しゅをほめうたえ。主,しゅはそのみわざを、みごとになし遂,とげられたから。これを全,ぜん地,ちに宣,のべ伝,つたえよ。","tok":[["主","しゅ"],["を"],["ほめ"],["うたえ"],["。"],["主","しゅ"],["は"],["その"],["みわざ"],["を"],["、"],["みごと"],["に"],["なし遂げられた","なしとげられた"],["から"],["。"],["これ"],["を"],["全地","ぜんち"],["に"],["宣べ伝えよ","のべつたえよ"],["。"]]},{"verse":6,"text":"シオンに住,すむ者,ものよ、声,こえをあげて、喜,よろこびうたえ。イスラエルの聖者,せいじゃはあなたがたのうちで大,おおいなる者,ものだから」。","tok":[["シオン"],["に"],["住む","すむ"],["者","もの"],["よ"],["、"],["声","こえ"],["を"],["あげて"],["、"],["喜こび","よろこび"],["うたえ"],["。"],["イスラエル"],["の"],["聖者","せいじゃ"],["は"],["あなた"],["がた"],["の"],["うち"],["で"],["大いなる","おおいなる"],["者","もの"],["だ"],["から"],["」"],["。"]]}]
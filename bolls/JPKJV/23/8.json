[{"verse":1,"text":"主,しゅはわたしに言,いわれた、「一枚,まいの大,おおきな札,ふだを取,とって、その上,うえに普通,ふつうの文字,もじで、『マヘル・シャラル・ハシ・バズ』と書,かきなさい」。","tok":[["主","しゅ"],["は"],["わたし"],["に"],["言われた","いわれた"],["、"],["「"],["一枚","まい"],["の"],["大きな","おおきな"],["札","ふだ"],["を"],["取って","とって"],["、"],["その"],["上","うえ"],["に"],["普通","ふつう"],["の"],["文字","もじ"],["で"],["、"],["『"],["マヘル"],["・"],["シャラル"],["・"],["ハシ"],["・"],["バズ"],["』"],["と"],["書き","かき"],["なさい"],["」"],["。"]]},{"verse":2,"text":"そこで、わたしは確,たしかな証人,しょうにんとして、祭司,さいしウリヤおよびエベレキヤの子,こゼカリヤを立,たてた。","tok":[["そこ"],["で"],["、"],["わたし"],["は"],["確か","たしか"],["な"],["証人","しょうにん"],["として"],["、"],["祭司","さいし"],["ウリヤ"],["および"],["エベレキヤ"],["の"],["子","こ"],["ゼカリヤ"],["を"],["立てた","たてた"],["。"]]},{"verse":3,"text":"わたしが預言者,よげんしゃの妻,つまに近,ちかづくと、彼女,かのじょはみごもって男,おとこの子,こを産,うんだ。その時,とき、主,しゅはわたしに言,いわれた、「その名,なをマヘル・シャラル・ハシ・バズと呼,よびなさい。","tok":[["わたし"],["が"],["預言者","よげんしゃ"],["の"],["妻","つま"],["に"],["近づく","ちかづく"],["と"],["、"],["彼女","かのじょ"],["は"],["みごもって"],["男の子","おとこのこ"],["を"],["産んだ","うんだ"],["。"],["その"],["時","とき"],["、"],["主","しゅ"],["は"],["わたし"],["に"],["言われた","いわれた"],["、"],["「"],["その"],["名","な"],["を"],["マヘル"],["・"],["シャラル"],["・"],["ハシ"],["・"],["バズ"],["と"],["呼び","よび"],["なさい"],["。"]]},{"verse":4,"text":"それはこの子,こがまだ『おとうさん、おかあさん』と呼,よぶことを知,しらないうちに、ダマスコの富,とみと、サマリヤのぶんどり品,ひんとが、アッスリヤ王,おうの前,まえに奪,うばい去,さられるからである」。","tok":[["それ"],["は"],["この"],["子","こ"],["が"],["まだ"],["『"],["おとうさん"],["、"],["おかあさん"],["』"],["と"],["呼ぶ","よぶ"],["こと"],["を"],["知らない","しらない"],["うち"],["に"],["、"],["ダマスコ"],["の"],["富","とみ"],["と"],["、"],["サマリヤ"],["の"],["ぶんどり"],["品","ひん"],["と"],["が"],["、"],["アッスリヤ"],["王","おう"],["の"],["前","まえ"],["に"],["奪い去られる","うばいさられる"],["から"],["で"],["ある"],["」"],["。"]]},{"verse":5,"text":"主,しゅはまた重,かさねてわたしに言,いわれた、","tok":[["主","しゅ"],["は"],["また"],["重ねて","かさねて"],["わたし"],["に"],["言われた","いわれた"],["、"]]},{"verse":6,"text":"「この民,たみはゆるやかに流,ながれるシロアの水,みずを捨,すてて、レヂンとレマリヤの子,この前,まえに恐,おそれくじける。","tok":[["「"],["この"],["民","たみ"],["は"],["ゆるやか"],["に"],["流れる","ながれる"],["シロア"],["の"],["水","みず"],["を"],["捨てて","すてて"],["、"],["レヂン"],["と"],["レマリヤ"],["の"],["子","こ"],["の"],["前","まえ"],["に"],["恐れ","おそれ"],["くじける"],["。"]]},{"verse":7,"text":"それゆえ見,みよ、主,しゅは勢,いきおいたけく、みなぎりわたる大川,おおかわの水,みずを彼,かれらにむかってせき入,いれられる。これはアッスリヤの王,おうと、そのもろもろの威勢,いせいとであって、そのすべての支流,しりゅうにはびこり、すべての岸,きしを越,こえ、","tok":[["それ"],["ゆえ"],["見よ","みよ"],["、"],["主","しゅ"],["は"],["勢","いきおい"],["たけ"],["く"],["、"],["みなぎり"],["わたる"],["大川","おおかわ"],["の"],["水","みず"],["を"],["彼","かれ"],["ら"],["に"],["むかって"],["せき入れられる","せきいれられる"],["。"],["これ"],["は"],["アッスリヤ"],["の"],["王","おう"],["と"],["、"],["その"],["もろもろ"],["の"],["威勢","いせい"],["と"],["であって"],["、"],["その"],["すべて"],["の"],["支流","しりゅう"],["に"],["はびこり"],["、"],["すべて"],["の"],["岸","きし"],["を"],["越え","こえ"],["、"]]},{"verse":8,"text":"ユダに流,ながれ入,いり、あふれみなぎって、首,くびにまで及,およぶ。インマヌエルよ、その広,ひろげた翼,つばさはあまねく、あなたの国,くにに満,みちわたる」。","tok":[["ユダ"],["に"],["流れ","ながれ"],["入","いり"],["、"],["あふれ"],["みなぎって"],["、"],["首","くび"],["に"],["まで"],["及ぶ","およぶ"],["。"],["インマヌエル"],["よ"],["、"],["その"],["広げた","ひろげた"],["翼","つばさ"],["は"],["あまねく"],["、"],["あなた"],["の"],["国","くに"],["に"],["満ち","みち"],["わたる"],["」"],["。"]]},{"verse":9,"text":"もろもろの民,たみよ、打,うち破,やぶられて、驚,おどろきあわてよ。遠,とおき国々,くにぐにのものよ、耳,みみを傾,かたむけよ。腰,こしに帯,おびして、驚,おどろきあわてよ。腰,こしに帯,おびして、驚,おどろきあわてよ。","tok":[["もろもろ"],["の"],["民","たみ"],["よ"],["、"],["打ち破られて","うちやぶられて"],["、"],["驚","おどろき"],["あわてよ"],["。"],["遠き","とおき"],["国々","くにぐに"],["の"],["もの"],["よ"],["、"],["耳","みみ"],["を"],["傾むけよ","かたむけよ"],["。"],["腰","こし"],["に"],["帯び","おび"],["して"],["、"],["驚","おどろき"],["あわてよ"],["。"],["腰","こし"],["に"],["帯び","おび"],["して"],["、"],["驚","おどろき"],["あわてよ"],["。"]]},{"verse":10,"text":"ともに計,はかれ、しかし、成,ならない。言葉,ことばを出,だせ、しかし、行,おこなわれない。神,かみがわれわれと共,ともにおられるからである。","tok":[["とも"],["に"],["計れ","はかれ"],["、"],["しかし"],["、"],["成らない","ならない"],["。"],["言葉","ことば"],["を"],["出せ","だせ"],["、"],["しかし"],["、"],["行なわれない","おこなわれない"],["。"],["神","かみ"],["が"],["われわれ"],["と"],["共","とも"],["に"],["おられる"],["から"],["で"],["ある"],["。"]]},{"verse":11,"text":"主,しゅは強,つよいみ手,てをもって、わたしを捕,とらえ、わたしに語,かたり、この民,たみの道,みちに歩,あゆまないように、さとして言,いわれた、","tok":[["主","しゅ"],["は"],["強い","つよい"],["み手","みて"],["を"],["もって"],["、"],["わたし"],["を"],["捕らえ","とらえ"],["、"],["わたし"],["に"],["語り","かたり"],["、"],["この"],["民","たみ"],["の"],["道","みち"],["に"],["歩まない","あゆまない"],["よう"],["に"],["、"],["さとして"],["言われた","いわれた"],["、"]]},{"verse":12,"text":"「この民,たみがすべて陰謀,いんぼうととなえるものを陰謀,いんぼうととなえてはならない。彼,かれらの恐,おそれるものを恐,おそれてはならない。またおののいてはならない。","tok":[["「"],["この"],["民","たみ"],["が"],["すべて"],["陰謀","いんぼう"],["と"],["となえる"],["もの"],["を"],["陰謀","いんぼう"],["と"],["となえて"],["は"],["ならない"],["。"],["彼","かれ"],["ら"],["の"],["恐れる","おそれる"],["もの"],["を"],["恐れて","おそれて"],["は"],["ならない"],["。"],["また"],["おののいて"],["は"],["ならない"],["。"]]},{"verse":13,"text":"あなたがたは、ただ万軍,ばんぐんの主,しゅを聖,せいとして、彼,かれをかしこみ、彼,かれを恐,おそれなければならない。","tok":[["あなた"],["がた"],["は"],["、"],["ただ"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["を"],["聖","せい"],["として"],["、"],["彼","かれ"],["を"],["かしこみ"],["、"],["彼","かれ"],["を"],["恐れなければ","おそれなければ"],["ならない"],["。"]]},{"verse":14,"text":"主,しゅはイスラエルの二つの家,いえには聖所,せいじょとなり、またさまたげの石,いし、つまずきの岩,いわとなり、エルサレムの住民,じゅうみんには網,あみとなり、わなとなる。","tok":[["主","しゅ"],["は"],["イスラエル"],["の"],["二","ふた"],["つ"],["の"],["家","いえ"],["に"],["は"],["聖","せい"],["所","しょ"],["い"],["じょ"],["と"],["なり"],["、"],["また"],["さまたげ"],["の"],["石","いし"],["、"],["つまずき"],["の"],["岩","いわ"],["と"],["なり"],["、"],["エルサレム"],["の"],["住民","じゅうみん"],["に"],["は"],["網","あみ"],["と"],["なり"],["、"],["わな"],["と"],["なる"],["。"]]},{"verse":15,"text":"多,おおくの者,ものはこれにつまずき、かつ倒,たおれ、破,やぶられ、わなにかけられ、捕,とらえられる」。","tok":[["多く","おおく"],["の"],["者","もの"],["は"],["これ"],["に"],["つまずき"],["、"],["かつ"],["倒れ","たおれ"],["、"],["破られ","やぶられ"],["、"],["わな"],["に"],["かけられ"],["、"],["捕らえられる","とらえられる"],["」"],["。"]]},{"verse":16,"text":"わたしは、あかしを一つにまとめ、教,おしえをわが弟子,でしたちのうちに封,ふうじておこう。","tok":[["わたし"],["は"],["、"],["あかし"],["を"],["一","ひと"],["つ"],["に"],["まとめ"],["、"],["教え","おしえ"],["を"],["わが"],["弟子","でし"],["たち"],["の"],["うち"],["に"],["封じて","ふうじて"],["おこう"],["。"]]},{"verse":17,"text":"主,しゅはいま、ヤコブの家,いえに、み顔,かおをかくしておられるとはいえ、わたしはその主,しゅを待,まち、主,しゅを望,のぞみまつる。","tok":[["主","しゅ"],["は"],["いま"],["、"],["ヤコブ"],["の"],["家","いえ"],["に"],["、"],["み顔","みかお"],["を"],["かくして"],["おられる"],["と"],["は"],["いえ"],["、"],["わたし"],["は"],["その"],["主","しゅ"],["を"],["待ち","まち"],["、"],["主","しゅ"],["を"],["望み","のぞみ"],["まつる"],["。"]]},{"verse":18,"text":"見,みよ、わたしと、主,しゅのわたしに賜,たまわった子,こたちとは、シオンの山,やまにいます万軍,ばんぐんの主,しゅから与,あたえられたイスラエルのしるしであり、前,まえぶれである。","tok":[["見よ","みよ"],["、"],["わたし"],["と"],["、"],["主","しゅ"],["の"],["わたし"],["に"],["賜わった","たまわった"],["子","こ"],["たち"],["と"],["は"],["、"],["シオン"],["の"],["山","やま"],["に"],["います"],["万","まん"],["軍","ぐん"],["の"],["主ら","しゅから"],["与えられた","あたえられた"],["イスラエル"],["の"],["しるし"],["で"],["あり"],["、"],["前ぶれ","まえぶれ"],["で"],["ある"],["。"]]},{"verse":19,"text":"人々,ひとびとがあなたがたにむかって「さえずるように、ささやくように語,かたる巫子,みこおよび魔術者,まじゅつしゃに求,もとめよ」という時,とき、民,たみは自分,じぶんたちの神,かみに求,もとむべきではないか。生,いける者,もののために死,しんだ者,ものに求,もとめるであろうか。","tok":[["人々","ひとびと"],["が"],["あなた"],["がた"],["に"],["むかって"],["「"],["さえずる"],["よう"],["に"],["、"],["ささやく"],["よう"],["に"],["語る","かたる"],["巫子","みこ"],["および"],["魔術者","まじゅつしゃ"],["に"],["求めよ","もとめよ"],["」"],["と"],["いう"],["時","とき"],["、"],["民","たみ"],["は"],["自分","じぶん"],["たち"],["の"],["神","かみ"],["に"],["求むべきで","もとむべきで"],["は"],["ない"],["か"],["。"],["生ける","いける"],["者","もの"],["の"],["ため"],["に"],["死んだ","しんだ"],["者","もの"],["に"],["求めるで","もとめるで"],["あろう"],["か"],["。"]]},{"verse":20,"text":"ただ教,おしえとあかしとに求,もとめよ。まことに彼,かれらはこの言葉,ことばによって語,かたるが、そこには夜明,よあけがない。","tok":[["ただ"],["教え","おしえ"],["と"],["あかし"],["と"],["に"],["求めよ","もとめよ"],["。"],["まこと"],["に"],["彼","かれ"],["ら"],["は"],["この"],["言葉","ことば"],["によって"],["語る","かたる"],["が"],["、"],["そこ"],["に"],["は"],["夜明","よあけ"],["が"],["ない"],["。"]]},{"verse":21,"text":"彼,かれらはしえたげられ、飢,うえて国,くにの中,なかを経,へあるく。その飢,うえるとき怒,いかりを放,はなち、自分,じぶんたちの王,おう、自分,じぶんたちの神,かみをのろい、かつその顔,かおを天,てんに向,むける。","tok":[["彼","かれ"],["ら"],["は"],["し"],["えたげられ"],["、"],["飢","うえ"],["て"],["国","くに"],["の"],["中","なか"],["を"],["経","へ"],["あるく"],["。"],["その"],["飢","うえ"],["る"],["とき"],["怒り","いかり"],["を"],["放ち","はなち"],["、"],["自分","じぶん"],["たち"],["の"],["王","おう"],["、"],["自分","じぶん"],["たち"],["の"],["神","かみ"],["を"],["のろい"],["、"],["かつ"],["その"],["顔","かお"],["を"],["天","てん"],["に"],["向ける","むける"],["。"]]},{"verse":22,"text":"また地,ちを見,みると、見,みよ、悩,なやみと暗,くらきと、苦,くるしみのやみとがあり、彼,かれらは暗黒,あんこくに追,おいやられる。","tok":[["また"],["地","ち"],["を"],["見る","みる"],["と"],["、"],["見よ","みよ"],["、"],["悩み","なやみ"],["と"],["暗き","くらき"],["と"],["、"],["苦しみ","くるしみ"],["の"],["やみ"],["と"],["が"],["あり"],["、"],["彼","かれ"],["ら"],["は"],["暗黒","あんこく"],["に"],["追いやられる","おいやられる"],["。"]]},{"verse":23,"text":"[9:1]しかし、苦,くるしみにあった地,ちにも、やみがなくなる。さきにはゼブルンの地,ち、ナフタリの地,ちにはずかしめを与,あたえられたが、後,のちには海,うみに至,いたる道,みち、ヨルダンの向,むこうの地,ち、異邦人,いほうじんのガリラヤに光栄,こうえいを与,あたえられる。","tok":[["["],["9"],[":"],["1"],["]"],["しかし"],["、"],["苦しみ","くるしみ"],["に"],["あった"],["地","ち"],["に"],["も"],["、"],["やみ"],["が"],["なくなる"],["。"],["さき"],["に"],["は"],["ゼブルン"],["の"],["地","ち"],["、"],["ナフタリ"],["の"],["地","ち"],["に"],["はずかしめ"],["を"],["与えられた","あたえられた"],["が"],["、"],["後","のち"],["に"],["は"],["海","うみ"],["に"],["至る","いたる"],["道","みち"],["、"],["ヨルダン"],["の"],["向こう","むこう"],["の"],["地","ち"],["、"],["異邦人","いほうじん"],["の"],["ガリラヤ"],["に"],["光栄","こうえい"],["を"],["与えられる","あたえられる"],["。"]]}]
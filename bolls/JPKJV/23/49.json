[{"verse":1,"text":"海沿,うみぞいの国々,くにぐによ、わたしに聞,きけ。遠,とおいところのもろもろの民,たみよ、耳,みみを傾,かたむけよ。主,しゅはわたしを生,うまれ出,でた時,ときから召,めし、母,ははの胎,たいを出,でた時,ときからわが名,なを語,かたり告,つげられた。","tok":[["海沿い","うみぞい"],["の"],["国々","くにぐに"],["よ"],["、"],["わたし"],["に"],["聞け","きけ"],["。"],["遠い","とおい"],["ところ"],["の"],["もろもろ"],["の"],["民","たみ"],["よ"],["、"],["耳","みみ"],["を"],["傾むけよ","かたむけよ"],["。"],["主","しゅ"],["は"],["わたし"],["を"],["生まれ出た","うまれでた"],["時","とき"],["から"],["召","めし"],["、"],["母","はは"],["の"],["胎","たい"],["を"],["出た","でた"],["時","とき"],["から"],["わが"],["名","な"],["を"],["語り告げられた","かたりつげられた"],["。"]]},{"verse":2,"text":"主,しゅはわが口,くちを鋭利,えいりなつるぎとなし、わたしをみ手,ての陰,かげにかくし、とぎすました矢,やとなして、箙,えびらにわたしを隠,かくされた。","tok":[["主","しゅ"],["は"],["わが"],["口","くち"],["を"],["鋭利","えいり"],["な"],["つるぎ"],["と"],["なし"],["、"],["わたし"],["を"],["み手","みて"],["の"],["陰","かげ"],["に"],["かくし"],["、"],["とぎすました"],["矢","や"],["と"],["なして"],["、"],["箙","えびら"],["に"],["わたし"],["を"],["隠された","かくされた"],["。"]]},{"verse":3,"text":"また、わたしに言,いわれた、「あなたはわがしもべ、わが栄光,えいこうをあらわすべきイスラエルである」と。","tok":[["また"],["、"],["わたし"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["は"],["わが"],["しもべ"],["、"],["わが"],["栄光","えいこう"],["を"],["あらわすべき"],["イスラエル"],["で"],["ある"],["」"],["と"],["。"]]},{"verse":4,"text":"しかし、わたしは言,いった、「わたしはいたずらに働,はたらき、益,えきなく、むなしく力,ちからを費,ついやした。しかもなお、まことにわが正,ただしきは主,しゅと共,ともにあり、わが報,むくいはわが神,かみと共,ともにある」と。","tok":[["しかし"],["、"],["わたし"],["は"],["言った","いった"],["、"],["「"],["わたし"],["は"],["いたずら"],["に"],["働らき","はたらき"],["、"],["益","えき"],["なく"],["、"],["むなしく"],["力","ちから"],["を"],["費やした","ついやした"],["。"],["しかも"],["なお"],["、"],["まこと"],["に"],["わが"],["正き","ただしき"],["は"],["主","しゅ"],["と"],["共","とも"],["に"],["あり"],["、"],["わが"],["報い","むくい"],["は"],["わが"],["神","かみ"],["と"],["共","とも"],["に"],["ある"],["」"],["と"],["。"]]},{"verse":5,"text":"ヤコブをおのれに帰,かえらせ、イスラエルをおのれのもとに集,あつめるために、わたしを腹,はらの中,うちからつくってそのしもべとされた主,しゅは言,いわれる。（わたしは主,しゅの前,まえに尊,たっとばれ、わが神,かみはわが力,ちからとなられた）","tok":[["ヤコブ"],["を"],["おのれ"],["に"],["帰えらせ","かえらせ"],["、"],["イスラエル"],["を"],["おのれ"],["の"],["もと"],["に"],["集める","あつめる"],["ため"],["に"],["、"],["わたし"],["を"],["腹","はら"],["の"],["中ら","うちから"],["つくって"],["その"],["しもべ"],["と"],["された"],["主","しゅ"],["は"],["言われる","いわれる"],["。"],["（"],["わたし"],["は"],["主","しゅ"],["の"],["前","まえ"],["に"],["尊","た"],["っと"],["ばれ"],["、"],["わが"],["神","かみ"],["は"],["わが"],["力","ちから"],["と"],["なられた"],["）"]]},{"verse":6,"text":"主,しゅは言,いわれる、「あなたがわがしもべとなって、ヤコブのもろもろの部族,ぶぞくをおこし、イスラエルのうちの残,のこった者,ものを帰,かえらせることは、いとも軽,かるい事,ことである。わたしはあなたを、もろもろの国,くにびとの光,ひかりとなして、わが救,すくいを地,ちの果,はてにまでいたらせよう」と。","tok":[["主","しゅ"],["は"],["言われる","いわれる"],["、"],["「"],["あなた"],["が"],["わが"],["しもべ"],["と"],["なって"],["、"],["ヤコブ"],["の"],["もろもろ"],["の"],["部族","ぶぞく"],["を"],["おこし"],["、"],["イスラエル"],["の"],["うち"],["の"],["残った","のこった"],["者","もの"],["を"],["帰えらせる","かえらせる"],["こと"],["は"],["、"],["いとも"],["軽い","かるい"],["事","こと"],["で"],["ある"],["。"],["わたし"],["は"],["あなた"],["を"],["、"],["もろもろ"],["の"],["国びと","くにびと"],["の"],["光","ひかり"],["と"],["なして"],["、"],["わが"],["救い","すくい"],["を"],["地","ち"],["の"],["果て","はて"],["に"],["まで"],["いたらせよう"],["」"],["と"],["。"]]},{"verse":7,"text":"イスラエルのあがない主,しゅ、イスラエルの聖者,せいじゃなる主,しゅは、人,ひとに侮,あなどられる者,もの、民,たみに忌,いみきらわれる者,もの、つかさたちのしもべにむかってこう言,いわれる、「もろもろの王,おうは見,みて、立,たちあがり、もろもろの君,きみは立,たって、拝,はいする。これは真実,しんじつなる主,しゅ、イスラエルの聖者,せいじゃが、あなたを選,えらばれたゆえである」。","tok":[["イスラエル"],["の"],["あがない"],["主","しゅ"],["、"],["イスラエル"],["の"],["聖者","せいじゃ"],["なる"],["主","しゅ"],["は"],["、"],["人","ひと"],["に"],["侮られる","あなどられる"],["者","もの"],["、"],["民","たみ"],["に"],["忌","いみ"],["きらわれる"],["者","もの"],["、"],["つかさ"],["たち"],["の"],["しもべ"],["に"],["むかって"],["こう"],["言われる","いわれる"],["、"],["「"],["もろもろ"],["の"],["王","おう"],["は"],["見て","みて"],["、"],["立ちあがり","たちあがり"],["、"],["もろもろ"],["の"],["君","きみ"],["は"],["立って","たって"],["、"],["拝する","はいする"],["。"],["これ"],["は"],["真実","しんじつ"],["なる"],["主","しゅ"],["、"],["イスラエル"],["の"],["聖者","せいじゃ"],["が"],["、"],["あなた"],["を"],["選ら","えら"],["ばれた"],["ゆえ"],["で"],["ある"],["」"],["。"]]},{"verse":8,"text":"主,しゅはこう言,いわれる、「わたしは恵,めぐみの時,ときに、あなたに答,こたえ、救,すくいの日,ひにあなたを助,たすけた。わたしはあなたを守,まもり、あなたを与,あたえて民,たみの契約,けいやくとし、国,くにを興,おこし、荒,あれすたれた地,ちを嗣,し業,ぎょうとして継,つがせる。","tok":[["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["「"],["わたし"],["は"],["恵","めぐみ"],["の"],["時","とき"],["に"],["、"],["あなた"],["に"],["答","こたえ"],["、"],["救い","すくい"],["の"],["日","ひ"],["に"],["あなた"],["を"],["助けた","たすけた"],["。"],["わたし"],["は"],["あなた"],["を"],["守り","まもり"],["、"],["あなた"],["を"],["与","あたえ"],["て"],["民","たみ"],["の"],["契約","けいやく"],["と"],["し"],["、"],["国","くに"],["を"],["興し","おこし"],["、"],["荒れ","あれ"],["すたれた"],["地","ち"],["を"],["嗣業","しぎょう"],["として"],["継がせる","つがせる"],["。"]]},{"verse":9,"text":"わたしは捕,とらえられた人,ひとに『出,でよ』と言,いい、暗,くらきにおる者,ものに『あらわれよ』と言,いう。彼,かれらは道,みちすがら食,たべることができ、すべての裸,はだかの山,やまにも牧草,ぼくそうを得,える。","tok":[["わたし"],["は"],["捕らえられた","とらえられた"],["人","ひと"],["に"],["『"],["出","で"],["よ"],["』"],["と"],["言い","いい"],["、"],["暗き","くらき"],["に"],["おる"],["者","もの"],["に"],["『"],["あらわれ"],["よ"],["』"],["と"],["言う","いう"],["。"],["彼","かれ"],["ら"],["は"],["道すがら","みちすがら"],["食べる","たべる"],["こと"],["が"],["でき"],["、"],["すべて"],["の"],["裸","はだか"],["の"],["山","やま"],["に"],["も"],["牧草","ぼくそう"],["を"],["得る","える"],["。"]]},{"verse":10,"text":"彼,かれらは飢,うえることがなく、かわくこともない。また熱,あつい風,かぜも、太陽,たいようも彼,かれらを撃,うつことはない。彼,かれらをあわれむ者,ものが彼,かれらを導,みちびき、泉,いずみのほとりに彼,かれらを導,みちびかれるからだ。","tok":[["彼","かれ"],["ら"],["は"],["飢","うえ"],["る"],["こと"],["が"],["なく"],["、"],["かわく"],["こと"],["も"],["ない"],["。"],["また"],["熱い","あつい"],["風","かぜ"],["も"],["、"],["太陽","たいよう"],["も"],["彼","かれ"],["ら"],["を"],["撃つ","うつ"],["こと"],["は"],["ない"],["。"],["彼","かれ"],["ら"],["を"],["あわれむ"],["者","もの"],["が"],["彼","かれ"],["ら"],["を"],["導き","みちびき"],["、"],["泉","いずみ"],["の"],["ほとり"],["に"],["彼","かれ"],["ら"],["を"],["導かれる","みちびかれる"],["から"],["だ"],["。"]]},{"verse":11,"text":"わたしは、わがもろもろの山,やまを道,みちとし、わが大路,おおじを高,たかくする。","tok":[["わたし"],["は"],["、"],["わが"],["もろもろ"],["の"],["山","やま"],["を"],["道","みち"],["と"],["し"],["、"],["わが"],["大路","おおじ"],["を"],["高かく","たかく"],["する"],["。"]]},{"verse":12,"text":"見,みよ、人々,ひとびとは遠,とおくから来,くる。見,みよ、人々,ひとびとは北,きたから西,にしから、またスエネの地,ちから来,くる」。","tok":[["見よ","みよ"],["、"],["人々","ひとびと"],["は"],["遠く","とおく"],["から"],["来る","くる"],["。"],["見よ","みよ"],["、"],["人々","ひとびと"],["は"],["北","きた"],["から"],["西","にし"],["から"],["、"],["また"],["スエネ"],["の"],["地","ち"],["から"],["来る","くる"],["」"],["。"]]},{"verse":13,"text":"天,てんよ、歌,うたえ、地,ちよ、喜,よろこべ。もろもろの山,やまよ、声,こえを放,はなって歌,うたえ。主,しゅはその民,たみを慰,なぐさめ、その苦,くるしむ者,ものをあわれまれるからだ。","tok":[["天","てん"],["よ"],["、"],["歌え","うたえ"],["、"],["地","ち"],["よ"],["、"],["喜こべ","よろこべ"],["。"],["もろもろ"],["の"],["山","やま"],["よ"],["、"],["声","こえ"],["を"],["放って","はなって"],["歌え","うたえ"],["。"],["主","しゅ"],["は"],["その"],["民","たみ"],["を"],["慰さめ","なぐさめ"],["、"],["その"],["苦しむ","くるしむ"],["者","もの"],["を"],["あわれまれる"],["から"],["だ"],["。"]]},{"verse":14,"text":"しかしシオンは言,いった、「主,しゅはわたしを捨,すて、主,しゅはわたしを忘,わすれられた」と。","tok":[["しかし"],["シオン"],["は"],["言った","いった"],["、"],["「"],["主","しゅ"],["は"],["わたし"],["を"],["捨て","すて"],["、"],["主","しゅ"],["は"],["わたし"],["を"],["忘られた","わすれられた"],["」"],["と"],["。"]]},{"verse":15,"text":"「女,おんながその乳,ちのみ子,ごを忘,わすれて、その腹,はらの子,こを、あわれまないようなことがあろうか。たとい彼,かれらが忘,わすれるようなことがあっても、わたしは、あなたを忘,わすれることはない。","tok":[["「"],["女","おんな"],["が"],["その"],["乳","ち"],["のみ"],["子","ご"],["を"],["忘て","わすれて"],["、"],["その"],["腹","はら"],["の"],["子","こ"],["を"],["、"],["あわれまない"],["よう"],["な"],["こと"],["が"],["あろう"],["か"],["。"],["たとい"],["彼","かれ"],["ら"],["が"],["忘る","わすれる"],["よう"],["な"],["こと"],["が"],["あって"],["も"],["、"],["わたし"],["は"],["、"],["あなた"],["を"],["忘る","わすれる"],["こと"],["は"],["ない"],["。"]]},{"verse":16,"text":"見,みよ、わたしは、たなごころにあなたを彫,ほり刻,きざんだ。あなたの石,いしがきは常,つねにわが前,まえにある。","tok":[["見よ","みよ"],["、"],["わたし"],["は"],["、"],["たなごころ"],["に"],["あなた"],["を"],["彫刻","ほりきざ"],["ん"],["だ"],["。"],["あなた"],["の"],["石がき","いしがき"],["は"],["常","つね"],["に"],["わが"],["前","まえ"],["に"],["ある"],["。"]]},{"verse":17,"text":"あなたを建,たてる者,ものは、あなたをこわす者,ものを追,おい越,こし、あなたを荒,あらした者,ものは、あなたから出,でて行,いく。","tok":[["あなた"],["を"],["建てる","たてる"],["者","もの"],["は"],["、"],["あなた"],["を"],["こわす"],["者","もの"],["を"],["追い","おい"],["越","こし"],["、"],["あなた"],["を"],["荒した","あらした"],["者","もの"],["は"],["、"],["あなた"],["から"],["出て","でて"],["行く","いく"],["。"]]},{"verse":18,"text":"あなたの目,めをあげて見,みまわせ。彼,かれらは皆,みな集,あつまって、あなたのもとに来,くる。主,しゅは言,いわれる、わたしは生,いきている、あなたは彼,かれらを皆,みな、飾,かざりとして身,みにつけ、花嫁,はなよめの帯,おびのようにこれを結,むすぶ。","tok":[["あなた"],["の"],["目","め"],["を"],["あげて"],["見まわせ","みまわせ"],["。"],["彼","かれ"],["ら"],["は"],["皆","みな"],["集まって","あつまって"],["、"],["あなた"],["の"],["もと"],["に"],["来る","くる"],["。"],["主","しゅ"],["は"],["言われる","いわれる"],["、"],["わたし"],["は"],["生きて","いきて"],["いる"],["、"],["あなた"],["は"],["彼","かれ"],["ら"],["を"],["皆","みな"],["、"],["飾","かざり"],["として"],["身","み"],["に"],["つけ"],["、"],["花嫁","はなよめ"],["の"],["帯","おび"],["の"],["よう"],["に"],["これ"],["を"],["結ぶ","むすぶ"],["。"]]},{"verse":19,"text":"あなたの荒,あれ、かつすたれた所,ところ、こわされた地,ちは、住,すむ人,ひとの多,おおいために狭,せまくなり、あなたを、のみつくした者,ものは、はるかに離,はなれ去,さる。","tok":[["あなた"],["の"],["荒れ","あれ"],["、"],["かつ"],["すたれた"],["所","ところ"],["、"],["こわされた"],["地","ち"],["は"],["、"],["住む","すむ"],["人","ひと"],["の"],["多い","おおい"],["ため"],["に"],["狭く","せまく"],["なり"],["、"],["あなた"],["を"],["、"],["のみ"],["つくした"],["者","もの"],["は"],["、"],["はるか"],["に"],["離れ去る","はなれさる"],["。"]]},{"verse":20,"text":"あなたが子,こを失,うしなった後,のちに生,うまれた子,こらは、なおあなたの耳,みみに言,いう、『この所,ところはわたしには狭,せますぎる、わたしのために住,すむべき所,ところを得,えさせよ』と。","tok":[["あなた"],["が"],["子","こ"],["を"],["失なった","うしなった"],["後","のち"],["に"],["生まれた","うまれた"],["子","こ"],["ら"],["は"],["、"],["なお"],["あなた"],["の"],["耳","みみ"],["に"],["言う","いう"],["、"],["『"],["この"],["所","ところ"],["は"],["わたし"],["に"],["は"],["狭","せま"],["すぎる"],["、"],["わたし"],["の"],["ため"],["に"],["住むべき","すむべき"],["所","ところ"],["を"],["得させよ","えさせよ"],["』"],["と"],["。"]]},{"verse":21,"text":"その時,ときあなたは心,こころのうちに言,いう、『だれがわたしのためにこれらの者,ものを産,うんだのか。わたしは子,こを失,うしなって、子,こをもたない。わたしは捕,とらわれ、かつ追,おいやられた。だれがこれらの者,ものを育,そだてたのか。見,みよ、わたしはひとり残,のこされた。これらの者,ものはどこから来,きたのか』と」。","tok":[["その"],["時","とき"],["あなた"],["は"],["心","こころ"],["の"],["うち"],["に"],["言う","いう"],["、"],["『"],["だれ"],["が"],["わたし"],["の"],["ため"],["に"],["これ"],["ら"],["の"],["者","もの"],["を"],["産","うんだ"],["の"],["か"],["。"],["わたし"],["は"],["子","こ"],["を"],["失なって","うしなって"],["、"],["子","こ"],["を"],["もたない"],["。"],["わたし"],["は"],["捕らわれ","とらわれ"],["、"],["かつ"],["追いやられた","おいやられた"],["。"],["だれ"],["が"],["これ"],["ら"],["の"],["者","もの"],["を"],["育てた","そだてた"],["の"],["か"],["。"],["見よ","みよ"],["、"],["わたし"],["は"],["ひとり"],["残された","のこされた"],["。"],["これ"],["ら"],["の"],["者","もの"],["は"],["どこ"],["から"],["来た","きた"],["の"],["か"],["』"],["と"],["」"],["。"]]},{"verse":22,"text":"主,しゅなる神,かみはこう言,いわれる、「見,みよ、わたしは手,てをもろもろの国,くににむかってあげ、旗,はたをもろもろの民,たみにむかって立,たてる。彼,かれらはそのふところにあなたの子,こらを携,たずさえ、その肩,かたにあなたの娘,むすめたちを載,のせて来,くる。","tok":[["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["「"],["見よ","みよ"],["、"],["わたし"],["は"],["手","て"],["を"],["もろもろ"],["の"],["国","くに"],["に"],["むかって"],["あげ"],["、"],["旗","はた"],["を"],["もろもろ"],["の"],["民","たみ"],["に"],["むかって"],["立る","たてる"],["。"],["彼","かれ"],["ら"],["は"],["その"],["ふところ"],["に"],["あなた"],["の"],["子","こ"],["ら"],["を"],["携え","たずさえ"],["、"],["その"],["肩","かた"],["に"],["あなた"],["の"],["娘","むすめ"],["たち"],["を"],["載せて","のせて"],["来る","くる"],["。"]]},{"verse":23,"text":"もろもろの王,おうは、あなたの養父,ようふとなり、その王妃,おうひたちは、あなたの乳母,うばとなり、彼,かれらはその顔,かおを地,ちにつけて、あなたにひれ伏,ふし、あなたの足,あしのちりをなめる。こうして、あなたはわたしが主,しゅであることを知,しる。わたしを待,まち望,のぞむ者,ものは恥,はじをこうむることがない」。","tok":[["もろもろ"],["の"],["王","おう"],["は"],["、"],["あなた"],["の"],["養父","ようふ"],["と"],["なり"],["、"],["その"],["王妃","おうひ"],["たち"],["は"],["、"],["あなた"],["の"],["乳母","うば"],["と"],["なり"],["、"],["彼","かれ"],["ら"],["は"],["その"],["顔","かお"],["を"],["地","ち"],["に"],["つけて"],["、"],["あなた"],["に"],["ひれ伏し","ひれふし"],["、"],["あなた"],["の"],["足","あし"],["の"],["ちり"],["を"],["なめる"],["。"],["こう"],["して"],["、"],["あなた"],["は"],["わたし"],["が"],["主","しゅ"],["で"],["ある"],["こと"],["を"],["知る","しる"],["。"],["わたし"],["を"],["待ち望む","まちのぞむ"],["者","もの"],["は"],["恥","はじ"],["を"],["こうむる"],["こと"],["が"],["ない"],["」"],["。"]]},{"verse":24,"text":"勇士,ゆうしが奪,うばった獲物,えものをどうして取,とり返,かえすことができようか。暴君,ぼうくんがかすめた捕虜,ほりょをどうして救,すくい出,だすことができようか。","tok":[["勇士","ゆうし"],["が"],["奪った","うばった"],["獲物","えもの"],["を"],["どう"],["して"],["取","とり"],["返えす","かえす"],["こと"],["が"],["できよう"],["か"],["。"],["暴君","ぼうくん"],["が"],["かすめた"],["捕虜","ほりょ"],["を"],["どう"],["して"],["救い出す","すくいだす"],["こと"],["が"],["できよう"],["か"],["。"]]},{"verse":25,"text":"しかし主,しゅはこう言,いわれる、「勇士,ゆうしがかすめた捕虜,ほりょも取,とり返,かえされ、暴君,ぼうくんが奪,うばった獲物,えものも救,すくい出,だされる。わたしはあなたと争,あらそう者,ものと争,あらそい、あなたの子,こらを救,すくうからである。","tok":[["しかし"],["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["「"],["勇士","ゆうし"],["が"],["かすめた"],["捕虜","ほりょ"],["も"],["取","とり"],["返えされ","かえされ"],["、"],["暴君","ぼうくん"],["が"],["奪った","うばった"],["獲物","えもの"],["も"],["救い出される","すくいだされる"],["。"],["わたし"],["は"],["あなた"],["と"],["争う","あらそう"],["者","もの"],["と"],["争い","あらそい"],["、"],["あなた"],["の"],["子","こ"],["ら"],["を"],["救う","すくう"],["から"],["で"],["ある"],["。"]]},{"verse":26,"text":"わたしはあなたをしえたげる者,ものにその肉,にくを食,くわせ、その血,ちを新,あたらしい酒,さけのように飲,のませて酔,よわせる。こうして、すべての人,ひとはわたしが主,しゅであって、あなたの救主,すくいぬし、またあなたのあがない主,しゅ、ヤコブの全能者,ぜんのうしゃであることを知,しるようになる」。","tok":[["わたし"],["は"],["あなた"],["を"],["し"],["えたげる"],["者","もの"],["に"],["その"],["肉","にく"],["を"],["食わせ","くわせ"],["、"],["その"],["血","ち"],["を"],["新らしい","あたらしい"],["酒","さけ"],["の"],["よう"],["に"],["飲ませて","のませて"],["酔わせる","よわせる"],["。"],["こう"],["して"],["、"],["すべて"],["の"],["人","ひと"],["は"],["わたし"],["が"],["主","しゅ"],["で"],["あって"],["、"],["あなた"],["の"],["救主","す"],["くいぬ"],["し"],["、"],["また"],["あなた"],["の"],["あがない"],["主","しゅ"],["、"],["ヤコブ"],["の"],["全能者","ぜんのうしゃ"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["」"],["。"]]}]
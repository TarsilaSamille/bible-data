[{"verse":1,"text":"しかし、わがしもべヤコブよ、わたしが選,えらんだイスラエルよ、いま聞,きけ。","tok":[["しかし"],["、"],["わが"],["しもべ"],["ヤコブ"],["よ"],["、"],["わたし"],["が"],["選らんだ","えらんだ"],["イスラエル"],["よ"],["、"],["いま"],["聞け","きけ"],["。"]]},{"verse":2,"text":"あなたを造,つくり、あなたを胎内,たいないに形,かたち造,つくり、あなたを助,たすける主,しゅはこう言,いわれる、『わがしもべヤコブよ、わたしが選,えらんだエシュルンよ、恐,おそれるな。","tok":[["あなた"],["を"],["造","つくり"],["、"],["あなた"],["を"],["胎内","たいない"],["に"],["形造","かたちつくり"],["、"],["あなた"],["を"],["助ける","たすける"],["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["『"],["わが"],["しもべ"],["ヤコブ"],["よ"],["、"],["わたし"],["が"],["選らんだ","えらんだ"],["エシュルン"],["よ"],["、"],["恐れる","おそれる"],["な"],["。"]]},{"verse":3,"text":"わたしは、かわいた地,ちに水,みずを注,そそぎ、干,ひからびた地,ちに流,ながれをそそぎ、わが霊,れいをあなたの子,こらにそそぎ、わが恵,めぐみをあなたの子孫,しそんに与,あたえるからである。","tok":[["わたし"],["は"],["、"],["かわいた"],["地","ち"],["に"],["水","みず"],["を"],["注ぎ","そそぎ"],["、"],["干からびた","ひからびた"],["地","ち"],["に"],["流れ","ながれ"],["を"],["そそぎ"],["、"],["わが"],["霊","れい"],["を"],["あなた"],["の"],["子","こ"],["ら"],["に"],["そそぎ"],["、"],["わが"],["恵","めぐみ"],["を"],["あなた"],["の"],["子孫","しそん"],["に"],["与える","あたえる"],["から"],["で"],["ある"],["。"]]},{"verse":4,"text":"こうして、彼,かれらは水,みずの中,なかの草,くさのように、流,ながれのほとりの柳,やなぎのように、生,はえ育,そだつ。","tok":[["こう"],["して"],["、"],["彼","かれ"],["ら"],["は"],["水","みず"],["の"],["中","なか"],["の"],["草","くさ"],["の"],["よう"],["に"],["、"],["流れ","ながれ"],["の"],["ほとり"],["の"],["柳","やなぎ"],["の"],["よう"],["に"],["、"],["生え","はえ"],["育つ","そだつ"],["。"]]},{"verse":5,"text":"ある人,ひとは「わたしは主,しゅのものである」と言,いい、ある人,ひとはヤコブの名,なをもって自分,じぶんを呼,よび、またある人,ひとは「主,しゅのものである」と手,てにしるして、イスラエルの名,なをもって自分,じぶんを呼,よぶ』」。","tok":[["ある"],["人","ひと"],["は"],["「"],["わたし"],["は"],["主","しゅ"],["の"],["もの"],["で"],["ある"],["」"],["と"],["言い","いい"],["、"],["ある"],["人","ひと"],["は"],["ヤコブ"],["の"],["名","な"],["を"],["もって"],["自分","じぶん"],["を"],["呼び","よび"],["、"],["また"],["ある"],["人","ひと"],["は"],["「"],["主","しゅ"],["の"],["もの"],["で"],["ある"],["」"],["と"],["手","て"],["に"],["しるして"],["、"],["イスラエル"],["の"],["名","な"],["を"],["もって"],["自分","じぶん"],["を"],["呼ぶ","よぶ"],["』"],["」"],["。"]]},{"verse":6,"text":"主,しゅ、イスラエルの王,おう、イスラエルをあがなう者,もの、万軍,ばんぐんの主,しゅはこう言,いわれる、「わたしは初,はじめであり、わたしは終,おわりである。わたしのほかに神,かみはない。","tok":[["主","しゅ"],["、"],["イスラエル"],["の"],["王","おう"],["、"],["イスラエル"],["を"],["あがなう"],["者","もの"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["「"],["わたし"],["は"],["初め","はじめ"],["で"],["あり"],["、"],["わたし"],["は"],["終","おわり"],["で"],["ある"],["。"],["わたし"],["の"],["ほか"],["に"],["神","かみ"],["は"],["ない"],["。"]]},{"verse":7,"text":"だれかわたしに等,ひとしい者,ものがあるか。その者,ものはそれを示,しめし、またそれを告,つげ、わが前,まえに言,いいつらねよ。だれが、昔,むかしから、きたるべき事,ことを聞,きかせたか。その者,ものはやがて成,なるべき事,ことをわれわれに告,つげよ。","tok":[["だれ"],["か"],["わたし"],["に"],["等い","ひとしい"],["者","もの"],["が"],["ある"],["か"],["。"],["その"],["者","もの"],["は"],["それ"],["を"],["示めし","しめし"],["、"],["また"],["それ"],["を"],["告","つげ"],["、"],["わが"],["前","まえ"],["に"],["言いつらね","いいつらね"],["よ"],["。"],["だれ"],["が"],["、"],["昔","むかし"],["から"],["、"],["きたるべき"],["事","こと"],["を"],["聞かせた","きかせた"],["か"],["。"],["その"],["者","もの"],["は"],["やがて"],["成るべき","なるべき"],["事","こと"],["を"],["われわれ"],["に"],["告","つげ"],["よ"],["。"]]},{"verse":8,"text":"恐,おそれてはならない、またおののいてはならない。わたしはこの事,ことを昔,むかしから、あなたがたに聞,きかせなかったか、また告,つげなかったか。あなたがたはわが証人,しょうにんである。わたしのほかに神,かみがあるか。わたしのほかに岩,いわはない。わたしはそのあることを知,しらない」。","tok":[["恐れて","おそれて"],["は"],["ならない"],["、"],["また"],["おののいて"],["は"],["ならない"],["。"],["わたし"],["は"],["この"],["事","こと"],["を"],["昔","むかし"],["から"],["、"],["あなた"],["がた"],["に"],["聞かせなかった","きかせなかった"],["か"],["、"],["また"],["告","つげ"],["なかった"],["か"],["。"],["あなた"],["がた"],["は"],["わが"],["証人","しょうにん"],["で"],["ある"],["。"],["わたし"],["の"],["ほか"],["に"],["神","かみ"],["が"],["ある"],["か"],["。"],["わたし"],["の"],["ほか"],["に"],["岩","いわ"],["は"],["ない"],["。"],["わたし"],["は"],["その"],["ある"],["こと"],["を"],["知らない","しらない"],["」"],["。"]]},{"verse":9,"text":"偶像,ぐうぞうを造,つくる者,ものは皆,みなむなしく、彼,かれらの喜,よろこぶところのものは、なんの役,やくにも立,たたない。その信者,しんじゃは見,みることもなく、また知,しることもない。ゆえに彼,かれらは恥,はじを受,うける。","tok":[["偶像","ぐうぞう"],["を"],["造る","つくる"],["者","もの"],["は"],["皆","みな"],["むなしく"],["、"],["彼","かれ"],["ら"],["の"],["喜こぶ","よろこぶ"],["ところ"],["の"],["もの"],["は"],["、"],["なん"],["の"],["役","やく"],["に"],["も"],["立たない","たたない"],["。"],["その"],["信者","しんじゃ"],["は"],["見る","みる"],["こと"],["も"],["なく"],["、"],["また"],["知る","しる"],["こと"],["も"],["ない"],["。"],["ゆえ"],["に"],["彼","かれ"],["ら"],["は"],["恥","はじ"],["を"],["受る","うける"],["。"]]},{"verse":10,"text":"だれが神,かみを造,つくり、またなんの役,やくにも立,たたない偶像,ぐうぞうを鋳,いたか。","tok":[["だれ"],["が"],["神","かみ"],["を"],["造","つくり"],["、"],["また"],["なん"],["の"],["役","やく"],["に"],["も"],["立たない","たたない"],["偶像","ぐうぞう"],["を"],["鋳た","いた"],["か"],["。"]]},{"verse":11,"text":"見,みよ、その仲間,なかまは皆,みな恥,はじを受,うける。その細工人,さいくにんらは人間,にんげんにすぎない。彼,かれらが皆,みな集,あつまって立,たつとき、恐,おそれて共,ともに恥,はじる。","tok":[["見よ","みよ"],["、"],["その"],["仲間","なかま"],["は"],["皆","みな"],["恥","はじ"],["を"],["受る","うける"],["。"],["その"],["細工人","さいくにん"],["ら"],["は"],["人間","にんげん"],["に"],["すぎない"],["。"],["彼","かれ"],["ら"],["が"],["皆","みな"],["集まって","あつまって"],["立つ","たつ"],["とき"],["、"],["恐れて","おそれて"],["共","とも"],["に"],["恥","はじ"],["る"],["。"]]},{"verse":12,"text":"鉄,てつの細工人,さいくにんはこれを造,つくるのに炭,すみの火,ひをもって細工,さいくし、鎚,つちをもってこれを造,つくり、強,つよい腕,うでをもってこれを鍛,きたえる。彼,かれが飢,うえれば力,ちからは衰,おとろえ、水,みずを飲,のまなければ疲,つかれはてる。","tok":[["鉄","てつ"],["の"],["細工人","さいくにん"],["は"],["これ"],["を"],["造る","つくる"],["のに"],["炭","すみ"],["の"],["火","ひ"],["を"],["もって"],["細工","さいく"],["し"],["、"],["鎚","つち"],["を"],["もって"],["これ"],["を"],["造","つくり"],["、"],["強い","つよい"],["腕","うで"],["を"],["もって"],["これ"],["を"],["鍛","きたえ"],["る"],["。"],["彼","かれ"],["が"],["飢","うえ"],["れば"],["力","ちから"],["は"],["衰え","おとろえ"],["、"],["水","みず"],["を"],["飲まなければ","のまなければ"],["疲れ","つかれ"],["はてる"],["。"]]},{"verse":13,"text":"木,きの細工人,さいくにんは線,せんを引,ひき、鉛筆,えんぴつでえがき、かんなで削,けずり、コンパスでえがき、それを人,ひとの美,うつくしい姿,すがたにしたがって人,ひとの形,かたちに造,つくり、家,いえの中,なかに安置,あんちする。","tok":[["木","き"],["の"],["細工人","さいくにん"],["は"],["線","せん"],["を"],["引","ひき"],["、"],["鉛筆","えんぴつ"],["で"],["えがき"],["、"],["かんな"],["で"],["削り","けずり"],["、"],["コンパス"],["で"],["えがき"],["、"],["それ"],["を"],["人","ひと"],["の"],["美しい","うつくしい"],["姿","すがた"],["に"],["したがって"],["人","ひと"],["の"],["形","かたち"],["に"],["造","つくり"],["、"],["家","いえ"],["の"],["中","なか"],["に"],["安置","あんち"],["する"],["。"]]},{"verse":14,"text":"彼,かれは香柏,こうはくを切,きり倒,たおし、あるいはかしの木,き、あるいはかしわの木,きを選,えらんで、それを林,はやしの木,きの中,なかで強,つよく育,そだてる。あるいは香柏,こうはくを植,うえ、雨,あめにそれを育,そだてさせる。","tok":[["彼","かれ"],["は"],["香","こう"],["柏","かしわ"],["を"],["切り倒し","きりたおし"],["、"],["あるいは"],["かし"],["の"],["木","き"],["、"],["あるいは"],["かしわ"],["の"],["木","き"],["を"],["選らんで","えらんで"],["、"],["それ"],["を"],["林","はやし"],["の"],["木","き"],["の"],["中","なか"],["で"],["強く","つよく"],["育てる","そだてる"],["。"],["あるいは"],["香","こう"],["柏","かしわ"],["を"],["植え","うえ"],["、"],["雨","あめ"],["に"],["それ"],["を"],["育てさせる","そだてさせる"],["。"]]},{"verse":15,"text":"こうして人,ひとはその一部,いちぶをとって、たきぎとし、これをもって身,みを暖,あたため、またこれを燃,もやしてパンを焼,やき、また他,たの一部,いちぶを神,かみに造,つくって拝,おがみ、刻,きざんだ像,ぞうに造,つくってその前,まえにひれ伏,ふす。","tok":[["こう"],["して"],["人","ひと"],["は"],["その"],["一部","いちぶ"],["を"],["とって"],["、"],["たきぎ"],["と"],["し"],["、"],["これ"],["を"],["もって"],["身","み"],["を"],["暖め","あたため"],["、"],["また"],["これ"],["を"],["燃やして","もやして"],["パン"],["を"],["焼き","やき"],["、"],["また"],["他","た"],["の"],["一部","いちぶ"],["を"],["神","かみ"],["に"],["造って","つくって"],["拝み","おがみ"],["、"],["刻","き"],["ざ"],["ん"],["だ"],["像","ぞう"],["に"],["造って","つくって"],["その"],["前","まえ"],["に"],["ひれ伏す","ひれふす"],["。"]]},{"verse":16,"text":"その半,なかばは火,ひに燃,もやし、その半,なかばで肉,にくを煮,にて食,たべ、あるいは肉,にくをあぶって食,たべ飽,あき、また身,みを暖,あたためて言,いう、「ああ、暖,あたたまった、熱,あつくなった」と。","tok":[["その"],["半ば","なかば"],["は"],["火","ひ"],["に"],["燃やし","もやし"],["、"],["その"],["半ば","なかば"],["で"],["肉","にく"],["を"],["煮て","にて"],["食べ","たべ"],["、"],["あるいは"],["肉","にく"],["を"],["あぶって"],["食べ飽き","たべあき"],["、"],["また"],["身","み"],["を"],["暖めて","あたためて"],["言う","いう"],["、"],["「"],["ああ"],["、"],["暖まった","あたたまった"],["、"],["熱く","あつく"],["なった"],["」"],["と"],["。"]]},{"verse":17,"text":"そしてその余,あまりをもって神,かみを造,つくって偶像,ぐうぞうとし、その前,まえにひれ伏,ふして拝,おがみ、これに祈,いのって、「あなたはわが神,かみだ、わたしを救,すくえ」と言,いう。","tok":[["そして"],["その"],["余","あまり"],["を"],["もって"],["神","かみ"],["を"],["造って","つくって"],["偶像","ぐうぞう"],["と"],["し"],["、"],["その"],["前","まえ"],["に"],["ひれ伏して","ひれふして"],["拝み","おがみ"],["、"],["これ"],["に"],["祈って","いのって"],["、"],["「"],["あなた"],["は"],["わが"],["神","かみ"],["だ"],["、"],["わたし"],["を"],["救え","すくえ"],["」"],["と"],["言う","いう"],["。"]]},{"verse":18,"text":"これらの人,ひとは知,しることがなく、また悟,さとることがない。その目,めはふさがれて見,みることができず、その心,こころは鈍,にぶくなって悟,さとることができない。","tok":[["これ"],["ら"],["の"],["人","ひと"],["は"],["知る","しる"],["こと"],["が"],["なく"],["、"],["また"],["悟","さとる"],["こと"],["が"],["ない"],["。"],["その"],["目","め"],["は"],["ふさがれて"],["見る","みる"],["こと"],["が"],["できず"],["、"],["その"],["心","こころ"],["は"],["鈍く","にぶく"],["なって"],["悟","さとる"],["こと"],["が"],["できない"],["。"]]},{"verse":19,"text":"その心,こころのうちに思,おもうことをせず、また知識,ちしきがなく、悟,さとりがないために、「わたしはその半,なかばを火,ひに燃,もやし、またその炭火,すみびの上,うえでパンを焼,やき、肉,にくをあぶって食,たべ、その残,のこりの木,きをもって憎,にくむべきものを造,つくるのか。木,きのはしくれの前,まえにひれ伏,ふすのか」と言,いう者,ものもない。","tok":[["その"],["心","こころ"],["の"],["うち"],["に"],["思う","おもう"],["こと"],["を"],["せず"],["、"],["また"],["知識","ちしき"],["が"],["なく"],["、"],["悟り","さとり"],["が"],["ない"],["ため"],["に"],["、"],["「"],["わたし"],["は"],["その"],["半ば","なかば"],["を"],["火","ひ"],["に"],["燃やし","もやし"],["、"],["また"],["その"],["炭火","すみび"],["の"],["上","うえ"],["で"],["パン"],["を"],["焼き","やき"],["、"],["肉","にく"],["を"],["あぶって"],["食べ","たべ"],["、"],["その"],["残り","のこり"],["の"],["木","き"],["を"],["もって"],["憎むべき","にくむべき"],["もの"],["を"],["造る","つくる"],["の"],["か"],["。"],["木","き"],["の"],["はしくれ"],["の"],["前","まえ"],["に"],["ひれ伏す","ひれふす"],["の"],["か"],["」"],["と"],["言う","いう"],["者","もの"],["も"],["ない"],["。"]]},{"verse":20,"text":"彼,かれは灰,はいを食,くい、迷,まよった心,こころに惑,まどわされて、おのれを救,すくうことができず、また「わが右,みぎの手,てに偽,いつわりがあるではないか」と言,いわない。","tok":[["彼","かれ"],["は"],["灰","はい"],["を"],["食い","くい"],["、"],["迷った","まよった"],["心","こころ"],["に"],["惑わされて","まどわされて"],["、"],["おのれ"],["を"],["救う","すくう"],["こと"],["が"],["できず"],["、"],["また"],["「"],["わが"],["右","みぎ"],["の"],["手","て"],["に"],["偽り","いつわり"],["が"],["ある"],["で"],["は"],["ない"],["か"],["」"],["と"],["言わない","いわない"],["。"]]},{"verse":21,"text":"ヤコブよ、イスラエルよ、これらの事,ことを心,こころにとめよ。あなたはわがしもべだから。わたしはあなたを造,つくった、あなたはわがしもべだ。イスラエルよ、わたしはあなたを忘,わすれない。","tok":[["ヤコブ"],["よ"],["、"],["イスラエル"],["よ"],["、"],["これ"],["ら"],["の"],["事","こと"],["を"],["心","こころ"],["に"],["とめよ"],["。"],["あなた"],["は"],["わが"],["しもべ"],["だ"],["から"],["。"],["わたし"],["は"],["あなた"],["を"],["造った","つくった"],["、"],["あなた"],["は"],["わが"],["しもべ"],["だ"],["。"],["イスラエル"],["よ"],["、"],["わたし"],["は"],["あなた"],["を"],["忘ない","わすれない"],["。"]]},{"verse":22,"text":"わたしはあなたのとがを雲,くものように吹,ふき払,はらい、あなたの罪,つみを霧,きりのように消,けした。わたしに立,たち返,かえれ、わたしはあなたをあがなったから。","tok":[["わたし"],["は"],["あなた"],["の"],["とが"],["を"],["雲","くも"],["の"],["よう"],["に"],["吹","ふき"],["払","はらい"],["、"],["あなた"],["の"],["罪","つみ"],["を"],["霧","きり"],["の"],["よう"],["に"],["消した","けした"],["。"],["わたし"],["に"],["立ち返れ","たちかえれ"],["、"],["わたし"],["は"],["あなた"],["を"],["あがなった"],["から"],["。"]]},{"verse":23,"text":"天,てんよ、歌,うたえ、主,しゅがこの事,ことをなされたから。地,ちの深,ふかき所,ところよ、呼,よばわれ。もろもろの山,やまよ、林,はやしおよびその中,なかのもろもろの木,きよ、声,こえを放,はなって歌,うたえ。主,しゅはヤコブをあがない、イスラエルのうちに栄光,えいこうをあらわされたから。","tok":[["天","てん"],["よ"],["、"],["歌え","うたえ"],["、"],["主","しゅがこ"],["の"],["事","こと"],["を"],["なされた"],["から"],["。"],["地","ち"],["の"],["深き","ふかき"],["所","ところ"],["よ"],["、"],["呼ばわれ","よばわれ"],["。"],["もろもろ"],["の"],["山","やま"],["よ"],["、"],["林","はやし"],["および"],["その"],["中","なか"],["の"],["もろもろ"],["の"],["木","き"],["よ"],["、"],["声","こえ"],["を"],["放って","はなって"],["歌え","うたえ"],["。"],["主","しゅ"],["は"],["ヤコブ"],["を"],["あがない"],["、"],["イスラエル"],["の"],["うち"],["に"],["栄光","えいこう"],["を"],["あらわされた"],["から"],["。"]]},{"verse":24,"text":"あなたをあがない、あなたを胎内,たいないに造,つくられた主,しゅはこう言,いわれる、「わたしは主,しゅである。わたしはよろずの物,ものを造,つくり、ただわたしだけが天,てんをのべ、地,ちをひらき、――だれがわたしと共,ともにいたか――","tok":[["あなた"],["を"],["あがない"],["、"],["あなた"],["を"],["胎内","たいない"],["に"],["造られた","つくられた"],["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["「"],["わたし"],["は"],["主","しゅ"],["で"],["ある"],["。"],["わたし"],["は"],["よろず"],["の"],["物","もの"],["を"],["造","つくり"],["、"],["ただ"],["わたし"],["だけ"],["が"],["天","てん"],["を"],["のべ"],["、"],["地","ち"],["を"],["ひらき"],["、"],["―"],["―"],["だれ"],["が"],["わたし"],["と"],["共","とも"],["に"],["いた"],["か"],["―"],["―"]]},{"verse":25,"text":"偽,いつわる物,もののしるしをむなしくし、占,うらなう者,ものを狂,くるわせ、賢,かしこい者,ものをうしろに退,しりぞけて、その知識,ちしきを愚,おろかにする。","tok":[["偽わる","いつわる"],["物","もの"],["の"],["しるし"],["を"],["むなしく"],["し"],["、"],["占う","うらなう"],["者","もの"],["を"],["狂わせ","くるわせ"],["、"],["賢しこい","かしこい"],["者","もの"],["を"],["うしろ"],["に"],["退ぞけて","しりぞけて"],["、"],["その"],["知識","ちしき"],["を"],["愚か","おろか"],["に"],["する"],["。"]]},{"verse":26,"text":"わたしは、わがしもべの言葉,ことばを遂,とげさせ、わが使,つかいの計,はかりごとを成,ならせ、エルサレムについては、『これは民,たみの住,すむ所,ところとなる』と言,いい、ユダのもろもろの町,まちについては、『ふたたび建,たてられる、わたしはその荒,あれ跡,あとを興,おこそう』と言,いい、","tok":[["わたし"],["は"],["、"],["わが"],["しもべ"],["の"],["言葉","ことば"],["を"],["遂げさせ","とげさせ"],["、"],["わが"],["使","つかい"],["の"],["計り","はかり"],["ごと"],["を"],["成らせ","ならせ"],["、"],["エルサレム"],["について"],["は"],["、"],["『"],["これ"],["は"],["民","たみ"],["の"],["住む","すむ"],["所","ところ"],["と"],["なる"],["』"],["と"],["言い","いい"],["、"],["ユダ"],["の"],["もろもろ"],["の"],["町","まち"],["について"],["は"],["、"],["『"],["ふたたび"],["建てられる","たてられる"],["、"],["わたし"],["は"],["その"],["荒れ","あれ"],["跡","あと"],["を"],["興そう","おこそう"],["』"],["と"],["言い","いい"],["、"]]},{"verse":27,"text":"また淵,ふちについては、『かわけ、わたしはあなたのもろもろの川,かわを干,ほす』と言,いい、","tok":[["また"],["淵","ふち"],["について"],["は"],["、"],["『"],["かわけ"],["、"],["わたし"],["は"],["あなた"],["の"],["もろもろ"],["の"],["川","かわ"],["を"],["干す","ほす"],["』"],["と"],["言い","いい"],["、"]]},{"verse":28,"text":"またクロスについては、『彼,かれはわが牧者,ぼくしゃ、わが目的,もくてきをことごとくなし遂,とげる』と言,いい、エルサレムについては、『ふたたび建,たてられる』と言,いい、神殿,しんでんについては、『あなたの基,もといがすえられる』と言,いう」。","tok":[["また"],["クロス"],["について"],["は"],["、"],["『"],["彼","かれ"],["は"],["わが"],["牧者","ぼくしゃ"],["、"],["わが"],["目的","もくてき"],["を"],["ことごとく"],["なし遂げる","なしとげる"],["』"],["と"],["言い","いい"],["、"],["エルサレム"],["について"],["は"],["、"],["『"],["ふたたび"],["建てられる","たてられる"],["』"],["と"],["言い","いい"],["、"],["神殿","しんでん"],["について"],["は"],["、"],["『"],["あなた"],["の"],["基い","もとい"],["が"],["すえられる"],["』"],["と"],["言う","いう"],["」"],["。"]]}]
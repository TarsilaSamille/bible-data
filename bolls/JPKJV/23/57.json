[{"verse":1,"text":"正,ただしい者,ものが滅,ほろびても、心,こころにとめる人,ひとがなく、神,かみを敬,うやまう人々,ひとびとが取,とり去,さられても、悟,さとる者,ものはない。正,ただしい者,ものは災,わざわいの前,まえに取,とり去,さられて、","tok":[["正い","ただしい"],["者","もの"],["が"],["滅びて","ほろびて"],["も"],["、"],["心","こころ"],["に"],["とめる"],["人","ひと"],["が"],["なく"],["、"],["神","かみ"],["を"],["敬う","うやまう"],["人々","ひとびと"],["が"],["取去られて","とりさられて"],["も"],["、"],["悟者","さとるもの"],["は"],["ない"],["。"],["正い","ただしい"],["者","もの"],["は"],["災","わざわい"],["の"],["前","まえ"],["に"],["取去られて","とりさられて"],["、"]]},{"verse":2,"text":"平安,へいあんに入,いるからである。すべて正直,しょうじきに歩,あゆむ者,ものは、その床,とこに休,やすむことができる。","tok":[["平安","へいあん"],["に"],["入らで","いるからで"],["ある"],["。"],["すべて"],["正直","しょうじき"],["に"],["歩む","あゆむ"],["者","もの"],["は"],["、"],["その"],["床","とこ"],["に"],["休む","やすむ"],["こと"],["が"],["できる"],["。"]]},{"verse":3,"text":"しかし、あなたがた女,おんな魔法使,まほうつかいの子,こよ、姦夫,かんぷと遊女,ゆうじょのすえよ、こちらへ近寄,ちかよれ。","tok":[["しかし"],["、"],["あなた"],["がた"],["女","おんな"],["魔法","まほう"],["使い","つかい"],["の"],["子","こ"],["よ"],["、"],["姦夫","かんぷ"],["と"],["遊女","ゆうじょ"],["の"],["すえ"],["よ"],["、"],["こちら"],["へ"],["近寄れ","ちかよれ"],["。"]]},{"verse":4,"text":"あなたがたは、だれにむかって戯,ざれをなすのか。だれにむかって口,くちを開,ひらき、舌,したを出,だすのか。あなたがたは背信,はいしんの子,こら、偽,いつわりのすえではないか。","tok":[["あなた"],["がた"],["は"],["、"],["だれ"],["に"],["むかって"],["戯","ざれ"],["を"],["なす"],["の"],["か"],["。"],["だれ"],["に"],["むかって"],["口","くち"],["を"],["開らき","ひらき"],["、"],["舌","した"],["を"],["出す","だす"],["の"],["か"],["。"],["あなた"],["がた"],["は"],["背信","はいしん"],["の"],["子","こ"],["ら"],["、"],["偽わり","いつわり"],["の"],["すえ"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":5,"text":"あなたがたは、かしの木,きの間,あいだ、すべての青,あお木,きの下,したで心,こころをこがし、谷,たにの中,なか、岩,いわのはざまで子,こどもを殺,ころした。","tok":[["あなた"],["がた"],["は"],["、"],["かし"],["の"],["木の間","きのあ"],["い"],["だ"],["、"],["すべて"],["の"],["青木","あおき"],["の"],["下","した"],["で"],["心","こころ"],["を"],["こがし"],["、"],["谷","たに"],["の"],["中","なか"],["、"],["岩","いわ"],["の"],["はざま"],["で"],["子ども","こども"],["を"],["殺ろした","ころした"],["。"]]},{"verse":6,"text":"あなたは谷,たにのなめらかな石,いしを自分,じぶんの嗣,し業,ぎょうとし、これを自分,じぶんの分,わけ前,まえとし、これに灌祭,かんさいをそそぎ、供,そなえ物,ものをささげた。わたしはこれらの物,ものによってなだめられようか。","tok":[["あなた"],["は"],["谷","たに"],["の"],["なめらか"],["な"],["石","いし"],["を"],["自分","じぶん"],["の"],["嗣業","しぎょ"],["う"],["と"],["し"],["、"],["これ"],["を"],["自分","じぶん"],["の"],["分け前","わけまえ"],["と"],["し"],["、"],["これ"],["に"],["灌祭","かんさい"],["を"],["そそぎ"],["、"],["供え物","そなえもの"],["を"],["ささげた"],["。"],["わたし"],["は"],["これ"],["ら"],["の"],["物","もの"],["によって"],["なだめられよう"],["か"],["。"]]},{"verse":7,"text":"あなたは高,たかくそびえた山,やまの上,うえに自分,じぶんの床,とこを設,もうけ、またそこに登,のぼって行,いって犠牲,ぎせいをささげた。","tok":[["あなた"],["は"],["高かく","たかく"],["そびえた"],["山","やま"],["の"],["上","うえ"],["に"],["自分","じぶん"],["の"],["床","とこ"],["を"],["設け","もうけ"],["、"],["また"],["そこ"],["に"],["登って","のぼって"],["行って","いって"],["犠牲","ぎせい"],["を"],["ささげた"],["。"]]},{"verse":8,"text":"また戸,とおよび柱,はしらのうしろに、あなたのしるしを置,おいた。あなたはわたしを離,はなれて自分,じぶんの床,とこをあらわし、それにのぼって、その床,とこをひろくした。また彼,かれらと契約,けいやくをなし、彼,かれらの床,とこを愛,あいし、その裸,はだかを見,みた。","tok":[["また"],["戸","と"],["および"],["柱","はしら"],["の"],["うしろ"],["に"],["、"],["あなた"],["の"],["しるし"],["を"],["置いた","おいた"],["。"],["あなた"],["は"],["わたし"],["を"],["離れて","はなれて"],["自分","じぶん"],["の"],["床","とこ"],["を"],["あらわし"],["、"],["それ"],["に"],["のぼって"],["、"],["その"],["床","とこ"],["を"],["ひろく"],["した"],["。"],["また"],["彼","かれ"],["ら"],["と"],["契約","けいやく"],["を"],["なし"],["、"],["彼","かれ"],["ら"],["の"],["床","とこ"],["を"],["愛し","あいし"],["、"],["その"],["裸","はだか"],["を"],["見た","みた"],["。"]]},{"verse":9,"text":"あなたは、におい油,あぶらを携,たずさえてモレクに行,いき、多,おおくのかおり物,ものをささげた。またあなたの使者,ししゃを遠,とおくにつかわし、陰府,よみの深,ふかい所,ところにまでつかわした。","tok":[["あなた"],["は"],["、"],["におい"],["油","あぶら"],["を"],["携えて","たずさえて"],["モレク"],["に"],["行き","いき"],["、"],["多く","おおく"],["の"],["かおり"],["物","もの"],["を"],["ささげた"],["。"],["また"],["あなた"],["の"],["使者","ししゃ"],["を"],["遠く","とおく"],["に"],["つかわし"],["、"],["陰府","よみ"],["の"],["深い","ふかい"],["所","ところ"],["に"],["まで"],["つかわした"],["。"]]},{"verse":10,"text":"あなたは道,みちの長,ながいのに疲,つかれても、なお「望,のぞみがない」とは言,いわなかった。あなたはおのが力,ちからの回復,かいふくを得,えたので、衰,おとろえることがなかった。","tok":[["あなた"],["は"],["道","みち"],["の"],["長い","ながい"],["のに"],["疲れて","つかれて"],["も"],["、"],["なお"],["「"],["望み","のぞみ"],["が"],["ない"],["」"],["と"],["は"],["言わなかった","いわなかった"],["。"],["あなた"],["は"],["お"],["の"],["が"],["力","ちから"],["の"],["回復","かいふく"],["を"],["得た","えた"],["ので"],["、"],["衰える","おとろえる"],["こと"],["が"],["なかった"],["。"]]},{"verse":11,"text":"あなたはだれをおじ恐,おそれて、偽,いつわりを言,いい、わたしを覚,おぼえず、また心,こころにおかなかったのか。わたしが久,ひさしく黙,だまっていたために、あなたはわたしを恐,おそれなかったのではなかったか。","tok":[["あなた"],["は"],["だれ"],["を"],["おじ恐れて","おじおそれて"],["、"],["偽り","いつわり"],["を"],["言い","いい"],["、"],["わたし"],["を"],["覚えず","おぼえず"],["、"],["また"],["心","こころ"],["に"],["おかなかった"],["の"],["か"],["。"],["わたし"],["が"],["久く","ひさしく"],["黙って","だまって"],["いた"],["ため"],["に"],["、"],["あなた"],["は"],["わたし"],["を"],["恐れなかった","おそれなかった"],["ので"],["は"],["なかった"],["か"],["。"]]},{"verse":12,"text":"わたしはあなたの義,ぎと、あなたのわざを告,つげ示,しめそう、しかしこれらはあなたを益,えきしない。","tok":[["わたし"],["は"],["あなた"],["の"],["義","ぎ"],["と"],["、"],["あなた"],["の"],["わざ"],["を"],["告","つげ"],["示めそう","しめそう"],["、"],["しかし"],["これ"],["ら"],["は"],["あなた"],["を"],["益しない","えきしない"],["。"]]},{"verse":13,"text":"あなたが呼,よばわる時,とき、あなたが集,あつめておいた偶像,ぐうぞうにあなたを救,すくわせよ。風,かぜは彼,かれらを運,はこび去,さり、息,いきは彼,かれらを取,とり去,さる。しかしわたしに寄,より頼,たのむ者,ものは地,ちを継,つぎ、わが聖,せいなる山,やまをまもる。","tok":[["あなた"],["が"],["呼ばわる","よばわる"],["時","とき"],["、"],["あなた"],["が"],["集めて","あつめて"],["おいた"],["偶像","ぐうぞう"],["に"],["あなた"],["を"],["救わせ","すくわせ"],["よ"],["。"],["風","かぜ"],["は"],["彼","かれ"],["ら"],["を"],["運こび","はこび"],["去り","さり"],["、"],["息","いき"],["は"],["彼","かれ"],["ら"],["を"],["取去る","とりさる"],["。"],["しかし"],["わたし"],["に"],["寄り","より"],["頼む","たのむ"],["者","もの"],["は"],["地","ち"],["を"],["継","つぎ"],["、"],["わが"],["聖","せい"],["なる"],["山","やま"],["を"],["まもる"],["。"]]},{"verse":14,"text":"主,しゅは言,いわれる、「土,つちを盛,もり、土,つちを盛,もって道,みちを備,そなえよ、わが民,たみの道,みちから、つまずく物,ものを取,とり去,され」と。","tok":[["主","しゅ"],["は"],["言われる","いわれる"],["、"],["「"],["土","つち"],["を"],["盛り","もり"],["、"],["土","つち"],["を"],["盛って","もって"],["道","みち"],["を"],["備","そなえ"],["よ"],["、"],["わが"],["民","たみ"],["の"],["道","みち"],["から"],["、"],["つまずく"],["物","もの"],["を"],["取去れ","とりされ"],["」"],["と"],["。"]]},{"verse":15,"text":"いと高,たかく、いと上,うえなる者,もの、とこしえに住,すむ者,もの、その名,なを聖,せいととなえられる者,ものがこう言,いわれる、「わたしは高,たかく、聖,せいなる所,ところに住,すみ、また心,こころ砕,くだけて、へりくだる者,ものと共,ともに住,すみ、へりくだる者,ものの霊,れいをいかし、砕,くだける者,ものの心,こころをいかす。","tok":[["いと"],["高かく","たかく"],["、"],["いと"],["上","うえ"],["なる"],["者","もの"],["、"],["とこしえ"],["に"],["住む","すむ"],["者","もの"],["、"],["その"],["名","な"],["を"],["聖","せい"],["と"],["となえられる"],["者","もの"],["が"],["こう"],["言われる","いわれる"],["、"],["「"],["わたし"],["は"],["高かく","たかく"],["、"],["聖","せい"],["なる"],["所","ところ"],["に"],["住み","すみ"],["、"],["また"],["心","こころ"],["砕けて","くだけて"],["、"],["へりくだる"],["者","もの"],["と"],["共","とも"],["に"],["住み","すみ"],["、"],["へりくだる"],["者","もの"],["の"],["霊","れい"],["を"],["いかし"],["、"],["砕ける","くだける"],["者","もの"],["の"],["心","こころ"],["を"],["いかす"],["。"]]},{"verse":16,"text":"わたしはかぎりなく争,あらそわない、また絶,たえず怒,いからない。霊,れいはわたしから出,で、いのちの息,いきはわたしがつくったからだ。","tok":[["わたし"],["は"],["かぎりなく"],["争わない","あらそわない"],["、"],["また"],["絶えず","たえず"],["怒らない","いからない"],["。"],["霊","れい"],["は"],["わたし"],["から"],["出","で"],["、"],["いのち"],["の"],["息","いき"],["は"],["わたし"],["が"],["つくった"],["から"],["だ"],["。"]]},{"verse":17,"text":"彼,かれのむさぼりの罪,つみのゆえに、わたしは怒,いかって彼,かれを打,うち、わが顔,かおをかくして怒,いかった。しかし彼,かれはなおそむいて、おのが心,こころの道,みちへ行,いった。","tok":[["彼","かれ"],["の"],["むさぼり"],["の"],["罪","つみ"],["の"],["ゆえ"],["に"],["、"],["わたし"],["は"],["怒","い"],["か"],["って"],["彼","かれ"],["を"],["打ち","うち"],["、"],["わが"],["顔","かお"],["を"],["かくして"],["怒","い"],["かった"],["。"],["しかし"],["彼","かれ"],["は"],["なお"],["そむいて"],["、"],["お"],["の"],["が"],["心","こころ"],["の"],["道","みち"],["へ"],["行った","いった"],["。"]]},{"verse":18,"text":"わたしは彼,かれの道,みちを見,みた。わたしは彼,かれをいやし、また彼,かれを導,みちびき、慰,なぐさめをもって彼,かれに報,むくい、悲,かなしめる者,もののために、くちびるの実,みを造,つくろう。","tok":[["わたし"],["は"],["彼","かれ"],["の"],["道","みち"],["を"],["見た","みた"],["。"],["わたし"],["は"],["彼","かれ"],["を"],["いやし"],["、"],["また"],["彼","かれ"],["を"],["導き","みちびき"],["、"],["慰さめ","なぐさめ"],["を"],["もって"],["彼","かれ"],["に"],["報い","むくい"],["、"],["悲める","かなしめる"],["者","もの"],["の"],["ため"],["に"],["、"],["くちびる"],["の"],["実","み"],["を"],["造ろう","つくろう"],["。"]]},{"verse":19,"text":"遠,とおい者,ものにも近,ちかい者,ものにも平安,へいあんあれ、平安,へいあんあれ、わたしは彼,かれをいやそう」と主,しゅは言,いわれる。","tok":[["遠い","とおい"],["者","もの"],["に"],["も"],["近い","ちかい"],["者","もの"],["に"],["も"],["平安","へいあん"],["あれ"],["、"],["平安","へいあん"],["あれ"],["、"],["わたし"],["は"],["彼","かれ"],["を"],["いやそう"],["」"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":20,"text":"しかし悪,あしき者,ものは波,なみの荒,あらい海,うみのようだ。静,しずまることができないで、その水,みずはついに泥,どろと汚物,おぶつとを出,だす。","tok":[["しかし"],["悪しき","あしき"],["者","もの"],["は"],["波","なみ"],["の"],["荒い","あらい"],["海","うみ"],["の"],["よう"],["だ"],["。"],["静まる","しずまる"],["こと"],["が"],["できないで"],["、"],["その"],["水","みず"],["は"],["ついに"],["泥","どろ"],["と"],["汚物","おぶつ"],["と"],["を"],["出す","だす"],["。"]]},{"verse":21,"text":"わが神,かみは言,いわれる、「よこしまな者,ものには平安,へいあんがない」と。","tok":[["わが"],["神","かみ"],["は"],["言われる","いわれる"],["、"],["「"],["よこしま"],["な"],["者","もの"],["に"],["は"],["平安","へいあん"],["が"],["ない"],["」"],["と"],["。"]]}]
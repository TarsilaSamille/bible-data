[{"verse":1,"text":"主,しゅはこう言,いわれる、「天,てんはわが位,くらい、地,ちはわが足,あし台,だいである。あなたがたはわたしのためにどんな家,いえを建,たてようとするのか。またどんな所,ところがわが休,やすみ所,ところとなるのか」。","tok":[["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["「"],["天","てん"],["は"],["わが"],["位","くらい"],["、"],["地","ち"],["は"],["わが"],["足台","あしだい"],["で"],["ある"],["。"],["あなた"],["がた"],["は"],["わたし"],["の"],["ため"],["に"],["どんな"],["家","いえ"],["を"],["建てよう","たてよう"],["と"],["する"],["の"],["か"],["。"],["また"],["どんな"],["所","ところ"],["が"],["わが"],["休み所","やすみところ"],["と"],["なる"],["の"],["か"],["」"],["。"]]},{"verse":2,"text":"主,しゅは言,いわれる、「わが手,てはすべてこれらの物,ものを造,つくった。これらの物,ものはことごとくわたしのものである。しかし、わたしが顧,かえりみる人,ひとはこれである。すなわち、へりくだって心,こころ悔,くい、わが言葉,ことばに恐,おそれおののく者,ものである。","tok":[["主","しゅ"],["は"],["言われる","いわれる"],["、"],["「"],["わが"],["手","て"],["は"],["すべて"],["これ"],["ら"],["の"],["物","もの"],["を"],["造った","つくった"],["。"],["これ"],["ら"],["の"],["物","もの"],["は"],["ことごとく"],["わたし"],["の"],["もの"],["で"],["ある"],["。"],["しかし"],["、"],["わたし"],["が"],["顧る","かえりみる"],["人","ひと"],["は"],["これ"],["で"],["ある"],["。"],["すなわち"],["、"],["へりくだって"],["心","こころ"],["悔い","くい"],["、"],["わが"],["言葉","ことば"],["に"],["恐れおののく","おそれおののく"],["者","もの"],["で"],["ある"],["。"]]},{"verse":3,"text":"牛,うしをほふる者,ものは、また人,ひとを殺,ころす者,もの、小羊,こひつじを犠牲,ぎせいとする者,ものは、また犬,いぬをくびり殺,ころす者,もの、供,そなえ物,ものをささげる者,ものは、また豚,ぶたの血,ちをささげる者,もの、乳香,にゅうこうを記念,きねんとしてささげる者,ものは、また偶像,ぐうぞうをほめる者,ものである。これはおのが道,みちを選,えらび、その心,こころは憎,にくむべきものを楽,たのしむ。","tok":[["牛","うし"],["を"],["ほふる"],["者","もの"],["は"],["、"],["また"],["人","ひと"],["を"],["殺ろす","ころす"],["者","もの"],["、"],["小羊","こひつじ"],["を"],["犠牲","ぎせい"],["と"],["する"],["者","もの"],["は"],["、"],["また"],["犬","いぬ"],["を"],["くびり"],["殺ろす","ころす"],["者","もの"],["、"],["供え物","そなえもの"],["を"],["ささげる"],["者","もの"],["は"],["、"],["また"],["豚","ぶた"],["の"],["血","ち"],["を"],["ささげる"],["者","もの"],["、"],["乳香","にゅうこう"],["を"],["記念","きねん"],["として"],["ささげる"],["者","もの"],["は"],["、"],["また"],["偶像","ぐうぞう"],["を"],["ほめる"],["者","もの"],["で"],["ある"],["。"],["これ"],["は"],["お"],["の"],["が"],["道","みち"],["を"],["選ら","えら"],["び"],["、"],["その"],["心","こころ"],["は"],["憎むべき","にくむべき"],["もの"],["を"],["楽しむ","たのしむ"],["。"]]},{"verse":4,"text":"わたしもまた彼,かれらのために悩,なやみを選,えらび、彼,かれらの恐,おそれるところのものを彼,かれらに臨,のぞませる。これは、わたしが呼,よんだときに答,こたえる者,ものなく、わたしが語,かたったときに聞,きくことをせず、わたしの目,めに悪,わるい事,ことを行,おこない、わたしの好,このまなかった事,ことを選,えらんだからである」。","tok":[["わたし"],["も"],["また"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["悩み","なやみ"],["を"],["選ら","えら"],["び"],["、"],["彼","かれ"],["ら"],["の"],["恐れる","おそれる"],["ところ"],["の"],["もの"],["を"],["彼","かれ"],["ら"],["に"],["臨ませる","のぞませる"],["。"],["これ"],["は"],["、"],["わたし"],["が"],["呼","よんだとき"],["に"],["答","こたえ"],["る"],["者","もの"],["なく"],["、"],["わたし"],["が"],["語った","かたった"],["とき"],["に"],["聞く","きく"],["こと"],["を"],["せず"],["、"],["わたし"],["の"],["目","め"],["に"],["悪い","わるい"],["事","こと"],["を"],["行ない","おこない"],["、"],["わたし"],["の"],["好まなかった","このまなかった"],["事","こと"],["を"],["選らんだ","えらんだ"],["から"],["で"],["ある"],["」"],["。"]]},{"verse":5,"text":"あなたがた、主,しゅの言葉,ことばに恐,おそれおののく者,ものよ、主,しゅの言葉,ことばを聞,きけ、「あなたがたの兄弟,きょうだいたちはあなたがたを憎,にくみ、あなたがたをわが名,なのために追,おい出,だして言,いった、『願,ねがわくは主,しゅがその栄光,えいこうをあらわしてわれわれにあなたがたの喜,よろこびを見,みさせよ』と。しかし彼,かれらは恥,はじを受,うける。","tok":[["あなた"],["がた"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["に"],["恐れおののく","おそれおののく"],["者","もの"],["よ"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["を"],["聞け","きけ"],["、"],["「"],["あなた"],["がた"],["の"],["兄弟","きょうだい"],["たち"],["は"],["あなた"],["がた"],["を"],["憎み","にくみ"],["、"],["あなた"],["がた"],["を"],["わが"],["名","な"],["の"],["ため"],["に"],["追い出して","おいだして"],["言った","いった"],["、"],["『"],["願わく","ねがわく"],["は"],["主","しゅがそ"],["の"],["栄光","えいこう"],["を"],["あらわして"],["われわれ"],["に"],["あなた"],["がた"],["の"],["喜こび","よろこび"],["を"],["見させよ","みさせよ"],["』"],["と"],["。"],["しかし"],["彼","かれ"],["ら"],["は"],["恥","はじ"],["を"],["受る","うける"],["。"]]},{"verse":6,"text":"聞,きけよ、町,まちから起,おこる騒,さわぎを。宮,みやから聞,きこえる声,こえを。主,しゅがその敵,てきに報復,ほうふくされる声,こえを。","tok":[["聞けよ","きけよ"],["、"],["町","まち"],["から"],["起こる","おこる"],["騒","さわぎ"],["を"],["。"],["宮","みや"],["から"],["聞こえる","きこえる"],["声","こえ"],["を"],["。"],["主","しゅがそ"],["の"],["敵","てき"],["に"],["報復","ほうふく"],["される"],["声","こえ"],["を"],["。"]]},{"verse":7,"text":"シオンは産,うみの苦,くるしみをなす前,まえに産,うみ、その苦,くるしみの来,きない前,まえに男子,だんしを産,うんだ。","tok":[["シオン"],["は"],["産み","うみ"],["の"],["苦しみ","くるしみ"],["を"],["なす"],["前","まえ"],["に"],["産み","うみ"],["、"],["その"],["苦しみ","くるしみ"],["の"],["来ない","きない"],["前","まえ"],["に"],["男子","だんし"],["を"],["産んだ","うんだ"],["。"]]},{"verse":8,"text":"だれがこのような事,ことを聞,きいたか、だれがこのような事,ことどもを見,みたか。一つの国,くには一日,にちの苦,くるしみで生,うまれるだろうか。一つの国民,こくみんはひと時,ときに生,うまれるだろうか。しかし、シオンは産,うみの苦,くるしみをするやいなやその子,こらを産,うんだ。","tok":[["だれ"],["が"],["この"],["よう"],["な"],["事","こと"],["を"],["聞いた","きいた"],["か"],["、"],["だれ"],["が"],["この"],["よう"],["な"],["事","こと"],["ども"],["を"],["見た","みた"],["か"],["。"],["一","ひと"],["つ"],["の"],["国","くに"],["は"],["一","いち"],["日","にち"],["の"],["苦しみ","くるしみ"],["で"],["生まれるだろう","うまれるだろう"],["か"],["。"],["一","ひと"],["つ"],["の"],["国民","こくみん"],["は"],["ひと時","ひととき"],["に"],["生まれるだろう","うまれるだろう"],["か"],["。"],["しかし"],["、"],["シオン"],["は"],["産み","うみ"],["の"],["苦しみ","くるしみ"],["を"],["する"],["や"],["いな"],["や"],["その"],["子","こ"],["ら"],["を"],["産んだ","うんだ"],["。"]]},{"verse":9,"text":"わたしが出産,しゅっさんに臨,のぞませて産,うませないことがあろうか」と主,しゅは言,いわれる。「わたしは産,うませる者,ものなのに胎,たいをとざすであろうか」とあなたの神,かみは言,いわれる。","tok":[["わたし"],["が"],["出産","しゅっさん"],["に"],["臨ませて","のぞませて"],["産ませない","うませない"],["こと"],["が"],["あろう"],["か"],["」"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["。"],["「"],["わたし"],["は"],["産ませる","うませる"],["者","もの"],["な"],["のに"],["胎","たい"],["を"],["とざすで"],["あろう"],["か"],["」"],["と"],["あなた"],["の"],["神","かみ"],["は"],["言われる","いわれる"],["。"]]},{"verse":10,"text":"「すべてエルサレムを愛,あいする者,ものよ、彼女,かのじょと共,ともに喜,よろこべ、彼女,かのじょのゆえに楽,たのしめ。すべて彼女,かのじょのために悲,かなしむ者,ものよ、彼女,かのじょと共,ともに喜,よろこび楽,たのしめ。","tok":[["「"],["すべて"],["エルサレム"],["を"],["愛する","あいする"],["者","もの"],["よ"],["、"],["彼女","かのじょ"],["と"],["共","とも"],["に"],["喜こべ","よろこべ"],["、"],["彼女","かのじょ"],["の"],["ゆえ"],["に"],["楽め","たのしめ"],["。"],["すべて"],["彼女","かのじょ"],["の"],["ため"],["に"],["悲しむ","かなしむ"],["者","もの"],["よ"],["、"],["彼女","かのじょ"],["と"],["共","とも"],["に"],["喜こび","よろこび"],["楽め","たのしめ"],["。"]]},{"verse":11,"text":"あなたがたは慰,なぐさめを与,あたえるエルサレムの乳,ちぶさから乳,ちちを吸,すって飽,あくことができ、またその豊,ゆたかな栄,さかえから飲,のんで楽,たのしむことができるからだ」。","tok":[["あなた"],["がた"],["は"],["慰さめ","なぐさめ"],["を"],["与える","あたえる"],["エルサレム"],["の"],["乳ぶさ","ちぶさ"],["から"],["乳","ちち"],["を"],["吸って","すって"],["飽く","あく"],["こと"],["が"],["でき"],["、"],["また"],["その"],["豊","ゆたか"],["な"],["栄","さかえ"],["から"],["飲んで","のんで"],["楽しむ","たのしむ"],["こと"],["が"],["できる"],["から"],["だ"],["」"],["。"]]},{"verse":12,"text":"主,しゅはこう言,いわれる、「見,みよ、わたしは川,かわのように彼女,かのじょに繁栄,はんえいを与,あたえ、みなぎる流,ながれのように、もろもろの国,くにの富,とみを与,あたえる。あなたがたは乳,ちちを飲,のみ、腰,こしに負,おわれ、ひざの上,うえであやされる。","tok":[["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["「"],["見よ","みよ"],["、"],["わたし"],["は"],["川","かわ"],["の"],["よう"],["に"],["彼女","かのじょ"],["に"],["繁栄","はんえい"],["を"],["与","あたえ"],["、"],["みなぎる"],["流れ","ながれ"],["の"],["よう"],["に"],["、"],["もろもろ"],["の"],["国","くに"],["の"],["富","とみ"],["を"],["与える","あたえる"],["。"],["あなた"],["がた"],["は"],["乳","ちち"],["を"],["飲み","のみ"],["、"],["腰","こし"],["に"],["負われ","おわれ"],["、"],["ひざ"],["の"],["上","うえ"],["で"],["あやされる"],["。"]]},{"verse":13,"text":"母,ははのその子,こを慰,なぐさめるように、わたしもあなたがたを慰,なぐさめる。あなたがたはエルサレムで慰,なぐさめを得,える。","tok":[["母","はは"],["の"],["その"],["子","こ"],["を"],["慰さめる","なぐさめる"],["よう"],["に"],["、"],["わたし"],["も"],["あなた"],["がた"],["を"],["慰さめる","なぐさめる"],["。"],["あなた"],["がた"],["は"],["エルサレム"],["で"],["慰さめ","なぐさめ"],["を"],["得る","える"],["。"]]},{"verse":14,"text":"あなたがたは見,みて、心,こころ喜,よろこび、あなたがたの骨,ほねは若草,わかくさのように栄,さかえる。主,しゅの手,てはそのしもべらと共,ともにあり、その憤,いきどおりはその敵,てきにむかっていることを知,しる。","tok":[["あなた"],["がた"],["は"],["見て","みて"],["、"],["心","こころ"],["喜こび","よろこび"],["、"],["あなた"],["がた"],["の"],["骨","ほね"],["は"],["若草","わかくさ"],["の"],["よう"],["に"],["栄","さかえ"],["る"],["。"],["主","しゅ"],["の"],["手","て"],["は"],["その"],["しもべ"],["ら"],["と"],["共","とも"],["に"],["あり"],["、"],["その"],["憤り","いきどおり"],["は"],["その"],["敵","てき"],["に"],["むかって"],["いる"],["こと"],["を"],["知る","しる"],["。"]]},{"verse":15,"text":"見,みよ、主,しゅは火,ひの中,なかにあらわれて来,こられる。その車,くるまはつむじ風,かぜのようだ。激,はげしい怒,いかりをもってその憤,いきどおりをもらし、火,ひの炎,ほのおをもって責,せめられる。","tok":[["見よ","みよ"],["、"],["主","しゅ"],["は"],["火","ひ"],["の"],["中","なか"],["に"],["あらわれて"],["来られる","こられる"],["。"],["その"],["車","くるま"],["は"],["つむじ風","つむじかぜ"],["の"],["よう"],["だ"],["。"],["激しい","はげしい"],["怒り","いかり"],["を"],["もって"],["その"],["憤り","いきどおり"],["を"],["もらし"],["、"],["火","ひ"],["の"],["炎","ほのお"],["を"],["もって"],["責","せめ"],["られる"],["。"]]},{"verse":16,"text":"主,しゅは火,ひをもって、またつるぎをもって、すべての人,ひとにさばきを行,おこなわれる。主,しゅに殺,ころされる者,ものは多,おおい」。","tok":[["主","しゅ"],["は"],["火","ひ"],["を"],["もって"],["、"],["また"],["つるぎ"],["を"],["もって"],["、"],["すべて"],["の"],["人","ひと"],["に"],["さばき"],["を"],["行なわれる","おこなわれる"],["。"],["主に","しゅに"],["殺ろされる","ころされる"],["者","もの"],["は"],["多い","おおい"],["」"],["。"]]},{"verse":17,"text":"「みずからを聖別,せいべつし、みずからを清,きよめて園,そのに行,いき、その中,なかにあるものに従,したがい、豚,ぶたの肉,にく、憎,にくむべき物,ものおよびねずみを食,くう者,ものはみな共,ともに絶,たえうせる」と主,しゅは言,いわれる。","tok":[["「"],["みずから"],["を"],["聖別","せいべつ"],["し"],["、"],["みずから"],["を"],["清めて","きよめて"],["園","その"],["に"],["行き","いき"],["、"],["その"],["中","なか"],["に"],["ある"],["もの"],["に"],["従い","したがい"],["、"],["豚","ぶた"],["の"],["肉","にく"],["、"],["憎むべき","にくむべき"],["物","もの"],["および"],["ねずみ"],["を"],["食う","くう"],["者","もの"],["は"],["みな"],["共","とも"],["に"],["絶え","たえ"],["うせる"],["」"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":18,"text":"「わたしは彼,かれらのわざと、彼,かれらの思,おもいとを知,しっている。わたしは来,きて、すべての国民,こくみんと、もろもろのやからとを集,あつめる。彼,かれらは来,きて、わが栄光,えいこうを見,みる。","tok":[["「"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["わざと"],["、"],["彼","かれ"],["ら"],["の"],["思い","おもい"],["と"],["を"],["知って","しって"],["いる"],["。"],["わたし"],["は"],["来て","きて"],["、"],["すべて"],["の"],["国民","こくみん"],["と"],["、"],["もろもろ"],["の"],["やから"],["と"],["を"],["集める","あつめる"],["。"],["彼","かれ"],["ら"],["は"],["来て","きて"],["、"],["わが"],["栄光","えいこう"],["を"],["見る","みる"],["。"]]},{"verse":19,"text":"わたしは彼,かれらの中,なかに一つのしるしを立,たてて、のがれた者,ものをもろもろの国,くに、すなわちタルシシ、よく弓,ゆみをひくプトおよびルデ、トバル、ヤワン、またわが名声,めいせいを聞,きかず、わが栄光,えいこうを見,みない遠,とおくの海沿,うみぞいの国々,くにぐににつかわす。彼,かれらはわが栄光,えいこうをもろもろの国民,こくみんの中,なかに伝,つたえる。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["の"],["中","なか"],["に"],["一","ひと"],["つ"],["の"],["しるし"],["を"],["立てて","たてて"],["、"],["のがれた"],["者","もの"],["を"],["もろもろ"],["の"],["国","くに"],["、"],["すなわち"],["タルシシ"],["、"],["よく"],["弓","ゆみ"],["を"],["ひく"],["プト"],["および"],["ルデ"],["、"],["トバル"],["、"],["ヤワン"],["、"],["また"],["わが"],["名声","めいせい"],["を"],["聞かず","きかず"],["、"],["わが"],["栄光","えいこう"],["を"],["見ない","みない"],["遠く","とおく"],["の"],["海沿い","うみぞい"],["の"],["国々","くにぐに"],["に"],["つかわす"],["。"],["彼","かれ"],["ら"],["は"],["わが"],["栄光","えいこう"],["を"],["もろもろ"],["の"],["国民","こくみん"],["の"],["中","なか"],["に"],["伝える","つたえる"],["。"]]},{"verse":20,"text":"彼,かれらはイスラエルの子,こらが清,きよい器,うつわに供,そなえ物,ものを盛,もって主,しゅの宮,みやに携,たずさえて来,くるように、あなたがたの兄弟,きょうだいをことごとくもろもろの国,くにの中,なかから馬,うま、車,くるま、かご、騾馬,らば、らくだに乗,のせて、わが聖,せいなる山,やまエルサレムにこさせ、主,しゅの供,そなえ物,ものとする」と主,しゅは言,いわれる。","tok":[["彼","かれ"],["ら"],["は"],["イスラエル"],["の"],["子","こ"],["ら"],["が"],["清い","きよい"],["器","うつわ"],["に"],["供え物","そなえもの"],["を"],["盛って","もって"],["主","しゅ"],["の"],["宮","みや"],["に"],["携えて","たずさえて"],["来る","くる"],["よう"],["に"],["、"],["あなた"],["がた"],["の"],["兄弟","きょうだい"],["を"],["ことごとく"],["もろもろ"],["の"],["国","くに"],["の"],["中","なか"],["から"],["馬","うま"],["、"],["車","くるま"],["、"],["かご"],["、"],["騾馬","らば"],["、"],["らくだ"],["に"],["乗せて","のせて"],["、"],["わが"],["聖","せい"],["なる"],["山","やま"],["エルサレム"],["に"],["こさせ"],["、"],["主","しゅ"],["の"],["供え物","そなえもの"],["と"],["する"],["」"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":21,"text":"「わたしはまた彼,かれらの中,なかから人,ひとを選,えらんで祭司,さいしとし、レビびととする」と主,しゅは言,いわれる。","tok":[["「"],["わたし"],["は"],["また"],["彼","かれ"],["ら"],["の"],["中","なか"],["から"],["人","ひと"],["を"],["選らんで","えらんで"],["祭司","さいし"],["と"],["し"],["、"],["レビ"],["びと"],["と"],["する"],["」"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":22,"text":"「わたしが造,つくろうとする新,あたらしい天,てんと、新,あたらしい地,ちがわたしの前,まえにながくとどまるように、あなたの子孫,しそんと、あなたの名,なはながくとどまる」と主,しゅは言,いわれる。","tok":[["「"],["わたし"],["が"],["造ろう","つくろう"],["と"],["する"],["新らしい","あたらしい"],["天","てん"],["と"],["、"],["新らしい","あたらしい"],["地","ち"],["が"],["わたし"],["の"],["前","まえ"],["に"],["ながく"],["とどまる"],["よう"],["に"],["、"],["あなた"],["の"],["子孫","しそん"],["と"],["、"],["あなた"],["の"],["名","な"],["は"],["ながく"],["とどまる"],["」"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":23,"text":"「新月,しんげつごとに、安息日,あんそくにちごとに、すべての人,ひとはわが前,まえに来,きて礼,れい拝,はいする」と主,しゅは言,いわれる。","tok":[["「"],["新月","しんげつ"],["ごと"],["に"],["、"],["安息日","あんそくにちごと"],["に"],["、"],["すべて"],["の"],["人","ひと"],["は"],["わが"],["前","まえ"],["に"],["来て","きて"],["礼拝","れいはい"],["する"],["」"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":24,"text":"「彼,かれらは出,でて、わたしにそむいた人々,ひとびとのしかばねを見,みる。そのうじは死,しなず、その火,ひは消,きえることがない。彼,かれらはすべての人,ひとに忌,いみきらわれる」。","tok":[["「"],["彼","かれ"],["ら"],["は"],["出て","でて"],["、"],["わたし"],["に"],["そむいた"],["人々","ひとびと"],["の"],["しかばね"],["を"],["見る","みる"],["。"],["その"],["うじ"],["は"],["死なず","しなず"],["、"],["その"],["火","ひ"],["は"],["消える","きえる"],["こと"],["が"],["ない"],["。"],["彼","かれ"],["ら"],["は"],["すべて"],["の"],["人","ひと"],["に"],["忌","いみ"],["きらわれる"],["」"],["。"]]}]
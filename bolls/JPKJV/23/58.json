[{"verse":1,"text":"「大,おおいに呼,よばわって声,こえを惜,おしむな。あなたの声,こえをラッパのようにあげ、わが民,たみにそのとがを告,つげ、ヤコブの家,いえにその罪,つみを告,つげ示,しめせ。","tok":[["「"],["大いに","おおいに"],["呼ばわって","よばわって"],["声","こえ"],["を"],["惜む","おしむ"],["な"],["。"],["あなた"],["の"],["声","こえ"],["を"],["ラッパ"],["の"],["よう"],["に"],["あげ"],["、"],["わが"],["民","たみ"],["に"],["その"],["とが"],["を"],["告","つげ"],["、"],["ヤコブ"],["の"],["家","いえ"],["に"],["その"],["罪","つみ"],["を"],["告","つげ"],["示めせ","しめせ"],["。"]]},{"verse":2,"text":"彼,かれらは日々,ひびわたしを尋,たずね求,もとめ、義,ぎを行,おこない、神,かみのおきてを捨,すてない国民,こくみんのように、わが道,みちを知,しることを喜,よろこぶ。彼,かれらは正,ただしいさばきをわたしに求,もとめ、神,かみに近,ちかづくことを喜,よろこぶ。","tok":[["彼","かれ"],["ら"],["は"],["日々","ひび"],["わたし"],["を"],["尋ね求め","たずねもとめ"],["、"],["義","ぎ"],["を"],["行ない","おこない"],["、"],["神","かみ"],["の"],["おきて"],["を"],["捨てない","すてない"],["国民","こくみん"],["の"],["よう"],["に"],["、"],["わが"],["道","みち"],["を"],["知る","しる"],["こと"],["を"],["喜こぶ","よろこぶ"],["。"],["彼","かれ"],["ら"],["は"],["正い","ただしい"],["さばき"],["を"],["わたし"],["に"],["求め","もとめ"],["、"],["神","かみ"],["に"],["近づく","ちかづく"],["こと"],["を"],["喜こぶ","よろこぶ"],["。"]]},{"verse":3,"text":"彼,かれらは言,いう、『われわれが断食,だんじきしたのに、なぜ、ごらんにならないのか。われわれがおのれを苦,くるしめたのに、なぜ、ごぞんじないのか』と。見,みよ、あなたがたの断食,だんじきの日,ひには、おのが楽,たのしみを求,もとめ、その働,はたらき人,ひとをことごとくしえたげる。","tok":[["彼","かれ"],["ら"],["は"],["言う","いう"],["、"],["『"],["われわれ"],["が"],["断食","だんじき"],["した"],["のに"],["、"],["なぜ"],["、"],["ごらん"],["に"],["ならない"],["の"],["か"],["。"],["われわれ"],["が"],["おのれ"],["を"],["苦しめた","くるしめた"],["のに"],["、"],["なぜ"],["、"],["ごぞんじない"],["の"],["か"],["』"],["と"],["。"],["見よ","みよ"],["、"],["あなた"],["がた"],["の"],["断食","だんじき"],["の"],["日","ひ"],["に"],["は"],["、"],["お"],["の"],["が"],["楽み","たのしみ"],["を"],["求め","もとめ"],["、"],["その"],["働らき人","はたらきひと"],["を"],["ことごとく"],["し"],["えたげる"],["。"]]},{"verse":4,"text":"見,みよ、あなたがたの断食,しょくするのは、ただ争,あらそいと、いさかいのため、また悪,あくのこぶしをもって人,ひとを打,うつためだ。きょう、あなたがたのなす断食,だんじきは、その声,こえを上,うえに聞,きこえさせるものではない。","tok":[["見よ","みよ"],["、"],["あなた"],["がた"],["の"],["断食","しょくする"],["の"],["は"],["、"],["ただ"],["争い","あらそい"],["と"],["、"],["いさかい"],["の"],["ため"],["、"],["また"],["悪","あく"],["の"],["こぶし"],["を"],["もって"],["人","ひと"],["を"],["打つ","うつ"],["ため"],["だ"],["。"],["きょう"],["、"],["あなた"],["がた"],["の"],["なす"],["断食","だんじき"],["は"],["、"],["その"],["声","こえ"],["を"],["上","うえ"],["に"],["聞こえさせる","きこえさせる"],["もの"],["で"],["は"],["ない"],["。"]]},{"verse":5,"text":"このようなものは、わたしの選,えらぶ断食,だんじきであろうか。人,ひとがおのれを苦,くるしめる日,ひであろうか。そのこうべを葦,あしのように伏,ふせ、荒布,あらぬのと灰,はいとをその下,したに敷,しくことであろうか。あなたは、これを断食,だんじきととなえ、主,しゅに受,うけいれられる日,ひと、となえるであろうか。","tok":[["この"],["よう"],["な"],["もの"],["は"],["、"],["わたし"],["の"],["選ぶ","えらぶ"],["断食","だんじき"],["で"],["あろう"],["か"],["。"],["人","ひと"],["が"],["おのれ"],["を"],["苦しめる","くるしめる"],["日","ひ"],["で"],["あろう"],["か"],["。"],["その"],["こうべ"],["を"],["葦","あし"],["の"],["よう"],["に"],["伏せ","ふせ"],["、"],["荒布","あらぬ"],["の"],["と"],["灰","はい"],["と"],["を"],["その"],["下","した"],["に"],["敷く","しく"],["こと"],["で"],["あろう"],["か"],["。"],["あなた"],["は"],["、"],["これ"],["を"],["断食","だんじき"],["と"],["となえ"],["、"],["主に","しゅに"],["受","うけ"],["いれられる"],["日","ひ"],["と"],["、"],["となえるで"],["あろう"],["か"],["。"]]},{"verse":6,"text":"わたしが選,えらぶところの断食,だんじきは、悪,あくのなわをほどき、くびきのひもを解,とき、しえたげられる者,ものを放,はなち去,さらせ、すべてのくびきを折,おるなどの事,ことではないか。","tok":[["わたし"],["が"],["選ぶ","えらぶ"],["ところ"],["の"],["断食","だんじき"],["は"],["、"],["悪","あく"],["の"],["なわ"],["を"],["ほどき"],["、"],["くびき"],["の"],["ひも"],["を"],["解き","とき"],["、"],["し"],["えたげられる"],["者","もの"],["を"],["放ち","はなち"],["去らせ","さらせ"],["、"],["すべて"],["の"],["くびき"],["を"],["折る","おる"],["など"],["の"],["事","こと"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":7,"text":"また飢,うえた者,ものに、あなたのパンを分,わけ与,あたえ、さすらえる貧,まずしい者,ものを、あなたの家,いえに入,いれ、裸,はだかの者,ものを見,みて、これを着,きせ、自分,じぶんの骨肉,こつにくに身,みを隠,かくさないなどの事,ことではないか。","tok":[["また"],["飢","うえ"],["た"],["者","もの"],["に"],["、"],["あなた"],["の"],["パン"],["を"],["分け","わけ"],["与","あたえ"],["、"],["さすらえる"],["貧しい","まずしい"],["者","もの"],["を"],["、"],["あなた"],["の"],["家","いえ"],["に"],["入れ","いれ"],["、"],["裸","はだか"],["の"],["者","もの"],["を"],["見て","みて"],["、"],["これ"],["を"],["着せ","きせ"],["、"],["自分","じぶん"],["の"],["骨肉","こつにく"],["に"],["身","み"],["を"],["隠さない","かくさない"],["など"],["の"],["事","こと"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":8,"text":"そうすれば、あなたの光,ひかりが暁,あかつきのようにあらわれ出,でて、あなたは、すみやかにいやされ、あなたの義,ぎはあなたの前,まえに行,いき、主,しゅの栄光,えいこうはあなたのしんがりとなる。","tok":[["そう"],["すれば"],["、"],["あなた"],["の"],["光","ひかり"],["が"],["暁","あかつき"],["の"],["よう"],["に"],["あらわれ出て","あらわれでて"],["、"],["あなた"],["は"],["、"],["すみやか"],["に"],["いやされ"],["、"],["あなた"],["の"],["義","ぎ"],["は"],["あなた"],["の"],["前","まえ"],["に"],["行き","いき"],["、"],["主","しゅ"],["の"],["栄光","えいこう"],["は"],["あなた"],["の"],["しんがり"],["と"],["なる"],["。"]]},{"verse":9,"text":"また、あなたが呼,よぶとき、主,しゅは答,こたえられ、あなたが叫,さけぶとき、『わたしはここにおる』と言,いわれる。もし、あなたの中,なかからくびきを除,のぞき、指,ゆびをさすこと、悪,わるい事,ことを語,かたることを除,のぞき、","tok":[["また"],["、"],["あなた"],["が"],["呼ぶ","よぶ"],["とき"],["、"],["主","しゅ"],["は"],["答","こたえ"],["られ"],["、"],["あなた"],["が"],["叫けぶ","さけぶ"],["とき"],["、"],["『"],["わたし"],["は"],["ここ"],["に"],["おる"],["』"],["と"],["言われる","いわれる"],["。"],["もし"],["、"],["あなた"],["の"],["中","なか"],["から"],["くびき"],["を"],["除き","のぞき"],["、"],["指","ゆび"],["を"],["さす"],["こと"],["、"],["悪い","わるい"],["事","こと"],["を"],["語る","かたる"],["こと"],["を"],["除き","のぞき"],["、"]]},{"verse":10,"text":"飢,うえた者,ものにあなたのパンを施,ほどこし、苦,くるしむ者,ものの願,ねがいを満,みち足,たらせるならば、あなたの光,ひかりは暗,くらきに輝,かがやき、あなたのやみは真昼,まひるのようになる。","tok":[["飢","うえ"],["た"],["者","もの"],["に"],["あなた"],["の"],["パン"],["を"],["施し","ほどこし"],["、"],["苦しむ","くるしむ"],["者","もの"],["の"],["願い","ねがい"],["を"],["満ち","みち"],["足らせるならば","たらせるならば"],["、"],["あなた"],["の"],["光","ひかり"],["は"],["暗き","くらき"],["に"],["輝やき","かがやき"],["、"],["あなた"],["の"],["やみ"],["は"],["真昼","まひる"],["の"],["よう"],["に"],["なる"],["。"]]},{"verse":11,"text":"主,しゅは常,つねにあなたを導,みちびき、良,よき物,ものをもってあなたの願,ねがいを満,みち足,たらせ、あなたの骨,ほねを強,つよくされる。あなたは潤,うるおった園,そののように、水,みずの絶,たえない泉,いずみのようになる。","tok":[["主","しゅ"],["は"],["常","つね"],["に"],["あなた"],["を"],["導き","みちびき"],["、"],["良き","よき"],["物","もの"],["を"],["もって"],["あなた"],["の"],["願い","ねがい"],["を"],["満ち","みち"],["足らせ","たらせ"],["、"],["あなた"],["の"],["骨","ほね"],["を"],["強く","つよく"],["される"],["。"],["あなた"],["は"],["潤った","うるおった"],["園","その"],["の"],["よう"],["に"],["、"],["水","みず"],["の"],["絶えない","たえない"],["泉","いずみ"],["の"],["よう"],["に"],["なる"],["。"]]},{"verse":12,"text":"あなたの子,こらは久,ひさしく荒,あれすたれたる所,ところを興,おこし、あなたは代々,よよやぶれた基,もといを立,たて、人,ひとはあなたを『破,やぶれを繕,つくろう者,もの』と呼,よび、『市街,しがいを繕,つくろって住,すむべき所,ところとなす者,もの』と呼,よぶようになる。","tok":[["あなた"],["の"],["子","こ"],["ら"],["は"],["久く","ひさしく"],["荒れ","あれ"],["すたれたる"],["所","ところ"],["を"],["興し","おこし"],["、"],["あなた"],["は"],["代々","よ"],["よ"],["やぶれた"],["基い","もとい"],["を"],["立て","たて"],["、"],["人","ひと"],["は"],["あなた"],["を"],["『"],["破れ","やぶれ"],["を"],["繕う","つくろう"],["者","もの"],["』"],["と"],["呼び","よび"],["、"],["『"],["市街","しがい"],["を"],["繕って","つくろって"],["住むべき","すむべき"],["所","ところ"],["と"],["なす"],["者","もの"],["』"],["と"],["呼ぶ","よぶ"],["よう"],["に"],["なる"],["。"]]},{"verse":13,"text":"もし安息日,あんそくにちにあなたの足,あしをとどめ、わが聖日,せいじつにあなたの楽,たのしみをなさず、安息日,あんそくにちを喜,よろこびの日,ひと呼,よび、主,しゅの聖日,せいじつを尊,たっとぶべき日,ひととなえ、これを尊,たっとんで、おのが道,みちを行,おこなわず、おのが楽,たのしみを求,もとめず、むなしい言葉,ことばを語,かたらないならば、","tok":[["もし"],["安息日","あんそくにち"],["に"],["あなた"],["の"],["足","あし"],["を"],["とどめ"],["、"],["わが"],["聖日","せいじつ"],["に"],["あなた"],["の"],["楽み","たのしみ"],["を"],["なさず"],["、"],["安息日","あんそくにち"],["を"],["喜こび","よろこび"],["の"],["日","ひ"],["と"],["呼び","よび"],["、"],["主","しゅ"],["の"],["聖日","せいじつ"],["を"],["尊","た"],["っと"],["ぶ"],["べき"],["日","ひ"],["と"],["となえ"],["、"],["これ"],["を"],["尊","た"],["っと"],["んで"],["、"],["お"],["の"],["が"],["道","みち"],["を"],["行なわず","おこなわず"],["、"],["お"],["の"],["が"],["楽み","たのしみ"],["を"],["求めず","もとめず"],["、"],["むなしい"],["言葉","ことば"],["を"],["語らないならば","かたらないならば"],["、"]]},{"verse":14,"text":"その時,ときあなたは主,しゅによって喜,よろこびを得,え、わたしは、あなたに地,ちの高,たかい所,ところを乗,のり通,とおらせ、あなたの先祖,せんぞヤコブの嗣,し業,ぎょうをもって、あなたを養,やしなう」。これは主,しゅの口,くちから語,かたられたものである。","tok":[["その"],["時","とき"],["あなた"],["は"],["主に","しゅに"],["よって"],["喜こび","よろこび"],["を"],["得","え"],["、"],["わたし"],["は"],["、"],["あなた"],["に"],["地","ち"],["の"],["高い","たかい"],["所","ところ"],["を"],["乗","のり"],["通らせ","とおらせ"],["、"],["あなた"],["の"],["先祖","せんぞ"],["ヤコブ"],["の"],["嗣業","しぎょう"],["を"],["もって"],["、"],["あなた"],["を"],["養う","やしなう"],["」"],["。"],["これ"],["は"],["主","しゅ"],["の"],["口","くち"],["から"],["語られた","かたられた"],["もの"],["で"],["ある"],["。"]]}]
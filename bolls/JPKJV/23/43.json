[{"verse":1,"text":"ヤコブよ、あなたを創造,そうぞうされた主,しゅはこう言,いわれる。イスラエルよ、あなたを造,つくられた主,しゅはいまこう言,いわれる、「恐,おそれるな、わたしはあなたをあがなった。わたしはあなたの名,なを呼,よんだ、あなたはわたしのものだ。","tok":[["ヤコブ"],["よ"],["、"],["あなた"],["を"],["創造","そうぞう"],["された"],["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["。"],["イスラエル"],["よ"],["、"],["あなた"],["を"],["造られた","つくられた"],["主","しゅ"],["は"],["いま"],["こう"],["言われる","いわれる"],["、"],["「"],["恐れる","おそれる"],["な"],["、"],["わたし"],["は"],["あなた"],["を"],["あがなった"],["。"],["わたし"],["は"],["あなた"],["の"],["名","な"],["を"],["呼んだ","よんだ"],["、"],["あなた"],["は"],["わたし"],["の"],["もの"],["だ"],["。"]]},{"verse":2,"text":"あなたが水,みずの中,なかを過,すぎるとき、わたしはあなたと共,ともにおる。川,かわの中,なかを過,すぎるとき、水,みずはあなたの上,うえにあふれることがない。あなたが火,ひの中,なかを行,いくとき、焼,やかれることもなく、炎,ほのおもあなたに燃,もえつくことがない。","tok":[["あなた"],["が"],["水","みず"],["の"],["中","なか"],["を"],["過ぎる","すぎる"],["とき"],["、"],["わたし"],["は"],["あなた"],["と"],["共","とも"],["に"],["おる"],["。"],["川","かわ"],["の"],["中","なか"],["を"],["過ぎる","すぎる"],["とき"],["、"],["水","みず"],["は"],["あなた"],["の"],["上","うえ"],["に"],["あふれる"],["こと"],["が"],["ない"],["。"],["あなた"],["が"],["火","ひ"],["の"],["中","なか"],["を"],["行く","いく"],["とき"],["、"],["焼かれる","やかれる"],["こと"],["も"],["なく"],["、"],["炎","ほのお"],["も"],["あなた"],["に"],["燃えつく","もえつく"],["こと"],["が"],["ない"],["。"]]},{"verse":3,"text":"わたしはあなたの神,かみ、主,しゅである、イスラエルの聖者,せいじゃ、あなたの救主,すくいぬしである。わたしはエジプトを与,あたえてあなたのあがないしろとし、エチオピヤとセバとをあなたの代,かわりとする。","tok":[["わたし"],["は"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["で"],["ある"],["、"],["イスラエル"],["の"],["聖者","せいじゃ"],["、"],["あなた"],["の"],["救主","す"],["くい"],["ぬし"],["で"],["ある"],["。"],["わたし"],["は"],["エジプト"],["を"],["与","あたえ"],["て"],["あなた"],["の"],["あがない"],["しろ"],["と"],["し"],["、"],["エチオピヤ"],["と"],["セバ"],["と"],["を"],["あなた"],["の"],["代わり","かわり"],["と"],["する"],["。"]]},{"verse":4,"text":"あなたはわが目,めに尊,たっとく、重,おもんぜられるもの、わたしはあなたを愛,あいするがゆえに、あなたの代,かわりに人,ひとを与,あたえ、あなたの命,いのちの代,かわりに民,たみを与,あたえる。","tok":[["あなた"],["は"],["わが"],["目","め"],["に"],["尊","た"],["っと"],["く"],["、"],["重ぜられる","おもんぜられる"],["もの"],["、"],["わたし"],["は"],["あなた"],["を"],["愛する","あいする"],["が"],["ゆえ"],["に"],["、"],["あなた"],["の"],["代わり","かわり"],["に"],["人","ひと"],["を"],["与","あたえ"],["、"],["あなた"],["の"],["命","いのち"],["の"],["代わり","かわり"],["に"],["民","たみ"],["を"],["与える","あたえる"],["。"]]},{"verse":5,"text":"恐,おそれるな、わたしはあなたと共,ともにおる。わたしは、あなたの子孫,しそんを東,ひがしからこさせ、西,にしからあなたを集,あつめる。","tok":[["恐れる","おそれる"],["な"],["、"],["わたし"],["は"],["あなた"],["と"],["共","とも"],["に"],["おる"],["。"],["わたし"],["は"],["、"],["あなた"],["の"],["子孫","しそん"],["を"],["東","ひがし"],["から"],["こさせ"],["、"],["西","にし"],["から"],["あなた"],["を"],["集める","あつめる"],["。"]]},{"verse":6,"text":"わたしは北,きたにむかって『ゆるせ』と言,いい、南,みなみにむかって『留,とめるな』と言,いう。わが子,こらを遠,とおくからこさせ、わが娘,むすめらを地,ちの果,はてからこさせよ。","tok":[["わたし"],["は"],["北","きた"],["に"],["むかって"],["『"],["ゆるせ"],["』"],["と"],["言い","いい"],["、"],["南","みなみ"],["に"],["むかって"],["『"],["留める","とめる"],["な"],["』"],["と"],["言う","いう"],["。"],["わが"],["子","こ"],["ら"],["を"],["遠く","とおく"],["から"],["こさせ"],["、"],["わが"],["娘","むすめ"],["ら"],["を"],["地","ち"],["の"],["果て","はて"],["から"],["こさせ"],["よ"],["。"]]},{"verse":7,"text":"すべてわが名,なをもってとなえられる者,ものをこさせよ。わたしは彼,かれらをわが栄光,えいこうのために創造,そうぞうし、これを造,つくり、これを仕立,したてた」。","tok":[["すべて"],["わが"],["名","な"],["を"],["もって"],["となえられる"],["者","もの"],["を"],["こさせ"],["よ"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["わが"],["栄光","えいこう"],["の"],["ため"],["に"],["創造","そうぞう"],["し"],["、"],["これ"],["を"],["造","つくり"],["、"],["これ"],["を"],["仕立","したて"],["た"],["」"],["。"]]},{"verse":8,"text":"目,めがあっても目,めしいのような民,たみ、耳,みみがあっても耳,みみしいのような民,たみを連,つれ出,だせ。","tok":[["目","め"],["が"],["あって"],["も"],["目","め"],["しい"],["の"],["よう"],["な"],["民","たみ"],["、"],["耳","みみ"],["が"],["あって"],["も"],["耳","みみ"],["しい"],["の"],["よう"],["な"],["民","たみ"],["を"],["連れ出せ","つれだせ"],["。"]]},{"verse":9,"text":"国々,くにぐにはみな相,あいつどい、もろもろの民,たみは集,あつまれ。彼,かれらのうち、だれがこの事,ことを告,つげ、さきの事,ことどもを、われわれに聞,きかせることができるか。その証人,しょうにんを出,だして、おのれの正,ただしい事,ことを証明,しょうめいさせ、それを聞,きいて「これは真実,しんじつだ」と言,いわせよ。","tok":[["国々","くにぐに"],["は"],["みな"],["相","あい"],["つどい"],["、"],["もろもろ"],["の"],["民","たみ"],["は"],["集まれ","あつまれ"],["。"],["彼","かれ"],["ら"],["の"],["うち"],["、"],["だれ"],["が"],["この"],["事","こと"],["を"],["告","つげ"],["、"],["さき"],["の"],["事","こと"],["ども"],["を"],["、"],["われわれ"],["に"],["聞かせる","きかせる"],["こと"],["が"],["できる"],["か"],["。"],["その"],["証人","しょうにん"],["を"],["出して","だして"],["、"],["おのれ"],["の"],["正い","ただしい"],["事","こと"],["を"],["証明","しょうめい"],["させ"],["、"],["それ"],["を"],["聞いて","きいて"],["「"],["これ"],["は"],["真実","しんじつ"],["だ"],["」"],["と"],["言わせ","いわせ"],["よ"],["。"]]},{"verse":10,"text":"主,しゅは言,いわれる、「あなたがたはわが証人,しょうにん、わたしが選,えらんだわがしもべである。それゆえ、あなたがたは知,しって、わたしを信,しんじ、わたしが主,しゅであることを悟,さとることができる。わたしより前,まえに造,つくられた神,かみはなく、わたしより後,のちにもない。","tok":[["主","しゅ"],["は"],["言われる","いわれる"],["、"],["「"],["あなた"],["がた"],["は"],["わが"],["証人","しょうにん"],["、"],["わたし"],["が"],["選らんだ","えらんだ"],["わが"],["しもべ"],["で"],["ある"],["。"],["それ"],["ゆえ"],["、"],["あなた"],["がた"],["は"],["知って","しって"],["、"],["わたし"],["を"],["信じ","しんじ"],["、"],["わたし"],["が"],["主","しゅ"],["で"],["ある"],["こと"],["を"],["悟","さとる"],["こと"],["が"],["できる"],["。"],["わたし"],["より"],["前","まえ"],["に"],["造られた","つくられた"],["神","かみ"],["は"],["なく"],["、"],["わたし"],["より"],["後","のち"],["に"],["も"],["ない"],["。"]]},{"verse":11,"text":"ただわたしのみ主,しゅである。わたしのほかに救,すくう者,ものはいない。","tok":[["ただ"],["わたし"],["のみ"],["主","しゅ"],["で"],["ある"],["。"],["わたし"],["の"],["ほか"],["に"],["救う","すくう"],["者","もの"],["は"],["いない"],["。"]]},{"verse":12,"text":"わたしはさきに告,つげ、かつ救,すくい、かつ聞,きかせた。あなたがたのうちには、ほかの神,かみはなかった。あなたがたはわが証人,しょうにんである」と主,しゅは言,いわれる。","tok":[["わたし"],["は"],["さき"],["に"],["告","つげ"],["、"],["かつ"],["救い","すくい"],["、"],["かつ"],["聞かせた","きかせた"],["。"],["あなた"],["がた"],["の"],["うち"],["に"],["は"],["、"],["ほか"],["の"],["神","かみ"],["は"],["なかった"],["。"],["あなた"],["がた"],["は"],["わが"],["証人","しょうにん"],["で"],["ある"],["」"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":13,"text":"「わたしは神,かみである、今,いまより後,のちもわたしは主,しゅである。わが手,てから救,すくい出,だしうる者,ものはない。わたしがおこなえば、だれが、これをとどめることができよう」。","tok":[["「"],["わたし"],["は"],["神","かみ"],["で"],["ある"],["、"],["今","いま"],["より"],["後","のち"],["も"],["わたし"],["は"],["主","しゅ"],["で"],["ある"],["。"],["わが"],["手","て"],["から"],["救い出し","すくいだし"],["うる"],["者","もの"],["は"],["ない"],["。"],["わたし"],["が"],["おこなえば"],["、"],["だれ"],["が"],["、"],["これ"],["を"],["とどめる"],["こと"],["が"],["できよう"],["」"],["。"]]},{"verse":14,"text":"あなたがたをあがなう者,もの、イスラエルの聖者,せいじゃ、主,しゅはこう言,いわれる、「あなたがたのために、わたしは人,ひとをバビロンにつかわし、すべての貫,かんの木,きをこわし、カルデヤびとの喜,よろこびの声,こえを嘆,なげきに変,かわらせる。","tok":[["あなた"],["がた"],["を"],["あがなう"],["者","もの"],["、"],["イスラエル"],["の"],["聖者","せいじゃ"],["、"],["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["「"],["あなた"],["がた"],["の"],["ため"],["に"],["、"],["わたし"],["は"],["人","ひと"],["を"],["バビロン"],["に"],["つかわし"],["、"],["すべて"],["の"],["貫の木","かんのき"],["を"],["こわし"],["、"],["カルデヤ"],["びと"],["の"],["喜こび","よろこび"],["の"],["声","こえ"],["を"],["嘆き","なげき"],["に"],["変わらせる","かわらせる"],["。"]]},{"verse":15,"text":"わたしは主,しゅ、あなたがたの聖者,せいじゃ、イスラエルの創造者,そうぞうしゃ、あなたがたの王,おうである」。","tok":[["わたし"],["は"],["主","しゅ"],["、"],["あなた"],["がた"],["の"],["聖者","せいじゃ"],["、"],["イスラエル"],["の"],["創造者","そうぞうしゃ"],["、"],["あなた"],["がた"],["の"],["王","おう"],["で"],["ある"],["」"],["。"]]},{"verse":16,"text":"海,うみのなかに大路,おおじを設,もうけ、大,おおいなる水,みずの中,なかに道,みちをつくり、","tok":[["海","うみ"],["の"],["なか"],["に"],["大路","おおじ"],["を"],["設け","もうけ"],["、"],["大いなる","おおいなる"],["水","みず"],["の"],["中","なか"],["に"],["道","みち"],["を"],["つくり"],["、"]]},{"verse":17,"text":"戦車,せんしゃおよび馬,うま、軍勢,ぐんぜいおよび兵士,へいしを出,でてこさせ、これを倒,たおして起,おきることができないようにし、絶,たえ滅,ほろぼして、灯心,とうしんの消,きえうせるようにされる主,しゅはこう言,いわれる、","tok":[["戦車","せんしゃ"],["および"],["馬","うま"],["、"],["軍勢","ぐんぜい"],["および"],["兵士","へいし"],["を"],["出て","でて"],["こさせ"],["、"],["これ"],["を"],["倒して","たおして"],["起きる","おきる"],["こと"],["が"],["できない"],["よう"],["に"],["し"],["、"],["絶え","たえ"],["滅ぼして","ほろぼして"],["、"],["灯心","とうしん"],["の"],["消えうせる","きえうせる"],["よう"],["に"],["される"],["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"]]},{"verse":18,"text":"「あなたがたは、さきの事,ことを思,おもい出,だしてはならない、また、いにしえのことを考,かんがえてはならない。","tok":[["「"],["あなた"],["がた"],["は"],["、"],["さき"],["の"],["事","こと"],["を"],["思い出して","おもいだして"],["は"],["ならない"],["、"],["また"],["、"],["いにしえ"],["の"],["こと"],["を"],["考","かんがえ"],["ては"],["ならない"],["。"]]},{"verse":19,"text":"見,みよ、わたしは新,あたらしい事,ことをなす。やがてそれは起,おこる、あなたがたはそれを知,しらないのか。わたしは荒野,あらのに道,みちを設,もうけ、さばくに川,かわを流,ながれさせる。","tok":[["見よ","みよ"],["、"],["わたし"],["は"],["新らしい","あたらしい"],["事","こと"],["を"],["なす"],["。"],["やがて"],["それ"],["は"],["起こる","おこる"],["、"],["あなた"],["がた"],["は"],["それ"],["を"],["知らない","しらない"],["の"],["か"],["。"],["わたし"],["は"],["荒野","あら"],["のに"],["道","みち"],["を"],["設け","もうけ"],["、"],["さばく"],["に"],["川","かわ"],["を"],["流れさせる","ながれさせる"],["。"]]},{"verse":20,"text":"野,のの獣,けものはわたしをあがめ、山犬,やまいぬおよび、だちょうもわたしをあがめる。わたしが荒野,あらのに水,みずをいだし、さばくに川,かわを流,ながれさせて、わたしの選,えらんだ民,たみに飲,のませるからだ。","tok":[["野","の"],["の"],["獣","けもの"],["は"],["わたし"],["を"],["あがめ"],["、"],["山犬","やまいぬ"],["および"],["、"],["だちょう"],["も"],["わたし"],["を"],["あがめる"],["。"],["わたし"],["が"],["荒野","あらの"],["に"],["水","みず"],["を"],["いだし"],["、"],["さばく"],["に"],["川","かわ"],["を"],["流れさせて","ながれさせて"],["、"],["わたし"],["の"],["選","え"],["らんだ"],["民","たみ"],["に"],["飲ませる","のませる"],["から"],["だ"],["。"]]},{"verse":21,"text":"この民,たみは、わが誉,ほまれを述,のべさせるためにわたしが自分,じぶんのために造,つくったものである。","tok":[["この"],["民","たみ"],["は"],["、"],["わが"],["誉","ほまれ"],["を"],["述べさせる","のべさせる"],["ため"],["に"],["わたし"],["が"],["自分","じぶん"],["の"],["ため"],["に"],["造った","つくった"],["もの"],["で"],["ある"],["。"]]},{"verse":22,"text":"ところがヤコブよ、あなたはわたしを呼,よばなかった。イスラエルよ、あなたはわたしをうとんじた。","tok":[["ところ"],["が"],["ヤコブ"],["よ"],["、"],["あなた"],["は"],["わたし"],["を"],["呼ばなかった","よばなかった"],["。"],["イスラエル"],["よ"],["、"],["あなた"],["は"],["わたし"],["を"],["うとんじた"],["。"]]},{"verse":23,"text":"あなたは燔祭,はんさいの羊,ひつじをわたしに持,もってこなかった。また犠牲,ぎせいをもってわたしをあがめなかった。わたしは供,そなえ物,ものの重荷,おもにをあなたに負,おわせなかった。また乳香,にゅうこうをもってあなたを煩,わずらわさなかった。","tok":[["あなた"],["は"],["燔祭","はんさい"],["の"],["羊","ひつじ"],["を"],["わたし"],["に"],["持って","もって"],["こなかった"],["。"],["また"],["犠牲","ぎせい"],["を"],["もって"],["わたし"],["を"],["あがめなかった"],["。"],["わたし"],["は"],["供え物","そなえもの"],["の"],["重荷","おもに"],["を"],["あなた"],["に"],["負わせなかった","おわせなかった"],["。"],["また"],["乳香","にゅうこう"],["を"],["もって"],["あなた"],["を"],["煩わさなかった","わずらわさなかった"],["。"]]},{"verse":24,"text":"あなたは金,かねを出,だして、わたしのために菖蒲,しょうぶを買,かわず、犠牲,ぎせいの脂肪,しぼうを供,そなえて、わたしを飽,あかせず、かえって、あなたの罪,つみの重荷,おもにをわたしに負,おわせ、あなたの不義,ふぎをもって、わたしを煩,わずらわせた。","tok":[["あなた"],["は"],["金","かね"],["を"],["出して","だして"],["、"],["わたし"],["の"],["ため"],["に"],["菖蒲","しょうぶ"],["を"],["買わず","かわず"],["、"],["犠牲","ぎせい"],["の"],["脂肪","しぼう"],["を"],["供えて","そなえて"],["、"],["わたし"],["を"],["飽かせず","あかせず"],["、"],["かえって"],["、"],["あなた"],["の"],["罪","つみ"],["の"],["重荷","おもに"],["を"],["わたし"],["に"],["負わせ","おわせ"],["、"],["あなた"],["の"],["不義","ふぎ"],["を"],["もって"],["、"],["わたし"],["を"],["煩わせた","わずらわせた"],["。"]]},{"verse":25,"text":"わたしこそ、わたし自身,じしんのためにあなたのとがを消,けす者,ものである。わたしは、あなたの罪,つみを心,こころにとめない。","tok":[["わたし"],["こそ"],["、"],["わたし"],["自身","じしん"],["の"],["ため"],["に"],["あなた"],["の"],["とが"],["を"],["消す","けす"],["者","もの"],["で"],["ある"],["。"],["わたし"],["は"],["、"],["あなた"],["の"],["罪","つみ"],["を"],["心","こころ"],["に"],["とめない"],["。"]]},{"verse":26,"text":"あなたは、自分,じぶんの正,ただしいことを証明,しょうめいするために自分,じぶんのことを述,のべて、わたしに思,おもい出,ださせよ。われわれは共,ともに論,ろんじよう。","tok":[["あなた"],["は"],["、"],["自分","じぶん"],["の"],["正い","ただしい"],["こと"],["を"],["証明","しょうめい"],["する"],["ため"],["に"],["自分","じぶん"],["の"],["こと"],["を"],["述べて","のべて"],["、"],["わたし"],["に"],["思い出させ","おもいださせ"],["よ"],["。"],["われわれ"],["は"],["共","とも"],["に"],["論じよう","ろんじよう"],["。"]]},{"verse":27,"text":"あなたの遠,とおい先祖,せんぞは罪,つみを犯,おかし、あなたの仲保者,ちゅうほしゃらはわたしにそむいた。","tok":[["あなた"],["の"],["遠い","とおい"],["先祖","せんぞ"],["は"],["罪","つみ"],["を"],["犯し","おかし"],["、"],["あなた"],["の"],["仲保者","ちゅうほしゃら"],["は"],["わたし"],["に"],["そむいた"],["。"]]},{"verse":28,"text":"それゆえ、わたしは聖所,せいじょの君,きみたちを汚,けがし、ヤコブを全,まったき滅,ほろびにわたし、イスラエルをののしらしめた。","tok":[["それ"],["ゆえ"],["、"],["わたし"],["は"],["聖","せい"],["所","しょ"],["の"],["君","きみ"],["たち"],["を"],["汚","け"],["がし"],["、"],["ヤコブ"],["を"],["全","ま"],["っ"],["たき"],["滅び","ほろび"],["に"],["わたし"],["、"],["イスラエル"],["を"],["ののしらしめた"],["。"]]}]
[{"verse":1,"text":"ヤコブの家,いえよ、これを聞,きけ。あなたがたはイスラエルの名,なをもってとなえられ、ユダの腰,こしから出,で、主,しゅの名,なによって誓,ちかい、イスラエルの神,かみをとなえるけれども、真実,しんじつをもってせず、正義,せいぎをもってしない。","tok":[["ヤコブ"],["の"],["家","いえ"],["よ"],["、"],["これ"],["を"],["聞け","きけ"],["。"],["あなた"],["がた"],["は"],["イスラエル"],["の"],["名","な"],["を"],["もって"],["となえられ"],["、"],["ユダ"],["の"],["腰","こし"],["から"],["出","で"],["、"],["主","しゅ"],["の"],["名","な"],["によって"],["誓い","ちかい"],["、"],["イスラエル"],["の"],["神","かみ"],["を"],["となえる"],["けれど"],["も"],["、"],["真実","しんじつ"],["を"],["もって"],["せず"],["、"],["正義","せいぎ"],["を"],["もって"],["しない"],["。"]]},{"verse":2,"text":"彼,かれらはみずから聖,せいなる都,みやこのものととなえ、イスラエルの神,かみに寄,より頼,たのむ。その名,なは万軍,ばんぐんの主,しゅという。","tok":[["彼","かれ"],["ら"],["は"],["みずから"],["聖","せい"],["なる"],["都","みやこ"],["の"],["もの"],["と"],["となえ"],["、"],["イスラエル"],["の"],["神","かみ"],["に"],["寄り","より"],["頼む","たのむ"],["。"],["その"],["名","な"],["は"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["と"],["いう"],["。"]]},{"verse":3,"text":"「わたしはさきに成,なった事,ことを、いにしえから告,つげた。わたしは口,くちから出,だして彼,かれらに知,しらせた。わたしは、にわかにこの事,ことを行,おこない、そして成,なった。","tok":[["「"],["わたし"],["は"],["さき"],["に"],["成った","なった"],["事","こと"],["を"],["、"],["いにしえ"],["から"],["告","つげ"],["た"],["。"],["わたし"],["は"],["口","くち"],["から"],["出して","だして"],["彼","かれ"],["ら"],["に"],["知らせた","しらせた"],["。"],["わたし"],["は"],["、"],["にわか"],["に"],["この"],["事","こと"],["を"],["行ない","おこない"],["、"],["そして"],["成った","なった"],["。"]]},{"verse":4,"text":"わたしはあなたが、かたくなで、その首,くびは鉄,てつの筋,すじ、その額,ひたいは青銅,せいどうであることを知,しるゆえに、","tok":[["わたし"],["は"],["あなた"],["が"],["、"],["かたくな"],["で"],["、"],["その"],["首","くび"],["は"],["鉄","てつ"],["の"],["筋","すじ"],["、"],["その"],["額","ひたい"],["は"],["青銅","せいどう"],["で"],["ある"],["こと"],["を"],["知る","しる"],["ゆえ"],["に"],["、"]]},{"verse":5,"text":"いにしえから、かの事,ことをあなたに告,つげ、その成,ならないさきに、これをあなたに聞,きかせた。そうでなければ、あなたは言,いうだろう、『わが偶像,ぐうぞうがこれをしたのだ、わが刻,きざんだ像,ぞうと、鋳,いた像,ぞうがこれを命,めいじたのだ』と。","tok":[["いにしえ"],["から"],["、"],["かの"],["事","こと"],["を"],["あなた"],["に"],["告","つげ"],["、"],["その"],["成らない","ならない"],["さき"],["に"],["、"],["これ"],["を"],["あなた"],["に"],["聞かせた","きかせた"],["。"],["そう"],["で"],["なければ"],["、"],["あなた"],["は"],["言うだろう","いうだろう"],["、"],["『"],["わが"],["偶像","ぐうぞう"],["が"],["これ"],["を"],["した"],["の"],["だ"],["、"],["わが"],["刻んだ","きざんだ"],["像","ぞう"],["と"],["、"],["鋳た","いた"],["像","ぞう"],["が"],["これ"],["を"],["命じた","めいじた"],["の"],["だ"],["』"],["と"],["。"]]},{"verse":6,"text":"あなたはすでに聞,きいた、すべてこれが成,なったことを見,みよ。あなたがたはこれを宣,のべ伝,つたえないのか。わたしは今,いまから新,あたらしい事,こと、あなたがまだ知,しらない隠,かくれた事,ことをあなたに聞,きかせよう。","tok":[["あなた"],["は"],["すでに"],["聞いた","きいた"],["、"],["すべて"],["これ"],["が"],["成った","なった"],["こと"],["を"],["見よ","みよ"],["。"],["あなた"],["がた"],["は"],["これ"],["を"],["宣べ伝えない","のべつたえない"],["の"],["か"],["。"],["わたし"],["は"],["今","いま"],["から"],["新らしい","あたらしい"],["事","こと"],["、"],["あなた"],["が"],["まだ"],["知らない","しらない"],["隠れた","かくれた"],["事","こと"],["を"],["あなた"],["に"],["聞かせよう","きかせよう"],["。"]]},{"verse":7,"text":"これらの事,ことはいま創造,そうぞうされたので、いにしえからあったのではない。この日,ひ以前,いぜんには、あなたはこれを聞,きかなかった。そうでなければ、あなたは言,いうだろう、『見,みよ、わたしはこれを知,しっていた』と。","tok":[["これ"],["ら"],["の"],["事","こと"],["は"],["いま"],["創造","そうぞう"],["された"],["ので"],["、"],["いにしえ"],["から"],["あった"],["ので"],["は"],["ない"],["。"],["この"],["日","ひ"],["以前","いぜん"],["に"],["は"],["、"],["あなた"],["は"],["これ"],["を"],["聞かなかった","きかなかった"],["。"],["そう"],["で"],["なければ"],["、"],["あなた"],["は"],["言うだろう","いうだろう"],["、"],["『"],["見よ","みよ"],["、"],["わたし"],["は"],["これ"],["を"],["知って","しって"],["いた"],["』"],["と"],["。"]]},{"verse":8,"text":"あなたはこれを聞,きくこともなく、知,しることもなく、あなたの耳,みみは、いにしえから開,ひらかれなかった。わたしはあなたが全,まったく不信実,ふしんじつで、生,うまれながら反逆者,はんぎゃくしゃととなえられたことを知,しっていたからである。","tok":[["あなた"],["は"],["これ"],["を"],["聞く","きく"],["こと"],["も"],["なく"],["、"],["知る","しる"],["こと"],["も"],["なく"],["、"],["あなた"],["の"],["耳","みみ"],["は"],["、"],["いにしえ"],["から"],["開らかれなかった","ひらかれなかった"],["。"],["わたし"],["は"],["あなた"],["が"],["全く","まったく"],["不","ふ"],["信実","しんじつ"],["で"],["、"],["生まれ","うまれ"],["ながら"],["反逆者","はんぎゃくしゃ"],["と"],["となえられた"],["こと"],["を"],["知って","しって"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":9,"text":"わが名,なのために、わたしは怒,いかりをおそくする。わが誉,ほまれのために、わたしはこれをおさえて、あなたを断,たち滅,ほろぼすことをしない。","tok":[["わが"],["名","な"],["の"],["ため"],["に"],["、"],["わたし"],["は"],["怒り","いかり"],["を"],["おそく"],["する"],["。"],["わが"],["誉","ほまれ"],["の"],["ため"],["に"],["、"],["わたし"],["は"],["これ"],["を"],["おさえて"],["、"],["あなた"],["を"],["断ち","たち"],["滅ぼす","ほろぼす"],["こと"],["を"],["しない"],["。"]]},{"verse":10,"text":"見,みよ、わたしはあなたを練,ねった。しかし銀,ぎんのようにではなくて、苦,くるしみの炉,ろをもってあなたを試,こころみた。","tok":[["見よ","みよ"],["、"],["わたし"],["は"],["あなた"],["を"],["練った","ねった"],["。"],["しかし"],["銀","ぎん"],["の"],["よう"],["にで"],["は"],["なくて"],["、"],["苦しみ","くるしみ"],["の"],["炉","ろ"],["を"],["もって"],["あなた"],["を"],["試みた","こころみた"],["。"]]},{"verse":11,"text":"わたしは自分,じぶんのために、自分,じぶんのためにこれを行,おこなう。どうしてわが名,なを汚,けがさせることができよう。わたしはわが栄光,えいこうをほかの者,ものに与,あたえることをしない。","tok":[["わたし"],["は"],["自分","じぶん"],["の"],["ため"],["に"],["、"],["自分","じぶん"],["の"],["ため"],["に"],["これ"],["を"],["行なう","おこなう"],["。"],["どう"],["して"],["わが"],["名","な"],["を"],["汚","け"],["が"],["させる"],["こと"],["が"],["できよう"],["。"],["わたし"],["は"],["わが"],["栄光","えいこう"],["を"],["ほか"],["の"],["者","もの"],["に"],["与える","あたえる"],["こと"],["を"],["しない"],["。"]]},{"verse":12,"text":"ヤコブよ、わたしの召,めしたイスラエルよ、わたしに聞,きけ。わたしはそれだ、わたしは初,はじめであり、わたしはまた終,おわりである。","tok":[["ヤコブ"],["よ"],["、"],["わたし"],["の"],["召","めし"],["た"],["イスラエル"],["よ"],["、"],["わたし"],["に"],["聞け","きけ"],["。"],["わたし"],["は"],["それ"],["だ"],["、"],["わたし"],["は"],["初め","はじめ"],["で"],["あり"],["、"],["わたし"],["は"],["また"],["終","おわり"],["で"],["ある"],["。"]]},{"verse":13,"text":"わが手,ては地,ちの基,もといをすえ、わが右,みぎの手,ては天,てんをのべた。わたしが呼,よぶと、彼,かれらはもろともに立,たつ。","tok":[["わが"],["手","て"],["は"],["地","ち"],["の"],["基い","もとい"],["を"],["すえ"],["、"],["わが"],["右","みぎ"],["の"],["手","て"],["は"],["天","てん"],["を"],["のべた"],["。"],["わたし"],["が"],["呼ぶ","よぶ"],["と"],["、"],["彼","かれ"],["ら"],["は"],["もろとも"],["に"],["立つ","たつ"],["。"]]},{"verse":14,"text":"あなたがたは皆,みな集,あつまって聞,きけ。彼,かれらのうち、だれがこれらの事,ことを告,つげたか。主,しゅの愛,あいせられる彼,かれは主,しゅのみこころをバビロンに行,おこない、その腕,うではカルデヤびとの上,うえに臨,のぞむ。","tok":[["あなた"],["がた"],["は"],["皆","みな"],["集まって","あつまって"],["聞け","きけ"],["。"],["彼","かれ"],["ら"],["の"],["うち"],["、"],["だれ"],["が"],["これ"],["ら"],["の"],["事","こと"],["を"],["告","つげ"],["た"],["か"],["。"],["主","しゅ"],["の"],["愛せられる","あいせられる"],["彼","かれ"],["は"],["主","しゅ"],["のみ"],["こころ"],["を"],["バビロン"],["に"],["行ない","おこない"],["、"],["その"],["腕","うで"],["は"],["カルデヤ"],["びと"],["の"],["上","うえ"],["に"],["臨む","のぞむ"],["。"]]},{"verse":15,"text":"語,かたったのは、ただわたしであって、わたしは彼,かれを召,めした。わたしは彼,かれをこさせた。彼,かれはその道,みちに栄,さかえる。","tok":[["語った","かたった"],["の"],["は"],["、"],["ただ"],["わたし"],["で"],["あって"],["、"],["わたし"],["は"],["彼","かれ"],["を"],["召","めし"],["た"],["。"],["わたし"],["は"],["彼","かれ"],["を"],["こさせた"],["。"],["彼","かれ"],["は"],["その"],["道","みち"],["に"],["栄","さかえ"],["る"],["。"]]},{"verse":16,"text":"あなたがたはわたしに近寄,ちかよって、これを聞,きけ。わたしは初,はじめから、ひそかに語,かたらなかった。それが成,なった時,ときから、わたしはそこにいたのだ」。いま主,しゅなる神,かみは、わたしとその霊,れいとをつかわされた。","tok":[["あなた"],["がた"],["は"],["わたし"],["に"],["近寄って","ちかよって"],["、"],["これ"],["を"],["聞け","きけ"],["。"],["わたし"],["は"],["初め","はじめ"],["から"],["、"],["ひそか"],["に"],["語らなかった","かたらなかった"],["。"],["それ"],["が"],["成った","なった"],["時","とき"],["から"],["、"],["わたし"],["は"],["そこ"],["に"],["いた"],["の"],["だ"],["」"],["。"],["いま"],["主","しゅ"],["なる"],["神","かみ"],["は"],["、"],["わたし"],["と"],["その"],["霊","れい"],["と"],["を"],["つかわされた"],["。"]]},{"verse":17,"text":"あなたのあがない主,しゅ、イスラエルの聖者,せいじゃ、主,しゅはこう言,いわれる、「わたしはあなたの神,かみ、主,しゅである。わたしは、あなたの利益,りえきのために、あなたを教,おしえ、あなたを導,みちびいて、その行,いくべき道,みちに行,いかせる。","tok":[["あなた"],["の"],["あがない"],["主","しゅ"],["、"],["イスラエル"],["の"],["聖者","せいじゃ"],["、"],["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["「"],["わたし"],["は"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["で"],["ある"],["。"],["わたし"],["は"],["、"],["あなた"],["の"],["利益","りえき"],["の"],["ため"],["に"],["、"],["あなた"],["を"],["教え","おしえ"],["、"],["あなた"],["を"],["導いて","みちびいて"],["、"],["その"],["行くべき","いくべき"],["道","みち"],["に"],["行かせる","いかせる"],["。"]]},{"verse":18,"text":"どうか、あなたはわたしの戒,いましめに聞,きき従,したがうように。そうすれば、あなたの平安,へいあんは川,かわのように、あなたの義,ぎは海,うみの波,なみのようになり、","tok":[["どう"],["か"],["、"],["あなた"],["は"],["わたし"],["の"],["戒しめ","いましめ"],["に"],["聞","きき"],["従う","したがう"],["よう"],["に"],["。"],["そう"],["すれば"],["、"],["あなた"],["の"],["平安","へいあん"],["は"],["川","かわ"],["の"],["よう"],["に"],["、"],["あなた"],["の"],["義","ぎ"],["は"],["海","うみ"],["の"],["波","なみ"],["の"],["よう"],["に"],["なり"],["、"]]},{"verse":19,"text":"あなたのすえは砂,すなのように、あなたの子孫,しそんは砂粒,すなつぶのようになって、その名,なはわが前,まえから断,たたれることなく、滅,ほろぼされることはない」。","tok":[["あなた"],["の"],["すえ"],["は"],["砂","すな"],["の"],["よう"],["に"],["、"],["あなた"],["の"],["子孫","しそん"],["は"],["砂粒","すなつぶ"],["の"],["よう"],["に"],["なって"],["、"],["その"],["名","な"],["は"],["わが"],["前","まえ"],["から"],["断たれる","たたれる"],["こと"],["なく"],["、"],["滅ぼされる","ほろぼされる"],["こと"],["は"],["ない"],["」"],["。"]]},{"verse":20,"text":"あなたがたはバビロンから出,で、カルデヤからのがれよ。喜,よろこびの声,こえをもってこれをのべ聞,きかせ、地,ちの果,はてにまで語,かたり伝,つたえ、「主,しゅはそのしもべヤコブをあがなわれた」と言,いえ。","tok":[["あなた"],["がた"],["は"],["バビロン"],["から"],["出","で"],["、"],["カルデヤ"],["から"],["のがれ"],["よ"],["。"],["喜こび","よろこび"],["の"],["声","こえ"],["を"],["もって"],["これ"],["を"],["のべ"],["聞かせ","きかせ"],["、"],["地","ち"],["の"],["果て","はて"],["に"],["まで"],["語り伝え","かたりつたえ"],["、"],["「"],["主","しゅ"],["は"],["その"],["しもべ"],["ヤコブ"],["を"],["あがなわれた"],["」"],["と"],["言え","いえ"],["。"]]},{"verse":21,"text":"主,しゅが彼,かれらを導,みちびいて、さばくを通,とおらせられたとき、彼,かれらは、かわいたことがなかった。主,しゅは彼,かれらのために岩,いわから水,みずを流,ながれさせ、また岩,いわを裂,さかれると、水,みずがほとばしり出,でた。","tok":[["主","しゅ"],["が"],["彼","かれ"],["ら"],["を"],["導いて","みちびいて"],["、"],["さばく"],["を"],["通らせられた","とおらせられた"],["とき"],["、"],["彼","かれ"],["ら"],["は"],["、"],["かわいた"],["こと"],["が"],["なかった"],["。"],["主","しゅ"],["は"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["岩","いわ"],["から"],["水","みず"],["を"],["流れさせ","ながれさせ"],["、"],["また"],["岩","いわ"],["を"],["裂かれる","さかれる"],["と"],["、"],["水","みず"],["が"],["ほとばしり出た","ほとばしりでた"],["。"]]},{"verse":22,"text":"主,しゅは言,いわれた、「悪,わるい者,ものには平安,へいあんがない」と。","tok":[["主","しゅ"],["は"],["言われた","いわれた"],["、"],["「"],["悪い","わるい"],["者","もの"],["に"],["は"],["平安","へいあん"],["が"],["ない"],["」"],["と"],["。"]]}]
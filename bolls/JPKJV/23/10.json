[{"verse":1,"text":"わざわいなるかな、不義,ふぎの判決,はんけつを下,くだす者,もの、暴虐,ぼうぎゃくの宣告,せんこくを書,かきしるす者,もの。","tok":[["わざわい"],["なる"],["か"],["な"],["、"],["不義","ふぎ"],["の"],["判決","はんけつ"],["を"],["下す","くだす"],["者","もの"],["、"],["暴虐","ぼうぎゃく"],["の"],["宣告","せんこく"],["を"],["書きしるす","かきしるす"],["者","もの"],["。"]]},{"verse":2,"text":"彼,かれらは乏,とぼしい者,ものの訴,うったえを引,ひき受,うけず、わが民,たみのうちの貧,まずしい者,ものの権利,けんりをはぎ、寡婦,かふの資産,しさんを奪,うばい、みなしごのものをかすめる。","tok":[["彼","かれ"],["ら"],["は"],["乏い","とぼしい"],["者","もの"],["の"],["訴","うったえ"],["を"],["引受","ひきうけ"],["ず"],["、"],["わが"],["民","たみ"],["の"],["うち"],["の"],["貧しい","まずしい"],["者","もの"],["の"],["権利","けんり"],["を"],["はぎ"],["、"],["寡婦","かふ"],["の"],["資産","しさん"],["を"],["奪い","うばい"],["、"],["みなしご"],["の"],["もの"],["を"],["かすめる"],["。"]]},{"verse":3,"text":"あなたがたは刑罰,けいばつの日,ひがきたなら、何,なにをしようとするのか。大風,おおかぜが遠,とおくから来,くるとき、何,なにをしようとするのか。あなたがたはのがれていって、だれに助,たすけを求,もとめようとするのか。また、どこにあなたがたの富,とみを残,のこそうとするのか。","tok":[["あなた"],["がた"],["は"],["刑罰","けいばつ"],["の"],["日","ひ"],["が"],["きたなら"],["、"],["何に","なに"],["を"],["しよう"],["と"],["する"],["の"],["か"],["。"],["大風","お"],["おかぜ"],["が"],["遠く","とおく"],["から"],["来る","くる"],["とき"],["、"],["何に","なに"],["を"],["しよう"],["と"],["する"],["の"],["か"],["。"],["あなた"],["がた"],["は"],["のがれて"],["いって"],["、"],["だれ"],["に"],["助け","たすけ"],["を"],["求めよう","もとめよう"],["と"],["する"],["の"],["か"],["。"],["また"],["、"],["どこ"],["に"],["あなた"],["がた"],["の"],["富","とみ"],["を"],["残そう","のこそう"],["と"],["する"],["の"],["か"],["。"]]},{"verse":4,"text":"ただ捕,とらわれた者,ものの中,なかにかがみ、殺,ころされた者,ものの中,なかに伏,ふし倒,たおれるのみだ。それでも主,しゅの怒,いかりはやまず、なおも、そのみ手,てを伸,のばされる。","tok":[["ただ"],["捕らわれた","とらわれた"],["者","もの"],["の"],["中","なか"],["に"],["かがみ"],["、"],["殺ろされた","ころされた"],["者","もの"],["の"],["中","なか"],["に"],["伏し","ふし"],["倒れる","たおれる"],["のみ"],["だ"],["。"],["それ"],["で"],["も"],["主","しゅ"],["の"],["怒り","いかり"],["は"],["やまず"],["、"],["なお"],["も"],["、"],["その"],["み手","みて"],["を"],["伸ばされる","のばされる"],["。"]]},{"verse":5,"text":"ああ、アッスリヤはわが怒,いかりのつえ、わが憤,いきどおりのむちだ。","tok":[["ああ"],["、"],["アッスリヤ"],["は"],["わが"],["怒り","いかり"],["の"],["つえ"],["、"],["わが"],["憤り","いきどおり"],["の"],["むち"],["だ"],["。"]]},{"verse":6,"text":"わたしは彼,かれをつかわして不信,ふしんの国,くにを攻,せめ、彼,かれに命,めいじてわが怒,いかりの民,たみを攻,せめ、かすめ奪,うばわせ、彼,かれらをちまたの泥,どろのように踏,ふみにじらせる。","tok":[["わたし"],["は"],["彼","かれ"],["を"],["つかわして"],["不信","ふしん"],["の"],["国","くに"],["を"],["攻め","せめ"],["、"],["彼","かれ"],["に"],["命じて","めいじて"],["わが"],["怒り","いかり"],["の"],["民","たみ"],["を"],["攻め","せめ"],["、"],["かすめ"],["奪わせ","うばわせ"],["、"],["彼","かれ"],["ら"],["を"],["ちまた"],["の"],["泥","どろ"],["の"],["よう"],["に"],["踏みにじらせる","ふみにじらせる"],["。"]]},{"verse":7,"text":"しかし彼,かれはそのようには思,おもわず、その心,こころもそのようには考,かんがえず、かえってその心,こころは滅,ほろぼすことを思,おもい、あまたの国々,くにぐにを倒,たおそうとする。","tok":[["しかし"],["彼","かれ"],["は"],["その"],["よう"],["に"],["は"],["思わず","おもわず"],["、"],["その"],["心","こころ"],["も"],["その"],["よう"],["に"],["は"],["考","かんがえ"],["ず"],["、"],["かえって"],["その"],["心","こころ"],["は"],["滅ぼす","ほろぼす"],["こと"],["を"],["思い","おもい"],["、"],["あまた"],["の"],["国々","くにぐに"],["を"],["倒そう","たおそう"],["と"],["する"],["。"]]},{"verse":8,"text":"彼,かれは言,いう、「わが諸侯,しょこうはみな王,おうではないか。","tok":[["彼","かれ"],["は"],["言う","いう"],["、"],["「"],["わが"],["諸侯","しょこう"],["は"],["みな"],["王","おう"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":9,"text":"カルノはカルケミシのようではないか。ハマテはアルパデのようではないか。サマリヤはダマスコのようではないか。","tok":[["カルノ"],["は"],["カルケミシ"],["の"],["よう"],["で"],["は"],["ない"],["か"],["。"],["ハマテ"],["は"],["アルパデ"],["の"],["よう"],["で"],["は"],["ない"],["か"],["。"],["サマリヤ"],["は"],["ダマスコ"],["の"],["よう"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":10,"text":"わが手,ては偶像,ぐうぞうに仕,つかえる国々,くにぐにに伸,のびた。その彫,ほった像,ぞうはエルサレムおよびサマリヤのものにまさっていた。","tok":[["わが"],["手","て"],["は"],["偶像","ぐうぞう"],["に"],["仕える","つかえる"],["国々","くにぐに"],["に"],["伸びた","のびた"],["。"],["その"],["彫った","ほった"],["像","ぞう"],["は"],["エルサレム"],["および"],["サマリヤ"],["の"],["もの"],["に"],["まさって"],["いた"],["。"]]},{"verse":11,"text":"わたしはサマリヤとその偶像,ぐうぞうに行,いったように、エルサレムとその偶像,ぐうぞうに行,おこなわぬであろうか」。","tok":[["わたし"],["は"],["サマリヤ"],["と"],["その"],["偶像","ぐうぞう"],["に"],["行った","いった"],["よう"],["に"],["、"],["エルサレム"],["と"],["その"],["偶像","ぐうぞう"],["に"],["行なわぬで","おこなわぬで"],["あろう"],["か"],["」"],["。"]]},{"verse":12,"text":"主,しゅがシオンの山,やまとエルサレムとになそうとすることを、ことごとくなし遂,とげられた時,とき、主,しゅはアッスリヤ王,おうの無礼,ぶれいな言葉,ことばと、その高,たかぶりとを罰,ばっせられる。","tok":[["主","しゅ"],["が"],["シオン"],["の"],["山","やま"],["と"],["エルサレム"],["と"],["に"],["なそう"],["と"],["する"],["こと"],["を"],["、"],["ことごとく"],["なし遂げられた","なしとげられた"],["時","とき"],["、"],["主","しゅ"],["は"],["アッスリヤ"],["王","おう"],["の"],["無礼","ぶれい"],["な"],["言葉","ことば"],["と"],["、"],["その"],["高ぶり","たかぶり"],["と"],["を"],["罰せられる","ばっせられる"],["。"]]},{"verse":13,"text":"彼,かれは言,いう、「わが手,ての力,ちからにより、またわが知恵,ちえによって、わたしはこれをなした。わたしは賢,かしこいからである。わたしはもろもろの民,たみの境,さかいを除,のぞき、その財宝,ざいほうを奪,うばった。またわたしは雄牛,おうしのように、位,くらいに座,ざする者,ものを引,ひきおろした。","tok":[["彼","かれ"],["は"],["言う","いう"],["、"],["「"],["わが"],["手","て"],["の"],["力","ちから"],["に"],["より"],["、"],["また"],["わが"],["知恵","ちえ"],["によって"],["、"],["わたし"],["は"],["これ"],["を"],["なした"],["。"],["わたし"],["は"],["賢しこい","かしこい"],["から"],["で"],["ある"],["。"],["わたし"],["は"],["もろもろ"],["の"],["民","たみ"],["の"],["境","さかい"],["を"],["除き","のぞき"],["、"],["その"],["財宝","ざいほう"],["を"],["奪った","うばった"],["。"],["また"],["わたし"],["は"],["雄牛","おうし"],["の"],["よう"],["に"],["、"],["位","くらい"],["に"],["座する","ざする"],["者","もの"],["を"],["引","ひき"],["おろした"],["。"]]},{"verse":14,"text":"わが手,ては巣,すを取,とるように、もろもろの民,たみの富,とみを得,えた。またわたしは人々,ひとびとが捨,すてられた卵,たまごを集,あつめるように、全,ぜん地,ちを取,とり集,あつめた。あるいは翼,つばさを動,うごかし、あるいは口,くちを開,ひらき、あるいはぺちゃくちゃ言,いう者,ものもなかった」。","tok":[["わが"],["手","て"],["は"],["巣","す"],["を"],["取る","とる"],["よう"],["に"],["、"],["もろもろ"],["の"],["民","たみ"],["の"],["富","とみ"],["を"],["得た","えた"],["。"],["また"],["わたし"],["は"],["人々","ひとびと"],["が"],["捨てられた","すてられた"],["卵","たまご"],["を"],["集める","あつめる"],["よう"],["に"],["、"],["全地","ぜんち"],["を"],["取集めた","とりあつめた"],["。"],["あるいは"],["翼","つばさ"],["を"],["動かし","うごかし"],["、"],["あるいは"],["口","くち"],["を"],["開らき","ひらき"],["、"],["あるいは"],["ぺちゃくちゃ"],["言う","いう"],["者","もの"],["も"],["なかった"],["」"],["。"]]},{"verse":15,"text":"おのは、それを用,もちいて切,きる者,ものにむかって、自分,じぶんを誇,ほこることができようか。のこぎりは、それを動,うごかす者,ものにむかって、みずから高,たかぶることができようか。これはあたかも、むちが自分,じぶんをあげる者,ものを動,うごかし、つえが木,きでない者,ものをあげようとするのに等,ひとしい。","tok":[["お"],["の"],["は"],["、"],["それ"],["を"],["用いて","もちいて"],["切る","きる"],["者","もの"],["に"],["むかって"],["、"],["自分","じぶん"],["を"],["誇る","ほこる"],["こと"],["が"],["できよう"],["か"],["。"],["のこぎり"],["は"],["、"],["それ"],["を"],["動かす","うごかす"],["者","もの"],["に"],["むかって"],["、"],["みずから"],["高か","たか"],["ぶる"],["こと"],["が"],["できよう"],["か"],["。"],["これ"],["は"],["あたかも"],["、"],["むち"],["が"],["自分","じぶん"],["を"],["あげる"],["者","もの"],["を"],["動かし","うごかし"],["、"],["つえ"],["が"],["木","き"],["で"],["ない"],["者","もの"],["を"],["あげよう"],["と"],["する"],["のに"],["等い","ひとしい"],["。"]]},{"verse":16,"text":"それゆえ、主,しゅ、万軍,ばんぐんの主,しゅは、その肥,こえた勇士,ゆうしの中,なかに病気,びょうきを送,おくって衰,おとろえさせ、その栄光,えいこうの下,したに火,ひの燃,もえるような炎,ほのおを燃,もやされる。","tok":[["それ"],["ゆえ"],["、"],["主","しゅ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["、"],["その"],["肥","こえ"],["た"],["勇士","ゆうし"],["の"],["中","なか"],["に"],["病気","びょうき"],["を"],["送って","おくって"],["衰えさせ","おとろえさせ"],["、"],["その"],["栄光","えいこう"],["の"],["下","した"],["に"],["火","ひ"],["の"],["燃える","もえる"],["よう"],["な"],["炎","ほのお"],["を"],["燃やされる","もやされる"],["。"]]},{"verse":17,"text":"イスラエルの光,ひかりは火,ひとなり、その聖者,せいじゃは炎,ほのおとなり、そのいばらと、おどろとを一日,にちのうちに焼,やき滅,ほろぼす。","tok":[["イスラエル"],["の"],["光","ひかり"],["は"],["火","ひ"],["と"],["なり"],["、"],["その"],["聖者","せいじゃ"],["は"],["炎","ほのお"],["と"],["なり"],["、"],["その"],["いばら"],["と"],["、"],["おどろ"],["と"],["を"],["一","いち"],["日","にち"],["の"],["うち"],["に"],["焼き滅ぼす","やきほろぼす"],["。"]]},{"verse":18,"text":"また、その林,はやしと土,つち肥,こえた田畑,たはたの栄,さかえを、魂,たましいも、からだも二つながら滅,ほろぼし、病,やめる者,もののやせ衰,おとろえる時,ときのようにされる。","tok":[["また"],["、"],["その"],["林","はやし"],["と"],["土肥","つちこえ"],["た"],["田畑","たはた"],["の"],["栄","さかえ"],["を"],["、"],["魂","たましい"],["も"],["、"],["からだ"],["も"],["二つながら","ふたつながら"],["滅ぼし","ほろぼし"],["、"],["病める","やめる"],["者","もの"],["の"],["やせ衰える","やせおとろえる"],["時","とき"],["の"],["よう"],["に"],["される"],["。"]]},{"verse":19,"text":"その林,はやしの木,きの残,のこりのものはわずかであって、わらべもそれを書,かきとめることができる。","tok":[["その"],["林","はやし"],["の"],["木","き"],["の"],["残り","のこり"],["の"],["もの"],["は"],["わずか"],["で"],["あって"],["、"],["わらべ"],["も"],["それ"],["を"],["書きとめる","かきとめる"],["こと"],["が"],["できる"],["。"]]},{"verse":20,"text":"その日,ひにはイスラエルの残,のこりの者,ものと、ヤコブの家,いえの生,いき残,のこった者,ものとは、もはや自分,じぶんたちを撃,うった者,ものにたよらず、真心,まごころをもってイスラエルの聖者,せいじゃ、主,しゅにたより、","tok":[["その"],["日","ひ"],["に"],["は"],["イスラエル"],["の"],["残り","のこり"],["の"],["者","もの"],["と"],["、"],["ヤコブ"],["の"],["家","いえ"],["の"],["生き残った","いきのこった"],["者","もの"],["と"],["は"],["、"],["もはや"],["自分","じぶん"],["たち"],["を"],["撃った","うった"],["者","もの"],["に"],["たよらず"],["、"],["真心","まごころ"],["を"],["もって"],["イスラエル"],["の"],["聖者","せいじゃ"],["、"],["主に","しゅに"],["たより"],["、"]]},{"verse":21,"text":"残,のこりの者,もの、すなわちヤコブの残,のこりの者,ものは大能,たいのうの神,かみに帰,かえる。","tok":[["残り","のこり"],["の"],["者","もの"],["、"],["すなわち"],["ヤコブ"],["の"],["残り","のこり"],["の"],["者","もの"],["は"],["大能","たいのう"],["の"],["神","かみ"],["に"],["帰える","かえる"],["。"]]},{"verse":22,"text":"あなたの民,たみイスラエルは海,うみの砂,すなのようであっても、そのうちの残,のこりの者,ものだけが帰,かえって来,くる。滅,ほろびはすでに定,さだまり、義,ぎであふれている。","tok":[["あなた"],["の"],["民","たみ"],["イスラエル"],["は"],["海","うみ"],["の"],["砂","すな"],["の"],["よう"],["で"],["あって"],["も"],["、"],["その"],["うち"],["の"],["残り","のこり"],["の"],["者","もの"],["だけ"],["が"],["帰えって","かえって"],["来る","くる"],["。"],["滅び","ほろび"],["は"],["すでに"],["定まり","さだまり"],["、"],["義","ぎ"],["で"],["あふれて"],["いる"],["。"]]},{"verse":23,"text":"主,しゅ、万軍,ばんぐんの主,しゅは定,さだめられた滅,ほろびを全,ぜん地,ちに行,おこなわれる。","tok":[["主","しゅ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["定められた","さだめられた"],["滅び","ほろび"],["を"],["全地","ぜんち"],["に"],["行なわれる","おこなわれる"],["。"]]},{"verse":24,"text":"それゆえ、主,しゅ、万軍,ばんぐんの主,しゅはこう言,いわれる、「シオンに住,すむわが民,たみよ、アッスリヤびとが、エジプトびとがしたように、むちをもってあなたを打,うち、つえをあげてあなたをせめても、彼,かれらを恐,おそれてはならない。","tok":[["それ"],["ゆえ"],["、"],["主","しゅ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["「"],["シオン"],["に"],["住む","すむ"],["わが"],["民","たみ"],["よ"],["、"],["アッスリヤ"],["びと"],["が"],["、"],["エジプト"],["びと"],["が"],["した"],["よう"],["に"],["、"],["むち"],["を"],["もって"],["あなた"],["を"],["打ち","うち"],["、"],["つえ"],["を"],["あげて"],["あなた"],["を"],["せめて"],["も"],["、"],["彼","かれ"],["ら"],["を"],["恐れて","おそれて"],["は"],["ならない"],["。"]]},{"verse":25,"text":"ただしばらくして、わが憤,いきどおりはやみ、わが怒,いかりは彼,かれらを滅,ほろぼすからである。","tok":[["ただ"],["しばらく"],["して"],["、"],["わが"],["憤り","いきどおり"],["は"],["やみ"],["、"],["わが"],["怒り","いかり"],["は"],["彼","かれ"],["ら"],["を"],["滅ぼす","ほろぼす"],["から"],["で"],["ある"],["。"]]},{"verse":26,"text":"万軍,ばんぐんの主,しゅは、むかしミデアンびとをオレブの岩,いわで撃,うたれた時,ときのように、彼,かれらにむかって、むちをふるわれる。またそのつえを海,うみの上,うえにのばし、エジプトでなされたように、それをあげられる。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["、"],["むかし"],["ミデアン"],["びと"],["を"],["オレブ"],["の"],["岩","いわ"],["で"],["撃たれた","うたれた"],["時","とき"],["の"],["よう"],["に"],["、"],["彼","かれ"],["ら"],["に"],["むかって"],["、"],["むち"],["を"],["ふるわれる"],["。"],["また"],["その"],["つえ"],["を"],["海","うみ"],["の"],["上","うえ"],["に"],["のばし"],["、"],["エジプト"],["で"],["なされた"],["よう"],["に"],["、"],["それ"],["を"],["あげられる"],["。"]]},{"verse":27,"text":"その日,ひには、彼,かれの重荷,おもにはあなたの肩,かたからおり、彼,かれのくびきはあなたの首,くびから離,はなれる」。彼,かれはリンモンから上,のぼり、","tok":[["その"],["日","ひ"],["に"],["は"],["、"],["彼","かれ"],["の"],["重荷","おもに"],["は"],["あなた"],["の"],["肩","かた"],["から"],["おり"],["、"],["彼","かれ"],["の"],["くびき"],["は"],["あなた"],["の"],["首","くび"],["から"],["離れる","はなれる"],["」"],["。"],["彼","かれ"],["は"],["リンモン"],["から"],["上り","のぼり"],["、"]]},{"verse":28,"text":"アイアテにきたり、ミグロンを過,すぎ、ミクマシでその行李,こうりをとどめ、","tok":[["アイアテ"],["に"],["き"],["たり"],["、"],["ミグロン"],["を"],["過","すぎ"],["、"],["ミクマシ"],["で"],["その"],["行李","こうり"],["を"],["とどめ"],["、"]]},{"verse":29,"text":"渡,わたしを過,すぎて、ゲバに宿,やどる。ラマはおののき、サウルのギベアは逃,にげ去,さった。","tok":[["渡","わたし"],["を"],["過て","すぎて"],["、"],["ゲバ"],["に"],["宿る","やどる"],["。"],["ラマ"],["は"],["おののき"],["、"],["サウル"],["の"],["ギベア"],["は"],["逃去","にげさっ"],["た"],["。"]]},{"verse":30,"text":"ガリムの娘,むすめよ、声,こえをあげて叫,さけべ。ライシよ、耳,みみを傾,かたむけよ。アナトテよ、彼,かれに答,こたえよ。","tok":[["ガリム"],["の"],["娘","むすめ"],["よ"],["、"],["声","こえ"],["を"],["あげて"],["叫けべ","さけべ"],["。"],["ライシ"],["よ"],["、"],["耳","みみ"],["を"],["傾むけよ","かたむけよ"],["。"],["アナトテ"],["よ"],["、"],["彼","かれ"],["に"],["答","こたえ"],["よ"],["。"]]},{"verse":31,"text":"マデメナは逃,にげ去,さり、ゲビムの民,たみは隠,かくれ場,ばを求,もとめた。","tok":[["マデメナ"],["は"],["逃","にげ"],["去り","さり"],["、"],["ゲビム"],["の"],["民","たみ"],["は"],["隠れ場","かくれば"],["を"],["求めた","もとめた"],["。"]]},{"verse":32,"text":"この日,ひ彼,かれはノブに立,たちとどまり、シオンの娘,むすめの山,やま、エルサレムの丘,おかにむかって、その手,てを振,ふる。","tok":[["この"],["日","ひ"],["彼","かれ"],["は"],["ノブ"],["に"],["立ち","たち"],["とどまり"],["、"],["シオン"],["の"],["娘","むすめ"],["の"],["山","やま"],["、"],["エルサレム"],["の"],["丘","おか"],["に"],["むかって"],["、"],["その"],["手","て"],["を"],["振る","ふる"],["。"]]},{"verse":33,"text":"見,みよ、主,しゅ、万軍,ばんぐんの主,しゅは、恐,おそろしい力,ちからをもって枝,えだを切,きりおろされる。たけの高,たかいものも切,きり落,おとされ、そびえ立,たつものは低,ひくくされる。","tok":[["見よ","みよ"],["、"],["主","しゅ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["、"],["恐ろしい","おそろしい"],["力","ちから"],["を"],["もって"],["枝","えだ"],["を"],["切りおろされる","きりおろされる"],["。"],["たけ"],["の"],["高かい","たかい"],["もの"],["も"],["切り落とされ","きりおとされ"],["、"],["そびえ立つ","そびえたつ"],["もの"],["は"],["低く","ひくく"],["される"],["。"]]},{"verse":34,"text":"主,しゅはおのをもって茂,しげりあう林,はやしを切,きられる。みごとな木,きの茂,しげるレバノンも倒,たおされる。","tok":[["主","しゅ"],["は"],["おの"],["を"],["もって"],["茂り","しげり"],["あう"],["林","はやし"],["を"],["切られる","きられる"],["。"],["みごと"],["な"],["木","き"],["の"],["茂","しげる"],["レバノン"],["も"],["倒される","たおされる"],["。"]]}]
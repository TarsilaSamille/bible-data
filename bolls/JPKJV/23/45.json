[{"verse":1,"text":"わたしはわが受膏者,じゅこうしゃクロスの右,みぎの手,てをとって、もろもろの国,くにをその前,まえに従,したがわせ、もろもろの王,おうの腰,こしを解,とき、とびらをその前,まえに開,ひらかせて、門,もんを閉,とじさせない、と言,いわれる主,しゅはその受膏者,じゅこうしゃクロスにこう言,いわれる、","tok":[["わたし"],["は"],["わが"],["受膏者","じゅこうしゃ"],["クロス"],["の"],["右","みぎ"],["の"],["手","て"],["を"],["とって"],["、"],["もろもろ"],["の"],["国","くに"],["を"],["その"],["前","まえ"],["に"],["従わせ","したがわせ"],["、"],["もろもろ"],["の"],["王","おう"],["の"],["腰","こし"],["を"],["解き","とき"],["、"],["とびら"],["を"],["その"],["前","まえ"],["に"],["開らかせて","ひらかせて"],["、"],["門","もん"],["を"],["閉じさせない","とじさせない"],["、"],["と"],["言われる","いわれる"],["主","しゅ"],["は"],["その"],["受膏者","じゅこうしゃ"],["クロス"],["に"],["こう"],["言われる","いわれる"],["、"]]},{"verse":2,"text":"「わたしはあなたの前,まえに行,いって、もろもろの山,やまを平,たいらにし、青銅,せいどうのとびらをこわし、鉄,てつの貫,かんの木,きを断,たち切,きり、","tok":[["「"],["わたし"],["は"],["あなた"],["の"],["前","まえ"],["に"],["行って","いって"],["、"],["もろもろ"],["の"],["山","やま"],["を"],["平","たいら"],["に"],["し"],["、"],["青銅","せいどう"],["の"],["とびら"],["を"],["こわし"],["、"],["鉄","てつ"],["の"],["貫の木","かんのき"],["を"],["断ち切り","たちきり"],["、"]]},{"verse":3,"text":"あなたに、暗,くらい所,ところにある財宝,ざいほうと、ひそかな所,ところに隠,かくした宝物,ほうもつとを与,あたえて、わたしは主,しゅ、あなたの名,なを呼,よんだイスラエルの神,かみであることをあなたに知,しらせよう。","tok":[["あなた"],["に"],["、"],["暗い","くらい"],["所","ところ"],["に"],["ある"],["財宝","ざいほう"],["と"],["、"],["ひそか"],["な"],["所","ところ"],["に"],["隠した","かくした"],["宝物","ほうもつ"],["と"],["を"],["与","あたえ"],["て"],["、"],["わたし"],["は"],["主","しゅ"],["、"],["あなた"],["の"],["名","な"],["を"],["呼んだ","よんだ"],["イスラエル"],["の"],["神","かみ"],["で"],["ある"],["こと"],["を"],["あなた"],["に"],["知らせよう","しらせよう"],["。"]]},{"verse":4,"text":"わがしもべヤコブのために、わたしの選,えらんだイスラエルのために、わたしはあなたの名,なを呼,よんだ。あなたがわたしを知,しらなくても、わたしはあなたに名,なを与,あたえた。","tok":[["わが"],["しもべ"],["ヤコブ"],["の"],["ため"],["に"],["、"],["わたし"],["の"],["選らんだ","えらんだ"],["イスラエル"],["の"],["ため"],["に"],["、"],["わたし"],["は"],["あなた"],["の"],["名","な"],["を"],["呼んだ","よんだ"],["。"],["あなた"],["が"],["わたし"],["を"],["知らなくて","しらなくて"],["も"],["、"],["わたし"],["は"],["あなた"],["に"],["名","な"],["を"],["与","あたえ"],["た"],["。"]]},{"verse":5,"text":"わたしは主,しゅである。わたしのほかに神,かみはない、ひとりもない。あなたがわたしを知,しらなくても、わたしはあなたを強,つよくする。","tok":[["わたし"],["は"],["主","しゅ"],["で"],["ある"],["。"],["わたし"],["の"],["ほか"],["に"],["神","かみ"],["は"],["ない"],["、"],["ひとり"],["も"],["ない"],["。"],["あなた"],["が"],["わたし"],["を"],["知らなくて","しらなくて"],["も"],["、"],["わたし"],["は"],["あなた"],["を"],["強く","つよく"],["する"],["。"]]},{"verse":6,"text":"これは日,ひの出,でる方,ほうから、また西,にしの方,ほうから、人々,ひとびとがわたしのほかに神,かみのないことを知,しるようになるためである。わたしは主,しゅである、わたしのほかに神,かみはない。","tok":[["これ"],["は"],["日","ひ"],["の"],["出る","でる"],["方","ほう"],["から"],["、"],["また"],["西","にし"],["の"],["方","ほう"],["から"],["、"],["人々","ひとびと"],["が"],["わたし"],["の"],["ほか"],["に"],["神","かみ"],["の"],["ない"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["ため"],["で"],["ある"],["。"],["わたし"],["は"],["主","しゅ"],["で"],["ある"],["、"],["わたし"],["の"],["ほか"],["に"],["神","かみ"],["は"],["ない"],["。"]]},{"verse":7,"text":"わたしは光,ひかりをつくり、また暗,くらきを創造,そうぞうし、繁栄,はんえいをつくり、またわざわいを創造,そうぞうする。わたしは主,しゅである、すべてこれらの事,ことをなす者,ものである。","tok":[["わたし"],["は"],["光","ひかり"],["を"],["つくり"],["、"],["また"],["暗き","くらき"],["を"],["創造","そうぞう"],["し"],["、"],["繁栄","はんえい"],["を"],["つくり"],["、"],["また"],["わざわい"],["を"],["創造","そうぞう"],["する"],["。"],["わたし"],["は"],["主","しゅ"],["で"],["ある"],["、"],["すべて"],["これ"],["ら"],["の"],["事","こと"],["を"],["なす"],["者","もの"],["で"],["ある"],["。"]]},{"verse":8,"text":"天,てんよ、上,うえより水,みずを注,そそげ、雲,くもは義,ぎを降,ふらせよ。地,ちは開,ひらけて救,すくいを生,しょうじ、また義,ぎをも、生,はえさせよ。主,しゅなるわたしはこれを創造,そうぞうした。","tok":[["天","てん"],["よ"],["、"],["上","うえ"],["より"],["水","みず"],["を"],["注げ","そそげ"],["、"],["雲","くも"],["は"],["義","ぎ"],["を"],["降らせ","ふらせ"],["よ"],["。"],["地","ち"],["は"],["開らけて","ひらけて"],["救い","すくい"],["を"],["生じ","しょうじ"],["、"],["また"],["義","ぎ"],["を"],["も"],["、"],["生えさせ","はえさせ"],["よ"],["。"],["主","しゅ"],["なる"],["わたし"],["は"],["これ"],["を"],["創造","そうぞう"],["した"],["。"]]},{"verse":9,"text":"陶器,とうきが陶器,とうき師,しと争,あらそうように、おのれを造,つくった者,ものと争,あらそう者,ものはわざわいだ。粘土,ねんどは陶器,とうき師,しにむかって『あなたは何,なにを造,つくるか』と言,いい、あるいは『あなたの造,つくった物,ものには手,てがない』と言,いうだろうか。","tok":[["陶器","とうき"],["が"],["陶器師","とうきし"],["と"],["争う","あらそう"],["よう"],["に"],["、"],["おのれ"],["を"],["造った","つくった"],["者","もの"],["と"],["争う","あらそう"],["者","もの"],["は"],["わざわい"],["だ"],["。"],["粘土","ねんど"],["は"],["陶器師","とうきし"],["に"],["むかって"],["『"],["あなた"],["は"],["何に","なに"],["を"],["造る","つくる"],["か"],["』"],["と"],["言い","いい"],["、"],["あるいは"],["『"],["あなた"],["の"],["造った","つくった"],["物","もの"],["に"],["は"],["手","て"],["が"],["ない"],["』"],["と"],["言うだろう","いうだろう"],["か"],["。"]]},{"verse":10,"text":"父,ちちにむかって『あなたは、なぜ子,こをもうけるのか』と言,いい、あるいは女,おんなにむかって『あなたは、なぜ産,うみの苦,くるしみをするのか』と言,いう者,ものはわざわいだ」。","tok":[["父","ちち"],["に"],["むかって"],["『"],["あなた"],["は"],["、"],["なぜ"],["子","こ"],["を"],["もうける"],["の"],["か"],["』"],["と"],["言い","いい"],["、"],["あるいは"],["女","おんな"],["に"],["むかって"],["『"],["あなた"],["は"],["、"],["なぜ"],["産み","うみ"],["の"],["苦しみ","くるしみ"],["を"],["する"],["の"],["か"],["』"],["と"],["言う","いう"],["者","もの"],["は"],["わざわい"],["だ"],["」"],["。"]]},{"verse":11,"text":"イスラエルの聖者,せいじゃ、イスラエルを造,つくられた主,しゅはこう言,いわれる、「あなたがたは、わが子,こらについてわたしに問,とい、またわが手,てのわざについてわたしに命,めいずるのか。","tok":[["イスラエル"],["の"],["聖者","せいじゃ"],["、"],["イスラエル"],["を"],["造られた","つくられた"],["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["「"],["あなた"],["がた"],["は"],["、"],["わが"],["子","こ"],["ら"],["について"],["わたし"],["に"],["問","とい"],["、"],["また"],["わが"],["手","て"],["の"],["わざ"],["について"],["わたし"],["に"],["命ずる","めいずる"],["の"],["か"],["。"]]},{"verse":12,"text":"わたしは地,ちを造,つくって、その上,うえに人,ひとを創造,そうぞうした。わたしは手,てをもって天,てんをのべ、その万軍,ばんぐんを指揮,しきした。","tok":[["わたし"],["は"],["地","ち"],["を"],["造って","つくって"],["、"],["その"],["上","うえ"],["に"],["人","ひと"],["を"],["創造","そうぞう"],["した"],["。"],["わたし"],["は"],["手","て"],["を"],["もって"],["天","てん"],["を"],["のべ"],["、"],["その"],["万","まん"],["軍","ぐん"],["を"],["指揮","しき"],["した"],["。"]]},{"verse":13,"text":"わたしは義,ぎをもってクロスを起,おこした。わたしは彼,かれのすべての道,みちをまっすぐにしよう。彼,かれはわが町,まちを建,たて、わが捕囚,ほしゅうを価,あたいのためでなく、また報,むくいのためでもなく解,とき放,はなつ」と万軍,ばんぐんの主,しゅは言,いわれる。","tok":[["わたし"],["は"],["義","ぎ"],["を"],["もって"],["クロス"],["を"],["起こした","おこした"],["。"],["わたし"],["は"],["彼","かれ"],["の"],["すべて"],["の"],["道","みち"],["を"],["まっすぐ"],["に"],["しよう"],["。"],["彼","かれ"],["は"],["わが"],["町","まち"],["を"],["建て","たて"],["、"],["わが"],["捕囚","ほしゅう"],["を"],["価","あたい"],["の"],["ため"],["で"],["なく"],["、"],["また"],["報い","むくい"],["の"],["ため"],["で"],["も"],["なく"],["解き放つ","ときはなつ"],["」"],["と"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":14,"text":"主,しゅはこう言,いわれる、「エジプトの富,とみと、エチオピヤの商品,しょうひんと、たけの高,たかいセバびととはあなたに来,きて、あなたのものとなり、あなたに従,したがい、彼,かれらは鎖,くさりにつながれて来,きて、あなたの前,まえにひれ伏,ふし、あなたに願,ねがって言,いう、『神,かみはただあなたと共,ともにいまし、このほかに神,かみはなく、ひとりもない』」。","tok":[["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["「"],["エジプト"],["の"],["富","とみ"],["と"],["、"],["エチオピヤ"],["の"],["商品","しょうひん"],["と"],["、"],["たけ"],["の"],["高かい","たかい"],["セバ"],["びと"],["と"],["は"],["あなた"],["に"],["来て","きて"],["、"],["あなた"],["の"],["もの"],["と"],["なり"],["、"],["あなた"],["に"],["従い","したがい"],["、"],["彼","かれ"],["ら"],["は"],["鎖","くさり"],["に"],["つながれて"],["来て","きて"],["、"],["あなた"],["の"],["前","まえ"],["に"],["ひれ伏し","ひれふし"],["、"],["あなた"],["に"],["願って","ねがって"],["言う","いう"],["、"],["『"],["神","かみ"],["は"],["ただ"],["あなた"],["と"],["共","とも"],["に"],["いまし"],["、"],["この"],["ほか"],["に"],["神","かみ"],["は"],["なく"],["、"],["ひとり"],["も"],["ない"],["』"],["」"],["。"]]},{"verse":15,"text":"イスラエルの神,かみ、救主,すくいぬしよ、まことに、あなたはご自分,じぶんを隠,かくしておられる神,かみである。","tok":[["イスラエル"],["の"],["神","かみ"],["、"],["救主","す"],["くい"],["ぬし"],["よ"],["、"],["まこと"],["に"],["、"],["あなた"],["は"],["ご自分","ごじぶん"],["を"],["隠して","かくして"],["おられる"],["神","かみ"],["で"],["ある"],["。"]]},{"verse":16,"text":"偶像,ぐうぞうを造,つくる者,ものは皆,みな恥,はじを負,おい、はずかしめを受,うけ、ともに、あわてふためいて退,しりぞく。","tok":[["偶像","ぐうぞう"],["を"],["造る","つくる"],["者","もの"],["は"],["皆","みな"],["恥","はじ"],["を"],["負い","おい"],["、"],["はずかしめ"],["を"],["受け","うけ"],["、"],["とも"],["に"],["、"],["あわてふためいて"],["退ぞく","しりぞく"],["。"]]},{"verse":17,"text":"しかし、イスラエルは主,しゅに救,すくわれて、とこしえの救,すくいを得,える。あなたがたは世々,よよかぎりなく、恥,はじを負,おわず、はずかしめを受,うけない。","tok":[["しかし"],["、"],["イスラエル"],["は"],["主に","しゅに"],["救われて","すくわれて"],["、"],["とこしえ"],["の"],["救い","すくい"],["を"],["得る","える"],["。"],["あなた"],["がた"],["は"],["世々","よ"],["よ"],["かぎりなく"],["、"],["恥","はじ"],["を"],["負わず","おわず"],["、"],["はずかしめ"],["を"],["受ない","うけない"],["。"]]},{"verse":18,"text":"天,てんを創造,そうぞうされた主,しゅ、すなわち神,かみであってまた地,ちをも造,つくり成,なし、これを堅,かたくし、いたずらにこれを創造,そうぞうされず、これを人,ひとのすみかに造,つくられた主,しゅはこう言,いわれる、「わたしは主,しゅである、わたしのほかに神,かみはない。","tok":[["天","てん"],["を"],["創造","そうぞう"],["された"],["主","しゅ"],["、"],["すなわち"],["神","かみ"],["で"],["あって"],["また"],["地","ち"],["を"],["も"],["造成","つくりな"],["し"],["、"],["これ"],["を"],["堅く","かたく"],["し"],["、"],["いたずら"],["に"],["これ"],["を"],["創造","そうぞう"],["されず"],["、"],["これ"],["を"],["人","ひと"],["の"],["すみか"],["に"],["造られた","つくられた"],["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["「"],["わたし"],["は"],["主","しゅ"],["で"],["ある"],["、"],["わたし"],["の"],["ほか"],["に"],["神","かみ"],["は"],["ない"],["。"]]},{"verse":19,"text":"わたしは隠,かくれたところ、地,ちの暗,くらい所,ところで語,かたらず、ヤコブの子孫,しそんに『わたしを尋,たずねるのはむだだ』と言,いわなかった。主,しゅなるわたしは正,ただしい事,ことを語,かたり、まっすぐな事,ことを告,つげる。","tok":[["わたし"],["は"],["隠れた","かくれた"],["ところ"],["、"],["地","ち"],["の"],["暗い","くらい"],["所","ところ"],["で"],["語らず","かたらず"],["、"],["ヤコブ"],["の"],["子孫","しそん"],["に"],["『"],["わたし"],["を"],["尋ねる","たずねる"],["の"],["は"],["むだ"],["だ"],["』"],["と"],["言わなかった","いわなかった"],["。"],["主","しゅ"],["なる"],["わたし"],["は"],["正い","ただしい"],["事","こと"],["を"],["語り","かたり"],["、"],["まっすぐ"],["な"],["事","こと"],["を"],["告げる","つげる"],["。"]]},{"verse":20,"text":"もろもろの国,くにからのがれてきた者,ものよ、集,あつまってきて、共,ともに近寄,ちかよれ。木像,もくぞうをにない、救,すくうことのできない神,かみに祈,いのる者,ものは無知,むちである。","tok":[["もろもろ"],["の"],["国","くに"],["から"],["のがれて"],["きた"],["者","もの"],["よ"],["、"],["集まって","あつまって"],["きて"],["、"],["共","とも"],["に"],["近寄れ","ちかよれ"],["。"],["木像","もくぞう"],["を"],["にない"],["、"],["救う","すくう"],["こと"],["の"],["できない"],["神","かみ"],["に"],["祈る","いのる"],["者","もの"],["は"],["無知","むち"],["で"],["ある"],["。"]]},{"verse":21,"text":"あなたがたの言,いい分,ぶんを持,もってきて述,のべよ。また共,ともに相談,そうだんせよ。この事,ことをだれがいにしえから示,しめしたか。だれが昔,むかしから告,つげたか。わたし、すなわち主,しゅではなかったか。わたしのほかに神,かみはない。わたしは義,ぎなる神,かみ、救主,すくいぬしであって、わたしのほかに神,かみはない。","tok":[["あなた"],["がた"],["の"],["言い分","いいぶん"],["を"],["持って","もって"],["きて"],["述べ","のべ"],["よ"],["。"],["また"],["共","とも"],["に"],["相談","そうだん"],["せよ"],["。"],["この"],["事","こと"],["を"],["だれ"],["が"],["いにしえ"],["から"],["示めした","しめした"],["か"],["。"],["だれ"],["が"],["昔","むかし"],["から"],["告","つげ"],["た"],["か"],["。"],["わたし"],["、"],["すなわち"],["主","しゅ"],["で"],["は"],["なかった"],["か"],["。"],["わたし"],["の"],["ほか"],["に"],["神","かみ"],["は"],["ない"],["。"],["わたし"],["は"],["義","ぎ"],["なる"],["神","かみ"],["、"],["救主","す"],["くい"],["ぬし"],["で"],["あって"],["、"],["わたし"],["の"],["ほか"],["に"],["神","かみ"],["は"],["ない"],["。"]]},{"verse":22,"text":"地,ちの果,はてなるもろもろの人,ひとよ、わたしを仰,あおぎのぞめ、そうすれば救,すくわれる。わたしは神,かみであって、ほかに神,かみはないからだ。","tok":[["地","ち"],["の"],["果てなる","はてなる"],["もろもろ"],["の"],["人","ひと"],["よ"],["、"],["わたし"],["を"],["仰ぎ","あおぎ"],["のぞめ"],["、"],["そう"],["すれば"],["救われる","すくわれる"],["。"],["わたし"],["は"],["神","かみ"],["で"],["あって"],["、"],["ほか"],["に"],["神","かみ"],["は"],["ない"],["から"],["だ"],["。"]]},{"verse":23,"text":"わたしは自分,じぶんをさして誓,ちかった、わたしの口,くちから出,でた正,ただしい言葉,ことばは帰,かえることがない、『すべてのひざはわが前,まえにかがみ、すべての舌,したは誓,ちかいをたてる』。","tok":[["わたし"],["は"],["自分","じぶん"],["を"],["さして"],["誓った","ちかった"],["、"],["わたし"],["の"],["口","くち"],["から"],["出た","でた"],["正い","ただしい"],["言葉","ことば"],["は"],["帰える","かえる"],["こと"],["が"],["ない"],["、"],["『"],["すべて"],["の"],["ひざ"],["は"],["わが"],["前","まえ"],["に"],["かがみ"],["、"],["すべて"],["の"],["舌","した"],["は"],["誓い","ちかい"],["を"],["たてる"],["』"],["。"]]},{"verse":24,"text":"人,ひとはわたしについて言,いう、『正義,せいぎと力,ちからとは主,しゅにのみある』と。人々,ひとびとは主,しゅにきたり、主,しゅにむかって怒,いかる者,ものは皆,みな恥,はじを受,うける。","tok":[["人","ひと"],["は"],["わたし"],["について"],["言う","いう"],["、"],["『"],["正義","せいぎ"],["と"],["力","ちから"],["と"],["は"],["主に","しゅに"],["のみ"],["ある"],["』"],["と"],["。"],["人々","ひとびと"],["は"],["主に","しゅに"],["き"],["たり"],["、"],["主に","しゅに"],["むかって"],["怒","い"],["かる"],["者","もの"],["は"],["皆","みな"],["恥","はじ"],["を"],["受る","うける"],["。"]]},{"verse":25,"text":"しかしイスラエルの子孫,しそんは皆,みな主,しゅによって勝,かち誇,ほこることができる」。","tok":[["しかし"],["イスラエル"],["の"],["子孫","しそん"],["は"],["皆","みな"],["主に","しゅに"],["よって"],["勝誇る","かちほこる"],["こと"],["が"],["できる"],["」"],["。"]]}]
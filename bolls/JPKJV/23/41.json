[{"verse":1,"text":"海沿,うみぞいの国々,くにぐによ、静,しずかにして、わたしに聞,きけ。もろもろの民,たみよ、力,ちからを新,あらたにし、近,ちかづいて語,かたれ。われわれは共,ともにさばきの座,ざに近,ちかづこう。","tok":[["海沿い","うみぞい"],["の"],["国々","くにぐに"],["よ"],["、"],["静","しずか"],["に"],["して"],["、"],["わたし"],["に"],["聞け","きけ"],["。"],["もろもろ"],["の"],["民","たみ"],["よ"],["、"],["力","ちから"],["を"],["新らた","あらた"],["に"],["し"],["、"],["近づいて","ちかづいて"],["語れ","かたれ"],["。"],["われわれ"],["は"],["共","とも"],["に"],["さばき"],["の"],["座","ざ"],["に"],["近づこう","ちかづこう"],["。"]]},{"verse":2,"text":"だれが東,ひがしから人,ひとを起,おこしたか。彼,かれはその行,ゆく所,ところで勝利,しょうりをもって迎,むかえられ、もろもろの国,くにを征服,せいふくし、もろもろの王,おうを足,あしの下,したに踏,ふみつけ、そのつるぎをもって彼,かれらをちりのようにし、その弓,ゆみをもって吹,ふき去,さられる、わらのようにする。","tok":[["だれ"],["が"],["東","ひがし"],["から"],["人","ひと"],["を"],["起こした","おこした"],["か"],["。"],["彼","かれ"],["は"],["その"],["行く","ゆく"],["所","ところ"],["で"],["勝利","しょうり"],["を"],["もって"],["迎","むかえ"],["られ"],["、"],["もろもろ"],["の"],["国","くに"],["を"],["征服","せいふく"],["し"],["、"],["もろもろ"],["の"],["王","おう"],["を"],["足","あし"],["の"],["下","した"],["に"],["踏みつけ","ふみつけ"],["、"],["その"],["つるぎ"],["を"],["もって"],["彼","かれ"],["ら"],["を"],["ちり"],["の"],["よう"],["に"],["し"],["、"],["その"],["弓","ゆみ"],["を"],["もって"],["吹","ふき"],["去られる","さられる"],["、"],["わら"],["の"],["よう"],["に"],["する"],["。"]]},{"verse":3,"text":"彼,かれはこれらの者,ものを追,おってその足,あしのまだ踏,ふんだことのない道,みちを、安,やすらかに過,すぎて行,いく。","tok":[["彼","かれ"],["は"],["これ"],["ら"],["の"],["者","もの"],["を"],["追って","おって"],["その"],["足","あし"],["の"],["まだ"],["踏","ふんだこ"],["と"],["の"],["ない"],["道","みち"],["を"],["、"],["安らか","やすらか"],["に"],["過て","すぎて"],["行く","いく"],["。"]]},{"verse":4,"text":"だれがこの事,ことを行,おこなったか、なしたか。だれが初,はじめから世々,よよの人々,ひとびとを呼,よび出,だしたか。主,しゅなるわたしは初,はじめであって、また終,おわりと共,ともにあり、わたしがそれだ。","tok":[["だれ"],["が"],["この"],["事","こと"],["を"],["行なった","おこなった"],["か"],["、"],["なした"],["か"],["。"],["だれ"],["が"],["初め","はじめ"],["から"],["世々","よよ"],["の"],["人々","ひとびと"],["を"],["呼び","よび"],["出た","だした"],["か"],["。"],["主","しゅ"],["なる"],["わたし"],["は"],["初め","はじめ"],["で"],["あって"],["、"],["また"],["終","おわり"],["と"],["共","とも"],["に"],["あり"],["、"],["わたし"],["が"],["それ"],["だ"],["。"]]},{"verse":5,"text":"海沿,うみぞいの国々,くにぐには見,みて恐,おそれ、地,ちの果,はては、おののき、近,ちかづいて来,きた。","tok":[["海沿い","うみぞい"],["の"],["国々","くにぐに"],["は"],["見て","みて"],["恐","おそれ"],["、"],["地","ち"],["の"],["果て","はて"],["は"],["、"],["おののき"],["、"],["近づいて","ちかづいて"],["来た","きた"],["。"]]},{"verse":6,"text":"彼,かれらはおのおのその隣,となりを助,たすけ、その兄弟,きょうだいたちに言,いう、「勇気,ゆうきを出,だせよ」と。","tok":[["彼","かれ"],["ら"],["は"],["おのおの"],["その"],["隣","となり"],["を"],["助け","たすけ"],["、"],["その"],["兄弟","きょうだい"],["たち"],["に"],["言う","いう"],["、"],["「"],["勇気","ゆうき"],["を"],["出せ","だせ"],["よ"],["」"],["と"],["。"]]},{"verse":7,"text":"細工人,さいくにんは鍛冶,かじを励,はげまし、鎚,つちをもって平,たいらかにする者,ものは金,かな敷,しきを打,うつ者,ものに、はんだづけについて言,いう、「それは良,よい」と。また、くぎをもってそれを堅,かたくし、動,うごくことのないようにする。","tok":[["細工人","さいくにん"],["は"],["鍛冶","かじ"],["を"],["励まし","はげまし"],["、"],["鎚","つち"],["を"],["もって"],["平か","たいらか"],["に"],["する"],["者","もの"],["は"],["金","か"],["な"],["敷","しき"],["を"],["打つ","うつ"],["者","もの"],["に"],["、"],["はんだ"],["づけ"],["について"],["言う","いう"],["、"],["「"],["それ"],["は"],["良い","よい"],["」"],["と"],["。"],["また"],["、"],["くぎ"],["を"],["もって"],["それ"],["を"],["堅く","かたく"],["し"],["、"],["動く","うごく"],["こと"],["の"],["ない"],["よう"],["に"],["する"],["。"]]},{"verse":8,"text":"しかし、わがしもべイスラエルよ、わたしの選,えらんだヤコブ、わが友,ともアブラハムの子孫,しそんよ、","tok":[["しかし"],["、"],["わが"],["しもべ"],["イスラエル"],["よ"],["、"],["わたし"],["の"],["選らんだ","えらんだ"],["ヤコブ"],["、"],["わが"],["友","とも"],["アブラハム"],["の"],["子孫","しそん"],["よ"],["、"]]},{"verse":9,"text":"わたしは地,ちの果,はてから、あなたを連,つれてき、地,ちのすみずみから、あなたを召,めして、あなたに言,いった、「あなたは、わたしのしもべ、わたしは、あなたを選,えらんで捨,すてなかった」と。","tok":[["わたし"],["は"],["地","ち"],["の"],["果て","はて"],["から"],["、"],["あなた"],["を"],["連れて","つれて"],["き"],["、"],["地","ち"],["の"],["すみずみ"],["から"],["、"],["あなた"],["を"],["召","めし"],["て"],["、"],["あなた"],["に"],["言った","いった"],["、"],["「"],["あなた"],["は"],["、"],["わたし"],["の"],["しもべ"],["、"],["わたし"],["は"],["、"],["あなた"],["を"],["選らんで","えらんで"],["捨てなかった","すてなかった"],["」"],["と"],["。"]]},{"verse":10,"text":"恐,おそれてはならない、わたしはあなたと共,ともにいる。驚,おどろいてはならない、わたしはあなたの神,かみである。わたしはあなたを強,つよくし、あなたを助,たすけ、わが勝利,しょうりの右,みぎの手,てをもって、あなたをささえる。","tok":[["恐れて","おそれて"],["は"],["ならない"],["、"],["わたし"],["は"],["あなた"],["と"],["共","とも"],["に"],["いる"],["。"],["驚ろいて","おどろいて"],["は"],["ならない"],["、"],["わたし"],["は"],["あなた"],["の"],["神","かみ"],["で"],["ある"],["。"],["わたし"],["は"],["あなた"],["を"],["強く","つよく"],["し"],["、"],["あなた"],["を"],["助け","たすけ"],["、"],["わが"],["勝利","しょうり"],["の"],["右","みぎ"],["の"],["手","て"],["を"],["もって"],["、"],["あなた"],["を"],["ささえる"],["。"]]},{"verse":11,"text":"見,みよ、あなたにむかって怒,いかる者,ものはみな、はじて、あわてふためき、あなたと争,あらそう者,ものは滅,ほろびて無,むに帰,きする。","tok":[["見よ","みよ"],["、"],["あなた"],["に"],["むかって"],["怒","い"],["かる"],["者","もの"],["は"],["みな"],["、"],["はじて"],["、"],["あわてふためき"],["、"],["あなた"],["と"],["争う","あらそう"],["者","もの"],["は"],["滅びて","ほろびて"],["無","む"],["に"],["帰する","きする"],["。"]]},{"verse":12,"text":"あなたは、あなたと争,あらそう者,ものを尋,たずねても見,みいださず、あなたと戦,たたかう者,ものは全,まったく消,きえうせる。","tok":[["あなた"],["は"],["、"],["あなた"],["と"],["争う","あらそう"],["者","もの"],["を"],["尋ねて","たずねて"],["も"],["見いださず","みいださず"],["、"],["あなた"],["と"],["戦う","たたかう"],["者","もの"],["は"],["全く","まったく"],["消えうせる","きえうせる"],["。"]]},{"verse":13,"text":"あなたの神,かみ、主,しゅなるわたしはあなたの右,みぎの手,てをとってあなたに言,いう、「恐,おそれてはならない、わたしはあなたを助,たすける」。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["なる"],["わたし"],["は"],["あなた"],["の"],["右","みぎ"],["の"],["手","て"],["を"],["とって"],["あなた"],["に"],["言う","いう"],["、"],["「"],["恐れて","おそれて"],["は"],["ならない"],["、"],["わたし"],["は"],["あなた"],["を"],["助ける","たすける"],["」"],["。"]]},{"verse":14,"text":"主,しゅは言,いわれる、「虫,むしにひとしいヤコブよ、イスラエルの人々,ひとびとよ、恐,おそれてはならない。わたしはあなたを助,たすける。あなたをあがなう者,ものはイスラエルの聖者,せいじゃである。","tok":[["主","しゅ"],["は"],["言われる","いわれる"],["、"],["「"],["虫","むし"],["に"],["ひとしい"],["ヤコブ"],["よ"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["よ"],["、"],["恐れて","おそれて"],["は"],["ならない"],["。"],["わたし"],["は"],["あなた"],["を"],["助ける","たすける"],["。"],["あなた"],["を"],["あがなう"],["者","もの"],["は"],["イスラエル"],["の"],["聖者","せいじゃ"],["で"],["ある"],["。"]]},{"verse":15,"text":"見,みよ、わたしはあなたを鋭,するどい歯,はのある新,あたらしい打,だ穀,こく機,きとする。あなたは山,やまを打,うって、これを粉々,こなごなにし、丘,おかをもみがらのようにする。","tok":[["見よ","みよ"],["、"],["わたし"],["は"],["あなた"],["を"],["鋭どい","するどい"],["歯","は"],["の"],["ある"],["新らしい","あたらしい"],["打","だ"],["穀","こく"],["機","き"],["と"],["する"],["。"],["あなた"],["は"],["山","やま"],["を"],["打って","うって"],["、"],["これ"],["を"],["粉々","こなごな"],["に"],["し"],["、"],["丘","おか"],["を"],["もみがら"],["の"],["よう"],["に"],["する"],["。"]]},{"verse":16,"text":"あなたがあおげば風,かぜはこれを巻,まき去,さり、つむじ風,かぜがこれを吹,ふき散,ちらす。あなたは主,しゅによって喜,よろこびイスラエルの聖者,せいじゃによって誇,ほこる。","tok":[["あなた"],["が"],["あおげば"],["風","かぜ"],["は"],["これ"],["を"],["巻","まき"],["去り","さり"],["、"],["つむじ風","つむじかぜ"],["が"],["これ"],["を"],["吹","ふき"],["散らす","ちらす"],["。"],["あなた"],["は"],["主に","しゅに"],["よって"],["喜こび","よろこび"],["イスラエル"],["の"],["聖者","せいじゃ"],["によって"],["誇る","ほこる"],["。"]]},{"verse":17,"text":"貧,まずしい者,ものと乏,とぼしい者,ものとは水,みずを求,もとめても、水,みずがなく、その舌,したがかわいて焼,やけているとき、主,しゅなるわたしは彼,かれらに答,こたえる、イスラエルの神,かみなるわたしは彼,かれらを捨,すてることがない。","tok":[["貧しい","まずしい"],["者","もの"],["と"],["乏い","とぼしい"],["者","もの"],["と"],["は"],["水","みず"],["を"],["求めて","もとめて"],["も"],["、"],["水","みず"],["が"],["なく"],["、"],["その"],["舌","した"],["が"],["かわいて"],["焼","やけ"],["て"],["いる"],["とき"],["、"],["主","しゅ"],["なる"],["わたし"],["は"],["彼","かれ"],["ら"],["に"],["答","こたえ"],["る"],["、"],["イスラエル"],["の"],["神","かみ"],["なる"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["捨てる","すてる"],["こと"],["が"],["ない"],["。"]]},{"verse":18,"text":"わたしは裸,はだかの山,やまに川,かわを開,ひらき、谷,たにの中,なかに泉,いずみをいだし、荒野,あらのを池,いけとなし、かわいた地,ちを水,みずの源,みなもととする。","tok":[["わたし"],["は"],["裸","はだか"],["の"],["山","やま"],["に"],["川","かわ"],["を"],["開らき","ひらき"],["、"],["谷","たに"],["の"],["中","なか"],["に"],["泉","いずみ"],["を"],["いだし"],["、"],["荒野","あら"],["の"],["を"],["池","いけ"],["と"],["なし"],["、"],["かわいた"],["地","ち"],["を"],["水","みず"],["の"],["源","みなもと"],["と"],["する"],["。"]]},{"verse":19,"text":"わたしは荒野,あらのに香柏,こうはく、アカシヤ、ミルトスおよびオリブの木,きを植,うえ、さばくに、いとすぎ、すずかけ、からまつをともに置,おく。","tok":[["わたし"],["は"],["荒野","あら"],["のに"],["香","こう"],["柏","かしわ"],["う"],["はく"],["、"],["アカシヤ"],["、"],["ミルトス"],["および"],["オリブ"],["の"],["木","き"],["を"],["植え","うえ"],["、"],["さばく"],["に"],["、"],["いと"],["すぎ"],["、"],["すずかけ"],["、"],["からまつ"],["を"],["とも"],["に"],["置く","おく"],["。"]]},{"verse":20,"text":"人々,ひとびとはこれを見,みて、主,しゅのみ手,てがこれをなし、イスラエルの聖者,せいじゃがこれを創造,そうぞうされたことを知,しり、かつ、よく考,かんがえて共,ともに悟,さとる」。","tok":[["人々","ひとびと"],["は"],["これ"],["を"],["見て","みて"],["、"],["主","しゅ"],["のみ"],["手","て"],["が"],["これ"],["を"],["なし"],["、"],["イスラエル"],["の"],["聖者","せいじゃ"],["が"],["これ"],["を"],["創造","そうぞう"],["された"],["こと"],["を"],["知り","しり"],["、"],["かつ"],["、"],["よく"],["考","かんがえ"],["て"],["共","とも"],["に"],["悟","さとる"],["」"],["。"]]},{"verse":21,"text":"主,しゅは言,いわれる、「あなたがたの訴,うったえを出,だせ」と。ヤコブの王,おうは言,いわれる、「あなたがたの証拠,しょうこを持,もってこい。","tok":[["主","しゅ"],["は"],["言われる","いわれる"],["、"],["「"],["あなた"],["がた"],["の"],["訴","うったえ"],["を"],["出せ","だせ"],["」"],["と"],["。"],["ヤコブ"],["の"],["王","おう"],["は"],["言われる","いわれる"],["、"],["「"],["あなた"],["がた"],["の"],["証拠","しょうこ"],["を"],["持って","もって"],["こい"],["。"]]},{"verse":22,"text":"それを持,もってきて、起,おこるべき事,ことをわれわれに告,つげよ。さきの事,ことどもの何,なにであるかを告,つげよ。われわれはよく考,かんがえて、その結末,けつまつを知,しろう。あるいはきたるべき事,ことをわれわれに聞,きかせよ。","tok":[["それ"],["を"],["持って","もって"],["きて"],["、"],["起こるべき","おこるべき"],["事","こと"],["を"],["われわれ"],["に"],["告","つげ"],["よ"],["。"],["さき"],["の"],["事","こと"],["ども"],["の"],["何","な"],["に"],["で"],["ある"],["か"],["を"],["告","つげ"],["よ"],["。"],["われわれ"],["は"],["よく"],["考","かんがえ"],["て"],["、"],["その"],["結末","けつまつ"],["を"],["知ろう","しろう"],["。"],["あるいは"],["きたるべき"],["事","こと"],["を"],["われわれ"],["に"],["聞かせ","きかせ"],["よ"],["。"]]},{"verse":23,"text":"この後,のちきたるべき事,ことをわれわれに告,つげよ。われわれはあなたがたが神,かみであることを知,しるであろう。幸,さいわいをくだし、あるいは災,わざわいをくだせ。われわれは驚,おどろいて肝,きもをつぶすであろう。","tok":[["この"],["後","の"],["ち"],["きたるべき"],["事","こと"],["を"],["われわれ"],["に"],["告","つげ"],["よ"],["。"],["われわれ"],["は"],["あなた"],["がた"],["が"],["神","かみ"],["で"],["ある"],["こと"],["を"],["知るで","しるで"],["あろう"],["。"],["幸い","さいわい"],["を"],["くだし"],["、"],["あるいは"],["災","わざわい"],["を"],["くだせ"],["。"],["われわれ"],["は"],["驚ろいて","おどろいて"],["肝","きも"],["を"],["つぶすで"],["あろう"],["。"]]},{"verse":24,"text":"見,みよ、あなたがたは無,なきものである。あなたがたのわざはむなしい。あなたがたを選,えらぶ者,ものは憎,にくむべき者,ものである」。","tok":[["見よ","みよ"],["、"],["あなた"],["がた"],["は"],["無き","なき"],["もの"],["で"],["ある"],["。"],["あなた"],["がた"],["の"],["わざ"],["は"],["むなしい"],["。"],["あなた"],["がた"],["を"],["選ぶ","えらぶ"],["者","もの"],["は"],["憎むべき","にくむべき"],["者","もの"],["で"],["ある"],["」"],["。"]]},{"verse":25,"text":"わたしはひとりを起,おこして北,きたからこさせ、わが名,なを呼,よぶ者,ものを東,ひがしからこさせる。彼,かれはもろもろのつかさを踏,ふみつけてしっくいのようにし、陶器,とうき師,しが粘土,ねんどを踏,ふむようにする。","tok":[["わたし"],["は"],["ひとり"],["を"],["起こして","おこして"],["北","きた"],["から"],["こさせ"],["、"],["わが"],["名","な"],["を"],["呼ぶ","よぶ"],["者","もの"],["を"],["東","ひがし"],["から"],["こさせる"],["。"],["彼","かれ"],["は"],["もろもろ"],["の"],["つかさ"],["を"],["踏みつけて","ふみつけて"],["しっくい"],["の"],["よう"],["に"],["し"],["、"],["陶器師","とうきし"],["が"],["粘土","ねんど"],["を"],["踏む","ふむ"],["よう"],["に"],["する"],["。"]]},{"verse":26,"text":"だれか、初,はじめからこの事,ことをわれわれに告,つげ知,しらせたか。だれか、あらかじめわれわれに告,つげて、「彼,かれは正,ただしい」と言,いわせたか。ひとりもこの事,ことを告,つげた者,ものはない。ひとりも聞,きかせた者,ものはない。ひとりもあなたがたの言葉,ことばを聞,きいた者,ものはない。","tok":[["だれ"],["か"],["、"],["初め","はじめ"],["から"],["この"],["事","こと"],["を"],["われわれ"],["に"],["告","つげ"],["知らせた","しらせた"],["か"],["。"],["だれ"],["か"],["、"],["あらかじめ"],["われわれ"],["に"],["告","つげ"],["て"],["、"],["「"],["彼","かれ"],["は"],["正い","ただしい"],["」"],["と"],["言わせた","いわせた"],["か"],["。"],["ひとり"],["も"],["この"],["事","こと"],["を"],["告","つげ"],["た"],["者","もの"],["は"],["ない"],["。"],["ひとり"],["も"],["聞かせた","きかせた"],["者","もの"],["は"],["ない"],["。"],["ひとり"],["も"],["あなた"],["がた"],["の"],["言葉","ことば"],["を"],["聞いた","きいた"],["者","もの"],["は"],["ない"],["。"]]},{"verse":27,"text":"わたしははじめてこれをシオンに告,つげた。わたしは、よきおとずれを伝,つたえる者,ものをエルサレムに与,あたえる。","tok":[["わたし"],["は"],["はじめて"],["これ"],["を"],["シオン"],["に"],["告","つげ"],["た"],["。"],["わたし"],["は"],["、"],["よき"],["おとずれ"],["を"],["伝える","つたえる"],["者","もの"],["を"],["エルサレム"],["に"],["与える","あたえる"],["。"]]},{"verse":28,"text":"しかし、わたしが見,みると、ひとりもない。彼,かれらのなかには、わたしが尋,たずねても答,こたえうる助言者,じょげんしゃはひとりもない。","tok":[["しかし"],["、"],["わたし"],["が"],["見る","みる"],["と"],["、"],["ひとり"],["も"],["ない"],["。"],["彼","かれ"],["ら"],["の"],["なか"],["に"],["は"],["、"],["わたし"],["が"],["尋ねて","たずねて"],["も"],["答","こたえ"],["うる"],["助言者","じょげんしゃ"],["は"],["ひとり"],["も"],["ない"],["。"]]},{"verse":29,"text":"見,みよ、彼,かれらはみな人,ひとを惑,まどわす者,ものであって、そのわざは無,なきもの、その鋳,いた像,ぞうはむなしき風,かぜである。","tok":[["見よ","みよ"],["、"],["彼","かれ"],["ら"],["は"],["みな"],["人","ひと"],["を"],["惑わす","まどわす"],["者","もの"],["で"],["あって"],["、"],["その"],["わざ"],["は"],["無き","なき"],["もの"],["、"],["その"],["鋳た","いた"],["像","ぞう"],["は"],["むなし"],["き"],["風","かぜ"],["で"],["ある"],["。"]]}]
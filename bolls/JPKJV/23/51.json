[{"verse":1,"text":"「義,ぎを追,おい求,もとめ、主,しゅを尋,たずね求,もとめる者,ものよ、わたしに聞,きけ。あなたがたの切,きり出,だされた岩,いわと、あなたがたの掘,ほり出,だされた穴,あなとを思,おもいみよ。","tok":[["「"],["義","ぎ"],["を"],["追い求め","おいもとめ"],["、"],["主","しゅ"],["を"],["尋ね求める","たずねもとめる"],["者","もの"],["よ"],["、"],["わたし"],["に"],["聞け","きけ"],["。"],["あなた"],["がた"],["の"],["切り出された","きりだされた"],["岩","いわ"],["と"],["、"],["あなた"],["がた"],["の"],["掘出された","ほりだされた"],["穴","あな"],["と"],["を"],["思いみ","おもいみ"],["よ"],["。"]]},{"verse":2,"text":"あなたがたの父,ちちアブラハムと、あなたがたを産,うんだサラとを思,おもいみよ。わたしは彼,かれをただひとりであったときに召,めし、彼,かれを祝福,しゅくふくして、その子孫,しそんを増,まし加,くわえた。","tok":[["あなた"],["がた"],["の"],["父","ちち"],["アブラハム"],["と"],["、"],["あなた"],["がた"],["を"],["産んだ","うんだ"],["サラ"],["と"],["を"],["思いみ","おもいみ"],["よ"],["。"],["わたし"],["は"],["彼","かれ"],["を"],["ただ"],["ひとり"],["で"],["あった"],["とき"],["に"],["召","めし"],["、"],["彼","かれ"],["を"],["祝福","しゅくふく"],["して"],["、"],["その"],["子孫","しそん"],["を"],["増し加えた","ましくわえた"],["。"]]},{"verse":3,"text":"主,しゅはシオンを慰,なぐさめ、またそのすべて荒,あれた所,ところを慰,なぐさめて、その荒野,あらのをエデンのように、そのさばくを主,しゅの園,そののようにされる。こうして、その中,なかに喜,よろこびと楽,たのしみとがあり、感謝,かんしゃと歌,うたの声,こえとがある。","tok":[["主","しゅ"],["は"],["シオン"],["を"],["慰さめ","なぐさめ"],["、"],["また"],["その"],["すべて"],["荒れた","あれた"],["所","ところ"],["を"],["慰さめて","なぐさめて"],["、"],["その"],["荒野","あら"],["の"],["を"],["エデン"],["の"],["よう"],["に"],["、"],["その"],["さばく"],["を"],["主","しゅ"],["の"],["園","その"],["の"],["よう"],["に"],["される"],["。"],["こう"],["して"],["、"],["その"],["中","なか"],["に"],["喜こび","よろこび"],["と"],["楽み","たのしみ"],["と"],["が"],["あり"],["、"],["感謝","かんしゃ"],["と"],["歌","うた"],["の"],["声","こえ"],["と"],["が"],["ある"],["。"]]},{"verse":4,"text":"わが民,たみよ、わたしに聞,きけ、わが国,くにびとよ、わたしに耳,みみを傾,かたむけよ。律法,りっぽうはわたしから出,で、わが道,みちはもろもろの民,たみの光,ひかりとなる。","tok":[["わが"],["民","たみ"],["よ"],["、"],["わたし"],["に"],["聞け","きけ"],["、"],["わが"],["国びと","くにびと"],["よ"],["、"],["わたし"],["に"],["耳","みみ"],["を"],["傾むけよ","かたむけよ"],["。"],["律法","りっぽう"],["は"],["わたし"],["から"],["出","で"],["、"],["わが"],["道","みち"],["は"],["もろもろ"],["の"],["民","たみ"],["の"],["光","ひかり"],["と"],["なる"],["。"]]},{"verse":5,"text":"わが義,ぎはすみやかに近,ちかづき、わが救,すくいは出,でて行,いった。わが腕,うではもろもろの民,たみを治,おさめる。海沿,うみぞいの国々,くにぐにはわたしを待,まち望,のぞみ、わが腕,うでに寄,より頼,たのむ。","tok":[["わが"],["義","ぎ"],["は"],["すみやか"],["に"],["近づき","ちかづき"],["、"],["わが"],["救い","すくい"],["は"],["出て","でて"],["行った","いった"],["。"],["わが"],["腕","うで"],["は"],["もろもろ"],["の"],["民","たみ"],["を"],["治める","おさめる"],["。"],["海沿い","うみぞい"],["の"],["国々","くにぐに"],["は"],["わたし"],["を"],["待ち望み","まちのぞみ"],["、"],["わが"],["腕","うで"],["に"],["寄り","より"],["頼む","たのむ"],["。"]]},{"verse":6,"text":"目,めをあげて天,てんを見,み、また,また下,したなる地,ちを見,みよ。天,てんは煙,けむりのように消,きえ、地,ちは衣,ころものようにふるび、その中,なかに住,すむ者,ものは、ぶよのように死,しぬ。しかし、わが救,すくいはとこしえにながらえ、わが義,ぎはくじけることがない。","tok":[["目","め"],["を"],["あげて"],["天","てん"],["を"],["見","み"],["、"],["また"],[","],["また下","またした"],["なる"],["地","ち"],["を"],["見よ","みよ"],["。"],["天","てん"],["は"],["煙","けむり"],["の"],["よう"],["に"],["消え","きえ"],["、"],["地","ち"],["は"],["衣","ころも"],["の"],["よう"],["に"],["ふるび"],["、"],["その"],["中","なか"],["に"],["住む","すむ"],["者","もの"],["は"],["、"],["ぶよ"],["の"],["よう"],["に"],["死ぬ","しぬ"],["。"],["しかし"],["、"],["わが"],["救い","すくい"],["は"],["とこしえ"],["に"],["ながらえ"],["、"],["わが"],["義","ぎ"],["は"],["くじける"],["こと"],["が"],["ない"],["。"]]},{"verse":7,"text":"義,ぎを知,しる者,ものよ、心,こころのうちにわが律法,りっぽうをたもつ者,ものよ、わたしに聞,きけ。人,ひとのそしりを恐,おそれてはならない、彼,かれらのののしりに驚,おどろいてはならない。","tok":[["義","ぎ"],["を"],["知る","しる"],["者","もの"],["よ"],["、"],["心","こころ"],["の"],["うち"],["に"],["わが"],["律法","りっぽう"],["を"],["たもつ"],["者","もの"],["よ"],["、"],["わたし"],["に"],["聞け","きけ"],["。"],["人","ひと"],["の"],["そ"],["しり"],["を"],["恐れて","おそれて"],["は"],["ならない"],["、"],["彼","かれ"],["ら"],["の"],["ののしり"],["に"],["驚ろいて","おどろいて"],["は"],["ならない"],["。"]]},{"verse":8,"text":"彼,かれらは衣,ころものように、しみに食,くわれ、羊,ひつじの毛,けのように虫,むしに食,くわれるからだ。しかし、わが義,ぎはとこしえにながらえ、わが救,すくいはよろず代,よに及,およぶ」。","tok":[["彼","かれ"],["ら"],["は"],["衣","ころも"],["の"],["よう"],["に"],["、"],["しみ"],["に"],["食われ","くわれ"],["、"],["羊","ひつじ"],["の"],["毛","け"],["の"],["よう"],["に"],["虫","むし"],["に"],["食われる","くわれる"],["から"],["だ"],["。"],["しかし"],["、"],["わが"],["義","ぎ"],["は"],["とこしえ"],["に"],["ながらえ"],["、"],["わが"],["救い","すくい"],["は"],["よろず代","よろずよ"],["に"],["及ぶ","およぶ"],["」"],["。"]]},{"verse":9,"text":"主,しゅのかいなよ、さめよ、さめよ、力,ちからを着,きよ。さめて、いにしえの日,ひ、昔,むかしの代,よにあったようになれ。ラハブを切,きり殺,ころし、龍,りゅうを刺,さし貫,つらぬいたのは、あなたではなかったか。","tok":[["主","しゅ"],["の"],["かいな"],["よ"],["、"],["さめ"],["よ"],["、"],["さめ"],["よ"],["、"],["力","ちから"],["を"],["着","き"],["よ"],["。"],["さめて"],["、"],["いにしえ"],["の"],["日","ひ"],["、"],["昔","むかし"],["の"],["代","よ"],["に"],["あった"],["よう"],["に"],["なれ"],["。"],["ラハブ"],["を"],["切り殺し","きりころし"],["、"],["龍","りゅう"],["を"],["刺","さし"],["貫ぬいた","つらぬいた"],["の"],["は"],["、"],["あなた"],["で"],["は"],["なかった"],["か"],["。"]]},{"verse":10,"text":"海,うみをかわかし、大,おおいなる淵,ふちの水,みずをかわかし、また海,うみの深,ふかき所,ところを、あがなわれた者,ものの過,すぎる道,みちとされたのは、あなたではなかったか。","tok":[["海","うみ"],["を"],["かわかし"],["、"],["大いなる","おおいなる"],["淵","ふち"],["の"],["水","みず"],["を"],["かわかし"],["、"],["また"],["海","うみ"],["の"],["深き","ふかき"],["所","ところ"],["を"],["、"],["あがなわれた"],["者","もの"],["の"],["過る","すぎる"],["道","みち"],["と"],["された"],["の"],["は"],["、"],["あなた"],["で"],["は"],["なかった"],["か"],["。"]]},{"verse":11,"text":"主,しゅにあがなわれた者,ものは、歌,うたうたいつつ、シオンに帰,かえってきて、そのこうべに、とこしえの喜,よろこびをいただき、彼,かれらは喜,よろこびと楽,たのしみとを得,え、悲,かなしみと嘆,なげきとは逃,にげ去,さる。","tok":[["主に","しゅに"],["あがなわれた"],["者","もの"],["は"],["、"],["歌うたい","うたうたい"],["つつ"],["、"],["シオン"],["に"],["帰えって","かえって"],["きて"],["、"],["その"],["こうべ"],["に"],["、"],["とこしえ"],["の"],["喜こび","よろこび"],["を"],["いただき"],["、"],["彼","かれ"],["ら"],["は"],["喜こび","よろこび"],["と"],["楽み","たのしみ"],["と"],["を"],["得","え"],["、"],["悲しみ","かなしみ"],["と"],["嘆き","なげき"],["と"],["は"],["逃","にげ"],["去る","さる"],["。"]]},{"verse":12,"text":"「わたしこそあなたを慰,なぐさめる者,ものだ。あなたは何者,なにものなれば、死,しぬべき人,ひとを恐,おそれ、草,くさのようになるべき人,ひとの子,こを恐,おそれるのか。","tok":[["「"],["わたし"],["こそ"],["あなた"],["を"],["慰さめる","なぐさめる"],["者","もの"],["だ"],["。"],["あなた"],["は"],["何者","なにもの"],["なれば"],["、"],["死ぬべき","しぬべき"],["人","ひと"],["を"],["恐","おそれ"],["、"],["草","くさ"],["の"],["よう"],["に"],["なるべき"],["人","ひと"],["の"],["子","こ"],["を"],["恐れる","おそれる"],["の"],["か"],["。"]]},{"verse":13,"text":"天,てんをのべ、地,ちの基,もといをすえられたあなたの造,つくり主,ぬし、主,しゅを忘,わすれて、なぜ、しえたげる者,ものが滅,ほろぼそうと備,そなえをするとき、その憤,いきどおりのゆえに常,つねにひねもす恐,おそれるのか。しえたげる者,ものの憤,いきどおりはどこにあるか。","tok":[["天","てん"],["を"],["のべ"],["、"],["地","ち"],["の"],["基い","もとい"],["を"],["すえられた"],["あなた"],["の"],["造主","つくりぬし"],["、"],["主","しゅ"],["を"],["忘て","わすれて"],["、"],["なぜ"],["、"],["し"],["えたげる"],["者","もの"],["が"],["滅ぼそう","ほろぼそう"],["と"],["備","そなえ"],["を"],["する"],["とき"],["、"],["その"],["憤り","いきどおり"],["の"],["ゆえ"],["に"],["常","つね"],["に"],["ひねもす"],["恐れる","おそれる"],["の"],["か"],["。"],["し"],["えたげる"],["者","もの"],["の"],["憤り","いきどおり"],["は"],["どこ"],["に"],["ある"],["か"],["。"]]},{"verse":14,"text":"身,みをかがめている捕,とらわれ人,びとは、すみやかに解,とかれて、死,しぬことなく、穴,あなにくだることなく、その食物,しょくもつはつきることがない。","tok":[["身","み"],["を"],["かがめて"],["いる"],["捕らわれ","とらわれ"],["人","びと"],["は"],["、"],["すみやか"],["に"],["解かれて","とかれて"],["、"],["死ぬ","しぬ"],["こと"],["なく"],["、"],["穴","あな"],["に"],["くだる"],["こと"],["なく"],["、"],["その"],["食物","しょくもつ"],["は"],["つきる"],["こと"],["が"],["ない"],["。"]]},{"verse":15,"text":"わたしは海,うみをふるわせ、その波,なみをなりどよめかすあなたの神,かみ、主,しゅである。その名,なを万軍,ばんぐんの主,しゅという。","tok":[["わたし"],["は"],["海","うみ"],["を"],["ふるわせ"],["、"],["その"],["波","なみ"],["を"],["なり"],["ど"],["よ"],["めかす"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["で"],["ある"],["。"],["その"],["名","な"],["を"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["と"],["いう"],["。"]]},{"verse":16,"text":"わたしはわが言葉,ことばをあなたの口,くちにおき、わが手,ての陰,かげにあなたを隠,かくした。こうして、わたしは天,てんをのべ、地,ちの基,もといをすえ、シオンにむかって、あなたはわが民,たみであると言,いう」。","tok":[["わたし"],["は"],["わが"],["言葉","ことば"],["を"],["あなた"],["の"],["口","くち"],["に"],["おき"],["、"],["わが"],["手","て"],["の"],["陰","かげ"],["に"],["あなた"],["を"],["隠した","かくした"],["。"],["こう"],["して"],["、"],["わたし"],["は"],["天","てん"],["を"],["のべ"],["、"],["地","ち"],["の"],["基い","もとい"],["を"],["すえ"],["、"],["シオン"],["に"],["むかって"],["、"],["あなた"],["は"],["わが"],["民","たみ"],["で"],["ある"],["と"],["言う","いう"],["」"],["。"]]},{"verse":17,"text":"エルサレムよ、起,おきよ、起,おきよ、立,たて。あなたはさきに主,しゅの手,てから憤,いきどおりの杯,さかずきをうけて飲,のみ、よろめかす大杯,おおさかずきを、滓,かすまでも飲,のみほした。","tok":[["エルサレム"],["よ"],["、"],["起きよ","おきよ"],["、"],["起きよ","おきよ"],["、"],["立","たて"],["。"],["あなた"],["は"],["さき"],["に"],["主","しゅ"],["の"],["手","て"],["から"],["憤り","いきどおり"],["の"],["杯","さかずき"],["を"],["うけて"],["飲み","のみ"],["、"],["よろ"],["めかす"],["大杯","おおさかずき"],["を"],["、"],["滓","かす"],["まで"],["も"],["飲みほした","のみほした"],["。"]]},{"verse":18,"text":"その産,うんだもろもろの子,このなかに、自分,じぶんを導,みちびく者,ものなく、その育,そだてたもろもろの子,このなかに、自分,じぶんの手,てをとる者,ものがない。","tok":[["その"],["産んだ","うんだ"],["もろもろ"],["の"],["子","こ"],["の"],["なか"],["に"],["、"],["自分","じぶん"],["を"],["導く","みちびく"],["者","もの"],["なく"],["、"],["その"],["育てた","そだてた"],["もろもろ"],["の"],["子","こ"],["の"],["なか"],["に"],["、"],["自分","じぶん"],["の"],["手","て"],["を"],["とる"],["者","もの"],["が"],["ない"],["。"]]},{"verse":19,"text":"これら二つの事,ことがあなたに臨,のぞんだ――だれがあなたと共,ともに嘆,なげくだろうか――荒廃,こうはいと滅亡,めつぼう、ききんとつるぎ。だれがあなたを慰,なぐさめるだろうか。","tok":[["これ"],["ら"],["二","ふた"],["つ"],["の"],["事","こと"],["が"],["あなた"],["に"],["臨んだ","のぞんだ"],["―"],["―"],["だれ"],["が"],["あなた"],["と"],["共","とも"],["に"],["嘆くだろう","なげくだろう"],["か"],["―"],["―"],["荒廃","こうはい"],["と"],["滅亡","めつぼう"],["、"],["ききん"],["と"],["つるぎ"],["。"],["だれ"],["が"],["あなた"],["を"],["慰さめるだろう","なぐさめるだろう"],["か"],["。"]]},{"verse":20,"text":"あなたの子,こらは息,いき絶,たえだえになり、網,あみにかかった、かもしかのように、すべてのちまたのすみに横,よこたわり、主,しゅの憤,いきどおりと、あなたの神,かみの責,せめとは、彼,かれらに満,みちている。","tok":[["あなた"],["の"],["子","こ"],["ら"],["は"],["息","いき"],["絶えだえ","たえだえ"],["に"],["なり"],["、"],["網","あみ"],["に"],["かかった"],["、"],["かもしか"],["の"],["よう"],["に"],["、"],["すべて"],["の"],["ちまた"],["の"],["すみ"],["に"],["横たわり","よこたわり"],["、"],["主","しゅ"],["の"],["憤り","いきどおり"],["と"],["、"],["あなた"],["の"],["神","かみ"],["の"],["責","せめ"],["と"],["は"],["、"],["彼","かれ"],["ら"],["に"],["満ちて","みちて"],["いる"],["。"]]},{"verse":21,"text":"それゆえ、苦,くるしめる者,もの、酒,さけにではなく酔,よっている者,ものよ、これを聞,きけ。","tok":[["それ"],["ゆえ"],["、"],["苦める","くるしめる"],["者","もの"],["、"],["酒","さけ"],["に"],["で"],["は"],["なく"],["酔って","よって"],["いる"],["者","もの"],["よ"],["、"],["これ"],["を"],["聞け","きけ"],["。"]]},{"verse":22,"text":"あなたの主,しゅ、おのが民,たみの訴,うったえを弁護,べんごされるあなたの神,かみ、主,しゅはこう言,いわれる、「見,みよ、わたしはよろめかす杯,さかずきをあなたの手,てから取,とり除,のぞき、わが憤,いきどおりの大杯,おおさかずきを取,とり除,のぞいた。あなたは再,ふたたびこれを飲,のむことはない。","tok":[["あなた"],["の"],["主","しゅ"],["、"],["お"],["の"],["が"],["民","たみ"],["の"],["訴","うったえ"],["を"],["弁護","べんご"],["される"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["「"],["見よ","みよ"],["、"],["わたし"],["は"],["よろ"],["めかす"],["杯","さかずき"],["を"],["あなた"],["の"],["手","て"],["から"],["取除き","とりのぞき"],["、"],["わが"],["憤り","いきどおり"],["の"],["大杯","おおさかずき"],["を"],["取除いた","とりのぞいた"],["。"],["あなた"],["は"],["再び","ふたたび"],["これ"],["を"],["飲む","のむ"],["こと"],["は"],["ない"],["。"]]},{"verse":23,"text":"わたしはこれをあなたを悩,なやます者,ものの手,てにおく。彼,かれらはさきにあなたにむかって言,いった、『身,みをかがめよ、われわれは越,こえていこう』と。そしてあなたはその背,せを地,ちのようにし、ちまたのようにして、彼,かれらの越,こえていくにまかせた」。","tok":[["わたし"],["は"],["これ"],["を"],["あなた"],["を"],["悩す","なやます"],["者","もの"],["の"],["手","て"],["に"],["おく"],["。"],["彼","かれ"],["ら"],["は"],["さき"],["に"],["あなた"],["に"],["むかって"],["言った","いった"],["、"],["『"],["身","み"],["を"],["かがめよ"],["、"],["われわれ"],["は"],["越えて","こえて"],["いこう"],["』"],["と"],["。"],["そして"],["あなた"],["は"],["その"],["背","せ"],["を"],["地","ち"],["の"],["よう"],["に"],["し"],["、"],["ちまた"],["の"],["よう"],["に"],["して"],["、"],["彼","かれ"],["ら"],["の"],["越えて","こえて"],["いく"],["に"],["まかせた"],["」"],["。"]]}]
[{"verse":1,"text":"見,みよ、主,しゅ、万軍,ばんぐんの主,しゅはエルサレムとユダからささえとなり、頼,たのみとなるもの――すべてささえとなるパン、すべてささえとなる水,みず――を取,とり去,さられる。","tok":[["見よ","みよ"],["、"],["主","しゅ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["エルサレム"],["と"],["ユダ"],["から"],["ささえ"],["と"],["なり"],["、"],["頼み","たのみ"],["と"],["なる"],["もの"],["―"],["―"],["すべて"],["ささえ"],["と"],["なる"],["パン"],["、"],["すべて"],["ささえ"],["と"],["なる"],["水","みず"],["―"],["―"],["を"],["取去られる","とりさられる"],["。"]]},{"verse":2,"text":"すなわち勇士,ゆうしと軍人,ぐんじん、裁判官,さいばんかんと預言者,よげんしゃ、占,うらない師,しと長老,ちょうろう、","tok":[["すなわち"],["勇士","ゆうし"],["と"],["軍人","ぐんじん"],["、"],["裁判官","さいばんかん"],["と"],["預言者","よげんしゃ"],["、"],["占師","うらないし"],["と"],["長老","ちょうろう"],["、"]]},{"verse":3,"text":"五十人,にんの長,ちょうと身分,みぶんの高,たかい人,ひと、議,ぎ官,かんと巧,たくみな魔術,まじゅつ師,し、老練,ろうれんなまじない師,しを取,とり去,さられる。","tok":[["五","ご"],["十人","じゅうにん"],["の"],["長","ちょう"],["と"],["身分","みぶん"],["の"],["高い","たかい"],["人","ひと"],["、"],["議官","ぎかん"],["と"],["巧み","たくみ"],["な"],["魔術師","まじゅつし"],["、"],["老練","ろうれん"],["な"],["まじない"],["師","し"],["を"],["取去られる","とりさられる"],["。"]]},{"verse":4,"text":"わたしはわらべを立,たてて彼,かれらの君,きみとし、みどりごに彼,かれらを治,おさめさせる。","tok":[["わたし"],["は"],["わらべ"],["を"],["立てて","たてて"],["彼","かれ"],["ら"],["の"],["君","きみ"],["と"],["し"],["、"],["みどりご"],["に"],["彼","かれ"],["ら"],["を"],["治めさせる","おさめさせる"],["。"]]},{"verse":5,"text":"民,たみは互,たがいに相,あいしえたげ、人,ひとはおのおのその隣,となりをしえたげ、若,わかい者,ものは老,おいたる者,ものにむかって高,たかぶり、卑,いやしい者,ものは尊,たっとい者,ものにむかって高,たかぶる。","tok":[["民","たみ"],["は"],["互","たがい"],["に"],["相","あ"],["いし"],["え"],["たげ"],["、"],["人","ひと"],["は"],["おのおの"],["その"],["隣","となり"],["を"],["し"],["えたげ"],["、"],["若い","わかい"],["者","もの"],["は"],["老","おい"],["たる"],["者","もの"],["に"],["むかって"],["高か","たか"],["ぶり"],["、"],["卑しい","いやしい"],["者","もの"],["は"],["尊","た"],["っと"],["い"],["者","もの"],["に"],["むかって"],["高か","たか"],["ぶる"],["。"]]},{"verse":6,"text":"その時,とき、人,ひとはその父,ちちの家,いえで、兄弟,きょうだいをつかまえて言,いう、「あなたは外套,がいとうを持,もっている、わたしたちのつかさびとになって、この荒,あれ跡,あとをあなたの手,てで治,おさめてください」と。","tok":[["その"],["時","とき"],["、"],["人","ひと"],["は"],["その"],["父","ちち"],["の"],["家","いえ"],["で"],["、"],["兄弟","きょうだい"],["を"],["つかまえて"],["言う","いう"],["、"],["「"],["あなた"],["は"],["外套","がいとう"],["を"],["持って","もって"],["いる"],["、"],["わたしたち"],["の"],["つかさ"],["びと"],["に"],["なって"],["、"],["この"],["荒れ","あれ"],["跡","あと"],["を"],["あなた"],["の"],["手","て"],["で"],["治めて","おさめて"],["ください"],["」"],["と"],["。"]]},{"verse":7,"text":"その日,ひ、彼,かれは声,こえをあげて言,いう、「わたしはいやす者,ものとなることはできません、わたしの家,いえにはパンもなく、外套,がいとうもありません、わたしを立,たてて、民,たみのつかさびとにしないでください」。","tok":[["その"],["日","ひ"],["、"],["彼","かれ"],["は"],["声","こえ"],["を"],["あげて"],["言う","いう"],["、"],["「"],["わたし"],["は"],["いやす"],["者","もの"],["と"],["なる"],["こと"],["は"],["できません"],["、"],["わたし"],["の"],["家","いえ"],["に"],["は"],["パン"],["も"],["なく"],["、"],["外套","がいとう"],["も"],["ありません"],["、"],["わたし"],["を"],["立てて","たてて"],["、"],["民","たみ"],["の"],["つかさ"],["びと"],["に"],["しないで"],["ください"],["」"],["。"]]},{"verse":8,"text":"これは彼,かれらの言葉,ことばと行,おこないとが主,しゅにそむき、その栄光,えいこうの目,めをおかしたので、エルサレムはつまずき、ユダは倒,たおれたからである。","tok":[["これ"],["は"],["彼","かれ"],["ら"],["の"],["言葉","ことば"],["と"],["行ない","おこない"],["と"],["が"],["主","しゅ"],["に"],["そむき"],["、"],["その"],["栄光","えいこう"],["の"],["目","め"],["を"],["おかした"],["ので"],["、"],["エルサレム"],["は"],["つまずき"],["、"],["ユダ"],["は"],["倒れた","たおれた"],["から"],["で"],["ある"],["。"]]},{"verse":9,"text":"彼,かれらの不公平,ふこうへいは彼,かれらにむかって不利,ふりなあかしをし、ソドムのようにその罪,つみをあらわして隠,かくさない。わざわいなるかな、彼,かれらはみずから悪,あくの報,むくいをうけた。","tok":[["彼","かれ"],["ら"],["の"],["不公平","ふこうへい"],["は"],["彼","かれ"],["ら"],["に"],["むかって"],["不利","ふり"],["な"],["あかし"],["を"],["し"],["、"],["ソドム"],["の"],["よう"],["に"],["その"],["罪","つみ"],["を"],["あらわして"],["隠さない","かくさない"],["。"],["わざわい"],["なる"],["か"],["な"],["、"],["彼","かれ"],["ら"],["は"],["みずから"],["悪","あく"],["の"],["報い","むくい"],["を"],["うけた"],["。"]]},{"verse":10,"text":"正,ただしい人,ひとに言,いえ、彼,かれらはさいわいであると。彼,かれらはその行,おこないの実,みを食,たべるからである。","tok":[["正い","ただしい"],["人","ひと"],["に"],["言え","いえ"],["、"],["彼","かれ"],["ら"],["は"],["さいわい"],["で"],["ある"],["と"],["。"],["彼","かれ"],["ら"],["は"],["その"],["行ない","おこない"],["の"],["実","み"],["を"],["食べる","たべる"],["から"],["で"],["ある"],["。"]]},{"verse":11,"text":"悪,あしき者,ものはわざわいだ、彼,かれは災,わざわいをうける。その手,てのなした事,ことが彼,かれに報,むくいられるからである。","tok":[["悪しき","あしき"],["者","もの"],["は"],["わざわい"],["だ"],["、"],["彼","かれ"],["は"],["災","わざわい"],["を"],["うける"],["。"],["その"],["手","て"],["の"],["なした"],["事","こと"],["が"],["彼","かれ"],["に"],["報いられる","むくいられる"],["から"],["で"],["ある"],["。"]]},{"verse":12,"text":"わが民,たみは幼,おさな子,ごにしえたげられ、女,おんなたちに治,おさめられる。ああ、わが民,たみよ、あなたを導,みちびく者,ものはかえって、あなたを迷,まよわせ、あなたの行,いくべき道,みちを混乱,こんらんさせる。","tok":[["わが"],["民","たみ"],["は"],["幼な子","おさなご"],["に"],["し"],["えたげられ"],["、"],["女","おんな"],["たち"],["に"],["治められる","おさめられる"],["。"],["ああ"],["、"],["わが"],["民","たみ"],["よ"],["、"],["あなた"],["を"],["導く","みちびく"],["者","もの"],["は"],["かえって"],["、"],["あなた"],["を"],["迷わせ","まよわせ"],["、"],["あなた"],["の"],["行くべき","いくべき"],["道","みち"],["を"],["混乱","こんらん"],["させる"],["。"]]},{"verse":13,"text":"主,しゅは言,いい争,あらそうために立,たちあがり、その民,たみをさばくために立,たたれる。","tok":[["主","しゅ"],["は"],["言い争う","いいあらそう"],["ため"],["に"],["立ちあがり","たちあがり"],["、"],["その"],["民","たみ"],["を"],["さばく"],["ため"],["に"],["立たれる","たたれる"],["。"]]},{"verse":14,"text":"主,しゅはその民,たみの長老,ちょうろうと君,きみたちとをさばいて、「あなたがたは、ぶどう畑,はたけを食,くい荒,あらした。貧,まずしい者,ものからかすめとった物,ものは、あなたがたの家,いえにある。","tok":[["主","しゅ"],["は"],["その"],["民","たみ"],["の"],["長老","ちょうろう"],["と"],["君","きみ"],["たち"],["と"],["を"],["さばいて"],["、"],["「"],["あなた"],["がた"],["は"],["、"],["ぶどう"],["畑","はたけ"],["を"],["食い荒した","くいあらした"],["。"],["貧しい","まずしい"],["者","もの"],["から"],["かすめとった"],["物","もの"],["は"],["、"],["あなた"],["がた"],["の"],["家","いえ"],["に"],["ある"],["。"]]},{"verse":15,"text":"なぜ、あなたがたはわが民,たみを踏,ふみにじり、貧,まずしい者,ものの顔,かおをすり砕,くだくのか」と万軍,ばんぐんの神,かみ、主,しゅは言,いわれる。","tok":[["なぜ"],["、"],["あなた"],["がた"],["は"],["わが"],["民","たみ"],["を"],["踏みにじり","ふみにじり"],["、"],["貧しい","まずしい"],["者","もの"],["の"],["顔","かお"],["を"],["すり砕く","すりくだく"],["の"],["か"],["」"],["と"],["万","まん"],["軍","ぐん"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":16,"text":"主,しゅは言,いわれた、シオンの娘,むすめらは高,たかぶり、首,くびをのばしてあるき、目,めでこびをおくり、その行,ゆくとき気,きどって歩,あるき、その足,あしでりんりんと鳴,なり響,ひびかす。","tok":[["主","しゅ"],["は"],["言われた","いわれた"],["、"],["シオン"],["の"],["娘","むすめ"],["ら"],["は"],["高か","たか"],["ぶり"],["、"],["首","くび"],["を"],["のばして"],["あるき"],["、"],["目","め"],["で"],["こび"],["を"],["おくり"],["、"],["その"],["行く","ゆく"],["とき"],["気どって","きどって"],["歩き","あるき"],["、"],["その"],["足","あし"],["で"],["りんりん"],["と"],["鳴り響かす","なりひびかす"],["。"]]},{"verse":17,"text":"それゆえ、主,しゅはシオンの娘,むすめらの頭,あたまを撃,うって、かさぶたでおおい、彼,かれらの隠,かくれた所,ところをあらわされる。","tok":[["それ"],["ゆえ"],["、"],["主","しゅ"],["は"],["シオン"],["の"],["娘","むすめ"],["ら"],["の"],["頭","あたま"],["を"],["撃って","うって"],["、"],["かさぶた"],["で"],["おおい"],["、"],["彼","かれ"],["ら"],["の"],["隠れた","かくれた"],["所","ところ"],["を"],["あらわされる"],["。"]]},{"verse":18,"text":"その日,ひ、主,しゅは彼,かれらの美,うつくしい装身具,そうしんぐと服装,ふくそうすなわち、くるぶし輪,わ、髪,かみひも、月形,つきがたの飾,かざり、","tok":[["その"],["日","ひ"],["、"],["主","しゅ"],["は"],["彼","かれ"],["ら"],["の"],["美しい","うつくしい"],["装身具","そうしんぐ"],["と"],["服装","ふくそう"],["すなわち"],["、"],["くるぶし"],["輪","わ"],["、"],["髪","かみ"],["ひも"],["、"],["月形","つきがた"],["の"],["飾","かざり"],["、"]]},{"verse":19,"text":"耳輪,みみわ、腕輪,うでわ、顔,かおおおい、","tok":[["耳輪","みみわ"],["、"],["腕輪","うでわ"],["、"],["顔","かお"],["おおい"],["、"]]},{"verse":20,"text":"頭,あたま飾,かざり、すね飾,かざり、飾,かざり帯,おび、香箱,こうばこ、守,まもり袋,ふくろ、","tok":[["頭","あたま"],["飾","かざり"],["、"],["す"],["ね"],["飾","かざり"],["、"],["飾帯び","かざりおび"],["、"],["香箱","こうばこ"],["、"],["守り袋","まもりふくろ"],["、"]]},{"verse":21,"text":"指輪,ゆびわ、鼻輪,はなわ、","tok":[["指輪","ゆびわ"],["、"],["鼻輪","はなわ"],["、"]]},{"verse":22,"text":"礼服,れいふく、外套,がいとう、肩掛,かたかけ、手,てさげ袋,ふくろ、","tok":[["礼服","れいふく"],["、"],["外套","がいとう"],["、"],["肩掛","かたかけ"],["、"],["手さげ","てさげ"],["袋","ふくろ"],["、"]]},{"verse":23,"text":"薄,うす織,おりの上着,うわぎ、亜麻,あま布,ぬのの着物,きもの、帽子,ぼうし、被衣,かずきなどを取,とり除,のぞかれる。","tok":[["薄","うす"],["織","おり"],["の"],["上着","うわぎ"],["、"],["亜","あ"],["麻布","麻ぬの"],["の"],["着物","きもの"],["、"],["帽子","ぼうし"],["、"],["被衣","かずきなど"],["を"],["取除かれる","とりのぞかれる"],["。"]]},{"verse":24,"text":"芳香,ほうこうはかわって、悪臭,あくしゅうとなり、帯,おびはかわって、なわとなり、よく編,あんだ髪,かみはかわって、かぶろとなり、はなやかな衣,ころもはかわって、荒布,あらぬのの衣,ころもとなり、美,うつくしい顔,かおはかわって、焼,やき印,いんされた顔,かおとなる。","tok":[["芳香","ほうこう"],["は"],["かわって"],["、"],["悪臭","あくしゅう"],["と"],["なり"],["、"],["帯","おび"],["は"],["かわって"],["、"],["なわ"],["と"],["なり"],["、"],["よく"],["編んだ","あんだ"],["髪","かみ"],["は"],["かわって"],["、"],["かぶろ"],["と"],["なり"],["、"],["はなやか"],["な"],["衣","ころも"],["は"],["かわって"],["、"],["荒布","あらぬ"],["の"],["の"],["衣","ころも"],["と"],["なり"],["、"],["美しい","うつくしい"],["顔","かお"],["は"],["かわって"],["、"],["焼き印","やきいん"],["された"],["顔","かお"],["と"],["なる"],["。"]]},{"verse":25,"text":"あなたの男,おとこたちはつるぎに倒,たおれ、あなたの勇士,ゆうしたちは戦,たたかいに倒,たおれる。","tok":[["あなた"],["の"],["男","おとこ"],["たち"],["は"],["つるぎ"],["に"],["倒れ","たおれ"],["、"],["あなた"],["の"],["勇士","ゆうし"],["たち"],["は"],["戦い","たたかい"],["に"],["倒れる","たおれる"],["。"]]},{"verse":26,"text":"シオンの門,もんは嘆,なげき悲,かなしみ、シオンは荒,あれすたれて、地,ちに座,ざする。","tok":[["シオン"],["の"],["門","もん"],["は"],["嘆き悲しみ","なげきかなしみ"],["、"],["シオン"],["は"],["荒れ","あれ"],["すたれて"],["、"],["地","ち"],["に"],["座する","ざする"],["。"]]}]
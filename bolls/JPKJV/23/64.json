[{"verse":1,"text":"[2]火,ひが柴木,しばきを燃,もやし、火,ひが水,みずを沸,わかすときのごとく下,くだられるように。そして、み名,なをあなたのあだにあらわし、もろもろの国,くにをあなたの前,まえに震,ふるえおののかせられるように。","tok":[["["],["2"],["]"],["火","ひ"],["が"],["柴木","しばき"],["を"],["燃やし","もやし"],["、"],["火","ひ"],["が"],["水","みず"],["を"],["沸かす","わかす"],["とき"],["の"],["ごとく"],["下られる","くだられる"],["よう"],["に"],["。"],["そして"],["、"],["み名","みな"],["を"],["あなた"],["の"],["あだ"],["に"],["あらわし"],["、"],["もろもろ"],["の"],["国","くに"],["を"],["あなた"],["の"],["前","まえ"],["に"],["震えおののかせられる","ふるえおののかせられる"],["よう"],["に"],["。"]]},{"verse":2,"text":"[3]あなたは、われわれが期待,きたいしなかった恐,おそるべき事,ことをなされた時,ときに下,くだられたので、山々,やまやまは震,ふるい動,うごいた。","tok":[["["],["3"],["]"],["あなた"],["は"],["、"],["われわれ"],["が"],["期待","きたい"],["しなかった"],["恐るべき","おそるべき"],["事","こと"],["を"],["なされた"],["時","とき"],["に"],["下られた","くだられた"],["ので"],["、"],["山々","やまやま"],["は"],["震い","ふるい"],["動いた","うごいた"],["。"]]},{"verse":3,"text":"[4]いにしえからこのかた、あなたのほか神,かみを待,まち望,のぞむ者,ものに、このような事,ことを行,おこなわれた神,かみを聞,きいたことはなく、耳,みみに入,いれたこともなく、目,めに見,みたこともない。","tok":[["["],["4"],["]"],["いにしえ"],["から"],["このかた"],["、"],["あなた"],["の"],["ほか"],["神","かみ"],["を"],["待ち望む","まちのぞむ"],["者","もの"],["に"],["、"],["この"],["よう"],["な"],["事","こと"],["を"],["行なわれた","おこなわれた"],["神","かみ"],["を"],["聞いた","きいた"],["こと"],["は"],["なく"],["、"],["耳","みみ"],["に"],["入れた","いれた"],["こと"],["も"],["なく"],["、"],["目","め"],["に"],["見た","みた"],["こと"],["も"],["ない"],["。"]]},{"verse":4,"text":"[5]あなたは喜,よろこんで義,ぎを行,おこない、あなたの道,みちにあって、あなたを記念,きねんする者,ものを迎,むかえられる。見,みよ、あなたは怒,いかられた、われわれは罪,つみを犯,おかした。われわれは久,ひさしく罪,つみのうちにあった。われわれは救,すくわれるであろうか。","tok":[["["],["5"],["]"],["あなた"],["は"],["喜こんで","よろこんで"],["義","ぎ"],["を"],["行ない","おこない"],["、"],["あなた"],["の"],["道","みち"],["に"],["あって"],["、"],["あなた"],["を"],["記念","きねん"],["する"],["者","もの"],["を"],["迎","むかえ"],["られる"],["。"],["見よ","みよ"],["、"],["あなた"],["は"],["怒","い"],["から"],["れた"],["、"],["われわれ"],["は"],["罪","つみ"],["を"],["犯した","おかした"],["。"],["われわれ"],["は"],["久く","ひさしく"],["罪","つみ"],["の"],["うち"],["に"],["あった"],["。"],["われわれ"],["は"],["救われるで","すくわれるで"],["あろう"],["か"],["。"]]},{"verse":5,"text":"[6]われわれはみな汚,けがれた人,ひとのようになり、われわれの正,ただしい行,おこないは、ことごとく汚,けがれた衣,ころものようである。われわれはみな木,この葉,はのように枯,かれ、われわれの不義,ふぎは風,かぜのようにわれわれを吹,ふき去,さる。","tok":[["["],["6"],["]"],["われわれ"],["は"],["みな"],["汚","け"],["がれ"],["た"],["人","ひと"],["の"],["よう"],["に"],["なり"],["、"],["われわれ"],["の"],["正い","ただしい"],["行ない","おこない"],["は"],["、"],["ことごとく"],["汚","け"],["がれ"],["た"],["衣","ころも"],["の"],["よう"],["で"],["ある"],["。"],["われわれ"],["は"],["みな"],["木の葉","このは"],["の"],["よう"],["に"],["枯","かれ"],["、"],["われわれ"],["の"],["不義","ふぎ"],["は"],["風","かぜ"],["の"],["よう"],["に"],["われわれ"],["を"],["吹","ふき"],["去る","さる"],["。"]]},{"verse":6,"text":"[7]あなたの名,なを呼,よぶ者,ものはなく、みずから励,はげんで、あなたによりすがる者,ものはない。あなたはみ顔,かおを隠,かくして、われわれを顧,かえりみられず、われわれをおのれの不義,ふぎの手,てに渡,わたされた。","tok":[["["],["7"],["]"],["あなた"],["の"],["名","な"],["を"],["呼ぶ","よぶ"],["者","もの"],["は"],["なく"],["、"],["みずから"],["励んで","はげんで"],["、"],["あなた"],["に"],["よりすがる"],["者","もの"],["は"],["ない"],["。"],["あなた"],["は"],["み顔","みかお"],["を"],["隠して","かくして"],["、"],["われわれ"],["を"],["顧られず","かえりみられず"],["、"],["われわれ"],["を"],["おのれ"],["の"],["不義","ふぎ"],["の"],["手","て"],["に"],["渡された","わたされた"],["。"]]},{"verse":7,"text":"[8]されど主,しゅよ、あなたはわれわれの父,ちちです。われわれは粘土,ねんどであって、あなたは陶器,とうき師,しです。われわれはみな、み手,てのわざです。","tok":[["["],["8"],["]"],["されど"],["主","しゅ"],["よ"],["、"],["あなた"],["は"],["われわれ"],["の"],["父","ちち"],["です"],["。"],["われわれ"],["は"],["粘土","ねんど"],["で"],["あって"],["、"],["あなた"],["は"],["陶器師","とうきし"],["です"],["。"],["われわれ"],["は"],["みな"],["、"],["み手","みて"],["の"],["わざ"],["です"],["。"]]},{"verse":8,"text":"[9]主,しゅよ、ひどくお怒,いかりにならぬように、いつまでも不義,ふぎをみこころにとめられぬように。どうぞ、われわれを顧,かえりみてください。われわれはみな、あなたの民,たみです。","tok":[["["],["9"],["]"],["主","しゅ"],["よ"],["、"],["ひどく"],["お怒り","おいかり"],["に"],["ならぬ"],["よう"],["に"],["、"],["いつ"],["まで"],["も"],["不義","ふぎ"],["を"],["みこころ"],["に"],["とめられぬ"],["よう"],["に"],["。"],["どうぞ"],["、"],["われわれ"],["を"],["顧て","かえりみて"],["ください"],["。"],["われわれ"],["は"],["みな"],["、"],["あなた"],["の"],["民","たみ"],["です"],["。"]]},{"verse":9,"text":"[10]あなたの聖,せいなる町々,まちまちは荒野,あらのとなり、シオンは荒野,あらのとなり、エルサレムは荒,あれすたれた。","tok":[["["],["10"],["]"],["あなた"],["の"],["聖","せい"],["なる"],["町々","まちまち"],["は"],["荒野","あら"],["の"],["と"],["なり"],["、"],["シオン"],["は"],["荒野","あら"],["の"],["と"],["なり"],["、"],["エルサレム"],["は"],["荒れ","あれ"],["すたれた"],["。"]]},{"verse":10,"text":"[11]われわれの先祖,せんぞがあなたをほめたたえた聖,せいなる麗,うるわしいわれわれの宮,みやは火,ひで焼,やかれ、われわれが慕,したった所,ところはことごとく荒,あれはてた。","tok":[["["],["11"],["]"],["われわれ"],["の"],["先祖","せんぞ"],["が"],["あなた"],["を"],["ほめたたえた"],["聖","せい"],["なる"],["麗わしい","うるわしい"],["われわれ"],["の"],["宮","みや"],["は"],["火","ひ"],["で"],["焼かれ","やかれ"],["、"],["われわれ"],["が"],["慕った","したった"],["所","ところ"],["は"],["ことごとく"],["荒れはてた","あれはてた"],["。"]]},{"verse":11,"text":"[12]主,しゅよ、これらの事,ことがあってもなお、あなたはみずからをおさえ、黙,もくして、われわれをいたく苦,くるしめられるのですか。","tok":[["["],["12"],["]"],["主","しゅ"],["よ"],["、"],["これ"],["ら"],["の"],["事","こと"],["が"],["あって"],["も"],["なお"],["、"],["あなた"],["は"],["みずから"],["を"],["おさえ"],["、"],["黙して","もくして"],["、"],["われわれ"],["を"],["いたく"],["苦しめられる","くるしめられる"],["の"],["です"],["か"],["。"]]}]
[{"verse":1,"text":"主,しゅはこう言,いわれる、「わたしがあなたがたの母,ははを去,さらせたその離縁,りえん状,じょうは、どこにあるか。わたしはどの債,さい主,しゅにあなたがたを売,うりわたしたか。見,みよ、あなたがたは、その不義,ふぎのために売,うられ、あなたがたの母,ははは、あなたがたのとがのために出,だされたのだ。","tok":[["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["「"],["わたし"],["が"],["あなた"],["がた"],["の"],["母","はは"],["を"],["去らせた","さらせた"],["その"],["離縁状","りえんじょう"],["は"],["、"],["どこ"],["に"],["ある"],["か"],["。"],["わたし"],["は"],["どの"],["債主","さいしゅ"],["に"],["あなた"],["がた"],["を"],["売","うり"],["わたした"],["か"],["。"],["見よ","みよ"],["、"],["あなた"],["がた"],["は"],["、"],["その"],["不義","ふぎ"],["の"],["ため"],["に"],["売られ","うられ"],["、"],["あなた"],["がた"],["の"],["母","はは"],["は"],["、"],["あなた"],["がた"],["の"],["とが"],["の"],["ため"],["に"],["出された","だされた"],["の"],["だ"],["。"]]},{"verse":2,"text":"わたしが来,きたとき、なぜひとりもいなかったか。わたしが呼,よんだとき、なぜひとりも答,こたえる者,ものがなかったか。わたしの手,てが短,みじかくて、あがなうことができないのか。わたしは救,すくう力,ちからを持,もたないのか。見,みよ、わたしが、しかると海,うみはかれ、川,かわは荒野,あらのとなり、その中,なかの魚,うおは水,みずがないために、かわき死,しんで悪臭,あくしゅうを放,はなつ。","tok":[["わたし"],["が"],["来た","きた"],["とき"],["、"],["なぜ"],["ひとり"],["も"],["いなかった"],["か"],["。"],["わたし"],["が"],["呼んだ","よんだ"],["とき"],["、"],["なぜ"],["ひとり"],["も"],["答","こたえ"],["る"],["者","もの"],["が"],["なかった"],["か"],["。"],["わたし"],["の"],["手","て"],["が"],["短かくて","みじかくて"],["、"],["あがなう"],["こと"],["が"],["できない"],["の"],["か"],["。"],["わたし"],["は"],["救う","すくう"],["力","ちから"],["を"],["持たない","もたない"],["の"],["か"],["。"],["見よ","みよ"],["、"],["わたし"],["が"],["、"],["しかる"],["と"],["海","うみ"],["は"],["かれ"],["、"],["川","かわ"],["は"],["荒野","あら"],["の"],["と"],["なり"],["、"],["その"],["中","なか"],["の"],["魚","うお"],["は"],["水","みず"],["が"],["ない"],["ため"],["に"],["、"],["かわき"],["死んで","しんで"],["悪臭","あくしゅう"],["を"],["放つ","はなつ"],["。"]]},{"verse":3,"text":"わたしは黒,くろい衣,ころもを天,てんに着,きせ、荒布,あらぬのをもってそのおおいとする」。","tok":[["わたし"],["は"],["黒い","くろい"],["衣","ころも"],["を"],["天","てん"],["に"],["着せ","きせ"],["、"],["荒布","あらぬ"],["の"],["を"],["もって"],["その"],["おおい"],["と"],["する"],["」"],["。"]]},{"verse":4,"text":"主,しゅなる神,かみは教,おしえをうけた者,ものの舌,したをわたしに与,あたえて、疲,つかれた者,ものを言葉,ことばをもって助,たすけることを知,しらせ、また朝,あさごとにさまし、わたしの耳,みみをさまして、教,おしえをうけた者,もののように聞,きかせられる。","tok":[["主","しゅ"],["なる"],["神","かみ"],["は"],["教え","おしえ"],["を"],["うけた"],["者","もの"],["の"],["舌","した"],["を"],["わたし"],["に"],["与","あたえ"],["て"],["、"],["疲れた","つかれた"],["者","もの"],["を"],["言葉","ことば"],["を"],["もって"],["助ける","たすける"],["こと"],["を"],["知らせ","しらせ"],["、"],["また"],["朝","あさ"],["ごと"],["に"],["さまし"],["、"],["わたし"],["の"],["耳","みみ"],["を"],["さまして"],["、"],["教え","おしえ"],["を"],["うけた"],["者","もの"],["の"],["よう"],["に"],["聞かせられる","きかせられる"],["。"]]},{"verse":5,"text":"主,しゅなる神,かみはわたしの耳,みみを開,ひらかれた。わたしは、そむくことをせず、退,しりぞくことをしなかった。","tok":[["主","しゅ"],["なる"],["神","かみ"],["は"],["わたし"],["の"],["耳","みみ"],["を"],["開らかれた","ひらかれた"],["。"],["わたし"],["は"],["、"],["そむく"],["こと"],["を"],["せず"],["、"],["退ぞく","しりぞく"],["こと"],["を"],["しなかった"],["。"]]},{"verse":6,"text":"わたしを打,うつ者,ものに、わたしの背,せをまかせ、わたしのひげを抜,ぬく者,ものに、わたしのほおをまかせ、恥,はじとつばきとを避,さけるために、顔,かおをかくさなかった。","tok":[["わたし"],["を"],["打つ","うつ"],["者","もの"],["に"],["、"],["わたし"],["の"],["背","せ"],["を"],["まかせ"],["、"],["わたし"],["の"],["ひげ"],["を"],["抜く","ぬく"],["者","もの"],["に"],["、"],["わたし"],["の"],["ほお"],["を"],["まかせ"],["、"],["恥","はじ"],["と"],["つばき"],["と"],["を"],["避ける","さける"],["ため"],["に"],["、"],["顔","かお"],["を"],["かくさなかった"],["。"]]},{"verse":7,"text":"しかし主,しゅなる神,かみはわたしを助,たすけられる。それゆえ、わたしは恥,はじることがなかった。それゆえ、わたしは顔,かおを火打石,ひうちいしのようにした。わたしは決,けっしてはずかしめられないことを知,しる。","tok":[["しかし"],["主","しゅ"],["なる"],["神","かみ"],["は"],["わたし"],["を"],["助けられる","たすけられる"],["。"],["それ"],["ゆえ"],["、"],["わたし"],["は"],["恥","はじ"],["る"],["こと"],["が"],["なかった"],["。"],["それ"],["ゆえ"],["、"],["わたし"],["は"],["顔","かお"],["を"],["火打石","ひうちいし"],["の"],["よう"],["に"],["した"],["。"],["わたし"],["は"],["決っして","けっして"],["はずかしめられない"],["こと"],["を"],["知る","しる"],["。"]]},{"verse":8,"text":"わたしを義,ぎとする者,ものが近,ちかくおられる。だれがわたしと争,あらそうだろうか、われわれは共,ともに立,たとう。わたしのあだはだれか、わたしの所,ところへ近,ちかくこさせよ。","tok":[["わたし"],["を"],["義","ぎ"],["と"],["する"],["者","もの"],["が"],["近く","ちかく"],["おられる"],["。"],["だれ"],["が"],["わたし"],["と"],["争うだろう","あらそうだろう"],["か"],["、"],["われわれ"],["は"],["共","とも"],["に"],["立とう","たとう"],["。"],["わたし"],["の"],["あだ"],["は"],["だれ"],["か"],["、"],["わたし"],["の"],["所","ところ"],["へ"],["近く","ちかく"],["こさせ"],["よ"],["。"]]},{"verse":9,"text":"見,みよ、主,しゅなる神,かみはわたしを助,たすけられる。だれがわたしを罪,つみに定,さだめるだろうか。見,みよ、彼,かれらは皆,みな衣,ころものようにふるび、しみのために食,くいつくされる。","tok":[["見よ","みよ"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["わたし"],["を"],["助けられる","たすけられる"],["。"],["だれ"],["が"],["わたし"],["を"],["罪","つみ"],["に"],["定めるだろう","さだめるだろう"],["か"],["。"],["見よ","みよ"],["、"],["彼","かれ"],["ら"],["は"],["皆","みな"],["衣","ころも"],["の"],["よう"],["に"],["ふるび"],["、"],["しみ"],["の"],["ため"],["に"],["食い","くい"],["つくされる"],["。"]]},{"verse":10,"text":"あなたがたのうち主,しゅを恐,おそれ、そのしもべの声,こえに聞,きき従,したがい、暗,くらい中,なかを歩,あるいて光,ひかりを得,えなくても、なお主,しゅの名,なを頼,たのみ、おのれの神,かみにたよる者,ものはだれか。","tok":[["あなた"],["がた"],["の"],["うち"],["主","しゅ"],["を"],["恐","おそれ"],["、"],["その"],["しもべ"],["の"],["声","こえ"],["に"],["聞","きき"],["従い","したがい"],["、"],["暗い","くらい"],["中","なか"],["を"],["歩いて","あるいて"],["光","ひかり"],["を"],["得なくて","えなくて"],["も"],["、"],["なお"],["主","しゅ"],["の"],["名","な"],["を"],["頼み","たのみ"],["、"],["おのれ"],["の"],["神","かみ"],["に"],["たよる"],["者","もの"],["は"],["だれ"],["か"],["。"]]},{"verse":11,"text":"見,みよ、火,ひを燃,もやし、たいまつをともす者,ものよ、皆,みなその火,ひの炎,ほのおの中,なかを歩,あゆめ、またその燃,もやした、たいまつの中,なかを歩,あゆめ。あなたがたは、これをわたしの手,てから受,うけて、苦,くるしみのうちに伏,ふし倒,たおれる。","tok":[["見よ","みよ"],["、"],["火","ひ"],["を"],["燃やし","もやし"],["、"],["たいまつ"],["を"],["ともす"],["者","もの"],["よ"],["、"],["皆","みな"],["その"],["火","ひ"],["の"],["炎","ほのお"],["の"],["中","なか"],["を"],["歩め","あゆめ"],["、"],["また"],["その"],["燃やした","もやした"],["、"],["たいまつ"],["の"],["中","なか"],["を"],["歩め","あゆめ"],["。"],["あなた"],["がた"],["は"],["、"],["これ"],["を"],["わたし"],["の"],["手","て"],["から"],["受けて","うけて"],["、"],["苦しみ","くるしみ"],["の"],["うち"],["に"],["伏し","ふし"],["倒れる","たおれる"],["。"]]}]
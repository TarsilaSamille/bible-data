[{"verse":1,"text":"見,みよ、主,しゅはこの地,ちをむなしくし、これを荒,あれすたれさせ、これをくつがえして、その民,たみを散,ちらされる。","tok":[["見よ","みよ"],["、"],["主","しゅ"],["は"],["この"],["地","ち"],["を"],["むなしく"],["し"],["、"],["これ"],["を"],["荒れ","あれ"],["すたれさせ"],["、"],["これ"],["を"],["くつがえして"],["、"],["その"],["民","たみ"],["を"],["散らされる","ちらされる"],["。"]]},{"verse":2,"text":"そして、その民,たみも祭司,さいしもひとしく、しもべも主人,しゅじんもひとしく、はしためも主婦,しゅふもひとしく、買,かう者,ものも売,うる者,ものもひとしく、貸,かす者,ものも借,かりる者,ものもひとしく、債権者,さいけんしゃも債務者,さいむしゃもひとしく、この事,ことにあう。","tok":[["そして"],["、"],["その"],["民","たみ"],["も"],["祭司","さいし"],["も"],["ひとしく"],["、"],["しもべ"],["も"],["主人","しゅじん"],["も"],["ひとしく"],["、"],["はし"],["ため"],["も"],["主婦","しゅふ"],["も"],["ひとしく"],["、"],["買う","かう"],["者","もの"],["も"],["売る","うる"],["者","もの"],["も"],["ひとしく"],["、"],["貸す","かす"],["者","もの"],["も"],["借りる","かりる"],["者","もの"],["も"],["ひとしく"],["、"],["債権者","さいけんしゃ"],["も"],["債務者","さいむしゃ"],["も"],["ひとしく"],["、"],["この"],["事","こと"],["に"],["あう"],["。"]]},{"verse":3,"text":"地,ちは全,まったくむなしくされ、全,まったくかすめられる。主,しゅがこの言葉,ことばを告,つげられたからである。","tok":[["地","ち"],["は"],["全く","まったく"],["むなしく"],["され"],["、"],["全く","まったく"],["かすめられる"],["。"],["主","しゅがこ"],["の"],["言葉","ことば"],["を"],["告げられた","つげられた"],["から"],["で"],["ある"],["。"]]},{"verse":4,"text":"地,ちは悲,かなしみ、衰,おとろえ、世,よはしおれ、衰,おとろえ、天,てんも地,ちと共,ともにしおれはてる。","tok":[["地","ち"],["は"],["悲しみ","かなしみ"],["、"],["衰え","おとろえ"],["、"],["世","よ"],["は"],["しおれ"],["、"],["衰え","おとろえ"],["、"],["天","てん"],["も"],["地","ち"],["と"],["共","とも"],["に"],["しおれ"],["はてる"],["。"]]},{"verse":5,"text":"地,ちはその住,すむ民,たみの下,したに汚,けがされた。これは彼,かれらが律法,りっぽうにそむき、定,さだめを犯,おかし、とこしえの契約,けいやくを破,やぶったからだ。","tok":[["地","ち"],["は"],["その"],["住む","すむ"],["民","たみ"],["の"],["下","した"],["に"],["汚","け"],["が"],["された"],["。"],["これ"],["は"],["彼","かれ"],["ら"],["が"],["律法","りっぽう"],["に"],["そむき"],["、"],["定め","さだめ"],["を"],["犯し","おかし"],["、"],["とこしえ"],["の"],["契約","けいやく"],["を"],["破った","やぶった"],["から"],["だ"],["。"]]},{"verse":6,"text":"それゆえ、のろいは地,ちをのみつくし、そこに住,すむ者,ものはその罪,つみに苦,くるしみ、また地,ちの民,たみは焼,やかれて、わずかの者,ものが残,のこされる。","tok":[["それ"],["ゆえ"],["、"],["のろい"],["は"],["地","ち"],["を"],["のみ"],["つくし"],["、"],["そこ"],["に"],["住む","すむ"],["者","もの"],["は"],["その"],["罪","つみ"],["に"],["苦しみ","くるしみ"],["、"],["また"],["地","ち"],["の"],["民","たみ"],["は"],["焼かれて","やかれて"],["、"],["わずか"],["の"],["者","もの"],["が"],["残される","のこされる"],["。"]]},{"verse":7,"text":"新,あたらしいぶどう酒,しゅは悲,かなしみ、ぶどうはしおれ、心,こころの楽,たのしい者,ものもみな嘆,なげく。","tok":[["新らしい","あたらしい"],["ぶどう酒","ぶどうしゅ"],["は"],["悲しみ","かなしみ"],["、"],["ぶどう"],["は"],["しおれ"],["、"],["心","こころ"],["の"],["楽い","たのしい"],["者","もの"],["も"],["みな"],["嘆く","なげく"],["。"]]},{"verse":8,"text":"鼓,つづみの音,おとは静,しずまり、喜,よろこぶ者,ものの騒,さわぎはやみ、琴,ことの音,ねもまた静,しずまった。","tok":[["鼓","つづみ"],["の"],["音","おと"],["は"],["静まり","しずまり"],["、"],["喜こぶ","よろこぶ"],["者","もの"],["の"],["騒","さわぎ"],["は"],["やみ"],["、"],["琴","こと"],["の"],["音","ね"],["も"],["また"],["静まった","しずまった"],["。"]]},{"verse":9,"text":"彼,かれらはもはや歌,うたをうたって酒,さけを飲,のまず、濃,こき酒,さけはこれを飲,のむ者,ものに苦,にがくなる。","tok":[["彼","かれ"],["ら"],["は"],["もはや"],["歌","うた"],["を"],["うたって"],["酒","さけ"],["を"],["飲まず","のまず"],["、"],["濃き","こき"],["酒","さけ"],["は"],["これ"],["を"],["飲む","のむ"],["者","もの"],["に"],["苦く","にがく"],["なる"],["。"]]},{"verse":10,"text":"混乱,こんらんせる町,まちは破,やぶられ、すべての家,いえは閉,とざされて、はいることができない。","tok":[["混乱","こんらん"],["せる"],["町","まち"],["は"],["破られ","やぶられ"],["、"],["すべて"],["の"],["家","いえ"],["は"],["閉ざされて","とざされて"],["、"],["はいる"],["こと"],["が"],["できない"],["。"]]},{"verse":11,"text":"ちまたには酒,さけの不足,ふそくのために叫,さけぶ声,こえがあり、すべての喜,よろこびは暗,くらくなり、地,ちの楽,たのしみは追,おいやられた。","tok":[["ちまた"],["に"],["は"],["酒","さけ"],["の"],["不足","ふそく"],["の"],["ため"],["に"],["叫けぶ","さけぶ"],["声","こえ"],["が"],["あり"],["、"],["すべて"],["の"],["喜こび","よろこび"],["は"],["暗く","くらく"],["なり"],["、"],["地","ち"],["の"],["楽み","たのしみ"],["は"],["追いやられた","おいやられた"],["。"]]},{"verse":12,"text":"町,まちには荒,あれすたれた所,ところのみ残,のこり、その門,もんもこわされて破,やぶれた。","tok":[["町","まち"],["に"],["は"],["荒れ","あれ"],["すたれた"],["所","ところ"],["のみ"],["残り","のこり"],["、"],["その"],["門","もん"],["も"],["こわされて"],["破れた","やぶれた"],["。"]]},{"verse":13,"text":"地,ちのうちで、もろもろの民,たみのなかで残,のこるものは、オリブの木,きの打,うたれた後,のちの実,みのように、ぶどうの収穫,しゅうかくの終,おわった後,のちにその採,とり残,のこりを集,あつめるときのようになる。","tok":[["地","ち"],["の"],["うち"],["で"],["、"],["もろもろ"],["の"],["民","たみ"],["の"],["なか"],["で"],["残る","のこる"],["もの"],["は"],["、"],["オリブ"],["の"],["木","き"],["の"],["打たれた","うたれた"],["後","のち"],["の"],["実","み"],["の"],["よう"],["に"],["、"],["ぶどう"],["の"],["収穫","しゅうかく"],["の"],["終わった","おわった"],["後","のち"],["に"],["その"],["採り","とり"],["残り","のこり"],["を"],["集める","あつめる"],["とき"],["の"],["よう"],["に"],["なる"],["。"]]},{"verse":14,"text":"彼,かれらは声,こえをあげて喜,よろこび歌,うたう。主,しゅの威光,いこうのゆえに、西,にしから喜,よろこび呼,よばわる。","tok":[["彼","かれ"],["ら"],["は"],["声","こえ"],["を"],["あげて"],["喜こび","よろこび"],["歌う","うたう"],["。"],["主","しゅ"],["の"],["威光","いこう"],["の"],["ゆえ"],["に"],["、"],["西","にし"],["から"],["喜こび","よろこび"],["呼ばわる","よばわる"],["。"]]},{"verse":15,"text":"それゆえ、東,ひがしで主,しゅをあがめ、海沿,うみぞいの国々,くにぐにでイスラエルの神,かみ、主,しゅの名,なをあがめよ。","tok":[["それ"],["ゆえ"],["、"],["東","ひがし"],["で"],["主","しゅ"],["を"],["あがめ"],["、"],["海沿い","うみぞい"],["の"],["国々","くにぐに"],["で"],["イスラエル"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["名","な"],["を"],["あがめよ"],["。"]]},{"verse":16,"text":"われわれは地,ちの果,はてから、さんびの歌,うたを聞,きいた、「栄光,えいこうは正,ただしい者,ものにある」と。しかし、わたしは言,いう、「わたしはやせ衰,おとろえる、わたしはやせ衰,おとろえる、わたしはわざわいだ。欺,あざむく者,ものはあざむき、欺,あざむく者,ものは、はなはだしくあざむく」。","tok":[["われわれ"],["は"],["地","ち"],["の"],["果て","はて"],["から"],["、"],["さん"],["び"],["の"],["歌","うた"],["を"],["聞いた","きいた"],["、"],["「"],["栄光","えいこう"],["は"],["正い","ただしい"],["者","もの"],["に"],["ある"],["」"],["と"],["。"],["しかし"],["、"],["わたし"],["は"],["言う","いう"],["、"],["「"],["わたし"],["は"],["やせ衰える","やせおとろえる"],["、"],["わたし"],["は"],["やせ衰える","やせおとろえる"],["、"],["わたし"],["は"],["わざわい"],["だ"],["。"],["欺く","あざむく"],["者","もの"],["は"],["あざむき"],["、"],["欺く","あざむく"],["者","もの"],["は"],["、"],["はなはだしく"],["あざむく"],["」"],["。"]]},{"verse":17,"text":"地,ちに住,すむ者,ものよ、恐,おそれと、落,おとし穴,あなと、わなとはあなたの上,うえにある。","tok":[["地","ち"],["に"],["住む","すむ"],["者","もの"],["よ"],["、"],["恐","おそれ"],["と"],["、"],["落とし穴","おとしあな"],["と"],["、"],["わな"],["と"],["は"],["あなた"],["の"],["上","うえ"],["に"],["ある"],["。"]]},{"verse":18,"text":"恐,おそれの声,こえをのがれる者,ものは落,おとし穴,あなに陥,おちいり、落,おとし穴,あなから出,でる者,ものはわなに捕,とらえられる。天,てんの窓,まどは開,ひらけ、地,ちの基,もといが震,ふるい動,うごくからである。","tok":[["恐","おそれ"],["の"],["声","こえ"],["を"],["のがれる"],["者","もの"],["は"],["落とし穴","おとしあな"],["に"],["陥ち","おち"],["いり"],["、"],["落とし穴","おとしあな"],["から"],["出る","でる"],["者","もの"],["は"],["わな"],["に"],["捕らえられる","とらえられる"],["。"],["天","てん"],["の"],["窓","まど"],["は"],["開らけ","ひらけ"],["、"],["地","ち"],["の"],["基い","もとい"],["が"],["震い","ふるい"],["動く","うごく"],["から"],["で"],["ある"],["。"]]},{"verse":19,"text":"地,ちは全,まったく砕,くだけ、地,ちは裂,さけ、地,ちは激,はげしく震,ふるい、","tok":[["地","ち"],["は"],["全く","まったく"],["砕け","くだけ"],["、"],["地","ち"],["は"],["裂け","さけ"],["、"],["地","ち"],["は"],["激しく","はげしく"],["震い","ふるい"],["、"]]},{"verse":20,"text":"地,ちは酔,よいどれのようによろめき、仮,かり小屋,こやのようにゆり動,うごく。そのとがはその上,うえに重,おもく、ついに倒,たおれて再,ふたたび起,おきあがることはない。","tok":[["地","ち"],["は"],["酔","よい"],["どれ"],["の"],["よう"],["に"],["よろめき"],["、"],["仮","かり"],["小屋","こや"],["の"],["よう"],["に"],["ゆり"],["動く","うごく"],["。"],["その"],["とが"],["は"],["その"],["上","うえ"],["に"],["重く","おもく"],["、"],["ついに"],["倒れて","たおれて"],["再び","ふたたび"],["起きあがる","おきあがる"],["こと"],["は"],["ない"],["。"]]},{"verse":21,"text":"その日,ひ、主,しゅは天,てんにおいて、天,てんの軍勢,ぐんぜいを罰,ばっし、地,ちの上,うえで、地,ちのもろもろの王,おうを罰,ばっせられる。","tok":[["その"],["日","ひ"],["、"],["主","しゅ"],["は"],["天","てん"],["に"],["おいて"],["、"],["天","てん"],["の"],["軍勢","ぐんぜい"],["を"],["罰し","ばっし"],["、"],["地","ち"],["の"],["上","うえ"],["で"],["、"],["地","ち"],["の"],["もろもろ"],["の"],["王","おう"],["を"],["罰せられる","ばっせられる"],["。"]]},{"verse":22,"text":"彼,かれらは囚人,しゅうじんが土,つちろうの中,なかに集,あつめられるように集,あつめられて、獄屋,ごくやの中,なかに閉,とざされ、多,おおくの日,ひを経,へて後,のち、罰,ばっせられる。","tok":[["彼","かれ"],["ら"],["は"],["囚人","しゅうじん"],["が"],["土","つち"],["ろう"],["の"],["中","なか"],["に"],["集められる","あつめられる"],["よう"],["に"],["集められて","あつめられて"],["、"],["獄屋","ごくや"],["の"],["中","なか"],["に"],["閉ざされ","とざされ"],["、"],["多く","おおく"],["の"],["日","ひ"],["を"],["経て","へて"],["後","の"],["ち"],["、"],["罰せられる","ばっせられる"],["。"]]},{"verse":23,"text":"こうして万軍,ばんぐんの主,しゅがシオンの山,やまおよびエルサレムで統,すべ治,おさめ、かつその長老,ちょうろうたちの前,まえにその栄光,えいこうをあらわされるので、月,つきはあわて、日,ひは恥,はじる。","tok":[["こう"],["して"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["が"],["シオン"],["の"],["山","やま"],["および"],["エルサレム"],["で"],["統べ治め","すべおさめ"],["、"],["かつ"],["その"],["長老","ちょうろう"],["たち"],["の"],["前","まえ"],["に"],["その"],["栄光","えいこう"],["を"],["あらわされる"],["ので"],["、"],["月","つき"],["は"],["あわて"],["、"],["日","ひ"],["は"],["恥","はじ"],["る"],["。"]]}]
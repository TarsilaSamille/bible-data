[{"verse":1,"text":"ヒゼキヤ王,おうの第,だい十四年,ねんに、アッスリヤの王,おうセナケリブが上,のぼってきて、ユダのすべての堅固,けんごな町々,まちまちを攻,せめ取,とった。","tok":[["ヒゼキヤ"],["王","おう"],["の"],["第","だい"],["十四","じゅうよん"],["年","ねん"],["に"],["、"],["アッスリヤ"],["の"],["王","おう"],["セナケリブ"],["が"],["上って","のぼって"],["きて"],["、"],["ユダ"],["の"],["すべて"],["の"],["堅固","けんご"],["な"],["町々","まちまち"],["を"],["攻め取った","せめとった"],["。"]]},{"verse":2,"text":"アッスリヤの王,おうはラキシからラブシャケをエルサレムにつかわし、大軍,たいぐんを率,ひきいてヒゼキヤ王,おうのもとへ行,いかせた。ラブシャケは布,ぬのさらしの野,のへ行,いく大路,おおじに沿,そう、上,うえの池,いけの水道,すいどうのかたわらに立,たった。","tok":[["アッスリヤ"],["の"],["王","おう"],["は"],["ラキシ"],["から"],["ラブシャケ"],["を"],["エルサレム"],["に"],["つかわし"],["、"],["大軍","たいぐん"],["を"],["率いて","ひきいて"],["ヒゼキヤ"],["王","おう"],["の"],["もと"],["へ"],["行かせた","いかせた"],["。"],["ラブシャケ"],["は"],["布","ぬの"],["さらし"],["の"],["野","の"],["へ"],["行く","いく"],["大路","おおじ"],["に"],["沿う","そう"],["、"],["上","うえ"],["の"],["池","いけ"],["の"],["水道","すいどう"],["の"],["かたわら"],["に"],["立った","たった"],["。"]]},{"verse":3,"text":"この時,ときヒルキヤの子,こである宮内卿,くないきょうエリアキム、書記官,しょきかんセブナおよびアサフの子,こである史官,しかんヨアが彼,かれの所,ところに出,でてきた。","tok":[["この"],["時","とき"],["ヒルキヤ"],["の"],["子","こ"],["で"],["ある"],["宮内","くない"],["卿","きょう"],["エリアキム"],["、"],["書記官","しょきかん"],["セブナ"],["および"],["アサフ"],["の"],["子","こ"],["で"],["ある"],["史官","しかん"],["ヨア"],["が"],["彼","かれ"],["の"],["所","ところ"],["に"],["出て","でて"],["きた"],["。"]]},{"verse":4,"text":"ラブシャケは彼,かれらに言,いった、「ヒゼキヤに言,いいなさい、『大王,だいおうアッスリヤの王,おうはこう仰,おおせられる、あなたが頼,たのみとする者,ものは何,なにか。","tok":[["ラブシャケ"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["ヒゼキヤ"],["に"],["言い","いい"],["なさい"],["、"],["『"],["大王","だいおう"],["アッスリヤ"],["の"],["王","おう"],["は"],["こう"],["仰せられる","おおせられる"],["、"],["あなた"],["が"],["頼み","たのみ"],["と"],["する"],["者","もの"],["は"],["何に","なに"],["か"],["。"]]},{"verse":5,"text":"口先,くちさきだけの言葉,ことばが戦争,せんそうをする計略,けいりゃくと力,ちからだと考,かんがえるのか。あなたは今,いまだれを頼,たよんで、わたしにそむいたのか。","tok":[["口先","くちさき"],["だけ"],["の"],["言葉","ことば"],["が"],["戦争","せんそう"],["を"],["する"],["計略","けいりゃく"],["と"],["力","ちから"],["だ"],["と"],["考","かんがえ"],["る"],["の"],["か"],["。"],["あなた"],["は"],["今","いま"],["だれ"],["を"],["頼","た"],["よ"],["んで"],["、"],["わたし"],["に"],["そむいた"],["の"],["か"],["。"]]},{"verse":6,"text":"見,みよ、あなたはかの折,おれかけている葦,あしのつえエジプトを頼,たのみとしているが、それは人,ひとが寄,よりかかるとき、その人,ひとの手,てを刺,さし通,とおす。エジプトの王,おうパロはすべて寄,より頼,たのむ者,ものにそのようにするのだ。","tok":[["見よ","みよ"],["、"],["あなた"],["は"],["かの"],["折れ","おれ"],["かけて"],["いる"],["葦","あし"],["の"],["つえ"],["エジプト"],["を"],["頼み","たのみ"],["として"],["いる"],["が"],["、"],["それ"],["は"],["人","ひと"],["が"],["寄りかかる","よりかかる"],["とき"],["、"],["その"],["人","ひと"],["の"],["手","て"],["を"],["刺通す","さしとおす"],["。"],["エジプト"],["の"],["王","おう"],["パロ"],["は"],["すべて"],["寄り","より"],["頼む","たのむ"],["者","もの"],["に"],["その"],["よう"],["に"],["する"],["の"],["だ"],["。"]]},{"verse":7,"text":"しかし、あなたがもし「われわれはわれわれの神,かみ、主,しゅを頼,たのむ」とわたしに言,いうならば、ヒゼキヤがユダとエルサレムに告,つげて、「あなたがたはこの祭壇,さいだんの前,まえで礼拝,れいはいしなければならない」と言,いって除,のぞいたのは、その神,かみの高,たかき所,ところと祭壇,さいだんではなかったのか。","tok":[["しかし"],["、"],["あなた"],["が"],["もし"],["「"],["われわれ"],["は"],["われわれ"],["の"],["神","かみ"],["、"],["主","しゅ"],["を"],["頼む","たのむ"],["」"],["と"],["わたし"],["に"],["言うならば","いうならば"],["、"],["ヒゼキヤ"],["が"],["ユダ"],["と"],["エルサレム"],["に"],["告","つげ"],["て"],["、"],["「"],["あなた"],["がた"],["は"],["この"],["祭壇","さいだん"],["の"],["前","まえ"],["で"],["礼拝","れいはい"],["しなければ"],["ならない"],["」"],["と"],["言って","いって"],["除いた","のぞいた"],["の"],["は"],["、"],["その"],["神","かみ"],["の"],["高き","たかき"],["所","ところ"],["と"],["祭壇","さいだん"],["で"],["は"],["なかった"],["の"],["か"],["。"]]},{"verse":8,"text":"さあ、今,いまわたしの主君,しゅくんアッスリヤの王,おうとかけをせよ。もしあなたの方,ほうに乗,のる人,ひとがあるならば、わたしは馬,うま二千頭,とうを与,あたえよう。","tok":[["さあ"],["、"],["今","いま"],["わたし"],["の"],["主君","しゅくん"],["アッスリヤ"],["の"],["王","おう"],["と"],["かけ"],["を"],["せよ"],["。"],["もし"],["あなた"],["の"],["方","ほう"],["に"],["乗る","のる"],["人","ひと"],["が"],["あるならば"],["、"],["わたし"],["は"],["馬","うま"],["二千頭","とう"],["を"],["与","あたえ"],["よう"],["。"]]},{"verse":9,"text":"あなたはエジプトを頼,たのみ、戦車,せんしゃと騎兵,きへいを請,こい求,もとめているが、わたしの主君,しゅくんの家来,けらいのうちの最,もっとも小,ちいさい一隊長,たいちょうでさえ、どうして撃退,げきたいすることができようか。","tok":[["あなた"],["は"],["エジプト"],["を"],["頼み","たのみ"],["、"],["戦車","せんしゃ"],["と"],["騎兵","きへい"],["を"],["請い求めて","こいもとめて"],["いる"],["が"],["、"],["わたし"],["の"],["主君","しゅくん"],["の"],["家来","けらい"],["の"],["うち"],["の"],["最も","もっとも"],["小さい","ちいさい"],["一","いち"],["隊長","たいちょう"],["いちょう"],["で"],["さえ"],["、"],["どう"],["して"],["撃退","げきたい"],["する"],["こと"],["が"],["できよう"],["か"],["。"]]},{"verse":10,"text":"わたしがこの国,くにを滅,ほろぼすために上,のぼってきたのは、主,しゅの許,ゆるしなしでしたことであろうか。主,しゅはわたしに、この国,くにへ攻,せめ上,のぼって、これを滅,ほろぼせと言,いわれたのだ』」。","tok":[["わたし"],["が"],["この"],["国","くに"],["を"],["滅ぼす","ほろぼす"],["ため"],["に"],["上って","のぼって"],["きた"],["の"],["は"],["、"],["主","しゅ"],["の"],["許し","ゆるし"],["なし"],["でした"],["こと"],["で"],["あろう"],["か"],["。"],["主","しゅ"],["は"],["わたし"],["に"],["、"],["この"],["国","くに"],["へ"],["攻め上って","せめのぼって"],["、"],["これ"],["を"],["滅ぼせ","ほろぼせ"],["と"],["言われた","いわれた"],["の"],["だ"],["』"],["」"],["。"]]},{"verse":11,"text":"その時,とき、エリアキム、セブナおよびヨアはラブシャケに言,いった、「どうぞ、アラム語,ごでしもべたちに話,はなしてください。わたしたちはそれがわかるからです。城壁,じょうへきの上,うえにいる民,たみの聞,きいているところで、わたしたちにユダヤの言葉,ことばで話,はなさないでください」。","tok":[["その"],["時","とき"],["、"],["エリアキム"],["、"],["セブナ"],["および"],["ヨア"],["は"],["ラブシャケ"],["に"],["言った","いった"],["、"],["「"],["どうぞ"],["、"],["アラム"],["語","ご"],["で"],["しもべ"],["たち"],["に"],["話","はなし"],["て"],["ください"],["。"],["わたしたち"],["は"],["それ"],["が"],["わかる"],["から"],["です"],["。"],["城壁","じょうへき"],["の"],["上","うえ"],["に"],["いる"],["民","たみ"],["の"],["聞いて","きいて"],["いる"],["ところ"],["で"],["、"],["わたしたち"],["に"],["ユダヤ"],["の"],["言葉","ことば"],["で"],["話さないで","はなさないで"],["ください"],["」"],["。"]]},{"verse":12,"text":"しかしラブシャケは言,いった、「わたしの主君,しゅくんは、あなたの主君,しゅくんとあなたにだけでなく、城壁,じょうへきの上,うえに座,ざしている人々,ひとびとにも、この言葉,ことばを告,つげるために、わたしをつかわされたのではないか。彼,かれらをも、あなたがたと共,ともに自分,じぶんの糞尿,ふんにょうを食,くい飲,のみするに至,いたらせるためではないか」。","tok":[["しかし"],["ラブシャケ"],["は"],["言った","いった"],["、"],["「"],["わたし"],["の"],["主君","しゅくん"],["は"],["、"],["あなた"],["の"],["主君","しゅくん"],["と"],["あなた"],["に"],["だけ"],["で"],["なく"],["、"],["城壁","じょうへき"],["の"],["上","うえ"],["に"],["座して","ざして"],["いる"],["人々","ひとびと"],["に"],["も"],["、"],["この"],["言葉","ことば"],["を"],["告げる","つげる"],["ため"],["に"],["、"],["わたし"],["を"],["つかわされた"],["ので"],["は"],["ない"],["か"],["。"],["彼","かれ"],["ら"],["を"],["も"],["、"],["あなた"],["がた"],["と"],["共","とも"],["に"],["自分","じぶん"],["の"],["糞尿","ふんにょう"],["を"],["食い","くい"],["飲み","のみ"],["する"],["に"],["至らせる","いたらせる"],["ため"],["で"],["は"],["ない"],["か"],["」"],["。"]]},{"verse":13,"text":"そしてラブシャケは立,たちあがり、ユダヤの言葉,ことばで大声,おおごえに呼,よばわって言,いった、「大王,だいおう、アッスリヤの王,おうの言葉,ことばを聞,きけ。","tok":[["そして"],["ラブシャケ"],["は"],["立ちあがり","たちあがり"],["、"],["ユダヤ"],["の"],["言葉","ことば"],["で"],["大声","おおごえ"],["に"],["呼ばわって","よばわって"],["言った","いった"],["、"],["「"],["大王","だいおう"],["、"],["アッスリヤ"],["の"],["王","おう"],["の"],["言葉","ことば"],["を"],["聞け","きけ"],["。"]]},{"verse":14,"text":"王,おうはこう仰,おおせられる、『あなたがたはヒゼキヤに欺,あざむかれてはならない。彼,かれはあなたがたを救,すくい出,だすことはできない。","tok":[["王","おう"],["は"],["こう"],["仰せられる","おおせられる"],["、"],["『"],["あなた"],["がた"],["は"],["ヒゼキヤ"],["に"],["欺かれて","あざむかれて"],["は"],["ならない"],["。"],["彼","かれ"],["は"],["あなた"],["がた"],["を"],["救い出す","すくいだす"],["こと"],["は"],["できない"],["。"]]},{"verse":15,"text":"ヒゼキヤが、主,しゅは必,かならずわれわれを救,すくい出,だされる。この町,まちはアッスリヤの王,おうの手,てに陥,おちいることはない、と言,いっても、あなたがたは主,しゅを頼,たのみとしてはならない』。","tok":[["ヒゼキヤ"],["が"],["、"],["主","しゅ"],["は"],["必","かならず"],["われわれ"],["を"],["救い出される","すくいだされる"],["。"],["この"],["町","まち"],["は"],["アッスリヤ"],["の"],["王","おう"],["の"],["手","て"],["に"],["陥ち","おち"],["いる"],["こと"],["は"],["ない"],["、"],["と"],["言って","いって"],["も"],["、"],["あなた"],["がた"],["は"],["主","しゅ"],["を"],["頼み","たのみ"],["として"],["は"],["ならない"],["』"],["。"]]},{"verse":16,"text":"あなたがたはヒゼキヤの言葉,ことばを聞,きいてはならない。アッスリヤの王,おうはこう仰,おおせられる、『あなたがたは、わたしと和,わぼくして、わたしに降服,こうふくせよ。そうすれば、あなたがたはめいめい自分,じぶんのぶどうの実,みを食,たべ、めいめい自分,じぶんのいちじくの実,みを食,たべ、めいめい自分,じぶんの井戸,いどの水,みずを飲,のむことができる。","tok":[["あなた"],["がた"],["は"],["ヒゼキヤ"],["の"],["言葉","ことば"],["を"],["聞いて","きいて"],["は"],["ならない"],["。"],["アッスリヤ"],["の"],["王","おう"],["は"],["こう"],["仰せられる","おおせられる"],["、"],["『"],["あなた"],["がた"],["は"],["、"],["わたし"],["と"],["和","わ"],["ぼく"],["して"],["、"],["わたし"],["に"],["降服","こうふく"],["せよ"],["。"],["そう"],["すれば"],["、"],["あなた"],["がた"],["は"],["めいめい"],["自分","じぶん"],["の"],["ぶどう"],["の"],["実","み"],["を"],["食べ","たべ"],["、"],["めいめい"],["自分","じぶん"],["の"],["いちじく"],["の"],["実","み"],["を"],["食べ","たべ"],["、"],["めいめい"],["自分","じぶん"],["の"],["井戸","いど"],["の"],["水","みず"],["を"],["飲む","のむ"],["こと"],["が"],["できる"],["。"]]},{"verse":17,"text":"やがて、わたしが来,きて、あなたがたを一つの国,くにへ連,つれて行,いく。それは、あなたがたの国,くにのように穀物,こくもつとぶどう酒,しゅの多,おおい地,ち、パンとぶどう畑,はたけの多,おおい地,ちだ。","tok":[["やがて"],["、"],["わたし"],["が"],["来て","きて"],["、"],["あなた"],["がた"],["を"],["一","ひと"],["つ"],["の"],["国","くに"],["へ"],["連れて","つれて"],["行く","いく"],["。"],["それ"],["は"],["、"],["あなた"],["がた"],["の"],["国","くに"],["の"],["よう"],["に"],["穀物","こくもつ"],["と"],["ぶどう酒","ぶどうしゅ"],["の"],["多い","おおい"],["地","ち"],["、"],["パン"],["と"],["ぶどう"],["畑","はたけ"],["の"],["多い","おおい"],["地","ち"],["だ"],["。"]]},{"verse":18,"text":"ヒゼキヤが、主,しゅはわれわれを救,すくわれる、と言,いって、あなたがたを惑,まどわすことのないように気,きをつけよ。もろもろの国,くにの神々,かみがみのうち、どの神,かみがその国,くにをアッスリヤの王,おうの手,てから救,すくったか。","tok":[["ヒゼキヤ"],["が"],["、"],["主","しゅ"],["は"],["われわれ"],["を"],["救われる","すくわれる"],["、"],["と"],["言って","いって"],["、"],["あなた"],["がた"],["を"],["惑わす","まどわす"],["こと"],["の"],["ない"],["よう"],["に"],["気","き"],["を"],["つけよ"],["。"],["もろもろ"],["の"],["国","くに"],["の"],["神々","かみがみ"],["の"],["うち"],["、"],["どの"],["神","かみ"],["が"],["その"],["国","くに"],["を"],["アッスリヤ"],["の"],["王","おう"],["の"],["手","て"],["から"],["救った","すくった"],["か"],["。"]]},{"verse":19,"text":"ハマテやアルパデの神々,かみがみはどこにいるか。セパルワイムの神々,かみがみはどこにいるか。彼,かれらはサマリヤをわたしの手,てから救,すくい出,だしたか。","tok":[["ハマテ"],["や"],["アルパデ"],["の"],["神々","かみがみ"],["は"],["どこ"],["に"],["いる"],["か"],["。"],["セパルワイム"],["の"],["神々","かみがみ"],["は"],["どこ"],["に"],["いる"],["か"],["。"],["彼","かれ"],["ら"],["は"],["サマリヤ"],["を"],["わたし"],["の"],["手","て"],["から"],["救い出した","すくいだした"],["か"],["。"]]},{"verse":20,"text":"これらの国々,くにぐにのすべての神々,かみがみのうちに、だれかその国,くにをわたしの手,てから救,すくい出,だした者,ものがあるか。主,しゅがどうしてエルサレムをわたしの手,てから救,すくい出,だすことができよう』」。","tok":[["これ"],["ら"],["の"],["国々","くにぐに"],["の"],["すべて"],["の"],["神々","かみがみ"],["の"],["うち"],["に"],["、"],["だれ"],["か"],["その"],["国","くに"],["を"],["わたし"],["の"],["手","て"],["から"],["救い出した","すくいだした"],["者","もの"],["が"],["ある"],["か"],["。"],["主","しゅ"],["が"],["どう"],["して"],["エルサレム"],["を"],["わたし"],["の"],["手","て"],["から"],["救い出す","すくいだす"],["こと"],["が"],["できよう"],["』"],["」"],["。"]]},{"verse":21,"text":"しかし民,たみは黙,だまってひと言,ことも答,こたえなかった。王,おうが命,めいじて、「彼,かれに答,こたえてはならない」と言,いっておいたからである。","tok":[["しかし"],["民","たみ"],["は"],["黙って","だまって"],["ひと言","ひとこと"],["も"],["答","こたえ"],["なかった"],["。"],["王","おう"],["が"],["命じて","めいじて"],["、"],["「"],["彼","かれ"],["に"],["答","こたえ"],["ては"],["ならない"],["」"],["と"],["言って","いって"],["おいた"],["から"],["で"],["ある"],["。"]]},{"verse":22,"text":"その時,ときヒルキヤの子,こである宮内卿,くないきょうエリアキム、書記官,しょきかんセブナおよびアサフの子,こである史官,しかんヨアは衣,ころもを裂,さき、ヒゼキヤのもとに来,きて、ラブシャケの言葉,ことばを彼,かれに告,つげた。","tok":[["その"],["時","とき"],["ヒルキヤ"],["の"],["子","こ"],["で"],["ある"],["宮内","くない"],["卿","きょう"],["エリアキム"],["、"],["書記官","しょきかん"],["セブナ"],["および"],["アサフ"],["の"],["子","こ"],["で"],["ある"],["史官","しかん"],["ヨア"],["は"],["衣","ころも"],["を"],["裂き","さき"],["、"],["ヒゼキヤ"],["の"],["もと"],["に"],["来て","きて"],["、"],["ラブシャケ"],["の"],["言葉","ことば"],["を"],["彼","かれ"],["に"],["告","つげ"],["た"],["。"]]}]
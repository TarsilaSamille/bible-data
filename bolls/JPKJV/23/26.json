[{"verse":1,"text":"その日,ひユダの国,くにで、この歌,うたをうたう、「われわれは堅固,けんごな町,まちをもつ。主,しゅは救,すくいをその石,いしがきとし、またとりでとされる。","tok":[["その"],["日","ひ"],["ユダ"],["の"],["国","くに"],["で"],["、"],["この"],["歌","うた"],["を"],["うたう"],["、"],["「"],["われわれ"],["は"],["堅固","けんご"],["な"],["町","まち"],["を"],["もつ"],["。"],["主","しゅ"],["は"],["救い","すくい"],["を"],["その"],["石がき","いしがき"],["と"],["し"],["、"],["また"],["とりで"],["と"],["される"],["。"]]},{"verse":2,"text":"門,もんを開,ひらいて、信仰,しんこうを守,まもる正,ただしい国民,こくみんを入,いれよ。","tok":[["門","もん"],["を"],["開らいて","ひらいて"],["、"],["信仰","しんこう"],["を"],["守","まもる"],["正い","ただしい"],["国民","こくみん"],["を"],["入れよ","いれよ"],["。"]]},{"verse":3,"text":"あなたは全,まったき平安,へいあんをもってこころざしの堅固,けんごなものを守,まもられる。彼,かれはあなたに信頼,しんらいしているからである。","tok":[["あなた"],["は"],["全","ま"],["っ"],["たき"],["平安","へいあん"],["を"],["もって"],["こころざし"],["の"],["堅固","けんご"],["な"],["もの"],["を"],["守られる","まもられる"],["。"],["彼","かれ"],["は"],["あなた"],["に"],["信頼","しんらい"],["して"],["いる"],["から"],["で"],["ある"],["。"]]},{"verse":4,"text":"とこしえに主,しゅに信頼,しんらいせよ、主,しゅなる神,かみはとこしえの岩,いわだからである。","tok":[["とこしえ"],["に"],["主に","しゅに"],["信頼","しんらい"],["せよ"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["とこしえ"],["の"],["岩","いわ"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":5,"text":"主,しゅは高,たかき所,ところ、そびえたつ町,まちに住,すむ者,ものをひきおろし、これを伏,ふさせ、これを地,ちに伏,ふさせて、ちりにかえされる。","tok":[["主","しゅ"],["は"],["高き","たかき"],["所","ところ"],["、"],["そびえたつ"],["町","まち"],["に"],["住む","すむ"],["者","もの"],["を"],["ひきおろし"],["、"],["これ"],["を"],["伏させ","ふさせ"],["、"],["これ"],["を"],["地","ち"],["に"],["伏させて","ふさせて"],["、"],["ちり"],["に"],["かえされる"],["。"]]},{"verse":6,"text":"こうして足,あしで踏,ふまれ、貧,まずしい者,ものの足,あしで踏,ふまれ、乏,とぼしい者,ものはその上,うえを歩,あゆむ」。","tok":[["こう"],["して"],["足","あし"],["で"],["踏まれ","ふまれ"],["、"],["貧しい","まずしい"],["者","もの"],["の"],["足","あし"],["で"],["踏まれ","ふまれ"],["、"],["乏い","とぼしい"],["者","もの"],["は"],["その"],["上","うえ"],["を"],["歩む","あゆむ"],["」"],["。"]]},{"verse":7,"text":"正,ただしい者,ものの道,みちは平,たいらである。あなたは正,ただしい者,ものの道,みちをなめらかにされる。","tok":[["正い","ただしい"],["者","もの"],["の"],["道","みち"],["は"],["平","たいら"],["で"],["ある"],["。"],["あなた"],["は"],["正い","ただしい"],["者","もの"],["の"],["道","みち"],["を"],["なめらか"],["に"],["される"],["。"]]},{"verse":8,"text":"主,しゅよ、あなたがさばきをなさる道,みちで、われわれはあなたを待,まち望,のぞむ。われわれの魂,たましいの慕,したうものは、あなたの記念,きねんの名,なである。","tok":[["主","しゅ"],["よ"],["、"],["あなた"],["が"],["さばき"],["を"],["なさる"],["道","みち"],["で"],["、"],["われわれ"],["は"],["あなた"],["を"],["待ち望む","まちのぞむ"],["。"],["われわれ"],["の"],["魂","たましい"],["の"],["慕う","したう"],["もの"],["は"],["、"],["あなた"],["の"],["記念","きねん"],["の"],["名","な"],["で"],["ある"],["。"]]},{"verse":9,"text":"わが魂,たましいは夜,よるあなたを慕,したい、わがうちなる霊,れいは、せつにあなたを求,もとめる。あなたのさばきが地,ちに行,おこなわれるとき、世,よに住,すむ者,ものは正義,せいぎを学,まなぶからである。","tok":[["わが"],["魂","たましい"],["は"],["夜","よる"],["あなた"],["を"],["慕い","したい"],["、"],["わが"],["うち"],["なる"],["霊","れい"],["は"],["、"],["せつ"],["に"],["あなた"],["を"],["求める","もとめる"],["。"],["あなた"],["の"],["さばき"],["が"],["地","ち"],["に"],["行なわれる","おこなわれる"],["とき"],["、"],["世","よ"],["に"],["住む","すむ"],["者","もの"],["は"],["正義","せいぎ"],["を"],["学ぶ","まなぶ"],["から"],["で"],["ある"],["。"]]},{"verse":10,"text":"悪,あしき者,ものは恵,めぐまれても、なお正義,せいぎを学,まなばず、正,ただしい地,ちにあっても不義,ふぎを行,おこない、主,しゅの威光,いこうを仰,あおぐことをしない。","tok":[["悪しき","あしき"],["者","もの"],["は"],["恵まれて","めぐまれて"],["も"],["、"],["なお"],["正義","せいぎ"],["を"],["学ばず","まなばず"],["、"],["正い","ただしい"],["地","ち"],["に"],["あって"],["も"],["不義","ふぎ"],["を"],["行ない","おこない"],["、"],["主","しゅ"],["の"],["威光","いこう"],["を"],["仰ぐ","あおぐ"],["こと"],["を"],["しない"],["。"]]},{"verse":11,"text":"主,しゅよ、あなたのみ手,てが高,たかくあがるけれども、彼,かれらはそれを顧,かえりみない。どうか、あなたの、おのが民,たみを救,すくわれる熱心,ねっしんを彼,かれらに見,みさせて、大,おおいに恥,はじさせ、火,ひをもってあなたの敵,てきを焼,やき滅,ほろぼしてください。","tok":[["主","しゅ"],["よ"],["、"],["あなた"],["のみ"],["手","て"],["が"],["高かく","たかく"],["あがる"],["けれど"],["も"],["、"],["彼","かれ"],["ら"],["は"],["それ"],["を"],["顧ない","かえりみない"],["。"],["どう"],["か"],["、"],["あなた"],["の"],["、"],["お"],["の"],["が"],["民","たみ"],["を"],["救われる","すくわれる"],["熱心","ねっしん"],["を"],["彼","かれ"],["ら"],["に"],["見させて","みさせて"],["、"],["大いに","おおいに"],["恥","はじ"],["させ"],["、"],["火","ひ"],["を"],["もって"],["あなた"],["の"],["敵","てき"],["を"],["焼き滅ぼして","やきほろぼして"],["ください"],["。"]]},{"verse":12,"text":"主,しゅよ、あなたはわれわれのために平和,へいわを設,もうけられる。あなたはわれわれのためにわれわれのすべてのわざをなし遂,とげられた。","tok":[["主","しゅ"],["よ"],["、"],["あなた"],["は"],["われわれ"],["の"],["ため"],["に"],["平和","へいわ"],["を"],["設けられる","もうけられる"],["。"],["あなた"],["は"],["われわれ"],["の"],["ため"],["に"],["われわれ"],["の"],["すべて"],["の"],["わざ"],["を"],["なし遂げられた","なしとげられた"],["。"]]},{"verse":13,"text":"われわれの神,かみ、主,しゅよ、あなた以外,いがいのもろもろの主,しゅがわれわれを治,おさめた。しかし、われわれはただ、あなたの名,なのみをあがめる。","tok":[["われわれ"],["の"],["神","かみ"],["、"],["主","しゅ"],["よ"],["、"],["あなた"],["以外","いがい"],["の"],["もろもろ"],["の"],["主","しゅ"],["が"],["われわれ"],["を"],["治めた","おさめた"],["。"],["しかし"],["、"],["われわれ"],["は"],["ただ"],["、"],["あなた"],["の"],["名","な"],["のみ"],["を"],["あがめる"],["。"]]},{"verse":14,"text":"死,しんだ者,ものはまた生,いきない。亡霊,ぼうれいは生,いき返,かえらない。それで、あなたは彼,かれらを罰,ばっして滅,ほろぼし、彼,かれらの思,おもい出,でをことごとく消,けし去,さられた。","tok":[["死んだ","しんだ"],["者","もの"],["は"],["また"],["生きない","いきない"],["。"],["亡霊","ぼうれい"],["は"],["生き返らない","いきかえらない"],["。"],["それ"],["で"],["、"],["あなた"],["は"],["彼","かれ"],["ら"],["を"],["罰して","ばっして"],["滅ぼし","ほろぼし"],["、"],["彼","かれ"],["ら"],["の"],["思い出","おもいで"],["を"],["ことごとく"],["消し去られた","けしさられた"],["。"]]},{"verse":15,"text":"主,しゅよ、あなたはこの国民,こくみんを増,まし加,くわえられた。あなたはこの国民,こくみんを増,まし加,くわえられた。あなたは栄光,えいこうをあらわされた。あなたは地,ちの境,さかいを四方,しほうに広,ひろげられた。","tok":[["主","しゅ"],["よ"],["、"],["あなた"],["は"],["この"],["国民","こくみん"],["を"],["増し加えられた","ましくわえられた"],["。"],["あなた"],["は"],["この"],["国民","こくみん"],["を"],["増し加えられた","ましくわえられた"],["。"],["あなた"],["は"],["栄光","えいこう"],["を"],["あらわされた"],["。"],["あなた"],["は"],["地","ち"],["の"],["境","さかい"],["を"],["四方","しほう"],["に"],["広げられた","ひろげられた"],["。"]]},{"verse":16,"text":"主,しゅよ、彼,かれらは悩,なやみのとき、あなたに求,もとめた。彼,かれらがあなたの懲,こらしめにあったとき、祈,いのりをささげた。","tok":[["主","しゅ"],["よ"],["、"],["彼","かれ"],["ら"],["は"],["悩み","なやみ"],["の"],["とき"],["、"],["あなた"],["に"],["求めた","もとめた"],["。"],["彼","かれ"],["ら"],["が"],["あなた"],["の"],["懲らしめ","こらしめ"],["に"],["あった"],["とき"],["、"],["祈","いのり"],["を"],["ささげた"],["。"]]},{"verse":17,"text":"主,しゅよ、はらめる女,おんなの産,うむときが近,ちかづいて苦,くるしみ、その痛,いたみによって叫,さけぶように、われわれはあなたのゆえに、そのようであった。","tok":[["主","しゅ"],["よ"],["、"],["はらめる"],["女","おんな"],["の"],["産む","うむ"],["とき"],["が"],["近づいて","ちかづいて"],["苦しみ","くるしみ"],["、"],["その"],["痛み","いたみ"],["によって"],["叫けぶ","さけぶ"],["よう"],["に"],["、"],["われわれ"],["は"],["あなた"],["の"],["ゆえ"],["に"],["、"],["その"],["よう"],["で"],["あった"],["。"]]},{"verse":18,"text":"われわれは、はらみ、苦,くるしんだ。しかしわれわれの産,うんだものは風,かぜにすぎなかった。われわれは救,すくいを地,ちに施,ほどこすこともせず、また世,よに住,すむ者,ものを滅,ほろぼすこともしなかった。","tok":[["われわれ"],["は"],["、"],["はらみ"],["、"],["苦しんだ","くるしんだ"],["。"],["しかし"],["われわれ"],["の"],["産","うんだも"],["の"],["は"],["風","かぜ"],["に"],["すぎなかった"],["。"],["われわれ"],["は"],["救い","すくい"],["を"],["地","ち"],["に"],["施す","ほどこす"],["こと"],["も"],["せず"],["、"],["また"],["世","よ"],["に"],["住む","すむ"],["者","もの"],["を"],["滅ぼす","ほろぼす"],["こと"],["も"],["しなかった"],["。"]]},{"verse":19,"text":"あなたの死者,ししゃは生,いき、彼,かれらのなきがらは起,おきる。ちりに伏,ふす者,ものよ、さめて喜,よろこびうたえ。あなたの露,つゆは光,ひかりの露,つゆであって、それを亡霊,ぼうれいの国,くにの上,うえに降,ふらされるからである。","tok":[["あなた"],["の"],["死者","ししゃ"],["は"],["生き","いき"],["、"],["彼","かれ"],["ら"],["の"],["なきがら"],["は"],["起きる","おきる"],["。"],["ちり"],["に"],["伏す","ふす"],["者","もの"],["よ"],["、"],["さめて"],["喜こび","よろこび"],["うたえ"],["。"],["あなた"],["の"],["露","つゆ"],["は"],["光","ひかり"],["の"],["露","つ"],["ゆで"],["あって"],["、"],["それ"],["を"],["亡霊","ぼうれい"],["の"],["国","くに"],["の"],["上","うえ"],["に"],["降らされる","ふらされる"],["から"],["で"],["ある"],["。"]]},{"verse":20,"text":"さあ、わが民,たみよ、あなたのへやにはいり、あなたのうしろの戸,とを閉,とじて、憤,いきどおりの過,すぎ去,さるまで、しばらく隠,かくれよ。","tok":[["さあ"],["、"],["わが"],["民","たみ"],["よ"],["、"],["あなた"],["の"],["へや"],["に"],["はいり"],["、"],["あなた"],["の"],["うしろ"],["の"],["戸","と"],["を"],["閉じて","とじて"],["、"],["憤り","いきどおり"],["の"],["過去る","すぎさる"],["まで"],["、"],["しばらく"],["隠れ","かくれ"],["よ"],["。"]]},{"verse":21,"text":"見,みよ、主,しゅはそのおられる所,ところを出,でて、地,ちに住,すむ者,ものの不義,ふぎを罰,ばっせられる。地,ちはその上,うえに流,ながされた血,ちをあらわして、殺,ころされた者,ものを、もはやおおうことがない。","tok":[["見よ","みよ"],["、"],["主","しゅ"],["は"],["その"],["おられる"],["所","ところ"],["を"],["出て","でて"],["、"],["地","ち"],["に"],["住む","すむ"],["者","もの"],["の"],["不義","ふぎ"],["を"],["罰せられる","ばっせられる"],["。"],["地","ち"],["は"],["その"],["上","うえ"],["に"],["流された","ながされた"],["血","ち"],["を"],["あらわして"],["、"],["殺ろされた","ころされた"],["者","もの"],["を"],["、"],["もはや"],["おおう"],["こと"],["が"],["ない"],["。"]]}]
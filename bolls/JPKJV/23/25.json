[{"verse":1,"text":"主,しゅよ、あなたはわが神,かみ、わたしはあなたをあがめ、み名,なをほめたたえる。あなたはさきに驚,おどろくべきみわざを行,おこない、いにしえから定,さだめた計画,けいかくを真実,しんじつをもって行,おこなわれたから。","tok":[["主","しゅ"],["よ"],["、"],["あなた"],["は"],["わが"],["神","かみ"],["、"],["わたし"],["は"],["あなた"],["を"],["あがめ"],["、"],["み名","みな"],["を"],["ほめたたえる"],["。"],["あなた"],["は"],["さき"],["に"],["驚ろくべき","おどろくべき"],["みわざ"],["を"],["行ない","おこない"],["、"],["いにしえ"],["から"],["定めた","さだめた"],["計画","けいかく"],["を"],["真実","しんじつ"],["を"],["もって"],["行なわれた","おこなわれた"],["から"],["。"]]},{"verse":2,"text":"あなたは町,まちを石塚,いしづかとし、堅固,けんごな町,まちを荒塚,あらつかとされた。外国,がいこく人,じんのやかたは、もはや町,まちではなく、とこしえに建,たてられることはない。","tok":[["あなた"],["は"],["町","まち"],["を"],["石塚","いしづか"],["と"],["し"],["、"],["堅固","けんご"],["な"],["町","まち"],["を"],["荒塚","あらつか"],["と"],["された"],["。"],["外国人","がいこくじん"],["の"],["やかた"],["は"],["、"],["もはや"],["町","まち"],["で"],["は"],["なく"],["、"],["とこしえ"],["に"],["建てられる","たてられる"],["こと"],["は"],["ない"],["。"]]},{"verse":3,"text":"それゆえ、強,つよい民,たみはあなたを尊,たっとび、あらぶる国々,くにぐにの町,まちはあなたを恐,おそれる。","tok":[["それ"],["ゆえ"],["、"],["強い","つよい"],["民","たみ"],["は"],["あなた"],["を"],["尊","た"],["っと"],["び"],["、"],["あら"],["ぶる"],["国々","くにぐに"],["の"],["町","まち"],["は"],["あなた"],["を"],["恐れる","おそれる"],["。"]]},{"verse":4,"text":"あなたは貧,まずしい者,もののとりでとなり、乏,とぼしい者,ものの悩,なやみのときのとりでとなり、あらしをさける避,さけ所,どころとなり、熱,あつさをさける陰,かげとなられた。あらぶる者,ものの及,およぼす害,がいは、石,いしがきを打,うつあらしのごとく、","tok":[["あなた"],["は"],["貧しい","まずしい"],["者","もの"],["の"],["とりで"],["と"],["なり"],["、"],["乏い","とぼしい"],["者","もの"],["の"],["悩み","なやみ"],["の"],["とき"],["の"],["とりで"],["と"],["なり"],["、"],["あらし"],["を"],["さける"],["避け所","さけど"],["ころ"],["と"],["なり"],["、"],["熱","あつ"],["さ"],["を"],["さける"],["陰","かげ"],["と"],["なられた"],["。"],["あら"],["ぶる"],["者","もの"],["の"],["及ぼす","およぼす"],["害","がい"],["は"],["、"],["石がき","いしがき"],["を"],["打つ","うつ"],["あらし"],["の"],["ごとく"],["、"]]},{"verse":5,"text":"かわいた地,ちの熱,あつさのようだからである。あなたは外国,がいこく人,じんの騒,さわぎをおさえ、雲,くもが陰,かげをもって熱,ねつをとどめるようにあらぶる者,ものの歌,うたをとどめられる。","tok":[["かわいた"],["地","ち"],["の"],["熱","あつ"],["さ"],["の"],["よう"],["だ"],["から"],["で"],["ある"],["。"],["あなた"],["は"],["外国人","がいこくじん"],["の"],["騒","さわぎ"],["を"],["おさえ"],["、"],["雲","くも"],["が"],["陰","かげ"],["を"],["もって"],["熱","ねつ"],["を"],["とどめる"],["よう"],["に"],["あら"],["ぶる"],["者","もの"],["の"],["歌","うた"],["を"],["とどめられる"],["。"]]},{"verse":6,"text":"万軍,ばんぐんの主,しゅはこの山,やまで、すべての民,たみのために肥,こえたものをもって祝宴,しゅくえんを設,もうけ、久,ひさしくたくわえたぶどう酒,しゅをもって祝宴,しゅくえんを設,もうけられる。すなわち髄,ずいの多,おおい肥,こえたものと、よく澄,すんだ長,ながくたくわえたぶどう酒,しゅをもって祝宴,しゅくえんを設,もうけられる。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["この"],["山","やま"],["で"],["、"],["すべて"],["の"],["民","たみ"],["の"],["ため"],["に"],["肥","こえ"],["た"],["もの"],["を"],["もって"],["祝宴","しゅくえん"],["を"],["設け","もうけ"],["、"],["久く","ひさしく"],["たくわえた"],["ぶどう酒","ぶどうしゅ"],["を"],["もって"],["祝宴","しゅくえん"],["を"],["設けられる","もうけられる"],["。"],["すなわち"],["髄","ずい"],["の"],["多い","おおい"],["肥","こえ"],["た"],["もの"],["と"],["、"],["よく"],["澄んだ","すんだ"],["長く","ながく"],["たくわえた"],["ぶどう酒","ぶどうしゅ"],["を"],["もって"],["祝宴","しゅくえん"],["を"],["設けられる","もうけられる"],["。"]]},{"verse":7,"text":"また主,しゅはこの山,やまで、すべての民,たみのかぶっている顔,かおおおいと、すべての国,くにのおおっているおおい物,ものとを破,やぶられる。","tok":[["また"],["主","しゅ"],["は"],["この"],["山","やま"],["で"],["、"],["すべて"],["の"],["民","たみ"],["の"],["かぶって"],["いる"],["顔","かお"],["おおい"],["と"],["、"],["すべて"],["の"],["国","くに"],["の"],["おおって"],["いる"],["おおい"],["物","もの"],["と"],["を"],["破られる","やぶられる"],["。"]]},{"verse":8,"text":"主,しゅはとこしえに死,しを滅,ほろぼし、主,しゅなる神,かみはすべての顔,かおから涙,なみだをぬぐい、その民,たみのはずかしめを全,ぜん地,ちの上,うえから除,のぞかれる。これは主,しゅの語,かたられたことである。","tok":[["主","しゅ"],["は"],["とこしえ"],["に"],["死","し"],["を"],["滅ぼし","ほろぼし"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["すべて"],["の"],["顔","かお"],["から"],["涙","なみだ"],["を"],["ぬぐい"],["、"],["その"],["民","たみ"],["の"],["はずかし"],["め"],["を"],["全地","ぜんち"],["の"],["上","うえ"],["から"],["除かれる","のぞかれる"],["。"],["これ"],["は"],["主","しゅ"],["の"],["語られた","かたられた"],["こと"],["で"],["ある"],["。"]]},{"verse":9,"text":"その日,ひ、人,ひとは言,いう、「見,みよ、これはわれわれの神,かみである。わたしたちは彼,かれを待,まち望,のぞんだ。彼,かれはわたしたちを救,すくわれる。これは主,しゅである。わたしたちは彼,かれを待,まち望,のぞんだ。わたしたちはその救,すくいを喜,よろこび楽,たのしもう」と。","tok":[["その"],["日","ひ"],["、"],["人","ひと"],["は"],["言う","いう"],["、"],["「"],["見よ","みよ"],["、"],["これ"],["は"],["われわれ"],["の"],["神","かみ"],["で"],["ある"],["。"],["わたしたち"],["は"],["彼","かれ"],["を"],["待ち望んだ","まちのぞんだ"],["。"],["彼","かれ"],["は"],["わたしたち"],["を"],["救われる","すくわれる"],["。"],["これ"],["は"],["主","しゅ"],["で"],["ある"],["。"],["わたしたち"],["は"],["彼","かれ"],["を"],["待ち望んだ","まちのぞんだ"],["。"],["わたしたち"],["は"],["その"],["救い","すくい"],["を"],["喜こび","よろこび"],["楽しもう","たのしもう"],["」"],["と"],["。"]]},{"verse":10,"text":"主,しゅの手,てはこの山,やまにとどまり、モアブは肥,こえだめの中,なかに踏,ふまれるわらのように、おのれの所,ところで踏,ふみにじられる。","tok":[["主","しゅ"],["の"],["手","て"],["は"],["この"],["山","やま"],["に"],["とどまり"],["、"],["モアブ"],["は"],["肥だめ","こえだめ"],["の"],["中","なか"],["に"],["踏まれる","ふまれる"],["わら"],["の"],["よう"],["に"],["、"],["おのれ"],["の"],["所","ところ"],["で"],["踏みにじられる","ふみにじられる"],["。"]]},{"verse":11,"text":"彼,かれはその中,なかで泳,およぐ物,ものが泳,およごうとして手,てを伸,のばすように、その手,てを伸,のばす。しかし主,しゅはその高,たかぶりを、その手,ての巧,たくみなわざと共,ともに低,ひくくされる。","tok":[["彼","かれ"],["は"],["その"],["中","なか"],["で"],["泳ぐ","およぐ"],["物","もの"],["が"],["泳ごう","およごう"],["として"],["手","て"],["を"],["伸ばす","のばす"],["よう"],["に"],["、"],["その"],["手","て"],["を"],["伸ばす","のばす"],["。"],["しかし"],["主","しゅ"],["は"],["その"],["高ぶり","たかぶり"],["を"],["、"],["その"],["手","て"],["の"],["巧","たくみ"],["な"],["わざと"],["共","とも"],["に"],["低く","ひくく"],["される"],["。"]]},{"verse":12,"text":"その石,いしがきの高,たかい城郭,じょうかくを主,しゅは傾,かたむけ倒,たおし、地,ちに投,なげうって、ちりにかえされる。","tok":[["その"],["石がき","いしがき"],["の"],["高い","たかい"],["城郭","じょうかく"],["を"],["主","しゅ"],["は"],["傾むけ","かたむけ"],["倒し","たおし"],["、"],["地","ち"],["に"],["投","なげ"],["うって"],["、"],["ちり"],["に"],["かえされる"],["。"]]}]
[{"verse":1,"text":"主,しゅはヤコブをあわれみ、イスラエルを再,ふたたび選,えらんで、これをおのれの地,ちに置,おかれる。異邦人,いほうじんはこれに加,くわわって、ヤコブの家,いえに結,むすびつらなり、","tok":[["主","しゅ"],["は"],["ヤコブ"],["を"],["あわれみ"],["、"],["イスラエル"],["を"],["再び","ふたたび"],["選らんで","えらんで"],["、"],["これ"],["を"],["おのれ"],["の"],["地","ち"],["に"],["置かれる","おかれる"],["。"],["異邦人","いほうじん"],["は"],["これ"],["に"],["加わわって","くわわって"],["、"],["ヤコブ"],["の"],["家","いえ"],["に"],["結び","むすび"],["つらなり"],["、"]]},{"verse":2,"text":"もろもろの民,たみは彼,かれらを連,つれてその所,ところに導,みちびいて来,くる。そしてイスラエルの家,いえは、主,しゅの地,ちで彼,かれらを男女,だんじょの奴隷,どれいとし、さきに自分,じぶんたちを捕虜,ほりょにした者,ものを捕虜,ほりょにし、自分,じぶんたちをしえたげた者,ものを治,おさめる。","tok":[["もろもろ"],["の"],["民","たみ"],["は"],["彼","かれ"],["ら"],["を"],["連れて","つれて"],["その"],["所","ところ"],["に"],["導いて","みちびいて"],["来る","くる"],["。"],["そして"],["イスラエル"],["の"],["家","いえ"],["は"],["、"],["主","しゅ"],["の"],["地","ち"],["で"],["彼","かれ"],["ら"],["を"],["男女","だんじょ"],["の"],["奴隷","どれい"],["と"],["し"],["、"],["さき"],["に"],["自分","じぶん"],["たち"],["を"],["捕虜","ほりょ"],["に"],["した"],["者","もの"],["を"],["捕虜","ほりょ"],["に"],["し"],["、"],["自分","じぶん"],["たち"],["を"],["し"],["えたげた"],["者","もの"],["を"],["治める","おさめる"],["。"]]},{"verse":3,"text":"主,しゅがあなたの苦労,くろうと不安,ふあんとを除,のぞき、またあなたが服,ふくした苦役,くえきを除,のぞいて、安息,あんそくをお与,あたえになるとき、","tok":[["主","しゅ"],["が"],["あなた"],["の"],["苦労","くろう"],["と"],["不安","ふあん"],["と"],["を"],["除き","のぞき"],["、"],["また"],["あなた"],["が"],["服した","ふくした"],["苦役","くえき"],["を"],["除いて","のぞいて"],["、"],["安息","あんそく"],["を"],["お"],["与","あたえ"],["に"],["なる"],["とき"],["、"]]},{"verse":4,"text":"あなたはこのあざけりの歌,うたをとなえ、バビロンの王,おうをののしって言,いう、「あの、しえたげる者,ものは全,まったく絶,たえてしまった。あの、おごる者,ものは全,まったく絶,たえてしまった。","tok":[["あなた"],["は"],["この"],["あざけり"],["の"],["歌","うた"],["を"],["となえ"],["、"],["バビロン"],["の"],["王","おう"],["を"],["ののしって"],["言う","いう"],["、"],["「"],["あの"],["、"],["し"],["えたげる"],["者","もの"],["は"],["全く","まったく"],["絶えて","たえて"],["しまった"],["。"],["あの"],["、"],["おごる"],["者","もの"],["は"],["全く","まったく"],["絶えて","たえて"],["しまった"],["。"]]},{"verse":5,"text":"主,しゅは悪,わるい者,もののつえと、つかさびとの笏,しゃくを折,おられた。","tok":[["主","しゅ"],["は"],["悪い","わるい"],["者","もの"],["の"],["つえ"],["と"],["、"],["つかさ"],["びと"],["の"],["笏","しゃく"],["を"],["折られた","おられた"],["。"]]},{"verse":6,"text":"彼,かれらは憤,いきどおりをもってもろもろの民,たみを絶,たえず撃,うっては打,うち、怒,いかりをもってもろもろの国,くにを治,おさめても、そのしえたげをとどめる者,ものがなかった。","tok":[["彼","かれ"],["ら"],["は"],["憤り","いきどおり"],["を"],["もって"],["もろもろ"],["の"],["民","たみ"],["を"],["絶えず","たえず"],["撃って","うって"],["は"],["打ち","うち"],["、"],["怒り","いかり"],["を"],["もって"],["もろもろ"],["の"],["国","くに"],["を"],["治めて","おさめて"],["も"],["、"],["その"],["し"],["えたげ"],["を"],["とどめる"],["者","もの"],["が"],["なかった"],["。"]]},{"verse":7,"text":"全,ぜん地,ちはやすみを得,え、穏,おだやかになり、ことごとく声,こえをあげて歌,うたう。","tok":[["全地","ぜんち"],["は"],["やすみ"],["を"],["得","え"],["、"],["穏","おだやか"],["に"],["なり"],["、"],["ことごとく"],["声","こえ"],["を"],["あげて"],["歌う","うたう"],["。"]]},{"verse":8,"text":"いとすぎおよびレバノンの香柏,こうはくでさえもあなたのゆえに喜,よろこんで言,いう、『あなたはすでに倒,たおれたので、もはや、きこりが上,のぼってきて、われわれを攻,せめることはない』。","tok":[["いと"],["すぎ"],["および"],["レバノン"],["の"],["香","こう"],["柏","かしわ"],["も"],["あなた"],["の"],["ゆえ"],["に"],["喜こんで","よろこんで"],["言う","いう"],["、"],["『"],["あなた"],["は"],["すでに"],["倒れた","たおれた"],["ので"],["、"],["もはや"],["、"],["きこり"],["が"],["上って","のぼって"],["きて"],["、"],["われわれ"],["を"],["攻める","せめる"],["こと"],["は"],["ない"],["』"],["。"]]},{"verse":9,"text":"下,したの陰府,よみはあなたのために動,うごいて、あなたの来,くるのを迎,むかえ、地,ちのもろもろの指導者,しどうしゃたちの亡霊,ぼうれいをあなたのために起,おこし、国々,くにぐにのもろもろの王,おうをその王座,おうざから立,たちあがらせる。","tok":[["下","した"],["の"],["陰府","よみ"],["は"],["あなた"],["の"],["ため"],["に"],["動いて","うごいて"],["、"],["あなた"],["の"],["来る","くる"],["の"],["を"],["迎","むかえ"],["、"],["地","ち"],["の"],["もろもろ"],["の"],["指導者","しどうしゃ"],["たち"],["の"],["亡霊","ぼうれい"],["を"],["あなた"],["の"],["ため"],["に"],["起こし","おこし"],["、"],["国々","くにぐに"],["の"],["もろもろ"],["の"],["王","おう"],["を"],["その"],["王座","おうざ"],["から"],["立ちあがらせる","たちあがらせる"],["。"]]},{"verse":10,"text":"彼,かれらは皆,みなあなたに告,つげて言,いう、『あなたもまたわれわれのように弱,よわくなった、あなたもわれわれと同,おなじようになった』。","tok":[["彼","かれ"],["ら"],["は"],["皆","みな"],["あなた"],["に"],["告","つげ"],["て"],["言う","いう"],["、"],["『"],["あなた"],["も"],["また"],["われわれ"],["の"],["よう"],["に"],["弱く","よわく"],["なった"],["、"],["あなた"],["も"],["われわれ"],["と"],["同じ","おなじ"],["よう"],["に"],["なった"],["』"],["。"]]},{"verse":11,"text":"あなたの栄華,えいがとあなたの琴,ことの音,おとは陰府,よみに落,おちてしまった。うじはあなたの下,したに敷,しかれ、みみずはあなたをおおっている。","tok":[["あなた"],["の"],["栄華","えいが"],["と"],["あなた"],["の"],["琴","こと"],["の"],["音","おと"],["は"],["陰府","よみ"],["に"],["落","おち"],["て"],["しまった"],["。"],["うじ"],["は"],["あなた"],["の"],["下","した"],["に"],["敷かれ","しかれ"],["、"],["みみず"],["は"],["あなた"],["を"],["おおって"],["いる"],["。"]]},{"verse":12,"text":"黎明,れいめいの子,こ、明,あけの明星,みょうじょうよ、あなたは天,てんから落,おちてしまった。もろもろの国,くにを倒,たおした者,ものよ、あなたは切,きられて地,ちに倒,たおれてしまった。","tok":[["黎明","れいめい"],["の"],["子","こ"],["、"],["明け","あけ"],["の"],["明星","みょうじょう"],["よ"],["、"],["あなた"],["は"],["天","てん"],["から"],["落","おち"],["て"],["しまった"],["。"],["もろもろ"],["の"],["国","くに"],["を"],["倒した","たおした"],["者","もの"],["よ"],["、"],["あなた"],["は"],["切られて","きられて"],["地","ち"],["に"],["倒れて","たおれて"],["しまった"],["。"]]},{"verse":13,"text":"あなたはさきに心,こころのうちに言,いった、『わたしは天,てんにのぼり、わたしの王座,おうざを高,たかく神,かみの星,ほしの上,うえにおき、北,きたの果,はてなる集会,しゅうかいの山,やまに座,ざし、","tok":[["あなた"],["は"],["さき"],["に"],["心","こころ"],["の"],["うち"],["に"],["言った","いった"],["、"],["『"],["わたし"],["は"],["天","てん"],["に"],["のぼり"],["、"],["わたし"],["の"],["王座","おうざ"],["を"],["高かく","たかく"],["神","かみ"],["の"],["星","ほし"],["の"],["上","うえ"],["に"],["おき"],["、"],["北","きた"],["の"],["果てなる","はてなる"],["集会","しゅうかい"],["の"],["山","やま"],["に"],["座し","ざし"],["、"]]},{"verse":14,"text":"雲,くものいただきにのぼり、いと高,たかき者,もののようになろう』。","tok":[["雲","くも"],["の"],["いただき"],["に"],["のぼり"],["、"],["いと"],["高き","たかき"],["者","もの"],["の"],["よう"],["に"],["なろう"],["』"],["。"]]},{"verse":15,"text":"しかしあなたは陰府,よみに落,おとされ、穴,あなの奥底,おくそこに入,いれられる。","tok":[["しかし"],["あなた"],["は"],["陰府","よみ"],["に"],["落とされ","おとされ"],["、"],["穴","あな"],["の"],["奥底","おくそこ"],["に"],["入れられる","いれられる"],["。"]]},{"verse":16,"text":"あなたを見,みる者,ものはつくづくあなたを見,み、あなたに目,めをとめて言,いう、『この人,ひとは地,ちを震,ふるわせ、国々,くにぐにを動,うごかし、","tok":[["あなた"],["を"],["見る","みる"],["者","もの"],["は"],["つくづく"],["あなた"],["を"],["見","み"],["、"],["あなた"],["に"],["目","め"],["を"],["とめて"],["言う","いう"],["、"],["『"],["この"],["人","ひと"],["は"],["地","ち"],["を"],["震わせ","ふるわせ"],["、"],["国々","くにぐに"],["を"],["動かし","うごかし"],["、"]]},{"verse":17,"text":"世界,せかいを荒野,あらののようにし、その都市,としをこわし、捕,とらえた者,ものをその家,いえに解,とき帰,かえさなかった者,ものであるのか』。","tok":[["世界","せかい"],["を"],["荒野","あらの"],["の"],["よう"],["に"],["し"],["、"],["その"],["都市","とし"],["を"],["こわし"],["、"],["捕らえた","とらえた"],["者","もの"],["を"],["その"],["家","いえ"],["に"],["解き","とき"],["帰さなかった","かえさなかった"],["者","もの"],["で"],["ある"],["の"],["か"],["』"],["。"]]},{"verse":18,"text":"もろもろの国,くにの王,おうたちは皆,みな尊,たっといさまで、自分,じぶんの墓,はかに眠,ねむる。","tok":[["もろもろ"],["の"],["国","くに"],["の"],["王","おう"],["たち"],["は"],["皆","みな"],["尊","た"],["っと"],["いさまで"],["、"],["自分","じぶん"],["の"],["墓","はか"],["に"],["眠る","ねむる"],["。"]]},{"verse":19,"text":"しかしあなたは忌,いみきらわれる月,つき足,たらぬ子,このように墓,はかのそとに捨,すてられ、つるぎで刺,さし殺,ころされた者,ものでおおわれ、踏,ふみつけられる死体,したいのように穴,あなの石,いしに下,くだる。","tok":[["しかし"],["あなた"],["は"],["忌","いみ"],["きらわれる"],["月","つき"],["足らぬ","たらぬ"],["子","こ"],["の"],["よう"],["に"],["墓","はか"],["の"],["そと"],["に"],["捨てられ","すてられ"],["、"],["つるぎ"],["で"],["刺殺","さしこ"],["ろ"],["された"],["者","もの"],["で"],["おおわれ"],["、"],["踏みつけられる","ふみつけられる"],["死体","したい"],["の"],["よう"],["に"],["穴","あな"],["の"],["石","いし"],["に"],["下る","くだる"],["。"]]},{"verse":20,"text":"あなたは自分,じぶんの国,くにを滅,ほろぼし、自分,じぶんの民,たみを殺,ころしたために、彼,かれらと共,ともに葬,ほうむられることはない。どうか、悪,あくを行,おこなう者,ものの子孫,しそんはとこしえに名,なを呼,よばれることのないように。","tok":[["あなた"],["は"],["自分","じぶん"],["の"],["国","くに"],["を"],["滅ぼし","ほろぼし"],["、"],["自分","じぶん"],["の"],["民","たみ"],["を"],["殺ろした","ころした"],["ため"],["に"],["、"],["彼","かれ"],["ら"],["と"],["共","とも"],["に"],["葬むられる","ほうむられる"],["こと"],["は"],["ない"],["。"],["どう"],["か"],["、"],["悪","あく"],["を"],["行なう","おこなう"],["者","もの"],["の"],["子孫","しそん"],["は"],["とこしえ"],["に"],["名","な"],["を"],["呼ばれる","よばれる"],["こと"],["の"],["ない"],["よう"],["に"],["。"]]},{"verse":21,"text":"先祖,せんぞのよこしまのゆえに、その子孫,しそんのためにほふり場,ばを備,そなえよ。これは彼,かれらが起,たって地,ちを取,とり、世界,せかいのおもてに町々,まちまちを満,みたすことのないためである」。","tok":[["先祖","せんぞ"],["の"],["よこしま"],["の"],["ゆえ"],["に"],["、"],["その"],["子孫","しそん"],["の"],["ため"],["に"],["ほふり"],["場","ば"],["を"],["備","そなえ"],["よ"],["。"],["これ"],["は"],["彼","かれ"],["ら"],["が"],["起って","たって"],["地","ち"],["を"],["取","とり"],["、"],["世界","せかい"],["の"],["おもて"],["に"],["町々","まちまち"],["を"],["満たす","みたす"],["こと"],["の"],["ない"],["ため"],["で"],["ある"],["」"],["。"]]},{"verse":22,"text":"万軍,ばんぐんの主,しゅは言,いわれる、「わたしは立,たって彼,かれらを攻,せめ、バビロンからその名,なと、残,のこれる者,もの、その子,こと孫,まごとを断,たち滅,ほろぼす、と主,しゅは言,いう。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["言われる","いわれる"],["、"],["「"],["わたし"],["は"],["立って","たって"],["彼","かれ"],["ら"],["を"],["攻め","せめ"],["、"],["バビロン"],["から"],["その"],["名","な"],["と"],["、"],["残れる","のこれる"],["者","もの"],["、"],["その"],["子","こ"],["と"],["孫","まご"],["と"],["を"],["断ち","たち"],["滅ぼす","ほろぼす"],["、"],["と"],["主","しゅ"],["は"],["言う","いう"],["。"]]},{"verse":23,"text":"わたしはこれをはりねずみのすみかとし、水,みずの池,いけとし、滅,ほろびのほうきをもって、これを払,はらい除,のぞく、と万軍,ばんぐんの主,しゅは言,いう」。","tok":[["わたし"],["は"],["これ"],["を"],["はりねずみ"],["の"],["すみか"],["と"],["し"],["、"],["水","みず"],["の"],["池","いけ"],["と"],["し"],["、"],["滅び","ほろび"],["の"],["ほうき"],["を"],["もって"],["、"],["これ"],["を"],["払","はらい"],["除く","のぞく"],["、"],["と"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["言う","いう"],["」"],["。"]]},{"verse":24,"text":"万軍,ばんぐんの主,しゅは誓,ちかって言,いわれる、「わたしが思,おもったように必,かならず成,なり、わたしが定,さだめたように必,かならず立,たつ。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["誓って","ちかって"],["言われる","いわれる"],["、"],["「"],["わたし"],["が"],["思った","おもった"],["よう"],["に"],["必","かならず"],["成り","なり"],["、"],["わたし"],["が"],["定めた","さだめた"],["よう"],["に"],["必","かならず"],["立つ","たつ"],["。"]]},{"verse":25,"text":"わたしはアッスリヤびとをわが地,ちで打,うち破,やぶり、わが山々,やまやまで彼,かれを踏,ふみにじる。こうして彼,かれが置,おいたくびきはイスラエルびとから離,はなれ、彼,かれが負,おわせた重荷,おもにはイスラエルびとの肩,かたから離,はなれる」。","tok":[["わたし"],["は"],["アッスリヤ"],["びと"],["を"],["わが"],["地","ち"],["で"],["打ち破り","うちやぶり"],["、"],["わが"],["山々","やまやま"],["で"],["彼","かれ"],["を"],["踏みにじる","ふみにじる"],["。"],["こう"],["して"],["彼","かれ"],["が"],["置いた","おいた"],["くびき"],["は"],["イスラエル"],["びと"],["から"],["離れ","はなれ"],["、"],["彼","かれ"],["が"],["負わせた","おわせた"],["重荷","おもに"],["は"],["イスラエル"],["びと"],["の"],["肩","かた"],["から"],["離れる","はなれる"],["」"],["。"]]},{"verse":26,"text":"これは全,ぜん地,ちについて定,さだめられた計画,けいかくである。これは国々,くにぐにの上,うえに伸,のばされた手,てである。","tok":[["これ"],["は"],["全地","ぜんち"],["について"],["定められた","さだめられた"],["計画","けいかく"],["で"],["ある"],["。"],["これ"],["は"],["国々","くにぐに"],["の"],["上","うえ"],["に"],["伸ばされた","のばされた"],["手","て"],["で"],["ある"],["。"]]},{"verse":27,"text":"万軍,ばんぐんの主,しゅが定,さだめられるとき、だれがそれを取,とり消,けすことができるのか。その手,てを伸,のばされるとき、だれがそれを引,ひきもどすことができるのか。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["が"],["定められる","さだめられる"],["とき"],["、"],["だれ"],["が"],["それ"],["を"],["取消す","とりけす"],["こと"],["が"],["できる"],["の"],["か"],["。"],["その"],["手","て"],["を"],["伸ばされる","のばされる"],["とき"],["、"],["だれ"],["が"],["それ"],["を"],["引","ひき"],["も"],["どす"],["こと"],["が"],["できる"],["の"],["か"],["。"]]},{"verse":28,"text":"アハズ王,おうの死,しんだ年,ねんにこの託宣,たくせんがあった、","tok":[["アハズ"],["王","おう"],["の"],["死んだ","しんだ"],["年","ねん"],["に"],["この"],["託宣","たくせん"],["が"],["あった"],["、"]]},{"verse":29,"text":"「ペリシテの全,ぜん地,ちよ、あなたを打,うったむちが折,おられたことを喜,よろこんではならない。へびの根,ねからまむしが出,で、その実,みは飛,とびかけるへびとなるからだ。","tok":[["「"],["ペリシテ"],["の"],["全地","ぜんち"],["よ"],["、"],["あなた"],["を"],["打った","うった"],["むち"],["が"],["折られた","おられた"],["こと"],["を"],["喜こんで","よろこんで"],["は"],["ならない"],["。"],["へび"],["の"],["根","ね"],["から"],["まむし"],["が"],["出","で"],["、"],["その"],["実","み"],["は"],["飛び","とび"],["かける"],["へび"],["と"],["なる"],["から"],["だ"],["。"]]},{"verse":30,"text":"いと貧,まずしい者,ものは食,しょくを得,え、乏,とぼしい者,ものは安,やすらかに伏,ふす。しかし、わたしはききんをもってあなたの子孫,しそんを殺,ころし、あなたの残,のこれる者,ものを滅,ほろぼす。","tok":[["いと"],["貧しい","まずしい"],["者","もの"],["は"],["食","しょく"],["を"],["得","え"],["、"],["乏い","とぼしい"],["者","もの"],["は"],["安らか","やすらか"],["に"],["伏す","ふす"],["。"],["しかし"],["、"],["わたし"],["は"],["ききん"],["を"],["もって"],["あなた"],["の"],["子孫","しそん"],["を"],["殺ろし","ころし"],["、"],["あなた"],["の"],["残れる","のこれる"],["者","もの"],["を"],["滅ぼす","ほろぼす"],["。"]]},{"verse":31,"text":"門,もんよ、泣,なきわめけ。町,まちよ、叫,さけべ。ペリシテの全,ぜん地,ちよ、恐,おそれのあまり消,きえうせよ、北,きたから煙,けむりが来,くるからだ。その隊列,たいれつからは、ひとりも脱落,だつらくする者,ものはない」。","tok":[["門","もん"],["よ"],["、"],["泣","なき"],["わめけ"],["。"],["町","まち"],["よ"],["、"],["叫けべ","さけべ"],["。"],["ペリシテ"],["の"],["全地","ぜんち"],["よ"],["、"],["恐","おそれ"],["の"],["あまり"],["消えうせよ","きえうせよ"],["、"],["北","きた"],["から"],["煙","けむり"],["が"],["来る","くる"],["から"],["だ"],["。"],["その"],["隊列","たいれつ"],["から"],["は"],["、"],["ひとり"],["も"],["脱落","だつらく"],["する"],["者","もの"],["は"],["ない"],["」"],["。"]]},{"verse":32,"text":"その国,くにの使者,ししゃたちになんと答,こたえようか。「主,しゅはシオンの基,もといをおかれた、その民,たみの苦,くるしむ者,ものはこの中,なかに避,さけ所,どころを得,える」と答,こたえよ。","tok":[["その"],["国","くに"],["の"],["使者","ししゃ"],["たち"],["に"],["なん"],["と"],["答","こたえ"],["よう"],["か"],["。"],["「"],["主","しゅ"],["は"],["シオン"],["の"],["基い","もとい"],["を"],["おかれた"],["、"],["その"],["民","たみ"],["の"],["苦しむ","くるしむ"],["者","もの"],["は"],["この"],["中","なか"],["に"],["避け","さけ"],["所","どころ"],["を"],["得る","える"],["」"],["と"],["答","こたえ"],["よ"],["。"]]}]
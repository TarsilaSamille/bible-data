[{"verse":1,"text":"幻,まぼろしの谷,たにについての託宣,たくせん。あなたがたはなぜ、みな屋根,やねにのぼったのか。","tok":[["幻","まぼろし"],["の"],["谷","たに"],["について"],["の"],["託宣","たくせん"],["。"],["あなた"],["がた"],["は"],["なぜ"],["、"],["みな"],["屋根","やね"],["に"],["のぼった"],["の"],["か"],["。"]]},{"verse":2,"text":"叫,さけび声,ごえで満,みちている者,もの、騒,さわがしい都,みやこ、喜,よろこびに酔,よっている町,まちよ。あなたのうちの殺,ころされた者,ものはつるぎで殺,ころされたのではなく、また戦,たたかいに倒,たおれたのでもない。","tok":[["叫声","さけびご"],["え"],["で"],["満ちて","みちて"],["いる"],["者","もの"],["、"],["騒がしい","さわがしい"],["都","み"],["やこ"],["、"],["喜こび","よろこび"],["に"],["酔って","よって"],["いる"],["町","まち"],["よ"],["。"],["あなた"],["の"],["うち"],["の"],["殺ろされた","ころされた"],["者","もの"],["は"],["つるぎ"],["で"],["殺ろされた","ころされた"],["ので"],["は"],["なく"],["、"],["また"],["戦い","たたかい"],["に"],["倒れた","たおれた"],["ので"],["も"],["ない"],["。"]]},{"verse":3,"text":"あなたのつかさたちは皆,みな共,ともにのがれて行,いったが、弓,ゆみを捨,すてて捕,とらえられた。彼,かれらは遠,とおく逃,にげて行,いったが、あなたのうちの見,みつかった者,ものはみな捕,とらえられた。","tok":[["あなた"],["の"],["つかさ"],["たち"],["は"],["皆","みな"],["共","とも"],["に"],["のがれて"],["行った","いった"],["が"],["、"],["弓","ゆみ"],["を"],["捨てて","すてて"],["捕らえられた","とらえられた"],["。"],["彼","かれ"],["ら"],["は"],["遠く","とおく"],["逃て","にげて"],["行った","いった"],["が"],["、"],["あなた"],["の"],["うち"],["の"],["見つかった","みつかった"],["者","もの"],["は"],["みな"],["捕らえられた","とらえられた"],["。"]]},{"verse":4,"text":"それゆえ、わたしは言,いった、「わたしを顧,かえりみてくれるな、わたしはいたく泣,なき悲,かなしむ。わが民,たみの娘,むすめの滅,ほろびのために、わたしを慰,なぐさめようと努,つとめてはならない」。","tok":[["それ"],["ゆえ"],["、"],["わたし"],["は"],["言った","いった"],["、"],["「"],["わたし"],["を"],["顧て","かえりみて"],["くれる"],["な"],["、"],["わたし"],["は"],["いたく"],["泣","なき"],["悲しむ","かなしむ"],["。"],["わが"],["民","たみ"],["の"],["娘","むすめ"],["の"],["滅び","ほろび"],["の"],["ため"],["に"],["、"],["わたし"],["を"],["慰さめよう","なぐさめよう"],["と"],["努めて","つとめて"],["は"],["ならない"],["」"],["。"]]},{"verse":5,"text":"万軍,ばんぐんの神,かみ、主,しゅは幻,まぼろしの谷,たにに騒,さわぎと、踏,ふみにじりと、混乱,こんらんの日,ひをこさせられる。城壁,じょうへきはくずれ落,おち、叫,さけび声,ごえは山,やまに聞,きこえる。","tok":[["万","まん"],["軍","ぐん"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["幻","まぼろし"],["の"],["谷","たに"],["に"],["騒","さわぎ"],["と"],["、"],["踏みにじり","ふみにじり"],["と"],["、"],["混乱","こんらん"],["の"],["日","ひ"],["を"],["こさせられる"],["。"],["城壁","じょうへき"],["は"],["くずれ"],["落","おち"],["、"],["叫声","さけびごえ"],["は"],["山","やま"],["に"],["聞こえる","きこえる"],["。"]]},{"verse":6,"text":"エラムは箙,えびらを負,おい、戦車,せんしゃと騎兵,きへいとをもってきたり、キルは盾,たてをあらわした。","tok":[["エラム"],["は"],["箙","えびら"],["を"],["負い","おい"],["、"],["戦車","せんしゃ"],["と"],["騎兵","きへい"],["と"],["を"],["もって"],["き"],["たり"],["、"],["キル"],["は"],["盾","たて"],["を"],["あらわした"],["。"]]},{"verse":7,"text":"あなたの最,もっとも美,うつくしい谷,たには戦車,せんしゃで満,みち、騎兵,きへいはもろもろの門,もんにむかって立,たった。","tok":[["あなた"],["の"],["最も","もっとも"],["美しい","うつくしい"],["谷","たに"],["は"],["戦車","せんしゃ"],["で"],["満ち","みち"],["、"],["騎兵","きへい"],["は"],["もろもろ"],["の"],["門","もん"],["に"],["むかって"],["立った","たった"],["。"]]},{"verse":8,"text":"ユダを守,まもるおおいは取,とり除,のぞかれた。その日,ひあなたは林,はやしの家,いえの武具,ぶぐを仰,あおぎ望,のぞんだ。","tok":[["ユダ"],["を"],["守","まもる"],["おおい"],["は"],["取除かれた","とりのぞかれた"],["。"],["その"],["日","ひ"],["あなた"],["は"],["林","はやし"],["の"],["家","いえ"],["の"],["武具","ぶぐ"],["を"],["仰ぎ","あおぎ"],["望んだ","のぞんだ"],["。"]]},{"verse":9,"text":"またあなたがたはダビデの町,まちの破,やぶれの多,おおいのを見,み、下,したの池,いけの水,みずを集,あつめ、","tok":[["また"],["あなた"],["がた"],["は"],["ダビデ"],["の"],["町","まち"],["の"],["破れ","やぶれ"],["の"],["多い","おおい"],["の"],["を"],["見","み"],["、"],["下","した"],["の"],["池","いけ"],["の"],["水","みず"],["を"],["集め","あつめ"],["、"]]},{"verse":10,"text":"エルサレムの家,いえを数,かぞえ、またその家,いえをこわして城壁,じょうへきを築,きずき、","tok":[["エルサレム"],["の"],["家","いえ"],["を"],["数え","かぞえ"],["、"],["また"],["その"],["家","いえ"],["を"],["こわして"],["城壁","じょうへき"],["を"],["築き","きずき"],["、"]]},{"verse":11,"text":"一つの貯水池,ちょすいちを二つの城壁,じょうへきの間,あいだに造,つくって古池,ふるいけの水,みずをひいた。しかしあなたがたはこの事,ことをなされた者,ものを仰,あおぎ望,のぞまず、この事,ことを昔,むかしから計画,けいかくされた者,ものを顧,かえりみなかった。","tok":[["一","ひと"],["つ"],["の"],["貯水池","ちょすいち"],["を"],["二","ふた"],["つ"],["の"],["城壁","じょうへき"],["の"],["間","あいだ"],["に"],["造って","つくって"],["古池","ふるいけ"],["の"],["水","みず"],["を"],["ひいた"],["。"],["しかし"],["あなた"],["がた"],["は"],["この"],["事","こと"],["を"],["なされた"],["者","もの"],["を"],["仰ぎ","あおぎ"],["望まず","のぞまず"],["、"],["この"],["事","こと"],["を"],["昔","むかし"],["から"],["計画","けいかく"],["された"],["者","もの"],["を"],["顧なかった","かえりみなかった"],["。"]]},{"verse":12,"text":"その日,ひ、万軍,ばんぐんの神,かみ、主,しゅは泣,なき悲,かなしみ、頭,あたまをかぶろにし、荒布,あらぬのをまとうことを命,めいじられたが、","tok":[["その"],["日","ひ"],["、"],["万","まん"],["軍","ぐん"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["泣","なき"],["悲しみ","かなしみ"],["、"],["頭","あたま"],["を"],["かぶろ"],["に"],["し"],["、"],["荒布","あらぬ"],["の"],["を"],["まとう"],["こと"],["を"],["命じられた","めいじられた"],["が"],["、"]]},{"verse":13,"text":"見,みよ、あなたがたは喜,よろこび楽,たのしみ、牛,うしをほふり、羊,ひつじを殺,ころし、肉,にくを食,くい、酒,さけを飲,のんで言,いう、「われわれは食,くい、かつ飲,のもう、明日,みょうにちは死,しぬのだから」。","tok":[["見よ","みよ"],["、"],["あなた"],["がた"],["は"],["喜こび","よろこび"],["楽み","たのしみ"],["、"],["牛","うし"],["を"],["ほふり"],["、"],["羊","ひつじ"],["を"],["殺ろし","ころし"],["、"],["肉","にく"],["を"],["食い","くい"],["、"],["酒","さけ"],["を"],["飲んで","のんで"],["言う","いう"],["、"],["「"],["われわれ"],["は"],["食い","くい"],["、"],["かつ"],["飲もう","のもう"],["、"],["明日","みょうにち"],["は"],["死ぬ","しぬ"],["の"],["だ"],["から"],["」"],["。"]]},{"verse":14,"text":"万軍,ばんぐんの主,しゅはみずからわたしの耳,みみに示,しめされた、「まことに、この不義,ふぎはあなたがたが死,しぬまで、ゆるされることはない」と万軍,ばんぐんの神,かみ、主,しゅは言,いわれる。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["みずから"],["わたし"],["の"],["耳","みみ"],["に"],["示めされた","しめされた"],["、"],["「"],["まこと"],["に"],["、"],["この"],["不義","ふぎ"],["は"],["あなた"],["がた"],["が"],["死ぬ","しぬ"],["まで"],["、"],["ゆるされる"],["こと"],["は"],["ない"],["」"],["と"],["万","まん"],["軍","ぐん"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":15,"text":"万軍,ばんぐんの神,かみ、主,しゅはこう言,いわれる、「さあ、王,おうの家,いえをつかさどるこの執事,しつじセブナに行,いって言,いいなさい、","tok":[["万","まん"],["軍","ぐん"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["「"],["さあ"],["、"],["王","おう"],["の"],["家","いえ"],["を"],["つかさどる"],["この"],["執事","しつじ"],["セブナ"],["に"],["行って","いって"],["言い","いい"],["なさい"],["、"]]},{"verse":16,"text":"『あなたはここになんの係,かかわりがありますか。あなたはだれの縁故,えんこでここに自分,じぶんのために墓,はかを掘,ほったのですか。あなたは高,たかい所,ところに墓,はかを掘,ほり、岩,いわをうがって自分,じぶんのためにすみかを造,つくった。","tok":[["『"],["あなた"],["は"],["ここ"],["に"],["なん"],["の"],["係わり","かかわり"],["が"],["あります"],["か"],["。"],["あなた"],["は"],["だれ"],["の"],["縁故","えんこ"],["で"],["ここ"],["に"],["自分","じぶん"],["の"],["ため"],["に"],["墓","はか"],["を"],["掘った","ほった"],["の"],["です"],["か"],["。"],["あなた"],["は"],["高かい","たかい"],["所","ところ"],["に"],["墓","はか"],["を"],["掘","ほり"],["、"],["岩","いわ"],["を"],["うがって"],["自分","じぶん"],["の"],["ため"],["に"],["すみか"],["を"],["造った","つくった"],["。"]]},{"verse":17,"text":"強,つよい人,ひとよ、見,みよ、主,しゅはあなたを激,はげしくなげ倒,たおされる。主,しゅはあなたを堅,かたくつかまえ、","tok":[["強い","つよい"],["人","ひと"],["よ"],["、"],["見よ","みよ"],["、"],["主","しゅ"],["は"],["あなた"],["を"],["激しく","はげしく"],["な"],["げ"],["倒される","たおされる"],["。"],["主","しゅ"],["は"],["あなた"],["を"],["堅く","かたく"],["つかまえ"],["、"]]},{"verse":18,"text":"ぐるぐるまわして、まりのように広々,ひろびろした地,ちに投,なげられる。主人,しゅじんの家,いえの恥,はじとなる者,ものよ、あなたはそこで死,しに、あなたの華麗,かれいな車,くるまはそこに残,のこる。","tok":[["ぐるぐる"],["まわして"],["、"],["まり"],["の"],["よう"],["に"],["広々","ひろびろ"],["した"],["地","ち"],["に"],["投られる","なげられる"],["。"],["主人","しゅじん"],["の"],["家","いえ"],["の"],["恥","はじ"],["と"],["なる"],["者","もの"],["よ"],["、"],["あなた"],["は"],["そこ"],["で"],["死に","しに"],["、"],["あなた"],["の"],["華麗","かれい"],["な"],["車","くるま"],["は"],["そこ"],["に"],["残る","のこる"],["。"]]},{"verse":19,"text":"わたしは、あなたをその職,しょくから追,おい、その地位,ちいから引,ひきおろす。","tok":[["わたし"],["は"],["、"],["あなた"],["を"],["その"],["職","しょく"],["から"],["追い","おい"],["、"],["その"],["地位","ちい"],["から"],["引","ひき"],["おろす"],["。"]]},{"verse":20,"text":"その日,ひ、わたしは、わがしもべヒルキヤの子,こエリアキムを呼,よんで、","tok":[["その"],["日","ひ"],["、"],["わたし"],["は"],["、"],["わが"],["しもべ"],["ヒルキヤ"],["の"],["子","こ"],["エリアキム"],["を"],["呼んで","よんで"],["、"]]},{"verse":21,"text":"あなたの衣,ころもを着,きせ、あなたの帯,おびをしめさせ、あなたの権力,けんりょくを彼,かれの手,てにゆだねる。彼,かれはエルサレムの民,たみとユダの家,いえとの父,ちちとなる。","tok":[["あなた"],["の"],["衣","ころも"],["を"],["着せ","きせ"],["、"],["あなた"],["の"],["帯","おび"],["を"],["しめさせ"],["、"],["あなた"],["の"],["権力","けんりょく"],["を"],["彼","かれ"],["の"],["手","て"],["に"],["ゆだねる"],["。"],["彼","かれ"],["は"],["エルサレム"],["の"],["民","たみ"],["と"],["ユダ"],["の"],["家","いえ"],["と"],["の"],["父","ちち"],["と"],["なる"],["。"]]},{"verse":22,"text":"わたしはまたダビデの家,いえのかぎを彼,かれの肩,かたに置,おく。彼,かれが開,ひらけば閉,とじる者,ものなく、彼,かれが閉,とじれば開,ひらく者,ものはない。","tok":[["わたし"],["は"],["また"],["ダビデ"],["の"],["家","いえ"],["の"],["かぎ"],["を"],["彼","かれ"],["の"],["肩","かた"],["に"],["置く","おく"],["。"],["彼","かれ"],["が"],["開ば","ひらけば"],["閉じる","とじる"],["者","もの"],["なく"],["、"],["彼","かれ"],["が"],["閉じれば","とじれば"],["開らく","ひらく"],["者","もの"],["は"],["ない"],["。"]]},{"verse":23,"text":"わたしは彼,かれを堅,かたい所,ところに打,うったくぎのようにする。そして彼,かれはその父,ちちの家,いえの誉,ほまれの座,ざとなり、","tok":[["わたし"],["は"],["彼","かれ"],["を"],["堅い","かたい"],["所","ところ"],["に"],["打った","うった"],["くぎ"],["の"],["よう"],["に"],["する"],["。"],["そして"],["彼","かれ"],["は"],["その"],["父","ちち"],["の"],["家","いえ"],["の"],["誉","ほまれ"],["の"],["座","ざ"],["と"],["なり"],["、"]]},{"verse":24,"text":"その父,ちちの家,いえのすべての重,おもさは彼,かれの上,うえにかかる。すなわちその子,こ、その孫,まごおよびすべての小,ちいさい器,うつわ、鉢,はちからすべてのびんにいたるまでみな、彼,かれの上,うえにかかる』」。","tok":[["その"],["父","ちち"],["の"],["家","いえ"],["の"],["すべて"],["の"],["重さ","おもさ"],["は"],["彼","かれ"],["の"],["上","うえ"],["に"],["かかる"],["。"],["すなわち"],["その"],["子","こ"],["、"],["その"],["孫","まご"],["および"],["すべて"],["の"],["小さい","ちいさい"],["器","うつわ"],["、"],["鉢","はちか"],["ら"],["すべて"],["の"],["びん"],["に"],["いたる"],["まで"],["みな"],["、"],["彼","かれ"],["の"],["上","うえ"],["に"],["かかる"],["』"],["」"],["。"]]},{"verse":25,"text":"万軍,ばんぐんの主,しゅは言,いわれる、「その日,ひ、堅,かたい所,ところに打,うったくぎは抜,ぬけ、切,きられて落,おちる。その上,うえにかかっている荷,にもまた取,とり去,さられる」と主,しゅは語,かたられた。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["言われる","いわれる"],["、"],["「"],["その"],["日","ひ"],["、"],["堅い","かたい"],["所","ところ"],["に"],["打った","うった"],["くぎ"],["は"],["抜","ぬけ"],["、"],["切られて","きられて"],["落","おち"],["る"],["。"],["その"],["上","うえ"],["に"],["かかって"],["いる"],["荷","に"],["も"],["また"],["取去られる","とりさられる"],["」"],["と"],["主","しゅ"],["は"],["語られた","かたられた"],["。"]]}]
[{"verse":1,"text":"「このエドムから来,くる者,もの、深紅,しんくの衣,ころもを着,きて、ボズラから来,くる者,ものはだれか。その装,よそおいは、はなやかに、大,おおいなる力,ちからをもって進,すすみ来,くる者,ものはだれか」。「義,ぎをもって語,かたり、救,すくいを施,ほどこす力,ちからあるわたしがそれだ」。","tok":[["「"],["この"],["エドム"],["から"],["来る","くる"],["者","もの"],["、"],["深紅","しんく"],["の"],["衣","ころも"],["を"],["着て","きて"],["、"],["ボズラ"],["から"],["来る","くる"],["者","もの"],["は"],["だれ"],["か"],["。"],["その"],["装い","よそおい"],["は"],["、"],["はなやか"],["に"],["、"],["大いなる","おおいなる"],["力","ちから"],["を"],["もって"],["進み","すすみ"],["来る","くる"],["者","もの"],["は"],["だれ"],["か"],["」"],["。"],["「"],["義","ぎ"],["を"],["もって"],["語り","かたり"],["、"],["救い","すくい"],["を"],["施す","ほどこす"],["力","ちから"],["ある"],["わたし"],["が"],["それ"],["だ"],["」"],["。"]]},{"verse":2,"text":"「何,なにゆえあなたの装,よそおいは赤,あかく、あなたの衣,ころもは酒,さかぶねを踏,ふむ者,もののように赤,あかいのか」。","tok":[["「"],["何ゆえ","なにゆえ"],["あなた"],["の"],["装い","よそおい"],["は"],["赤く","あかく"],["、"],["あなた"],["の"],["衣","ころも"],["は"],["酒","さか"],["ぶね"],["を"],["踏む","ふむ"],["者","もの"],["の"],["よう"],["に"],["赤い","あかい"],["の"],["か"],["」"],["。"]]},{"verse":3,"text":"「わたしはひとりで酒,さかぶねを踏,ふんだ。もろもろの民,たみのなかに、わたしと事,ことを共,ともにする者,ものはなかった。わたしは怒,いかりによって彼,かれらを踏,ふみ、憤,いきどおりによって彼,かれらを踏,ふみにじったので、彼,かれらの血,ちがわが衣,ころもにふりかかり、わが装,よそおいをことごとく汚,けがした。","tok":[["「"],["わたし"],["は"],["ひとり"],["で"],["酒","さかぶね"],["を"],["踏んだ","ふんだ"],["。"],["もろもろ"],["の"],["民","たみ"],["の"],["なか"],["に"],["、"],["わたし"],["と"],["事","こと"],["を"],["共","とも"],["に"],["する"],["者","もの"],["は"],["なかった"],["。"],["わたし"],["は"],["怒り","いかり"],["によって"],["彼","かれ"],["ら"],["を"],["踏み","ふみ"],["、"],["憤り","いきどおり"],["によって"],["彼","かれ"],["ら"],["を"],["踏みにじった","ふみにじった"],["ので"],["、"],["彼","かれ"],["ら"],["の"],["血","ち"],["が"],["わが"],["衣","ころも"],["に"],["ふりかかり"],["、"],["わが"],["装い","よそおい"],["を"],["ことごとく"],["汚","け"],["がした"],["。"]]},{"verse":4,"text":"報復,ほうふくの日,ひがわが心,こころのうちにあり、わがあがないの年,としが来,きたからである。","tok":[["報復","ほうふく"],["の"],["日","ひ"],["が"],["わが"],["心","こころ"],["の"],["うち"],["に"],["あり"],["、"],["わが"],["あ"],["が"],["ない"],["の"],["年","とし"],["が"],["来た","きた"],["から"],["で"],["ある"],["。"]]},{"verse":5,"text":"わたしは見,みたけれども、助,たすける者,ものはなく、怪,あやしんだけれども、ささえる者,ものはなかった。それゆえ、わがかいながわたしを勝,かたせ、わが憤,いきどおりがわたしをささえた。","tok":[["わたし"],["は"],["見た","みた"],["けれど"],["も"],["、"],["助ける","たすける"],["者","もの"],["は"],["なく"],["、"],["怪しんだ","あやしんだ"],["けれど"],["も"],["、"],["ささえる"],["者","もの"],["は"],["なかった"],["。"],["それ"],["ゆえ"],["、"],["わが"],["かいな"],["が"],["わたし"],["を"],["勝たせ","かたせ"],["、"],["わが"],["憤り","いきどおり"],["が"],["わたし"],["を"],["ささえた"],["。"]]},{"verse":6,"text":"わたしは怒,いかりによって、もろもろの民,たみを踏,ふみにじり、憤,いきどおりによって彼,かれらを酔,よわせ、彼,かれらの血,ちを、地,ちに流,ながれさせた」。","tok":[["わたし"],["は"],["怒り","いかり"],["によって"],["、"],["もろもろ"],["の"],["民","たみ"],["を"],["踏みにじり","ふみにじり"],["、"],["憤り","いきどおり"],["によって"],["彼","かれ"],["ら"],["を"],["酔わせ","よわせ"],["、"],["彼","かれ"],["ら"],["の"],["血","ち"],["を"],["、"],["地","ち"],["に"],["流れさせた","ながれさせた"],["」"],["。"]]},{"verse":7,"text":"わたしは主,しゅがわれわれになされたすべてのことによって、主,しゅのいつくしみと、主,しゅの誉,ほまれとを語,かたり告,つげ、また、そのあわれみにより、その多,おおくのいつくしみによって、イスラエルの家,いえに施,ほどこされたその大,おおいなる恵,めぐみを語,かたり告,つげよう。","tok":[["わたし"],["は"],["主","しゅ"],["が"],["われわれ"],["に"],["なされた"],["すべて"],["の"],["こと"],["によって"],["、"],["主","しゅ"],["の"],["いつくしみ"],["と"],["、"],["主","しゅ"],["の"],["誉","ほまれ"],["と"],["を"],["語り","かたり"],["告","つげ"],["、"],["また"],["、"],["その"],["あわれみ"],["に"],["より"],["、"],["その"],["多く","おおく"],["の"],["いつくしみ"],["によって"],["、"],["イスラエル"],["の"],["家","いえ"],["に"],["施された","ほどこされた"],["その"],["大いなる","おおいなる"],["恵","めぐみ"],["を"],["語り","かたり"],["告","つげ"],["よう"],["。"]]},{"verse":8,"text":"主,しゅは言,いわれた、「まことに彼,かれらはわが民,たみ、偽,いつわりのない子,こらである」と。そして主,しゅは彼,かれらの救主,すくいぬしとなられた。","tok":[["主","しゅ"],["は"],["言われた","いわれた"],["、"],["「"],["まこと"],["に"],["彼","かれ"],["ら"],["は"],["わが"],["民","た"],["み"],["、"],["偽わり","いつわり"],["の"],["ない"],["子","こ"],["ら"],["で"],["ある"],["」"],["と"],["。"],["そして"],["主","しゅ"],["は"],["彼","かれ"],["ら"],["の"],["救主","すくいぬし"],["と"],["なられた"],["。"]]},{"verse":9,"text":"彼,かれらのすべての悩,なやみのとき、主,しゅも悩,なやまれて、そのみ前,まえの使,つかいをもって彼,かれらを救,すくい、その愛,あいとあわれみとによって彼,かれらをあがない、いにしえの日,ひ、つねに彼,かれらをもたげ、彼,かれらを携,たずさえられた。","tok":[["彼","かれ"],["ら"],["の"],["すべて"],["の"],["悩み","なやみ"],["の"],["とき"],["、"],["主","しゅ"],["も"],["悩まれて","なやまれて"],["、"],["その"],["み前","みまえ"],["の"],["使","つかい"],["を"],["もって"],["彼","かれ"],["ら"],["を"],["救い","すくい"],["、"],["その"],["愛","あい"],["と"],["あわれみ"],["と"],["によって"],["彼","かれ"],["ら"],["を"],["あがない"],["、"],["いにしえ"],["の"],["日","ひ"],["、"],["つね"],["に"],["彼","かれ"],["ら"],["を"],["もたげ"],["、"],["彼","かれ"],["ら"],["を"],["携えられた","たずさえられた"],["。"]]},{"verse":10,"text":"ところが彼,かれらはそむいてその聖,せいなる霊,れいを憂,うれえさせたので、主,しゅはひるがえって彼,かれらの敵,てきとなり、みずから彼,かれらと戦,たたかわれた。","tok":[["ところ"],["が"],["彼","かれ"],["ら"],["は"],["そむいて"],["その"],["聖","せい"],["なる"],["霊","れい"],["を"],["憂えさせた","うれえさせた"],["ので"],["、"],["主","しゅ"],["は"],["ひるがえって"],["彼","かれ"],["ら"],["の"],["敵","てき"],["と"],["なり"],["、"],["みずから"],["彼","かれ"],["ら"],["と"],["戦われた","たたかわれた"],["。"]]},{"verse":11,"text":"その時,とき、民,たみはいにしえのモーセの日,ひを思,おもい出,だして言,いった、「その群,むれの牧者,ぼくしゃを、海,うみから携,たずさえあげた者,ものはどこにいるか。彼,かれらの中,なかに聖,せいなる霊,れいをおいた者,ものはどこにいるか。","tok":[["その"],["時","とき"],["、"],["民","たみ"],["は"],["いにしえ"],["の"],["モーセ"],["の"],["日","ひ"],["を"],["思い出して","おもいだして"],["言った","いった"],["、"],["「"],["その"],["群れ","むれ"],["の"],["牧者","ぼくしゃ"],["を"],["、"],["海","うみ"],["から"],["携え","たずさえ"],["あげた"],["者","もの"],["は"],["どこ"],["に"],["いる"],["か"],["。"],["彼","かれ"],["ら"],["の"],["中","なか"],["に"],["聖","せい"],["なる"],["霊","れい"],["を"],["おいた"],["者","もの"],["は"],["どこ"],["に"],["いる"],["か"],["。"]]},{"verse":12,"text":"栄光,えいこうのかいなをモーセの右,みぎに行,いかせ、彼,かれらの前,まえに水,みずを二つに分,わけて、みずから、とこしえの名,なをつくり、","tok":[["栄光","えいこう"],["の"],["かいな"],["を"],["モーセ"],["の"],["右","みぎ"],["に"],["行かせ","いかせ"],["、"],["彼","かれ"],["ら"],["の"],["前","まえ"],["に"],["水","みず"],["を"],["二","ふた"],["つ"],["に"],["分けて","わけて"],["、"],["みずから"],["、"],["とこしえ"],["の"],["名","な"],["を"],["つくり"],["、"]]},{"verse":13,"text":"彼,かれらを導,みちびいて、馬,うまが野,のを走,はしるように、つまずくことなく淵,ふちを通,とおらせた者,ものはどこにいるか。","tok":[["彼","かれ"],["ら"],["を"],["導いて","みちびいて"],["、"],["馬","うま"],["が"],["野","の"],["を"],["走る","はしる"],["よう"],["に"],["、"],["つまずく"],["こと"],["なく"],["淵","ふち"],["を"],["通らせた","とおらせた"],["者","もの"],["は"],["どこ"],["に"],["いる"],["か"],["。"]]},{"verse":14,"text":"谷,たににくだる家畜,かちくのように、主,しゅの霊,れいは彼,かれらをいこわせられた。このように、あなたはおのれの民,たみを導,みちびいてみずから栄光,えいこうの名,なをつくられた」。","tok":[["谷","たに"],["に"],["くだる"],["家畜","かちく"],["の"],["よう"],["に"],["、"],["主","しゅ"],["の"],["霊","れい"],["は"],["彼","かれ"],["ら"],["を"],["いこわせられた"],["。"],["この"],["よう"],["に"],["、"],["あなた"],["は"],["おのれ"],["の"],["民","たみ"],["を"],["導いて","みちびいて"],["みずから"],["栄光","えいこう"],["の"],["名","な"],["を"],["つくられた"],["」"],["。"]]},{"verse":15,"text":"どうか、天,てんから見,みおろし、その聖,せいなる栄光,えいこうあるすみかからごらんください。あなたの熱心,ねっしんと、大能,たいのうとはどこにありますか。あなたのせつなる同情,どうじょうとあわれみとはおさえられて、わたしにあらわれません。","tok":[["どう"],["か"],["、"],["天","てん"],["から"],["見おろし","みおろし"],["、"],["その"],["聖","せい"],["なる"],["栄光","えいこう"],["ある"],["すみか"],["から"],["ごらん"],["ください"],["。"],["あなた"],["の"],["熱心","ねっしん"],["と"],["、"],["大能","たいのうと"],["は"],["どこ"],["に"],["あります"],["か"],["。"],["あなた"],["の"],["せつ"],["なる"],["同情","どうじょう"],["と"],["あわれみ"],["と"],["は"],["おさえられて"],["、"],["わたし"],["に"],["あらわれません"],["。"]]},{"verse":16,"text":"たといアブラハムがわれわれを知,しらず、イスラエルがわれわれを認,みとめなくても、あなたはわれわれの父,ちちです。主,しゅよ、あなたはわれわれの父,ちち、いにしえからあなたの名,なはわれわれのあながい主,しゅです。","tok":[["たとい"],["アブラハム"],["が"],["われわれ"],["を"],["知らず","しらず"],["、"],["イスラエル"],["が"],["われわれ"],["を"],["認めなくて","みとめなくて"],["も"],["、"],["あなた"],["は"],["われわれ"],["の"],["父","ちち"],["です"],["。"],["主","しゅ"],["よ"],["、"],["あなた"],["は"],["われわれ"],["の"],["父","ちち"],["、"],["いにしえ"],["から"],["あなた"],["の"],["名","な"],["は"],["われわれ"],["の"],["あ"],["ながい"],["主","しゅ"],["です"],["。"]]},{"verse":17,"text":"主,しゅよ、なぜ、われわれをあなたの道,みちから離,はなれ迷,まよわせ、われわれの心,こころをかたくなにして、あなたを恐,おそれないようにされるのですか。どうぞ、あなたのしもべらのために、あなたの嗣,し業,ぎょうである部族,ぶぞくらのために、お帰,かえりください。","tok":[["主","しゅ"],["よ"],["、"],["なぜ"],["、"],["われわれ"],["を"],["あなた"],["の"],["道","みち"],["から"],["離れ","はなれ"],["迷わせ","まよわせ"],["、"],["われわれ"],["の"],["心","こころ"],["を"],["かたくな"],["に"],["して"],["、"],["あなた"],["を"],["恐れない","おそれない"],["よう"],["に"],["される"],["の"],["です"],["か"],["。"],["どうぞ"],["、"],["あなた"],["の"],["しもべ"],["ら"],["の"],["ため"],["に"],["、"],["あなた"],["の"],["嗣業","しぎょ"],["うで"],["ある"],["部族","ぶぞく"],["ら"],["の"],["ため"],["に"],["、"],["お帰えり","おかえり"],["ください"],["。"]]},{"verse":18,"text":"あなたの聖,せいなる民,たみが、あなたの聖所,せいじょを獲,えて間,あいだもないのに、われわれのあだは、それを踏,ふみにじりました。","tok":[["あなた"],["の"],["聖","せい"],["なる"],["民","たみ"],["が"],["、"],["あなた"],["の"],["聖","せい"],["所","しょ"],["を"],["獲て","えて"],["間","あいだ"],["も"],["ない"],["のに"],["、"],["われわれ"],["の"],["あだ"],["は"],["、"],["それ"],["を"],["踏みにじりました","ふみにじりました"],["。"]]},{"verse":19,"text":"われわれはあなたによって、いにしえから治,おさめられない者,もののようになり、あなたの名,なをもって、となえられない者,もののようになりました。[64:1]どうか、あなたが天,てんを裂,さいて下,くだり、あなたの前,まえに山々,やまやまが震,ふるい動,うごくように。","tok":[["われわれ"],["は"],["あなた"],["によって"],["、"],["いにしえ"],["から"],["治められない","おさめられない"],["者","もの"],["の"],["よう"],["に"],["なり"],["、"],["あなた"],["の"],["名","な"],["を"],["もって"],["、"],["となえられない"],["者","もの"],["の"],["よう"],["に"],["なりました"],["。"],["["],["64"],[":"],["1"],["]"],["どう"],["か"],["、"],["あなた"],["が"],["天","てん"],["を"],["裂いて","さいて"],["下り","くだり"],["、"],["あなた"],["の"],["前","まえ"],["に"],["山々","やまやま"],["が"],["震い","ふるい"],["動く","うごく"],["よう"],["に"],["。"]]}]
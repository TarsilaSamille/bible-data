[{"verse":1,"text":"わたしはわたしを求,もとめなかった者,ものに問,とわれることを喜,よろこび、わたしを尋,たずねなかった者,ものに見,みいだされることを喜,よろこんだ。わたしはわが名,なを呼,よばなかった国民,こくみんに言,いった、「わたしはここにいる、わたしはここにいる」と。","tok":[["わたし"],["は"],["わたし"],["を"],["求めなかった","もとめなかった"],["者","もの"],["に"],["問われる","とわれる"],["こと"],["を"],["喜こび","よろこび"],["、"],["わたし"],["を"],["尋ねなかった","たずねなかった"],["者","もの"],["に"],["見いだされる","みいだされる"],["こと"],["を"],["喜こんだ","よろこんだ"],["。"],["わたし"],["は"],["わが"],["名","な"],["を"],["呼ばなかった","よばなかった"],["国民","こくみん"],["に"],["言った","いった"],["、"],["「"],["わたし"],["は"],["ここ"],["に"],["いる"],["、"],["わたし"],["は"],["ここ"],["に"],["いる"],["」"],["と"],["。"]]},{"verse":2,"text":"よからぬ道,みちに歩,あゆみ、自分,じぶんの思,おもいに従,したがうそむける民,たみに、わたしはひねもす手,てを伸,のべて招,まねいた。","tok":[["よからぬ"],["道","みち"],["に"],["歩み","あゆみ"],["、"],["自分","じぶん"],["の"],["思い","おもい"],["に"],["従う","したがう"],["そむける"],["民","たみ"],["に"],["、"],["わたし"],["は"],["ひねもす"],["手","て"],["を"],["伸べて","のべて"],["招いた","まねいた"],["。"]]},{"verse":3,"text":"この民,たみはまのあたり常,つねにわたしを怒,いからせ、園,そのの中,なかで犠牲,ぎせいをささげ、かわらの上,うえで香,こうをたき、","tok":[["この"],["民","たみはま"],["の"],["あたり"],["常","つね"],["に"],["わたし"],["を"],["怒らせ","いからせ"],["、"],["園","その"],["の"],["中","なか"],["で"],["犠牲","ぎせい"],["を"],["ささげ"],["、"],["かわら"],["の"],["上","うえ"],["で"],["香","こう"],["を"],["たき"],["、"]]},{"verse":4,"text":"墓場,はかばにすわり、ひそかな所,ところにやどり、豚,ぶたの肉,にくを食,くらい、憎,にくむべき物,ものの、あつものをその器,うつわに盛,もって、","tok":[["墓場","はかば"],["に"],["すわり"],["、"],["ひそか"],["な"],["所","ところ"],["に"],["やどり"],["、"],["豚","ぶた"],["の"],["肉","にく"],["を"],["食らい","くらい"],["、"],["憎むべき","にくむべき"],["物","もの"],["の"],["、"],["あつもの"],["を"],["その"],["器","うつわ"],["に"],["盛って","もって"],["、"]]},{"verse":5,"text":"言,いう、「あなたはそこに立,たって、わたしに近,ちかづいてはならない。わたしはあなたと区別,くべつされたものだから」と。これらはわが鼻,はなの煙,けむり、ひねもす燃,もえる火,ひである。","tok":[["言う","いう"],["、"],["「"],["あなた"],["は"],["そこ"],["に"],["立って","たって"],["、"],["わたし"],["に"],["近づいて","ちかづいて"],["は"],["ならない"],["。"],["わたし"],["は"],["あなた"],["と"],["区別","くべつ"],["された"],["もの"],["だ"],["から"],["」"],["と"],["。"],["これ"],["ら"],["は"],["わが"],["鼻","はな"],["の"],["煙","けむり"],["、"],["ひねもす"],["燃える","もえる"],["火","ひ"],["で"],["ある"],["。"]]},{"verse":6,"text":"見,みよ、この事,ことはわが前,まえにしるされた、「わたしは黙,だまっていないで報,むくい返,かえす。そうだ、わたしは彼,かれらのふところに、","tok":[["見よ","みよ"],["、"],["この"],["事","こと"],["は"],["わが"],["前","まえ"],["に"],["しるされた"],["、"],["「"],["わたし"],["は"],["黙って","だまって"],["いないで"],["報い","むくい"],["返えす","かえす"],["。"],["そう"],["だ"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["ふところ"],["に"],["、"]]},{"verse":7,"text":"彼,かれらの不義,ふぎと、彼,かれらの先祖,せんぞたちの不義,ふぎとを共,ともに報,むくい返,かえす。彼,かれらが山,やまの上,うえで香,こうをたき、丘,おかの上,うえでわたしをそしったゆえ、わたしは彼,かれらのさきのわざを量,はかって、そのふところに返,かえす」と主,しゅは言,いわれる。","tok":[["彼","かれ"],["ら"],["の"],["不義","ふぎ"],["と"],["、"],["彼","かれ"],["ら"],["の"],["先祖","せんぞ"],["たち"],["の"],["不義","ふぎ"],["と"],["を"],["共","とも"],["に"],["報い","むくい"],["返えす","かえす"],["。"],["彼","かれ"],["ら"],["が"],["山","やま"],["の"],["上","うえ"],["で"],["香","こう"],["を"],["たき"],["、"],["丘","おか"],["の"],["上","うえ"],["で"],["わたし"],["を"],["そしった"],["ゆえ"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["さき"],["の"],["わざ"],["を"],["量って","はかって"],["、"],["その"],["ふところ"],["に"],["返えす","かえす"],["」"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":8,"text":"主,しゅはこう言,いわれる、「人,ひとがぶどうのふさの中,なかに、ぶどうのしるのあるのを見,みるならば、『それを破,やぶるな、その中,なかに祝福,しゅくふくがあるから』と言,いう。そのようにわたしは、わがしもべらのために行,いって、ことごとくは滅,ほろぼさない。","tok":[["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["「"],["人","ひと"],["が"],["ぶどう"],["の"],["ふさ"],["の"],["中","なか"],["に"],["、"],["ぶどう"],["の"],["しる"],["の"],["ある"],["の"],["を"],["見るならば","みるならば"],["、"],["『"],["それ"],["を"],["破る","やぶる"],["な"],["、"],["その"],["中","なか"],["に"],["祝福","しゅくふく"],["が"],["ある"],["から"],["』"],["と"],["言う","いう"],["。"],["その"],["よう"],["に"],["わたし"],["は"],["、"],["わが"],["しもべ"],["ら"],["の"],["ため"],["に"],["行って","いって"],["、"],["ことごとく"],["は"],["滅ぼさない","ほろぼさない"],["。"]]},{"verse":9,"text":"わたしはヤコブから子孫,しそんをいだし、ユダからわが山々,やまやまを受,うけつぐべき者,ものをいだす。わたしが選,えらんだ者,ものはこれを受,うけつぎ、わがしもべらはそこに住,すむ。","tok":[["わたし"],["は"],["ヤコブ"],["から"],["子孫","しそん"],["を"],["いだし"],["、"],["ユダ"],["から"],["わが"],["山々","やまやま"],["を"],["受","うけ"],["つぐべき"],["者","もの"],["を"],["いだす"],["。"],["わたし"],["が"],["選らんだ","えらんだ"],["者","もの"],["は"],["これ"],["を"],["受","うけ"],["つぎ"],["、"],["わが"],["しもべ"],["ら"],["は"],["そこ"],["に"],["住む","すむ"],["。"]]},{"verse":10,"text":"シャロンは羊,ひつじの群,むれの牧場,まきばとなり、アコルの谷,たには牛,うしの群,むれの伏,ふす所,ところとなって、わたしを尋,たずね求,もとめたわが民,たみのものとなる。","tok":[["シャロン"],["は"],["羊","ひつじ"],["の"],["群れ","むれ"],["の"],["牧場","ま"],["きば"],["と"],["なり"],["、"],["アコル"],["の"],["谷","たに"],["は"],["牛","うし"],["の"],["群れ","むれ"],["の"],["伏す","ふす"],["所","ところ"],["と"],["なって"],["、"],["わたし"],["を"],["尋ね求めた","たずねもとめた"],["わが"],["民","たみ"],["の"],["もの"],["と"],["なる"],["。"]]},{"verse":11,"text":"しかし主,しゅを捨,すて、わが聖,せいなる山,やまを忘,わすれ、机,つくえを禍福,かふくの神,かみに供,そなえ、混,まぜ合,あわせた酒,さけを盛,もって運命,うんめいの神,かみにささげるあなたがたよ、","tok":[["しかし"],["主","しゅ"],["を"],["捨て","すて"],["、"],["わが"],["聖","せい"],["なる"],["山","やま"],["を"],["忘","わすれ"],["、"],["机","つくえ"],["を"],["禍福","かふく"],["の"],["神","かみ"],["に"],["供え","そなえ"],["、"],["混ぜ","まぜ"],["合","あわせ"],["た"],["酒","さけ"],["を"],["盛って","もって"],["運命","うんめい"],["の"],["神","かみ"],["に"],["ささげる"],["あなた"],["がた"],["よ"],["、"]]},{"verse":12,"text":"わたしは、あなたがたをつるぎに渡,わたすことに定,さだめた。あなたがたは皆,みなかがんでほふられる。あなたがたはわたしが呼,よんだときに答,こたえず、わたしが語,かたったときに聞,きかず、わたしの目,めに悪,わるい事,ことをおこない、わたしの好,このまなかった事,ことを選,えらんだからだ」。","tok":[["わたし"],["は"],["、"],["あなた"],["がた"],["を"],["つるぎ"],["に"],["渡す","わたす"],["こと"],["に"],["定めた","さだめた"],["。"],["あなた"],["がた"],["は"],["皆","みな"],["か"],["がん"],["で"],["ほふられる"],["。"],["あなた"],["がた"],["は"],["わたし"],["が"],["呼","よんだとき"],["に"],["答","こたえ"],["ず"],["、"],["わたし"],["が"],["語った","かたった"],["とき"],["に"],["聞かず","きかず"],["、"],["わたし"],["の"],["目","め"],["に"],["悪い","わるい"],["事","こと"],["を"],["おこない"],["、"],["わたし"],["の"],["好まなかった","このまなかった"],["事","こと"],["を"],["選らんだ","えらんだ"],["から"],["だ"],["」"],["。"]]},{"verse":13,"text":"それゆえ、主,しゅなる神,かみはこう言,いわれる、「見,みよ、わがしもべたちは食,たべる、しかし、あなたがたは飢,うえる。見,みよ、わがしもべたちは飲,のむ、しかし、あなたがたはかわく。見,みよ、わがしもべたちは喜,よろこぶ、しかし、あなたがたは恥,はじる。","tok":[["それ"],["ゆえ"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["「"],["見よ","みよ"],["、"],["わが"],["しもべ"],["たち"],["は"],["食べる","たべる"],["、"],["しかし"],["、"],["あなた"],["がた"],["は"],["飢","うえ"],["る"],["。"],["見よ","みよ"],["、"],["わが"],["しもべ"],["たち"],["は"],["飲む","のむ"],["、"],["しかし"],["、"],["あなた"],["がた"],["は"],["かわく"],["。"],["見よ","みよ"],["、"],["わが"],["しもべ"],["たち"],["は"],["喜こぶ","よろこぶ"],["、"],["しかし"],["、"],["あなた"],["がた"],["は"],["恥","はじ"],["る"],["。"]]},{"verse":14,"text":"見,みよ、わがしもべたちは心,こころの楽,たのしみによって歌,うたう、しかし、あなたがたは心,こころの苦,くるしみによって叫,さけび、たましいの悩,なやみによって泣,なき叫,さけぶ。","tok":[["見よ","みよ"],["、"],["わが"],["しもべ"],["たち"],["は"],["心","こころ"],["の"],["楽み","たのしみ"],["によって"],["歌う","うたう"],["、"],["しかし"],["、"],["あなた"],["がた"],["は"],["心","こころ"],["の"],["苦しみ","くるしみ"],["によって"],["叫","さけび"],["、"],["たましい"],["の"],["悩み","なやみ"],["によって"],["泣","なき"],["叫けぶ","さけぶ"],["。"]]},{"verse":15,"text":"あなたがたの残,のこす名,なはわが選,えらんだ者,ものには、のろいの文句,もんくとなり、主,しゅなる神,かみはあなたがたを殺,ころされる。しかし、おのれのしもべたちを、ほかの名,なをもって呼,よばれる。","tok":[["あなた"],["がた"],["の"],["残す","のこす"],["名","な"],["は"],["わが"],["選らんだ","えらんだ"],["者","もの"],["に"],["は"],["、"],["のろい"],["の"],["文句","もんく"],["と"],["なり"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["あなた"],["がた"],["を"],["殺ろされる","ころされる"],["。"],["しかし"],["、"],["おのれ"],["の"],["しもべ"],["たち"],["を"],["、"],["ほか"],["の"],["名","な"],["を"],["もって"],["呼ばれる","よばれる"],["。"]]},{"verse":16,"text":"それゆえ、地,ちにあっておのれのために祝福,しゅくふくを求,もとめる者,ものは、真実,しんじつの神,かみによっておのれの祝福,しゅくふくを求,もとめ、地,ちにあって誓,ちかう者,ものは、真実,しんじつの神,かみをさして誓,ちかう。さきの悩,なやみは忘,わすれられて、わが目,めから隠,かくれうせるからである。","tok":[["それ"],["ゆえ"],["、"],["地","ち"],["に"],["あって"],["おのれ"],["の"],["ため"],["に"],["祝福","しゅくふく"],["を"],["求める","もとめる"],["者","もの"],["は"],["、"],["真実","しんじつ"],["の"],["神","かみ"],["によって"],["おのれ"],["の"],["祝福","しゅくふく"],["を"],["求め","もとめ"],["、"],["地","ち"],["に"],["あって"],["誓う","ちかう"],["者","もの"],["は"],["、"],["真実","しんじつ"],["の"],["神","かみ"],["を"],["さして"],["誓う","ちかう"],["。"],["さき"],["の"],["悩み","なやみ"],["は"],["忘られて","わすれられて"],["、"],["わが"],["目","め"],["から"],["隠れ","かくれ"],["うせる"],["から"],["で"],["ある"],["。"]]},{"verse":17,"text":"見,みよ、わたしは新,あたらしい天,てんと、新,あたらしい地,ちとを創造,そうぞうする。さきの事,ことはおぼえられることなく、心,こころに思,おもい起,おこすことはない。","tok":[["見よ","みよ"],["、"],["わたし"],["は"],["新らしい","あたらしい"],["天","てん"],["と"],["、"],["新らしい","あたらしい"],["地","ち"],["と"],["を"],["創造","そうぞう"],["する"],["。"],["さき"],["の"],["事","こと"],["は"],["おぼえられる"],["こと"],["なく"],["、"],["心","こころ"],["に"],["思い起こす","おもいおこす"],["こと"],["は"],["ない"],["。"]]},{"verse":18,"text":"しかし、あなたがたはわたしの創造,そうぞうするものにより、とこしえに楽,たのしみ、喜,よろこびを得,えよ。見,みよ、わたしはエルサレムを造,つくって喜,よろこびとし、その民,たみを楽,たのしみとする。","tok":[["しかし"],["、"],["あなた"],["がた"],["は"],["わたし"],["の"],["創造","そうぞう"],["する"],["もの"],["に"],["より"],["、"],["とこしえ"],["に"],["楽み","たのしみ"],["、"],["喜こび","よろこび"],["を"],["得","え"],["よ"],["。"],["見よ","みよ"],["、"],["わたし"],["は"],["エルサレム"],["を"],["造って","つくって"],["喜こび","よろこび"],["と"],["し"],["、"],["その"],["民","たみ"],["を"],["楽み","たのしみ"],["と"],["する"],["。"]]},{"verse":19,"text":"わたしはエルサレムを喜,よろこび、わが民,たみを楽,たのしむ。泣,なく声,こえと叫,さけぶ声,こえは再,ふたたびその中,なかに聞,きこえることはない。","tok":[["わたし"],["は"],["エルサレム"],["を"],["喜こび","よろこび"],["、"],["わが"],["民","たみ"],["を"],["楽しむ","たのしむ"],["。"],["泣く","なく"],["声","こえ"],["と"],["叫けぶ","さけぶ"],["声","こえ"],["は"],["再び","ふたたび"],["その"],["中","なか"],["に"],["聞こえる","きこえる"],["こと"],["は"],["ない"],["。"]]},{"verse":20,"text":"わずか数日,すうじつで死,しぬみどりごと、おのが命,いのちの日,ひを満,みたさない老人,ろうじんとは、もはやその中,なかにいない。百歳,さいで死,しぬ者,ものも、なお若,わかい者,ものとせられ、百歳,さいで死,しぬ者,ものは、のろわれた罪,つみびととされる。","tok":[["わずか"],["数日","すうじつ"],["で"],["死ぬ","しぬ"],["みどりご"],["と"],["、"],["お"],["の"],["が"],["命","いのち"],["の"],["日","ひ"],["を"],["満たさない","みたさない"],["老人","ろうじん"],["と"],["は"],["、"],["もはや"],["その"],["中","なか"],["に"],["いない"],["。"],["百歳","さ"],["いで"],["死ぬ","しぬ"],["者","もの"],["も"],["、"],["なお"],["若い","わかい"],["者","もの"],["と"],["せられ"],["、"],["百歳","さ"],["いで"],["死ぬ","しぬ"],["者","もの"],["は"],["、"],["のろわれた"],["罪びと","つみびと"],["と"],["される"],["。"]]},{"verse":21,"text":"彼,かれらは家,いえを建,たてて、それに住,すみ、ぶどう畑,はたけを作,つくって、その実,みを食,たべる。","tok":[["彼","かれ"],["ら"],["は"],["家","いえ"],["を"],["建てて","たてて"],["、"],["それ"],["に"],["住み","すみ"],["、"],["ぶどう"],["畑","はたけ"],["を"],["作って","つくって"],["、"],["その"],["実","み"],["を"],["食べる","たべる"],["。"]]},{"verse":22,"text":"彼,かれらが建,たてる所,ところに、ほかの人,ひとは住,すまず、彼,かれらが植,うえるものは、ほかの人,ひとが食,たべない。わが民,たみの命,いのちは、木,きの命,いのちのようになり、わが選,えらんだ者,ものは、その手,てのわざをながく楽,たのしむからである。","tok":[["彼","かれ"],["ら"],["が"],["建てる","たてる"],["所","ところ"],["に"],["、"],["ほか"],["の"],["人","ひと"],["は"],["住まず","すまず"],["、"],["彼","かれ"],["ら"],["が"],["植える","うえる"],["もの"],["は"],["、"],["ほか"],["の"],["人","ひと"],["が"],["食べない","たべない"],["。"],["わが"],["民","たみ"],["の"],["命","いのち"],["は"],["、"],["木","き"],["の"],["命","いのち"],["の"],["よう"],["に"],["なり"],["、"],["わが"],["選","え"],["らんだ"],["者","もの"],["は"],["、"],["その"],["手","て"],["の"],["わざ"],["を"],["ながく"],["楽しむ","たのしむ"],["から"],["で"],["ある"],["。"]]},{"verse":23,"text":"彼,かれらの勤労,きんろうはむだでなく、その生,うむところの子,こらは災,わざわいにかからない。彼,かれらは主,しゅに祝福,しゅくふくされた者,もののすえであって、その子,こらも彼,かれらと共,ともにおるからである。","tok":[["彼","かれ"],["ら"],["の"],["勤労","きんろう"],["は"],["むだ"],["で"],["なく"],["、"],["その"],["生む","うむ"],["ところ"],["の"],["子","こ"],["ら"],["は"],["災","わざわい"],["に"],["かからない"],["。"],["彼","かれ"],["ら"],["は"],["主に","しゅに"],["祝福","しゅくふく"],["された"],["者","もの"],["の"],["すえ"],["で"],["あって"],["、"],["その"],["子","こ"],["ら"],["も"],["彼","かれ"],["ら"],["と"],["共","とも"],["に"],["おる"],["から"],["で"],["ある"],["。"]]},{"verse":24,"text":"彼,かれらが呼,よばないさきに、わたしは答,こたえ、彼,かれらがなお語,かたっているときに、わたしは聞,きく。","tok":[["彼","かれ"],["ら"],["が"],["呼ばない","よばない"],["さき"],["に"],["、"],["わたし"],["は"],["答","こたえ"],["、"],["彼","かれ"],["ら"],["が"],["なお"],["語って","かたって"],["いる"],["とき"],["に"],["、"],["わたし"],["は"],["聞く","きく"],["。"]]},{"verse":25,"text":"おおかみと小羊,こひつじとは共,ともに食,くらい、ししは牛,うしのようにわらを食,くらい、へびはちりを食物,しょくもつとする。彼,かれらはわが聖,せいなる山,やまのどこでもそこなうことなく、やぶることはない」と主,しゅは言,いわれる。","tok":[["おおかみ"],["と"],["小羊","こひつじ"],["と"],["は"],["共","とも"],["に"],["食らい","くらい"],["、"],["しし"],["は"],["牛","うし"],["の"],["よう"],["に"],["わら"],["を"],["食らい","くらい"],["、"],["へび"],["は"],["ちり"],["を"],["食物","しょくもつ"],["と"],["する"],["。"],["彼","かれ"],["ら"],["は"],["わが"],["聖","せい"],["なる"],["山","やま"],["の"],["どこ"],["で"],["も"],["そこなう"],["こと"],["なく"],["、"],["やぶる"],["こと"],["は"],["ない"],["」"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]}]
[{"verse":1,"text":"見,みよ、主,しゅの手,てが短,みじかくて、救,すくい得,えないのではない。その耳,みみが鈍,にぶくて聞,きき得,えないのでもない。","tok":[["見よ","みよ"],["、"],["主","しゅ"],["の"],["手","て"],["が"],["短かくて","みじかくて"],["、"],["救い","すくい"],["得ない","えない"],["ので"],["は"],["ない"],["。"],["その"],["耳","みみ"],["が"],["鈍くて","にぶくて"],["聞得","ききえ"],["ない"],["ので"],["も"],["ない"],["。"]]},{"verse":2,"text":"ただ、あなたがたの不義,ふぎがあなたがたと、あなたがたの神,かみとの間,あいだを隔,へだてたのだ。またあなたがたの罪,つみが主,しゅの顔,かおをおおったために、お聞,ききにならないのだ。","tok":[["ただ"],["、"],["あなた"],["がた"],["の"],["不義","ふぎ"],["が"],["あなた"],["がた"],["と"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["と"],["の"],["間","あいだ"],["を"],["隔てた","へだてた"],["の"],["だ"],["。"],["また"],["あなた"],["がた"],["の"],["罪","つみ"],["が"],["主","しゅ"],["の"],["顔","かお"],["を"],["おおった"],["ため"],["に"],["、"],["お聞","おきき"],["に"],["ならない"],["の"],["だ"],["。"]]},{"verse":3,"text":"あなたがたの手,ては血,ちで汚,けがれ、あなたがたの指,ゆびは不義,ふぎで汚,けがれ、あなたがたのくちびるは偽,いつわりを語,かたり、あなたがたの舌,したは悪,あくをささやき、","tok":[["あなた"],["がた"],["の"],["手","て"],["は"],["血","ち"],["で"],["汚","け"],["がれ"],["、"],["あなた"],["がた"],["の"],["指","ゆび"],["は"],["不義","ふぎ"],["で"],["汚","け"],["がれ"],["、"],["あなた"],["がた"],["の"],["くちびる"],["は"],["偽り","いつわり"],["を"],["語り","かたり"],["、"],["あなた"],["がた"],["の"],["舌","した"],["は"],["悪","あく"],["を"],["ささやき"],["、"]]},{"verse":4,"text":"ひとりも正義,せいぎをもって訴,うったえ、真実,しんじつをもって論争,ろんそうする者,ものがない。彼,かれらはむなしきことを頼,たのみ、偽,いつわりを語,かたり、害悪,がいあくをはらみ、不義,ふぎを産,うむ。","tok":[["ひとり"],["も"],["正義","せいぎ"],["を"],["もって"],["訴","うったえ"],["、"],["真実","しんじつ"],["を"],["もって"],["論争","ろんそう"],["する"],["者","もの"],["が"],["ない"],["。"],["彼","かれ"],["ら"],["は"],["むなしき"],["こと"],["を"],["頼み","たのみ"],["、"],["偽り","いつわり"],["を"],["語り","かたり"],["、"],["害悪","がいあく"],["を"],["はらみ"],["、"],["不義","ふぎ"],["を"],["産む","うむ"],["。"]]},{"verse":5,"text":"彼,かれらはまむしの卵,たまごをかえし、くもの巣,すを織,おる。その卵,たまごを食,たべる者,ものは死,しぬ。卵,たまごが踏,ふまれると破,やぶれて毒蛇,どくへびを出,だす。","tok":[["彼","かれ"],["ら"],["は"],["まむし"],["の"],["卵","たまご"],["を"],["かえし"],["、"],["くも"],["の"],["巣","す"],["を"],["織る","おる"],["。"],["その"],["卵","たまご"],["を"],["食べる","たべる"],["者","もの"],["は"],["死ぬ","しぬ"],["。"],["卵","たまご"],["が"],["踏まれる","ふまれる"],["と"],["破れて","やぶれて"],["毒蛇","どくへび"],["を"],["出す","だす"],["。"]]},{"verse":6,"text":"その織,おる物,ものは着物,きものとならない。その造,つくる物,ものをもって身,みをおおうことができない。彼,かれのわざは不義,ふぎのわざであり、彼,かれらの手,てには暴虐,ぼうぎゃくの行,おこないがある。","tok":[["その"],["織る","おる"],["物","もの"],["は"],["着物","きもの"],["と"],["ならない"],["。"],["その"],["造る","つくる"],["物","もの"],["を"],["もって"],["身","み"],["を"],["おおう"],["こと"],["が"],["できない"],["。"],["彼","かれ"],["の"],["わざ"],["は"],["不義","ふぎ"],["の"],["わざ"],["で"],["あり"],["、"],["彼","かれ"],["ら"],["の"],["手","て"],["に"],["は"],["暴虐","ぼうぎゃく"],["の"],["行ない","おこない"],["が"],["ある"],["。"]]},{"verse":7,"text":"彼,かれらの足,あしは悪,あくに走,はしり、罪,つみのない血,ちを流,ながすことに速,はやい。彼,かれらの思,おもいは不義,ふぎの思,おもいであり、荒廃,こうはいと滅亡,めつぼうとがその道,みちにある。","tok":[["彼","かれ"],["ら"],["の"],["足","あし"],["は"],["悪","あく"],["に"],["走り","はしり"],["、"],["罪","つみ"],["の"],["ない"],["血","ち"],["を"],["流す","ながす"],["こと"],["に"],["速い","はやい"],["。"],["彼","かれ"],["ら"],["の"],["思い","おもい"],["は"],["不義","ふぎ"],["の"],["思い","おもい"],["で"],["あり"],["、"],["荒廃","こうはい"],["と"],["滅亡","めつぼう"],["と"],["が"],["その"],["道","みち"],["に"],["ある"],["。"]]},{"verse":8,"text":"彼,かれらは平和,へいわの道,みちを知,しらず、その行,ゆく道,みちには公平,こうへいがない。彼,かれらはその道,みちを曲,まげた。すべてこれを歩,あゆむ者,ものは平和,へいわを知,しらない。","tok":[["彼","かれ"],["ら"],["は"],["平和","へいわ"],["の"],["道","みち"],["を"],["知らず","しらず"],["、"],["その"],["行く","ゆく"],["道","みち"],["に"],["は"],["公平","こうへい"],["が"],["ない"],["。"],["彼","かれ"],["ら"],["は"],["その"],["道","みち"],["を"],["曲げた","まげた"],["。"],["すべて"],["これ"],["を"],["歩む","あゆむ"],["者","もの"],["は"],["平和","へいわ"],["を"],["知らない","しらない"],["。"]]},{"verse":9,"text":"それゆえ、公平,こうへいは遠,とおくわれわれを離,はなれ、正義,せいぎはわれわれに追,おいつかない。われわれは光,ひかりを望,のぞんでも、暗,くらきを見,み、輝,かがやきを望,のぞんでも、やみを行,いく。","tok":[["それ"],["ゆえ"],["、"],["公平","こうへい"],["は"],["遠く","とおく"],["われわれ"],["を"],["離れ","はなれ"],["、"],["正義","せいぎ"],["は"],["われわれ"],["に"],["追いつかない","おいつかない"],["。"],["われわれ"],["は"],["光","ひかり"],["を"],["望","のぞん"],["で"],["も"],["、"],["暗き","くらき"],["を"],["見","み"],["、"],["輝やき","かがやき"],["を"],["望","のぞん"],["で"],["も"],["、"],["やみ"],["を"],["行く","いく"],["。"]]},{"verse":10,"text":"われわれは盲人,もうじんのように、かきを手,てさぐりゆき、目,めのない者,もののように手,てさぐりゆき、真昼,まひるでも、たそがれのようにつまずき、強壮,きょうそうな者,ものの中,なかにあっても死人,しにんのようだ。","tok":[["われわれ"],["は"],["盲人","もうじん"],["の"],["よう"],["に"],["、"],["かき"],["を"],["手さぐり","てさぐり"],["ゆき"],["、"],["目","め"],["の"],["ない"],["者","もの"],["の"],["よう"],["に"],["手さぐり","てさぐり"],["ゆき"],["、"],["真昼","まひる"],["で"],["も"],["、"],["たそがれ"],["の"],["よう"],["に"],["つまずき"],["、"],["強壮","きょうそう"],["な"],["者","もの"],["の"],["中","なか"],["に"],["あって"],["も"],["死人","しにん"],["の"],["よう"],["だ"],["。"]]},{"verse":11,"text":"われわれは皆,みなくまのようにほえ、はとのようにいたくうめき、公平,こうへいを望,のぞんでも、きたらず、救,すくいを望,のぞんでも、遠,とおくわれわれを離,はなれ去,さる。","tok":[["われわれ"],["は"],["皆","みな"],["くま"],["の"],["よう"],["に"],["ほえ"],["、"],["はと"],["の"],["よう"],["に"],["いたく"],["うめき"],["、"],["公平","こうへい"],["を"],["望","のぞん"],["で"],["も"],["、"],["きたらず"],["、"],["救い","すくい"],["を"],["望","のぞん"],["で"],["も"],["、"],["遠く","とおく"],["われわれ"],["を"],["離れ去る","はなれさる"],["。"]]},{"verse":12,"text":"われわれのとがは、あなたの前,まえに多,おおく、罪,つみは、われわれを訴,うったえて、あかしをなし、とがは、われわれと共,ともにあり、不義,ふぎは、われわれがこれを知,しる。","tok":[["われわれ"],["の"],["とが"],["は"],["、"],["あなた"],["の"],["前","まえ"],["に"],["多く","おおく"],["、"],["罪","つみ"],["は"],["、"],["われわれ"],["を"],["訴て","うったえて"],["、"],["あかし"],["を"],["なし"],["、"],["とが"],["は"],["、"],["われわれ"],["と"],["共","とも"],["に"],["あり"],["、"],["不義","ふぎ"],["は"],["、"],["われわれ"],["が"],["これ"],["を"],["知る","しる"],["。"]]},{"verse":13,"text":"われわれは、そむいて主,しゅをいなみ、退,しりぞいて、われわれの神,かみに従,したがわず、しえたげと、そむきとを語,かたり、偽,いつわりの言葉,ことばを心,こころにはらんで、それを言,いいあらわす。","tok":[["われわれ"],["は"],["、"],["そむいて"],["主","しゅ"],["を"],["いなみ"],["、"],["退ぞいて","しりぞいて"],["、"],["われわれ"],["の"],["神","かみ"],["に"],["従わず","したがわず"],["、"],["し"],["えたげ"],["と"],["、"],["そむき"],["と"],["を"],["語り","かたり"],["、"],["偽わり","いつわり"],["の"],["言葉","ことば"],["を"],["心","こころ"],["に"],["はらんで"],["、"],["それ"],["を"],["言いあらわす","いいあらわす"],["。"]]},{"verse":14,"text":"公平,こうへいはうしろに退,しりぞけられ、正義,せいぎははるかに立,たつ。それは、真実,しんじつは広場,ひろばに倒,たおれ、正直,しょうじきは、はいることができないからである。","tok":[["公平","こうへい"],["は"],["うしろ"],["に"],["退ぞけられ","しりぞけられ"],["、"],["正義","せいぎ"],["は"],["はるか"],["に"],["立つ","たつ"],["。"],["それ"],["は"],["、"],["真実","しんじつ"],["は"],["広場","ひろば"],["に"],["倒れ","たおれ"],["、"],["正直","しょうじき"],["は"],["、"],["はいる"],["こと"],["が"],["できない"],["から"],["で"],["ある"],["。"]]},{"verse":15,"text":"真実,しんじつは欠,かけてなく、悪,あくを離,はなれる者,ものはかすめ奪,うばわれる。主,しゅはこれを見,みて、公平,こうへいがなかったことを喜,よろこばれなかった。","tok":[["真実","しんじつ"],["は"],["欠けてなく","かけてなく"],["、"],["悪","あく"],["を"],["離れる","はなれる"],["者","もの"],["は"],["かすめ"],["奪われる","うばわれる"],["。"],["主","しゅ"],["は"],["これ"],["を"],["見て","みて"],["、"],["公平","こうへい"],["が"],["なかった"],["こと"],["を"],["喜こばれなかった","よろこばれなかった"],["。"]]},{"verse":16,"text":"主,しゅは人,ひとのないのを見,みられ、仲,なかに立,たつ者,もののないのをあやしまれた。それゆえ、ご自分,じぶんのかいなをもって、勝利,しょうりを得,え、その義,ぎをもって、おのれをささえられた。","tok":[["主","しゅ"],["は"],["人","ひと"],["の"],["ない"],["の"],["を"],["見られ","みられ"],["、"],["仲","なか"],["に"],["立つ","たつ"],["者","もの"],["の"],["ない"],["の"],["を"],["あやしまれた"],["。"],["それ"],["ゆえ"],["、"],["ご自分","ごじぶん"],["の"],["かいな"],["を"],["もって"],["、"],["勝利","しょうり"],["を"],["得","え"],["、"],["その"],["義","ぎ"],["を"],["もって"],["、"],["おのれ"],["を"],["ささえられた"],["。"]]},{"verse":17,"text":"主,しゅは義,ぎを胸当,むねあてとしてまとい、救,すくいのかぶとをその頭,あたまにいただき、報復,ほうふくの衣,ころもをまとって着物,きものとし、熱心,ねっしんを外套,がいとうとして身,みを包,つつまれた。","tok":[["主","しゅ"],["は"],["義","ぎ"],["を"],["胸当","むねあて"],["として"],["まとい"],["、"],["救い","すくい"],["の"],["かぶと"],["を"],["その"],["頭","あたま"],["に"],["いただき"],["、"],["報復","ほうふく"],["の"],["衣","ころも"],["を"],["まとって"],["着物","きもの"],["と"],["し"],["、"],["熱心","ねっしん"],["を"],["外套","がいとう"],["として"],["身","み"],["を"],["包まれた","つつまれた"],["。"]]},{"verse":18,"text":"主,しゅは彼,かれらの行,おこないにしたがって報,むくいをなし、あだにむかって怒,いかり、敵,てきにむかって報,むくいをなし、海沿,うみぞいの国々,くにぐににむかって報,むくいをされる。","tok":[["主","しゅ"],["は"],["彼","かれ"],["ら"],["の"],["行ない","おこない"],["に"],["したがって"],["報い","むくい"],["を"],["なし"],["、"],["あだ"],["に"],["むかって"],["怒り","いかり"],["、"],["敵","てき"],["に"],["むかって"],["報い","むくい"],["を"],["なし"],["、"],["海沿い","うみぞい"],["の"],["国々","くにぐに"],["に"],["むかって"],["報い","むくい"],["を"],["される"],["。"]]},{"verse":19,"text":"こうして、人々,ひとびとは西,にしの方,ほうから主,しゅの名,なを恐,おそれ、日,ひの出,でる方,ほうからその栄光,えいこうを恐,おそれる。主,しゅは、せき止,とめた川,かわを、そのいぶきで押,おし流,ながすように、こられるからである。","tok":[["こう"],["して"],["、"],["人々","ひとびと"],["は"],["西","にし"],["の"],["方","ほう"],["から"],["主","しゅ"],["の"],["名","な"],["を"],["恐","おそれ"],["、"],["日","ひ"],["の"],["出る","でる"],["方","ほう"],["から"],["その"],["栄光","えいこう"],["を"],["恐れる","おそれる"],["。"],["主","しゅ"],["は"],["、"],["せき"],["止","とめ"],["た"],["川","かわ"],["を"],["、"],["その"],["いぶき"],["で"],["押","おし"],["流す","ながす"],["よう"],["に"],["、"],["こられる"],["から"],["で"],["ある"],["。"]]},{"verse":20,"text":"主,しゅは言,いわれる、「主,しゅは、あがなう者,ものとしてシオンにきたり、ヤコブのうちの、とがを離,はなれる者,ものに至,いたる」と。","tok":[["主","しゅ"],["は"],["言われる","いわれる"],["、"],["「"],["主","しゅ"],["は"],["、"],["あがなう"],["者","もの"],["として"],["シオン"],["に"],["き"],["たり"],["、"],["ヤコブ"],["の"],["うち"],["の"],["、"],["とが"],["を"],["離れる","はなれる"],["者","もの"],["に"],["至る","いたる"],["」"],["と"],["。"]]},{"verse":21,"text":"主,しゅは言,いわれる、「わたしが彼,かれらと立,たてる契約,けいやくはこれである。あなたの上,うえにあるわが霊,れい、あなたの口,くちにおいたわが言葉,ことばは、今,いまから後,のちとこしえに、あなたの口,くちから、あなたの子,こらの口,くちから、あなたの子,こらの子,この口,くちから離,はなれることはない」と。","tok":[["主","しゅ"],["は"],["言われる","いわれる"],["、"],["「"],["わたし"],["が"],["彼","かれ"],["ら"],["と"],["立る","たてる"],["契約","けいやく"],["は"],["これ"],["で"],["ある"],["。"],["あなた"],["の"],["上","うえ"],["に"],["ある"],["わが"],["霊","れい"],["、"],["あなた"],["の"],["口","くち"],["に"],["おいた"],["わが"],["言葉","ことば"],["は"],["、"],["今","いま"],["から"],["後","の"],["ち"],["とこしえ"],["に"],["、"],["あなた"],["の"],["口","くち"],["から"],["、"],["あなた"],["の"],["子","こ"],["ら"],["の"],["口","くち"],["から"],["、"],["あなた"],["の"],["子","こ"],["ら"],["の"],["子","こ"],["の"],["口","くち"],["から"],["離れる","はなれる"],["こと"],["は"],["ない"],["」"],["と"],["。"]]}]
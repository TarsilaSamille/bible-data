[{"verse":1,"text":"ああ、アリエルよ、アリエルよ、ダビデが営,えいをかまえた町,まちよ、年,ねんに年,ねんを加,くわえ、祭,まつりをめぐりこさせよ。","tok":[["ああ"],["、"],["アリエル"],["よ"],["、"],["アリエル"],["よ"],["、"],["ダビデ"],["が"],["営","えい"],["を"],["かまえた"],["町","まち"],["よ"],["、"],["年","ねん"],["に"],["年","ねん"],["を"],["加え","くわえ"],["、"],["祭","まつり"],["を"],["めぐり"],["こ"],["さ"],["せよ"],["。"]]},{"verse":2,"text":"その時,ときわたしはアリエルを悩,なやます。そこには悲,かなしみと嘆,なげきとがあって、アリエルのようなものとなる。","tok":[["その"],["時","とき"],["わたし"],["は"],["アリエル"],["を"],["悩す","なやます"],["。"],["そこ"],["に"],["は"],["悲しみ","かなしみ"],["と"],["嘆き","なげき"],["と"],["が"],["あって"],["、"],["アリエル"],["の"],["よう"],["な"],["もの"],["と"],["なる"],["。"]]},{"verse":3,"text":"わたしはあなたのまわりに営,えいを構,かまえ、やぐらをもってあなたを囲,かこみ、塁,るいを築,きずいてあなたを攻,せめる。","tok":[["わたし"],["は"],["あなた"],["の"],["まわり"],["に"],["営","えい"],["を"],["構","かまえ"],["、"],["やぐら"],["を"],["もって"],["あなた"],["を"],["囲み","かこみ"],["、"],["塁","るい"],["を"],["築いて","きずいて"],["あなた"],["を"],["攻める","せめる"],["。"]]},{"verse":4,"text":"その時,ときあなたは深,ふかい地,ちの中,なかから物言,ものいい、低,ひくいちりの中,なかから言葉,ことばを出,だす。あなたの声,こえは亡霊,ぼうれいの声,こえのように地,ちから出,で、あなたの言葉,ことばはちりの中,なかから、さえずるようである。","tok":[["その"],["時","とき"],["あなた"],["は"],["深","ふ"],["かい"],["地","ち"],["の"],["中","なか"],["から"],["物言い","ものいい"],["、"],["低い","ひくい"],["ちり"],["の"],["中","なか"],["から"],["言葉","ことば"],["を"],["出す","だす"],["。"],["あなた"],["の"],["声","こえ"],["は"],["亡霊","ぼうれい"],["の"],["声","こえ"],["の"],["よう"],["に"],["地","ち"],["から"],["出","で"],["、"],["あなた"],["の"],["言葉","ことば"],["は"],["ちり"],["の"],["中","なか"],["から"],["、"],["さえずる"],["よう"],["で"],["ある"],["。"]]},{"verse":5,"text":"しかしあなたのあだの群,むれは細,こまかなちりのようになり、あらぶる者,ものの群,むれは吹,ふき去,さられるもみがらのようになる。また、にわかに、またたくまに、この事,ことがある。","tok":[["しかし"],["あなた"],["の"],["あだ"],["の"],["群れ","むれ"],["は"],["細か","こまか"],["な"],["ちり"],["の"],["よう"],["に"],["なり"],["、"],["あら"],["ぶる"],["者","もの"],["の"],["群れ","むれ"],["は"],["吹","ふき"],["去られる","さられる"],["もみがら"],["の"],["よう"],["に"],["なる"],["。"],["また"],["、"],["にわか"],["に"],["、"],["またたく"],["ま"],["に"],["、"],["この"],["事","こと"],["が"],["ある"],["。"]]},{"verse":6,"text":"すなわち万軍,ばんぐんの主,しゅは雷,かみなり、地震,じしん、大,おおいなる叫,さけび、つむじ風,かぜ、暴風,ぼうふうおよび焼,やきつくす火,ひの炎,ほのおをもって臨,のぞまれる。","tok":[["すなわち"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["雷","かみなり"],["、"],["地震","じしん"],["、"],["大いなる","おおいなる"],["叫","さけび"],["、"],["つむじ風","つむじかぜ"],["、"],["暴風","ぼうふう"],["および"],["焼き","やき"],["つくす"],["火","ひ"],["の"],["炎","ほのお"],["を"],["もって"],["臨まれる","のぞまれる"],["。"]]},{"verse":7,"text":"そしてアリエルを攻,せめて戦,たたかう国々,くにぐにの群,むれ、すなわちアリエルとその城,しろを攻,せめて戦,たたかい、これを悩,なやます者,ものはみな夢,ゆめのように、夜,よるの幻,まぼろしのようになる。","tok":[["そして"],["アリエル"],["を"],["攻めて","せめて"],["戦う","たたかう"],["国々","くにぐに"],["の"],["群れ","むれ"],["、"],["すなわち"],["アリエル"],["と"],["その"],["城","しろ"],["を"],["攻めて","せめて"],["戦い","たたかい"],["、"],["これ"],["を"],["悩す","なやます"],["者","もの"],["は"],["みな"],["夢","ゆめ"],["の"],["よう"],["に"],["、"],["夜","よる"],["の"],["幻","まぼろし"],["の"],["よう"],["に"],["なる"],["。"]]},{"verse":8,"text":"飢,うえた者,ものが食,たべることを夢,ゆめみても、さめると、その飢,うえがいえないように、あるいは、かわいた者,ものが飲,のむことを夢,ゆめみても、さめると、疲,つかれてそのかわきがとまらないように、シオンの山,やまを攻,せめて戦,たたかう国々,くにぐにの群,むれもそのようになる。","tok":[["飢","うえ"],["た"],["者","もの"],["が"],["食べる","たべる"],["こと"],["を"],["夢みて","ゆめみて"],["も"],["、"],["さめる"],["と"],["、"],["その"],["飢","うえ"],["が"],["いえない"],["よう"],["に"],["、"],["あるいは"],["、"],["かわいた"],["者","もの"],["が"],["飲む","のむ"],["こと"],["を"],["夢みて","ゆめみて"],["も"],["、"],["さめる"],["と"],["、"],["疲れて","つかれて"],["その"],["かわき"],["が"],["とまらない"],["よう"],["に"],["、"],["シオン"],["の"],["山","やま"],["を"],["攻めて","せめて"],["戦う","たたかう"],["国々","くにぐに"],["の"],["群れ","むれ"],["も"],["その"],["よう"],["に"],["なる"],["。"]]},{"verse":9,"text":"あなたがたは知覚,ちかくを失,うしなって気,きが遠,とおくなれ、目,めがくらんで盲,めくらとなれ。あなたがたは酔,よっていよ、しかし酒,さけのゆえではない、よろめけ、しかし濃,こき酒,さけのゆえではない。","tok":[["あなた"],["がた"],["は"],["知覚","ちかく"],["を"],["失なって","うしなって"],["気","き"],["が"],["遠く","とおく"],["なれ"],["、"],["目","め"],["が"],["くらんで"],["盲","めく"],["ら"],["と"],["なれ"],["。"],["あなた"],["がた"],["は"],["酔って","よって"],["いよ"],["、"],["しかし"],["酒","さけ"],["の"],["ゆえ"],["で"],["は"],["ない"],["、"],["よろめけ"],["、"],["しかし"],["濃き","こき"],["酒","さけ"],["の"],["ゆえ"],["で"],["は"],["ない"],["。"]]},{"verse":10,"text":"主,しゅが深,ふかい眠,ねむりの霊,れいをあなたがたの上,うえにそそぎ、あなたがたの目,めである預言者,よげんしゃを閉,とじこめ、あなたがたの頭,あたまである先見者,せんけんしゃをおおわれたからである。","tok":[["主","しゅ"],["が"],["深","ふ"],["かい"],["眠","ねむり"],["の"],["霊","れい"],["を"],["あなた"],["がた"],["の"],["上","うえ"],["に"],["そそぎ"],["、"],["あなた"],["がた"],["の"],["目","め"],["で"],["ある"],["預言者","よげんしゃ"],["を"],["閉じこめ","とじこめ"],["、"],["あなた"],["がた"],["の"],["頭","あたま"],["で"],["ある"],["先見者","せんけんしゃ"],["を"],["おおわれた"],["から"],["で"],["ある"],["。"]]},{"verse":11,"text":"それゆえ、このすべての幻,まぼろしは、あなたがたには封,ふうじた書物,しょもつの言葉,ことばのようになり、人々,ひとびとはこれを読,よむことのできる者,ものにわたして、「これを読,よんでください」と言,いえば、「これは封,ふうじてあるから読,よむことができない」と彼,かれは言,いう。","tok":[["それ"],["ゆえ"],["、"],["この"],["すべて"],["の"],["幻","まぼろし"],["は"],["、"],["あなた"],["がた"],["に"],["は"],["封じた","ふうじた"],["書物","しょもつ"],["の"],["言葉","ことば"],["の"],["よう"],["に"],["なり"],["、"],["人々","ひとびと"],["は"],["これ"],["を"],["読む","よむ"],["こと"],["の"],["できる"],["者","もの"],["に"],["わたして"],["、"],["「"],["これ"],["を"],["読んで","よんで"],["ください"],["」"],["と"],["言えば","いえば"],["、"],["「"],["これ"],["は"],["封じて","ふうじて"],["ある"],["から"],["読む","よむ"],["こと"],["が"],["できない"],["」"],["と"],["彼","かれ"],["は"],["言う","いう"],["。"]]},{"verse":12,"text":"またその書物,しょもつを読,よむことのできない者,ものにわたして、「これを読,よんでください」と言,いえば、「読,よむことはできない」と彼,かれは言,いう。","tok":[["また"],["その"],["書物","しょもつ"],["を"],["読む","よむ"],["こと"],["の"],["できない"],["者","もの"],["に"],["わたして"],["、"],["「"],["これ"],["を"],["読んで","よんで"],["ください"],["」"],["と"],["言えば","いえば"],["、"],["「"],["読む","よむ"],["こと"],["は"],["できない"],["」"],["と"],["彼","かれ"],["は"],["言う","いう"],["。"]]},{"verse":13,"text":"主,しゅは言,いわれた、「この民,たみは口,くちをもってわたしに近,ちかづき、くちびるをもってわたしを敬,うやまうけれども、その心,こころはわたしから遠,とおく離,はなれ、彼,かれらのわたしをかしこみ恐,おそれるのは、そらで覚,おぼえた人,ひとの戒,いましめによるのである。","tok":[["主","しゅ"],["は"],["言われた","いわれた"],["、"],["「"],["この"],["民","たみ"],["は"],["口","くち"],["を"],["もって"],["わたし"],["に"],["近づき","ちかづき"],["、"],["くちびる"],["を"],["もって"],["わたし"],["を"],["敬う","うやまう"],["けれど"],["も"],["、"],["その"],["心","こころ"],["は"],["わたし"],["から"],["遠く","とおく"],["離れ","はなれ"],["、"],["彼","かれ"],["ら"],["の"],["わたし"],["を"],["かしこみ"],["恐れる","おそれる"],["の"],["は"],["、"],["そら"],["で"],["覚えた","おぼえた"],["人","ひと"],["の"],["戒しめ","いましめ"],["に"],["よる"],["ので"],["ある"],["。"]]},{"verse":14,"text":"それゆえ、見,みよ、わたしはこの民,たみに、再,ふたたび驚,おどろくべきわざを行,おこなう、それは不思議,ふしぎな驚,おどろくべきわざである。彼,かれらのうちの賢,かしこい人,ひとの知恵,ちえは滅,ほろび、さとい人,ひとの知識,ちしきは隠,かくされる」。","tok":[["それ"],["ゆえ"],["、"],["見よ","みよ"],["、"],["わたし"],["は"],["この"],["民","たみ"],["に"],["、"],["再び","ふたたび"],["驚ろくべき","おどろくべき"],["わざ"],["を"],["行なう","おこなう"],["、"],["それ"],["は"],["不思議","ふしぎ"],["な"],["驚ろくべき","おどろくべき"],["わざ"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["の"],["うち"],["の"],["賢しこい","かしこい"],["人","ひと"],["の"],["知恵","ちえ"],["は"],["滅び","ほろび"],["、"],["さとい"],["人","ひと"],["の"],["知識","ちしき"],["は"],["隠される","かくされる"],["」"],["。"]]},{"verse":15,"text":"わざわいなるかな、おのが計,はかりごとを主,しゅに深,ふかく隠,かくす者,もの。彼,かれらは暗,くらい中,なかでわざを行,おこない、「だれがわれわれを見,みるか、だれがわれわれのことを知,しるか」と言,いう。","tok":[["わざわい"],["なる"],["か"],["な"],["、"],["お"],["の"],["が"],["計り","はかり"],["ごと"],["を"],["主に","しゅに"],["深く","ふかく"],["隠す","かくす"],["者","もの"],["。"],["彼","かれ"],["ら"],["は"],["暗い","くらい"],["中","なか"],["で"],["わざ"],["を"],["行ない","おこない"],["、"],["「"],["だれ"],["が"],["われわれ"],["を"],["見る","みる"],["か"],["、"],["だれ"],["が"],["われわれ"],["の"],["こと"],["を"],["知る","しる"],["か"],["」"],["と"],["言う","いう"],["。"]]},{"verse":16,"text":"あなたがたは転倒,てんとうして考,かんがえている。陶器,とうき師,しは粘土,ねんどと同,おなじものに思,おもわれるだろうか。造,つくられた物,ものはそれを造,つくった者,ものについて、「彼,かれはわたしを造,つくらなかった」と言,いい、形,かたち造,つくられた物,ものは形,かたち造,つくった者,ものについて、「彼,かれは知恵,ちえがない」と言,いうことができようか。","tok":[["あなた"],["がた"],["は"],["転倒","てんとう"],["して"],["考","かんがえ"],["て"],["いる"],["。"],["陶器師","とうきし"],["は"],["粘土","ねんど"],["と"],["同じ","おなじ"],["もの"],["に"],["思われるだろう","おもわれるだろう"],["か"],["。"],["造られた","つくられた"],["物","もの"],["は"],["それ"],["を"],["造った","つくった"],["者","もの"],["について"],["、"],["「"],["彼","かれ"],["は"],["わたし"],["を"],["造らなかった","つくらなかった"],["」"],["と"],["言い","いい"],["、"],["形造られた","かたちつくられた"],["物","もの"],["は"],["形造った","かたちつくった"],["者","もの"],["について"],["、"],["「"],["彼","かれ"],["は"],["知恵","ちえ"],["が"],["ない"],["」"],["と"],["言う","いう"],["こと"],["が"],["できよう"],["か"],["。"]]},{"verse":17,"text":"しばらくしてレバノンは変,かわって肥,こえた畑,はたけとなり、肥,こえた畑,はたけは林,はやしのように思,おもわれる時,ときが来,くるではないか。","tok":[["しばらく"],["して"],["レバノン"],["は"],["変わって","かわって"],["肥","こえ"],["た"],["畑","はたけ"],["と"],["なり"],["、"],["肥","こえ"],["た"],["畑","はたけ"],["は"],["林","はやし"],["の"],["よう"],["に"],["思われる","おもわれる"],["時","とき"],["が"],["来るで","くるで"],["は"],["ない"],["か"],["。"]]},{"verse":18,"text":"その日,ひ、耳,みみしいは書物,しょもつの言葉,ことばを聞,きき、目,めしいの目,めはその暗,くらやみから、見,みることができる。","tok":[["その"],["日","ひ"],["、"],["耳","みみ"],["しい"],["は"],["書物","しょもつ"],["の"],["言葉","ことば"],["を"],["聞","きき"],["、"],["目","め"],["しい"],["の"],["目","め"],["は"],["その"],["暗やみ","くらやみ"],["から"],["、"],["見る","みる"],["こと"],["が"],["できる"],["。"]]},{"verse":19,"text":"柔和,にゅうわな者,ものは主,しゅによって新,あらたなる喜,よろこびを得,え、人,ひとのなかの貧,まずしい者,ものはイスラエルの聖者,せいじゃによって楽,たのしみを得,える。","tok":[["柔和","にゅうわ"],["な"],["者","もの"],["は"],["主に","しゅに"],["よって"],["新らた","あらた"],["なる"],["喜こび","よろこび"],["を"],["得","え"],["、"],["人","ひと"],["の"],["なか"],["の"],["貧しい","まずしい"],["者","もの"],["は"],["イスラエル"],["の"],["聖者","せいじゃ"],["によって"],["楽み","たのしみ"],["を"],["得る","える"],["。"]]},{"verse":20,"text":"あらぶる者,ものは絶,たえ、あざける者,ものはうせ、悪,あくを行,おこなおうと、おりをうかがう者,ものは、ことごとく断,たち滅,ほろぼされるからである。","tok":[["あら"],["ぶる"],["者","もの"],["は"],["絶え","たえ"],["、"],["あざける"],["者","もの"],["は"],["うせ"],["、"],["悪","あく"],["を"],["行なおう","おこなおう"],["と"],["、"],["おり"],["を"],["うかがう"],["者","もの"],["は"],["、"],["ことごとく"],["断ち","たち"],["滅ぼされる","ほろぼされる"],["から"],["で"],["ある"],["。"]]},{"verse":21,"text":"彼,かれらは言葉,ことばによって人,ひとを罪,つみに定,さだめ、町,まちの門,もんでいさめる者,ものをわなにおとしいれ、むなしい言葉,ことばをかまえて正,ただしい者,ものをしりぞける。","tok":[["彼","かれ"],["ら"],["は"],["言葉","ことば"],["によって"],["人","ひと"],["を"],["罪","つみ"],["に"],["定め","さだめ"],["、"],["町","まち"],["の"],["門","もん"],["で"],["いさめる"],["者","もの"],["を"],["わな"],["に"],["おとしいれ"],["、"],["むなしい"],["言葉","ことば"],["を"],["かまえて"],["正い","ただしい"],["者","もの"],["を"],["しりぞける"],["。"]]},{"verse":22,"text":"それゆえ、昔,むかしアブラハムをあがなわれた主,しゅは、ヤコブの家,いえについてこう言,いわれる、「ヤコブは、もはやはずかしめを受,うけず、その顔,かおは、もはや色,いろを失,うしなうことはない。","tok":[["それ"],["ゆえ"],["、"],["昔","むかし"],["アブラハム"],["を"],["あがなわれた"],["主","しゅ"],["は"],["、"],["ヤコブ"],["の"],["家","いえ"],["について"],["こう"],["言われる","いわれる"],["、"],["「"],["ヤコブ"],["は"],["、"],["もはや"],["はずかしめ"],["を"],["受ず","うけず"],["、"],["その"],["顔","かお"],["は"],["、"],["もはや"],["色","いろ"],["を"],["失なう","うしなう"],["こと"],["は"],["ない"],["。"]]},{"verse":23,"text":"彼,かれの子孫,しそんが、その中,なかにわが手,てのわざを見,みるとき、彼,かれらはわが名,なを聖,せいとし、ヤコブの聖者,せいじゃを聖,せいとして、イスラエルの神,かみを恐,おそれる。","tok":[["彼","かれ"],["の"],["子孫","しそん"],["が"],["、"],["その"],["中","なか"],["に"],["わが"],["手","て"],["の"],["わざ"],["を"],["見る","みる"],["とき"],["、"],["彼","かれ"],["ら"],["は"],["わが"],["名","な"],["を"],["聖","せい"],["と"],["し"],["、"],["ヤコブ"],["の"],["聖者","せいじゃ"],["を"],["聖","せい"],["として"],["、"],["イスラエル"],["の"],["神","かみ"],["を"],["恐れる","おそれる"],["。"]]},{"verse":24,"text":"心,こころのあやまれる者,ものも、悟,さとりを得,え、つぶやく者,ものも教,おしえをうける」。","tok":[["心","こころ"],["の"],["あやまれる"],["者","もの"],["も"],["、"],["悟り","さとり"],["を"],["得","え"],["、"],["つぶやく"],["者","もの"],["も"],["教え","おしえ"],["を"],["うける"],["」"],["。"]]}]
[{"verse":1,"text":"しかし、このことは知,しっておかねばならない。終,おわりの時,ときには、苦難,くなんの時代,じだいが来,くる。","tok":[["しかし"],["、"],["この"],["こと"],["は"],["知って","しって"],["おかねば"],["ならない"],["。"],["終","おわり"],["の"],["時","とき"],["に"],["は"],["、"],["苦難","くなん"],["の"],["時代","じだい"],["が"],["来る","くる"],["。"]]},{"verse":2,"text":"その時,とき、人々,ひとびとは自分,じぶんを愛,あいする者,もの、金,かねを愛,あいする者,もの、大言壮語,たいげんそうごする者,もの、高慢,こうまんな者,もの、神,かみをそしる者,もの、親,おやに逆,さからう者,もの、恩,おんを知,しらぬ者,もの、神聖,しんせいを汚,けがす者,もの、","tok":[["その"],["時","とき"],["、"],["人々","ひとびと"],["は"],["自分","じぶん"],["を"],["愛する","あいする"],["者","もの"],["、"],["金","かね"],["を"],["愛する","あいする"],["者","もの"],["、"],["大言","たいげん"],["壮語","そうご"],["する"],["者","もの"],["、"],["高慢","こうまん"],["な"],["者","もの"],["、"],["神","かみ"],["を"],["そしる"],["者","もの"],["、"],["親","おや"],["に"],["逆らう","さからう"],["者","もの"],["、"],["恩","おん"],["を"],["知らぬ","しらぬ"],["者","もの"],["、"],["神聖","しんせい"],["を"],["汚","け"],["がす"],["者","もの"],["、"]]},{"verse":3,"text":"無情,むじょうな者,もの、融和,ゆうわしない者,もの、そしる者,もの、無,む節制,せっせいな者,もの、粗暴,そぼうな者,もの、善,ぜんを好,このまない者,もの、","tok":[["無情","むじょう"],["な"],["者","もの"],["、"],["融和","ゆうわ"],["しない"],["者","もの"],["、"],["そしる"],["者","もの"],["、"],["無","む"],["節制","せっせい"],["な"],["者","もの"],["、"],["粗暴","そぼう"],["な"],["者","もの"],["、"],["善","ぜん"],["を"],["好まない","このまない"],["者","もの"],["、"]]},{"verse":4,"text":"裏切,うらぎり者,もの、乱暴,らんぼう者,もの、高言,こうげんをする者,もの、神,かみよりも快楽,かいらくを愛,あいする者,もの、","tok":[["裏切者","うらぎりもの"],["、"],["乱暴者","らんぼうもの"],["、"],["高言","こうげん"],["を"],["する"],["者","もの"],["、"],["神","かみ"],["より"],["も"],["快楽","かいらく"],["を"],["愛する","あいする"],["者","もの"],["、"]]},{"verse":5,"text":"信心,しんじん深,ぶかい様子,ようすをしながらその実,じつを捨,すてる者,ものとなるであろう。こうした人々,ひとびとを避,さけなさい。","tok":[["信心","しんじん"],["深い","ぶかい"],["様子","ようす"],["を"],["し"],["ながら"],["その"],["実","じつ"],["を"],["捨てる","すてる"],["者","もの"],["と"],["なるで"],["あろう"],["。"],["こう"],["した"],["人々","ひとびと"],["を"],["避け","さけ"],["なさい"],["。"]]},{"verse":6,"text":"彼,かれらの中,なかには、人,ひとの家,いえにもぐり込,こみ、そして、さまざまの欲,よくに心,こころを奪,うばわれて、多,おおくの罪,つみを積,つみ重,かさねている愚,おろかな女,おんなどもを、とりこにしている者,ものがある。","tok":[["彼","かれ"],["ら"],["の"],["中","なか"],["に"],["は"],["、"],["人","ひと"],["の"],["家","いえ"],["に"],["もぐり"],["込","こみ"],["、"],["そして"],["、"],["さまざま"],["の"],["欲","よく"],["に"],["心","こころ"],["を"],["奪われて","うばわれて"],["、"],["多く","おおく"],["の"],["罪","つみ"],["を"],["積み重ねて","つみかさねて"],["いる"],["愚か","おろか"],["な"],["女","おんな"],["ども"],["を"],["、"],["とりこ"],["に"],["して"],["いる"],["者","もの"],["が"],["ある"],["。"]]},{"verse":7,"text":"彼女,かのじょたちは、常,つねに学,まなんではいるが、いつになっても真理,しんりの知識,ちしきに達,たっすることができない。","tok":[["彼女","かのじょ"],["たち"],["は"],["、"],["常","つね"],["に"],["学","まなん"],["で"],["は"],["いる"],["が"],["、"],["いつ"],["に"],["なって"],["も"],["真理","しんり"],["の"],["知識","ちしき"],["に"],["達する","たっする"],["こと"],["が"],["できない"],["。"]]},{"verse":8,"text":"ちょうど、ヤンネとヤンブレとがモーセに逆,さからったように、こうした人々,ひとびとも真理,しんりに逆,さからうのである。彼,かれらは知性,ちせいの腐,くさった、信仰,しんこうの失格者,しっかくしゃである。","tok":[["ちょうど"],["、"],["ヤンネ"],["と"],["ヤンブレ"],["と"],["が"],["モーセ"],["に"],["逆らった","さからった"],["よう"],["に"],["、"],["こう"],["した"],["人々","ひとびと"],["も"],["真理","しんり"],["に"],["逆らう","さからう"],["ので"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["知性","ちせい"],["の"],["腐った","くさった"],["、"],["信仰","しんこう"],["の"],["失格者","しっかくしゃ"],["で"],["ある"],["。"]]},{"verse":9,"text":"しかし、彼,かれらはそのまま進,すすんでいけるはずがない。彼,かれらの愚,おろかさは、あのふたりの場合,ばあいと同,おなじように、多,おおくの人,ひとに知,しれて来,くるであろう。","tok":[["しかし"],["、"],["彼","かれ"],["ら"],["は"],["そのまま"],["進んで","すすんで"],["いける"],["はず"],["が"],["ない"],["。"],["彼","かれ"],["ら"],["の"],["愚か","おろか"],["さ"],["は"],["、"],["あの"],["ふたり"],["の"],["場合","ばあい"],["と"],["同じ","おなじ"],["よう"],["に"],["、"],["多く","おおく"],["の"],["人","ひと"],["に"],["知れて","しれて"],["来るで","くるで"],["あろう"],["。"]]},{"verse":10,"text":"しかしあなたは、わたしの教,おしえ、歩,あゆみ、こころざし、信仰,しんこう、寛容,かんよう、愛,あい、忍耐,にんたい、","tok":[["しかし"],["あなた"],["は"],["、"],["わたし"],["の"],["教え","おしえ"],["、"],["歩","あゆみ"],["、"],["こころざし"],["、"],["信仰","しんこう"],["、"],["寛容","かんよう"],["、"],["愛","あい"],["、"],["忍耐","にんたい"],["、"]]},{"verse":11,"text":"それから、わたしがアンテオケ、イコニオム、ルステラで受,うけた数々,かずかずの迫害,はくがい、苦難,くなんに、よくも続,つづいてきてくれた。そのひどい迫害,はくがいにわたしは耐,たえてきたが、主,しゅはそれらいっさいのことから、救,すくい出,だして下,くださったのである。","tok":[["それ"],["から"],["、"],["わたし"],["が"],["アンテオケ"],["、"],["イコニオム"],["、"],["ルステラ"],["で"],["受た","うけた"],["数々","かずかず"],["の"],["迫害","はくがい"],["、"],["苦難","くなん"],["に"],["、"],["よく"],["も"],["続いて","つづいて"],["きて"],["くれた"],["。"],["その"],["ひどい"],["迫害","はくがい"],["に"],["わたし"],["は"],["耐えて","たえて"],["きた"],["が"],["、"],["主","しゅ"],["は"],["それ"],["ら"],["いっさい"],["の"],["こと"],["から"],["、"],["救い出して","すくいだして"],["下さった","くださった"],["ので"],["ある"],["。"]]},{"verse":12,"text":"いったい、キリスト・イエスにあって信心,しんじん深,ぶかく生,いきようとする者,ものは、みな、迫害,はくがいを受,うける。","tok":[["いったい"],["、"],["キリスト"],["・"],["イエス"],["に"],["あって"],["信心","しんじん"],["深","ぶ"],["かく"],["生きよう","いきよう"],["と"],["する"],["者","もの"],["は"],["、"],["みな"],["、"],["迫害","はくがい"],["を"],["受る","うける"],["。"]]},{"verse":13,"text":"悪人,あくにんと詐欺,さぎ師,しとは人,ひとを惑,まどわし人,ひとに惑,まどわされて、悪,あくから悪,あくへと落,おちていく。","tok":[["悪人","あくにん"],["と"],["詐欺師","さぎし"],["と"],["は"],["人","ひと"],["を"],["惑わし","まどわし"],["人","ひと"],["に"],["惑わされて","まどわされて"],["、"],["悪","あく"],["から"],["悪","あく"],["へ"],["と"],["落","おち"],["て"],["いく"],["。"]]},{"verse":14,"text":"しかし、あなたは、自分,じぶんが学,まなんで確信,かくしんしているところに、いつもとどまっていなさい。あなたは、それをだれから学,まなんだか知,しっており、","tok":[["しかし"],["、"],["あなた"],["は"],["、"],["自分","じぶん"],["が"],["学んで","まなんで"],["確信","かくしん"],["して"],["いる"],["ところ"],["に"],["、"],["いつも"],["とどまって"],["い"],["なさい"],["。"],["あなた"],["は"],["、"],["それ"],["を"],["だれ"],["から"],["学んだ","まなんだ"],["か"],["知って","しって"],["おり"],["、"]]},{"verse":15,"text":"また幼,おさない時,ときから、聖書,せいしょに親,したしみ、それが、キリスト・イエスに対,たいする信仰,しんこうによって救,すくいに至,いたる知恵,ちえを、あなたに与,あたえうる書物,しょもつであることを知,しっている。","tok":[["また"],["幼ない","おさない"],["時","とき"],["から"],["、"],["聖書","せいしょ"],["に"],["親しみ","したしみ"],["、"],["それ"],["が"],["、"],["キリスト"],["・"],["イエス"],["に"],["対する","たいする"],["信仰","しんこう"],["によって"],["救い","すくい"],["に"],["至る","いたる"],["知恵","ちえ"],["を"],["、"],["あなた"],["に"],["与え","あたえ"],["うる"],["書物","しょもつ"],["で"],["ある"],["こと"],["を"],["知って","しって"],["いる"],["。"]]},{"verse":16,"text":"聖書,せいしょは、すべて神,かみの霊,れい感,かんを受,うけて書,かかれたものであって、人,ひとを教,おしえ、戒,いましめ、正,ただしくし、義,ぎに導,みちびくのに有益,ゆうえきである。","tok":[["聖書","せいしょ"],["は"],["、"],["すべて"],["神","かみ"],["の"],["霊感","れいかん"],["を"],["受て","うけて"],["書かれた","かかれた"],["もの"],["で"],["あって"],["、"],["人","ひと"],["を"],["教え","おしえ"],["、"],["戒しめ","いましめ"],["、"],["正く","ただしく"],["し"],["、"],["義","ぎ"],["に"],["導く","みちびく"],["のに"],["有益","ゆうえき"],["で"],["ある"],["。"]]},{"verse":17,"text":"それによって、神,かみの人,ひとが、あらゆる良,よいわざに対,たいして十分,じゅうぶんな準備,じゅんびができて、完全,かんぜんにととのえられた者,ものになるのである。","tok":[["それ"],["によって"],["、"],["神","かみ"],["の"],["人","ひと"],["が"],["、"],["あらゆる"],["良い","よい"],["わざ"],["に対して","にたいして"],["十分","じゅうぶん"],["な"],["準備","じゅんび"],["が"],["できて"],["、"],["完全","かんぜん"],["に"],["ととのえられた"],["者","もの"],["に"],["なる"],["ので"],["ある"],["。"]]}]
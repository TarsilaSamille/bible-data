[{"verse":1,"text":"【ダビデがよんだ都,みやこもうでの歌,うた】人々,ひとびとがわたしにむかって「われらは主,しゅの家,いえに行,いこう」と言,いったとき、わたしは喜,よろこんだ。","tok":[["【"],["ダビデ"],["が"],["よんだ"],["都","みやこもう"],["で"],["の"],["歌","うた"],["】"],["人々","ひとびと"],["が"],["わたし"],["に"],["むかって"],["「"],["われ"],["ら"],["は"],["主","しゅ"],["の"],["家","いえ"],["に"],["行こう","いこう"],["」"],["と"],["言った","いった"],["とき"],["、"],["わたし"],["は"],["喜こんだ","よろこんだ"],["。"]]},{"verse":2,"text":"エルサレムよ、われらの足,あしはあなたの門,もんのうちに立,たっている。","tok":[["エルサレム"],["よ"],["、"],["われ"],["ら"],["の"],["足","あし"],["は"],["あなた"],["の"],["門","もん"],["の"],["うち"],["に"],["立って","たって"],["いる"],["。"]]},{"verse":3,"text":"しげくつらなった町,まちのように建,たてられているエルサレムよ、","tok":[["しげく"],["つらなった"],["町","まち"],["の"],["よう"],["に"],["建てられて","たてられて"],["いる"],["エルサレム"],["よ"],["、"]]},{"verse":4,"text":"もろもろの部族,ぶぞくすなわち主,しゅの部族,ぶぞくが、そこに上,のぼって来,きて主,しゅのみ名,なに感謝,かんしゃすることは、イスラエルのおきてである。","tok":[["もろもろ"],["の"],["部族","ぶぞく"],["すなわち"],["主","しゅ"],["の"],["部族","ぶぞく"],["が"],["、"],["そこ"],["に"],["上って","のぼって"],["来て","きて"],["主","しゅ"],["のみ"],["名","な"],["に"],["感謝","かんしゃ"],["する"],["こと"],["は"],["、"],["イスラエル"],["の"],["おきて"],["で"],["ある"],["。"]]},{"verse":5,"text":"そこにさばきの座,ざ、ダビデの家,いえの王座,おうざが設,もうけられてあった。","tok":[["そこ"],["に"],["さばき"],["の"],["座","ざ"],["、"],["ダビデ"],["の"],["家","いえ"],["の"],["王座","おうざ"],["が"],["設けられて","もうけられて"],["あった"],["。"]]},{"verse":6,"text":"エルサレムのために平安,へいあんを祈,いのれ、「エルサレムを愛,あいする者,ものは栄,さかえ、","tok":[["エルサレム"],["の"],["ため"],["に"],["平安","へいあん"],["を"],["祈れ","いのれ"],["、"],["「"],["エルサレム"],["を"],["愛する","あいする"],["者","もの"],["は"],["栄","さかえ"],["、"]]},{"verse":7,"text":"その城壁,じょうへきのうちに平安,へいあんがあり、もろもろの殿,とののうちに安全,あんぜんがあるように」と。","tok":[["その"],["城壁","じょうへき"],["の"],["うち"],["に"],["平安","へいあん"],["が"],["あり"],["、"],["もろもろ"],["の"],["殿","との"],["の"],["うち"],["に"],["安全","あんぜん"],["が"],["ある"],["よう"],["に"],["」"],["と"],["。"]]},{"verse":8,"text":"わが兄弟,きょうだいおよび友,とものために、わたしは「エルサレムのうちに平安,へいあんがあるように」と言,いい、","tok":[["わが"],["兄弟","きょうだい"],["および"],["友","とも"],["の"],["ため"],["に"],["、"],["わたし"],["は"],["「"],["エルサレム"],["の"],["うち"],["に"],["平安","へいあん"],["が"],["ある"],["よう"],["に"],["」"],["と"],["言い","いい"],["、"]]},{"verse":9,"text":"われらの神,かみ、主,しゅの家,いえのために、わたしはエルサレムのさいわいを求,もとめるであろう。","tok":[["われ"],["ら"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["家","いえ"],["の"],["ため"],["に"],["、"],["わたし"],["は"],["エルサレム"],["の"],["さいわい"],["を"],["求めるで","もとめるで"],["あろう"],["。"]]}]
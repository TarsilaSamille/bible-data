[{"verse":1,"text":"【都,みやこもうでの歌,うた】わたしは山,やまにむかって目,めをあげる。わが助,たすけは、どこから来,くるであろうか。","tok":[["【"],["都","みやこもう"],["で"],["の"],["歌","うた"],["】"],["わたし"],["は"],["山","やま"],["に"],["むかって"],["目","め"],["を"],["あげる"],["。"],["わが"],["助け","たすけ"],["は"],["、"],["どこ"],["から"],["来るで","くるで"],["あろう"],["か"],["。"]]},{"verse":2,"text":"わが助,たすけは、天,てんと地,ちを造,つくられた主,しゅから来,くる。","tok":[["わが"],["助け","たすけ"],["は"],["、"],["天","てん"],["と"],["地","ち"],["を"],["造られた","つくられた"],["主ら","しゅから"],["来る","くる"],["。"]]},{"verse":3,"text":"主,しゅはあなたの足,あしの動,うごかされるのをゆるされない。あなたを守,まもる者,ものはまどろむことがない。","tok":[["主","しゅ"],["は"],["あなた"],["の"],["足","あし"],["の"],["動かされる","うごかされる"],["の"],["を"],["ゆるされない"],["。"],["あなた"],["を"],["守者","まもるもの"],["は"],["まどろむ"],["こと"],["が"],["ない"],["。"]]},{"verse":4,"text":"見,みよ、イスラエルを守,まもる者,ものはまどろむこともなく、眠,ねむることもない。","tok":[["見よ","みよ"],["、"],["イスラエル"],["を"],["守者","まもるもの"],["は"],["まどろむ"],["こと"],["も"],["なく"],["、"],["眠る","ねむる"],["こと"],["も"],["ない"],["。"]]},{"verse":5,"text":"主,しゅはあなたを守,まもる者,もの、主,しゅはあなたの右,みぎの手,てをおおう陰,かげである。","tok":[["主","しゅ"],["は"],["あなた"],["を"],["守者","まもるもの"],["、"],["主","しゅ"],["は"],["あなた"],["の"],["右","みぎ"],["の"],["手","て"],["を"],["おおう"],["陰","かげ"],["で"],["ある"],["。"]]},{"verse":6,"text":"昼,ひるは太陽,たいようがあなたを撃,うつことなく、夜,よるは月,つきがあなたを撃,うつことはない。","tok":[["昼","ひる"],["は"],["太陽","たいよう"],["が"],["あなた"],["を"],["撃つ","うつ"],["こと"],["なく"],["、"],["夜","よる"],["は"],["月","つき"],["が"],["あなた"],["を"],["撃つ","うつ"],["こと"],["は"],["ない"],["。"]]},{"verse":7,"text":"主,しゅはあなたを守,まもって、すべての災,わざわいを免,まぬかれさせ、またあなたの命,いのちを守,まもられる。","tok":[["主","しゅ"],["は"],["あなた"],["を"],["守って","まもって"],["、"],["すべて"],["の"],["災","わざわい"],["を"],["免かれさせ","まぬかれさせ"],["、"],["また"],["あなた"],["の"],["命","いのち"],["を"],["守られる","まもられる"],["。"]]},{"verse":8,"text":"主,しゅは今,いまからとこしえに至,いたるまで、あなたの出,でると入,いるとを守,まもられるであろう。","tok":[["主","しゅ"],["は"],["今","いま"],["から"],["とこしえ"],["に"],["至る","いたる"],["まで"],["、"],["あなた"],["の"],["出る","でる"],["と"],["入","いると"],["を"],["守られるで","まもられるで"],["あろう"],["。"]]}]
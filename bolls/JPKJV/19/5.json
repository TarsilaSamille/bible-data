[{"verse":1,"text":"[0]【聖歌,せいか隊,たいの指揮者,しきしゃによって笛,ふえにあわせてうたわせたダビデの歌,うた】","tok":[["["],["0"],["]"],["【"],["聖歌隊","せいかたい"],["の"],["指揮者","しきしゃ"],["によって"],["笛","ふえ"],["に"],["あわせて"],["うたわせた"],["ダビデ"],["の"],["歌","うた"],["】"]]},{"verse":2,"text":"[1]主,しゅよ、わたしの言葉,ことばに耳,みみを傾,かたむけ、わたしの嘆,なげきに、み心,こころをとめてください。","tok":[["["],["1"],["]"],["主","しゅ"],["よ"],["、"],["わたし"],["の"],["言葉","ことば"],["に"],["耳","みみ"],["を"],["傾むけ","かたむけ"],["、"],["わたし"],["の"],["嘆き","なげき"],["に"],["、"],["み心","みこころ"],["を"],["とめて"],["ください"],["。"]]},{"verse":3,"text":"[2]わが王,おう、わが神,かみよ、わたしの叫,さけびの声,こえをお聞,ききください。わたしはあなたに祈,いのっています。","tok":[["["],["2"],["]"],["わが"],["王","おう"],["、"],["わが"],["神","かみ"],["よ"],["、"],["わたし"],["の"],["叫","さけび"],["の"],["声","こえ"],["を"],["お聞く","おききく"],["ださい"],["。"],["わたし"],["は"],["あなた"],["に"],["祈って","いのって"],["います"],["。"]]},{"verse":4,"text":"[3]主,しゅよ、朝,あさごとにあなたはわたしの声,こえを聞,きかれます。わたしは朝,あさごとにあなたのためにいけにえを備,そなえて待,まち望,のぞみます。","tok":[["["],["3"],["]"],["主","しゅ"],["よ"],["、"],["朝","あさ"],["ごと"],["に"],["あなた"],["は"],["わたし"],["の"],["声","こえ"],["を"],["聞かれます","きかれます"],["。"],["わたし"],["は"],["朝","あさ"],["ごと"],["に"],["あなた"],["の"],["ため"],["に"],["いけにえ"],["を"],["備","そなえ"],["て"],["待望みます","まちのぞみます"],["。"]]},{"verse":5,"text":"[4]あなたは悪,あしき事,ことを喜,よろこばれる神,かみではない。悪人,あくにんはあなたのもとに身,みを寄,よせることはできない。","tok":[["["],["4"],["]"],["あなた"],["は"],["悪しき","あしき"],["事","こと"],["を"],["喜こばれる","よろこばれる"],["神","かみ"],["で"],["は"],["ない"],["。"],["悪人","あくにん"],["は"],["あなた"],["の"],["もと"],["に"],["身","み"],["を"],["寄せる","よせる"],["こと"],["は"],["できない"],["。"]]},{"verse":6,"text":"[5]高,たかぶる者,ものはあなたの目,めの前,まえに立,たつことはできない。あなたはすべて悪,あくを行,おこなう者,ものを憎,にくまれる。","tok":[["["],["5"],["]"],["高か","たか"],["ぶる"],["者","もの"],["は"],["あなた"],["の"],["目","め"],["の"],["前","まえ"],["に"],["立つ","たつ"],["こと"],["は"],["できない"],["。"],["あなた"],["は"],["すべて"],["悪","あく"],["を"],["行なう","おこなう"],["者","もの"],["を"],["憎まれる","にくまれる"],["。"]]},{"verse":7,"text":"[6]あなたは偽,いつわりを言,いう者,ものを滅,ほろぼされる。主,しゅは血,ちを流,ながす者,ものと、人,ひとをだます者,ものを忌,いみきらわれる。","tok":[["["],["6"],["]"],["あなた"],["は"],["偽り","いつわり"],["を"],["言う","いう"],["者","もの"],["を"],["滅ぼされる","ほろぼされる"],["。"],["主","しゅ"],["は"],["血","ち"],["を"],["流す","ながす"],["者","もの"],["と"],["、"],["人","ひと"],["を"],["だます"],["者","もの"],["を"],["忌","いみ"],["きらわれる"],["。"]]},{"verse":8,"text":"[7]しかし、わたしはあなたの豊,ゆたかないつくしみによって、あなたの家,いえに入,いり、聖,せいなる宮,みやにむかって、かしこみ伏,ふし拝,おがみます。","tok":[["["],["7"],["]"],["しかし"],["、"],["わたし"],["は"],["あなた"],["の"],["豊","ゆたか"],["な"],["いつくしみ"],["によって"],["、"],["あなた"],["の"],["家","いえ"],["に"],["入","いり"],["、"],["聖","せい"],["なる"],["宮","みや"],["に"],["むかって"],["、"],["かしこみ"],["伏し拝みます","ふしおがみます"],["。"]]},{"verse":9,"text":"[8]主,しゅよ、わたしのあだのゆえに、あなたの義,ぎをもってわたしを導,みちびき、わたしの前,まえにあなたの道,みちをまっすぐにしてください。","tok":[["["],["8"],["]"],["主","しゅ"],["よ"],["、"],["わたし"],["の"],["あだ"],["の"],["ゆえ"],["に"],["、"],["あなた"],["の"],["義","ぎ"],["を"],["もって"],["わたし"],["を"],["導き","みちびき"],["、"],["わたし"],["の"],["前","まえ"],["に"],["あなた"],["の"],["道","みち"],["を"],["まっすぐ"],["に"],["して"],["ください"],["。"]]},{"verse":10,"text":"[9]彼,かれらの口,くちには真実,しんじつがなく、彼,かれらの心,こころには滅,ほろびがあり、そののどは開,ひらいた墓,はか、その舌,したはへつらいを言,いうのです。","tok":[["["],["9"],["]"],["彼","かれ"],["ら"],["の"],["口","くち"],["に"],["は"],["真実","しんじつ"],["が"],["なく"],["、"],["彼","かれ"],["ら"],["の"],["心","こころ"],["に"],["は"],["滅び","ほろび"],["が"],["あり"],["、"],["その"],["のど"],["は"],["開らいた","ひらいた"],["墓","はか"],["、"],["その"],["舌","した"],["は"],["へつらい"],["を"],["言う","いう"],["の"],["です"],["。"]]},{"verse":11,"text":"[10]神,かみよ、どうか彼,かれらにその罪,つみを負,おわせ、そのはかりごとによって、みずから倒,たおれさせ、その多,おおくのとがのゆえに彼,かれらを追,おいだしてください。彼,かれらはあなたにそむいたからです。","tok":[["["],["10"],["]"],["神","かみ"],["よ"],["、"],["どう"],["か"],["彼","かれ"],["ら"],["に"],["その"],["罪","つみ"],["を"],["負わせ","おわせ"],["、"],["その"],["はかりごと"],["によって"],["、"],["みずから"],["倒れさせ","たおれさせ"],["、"],["その"],["多く","おおく"],["の"],["とが"],["の"],["ゆえ"],["に"],["彼","かれ"],["ら"],["を"],["追いだして","おいだして"],["ください"],["。"],["彼","かれ"],["ら"],["は"],["あなた"],["に"],["そむいた"],["から"],["です"],["。"]]},{"verse":12,"text":"[11]しかし、すべてあなたに寄,より頼,たのむ者,ものを喜,よろこばせ、とこしえに喜,よろこび呼,よばわらせてください。また、み名,なを愛,あいする者,ものがあなたによって喜,よろこびを得,えるように、彼,かれらをお守,まもりください。","tok":[["["],["11"],["]"],["しかし"],["、"],["すべて"],["あなた"],["に"],["寄り","より"],["頼む","たのむ"],["者","もの"],["を"],["喜こばせ","よろこばせ"],["、"],["とこしえ"],["に"],["喜こび","よろこび"],["呼ばわらせて","よばわらせて"],["ください"],["。"],["また"],["、"],["み名","みな"],["を"],["愛する","あいする"],["者","もの"],["が"],["あなた"],["によって"],["喜こび","よろこび"],["を"],["得る","える"],["よう"],["に"],["、"],["彼","かれ"],["ら"],["を"],["お守り","おまもり"],["ください"],["。"]]},{"verse":13,"text":"[12]主,しゅよ、あなたは正,ただしい者,ものを祝福,しゅくふくし、盾,たてをもってするように、恵,めぐみをもってこれをおおい守,まもられます。","tok":[["["],["12"],["]"],["主","しゅ"],["よ"],["、"],["あなた"],["は"],["正い","ただしい"],["者","もの"],["を"],["祝福","しゅくふく"],["し"],["、"],["盾","たて"],["を"],["もって"],["する"],["よう"],["に"],["、"],["恵","めぐみ"],["を"],["もって"],["これ"],["を"],["おおい"],["守られます","まもられます"],["。"]]}]
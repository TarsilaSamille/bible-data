[{"verse":1,"text":"さあ、われらは主,しゅにむかって歌,うたい、われらの救,すくいの岩,いわにむかって喜,よろこばしい声,こえをあげよう。","tok":[["さあ"],["、"],["われ"],["ら"],["は"],["主に","しゅに"],["むか"],["って"],["歌い","うたい"],["、"],["われ"],["ら"],["の"],["救い","すくい"],["の"],["岩","いわ"],["に"],["むかって"],["喜こば","よろこば"],["しい声","しいこえ"],["を"],["あげよう"],["。"]]},{"verse":2,"text":"われらは感謝,かんしゃをもって、み前,まえに行,いき、主,しゅにむかい、さんびの歌,うたをもって、喜,よろこばしい声,こえをあげよう。","tok":[["われ"],["ら"],["は"],["感謝","かんしゃ"],["を"],["もって"],["、"],["み前","みまえ"],["に"],["行き","いき"],["、"],["主に","しゅに"],["むかい"],["、"],["さん"],["び"],["の"],["歌","うた"],["を"],["もって"],["、"],["喜こば","よろこば"],["しい声","しいこえ"],["を"],["あげよう"],["。"]]},{"verse":3,"text":"主,しゅは大,おおいなる神,かみ、すべての神,かみにまさって大,おおいなる王,おうだからである。","tok":[["主","しゅ"],["は"],["大いなる","おおいなる"],["神","かみ"],["、"],["すべて"],["の"],["神","かみ"],["に"],["まさって"],["大いなる","おおいなる"],["王","おう"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":4,"text":"地,ちの深,ふかい所,ところは主,しゅのみ手,てにあり、山々,やまやまの頂,いただきもまた主,しゅのものである。","tok":[["地","ち"],["の"],["深い","ふかい"],["所","ところ"],["は"],["主","しゅ"],["のみ"],["手","て"],["に"],["あり"],["、"],["山々","やまやま"],["の"],["頂","いただき"],["も"],["また"],["主","しゅ"],["の"],["もの"],["で"],["ある"],["。"]]},{"verse":5,"text":"海,うみは主,しゅのもの、主,しゅはこれを造,つくられた。またそのみ手,てはかわいた地,ちを造,つくられた。","tok":[["海","うみ"],["は"],["主","しゅ"],["の"],["もの"],["、"],["主","しゅ"],["は"],["これ"],["を"],["造られた","つくられた"],["。"],["また"],["その"],["み手","みて"],["は"],["かわいた"],["地","ち"],["を"],["造られた","つくられた"],["。"]]},{"verse":6,"text":"さあ、われらは拝,おがみ、ひれ伏,ふし、われらの造,つくり主,ぬし、主,しゅのみ前,まえにひざまずこう。","tok":[["さあ"],["、"],["われ"],["ら"],["は"],["拝み","おがみ"],["、"],["ひれ伏し","ひれふし"],["、"],["われ"],["ら"],["の"],["造主","つくりぬし"],["、"],["主","しゅ"],["のみ"],["前","まえ"],["に"],["ひざまずこう"],["。"]]},{"verse":7,"text":"主,しゅはわれらの神,かみであり、われらはその牧,ぼくの民,たみ、そのみ手,ての羊,ひつじである。どうか、あなたがたは、きょう、そのみ声,こえを聞,きくように。","tok":[["主","しゅ"],["は"],["われ"],["ら"],["の"],["神","かみ"],["で"],["あり"],["、"],["われ"],["ら"],["は"],["その"],["牧","ぼく"],["の"],["民","たみ"],["、"],["その"],["み手","みて"],["の"],["羊","ひつじ"],["で"],["ある"],["。"],["どう"],["か"],["、"],["あなた"],["がた"],["は"],["、"],["きょう"],["、"],["その"],["み声","みこえ"],["を"],["聞く","きく"],["よう"],["に"],["。"]]},{"verse":8,"text":"あなたがたは、メリバにいた時,ときのように、また荒野,あらののマッサにいた日,ひのように、心,こころをかたくなにしてはならない。","tok":[["あなた"],["がた"],["は"],["、"],["メリバ"],["に"],["いた"],["時","とき"],["の"],["よう"],["に"],["、"],["また"],["荒野","あら"],["の"],["の"],["マッサ"],["に"],["いた"],["日","ひ"],["の"],["よう"],["に"],["、"],["心","こころ"],["を"],["かたくな"],["に"],["して"],["は"],["ならない"],["。"]]},{"verse":9,"text":"あの時,とき、あなたがたの先祖,せんぞたちはわたしのわざを見,みたにもかかわらず、わたしを試,こころみ、わたしをためした。","tok":[["あの"],["時","とき"],["、"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["たち"],["は"],["わたし"],["の"],["わざ"],["を"],["見た","みた"],["に"],["も"],["かかわらず"],["、"],["わたし"],["を"],["試み","こころみ"],["、"],["わたし"],["を"],["ためした"],["。"]]},{"verse":10,"text":"わたしは四十年,ねんの間,あいだ、その代,よをきらって言,いった、「彼,かれらは心,こころの誤,あやまっている民,たみであって、わたしの道,みちを知,しらない」と。","tok":[["わたし"],["は"],["四十","よんじゅう"],["年","ねん"],["の"],["間","あいだ"],["、"],["その"],["代","よ"],["を"],["きら"],["って"],["言った","いった"],["、"],["「"],["彼","かれ"],["ら"],["は"],["心","こころ"],["の"],["誤って","あやまって"],["いる"],["民","たみ"],["で"],["あって"],["、"],["わたし"],["の"],["道","みち"],["を"],["知らない","しらない"],["」"],["と"],["。"]]},{"verse":11,"text":"それゆえ、わたしは憤,いきどおって、彼,かれらはわが安息,あんそくに入,いることができないと誓,ちかった。","tok":[["それ"],["ゆえ"],["、"],["わたし"],["は"],["憤って","いきどおって"],["、"],["彼","かれ"],["ら"],["は"],["わが"],["安息","あんそく"],["に"],["入","いる"],["こと"],["が"],["できない"],["と"],["誓った","ちかった"],["。"]]}]
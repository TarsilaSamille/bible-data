[{"verse":1,"text":"[0]【聖歌,せいか隊,たいの指揮者,しきしゃによってうたわせたダビデの歌,うた】","tok":[["["],["0"],["]"],["【"],["聖歌隊","せいかたい"],["の"],["指揮者","しきしゃ"],["によって"],["うたわせた"],["ダビデ"],["の"],["歌","うた"],["】"]]},{"verse":2,"text":"[1]主,しゅよ、わたしはあなたに寄,より頼,たのみます。とこしえにわたしをはずかしめず、あなたの義,ぎをもってわたしをお助,たすけください。","tok":[["["],["1"],["]"],["主","しゅ"],["よ"],["、"],["わたし"],["は"],["あなた"],["に"],["寄り","より"],["頼みます","たのみます"],["。"],["とこしえ"],["に"],["わたし"],["を"],["はずかしめず"],["、"],["あなた"],["の"],["義","ぎ"],["を"],["もって"],["わたし"],["を"],["お助け","おたすけ"],["ください"],["。"]]},{"verse":3,"text":"[2]あなたの耳,みみをわたしに傾,かたむけて、すみやかにわたしをお救,すくいください。わたしのためにのがれの岩,いわとなり、わたしを救,すくう堅固,けんごな城,しろとなってください。","tok":[["["],["2"],["]"],["あなた"],["の"],["耳","みみ"],["を"],["わたし"],["に"],["傾むけて","かたむけて"],["、"],["すみやか"],["に"],["わたし"],["を"],["お救い","おすくい"],["ください"],["。"],["わたし"],["の"],["ため"],["に"],["のがれ"],["の"],["岩","いわ"],["と"],["なり"],["、"],["わたし"],["を"],["救う","すくう"],["堅固","けんご"],["な"],["城","しろ"],["と"],["なって"],["ください"],["。"]]},{"verse":4,"text":"[3]まことに、あなたはわたしの岩,いわ、わたしの城,しろです。み名,なのためにわたしを引,ひき、わたしを導,みちびき、","tok":[["["],["3"],["]"],["まこと"],["に"],["、"],["あなた"],["は"],["わたし"],["の"],["岩","いわ"],["、"],["わたし"],["の"],["城","しろ"],["です"],["。"],["み名","みな"],["の"],["ため"],["に"],["わたし"],["を"],["引","ひき"],["、"],["わたし"],["を"],["導き","みちびき"],["、"]]},{"verse":5,"text":"[4]わたしのためにひそかに設,もうけた網,あみからわたしを取,とり出,だしてください。あなたはわたしの避,さけ所,どころです。","tok":[["["],["4"],["]"],["わたし"],["の"],["ため"],["に"],["ひそか"],["に"],["設けた","もうけた"],["網","あみ"],["から"],["わたし"],["を"],["取出して","とりだして"],["ください"],["。"],["あなた"],["は"],["わたし"],["の"],["避け","さけ"],["所","ど"],["ころ"],["です"],["。"]]},{"verse":6,"text":"[5]わたしは、わが魂,たましいをみ手,てにゆだねます。主,しゅ、まことの神,かみよ、あなたはわたしをあがなわれました。","tok":[["["],["5"],["]"],["わたし"],["は"],["、"],["わが"],["魂","たましい"],["を"],["み手","みて"],["に"],["ゆだねます"],["。"],["主","しゅ"],["、"],["まこと"],["の"],["神","かみ"],["よ"],["、"],["あなた"],["は"],["わたし"],["を"],["あがなわれました"],["。"]]},{"verse":7,"text":"[6]あなたはむなしい偶像,ぐうぞうに心,こころを寄,よせる者,ものを憎,にくまれます。しかしわたしは主,しゅに信頼,しんらいし、","tok":[["["],["6"],["]"],["あなた"],["は"],["むなしい"],["偶像","ぐうぞう"],["に"],["心","こころ"],["を"],["寄せる","よせる"],["者","もの"],["を"],["憎まれます","にくまれます"],["。"],["しかし"],["わたし"],["は"],["主に","しゅに"],["信頼","しんらい"],["し"],["、"]]},{"verse":8,"text":"[7]あなたのいつくしみを喜,よろこび楽,たのしみます。あなたがわたしの苦,くるしみをかえりみ、わたしの悩,なやみにみこころをとめ、","tok":[["["],["7"],["]"],["あなた"],["の"],["いつくしみ"],["を"],["喜こび","よろこび"],["楽しみます","たのしみます"],["。"],["あなた"],["が"],["わたし"],["の"],["苦しみ","くるしみ"],["を"],["かえりみ"],["、"],["わたし"],["の"],["悩み","なやみ"],["に"],["みこころ"],["を"],["とめ"],["、"]]},{"verse":9,"text":"[8]わたしを敵,てきの手,てにわたさず、わたしの足,あしを広,ひろい所,ところに立,たたせられたからです。","tok":[["["],["8"],["]"],["わたし"],["を"],["敵","てき"],["の"],["手","て"],["に"],["わたさず"],["、"],["わたし"],["の"],["足","あし"],["を"],["広い","ひろい"],["所","ところ"],["に"],["立たせられた","たたせられた"],["から"],["です"],["。"]]},{"verse":10,"text":"[9]主,しゅよ、わたしをあわれんでください。わたしは悩,なやみ苦,くるしんでいます。わたしの目,めは憂,うれいによって衰,おとろえ、わたしの魂,たましいも、からだもまた衰,おとろえました。","tok":[["["],["9"],["]"],["主","しゅ"],["よ"],["、"],["わたし"],["を"],["あわれんで"],["ください"],["。"],["わたし"],["は"],["悩み苦しんで","なやみくるしんで"],["います"],["。"],["わたし"],["の"],["目","め"],["は"],["憂","うれい"],["によって"],["衰え","おとろえ"],["、"],["わたし"],["の"],["魂","たましい"],["も"],["、"],["からだ"],["も"],["また"],["衰えました","おとろえました"],["。"]]},{"verse":11,"text":"[10]わたしのいのちは悲,かなしみによって消,きえゆき、わたしの年,としは嘆,なげきによって消,きえさり、わたしの力,ちからは苦,くるしみによって尽,つき、わたしの骨,ほねは枯,かれはてました。","tok":[["["],["10"],["]"],["わたし"],["の"],["いのち"],["は"],["悲しみ","かなしみ"],["によって"],["消えゆき","きえゆき"],["、"],["わたし"],["の"],["年","とし"],["は"],["嘆き","なげき"],["によって"],["消えさり","きえさり"],["、"],["わたし"],["の"],["力","ちから"],["は"],["苦しみ","くるしみ"],["によって"],["尽き","つき"],["、"],["わたし"],["の"],["骨","ほね"],["は"],["枯","かれ"],["はてました"],["。"]]},{"verse":12,"text":"[11]わたしはすべてのあだにそしられる者,ものとなり、隣,となり人,びとには恐,おそれられ、知,しり人,ひとには恐,おそるべき者,ものとなり、ちまたでわたしを見,みる者,ものは避,さけて逃,にげます。","tok":[["["],["11"],["]"],["わたし"],["は"],["すべて"],["の"],["あだ"],["に"],["そしられる"],["者","もの"],["と"],["なり"],["、"],["隣人","となりびと"],["に"],["は"],["恐","おそれ"],["られ"],["、"],["知り人","しりひと"],["に"],["は"],["恐るべき","おそるべき"],["者","もの"],["と"],["なり"],["、"],["ちまた"],["で"],["わたし"],["を"],["見る","みる"],["者","もの"],["は"],["避けて","さけて"],["逃ます","にげます"],["。"]]},{"verse":13,"text":"[12]わたしは死,しんだ者,もののように人,ひとの心,こころに忘,わすれられ、破,やぶれた器,うつわのようになりました。","tok":[["["],["12"],["]"],["わたし"],["は"],["死んだ","しんだ"],["者","もの"],["の"],["よう"],["に"],["人","ひと"],["の"],["心","こころ"],["に"],["忘られ","わすれられ"],["、"],["破れた","やぶれた"],["器","うつわ"],["の"],["よう"],["に"],["なりました"],["。"]]},{"verse":14,"text":"[13]まことに、わたしは多,おおくの人,ひとのささやくのを聞,ききます、「至,いたる所,ところに恐,おそるべきことがある」と。彼,かれらはわたしに逆,さからってともに計,はかり、わたしのいのちを取,とろうと、たくらむのです。","tok":[["["],["13"],["]"],["まこと"],["に"],["、"],["わたし"],["は"],["多く","おおく"],["の"],["人","ひと"],["の"],["ささやく"],["の"],["を"],["聞","きき"],["ます"],["、"],["「"],["至る所","いたるところ"],["に"],["恐るべき","おそるべき"],["こと"],["が"],["ある"],["」"],["と"],["。"],["彼","かれ"],["ら"],["は"],["わたし"],["に"],["逆らって","さからって"],["とも"],["に"],["計り","はかり"],["、"],["わたし"],["の"],["いのち"],["を"],["取ろう","とろう"],["と"],["、"],["たくらむ"],["の"],["です"],["。"]]},{"verse":15,"text":"[14]しかし、主,しゅよ、わたしはあなたに信頼,しんらいして、言,いいます、「あなたはわたしの神,かみである」と。","tok":[["["],["14"],["]"],["しかし"],["、"],["主","しゅ"],["よ"],["、"],["わたし"],["は"],["あなた"],["に"],["信頼","しんらい"],["して"],["、"],["言います","いいます"],["、"],["「"],["あなた"],["は"],["わたし"],["の"],["神","かみ"],["で"],["ある"],["」"],["と"],["。"]]},{"verse":16,"text":"[15]わたしの時,ときはあなたのみ手,てにあります。わたしをわたしの敵,てきの手,てと、わたしを責,せめ立,たてる者,ものから救,すくい出,だしてください。","tok":[["["],["15"],["]"],["わたし"],["の"],["時","とき"],["は"],["あなた"],["のみ"],["手","て"],["に"],["あります"],["。"],["わたし"],["を"],["わたし"],["の"],["敵","てき"],["の"],["手","て"],["と"],["、"],["わたし"],["を"],["責","せめ"],["立る","たてる"],["者","もの"],["から"],["救い出して","すくいだして"],["ください"],["。"]]},{"verse":17,"text":"[16]み顔,かおをしもべの上,うえに輝,かがやかせ、いつくしみをもってわたしをお救,すくいください。","tok":[["["],["16"],["]"],["み顔","みかお"],["を"],["しもべ"],["の"],["上","うえ"],["に"],["輝やかせ","かがやかせ"],["、"],["いつくしみ"],["を"],["もって"],["わたし"],["を"],["お救い","おすくい"],["ください"],["。"]]},{"verse":18,"text":"[17]主,しゅよ、わたしはあなたに呼,よばわります、わたしをはずかしめないでください。悪,あしき者,ものに恥,はじをうけさせ、彼,かれらに声,こえをあげさせずに陰府,よみに行,いかせてください。","tok":[["["],["17"],["]"],["主","しゅ"],["よ"],["、"],["わたし"],["は"],["あなた"],["に"],["呼ばわります","よばわります"],["、"],["わたし"],["を"],["はずかしめないで"],["ください"],["。"],["悪しき","あしき"],["者","もの"],["に"],["恥","はじ"],["を"],["うけさせ"],["、"],["彼","かれ"],["ら"],["に"],["声","こえ"],["を"],["あげさせず"],["に"],["陰府","よみ"],["に"],["行かせて","いかせて"],["ください"],["。"]]},{"verse":19,"text":"[18]高,たかぶりと侮,あなどりとをもって正,ただしい者,ものをみだりにそしる偽,いつわりのくちびるをつぐませてください。","tok":[["["],["18"],["]"],["高か","たか"],["ぶり"],["と"],["侮","あなどり"],["と"],["を"],["もって"],["正い","ただしい"],["者","もの"],["を"],["みだり"],["に"],["そしる"],["偽わり","いつわり"],["の"],["くちびる"],["を"],["つぐませて"],["ください"],["。"]]},{"verse":20,"text":"[19]あなたを恐,おそれる者,もののためにたくわえ、あなたに寄,より頼,たのむ者,もののために人,ひとの子,こらの前,まえに施,ほどこされたあなたの恵,めぐみはいかに大,おおいなるものでしょう。","tok":[["["],["19"],["]"],["あなた"],["を"],["恐れる","おそれる"],["者","もの"],["の"],["ため"],["に"],["たくわえ"],["、"],["あなた"],["に"],["寄り","より"],["頼む","たのむ"],["者","もの"],["の"],["ため"],["に"],["人","ひと"],["の"],["子","こ"],["ら"],["の"],["前","まえ"],["に"],["施された","ほどこされた"],["あなた"],["の"],["恵","めぐみ"],["は"],["いかに"],["大いなる","おおいなる"],["もの"],["でしょう"],["。"]]},{"verse":21,"text":"[20]あなたは彼,かれらをみ前,まえのひそかな所,ところに隠,かくして人々,ひとびとのはかりごとを免,まぬかれさせ、また仮屋,かりやのうちに潜,ひそませて舌,したの争,あらそいを避,さけさせられます。","tok":[["["],["20"],["]"],["あなた"],["は"],["彼","かれ"],["ら"],["を"],["み前","みまえ"],["の"],["ひそか"],["な"],["所","ところ"],["に"],["隠して","かくして"],["人々","ひとびと"],["の"],["はかりごと"],["を"],["免かれさせ","まぬかれさせ"],["、"],["また"],["仮屋","かりや"],["の"],["うち"],["に"],["潜ませて","ひそませて"],["舌","した"],["の"],["争い","あらそい"],["を"],["避けさせられます","さけさせられます"],["。"]]},{"verse":22,"text":"[21]主,しゅはほむべきかな、包囲,ほういされた町,まちのようにわたしが囲,かこまれたとき、主,しゅは驚,おどろくばかりに、いつくしみをわたしに示,しめされた。","tok":[["["],["21"],["]"],["主","しゅ"],["は"],["ほ"],["むべき"],["か"],["な"],["、"],["包囲","ほうい"],["された"],["町","まち"],["の"],["よう"],["に"],["わたし"],["が"],["囲まれた","かこまれた"],["とき"],["、"],["主","しゅ"],["は"],["驚ろく","おどろく"],["ばかり"],["に"],["、"],["いつくしみ"],["を"],["わたし"],["に"],["示めされた","しめされた"],["。"]]},{"verse":23,"text":"[22]わたしは驚,おどろきあわてて言,いった、「わたしはあなたの目,めの前,まえから断,たたれた」と。しかしわたしがあなたに助,たすけを呼,よび求,もとめたとき、わたしの願,ねがいを聞,ききいれられた。","tok":[["["],["22"],["]"],["わたし"],["は"],["驚","おどろき"],["あわてて"],["言った","いった"],["、"],["「"],["わたし"],["は"],["あなた"],["の"],["目","め"],["の"],["前","まえ"],["から"],["断たれた","たたれた"],["」"],["と"],["。"],["しかし"],["わたし"],["が"],["あなた"],["に"],["助け","たすけ"],["を"],["呼び求めた","よびもとめた"],["とき"],["、"],["わたし"],["の"],["願い","ねがい"],["を"],["聞きいれられた","ききいれられた"],["。"]]},{"verse":24,"text":"[23]すべての聖徒,せいとよ、主,しゅを愛,あいせよ。主,しゅは真実,しんじつな者,ものを守,まもられるが、おごりふるまう者,ものにはしたたかに報,むくいられる。","tok":[["["],["23"],["]"],["すべて"],["の"],["聖徒","せいと"],["よ"],["、"],["主","しゅ"],["を"],["愛せよ","あいせよ"],["。"],["主","しゅ"],["は"],["真実","しんじつ"],["な"],["者","もの"],["を"],["守られる","まもられる"],["が"],["、"],["おごり"],["ふるまう"],["者","もの"],["に"],["は"],["したたか"],["に"],["報いられる","むくいられる"],["。"]]},{"verse":25,"text":"[24]すべて主,しゅを待,まち望,のぞむ者,ものよ、強,つよくあれ、心,こころを雄々,おおしくせよ。","tok":[["["],["24"],["]"],["すべて"],["主","しゅ"],["を"],["待ち望む","まちのぞむ"],["者","もの"],["よ"],["、"],["強く","つよく"],["あれ"],["、"],["心","こころ"],["を"],["雄々しく","おおしく"],["せよ"],["。"]]}]
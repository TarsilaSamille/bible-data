[{"verse":1,"text":"【都,みやこもうでの歌,うた】主,しゅに信頼,しんらいする者,ものは、動,うごかされることなくて、とこしえにあるシオンの山,やまのようである。","tok":[["【"],["都","みやこもう"],["で"],["の"],["歌","うた"],["】"],["主に","しゅに"],["信頼","しんらい"],["する"],["者","もの"],["は"],["、"],["動かされる","うごかされる"],["こと"],["なくて"],["、"],["とこしえ"],["に"],["ある"],["シオン"],["の"],["山","やま"],["の"],["よう"],["で"],["ある"],["。"]]},{"verse":2,"text":"山々,やまやまがエルサレムを囲,かこんでいるように、主,しゅは今,いまからとこしえにその民,たみを囲,かこまれる。","tok":[["山々","やまやま"],["が"],["エルサレム"],["を"],["囲んで","かこんで"],["いる"],["よう"],["に"],["、"],["主","しゅ"],["は"],["今","いま"],["から"],["とこしえ"],["に"],["その"],["民","たみ"],["を"],["囲まれる","かこまれる"],["。"]]},{"verse":3,"text":"これは悪,あしき者,もののつえが正,ただしい者,ものの所領,しょりょうにとどまることなく、正,ただしい者,ものがその手,てを不義,ふぎに伸,のべることのないためである。","tok":[["これ"],["は"],["悪しき","あしき"],["者","もの"],["の"],["つえ"],["が"],["正い","ただしい"],["者","もの"],["の"],["所領","しょりょう"],["に"],["とどまる"],["こと"],["なく"],["、"],["正い","ただしい"],["者","もの"],["が"],["その"],["手","て"],["を"],["不義","ふぎ"],["に"],["伸べる","のべる"],["こと"],["の"],["ない"],["ため"],["で"],["ある"],["。"]]},{"verse":4,"text":"主,しゅよ、善良,ぜんりょうな人,ひとと、心,こころの正,ただしい人,ひととに、さいわいを施,ほどこしてください。","tok":[["主","しゅ"],["よ"],["、"],["善良","ぜんりょう"],["な"],["人","ひと"],["と"],["、"],["心","こころ"],["の"],["正い","ただしい"],["人","ひと"],["と"],["に"],["、"],["さいわい"],["を"],["施して","ほどこして"],["ください"],["。"]]},{"verse":5,"text":"しかし転,てんじて自分,じぶんの曲,まがった道,みちに入,いる者,ものを主,しゅは、悪,あくを行,おこなう者,ものと共,ともに去,さらせられる。イスラエルの上,うえに平安,へいあんがあるように。","tok":[["しかし"],["転じて","てんじて"],["自分","じぶん"],["の"],["曲がった","まがった"],["道","みち"],["に"],["入る","いる"],["者","もの"],["を"],["主","しゅ"],["は"],["、"],["悪","あく"],["を"],["行なう","おこなう"],["者","もの"],["と"],["共","とも"],["に"],["去らせられる","さらせられる"],["。"],["イスラエル"],["の"],["上","うえ"],["に"],["平安","へいあん"],["が"],["ある"],["よう"],["に"],["。"]]}]
[{"verse":1,"text":"【ダビデの歌,うた】悪,あくをなす者,もののゆえに、心,こころを悩,なやますな。不義,ふぎを行,おこなう者,もののゆえに、ねたみを起,おこすな。","tok":[["【"],["ダビデ"],["の"],["歌","うた"],["】"],["悪","あく"],["を"],["なす"],["者","もの"],["の"],["ゆえ"],["に"],["、"],["心","こころ"],["を"],["悩す","なやます"],["な"],["。"],["不義","ふぎ"],["を"],["行なう","おこなう"],["者","もの"],["の"],["ゆえ"],["に"],["、"],["ねたみ"],["を"],["起こす","おこす"],["な"],["。"]]},{"verse":2,"text":"彼,かれらはやがて草,くさのように衰,おとろえ、青菜,あおなのようにしおれるからである。","tok":[["彼","かれ"],["ら"],["は"],["やがて"],["草","くさ"],["の"],["よう"],["に"],["衰え","おとろえ"],["、"],["青菜","あおな"],["の"],["よう"],["に"],["しおれる"],["から"],["で"],["ある"],["。"]]},{"verse":3,"text":"主,しゅに信頼,しんらいして善,ぜんを行,おこなえ。そうすればあなたはこの国,くにに住,すんで、安,やすきを得,える。","tok":[["主に","しゅに"],["信頼","しんらい"],["して"],["善","ぜん"],["を"],["行なえ","おこなえ"],["。"],["そう"],["すれば"],["あなた"],["は"],["この"],["国","くに"],["に"],["住んで","すんで"],["、"],["安き","やすき"],["を"],["得る","える"],["。"]]},{"verse":4,"text":"主,しゅによって喜,よろこびをなせ。主,しゅはあなたの心,こころの願,ねがいをかなえられる。","tok":[["主に","しゅに"],["よって"],["喜こび","よろこび"],["を"],["なせ"],["。"],["主","しゅ"],["は"],["あなた"],["の"],["心","こころ"],["の"],["願い","ねがい"],["を"],["かなえられる"],["。"]]},{"verse":5,"text":"あなたの道,みちを主,しゅにゆだねよ。主,しゅに信頼,しんらいせよ、主,しゅはそれをなしとげ、","tok":[["あなた"],["の"],["道","みち"],["を"],["主に","しゅに"],["ゆだね"],["よ"],["。"],["主に","しゅに"],["信頼","しんらい"],["せよ"],["、"],["主","しゅ"],["は"],["それ"],["を"],["なしとげ"],["、"]]},{"verse":6,"text":"あなたの義,ぎを光,ひかりのように明,あきらかにし、あなたの正,ただしいことを真昼,まひるのように明,あきらかにされる。","tok":[["あなた"],["の"],["義","ぎ"],["を"],["光","ひかり"],["の"],["よう"],["に"],["明か","あきらか"],["に"],["し"],["、"],["あなた"],["の"],["正い","ただしい"],["こと"],["を"],["真昼","まひる"],["の"],["よう"],["に"],["明か","あきらか"],["に"],["される"],["。"]]},{"verse":7,"text":"主,しゅの前,まえにもだし、耐,たえ忍,しのびて主,しゅを待,まち望,のぞめ。おのが道,みちを歩,あゆんで栄,さかえる者,もののゆえに、悪,わるいはかりごとを遂,とげる人,ひとのゆえに、心,こころを悩,なやますな。","tok":[["主","しゅ"],["の"],["前","まえ"],["に"],["もだし"],["、"],["耐え忍びて","たえしのびて"],["主","しゅ"],["を"],["待ち望め","まちのぞめ"],["。"],["お"],["の"],["が"],["道","みち"],["を"],["歩んで","あゆんで"],["栄","さかえ"],["る"],["者","もの"],["の"],["ゆえ"],["に"],["、"],["悪い","わるい"],["はかりごと"],["を"],["遂げる","とげる"],["人","ひと"],["の"],["ゆえ"],["に"],["、"],["心","こころ"],["を"],["悩す","なやます"],["な"],["。"]]},{"verse":8,"text":"怒,いかりをやめ、憤,いきどおりを捨,すてよ。心,こころを悩,なやますな、これはただ悪,あくを行,おこなうに至,いたるのみだ。","tok":[["怒り","いかり"],["を"],["やめ"],["、"],["憤り","いきどおり"],["を"],["捨てよ","すてよ"],["。"],["心","こころ"],["を"],["悩す","なやます"],["な"],["、"],["これ"],["は"],["ただ"],["悪","あく"],["を"],["行なう","おこなう"],["に"],["至る","いたる"],["のみ"],["だ"],["。"]]},{"verse":9,"text":"悪,あくを行,おこなう者,ものは断,たち滅,ほろぼされ、主,しゅを待,まち望,のぞむ者,ものは国,くにを継,つぐからである。","tok":[["悪","あく"],["を"],["行なう","おこなう"],["者","もの"],["は"],["断ち","たち"],["滅ぼされ","ほろぼされ"],["、"],["主","しゅ"],["を"],["待ち望む","まちのぞむ"],["者","もの"],["は"],["国","くに"],["を"],["継ぐ","つぐ"],["から"],["で"],["ある"],["。"]]},{"verse":10,"text":"悪,あしき者,ものはただしばらくで、うせ去,さる。あなたは彼,かれの所,ところをつぶさに尋,たずねても彼,かれはいない。","tok":[["悪しき","あしき"],["者","もの"],["は"],["ただ"],["しばらく"],["で"],["、"],["うせ"],["去る","さる"],["。"],["あなた"],["は"],["彼","かれ"],["の"],["所","ところ"],["を"],["つぶさに"],["尋ねて","たずねて"],["も"],["彼","かれ"],["は"],["いない"],["。"]]},{"verse":11,"text":"しかし柔和,にゅうわな者,ものは国,くにを継,つぎ、豊,ゆたかな繁栄,はんえいをたのしむことができる。","tok":[["しかし"],["柔和","にゅうわ"],["な"],["者","もの"],["は"],["国","くに"],["を"],["継","つぎ"],["、"],["豊","ゆたか"],["な"],["繁栄","はんえい"],["を"],["たのしむ"],["こと"],["が"],["できる"],["。"]]},{"verse":12,"text":"悪,あしき者,ものは正,ただしい者,ものにむかってはかりごとをめぐらし、これにむかって歯,はがみする。","tok":[["悪しき","あしき"],["者","もの"],["は"],["正い","ただしい"],["者","もの"],["に"],["むかって"],["はかりごと"],["を"],["めぐらし"],["、"],["これ"],["に"],["むかって"],["歯がみ","はがみ"],["する"],["。"]]},{"verse":13,"text":"しかし主,しゅは悪,あしき者,ものを笑,わらわれる、彼,かれの日,ひの来,くるのを見,みられるからである。","tok":[["しかし"],["主","しゅ"],["は"],["悪しき","あしき"],["者","もの"],["を"],["笑われる","わらわれる"],["、"],["彼","かれ"],["の"],["日","ひ"],["の"],["来る","くる"],["の"],["を"],["見られる","みられる"],["から"],["で"],["ある"],["。"]]},{"verse":14,"text":"悪,あしき者,ものはつるぎを抜,ぬき、弓,ゆみを張,はって、貧,まずしい者,ものと乏,とぼしい者,ものとを倒,たおし、直,なおく歩,あゆむ者,ものを殺,ころそうとする。","tok":[["悪しき","あしき"],["者","もの"],["は"],["つるぎ"],["を"],["抜き","ぬき"],["、"],["弓","ゆみ"],["を"],["張って","はって"],["、"],["貧しい","まずしい"],["者","もの"],["と"],["乏い","とぼしい"],["者","もの"],["と"],["を"],["倒し","たおし"],["、"],["直","な"],["おく"],["歩む","あゆむ"],["者","もの"],["を"],["殺そう","ころそう"],["と"],["する"],["。"]]},{"verse":15,"text":"しかしそのつるぎはおのが胸,むねを刺,さし、その弓,ゆみは折,おられる。","tok":[["しかし"],["その"],["つるぎ"],["は"],["お"],["の"],["が"],["胸","むね"],["を"],["刺","さし"],["、"],["その"],["弓","ゆみ"],["は"],["折られる","おられる"],["。"]]},{"verse":16,"text":"正,ただしい人,ひとの持,もち物,ものの少,すくないのは、多,おおくの悪,あしきの者,ものの豊,ゆたかなのにまさる。","tok":[["正い","ただしい"],["人","ひと"],["の"],["持物","もちもの"],["の"],["少ない","すくない"],["の"],["は"],["、"],["多く","おおく"],["の"],["悪しき","あしき"],["の"],["者","もの"],["の"],["豊","ゆたか"],["な"],["のに"],["まさる"],["。"]]},{"verse":17,"text":"悪,あしき者,ものの腕,うでは折,おられるが、主,しゅは正,ただしい者,ものを助,たすけささえられるからである。","tok":[["悪しき","あしき"],["者","もの"],["の"],["腕","うで"],["は"],["折られる","おられる"],["が"],["、"],["主","しゅ"],["は"],["正い","ただしい"],["者","もの"],["を"],["助け","たすけ"],["ささえられる"],["から"],["で"],["ある"],["。"]]},{"verse":18,"text":"主,しゅは全,まったき者,もののもろもろの日,ひを知,しられる。彼,かれらの嗣,し業,ぎょうはとこしえに続,つづく。","tok":[["主","しゅ"],["は"],["全","ま"],["っ"],["たき者","たきもの"],["の"],["もろもろ"],["の"],["日","ひ"],["を"],["知られる","しられる"],["。"],["彼","かれ"],["ら"],["の"],["嗣業","しぎょう"],["は"],["とこしえ"],["に"],["続く","つづく"],["。"]]},{"verse":19,"text":"彼,かれらは災,わざわいの時,ときにも恥,はじをこうむらず、ききんの日,ひにも飽,あき足,たりる。","tok":[["彼","かれ"],["ら"],["は"],["災","わざわい"],["の"],["時","とき"],["に"],["も"],["恥","はじ"],["を"],["こうむらず"],["、"],["ききん"],["の"],["日","ひ"],["に"],["も"],["飽き足りる","あきたりる"],["。"]]},{"verse":20,"text":"しかし、悪,あしき者,ものは滅,ほろび、主,しゅの敵,てきは牧場,まきばの栄,さかえの枯,かれるように消,きえ、煙,けむりのように消,きえうせる。","tok":[["しかし"],["、"],["悪しき","あしき"],["者","もの"],["は"],["滅び","ほろび"],["、"],["主","しゅ"],["の"],["敵","てき"],["は"],["牧場","まきば"],["の"],["栄","さかえ"],["の"],["枯る","かれる"],["よう"],["に"],["消え","きえ"],["、"],["煙","けむり"],["の"],["よう"],["に"],["消えうせる","きえうせる"],["。"]]},{"verse":21,"text":"悪,あしき者,ものは物,ものを借,かりて返,かえすことをしない。しかし正,ただしい人,ひとは寛大,かんだいで、施,ほどこし与,あたえる。","tok":[["悪しき","あしき"],["者","もの"],["は"],["物","もの"],["を"],["借","かり"],["て"],["返えす","かえす"],["こと"],["を"],["しない"],["。"],["しかし"],["正い","ただしい"],["人","ひと"],["は"],["寛大","かんだい"],["で"],["、"],["施し与える","ほどこしあたえる"],["。"]]},{"verse":22,"text":"主,しゅに祝福,しゅくふくされた者,ものは国,くにを継,つぎ、主,しゅにのろわれた者,ものは断,たち滅,ほろぼされる。","tok":[["主に","しゅに"],["祝福","しゅくふく"],["された"],["者","もの"],["は"],["国","くに"],["を"],["継","つぎ"],["、"],["主に","しゅに"],["のろわれた"],["者","もの"],["は"],["断ち","たち"],["滅ぼされる","ほろぼされる"],["。"]]},{"verse":23,"text":"人,ひとの歩,あゆみは主,しゅによって定,さだめられる。主,しゅはその行,いく道,みちを喜,よろこばれる。","tok":[["人","ひと"],["の"],["歩み","あゆみ"],["は"],["主に","しゅに"],["よって"],["定められる","さだめられる"],["。"],["主","しゅ"],["は"],["その"],["行く","いく"],["道","みち"],["を"],["喜こばれる","よろこばれる"],["。"]]},{"verse":24,"text":"たといその人,ひとが倒,たおれても、全,まったく打,うち伏,ふせられることはない、主,しゅがその手,てを助,たすけささえられるからである。","tok":[["たとい"],["その"],["人","ひと"],["が"],["倒れて","たおれて"],["も"],["、"],["全く","まったく"],["打ち伏せられる","うちふせられる"],["こと"],["は"],["ない"],["、"],["主","しゅがそ"],["の"],["手","て"],["を"],["助け","たすけ"],["ささえられる"],["から"],["で"],["ある"],["。"]]},{"verse":25,"text":"わたしは、むかし年,とし若,わかかった時,ときも、年老,としおいた今,いまも、正,ただしい人,ひとが捨,すてられ、あるいはその子孫,しそんが食物,しょくもつを請,こいあるくのを見,みたことがない。","tok":[["わたし"],["は"],["、"],["むかし"],["年","とし"],["若かった","わかかった"],["時","とき"],["も"],["、"],["年老いた","としおいた"],["今","いま"],["も"],["、"],["正い","ただしい"],["人","ひと"],["が"],["捨てられ","すてられ"],["、"],["あるいは"],["その"],["子孫","しそん"],["が"],["食物","しょくもつ"],["を"],["請い","こい"],["あるく"],["の"],["を"],["見た","みた"],["こと"],["が"],["ない"],["。"]]},{"verse":26,"text":"正,ただしい人,ひとは常,つねに寛大,かんだいで、物,ものを貸,かし与,あたえ、その子孫,しそんは祝福,しゅくふくを得,える。","tok":[["正い","ただしい"],["人","ひと"],["は"],["常","つね"],["に"],["寛大","かんだい"],["で"],["、"],["物","もの"],["を"],["貸与","かしあたえ"],["、"],["その"],["子孫","しそん"],["は"],["祝福","しゅくふく"],["を"],["得る","える"],["。"]]},{"verse":27,"text":"悪,あくをさけて、善,ぜんを行,おこなえ。そうすれば、あなたはとこしえに住,すむことができる。","tok":[["悪","あく"],["を"],["さけて"],["、"],["善","ぜん"],["を"],["行なえ","おこなえ"],["。"],["そう"],["すれば"],["、"],["あなた"],["は"],["とこしえ"],["に"],["住む","すむ"],["こと"],["が"],["できる"],["。"]]},{"verse":28,"text":"主,しゅは公義,こうぎを愛,あいし、その聖徒,せいとを見捨,みすてられないからである。正,ただしい者,ものはとこしえに助,たすけ守,まもられる。しかし、悪,あしき者,ものの子孫,しそんは断,たち滅,ほろぼされる。","tok":[["主","しゅ"],["は"],["公義","こうぎ"],["を"],["愛し","あいし"],["、"],["その"],["聖徒","せいと"],["を"],["見捨てられない","みすてられない"],["から"],["で"],["ある"],["。"],["正い","ただしい"],["者","もの"],["は"],["とこしえ"],["に"],["助け守られる","たすけまもられる"],["。"],["しかし"],["、"],["悪しき","あしき"],["者","もの"],["の"],["子孫","しそん"],["は"],["断ち","たち"],["滅ぼされる","ほろぼされる"],["。"]]},{"verse":29,"text":"正,ただしい者,ものは国,くにを継,つぎ、とこしえにその中,なかに住,すむことができる。","tok":[["正い","ただしい"],["者","もの"],["は"],["国","くに"],["を"],["継","つぎ"],["、"],["とこしえ"],["に"],["その"],["中","なか"],["に"],["住む","すむ"],["こと"],["が"],["できる"],["。"]]},{"verse":30,"text":"正,ただしい者,ものの口,くちは知恵,ちえを語,かたり、その舌,したは公義,こうぎを述,のべる。","tok":[["正い","ただしい"],["者","もの"],["の"],["口","くち"],["は"],["知恵","ちえ"],["を"],["語り","かたり"],["、"],["その"],["舌","した"],["は"],["公義","こうぎ"],["を"],["述べる","のべる"],["。"]]},{"verse":31,"text":"その心,こころには神,かみのおきてがあり、その歩,あゆみはすべることがない。","tok":[["その"],["心","こころ"],["に"],["は"],["神","かみ"],["の"],["おきて"],["が"],["あり"],["、"],["その"],["歩み","あゆみ"],["は"],["すべる"],["こと"],["が"],["ない"],["。"]]},{"verse":32,"text":"悪,あしき者,ものは正,ただしい人,ひとをうかがい、これを殺,ころそうとはかる。","tok":[["悪しき","あしき"],["者","もの"],["は"],["正い","ただしい"],["人","ひと"],["を"],["うかがい"],["、"],["これ"],["を"],["殺そう","ころそう"],["と"],["はかる"],["。"]]},{"verse":33,"text":"主,しゅは正,ただしい人,ひとを悪,あしき者,ものの手,てにゆだねられない、またさばかれる時,とき、これを罪,つみに定,さだめられることはない。","tok":[["主","しゅ"],["は"],["正い","ただしい"],["人","ひと"],["を"],["悪しき","あしき"],["者","もの"],["の"],["手","て"],["に"],["ゆだねられない"],["、"],["また"],["さばかれる"],["時","とき"],["、"],["これ"],["を"],["罪","つみ"],["に"],["定められる","さだめられる"],["こと"],["は"],["ない"],["。"]]},{"verse":34,"text":"主,しゅを待,まち望,のぞめ、その道,みちを守,まもれ。そうすれば、主,しゅはあなたを上,あげて、国,くにを継,つがせられる。あなたは悪,あしき者,ものの断,たち滅,ほろぼされるのを見,みるであろう。","tok":[["主","しゅ"],["を"],["待ち望め","まちのぞめ"],["、"],["その"],["道","みち"],["を"],["守れ","まもれ"],["。"],["そう"],["すれば"],["、"],["主","しゅ"],["は"],["あなた"],["を"],["上げて","あげて"],["、"],["国","くに"],["を"],["継がせられる","つがせられる"],["。"],["あなた"],["は"],["悪しき","あしき"],["者","もの"],["の"],["断ち","たち"],["滅ぼされる","ほろぼされる"],["の"],["を"],["見るで","みるで"],["あろう"],["。"]]},{"verse":35,"text":"わたしは悪,あしき者,ものが勝,かち誇,ほこって、レバノンの香柏,こうはくのようにそびえたつのを見,みた。","tok":[["わたし"],["は"],["悪しき","あしき"],["者","もの"],["が"],["勝誇って","かちほこって"],["、"],["レバノン"],["の"],["香","こう"],["柏","かしわ"],["の"],["よう"],["に"],["そびえたつ"],["の"],["を"],["見た","みた"],["。"]]},{"verse":36,"text":"しかし、わたしが通,とおり過,すぎると、見,みよ、彼,かれはいなかった。わたしは彼,かれを尋,たずねたけれども見,みつからなかった。","tok":[["しかし"],["、"],["わたし"],["が"],["通り","とおり"],["過る","すぎる"],["と"],["、"],["見よ","みよ"],["、"],["彼","かれ"],["は"],["いなかった"],["。"],["わたし"],["は"],["彼","かれ"],["を"],["尋ねた","たずねた"],["けれど"],["も"],["見つからなかった","みつからなかった"],["。"]]},{"verse":37,"text":"全,まったき人,ひとに目,めをそそぎ、直,なおき人,ひとを見,みよ。おだやかな人,ひとには子孫,しそんがある。","tok":[["全","ま"],["っ"],["たき人","たきひと"],["に"],["目","め"],["を"],["そそぎ"],["、"],["直","な"],["おき"],["人","ひと"],["を"],["見よ","みよ"],["。"],["おだやか"],["な"],["人","ひと"],["に"],["は"],["子孫","しそん"],["が"],["ある"],["。"]]},{"verse":38,"text":"しかし罪,つみを犯,おかす者,ものどもは共,ともに滅,ほろぼされ、悪,あしき者,ものの子孫,しそんは断,たたれる。","tok":[["しかし"],["罪","つみ"],["を"],["犯す","おかす"],["者","もの"],["ども"],["は"],["共","とも"],["に"],["滅ぼされ","ほろぼされ"],["、"],["悪しき","あしき"],["者","もの"],["の"],["子孫","しそん"],["は"],["断たれる","たたれる"],["。"]]},{"verse":39,"text":"正,ただしい人,ひとの救,すくいは主,しゅから出,でる。主,しゅは彼,かれらの悩,なやみの時,ときの避,さけ所,どころである。","tok":[["正い","ただしい"],["人","ひと"],["の"],["救い","すくい"],["は"],["主ら","しゅから"],["出る","でる"],["。"],["主","しゅ"],["は"],["彼","かれ"],["ら"],["の"],["悩み","なやみ"],["の"],["時","とき"],["の"],["避け","さけ"],["所","ど"],["ころ"],["で"],["ある"],["。"]]},{"verse":40,"text":"主,しゅは彼,かれらを助,たすけ、彼,かれらを解,とき放,はなち、彼,かれらを悪,あしき者,ものどもから解,とき放,はなって救,すくわれる。彼,かれらは主,しゅに寄,より頼,たのむからである。","tok":[["主","しゅ"],["は"],["彼","かれ"],["ら"],["を"],["助け","たすけ"],["、"],["彼","かれ"],["ら"],["を"],["解き放ち","ときはなち"],["、"],["彼","かれ"],["ら"],["を"],["悪しき","あしき"],["者","もの"],["ども"],["から"],["解き","とき"],["放","は"],["な"],["って"],["救われる","すくわれる"],["。"],["彼","かれ"],["ら"],["は"],["主","しゅ"],["に"],["寄り","より"],["頼む","たのむ"],["から"],["で"],["ある"],["。"]]}]
[{"verse":1,"text":"[0]【聖歌,せいか隊,たいの指揮者,しきしゃによってあけぼののめじかのしらべにあわせてうたわせたダビデの歌,うた】","tok":[["["],["0"],["]"],["【"],["聖歌隊","せいかたい"],["の"],["指揮者","しきしゃ"],["によって"],["あけぼの"],["の"],["めじか"],["の"],["しらべ"],["に"],["あわせて"],["うたわせた"],["ダビデ"],["の"],["歌","うた"],["】"]]},{"verse":2,"text":"[1]わが神,かみ、わが神,かみ、なにゆえわたしを捨,すてられるのですか。なにゆえ遠,とおく離,はなれてわたしを助,たすけず、わたしの嘆,なげきの言葉,ことばを聞,きかれないのですか。","tok":[["["],["1"],["]"],["わが"],["神","かみ"],["、"],["わが"],["神","かみ"],["、"],["なにゆえ"],["わたし"],["を"],["捨てられる","すてられる"],["の"],["です"],["か"],["。"],["なにゆえ"],["遠く","とおく"],["離れて","はなれて"],["わたし"],["を"],["助けず","たすけず"],["、"],["わたし"],["の"],["嘆き","なげき"],["の"],["言葉","ことば"],["を"],["聞かれない","きかれない"],["の"],["です"],["か"],["。"]]},{"verse":3,"text":"[2]わが神,かみよ、わたしが昼,ひるよばわっても、あなたは答,こたえられず、夜,よるよばわっても平安,へいあんを得,えません。","tok":[["["],["2"],["]"],["わが"],["神","かみ"],["よ"],["、"],["わたし"],["が"],["昼","ひる"],["よばわって"],["も"],["、"],["あなた"],["は"],["答","こたえ"],["られず"],["、"],["夜","よる"],["よばわって"],["も"],["平安","へいあん"],["を"],["得ません","えません"],["。"]]},{"verse":4,"text":"[3]しかしイスラエルのさんびの上,うえに座,ざしておられるあなたは聖,せいなるおかたです。","tok":[["["],["3"],["]"],["しかし"],["イスラエル"],["の"],["さん"],["び"],["の"],["上","うえ"],["に"],["座して","ざして"],["おられる"],["あなた"],["は"],["聖","せい"],["なる"],["おかた"],["です"],["。"]]},{"verse":5,"text":"[4]われらの先祖,せんぞたちはあなたに信頼,しんらいしました。彼,かれらが信頼,しんらいしたので、あなたは彼,かれらを助,たすけられました。","tok":[["["],["4"],["]"],["われ"],["ら"],["の"],["先祖","せんぞ"],["たち"],["は"],["あなた"],["に"],["信頼","しんらい"],["しました"],["。"],["彼","かれ"],["ら"],["が"],["信頼","しんらい"],["した"],["ので"],["、"],["あなた"],["は"],["彼","かれ"],["ら"],["を"],["助けられました","たすけられました"],["。"]]},{"verse":6,"text":"[5]彼,かれらはあなたに呼,よばわって救,すくわれ、あなたに信頼,しんらいして恥,はじをうけなかったのです。","tok":[["["],["5"],["]"],["彼","かれ"],["ら"],["は"],["あなた"],["に"],["呼ばわって","よばわって"],["救われ","すくわれ"],["、"],["あなた"],["に"],["信頼","しんらい"],["して"],["恥","はじ"],["を"],["うけなかった"],["の"],["です"],["。"]]},{"verse":7,"text":"[6]しかし、わたしは虫,むしであって、人,ひとではない。人,ひとにそしられ、民,たみに侮,あなどられる。","tok":[["["],["6"],["]"],["しかし"],["、"],["わたし"],["は"],["虫","むし"],["で"],["あって"],["、"],["人","ひと"],["で"],["は"],["ない"],["。"],["人","ひと"],["に"],["そしられ"],["、"],["民","たみ"],["に"],["侮られる","あなどられる"],["。"]]},{"verse":8,"text":"[7]すべてわたしを見,みる者,ものは、わたしをあざ笑,あざわらい、くちびるを突,つき出,だし、かしらを振,ふり動,うごかして言,いう、","tok":[["["],["7"],["]"],["すべて"],["わたし"],["を"],["見る","みる"],["者","もの"],["は"],["、"],["わたし"],["を"],["あざ"],["笑","あ"],["ざわ"],["らい"],["、"],["くちびる"],["を"],["突き出し","つきだし"],["、"],["かしら"],["を"],["振り動かして","ふりうごかして"],["言う","いう"],["、"]]},{"verse":9,"text":"[8]「彼,かれは主,しゅに身,みをゆだねた、主,しゅに彼,かれを助,たすけさせよ。主,しゅは彼,かれを喜,よろこばれるゆえ、主,しゅに彼,かれを救,すくわせよ」と。","tok":[["["],["8"],["]"],["「"],["彼","かれ"],["は"],["主に","しゅに"],["身","み"],["を"],["ゆだねた"],["、"],["主に","しゅに"],["彼","かれ"],["を"],["助けさせ","たすけさせ"],["よ"],["。"],["主","しゅ"],["は"],["彼","かれ"],["を"],["喜こばれる","よろこばれる"],["ゆえ"],["、"],["主に","しゅに"],["彼","かれ"],["を"],["救わせよ","すくわせよ"],["」"],["と"],["。"]]},{"verse":10,"text":"[9]しかし、あなたはわたしを生,うまれさせ、母,ははのふところにわたしを安,やすらかに守,まもられた方,かたです。","tok":[["["],["9"],["]"],["しかし"],["、"],["あなた"],["は"],["わたし"],["を"],["生まれさせ","うまれさせ"],["、"],["母","はは"],["の"],["ふところ"],["に"],["わたし"],["を"],["安らか","やすらか"],["に"],["守られた","まもられた"],["方","か"],["たです"],["。"]]},{"verse":11,"text":"[10]わたしは生,うまれた時,ときから、あなたにゆだねられました。母,ははの胎,たいを出,でてからこのかた、あなたはわたしの神,かみでいらせられました。","tok":[["["],["10"],["]"],["わたし"],["は"],["生まれた","うまれた"],["時","とき"],["から"],["、"],["あなた"],["に"],["ゆだねられました"],["。"],["母","はは"],["の"],["胎","たい"],["を"],["出て","でて"],["から"],["このかた"],["、"],["あなた"],["は"],["わたし"],["の"],["神","かみ"],["で"],["いらせられました"],["。"]]},{"verse":12,"text":"[11]わたしを遠,とおく離,はなれないでください。悩,なやみが近,ちかづき、助,たすける者,ものがないのです。","tok":[["["],["11"],["]"],["わたし"],["を"],["遠く","とおく"],["離れないで","はなれないで"],["ください"],["。"],["悩み","なやみ"],["が"],["近づき","ちかづき"],["、"],["助ける","たすける"],["者","もの"],["が"],["ない"],["の"],["です"],["。"]]},{"verse":13,"text":"[12]多,おおくの雄牛,おうしはわたしを取,とり巻,まき、バシャンの強,つよい雄牛,おうしはわたしを囲,かこみ、","tok":[["["],["12"],["]"],["多く","おおく"],["の"],["雄牛","おうし"],["は"],["わたし"],["を"],["取巻","とりまき"],["、"],["バシャン"],["の"],["強い","つよい"],["雄牛","おうし"],["は"],["わたし"],["を"],["囲み","かこみ"],["、"]]},{"verse":14,"text":"[13]かき裂,さき、ほえたけるししのように、わたしにむかって口,くちを開,ひらく。","tok":[["["],["13"],["]"],["かき裂き","かきさき"],["、"],["ほえ"],["たける"],["しし"],["の"],["よう"],["に"],["、"],["わたし"],["に"],["むかって"],["口","くち"],["を"],["開らく","ひらく"],["。"]]},{"verse":15,"text":"[14]わたしは水,みずのように注,そそぎ出,だされ、わたしの骨,ほねはことごとくはずれ、わたしの心臓,しんぞうは、ろうのように、胸,むねのうちで溶,とけた。","tok":[["["],["14"],["]"],["わたし"],["は"],["水","みず"],["の"],["よう"],["に"],["注ぎ","そそぎ"],["出され","だされ"],["、"],["わたし"],["の"],["骨","ほね"],["は"],["ことごとく"],["はずれ"],["、"],["わたし"],["の"],["心臓","しんぞう"],["は"],["、"],["ろう"],["の"],["よう"],["に"],["、"],["胸","むね"],["の"],["うち"],["で"],["溶けた","とけた"],["。"]]},{"verse":16,"text":"[15]わたしの力,ちからは陶器,とうきの破片,はへんのようにかわき、わたしの舌,したはあごにつく。あなたはわたしを死,しのちりに伏,ふさせられる。","tok":[["["],["15"],["]"],["わたし"],["の"],["力","ちから"],["は"],["陶器","とうき"],["の"],["破片","はへん"],["の"],["よう"],["に"],["かわき"],["、"],["わたし"],["の"],["舌","した"],["は"],["あご"],["に"],["つく"],["。"],["あなた"],["は"],["わたし"],["を"],["死","し"],["の"],["ちり"],["に"],["伏させられる","ふさせられる"],["。"]]},{"verse":17,"text":"[16]まことに、犬,いぬはわたしをめぐり、悪,あくを行,おこなう者,ものの群,むれがわたしを囲,かこんで、わたしの手,てと足,あしを刺,さし貫,つらぬいた。","tok":[["["],["16"],["]"],["まこと"],["に"],["、"],["犬","いぬ"],["は"],["わたし"],["を"],["めぐり"],["、"],["悪","あく"],["を"],["行なう","おこなう"],["者","もの"],["の"],["群れ","むれ"],["が"],["わたし"],["を"],["囲んで","かこんで"],["、"],["わたし"],["の"],["手","て"],["と"],["足","あし"],["を"],["刺","さし"],["貫ぬいた","つらぬいた"],["。"]]},{"verse":18,"text":"[17]わたしは自分,じぶんの骨,ほねをことごとく数,かぞえることができる。彼,かれらは目,めをとめて、わたしを見,みる。","tok":[["["],["17"],["]"],["わたし"],["は"],["自分","じぶん"],["の"],["骨","ほね"],["を"],["ことごとく"],["数える","かぞえる"],["こと"],["が"],["できる"],["。"],["彼","かれ"],["ら"],["は"],["目","め"],["を"],["とめて"],["、"],["わたし"],["を"],["見る","みる"],["。"]]},{"verse":19,"text":"[18]彼,かれらは互,たがいにわたしの衣服,いふくを分,わけ、わたしの着物,きものをくじ引,ひにする。","tok":[["["],["18"],["]"],["彼","かれ"],["ら"],["は"],["互","たがい"],["に"],["わたし"],["の"],["衣服","いふく"],["を"],["分け","わけ"],["、"],["わたし"],["の"],["着物","きもの"],["を"],["くじ引","くじひ"],["に"],["する"],["。"]]},{"verse":20,"text":"[19]しかし主,しゅよ、遠,とおく離,はなれないでください。わが力,ちからよ、速,はやく来,きてわたしをお助,たすけください。","tok":[["["],["19"],["]"],["しかし"],["主","しゅ"],["よ"],["、"],["遠く","とおく"],["離れないで","はなれないで"],["ください"],["。"],["わが"],["力","ちから"],["よ"],["、"],["速く","はやく"],["来て","きて"],["わたし"],["を"],["お助け","おたすけ"],["ください"],["。"]]},{"verse":21,"text":"[20]わたしの魂,たましいをつるぎから、わたしのいのちを犬,いぬの力,ちからから助,たすけ出,だしてください。","tok":[["["],["20"],["]"],["わたし"],["の"],["魂","たましい"],["を"],["つるぎ"],["から"],["、"],["わたし"],["の"],["いのち"],["を"],["犬","いぬ"],["の"],["力","ちから"],["から"],["助け出して","たすけだして"],["ください"],["。"]]},{"verse":22,"text":"[21]わたしをししの口,くちから、苦,くるしむわが魂,たましいを野牛,やぎゅうの角,つのから救,すくい出,だしてください。","tok":[["["],["21"],["]"],["わたし"],["を"],["しし"],["の"],["口","くち"],["から"],["、"],["苦しむ","くるしむ"],["わが"],["魂","たましい"],["を"],["野牛","やぎゅう"],["の"],["角","つ"],["の"],["から"],["救い出して","すくいだして"],["ください"],["。"]]},{"verse":23,"text":"[22]わたしはあなたのみ名,なを兄弟,きょうだいたちに告,つげ、会衆,かいしゅうの中,なかであなたをほめたたえるでしょう。","tok":[["["],["22"],["]"],["わたし"],["は"],["あなた"],["のみ"],["名","な"],["を"],["兄弟","きょうだい"],["たち"],["に"],["告","つげ"],["、"],["会衆","かいしゅう"],["の"],["中","なか"],["で"],["あなた"],["を"],["ほめたたえるでしょう"],["。"]]},{"verse":24,"text":"[23]主,しゅを恐,おそれる者,ものよ、主,しゅをほめたたえよ。ヤコブのもろもろのすえよ、主,しゅをあがめよ。イスラエルのもろもろのすえよ、主,しゅをおじおそれよ。","tok":[["["],["23"],["]"],["主","しゅ"],["を"],["恐れる","おそれる"],["者","もの"],["よ"],["、"],["主","しゅ"],["を"],["ほめたたえ"],["よ"],["。"],["ヤコブ"],["の"],["もろもろ"],["の"],["すえ"],["よ"],["、"],["主","しゅ"],["を"],["あがめよ"],["。"],["イスラエル"],["の"],["もろもろ"],["の"],["すえ"],["よ"],["、"],["主","しゅ"],["を"],["おじ"],["おそれ"],["よ"],["。"]]},{"verse":25,"text":"[24]主,しゅが苦,くるしむ者,ものの苦,くるしみをかろんじ、いとわれず、またこれにみ顔,かおを隠,かくすことなく、その叫,さけぶときに聞,きかれたからである。","tok":[["["],["24"],["]"],["主","しゅ"],["が"],["苦しむ","くるしむ"],["者","もの"],["の"],["苦しみ","くるしみ"],["を"],["かろんじ"],["、"],["いとわれず"],["、"],["また"],["これ"],["に"],["み顔","みかお"],["を"],["隠す","かくす"],["こと"],["なく"],["、"],["その"],["叫けぶ","さけぶ"],["とき"],["に"],["聞かれた","きかれた"],["から"],["で"],["ある"],["。"]]},{"verse":26,"text":"[25]大,おおいなる会衆,かいしゅうの中,なかで、わたしのさんびはあなたから出,でるのです。わたしは主,しゅを恐,おそれる者,ものの前,まえで、わたしの誓,ちかいを果,はたします。","tok":[["["],["25"],["]"],["大いなる","おおいなる"],["会衆","かいしゅう"],["の"],["中","なか"],["で"],["、"],["わたし"],["の"],["さん"],["び"],["は"],["あなた"],["から"],["出る","でる"],["の"],["です"],["。"],["わたし"],["は"],["主","しゅ"],["を"],["恐れる","おそれる"],["者","もの"],["の"],["前","まえ"],["で"],["、"],["わたし"],["の"],["誓い","ちかい"],["を"],["果たします","はたします"],["。"]]},{"verse":27,"text":"[26]貧,まずしい者,ものは食,たべて飽,あくことができ、主,しゅを尋,たずね求,もとめる者,ものは主,しゅをほめたたえるでしょう。どうか、あなたがたの心,こころがとこしえに生,いきるように。","tok":[["["],["26"],["]"],["貧しい","まずしい"],["者","もの"],["は"],["食べて","たべて"],["飽く","あく"],["こと"],["が"],["でき"],["、"],["主","しゅ"],["を"],["尋ね求める","たずねもとめる"],["者","もの"],["は"],["主","しゅ"],["を"],["ほめたたえるでしょう"],["。"],["どう"],["か"],["、"],["あなた"],["がた"],["の"],["心","こころ"],["が"],["とこしえ"],["に"],["生きる","いきる"],["よう"],["に"],["。"]]},{"verse":28,"text":"[27]地,ちのはての者,ものはみな思,おもい出,だして、主,しゅに帰,かえり、もろもろの国,くにのやからはみな、み前,まえに伏,ふし拝,おがむでしょう。","tok":[["["],["27"],["]"],["地","ち"],["の"],["はて"],["の"],["者","もの"],["は"],["みな"],["思い出して","おもいだして"],["、"],["主に","しゅに"],["帰えり","かえり"],["、"],["もろもろ"],["の"],["国","くに"],["の"],["やから"],["は"],["みな"],["、"],["み前","みまえ"],["に"],["伏し拝むでしょう","ふしおがむでしょう"],["。"]]},{"verse":29,"text":"[28]国,くには主,しゅのものであって、主,しゅはもろもろの国民,こくみんを統,すべ治,おさめられます。","tok":[["["],["28"],["]"],["国","くに"],["は"],["主","しゅ"],["の"],["もの"],["で"],["あって"],["、"],["主","しゅ"],["は"],["もろもろ"],["の"],["国民","こくみん"],["を"],["統べ治められます","すべおさめられます"],["。"]]},{"verse":30,"text":"[29]地,ちの誇,ほこり高,たかぶる者,ものはみな主,しゅを拝,おがみ、ちりに下,くだる者,ものも、おのれを生,いきながらえさせえない者,ものも、みなそのみ前,まえにひざまずくでしょう。","tok":[["["],["29"],["]"],["地","ち"],["の"],["誇","ほこり"],["高ぶる","たかぶる"],["者","もの"],["は"],["みな"],["主","しゅ"],["を"],["拝み","おがみ"],["、"],["ちり"],["に"],["下る","くだる"],["者","もの"],["も"],["、"],["おのれ"],["を"],["生きながらえさせ","いきながらえさせ"],["えない"],["者","もの"],["も"],["、"],["みなそ"],["のみ"],["前","まえ"],["に"],["ひざまずくでしょう"],["。"]]},{"verse":31,"text":"[30]子々孫々,ししそんそん、主,しゅに仕,つかえ、人々,ひとびとは主,しゅのことをきたるべき代,よまで語,かたり伝,つたえ、","tok":[["["],["30"],["]"],["子々","しし"],["孫々","そんそん"],["、"],["主に","しゅに"],["仕え","つかえ"],["、"],["人々","ひとびと"],["は"],["主","しゅ"],["の"],["こと"],["を"],["きたるべき"],["代","よ"],["まで"],["語り伝え","かたりつたえ"],["、"]]},{"verse":32,"text":"[31]主,しゅがなされたその救,すくいを後,のちに生,うまれる民,たみにのべ伝,つたえるでしょう。","tok":[["["],["31"],["]"],["主","しゅ"],["が"],["なされた"],["その"],["救い","すくい"],["を"],["後","のち"],["に"],["生まれる","うまれる"],["民","たみ"],["に"],["のべ伝えるでしょう","のべつたえるでしょう"],["。"]]}]
[{"verse":1,"text":"[0]【聖歌,せいか隊,たいの指揮者,しきしゃエドトンによってうたわせたダビデの歌,うた】","tok":[["["],["0"],["]"],["【"],["聖歌隊","せいかたい"],["の"],["指揮者","しきしゃ"],["エドトン"],["によって"],["うたわせた"],["ダビデ"],["の"],["歌","うた"],["】"]]},{"verse":2,"text":"[1]わたしは言,いった、「舌,したをもって罪,つみを犯,おかさないために、わたしの道,みちを慎,つつしみ、悪,あしき者,もののわたしの前,まえにある間,あいだはわたしの口,くちにくつわをかけよう」と。","tok":[["["],["1"],["]"],["わたし"],["は"],["言った","いった"],["、"],["「"],["舌","した"],["を"],["もって"],["罪","つみ"],["を"],["犯さない","おかさない"],["ため"],["に"],["、"],["わたし"],["の"],["道","みち"],["を"],["慎しみ","つつしみ"],["、"],["悪しき","あしき"],["者","もの"],["の"],["わたし"],["の"],["前","まえ"],["に"],["ある"],["間","あいだ"],["は"],["わたし"],["の"],["口","くち"],["に"],["くつわ"],["を"],["かけよう"],["」"],["と"],["。"]]},{"verse":3,"text":"[2]わたしは黙,もくして物言,ものいわず、むなしく沈黙,ちんもくを守,まもった。しかし、わたしの悩,なやみはさらにひどくなり、","tok":[["["],["2"],["]"],["わたし"],["は"],["黙して","もくして"],["物","もの"],["言わず","いわず"],["、"],["むなしく"],["沈黙","ちんもく"],["を"],["守った","まもった"],["。"],["しかし"],["、"],["わたし"],["の"],["悩み","なやみ"],["は"],["さらに"],["ひどく"],["なり"],["、"]]},{"verse":4,"text":"[3]わたしの心,こころはわたしのうちに熱,ねっし、思,おもいつづけるほどに火,ひが燃,もえたので、わたしは舌,したをもって語,かたった。","tok":[["["],["3"],["]"],["わたし"],["の"],["心","こころ"],["は"],["わたし"],["の"],["うち"],["に"],["熱し","ねっし"],["、"],["思い","おもい"],["つづける"],["ほど"],["に"],["火","ひ"],["が"],["燃えた","もえた"],["ので"],["、"],["わたし"],["は"],["舌","した"],["を"],["もって"],["語った","かたった"],["。"]]},{"verse":5,"text":"[4]「主,しゅよ、わが終,おわりと、わが日,ひの数,かずのどれほどであるかをわたしに知,しらせ、わが命,いのちのいかにはかないかを知,しらせてください。","tok":[["["],["4"],["]"],["「"],["主","しゅ"],["よ"],["、"],["わが"],["終","おわり"],["と"],["、"],["わが"],["日","ひ"],["の"],["数","かず"],["の"],["どれ"],["ほど"],["で"],["ある"],["か"],["を"],["わたし"],["に"],["知らせ","しらせ"],["、"],["わが"],["命","いのち"],["の"],["いかに"],["はかない"],["か"],["を"],["知らせて","しらせて"],["ください"],["。"]]},{"verse":6,"text":"[5]見,みよ、あなたはわたしの日,ひをつかのまとされました。わたしの一生,いっしょうはあなたの前,まえでは無,むにひとしいのです。まことに、すべての人,ひとはその盛,さかんな時,ときでも息,いきにすぎません。〔セラ","tok":[["["],["5"],["]"],["見よ","みよ"],["、"],["あなた"],["は"],["わたし"],["の"],["日","ひ"],["を"],["つかのま"],["と"],["されました"],["。"],["わたし"],["の"],["一生","いっしょう"],["は"],["あなた"],["の"],["前","まえ"],["で"],["は"],["無","む"],["に"],["ひとしい"],["の"],["です"],["。"],["まこと"],["に"],["、"],["すべて"],["の"],["人","ひと"],["は"],["その"],["盛","さかん"],["な"],["時","とき"],["で"],["も"],["息","いき"],["に"],["すぎません"],["。"],["〔"],["セラ"]]},{"verse":7,"text":"[6]まことに人,ひとは影,かげのように、さまよいます。まことに彼,かれらはむなしい事,ことのために騒,さわぎまわるのです。彼,かれは積,つみたくわえるけれども、だれがそれを収,おさめるかを知,しりません。","tok":[["["],["6"],["]"],["まこと"],["に"],["人","ひと"],["は"],["影","かげ"],["の"],["よう"],["に"],["、"],["さまよいます"],["。"],["まこと"],["に"],["彼","かれ"],["ら"],["は"],["むなしい"],["事","こと"],["の"],["ため"],["に"],["騒","さわぎ"],["まわる"],["の"],["です"],["。"],["彼","かれ"],["は"],["積み","つみ"],["たくわえる"],["けれど"],["も"],["、"],["だれ"],["が"],["それ"],["を"],["収める","おさめる"],["か"],["を"],["知りません","しりません"],["。"]]},{"verse":8,"text":"[7]主,しゅよ、今,いまわたしは何,なにを待,まち望,のぞみましょう。わたしの望,のぞみはあなたにあります。","tok":[["["],["7"],["]"],["主","しゅ"],["よ"],["、"],["今","いま"],["わたし"],["は"],["何に","なに"],["を"],["待ち望みましょう","まちのぞみましょう"],["。"],["わたし"],["の"],["望み","のぞみ"],["は"],["あなた"],["に"],["あります"],["。"]]},{"verse":9,"text":"[8]わたしをすべてのとがから助,たすけ出,だし、愚,おろかな者,ものにわたしをあざけらせないでください。","tok":[["["],["8"],["]"],["わたし"],["を"],["すべて"],["の"],["とが"],["から"],["助け出し","たすけだし"],["、"],["愚か","おろか"],["な"],["者","もの"],["に"],["わたし"],["を"],["あざけらせないで"],["ください"],["。"]]},{"verse":10,"text":"[9]わたしは黙,もくして口,くちを開,ひらきません。あなたがそれをなされたからです。","tok":[["["],["9"],["]"],["わたし"],["は"],["黙して","もくして"],["口","くち"],["を"],["開らきません","ひらきません"],["。"],["あなた"],["が"],["それ"],["を"],["なされた"],["から"],["です"],["。"]]},{"verse":11,"text":"[10]あなたが下,くだされた災,わざわいをわたしから取,とり去,さってください。わたしはあなたのみ手,てに打,うち懲,こらされることにより滅,ほろびるばかりです。","tok":[["["],["10"],["]"],["あなた"],["が"],["下された","くだされた"],["災","わざわい"],["を"],["わたし"],["から"],["取","とり"],["去て","さって"],["ください"],["。"],["わたし"],["は"],["あなた"],["のみ"],["手","て"],["に"],["打ち","うち"],["懲らされる","こらされる"],["こと"],["に"],["より"],["滅びる","ほろびる"],["ばかり"],["です"],["。"]]},{"verse":12,"text":"[11]あなたは罪,つみを責,せめて人,ひとを懲,こらされるとき、その慕,したい喜,よろこぶものを、しみが食,くうように、消,けし滅,ほろぼされるのです。まことにすべての人,ひとは息,いきにすぎません。〔セラ","tok":[["["],["11"],["]"],["あなた"],["は"],["罪","つみ"],["を"],["責","せめ"],["て"],["人","ひと"],["を"],["懲らされる","こらされる"],["とき"],["、"],["その"],["慕い","したい"],["喜こぶ","よろこぶ"],["もの"],["を"],["、"],["しみ"],["が"],["食う","くう"],["よう"],["に"],["、"],["消し","けし"],["滅ぼされる","ほろぼされる"],["の"],["です"],["。"],["まこと"],["に"],["すべて"],["の"],["人","ひと"],["は"],["息","いき"],["に"],["すぎません"],["。"],["〔"],["セラ"]]},{"verse":13,"text":"[12]主,しゅよ、わたしの祈,いのりを聞,きき、わたしの叫,さけびに耳,みみを傾,かたむけ、わたしの涙,なみだを見,みて、もださないでください。わたしはあなたに身,みを寄,よせる旅,たびびと、わがすべての先祖,せんぞたちのように寄留者,きりゅうしゃです。","tok":[["["],["12"],["]"],["主","しゅ"],["よ"],["、"],["わたし"],["の"],["祈","いのり"],["を"],["聞","きき"],["、"],["わたし"],["の"],["叫","さけび"],["に"],["耳","みみ"],["を"],["傾むけ","かたむけ"],["、"],["わたし"],["の"],["涙","なみだ"],["を"],["見て","みて"],["、"],["もださないで"],["ください"],["。"],["わたし"],["は"],["あなた"],["に"],["身","み"],["を"],["寄せる","よせる"],["旅びと","たびびと"],["、"],["わが"],["すべて"],["の"],["先祖","せんぞ"],["たち"],["の"],["よう"],["に"],["寄留者","きりゅうしゃ"],["です"],["。"]]},{"verse":14,"text":"[13]わたしが去,さって、うせない前,まえに、み顔,かおをそむけて、わたしを喜,よろこばせてください」。","tok":[["["],["13"],["]"],["わたし"],["が"],["去て","さって"],["、"],["うせない"],["前","まえ"],["に"],["、"],["み顔","みかお"],["を"],["そむけて"],["、"],["わたし"],["を"],["喜こばせて","よろこばせて"],["ください"],["」"],["。"]]}]
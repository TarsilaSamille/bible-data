[{"verse":1,"text":"あだを報,むくいられる神,かみ、主,しゅよ、あだを報,むくいられる神,かみよ、光,ひかりを放,はなってください。","tok":[["あだ"],["を"],["報いられる","むくいられる"],["神","かみ"],["、"],["主","しゅ"],["よ"],["、"],["あだ"],["を"],["報いられる","むくいられる"],["神","かみ"],["よ"],["、"],["光","ひかり"],["を"],["放って","はなって"],["ください"],["。"]]},{"verse":2,"text":"地,ちをさばかれる者,ものよ、立,たって高,たかぶる者,ものにその受,うくべき罰,ばつをお与,あたえください。","tok":[["地","ち"],["を"],["さばかれる"],["者","もの"],["よ"],["、"],["立って","たって"],["高か","たか"],["ぶる"],["者","もの"],["に"],["その"],["受","う"],["くべき"],["罰","ばつ"],["を"],["お与え","おあたえ"],["ください"],["。"]]},{"verse":3,"text":"主,しゅよ、悪,あしき者,ものはいつまで、悪,あしき者,ものはいつまで勝,かち誇,ほこるでしょうか。","tok":[["主","しゅ"],["よ"],["、"],["悪しき","あしき"],["者","もの"],["は"],["いつ"],["まで"],["、"],["悪しき","あしき"],["者","もの"],["は"],["いつ"],["まで"],["勝誇るでしょう","かちほこるでしょう"],["か"],["。"]]},{"verse":4,"text":"彼,かれらは高慢,こうまんな言葉,ことばを吐,はき散,ちらし、すべて不義,ふぎを行,おこなう者,ものはみずから高,たかぶります。","tok":[["彼","かれ"],["ら"],["は"],["高慢","こうまん"],["な"],["言葉","ことば"],["を"],["吐","はき"],["散らし","ちらし"],["、"],["すべて"],["不義","ふぎ"],["を"],["行なう","おこなう"],["者","もの"],["は"],["みずから"],["高ぶります","たかぶります"],["。"]]},{"verse":5,"text":"主,しゅよ、彼,かれらはあなたの民,たみを打,うち砕,くだき、あなたの嗣,し業,ぎょうを苦,くるしめます。","tok":[["主","しゅ"],["よ"],["、"],["彼","かれ"],["ら"],["は"],["あなた"],["の"],["民","たみ"],["を"],["打ち砕き","うちくだき"],["、"],["あなた"],["の"],["嗣業","しぎょう"],["を"],["苦しめます","くるしめます"],["。"]]},{"verse":6,"text":"彼,かれらはやもめと旅,たびびとのいのちをうばい、みなしごを殺,ころします。","tok":[["彼","かれ"],["ら"],["は"],["やもめ"],["と"],["旅びと","たびびと"],["の"],["いのち"],["を"],["うばい"],["、"],["みなしご"],["を"],["殺ろします","ころします"],["。"]]},{"verse":7,"text":"彼,かれらは言,いいます、「主,しゅは見,みない、ヤコブの神,かみは悟,さとらない」と。","tok":[["彼","かれ"],["ら"],["は"],["言います","いいます"],["、"],["「"],["主","しゅ"],["は"],["見ない","みない"],["、"],["ヤコブ"],["の"],["神","かみ"],["は"],["悟らない","さとらない"],["」"],["と"],["。"]]},{"verse":8,"text":"民,たみのうちの鈍,にぶき者,ものよ、悟,さとれ。愚,おろかな者,ものよ、いつ賢,かしこくなるだろうか。","tok":[["民","たみ"],["の"],["うち"],["の"],["鈍","に"],["ぶき"],["者","もの"],["よ"],["、"],["悟れ","さとれ"],["。"],["愚か","おろか"],["な"],["者","もの"],["よ"],["、"],["いつ"],["賢しこく","かしこく"],["なるだろう"],["か"],["。"]]},{"verse":9,"text":"耳,みみを植,うえた者,ものは聞,きくことをしないだろうか、目,めを造,つくった者,ものは見,みることをしないだろうか。","tok":[["耳","みみ"],["を"],["植えた","うえた"],["者","もの"],["は"],["聞く","きく"],["こと"],["を"],["しないだろう"],["か"],["、"],["目","め"],["を"],["造った","つくった"],["者","もの"],["は"],["見る","みる"],["こと"],["を"],["しないだろう"],["か"],["。"]]},{"verse":10,"text":"もろもろの国民,こくみんを懲,こらす者,ものは罰,ばっすることをしないだろうか、人,ひとを教,おしえる者,ものは知識,ちしきをもたないだろうか。","tok":[["もろもろ"],["の"],["国民","こくみん"],["を"],["懲らす","こらす"],["者","もの"],["は"],["罰する","ばっする"],["こと"],["を"],["しないだろう"],["か"],["、"],["人","ひと"],["を"],["教える","おしえる"],["者","もの"],["は"],["知識","ちしき"],["を"],["もたないだろう"],["か"],["。"]]},{"verse":11,"text":"主,しゅは人,ひとの思,おもいの、むなしいことを知,しられる。","tok":[["主","しゅ"],["は"],["人","ひと"],["の"],["思い","おもい"],["の"],["、"],["むなしい"],["こと"],["を"],["知られる","しられる"],["。"]]},{"verse":12,"text":"主,しゅよ、あなたによって懲,こらされる人,ひと、あなたのおきてを教,おしえられる人,ひとはさいわいです。","tok":[["主","しゅ"],["よ"],["、"],["あなた"],["によって"],["懲らされる","こらされる"],["人","ひと"],["、"],["あなた"],["の"],["おきて"],["を"],["教えられる","おしえられる"],["人","ひと"],["は"],["さいわい"],["です"],["。"]]},{"verse":13,"text":"あなたはその人,ひとを災,わざわいの日,ひからのがれさせ、悪,あしき者,もののために穴,あなが掘,ほられるまでその人,ひとに平安,へいあんを与,あたえられます。","tok":[["あなた"],["は"],["その"],["人","ひと"],["を"],["災","わざわい"],["の"],["日","ひ"],["から"],["のがれさせ"],["、"],["悪しき","あしき"],["者","もの"],["の"],["ため"],["に"],["穴","あな"],["が"],["掘られる","ほられる"],["まで"],["その"],["人","ひと"],["に"],["平安","へいあん"],["を"],["与えられます","あたえられます"],["。"]]},{"verse":14,"text":"主,しゅはその民,たみを捨,すてず、その嗣,し業,ぎょうを見捨,みすてられないからです。","tok":[["主","しゅ"],["は"],["その"],["民","たみ"],["を"],["捨てず","すてず"],["、"],["その"],["嗣業","しぎょう"],["を"],["見捨てられない","みすてられない"],["から"],["です"],["。"]]},{"verse":15,"text":"さばきは正義,せいぎに帰,かえり、すべて心,こころの正,ただしい者,ものはそれに従,したがうでしょう。","tok":[["さばき"],["は"],["正義","せいぎ"],["に"],["帰えり","かえり"],["、"],["すべて"],["心","こころ"],["の"],["正い","ただしい"],["者","もの"],["は"],["それ"],["に"],["従うでしょう","したがうでしょう"],["。"]]},{"verse":16,"text":"だれがわたしのために立,たちあがって、悪,あしき者,ものを責,せめるだろうか。だれがわたしのために立,たって、不義,ふぎを行,おこなう者,ものを責,せめるだろうか。","tok":[["だれ"],["が"],["わたし"],["の"],["ため"],["に"],["立ちあがって","たちあがって"],["、"],["悪しき","あしき"],["者","もの"],["を"],["責","せめ"],["るだろう"],["か"],["。"],["だれ"],["が"],["わたし"],["の"],["ため"],["に"],["立って","たって"],["、"],["不義","ふぎ"],["を"],["行なう","おこなう"],["者","もの"],["を"],["責","せめ"],["るだろう"],["か"],["。"]]},{"verse":17,"text":"もしも主,しゅがわたしを助,たすけられなかったならば、わが魂,たましいはとくに音,おとなき所,ところに住,すんだであろう。","tok":[["もし"],["も"],["主","しゅ"],["が"],["わたし"],["を"],["助けられなかったならば","たすけられなかったならば"],["、"],["わが"],["魂","たましい"],["は"],["とくに"],["音","おと"],["なき"],["所","ところ"],["に"],["住んだで","すんだで"],["あろう"],["。"]]},{"verse":18,"text":"しかし「わたしの足,あしがすべる」と思,おもったとき、主,しゅよ、あなたのいつくしみはわたしをささえられました。","tok":[["しかし"],["「"],["わたし"],["の"],["足","あし"],["が"],["すべる"],["」"],["と"],["思った","おもった"],["とき"],["、"],["主","しゅ"],["よ"],["、"],["あなた"],["の"],["いつくしみ"],["は"],["わたし"],["を"],["ささえられました"],["。"]]},{"verse":19,"text":"わたしのうちに思,おもい煩,わずらいの満,みちるとき、あなたの慰,なぐさめはわが魂,たましいを喜,よろこばせます。","tok":[["わたし"],["の"],["うち"],["に"],["思い煩い","おもいわずらい"],["の"],["満ちる","みちる"],["とき"],["、"],["あなた"],["の"],["慰さめ","なぐさめ"],["は"],["わが"],["魂","たましい"],["を"],["喜こばせます","よろこばせます"],["。"]]},{"verse":20,"text":"定,さだめをもって危害,きがいをたくらむ悪,あしき支配者,しはいしゃはあなたと親,したしむことができるでしょうか。","tok":[["定め","さだめ"],["を"],["もって"],["危害","きがい"],["を"],["たくらむ"],["悪しき","あしき"],["支配者","しはいしゃ"],["は"],["あなた"],["と"],["親しむ","したしむ"],["こと"],["が"],["できるでしょう"],["か"],["。"]]},{"verse":21,"text":"彼,かれらは相,あい結,むすんで正,ただしい人,ひとの魂,たましいを責,せめ、罪,つみのない者,ものに死,しを宣告,せんこくします。","tok":[["彼","かれ"],["ら"],["は"],["相","あ"],["い"],["結んで","むすんで"],["正い","ただしい"],["人","ひと"],["の"],["魂","たましい"],["を"],["責","せめ"],["、"],["罪","つみ"],["の"],["ない"],["者","もの"],["に"],["死","し"],["を"],["宣告","せんこく"],["します"],["。"]]},{"verse":22,"text":"しかし主,しゅはわが高,たかきやぐらとなり、わが神,かみはわが避,さけ所,どころの岩,いわとなられました。","tok":[["しかし"],["主","しゅ"],["は"],["わが"],["高き","たかき"],["やぐら"],["と"],["なり"],["、"],["わが"],["神","かみ"],["は"],["わが"],["避け","さけ"],["所","どころ"],["の"],["岩","いわ"],["と"],["なられました"],["。"]]},{"verse":23,"text":"主,しゅは彼,かれらの不義,ふぎを彼,かれらに報,むくい、彼,かれらをその悪,あくのゆえに滅,ほろぼされます。われらの神,かみ、主,しゅは彼,かれらを滅,ほろぼされます。","tok":[["主","しゅ"],["は"],["彼","かれ"],["ら"],["の"],["不義","ふぎ"],["を"],["彼","かれ"],["ら"],["に"],["報い","むくい"],["、"],["彼","かれ"],["ら"],["を"],["その"],["悪","あく"],["の"],["ゆえ"],["に"],["滅ぼされます","ほろぼされます"],["。"],["われ"],["ら"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["彼","かれ"],["ら"],["を"],["滅ぼされます","ほろぼされます"],["。"]]}]
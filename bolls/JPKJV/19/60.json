[{"verse":1,"text":"[0]【聖歌,せいか隊,たいの指揮者,しきしゃによって、「あかしのゆり」というしらべにあわせて教,おしえのためにうたわせたダビデのミクタムの歌,うた。","tok":[["["],["0"],["]"],["【"],["聖歌隊","せいかたい"],["の"],["指揮者","しきしゃ"],["によって"],["、"],["「"],["あかし"],["の"],["ゆり"],["」"],["と"],["いう"],["しらべ"],["に"],["あわせて"],["教え","おしえ"],["の"],["ため"],["に"],["うたわせた"],["ダビデ"],["の"],["ミクタム"],["の"],["歌","うた"],["。"]]},{"verse":2,"text":"[00]これはダビデが、アラムナハライムおよびアラムゾバと戦,たたかったとき、ヨアブがその帰,かえりに、塩,しおの谷,たにでエドムびと一万二千人,にんを殺,ころしたときによんだもの】","tok":[["["],["00"],["]"],["これ"],["は"],["ダビデ"],["が"],["、"],["アラムナハライム"],["および"],["アラムゾバ"],["と"],["戦った","たたかった"],["とき"],["、"],["ヨアブ"],["が"],["その"],["帰えり","かえり"],["に"],["、"],["塩","しお"],["の"],["谷","たに"],["で"],["エドム"],["びと"],["一万二千","いちまんにせん"],["人","にん"],["を"],["殺ろした","ころした"],["とき"],["に"],["よんだ"],["もの"],["】"]]},{"verse":3,"text":"[1]神,かみよ、あなたはわれらを捨,すて、われらを打,うち破,やぶられました。あなたは憤,いきどおられました。再,ふたたびわれらをかえしてください。","tok":[["["],["1"],["]"],["神","かみ"],["よ"],["、"],["あなた"],["は"],["われ"],["ら"],["を"],["捨て","すて"],["、"],["われ"],["ら"],["を"],["打ち破られました","うちやぶられました"],["。"],["あなた"],["は"],["憤られました","いきどおられました"],["。"],["再び","ふたたび"],["われ"],["ら"],["を"],["かえして"],["ください"],["。"]]},{"verse":4,"text":"[2]あなたは国,くにを震,ふるわせ、これを裂,さかれました。その破,やぶれをいやしてください。国,くにが揺,ゆれ動,うごくのです。","tok":[["["],["2"],["]"],["あなた"],["は"],["国","くに"],["を"],["震わせ","ふるわせ"],["、"],["これ"],["を"],["裂かれました","さかれました"],["。"],["その"],["破れ","やぶれ"],["を"],["いやして"],["ください"],["。"],["国","くに"],["が"],["揺れ動く","ゆれうごく"],["の"],["です"],["。"]]},{"verse":5,"text":"[3]あなたはその民,たみに耐,たえがたい事,ことをさせ、人,ひとをよろめかす酒,さけをわれらに飲,のませられました。","tok":[["["],["3"],["]"],["あなた"],["は"],["その"],["民","たみ"],["に"],["耐え","たえ"],["がたい"],["事","こと"],["を"],["させ"],["、"],["人","ひと"],["を"],["よろ"],["めかす"],["酒","さけ"],["を"],["われ"],["ら"],["に"],["飲ませられました","のませられました"],["。"]]},{"verse":6,"text":"[4]あなたは弓,ゆみの前,まえからのがれた者,ものを再,ふたたび集,あつめようとあなたを恐,おそれる者,もののために一つの旗,はたを立,たてられました。〔セラ","tok":[["["],["4"],["]"],["あなた"],["は"],["弓","ゆみ"],["の"],["前","まえ"],["から"],["のがれた"],["者","もの"],["を"],["再び","ふたたび"],["集めよう","あつめよう"],["と"],["あなた"],["を"],["恐れる","おそれる"],["者","もの"],["の"],["ため"],["に"],["一","ひと"],["つ"],["の"],["旗","はた"],["を"],["立られました","たてられました"],["。"],["〔"],["セラ"]]},{"verse":7,"text":"[5]あなたの愛,あいされる者,ものが助,たすけを得,えるために、右,みぎの手,てをもって勝利,しょうりを与,あたえ、われらに答,こたえてください。","tok":[["["],["5"],["]"],["あなた"],["の"],["愛される","あいされる"],["者","もの"],["が"],["助け","たすけ"],["を"],["得る","える"],["ため"],["に"],["、"],["右","みぎ"],["の"],["手","て"],["を"],["もって"],["勝利","しょうり"],["を"],["与","あたえ"],["、"],["われ"],["ら"],["に"],["答","こたえ"],["て"],["ください"],["。"]]},{"verse":8,"text":"[6]神,かみはその聖所,せいじょで言,いわれた、「わたしは大,おおいなる喜,よろこびをもってシケムを分,わかち、スコテの谷,たにを分,わかち与,あたえよう。","tok":[["["],["6"],["]"],["神","かみ"],["は"],["その"],["聖","せい"],["所","しょ"],["い"],["じょ"],["で"],["言われた","いわれた"],["、"],["「"],["わたし"],["は"],["大いなる","おおいなる"],["喜こび","よろこび"],["を"],["もって"],["シケム"],["を"],["分かち","わかち"],["、"],["スコテ"],["の"],["谷","たに"],["を"],["分かち","わかち"],["与","あたえ"],["よう"],["。"]]},{"verse":9,"text":"[7]ギレアデはわたしのもの、マナセもわたしのものである。エフライムはわたしのかぶと、ユダはわたしのつえである。","tok":[["["],["7"],["]"],["ギレアデ"],["は"],["わたし"],["の"],["もの"],["、"],["マナセ"],["も"],["わたし"],["の"],["もの"],["で"],["ある"],["。"],["エフライム"],["は"],["わたし"],["の"],["かぶ"],["と"],["、"],["ユダ"],["は"],["わたし"],["の"],["つえ"],["で"],["ある"],["。"]]},{"verse":10,"text":"[8]モアブはわたしの足,あしだらい、エドムにはわたしのくつを投,なげる。ペリシテについては、かちどきをあげる」と。","tok":[["["],["8"],["]"],["モアブ"],["は"],["わたし"],["の"],["足","あし"],["だらい"],["、"],["エドム"],["に"],["は"],["わたし"],["の"],["くつ"],["を"],["投る","なげる"],["。"],["ペリシテ"],["について"],["は"],["、"],["かちどき"],["を"],["あげる"],["」"],["と"],["。"]]},{"verse":11,"text":"[9]だれがわたしを堅固,けんごな町,まちに至,いたらせるでしょうか。だれがわたしをエドムに導,みちびくでしょうか。","tok":[["["],["9"],["]"],["だれ"],["が"],["わたし"],["を"],["堅固","けんご"],["な"],["町","まち"],["に"],["至らせるでしょう","いたらせるでしょう"],["か"],["。"],["だれ"],["が"],["わたし"],["を"],["エドム"],["に"],["導くでしょう","みちびくでしょう"],["か"],["。"]]},{"verse":12,"text":"[10]神,かみよ、あなたはわれらを捨,すてられたではありませんか。神,かみよ、あなたはわれらの軍勢,ぐんぜいと共,ともに出,でて行,いかれません。","tok":[["["],["10"],["]"],["神","かみ"],["よ"],["、"],["あなた"],["は"],["われ"],["ら"],["を"],["捨てられたで","すてられたで"],["は"],["ありません"],["か"],["。"],["神","かみ"],["よ"],["、"],["あなた"],["は"],["われ"],["ら"],["の"],["軍勢","ぐんぜい"],["と"],["共","とも"],["に"],["出て","でて"],["行かれません","いかれません"],["。"]]},{"verse":13,"text":"[11]われらに助,たすけを与,あたえて、あだにむかわせてください。人,ひとの助,たすけはむなしいのです。","tok":[["["],["11"],["]"],["われ"],["ら"],["に"],["助け","たすけ"],["を"],["与","あたえ"],["て"],["、"],["あだ"],["に"],["むかわせて"],["ください"],["。"],["人","ひと"],["の"],["助け","たすけ"],["は"],["むなしい"],["の"],["です"],["。"]]},{"verse":14,"text":"[12]われらは神,かみによって勇,いさましく働,はたらきます。われらのあだを踏,ふみにじる者,ものは神,かみだからです。","tok":[["["],["12"],["]"],["われ"],["ら"],["は"],["神","かみ"],["によって"],["勇ましく","いさましく"],["働らき","はたらき"],["ます"],["。"],["われ"],["ら"],["の"],["あだ"],["を"],["踏みにじる","ふみにじる"],["者","もの"],["は"],["神","かみ"],["だ"],["から"],["です"],["。"]]}]
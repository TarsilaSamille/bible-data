[{"verse":1,"text":"[0]【コラの子,この歌,うた、さんび】","tok":[["["],["0"],["]"],["【"],["コラ"],["の"],["子","こ"],["の"],["歌","うた"],["、"],["さん"],["び"],["】"]]},{"verse":2,"text":"[1]主,しゅは大,おおいなる神,かみであって、われらの神,かみの都,みやこ、その聖,せいなる山,やまで、大,おおいにほめたたえらるべき方,かたである。","tok":[["["],["1"],["]"],["主","しゅ"],["は"],["大いなる","おおいなる"],["神","かみ"],["で"],["あって"],["、"],["われ"],["ら"],["の"],["神","かみ"],["の"],["都","み"],["やこ"],["、"],["その"],["聖","せい"],["なる"],["山","やま"],["で"],["、"],["大いに","おおいに"],["ほめたたえらるべき"],["方","かた"],["で"],["ある"],["。"]]},{"verse":3,"text":"[2]シオンの山,やまは北,きたの端,はしが高,たかくて、うるわしく、全,ぜん地,ちの喜,よろこびであり、大,おおいなる王,おうの都,みやこである。","tok":[["["],["2"],["]"],["シオン"],["の"],["山","やま"],["は"],["北","きた"],["の"],["端","はし"],["が"],["高かくて","たかくて"],["、"],["うるわしく"],["、"],["全地","ぜんち"],["の"],["喜こびで","よろこびで"],["あり"],["、"],["大いなる","おおいなる"],["王","おう"],["の"],["都","みやこ"],["で"],["ある"],["。"]]},{"verse":4,"text":"[3]そのもろもろの殿,とののうちに神,かみはみずからを高,たかきやぐらとして現,あらわされた。","tok":[["["],["3"],["]"],["その"],["もろもろ"],["の"],["殿","との"],["の"],["うち"],["に"],["神","かみ"],["は"],["みずから"],["を"],["高き","たかき"],["やぐら"],["として"],["現わされた","あらわされた"],["。"]]},{"verse":5,"text":"[4]見,みよ、王,おうらは相,あい会,かいして共,ともに進,すすんできたが、","tok":[["["],["4"],["]"],["見よ","みよ"],["、"],["王","おう"],["ら"],["は"],["相","あ"],["い"],["会して","かいして"],["共","とも"],["に"],["進んで","すすんで"],["きた"],["が"],["、"]]},{"verse":6,"text":"[5]彼,かれらは都,みやこを見,みるや驚,おどろき、あわてふためき、急,いそぎ逃,にげ去,さった。","tok":[["["],["5"],["]"],["彼","かれ"],["ら"],["は"],["都","みやこ"],["を"],["見る","みる"],["や"],["驚","おどろき"],["、"],["あわてふためき"],["、"],["急ぎ","いそぎ"],["逃去","にげさっ"],["た"],["。"]]},{"verse":7,"text":"[6]おののきは彼,かれらに臨,のぞみ、その苦,くるしみは産,うみの苦,くるしみをする女,おんなのようであった。","tok":[["["],["6"],["]"],["おののき"],["は"],["彼","かれ"],["ら"],["に"],["臨み","のぞみ"],["、"],["その"],["苦しみ","くるしみ"],["は"],["産み","うみ"],["の"],["苦しみ","くるしみ"],["を"],["する"],["女","おんな"],["の"],["よう"],["で"],["あった"],["。"]]},{"verse":8,"text":"[7]あなたは東風,ひがしかぜを起,おこしてタルシシの舟,ふねを破,やぶられた。","tok":[["["],["7"],["]"],["あなた"],["は"],["東風","ひ"],["が"],["し"],["かぜ"],["を"],["起こして","おこして"],["タルシシ"],["の"],["舟","ふね"],["を"],["破られた","やぶられた"],["。"]]},{"verse":9,"text":"[8]さきにわれらが聞,きいたように、今,いまわれらは万軍,ばんぐんの主,しゅの都,みやこ、われらの神,かみの都,みやこでこれを見,みることができた。神,かみはとこしえにこの都,みやこを堅,かたくされる。〔セラ","tok":[["["],["8"],["]"],["さき"],["に"],["われ"],["ら"],["が"],["聞いた","きいた"],["よう"],["に"],["、"],["今","いま"],["われ"],["ら"],["は"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["の"],["都","み"],["やこ"],["、"],["われ"],["ら"],["の"],["神","かみ"],["の"],["都","み"],["や"],["こ"],["で"],["これ"],["を"],["見る","みる"],["こと"],["が"],["できた"],["。"],["神","かみ"],["は"],["とこしえ"],["に"],["この"],["都","みやこ"],["を"],["堅く","かたく"],["される"],["。"],["〔"],["セラ"]]},{"verse":10,"text":"[9]神,かみよ、われらはあなたの宮,みやのうちであなたのいつくしみを思,おもいました。","tok":[["["],["9"],["]"],["神","かみ"],["よ"],["、"],["われ"],["ら"],["は"],["あなた"],["の"],["宮","みや"],["の"],["うち"],["で"],["あなた"],["の"],["いつくしみ"],["を"],["思いました","おもいました"],["。"]]},{"verse":11,"text":"[10]神,かみよ、あなたの誉,ほまれは、あなたのみ名,なのように、地,ちのはてにまで及,およびます。あなたの右,みぎの手,ては勝利,しょうりで満,みちています。","tok":[["["],["10"],["]"],["神","かみ"],["よ"],["、"],["あなた"],["の"],["誉","ほまれ"],["は"],["、"],["あなた"],["のみ"],["名","な"],["の"],["よう"],["に"],["、"],["地","ち"],["の"],["はて"],["に"],["まで"],["及","および"],["ます"],["。"],["あなた"],["の"],["右","みぎ"],["の"],["手","て"],["は"],["勝利","しょうり"],["で"],["満ちて","みちて"],["います"],["。"]]},{"verse":12,"text":"[11]あなたのさばきのゆえに、シオンの山,やまを喜,よろこばせ、ユダの娘,むすめを楽,たのしませてください。","tok":[["["],["11"],["]"],["あなた"],["の"],["さばき"],["の"],["ゆえ"],["に"],["、"],["シオン"],["の"],["山","やま"],["を"],["喜こばせ","よろこばせ"],["、"],["ユダ"],["の"],["娘","むすめ"],["を"],["楽しませて","たのしませて"],["ください"],["。"]]},{"verse":13,"text":"[12]シオンのまわりを歩,あるき、あまねくめぐって、そのやぐらを数,かぞえ、","tok":[["["],["12"],["]"],["シオン"],["の"],["まわり"],["を"],["歩き","あるき"],["、"],["あまねく"],["めぐって"],["、"],["その"],["やぐら"],["を"],["数え","かぞえ"],["、"]]},{"verse":14,"text":"[13]その城壁,じょうへきに心,こころをとめ、そのもろもろの殿,とのをしらべよ。これはあなたがたが後,のちの代,よに語,かたり伝,つたえるためである。","tok":[["["],["13"],["]"],["その"],["城壁","じょうへき"],["に"],["心","こころ"],["を"],["とめ"],["、"],["その"],["もろもろ"],["の"],["殿","との"],["を"],["しらべ"],["よ"],["。"],["これ"],["は"],["あなた"],["がた"],["が"],["後","のち"],["の"],["代","よ"],["に"],["語り伝える","かたりつたえる"],["ため"],["で"],["ある"],["。"]]},{"verse":15,"text":"[14]これこそ神,かみであり、世々,よよかぎりなくわれらの神,かみであって、とこしえにわれらを導,みちびかれるであろう。","tok":[["["],["14"],["]"],["これ"],["こそ"],["神","かみ"],["で"],["あり"],["、"],["世々","よ"],["よ"],["かぎりなく"],["われ"],["ら"],["の"],["神","かみ"],["で"],["あって"],["、"],["とこしえ"],["に"],["われ"],["ら"],["を"],["導かれるで","みちびかれるで"],["あろう"],["。"]]}]
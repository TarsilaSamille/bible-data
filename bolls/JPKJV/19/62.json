[{"verse":1,"text":"[0]【聖歌,せいか隊,たいの指揮者,しきしゃによってエドトンのしらべにしたがってうたわせたダビデの歌,うた】","tok":[["["],["0"],["]"],["【"],["聖歌隊","せいかたい"],["の"],["指揮者","しきしゃ"],["によって"],["エドトン"],["の"],["しらべ"],["に"],["したがって"],["うたわせた"],["ダビデ"],["の"],["歌","うた"],["】"]]},{"verse":2,"text":"[1]わが魂,たましいはもだしてただ神,かみをまつ。わが救,すくいは神,かみから来,くる。","tok":[["["],["1"],["]"],["わが"],["魂","たましい"],["は"],["もだして"],["ただ"],["神","かみ"],["を"],["まつ"],["。"],["わが"],["救い","すくい"],["は"],["神","かみ"],["から"],["来る","くる"],["。"]]},{"verse":3,"text":"[2]神,かみこそわが岩,いわ、わが救,すくい、わが高,たかきやぐらである。わたしはいたく動,うごかされることはない。","tok":[["["],["2"],["]"],["神","かみ"],["こそ"],["わが"],["岩","いわ"],["、"],["わが"],["救い","すくい"],["、"],["わが"],["高き","たかき"],["やぐら"],["で"],["ある"],["。"],["わたし"],["は"],["いたく"],["動かされる","うごかされる"],["こと"],["は"],["ない"],["。"]]},{"verse":4,"text":"[3]あなたがたは、いつまで人,ひとに押,おし迫,せまるのか。あなたがたは皆,みな、傾,かたむいた石,いしがきのように、揺,ゆり動,うごくまがきのように人,ひとを倒,たおそうとするのか。","tok":[["["],["3"],["]"],["あなた"],["がた"],["は"],["、"],["いつ"],["まで"],["人","ひと"],["に"],["押","おし"],["迫まる","せまる"],["の"],["か"],["。"],["あなた"],["がた"],["は"],["皆","みな"],["、"],["傾いた","かたむいた"],["石がき","いしがき"],["の"],["よう"],["に"],["、"],["揺り","ゆり"],["動く","うごく"],["ま"],["がき"],["の"],["よう"],["に"],["人","ひと"],["を"],["倒そう","たおそう"],["と"],["する"],["の"],["か"],["。"]]},{"verse":5,"text":"[4]彼,かれらは人,ひとを尊,たっとい地位,ちいから落,おとそうとのみはかり、偽,いつわりを喜,よろこび、その口,くちでは祝福,しゅくふくし、心,こころのうちではのろうのである。〔セラ","tok":[["["],["4"],["]"],["彼","かれ"],["ら"],["は"],["人","ひと"],["を"],["尊","た"],["っと"],["い"],["地位","ちい"],["から"],["落とそう","おとそう"],["と"],["のみ"],["はかり"],["、"],["偽り","いつわり"],["を"],["喜こび","よろこび"],["、"],["その"],["口","くち"],["で"],["は"],["祝福","しゅくふく"],["し"],["、"],["心","こころ"],["の"],["うち"],["で"],["は"],["のろう"],["ので"],["ある"],["。"],["〔"],["セラ"]]},{"verse":6,"text":"[5]わが魂,たましいはもだしてただ神,かみをまつ。わが望,のぞみは神,かみから来,くるからである。","tok":[["["],["5"],["]"],["わが"],["魂","たましい"],["は"],["もだして"],["ただ"],["神","かみ"],["を"],["まつ"],["。"],["わが"],["望み","のぞみ"],["は"],["神","かみ"],["から"],["来る","くる"],["から"],["で"],["ある"],["。"]]},{"verse":7,"text":"[6]神,かみこそわが岩,いわ、わが救,すくい、わが高,たかきやぐらである。わたしは動,うごかされることはない。","tok":[["["],["6"],["]"],["神","かみ"],["こそ"],["わが"],["岩","いわ"],["、"],["わが"],["救い","すくい"],["、"],["わが"],["高き","たかき"],["やぐら"],["で"],["ある"],["。"],["わたし"],["は"],["動かされる","うごかされる"],["こと"],["は"],["ない"],["。"]]},{"verse":8,"text":"[7]わが救,すくいとわが誉,ほまれとは神,かみにある。神,かみはわが力,ちからの岩,いわ、わが避,さけ所,どころである。","tok":[["["],["7"],["]"],["わが"],["救い","すくい"],["と"],["わが"],["誉","ほまれ"],["と"],["は"],["神","かみ"],["に"],["ある"],["。"],["神","かみ"],["は"],["わが"],["力","ちから"],["の"],["岩","いわ"],["、"],["わが"],["避け","さけ"],["所","ど"],["ころ"],["で"],["ある"],["。"]]},{"verse":9,"text":"[8]民,たみよ、いかなる時,ときにも神,かみに信頼,しんらいせよ。そのみ前,まえにあなたがたの心,こころを注,そそぎ出,だせ。神,かみはわれらの避,さけ所,どころである。〔セラ","tok":[["["],["8"],["]"],["民","たみ"],["よ"],["、"],["いかなる"],["時","とき"],["に"],["も"],["神","かみ"],["に"],["信頼","しんらい"],["せよ"],["。"],["その"],["み前","みまえ"],["に"],["あなた"],["がた"],["の"],["心","こころ"],["を"],["注ぎ","そそぎ"],["出せ","だせ"],["。"],["神","かみ"],["は"],["われ"],["ら"],["の"],["避け","さけ"],["所","ど"],["ころ"],["で"],["ある"],["。"],["〔"],["セラ"]]},{"verse":10,"text":"[9]低,ひくい人,ひとはむなしく、高,たかい人,ひとは偽,いつわりである。彼,かれらをはかりにおけば、彼,かれらは共,ともに息,いきよりも軽,かるい。","tok":[["["],["9"],["]"],["低い","ひくい"],["人","ひと"],["は"],["むなしく"],["、"],["高かい","たかい"],["人","ひと"],["は"],["偽わりで","いつわりで"],["ある"],["。"],["彼","かれ"],["ら"],["を"],["はかり"],["に"],["おけば"],["、"],["彼","かれ"],["ら"],["は"],["共","とも"],["に"],["息","いき"],["より"],["も"],["軽い","かるい"],["。"]]},{"verse":11,"text":"[10]あなたがたは、しえたげにたよってはならない。かすめ奪,うばうことに、むなしい望,のぞみをおいてはならない。富,とみの増,まし加,くわわるとき、これに心,こころをかけてはならない。","tok":[["["],["10"],["]"],["あなた"],["がた"],["は"],["、"],["し"],["えたげ"],["に"],["たよって"],["は"],["ならない"],["。"],["かすめ"],["奪う","うばう"],["こと"],["に"],["、"],["むなしい"],["望み","のぞみ"],["を"],["おいて"],["は"],["ならない"],["。"],["富","とみ"],["の"],["増し","まし"],["加わわる","くわわる"],["とき"],["、"],["これ"],["に"],["心","こころ"],["を"],["かけて"],["は"],["ならない"],["。"]]},{"verse":12,"text":"[11]神,かみはひとたび言,いわれた、わたしはふたたびこれを聞,きいた、力,ちからは神,かみに属,ぞくすることを。","tok":[["["],["11"],["]"],["神","かみ"],["は"],["ひとたび"],["言われた","いわれた"],["、"],["わたし"],["は"],["ふたたび"],["これ"],["を"],["聞いた","きいた"],["、"],["力","ちから"],["は"],["神","かみ"],["に"],["属する","ぞくする"],["こと"],["を"],["。"]]},{"verse":13,"text":"[12]主,しゅよ、いつくしみもまたあなたに属,ぞくすることを。あなたは人,ひとおのおののわざにしたがって報,むくいられるからである。","tok":[["["],["12"],["]"],["主","しゅ"],["よ"],["、"],["いつくしみ"],["も"],["また"],["あなた"],["に"],["属する","ぞくする"],["こと"],["を"],["。"],["あなた"],["は"],["人","ひと"],["おのおの"],["の"],["わざ"],["に"],["したがって"],["報いられる","むくいられる"],["から"],["で"],["ある"],["。"]]}]
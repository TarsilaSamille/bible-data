[{"verse":1,"text":"[0]【ベニヤミンびとクシのことについてダビデが主,しゅにむかってうたったシガヨンの歌,うた】","tok":[["["],["0"],["]"],["【"],["ベニヤミン"],["びと"],["クシ"],["の"],["こと"],["について"],["ダビデ"],["が"],["主に","しゅに"],["むか"],["って"],["うたった"],["シガヨン"],["の"],["歌","うた"],["】"]]},{"verse":2,"text":"[1]わが神,かみ、主,しゅよ、わたしはあなたに寄,より頼,たのみます。どうかすべての追,おい迫,せまる者,ものからわたしを救,すくい、わたしをお助,たすけください。","tok":[["["],["1"],["]"],["わが"],["神","かみ"],["、"],["主","しゅ"],["よ"],["、"],["わたし"],["は"],["あなた"],["に"],["寄り","より"],["頼みます","たのみます"],["。"],["どう"],["か"],["すべて"],["の"],["追い","おい"],["迫まる","せまる"],["者","もの"],["から"],["わたし"],["を"],["救い","すくい"],["、"],["わたし"],["を"],["お助け","おたすけ"],["ください"],["。"]]},{"verse":3,"text":"[2]さもないと彼,かれらは、ししのように、わたしをかき裂,さき、助,たすける者,ものの来,きないうちに、引,ひいて行,いくでしょう。","tok":[["["],["2"],["]"],["さ"],["も"],["ない"],["と"],["彼","かれ"],["ら"],["は"],["、"],["しし"],["の"],["よう"],["に"],["、"],["わたし"],["を"],["かき裂き","かきさき"],["、"],["助ける","たすける"],["者","もの"],["の"],["来ない","きない"],["うち"],["に"],["、"],["引いて","ひいて"],["行くでしょう","いくでしょう"],["。"]]},{"verse":4,"text":"[3]わが神,かみ、主,しゅよ、もしわたしがこの事,ことを行,おこなったならば、もしわたしの手,てによこしまな事,ことがあるならば、","tok":[["["],["3"],["]"],["わが"],["神","かみ"],["、"],["主","しゅ"],["よ"],["、"],["もし"],["わたし"],["が"],["この"],["事","こと"],["を"],["行なったならば","おこなったならば"],["、"],["もし"],["わたし"],["の"],["手","て"],["に"],["よこしま"],["な"],["事","こと"],["が"],["あるならば"],["、"]]},{"verse":5,"text":"[4]もしわたしの友,ともに悪,あくをもって報,むくいたことがあり、ゆえなく、敵,てきのものを略奪,りゃくだつしたことがあるならば、","tok":[["["],["4"],["]"],["もし"],["わたし"],["の"],["友","とも"],["に"],["悪","あく"],["を"],["もって"],["報いた","むくいた"],["こと"],["が"],["あり"],["、"],["ゆえ"],["なく"],["、"],["敵","てき"],["の"],["もの"],["を"],["略奪","りゃくだつ"],["した"],["こと"],["が"],["あるならば"],["、"]]},{"verse":6,"text":"[5]敵,てきにわたしを追,おい捕,とらえさせ、わたしの命,いのちを地,ちに踏,ふみにじらせ、わたしの魂,たましいをちりにゆだねさせてください。〔セラ","tok":[["["],["5"],["]"],["敵","てき"],["に"],["わたし"],["を"],["追い","おい"],["捕らえさせ","とらえさせ"],["、"],["わたし"],["の"],["命","いのち"],["を"],["地","ち"],["に"],["踏みにじらせ","ふみにじらせ"],["、"],["わたし"],["の"],["魂","たましい"],["を"],["ちり"],["に"],["ゆだねさせて"],["ください"],["。"],["〔"],["セラ"]]},{"verse":7,"text":"[6]主,しゅよ、怒,いかりをもって立,たち、わたしの敵,てきの憤,いきどおりにむかって立,たちあがり、わたしのために目,めをさましてください。あなたはさばきを命,めいじられました。","tok":[["["],["6"],["]"],["主","しゅ"],["よ"],["、"],["怒り","いかり"],["を"],["もって"],["立ち","たち"],["、"],["わたし"],["の"],["敵","てき"],["の"],["憤り","いきどおり"],["に"],["むかって"],["立ちあがり","たちあがり"],["、"],["わたし"],["の"],["ため"],["に"],["目","め"],["を"],["さまして"],["ください"],["。"],["あなた"],["は"],["さばき"],["を"],["命じられました","めいじられました"],["。"]]},{"verse":8,"text":"[7]もろもろの民,たみをあなたのまわりにつどわせ、その上,うえなる高,たかみくらにおすわりください。","tok":[["["],["7"],["]"],["もろもろ"],["の"],["民","たみ"],["を"],["あなた"],["の"],["まわり"],["に"],["つどわせ"],["、"],["その"],["上","うえ"],["なる"],["高み","たかみ"],["くら"],["に"],["おすわり"],["ください"],["。"]]},{"verse":9,"text":"[8]主,しゅはもろもろの民,たみをさばかれます。主,しゅよ、わたしの義,ぎと、わたしにある誠実,せいじつとに従,したがって、わたしをさばいてください。","tok":[["["],["8"],["]"],["主","しゅ"],["は"],["もろもろ"],["の"],["民","たみ"],["を"],["さばかれます"],["。"],["主","しゅ"],["よ"],["、"],["わたし"],["の"],["義","ぎ"],["と"],["、"],["わたし"],["に"],["ある"],["誠実","せいじつ"],["と"],["に"],["従って","したがって"],["、"],["わたし"],["を"],["さばいて"],["ください"],["。"]]},{"verse":10,"text":"[9]どうか悪,あしき者,ものの悪,あくを断,たち、正,ただしき者,ものを堅,かたく立,たたせてください。義,ぎなる神,かみよ、あなたは人,ひとの心,こころと思,おもいとを調,しらべられます。","tok":[["["],["9"],["]"],["どう"],["か"],["悪しき","あしき"],["者","もの"],["の"],["悪","あく"],["を"],["断ち","たち"],["、"],["正き者","ただしきもの"],["を"],["堅く","かたく"],["立たせて","たたせて"],["ください"],["。"],["義","ぎ"],["なる"],["神","かみ"],["よ"],["、"],["あなた"],["は"],["人","ひと"],["の"],["心","こころ"],["と"],["思い","おもい"],["と"],["を"],["調べられます","しらべられます"],["。"]]},{"verse":11,"text":"[10]わたしを守,まもる盾,たては神,かみである。神,かみは心,こころの直,なおき者,ものを救,すくわれる。","tok":[["["],["10"],["]"],["わたし"],["を"],["守","まもる"],["盾","たて"],["は"],["神","かみ"],["で"],["ある"],["。"],["神","かみ"],["は"],["心","こころ"],["の"],["直","な"],["おき"],["者","もの"],["を"],["救われる","すくわれる"],["。"]]},{"verse":12,"text":"[11]神,かみは義,ぎなるさばきびと、日,ひごとに憤,いきどおりを起,おこされる神,かみである。","tok":[["["],["11"],["]"],["神","かみ"],["は"],["義","ぎ"],["なる"],["さば"],["きび"],["と"],["、"],["日ごと","ひごと"],["に"],["憤り","いきどおり"],["を"],["起こされる","おこされる"],["神","かみ"],["で"],["ある"],["。"]]},{"verse":13,"text":"[12]もし人,ひとが悔,くい改,あらためないならば、神,かみはそのつるぎをとぎ、その弓,ゆみを張,はって構,かまえ、","tok":[["["],["12"],["]"],["もし"],["人","ひと"],["が"],["悔い","くい"],["改","あらため"],["ないならば"],["、"],["神","かみ"],["は"],["その"],["つるぎ"],["を"],["とぎ"],["、"],["その"],["弓","ゆみ"],["を"],["張って","はって"],["構","かまえ"],["、"]]},{"verse":14,"text":"[13]また死,しに至,いたらせる武器,ぶきを備,そなえ、その矢,やを火矢,ひやとされる。","tok":[["["],["13"],["]"],["また"],["死","し"],["に"],["至らせる","いたらせる"],["武器","ぶき"],["を"],["備","そなえ"],["、"],["その"],["矢","や"],["を"],["火矢","ひや"],["と"],["される"],["。"]]},{"verse":15,"text":"[14]見,みよ、悪,あしき者,ものは邪悪,じゃあくをはらみ、害毒,がいどくをやどし、偽,いつわりを生,うむ。","tok":[["["],["14"],["]"],["見よ","みよ"],["、"],["悪しき","あしき"],["者","もの"],["は"],["邪悪","じゃあく"],["を"],["はらみ"],["、"],["害毒","がいどく"],["を"],["やどし"],["、"],["偽り","いつわり"],["を"],["生む","うむ"],["。"]]},{"verse":16,"text":"[15]彼,かれは穴,あなを掘,ほって、それを深,ふかくし、みずから作,つくった穴,あなに陥,おちいる。","tok":[["["],["15"],["]"],["彼","かれ"],["は"],["穴","あな"],["を"],["掘って","ほって"],["、"],["それ"],["を"],["深く","ふかく"],["し"],["、"],["みずから"],["作った","つくった"],["穴","あな"],["に"],["陥ち","おち"],["いる"],["。"]]},{"verse":17,"text":"[16]その害毒,がいどくは自分,じぶんのかしらに帰,かえり、その強暴,きょうぼうは自分,じぶんのこうべに下,くだる。","tok":[["["],["16"],["]"],["その"],["害毒","がいどく"],["は"],["自分","じぶん"],["の"],["かしら"],["に"],["帰えり","かえり"],["、"],["その"],["強暴","きょうぼう"],["は"],["自分","じぶん"],["の"],["こうべ"],["に"],["下る","くだる"],["。"]]},{"verse":18,"text":"[17]わたしは主,しゅにむかって、その義,ぎにふさわしい感謝,かんしゃをささげ、いと高,たかき者,ものなる主,しゅの名,なをほめ歌,うたうであろう。","tok":[["["],["17"],["]"],["わたし"],["は"],["主に","しゅに"],["むかって"],["、"],["その"],["義","ぎ"],["に"],["ふさわしい"],["感謝","かんしゃ"],["を"],["ささげ"],["、"],["いと"],["高き","たかき"],["者","もの"],["なる"],["主","しゅ"],["の"],["名","な"],["を"],["ほめ"],["歌うで","うたうで"],["あろう"],["。"]]}]
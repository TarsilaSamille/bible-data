[{"verse":1,"text":"【都,みやこもうでの歌,うた】主,しゅよ、ダビデのために、そのもろもろの辛苦,しんくをみこころにとめてください。","tok":[["【"],["都","みやこもう"],["で"],["の"],["歌","うた"],["】"],["主","しゅ"],["よ"],["、"],["ダビデ"],["の"],["ため"],["に"],["、"],["その"],["もろもろ"],["の"],["辛苦","しんく"],["を"],["みこころ"],["に"],["とめて"],["ください"],["。"]]},{"verse":2,"text":"ダビデは主,しゅに誓,ちかい、ヤコブの全能者,ぜんのうしゃに誓,ちかいを立,たてて言,いいました、","tok":[["ダビデ"],["は"],["主に","しゅに"],["誓い","ちかい"],["、"],["ヤコブ"],["の"],["全能者","ぜんのうしゃ"],["に"],["誓い","ちかい"],["を"],["立てて","たてて"],["言いました","いいました"],["、"]]},{"verse":3,"text":"[3-5]「わたしは主,しゅのために所,ところを捜,さがし出,だし、ヤコブの全能者,ぜんのうしゃのためにすまいを求,もとめ得,えるまでは、わが家,やに入,いらず、わが寝台,しんだいに上,のぼらず、わが目,めに眠,ねむりを与,あたえず、わがまぶたにまどろみを与,あたえません」。","tok":[["["],["3"],["-"],["5"],["]"],["「"],["わたし"],["は"],["主","しゅ"],["の"],["ため"],["に"],["所","ところ"],["を"],["捜し出し","さがしだし"],["、"],["ヤコブ"],["の"],["全能者","ぜんのうしゃ"],["の"],["ため"],["に"],["すまい"],["を"],["求め","もとめ"],["得る","える"],["まで"],["は"],["、"],["わが家","わがや"],["に"],["入らず","いらず"],["、"],["わが"],["寝台","しんだい"],["に"],["上らず","のぼらず"],["、"],["わが"],["目","め"],["に"],["眠","ねむり"],["を"],["与えず","あたえず"],["、"],["わが"],["まぶた"],["に"],["まどろみ"],["を"],["与","あたえ"],["ません"],["」"],["。"]]},{"verse":4,"text":"*[3-5]「わたしは主,しゅのために所,ところを捜,さがし出,だし、ヤコブの全能者,ぜんのうしゃのためにすまいを求,もとめ得,えるまでは、わが家,やに入,いらず、わが寝台,しんだいに上,のぼらず、わが目,めに眠,ねむりを与,あたえず、わがまぶたにまどろみを与,あたえません」。","tok":[["*"],["["],["3"],["-"],["5"],["]"],["「"],["わたし"],["は"],["主","しゅ"],["の"],["ため"],["に"],["所","ところ"],["を"],["捜し出し","さがしだし"],["、"],["ヤコブ"],["の"],["全能者","ぜんのうしゃ"],["の"],["ため"],["に"],["すまい"],["を"],["求め","もとめ"],["得る","える"],["まで"],["は"],["、"],["わが家","わがや"],["に"],["入らず","いらず"],["、"],["わが"],["寝台","しんだい"],["に"],["上らず","のぼらず"],["、"],["わが"],["目","め"],["に"],["眠","ねむり"],["を"],["与えず","あたえず"],["、"],["わが"],["まぶた"],["に"],["まどろみ"],["を"],["与","あたえ"],["ません"],["」"],["。"]]},{"verse":5,"text":"*[3-5]「わたしは主,しゅのために所,ところを捜,さがし出,だし、ヤコブの全能者,ぜんのうしゃのためにすまいを求,もとめ得,えるまでは、わが家,やに入,いらず、わが寝台,しんだいに上,のぼらず、わが目,めに眠,ねむりを与,あたえず、わがまぶたにまどろみを与,あたえません」。","tok":[["*"],["["],["3"],["-"],["5"],["]"],["「"],["わたし"],["は"],["主","しゅ"],["の"],["ため"],["に"],["所","ところ"],["を"],["捜し出し","さがしだし"],["、"],["ヤコブ"],["の"],["全能者","ぜんのうしゃ"],["の"],["ため"],["に"],["すまい"],["を"],["求め","もとめ"],["得る","える"],["まで"],["は"],["、"],["わが家","わがや"],["に"],["入らず","いらず"],["、"],["わが"],["寝台","しんだい"],["に"],["上らず","のぼらず"],["、"],["わが"],["目","め"],["に"],["眠","ねむり"],["を"],["与えず","あたえず"],["、"],["わが"],["まぶた"],["に"],["まどろみ"],["を"],["与","あたえ"],["ません"],["」"],["。"]]},{"verse":6,"text":"見,みよ、われらはエフラタでそれを聞,きき、ヤアルの野,のでそれを見,みとめた。","tok":[["見よ","みよ"],["、"],["われ"],["ら"],["は"],["エフラタ"],["で"],["それ"],["を"],["聞","きき"],["、"],["ヤアル"],["の"],["野","の"],["で"],["それ"],["を"],["見とめた","みとめた"],["。"]]},{"verse":7,"text":"「われらはそのすまいへ行,いって、その足,あし台,だいのもとにひれ伏,ふそう」。","tok":[["「"],["われ"],["ら"],["は"],["その"],["すまい"],["へ"],["行って","いって"],["、"],["その"],["足台","あしだい"],["の"],["もと"],["に"],["ひれ伏そう","ひれふそう"],["」"],["。"]]},{"verse":8,"text":"主,しゅよ、起,おきて、あなたの力,ちからのはこと共,ともに、あなたの安息所,あんそくじょにおはいりください。","tok":[["主","しゅ"],["よ"],["、"],["起きて","おきて"],["、"],["あなた"],["の"],["力","ちから"],["の"],["は"],["こと"],["共","とも"],["に"],["、"],["あなた"],["の"],["安息所","あんそくじょ"],["に"],["おはいり"],["ください"],["。"]]},{"verse":9,"text":"あなたの祭司,さいしたちに義,ぎをまとわせ、あなたの聖徒,せいとたちに喜,よろこび呼,よばわらせてください。","tok":[["あなた"],["の"],["祭司","さいし"],["たち"],["に"],["義","ぎ"],["を"],["まとわせ"],["、"],["あなた"],["の"],["聖徒","せいと"],["たち"],["に"],["喜こび","よろこび"],["呼ばわらせて","よばわらせて"],["ください"],["。"]]},{"verse":10,"text":"あなたのしもべダビデのために、あなたの油,あぶらそそがれた者,ものの顔,かおを、しりぞけないでください。","tok":[["あなた"],["の"],["しもべ"],["ダビデ"],["の"],["ため"],["に"],["、"],["あなた"],["の"],["油","あぶら"],["そそがれた"],["者","もの"],["の"],["顔","かお"],["を"],["、"],["しりぞけないで"],["ください"],["。"]]},{"verse":11,"text":"主,しゅはまことをもってダビデに誓,ちかわれたので、それにそむくことはない。すなわち言,いわれた、「わたしはあなたの身,みから出,でた子,このひとりを、あなたの位,くらいにつかせる。","tok":[["主","しゅ"],["は"],["まこと"],["を"],["もって"],["ダビデ"],["に"],["誓われた","ちかわれた"],["ので"],["、"],["それ"],["に"],["そむく"],["こと"],["は"],["ない"],["。"],["すなわち"],["言われた","いわれた"],["、"],["「"],["わたし"],["は"],["あなた"],["の"],["身","み"],["から"],["出た","でた"],["子","こ"],["の"],["ひとり"],["を"],["、"],["あなた"],["の"],["位","くらい"],["に"],["つかせる"],["。"]]},{"verse":12,"text":"もしあなたの子,こらがわたしの教,おしえる契約,けいやくと、あかしとを守,まもるならば、その子,こらもまた、とこしえにあなたの位,くらいに座,ざするであろう」。","tok":[["もし"],["あなた"],["の"],["子","こ"],["ら"],["が"],["わたし"],["の"],["教える","おしえる"],["契約","けいやく"],["と"],["、"],["あかし"],["と"],["を"],["守","まもる"],["ならば"],["、"],["その"],["子","こ"],["ら"],["も"],["また"],["、"],["とこしえ"],["に"],["あなた"],["の"],["位","くらい"],["に"],["座するで","ざするで"],["あろう"],["」"],["。"]]},{"verse":13,"text":"主,しゅはシオンを選,えらび、それをご自分,じぶんのすみかにしようと望,のぞんで言,いわれた、","tok":[["主","しゅ"],["は"],["シオン"],["を"],["選ら","えら"],["び"],["、"],["それ"],["を"],["ご自分","ごじぶん"],["の"],["すみか"],["に"],["しよう"],["と"],["望んで","のぞんで"],["言われた","いわれた"],["、"]]},{"verse":14,"text":"「これはとこしえにわが安息所,あんそくじょである。わたしはこれを望,のぞんだゆえ、ここに住,すむ。","tok":[["「"],["これ"],["は"],["とこしえ"],["に"],["わが"],["安息所","あん"],["そ"],["く"],["じょ"],["で"],["ある"],["。"],["わたし"],["は"],["これ"],["を"],["望んだ","のぞんだ"],["ゆえ"],["、"],["ここ"],["に"],["住む","すむ"],["。"]]},{"verse":15,"text":"わたしはシオンの糧食,りょうしょくを豊,ゆたかに祝福,しゅくふくし、食物,しょくもつをもってその貧,まずしい者,ものを飽,あかせる。","tok":[["わたし"],["は"],["シオン"],["の"],["糧食","りょうしょく"],["を"],["豊","ゆたか"],["に"],["祝福","しゅくふく"],["し"],["、"],["食物","しょくもつ"],["を"],["もって"],["その"],["貧しい","まずしい"],["者","もの"],["を"],["飽かせる","あかせる"],["。"]]},{"verse":16,"text":"またわたしはその祭司,さいしたちに救,すくいを着,きせる。その聖徒,せいとたちは声,こえ高,たからかに喜,よろこび呼,よばわるであろう。","tok":[["また"],["わたし"],["は"],["その"],["祭司","さいし"],["たち"],["に"],["救い","すくい"],["を"],["着せる","きせる"],["。"],["その"],["聖徒","せいと"],["たち"],["は"],["声","こえ"],["高らか","たからか"],["に"],["喜こび","よろこび"],["呼ばわるで","よばわるで"],["あろう"],["。"]]},{"verse":17,"text":"わたしはダビデのためにそこに一つの角,つのをはえさせる。わたしはわが油,あぶらそそがれた者,もののために一つのともしびを備,そなえた。","tok":[["わたし"],["は"],["ダビデ"],["の"],["ため"],["に"],["そこ"],["に"],["一","ひと"],["つ"],["の"],["角","つ"],["の"],["を"],["は"],["え"],["させる"],["。"],["わたし"],["は"],["わが"],["油","あぶら"],["そそがれた"],["者","もの"],["の"],["ため"],["に"],["一","ひと"],["つ"],["の"],["ともしび"],["を"],["備","そなえ"],["た"],["。"]]},{"verse":18,"text":"わたしは彼,かれの敵,てきに恥,はじを着,きせる。しかし彼,かれの上,うえにはその冠,かんむりが輝,かがやくであろう」。","tok":[["わたし"],["は"],["彼","かれ"],["の"],["敵","てき"],["に"],["恥","はじ"],["を"],["着せる","きせる"],["。"],["しかし"],["彼","かれ"],["の"],["上","うえ"],["に"],["は"],["その"],["冠","かんむり"],["が"],["輝やくで","かがやくで"],["あろう"],["」"],["。"]]}]
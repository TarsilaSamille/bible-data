[{"verse":1,"text":"【アサフの歌,うた】全能者,ぜんのうしゃなる神,かみ、主,しゅは詔,みことのりして、日,ひの出,でるところから日,ひの入,いるところまであまねく地,ちに住,すむ者,ものを召,めし集,あつめられる。","tok":[["【"],["アサフ"],["の"],["歌","うた"],["】"],["全能者","ぜんのうしゃ"],["なる"],["神","かみ"],["、"],["主","しゅ"],["は"],["詔","みことのり"],["して"],["、"],["日","ひ"],["の"],["出る","でる"],["ところ"],["から"],["日","ひ"],["の"],["入る","いる"],["ところ"],["まで"],["あまねく"],["地","ち"],["に"],["住む","すむ"],["者","もの"],["を"],["召","めし"],["集められる","あつめられる"],["。"]]},{"verse":2,"text":"神,かみは麗,うるわしさのきわみであるシオンから光,ひかりを放,はなたれる。","tok":[["神","かみ"],["は"],["麗わし","うるわし"],["さ"],["の"],["きわみ"],["で"],["ある"],["シオン"],["から"],["光","ひかり"],["を"],["放たれる","はなたれる"],["。"]]},{"verse":3,"text":"われらの神,かみは来,きて、もだされない。み前,まえには焼,やきつくす火,ひがあり、そのまわりには、はげしい暴風,ぼうふうがある。","tok":[["われ"],["ら"],["の"],["神","かみ"],["は"],["来て","きて"],["、"],["もだされない"],["。"],["み前","みまえ"],["に"],["は"],["焼き","やき"],["つくす"],["火","ひ"],["が"],["あり"],["、"],["その"],["まわり"],["に"],["は"],["、"],["はげしい"],["暴風","ぼうふう"],["が"],["ある"],["。"]]},{"verse":4,"text":"神,かみはその民,たみをさばくために、上,うえなる天,てんおよび地,ちに呼,よばわれる、","tok":[["神","かみ"],["は"],["その"],["民","たみ"],["を"],["さばく"],["ため"],["に"],["、"],["上","うえ"],["なる"],["天","てん"],["および"],["地","ち"],["に"],["呼ばわれる","よばわれる"],["、"]]},{"verse":5,"text":"「いけにえをもってわたしと契約,けいやくを結,むすんだわが聖徒,せいとをわたしのもとに集,あつめよ」と。","tok":[["「"],["いけにえ"],["を"],["もって"],["わたし"],["と"],["契約","けいやく"],["を"],["結んだ","むすんだ"],["わが"],["聖徒","せいと"],["を"],["わたし"],["の"],["もと"],["に"],["集めよ","あつめよ"],["」"],["と"],["。"]]},{"verse":6,"text":"天,てんは神,かみの義,ぎをあらわす、神,かみはみずから、さばきぬしだからである。〔セラ","tok":[["天","てん"],["は"],["神","かみ"],["の"],["義","ぎ"],["を"],["あらわす"],["、"],["神","かみ"],["は"],["みずから"],["、"],["さばき"],["ぬし"],["だ"],["から"],["で"],["ある"],["。"],["〔"],["セラ"]]},{"verse":7,"text":"「わが民,たみよ、聞,きけ、わたしは言,いう。イスラエルよ、わたしはあなたにむかってあかしをなす。わたしは神,かみ、あなたの神,かみである。","tok":[["「"],["わが"],["民","たみ"],["よ"],["、"],["聞け","きけ"],["、"],["わたし"],["は"],["言う","いう"],["。"],["イスラエル"],["よ"],["、"],["わたし"],["は"],["あなた"],["に"],["むかって"],["あかし"],["を"],["なす"],["。"],["わたし"],["は"],["神","かみ"],["、"],["あなた"],["の"],["神","かみ"],["で"],["ある"],["。"]]},{"verse":8,"text":"わたしがあなたを責,せめるのは、あなたのいけにえのゆえではない。あなたの燔祭,はんさいはいつもわたしの前,まえにある。","tok":[["わたし"],["が"],["あなた"],["を"],["責","せめ"],["る"],["の"],["は"],["、"],["あなた"],["の"],["いけにえ"],["の"],["ゆえ"],["で"],["は"],["ない"],["。"],["あなた"],["の"],["燔祭","はんさい"],["は"],["いつも"],["わたし"],["の"],["前","まえ"],["に"],["ある"],["。"]]},{"verse":9,"text":"わたしはあなたの家,いえから雄牛,おうしを取,とらない。またあなたのおりから雄,おやぎを取,とらない。","tok":[["わたし"],["は"],["あなた"],["の"],["家","いえ"],["から"],["雄牛","おうし"],["を"],["取らない","とらない"],["。"],["また"],["あなた"],["の"],["おり"],["から"],["雄","おやぎ"],["を"],["取らない","とらない"],["。"]]},{"verse":10,"text":"林,はやしのすべての獣,けものはわたしのもの、丘,おかの上,うえの千々,ちぢの家畜,かちくもわたしのものである。","tok":[["林","はやし"],["の"],["すべて"],["の"],["獣","けもの"],["は"],["わたし"],["の"],["もの"],["、"],["丘","おか"],["の"],["上","うえ"],["の"],["千々","ちぢ"],["の"],["家畜","かちく"],["も"],["わたし"],["の"],["もの"],["で"],["ある"],["。"]]},{"verse":11,"text":"わたしは空,そらの鳥,とりをことごとく知,しっている。野,のに動,うごくすべてのものはわたしのものである。","tok":[["わたし"],["は"],["空","そら"],["の"],["鳥","とり"],["を"],["ことごとく"],["知って","しって"],["いる"],["。"],["野","の"],["に"],["動く","うごく"],["すべて"],["の"],["もの"],["は"],["わたし"],["の"],["もの"],["で"],["ある"],["。"]]},{"verse":12,"text":"たといわたしは飢,うえても、あなたに告,つげない、世界,せかいとその中,なかに満,みちるものとはわたしのものだからである。","tok":[["たとい"],["わたし"],["は"],["飢","うえ"],["て"],["も"],["、"],["あなた"],["に"],["告","つげ"],["ない"],["、"],["世界","せかい"],["と"],["その"],["中","なか"],["に"],["満ちる","みちる"],["もの"],["と"],["は"],["わたし"],["の"],["もの"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":13,"text":"わたしは雄牛,おうしの肉,にくを食,たべ、雄,おやぎの血,ちを飲,のむだろうか。","tok":[["わたし"],["は"],["雄牛","おうし"],["の"],["肉","にく"],["を"],["食べ","たべ"],["、"],["雄","おやぎ"],["の"],["血","ち"],["を"],["飲むだろう","のむだろう"],["か"],["。"]]},{"verse":14,"text":"感謝,かんしゃのいけにえを神,かみにささげよ。あなたの誓,ちかいをいと高,たかき者,ものに果,はたせ。","tok":[["感謝","かんしゃ"],["の"],["いけにえ"],["を"],["神","かみ"],["に"],["ささげ"],["よ"],["。"],["あなた"],["の"],["誓い","ちかい"],["を"],["い"],["と"],["高き","たかき"],["者","もの"],["に"],["果たせ","はたせ"],["。"]]},{"verse":15,"text":"悩,なやみの日,ひにわたしを呼,よべ、わたしはあなたを助,たすけ、あなたはわたしをあがめるであろう」。","tok":[["悩み","なやみ"],["の"],["日","ひ"],["に"],["わたし"],["を"],["呼べ","よべ"],["、"],["わたし"],["は"],["あなた"],["を"],["助け","たすけ"],["、"],["あなた"],["は"],["わたし"],["を"],["あがめるで"],["あろう"],["」"],["。"]]},{"verse":16,"text":"しかし神,かみは悪,あしき者,ものに言,いわれる、「あなたはなんの権利,けんりがあってわたしの定,さだめを述,のべ、わたしの契約,けいやくを口,くちにするのか。","tok":[["しかし"],["神","かみ"],["は"],["悪しき","あしき"],["者","もの"],["に"],["言われる","いわれる"],["、"],["「"],["あなた"],["は"],["なん"],["の"],["権利","けんり"],["が"],["あって"],["わたし"],["の"],["定め","さだめ"],["を"],["述べ","のべ"],["、"],["わたし"],["の"],["契約","けいやく"],["を"],["口","くち"],["に"],["する"],["の"],["か"],["。"]]},{"verse":17,"text":"あなたは教,おしえを憎,にくみ、わたしの言葉,ことばを捨,すて去,さった。","tok":[["あなた"],["は"],["教え","おしえ"],["を"],["憎み","にくみ"],["、"],["わたし"],["の"],["言葉","ことば"],["を"],["捨て","すて"],["去た","さった"],["。"]]},{"verse":18,"text":"あなたは盗,ぬすびとを見,みればこれとむつみ、姦淫,かんいんを行,おこなう者,ものと交,まじわる。","tok":[["あなた"],["は"],["盗","ぬすびと"],["を"],["見れば","みれば"],["これ"],["と"],["むつみ"],["、"],["姦淫","かんいん"],["を"],["行なう","おこなう"],["者","もの"],["と"],["交じわる","まじわる"],["。"]]},{"verse":19,"text":"あなたはその口,くちを悪,あくにわたし、あなたの舌,したはたばかりを仕組,しくむ。","tok":[["あなた"],["は"],["その"],["口","くち"],["を"],["悪","あく"],["に"],["わたし"],["、"],["あなた"],["の"],["舌","した"],["はた"],["ばかり"],["を"],["仕組む","しくむ"],["。"]]},{"verse":20,"text":"あなたは座,ざしてその兄弟,きょうだいをそしり、自分,じぶんの母,ははの子,こをののしる。","tok":[["あなた"],["は"],["座して","ざして"],["その"],["兄弟","きょうだい"],["を"],["そしり"],["、"],["自分","じぶん"],["の"],["母","はは"],["の"],["子","こ"],["を"],["ののしる"],["。"]]},{"verse":21,"text":"あなたがこれらの事,ことをしたのを、わたしが黙,だまっていたので、あなたはわたしを全,まったく自分,じぶんとひとしい者,ものと思,おもった。しかしわたしはあなたを責,せめ、あなたの目,めの前,まえにその罪,つみをならべる。","tok":[["あなた"],["が"],["これ"],["ら"],["の"],["事","こと"],["を"],["した"],["の"],["を"],["、"],["わたし"],["が"],["黙って","だまって"],["いた"],["ので"],["、"],["あなた"],["は"],["わたし"],["を"],["全く","まったく"],["自分","じぶん"],["と"],["ひとしい"],["者","もの"],["と"],["思った","おもった"],["。"],["しかし"],["わたし"],["は"],["あなた"],["を"],["責","せめ"],["、"],["あなた"],["の"],["目","め"],["の"],["前","まえ"],["に"],["その"],["罪","つみ"],["を"],["ならべる"],["。"]]},{"verse":22,"text":"神,かみを忘,わすれる者,ものよ、このことを思,おもえ。さもないとわたしはあなたをかき裂,さく。そのときだれも助,たすける者,ものはないであろう。","tok":[["神","かみ"],["を"],["忘る","わすれる"],["者","もの"],["よ"],["、"],["この"],["こと"],["を"],["思え","おもえ"],["。"],["さも"],["ない"],["と"],["わたし"],["は"],["あなた"],["を"],["かき裂く","かきさく"],["。"],["その"],["とき"],["だれ"],["も"],["助ける","たすける"],["者","もの"],["は"],["ないで"],["あろう"],["。"]]},{"verse":23,"text":"感謝,かんしゃのいけにえをささげる者,ものはわたしをあがめる。自分,じぶんのおこないを慎,つつしむ者,ものにはわたしは神,かみの救,すくいを示,しめす」。","tok":[["感謝","かんしゃ"],["の"],["いけにえ"],["を"],["ささげる"],["者","もの"],["は"],["わたし"],["を"],["あがめる"],["。"],["自分","じぶん"],["の"],["おこない"],["を"],["慎しむ","つつしむ"],["者","もの"],["に"],["は"],["わたし"],["は"],["神","かみ"],["の"],["救い","すくい"],["を"],["示めす","しめす"],["」"],["。"]]}]
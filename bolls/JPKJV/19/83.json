[{"verse":1,"text":"[0]【アサフの歌,うた、さんび】","tok":[["["],["0"],["]"],["【"],["アサフ"],["の"],["歌","うた"],["、"],["さん"],["び"],["】"]]},{"verse":2,"text":"[1]神,かみよ、沈黙,ちんもくを守,まもらないでください。神,かみよ、何,なにも言,いわずに、黙,だまっていないでください。","tok":[["["],["1"],["]"],["神","かみ"],["よ"],["、"],["沈黙","ちんもく"],["を"],["守らないで","まもらないで"],["ください"],["。"],["神","かみ"],["よ"],["、"],["何に","なに"],["も"],["言わず","いわず"],["に"],["、"],["黙って","だまって"],["いないで"],["ください"],["。"]]},{"verse":3,"text":"[2]見,みよ、あなたの敵,てきは騒,さわぎたち、あなたを憎,にくむ者,ものは頭,あたまをあげました。","tok":[["["],["2"],["]"],["見よ","みよ"],["、"],["あなた"],["の"],["敵","てき"],["は"],["騒","さわぎ"],["たち"],["、"],["あなた"],["を"],["憎む","にくむ"],["者","もの"],["は"],["頭","あたま"],["を"],["あげました"],["。"]]},{"verse":4,"text":"[3]彼,かれらはあなたの民,たみにむかって巧,たくみなはかりごとをめぐらし、あなたの保護,ほごされる者,ものにむかって相,あいともに計,はかります。","tok":[["["],["3"],["]"],["彼","かれ"],["ら"],["は"],["あなた"],["の"],["民","たみ"],["に"],["むかって"],["巧","たくみ"],["な"],["はかりごと"],["を"],["めぐらし"],["、"],["あなた"],["の"],["保護","ほご"],["される"],["者","もの"],["に"],["むかって"],["相","あい"],["とも"],["に"],["計ります","はかります"],["。"]]},{"verse":5,"text":"[4]彼,かれらは言,いいます、「さあ、彼,かれらを断,たち滅,ほろぼして国,くにを立,たてさせず、イスラエルの名,なをふたたび思,おもい出,ださせないようにしよう」。","tok":[["["],["4"],["]"],["彼","かれ"],["ら"],["は"],["言います","いいます"],["、"],["「"],["さあ"],["、"],["彼","かれ"],["ら"],["を"],["断ち","たち"],["滅ぼして","ほろぼして"],["国","くに"],["を"],["立てさせず","たてさせず"],["、"],["イスラエル"],["の"],["名","な"],["を"],["ふたたび"],["思い出させない","おもいださせない"],["よう"],["に"],["しよう"],["」"],["。"]]},{"verse":6,"text":"[5]彼,かれらは心,こころをひとつにして共,ともにはかり、あなたに逆,さからって契約,けいやくを結,むすびます。","tok":[["["],["5"],["]"],["彼","かれ"],["ら"],["は"],["心","こころ"],["を"],["ひと"],["つ"],["に"],["して"],["共","とも"],["に"],["はかり"],["、"],["あなた"],["に"],["逆らって","さからって"],["契約","けいやく"],["を"],["結びます","むすびます"],["。"]]},{"verse":7,"text":"[6]すなわちエドムの天幕,てんまくに住,すむ者,ものとイシマエルびと、モアブとハガルびと、","tok":[["["],["6"],["]"],["すなわち"],["エドム"],["の"],["天幕","てんまく"],["に"],["住む","すむ"],["者","もの"],["と"],["イシマエル"],["び"],["と"],["、"],["モアブ"],["と"],["ハガル"],["び"],["と"],["、"]]},{"verse":8,"text":"[7]ゲバルとアンモンとアマレク、ペリシテとツロの住民,じゅうみんなどです。","tok":[["["],["7"],["]"],["ゲバル"],["と"],["アンモン"],["と"],["アマレク"],["、"],["ペリシテ"],["と"],["ツロ"],["の"],["住民","じゅうみん"],["など"],["です"],["。"]]},{"verse":9,"text":"[8]アッスリヤもまた彼,かれらにくみしました。彼,かれらはロトの子孫,しそんを助,たすけました。〔セラ","tok":[["["],["8"],["]"],["アッスリヤ"],["も"],["また"],["彼","かれ"],["ら"],["に"],["くみしました"],["。"],["彼","かれ"],["ら"],["は"],["ロト"],["の"],["子孫","しそん"],["を"],["助けました","たすけました"],["。"],["〔"],["セラ"]]},{"verse":10,"text":"[9]あなたがミデアンにされたように、キション川,かわでシセラとヤビンにされたように、彼,かれらにしてください。","tok":[["["],["9"],["]"],["あなた"],["が"],["ミデアン"],["に"],["された"],["よう"],["に"],["、"],["キション"],["川","かわ"],["で"],["シセラ"],["と"],["ヤビン"],["に"],["された"],["よう"],["に"],["、"],["彼","かれ"],["ら"],["に"],["して"],["ください"],["。"]]},{"verse":11,"text":"[10]彼,かれらはエンドルで滅,ほろぼされ、地,ちのために肥料,ひりょうとなりました。","tok":[["["],["10"],["]"],["彼","かれ"],["ら"],["は"],["エンドル"],["で"],["滅ぼされ","ほろぼされ"],["、"],["地","ち"],["の"],["ため"],["に"],["肥料","ひりょう"],["と"],["なりました"],["。"]]},{"verse":12,"text":"[11]彼,かれらの貴人,きじんをオレブとゼエブのように、そのすべての君,きみたちをゼバとザルムンナのようにしてください。","tok":[["["],["11"],["]"],["彼","かれ"],["ら"],["の"],["貴人","きじん"],["を"],["オレブ"],["と"],["ゼエブ"],["の"],["よう"],["に"],["、"],["その"],["すべて"],["の"],["君","きみ"],["たち"],["を"],["ゼバ"],["と"],["ザルムンナ"],["の"],["よう"],["に"],["して"],["ください"],["。"]]},{"verse":13,"text":"[12]彼,かれらは言,いいました、「われらは神,かみの牧場,まきばを獲,えて、われらの所有,しょゆうにしよう」と。","tok":[["["],["12"],["]"],["彼","かれ"],["ら"],["は"],["言いました","いいました"],["、"],["「"],["われ"],["ら"],["は"],["神","かみ"],["の"],["牧場","まきば"],["を"],["獲て","えて"],["、"],["われ"],["ら"],["の"],["所有","しょゆう"],["に"],["しよう"],["」"],["と"],["。"]]},{"verse":14,"text":"[13]わが神,かみよ、彼,かれらを巻,まきあげられるちりのように、風,かぜの前,まえのもみがらのようにしてください。","tok":[["["],["13"],["]"],["わが"],["神","かみ"],["よ"],["、"],["彼","かれ"],["ら"],["を"],["巻","まき"],["あげられる"],["ちり"],["の"],["よう"],["に"],["、"],["風","かぜ"],["の"],["前","まえ"],["の"],["もみがら"],["の"],["よう"],["に"],["して"],["ください"],["。"]]},{"verse":15,"text":"[14]林,はやしを焼,やく火,ひのように、山,やまを燃,もやす炎,ほのおのように、","tok":[["["],["14"],["]"],["林","はやし"],["を"],["焼く","やく"],["火","ひ"],["の"],["よう"],["に"],["、"],["山","やま"],["を"],["燃やす","もやす"],["炎","ほのお"],["の"],["よう"],["に"],["、"]]},{"verse":16,"text":"[15]あなたのはやてをもって彼,かれらを追,おい、つむじかぜをもって彼,かれらを恐,おそれさせてください。","tok":[["["],["15"],["]"],["あなた"],["の"],["はやて"],["を"],["もって"],["彼","かれ"],["ら"],["を"],["追い","おい"],["、"],["つむじ"],["かぜ"],["を"],["もって"],["彼","かれ"],["ら"],["を"],["恐れさせて","おそれさせて"],["ください"],["。"]]},{"verse":17,"text":"[16]彼,かれらの顔,かおに恥,はじを満,みたしてください。主,しゅよ、そうすれば彼,かれらはあなたの名,なを求,もとめるでしょう。","tok":[["["],["16"],["]"],["彼","かれ"],["ら"],["の"],["顔","かお"],["に"],["恥","はじ"],["を"],["満たして","みたして"],["ください"],["。"],["主","しゅ"],["よ"],["、"],["そう"],["すれば"],["彼","かれ"],["ら"],["は"],["あなた"],["の"],["名","な"],["を"],["求めるでしょう","もとめるでしょう"],["。"]]},{"verse":18,"text":"[17]彼,かれらをとこしえに恥,はじ恐,おそれさせ、あわて惑,まどって滅,ほろびうせさせてください。","tok":[["["],["17"],["]"],["彼","かれ"],["ら"],["を"],["とこしえ"],["に"],["恥","はじ"],["恐れさせ","おそれさせ"],["、"],["あわて惑って","あわてまどって"],["滅び","ほろび"],["うせさせて"],["ください"],["。"]]},{"verse":19,"text":"[18]主,しゅという名,なをおもちになるあなたのみ、全,ぜん地,ちをしろしめすいと高,たかき者,ものであることを彼,かれらに知,しらせてください。","tok":[["["],["18"],["]"],["主","しゅ"],["と"],["いう"],["名","な"],["を"],["おもち"],["に"],["なる"],["あなた"],["のみ"],["、"],["全地","ぜんち"],["を"],["しろしめす"],["いと"],["高き","たかき"],["者","もの"],["で"],["ある"],["こと"],["を"],["彼","かれ"],["ら"],["に"],["知らせて","しらせて"],["ください"],["。"]]}]
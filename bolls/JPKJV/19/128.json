[{"verse":1,"text":"【都,みやこもうでの歌,うた】すべて主,しゅをおそれ、主,しゅの道,みちに歩,あゆむ者,ものはさいわいである。","tok":[["【"],["都","みやこもう"],["で"],["の"],["歌","うた"],["】"],["すべて"],["主","しゅ"],["を"],["おそれ"],["、"],["主","しゅ"],["の"],["道","みち"],["に"],["歩む","あゆむ"],["者","もの"],["は"],["さいわい"],["で"],["ある"],["。"]]},{"verse":2,"text":"あなたは自分,じぶんの手,ての勤労,きんろうの実,みを食,たべ、幸福,こうふくで、かつ安,やすらかであろう。","tok":[["あなた"],["は"],["自分","じぶん"],["の"],["手","て"],["の"],["勤労","きんろう"],["の"],["実","み"],["を"],["食べ","たべ"],["、"],["幸福","こうふく"],["で"],["、"],["かつ"],["安らか","やすらか"],["で"],["あろう"],["。"]]},{"verse":3,"text":"あなたの妻,つまは家,いえの奥,おくにいて多,おおくの実,みを結,むすぶぶどうの木,きのようであり、あなたの子供,こどもたちは食卓,しょくたくを囲,かこんでオリブの若木,わかぎのようである。","tok":[["あなた"],["の"],["妻","つま"],["は"],["家","いえ"],["の"],["奥","おく"],["に"],["いて"],["多く","おおく"],["の"],["実","み"],["を"],["結ぶ","むすぶ"],["ぶどう"],["の"],["木","き"],["の"],["よう"],["で"],["あり"],["、"],["あなた"],["の"],["子供","こども"],["たち"],["は"],["食卓","しょくたく"],["を"],["囲んで","かこんで"],["オリブ"],["の"],["若木","わかぎ"],["の"],["よう"],["で"],["ある"],["。"]]},{"verse":4,"text":"見,みよ、主,しゅをおそれる人,ひとは、このように祝福,しゅくふくを得,える。","tok":[["見よ","みよ"],["、"],["主","しゅ"],["を"],["おそれる"],["人","ひと"],["は"],["、"],["この"],["よう"],["に"],["祝福","しゅくふく"],["を"],["得る","える"],["。"]]},{"verse":5,"text":"主,しゅはシオンからあなたを祝福,しゅくふくされるように。あなたは世,よにあるかぎりエルサレムの繁栄,はんえいを見,み、","tok":[["主","しゅ"],["は"],["シオン"],["から"],["あなた"],["を"],["祝福","しゅくふく"],["される"],["よう"],["に"],["。"],["あなた"],["は"],["世","よ"],["に"],["ある"],["かぎり"],["エルサレム"],["の"],["繁栄","はんえい"],["を"],["見","み"],["、"]]},{"verse":6,"text":"またあなたの子,こらの子,こを見,みるであろう。どうぞ、イスラエルの上,うえに平安,へいあんがあるように。","tok":[["また"],["あなた"],["の"],["子","こ"],["ら"],["の"],["子","こ"],["を"],["見るで","みるで"],["あろう"],["。"],["どうぞ"],["、"],["イスラエル"],["の"],["上","うえ"],["に"],["平安","へいあん"],["が"],["ある"],["よう"],["に"],["。"]]}]
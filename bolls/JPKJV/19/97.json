[{"verse":1,"text":"主,しゅは王,おうとなられた。地,ちは楽,たのしみ、海,うみに沿,そった多,おおくの国々,くにぐには喜,よろこべ。","tok":[["主","しゅ"],["は"],["王","おう"],["と"],["なられた"],["。"],["地","ち"],["は"],["楽み","たのしみ"],["、"],["海","うみ"],["に"],["沿った","そった"],["多く","おおく"],["の"],["国々","くにぐに"],["は"],["喜こべ","よろこべ"],["。"]]},{"verse":2,"text":"雲,くもと暗,くらやみとはそのまわりにあり、義,ぎと正,せいとはそのみくらの基,もといである。","tok":[["雲","くも"],["と"],["暗やみ","くらやみ"],["と"],["は"],["その"],["まわり"],["に"],["あり"],["、"],["義","ぎ"],["と"],["正","せい"],["と"],["は"],["その"],["みく"],["ら"],["の"],["基いで","もといで"],["ある"],["。"]]},{"verse":3,"text":"火,ひはそのみ前,まえに行,いき、そのまわりのあだを焼,やきつくす。","tok":[["火","ひ"],["は"],["その"],["み前","みまえ"],["に"],["行き","いき"],["、"],["その"],["まわり"],["の"],["あだ"],["を"],["焼き","やき"],["つくす"],["。"]]},{"verse":4,"text":"主,しゅのいなずまは世界,せかいを照,てらし、地,ちは見,みておののく。","tok":[["主","しゅ"],["の"],["いなずま"],["は"],["世界","せかい"],["を"],["照","てらし"],["、"],["地","ち"],["は"],["見て","みて"],["おののく"],["。"]]},{"verse":5,"text":"もろもろの山,やまは主,しゅのみ前,まえに、全,ぜん地,ちの主,しゅのみ前,まえに、ろうのように溶,とけた。","tok":[["もろもろ"],["の"],["山","やま"],["は"],["主","しゅ"],["のみ"],["前","まえ"],["に"],["、"],["全地","ぜんち"],["の"],["主","しゅ"],["のみ"],["前","まえ"],["に"],["、"],["ろう"],["の"],["よう"],["に"],["溶けた","とけた"],["。"]]},{"verse":6,"text":"もろもろの天,てんはその義,ぎをあらわし、よろずの民,たみはその栄光,えいこうを見,みた。","tok":[["もろもろ"],["の"],["天","てん"],["は"],["その"],["義","ぎ"],["を"],["あらわし"],["、"],["よろず"],["の"],["民","たみ"],["は"],["その"],["栄光","えいこう"],["を"],["見た","みた"],["。"]]},{"verse":7,"text":"すべて刻,きざんだ像,ぞうを拝,おがむ者,もの、むなしい偶像,ぐうぞうをもってみずから誇,ほこる者,ものははずかしめをうける。もろもろの神,かみは主,しゅのみ前,まえにひれ伏,ふす。","tok":[["すべて"],["刻んだ","きざんだ"],["像","ぞう"],["を"],["拝む","おがむ"],["者","もの"],["、"],["むなしい"],["偶像","ぐうぞう"],["を"],["もって"],["みず"],["から"],["誇る","ほこる"],["者","もの"],["は"],["はずかしめ"],["を"],["うける"],["。"],["もろもろ"],["の"],["神","かみ"],["は"],["主","しゅ"],["のみ"],["前","まえ"],["に"],["ひれ伏す","ひれふす"],["。"]]},{"verse":8,"text":"主,しゅよ、あなたのさばきのゆえに、シオンは聞,きいて喜,よろこび、ユダの娘,むすめたちは楽,たのしむ。","tok":[["主","しゅ"],["よ"],["、"],["あなた"],["の"],["さばき"],["の"],["ゆえ"],["に"],["、"],["シオン"],["は"],["聞いて","きいて"],["喜こび","よろこび"],["、"],["ユダ"],["の"],["娘","むすめ"],["たち"],["は"],["楽しむ","たのしむ"],["。"]]},{"verse":9,"text":"主,しゅよ、あなたは全,ぜん地,ちの上,うえにいまして、いと高,たかく、もろもろの神,かみにまさって大,おおいにあがめられます。","tok":[["主","しゅ"],["よ"],["、"],["あなた"],["は"],["全地","ぜんち"],["の"],["上","うえ"],["に"],["いまして"],["、"],["いと"],["高かく","たかく"],["、"],["もろもろ"],["の"],["神","かみ"],["に"],["まさって"],["大いに","おおいに"],["あがめられます"],["。"]]},{"verse":10,"text":"主,しゅは悪,あくを憎,にくむ者,ものを愛,あいし、その聖徒,せいとのいのちを守,まもり、これを悪,あしき者,ものの手,てから助,たすけ出,だされる。","tok":[["主","しゅ"],["は"],["悪","あく"],["を"],["憎む","にくむ"],["者","もの"],["を"],["愛し","あいし"],["、"],["その"],["聖徒","せいと"],["の"],["いのち"],["を"],["守り","まもり"],["、"],["これ"],["を"],["悪しき","あしき"],["者","もの"],["の"],["手","て"],["から"],["助け出される","たすけだされる"],["。"]]},{"verse":11,"text":"光,ひかりは正,ただしい人,ひとのために現,あらわれ、喜,よろこびは心,こころの正,ただしい者,もののためにあらわれる。","tok":[["光","ひかり"],["は"],["正い","ただしい"],["人","ひと"],["の"],["ため"],["に"],["現われ","あらわれ"],["、"],["喜こび","よろこび"],["は"],["心","こころ"],["の"],["正い","ただしい"],["者","もの"],["の"],["ため"],["に"],["あらわれる"],["。"]]},{"verse":12,"text":"正,ただしき人,ひとよ、主,しゅによって喜,よろこべ、その聖,せいなるみ名,なに感謝,かんしゃせよ。","tok":[["正き人","ただしきひと"],["よ"],["、"],["主に","しゅに"],["よって"],["喜こべ","よろこべ"],["、"],["その"],["聖","せい"],["なる"],["み名","みな"],["に"],["感謝","かんしゃ"],["せよ"],["。"]]}]
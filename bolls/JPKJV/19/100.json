[{"verse":1,"text":"【感謝,かんしゃの供,そなえ物,もののための歌,うた】全,ぜん地,ちよ、主,しゅにむかって喜,よろこばしき声,こえをあげよ。","tok":[["【"],["感謝","かんしゃ"],["の"],["供え物","そなえもの"],["の"],["ため"],["の"],["歌","うた"],["】"],["全地","ぜんち"],["よ"],["、"],["主に","しゅに"],["むかって"],["喜こば","よろこば"],["しき"],["声","こえ"],["を"],["あげ"],["よ"],["。"]]},{"verse":2,"text":"喜,よろこびをもって主,しゅに仕,つかえよ。歌,うたいつつ、そのみ前,まえにきたれ。","tok":[["喜こび","よろこび"],["を"],["もって"],["主に","しゅに"],["仕え","つかえ"],["よ"],["。"],["歌い","うたい"],["つつ"],["、"],["その"],["み前","みまえ"],["に"],["きたれ"],["。"]]},{"verse":3,"text":"主,しゅこそ神,かみであることを知,しれ。われらを造,つくられたものは主,しゅであって、われらは主,しゅのものである。われらはその民,たみ、その牧,ぼくの羊,ひつじである。","tok":[["主","しゅ"],["こそ"],["神","かみ"],["で"],["ある"],["こと"],["を"],["知れ","しれ"],["。"],["われ"],["ら"],["を"],["造られた","つくられた"],["もの"],["は"],["主","しゅ"],["で"],["あって"],["、"],["われ"],["ら"],["は"],["主","しゅ"],["の"],["もの"],["で"],["ある"],["。"],["われ"],["ら"],["は"],["その"],["民","た"],["み"],["、"],["その"],["牧","ぼく"],["の"],["羊","ひつじ"],["で"],["ある"],["。"]]},{"verse":4,"text":"感謝,かんしゃしつつ、その門,もんに入,いり、ほめたたえつつ、その大庭,おおにわに入,いれ。主,しゅに感謝,かんしゃし、そのみ名,なをほめまつれ。","tok":[["感謝","かんしゃ"],["し"],["つつ"],["、"],["その"],["門","もん"],["に"],["入","いり"],["、"],["ほめたたえ"],["つつ"],["、"],["その"],["大庭","おおにわ"],["に"],["入れ","いれ"],["。"],["主に","しゅに"],["感謝","かんしゃ"],["し"],["、"],["その"],["み名","みな"],["を"],["ほめ"],["まつれ"],["。"]]},{"verse":5,"text":"主,しゅは恵,めぐみふかく、そのいつくしみはかぎりなく、そのまことはよろず代,よに及,およぶからである。","tok":[["主","しゅ"],["は"],["恵","めぐみ"],["ふかく"],["、"],["その"],["いつくしみ"],["は"],["かぎりなく"],["、"],["その"],["まこと"],["は"],["よろず代","よろずよ"],["に"],["及ぶ","およぶ"],["から"],["で"],["ある"],["。"]]}]
[{"verse":1,"text":"[0]【聖歌,せいか隊,たいの指揮者,しきしゃによって、「滅,ほろぼすな」というしらべにあわせてうたわせたダビデのミクタムの歌,うた。これはサウルがダビデを殺,ころそうとして人,ひとをつかわし、その家,いえをうかがわせたときダビデのよんだもの】","tok":[["["],["0"],["]"],["【"],["聖歌隊","せいかたい"],["の"],["指揮者","しきしゃ"],["によって"],["、"],["「"],["滅ぼす","ほろぼす"],["な"],["」"],["と"],["いう"],["しらべ"],["に"],["あわせて"],["うたわせた"],["ダビデ"],["の"],["ミクタム"],["の"],["歌","うた"],["。"],["これ"],["は"],["サウル"],["が"],["ダビデ"],["を"],["殺そう","ころそう"],["として"],["人","ひと"],["を"],["つかわし"],["、"],["その"],["家","いえ"],["を"],["うかがわせた"],["とき"],["ダビデ"],["の"],["よんだ"],["もの"],["】"]]},{"verse":2,"text":"[1]わが神,かみよ、どうかわたしをわが敵,てきから助,たすけ出,だし、わたしに逆,さからって起,おこりたつ者,ものからお守,まもりください。","tok":[["["],["1"],["]"],["わが"],["神","かみ"],["よ"],["、"],["どう"],["か"],["わたし"],["を"],["わが"],["敵","てき"],["から"],["助け出し","たすけだし"],["、"],["わたし"],["に"],["逆らって","さからって"],["起こり","おこり"],["たつ"],["者","もの"],["から"],["お守り","おまもり"],["ください"],["。"]]},{"verse":3,"text":"[2]悪,あくを行,おこなう者,ものからわたしを助,たすけ出,だし、血,ちを流,ながす人,ひとからわたしをお救,すくいください。","tok":[["["],["2"],["]"],["悪","あく"],["を"],["行なう","おこなう"],["者","もの"],["から"],["わたし"],["を"],["助け出し","たすけだし"],["、"],["血","ち"],["を"],["流す","ながす"],["人","ひと"],["から"],["わたし"],["を"],["お救い","おすくい"],["ください"],["。"]]},{"verse":4,"text":"[3]見,みよ、彼,かれらはひそみかくれて、わたしの命,いのちをうかがい、力,ちからある人々,ひとびとが共,ともに集,あつまってわたしを攻,せめます。主,しゅよ、わたしにとがも罪,つみもなく、","tok":[["["],["3"],["]"],["見よ","みよ"],["、"],["彼","かれ"],["ら"],["は"],["ひそみ"],["かくれて"],["、"],["わたし"],["の"],["命","いのち"],["を"],["うかがい"],["、"],["力","ちから"],["ある"],["人々","ひとびと"],["が"],["共","とも"],["に"],["集まって","あつまって"],["わたし"],["を"],["攻めます","せめます"],["。"],["主","しゅ"],["よ"],["、"],["わたし"],["に"],["とが"],["も"],["罪","つみ"],["も"],["なく"],["、"]]},{"verse":5,"text":"[4]わたしにあやまちもないのに、彼,かれらは走,はしりまわって備,そなえをします。わたしを助,たすけるために目,めをさまして、ごらんください。","tok":[["["],["4"],["]"],["わたし"],["に"],["あやまち"],["も"],["ない"],["のに"],["、"],["彼","かれ"],["ら"],["は"],["走りまわって","はしりまわって"],["備","そなえ"],["を"],["します"],["。"],["わたし"],["を"],["助ける","たすける"],["ため"],["に"],["目","め"],["を"],["さまして"],["、"],["ごらん"],["ください"],["。"]]},{"verse":6,"text":"[5]万軍,ばんぐんの神,かみ、主,しゅよ、あなたはイスラエルの神,かみです。目,めをさまして、もろもろの国民,こくみんを罰,ばっし、悪,あくをたくらむ者,ものどもに、あわれみを施,ほどこさないでください。〔セラ","tok":[["["],["5"],["]"],["万","まん"],["軍","ぐん"],["の"],["神","かみ"],["、"],["主","しゅ"],["よ"],["、"],["あなた"],["は"],["イスラエル"],["の"],["神","かみ"],["です"],["。"],["目","め"],["を"],["さまして"],["、"],["もろもろ"],["の"],["国民","こくみん"],["を"],["罰し","ばっし"],["、"],["悪","あく"],["を"],["たくらむ"],["者","もの"],["ども"],["に"],["、"],["あわれみ"],["を"],["施さないで","ほどこさないで"],["ください"],["。"],["〔"],["セラ"]]},{"verse":7,"text":"[6]彼,かれらは夕,ゆうごとに帰,かえってきて、犬,いぬのようにほえて町,まちをあさりまわる。","tok":[["["],["6"],["]"],["彼","かれ"],["ら"],["は"],["夕","ゆう"],["ごと"],["に"],["帰えって","かえって"],["きて"],["、"],["犬","いぬ"],["の"],["よう"],["に"],["ほえて"],["町","まち"],["を"],["あさり"],["まわる"],["。"]]},{"verse":8,"text":"[7]見,みよ、彼,かれらはその口,くちをもってほえ叫,さけび、そのくちびるをもってうなり、「だれが聞,きくものか」と言,いう。","tok":[["["],["7"],["]"],["見よ","みよ"],["、"],["彼","かれ"],["ら"],["は"],["その"],["口","くち"],["を"],["もって"],["ほえ"],["叫","さけび"],["、"],["その"],["くちびる"],["を"],["もって"],["うなり"],["、"],["「"],["だれ"],["が"],["聞く","きく"],["もの"],["か"],["」"],["と"],["言う","いう"],["。"]]},{"verse":9,"text":"[8]しかし、主,しゅよ、あなたは彼,かれらを笑,わらい、もろもろの国民,こくみんをあざけり笑,わらわれる。","tok":[["["],["8"],["]"],["しかし"],["、"],["主","しゅ"],["よ"],["、"],["あなた"],["は"],["彼","かれ"],["ら"],["を"],["笑","わらい"],["、"],["もろもろ"],["の"],["国民","こくみん"],["を"],["あざけり笑われる","あざけりわらわれる"],["。"]]},{"verse":10,"text":"[9]わが力,ちからよ、わたしはあなたにむかってほめ歌,うたいます。神,かみよ、あなたはわたしの高,たかきやぐらです。","tok":[["["],["9"],["]"],["わが"],["力","ちから"],["よ"],["、"],["わたし"],["は"],["あなた"],["に"],["むかって"],["ほめ歌","ほめうた"],["います"],["。"],["神","かみ"],["よ"],["、"],["あなた"],["は"],["わたし"],["の"],["高き","たかき"],["やぐら"],["です"],["。"]]},{"verse":11,"text":"[10]わが神,かみはそのいつくしみをもってわたしを迎,むかえられる。わが神,かみはわたしに敵,てきの敗北,はいぼくを見,みさせられる。","tok":[["["],["10"],["]"],["わが"],["神","かみ"],["は"],["その"],["いつくしみ"],["を"],["もって"],["わたし"],["を"],["迎","むかえ"],["られる"],["。"],["わが"],["神","かみ"],["は"],["わたし"],["に"],["敵","てき"],["の"],["敗北","はいぼく"],["を"],["見させられる","みさせられる"],["。"]]},{"verse":12,"text":"[11]どうぞ、わが民,たみの忘,わすれることのないために、彼,かれらを殺,ころさないでください。主,しゅ、われらの盾,たてよ、み力,ちからをもって彼,かれらをよろめかせ、彼,かれらを倒,たおれさせないでください。","tok":[["["],["11"],["]"],["どうぞ"],["、"],["わが"],["民","たみ"],["の"],["忘る","わすれる"],["こと"],["の"],["ない"],["ため"],["に"],["、"],["彼","かれ"],["ら"],["を"],["殺ろさないで","ころさないで"],["ください"],["。"],["主","しゅ"],["、"],["われ"],["ら"],["の"],["盾","たて"],["よ"],["、"],["み力","みちから"],["を"],["もって"],["彼","かれ"],["ら"],["を"],["よろめかせ"],["、"],["彼","かれ"],["ら"],["を"],["倒れさせないで","たおれさせないで"],["ください"],["。"]]},{"verse":13,"text":"[12]彼,かれらの口,くちの罪,つみ、そのくちびるの言葉,ことばのために彼,かれらをその高,たかぶりに捕,とらわれさせてください。彼,かれらが語,かたるのろいと偽,いつわりのために","tok":[["["],["12"],["]"],["彼","かれ"],["ら"],["の"],["口","くち"],["の"],["罪","つみ"],["、"],["その"],["くちびる"],["の"],["言葉","ことば"],["の"],["ため"],["に"],["彼","かれ"],["ら"],["を"],["その"],["高ぶり","たかぶり"],["に"],["捕らわれさせて","とらわれさせて"],["ください"],["。"],["彼","かれ"],["ら"],["が"],["語る","かたる"],["のろい"],["と"],["偽わり","いつわり"],["の"],["ため"],["に"]]},{"verse":14,"text":"[13]憤,いきどおりをもって彼,かれらを滅,ほろぼし、もはやながらえることのないまでに、彼,かれらを滅,ほろぼしてください。そうすれば地,ちのはてまで、人々,ひとびとは神,かみがヤコブを治,おさめられることを知,しるに至,いたるでしょう。〔セラ","tok":[["["],["13"],["]"],["憤り","いきどおり"],["を"],["もって"],["彼","かれ"],["ら"],["を"],["滅ぼし","ほろぼし"],["、"],["もはや"],["ながらえる"],["こと"],["の"],["ない"],["まで"],["に"],["、"],["彼","かれ"],["ら"],["を"],["滅ぼして","ほろぼして"],["ください"],["。"],["そう"],["すれば"],["地","ち"],["の"],["はて"],["まで"],["、"],["人々","ひとびと"],["は"],["神","かみ"],["が"],["ヤコブ"],["を"],["治められる","おさめられる"],["こと"],["を"],["知る","しる"],["に"],["至るでしょう","いたるでしょう"],["。"],["〔"],["セラ"]]},{"verse":15,"text":"[14]彼,かれらは夕,ゆうごとに帰,かえってきて、犬,いぬのようにほえて町,まちをあさりまわる。","tok":[["["],["14"],["]"],["彼","かれ"],["ら"],["は"],["夕","ゆう"],["ごと"],["に"],["帰えって","かえって"],["きて"],["、"],["犬","いぬ"],["の"],["よう"],["に"],["ほえて"],["町","まち"],["を"],["あさり"],["まわる"],["。"]]},{"verse":16,"text":"[15]彼,かれらは食,くい物,もののためにあるきまわり、飽,あくことを得,えなければ怒,いかりうなる。","tok":[["["],["15"],["]"],["彼","かれ"],["ら"],["は"],["食い物","くいもの"],["の"],["ため"],["に"],["あるきまわり"],["、"],["飽く","あく"],["こと"],["を"],["得なければ","えなければ"],["怒り","いかり"],["うなる"],["。"]]},{"verse":17,"text":"[16]しかし、わたしはあなたのみ力,ちからをうたい、朝,あさには声,こえをあげてみいつくしみを歌,うたいます。あなたはわたしの悩,なやみの日,ひにわが高,たかきやぐらとなり、わたしの避,さけ所,どころとなられたからです。","tok":[["["],["16"],["]"],["しかし"],["、"],["わたし"],["は"],["あなた"],["のみ"],["力","ちから"],["を"],["うたい"],["、"],["朝","あさ"],["に"],["は"],["声","こえ"],["を"],["あげて"],["み"],["いつくしみ"],["を"],["歌います","うたいます"],["。"],["あなた"],["は"],["わたし"],["の"],["悩み","なやみ"],["の"],["日","ひ"],["に"],["わが"],["高き","たかき"],["やぐら"],["と"],["なり"],["、"],["わたし"],["の"],["避け","さけ"],["所","どころ"],["と"],["なられた"],["から"],["です"],["。"]]},{"verse":18,"text":"[17]わが力,ちからよ、わたしはあなたにむかってほめうたいます。神,かみよ、あなたはわが高,たかきやぐら、わたしにいつくしみを賜,たまわる神,かみであられるからです。","tok":[["["],["17"],["]"],["わが"],["力","ちから"],["よ"],["、"],["わたし"],["は"],["あなた"],["に"],["むかって"],["ほめ"],["うたいます"],["。"],["神","かみ"],["よ"],["、"],["あなた"],["は"],["わが"],["高き","たかき"],["やぐら"],["、"],["わたし"],["に"],["いつくしみ"],["を"],["賜わる","たまわる"],["神","かみ"],["で"],["あられる"],["から"],["です"],["。"]]}]
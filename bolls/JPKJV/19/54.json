[{"verse":1,"text":"[0]【聖歌,せいか隊,たいの指揮者,しきしゃによって琴,ことをもってうたわせたダビデのマスキールの歌,うた。","tok":[["["],["0"],["]"],["【"],["聖歌隊","せいかたい"],["の"],["指揮者","しきしゃ"],["によって"],["琴","こと"],["を"],["もって"],["うたわせた"],["ダビデ"],["の"],["マスキール"],["の"],["歌","うた"],["。"]]},{"verse":2,"text":"[00]これはジフびとがサウルにきて、「ダビデはわれらのうちに隠,かくれている」と言,いった時,ときによんだもの】","tok":[["["],["00"],["]"],["これ"],["は"],["ジフ"],["びと"],["が"],["サウル"],["に"],["きて"],["、"],["「"],["ダビデ"],["は"],["われ"],["ら"],["の"],["うち"],["に"],["隠れて","かくれて"],["いる"],["」"],["と"],["言った","いった"],["時","とき"],["に"],["よんだ"],["もの"],["】"]]},{"verse":3,"text":"[1]神,かみよ、み名,なによってわたしを救,すくい、み力,ちからによってわたしをさばいてください。","tok":[["["],["1"],["]"],["神","かみ"],["よ"],["、"],["み名","みな"],["によって"],["わたし"],["を"],["救い","すくい"],["、"],["み力","みちから"],["によって"],["わたし"],["を"],["さばいて"],["ください"],["。"]]},{"verse":4,"text":"[2]神,かみよ、わたしの祈,いのりをきき、わが口,くちの言葉,ことばに耳,みみを傾,かたむけてください。","tok":[["["],["2"],["]"],["神","かみ"],["よ"],["、"],["わたし"],["の"],["祈","いのり"],["を"],["きき"],["、"],["わが"],["口","くち"],["の"],["言葉","ことば"],["に"],["耳","みみ"],["を"],["傾むけて","かたむけて"],["ください"],["。"]]},{"verse":5,"text":"[3]高,たかぶる者,ものがわたしに逆,さからって起,おこり、あらぶる者,ものがわたしのいのちを求,もとめています。彼,かれらは神,かみをおのが前,まえに置,おくことをしません。〔セラ","tok":[["["],["3"],["]"],["高か","たか"],["ぶる"],["者","もの"],["が"],["わたし"],["に"],["逆らって","さからって"],["起こり","おこり"],["、"],["あら"],["ぶる"],["者","もの"],["が"],["わたし"],["の"],["いのち"],["を"],["求めて","もとめて"],["います"],["。"],["彼","かれ"],["ら"],["は"],["神","かみ"],["を"],["おの"],["が"],["前","まえ"],["に"],["置く","おく"],["こと"],["を"],["しません"],["。"],["〔"],["セラ"]]},{"verse":6,"text":"[4]見,みよ、神,かみはわが助,たすけぬし、主,しゅはわがいのちを守,まもられるかたです。","tok":[["["],["4"],["]"],["見よ","みよ"],["、"],["神","かみ"],["は"],["わが"],["助けぬ","たすけぬ"],["し"],["、"],["主","しゅ"],["は"],["わが"],["いのち"],["を"],["守られる","まもられる"],["かた"],["です"],["。"]]},{"verse":7,"text":"[5]神,かみはわたしのあだに災,わざわいをもって報,むくいられるでしょう。あなたのまことをもって彼,かれらを滅,ほろぼしてください。","tok":[["["],["5"],["]"],["神","かみ"],["は"],["わたし"],["の"],["あだ"],["に"],["災","わざわい"],["を"],["もって"],["報いられるでしょう","むくいられるでしょう"],["。"],["あなた"],["の"],["まこと"],["を"],["もって"],["彼","かれ"],["ら"],["を"],["滅ぼして","ほろぼして"],["ください"],["。"]]},{"verse":8,"text":"[6]わたしは喜,よろこんであなたにいけにえをささげます。主,しゅよ、わたしはみ名,なに感謝,かんしゃします。これはよい事,ことだからです。","tok":[["["],["6"],["]"],["わたし"],["は"],["喜こんで","よろこんで"],["あなた"],["に"],["いけにえ"],["を"],["ささげます"],["。"],["主","しゅ"],["よ"],["、"],["わたし"],["は"],["み名","みな"],["に"],["感謝","かんしゃ"],["します"],["。"],["これ"],["は"],["よい"],["事","こと"],["だ"],["から"],["です"],["。"]]},{"verse":9,"text":"[7]あなたはすべての悩,なやみからわたしを救,すくい、わたしの目,めに敵,てきの敗北,はいぼくを見,みさせられたからです。","tok":[["["],["7"],["]"],["あなた"],["は"],["すべて"],["の"],["悩み","なやみ"],["から"],["わたし"],["を"],["救い","すくい"],["、"],["わたし"],["の"],["目","め"],["に"],["敵","てき"],["の"],["敗北","はいぼく"],["を"],["見させられた","みさせられた"],["から"],["です"],["。"]]}]
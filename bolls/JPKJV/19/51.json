[{"verse":1,"text":"[0]【聖歌,せいか隊,たいの指揮者,しきしゃによってうたわせたダビデの歌,うた、","tok":[["["],["0"],["]"],["【"],["聖歌隊","せいかたい"],["の"],["指揮者","しきしゃ"],["によって"],["うたわせた"],["ダビデ"],["の"],["歌","うた"],["、"]]},{"verse":2,"text":"[00]これはダビデがバテセバに通,とおった後,のち預言者,よげんしゃナタンがきたときによんだもの】","tok":[["["],["00"],["]"],["これ"],["は"],["ダビデ"],["が"],["バテセバ"],["に"],["通った","とおった"],["後","の"],["ち"],["預言者","よげんしゃ"],["ナタン"],["が"],["きた"],["とき"],["に"],["よんだ"],["もの"],["】"]]},{"verse":3,"text":"[1]神,かみよ、あなたのいつくしみによって、わたしをあわれみ、あなたの豊,ゆたかなあわれみによって、わたしのもろもろのとがをぬぐい去,さってください。","tok":[["["],["1"],["]"],["神","かみ"],["よ"],["、"],["あなた"],["の"],["いつくしみ"],["によって"],["、"],["わたし"],["を"],["あわれみ"],["、"],["あなた"],["の"],["豊","ゆたか"],["な"],["あわれみ"],["によって"],["、"],["わたし"],["の"],["もろもろ"],["の"],["とが"],["を"],["ぬぐい"],["去て","さって"],["ください"],["。"]]},{"verse":4,"text":"[2]わたしの不義,ふぎをことごとく洗,あらい去,さり、わたしの罪,つみからわたしを清,きよめてください。","tok":[["["],["2"],["]"],["わたし"],["の"],["不義","ふぎ"],["を"],["ことごとく"],["洗","あらい"],["去り","さり"],["、"],["わたし"],["の"],["罪","つみ"],["から"],["わたし"],["を"],["清めて","きよめて"],["ください"],["。"]]},{"verse":5,"text":"[3]わたしは自分,じぶんのとがを知,しっています。わたしの罪,つみはいつもわたしの前,まえにあります。","tok":[["["],["3"],["]"],["わたし"],["は"],["自分","じぶん"],["の"],["とが"],["を"],["知って","しって"],["います"],["。"],["わたし"],["の"],["罪","つみ"],["は"],["いつも"],["わたし"],["の"],["前","まえ"],["に"],["あります"],["。"]]},{"verse":6,"text":"[4]わたしはあなたにむかい、ただあなたに罪,つみを犯,おかし、あなたの前,まえに悪,わるい事,ことを行,おこないました。それゆえ、あなたが宣告,せんこくをお与,あたえになるときは正,ただしく、あなたが人,ひとをさばかれるときは誤,あやまりがありません。","tok":[["["],["4"],["]"],["わたし"],["は"],["あなた"],["に"],["むかい"],["、"],["ただ"],["あなた"],["に"],["罪","つみ"],["を"],["犯し","おかし"],["、"],["あなた"],["の"],["前","まえ"],["に"],["悪い","わるい"],["事","こと"],["を"],["行ないました","おこないました"],["。"],["それ"],["ゆえ"],["、"],["あなた"],["が"],["宣告","せんこく"],["を"],["お"],["与","あたえ"],["に"],["なる"],["とき"],["は"],["正く","ただしく"],["、"],["あなた"],["が"],["人","ひと"],["を"],["さばかれる"],["とき"],["は"],["誤り","あやまり"],["が"],["ありません"],["。"]]},{"verse":7,"text":"[5]見,みよ、わたしは不義,ふぎのなかに生,うまれました。わたしの母,ははは罪,つみのうちにわたしをみごもりました。","tok":[["["],["5"],["]"],["見よ","みよ"],["、"],["わたし"],["は"],["不義","ふぎ"],["の"],["なか"],["に"],["生まれました","うまれました"],["。"],["わたし"],["の"],["母","はは"],["は"],["罪","つみ"],["の"],["うち"],["に"],["わたし"],["を"],["みごもりました"],["。"]]},{"verse":8,"text":"[6]見,みよ、あなたは真実,しんじつを心,こころのうちに求,もとめられます。それゆえ、わたしの隠,かくれた心,こころに知恵,ちえを教,おしえてください。","tok":[["["],["6"],["]"],["見よ","みよ"],["、"],["あなた"],["は"],["真実","しんじつ"],["を"],["心","こころ"],["の"],["うち"],["に"],["求められます","もとめられます"],["。"],["それ"],["ゆえ"],["、"],["わたし"],["の"],["隠れた","かくれた"],["心","こころ"],["に"],["知恵","ちえ"],["を"],["教えて","おしえて"],["ください"],["。"]]},{"verse":9,"text":"[7]ヒソプをもって、わたしを清,きよめてください、わたしは清,きよくなるでしょう。わたしを洗,あらってください、わたしは雪,ゆきよりも白,しろくなるでしょう。","tok":[["["],["7"],["]"],["ヒソプ"],["を"],["もって"],["、"],["わたし"],["を"],["清めて","きよめて"],["ください"],["、"],["わたし"],["は"],["清く","きよく"],["なるでしょう"],["。"],["わたし"],["を"],["洗って","あらって"],["ください"],["、"],["わたし"],["は"],["雪","ゆき"],["より"],["も"],["白く","しろく"],["なるでしょう"],["。"]]},{"verse":10,"text":"[8]わたしに喜,よろこびと楽,たのしみとを満,みたし、あなたが砕,くだいた骨,ほねを喜,よろこばせてください。","tok":[["["],["8"],["]"],["わたし"],["に"],["喜こび","よろこび"],["と"],["楽み","たのしみ"],["と"],["を"],["満たし","みたし"],["、"],["あなた"],["が"],["砕いた","くだいた"],["骨","ほね"],["を"],["喜こばせて","よろこばせて"],["ください"],["。"]]},{"verse":11,"text":"[9]み顔,かおをわたしの罪,つみから隠,かくし、わたしの不義,ふぎをことごとくぬぐい去,さってください。","tok":[["["],["9"],["]"],["み顔","みかお"],["を"],["わたし"],["の"],["罪","つみ"],["から"],["隠し","かくし"],["、"],["わたし"],["の"],["不義","ふぎ"],["を"],["ことごとく"],["ぬぐい"],["去て","さって"],["ください"],["。"]]},{"verse":12,"text":"[10]神,かみよ、わたしのために清,きよい心,こころをつくり、わたしのうちに新,あたらしい、正,ただしい霊,れいを与,あたえてください。","tok":[["["],["10"],["]"],["神","かみ"],["よ"],["、"],["わたし"],["の"],["ため"],["に"],["清い","きよい"],["心","こころ"],["を"],["つくり"],["、"],["わたし"],["の"],["うち"],["に"],["新らしい","あたらしい"],["、"],["正い","ただしい"],["霊","れい"],["を"],["与","あたえ"],["て"],["ください"],["。"]]},{"verse":13,"text":"[11]わたしをみ前,まえから捨,すてないでください。あなたの聖,せいなる霊,れいをわたしから取,とらないでください。","tok":[["["],["11"],["]"],["わたし"],["を"],["み前","みまえ"],["から"],["捨てないで","すてないで"],["ください"],["。"],["あなた"],["の"],["聖","せい"],["なる"],["霊","れい"],["を"],["わたし"],["から"],["取らないで","とらないで"],["ください"],["。"]]},{"verse":14,"text":"[12]あなたの救,すくいの喜,よろこびをわたしに返,かえし、自由,じゆうの霊,れいをもって、わたしをささえてください。","tok":[["["],["12"],["]"],["あなた"],["の"],["救い","すくい"],["の"],["喜こび","よろこび"],["を"],["わたし"],["に"],["返","かえし"],["、"],["自由","じゆう"],["の"],["霊","れい"],["を"],["もって"],["、"],["わたし"],["を"],["ささえて"],["ください"],["。"]]},{"verse":15,"text":"[13]そうすればわたしは、とがを犯,おかした者,ものにあなたの道,みちを教,おしえ、罪,つみびとはあなたに帰,かえってくるでしょう。","tok":[["["],["13"],["]"],["そう"],["すれば"],["わたし"],["は"],["、"],["とが"],["を"],["犯した","おかした"],["者","もの"],["に"],["あなた"],["の"],["道","みち"],["を"],["教え","おしえ"],["、"],["罪びと","つみびと"],["は"],["あなた"],["に"],["帰えって","かえって"],["くるでしょう"],["。"]]},{"verse":16,"text":"[14]神,かみよ、わが救,すくいの神,かみよ、血,ちを流,ながした罪,つみからわたしを助,たすけ出,だしてください。わたしの舌,したは声,こえ高,たからかにあなたの義,ぎを歌,うたうでしょう。","tok":[["["],["14"],["]"],["神","かみ"],["よ"],["、"],["わが"],["救い","すくい"],["の"],["神","かみ"],["よ"],["、"],["血","ち"],["を"],["流した","ながした"],["罪","つみ"],["から"],["わたし"],["を"],["助け出して","たすけだして"],["ください"],["。"],["わたし"],["の"],["舌","した"],["は"],["声","こえ"],["高らか","たからか"],["に"],["あなた"],["の"],["義","ぎ"],["を"],["歌うでしょう","うたうでしょう"],["。"]]},{"verse":17,"text":"[15]主,しゅよ、わたしのくちびるを開,ひらいてください。わたしの口,くちはあなたの誉,ほまれをあらわすでしょう。","tok":[["["],["15"],["]"],["主","しゅ"],["よ"],["、"],["わたし"],["の"],["くちびる"],["を"],["開らいて","ひらいて"],["ください"],["。"],["わたし"],["の"],["口","くち"],["は"],["あなた"],["の"],["誉","ほまれ"],["を"],["あらわすでしょう"],["。"]]},{"verse":18,"text":"[16]あなたはいけにえを好,このまれません。たといわたしが燔祭,はんさいをささげてもあなたは喜,よろこばれないでしょう。","tok":[["["],["16"],["]"],["あなた"],["は"],["いけにえ"],["を"],["好まれません","このまれません"],["。"],["たとい"],["わたし"],["が"],["燔祭","はんさい"],["を"],["ささげて"],["も"],["あなた"],["は"],["喜こばれないでしょう","よろこばれないでしょう"],["。"]]},{"verse":19,"text":"[17]神,かみの受,うけられるいけにえは砕,くだけた魂,たましいです。神,かみよ、あなたは砕,くだけた悔,くいた心,こころをかろしめられません。","tok":[["["],["17"],["]"],["神","かみ"],["の"],["受けられる","うけられる"],["いけにえ"],["は"],["砕けた","くだけた"],["魂","たましい"],["です"],["。"],["神","かみ"],["よ"],["、"],["あなた"],["は"],["砕けた","くだけた"],["悔いた","くいた"],["心","こころ"],["を"],["かろしめられません"],["。"]]},{"verse":20,"text":"[18]あなたのみこころにしたがってシオンに恵,めぐみを施,ほどこし、エルサレムの城壁,じょうへきを築,きずきなおしてください。","tok":[["["],["18"],["]"],["あなた"],["のみ"],["こころ"],["に"],["したがって"],["シオン"],["に"],["恵","めぐみ"],["を"],["施し","ほどこし"],["、"],["エルサレム"],["の"],["城壁","じょうへき"],["を"],["築き","きずき"],["なおして"],["ください"],["。"]]},{"verse":21,"text":"[19]その時,ときあなたは義,ぎのいけにえと燔祭,はんさいと、全,まったき燔祭,はんさいとを喜,よろこばれるでしょう。その時,ときあなたの祭壇,さいだんに雄牛,おうしがささげられるでしょう。","tok":[["["],["19"],["]"],["その"],["時","とき"],["あなた"],["は"],["義","ぎ"],["の"],["いけにえ"],["と"],["燔祭","はんさい"],["と"],["、"],["全","ま"],["っ"],["たき"],["燔祭","はんさい"],["と"],["を"],["喜こばれるでしょう","よろこばれるでしょう"],["。"],["その"],["時","とき"],["あなた"],["の"],["祭壇","さいだん"],["に"],["雄牛","おうし"],["が"],["ささげられるでしょう"],["。"]]}]
[{"verse":1,"text":"[0]【宮,みやをささげるときにうたったダビデの歌,うた】","tok":[["["],["0"],["]"],["【"],["宮","みや"],["を"],["ささげる"],["とき"],["に"],["うたった"],["ダビデ"],["の"],["歌","うた"],["】"]]},{"verse":2,"text":"[1]主,しゅよ、わたしはあなたをあがめます。あなたはわたしを引,ひきあげ、敵,てきがわたしの事,ことによって喜,よろこぶのを、ゆるされなかったからです。","tok":[["["],["1"],["]"],["主","しゅ"],["よ"],["、"],["わたし"],["は"],["あなた"],["を"],["あがめます"],["。"],["あなた"],["は"],["わたし"],["を"],["引","ひき"],["あげ"],["、"],["敵","てき"],["が"],["わたし"],["の"],["事","こと"],["によって"],["喜こぶ","よろこぶ"],["の"],["を"],["、"],["ゆるされなかった"],["から"],["です"],["。"]]},{"verse":3,"text":"[2]わが神,かみ、主,しゅよ、わたしがあなたにむかって助,たすけを叫,さけび求,もとめると、あなたはわたしをいやしてくださいました。","tok":[["["],["2"],["]"],["わが"],["神","かみ"],["、"],["主","しゅ"],["よ"],["、"],["わたし"],["が"],["あなた"],["に"],["むかって"],["助け","たすけ"],["を"],["叫","さけび"],["求める","もとめる"],["と"],["、"],["あなた"],["は"],["わたし"],["を"],["いやして"],["くださいました"],["。"]]},{"verse":4,"text":"[3]主,しゅよ、あなたはわたしの魂,たましいを陰府,よみからひきあげ、墓,はかに下,くだる者,もののうちから、わたしを生,いき返,かえらせてくださいました。","tok":[["["],["3"],["]"],["主","しゅ"],["よ"],["、"],["あなた"],["は"],["わたし"],["の"],["魂","たましい"],["を"],["陰府","よみ"],["から"],["ひきあげ"],["、"],["墓","はか"],["に"],["下る","くだる"],["者","もの"],["の"],["うち"],["から"],["、"],["わたし"],["を"],["生き返らせて","いきかえらせて"],["くださいました"],["。"]]},{"verse":5,"text":"[4]主,しゅの聖徒,せいとよ、主,しゅをほめうたい、その聖,せいなるみ名,なに感謝,かんしゃせよ。","tok":[["["],["4"],["]"],["主","しゅ"],["の"],["聖徒","せいと"],["よ"],["、"],["主","しゅ"],["を"],["ほめ"],["うたい"],["、"],["その"],["聖","せい"],["なる"],["み名","みな"],["に"],["感謝","かんしゃ"],["せよ"],["。"]]},{"verse":6,"text":"[5]その怒,いかりはただつかのまで、その恵,めぐみはいのちのかぎり長,ながいからである。夜,よるはよもすがら泣,なきかなしんでも、朝,あさと共,ともに喜,よろこびが来,くる。","tok":[["["],["5"],["]"],["その"],["怒り","いかり"],["は"],["ただ"],["つかのま"],["で"],["、"],["その"],["恵","めぐみ"],["は"],["いのち"],["の"],["かぎり"],["長い","ながい"],["から"],["で"],["ある"],["。"],["夜","よる"],["は"],["よもすがら"],["泣かなし","なきかなし"],["ん"],["で"],["も"],["、"],["朝","あさ"],["と"],["共","とも"],["に"],["喜こび","よろこび"],["が"],["来る","くる"],["。"]]},{"verse":7,"text":"[6]わたしは安,やすらかな時,ときに言,いった、「わたしは決,けっして動,うごかされることはない」と。","tok":[["["],["6"],["]"],["わたし"],["は"],["安らか","やすらか"],["な"],["時","とき"],["に"],["言った","いった"],["、"],["「"],["わたし"],["は"],["決っして","けっして"],["動かされる","うごかされる"],["こと"],["は"],["ない"],["」"],["と"],["。"]]},{"verse":8,"text":"[7]主,しゅよ、あなた恵,めぐみをもって、わたしをゆるがない山,やまのように堅,かたくされました。あなたがみ顔,かおをかくされたので、わたしはおじ惑,まどいました。","tok":[["["],["7"],["]"],["主","しゅ"],["よ"],["、"],["あなた"],["恵","めぐみ"],["を"],["もって"],["、"],["わたし"],["を"],["ゆるがない"],["山","やま"],["の"],["よう"],["に"],["堅く","かたく"],["されました"],["。"],["あなた"],["が"],["み顔","みかお"],["を"],["かくされた"],["ので"],["、"],["わたし"],["は"],["おじ"],["惑いました","まどいました"],["。"]]},{"verse":9,"text":"[8]主,しゅよ、わたしはあなたに呼,よばわりました。ひたすら主,しゅに請,こい願,ねがいました、","tok":[["["],["8"],["]"],["主","しゅ"],["よ"],["、"],["わたし"],["は"],["あなた"],["に"],["呼ばわりました","よばわりました"],["。"],["ひたすら"],["主に","しゅに"],["請い願いました","こいねがいました"],["、"]]},{"verse":10,"text":"[9]「わたしが墓,はかに下,くだるならば、わたしの死,しになんの益,えきがあるでしょうか。ちりはあなたをほめたたえるでしょうか。あなたのまことをのべ伝,つたえるでしょうか。","tok":[["["],["9"],["]"],["「"],["わたし"],["が"],["墓","はか"],["に"],["下るならば","くだるならば"],["、"],["わたし"],["の"],["死","し"],["に"],["なん"],["の"],["益","えき"],["が"],["あるでしょう"],["か"],["。"],["ちり"],["は"],["あなた"],["を"],["ほめたたえるでしょう"],["か"],["。"],["あなた"],["の"],["まこと"],["を"],["のべ伝えるでしょう","のべつたえるでしょう"],["か"],["。"]]},{"verse":11,"text":"[10]主,しゅよ、聞,きいてください、わたしをあわれんでください。主,しゅよ、わたしの助,たすけとなってください」と。","tok":[["["],["10"],["]"],["主","しゅ"],["よ"],["、"],["聞いて","きいて"],["ください"],["、"],["わたし"],["を"],["あわれんで"],["ください"],["。"],["主","しゅ"],["よ"],["、"],["わたし"],["の"],["助け","たすけ"],["と"],["なって"],["ください"],["」"],["と"],["。"]]},{"verse":12,"text":"[11]あなたはわたしのために、嘆,なげきを踊,おどりにかえ、荒布,あらぬのを解,とき、喜,よろこびをわたしの帯,おびとされました。","tok":[["["],["11"],["]"],["あなた"],["は"],["わたし"],["の"],["ため"],["に"],["、"],["嘆き","なげき"],["を"],["踊","おどり"],["に"],["かえ"],["、"],["荒布","あらぬ"],["の"],["を"],["解き","とき"],["、"],["喜こび","よろこび"],["を"],["わたし"],["の"],["帯","おび"],["と"],["されました"],["。"]]},{"verse":13,"text":"[12]これはわたしの魂,たましいがあなたをほめたたえて、口,くちをつぐむことのないためです。わが神,かみ、主,しゅよ、わたしはとこしえにあなたに感謝,かんしゃします。","tok":[["["],["12"],["]"],["これ"],["は"],["わたし"],["の"],["魂","たましい"],["が"],["あなた"],["を"],["ほめたたえて"],["、"],["口","くち"],["を"],["つぐむ"],["こと"],["の"],["ない"],["ため"],["です"],["。"],["わが"],["神","かみ"],["、"],["主","しゅ"],["よ"],["、"],["わたし"],["は"],["とこしえ"],["に"],["あなた"],["に"],["感謝","かんしゃ"],["します"],["。"]]}]
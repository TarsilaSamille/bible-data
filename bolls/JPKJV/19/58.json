[{"verse":1,"text":"[0]【聖歌,せいか隊,たいの指揮者,しきしゃによって、「滅,ほろぼすな」というしらべにあわせてうたわせたダビデのミクタムの歌,うた】","tok":[["["],["0"],["]"],["【"],["聖歌隊","せいかたい"],["の"],["指揮者","しきしゃ"],["によって"],["、"],["「"],["滅ぼす","ほろぼす"],["な"],["」"],["と"],["いう"],["しらべ"],["に"],["あわせて"],["うたわせた"],["ダビデ"],["の"],["ミクタム"],["の"],["歌","うた"],["】"]]},{"verse":2,"text":"[1]あなたがた力,ちからある者,ものよ、まことにあなたがたは正,ただしい事,ことを語,かたり、公平,こうへいをもって人,ひとの子,こらをさばくのか。","tok":[["["],["1"],["]"],["あなた"],["がた"],["力","ちから"],["ある"],["者","もの"],["よ"],["、"],["まこと"],["に"],["あなた"],["がた"],["は"],["正い","ただしい"],["事","こと"],["を"],["語り","かたり"],["、"],["公平","こうへい"],["を"],["もって"],["人","ひと"],["の"],["子","こ"],["ら"],["を"],["さばく"],["の"],["か"],["。"]]},{"verse":3,"text":"[2]否,いな、あなたがたは心,こころのうちに悪,わるい事,ことをたくらみ、その手,ては地,ちに暴虐,ぼうぎゃくを行,おこなう。","tok":[["["],["2"],["]"],["否","いな"],["、"],["あなた"],["がた"],["は"],["心","こころ"],["の"],["うち"],["に"],["悪い","わるい"],["事","こと"],["を"],["たくらみ"],["、"],["その"],["手","て"],["は"],["地","ち"],["に"],["暴虐","ぼうぎゃく"],["を"],["行なう","おこなう"],["。"]]},{"verse":4,"text":"[3]悪,あしき者,ものは胎,たいを出,でた時,ときから、そむき去,さり、生,うまれ出,でた時,ときから、あやまちを犯,おかし、偽,いつわりを語,かたる。","tok":[["["],["3"],["]"],["悪しき","あしき"],["者","もの"],["は"],["胎","たい"],["を"],["出た","でた"],["時","とき"],["から"],["、"],["そむき"],["去り","さり"],["、"],["生まれ出た","うまれでた"],["時","とき"],["から"],["、"],["あやまち"],["を"],["犯し","おかし"],["、"],["偽り","いつわり"],["を"],["語る","かたる"],["。"]]},{"verse":5,"text":"[4-5]彼,かれらはへびの毒,どくのような毒,どくをもち、魔法使,まほうつかいまたは巧,たくみに呪文,じゅもんを唱,となえる者,ものの声,こえを聞,きかない耳,みみをふさぐ耳,みみしいのまむしのようである。","tok":[["["],["4"],["-"],["5"],["]"],["彼","かれ"],["ら"],["は"],["へび"],["の"],["毒","どく"],["の"],["よう"],["な"],["毒","どく"],["を"],["もち"],["、"],["魔法","まほう"],["使い","つかい"],["また"],["は"],["巧","たくみ"],["に"],["呪文","じゅもん"],["を"],["唱える","となえる"],["者","もの"],["の"],["声","こえ"],["を"],["聞かない","きかない"],["耳","みみ"],["を"],["ふさぐ"],["耳","みみ"],["しい"],["の"],["まむし"],["の"],["よう"],["で"],["ある"],["。"]]},{"verse":6,"text":"*[4-5]彼,かれらはへびの毒,どくのような毒,どくをもち、魔法使,まほうつかいまたは巧,たくみに呪文,じゅもんを唱,となえる者,ものの声,こえを聞,きかない耳,みみをふさぐ耳,みみしいのまむしのようである。","tok":[["*"],["["],["4"],["-"],["5"],["]"],["彼","かれ"],["ら"],["は"],["へび"],["の"],["毒","どく"],["の"],["よう"],["な"],["毒","どく"],["を"],["もち"],["、"],["魔法","まほう"],["使い","つかい"],["また"],["は"],["巧","たくみ"],["に"],["呪文","じゅもん"],["を"],["唱える","となえる"],["者","もの"],["の"],["声","こえ"],["を"],["聞かない","きかない"],["耳","みみ"],["を"],["ふさぐ"],["耳","みみ"],["しい"],["の"],["まむし"],["の"],["よう"],["で"],["ある"],["。"]]},{"verse":7,"text":"[6]神,かみよ、彼,かれらの口,くちの歯,はを折,おってください。主,しゅよ、若,わかいししのきばを抜,ぬき砕,くだいてください。","tok":[["["],["6"],["]"],["神","かみ"],["よ"],["、"],["彼","かれ"],["ら"],["の"],["口","くち"],["の"],["歯","は"],["を"],["折って","おって"],["ください"],["。"],["主","しゅ"],["よ"],["、"],["若い","わかい"],["しし"],["の"],["きば"],["を"],["抜き","ぬき"],["砕いて","くだいて"],["ください"],["。"]]},{"verse":8,"text":"[7]彼,かれらを流,ながれゆく水,みずのように消,きえ去,さらせ、踏,ふみ倒,たおされる若草,わかくさのように衰,おとろえさせてください。","tok":[["["],["7"],["]"],["彼","かれ"],["ら"],["を"],["流れ","ながれ"],["ゆく"],["水","みず"],["の"],["よう"],["に"],["消え去らせ","きえさらせ"],["、"],["踏み倒される","ふみたおされる"],["若草","わかくさ"],["の"],["よう"],["に"],["衰えさせて","おとろえさせて"],["ください"],["。"]]},{"verse":9,"text":"[8]また溶,とけてどろどろになるかたつむりのように、時,ときならず生,うまれた日,ひを見,みぬ子,このようにしてください。","tok":[["["],["8"],["]"],["また"],["溶けて","とけて"],["どろどろ"],["に"],["なる"],["かたつむり"],["の"],["よう"],["に"],["、"],["時","とき"],["ならず"],["生まれた","うまれた"],["日","ひ"],["を"],["見ぬ","みぬ"],["子","こ"],["の"],["よう"],["に"],["して"],["ください"],["。"]]},{"verse":10,"text":"[9]あなたがたの釜,かまがまだいばらの熱,ねつを感,かんじない前,まえに青,あおいのも、燃,もえているのも共,ともにつむじ風,かぜに吹,ふき払,はらわれるように彼,かれらを吹,ふき払,はらってください。","tok":[["["],["9"],["]"],["あなた"],["がた"],["の"],["釜","かま"],["が"],["まだ"],["いばら"],["の"],["熱","ねつ"],["を"],["感じない","かんじない"],["前","まえ"],["に"],["青い","あおい"],["の"],["も"],["、"],["燃えて","もえて"],["いる"],["の"],["も"],["共","とも"],["に"],["つむじ風","つむじかぜ"],["に"],["吹払われる","ふきはらわれる"],["よう"],["に"],["彼","かれ"],["ら"],["を"],["吹払って","ふきはらって"],["ください"],["。"]]},{"verse":11,"text":"[10]正,ただしい者,ものは復讐,ふくしゅうを見,みて喜,よろこび、その足,あしを悪,あしき者,ものの血,ちで洗,あらうであろう。","tok":[["["],["10"],["]"],["正い","ただしい"],["者","もの"],["は"],["復讐","ふくしゅう"],["を"],["見て","みて"],["喜こび","よろこび"],["、"],["その"],["足","あし"],["を"],["悪しき","あしき"],["者","もの"],["の"],["血","ち"],["で"],["洗うで","あらうで"],["あろう"],["。"]]},{"verse":12,"text":"[11]そして人々,ひとびとは言,いうであろう、「まことに正,ただしい者,ものには報,むくいがある。まことに地,ちにさばきを行,おこなわれる神,かみがある」と。","tok":[["["],["11"],["]"],["そして"],["人々","ひとびと"],["は"],["言うで","いうで"],["あろう"],["、"],["「"],["まこと"],["に"],["正い","ただしい"],["者","もの"],["に"],["は"],["報い","むくい"],["が"],["ある"],["。"],["まこと"],["に"],["地","ち"],["に"],["さばき"],["を"],["行なわれる","おこなわれる"],["神","かみ"],["が"],["ある"],["」"],["と"],["。"]]}]
[{"verse":1,"text":"[0]【ダビデがほら穴,あなにいた時,ときによんだマスキールの歌,うた、祈,いのり】","tok":[["["],["0"],["]"],["【"],["ダビデ"],["が"],["ほら穴","ほらあな"],["に"],["いた"],["時","とき"],["に"],["よんだ"],["マスキール"],["の"],["歌","うた"],["、"],["祈","いのり"],["】"]]},{"verse":2,"text":"[1]わたしは声,こえを出,だして主,しゅに呼,よばわり、声,こえを出,だして主,しゅに願,ねがい求,もとめます。","tok":[["["],["1"],["]"],["わたし"],["は"],["声","こえ"],["を"],["出して","だして"],["主に","しゅに"],["呼ばわり","よばわり"],["、"],["声","こえ"],["を"],["出して","だして"],["主に","しゅに"],["願い求めます","ねがいもとめます"],["。"]]},{"verse":3,"text":"[2]わたしはみ前,まえにわが嘆,なげきを注,そそぎ出,だし、み前,まえにわが悩,なやみをあらわします。","tok":[["["],["2"],["]"],["わたし"],["は"],["み前","みまえ"],["に"],["わが"],["嘆き","なげき"],["を"],["注ぎ","そそぎ"],["出し","だし"],["、"],["み前","みまえ"],["に"],["わが"],["悩み","なやみ"],["を"],["あらわします"],["。"]]},{"verse":4,"text":"[3]わが霊,れいのわがうちに消,きえうせようとする時,ときも、あなたはわが道,みちを知,しられます。彼,かれらはわたしを捕,とらえようとわたしの行,いく道,みちにわなを隠,かくしました。","tok":[["["],["3"],["]"],["わが"],["霊","れい"],["の"],["わが"],["うち"],["に"],["消えうせよう","きえうせよう"],["と"],["する"],["時","とき"],["も"],["、"],["あなた"],["は"],["わが"],["道","みち"],["を"],["知られます","しられます"],["。"],["彼","かれ"],["ら"],["は"],["わたし"],["を"],["捕らえよう","とらえよう"],["と"],["わたし"],["の"],["行く","いく"],["道","みち"],["に"],["わな"],["を"],["隠しました","かくしました"],["。"]]},{"verse":5,"text":"[4]わたしは右,みぎの方,ほうに目,めを注,そそいで見回,みまわしたが、わたしに心,こころをとめる者,ものはひとりもありません。わたしには避,さけ所,どころがなく、わたしをかえりみる人,ひとはありません。","tok":[["["],["4"],["]"],["わたし"],["は"],["右","みぎ"],["の"],["方","ほう"],["に"],["目","め"],["を"],["注いで","そそいで"],["見回わした","みまわした"],["が"],["、"],["わたし"],["に"],["心","こころ"],["を"],["とめる"],["者","もの"],["は"],["ひとり"],["も"],["ありません"],["。"],["わたし"],["に"],["は"],["避け","さけ"],["所","どころ"],["が"],["なく"],["、"],["わたし"],["を"],["かえりみる"],["人","ひと"],["は"],["ありません"],["。"]]},{"verse":6,"text":"[5]主,しゅよ、わたしはあなたに呼,よばわります。わたしは言,いいます、「あなたはわが避,さけ所,どころ、生,いける者,ものの地,ちでわたしの受,うくべき分,ぶんです。","tok":[["["],["5"],["]"],["主","しゅ"],["よ"],["、"],["わたし"],["は"],["あなた"],["に"],["呼ばわります","よばわります"],["。"],["わたし"],["は"],["言います","いいます"],["、"],["「"],["あなた"],["は"],["わが"],["避け","さけ"],["所","ど"],["ころ"],["、"],["生ける","いける"],["者","もの"],["の"],["地","ち"],["で"],["わたし"],["の"],["受","う"],["くべき"],["分","ぶん"],["です"],["。"]]},{"verse":7,"text":"[6]どうか、わが叫,さけびにみこころをとめてください。わたしは、はなはだしく低,ひくくされています。わたしを責,せめる者,ものから助,たすけ出,だしてください。彼,かれらはわたしにまさって強,つよいのです。","tok":[["["],["6"],["]"],["どう"],["か"],["、"],["わが"],["叫","さけび"],["に"],["みこころ"],["を"],["とめて"],["ください"],["。"],["わたし"],["は"],["、"],["はなはだしく"],["低く","ひくく"],["されて"],["います"],["。"],["わたし"],["を"],["責","せめ"],["る"],["者","もの"],["から"],["助け出して","たすけだして"],["ください"],["。"],["彼","かれ"],["ら"],["は"],["わたし"],["に"],["まさって"],["強い","つよい"],["の"],["です"],["。"]]},{"verse":8,"text":"[7]わたしをひとやから出,だし、み名,なに感謝,かんしゃさせてください。あなたが豊,ゆたかにわたしをあしらわれるので、正,ただしい人々,ひとびとはわたしのまわりに集,あつまるでしょう」。","tok":[["["],["7"],["]"],["わたし"],["を"],["ひと"],["や"],["から"],["出し","だし"],["、"],["み名","みな"],["に"],["感謝","かんしゃ"],["させて"],["ください"],["。"],["あなた"],["が"],["豊","ゆたか"],["に"],["わたし"],["を"],["あしらわれる"],["ので"],["、"],["正い","ただしい"],["人々","ひとびと"],["は"],["わたし"],["の"],["まわり"],["に"],["集まるでしょう","あつまるでしょう"],["」"],["。"]]}]
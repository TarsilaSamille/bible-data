[{"verse":1,"text":"【ダビデの歌,うた】主,しゅよ、わたしをさばいてください。わたしは誠実,せいじつに歩,あゆみ、迷,まようことなく主,しゅに信頼,しんらいしています。","tok":[["【"],["ダビデ"],["の"],["歌","うた"],["】"],["主","しゅ"],["よ"],["、"],["わたし"],["を"],["さばいて"],["ください"],["。"],["わたし"],["は"],["誠実","せいじつ"],["に"],["歩","あゆみ"],["、"],["迷う","まよう"],["こと"],["なく"],["主に","しゅに"],["信頼","しんらい"],["して"],["います"],["。"]]},{"verse":2,"text":"主,しゅよ、わたしをためし、わたしを試,こころみ、わたしの心,こころと思,おもいとを練,ねりきよめてください。","tok":[["主","しゅ"],["よ"],["、"],["わたし"],["を"],["ためし"],["、"],["わたし"],["を"],["試み","こころみ"],["、"],["わたし"],["の"],["心","こころ"],["と"],["思い","おもい"],["と"],["を"],["練り","ねり"],["きよめて"],["ください"],["。"]]},{"verse":3,"text":"あなたのいつくしみはわたしの目,めの前,まえにあり、わたしはあなたのまことによって歩,あゆみました。","tok":[["あなた"],["の"],["いつくしみ"],["は"],["わたし"],["の"],["目","め"],["の"],["前","まえ"],["に"],["あり"],["、"],["わたし"],["は"],["あなた"],["の"],["まこと"],["によって"],["歩みました","あゆみました"],["。"]]},{"verse":4,"text":"わたしは偽,いつわる人々,ひとびとと共,ともにすわらず、偽善者,ぎぜんしゃと交,まじわらず、","tok":[["わたし"],["は"],["偽わる","いつわる"],["人々","ひとびと"],["と"],["共","とも"],["に"],["すわらず"],["、"],["偽善者","ぎぜんしゃ"],["と"],["交じわらず","まじわらず"],["、"]]},{"verse":5,"text":"悪,あくを行,おこなう者,もののつどいを憎,にくみ、悪,あしき者,ものと共,ともにすわることをしません。","tok":[["悪","あく"],["を"],["行なう","おこなう"],["者","もの"],["の"],["つどい"],["を"],["憎み","にくみ"],["、"],["悪しき","あしき"],["者","もの"],["と"],["共","とも"],["に"],["すわる"],["こと"],["を"],["しません"],["。"]]},{"verse":6,"text":"主,しゅよ、わたしは手,てを洗,あらって、罪,つみのないことを示,しめし、あなたの祭壇,さいだんをめぐって、","tok":[["主","しゅ"],["よ"],["、"],["わたし"],["は"],["手","て"],["を"],["洗って","あらって"],["、"],["罪","つみ"],["の"],["ない"],["こと"],["を"],["示めし","しめし"],["、"],["あなた"],["の"],["祭壇","さいだん"],["を"],["めぐって"],["、"]]},{"verse":7,"text":"感謝,かんしゃの歌,うたを声,こえ高,たかくうたい、あなたのくすしきみわざをことごとくのべ伝,つたえます。","tok":[["感謝","かんしゃ"],["の"],["歌","うた"],["を"],["声","こえ"],["高かく","たかく"],["うたい"],["、"],["あなた"],["の"],["くす"],["しきみ"],["わざ"],["を"],["ことごとく"],["のべ伝えます","のべつたえます"],["。"]]},{"verse":8,"text":"主,しゅよ、わたしはあなたの住,すまわれる家,いえと、あなたの栄光,えいこうのとどまる所,ところとを愛,あいします。","tok":[["主","しゅ"],["よ"],["、"],["わたし"],["は"],["あなた"],["の"],["住まわれる","すまわれる"],["家","いえ"],["と"],["、"],["あなた"],["の"],["栄光","えいこう"],["の"],["とどまる"],["所","ところ"],["と"],["を"],["愛します","あいします"],["。"]]},{"verse":9,"text":"どうか、わたしを罪,つみびとと共,ともに、わたしのいのちを、血,ちを流,ながす人々,ひとびとと共,ともに、取,とり去,さらないでください。","tok":[["どう"],["か"],["、"],["わたし"],["を"],["罪びと","つみびと"],["と"],["共","とも"],["に"],["、"],["わたし"],["の"],["いのち"],["を"],["、"],["血","ち"],["を"],["流す","ながす"],["人々","ひとびと"],["と"],["共","とも"],["に"],["、"],["取去らないで","とりさらないで"],["ください"],["。"]]},{"verse":10,"text":"彼,かれらの手,てには悪,わるい企,くわだてがあり、彼,かれらの右,みぎの手,ては、まいないで満,みちています。","tok":[["彼","かれ"],["ら"],["の"],["手","て"],["に"],["は"],["悪い","わるい"],["企て","くわだて"],["が"],["あり"],["、"],["彼","かれ"],["ら"],["の"],["右","みぎ"],["の"],["手","て"],["は"],["、"],["まいない"],["で"],["満ちて","みちて"],["います"],["。"]]},{"verse":11,"text":"しかしわたしは誠実,せいじつに歩,あゆみます。わたしをあがない、わたしをあわれんでください。","tok":[["しかし"],["わたし"],["は"],["誠実","せいじつ"],["に"],["歩みます","あゆみます"],["。"],["わたし"],["を"],["あがない"],["、"],["わたし"],["を"],["あわれんで"],["ください"],["。"]]},{"verse":12,"text":"わたしの足,あしは平,たいらかな所,ところに立,たっています。わたしは会衆,かいしゅうのなかで主,しゅをたたえましょう。","tok":[["わたし"],["の"],["足","あし"],["は"],["平か","たいらか"],["な"],["所","ところ"],["に"],["立って","たって"],["います"],["。"],["わたし"],["は"],["会衆","かいしゅう"],["の"],["なか"],["で"],["主","しゅ"],["を"],["たたえましょう"],["。"]]}]
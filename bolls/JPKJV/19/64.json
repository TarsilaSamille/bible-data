[{"verse":1,"text":"[0]【聖歌,せいか隊,たいの指揮者,しきしゃによってうたわせたダビデの歌,うた】","tok":[["["],["0"],["]"],["【"],["聖歌隊","せいかたい"],["の"],["指揮者","しきしゃ"],["によって"],["うたわせた"],["ダビデ"],["の"],["歌","うた"],["】"]]},{"verse":2,"text":"[1]神,かみよ、わたしが嘆,なげき訴,うったえるとき、わたしの声,こえをお聞,ききください。敵,てきの恐,おそれからわたしの命,いのちをお守,まもりください。","tok":[["["],["1"],["]"],["神","かみ"],["よ"],["、"],["わたし"],["が"],["嘆き","なげき"],["訴る","うったえる"],["とき"],["、"],["わたし"],["の"],["声","こえ"],["を"],["お聞く","おききく"],["ださい"],["。"],["敵","てき"],["の"],["恐","おそれ"],["から"],["わたし"],["の"],["命","いのち"],["を"],["お守り","おまもり"],["ください"],["。"]]},{"verse":3,"text":"[2]わたしを隠,かくして、悪,あくを行,おこなう者,もののひそかなはかりごとから免,まぬかれさせ、不義,ふぎを行,おこなう者,もののはかりごとから免,まぬかれさせてください。","tok":[["["],["2"],["]"],["わたし"],["を"],["隠して","かくして"],["、"],["悪","あく"],["を"],["行なう","おこなう"],["者","もの"],["の"],["ひそか"],["な"],["はかりごと"],["から"],["免かれさせ","まぬかれさせ"],["、"],["不義","ふぎ"],["を"],["行なう","おこなう"],["者","もの"],["の"],["はかりごと"],["から"],["免かれさせて","まぬかれさせて"],["ください"],["。"]]},{"verse":4,"text":"[3]彼,かれらはその舌,したをつるぎのようにとぎ、苦,にがい言葉,ことばを矢,やのように放,はなち、","tok":[["["],["3"],["]"],["彼","かれ"],["ら"],["は"],["その"],["舌","した"],["を"],["つるぎ"],["の"],["よう"],["に"],["とぎ"],["、"],["苦い","にがい"],["言葉","ことば"],["を"],["矢","や"],["の"],["よう"],["に"],["放ち","はなち"],["、"]]},{"verse":5,"text":"[4]隠,かくれた所,ところから罪,つみなき者,ものを射,いようとする。にわかに彼,かれを射,いて恐,おそれることがない。","tok":[["["],["4"],["]"],["隠れた","かくれた"],["所","ところ"],["から"],["罪","つみ"],["なき"],["者","もの"],["を"],["射よう","いよう"],["と"],["する"],["。"],["にわか"],["に"],["彼","かれ"],["を"],["射て","いて"],["恐れる","おそれる"],["こと"],["が"],["ない"],["。"]]},{"verse":6,"text":"[5]彼,かれらは悪,わるい企,くわだてを固,かたくたもち、共,ともにはかり、ひそかにわなをかけて言,いう、「だれがわれらを見破,みやぶることができるか。","tok":[["["],["5"],["]"],["彼","かれ"],["ら"],["は"],["悪い","わるい"],["企て","くわだて"],["を"],["固く","かたく"],["たもち"],["、"],["共","とも"],["に"],["はかり"],["、"],["ひそか"],["に"],["わな"],["を"],["かけて"],["言う","いう"],["、"],["「"],["だれ"],["が"],["われ"],["ら"],["を"],["見破る","みやぶる"],["こと"],["が"],["できる"],["か"],["。"]]},{"verse":7,"text":"[6]だれがわれらの罪,つみをたずね出,だすことができるか。われらは巧,たくみに、はかりごとを考,かんがえめぐらしたのだ」と。人,ひとの内,うちなる思,おもいと心,こころとは深,ふかい。","tok":[["["],["6"],["]"],["だれ"],["が"],["われ"],["ら"],["の"],["罪","つみ"],["を"],["たずね"],["出す","だす"],["こと"],["が"],["できる"],["か"],["。"],["われ"],["ら"],["は"],["巧","たくみ"],["に"],["、"],["はかりごと"],["を"],["考","かんがえ"],["めぐらした"],["の"],["だ"],["」"],["と"],["。"],["人","ひと"],["の"],["内","うち"],["なる"],["思い","おもい"],["と"],["心","こころ"],["と"],["は"],["深","ふ"],["か"],["い"],["。"]]},{"verse":8,"text":"[7]しかし神,かみは矢,やをもって彼,かれらを射,いられる。彼,かれらはにわかに傷,きずをうけるであろう。","tok":[["["],["7"],["]"],["しかし"],["神","かみ"],["は"],["矢","や"],["を"],["もって"],["彼","かれ"],["ら"],["を"],["射られる","いられる"],["。"],["彼","かれ"],["ら"],["は"],["にわか"],["に"],["傷","きず"],["を"],["うけるで"],["あろう"],["。"]]},{"verse":9,"text":"[8]神,かみは彼,かれらの舌,したのゆえに彼,かれらを滅,ほろぼされる。彼,かれらを見,みる者,ものは皆,みなそのこうべを振,ふるであろう。","tok":[["["],["8"],["]"],["神","かみ"],["は"],["彼","かれ"],["ら"],["の"],["舌","した"],["の"],["ゆえ"],["に"],["彼","かれ"],["ら"],["を"],["滅ぼされる","ほろぼされる"],["。"],["彼","かれ"],["ら"],["を"],["見る","みる"],["者","もの"],["は"],["皆","みな"],["その"],["こうべ"],["を"],["振るで","ふるで"],["あろう"],["。"]]},{"verse":10,"text":"[9]その時,ときすべての人,ひとは恐,おそれ、神,かみのみわざを宣,のべ伝,つたえ、そのなされた事,ことを考,かんがえるであろう。","tok":[["["],["9"],["]"],["その"],["時","とき"],["すべて"],["の"],["人","ひと"],["は"],["恐","おそれ"],["、"],["神","かみ"],["のみ"],["わざ"],["を"],["宣べ伝え","のべつたえ"],["、"],["その"],["なされた"],["事","こと"],["を"],["考","かんがえ"],["るで"],["あろう"],["。"]]},{"verse":11,"text":"[10]正,ただしい人,ひとは主,しゅにあって喜,よろこび、かつ主,しゅに寄,より頼,たのむ。すべて心,こころの直,なおき者,ものは誇,ほこることができる。","tok":[["["],["10"],["]"],["正い","ただしい"],["人","ひと"],["は"],["主に","しゅに"],["あって"],["喜こび","よろこび"],["、"],["かつ"],["主","しゅ"],["に"],["寄り","より"],["頼む","たのむ"],["。"],["すべて"],["心","こころ"],["の"],["直","な"],["おき"],["者","もの"],["は"],["誇る","ほこる"],["こと"],["が"],["できる"],["。"]]}]
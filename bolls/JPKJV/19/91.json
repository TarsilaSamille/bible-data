[{"verse":1,"text":"いと高,たかき者,もののもとにある隠,かくれ場,ばに住,すむ人,ひと、全能者,ぜんのうしゃの陰,かげにやどる人,ひとは","tok":[["いと"],["高き","たかき"],["者","もの"],["の"],["もと"],["に"],["ある"],["隠れ場","かくれば"],["に"],["住む","すむ"],["人","ひと"],["、"],["全能者","ぜんのうしゃ"],["の"],["陰","かげ"],["に"],["やどる"],["人","ひと"],["は"]]},{"verse":2,"text":"主,しゅに言,いうであろう、「わが避,さけ所,どころ、わが城,しろ、わが信頼,しんらいしまつるわが神,かみ」と。","tok":[["主に","しゅに"],["言うで","いうで"],["あろう"],["、"],["「"],["わが"],["避け","さけ"],["所","ど"],["ころ"],["、"],["わが"],["城","しろ"],["、"],["わが"],["信頼","しんらい"],["し"],["まつる"],["わが"],["神","かみ"],["」"],["と"],["。"]]},{"verse":3,"text":"主,しゅはあなたをかりゅうどのわなと、恐,おそろしい疫病,えきびょうから助,たすけ出,だされるからである。","tok":[["主","しゅ"],["は"],["あなた"],["を"],["かりゅうど"],["の"],["わな"],["と"],["、"],["恐ろしい","おそろしい"],["疫病","えきびょうか"],["ら"],["助け出される","たすけだされる"],["から"],["で"],["ある"],["。"]]},{"verse":4,"text":"主,しゅはその羽,はねをもって、あなたをおおわれる。あなたはその翼,つばさの下,したに避,さけ所,どころを得,えるであろう。そのまことは大盾,おおだて、また小盾,こだてである。","tok":[["主","しゅ"],["は"],["その"],["羽","はね"],["を"],["もって"],["、"],["あなた"],["を"],["おおわれる"],["。"],["あなた"],["は"],["その"],["翼","つばさ"],["の"],["下","した"],["に"],["避け","さけ"],["所","どころ"],["を"],["得るで","えるで"],["あろう"],["。"],["その"],["まこと"],["は"],["大","だい"],["盾","たて"],["おだて"],["、"],["また"],["小","こ"],["盾","たて"],["だて"],["で"],["ある"],["。"]]},{"verse":5,"text":"あなたは夜,よるの恐,おそろしい物,ものをも、昼,ひるに飛,とんでくる矢,やをも恐,おそれることはない。","tok":[["あなた"],["は"],["夜","よる"],["の"],["恐ろしい","おそろしい"],["物","もの"],["を"],["も"],["、"],["昼","ひる"],["に"],["飛んで","とんで"],["くる"],["矢","や"],["を"],["も"],["恐れる","おそれる"],["こと"],["は"],["ない"],["。"]]},{"verse":6,"text":"また暗,くらやみに歩,あるきまわる疫病,えきびょうをも、真昼,まひるに荒,あらす滅,ほろびをも恐,おそれることはない。","tok":[["また"],["暗やみ","くらやみ"],["に"],["歩き","あるき"],["まわる"],["疫病","えきびょう"],["を"],["も"],["、"],["真昼","まひる"],["に"],["荒す","あらす"],["滅び","ほろび"],["を"],["も"],["恐れる","おそれる"],["こと"],["は"],["ない"],["。"]]},{"verse":7,"text":"たとい千人,にんはあなたのかたわらに倒,たおれ、万人,にんはあなたの右,みぎに倒,たおれても、その災,わざわいはあなたに近,ちかづくことはない。","tok":[["たとい"],["千人","にん"],["は"],["あなた"],["の"],["かたわら"],["に"],["倒れ","たおれ"],["、"],["万人","にん"],["は"],["あなた"],["の"],["右","みぎ"],["に"],["倒れて","たおれて"],["も"],["、"],["その"],["災","わざわい"],["は"],["あなた"],["に"],["近づく","ちかづく"],["こと"],["は"],["ない"],["。"]]},{"verse":8,"text":"あなたはただ、その目,めをもって見,み、悪,あしき者,ものの報,むくいを見,みるだけである。","tok":[["あなた"],["は"],["ただ"],["、"],["その"],["目","め"],["を"],["もって"],["見","み"],["、"],["悪しき","あしき"],["者","もの"],["の"],["報い","むくい"],["を"],["見る","みる"],["だけ"],["で"],["ある"],["。"]]},{"verse":9,"text":"あなたは主,しゅを避,さけ所,どころとし、いと高,たかき者,ものをすまいとしたので、","tok":[["あなた"],["は"],["主","しゅ"],["を"],["避け","さけ"],["所","ど"],["ころ"],["と"],["し"],["、"],["いと"],["高き","たかき"],["者","もの"],["を"],["すまい"],["と"],["した"],["ので"],["、"]]},{"verse":10,"text":"災,わざわいはあなたに臨,のぞまず、悩,なやみはあなたの天幕,てんまくに近,ちかづくことはない。","tok":[["災","わざわい"],["は"],["あなた"],["に"],["臨まず","のぞまず"],["、"],["悩み","なやみ"],["は"],["あなた"],["の"],["天幕","てんまく"],["に"],["近づく","ちかづく"],["こと"],["は"],["ない"],["。"]]},{"verse":11,"text":"これは主,しゅがあなたのために天使,てんしたちに命,めいじて、あなたの歩,あゆむすべての道,みちであなたを守,まもらせられるからである。","tok":[["これ"],["は"],["主","しゅ"],["が"],["あなた"],["の"],["ため"],["に"],["天使","てんし"],["たち"],["に"],["命じて","めいじて"],["、"],["あなた"],["の"],["歩む","あゆむ"],["すべて"],["の"],["道","みち"],["で"],["あなた"],["を"],["守らせられる","まもらせられる"],["から"],["で"],["ある"],["。"]]},{"verse":12,"text":"彼,かれらはその手,てで、あなたをささえ、石,いしに足,あしを打,うちつけることのないようにする。","tok":[["彼","かれ"],["ら"],["は"],["その"],["手","て"],["で"],["、"],["あなた"],["を"],["ささえ"],["、"],["石","いし"],["に"],["足","あし"],["を"],["打ちつける","うちつける"],["こと"],["の"],["ない"],["よう"],["に"],["する"],["。"]]},{"verse":13,"text":"あなたはししと、まむしとを踏,ふみ、若,わかいししと、へびとを足,あしの下,したに踏,ふみにじるであろう。","tok":[["あなた"],["は"],["し"],["し"],["と"],["、"],["まむし"],["と"],["を"],["踏み","ふみ"],["、"],["若い","わかい"],["しし"],["と"],["、"],["へび"],["と"],["を"],["足","あし"],["の"],["下","した"],["に"],["踏みにじるで","ふみにじるで"],["あろう"],["。"]]},{"verse":14,"text":"彼,かれはわたしを愛,あいして離,はなれないゆえに、わたしは彼,かれを助,たすけよう。彼,かれはわが名,なを知,しるゆえに、わたしは彼,かれを守,まもる。","tok":[["彼","かれ"],["は"],["わたし"],["を"],["愛して","あいして"],["離れない","はなれない"],["ゆえ"],["に"],["、"],["わたし"],["は"],["彼","かれ"],["を"],["助けよう","たすけよう"],["。"],["彼","かれ"],["は"],["わが"],["名","な"],["を"],["知る","しる"],["ゆえ"],["に"],["、"],["わたし"],["は"],["彼","かれ"],["を"],["守","まもる"],["。"]]},{"verse":15,"text":"彼,かれがわたしを呼,よぶとき、わたしは彼,かれに答,こたえる。わたしは彼,かれの悩,なやみのときに、共,ともにいて、彼,かれを救,すくい、彼,かれに光栄,こうえいを与,あたえよう。","tok":[["彼","かれ"],["が"],["わたし"],["を"],["呼ぶ","よぶ"],["とき"],["、"],["わたし"],["は"],["彼","かれ"],["に"],["答","こたえ"],["る"],["。"],["わたし"],["は"],["彼","かれ"],["の"],["悩み","なやみ"],["の"],["とき"],["に"],["、"],["共","とも"],["に"],["いて"],["、"],["彼","かれ"],["を"],["救い","すくい"],["、"],["彼","かれ"],["に"],["光栄","こうえい"],["を"],["与","あたえ"],["よう"],["。"]]},{"verse":16,"text":"わたしは長寿,ちょうじゅをもって彼,かれを満,みち足,たらせ、わが救,すくいを彼,かれに示,しめすであろう。","tok":[["わたし"],["は"],["長寿","ちょうじゅ"],["を"],["もって"],["彼","かれ"],["を"],["満ち","みち"],["足らせ","たらせ"],["、"],["わが"],["救い","すくい"],["を"],["彼","かれ"],["に"],["示めすで","しめすで"],["あろう"],["。"]]}]
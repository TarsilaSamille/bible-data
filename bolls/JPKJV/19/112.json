[{"verse":1,"text":"主,しゅをほめたたえよ。主,しゅをおそれて、そのもろもろの戒,いましめを大,おおいに喜,よろこぶ人,ひとはさいわいである。","tok":[["主","しゅ"],["を"],["ほめたたえ"],["よ"],["。"],["主","しゅ"],["を"],["おそれて"],["、"],["その"],["もろもろ"],["の"],["戒しめ","いましめ"],["を"],["大いに","おおいに"],["喜こぶ","よろこぶ"],["人","ひと"],["は"],["さいわい"],["で"],["ある"],["。"]]},{"verse":2,"text":"その子孫,しそんは地,ちにおいて強,つよくなり、正,ただしい者,もののやからは祝福,しゅくふくを得,える。","tok":[["その"],["子孫","しそん"],["は"],["地","ち"],["に"],["おいて"],["強く","つよく"],["なり"],["、"],["正い","ただしい"],["者","もの"],["の"],["やから"],["は"],["祝福","しゅくふく"],["を"],["得る","える"],["。"]]},{"verse":3,"text":"繁栄,はんえいと富,とみとはその家,いえにあり、その義,ぎはとこしえに、うせることはない。","tok":[["繁栄","はんえい"],["と"],["富","とみ"],["と"],["は"],["その"],["家","いえ"],["に"],["あり"],["、"],["その"],["義","ぎ"],["は"],["とこしえ"],["に"],["、"],["うせる"],["こと"],["は"],["ない"],["。"]]},{"verse":4,"text":"光,ひかりは正,ただしい者,もののために暗黒,あんこくの中,なかにもあらわれる。主,しゅは恵,めぐみ深,ふかく、あわれみに満,みち、正,ただしくいらせられる。","tok":[["光","ひかり"],["は"],["正い","ただしい"],["者","もの"],["の"],["ため"],["に"],["暗黒","あんこく"],["の"],["中","なか"],["に"],["も"],["あらわれる"],["。"],["主","しゅ"],["は"],["恵","めぐみ"],["深く","ふかく"],["、"],["あわれみ"],["に"],["満ち","みち"],["、"],["正く","ただしく"],["いらせられる"],["。"]]},{"verse":5,"text":"恵,めぐみを施,ほどこし、貸,かすことをなし、その事,ことを正,ただしく行,おこなう人,ひとはさいわいである。","tok":[["恵","めぐみ"],["を"],["施し","ほどこし"],["、"],["貸す","かす"],["こと"],["を"],["なし"],["、"],["その"],["事","こと"],["を"],["正く","ただしく"],["行なう","おこなう"],["人","ひと"],["は"],["さいわい"],["で"],["ある"],["。"]]},{"verse":6,"text":"正,ただしい人,ひとは決,けっして動,うごかされることなく、とこしえに覚,おぼえられる。","tok":[["正い","ただしい"],["人","ひと"],["は"],["決っして","けっして"],["動かされる","うごかされる"],["こと"],["なく"],["、"],["とこしえ"],["に"],["覚えられる","おぼえられる"],["。"]]},{"verse":7,"text":"彼,かれは悪,わるいおとずれを恐,おそれず、その心,こころは主,しゅに信頼,しんらいしてゆるがない。","tok":[["彼","かれ"],["は"],["悪い","わるい"],["おとずれ"],["を"],["恐れず","おそれず"],["、"],["その"],["心","こころ"],["は"],["主に","しゅに"],["信頼","しんらい"],["して"],["ゆるがない"],["。"]]},{"verse":8,"text":"その心,こころは落,おち着,ついて恐,おそれることなく、ついにそのあだについての願,ねがいを見,みる。","tok":[["その"],["心","こころ"],["は"],["落着いて","おちついて"],["恐れる","おそれる"],["こと"],["なく"],["、"],["ついに"],["その"],["あだ"],["について"],["の"],["願い","ねがい"],["を"],["見る","みる"],["。"]]},{"verse":9,"text":"彼,かれは惜,おしげなく施,ほどこし、貧,まずしい者,ものに与,あたえた。その義,ぎはとこしえに、うせることはない。その角,つのは誉,ほまれを得,えてあげられる。","tok":[["彼","かれ"],["は"],["惜","おし"],["げ"],["なく"],["施し","ほどこし"],["、"],["貧しい","まずしい"],["者","もの"],["に"],["与","あたえ"],["た"],["。"],["その"],["義","ぎ"],["は"],["とこしえ"],["に"],["、"],["うせる"],["こと"],["は"],["ない"],["。"],["その"],["角","つ"],["の"],["は"],["誉","ほまれ"],["を"],["得て","えて"],["あげられる"],["。"]]},{"verse":10,"text":"悪,あしき者,ものはこれを見,みて怒,いかり、歯,はをかみならして溶,とけ去,さる。悪,あしき者,ものの願,ねがいは滅,ほろびる。","tok":[["悪しき","あしき"],["者","もの"],["は"],["これ"],["を"],["見て","みて"],["怒り","いかり"],["、"],["歯","は"],["を"],["かみ"],["ならして"],["溶け去る","とけさる"],["。"],["悪しき","あしき"],["者","もの"],["の"],["願い","ねがい"],["は"],["滅びる","ほろびる"],["。"]]}]
[{"verse":1,"text":"【ダビデの祈,いのり】主,しゅよ、正,ただしい訴,うったえを聞,きき、わたしの叫,さけびにみ心,こころをとめ、偽,いつわりのないくちびるから出,でるわたしの祈,いのりに耳,みみを傾,かたむけてください。","tok":[["【"],["ダビデ"],["の"],["祈","いのり"],["】"],["主","しゅ"],["よ"],["、"],["正い","ただしい"],["訴","うったえ"],["を"],["聞","きき"],["、"],["わたし"],["の"],["叫","さけび"],["に"],["み心","みこころ"],["を"],["とめ"],["、"],["偽わり","いつわり"],["の"],["ない"],["くちびる"],["から"],["出る","でる"],["わたし"],["の"],["祈","いのり"],["に"],["耳","みみ"],["を"],["傾むけて","かたむけて"],["ください"],["。"]]},{"verse":2,"text":"どうかわたしについての宣告,せんこくがみ前,まえから出,でて、あなたの目,めが公平,こうへいをみられるように。","tok":[["どう"],["か"],["わたし"],["について"],["の"],["宣告","せんこく"],["が"],["み前","みまえ"],["から"],["出て","でて"],["、"],["あなた"],["の"],["目","め"],["が"],["公平","こうへい"],["を"],["みられる"],["よう"],["に"],["。"]]},{"verse":3,"text":"あなたがわたしの心,こころをためし、夜,よる、わたしに臨,のぞみ、わたしを試,こころみられても、わたしのうちになんの悪,わるい思,おもいをも見,みいだされないでしょう。わたしの口,くちも罪,つみを犯,おかしません。","tok":[["あなた"],["が"],["わたし"],["の"],["心","こころ"],["を"],["ためし"],["、"],["夜","よる"],["、"],["わたし"],["に"],["臨み","のぞみ"],["、"],["わたし"],["を"],["試みられて","こころみられて"],["も"],["、"],["わたし"],["の"],["うち"],["に"],["なん"],["の"],["悪い","わるい"],["思い","おもい"],["を"],["も"],["見いだされないでしょう","みいだされないでしょう"],["。"],["わたし"],["の"],["口","くち"],["も"],["罪","つみ"],["を"],["犯しません","おかしません"],["。"]]},{"verse":4,"text":"人,ひとのおこないの事,ことをいえば、あなたのくちびるの言葉,ことばによって、わたしは不法,ふほうな者,ものの道,みちを避,さけました。","tok":[["人","ひと"],["の"],["おこない"],["の"],["事","こと"],["を"],["いえば"],["、"],["あなた"],["の"],["くちびる"],["の"],["言葉","ことば"],["によって"],["、"],["わたし"],["は"],["不法","ふほう"],["な"],["者","もの"],["の"],["道","みち"],["を"],["避けました","さけました"],["。"]]},{"verse":5,"text":"わたしの歩,あゆみはあなたの道,みちに堅,かたく立,たち、わたしの足,あしはすべることがなかったのです。","tok":[["わたし"],["の"],["歩み","あゆみ"],["は"],["あなた"],["の"],["道","みち"],["に"],["堅く","かたく"],["立ち","たち"],["、"],["わたし"],["の"],["足","あし"],["は"],["すべる"],["こと"],["が"],["なかった"],["の"],["です"],["。"]]},{"verse":6,"text":"神,かみよ、わたしはあなたに呼,よばわります。あなたはわたしに答,こたえられます。どうか耳,みみを傾,かたむけて、わたしの述,のべることをお聞,ききください。","tok":[["神","かみ"],["よ"],["、"],["わたし"],["は"],["あなた"],["に"],["呼ばわります","よばわります"],["。"],["あなた"],["は"],["わたし"],["に"],["答","こたえ"],["られます"],["。"],["どう"],["か"],["耳","みみ"],["を"],["傾むけて","かたむけて"],["、"],["わたし"],["の"],["述べる","のべる"],["こと"],["を"],["お聞く","おききく"],["ださい"],["。"]]},{"verse":7,"text":"寄,より頼,たのむ者,ものをそのあだから右,みぎの手,てで救,すくわれる者,ものよ、あなたのいつくしみを驚,おどろくばかりにあらわし、","tok":[["寄り","より"],["頼む","たのむ"],["者","もの"],["を"],["その"],["あだ"],["から"],["右","みぎ"],["の"],["手","て"],["で"],["救われる","すくわれる"],["者","もの"],["よ"],["、"],["あなた"],["の"],["いつくしみ"],["を"],["驚ろく","おどろく"],["ばかり"],["に"],["あらわし"],["、"]]},{"verse":8,"text":"ひとみのようにわたしを守,まもり、みつばさの陰,かげにわたしを隠,かくし、","tok":[["ひとみ"],["の"],["よう"],["に"],["わたし"],["を"],["守り","まもり"],["、"],["みつばさ"],["の"],["陰","かげ"],["に"],["わたし"],["を"],["隠し","かくし"],["、"]]},{"verse":9,"text":"わたしをしえたげる悪,あしき者,ものから、わたしを囲,かこむ恐,おそろしい敵,てきから、のがれさせてください。","tok":[["わたし"],["を"],["し"],["えたげる"],["悪しき","あしき"],["者","もの"],["から"],["、"],["わたし"],["を"],["囲む","かこむ"],["恐ろしい","おそろしい"],["敵","てき"],["から"],["、"],["のがれ"],["させて"],["ください"],["。"]]},{"verse":10,"text":"彼,かれらはその心,こころを閉,とじて、あわれむことなく、その口,くちをもって高,たかぶって語,かたるのです。","tok":[["彼","かれ"],["ら"],["は"],["その"],["心","こころ"],["を"],["閉じて","とじて"],["、"],["あわれむ"],["こと"],["なく"],["、"],["その"],["口","くち"],["を"],["もって"],["高か","たか"],["ぶっ"],["て"],["語る","かたる"],["の"],["です"],["。"]]},{"verse":11,"text":"彼,かれらはわたしを追,おいつめ、わたしを囲,かこみ、わたしを地,ちに投,なげ倒,たおさんと、その目,めをそそぎます。","tok":[["彼","かれ"],["ら"],["は"],["わたし"],["を"],["追いつめ","おいつめ"],["、"],["わたし"],["を"],["囲み","かこみ"],["、"],["わたし"],["を"],["地","ち"],["に"],["投","なげ"],["倒さん","たおさん"],["と"],["、"],["その"],["目","め"],["を"],["そそぎます"],["。"]]},{"verse":12,"text":"彼,かれらはかき裂,さかんと、いらだつししのごとく、隠,かくれた所,ところにひそみ待,まつ子,こじしのようです。","tok":[["彼","かれ"],["ら"],["は"],["かき裂かん","かきさかん"],["と"],["、"],["いらだつ"],["しし"],["の"],["ごとく"],["、"],["隠れた","かくれた"],["所","ところ"],["に"],["ひそみ"],["待つ","まつ"],["子","こ"],["じし"],["の"],["よう"],["です"],["。"]]},{"verse":13,"text":"主,しゅよ、立,たちあがって、彼,かれらに立,たちむかい、彼,かれらを倒,たおしてください。つるぎをもって悪,あしき者,ものからわたしのいのちをお救,すくいください。","tok":[["主","しゅ"],["よ"],["、"],["立ちあがって","たちあがって"],["、"],["彼","かれ"],["ら"],["に"],["立ちむかい","たちむかい"],["、"],["彼","かれ"],["ら"],["を"],["倒して","たおして"],["ください"],["。"],["つるぎ"],["を"],["もって"],["悪しき","あしき"],["者","もの"],["から"],["わたし"],["の"],["いのち"],["を"],["お救い","おすくい"],["ください"],["。"]]},{"verse":14,"text":"主,しゅよ、み手,てをもって人々,ひとびとからわたしをお救,すくいください。すなわち自分,じぶんの分,わけ前,まえをこの世,よで受,うけ、あなたの宝,たからをもってその腹,はらを満,みたされる世,よの人々,ひとびとからわたしをお救,すくいください。彼,かれらは多,おおくの子,こに飽,あき足,たり、その富,とみを幼,おさな子,こに残,のこすのです。","tok":[["主","しゅ"],["よ"],["、"],["み手","みて"],["を"],["もって"],["人々","ひとびと"],["から"],["わたし"],["を"],["お救い","おすくい"],["ください"],["。"],["すなわち"],["自分","じぶん"],["の"],["分け前","わけまえ"],["を"],["この世","このよ"],["で"],["受け","うけ"],["、"],["あなた"],["の"],["宝","たから"],["を"],["もって"],["その"],["腹","はら"],["を"],["満たされる","みたされる"],["世","よ"],["の"],["人々","ひとびと"],["から"],["わたし"],["を"],["お救い","おすくい"],["ください"],["。"],["彼","かれ"],["ら"],["は"],["多く","おおく"],["の"],["子","こ"],["に"],["飽き足り","あきたり"],["、"],["その"],["富","とみ"],["を"],["幼な子","おさなこ"],["に"],["残す","のこす"],["の"],["です"],["。"]]},{"verse":15,"text":"しかしわたしは義,ぎにあって、み顔,かおを見,み、目,めざめる時,とき、みかたちを見,みて、満,みち足,たりるでしょう。","tok":[["しかし"],["わたし"],["は"],["義","ぎ"],["に"],["あって"],["、"],["み顔","みかお"],["を"],["見","み"],["、"],["目ざめる","めざめる"],["時","とき"],["、"],["みかたち"],["を"],["見て","みて"],["、"],["満ち足りるでしょう","みちたりるでしょう"],["。"]]}]
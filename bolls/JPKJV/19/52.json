[{"verse":1,"text":"[0]【聖歌,せいか隊,たいの指揮者,しきしゃによってうたわせたダビデのマスキールの歌,うた。","tok":[["["],["0"],["]"],["【"],["聖歌隊","せいかたい"],["の"],["指揮者","しきしゃ"],["によって"],["うたわせた"],["ダビデ"],["の"],["マスキール"],["の"],["歌","うた"],["。"]]},{"verse":2,"text":"[00]これはエドムびとドエグがサウルにきて、「ダビデはアヒメレクの家,いえにきた」と告,つげたときにダビデがよんだもの】","tok":[["["],["00"],["]"],["これ"],["は"],["エドム"],["びと"],["ドエグ"],["が"],["サウル"],["に"],["きて"],["、"],["「"],["ダビデ"],["は"],["アヒメレク"],["の"],["家","いえ"],["に"],["きた"],["」"],["と"],["告","つげ"],["た"],["とき"],["に"],["ダビデ"],["が"],["よんだ"],["もの"],["】"]]},{"verse":3,"text":"[1]力,ちからある者,ものよ、何,なにゆえあなたは神,かみを敬,うやまう人,ひとに与,あたえた災,わざわいについて誇,ほこるのか。あなたはひねもす人,ひとを滅,ほろぼすことをたくらむ。","tok":[["["],["1"],["]"],["力","ちから"],["ある"],["者","もの"],["よ"],["、"],["何ゆえ","なにゆえ"],["あなた"],["は"],["神","かみ"],["を"],["敬う","うやまう"],["人","ひと"],["に"],["与","あたえ"],["た"],["災","わざわい"],["について"],["誇る","ほこる"],["の"],["か"],["。"],["あなた"],["は"],["ひねもす"],["人","ひと"],["を"],["滅ぼす","ほろぼす"],["こと"],["を"],["たくらむ"],["。"]]},{"verse":4,"text":"[2]虚偽,きょぎを行,おこなう者,ものよ、あなたの舌,したは鋭,するどいかみそりのようだ。","tok":[["["],["2"],["]"],["虚偽","きょぎ"],["を"],["行なう","おこなう"],["者","もの"],["よ"],["、"],["あなた"],["の"],["舌","した"],["は"],["鋭い","するどい"],["かみそり"],["の"],["よう"],["だ"],["。"]]},{"verse":5,"text":"[3]あなたは善,ぜんよりも悪,あくを好,このみ、まことを語,かたるよりも偽,いつわりを語,かたることを好,このむ。〔セラ","tok":[["["],["3"],["]"],["あなた"],["は"],["善","ぜん"],["より"],["も"],["悪","あく"],["を"],["好み","このみ"],["、"],["まこと"],["を"],["語る","かたる"],["より"],["も"],["偽り","いつわり"],["を"],["語る","かたる"],["こと"],["を"],["好む","このむ"],["。"],["〔"],["セラ"]]},{"verse":6,"text":"[4]欺,あざむきの舌,したよ、あなたはすべての滅,ほろぼす言葉,ことばを好,このむ。","tok":[["["],["4"],["]"],["欺き","あざむき"],["の"],["舌","した"],["よ"],["、"],["あなた"],["は"],["すべて"],["の"],["滅ぼす","ほろぼす"],["言葉","ことば"],["を"],["好む","このむ"],["。"]]},{"verse":7,"text":"[5]しかし神,かみはとこしえにあなたを砕,くだき、あなたを捕,とらえて、その天幕,てんまくから引,ひき離,はなし、生,いける者,ものの地,ちから、あなたの根,ねを絶,たやされる。〔セラ","tok":[["["],["5"],["]"],["しかし"],["神","かみ"],["は"],["とこしえ"],["に"],["あなた"],["を"],["砕き","くだき"],["、"],["あなた"],["を"],["捕らえて","とらえて"],["、"],["その"],["天幕","てんまく"],["から"],["引離し","ひきはなし"],["、"],["生ける","いける"],["者","もの"],["の"],["地","ち"],["から"],["、"],["あなた"],["の"],["根","ね"],["を"],["絶やされる","たやされる"],["。"],["〔"],["セラ"]]},{"verse":8,"text":"[6]正,ただしい者,ものはこれを見,みて恐,おそれ、彼,かれを笑,わらって言,いうであろう、","tok":[["["],["6"],["]"],["正い","ただしい"],["者","もの"],["は"],["これ"],["を"],["見て","みて"],["恐","おそれ"],["、"],["彼","かれ"],["を"],["笑って","わらって"],["言うで","いうで"],["あろう"],["、"]]},{"verse":9,"text":"[7]「神,かみをおのが避,さけ所,どころとせず、その富,とみの豊,ゆたかなるを頼,たのみ、その宝,たからに寄,より頼,たのむ人,ひとを見,みよ」と。","tok":[["["],["7"],["]"],["「"],["神","かみ"],["を"],["おの"],["が"],["避け","さけ"],["所","どころ"],["と"],["せず"],["、"],["その"],["富","とみ"],["の"],["豊","ゆたか"],["なる"],["を"],["頼み","たのみ"],["、"],["その"],["宝","たから"],["に"],["寄り","より"],["頼む","たのむ"],["人","ひと"],["を"],["見よ","みよ"],["」"],["と"],["。"]]},{"verse":10,"text":"[8]しかし、わたしは神,かみの家,いえにある緑,みどりのオリブの木,きのようだ。わたしは世々,よよかぎりなく神,かみのいつくしみを頼,たのむ。","tok":[["["],["8"],["]"],["しかし"],["、"],["わたし"],["は"],["神","かみ"],["の"],["家","いえ"],["に"],["ある"],["緑","みどり"],["の"],["オリブ"],["の"],["木","き"],["の"],["よう"],["だ"],["。"],["わたし"],["は"],["世々","よ"],["よ"],["かぎりなく"],["神","かみ"],["の"],["いつくしみ"],["を"],["頼む","たのむ"],["。"]]},{"verse":11,"text":"[9]あなたがこの事,ことをなされたので、わたしはとこしえに、あなたに感謝,かんしゃし、聖徒,せいとの前,まえであなたのみ名,なをふれ示,しめそう。これはよいことだからである。","tok":[["["],["9"],["]"],["あなた"],["が"],["この"],["事","こと"],["を"],["なされた"],["ので"],["、"],["わたし"],["は"],["とこしえ"],["に"],["、"],["あなた"],["に"],["感謝","かんしゃ"],["し"],["、"],["聖徒","せいと"],["の"],["前","まえ"],["で"],["あなた"],["のみ"],["名","な"],["を"],["ふれ"],["示めそう","しめそう"],["。"],["これ"],["は"],["よい"],["こと"],["だ"],["から"],["で"],["ある"],["。"]]}]
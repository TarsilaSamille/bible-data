[{"verse":1,"text":"[0]【安息日,あんそくにちの歌,うた、さんび】","tok":[["["],["0"],["]"],["【"],["安息日","あんそくにち"],["の"],["歌","うた"],["、"],["さん"],["び"],["】"]]},{"verse":2,"text":"[1]いと高,たかき者,ものよ、主,しゅに感謝,かんしゃし、み名,なをほめたたえるのは、よいことです。","tok":[["["],["1"],["]"],["いと"],["高き","たかき"],["者","もの"],["よ"],["、"],["主に","しゅに"],["感謝","かんしゃ"],["し"],["、"],["み名","みな"],["を"],["ほめたたえる"],["の"],["は"],["、"],["よい"],["こと"],["です"],["。"]]},{"verse":3,"text":"[2]あしたに、あなたのいつくしみをあらわし、夜,よな夜,よな、あなたのまことをあらわすために、","tok":[["["],["2"],["]"],["あした"],["に"],["、"],["あなた"],["の"],["いつくしみ"],["を"],["あらわし"],["、"],["夜な夜な","よなよな"],["、"],["あなた"],["の"],["まこと"],["を"],["あらわす"],["ため"],["に"],["、"]]},{"verse":4,"text":"[3]十弦,じゅうげんの楽器,がっきと立琴,たてごとを用,もちい、琴,ことのたえなる調,しらべを用,もちいるのは、よいことです。","tok":[["["],["3"],["]"],["十","じゅう"],["弦","げん"],["の"],["楽器","がっき"],["と"],["立琴","たてごと"],["を"],["用い","もちい"],["、"],["琴","こと"],["の"],["たえなる"],["調べ","しらべ"],["を"],["用いる","もちいる"],["の"],["は"],["、"],["よい"],["こと"],["です"],["。"]]},{"verse":5,"text":"[4]主,しゅよ、あなたはみわざをもってわたしを楽,たのしませられました。わたしはあなたのみ手,てのわざを喜,よろこび歌,うたいます。","tok":[["["],["4"],["]"],["主","しゅ"],["よ"],["、"],["あなた"],["は"],["みわざ"],["を"],["もって"],["わたし"],["を"],["楽しませられました","たのしませられました"],["。"],["わたし"],["は"],["あなた"],["のみ"],["手","て"],["の"],["わざ"],["を"],["喜こび","よろこび"],["歌います","うたいます"],["。"]]},{"verse":6,"text":"[5]主,しゅよ、あなたのみわざはいかに大,おおいなることでしょう。あなたのもろもろの思,おもいは、いとも深,ふかく、","tok":[["["],["5"],["]"],["主","しゅ"],["よ"],["、"],["あなた"],["のみ"],["わざ"],["は"],["いかに"],["大いなる","おおいなる"],["こと"],["でしょう"],["。"],["あなた"],["の"],["もろもろ"],["の"],["思い","おもい"],["は"],["、"],["いとも"],["深く","ふかく"],["、"]]},{"verse":7,"text":"[6]鈍,にぶい者,ものは知,しることができず、愚,おろかな者,ものはこれを悟,さとることができません。","tok":[["["],["6"],["]"],["鈍い","にぶい"],["者","もの"],["は"],["知る","しる"],["こと"],["が"],["できず"],["、"],["愚か","おろか"],["な"],["者","もの"],["は"],["これ"],["を"],["悟","さとる"],["こと"],["が"],["できません"],["。"]]},{"verse":8,"text":"[7]たとい、悪,あしき者,ものは草,くさのようにもえいで、不義,ふぎを行,おこなう者,ものはことごとく栄,さかえても、彼,かれらはとこしえに滅,ほろびに定,さだめられているのです。","tok":[["["],["7"],["]"],["たとい"],["、"],["悪しき","あしき"],["者","もの"],["は"],["草","くさ"],["の"],["よう"],["に"],["も"],["え"],["いで"],["、"],["不義","ふぎ"],["を"],["行なう","おこなう"],["者","もの"],["は"],["ことごとく"],["栄","さかえ"],["て"],["も"],["、"],["彼","かれ"],["ら"],["は"],["とこしえ"],["に"],["滅び","ほろび"],["に"],["定められて","さだめられて"],["いる"],["の"],["です"],["。"]]},{"verse":9,"text":"[8]しかし、主,しゅよ、あなたはとこしえに高,たかき所,ところにいらせられます。","tok":[["["],["8"],["]"],["しかし"],["、"],["主","しゅ"],["よ"],["、"],["あなた"],["は"],["とこしえ"],["に"],["高き","たかき"],["所","ところ"],["に"],["いらせられます"],["。"]]},{"verse":10,"text":"[9]主,しゅよ、あなたの敵,てき、あなたの敵,てきは滅,ほろび、不義,ふぎを行,おこなう者,ものはことごとく散,ちらされるでしょう。","tok":[["["],["9"],["]"],["主","しゅ"],["よ"],["、"],["あなた"],["の"],["敵","てき"],["、"],["あなた"],["の"],["敵","てき"],["は"],["滅び","ほろび"],["、"],["不義","ふぎ"],["を"],["行なう","おこなう"],["者","もの"],["は"],["ことごとく"],["散らされるでしょう","ちらされるでしょう"],["。"]]},{"verse":11,"text":"[10]しかし、あなたはわたしの角,つのを野牛,やぎゅうの角,つののように高,たかくあげ、新,あたらしい油,あぶらをわたしに注,そそがれました。","tok":[["["],["10"],["]"],["しかし"],["、"],["あなた"],["は"],["わたし"],["の"],["角","つ"],["の"],["を"],["野牛","やぎゅう"],["の"],["角","つ"],["の"],["の"],["よう"],["に"],["高く","たかく"],["あげ"],["、"],["新らしい","あたらしい"],["油","あぶら"],["を"],["わたし"],["に"],["注がれました","そそがれました"],["。"]]},{"verse":12,"text":"[11]わたしの目,めはわが敵,てきの没落,ぼつらくを見,み、わたしの耳,みみはわたしを攻,せめる悪者,わるものどもの破滅,はめつを聞,ききました。","tok":[["["],["11"],["]"],["わたし"],["の"],["目","め"],["は"],["わが"],["敵","てき"],["の"],["没落","ぼつらく"],["を"],["見","み"],["、"],["わたし"],["の"],["耳","みみ"],["は"],["わたし"],["を"],["攻める","せめる"],["悪者","わるもの"],["ども"],["の"],["破滅","はめつ"],["を"],["聞","きき"],["ました"],["。"]]},{"verse":13,"text":"[12]正,ただしい者,ものはなつめやしの木,きのように栄,さかえ、レバノンの香柏,こうはくのように育,そだちます。","tok":[["["],["12"],["]"],["正い","ただしい"],["者","もの"],["は"],["なつめやし"],["の"],["木","き"],["の"],["よう"],["に"],["栄","さかえ"],["、"],["レバノン"],["の"],["香","こう"],["柏","かしわ"],["の"],["よう"],["に"],["育ちます","そだちます"],["。"]]},{"verse":14,"text":"[13]彼,かれらは主,しゅの家,いえに植,うえられ、われらの神,かみの大庭,おおにわに栄,さかえます。","tok":[["["],["13"],["]"],["彼","かれ"],["ら"],["は"],["主","しゅ"],["の"],["家","いえ"],["に"],["植えられ","うえられ"],["、"],["われ"],["ら"],["の"],["神","かみ"],["の"],["大庭","おおにわ"],["に"],["栄","さかえ"],["ます"],["。"]]},{"verse":15,"text":"[14]彼,かれらは年老,としおいてなお実,みを結,むすび、いつも生気,せいきに満,みち、青々,あおあおとして、","tok":[["["],["14"],["]"],["彼","かれ"],["ら"],["は"],["年老いて","としおいて"],["なお実","なおみ"],["を"],["結び","むすび"],["、"],["いつも"],["生気","せいき"],["に"],["満ち","みち"],["、"],["青々","あおあお"],["として"],["、"]]},{"verse":16,"text":"[15]主,しゅの正,ただしいことを示,しめすでしょう。主,しゅはわが岩,いわです。主,しゅには少,すこしの不義,ふぎもありません。","tok":[["["],["15"],["]"],["主","しゅ"],["の"],["正い","ただしい"],["こと"],["を"],["示めすでしょう","しめすでしょう"],["。"],["主","しゅ"],["は"],["わが"],["岩","いわ"],["です"],["。"],["主に","しゅに"],["は"],["少し","すこし"],["の"],["不義","ふぎ"],["も"],["ありません"],["。"]]}]
[{"verse":1,"text":"第,だい四,よん巻,かん【神,かみの人,ひとモーセの祈,いのり】主,しゅよ、あなたは世々,よよわれらのすみかでいらせられる。","tok":[["第","だい"],["四","よん"],["巻","かん"],["【"],["神","かみ"],["の"],["人","ひと"],["モーセ"],["の"],["祈","いのり"],["】"],["主","しゅ"],["よ"],["、"],["あなた"],["は"],["世々","よよわれら"],["の"],["すみか"],["で"],["いらせられる"],["。"]]},{"verse":2,"text":"山,やまがまだ生,うまれず、あなたがまだ地,ちと世界,せかいとを造,つくられなかったとき、とこしえからとこしえまで、あなたは神,かみでいらせられる。","tok":[["山","やま"],["が"],["まだ"],["生まれず","うまれず"],["、"],["あなた"],["が"],["まだ"],["地","ち"],["と"],["世界","せかい"],["と"],["を"],["造られなかった","つくられなかった"],["とき"],["、"],["とこしえ"],["から"],["とこしえ"],["まで"],["、"],["あなた"],["は"],["神","かみ"],["で"],["いらせられる"],["。"]]},{"verse":3,"text":"あなたは人,ひとをちりに帰,かえらせて言,いわれます、「人,ひとの子,こよ、帰,かえれ」と。","tok":[["あなた"],["は"],["人","ひと"],["を"],["ちり"],["に"],["帰えらせて","かえらせて"],["言われます","いわれます"],["、"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["帰えれ","かえれ"],["」"],["と"],["。"]]},{"verse":4,"text":"あなたの目,めの前,まえには千年,ねんも過,すぎ去,さればきのうのごとく、夜,よの間,まのひと時,ときのようです。","tok":[["あなた"],["の"],["目","め"],["の"],["前","まえ"],["に"],["は"],["千","せん"],["年","ねん"],["も"],["過去れば","すぎされば"],["きのう"],["の"],["ごとく"],["、"],["夜","よ"],["の"],["間","ま"],["の"],["ひと時","ひととき"],["の"],["よう"],["です"],["。"]]},{"verse":5,"text":"あなたは人,ひとを大水,おおみずのように流,ながれ去,さらせられます。彼,かれらはひと夜,よの夢,ゆめのごとく、あしたにもえでる青草,あおくさのようです。","tok":[["あなた"],["は"],["人","ひと"],["を"],["大水","おおみず"],["の"],["よう"],["に"],["流れ去らせられます","ながれさらせられます"],["。"],["彼","かれ"],["ら"],["は"],["ひと"],["夜","よ"],["の"],["夢","ゆめ"],["の"],["ごとく"],["、"],["あした"],["に"],["もえでる"],["青草","あおくさ"],["の"],["よう"],["です"],["。"]]},{"verse":6,"text":"あしたにもえでて、栄,さかえるが、夕,ゆうべには、しおれて枯,かれるのです。","tok":[["あした"],["に"],["もえでて"],["、"],["栄","さかえ"],["る"],["が"],["、"],["夕べ","ゆうべ"],["に"],["は"],["、"],["しおれて"],["枯る","かれる"],["の"],["です"],["。"]]},{"verse":7,"text":"われらはあなたの怒,いかりによって消,きえうせ、あなたの憤,いきどおりによって滅,ほろび去,さるのです。","tok":[["われ"],["ら"],["は"],["あなた"],["の"],["怒り","いかり"],["によって"],["消えうせ","きえうせ"],["、"],["あなた"],["の"],["憤り","いきどおり"],["によって"],["滅び去る","ほろびさる"],["の"],["です"],["。"]]},{"verse":8,"text":"あなたはわれらの不義,ふぎをみ前,まえにおき、われらの隠,かくれた罪,つみをみ顔,かおの光,ひかりのなかにおかれました。","tok":[["あなた"],["は"],["われ"],["ら"],["の"],["不義","ふぎ"],["を"],["み前","みまえ"],["に"],["おき"],["、"],["われ"],["ら"],["の"],["隠れた","かくれた"],["罪","つみ"],["を"],["み顔","みかお"],["の"],["光","ひかり"],["の"],["なか"],["に"],["おかれました"],["。"]]},{"verse":9,"text":"われらのすべての日,ひは、あなたの怒,いかりによって過,すぎ去,さり、われらの年,としの尽,つきるのは、ひと息,いきのようです。","tok":[["われ"],["ら"],["の"],["すべて"],["の"],["日","ひ"],["は"],["、"],["あなた"],["の"],["怒り","いかり"],["によって"],["過去り","すぎさり"],["、"],["われ"],["ら"],["の"],["年","とし"],["の"],["尽きる","つきる"],["の"],["は"],["、"],["ひと息","ひといき"],["の"],["よう"],["です"],["。"]]},{"verse":10,"text":"われらのよわいは七十年,ねんにすぎません。あるいは健,すこやかであっても八十年,ねんでしょう。しかしその一生,いっしょうはただ、ほねおりと悩,なやみであって、その過,すぎゆくことは速,はやく、われらは飛,とび去,さるのです。","tok":[["われ"],["ら"],["の"],["よわい"],["は"],["七十","ななじゅう"],["年","ねん"],["に"],["すぎません"],["。"],["あるいは"],["健やか","すこやか"],["で"],["あって"],["も"],["八十","はちじゅう"],["年","ねん"],["でしょう"],["。"],["しかし"],["その"],["一生","いっしょう"],["は"],["ただ"],["、"],["ほねおり"],["と"],["悩み","なやみ"],["で"],["あって"],["、"],["その"],["過","すぎ"],["ゆく"],["こと"],["は"],["速く","はやく"],["、"],["われ"],["ら"],["は"],["飛び去る","とびさる"],["の"],["です"],["。"]]},{"verse":11,"text":"だれがあなたの怒,いかりの力,ちからを知,しるでしょうか。だれがあなたをおそれる恐,おそれにしたがってあなたの憤,いきどおりを知,しるでしょうか。","tok":[["だれ"],["が"],["あなた"],["の"],["怒り","いかり"],["の"],["力","ちから"],["を"],["知るでしょう","しるでしょう"],["か"],["。"],["だれ"],["が"],["あなた"],["を"],["おそれる"],["恐","おそれ"],["に"],["したがって"],["あなた"],["の"],["憤り","いきどおり"],["を"],["知るでしょう","しるでしょう"],["か"],["。"]]},{"verse":12,"text":"われらにおのが日,ひを数,かぞえることを教,おしえて、知恵,ちえの心,こころを得,えさせてください。","tok":[["われ"],["ら"],["に"],["お"],["の"],["が"],["日","ひ"],["を"],["数える","かぞえる"],["こと"],["を"],["教えて","おしえて"],["、"],["知恵","ちえ"],["の"],["心","こころ"],["を"],["得させて","えさせて"],["ください"],["。"]]},{"verse":13,"text":"主,しゅよ、み心,こころを変,かえてください。いつまでお怒,いかりになるのですか。あなたのしもべをあわれんでください。","tok":[["主","しゅ"],["よ"],["、"],["み心","みこころ"],["を"],["変えて","かえて"],["ください"],["。"],["いつ"],["まで"],["お怒り","おいかり"],["に"],["なる"],["の"],["です"],["か"],["。"],["あなた"],["の"],["しもべ"],["を"],["あわれんで"],["ください"],["。"]]},{"verse":14,"text":"あしたに、あなたのいつくしみをもってわれらを飽,あき足,たらせ、世,よを終,おわるまで喜,よろこび楽,たのしませてください。","tok":[["あした"],["に"],["、"],["あなた"],["の"],["いつくしみ"],["を"],["もって"],["われ"],["ら"],["を"],["飽き足らせ","あきたらせ"],["、"],["世","よ"],["を"],["終わる","おわる"],["まで"],["喜こび","よろこび"],["楽しませて","たのしませて"],["ください"],["。"]]},{"verse":15,"text":"あなたがわれらを苦,くるしめられた多,おおくの日,ひと、われらが災,わざわいにあった多,おおくの年,としとに比,くらべて、われらを楽,たのしませてください。","tok":[["あなた"],["が"],["われ"],["ら"],["を"],["苦しめられた","くるしめられた"],["多く","おおく"],["の"],["日","ひ"],["と"],["、"],["われ"],["ら"],["が"],["災","わざわい"],["に"],["あった"],["多く","おおく"],["の"],["年","とし"],["と"],["に"],["比べて","くらべて"],["、"],["われ"],["ら"],["を"],["楽しませて","たのしませて"],["ください"],["。"]]},{"verse":16,"text":"あなたのみわざを、あなたのしもべらに、あなたの栄光,えいこうを、その子,こらにあらわしてください。","tok":[["あなた"],["のみ"],["わざ"],["を"],["、"],["あなた"],["の"],["しもべ"],["ら"],["に"],["、"],["あなた"],["の"],["栄光","えいこう"],["を"],["、"],["その"],["子","こ"],["ら"],["に"],["あらわして"],["ください"],["。"]]},{"verse":17,"text":"われらの神,かみ、主,しゅの恵,めぐみを、われらの上,うえにくだし、われらの手,てのわざを、われらの上,うえに栄,さかえさせてください。われらの手,てのわざを栄,さかえさせてください。","tok":[["われ"],["ら"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["恵","めぐみ"],["を"],["、"],["われ"],["ら"],["の"],["上","うえ"],["に"],["くだし"],["、"],["われ"],["ら"],["の"],["手","て"],["の"],["わざ"],["を"],["、"],["われ"],["ら"],["の"],["上","うえ"],["に"],["栄","さかえ"],["させて"],["ください"],["。"],["われ"],["ら"],["の"],["手","て"],["の"],["わざ"],["を"],["栄","さかえ"],["させて"],["ください"],["。"]]}]
[{"verse":1,"text":"[0]【ダビデの歌,うた、さんび】","tok":[["["],["0"],["]"],["【"],["ダビデ"],["の"],["歌","うた"],["、"],["さん"],["び"],["】"]]},{"verse":2,"text":"[1]神,かみよ、わが心,こころは定,さだまりました。わが心,こころは定,さだまりました。わたしは歌,うたい、かつほめたたえます。わが魂,たましいよ、さめよ。","tok":[["["],["1"],["]"],["神","かみ"],["よ"],["、"],["わが"],["心","こころ"],["は"],["定まりました","さだまりました"],["。"],["わが"],["心","こころ"],["は"],["定まりました","さだまりました"],["。"],["わたし"],["は"],["歌い","うたい"],["、"],["かつ"],["ほめたたえます"],["。"],["わが"],["魂","たましい"],["よ"],["、"],["さめ"],["よ"],["。"]]},{"verse":3,"text":"[2]立琴,たてごとよ、琴,ことよ、さめよ。わたしはしののめを呼,よびさまします。","tok":[["["],["2"],["]"],["立琴","たてごと"],["よ"],["、"],["琴","こと"],["よ"],["、"],["さめ"],["よ"],["。"],["わたし"],["は"],["しののめ"],["を"],["呼びさまします","よびさまします"],["。"]]},{"verse":4,"text":"[3]主,しゅよ、わたしはもろもろの民,たみの中,なかであなたに感謝,かんしゃし、もろもろの国,くにの中,なかであなたをほめたたえます。","tok":[["["],["3"],["]"],["主","しゅ"],["よ"],["、"],["わたし"],["は"],["もろもろ"],["の"],["民","たみ"],["の"],["中","なか"],["で"],["あなた"],["に"],["感謝","かんしゃ"],["し"],["、"],["もろもろ"],["の"],["国","くに"],["の"],["中","なか"],["で"],["あなた"],["を"],["ほめたたえます"],["。"]]},{"verse":5,"text":"[4]あなたのいつくしみは大,おおきく、天,てんにまでおよびあなたのまことは雲,くもにまで及,およぶ。","tok":[["["],["4"],["]"],["あなた"],["の"],["いつくしみ"],["は"],["大きく","おおきく"],["、"],["天","てん"],["に"],["まで"],["および"],["あなた"],["の"],["まこと"],["は"],["雲","くも"],["に"],["まで"],["及ぶ","およぶ"],["。"]]},{"verse":6,"text":"[5]神,かみよ、みずからを天,てんよりも高,たかくし、みさかえを全,ぜん地,ちの上,うえにあげてください。","tok":[["["],["5"],["]"],["神","かみ"],["よ"],["、"],["みずから"],["を"],["天","てん"],["より"],["も"],["高かく","たかく"],["し"],["、"],["みさか"],["え"],["を"],["全地","ぜんち"],["の"],["上","うえ"],["に"],["あげて"],["ください"],["。"]]},{"verse":7,"text":"[6]あなたの愛,あいされる者,ものが助,たすけを得,えるために、右,みぎのみ手,てをもって救,すくいをほどこし、わたしに答,こたえてください。","tok":[["["],["6"],["]"],["あなた"],["の"],["愛される","あいされる"],["者","もの"],["が"],["助け","たすけ"],["を"],["得る","える"],["ため"],["に"],["、"],["右","みぎ"],["のみ"],["手","て"],["を"],["もって"],["救い","すくい"],["を"],["ほどこし"],["、"],["わたし"],["に"],["答","こたえ"],["て"],["ください"],["。"]]},{"verse":8,"text":"[7]神,かみはその聖所,せいじょで言,いわれた、「わたしは大,おおいなる喜,よろこびをもってシケムを分,わかち、スコテの谷,たにを分,わかち与,あたえよう。","tok":[["["],["7"],["]"],["神","かみ"],["は"],["その"],["聖","せい"],["所","しょ"],["い"],["じょ"],["で"],["言われた","いわれた"],["、"],["「"],["わたし"],["は"],["大いなる","おおいなる"],["喜こび","よろこび"],["を"],["もって"],["シケム"],["を"],["分かち","わかち"],["、"],["スコテ"],["の"],["谷","たに"],["を"],["分かち","わかち"],["与","あたえ"],["よう"],["。"]]},{"verse":9,"text":"[8]ギレアデはわたしのもの、マナセもわたしのものである。エフライムはわたしのかぶと、ユダはわたしのつえである。","tok":[["["],["8"],["]"],["ギレアデ"],["は"],["わたし"],["の"],["もの"],["、"],["マナセ"],["も"],["わたし"],["の"],["もの"],["で"],["ある"],["。"],["エフライム"],["は"],["わたし"],["の"],["かぶ"],["と"],["、"],["ユダ"],["は"],["わたし"],["の"],["つえ"],["で"],["ある"],["。"]]},{"verse":10,"text":"[9]モアブはわたしの足,あしだらい、エドムにはわたしのくつを投,なげる。ペリシテについては、かちどきをあげる」。","tok":[["["],["9"],["]"],["モアブ"],["は"],["わたし"],["の"],["足","あし"],["だらい"],["、"],["エドム"],["に"],["は"],["わたし"],["の"],["くつ"],["を"],["投る","なげる"],["。"],["ペリシテ"],["について"],["は"],["、"],["かちどき"],["を"],["あげる"],["」"],["。"]]},{"verse":11,"text":"[10]だれがわたしを堅固,けんごな町,まちに至,いたらせるであろうか。だれがわたしをエドムに導,みちびくであろうか。","tok":[["["],["10"],["]"],["だれ"],["が"],["わたし"],["を"],["堅固","けんご"],["な"],["町","まち"],["に"],["至らせるで","いたらせるで"],["あろう"],["か"],["。"],["だれ"],["が"],["わたし"],["を"],["エドム"],["に"],["導くで","みちびくで"],["あろう"],["か"],["。"]]},{"verse":12,"text":"[11]神,かみよ、あなたはわれらを捨,すてられたではありませんか。神,かみよ、あなたはわれらの軍勢,ぐんぜいと共,ともに出,でて行,いかれません。","tok":[["["],["11"],["]"],["神","かみ"],["よ"],["、"],["あなた"],["は"],["われ"],["ら"],["を"],["捨てられたで","すてられたで"],["は"],["ありません"],["か"],["。"],["神","かみ"],["よ"],["、"],["あなた"],["は"],["われ"],["ら"],["の"],["軍勢","ぐんぜい"],["と"],["共","とも"],["に"],["出て","でて"],["行かれません","いかれません"],["。"]]},{"verse":13,"text":"[12]われらに助,たすけを与,あたえて、あだにむかわせてください。人,ひとの助,たすけはむなしいからです。","tok":[["["],["12"],["]"],["われ"],["ら"],["に"],["助け","たすけ"],["を"],["与","あたえ"],["て"],["、"],["あだ"],["に"],["むかわせて"],["ください"],["。"],["人","ひと"],["の"],["助け","たすけ"],["は"],["むなしい"],["から"],["です"],["。"]]},{"verse":14,"text":"[13]われらは神,かみによって勇,いさましく働,はたらきます。われらのあだを踏,ふみにじる者,ものは神,かみだからです。","tok":[["["],["13"],["]"],["われ"],["ら"],["は"],["神","かみ"],["によって"],["勇ましく","いさましく"],["働らき","はたらき"],["ます"],["。"],["われ"],["ら"],["の"],["あだ"],["を"],["踏みにじる","ふみにじる"],["者","もの"],["は"],["神","かみ"],["だ"],["から"],["です"],["。"]]}]
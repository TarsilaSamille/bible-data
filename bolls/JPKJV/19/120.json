[{"verse":1,"text":"【都,みやこもうでの歌,うた】わたしが悩,なやみのうちに、主,しゅに呼,よばわると、主,しゅはわたしに答,こたえられる。","tok":[["【"],["都","みやこもう"],["で"],["の"],["歌","うた"],["】"],["わたし"],["が"],["悩み","なやみ"],["の"],["うち"],["に"],["、"],["主に","しゅに"],["呼ばわる","よばわる"],["と"],["、"],["主","しゅ"],["は"],["わたし"],["に"],["答","こたえ"],["られる"],["。"]]},{"verse":2,"text":"「主,しゅよ、偽,いつわりのくちびるから、欺,あざむきの舌,したから、わたしを助,たすけ出,だしてください」。","tok":[["「"],["主","しゅ"],["よ"],["、"],["偽わり","いつわり"],["の"],["くちびる"],["から"],["、"],["欺き","あざむき"],["の"],["舌","した"],["から"],["、"],["わたし"],["を"],["助け出して","たすけだして"],["ください"],["」"],["。"]]},{"verse":3,"text":"欺,あざむきの舌,したよ、おまえに何,なにが与,あたえられ、何,なにが加,くわえられるであろうか。","tok":[["欺き","あざむき"],["の"],["舌","した"],["よ"],["、"],["おまえ"],["に"],["何に","なに"],["が"],["与えられ","あたえられ"],["、"],["何に","なに"],["が"],["加えられるで","くわえられるで"],["あろう"],["か"],["。"]]},{"verse":4,"text":"ますらおの鋭,するどい矢,やと、えにしだの熱,あつい炭,すみとである。","tok":[["ますらお"],["の"],["鋭い","するどい"],["矢","や"],["と"],["、"],["えにし"],["だ"],["の"],["熱い","あつい"],["炭","すみ"],["と"],["で"],["ある"],["。"]]},{"verse":5,"text":"わざわいなるかな、わたしはメセクにやどり、ケダルの天幕,てんまくのなかに住,すんでいる。","tok":[["わざわい"],["なる"],["か"],["な"],["、"],["わたし"],["は"],["メセク"],["に"],["やどり"],["、"],["ケダル"],["の"],["天幕","てんまく"],["の"],["なか"],["に"],["住んで","すんで"],["いる"],["。"]]},{"verse":6,"text":"わたしは久,ひさしく平安,へいあんを憎,にくむ者,もののなかに住,すんでいた。","tok":[["わたし"],["は"],["久く","ひさしく"],["平安","へいあん"],["を"],["憎む","にくむ"],["者","もの"],["の"],["なか"],["に"],["住んで","すんで"],["いた"],["。"]]},{"verse":7,"text":"わたしは平安,へいあんを願,ねがう、しかし、わたしが物言,ものいうとき、彼,かれらは戦,たたかいを好,このむ。","tok":[["わたし"],["は"],["平安","へいあん"],["を"],["願う","ねがう"],["、"],["しかし"],["、"],["わたし"],["が"],["物","もの"],["言う","いう"],["とき"],["、"],["彼","かれ"],["ら"],["は"],["戦い","たたかい"],["を"],["好む","このむ"],["。"]]}]
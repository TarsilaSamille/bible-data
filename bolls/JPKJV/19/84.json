[{"verse":1,"text":"[0]【聖歌,せいか隊,たいの指揮者,しきしゃによってギテトのしらべにあわせてうたわせたコラの子,この歌,うた】","tok":[["["],["0"],["]"],["【"],["聖歌隊","せいかたい"],["の"],["指揮者","しきしゃ"],["によって"],["ギテト"],["の"],["しらべ"],["に"],["あわせて"],["うたわせた"],["コラ"],["の"],["子","こ"],["の"],["歌","うた"],["】"]]},{"verse":2,"text":"[1]万軍,ばんぐんの主,しゅよ、あなたのすまいはいかに麗,うるわしいことでしょう。","tok":[["["],["1"],["]"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["よ"],["、"],["あなた"],["の"],["すまい"],["は"],["いかに"],["麗わしい","うるわしい"],["こと"],["でしょう"],["。"]]},{"verse":3,"text":"[2]わが魂,たましいは絶,たえいるばかりに主,しゅの大庭,おおにわを慕,したい、わが心,こころとわが身,みは生,いける神,かみにむかって喜,よろこび歌,うたいます。","tok":[["["],["2"],["]"],["わが"],["魂","たましい"],["は"],["絶え","たえ"],["いる"],["ばかり"],["に"],["主","しゅ"],["の"],["大庭","おおにわ"],["を"],["慕い","したい"],["、"],["わが"],["心","こころ"],["と"],["わが"],["身","み"],["は"],["生ける","いける"],["神","かみ"],["に"],["むかって"],["喜こび","よろこび"],["歌います","うたいます"],["。"]]},{"verse":4,"text":"[3]すずめがすみかを得,え、つばめがそのひなをいれる巣,すを得,えるように、万軍,ばんぐんの主,しゅ、わが王,おう、わが神,かみよ、あなたの祭壇,さいだんのかたわらにわがすまいを得,えさせてください。","tok":[["["],["3"],["]"],["すずめ"],["が"],["すみか"],["を"],["得","え"],["、"],["つばめ"],["が"],["その"],["ひな"],["を"],["いれる"],["巣","す"],["を"],["得る","える"],["よう"],["に"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["、"],["わが"],["王","おう"],["、"],["わが"],["神","かみ"],["よ"],["、"],["あなた"],["の"],["祭壇","さいだん"],["の"],["かたわら"],["に"],["わが"],["すまい"],["を"],["得させて","えさせて"],["ください"],["。"]]},{"verse":5,"text":"[4]あなたの家,いえに住,すみ、常,つねにあなたをほめたたえる人,ひとはさいわいです。〔セラ","tok":[["["],["4"],["]"],["あなた"],["の"],["家","いえ"],["に"],["住み","すみ"],["、"],["常","つね"],["に"],["あなた"],["を"],["ほめたたえる"],["人","ひと"],["は"],["さいわい"],["です"],["。"],["〔"],["セラ"]]},{"verse":6,"text":"[5]その力,ちからがあなたにあり、その心,こころがシオンの大路,おおじにある人,ひとはさいわいです。","tok":[["["],["5"],["]"],["その"],["力","ちから"],["が"],["あなた"],["に"],["あり"],["、"],["その"],["心","こころ"],["が"],["シオン"],["の"],["大路","おおじ"],["に"],["ある"],["人","ひと"],["は"],["さいわい"],["です"],["。"]]},{"verse":7,"text":"[6]彼,かれらはバカの谷,たにを通,とおっても、そこを泉,いずみのある所,ところとします。また前,まえの雨,あめは池,いけをもってそこをおおいます。","tok":[["["],["6"],["]"],["彼","かれ"],["ら"],["は"],["バカ"],["の"],["谷","たに"],["を"],["通って","とおって"],["も"],["、"],["そこ"],["を"],["泉","いずみ"],["の"],["ある"],["所","ところ"],["と"],["します"],["。"],["また"],["前","まえ"],["の"],["雨","あめ"],["は"],["池","いけ"],["を"],["もって"],["そこ"],["を"],["おおいます"],["。"]]},{"verse":8,"text":"[7]彼,かれらは力,ちからから力,ちからに進,すすみ、シオンにおいて神々,かみがみの神,かみにまみえるでしょう。","tok":[["["],["7"],["]"],["彼","かれ"],["ら"],["は"],["力","ちから"],["から"],["力","ちから"],["に"],["進み","すすみ"],["、"],["シオン"],["に"],["おいて"],["神々","かみがみ"],["の"],["神","かみ"],["に"],["まみえるでしょう"],["。"]]},{"verse":9,"text":"[8]万軍,ばんぐんの神,かみ、主,しゅよ、わが祈,いのりをおききください。ヤコブの神,かみよ、耳,みみを傾,かたむけてください。〔セラ","tok":[["["],["8"],["]"],["万","まん"],["軍","ぐん"],["の"],["神","かみ"],["、"],["主","しゅ"],["よ"],["、"],["わが"],["祈","いのり"],["を"],["おきき"],["ください"],["。"],["ヤコブ"],["の"],["神","かみ"],["よ"],["、"],["耳","みみ"],["を"],["傾むけて","かたむけて"],["ください"],["。"],["〔"],["セラ"]]},{"verse":10,"text":"[9]神,かみよ、われらの盾,たてをみそなわし、あなたの油,あぶらそそがれた者,ものの顔,かおをかえりみてください。","tok":[["["],["9"],["]"],["神","かみ"],["よ"],["、"],["われ"],["ら"],["の"],["盾","たて"],["を"],["みそ"],["な"],["わし"],["、"],["あなた"],["の"],["油","あぶら"],["そそがれた"],["者","もの"],["の"],["顔","かお"],["を"],["かえりみて"],["ください"],["。"]]},{"verse":11,"text":"[10]あなたの大庭,おおにわにいる一日,にちは、よそにいる千日,にちにもまさるのです。わたしは悪,あくの天幕,てんまくにいるよりは、むしろ、わが神,かみの家,いえの門守,かどもりとなることを願,ねがいます。","tok":[["["],["10"],["]"],["あなた"],["の"],["大庭","おおにわ"],["に"],["いる"],["一","いち"],["日","にち"],["は"],["、"],["よそ"],["に"],["いる"],["千","せん"],["日","にち"],["に"],["も"],["まさる"],["の"],["です"],["。"],["わたし"],["は"],["悪","あく"],["の"],["天幕","てんまく"],["に"],["いる"],["より"],["は"],["、"],["むしろ"],["、"],["わが"],["神","かみ"],["の"],["家","いえ"],["の"],["門守","かどもり"],["と"],["なる"],["こと"],["を"],["願います","ねがいます"],["。"]]},{"verse":12,"text":"[11]主,しゅなる神,かみは日,ひです、盾,たてです。主,しゅは恵,めぐみと誉,ほまれとを与,あたえ、直,なおく歩,あゆむ者,ものに良,よい物,ものを拒,こばまれることはありません。","tok":[["["],["11"],["]"],["主","しゅ"],["なる"],["神","かみ"],["は"],["日","ひ"],["です"],["、"],["盾","たて"],["です"],["。"],["主","しゅ"],["は"],["恵","めぐみ"],["と"],["誉","ほまれ"],["と"],["を"],["与","あたえ"],["、"],["直","な"],["おく"],["歩む","あゆむ"],["者","もの"],["に"],["良い","よい"],["物","もの"],["を"],["拒まれる","こばまれる"],["こと"],["は"],["ありません"],["。"]]},{"verse":13,"text":"[12]万軍,ばんぐんの主,しゅよ、あなたに信頼,しんらいする人,ひとはさいわいです。","tok":[["["],["12"],["]"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["よ"],["、"],["あなた"],["に"],["信頼","しんらい"],["する"],["人","ひと"],["は"],["さいわい"],["です"],["。"]]}]
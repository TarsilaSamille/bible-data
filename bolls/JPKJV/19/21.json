[{"verse":1,"text":"[0]【聖歌,せいか隊,たいの指揮者,しきしゃによってうたわせたダビデの歌,うた】","tok":[["["],["0"],["]"],["【"],["聖歌隊","せいかたい"],["の"],["指揮者","しきしゃ"],["によって"],["うたわせた"],["ダビデ"],["の"],["歌","うた"],["】"]]},{"verse":2,"text":"[1]主,しゅよ、王,おうはあなたの力,ちからによって喜,よろこび、あなたの助,たすけによって、いかに大,おおきな喜,よろこびをもつことでしょう。","tok":[["["],["1"],["]"],["主","しゅ"],["よ"],["、"],["王","おう"],["は"],["あなた"],["の"],["力","ちから"],["によって"],["喜こび","よろこび"],["、"],["あなた"],["の"],["助け","たすけ"],["によって"],["、"],["いかに"],["大きな","おおきな"],["喜こび","よろこび"],["を"],["もつ"],["こと"],["でしょう"],["。"]]},{"verse":3,"text":"[2]あなたは彼,かれの心,こころの願,ねがいをゆるし、そのくちびるの求,もとめをいなまれなかった。〔セラ","tok":[["["],["2"],["]"],["あなた"],["は"],["彼","かれ"],["の"],["心","こころ"],["の"],["願い","ねがい"],["を"],["ゆるし"],["、"],["その"],["くちびる"],["の"],["求め","もとめ"],["を"],["いなまれなかった"],["。"],["〔"],["セラ"]]},{"verse":4,"text":"[3]あなたは大,おおいなる恵,めぐみをもって彼,かれを迎,むかえ、そのかしらに純金,じゅんきんの冠,かんむりをいただかせられる。","tok":[["["],["3"],["]"],["あなた"],["は"],["大いなる","おおいなる"],["恵","めぐみ"],["を"],["もって"],["彼","かれ"],["を"],["迎","むかえ"],["、"],["その"],["かしら"],["に"],["純金","じゅんきん"],["の"],["冠","かんむり"],["を"],["いただかせられる"],["。"]]},{"verse":5,"text":"[4]彼,かれがいのちを求,もとめると、あなたはそれを彼,かれにさずけ、世々,よよ限,かぎりなくそのよわいを長,ながくされた。","tok":[["["],["4"],["]"],["彼","かれ"],["が"],["いのち"],["を"],["求める","もとめる"],["と"],["、"],["あなた"],["は"],["それ"],["を"],["彼","かれ"],["に"],["さずけ"],["、"],["世々","よ"],["よ"],["限","かぎり"],["なく"],["その"],["よわい"],["を"],["長く","ながく"],["された"],["。"]]},{"verse":6,"text":"[5]あなたの助,たすけによって彼,かれの栄光,えいこうは大,おおきい。あなたは誉,ほまれと威厳,いげんとを彼,かれに与,あたえられる。","tok":[["["],["5"],["]"],["あなた"],["の"],["助け","たすけ"],["によって"],["彼","かれ"],["の"],["栄光","えいこう"],["は"],["大きい","おおきい"],["。"],["あなた"],["は"],["誉","ほまれ"],["と"],["威厳","いげん"],["と"],["を"],["彼","かれ"],["に"],["与えられる","あたえられる"],["。"]]},{"verse":7,"text":"[6]まことに、あなたは彼,かれをとこしえに恵,めぐまれた者,ものとし、み前,まえに喜,よろこびをもって楽,たのしませられる。","tok":[["["],["6"],["]"],["まこと"],["に"],["、"],["あなた"],["は"],["彼","かれ"],["を"],["とこしえ"],["に"],["恵れた","めぐまれた"],["者","もの"],["と"],["し"],["、"],["み前","みまえ"],["に"],["喜こび","よろこび"],["を"],["もって"],["楽しませられる","たのしませられる"],["。"]]},{"verse":8,"text":"[7]王,おうは主,しゅに信頼,しんらいするゆえ、いと高,たかき者,もののいつくしみをこうむって、動,うごかされることはない。","tok":[["["],["7"],["]"],["王","おう"],["は"],["主に","しゅに"],["信頼","しんらい"],["する"],["ゆえ"],["、"],["いと"],["高き","たかき"],["者","もの"],["の"],["いつくしみ"],["を"],["こうむって"],["、"],["動かされる","うごかされる"],["こと"],["は"],["ない"],["。"]]},{"verse":9,"text":"[8]あなたの手,てはもろもろの敵,てきを尋,たずね出,だし、あなたの右,みぎの手,てはあなたを憎,にくむ者,ものを尋,たずね出,だすであろう。","tok":[["["],["8"],["]"],["あなた"],["の"],["手","て"],["は"],["もろもろ"],["の"],["敵","てき"],["を"],["尋ね出し","たずねだし"],["、"],["あなた"],["の"],["右","みぎ"],["の"],["手","て"],["は"],["あなた"],["を"],["憎む","にくむ"],["者","もの"],["を"],["尋ね出すで","たずねだすで"],["あろう"],["。"]]},{"verse":10,"text":"[9]あなたが怒,いかる時,とき、彼,かれらを燃,もえる炉,ろのようにするであろう。主,しゅはみ怒,いかりによって彼,かれらをのみつくされる。火,ひは彼,かれらを食,くいつくすであろう。","tok":[["["],["9"],["]"],["あなた"],["が"],["怒","い"],["かる"],["時","とき"],["、"],["彼","かれ"],["ら"],["を"],["燃える","もえる"],["炉","ろ"],["の"],["よう"],["に"],["するで"],["あろう"],["。"],["主","しゅ"],["は"],["み怒り","みいかり"],["によって"],["彼","かれ"],["ら"],["を"],["のみ"],["つくされる"],["。"],["火","ひ"],["は"],["彼","かれ"],["ら"],["を"],["食い","くい"],["つくすで"],["あろう"],["。"]]},{"verse":11,"text":"[10]あなたは彼,かれらのすえを地,ちから断,たち、彼,かれらの種,たねを人,ひとの子,こらの中,なかから滅,ほろぼすであろう。","tok":[["["],["10"],["]"],["あなた"],["は"],["彼","かれ"],["ら"],["の"],["すえ"],["を"],["地","ち"],["から"],["断ち","たち"],["、"],["彼","かれ"],["ら"],["の"],["種","たね"],["を"],["人","ひと"],["の"],["子","こ"],["ら"],["の"],["中","なか"],["から"],["滅ぼすで","ほろぼすで"],["あろう"],["。"]]},{"verse":12,"text":"[11]たとい彼,かれらがあなたにむかって悪,わるい事,ことを企,くわだて、悪,わるいはかりごとを思,おもいめぐらしても、なし遂,とげることはできない。","tok":[["["],["11"],["]"],["たとい"],["彼","かれ"],["ら"],["が"],["あなた"],["に"],["むかって"],["悪い","わるい"],["事","こと"],["を"],["企だて","くわだて"],["、"],["悪い","わるい"],["はかりごと"],["を"],["思いめぐらして","おもいめぐらして"],["も"],["、"],["なし遂げる","なしとげる"],["こと"],["は"],["できない"],["。"]]},{"verse":13,"text":"[12]あなたは彼,かれらを逃,にげ走,はしらせ、あなたの弓弦,ゆみづるを張,はって、彼,かれらの顔,かおをねらうであろう。","tok":[["["],["12"],["]"],["あなた"],["は"],["彼","かれ"],["ら"],["を"],["逃","にげ"],["走らせ","はしらせ"],["、"],["あなた"],["の"],["弓弦","ゆみづる"],["を"],["張って","はって"],["、"],["彼","かれ"],["ら"],["の"],["顔","かお"],["を"],["ねらうで"],["あろう"],["。"]]},{"verse":14,"text":"[13]主,しゅよ、力,ちからをあらわして、みずからを高,たかくしてください。われらはあなたの大能,たいのうをうたい、かつほめたたえるでしょう。","tok":[["["],["13"],["]"],["主","しゅ"],["よ"],["、"],["力","ちから"],["を"],["あらわして"],["、"],["みずから"],["を"],["高かく","たかく"],["して"],["ください"],["。"],["われ"],["ら"],["は"],["あなた"],["の"],["大能","たいのう"],["を"],["うたい"],["、"],["かつ"],["ほめたたえるでしょう"],["。"]]}]
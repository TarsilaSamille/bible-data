[{"verse":1,"text":"[0]【聖歌,せいか隊,たいの指揮者,しきしゃによって琴,ことにあわせてうたわせたダビデの歌,うた】","tok":[["["],["0"],["]"],["【"],["聖歌隊","せいかたい"],["の"],["指揮者","しきしゃ"],["によって"],["琴","こと"],["に"],["あわせて"],["うたわせた"],["ダビデ"],["の"],["歌","うた"],["】"]]},{"verse":2,"text":"[1]神,かみよ、わたしの叫,さけびを聞,きいてください。わたしの祈,いのりに耳,みみを傾,かたむけてください。","tok":[["["],["1"],["]"],["神","かみ"],["よ"],["、"],["わたし"],["の"],["叫","さけび"],["を"],["聞いて","きいて"],["ください"],["。"],["わたし"],["の"],["祈","いのり"],["に"],["耳","みみ"],["を"],["傾むけて","かたむけて"],["ください"],["。"]]},{"verse":3,"text":"[2]わが心,こころのくずおれるとき、わたしは地,ちのはてからあなたに呼,よばわります。わたしを導,みちびいてわたしの及,およびがたいほどの高,たかい岩,いわにのぼらせてください。","tok":[["["],["2"],["]"],["わが"],["心","こころ"],["の"],["くずおれる"],["とき"],["、"],["わたし"],["は"],["地","ち"],["の"],["はて"],["から"],["あなた"],["に"],["呼ばわります","よばわります"],["。"],["わたし"],["を"],["導いて","みちびいて"],["わたし"],["の"],["及","および"],["がたい"],["ほど"],["の"],["高い","たかい"],["岩","いわ"],["に"],["のぼらせて"],["ください"],["。"]]},{"verse":4,"text":"[3]あなたはわたしの避,さけ所,どころ、敵,てきに対,たいする堅固,けんごなやぐらです。","tok":[["["],["3"],["]"],["あなた"],["は"],["わたし"],["の"],["避け","さけ"],["所","ど"],["ころ"],["、"],["敵","てき"],["に"],["対する","たいする"],["堅固","けんご"],["な"],["やぐら"],["です"],["。"]]},{"verse":5,"text":"[4]わたしをとこしえにあなたの幕屋,まくやに住,すまわせ、あなたの翼,つばさの陰,かげにのがれさせてください。〔セラ","tok":[["["],["4"],["]"],["わたし"],["を"],["とこしえ"],["に"],["あなた"],["の"],["幕屋","まくや"],["に"],["住まわせ","すまわせ"],["、"],["あなた"],["の"],["翼","つばさ"],["の"],["陰","かげ"],["に"],["のがれさせて"],["ください"],["。"],["〔"],["セラ"]]},{"verse":6,"text":"[5]神,かみよ、あなたはわたしのもろもろの誓,ちかいを聞,きき、み名,なを恐,おそれる者,ものに賜,たまわる嗣,し業,ぎょうをわたしに与,あたえられました。","tok":[["["],["5"],["]"],["神","かみ"],["よ"],["、"],["あなた"],["は"],["わたし"],["の"],["もろもろ"],["の"],["誓い","ちかい"],["を"],["聞","きき"],["、"],["み名","みな"],["を"],["恐れる","おそれる"],["者","もの"],["に"],["賜わる","たまわる"],["嗣業","しぎょう"],["を"],["わたし"],["に"],["与えられました","あたえられました"],["。"]]},{"verse":7,"text":"[6]どうか王,おうのいのちを延,のばし、そのよわいをよろずよに至,いたらせてください。","tok":[["["],["6"],["]"],["どう"],["か"],["王","おう"],["の"],["いのち"],["を"],["延ばし","のばし"],["、"],["その"],["よわい"],["を"],["よろず"],["よ"],["に"],["至らせて","いたらせて"],["ください"],["。"]]},{"verse":8,"text":"[7]彼,かれをとこしえに神,かみの前,まえに王,おうたらしめ、いつくしみとまこととに命,めいじて彼,かれを守,まもらせてください。","tok":[["["],["7"],["]"],["彼","かれ"],["を"],["とこしえ"],["に"],["神","かみ"],["の"],["前","まえ"],["に"],["王","おう"],["たらしめ"],["、"],["いつくしみ"],["と"],["まこと"],["と"],["に"],["命じて","めいじて"],["彼","かれ"],["を"],["守らせて","まもらせて"],["ください"],["。"]]},{"verse":9,"text":"[8]そうすればわたしはとこしえにみ名,なをほめうたい、日,ひごとにわたしのもろもろの誓,ちかいを果,はたすでしょう。","tok":[["["],["8"],["]"],["そう"],["すれば"],["わたし"],["は"],["とこしえ"],["に"],["み名","みな"],["を"],["ほめ"],["うたい"],["、"],["日ごと","ひごと"],["に"],["わたし"],["の"],["もろもろ"],["の"],["誓い","ちかい"],["を"],["果たすでしょう","はたすでしょう"],["。"]]}]
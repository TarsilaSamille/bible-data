[{"verse":1,"text":"【聖歌,せいか隊,たいの指揮者,しきしゃによってうたわせたダビデの歌,うた】主,しゅよ、あなたはわたしを探,さぐり、わたしを知,しりつくされました。","tok":[["【"],["聖歌隊","せいかたい"],["の"],["指揮者","しきしゃ"],["によって"],["うたわせた"],["ダビデ"],["の"],["歌","うた"],["】"],["主","しゅ"],["よ"],["、"],["あなた"],["は"],["わたし"],["を"],["探ぐり","さぐり"],["、"],["わたし"],["を"],["知り","しり"],["つくされました"],["。"]]},{"verse":2,"text":"あなたはわがすわるをも、立,たつをも知,しり、遠,とおくからわが思,おもいをわきまえられます。","tok":[["あなた"],["は"],["わが"],["すわる"],["を"],["も"],["、"],["立つ","たつ"],["を"],["も"],["知り","しり"],["、"],["遠く","とおく"],["から"],["わが"],["思い","おもい"],["を"],["わきまえられます"],["。"]]},{"verse":3,"text":"あなたはわが歩,あゆむをも、伏,ふすをも探,さぐり出,だし、わがもろもろの道,みちをことごとく知,しっておられます。","tok":[["あなた"],["は"],["わが"],["歩む","あゆむ"],["を"],["も"],["、"],["伏す","ふす"],["を"],["も"],["探ぐり","さぐり"],["出し","だし"],["、"],["わが"],["もろもろ"],["の"],["道","みち"],["を"],["ことごとく"],["知って","しって"],["おられます"],["。"]]},{"verse":4,"text":"わたしの舌,したに一言,ひとこともないのに、主,しゅよ、あなたはことごとくそれを知,しられます。","tok":[["わたし"],["の"],["舌","した"],["に"],["一言","ひとこと"],["も"],["ない"],["のに"],["、"],["主","しゅ"],["よ"],["、"],["あなた"],["は"],["ことごとく"],["それ"],["を"],["知られます","しられます"],["。"]]},{"verse":5,"text":"あなたは後,のちから、前,まえからわたしを囲,かこみ、わたしの上,うえにみ手,てをおかれます。","tok":[["あなた"],["は"],["後","のちか"],["ら"],["、"],["前","まえ"],["から"],["わたし"],["を"],["囲み","かこみ"],["、"],["わたし"],["の"],["上","うえ"],["に"],["み手","みて"],["を"],["おかれます"],["。"]]},{"verse":6,"text":"このような知識,ちしきはあまりに不思議,ふしぎで、わたしには思,おもいも及,およびません。これは高,たかくて達,たっすることはできません。","tok":[["この"],["よう"],["な"],["知識","ちしき"],["は"],["あまり"],["に"],["不思議","ふしぎ"],["で"],["、"],["わたし"],["に"],["は"],["思い","おもい"],["も"],["及","および"],["ません"],["。"],["これ"],["は"],["高かくて","たかくて"],["達する","たっする"],["こと"],["は"],["できません"],["。"]]},{"verse":7,"text":"わたしはどこへ行,いって、あなたのみたまを離,はなれましょうか。わたしはどこへ行,いって、あなたのみ前,まえをのがれましょうか。","tok":[["わたし"],["は"],["どこ"],["へ"],["行って","いって"],["、"],["あなた"],["の"],["みたま"],["を"],["離れましょう","はなれましょう"],["か"],["。"],["わたし"],["は"],["どこ"],["へ"],["行って","いって"],["、"],["あなた"],["のみ"],["前","まえ"],["を"],["のがれましょう"],["か"],["。"]]},{"verse":8,"text":"わたしが天,てんにのぼっても、あなたはそこにおられます。わたしが陰府,よみに床,とこを設,もうけても、あなたはそこにおられます。","tok":[["わたし"],["が"],["天","てん"],["に"],["のぼって"],["も"],["、"],["あなた"],["は"],["そこ"],["に"],["おられます"],["。"],["わたし"],["が"],["陰府","よみ"],["に"],["床","とこ"],["を"],["設けて","もうけて"],["も"],["、"],["あなた"],["は"],["そこ"],["に"],["おられます"],["。"]]},{"verse":9,"text":"わたしがあけぼのの翼,つばさをかって海,うみのはてに住,すんでも、","tok":[["わたし"],["が"],["あけぼの"],["の"],["翼","つばさ"],["を"],["かって"],["海","うみ"],["の"],["はて"],["に"],["住","すん"],["で"],["も"],["、"]]},{"verse":10,"text":"あなたのみ手,てはその所,ところでわたしを導,みちびき、あなたの右,みぎのみ手,てはわたしをささえられます。","tok":[["あなた"],["のみ"],["手","て"],["は"],["その"],["所","ところ"],["で"],["わたし"],["を"],["導き","みちびき"],["、"],["あなた"],["の"],["右","みぎ"],["のみ"],["手","て"],["は"],["わたし"],["を"],["ささえられます"],["。"]]},{"verse":11,"text":"「やみはわたしをおおい、わたしを囲,かこむ光,ひかりは夜,よるとなれ」とわたしが言,いっても、","tok":[["「"],["やみ"],["は"],["わたし"],["を"],["おおい"],["、"],["わたし"],["を"],["囲む","かこむ"],["光","ひかり"],["は"],["夜","よる"],["と"],["なれ"],["」"],["と"],["わたし"],["が"],["言って","いって"],["も"],["、"]]},{"verse":12,"text":"あなたには、やみも暗,くらくはなく、夜,よるも昼,ひるのように輝,かがやきます。あなたには、やみも光,ひかりも異,ことなることはありません。","tok":[["あなた"],["に"],["は"],["、"],["やみ"],["も"],["暗く","くらく"],["は"],["なく"],["、"],["夜","よる"],["も"],["昼","ひる"],["の"],["よう"],["に"],["輝やきます","かがやきます"],["。"],["あなた"],["に"],["は"],["、"],["やみ"],["も"],["光","ひかり"],["も"],["異なる","ことなる"],["こと"],["は"],["ありません"],["。"]]},{"verse":13,"text":"あなたはわが内臓,ないぞうをつくり、わが母,ははの胎内,たいないでわたしを組,くみ立,たてられました。","tok":[["あなた"],["は"],["わが"],["内臓","ないぞう"],["を"],["つくり"],["、"],["わが"],["母","はは"],["の"],["胎内","たいない"],["で"],["わたし"],["を"],["組立","くみたて"],["られました"],["。"]]},{"verse":14,"text":"わたしはあなたをほめたたえます。あなたは恐,おそれるべく、くすしき方,かただからです。あなたのみわざはくすしく、あなたは最,もっともよくわたしを知,しっておられます。","tok":[["わたし"],["は"],["あなた"],["を"],["ほめたたえます"],["。"],["あなた"],["は"],["恐れるべく","おそれるべく"],["、"],["くす"],["しき"],["方","かた"],["だ"],["から"],["です"],["。"],["あなた"],["のみ"],["わざ"],["は"],["くす"],["しく"],["、"],["あなた"],["は"],["最も","もっとも"],["よく"],["わたし"],["を"],["知って","しって"],["おられます"],["。"]]},{"verse":15,"text":"わたしが隠,かくれた所,ところで造,つくられ、地,ちの深,ふかい所,ところでつづり合,あわされたとき、わたしの骨,ほねはあなたに隠,かくれることがなかった。","tok":[["わたし"],["が"],["隠れた","かくれた"],["所","ところ"],["で"],["造られ","つくられ"],["、"],["地","ち"],["の"],["深い","ふかい"],["所","ところ"],["で"],["つづり合わされた","つづりあわされた"],["とき"],["、"],["わたし"],["の"],["骨","ほね"],["は"],["あなた"],["に"],["隠れる","かくれる"],["こと"],["が"],["なかった"],["。"]]},{"verse":16,"text":"あなたの目,めは、まだできあがらないわたしのからだを見,みられた。わたしのためにつくられたわがよわいの日,ひのまだ一日,にちもなかったとき、その日,ひはことごとくあなたの書,しょにしるされた。","tok":[["あなた"],["の"],["目","め"],["は"],["、"],["まだ"],["できあがらない"],["わたし"],["の"],["からだ"],["を"],["見られた","みられた"],["。"],["わたし"],["の"],["ため"],["に"],["つくられた"],["わが"],["よわい"],["の"],["日","ひ"],["の"],["まだ"],["一","いち"],["日","にち"],["も"],["なかった"],["とき"],["、"],["その"],["日","ひ"],["は"],["ことごとく"],["あなた"],["の"],["書","しょ"],["に"],["しるされた"],["。"]]},{"verse":17,"text":"神,かみよ、あなたのもろもろのみ思,おもいは、なんとわたしに尊,たっといことでしょう。その全体,ぜんたいはなんと広大,こうだいなことでしょう。","tok":[["神","かみ"],["よ"],["、"],["あなた"],["の"],["もろもろ"],["のみ"],["思い","おもい"],["は"],["、"],["なん"],["と"],["わたし"],["に"],["尊","た"],["っと"],["いこ"],["と"],["でしょう"],["。"],["その"],["全体","ぜんたい"],["は"],["なん"],["と"],["広大","こうだい"],["な"],["こと"],["でしょう"],["。"]]},{"verse":18,"text":"わたしがこれを数,かぞえようとすれば、その数,かずは砂,すなよりも多,おおい。わたしが目,めざめるとき、わたしはなおあなたと共,ともにいます。","tok":[["わたし"],["が"],["これ"],["を"],["数えよう","かぞえよう"],["と"],["すれば"],["、"],["その"],["数","かず"],["は"],["砂","すな"],["より"],["も"],["多い","おおい"],["。"],["わたし"],["が"],["目ざめる","めざめる"],["とき"],["、"],["わたし"],["は"],["なお"],["あなた"],["と"],["共","とも"],["に"],["います"],["。"]]},{"verse":19,"text":"神,かみよ、どうか悪,あしき者,ものを殺,ころしてください。血,ちを流,ながす者,ものをわたしから離,はなれ去,さらせてください。","tok":[["神","かみ"],["よ"],["、"],["どう"],["か"],["悪しき","あしき"],["者","もの"],["を"],["殺ろして","ころして"],["ください"],["。"],["血","ち"],["を"],["流す","ながす"],["者","もの"],["を"],["わたし"],["から"],["離れ去らせて","はなれさらせて"],["ください"],["。"]]},{"verse":20,"text":"彼,かれらは敵意,てきいをもってあなたをあなどり、あなたに逆,さからって高,たかぶり、悪,あくを行,おこなう人々,ひとびとです。","tok":[["彼","かれ"],["ら"],["は"],["敵意","てきい"],["を"],["もって"],["あなた"],["を"],["あなどり"],["、"],["あなた"],["に"],["逆らって","さからって"],["高か","たか"],["ぶり"],["、"],["悪","あく"],["を"],["行なう","おこなう"],["人々","ひとびと"],["です"],["。"]]},{"verse":21,"text":"主,しゅよ、わたしはあなたを憎,にくむ者,ものを憎,にくみ、あなたに逆,さからって起,おこり立,たつ者,ものをいとうではありませんか。","tok":[["主","しゅ"],["よ"],["、"],["わたし"],["は"],["あなた"],["を"],["憎む","にくむ"],["者","もの"],["を"],["憎み","にくみ"],["、"],["あなた"],["に"],["逆らって","さからって"],["起こり","おこり"],["立つ","たつ"],["者","もの"],["を"],["いとうで"],["は"],["ありません"],["か"],["。"]]},{"verse":22,"text":"わたしは全,まったく彼,かれらを憎,にくみ、彼,かれらをわたしの敵,てきと思,おもいます。","tok":[["わたし"],["は"],["全く","まったく"],["彼","かれ"],["ら"],["を"],["憎み","にくみ"],["、"],["彼","かれ"],["ら"],["を"],["わたし"],["の"],["敵","てき"],["と"],["思います","おもいます"],["。"]]},{"verse":23,"text":"神,かみよ、どうか、わたしを探,さぐって、わが心,こころを知,しり、わたしを試,こころみて、わがもろもろの思,おもいを知,しってください。","tok":[["神","かみ"],["よ"],["、"],["どう"],["か"],["、"],["わたし"],["を"],["探って","さぐって"],["、"],["わが"],["心","こころ"],["を"],["知り","しり"],["、"],["わたし"],["を"],["試みて","こころみて"],["、"],["わが"],["もろもろ"],["の"],["思い","おもい"],["を"],["知って","しって"],["ください"],["。"]]},{"verse":24,"text":"わたしに悪,あしき道,みちのあるかないかを見,みて、わたしをとこしえの道,みちに導,みちびいてください。","tok":[["わたし"],["に"],["悪しき","あしき"],["道","みち"],["の"],["あるかない"],["か"],["を"],["見て","みて"],["、"],["わたし"],["を"],["とこしえ"],["の"],["道","みち"],["に"],["導いて","みちびいて"],["ください"],["。"]]}]
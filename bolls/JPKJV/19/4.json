[{"verse":1,"text":"[0]【聖歌,せいか隊,たいの指揮者,しきしゃによって琴,ことにあわせてうたわせたダビデの歌,うた】","tok":[["["],["0"],["]"],["【"],["聖歌隊","せいかたい"],["の"],["指揮者","しきしゃ"],["によって"],["琴","こと"],["に"],["あわせて"],["うたわせた"],["ダビデ"],["の"],["歌","うた"],["】"]]},{"verse":2,"text":"[1]わたしの義,ぎを助,たすけ守,まもられる神,かみよ、わたしが呼,よばわる時,とき、お答,こたえください。あなたはわたしが悩,なやんでいた時,とき、わたしをくつろがせてくださいました。わたしをあわれみ、わたしの祈,いのりをお聞,ききください。","tok":[["["],["1"],["]"],["わたし"],["の"],["義","ぎ"],["を"],["助け守られる","たすけまもられる"],["神","かみ"],["よ"],["、"],["わたし"],["が"],["呼ばわる","よばわる"],["時","とき"],["、"],["お答","おこたえ"],["ください"],["。"],["あなた"],["は"],["わたし"],["が"],["悩んで","なやんで"],["いた"],["時","とき"],["、"],["わたし"],["を"],["くつろがせて"],["くださいました"],["。"],["わたし"],["を"],["あわれみ"],["、"],["わたし"],["の"],["祈","いのり"],["を"],["お聞く","おききく"],["ださい"],["。"]]},{"verse":3,"text":"[2]人,ひとの子,こらよ、いつまでわたしの誉,ほまれをはずかしめるのか。いつまでむなしい言葉,ことばを愛,あいし、偽,いつわりを慕,したい求,もとめるのか。〔セラ","tok":[["["],["2"],["]"],["人","ひと"],["の"],["子","こ"],["ら"],["よ"],["、"],["いつ"],["まで"],["わたし"],["の"],["誉","ほまれ"],["を"],["はずかしめる"],["の"],["か"],["。"],["いつ"],["まで"],["むなしい"],["言葉","ことば"],["を"],["愛し","あいし"],["、"],["偽り","いつわり"],["を"],["慕い求める","したいもとめる"],["の"],["か"],["。"],["〔"],["セラ"]]},{"verse":4,"text":"[3]しかしあなたがたは知,しるがよい、主,しゅは神,かみを敬,うやまう人,ひとをご自分,じぶんのために聖別,せいべつされたことを。主,しゅはわたしが呼,よばわる時,ときにおききくださる。","tok":[["["],["3"],["]"],["しかし"],["あなた"],["がた"],["は"],["知る","しる"],["がよい"],["、"],["主","しゅ"],["は"],["神","かみ"],["を"],["敬う","うやまう"],["人","ひと"],["を"],["ご自分","ごじぶん"],["の"],["ため"],["に"],["聖別","せいべつ"],["された"],["こと"],["を"],["。"],["主","しゅ"],["は"],["わたし"],["が"],["呼ばわる","よばわる"],["時","とき"],["に"],["おきき"],["くださる"],["。"]]},{"verse":5,"text":"[4]あなたがたは怒,いかっても、罪,つみを犯,おかしてはならない。床,とこの上,うえで静,しずかに自分,じぶんの心,こころに語,かたりなさい。〔セラ","tok":[["["],["4"],["]"],["あなた"],["がた"],["は"],["怒","いかって"],["も"],["、"],["罪","つみ"],["を"],["犯して","おかして"],["は"],["ならない"],["。"],["床","とこ"],["の"],["上","うえ"],["で"],["静","しずか"],["に"],["自分","じぶん"],["の"],["心","こころ"],["に"],["語り","かたり"],["なさい"],["。"],["〔"],["セラ"]]},{"verse":6,"text":"[5]義,ぎのいけにえをささげて主,しゅに寄,より頼,たのみなさい。","tok":[["["],["5"],["]"],["義","ぎ"],["の"],["いけにえ"],["を"],["ささげて"],["主に","しゅに"],["寄り","より"],["頼み","たのみ"],["なさい"],["。"]]},{"verse":7,"text":"[6]多,おおくの人,ひとは言,いう、「どうか、わたしたちに良,よい事,ことが見,みられるように。主,しゅよ、どうか、み顔,かおの光,ひかりをわたしたちの上,うえに照,てらされるように」と。","tok":[["["],["6"],["]"],["多く","おおく"],["の"],["人","ひと"],["は"],["言う","いう"],["、"],["「"],["どう"],["か"],["、"],["わたしたち"],["に"],["良い","よい"],["事","こと"],["が"],["見られる","みられる"],["よう"],["に"],["。"],["主","しゅ"],["よ"],["、"],["どう"],["か"],["、"],["み顔","みかお"],["の"],["光","ひかり"],["を"],["わたしたち"],["の"],["上","うえ"],["に"],["照らされる","てらされる"],["よう"],["に"],["」"],["と"],["。"]]},{"verse":8,"text":"[7]あなたがわたしの心,こころにお与,あたえになった喜,よろこびは、穀物,こくもつと、ぶどう酒,しゅの豊,ゆたかな時,ときの喜,よろこびにまさるものでした。","tok":[["["],["7"],["]"],["あなた"],["が"],["わたし"],["の"],["心","こころ"],["に"],["お"],["与","あたえ"],["に"],["なった"],["喜こび","よろこび"],["は"],["、"],["穀物","こくもつ"],["と"],["、"],["ぶどう酒","ぶどうしゅ"],["の"],["豊","ゆたか"],["な"],["時","とき"],["の"],["喜こび","よろこび"],["に"],["まさる"],["もの"],["でした"],["。"]]},{"verse":9,"text":"[8]わたしは安,やすらかに伏,ふし、また眠,ねむります。主,しゅよ、わたしを安,やすらかにおらせてくださるのは、ただあなただけです。","tok":[["["],["8"],["]"],["わたし"],["は"],["安らか","やすらか"],["に"],["伏し","ふし"],["、"],["また"],["眠ります","ねむります"],["。"],["主","しゅ"],["よ"],["、"],["わたし"],["を"],["安らか","やすらか"],["に"],["おらせて"],["くださる"],["の"],["は"],["、"],["ただ"],["あなた"],["だけ"],["です"],["。"]]}]
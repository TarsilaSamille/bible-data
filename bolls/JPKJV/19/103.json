[{"verse":1,"text":"【ダビデの歌,うた】わがたましいよ、主,しゅをほめよ。わがうちなるすべてのものよ、その聖,せいなるみ名,なをほめよ。","tok":[["【"],["ダビデ"],["の"],["歌","うた"],["】"],["わが"],["たましい"],["よ"],["、"],["主","しゅ"],["を"],["ほめよ"],["。"],["わが"],["うち"],["なる"],["すべて"],["の"],["もの"],["よ"],["、"],["その"],["聖","せい"],["なる"],["み名","みな"],["を"],["ほめよ"],["。"]]},{"verse":2,"text":"わがたましいよ、主,しゅをほめよ。そのすべてのめぐみを心,こころにとめよ。","tok":[["わが"],["たましい"],["よ"],["、"],["主","しゅ"],["を"],["ほめよ"],["。"],["その"],["すべて"],["の"],["めぐみ"],["を"],["心","こころ"],["に"],["とめよ"],["。"]]},{"verse":3,"text":"主,しゅはあなたのすべての不義,ふぎをゆるし、あなたのすべての病,やまいをいやし、","tok":[["主","しゅ"],["は"],["あなた"],["の"],["すべて"],["の"],["不義","ふぎ"],["を"],["ゆるし"],["、"],["あなた"],["の"],["すべて"],["の"],["病","やまい"],["を"],["いやし"],["、"]]},{"verse":4,"text":"あなたのいのちを墓,はかからあがないいだし、いつくしみと、あわれみとをあなたにこうむらせ、","tok":[["あなた"],["の"],["いのち"],["を"],["墓","はか"],["から"],["あがない"],["いだし"],["、"],["いつくしみ"],["と"],["、"],["あわれみ"],["と"],["を"],["あなた"],["に"],["こうむらせ"],["、"]]},{"verse":5,"text":"あなたの生,いきながらえるかぎり、良,よき物,ものをもってあなたを飽,あき足,たらせられる。こうしてあなたは若返,わかがえって、わしのように新,あらたになる。","tok":[["あなた"],["の"],["生きながらえる","いきながらえる"],["かぎり"],["、"],["良き","よき"],["物","もの"],["を"],["もって"],["あなた"],["を"],["飽き足らせられる","あきたらせられる"],["。"],["こう"],["して"],["あなた"],["は"],["若返って","わかがえって"],["、"],["わし"],["の"],["よう"],["に"],["新らた","あらた"],["に"],["なる"],["。"]]},{"verse":6,"text":"主,しゅはすべてしえたげられる者,もののために正義,せいぎと公正,こうせいとを行,おこなわれる。","tok":[["主","しゅ"],["は"],["すべて"],["し"],["えたげられる"],["者","もの"],["の"],["ため"],["に"],["正義","せいぎ"],["と"],["公正","こうせい"],["と"],["を"],["行なわれる","おこなわれる"],["。"]]},{"verse":7,"text":"主,しゅはおのれの道,みちをモーセに知,しらせ、おのれのしわざをイスラエルの人々,ひとびとに知,しらせられた。","tok":[["主","しゅ"],["は"],["おのれ"],["の"],["道","みち"],["を"],["モーセ"],["に"],["知らせ","しらせ"],["、"],["おのれ"],["の"],["しわざ"],["を"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["知らせられた","しらせられた"],["。"]]},{"verse":8,"text":"主,しゅはあわれみに富,とみ、めぐみふかく、怒,いかること遅,おそく、いつくしみ豊,ゆたかでいらせられる。","tok":[["主","しゅ"],["は"],["あわれみ"],["に"],["富","とみ"],["、"],["めぐみ"],["ふかく"],["、"],["怒","いかるこ"],["と"],["遅く","おそく"],["、"],["いつくしみ"],["豊か","ゆたか"],["で"],["いらせられる"],["。"]]},{"verse":9,"text":"主,しゅは常,つねに責,せめることをせず、また、とこしえに怒,いかりをいだかれない。","tok":[["主","しゅ"],["は"],["常","つね"],["に"],["責","せめ"],["る"],["こと"],["を"],["せず"],["、"],["また"],["、"],["とこしえ"],["に"],["怒り","いかり"],["を"],["いだかれない"],["。"]]},{"verse":10,"text":"主,しゅはわれらの罪,つみにしたがってわれらをあしらわず、われらの不義,ふぎにしたがって報,むくいられない。","tok":[["主","しゅ"],["は"],["われ"],["ら"],["の"],["罪","つみ"],["に"],["したがって"],["われ"],["ら"],["を"],["あしらわず"],["、"],["われ"],["ら"],["の"],["不義","ふぎ"],["に"],["したがって"],["報いられない","むくいられない"],["。"]]},{"verse":11,"text":"天,てんが地,ちよりも高,たかいように、主,しゅがおのれを恐,おそれる者,ものに賜,たまわるいつくしみは大,おおきい、","tok":[["天","てん"],["が"],["地","ち"],["より"],["も"],["高かい","たかい"],["よう"],["に"],["、"],["主","しゅ"],["が"],["おのれ"],["を"],["恐れる","おそれる"],["者","もの"],["に"],["賜わる","たまわる"],["いつくしみ"],["は"],["大きい","おおきい"],["、"]]},{"verse":12,"text":"東,ひがしが西,にしから遠,とおいように、主,しゅはわれらのとがをわれらから遠,とおざけられる。","tok":[["東","ひがし"],["が"],["西","にし"],["から"],["遠い","とおい"],["よう"],["に"],["、"],["主","しゅ"],["は"],["われ"],["ら"],["の"],["とが"],["を"],["われ"],["ら"],["から"],["遠ざけられる","とおざけられる"],["。"]]},{"verse":13,"text":"父,ちちがその子,こ供,ともをあわれむように、主,しゅはおのれを恐,おそれる者,ものをあわれまれる。","tok":[["父","ちち"],["が"],["その"],["子供","ことも"],["を"],["あわれむ"],["よう"],["に"],["、"],["主","しゅ"],["は"],["おのれ"],["を"],["恐れる","おそれる"],["者","もの"],["を"],["あわれまれる"],["。"]]},{"verse":14,"text":"主,しゅはわれらの造,つくられたさまを知,しり、われらのちりであることを覚,おぼえていられるからである。","tok":[["主","しゅ"],["は"],["われ"],["ら"],["の"],["造られた","つくられた"],["さま"],["を"],["知り","しり"],["、"],["われ"],["ら"],["の"],["ちり"],["で"],["ある"],["こと"],["を"],["覚えて","おぼえて"],["いられる"],["から"],["で"],["ある"],["。"]]},{"verse":15,"text":"人,ひとは、そのよわいは草,くさのごとく、その栄,さかえは野,のの花,はなにひとしい。","tok":[["人","ひと"],["は"],["、"],["その"],["よわい"],["は"],["草","くさ"],["の"],["ごとく"],["、"],["その"],["栄","さかえ"],["は"],["野","の"],["の"],["花","はな"],["に"],["ひとしい"],["。"]]},{"verse":16,"text":"風,かぜがその上,うえを過,すぎると、うせて跡,あとなく、その場所,ばしょにきいても、もはやそれを知,しらない。","tok":[["風","かぜ"],["が"],["その"],["上","うえ"],["を"],["過る","すぎる"],["と"],["、"],["うせて"],["跡","あと"],["なく"],["、"],["その"],["場所","ばしょ"],["に"],["きいて"],["も"],["、"],["もはや"],["それ"],["を"],["知らない","しらない"],["。"]]},{"verse":17,"text":"しかし主,しゅのいつくしみは、とこしえからとこしえまで、主,しゅを恐,おそれる者,ものの上,うえにあり、その義,ぎは子,こらの子,こに及,および、","tok":[["しかし"],["主","しゅ"],["の"],["いつくしみ"],["は"],["、"],["とこしえ"],["から"],["とこしえ"],["まで"],["、"],["主","しゅ"],["を"],["恐れる","おそれる"],["者","もの"],["の"],["上","うえ"],["に"],["あり"],["、"],["その"],["義","ぎ"],["は"],["子","こ"],["ら"],["の"],["子","こ"],["に"],["及","および"],["、"]]},{"verse":18,"text":"その契約,けいやくを守,まもり、その命令,めいれいを心,こころにとめて行,おこなう者,ものにまで及,およぶ。","tok":[["その"],["契約","けいやく"],["を"],["守り","まもり"],["、"],["その"],["命令","めいれい"],["を"],["心","こころ"],["に"],["とめて"],["行なう","おこなう"],["者","もの"],["に"],["まで"],["及ぶ","およぶ"],["。"]]},{"verse":19,"text":"主,しゅはその玉座,ぎょくざを天,てんに堅,かたくすえられ、そのまつりごとはすべての物,ものを統,すべ治,おさめる。","tok":[["主","しゅ"],["は"],["その"],["玉座","ぎょくざ"],["を"],["天","てん"],["に"],["堅く","かたく"],["すえられ"],["、"],["その"],["まつりごと"],["は"],["すべて"],["の"],["物","もの"],["を"],["統べ治める","すべおさめる"],["。"]]},{"verse":20,"text":"主,しゅの使,つかいたちよ、そのみ言葉,ことばの声,こえを聞,きいて、これを行,おこなう勇士,ゆうしたちよ、主,しゅをほめまつれ。","tok":[["主","しゅ"],["の"],["使","つかい"],["たち"],["よ"],["、"],["その"],["み言葉","みことば"],["の"],["声","こえ"],["を"],["聞いて","きいて"],["、"],["これ"],["を"],["行なう","おこなう"],["勇士","ゆうし"],["たち"],["よ"],["、"],["主","しゅ"],["を"],["ほめ"],["まつれ"],["。"]]},{"verse":21,"text":"そのすべての万軍,ばんぐんよ、そのみこころを行,おこなうしもべたちよ、主,しゅをほめよ。","tok":[["その"],["すべて"],["の"],["万","まん"],["軍","ぐん"],["ぐ"],["ん"],["よ"],["、"],["その"],["みこころ"],["を"],["行なう","おこなう"],["しもべ"],["たち"],["よ"],["、"],["主","しゅ"],["を"],["ほめよ"],["。"]]},{"verse":22,"text":"主,しゅが造,つくられたすべての物,ものよ、そのまつりごとの下,したにあるすべての所,ところで、主,しゅをほめよ。わがたましいよ、主,しゅをほめよ。","tok":[["主","しゅ"],["が"],["造られた","つくられた"],["すべて"],["の"],["物","もの"],["よ"],["、"],["その"],["まつりごと"],["の"],["下","した"],["に"],["ある"],["すべて"],["の"],["所","ところ"],["で"],["、"],["主","しゅ"],["を"],["ほめよ"],["。"],["わが"],["たましい"],["よ"],["、"],["主","しゅ"],["を"],["ほめよ"],["。"]]}]
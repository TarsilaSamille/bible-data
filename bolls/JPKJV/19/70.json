[{"verse":1,"text":"[0]【聖歌,せいか隊,たいの指揮者,しきしゃによってうたわせたダビデの記念,きねんの歌,うた】","tok":[["["],["0"],["]"],["【"],["聖歌隊","せいかたい"],["の"],["指揮者","しきしゃ"],["によって"],["うたわせた"],["ダビデ"],["の"],["記念","きねん"],["の"],["歌","うた"],["】"]]},{"verse":2,"text":"[1]神,かみよ、みこころならばわたしをお救,すくいください。主,しゅよ、すみやかにわたしをお助,たすけください。","tok":[["["],["1"],["]"],["神","かみ"],["よ"],["、"],["みこころ"],["ならば"],["わたし"],["を"],["お救い","おすくい"],["ください"],["。"],["主","しゅ"],["よ"],["、"],["すみやか"],["に"],["わたし"],["を"],["お助け","おたすけ"],["ください"],["。"]]},{"verse":3,"text":"[2]わたしのいのちをたずね求,もとめる者,ものどもを恥,はじあわてさせてください。わたしのそこなわれることを願,ねがう者,ものどもをうしろに退,しりぞかせ、恥,はじを負,おわせてください。","tok":[["["],["2"],["]"],["わたし"],["の"],["いのち"],["を"],["たずね求める","たずねもとめる"],["者","もの"],["ども"],["を"],["恥","はじ"],["あわてさせて"],["ください"],["。"],["わたし"],["の"],["そこなわれる"],["こと"],["を"],["願う","ねがう"],["者","もの"],["ども"],["を"],["うしろ"],["に"],["退ぞかせ","しりぞかせ"],["、"],["恥","はじ"],["を"],["負わせて","おわせて"],["ください"],["。"]]},{"verse":4,"text":"[3]「あはぁ、あはぁ」と言,いう者,ものどもを自分,じぶんの恥,はじによって恐,おそれおののかせてください。","tok":[["["],["3"],["]"],["「"],["あ"],["はぁ"],["、"],["あ"],["はぁ"],["」"],["と"],["言う","いう"],["者","もの"],["ども"],["を"],["自分","じぶん"],["の"],["恥","はじ"],["によって"],["恐れおののかせて","おそれおののかせて"],["ください"],["。"]]},{"verse":5,"text":"[4]すべてあなたを尋,たずね求,もとめる者,ものはあなたによって喜,よろこび楽,たのしむように。あなたの救,すくいを愛,あいする者,ものはつねに「神,かみは大,おおいなるかな」ととなえるように。","tok":[["["],["4"],["]"],["すべて"],["あなた"],["を"],["尋ね求める","たずねもとめる"],["者","もの"],["は"],["あなた"],["によって"],["喜こび","よろこび"],["楽しむ","たのしむ"],["よう"],["に"],["。"],["あなた"],["の"],["救い","すくい"],["を"],["愛する","あいする"],["者","もの"],["は"],["つね"],["に"],["「"],["神","かみ"],["は"],["大いなる","おおいなる"],["か"],["な"],["」"],["と"],["となえる"],["よう"],["に"],["。"]]},{"verse":6,"text":"[5]しかし、わたしは貧,まずしく、かつ乏,とぼしい。神,かみよ、急,いそいでわたしに来,きてください。あなたはわが助,たすけ、わが救主,すくいぬしです。主,しゅよ、ためらわないでください。","tok":[["["],["5"],["]"],["しかし"],["、"],["わたし"],["は"],["貧しく","まずしく"],["、"],["かつ"],["乏い","とぼしい"],["。"],["神","かみ"],["よ"],["、"],["急いで","いそいで"],["わたし"],["に"],["来て","きて"],["ください"],["。"],["あなた"],["は"],["わが"],["助け","たすけ"],["、"],["わが"],["救主","す"],["くい"],["ぬし"],["です"],["。"],["主","しゅ"],["よ"],["、"],["ためらわないで"],["ください"],["。"]]}]
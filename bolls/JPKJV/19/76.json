[{"verse":1,"text":"[0]【聖歌,せいか隊,たいの指揮者,しきしゃによって琴,ことにあわせてうたわせたアサフの歌,うた、さんび】","tok":[["["],["0"],["]"],["【"],["聖歌隊","せいかたい"],["の"],["指揮者","しきしゃ"],["によって"],["琴","こと"],["に"],["あわせて"],["うたわせた"],["アサフ"],["の"],["歌","うた"],["、"],["さん"],["び"],["】"]]},{"verse":2,"text":"[1]神,かみはユダに知,しられ、そのみ名,なはイスラエルにおいて偉大,いだいである。","tok":[["["],["1"],["]"],["神","かみ"],["は"],["ユダ"],["に"],["知られ","しられ"],["、"],["その"],["み名","みな"],["は"],["イスラエル"],["に"],["おいて"],["偉大","いだい"],["で"],["ある"],["。"]]},{"verse":3,"text":"[2]その幕屋,まくやはサレムにあり、そのすまいはシオンにある。","tok":[["["],["2"],["]"],["その"],["幕屋","まくや"],["は"],["サレム"],["に"],["あり"],["、"],["その"],["すまい"],["は"],["シオン"],["に"],["ある"],["。"]]},{"verse":4,"text":"[3]かしこで神,かみは弓,ゆみの火矢,ひやを折,おり、盾,たてとつるぎと戦,たたかいの武器,ぶきをこわされた。〔セラ","tok":[["["],["3"],["]"],["かしこ"],["で"],["神","かみ"],["は"],["弓","ゆみ"],["の"],["火矢","ひや"],["を"],["折","おり"],["、"],["盾","たて"],["と"],["つるぎ"],["と"],["戦い","たたかい"],["の"],["武器","ぶき"],["を"],["こわされた"],["。"],["〔"],["セラ"]]},{"verse":5,"text":"[4]あなたは永久,えいきゅうの山々,やまやまにまさって光栄,こうえいあり、威厳,いげんがある。","tok":[["["],["4"],["]"],["あなた"],["は"],["永久","えいきゅう"],["の"],["山々","やまやま"],["に"],["まさって"],["光栄","こうえい"],["あり"],["、"],["威厳","いげん"],["が"],["ある"],["。"]]},{"verse":6,"text":"[5]雄々,おおしい者,ものはかすめられ、彼,かれらは眠,ねむりに沈,しずみ、いくさびとは皆,みなその手,てを施,ほどこすことができなかった。","tok":[["["],["5"],["]"],["雄々しい","おおしい"],["者","もの"],["は"],["かすめられ"],["、"],["彼","かれ"],["ら"],["は"],["眠","ねむり"],["に"],["沈み","しずみ"],["、"],["いく"],["さび"],["と"],["は"],["皆","みな"],["その"],["手","て"],["を"],["施す","ほどこす"],["こと"],["が"],["できなかった"],["。"]]},{"verse":7,"text":"[6]ヤコブの神,かみよ、あなたのとがめによって、乗,のり手,てと馬,うまとは深,ふかい眠,ねむりに陥,おちいった。","tok":[["["],["6"],["]"],["ヤコブ"],["の"],["神","かみ"],["よ"],["、"],["あなた"],["の"],["とがめ"],["によって"],["、"],["乗手","のりて"],["と"],["馬","うま"],["と"],["は"],["深","ふ"],["かい"],["眠","ねむり"],["に"],["陥た","おちいった"],["。"]]},{"verse":8,"text":"[7]しかし、あなたこそは恐,おそるべき方,かたである。あなたが怒,いかりを発,はっせられるとき、だれがみ前,まえに立,たつことができよう。","tok":[["["],["7"],["]"],["しかし"],["、"],["あなた"],["こそ"],["は"],["恐るべき","おそるべき"],["方","かた"],["で"],["ある"],["。"],["あなた"],["が"],["怒り","いかり"],["を"],["発せられる","はっせられる"],["とき"],["、"],["だれ"],["が"],["み前","みまえ"],["に"],["立つ","たつ"],["こと"],["が"],["できよう"],["。"]]},{"verse":9,"text":"[8-9]あなたは天,てんからさばきを仰,おおせられた。神,かみが地,ちのしえたげられた者,ものを救,すくうために、さばきに立,たたれたとき、地,ちは恐,おそれて、沈黙,ちんもくした。〔セラ","tok":[["["],["8"],["-"],["9"],["]"],["あなた"],["は"],["天","てん"],["から"],["さばき"],["を"],["仰せられた","おおせられた"],["。"],["神","かみ"],["が"],["地のし","ちのし"],["え"],["たげられた"],["者","もの"],["を"],["救う","すくう"],["ため"],["に"],["、"],["さばき"],["に"],["立たれた","たたれた"],["とき"],["、"],["地","ち"],["は"],["恐れて","おそれて"],["、"],["沈黙","ちんもく"],["した"],["。"],["〔"],["セラ"]]},{"verse":10,"text":"*[8-9]あなたは天,てんからさばきを仰,おおせられた。神,かみが地,ちのしえたげられた者,ものを救,すくうために、さばきに立,たたれたとき、地,ちは恐,おそれて、沈黙,ちんもくした。〔セラ","tok":[["*"],["["],["8"],["-"],["9"],["]"],["あなた"],["は"],["天","てん"],["から"],["さばき"],["を"],["仰せられた","おおせられた"],["。"],["神","かみ"],["が"],["地のし","ちのし"],["え"],["たげられた"],["者","もの"],["を"],["救う","すくう"],["ため"],["に"],["、"],["さばき"],["に"],["立たれた","たたれた"],["とき"],["、"],["地","ち"],["は"],["恐れて","おそれて"],["、"],["沈黙","ちんもく"],["した"],["。"],["〔"],["セラ"]]},{"verse":11,"text":"[10]まことに人,ひとの怒,いかりはあなたをほめたたえる。怒,いかりの余,あまりをあなたは帯,おびとされる。","tok":[["["],["10"],["]"],["まこと"],["に"],["人","ひと"],["の"],["怒り","いかり"],["は"],["あなた"],["を"],["ほめたたえる"],["。"],["怒り","いかり"],["の"],["余","あまり"],["を"],["あなた"],["は"],["帯","おび"],["と"],["される"],["。"]]},{"verse":12,"text":"[11]あなたがたの神,かみ、主,しゅに誓,ちかいを立,たてて、それを償,つぐなえ。その周囲,しゅういのすべての者,ものは恐,おそるべき主,しゅに贈,おくり物,ものをささげよ。","tok":[["["],["11"],["]"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主に","しゅに"],["誓い","ちかい"],["を"],["立てて","たてて"],["、"],["それ"],["を"],["償なえ","つぐなえ"],["。"],["その"],["周囲","しゅうい"],["の"],["すべて"],["の"],["者","もの"],["は"],["恐るべき","おそるべき"],["主に","しゅに"],["贈り物","おくりもの"],["を"],["ささげ"],["よ"],["。"]]},{"verse":13,"text":"[12]主,しゅはもろもろの君,きみたちのいのちを断,たたれる。主,しゅは地,ちの王,おうたちの恐,おそるべき者,ものである。","tok":[["["],["12"],["]"],["主","しゅ"],["は"],["もろもろ"],["の"],["君","きみ"],["たち"],["の"],["いのち"],["を"],["断たれる","たたれる"],["。"],["主","しゅ"],["は"],["地","ち"],["の"],["王","おう"],["たち"],["の"],["恐るべき","おそるべき"],["者","もの"],["で"],["ある"],["。"]]}]
[{"verse":1,"text":"[0]【聖歌,せいか隊,たいの指揮者,しきしゃによってムツラベンのしらべにあわせてうたわせたダビデの歌,うた】","tok":[["["],["0"],["]"],["【"],["聖歌隊","せいかたい"],["の"],["指揮者","しきしゃ"],["によって"],["ムツラベン"],["の"],["しらべ"],["に"],["あわせて"],["うたわせた"],["ダビデ"],["の"],["歌","うた"],["】"]]},{"verse":2,"text":"[1]わたしは心,こころをつくして主,しゅに感謝,かんしゃし、あなたのくすしきみわざをことごとく宣,のべ伝,つたえます。","tok":[["["],["1"],["]"],["わたし"],["は"],["心","こころ"],["を"],["つくして"],["主に","しゅに"],["感謝","かんしゃ"],["し"],["、"],["あなた"],["の"],["くす"],["しきみ"],["わざ"],["を"],["ことごとく"],["宣べ伝えます","のべつたえます"],["。"]]},{"verse":3,"text":"[2]いと高,たかき者,ものよ、あなたによってわたしは喜,よろこびかつ楽,たのしみ、あなたの名,なをほめ歌,うたいます。","tok":[["["],["2"],["]"],["いと"],["高き","たかき"],["者","もの"],["よ"],["、"],["あなた"],["によって"],["わたし"],["は"],["喜こび","よろこび"],["かつ"],["楽み","たのしみ"],["、"],["あなた"],["の"],["名","な"],["を"],["ほめ"],["歌います","うたいます"],["。"]]},{"verse":4,"text":"[3]わたしの敵,てきは退,しりぞくとき、つまずき倒,たおれてあなたの前,まえに滅,ほろびました。","tok":[["["],["3"],["]"],["わたし"],["の"],["敵","てき"],["は"],["退ぞく","しりぞく"],["とき"],["、"],["つまずき"],["倒れて","たおれて"],["あなた"],["の"],["前","まえ"],["に"],["滅びました","ほろびました"],["。"]]},{"verse":5,"text":"[4]あなたがわたしの正,ただしい訴,うったえを助,たすけ守,まもられたからです。あなたはみくらに座,ざして、正,ただしいさばきをされました。","tok":[["["],["4"],["]"],["あなた"],["が"],["わたし"],["の"],["正い","ただしい"],["訴","うったえ"],["を"],["助け守られた","たすけまもられた"],["から"],["です"],["。"],["あなた"],["は"],["みく"],["ら"],["に"],["座して","ざして"],["、"],["正い","ただしい"],["さばき"],["を"],["されました"],["。"]]},{"verse":6,"text":"[5]あなたはもろもろの国民,こくみんを責,せめ、悪,あしき者,ものを滅,ほろぼし、永久,えいきゅうに彼,かれらの名,なを消,けし去,さられました。","tok":[["["],["5"],["]"],["あなた"],["は"],["もろもろ"],["の"],["国民","こくみん"],["を"],["責","せめ"],["、"],["悪しき","あしき"],["者","もの"],["を"],["滅ぼし","ほろぼし"],["、"],["永久","えいきゅう"],["に"],["彼","かれ"],["ら"],["の"],["名","な"],["を"],["消し去られました","けしさられました"],["。"]]},{"verse":7,"text":"[6]敵,てきは絶,たえはてて、とこしえに滅,ほろび、あなたが滅,ほろぼされたもろもろの町,まちはその記憶,きおくさえ消,きえうせました。","tok":[["["],["6"],["]"],["敵","てき"],["は"],["絶え","たえ"],["はてて"],["、"],["とこしえ"],["に"],["滅び","ほろび"],["、"],["あなた"],["が"],["滅ぼされた","ほろぼされた"],["もろもろ"],["の"],["町","まち"],["は"],["その"],["記憶","きおく"],["さえ"],["消えうせました","きえうせました"],["。"]]},{"verse":8,"text":"[7]しかし主,しゅはとこしえに、み位,くらいに座,ざし、さばきのために、みくらを設,もうけられました。","tok":[["["],["7"],["]"],["しかし"],["主","しゅ"],["は"],["とこしえ"],["に"],["、"],["み位","みくらい"],["に"],["座し","ざし"],["、"],["さばき"],["の"],["ため"],["に"],["、"],["みく"],["ら"],["を"],["設けられました","もうけられました"],["。"]]},{"verse":9,"text":"[8]主,しゅは正義,せいぎをもって世界,せかいをさばき、公平,こうへいをもってもろもろの民,たみをさばかれます。","tok":[["["],["8"],["]"],["主","しゅ"],["は"],["正義","せいぎ"],["を"],["もって"],["世界","せかい"],["を"],["さばき"],["、"],["公平","こうへい"],["を"],["もって"],["もろもろ"],["の"],["民","たみ"],["を"],["さばかれます"],["。"]]},{"verse":10,"text":"[9]主,しゅはしえたげられる者,もののとりで、なやみの時,ときのとりでです。","tok":[["["],["9"],["]"],["主","しゅ"],["は"],["し"],["えたげられる"],["者","もの"],["の"],["とり"],["で"],["、"],["なやみ"],["の"],["時","とき"],["の"],["とりで"],["です"],["。"]]},{"verse":11,"text":"[10]み名,なを知,しる者,ものはあなたに寄,より頼,たのみます。主,しゅよ、あなたを尋,たずね求,もとめる者,ものをあなたは捨,すてられたことがないからです。","tok":[["["],["10"],["]"],["み名","みな"],["を"],["知る","しる"],["者","もの"],["は"],["あなた"],["に"],["寄り","より"],["頼みます","たのみます"],["。"],["主","しゅ"],["よ"],["、"],["あなた"],["を"],["尋ね求める","たずねもとめる"],["者","もの"],["を"],["あなた"],["は"],["捨てられた","すてられた"],["こと"],["が"],["ない"],["から"],["です"],["。"]]},{"verse":12,"text":"[11]シオンに住,すまわれる主,しゅにむかってほめうたい、そのみわざをもろもろの民,たみのなかに宣,のべ伝,つたえよ。","tok":[["["],["11"],["]"],["シオン"],["に"],["住まわれる","すまわれる"],["主","しゅ"],["に"],["むかって"],["ほめ"],["うたい"],["、"],["その"],["みわざ"],["を"],["もろもろ"],["の"],["民","たみ"],["の"],["なか"],["に"],["宣べ伝えよ","のべつたえよ"],["。"]]},{"verse":13,"text":"[12]血,ちを流,ながす者,ものにあだを報,むくいられる主,しゅは彼,かれらを心,こころにとめ、苦,くるしむ者,ものの叫,さけびをお忘,わすれにならないからです。","tok":[["["],["12"],["]"],["血","ち"],["を"],["流す","ながす"],["者","もの"],["に"],["あだ"],["を"],["報いられる","むくいられる"],["主","しゅ"],["は"],["彼","かれ"],["ら"],["を"],["心","こころ"],["に"],["とめ"],["、"],["苦しむ","くるしむ"],["者","もの"],["の"],["叫","さけび"],["を"],["お忘","おわすれ"],["に"],["ならない"],["から"],["です"],["。"]]},{"verse":14,"text":"[13]主,しゅよ、わたしをあわれんでください。死,しの門,もんからわたしを引,ひきあげられる主,しゅよ、あだする者,もののわたしを悩,なやますのをみそなわしてください。","tok":[["["],["13"],["]"],["主","しゅ"],["よ"],["、"],["わたし"],["を"],["あわれんで"],["ください"],["。"],["死","し"],["の"],["門","もん"],["から"],["わたし"],["を"],["引","ひき"],["あげられる"],["主","しゅ"],["よ"],["、"],["あだ"],["する"],["者","もの"],["の"],["わたし"],["を"],["悩す","なやます"],["の"],["を"],["みそ"],["なわ"],["して"],["ください"],["。"]]},{"verse":15,"text":"[14]そうすれば、わたしはあなたのすべての誉,ほまれを述,のべ、シオンの娘,むすめの門,もんで、あなたの救,すくいを喜,よろこぶことができましょう。","tok":[["["],["14"],["]"],["そう"],["すれば"],["、"],["わたし"],["は"],["あなた"],["の"],["すべて"],["の"],["誉","ほまれ"],["を"],["述べ","のべ"],["、"],["シオン"],["の"],["娘","むすめ"],["の"],["門","もん"],["で"],["、"],["あなた"],["の"],["救い","すくい"],["を"],["喜こぶ","よろこぶ"],["こと"],["が"],["できましょう"],["。"]]},{"verse":16,"text":"[15]もろもろの国民,こくみんは自分,じぶんの作,つくった穴,あなに陥,おちいり、隠,かくし設,もうけた網,あみに自分,じぶんの足,あしを捕,とらえられる。","tok":[["["],["15"],["]"],["もろもろ"],["の"],["国民","こくみん"],["は"],["自分","じぶん"],["の"],["作った","つくった"],["穴","あな"],["に"],["陥ち","おち"],["いり"],["、"],["隠し","かくし"],["設けた","もうけた"],["網","あみ"],["に"],["自分","じぶん"],["の"],["足","あし"],["を"],["捕らえられる","とらえられる"],["。"]]},{"verse":17,"text":"[16]主,しゅはみずからを知,しらせ、さばきを行,おこなわれた。悪,あしき者,ものは自分,じぶんの手,てで作,つくったわなに捕,とらえられる。〔ヒガヨン、セラ","tok":[["["],["16"],["]"],["主","しゅ"],["は"],["みずから"],["を"],["知らせ","しらせ"],["、"],["さばき"],["を"],["行なわれた","おこなわれた"],["。"],["悪しき","あしき"],["者","もの"],["は"],["自分","じぶん"],["の"],["手","て"],["で"],["作った","つくった"],["わな"],["に"],["捕らえられる","とらえられる"],["。"],["〔"],["ヒガヨン"],["、"],["セラ"]]},{"verse":18,"text":"[17]悪,あしき者,もの、また神,かみを忘,わすれるもろもろの国民,こくみんは陰府,よみへ去,さって行,いく。","tok":[["["],["17"],["]"],["悪しき","あしき"],["者","もの"],["、"],["また"],["神","かみ"],["を"],["忘る","わすれる"],["もろもろ"],["の"],["国民","こくみん"],["は"],["陰府","よみ"],["へ"],["去て","さって"],["行く","いく"],["。"]]},{"verse":19,"text":"[18]貧,まずしい者,ものは常,つねに忘,わすれられるのではない。苦,くるしむ者,ものの望,のぞみはとこしえに滅,ほろびるのではない。","tok":[["["],["18"],["]"],["貧しい","まずしい"],["者","もの"],["は"],["常","つね"],["に"],["忘られる","わすれられる"],["ので"],["は"],["ない"],["。"],["苦しむ","くるしむ"],["者","もの"],["の"],["望み","のぞみ"],["は"],["とこしえ"],["に"],["滅びる","ほろびる"],["ので"],["は"],["ない"],["。"]]},{"verse":20,"text":"[19]主,しゅよ、立,たちあがってください。人,ひとに勝利,しょうりを得,えさせず、もろもろの国民,こくみんに、み前,まえでさばきを受,うけさせてください。","tok":[["["],["19"],["]"],["主","しゅ"],["よ"],["、"],["立ちあがって","たちあがって"],["ください"],["。"],["人","ひと"],["に"],["勝利","しょうり"],["を"],["得させず","えさせず"],["、"],["もろもろ"],["の"],["国民","こくみん"],["に"],["、"],["み前","みまえ"],["で"],["さばき"],["を"],["受させて","うけさせて"],["ください"],["。"]]},{"verse":21,"text":"[20]主,しゅよ、彼,かれらに恐,おそれを起,おこさせ、もろもろの国民,こくみんに自分,じぶんがただ、人,ひとであることを知,しらせてください。〔セラ","tok":[["["],["20"],["]"],["主","しゅ"],["よ"],["、"],["彼","かれ"],["ら"],["に"],["恐","おそれ"],["を"],["起こさせ","おこさせ"],["、"],["もろもろ"],["の"],["国民","こくみん"],["に"],["自分","じぶん"],["が"],["ただ"],["、"],["人","ひと"],["で"],["ある"],["こと"],["を"],["知らせて","しらせて"],["ください"],["。"],["〔"],["セラ"]]}]
[{"verse":1,"text":"[0]【聖歌,せいか隊,たいの指揮者,しきしゃによってうたわせたダビデの歌,うた】","tok":[["["],["0"],["]"],["【"],["聖歌隊","せいかたい"],["の"],["指揮者","しきしゃ"],["によって"],["うたわせた"],["ダビデ"],["の"],["歌","うた"],["】"]]},{"verse":2,"text":"[1]わたしは耐,たえ忍,しのんで主,しゅを待,まち望,のぞんだ。主,しゅは耳,みみを傾,かたむけて、わたしの叫,さけびを聞,きかれた。","tok":[["["],["1"],["]"],["わたし"],["は"],["耐え忍んで","たえしのんで"],["主","しゅ"],["を"],["待ち望んだ","まちのぞんだ"],["。"],["主","しゅ"],["は"],["耳","みみ"],["を"],["傾むけて","かたむけて"],["、"],["わたし"],["の"],["叫","さけび"],["を"],["聞かれた","きかれた"],["。"]]},{"verse":3,"text":"[2]主,しゅはわたしを滅,ほろびの穴,あなから、泥,どろの沼,ぬまから引,ひきあげて、わたしの足,あしを岩,いわの上,うえにおき、わたしの歩,あゆみをたしかにされた。","tok":[["["],["2"],["]"],["主","しゅ"],["は"],["わたし"],["を"],["滅び","ほろび"],["の"],["穴","あな"],["から"],["、"],["泥","どろ"],["の"],["沼","ぬま"],["から"],["引","ひき"],["あげて"],["、"],["わたし"],["の"],["足","あし"],["を"],["岩","いわ"],["の"],["上","うえ"],["に"],["おき"],["、"],["わたし"],["の"],["歩み","あゆみ"],["を"],["たしか"],["に"],["された"],["。"]]},{"verse":4,"text":"[3]主,しゅは新,あたらしい歌,うたをわたしの口,くちに授,さづけ、われらの神,かみにささげるさんびの歌,うたをわたしの口,くちに授,さづけられた。多,おおくの人,ひとはこれを見,みて恐,おそれ、かつ主,しゅに信頼,しんらいするであろう。","tok":[["["],["3"],["]"],["主","しゅ"],["は"],["新らしい","あたらしい"],["歌","うた"],["を"],["わたし"],["の"],["口","くち"],["に"],["授","さ"],["づけ"],["、"],["われ"],["ら"],["の"],["神","かみ"],["に"],["ささげる"],["さん"],["び"],["の"],["歌","うた"],["を"],["わたし"],["の"],["口","くち"],["に"],["授","さ"],["づけられた"],["。"],["多く","おおく"],["の"],["人","ひと"],["は"],["これ"],["を"],["見て","みて"],["恐","おそれ"],["、"],["かつ"],["主に","しゅに"],["信頼","しんらい"],["するで"],["あろう"],["。"]]},{"verse":5,"text":"[4]主,しゅをおのが頼,たのみとする人,ひと、高,たかぶる者,ものにたよらず、偽,いつわりの神,かみに迷,まよう者,ものにたよらない人,ひとはさいわいである。","tok":[["["],["4"],["]"],["主","しゅ"],["を"],["おの"],["が"],["頼み","たのみ"],["と"],["する"],["人","ひと"],["、"],["高か","たか"],["ぶる"],["者","もの"],["に"],["たよらず"],["、"],["偽わり","いつわり"],["の"],["神","かみ"],["に"],["迷う","まよう"],["者","もの"],["に"],["たよらない"],["人","ひと"],["は"],["さいわい"],["で"],["ある"],["。"]]},{"verse":6,"text":"[5]わが神,かみ、主,しゅよ、あなたのくすしきみわざと、われらを思,おもうみおもいとは多,おおくて、くらべうるものはない。わたしはこれを語,かたり述,のべようとしても多,おおくて数,かぞえることはできない。","tok":[["["],["5"],["]"],["わが"],["神","かみ"],["、"],["主","しゅ"],["よ"],["、"],["あなた"],["の"],["くす"],["しきみ"],["わざと"],["、"],["われ"],["ら"],["を"],["思う","おもう"],["みおもい"],["と"],["は"],["多くて","おおくて"],["、"],["くらべ"],["うる"],["もの"],["は"],["ない"],["。"],["わたし"],["は"],["これ"],["を"],["語り","かたり"],["述べよう","のべよう"],["として"],["も"],["多くて","おおくて"],["数える","かぞえる"],["こと"],["は"],["できない"],["。"]]},{"verse":7,"text":"[6]あなたはいけにえと供,そなえ物,ものとを喜,よろこばれない。あなたはわたしの耳,みみを開,ひらかれた。あなたは燔祭,はんさいと罪祭,ざいさいとを求,もとめられない。","tok":[["["],["6"],["]"],["あなた"],["は"],["いけにえ"],["と"],["供え物","そなえもの"],["と"],["を"],["喜こばれない","よろこばれない"],["。"],["あなた"],["は"],["わたし"],["の"],["耳","みみ"],["を"],["開らかれた","ひらかれた"],["。"],["あなた"],["は"],["燔祭","はんさい"],["と"],["罪","つみ"],["祭","まつり"],["を"],["求められない","もとめられない"],["。"]]},{"verse":8,"text":"[7]その時,ときわたしは言,いった、「見,みよ、わたしはまいります。書,しょの巻,まきに、わたしのためにしるされています。","tok":[["["],["7"],["]"],["その"],["時","とき"],["わたし"],["は"],["言った","いった"],["、"],["「"],["見よ","みよ"],["、"],["わたし"],["は"],["まいります"],["。"],["書","しょ"],["の"],["巻","まき"],["に"],["、"],["わたし"],["の"],["ため"],["に"],["しるされて"],["います"],["。"]]},{"verse":9,"text":"[8]わが神,かみよ、わたしはみこころを行,おこなうことを喜,よろこびます。あなたのおきてはわたしの心,こころのうちにあります」と。","tok":[["["],["8"],["]"],["わが"],["神","かみ"],["よ"],["、"],["わたし"],["は"],["みこころ"],["を"],["行なう","おこなう"],["こと"],["を"],["喜こびます","よろこびます"],["。"],["あなた"],["の"],["おきて"],["は"],["わたし"],["の"],["心","こころ"],["の"],["うち"],["に"],["あります"],["」"],["と"],["。"]]},{"verse":10,"text":"[9]わたしは大,おおいなる集会,しゅうかいで、救,すくいについての喜,よろこびのおとずれを告,つげ示,しめしました。見,みよ、わたしはくちびるを閉,とじませんでした。主,しゅよ、あなたはこれをご存,ぞんじです。","tok":[["["],["9"],["]"],["わたし"],["は"],["大いなる","おおいなる"],["集会","しゅうかい"],["で"],["、"],["救い","すくい"],["について"],["の"],["喜こび","よろこび"],["の"],["おとずれ"],["を"],["告示","つげし"],["めしました"],["。"],["見よ","みよ"],["、"],["わたし"],["は"],["くちびる"],["を"],["閉じませんでした","とじませんでした"],["。"],["主","しゅ"],["よ"],["、"],["あなた"],["は"],["これ"],["を"],["ご存じ","ごぞんじ"],["です"],["。"]]},{"verse":11,"text":"[10]わたしはあなたの救,すくいを心,こころのうちに隠,かくしおかず、あなたのまことと救,すくいとを告,つげ示,しめしました。わたしはあなたのいつくしみとまこととを大,おおいなる集会,しゅうかいに隠,かくしませんでした。","tok":[["["],["10"],["]"],["わたし"],["は"],["あなた"],["の"],["救い","すくい"],["を"],["心","こころ"],["の"],["うち"],["に"],["隠し","かくし"],["おかず"],["、"],["あなた"],["の"],["まこと"],["と"],["救い","すくい"],["と"],["を"],["告示","つげし"],["めしました"],["。"],["わたし"],["は"],["あなた"],["の"],["いつくしみ"],["と"],["まこと"],["と"],["を"],["大いなる","おおいなる"],["集会","しゅうかい"],["に"],["隠しませんでした","かくしませんでした"],["。"]]},{"verse":12,"text":"[11]主,しゅよ、あなたのあわれみをわたしに惜,おしまず、あなたのいつくしみとまこととをもって常,つねにわたしをお守,まもりください。","tok":[["["],["11"],["]"],["主","しゅ"],["よ"],["、"],["あなた"],["の"],["あわれみ"],["を"],["わたし"],["に"],["惜まず","おしまず"],["、"],["あなた"],["の"],["いつくしみ"],["と"],["まこと"],["と"],["を"],["もって"],["常","つね"],["に"],["わたし"],["を"],["お守り","おまもり"],["ください"],["。"]]},{"verse":13,"text":"[12]数,かぞえがたい災,わざわいがわたしを囲,かこみ、わたしの不義,ふぎがわたしに追,おい迫,せまって、物見,ものみることができないまでになりました。それはわたしの頭,あたまの毛,けよりも多,おおく、わたしの心,こころは消,きえうせるばかりになりました。","tok":[["["],["12"],["]"],["数え","かぞえ"],["がたい"],["災","わざわい"],["が"],["わたし"],["を"],["囲み","かこみ"],["、"],["わたし"],["の"],["不義","ふぎ"],["が"],["わたし"],["に"],["追い","おい"],["迫まって","せまって"],["、"],["物","もの"],["見る","みる"],["こと"],["が"],["できない"],["まで"],["に"],["なりました"],["。"],["それ"],["は"],["わたし"],["の"],["頭","あたま"],["の"],["毛","け"],["より"],["も"],["多く","おおく"],["、"],["わたし"],["の"],["心","こころ"],["は"],["消えうせる","きえうせる"],["ばかり"],["に"],["なりました"],["。"]]},{"verse":14,"text":"[13]主,しゅよ、みこころならばわたしをお救,すくいください。主,しゅよ、すみやかにわたしをお助,たすけください。","tok":[["["],["13"],["]"],["主","しゅ"],["よ"],["、"],["みこころ"],["ならば"],["わたし"],["を"],["お救い","おすくい"],["ください"],["。"],["主","しゅ"],["よ"],["、"],["すみやか"],["に"],["わたし"],["を"],["お助け","おたすけ"],["ください"],["。"]]},{"verse":15,"text":"[14]わたしのいのちを奪,うばおうと尋,たずね求,もとめる者,ものどもをことごとく恥,はじあわてさせてください。わたしのそこなわれることを願,ねがう者,ものどもをうしろに退,しりぞかせ、恥,はじを負,おわせてください。","tok":[["["],["14"],["]"],["わたし"],["の"],["いのち"],["を"],["奪おう","うばおう"],["と"],["尋ね求める","たずねもとめる"],["者","もの"],["ども"],["を"],["ことごとく"],["恥","はじ"],["あわてさせて"],["ください"],["。"],["わたし"],["の"],["そこなわれる"],["こと"],["を"],["願う","ねがう"],["者","もの"],["ども"],["を"],["うしろ"],["に"],["退ぞかせ","しりぞかせ"],["、"],["恥","はじ"],["を"],["負わせて","おわせて"],["ください"],["。"]]},{"verse":16,"text":"[15]わたしにむかって「あはぁ、あはぁ」と言,いう者,ものどもを自分,じぶんの恥,はじによって恐,おそれおののかせてください。","tok":[["["],["15"],["]"],["わたし"],["に"],["むかって"],["「"],["あ"],["はぁ"],["、"],["あ"],["はぁ"],["」"],["と"],["言う","いう"],["者","もの"],["ども"],["を"],["自分","じぶん"],["の"],["恥","はじ"],["によって"],["恐れおののかせて","おそれおののかせて"],["ください"],["。"]]},{"verse":17,"text":"[16]しかし、すべてあなたを尋,たずね求,もとめる者,ものはあなたによって喜,よろこび楽,たのしむように。あなたの救,すくいを愛,あいする者,ものは常,つねに「主,しゅは大,おおいなるかな」ととなえるように。","tok":[["["],["16"],["]"],["しかし"],["、"],["すべて"],["あなた"],["を"],["尋ね求める","たずねもとめる"],["者","もの"],["は"],["あなた"],["によって"],["喜こび","よろこび"],["楽しむ","たのしむ"],["よう"],["に"],["。"],["あなた"],["の"],["救い","すくい"],["を"],["愛する","あいする"],["者","もの"],["は"],["常","つね"],["に"],["「"],["主","しゅ"],["は"],["大いなる","おおいなる"],["か"],["な"],["」"],["と"],["となえる"],["よう"],["に"],["。"]]},{"verse":18,"text":"[17]わたしは貧,まずしく、かつ乏,とぼしい。しかし主,しゅはわたしをかえりみられます。あなたはわが助,たすけ、わが救主,すくいぬしです。わが神,かみよ、ためらわないでください。","tok":[["["],["17"],["]"],["わたし"],["は"],["貧しく","まずしく"],["、"],["かつ"],["乏い","とぼしい"],["。"],["しかし"],["主","しゅ"],["は"],["わたし"],["を"],["かえりみられます"],["。"],["あなた"],["は"],["わが"],["助け","たすけ"],["、"],["わが"],["救主","す"],["くい"],["ぬし"],["です"],["。"],["わが"],["神","かみ"],["よ"],["、"],["ためらわないで"],["ください"],["。"]]}]
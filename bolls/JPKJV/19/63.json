[{"verse":1,"text":"[0]【ユダの野,のにあったときによんだダビデの歌,うた】","tok":[["["],["0"],["]"],["【"],["ユダ"],["の"],["野","の"],["に"],["あった"],["とき"],["に"],["よんだ"],["ダビデ"],["の"],["歌","うた"],["】"]]},{"verse":2,"text":"[1]神,かみよ、あなたはわたしの神,かみ、わたしは切,せつにあなたをたずね求,もとめ、わが魂,たましいはあなたをかわき望,のぞむ。水,みずなき、かわき衰,おとろえた地,ちにあるように、わが肉体,にくたいはあなたを慕,したいこがれる。","tok":[["["],["1"],["]"],["神","かみ"],["よ"],["、"],["あなた"],["は"],["わたし"],["の"],["神","かみ"],["、"],["わたし"],["は"],["切に","せつに"],["あなた"],["を"],["たずね求め","たずねもとめ"],["、"],["わが"],["魂","たましい"],["は"],["あなた"],["を"],["かわき"],["望む","のぞむ"],["。"],["水","みず"],["なき"],["、"],["かわき"],["衰えた","おとろえた"],["地","ち"],["に"],["ある"],["よう"],["に"],["、"],["わが"],["肉体","にくたい"],["は"],["あなた"],["を"],["慕い","したい"],["こがれる"],["。"]]},{"verse":3,"text":"[2]それでわたしはあなたの力,ちからと栄,さかえとを見,みようと、聖所,せいじょにあって目,めをあなたに注,そそいだ。","tok":[["["],["2"],["]"],["それ"],["で"],["わたし"],["は"],["あなた"],["の"],["力","ちから"],["と"],["栄","さかえ"],["と"],["を"],["見よう","みよう"],["と"],["、"],["聖","せい"],["所","しょ"],["に"],["あって"],["目","め"],["を"],["あなた"],["に"],["注いだ","そそいだ"],["。"]]},{"verse":4,"text":"[3]あなたのいつくしみは、いのちにもまさるゆえ、わがくちびるはあなたをほめたたえる。","tok":[["["],["3"],["]"],["あなた"],["の"],["いつくしみ"],["は"],["、"],["いのち"],["に"],["も"],["まさる"],["ゆえ"],["、"],["わが"],["くちびる"],["は"],["あなた"],["を"],["ほめたたえる"],["。"]]},{"verse":5,"text":"[4]わたしは生,いきながらえる間,あいだ、あなたをほめ、手,てをあげて、み名,なを呼,よびまつる。","tok":[["["],["4"],["]"],["わたし"],["は"],["生きながらえる","いきながらえる"],["間","あ"],["い"],["だ"],["、"],["あなた"],["を"],["ほめ"],["、"],["手","て"],["を"],["あげて"],["、"],["み名","みな"],["を"],["呼び","よび"],["まつる"],["。"]]},{"verse":6,"text":"[5-6]わたしが床,とこの上,うえであなたを思,おもいだし、夜,よのふけるままにあなたを深,ふかく思,おもうとき、わたしの魂,たましいは髄,ずいとあぶらとをもってもてなされるように飽,あき足,たり、わたしの口,くちは喜,よろこびのくちびるをもってあなたをほめたたえる。","tok":[["["],["5"],["-"],["6"],["]"],["わたし"],["が"],["床","とこ"],["の"],["上","うえ"],["で"],["あなた"],["を"],["思いだし","おもいだし"],["、"],["夜","よ"],["の"],["ふける"],["まま"],["に"],["あなた"],["を"],["深く","ふかく"],["思う","おもう"],["とき"],["、"],["わたし"],["の"],["魂","たましい"],["は"],["髄","ずい"],["と"],["あぶら"],["と"],["を"],["もって"],["もてなされる"],["よう"],["に"],["飽き足り","あきたり"],["、"],["わたし"],["の"],["口","くち"],["は"],["喜こび","よろこび"],["の"],["くちびる"],["を"],["もって"],["あなた"],["を"],["ほめたたえる"],["。"]]},{"verse":7,"text":"*[5-6]わたしが床,とこの上,うえであなたを思,おもいだし、夜,よのふけるままにあなたを深,ふかく思,おもうとき、わたしの魂,たましいは髄,ずいとあぶらとをもってもてなされるように飽,あき足,たり、わたしの口,くちは喜,よろこびのくちびるをもってあなたをほめたたえる。","tok":[["*"],["["],["5"],["-"],["6"],["]"],["わたし"],["が"],["床","とこ"],["の"],["上","うえ"],["で"],["あなた"],["を"],["思いだし","おもいだし"],["、"],["夜","よ"],["の"],["ふける"],["まま"],["に"],["あなた"],["を"],["深く","ふかく"],["思う","おもう"],["とき"],["、"],["わたし"],["の"],["魂","たましい"],["は"],["髄","ずい"],["と"],["あぶら"],["と"],["を"],["もって"],["もてなされる"],["よう"],["に"],["飽き足り","あきたり"],["、"],["わたし"],["の"],["口","くち"],["は"],["喜こび","よろこび"],["の"],["くちびる"],["を"],["もって"],["あなた"],["を"],["ほめたたえる"],["。"]]},{"verse":8,"text":"[7]あなたはわたしの助,たすけとなられたゆえ、わたしはあなたの翼,つばさの陰,かげで喜,よろこび歌,うたう。","tok":[["["],["7"],["]"],["あなた"],["は"],["わたし"],["の"],["助け","たすけ"],["と"],["なられた"],["ゆえ"],["、"],["わたし"],["は"],["あなた"],["の"],["翼","つばさ"],["の"],["陰","かげ"],["で"],["喜こび","よろこび"],["歌う","うたう"],["。"]]},{"verse":9,"text":"[8]わたしの魂,たましいはあなたにすがりつき、あなたの右,みぎの手,てはわたしをささえられる。","tok":[["["],["8"],["]"],["わたし"],["の"],["魂","たましい"],["は"],["あなた"],["に"],["すがりつき"],["、"],["あなた"],["の"],["右","みぎ"],["の"],["手","て"],["は"],["わたし"],["を"],["ささえられる"],["。"]]},{"verse":10,"text":"[9]しかしわたしの魂,たましいを滅,ほろぼそうとたずね求,もとめる者,ものは地,ちの深,ふかき所,ところに行,いき、","tok":[["["],["9"],["]"],["しかし"],["わたし"],["の"],["魂","たましい"],["を"],["滅ぼそう","ほろぼそう"],["と"],["たずね求める","たずねもとめる"],["者","もの"],["は"],["地","ち"],["の"],["深き","ふかき"],["所","ところ"],["に"],["行き","いき"],["、"]]},{"verse":11,"text":"[10]つるぎの力,ちからにわたされ、山犬,やまいぬのえじきとなる。","tok":[["["],["10"],["]"],["つるぎ"],["の"],["力","ちから"],["に"],["わたされ"],["、"],["山犬","やまいぬ"],["の"],["えじき"],["と"],["なる"],["。"]]},{"verse":12,"text":"[11]しかし王,おうは神,かみにあって喜,よろこび、神,かみによって誓,ちかう者,ものはみな誇,ほこることができる。偽,いつわりを言,いう者,ものの口,くちはふさがれるからである。","tok":[["["],["11"],["]"],["しかし"],["王","おう"],["は"],["神","かみ"],["に"],["あって"],["喜こび","よろこび"],["、"],["神","かみ"],["によって"],["誓う","ちかう"],["者","もの"],["は"],["みな"],["誇る","ほこる"],["こと"],["が"],["できる"],["。"],["偽り","いつわり"],["を"],["言う","いう"],["者","もの"],["の"],["口","くち"],["は"],["ふさがれる"],["から"],["で"],["ある"],["。"]]}]
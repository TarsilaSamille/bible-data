[{"verse":1,"text":"第,だい三,さん巻,かん【アサフの歌,うた】神,かみは正,ただしい者,ものにむかい、心,こころの清,きよい者,ものにむかって、まことに恵,めぐみふかい。","tok":[["第","だい"],["三","さん"],["巻","かん"],["【"],["アサフ"],["の"],["歌","うた"],["】"],["神","かみ"],["は"],["正い","ただしい"],["者","もの"],["に"],["むかい"],["、"],["心","こころ"],["の"],["清い","きよい"],["者","もの"],["に"],["むかって"],["、"],["まこと"],["に"],["恵","めぐみ"],["ふかい"],["。"]]},{"verse":2,"text":"しかし、わたしは、わたしの足,あしがつまずくばかり、わたしの歩,あゆみがすべるばかりであった。","tok":[["しかし"],["、"],["わたし"],["は"],["、"],["わたし"],["の"],["足","あし"],["が"],["つまずく"],["ばかり"],["、"],["わたし"],["の"],["歩み","あゆみ"],["が"],["すべる"],["ばかり"],["で"],["あった"],["。"]]},{"verse":3,"text":"これはわたしが、悪,あしき者,ものの栄,さかえるのを見,みて、その高,たかぶる者,ものをねたんだからである。","tok":[["これ"],["は"],["わたし"],["が"],["、"],["悪しき","あしき"],["者","もの"],["の"],["栄","さかえ"],["る"],["の"],["を"],["見て","みて"],["、"],["その"],["高ぶる","たかぶる"],["者","もの"],["を"],["ねたんだ"],["から"],["で"],["ある"],["。"]]},{"verse":4,"text":"彼,かれらには苦,くるしみがなく、その身,みはすこやかで、つやがあり、","tok":[["彼","かれ"],["ら"],["に"],["は"],["苦しみ","くるしみ"],["が"],["なく"],["、"],["その"],["身","み"],["は"],["すこやか"],["で"],["、"],["つや"],["が"],["あり"],["、"]]},{"verse":5,"text":"ほかの人々,ひとびとのように悩,なやむことがなく、ほかの人々,ひとびとのように打,うたれることはない。","tok":[["ほか"],["の"],["人々","ひとびと"],["の"],["よう"],["に"],["悩む","なやむ"],["こと"],["が"],["なく"],["、"],["ほか"],["の"],["人々","ひとびと"],["の"],["よう"],["に"],["打たれる","うたれる"],["こと"],["は"],["ない"],["。"]]},{"verse":6,"text":"それゆえ高慢,こうまんは彼,かれらの首,くび飾,かざりとなり、暴力,ぼうりょくは衣,ころものように彼,かれらをおおっている。","tok":[["それ"],["ゆえ"],["高慢","こうまん"],["は"],["彼","かれ"],["ら"],["の"],["首飾","くびかざり"],["と"],["なり"],["、"],["暴力","ぼうりょく"],["は"],["衣","ころも"],["の"],["よう"],["に"],["彼","かれ"],["ら"],["を"],["おおって"],["いる"],["。"]]},{"verse":7,"text":"彼,かれらは肥,こえ太,ふとって、その目,めはとびいで、その心,こころは愚,おろかな思,おもいに満,みちあふれている。","tok":[["彼","かれ"],["ら"],["は"],["肥","こえ"],["太って","ふとって"],["、"],["その"],["目","め"],["は"],["とび"],["いで"],["、"],["その"],["心","こころ"],["は"],["愚か","おろか"],["な"],["思い","おもい"],["に"],["満ちあふれて","みちあふれて"],["いる"],["。"]]},{"verse":8,"text":"彼,かれらはあざけり、悪意,あくいをもって語,かたり、高,たかぶって、しえたげを語,かたる。","tok":[["彼","かれ"],["ら"],["は"],["あざけり"],["、"],["悪意","あくい"],["を"],["もって"],["語り","かたり"],["、"],["高か","たか"],["ぶっ"],["て"],["、"],["し"],["えたげ"],["を"],["語る","かたる"],["。"]]},{"verse":9,"text":"彼,かれらはその口,くちを天,てんにさからって置,おき、その舌,したは地,ちをあるきまわる。","tok":[["彼","かれ"],["ら"],["は"],["その"],["口","くち"],["を"],["天","てん"],["に"],["さからって"],["置き","おき"],["、"],["その"],["舌","した"],["は"],["地","ち"],["を"],["あるきまわる"],["。"]]},{"verse":10,"text":"それゆえ民,たみは心,こころを変,かえて彼,かれらをほめたたえ、彼,かれらのうちにあやまちを認,みとめない。","tok":[["それ"],["ゆえ民","ゆえたみ"],["は"],["心","こころ"],["を"],["変えて","かえて"],["彼","かれ"],["ら"],["を"],["ほめたたえ"],["、"],["彼","かれ"],["ら"],["の"],["うち"],["に"],["あやまち"],["を"],["認めない","みとめない"],["。"]]},{"verse":11,"text":"彼,かれらは言,いう、「神,かみはどうして知,しり得,えようか、いと高,たかき者,ものに知識,ちしきがあろうか」と。","tok":[["彼","かれ"],["ら"],["は"],["言う","いう"],["、"],["「"],["神","かみ"],["は"],["どう"],["して"],["知り","しり"],["得よう","えよう"],["か"],["、"],["いと"],["高き","たかき"],["者","もの"],["に"],["知識","ちしき"],["が"],["あろう"],["か"],["」"],["と"],["。"]]},{"verse":12,"text":"見,みよ、これらは悪,あしき者,ものであるのに、常,つねに安,やすらかで、その富,とみが増,まし加,くわわる。","tok":[["見よ","みよ"],["、"],["これ"],["ら"],["は"],["悪しき","あしき"],["者","もの"],["で"],["ある"],["のに"],["、"],["常","つね"],["に"],["安らか","やすらか"],["で"],["、"],["その"],["富","とみ"],["が"],["増し","まし"],["加わわる","くわわる"],["。"]]},{"verse":13,"text":"まことに、わたしはいたずらに心,こころをきよめ、罪,つみを犯,おかすことなく手,てを洗,あらった。","tok":[["まこと"],["に"],["、"],["わたし"],["は"],["いたずら"],["に"],["心","こころ"],["を"],["きよめ"],["、"],["罪","つみ"],["を"],["犯す","おかす"],["こと"],["なく"],["手","て"],["を"],["洗った","あらった"],["。"]]},{"verse":14,"text":"わたしはひねもす打,うたれ、朝,あさごとに懲,こらしめをうけた。","tok":[["わたし"],["は"],["ひねもす"],["打たれ","うたれ"],["、"],["朝","あさ"],["ごと"],["に"],["懲らしめ","こらしめ"],["を"],["うけた"],["。"]]},{"verse":15,"text":"もしわたしが「このような事,ことを語,かたろう」と言,いったなら、わたしはあなたの子,こらの代,よを誤,あやまらせたであろう。","tok":[["もし"],["わたし"],["が"],["「"],["この"],["よう"],["な"],["事","こと"],["を"],["語ろう","かたろう"],["」"],["と"],["言ったなら","いったなら"],["、"],["わたし"],["は"],["あなた"],["の"],["子","こ"],["ら"],["の"],["代","よ"],["を"],["誤らせたで","あやまらせたで"],["あろう"],["。"]]},{"verse":16,"text":"しかし、わたしがこれを知,しろうと思,おもいめぐらしたとき、これはわたしにめんどうな仕事,しごとのように思,おもわれた。","tok":[["しかし"],["、"],["わたし"],["が"],["これ"],["を"],["知ろう","しろう"],["と"],["思いめぐらした","おもいめぐらした"],["とき"],["、"],["これ"],["は"],["わたし"],["に"],["めんどう"],["な"],["仕事","しごと"],["の"],["よう"],["に"],["思われた","おもわれた"],["。"]]},{"verse":17,"text":"わたしが神,かみの聖所,せいじょに行,いって、彼,かれらの最後,さいごを悟,さとり得,えたまではそうであった。","tok":[["わたし"],["が"],["神","かみ"],["の"],["聖","せい"],["所","しょ"],["に"],["行って","いって"],["、"],["彼","かれ"],["ら"],["の"],["最後","さいご"],["を"],["悟り","さとり"],["得た","えた"],["まで"],["は"],["そう"],["で"],["あった"],["。"]]},{"verse":18,"text":"まことにあなたは彼,かれらをなめらかな所,ところに置,おき、彼,かれらを滅,ほろびに陥,おちいらせられる。","tok":[["まこと"],["に"],["あなた"],["は"],["彼","かれ"],["ら"],["を"],["なめらか"],["な"],["所","ところ"],["に"],["置き","おき"],["、"],["彼","かれ"],["ら"],["を"],["滅び","ほろび"],["に"],["陥ち","おち"],["いらせられる"],["。"]]},{"verse":19,"text":"なんと彼,かれらはまたたくまに滅,ほろぼされ、恐,おそれをもって全,まったく一掃,いっそうされたことであろう。","tok":[["なん"],["と"],["彼","かれ"],["ら"],["は"],["またたく"],["ま"],["に"],["滅ぼされ","ほろぼされ"],["、"],["恐","おそれ"],["を"],["もって"],["全く","まったく"],["一掃","いっそう"],["された"],["こと"],["で"],["あろう"],["。"]]},{"verse":20,"text":"あなたが目,めをさまして彼,かれらの影,かげをかろしめられるとき、彼,かれらは夢,ゆめみた人,ひとの目,めをさました時,ときのようである。","tok":[["あなた"],["が"],["目","め"],["を"],["さまして"],["彼","かれ"],["ら"],["の"],["影","かげ"],["を"],["かろしめられる"],["とき"],["、"],["彼","かれ"],["ら"],["は"],["夢みた","ゆめみた"],["人","ひと"],["の"],["目","め"],["を"],["さました"],["時","とき"],["の"],["よう"],["で"],["ある"],["。"]]},{"verse":21,"text":"わたしの魂,たましいが痛,いたみ、わたしの心,こころが刺,さされたとき、","tok":[["わたし"],["の"],["魂","たましい"],["が"],["痛み","いたみ"],["、"],["わたし"],["の"],["心","こころ"],["が"],["刺された","さされた"],["とき"],["、"]]},{"verse":22,"text":"わたしは愚,おろかで悟,さとりがなく、あなたに対,たいしては獣,けもののようであった。","tok":[["わたし"],["は"],["愚か","おろか"],["で"],["悟り","さとり"],["が"],["なく"],["、"],["あなた"],["に対して","にたいして"],["は"],["獣","けもの"],["の"],["よう"],["で"],["あった"],["。"]]},{"verse":23,"text":"けれどもわたしは常,つねにあなたと共,ともにあり、あなたはわたしの右,みぎの手,てを保,たもたれる。","tok":[["けれど"],["も"],["わたし"],["は"],["常","つね"],["に"],["あなた"],["と"],["共","とも"],["に"],["あり"],["、"],["あなた"],["は"],["わたし"],["の"],["右","みぎ"],["の"],["手","て"],["を"],["保たれる","たもたれる"],["。"]]},{"verse":24,"text":"あなたはさとしをもってわたしを導,みちびき、その後,のちわたしを受,うけて栄光,えいこうにあずからせられる。","tok":[["あなた"],["は"],["さとし"],["を"],["もって"],["わたし"],["を"],["導き","みちびき"],["、"],["その後","そののちわたし"],["を"],["受て","うけて"],["栄光","えいこう"],["に"],["あずからせられる"],["。"]]},{"verse":25,"text":"わたしはあなたのほかに、だれを天,てんにもち得,えよう。地,ちにはあなたのほかに慕,したうものはない。","tok":[["わたし"],["は"],["あなた"],["の"],["ほか"],["に"],["、"],["だれ"],["を"],["天","てん"],["に"],["もち"],["得よう","えよう"],["。"],["地","ち"],["に"],["は"],["あなた"],["の"],["ほか"],["に"],["慕う","したう"],["もの"],["は"],["ない"],["。"]]},{"verse":26,"text":"わが身,みとわが心,こころとは衰,おとろえる。しかし神,かみはとこしえにわが心,こころの力,ちから、わが嗣,し業,ぎょうである。","tok":[["わが"],["身","み"],["と"],["わが"],["心","こころ"],["と"],["は"],["衰える","おとろえる"],["。"],["しかし"],["神","かみ"],["は"],["とこしえ"],["に"],["わが"],["心","こころ"],["の"],["力","ちから"],["、"],["わが"],["嗣業","しぎょ"],["うで"],["ある"],["。"]]},{"verse":27,"text":"見,みよ、あなたに遠,とおい者,ものは滅,ほろびる。あなたは、あなたにそむく者,ものを滅,ほろぼされる。","tok":[["見よ","みよ"],["、"],["あなた"],["に"],["遠い","とおい"],["者","もの"],["は"],["滅びる","ほろびる"],["。"],["あなた"],["は"],["、"],["あなた"],["に"],["そむく"],["者","もの"],["を"],["滅ぼされる","ほろぼされる"],["。"]]},{"verse":28,"text":"しかし神,かみに近,ちかくあることはわたしに良,よいことである。わたしは主,しゅなる神,かみをわが避,さけ所,どころとして、あなたのもろもろのみわざを宣,のべ伝,つたえるであろう。","tok":[["しかし"],["神","かみ"],["に"],["近く","ちかく"],["ある"],["こと"],["は"],["わたし"],["に"],["良い","よい"],["こと"],["で"],["ある"],["。"],["わたし"],["は"],["主","しゅ"],["なる"],["神","かみ"],["を"],["わが"],["避け","さけ"],["所","どころ"],["として"],["、"],["あなた"],["の"],["もろもろ"],["のみ"],["わざ"],["を"],["宣べ伝えるで","のべつたえるで"],["あろう"],["。"]]}]
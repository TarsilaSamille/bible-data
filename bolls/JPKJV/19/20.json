[{"verse":1,"text":"[0]【聖歌,せいか隊,たいの指揮者,しきしゃによってうたわせたダビデの歌,うた】","tok":[["["],["0"],["]"],["【"],["聖歌隊","せいかたい"],["の"],["指揮者","しきしゃ"],["によって"],["うたわせた"],["ダビデ"],["の"],["歌","うた"],["】"]]},{"verse":2,"text":"[1]主,しゅが悩,なやみの日,ひにあなたに答,こたえ、ヤコブの神,かみのみ名,ながあなたを守,まもられるように。","tok":[["["],["1"],["]"],["主","しゅ"],["が"],["悩み","なやみ"],["の"],["日","ひ"],["に"],["あなた"],["に"],["答","こたえ"],["、"],["ヤコブ"],["の"],["神","かみ"],["のみ"],["名","な"],["が"],["あなた"],["を"],["守られる","まもられる"],["よう"],["に"],["。"]]},{"verse":3,"text":"[2]主,しゅが聖所,せいじょから助,たすけをあなたにおくり、シオンからあなたをささえ、","tok":[["["],["2"],["]"],["主","しゅ"],["が"],["聖","せい"],["所","しょ"],["ら"],["助け","たすけ"],["を"],["あなた"],["に"],["おくり"],["、"],["シオン"],["から"],["あなた"],["を"],["ささえ"],["、"]]},{"verse":4,"text":"[3]あなたのもろもろの供,そなえ物,ものをみ心,こころにとめ、あなたの燔祭,はんさいをうけられるように。〔セラ","tok":[["["],["3"],["]"],["あなた"],["の"],["もろもろ"],["の"],["供え物","そなえもの"],["を"],["み心","みこころ"],["に"],["とめ"],["、"],["あなた"],["の"],["燔祭","はんさい"],["を"],["うけられる"],["よう"],["に"],["。"],["〔"],["セラ"]]},{"verse":5,"text":"[4]主,しゅがあなたの心,こころの願,ねがいをゆるし、あなたのはかりごとをことごとく遂,とげさせられるように。","tok":[["["],["4"],["]"],["主","しゅ"],["が"],["あなた"],["の"],["心","こころ"],["の"],["願い","ねがい"],["を"],["ゆるし"],["、"],["あなた"],["の"],["はかりごと"],["を"],["ことごとく"],["遂げさせられる","とげさせられる"],["よう"],["に"],["。"]]},{"verse":6,"text":"[5]われらがあなたの勝利,しょうりを喜,よろこびうたい、われらの神,かみのみ名,なによって旗,はたを揚,あげるように。主,しゅがあなたの求,もとめをすべて遂,とげさせられるように。","tok":[["["],["5"],["]"],["われ"],["ら"],["が"],["あなた"],["の"],["勝利","しょうり"],["を"],["喜こび","よろこび"],["うたい"],["、"],["われ"],["ら"],["の"],["神","かみ"],["のみ"],["名","な"],["によって"],["旗","はた"],["を"],["揚げる","あげる"],["よう"],["に"],["。"],["主","しゅ"],["が"],["あなた"],["の"],["求め","もとめ"],["を"],["すべて"],["遂げさせられる","とげさせられる"],["よう"],["に"],["。"]]},{"verse":7,"text":"[6]今,いまわたしは知,しる、主,しゅはその油,あぶらそそがれた者,ものを助,たすけられることを。主,しゅはその右,みぎの手,てによる大,おおいなる勝利,しょうりをもってその聖,せいなる天,てんから彼,かれに答,こたえられるであろう。","tok":[["["],["6"],["]"],["今","いま"],["わたし"],["は"],["知る","しる"],["、"],["主","しゅ"],["は"],["その"],["油","あぶら"],["そそがれた"],["者","もの"],["を"],["助けられる","たすけられる"],["こと"],["を"],["。"],["主","しゅ"],["は"],["その"],["右","みぎ"],["の"],["手","て"],["に"],["よる"],["大いなる","おおいなる"],["勝利","しょうり"],["を"],["もって"],["その"],["聖","せい"],["なる"],["天","てん"],["から"],["彼","かれ"],["に"],["答","こたえ"],["られるで"],["あろう"],["。"]]},{"verse":8,"text":"[7]ある者,ものは戦車,せんしゃを誇,ほこり、ある者,ものは馬,うまを誇,ほこる。しかしわれらは、われらの神,かみ、主,しゅのみ名,なを誇,ほこる。","tok":[["["],["7"],["]"],["ある"],["者","もの"],["は"],["戦車","せんしゃ"],["を"],["誇","ほこり"],["、"],["ある"],["者","もの"],["は"],["馬","うま"],["を"],["誇る","ほこる"],["。"],["しかし"],["われ"],["ら"],["は"],["、"],["われ"],["ら"],["の"],["神","かみ"],["、"],["主","しゅ"],["のみ"],["名","な"],["を"],["誇る","ほこる"],["。"]]},{"verse":9,"text":"[8]彼,かれらはかがみ、また倒,たおれる。しかしわれらは起,おきて、まっすぐに立,たつ。","tok":[["["],["8"],["]"],["彼","かれ"],["ら"],["は"],["かがみ"],["、"],["また"],["倒れる","たおれる"],["。"],["しかし"],["われ"],["ら"],["は"],["起きて","おきて"],["、"],["まっすぐ"],["に"],["立つ","たつ"],["。"]]},{"verse":10,"text":"[9]主,しゅよ、王,おうに勝利,しょうりをおさずけください。われらが呼,よばわる時,とき、われらにお答,こたえください。","tok":[["["],["9"],["]"],["主","しゅ"],["よ"],["、"],["王","おう"],["に"],["勝利","しょうり"],["を"],["おさずけ"],["ください"],["。"],["われ"],["ら"],["が"],["呼ばわる","よばわる"],["時","とき"],["、"],["われ"],["ら"],["に"],["お答","おこたえ"],["ください"],["。"]]}]
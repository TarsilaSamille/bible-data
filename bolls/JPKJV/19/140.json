[{"verse":1,"text":"[0]【聖歌,せいか隊,たいの指揮者,しきしゃによってうたわせたダビデの歌,うた】","tok":[["["],["0"],["]"],["【"],["聖歌隊","せいかたい"],["の"],["指揮者","しきしゃ"],["によって"],["うたわせた"],["ダビデ"],["の"],["歌","うた"],["】"]]},{"verse":2,"text":"[1]主,しゅよ、悪,あしき人々,ひとびとからわたしを助,たすけ出,だし、わたしを守,まもって、乱暴,らんぼうな人々,ひとびとからのがれさせてください。","tok":[["["],["1"],["]"],["主","しゅ"],["よ"],["、"],["悪しき","あしき"],["人々","ひとびと"],["から"],["わたし"],["を"],["助け出し","たすけだし"],["、"],["わたし"],["を"],["守って","まもって"],["、"],["乱暴","らんぼう"],["な"],["人々","ひとびと"],["から"],["のがれさせて"],["ください"],["。"]]},{"verse":3,"text":"[2]彼,かれらは心,こころのうちに悪,わるい事,ことをはかり、絶,たえず戦,たたかいを起,おこします。","tok":[["["],["2"],["]"],["彼","かれ"],["ら"],["は"],["心","こころ"],["の"],["うち"],["に"],["悪い","わるい"],["事","こと"],["を"],["はかり"],["、"],["絶えず","たえず"],["戦い","たたかい"],["を"],["起こします","おこします"],["。"]]},{"verse":4,"text":"[3]彼,かれらはへびのようにおのが舌,したを鋭,するどくし、そのくちびるの下,したにはまむしの毒,どくがあります。〔セラ","tok":[["["],["3"],["]"],["彼","かれ"],["ら"],["は"],["へび"],["の"],["よう"],["に"],["お"],["の"],["が"],["舌","した"],["を"],["鋭く","するどく"],["し"],["、"],["その"],["くちびる"],["の"],["下","した"],["に"],["は"],["まむし"],["の"],["毒","どく"],["が"],["あります"],["。"],["〔"],["セラ"]]},{"verse":5,"text":"[4]主,しゅよ、わたしを保,たもって、悪,あしき人,ひとの手,てからのがれさせ、わたしを守,まもって、わが足,あしをつまずかせようとする乱暴,らんぼうな人々,ひとびとからのがれさせてください。","tok":[["["],["4"],["]"],["主","しゅ"],["よ"],["、"],["わたし"],["を"],["保って","たもって"],["、"],["悪しき","あしき"],["人","ひと"],["の"],["手","て"],["から"],["のがれさせ"],["、"],["わたし"],["を"],["守って","まもって"],["、"],["わが"],["足","あし"],["を"],["つまずかせよう"],["と"],["する"],["乱暴","らんぼう"],["な"],["人々","ひとびと"],["から"],["のがれさせて"],["ください"],["。"]]},{"verse":6,"text":"[5]高,たかぶる者,ものはわたしのためにわなを伏,ふせ、綱,つなをもって網,あみを張,はり、道,みちのほとりにわなを設,もうけました。〔セラ","tok":[["["],["5"],["]"],["高か","たか"],["ぶる"],["者","もの"],["は"],["わたし"],["の"],["ため"],["に"],["わな"],["を"],["伏せ","ふせ"],["、"],["綱","つな"],["を"],["もって"],["網","あみ"],["を"],["張り","はり"],["、"],["道","みち"],["の"],["ほとり"],["に"],["わな"],["を"],["設けました","もうけました"],["。"],["〔"],["セラ"]]},{"verse":7,"text":"[6]わたしは主,しゅに言,いいます、「あなたはわが神,かみです。主,しゅよ、わが願,ねがいの声,こえに耳,みみを傾,かたむけてください。","tok":[["["],["6"],["]"],["わたし"],["は"],["主に","しゅに"],["言います","いいます"],["、"],["「"],["あなた"],["は"],["わが"],["神","かみ"],["です"],["。"],["主","しゅ"],["よ"],["、"],["わが"],["願い","ねがい"],["の"],["声","こえ"],["に"],["耳","みみ"],["を"],["傾むけて","かたむけて"],["ください"],["。"]]},{"verse":8,"text":"[7]わが救,すくいの力,ちから、主,しゅなる神,かみよ、あなたは戦,たたかいの日,ひに、わがこうべをおおわれました。","tok":[["["],["7"],["]"],["わが"],["救い","すくい"],["の"],["力","ちから"],["、"],["主","しゅ"],["なる"],["神","かみ"],["よ"],["、"],["あなた"],["は"],["戦い","たたかい"],["の"],["日","ひ"],["に"],["、"],["わが"],["こうべ"],["を"],["おおわれました"],["。"]]},{"verse":9,"text":"[8]主,しゅよ、悪,あしき人,ひとの願,ねがいをゆるさないでください。その悪,あしき計画,けいかくをとげさせないでください。〔セラ","tok":[["["],["8"],["]"],["主","しゅ"],["よ"],["、"],["悪しき","あしき"],["人","ひと"],["の"],["願い","ねがい"],["を"],["ゆるさないで"],["ください"],["。"],["その"],["悪しき","あしき"],["計画","けいかく"],["を"],["とげさせないで"],["ください"],["。"],["〔"],["セラ"]]},{"verse":10,"text":"[9]わたしを囲,かこむ者,ものがそのこうべをあげるとき、そのくちびるの害悪,がいあくで彼,かれらをおおってください。","tok":[["["],["9"],["]"],["わたし"],["を"],["囲む","かこむ"],["者","もの"],["が"],["その"],["こうべ"],["を"],["あげる"],["とき"],["、"],["その"],["くちびる"],["の"],["害悪","がいあく"],["で"],["彼","かれ"],["ら"],["を"],["おおって"],["ください"],["。"]]},{"verse":11,"text":"[10]燃,もえる炭,すみを彼,かれらの上,うえに落,おとしてください。彼,かれらを穴,あなに投,なげ入,いれ、再,ふたたび上,あがることのできないようにしてください。","tok":[["["],["10"],["]"],["燃える","もえる"],["炭","すみ"],["を"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["落として","おとして"],["ください"],["。"],["彼","かれ"],["ら"],["を"],["穴","あな"],["に"],["投入れ","なげいれ"],["、"],["再び","ふたたび"],["上がる","あがる"],["こと"],["の"],["できない"],["よう"],["に"],["して"],["ください"],["。"]]},{"verse":12,"text":"[11]悪口,わるぐちを言,いう者,ものを世,よに立,たたせないでください。乱暴,らんぼうな人,ひとをすみやかに災,わざわいに追,おい捕,とらえさせてください」。","tok":[["["],["11"],["]"],["悪口","わるぐち"],["を"],["言う","いう"],["者","もの"],["を"],["世","よ"],["に"],["立たせないで","たたせないで"],["ください"],["。"],["乱暴","らんぼう"],["な"],["人","ひと"],["を"],["すみやか"],["に"],["災","わざわい"],["に"],["追い","おい"],["捕らえさせて","とらえさせて"],["ください"],["」"],["。"]]},{"verse":13,"text":"[12]わたしは主,しゅが苦,くるしむ者,ものの訴,うったえをたすけ、貧,まずしい者,もののために正,ただしいさばきを行,おこなわれることを知,しっています。","tok":[["["],["12"],["]"],["わたし"],["は"],["主","しゅ"],["が"],["苦しむ","くるしむ"],["者","もの"],["の"],["訴","うったえ"],["を"],["たすけ"],["、"],["貧しい","まずしい"],["者","もの"],["の"],["ため"],["に"],["正い","ただしい"],["さばき"],["を"],["行なわれる","おこなわれる"],["こと"],["を"],["知って","しって"],["います"],["。"]]},{"verse":14,"text":"[13]正,ただしい人,ひとは必,かならずみ名,なに感謝,かんしゃし、直,なおき人,ひとはみ前,まえに住,すむでしょう。","tok":[["["],["13"],["]"],["正い","ただしい"],["人","ひと"],["は"],["必","かならず"],["み名","みな"],["に"],["感謝","かんしゃ"],["し"],["、"],["直","な"],["おき"],["人","ひと"],["は"],["み前","みまえ"],["に"],["住むでしょう","すむでしょう"],["。"]]}]
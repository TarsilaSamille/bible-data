[{"verse":1,"text":"[0]【聖歌,せいか隊,たいの指揮者,しきしゃによってゆりの花,はなのしらべにあわせてうたわせたダビデの歌,うた】","tok":[["["],["0"],["]"],["【"],["聖歌隊","せいかたい"],["の"],["指揮者","しきしゃ"],["によって"],["ゆり"],["の"],["花","はな"],["の"],["しらべ"],["に"],["あわせて"],["うたわせた"],["ダビデ"],["の"],["歌","うた"],["】"]]},{"verse":2,"text":"[1]神,かみよ、わたしをお救,すくいください。大水,おおみずが流,ながれ来,きて、わたしの首,くびにまで達,たっしました。","tok":[["["],["1"],["]"],["神","かみ"],["よ"],["、"],["わたし"],["を"],["お救い","おすくい"],["ください"],["。"],["大水","おおみず"],["が"],["流れ","ながれ"],["来て","きて"],["、"],["わたし"],["の"],["首","くび"],["に"],["まで"],["達しました","たっしました"],["。"]]},{"verse":3,"text":"[2]わたしは足,あしがかりもない深,ふかい泥,どろの中,なかに沈,しずみました。わたしは深,ふかい水,みずに陥,おちいり、大水,おおみずがわたしの上,うえを流,ながれ過,すぎました。","tok":[["["],["2"],["]"],["わたし"],["は"],["足がかり","あしがかり"],["も"],["ない"],["深","ふ"],["かい"],["泥","どろ"],["の"],["中","なか"],["に"],["沈みました","しずみました"],["。"],["わたし"],["は"],["深","ふ"],["かい水","かいみず"],["に"],["陥ち","おち"],["いり"],["、"],["大水","おおみず"],["が"],["わたし"],["の"],["上","うえ"],["を"],["流れ","ながれ"],["過ました","すぎました"],["。"]]},{"verse":4,"text":"[3]わたしは叫,さけびによって疲,つかれ、わたしののどはかわき、わたしの目,めは神,かみを待,まちわびて衰,おとろえました。","tok":[["["],["3"],["]"],["わたし"],["は"],["叫","さけび"],["によって"],["疲れ","つかれ"],["、"],["わたし"],["の"],["のど"],["は"],["かわき"],["、"],["わたし"],["の"],["目","め"],["は"],["神","かみ"],["を"],["待","まち"],["わびて"],["衰えました","おとろえました"],["。"]]},{"verse":5,"text":"[4]ゆえなく、わたしを憎,にくむ者,ものはわたしの頭,あたまの毛,けよりも多,おおく、偽,いつわってわたしの敵,てきとなり、わたしを滅,ほろぼそうとする者,ものは強,つよいのです。わたしは盗,ぬすまなかった物,ものをも償,つぐなわなければならないのですか。","tok":[["["],["4"],["]"],["ゆえ"],["なく"],["、"],["わたし"],["を"],["憎む","にくむ"],["者","もの"],["は"],["わたし"],["の"],["頭","あたま"],["の"],["毛","け"],["より"],["も"],["多く","おおく"],["、"],["偽わって","いつわって"],["わたし"],["の"],["敵","てき"],["と"],["なり"],["、"],["わたし"],["を"],["滅ぼそう","ほろぼそう"],["と"],["する"],["者","もの"],["は"],["強い","つよい"],["の"],["です"],["。"],["わたし"],["は"],["盗まなかった","ぬすまなかった"],["物","もの"],["を"],["も"],["償なわなければ","つぐなわなければ"],["ならない"],["の"],["です"],["か"],["。"]]},{"verse":6,"text":"[5]神,かみよ、あなたはわたしの愚,おろかなことを知,しっておられます。わたしのもろもろのとがはあなたに隠,かくれることはありません。","tok":[["["],["5"],["]"],["神","かみ"],["よ"],["、"],["あなた"],["は"],["わたし"],["の"],["愚か","おろか"],["な"],["こと"],["を"],["知って","しって"],["おられます"],["。"],["わたし"],["の"],["もろもろ"],["の"],["とが"],["は"],["あなた"],["に"],["隠れる","かくれる"],["こと"],["は"],["ありません"],["。"]]},{"verse":7,"text":"[6]万軍,ばんぐんの神,かみ、主,しゅよ、あなたを待,まち望,のぞむ者,ものがわたしの事,ことによって、はずかしめられることのないようにしてください。イスラエルの神,かみよ、あなたを求,もとめる者,ものがわたしの事,ことによって、恥,はじを負,おわせられることのないようにしてください。","tok":[["["],["6"],["]"],["万","まん"],["軍","ぐん"],["の"],["神","かみ"],["、"],["主","しゅ"],["よ"],["、"],["あなた"],["を"],["待ち望む","まちのぞむ"],["者","もの"],["が"],["わたし"],["の"],["事","こと"],["によって"],["、"],["はずかしめられる"],["こと"],["の"],["ない"],["よう"],["に"],["して"],["ください"],["。"],["イスラエル"],["の"],["神","かみ"],["よ"],["、"],["あなた"],["を"],["求める","もとめる"],["者","もの"],["が"],["わたし"],["の"],["事","こと"],["によって"],["、"],["恥","はじ"],["を"],["負わせられる","おわせられる"],["こと"],["の"],["ない"],["よう"],["に"],["して"],["ください"],["。"]]},{"verse":8,"text":"[7]わたしはあなたのためにそしりを負,おい、恥,はじがわたしの顔,かおをおおったのです。","tok":[["["],["7"],["]"],["わたし"],["は"],["あなた"],["の"],["ため"],["に"],["そしり"],["を"],["負い","おい"],["、"],["恥","はじ"],["が"],["わたし"],["の"],["顔","かお"],["を"],["おおった"],["の"],["です"],["。"]]},{"verse":9,"text":"[8]わたしはわが兄弟,きょうだいには、知,しらぬ者,ものとなり、わが母,ははの子,こらには、のけ者,ものとなりました。","tok":[["["],["8"],["]"],["わたし"],["は"],["わが"],["兄弟","きょうだい"],["に"],["は"],["、"],["知らぬ","しらぬ"],["者","もの"],["と"],["なり"],["、"],["わが"],["母","はは"],["の"],["子","こ"],["ら"],["に"],["は"],["、"],["のけ者","のけもの"],["と"],["なりました"],["。"]]},{"verse":10,"text":"[9]あなたの家,いえを思,おもう熱心,ねっしんがわたしを食,くいつくし、あなたをそしる者,もののそしりがわたしに及,およんだからです。","tok":[["["],["9"],["]"],["あなた"],["の"],["家","いえ"],["を"],["思う","おもう"],["熱心","ねっしん"],["が"],["わたし"],["を"],["食いつく","くいつく"],["し"],["、"],["あなた"],["を"],["そしる"],["者","もの"],["の"],["そしり"],["が"],["わたし"],["に"],["及んだ","およんだ"],["から"],["です"],["。"]]},{"verse":11,"text":"[10]わたしが断食,だんじきをもってわたしの魂,たましいを悩,なやませば、かえってそれによってそしりをうけました。","tok":[["["],["10"],["]"],["わたし"],["が"],["断食","だんじき"],["を"],["もって"],["わたし"],["の"],["魂","たましい"],["を"],["悩せば","なやませば"],["、"],["かえって"],["それ"],["によって"],["そ"],["しり"],["を"],["うけました"],["。"]]},{"verse":12,"text":"[11]わたしが荒布,あらぬのを衣,ころもとすれば、かえって彼,かれらのことわざとなりました。","tok":[["["],["11"],["]"],["わたし"],["が"],["荒布","あらぬ"],["の"],["を"],["衣","ころも"],["と"],["すれば"],["、"],["かえって"],["彼","かれ"],["ら"],["の"],["ことわざ"],["と"],["なりました"],["。"]]},{"verse":13,"text":"[12]わたしは門,もんに座,ざする者,ものの話題,わだいとなり、酔,よいどれの歌,うたとなりました。","tok":[["["],["12"],["]"],["わたし"],["は"],["門","もん"],["に"],["座する","ざする"],["者","もの"],["の"],["話題","わだい"],["と"],["なり"],["、"],["酔","よい"],["どれ"],["の"],["歌","うた"],["と"],["なりました"],["。"]]},{"verse":14,"text":"[13]しかし主,しゅよ、わたしはあなたに祈,いのります。神,かみよ、恵,めぐみの時,ときに、あなたのいつくしみの豊,ゆたかなるにより、わたしにお答,こたえください。","tok":[["["],["13"],["]"],["しかし"],["主","しゅ"],["よ"],["、"],["わたし"],["は"],["あなた"],["に"],["祈","いのり"],["ます"],["。"],["神","かみ"],["よ"],["、"],["恵","めぐみ"],["の"],["時","とき"],["に"],["、"],["あなた"],["の"],["いつくしみ"],["の"],["豊","ゆたか"],["なる"],["に"],["より"],["、"],["わたし"],["に"],["お答","おこたえ"],["ください"],["。"]]},{"verse":15,"text":"[14]あなたのまことの救,すくいにより、わたしを泥,どろの中,なかに沈,しずまぬよう助,たすけ出,だしてください。わたしを憎,にくむ者,ものから、また深,ふかい水,みずからわたしを助,たすけ出,だしてください。","tok":[["["],["14"],["]"],["あなた"],["の"],["まこと"],["の"],["救い","すくい"],["に"],["より"],["、"],["わたし"],["を"],["泥","どろ"],["の"],["中","なか"],["に"],["沈まぬ","しずまぬ"],["よう"],["助け出して","たすけだして"],["ください"],["。"],["わたし"],["を"],["憎む","にくむ"],["者","もの"],["から"],["、"],["また"],["深","ふ"],["かい"],["水","みず"],["から"],["わたし"],["を"],["助け出して","たすけだして"],["ください"],["。"]]},{"verse":16,"text":"[15]大水,おおみずがわたしの上,うえを流,ながれ過,すぎることなく、淵,ふちがわたしをのむことなく、穴,あながその口,くちをわたしの上,うえに閉,とじることのないようにしてください。","tok":[["["],["15"],["]"],["大水","おおみず"],["が"],["わたし"],["の"],["上","うえ"],["を"],["流れ","ながれ"],["過る","すぎる"],["こと"],["なく"],["、"],["淵","ふち"],["が"],["わたし"],["を"],["のむ"],["こと"],["なく"],["、"],["穴","あな"],["が"],["その"],["口","くち"],["を"],["わたし"],["の"],["上","うえ"],["に"],["閉じる","とじる"],["こと"],["の"],["ない"],["よう"],["に"],["して"],["ください"],["。"]]},{"verse":17,"text":"[16]主,しゅよ、あなたのいつくしみの深,ふかきにより、わたしにお答,こたえください。あなたのあわれみの豊,ゆたかなるにより、わたしを顧,かえりみてください。","tok":[["["],["16"],["]"],["主","しゅ"],["よ"],["、"],["あなた"],["の"],["いつくしみ"],["の"],["深き","ふかき"],["に"],["より"],["、"],["わたし"],["に"],["お答","おこたえ"],["ください"],["。"],["あなた"],["の"],["あわれみ"],["の"],["豊","ゆたか"],["なる"],["に"],["より"],["、"],["わたし"],["を"],["顧て","かえりみて"],["ください"],["。"]]},{"verse":18,"text":"[17]あなたの顔,かおをしもべに隠,かくさないでください。わたしは悩,なやんでいるのです。すみやかにわたしにお答,こたえください。","tok":[["["],["17"],["]"],["あなた"],["の"],["顔","かお"],["を"],["しもべ"],["に"],["隠さないで","かくさないで"],["ください"],["。"],["わたし"],["は"],["悩んで","なやんで"],["いる"],["の"],["です"],["。"],["すみやか"],["に"],["わたし"],["に"],["お答","おこたえ"],["ください"],["。"]]},{"verse":19,"text":"[18]わたしに近,ちかく寄,よって、わたしをあがない、わが敵,てきのゆえにわたしをお救,すくいください。","tok":[["["],["18"],["]"],["わたし"],["に"],["近く","ちかく"],["寄って","よって"],["、"],["わたし"],["を"],["あがない"],["、"],["わが"],["敵","てき"],["の"],["ゆえ"],["に"],["わたし"],["を"],["お救い","おすくい"],["ください"],["。"]]},{"verse":20,"text":"[19]あなたはわたしの受,うけるそしりと、恥,はじと、はずかしめとを知,しっておられます。わたしのあだは皆,みなあなたの前,まえにあります。","tok":[["["],["19"],["]"],["あなた"],["は"],["わたし"],["の"],["受ける","うける"],["そしり"],["と"],["、"],["恥","はじ"],["と"],["、"],["はずかしめ"],["と"],["を"],["知って","しって"],["おられます"],["。"],["わたし"],["の"],["あだ"],["は"],["皆","みな"],["あなた"],["の"],["前","まえ"],["に"],["あります"],["。"]]},{"verse":21,"text":"[20]そしりがわたしの心,こころを砕,くだいたので、わたしは望,のぞみを失,うしないました。わたしは同情,どうじょうする者,ものを求,もとめたけれども、ひとりもなく、慰,なぐさめる者,ものを求,もとめたけれども、ひとりも見,みませんでした。","tok":[["["],["20"],["]"],["そしり"],["が"],["わたし"],["の"],["心","こころ"],["を"],["砕いた","くだいた"],["ので"],["、"],["わたし"],["は"],["望み","のぞみ"],["を"],["失ないました","うしないました"],["。"],["わたし"],["は"],["同情","どうじょう"],["する"],["者","もの"],["を"],["求めた","もとめた"],["けれど"],["も"],["、"],["ひとり"],["も"],["なく"],["、"],["慰さめる","なぐさめる"],["者","もの"],["を"],["求めた","もとめた"],["けれど"],["も"],["、"],["ひとり"],["も"],["見ませんでした","みませんでした"],["。"]]},{"verse":22,"text":"[21]彼,かれらはわたしの食物,しょくもつに毒,どくを入,いれ、わたしのかわいた時,ときに酢,すを飲,のませました。","tok":[["["],["21"],["]"],["彼","かれ"],["ら"],["は"],["わたし"],["の"],["食物","しょくもつ"],["に"],["毒","どく"],["を"],["入れ","いれ"],["、"],["わたし"],["の"],["かわいた"],["時","とき"],["に"],["酢","す"],["を"],["飲ませました","のませました"],["。"]]},{"verse":23,"text":"[22]彼,かれらの前,まえの食卓,しょくたくを網,あみとし、彼,かれらが犠牲,ぎせいをささげる祭,まつりを、わなとしてください。","tok":[["["],["22"],["]"],["彼","かれ"],["ら"],["の"],["前","まえ"],["の"],["食卓","しょくたく"],["を"],["網","あみ"],["と"],["し"],["、"],["彼","かれ"],["ら"],["が"],["犠牲","ぎせい"],["を"],["ささげる"],["祭","まつり"],["を"],["、"],["わな"],["として"],["ください"],["。"]]},{"verse":24,"text":"[23]彼,かれらの目,めを暗,くらくして見,みえなくし、彼,かれらの腰,こしを常,つねに震,ふるわせ、","tok":[["["],["23"],["]"],["彼","かれ"],["ら"],["の"],["目","め"],["を"],["暗く","くらく"],["して"],["見えなく","みえなく"],["し"],["、"],["彼","かれ"],["ら"],["の"],["腰","こし"],["を"],["常","つね"],["に"],["震わせ","ふるわせ"],["、"]]},{"verse":25,"text":"[24]あなたの憤,いきどおりを彼,かれらの上,うえにそそぎ、あなたの激,はげしい怒,いかりを彼,かれらに追,おいつかせてください。","tok":[["["],["24"],["]"],["あなた"],["の"],["憤り","いきどおり"],["を"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["そそぎ"],["、"],["あなた"],["の"],["激しい","はげしい"],["怒り","いかり"],["を"],["彼","かれ"],["ら"],["に"],["追いつかせて","おいつかせて"],["ください"],["。"]]},{"verse":26,"text":"[25]彼,かれらの宿営,しゅくえいを荒,あらし、ひとりもその天幕,てんまくに住,すまわせないでください。","tok":[["["],["25"],["]"],["彼","かれ"],["ら"],["の"],["宿営","しゅくえい"],["を"],["荒し","あらし"],["、"],["ひとり"],["も"],["その"],["天幕","てんまく"],["に"],["住まわせないで","すまわせないで"],["ください"],["。"]]},{"verse":27,"text":"[26]彼,かれらはあなたが撃,うたれた者,ものを迫害,はくがいし、あなたが傷,きずつけられた者,ものをさらに苦,くるしめるからです。","tok":[["["],["26"],["]"],["彼","かれ"],["ら"],["は"],["あなた"],["が"],["撃たれた","うたれた"],["者","もの"],["を"],["迫害","はくがい"],["し"],["、"],["あなた"],["が"],["傷つけられた","きずつけられた"],["者","もの"],["を"],["さらに"],["苦しめる","くるしめる"],["から"],["です"],["。"]]},{"verse":28,"text":"[27]彼,かれらに、罰,ばつに罰,ばつを加,くわえ、あなたの赦免,しゃめんにあずからせないでください。","tok":[["["],["27"],["]"],["彼","かれ"],["ら"],["に"],["、"],["罰","ばつ"],["に"],["罰","ばつ"],["を"],["加え","くわえ"],["、"],["あなた"],["の"],["赦免","しゃめん"],["に"],["あずからせないで"],["ください"],["。"]]},{"verse":29,"text":"[28]彼,かれらをいのちの書,かから消,けし去,さって、義人,ぎじんのうちに記録,きろくされることのないようにしてください。","tok":[["["],["28"],["]"],["彼","かれ"],["ら"],["を"],["いのち"],["の"],["書","かか"],["ら"],["消し","けし"],["去て","さって"],["、"],["義人","ぎじん"],["の"],["うち"],["に"],["記録","きろく"],["される"],["こと"],["の"],["ない"],["よう"],["に"],["して"],["ください"],["。"]]},{"verse":30,"text":"[29]しかしわたしは悩,なやみ苦,くるしんでいます。神,かみよ、あなたの救,すくいがわたしを高,たかい所,ところに置,おかれますように。","tok":[["["],["29"],["]"],["しかし"],["わたし"],["は"],["悩み苦しんで","なやみくるしんで"],["います"],["。"],["神","かみ"],["よ"],["、"],["あなた"],["の"],["救い","すくい"],["が"],["わたし"],["を"],["高かい","たかい"],["所","ところ"],["に"],["置かれます","おかれます"],["よう"],["に"],["。"]]},{"verse":31,"text":"[30]わたしは歌,うたをもって神,かみの名,なをほめたたえ、感謝,かんしゃをもって神,かみをあがめます。","tok":[["["],["30"],["]"],["わたし"],["は"],["歌","うた"],["を"],["もって"],["神","かみ"],["の"],["名","な"],["を"],["ほめたたえ"],["、"],["感謝","かんしゃ"],["を"],["もって"],["神","かみ"],["を"],["あがめます"],["。"]]},{"verse":32,"text":"[31]これは雄牛,おうしまたは角,つのとひずめのある雄牛,おうしにまさって主,しゅを喜,よろこばせるでしょう。","tok":[["["],["31"],["]"],["これ"],["は"],["雄牛","おうし"],["また"],["は"],["角","つの"],["と"],["ひずめ"],["の"],["ある"],["雄牛","おうし"],["に"],["まさって"],["主","しゅ"],["を"],["喜こばせるでしょう","よろこばせるでしょう"],["。"]]},{"verse":33,"text":"[32]へりくだる者,ものは、これを見,みて喜,よろこべ。神,かみを求,もとめる者,ものよ、あなたがたの心,こころを生,いきかえらせよ。","tok":[["["],["32"],["]"],["へりくだる"],["者","もの"],["は"],["、"],["これ"],["を"],["見て","みて"],["喜こべ","よろこべ"],["。"],["神","かみ"],["を"],["求める","もとめる"],["者","もの"],["よ"],["、"],["あなた"],["がた"],["の"],["心","こころ"],["を"],["生きかえらせ","いきかえらせ"],["よ"],["。"]]},{"verse":34,"text":"[33]主,しゅは乏,とぼしい者,ものに聞,きき、その捕,とらわれ人,びとをかろしめられないからである。","tok":[["["],["33"],["]"],["主","しゅ"],["は"],["乏い","とぼしい"],["者","もの"],["に"],["聞","きき"],["、"],["その"],["捕らわれ","とらわれ"],["人","びと"],["を"],["かろしめられない"],["から"],["で"],["ある"],["。"]]},{"verse":35,"text":"[34]天,てんと地,ちは主,しゅをほめたたえ、海,うみとその中,なかに動,うごくあらゆるものは主,しゅをほめたたえよ。","tok":[["["],["34"],["]"],["天","てん"],["と"],["地","ち"],["は"],["主","しゅ"],["を"],["ほめたたえ"],["、"],["海","うみ"],["と"],["その"],["中","なか"],["に"],["動く","うごく"],["あらゆる"],["もの"],["は"],["主","しゅ"],["を"],["ほめたたえ"],["よ"],["。"]]},{"verse":36,"text":"[35]神,かみはシオンを救,すくい、ユダの町々,まちまちを建,たて直,なおされるからである。そのしもべらはそこに住,すんでこれを所有,しょゆうし、","tok":[["["],["35"],["]"],["神","かみ"],["は"],["シオン"],["を"],["救い","すくい"],["、"],["ユダ"],["の"],["町々","まちまち"],["を"],["建て直される","たてなおされる"],["から"],["で"],["ある"],["。"],["その"],["しもべ"],["ら"],["は"],["そこ"],["に"],["住","すんでこれ"],["を"],["所有","しょゆう"],["し"],["、"]]},{"verse":37,"text":"[36]そのしもべらの子孫,しそんはこれを継,つぎ、み名,なを愛,あいする者,ものはその中,なかに住,すむであろう。","tok":[["["],["36"],["]"],["その"],["しもべ"],["ら"],["の"],["子孫","しそん"],["は"],["これ"],["を"],["継","つぎ"],["、"],["み名","みな"],["を"],["愛する","あいする"],["者","もの"],["は"],["その"],["中","なか"],["に"],["住むで","すむで"],["あろう"],["。"]]}]
[{"verse":1,"text":"[0]【聖歌,せいか隊,たいの指揮者,しきしゃによってうたわせたダビデの歌,うた】","tok":[["["],["0"],["]"],["【"],["聖歌隊","せいかたい"],["の"],["指揮者","しきしゃ"],["によって"],["うたわせた"],["ダビデ"],["の"],["歌","うた"],["】"]]},{"verse":2,"text":"[1]もろもろの天,てんは神,かみの栄光,えいこうをあらわし、大空,おおぞらはみ手,てのわざをしめす。","tok":[["["],["1"],["]"],["もろもろ"],["の"],["天","てん"],["は"],["神","かみ"],["の"],["栄光","えいこう"],["を"],["あらわし"],["、"],["大空","おおぞら"],["は"],["み手","みて"],["の"],["わざ"],["を"],["しめす"],["。"]]},{"verse":3,"text":"[2]この日,ひは言葉,ことばをかの日,ひにつたえ、この夜,よは知識,ちしきをかの夜,よにつげる。","tok":[["["],["2"],["]"],["この"],["日","ひ"],["は"],["言葉","ことば"],["を"],["かの"],["日","ひ"],["に"],["つたえ"],["、"],["この"],["夜","よ"],["は"],["知識","ちしき"],["を"],["かの"],["夜","よ"],["に"],["つげる"],["。"]]},{"verse":4,"text":"[3]話,はなすことなく、語,かたることなく、その声,こえも聞,きこえないのに、","tok":[["["],["3"],["]"],["話す","はなす"],["こと"],["なく"],["、"],["語る","かたる"],["こと"],["なく"],["、"],["その"],["声","こえ"],["も"],["聞こえない","きこえない"],["のに"],["、"]]},{"verse":5,"text":"[4]その響,ひびきは全,ぜん地,ちにあまねく、その言葉,ことばは世界,せかいのはてにまで及,およぶ。神,かみは日,ひのために幕屋,まくやを天,てんに設,もうけられた。","tok":[["["],["4"],["]"],["その"],["響","ひびき"],["は"],["全地","ぜんち"],["に"],["あまねく"],["、"],["その"],["言葉","ことば"],["は"],["世界","せかい"],["の"],["はて"],["に"],["まで"],["及ぶ","およぶ"],["。"],["神","かみ"],["は"],["日","ひ"],["の"],["ため"],["に"],["幕屋","まくや"],["を"],["天","てん"],["に"],["設けられた","もうけられた"],["。"]]},{"verse":6,"text":"[5]日,ひは花婿,はなむこがその祝,しゅくのへやから出,でてくるように、また勇士,ゆうしが競,きそい走,はしるように、その道,みちを喜,よろこび走,はしる。","tok":[["["],["5"],["]"],["日","ひ"],["は"],["花婿","はなむこ"],["が"],["その"],["祝","しゅく"],["の"],["へや"],["から"],["出て","でて"],["くる"],["よう"],["に"],["、"],["また"],["勇士","ゆうし"],["が"],["競い","きそい"],["走る","はしる"],["よう"],["に"],["、"],["その"],["道","みち"],["を"],["喜こび","よろこび"],["走る","はしる"],["。"]]},{"verse":7,"text":"[6]それは天,てんのはてからのぼって、天,てんのはてにまで、めぐって行,いく。その暖,あたたまりをこうむらないものはない。","tok":[["["],["6"],["]"],["それ"],["は"],["天","てん"],["の"],["はて"],["から"],["のぼって"],["、"],["天","てん"],["の"],["はて"],["に"],["まで"],["、"],["めぐって"],["行く","いく"],["。"],["その"],["暖まり","あたたまり"],["を"],["こうむらない"],["もの"],["は"],["ない"],["。"]]},{"verse":8,"text":"[7]主,しゅのおきては完全,かんぜんであって、魂,たましいを生,いきかえらせ、主,しゅのあかしは確,たしかであって、無学,むがくな者,ものを賢,かしこくする。","tok":[["["],["7"],["]"],["主","しゅ"],["の"],["おきて"],["は"],["完全","かんぜん"],["で"],["あって"],["、"],["魂","たましい"],["を"],["生きかえらせ","いきかえらせ"],["、"],["主","しゅ"],["の"],["あかし"],["は"],["確か","たしか"],["で"],["あって"],["、"],["無学","むがく"],["な"],["者","もの"],["を"],["賢しこく","かしこく"],["する"],["。"]]},{"verse":9,"text":"[8]主,しゅのさとしは正,ただしくて、心,こころを喜,よろこばせ、主,しゅの戒,いましめはまじりなくて、眼,めを明,あきらかにする。","tok":[["["],["8"],["]"],["主","しゅ"],["の"],["さとし"],["は"],["正くて","ただしくて"],["、"],["心","こころ"],["を"],["喜こばせ","よろこばせ"],["、"],["主","しゅ"],["の"],["戒しめ","いましめ"],["は"],["ま"],["じり"],["なくて"],["、"],["眼","め"],["を"],["明か","あきらか"],["に"],["する"],["。"]]},{"verse":10,"text":"[9]主,しゅを恐,おそれる道,みちは清,きよらかで、とこしえに絶,たえることがなく、主,しゅのさばきは真実,しんじつであって、ことごとく正,ただしい。","tok":[["["],["9"],["]"],["主","しゅ"],["を"],["恐れる","おそれる"],["道","みち"],["は"],["清らか","きよらか"],["で"],["、"],["とこしえ"],["に"],["絶える","たえる"],["こと"],["が"],["なく"],["、"],["主","しゅ"],["の"],["さばき"],["は"],["真実","しんじつ"],["で"],["あって"],["、"],["ことごとく"],["正い","ただしい"],["。"]]},{"verse":11,"text":"[10]これらは金,きんよりも、多,おおくの純金,じゅんきんよりも慕,したわしく、また蜜,みつよりも、蜂,はちの巣,すのしたたりよりも甘,あまい。","tok":[["["],["10"],["]"],["これ"],["ら"],["は"],["金","きん"],["より"],["も"],["、"],["多く","おおく"],["の"],["純金","じゅんきん"],["より"],["も"],["慕わしく","したわしく"],["、"],["また"],["蜜","みつ"],["より"],["も"],["、"],["蜂の巣","はちのす"],["の"],["した"],["たり"],["より"],["も"],["甘い","あまい"],["。"]]},{"verse":12,"text":"[11]あなたのしもべは、これらによって戒,いましめをうける。これらを守,まもれば、大,おおいなる報,むくいがある。","tok":[["["],["11"],["]"],["あなた"],["の"],["しもべ"],["は"],["、"],["これ"],["ら"],["によって"],["戒しめ","いましめ"],["を"],["うける"],["。"],["これ"],["ら"],["を"],["守れば","まもれば"],["、"],["大いなる","おおいなる"],["報い","むくい"],["が"],["ある"],["。"]]},{"verse":13,"text":"[12]だれが自分,じぶんのあやまちを知,しることができましようか。どうか、わたしを隠,かくれたとがから解,とき放,はなってください。","tok":[["["],["12"],["]"],["だれ"],["が"],["自分","じぶん"],["の"],["あやまち"],["を"],["知る","しる"],["こと"],["が"],["できまし"],["よう"],["か"],["。"],["どう"],["か"],["、"],["わたし"],["を"],["隠れた","かくれた"],["とが"],["から"],["解き","とき"],["放","は"],["なって"],["ください"],["。"]]},{"verse":14,"text":"[13]また、あなたのしもべを引,ひきとめて、故意,こいの罪,つみを犯,おかさせず、これに支配,しはいされることのないようにしてください。そうすれば、わたしはあやまちのない者,ものとなって、大,おおいなるとがを免,まぬかれることができるでしょう。","tok":[["["],["13"],["]"],["また"],["、"],["あなた"],["の"],["しもべ"],["を"],["引","ひき"],["とめて"],["、"],["故意","こい"],["の"],["罪","つみ"],["を"],["犯させず","おかさせず"],["、"],["これ"],["に"],["支配","しはい"],["される"],["こと"],["の"],["ない"],["よう"],["に"],["して"],["ください"],["。"],["そう"],["すれば"],["、"],["わたし"],["は"],["あやまち"],["の"],["ない"],["者","もの"],["と"],["なって"],["、"],["大いなる","おおいなる"],["とが"],["を"],["免かれる","まぬかれる"],["こと"],["が"],["できるでしょう"],["。"]]},{"verse":15,"text":"[14]わが岩,いわ、わがあがないぬしなる主,しゅよ、どうか、わたしの口,くちの言葉,ことばと、心,こころの思,おもいがあなたの前,まえに喜,よろこばれますように。","tok":[["["],["14"],["]"],["わが"],["岩","いわ"],["、"],["わが"],["あがないぬ"],["し"],["なる"],["主","しゅ"],["よ"],["、"],["どう"],["か"],["、"],["わたし"],["の"],["口","くち"],["の"],["言葉","ことば"],["と"],["、"],["心","こころ"],["の"],["思い","おもい"],["が"],["あなた"],["の"],["前","まえ"],["に"],["喜こばれます","よろこばれます"],["よう"],["に"],["。"]]}]
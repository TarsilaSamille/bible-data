[{"verse":1,"text":"[0]【聖歌,せいか隊,たいの指揮者,しきしゃによってギテトにあわせてうたわせたダビデの歌,うた】","tok":[["["],["0"],["]"],["【"],["聖歌隊","せいかたい"],["の"],["指揮者","しきしゃ"],["によって"],["ギテト"],["に"],["あわせて"],["うたわせた"],["ダビデ"],["の"],["歌","うた"],["】"]]},{"verse":2,"text":"[1]主,しゅ、われらの主,しゅよ、あなたの名,なは地,ちにあまねく、いかに尊,たっといことでしょう。あなたの栄光,えいこうは天,てんの上,うえにあり、","tok":[["["],["1"],["]"],["主","しゅ"],["、"],["われ"],["ら"],["の"],["主","しゅ"],["よ"],["、"],["あなた"],["の"],["名","な"],["は"],["地","ち"],["に"],["あまねく"],["、"],["いかに"],["尊","た"],["っと"],["いこ"],["と"],["でしょう"],["。"],["あなた"],["の"],["栄光","えいこう"],["は"],["天","てん"],["の"],["上","うえ"],["に"],["あり"],["、"]]},{"verse":3,"text":"[2]みどりごと、ちのみごとの口,くちによって、ほめたたえられています。あなたは敵,てきと恨,うらみを晴,はらす者,ものとを静,しずめるため、あだに備,そなえて、とりでを設,もうけられました。","tok":[["["],["2"],["]"],["みどりご"],["と"],["、"],["ちのみ"],["ごと"],["の"],["口","くち"],["によって"],["、"],["ほめたたえられて"],["います"],["。"],["あなた"],["は"],["敵","てき"],["と"],["恨み","うらみ"],["を"],["晴らす","はらす"],["者","もの"],["と"],["を"],["静める","しずめる"],["ため"],["、"],["あだ"],["に"],["備","そなえ"],["て"],["、"],["とりで"],["を"],["設けられました","もうけられました"],["。"]]},{"verse":4,"text":"[3]わたしは、あなたの指,ゆびのわざなる天,てんを見,み、あなたが設,もうけられた月,つきと星,ほしとを見,みて思,おもいます。","tok":[["["],["3"],["]"],["わたし"],["は"],["、"],["あなた"],["の"],["指","ゆび"],["の"],["わざ"],["なる"],["天","てん"],["を"],["見","み"],["、"],["あなた"],["が"],["設けられた","もうけられた"],["月","つき"],["と"],["星","ほし"],["と"],["を"],["見て","みて"],["思います","おもいます"],["。"]]},{"verse":5,"text":"[4]人,ひとは何者,なにものなので、これをみ心,こころにとめられるのですか、人,ひとの子,こは何者,なにものなので、これを顧,かえりみられるのですか。","tok":[["["],["4"],["]"],["人","ひと"],["は"],["何者","なにもの"],["な"],["ので"],["、"],["これ"],["を"],["み心","みこころ"],["に"],["とめられる"],["の"],["です"],["か"],["、"],["人","ひと"],["の"],["子","こ"],["は"],["何者","なにもの"],["な"],["ので"],["、"],["これ"],["を"],["顧られる","かえりみられる"],["の"],["です"],["か"],["。"]]},{"verse":6,"text":"[5]ただ少,すこしく人,ひとを神,かみよりも低,ひくく造,つくって、栄,さかえと誉,ほまれとをこうむらせ、","tok":[["["],["5"],["]"],["ただ"],["少しく","すこしく"],["人","ひと"],["を"],["神","かみ"],["より"],["も"],["低く","ひくく"],["造って","つくって"],["、"],["栄","さかえ"],["と"],["誉","ほまれ"],["と"],["を"],["こうむらせ"],["、"]]},{"verse":7,"text":"[6]これにみ手,てのわざを治,おさめさせ、よろずの物,ものをその足,あしの下,したにおかれました。","tok":[["["],["6"],["]"],["これ"],["に"],["み手","みて"],["の"],["わざ"],["を"],["治めさせ","おさめさせ"],["、"],["よろず"],["の"],["物","もの"],["を"],["その"],["足","あし"],["の"],["下","した"],["に"],["おかれました"],["。"]]},{"verse":8,"text":"[7]すべての羊,ひつじと牛,うし、また野,のの獣,けもの、","tok":[["["],["7"],["]"],["すべて"],["の"],["羊","ひつじ"],["と"],["牛","うし"],["、"],["また"],["野","の"],["の"],["獣","けもの"],["、"]]},{"verse":9,"text":"[8]空,そらの鳥,とりと海,うみの魚,うお、海路,かいろを通,かようものまでも。","tok":[["["],["8"],["]"],["空","そら"],["の"],["鳥","とり"],["と"],["海","うみ"],["の"],["魚","う"],["お"],["、"],["海路","かいろ"],["を"],["通う","かよう"],["もの"],["まで"],["も"],["。"]]},{"verse":10,"text":"[9]主,しゅ、われらの主,しゅよ、あなたの名,なは地,ちにあまねく、いかに尊,たっといことでしょう。","tok":[["["],["9"],["]"],["主","しゅ"],["、"],["われ"],["ら"],["の"],["主","しゅ"],["よ"],["、"],["あなた"],["の"],["名","な"],["は"],["地","ち"],["に"],["あまねく"],["、"],["いかに"],["尊","た"],["っと"],["いこ"],["と"],["でしょう"],["。"]]}]
[{"verse":1,"text":"[0]【聖歌,せいか隊,たいの指揮者,しきしゃによって女,おんなの声,こえのしらべにあわせてうたわせたコラの子,この歌,うた】","tok":[["["],["0"],["]"],["【"],["聖歌隊","せいかたい"],["の"],["指揮者","しきしゃ"],["によって"],["女","おんな"],["の"],["声","こえ"],["の"],["しらべ"],["に"],["あわせて"],["うたわせた"],["コラ"],["の"],["子","こ"],["の"],["歌","うた"],["】"]]},{"verse":2,"text":"[1]神,かみはわれらの避,さけ所,どころまた力,ちからである。悩,なやめる時,ときのいと近,ちかき助,たすけである。","tok":[["["],["1"],["]"],["神","かみ"],["は"],["われ"],["ら"],["の"],["避け","さけ"],["所","ど"],["ころ"],["また"],["力","ちから"],["で"],["ある"],["。"],["悩める","なやめる"],["時","とき"],["の"],["いと"],["近き","ちかき"],["助け","たすけ"],["で"],["ある"],["。"]]},{"verse":3,"text":"[2]このゆえに、たとい地,ちは変,かわり、山,やまは海,うみの真中,まんなかに移,うつるとも、われらは恐,おそれない。","tok":[["["],["2"],["]"],["この"],["ゆえ"],["に"],["、"],["たとい"],["地","ち"],["は"],["変わり","かわり"],["、"],["山","やま"],["は"],["海","うみ"],["の"],["真中","まんなか"],["に"],["移る","うつる"],["とも"],["、"],["われ"],["ら"],["は"],["恐れない","おそれない"],["。"]]},{"verse":4,"text":"[3]たといその水,みずは鳴,なりとどろき、あわだつとも、そのさわぎによって山,やまは震,ふるえ動,うごくとも、われらは恐,おそれない。〔セラ","tok":[["["],["3"],["]"],["たとい"],["その"],["水","みず"],["は"],["鳴り","なり"],["とどろき"],["、"],["あわだつ"],["とも"],["、"],["その"],["さわぎ"],["によって"],["山","やま"],["は"],["震え動く","ふるえうごく"],["とも"],["、"],["われ"],["ら"],["は"],["恐れない","おそれない"],["。"],["〔"],["セラ"]]},{"verse":5,"text":"[4]一つの川,かわがある。その流,ながれは神,かみの都,みやこを喜,よろこばせ、いと高,たかき者,ものの聖,せいなるすまいを喜,よろこばせる。","tok":[["["],["4"],["]"],["一","ひと"],["つ"],["の"],["川","かわ"],["が"],["ある"],["。"],["その"],["流れ","ながれ"],["は"],["神","かみ"],["の"],["都","みやこ"],["を"],["喜こばせ","よろこばせ"],["、"],["いと"],["高き","たかき"],["者","もの"],["の"],["聖","せい"],["なる"],["すまい"],["を"],["喜こばせる","よろこばせる"],["。"]]},{"verse":6,"text":"[5]神,かみがその中,なかにおられるので、都,みやこはゆるがない。神,かみは朝,あさはやく、これを助,たすけられる。","tok":[["["],["5"],["]"],["神","かみ"],["が"],["その"],["中","なか"],["に"],["おられる"],["ので"],["、"],["都","みやこ"],["は"],["ゆるがない"],["。"],["神","かみ"],["は"],["朝","あさ"],["はやく"],["、"],["これ"],["を"],["助けられる","たすけられる"],["。"]]},{"verse":7,"text":"[6]もろもろの民,たみは騒,さわぎたち、もろもろの国,くには揺,ゆれ動,うごく、神,かみがその声,こえを出,だされると地,ちは溶,とける。","tok":[["["],["6"],["]"],["もろもろ"],["の"],["民","たみ"],["は"],["騒","さわぎ"],["たち"],["、"],["もろもろ"],["の"],["国","くに"],["は"],["揺れ動く","ゆれうごく"],["、"],["神","かみ"],["が"],["その"],["声","こえ"],["を"],["出される","だされる"],["と"],["地","ち"],["は"],["溶ける","とける"],["。"]]},{"verse":8,"text":"[7]万軍,ばんぐんの主,しゅはわれらと共,ともにおられる、ヤコブの神,かみはわれらの避,さけ所,どころである。〔セラ","tok":[["["],["7"],["]"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["われ"],["ら"],["と"],["共","とも"],["に"],["おられる"],["、"],["ヤコブ"],["の"],["神","かみ"],["は"],["われ"],["ら"],["の"],["避け","さけ"],["所","ど"],["ころ"],["で"],["ある"],["。"],["〔"],["セラ"]]},{"verse":9,"text":"[8]来,きて、主,しゅのみわざを見,みよ、主,しゅは驚,おどろくべきことを地,ちに行,おこなわれた。","tok":[["["],["8"],["]"],["来て","きて"],["、"],["主","しゅ"],["のみ"],["わざ"],["を"],["見よ","みよ"],["、"],["主","しゅ"],["は"],["驚ろくべき","おどろくべき"],["こと"],["を"],["地","ち"],["に"],["行なわれた","おこなわれた"],["。"]]},{"verse":10,"text":"[9]主,しゅは地,ちのはてまでも戦,たたかいをやめさせ、弓,ゆみを折,おり、やりを断,たち、戦車,せんしゃを火,ひで焼,やかれる。","tok":[["["],["9"],["]"],["主","しゅ"],["は"],["地","ち"],["の"],["はて"],["まで"],["も"],["戦い","たたかい"],["を"],["やめさせ"],["、"],["弓","ゆみ"],["を"],["折","おり"],["、"],["やり"],["を"],["断ち","たち"],["、"],["戦車","せんしゃ"],["を"],["火","ひ"],["で"],["焼かれる","やかれる"],["。"]]},{"verse":11,"text":"[10]「静,しずまって、わたしこそ神,かみであることを知,しれ。わたしはもろもろの国民,こくみんのうちにあがめられ、全,ぜん地,ちにあがめられる」。","tok":[["["],["10"],["]"],["「"],["静まって","しずまって"],["、"],["わたし"],["こそ"],["神","かみ"],["で"],["ある"],["こと"],["を"],["知れ","しれ"],["。"],["わたし"],["は"],["もろもろ"],["の"],["国民","こくみん"],["の"],["うち"],["に"],["あがめられ"],["、"],["全地","ぜんち"],["に"],["あがめられる"],["」"],["。"]]},{"verse":12,"text":"[11]万軍,ばんぐんの主,しゅはわれらと共,ともにおられる、ヤコブの神,かみはわれらの避,さけ所,どころである。〔セラ","tok":[["["],["11"],["]"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["われ"],["ら"],["と"],["共","とも"],["に"],["おられる"],["、"],["ヤコブ"],["の"],["神","かみ"],["は"],["われ"],["ら"],["の"],["避け","さけ"],["所","ど"],["ころ"],["で"],["ある"],["。"],["〔"],["セラ"]]}]
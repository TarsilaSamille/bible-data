[{"verse":1,"text":"[0]【聖歌,せいか隊,たいの指揮者,しきしゃによってうたわせたコラの子,この歌,うた】","tok":[["["],["0"],["]"],["【"],["聖歌隊","せいかたい"],["の"],["指揮者","しきしゃ"],["によって"],["うたわせた"],["コラ"],["の"],["子","こ"],["の"],["歌","うた"],["】"]]},{"verse":2,"text":"[1]もろもろの民,たみよ、これを聞,きけ、すべて世,よに住,すむ者,ものよ、耳,みみを傾,かたむけよ。","tok":[["["],["1"],["]"],["もろもろ"],["の"],["民","たみ"],["よ"],["、"],["これ"],["を"],["聞け","きけ"],["、"],["すべて"],["世","よ"],["に"],["住む","すむ"],["者","もの"],["よ"],["、"],["耳","みみ"],["を"],["傾むけよ","かたむけよ"],["。"]]},{"verse":3,"text":"[2]低,ていきも高,たかきも、富,とめるも貧,まずしきも、共,ともに耳,みみを傾,かたむけよ。","tok":[["["],["2"],["]"],["低き","ていき"],["も"],["高き","たかき"],["も"],["、"],["富める","とめる"],["も"],["貧しき","まずしき"],["も"],["、"],["共","とも"],["に"],["耳","みみ"],["を"],["傾むけよ","かたむけよ"],["。"]]},{"verse":4,"text":"[3]わが口,くちは知恵,ちえを語,かたり、わが心,こころは知識,ちしきを思,おもう。","tok":[["["],["3"],["]"],["わが"],["口","くち"],["は"],["知恵","ちえ"],["を"],["語り","かたり"],["、"],["わが"],["心","こころ"],["は"],["知識","ちしき"],["を"],["思う","おもう"],["。"]]},{"verse":5,"text":"[4]わたしは耳,みみをたとえに傾,かたむけ、琴,ことを鳴,ならして、わたしのなぞを解,とき明,あかそう。","tok":[["["],["4"],["]"],["わたし"],["は"],["耳","みみ"],["を"],["たとえ"],["に"],["傾むけ","かたむけ"],["、"],["琴","こと"],["を"],["鳴らして","ならして"],["、"],["わたし"],["の"],["なぞ"],["を"],["解き明そう","ときあかそう"],["。"]]},{"verse":6,"text":"[5]わたしをしえたげる者,ものの不義,ふぎがわたしを取,とり囲,かこむ悩,なやみの日,ひに、どうして恐,おそれなければならないのか。","tok":[["["],["5"],["]"],["わたし"],["を"],["し"],["えたげる"],["者","もの"],["の"],["不義","ふぎ"],["が"],["わたし"],["を"],["取囲む","とりかこむ"],["悩み","なやみ"],["の"],["日","ひ"],["に"],["、"],["どう"],["して"],["恐れなければ","おそれなければ"],["ならない"],["の"],["か"],["。"]]},{"verse":7,"text":"[6]彼,かれらはおのが富,とみをたのみ、そのたからの多,おおいのを誇,ほこる人々,ひとびとである。","tok":[["["],["6"],["]"],["彼","かれ"],["ら"],["は"],["お"],["の"],["が"],["富","とみ"],["を"],["たのみ"],["、"],["その"],["たから"],["の"],["多い","おおい"],["の"],["を"],["誇る","ほこる"],["人々","ひとびと"],["で"],["ある"],["。"]]},{"verse":8,"text":"[7]まことに人,ひとはだれも自分,じぶんをあがなうことはできない。そのいのちの価,あたいを神,かみに払,はらうことはできない。","tok":[["["],["7"],["]"],["まこと"],["に"],["人","ひと"],["は"],["だれ"],["も"],["自分","じぶん"],["を"],["あがなう"],["こと"],["は"],["できない"],["。"],["その"],["いのち"],["の"],["価","あたい"],["を"],["神","かみ"],["に"],["払う","はらう"],["こと"],["は"],["できない"],["。"]]},{"verse":9,"text":"[8-9]とこしえに生,いきながらえて、墓,はかを見,みないためにそのいのちをあがなうには、あまりに価,あたい高,たかくて、それを満足,まんぞくに払,はらうことができないからである。","tok":[["["],["8"],["-"],["9"],["]"],["とこしえ"],["に"],["生きながらえて","いきながらえて"],["、"],["墓","はか"],["を"],["見ない","みない"],["ため"],["に"],["その"],["いのち"],["を"],["あがなう"],["に"],["は"],["、"],["あまり"],["に"],["価","あたい"],["高かくて","たかくて"],["、"],["それ"],["を"],["満足","まんぞく"],["に"],["払う","はらう"],["こと"],["が"],["できない"],["から"],["で"],["ある"],["。"]]},{"verse":10,"text":"*[8-9]とこしえに生,いきながらえて、墓,はかを見,みないためにそのいのちをあがなうには、あまりに価,あたい高,たかくて、それを満足,まんぞくに払,はらうことができないからである。","tok":[["*"],["["],["8"],["-"],["9"],["]"],["とこしえ"],["に"],["生きながらえて","いきながらえて"],["、"],["墓","はか"],["を"],["見ない","みない"],["ため"],["に"],["その"],["いのち"],["を"],["あがなう"],["に"],["は"],["、"],["あまり"],["に"],["価","あたい"],["高かくて","たかくて"],["、"],["それ"],["を"],["満足","まんぞく"],["に"],["払う","はらう"],["こと"],["が"],["できない"],["から"],["で"],["ある"],["。"]]},{"verse":11,"text":"[10]まことに賢,かしこい人,ひとも死,しに、愚,おろかな者,ものも、獣,けもののような者,ものも、ひとしく滅,ほろんで、その富,とみを他人,たにんに残,のこすことは人,ひとの見,みるところである。","tok":[["["],["10"],["]"],["まこと"],["に"],["賢しこい","かしこい"],["人","ひと"],["も"],["死に","しに"],["、"],["愚か","おろか"],["な"],["者","もの"],["も"],["、"],["獣","けもの"],["の"],["よう"],["な"],["者","もの"],["も"],["、"],["ひとしく"],["滅んで","ほろんで"],["、"],["その"],["富","とみ"],["を"],["他人","たにん"],["に"],["残す","のこす"],["こと"],["は"],["人","ひと"],["の"],["見る","みる"],["ところ"],["で"],["ある"],["。"]]},{"verse":12,"text":"[11]たとい彼,かれらはその地,ちを自分,じぶんの名,なをもって呼,よんでも、墓,はかこそ彼,かれらのとこしえのすまい、世々,よよ彼,かれらのすみかである。","tok":[["["],["11"],["]"],["たとい"],["彼","かれ"],["ら"],["は"],["その"],["地","ち"],["を"],["自分","じぶん"],["の"],["名","な"],["を"],["もって"],["呼","よん"],["で"],["も"],["、"],["墓","はか"],["こそ"],["彼","かれ"],["ら"],["の"],["とこしえ"],["の"],["すまい"],["、"],["世々","よ"],["よ"],["彼","かれ"],["ら"],["の"],["すみか"],["で"],["ある"],["。"]]},{"verse":13,"text":"[12]人,ひとは栄華,えいがのうちに長,ながくとどまることはできない、滅,ほろびうせる獣,けものにひとしい。","tok":[["["],["12"],["]"],["人","ひと"],["は"],["栄華","えいが"],["の"],["うち"],["に"],["長く","ながく"],["とどまる"],["こと"],["は"],["できない"],["、"],["滅び","ほろび"],["うせる"],["獣","けもの"],["に"],["ひとしい"],["。"]]},{"verse":14,"text":"[13]これぞ自分,じぶんをたのむ愚,おろかな者,ものどもの成,なりゆき、自分,じぶんの分,わけ前,まえを喜,よろこぶ者,ものどもの果,はてである。〔セラ","tok":[["["],["13"],["]"],["これ"],["ぞ"],["自分","じぶん"],["を"],["たのむ"],["愚か","おろか"],["な"],["者","もの"],["ども"],["の"],["成りゆき","なりゆき"],["、"],["自分","じぶん"],["の"],["分け前","わけまえ"],["を"],["喜こぶ","よろこぶ"],["者","もの"],["ども"],["の"],["果て","はて"],["で"],["ある"],["。"],["〔"],["セラ"]]},{"verse":15,"text":"[14]彼,かれらは陰府,よみに定,さだめられた羊,ひつじのように死,しが彼,かれらを牧,ぼくするであろう。彼,かれらはまっすぐに墓,はかに下,くだり、そのかたちは消,きえうせ、陰府,よみが彼,かれらのすまいとなるであろう。","tok":[["["],["14"],["]"],["彼","かれ"],["ら"],["は"],["陰府","よみ"],["に"],["定められた","さだめられた"],["羊","ひつじ"],["の"],["よう"],["に"],["死","し"],["が"],["彼","かれ"],["ら"],["を"],["牧","ぼ"],["く"],["するで"],["あろう"],["。"],["彼","かれ"],["ら"],["は"],["まっすぐ"],["に"],["墓","はか"],["に"],["下り","くだり"],["、"],["その"],["かたち"],["は"],["消えうせ","きえうせ"],["、"],["陰府","よみ"],["が"],["彼","かれ"],["ら"],["の"],["すまい"],["と"],["なるで"],["あろう"],["。"]]},{"verse":16,"text":"[15]しかし神,かみはわたしを受,うけられるゆえ、わたしの魂,たましいを陰府,よみの力,ちからからあがなわれる。〔セラ","tok":[["["],["15"],["]"],["しかし"],["神","かみ"],["は"],["わたし"],["を"],["受られる","うけられる"],["ゆえ"],["、"],["わたし"],["の"],["魂","たましい"],["を"],["陰府","よみ"],["の"],["力","ちから"],["から"],["あがなわれる"],["。"],["〔"],["セラ"]]},{"verse":17,"text":"[16]人,ひとが富,とみを得,えるときも、その家,いえの栄,さかえが増,まし加,くわわるときも、恐,おそれてはならない。","tok":[["["],["16"],["]"],["人","ひと"],["が"],["富","とみ"],["を"],["得る","える"],["とき"],["も"],["、"],["その"],["家","いえ"],["の"],["栄","さかえ"],["が"],["増し","まし"],["加わわる","くわわる"],["とき"],["も"],["、"],["恐れて","おそれて"],["は"],["ならない"],["。"]]},{"verse":18,"text":"[17]彼,かれが死,しぬときは何,なにひとつ携,たずさえ行,いくことができず、その栄,さかえも彼,かれに従,したがって下,くだって行,いくことはないからである。","tok":[["["],["17"],["]"],["彼","かれ"],["が"],["死ぬ","しぬ"],["とき"],["は"],["何","な"],["に"],["ひと"],["つ"],["携え","たずさえ"],["行く","いく"],["こと"],["が"],["できず"],["、"],["その"],["栄","さかえ"],["も"],["彼","かれ"],["に"],["従って","したがって"],["下って","くだって"],["行く","いく"],["こと"],["は"],["ない"],["から"],["で"],["ある"],["。"]]},{"verse":19,"text":"[18]たとい彼,かれが生,いきながらえる間,あいだ、自分,じぶんを幸福,こうふくと思,おもっても、またみずから幸,さいわいな時,ときに、人々,ひとびとから称賛,しょうさんされても、","tok":[["["],["18"],["]"],["たとい"],["彼","かれ"],["が"],["生きながらえる","いきながらえる"],["間","あ"],["い"],["だ"],["、"],["自分","じぶん"],["を"],["幸福","こうふく"],["と"],["思って","おもって"],["も"],["、"],["また"],["みずから"],["幸い","さいわい"],["な"],["時","とき"],["に"],["、"],["人々","ひとびと"],["から"],["称賛","しょうさん"],["されて"],["も"],["、"]]},{"verse":20,"text":"[19]彼,かれはついにおのれの先祖,せんぞの仲間,なかまに連,つらなる。彼,かれらは絶,たえて光,ひかりを見,みることがない。","tok":[["["],["19"],["]"],["彼","かれ"],["は"],["ついに"],["おのれ"],["の"],["先祖","せんぞ"],["の"],["仲間","なかま"],["に"],["連なる","つらなる"],["。"],["彼","かれ"],["ら"],["は"],["絶えて","たえて"],["光","ひかり"],["を"],["見る","みる"],["こと"],["が"],["ない"],["。"]]},{"verse":21,"text":"[20]人,ひとは栄華,えいがのうちに長,ながくとどまることはできない。滅,ほろびうせる獣,けものにひとしい。","tok":[["["],["20"],["]"],["人","ひと"],["は"],["栄華","えいが"],["の"],["うち"],["に"],["長く","ながく"],["とどまる"],["こと"],["は"],["できない"],["。"],["滅び","ほろび"],["うせる"],["獣","けもの"],["に"],["ひとしい"],["。"]]}]
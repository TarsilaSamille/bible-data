[{"verse":1,"text":"【コラの子,この歌,うた、さんび】主,しゅが基,もといをすえられた都,みやこは聖,せいなる山,やまの上,うえに立,たつ。","tok":[["【"],["コラ"],["の"],["子","こ"],["の"],["歌","うた"],["、"],["さん"],["び"],["】"],["主","しゅ"],["が"],["基い","もとい"],["を"],["すえられた"],["都","みやこ"],["は"],["聖","せい"],["なる"],["山","やま"],["の"],["上","うえ"],["に"],["立つ","たつ"],["。"]]},{"verse":2,"text":"主,しゅはヤコブのすべてのすまいにまさって、シオンのもろもろの門,もんを愛,あいされる。","tok":[["主","しゅ"],["は"],["ヤコブ"],["の"],["すべて"],["の"],["すまい"],["に"],["まさって"],["、"],["シオン"],["の"],["もろもろ"],["の"],["門","もん"],["を"],["愛される","あいされる"],["。"]]},{"verse":3,"text":"神,かみの都,みやこよ、あなたについて、もろもろの栄光,えいこうある事,ことが語,かたられる。〔セラ","tok":[["神","かみ"],["の"],["都","みやこ"],["よ"],["、"],["あなた"],["について"],["、"],["もろもろ"],["の"],["栄光","えいこう"],["ある"],["事","こと"],["が"],["語られる","かたられる"],["。"],["〔"],["セラ"]]},{"verse":4,"text":"わたしはラハブとバビロンをわたしを知,しる者,もののうちに挙,あげる。ペリシテ、ツロ、またエチオピヤを見,みよ。「この者,ものはかしこに生,うまれた」と言,いわれる。","tok":[["わたし"],["は"],["ラハブ"],["と"],["バビロン"],["を"],["わたし"],["を"],["知る","しる"],["者","もの"],["の"],["うち"],["に"],["挙げる","あげる"],["。"],["ペリシテ"],["、"],["ツロ"],["、"],["また"],["エチオピヤ"],["を"],["見よ","みよ"],["。"],["「"],["この"],["者","もの"],["は"],["かしこ"],["に"],["生まれた","うまれた"],["」"],["と"],["言われる","いわれる"],["。"]]},{"verse":5,"text":"しかしシオンについては「この者,ものも、かの者,ものもその中,なかに生,うまれた」と言,いわれる。いと高,たかき者,ものみずからシオンを堅,かたく立,たてられるからである。","tok":[["しかし"],["シオン"],["について"],["は"],["「"],["この"],["者","もの"],["も"],["、"],["かの"],["者","もの"],["も"],["その"],["中","なか"],["に"],["生まれた","うまれた"],["」"],["と"],["言われる","いわれる"],["。"],["いと"],["高き","たかき"],["者","もの"],["みずから"],["シオン"],["を"],["堅く","かたく"],["立られる","たてられる"],["から"],["で"],["ある"],["。"]]},{"verse":6,"text":"主,しゅがもろもろの民,たみを登録,とうろくされるとき、「この者,ものはかしこに生,うまれた」としるされる。〔セラ","tok":[["主","しゅ"],["が"],["もろもろ"],["の"],["民","たみ"],["を"],["登録","とうろく"],["される"],["とき"],["、"],["「"],["この"],["者","もの"],["は"],["かしこ"],["に"],["生まれた","うまれた"],["」"],["と"],["しるされる"],["。"],["〔"],["セラ"]]},{"verse":7,"text":"歌,うたう者,ものと踊,おどる者,ものはみな言,いう、「わがもろもろの泉,いずみはあなたのうちにある」と。","tok":[["歌う","うたう"],["者","もの"],["と"],["踊る","おどる"],["者","もの"],["は"],["みな"],["言う","いう"],["、"],["「"],["わが"],["もろもろ"],["の"],["泉","いずみ"],["は"],["あなた"],["の"],["うち"],["に"],["ある"],["」"],["と"],["。"]]}]
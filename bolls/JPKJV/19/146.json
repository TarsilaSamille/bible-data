[{"verse":1,"text":"主,しゅをほめたたえよ。わが魂,たましいよ、主,しゅをほめたたえよ。","tok":[["主","しゅ"],["を"],["ほめたたえ"],["よ"],["。"],["わが"],["魂","たましい"],["よ"],["、"],["主","しゅ"],["を"],["ほめたたえ"],["よ"],["。"]]},{"verse":2,"text":"わたしは生,いけるかぎりは主,しゅをほめたたえ、ながらえる間,あいだは、わが神,かみをほめうたおう。","tok":[["わたし"],["は"],["生ける","いける"],["かぎり"],["は"],["主","しゅ"],["を"],["ほめたたえ"],["、"],["ながらえる"],["間","あいだ"],["は"],["、"],["わが"],["神","かみ"],["を"],["ほめ"],["うたおう"],["。"]]},{"verse":3,"text":"もろもろの君,きみに信頼,しんらいしてはならない。人,ひとの子,こに信頼,しんらいしてはならない。彼,かれらには助,たすけがない。","tok":[["もろもろ"],["の"],["君","きみ"],["に"],["信頼","しんらい"],["して"],["は"],["ならない"],["。"],["人","ひと"],["の"],["子","こ"],["に"],["信頼","しんらい"],["して"],["は"],["ならない"],["。"],["彼","かれ"],["ら"],["に"],["は"],["助け","たすけ"],["が"],["ない"],["。"]]},{"verse":4,"text":"その息,いきが出,でていけば彼,かれは土,つちに帰,かえる。その日,ひには彼,かれのもろもろの計画,けいかくは滅,ほろびる。","tok":[["その"],["息","いき"],["が"],["出て","でて"],["いけば"],["彼","かれ"],["は"],["土","つち"],["に"],["帰える","かえる"],["。"],["その"],["日","ひ"],["に"],["は"],["彼","かれ"],["の"],["もろもろ"],["の"],["計画","けいかく"],["は"],["滅びる","ほろびる"],["。"]]},{"verse":5,"text":"ヤコブの神,かみをおのが助,たすけとし、その望,のぞみをおのが神,かみ、主,しゅにおく人,ひとはさいわいである。","tok":[["ヤコブ"],["の"],["神","かみ"],["を"],["おの"],["が"],["助け","たすけ"],["と"],["し"],["、"],["その"],["望み","のぞみ"],["を"],["おの"],["が"],["神","かみ"],["、"],["主に","しゅに"],["おく"],["人","ひと"],["は"],["さいわい"],["で"],["ある"],["。"]]},{"verse":6,"text":"主,しゅは天,てんと地,ちと、海,うみと、その中,なかにあるあらゆるものを造,つくり、とこしえに真実,しんじつを守,まもり、","tok":[["主","しゅ"],["は"],["天","てん"],["と"],["地","ち"],["と"],["、"],["海","うみ"],["と"],["、"],["その"],["中","なか"],["に"],["ある"],["あらゆる"],["もの"],["を"],["造","つくり"],["、"],["とこしえ"],["に"],["真実","しんじつ"],["を"],["守り","まもり"],["、"]]},{"verse":7,"text":"しえたげられる者,もののためにさばきをおこない、飢,うえた者,ものに食物,しょくもつを与,あたえられる。主,しゅは捕,とらわれ人,びとを解,とき放,はなたれる。","tok":[["し"],["えたげられる"],["者","もの"],["の"],["ため"],["に"],["さばき"],["を"],["おこない"],["、"],["飢","うえ"],["た"],["者","もの"],["に"],["食物","しょくもつ"],["を"],["与えられる","あたえられる"],["。"],["主","しゅ"],["は"],["捕らわれ","とらわれ"],["人","びと"],["を"],["解き放たれる","ときはなたれる"],["。"]]},{"verse":8,"text":"主,しゅは盲人,もうじんの目,めを開,ひらかれる。主,しゅはかがむ者,ものを立,たたせられる。主,しゅは正,ただしい者,ものを愛,あいされる。","tok":[["主","しゅ"],["は"],["盲人","もうじん"],["の"],["目","め"],["を"],["開らかれる","ひらかれる"],["。"],["主","しゅ"],["は"],["かがむ"],["者","もの"],["を"],["立たせられる","たたせられる"],["。"],["主","しゅ"],["は"],["正い","ただしい"],["者","もの"],["を"],["愛される","あいされる"],["。"]]},{"verse":9,"text":"主,しゅは寄留,きりゅうの他国,たこく人,じんを守,まもり、みなしごと、やもめとをささえられる。しかし、悪,あしき者,ものの道,みちを滅,ほろびに至,いたらせられる。","tok":[["主","しゅ"],["は"],["寄留","きりゅう"],["の"],["他国人","たこくじん"],["を"],["守り","まもり"],["、"],["みなしご"],["と"],["、"],["やもめ"],["と"],["を"],["ささえられる"],["。"],["しかし"],["、"],["悪しき","あしき"],["者","もの"],["の"],["道","みち"],["を"],["滅び","ほろび"],["に"],["至らせられる","いたらせられる"],["。"]]},{"verse":10,"text":"主,しゅはとこしえに統,すべ治,おさめられる。シオンよ、あなたの神,かみはよろず代,よまで統,すべ治,おさめられる。主,しゅをほめたたえよ。","tok":[["主","しゅ"],["は"],["とこしえ"],["に"],["統べ治められる","すべおさめられる"],["。"],["シオン"],["よ"],["、"],["あなた"],["の"],["神","かみ"],["は"],["よろず"],["代","よ"],["まで"],["統べ治められる","すべおさめられる"],["。"],["主","しゅ"],["を"],["ほめたたえ"],["よ"],["。"]]}]
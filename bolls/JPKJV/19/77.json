[{"verse":1,"text":"[0]【聖歌,せいか隊,たいの指揮者,しきしゃによってエドトンのしらべにしたがってうたわせたアサフの歌,うた】","tok":[["["],["0"],["]"],["【"],["聖歌隊","せいかたい"],["の"],["指揮者","しきしゃ"],["によって"],["エドトン"],["の"],["しらべ"],["に"],["したがって"],["うたわせた"],["アサフ"],["の"],["歌","うた"],["】"]]},{"verse":2,"text":"[1]わたしは神,かみにむかい声,こえをあげて叫,さけぶ。わたしが神,かみにむかって声,こえをあげれば、神,かみはわたしに聞,きかれる。","tok":[["["],["1"],["]"],["わたし"],["は"],["神","かみ"],["に"],["むかい"],["声","こえ"],["を"],["あげて"],["叫けぶ","さけぶ"],["。"],["わたし"],["が"],["神","かみ"],["に"],["むかって"],["声","こえ"],["を"],["あげれば"],["、"],["神","かみ"],["は"],["わたし"],["に"],["聞かれる","きかれる"],["。"]]},{"verse":3,"text":"[2]わたしは悩,なやみの日,ひに主,しゅをたずね求,もとめ、夜,よるはわが手,てを伸,のべてたゆむことなく、わが魂,たましいは慰,なぐさめられるのを拒,こばむ。","tok":[["["],["2"],["]"],["わたし"],["は"],["悩み","なやみ"],["の"],["日","ひ"],["に"],["主","しゅ"],["を"],["たずね求め","たずねもとめ"],["、"],["夜","よる"],["は"],["わが"],["手","て"],["を"],["伸べて","のべて"],["たゆむ"],["こと"],["なく"],["、"],["わが"],["魂","たましい"],["は"],["慰さめられる","なぐさめられる"],["の"],["を"],["拒む","こばむ"],["。"]]},{"verse":4,"text":"[3]わたしは神,かみを思,おもうとき、嘆,なげき悲,かなしみ、深,ふかく思,おもうとき、わが魂,たましいは衰,おとろえる。〔セラ","tok":[["["],["3"],["]"],["わたし"],["は"],["神","かみ"],["を"],["思う","おもう"],["とき"],["、"],["嘆き悲しみ","なげきかなしみ"],["、"],["深く","ふかく"],["思う","おもう"],["とき"],["、"],["わが"],["魂","たましい"],["は"],["衰える","おとろえる"],["。"],["〔"],["セラ"]]},{"verse":5,"text":"[4]あなたはわたしのまぶたをささえて閉,とじさせず、わたしは物言,ものいうこともできないほどに悩,なやむ。","tok":[["["],["4"],["]"],["あなた"],["は"],["わたし"],["の"],["まぶた"],["を"],["ささえて"],["閉じさせず","とじさせず"],["、"],["わたし"],["は"],["物","もの"],["言う","いう"],["こと"],["も"],["できない"],["ほど"],["に"],["悩む","なやむ"],["。"]]},{"verse":6,"text":"[5]わたしは昔,むかしの日,ひを思,おもい、いにしえの年,としを思,おもう。","tok":[["["],["5"],["]"],["わたし"],["は"],["昔","むかし"],["の"],["日","ひ"],["を"],["思い","おもい"],["、"],["いにしえ"],["の"],["年","とし"],["を"],["思う","おもう"],["。"]]},{"verse":7,"text":"[6]わたしは夜,よる、わが心,こころと親,したしく語,かたり、深,ふかく思,おもうてわが魂,たましいを探,さぐり、言,いう、","tok":[["["],["6"],["]"],["わたし"],["は"],["夜","よる"],["、"],["わが"],["心","こころ"],["と"],["親しく","したしく"],["語り","かたり"],["、"],["深く","ふかく"],["思うて","おもうて"],["わが"],["魂","たましい"],["を"],["探ぐり","さぐり"],["、"],["言う","いう"],["、"]]},{"verse":8,"text":"[7]「主,しゅはとこしえにわれらを捨,すてられるであろうか。ふたたび、めぐみを施,ほどこされないであろうか。","tok":[["["],["7"],["]"],["「"],["主","しゅ"],["は"],["とこしえ"],["に"],["われ"],["ら"],["を"],["捨てられるで","すてられるで"],["あろう"],["か"],["。"],["ふたたび"],["、"],["めぐみ"],["を"],["施されないで","ほどこされないで"],["あろう"],["か"],["。"]]},{"verse":9,"text":"[8]そのいつくしみはとこしえに絶,たえ、その約束,やくそくは世々,よよながくすたれるであろうか。","tok":[["["],["8"],["]"],["その"],["いつくしみ"],["は"],["とこしえ"],["に"],["絶え","たえ"],["、"],["その"],["約束","やくそく"],["は"],["世々","よ"],["よ"],["ながく"],["すたれるで"],["あろう"],["か"],["。"]]},{"verse":10,"text":"[9]神,かみは恵,めぐみを施,ほどこすことを忘,わすれ、怒,いかりをもってそのあわれみを閉,とじられたであろうか」と。〔セラ","tok":[["["],["9"],["]"],["神","かみ"],["は"],["恵","めぐみ"],["を"],["施す","ほどこす"],["こと"],["を"],["忘","わすれ"],["、"],["怒り","いかり"],["を"],["もって"],["その"],["あわれみ"],["を"],["閉じられたで","とじられたで"],["あろう"],["か"],["」"],["と"],["。"],["〔"],["セラ"]]},{"verse":11,"text":"[10]その時,ときわたしは言,いう、「わたしの悲,かなしみはいと高,たかき者,ものの右,みぎの手,てが変,かわったことである」と。","tok":[["["],["10"],["]"],["その"],["時","とき"],["わたし"],["は"],["言う","いう"],["、"],["「"],["わたし"],["の"],["悲しみ","かなしみ"],["は"],["いと"],["高き","たかき"],["者","もの"],["の"],["右","みぎ"],["の"],["手","て"],["が"],["変わった","かわった"],["こと"],["で"],["ある"],["」"],["と"],["。"]]},{"verse":12,"text":"[11]わたしは主,しゅのみわざを思,おもい起,おこす。わたしは、いにしえからのあなたのくすしきみわざを思,おもいいだす。","tok":[["["],["11"],["]"],["わたし"],["は"],["主","しゅ"],["のみ"],["わざ"],["を"],["思い起こす","おもいおこす"],["。"],["わたし"],["は"],["、"],["いにしえ"],["から"],["の"],["あなた"],["の"],["くす"],["しきみ"],["わざ"],["を"],["思い","おもい"],["いだす"],["。"]]},{"verse":13,"text":"[12]わたしは、あなたのすべてのみわざを思,おもい、あなたの力,ちからあるみわざを深,ふかく思,おもう。","tok":[["["],["12"],["]"],["わたし"],["は"],["、"],["あなた"],["の"],["すべて"],["のみ"],["わざ"],["を"],["思い","おもい"],["、"],["あなた"],["の"],["力","ちから"],["ある"],["みわざ"],["を"],["深く","ふかく"],["思う","おもう"],["。"]]},{"verse":14,"text":"[13]神,かみよ、あなたの道,みちは聖,せいである。われらの神,かみのように大,おおいなる神,かみはだれか。","tok":[["["],["13"],["]"],["神","かみ"],["よ"],["、"],["あなた"],["の"],["道","みち"],["は"],["聖","せい"],["で"],["ある"],["。"],["われ"],["ら"],["の"],["神","かみ"],["の"],["よう"],["に"],["大いなる","おおいなる"],["神","かみ"],["は"],["だれ"],["か"],["。"]]},{"verse":15,"text":"[14]あなたは、くすしきみわざを行,おこなわれる神,かみである。あなたは、もろもろの民,たみの間,あいだに、その大能,たいのうをあらわし、","tok":[["["],["14"],["]"],["あなた"],["は"],["、"],["くす"],["しきみ"],["わざ"],["を"],["行なわれる","おこなわれる"],["神","かみ"],["で"],["ある"],["。"],["あなた"],["は"],["、"],["もろもろ"],["の"],["民","たみ"],["の"],["間","あいだ"],["に"],["、"],["その"],["大能","たいのう"],["を"],["あらわし"],["、"]]},{"verse":16,"text":"[15]その腕,うでをもっておのれの民,たみをあがない、ヤコブとヨセフの子,こらをあがなわれた。〔セラ","tok":[["["],["15"],["]"],["その"],["腕","うで"],["を"],["もって"],["おのれ"],["の"],["民","たみ"],["を"],["あがない"],["、"],["ヤコブ"],["と"],["ヨセフ"],["の"],["子","こ"],["ら"],["を"],["あがなわれた"],["。"],["〔"],["セラ"]]},{"verse":17,"text":"[16]神,かみよ、大水,おおみずはあなたを見,みた。大水,おおみずはあなたを見,みておののき、淵,ふちもまた震,ふるえた。","tok":[["["],["16"],["]"],["神","かみ"],["よ"],["、"],["大水","おおみず"],["は"],["あなた"],["を"],["見た","みた"],["。"],["大水","おおみず"],["は"],["あなた"],["を"],["見て","みて"],["おののき"],["、"],["淵","ふち"],["も"],["また"],["震えた","ふるえた"],["。"]]},{"verse":18,"text":"[17]雲,くもは水,みずを注,そそぎいだし、空,そらは雷,かみなりをとどろかし、あなたの矢,やは四方,しほうにきらめいた。","tok":[["["],["17"],["]"],["雲","くも"],["は"],["水","みず"],["を"],["注ぎ","そそぎ"],["いだし"],["、"],["空","そら"],["は"],["雷","かみなり"],["を"],["とどろかし"],["、"],["あなた"],["の"],["矢","や"],["は"],["四方","しほう"],["に"],["きらめいた"],["。"]]},{"verse":19,"text":"[18]あなたの雷,かみなりのとどろきは、つむじ風,かぜの中,なかにあり、あなたのいなずまは世,よを照,てらし、地,ちは震,ふるい動,うごいた。","tok":[["["],["18"],["]"],["あなた"],["の"],["雷","かみなり"],["の"],["とどろき"],["は"],["、"],["つむじ風","つむじかぜ"],["の"],["中","なか"],["に"],["あり"],["、"],["あなた"],["の"],["いなずま"],["は"],["世","よ"],["を"],["照","てらし"],["、"],["地","ち"],["は"],["震い","ふるい"],["動いた","うごいた"],["。"]]},{"verse":20,"text":"[19]あなたの大路,おおじは海,うみの中,なかにあり、あなたの道,みちは大水,おおみずの中,なかにあり、あなたの足跡,あしあとはたずねえなかった。","tok":[["["],["19"],["]"],["あなた"],["の"],["大路","おおじ"],["は"],["海","うみ"],["の"],["中","なか"],["に"],["あり"],["、"],["あなた"],["の"],["道","みち"],["は"],["大水","おおみず"],["の"],["中","なか"],["に"],["あり"],["、"],["あなた"],["の"],["足跡","あしあと"],["は"],["たずね"],["えなかった"],["。"]]},{"verse":21,"text":"[20]あなたは、その民,たみをモーセとアロンの手,てによって羊,ひつじの群,むれのように導,みちびかれた。","tok":[["["],["20"],["]"],["あなた"],["は"],["、"],["その"],["民","たみ"],["を"],["モーセ"],["と"],["アロン"],["の"],["手","て"],["によって"],["羊","ひつじ"],["の"],["群れ","むれ"],["の"],["よう"],["に"],["導かれた","みちびかれた"],["。"]]}]
[{"verse":1,"text":"[0]【聖歌,せいか隊,たいの指揮者,しきしゃによってうたわせたコラの子,このマスキールの歌,うた】","tok":[["["],["0"],["]"],["【"],["聖歌隊","せいかたい"],["の"],["指揮者","しきしゃ"],["によって"],["うたわせた"],["コラ"],["の"],["子","こ"],["の"],["マスキール"],["の"],["歌","うた"],["】"]]},{"verse":2,"text":"[1]神,かみよ、いにしえ、われらの先祖,せんぞたちの日,ひに、あなたがなされたみわざを彼,かれらがわれらに語,かたったのを耳,みみで聞,ききました。","tok":[["["],["1"],["]"],["神","かみ"],["よ"],["、"],["いにしえ"],["、"],["われ"],["ら"],["の"],["先祖","せんぞ"],["たち"],["の"],["日","ひ"],["に"],["、"],["あなた"],["が"],["なされた"],["みわざ"],["を"],["彼","かれ"],["ら"],["が"],["われ"],["ら"],["に"],["語った","かたった"],["の"],["を"],["耳","みみ"],["で"],["聞","きき"],["ました"],["。"]]},{"verse":3,"text":"[2]すなわちあなたはみ手,てをもって、もろもろの国民,こくみんを追,おい払,はらってわれらの先祖,せんぞたちを植,うえ、またもろもろの民,たみを悩,なやまして、われらの先祖,せんぞたちをふえ広,ひろがらせられました。","tok":[["["],["2"],["]"],["すなわち"],["あなた"],["は"],["み手","みて"],["を"],["もって"],["、"],["もろもろ"],["の"],["国民","こくみん"],["を"],["追い払って","おいはらって"],["われ"],["ら"],["の"],["先祖","せんぞ"],["たち"],["を"],["植え","うえ"],["、"],["また"],["もろもろ"],["の"],["民","たみ"],["を"],["悩して","なやまして"],["、"],["われ"],["ら"],["の"],["先祖","せんぞ"],["たち"],["を"],["ふえ"],["広がらせられました","ひろがらせられました"],["。"]]},{"verse":4,"text":"[3]彼,かれらは自分,じぶんのつるぎによって国,くにを獲,えたのでなく、また自分,じぶんの腕,うでによって勝利,しょうりを得,えたのでもありません。ただあなたの右,みぎの手,て、あなたの腕,うで、あなたのみ顔,かおの光,ひかりによるのでした。あなたが彼,かれらを恵,めぐまれたからです。","tok":[["["],["3"],["]"],["彼","かれ"],["ら"],["は"],["自分","じぶん"],["の"],["つるぎ"],["によって"],["国","くに"],["を"],["獲た","えた"],["ので"],["なく"],["、"],["また"],["自分","じぶん"],["の"],["腕","うで"],["によって"],["勝利","しょうり"],["を"],["得た","えた"],["ので"],["も"],["ありません"],["。"],["ただ"],["あなた"],["の"],["右","みぎ"],["の"],["手","て"],["、"],["あなた"],["の"],["腕","うで"],["、"],["あなた"],["のみ"],["顔","かお"],["の"],["光","ひかり"],["に"],["よる"],["の"],["でした"],["。"],["あなた"],["が"],["彼","かれ"],["ら"],["を"],["恵れた","めぐまれた"],["から"],["です"],["。"]]},{"verse":5,"text":"[4]あなたはわが王,おう、わが神,かみ、ヤコブのために勝利,しょうりを定,さだめられる方,かたです。","tok":[["["],["4"],["]"],["あなた"],["は"],["わが"],["王","おう"],["、"],["わが"],["神","かみ"],["、"],["ヤコブ"],["の"],["ため"],["に"],["勝利","しょうり"],["を"],["定められる","さだめられる"],["方","かた"],["です"],["。"]]},{"verse":6,"text":"[5]われらはあなたによって、あだを押,おし倒,たおし、われらに立,たちむかう者,ものを、み名,なによって踏,ふみにじるのです。","tok":[["["],["5"],["]"],["われ"],["ら"],["は"],["あなた"],["によって"],["、"],["あだ"],["を"],["押倒し","おしたおし"],["、"],["われ"],["ら"],["に"],["立ちむかう","たちむかう"],["者","もの"],["を"],["、"],["み名","みな"],["によって"],["踏みにじる","ふみにじる"],["の"],["です"],["。"]]},{"verse":7,"text":"[6]わたしは自分,じぶんの弓,ゆみを頼,たのまず、わたしのつるぎもまた、わたしを救,すくうことができないからです。","tok":[["["],["6"],["]"],["わたし"],["は"],["自分","じぶん"],["の"],["弓","ゆみ"],["を"],["頼まず","たのまず"],["、"],["わたし"],["の"],["つるぎ"],["も"],["また"],["、"],["わたし"],["を"],["救う","すくう"],["こと"],["が"],["できない"],["から"],["です"],["。"]]},{"verse":8,"text":"[7]しかしあなたはわれらをあだから救,すくい、われらを憎,にくむ者,ものをはずかしめられました。","tok":[["["],["7"],["]"],["しかし"],["あなた"],["は"],["われ"],["ら"],["を"],["あだ"],["から"],["救い","すくい"],["、"],["われ"],["ら"],["を"],["憎む","にくむ"],["者","もの"],["を"],["はずかしめられました"],["。"]]},{"verse":9,"text":"[8]われらは常,つねに神,かみによって誇,ほこり、とこしえにあなたのみ名,なに感謝,かんしゃするでしょう。〔セラ","tok":[["["],["8"],["]"],["われ"],["ら"],["は"],["常","つね"],["に"],["神","かみ"],["によって"],["誇","ほこり"],["、"],["とこしえ"],["に"],["あなた"],["のみ"],["名","な"],["に"],["感謝","かんしゃ"],["するでしょう"],["。"],["〔"],["セラ"]]},{"verse":10,"text":"[9]ところがあなたはわれらを捨,すてて恥,はじを負,おわせ、われらの軍勢,ぐんぜいと共,ともに出,でて行,いかれませんでした。","tok":[["["],["9"],["]"],["ところ"],["が"],["あなた"],["は"],["われ"],["ら"],["を"],["捨てて","すてて"],["恥","はじ"],["を"],["負わせ","おわせ"],["、"],["われ"],["ら"],["の"],["軍勢","ぐんぜい"],["と"],["共","とも"],["に"],["出て","でて"],["行かれませんでした","いかれませんでした"],["。"]]},{"verse":11,"text":"[10]あなたがわれらをあだの前,まえから退,しりぞかせられたので、われらの敵,てきは心,こころのままにかすめ奪,うばいました。","tok":[["["],["10"],["]"],["あなた"],["が"],["われ"],["ら"],["を"],["あだ"],["の"],["前","まえ"],["から"],["退ぞかせられた","しりぞかせられた"],["ので"],["、"],["われ"],["ら"],["の"],["敵","てき"],["は"],["心","こころ"],["の"],["まま"],["に"],["かすめ"],["奪いました","うばいました"],["。"]]},{"verse":12,"text":"[11]あなたはわれらをほふられる羊,ひつじのようにし、またもろもろの国民,こくみんのなかに散,ちらされました。","tok":[["["],["11"],["]"],["あなた"],["は"],["われ"],["ら"],["を"],["ほふられる"],["羊","ひつじ"],["の"],["よう"],["に"],["し"],["、"],["また"],["もろもろ"],["の"],["国民","こくみん"],["の"],["なか"],["に"],["散らされました","ちらされました"],["。"]]},{"verse":13,"text":"[12]あなたはわずかの金,きんであなたの民,たみを売,うり、彼,かれらのために高,たかい価,あたいを求,もとめられませんでした。","tok":[["["],["12"],["]"],["あなた"],["は"],["わずか"],["の"],["金","きん"],["で"],["あなた"],["の"],["民","たみ"],["を"],["売","うり"],["、"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["高かい","たかい"],["価","あたい"],["を"],["求められませんでした","もとめられませんでした"],["。"]]},{"verse":14,"text":"[13]あなたはわれらを隣,となり人,びとにそしらせ、われらをめぐる者,ものどもに侮,あなどらせ、あざけらせられました。","tok":[["["],["13"],["]"],["あなた"],["は"],["われ"],["ら"],["を"],["隣人","となりびと"],["に"],["そしらせ"],["、"],["われ"],["ら"],["を"],["めぐる"],["者","もの"],["ども"],["に"],["侮らせ","あなどらせ"],["、"],["あざけらせられました"],["。"]]},{"verse":15,"text":"[14]またもろもろの国民,こくみんのなかにわれらを笑,わらい草,ぐさとし、もろもろの民,たみのなかに笑,わらい者,ものとされました。","tok":[["["],["14"],["]"],["また"],["もろもろ"],["の"],["国民","こくみん"],["の"],["なか"],["に"],["われ"],["ら"],["を"],["笑草","わらいぐさ"],["と"],["し"],["、"],["もろもろ"],["の"],["民","たみ"],["の"],["なか"],["に"],["笑者","わらいもの"],["と"],["されました"],["。"]]},{"verse":16,"text":"[15]わがはずかしめはひねもすわたしの前,まえにあり、恥,はじはわたしの顔,かおをおおいました。","tok":[["["],["15"],["]"],["わが"],["はずかしめ"],["は"],["ひねもす"],["わたし"],["の"],["前","まえ"],["に"],["あり"],["、"],["恥","はじ"],["は"],["わたし"],["の"],["顔","かお"],["を"],["おおいました"],["。"]]},{"verse":17,"text":"[16]これはそしる者,ものと、ののしる者,ものの言葉,ことばにより、敵,てきと、恨,うらみを報,むくいる者,もののゆえによるのです。","tok":[["["],["16"],["]"],["これ"],["は"],["そしる"],["者","もの"],["と"],["、"],["ののしる"],["者","もの"],["の"],["言葉","ことば"],["に"],["より"],["、"],["敵","てき"],["と"],["、"],["恨み","うらみ"],["を"],["報いる","むくいる"],["者","もの"],["の"],["ゆえ"],["に"],["よる"],["の"],["です"],["。"]]},{"verse":18,"text":"[17]これらの事,ことが皆,みなわれらに臨,のぞみましたが、われらはあなたを忘,わすれず、あなたの契約,けいやくにそむくことがありませんでした。","tok":[["["],["17"],["]"],["これ"],["ら"],["の"],["事","こと"],["が"],["皆","みな"],["われ"],["ら"],["に"],["臨みました","のぞみました"],["が"],["、"],["われ"],["ら"],["は"],["あなた"],["を"],["忘ず","わすれず"],["、"],["あなた"],["の"],["契約","けいやく"],["に"],["そむく"],["こと"],["が"],["ありませんでした"],["。"]]},{"verse":19,"text":"[18]われらの心,こころはたじろがず、またわれらの歩,あゆみはあなたの道,みちを離,はなれませんでした。","tok":[["["],["18"],["]"],["われ"],["ら"],["の"],["心","こころ"],["は"],["たじろがず"],["、"],["また"],["われ"],["ら"],["の"],["歩み","あゆみ"],["は"],["あなた"],["の"],["道","みち"],["を"],["離れませんでした","はなれませんでした"],["。"]]},{"verse":20,"text":"[19]それでもあなたは山犬,やまいぬの住,すむ所,ところでわれらを砕,くだき、暗,くらやみをもってわれらをおおわれました。","tok":[["["],["19"],["]"],["それ"],["で"],["も"],["あなた"],["は"],["山犬","やまいぬ"],["の"],["住む","すむ"],["所","ところ"],["で"],["われ"],["ら"],["を"],["砕き","くだき"],["、"],["暗やみ","くらやみ"],["を"],["もって"],["われ"],["ら"],["を"],["おおわれました"],["。"]]},{"verse":21,"text":"[20]われらがもしわれらの神,かみの名,なを忘,わすれ、ほかの神,かみに手,てを伸,のべたことがあったならば、","tok":[["["],["20"],["]"],["われ"],["ら"],["が"],["もし"],["われ"],["ら"],["の"],["神","かみ"],["の"],["名","な"],["を"],["忘","わすれ"],["、"],["ほか"],["の"],["神","かみ"],["に"],["手","て"],["を"],["伸べた","のべた"],["こと"],["が"],["あったならば"],["、"]]},{"verse":22,"text":"[21]神,かみはこれを見,みあらわされないでしょうか。神,かみは心,こころの秘密,ひみつをも知,しっておられるからです。","tok":[["["],["21"],["]"],["神","かみ"],["は"],["これ"],["を"],["見","み"],["あらわされないでしょう"],["か"],["。"],["神","かみ"],["は"],["心","こころ"],["の"],["秘密","ひみつ"],["を"],["も"],["知って","しって"],["おられる"],["から"],["です"],["。"]]},{"verse":23,"text":"[22]ところがわれらはあなたのためにひねもす殺,ころされて、ほふられる羊,ひつじのようにみなされました。","tok":[["["],["22"],["]"],["ところ"],["が"],["われ"],["ら"],["は"],["あなた"],["の"],["ため"],["に"],["ひねもす"],["殺ろされて","ころされて"],["、"],["ほふられる"],["羊","ひつじ"],["の"],["よう"],["に"],["みなされました"],["。"]]},{"verse":24,"text":"[23]主,しゅよ、起,おきてください。なぜ眠,ねむっておられるのですか。目,めをさましてください。われらをとこしえに捨,すてないでください。","tok":[["["],["23"],["]"],["主","しゅ"],["よ"],["、"],["起きて","おきて"],["ください"],["。"],["なぜ"],["眠って","ねむって"],["おられる"],["の"],["です"],["か"],["。"],["目","め"],["を"],["さまして"],["ください"],["。"],["われ"],["ら"],["を"],["とこしえ"],["に"],["捨てないで","すてないで"],["ください"],["。"]]},{"verse":25,"text":"[24]なぜあなたはみ顔,かおを隠,かくされるのですか。なぜわれらの悩,なやみと、しえたげをお忘,わすれになるのですか。","tok":[["["],["24"],["]"],["なぜ"],["あなた"],["は"],["み顔","みかお"],["を"],["隠される","かくされる"],["の"],["です"],["か"],["。"],["なぜ"],["われ"],["ら"],["の"],["悩み","なやみ"],["と"],["、"],["し"],["えたげ"],["を"],["お忘","おわすれ"],["に"],["なる"],["の"],["です"],["か"],["。"]]},{"verse":26,"text":"[25]まことにわれらの魂,たましいはかがんで、ちりに伏,ふし、われらのからだは土,つちにつきました。","tok":[["["],["25"],["]"],["まこと"],["に"],["われ"],["ら"],["の"],["魂","たましい"],["は"],["かがんで"],["、"],["ちり"],["に"],["伏し","ふし"],["、"],["われ"],["ら"],["の"],["からだ"],["は"],["土","つち"],["に"],["つきました"],["。"]]},{"verse":27,"text":"[26]起,おきて、われらをお助,たすけください。あなたのいつくしみのゆえに、われらをあがなってください。","tok":[["["],["26"],["]"],["起きて","おきて"],["、"],["われ"],["ら"],["を"],["お助け","おたすけ"],["ください"],["。"],["あなた"],["の"],["いつくしみ"],["の"],["ゆえ"],["に"],["、"],["われ"],["ら"],["を"],["あがなって"],["ください"],["。"]]}]
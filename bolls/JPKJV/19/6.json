[{"verse":1,"text":"[0]【聖歌,せいか隊,たいの指揮者,しきしゃによってシェミニテにあわせ琴,ことをもってうたわせたダビデの歌,うた】","tok":[["["],["0"],["]"],["【"],["聖歌隊","せいかたい"],["の"],["指揮者","しきしゃ"],["によって"],["シェミニテ"],["に"],["あわせ"],["琴","こと"],["を"],["もって"],["うたわせた"],["ダビデ"],["の"],["歌","うた"],["】"]]},{"verse":2,"text":"[1]主,しゅよ、あなたの怒,いかりをもって、わたしを責,せめず、あなたの激,はげしい怒,いかりをもって、わたしを懲,こらしめないでください。","tok":[["["],["1"],["]"],["主","しゅ"],["よ"],["、"],["あなた"],["の"],["怒り","いかり"],["を"],["もって"],["、"],["わたし"],["を"],["責","せめ"],["ず"],["、"],["あなた"],["の"],["激しい","はげしい"],["怒り","いかり"],["を"],["もって"],["、"],["わたし"],["を"],["懲らしめないで","こらしめないで"],["ください"],["。"]]},{"verse":3,"text":"[2]主,しゅよ、わたしをあわれんでください。わたしは弱,よわり衰,おとろえています。主,しゅよ、わたしをいやしてください。わたしの骨,ほねは悩,なやみ苦,くるしんでいます。","tok":[["["],["2"],["]"],["主","しゅ"],["よ"],["、"],["わたし"],["を"],["あわれんで"],["ください"],["。"],["わたし"],["は"],["弱り","よわり"],["衰えて","おとろえて"],["います"],["。"],["主","しゅ"],["よ"],["、"],["わたし"],["を"],["いやして"],["ください"],["。"],["わたし"],["の"],["骨","ほね"],["は"],["悩み苦しんで","なやみくるしんで"],["います"],["。"]]},{"verse":4,"text":"[3]わたしの魂,たましいもまたいたく悩,なやみ苦,くるしんでいます。主,しゅよ、あなたはいつまでお怒,いかりになるのですか。","tok":[["["],["3"],["]"],["わたし"],["の"],["魂","たましい"],["も"],["また"],["いたく"],["悩み苦しんで","なやみくるしんで"],["います"],["。"],["主","しゅ"],["よ"],["、"],["あなた"],["は"],["いつ"],["まで"],["お怒り","おいかり"],["に"],["なる"],["の"],["です"],["か"],["。"]]},{"verse":5,"text":"[4]主,しゅよ、かえりみて、わたしの命,いのちをお救,すくいください。あなたのいつくしみにより、わたしをお助,たすけください。","tok":[["["],["4"],["]"],["主","しゅ"],["よ"],["、"],["かえりみて"],["、"],["わたし"],["の"],["命","いのち"],["を"],["お救い","おすくい"],["ください"],["。"],["あなた"],["の"],["いつくしみ"],["に"],["より"],["、"],["わたし"],["を"],["お助け","おたすけ"],["ください"],["。"]]},{"verse":6,"text":"[5]死,しにおいては、あなたを覚,おぼえるものはなく、陰府,よみにおいては、だれがあなたをほめたたえることができましょうか。","tok":[["["],["5"],["]"],["死","し"],["に"],["おいて"],["は"],["、"],["あなた"],["を"],["覚える","おぼえる"],["もの"],["は"],["なく"],["、"],["陰府","よみ"],["に"],["おいて"],["は"],["、"],["だれ"],["が"],["あなた"],["を"],["ほめたたえる"],["こと"],["が"],["できましょう"],["か"],["。"]]},{"verse":7,"text":"[6]わたしは嘆,なげきによって疲,つかれ、夜,よごとに涙,なみだをもって、わたしのふしどをただよわせ、わたしのしとねをぬらした。","tok":[["["],["6"],["]"],["わたし"],["は"],["嘆き","なげき"],["によって"],["疲れ","つかれ"],["、"],["夜","よごと"],["に"],["涙","なみだ"],["を"],["もって"],["、"],["わたし"],["の"],["ふし"],["ど"],["を"],["ただよわせ"],["、"],["わたし"],["の"],["しとね"],["を"],["ぬらした"],["。"]]},{"verse":8,"text":"[7]わたしの目,めは憂,うれいによって衰,おとろえ、もろもろのあだのゆえに弱,よわくなった。","tok":[["["],["7"],["]"],["わたし"],["の"],["目","め"],["は"],["憂","うれい"],["によって"],["衰え","おとろえ"],["、"],["もろもろ"],["の"],["あだ"],["の"],["ゆえ"],["に"],["弱く","よわく"],["なった"],["。"]]},{"verse":9,"text":"[8]すべて悪,あくを行,おこなう者,ものよ、わたしを離,はなれ去,され。主,しゅはわたしの泣,なく声,こえを聞,きかれた。","tok":[["["],["8"],["]"],["すべて"],["悪","あく"],["を"],["行なう","おこなう"],["者","もの"],["よ"],["、"],["わたし"],["を"],["離れ去れ","はなれされ"],["。"],["主","しゅ"],["は"],["わたし"],["の"],["泣く","なく"],["声","こえ"],["を"],["聞かれた","きかれた"],["。"]]},{"verse":10,"text":"[9]主,しゅはわたしの願,ねがいを聞,きかれた。主,しゅはわたしの祈,いのりをうけられる。","tok":[["["],["9"],["]"],["主","しゅ"],["は"],["わたし"],["の"],["願い","ねがい"],["を"],["聞かれた","きかれた"],["。"],["主","しゅ"],["は"],["わたし"],["の"],["祈","いのり"],["を"],["うけられる"],["。"]]},{"verse":11,"text":"[10]わたしの敵,てきは恥,はじて、いたく悩,なやみ苦,くるしみ、彼,かれらは退,しりぞいて、たちどころに恥,はじをうけるであろう。","tok":[["["],["10"],["]"],["わたし"],["の"],["敵","てき"],["は"],["恥","はじ"],["て"],["、"],["いたく"],["悩み苦しみ","なやみくるしみ"],["、"],["彼","かれ"],["ら"],["は"],["退ぞいて","しりぞいて"],["、"],["たちどころ"],["に"],["恥","はじ"],["を"],["うけるで"],["あろう"],["。"]]}]
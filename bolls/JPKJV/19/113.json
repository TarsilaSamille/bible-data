[{"verse":1,"text":"主,しゅをほめたたえよ。主,しゅのしもべたちよ、ほめたたえよ。主,しゅのみ名,なをほめたたえよ。","tok":[["主","しゅ"],["を"],["ほめたたえ"],["よ"],["。"],["主","しゅ"],["の"],["しもべ"],["たち"],["よ"],["、"],["ほめたたえ"],["よ"],["。"],["主","しゅ"],["のみ"],["名","な"],["を"],["ほめたたえ"],["よ"],["。"]]},{"verse":2,"text":"今,いまより、とこしえに至,いたるまで主,しゅのみ名,なはほむべきかな。","tok":[["今","いま"],["より"],["、"],["とこしえ"],["に"],["至る","いたる"],["まで"],["主","しゅ"],["のみ"],["名","な"],["は"],["ほ"],["むべき"],["か"],["な"],["。"]]},{"verse":3,"text":"日,ひのいずるところから日,ひの入,いるところまで、主,しゅのみ名,なはほめたたえられる。","tok":[["日","ひ"],["の"],["いずる"],["ところ"],["から"],["日","ひ"],["の"],["入る","いる"],["ところ"],["まで"],["、"],["主","しゅ"],["のみ"],["名","な"],["は"],["ほめたたえられる"],["。"]]},{"verse":4,"text":"主,しゅはもろもろの国民,こくみんの上,うえに高,たかくいらせられ、その栄光,えいこうは天,てんよりも高,たかい。","tok":[["主","しゅ"],["は"],["もろもろ"],["の"],["国民","こくみん"],["の"],["上","うえ"],["に"],["高かく","たかく"],["いらせられ"],["、"],["その"],["栄光","えいこう"],["は"],["天","てん"],["より"],["も"],["高かい","たかい"],["。"]]},{"verse":5,"text":"われらの神,かみ、主,しゅにくらぶべき者,ものはだれか。主,しゅは高,たかき所,ところに座,ざし、","tok":[["われ"],["ら"],["の"],["神","かみ"],["、"],["主に","しゅに"],["くらぶ"],["べき"],["者","もの"],["は"],["だれ"],["か"],["。"],["主","しゅ"],["は"],["高き","たかき"],["所","ところ"],["に"],["座し","ざし"],["、"]]},{"verse":6,"text":"遠,とおく天,てんと地,ちとを見,みおろされる。","tok":[["遠く","とおく"],["天","てん"],["と"],["地","ち"],["と"],["を"],["見おろされる","みおろされる"],["。"]]},{"verse":7,"text":"主,しゅは貧,まずしい者,ものをちりからあげ、乏,とぼしい者,ものをあくたからあげて、","tok":[["主","しゅ"],["は"],["貧しい","まずしい"],["者","もの"],["を"],["ちり"],["から"],["あげ"],["、"],["乏い","とぼしい"],["者","もの"],["を"],["あくた"],["から"],["あげて"],["、"]]},{"verse":8,"text":"もろもろの君,きみたちと共,ともにすわらせ、その民,たみの君,きみたちと共,ともにすわらせられる。","tok":[["もろもろ"],["の"],["君","きみ"],["たち"],["と"],["共","とも"],["に"],["すわらせ"],["、"],["その"],["民","たみ"],["の"],["君","きみ"],["たち"],["と"],["共","とも"],["に"],["すわらせられる"],["。"]]},{"verse":9,"text":"また子,こを産,うまぬ女,おんなに家庭,かていを与,あたえ、多,おおくの子供,こどもたちの喜,よろこばしい母,ははとされる。主,しゅをほめたたえよ。","tok":[["また"],["子","こ"],["を"],["産まぬ","うまぬ"],["女","おんな"],["に"],["家庭","かてい"],["を"],["与","あたえ"],["、"],["多く","おおく"],["の"],["子供","こども"],["たち"],["の"],["喜こば","よろこば"],["しい"],["母","はは"],["と"],["される"],["。"],["主","しゅ"],["を"],["ほめたたえ"],["よ"],["。"]]}]
[{"verse":1,"text":"【アサフのマスキールの歌,うた】神,かみよ、なぜ、われらをとこしえに捨,すてられるのですか。なぜ、あなたの牧,ぼくの羊,ひつじに怒,いかりを燃,もやされるのですか。","tok":[["【"],["アサフ"],["の"],["マスキール"],["の"],["歌","うた"],["】"],["神","かみ"],["よ"],["、"],["なぜ"],["、"],["われ"],["ら"],["を"],["とこしえ"],["に"],["捨てられる","すてられる"],["の"],["です"],["か"],["。"],["なぜ"],["、"],["あなた"],["の"],["牧","ぼく"],["の"],["羊","ひつじ"],["に"],["怒り","いかり"],["を"],["燃やされる","もやされる"],["の"],["です"],["か"],["。"]]},{"verse":2,"text":"昔,むかしあなたが手,てに入,いれられたあなたの公会,こうかい、すなわち、あなたの嗣,し業,ぎょうの部族,ぶぞくとなすためにあがなわれたものを思,おもい出,だしてください。あなたが住,すまわれたシオンの山,やまを思,おもい出,だしてください。","tok":[["昔","むかし"],["あなた"],["が"],["手","て"],["に"],["入れられた","いれられた"],["あなた"],["の"],["公会","こうかい"],["、"],["すなわち"],["、"],["あなた"],["の"],["嗣業","しぎょう"],["の"],["部族","ぶぞく"],["と"],["なす"],["ため"],["に"],["あがなわれた"],["もの"],["を"],["思い出して","おもいだして"],["ください"],["。"],["あなた"],["が"],["住まわれた","すまわれた"],["シオン"],["の"],["山","やま"],["を"],["思い出して","おもいだして"],["ください"],["。"]]},{"verse":3,"text":"とこしえの滅,ほろびの跡,あとに、あなたの足,あしを向,むけてください。敵,てきは聖所,せいじょで、すべての物,ものを破壊,はかいしました。","tok":[["とこしえ"],["の"],["滅び","ほろび"],["の"],["跡","あと"],["に"],["、"],["あなた"],["の"],["足","あし"],["を"],["向けて","むけて"],["ください"],["。"],["敵","てき"],["は"],["聖","せい"],["所","しょ"],["い"],["じょ"],["で"],["、"],["すべて"],["の"],["物","もの"],["を"],["破壊","はかい"],["しました"],["。"]]},{"verse":4,"text":"あなたのあだは聖所,せいじょの中,なかでほえさけび、彼,かれらのしるしを立,たてて、しるしとしました。","tok":[["あなた"],["の"],["あだ"],["は"],["聖","せい"],["所","しょ"],["の"],["中","なか"],["で"],["ほえ"],["さけび"],["、"],["彼","かれ"],["ら"],["の"],["しるし"],["を"],["立てて","たてて"],["、"],["しるし"],["と"],["しました"],["。"]]},{"verse":5,"text":"彼,かれらは上,うえの入口,いりぐちでは、おのをもって木,きの格子,こうし垣,かきを切,きり倒,たおしました。","tok":[["彼","かれ"],["ら"],["は"],["上","うえ"],["の"],["入口","いりぐち"],["で"],["は"],["、"],["おの"],["を"],["もって"],["木","き"],["の"],["格子","こうし"],["垣","かき"],["を"],["切り倒しました","きりたおしました"],["。"]]},{"verse":6,"text":"また彼,かれらは手,ておのと鎚,つちとをもって聖所,せいじょの彫,ほり物,ものをことごとく打,うち落,おとしました。","tok":[["また"],["彼","かれ"],["ら"],["は"],["手おの","ておの"],["と"],["鎚","つちと"],["を"],["もって"],["聖","せい"],["所","しょ"],["の"],["彫物","ほりもの"],["を"],["ことごとく"],["打ち落としました","うちおとしました"],["。"]]},{"verse":7,"text":"彼,かれらはあなたの聖所,せいじょに火,ひをかけ、み名,なのすみかをけがして、地,ちに倒,たおしました。","tok":[["彼","かれ"],["ら"],["は"],["あなた"],["の"],["聖","せい"],["所","しょ"],["に"],["火","ひ"],["を"],["かけ"],["、"],["み名","みな"],["の"],["すみか"],["を"],["けがして"],["、"],["地","ち"],["に"],["倒しました","たおしました"],["。"]]},{"verse":8,"text":"彼,かれらは心,こころのうちに言,いいました、「われらはことごとくこれを滅,ほろぼそう」と。彼,かれらは国,くにのうちの神,かみの会堂,かいどうをことごとく焼,やきました。","tok":[["彼","かれ"],["ら"],["は"],["心","こころ"],["の"],["うち"],["に"],["言いました","いいました"],["、"],["「"],["われ"],["ら"],["は"],["ことごとく"],["これ"],["を"],["滅ぼそう","ほろぼそう"],["」"],["と"],["。"],["彼","かれ"],["ら"],["は"],["国","くに"],["の"],["うち"],["の"],["神","かみ"],["の"],["会堂","かいどう"],["を"],["ことごとく"],["焼きました","やきました"],["。"]]},{"verse":9,"text":"われらは自分,じぶんたちのしるしを見,みません。預言者,よげんしゃも今,いまはいません。そしていつまで続,つづくのか、われらのうちには、知,しる者,ものがありません。","tok":[["われ"],["ら"],["は"],["自分","じぶん"],["たち"],["の"],["しるし"],["を"],["見ません","みません"],["。"],["預言者","よげんしゃ"],["も"],["今","いま"],["は"],["いません"],["。"],["そして"],["いつ"],["まで"],["続","つづく"],["の"],["か"],["、"],["われ"],["ら"],["の"],["うち"],["に"],["は"],["、"],["知る","しる"],["者","もの"],["が"],["ありません"],["。"]]},{"verse":10,"text":"神,かみよ、あだはいつまであざけるでしょうか。敵,てきはとこしえにあなたの名,なをののしるでしょうか。","tok":[["神","かみ"],["よ"],["、"],["あだ"],["は"],["いつ"],["まで"],["あざけるでしょう"],["か"],["。"],["敵","てき"],["は"],["とこしえ"],["に"],["あなた"],["の"],["名","な"],["を"],["ののしるでしょう"],["か"],["。"]]},{"verse":11,"text":"なぜあなたは手,てを引,ひかれるのですか。なぜあなたは右,みぎの手,てをふところに入,いれておかれるのですか。","tok":[["なぜ"],["あなた"],["は"],["手","て"],["を"],["引かれる","ひかれる"],["の"],["です"],["か"],["。"],["なぜ"],["あなた"],["は"],["右","みぎ"],["の"],["手","て"],["を"],["ふところ"],["に"],["入れて","いれて"],["おかれる"],["の"],["です"],["か"],["。"]]},{"verse":12,"text":"神,かみはいにしえからわたしの王,おうであって、救,すくいを世,よの中,なかに行,おこなわれた。","tok":[["神","かみ"],["は"],["いにしえ"],["から"],["わたし"],["の"],["王","おう"],["で"],["あって"],["、"],["救い","すくい"],["を"],["世の中","よのなか"],["に"],["行なわれた","おこなわれた"],["。"]]},{"verse":13,"text":"あなたはみ力,ちからをもって海,うみをわかち、水,みずの上,うえの龍,りゅうの頭,あたまを砕,くだかれた。","tok":[["あなた"],["は"],["み力","みちから"],["を"],["もって"],["海","うみ"],["を"],["わかち"],["、"],["水","みず"],["の"],["上","うえ"],["の"],["龍","りゅう"],["の"],["頭","あたま"],["を"],["砕かれた","くだかれた"],["。"]]},{"verse":14,"text":"あなたはレビヤタンの頭,あたまをくだき、これを野,のの獣,けものに与,あたえてえじきとされた。","tok":[["あなた"],["は"],["レビヤタン"],["の"],["頭","あたま"],["を"],["くだき"],["、"],["これ"],["を"],["野","の"],["の"],["獣","けもの"],["に"],["与","あたえ"],["て"],["えじき"],["と"],["された"],["。"]]},{"verse":15,"text":"あなたは泉,いずみと流,ながれとを開,ひらき、絶,たえず流,ながれるもろもろの川,かわをからされた。","tok":[["あなた"],["は"],["泉","いずみ"],["と"],["流れ","ながれ"],["と"],["を"],["開らき","ひらき"],["、"],["絶えず","たえず"],["流れる","ながれる"],["もろもろ"],["の"],["川","かわ"],["を"],["からされた"],["。"]]},{"verse":16,"text":"昼,ひるはあなたのもの、夜,よるもまたあなたのもの。あなたは光,ひかりと太陽,たいようとを設,もうけられた。","tok":[["昼","ひる"],["は"],["あなた"],["の"],["もの"],["、"],["夜","よる"],["も"],["また"],["あなた"],["の"],["もの"],["。"],["あなた"],["は"],["光","ひかり"],["と"],["太陽","たいよう"],["と"],["を"],["設けられた","もうけられた"],["。"]]},{"verse":17,"text":"あなたは地,ちのもろもろの境,さかいを定,さだめ、夏,なつと冬,ふゆとを造,つくられた。","tok":[["あなた"],["は"],["地","ち"],["の"],["もろもろ"],["の"],["境","さかい"],["を"],["定め","さだめ"],["、"],["夏","なつ"],["と"],["冬","ふゆ"],["と"],["を"],["造られた","つくられた"],["。"]]},{"verse":18,"text":"主,しゅよ、敵,てきはあなたをあざけり、愚,おろかな民,たみはあなたのみ名,なをののしります。この事,ことを思,おもい出,だしてください。","tok":[["主","しゅ"],["よ"],["、"],["敵","てき"],["は"],["あなた"],["を"],["あざけり"],["、"],["愚か","おろか"],["な"],["民","たみ"],["は"],["あなた"],["のみ"],["名","な"],["を"],["ののしります"],["。"],["この"],["事","こと"],["を"],["思い出して","おもいだして"],["ください"],["。"]]},{"verse":19,"text":"どうかあなたのはとの魂,たましいを野,のの獣,けものにわたさないでください。貧,まずしい者,もののいのちをとこしえに忘,わすれないでください。","tok":[["どう"],["か"],["あなた"],["の"],["はと"],["の"],["魂","たましい"],["を"],["野","の"],["の"],["獣","けもの"],["に"],["わたさないで"],["ください"],["。"],["貧しい","まずしい"],["者","もの"],["の"],["いのち"],["を"],["とこしえ"],["に"],["忘ないで","わすれないで"],["ください"],["。"]]},{"verse":20,"text":"あなたの契約,けいやくをかえりみてください。地,ちの暗,くらい所,ところは暴力,ぼうりょくのすまいで満,みちています。","tok":[["あなた"],["の"],["契約","けいやく"],["を"],["かえりみて"],["ください"],["。"],["地","ち"],["の"],["暗い","くらい"],["所","ところ"],["は"],["暴力","ぼうりょく"],["の"],["すまい"],["で"],["満ちて","みちて"],["います"],["。"]]},{"verse":21,"text":"しえたげられる者,ものを恥,はじさせないでください。貧,まずしい者,ものと乏,とぼしい者,ものとにみ名,なをほめたたえさせてください。","tok":[["し"],["えたげられる"],["者","もの"],["を"],["恥","はじ"],["させないで"],["ください"],["。"],["貧しい","まずしい"],["者","もの"],["と"],["乏い","とぼしい"],["者","もの"],["と"],["に"],["み名","みな"],["を"],["ほめたたえさせて"],["ください"],["。"]]},{"verse":22,"text":"神,かみよ、起,おきてあなたの訴,うったえをあげつらい、愚,おろかな者,もののひねもすあなたをあざけるのをみこころにとめてください。","tok":[["神","かみ"],["よ"],["、"],["起きて","おきて"],["あなた"],["の"],["訴","うったえ"],["を"],["あげつらい"],["、"],["愚か","おろか"],["な"],["者","もの"],["の"],["ひねもす"],["あなた"],["を"],["あざける"],["の"],["を"],["みこころ"],["に"],["とめて"],["ください"],["。"]]},{"verse":23,"text":"あなたのあだの叫,さけびを忘,わすれないでください。あなたの敵,てきの絶,たえずあげる騒,さわぎを忘,わすれないでください。","tok":[["あなた"],["の"],["あだ"],["の"],["叫","さけび"],["を"],["忘ないで","わすれないで"],["ください"],["。"],["あなた"],["の"],["敵","てき"],["の"],["絶えず","たえず"],["あげる"],["騒","さわぎ"],["を"],["忘ないで","わすれないで"],["ください"],["。"]]}]
[{"verse":1,"text":"[0]【聖歌,せいか隊,たいの指揮者,しきしゃによってうたわせたダビデの歌,うた、さんび】","tok":[["["],["0"],["]"],["【"],["聖歌隊","せいかたい"],["の"],["指揮者","しきしゃ"],["によって"],["うたわせた"],["ダビデ"],["の"],["歌","うた"],["、"],["さん"],["び"],["】"]]},{"verse":2,"text":"[1]神,かみよ、立,たちあがって、その敵,てきを散,ちらし、神,かみを憎,にくむ者,ものをみ前,まえから逃,にげ去,さらせてください。","tok":[["["],["1"],["]"],["神","かみ"],["よ"],["、"],["立ちあがって","たちあがって"],["、"],["その"],["敵","てき"],["を"],["散らし","ちらし"],["、"],["神","かみ"],["を"],["憎む","にくむ"],["者","もの"],["を"],["み前","みまえ"],["から"],["逃","にげ"],["去らせて","さらせて"],["ください"],["。"]]},{"verse":3,"text":"[2]煙,けむりの追,おいやられるように彼,かれらを追,おいやり、ろうの火,ひの前,まえに溶,とけるように悪,あしき者,ものを神,かみの前,まえに滅,ほろぼしてください。","tok":[["["],["2"],["]"],["煙","けむり"],["の"],["追いやられる","おいやられる"],["よう"],["に"],["彼","かれ"],["ら"],["を"],["追いやり","おいやり"],["、"],["ろう"],["の"],["火","ひ"],["の"],["前","まえ"],["に"],["溶ける","とける"],["よう"],["に"],["悪しき","あしき"],["者","もの"],["を"],["神","かみ"],["の"],["前","まえ"],["に"],["滅ぼして","ほろぼして"],["ください"],["。"]]},{"verse":4,"text":"[3]しかし正,ただしい者,ものを喜,よろこばせ、神,かみの前,まえに喜,よろこび踊,おどらせ、喜,よろこび楽,たのしませてください。","tok":[["["],["3"],["]"],["しかし"],["正い","ただしい"],["者","もの"],["を"],["喜こばせ","よろこばせ"],["、"],["神","かみ"],["の"],["前","まえ"],["に"],["喜こび","よろこび"],["踊らせ","おどらせ"],["、"],["喜こび","よろこび"],["楽しませて","たのしませて"],["ください"],["。"]]},{"verse":5,"text":"[4]神,かみにむかって歌,うたえ、そのみ名,なをほめうたえ。雲,くもに乗,のられる者,ものにむかって歌声,うたごえをあげよ。その名,なは主,しゅ、そのみ前,まえに喜,よろこび踊,おどれ。","tok":[["["],["4"],["]"],["神","かみ"],["に"],["むかって"],["歌え","うたえ"],["、"],["その"],["み名","みな"],["を"],["ほめ"],["うたえ"],["。"],["雲","くも"],["に"],["乗られる","のられる"],["者","もの"],["に"],["むかって"],["歌声","うたごえ"],["を"],["あげ"],["よ"],["。"],["その"],["名","な"],["は"],["主","しゅ"],["、"],["その"],["み前","みまえ"],["に"],["喜こび","よろこび"],["踊れ","おどれ"],["。"]]},{"verse":6,"text":"[5]その聖,せいなるすまいにおられる神,かみはみなしごの父,ちち、やもめの保護,ほご者,ものである。","tok":[["["],["5"],["]"],["その"],["聖","せい"],["なる"],["すまい"],["に"],["おられる"],["神","かみ"],["は"],["みなしご"],["の"],["父","ちち"],["、"],["やもめ"],["の"],["保護者","ほごもの"],["で"],["ある"],["。"]]},{"verse":7,"text":"[6]神,かみは寄,よるべなき者,ものに住,すむべき家,いえを与,あたえ、めしゅうどを解,といて幸福,こうふくに導,みちびかれる。しかしそむく者,ものはかわいた地,ちに住,すむ。","tok":[["["],["6"],["]"],["神","かみ"],["は"],["寄るべ","よるべ"],["なき"],["者","もの"],["に"],["住むべき","すむべき"],["家","いえ"],["を"],["与","あたえ"],["、"],["め"],["しゅ"],["うど"],["を"],["解いて","といて"],["幸福","こうふく"],["に"],["導かれる","みちびかれる"],["。"],["しかし"],["そむく"],["者","もの"],["は"],["かわいた"],["地","ち"],["に"],["住む","すむ"],["。"]]},{"verse":8,"text":"[7]神,かみよ、あなたが民,たみに先,さきだち出,でて、荒野,あらのを進,すすみ行,いかれたとき、〔セラ","tok":[["["],["7"],["]"],["神","かみ"],["よ"],["、"],["あなた"],["が"],["民","たみ"],["に"],["先だち","さきだち"],["出て","でて"],["、"],["荒野","あら"],["の"],["を"],["進み","すすみ"],["行かれた","いかれた"],["とき"],["、"],["〔"],["セラ"]]},{"verse":9,"text":"[8]シナイの主,しゅなる神,かみの前,まえに、イスラエルの神,かみなる神,かみの前,まえに、地,ちは震,ふるい、天,てんは雨,あめを降,ふらせました。","tok":[["["],["8"],["]"],["シナイ"],["の"],["主","しゅ"],["なる"],["神","かみ"],["の"],["前","まえ"],["に"],["、"],["イスラエル"],["の"],["神","かみ"],["なる"],["神","かみ"],["の"],["前","まえ"],["に"],["、"],["地","ち"],["は"],["震い","ふるい"],["、"],["天","てん"],["は"],["雨","あめ"],["を"],["降らせました","ふらせました"],["。"]]},{"verse":10,"text":"[9]神,かみよ、あなたは豊,ゆたかな雨,あめを降,ふらせて、疲,つかれ衰,おとろえたあなたの嗣,し業,ぎょうの地,ちを回復,かいふくされ、","tok":[["["],["9"],["]"],["神","かみ"],["よ"],["、"],["あなた"],["は"],["豊","ゆたか"],["な"],["雨","あめ"],["を"],["降らせて","ふらせて"],["、"],["疲れ","つかれ"],["衰えた","おとろえた"],["あなた"],["の"],["嗣業","しぎょう"],["の"],["地","ち"],["を"],["回復","かいふく"],["され"],["、"]]},{"verse":11,"text":"[10]あなたの群,むれは、そのうちにすまいを得,えました。神,かみよ、あなたは恵,めぐみをもって貧,まずしい者,もののために備,そなえられました。","tok":[["["],["10"],["]"],["あなた"],["の"],["群れ","むれ"],["は"],["、"],["その"],["うち"],["に"],["すまい"],["を"],["得ました","えました"],["。"],["神","かみ"],["よ"],["、"],["あなた"],["は"],["恵","めぐみ"],["を"],["もって"],["貧しい","まずしい"],["者","もの"],["の"],["ため"],["に"],["備","そなえ"],["られました"],["。"]]},{"verse":12,"text":"[11]主,しゅは命令,めいれいを下,くだされる。おとずれを携,たずさえた女,おんなたちの大,おおいなる群,むれは言,いう、","tok":[["["],["11"],["]"],["主","しゅ"],["は"],["命令","めいれい"],["を"],["下される","くだされる"],["。"],["おとずれ"],["を"],["携えた","たずさえた"],["女","おんな"],["たち"],["の"],["大いなる","おおいなる"],["群れ","むれ"],["は"],["言う","いう"],["、"]]},{"verse":13,"text":"[12]「もろもろの軍勢,ぐんぜいの王,おうたちは逃,にげ去,さり、逃,にげ去,さった」と。家,いえにとどまる女,おんなたちは獲物,えものを分,わける、","tok":[["["],["12"],["]"],["「"],["もろもろ"],["の"],["軍勢","ぐんぜい"],["の"],["王","おう"],["たち"],["は"],["逃","にげ"],["去り","さり"],["、"],["逃去","にげさっ"],["た"],["」"],["と"],["。"],["家","いえ"],["に"],["とどまる"],["女","おんな"],["たち"],["は"],["獲物","えもの"],["を"],["分ける","わける"],["、"]]},{"verse":14,"text":"[13]たとい彼,かれらは羊,ひつじのおりの中,なかにとどまるとも。はとの翼,つばさは、しろがねをもっておおわれ、その羽,はねはきらめくこがねをもっておおわれる。","tok":[["["],["13"],["]"],["たとい"],["彼","かれ"],["ら"],["は"],["羊","ひつじ"],["の"],["おり"],["の"],["中","なか"],["に"],["とどまる"],["とも"],["。"],["はと"],["の"],["翼","つばさ"],["は"],["、"],["しろがね"],["を"],["もって"],["おおわれ"],["、"],["その"],["羽","はね"],["は"],["きらめく"],["こがね"],["を"],["もって"],["おおわれる"],["。"]]},{"verse":15,"text":"[14]全能者,ぜんのうしゃがかしこで王,おうたちを散,ちらされたとき、ザルモンに雪,ゆきが降,ふった。","tok":[["["],["14"],["]"],["全能者","ぜんのうしゃ"],["が"],["かしこ"],["で"],["王","おう"],["たち"],["を"],["散らされた","ちらされた"],["とき"],["、"],["ザルモン"],["に"],["雪","ゆき"],["が"],["降った","ふった"],["。"]]},{"verse":16,"text":"[15]神,かみの山,やま、バシャンの山,やま、峰,みねかさなる山,やま、バシャンの山,やまよ。","tok":[["["],["15"],["]"],["神","かみ"],["の"],["山","やま"],["、"],["バシャン"],["の"],["山","やま"],["、"],["峰","みね"],["かさなる"],["山","やま"],["、"],["バシャン"],["の"],["山","やま"],["よ"],["。"]]},{"verse":17,"text":"[16]峰,みねかさなるもろもろの山,やまよ、何,なにゆえ神,かみがすまいにと望,のぞまれた山,やまをねたみ見,みるのか。まことに主,しゅはとこしえにそこに住,すまわれる。","tok":[["["],["16"],["]"],["峰","みね"],["かさなる"],["もろもろ"],["の"],["山","やま"],["よ"],["、"],["何ゆえ","なにゆえ"],["神","かみ"],["が"],["すまい"],["に"],["と"],["望まれた","のぞまれた"],["山","やま"],["を"],["ねたみ"],["見る","みる"],["の"],["か"],["。"],["まこと"],["に"],["主","しゅ"],["は"],["とこしえ"],["に"],["そこ"],["に"],["住まわれる","すまわれる"],["。"]]},{"verse":18,"text":"[17]主,しゅは神,かみのいくさ車,ぐるま幾,いく千万,せんまんをもって、シナイから聖所,せいじょに来,こられた。","tok":[["["],["17"],["]"],["主","しゅ"],["は"],["神","かみ"],["の"],["いくさ車","いくさぐ"],["る"],["ま"],["幾","いく"],["千万","せんまん"],["を"],["もって"],["、"],["シナイ"],["から"],["聖","せい"],["所","しょ"],["に"],["来られた","こられた"],["。"]]},{"verse":19,"text":"[18]あなたはとりこを率,ひきい、人々,ひとびとのうちから、またそむく者,もののうちから贈,おくり物,ものをうけて、高,たかい山,やまに登,のぼられた。主,しゅなる神,かみがそこに住,すまわれるためである。","tok":[["["],["18"],["]"],["あなた"],["は"],["とりこ"],["を"],["率い","ひきい"],["、"],["人々","ひとびと"],["の"],["うち"],["から"],["、"],["また"],["そむく"],["者","もの"],["の"],["うち"],["から"],["贈り物","おくりもの"],["を"],["うけて"],["、"],["高かい","たかい"],["山","やま"],["に"],["登られた","のぼられた"],["。"],["主","しゅ"],["なる"],["神","かみ"],["が"],["そこ"],["に"],["住まわれる","すまわれる"],["ため"],["で"],["ある"],["。"]]},{"verse":20,"text":"[19]日々,ひびにわれらの荷,にを負,おわれる主,しゅはほむべきかな。神,かみはわれらの救,すくいである。〔セラ","tok":[["["],["19"],["]"],["日々","ひび"],["に"],["われ"],["ら"],["の"],["荷","に"],["を"],["負われる","おわれる"],["主","しゅ"],["は"],["ほ"],["むべき"],["か"],["な"],["。"],["神","かみ"],["は"],["われ"],["ら"],["の"],["救い","すくい"],["で"],["ある"],["。"],["〔"],["セラ"]]},{"verse":21,"text":"[20]われらの神,かみは救,すくいの神,かみである。死,しからのがれ得,えるのは主,しゅなる神,かみによる。","tok":[["["],["20"],["]"],["われ"],["ら"],["の"],["神","かみ"],["は"],["救い","すくい"],["の"],["神","かみ"],["で"],["ある"],["。"],["死","し"],["から"],["のがれ"],["得る","える"],["の"],["は"],["主","しゅ"],["なる"],["神","かみ"],["に"],["よる"],["。"]]},{"verse":22,"text":"[21]神,かみはその敵,てきのこうべを打,うち砕,くだき、おのがとがの中,なかに歩,あゆむ者,ものの毛深,けぶかい頭,あたまのいただきを打,うち砕,くだかれる。","tok":[["["],["21"],["]"],["神","かみ"],["は"],["その"],["敵","てき"],["の"],["こうべ"],["を"],["打ち砕き","うちくだき"],["、"],["お"],["の"],["が"],["とが"],["の"],["中","なか"],["に"],["歩む","あゆむ"],["者","もの"],["の"],["毛深い","けぶかい"],["頭","あたま"],["の"],["いただき"],["を"],["打ち砕かれる","うちくだかれる"],["。"]]},{"verse":23,"text":"[22]主,しゅは言,いわれた、「わたしはバシャンから彼,かれらを携,たずさえ帰,かえり、海,うみの深,ふかい所,ところから彼,かれらを携,たずさえ帰,かえる。","tok":[["["],["22"],["]"],["主","しゅ"],["は"],["言われた","いわれた"],["、"],["「"],["わたし"],["は"],["バシャン"],["から"],["彼","かれ"],["ら"],["を"],["携え","たずさえ"],["帰えり","かえり"],["、"],["海","うみ"],["の"],["深い","ふかい"],["所","ところ"],["から"],["彼","かれ"],["ら"],["を"],["携え","たずさえ"],["帰える","かえる"],["。"]]},{"verse":24,"text":"[23]あなたはその足,あしを彼,かれらの血,ちに浸,ひたし、あなたの犬,いぬの舌,したはその分,わけ前,まえを敵,てきから得,えるであろう」と。","tok":[["["],["23"],["]"],["あなた"],["は"],["その"],["足","あし"],["を"],["彼","かれ"],["ら"],["の"],["血","ち"],["に"],["浸し","ひたし"],["、"],["あなた"],["の"],["犬","いぬ"],["の"],["舌","した"],["は"],["その"],["分け前","わけまえ"],["を"],["敵","てき"],["から"],["得るで","えるで"],["あろう"],["」"],["と"],["。"]]},{"verse":25,"text":"[24]神,かみよ、人々,ひとびとはあなたのこうごうしい行列,ぎょうれつを見,みた。わが神,かみ、わが王,おうの、聖所,せいじょに進,すすみ行,ゆかれるのを見,みた。","tok":[["["],["24"],["]"],["神","かみ"],["よ"],["、"],["人々","ひとびと"],["は"],["あなた"],["の"],["こうごうしい"],["行列","ぎょうれつ"],["を"],["見た","みた"],["。"],["わが"],["神","かみ"],["、"],["わが"],["王","おう"],["の"],["、"],["聖","せい"],["所","しょ"],["に"],["進み","すすみ"],["行","ゆかれる"],["の"],["を"],["見た","みた"],["。"]]},{"verse":26,"text":"[25]歌,うたう者,ものは前,まえに行,いき、琴,ことをひく者,ものはあとになり、おとめらはその間,あいだにあって手,て鼓,つづみを打,うって言,いう、","tok":[["["],["25"],["]"],["歌う","うたう"],["者","もの"],["は"],["前","まえ"],["に"],["行き","いき"],["、"],["琴","こと"],["を"],["ひく"],["者","もの"],["は"],["あと"],["に"],["なり"],["、"],["おとめ"],["ら"],["は"],["その"],["間","あいだ"],["に"],["あって"],["手","て"],["鼓","つづみ"],["を"],["打って","うって"],["言う","いう"],["、"]]},{"verse":27,"text":"[26]「大,おおいなる集会,しゅうかいで神,かみをほめよ。イスラエルの源,みなもとから出,でた者,ものよ、主,しゅをほめまつれ」と。","tok":[["["],["26"],["]"],["「"],["大いなる","おおいなる"],["集会","しゅうかい"],["で"],["神","かみ"],["を"],["ほめよ"],["。"],["イスラエル"],["の"],["源","みなもと"],["から"],["出た","でた"],["者","もの"],["よ"],["、"],["主","しゅ"],["を"],["ほめ"],["まつれ"],["」"],["と"],["。"]]},{"verse":28,"text":"[27]そこに彼,かれらを導,みちびく年,とし若,わかいベニヤミンがおり、その群,むれの中,なかにユダの君,きみたちがおり、ゼブルンの君,きみたち、ナフタリの君,きみたちがいる。","tok":[["["],["27"],["]"],["そこ"],["に"],["彼","かれ"],["ら"],["を"],["導く","みちびく"],["年","とし"],["若い","わかい"],["ベニヤミン"],["が"],["おり"],["、"],["その"],["群れ","むれ"],["の"],["中","なか"],["に"],["ユダ"],["の"],["君","きみ"],["たち"],["が"],["おり"],["、"],["ゼブルン"],["の"],["君","きみ"],["たち"],["、"],["ナフタリ"],["の"],["君","きみ"],["たち"],["が"],["いる"],["。"]]},{"verse":29,"text":"[28]神,かみよ、あなたの大能,たいのうを奮,ふるい起,おこしてください。われらのために事,ことをなされた神,かみよ、あなたの力,ちからをお示,しめしください。","tok":[["["],["28"],["]"],["神","かみ"],["よ"],["、"],["あなた"],["の"],["大能","たいのう"],["を"],["奮い起こして","ふるいおこして"],["ください"],["。"],["われ"],["ら"],["の"],["ため"],["に"],["事","こと"],["を"],["なされた"],["神","かみ"],["よ"],["、"],["あなた"],["の"],["力","ちから"],["を"],["お示めし","おしめし"],["ください"],["。"]]},{"verse":30,"text":"[29]エルサレムにあるあなたの宮,みやのために、王,おうたちはあなたに贈,おくり物,ものをささげるでしょう。","tok":[["["],["29"],["]"],["エルサレム"],["に"],["ある"],["あなた"],["の"],["宮","みや"],["の"],["ため"],["に"],["、"],["王","おう"],["たち"],["は"],["あなた"],["に"],["贈り物","おくりもの"],["を"],["ささげるでしょう"],["。"]]},{"verse":31,"text":"[30]葦,あしの中,なかに住,すむ獣,けもの、もろもろの民,たみの子,こ牛,うしを率,ひきいる雄牛,おうしの群,むれをいましめてください。みつぎ物,ものをむさぼる者,ものたちを足,あしの下,したに踏,ふみつけ、戦,たたかいを好,このむもろもろの民,たみを散,ちらしてください。","tok":[["["],["30"],["]"],["葦","あし"],["の"],["中","なか"],["に"],["住む","すむ"],["獣","けもの"],["、"],["もろもろ"],["の"],["民","たみ"],["の"],["子牛","こうし"],["を"],["率いる","ひきいる"],["雄牛","おうし"],["の"],["群れ","むれ"],["を"],["いましめて"],["ください"],["。"],["みつぎ"],["物","もの"],["を"],["むさぼる"],["者","もの"],["たち"],["を"],["足","あし"],["の"],["下","した"],["に"],["踏みつけ","ふみつけ"],["、"],["戦い","たたかい"],["を"],["好む","このむ"],["もろもろ"],["の"],["民","たみ"],["を"],["散らして","ちらして"],["ください"],["。"]]},{"verse":32,"text":"[31]青銅,せいどうをエジプトから持,もちきたらせ、エチオピヤには急,いそいでその手,てを神,かみに伸,のべさせてください。","tok":[["["],["31"],["]"],["青銅","せいどう"],["を"],["エジプト"],["から"],["持","もち"],["きたらせ"],["、"],["エチオピヤ"],["に"],["は"],["急いで","いそいで"],["その"],["手","て"],["を"],["神","かみ"],["に"],["伸べさせて","のべさせて"],["ください"],["。"]]},{"verse":33,"text":"[32]地,ちのもろもろの国,くによ、神,かみにむかって歌,うたえ、主,しゅをほめうたえ。〔セラ","tok":[["["],["32"],["]"],["地","ち"],["の"],["もろもろ"],["の"],["国","くに"],["よ"],["、"],["神","かみ"],["に"],["むかって"],["歌え","うたえ"],["、"],["主","しゅ"],["を"],["ほめ"],["うたえ"],["。"],["〔"],["セラ"]]},{"verse":34,"text":"[33]いにしえからの天,てんの天,てんに乗,のられる主,しゅにむかってほめうたえ。見,みよ、主,しゅはみ声,こえを出,だし、力,ちからあるみ声,こえを出,だされる。","tok":[["["],["33"],["]"],["いにしえ"],["から"],["の"],["天","てん"],["の"],["天","てん"],["に"],["乗られる","のられる"],["主","しゅ"],["に"],["むかって"],["ほめ"],["うたえ"],["。"],["見よ","みよ"],["、"],["主","しゅ"],["は"],["み声","みこえ"],["を"],["出し","だし"],["、"],["力","ちから"],["ある"],["み声","みこえ"],["を"],["出される","だされる"],["。"]]},{"verse":35,"text":"[34]力,ちからを神,かみに帰,かえせよ。その威光,いこうはイスラエルの上,うえにあり、その力,ちからは雲,くもの中,なかにある。","tok":[["["],["34"],["]"],["力","ちから"],["を"],["神","かみ"],["に"],["帰せよ","かえせよ"],["。"],["その"],["威光","いこう"],["は"],["イスラエル"],["の"],["上","うえ"],["に"],["あり"],["、"],["その"],["力","ちから"],["は"],["雲","くも"],["の"],["中","なか"],["に"],["ある"],["。"]]},{"verse":36,"text":"[35]神,かみはその聖所,せいじょで恐,おそれるべく、イスラエルの神,かみはその民,たみに力,ちからと勢,いきおいとを与,あたえられる。神,かみはほむべきかな。","tok":[["["],["35"],["]"],["神","かみ"],["は"],["その"],["聖","せい"],["所","しょ"],["い"],["じょ"],["で"],["恐れるべく","おそれるべく"],["、"],["イスラエル"],["の"],["神","かみ"],["は"],["その"],["民","たみ"],["に"],["力","ちから"],["と"],["勢","いきおい"],["と"],["を"],["与えられる","あたえられる"],["。"],["神","かみ"],["は"],["ほ"],["むべき"],["か"],["な"],["。"]]}]
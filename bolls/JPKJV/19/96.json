[{"verse":1,"text":"新,あたらしい歌,うたを主,しゅにむかってうたえ。全,ぜん地,ちよ、主,しゅにむかってうたえ。","tok":[["新らしい","あたらしい"],["歌","うた"],["を"],["主に","しゅに"],["むかって"],["うたえ"],["。"],["全地","ぜんち"],["よ"],["、"],["主に","しゅに"],["むかって"],["うたえ"],["。"]]},{"verse":2,"text":"主,しゅにむかって歌,うたい、そのみ名,なをほめよ。日,ひごとにその救,すくいを宣,のべ伝,つたえよ。","tok":[["主に","しゅに"],["むか"],["って"],["歌い","うたい"],["、"],["その"],["み名","みな"],["を"],["ほめよ"],["。"],["日ごと","ひごと"],["に"],["その"],["救い","すくい"],["を"],["宣べ伝え","のべつたえ"],["よ"],["。"]]},{"verse":3,"text":"もろもろの国,くにの中,なかにその栄光,えいこうをあらわし、もろもろの民,たみの中,なかにそのくすしきみわざをあらわせ。","tok":[["もろもろ"],["の"],["国","くに"],["の"],["中","なか"],["に"],["その"],["栄光","えいこう"],["を"],["あらわし"],["、"],["もろもろ"],["の"],["民","たみ"],["の"],["中","なか"],["に"],["その"],["くす"],["しきみ"],["わざ"],["を"],["あらわせ"],["。"]]},{"verse":4,"text":"主,しゅは大,おおいなる神,かみであって、いともほめたたうべきもの、もろもろの神,かみにまさって恐,おそるべき者,ものである。","tok":[["主","しゅ"],["は"],["大いなる","おおいなる"],["神","かみ"],["で"],["あって"],["、"],["いとも"],["ほめ"],["たたうべき"],["もの"],["、"],["もろもろ"],["の"],["神","かみ"],["に"],["まさって"],["恐るべき","おそるべき"],["者","もの"],["で"],["ある"],["。"]]},{"verse":5,"text":"もろもろの民,たみのすべての神,かみはむなしい。しかし主,しゅはもろもろの天,てんを造,つくられた。","tok":[["もろもろ"],["の"],["民","たみ"],["の"],["すべて"],["の"],["神","かみ"],["は"],["むなしい"],["。"],["しかし"],["主","しゅ"],["は"],["もろもろ"],["の"],["天","てん"],["を"],["造られた","つくられた"],["。"]]},{"verse":6,"text":"誉,ほまれと、威厳,いげんとはそのみ前,まえにあり、力,ちからと、うるわしさとはその聖所,せいじょにある。","tok":[["誉","ほまれ"],["と"],["、"],["威厳","いげん"],["と"],["は"],["その"],["み前","みまえ"],["に"],["あり"],["、"],["力","ちから"],["と"],["、"],["うるわし"],["さ"],["と"],["は"],["その"],["聖","せい"],["所","しょ"],["に"],["ある"],["。"]]},{"verse":7,"text":"もろもろの民,たみのやからよ、主,しゅに帰,きせよ、栄光,えいこうと力,ちからとを主,しゅに帰,きせよ。","tok":[["もろもろ"],["の"],["民","たみ"],["の"],["やから"],["よ"],["、"],["主に","しゅに"],["帰せよ","きせよ"],["、"],["栄光","えいこう"],["と"],["力","ちから"],["と"],["を"],["主に","しゅに"],["帰せ","きせ"],["よ"],["。"]]},{"verse":8,"text":"そのみ名,なにふさわしい栄光,えいこうを主,しゅに帰,きせよ。供,そなえ物,ものを携,たずさえてその大庭,おおにわにきたれ。","tok":[["その"],["み名","みな"],["に"],["ふさわしい"],["栄光","えいこう"],["を"],["主に","しゅに"],["帰せ","きせ"],["よ"],["。"],["供え物","そなえもの"],["を"],["携えて","たずさえて"],["その"],["大庭","おおにわ"],["に"],["きたれ"],["。"]]},{"verse":9,"text":"聖,せいなる装,よそおいをして主,しゅを拝,おがめ、全,ぜん地,ちよ、そのみ前,まえにおののけ。","tok":[["聖","せい"],["なる"],["装い","よそおい"],["を"],["して"],["主","しゅ"],["を"],["拝め","おがめ"],["、"],["全地","ぜんち"],["よ"],["、"],["その"],["み前","みまえ"],["に"],["おののけ"],["。"]]},{"verse":10,"text":"もろもろの国民,こくみんの中,なかに言,いえ、「主,しゅは王,おうとなられた。世界,せかいは堅,かたく立,たって、動,うごかされることはない。主,しゅは公平,こうへいをもってもろもろの民,たみをさばかれる」と。","tok":[["もろもろ"],["の"],["国民","こくみん"],["の"],["中","なか"],["に"],["言え","いえ"],["、"],["「"],["主","しゅ"],["は"],["王","おう"],["と"],["なられた"],["。"],["世界","せかい"],["は"],["堅く","かたく"],["立って","たって"],["、"],["動かされる","うごかされる"],["こと"],["は"],["ない"],["。"],["主","しゅ"],["は"],["公平","こうへい"],["を"],["もって"],["もろもろ"],["の"],["民","たみ"],["を"],["さばかれる"],["」"],["と"],["。"]]},{"verse":11,"text":"天,てんは喜,よろこび、地,ちは楽,たのしみ、海,うみとその中,なかに満,みちるものとは鳴,なりどよめき、","tok":[["天","てん"],["は"],["喜こび","よろこび"],["、"],["地","ち"],["は"],["楽み","たのしみ"],["、"],["海","うみ"],["と"],["その"],["中","なか"],["に"],["満ちる","みちる"],["もの"],["と"],["は"],["鳴り","なり"],["どよめき"],["、"]]},{"verse":12,"text":"田畑,たはたとその中,なかのすべての物,ものは大,おおいに喜,よろこべ。そのとき、林,はやしのもろもろの木,きも主,しゅのみ前,まえに喜,よろこび歌,うたうであろう。","tok":[["田畑","たはた"],["と"],["その"],["中","なか"],["の"],["すべて"],["の"],["物","もの"],["は"],["大いに","おおいに"],["喜こべ","よろこべ"],["。"],["その"],["とき"],["、"],["林","はやし"],["の"],["もろもろ"],["の"],["木","き"],["も"],["主","しゅ"],["のみ"],["前","まえ"],["に"],["喜こび","よろこび"],["歌うで","うたうで"],["あろう"],["。"]]},{"verse":13,"text":"主,しゅは来,こられる、地,ちをさばくために来,こられる。主,しゅは義,ぎをもって世界,せかいをさばき、まことをもってもろもろの民,たみをさばかれる。","tok":[["主","しゅ"],["は"],["来られる","こられる"],["、"],["地","ち"],["を"],["さばく"],["ため"],["に"],["来られる","こられる"],["。"],["主","しゅ"],["は"],["義","ぎ"],["を"],["もって"],["世界","せかい"],["を"],["さばき"],["、"],["まこと"],["を"],["もって"],["もろもろ"],["の"],["民","たみ"],["を"],["さばかれる"],["。"]]}]
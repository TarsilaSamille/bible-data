["を"],["求めました","もとめました"],["。"]]},{"verse":95,"text":"悪,あしき者,ものはわたしを滅,ほろぼそうと待,まち伏,ぶせています。しかし、わたしはあなたのあかしを思,おもいます。","tok":[["悪しき","あしき"],["者","もの"],["は"],["わたし"],["を"],["滅ぼそう","ほろぼそう"],["と"],["待伏","まちぶせ"],["て"],["います"],["。"],["しかし"],["、"],["わたし"],["は"],["あなた"],["の"],["あかし"],["を"],["思います","おもいます"],["。"]]},{"verse":96,"text":"わたしはすべての全,まったきことに限,かぎりあることを見,みました。しかしあなたの戒,いましめは限,かぎりなく広,ひろいのです。","tok":[["わたし"],["は"],["すべて"],["の"],["全","まったきこ"],["と"],["に"],["限","かぎり"],["ある"],["こと"],["を"],["見ました","みました"],["。"],["しかし"],["あなた"],["の"],["戒しめ","いましめ"],["は"],["限","かぎり"],["なく"],["広い","ひろい"],["の"],["です"],["。"]]},{"verse":97,"text":"メムいかにわたしはあなたのおきてを愛,あいすることでしょう。わたしはひねもすこれを深,ふかく思,おもいます。","tok":[["メム"],["いかに"],["わたし"],["は"],["あなた"],["の"],["おきて"],["を"],["愛する","あいする"],["こと"],["でしょう"],["。"],["わたし"],["は"],["ひねもす"],["これ"],["を"],["深く","ふかく"],["思います","おもいます"],["。"]]},{"verse":98,"text":"あなたの戒,いましめは常,つねにわたしと共,ともにあるので、わたしをわが敵,てきにまさって賢,かしこくします。","tok":[["あなた"],["の"],["戒しめ","いましめ"],["は"],["常","つね"],["に"],["わたし"],["と"],["共","とも"],["に"],["ある"],["ので"],["、"],["わたし"],["を"],["わが"],["敵","てき"],["に"],["まさって"],["賢しこく","かしこく"],["します"],["。"]]},{"verse":99,"text":"わたしはあなたのあかしを深,ふかく思,おもうので、わがすべての師,しにまさって知恵,ちえがあります。","tok":[["わたし"],["は"],["あなた"],["の"],["あかし"],["を"],["深く","ふかく"],["思","おもう"],["ので"],["、"],["わが"],["すべて"],["の"],["師","し"],["に"],["まさって"],["知恵","ちえ"],["が"],["あります"],["。"]]},{"verse":100,"text":"わたしはあなたのさとしを守,まもるので、老,おいた者,ものにまさって事,ことをわきまえます。","tok":[["わたし"],["は"],["あなた"],["の"],["さとし"],["を"],["守","まもる"],["ので"],["、"],["老","おい"],["た"],["者","もの"],["に"],["まさって"],["事","こと"],["を"],["わきまえます"],["。"]]},{"verse":101,"text":"わたしはみ言葉,ことばを守,まもるために、わが足,あしをとどめて、すべての悪,わるい道,みちに行,いかせません。","tok":[["わたし"],["は"],["み言葉","みことば"],["を"],["守","まもる"],["ため"],["に"],["、"],["わが"],["足","あし"],["を"],["とどめて"],["、"],["すべて"],["の"],["悪い","わるい"],["道","みち"],["に"],["行かせません","いかせません"],["。"]]},{"verse":102,"text":"あなたがわたしを教,おしえられたので、わたしはあなたのおきてを離,はなれません。","tok":[["あなた"],["が"],["わたし"],["を"],["教えられた","おしえられた"],["ので"],["、"],["わたし"],["は"],["あなた"],["の"],["おきて"],["を"],["離れません","はなれません"],["。"]]},{"verse":103,"text":"あなたのみ言葉,ことばはいかにわがあごに甘,あまいことでしょう。蜜,みつにまさってわが口,くちに甘,あまいのです。","tok":[["あなた"],["のみ"],["言葉","ことば"],["は"],["いかに"],["わが"],["あご"],["に"],["甘い","あまい"],["こと"],["でしょう"],["。"],["蜜","みつ"],["に"],["まさって"],["わが"],["口","くち"],["に"],["甘い","あまい"],["の"],["です"],["。"]]},{"verse":104,"text":"わたしはあなたのさとしによって知恵,ちえを得,えました。それゆえ、わたしは偽,いつわりのすべての道,みちを憎,にくみます。","tok":[["わたし"],["は"],["あなた"],["の"],["さとし"],["によって"],["知恵","ちえ"],["を"],["得ました","えました"],["。"],["それ"],["ゆえ"],["、"],["わたし"],["は"],["偽わり","いつわり"],["の"],["すべて"],["の"],["道","みち"],["を"],["憎みます","にくみます"],["。"]]},{"verse":105,"text":"ヌンあなたのみ言葉,ことばはわが足,あしのともしび、わが道,みちの光,ひかりです。","tok":[["ヌン"],["あなた"],["のみ"],["言葉","ことば"],["は"],["わが"],["足","あし"],["の"],["ともしび"],["、"],["わが"],["道","みち"],["の"],["光","ひかり"],["です"],["。"]]},{"verse":106,"text":"わたしはあなたの正,ただしいおきてを守,まもることを誓,ちかい、かつこれを実行,じっこうしました。","tok":[["わたし"],["は"],["あなた"],["の"],["正い","ただしい"],["おきて"],["を"],["守","まもる"],["こと"],["を"],["誓い","ちかい"],["、"],["かつ"],["これ"],["を"],["実行","じっこう"],["しました"],["。"]]},{"verse":107,"text":"わたしはいたく苦,くるしみました。主,しゅよ、み言葉,ことばに従,したがって、わたしを生,いかしてください。","tok":[["わたし"],["は"],["いたく"],["苦しみました","くるしみました"],["。"],["主","しゅ"],["よ"],["、"],["み言葉","みことば"],["に"],["従って","したがって"],["、"],["わたし"],["を"],["生かして","いかして"],["ください"],["。"]]},{"verse":108,"text":"主,しゅよ、わがさんびの供,そなえ物,ものをうけて、あなたのおきてを教,おしえてください。","tok":[["主","しゅ"],["よ"],["、"],["わが"],["さん"],["び"],["の"],["供え物","そなえもの"],["を"],["うけて"],["、"],["あなた"],["の"],["おきて"],["を"],["教えて","おしえて"],["ください"],["。"]]},{"verse":109,"text":"わたしのいのちは常,つねに危険,きけんにさらされています。しかし、わたしはあなたのおきてを忘,わすれません。","tok":[["わたし"],["の"],["いのち"],["は"],["常","つね"],["に"],["危険","きけん"],["に"],["さらされて"],["います"],["。"],["しかし"],["、"],["わたし"],["は"],["あなた"],["の"],["おきて"],["を"],["忘ません","わすれません"],["。"]]},{"verse":110,"text":"悪,あしき者,ものはわたしのためにわなを設,もうけました。しかし、わたしはあなたのさとしから迷,まよい出,でません。","tok":[["悪しき","あしき"],["者","もの"],["は"],["わたし"],["の"],["ため"],["に"],["わな"],["を"],["設けました","もうけました"],["。"],["しかし"],["、"],["わたし"],["は"],["あなた"],["の"],["さとし"],["から"],["迷い出ません","まよいでません"],["。"]]},{"verse":111,"text":"あなたのあかしはとこしえにわが嗣,し業,ぎょうです。まことに、そのあかしはわが心,こころの喜,よろこびです。","tok":[["あなた"],["の"],["あかし"],["は"],["とこしえ"],["に"],["わが"],["嗣業","しぎょ"],["う"],["です"],["。"],["まこと"],["に"],["、"],["その"],["あかし"],["は"],["わが"],["心","こころ"],["の"],["喜こびです","よろこびです"],["。"]]},{"verse":112,"text":"わたしはあなたの定,さだめを終,おわりまで、とこしえに守,まもろうと心,こころを傾,かたむけます。","tok":[["わたし"],["は"],["あなた"],["の"],["定め","さだめ"],["を"],["終","おわり"],["まで"],["、"],["とこしえ"],["に"],["守ろう","まもろう"],["と"],["心","こころ"],["を"],["傾むけます","かたむけます"],["。"]]},{"verse":113,"text":"サメクわたしは二心,ふたごころの者,ものを憎,にくみます。しかしあなたのおきてを愛,あいします。","tok":[["サメク"],["わたし"],["は"],["二心","ふたごころ"],["の"],["者","もの"],["を"],["憎みます","にくみます"],["。"],["しかし"],["あなた"],["の"],["おきて"],["を"],["愛します","あいします"],["。"]]},{"verse":114,"text":"あなたはわが隠,かくれ場,ば、わが盾,たてです。わたしはみ言葉,ことばによって望,のぞみをいだきます。","tok":[["あなた"],["は"],["わが"],["隠れ場","かくれば"],["、"],["わが"],["盾","たて"],["です"],["。"],["わたし"],["は"],["み言葉","みことば"],["によって"],["望み","のぞみ"],["を"],["いだきます"],["。"]]},{"verse":115,"text":"悪,あくをなす者,ものよ、わたしを離,はなれ去,され、わたしはわが神,かみの戒,いましめを守,まもるのです。","tok":[["悪","あく"],["を"],["なす"],["者","もの"],["よ"],["、"],["わたし"],["を"],["離れ去れ","はなれされ"],["、"],["わたし"],["は"],["わが"],["神","かみ"],["の"],["戒しめ","いましめ"],["を"],["守","まもる"],["の"],["です"],["。"]]},{"verse":116,"text":"あなたの約束,やくそくにしたがって、わたしをささえて、ながらえさせ、わが望,のぞみについて恥,はじることのないようにしてください。","tok":[["あなた"],["の"],["約束","やくそく"],["に"],["したがって"],["、"],["わたし"],["を"],["ささえて"],["、"],["ながらえさせ"],["、"],["わが"],["望み","のぞみ"],["について"],["恥","はじ"],["る"],["こと"],["の"],["ない"],["よう"],["に"],["して"],["ください"],["。"]]},{"verse":117,"text":"わたしをささえてください。そうすれば、わたしは安,やすらかで、常,つねにあなたの定,さだめに心,こころをそそぎます。","tok":[["わたし"],["を"],["ささえて"],["ください"],["。"],["そう"],["すれば"],["、"],["わたし"],["は"],["安らか","やすらか"],["で"],["、"],["常","つね"],["に"],["あなた"],["の"],["定め","さだめ"],["に"],["心","こころ"],["を"],["そそぎます"],["。"]]},{"verse":118,"text":"すべてあなたの定,さだめから迷,まよい出,でる者,ものをあなたは、かろしめられます。まことに、彼,かれらの欺,あざむきはむなしいのです。","tok":[["すべて"],["あなた"],["の"],["定め","さだめ"],["から"],["迷い出る","まよいでる"],["者","もの"],["を"],["あなた"],["は"],["、"],["かろしめられます"],["。"],["まこと"],["に"],["、"],["彼","かれ"],["ら"],["の"],["欺き","あざむき"],["は"],["むなしい"],["の"],["です"],["。"]]},{"verse":119,"text":"あなたは地,ちのすべての悪,あしき者,ものを、金,かなかすのようにみなされます。それゆえ、わたしはあなたのあかしを愛,あいします。","tok":[["あなた"],["は"],["地","ち"],["の"],["すべて"],["の"],["悪しき","あしき"],["者","もの"],["を"],["、"],["金","かなかす"],["の"],["よう"],["に"],["みなされます"],["。"],["それ"],["ゆえ"],["、"],["わたし"],["は"],["あなた"],["の"],["あかし"],["を"],["愛します","あいします"],["。"]]},{"verse":120,"text":"わが肉,にくはあなたを恐,おそれるので震,ふるえます。わたしはあなたのさばきを恐,おそれます。","tok":[["わが"],["肉","にく"],["は"],["あなた"],["を"],["恐れる","おそれる"],["ので"],["震えます","ふるえます"],["。"],["わたし"],["は"],["あなた"],["の"],["さばき"],["を"],["恐れます","おそれます"],["。"]]},{"verse":121,"text":"アインわたしは正,ただしく義,ぎにかなったことを行,おこないました。わたしを捨,すてて、しえたげる者,ものにゆだねないでください。","tok":[["アイン"],["わたし"],["は"],["正く","ただしく"],["義","ぎ"],["に"],["かなった"],["こと"],["を"],["行ないました","おこないました"],["。"],["わたし"],["を"],["捨てて","すてて"],["、"],["し"],["えたげる"],["者","もの"],["に"],["ゆだねないで"],["ください"],["。"]]},{"verse":122,"text":"しもべのために保証人,ほしょうにんとなって、高,たかぶる者,ものにわたしを、しえたげさせないでください。","tok":[["しもべ"],["の"],["ため"],["に"],["保証人","ほしょうにん"],["と"],["なって"],["、"],["高か","たか"],["ぶる"],["者","もの"],["に"],["わたし"],["を"],["、"],["し"],["えたげさせないで"],["ください"],["。"]]},{"verse":123,"text":"わが目,めはあなたの救,すくいと、あなたの正,ただしい約束,やくそくとを待,まち望,のぞんで衰,おとろえます。","tok":[["わが"],["目","め"],["は"],["あなた"],["の"],["救い","すくい"],["と"],["、"],["あなた"],["の"],["正い","ただしい"],["約束","やくそく"],["と"],["を"],["待ち望んで","まちのぞんで"],["衰えます","おとろえます"],["。"]]},{"verse":124,"text":"あなたのいつくしみにしたがって、しもべをあしらい、あなたの定,さだめを教,おしえてください。","tok":[["あなた"],["の"],["いつくしみ"],["に"],["したがって"],["、"],["しもべ"],["を"],["あしらい"],["、"],["あなた"],["の"],["定め","さだめ"],["を"],["教えて","おしえて"],["ください"],["。"]]},{"verse":125,"text":"わたしはあなたのしもべです。わたしに知恵,ちえを与,あたえて、あなたのあかしを知,しらせてください。","tok":[["わたし"],["は"],["あなた"],["の"],["しもべ"],["です"],["。"],["わたし"],["に"],["知恵","ちえ"],["を"],["与","あたえ"],["て"],["、"],["あなた"],["の"],["あかし"],["を"],["知らせて","しらせて"],["ください"],["。"]]},{"verse":126,"text":"彼,かれらはあなたのおきてを破,やぶりました。今,いまは主,しゅのはたらかれる時,ときです。","tok":[["彼","かれ"],["ら"],["は"],["あなた"],["の"],["おきて"],["を"],["破りました","やぶりました"],["。"],["今","いま"],["は"],["主","しゅ"],["の"],["はたらかれる"],["時","とき"],["です"],["。"]]},{"verse":127,"text":"それゆえ、わたしは金,きんよりも、純金,じゅんきんよりもまさってあなたの戒,いましめを愛,あいします。","tok":[["それ"],["ゆえ"],["、"],["わたし"],["は"],["金","きん"],["より"],["も"],["、"],["純金","じゅんきん"],["より"],["も"],["まさって"],["あなた"],["の"],["戒しめ","いましめ"],["を"],["愛します","あいします"],["。"]]},{"verse":128,"text":"それゆえ、わたしは、あなたのもろもろのさとしにしたがって、正,ただしき道,みちに歩,あゆみ、すべての偽,いつわりの道,みちを憎,にくみます。","tok":[["それ"],["ゆえ"],["、"],["わたし"],["は"],["、"],["あなた"],["の"],["もろもろ"],["の"],["さとし"],["に"],["したがって"],["、"],["正き","ただしき"],["道","みち"],["に"],["歩み","あゆみ"],["、"],["すべて"],["の"],["偽わり","いつわり"],["の"],["道","みち"],["を"],["憎みます","にくみます"],["。"]]},{"verse":129,"text":"ペあなたのあかしは驚,おどろくべきものです。それゆえ、わが魂,たましいはこれを守,まもります。","tok":[["ペ"],["あなた"],["の"],["あかし"],["は"],["驚ろくべき","おどろくべき"],["もの"],["です"],["。"],["それ"],["ゆえ"],["、"],["わが"],["魂","たましい"],["は"],["これ"],["を"],["守ります","まもります"],["。"]]},{"verse":130,"text":"み言葉,ことばが開,あけると光,ひかりを放,はなって、無学,むがくな者,ものに知恵,ちえを与,あたえます。","tok":[["み言葉","みことば"],["が"],["開ける","あける"],["と"],["光","ひかり"],["を"],["放って","はなって"],["、"],["無学","むがく"],["な"],["者","もの"],["に"],["知恵","ちえ"],["を"],["与えます","あたえます"],["。"]]},{"verse":131,"text":"わたしはあなたの戒,いましめを慕,したうゆえに、口,くちを広,ひろくあけてあえぎ求,もとめました。","tok":[["わたし"],["は"],["あなた"],["の"],["戒しめ","いましめ"],["を"],["慕う","したう"],["ゆえ"],["に"],["、"],["口","くち"],["を"],["広く","ひろく"],["あけて"],["あえぎ"],["求めました","もとめました"],["。"]]},{"verse":132,"text":"み名,なを愛,あいする者,ものに常,つねにされるように、わたしをかえりみ、わたしをあわれんでください。","tok":[["み名","みな"],["を"],["愛する","あいする"],["者","もの"],["に"],["常","つね"],["に"],["される"],["よう"],["に"],["、"],["わたし"],["を"],["かえりみ"],["、"],["わたし"],["を"],["あわれんで"],["ください"],["。"]]},{"verse":133,"text":"あなたの約束,やくそくにしたがって、わが歩,あゆみを確,たしかにし、すべての不義,ふぎに支配,しはいされないようにしてください。","tok":[["あなた"],["の"],["約束","やくそく"],["に"],["したがって"],["、"],["わが"],["歩み","あゆみ"],["を"],["確か","たしか"],["に"],["し"],["、"],["すべて"],["の"],["不義","ふぎ"],["に"],["支配","しはい"],["されない"],["よう"],["に"],["して"],["ください"],["。"]]},{"verse":134,"text":"わたしを人,ひとのしえたげからあがなってください。そうすればわたしは、あなたのさとしを守,まもります。","tok":[["わたし"],["を"],["人","ひと"],["の"],["し"],["えたげ"],["から"],["あがなって"],["ください"],["。"],["そう"],["すれば"],["わたし"],["は"],["、"],["あなた"],["の"],["さとし"],["を"],["守ります","まもります"],["。"]]},{"verse":135,"text":"み顔,かおをしもべの上,うえに照,てらし、あなたの定,さだめを教,おしえてください。","tok":[["み顔","みかお"],["を"],["しもべ"],["の"],["上","うえ"],["に"],["照","てらし"],["、"],["あなた"],["の"],["定め","さだめ"],["を"],["教えて","おしえて"],["ください"],["。"]]},{"verse":136,"text":"人々,ひとびとがあなたのおきてを守,まもらないので、わが目,めの涙,なみだは川,かわのように流,ながれます。","tok":[["人々","ひとびと"],["が"],["あなた"],["の"],["おきて"],["を"],["守らない","まもらない"],["ので"],["、"],["わが"],["目","め"],["の"],["涙","なみだ"],["は"],["川","かわ"],["の"],["よう"],["に"],["流れます","ながれます"],["。"]]},{"verse":137,"text":"ツァデー主,しゅよ、あなたは正,ただしく、あなたのさばきは正,ただしいのです。","tok":[["ツァデー"],["主","しゅ"],["よ"],["、"],["あなた"],["は"],["正く","ただしく"],["、"],["あなた"],["の"],["さばき"],["は"],["正い","ただしい"],["の"],["です"],["。"]]},{"verse":138,"text":"あなたの正義,せいぎと、この上,うえない真実,しんじつとをもってあなたのあかしを命,めいじられました。","tok":[["あなた"],["の"],["正義","せいぎ"],["と"],["、"],["この"],["上","うえ"],["ない"],["真実","しんじつ"],["と"],["を"],["もって"],["あなた"],["の"],["あかし"],["を"],["命じられました","めいじられました"],["。"]]},{"verse":139,"text":"わたしのあだが、あなたのみ言葉,ことばを忘,わすれるので、わが熱心,ねっしんはわたしを滅,ほろぼすのです。","tok":[["わたし"],["の"],["あだ"],["が"],["、"],["あなた"],["のみ"],["言葉","ことば"],["を"],["忘る","わすれる"],["ので"],["、"],["わが"],["熱心","ねっしん"],["は"],["わたし"],["を"],["滅ぼす","ほろぼす"],["の"],["です"],["。"]]},{"verse":140,"text":"あなたの約束,やくそくはまことに確,たしかです。あなたのしもべはこれを愛,あいします。","tok":[["あなた"],["の"],["約束","やくそく"],["は"],["まこと"],["に"],["確か","たしか"],["です"],["。"],["あなた"],["の"],["しもべ"],["は"],["これ"],["を"],["愛します","あいします"],["。"]]},{"verse":141,"text":"わたしは取,とるにたらない者,もので、人,ひとに侮,あなどられるけれども、なお、あなたのさとしを忘,わすれません。","tok":[["わたし"],["は"],["取る","とる"],["に"],["たらない"],["者","もの"],["で"],["、"],["人","ひと"],["に"],["侮られる","あなどられる"],["けれど"],["も"],["、"],["なお"],["、"],["あなた"],["の"],["さとし"],["を"],["忘ません","わすれません"],["。"]]},{"verse":142,"text":"あなたの義,ぎはとこしえに正,ただしく、あなたのおきてはまことです。","tok":[["あなた"],["の"],["義","ぎ"],["は"],["とこしえ"],["に"],["正く","ただしく"],["、"],["あなた"],["の"],["おきて"],["は"],["まこと"],["です"],["。"]]},{"verse":143,"text":"悩,なやみと苦
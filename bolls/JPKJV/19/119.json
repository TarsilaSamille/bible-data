[{"verse":1,"text":"アレフおのが道,みちを全,まったくして、主,しゅのおきてに歩,あゆむ者,ものはさいわいです。","tok":[["アレフ"],["おの"],["が"],["道","みち"],["を"],["全く","まったく"],["して"],["、"],["主","しゅ"],["の"],["おきて"],["に"],["歩む","あゆむ"],["者","もの"],["は"],["さいわい"],["です"],["。"]]},{"verse":2,"text":"主,しゅのもろもろのあかしを守,まもり心,こころをつくして主,しゅを尋,たずね求,もとめ、","tok":[["主","しゅ"],["の"],["もろもろ"],["の"],["あかし"],["を"],["守り","まもり"],["心","こころ"],["を"],["つくして"],["主","しゅ"],["を"],["尋ね求め","たずねもとめ"],["、"]]},{"verse":3,"text":"また悪,あくを行,おこなわず、主,しゅの道,みちに歩,あゆむ者,ものはさいわいです。","tok":[["また"],["悪","あく"],["を"],["行なわず","おこなわず"],["、"],["主","しゅ"],["の"],["道","みち"],["に"],["歩む","あゆむ"],["者","もの"],["は"],["さいわい"],["です"],["。"]]},{"verse":4,"text":"あなたはさとしを命,めいじて、ねんごろに守,まもらせられます。","tok":[["あなた"],["は"],["さとし"],["を"],["命じて","めいじて"],["、"],["ねんごろ"],["に"],["守らせられます","まもらせられます"],["。"]]},{"verse":5,"text":"どうかわたしの道,みちを堅,かたくして、あなたの定,さだめを守,まもらせてください。","tok":[["どう"],["か"],["わたし"],["の"],["道","みち"],["を"],["堅く","かたく"],["して"],["、"],["あなた"],["の"],["定め","さだめ"],["を"],["守らせて","まもらせて"],["ください"],["。"]]},{"verse":6,"text":"わたしは、あなたのもろもろの戒,いましめに目,めをとめる時,とき、恥,はじることはありません。","tok":[["わたし"],["は"],["、"],["あなた"],["の"],["もろもろ"],["の"],["戒しめ","いましめ"],["に"],["目","め"],["を"],["とめる"],["時","とき"],["、"],["恥","はじ"],["る"],["こと"],["は"],["ありません"],["。"]]},{"verse":7,"text":"わたしは、あなたの正,ただしいおきてを学,まなぶとき、正,ただしい心,こころをもってあなたに感謝,かんしゃします。","tok":[["わたし"],["は"],["、"],["あなた"],["の"],["正い","ただしい"],["おきて"],["を"],["学ぶ","まなぶ"],["とき"],["、"],["正い","ただしい"],["心","こころ"],["を"],["もって"],["あなた"],["に"],["感謝","かんしゃ"],["します"],["。"]]},{"verse":8,"text":"わたしはあなたの定,さだめを守,まもります。わたしを全,まったくお捨,すてにならないでください。","tok":[["わたし"],["は"],["あなた"],["の"],["定め","さだめ"],["を"],["守ります","まもります"],["。"],["わたし"],["を"],["全く","まったく"],["お捨て","おすて"],["に"],["ならないで"],["ください"],["。"]]},{"verse":9,"text":"ベス若,わかい人,ひとはどうしておのが道,みちを清,きよく保,たもつことができるでしょうか。み言葉,ことばにしたがって、それを守,まもるよりほかにありません。","tok":[["ベス"],["若い","わかい"],["人","ひと"],["は"],["どう"],["して"],["お"],["の"],["が"],["道","みち"],["を"],["清く","きよく"],["保つ","たもつ"],["こと"],["が"],["できるでしょう"],["か"],["。"],["み言葉","みことば"],["に"],["したがって"],["、"],["それ"],["を"],["守","まもる"],["より"],["ほか"],["に"],["ありません"],["。"]]},{"verse":10,"text":"わたしは心,こころをつくしてあなたを尋,たずね求,もとめます。わたしをあなたの戒,いましめから迷,まよい出,ださせないでください。","tok":[["わたし"],["は"],["心","こころ"],["を"],["つくして"],["あなた"],["を"],["尋ね求めます","たずねもとめます"],["。"],["わたし"],["を"],["あなた"],["の"],["戒しめ","いましめ"],["から"],["迷い出させないで","まよいださせないで"],["ください"],["。"]]},{"verse":11,"text":"わたしはあなたにむかって罪,つみを犯,おかすことのないように、心,こころのうちにみ言葉,ことばをたくわえました。","tok":[["わたし"],["は"],["あなた"],["に"],["むかって"],["罪","つみ"],["を"],["犯す","おかす"],["こと"],["の"],["ない"],["よう"],["に"],["、"],["心","こころ"],["の"],["うち"],["に"],["み言葉","みことば"],["を"],["たくわえました"],["。"]]},{"verse":12,"text":"あなたはほむべきかな、主,しゅよ、あなたの定,さだめをわたしに教,おしえてください。","tok":[["あなた"],["は"],["ほ"],["むべき"],["か"],["な"],["、"],["主","しゅ"],["よ"],["、"],["あなた"],["の"],["定め","さだめ"],["を"],["わたし"],["に"],["教えて","おしえて"],["ください"],["。"]]},{"verse":13,"text":"わたしはくちびるをもって、あなたの口,くちから出,でるもろもろのおきてを言,いいあらわします。","tok":[["わたし"],["は"],["くちびる"],["を"],["もって"],["、"],["あなた"],["の"],["口","くち"],["から"],["出る","でる"],["もろもろ"],["の"],["おきて"],["を"],["言いあらわします","いいあらわします"],["。"]]},{"verse":14,"text":"わたしは、もろもろのたからを喜,よろこぶように、あなたのあかしの道,みちを喜,よろこびます。","tok":[["わたし"],["は"],["、"],["もろもろ"],["の"],["たから"],["を"],["喜こぶ","よろこぶ"],["よう"],["に"],["、"],["あなた"],["の"],["あかし"],["の"],["道","みち"],["を"],["喜こびます","よろこびます"],["。"]]},{"verse":15,"text":"わたしは、あなたのさとしを思,おもい、あなたの道,みちに目,めをとめます。","tok":[["わたし"],["は"],["、"],["あなた"],["の"],["さとし"],["を"],["思い","おもい"],["、"],["あなた"],["の"],["道","みち"],["に"],["目","め"],["を"],["とめます"],["。"]]},{"verse":16,"text":"わたしはあなたの定,さだめを喜,よろこび、あなたのみ言葉,ことばを忘,わすれません。","tok":[["わたし"],["は"],["あなた"],["の"],["定め","さだめ"],["を"],["喜こび","よろこび"],["、"],["あなた"],["のみ"],["言葉","ことば"],["を"],["忘ません","わすれません"],["。"]]},{"verse":17,"text":"ギメルあなたのしもべを豊,ゆたかにあしらって、生,いきながらえさせ、み言葉,ことばを守,まもらせてください。","tok":[["ギメル"],["あなた"],["の"],["しもべ"],["を"],["豊","ゆたか"],["に"],["あしらって"],["、"],["生きながらえさせ","いきながらえさせ"],["、"],["み言葉","みことば"],["を"],["守らせて","まもらせて"],["ください"],["。"]]},{"verse":18,"text":"わたしの目,めを開,ひらいて、あなたのおきてのうちのくすしき事,ことを見,みさせてください。","tok":[["わたし"],["の"],["目","め"],["を"],["開らいて","ひらいて"],["、"],["あなた"],["の"],["おきて"],["の"],["うち"],["の"],["くす"],["しき"],["事","こと"],["を"],["見させて","みさせて"],["ください"],["。"]]},{"verse":19,"text":"わたしはこの地,ちにあっては寄留者,きりゅうしゃです。あなたの戒,いましめをわたしに隠,かくさないでください。","tok":[["わたし"],["は"],["この"],["地","ち"],["に"],["あって"],["は"],["寄留者","きりゅうしゃ"],["です"],["。"],["あなた"],["の"],["戒しめ","いましめ"],["を"],["わたし"],["に"],["隠さないで","かくさないで"],["ください"],["。"]]},{"verse":20,"text":"わが魂,たましいはつねにあなたのおきてを慕,したって、絶,たえいるばかりです。","tok":[["わが"],["魂","たましい"],["は"],["つね"],["に"],["あなた"],["の"],["おきて"],["を"],["慕って","したって"],["、"],["絶え","たえ"],["いる"],["ばかり"],["です"],["。"]]},{"verse":21,"text":"あなたは、あなたの戒,いましめから迷,まよい出,でる高,たかぶる者,もの、のろわれた者,ものを責,せめられます。","tok":[["あなた"],["は"],["、"],["あなた"],["の"],["戒しめ","いましめ"],["から"],["迷い出る","まよいでる"],["高か","たか"],["ぶる"],["者","もの"],["、"],["のろわれた"],["者","もの"],["を"],["責","せめ"],["られます"],["。"]]},{"verse":22,"text":"わたしはあなたのあかしを守,まもりました。彼,かれらのそしりと侮,あなどりとをわたしから取,とり去,さってください。","tok":[["わたし"],["は"],["あなた"],["の"],["あかし"],["を"],["守りました","まもりました"],["。"],["彼","かれ"],["ら"],["の"],["そしり"],["と"],["侮","あなどり"],["と"],["を"],["わたし"],["から"],["取","とり"],["去て","さって"],["ください"],["。"]]},{"verse":23,"text":"たといもろもろの君,きみが座,ざして、わたしをそこなおうと図,はかっても、あなたのしもべは、あなたの定,さだめを深,ふかく思,おもいます。","tok":[["たとい"],["もろもろ"],["の"],["君","きみ"],["が"],["座して","ざして"],["、"],["わたし"],["を"],["そこなおう"],["と"],["図って","はかって"],["も"],["、"],["あなた"],["の"],["しもべ"],["は"],["、"],["あなた"],["の"],["定め","さだめ"],["を"],["深く","ふかく"],["思います","おもいます"],["。"]]},{"verse":24,"text":"あなたのあかしは、わたしを喜,よろこばせ、わたしを教,おしえさとすものです。","tok":[["あなた"],["の"],["あかし"],["は"],["、"],["わたし"],["を"],["喜こばせ","よろこばせ"],["、"],["わたし"],["を"],["教えさとす","おしえさとす"],["もの"],["です"],["。"]]},{"verse":25,"text":"ダレスわが魂,たましいはちりについています。み言葉,ことばに従,したがって、わたしを生,いき返,かえらせてください。","tok":[["ダレス"],["わが"],["魂","たましい"],["は"],["ちり"],["について"],["います"],["。"],["み言葉","みことば"],["に"],["従って","したがって"],["、"],["わたし"],["を"],["生き返らせて","いきかえらせて"],["ください"],["。"]]},{"verse":26,"text":"わたしが自分,じぶんの歩,あゆんだ道,みちを語,かたったとき、あなたはわたしに答,こたえられました。あなたの定,さだめをわたしに教,おしえてください。","tok":[["わたし"],["が"],["自分","じぶん"],["の"],["歩んだ","あゆんだ"],["道","みち"],["を"],["語った","かたった"],["とき"],["、"],["あなた"],["は"],["わたし"],["に"],["答","こたえ"],["られました"],["。"],["あなた"],["の"],["定め","さだめ"],["を"],["わたし"],["に"],["教えて","おしえて"],["ください"],["。"]]},{"verse":27,"text":"あなたのさとしの道,みちをわたしにわきまえさせてください。わたしはあなたのくすしきみわざを深,ふかく思,おもいます。","tok":[["あなた"],["の"],["さとし"],["の"],["道","みち"],["を"],["わたし"],["に"],["わきまえさせて"],["ください"],["。"],["わたし"],["は"],["あなた"],["の"],["くす"],["しきみ"],["わざ"],["を"],["深く","ふかく"],["思います","おもいます"],["。"]]},{"verse":28,"text":"わが魂,たましいは悲,かなしみによって溶,とけ去,さります。み言葉,ことばに従,したがって、わたしを強,つよくしてください。","tok":[["わが"],["魂","たましい"],["は"],["悲しみ","かなしみ"],["によって"],["溶け去ります","とけさります"],["。"],["み言葉","みことば"],["に"],["従って","したがって"],["、"],["わたし"],["を"],["強く","つよく"],["して"],["ください"],["。"]]},{"verse":29,"text":"偽,いつわりの道,みちをわたしから遠,とおざけ、あなたのおきてをねんごろに教,おしえてください。","tok":[["偽わり","いつわり"],["の"],["道","みち"],["を"],["わたし"],["から"],["遠ざけ","とおざけ"],["、"],["あなた"],["の"],["おきて"],["を"],["ねんごろ"],["に"],["教えて","おしえて"],["ください"],["。"]]},{"verse":30,"text":"わたしは真実,しんじつの道,みちを選,えらび、あなたのおきてをわたしの前,まえに置,おきました。","tok":[["わたし"],["は"],["真実","しんじつ"],["の"],["道","みち"],["を"],["選ら","えら"],["び"],["、"],["あなた"],["の"],["おきて"],["を"],["わたし"],["の"],["前","まえ"],["に"],["置きました","おきました"],["。"]]},{"verse":31,"text":"主,しゅよ、わたしはあなたのあかしに堅,かたく従,したがっています。願,ねがわくは、わたしをはずかしめないでください。","tok":[["主","しゅ"],["よ"],["、"],["わたし"],["は"],["あなた"],["の"],["あかし"],["に"],["堅く","かたく"],["従って","したがって"],["います"],["。"],["願わく","ねがわく"],["は"],["、"],["わたし"],["を"],["はずかしめないで"],["ください"],["。"]]},{"verse":32,"text":"あなたがわたしの心,こころを広,ひろくされるとき、わたしはあなたの戒,いましめの道,みちを走,はしります。","tok":[["あなた"],["が"],["わたし"],["の"],["心","こころ"],["を"],["広く","ひろく"],["される"],["とき"],["、"],["わたし"],["は"],["あなた"],["の"],["戒しめ","いましめ"],["の"],["道","みち"],["を"],["走ります","はしります"],["。"]]},{"verse":33,"text":"ヘ主,しゅよ、あなたの定,さだめの道,みちをわたしに教,おしえてください。わたしは終,おわりまでこれを守,まもります。","tok":[["ヘ"],["主","しゅ"],["よ"],["、"],["あなた"],["の"],["定め","さだめ"],["の"],["道","みち"],["を"],["わたし"],["に"],["教えて","おしえて"],["ください"],["。"],["わたし"],["は"],["終","おわり"],["まで"],["これ"],["を"],["守ります","まもります"],["。"]]},{"verse":34,"text":"わたしに知恵,ちえを与,あたえてください。わたしはあなたのおきてを守,まもり、心,こころをつくしてこれに従,したがいます。","tok":[["わたし"],["に"],["知恵","ちえ"],["を"],["与","あたえ"],["て"],["ください"],["。"],["わたし"],["は"],["あなた"],["の"],["おきて"],["を"],["守り","まもり"],["、"],["心","こころ"],["を"],["つくして"],["これ"],["に"],["従います","したがいます"],["。"]]},{"verse":35,"text":"わたしをあなたの戒,いましめの道,みちに導,みちびいてください。わたしはそれを喜,よろこぶからです。","tok":[["わたし"],["を"],["あなた"],["の"],["戒しめ","いましめ"],["の"],["道","みち"],["に"],["導いて","みちびいて"],["ください"],["。"],["わたし"],["は"],["それ"],["を"],["喜こぶ","よろこぶ"],["から"],["です"],["。"]]},{"verse":36,"text":"わたしの心,こころをあなたのあかしに傾,かたむけさせ、不正,ふせいな利得,りとくに傾,かたむけさせないでください。","tok":[["わたし"],["の"],["心","こころ"],["を"],["あなた"],["の"],["あかし"],["に"],["傾むけさせ","かたむけさせ"],["、"],["不正","ふせい"],["な"],["利得","りとく"],["に"],["傾むけさせないで","かたむけさせないで"],["ください"],["。"]]},{"verse":37,"text":"わたしの目,めをほかにむけて、むなしいものを見,みさせず、あなたの道,みちをもって、わたしを生,いかしてください。","tok":[["わたし"],["の"],["目","め"],["を"],["ほか"],["に"],["むけて"],["、"],["むなしい"],["もの"],["を"],["見させず","みさせず"],["、"],["あなた"],["の"],["道","みち"],["を"],["もって"],["、"],["わたし"],["を"],["生かして","いかして"],["ください"],["。"]]},{"verse":38,"text":"あなたを恐,おそれる者,ものにかかわる約束,やくそくをあなたのしもべに堅,かたくしてください。","tok":[["あなた"],["を"],["恐れる","おそれる"],["者","もの"],["に"],["かかわる"],["約束","やくそく"],["を"],["あなた"],["の"],["しもべ"],["に"],["堅く","かたく"],["して"],["ください"],["。"]]},{"verse":39,"text":"わたしの恐,おそれるそしりを除,のぞいてください。あなたのおきては正,ただしいからです。","tok":[["わたし"],["の"],["恐れる","おそれる"],["そ"],["しり"],["を"],["除いて","のぞいて"],["ください"],["。"],["あなた"],["の"],["おきて"],["は"],["正い","ただしい"],["から"],["です"],["。"]]},{"verse":40,"text":"見,みよ、わたしはあなたのさとしを慕,したいます。あなたの義,ぎをもって、わたしを生,いかしてください。","tok":[["見よ","みよ"],["、"],["わたし"],["は"],["あなた"],["の"],["さとし"],["を"],["慕います","したいます"],["。"],["あなた"],["の"],["義","ぎ"],["を"],["もって"],["、"],["わたし"],["を"],["生かして","いかして"],["ください"],["。"]]},{"verse":41,"text":"ワウ主,しゅよ、あなたの約束,やくそくにしたがって、あなたのいつくしみと、あなたの救,すくいをわたしに臨,のぞませてください。","tok":[["ワウ"],["主","しゅ"],["よ"],["、"],["あなた"],["の"],["約束","やくそく"],["に"],["したがって"],["、"],["あなた"],["の"],["いつくしみ"],["と"],["、"],["あなた"],["の"],["救い","すくい"],["を"],["わたし"],["に"],["臨ませて","のぞませて"],["ください"],["。"]]},{"verse":42,"text":"そうすれば、わたしをそしる者,ものに、答,こたえることができます。わたしはあなたのみ言葉,ことばに信頼,しんらいするからです。","tok":[["そう"],["すれば"],["、"],["わたし"],["を"],["そしる"],["者","もの"],["に"],["、"],["答","こたえ"],["る"],["こと"],["が"],["できます"],["。"],["わたし"],["は"],["あなた"],["のみ"],["言葉","ことば"],["に"],["信頼","しんらい"],["する"],["から"],["です"],["。"]]},{"verse":43,"text":"またわたしの口,くちから真理,しんりの言葉,ことばをことごとく除,のぞかないでください。わたしの望,のぞみはあなたのおきてにあるからです。","tok":[["また"],["わたし"],["の"],["口","くち"],["から"],["真理","しんり"],["の"],["言葉","ことば"],["を"],["ことごとく"],["除かないで","のぞかないで"],["ください"],["。"],["わたし"],["の"],["望み","のぞみ"],["は"],["あなた"],["の"],["おきて"],["に"],["ある"],["から"],["です"],["。"]]},{"verse":44,"text":"わたしは絶,たえず、とこしえに、あなたのおきてを守,まもります。","tok":[["わたし"],["は"],["絶えず","たえず"],["、"],["とこしえ"],["に"],["、"],["あなた"],["の"],["おきて"],["を"],["守ります","まもります"],["。"]]},{"verse":45,"text":"わたしはあなたのさとしを求,もとめたので、自由,じゆうに歩,あゆむことができます。","tok":[["わたし"],["は"],["あなた"],["の"],["さとし"],["を"],["求めた","もとめた"],["ので"],["、"],["自由","じゆう"],["に"],["歩む","あゆむ"],["こと"],["が"],["できます"],["。"]]},{"verse":46,"text":"わたしはまた王,おうたちの前,まえにあなたのあかしを語,かたって恥,はじることはありません。","tok":[["わたし"],["は"],["また"],["王","おう"],["たち"],["の"],["前","まえ"],["に"],["あなた"],["の"],["あかし"],["を"],["語って","かたって"],["恥","はじ"],["る"],["こと"],["は"],["ありません"],["。"]]},{"verse":47,"text":"わたしは、わたしの愛,あいするあなたの戒,いましめに自分,じぶんの喜,よろこびを見,みいだすからです。","tok":[["わたし"],["は"],["、"],["わたし"],["の"],["愛する","あいする"],["あなた"],["の"],["戒しめ","いましめ"],["に"],["自分","じぶん"],["の"],["喜こび","よろこび"],["を"],["見いだす","みいだす"],["から"],["です"],["。"]]},{"verse":48,"text":"わたしは、わたしの愛,あいするあなたの戒,いましめを尊,たっとび、あなたの定,さだめを深,ふかく思,おもいます。","tok":[["わたし"],["は"],["、"],["わたし"],["の"],["愛する","あいする"],["あなた"],["の"],["戒しめ","いましめ"],["を"],["尊","た"],["っと"],["び"],["、"],["あなた"],["の"],["定め","さだめ"],["を"],["深く","ふかく"],["思います","おもいます"],["。"]]},{"verse":49,"text":"ザインどうか、あなたのしもべに言,いわれたみ言葉,ことばを思,おもい出,だしてください。あなたはわたしにそれを望,のぞませられました。","tok":[["ザイン"],["どう"],["か"],["、"],["あなた"],["の"],["しもべ"],["に"],["言われた","いわれた"],["み言葉","みことば"],["を"],["思い出して","おもいだして"],["ください"],["。"],["あなた"],["は"],["わたし"],["に"],["それ"],["を"],["望ませられました","のぞませられました"],["。"]]},{"verse":50,"text":"あなたの約束,やくそくはわたしを生,いかすので、わが悩,なやみの時,ときの慰,なぐさめです。","tok":[["あなた"],["の"],["約束","やくそく"],["は"],["わたし"],["を"],["生かす","いかす"],["ので"],["、"],["わが"],["悩み","なやみ"],["の"],["時","とき"],["の"],["慰さめです","なぐさめです"],["。"]]},{"verse":51,"text":"高,たかぶる者,ものは大,おおいにわたしをあざ笑,あざわらいます。しかしわたしはあなたのおきてを離,はなれません。","tok":[["高か","たか"],["ぶる"],["者","もの"],["は"],["大いに","おおいに"],["わたし"],["を"],["あざ"],["笑","あ"],["ざ"],["わらいます"],["。"],["しかし"],["わたし"],["は"],["あなた"],["の"],["おきて"],["を"],["離れません","はなれません"],["。"]]},{"verse":52,"text":"主,しゅよ、わたしはあなたの昔,むかしからのおきてを思,おもい出,だして、みずから慰,なぐさめます。","tok":[["主","しゅ"],["よ"],["、"],["わたし"],["は"],["あなた"],["の"],["昔","むかし"],["から"],["の"],["おきて"],["を"],["思い出して","おもいだして"],["、"],["みずから"],["慰さめます","なぐさめます"],["。"]]},{"verse":53,"text":"あなたのおきてを捨,すてる悪,あしき者,もののゆえに、わたしは激,はげしい憤,いきどおりを起,おこします。","tok":[["あなた"],["の"],["おきて"],["を"],["捨てる","すてる"],["悪しき","あしき"],["者","もの"],["の"],["ゆえ"],["に"],["、"],["わたし"],["は"],["激しい","はげしい"],["憤り","いきどおり"],["を"],["起こします","おこします"],["。"]]},{"verse":54,"text":"あなたの定,さだめはわが旅,たびの家,いえで、わたしの歌,うたとなりました。","tok":[["あなた"],["の"],["定め","さだめ"],["は"],["わが"],["旅","たび"],["の"],["家","いえ"],["で"],["、"],["わたし"],["の"],["歌","うた"],["と"],["なりました"],["。"]]},{"verse":55,"text":"主,しゅよ、わたしは夜,よの間,まにあなたのみ名,なを思,おもい出,だして、あなたのおきてを守,まもります。","tok":[["主","しゅ"],["よ"],["、"],["わたし"],["は"],["夜","よ"],["の"],["間","ま"],["に"],["あなた"],["のみ"],["名","な"],["を"],["思い出して","おもいだして"],["、"],["あなた"],["の"],["おきて"],["を"],["守ります","まもります"],["。"]]},{"verse":56,"text":"わたしはあなたのさとしを守,まもったことによって、この祝福,しゅくふくがわたしに臨,のぞみました。","tok":[["わたし"],["は"],["あなた"],["の"],["さとし"],["を"],["守った","まもった"],["こと"],["によって"],["、"],["この"],["祝福","しゅくふく"],["が"],["わたし"],["に"],["臨みました","のぞみました"],["。"]]},{"verse":57,"text":"ヘス主,しゅはわたしの受,うくべき分,ぶんです。わたしはあなたのみ言葉,ことばを守,まもることを約束,やくそくします。","tok":[["ヘス"],["主","しゅ"],["は"],["わたし"],["の"],["受","う"],["くべき"],["分","ぶん"],["です"],["。"],["わたし"],["は"],["あなた"],["のみ"],["言葉","ことば"],["を"],["守","まもる"],["こと"],["を"],["約束","やくそく"],["します"],["。"]]},{"verse":58,"text":"わたしは心,こころをつくして、あなたの恵,めぐみを請,こい求,もとめます。あなたの約束,やくそくにしたがって、わたしをお恵,めぐみください。","tok":[["わたし"],["は"],["心","こころ"],["を"],["つくして"],["、"],["あなた"],["の"],["恵","めぐみ"],["を"],["請い求めます","こいもとめます"],["。"],["あなた"],["の"],["約束","やくそく"],["に"],["したがって"],["、"],["わたし"],["を"],["お恵み","おめぐみ"],["ください"],["。"]]},{"verse":59,"text":"わたしは、あなたの道,みちを思,おもうとき、足,あしをかえして、あなたのあかしに向,むかいます。","tok":[["わたし"],["は"],["、"],["あなた"],["の"],["道","みち"],["を"],["思う","おもう"],["とき"],["、"],["足","あし"],["を"],["かえして"],["、"],["あなた"],["の"],["あかし"],["に"],["向かいます","むかいます"],["。"]]},{"verse":60,"text":"わたしはあなたの戒,いましめを守,まもるのに、すみやかで、ためらいません。","tok":[["わたし"],["は"],["あなた"],["の"],["戒しめ","いましめ"],["を"],["守","まもる"],["のに"],["、"],["すみやか"],["で"],["、"],["ためらいません"],["。"]]},{"verse":61,"text":"たとい、悪,あしき者,もののなわがわたしを捕,とらえても、わたしはあなたのおきてを忘,わすれません。","tok":[["たとい"],["、"],["悪しき","あしき"],["者","もの"],["の"],["なわ"],["が"],["わたし"],["を"],["捕らえて","とらえて"],["も"],["、"],["わたし"],["は"],["あなた"],["の"],["おきて"],["を"],["忘ません","わすれません"],["。"]]},{"verse":62,"text":"わたしはあなたの正,ただしいおきてのゆえに夜半,やはんに起,おきて、あなたに感謝,かんしゃします。","tok":[["わたし"],["は"],["あなた"],["の"],["正い","ただしい"],["おきて"],["の"],["ゆえ"],["に"],["夜半","やはん"],["に"],["起きて","おきて"],["、"],["あなた"],["に"],["感謝","かんしゃ"],["します"],["。"]]},{"verse":63,"text":"わたしは、すべてあなたを恐,おそれる者,もの、またあなたのさとしを守,まもる者,ものの仲間,なかまです。","tok":[["わたし"],["は"],["、"],["すべて"],["あなた"],["を"],["恐れる","おそれる"],["者","もの"],["、"],["また"],["あなた"],["の"],["さとし"],["を"],["守者","まもるもの"],["の"],["仲間","なかま"],["です"],["。"]]},{"verse":64,"text":"主,しゅよ、地,ちはあなたのいつくしみで満,みちています。あなたの定,さだめをわたしに教,おしえてください。","tok":[["主","しゅ"],["よ"],["、"],["地","ち"],["は"],["あなた"],["の"],["いつくしみで"],["満ちて","みちて"],["います"],["。"],["あなた"],["の"],["定め","さだめ"],["を"],["わたし"],["に"],["教えて","おしえて"],["ください"],["。"]]},{"verse":65,"text":"テス主,しゅよ、あなたはみ言葉,ことばにしたがってしもべをよくあしらわれました。","tok":[["テス"],["主","しゅ"],["よ"],["、"],["あなた"],["は"],["み言葉","みことば"],["に"],["したがって"],["しもべ"],["を"],["よく"],["あしらわれました"],["。"]]},{"verse":66,"text":"わたしに良,よい判断,はんだんと知識,ちしきとを教,おしえてください。わたしはあなたの戒,いましめを信,しんじるからです。","tok":[["わたし"],["に"],["良い","よい"],["判断","はんだん"],["と"],["知識","ちしき"],["と"],["を"],["教えて","おしえて"],["ください"],["。"],["わたし"],["は"],["あなた"],["の"],["戒しめ","いましめ"],["を"],["信じる","しんじる"],["から"],["です"],["。"]]},{"verse":67,"text":"わたしは苦,くるしまない前,まえには迷,まよいました。しかし今,いまはみ言葉,ことばを守,まもります。","tok":[["わたし"],["は"],["苦しまない","くるしまない"],["前","まえ"],["に"],["は"],["迷いました","まよいました"],["。"],["しかし"],["今","いま"],["は"],["み言葉","みことば"],["を"],["守ります","まもります"],["。"]]},{"verse":68,"text":"あなたは善,ぜんにして善,ぜんを行,おこなわれます。あなたの定,さだめをわたしに教,おしえてください。","tok":[["あなた"],["は"],["善","ぜん"],["に"],["して"],["善","ぜん"],["を"],["行なわれます","おこなわれます"],["。"],["あなた"],["の"],["定め","さだめ"],["を"],["わたし"],["に"],["教えて","おしえて"],["ください"],["。"]]},{"verse":69,"text":"高,たかぶる者,ものは偽,いつわりをもってわたしをことごとくおおいます。しかしわたしは心,こころをつくしてあなたのさとしを守,まもります。","tok":[["高か","たか"],["ぶる"],["者","もの"],["は"],["偽り","いつわり"],["を"],["もって"],["わたし"],["を"],["ことごとく"],["おおいます"],["。"],["しかし"],["わたし"],["は"],["心","こころ"],["を"],["つくして"],["あなた"],["の"],["さとし"],["を"],["守ります","まもります"],["。"]]},{"verse":70,"text":"彼,かれらの心,こころは肥,こえ太,ふとって脂肪,しぼうのようです。しかしわたしはあなたのおきてを喜,よろこびます。","tok":[["彼","かれ"],["ら"],["の"],["心","こころ"],["は"],["肥","こえ"],["太って","ふとって"],["脂肪","しぼう"],["の"],["よう"],["です"],["。"],["しかし"],["わたし"],["は"],["あなた"],["の"],["おきて"],["を"],["喜こびます","よろこびます"],["。"]]},{"verse":71,"text":"苦,くるしみにあったことは、わたしに良,よい事,ことです。これによってわたしはあなたのおきてを学,まなぶことができました。","tok":[["苦しみ","くるしみ"],["に"],["あった"],["こと"],["は"],["、"],["わたし"],["に"],["良い","よい"],["事","こと"],["です"],["。"],["これ"],["によって"],["わたし"],["は"],["あなた"],["の"],["おきて"],["を"],["学ぶ","まなぶ"],["こと"],["が"],["できました"],["。"]]},{"verse":72,"text":"あなたの口,くちのおきては、わたしのためには幾,いく千の金銀,きんぎん貨幣,かへいにもまさるのです。","tok":[["あなた"],["の"],["口","くち"],["の"],["おきて"],["は"],["、"],["わたし"],["の"],["ため"],["に"],["は"],["幾","いく"],["千","せん"],["の"],["金銀","きんぎん"],["貨幣","かへい"],["に"],["も"],["まさる"],["の"],["です"],["。"]]},{"verse":73,"text":"ヨードあなたのみ手,てはわたしを造,つくり、わたしを形,かたち造,つくりました。わたしに知恵,ちえを与,あたえて、あなたの戒,いましめを学,まなばせてください。","tok":[["ヨード"],["あなた"],["のみ"],["手","て"],["は"],["わたし"],["を"],["造","つくり"],["、"],["わたし"],["を"],["形造","かたちつくり"],["ました"],["。"],["わたし"],["に"],["知恵","ちえ"],["を"],["与","あたえ"],["て"],["、"],["あなた"],["の"],["戒しめ","いましめ"],["を"],["学ばせて","まなばせて"],["ください"],["。"]]},{"verse":74,"text":"あなたを恐,おそれる者,ものはわたしを見,みて喜,よろこぶでしょう。わたしはみ言葉,ことばによって望,のぞみをいだいたからです。","tok":[["あなた"],["を"],["恐れる","おそれる"],["者","もの"],["は"],["わたし"],["を"],["見て","みて"],["喜こぶでしょう","よろこぶでしょう"],["。"],["わたし"],["は"],["み言葉","みことば"],["によって"],["望み","のぞみ"],["を"],["いだいた"],["から"],["です"],["。"]]},{"verse":75,"text":"主,しゅよ、わたしはあなたのさばきの正,ただしく、また、あなたが真実,しんじつをもってわたしを苦,くるしめられたことを知,しっています。","tok":[["主","しゅ"],["よ"],["、"],["わたし"],["は"],["あなた"],["の"],["さばき"],["の"],["正く","ただしく"],["、"],["また"],["、"],["あなた"],["が"],["真実","しんじつ"],["を"],["もって"],["わたし"],["を"],["苦しめられた","くるしめられた"],["こと"],["を"],["知って","しって"],["います"],["。"]]},{"verse":76,"text":"あなたがしもべに告,つげられた約束,やくそくにしたがって、あなたのいつくしみをわが慰,なぐさめとしてください。","tok":[["あなた"],["が"],["しもべ"],["に"],["告げられた","つげられた"],["約束","やくそく"],["に"],["したがって"],["、"],["あなた"],["の"],["いつくしみ"],["を"],["わが"],["慰さめ","なぐさめ"],["として"],["ください"],["。"]]},{"verse":77,"text":"あなたのあわれみをわたしに臨,のぞませ、わたしを生,いかしてください。あなたのおきてはわが喜,よろこびだからです。","tok":[["あなた"],["の"],["あわれみ"],["を"],["わたし"],["に"],["臨ませ","のぞませ"],["、"],["わたし"],["を"],["生かして","いかして"],["ください"],["。"],["あなた"],["の"],["おきて"],["は"],["わが"],["喜こびだ","よろこびだ"],["から"],["です"],["。"]]},{"verse":78,"text":"高,たかぶる者,ものに恥,はじをこうむらせてください。彼,かれらは偽,いつわりをもって、わたしをくつがえしたからです。しかしわたしはあなたのさとしを深,ふかく思,おもいます。","tok":[["高か","たか"],["ぶる"],["者","もの"],["に"],["恥","はじ"],["を"],["こうむらせて"],["ください"],["。"],["彼","かれ"],["ら"],["は"],["偽り","いつわり"],["を"],["もって"],["、"],["わたし"],["を"],["くつがえした"],["から"],["です"],["。"],["しかし"],["わたし"],["は"],["あなた"],["の"],["さとし"],["を"],["深く","ふかく"],["思います","おもいます"],["。"]]},{"verse":79,"text":"あなたをおそれる者,ものと、あなたのあかしを知,しる者,ものとをわたしに帰,かえらせてください。","tok":[["あなた"],["を"],["おそれる"],["者","もの"],["と"],["、"],["あなた"],["の"],["あかし"],["を"],["知る","しる"],["者","もの"],["と"],["を"],["わたし"],["に"],["帰えらせて","かえらせて"],["ください"],["。"]]},{"verse":80,"text":"わたしの心,こころを全,まったくして、あなたの定,さだめを守,まもらせてください。そうすればわたしは恥,はじをこうむることがありません。","tok":[["わたし"],["の"],["心","こころ"],["を"],["全く","まったく"],["して"],["、"],["あなた"],["の"],["定め","さだめ"],["を"],["守らせて","まもらせて"],["ください"],["。"],["そう"],["すれば"],["わたし"],["は"],["恥","はじ"],["を"],["こうむる"],["こと"],["が"],["ありません"],["。"]]},{"verse":81,"text":"カフわが魂,たましいはあなたの救,すくいを慕,したって絶,たえいるばかりです。わたしはみ言葉,ことばによって望,のぞみをいだきます。","tok":[["カフ"],["わが"],["魂","たましい"],["は"],["あなた"],["の"],["救い","すくい"],["を"],["慕って","したって"],["絶え","たえ"],["いる"],["ばかり"],["です"],["。"],["わたし"],["は"],["み言葉","みことば"],["によって"],["望み","のぞみ"],["を"],["いだきます"],["。"]]},{"verse":82,"text":"わたしの目,めはあなたの約束,やくそくを待,まつによって衰,おとろえ、「いつ、あなたはわたしを慰,なぐさめられるのですか」と尋,たずねます。","tok":[["わたし"],["の"],["目","め"],["は"],["あなた"],["の"],["約束","やくそく"],["を"],["待つ","まつ"],["によって"],["衰え","おとろえ"],["、"],["「"],["いつ"],["、"],["あなた"],["は"],["わたし"],["を"],["慰さめられる","なぐさめられる"],["の"],["です"],["か"],["」"],["と"],["尋ねます","たずねます"],["。"]]},{"verse":83,"text":"わたしは煙,けむりの中,なかの皮,かわ袋,ぶくろのようになりましたが、なお、あなたの定,さだめを忘,わすれませんでした。","tok":[["わたし"],["は"],["煙","けむり"],["の"],["中","なか"],["の"],["皮袋","かわぶくろ"],["の"],["よう"],["に"],["なりました"],["が"],["、"],["なお"],["、"],["あなた"],["の"],["定め","さだめ"],["を"],["忘ませんでした","わすれませんでした"],["。"]]},{"verse":84,"text":"あなたのしもべの日,ひはどれほど続,つづくでしょうか。いつあなたは、わたしを迫害,はくがいする者,ものをさばかれるでしょうか。","tok":[["あなた"],["の"],["しもべ"],["の"],["日","ひ"],["は"],["どれ"],["ほど"],["続くでしょう","つづくでしょう"],["か"],["。"],["いつ"],["あなた"],["は"],["、"],["わたし"],["を"],["迫害","はくがい"],["する"],["者","もの"],["を"],["さばかれるでしょう"],["か"],["。"]]},{"verse":85,"text":"高,たかぶる者,ものはわたしをおとしいれようと穴,あなを掘,ほりました。彼,かれらはあなたのおきてに従,したがわない人々,ひとびとです。","tok":[["高か","たか"],["ぶる"],["者","もの"],["は"],["わたし"],["を"],["おとしいれよう"],["と"],["穴","あな"],["を"],["掘","ほり"],["ました"],["。"],["彼","かれ"],["ら"],["は"],["あなた"],["の"],["おきて"],["に"],["従わない","したがわない"],["人々","ひとびと"],["です"],["。"]]},{"verse":86,"text":"あなたの戒,いましめはみな真実,しんじつです。彼,かれらは偽,いつわりをもってわたしを迫害,はくがいします。わたしをお助,たすけください。","tok":[["あなた"],["の"],["戒しめ","いましめ"],["は"],["みな"],["真実","しんじつ"],["です"],["。"],["彼","かれ"],["ら"],["は"],["偽り","いつわり"],["を"],["もって"],["わたし"],["を"],["迫害","はくがい"],["します"],["。"],["わたし"],["を"],["お助け","おたすけ"],["ください"],["。"]]},{"verse":87,"text":"彼,かれらはこの地,ちにおいて、ほとんどわたしを滅,ほろぼしました。しかし、わたしはあなたのさとしを捨,すてませんでした。","tok":[["彼","かれ"],["ら"],["は"],["この"],["地","ち"]
[{"verse":1,"text":"[0]【聖歌,せいか隊,たいの指揮者,しきしゃによってうたわせたダビデの歌,うた、さんび】","tok":[["["],["0"],["]"],["【"],["聖歌隊","せいかたい"],["の"],["指揮者","しきしゃ"],["によって"],["うたわせた"],["ダビデ"],["の"],["歌","うた"],["、"],["さん"],["び"],["】"]]},{"verse":2,"text":"[1]神,かみよ、シオンにて、あなたをほめたたえることはふさわしいことである。人,ひとはあなたに誓,ちかいを果,はたすであろう。","tok":[["["],["1"],["]"],["神","かみ"],["よ"],["、"],["シオン"],["にて"],["、"],["あなた"],["を"],["ほめたたえる"],["こと"],["は"],["ふさわしい"],["こと"],["で"],["ある"],["。"],["人","ひと"],["は"],["あなた"],["に"],["誓い","ちかい"],["を"],["果たすで","はたすで"],["あろう"],["。"]]},{"verse":3,"text":"[2-3]祈,いのりを聞,きかれる方,かたよ、すべての肉,にくなる者,ものは罪,つみのゆえにあなたに来,くる。われらのとががわれらに打,うち勝,かつとき、あなたはこれをゆるされる。","tok":[["["],["2"],["-"],["3"],["]"],["祈","いのり"],["を"],["聞かれる","きかれる"],["方","かた"],["よ"],["、"],["すべて"],["の"],["肉","にく"],["なる"],["者","もの"],["は"],["罪","つみ"],["の"],["ゆえ"],["に"],["あなた"],["に"],["来る","くる"],["。"],["われ"],["ら"],["の"],["とが"],["が"],["われ"],["ら"],["に"],["打ち勝つ","うちかつ"],["とき"],["、"],["あなた"],["は"],["これ"],["を"],["ゆるされる"],["。"]]},{"verse":4,"text":"*[2-3]祈,いのりを聞,きかれる方,かたよ、すべての肉,にくなる者,ものは罪,つみのゆえにあなたに来,くる。われらのとががわれらに打,うち勝,かつとき、あなたはこれをゆるされる。","tok":[["*"],["["],["2"],["-"],["3"],["]"],["祈","いのり"],["を"],["聞かれる","きかれる"],["方","かた"],["よ"],["、"],["すべて"],["の"],["肉","にく"],["なる"],["者","もの"],["は"],["罪","つみ"],["の"],["ゆえ"],["に"],["あなた"],["に"],["来る","くる"],["。"],["われ"],["ら"],["の"],["とが"],["が"],["われ"],["ら"],["に"],["打ち勝つ","うちかつ"],["とき"],["、"],["あなた"],["は"],["これ"],["を"],["ゆるされる"],["。"]]},{"verse":5,"text":"[4]あなたに選,えらばれ、あなたに近,ちかづけられて、あなたの大庭,おおにわに住,すむ人,ひとはさいわいである。われらはあなたの家,いえ、あなたの聖,せいなる宮,みやの恵,めぐみによって飽,あくことができる。","tok":[["["],["4"],["]"],["あなた"],["に"],["選ら","えら"],["ばれ"],["、"],["あなた"],["に"],["近づけられて","ちかづけられて"],["、"],["あなた"],["の"],["大庭","おおにわ"],["に"],["住む","すむ"],["人","ひと"],["は"],["さいわい"],["で"],["ある"],["。"],["われ"],["ら"],["は"],["あなた"],["の"],["家","いえ"],["、"],["あなた"],["の"],["聖","せい"],["なる"],["宮","みや"],["の"],["恵","めぐみ"],["によって"],["飽く","あく"],["こと"],["が"],["できる"],["。"]]},{"verse":6,"text":"[5]われらの救,すくいの神,かみよ、地,ちのもろもろのはてと、遠,とおき海,うみの望,のぞみであるあなたは恐,おそるべきわざにより、救,すくいをもってわれらに答,こたえられる。","tok":[["["],["5"],["]"],["われ"],["ら"],["の"],["救い","すくい"],["の"],["神","かみ"],["よ"],["、"],["地","ち"],["の"],["もろもろ"],["の"],["はて"],["と"],["、"],["遠き","とおき"],["海","うみ"],["の"],["望み","のぞみ"],["で"],["ある"],["あなた"],["は"],["恐るべき","おそるべき"],["わざ"],["に"],["より"],["、"],["救い","すくい"],["を"],["もって"],["われ"],["ら"],["に"],["答","こたえ"],["られる"],["。"]]},{"verse":7,"text":"[6]あなたは大能,たいのうを帯,おび、そのみ力,ちからによって、もろもろの山,やまを堅,かたく立,たたせられる。","tok":[["["],["6"],["]"],["あなた"],["は"],["大能","たいのう"],["を"],["帯","おび"],["、"],["その"],["み力","みちから"],["によって"],["、"],["もろもろ"],["の"],["山","やま"],["を"],["堅く","かたく"],["立たせられる","たたせられる"],["。"]]},{"verse":8,"text":"[7]あなたは海,うみの響,ひびき、大波,おおなみの響,ひびき、もろもろの民,たみの騒,さわぎを静,しずめられる。","tok":[["["],["7"],["]"],["あなた"],["は"],["海","うみ"],["の"],["響","ひびき"],["、"],["大波","おおなみ"],["の"],["響","ひびき"],["、"],["もろもろ"],["の"],["民","たみ"],["の"],["騒","さわぎ"],["を"],["静められる","しずめられる"],["。"]]},{"verse":9,"text":"[8]それゆえ、地,ちのはてに住,すむ人々,ひとびとも、あなたのもろもろのしるしを見,みて恐,おそれる。あなたは朝,あさと夕,ゆうの出,でる所,ところをして喜,よろこび歌,うたわせられる。","tok":[["["],["8"],["]"],["それ"],["ゆえ"],["、"],["地","ち"],["の"],["はて"],["に"],["住む","すむ"],["人々","ひとびと"],["も"],["、"],["あなた"],["の"],["もろもろ"],["の"],["しるし"],["を"],["見て","みて"],["恐れる","おそれる"],["。"],["あなた"],["は"],["朝","あさ"],["と"],["夕","ゆう"],["の"],["出る","でる"],["所","ところ"],["を"],["して"],["喜こび","よろこび"],["歌わせられる","うたわせられる"],["。"]]},{"verse":10,"text":"[9]あなたは地,ちに臨,のぞんで、これに水,みずをそそぎ、これを大,おおいに豊,ゆたかにされる。神,かみの川,かわは水,みずで満,みちている。あなたはそのように備,そなえして彼,かれらに穀物,こくもつを与,あたえられる。","tok":[["["],["9"],["]"],["あなた"],["は"],["地","ち"],["に"],["臨んで","のぞんで"],["、"],["これ"],["に"],["水","みず"],["を"],["そそぎ"],["、"],["これ"],["を"],["大いに","おおいに"],["豊","ゆたか"],["に"],["される"],["。"],["神","かみ"],["の"],["川","かわ"],["は"],["水","みず"],["で"],["満ちて","みちて"],["いる"],["。"],["あなた"],["は"],["その"],["よう"],["に"],["備","そなえ"],["して"],["彼","かれ"],["ら"],["に"],["穀物","こくもつ"],["を"],["与えられる","あたえられる"],["。"]]},{"verse":11,"text":"[10]あなたはその田,たみぞを豊,ゆたかにうるおし、そのうねを整,ととのえ、夕立,ゆうだちをもってそれを柔,やわらかにし、そのもえ出,でるのを祝福,しゅくふくし、","tok":[["["],["10"],["]"],["あなた"],["は"],["その"],["田","た"],["みぞ"],["を"],["豊","ゆたか"],["に"],["うるおし"],["、"],["その"],["うね"],["を"],["整え","ととのえ"],["、"],["夕立","ゆうだち"],["を"],["もって"],["それ"],["を"],["柔らか","やわらか"],["に"],["し"],["、"],["その"],["もえ出る","もえでる"],["の"],["を"],["祝福","しゅくふく"],["し"],["、"]]},{"verse":12,"text":"[11]またその恵,めぐみをもって年,としの冠,かんむりとされる。あなたの道,みちにはあぶらがしたたる。","tok":[["["],["11"],["]"],["また"],["その"],["恵","めぐみ"],["を"],["もって"],["年","とし"],["の"],["冠","かんむり"],["と"],["される"],["。"],["あなた"],["の"],["道","みち"],["に"],["は"],["あぶら"],["が"],["したたる"],["。"]]},{"verse":13,"text":"[12]野,のの牧場,まきばはしたたり、小山,こやまは喜,よろこびをまとい、","tok":[["["],["12"],["]"],["野","の"],["の"],["牧場","まきば"],["は"],["した"],["たり"],["、"],["小山","こやま"],["は"],["喜こび","よろこび"],["を"],["まとい"],["、"]]},{"verse":14,"text":"[13]牧場,まきばは羊,ひつじの群,むれを着,き、もろもろの谷,たには穀物,こくもつをもっておおわれ、彼,かれらは喜,よろこび呼,よばわって共,ともに歌,うたう。","tok":[["["],["13"],["]"],["牧場","まきば"],["は"],["羊","ひつじ"],["の"],["群れ","むれ"],["を"],["着","き"],["、"],["もろもろ"],["の"],["谷","たに"],["は"],["穀物","こくもつ"],["を"],["もって"],["おおわれ"],["、"],["彼","かれ"],["ら"],["は"],["喜こび","よろこび"],["呼ばわって","よばわって"],["共","とも"],["に"],["歌う","うたう"],["。"]]}]
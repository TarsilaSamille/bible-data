[{"verse":1,"text":"[0]【聖歌,せいか隊,たいの指揮者,しきしゃによってマハラテのしらべにあわせてうたわせたダビデのマスキールの歌,うた】","tok":[["["],["0"],["]"],["【"],["聖歌隊","せいかたい"],["の"],["指揮者","しきしゃ"],["によって"],["マハラテ"],["の"],["しらべ"],["に"],["あわせて"],["うたわせた"],["ダビデ"],["の"],["マスキール"],["の"],["歌","うた"],["】"]]},{"verse":2,"text":"[1]愚,おろかな者,ものは心,こころのうちに「神,かみはない」と言,いう。彼,かれらは腐,くされはて、憎,にくむべき不義,ふぎをおこなった。善,ぜんを行,おこなう者,ものはない。","tok":[["["],["1"],["]"],["愚か","おろか"],["な"],["者","もの"],["は"],["心","こころ"],["の"],["うち"],["に"],["「"],["神","かみ"],["は"],["ない"],["」"],["と"],["言う","いう"],["。"],["彼","かれ"],["ら"],["は"],["腐れ","くされ"],["はて"],["、"],["憎むべき","にくむべき"],["不義","ふぎ"],["を"],["おこなった"],["。"],["善","ぜん"],["を"],["行なう","おこなう"],["者","もの"],["は"],["ない"],["。"]]},{"verse":3,"text":"[2]神,かみは天,てんから人,ひとの子,こを見,みおろして、賢,かしこい者,もの、神,かみを尋,たずね求,もとめる者,ものがあるかないかを見,みられた。","tok":[["["],["2"],["]"],["神","かみ"],["は"],["天","てん"],["から"],["人","ひと"],["の"],["子","こ"],["を"],["見おろして","みおろして"],["、"],["賢しこい","かしこい"],["者","もの"],["、"],["神","かみ"],["を"],["尋ね求める","たずねもとめる"],["者","もの"],["が"],["ある"],["か"],["ない"],["か"],["を"],["見られた","みられた"],["。"]]},{"verse":4,"text":"[3]彼,かれらは皆,みなそむき、みなひとしく堕落,だらくした。善,ぜんを行,おこなう者,ものはない、ひとりもない。","tok":[["["],["3"],["]"],["彼","かれ"],["ら"],["は"],["皆","みな"],["そむき"],["、"],["みな"],["ひとしく"],["堕落","だらく"],["した"],["。"],["善","ぜん"],["を"],["行なう","おこなう"],["者","もの"],["は"],["ない"],["、"],["ひとり"],["も"],["ない"],["。"]]},{"verse":5,"text":"[4]悪,あくを行,おこなう者,ものは悟,さとりがないのか。彼,かれらは物,もの食,くうようにわが民,たみを食,くらい、また神,かみを呼,よぶことをしない。","tok":[["["],["4"],["]"],["悪","あく"],["を"],["行なう","おこなう"],["者","もの"],["は"],["悟り","さとり"],["が"],["ない"],["の"],["か"],["。"],["彼","かれ"],["ら"],["は"],["物","もの"],["食う","くう"],["よう"],["に"],["わが"],["民","たみ"],["を"],["食らい","くらい"],["、"],["また"],["神","かみ"],["を"],["呼ぶ","よぶ"],["こと"],["を"],["しない"],["。"]]},{"verse":6,"text":"[5]彼,かれらは恐,おそるべきことのない時,ときに大,おおいに恐,おそれた。神,かみはよこしまな者,ものの骨,ほねを散,ちらされるからである。神,かみが彼,かれらを捨,すてられるので、彼,かれらは恥,はじをこうむるであろう。","tok":[["["],["5"],["]"],["彼","かれ"],["ら"],["は"],["恐るべき","おそるべき"],["こと"],["の"],["ない"],["時","とき"],["に"],["大いに","おおいに"],["恐れた","おそれた"],["。"],["神","かみ"],["は"],["よこしま"],["な"],["者","もの"],["の"],["骨","ほね"],["を"],["散らされる","ちらされる"],["から"],["で"],["ある"],["。"],["神","かみ"],["が"],["彼","かれ"],["ら"],["を"],["捨てられる","すてられる"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["恥","はじ"],["を"],["こうむるで"],["あろう"],["。"]]},{"verse":7,"text":"[6]どうか、シオンからイスラエルの救,すくいが出,でるように。神,かみがその民,たみの繁栄,はんえいを回復,かいふくされる時,とき、ヤコブは喜,よろこび、イスラエルは楽,たのしむであろう。","tok":[["["],["6"],["]"],["どう"],["か"],["、"],["シオン"],["から"],["イスラエル"],["の"],["救い","すくい"],["が"],["出る","でる"],["よう"],["に"],["。"],["神","かみ"],["が"],["その"],["民","たみ"],["の"],["繁栄","はんえい"],["を"],["回復","かいふく"],["される"],["時","とき"],["、"],["ヤコブ"],["は"],["喜こび","よろこび"],["、"],["イスラエル"],["は"],["楽しむで","たのしむで"],["あろう"],["。"]]}]
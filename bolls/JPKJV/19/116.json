[{"verse":1,"text":"わたしは主,しゅを愛,あいする。主,しゅはわが声,こえと、わが願,ねがいとを聞,きかれたからである。","tok":[["わたし"],["は"],["主","しゅ"],["を"],["愛する","あいする"],["。"],["主","しゅ"],["は"],["わが"],["声","こえ"],["と"],["、"],["わが"],["願い","ねがい"],["と"],["を"],["聞かれた","きかれた"],["から"],["で"],["ある"],["。"]]},{"verse":2,"text":"主,しゅはわたしに耳,みみを傾,かたむけられたので、わたしは生,いきるかぎり主,しゅを呼,よびまつるであろう。","tok":[["主","しゅ"],["は"],["わたし"],["に"],["耳","みみ"],["を"],["傾むけられた","かたむけられた"],["ので"],["、"],["わたし"],["は"],["生きる","いきる"],["かぎり"],["主","しゅ"],["を"],["呼び","よび"],["まつるで"],["あろう"],["。"]]},{"verse":3,"text":"死,しの綱,つながわたしを取,とり巻,まき、陰府,よみの苦,くるしみがわたしを捕,とらえた。わたしは悩,なやみと悲,かなしみにあった。","tok":[["死","し"],["の"],["綱","つな"],["が"],["わたし"],["を"],["取巻","とりまき"],["、"],["陰府","よみ"],["の"],["苦しみ","くるしみ"],["が"],["わたし"],["を"],["捕らえた","とらえた"],["。"],["わたし"],["は"],["悩み","なやみ"],["と"],["悲しみ","かなしみ"],["に"],["あった"],["。"]]},{"verse":4,"text":"その時,ときわたしは主,しゅのみ名,なを呼,よんだ。「主,しゅよ、どうぞわたしをお救,すくいください」と。","tok":[["その"],["時","とき"],["わたし"],["は"],["主","しゅ"],["のみ"],["名","な"],["を"],["呼んだ","よんだ"],["。"],["「"],["主","しゅ"],["よ"],["、"],["どうぞ"],["わたし"],["を"],["お救い","おすくい"],["ください"],["」"],["と"],["。"]]},{"verse":5,"text":"主,しゅは恵,めぐみふかく、正,ただしくいらせられ、われらの神,かみはあわれみに富,とまれる。","tok":[["主","しゅ"],["は"],["恵","めぐみ"],["ふかく"],["、"],["正く","ただしく"],["いらせられ"],["、"],["われ"],["ら"],["の"],["神","かみ"],["は"],["あわれみ"],["に"],["富まれる","とまれる"],["。"]]},{"verse":6,"text":"主,しゅは無学,むがくな者,ものを守,まもられる。わたしが低,ひくくされたとき、主,しゅはわたしを救,すくわれた。","tok":[["主","しゅ"],["は"],["無学","むがく"],["な"],["者","もの"],["を"],["守られる","まもられる"],["。"],["わたし"],["が"],["低く","ひくく"],["された"],["とき"],["、"],["主","しゅ"],["は"],["わたし"],["を"],["救われた","すくわれた"],["。"]]},{"verse":7,"text":"わが魂,たましいよ、おまえの平安,へいあんに帰,かえるがよい。主,しゅは豊,ゆたかにおまえをあしらわれたからである。","tok":[["わが"],["魂","たましい"],["よ"],["、"],["おまえ"],["の"],["平安","へいあん"],["に"],["帰える","かえる"],["が"],["よい"],["。"],["主","しゅ"],["は"],["豊","ゆたか"],["に"],["おまえ"],["を"],["あしらわれた"],["から"],["で"],["ある"],["。"]]},{"verse":8,"text":"あなたはわたしの魂,たましいを死,しから、わたしの目,めを涙,なみだから、わたしの足,あしをつまずきから助,たすけ出,だされました。","tok":[["あなた"],["は"],["わたし"],["の"],["魂","たましい"],["を"],["死","し"],["から"],["、"],["わたし"],["の"],["目","め"],["を"],["涙","なみだ"],["から"],["、"],["わたし"],["の"],["足","あし"],["を"],["つまずき"],["から"],["助け出されました","たすけだされました"],["。"]]},{"verse":9,"text":"わたしは生,いける者,ものの地,ちで、主,しゅのみ前,まえに歩,あゆみます。","tok":[["わたし"],["は"],["生ける","いける"],["者","もの"],["の"],["地","ち"],["で"],["、"],["主","しゅ"],["のみ"],["前","まえ"],["に"],["歩みます","あゆみます"],["。"]]},{"verse":10,"text":"「わたしは大,おおいに悩,なやんだ」と言,いった時,ときにもなお信,しんじた。","tok":[["「"],["わたし"],["は"],["大いに","おおいに"],["悩んだ","なやんだ"],["」"],["と"],["言った","いった"],["時","とき"],["に"],["も"],["なお"],["信じた","しんじた"],["。"]]},{"verse":11,"text":"わたしは驚,おどろきあわてたときに言,いった、「すべての人,ひとは当,とうにならぬ者,ものである」と。","tok":[["わたし"],["は"],["驚","おどろき"],["あわてた"],["とき"],["に"],["言った","いった"],["、"],["「"],["すべて"],["の"],["人","ひと"],["は"],["当","とう"],["に"],["ならぬ"],["者","もの"],["で"],["ある"],["」"],["と"],["。"]]},{"verse":12,"text":"わたしに賜,たまわったもろもろの恵,めぐみについて、どうして主,しゅに報,むくいることができようか。","tok":[["わたし"],["に"],["賜わった","たまわった"],["もろもろ"],["の"],["恵","めぐみ"],["について"],["、"],["どう"],["して"],["主に","しゅに"],["報いる","むくいる"],["こと"],["が"],["できよう"],["か"],["。"]]},{"verse":13,"text":"わたしは救,すくいの杯,さかずきをあげて、主,しゅのみ名,なを呼,よぶ。","tok":[["わたし"],["は"],["救い","すくい"],["の"],["杯","さかずき"],["を"],["あげて"],["、"],["主","しゅ"],["のみ"],["名","な"],["を"],["呼ぶ","よぶ"],["。"]]},{"verse":14,"text":"わたしはすべての民,たみの前,まえで、主,しゅにわが誓,ちかいをつぐなおう。","tok":[["わたし"],["は"],["すべて"],["の"],["民","たみ"],["の"],["前","まえ"],["で"],["、"],["主に","しゅに"],["わが"],["誓い","ちかい"],["を"],["つぐなおう"],["。"]]},{"verse":15,"text":"主,しゅの聖徒,せいとの死,しはそのみ前,まえにおいて尊,たっとい。","tok":[["主","しゅ"],["の"],["聖徒","せいと"],["の"],["死","し"],["は"],["その"],["み前","みまえ"],["に"],["おいて"],["尊","た"],["っと"],["い"],["。"]]},{"verse":16,"text":"主,しゅよ、わたしはあなたのしもべです。わたしはあなたのしもべ、あなたのはしための子,こです。あなたはわたしのなわめを解,とかれました。","tok":[["主","しゅ"],["よ"],["、"],["わたし"],["は"],["あなた"],["の"],["しもべ"],["です"],["。"],["わたし"],["は"],["あなた"],["の"],["しもべ"],["、"],["あなた"],["の"],["はし"],["ため"],["の"],["子","こ"],["です"],["。"],["あなた"],["は"],["わたし"],["の"],["なわ"],["め"],["を"],["解かれました","とかれました"],["。"]]},{"verse":17,"text":"わたしは感謝,かんしゃのいけにえをあなたにささげて、主,しゅのみ名,なを呼,よびます。","tok":[["わたし"],["は"],["感謝","かんしゃ"],["の"],["いけにえ"],["を"],["あなた"],["に"],["ささげて"],["、"],["主","しゅ"],["のみ"],["名","な"],["を"],["呼びます","よびます"],["。"]]},{"verse":18,"text":"わたしはすべての民,たみの前,まえで主,しゅにわが誓,ちかいをつぐないます。","tok":[["わたし"],["は"],["すべて"],["の"],["民","たみ"],["の"],["前","まえ"],["で"],["主に","しゅに"],["わが"],["誓い","ちかい"],["を"],["つぐないます"],["。"]]},{"verse":19,"text":"エルサレムよ、あなたの中,なかで、主,しゅの家,いえの大庭,おおにわの中,なかで、これをつぐないます。主,しゅをほめたたえよ。","tok":[["エルサレム"],["よ"],["、"],["あなた"],["の"],["中","なか"],["で"],["、"],["主","しゅ"],["の"],["家","いえ"],["の"],["大庭","おおにわ"],["の"],["中","なか"],["で"],["、"],["これ"],["を"],["つぐないます"],["。"],["主","しゅ"],["を"],["ほめたたえ"],["よ"],["。"]]}]
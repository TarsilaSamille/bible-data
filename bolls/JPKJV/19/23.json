[{"verse":1,"text":"【ダビデの歌,うた】主,しゅはわたしの牧者,ぼくしゃであって、わたしには乏,とぼしいことがない。","tok":[["【"],["ダビデ"],["の"],["歌","うた"],["】"],["主","しゅ"],["は"],["わたし"],["の"],["牧者","ぼくしゃ"],["で"],["あって"],["、"],["わたし"],["に"],["は"],["乏い","とぼしい"],["こと"],["が"],["ない"],["。"]]},{"verse":2,"text":"主,しゅはわたしを緑,みどりの牧場,まきばに伏,ふさせ、いこいのみぎわに伴,ともなわれる。","tok":[["主","しゅ"],["は"],["わたし"],["を"],["緑","みどり"],["の"],["牧場","まきば"],["に"],["伏させ","ふさせ"],["、"],["いこい"],["の"],["みぎわ"],["に"],["伴なわれる","ともなわれる"],["。"]]},{"verse":3,"text":"主,しゅはわたしの魂,たましいをいきかえらせ、み名,なのためにわたしを正,ただしい道,みちに導,みちびかれる。","tok":[["主","しゅ"],["は"],["わたし"],["の"],["魂","たましい"],["を"],["いきかえらせ"],["、"],["み名","みな"],["の"],["ため"],["に"],["わたし"],["を"],["正い","ただしい"],["道","みち"],["に"],["導かれる","みちびかれる"],["。"]]},{"verse":4,"text":"たといわたしは死,しの陰,かげの谷,たにを歩,あゆむとも、わざわいを恐,おそれません。あなたがわたしと共,ともにおられるからです。あなたのむちと、あなたのつえはわたしを慰,なぐさめます。","tok":[["たとい"],["わたし"],["は"],["死","し"],["の"],["陰","かげ"],["の"],["谷","たに"],["を"],["歩む","あゆむ"],["とも"],["、"],["わざわい"],["を"],["恐れません","おそれません"],["。"],["あなた"],["が"],["わたし"],["と"],["共","とも"],["に"],["おられる"],["から"],["です"],["。"],["あなた"],["の"],["むち"],["と"],["、"],["あなた"],["の"],["つえ"],["は"],["わたし"],["を"],["慰さめます","なぐさめます"],["。"]]},{"verse":5,"text":"あなたはわたしの敵,てきの前,まえで、わたしの前,まえに宴,うたげを設,もうけ、わたしのこうべに油,あぶらをそそがれる。わたしの杯,さかずきはあふれます。","tok":[["あなた"],["は"],["わたし"],["の"],["敵","てき"],["の"],["前","まえ"],["で"],["、"],["わたし"],["の"],["前","まえ"],["に"],["宴","うたげ"],["を"],["設け","もうけ"],["、"],["わたし"],["の"],["こうべ"],["に"],["油","あぶら"],["を"],["そそがれる"],["。"],["わたし"],["の"],["杯","さかずき"],["は"],["あふれます"],["。"]]},{"verse":6,"text":"わたしの生,いきているかぎりは必,かならず恵,めぐみといつくしみとが伴,ともなうでしょう。わたしはとこしえに主,しゅの宮,みやに住,すむでしょう。","tok":[["わたし"],["の"],["生きて","いきて"],["いる"],["かぎり"],["は"],["必","かならず"],["恵","めぐみ"],["と"],["いつくしみ"],["と"],["が"],["伴なうでしょう","ともなうでしょう"],["。"],["わたし"],["は"],["とこしえ"],["に"],["主","しゅ"],["の"],["宮","みや"],["に"],["住むでしょう","すむでしょう"],["。"]]}]
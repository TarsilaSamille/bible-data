[{"verse":1,"text":"[0]【聖歌,せいか隊,たいの指揮者,しきしゃによって琴,ことにあわせてうたわせた歌,うた、さんび】","tok":[["["],["0"],["]"],["【"],["聖歌隊","せいかたい"],["の"],["指揮者","しきしゃ"],["によって"],["琴","こと"],["に"],["あわせて"],["うたわせた"],["歌","うた"],["、"],["さん"],["び"],["】"]]},{"verse":2,"text":"[1]どうか、神,かみがわれらをあわれみ、われらを祝福,しゅくふくし、そのみ顔,かおをわれらの上,うえに照,てらされるように。〔セラ","tok":[["["],["1"],["]"],["どう"],["か"],["、"],["神","かみ"],["が"],["われ"],["ら"],["を"],["あわれみ"],["、"],["われ"],["ら"],["を"],["祝福","しゅくふく"],["し"],["、"],["その"],["み顔","みかお"],["を"],["われ"],["ら"],["の"],["上","うえ"],["に"],["照らされる","てらされる"],["よう"],["に"],["。"],["〔"],["セラ"]]},{"verse":3,"text":"[2]これはあなたの道,みちがあまねく地,ちに知,しられ、あなたの救,すくいの力,ちからがもろもろの国民,こくみんのうちに知,しられるためです。","tok":[["["],["2"],["]"],["これ"],["は"],["あなた"],["の"],["道","みち"],["が"],["あまねく"],["地","ち"],["に"],["知られ","しられ"],["、"],["あなた"],["の"],["救い","すくい"],["の"],["力","ちから"],["が"],["もろもろ"],["の"],["国民","こくみん"],["の"],["うち"],["に"],["知られる","しられる"],["ため"],["です"],["。"]]},{"verse":4,"text":"[3]神,かみよ、民,たみらにあなたをほめたたえさせ、もろもろの民,たみにあなたをほめたたえさせてください。","tok":[["["],["3"],["]"],["神","かみ"],["よ"],["、"],["民","たみ"],["ら"],["に"],["あなた"],["を"],["ほめたたえさせ"],["、"],["もろもろ"],["の"],["民","たみ"],["に"],["あなた"],["を"],["ほめたたえさせて"],["ください"],["。"]]},{"verse":5,"text":"[4]もろもろの国民,こくみんを楽,たのしませ、また喜,よろこび歌,うたわせてください。あなたは公平,こうへいをもってもろもろの民,たみをさばき、地,ちの上,うえなるもろもろの国民,こくみんを導,みちびかれるからです。〔セラ","tok":[["["],["4"],["]"],["もろもろ"],["の"],["国民","こくみん"],["を"],["楽しませ","たのしませ"],["、"],["また"],["喜こび","よろこび"],["歌わせて","うたわせて"],["ください"],["。"],["あなた"],["は"],["公平","こうへい"],["を"],["もって"],["もろもろ"],["の"],["民","たみ"],["を"],["さばき"],["、"],["地","ち"],["の"],["上","うえ"],["なる"],["もろもろ"],["の"],["国民","こくみん"],["を"],["導かれる","みちびかれる"],["から"],["です"],["。"],["〔"],["セラ"]]},{"verse":6,"text":"[5]神,かみよ、民,たみらにあなたをほめたたえさせ、もろもろの民,たみにあなたをほめたたえさせてください。","tok":[["["],["5"],["]"],["神","かみ"],["よ"],["、"],["民","たみ"],["ら"],["に"],["あなた"],["を"],["ほめたたえさせ"],["、"],["もろもろ"],["の"],["民","たみ"],["に"],["あなた"],["を"],["ほめたたえさせて"],["ください"],["。"]]},{"verse":7,"text":"[6]地,ちはその産物,さんぶつを出,だしました。神,かみ、われらの神,かみはわれらを祝福,しゅくふくされました。","tok":[["["],["6"],["]"],["地","ち"],["は"],["その"],["産物","さんぶつ"],["を"],["出しました","だしました"],["。"],["神","かみ"],["、"],["われ"],["ら"],["の"],["神","かみ"],["は"],["われ"],["ら"],["を"],["祝福","しゅくふく"],["されました"],["。"]]},{"verse":8,"text":"[7]神,かみはわれらを祝福,しゅくふくされました。地,ちのもろもろのはてにことごとく神,かみを恐,おそれさせてください。","tok":[["["],["7"],["]"],["神","かみ"],["は"],["われ"],["ら"],["を"],["祝福","しゅくふく"],["されました"],["。"],["地","ち"],["の"],["もろもろ"],["の"],["はて"],["に"],["ことごとく"],["神","かみ"],["を"],["恐れさせて","おそれさせて"],["ください"],["。"]]}]
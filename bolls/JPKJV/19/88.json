[{"verse":1,"text":"[0]【聖歌,せいか隊,たいの指揮者,しきしゃによってマハラテ・レアノテのしらべにあわせてうたわせたコラの子,この歌,うた、さんび。エズラびとヘマンのマスキールの歌,うた】","tok":[["["],["0"],["]"],["【"],["聖歌隊","せいかたい"],["の"],["指揮者","しきしゃ"],["によって"],["マハラテ"],["・"],["レアノテ"],["の"],["しらべ"],["に"],["あわせて"],["うたわせた"],["コラ"],["の"],["子","こ"],["の"],["歌","うた"],["、"],["さん"],["び"],["。"],["エズラ"],["びと"],["ヘマン"],["の"],["マスキール"],["の"],["歌","うた"],["】"]]},{"verse":2,"text":"[1]わが神,かみ、主,しゅよ、わたしは昼,ひる、助,たすけを呼,よび求,もとめ、夜,よる、み前,まえに叫,さけび求,もとめます。","tok":[["["],["1"],["]"],["わが"],["神","かみ"],["、"],["主","しゅ"],["よ"],["、"],["わたし"],["は"],["昼","ひる"],["、"],["助け","たすけ"],["を"],["呼び求め","よびもとめ"],["、"],["夜","よる"],["、"],["み前","みまえ"],["に"],["叫","さけび"],["求めます","もとめます"],["。"]]},{"verse":3,"text":"[2]わたしの祈,いのりをみ前,まえにいたらせ、わたしの叫,さけびに耳,みみを傾,かたむけてください。","tok":[["["],["2"],["]"],["わたし"],["の"],["祈","いのり"],["を"],["み前","みまえ"],["に"],["いたらせ"],["、"],["わたし"],["の"],["叫","さけび"],["に"],["耳","みみ"],["を"],["傾むけて","かたむけて"],["ください"],["。"]]},{"verse":4,"text":"[3]わたしの魂,たましいは悩,なやみに満,みち、わたしのいのちは陰府,よみに近,ちかづきます。","tok":[["["],["3"],["]"],["わたし"],["の"],["魂","たましい"],["は"],["悩み","なやみ"],["に"],["満ち","みち"],["、"],["わたし"],["の"],["いのち"],["は"],["陰府","よみ"],["に"],["近づきます","ちかづきます"],["。"]]},{"verse":5,"text":"[4]わたしは穴,あなに下,くだる者,もののうちに数,かぞえられ、力,ちからのない人,ひとのようになりました。","tok":[["["],["4"],["]"],["わたし"],["は"],["穴","あな"],["に"],["下る","くだる"],["者","もの"],["の"],["うち"],["に"],["数えられ","かぞえられ"],["、"],["力","ちから"],["の"],["ない"],["人","ひと"],["の"],["よう"],["に"],["なりました"],["。"]]},{"verse":6,"text":"[5]すなわち死人,しにんのうちに捨,すてられた者,もののように、墓,はかに横,よこたわる殺,ころされた者,もののように、あなたが再,ふたたび心,こころにとめられない者,もののようになりました。彼,かれらはあなたのみ手,てから断,たち滅,ほろぼされた者,ものです。","tok":[["["],["5"],["]"],["すなわち"],["死人","しにん"],["の"],["うち"],["に"],["捨てられた","すてられた"],["者","もの"],["の"],["よう"],["に"],["、"],["墓","はか"],["に"],["横たわる","よこたわる"],["殺された","ころされた"],["者","もの"],["の"],["よう"],["に"],["、"],["あなた"],["が"],["再び","ふたたび"],["心","こころ"],["に"],["とめられない"],["者","もの"],["の"],["よう"],["に"],["なりました"],["。"],["彼","かれ"],["ら"],["は"],["あなた"],["のみ"],["手","て"],["から"],["断ち","たち"],["滅ぼされた","ほろぼされた"],["者","もの"],["です"],["。"]]},{"verse":7,"text":"[6]あなたはわたしを深,ふかい穴,あな、暗,くらい所,ところ、深,ふかい淵,ふちに置,おかれました。","tok":[["["],["6"],["]"],["あなた"],["は"],["わたし"],["を"],["深","ふ"],["かい"],["穴","あな"],["、"],["暗い","くらい"],["所","ところ"],["、"],["深","ふ"],["かい"],["淵","ふち"],["に"],["置かれました","おかれました"],["。"]]},{"verse":8,"text":"[7]あなたの怒,いかりはわたしの上,うえに重,おもく、あなたはもろもろの波,なみをもってわたしを苦,くるしめられました。〔セラ","tok":[["["],["7"],["]"],["あなた"],["の"],["怒り","いかり"],["は"],["わたし"],["の"],["上","うえ"],["に"],["重く","おもく"],["、"],["あなた"],["は"],["もろもろ"],["の"],["波","なみ"],["を"],["もって"],["わたし"],["を"],["苦しめられました","くるしめられました"],["。"],["〔"],["セラ"]]},{"verse":9,"text":"[8]あなたはわが知,しり人,ひとをわたしから遠,とおざけ、わたしを彼,かれらの忌,いみきらう者,ものとされました。わたしは閉,とじこめられて、のがれることはできません。","tok":[["["],["8"],["]"],["あなた"],["は"],["わが"],["知り人","しりひと"],["を"],["わたし"],["から"],["遠ざけ","とおざけ"],["、"],["わたし"],["を"],["彼","かれ"],["ら"],["の"],["忌","いみ"],["きらう"],["者","もの"],["と"],["されました"],["。"],["わたし"],["は"],["閉じこめられて","とじこめられて"],["、"],["のがれる"],["こと"],["は"],["できません"],["。"]]},{"verse":10,"text":"[9]わたしの目,めは悲,かなしみによって衰,おとろえました。主,しゅよ、わたしは日,ひごとにあなたを呼,よび、あなたにむかってわが両手,りょうてを伸,のべました。","tok":[["["],["9"],["]"],["わたし"],["の"],["目","め"],["は"],["悲しみ","かなしみ"],["によって"],["衰えました","おとろえました"],["。"],["主","しゅ"],["よ"],["、"],["わたし"],["は"],["日ごと","ひごと"],["に"],["あなた"],["を"],["呼び","よび"],["、"],["あなた"],["に"],["むかって"],["わが"],["両手","りょうて"],["を"],["伸べました","のべました"],["。"]]},{"verse":11,"text":"[10]あなたは死,しんだ者,もののために奇跡,きせきを行,おこなわれるでしょうか。なき人,ひとのたましいは起,おきあがってあなたをほめたたえるでしょうか。〔セラ","tok":[["["],["10"],["]"],["あなた"],["は"],["死んだ","しんだ"],["者","もの"],["の"],["ため"],["に"],["奇跡","きせき"],["を"],["行なわれるでしょう","おこなわれるでしょう"],["か"],["。"],["なき"],["人","ひと"],["の"],["たましい"],["は"],["起きあがって","おきあがって"],["あなた"],["を"],["ほめたたえるでしょう"],["か"],["。"],["〔"],["セラ"]]},{"verse":12,"text":"[11]あなたのいつくしみは墓,はかのなかに、あなたのまことは滅,ほろびのなかに、宣,のべ伝,つたえられるでしょうか。","tok":[["["],["11"],["]"],["あなた"],["の"],["いつくしみ"],["は"],["墓","はか"],["の"],["なか"],["に"],["、"],["あなた"],["の"],["まこと"],["は"],["滅び","ほろび"],["の"],["なか"],["に"],["、"],["宣べ伝えられるでしょう","のべつたえられるでしょう"],["か"],["。"]]},{"verse":13,"text":"[12]あなたの奇跡,きせきは暗,くらやみに、あなたの義,ぎは忘,わすれの国,くにに知,しられるでしょうか。","tok":[["["],["12"],["]"],["あなた"],["の"],["奇跡","きせき"],["は"],["暗やみ","くらやみ"],["に"],["、"],["あなた"],["の"],["義","ぎ"],["は"],["忘","わすれ"],["の"],["国","くに"],["に"],["知られるでしょう","しられるでしょう"],["か"],["。"]]},{"verse":14,"text":"[13]しかし主,しゅよ、わたしはあなたに呼,よばわります。あしたに、わが祈,いのりをあなたのみ前,まえにささげます。","tok":[["["],["13"],["]"],["しかし"],["主","しゅ"],["よ"],["、"],["わたし"],["は"],["あなた"],["に"],["呼ばわります","よばわります"],["。"],["あした"],["に"],["、"],["わが"],["祈","いのり"],["を"],["あなた"],["のみ"],["前","まえ"],["に"],["ささげます"],["。"]]},{"verse":15,"text":"[14]主,しゅよ、なぜ、あなたはわたしを捨,すてられるのですか。なぜ、わたしにみ顔,かおを隠,かくされるのですか。","tok":[["["],["14"],["]"],["主","しゅ"],["よ"],["、"],["なぜ"],["、"],["あなた"],["は"],["わたし"],["を"],["捨てられる","すてられる"],["の"],["です"],["か"],["。"],["なぜ"],["、"],["わたし"],["に"],["み顔","みかお"],["を"],["隠される","かくされる"],["の"],["です"],["か"],["。"]]},{"verse":16,"text":"[15]わたしは若,わかい時,ときから苦,くるしんで死,しぬばかりです。あなたの脅,おびやかしにあって衰,おとろえはてました。","tok":[["["],["15"],["]"],["わたし"],["は"],["若い","わかい"],["時","とき"],["から"],["苦しんで","くるしんで"],["死ぬ","しぬ"],["ばかり"],["です"],["。"],["あなた"],["の"],["脅やかし","おびやかし"],["に"],["あって"],["衰え","おとろえ"],["はてました"],["。"]]},{"verse":17,"text":"[16]あなたの激,はげしい怒,いかりがわたしを襲,おそい、あなたの恐,おそろしい脅,おびやかしがわたしを滅,ほろぼしました。","tok":[["["],["16"],["]"],["あなた"],["の"],["激しい","はげしい"],["怒り","いかり"],["が"],["わたし"],["を"],["襲い","おそい"],["、"],["あなた"],["の"],["恐ろしい","おそろしい"],["脅やかし","おびやかし"],["が"],["わたし"],["を"],["滅ぼしました","ほろぼしました"],["。"]]},{"verse":18,"text":"[17]これらの事,ことがひねもす大水,おおみずのようにわたしをめぐり、わたしを全,まったく取,とり巻,まきました。","tok":[["["],["17"],["]"],["これ"],["ら"],["の"],["事","こと"],["が"],["ひねもす"],["大水","おおみず"],["の"],["よう"],["に"],["わたし"],["を"],["めぐり"],["、"],["わたし"],["を"],["全く","まったく"],["取巻","とりまき"],["ました"],["。"]]},{"verse":19,"text":"[18]あなたは愛,あいする者,ものと友,ともとをわたしから遠,とおざけ、わたしの知,しり人,ひとを暗,くらやみにおかれました。","tok":[["["],["18"],["]"],["あなた"],["は"],["愛する","あいする"],["者","もの"],["と"],["友","とも"],["と"],["を"],["わたし"],["から"],["遠ざけ","とおざけ"],["、"],["わたし"],["の"],["知り人","しりひと"],["を"],["暗やみ","くらやみ"],["に"],["おかれました"],["。"]]}]
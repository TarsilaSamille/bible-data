[{"verse":1,"text":"【ダビデの歌,うた】わたしはいつくしみと公義,こうぎについて歌,うたいます。主,しゅよ、わたしはあなたにむかって歌,うたいます。","tok":[["【"],["ダビデ"],["の"],["歌","うた"],["】"],["わたし"],["は"],["いつくしみ"],["と"],["公義","こうぎ"],["について"],["歌います","うたいます"],["。"],["主","しゅ"],["よ"],["、"],["わたし"],["は"],["あなた"],["に"],["むかって"],["歌います","うたいます"],["。"]]},{"verse":2,"text":"わたしは全,まったき道,みちに心,こころをとめます。あなたはいつ、わたしに来,こられるでしょうか。わたしは直,なおき心,こころをもって、わが家,いえのうちを歩,あゆみます。","tok":[["わたし"],["は"],["全","ま"],["っ"],["たき"],["道","みち"],["に"],["心","こころ"],["を"],["とめます"],["。"],["あなた"],["は"],["いつ"],["、"],["わたし"],["に"],["来られるでしょう","こられるでしょう"],["か"],["。"],["わたし"],["は"],["直","な"],["おき"],["心","こころ"],["を"],["もって"],["、"],["わが家","わがいえ"],["の"],["うち"],["を"],["歩みます","あゆみます"],["。"]]},{"verse":3,"text":"わたしは目,めの前,まえに卑,いやしい事,ことを置,おきません。わたしはそむく者,ものの行,おこないを憎,にくみます。それはわたしに付,つきまといません。","tok":[["わたし"],["は"],["目","め"],["の"],["前","まえ"],["に"],["卑しい","いやしい"],["事","こと"],["を"],["置きません","おきません"],["。"],["わたし"],["は"],["そむく"],["者","もの"],["の"],["行ない","おこない"],["を"],["憎みます","にくみます"],["。"],["それ"],["は"],["わたし"],["に"],["付きまといません","つきまといません"],["。"]]},{"verse":4,"text":"ひがんだ心,こころはわたしを離,はなれるでしょう。わたしは悪,わるい事,ことを知,しりません。","tok":[["ひがんだ"],["心","こころ"],["は"],["わたし"],["を"],["離れるでしょう","はなれるでしょう"],["。"],["わたし"],["は"],["悪い","わるい"],["事","こと"],["を"],["知りません","しりません"],["。"]]},{"verse":5,"text":"ひそかに、その隣,となり人,びとをそしる者,ものをわたしは滅,ほろぼします。高,たかぶる目,めと高慢,こうまんな心,こころの人,ひとを耐,たえ忍,しのぶ事,ことはできません。","tok":[["ひそか"],["に"],["、"],["その"],["隣人","となりびと"],["を"],["そしる"],["者","もの"],["を"],["わたし"],["は"],["滅ぼします","ほろぼします"],["。"],["高か","たか"],["ぶる"],["目","め"],["と"],["高慢","こうまん"],["な"],["心","こころ"],["の"],["人","ひと"],["を"],["耐え","たえ"],["忍","しのぶ"],["事","こと"],["は"],["できません"],["。"]]},{"verse":6,"text":"わたしは国,くにのうちの忠信,ちゅうしんな者,ものに好意,こういを寄,よせ、わたしと共,ともに住,すまわせます。全,まったき道,みちを歩,あゆむ者,ものはわたしに仕,つかえるでしょう。","tok":[["わたし"],["は"],["国","くに"],["の"],["うち"],["の"],["忠信","ちゅうしん"],["な"],["者","もの"],["に"],["好意","こうい"],["を"],["寄せ","よせ"],["、"],["わたし"],["と"],["共","とも"],["に"],["住まわせます","すまわせます"],["。"],["全","ま"],["っ"],["たき"],["道","みち"],["を"],["歩む","あゆむ"],["者","もの"],["は"],["わたし"],["に"],["仕えるでしょう","つかえるでしょう"],["。"]]},{"verse":7,"text":"欺,あざむくことをする者,ものはわが家,いえのうちに住,すむことができません。偽,いつわりを言,いう者,ものはわが目,めの前,まえに立,たつことができません。","tok":[["欺く","あざむく"],["こと"],["を"],["する"],["者","もの"],["は"],["わが家","わがいえ"],["の"],["うち"],["に"],["住む","すむ"],["こと"],["が"],["できません"],["。"],["偽り","いつわり"],["を"],["言う","いう"],["者","もの"],["は"],["わが"],["目","め"],["の"],["前","まえ"],["に"],["立つ","たつ"],["こと"],["が"],["できません"],["。"]]},{"verse":8,"text":"わたしは朝,あさごとに国,くにの悪,あしき者,ものをことごとく滅,ほろぼし、不義,ふぎを行,おこなう者,ものをことごとく主,しゅの都,みやこから断,たち除,のぞきます。","tok":[["わたし"],["は"],["朝","あさ"],["ごと"],["に"],["国","くに"],["の"],["悪しき","あしき"],["者","もの"],["を"],["ことごとく"],["滅ぼし","ほろぼし"],["、"],["不義","ふぎ"],["を"],["行なう","おこなう"],["者","もの"],["を"],["ことごとく"],["主","しゅ"],["の"],["都","みやこか"],["ら"],["断ち","たち"],["除きます","のぞきます"],["。"]]}]
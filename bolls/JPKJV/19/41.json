[{"verse":1,"text":"[0]【聖歌,せいか隊,たいの指揮者,しきしゃによってうたわせたダビデの歌,うた】","tok":[["["],["0"],["]"],["【"],["聖歌隊","せいかたい"],["の"],["指揮者","しきしゃ"],["によって"],["うたわせた"],["ダビデ"],["の"],["歌","うた"],["】"]]},{"verse":2,"text":"[1]貧,まずしい者,ものをかえりみる人,ひとはさいわいである。主,しゅはそのような人,ひとを悩,なやみの日,ひに救,すくい出,だされる。","tok":[["["],["1"],["]"],["貧しい","まずしい"],["者","もの"],["を"],["かえりみる"],["人","ひと"],["は"],["さいわい"],["で"],["ある"],["。"],["主","しゅ"],["は"],["その"],["よう"],["な"],["人","ひと"],["を"],["悩み","なやみ"],["の"],["日","ひ"],["に"],["救い出される","すくいだされる"],["。"]]},{"verse":3,"text":"[2]主,しゅは彼,かれを守,まもって、生,いきながらえさせられる。彼,かれはこの地,ちにあって、さいわいな者,ものと呼,よばれる。あなたは彼,かれをその敵,てきの欲望,よくぼうにわたされない。","tok":[["["],["2"],["]"],["主","しゅ"],["は"],["彼","かれ"],["を"],["守って","まもって"],["、"],["生きながらえさせられる","いきながらえさせられる"],["。"],["彼","かれ"],["は"],["この"],["地","ち"],["に"],["あって"],["、"],["さいわい"],["な"],["者","もの"],["と"],["呼ばれる","よばれる"],["。"],["あなた"],["は"],["彼","かれ"],["を"],["その"],["敵","てき"],["の"],["欲望","よくぼう"],["に"],["わたされない"],["。"]]},{"verse":4,"text":"[3]主,しゅは彼,かれをその病,やまいの床,とこでささえられる。あなたは彼,かれの病,やむ時,とき、その病,やまいをことごとくいやされる。","tok":[["["],["3"],["]"],["主","しゅ"],["は"],["彼","かれ"],["を"],["その"],["病","やまい"],["の"],["床","と"],["こ"],["で"],["ささえられる"],["。"],["あなた"],["は"],["彼","かれ"],["の"],["病む","やむ"],["時","とき"],["、"],["その"],["病","やまい"],["を"],["ことごとく"],["いやされる"],["。"]]},{"verse":5,"text":"[4]わたしは言,いった、「主,しゅよ、わたしをあわれみ、わたしをいやしてください。わたしはあなたにむかって罪,つみを犯,おかしました」と。","tok":[["["],["4"],["]"],["わたし"],["は"],["言った","いった"],["、"],["「"],["主","しゅ"],["よ"],["、"],["わたし"],["を"],["あわれみ"],["、"],["わたし"],["を"],["いやして"],["ください"],["。"],["わたし"],["は"],["あなた"],["に"],["むかって"],["罪","つみ"],["を"],["犯しました","おかしました"],["」"],["と"],["。"]]},{"verse":6,"text":"[5]わたしの敵,てきはわたしをそしって言,いう、「いつ彼,かれは死,しに、その名,ながほろびるであろうか」と。","tok":[["["],["5"],["]"],["わたし"],["の"],["敵","てき"],["は"],["わたし"],["を"],["そしって"],["言う","いう"],["、"],["「"],["いつ"],["彼","かれ"],["は"],["死に","しに"],["、"],["その"],["名","な"],["が"],["ほろびるで"],["あろう"],["か"],["」"],["と"],["。"]]},{"verse":7,"text":"[6]そのひとりがわたしを見,みようとして来,くるとき、彼,かれは偽,いつわりを語,かたり、その心,こころによこしまを集,あつめ、外,そとに出,でてはそれを言,いいふらす。","tok":[["["],["6"],["]"],["その"],["ひとり"],["が"],["わたし"],["を"],["見よう","みよう"],["として"],["来る","くる"],["とき"],["、"],["彼","かれ"],["は"],["偽り","いつわり"],["を"],["語り","かたり"],["、"],["その"],["心","こころ"],["に"],["よこしま"],["を"],["集め","あつめ"],["、"],["外","そと"],["に"],["出て","でて"],["は"],["それ"],["を"],["言いふらす","いいふらす"],["。"]]},{"verse":8,"text":"[7]すべてわたしを憎,にくむ者,ものはわたしについて共,ともにささやき、わたしのために災,わざわいを思,おもいめぐらす。","tok":[["["],["7"],["]"],["すべて"],["わたし"],["を"],["憎む","にくむ"],["者","もの"],["は"],["わたし"],["について"],["共","とも"],["に"],["ささやき"],["、"],["わたし"],["の"],["ため"],["に"],["災","わざわい"],["を"],["思いめぐらす","おもいめぐらす"],["。"]]},{"verse":9,"text":"[8]彼,かれらは言,いう、「彼,かれに一つのたたりがつきまとったから、倒,たおれ伏,ふして再,ふたたび起,おきあがらないであろう」と。","tok":[["["],["8"],["]"],["彼","かれ"],["ら"],["は"],["言う","いう"],["、"],["「"],["彼","かれ"],["に"],["一","ひと"],["つ"],["の"],["たたり"],["が"],["つきまとった"],["から"],["、"],["倒れ伏して","たおれふして"],["再び","ふたたび"],["起きあがらないで","おきあがらないで"],["あろう"],["」"],["と"],["。"]]},{"verse":10,"text":"[9]わたしの信頼,しんらいした親,したしい友,とも、わたしのパンを食,たべた親,したしい友,ともさえもわたしにそむいてくびすをあげた。","tok":[["["],["9"],["]"],["わたし"],["の"],["信頼","しんらい"],["した"],["親しい","したしい"],["友","とも"],["、"],["わたし"],["の"],["パン"],["を"],["食べた","たべた"],["親しい","したしい"],["友","とも"],["さえ"],["も"],["わたし"],["に"],["そむいて"],["くびす"],["を"],["あげた"],["。"]]},{"verse":11,"text":"[10]しかし主,しゅよ、わたしをあわれみ、わたしを助,たすけ起,おこしてください。そうすればわたしは彼,かれらに報,むくい返,かえすことができます。","tok":[["["],["10"],["]"],["しかし"],["主","しゅ"],["よ"],["、"],["わたし"],["を"],["あわれみ"],["、"],["わたし"],["を"],["助け起こして","たすけおこして"],["ください"],["。"],["そう"],["すれば"],["わたし"],["は"],["彼","かれ"],["ら"],["に"],["報い","むくい"],["返えす","かえす"],["こと"],["が"],["できます"],["。"]]},{"verse":12,"text":"[11]わたしの敵,てきがわたしに打,うち勝,かてないことによって、あなたがわたしを喜,よろこばれることをわたしは知,しります。","tok":[["["],["11"],["]"],["わたし"],["の"],["敵","てき"],["が"],["わたし"],["に"],["打ち勝てない","うちかてない"],["こと"],["によって"],["、"],["あなた"],["が"],["わたし"],["を"],["喜こばれる","よろこばれる"],["こと"],["を"],["わたし"],["は"],["知ります","しります"],["。"]]},{"verse":13,"text":"[12]あなたはわたしの全,まったきによって、わたしをささえ、とこしえにみ前,まえに置,おかれます。","tok":[["["],["12"],["]"],["あなた"],["は"],["わたし"],["の"],["全","まったき"],["によって"],["、"],["わたし"],["を"],["ささえ"],["、"],["とこしえ"],["に"],["み前","みまえ"],["に"],["置かれます","おかれます"],["。"]]},{"verse":14,"text":"[13]イスラエルの神,かみ、主,しゅはとこしえからとこしえまでほむべきかな。アァメン、アァメン。","tok":[["["],["13"],["]"],["イスラエル"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["とこしえ"],["から"],["とこしえ"],["まで"],["ほ"],["むべき"],["か"],["な"],["。"],["アァメン"],["、"],["アァメン"],["。"]]}]
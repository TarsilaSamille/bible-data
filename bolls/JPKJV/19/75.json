[{"verse":1,"text":"[0]【聖歌,せいか隊,たいの指揮者,しきしゃによって、「滅,ほろぼすな」というしらべにあわせてうたわせたアサフの歌,うた、さんび】","tok":[["["],["0"],["]"],["【"],["聖歌隊","せいかたい"],["の"],["指揮者","しきしゃ"],["によって"],["、"],["「"],["滅ぼす","ほろぼす"],["な"],["」"],["と"],["いう"],["しらべ"],["に"],["あわせて"],["うたわせた"],["アサフ"],["の"],["歌","うた"],["、"],["さん"],["び"],["】"]]},{"verse":2,"text":"[1]神,かみよ、われらはあなたに感謝,かんしゃします。われらは感謝,かんしゃします。われらはあなたのみ名,なを呼,よび、あなたのくすしきみわざを語,かたります。","tok":[["["],["1"],["]"],["神","かみ"],["よ"],["、"],["われ"],["ら"],["は"],["あなた"],["に"],["感謝","かんしゃ"],["します"],["。"],["われ"],["ら"],["は"],["感謝","かんしゃ"],["します"],["。"],["われ"],["ら"],["は"],["あなた"],["のみ"],["名","な"],["を"],["呼び","よび"],["、"],["あなた"],["の"],["くす"],["しきみ"],["わざ"],["を"],["語ります","かたります"],["。"]]},{"verse":3,"text":"[2]定,さだまった時,ときが来,くれば、わたしは公平,こうへいをもってさばく。","tok":[["["],["2"],["]"],["定まった","さだまった"],["時","とき"],["が"],["来れば","くれば"],["、"],["わたし"],["は"],["公平","こうへい"],["を"],["もって"],["さばく"],["。"]]},{"verse":4,"text":"[3]地,ちとすべてこれに住,すむものがよろめくとき、わたしはその柱,はしらを堅,かたくする。〔セラ","tok":[["["],["3"],["]"],["地","ち"],["と"],["すべて"],["これ"],["に"],["住む","すむ"],["もの"],["が"],["よろめく"],["とき"],["、"],["わたし"],["は"],["その"],["柱","はしら"],["を"],["堅く","かたく"],["する"],["。"],["〔"],["セラ"]]},{"verse":5,"text":"[4]わたしは、誇,ほこる者,ものには「誇,ほこるな」と言,いい、悪,あしき者,ものには「角,つのをあげるな、","tok":[["["],["4"],["]"],["わたし"],["は"],["、"],["誇る","ほこる"],["者","もの"],["に"],["は"],["「"],["誇る","ほこる"],["な"],["」"],["と"],["言い","いい"],["、"],["悪しき","あしき"],["者","もの"],["に"],["は"],["「"],["角","つ"],["の"],["を"],["あげる"],["な"],["、"]]},{"verse":6,"text":"[5]角,つのを高,たかくあげるな、高慢,こうまんな態度,たいどをもって語,かたるな」と言,いう。","tok":[["["],["5"],["]"],["角","つ"],["の"],["を"],["高かく","たかく"],["あげる"],["な"],["、"],["高慢","こうまん"],["な"],["態度","たいど"],["を"],["もって"],["語る","かたる"],["な"],["」"],["と"],["言う","いう"],["。"]]},{"verse":7,"text":"[6]上,あげることは東,ひがしからでなく、西,にしからでなく、また荒野,あらのからでもない。","tok":[["["],["6"],["]"],["上げる","あげる"],["こと"],["は"],["東","ひがし"],["から"],["で"],["なく"],["、"],["西","にし"],["から"],["で"],["なく"],["、"],["また"],["荒野","あら"],["の"],["から"],["で"],["も"],["ない"],["。"]]},{"verse":8,"text":"[7]それはさばきを行,おこなわれる神,かみであって、神,かみはこれを下,さげ、かれを上,あげられる。","tok":[["["],["7"],["]"],["それ"],["は"],["さばき"],["を"],["行なわれる","おこなわれる"],["神","かみ"],["で"],["あって"],["、"],["神","かみ"],["は"],["これ"],["を"],["下げ","さげ"],["、"],["かれ"],["を"],["上げられる","あげられる"],["。"]]},{"verse":9,"text":"[8]主,しゅの手,てには杯,さかずきがあって、よく混,まぜた酒,さけがあわだっている。主,しゅがこれを注,そそぎ出,だされると、地,ちのすべての悪,あしき者,ものはこれを一滴,いってきも残,のこさずに飲,のみつくすであろう。","tok":[["["],["8"],["]"],["主","しゅ"],["の"],["手","て"],["に"],["は"],["杯","さかずき"],["が"],["あって"],["、"],["よく"],["混ぜた","まぜた"],["酒","さけ"],["が"],["あわだって"],["いる"],["。"],["主","しゅがこれ"],["を"],["注ぎ","そそぎ"],["出される","だされる"],["と"],["、"],["地","ち"],["の"],["すべて"],["の"],["悪しき","あしき"],["者","もの"],["は"],["これ"],["を"],["一滴","いってき"],["も"],["残さず","のこさず"],["に"],["飲み","のみ"],["つくすで"],["あろう"],["。"]]},{"verse":10,"text":"[9]しかしわたしはとこしえに喜,よろこび、ヤコブの神,かみをほめうたいます。","tok":[["["],["9"],["]"],["しかし"],["わたし"],["は"],["とこしえ"],["に"],["喜こび","よろこび"],["、"],["ヤコブ"],["の"],["神","かみ"],["を"],["ほめ"],["うたいます"],["。"]]},{"verse":11,"text":"[10]悪,あしき者,ものの角,つのはことごとく切,きり離,はなされるが正,ただしい者,ものの角,つのはあげられるであろう。","tok":[["["],["10"],["]"],["悪しき","あしき"],["者","もの"],["の"],["角","つ"],["の"],["は"],["ことごとく"],["切り離される","きりはなされる"],["が"],["正い","ただしい"],["者","もの"],["の"],["角","つ"],["の"],["は"],["あげられるで"],["あろう"],["。"]]}]
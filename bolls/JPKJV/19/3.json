[{"verse":1,"text":"[0]【ダビデがその子,こアブサロムを避,さけてのがれたときの歌,うた】","tok":[["["],["0"],["]"],["【"],["ダビデ"],["が"],["その"],["子","こ"],["アブサロム"],["を"],["避けて","さけて"],["のがれた"],["とき"],["の"],["歌","うた"],["】"]]},{"verse":2,"text":"[1]主,しゅよ、わたしに敵,てきする者,もののいかに多,おおいことでしょう。わたしに逆,さからって立,たつ者,ものが多,おおく、","tok":[["["],["1"],["]"],["主","しゅ"],["よ"],["、"],["わたし"],["に"],["敵する","てきする"],["者","もの"],["の"],["いかに"],["多い","おおい"],["こと"],["でしょう"],["。"],["わたし"],["に"],["逆らって","さからって"],["立つ","たつ"],["者","もの"],["が"],["多く","おおく"],["、"]]},{"verse":3,"text":"[2]「彼,かれには神,かみの助,たすけがない」と、わたしについて言,いう者,ものが多,おおいのです。〔セラ","tok":[["["],["2"],["]"],["「"],["彼","かれ"],["に"],["は"],["神","かみ"],["の"],["助け","たすけ"],["が"],["ない"],["」"],["と"],["、"],["わたし"],["について"],["言う","いう"],["者","もの"],["が"],["多い","おおい"],["の"],["です"],["。"],["〔"],["セラ"]]},{"verse":4,"text":"[3]しかし主,しゅよ、あなたはわたしを囲,かこむ盾,たて、わが栄,さかえ、わたしの頭,あたまを、もたげてくださるかたです。","tok":[["["],["3"],["]"],["しかし"],["主","しゅ"],["よ"],["、"],["あなた"],["は"],["わたし"],["を"],["囲む","かこむ"],["盾","たて"],["、"],["わが"],["栄","さかえ"],["、"],["わたし"],["の"],["頭","あたま"],["を"],["、"],["もたげて"],["くださる"],["かた"],["です"],["。"]]},{"verse":5,"text":"[4]わたしが声,こえをあげて主,しゅを呼,よばわると、主,しゅは聖,せいなる山,やまからわたしに答,こたえられる。〔セラ","tok":[["["],["4"],["]"],["わたし"],["が"],["声","こえ"],["を"],["あげて"],["主","しゅ"],["を"],["呼ばわる","よばわる"],["と"],["、"],["主","しゅ"],["は"],["聖","せい"],["なる"],["山","やま"],["から"],["わたし"],["に"],["答","こたえ"],["られる"],["。"],["〔"],["セラ"]]},{"verse":6,"text":"[5]わたしはふして眠,ねむり、また目,めをさます。主,しゅがわたしをささえられるからだ。","tok":[["["],["5"],["]"],["わたし"],["は"],["ふして"],["眠","ねむり"],["、"],["また"],["目","め"],["を"],["さます"],["。"],["主","しゅ"],["が"],["わたし"],["を"],["ささえられる"],["から"],["だ"],["。"]]},{"verse":7,"text":"[6]わたしを囲,かこんで立,たち構,かまえるちよろずの民,たみをもわたしは恐,おそれない。","tok":[["["],["6"],["]"],["わたし"],["を"],["囲んで","かこんで"],["立ち","たち"],["構","かまえ"],["る"],["ち"],["よろず"],["の"],["民","たみ"],["を"],["も"],["わたし"],["は"],["恐れない","おそれない"],["。"]]},{"verse":8,"text":"[7]主,しゅよ、お立,たちください。わが神,かみよ、わたしをお救,すくいください。あなたはわたしのすべての敵,てきのほおを打,うち、悪,あしき者,ものの歯,はを折,おられるのです。","tok":[["["],["7"],["]"],["主","しゅ"],["よ"],["、"],["お立","おたち"],["ください"],["。"],["わが"],["神","かみ"],["よ"],["、"],["わたし"],["を"],["お救い","おすくい"],["ください"],["。"],["あなた"],["は"],["わたし"],["の"],["すべて"],["の"],["敵","てき"],["の"],["ほお"],["を"],["打ち","うち"],["、"],["悪しき","あしき"],["者","もの"],["の"],["歯","は"],["を"],["折られる","おられる"],["の"],["です"],["。"]]},{"verse":9,"text":"[8]救,すくいは主,しゅのものです。どうかあなたの祝福,しゅくふくがあなたの民,たみの上,うえにありますように。〔セラ","tok":[["["],["8"],["]"],["救い","すくい"],["は"],["主","しゅ"],["の"],["もの"],["です"],["。"],["どう"],["か"],["あなた"],["の"],["祝福","しゅくふく"],["が"],["あなた"],["の"],["民","たみ"],["の"],["上","うえ"],["に"],["あります"],["よう"],["に"],["。"],["〔"],["セラ"]]}]
[{"verse":1,"text":"【ダビデの歌,うた】主,しゅよ、わたしはあなたにむかって呼,よばわります。わが岩,いわよ、わたしにむかって耳,みみしいとならないでください。もしあなたが黙,だまっておられるならば、おそらく、わたしは墓,はかに下,くだる者,ものと等,ひとしくなるでしょう。","tok":[["【"],["ダビデ"],["の"],["歌","うた"],["】"],["主","しゅ"],["よ"],["、"],["わたし"],["は"],["あなた"],["に"],["むかって"],["呼ばわります","よばわります"],["。"],["わが"],["岩","いわ"],["よ"],["、"],["わたし"],["に"],["むかって"],["耳","みみ"],["しい"],["と"],["ならないで"],["ください"],["。"],["もし"],["あなた"],["が"],["黙って","だまって"],["おられるならば"],["、"],["おそらく"],["、"],["わたし"],["は"],["墓","はか"],["に"],["下る","くだる"],["者","もの"],["と"],["等く","ひとしく"],["なるでしょう"],["。"]]},{"verse":2,"text":"わたしがあなたにむかって助,たすけを求,もとめ、あなたの至聖所,しせいじょにむかって手,てをあげるとき、わたしの願,ねがいの声,こえを聞,きいてください。","tok":[["わたし"],["が"],["あなた"],["に"],["むかって"],["助け","たすけ"],["を"],["求め","もとめ"],["、"],["あなた"],["の"],["至聖所","しせいじょ"],["に"],["むかって"],["手","て"],["を"],["あげる"],["とき"],["、"],["わたし"],["の"],["願い","ねがい"],["の"],["声","こえ"],["を"],["聞いて","きいて"],["ください"],["。"]]},{"verse":3,"text":"悪,あしき者,ものおよび悪,あくを行,おこなう者,ものらと共,ともにわたしを引,ひき行,いかないでください。彼,かれらはその隣,となり人,びととむつまじく語,かたるけれども、その心,こころには害悪,がいあくをいだく者,ものです。","tok":[["悪しき","あしき"],["者","もの"],["および"],["悪","あく"],["を"],["行なう","おこなう"],["者","もの"],["ら"],["と"],["共","とも"],["に"],["わたし"],["を"],["引","ひき"],["行かないで","いかないで"],["ください"],["。"],["彼","かれ"],["ら"],["は"],["その"],["隣人","となりび"],["と"],["と"],["むつまじく"],["語る","かたる"],["けれど"],["も"],["、"],["その"],["心","こころ"],["に"],["は"],["害悪","がいあく"],["を"],["いだく"],["者","もの"],["です"],["。"]]},{"verse":4,"text":"どうぞ、そのわざにしたがい、その悪,あしき行,おこないにしたがって彼,かれらに報,むくい、その手,てのわざにしたがって彼,かれらに報,むくい、その受,うくべき罰,ばつを彼,かれらに与,あたえてください。","tok":[["どうぞ"],["、"],["その"],["わざ"],["に"],["したがい"],["、"],["その"],["悪しき","あしき"],["行ない","おこない"],["に"],["したがって"],["彼","かれ"],["ら"],["に"],["報い","むくい"],["、"],["その"],["手","て"],["の"],["わざ"],["に"],["したがって"],["彼","かれ"],["ら"],["に"],["報い","むくい"],["、"],["その"],["受","う"],["くべき"],["罰","ばつ"],["を"],["彼","かれ"],["ら"],["に"],["与","あたえ"],["て"],["ください"],["。"]]},{"verse":5,"text":"彼,かれらは主,しゅのもろもろのみわざと、み手,てのわざとを顧,かえりみないゆえに、主,しゅは彼,かれらを倒,たおして、再,ふたたび建,たてられることはない。","tok":[["彼","かれ"],["ら"],["は"],["主","しゅ"],["の"],["もろもろ"],["のみ"],["わざと"],["、"],["み手","みて"],["の"],["わざと"],["を"],["顧ない","かえりみない"],["ゆえ"],["に"],["、"],["主","しゅ"],["は"],["彼","かれ"],["ら"],["を"],["倒して","たおして"],["、"],["再び","ふたたび"],["建てられる","たてられる"],["こと"],["は"],["ない"],["。"]]},{"verse":6,"text":"主,しゅはほむべきかな。主,しゅはわたしの願,ねがいの声,こえを聞,きかれた。","tok":[["主","しゅ"],["は"],["ほ"],["むべき"],["か"],["な"],["。"],["主","しゅ"],["は"],["わたし"],["の"],["願い","ねがい"],["の"],["声","こえ"],["を"],["聞かれた","きかれた"],["。"]]},{"verse":7,"text":"主,しゅはわが力,ちから、わが盾,たて。わたしの心,こころは主,しゅに寄,より頼,たのむ。わたしは助,たすけを得,えたので、わたしの心,こころは大,おおいに喜,よろこび、歌,うたをもって主,しゅをほめたたえる。","tok":[["主","しゅ"],["は"],["わが"],["力","ちから"],["、"],["わが"],["盾","たて"],["。"],["わたし"],["の"],["心","こころ"],["は"],["主","しゅ"],["に"],["寄り","より"],["頼む","たのむ"],["。"],["わたし"],["は"],["助け","たすけ"],["を"],["得た","えた"],["ので"],["、"],["わたし"],["の"],["心","こころ"],["は"],["大いに","おおいに"],["喜こび","よろこび"],["、"],["歌","うた"],["を"],["もって"],["主","しゅ"],["を"],["ほめたたえる"],["。"]]},{"verse":8,"text":"主,しゅはその民,たみの力,ちから、その油,あぶらそそがれた者,ものの救,すくいのとりでである。","tok":[["主","しゅ"],["は"],["その"],["民","たみ"],["の"],["力","ちから"],["、"],["その"],["油","あぶら"],["そそがれた"],["者","もの"],["の"],["救い","すくい"],["の"],["とりで"],["で"],["ある"],["。"]]},{"verse":9,"text":"どうぞ、あなたの民,たみを救,すくい、あなたの嗣,し業,ぎょうを恵,めぐみ、彼,かれらの牧者,ぼくしゃとなって、とこしえに彼,かれらをいだき導,みちびいてください。","tok":[["どうぞ"],["、"],["あなた"],["の"],["民","たみ"],["を"],["救い","すくい"],["、"],["あなた"],["の"],["嗣業","しぎょう"],["を"],["恵み","めぐみ"],["、"],["彼","かれ"],["ら"],["の"],["牧者","ぼくしゃ"],["と"],["なって"],["、"],["とこしえ"],["に"],["彼","かれ"],["ら"],["を"],["いだき"],["導いて","みちびいて"],["ください"],["。"]]}]
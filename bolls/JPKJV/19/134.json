[{"verse":1,"text":"【都,みやこもうでの歌,うた】見,みよ、夜,よる、主,しゅの家,いえに立,たって主,しゅに仕,つかえるすべてのしもべよ、主,しゅをほめよ。","tok":[["【"],["都","みやこもう"],["で"],["の"],["歌","うた"],["】"],["見よ","みよ"],["、"],["夜","よる"],["、"],["主","しゅ"],["の"],["家","いえ"],["に"],["立って","たって"],["主に","しゅに"],["仕える","つかえる"],["すべて"],["の"],["しもべ"],["よ"],["、"],["主","しゅ"],["を"],["ほめよ"],["。"]]},{"verse":2,"text":"聖所,せいじょにむかってあなたがたの手,てをあげ、主,しゅをほめよ。","tok":[["聖","せい"],["所","しょ"],["に"],["むかって"],["あなた"],["がた"],["の"],["手","て"],["を"],["あげ"],["、"],["主","しゅ"],["を"],["ほめよ"],["。"]]},{"verse":3,"text":"どうぞ主,しゅ、天,てんと地,ちを造,つくられた者,もの、シオンからあなたを祝福,しゅくふくされるように。","tok":[["どうぞ"],["主","しゅ"],["、"],["天","てん"],["と"],["地","ち"],["を"],["造られた","つくられた"],["者","もの"],["、"],["シオン"],["から"],["あなた"],["を"],["祝福","しゅくふく"],["される"],["よう"],["に"],["。"]]}]
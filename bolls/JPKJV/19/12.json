[{"verse":1,"text":"[0]【聖歌,せいか隊,たいの指揮者,しきしゃによってシェミニテにあわせてうたわせたダビデの歌,うた】","tok":[["["],["0"],["]"],["【"],["聖歌隊","せいかたい"],["の"],["指揮者","しきしゃ"],["によって"],["シェミニテ"],["に"],["あわせて"],["うたわせた"],["ダビデ"],["の"],["歌","うた"],["】"]]},{"verse":2,"text":"[1]主,しゅよ、お助,たすけください。神,かみを敬,うやまう人,ひとは絶,たえ、忠信,ちゅうしんな者,ものは人,ひとの子,こらのなかから消,きえうせました。","tok":[["["],["1"],["]"],["主","しゅ"],["よ"],["、"],["お助け","おたすけ"],["ください"],["。"],["神","かみ"],["を"],["敬う","うやまう"],["人","ひと"],["は"],["絶え","たえ"],["、"],["忠信","ちゅうしん"],["な"],["者","もの"],["は"],["人","ひと"],["の"],["子","こ"],["ら"],["の"],["なか"],["から"],["消えうせました","きえうせました"],["。"]]},{"verse":3,"text":"[2]人,ひとはみなその隣,となり人,びとに偽,いつわりを語,かたり、へつらいのくちびると、ふたごころとをもって語,かたる。","tok":[["["],["2"],["]"],["人","ひと"],["は"],["みな"],["その"],["隣人","となりびと"],["に"],["偽り","いつわり"],["を"],["語り","かたり"],["、"],["へつらい"],["の"],["くちびる"],["と"],["、"],["ふたご"],["ころ"],["と"],["を"],["もって"],["語る","かたる"],["。"]]},{"verse":4,"text":"[3]主,しゅはすべてのへつらいのくちびると、大,おおきな事,ことを語,かたる舌,したとを断,たたれるように。","tok":[["["],["3"],["]"],["主","しゅ"],["は"],["すべて"],["の"],["へつらい"],["の"],["くちびる"],["と"],["、"],["大きな","おおきな"],["事","こと"],["を"],["語る","かたる"],["舌","した"],["と"],["を"],["断たれる","たたれる"],["よう"],["に"],["。"]]},{"verse":5,"text":"[4]彼,かれらは言,いう、「わたしたちは舌,したをもって勝,かちを得,えよう、わたしたちのくちびるはわたしたちのものだ、だれがわたしたちの主人,しゅじんであるか」と。","tok":[["["],["4"],["]"],["彼","かれ"],["ら"],["は"],["言う","いう"],["、"],["「"],["わたしたち"],["は"],["舌","した"],["を"],["もって"],["勝","かち"],["を"],["得よう","えよう"],["、"],["わたしたち"],["の"],["くちびる"],["は"],["わたしたち"],["の"],["もの"],["だ"],["、"],["だれ"],["が"],["わたしたち"],["の"],["主人","しゅじん"],["で"],["ある"],["か"],["」"],["と"],["。"]]},{"verse":6,"text":"[5]主,しゅは言,いわれる、「貧,まずしい者,ものがかすめられ、乏,とぼしい者,ものが嘆,なげくゆえに、わたしはいま立,たちあがって、彼,かれらをその慕,したい求,もとめる安全,あんぜんな所,ところに置,おこう」と。","tok":[["["],["5"],["]"],["主","しゅ"],["は"],["言われる","いわれる"],["、"],["「"],["貧しい","まずしい"],["者","もの"],["が"],["かすめられ"],["、"],["乏い","とぼしい"],["者","もの"],["が"],["嘆く","なげく"],["ゆえ"],["に"],["、"],["わたし"],["は"],["いま"],["立ちあがって","たちあがって"],["、"],["彼","かれ"],["ら"],["を"],["その"],["慕い求める","したいもとめる"],["安全","あんぜん"],["な"],["所","ところ"],["に"],["置こう","おこう"],["」"],["と"],["。"]]},{"verse":7,"text":"[6]主,しゅのことばは清,きよき言葉,ことばである。地,ちに設,もうけた炉,ろで練,ねり、七たびきよめた銀,ぎんのようである。","tok":[["["],["6"],["]"],["主","しゅ"],["の"],["ことば"],["は"],["清","き"],["よき"],["言葉","ことば"],["で"],["ある"],["。"],["地","ち"],["に"],["設けた","もうけた"],["炉","ろ"],["で"],["練り","ねり"],["、"],["七","なな"],["たび"],["きよめた"],["銀","ぎん"],["の"],["よう"],["で"],["ある"],["。"]]},{"verse":8,"text":"[7]主,しゅよ、われらを保,たもち、とこしえにこの人々,ひとびとから免,まぬかれさせてください。","tok":[["["],["7"],["]"],["主","しゅ"],["よ"],["、"],["われ"],["ら"],["を"],["保ち","たもち"],["、"],["とこしえ"],["に"],["この"],["人々","ひとびと"],["から"],["免かれさせて","まぬかれさせて"],["ください"],["。"]]},{"verse":9,"text":"[8]卑,いやしい事,ことが人,ひとの子,このなかにあがめられている時,とき、悪,あしき者,ものはいたる所,ところでほしいままに歩,あるいています。","tok":[["["],["8"],["]"],["卑しい","いやしい"],["事","こと"],["が"],["人","ひと"],["の"],["子","こ"],["の"],["なか"],["に"],["あがめられて"],["いる"],["時","とき"],["、"],["悪しき","あしき"],["者","もの"],["は"],["いたる"],["所","ところ"],["で"],["ほしいまま"],["に"],["歩いて","あるいて"],["います"],["。"]]}]
[{"verse":1,"text":"【ダビデの歌,うた】主,しゅよ、わたしはあなたに呼,よばわります。すみやかにわたしをお助,たすけください。わたしがあなたに呼,よばわるとき、わが声,こえに耳,みみを傾,かたむけてください。","tok":[["【"],["ダビデ"],["の"],["歌","うた"],["】"],["主","しゅ"],["よ"],["、"],["わたし"],["は"],["あなた"],["に"],["呼ばわります","よばわります"],["。"],["すみやか"],["に"],["わたし"],["を"],["お助け","おたすけ"],["ください"],["。"],["わたし"],["が"],["あなた"],["に"],["呼ばわる","よばわる"],["とき"],["、"],["わが"],["声","こえ"],["に"],["耳","みみ"],["を"],["傾むけて","かたむけて"],["ください"],["。"]]},{"verse":2,"text":"わたしの祈,いのりを、み前,まえにささげる薫香,くんこうのようにみなし、わたしのあげる手,てを、夕,ゆうべの供,そなえ物,もののようにみなしてください。","tok":[["わたし"],["の"],["祈","いのり"],["を"],["、"],["み前","みまえ"],["に"],["ささげる"],["薫香","くんこう"],["の"],["よう"],["に"],["みなし"],["、"],["わたし"],["の"],["あげる"],["手","て"],["を"],["、"],["夕べ","ゆうべ"],["の"],["供え物","そなえもの"],["の"],["よう"],["に"],["みなして"],["ください"],["。"]]},{"verse":3,"text":"主,しゅよ、わが口,くちに門守,かどもりを置,おいて、わがくちびるの戸,とを守,まもってください。","tok":[["主","しゅ"],["よ"],["、"],["わが"],["口","くち"],["に"],["門守","かどもり"],["を"],["置いて","おいて"],["、"],["わが"],["くちびる"],["の"],["戸","と"],["を"],["守って","まもって"],["ください"],["。"]]},{"verse":4,"text":"悪,あしき事,ことにわが心,こころを傾,かたむけさせず、不義,ふぎを行,おこなう人々,ひとびとと共,ともに悪,あしきわざにあずからせないでください。また彼,かれらのうまき物,ものを食,たべさせないでください。","tok":[["悪しき","あしき"],["事","こと"],["に"],["わが"],["心","こころ"],["を"],["傾むけさせず","かたむけさせず"],["、"],["不義","ふぎ"],["を"],["行なう","おこなう"],["人々","ひとびと"],["と"],["共","とも"],["に"],["悪しき","あしき"],["わざ"],["に"],["あずからせないで"],["ください"],["。"],["また"],["彼","かれ"],["ら"],["の"],["うまき"],["物","もの"],["を"],["食べさせないで","たべさせないで"],["ください"],["。"]]},{"verse":5,"text":"正,ただしい者,ものにいつくしみをもってわたしを打,うたせ、わたしを責,せめさせてください。しかし悪,あしき者,ものの油,あぶらをわがこうべにそそがせないでください。わが祈,いのりは絶,たえず彼,かれらの悪,あしきわざに敵,てきしているからです。","tok":[["正い","ただしい"],["者","もの"],["に"],["いつくしみ"],["を"],["もって"],["わたし"],["を"],["打たせ","うたせ"],["、"],["わたし"],["を"],["責","せめ"],["させて"],["ください"],["。"],["しかし"],["悪しき","あしき"],["者","もの"],["の"],["油","あぶら"],["を"],["わが"],["こうべ"],["に"],["そそがせないで"],["ください"],["。"],["わが"],["祈","いのり"],["は"],["絶えず","たえず"],["彼","かれ"],["ら"],["の"],["悪しき","あしき"],["わざ"],["に"],["敵して","てきして"],["いる"],["から"],["です"],["。"]]},{"verse":6,"text":"彼,かれらはおのれを罪,つみに定,さだめる者,ものにわたされるとき、主,しゅのみ言葉,ことばのまことなることを学,まなぶでしょう。","tok":[["彼","かれ"],["ら"],["は"],["おのれ"],["を"],["罪","つみ"],["に"],["定める","さだめる"],["者","もの"],["に"],["わたされる"],["とき"],["、"],["主","しゅ"],["のみ"],["言葉","ことば"],["の"],["まこと"],["なる"],["こと"],["を"],["学ぶでしょう","まなぶでしょう"],["。"]]},{"verse":7,"text":"人,ひとが岩,いわを裂,さいて地,ちの上,うえに打,うち砕,くだくように、彼,かれらの骨,ほねは陰府,よみの口,くちにまき散,ちらされるでしょう。","tok":[["人","ひと"],["が"],["岩","いわ"],["を"],["裂いて","さいて"],["地","ち"],["の"],["上","うえ"],["に"],["打ち砕く","うちくだく"],["よう"],["に"],["、"],["彼","かれ"],["ら"],["の"],["骨","ほね"],["は"],["陰府","よみ"],["の"],["口","くち"],["に"],["まき散らされるでしょう","まきちらされるでしょう"],["。"]]},{"verse":8,"text":"しかし主,しゅなる神,かみよ、わが目,めはあなたに向,むかっています。わたしはあなたに寄,より頼,たのみます。わたしを助,たすけるものもないままに捨,すておかないでください。","tok":[["しかし"],["主","しゅ"],["なる"],["神","かみ"],["よ"],["、"],["わが"],["目","め"],["は"],["あなた"],["に"],["向かって","むかって"],["います"],["。"],["わたし"],["は"],["あなた"],["に"],["寄り","より"],["頼みます","たのみます"],["。"],["わたし"],["を"],["助ける","たすける"],["もの"],["も"],["ない"],["まま"],["に"],["捨ておかないで","すておかないで"],["ください"],["。"]]},{"verse":9,"text":"わたしを守,まもって、彼,かれらがわたしのために設,もうけたわなと、悪,あくを行,おこなう者,もののわなとをのがれさせてください。","tok":[["わたし"],["を"],["守って","まもって"],["、"],["彼","かれ"],["ら"],["が"],["わたし"],["の"],["ため"],["に"],["設けた","もうけた"],["わ"],["な"],["と"],["、"],["悪","あく"],["を"],["行なう","おこなう"],["者","もの"],["の"],["わな"],["と"],["を"],["のがれさせて"],["ください"],["。"]]},{"verse":10,"text":"わたしがのがれると同時,どうじに、悪,あしき者,ものをおのれの網,あみに陥,おちいらせてください。","tok":[["わたし"],["が"],["のがれる"],["と"],["同時","どうじ"],["に"],["、"],["悪しき","あしき"],["者","もの"],["を"],["おのれ"],["の"],["網","あみ"],["に"],["陥ち","おち"],["いらせて"],["ください"],["。"]]}]
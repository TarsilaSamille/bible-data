[{"verse":1,"text":"[0]【聖歌,せいか隊,たいの指揮者,しきしゃによって、「遠,とおき所,ところにおる音,おとをたてぬはと」のしらべにあわせてうたわせたダビデのミクタムの歌,うた。これはダビデがガテでペリシテびとに捕,とらえられたときによんだもの】","tok":[["["],["0"],["]"],["【"],["聖歌隊","せいかたい"],["の"],["指揮者","しきしゃ"],["によって"],["、"],["「"],["遠き","とおき"],["所","ところ"],["に"],["おる"],["音","おと"],["を"],["たてぬ"],["はと"],["」"],["の"],["しらべ"],["に"],["あわせて"],["うたわせた"],["ダビデ"],["の"],["ミクタム"],["の"],["歌","うた"],["。"],["これ"],["は"],["ダビデ"],["が"],["ガテ"],["で"],["ペリシテ"],["びと"],["に"],["捕らえられた","とらえられた"],["とき"],["に"],["よんだ"],["もの"],["】"]]},{"verse":2,"text":"[1]神,かみよ、どうかわたしをあわれんでください。人々,ひとびとがわたしを踏,ふみつけ、あだする人々,ひとびとがひねもすわたしをしえたげます。","tok":[["["],["1"],["]"],["神","かみ"],["よ"],["、"],["どう"],["か"],["わたし"],["を"],["あわれんで"],["ください"],["。"],["人々","ひとびと"],["が"],["わたし"],["を"],["踏みつけ","ふみつけ"],["、"],["あだ"],["する"],["人々","ひとびと"],["が"],["ひねもす"],["わたし"],["を"],["し"],["えたげます"],["。"]]},{"verse":3,"text":"[2]わたしの敵,てきはひねもすわたしを踏,ふみつけ、誇,ほこりたかぶって、わたしと戦,たたかう者,ものが多,おおいのです。","tok":[["["],["2"],["]"],["わたし"],["の"],["敵","てき"],["は"],["ひねもす"],["わたし"],["を"],["踏みつけ","ふみつけ"],["、"],["誇","ほこり"],["たかぶって"],["、"],["わたし"],["と"],["戦う","たたかう"],["者","もの"],["が"],["多い","おおい"],["の"],["です"],["。"]]},{"verse":4,"text":"[3]わたしが恐,おそれるときは、あなたに寄,より頼,たのみます。","tok":[["["],["3"],["]"],["わたし"],["が"],["恐れる","おそれる"],["とき"],["は"],["、"],["あなた"],["に"],["寄り","より"],["頼みます","たのみます"],["。"]]},{"verse":5,"text":"[4]わたしは神,かみによって、そのみ言葉,ことばをほめたたえます。わたしは神,かみに信頼,しんらいするゆえ、恐,おそれることはありません。肉,にくなる者,ものはわたしに何,なにをなし得,えましょうか。","tok":[["["],["4"],["]"],["わたし"],["は"],["神","かみ"],["によって"],["、"],["その"],["み言葉","みことば"],["を"],["ほめたたえます"],["。"],["わたし"],["は"],["神","かみ"],["に"],["信頼","しんらい"],["する"],["ゆえ"],["、"],["恐れる","おそれる"],["こと"],["は"],["ありません"],["。"],["肉","にく"],["なる"],["者","もの"],["は"],["わたし"],["に"],["何に","なに"],["を"],["なし"],["得ましょう","えましょう"],["か"],["。"]]},{"verse":6,"text":"[5]彼,かれらはひねもすわたしの事,ことを妨害,ぼうがいし、その思,おもいはことごとくわたしにわざわいします。","tok":[["["],["5"],["]"],["彼","かれ"],["ら"],["は"],["ひねもす"],["わたし"],["の"],["事","こと"],["を"],["妨害","ぼうがい"],["し"],["、"],["その"],["思い","おもい"],["は"],["ことごとく"],["わたし"],["に"],["わざわい"],["します"],["。"]]},{"verse":7,"text":"[6]彼,かれらは共,ともに集,あつまって身,みをひそめ、わたしの歩,あゆみに目,めをとめ、わたしのいのちをうかがい求,もとめます。","tok":[["["],["6"],["]"],["彼","かれ"],["ら"],["は"],["共","とも"],["に"],["集まって","あつまって"],["身","み"],["を"],["ひそめ"],["、"],["わたし"],["の"],["歩み","あゆみ"],["に"],["目","め"],["を"],["とめ"],["、"],["わたし"],["の"],["いのち"],["を"],["うかがい"],["求めます","もとめます"],["。"]]},{"verse":8,"text":"[7]神,かみよ、彼,かれらにその罪,つみを報,むくい、憤,いきどおりをもってもろもろの民,たみを倒,たおしてください。","tok":[["["],["7"],["]"],["神","かみ"],["よ"],["、"],["彼","かれ"],["ら"],["に"],["その"],["罪","つみ"],["を"],["報い","むくい"],["、"],["憤り","いきどおり"],["を"],["もって"],["もろもろ"],["の"],["民","たみ"],["を"],["倒して","たおして"],["ください"],["。"]]},{"verse":9,"text":"[8]あなたはわたしのさすらいを数,かぞえられました。わたしの涙,なみだをあなたの皮,かわ袋,ぶくろにたくわえてください。これは皆,みなあなたの書,しょにしるされているではありませんか。","tok":[["["],["8"],["]"],["あなた"],["は"],["わたし"],["の"],["さすらい"],["を"],["数えられました","かぞえられました"],["。"],["わたし"],["の"],["涙","なみだ"],["を"],["あなた"],["の"],["皮袋","かわぶくろ"],["に"],["たくわえて"],["ください"],["。"],["これ"],["は"],["皆","みな"],["あなた"],["の"],["書","しょ"],["に"],["しるされて"],["いるで"],["は"],["ありません"],["か"],["。"]]},{"verse":10,"text":"[9]わたしが呼,よび求,もとめる日,ひに、わたしの敵,てきは退,しりぞきます。これによって神,かみがわたしを守,まもられることを知,しります。","tok":[["["],["9"],["]"],["わたし"],["が"],["呼び求める","よびもとめる"],["日","ひ"],["に"],["、"],["わたし"],["の"],["敵","てき"],["は"],["退ぞきます","しりぞきます"],["。"],["これ"],["によって"],["神","かみ"],["が"],["わたし"],["を"],["守られる","まもられる"],["こと"],["を"],["知ります","しります"],["。"]]},{"verse":11,"text":"[10]わたしは神,かみによってそのみ言葉,ことばをほめたたえ、主,しゅによってそのみ言葉,ことばをほめたたえます。","tok":[["["],["10"],["]"],["わたし"],["は"],["神","かみ"],["によって"],["その"],["み言葉","みことば"],["を"],["ほめたたえ"],["、"],["主に","しゅに"],["よって"],["その"],["み言葉","みことば"],["を"],["ほめたたえます"],["。"]]},{"verse":12,"text":"[11]わたしは神,かみに信頼,しんらいするゆえ、恐,おそれることはありません。人,ひとはわたしに何,なにをなし得,えましょうか。","tok":[["["],["11"],["]"],["わたし"],["は"],["神","かみ"],["に"],["信頼","しんらい"],["する"],["ゆえ"],["、"],["恐れる","おそれる"],["こと"],["は"],["ありません"],["。"],["人","ひと"],["は"],["わたし"],["に"],["何に","なに"],["を"],["なし"],["得ましょう","えましょう"],["か"],["。"]]},{"verse":13,"text":"[12]神,かみよ、わたしがあなたに立,たてた誓,ちかいは果,はたさなければなりません。わたしは感謝,かんしゃの供,そなえ物,ものをあなたにささげます。","tok":[["["],["12"],["]"],["神","かみ"],["よ"],["、"],["わたし"],["が"],["あなた"],["に"],["立てた","たてた"],["誓い","ちかい"],["は"],["果たさなければ","はたさなければ"],["なりません"],["。"],["わたし"],["は"],["感謝","かんしゃ"],["の"],["供え物","そなえもの"],["を"],["あなた"],["に"],["ささげます"],["。"]]},{"verse":14,"text":"[13]あなたはわたしの魂,たましいを死,しから救,すくい、わたしの足,あしを守,まもって倒,たおれることなく、いのちの光,ひかりのうちで神,かみの前,まえにわたしを歩,あゆませられたからです。","tok":[["["],["13"],["]"],["あなた"],["は"],["わたし"],["の"],["魂","たましい"],["を"],["死","し"],["から"],["救い","すくい"],["、"],["わたし"],["の"],["足","あし"],["を"],["守って","まもって"],["倒れる","たおれる"],["こと"],["なく"],["、"],["いのち"],["の"],["光","ひかり"],["の"],["うち"],["で"],["神","かみ"],["の"],["前","まえ"],["に"],["わたし"],["を"],["歩ませられた","あゆませられた"],["から"],["です"],["。"]]}]
[{"verse":1,"text":"[0]【記念,きねんのためにうたったダビデの歌,うた】","tok":[["["],["0"],["]"],["【"],["記念","きねん"],["の"],["ため"],["に"],["うたった"],["ダビデ"],["の"],["歌","うた"],["】"]]},{"verse":2,"text":"[1]主,しゅよ、あなたの憤,いきどおりをもってわたしを責,せめず、激,はげしい怒,いかりをもってわたしを懲,こらさないでください。","tok":[["["],["1"],["]"],["主","しゅ"],["よ"],["、"],["あなた"],["の"],["憤り","いきどおり"],["を"],["もって"],["わたし"],["を"],["責","せめ"],["ず"],["、"],["激しい","はげしい"],["怒り","いかり"],["を"],["もって"],["わたし"],["を"],["懲らさないで","こらさないで"],["ください"],["。"]]},{"verse":3,"text":"[2]あなたの矢,やがわたしに突,つき刺,ささり、あなたの手,てがわたしの上,うえにくだりました。","tok":[["["],["2"],["]"],["あなた"],["の"],["矢","や"],["が"],["わたし"],["に"],["突き刺さり","つきささり"],["、"],["あなた"],["の"],["手","て"],["が"],["わたし"],["の"],["上","うえ"],["に"],["くだりました"],["。"]]},{"verse":4,"text":"[3]あなたの怒,いかりによって、わたしの肉,にくには全,まったきところなく、わたしの罪,つみによって、わたしの骨,ほねには健,すこやかなところはありません。","tok":[["["],["3"],["]"],["あなた"],["の"],["怒り","いかり"],["によって"],["、"],["わたし"],["の"],["肉","にく"],["に"],["は"],["全","ま"],["っ"],["たき"],["ところ"],["なく"],["、"],["わたし"],["の"],["罪","つみ"],["によって"],["、"],["わたし"],["の"],["骨","ほね"],["に"],["は"],["健やか","すこやか"],["な"],["ところ"],["は"],["ありません"],["。"]]},{"verse":5,"text":"[4]わたしの不義,ふぎはわたしの頭,あたまを越,こえ、重荷,おもにのように重,おもくて負,おうことができません。","tok":[["["],["4"],["]"],["わたし"],["の"],["不義","ふぎ"],["は"],["わたし"],["の"],["頭","あたま"],["を"],["越え","こえ"],["、"],["重荷","おもに"],["の"],["よう"],["に"],["重くて","おもくて"],["負う","おう"],["こと"],["が"],["できません"],["。"]]},{"verse":6,"text":"[5]わたしの愚,おろかによって、わたしの傷,きずは悪臭,あくしゅうを放,はなち、腐,くされただれました。","tok":[["["],["5"],["]"],["わたし"],["の"],["愚か","おろか"],["によって"],["、"],["わたし"],["の"],["傷","きず"],["は"],["悪臭","あくしゅう"],["を"],["放ち","はなち"],["、"],["腐れ","くされ"],["ただれました"],["。"]]},{"verse":7,"text":"[6]わたしは折,おれかがんで、いたくうなだれ、ひねもす悲,かなしんで歩,あるくのです。","tok":[["["],["6"],["]"],["わたし"],["は"],["折れ","おれ"],["かがんで"],["、"],["いたく"],["うなだれ"],["、"],["ひねもす"],["悲しんで","かなしんで"],["歩く","あるく"],["の"],["です"],["。"]]},{"verse":8,"text":"[7]わたしの腰,こしはことごとく焼,やけ、わたしの肉,にくには全,まったきところがありません。","tok":[["["],["7"],["]"],["わたし"],["の"],["腰","こし"],["は"],["ことごとく"],["焼け","やけ"],["、"],["わたし"],["の"],["肉","にく"],["に"],["は"],["全","ま"],["っ"],["たき"],["ところ"],["が"],["ありません"],["。"]]},{"verse":9,"text":"[8]わたしは衰,おとろえはて、いたく打,うちひしがれ、わたしの心,こころの激,はげしい騒,さわぎによってうめき叫,さけびます。","tok":[["["],["8"],["]"],["わたし"],["は"],["衰え","おとろえ"],["はて"],["、"],["いたく"],["打ちひしがれ","うちひしがれ"],["、"],["わたし"],["の"],["心","こころ"],["の"],["激しい","はげしい"],["騒","さわぎ"],["によって"],["うめき"],["叫","さけび"],["ます"],["。"]]},{"verse":10,"text":"[9]主,しゅよ、わたしのすべての願,ねがいはあなたに知,しられ、わたしの嘆,なげきはあなたに隠,かくれることはありません。","tok":[["["],["9"],["]"],["主","しゅ"],["よ"],["、"],["わたし"],["の"],["すべて"],["の"],["願い","ねがい"],["は"],["あなた"],["に"],["知られ","しられ"],["、"],["わたし"],["の"],["嘆き","なげき"],["は"],["あなた"],["に"],["隠れる","かくれる"],["こと"],["は"],["ありません"],["。"]]},{"verse":11,"text":"[10]わたしの胸,むねは激,はげしく打,うち、わたしの力,ちからは衰,おとろえ、わたしの目,めの光,ひかりもまた、わたしを離,はなれ去,さりました。","tok":[["["],["10"],["]"],["わたし"],["の"],["胸","むね"],["は"],["激しく","はげしく"],["打ち","うち"],["、"],["わたし"],["の"],["力","ちから"],["は"],["衰え","おとろえ"],["、"],["わたし"],["の"],["目","め"],["の"],["光","ひかり"],["も"],["また"],["、"],["わたし"],["を"],["離れ去りました","はなれさりました"],["。"]]},{"verse":12,"text":"[11]わが友,とも、わがともがらはわたしの災,わざわいを見,みて離,はなれて立,たち、わが親族,しんぞくもまた遠,とおく離,はなれて立,たっています。","tok":[["["],["11"],["]"],["わが"],["友","とも"],["、"],["わが"],["とも"],["がら"],["は"],["わたし"],["の"],["災","わざわい"],["を"],["見て","みて"],["離れて","はなれて"],["立ち","たち"],["、"],["わが"],["親族","しんぞく"],["も"],["また"],["遠く","とおく"],["離れて","はなれて"],["立って","たって"],["います"],["。"]]},{"verse":13,"text":"[12]わたしのいのちを求,もとめる者,ものはわなを設,もうけ、わたしをそこなおうとする者,ものは滅,ほろぼすことを語,かたり、ひねもす欺,あざむくことをはかるのです。","tok":[["["],["12"],["]"],["わたし"],["の"],["いのち"],["を"],["求める","もとめる"],["者","もの"],["は"],["わな"],["を"],["設け","もうけ"],["、"],["わたし"],["を"],["そこなおう"],["と"],["する"],["者","もの"],["は"],["滅ぼす","ほろぼす"],["こと"],["を"],["語り","かたり"],["、"],["ひねもす"],["欺く","あざむく"],["こと"],["を"],["はかる"],["の"],["です"],["。"]]},{"verse":14,"text":"[13]しかしわたしは耳,みみしいのように聞,きかず、おしのように口,くちを開,ひらきません。","tok":[["["],["13"],["]"],["しかし"],["わたし"],["は"],["耳","みみ"],["しい"],["の"],["よう"],["に"],["聞かず","きかず"],["、"],["おし"],["の"],["よう"],["に"],["口","くち"],["を"],["開らきません","ひらきません"],["。"]]},{"verse":15,"text":"[14]まことに、わたしは聞,きかない人,ひとのごとく、議論,ぎろんを口,くちにしない人,ひとのようです。","tok":[["["],["14"],["]"],["まこと"],["に"],["、"],["わたし"],["は"],["聞かない","きかない"],["人","ひと"],["の"],["ごとく"],["、"],["議論","ぎろん"],["を"],["口","くち"],["に"],["しない"],["人","ひと"],["の"],["よう"],["です"],["。"]]},{"verse":16,"text":"[15]しかし、主,しゅよ、わたしはあなたを待,まち望,のぞみます。わが神,かみ、主,しゅよ、あなたこそわたしに答,こたえられるのです。","tok":[["["],["15"],["]"],["しかし"],["、"],["主","しゅ"],["よ"],["、"],["わたし"],["は"],["あなた"],["を"],["待ち望みます","まちのぞみます"],["。"],["わが"],["神","かみ"],["、"],["主","しゅ"],["よ"],["、"],["あなた"],["こそ"],["わたし"],["に"],["答","こたえ"],["られる"],["の"],["です"],["。"]]},{"verse":17,"text":"[16]わたしは祈,いのります、「わが足,あしのすべるとき、わたしにむかって高,たかぶる彼,かれらにわたしのことによって喜,よろこぶことをゆるさないでください」と。","tok":[["["],["16"],["]"],["わたし"],["は"],["祈","いのり"],["ます"],["、"],["「"],["わが"],["足","あし"],["の"],["すべる"],["とき"],["、"],["わたし"],["に"],["むかって"],["高か","たか"],["ぶる"],["彼","かれ"],["ら"],["に"],["わたし"],["の"],["こと"],["によって"],["喜こぶ","よろこぶ"],["こと"],["を"],["ゆるさないで"],["ください"],["」"],["と"],["。"]]},{"verse":18,"text":"[17]わたしは倒,たおれるばかりになり、わたしの苦,くるしみは常,つねにわたしと共,ともにあります。","tok":[["["],["17"],["]"],["わたし"],["は"],["倒れる","たおれる"],["ばかり"],["に"],["なり"],["、"],["わたし"],["の"],["苦しみ","くるしみ"],["は"],["常","つね"],["に"],["わたし"],["と"],["共","とも"],["に"],["あります"],["。"]]},{"verse":19,"text":"[18]わたしは、みずから不義,ふぎを言,いいあらわし、わが罪,つみのために悲,かなしみます。","tok":[["["],["18"],["]"],["わたし"],["は"],["、"],["みずから"],["不義","ふぎ"],["を"],["言いあらわし","いいあらわし"],["、"],["わが"],["罪","つみ"],["の"],["ため"],["に"],["悲しみます","かなしみます"],["。"]]},{"verse":20,"text":"[19]ゆえなく、わたしに敵,てきする者,ものは強,つよく、偽,いつわってわたしを憎,にくむ者,ものは多,おおいのです。","tok":[["["],["19"],["]"],["ゆえ"],["なく"],["、"],["わたし"],["に"],["敵する","てきする"],["者","もの"],["は"],["強く","つよく"],["、"],["偽わって","いつわって"],["わたし"],["を"],["憎む","にくむ"],["者","もの"],["は"],["多い","おおい"],["の"],["です"],["。"]]},{"verse":21,"text":"[20]悪,あくをもって善,ぜんに報,むくいる者,ものは、わたしがよい事,ことに従,したがうがゆえに、わがあだとなります。","tok":[["["],["20"],["]"],["悪","あく"],["を"],["もって"],["善","ぜん"],["に"],["報いる","むくいる"],["者","もの"],["は"],["、"],["わたし"],["が"],["よい"],["事","こと"],["に"],["従う","したがう"],["が"],["ゆえ"],["に"],["、"],["わが"],["あだ"],["と"],["なります"],["。"]]},{"verse":22,"text":"[21]主,しゅよ、わたしを捨,すてないでください。わが神,かみよ、わたしに遠,とおざからないでください。","tok":[["["],["21"],["]"],["主","しゅ"],["よ"],["、"],["わたし"],["を"],["捨てないで","すてないで"],["ください"],["。"],["わが"],["神","かみ"],["よ"],["、"],["わたし"],["に"],["遠ざからないで","とおざからないで"],["ください"],["。"]]},{"verse":23,"text":"[22]主,しゅ、わが救,すくいよ、すみやかにわたしをお助,たすけください。","tok":[["["],["22"],["]"],["主","しゅ"],["、"],["わが"],["救い","すくい"],["よ"],["、"],["すみやか"],["に"],["わたし"],["を"],["お助け","おたすけ"],["ください"],["。"]]}]
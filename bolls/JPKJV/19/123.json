[{"verse":1,"text":"【都,みやこもうでの歌,うた】天,てんに座,ざしておられる者,ものよ、わたしはあなたにむかって目,めをあげます。","tok":[["【"],["都","みやこもう"],["で"],["の"],["歌","うた"],["】"],["天","てん"],["に"],["座して","ざして"],["おられる"],["者","もの"],["よ"],["、"],["わたし"],["は"],["あなた"],["に"],["むかって"],["目","め"],["を"],["あげます"],["。"]]},{"verse":2,"text":"見,みよ、しもべがその主人,しゅじんの手,てに目,めをそそぎ、はしためがその主婦,しゅふの手,てに目,めをそそぐように、われらはわれらの神,かみ、主,しゅに目,めをそそいで、われらをあわれまれるのを待,まちます。","tok":[["見よ","みよ"],["、"],["しもべ"],["が"],["その"],["主人","しゅじん"],["の"],["手","て"],["に"],["目","め"],["を"],["そそぎ"],["、"],["はし"],["ため"],["が"],["その"],["主婦","しゅふ"],["の"],["手","て"],["に"],["目","め"],["を"],["そそぐ"],["よう"],["に"],["、"],["われ"],["ら"],["は"],["われ"],["ら"],["の"],["神","かみ"],["、"],["主に","しゅに"],["目","め"],["を"],["そそいで"],["、"],["われ"],["ら"],["を"],["あわれまれる"],["の"],["を"],["待ちます","まちます"],["。"]]},{"verse":3,"text":"主,しゅよ、われらをあわれんでください。われらをあわれんでください。われらに侮,あなどりが満,みちあふれています。","tok":[["主","しゅ"],["よ"],["、"],["われ"],["ら"],["を"],["あわれんで"],["ください"],["。"],["われ"],["ら"],["を"],["あわれんで"],["ください"],["。"],["われ"],["ら"],["に"],["侮","あなどり"],["が"],["満ちあふれて","みちあふれて"],["います"],["。"]]},{"verse":4,"text":"思,おもい煩,わずらいのない者,もののあざけりと、高,たかぶる者,ものの侮,あなどりとは、われらの魂,たましいに満,みちあふれています。","tok":[["思い煩い","おもいわずらい"],["の"],["ない"],["者","もの"],["の"],["あざけり"],["と"],["、"],["高か","たか"],["ぶる"],["者","もの"],["の"],["侮","あなどり"],["と"],["は"],["、"],["われ"],["ら"],["の"],["魂","たましい"],["に"],["満ちあふれて","みちあふれて"],["います"],["。"]]}]
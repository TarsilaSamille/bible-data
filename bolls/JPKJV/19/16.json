[{"verse":1,"text":"【ダビデのミクタムの歌,うた】神,かみよ、わたしをお守,まもりください。わたしはあなたに寄,より頼,たのみます。","tok":[["【"],["ダビデ"],["の"],["ミクタム"],["の"],["歌","うた"],["】"],["神","かみ"],["よ"],["、"],["わたし"],["を"],["お守り","おまもり"],["ください"],["。"],["わたし"],["は"],["あなた"],["に"],["寄り","より"],["頼みます","たのみます"],["。"]]},{"verse":2,"text":"わたしは主,しゅに言,いう、「あなたはわたしの主,しゅ、あなたのほかにわたしの幸,さいわいはない」と。","tok":[["わたし"],["は"],["主に","しゅに"],["言う","いう"],["、"],["「"],["あなた"],["は"],["わたし"],["の"],["主","しゅ"],["、"],["あなた"],["の"],["ほか"],["に"],["わたし"],["の"],["幸い","さいわい"],["は"],["ない"],["」"],["と"],["。"]]},{"verse":3,"text":"地,ちにある聖徒,せいとは、すべてわたしの喜,よろこぶすぐれた人々,ひとびとである。","tok":[["地","ち"],["に"],["ある"],["聖徒","せいと"],["は"],["、"],["すべて"],["わたし"],["の"],["喜こぶ","よろこぶ"],["すぐれた"],["人々","ひとびと"],["で"],["ある"],["。"]]},{"verse":4,"text":"おおよそ、ほかの神,かみを選,えらぶ者,ものは悲,かなしみを増,ます。わたしは彼,かれらのささげる血,ちの灌祭,かんさいを注,そそがず、その名,なを口,くちにとなえることをしない。","tok":[["おおよそ"],["、"],["ほか"],["の"],["神","かみ"],["を"],["選ぶ","えらぶ"],["者","もの"],["は"],["悲しみ","かなしみ"],["を"],["増す","ます"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["ささげる"],["血","ち"],["の"],["灌祭","かんさい"],["を"],["注がず","そそがず"],["、"],["その"],["名","な"],["を"],["口","くち"],["に"],["となえる"],["こと"],["を"],["しない"],["。"]]},{"verse":5,"text":"主,しゅはわたしの嗣,し業,ぎょう、またわたしの杯,さかずきにうくべきもの。あなたはわたしの分,わけ前,まえを守,まもられる。","tok":[["主","しゅ"],["は"],["わたし"],["の"],["嗣業","しぎょ"],["う"],["、"],["また"],["わたし"],["の"],["杯","さかずき"],["に"],["うくべき"],["もの"],["。"],["あなた"],["は"],["わたし"],["の"],["分け前","わけまえ"],["を"],["守られる","まもられる"],["。"]]},{"verse":6,"text":"測,はかりなわは、わたしのために好,このましい所,ところに落,おちた。まことにわたしは良,よい嗣,し業,ぎょうを得,えた。","tok":[["測り","はかり"],["なわ"],["は"],["、"],["わたし"],["の"],["ため"],["に"],["好しい","このましい"],["所","ところ"],["に"],["落","おち"],["た"],["。"],["まこと"],["に"],["わたし"],["は"],["良い","よい"],["嗣業","しぎょう"],["を"],["得た","えた"],["。"]]},{"verse":7,"text":"わたしにさとしをさずけられる主,しゅをほめまつる。夜,よるはまた、わたしの心,こころがわたしを教,おしえる。","tok":[["わたし"],["に"],["さとし"],["を"],["さずけられる"],["主","しゅ"],["を"],["ほめ"],["まつる"],["。"],["夜","よる"],["は"],["また"],["、"],["わたし"],["の"],["心","こころ"],["が"],["わたし"],["を"],["教える","おしえる"],["。"]]},{"verse":8,"text":"わたしは常,つねに主,しゅをわたしの前,まえに置,おく。主,しゅがわたしの右,みぎにいますゆえ、わたしは動,うごかされることはない。","tok":[["わたし"],["は"],["常","つね"],["に"],["主","しゅ"],["を"],["わたし"],["の"],["前","まえ"],["に"],["置く","おく"],["。"],["主","しゅ"],["が"],["わたし"],["の"],["右","みぎ"],["に"],["います"],["ゆえ"],["、"],["わたし"],["は"],["動かされる","うごかされる"],["こと"],["は"],["ない"],["。"]]},{"verse":9,"text":"このゆえに、わたしの心,こころは楽,たのしみ、わたしの魂,たましいは喜,よろこぶ。わたしの身,みもまた安,やすらかである。","tok":[["この"],["ゆえ"],["に"],["、"],["わたし"],["の"],["心","こころ"],["は"],["楽み","たのしみ"],["、"],["わたし"],["の"],["魂","たましい"],["は"],["喜こぶ","よろこぶ"],["。"],["わたし"],["の"],["身","み"],["も"],["また"],["安らか","やすらか"],["で"],["ある"],["。"]]},{"verse":10,"text":"あなたはわたしを陰府,よみに捨,すておかれず、あなたの聖者,せいじゃに墓,はかを見,みさせられないからである。","tok":[["あなた"],["は"],["わたし"],["を"],["陰府","よみ"],["に"],["捨ておかれず","すておかれず"],["、"],["あなた"],["の"],["聖者","せいじゃ"],["に"],["墓","はか"],["を"],["見させられない","みさせられない"],["から"],["で"],["ある"],["。"]]},{"verse":11,"text":"あなたはいのちの道,みちをわたしに示,しめされる。あなたの前,まえには満,みちあふれる喜,よろこびがあり、あなたの右,みぎには、とこしえにもろもろの楽,たのしみがある。","tok":[["あなた"],["は"],["いのち"],["の"],["道","みち"],["を"],["わたし"],["に"],["示めされる","しめされる"],["。"],["あなた"],["の"],["前","まえ"],["に"],["は"],["満ちあふれる","みちあふれる"],["喜こび","よろこび"],["が"],["あり"],["、"],["あなた"],["の"],["右","みぎ"],["に"],["は"],["、"],["とこしえ"],["に"],["もろもろ"],["の"],["楽み","たのしみ"],["が"],["ある"],["。"]]}]
[{"verse":1,"text":"[0]【聖歌,せいか隊,たいの指揮者,しきしゃによってうたわせた主,しゅのしもべダビデの歌,うた】","tok":[["["],["0"],["]"],["【"],["聖歌隊","せいかたい"],["の"],["指揮者","しきしゃ"],["によって"],["うたわせた"],["主","しゅ"],["の"],["しもべ"],["ダビデ"],["の"],["歌","うた"],["】"]]},{"verse":2,"text":"[1]とがは悪,あしき者,ものにむかい、その心,こころのうちに言,いう。その目,めの前,まえに神,かみを恐,おそれる恐,おそれはない。","tok":[["["],["1"],["]"],["と"],["が"],["は"],["悪しき","あしき"],["者","もの"],["に"],["むかい"],["、"],["その"],["心","こころ"],["の"],["うち"],["に"],["言う","いう"],["。"],["その"],["目","め"],["の"],["前","まえ"],["に"],["神","かみ"],["を"],["恐れる","おそれる"],["恐","おそれ"],["は"],["ない"],["。"]]},{"verse":3,"text":"[2]彼,かれは自分,じぶんの不義,ふぎがあらわされないため、また憎,にくまれないために、みずからその目,めでおもねる。","tok":[["["],["2"],["]"],["彼","かれ"],["は"],["自分","じぶん"],["の"],["不義","ふぎ"],["が"],["あらわされない"],["ため"],["、"],["また"],["憎まれない","にくまれない"],["ため"],["に"],["、"],["みずから"],["その"],["目","め"],["で"],["おもねる"],["。"]]},{"verse":4,"text":"[3]その口,くちの言葉,ことばはよこしまと欺,あざむきである。彼,かれは知恵,ちえを得,えることと、善,ぜんを行,おこなう事,こととをやめた。","tok":[["["],["3"],["]"],["その"],["口","くち"],["の"],["言葉","ことば"],["は"],["よこしま"],["と"],["欺きで","あざむきで"],["ある"],["。"],["彼","かれ"],["は"],["知恵","ちえ"],["を"],["得る","える"],["こと"],["と"],["、"],["善","ぜん"],["を"],["行なう","おこなう"],["事","こと"],["と"],["を"],["やめた"],["。"]]},{"verse":5,"text":"[4]彼,かれはその床,とこの上,うえでよこしまな事,ことをたくらみ、よからぬ道,みちに身,みをおいて、悪,あくをきらわない。","tok":[["["],["4"],["]"],["彼","かれ"],["は"],["その"],["床","とこ"],["の"],["上","うえ"],["で"],["よこしま"],["な"],["事","こと"],["を"],["たくらみ"],["、"],["よからぬ"],["道","みち"],["に"],["身","み"],["を"],["おいて"],["、"],["悪","あく"],["を"],["きらわない"],["。"]]},{"verse":6,"text":"[5]主,しゅよ、あなたのいつくしみは天,てんにまで及,および、あなたのまことは雲,くもにまで及,およぶ。","tok":[["["],["5"],["]"],["主","しゅ"],["よ"],["、"],["あなた"],["の"],["いつくしみ"],["は"],["天","てん"],["に"],["まで"],["及","および"],["、"],["あなた"],["の"],["まこと"],["は"],["雲","くも"],["に"],["まで"],["及ぶ","およぶ"],["。"]]},{"verse":7,"text":"[6]あなたの義,ぎは神,かみの山,やまのごとく、あなたのさばきは大,おおきな淵,ふちのようだ。主,しゅよ、あなたは人,ひとと獣,けものとを救,すくわれる。","tok":[["["],["6"],["]"],["あなた"],["の"],["義","ぎ"],["は"],["神","かみ"],["の"],["山","やま"],["の"],["ごとく"],["、"],["あなた"],["の"],["さばき"],["は"],["大きな","おおきな"],["淵","ふち"],["の"],["よう"],["だ"],["。"],["主","しゅ"],["よ"],["、"],["あなた"],["は"],["人","ひと"],["と"],["獣","けもの"],["と"],["を"],["救われる","すくわれる"],["。"]]},{"verse":8,"text":"[7]神,かみよ、あなたのいつくしみはいかに尊,たっといことでしょう。人,ひとの子,こらはあなたの翼,つばさのかげに避,さけ所,どころを得,え、","tok":[["["],["7"],["]"],["神","かみ"],["よ"],["、"],["あなた"],["の"],["いつくしみ"],["は"],["いかに"],["尊","た"],["っと"],["いこ"],["と"],["でしょう"],["。"],["人","ひと"],["の"],["子","こ"],["ら"],["は"],["あなた"],["の"],["翼","つばさ"],["の"],["かげ"],["に"],["避け","さけ"],["所","どころ"],["を"],["得","え"],["、"]]},{"verse":9,"text":"[8]あなたの家,いえの豊,ゆたかなのによって飽,あき足,たりる。あなたはその楽,たのしみの川,かわの水,みずを彼,かれらに飲,のませられる。","tok":[["["],["8"],["]"],["あなた"],["の"],["家","いえ"],["の"],["豊","ゆたか"],["な"],["のに"],["よって"],["飽き足りる","あきたりる"],["。"],["あなた"],["は"],["その"],["楽み","たのしみ"],["の"],["川","かわ"],["の"],["水","みず"],["を"],["彼","かれ"],["ら"],["に"],["飲ませられる","のませられる"],["。"]]},{"verse":10,"text":"[9]いのちの泉,いずみはあなたのもとにあり、われらはあなたの光,ひかりによって光,ひかりを見,みる。","tok":[["["],["9"],["]"],["いのち"],["の"],["泉","いずみ"],["は"],["あなた"],["の"],["もと"],["に"],["あり"],["、"],["われ"],["ら"],["は"],["あなた"],["の"],["光","ひかり"],["によって"],["光","ひかり"],["を"],["見る","みる"],["。"]]},{"verse":11,"text":"[10]どうか、あなたを知,しる者,ものに絶,たえずいつくしみを施,ほどこし、心,こころの直,なおき者,ものに絶,たえず救,すくいを施,ほどこしてください。","tok":[["["],["10"],["]"],["どう"],["か"],["、"],["あなた"],["を"],["知る","しる"],["者","もの"],["に"],["絶えず","たえず"],["いつくしみ"],["を"],["施し","ほどこし"],["、"],["心","こころ"],["の"],["直","な"],["おき"],["者","もの"],["に"],["絶えず","たえず"],["救い","すくい"],["を"],["施して","ほどこして"],["ください"],["。"]]},{"verse":12,"text":"[11]高,たかぶる者,ものの足,あしがわたしを踏,ふみ、悪,あしき者,ものの手,てがわたしを追,おい出,だすことをゆるさないでください。","tok":[["["],["11"],["]"],["高か","たか"],["ぶる"],["者","もの"],["の"],["足","あし"],["が"],["わたし"],["を"],["踏み","ふみ"],["、"],["悪しき","あしき"],["者","もの"],["の"],["手","て"],["が"],["わたし"],["を"],["追い出す","おいだす"],["こと"],["を"],["ゆるさないで"],["ください"],["。"]]},{"verse":13,"text":"[12]悪,あくを行,おこなう者,ものはそこに倒,たおれ、彼,かれらは打,うち伏,ふせられて、起,おきあがることはできない。","tok":[["["],["12"],["]"],["悪","あく"],["を"],["行なう","おこなう"],["者","もの"],["は"],["そこ"],["に"],["倒れ","たおれ"],["、"],["彼","かれ"],["ら"],["は"],["打ち伏せられて","うちふせられて"],["、"],["起きあがる","おきあがる"],["こと"],["は"],["できない"],["。"]]}]
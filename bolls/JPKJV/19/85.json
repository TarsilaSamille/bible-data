[{"verse":1,"text":"[0]【聖歌,せいか隊,たいの指揮者,しきしゃによってうたわせたコラの子,この歌,うた】","tok":[["["],["0"],["]"],["【"],["聖歌隊","せいかたい"],["の"],["指揮者","しきしゃ"],["によって"],["うたわせた"],["コラ"],["の"],["子","こ"],["の"],["歌","うた"],["】"]]},{"verse":2,"text":"[1]主,しゅよ、あなたはみ国,くににめぐみを示,しめし、ヤコブの繁栄,はんえいを回復,かいふくされました。","tok":[["["],["1"],["]"],["主","しゅ"],["よ"],["、"],["あなた"],["は"],["み国","みくに"],["に"],["めぐみ"],["を"],["示めし","しめし"],["、"],["ヤコブ"],["の"],["繁栄","はんえい"],["を"],["回復","かいふく"],["されました"],["。"]]},{"verse":3,"text":"[2]あなたはその民,たみの不義,ふぎをゆるし、彼,かれらの罪,つみをことごとくおおわれました。〔セラ","tok":[["["],["2"],["]"],["あなた"],["は"],["その"],["民","たみ"],["の"],["不義","ふぎ"],["を"],["ゆるし"],["、"],["彼","かれ"],["ら"],["の"],["罪","つみ"],["を"],["ことごとく"],["おおわれました"],["。"],["〔"],["セラ"]]},{"verse":4,"text":"[3]あなたはすべての怒,いかりを捨,すて、激,はげしい憤,いきどおりを遠,とおざけられました。","tok":[["["],["3"],["]"],["あなた"],["は"],["すべて"],["の"],["怒り","いかり"],["を"],["捨て","すて"],["、"],["激しい","はげしい"],["憤り","いきどおり"],["を"],["遠ざけられました","とおざけられました"],["。"]]},{"verse":5,"text":"[4]われらの救,すくいの神,かみよ、われらを回復,かいふくし、われらに対,たいするあなたの憤,いきどおりをおやめください。","tok":[["["],["4"],["]"],["われ"],["ら"],["の"],["救い","すくい"],["の"],["神","かみ"],["よ"],["、"],["われ"],["ら"],["を"],["回復","かいふく"],["し"],["、"],["われ"],["ら"],["に"],["対する","たいする"],["あなた"],["の"],["憤り","いきどおり"],["を"],["おやめ"],["ください"],["。"]]},{"verse":6,"text":"[5]あなたはとこしえにわれらを怒,いかり、よろずよまで、あなたの怒,いかりを延,のばされるのですか。","tok":[["["],["5"],["]"],["あなた"],["は"],["とこしえ"],["に"],["われ"],["ら"],["を"],["怒り","いかり"],["、"],["よろず"],["よ"],["まで"],["、"],["あなた"],["の"],["怒り","いかり"],["を"],["延ばされる","のばされる"],["の"],["です"],["か"],["。"]]},{"verse":7,"text":"[6]あなたの民,たみが、あなたによって喜,よろこびを得,えるため、われらを再,ふたたび生,いかされないのですか。","tok":[["["],["6"],["]"],["あなた"],["の"],["民","たみ"],["が"],["、"],["あなた"],["によって"],["喜こび","よろこび"],["を"],["得る","える"],["ため"],["、"],["われ"],["ら"],["を"],["再び","ふたたび"],["生かされない","いかされない"],["の"],["です"],["か"],["。"]]},{"verse":8,"text":"[7]主,しゅよ、あなたのいつくしみをわれらに示,しめし、あなたの救,すくいをわれらに与,あたえてください。","tok":[["["],["7"],["]"],["主","しゅ"],["よ"],["、"],["あなた"],["の"],["いつくしみ"],["を"],["われ"],["ら"],["に"],["示めし","しめし"],["、"],["あなた"],["の"],["救い","すくい"],["を"],["われ"],["ら"],["に"],["与","あたえ"],["て"],["ください"],["。"]]},{"verse":9,"text":"[8]わたしは主,しゅなる神,かみの語,かたられることを聞,ききましょう。主,しゅはその民,たみ、その聖徒,せいと、ならびにその心,こころを主,しゅに向,むける者,ものに、平和,へいわを語,かたられるからです。","tok":[["["],["8"],["]"],["わたし"],["は"],["主","しゅ"],["なる"],["神","かみ"],["の"],["語られる","かたられる"],["こと"],["を"],["聞","きき"],["ましょう"],["。"],["主","しゅ"],["は"],["その"],["民","た"],["み"],["、"],["その"],["聖徒","せいと"],["、"],["ならびに"],["その"],["心","こころ"],["を"],["主に","しゅに"],["向ける","むける"],["者","もの"],["に"],["、"],["平和","へいわ"],["を"],["語られる","かたられる"],["から"],["です"],["。"]]},{"verse":10,"text":"[9]まことに、その救,すくいは神,かみを恐,おそれる者,ものに近,ちかく、その栄光,えいこうはわれらの国,くににとどまるでしょう。","tok":[["["],["9"],["]"],["まこと"],["に"],["、"],["その"],["救い","すくい"],["は"],["神","かみ"],["を"],["恐れる","おそれる"],["者","もの"],["に"],["近く","ちかく"],["、"],["その"],["栄光","えいこう"],["は"],["われ"],["ら"],["の"],["国","くに"],["に"],["とどまるでしょう"],["。"]]},{"verse":11,"text":"[10]いつくしみと、まこととは共,ともに会,あい、義,ぎと平和,へいわとは互,たがいに口,くちづけし、","tok":[["["],["10"],["]"],["いつくしみ"],["と"],["、"],["まこと"],["と"],["は"],["共","とも"],["に"],["会い","あい"],["、"],["義","ぎ"],["と"],["平和","へいわ"],["と"],["は"],["互","たがい"],["に"],["口づけ","くちづけ"],["し"],["、"]]},{"verse":12,"text":"[11]まことは地,ちからはえ、義,ぎは天,てんから見,みおろすでしょう。","tok":[["["],["11"],["]"],["まこと"],["は"],["地","ち"],["から"],["はえ"],["、"],["義","ぎ"],["は"],["天","てん"],["から"],["見おろすでしょう","みおろすでしょう"],["。"]]},{"verse":13,"text":"[12]主,しゅが良,よい物,ものを与,あたえられるので、われらの国,くにはその産物,さんぶつを出,だし、","tok":[["["],["12"],["]"],["主","しゅ"],["が"],["良い","よい"],["物","もの"],["を"],["与えられる","あたえられる"],["ので"],["、"],["われ"],["ら"],["の"],["国","くに"],["は"],["その"],["産物","さんぶつ"],["を"],["出し","だし"],["、"]]},{"verse":14,"text":"[13]義,ぎは主,しゅのみ前,まえに行,いき、その足跡,あしあとを道,みちとするでしょう。","tok":[["["],["13"],["]"],["義","ぎ"],["は"],["主","しゅ"],["のみ"],["前","まえ"],["に"],["行き","いき"],["、"],["その"],["足跡","あしあと"],["を"],["道","みち"],["と"],["するでしょう"],["。"]]}]
[{"verse":1,"text":"主,しゅをほめたたえよ。もろもろの天,てんから主,しゅをほめたたえよ。もろもろの高,たかき所,ところで主,しゅをほめたたえよ。","tok":[["主","しゅ"],["を"],["ほめたたえ"],["よ"],["。"],["もろもろ"],["の"],["天","てん"],["から"],["主","しゅ"],["を"],["ほめたたえ"],["よ"],["。"],["もろもろ"],["の"],["高き","たかき"],["所","ところ"],["で"],["主","しゅ"],["を"],["ほめたたえ"],["よ"],["。"]]},{"verse":2,"text":"その天使,てんしよ、みな主,しゅをほめたたえよ。その万軍,ばんぐんよ、みな主,しゅをほめたたえよ。","tok":[["その"],["天使","てんし"],["よ"],["、"],["みな"],["主","しゅ"],["を"],["ほめたたえ"],["よ"],["。"],["その"],["万","まん"],["軍","ぐん"],["ぐ"],["ん"],["よ"],["、"],["みな"],["主","しゅ"],["を"],["ほめたたえ"],["よ"],["。"]]},{"verse":3,"text":"日,ひよ、月,つきよ、主,しゅをほめたたえよ。輝,かがやく星,ほしよ、みな主,しゅをほめたたえよ。","tok":[["日","ひ"],["よ"],["、"],["月","つき"],["よ"],["、"],["主","しゅ"],["を"],["ほめたたえ"],["よ"],["。"],["輝やく","かがやく"],["星","ほし"],["よ"],["、"],["みな"],["主","しゅ"],["を"],["ほめたたえ"],["よ"],["。"]]},{"verse":4,"text":"いと高,たかき天,てんよ、天,てんの上,うえにある水,みずよ、主,しゅをほめたたえよ。","tok":[["いと"],["高き","たかき"],["天","てん"],["よ"],["、"],["天","てん"],["の"],["上","うえ"],["に"],["ある"],["水","みず"],["よ"],["、"],["主","しゅ"],["を"],["ほめたたえ"],["よ"],["。"]]},{"verse":5,"text":"これらのものに主,しゅのみ名,なをほめたたえさせよ、これらは主,しゅが命,めいじられると造,つくられたからである。","tok":[["これ"],["ら"],["の"],["もの"],["に"],["主","しゅ"],["のみ"],["名","な"],["を"],["ほめたたえさせよ"],["、"],["これ"],["ら"],["は"],["主","しゅ"],["が"],["命じられる","めいじられる"],["と"],["造られた","つくられた"],["から"],["で"],["ある"],["。"]]},{"verse":6,"text":"主,しゅはこれらをとこしえに堅,かたく定,さだめ、越,こえることのできないその境,さかいを定,さだめられた。","tok":[["主","しゅ"],["は"],["これ"],["ら"],["を"],["とこしえ"],["に"],["堅く","かたく"],["定め","さだめ"],["、"],["越える","こえる"],["こと"],["の"],["できない"],["その"],["境","さかい"],["を"],["定められた","さだめられた"],["。"]]},{"verse":7,"text":"海,うみの獣,けものよ、すべての淵,ふちよ、地,ちから主,しゅをほめたたえよ。","tok":[["海","うみ"],["の"],["獣","けもの"],["よ"],["、"],["すべて"],["の"],["淵","ふち"],["よ"],["、"],["地","ち"],["から"],["主","しゅ"],["を"],["ほめたたえ"],["よ"],["。"]]},{"verse":8,"text":"火,ひよ、あられよ、雪,ゆきよ、霜,しもよ、み言葉,ことばを行,おこなうあらしよ、","tok":[["火","ひ"],["よ"],["、"],["あられ"],["よ"],["、"],["雪","ゆき"],["よ"],["、"],["霜","しも"],["よ"],["、"],["み言葉","みことば"],["を"],["行なう","おこなう"],["あらし"],["よ"],["、"]]},{"verse":9,"text":"もろもろの山,やま、すべての丘,おか、実,みを結,むすぶ木,き、すべての香柏,こうはくよ、","tok":[["もろもろ"],["の"],["山","やま"],["、"],["すべて"],["の"],["丘","おか"],["、"],["実","み"],["を"],["結ぶ","むすぶ"],["木","き"],["、"],["すべて"],["の"],["香","こう"],["柏","かしわ"],["う"],["はく"],["よ"],["、"]]},{"verse":10,"text":"野,のの獣,けもの、すべての家畜,かちく、這,はうもの、翼,つばさある鳥,とりよ、","tok":[["野","の"],["の"],["獣","けもの"],["、"],["すべて"],["の"],["家畜","かちく"],["、"],["這う","はう"],["もの"],["、"],["翼","つばさ"],["ある"],["鳥","とり"],["よ"],["、"]]},{"verse":11,"text":"地,ちの王,おうたち、すべての民,たみ、君,きみたち、地,ちのすべてのつかさよ、","tok":[["地","ち"],["の"],["王","おう"],["たち"],["、"],["すべて"],["の"],["民","たみ"],["、"],["君","きみ"],["たち"],["、"],["地","ち"],["の"],["すべて"],["の"],["つかさ"],["よ"],["、"]]},{"verse":12,"text":"若,わかい男子,だんし、若,わかい女子,じょし、老,おいた人,ひとと幼,おさない者,ものよ、","tok":[["若い","わかい"],["男子","だんし"],["、"],["若い","わかい"],["女子","じょし"],["、"],["老","おい"],["た"],["人","ひと"],["と"],["幼ない","おさない"],["者","もの"],["よ"],["、"]]},{"verse":13,"text":"彼,かれらをして主,しゅのみ名,なをほめたたえさせよ。そのみ名,なは高,たかく、たぐいなく、その栄光,えいこうは地,ちと天,てんの上,うえにあるからである。","tok":[["彼","かれ"],["ら"],["を"],["して"],["主","しゅ"],["のみ"],["名","な"],["を"],["ほめたたえさせ"],["よ"],["。"],["その"],["み名","みな"],["は"],["高かく","たかく"],["、"],["たぐい"],["なく"],["、"],["その"],["栄光","えいこう"],["は"],["地","ち"],["と"],["天","てん"],["の"],["上","うえ"],["に"],["ある"],["から"],["で"],["ある"],["。"]]},{"verse":14,"text":"主,しゅはその民,たみのために一つの角,つのをあげられた。これはすべての聖徒,せいとのほめたたえるもの、主,しゅに近,ちかいイスラエルの人々,ひとびとのほめたたえるものである。主,しゅをほめたたえよ。","tok":[["主","しゅ"],["は"],["その"],["民","たみ"],["の"],["ため"],["に"],["一","ひと"],["つ"],["の"],["角","つ"],["の"],["を"],["あげられた"],["。"],["これ"],["は"],["すべて"],["の"],["聖徒","せいと"],["の"],["ほめたたえる"],["もの"],["、"],["主に","しゅに"],["近い","ちかい"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["ほめたたえる"],["もの"],["で"],["ある"],["。"],["主","しゅ"],["を"],["ほめたたえ"],["よ"],["。"]]}]
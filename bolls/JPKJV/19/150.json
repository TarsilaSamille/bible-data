[{"verse":1,"text":"主,しゅをほめたたえよ。その聖所,せいじょで神,かみをほめたたえよ。その力,ちからのあらわれる大空,おおぞらで主,しゅをほめたたえよ。","tok":[["主","しゅ"],["を"],["ほめたたえ"],["よ"],["。"],["その"],["聖","せい"],["所","しょ"],["い"],["じょ"],["で"],["神","かみ"],["を"],["ほめたたえ"],["よ"],["。"],["その"],["力","ちから"],["の"],["あらわれる"],["大空","おおぞら"],["で"],["主","しゅ"],["を"],["ほめたたえ"],["よ"],["。"]]},{"verse":2,"text":"その大能,たいのうのはたらきのゆえに主,しゅをほめたたえよ。そのすぐれて大,おおいなることのゆえに主,しゅをほめたたえよ。","tok":[["その"],["大能","たいのう"],["の"],["はたらき"],["の"],["ゆえ"],["に"],["主","しゅ"],["を"],["ほめたたえ"],["よ"],["。"],["その"],["すぐれて"],["大いなる","おおいなる"],["こと"],["の"],["ゆえ"],["に"],["主","しゅ"],["を"],["ほめたたえ"],["よ"],["。"]]},{"verse":3,"text":"ラッパの声,こえをもって主,しゅをほめたたえよ。立琴,たてごとと琴,こととをもって主,しゅをほめたたえよ。","tok":[["ラッパ"],["の"],["声","こえ"],["を"],["もって"],["主","しゅ"],["を"],["ほめたたえ"],["よ"],["。"],["立琴","たてごと"],["と"],["琴","こと"],["と"],["を"],["もって"],["主","しゅ"],["を"],["ほめたたえ"],["よ"],["。"]]},{"verse":4,"text":"鼓,つづみと踊,おどりとをもって主,しゅをほめたたえよ。緒琴,おごとと笛,ふえとをもって主,しゅをほめたたえよ。","tok":[["鼓","つづみ"],["と"],["踊","おどり"],["と"],["を"],["もって"],["主","しゅ"],["を"],["ほめたたえ"],["よ"],["。"],["緒","いとぐち"],["琴","こと"],["と"],["と"],["笛","ふえ"],["と"],["を"],["もって"],["主","しゅ"],["を"],["ほめたたえ"],["よ"],["。"]]},{"verse":5,"text":"音,ねの高,たかいシンバルをもって主,しゅをほめたたえよ。鳴,なりひびくシンバルをもって主,しゅをほめたたえよ。","tok":[["音","ね"],["の"],["高い","たかい"],["シンバル"],["を"],["もって"],["主","しゅ"],["を"],["ほめたたえ"],["よ"],["。"],["鳴りひびく","なりひびく"],["シンバル"],["を"],["もって"],["主","しゅ"],["を"],["ほめたたえ"],["よ"],["。"]]},{"verse":6,"text":"息,いきのあるすべてのものに主,しゅをほめたたえさせよ。主,しゅをほめたたえよ。","tok":[["息","いき"],["の"],["ある"],["すべて"],["の"],["もの"],["に"],["主","しゅ"],["を"],["ほめたたえさせ"],["よ"],["。"],["主","しゅ"],["を"],["ほめたたえ"],["よ"],["。"]]}]
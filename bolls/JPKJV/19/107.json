[{"verse":1,"text":"第,だい五,ご巻,かん「主,しゅに感謝,かんしゃせよ、主,しゅは恵,めぐみふかく、そのいつくしみはとこしえに絶,たえることがない」と、","tok":[["第","だい"],["五","ご"],["巻","かん"],["「"],["主に","しゅに"],["感謝","かんしゃ"],["せよ"],["、"],["主","しゅ"],["は"],["恵","めぐみ"],["ふかく"],["、"],["その"],["いつくしみ"],["は"],["とこしえ"],["に"],["絶える","たえる"],["こと"],["が"],["ない"],["」"],["と"],["、"]]},{"verse":2,"text":"主,しゅにあがなわれた者,ものは言,いえ。主,しゅは彼,かれらを悩,なやみからあがない、","tok":[["主に","しゅに"],["あがなわれた"],["者","もの"],["は"],["言え","いえ"],["。"],["主","しゅ"],["は"],["彼","かれ"],["ら"],["を"],["悩み","なやみ"],["から"],["あがない"],["、"]]},{"verse":3,"text":"もろもろの国,くにから、東,ひがし、西,にし、北,きた、南,みなみから彼,かれらを集,あつめられた。","tok":[["もろもろ"],["の"],["国","くに"],["から"],["、"],["東","ひがし"],["、"],["西","にし"],["、"],["北","きた"],["、"],["南","みなみ"],["から"],["彼","かれ"],["ら"],["を"],["集められた","あつめられた"],["。"]]},{"verse":4,"text":"彼,かれらは人,ひとなき荒野,あらのにさまよい、住,すむべき町,まちにいたる道,みちを見,みいださなかった。","tok":[["彼","かれ"],["ら"],["は"],["人","ひと"],["なき"],["荒野","あらの"],["に"],["さまよい"],["、"],["住むべき","すむべき"],["町","まち"],["に"],["いたる"],["道","みち"],["を"],["見いださなかった","みいださなかった"],["。"]]},{"verse":5,"text":"彼,かれらは飢,うえ、またかわき、その魂,たましいは彼,かれらのうちに衰,おとろえた。","tok":[["彼","かれ"],["ら"],["は"],["飢","うえ"],["、"],["また"],["かわき"],["、"],["その"],["魂","たましい"],["は"],["彼","かれ"],["ら"],["の"],["うち"],["に"],["衰えた","おとろえた"],["。"]]},{"verse":6,"text":"彼,かれらはその悩,なやみのうちに主,しゅに呼,よばわったので、主,しゅは彼,かれらをその悩,なやみから助,たすけ出,だし、","tok":[["彼","かれ"],["ら"],["は"],["その"],["悩み","なやみ"],["の"],["うち"],["に"],["主","しゅ"],["に"],["呼ばわった","よばわった"],["ので"],["、"],["主","しゅ"],["は"],["彼","かれ"],["ら"],["を"],["その"],["悩み","なやみ"],["から"],["助け出し","たすけだし"],["、"]]},{"verse":7,"text":"住,すむべき町,まちに行,いき着,つくまで、まっすぐな道,みちに導,みちびかれた。","tok":[["住むべき","すむべき"],["町","まち"],["に"],["行き着く","いきつく"],["まで"],["、"],["まっすぐ"],["な"],["道","みち"],["に"],["導かれた","みちびかれた"],["。"]]},{"verse":8,"text":"どうか、彼,かれらが主,しゅのいつくしみと、人,ひとの子,こらになされたくすしきみわざとのために、主,しゅに感謝,かんしゃするように。","tok":[["どう"],["か"],["、"],["彼","かれ"],["ら"],["が"],["主","しゅ"],["の"],["いつくしみ"],["と"],["、"],["人","ひと"],["の"],["子","こ"],["ら"],["に"],["なされた"],["くす"],["しきみ"],["わざと"],["の"],["ため"],["に"],["、"],["主に","しゅに"],["感謝","かんしゃ"],["する"],["よう"],["に"],["。"]]},{"verse":9,"text":"主,しゅはかわいた魂,たましいを満,みち足,たらせ、飢,うえた魂,たましいを良,よき物,もので満,みたされるからである。","tok":[["主","しゅ"],["は"],["かわいた"],["魂","たましい"],["を"],["満ち","みち"],["足らせ","たらせ"],["、"],["飢","うえ"],["た"],["魂","たましい"],["を"],["良き","よき"],["物","もの"],["で"],["満たされる","みたされる"],["から"],["で"],["ある"],["。"]]},{"verse":10,"text":"暗黒,あんこくと深,ふかいやみの中,なかにいる者,もの、苦,くるしみと、くろがねに縛,しばられた者,もの、","tok":[["暗黒","あんこく"],["と"],["深い","ふかい"],["やみ"],["の"],["中","なか"],["に"],["いる"],["者","もの"],["、"],["苦しみ","くるしみ"],["と"],["、"],["くろがね"],["に"],["縛られた","しばられた"],["者","もの"],["、"]]},{"verse":11,"text":"彼,かれらは神,かみの言葉,ことばにそむき、いと高,たかき者,ものの勧,すすめを軽,かろんじたので、","tok":[["彼","かれ"],["ら"],["は"],["神","かみ"],["の"],["言葉","ことば"],["に"],["そむき"],["、"],["いと"],["高き","たかき"],["者","もの"],["の"],["勧め","すすめ"],["を"],["軽","かろんじた"],["ので"],["、"]]},{"verse":12,"text":"主,しゅは重,おもい労働,ろうどうをもって彼,かれらの心,こころを低,ひくくされた。彼,かれらはつまずき倒,たおれても、助,たすける者,ものがなかった。","tok":[["主","しゅ"],["は"],["重い","おもい"],["労働","ろうどう"],["を"],["もって"],["彼","かれ"],["ら"],["の"],["心","こころ"],["を"],["低く","ひくく"],["された"],["。"],["彼","かれ"],["ら"],["は"],["つまずき"],["倒れて","たおれて"],["も"],["、"],["助ける","たすける"],["者","もの"],["が"],["なかった"],["。"]]},{"verse":13,"text":"彼,かれらはその悩,なやみのうちに主,しゅに呼,よばわったので、主,しゅは彼,かれらをその悩,なやみから救,すくい、","tok":[["彼","かれ"],["ら"],["は"],["その"],["悩み","なやみ"],["の"],["うち"],["に"],["主","しゅ"],["に"],["呼ばわった","よばわった"],["ので"],["、"],["主","しゅ"],["は"],["彼","かれ"],["ら"],["を"],["その"],["悩み","なやみ"],["から"],["救い","すくい"],["、"]]},{"verse":14,"text":"暗黒,あんこくと深,ふかいやみから彼,かれらを導,みちびき出,だして、そのかせをこわされた。","tok":[["暗黒","あんこく"],["と"],["深い","ふかい"],["やみ"],["から"],["彼","かれ"],["ら"],["を"],["導き出して","みちびきだして"],["、"],["その"],["か"],["せ"],["を"],["こわされた"],["。"]]},{"verse":15,"text":"どうか、彼,かれらが主,しゅのいつくしみと、人,ひとの子,こらになされたくすしきみわざとのために、主,しゅに感謝,かんしゃするように。","tok":[["どう"],["か"],["、"],["彼","かれ"],["ら"],["が"],["主","しゅ"],["の"],["いつくしみ"],["と"],["、"],["人","ひと"],["の"],["子","こ"],["ら"],["に"],["なされた"],["くす"],["しきみ"],["わざと"],["の"],["ため"],["に"],["、"],["主に","しゅに"],["感謝","かんしゃ"],["する"],["よう"],["に"],["。"]]},{"verse":16,"text":"主,しゅは青銅,せいどうのとびらをこわし、鉄,てつの貫,かんの木,きを断,たち切,きられたからである。","tok":[["主","しゅ"],["は"],["青銅","せいどう"],["の"],["とびら"],["を"],["こわし"],["、"],["鉄","てつ"],["の"],["貫の木","かんのき"],["を"],["断ち切られた","たちきられた"],["から"],["で"],["ある"],["。"]]},{"verse":17,"text":"ある者,ものはその罪,つみに汚,けがれた行,おこないによって病,やみ、その不義,ふぎのゆえに悩,なやんだ。","tok":[["ある"],["者","もの"],["は"],["その"],["罪","つみ"],["に"],["汚","け"],["がれ"],["た"],["行ない","おこない"],["によって"],["病み","やみ"],["、"],["その"],["不義","ふぎ"],["の"],["ゆえ"],["に"],["悩んだ","なやんだ"],["。"]]},{"verse":18,"text":"彼,かれらはすべての食物,しょくもつをきらって、死,しの門,もんに近,ちかづいた。","tok":[["彼","かれ"],["ら"],["は"],["すべて"],["の"],["食物","しょくもつ"],["を"],["きらって"],["、"],["死","し"],["の"],["門","もん"],["に"],["近づいた","ちかづいた"],["。"]]},{"verse":19,"text":"彼,かれらはその悩,なやみのうちに主,しゅに呼,よばわったので、主,しゅは彼,かれらをその悩,なやみから救,すくい、","tok":[["彼","かれ"],["ら"],["は"],["その"],["悩み","なやみ"],["の"],["うち"],["に"],["主","しゅ"],["に"],["呼ばわった","よばわった"],["ので"],["、"],["主","しゅ"],["は"],["彼","かれ"],["ら"],["を"],["その"],["悩み","なやみ"],["から"],["救い","すくい"],["、"]]},{"verse":20,"text":"そのみ言葉,ことばをつかわして、彼,かれらをいやし、彼,かれらを滅,ほろびから助,たすけ出,だされた。","tok":[["その"],["み言葉","みことば"],["を"],["つかわして"],["、"],["彼","かれ"],["ら"],["を"],["いやし"],["、"],["彼","かれ"],["ら"],["を"],["滅び","ほろび"],["から"],["助け出された","たすけだされた"],["。"]]},{"verse":21,"text":"どうか、彼,かれらが主,しゅのいつくしみと、人,ひとの子,こらになされたくすしきみわざとのために、主,しゅに感謝,かんしゃするように。","tok":[["どう"],["か"],["、"],["彼","かれ"],["ら"],["が"],["主","しゅ"],["の"],["いつくしみ"],["と"],["、"],["人","ひと"],["の"],["子","こ"],["ら"],["に"],["なされた"],["くす"],["しきみ"],["わざと"],["の"],["ため"],["に"],["、"],["主に","しゅに"],["感謝","かんしゃ"],["する"],["よう"],["に"],["。"]]},{"verse":22,"text":"彼,かれらが感謝,かんしゃのいけにえをささげ、喜,よろこびの歌,うたをもって、そのみわざを言,いいあらわすように。","tok":[["彼","かれ"],["ら"],["が"],["感謝","かんしゃ"],["の"],["いけにえ"],["を"],["ささげ"],["、"],["喜こび","よろこび"],["の"],["歌","うた"],["を"],["もって"],["、"],["その"],["みわざ"],["を"],["言いあらわす","いいあらわす"],["よう"],["に"],["。"]]},{"verse":23,"text":"舟,ふねで海,うみにくだり、大海,たいかいで商売,しょうばいをする者,ものは、","tok":[["舟","ふね"],["で"],["海","うみ"],["に"],["くだり"],["、"],["大海","たいかい"],["で"],["商売","しょうばい"],["を"],["する"],["者","もの"],["は"],["、"]]},{"verse":24,"text":"主,しゅのみわざを見,み、また深,ふかい所,ところでそのくすしきみわざを見,みた。","tok":[["主","しゅ"],["のみ"],["わざ"],["を"],["見","み"],["、"],["また"],["深","ふ"],["かい所","かいところ"],["で"],["その"],["くす"],["しきみ"],["わざ"],["を"],["見た","みた"],["。"]]},{"verse":25,"text":"主,しゅが命,めいじられると暴風,ぼうふうが起,たって、海,うみの波,なみをあげた。","tok":[["主","しゅ"],["が"],["命じられる","めいじられる"],["と"],["暴風","ぼうふう"],["が"],["起って","たって"],["、"],["海","うみ"],["の"],["波","なみ"],["を"],["あげた"],["。"]]},{"verse":26,"text":"彼,かれらは天,てんにのぼり、淵,ふちにくだり、悩,なやみによってその勇気,ゆうきは溶,とけ去,さり、","tok":[["彼","かれ"],["ら"],["は"],["天","てん"],["に"],["のぼり"],["、"],["淵","ふち"],["に"],["くだり"],["、"],["悩み","なやみ"],["によって"],["その"],["勇気","ゆうき"],["は"],["溶け去り","とけさり"],["、"]]},{"verse":27,"text":"酔,よった人,ひとのようによろめき、よろめいて途方,とほうにくれる。","tok":[["酔った","よった"],["人","ひと"],["の"],["よう"],["に"],["よろめき"],["、"],["よろめいて"],["途方","とほう"],["に"],["くれる"],["。"]]},{"verse":28,"text":"彼,かれらはその悩,なやみのうちに主,しゅに呼,よばわったので、主,しゅは彼,かれらをその悩,なやみから救,すくい出,だされた。","tok":[["彼","かれ"],["ら"],["は"],["その"],["悩み","なやみ"],["の"],["うち"],["に"],["主","しゅ"],["に"],["呼ばわった","よばわった"],["ので"],["、"],["主","しゅ"],["は"],["彼","かれ"],["ら"],["を"],["その"],["悩み","なやみ"],["から"],["救い出された","すくいだされた"],["。"]]},{"verse":29,"text":"主,しゅがあらしを静,しずめられると、海,うみの波,なみは穏,おだやかになった。","tok":[["主","しゅ"],["が"],["あらし"],["を"],["静められる","しずめられる"],["と"],["、"],["海","うみ"],["の"],["波","なみ"],["は"],["穏","おだやか"],["に"],["なった"],["。"]]},{"verse":30,"text":"こうして彼,かれらは波,なみの静,しずまったのを喜,よろこび、主,しゅは彼,かれらをその望,のぞむ港,みなとへ導,みちびかれた。","tok":[["こう"],["して"],["彼","かれ"],["ら"],["は"],["波","なみ"],["の"],["静まった","しずまった"],["の"],["を"],["喜こび","よろこび"],["、"],["主","しゅ"],["は"],["彼","かれ"],["ら"],["を"],["その"],["望む","のぞむ"],["港","みなと"],["へ"],["導かれた","みちびかれた"],["。"]]},{"verse":31,"text":"どうか、彼,かれらが主,しゅのいつくしみと、人,ひとの子,こらになされたくすしきみわざとのために、主,しゅに感謝,かんしゃするように。","tok":[["どう"],["か"],["、"],["彼","かれ"],["ら"],["が"],["主","しゅ"],["の"],["いつくしみ"],["と"],["、"],["人","ひと"],["の"],["子","こ"],["ら"],["に"],["なされた"],["くす"],["しきみ"],["わざと"],["の"],["ため"],["に"],["、"],["主に","しゅに"],["感謝","かんしゃ"],["する"],["よう"],["に"],["。"]]},{"verse":32,"text":"彼,かれらが民,たみの集会,しゅうかいで主,しゅをあがめ、長老,ちょうろうの会合,かいごうで主,しゅをほめたたえるように。","tok":[["彼","かれ"],["ら"],["が"],["民","たみ"],["の"],["集会","しゅうかい"],["で"],["主","しゅ"],["を"],["あがめ"],["、"],["長老","ちょうろう"],["の"],["会合","かいごう"],["で"],["主","しゅ"],["を"],["ほめたたえる"],["よう"],["に"],["。"]]},{"verse":33,"text":"主,しゅは川,かわを野,のに変,かわらせ、泉,いずみをかわいた地,ちに変,かわらせ、","tok":[["主","しゅ"],["は"],["川","かわ"],["を"],["野","の"],["に"],["変わらせ","かわらせ"],["、"],["泉","いずみ"],["を"],["かわいた"],["地","ち"],["に"],["変わらせ","かわらせ"],["、"]]},{"verse":34,"text":"肥,こえた地,ちをそれに住,すむ者,ものの悪,あくのゆえに塩,しお地,ちに変,かわらせられる。","tok":[["肥","こえ"],["た"],["地","ち"],["を"],["それ"],["に"],["住む","すむ"],["者","もの"],["の"],["悪","あく"],["の"],["ゆえ"],["に"],["塩地","しおち"],["に"],["変わらせられる","かわらせられる"],["。"]]},{"verse":35,"text":"主,しゅは野,のを池,いけに変,かわらせ、かわいた地,ちを泉,いずみに変,かわらせ、","tok":[["主","しゅ"],["は"],["野","の"],["を"],["池","いけ"],["に"],["変わらせ","かわらせ"],["、"],["かわいた"],["地","ち"],["を"],["泉","いずみ"],["に"],["変わらせ","かわらせ"],["、"]]},{"verse":36,"text":"飢,うえた者,ものをそこに住,すまわせられる。こうして彼,かれらはその住,すむべき町,まちを建,たて、","tok":[["飢","うえ"],["た"],["者","もの"],["を"],["そこ"],["に"],["住まわせられる","すまわせられる"],["。"],["こう"],["して"],["彼","かれ"],["ら"],["は"],["その"],["住むべき","すむべき"],["町","まち"],["を"],["建て","たて"],["、"]]},{"verse":37,"text":"畑,はたけに種,たねをまき、ぶどう畑,はたけを設,もうけて多,おおくの収穫,しゅうかくを得,えた。","tok":[["畑","はたけ"],["に"],["種","たね"],["を"],["まき"],["、"],["ぶどう"],["畑","はたけ"],["を"],["設けて","もうけて"],["多く","おおく"],["の"],["収穫","しゅうかく"],["を"],["得た","えた"],["。"]]},{"verse":38,"text":"主,しゅが彼,かれらを祝福,しゅくふくされたので彼,かれらは大,おおいにふえ、その家畜,かちくの減,へるのをゆるされなかった。","tok":[["主","しゅ"],["が"],["彼","かれ"],["ら"],["を"],["祝福","しゅくふく"],["された"],["ので"],["彼","かれ"],["ら"],["は"],["大いに","おおいに"],["ふえ"],["、"],["その"],["家畜","かちく"],["の"],["減る","へる"],["の"],["を"],["ゆるされなかった"],["。"]]},{"verse":39,"text":"彼,かれらがしえたげと、悩,なやみと、悲,かなしみとによって減,へり、かつ卑,いやしめられたとき、","tok":[["彼","かれ"],["ら"],["が"],["し"],["えたげ"],["と"],["、"],["悩み","なやみ"],["と"],["、"],["悲しみ","かなしみ"],["と"],["によって"],["減り","へり"],["、"],["かつ"],["卑しめられた","いやしめられた"],["とき"],["、"]]},{"verse":40,"text":"主,しゅはもろもろの君,きみに侮,あなどりをそそぎ、道,みちなき荒,あれ地,ちにさまよわせられた。","tok":[["主","しゅ"],["は"],["もろもろ"],["の"],["君","きみ"],["に"],["侮","あなどり"],["を"],["そそぎ"],["、"],["道","みち"],["なき"],["荒れ地","あれち"],["に"],["さまよわせられた"],["。"]]},{"verse":41,"text":"しかし主,しゅは貧,まずしい者,ものを悩,なやみのうちからあげて、その家族,かぞくを羊,ひつじの群,むれのようにされた。","tok":[["しかし"],["主","しゅ"],["は"],["貧しい","まずしい"],["者","もの"],["を"],["悩み","なやみ"],["の"],["うち"],["から"],["あげて"],["、"],["その"],["家族","かぞく"],["を"],["羊","ひつじ"],["の"],["群れ","むれ"],["の"],["よう"],["に"],["された"],["。"]]},{"verse":42,"text":"正,ただしい者,ものはこれを見,みて喜,よろこび、もろもろの不義,ふぎはその口,くちを閉,とじた。","tok":[["正い","ただしい"],["者","もの"],["は"],["これ"],["を"],["見て","みて"],["喜こび","よろこび"],["、"],["もろもろ"],["の"],["不義","ふぎ"],["は"],["その"],["口","くち"],["を"],["閉じた","とじた"],["。"]]},{"verse":43,"text":"すべて賢,かしこい者,ものはこれらの事,ことに心,こころをよせ、主,しゅのいつくしみをさとるようにせよ。","tok":[["すべて"],["賢しこい","かしこい"],["者","もの"],["は"],["これ"],["ら"],["の"],["事","こと"],["に"],["心","こころ"],["を"],["よせ"],["、"],["主","しゅ"],["の"],["いつくしみ"],["を"],["さとる"],["よう"],["に"],["せよ"],["。"]]}]
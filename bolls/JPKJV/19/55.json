[{"verse":1,"text":"[0]【聖歌,せいか隊,たいの指揮者,しきしゃによって琴,ことをもってうたわせたダビデのマスキールの歌,うた】","tok":[["["],["0"],["]"],["【"],["聖歌隊","せいかたい"],["の"],["指揮者","しきしゃ"],["によって"],["琴","こと"],["を"],["もって"],["うたわせた"],["ダビデ"],["の"],["マスキール"],["の"],["歌","うた"],["】"]]},{"verse":2,"text":"[1]神,かみよ、わたしの祈,いのりに耳,みみを傾,かたむけてください。わたしの願,ねがいを避,さけて身,みを隠,かくさないでください。","tok":[["["],["1"],["]"],["神","かみ"],["よ"],["、"],["わたし"],["の"],["祈","いのり"],["に"],["耳","みみ"],["を"],["傾むけて","かたむけて"],["ください"],["。"],["わたし"],["の"],["願い","ねがい"],["を"],["避けて","さけて"],["身","み"],["を"],["隠さないで","かくさないで"],["ください"],["。"]]},{"verse":3,"text":"[2]わたしにみこころをとめ、わたしに答,こたえてください。わたしは悩,なやみによって弱,よわりはて、","tok":[["["],["2"],["]"],["わたし"],["に"],["みこころ"],["を"],["とめ"],["、"],["わたし"],["に"],["答","こたえ"],["て"],["ください"],["。"],["わたし"],["は"],["悩み","なやみ"],["によって"],["弱り","よわり"],["はて"],["、"]]},{"verse":4,"text":"[3]敵,てきの声,こえと、悪,あしき者,もののしえたげとによって気,きが狂,くるいそうです。彼,かれらはわたしに悩,なやみを臨,のぞませ、怒,いかってわたしを苦,くるしめるからです。","tok":[["["],["3"],["]"],["敵","てき"],["の"],["声","こえ"],["と"],["、"],["悪しき","あしき"],["者","もの"],["の"],["し"],["えたげ"],["と"],["によって"],["気","き"],["が"],["狂い","くるい"],["そう"],["です"],["。"],["彼","かれ"],["ら"],["は"],["わたし"],["に"],["悩み","なやみ"],["を"],["臨ませ","のぞませ"],["、"],["怒","い"],["か"],["って"],["わたし"],["を"],["苦しめる","くるしめる"],["から"],["です"],["。"]]},{"verse":5,"text":"[4]わたしの心,こころはわがうちにもだえ苦,くるしみ、死,しの恐,おそれがわたしの上,うえに落,おちました。","tok":[["["],["4"],["]"],["わたし"],["の"],["心","こころ"],["は"],["わが"],["うち"],["に"],["もだえ苦しみ","もだえくるしみ"],["、"],["死","し"],["の"],["恐","おそれ"],["が"],["わたし"],["の"],["上","うえ"],["に"],["落","おち"],["ました"],["。"]]},{"verse":6,"text":"[5]恐,おそれとおののきがわたしに臨,のぞみ、はなはだしい恐,おそれがわたしをおおいました。","tok":[["["],["5"],["]"],["恐","おそれ"],["と"],["おののき"],["が"],["わたし"],["に"],["臨み","のぞみ"],["、"],["はなはだしい"],["恐","おそれ"],["が"],["わたし"],["を"],["おおいました"],["。"]]},{"verse":7,"text":"[6]わたしは言,いいます、「どうか、はとのように翼,つばさをもちたいものだ。そうすればわたしは飛,とび去,さって安,やすきを得,えるであろう。","tok":[["["],["6"],["]"],["わたし"],["は"],["言います","いいます"],["、"],["「"],["どう"],["か"],["、"],["はと"],["の"],["よう"],["に"],["翼","つばさ"],["を"],["もちたい"],["もの"],["だ"],["。"],["そう"],["すれば"],["わたし"],["は"],["飛び","とび"],["去て","さって"],["安き","やすき"],["を"],["得るで","えるで"],["あろう"],["。"]]},{"verse":8,"text":"[7]わたしは遠,とおくのがれ去,さって、野,のに宿,やどろう。〔セラ","tok":[["["],["7"],["]"],["わたし"],["は"],["遠く","とおく"],["のがれ"],["去て","さって"],["、"],["野","の"],["に"],["宿ろう","やどろう"],["。"],["〔"],["セラ"]]},{"verse":9,"text":"[8]わたしは急,いそぎ避難,ひなんして、はやてとあらしをのがれよう」と。","tok":[["["],["8"],["]"],["わたし"],["は"],["急ぎ","いそぎ"],["避難","ひなん"],["して"],["、"],["はやて"],["と"],["あらし"],["を"],["のがれよう"],["」"],["と"],["。"]]},{"verse":10,"text":"[9]主,しゅよ、彼,かれらのはかりごとを打,うち破,やぶってください。彼,かれらの舌,したを混乱,こんらんさせてください。わたしは町,まちのうちに暴力,ぼうりょくと争,あらそいとを見,みるからです。","tok":[["["],["9"],["]"],["主","しゅ"],["よ"],["、"],["彼","かれ"],["ら"],["の"],["はかりごと"],["を"],["打ち破って","うちやぶって"],["ください"],["。"],["彼","かれ"],["ら"],["の"],["舌","した"],["を"],["混乱","こんらん"],["させて"],["ください"],["。"],["わたし"],["は"],["町","まち"],["の"],["うち"],["に"],["暴力","ぼうりょく"],["と"],["争い","あらそい"],["と"],["を"],["見る","みる"],["から"],["です"],["。"]]},{"verse":11,"text":"[10]彼,かれらは昼,ひるも夜,よるも町,まちの城壁,じょうへきの上,うえを歩,あるきめぐり、町,まちのうちには害悪,がいあくと悩,なやみとがあります。","tok":[["["],["10"],["]"],["彼","かれ"],["ら"],["は"],["昼","ひる"],["も"],["夜","よる"],["も"],["町","まち"],["の"],["城壁","じょうへき"],["の"],["上","うえ"],["を"],["歩き","あるき"],["めぐり"],["、"],["町","まち"],["の"],["うち"],["に"],["は"],["害悪","がいあく"],["と"],["悩み","なやみ"],["と"],["が"],["あります"],["。"]]},{"verse":12,"text":"[11]また滅,ほろぼす事,ことが町,まちのうちにあり、しえたげと欺,あざむきとはその市場,しじょうを離,はなれることがありません。","tok":[["["],["11"],["]"],["また"],["滅ぼす","ほろぼす"],["事","こと"],["が"],["町","まち"],["の"],["うち"],["に"],["あり"],["、"],["し"],["えたげ"],["と"],["欺き","あざむき"],["と"],["は"],["その"],["市場","しじょう"],["を"],["離れる","はなれる"],["こと"],["が"],["ありません"],["。"]]},{"verse":13,"text":"[12]わたしをののしる者,ものは敵,てきではありません。もしそうであるならば忍,しのぶことができます。わたしにむかって高,たかぶる者,ものはあだではありません。もしそうであるならば身,みを隠,かくして彼,かれを避,さけることができます。","tok":[["["],["12"],["]"],["わたし"],["を"],["ののしる"],["者","もの"],["は"],["敵","てき"],["で"],["は"],["ありません"],["。"],["もし"],["そう"],["で"],["あるならば"],["忍ぶ","しのぶ"],["こと"],["が"],["できます"],["。"],["わたし"],["に"],["むかって"],["高か","たか"],["ぶる"],["者","もの"],["は"],["あだ"],["で"],["は"],["ありません"],["。"],["もし"],["そう"],["で"],["あるならば"],["身","み"],["を"],["隠して","かくして"],["彼","かれ"],["を"],["避ける","さける"],["こと"],["が"],["できます"],["。"]]},{"verse":14,"text":"[13]しかしそれはあなたです、わたしと同,おなじ者,もの、わたしの同僚,どうりょう、わたしの親,したしい友,ともです。","tok":[["["],["13"],["]"],["しかし"],["それ"],["は"],["あなた"],["です"],["、"],["わたし"],["と"],["同じ","おなじ"],["者","もの"],["、"],["わたし"],["の"],["同僚","どうりょう"],["、"],["わたし"],["の"],["親しい","したしい"],["友","とも"],["です"],["。"]]},{"verse":15,"text":"[14]われらはたがいに楽,たのしく語,かたらい、つれだって神,かみの宮,みやに上,のぼりました。","tok":[["["],["14"],["]"],["われ"],["ら"],["は"],["たがい"],["に"],["楽く","たのしく"],["語らい","かたらい"],["、"],["つれだって"],["神","かみ"],["の"],["宮","みや"],["に"],["上りました","のぼりました"],["。"]]},{"verse":16,"text":"[15]どうぞ、死,しを彼,かれらに臨,のぞませ、生,いきたままで陰府,よみに下,くだらせ、恐,おそれをもって彼,かれらを墓,はかに去,さらせてください。","tok":[["["],["15"],["]"],["どうぞ"],["、"],["死","し"],["を"],["彼","かれ"],["ら"],["に"],["臨ませ","のぞませ"],["、"],["生きた","いきた"],["まま"],["で"],["陰府","よみ"],["に"],["下らせ","くだらせ"],["、"],["恐","おそれ"],["を"],["もって"],["彼","かれ"],["ら"],["を"],["墓","はか"],["に"],["去らせて","さらせて"],["ください"],["。"]]},{"verse":17,"text":"[16]しかしわたしが神,かみに呼,よばわれば、主,しゅはわたしを救,すくわれます。","tok":[["["],["16"],["]"],["しかし"],["わたし"],["が"],["神","かみ"],["に"],["呼ばわれば","よばわれば"],["、"],["主","しゅ"],["は"],["わたし"],["を"],["救われます","すくわれます"],["。"]]},{"verse":18,"text":"[17]夕,ゆうべに、あしたに、真昼,まひるにわたしが嘆,なげきうめけば、主,しゅはわたしの声,こえを聞,きかれます。","tok":[["["],["17"],["]"],["夕べ","ゆうべ"],["に"],["、"],["あした"],["に"],["、"],["真昼","まひる"],["に"],["わたし"],["が"],["嘆き","なげき"],["うめけば"],["、"],["主","しゅ"],["は"],["わたし"],["の"],["声","こえ"],["を"],["聞かれます","きかれます"],["。"]]},{"verse":19,"text":"[18]たといわたしを攻,せめる者,ものが多,おおくとも、主,しゅはわたしがたたかう戦,たたかいからわたしを安,やすらかに救,すくい出,だされます。","tok":[["["],["18"],["]"],["たとい"],["わたし"],["を"],["攻める","せめる"],["者","もの"],["が"],["多く","おおく"],["とも"],["、"],["主","しゅ"],["は"],["わたし"],["が"],["たたかう"],["戦い","たたかい"],["から"],["わたし"],["を"],["安らか","やすらか"],["に"],["救い出されます","すくいだされます"],["。"]]},{"verse":20,"text":"[19]昔,むかしからみくらに座,ざしておられる神,かみは聞,きいて彼,かれらを悩,なやまされるでしょう。〔セラ彼,かれらはおきてを守,まもらず、神,かみを恐,おそれないからです。","tok":[["["],["19"],["]"],["昔","むかし"],["から"],["みくら"],["に"],["座して","ざして"],["おられる"],["神","かみ"],["は"],["聞いて","きいて"],["彼","かれ"],["ら"],["を"],["悩されるでしょう","なやまされるでしょう"],["。"],["〔"],["セラ"],["彼","かれ"],["ら"],["は"],["おきて"],["を"],["守らず","まもらず"],["、"],["神","かみ"],["を"],["恐れない","おそれない"],["から"],["です"],["。"]]},{"verse":21,"text":"[20]わたしの友,ともはその親,したしき者,ものに手,てを伸,のばして、その契約,けいやくを破,やぶった。","tok":[["["],["20"],["]"],["わたし"],["の"],["友","とも"],["は"],["その"],["親","し"],["た"],["しき者","しきもの"],["に"],["手","て"],["を"],["伸ばして","のばして"],["、"],["その"],["契約","けいやく"],["を"],["破った","やぶった"],["。"]]},{"verse":22,"text":"[21]その口,くちは牛酪,ぎゅうらくよりもなめらかだが、その心,こころには戦,たたかいがある。その言葉,ことばは油,あぶらよりもやわらかだが、それは抜,ぬいたつるぎである。","tok":[["["],["21"],["]"],["その"],["口","くち"],["は"],["牛酪","ぎゅうらく"],["より"],["も"],["なめらか"],["だ"],["が"],["、"],["その"],["心","こころ"],["に"],["は"],["戦い","たたかい"],["が"],["ある"],["。"],["その"],["言葉","ことば"],["は"],["油","あぶら"],["より"],["も"],["やわらか"],["だ"],["が"],["、"],["それ"],["は"],["抜いた","ぬいた"],["つるぎ"],["で"],["ある"],["。"]]},{"verse":23,"text":"[22]あなたの荷,にを主,しゅにゆだねよ。主,しゅはあなたをささえられる。主,しゅは正,ただしい人,ひとの動,うごかされるのを決,けっしてゆるされない。","tok":[["["],["22"],["]"],["あなた"],["の"],["荷","に"],["を"],["主に","しゅに"],["ゆだね"],["よ"],["。"],["主","しゅ"],["は"],["あなた"],["を"],["ささえられる"],["。"],["主","しゅ"],["は"],["正い","ただしい"],["人","ひと"],["の"],["動かされる","うごかされる"],["の"],["を"],["決っして","けっして"],["ゆるされない"],["。"]]},{"verse":24,"text":"[23]しかし主,しゅよ、あなたは彼,かれらを滅,ほろびの穴,あなに投,なげ入,いれられます。血,ちを流,ながす者,ものと欺,あざむく者,ものとはおのが日,ひの半,なかばも生,いきながらえることはできません。しかしわたしはあなたに寄,より頼,たのみます。","tok":[["["],["23"],["]"],["しかし"],["主","しゅ"],["よ"],["、"],["あなた"],["は"],["彼","かれ"],["ら"],["を"],["滅び","ほろび"],["の"],["穴","あな"],["に"],["投入れられます","なげいれられます"],["。"],["血","ち"],["を"],["流す","ながす"],["者","もの"],["と"],["欺く","あざむく"],["者","もの"],["と"],["は"],["お"],["の"],["が"],["日","ひ"],["の"],["半ば","なかば"],["も"],["生きながらえる","いきながらえる"],["こと"],["は"],["できません"],["。"],["しかし"],["わたし"],["は"],["あなた"],["に"],["寄り","より"],["頼みます","たのみます"],["。"]]}]
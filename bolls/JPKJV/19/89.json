[{"verse":1,"text":"[0]【エズラびとエタンのマスキールの歌,うた】","tok":[["["],["0"],["]"],["【"],["エズラ"],["び"],["と"],["エタン"],["の"],["マスキール"],["の"],["歌","うた"],["】"]]},{"verse":2,"text":"[1]主,しゅよ、わたしはとこしえにあなたのいつくしみを歌,うたい、わたしの口,くちをもってあなたのまことをよろずよに告,つげ知,しらせます。","tok":[["["],["1"],["]"],["主","しゅ"],["よ"],["、"],["わたし"],["は"],["とこしえ"],["に"],["あなた"],["の"],["いつくしみ"],["を"],["歌い","うたい"],["、"],["わたし"],["の"],["口","くち"],["を"],["もって"],["あなた"],["の"],["まこと"],["を"],["よろず"],["よ"],["に"],["告","つげ"],["知らせます","しらせます"],["。"]]},{"verse":3,"text":"[2]あなたのいつくしみはとこしえに堅,かたく立,たち、あなたのまことは天,てんのようにゆるぐことはありません。","tok":[["["],["2"],["]"],["あなた"],["の"],["いつくしみ"],["は"],["とこしえ"],["に"],["堅く","かたく"],["立ち","たち"],["、"],["あなた"],["の"],["まこと"],["は"],["天","てん"],["の"],["よう"],["に"],["ゆるぐ"],["こと"],["は"],["ありません"],["。"]]},{"verse":4,"text":"[3]あなたは言,いわれました、「わたしはわたしの選,えらんだ者,ものと契約,けいやくを結,むすび、わたしのしもべダビデに誓,ちかった、","tok":[["["],["3"],["]"],["あなた"],["は"],["言われました","いわれました"],["、"],["「"],["わたし"],["は"],["わたし"],["の"],["選らんだ","えらんだ"],["者","もの"],["と"],["契約","けいやく"],["を"],["結び","むすび"],["、"],["わたし"],["の"],["しもべ"],["ダビデ"],["に"],["誓った","ちかった"],["、"]]},{"verse":5,"text":"[4]『わたしはあなたの子孫,しそんをとこしえに堅,かたくし、あなたの王座,おうざを建,たてて、よろずよに至,いたらせる』」。〔セラ","tok":[["["],["4"],["]"],["『"],["わたし"],["は"],["あなた"],["の"],["子孫","しそん"],["を"],["とこしえ"],["に"],["堅く","かたく"],["し"],["、"],["あなた"],["の"],["王座","おうざ"],["を"],["建てて","たてて"],["、"],["よろず"],["よ"],["に"],["至らせる","いたらせる"],["』"],["」"],["。"],["〔"],["セラ"]]},{"verse":6,"text":"[5]主,しゅよ、もろもろの天,てんにあなたのくすしきみわざをほめたたえさせ、聖,せいなる者,もののつどいで、あなたのまことをほめたたえさせてください。","tok":[["["],["5"],["]"],["主","しゅ"],["よ"],["、"],["もろもろ"],["の"],["天","てん"],["に"],["あなた"],["の"],["くす"],["しきみ"],["わざ"],["を"],["ほめたたえさせ"],["、"],["聖","せい"],["なる"],["者","もの"],["の"],["つどい"],["で"],["、"],["あなた"],["の"],["まこと"],["を"],["ほめたたえさせて"],["ください"],["。"]]},{"verse":7,"text":"[6]大空,おおぞらのうちに、だれか主,しゅと並,ならぶものがあるでしょうか。神,かみの子,こらのうちに、だれか主,しゅのような者,ものがあるでしょうか。","tok":[["["],["6"],["]"],["大空","おおぞら"],["の"],["うち"],["に"],["、"],["だれ"],["か"],["主","しゅ"],["と"],["並ぶ","ならぶ"],["もの"],["が"],["あるでしょう"],["か"],["。"],["神","かみ"],["の"],["子","こ"],["ら"],["の"],["うち"],["に"],["、"],["だれ"],["か"],["主","しゅ"],["の"],["よう"],["な"],["者","もの"],["が"],["あるでしょう"],["か"],["。"]]},{"verse":8,"text":"[7]主,しゅは聖,せいなる者,ものの会議,かいぎにおいて恐,おそるべき神,かみ、そのまわりにあるすべての者,ものにまさって大,おおいなる恐,おそるべき者,ものです。","tok":[["["],["7"],["]"],["主","しゅ"],["は"],["聖","せい"],["なる"],["者","もの"],["の"],["会議","かいぎ"],["に"],["おいて"],["恐るべき","おそるべき"],["神","かみ"],["、"],["その"],["まわり"],["に"],["ある"],["すべて"],["の"],["者","もの"],["に"],["まさって"],["大いなる","おおいなる"],["恐るべき","おそるべき"],["者","もの"],["です"],["。"]]},{"verse":9,"text":"[8]万軍,ばんぐんの神,かみ、主,しゅよ、主,しゅよ、だれかあなたのように大能,たいのうのある者,ものがあるでしょうか。あなたのまことは、あなたをめぐっています。","tok":[["["],["8"],["]"],["万","まん"],["軍","ぐん"],["の"],["神","かみ"],["、"],["主","しゅ"],["よ"],["、"],["主","しゅ"],["よ"],["、"],["だれ"],["か"],["あなた"],["の"],["よう"],["に"],["大能","たいのう"],["の"],["ある"],["者","もの"],["が"],["あるでしょう"],["か"],["。"],["あなた"],["の"],["まこと"],["は"],["、"],["あなた"],["を"],["めぐって"],["います"],["。"]]},{"verse":10,"text":"[9]あなたは海,うみの荒,あれるのを治,おさめ、その波,なみの起,おこるとき、これを静,しずめられます。","tok":[["["],["9"],["]"],["あなた"],["は"],["海","うみ"],["の"],["荒れる","あれる"],["の"],["を"],["治め","おさめ"],["、"],["その"],["波","なみ"],["の"],["起こる","おこる"],["とき"],["、"],["これ"],["を"],["静められます","しずめられます"],["。"]]},{"verse":11,"text":"[10]あなたはラハブを、殺,ころされた者,もののように打,うち砕,くだき、あなたの敵,てきを力,ちからある腕,うでをもって散,ちらされました。","tok":[["["],["10"],["]"],["あなた"],["は"],["ラハブ"],["を"],["、"],["殺ろされた","ころされた"],["者","もの"],["の"],["よう"],["に"],["打ち砕き","うちくだき"],["、"],["あなた"],["の"],["敵","てき"],["を"],["力","ちから"],["ある"],["腕","うで"],["を"],["もって"],["散らされました","ちらされました"],["。"]]},{"verse":12,"text":"[11]もろもろの天,てんはあなたのもの、地,ちもまたあなたのもの、世界,せかいとその中,なかにあるものとはあなたがその基,もといをおかれたものです。","tok":[["["],["11"],["]"],["もろもろ"],["の"],["天","てん"],["は"],["あなた"],["の"],["もの"],["、"],["地","ち"],["も"],["また"],["あなた"],["の"],["もの"],["、"],["世界","せかい"],["と"],["その"],["中","なか"],["に"],["ある"],["もの"],["と"],["は"],["あなた"],["が"],["その"],["基い","もとい"],["を"],["おかれた"],["もの"],["です"],["。"]]},{"verse":13,"text":"[12]北,きたと南,みなみはあなたがこれを造,つくられました。タボルとヘルモンは、み名,なを喜,よろこび歌,うたいます。","tok":[["["],["12"],["]"],["北","きた"],["と"],["南","みなみ"],["は"],["あなた"],["が"],["これ"],["を"],["造られました","つくられました"],["。"],["タボル"],["と"],["ヘルモン"],["は"],["、"],["み名","みな"],["を"],["喜こび","よろこび"],["歌います","うたいます"],["。"]]},{"verse":14,"text":"[13]あなたは大能,たいのうの腕,うでをもたれます。あなたの手,ては強,つよく、あなたの右,みぎの手,ては高,たかく、","tok":[["["],["13"],["]"],["あなた"],["は"],["大能","たいのう"],["の"],["腕","うで"],["を"],["もたれます"],["。"],["あなた"],["の"],["手","て"],["は"],["強く","つよく"],["、"],["あなた"],["の"],["右","みぎ"],["の"],["手","て"],["は"],["高かく","たかく"],["、"]]},{"verse":15,"text":"[14]義,ぎと公平,こうへいはあなたのみくらの基,もとい、いつくしみと、まことはあなたの前,まえに行,いきます。","tok":[["["],["14"],["]"],["義","ぎ"],["と"],["公平","こうへい"],["は"],["あなた"],["のみ"],["くら"],["の"],["基い","もとい"],["、"],["いつくしみ"],["と"],["、"],["まこと"],["は"],["あなた"],["の"],["前","まえ"],["に"],["行きます","いきます"],["。"]]},{"verse":16,"text":"[15]祭,まつりの日,ひの喜,よろこびの声,こえを知,しる民,たみはさいわいです。主,しゅよ、彼,かれらはみ顔,かおの光,ひかりのなかを歩,あゆみ、","tok":[["["],["15"],["]"],["祭","まつり"],["の"],["日","ひ"],["の"],["喜こび","よろこび"],["の"],["声","こえ"],["を"],["知る","しる"],["民","たみ"],["は"],["さいわい"],["です"],["。"],["主","しゅ"],["よ"],["、"],["彼","かれ"],["ら"],["は"],["み顔","みかお"],["の"],["光","ひかり"],["の"],["なか"],["を"],["歩み","あゆみ"],["、"]]},{"verse":17,"text":"[16]ひねもす、み名,なによって喜,よろこび、あなたの義,ぎをほめたたえます。","tok":[["["],["16"],["]"],["ひねもす"],["、"],["み名","みな"],["によって"],["喜こび","よろこび"],["、"],["あなた"],["の"],["義","ぎ"],["を"],["ほめたたえます"],["。"]]},{"verse":18,"text":"[17]あなたは彼,かれらの力,ちからの栄光,えいこうだからです。われらの角,つのはあなたの恵,めぐみによって高,たかくあげられるでしょう。","tok":[["["],["17"],["]"],["あなた"],["は"],["彼","かれ"],["ら"],["の"],["力","ちから"],["の"],["栄光","えいこう"],["だ"],["から"],["です"],["。"],["われ"],["ら"],["の"],["角","つ"],["の"],["は"],["あなた"],["の"],["恵","めぐみ"],["によって"],["高かく","たかく"],["あげられるでしょう"],["。"]]},{"verse":19,"text":"[18]われらの盾,たては主,しゅに属,ぞくし、われらの王,おうはイスラエルの聖者,せいじゃに属,ぞくします。","tok":[["["],["18"],["]"],["われ"],["ら"],["の"],["盾","たて"],["は"],["主に","しゅに"],["属し","ぞくし"],["、"],["われ"],["ら"],["の"],["王","おう"],["は"],["イスラエル"],["の"],["聖者","せいじゃ"],["に"],["属します","ぞくします"],["。"]]},{"verse":20,"text":"[19]昔,むかしあなたは幻,まぼろしをもってあなたの聖徒,せいとに告,つげて言,いわれました、「わたしは勇士,ゆうしに栄冠,えいかんを授,さづけ、民,たみの中,なかから選,えらばれた者,ものを高,たかくあげた。","tok":[["["],["19"],["]"],["昔","むかし"],["あなた"],["は"],["幻","まぼろし"],["を"],["もって"],["あなた"],["の"],["聖徒","せいと"],["に"],["告","つげ"],["て"],["言われました","いわれました"],["、"],["「"],["わたし"],["は"],["勇士","ゆうし"],["に"],["栄冠","えいかん"],["を"],["授","さ"],["づけ"],["、"],["民","たみ"],["の"],["中","なか"],["から"],["選ら","えら"],["ばれた"],["者","もの"],["を"],["高かく","たかく"],["あげた"],["。"]]},{"verse":21,"text":"[20]わたしはわがしもべダビデを得,えて、これにわが聖,せいなる油,あぶらをそそいだ。","tok":[["["],["20"],["]"],["わたし"],["は"],["わが"],["しもべ"],["ダビデ"],["を"],["得て","えて"],["、"],["これ"],["に"],["わが"],["聖","せい"],["なる"],["油","あぶら"],["を"],["そそいだ"],["。"]]},{"verse":22,"text":"[21]わが手,ては常,つねに彼,かれと共,ともにあり、わが腕,うではまた彼,かれを強,つよくする。","tok":[["["],["21"],["]"],["わが"],["手","て"],["は"],["常","つね"],["に"],["彼","かれ"],["と"],["共","とも"],["に"],["あり"],["、"],["わが"],["腕","うで"],["は"],["また"],["彼","かれ"],["を"],["強く","つよく"],["する"],["。"]]},{"verse":23,"text":"[22]敵,てきは彼,かれをだますことなく、悪,あしき者,ものは彼,かれを卑,いやしめることはない。","tok":[["["],["22"],["]"],["敵","てき"],["は"],["彼","かれ"],["を"],["だます"],["こと"],["なく"],["、"],["悪しき","あしき"],["者","もの"],["は"],["彼","かれ"],["を"],["卑しめる","いやしめる"],["こと"],["は"],["ない"],["。"]]},{"verse":24,"text":"[23]わたしは彼,かれの前,まえにもろもろのあだを打,うち滅,ほろぼし、彼,かれを憎,にくむ者,ものどもを打,うち倒,たおす。","tok":[["["],["23"],["]"],["わたし"],["は"],["彼","かれ"],["の"],["前","まえ"],["に"],["もろもろ"],["の"],["あだ"],["を"],["打ち滅ぼし","うちほろぼし"],["、"],["彼","かれ"],["を"],["憎む","にくむ"],["者","もの"],["ども"],["を"],["打ち倒す","うちたおす"],["。"]]},{"verse":25,"text":"[24]わがまことと、わがいつくしみは彼,かれと共,ともにあり、わが名,なによって彼,かれの角,つのは高,たかくあげられる。","tok":[["["],["24"],["]"],["わが"],["まこと"],["と"],["、"],["わが"],["いつくしみ"],["は"],["彼","かれ"],["と"],["共","とも"],["に"],["あり"],["、"],["わが"],["名","な"],["によって"],["彼","かれ"],["の"],["角","つ"],["の"],["は"],["高かく","たかく"],["あげられる"],["。"]]},{"verse":26,"text":"[25]わたしは彼,かれの手,てを海,うみの上,うえにおき、彼,かれの右,みぎの手,てを川,かわの上,うえにおく。","tok":[["["],["25"],["]"],["わたし"],["は"],["彼","かれ"],["の"],["手","て"],["を"],["海","うみ"],["の"],["上","うえ"],["に"],["おき"],["、"],["彼","かれ"],["の"],["右","みぎ"],["の"],["手","て"],["を"],["川","かわ"],["の"],["上","うえ"],["に"],["おく"],["。"]]},{"verse":27,"text":"[26]彼,かれはわたしにむかい『あなたはわが父,ちち、わが神,かみ、わが救,すくいの岩,いわ』と呼,よぶであろう。","tok":[["["],["26"],["]"],["彼","かれ"],["は"],["わたし"],["に"],["むかい"],["『"],["あなた"],["は"],["わが"],["父","ちち"],["、"],["わが"],["神","かみ"],["、"],["わが"],["救い","すくい"],["の"],["岩","いわ"],["』"],["と"],["呼ぶで","よぶで"],["あろう"],["。"]]},{"verse":28,"text":"[27]わたしはまた彼,かれをわがういごとし、地,ちの王,おうたちのうちの最,もっとも高,たかい者,ものとする。","tok":[["["],["27"],["]"],["わたし"],["は"],["また"],["彼","かれ"],["を"],["わが"],["うい"],["ごとし"],["、"],["地","ち"],["の"],["王","おう"],["たち"],["の"],["うち"],["の"],["最も","もっとも"],["高い","たかい"],["者","もの"],["と"],["する"],["。"]]},{"verse":29,"text":"[28]わたしはとこしえに、わがいつくしみを彼,かれのために保,たもち、わが契約,けいやくは彼,かれのために堅,かたく立,たつ。","tok":[["["],["28"],["]"],["わたし"],["は"],["とこしえ"],["に"],["、"],["わが"],["いつくしみ"],["を"],["彼","かれ"],["の"],["ため"],["に"],["保ち","たもち"],["、"],["わが"],["契約","けいやく"],["は"],["彼","かれ"],["の"],["ため"],["に"],["堅く","かたく"],["立つ","たつ"],["。"]]},{"verse":30,"text":"[29]わたしは彼,かれの家系,かけいをとこしえに堅,かたく定,さだめ、その位,くらいを天,てんの日,ひ数,かずのようにながらえさせる。","tok":[["["],["29"],["]"],["わたし"],["は"],["彼","かれ"],["の"],["家系","かけい"],["を"],["とこしえ"],["に"],["堅く","かたく"],["定め","さだめ"],["、"],["その"],["位","くらい"],["を"],["天","てん"],["の"],["日数","ひかず"],["の"],["よう"],["に"],["ながらえさせる"],["。"]]},{"verse":31,"text":"[30]もしその子孫,しそんがわがおきてを捨,すて、わがさばきに従,したがって歩,あゆまないならば、","tok":[["["],["30"],["]"],["もし"],["その"],["子孫","しそん"],["が"],["わが"],["おきて"],["を"],["捨て","すて"],["、"],["わが"],["さばき"],["に"],["従って","したがって"],["歩まないならば","あゆまないならば"],["、"]]},{"verse":32,"text":"[31]もし彼,かれらがわが定,さだめを犯,おかし、わが戒,いましめを守,まもらないならば、","tok":[["["],["31"],["]"],["もし"],["彼","かれ"],["ら"],["が"],["わが"],["定め","さだめ"],["を"],["犯し","おかし"],["、"],["わが"],["戒しめ","いましめ"],["を"],["守らないならば","まもらないならば"],["、"]]},{"verse":33,"text":"[32]わたしはつえをもって彼,かれらのとがを罰,ばっし、むちをもって彼,かれらの不義,ふぎを罰,ばっする。","tok":[["["],["32"],["]"],["わたし"],["は"],["つえ"],["を"],["もって"],["彼","かれ"],["ら"],["の"],["とが"],["を"],["罰し","ばっし"],["、"],["むち"],["を"],["もって"],["彼","かれ"],["ら"],["の"],["不義","ふぎ"],["を"],["罰する","ばっする"],["。"]]},{"verse":34,"text":"[33]しかし、わたしはわがいつくしみを彼,かれから取,とり去,さることなく、わがまことにそむくことはない。","tok":[["["],["33"],["]"],["しかし"],["、"],["わたし"],["は"],["わが"],["いつくしみ"],["を"],["彼","かれ"],["から"],["取去る","とりさる"],["こと"],["なく"],["、"],["わが"],["まこと"],["に"],["そむく"],["こと"],["は"],["ない"],["。"]]},{"verse":35,"text":"[34]わたしはわが契約,けいやくを破,やぶることなく、わがくちびるから出,でた言葉,ことばを変,かえることはない。","tok":[["["],["34"],["]"],["わたし"],["は"],["わが"],["契約","けいやく"],["を"],["破る","やぶる"],["こと"],["なく"],["、"],["わが"],["くちびる"],["から"],["出た","でた"],["言葉","ことば"],["を"],["変える","かえる"],["こと"],["は"],["ない"],["。"]]},{"verse":36,"text":"[35]わたしはひとたびわが聖,せいによって誓,ちかった。わたしはダビデに偽,いつわりを言,いわない。","tok":[["["],["35"],["]"],["わたし"],["は"],["ひとたび"],["わが"],["聖","せい"],["によって"],["誓った","ちかった"],["。"],["わたし"],["は"],["ダビデ"],["に"],["偽り","いつわり"],["を"],["言わない","いわない"],["。"]]},{"verse":37,"text":"[36]彼,かれの家系,かけいはとこしえに続,つづき、彼,かれの位,くらいは太陽,たいようのように常,つねにわたしの前,まえにある。","tok":[["["],["36"],["]"],["彼","かれ"],["の"],["家系","かけい"],["は"],["とこしえ"],["に"],["続き","つづき"],["、"],["彼","かれ"],["の"],["位","くらい"],["は"],["太陽","たいよう"],["の"],["よう"],["に"],["常","つね"],["に"],["わたし"],["の"],["前","まえ"],["に"],["ある"],["。"]]},{"verse":38,"text":"[37]また月,つきのようにとこしえに堅,かたく定,さだめられ、大空,おおぞらの続,つづくかぎり堅,かたく立,たつ」。〔セラ","tok":[["["],["37"],["]"],["また"],["月","つき"],["の"],["よう"],["に"],["とこしえ"],["に"],["堅く","かたく"],["定められ","さだめられ"],["、"],["大空","おおぞら"],["の"],["続く","つづく"],["かぎり"],["堅く","かたく"],["立つ","たつ"],["」"],["。"],["〔"],["セラ"]]},{"verse":39,"text":"[38]しかしあなたは、あなたの油,あぶらそそがれた者,ものを捨,すててしりぞけ、彼,かれに対,たいして激,はげしく怒,いかられました。","tok":[["["],["38"],["]"],["しかし"],["あなた"],["は"],["、"],["あなた"],["の"],["油","あぶら"],["そそがれた"],["者","もの"],["を"],["捨てて","すてて"],["しりぞけ"],["、"],["彼","かれ"],["に対して","にたいして"],["激しく","はげしく"],["怒","い"],["から"],["れました"],["。"]]},{"verse":40,"text":"[39]あなたはそのしもべとの契約,けいやくを廃棄,はいきし、彼,かれの冠,かんむりを地,ちになげうって、けがされました。","tok":[["["],["39"],["]"],["あなた"],["は"],["その"],["しもべ"],["と"],["の"],["契約","けいやく"],["を"],["廃棄","はいき"],["し"],["、"],["彼","かれ"],["の"],["冠","かんむり"],["を"],["地","ち"],["に"],["なげうって"],["、"],["けが"],["されました"],["。"]]},{"verse":41,"text":"[40]あなたはその城壁,じょうへきをことごとくこわし、そのとりでを荒,あれすたれさせられました。","tok":[["["],["40"],["]"],["あなた"],["は"],["その"],["城壁","じょうへき"],["を"],["ことごとく"],["こわし"],["、"],["その"],["とりで"],["を"],["荒れ","あれ"],["すたれさせられました"],["。"]]},{"verse":42,"text":"[41]そこを通,とおり過,すぎる者,ものは皆,みな彼,かれをかすめ、彼,かれはその隣,となり人,びとのあざけりとなりました。","tok":[["["],["41"],["]"],["そこ"],["を"],["通り","とおり"],["過る","すぎる"],["者","もの"],["は"],["皆","みな"],["彼","かれ"],["を"],["かすめ"],["、"],["彼","かれ"],["は"],["その"],["隣人","となりびと"],["の"],["あざけり"],["と"],["なりました"],["。"]]},{"verse":43,"text":"[42]あなたは彼,かれのあだの右,みぎの手,てを高,たかくあげ、そのもろもろの敵,てきを喜,よろこばせられました。","tok":[["["],["42"],["]"],["あなた"],["は"],["彼","かれ"],["の"],["あだ"],["の"],["右","みぎ"],["の"],["手","て"],["を"],["高かく","たかく"],["あげ"],["、"],["その"],["もろもろ"],["の"],["敵","てき"],["を"],["喜こばせられました","よろこばせられました"],["。"]]},{"verse":44,"text":"[43]まことに、あなたは彼,かれのつるぎの刃,はをかえして、彼,かれを戦,たたかいに立,たたせられなかったのです。","tok":[["["],["43"],["]"],["まこと"],["に"],["、"],["あなた"],["は"],["彼","かれ"],["の"],["つるぎ"],["の"],["刃","は"],["を"],["かえして"],["、"],["彼","かれ"],["を"],["戦い","たたかい"],["に"],["立たせられなかった","たたせられなかった"],["の"],["です"],["。"]]},{"verse":45,"text":"[44]あなたは彼,かれの手,てから王,おうのつえを取,とり去,さり、その王座,おうざを地,ちに投,なげすてられました。","tok":[["["],["44"],["]"],["あなた"],["は"],["彼","かれ"],["の"],["手","て"],["から"],["王","おう"],["の"],["つえ"],["を"],["取去り","とりさり"],["、"],["その"],["王座","おうざ"],["を"],["地","ち"],["に"],["投","なげ"],["すてられました"],["。"]]},{"verse":46,"text":"[45]あなたは彼,かれの若,わかき日,ひをちぢめ、恥,はじをもって彼,かれをおおわれました。〔セラ","tok":[["["],["45"],["]"],["あなた"],["は"],["彼","かれ"],["の"],["若き","わかき"],["日","ひ"],["を"],["ちぢめ"],["、"],["恥","はじ"],["を"],["もって"],["彼","かれ"],["を"],["おおわれました"],["。"],["〔"],["セラ"]]},{"verse":47,"text":"[46]主,しゅよ、いつまでなのですか。とこしえにお隠,おかくれになるのですか。あなたの怒,いかりはいつまで火,ひのように燃,もえるのですか。","tok":[["["],["46"],["]"],["主","しゅ"],["よ"],["、"],["いつ"],["まで"],["な"],["の"],["です"],["か"],["。"],["とこしえ"],["に"],["お隠","おおかくれ"],["に"],["なる"],["の"],["です"],["か"],["。"],["あなた"],["の"],["怒り","いかり"],["は"],["いつ"],["まで"],["火","ひ"],["の"],["よう"],["に"],["燃える","もえる"],["の"],["です"],["か"],["。"]]},{"verse":48,"text":"[47]主,しゅよ、人,ひとのいのちの、いかに短,みじかく、すべての人,ひとの子,こを、いかにはかなく造,つくられたかを、みこころにとめてください。","tok":[["["],["47"],["]"],["主","しゅ"],["よ"],["、"],["人","ひと"],["の"],["いのち"],["の"],["、"],["いかに"],["短く","みじかく"],["、"],["すべて"],["の"],["人","ひと"],["の"],["子","こ"],["を"],["、"],["いかに"],["はかなく"],["造られた","つくられた"],["か"],["を"],["、"],["みこころ"],["に"],["とめて"],["ください"],["。"]]},{"verse":49,"text":"[48]だれか生,いきて死,しを見,みず、その魂,たましいを陰府,よみの力,ちからから救,すくいうるものがあるでしょうか。〔セラ","tok":[["["],["48"],["]"],["だれ"],["か"],["生きて","いきて"],["死","し"],["を"],["見ず","みず"],["、"],["その"],["魂","たましい"],["を"],["陰府","よみ"],["の"],["力","ちから"],["から"],["救い","すくい"],["うる"],["もの"],["が"],["あるでしょう"],["か"],["。"],["〔"],["セラ"]]},{"verse":50,"text":"[49]主,しゅよ、あなたがまことをもってダビデに誓,ちかわれた昔,むかしのいつくしみはどこにありますか。","tok":[["["],["49"],["]"],["主","しゅ"],["よ"],["、"],["あなた"],["が"],["まこと"],["を"],["もって"],["ダビデ"],["に"],["誓われた","ちかわれた"],["昔","むかし"],["の"],["いつくしみ"],["は"],["どこ"],["に"],["あります"],["か"],["。"]]},{"verse":51,"text":"[50-51]主,しゅよ、あなたのしもべがうけるはずかしめをみこころにとめてください。主,しゅよ、あなたのもろもろの敵,てきはわたしをそしり、あなたの油,あぶらそそがれた者,ものの足跡,あしあとをそしります。わたしはもろもろの民,たみのそしりをわたしのふところにいだいているのです。","tok":[["["],["50"],["-"],["51"],["]"],["主","しゅ"],["よ"],["、"],["あなた"],["の"],["しもべ"],["が"],["うける"],["はず"],["かしめ"],["を"],["みこころ"],["に"],["とめて"],["ください"],["。"],["主","しゅ"],["よ"],["、"],["あなた"],["の"],["もろもろ"],["の"],["敵","てき"],["は"],["わたし"],["を"],["そしり"],["、"],["あなた"],["の"],["油","あぶら"],["そそがれた"],["者","もの"],["の"],["足跡","あしあと"],["を"],["そしります"],["。"],["わたし"],["は"],["もろもろ"],["の"],["民","たみ"],["の"],["そ"],["しり"],["を"],["わたし"],["の"],["ふところ"],["に"],["いだいて"],["いる"],["の"],["です"],["。"]]},{"verse":52,"text":"*[50-51]主,しゅよ、あなたのしもべがうけるはずかしめをみこころにとめてください。主,しゅよ、あなたのもろもろの敵,てきはわたしをそしり、あなたの油,あぶらそそがれた者,ものの足跡,あしあとをそしります。わたしはもろもろの民,たみのそしりをわたしのふところにいだいているのです。","tok":[["*"],["["],["50"],["-"],["51"],["]"],["主","しゅ"],["よ"],["、"],["あなた"],["の"],["しもべ"],["が"],["うける"],["はず"],["かしめ"],["を"],["みこころ"],["に"],["とめて"],["ください"],["。"],["主","しゅ"],["よ"],["、"],["あなた"],["の"],["もろもろ"],["の"],["敵","てき"],["は"],["わたし"],["を"],["そしり"],["、"],["あなた"],["の"],["油","あぶら"],["そそがれた"],["者","もの"],["の"],["足跡","あしあと"],["を"],["そしります"],["。"],["わたし"],["は"],["もろもろ"],["の"],["民","たみ"],["の"],["そ"],["しり"],["を"],["わたし"],["の"],["ふところ"],["に"],["いだいて"],["いる"],["の"],["です"],["。"]]},{"verse":53,"text":"[52]主,しゅはとこしえにほむべきかな。アァメン、アァメン。","tok":[["["],["52"],["]"],["主","しゅ"],["は"],["とこしえ"],["に"],["ほ"],["むべき"],["か"],["な"],["。"],["アァメン"],["、"],["アァメン"],["。"]]}]
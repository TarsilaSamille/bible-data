[{"verse":1,"text":"【ダビデの祈,いのり】主,しゅよ、あなたの耳,みみを傾,かたむけて、わたしにお答,こたえください。わたしは苦,くるしみかつ乏,とぼしいからです。","tok":[["【"],["ダビデ"],["の"],["祈","いのり"],["】"],["主","しゅ"],["よ"],["、"],["あなた"],["の"],["耳","みみ"],["を"],["傾むけて","かたむけて"],["、"],["わたし"],["に"],["お答","おこたえ"],["ください"],["。"],["わたし"],["は"],["苦しみ","くるしみ"],["かつ"],["乏い","とぼしい"],["から"],["です"],["。"]]},{"verse":2,"text":"わたしのいのちをお守,まもりください。わたしは神,かみを敬,うやまう者,ものだからです。あなたに信頼,しんらいするあなたのしもべをお救,すくいください。あなたはわたしの神,かみです。","tok":[["わたし"],["の"],["いのち"],["を"],["お守り","おまもり"],["ください"],["。"],["わたし"],["は"],["神","かみ"],["を"],["敬う","うやまう"],["者","もの"],["だ"],["から"],["です"],["。"],["あなた"],["に"],["信頼","しんらい"],["する"],["あなた"],["の"],["しもべ"],["を"],["お救い","おすくい"],["ください"],["。"],["あなた"],["は"],["わたし"],["の"],["神","かみ"],["です"],["。"]]},{"verse":3,"text":"主,しゅよ、わたしをあわれんでください。わたしはひねもすあなたに呼,よばわります。","tok":[["主","しゅ"],["よ"],["、"],["わたし"],["を"],["あわれんで"],["ください"],["。"],["わたし"],["は"],["ひねもす"],["あなた"],["に"],["呼ばわります","よばわります"],["。"]]},{"verse":4,"text":"あなたのしもべの魂,たましいを喜,よろこばせてください。主,しゅよ、わが魂,たましいはあなたを仰,あおぎ望,のぞみます。","tok":[["あなた"],["の"],["しもべ"],["の"],["魂","たましい"],["を"],["喜こばせて","よろこばせて"],["ください"],["。"],["主","しゅ"],["よ"],["、"],["わが"],["魂","たましい"],["は"],["あなた"],["を"],["仰ぎ","あおぎ"],["望みます","のぞみます"],["。"]]},{"verse":5,"text":"主,しゅよ、あなたは恵,めぐみふかく、寛容,かんようであって、あなたに呼,よばわるすべての者,ものにいつくしみを豊,ゆたかに施,ほどこされます。","tok":[["主","しゅ"],["よ"],["、"],["あなた"],["は"],["恵","めぐみ"],["ふかく"],["、"],["寛容","かんよう"],["で"],["あって"],["、"],["あなた"],["に"],["呼ばわる","よばわる"],["すべて"],["の"],["者","もの"],["に"],["いつくしみ"],["を"],["豊","ゆたか"],["に"],["施されます","ほどこされます"],["。"]]},{"verse":6,"text":"主,しゅよ、わたしの祈,いのりに耳,みみを傾,かたむけ、わたしの願,ねがいの声,こえをお聞,ききください。","tok":[["主","しゅ"],["よ"],["、"],["わたし"],["の"],["祈","いのり"],["に"],["耳","みみ"],["を"],["傾むけ","かたむけ"],["、"],["わたし"],["の"],["願い","ねがい"],["の"],["声","こえ"],["を"],["お聞く","おききく"],["ださい"],["。"]]},{"verse":7,"text":"わたしの悩,なやみの日,ひにわたしはあなたに呼,よばわります。あなたはわたしに答,こたえられるからです。","tok":[["わたし"],["の"],["悩み","なやみ"],["の"],["日","ひ"],["に"],["わたし"],["は"],["あなた"],["に"],["呼ばわります","よばわります"],["。"],["あなた"],["は"],["わたし"],["に"],["答","こたえ"],["られる"],["から"],["です"],["。"]]},{"verse":8,"text":"主,しゅよ、もろもろの神,かみのうちにあなたに等,ひとしい者,ものはなく、また、あなたのみわざに等,ひとしいものはありません。","tok":[["主","しゅ"],["よ"],["、"],["もろもろ"],["の"],["神","かみ"],["の"],["うち"],["に"],["あなた"],["に"],["等い","ひとしい"],["者","もの"],["は"],["なく"],["、"],["また"],["、"],["あなた"],["のみ"],["わざ"],["に"],["等い","ひとしい"],["もの"],["は"],["ありません"],["。"]]},{"verse":9,"text":"主,しゅよ、あなたが造,つくられたすべての国民,こくみんはあなたの前,まえに来,きて、伏,ふし拝,おがみ、み名,なをあがめるでしょう。","tok":[["主","しゅ"],["よ"],["、"],["あなた"],["が"],["造られた","つくられた"],["すべて"],["の"],["国民","こくみん"],["は"],["あなた"],["の"],["前","まえ"],["に"],["来て","きて"],["、"],["伏し拝み","ふしおがみ"],["、"],["み名","みな"],["を"],["あがめるでしょう"],["。"]]},{"verse":10,"text":"あなたは大,おおいなる神,かみで、くすしきみわざをなされます。ただあなたのみ、神,かみでいらせられます。","tok":[["あなた"],["は"],["大いなる","おおいなる"],["神","かみ"],["で"],["、"],["くす"],["しきみ"],["わざ"],["を"],["なされます"],["。"],["ただ"],["あなた"],["のみ"],["、"],["神","かみ"],["で"],["いらせられます"],["。"]]},{"verse":11,"text":"主,しゅよ、あなたの道,みちをわたしに教,おしえてください。わたしはあなたの真理,しんりに歩,あゆみます。心,こころをひとつにしてみ名,なを恐,おそれさせてください。","tok":[["主","しゅ"],["よ"],["、"],["あなた"],["の"],["道","みち"],["を"],["わたし"],["に"],["教えて","おしえて"],["ください"],["。"],["わたし"],["は"],["あなた"],["の"],["真理","しんり"],["に"],["歩みます","あゆみます"],["。"],["心","こころ"],["を"],["ひと"],["つ"],["に"],["して"],["み"],["名","な"],["を"],["恐れさせて","おそれさせて"],["ください"],["。"]]},{"verse":12,"text":"わが神,かみ、主,しゅよ、わたしは心,こころをつくしてあなたに感謝,かんしゃし、とこしえに、み名,なをあがめるでしょう。","tok":[["わが"],["神","かみ"],["、"],["主","しゅ"],["よ"],["、"],["わたし"],["は"],["心","こころ"],["を"],["つくして"],["あなた"],["に"],["感謝","かんしゃ"],["し"],["、"],["とこしえ"],["に"],["、"],["み名","みな"],["を"],["あがめるでしょう"],["。"]]},{"verse":13,"text":"わたしに示,しめされたあなたのいつくしみは大,おおきく、わが魂,たましいを陰府,よみの深,ふかい所,ところから助,たすけ出,だされたからです。","tok":[["わたし"],["に"],["示めされた","しめされた"],["あなた"],["の"],["いつくしみ"],["は"],["大きく","おおきく"],["、"],["わが"],["魂","たましい"],["を"],["陰府","よみ"],["の"],["深い","ふかい"],["所","ところ"],["から"],["助け出された","たすけだされた"],["から"],["です"],["。"]]},{"verse":14,"text":"神,かみよ、高,たかぶる者,ものはわたしに逆,さからって起,おこり、荒,あらぶる者,ものの群,むれはわたしのいのちを求,もとめ、彼,かれらは自分,じぶんの前,まえにあなたを置,おくことをしません。","tok":[["神","かみ"],["よ"],["、"],["高か","たか"],["ぶる"],["者","もの"],["は"],["わたし"],["に"],["逆らって","さからって"],["起こり","おこり"],["、"],["荒ぶる","あらぶる"],["者","もの"],["の"],["群れ","むれ"],["は"],["わたし"],["の"],["いのち"],["を"],["求め","もとめ"],["、"],["彼","かれ"],["ら"],["は"],["自分","じぶん"],["の"],["前","まえ"],["に"],["あなた"],["を"],["置く","おく"],["こと"],["を"],["しません"],["。"]]},{"verse":15,"text":"しかし主,しゅよ、あなたはあわれみと恵,めぐみに富,とみ、怒,いかりをおそくし、いつくしみと、まこととに豊,ゆたかな神,かみでいらせられます。","tok":[["しかし"],["主","しゅ"],["よ"],["、"],["あなた"],["は"],["あわれみ"],["と"],["恵","めぐみ"],["に"],["富","とみ"],["、"],["怒り","いかり"],["を"],["おそく"],["し"],["、"],["いつくしみ"],["と"],["、"],["まこと"],["と"],["に"],["豊","ゆたか"],["な"],["神","かみ"],["で"],["いらせられます"],["。"]]},{"verse":16,"text":"わたしをかえりみ、わたしをあわれみ、あなたのしもべにみ力,ちからを与,あたえ、あなたのはしための子,こをお救,すくいください。","tok":[["わたし"],["を"],["かえりみ"],["、"],["わたし"],["を"],["あわれみ"],["、"],["あなた"],["の"],["しもべ"],["に"],["み力","みちから"],["を"],["与","あたえ"],["、"],["あなた"],["の"],["はし"],["ため"],["の"],["子","こ"],["を"],["お救い","おすくい"],["ください"],["。"]]},{"verse":17,"text":"わたしに、あなたの恵,めぐみのしるしをあらわしてください。そうすれば、わたしを憎,にくむ者,ものどもはわたしを見,みて恥,はじるでしょう。主,しゅよ、あなたはわたしを助,たすけ、わたしを慰,なぐさめられたからです。","tok":[["わたし"],["に"],["、"],["あなた"],["の"],["恵","めぐみ"],["の"],["しるし"],["を"],["あらわして"],["ください"],["。"],["そう"],["すれば"],["、"],["わたし"],["を"],["憎む","にくむ"],["者","もの"],["ども"],["は"],["わたし"],["を"],["見て","みて"],["恥","はじ"],["るでしょう"],["。"],["主","しゅ"],["よ"],["、"],["あなた"],["は"],["わたし"],["を"],["助け","たすけ"],["、"],["わたし"],["を"],["慰さめられた","なぐさめられた"],["から"],["です"],["。"]]}]
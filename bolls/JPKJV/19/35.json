[{"verse":1,"text":"【ダビデの歌,うた】主,しゅよ、わたしと争,あらそう者,ものとあらそい、わたしと戦,たたかう者,ものと戦,たたかってください。","tok":[["【"],["ダビデ"],["の"],["歌","うた"],["】"],["主","しゅ"],["よ"],["、"],["わたし"],["と"],["争う","あらそう"],["者","もの"],["と"],["あらそい"],["、"],["わたし"],["と"],["戦う","たたかう"],["者","もの"],["と"],["戦って","たたかって"],["ください"],["。"]]},{"verse":2,"text":"盾,たてと大盾,おおだてとを執,とって、わたしを助,たすけるために立,たちあがってください。","tok":[["盾","たて"],["と"],["大","だい"],["盾","たて"],["を"],["執って","とって"],["、"],["わたし"],["を"],["助ける","たすける"],["ため"],["に"],["立ちあがって","たちあがって"],["ください"],["。"]]},{"verse":3,"text":"やりと投,なげやりとを抜,ぬいて、わたしに追,おい迫,せまる者,ものに立,たちむかい、「わたしはおまえの救,すくいである」と、わたしに言,いってください。","tok":[["やり"],["と"],["投","なげ"],["やり"],["と"],["を"],["抜いて","ぬいて"],["、"],["わたし"],["に"],["追い","おい"],["迫まる","せまる"],["者","もの"],["に"],["立ちむかい","たちむかい"],["、"],["「"],["わたし"],["は"],["おまえ"],["の"],["救い","すくい"],["で"],["ある"],["」"],["と"],["、"],["わたし"],["に"],["言って","いって"],["ください"],["。"]]},{"verse":4,"text":"どうか、わたしの命,いのちを求,もとめる者,ものをはずかしめ、いやしめ、わたしにむかって悪,あくをたくらむ者,ものを退,しりぞけ、あわてふためかせてください。","tok":[["どう"],["か"],["、"],["わたし"],["の"],["命","いのち"],["を"],["求める","もとめる"],["者","もの"],["を"],["はずかしめ"],["、"],["いやしめ"],["、"],["わたし"],["に"],["むかって"],["悪","あく"],["を"],["たくらむ"],["者","もの"],["を"],["退ぞけ","しりぞけ"],["、"],["あわてふためかせて"],["ください"],["。"]]},{"verse":5,"text":"彼,かれらを風,かぜの前,まえのもみがらのようにし、主,しゅの使,つかいに彼,かれらを追,おいやらせてください。","tok":[["彼","かれ"],["ら"],["を"],["風","かぜ"],["の"],["前","まえ"],["の"],["もみがら"],["の"],["よう"],["に"],["し"],["、"],["主","しゅ"],["の"],["使","つかい"],["に"],["彼","かれ"],["ら"],["を"],["追いやらせて","おいやらせて"],["ください"],["。"]]},{"verse":6,"text":"彼,かれらの道,みちを暗,くらく、なめらかにし、主,しゅの使,つかいに彼,かれらを追,おい行,いかせてください。","tok":[["彼","かれ"],["ら"],["の"],["道","みち"],["を"],["暗く","くらく"],["、"],["なめらか"],["に"],["し"],["、"],["主","しゅ"],["の"],["使","つかい"],["に"],["彼","かれ"],["ら"],["を"],["追い","おい"],["行かせて","いかせて"],["ください"],["。"]]},{"verse":7,"text":"彼,かれらはゆえなくわたしのために網,あみを隠,かくし、ゆえなくわたしのために穴,あなを掘,ほったからです。","tok":[["彼","かれ"],["ら"],["は"],["ゆえなく"],["わたし"],["の"],["ため"],["に"],["網","あみ"],["を"],["隠し","かくし"],["、"],["ゆえなく"],["わたし"],["の"],["ため"],["に"],["穴","あな"],["を"],["掘った","ほった"],["から"],["です"],["。"]]},{"verse":8,"text":"不意,ふいに滅,ほろびを彼,かれらに臨,のぞませ、みずから隠,かくした網,あみにとらえられ、彼,かれらを滅,ほろびに陥,おちいらせてください。","tok":[["不意","ふい"],["に"],["滅び","ほろび"],["を"],["彼","かれ"],["ら"],["に"],["臨ませ","のぞませ"],["、"],["みずから"],["隠した","かくした"],["網","あみ"],["に"],["とらえられ"],["、"],["彼","かれ"],["ら"],["を"],["滅び","ほろび"],["に"],["陥ち","おち"],["いらせて"],["ください"],["。"]]},{"verse":9,"text":"そのときわが魂,たましいは主,しゅによって喜,よろこび、その救,すくいをもって楽,たのしむでしょう。","tok":[["その"],["ときわ"],["が"],["魂","たましい"],["は"],["主に","しゅに"],["よって"],["喜こび","よろこび"],["、"],["その"],["救い","すくい"],["を"],["もって"],["楽しむでしょう","たのしむでしょう"],["。"]]},{"verse":10,"text":"わたしの骨,ほねはことごとく言,いうでしょう、「主,しゅよ、だれかあなたにたぐうべき者,ものがありましょう。あなたは弱,よわい者,ものを強,つよい者,ものから助,たすけ出,だし、弱,よわい者,ものと貧,まずしい者,ものを、かすめ奪,うばう者,ものから助,たすけ出,だされる方,ほうです」と。","tok":[["わたし"],["の"],["骨","ほね"],["は"],["ことごとく"],["言うでしょう","いうでしょう"],["、"],["「"],["主","しゅ"],["よ"],["、"],["だれ"],["か"],["あなた"],["に"],["たぐうべき"],["者","もの"],["が"],["ありましょう"],["。"],["あなた"],["は"],["弱い","よわい"],["者","もの"],["を"],["強い","つよい"],["者","もの"],["から"],["助け出し","たすけだし"],["、"],["弱い","よわい"],["者","もの"],["と"],["貧しい","まずしい"],["者","もの"],["を"],["、"],["かすめ"],["奪う","うばう"],["者","もの"],["から"],["助け出される","たすけだされる"],["方","ほう"],["です"],["」"],["と"],["。"]]},{"verse":11,"text":"悪意,あくいのある証人,しょうにんが起,たって、わたしの知,しらない事,ことをわたしに尋,たずねる。","tok":[["悪意","あくい"],["の"],["ある"],["証人","しょうにん"],["が"],["起って","たって"],["、"],["わたし"],["の"],["知らない","しらない"],["事","こと"],["を"],["わたし"],["に"],["尋ねる","たずねる"],["。"]]},{"verse":12,"text":"彼,かれらは悪,あくをもってわたしの善,ぜんに報,むくい、わが魂,たましいを寄,よるべなき者,ものとした。","tok":[["彼","かれ"],["ら"],["は"],["悪","あく"],["を"],["もって"],["わたし"],["の"],["善","ぜん"],["に"],["報い","むくい"],["、"],["わが"],["魂","たましい"],["を"],["寄るべ","よるべ"],["なき"],["者","もの"],["と"],["した"],["。"]]},{"verse":13,"text":"しかし、わたしは彼,かれらが病,やんだとき、荒布,あらぬのをまとい、断食,だんじきしてわが身,みを苦,くるしめた。わたしは胸,むねにこうべをたれて祈,いのった、","tok":[["しかし"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["が"],["病んだ","やんだ"],["とき"],["、"],["荒布","あらぬ"],["の"],["を"],["まとい"],["、"],["断食","だんじき"],["して"],["わが"],["身","み"],["を"],["苦しめた","くるしめた"],["。"],["わたし"],["は"],["胸","むね"],["に"],["こうべ"],["を"],["たれて"],["祈った","いのった"],["、"]]},{"verse":14,"text":"ちょうど、わが友,とも、わが兄弟,きょうだいのために悲,かなしんだかのように。わたしは母,ははをいたむ者,もののように悲,かなしみうなだれて歩,あるきまわった。","tok":[["ちょうど"],["、"],["わが"],["友","とも"],["、"],["わが"],["兄弟","きょうだい"],["の"],["ため"],["に"],["悲しんだ","かなしんだ"],["か"],["の"],["よう"],["に"],["。"],["わたし"],["は"],["母","はは"],["を"],["いたむ"],["者","もの"],["の"],["よう"],["に"],["悲しみ","かなしみ"],["うなだれて"],["歩き","あるき"],["まわった"],["。"]]},{"verse":15,"text":"しかし彼,かれらはわたしのつまずくとき、喜,よろこびつどい、ともに集,あつまってわたしを責,せめた。わたしの知,しらない他国,たこくの者,ものはわたしをののしってやめなかった。","tok":[["しかし"],["彼","かれ"],["ら"],["は"],["わたし"],["の"],["つまずく"],["とき"],["、"],["喜こび","よろこび"],["つどい"],["、"],["とも"],["に"],["集まって","あつまって"],["わたし"],["を"],["責","せめ"],["た"],["。"],["わたし"],["の"],["知らない","しらない"],["他国","たこく"],["の"],["者","もの"],["は"],["わたし"],["を"],["ののしって"],["やめなかった"],["。"]]},{"verse":16,"text":"彼,かれらはますます、けがす言葉,ことばをもってあざけり、わたしにむかって歯,はをかみならした。","tok":[["彼","かれ"],["ら"],["は"],["ますます"],["、"],["けがす"],["言葉","ことば"],["を"],["もって"],["あざけり"],["、"],["わたし"],["に"],["むかって"],["歯","は"],["を"],["かみ"],["ならした"],["。"]]},{"verse":17,"text":"主,しゅよ、いつまであなたはながめておられますか、わたしを彼,かれらの破壊,はかいから、わたしのいのちを若,わかきししから救,すくい出,だしてください。","tok":[["主","しゅ"],["よ"],["、"],["いつ"],["まで"],["あなた"],["は"],["ながめて"],["おられます"],["か"],["、"],["わたし"],["を"],["彼","かれ"],["ら"],["の"],["破壊","はかい"],["から"],["、"],["わたし"],["の"],["いのち"],["を"],["若き","わかき"],["しし"],["から"],["救い出して","すくいだして"],["ください"],["。"]]},{"verse":18,"text":"わたしは大,おおいなるつどいの中,なかで、あなたに感謝,かんしゃし、多,おおくの民,たみの中,なかで、あなたをほめたたえるでしょう。","tok":[["わたし"],["は"],["大いなる","おおいなる"],["つどい"],["の"],["中","なか"],["で"],["、"],["あなた"],["に"],["感謝","かんしゃ"],["し"],["、"],["多く","おおく"],["の"],["民","たみ"],["の"],["中","なか"],["で"],["、"],["あなた"],["を"],["ほめたたえるでしょう"],["。"]]},{"verse":19,"text":"偽,いつわってわたしの敵,てきとなった者,ものどものわたしについて喜,よろこぶことを許,ゆるさないでください。ゆえなく、わたしを憎,にくむ者,ものどものたがいに目,めくばせすることを許,ゆるさないでください。","tok":[["偽わって","いつわって"],["わたし"],["の"],["敵","てき"],["と"],["なった"],["者","もの"],["ども"],["の"],["わたし"],["について"],["喜こぶ","よろこぶ"],["こと"],["を"],["許さないで","ゆるさないで"],["ください"],["。"],["ゆえ"],["なく"],["、"],["わたし"],["を"],["憎む","にくむ"],["者","もの"],["ども"],["の"],["たがい"],["に"],["目くばせ","めくばせ"],["する"],["こと"],["を"],["許さないで","ゆるさないで"],["ください"],["。"]]},{"verse":20,"text":"彼,かれらは平和,へいわを語,かたらず、国,くにのうちに穏,おだやかに住,すむ者,ものにむかって欺,あざむきの言葉,ことばをたくらむからです。","tok":[["彼","かれ"],["ら"],["は"],["平和","へいわ"],["を"],["語らず","かたらず"],["、"],["国","くに"],["の"],["うち"],["に"],["穏","おだやか"],["に"],["住む","すむ"],["者","もの"],["に"],["むかって"],["欺き","あざむき"],["の"],["言葉","ことば"],["を"],["たくらむ"],["から"],["です"],["。"]]},{"verse":21,"text":"彼,かれらはわたしにむかって口,くちをあけひろげ、「あはぁ、あはぁ、われらの目,めはそれを見,みた」と言,いいます。","tok":[["彼","かれ"],["ら"],["は"],["わたし"],["に"],["むかって"],["口","くち"],["を"],["あけひろげ"],["、"],["「"],["あ"],["はぁ"],["、"],["あ"],["はぁ"],["、"],["われ"],["ら"],["の"],["目","め"],["は"],["それ"],["を"],["見た","みた"],["」"],["と"],["言います","いいます"],["。"]]},{"verse":22,"text":"主,しゅよ、あなたはこれを見,みられました。もださないでください。主,しゅよ、わたしに遠,とおざからないでください。","tok":[["主","しゅ"],["よ"],["、"],["あなた"],["は"],["これ"],["を"],["見られました","みられました"],["。"],["もださないで"],["ください"],["。"],["主","しゅ"],["よ"],["、"],["わたし"],["に"],["遠ざからないで","とおざからないで"],["ください"],["。"]]},{"verse":23,"text":"わが神,かみ、わが主,しゅよ、わがさばきのため、わが訴,うったえのために奮,ふるいたち、目,めをさましてください。","tok":[["わが"],["神","かみ"],["、"],["わが"],["主","しゅ"],["よ"],["、"],["わが"],["さばき"],["の"],["ため"],["、"],["わが"],["訴","うったえ"],["の"],["ため"],["に"],["奮いたち","ふるいたち"],["、"],["目","め"],["を"],["さまして"],["ください"],["。"]]},{"verse":24,"text":"わが神,かみ、主,しゅよ、あなたの義,ぎにしたがってわたしをさばき、わたしの事,ことについて彼,かれらを喜,よろこばせないでください。","tok":[["わが"],["神","かみ"],["、"],["主","しゅ"],["よ"],["、"],["あなた"],["の"],["義","ぎ"],["に"],["したがって"],["わたし"],["を"],["さばき"],["、"],["わたし"],["の"],["事","こと"],["について"],["彼","かれ"],["ら"],["を"],["喜こばせないで","よろこばせないで"],["ください"],["。"]]},{"verse":25,"text":"彼,かれらにその心,こころのうちで、「あはぁ、われらの願,ねがったことが達,たっせられた」と言,いわせないでください。また彼,かれらに「われらは彼,かれを滅,ほろぼしつくした」と言,いわせないでください。","tok":[["彼","かれ"],["ら"],["に"],["その"],["心","こころ"],["の"],["うち"],["で"],["、"],["「"],["あ"],["はぁ"],["、"],["われ"],["ら"],["の"],["願った","ねがった"],["こと"],["が"],["達せられた","たっせられた"],["」"],["と"],["言わせないで","いわせないで"],["ください"],["。"],["また"],["彼","かれ"],["ら"],["に"],["「"],["われ"],["ら"],["は"],["彼","かれ"],["を"],["滅ぼし","ほろぼし"],["つくした"],["」"],["と"],["言わせないで","いわせないで"],["ください"],["。"]]},{"verse":26,"text":"わたしの災,わざわいを喜,よろこぶ者,ものどもをともに恥,はじ、あわてふためかせてください。わたしにむかって誇,ほこりたかぶる者,ものどもに恥,はじと、はずかしめとを着,きせてください。","tok":[["わたし"],["の"],["災","わざわい"],["を"],["喜こぶ","よろこぶ"],["者","もの"],["ども"],["を"],["とも"],["に"],["恥","はじ"],["、"],["あわてふためかせて"],["ください"],["。"],["わたし"],["に"],["むかって"],["誇","ほこり"],["たかぶる"],["者","もの"],["ども"],["に"],["恥","はじ"],["と"],["、"],["はずかしめ"],["と"],["を"],["着せて","きせて"],["ください"],["。"]]},{"verse":27,"text":"わたしの義,ぎを喜,よろこぶ者,ものをば喜,よろこびの声,こえをあげて喜,よろこばせ、「そのしもべの幸福,こうふくを喜,よろこばれる主,しゅは大,おおいなるかな」とつねに言,いわせてください。","tok":[["わたし"],["の"],["義","ぎ"],["を"],["喜こぶ","よろこぶ"],["者","もの"],["をば"],["喜こび","よろこび"],["の"],["声","こえ"],["を"],["あげて"],["喜こばせ","よろこばせ"],["、"],["「"],["その"],["しもべ"],["の"],["幸福","こうふく"],["を"],["喜こばれる","よろこばれる"],["主","しゅ"],["は"],["大いなる","おおいなる"],["か"],["な"],["」"],["と"],["つね"],["に"],["言わせて","いわせて"],["ください"],["。"]]},{"verse":28,"text":"わたしの舌,したはひねもすあなたの義,ぎと、あなたの誉,ほまれとを語,かたるでしょう。","tok":[["わたし"],["の"],["舌","した"],["は"],["ひねもす"],["あなた"],["の"],["義","ぎ"],["と"],["、"],["あなた"],["の"],["誉","ほまれ"],["と"],["を"],["語るでしょう","かたるでしょう"],["。"]]}]
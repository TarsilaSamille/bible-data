[{"verse":1,"text":"主,しゅをほめたたえよ、主,しゅのみ名,なをほめたたえよ。主,しゅのしもべたちよ、ほめたたえよ。","tok":[["主","しゅ"],["を"],["ほめたたえよ"],["、"],["主","しゅ"],["のみ"],["名","な"],["を"],["ほめたたえ"],["よ"],["。"],["主","しゅ"],["の"],["しもべ"],["たち"],["よ"],["、"],["ほめたたえ"],["よ"],["。"]]},{"verse":2,"text":"主,しゅの家,いえに立,たつ者,もの、われらの神,かみの家,いえの大庭,おおにわに立,たつ者,ものよ、ほめたたえよ。","tok":[["主","しゅ"],["の"],["家","いえ"],["に"],["立つ","たつ"],["者","もの"],["、"],["われ"],["ら"],["の"],["神","かみ"],["の"],["家","いえ"],["の"],["大庭","おおにわ"],["に"],["立つ","たつ"],["者","もの"],["よ"],["、"],["ほめたたえ"],["よ"],["。"]]},{"verse":3,"text":"主,しゅは恵,めぐみふかい、主,しゅをほめたたえよ。主,しゅは情,じょうぶかい、そのみ名,なをほめ歌,うたえ。","tok":[["主","しゅ"],["は"],["恵","めぐみ"],["ふかい"],["、"],["主","しゅ"],["を"],["ほめたたえ"],["よ"],["。"],["主","しゅ"],["は"],["情","じょう"],["ぶかい"],["、"],["その"],["み名","みな"],["を"],["ほめ"],["歌え","うたえ"],["。"]]},{"verse":4,"text":"主,しゅはおのがためにヤコブを選,えらび、イスラエルを選,えらんで、おのれの所有,しょゆうとされた。","tok":[["主","しゅ"],["は"],["お"],["の"],["が"],["ため"],["に"],["ヤコブ"],["を"],["選ら","えら"],["び"],["、"],["イスラエル"],["を"],["選らんで","えらんで"],["、"],["おのれ"],["の"],["所有","しょゆう"],["と"],["された"],["。"]]},{"verse":5,"text":"わたしは主,しゅの大,おおいなることと、われらの主,しゅのすべての神,かみにまさることとを知,しっている。","tok":[["わたし"],["は"],["主","しゅ"],["の"],["大いなる","おおいなる"],["こと"],["と"],["、"],["われ"],["ら"],["の"],["主","しゅ"],["の"],["すべて"],["の"],["神","かみ"],["に"],["まさる"],["こと"],["と"],["を"],["知って","しって"],["いる"],["。"]]},{"verse":6,"text":"主,しゅはそのみこころにかなう事,ことを、天,てんにも地,ちにも、海,うみにもすべての淵,ふちにも行,おこなわれる。","tok":[["主","しゅ"],["は"],["その"],["みこころ"],["に"],["かなう"],["事","こと"],["を"],["、"],["天","てん"],["に"],["も"],["地","ち"],["に"],["も"],["、"],["海","うみ"],["に"],["も"],["すべて"],["の"],["淵","ふち"],["に"],["も"],["行なわれる","おこなわれる"],["。"]]},{"verse":7,"text":"主,しゅは地,ちのはてから雲,くもをのぼらせ、雨,あめのためにいなずまを造,つくり、その倉,くらから風,かぜを出,だされる。","tok":[["主","しゅ"],["は"],["地","ち"],["の"],["はて"],["から"],["雲","くも"],["を"],["のぼらせ"],["、"],["雨","あめ"],["の"],["ため"],["に"],["いなずま"],["を"],["造","つくり"],["、"],["その"],["倉","くら"],["から"],["風","かぜ"],["を"],["出される","だされる"],["。"]]},{"verse":8,"text":"主,しゅは人,ひとから獣,けものにいたるまで、エジプトのういごを撃,うたれた。","tok":[["主","しゅ"],["は"],["人","ひと"],["から"],["獣","けもの"],["に"],["いたる"],["まで"],["、"],["エジプト"],["の"],["うい"],["ご"],["を"],["撃たれた","うたれた"],["。"]]},{"verse":9,"text":"エジプトよ、主,しゅはおまえの中,なかに、しるしと不思議,ふしぎとを送,おくって、パロとそのすべてのしもべとに臨,のぞまれた。","tok":[["エジプト"],["よ"],["、"],["主","しゅ"],["は"],["おまえ"],["の"],["中","なか"],["に"],["、"],["しるし"],["と"],["不思議","ふしぎ"],["と"],["を"],["送って","おくって"],["、"],["パロ"],["と"],["その"],["すべて"],["の"],["しもべ"],["と"],["に"],["臨まれた","のぞまれた"],["。"]]},{"verse":10,"text":"主,しゅは多,おおくの国民,こくみんを撃,うち、力,ちからある王,おうたちを殺,ころされた。","tok":[["主","しゅ"],["は"],["多く","おおく"],["の"],["国民","こくみん"],["を"],["撃ち","うち"],["、"],["力","ちから"],["ある"],["王","おう"],["たち"],["を"],["殺ろされた","ころされた"],["。"]]},{"verse":11,"text":"すなわちアモリびとの王,おうシホン、バシャンの王,おうオグ、ならびにカナンのすべての国々,くにぐにである。","tok":[["すなわち"],["アモリ"],["びと"],["の"],["王","おう"],["シホン"],["、"],["バシャン"],["の"],["王","おう"],["オグ"],["、"],["ならびに"],["カナン"],["の"],["すべて"],["の"],["国々","くにぐに"],["で"],["ある"],["。"]]},{"verse":12,"text":"主,しゅは彼,かれらの地,ちを嗣,し業,ぎょうとし、その民,たみイスラエルに嗣,し業,ぎょうとして与,あたえられた。","tok":[["主","しゅ"],["は"],["彼","かれ"],["ら"],["の"],["地","ち"],["を"],["嗣業","しぎょ"],["う"],["と"],["し"],["、"],["その"],["民","た"],["みイスラエル"],["に"],["嗣業","しぎょう"],["として"],["与えられた","あたえられた"],["。"]]},{"verse":13,"text":"主,しゅよ、あなたのみ名,なはとこしえに絶,たえることがない。主,しゅよ、あなたの名声,めいせいはよろずよに及,およぶ。","tok":[["主","しゅ"],["よ"],["、"],["あなた"],["のみ"],["名","な"],["は"],["とこしえ"],["に"],["絶える","たえる"],["こと"],["が"],["ない"],["。"],["主","しゅ"],["よ"],["、"],["あなた"],["の"],["名声","めいせい"],["は"],["よろず"],["よ"],["に"],["及ぶ","およぶ"],["。"]]},{"verse":14,"text":"主,しゅはその民,たみをさばき、そのしもべらにあわれみをかけられるからである。","tok":[["主","しゅ"],["は"],["その"],["民","たみ"],["を"],["さばき"],["、"],["その"],["しもべ"],["ら"],["に"],["あわれみ"],["を"],["かけられる"],["から"],["で"],["ある"],["。"]]},{"verse":15,"text":"もろもろの国民,こくみんの偶像,ぐうぞうはしろがねと、こがねで、人,ひとの手,てのわざである。","tok":[["もろもろ"],["の"],["国民","こくみん"],["の"],["偶像","ぐうぞう"],["は"],["しろがね"],["と"],["、"],["こがね"],["で"],["、"],["人","ひと"],["の"],["手","て"],["の"],["わざ"],["で"],["ある"],["。"]]},{"verse":16,"text":"それは口,くちがあっても語,かたることができない。目,めがあっても見,みることができない。","tok":[["それ"],["は"],["口","くち"],["が"],["あって"],["も"],["語る","かたる"],["こと"],["が"],["できない"],["。"],["目","め"],["が"],["あって"],["も"],["見る","みる"],["こと"],["が"],["できない"],["。"]]},{"verse":17,"text":"耳,みみがあっても聞,きくことができない。またその口,くちには息,いきがない。","tok":[["耳","みみ"],["が"],["あって"],["も"],["聞く","きく"],["こと"],["が"],["できない"],["。"],["また"],["その"],["口","くち"],["に"],["は"],["息","いき"],["が"],["ない"],["。"]]},{"verse":18,"text":"これを造,つくる者,ものと、これに信頼,しんらいする者,ものとはみな、これと等,ひとしい者,ものになる。","tok":[["これ"],["を"],["造る","つくる"],["者","もの"],["と"],["、"],["これ"],["に"],["信頼","しんらい"],["する"],["者","もの"],["と"],["は"],["みな"],["、"],["これ"],["と"],["等い","ひとしい"],["者","もの"],["に"],["なる"],["。"]]},{"verse":19,"text":"イスラエルの家,いえよ、主,しゅをほめよ。アロンの家,いえよ、主,しゅをほめよ。","tok":[["イスラエル"],["の"],["家","いえ"],["よ"],["、"],["主","しゅ"],["を"],["ほめよ"],["。"],["アロン"],["の"],["家","いえ"],["よ"],["、"],["主","しゅ"],["を"],["ほめよ"],["。"]]},{"verse":20,"text":"レビの家,いえよ、主,しゅをほめよ。主,しゅを恐,おそれる者,ものよ、主,しゅをほめまつれ。","tok":[["レビ"],["の"],["家","いえ"],["よ"],["、"],["主","しゅ"],["を"],["ほめよ"],["。"],["主","しゅ"],["を"],["恐れる","おそれる"],["者","もの"],["よ"],["、"],["主","しゅ"],["を"],["ほめ"],["まつれ"],["。"]]},{"verse":21,"text":"エルサレムに住,すまわれる主,しゅは、シオンからほめたたえらるべきである。主,しゅをほめたたえよ。","tok":[["エルサレム"],["に"],["住まわれる","すまわれる"],["主","しゅ"],["は"],["、"],["シオン"],["から"],["ほめたたえらるべきで"],["ある"],["。"],["主","しゅ"],["を"],["ほめたたえ"],["よ"],["。"]]}]
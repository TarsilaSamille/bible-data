[{"verse":1,"text":"[0]【聖歌,せいか隊,たいの指揮者,しきしゃによって、「滅,ほろぼすな」というしらべにあわせてうたわせたダビデのミクタムの歌,うた。これはダビデが洞,ほらにはいってサウルの手,てをのがれたときによんだもの】","tok":[["["],["0"],["]"],["【"],["聖歌隊","せいかたい"],["の"],["指揮者","しきしゃ"],["によって"],["、"],["「"],["滅ぼす","ほろぼす"],["な"],["」"],["と"],["いう"],["しらべ"],["に"],["あわせて"],["うたわせた"],["ダビデ"],["の"],["ミクタム"],["の"],["歌","うた"],["。"],["これ"],["は"],["ダビデ"],["が"],["洞","ほら"],["に"],["はいって"],["サウル"],["の"],["手","て"],["を"],["のがれた"],["とき"],["に"],["よんだ"],["もの"],["】"]]},{"verse":2,"text":"[1]神,かみよ、わたしをあわれんでください。わたしをあわれんでください。わたしの魂,たましいはあなたに寄,より頼,たのみます。滅,ほろびのあらしの過,すぎ去,さるまではあなたの翼,つばさの陰,かげをわたしの避,さけ所,どころとします。","tok":[["["],["1"],["]"],["神","かみ"],["よ"],["、"],["わたし"],["を"],["あわれんで"],["ください"],["。"],["わたし"],["を"],["あわれんで"],["ください"],["。"],["わたし"],["の"],["魂","たましい"],["は"],["あなた"],["に"],["寄り","より"],["頼みます","たのみます"],["。"],["滅び","ほろび"],["の"],["あらし"],["の"],["過去る","すぎさる"],["まで"],["は"],["あなた"],["の"],["翼","つばさ"],["の"],["陰","かげ"],["を"],["わたし"],["の"],["避け","さけ"],["所","どころ"],["と"],["します"],["。"]]},{"verse":3,"text":"[2]わたしはいと高,たかき神,かみに呼,よばわります。わたしのためにすべての事,ことをなしとげられる神,かみに呼,よばわります。","tok":[["["],["2"],["]"],["わたし"],["はい"],["と"],["高き","たかき"],["神","かみ"],["に"],["呼ばわります","よばわります"],["。"],["わたし"],["の"],["ため"],["に"],["すべて"],["の"],["事","こと"],["を"],["なしとげられる"],["神","かみ"],["に"],["呼ばわります","よばわります"],["。"]]},{"verse":4,"text":"[3]神,かみは天,てんから送,おくってわたしを救,すくい、わたしを踏,ふみつける者,ものをはずかしめられます。〔セラすなわち神,かみはそのいつくしみとまこととを送,おくられるのです。","tok":[["["],["3"],["]"],["神","かみ"],["は"],["天","てん"],["から"],["送って","おくって"],["わたし"],["を"],["救い","すくい"],["、"],["わたし"],["を"],["踏みつける","ふみつける"],["者","もの"],["を"],["はずかしめられます"],["。"],["〔"],["セラ"],["すなわち"],["神","かみ"],["は"],["その"],["いつくしみ"],["と"],["まこと"],["と"],["を"],["送られる","おくられる"],["の"],["です"],["。"]]},{"verse":5,"text":"[4]わたしは人,ひとの子,こらをむさぼり食,くらうししの中,なかに横,よこたわっています。彼,かれらの歯,ははほこ、また矢,や、彼,かれらの舌,したは鋭,するどいつるぎです。","tok":[["["],["4"],["]"],["わたし"],["は"],["人","ひと"],["の"],["子","こ"],["ら"],["を"],["むさぼり食らう","むさぼりくらう"],["しし"],["の"],["中","なか"],["に"],["横たわって","よこたわって"],["います"],["。"],["彼","かれ"],["ら"],["の"],["歯","は"],["は"],["ほ"],["こ"],["、"],["また"],["矢","や"],["、"],["彼","かれ"],["ら"],["の"],["舌","した"],["は"],["鋭い","するどい"],["つるぎ"],["です"],["。"]]},{"verse":6,"text":"[5]神,かみよ、みずからを天,てんよりも高,たかくし、みさかえを全,ぜん地,ちの上,うえにあげてください。","tok":[["["],["5"],["]"],["神","かみ"],["よ"],["、"],["みずから"],["を"],["天","てん"],["より"],["も"],["高かく","たかく"],["し"],["、"],["みさか"],["え"],["を"],["全地","ぜんち"],["の"],["上","うえ"],["に"],["あげて"],["ください"],["。"]]},{"verse":7,"text":"[6]彼,かれらはわたしの足,あしを捕,とらえようと網,あみを設,もうけました。わたしの魂,たましいはうなだれました。彼,かれらはわたしの前,まえに穴,あなを掘,ほりました。しかし彼,かれらはみずからその中,なかに陥,おちいったのです。〔セラ","tok":[["["],["6"],["]"],["彼","かれ"],["ら"],["は"],["わたし"],["の"],["足","あし"],["を"],["捕らえよう","とらえよう"],["と"],["網","あみ"],["を"],["設けました","もうけました"],["。"],["わたし"],["の"],["魂","たましい"],["は"],["うなだれました"],["。"],["彼","かれ"],["ら"],["は"],["わたし"],["の"],["前","まえ"],["に"],["穴","あな"],["を"],["掘","ほり"],["ました"],["。"],["しかし"],["彼","かれ"],["ら"],["は"],["みずから"],["その"],["中","なか"],["に"],["陥た","おちいった"],["の"],["です"],["。"],["〔"],["セラ"]]},{"verse":8,"text":"[7]神,かみよ、わたしの心,こころは定,さだまりました。わたしの心,こころは定,さだまりました。わたしは歌,うたい、かつほめたたえます。","tok":[["["],["7"],["]"],["神","かみ"],["よ"],["、"],["わたし"],["の"],["心","こころ"],["は"],["定まりました","さだまりました"],["。"],["わたし"],["の"],["心","こころ"],["は"],["定まりました","さだまりました"],["。"],["わたし"],["は"],["歌い","うたい"],["、"],["かつ"],["ほめたたえます"],["。"]]},{"verse":9,"text":"[8]わが魂,たましいよ、さめよ。立琴,たてごとよ、琴,ことよ、さめよ。わたしはしののめを呼,よびさまします。","tok":[["["],["8"],["]"],["わが"],["魂","たましい"],["よ"],["、"],["さめ"],["よ"],["。"],["立琴","たてごと"],["よ"],["、"],["琴","こと"],["よ"],["、"],["さめ"],["よ"],["。"],["わたし"],["は"],["しののめ"],["を"],["呼びさまします","よびさまします"],["。"]]},{"verse":10,"text":"[9]主,しゅよ、わたしはもろもろの民,たみの中,なかであなたに感謝,かんしゃし、もろもろの国,くにの中,なかであなたをほめたたえます。","tok":[["["],["9"],["]"],["主","しゅ"],["よ"],["、"],["わたし"],["は"],["もろもろ"],["の"],["民","たみ"],["の"],["中","なか"],["で"],["あなた"],["に"],["感謝","かんしゃ"],["し"],["、"],["もろもろ"],["の"],["国","くに"],["の"],["中","なか"],["で"],["あなた"],["を"],["ほめたたえます"],["。"]]},{"verse":11,"text":"[10]あなたのいつくしみは大,おおきく、天,てんにまで及,および、あなたのまことは雲,くもにまで及,およびます。","tok":[["["],["10"],["]"],["あなた"],["の"],["いつくしみ"],["は"],["大きく","おおきく"],["、"],["天","てん"],["に"],["まで"],["及","および"],["、"],["あなた"],["の"],["まこと"],["は"],["雲","くも"],["に"],["まで"],["及","および"],["ます"],["。"]]},{"verse":12,"text":"[11]神,かみよ、みずからを天,てんよりも高,たかくし、みさかえを全,ぜん地,ちの上,うえにあげてください。","tok":[["["],["11"],["]"],["神","かみ"],["よ"],["、"],["みずから"],["を"],["天","てん"],["より"],["も"],["高かく","たかく"],["し"],["、"],["みさか"],["え"],["を"],["全地","ぜんち"],["の"],["上","うえ"],["に"],["あげて"],["ください"],["。"]]}]
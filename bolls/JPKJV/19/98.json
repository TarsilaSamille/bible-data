[{"verse":1,"text":"【歌,うた】新,あたらしき歌,うたを主,しゅにむかってうたえ。主,しゅはくすしきみわざをなされたからである。その右,みぎの手,てと聖,せいなる腕,うでとは、おのれのために勝利,しょうりを得,えられた。","tok":[["【"],["歌","うた"],["】"],["新らしき","あたらしき"],["歌","うた"],["を"],["主に","しゅに"],["むかって"],["うたえ"],["。"],["主","しゅ"],["は"],["くす"],["しきみ"],["わざ"],["を"],["なされた"],["から"],["で"],["ある"],["。"],["その"],["右","みぎ"],["の"],["手","て"],["と"],["聖","せい"],["なる"],["腕","うで"],["と"],["は"],["、"],["おのれ"],["の"],["ため"],["に"],["勝利","しょうり"],["を"],["得られた","えられた"],["。"]]},{"verse":2,"text":"主,しゅはその勝利,しょうりを知,しらせ、その義,ぎをもろもろの国民,こくみんの前,まえにあらわされた。","tok":[["主","しゅ"],["は"],["その"],["勝利","しょうり"],["を"],["知らせ","しらせ"],["、"],["その"],["義","ぎ"],["を"],["もろもろ"],["の"],["国民","こくみん"],["の"],["前","まえ"],["に"],["あらわされた"],["。"]]},{"verse":3,"text":"主,しゅはそのいつくしみと、まこととをイスラエルの家,いえにむかって覚,おぼえられた。地,ちのもろもろのはては、われらの神,かみの勝利,しょうりを見,みた。","tok":[["主","しゅ"],["は"],["その"],["いつくしみ"],["と"],["、"],["まこと"],["と"],["を"],["イスラエル"],["の"],["家","いえ"],["に"],["むかって"],["覚えられた","おぼえられた"],["。"],["地","ち"],["の"],["もろもろ"],["の"],["はて"],["は"],["、"],["われ"],["ら"],["の"],["神","かみ"],["の"],["勝利","しょうり"],["を"],["見た","みた"],["。"]]},{"verse":4,"text":"全,ぜん地,ちよ、主,しゅにむかって喜,よろこばしき声,こえをあげよ。声,こえを放,はなって喜,よろこび歌,うたえ、ほめうたえ。","tok":[["全地","ぜんち"],["よ"],["、"],["主に","しゅに"],["むかって"],["喜こば","よろこば"],["しき"],["声","こえ"],["を"],["あげ"],["よ"],["。"],["声","こえ"],["を"],["放って","はなって"],["喜こび","よろこび"],["歌え","うたえ"],["、"],["ほめ"],["うたえ"],["。"]]},{"verse":5,"text":"琴,ことをもって主,しゅをほめうたえ。琴,ことと歌,うたの声,こえをもってほめうたえ。","tok":[["琴","こと"],["を"],["もって"],["主","しゅ"],["を"],["ほめ"],["うたえ"],["。"],["琴","こと"],["と"],["歌","うた"],["の"],["声","こえ"],["を"],["もって"],["ほめ"],["うたえ"],["。"]]},{"verse":6,"text":"ラッパと角笛,つのぶえの音,おとをもって王,おうなる主,しゅの前,まえに喜,よろこばしき声,こえをあげよ。","tok":[["ラッパ"],["と"],["角笛","つのぶえ"],["の"],["音","おと"],["を"],["もって"],["王","おう"],["なる"],["主","しゅ"],["の"],["前","まえ"],["に"],["喜こば","よろこば"],["しき"],["声","こえ"],["を"],["あげ"],["よ"],["。"]]},{"verse":7,"text":"海,うみとその中,なかに満,みちるもの、世界,せかいとそのうちに住,すむ者,ものとは鳴,なりどよめけ。","tok":[["海","うみ"],["と"],["その"],["中","なか"],["に"],["満ちる","みちる"],["もの"],["、"],["世界","せかい"],["と"],["その"],["うち"],["に"],["住む","すむ"],["者","もの"],["と"],["は"],["鳴り","なり"],["どよめけ"],["。"]]},{"verse":8,"text":"大水,おおみずはその手,てを打,うち、もろもろの山,やまは共,ともに主,しゅのみ前,まえに喜,よろこび歌,うたえ。","tok":[["大水","おおみず"],["は"],["その"],["手","て"],["を"],["打ち","うち"],["、"],["もろもろ"],["の"],["山","やま"],["は"],["共","とも"],["に"],["主","しゅ"],["のみ"],["前","まえ"],["に"],["喜こび","よろこび"],["歌え","うたえ"],["。"]]},{"verse":9,"text":"主,しゅは地,ちをさばくために来,こられるからである。主,しゅは義,ぎをもって世界,せかいをさばき、公平,こうへいをもってもろもろの民,たみをさばかれる。","tok":[["主","しゅ"],["は"],["地","ち"],["を"],["さばく"],["ため"],["に"],["来られる","こられる"],["から"],["で"],["ある"],["。"],["主","しゅ"],["は"],["義","ぎ"],["を"],["もって"],["世界","せかい"],["を"],["さばき"],["、"],["公平","こうへい"],["を"],["もって"],["もろもろ"],["の"],["民","たみ"],["を"],["さばかれる"],["。"]]}]
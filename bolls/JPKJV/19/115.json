[{"verse":1,"text":"主,しゅよ、栄光,えいこうをわれらにではなく、われらにではなく、あなたのいつくしみと、まこととのゆえに、ただ、み名,なにのみ帰,きしてください。","tok":[["主","しゅ"],["よ"],["、"],["栄光","えいこう"],["を"],["われ"],["ら"],["に"],["で"],["は"],["なく"],["、"],["われ"],["ら"],["に"],["で"],["は"],["なく"],["、"],["あなた"],["の"],["いつくしみ"],["と"],["、"],["まこと"],["と"],["の"],["ゆえ"],["に"],["、"],["ただ"],["、"],["み名","みな"],["に"],["のみ"],["帰して","きして"],["ください"],["。"]]},{"verse":2,"text":"なにゆえ、もろもろの国民,こくみんは言,いうのでしょう、「彼,かれらの神,かみはどこにいるのか」と。","tok":[["なにゆえ"],["、"],["もろもろ"],["の"],["国民","こくみん"],["は"],["言う","いう"],["の"],["でしょう"],["、"],["「"],["彼","かれ"],["ら"],["の"],["神","かみ"],["は"],["どこ"],["に"],["いる"],["の"],["か"],["」"],["と"],["。"]]},{"verse":3,"text":"われらの神,かみは天,てんにいらせられる。神,かみはみこころにかなうすべての事,ことを行,おこなわれる。","tok":[["われ"],["ら"],["の"],["神","かみ"],["は"],["天","てん"],["に"],["いらせられる"],["。"],["神","かみ"],["は"],["みこころ"],["に"],["かなう"],["すべて"],["の"],["事","こと"],["を"],["行なわれる","おこなわれる"],["。"]]},{"verse":4,"text":"彼,かれらの偶像,ぐうぞうはしろがねと、こがねで、人,ひとの手,てのわざである。","tok":[["彼","かれ"],["ら"],["の"],["偶像","ぐうぞう"],["は"],["しろがね"],["と"],["、"],["こがね"],["で"],["、"],["人","ひと"],["の"],["手","て"],["の"],["わざ"],["で"],["ある"],["。"]]},{"verse":5,"text":"それは口,くちがあっても語,かたることができない。目,めがあっても見,みることができない。","tok":[["それ"],["は"],["口","くち"],["が"],["あって"],["も"],["語る","かたる"],["こと"],["が"],["できない"],["。"],["目","め"],["が"],["あって"],["も"],["見る","みる"],["こと"],["が"],["できない"],["。"]]},{"verse":6,"text":"耳,みみがあっても聞,きくことができない。鼻,はながあってもかぐことができない。","tok":[["耳","みみ"],["が"],["あって"],["も"],["聞く","きく"],["こと"],["が"],["できない"],["。"],["鼻","はな"],["が"],["あって"],["も"],["かぐ"],["こと"],["が"],["できない"],["。"]]},{"verse":7,"text":"手,てがあっても取,とることができない。足,あしがあっても歩,あるくことができない。また、のどから声,こえを出,だすこともできない。","tok":[["手","て"],["が"],["あって"],["も"],["取る","とる"],["こと"],["が"],["できない"],["。"],["足","あし"],["が"],["あって"],["も"],["歩く","あるく"],["こと"],["が"],["できない"],["。"],["また"],["、"],["のど"],["から"],["声","こえ"],["を"],["出す","だす"],["こと"],["も"],["できない"],["。"]]},{"verse":8,"text":"これを造,つくる者,ものと、これに信頼,しんらいする者,ものとはみな、これと等,ひとしい者,ものになる。","tok":[["これ"],["を"],["造る","つくる"],["者","もの"],["と"],["、"],["これ"],["に"],["信頼","しんらい"],["する"],["者","もの"],["と"],["は"],["みな"],["、"],["これ"],["と"],["等い","ひとしい"],["者","もの"],["に"],["なる"],["。"]]},{"verse":9,"text":"イスラエルよ、主,しゅに信頼,しんらいせよ。主,しゅは彼,かれらの助,たすけ、また彼,かれらの盾,たてである。","tok":[["イスラエル"],["よ"],["、"],["主に","しゅに"],["信頼","しんらい"],["せよ"],["。"],["主","しゅ"],["は"],["彼","かれ"],["ら"],["の"],["助け","たすけ"],["、"],["また"],["彼","かれ"],["ら"],["の"],["盾","たて"],["で"],["ある"],["。"]]},{"verse":10,"text":"アロンの家,いえよ、主,しゅに信頼,しんらいせよ。主,しゅは彼,かれらの助,たすけ、また彼,かれらの盾,たてである。","tok":[["アロン"],["の"],["家","いえ"],["よ"],["、"],["主に","しゅに"],["信頼","しんらい"],["せよ"],["。"],["主","しゅ"],["は"],["彼","かれ"],["ら"],["の"],["助け","たすけ"],["、"],["また"],["彼","かれ"],["ら"],["の"],["盾","たて"],["で"],["ある"],["。"]]},{"verse":11,"text":"主,しゅを恐,おそれる者,ものよ、主,しゅに信頼,しんらいせよ。主,しゅは彼,かれらの助,たすけ、また彼,かれらの盾,たてである。","tok":[["主","しゅ"],["を"],["恐れる","おそれる"],["者","もの"],["よ"],["、"],["主に","しゅに"],["信頼","しんらい"],["せよ"],["。"],["主","しゅ"],["は"],["彼","かれ"],["ら"],["の"],["助け","たすけ"],["、"],["また"],["彼","かれ"],["ら"],["の"],["盾","たて"],["で"],["ある"],["。"]]},{"verse":12,"text":"主,しゅはわれらをみこころにとめられた。主,しゅはわれらを恵,めぐみ、イスラエルの家,いえを恵,めぐみ、アロンの家,いえを恵,めぐみ、","tok":[["主","しゅ"],["は"],["われ"],["ら"],["を"],["みこころ"],["に"],["とめられた"],["。"],["主","しゅ"],["は"],["われ"],["ら"],["を"],["恵み","めぐみ"],["、"],["イスラエル"],["の"],["家","いえ"],["を"],["恵み","めぐみ"],["、"],["アロン"],["の"],["家","いえ"],["を"],["恵み","めぐみ"],["、"]]},{"verse":13,"text":"また、小,ちいさい者,ものも、大,おおいなる者,ものも、主,しゅを恐,おそれる者,ものを恵,めぐまれる。","tok":[["また"],["、"],["小さい","ちいさい"],["者","もの"],["も"],["、"],["大いなる","おおいなる"],["者","もの"],["も"],["、"],["主","しゅ"],["を"],["恐れる","おそれる"],["者","もの"],["を"],["恵れる","めぐまれる"],["。"]]},{"verse":14,"text":"どうか、主,しゅがあなたがたを増,まし加,くわえ、あなたがたと、あなたがたの子孫,しそんとを増,まし加,くわえられるように。","tok":[["どう"],["か"],["、"],["主","しゅ"],["が"],["あなた"],["がた"],["を"],["増し加え","ましくわえ"],["、"],["あなた"],["がた"],["と"],["、"],["あなた"],["がた"],["の"],["子孫","しそん"],["と"],["を"],["増し加えられる","ましくわえられる"],["よう"],["に"],["。"]]},{"verse":15,"text":"天地,てんちを造,つくられた主,しゅによってあなたがたが恵,めぐまれるように。","tok":[["天地","てんち"],["を"],["造られた","つくられた"],["主","しゅ"],["によって"],["あなた"],["がた"],["が"],["恵まれる","めぐまれる"],["よう"],["に"],["。"]]},{"verse":16,"text":"天,てんは主,しゅの天,てんである。しかし地,ちは人,ひとの子,こらに与,あたえられた。","tok":[["天","てん"],["は"],["主","しゅ"],["の"],["天","てん"],["で"],["ある"],["。"],["しかし"],["地","ち"],["は"],["人","ひと"],["の"],["子","こ"],["ら"],["に"],["与えられた","あたえられた"],["。"]]},{"verse":17,"text":"死,しんだ者,ものも、音,おとなき所,ところに下,くだる者,ものも、主,しゅをほめたたえることはない。","tok":[["死んだ","しんだ"],["者","もの"],["も"],["、"],["音","おと"],["なき"],["所","ところ"],["に"],["下る","くだる"],["者","もの"],["も"],["、"],["主","しゅ"],["を"],["ほめたたえる"],["こと"],["は"],["ない"],["。"]]},{"verse":18,"text":"しかし、われらは今,いまより、とこしえに至,いたるまで、主,しゅをほめまつるであろう。主,しゅをほめたたえよ。","tok":[["しかし"],["、"],["われ"],["ら"],["は"],["今","いま"],["より"],["、"],["とこしえ"],["に"],["至る","いたる"],["まで"],["、"],["主","しゅ"],["を"],["ほめ"],["まつるで"],["あろう"],["。"],["主","しゅ"],["を"],["ほめたたえ"],["よ"],["。"]]}]
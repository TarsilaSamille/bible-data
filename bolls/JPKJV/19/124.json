[{"verse":1,"text":"【ダビデがよんだ都,みやこもうでの歌,うた】今,いま、イスラエルは言,いえ、主,しゅがもしわれらの方,ほうにおられなかったならば、","tok":[["【"],["ダビデ"],["が"],["よんだ"],["都","みやこもう"],["で"],["の"],["歌","うた"],["】"],["今","いま"],["、"],["イスラエル"],["は"],["言え","いえ"],["、"],["主","しゅ"],["が"],["もし"],["われ"],["ら"],["の"],["方","ほう"],["に"],["おられなかったならば"],["、"]]},{"verse":2,"text":"人々,ひとびとがわれらに逆,さからって立,たちあがったとき、主,しゅがもしわれらの方,ほうにおられなかったならば、","tok":[["人々","ひとびと"],["が"],["われ"],["ら"],["に"],["逆らって","さからって"],["立ちあがった","たちあがった"],["とき"],["、"],["主","しゅ"],["が"],["もし"],["われ"],["ら"],["の"],["方","ほう"],["に"],["おられなかったならば"],["、"]]},{"verse":3,"text":"彼,かれらの怒,いかりがわれらにむかって燃,もえたったとき、彼,かれらはわれらを生,いきているままで、のんだであろう。","tok":[["彼","かれ"],["ら"],["の"],["怒り","いかり"],["が"],["われ"],["ら"],["に"],["むかって"],["燃えたった","もえたった"],["とき"],["、"],["彼","かれ"],["ら"],["は"],["われ"],["ら"],["を"],["生きて","いきて"],["いる"],["まま"],["で"],["、"],["のんだで"],["あろう"],["。"]]},{"verse":4,"text":"また大水,おおみずはわれらを押,おし流,ながし、激流,げきりゅうはわれらの上,うえを越,こえ、","tok":[["また"],["大水","おおみず"],["は"],["われ"],["ら"],["を"],["押","おし"],["流し","ながし"],["、"],["激流","げきりゅう"],["は"],["われ"],["ら"],["の"],["上","うえ"],["を"],["越え","こえ"],["、"]]},{"verse":5,"text":"さか巻,まく水,みずはわれらの上,うえを越,こえたであろう。","tok":[["さ"],["か"],["巻く","まく"],["水","みず"],["は"],["われ"],["ら"],["の"],["上","うえ"],["を"],["越えたで","こえたで"],["あろう"],["。"]]},{"verse":6,"text":"主,しゅはほむべきかな。主,しゅはわれらをえじきとして彼,かれらの歯,はにわたされなかった。","tok":[["主","しゅ"],["は"],["ほ"],["むべき"],["か"],["な"],["。"],["主","しゅ"],["は"],["われ"],["ら"],["を"],["えじき"],["として"],["彼","かれ"],["ら"],["の"],["歯","は"],["に"],["わたされなかった"],["。"]]},{"verse":7,"text":"われらは野鳥,やちょうを捕,とらえるわなをのがれる鳥,とりのようにのがれた。わなは破,やぶれてわれらはのがれた。","tok":[["われ"],["ら"],["は"],["野鳥","やちょう"],["を"],["捕らえる","とらえる"],["わな"],["を"],["のがれる"],["鳥","とり"],["の"],["よう"],["に"],["のがれた"],["。"],["わな"],["は"],["破れて","やぶれて"],["われ"],["ら"],["は"],["のがれた"],["。"]]},{"verse":8,"text":"われらの助,たすけは天地,てんちを造,つくられた主,しゅのみ名,なにある。","tok":[["われ"],["ら"],["の"],["助け","たすけ"],["は"],["天地","てんち"],["を"],["造られた","つくられた"],["主","しゅ"],["のみ"],["名","な"],["に"],["ある"],["。"]]}]
[{"verse":1,"text":"[0]第,だい二,に巻,かん【聖歌,せいか隊,たいの指揮者,しきしゃによってうたわせたコラの子,このマスキールの歌,うた】","tok":[["["],["0"],["]"],["第","だい"],["二","に"],["巻","かん"],["【"],["聖歌隊","せいかたい"],["の"],["指揮者","しきしゃ"],["によって"],["うたわせた"],["コラ"],["の"],["子","こ"],["の"],["マスキール"],["の"],["歌","うた"],["】"]]},{"verse":2,"text":"[1]神,かみよ、しかが谷川,たにがわを慕,したいあえぐように、わが魂,たましいもあなたを慕,したいあえぐ。","tok":[["["],["1"],["]"],["神","かみ"],["よ"],["、"],["しか"],["が"],["谷川","たにがわ"],["を"],["慕い","したい"],["あえぐ"],["よう"],["に"],["、"],["わが"],["魂","たましい"],["も"],["あなた"],["を"],["慕い","したい"],["あえぐ"],["。"]]},{"verse":3,"text":"[2]わが魂,たましいはかわいているように神,かみを慕,したい、いける神,かみを慕,したう。いつ、わたしは行,いって神,かみのみ顔,かおを見,みることができるだろうか。","tok":[["["],["2"],["]"],["わが"],["魂","たましい"],["は"],["かわいて"],["いる"],["よう"],["に"],["神","かみ"],["を"],["慕い","したい"],["、"],["いける"],["神","かみ"],["を"],["慕う","したう"],["。"],["いつ"],["、"],["わたし"],["は"],["行って","いって"],["神","かみ"],["のみ"],["顔","かお"],["を"],["見る","みる"],["こと"],["が"],["できるだろう"],["か"],["。"]]},{"verse":4,"text":"[3]人々,ひとびとがひねもすわたしにむかって「おまえの神,かみはどこにいるのか」と言,いいつづける間,あいだはわたしの涙,なみだは昼,ひるも夜,よるもわたしの食物,しょくもつであった。","tok":[["["],["3"],["]"],["人々","ひとびと"],["が"],["ひねもす"],["わたし"],["に"],["むかって"],["「"],["おまえ"],["の"],["神","かみ"],["は"],["どこ"],["に"],["いる"],["の"],["か"],["」"],["と"],["言い","いい"],["つづける"],["間","あいだ"],["は"],["わたし"],["の"],["涙","なみだ"],["は"],["昼","ひる"],["も"],["夜","よる"],["も"],["わたし"],["の"],["食物","しょくもつ"],["で"],["あった"],["。"]]},{"verse":5,"text":"[4]わたしはかつて祭,まつりを守,まもる多,おおくの人,ひとと共,ともに群,むれをなして行,いき、喜,よろこびと感謝,かんしゃの歌,うたをもって彼,かれらを神,かみの家,いえに導,みちびいた。今,いまこれらの事,ことを思,おもい起,おこして、わが魂,たましいをそそぎ出,だすのである。","tok":[["["],["4"],["]"],["わたし"],["は"],["かつて"],["祭","まつり"],["を"],["守","まもる"],["多く","おおく"],["の"],["人","ひと"],["と"],["共","とも"],["に"],["群れ","むれ"],["を"],["なして"],["行き","いき"],["、"],["喜こび","よろこび"],["と"],["感謝","かんしゃ"],["の"],["歌","うた"],["を"],["もって"],["彼","かれ"],["ら"],["を"],["神","かみ"],["の"],["家","いえ"],["に"],["導いた","みちびいた"],["。"],["今","いま"],["これ"],["ら"],["の"],["事","こと"],["を"],["思い起こして","おもいおこして"],["、"],["わが"],["魂","たましい"],["を"],["そそぎ"],["出す","だす"],["ので"],["ある"],["。"]]},{"verse":6,"text":"[5]わが魂,たましいよ、何,なにゆえうなだれるのか。何,なにゆえわたしのうちに思,おもいみだれるのか。神,かみを待,まち望,のぞめ。わたしはなおわが助,たすけ、わが神,かみなる主,しゅをほめたたえるであろう。","tok":[["["],["5"],["]"],["わが"],["魂","たましい"],["よ"],["、"],["何ゆえ","なにゆえ"],["うなだれる"],["の"],["か"],["。"],["何ゆえ","なにゆえ"],["わたし"],["の"],["うち"],["に"],["思い","おもい"],["みだれる"],["の"],["か"],["。"],["神","かみ"],["を"],["待ち望め","まちのぞめ"],["。"],["わたし"],["は"],["なお"],["わが"],["助け","たすけ"],["、"],["わが"],["神","かみ"],["なる"],["主","しゅ"],["を"],["ほめたたえるで"],["あろう"],["。"]]},{"verse":7,"text":"[6]わが魂,たましいはわたしのうちにうなだれる。それで、わたしはヨルダンの地,ちから、またヘルモンから、ミザルの山,やまからあなたを思,おもい起,おこす。","tok":[["["],["6"],["]"],["わが"],["魂","たましい"],["は"],["わたし"],["の"],["うち"],["に"],["うなだれる"],["。"],["それ"],["で"],["、"],["わたし"],["は"],["ヨルダン"],["の"],["地","ち"],["から"],["、"],["また"],["ヘルモン"],["から"],["、"],["ミザル"],["の"],["山","やま"],["から"],["あなた"],["を"],["思い起こす","おもいおこす"],["。"]]},{"verse":8,"text":"[7]あなたの大滝,おおたきの響,ひびきによって淵,ふち々呼,よびこたえ、あなたの波,なみ、あなたの大波,おおなみはことごとくわたしの上,うえを越,こえていった。","tok":[["["],["7"],["]"],["あなた"],["の"],["大滝","おおたき"],["の"],["響","ひびき"],["によって"],["淵","ふち"],["々"],["呼び","よび"],["こたえ"],["、"],["あなた"],["の"],["波","なみ"],["、"],["あなた"],["の"],["大波","おおなみ"],["は"],["ことごとく"],["わたし"],["の"],["上","うえ"],["を"],["越えて","こえて"],["いった"],["。"]]},{"verse":9,"text":"[8]昼,ひるには、主,しゅはそのいつくしみをほどこし、夜,よるには、その歌,うたすなわちわがいのちの神,かみにささげる祈,いのりがわたしと共,ともにある。","tok":[["["],["8"],["]"],["昼","ひる"],["に"],["は"],["、"],["主","しゅ"],["は"],["その"],["いつくしみ"],["を"],["ほどこし"],["、"],["夜","よる"],["に"],["は"],["、"],["その"],["歌","うた"],["すなわち"],["わが"],["いのち"],["の"],["神","かみ"],["に"],["ささげる"],["祈","いのり"],["が"],["わたし"],["と"],["共","とも"],["に"],["ある"],["。"]]},{"verse":10,"text":"[9]わたしはわが岩,いわなる神,かみに言,いう、「何,なにゆえわたしをお忘,わすれになりましたか。何,なにゆえわたしは敵,てきのしえたげによって悲,かなしみ歩,あるくのですか」と。","tok":[["["],["9"],["]"],["わたし"],["は"],["わが"],["岩","いわ"],["なる"],["神","かみ"],["に"],["言う","いう"],["、"],["「"],["何ゆえ","なにゆえ"],["わたし"],["を"],["お忘","おわすれ"],["に"],["なりました"],["か"],["。"],["何ゆえ","なにゆえ"],["わたし"],["は"],["敵","てき"],["の"],["し"],["えたげ"],["によって"],["悲しみ","かなしみ"],["歩く","あるく"],["の"],["です"],["か"],["」"],["と"],["。"]]},{"verse":11,"text":"[10]わたしのあだは骨,ほねも砕,くだけるばかりにわたしをののしり、ひねもすわたしにむかって「おまえの神,かみはどこにいるのか」と言,いう。","tok":[["["],["10"],["]"],["わたし"],["の"],["あだ"],["は"],["骨","ほね"],["も"],["砕ける","くだける"],["ばかり"],["に"],["わたし"],["を"],["ののしり"],["、"],["ひねもす"],["わたし"],["に"],["むかって"],["「"],["おまえ"],["の"],["神","かみ"],["は"],["どこ"],["に"],["いる"],["の"],["か"],["」"],["と"],["言う","いう"],["。"]]},{"verse":12,"text":"[11]わが魂,たましいよ、何,なにゆえうなだれるのか。何,なにゆえわたしのうちに思,おもいみだれるのか。神,かみを待,まち望,のぞめ。わたしはなおわが助,たすけ、わが神,かみなる主,しゅをほめたたえるであろう。","tok":[["["],["11"],["]"],["わが"],["魂","たましい"],["よ"],["、"],["何ゆえ","なにゆえ"],["うなだれる"],["の"],["か"],["。"],["何ゆえ","なにゆえ"],["わたし"],["の"],["うち"],["に"],["思い","おもい"],["みだれる"],["の"],["か"],["。"],["神","かみ"],["を"],["待ち望め","まちのぞめ"],["。"],["わたし"],["は"],["なお"],["わが"],["助け","たすけ"],["、"],["わが"],["神","かみ"],["なる"],["主","しゅ"],["を"],["ほめたたえるで"],["あろう"],["。"]]}]
[{"verse":1,"text":"主,しゅに感謝,かんしゃし、そのみ名,なを呼,よび、そのみわざをもろもろの民,たみのなかに知,しらせよ。","tok":[["主に","しゅに"],["感謝","かんしゃ"],["し"],["、"],["その"],["み名","みな"],["を"],["呼び","よび"],["、"],["その"],["みわざ"],["を"],["もろもろ"],["の"],["民","たみ"],["の"],["なか"],["に"],["知らせ","しらせ"],["よ"],["。"]]},{"verse":2,"text":"主,しゅにむかって歌,うたえ、主,しゅをほめうたえ、そのすべてのくすしきみわざを語,かたれ。","tok":[["主に","しゅに"],["むかって"],["歌え","うたえ"],["、"],["主","しゅ"],["を"],["ほめ"],["うたえ"],["、"],["その"],["すべて"],["の"],["くす"],["しきみ"],["わざ"],["を"],["語れ","かたれ"],["。"]]},{"verse":3,"text":"その聖,せいなるみ名,なを誇,ほこれ。主,しゅを尋,たずね求,もとめる者,ものの心,こころを喜,よろこばせよ。","tok":[["その"],["聖","せい"],["なる"],["み名","みな"],["を"],["誇れ","ほこれ"],["。"],["主","しゅ"],["を"],["尋ね求める","たずねもとめる"],["者","もの"],["の"],["心","こころ"],["を"],["喜こばせ","よろこばせ"],["よ"],["。"]]},{"verse":4,"text":"主,しゅとそのみ力,ちからとを求,もとめよ、つねにそのみ顔,かおを尋,たずねよ。","tok":[["主","しゅ"],["と"],["その"],["み力","みちから"],["と"],["を"],["求めよ","もとめよ"],["、"],["つね"],["に"],["その"],["み顔","みかお"],["を"],["尋ね","たずね"],["よ"],["。"]]},{"verse":5,"text":"[5-6]そのしもべアブラハムの子孫,しそんよ、その選,えらばれた者,ものであるヤコブの子,こらよ、主,しゅのなされたくすしきみわざと、その奇跡,きせきと、そのみ口,くちのさばきとを心,こころにとめよ。","tok":[["["],["5"],["-"],["6"],["]"],["その"],["しもべ"],["アブラハム"],["の"],["子孫","しそん"],["よ"],["、"],["その"],["選ら","えら"],["ばれた"],["者","もの"],["で"],["ある"],["ヤコブ"],["の"],["子","こ"],["ら"],["よ"],["、"],["主","しゅ"],["の"],["なされた"],["くす"],["しきみ"],["わざと"],["、"],["その"],["奇跡","きせき"],["と"],["、"],["その"],["み口","みくち"],["の"],["さばき"],["と"],["を"],["心","こころ"],["に"],["とめよ"],["。"]]},{"verse":6,"text":"*[5-6]そのしもべアブラハムの子孫,しそんよ、その選,えらばれた者,ものであるヤコブの子,こらよ、主,しゅのなされたくすしきみわざと、その奇跡,きせきと、そのみ口,くちのさばきとを心,こころにとめよ。","tok":[["*"],["["],["5"],["-"],["6"],["]"],["その"],["しもべ"],["アブラハム"],["の"],["子孫","しそん"],["よ"],["、"],["その"],["選ら","えら"],["ばれた"],["者","もの"],["で"],["ある"],["ヤコブ"],["の"],["子","こ"],["ら"],["よ"],["、"],["主","しゅ"],["の"],["なされた"],["くす"],["しきみ"],["わざと"],["、"],["その"],["奇跡","きせき"],["と"],["、"],["その"],["み口","みくち"],["の"],["さばき"],["と"],["を"],["心","こころ"],["に"],["とめよ"],["。"]]},{"verse":7,"text":"彼,かれはわれらの神,かみ、主,しゅでいらせられる。そのさばきは全,ぜん地,ちにある。","tok":[["彼","かれ"],["は"],["われ"],["ら"],["の"],["神","かみ"],["、"],["主らせられる","しゅでいらせられる"],["。"],["その"],["さばき"],["は"],["全地","ぜんち"],["に"],["ある"],["。"]]},{"verse":8,"text":"主,しゅはとこしえに、その契約,けいやくをみこころにとめられる。これはよろず代,よに命,めいじられたみ言葉,ことばであって、","tok":[["主","しゅ"],["は"],["とこしえ"],["に"],["、"],["その"],["契約","けいやく"],["を"],["みこころ"],["に"],["とめられる"],["。"],["これ"],["は"],["よろず代","よろずよ"],["に"],["命じられた","めいじられた"],["み言葉","みことば"],["で"],["あって"],["、"]]},{"verse":9,"text":"アブラハムと結,むすばれた契約,けいやく、イサクに誓,ちかわれた約束,やくそくである。","tok":[["アブラハム"],["と"],["結ばれた","むすばれた"],["契約","けいやく"],["、"],["イサク"],["に"],["誓われた","ちかわれた"],["約束","やくそく"],["で"],["ある"],["。"]]},{"verse":10,"text":"主,しゅはこれを堅,かたく立,たてて、ヤコブのために定,さだめとし、イスラエルのために、とこしえの契約,けいやくとして","tok":[["主","しゅ"],["は"],["これ"],["を"],["堅く","かたく"],["立てて","たてて"],["、"],["ヤコブ"],["の"],["ため"],["に"],["定め","さだめ"],["と"],["し"],["、"],["イスラエル"],["の"],["ため"],["に"],["、"],["とこしえ"],["の"],["契約","けいやく"],["として"]]},{"verse":11,"text":"言,いわれた、「わたしはあなたにカナンの地,ちを与,あたえて、あなたがたの受,うける嗣,し業,ぎょうの分,わけ前,まえとする」と。","tok":[["言われた","いわれた"],["、"],["「"],["わたし"],["は"],["あなた"],["に"],["カナン"],["の"],["地","ち"],["を"],["与","あたえ"],["て"],["、"],["あなた"],["がた"],["の"],["受ける","うける"],["嗣業","しぎょう"],["の"],["分け前","わけまえ"],["と"],["する"],["」"],["と"],["。"]]},{"verse":12,"text":"このとき彼,かれらの数,かずは少,すくなくて、数,かぞえるに足,たらず、その所,ところで旅,たびびととなり、","tok":[["この"],["とき"],["彼","かれ"],["ら"],["の"],["数","かず"],["は"],["少くて","すくなくて"],["、"],["数える","かぞえる"],["に"],["足らず","たらず"],["、"],["その"],["所","ところ"],["で"],["旅びと","たびびと"],["と"],["なり"],["、"]]},{"verse":13,"text":"この国,くにからかの国,くにへ行,いき、この国,くにから他,たの民,たみへ行,いった。","tok":[["この"],["国","くに"],["から"],["か"],["の"],["国","くに"],["へ"],["行き","いき"],["、"],["この"],["国","くに"],["から"],["他","た"],["の"],["民","たみ"],["へ"],["行った","いった"],["。"]]},{"verse":14,"text":"主,しゅは人,ひとの彼,かれらをしえたげるのをゆるさず、彼,かれらのために王,おうたちを懲,こらしめて、","tok":[["主","しゅ"],["は"],["人","ひと"],["の"],["彼","かれ"],["ら"],["を"],["し"],["えたげる"],["の"],["を"],["ゆるさず"],["、"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["王","おう"],["たち"],["を"],["懲らしめて","こらしめて"],["、"]]},{"verse":15,"text":"言,いわれた、「わが油,あぶらそそがれた者,ものたちにさわってはならない、わが預言者,よげんしゃたちに害,がいを加,くわえてはならない」と。","tok":[["言われた","いわれた"],["、"],["「"],["わが"],["油","あぶら"],["そそがれた"],["者","もの"],["たち"],["に"],["さわって"],["は"],["ならない"],["、"],["わが"],["預言者","よげんしゃ"],["たち"],["に"],["害","がい"],["を"],["加えて","くわえて"],["は"],["ならない"],["」"],["と"],["。"]]},{"verse":16,"text":"主,しゅはききんを地,ちに招,まねき、人,ひとのつえとするパンをことごとく砕,くだかれた。","tok":[["主","しゅ"],["は"],["ききん"],["を"],["地","ち"],["に"],["招き","まねき"],["、"],["人","ひと"],["の"],["つえ"],["と"],["する"],["パン"],["を"],["ことごとく"],["砕かれた","くだかれた"],["。"]]},{"verse":17,"text":"また彼,かれらの前,まえにひとりをつかわされた。すなわち売,うられて奴隷,どれいとなったヨセフである。","tok":[["また"],["彼","かれ"],["ら"],["の"],["前","まえ"],["に"],["ひとり"],["を"],["つかわされた"],["。"],["すなわち"],["売られて","うられて"],["奴隷","どれい"],["と"],["なった"],["ヨセフ"],["で"],["ある"],["。"]]},{"verse":18,"text":"彼,かれの足,あしは足,あしかせをもって痛,いためられ、彼,かれの首,くびは鉄,てつの首輪,くびわにはめられ、","tok":[["彼","かれ"],["の"],["足","あし"],["は"],["足かせ","あしかせ"],["を"],["もって"],["痛められ","いためられ"],["、"],["彼","かれ"],["の"],["首","くび"],["は"],["鉄","てつ"],["の"],["首輪","くびわ"],["に"],["はめられ"],["、"]]},{"verse":19,"text":"彼,かれの言葉,ことばの成,なる時,ときまで、主,しゅのみ言葉,ことばが彼,かれを試,こころみた。","tok":[["彼","かれ"],["の"],["言葉","ことば"],["の"],["成る","なる"],["時","とき"],["まで"],["、"],["主","しゅ"],["のみ"],["言葉","ことば"],["が"],["彼","かれ"],["を"],["試みた","こころみた"],["。"]]},{"verse":20,"text":"王,おうは人,ひとをつかわして彼,かれを解,とき放,はなち、民,たみのつかさは彼,かれに自由,じゆうを与,あたえた。","tok":[["王","おう"],["は"],["人","ひと"],["を"],["つかわして"],["彼","かれ"],["を"],["解き放ち","ときはなち"],["、"],["民","たみ"],["の"],["つかさ"],["は"],["彼","かれ"],["に"],["自由","じゆう"],["を"],["与","あたえ"],["た"],["。"]]},{"verse":21,"text":"王,おうはその家,いえのつかさとしてその所有,しょゆうをことごとくつかさどらせ、","tok":[["王","おう"],["は"],["その"],["家","いえ"],["の"],["つかさ"],["として"],["その"],["所有","しょゆう"],["を"],["ことごとく"],["つかさどらせ"],["、"]]},{"verse":22,"text":"その心,こころのままに君,きみたちを教,おしえさせ、長老,ちょうろうたちに知恵,ちえを授,さづけさせた。","tok":[["その"],["心","こころ"],["の"],["まま"],["に"],["君","きみ"],["たち"],["を"],["教えさせ","おしえさせ"],["、"],["長老","ちょうろう"],["たち"],["に"],["知恵","ちえ"],["を"],["授","さ"],["づけさせた"],["。"]]},{"verse":23,"text":"その時,ときイスラエルはエジプトにきたり、ヤコブはハムの地,ちに寄留,きりゅうした。","tok":[["その"],["時","とき"],["イスラエル"],["は"],["エジプト"],["に"],["き"],["たり"],["、"],["ヤコブ"],["は"],["ハム"],["の"],["地","ち"],["に"],["寄留","きりゅう"],["した"],["。"]]},{"verse":24,"text":"主,しゅはその民,たみを大,おおいに増,まし加,くわえ、これをそのあだよりも強,つよくされた。","tok":[["主","しゅ"],["は"],["その"],["民","たみ"],["を"],["大いに","おおいに"],["増し加え","ましくわえ"],["、"],["これ"],["を"],["その"],["あだ"],["より"],["も"],["強く","つよく"],["された"],["。"]]},{"verse":25,"text":"主,しゅは人々,ひとびとの心,こころをかえて、その民,たみを憎,にくませ、そのしもべたちを悪賢,わるがしこく扱,あつかわせられた。","tok":[["主","しゅ"],["は"],["人々","ひとびと"],["の"],["心","こころ"],["を"],["かえて"],["、"],["その"],["民","たみ"],["を"],["憎ませ","にくませ"],["、"],["その"],["しもべ"],["たち"],["を"],["悪賢く","わるがしこく"],["扱わせられた","あつかわせられた"],["。"]]},{"verse":26,"text":"主,しゅはそのしもべモーセと、そのお選,えらびになったアロンとをつかわされた。","tok":[["主","しゅ"],["は"],["その"],["しもべ"],["モーセ"],["と"],["、"],["その"],["お選ら","おえら"],["び"],["に"],["なった"],["アロン"],["と"],["を"],["つかわされた"],["。"]]},{"verse":27,"text":"彼,かれらはハムの地,ちで主,しゅのしるしと、奇跡,きせきとを彼,かれらのうちにおこなった。","tok":[["彼","かれ"],["ら"],["は"],["ハム"],["の"],["地","ち"],["で"],["主","しゅ"],["の"],["しるし"],["と"],["、"],["奇跡","きせき"],["と"],["を"],["彼","かれ"],["ら"],["の"],["うち"],["に"],["おこなった"],["。"]]},{"verse":28,"text":"主,しゅは暗,くらやみをつかわして地,ちを暗,くらくされた。しかし彼,かれらはそのみ言葉,ことばに従,したがわなかった。","tok":[["主","しゅ"],["は"],["暗やみ","くらやみ"],["を"],["つかわして"],["地","ち"],["を"],["暗く","くらく"],["された"],["。"],["しかし"],["彼","かれ"],["ら"],["は"],["その"],["み言葉","みことば"],["に"],["従わなかった","したがわなかった"],["。"]]},{"verse":29,"text":"主,しゅは彼,かれらの水,みずを血,ちに変,かわらせて、その魚,うおを殺,ころされた。","tok":[["主","しゅ"],["は"],["彼","かれ"],["ら"],["の"],["水","みず"],["を"],["血","ち"],["に"],["変わらせて","かわらせて"],["、"],["その"],["魚","うお"],["を"],["殺ろされた","ころされた"],["。"]]},{"verse":30,"text":"彼,かれらの国,くにには、かえるが群,むらがり、王,おうの寝間,ねまにまではいった。","tok":[["彼","かれ"],["ら"],["の"],["国","くに"],["に"],["は"],["、"],["かえる"],["が"],["群らがり","むらがり"],["、"],["王","おう"],["の"],["寝間","ねま"],["に"],["まで"],["は"],["いった"],["。"]]},{"verse":31,"text":"主,しゅが言,いわれると、はえの群,むれがきたり、ぶよが国,くにじゅうにあった。","tok":[["主","しゅ"],["が"],["言われる","いわれる"],["と"],["、"],["はえ"],["の"],["群れ","むれ"],["が"],["き"],["たり"],["、"],["ぶよ"],["が"],["国","くに"],["じゅう"],["に"],["あった"],["。"]]},{"verse":32,"text":"主,しゅは雨,あめにかえて、ひょうを彼,かれらに与,あたえ、きらめくいなずまを彼,かれらの国,くにに放,はなたれた。","tok":[["主","しゅ"],["は"],["雨","あめ"],["に"],["かえて"],["、"],["ひょう"],["を"],["彼","かれ"],["ら"],["に"],["与","あたえ"],["、"],["きらめく"],["いなずま"],["を"],["彼","かれ"],["ら"],["の"],["国","くに"],["に"],["放たれた","はなたれた"],["。"]]},{"verse":33,"text":"主,しゅは彼,かれらのぶどうの木,きと、いちじくの木,きとを撃,うち、彼,かれらの国,くにのもろもろの木,きを折,おり砕,くだかれた。","tok":[["主","しゅ"],["は"],["彼","かれ"],["ら"],["の"],["ぶどう"],["の"],["木","き"],["と"],["、"],["いちじく"],["の"],["木","き"],["と"],["を"],["撃ち","うち"],["、"],["彼","かれ"],["ら"],["の"],["国","くに"],["の"],["もろもろ"],["の"],["木","き"],["を"],["折","おり"],["砕かれた","くだかれた"],["。"]]},{"verse":34,"text":"主,しゅが言,いわれると、いなごがきたり、無数,むすうの若,わかいいなごが来,きて、","tok":[["主","しゅ"],["が"],["言われる","いわれる"],["と"],["、"],["いなご"],["が"],["き"],["たり"],["、"],["無数","むすう"],["の"],["若い","わかい"],["いなご"],["が"],["来て","きて"],["、"]]},{"verse":35,"text":"彼,かれらの国,くにのすべての青物,あおものを食,くいつくし、その地,ちの実,みを食,くいつくした。","tok":[["彼","かれ"],["ら"],["の"],["国","くに"],["の"],["すべて"],["の"],["青物","あおもの"],["を"],["食いつく","くいつく"],["し"],["、"],["その"],["地","ち"],["の"],["実","み"],["を"],["食いつく","くいつく"],["した"],["。"]]},{"verse":36,"text":"主,しゅは彼,かれらの国,くにのすべてのういごを撃,うち、彼,かれらのすべての力,ちからの初,はじめを撃,うたれた。","tok":[["主","しゅ"],["は"],["彼","かれ"],["ら"],["の"],["国","くに"],["の"],["すべて"],["の"],["うい"],["ご"],["を"],["撃ち","うち"],["、"],["彼","かれ"],["ら"],["の"],["すべて"],["の"],["力","ちから"],["の"],["初め","はじめ"],["を"],["撃たれた","うたれた"],["。"]]},{"verse":37,"text":"そして金銀,きんぎんを携,たずさえてイスラエルを出,でて行,いかせられた。その部族,ぶぞくのうちに、ひとりの倒,たおれる者,ものもなかった。","tok":[["そして"],["金銀","きんぎん"],["を"],["携えて","たずさえて"],["イスラエル"],["を"],["出て","でて"],["行かせられた","いかせられた"],["。"],["その"],["部族","ぶぞく"],["の"],["うち"],["に"],["、"],["ひとり"],["の"],["倒れる","たおれる"],["者","もの"],["も"],["なかった"],["。"]]},{"verse":38,"text":"エジプトは彼,かれらの去,さるのを喜,よろこんだ。彼,かれらに対,たいする恐,おそれが彼,かれらに臨,のぞんだからである。","tok":[["エジプト"],["は"],["彼","かれ"],["ら"],["の"],["去る","さる"],["の"],["を"],["喜こんだ","よろこんだ"],["。"],["彼","かれ"],["ら"],["に"],["対する","たいする"],["恐","おそれ"],["が"],["彼","かれ"],["ら"],["に"],["臨んだ","のぞんだ"],["から"],["で"],["ある"],["。"]]},{"verse":39,"text":"主,しゅは雲,くもをひろげておおいとし、夜,よるは火,ひをもって照,てらされた。","tok":[["主","しゅ"],["は"],["雲","くも"],["を"],["ひろげて"],["おおい"],["と"],["し"],["、"],["夜","よる"],["は"],["火","ひ"],["を"],["もって"],["照らされた","てらされた"],["。"]]},{"verse":40,"text":"また彼,かれらの求,もとめによって、うずらを飛,とびきたらせ、天,てんから、かてを豊,ゆたかに彼,かれらに与,あたえられた。","tok":[["また"],["彼","かれ"],["ら"],["の"],["求め","もとめ"],["によって"],["、"],["うずら"],["を"],["飛び","とび"],["きたらせ"],["、"],["天","てん"],["から"],["、"],["か"],["て"],["を"],["豊","ゆたか"],["に"],["彼","かれ"],["ら"],["に"],["与えられた","あたえられた"],["。"]]},{"verse":41,"text":"主,しゅが岩,いわを開,ひらかれると、水,みずがほとばしり出,でて、かわいた地,ちに川,かわのように流,ながれた。","tok":[["主","しゅ"],["が"],["岩","いわ"],["を"],["開らかれる","ひらかれる"],["と"],["、"],["水","みず"],["が"],["ほとばしり出て","ほとばしりでて"],["、"],["かわいた"],["地","ち"],["に"],["川","かわ"],["の"],["よう"],["に"],["流れた","ながれた"],["。"]]},{"verse":42,"text":"これは主,しゅがその聖,せいなる約束,やくそくと、そのしもべアブラハムを覚,おぼえられたからである。","tok":[["これ"],["は"],["主","しゅがそ"],["の"],["聖","せい"],["なる"],["約束","やくそく"],["と"],["、"],["その"],["しもべ"],["アブラハム"],["を"],["覚えられた","おぼえられた"],["から"],["で"],["ある"],["。"]]},{"verse":43,"text":"こうして主,しゅはその民,たみを導,みちびいて喜,よろこびつつ出,でて行,いかせ、その選,えらばれた民,たみを導,みちびいて歌,うたいつつ出,でて行,いかせられた。","tok":[["こう"],["して"],["主","しゅ"],["は"],["その"],["民","たみ"],["を"],["導いて","みちびいて"],["喜こび","よろこび"],["つつ"],["出て","でて"],["行かせ","いかせ"],["、"],["その"],["選ら","えら"],["ばれた"],["民","たみ"],["を"],["導いて","みちびいて"],["歌い","うたい"],["つつ"],["出て","でて"],["行かせられた","いかせられた"],["。"]]},{"verse":44,"text":"主,しゅはもろもろの国,くにびとの地,ちを彼,かれらに与,あたえられたので、彼,かれらはもろもろの民,たみの勤労,きんろうの実,みを自分,じぶんのものとした。","tok":[["主","しゅ"],["は"],["もろもろ"],["の"],["国びと","くにびと"],["の"],["地","ち"],["を"],["彼","かれ"],["ら"],["に"],["与えられた","あたえられた"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["もろもろ"],["の"],["民","たみ"],["の"],["勤労","きんろう"],["の"],["実","み"],["を"],["自分","じぶん"],["の"],["もの"],["と"],["した"],["。"]]},{"verse":45,"text":"これは彼,かれらが主,しゅの定,さだめを守,まもり、そのおきてを行,おこなうためである。主,しゅをほめたたえよ。","tok":[["これ"],["は"],["彼","かれ"],["ら"],["が"],["主","しゅ"],["の"],["定め","さだめ"],["を"],["守り","まもり"],["、"],["その"],["おきて"],["を"],["行なう","おこなう"],["ため"],["で"],["ある"],["。"],["主","しゅ"],["を"],["ほめたたえ"],["よ"],["。"]]}]
[{"verse":1,"text":"主,しゅに感謝,かんしゃせよ、主,しゅは恵,めぐみふかく、そのいつくしみはとこしえに絶,たえることがない。","tok":[["主に","しゅに"],["感謝","かんしゃ"],["せよ"],["、"],["主","しゅ"],["は"],["恵","めぐみ"],["ふかく"],["、"],["その"],["いつくしみ"],["は"],["とこしえ"],["に"],["絶える","たえる"],["こと"],["が"],["ない"],["。"]]},{"verse":2,"text":"イスラエルは言,いえ、「そのいつくしみはとこしえに絶,たえることがない」と。","tok":[["イスラエル"],["は"],["言え","いえ"],["、"],["「"],["その"],["いつくしみ"],["は"],["とこしえ"],["に"],["絶える","たえる"],["こと"],["が"],["ない"],["」"],["と"],["。"]]},{"verse":3,"text":"アロンの家,いえは言,いえ、「そのいつくしみはとこしえに絶,たえることがない」と。","tok":[["アロン"],["の"],["家","いえ"],["は"],["言え","いえ"],["、"],["「"],["その"],["いつくしみ"],["は"],["とこしえ"],["に"],["絶える","たえる"],["こと"],["が"],["ない"],["」"],["と"],["。"]]},{"verse":4,"text":"主,しゅをおそれる者,ものは言,いえ、「そのいつくしみはとこしえに絶,たえることがない」と。","tok":[["主","しゅ"],["を"],["おそれる"],["者","もの"],["は"],["言え","いえ"],["、"],["「"],["その"],["いつくしみ"],["は"],["とこしえ"],["に"],["絶える","たえる"],["こと"],["が"],["ない"],["」"],["と"],["。"]]},{"verse":5,"text":"わたしが悩,なやみのなかから主,しゅを呼,よぶと、主,しゅは答,こたえて、わたしを広,ひろい所,ところに置,おかれた。","tok":[["わたし"],["が"],["悩み","なやみ"],["の"],["なか"],["から"],["主","しゅ"],["を"],["呼ぶ","よぶ"],["と"],["、"],["主","しゅ"],["は"],["答","こたえ"],["て"],["、"],["わたし"],["を"],["広い","ひろい"],["所","ところ"],["に"],["置かれた","おかれた"],["。"]]},{"verse":6,"text":"主,しゅがわたしに味方,みかたされるので、恐,おそれることはない。人,ひとはわたしに何,なにをなし得,えようか。","tok":[["主","しゅ"],["が"],["わたし"],["に"],["味方","みかた"],["される"],["ので"],["、"],["恐れる","おそれる"],["こと"],["は"],["ない"],["。"],["人","ひと"],["は"],["わたし"],["に"],["何に","なに"],["を"],["なし"],["得よう","えよう"],["か"],["。"]]},{"verse":7,"text":"主,しゅはわたしに味方,みかたし、わたしを助,たすけられるので、わたしを憎,にくむ者,ものについての願,ねがいを見,みるであろう。","tok":[["主","しゅ"],["は"],["わたし"],["に"],["味方","みかた"],["し"],["、"],["わたし"],["を"],["助けられる","たすけられる"],["ので"],["、"],["わたし"],["を"],["憎む","にくむ"],["者","もの"],["について"],["の"],["願い","ねがい"],["を"],["見るで","みるで"],["あろう"],["。"]]},{"verse":8,"text":"主,しゅに寄,より頼,たのむは人,ひとにたよるよりも良,よい。","tok":[["主に","しゅに"],["寄り","より"],["頼む","たのむ"],["は"],["人","ひと"],["に"],["たよる"],["より"],["も"],["良い","よい"],["。"]]},{"verse":9,"text":"主,しゅに寄,より頼,たのむはもろもろの君,きみにたよるよりも良,よい。","tok":[["主に","しゅに"],["寄り","より"],["頼む","たのむ"],["は"],["もろもろ"],["の"],["君","きみ"],["に"],["たよる"],["より"],["も"],["良い","よい"],["。"]]},{"verse":10,"text":"もろもろの国民,こくみんはわたしを囲,かこんだ。わたしは主,しゅのみ名,なによって彼,かれらを滅,ほろぼす。","tok":[["もろもろ"],["の"],["国民","こくみん"],["は"],["わたし"],["を"],["囲んだ","かこんだ"],["。"],["わたし"],["は"],["主","しゅ"],["のみ"],["名","な"],["によって"],["彼","かれ"],["ら"],["を"],["滅ぼす","ほろぼす"],["。"]]},{"verse":11,"text":"彼,かれらはわたしを囲,かこんだ、わたしを囲,かこんだ。わたしは主,しゅのみ名,なによって彼,かれらを滅,ほろぼす。","tok":[["彼","かれ"],["ら"],["は"],["わたし"],["を"],["囲んだ","かこんだ"],["、"],["わたし"],["を"],["囲んだ","かこんだ"],["。"],["わたし"],["は"],["主","しゅ"],["のみ"],["名","な"],["によって"],["彼","かれ"],["ら"],["を"],["滅ぼす","ほろぼす"],["。"]]},{"verse":12,"text":"彼,かれらは蜂,はちのようにわたしを囲,かこみ、いばらの火,ひのように燃,もえたった。わたしは主,しゅのみ名,なによって彼,かれらを滅,ほろぼす。","tok":[["彼","かれ"],["ら"],["は"],["蜂","はち"],["の"],["よう"],["に"],["わたし"],["を"],["囲み","かこみ"],["、"],["いばら"],["の"],["火","ひ"],["の"],["よう"],["に"],["燃えたった","もえたった"],["。"],["わたし"],["は"],["主","しゅ"],["のみ"],["名","な"],["によって"],["彼","かれ"],["ら"],["を"],["滅ぼす","ほろぼす"],["。"]]},{"verse":13,"text":"わたしはひどく押,おされて倒,たおれようとしたが、主,しゅはわたしを助,たすけられた。","tok":[["わたし"],["は"],["ひどく"],["押されて","おされて"],["倒れよう","たおれよう"],["と"],["した"],["が"],["、"],["主","しゅ"],["は"],["わたし"],["を"],["助けられた","たすけられた"],["。"]]},{"verse":14,"text":"主,しゅはわが力,ちから、わが歌,うたであって、わが救,すくいとなられた。","tok":[["主","しゅ"],["は"],["わが"],["力","ちから"],["、"],["わが"],["歌","うた"],["で"],["あって"],["、"],["わが"],["救い","すくい"],["と"],["なられた"],["。"]]},{"verse":15,"text":"聞,きけ、勝利,しょうりの喜,よろこばしい歌,うたが正,ただしい者,ものの天幕,てんまくにある。「主,しゅの右,みぎの手,ては勇,いさましいはたらきをなし、","tok":[["聞け","きけ"],["、"],["勝利","しょうり"],["の"],["喜こば","よろこば"],["しい"],["歌","うた"],["が"],["正い","ただしい"],["者","もの"],["の"],["天幕","てんまく"],["に"],["ある"],["。"],["「"],["主","しゅ"],["の"],["右","みぎ"],["の"],["手","て"],["は"],["勇ましい","いさましい"],["はたらき"],["を"],["なし"],["、"]]},{"verse":16,"text":"主,しゅの右,みぎの手,ては高,たかくあがり、主,しゅの右,みぎの手,ては勇,いさましいはたらきをなす」。","tok":[["主","しゅ"],["の"],["右","みぎ"],["の"],["手","て"],["は"],["高かく","たかく"],["あがり"],["、"],["主","しゅ"],["の"],["右","みぎ"],["の"],["手","て"],["は"],["勇ましい","いさましい"],["はたらき"],["を"],["なす"],["」"],["。"]]},{"verse":17,"text":"わたしは死,しぬことなく、生,いきながらえて、主,しゅのみわざを物語,ものがたるであろう。","tok":[["わたし"],["は"],["死ぬ","しぬ"],["こと"],["なく"],["、"],["生きながらえて","いきながらえて"],["、"],["主","しゅ"],["のみ"],["わざ"],["を"],["物語るで","ものがたるで"],["あろう"],["。"]]},{"verse":18,"text":"主,しゅはいたくわたしを懲,こらされたが、死,しにはわたされなかった。","tok":[["主","しゅ"],["は"],["いたく"],["わたし"],["を"],["懲らされた","こらされた"],["が"],["、"],["死","し"],["に"],["は"],["わたされなかった"],["。"]]},{"verse":19,"text":"わたしのために義,ぎの門,もんを開,ひらけ、わたしはその内,うちにはいって、主,しゅに感謝,かんしゃしよう。","tok":[["わたし"],["の"],["ため"],["に"],["義","ぎ"],["の"],["門","もん"],["を"],["開らけ","ひらけ"],["、"],["わたし"],["は"],["その"],["内","うち"],["に"],["はいって"],["、"],["主に","しゅに"],["感謝","かんしゃ"],["しよう"],["。"]]},{"verse":20,"text":"これは主,しゅの門,もんである。正,ただしい者,ものはその内,うちにはいるであろう。","tok":[["これ"],["は"],["主","しゅ"],["の"],["門","もん"],["で"],["ある"],["。"],["正い","ただしい"],["者","もの"],["は"],["その"],["内","うち"],["に"],["はいるで"],["あろう"],["。"]]},{"verse":21,"text":"わたしはあなたに感謝,かんしゃします。あなたがわたしに答,こたえて、わが救,すくいとなられたことを。","tok":[["わたし"],["は"],["あなた"],["に"],["感謝","かんしゃ"],["します"],["。"],["あなた"],["が"],["わたし"],["に"],["答","こたえ"],["て"],["、"],["わが"],["救い","すくい"],["と"],["なられた"],["こと"],["を"],["。"]]},{"verse":22,"text":"家,いえ造,つくりらの捨,すてた石,いしは隅,すみのかしら石,いしとなった。","tok":[["家造","いえつくり"],["ら"],["の"],["捨てた","すてた"],["石","いし"],["は"],["隅","すみ"],["の"],["かしら"],["石","いし"],["と"],["なった"],["。"]]},{"verse":23,"text":"これは主,しゅのなされた事,ことでわれらの目,めには驚,おどろくべき事,ことである。","tok":[["これ"],["は"],["主","しゅ"],["の"],["なされた"],["事","こと"],["で"],["われ"],["ら"],["の"],["目","め"],["に"],["は"],["驚ろくべき","おどろくべき"],["事","こと"],["で"],["ある"],["。"]]},{"verse":24,"text":"これは主,しゅが設,もうけられた日,ひであって、われらはこの日,ひに喜,よろこび楽,たのしむであろう。","tok":[["これ"],["は"],["主","しゅ"],["が"],["設けられた","もうけられた"],["日","ひ"],["で"],["あって"],["、"],["われ"],["ら"],["は"],["この"],["日","ひ"],["に"],["喜こび","よろこび"],["楽しむで","たのしむで"],["あろう"],["。"]]},{"verse":25,"text":"主,しゅよ、どうぞわれらをお救,すくいください。主,しゅよ、どうぞわれらを栄,さかえさせてください。","tok":[["主","しゅ"],["よ"],["、"],["どうぞ"],["われ"],["ら"],["を"],["お救い","おすくい"],["ください"],["。"],["主","しゅ"],["よ"],["、"],["どうぞ"],["われ"],["ら"],["を"],["栄","さかえ"],["させて"],["ください"],["。"]]},{"verse":26,"text":"主,しゅのみ名,なによってはいる者,ものはさいわいである。われらは主,しゅの家,いえからあなたをたたえます。","tok":[["主","しゅ"],["のみ"],["名","な"],["に"],["よっ"],["ては"],["いる"],["者","もの"],["は"],["さいわい"],["で"],["ある"],["。"],["われ"],["ら"],["は"],["主","しゅ"],["の"],["家","いえ"],["から"],["あなた"],["を"],["たたえます"],["。"]]},{"verse":27,"text":"主,しゅは神,かみであって、われらを照,てらされた。枝,えだを携,たずさえて祭,まつりの行列,ぎょうれつを祭壇,さいだんの角,つのにまで進,すすませよ。","tok":[["主","しゅ"],["は"],["神","かみ"],["で"],["あって"],["、"],["われ"],["ら"],["を"],["照らされた","てらされた"],["。"],["枝","えだ"],["を"],["携えて","たずさえて"],["祭","まつり"],["の"],["行列","ぎょうれつ"],["を"],["祭壇","さいだん"],["の"],["角","つ"],["のに"],["まで"],["進ませ","すすませ"],["よ"],["。"]]},{"verse":28,"text":"あなたはわが神,かみ、わたしはあなたに感謝,かんしゃします。あなたはわが神,かみ、わたしはあなたをあがめます。","tok":[["あなた"],["は"],["わが"],["神","かみ"],["、"],["わたし"],["は"],["あなた"],["に"],["感謝","かんしゃ"],["します"],["。"],["あなた"],["は"],["わが"],["神","かみ"],["、"],["わたし"],["は"],["あなた"],["を"],["あがめます"],["。"]]},{"verse":29,"text":"主,しゅに感謝,かんしゃせよ、主,しゅは恵,めぐみふかく、そのいつくしみはとこしえに絶,たえることがない。","tok":[["主に","しゅに"],["感謝","かんしゃ"],["せよ"],["、"],["主","しゅ"],["は"],["恵","めぐみ"],["ふかく"],["、"],["その"],["いつくしみ"],["は"],["とこしえ"],["に"],["絶える","たえる"],["こと"],["が"],["ない"],["。"]]}]
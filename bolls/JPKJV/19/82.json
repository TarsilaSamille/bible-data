[{"verse":1,"text":"【アサフの歌,うた】神,かみは神,かみの会議,かいぎのなかに立,たたれる。神,かみは神々,かみがみのなかで、さばきを行,おこなわれる。","tok":[["【"],["アサフ"],["の"],["歌","うた"],["】"],["神","かみ"],["は"],["神","かみ"],["の"],["会議","かいぎ"],["の"],["なか"],["に"],["立たれる","たたれる"],["。"],["神","かみ"],["は"],["神々","かみがみ"],["の"],["なか"],["で"],["、"],["さばき"],["を"],["行なわれる","おこなわれる"],["。"]]},{"verse":2,"text":"「あなたがたはいつまで不正,ふせいなさばきをなし、悪,あしき者,ものに好意,こういを示,しめすのか。〔セラ","tok":[["「"],["あなた"],["がた"],["は"],["いつ"],["まで"],["不正","ふせい"],["な"],["さばき"],["を"],["なし"],["、"],["悪しき","あしき"],["者","もの"],["に"],["好意","こうい"],["を"],["示めす","しめす"],["の"],["か"],["。"],["〔"],["セラ"]]},{"verse":3,"text":"弱,よわい者,ものと、みなしごとを公平,こうへいに扱,あつかい、苦,くるしむ者,ものと乏,とぼしい者,ものの権利,けんりを擁護,ようごせよ。","tok":[["弱い","よわい"],["者","もの"],["と"],["、"],["みなし"],["ごと"],["を"],["公平","こうへい"],["に"],["扱い","あつかい"],["、"],["苦しむ","くるしむ"],["者","もの"],["と"],["乏い","とぼしい"],["者","もの"],["の"],["権利","けんり"],["を"],["擁護","ようご"],["せよ"],["。"]]},{"verse":4,"text":"弱,よわい者,ものと貧,まずしい者,ものを救,すくい、彼,かれらを悪,あしき者,ものの手,てから助,たすけ出,だせ」。","tok":[["弱い","よわい"],["者","もの"],["と"],["貧しい","まずしい"],["者","もの"],["を"],["救い","すくい"],["、"],["彼","かれ"],["ら"],["を"],["悪しき","あしき"],["者","もの"],["の"],["手","て"],["から"],["助け出せ","たすけだせ"],["」"],["。"]]},{"verse":5,"text":"彼,かれらは知,しることなく、悟,さとることもなくて、暗,くらき中,なかをさまよう。地,ちのもろもろの基,もといはゆり動,うごいた。","tok":[["彼","かれ"],["ら"],["は"],["知る","しる"],["こと"],["なく"],["、"],["悟","さとる"],["こと"],["も"],["なくて"],["、"],["暗き","くらき"],["中","なか"],["を"],["さまよう"],["。"],["地","ち"],["の"],["もろもろ"],["の"],["基い","もとい"],["は"],["ゆり"],["動いた","うごいた"],["。"]]},{"verse":6,"text":"わたしは言,いう、「あなたがたは神,かみだ、あなたがたは皆,みないと高,たかき者,ものの子,こだ。","tok":[["わたし"],["は"],["言う","いう"],["、"],["「"],["あなた"],["がた"],["は"],["神","かみ"],["だ"],["、"],["あなた"],["がた"],["は"],["皆","みな"],["いと"],["高き","たかき"],["者","もの"],["の"],["子","こ"],["だ"],["。"]]},{"verse":7,"text":"しかし、あなたがたは人,ひとのように死,しに、もろもろの君,きみのひとりのように倒,たおれるであろう」。","tok":[["しかし"],["、"],["あなた"],["がた"],["は"],["人","ひと"],["の"],["よう"],["に"],["死に","しに"],["、"],["もろもろ"],["の"],["君","きみ"],["の"],["ひとり"],["の"],["よう"],["に"],["倒れるで","たおれるで"],["あろう"],["」"],["。"]]},{"verse":8,"text":"神,かみよ、起,おきて、地,ちをさばいてください。すべての国民,こくみんはあなたのものだからです。","tok":[["神","かみ"],["よ"],["、"],["起きて","おきて"],["、"],["地","ち"],["を"],["さばいて"],["ください"],["。"],["すべて"],["の"],["国民","こくみん"],["は"],["あなた"],["の"],["もの"],["だ"],["から"],["です"],["。"]]}]
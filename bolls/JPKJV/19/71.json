[{"verse":1,"text":"主,しゅよ、わたしはあなたに寄,より頼,たのむ。とこしえにわたしをはずかしめないでください。","tok":[["主","しゅ"],["よ"],["、"],["わたし"],["は"],["あなた"],["に"],["寄り","より"],["頼む","たのむ"],["。"],["とこしえ"],["に"],["わたし"],["を"],["はずかしめないで"],["ください"],["。"]]},{"verse":2,"text":"あなたの義,ぎをもってわたしを助,たすけ、わたしを救,すくい出,だしてください。あなたの耳,みみを傾,かたむけて、わたしをお救,すくいください。","tok":[["あなた"],["の"],["義","ぎ"],["を"],["もって"],["わたし"],["を"],["助け","たすけ"],["、"],["わたし"],["を"],["救い出して","すくいだして"],["ください"],["。"],["あなた"],["の"],["耳","みみ"],["を"],["傾むけて","かたむけて"],["、"],["わたし"],["を"],["お救い","おすくい"],["ください"],["。"]]},{"verse":3,"text":"わたしのためにのがれの岩,いわとなり、わたしを救,すくう堅固,けんごな城,しろとなってください。あなたはわが岩,いわ、わが城,しろだからです。","tok":[["わたし"],["の"],["ため"],["に"],["のがれ"],["の"],["岩","いわ"],["と"],["なり"],["、"],["わたし"],["を"],["救う","すくう"],["堅固","けんご"],["な"],["城","しろ"],["と"],["なって"],["ください"],["。"],["あなた"],["は"],["わが"],["岩","いわ"],["、"],["わが"],["城","しろ"],["だ"],["から"],["です"],["。"]]},{"verse":4,"text":"わが神,かみよ、悪,あしき者,ものの手,てからわたしを救,すくい、不義,ふぎ、残忍,ざんにんな人,ひとの支配,しはいから、わたしを救,すくい出,だしてください。","tok":[["わが"],["神","かみ"],["よ"],["、"],["悪しき","あしき"],["者","もの"],["の"],["手","て"],["から"],["わたし"],["を"],["救い","すくい"],["、"],["不義","ふぎ"],["、"],["残忍","ざんにん"],["な"],["人","ひと"],["の"],["支配","しはい"],["から"],["、"],["わたし"],["を"],["救い出して","すくいだして"],["ください"],["。"]]},{"verse":5,"text":"主,しゅなる神,かみよ、あなたはわたしの若,わかい時,ときからのわたしの望,のぞみ、わたしの頼,たのみです。","tok":[["主","しゅ"],["なる"],["神","かみ"],["よ"],["、"],["あなた"],["は"],["わたし"],["の"],["若い","わかい"],["時","とき"],["から"],["の"],["わたし"],["の"],["望み","のぞみ"],["、"],["わたし"],["の"],["頼み","たのみ"],["です"],["。"]]},{"verse":6,"text":"わたしは生,うまれるときからあなたに寄,より頼,たのみました。あなたはわたしを母,ははの胎,たいから取,とり出,だされたかたです。わたしは常,つねにあなたをほめたたえます。","tok":[["わたし"],["は"],["生まれる","うまれる"],["とき"],["から"],["あなた"],["に"],["寄り","より"],["頼みました","たのみました"],["。"],["あなた"],["は"],["わたし"],["を"],["母","はは"],["の"],["胎","たいか"],["ら"],["取出された","とりだされた"],["かた"],["です"],["。"],["わたし"],["は"],["常","つね"],["に"],["あなた"],["を"],["ほめたたえます"],["。"]]},{"verse":7,"text":"わたしは多,おおくの人,ひとに怪,あやしまれるような者,ものとなりました。しかしあなたはわたしの堅固,けんごな避,さけ所,どころです。","tok":[["わたし"],["は"],["多く","おおく"],["の"],["人","ひと"],["に"],["怪しまれる","あやしまれる"],["よう"],["な"],["者","もの"],["と"],["なりました"],["。"],["しかし"],["あなた"],["は"],["わたし"],["の"],["堅固","けんご"],["な"],["避け","さけ"],["所","ど"],["ころ"],["です"],["。"]]},{"verse":8,"text":"わたしの口,くちはひねもす、あなたをたたえるさんびと、頌栄,しょうえいとをもって満,みたされています。","tok":[["わたし"],["の"],["口","くち"],["は"],["ひねもす"],["、"],["あなた"],["を"],["たたえる"],["さん"],["び"],["と"],["、"],["頌栄","しょうえい"],["と"],["を"],["もって"],["満たされて","みたされて"],["います"],["。"]]},{"verse":9,"text":"わたしが年老,としおいた時,とき、わたしを見離,みはなさないでください。わたしが力,ちから衰,おとろえた時,とき、わたしを見捨,みすてないでください。","tok":[["わたし"],["が"],["年老いた","としおいた"],["時","とき"],["、"],["わたし"],["を"],["見離さないで","みはなさないで"],["ください"],["。"],["わたし"],["が"],["力","ちから"],["衰えた","おとろえた"],["時","とき"],["、"],["わたし"],["を"],["見捨てないで","みすてないで"],["ください"],["。"]]},{"verse":10,"text":"わたしの敵,てきはわたしについて語,かたり、わたしのいのちをうかがう者,ものは共,ともにはかって、","tok":[["わたし"],["の"],["敵","てき"],["は"],["わたし"],["について"],["語り","かたり"],["、"],["わたし"],["の"],["いのち"],["を"],["うかがう"],["者","もの"],["は"],["共","とも"],["に"],["はかって"],["、"]]},{"verse":11,"text":"「神,かみは彼,かれを見捨,みすてた。彼,かれを助,たすける者,ものがないから彼,かれを追,おって捕,とらえよ」と言,いいます。","tok":[["「"],["神","かみ"],["は"],["彼","かれ"],["を"],["見捨てた","みすてた"],["。"],["彼","かれ"],["を"],["助ける","たすける"],["者","もの"],["が"],["ない"],["から"],["彼","かれ"],["を"],["追って","おって"],["捕らえよ","とらえよ"],["」"],["と"],["言います","いいます"],["。"]]},{"verse":12,"text":"神,かみよ、わたしに遠,とおざからないでください。わが神,かみよ、すみやかに来,きてわたしを助,たすけてください。","tok":[["神","かみ"],["よ"],["、"],["わたし"],["に"],["遠ざからないで","とおざからないで"],["ください"],["。"],["わが"],["神","かみ"],["よ"],["、"],["すみやか"],["に"],["来て","きて"],["わたし"],["を"],["助けて","たすけて"],["ください"],["。"]]},{"verse":13,"text":"わたしにあだする者,ものを恥,はじさせ、滅,ほろぼしてください。わたしをそこなわんとする者,ものを、そしりと、はずかしめとをもっておおってください。","tok":[["わたし"],["に"],["あだ"],["する"],["者","もの"],["を"],["恥","はじ"],["させ"],["、"],["滅ぼして","ほろぼして"],["ください"],["。"],["わたし"],["を"],["そこなわん"],["と"],["する"],["者","もの"],["を"],["、"],["そしり"],["と"],["、"],["はずかしめ"],["と"],["を"],["もって"],["おおって"],["ください"],["。"]]},{"verse":14,"text":"しかしわたしは絶,たえず望,のぞみをいだいて、いよいよあなたをほめたたえるでしょう。","tok":[["しかし"],["わたし"],["は"],["絶えず","たえず"],["望み","のぞみ"],["を"],["いだいて"],["、"],["いよいよ"],["あなた"],["を"],["ほめたたえるでしょう"],["。"]]},{"verse":15,"text":"わたしの口,くちはひねもすあなたの義,ぎと、あなたの救,すくいとを語,かたるでしょう。わたしはその数,かずを知,しらないからです。","tok":[["わたし"],["の"],["口","くち"],["は"],["ひねもす"],["あなた"],["の"],["義","ぎ"],["と"],["、"],["あなた"],["の"],["救い","すくい"],["と"],["を"],["語るでしょう","かたるでしょう"],["。"],["わたし"],["は"],["その"],["数","かず"],["を"],["知らない","しらない"],["から"],["です"],["。"]]},{"verse":16,"text":"わたしは主,しゅなる神,かみの大能,たいのうのみわざを携,たずさえゆき、ただあなたの義,ぎのみを、ほめたたえるでしょう。","tok":[["わたし"],["は"],["主","しゅ"],["なる"],["神","かみ"],["の"],["大能","たいのうのみわざ"],["を"],["携え","たずさえ"],["ゆき"],["、"],["ただ"],["あなた"],["の"],["義","ぎ"],["のみ"],["を"],["、"],["ほめたたえるでしょう"],["。"]]},{"verse":17,"text":"神,かみよ、あなたはわたしを若,わかい時,ときから教,おしえられました。わたしはなお、あなたのくすしきみわざを宣,のべ伝,つたえます。","tok":[["神","かみ"],["よ"],["、"],["あなた"],["は"],["わたし"],["を"],["若い","わかい"],["時","とき"],["から"],["教えられました","おしえられました"],["。"],["わたし"],["は"],["なお"],["、"],["あなた"],["の"],["くす"],["しきみ"],["わざ"],["を"],["宣べ伝えます","のべつたえます"],["。"]]},{"verse":18,"text":"神,かみよ、わたしが年老,としおいて、しらがとなるとも、あなたの力,ちからをきたらんとするすべての代,よに宣,のべ伝,つたえるまで、わたしを見捨,みすてないでください。","tok":[["神","かみ"],["よ"],["、"],["わたし"],["が"],["年老いて","としおいて"],["、"],["しらが"],["と"],["なる"],["とも"],["、"],["あなた"],["の"],["力","ちから"],["を"],["きたらん"],["と"],["する"],["すべて"],["の"],["代","よ"],["に"],["宣べ伝える","のべつたえる"],["まで"],["、"],["わたし"],["を"],["見捨てないで","みすてないで"],["ください"],["。"]]},{"verse":19,"text":"神,かみよ、あなたの大能,たいのうと義,ぎとは高,たかい天,てんにまで及,およぶ。あなたは大,おおいなる事,ことをなされました。神,かみよ、だれかあなたに等,ひとしい者,ものがあるでしょうか。","tok":[["神","かみ"],["よ"],["、"],["あなた"],["の"],["大能","たいのう"],["と"],["義","ぎ"],["と"],["は"],["高かい","たかい"],["天","てん"],["に"],["まで"],["及ぶ","およぶ"],["。"],["あなた"],["は"],["大いなる","おおいなる"],["事","こと"],["を"],["なされました"],["。"],["神","かみ"],["よ"],["、"],["だれ"],["か"],["あなた"],["に"],["等い","ひとしい"],["者","もの"],["が"],["あるでしょう"],["か"],["。"]]},{"verse":20,"text":"あなたはわたしを多,おおくの重,おもい悩,なやみにあわされましたが、再,ふたたびわたしを生,いかし、地,ちの深,ふかい所,ところから引,ひきあげられるでしょう。","tok":[["あなた"],["は"],["わたし"],["を"],["多く","おおく"],["の"],["重い","おもい"],["悩み","なやみ"],["に"],["あわされました"],["が"],["、"],["再び","ふたたび"],["わたし"],["を"],["生かし","いかし"],["、"],["地","ち"],["の"],["深い","ふかい"],["所","ところ"],["から"],["引","ひき"],["あげられるでしょう"],["。"]]},{"verse":21,"text":"あなたはわたしの誉,ほまれを増,まし、再,ふたたびわたしを慰,なぐさめられるでしょう。","tok":[["あなた"],["は"],["わたし"],["の"],["誉","ほまれ"],["を"],["増し","まし"],["、"],["再び","ふたたび"],["わたし"],["を"],["慰さめられるでしょう","なぐさめられるでしょう"],["。"]]},{"verse":22,"text":"わが神,かみよ、わたしはまた立琴,たてごとをもってあなたと、あなたのまこととをほめたたえます。イスラエルの聖者,せいじゃよ、わたしは琴,ことをもってあなたをほめ歌,うたいます。","tok":[["わが"],["神","かみ"],["よ"],["、"],["わたし"],["は"],["また"],["立琴","たてごと"],["を"],["もって"],["あなた"],["と"],["、"],["あなた"],["の"],["まこと"],["と"],["を"],["ほめたたえます"],["。"],["イスラエル"],["の"],["聖者","せいじゃ"],["よ"],["、"],["わたし"],["は"],["琴","こと"],["を"],["もって"],["あなた"],["を"],["ほめ"],["歌います","うたいます"],["。"]]},{"verse":23,"text":"わたしがあなたにむかってほめ歌,うたうとき、わがくちびるは喜,よろこび呼,よばわり、あなたがあがなわれたわが魂,たましいもまた喜,よろこび呼,よばわるでしょう。","tok":[["わたし"],["が"],["あなた"],["に"],["むかって"],["ほめ歌","ほめうた"],["う"],["とき"],["、"],["わが"],["くちびる"],["は"],["喜こび","よろこび"],["呼ばわり","よばわり"],["、"],["あなた"],["が"],["あがなわれた"],["わが"],["魂","たましい"],["も"],["また"],["喜こび","よろこび"],["呼ばわるでしょう","よばわるでしょう"],["。"]]},{"verse":24,"text":"わたしの舌,したもまたひねもすあなたの義,ぎを語,かたるでしょう。わたしをそこなわんとした者,ものが恥,はじあわてたからです。","tok":[["わたし"],["の"],["舌","した"],["も"],["また"],["ひねもす"],["あなた"],["の"],["義","ぎ"],["を"],["語るでしょう","かたるでしょう"],["。"],["わたし"],["を"],["そこなわん"],["と"],["した"],["者","もの"],["が"],["恥","はじ"],["あわてた"],["から"],["です"],["。"]]}]
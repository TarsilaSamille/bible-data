[{"verse":1,"text":"わたしの兄弟,きょうだいたちよ。わたしたちの栄光,えいこうの主,しゅイエス・キリストへの信仰,しんこうを守,まもるのに、分,わけ隔,へだてをしてはならない。","tok":[["わたし"],["の"],["兄弟","きょうだい"],["たち"],["よ"],["。"],["わたしたち"],["の"],["栄光","えいこう"],["の"],["主","しゅ"],["イエス"],["・"],["キリスト"],["へ"],["の"],["信仰","しんこう"],["を"],["守","まもる"],["のに"],["、"],["分け隔て","わけへだて"],["を"],["して"],["は"],["ならない"],["。"]]},{"verse":2,"text":"たとえば、あなたがたの会堂,かいどうに、金,きんの指輪,ゆびわをはめ、りっぱな着物,きものを着,きた人,ひとがはいって来,くると同時,どうじに、みすぼらしい着物,きものを着,きた貧,まずしい人,ひとがはいってきたとする。","tok":[["たとえば"],["、"],["あなた"],["がた"],["の"],["会堂","かいどう"],["に"],["、"],["金","きん"],["の"],["指輪","ゆびわ"],["を"],["はめ"],["、"],["りっぱ"],["な"],["着物","きもの"],["を"],["着た","きた"],["人","ひと"],["が"],["はいって"],["来る","くる"],["と"],["同時","どうじ"],["に"],["、"],["みすぼらしい"],["着物","きもの"],["を"],["着た","きた"],["貧しい","まずしい"],["人","ひと"],["が"],["はいって"],["きた"],["と"],["する"],["。"]]},{"verse":3,"text":"その際,さい、りっぱな着物,きものを着,きた人,ひとに対,たいしては、うやうやしく「どうぞ、こちらの良,よい席,せきにお掛,かけ下,ください」と言,いい、貧,まずしい人,ひとには、「あなたは、そこに立,たっていなさい。それとも、わたしの足,あしもとにすわっているがよい」と言,いったとしたら、","tok":[["その"],["際","さい"],["、"],["りっぱ"],["な"],["着物","きもの"],["を"],["着た","きた"],["人","ひと"],["に"],["対し","たいし"],["ては"],["、"],["うやうやしく"],["「"],["どうぞ"],["、"],["こちら"],["の"],["良い","よい"],["席","せき"],["に"],["お掛","おかけ"],["下さい","ください"],["」"],["と"],["言い","いい"],["、"],["貧しい","まずしい"],["人","ひと"],["に"],["は"],["、"],["「"],["あなた"],["は"],["、"],["そこ"],["に"],["立って","たって"],["い"],["なさい"],["。"],["それ"],["と"],["も"],["、"],["わたし"],["の"],["足もと","あしもと"],["に"],["すわって"],["いる"],["が"],["よい"],["」"],["と"],["言った","いった"],["と"],["したら"],["、"]]},{"verse":4,"text":"あなたがたは、自分,じぶんたちの間,あいだで差別,さべつ立,だてをし、よからぬ考,かんがえで人,ひとをさばく者,ものになったわけではないか。","tok":[["あなた"],["がた"],["は"],["、"],["自分","じぶん"],["たち"],["の"],["間","あいだ"],["で"],["差別立","さべつだて"],["を"],["し"],["、"],["よからぬ"],["考","かんがえ"],["で"],["人","ひと"],["を"],["さばく"],["者","もの"],["に"],["なった"],["わけ"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":5,"text":"愛,あいする兄弟,きょうだいたちよ。よく聞,ききなさい。神,かみは、この世,よの貧,まずしい人,ひとたちを選,えらんで信仰,しんこうに富,とませ、神,かみを愛,あいする者,ものたちに約束,やくそくされた御国,みくにの相続者,そうぞくしゃとされたではないか。","tok":[["愛する","あいする"],["兄弟","きょうだい"],["たち"],["よ"],["。"],["よく"],["聞","きき"],["なさい"],["。"],["神","かみ"],["は"],["、"],["この世","このよ"],["の"],["貧しい","まずしい"],["人","ひと"],["たち"],["を"],["選らんで","えらんで"],["信仰","しんこう"],["に"],["富ませ","とませ"],["、"],["神","かみ"],["を"],["愛する","あいする"],["者","もの"],["たち"],["に"],["約束","やくそく"],["された"],["御国","みくに"],["の"],["相続者","そうぞくしゃ"],["と"],["されたで"],["は"],["ない"],["か"],["。"]]},{"verse":6,"text":"しかるに、あなたがたは貧,まずしい人,ひとをはずかしめたのである。あなたがたをしいたげ、裁判所,さいばんしょに引,ひきずり込,こむのは、富,とんでいる者,ものたちではないか。","tok":[["しかる"],["に"],["、"],["あなた"],["がた"],["は"],["貧しい","まずしい"],["人","ひと"],["を"],["はずかしめた"],["ので"],["ある"],["。"],["あなた"],["がた"],["を"],["しいたげ"],["、"],["裁判所","さいばんしょ"],["に"],["引","ひき"],["ずり"],["込む","こむ"],["の"],["は"],["、"],["富","とん"],["で"],["いる"],["者","もの"],["たち"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":7,"text":"あなたがたに対,たいして唱,となえられた尊,たっとい御名,みなを汚,けがすのは、実,じつに彼,かれらではないか。","tok":[["あなた"],["がた"],["に対して","にたいして"],["唱えられた","となえられた"],["尊","た"],["っと"],["い"],["御名","みな"],["を"],["汚す","けがす"],["の"],["は"],["、"],["実","じつ"],["に"],["彼","かれ"],["ら"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":8,"text":"しかし、もしあなたがたが、「自分,じぶんを愛,あいするように、あなたの隣,となり人,ひとを愛,あいせよ」という聖書,せいしょの言葉,ことばに従,したがって、このきわめて尊,たっとい律法,りっぽうを守,まもるならば、それは良,よいことである。","tok":[["しかし"],["、"],["もし"],["あなた"],["が"],["た"],["が"],["、"],["「"],["自分","じぶん"],["を"],["愛する","あいする"],["よう"],["に"],["、"],["あなた"],["の"],["隣人","となりひと"],["を"],["愛せよ","あいせよ"],["」"],["と"],["いう"],["聖書","せいしょ"],["の"],["言葉","ことば"],["に"],["従って","したがって"],["、"],["この"],["きわめて"],["尊","た"],["っと"],["い"],["律法","りっぽう"],["を"],["守","まもる"],["ならば"],["、"],["それ"],["は"],["良い","よい"],["こと"],["で"],["ある"],["。"]]},{"verse":9,"text":"しかし、もし分,わけ隔,へだてをするならば、あなたがたは罪,つみを犯,おかすことになり、律法,りっぽうによって違反者,いはんしゃとして宣告,せんこくされる。","tok":[["しかし"],["、"],["もし"],["分け隔て","わけへだて"],["を"],["するならば"],["、"],["あなた"],["がた"],["は"],["罪","つみ"],["を"],["犯す","おかす"],["こと"],["に"],["なり"],["、"],["律法","りっぽう"],["によって"],["違反者","いはんしゃ"],["として"],["宣告","せんこく"],["される"],["。"]]},{"verse":10,"text":"なぜなら、律法,りっぽうをことごとく守,まもったとしても、その一つの点,てんにでも落,おち度,どがあれば、全体,ぜんたいを犯,おかしたことになるからである。","tok":[["なぜ"],["なら"],["、"],["律法","りっぽう"],["を"],["ことごとく"],["守った","まもった"],["として"],["も"],["、"],["その"],["一","ひと"],["つ"],["の"],["点","てん"],["に"],["で"],["も"],["落度","おちど"],["が"],["あれば"],["、"],["全体","ぜんたい"],["を"],["犯した","おかした"],["こと"],["に"],["なる"],["から"],["で"],["ある"],["。"]]},{"verse":11,"text":"たとえば、「姦淫,かんいんするな」と言,いわれたかたは、また「殺,ころすな」とも仰,おおせになった。そこで、たとい姦淫,かんいんはしなくても、人殺,ひとごろしをすれば、律法,りっぽうの違反者,いはんしゃになったことになる。","tok":[["たとえば"],["、"],["「"],["姦淫","かんいん"],["する"],["な"],["」"],["と"],["言われた","いわれた"],["かた"],["は"],["、"],["また"],["「"],["殺ろす","ころす"],["な"],["」"],["と"],["も"],["仰せ","おおせ"],["に"],["なった"],["。"],["そこ"],["で"],["、"],["たとい"],["姦淫","かんいん"],["は"],["しなくて"],["も"],["、"],["人殺し","ひとごろし"],["を"],["すれば"],["、"],["律法","りっぽう"],["の"],["違反者","いはんしゃ"],["に"],["なった"],["こと"],["に"],["なる"],["。"]]},{"verse":12,"text":"だから、自由,じゆうの律法,りっぽうによってさばかるべき者,ものらしく語,かたり、かつ行,おこないなさい。","tok":[["だ"],["から"],["、"],["自由","じゆう"],["の"],["律法","りっぽう"],["によって"],["さばかるべき"],["者","もの"],["らしく"],["語り","かたり"],["、"],["かつ"],["行ない","おこない"],["なさい"],["。"]]},{"verse":13,"text":"あわれみを行,おこなわなかった者,ものに対,たいしては、仮借,かしゃくのないさばきが下,くだされる。あわれみは、さばきにうち勝,かつ。","tok":[["あわれみ"],["を"],["行なわなかった","おこなわなかった"],["者","もの"],["に"],["対し","たいし"],["ては"],["、"],["仮借","かしゃく"],["の"],["ない"],["さばき"],["が"],["下される","くだされる"],["。"],["あわれみ"],["は"],["、"],["さばき"],["に"],["うち勝つ","うちかつ"],["。"]]},{"verse":14,"text":"わたしの兄弟,きょうだいたちよ。ある人,ひとが自分,じぶんには信仰,しんこうがあると称,しょうしていても、もし行,おこないがなかったら、なんの役,やくに立,たつか。その信仰,しんこうは彼,かれを救,すくうことができるか。","tok":[["わたし"],["の"],["兄弟","きょうだい"],["たち"],["よ"],["。"],["ある"],["人","ひと"],["が"],["自分","じぶん"],["に"],["は"],["信仰","しんこう"],["が"],["ある"],["と"],["称して","しょうして"],["いて"],["も"],["、"],["もし"],["行ない","おこない"],["が"],["なかったら"],["、"],["なん"],["の"],["役","やく"],["に"],["立つ","たつ"],["か"],["。"],["その"],["信仰","しんこう"],["は"],["彼","かれ"],["を"],["救う","すくう"],["こと"],["が"],["できる"],["か"],["。"]]},{"verse":15,"text":"ある兄弟,きょうだいまたは姉妹,しまいが裸,はだかでいて、その日,ひの食物,しょくもつにもこと欠,かいている場合,ばあい、","tok":[["ある"],["兄弟","きょうだい"],["また"],["は"],["姉妹","しまい"],["が"],["裸","はだか"],["で"],["いて"],["、"],["その"],["日","ひ"],["の"],["食物","しょくもつ"],["に"],["も"],["こと欠いて","ことかいて"],["いる"],["場合","ばあい"],["、"]]},{"verse":16,"text":"あなたがたのうち、だれかが、「安,やすらかに行,いきなさい。暖,あたたまって、食,たべ飽,あきなさい」と言,いうだけで、そのからだに必要,ひつようなものを何,なにひとつ与,あたえなかったとしたら、なんの役,やくに立,たつか。","tok":[["あなた"],["がた"],["の"],["うち"],["、"],["だれ"],["か"],["が"],["、"],["「"],["安らか","やすらか"],["に"],["行き","いき"],["なさい"],["。"],["暖まって","あたたまって"],["、"],["食べ飽き","たべあき"],["なさい"],["」"],["と"],["言う","いう"],["だけ"],["で"],["、"],["その"],["からだ"],["に"],["必要","ひつよう"],["な"],["もの"],["を"],["何","な"],["に"],["ひと"],["つ"],["与えなかった","あたえなかった"],["と"],["したら"],["、"],["なん"],["の"],["役","やく"],["に"],["立つ","たつ"],["か"],["。"]]},{"verse":17,"text":"信仰,しんこうも、それと同様,どうように、行,おこないを伴,ともなわなければ、それだけでは死,しんだものである。","tok":[["信仰","しんこう"],["も"],["、"],["それ"],["と"],["同様","どうよう"],["に"],["、"],["行ない","おこない"],["を"],["伴なわなければ","ともなわなければ"],["、"],["それ"],["だけ"],["で"],["は"],["死んだ","しんだ"],["もの"],["で"],["ある"],["。"]]},{"verse":18,"text":"しかし、「ある人,ひとには信仰,しんこうがあり、またほかの人,ひとには行,おこないがある」と言,いう者,ものがあろう。それなら、行,おこないのないあなたの信仰,しんこうなるものを見,みせてほしい。そうしたら、わたしの行,おこないによって信仰,しんこうを見,みせてあげよう。","tok":[["しかし"],["、"],["「"],["ある"],["人","ひと"],["に"],["は"],["信仰","しんこう"],["が"],["あり"],["、"],["また"],["ほか"],["の"],["人","ひと"],["に"],["は"],["行ない","おこない"],["が"],["ある"],["」"],["と"],["言う","いう"],["者","もの"],["が"],["あろう"],["。"],["それ"],["なら"],["、"],["行ない","おこない"],["の"],["ない"],["あなた"],["の"],["信仰","しんこう"],["なる"],["もの"],["を"],["見せて","みせて"],["ほしい"],["。"],["そう"],["したら"],["、"],["わたし"],["の"],["行ない","おこない"],["によって"],["信仰","しんこう"],["を"],["見せて","みせて"],["あげよう"],["。"]]},{"verse":19,"text":"あなたは、神,かみはただひとりであると信,しんじているのか。それは結構,けっこうである。悪霊,あくりょうどもでさえ、信,しんじておののいている。","tok":[["あなた"],["は"],["、"],["神","かみ"],["は"],["ただ"],["ひとり"],["で"],["ある"],["と"],["信じて","しんじて"],["いる"],["の"],["か"],["。"],["それ"],["は"],["結構","けっこう"],["で"],["ある"],["。"],["悪霊","あくりょう"],["ども"],["で"],["さえ"],["、"],["信じて","しんじて"],["おののいて"],["いる"],["。"]]},{"verse":20,"text":"ああ、愚,おろかな人,ひとよ。行,おこないを伴,ともなわない信仰,しんこうのむなしいことを知,しりたいのか。","tok":[["ああ"],["、"],["愚か","おろか"],["な"],["人","ひと"],["よ"],["。"],["行ない","おこない"],["を"],["伴なわない","ともなわない"],["信仰","しんこう"],["の"],["むなしい"],["こと"],["を"],["知りたい","しりたい"],["の"],["か"],["。"]]},{"verse":21,"text":"わたしたちの父祖,ふそアブラハムは、その子,こイサクを祭壇,さいだんにささげた時,とき、行,おこないによって義,ぎとされたのではなかったか。","tok":[["わたしたち"],["の"],["父祖","ふそ"],["アブラハム"],["は"],["、"],["その"],["子","こ"],["イサク"],["を"],["祭壇","さいだん"],["に"],["ささげた"],["時","とき"],["、"],["行ない","おこない"],["によって"],["義","ぎ"],["と"],["された"],["ので"],["は"],["なかった"],["か"],["。"]]},{"verse":22,"text":"あなたが知,しっているとおり、彼,かれにおいては、信仰,しんこうが行,おこないと共,ともに働,はたらき、その行,おこないによって信仰,しんこうが全,まっとうされ、","tok":[["あなた"],["が"],["知って","しって"],["いる"],["とおり"],["、"],["彼","かれ"],["に"],["おいて"],["は"],["、"],["信仰","しんこう"],["が"],["行ない","おこない"],["と"],["共","とも"],["に"],["働らき","はたらき"],["、"],["その"],["行ない","おこない"],["によって"],["信仰","しんこう"],["が"],["全う","まっとう"],["され"],["、"]]},{"verse":23,"text":"こうして、「アブラハムは神,かみを信,しんじた。それによって、彼,かれは義,ぎと認,みとめられた」という聖書,せいしょの言葉,ことばが成就,じょうじゅし、そして、彼,かれは「神,かみの友,とも」と唱,となえられたのである。","tok":[["こう"],["して"],["、"],["「"],["アブラハム"],["は"],["神","かみ"],["を"],["信じた","しんじた"],["。"],["それ"],["によって"],["、"],["彼","かれ"],["は"],["義","ぎ"],["と"],["認められた","みとめられた"],["」"],["と"],["いう"],["聖書","せいしょ"],["の"],["言葉","ことば"],["が"],["成就","じょうじゅ"],["し"],["、"],["そして"],["、"],["彼","かれ"],["は"],["「"],["神","かみ"],["の"],["友","とも"],["」"],["と"],["唱えられた","となえられた"],["ので"],["ある"],["。"]]},{"verse":24,"text":"これでわかるように、人,ひとが義,ぎとされるのは、行,おこないによるのであって、信仰,しんこうだけによるのではない。","tok":[["これ"],["で"],["わかる"],["よう"],["に"],["、"],["人","ひと"],["が"],["義","ぎ"],["と"],["される"],["の"],["は"],["、"],["行ない","おこない"],["に"],["よる"],["ので"],["あって"],["、"],["信仰","しんこう"],["だけ"],["に"],["よる"],["ので"],["は"],["ない"],["。"]]},{"verse":25,"text":"同,おなじように、かの遊女,ゆうじょラハブでさえも、使者,ししゃたちをもてなし、彼,かれらを別,べつな道,みちから送,おくり出,だした時,とき、行,おこないによって義,ぎとされたではないか。","tok":[["同じ","おなじ"],["よう"],["に"],["、"],["かの"],["遊女","ゆうじょ"],["ラハブ"],["で"],["さえ"],["も"],["、"],["使者","ししゃ"],["たち"],["を"],["もてなし"],["、"],["彼","かれ"],["ら"],["を"],["別","べつ"],["な"],["道","みち"],["から"],["送り出した","おくりだした"],["時","とき"],["、"],["行ない","おこない"],["によって"],["義","ぎ"],["と"],["されたで"],["は"],["ない"],["か"],["。"]]},{"verse":26,"text":"霊魂,れいこんのないからだが死,しんだものであると同様,どうように、行,おこないのない信仰,しんこうも死,しんだものなのである。","tok":[["霊魂","れいこん"],["の"],["ない"],["からだ"],["が"],["死んだ","しんだ"],["もの"],["で"],["ある"],["と"],["同様","どうよう"],["に"],["、"],["行ない","おこない"],["の"],["ない"],["信仰","しんこう"],["も"],["死んだ","しんだ"],["もの"],["な"],["ので"],["ある"],["。"]]}]
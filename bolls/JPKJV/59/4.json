[{"verse":1,"text":"あなたがたの中,なかの戦,たたかいや争,あらそいは、いったい、どこから起,おこるのか。それはほかではない。あなたがたの肢体,したいの中,なかで相戦,あいたたかう欲情,よくじょうからではないか。","tok":[["あなた"],["がた"],["の"],["中","なか"],["の"],["戦い","たたかい"],["や"],["争い","あらそい"],["は"],["、"],["いったい"],["、"],["どこ"],["から"],["起こる","おこる"],["の"],["か"],["。"],["それ"],["は"],["ほか"],["で"],["は"],["ない"],["。"],["あなた"],["がた"],["の"],["肢体","したい"],["の"],["中","なか"],["で"],["相","あい"],["戦う","たたかう"],["欲情","よくじょう"],["から"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":2,"text":"あなたがたは、むさぼるが得,えられない。そこで人殺,ひとごろしをする。熱望,ねつぼうするが手,てに入,いれることができない。そこで争,あらそい戦,たたかう。あなたがたは、求,もとめないから得,えられないのだ。","tok":[["あなた"],["がた"],["は"],["、"],["むさぼる"],["が"],["得られない","えられない"],["。"],["そこ"],["で"],["人殺し","ひとごろし"],["を"],["する"],["。"],["熱望","ねつぼう"],["する"],["が"],["手","て"],["に"],["入れる","いれる"],["こと"],["が"],["できない"],["。"],["そこ"],["で"],["争い","あらそい"],["戦う","たたかう"],["。"],["あなた"],["がた"],["は"],["、"],["求めない","もとめない"],["から"],["得られない","えられない"],["の"],["だ"],["。"]]},{"verse":3,"text":"求,もとめても与,あたえられないのは、快楽,かいらくのために使,つかおうとして、悪,わるい求,もとめ方,ほうをするからだ。","tok":[["求めて","もとめて"],["も"],["与えられない","あたえられない"],["の"],["は"],["、"],["快楽","かいらく"],["の"],["ため"],["に"],["使おう","つかおう"],["として"],["、"],["悪い","わるい"],["求め","もとめ"],["方","ほう"],["を"],["する"],["から"],["だ"],["。"]]},{"verse":4,"text":"不貞,ふていのやからよ。世,よを友,ともとするのは、神,かみへの敵対,てきたいであることを、知,しらないか。おおよそ世,よの友,ともとなろうと思,おもう者,ものは、自,みずからを神,かみの敵,てきとするのである。","tok":[["不貞","ふてい"],["の"],["やから"],["よ"],["。"],["世","よ"],["を"],["友","とも"],["と"],["する"],["の"],["は"],["、"],["神","かみ"],["へ"],["の"],["敵対","てきたい"],["で"],["ある"],["こと"],["を"],["、"],["知らない","しらない"],["か"],["。"],["おおよそ"],["世","よ"],["の"],["友","とも"],["と"],["なろう"],["と"],["思う","おもう"],["者","もの"],["は"],["、"],["自から","みずから"],["を"],["神","かみ"],["の"],["敵","てき"],["と"],["する"],["ので"],["ある"],["。"]]},{"verse":5,"text":"それとも、「神,かみは、わたしたちの内,うちに住,すまわせた霊,れいを、ねたむほどに愛,あいしておられる」と聖書,せいしょに書,かいてあるのは、むなしい言葉,ことばだと思,おもうのか。","tok":[["それ"],["と"],["も"],["、"],["「"],["神","かみ"],["は"],["、"],["わたしたち"],["の"],["内","うち"],["に"],["住まわせた","すまわせた"],["霊","れい"],["を"],["、"],["ねたむ"],["ほど"],["に"],["愛して","あいして"],["おられる"],["」"],["と"],["聖書","せいしょ"],["に"],["書いて","かいて"],["ある"],["の"],["は"],["、"],["むなしい"],["言葉","ことば"],["だ"],["と"],["思","おもう"],["の"],["か"],["。"]]},{"verse":6,"text":"しかし神,かみは、いや増,ましに恵,めぐみを賜,たまう。であるから、「神,かみは高,たかぶる者,ものをしりぞけ、へりくだる者,ものに恵,めぐみを賜,たまう」とある。","tok":[["しかし"],["神","かみ"],["は"],["、"],["いや"],["増し","まし"],["に"],["恵","めぐみ"],["を"],["賜う","たまう"],["。"],["で"],["ある"],["から"],["、"],["「"],["神","かみ"],["は"],["高か","たか"],["ぶる"],["者","もの"],["を"],["しりぞけ"],["、"],["へりくだる"],["者","もの"],["に"],["恵","めぐみ"],["を"],["賜う","たまう"],["」"],["と"],["ある"],["。"]]},{"verse":7,"text":"そういうわけだから、神,かみに従,したがいなさい。そして、悪魔,あくまに立,たちむかいなさい。そうすれば、彼,かれはあなたがたから逃,にげ去,さるであろう。","tok":[["そう"],["いう"],["わけ"],["だ"],["から"],["、"],["神","かみ"],["に"],["従い","したがい"],["なさい"],["。"],["そして"],["、"],["悪魔","あくま"],["に"],["立ちむかい","たちむかい"],["なさい"],["。"],["そう"],["すれば"],["、"],["彼","かれ"],["は"],["あなた"],["がた"],["から"],["逃","にげ"],["去るで","さるで"],["あろう"],["。"]]},{"verse":8,"text":"神,かみに近,ちかづきなさい。そうすれば、神,かみはあなたがたに近,ちかづいて下,くださるであろう。罪人,つみびとどもよ、手,てをきよめよ。二心,ふたごころの者,ものどもよ、心,こころを清,きよくせよ。","tok":[["神","かみ"],["に"],["近づき","ちかづき"],["なさい"],["。"],["そう"],["すれば"],["、"],["神","かみ"],["は"],["あなた"],["がた"],["に"],["近づいて","ちかづいて"],["下さるで","くださるで"],["あろう"],["。"],["罪人","つ"],["みびと"],["ども"],["よ"],["、"],["手","て"],["を"],["きよめよ"],["。"],["二心","ふたごころ"],["の"],["者","もの"],["ども"],["よ"],["、"],["心","こころ"],["を"],["清く","きよく"],["せよ"],["。"]]},{"verse":9,"text":"苦,くるしめ、悲,かなしめ、泣,なけ。あなたがたの笑,わらいを悲,かなしみに、喜,よろこびを憂,うれいに変,かえよ。","tok":[["苦しめ","くるしめ"],["、"],["悲しめ","かなしめ"],["、"],["泣け","なけ"],["。"],["あなた"],["がた"],["の"],["笑","わらい"],["を"],["悲しみ","かなしみ"],["に"],["、"],["喜こび","よろこび"],["を"],["憂","うれい"],["に"],["変え","かえ"],["よ"],["。"]]},{"verse":10,"text":"主,しゅのみまえにへりくだれ。そうすれば、主,しゅは、あなたがたを高,たかくして下,くださるであろう。","tok":[["主","しゅ"],["のみ"],["まえ"],["に"],["へりくだれ"],["。"],["そう"],["すれば"],["、"],["主","しゅ"],["は"],["、"],["あなた"],["がた"],["を"],["高かく","たかく"],["して"],["下さるで","くださるで"],["あろう"],["。"]]},{"verse":11,"text":"兄弟,きょうだいたちよ。互,たがいに悪口,わるぐちを言,いい合,あってはならない。兄弟,きょうだいの悪口,わるぐちを言,いったり、自分,じぶんの兄弟,きょうだいをさばいたりする者,ものは、律法,りっぽうをそしり、律法,りっぽうをさばくやからである。もしあなたが律法,りっぽうをさばくなら、律法,りっぽうの実行,じっこう者,ものではなくて、その審判者,しんぱんしゃなのである。","tok":[["兄弟","きょうだい"],["たち"],["よ"],["。"],["互","たがい"],["に"],["悪口","わるぐち"],["を"],["言い合って","いいあって"],["は"],["ならない"],["。"],["兄弟","きょうだい"],["の"],["悪口","わるぐち"],["を"],["言っ","いっ"],["たり"],["、"],["自分","じぶん"],["の"],["兄弟","きょうだい"],["を"],["さばい"],["たり"],["する"],["者","もの"],["は"],["、"],["律法","りっぽう"],["を"],["そしり"],["、"],["律法","りっぽう"],["を"],["さばく"],["やから"],["で"],["ある"],["。"],["もし"],["あなた"],["が"],["律法","りっぽう"],["を"],["さばくなら"],["、"],["律法","りっぽう"],["の"],["実行者","じっこうもの"],["で"],["は"],["なくて"],["、"],["その"],["審判者","しんぱんしゃ"],["な"],["ので"],["ある"],["。"]]},{"verse":12,"text":"しかし、立法,りっぽう者,しゃであり審判者,しんぱんしゃであるかたは、ただひとりであって、救,すくうことも滅,ほろぼすこともできるのである。しかるに、隣,となり人,ひとをさばくあなたは、いったい、何者,なにものであるか。","tok":[["しかし"],["、"],["立法者","りっぽうしゃ"],["で"],["あり"],["審判者","しんぱんしゃ"],["で"],["ある"],["かた"],["は"],["、"],["ただ"],["ひとり"],["で"],["あって"],["、"],["救う","すくう"],["こと"],["も"],["滅ぼす","ほろぼす"],["こと"],["も"],["できる"],["ので"],["ある"],["。"],["しかる"],["に"],["、"],["隣人","となりひと"],["を"],["さばく"],["あなた"],["は"],["、"],["いったい"],["、"],["何者","なにもの"],["で"],["ある"],["か"],["。"]]},{"verse":13,"text":"よく聞,ききなさい。「きょうか、あす、これこれの町,まちへ行,いき、そこに一か年,ねん滞在,たいざいし、商売,しょうばいをして一,ひともうけしよう」と言,いう者,ものたちよ。","tok":[["よく"],["聞","きき"],["なさい"],["。"],["「"],["きょうか"],["、"],["あす"],["、"],["これ"],["これ"],["の"],["町","まち"],["へ"],["行き","いき"],["、"],["そこ"],["に"],["一","いち"],["か年","かねん"],["滞在","たいざい"],["し"],["、"],["商売","しょうばい"],["を"],["して"],["一もうけ","ひともうけ"],["しよう"],["」"],["と"],["言う","いう"],["者","もの"],["たち"],["よ"],["。"]]},{"verse":14,"text":"あなたがたは、あすのこともわからぬ身,みなのだ。あなたがたのいのちは、どんなものであるか。あなたがたは、しばしの間,あいだあらわれて、たちまち消,きえ行,いく霧,きりにすぎない。","tok":[["あなた"],["がた"],["は"],["、"],["あす"],["の"],["こと"],["も"],["わからぬ"],["身","み"],["な"],["の"],["だ"],["。"],["あなた"],["がた"],["の"],["いのち"],["は"],["、"],["どんな"],["もの"],["で"],["ある"],["か"],["。"],["あなた"],["がた"],["は"],["、"],["しばし"],["の"],["間","あいだ"],["あらわれて"],["、"],["たちまち"],["消え行く","きえいく"],["霧","きり"],["に"],["すぎない"],["。"]]},{"verse":15,"text":"むしろ、あなたがたは「主,しゅのみこころであれば、わたしは生,いきながらえもし、あの事,ことこの事,こともしよう」と言,いうべきである。","tok":[["むしろ"],["、"],["あなた"],["がた"],["は"],["「"],["主","しゅ"],["のみ"],["こころ"],["で"],["あれば"],["、"],["わたし"],["は"],["生き","いき"],["ながら"],["え"],["もし"],["、"],["あの"],["事","こと"],["この"],["事","こと"],["も"],["しよう"],["」"],["と"],["言うべきで","いうべきで"],["ある"],["。"]]},{"verse":16,"text":"ところが、あなたがたは誇,ほこり高,たかぶっている。このような高慢,こうまんは、すべて悪,あくである。","tok":[["ところ"],["が"],["、"],["あなた"],["がた"],["は"],["誇","ほこり"],["高か","たか"],["ぶっ"],["て"],["いる"],["。"],["この"],["よう"],["な"],["高慢","こうまん"],["は"],["、"],["すべて"],["悪くで","あくで"],["ある"],["。"]]},{"verse":17,"text":"人,ひとが、なすべき善,ぜんを知,しりながら行,おこなわなければ、それは彼,かれにとって罪,つみである。","tok":[["人","ひと"],["が"],["、"],["なすべき"],["善","ぜん"],["を"],["知り","しり"],["ながら"],["行なわなければ","おこなわなければ"],["、"],["それ"],["は"],["彼","かれ"],["にとって"],["罪","つみ"],["で"],["ある"],["。"]]}]
[{"verse":1,"text":"そこでヨブは主,しゅに答,こたえて言,いった、","tok":[["そこ"],["で"],["ヨブ"],["は"],["主に","しゅに"],["答","こたえ"],["て"],["言った","いった"],["、"]]},{"verse":2,"text":"「わたしは知,しります、あなたはすべての事,ことをなすことができ、またいかなるおぼしめしでも、あなたにできないことはないことを。","tok":[["「"],["わたし"],["は"],["知ります","しります"],["、"],["あなた"],["は"],["すべて"],["の"],["事","こと"],["を"],["なす"],["こと"],["が"],["でき"],["、"],["また"],["いかなる"],["おぼしめしで"],["も"],["、"],["あなた"],["に"],["できない"],["こと"],["は"],["ない"],["こと"],["を"],["。"]]},{"verse":3,"text":"『無知,むちをもって神,かみの計,はかりごとをおおうこの者,ものはだれか』。それゆえ、わたしはみずから悟,さとらない事,ことを言,いい、みずから知,しらない、測,はかり難,がたい事,ことを述,のべました。","tok":[["『"],["無知","むち"],["を"],["もって"],["神","かみ"],["の"],["計り","はかり"],["ごと"],["を"],["おおう"],["この"],["者","もの"],["は"],["だれ"],["か"],["』"],["。"],["それ"],["ゆえ"],["、"],["わたし"],["は"],["みずから"],["悟らない","さとらない"],["事","こと"],["を"],["言い","いい"],["、"],["みずから"],["知らない","しらない"],["、"],["測り","はかり"],["難い","がたい"],["事","こと"],["を"],["述べました","のべました"],["。"]]},{"verse":4,"text":"『聞,きけ、わたしは語,かたろう、わたしはあなたに尋,たずねる、わたしに答,こたえよ』。","tok":[["『"],["聞け","きけ"],["、"],["わたし"],["は"],["語ろう","かたろう"],["、"],["わたし"],["は"],["あなた"],["に"],["尋ねる","たずねる"],["、"],["わたし"],["に"],["答","こたえ"],["よ"],["』"],["。"]]},{"verse":5,"text":"わたしはあなたの事,ことを耳,みみで聞,きいていましたが、今,いまはわたしの目,めであなたを拝見,はいけんいたします。","tok":[["わたし"],["は"],["あなた"],["の"],["事","こと"],["を"],["耳","みみ"],["で"],["聞いて","きいて"],["いました"],["が"],["、"],["今","いま"],["は"],["わたし"],["の"],["目","め"],["で"],["あなた"],["を"],["拝見","はいけん"],["いたします"],["。"]]},{"verse":6,"text":"それでわたしはみずから恨,うらみ、ちり灰,はいの中,なかで悔,くいます」。","tok":[["それ"],["で"],["わたし"],["は"],["みずから"],["恨み","うらみ"],["、"],["ちり"],["灰","はい"],["の"],["中","なか"],["で"],["悔います","くいます"],["」"],["。"]]},{"verse":7,"text":"主,しゅはこれらの言葉,ことばをヨブに語,かたられて後,のち、テマンびとエリパズに言,いわれた、「わたしの怒,いかりはあなたとあなたのふたりの友,ともに向,むかって燃,もえる。あなたがたが、わたしのしもべヨブのように正,ただしい事,ことをわたしについて述,のべなかったからである。","tok":[["主","しゅ"],["は"],["これ"],["ら"],["の"],["言葉","ことば"],["を"],["ヨブ"],["に"],["語られて","かたられて"],["後","の"],["ち"],["、"],["テマン"],["び"],["と"],["エリパズ"],["に"],["言われた","いわれた"],["、"],["「"],["わたし"],["の"],["怒り","いかり"],["は"],["あなた"],["と"],["あなた"],["の"],["ふたり"],["の"],["友","とも"],["に"],["向かって","むかって"],["燃える","もえる"],["。"],["あなた"],["が"],["た"],["が"],["、"],["わたし"],["の"],["しもべ"],["ヨブ"],["の"],["よう"],["に"],["正い","ただしい"],["事","こと"],["を"],["わたし"],["について"],["述べなかった","のべなかった"],["から"],["で"],["ある"],["。"]]},{"verse":8,"text":"それで今,いま、あなたがたは雄牛,おうし七頭,とう、雄羊,おひつじ七頭,とうを取,とって、わたしのしもべヨブの所,ところへ行,いき、あなたがたのために燔祭,はんさいをささげよ。わたしのしもべヨブはあなたがたのために祈,いのるであろう。わたしは彼,かれの祈,いのりを受,うけいれるによって、あなたがたの愚,おろかを罰,ばっすることをしない。あなたがたはわたしのしもべヨブのように正,ただしい事,ことをわたしについて述,のべなかったからである」。","tok":[["それ"],["で"],["今","いま"],["、"],["あなた"],["がた"],["は"],["雄牛","おうし"],["七頭","と"],["う"],["、"],["雄羊","おひつじ"],["七頭","とう"],["を"],["取って","とって"],["、"],["わたし"],["の"],["しもべ"],["ヨブ"],["の"],["所","ところ"],["へ"],["行き","いき"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["燔祭","はんさい"],["を"],["ささげ"],["よ"],["。"],["わたし"],["の"],["しもべ"],["ヨブ"],["は"],["あなた"],["がた"],["の"],["ため"],["に"],["祈るで","いのるで"],["あろう"],["。"],["わたし"],["は"],["彼","かれ"],["の"],["祈","いのり"],["を"],["受","うけ"],["いれる"],["によって"],["、"],["あなた"],["がた"],["の"],["愚か","おろか"],["を"],["罰する","ばっする"],["こと"],["を"],["しない"],["。"],["あなた"],["がた"],["は"],["わたし"],["の"],["しもべ"],["ヨブ"],["の"],["よう"],["に"],["正い","ただしい"],["事","こと"],["を"],["わたし"],["について"],["述べなかった","のべなかった"],["から"],["で"],["ある"],["」"],["。"]]},{"verse":9,"text":"そこでテマンびとエリパズ、シュヒびとビルダデ、ナアマびとゾパルは行,いって、主,しゅが彼,かれらに命,めいじられたようにしたので、主,しゅはヨブの祈,いのりを受,うけいれられた。","tok":[["そこ"],["で"],["テマン"],["びと"],["エリパズ"],["、"],["シュヒ"],["びと"],["ビルダデ"],["、"],["ナアマ"],["びと"],["ゾパル"],["は"],["行って","いって"],["、"],["主","しゅ"],["が"],["彼","かれ"],["ら"],["に"],["命じられた","めいじられた"],["よう"],["に"],["した"],["ので"],["、"],["主","しゅ"],["は"],["ヨブ"],["の"],["祈","いのり"],["を"],["受","うけ"],["いれられた"],["。"]]},{"verse":10,"text":"ヨブがその友人,ゆうじんたちのために祈,いのったとき、主,しゅはヨブの繁栄,はんえいをもとにかえし、そして主,しゅはヨブのすべての財産,ざいさんを二倍,ばいに増,まされた。","tok":[["ヨブ"],["が"],["その"],["友人","ゆうじん"],["たち"],["の"],["ため"],["に"],["祈った","いのった"],["とき"],["、"],["主","しゅ"],["は"],["ヨブ"],["の"],["繁栄","はんえい"],["を"],["もと"],["に"],["かえし"],["、"],["そして"],["主","しゅ"],["は"],["ヨブ"],["の"],["すべて"],["の"],["財産","ざいさん"],["を"],["二","に"],["倍","ばい"],["に"],["増された","まされた"],["。"]]},{"verse":11,"text":"そこで彼,かれのすべての兄弟,きょうだい、すべての姉妹,しまい、および彼,かれの旧知,きゅうちの者,ものどもことごとく彼,かれのもとに来,きて、彼,かれと共,ともにその家,いえで飲,のみ食,くいし、かつ主,しゅが彼,かれにくだされたすべての災,わざわいについて彼,かれをいたわり、慰,なぐさめ、おのおの銀,ぎん一ケシタと金,きんの輪,わ一つを彼,かれに贈,おくった。","tok":[["そこ"],["で"],["彼","かれ"],["の"],["すべて"],["の"],["兄弟","きょうだい"],["、"],["すべて"],["の"],["姉妹","しまい"],["、"],["および"],["彼","かれ"],["の"],["旧知","きゅうち"],["の"],["者","もの"],["ども"],["ことごとく"],["彼","かれ"],["の"],["もと"],["に"],["来て","きて"],["、"],["彼","かれ"],["と"],["共","とも"],["に"],["その"],["家","いえ"],["で"],["飲み食い","のみくい"],["し"],["、"],["かつ"],["主","しゅ"],["が"],["彼","かれ"],["に"],["くだされた"],["すべて"],["の"],["災","わざわい"],["について"],["彼","かれ"],["を"],["いたわり"],["、"],["慰さめ","なぐさめ"],["、"],["おのおの"],["銀一","ぎん一"],["ケシタ"],["と"],["金","きん"],["の"],["輪","わ"],["一","ひと"],["つ"],["を"],["彼","かれ"],["に"],["贈った","おくった"],["。"]]},{"verse":12,"text":"主,しゅはヨブの終,おわりを初,はじめよりも多,おおく恵,めぐまれた。彼,かれは羊,ひつじ一万四千頭,とう、らくだ六千頭,とう、牛,うし一千くびき、雌,めろば一千頭,とうをもった。","tok":[["主","しゅ"],["は"],["ヨブ"],["の"],["終","おわり"],["を"],["初め","はじめ"],["より"],["も"],["多く","おおく"],["恵まれた","めぐまれた"],["。"],["彼","かれ"],["は"],["羊","ひつじ"],["一万四千","いちまんよんせん"],["頭","とう"],["う"],["、"],["らくだ"],["六千頭","と"],["う"],["、"],["牛","うし"],["一千","いちせん"],["く"],["びき"],["、"],["雌","め"],["ろば"],["一千頭","とう"],["を"],["もった"],["。"]]},{"verse":13,"text":"また彼,かれは男,おとこの子,こ七人,にん、女,おんなの子,こ三人,にんをもった。","tok":[["また"],["彼","かれ"],["は"],["男の子","おとこのこ"],["七人","にん"],["、"],["女の子","おんなのこ"],["三人","にん"],["を"],["もった"],["。"]]},{"verse":14,"text":"彼,かれはその第,だい一の娘,むすめをエミマと名,なづけ、第,だい二をケジアと名,なづけ、第,だい三をケレン・ハップクと名,なづけた。","tok":[["彼","かれ"],["は"],["その"],["第","だい"],["一","いち"],["の"],["娘","むすめ"],["を"],["エミマ"],["と"],["名づけ","なづけ"],["、"],["第","だい"],["二","に"],["を"],["ケジア"],["と"],["名づけ","なづけ"],["、"],["第","だい"],["三","さん"],["を"],["ケレン"],["・"],["ハップク"],["と"],["名づけた","なづけた"],["。"]]},{"verse":15,"text":"全国,ぜんこくのうちでヨブの娘,むすめたちほど美,うつくしい女,おんなはなかった。父,ちちはその兄弟,きょうだいたちと同様,どうように嗣,し業,ぎょうを彼,かれらにも与,あたえた。","tok":[["全国","ぜんこく"],["の"],["うち"],["で"],["ヨブ"],["の"],["娘","むすめ"],["たち"],["ほど"],["美しい","うつくしい"],["女","おんな"],["は"],["なかった"],["。"],["父","ちち"],["は"],["その"],["兄弟","きょうだい"],["たち"],["と"],["同様","どうよう"],["に"],["嗣業","しぎょう"],["を"],["彼","かれ"],["ら"],["に"],["も"],["与","あたえ"],["た"],["。"]]},{"verse":16,"text":"この後,のち、ヨブは百四十年,ねん生,いきながらえて、その子,ことその孫,まごと四代,だいまでを見,みた。","tok":[["この"],["後","の"],["ち"],["、"],["ヨブ"],["は"],["百四十","ひゃくよんじゅう"],["年","ねん"],["生きながらえて","いきながらえて"],["、"],["その"],["子","こ"],["と"],["その"],["孫","まご"],["と"],["四","よん"],["代","だい"],["まで"],["を"],["見た","みた"],["。"]]},{"verse":17,"text":"ヨブは年老,としおい、日,ひ満,みちて死,しんだ。","tok":[["ヨブ"],["は"],["年老い","としおい"],["、"],["日","ひ"],["満ちて","みちて"],["死んだ","しんだ"],["。"]]}]
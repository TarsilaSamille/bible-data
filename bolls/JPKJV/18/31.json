[{"verse":1,"text":"わたしは、わたしの目,めと契約,けいやくを結,むすんだ、どうして、おとめを慕,したうことができようか。","tok":[["わたし"],["は"],["、"],["わたし"],["の"],["目","め"],["と"],["契約","けいやく"],["を"],["結んだ","むすんだ"],["、"],["どう"],["して"],["、"],["おとめ"],["を"],["慕う","したう"],["こと"],["が"],["できよう"],["か"],["。"]]},{"verse":2,"text":"もしそうすれば上,うえから神,かみの下,くだされる分,ぶんはどんなであろうか。高,たかき所,ところから全能者,ぜんのうしゃの与,あたえられる嗣,し業,ぎょうはどんなであろうか。","tok":[["もし"],["そう"],["すれば"],["上","うえ"],["から"],["神","かみ"],["の"],["下される","くだされる"],["分","ぶん"],["は"],["どんな"],["で"],["あろう"],["か"],["。"],["高き","たかき"],["所","ところ"],["から"],["全能者","ぜんのうしゃ"],["の"],["与えられる","あたえられる"],["嗣業","しぎょう"],["は"],["どんな"],["で"],["あろう"],["か"],["。"]]},{"verse":3,"text":"不義,ふぎなる者,ものには災,わざわいが下,くだらないであろうか。悪,あくをなす者,ものには災難,さいなんが臨,のぞまないであろうか。","tok":[["不義","ふぎ"],["なる"],["者","もの"],["に"],["は"],["災","わざわい"],["が"],["下らないで","くだらないで"],["あろう"],["か"],["。"],["悪","あく"],["を"],["なす"],["者","もの"],["に"],["は"],["災難","さいなん"],["が"],["臨まないで","のぞまないで"],["あろう"],["か"],["。"]]},{"verse":4,"text":"彼,かれはわたしの道,みちをみそなわし、わたしの歩,あゆみをことごとく数,かぞえられぬであろうか。","tok":[["彼","かれ"],["は"],["わたし"],["の"],["道","みち"],["を"],["みそ"],["な"],["わし"],["、"],["わたし"],["の"],["歩み","あゆみ"],["を"],["ことごとく"],["数えられぬで","かぞえられぬで"],["あろう"],["か"],["。"]]},{"verse":5,"text":"もし、わたしがうそと共,ともに歩,あゆみ、わたしの足,あしが偽,いつわりにむかって急,いそいだことがあるなら、","tok":[["もし"],["、"],["わたし"],["が"],["うそ"],["と"],["共","とも"],["に"],["歩み","あゆみ"],["、"],["わたし"],["の"],["足","あし"],["が"],["偽わり","いつわり"],["に"],["むかって"],["急いだ","いそいだ"],["こと"],["が"],["あるなら"],["、"]]},{"verse":6,"text":"（正,ただしいはかりをもってわたしを量,はかれ、そうすれば神,かみはわたしの潔白,けっぱくを知,しられるであろう。）","tok":[["（"],["正い","ただしい"],["はかり"],["を"],["もって"],["わたし"],["を"],["量れ","はかれ"],["、"],["そう"],["すれば"],["神","かみ"],["は"],["わたし"],["の"],["潔白","けっぱく"],["を"],["知られるで","しられるで"],["あろう"],["。"],["）"]]},{"verse":7,"text":"もしわたしの歩,あゆみが、道,みちをはなれ、わたしの心,こころがわたしの目,めにしたがって歩,あゆみ、わたしの手,てに汚,けがれがついていたなら、","tok":[["もし"],["わたし"],["の"],["歩み","あゆみ"],["が"],["、"],["道","みち"],["を"],["はなれ"],["、"],["わたし"],["の"],["心","こころ"],["が"],["わたし"],["の"],["目","め"],["に"],["したがって"],["歩","あゆみ"],["、"],["わたし"],["の"],["手","て"],["に"],["汚","けがれ"],["が"],["ついて"],["いたなら"],["、"]]},{"verse":8,"text":"わたしのまいたのを他,たの人,ひとが食,たべ、わたしのために成長,せいちょうするものが、抜,ぬき取,とられてもかまわない。","tok":[["わたし"],["の"],["ま"],["いた"],["の"],["を"],["他","た"],["の"],["人","ひと"],["が"],["食べ","たべ"],["、"],["わたし"],["の"],["ため"],["に"],["成長","せいちょう"],["する"],["もの"],["が"],["、"],["抜き取られて","ぬきとられて"],["も"],["かまわない"],["。"]]},{"verse":9,"text":"もし、わたしの心,こころが、女,おんなに迷,まよったことがあるか、またわたしが隣,となり人,びとの門,もんで待,まち伏,ぶせしたことがあるなら、","tok":[["もし"],["、"],["わたし"],["の"],["心","こころ"],["が"],["、"],["女","おんな"],["に"],["迷った","まよった"],["こと"],["が"],["ある"],["か"],["、"],["また"],["わたし"],["が"],["隣人","となりびと"],["の"],["門","もん"],["で"],["待伏せ","まちぶせ"],["した"],["こと"],["が"],["あるなら"],["、"]]},{"verse":10,"text":"わたしの妻,つまが他,たの人,ひとのためにうすをひき、他,たの人,ひとが彼女,かのじょの上,うえに寝,ねてもかまわない。","tok":[["わたし"],["の"],["妻","つま"],["が"],["他","た"],["の"],["人","ひと"],["の"],["ため"],["に"],["うす"],["を"],["ひき"],["、"],["他","た"],["の"],["人","ひと"],["が"],["彼女","かのじょ"],["の"],["上","うえ"],["に"],["寝て","ねて"],["も"],["かまわない"],["。"]]},{"verse":11,"text":"これは重,おもい罪,つみであって、さばきびとに罰,ばっせられるべき悪事,あくじだからである。","tok":[["これ"],["は"],["重い","おもい"],["罪","つみ"],["で"],["あって"],["、"],["さばき"],["びと"],["に"],["罰せられるべき","ばっせられるべき"],["悪事","あくじ"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":12,"text":"これは滅,ほろびに至,いたるまでも焼,やきつくす火,ひであって、わたしのすべての産業,さんぎょうを根,ねこそぎ焼,やくであろう。","tok":[["これ"],["は"],["滅び","ほろび"],["に"],["至る","いたる"],["まで"],["も"],["焼き","やき"],["つくす"],["火","ひ"],["で"],["あって"],["、"],["わたし"],["の"],["すべて"],["の"],["産業","さんぎょう"],["を"],["根こそぎ","ねこそぎ"],["焼くで","やくで"],["あろう"],["。"]]},{"verse":13,"text":"わたしのしもべ、また、はしためがわたしと言,いい争,あらそったときに、わたしがもしその言,いい分,ぶんを退,しりぞけたことがあるなら、","tok":[["わたし"],["の"],["しもべ"],["、"],["また"],["、"],["はし"],["ため"],["が"],["わたし"],["と"],["言い争った","いいあらそった"],["とき"],["に"],["、"],["わたし"],["が"],["もし"],["その"],["言い分","いいぶん"],["を"],["退ぞけた","しりぞけた"],["こと"],["が"],["あるなら"],["、"]]},{"verse":14,"text":"神,かみが立,たち上,あがられるとき、わたしはどうしようか、神,かみが尋,たずねられるとき、なんとお答,こたえしようか。","tok":[["神","かみ"],["が"],["立ち上がられる","たちあがられる"],["とき"],["、"],["わたし"],["は"],["どう"],["しよう"],["か"],["、"],["神","かみ"],["が"],["尋ねられる","たずねられる"],["とき"],["、"],["なん"],["と"],["お答","おこたえ"],["しよう"],["か"],["。"]]},{"verse":15,"text":"わたしを胎内,たいないに造,つくられた者,ものは、彼,かれをも造,つくられたのではないか。われわれを腹,はらの内,うちに形,かたち造,つくられた者,ものは、ただひとりではないか。","tok":[["わたし"],["を"],["胎内","たいない"],["に"],["造られた","つくられた"],["者","もの"],["は"],["、"],["彼","かれ"],["を"],["も"],["造られた","つくられた"],["ので"],["は"],["ない"],["か"],["。"],["われわれ"],["を"],["腹","はら"],["の"],["内","うち"],["に"],["形造られた","かたちつくられた"],["者","もの"],["は"],["、"],["ただ"],["ひとり"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":16,"text":"わたしがもし貧,まずしい者,ものの願,ねがいを退,しりぞけ、やもめの目,めを衰,おとろえさせ、","tok":[["わたし"],["が"],["もし"],["貧しい","まずしい"],["者","もの"],["の"],["願い","ねがい"],["を"],["退ぞけ","しりぞけ"],["、"],["やもめ"],["の"],["目","め"],["を"],["衰えさせ","おとろえさせ"],["、"]]},{"verse":17,"text":"あるいはわたしひとりで食物,しょくもつを食,たべて、みなしごに食,たべさせなかったことがあるなら、","tok":[["あるいは"],["わたし"],["ひとり"],["で"],["食物","しょくもつ"],["を"],["食べて","たべて"],["、"],["みなしご"],["に"],["食べさせなかった","たべさせなかった"],["こと"],["が"],["あるなら"],["、"]]},{"verse":18,"text":"（わたしは彼,かれの幼,おさない時,ときから父,ちちのように彼,かれを育,そだて、またその母,ははの胎,たいを出,でたときから彼,かれを導,みちびいた。）","tok":[["（"],["わたし"],["は"],["彼","かれ"],["の"],["幼ない","おさない"],["時","とき"],["から"],["父","ちち"],["の"],["よう"],["に"],["彼","かれ"],["を"],["育て","そだて"],["、"],["また"],["その"],["母","はは"],["の"],["胎","たい"],["を"],["出た","でた"],["とき"],["から"],["彼","かれ"],["を"],["導いた","みちびいた"],["。"],["）"]]},{"verse":19,"text":"もし着物,きものがないために死,しのうとする者,ものや、身,みをおおう物,もののない貧,まずしい人,ひとをわたしが見,みた時,ときに、","tok":[["もし"],["着物","きもの"],["が"],["ない"],["ため"],["に"],["死のう","しのう"],["と"],["する"],["者","もの"],["や"],["、"],["身","み"],["を"],["おおう"],["物","もの"],["の"],["ない"],["貧しい","まずしい"],["人","ひと"],["を"],["わたし"],["が"],["見た","みた"],["時","とき"],["に"],["、"]]},{"verse":20,"text":"その腰,こしがわたしを祝福,しゅくふくせず、また彼,かれがわたしの羊,ひつじの毛,けで暖,あたたまらなかったことがあるなら、","tok":[["その"],["腰","こし"],["が"],["わたし"],["を"],["祝福","しゅくふく"],["せず"],["、"],["また"],["彼","かれ"],["が"],["わたし"],["の"],["羊","ひつじ"],["の"],["毛","け"],["で"],["暖まらなかった","あたたまらなかった"],["こと"],["が"],["あるなら"],["、"]]},{"verse":21,"text":"もしわたしを助,たすける者,ものが門,もんにおるのを見,みて、みなしごにむかってわたしの手,てを振,ふり上,あげたことがあるなら、","tok":[["もし"],["わたし"],["を"],["助ける","たすける"],["者","もの"],["が"],["門","もん"],["に"],["おる"],["の"],["を"],["見て","みて"],["、"],["みなしご"],["に"],["むかって"],["わたし"],["の"],["手","て"],["を"],["振り上た","ふりあげた"],["こと"],["が"],["あるなら"],["、"]]},{"verse":22,"text":"わたしの肩,かた骨,ほねが、肩,かたから落,おち、わたしの腕,うでが、つけ根,ねから折,おれてもかまわない。","tok":[["わたし"],["の"],["肩骨","かたほね"],["が"],["、"],["肩","かた"],["から"],["落","おち"],["、"],["わたし"],["の"],["腕","うで"],["が"],["、"],["つけ根","つけね"],["から"],["折れて","おれて"],["も"],["かまわない"],["。"]]},{"verse":23,"text":"わたしは神,かみから出,でる災,わざわいを恐,おそれる、その威光,いこうの前,まえには何事,なにごともなすことはできない。","tok":[["わたし"],["は"],["神","かみ"],["から"],["出る","でる"],["災","わざわい"],["を"],["恐れる","おそれる"],["、"],["その"],["威光","いこう"],["の"],["前","まえ"],["に"],["は"],["何事","なにごと"],["も"],["なす"],["こと"],["は"],["できない"],["。"]]},{"verse":24,"text":"わたしがもし金,きんをわが望,のぞみとし、精,せい金,きんをわが頼,たのみと言,いったことがあるなら、","tok":[["わたし"],["が"],["もし"],["金","きん"],["を"],["わが"],["望み","のぞみ"],["と"],["し"],["、"],["精金","せいきん"],["を"],["わが"],["頼み","たのみ"],["と"],["言った","いった"],["こと"],["が"],["あるなら"],["、"]]},{"verse":25,"text":"わたしがもしわが富,とみの大,おおいなる事,ことと、わたしの手,てに多,おおくの物,ものを獲,えた事,こととを喜,よろこんだことがあるなら、","tok":[["わたし"],["が"],["もし"],["わが"],["富","とみ"],["の"],["大いなる","おおいなる"],["事","こと"],["と"],["、"],["わたし"],["の"],["手","て"],["に"],["多く","おおく"],["の"],["物","もの"],["を"],["獲た","えた"],["事","こと"],["と"],["を"],["喜こんだ","よろこんだ"],["こと"],["が"],["あるなら"],["、"]]},{"verse":26,"text":"わたしがもし日,ひの輝,かがやくのを見,み、または月,つきの照,てりわたって動,うごくのを見,みた時,とき、","tok":[["わたし"],["が"],["もし"],["日","ひ"],["の"],["輝やく","かがやく"],["の"],["を"],["見","み"],["、"],["また"],["は"],["月","つき"],["の"],["照り","てり"],["わたって"],["動く","うごく"],["の"],["を"],["見た","みた"],["時","とき"],["、"]]},{"verse":27,"text":"心,こころひそかに迷,まよって、手,てに口,くちづけしたことがあるなら、","tok":[["心","こころ"],["ひそか"],["に"],["迷って","まよって"],["、"],["手","て"],["に"],["口づけ","くちづけ"],["した"],["こと"],["が"],["あるなら"],["、"]]},{"verse":28,"text":"これもまたさばきびとに罰,ばっせらるべき悪事,あくじだ。わたしは上,うえなる神,かみを欺,あざむいたからである。","tok":[["これ"],["も"],["また"],["さばき"],["びと"],["に"],["罰せらるべき","ばっせらるべき"],["悪事","あくじ"],["だ"],["。"],["わたし"],["は"],["上","うえ"],["なる"],["神","かみ"],["を"],["欺いた","あざむいた"],["から"],["で"],["ある"],["。"]]},{"verse":29,"text":"わたしがもしわたしを憎,にくむ者,ものの滅,ほろびるのを喜,よろこび、または災,わざわいが彼,かれに臨,のぞんだとき、勝,かち誇,ほこったことがあるなら、","tok":[["わたし"],["が"],["もし"],["わたし"],["を"],["憎む","にくむ"],["者","もの"],["の"],["滅びる","ほろびる"],["の"],["を"],["喜こび","よろこび"],["、"],["また"],["は"],["災","わざわい"],["が"],["彼","かれ"],["に"],["臨んだ","のぞんだ"],["とき"],["、"],["勝誇った","かちほこった"],["こと"],["が"],["あるなら"],["、"]]},{"verse":30,"text":"（わたしはわが口,くちに罪,つみを犯,おかさせず、のろいをもって彼,かれの命,いのちを求,もとめたことはなかった。）","tok":[["（"],["わたし"],["は"],["わが"],["口","くち"],["に"],["罪","つみ"],["を"],["犯させず","おかさせず"],["、"],["のろい"],["を"],["もって"],["彼","かれ"],["の"],["命","いのち"],["を"],["求めた","もとめた"],["こと"],["は"],["なかった"],["。"],["）"]]},{"verse":31,"text":"もし、わたしの天幕,てんまくの人々,ひとびとで、『だれか彼,かれの肉,にくに飽,あきなかった者,ものがあるか』と、言,いわなかったことがあるなら、","tok":[["もし"],["、"],["わたし"],["の"],["天幕","てんまく"],["の"],["人々","ひとびと"],["で"],["、"],["『"],["だれ"],["か"],["彼","かれ"],["の"],["肉","にく"],["に"],["飽きなかった","あきなかった"],["者","もの"],["が"],["ある"],["か"],["』"],["と"],["、"],["言わなかった","いわなかった"],["こと"],["が"],["あるなら"],["、"]]},{"verse":32,"text":"（他国,たこく人,じんはちまたに宿,やどらず、わたしはわが門,もんを旅,たびびとに開,ひらいた。）","tok":[["（"],["他国人","たこくじん"],["は"],["ちまた"],["に"],["宿らず","やどらず"],["、"],["わたし"],["は"],["わが"],["門","もん"],["を"],["旅びと","たびびと"],["に"],["開らいた","ひらいた"],["。"],["）"]]},{"verse":33,"text":"わたしがもし人々,ひとびとの前,まえにわたしのとがをおおい、わたしの悪事,あくじを胸,むねの中,なかに隠,かくしたことがあるなら、","tok":[["わたし"],["が"],["もし"],["人々","ひとびと"],["の"],["前","まえ"],["に"],["わたし"],["の"],["とが"],["を"],["おおい"],["、"],["わたし"],["の"],["悪事","あくじ"],["を"],["胸","むね"],["の"],["中","なか"],["に"],["隠した","かくした"],["こと"],["が"],["あるなら"],["、"]]},{"verse":34,"text":"わたしが大衆,たいしゅうを恐,おそれ、宗族,そうぞくの侮,あなどりにおじて、口,くちを閉,とじ、門,もんを出,でなかったことがあるなら、","tok":[["わたし"],["が"],["大衆","たいしゅう"],["を"],["恐","おそれ"],["、"],["宗族","そうぞく"],["の"],["侮","あなどり"],["に"],["おじて"],["、"],["口","くち"],["を"],["閉じ","とじ"],["、"],["門","もん"],["を"],["出なかった","でなかった"],["こと"],["が"],["あるなら"],["、"]]},{"verse":35,"text":"ああ、わたしに聞,きいてくれる者,ものがあればよいのだが、（わたしのかきはんがここにある。どうか、全能者,ぜんのうしゃがわたしに答,こたえられるように。）ああ、わたしの敵,てきの書,かいた告訴,こくそ状,じょうがあればよいのだが。","tok":[["ああ"],["、"],["わたし"],["に"],["聞いて","きいて"],["くれる"],["者","もの"],["が"],["あれば"],["よい"],["の"],["だ"],["が"],["、"],["（"],["わたし"],["の"],["かき"],["はん"],["が"],["ここ"],["に"],["ある"],["。"],["どう"],["か"],["、"],["全能者","ぜんのうしゃ"],["が"],["わたし"],["に"],["答","こたえ"],["られる"],["よう"],["に"],["。"],["）"],["ああ"],["、"],["わたし"],["の"],["敵","てき"],["の"],["書いた","かいた"],["告訴状","こくそじょう"],["が"],["あれば"],["よい"],["の"],["だ"],["が"],["。"]]},{"verse":36,"text":"わたしは必,かならずこれを肩,かたに負,おい、冠,かんむりのようにこれをわが身,みに結,むすび、","tok":[["わたし"],["は"],["必","かならず"],["これ"],["を"],["肩","かた"],["に"],["負い","おい"],["、"],["冠","かんむり"],["の"],["よう"],["に"],["これ"],["を"],["わが"],["身","み"],["に"],["結び","むすび"],["、"]]},{"verse":37,"text":"わが歩,あゆみの数,かずを彼,かれに述,のべ、君,くんたる者,もののようにして、彼,かれに近,ちかづくであろう。","tok":[["わが"],["歩み","あゆみ"],["の"],["数","かず"],["を"],["彼","かれ"],["に"],["述べ","のべ"],["、"],["君","くん"],["たる"],["者","もの"],["の"],["よう"],["に"],["して"],["、"],["彼","かれ"],["に"],["近づくで","ちかづくで"],["あろう"],["。"]]},{"verse":38,"text":"もしわが田畑,たはたがわたしに向,むかって呼,よばわり、そのうねみぞが共,ともに泣,なき叫,さけんだことがあるなら、","tok":[["もし"],["わが"],["田畑","たはた"],["が"],["わたし"],["に"],["向かって","むかって"],["呼ばわり","よばわり"],["、"],["その"],["うね"],["みぞ"],["が"],["共","とも"],["に"],["泣","なき"],["叫けんだ","さけんだ"],["こと"],["が"],["あるなら"],["、"]]},{"verse":39,"text":"もしわたしが金,きんを払,はらわないでその産物,さんぶつを食,たべ、その持,もち主,ぬしを死,しなせたことがあるなら、","tok":[["もし"],["わたし"],["が"],["金","きん"],["を"],["払わないで","はらわないで"],["その"],["産物","さんぶつ"],["を"],["食べ","たべ"],["、"],["その"],["持主","もちぬし"],["を"],["死なせた","しなせた"],["こと"],["が"],["あるなら"],["、"]]},{"verse":40,"text":"小麦,こむぎの代,かわりに、いばらがはえ、大麦,おおむぎの代,かわりに雑草,ざっそうがはえてもかまわない」。ヨブの言葉,ことばは終,おわった。","tok":[["小麦","こむぎ"],["の"],["代わり","かわり"],["に"],["、"],["いばら"],["が"],["はえ"],["、"],["大麦","おおむぎ"],["の"],["代わり","かわり"],["に"],["雑草","ざっそう"],["が"],["はえて"],["も"],["かまわない"],["」"],["。"],["ヨブ"],["の"],["言葉","ことば"],["は"],["終わった","おわった"],["。"]]}]
[{"verse":1,"text":"ヨブは答,こたえて言,いった、","tok":[["ヨブ"],["は"],["答","こたえ"],["て"],["言った","いった"],["、"]]},{"verse":2,"text":"「まことにわたしは、その事,ことのそのとおりであることを知,しっている。しかし人,ひとはどうして神,かみの前,まえに正,ただしくありえようか。","tok":[["「"],["まこと"],["に"],["わたし"],["は"],["、"],["その"],["事","こと"],["の"],["その"],["とおり"],["で"],["ある"],["こと"],["を"],["知って","しって"],["いる"],["。"],["しかし"],["人","ひと"],["は"],["どう"],["して"],["神","かみ"],["の"],["前","まえ"],["に"],["正く","ただしく"],["あり"],["えよう"],["か"],["。"]]},{"verse":3,"text":"よし彼,かれと争,あらそおうとしても、千に一つも答,こたえることができない。","tok":[["よし"],["彼","かれ"],["と"],["争おう","あらそおう"],["として"],["も"],["、"],["千","せん"],["に"],["一","ひと"],["つ"],["も"],["答","こたえ"],["る"],["こと"],["が"],["できない"],["。"]]},{"verse":4,"text":"彼,かれは心,こころ賢,かしこく、力強,ちからづよくあられる。だれが彼,かれにむかい、おのれをかたくなにして、栄,さかえた者,ものがあるか。","tok":[["彼","かれ"],["は"],["心","こころ"],["賢しこく","かしこく"],["、"],["力強く","ちからづよく"],["あられる"],["。"],["だれ"],["が"],["彼","かれ"],["に"],["むかい"],["、"],["おのれ"],["を"],["かたくな"],["に"],["して"],["、"],["栄","さかえ"],["た"],["者","もの"],["が"],["ある"],["か"],["。"]]},{"verse":5,"text":"彼,かれは、山,やまを移,うつされるが、山,やまは知,しらない。彼,かれは怒,いかりをもって、これらをくつがえされる。","tok":[["彼","かれ"],["は"],["、"],["山","やま"],["を"],["移される","うつされる"],["が"],["、"],["山","やま"],["は"],["知らない","しらない"],["。"],["彼","かれ"],["は"],["怒り","いかり"],["を"],["もって"],["、"],["これ"],["ら"],["を"],["くつがえされる"],["。"]]},{"verse":6,"text":"彼,かれが、地,ちを震,ふるい動,うごかしてその所,ところを離,はなれさせられると、その柱,はしらはゆらぐ。","tok":[["彼","かれ"],["が"],["、"],["地","ち"],["を"],["震い","ふるい"],["動かして","うごかして"],["その"],["所","ところ"],["を"],["離れさせられる","はなれさせられる"],["と"],["、"],["その"],["柱","はしら"],["は"],["ゆらぐ"],["。"]]},{"verse":7,"text":"彼,かれが日,ひに命,めいじられると、日,ひは出,でない。彼,かれはまた星,ほしを閉,とじこめられる。","tok":[["彼","かれ"],["が"],["日","ひ"],["に"],["命じられる","めいじられる"],["と"],["、"],["日","ひ"],["は"],["出ない","でない"],["。"],["彼","かれ"],["は"],["また"],["星","ほし"],["を"],["閉じこめられる","とじこめられる"],["。"]]},{"verse":8,"text":"彼,かれはただひとり天,てんを張,はり、海,うみの波,なみを踏,ふまれた。","tok":[["彼","かれ"],["は"],["ただ"],["ひとり"],["天","てん"],["を"],["張り","はり"],["、"],["海","うみ"],["の"],["波","なみ"],["を"],["踏まれた","ふまれた"],["。"]]},{"verse":9,"text":"彼,かれは北斗,ほくと、オリオン、プレアデスおよび南,みなみの密室,みっしつを造,つくられた。","tok":[["彼","かれ"],["は"],["北斗","ほくと"],["、"],["オリオン"],["、"],["プレアデス"],["および"],["南","みなみ"],["の"],["密室","みっしつ"],["を"],["造られた","つくられた"],["。"]]},{"verse":10,"text":"彼,かれが大,おおいなる事,ことをされることは測,はかりがたく、不思議,ふしぎな事,ことをされることは数,かず知,しれない。","tok":[["彼","かれ"],["が"],["大いなる","おおいなる"],["事","こと"],["を"],["される"],["こと"],["は"],["測り","はかり"],["がたく"],["、"],["不思議","ふしぎ"],["な"],["事","こと"],["を"],["される"],["こと"],["は"],["数","か"],["ず"],["知れない","しれない"],["。"]]},{"verse":11,"text":"見,みよ、彼,かれがわたしのかたわらを通,とおられても、わたしは彼,かれを見,みない。彼,かれは進,すすみ行,いかれるが、わたしは彼,かれを認,みとめない。","tok":[["見よ","みよ"],["、"],["彼","かれ"],["が"],["わたし"],["の"],["かたわら"],["を"],["通られて","とおられて"],["も"],["、"],["わたし"],["は"],["彼","かれ"],["を"],["見ない","みない"],["。"],["彼","かれ"],["は"],["進み","すすみ"],["行かれる","いかれる"],["が"],["、"],["わたし"],["は"],["彼","かれ"],["を"],["認めない","みとめない"],["。"]]},{"verse":12,"text":"見,みよ、彼,かれが奪,うばい去,さられるのに、だれが彼,かれをはばむことができるか。だれが彼,かれにむかって『あなたは何,なにをするのか』と言,いうことができるか。","tok":[["見よ","みよ"],["、"],["彼","かれ"],["が"],["奪い去られる","うばいさられる"],["のに"],["、"],["だれ"],["が"],["彼","かれ"],["を"],["はばむ"],["こと"],["が"],["できる"],["か"],["。"],["だれ"],["が"],["彼","かれ"],["に"],["むかって"],["『"],["あなた"],["は"],["何に","なに"],["を"],["する"],["の"],["か"],["』"],["と"],["言う","いう"],["こと"],["が"],["できる"],["か"],["。"]]},{"verse":13,"text":"神,かみはその怒,いかりをやめられない。ラハブを助,たすける者,ものどもは彼,かれのもとにかがんだ。","tok":[["神","かみ"],["は"],["その"],["怒り","いかり"],["を"],["やめられない"],["。"],["ラハブ"],["を"],["助ける","たすける"],["者","もの"],["ども"],["は"],["彼","かれ"],["の"],["もと"],["に"],["かがんだ"],["。"]]},{"verse":14,"text":"どうしてわたしは彼,かれに答,こたえ、言葉,ことばを選,えらんで、彼,かれと議論,ぎろんすることができよう。","tok":[["どう"],["して"],["わたし"],["は"],["彼","かれ"],["に"],["答","こたえ"],["、"],["言葉","ことば"],["を"],["選らんで","えらんで"],["、"],["彼","かれ"],["と"],["議論","ぎろん"],["する"],["こと"],["が"],["できよう"],["。"]]},{"verse":15,"text":"たといわたしは正,ただしくても答,こたえることができない。わたしを責,せめられる者,ものにあわれみを請,こわなければならない。","tok":[["たとい"],["わたし"],["は"],["正くて","ただしくて"],["も"],["答","こたえ"],["る"],["こと"],["が"],["できない"],["。"],["わたし"],["を"],["責","せめ"],["られる"],["者","もの"],["に"],["あわれみ"],["を"],["請わなければ","こわなければ"],["ならない"],["。"]]},{"verse":16,"text":"たといわたしが呼,よばわり、彼,かれがわたしに答,こたえられても、わたしの声,こえに耳,みみを傾,かたむけられたとは信,しんじない。","tok":[["たとい"],["わたし"],["が"],["呼ばわり","よばわり"],["、"],["彼","かれ"],["が"],["わたし"],["に"],["答","こたえ"],["られて"],["も"],["、"],["わたし"],["の"],["声","こえ"],["に"],["耳","みみ"],["を"],["傾むけられた","かたむけられた"],["と"],["は"],["信じない","しんじない"],["。"]]},{"verse":17,"text":"彼,かれは大風,おおかぜをもってわたしを撃,うち砕,くだき、ゆえなく、わたしに多,おおくの傷,きずを負,おわせ、","tok":[["彼","かれ"],["は"],["大風","おおかぜ"],["を"],["もって"],["わたし"],["を"],["撃ち砕き","うちくだき"],["、"],["ゆえ"],["なく"],["、"],["わたし"],["に"],["多く","おおく"],["の"],["傷","きず"],["を"],["負わせ","おわせ"],["、"]]},{"verse":18,"text":"わたしに息,いきをつかせず、苦,にがい物,ものをもってわたしを満,みたされる。","tok":[["わたし"],["に"],["息","いき"],["を"],["つかせず"],["、"],["苦い","にがい"],["物","もの"],["を"],["もって"],["わたし"],["を"],["満たされる","みたされる"],["。"]]},{"verse":19,"text":"力,ちからの争,あらそいであるならば、彼,かれを見,みよ、さばきの事,ことであるならば、だれが彼,かれを呼,よび出,だすことができよう。","tok":[["力","ちから"],["の"],["争い","あらそい"],["で"],["あるならば"],["、"],["彼","かれ"],["を"],["見よ","みよ"],["、"],["さばき"],["の"],["事","こと"],["で"],["あるならば"],["、"],["だれ"],["が"],["彼","かれ"],["を"],["呼び出す","よびだす"],["こと"],["が"],["できよう"],["。"]]},{"verse":20,"text":"たといわたしは正,ただしくても、わたしの口,くちはわたしを罪,つみある者,ものとする。たといわたしは罪,つみがなくても、彼,かれはわたしを曲,まがった者,ものとする。","tok":[["たとい"],["わたし"],["は"],["正くて","ただしくて"],["も"],["、"],["わたし"],["の"],["口","くち"],["は"],["わたし"],["を"],["罪","つみ"],["ある"],["者","もの"],["と"],["する"],["。"],["たとい"],["わたし"],["は"],["罪","つみ"],["が"],["なくて"],["も"],["、"],["彼","かれ"],["は"],["わたし"],["を"],["曲がった","まがった"],["者","もの"],["と"],["する"],["。"]]},{"verse":21,"text":"わたしは罪,つみがない、しかしわたしは自分,じぶんを知,しらない。わたしは自分,じぶんの命,いのちをいとう。","tok":[["わたし"],["は"],["罪","つみ"],["が"],["ない"],["、"],["しかし"],["わたし"],["は"],["自分","じぶん"],["を"],["知らない","しらない"],["。"],["わたし"],["は"],["自分","じぶん"],["の"],["命","いのち"],["を"],["いとう"],["。"]]},{"verse":22,"text":"皆,みな同一,どういつである。それゆえ、わたしは言,いう、『彼,かれは罪,つみのない者,ものと、悪,あしき者,ものとを共,ともに滅,ほろぼされるのだ』と。","tok":[["皆","みな"],["同一","どういつ"],["で"],["ある"],["。"],["それ"],["ゆえ"],["、"],["わたし"],["は"],["言う","いう"],["、"],["『"],["彼","かれ"],["は"],["罪","つみ"],["の"],["ない"],["者","もの"],["と"],["、"],["悪しき","あしき"],["者","もの"],["と"],["を"],["共","とも"],["に"],["滅ぼされる","ほろぼされる"],["の"],["だ"],["』"],["と"],["。"]]},{"verse":23,"text":"災,わざわいがにわかに人,ひとを殺,ころすような事,ことがあると、彼,かれは罪,つみのない者,ものの苦難,くなんをあざ笑,わらわれる。","tok":[["災","わざわい"],["が"],["にわか"],["に"],["人","ひと"],["を"],["殺ろす","ころす"],["よう"],["な"],["事","こと"],["が"],["ある"],["と"],["、"],["彼","かれ"],["は"],["罪","つみ"],["の"],["ない"],["者","もの"],["の"],["苦難","くなん"],["を"],["あざ笑われる","あざわらわれる"],["。"]]},{"verse":24,"text":"世,よは悪人,あくにんの手,てに渡,わたされてある。彼,かれはその裁判人,さいばんにんの顔,かおをおおわれる。もし彼,かれでなければ、これはだれのしわざか。","tok":[["世","よ"],["は"],["悪人","あくにん"],["の"],["手","て"],["に"],["渡されて","わたされて"],["ある"],["。"],["彼","かれ"],["は"],["その"],["裁判人","さいばんにん"],["の"],["顔","かお"],["を"],["おおわれる"],["。"],["もし"],["彼","かれ"],["で"],["なければ"],["、"],["これ"],["は"],["だれ"],["の"],["しわざ"],["か"],["。"]]},{"verse":25,"text":"わたしの日,ひは飛脚,ひきゃくよりも速,はやく、飛,とび去,さって幸,さいわいを見,みない。","tok":[["わたし"],["の"],["日","ひ"],["は"],["飛脚","ひきゃく"],["より"],["も"],["速く","はやく"],["、"],["飛び","とび"],["去て","さって"],["幸い","さいわい"],["を"],["見ない","みない"],["。"]]},{"verse":26,"text":"これは走,はしること葦,あし舟,ぶねのごとく、えじきに襲,おそいかかる、わしのようだ。","tok":[["これ"],["は"],["走る","はしる"],["こと"],["葦舟","あしぶね"],["の"],["ごとく"],["、"],["えじき"],["に"],["襲いかかる","おそいかかる"],["、"],["わし"],["の"],["よう"],["だ"],["。"]]},{"verse":27,"text":"たといわたしは『わが嘆,なげきを忘,わすれ、憂,うれい顔,がおをかえて元気,げんきよくなろう』と言,いっても、","tok":[["たとい"],["わたし"],["は"],["『"],["わが"],["嘆き","なげき"],["を"],["忘","わすれ"],["、"],["憂","うれい"],["顔","がお"],["を"],["かえて"],["元気","げんき"],["よく"],["なろう"],["』"],["と"],["言って","いって"],["も"],["、"]]},{"verse":28,"text":"わたしはわがもろもろの苦,くるしみを恐,おそれる。あなたがわたしを罪,つみなき者,ものとされないことをわたしは知,しっているからだ。","tok":[["わたし"],["は"],["わが"],["もろもろ"],["の"],["苦しみ","くるしみ"],["を"],["恐れる","おそれる"],["。"],["あなた"],["が"],["わたし"],["を"],["罪","つみ"],["なき"],["者","もの"],["と"],["されない"],["こと"],["を"],["わたし"],["は"],["知って","しって"],["いる"],["から"],["だ"],["。"]]},{"verse":29,"text":"わたしは罪,つみある者,ものとされている。どうして、いたずらに労,ろうする必要,ひつようがあるか。","tok":[["わたし"],["は"],["罪","つみ"],["ある"],["者","もの"],["と"],["されて"],["いる"],["。"],["どう"],["して"],["、"],["いたずら"],["に"],["労する","ろうする"],["必要","ひつよう"],["が"],["ある"],["か"],["。"]]},{"verse":30,"text":"たといわたしは雪,ゆきで身,みを洗,あらい、灰汁,あくで手,てを清,きよめても、","tok":[["たとい"],["わたし"],["は"],["雪","ゆき"],["で"],["身","み"],["を"],["洗","あらい"],["、"],["灰汁","あく"],["で"],["手","て"],["を"],["清めて","きよめて"],["も"],["、"]]},{"verse":31,"text":"あなたはわたしを、みぞの中,なかに投,なげ込,こまれるので、わたしの着物,きものも、わたしをいとうようになる。","tok":[["あなた"],["は"],["わたし"],["を"],["、"],["みぞ"],["の"],["中","なか"],["に"],["投込まれる","なげこまれる"],["ので"],["、"],["わたし"],["の"],["着物","きもの"],["も"],["、"],["わたし"],["を"],["いとう"],["よう"],["に"],["なる"],["。"]]},{"verse":32,"text":"神,かみはわたしのように人,ひとではないゆえ、わたしは彼,かれに答,こたえることができない。われわれは共,ともにさばきに臨,のぞむことができない。","tok":[["神","かみ"],["は"],["わたし"],["の"],["よう"],["に"],["人","ひと"],["で"],["は"],["ない"],["ゆえ"],["、"],["わたし"],["は"],["彼","かれ"],["に"],["答","こたえ"],["る"],["こと"],["が"],["できない"],["。"],["われわれ"],["は"],["共","とも"],["に"],["さばき"],["に"],["臨む","のぞむ"],["こと"],["が"],["できない"],["。"]]},{"verse":33,"text":"われわれの間,あいだには、われわれふたりの上,うえに手,てを置,おくべき仲裁者,ちゅうさいしゃがない。","tok":[["われわれ"],["の"],["間","あいだ"],["に"],["は"],["、"],["われわれ"],["ふたり"],["の"],["上","うえ"],["に"],["手","て"],["を"],["置くべき","おくべき"],["仲裁者","ちゅうさいしゃ"],["が"],["ない"],["。"]]},{"verse":34,"text":"どうか彼,かれがそのつえをわたしから取,とり離,はなし、その怒,いかりをもって、わたしを恐,おそれさせられないように。","tok":[["どう"],["か"],["彼","かれ"],["が"],["その"],["つえ"],["を"],["わたし"],["から"],["取離し","とりはなし"],["、"],["その"],["怒り","いかり"],["を"],["もって"],["、"],["わたし"],["を"],["恐れさせられない","おそれさせられない"],["よう"],["に"],["。"]]},{"verse":35,"text":"そうすれば、わたしは語,かたって、彼,かれを恐,おそれることはない。わたしはみずからそのような者,ものではないからだ。","tok":[["そう"],["すれば"],["、"],["わたし"],["は"],["語って","かたって"],["、"],["彼","かれ"],["を"],["恐れる","おそれる"],["こと"],["は"],["ない"],["。"],["わたし"],["は"],["みずから"],["その"],["よう"],["な"],["者","もの"],["で"],["は"],["ない"],["から"],["だ"],["。"]]}]
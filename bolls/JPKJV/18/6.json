[{"verse":1,"text":"ヨブは答,こたえて言,いった、","tok":[["ヨブ"],["は"],["答","こたえ"],["て"],["言った","いった"],["、"]]},{"verse":2,"text":"「どうかわたしの憤,いきどおりが正,ただしく量,はかられ、同時,どうじにわたしの災,わざわいも、はかりにかけられるように。","tok":[["「"],["どう"],["か"],["わたし"],["の"],["憤り","いきどおり"],["が"],["正く","ただしく"],["量られ","はかられ"],["、"],["同時","どうじ"],["に"],["わたし"],["の"],["災","わざわい"],["も"],["、"],["はかり"],["に"],["かけられる"],["よう"],["に"],["。"]]},{"verse":3,"text":"そうすれば、これは海,うみの砂,すなよりも重,おもいに相違,そういない。それゆえ、わたしの言葉,ことばが軽率,けいそつであったのだ。","tok":[["そう"],["すれば"],["、"],["これ"],["は"],["海","うみ"],["の"],["砂","すな"],["より"],["も"],["重い","おもい"],["に"],["相違","そうい"],["ない"],["。"],["それ"],["ゆえ"],["、"],["わたし"],["の"],["言葉","ことば"],["が"],["軽率","けいそつ"],["で"],["あった"],["の"],["だ"],["。"]]},{"verse":4,"text":"全能者,ぜんのうしゃの矢,やが、わたしのうちにあり、わたしの霊,れいはその毒,どくを飲,のみ、神,かみの恐,おそるべき軍勢,ぐんぜいが、わたしを襲,おそい攻,せめている。","tok":[["全能者","ぜんのうしゃ"],["の"],["矢","や"],["が"],["、"],["わたし"],["の"],["うち"],["に"],["あり"],["、"],["わたし"],["の"],["霊","れい"],["は"],["その"],["毒","どく"],["を"],["飲み","のみ"],["、"],["神","かみ"],["の"],["恐るべき","おそるべき"],["軍勢","ぐんぜい"],["が"],["、"],["わたし"],["を"],["襲い","おそい"],["攻めて","せめて"],["いる"],["。"]]},{"verse":5,"text":"野,のろばは、青草,あおくさのあるのに鳴,なくであろうか。牛,うしは飼葉,かいばの上,うえでうなるであろうか。","tok":[["野","の"],["ろば"],["は"],["、"],["青草","あおくさ"],["の"],["ある"],["のに"],["鳴くで","なくで"],["あろう"],["か"],["。"],["牛","うし"],["は"],["飼葉","かいば"],["の"],["上","うえ"],["で"],["うなるで"],["あろう"],["か"],["。"]]},{"verse":6,"text":"味,あじのない物,ものは塩,しおがなくて食,たべられようか。すべりひゆのしるは味,あじがあろうか。","tok":[["味","あじ"],["の"],["ない"],["物","もの"],["は"],["塩","しお"],["が"],["なくて"],["食べられよう","たべられよう"],["か"],["。"],["すべりひゆ"],["の"],["しる"],["は"],["味","あじ"],["が"],["あろう"],["か"],["。"]]},{"verse":7,"text":"わたしの食欲,しょくよくはこれに触,ふれることを拒,こばむ。これは、わたしのきらう食物,しょくもつのようだ。","tok":[["わたし"],["の"],["食欲","しょくよく"],["は"],["これ"],["に"],["触れる","ふれる"],["こと"],["を"],["拒む","こばむ"],["。"],["これ"],["は"],["、"],["わたし"],["の"],["きらう"],["食物","しょくもつ"],["の"],["よう"],["だ"],["。"]]},{"verse":8,"text":"どうかわたしの求,もとめるものが獲,えられるように。どうか神,かみがわたしの望,のぞむものをくださるように。","tok":[["どう"],["か"],["わたし"],["の"],["求める","もとめる"],["もの"],["が"],["獲られる","えられる"],["よう"],["に"],["。"],["どう"],["か"],["神","かみ"],["が"],["わたし"],["の"],["望む","のぞむ"],["もの"],["を"],["くださる"],["よう"],["に"],["。"]]},{"verse":9,"text":"どうか神,かみがわたしを打,うち滅,ほろぼすことをよしとし、み手,てを伸,のべてわたしを断,たたれるように。","tok":[["どう"],["か"],["神","かみ"],["が"],["わたし"],["を"],["打ち滅ぼす","うちほろぼす"],["こと"],["を"],["よし"],["と"],["し"],["、"],["み手","みて"],["を"],["伸べて","のべて"],["わたし"],["を"],["断たれる","たたれる"],["よう"],["に"],["。"]]},{"verse":10,"text":"そうすれば、わたしはなお慰,なぐさめを得,え、激,はげしい苦,くるしみの中,なかにあっても喜,よろこぶであろう。わたしは聖,せいなる者,ものの言葉,ことばを否,いなんだことがないからだ。","tok":[["そう"],["すれば"],["、"],["わたし"],["は"],["なお"],["慰さめ","なぐさめ"],["を"],["得","え"],["、"],["激しい","はげしい"],["苦しみ","くるしみ"],["の"],["中","なか"],["に"],["あって"],["も"],["喜こぶで","よろこぶで"],["あろう"],["。"],["わたし"],["は"],["聖","せい"],["なる"],["者","もの"],["の"],["言葉","ことば"],["を"],["否んだ","いなんだ"],["こと"],["が"],["ない"],["から"],["だ"],["。"]]},{"verse":11,"text":"わたしにどんな力,ちからがあって、なお待,またねばならないのか。わたしにどんな終,おわりがあるので、なお耐,たえ忍,しのばねばならないのか。","tok":[["わたし"],["に"],["どんな"],["力","ちから"],["が"],["あって"],["、"],["なお"],["待たねば","またねば"],["ならない"],["の"],["か"],["。"],["わたし"],["に"],["どんな"],["終","おわり"],["が"],["ある"],["ので"],["、"],["なお"],["耐え忍ばねば","たえしのばねば"],["ならない"],["の"],["か"],["。"]]},{"verse":12,"text":"わたしの力,ちからは石,いしの力,ちからのようであるのか。わたしの肉,にくは青銅,せいどうのようであるのか。","tok":[["わたし"],["の"],["力","ちから"],["は"],["石","いし"],["の"],["力","ちから"],["の"],["よう"],["で"],["ある"],["の"],["か"],["。"],["わたし"],["の"],["肉","にく"],["は"],["青銅","せいどう"],["の"],["よう"],["で"],["ある"],["の"],["か"],["。"]]},{"verse":13,"text":"まことに、わたしのうちに助,たすけはなく、救,すくわれる望,のぞみは、わたしから追,おいやられた。","tok":[["まこと"],["に"],["、"],["わたし"],["の"],["うち"],["に"],["助け","たすけ"],["は"],["なく"],["、"],["救われる","すくわれる"],["望み","のぞみ"],["は"],["、"],["わたし"],["から"],["追いやられた","おいやられた"],["。"]]},{"verse":14,"text":"その友,ともに対,たいするいつくしみをさし控,ひかえる者,ものは、全能者,ぜんのうしゃを恐,おそれることをすてる。","tok":[["その"],["友","とも"],["に"],["対する","たいする"],["いつくしみ"],["を"],["さし"],["控","ひかえ"],["る"],["者","もの"],["は"],["、"],["全能者","ぜんのうしゃ"],["を"],["恐れる","おそれる"],["こと"],["を"],["すてる"],["。"]]},{"verse":15,"text":"わが兄弟,きょうだいたちは谷川,たにがわのように、過,すぎ去,さる出水,でみずのように欺,あざむく。","tok":[["わが"],["兄弟","きょうだい"],["たち"],["は"],["谷川","たにがわ"],["の"],["よう"],["に"],["、"],["過去る","すぎさる"],["出水","でみず"],["の"],["よう"],["に"],["欺く","あざむく"],["。"]]},{"verse":16,"text":"これは氷,こおりのために黒,くろくなり、そのうちに雪,ゆきが隠,かくれる。","tok":[["これ"],["は"],["氷","こおり"],["の"],["ため"],["に"],["黒く","くろく"],["なり"],["、"],["その"],["うち"],["に"],["雪","ゆき"],["が"],["隠れる","かくれる"],["。"]]},{"verse":17,"text":"これは暖,あたたかになると消,きえ去,さり、暑,あつくなるとその所,ところからなくなる。","tok":[["これ"],["は"],["暖か","あたたか"],["に"],["なる"],["と"],["消え去り","きえさり"],["、"],["暑く","あつく"],["なる"],["と"],["その"],["所","ところ"],["から"],["なくなる"],["。"]]},{"verse":18,"text":"隊商,たいしょうはその道,みちを転,てんじ、むなしい所,ところへ行,いって滅,ほろびる。","tok":[["隊商","たいしょう"],["は"],["その"],["道","みち"],["を"],["転じ","てんじ"],["、"],["むなしい"],["所","ところ"],["へ"],["行って","いって"],["滅びる","ほろびる"],["。"]]},{"verse":19,"text":"テマの隊商,たいしょうはこれを望,のぞみ、シバの旅,たびびとはこれを慕,したう。","tok":[["テマ"],["の"],["隊商","たいしょう"],["は"],["これ"],["を"],["望み","のぞみ"],["、"],["シバ"],["の"],["旅びと","たびびと"],["は"],["これ"],["を"],["慕う","したう"],["。"]]},{"verse":20,"text":"彼,かれらはこれにたよったために失望,しつぼうし、そこに来,きてみて、あわてる。","tok":[["彼","かれ"],["ら"],["は"],["これ"],["に"],["たよった"],["ため"],["に"],["失望","しつぼう"],["し"],["、"],["そこ"],["に"],["来て","きて"],["みて"],["、"],["あわてる"],["。"]]},{"verse":21,"text":"あなたがたは今,いまわたしにはこのような者,ものとなった。あなたがたはわたしの災難,さいなんを見,みて恐,おそれた。","tok":[["あなた"],["がた"],["は"],["今","いま"],["わたし"],["に"],["は"],["この"],["よう"],["な"],["者","もの"],["と"],["なった"],["。"],["あなた"],["がた"],["は"],["わたし"],["の"],["災難","さいなん"],["を"],["見て","みて"],["恐れた","おそれた"],["。"]]},{"verse":22,"text":"わたしは言,いったことがあるか、『わたしに与,あたえよ』と、あるいは『あなたがたの財産,ざいさんのうちからわたしのために、まいないを贈,おくれ』と、","tok":[["わたし"],["は"],["言った","いった"],["こと"],["が"],["ある"],["か"],["、"],["『"],["わたし"],["に"],["与","あたえ"],["よ"],["』"],["と"],["、"],["あるいは"],["『"],["あなた"],["がた"],["の"],["財産","ざいさん"],["の"],["うち"],["から"],["わたし"],["の"],["ため"],["に"],["、"],["まいない"],["を"],["贈れ","おくれ"],["』"],["と"],["、"]]},{"verse":23,"text":"あるいは『あだの手,てからわたしを救,すくい出,だせ』と、あるいは『しえたげる者,ものの手,てからわたしをあがなえ』と。","tok":[["あるいは"],["『"],["あだ"],["の"],["手","て"],["から"],["わたし"],["を"],["救い出せ","すくいだせ"],["』"],["と"],["、"],["あるいは"],["『"],["し"],["えたげる"],["者","もの"],["の"],["手","て"],["から"],["わたし"],["を"],["あがなえ"],["』"],["と"],["。"]]},{"verse":24,"text":"わたしに教,おしえよ、そうすればわたしは黙,だまるであろう。わたしの誤,あやまっている所,ところをわたしに悟,さとらせよ。","tok":[["わたし"],["に"],["教えよ","おしえよ"],["、"],["そう"],["すれば"],["わたし"],["は"],["黙るで","だまるで"],["あろう"],["。"],["わたし"],["の"],["誤って","あやまって"],["いる"],["所","ところ"],["を"],["わたし"],["に"],["悟らせ","さとらせ"],["よ"],["。"]]},{"verse":25,"text":"正,ただしい言葉,ことばはいかに力,ちからのあるものか。しかしあなたがたの戒,いましめは何,なにを戒,いましめるのか。","tok":[["正い","ただしい"],["言葉","ことば"],["は"],["いかに"],["力","ちから"],["の"],["ある"],["もの"],["か"],["。"],["しかし"],["あなた"],["がた"],["の"],["戒しめ","いましめ"],["は"],["何に","なに"],["を"],["戒める","いましめる"],["の"],["か"],["。"]]},{"verse":26,"text":"あなたがたは言葉,ことばを戒,いましめうると思,おもうのか。望,のぞみの絶,たえた者,ものの語,かたることは風,かぜのようなものだ。","tok":[["あなた"],["がた"],["は"],["言葉","ことば"],["を"],["戒しめ","いましめ"],["うる"],["と"],["思","おもう"],["の"],["か"],["。"],["望み","のぞみ"],["の"],["絶えた","たえた"],["者","もの"],["の"],["語る","かたる"],["こと"],["は"],["風","かぜ"],["の"],["よう"],["な"],["もの"],["だ"],["。"]]},{"verse":27,"text":"あなたがたは、みなしごのためにくじをひき、あなたがたの友,ともをさえ売,うり買,かいするであろう。","tok":[["あなた"],["がた"],["は"],["、"],["みなしご"],["の"],["ため"],["に"],["くじ"],["を"],["ひき"],["、"],["あなた"],["がた"],["の"],["友","とも"],["を"],["さえ"],["売買","うりかい"],["するで"],["あろう"],["。"]]},{"verse":28,"text":"今,いま、どうぞわたしを見,みられよ、わたしはあなたがたの顔,かおに向,むかって偽,いつわらない。","tok":[["今","いま"],["、"],["どうぞ"],["わたし"],["を"],["見られよ","みられよ"],["、"],["わたし"],["は"],["あなた"],["がた"],["の"],["顔","かお"],["に"],["向かって","むかって"],["偽わらない","いつわらない"],["。"]]},{"verse":29,"text":"どうぞ、思,おもいなおせ、まちがってはならない。さらに思,おもいなおせ、わたしの義,ぎは、なおわたしのうちにある。","tok":[["どうぞ"],["、"],["思いなおせ","おもいなおせ"],["、"],["まちがって"],["は"],["ならない"],["。"],["さらに"],["思いなおせ","おもいなおせ"],["、"],["わたし"],["の"],["義","ぎ"],["は"],["、"],["なお"],["わたし"],["の"],["うち"],["に"],["ある"],["。"]]},{"verse":30,"text":"わたしの舌,したに不義,ふぎがあるか。わたしの口,くちは災,わざわいをわきまえることができぬであろうか。","tok":[["わたし"],["の"],["舌","した"],["に"],["不義","ふぎ"],["が"],["ある"],["か"],["。"],["わたし"],["の"],["口","くち"],["は"],["災","わざわい"],["を"],["わきまえる"],["こと"],["が"],["できぬで"],["あろう"],["か"],["。"]]}]
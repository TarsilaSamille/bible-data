[{"verse":1,"text":"そこでテマンびとエリパズは答,こたえて言,いった、","tok":[["そこ"],["で"],["テマン"],["び"],["と"],["エリパズ"],["は"],["答","こたえ"],["て"],["言った","いった"],["、"]]},{"verse":2,"text":"「人,ひとは神,かみを益,えきすることができるであろうか。賢,かしこい人,ひとも、ただ自身,じしんを益,えきするのみである。","tok":[["「"],["人","ひと"],["は"],["神","かみ"],["を"],["益する","えきする"],["こと"],["が"],["できるで"],["あろう"],["か"],["。"],["賢しこい","かしこい"],["人","ひと"],["も"],["、"],["ただ"],["自身","じしん"],["を"],["益する","えきする"],["のみ"],["で"],["ある"],["。"]]},{"verse":3,"text":"あなたが正,ただしくても、全能者,ぜんのうしゃになんの喜,よろこびがあろう。あなたが自分,じぶんの道,みちを全,まっとうしても、彼,かれになんの利益,りえきがあろう。","tok":[["あなた"],["が"],["正くて","ただしくて"],["も"],["、"],["全能者","ぜんのうしゃ"],["に"],["なん"],["の"],["喜こび","よろこび"],["が"],["あろう"],["。"],["あなた"],["が"],["自分","じぶん"],["の"],["道","みち"],["を"],["全う","まっとう"],["して"],["も"],["、"],["彼","かれ"],["に"],["なん"],["の"],["利益","りえき"],["が"],["あろう"],["。"]]},{"verse":4,"text":"神,かみはあなたが神,かみを恐,おそれることのゆえに、あなたを責,せめ、あなたをさばかれるであろうか。","tok":[["神","かみ"],["は"],["あなた"],["が"],["神","かみ"],["を"],["恐れる","おそれる"],["こと"],["の"],["ゆえ"],["に"],["、"],["あなた"],["を"],["責","せめ"],["、"],["あなた"],["を"],["さばかれるで"],["あろう"],["か"],["。"]]},{"verse":5,"text":"あなたの悪,あくは大,おおきいではないか。あなたの罪,つみは、はてしがない。","tok":[["あなた"],["の"],["悪","あく"],["は"],["大きいで","おおきいで"],["は"],["ない"],["か"],["。"],["あなた"],["の"],["罪","つみ"],["は"],["、"],["はてし"],["が"],["ない"],["。"]]},{"verse":6,"text":"あなたはゆえなく兄弟,きょうだいのものを質,しちにとり、裸,はだかな者,ものの着物,きものをはぎ取,とり、","tok":[["あなた"],["は"],["ゆえなく"],["兄弟","きょうだい"],["の"],["もの"],["を"],["質","しち"],["に"],["とり"],["、"],["裸","はだか"],["な"],["者","もの"],["の"],["着物","きもの"],["を"],["はぎ"],["取","とり"],["、"]]},{"verse":7,"text":"疲,つかれた者,ものに水,みずを飲,のませず、飢,うえた者,ものに食物,しょくもつを与,あたえなかった。","tok":[["疲れた","つかれた"],["者","もの"],["に"],["水","みず"],["を"],["飲ませず","のませず"],["、"],["飢","うえ"],["た"],["者","もの"],["に"],["食物","しょくもつ"],["を"],["与えなかった","あたえなかった"],["。"]]},{"verse":8,"text":"力,ちからある人,ひとは土地,とちを得,え、名,なある人,ひとはそのうちに住,すんだ。","tok":[["力","ちから"],["ある"],["人","ひと"],["は"],["土地","とち"],["を"],["得","え"],["、"],["名","な"],["ある"],["人","ひと"],["は"],["その"],["うち"],["に"],["住んだ","すんだ"],["。"]]},{"verse":9,"text":"あなたは、やもめをむなしく去,さらせた。みなしごの腕,うでは折,おられた。","tok":[["あなた"],["は"],["、"],["やもめ"],["を"],["むなしく"],["去らせた","さらせた"],["。"],["みなしご"],["の"],["腕","うで"],["は"],["折られた","おられた"],["。"]]},{"verse":10,"text":"それゆえ、わなはあなたをめぐり、恐怖,きょうふは、にわかにあなたを驚,おどろかす。","tok":[["それ"],["ゆえ"],["、"],["わな"],["は"],["あなた"],["を"],["めぐり"],["、"],["恐怖","きょうふ"],["は"],["、"],["にわか"],["に"],["あなた"],["を"],["驚ろかす","おどろかす"],["。"]]},{"verse":11,"text":"あなたの光,ひかりは暗,くらくされ、あなたは見,みることができない。大水,おおみずはあなたをおおうであろう。","tok":[["あなた"],["の"],["光","ひかり"],["は"],["暗く","くらく"],["され"],["、"],["あなた"],["は"],["見る","みる"],["こと"],["が"],["できない"],["。"],["大水","おおみず"],["は"],["あなた"],["を"],["おおうで"],["あろう"],["。"]]},{"verse":12,"text":"神,かみは天,てんに高,たかくおられるではないか。見,みよ、いと高,たかき星,ほしを。いかに高,たかいことよ。","tok":[["神","かみ"],["は"],["天","てん"],["に"],["高かく","たかく"],["おられるで"],["は"],["ない"],["か"],["。"],["見よ","みよ"],["、"],["いと"],["高き","たかき"],["星","ほし"],["を"],["。"],["いかに"],["高い","たかい"],["こと"],["よ"],["。"]]},{"verse":13,"text":"それであなたは言,いう、『神,かみは何,なにを知,しっておられるか。彼,かれは黒雲,くろくもを通,とおして、さばくことができるのか。","tok":[["それ"],["で"],["あなた"],["は"],["言う","いう"],["、"],["『"],["神","かみ"],["は"],["何に","なに"],["を"],["知って","しって"],["おられる"],["か"],["。"],["彼","かれ"],["は"],["黒雲","くろくも"],["を"],["通して","とおして"],["、"],["さばく"],["こと"],["が"],["できる"],["の"],["か"],["。"]]},{"verse":14,"text":"濃,こい雲,くもが彼,かれをおおい隠,かくすと、彼,かれは見,みることができない。彼,かれは天,てんの大空,おおぞらを歩,あゆまれるのだ』と。","tok":[["濃い","こい"],["雲","くも"],["が"],["彼","かれ"],["を"],["おおい隠す","おおいかくす"],["と"],["、"],["彼","かれ"],["は"],["見る","みる"],["こと"],["が"],["できない"],["。"],["彼","かれ"],["は"],["天","てん"],["の"],["大空","おおぞら"],["を"],["歩まれる","あゆまれる"],["の"],["だ"],["』"],["と"],["。"]]},{"verse":15,"text":"あなたは悪,あしき人々,ひとびとが踏,ふんだいにしえの道,みちを守,まもろうとするのか。","tok":[["あなた"],["は"],["悪しき","あしき"],["人々","ひとびと"],["が"],["踏","ふんだい"],["に"],["し"],["え"],["の"],["道","みち"],["を"],["守ろう","まもろう"],["と"],["する"],["の"],["か"],["。"]]},{"verse":16,"text":"彼,かれらは時,ときがこないうちに取,とり去,さられ、その基,もといは川,かわのように押,おし流,ながされた。","tok":[["彼","かれ"],["ら"],["は"],["時","とき"],["が"],["こない"],["うち"],["に"],["取去られ","とりさられ"],["、"],["その"],["基い","もとい"],["は"],["川","かわ"],["の"],["よう"],["に"],["押","おし"],["流された","ながされた"],["。"]]},{"verse":17,"text":"彼,かれらは神,かみに言,いった、『われわれを離,はなれてください』と、また『全能者,ぜんのうしゃはわれわれに何,なにをなしえようか』と。","tok":[["彼","かれ"],["ら"],["は"],["神","かみ"],["に"],["言った","いった"],["、"],["『"],["われわれ"],["を"],["離れて","はなれて"],["ください"],["』"],["と"],["、"],["また"],["『"],["全能者","ぜんのうしゃ"],["は"],["われわれ"],["に"],["何に","なに"],["を"],["なし"],["えよう"],["か"],["』"],["と"],["。"]]},{"verse":18,"text":"しかし神,かみは彼,かれらの家,いえを良,よい物,もので満,みたされた。ただし悪人,あくにんの計,はかりごとはわたしのくみする所,ところではない。","tok":[["しかし"],["神","かみ"],["は"],["彼","かれ"],["ら"],["の"],["家","いえ"],["を"],["良い","よい"],["物","もの"],["で"],["満たされた","みたされた"],["。"],["ただし"],["悪人","あくにん"],["の"],["計り","はかり"],["ごと"],["は"],["わたし"],["の"],["くみする"],["所","ところ"],["で"],["は"],["ない"],["。"]]},{"verse":19,"text":"正,ただしい者,ものはこれを見,みて喜,よろこび、罪,つみなき者,ものは彼,かれらをあざ笑,わらって言,いう、","tok":[["正い","ただしい"],["者","もの"],["は"],["これ"],["を"],["見て","みて"],["喜こび","よろこび"],["、"],["罪","つみ"],["なき"],["者","もの"],["は"],["彼","かれ"],["ら"],["を"],["あざ笑って","あざわらって"],["言う","いう"],["、"]]},{"verse":20,"text":"『まことにわれわれのあだは滅,ほろぼされ、その残,のこした物,ものは火,ひで焼,やき滅,ほろぼされた』と。","tok":[["『"],["まこと"],["に"],["われわれ"],["の"],["あだ"],["は"],["滅ぼされ","ほろぼされ"],["、"],["その"],["残した","のこした"],["物","もの"],["は"],["火","ひ"],["で"],["焼き滅ぼされた","やきほろぼされた"],["』"],["と"],["。"]]},{"verse":21,"text":"あなたは神,かみと和,やわらいで、平安,へいあんを得,えるがよい。そうすれば幸福,こうふくがあなたに来,くるでしょう。","tok":[["あなた"],["は"],["神","かみ"],["と"],["和らいで","やわらいで"],["、"],["平安","へいあん"],["を"],["得る","える"],["が"],["よい"],["。"],["そう"],["すれば"],["幸福","こうふく"],["が"],["あなた"],["に"],["来るでしょう","くるでしょう"],["。"]]},{"verse":22,"text":"どうか、彼,かれの口,くちから教,おしえを受,うけ、その言葉,ことばをあなたの心,こころにおさめるように。","tok":[["どう"],["か"],["、"],["彼","かれ"],["の"],["口","くち"],["から"],["教え","おしえ"],["を"],["受け","うけ"],["、"],["その"],["言葉","ことば"],["を"],["あなた"],["の"],["心","こころ"],["に"],["おさめる"],["よう"],["に"],["。"]]},{"verse":23,"text":"あなたがもし全能者,ぜんのうしゃに立,たち返,かえって、おのれを低,ひくくし、あなたの天幕,てんまくから不義,ふぎを除,のぞき去,さり、","tok":[["あなた"],["が"],["もし"],["全能者","ぜんのうしゃ"],["に"],["立ち返って","たちかえって"],["、"],["おのれ"],["を"],["低く","ひくく"],["し"],["、"],["あなた"],["の"],["天幕","てんまく"],["から"],["不義","ふぎ"],["を"],["除き去り","のぞきさり"],["、"]]},{"verse":24,"text":"こがねをちりの中,なかに置,おき、オフルのこがねを谷川,たにがわの石,いしの中,なかに置,おき、","tok":[["こがね"],["を"],["ちり"],["の"],["中","なか"],["に"],["置き","おき"],["、"],["オフル"],["の"],["こがね"],["を"],["谷川","たにがわ"],["の"],["石","いし"],["の"],["中","なか"],["に"],["置き","おき"],["、"]]},{"verse":25,"text":"全能者,ぜんのうしゃがあなたのこがねとなり、あなたの貴重,きちょうなしろがねとなるならば、","tok":[["全能者","ぜんのうしゃ"],["が"],["あなた"],["の"],["こがね"],["と"],["なり"],["、"],["あなた"],["の"],["貴重","きちょう"],["な"],["しろがね"],["と"],["なるならば"],["、"]]},{"verse":26,"text":"その時,とき、あなたは全能者,ぜんのうしゃを喜,よろこび、神,かみに向,むかって顔,かおをあげることができる。","tok":[["その"],["時","とき"],["、"],["あなた"],["は"],["全能者","ぜんのうしゃ"],["を"],["喜こび","よろこび"],["、"],["神","かみ"],["に"],["向かって","むかって"],["顔","かお"],["を"],["あげる"],["こと"],["が"],["できる"],["。"]]},{"verse":27,"text":"あなたが彼,かれに祈,いのるならば、彼,かれはあなたに聞,きかれる。そしてあなたは自分,じぶんの誓,ちかいを果,はたす。","tok":[["あなた"],["が"],["彼","かれ"],["に"],["祈るならば","いのるならば"],["、"],["彼","かれ"],["は"],["あなた"],["に"],["聞かれる","きかれる"],["。"],["そして"],["あなた"],["は"],["自分","じぶん"],["の"],["誓い","ちかい"],["を"],["果たす","はたす"],["。"]]},{"verse":28,"text":"あなたが事,ことをなそうと定,さだめるならば、あなたはその事,ことを成就,じょうじゅし、あなたの道,みちには光,ひかりが輝,かがやく。","tok":[["あなた"],["が"],["事","こと"],["を"],["なそう"],["と"],["定めるならば","さだめるならば"],["、"],["あなた"],["は"],["その"],["事","こと"],["を"],["成就","じょうじゅ"],["し"],["、"],["あなた"],["の"],["道","みち"],["に"],["は"],["光","ひかり"],["が"],["輝やく","かがやく"],["。"]]},{"verse":29,"text":"彼,かれは高,たかぶる者,ものを低,ひくくされるが、へりくだる者,ものを救,すくわれるからだ。","tok":[["彼","かれ"],["は"],["高か","たか"],["ぶる"],["者","もの"],["を"],["低く","ひくく"],["される"],["が"],["、"],["へりくだる"],["者","もの"],["を"],["救われる","すくわれる"],["から"],["だ"],["。"]]},{"verse":30,"text":"彼,かれは罪,つみのない者,ものを救,すくわれる。あなたはその手,ての潔,いさぎよいことによって、救,すくわれるであろう」。","tok":[["彼","かれ"],["は"],["罪","つみ"],["の"],["ない"],["者","もの"],["を"],["救われる","すくわれる"],["。"],["あなた"],["は"],["その"],["手","て"],["の"],["潔ぎよい","いさぎよい"],["こと"],["によって"],["、"],["救われるで","すくわれるで"],["あろう"],["」"],["。"]]}]
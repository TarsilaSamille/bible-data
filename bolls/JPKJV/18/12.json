[{"verse":1,"text":"そこでヨブは答,こたえて言,いった、","tok":[["そこ"],["で"],["ヨブ"],["は"],["答","こたえ"],["て"],["言った","いった"],["、"]]},{"verse":2,"text":"「まことに、あなたがたのみ、人,ひとである、知恵,ちえはあなたがたと共,ともに死,しぬであろう。","tok":[["「"],["まこと"],["に"],["、"],["あなた"],["が"],["たのみ"],["、"],["人","ひと"],["で"],["ある"],["、"],["知恵","ちえ"],["は"],["あなた"],["がた"],["と"],["共","とも"],["に"],["死ぬで","しぬで"],["あろう"],["。"]]},{"verse":3,"text":"しかしわたしも、あなたがたと同様,どうように悟,さとりをもつ。わたしはあなたがたに劣,おとらない。だれがこのような事,ことを知,しらないだろうか。","tok":[["しかし"],["わたし"],["も"],["、"],["あなた"],["がた"],["と"],["同様","どうよう"],["に"],["悟り","さとり"],["を"],["もつ"],["。"],["わたし"],["は"],["あなた"],["がた"],["に"],["劣らない","おとらない"],["。"],["だれ"],["が"],["この"],["よう"],["な"],["事","こと"],["を"],["知らないだろう","しらないだろう"],["か"],["。"]]},{"verse":4,"text":"わたしは神,かみに呼,よばわって、聞,きかれた者,ものであるのに、その友,ともの物笑,ものわらいとなっている。正,ただしく全,まったき人,ひとは物笑,ものわらいとなる。","tok":[["わたし"],["は"],["神","かみ"],["に"],["呼ばわって","よばわって"],["、"],["聞かれた","きかれた"],["者","もの"],["で"],["ある"],["のに"],["、"],["その"],["友","とも"],["の"],["物","もの"],["笑","わらい"],["と"],["なって"],["いる"],["。"],["正く","ただしく"],["全","ま"],["っ"],["たき人","たきひと"],["は"],["物","もの"],["笑","わらい"],["と"],["なる"],["。"]]},{"verse":5,"text":"安,やすらかな者,ものの思,おもいには、不幸,ふこうな者,ものに対,たいする侮,あなどりがあって、足,あしのすべる者,ものを待,まっている。","tok":[["安らか","やすらか"],["な"],["者","もの"],["の"],["思い","おもい"],["に"],["は"],["、"],["不幸","ふこう"],["な"],["者","もの"],["に"],["対する","たいする"],["侮","あなどり"],["が"],["あって"],["、"],["足","あし"],["の"],["すべる"],["者","もの"],["を"],["待って","まって"],["いる"],["。"]]},{"verse":6,"text":"かすめ奪,うばう者,ものの天幕,てんまくは栄,さかえ、神,かみを怒,いからす者,ものは安,やすらかである。自分,じぶんの手,てに神,かみを携,たずさえている者,ものも同様,どうようだ。","tok":[["かすめ"],["奪う","うばう"],["者","もの"],["の"],["天幕","てんまく"],["は"],["栄","さかえ"],["、"],["神","かみ"],["を"],["怒らす","いからす"],["者","もの"],["は"],["安らか","やすらか"],["で"],["ある"],["。"],["自分","じぶん"],["の"],["手","て"],["に"],["神","かみ"],["を"],["携えて","たずさえて"],["いる"],["者","もの"],["も"],["同様","どうよう"],["だ"],["。"]]},{"verse":7,"text":"しかし獣,けものに問,とうてみよ、それはあなたに教,おしえる。空,そらの鳥,とりに問,とうてみよ、それはあなたに告,つげる。","tok":[["しかし"],["獣","けもの"],["に"],["問うて","とうて"],["みよ"],["、"],["それ"],["は"],["あなた"],["に"],["教える","おしえる"],["。"],["空","そら"],["の"],["鳥","とり"],["に"],["問うて","とうて"],["みよ"],["、"],["それ"],["は"],["あなた"],["に"],["告げる","つげる"],["。"]]},{"verse":8,"text":"あるいは地,ちの草,くさや木,きに問,とうてみよ、彼,かれらはあなたに教,おしえる。海,うみの魚,うおもまたあなたに示,しめす。","tok":[["あるいは"],["地","ち"],["の"],["草","くさ"],["や"],["木","き"],["に"],["問うて","とうて"],["みよ"],["、"],["彼","かれ"],["ら"],["は"],["あなた"],["に"],["教える","おしえる"],["。"],["海","うみ"],["の"],["魚","うお"],["も"],["また"],["あなた"],["に"],["示めす","しめす"],["。"]]},{"verse":9,"text":"これらすべてのもののうち、いずれか主,しゅの手,てがこれをなしたことを知,しらぬ者,ものがあろうか。","tok":[["これ"],["ら"],["すべて"],["の"],["もの"],["の"],["うち"],["、"],["いずれ"],["か"],["主","しゅ"],["の"],["手","て"],["が"],["これ"],["を"],["なした"],["こと"],["を"],["知らぬ","しらぬ"],["者","もの"],["が"],["あろう"],["か"],["。"]]},{"verse":10,"text":"すべての生,いき物,ものの命,いのち、およびすべての人,ひとの息,いきは彼,かれの手,てのうちにある。","tok":[["すべて"],["の"],["生き物","いきもの"],["の"],["命","いのち"],["、"],["および"],["すべて"],["の"],["人","ひと"],["の"],["息","いき"],["は"],["彼","かれ"],["の"],["手","て"],["の"],["うち"],["に"],["ある"],["。"]]},{"verse":11,"text":"口,くちが食物,しょくもつを味,あじわうように、耳,みみは言葉,ことばをわきまえないであろうか。","tok":[["口","くち"],["が"],["食物","しょくもつ"],["を"],["味わう","あじわう"],["よう"],["に"],["、"],["耳","みみ"],["は"],["言葉","ことば"],["を"],["わきまえないで"],["あろう"],["か"],["。"]]},{"verse":12,"text":"老,おいた者,ものには知恵,ちえがあり、命,いのちの長,ながい者,ものには悟,さとりがある。","tok":[["老","おい"],["た"],["者","もの"],["に"],["は"],["知恵","ちえ"],["が"],["あり"],["、"],["命","いのち"],["の"],["長い","ながい"],["者","もの"],["に"],["は"],["悟り","さとり"],["が"],["ある"],["。"]]},{"verse":13,"text":"知恵,ちえと力,ちからは神,かみと共,ともにあり、深慮,しんりょと悟,さとりも彼,かれのものである。","tok":[["知恵","ちえ"],["と"],["力","ちから"],["は"],["神","かみ"],["と"],["共","とも"],["に"],["あり"],["、"],["深慮","しんりょ"],["と"],["悟り","さとり"],["も"],["彼","かれ"],["の"],["もの"],["で"],["ある"],["。"]]},{"verse":14,"text":"彼,かれが破壊,はかいすれば、再,ふたたび建,たてることができない。彼,かれが人,ひとを閉,とじ込,こめれば、開,ひらき出,だすことができない。","tok":[["彼","かれ"],["が"],["破壊","はかい"],["すれば"],["、"],["再び","ふたたび"],["建てる","たてる"],["こと"],["が"],["できない"],["。"],["彼","かれ"],["が"],["人","ひと"],["を"],["閉じ込めれば","とじこめれば"],["、"],["開らき","ひらき"],["出す","だす"],["こと"],["が"],["できない"],["。"]]},{"verse":15,"text":"彼,かれが水,みずを止,とめれば、それはかれ、彼,かれが水,みずを出,だせば、地,ちをくつがえす。","tok":[["彼","かれ"],["が"],["水","みず"],["を"],["止めれば","とめれば"],["、"],["それ"],["は"],["かれ"],["、"],["彼","かれ"],["が"],["水","みず"],["を"],["出せば","だせば"],["、"],["地","ち"],["を"],["くつがえす"],["。"]]},{"verse":16,"text":"力,ちからと深,ふかき知恵,ちえは彼,かれと共,ともにあり、惑,まどわされる者,ものも惑,まどわす者,ものも彼,かれのものである。","tok":[["力","ちから"],["と"],["深き","ふかき"],["知恵","ちえ"],["は"],["彼","かれ"],["と"],["共","とも"],["に"],["あり"],["、"],["惑わされる","まどわされる"],["者","もの"],["も"],["惑わす","まどわす"],["者","もの"],["も"],["彼","かれ"],["の"],["もの"],["で"],["ある"],["。"]]},{"verse":17,"text":"彼,かれは議,ぎ士,したちを裸,はだかにして連,つれ行,いき、さばきびとらを愚,おろかにし、","tok":[["彼","かれ"],["は"],["議士","ぎし"],["たち"],["を"],["裸","はだか"],["に"],["して"],["連れ","つれ"],["行き","いき"],["、"],["さば"],["きび"],["とら"],["を"],["愚か","おろか"],["に"],["し"],["、"]]},{"verse":18,"text":"王,おうたちのきずなを解,とき、彼,かれらの腰,こしに腰帯,こしおびを巻,まき、","tok":[["王","おう"],["たち"],["の"],["きずな"],["を"],["解き","とき"],["、"],["彼","かれ"],["ら"],["の"],["腰","こし"],["に"],["腰帯","こしおび"],["を"],["巻","まき"],["、"]]},{"verse":19,"text":"祭司,さいしたちを裸,はだかにして連,つれ行,いき、力,ちからある者,ものを滅,ほろぼし、","tok":[["祭司","さいし"],["たち"],["を"],["裸","はだか"],["に"],["して"],["連れ","つれ"],["行き","いき"],["、"],["力","ちから"],["ある"],["者","もの"],["を"],["滅ぼし","ほろぼし"],["、"]]},{"verse":20,"text":"みずから頼,たのむ者,ものたちの言葉,ことばを奪,うばい、長老,ちょうろうたちの分別,ふんべつを取,とり去,さり、","tok":[["みずから"],["頼む","たのむ"],["者","もの"],["たち"],["の"],["言葉","ことば"],["を"],["奪い","うばい"],["、"],["長老","ちょうろう"],["たち"],["の"],["分別","ふんべつ"],["を"],["取去り","とりさり"],["、"]]},{"verse":21,"text":"君,きみたちの上,うえに侮,あなどりを注,そそぎ、強,つよい者,ものたちの帯,おびを解,とき、","tok":[["君","きみ"],["たち"],["の"],["上","うえ"],["に"],["侮","あなどり"],["を"],["注ぎ","そそぎ"],["、"],["強い","つよい"],["者","もの"],["たち"],["の"],["帯","おび"],["を"],["解き","とき"],["、"]]},{"verse":22,"text":"暗,くらやみの中,なかから隠,かくれた事,ことどもをあらわし、暗黒,あんこくを光,ひかりに引,ひき出,だし、","tok":[["暗やみ","くらやみ"],["の"],["中","なか"],["から"],["隠れた","かくれた"],["事","こと"],["ども"],["を"],["あらわし"],["、"],["暗黒","あんこく"],["を"],["光","ひかり"],["に"],["引出し","ひきだし"],["、"]]},{"verse":23,"text":"国々,くにぐにを大,おおきくし、またこれを滅,ほろぼし、国々,くにぐにを広,ひろくし、また捕,とらえ行,いき、","tok":[["国々","くにぐに"],["を"],["大きく","おおきく"],["し"],["、"],["また"],["これ"],["を"],["滅ぼし","ほろぼし"],["、"],["国々","くにぐに"],["を"],["広く","ひろく"],["し"],["、"],["また"],["捕らえ","とらえ"],["行き","いき"],["、"]]},{"verse":24,"text":"地,ちの民,たみの長,ちょうたちの悟,さとりを奪,うばい、彼,かれらを道,みちなき荒野,あらのにさまよわせ、","tok":[["地","ち"],["の"],["民","たみ"],["の"],["長","ちょう"],["たち"],["の"],["悟り","さとり"],["を"],["奪い","うばい"],["、"],["彼","かれ"],["ら"],["を"],["道","みち"],["なき"],["荒野","あらの"],["に"],["さまよわせ"],["、"]]},{"verse":25,"text":"光,ひかりなき暗,くらやみに手探,てさぐりさせ、酔,ようた者,もののようによろめかせる。","tok":[["光","ひかり"],["なき"],["暗やみ","くらやみ"],["に"],["手","て"],["探ぐりさせ","さぐりさせ"],["、"],["酔うた","ようた"],["者","もの"],["の"],["よう"],["に"],["よろめかせる"],["。"]]}]
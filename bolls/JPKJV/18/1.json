[{"verse":1,"text":"ウヅの地,ちにヨブという名,なの人,ひとがあった。そのひととなりは全,まったく、かつ正,ただしく、神,かみを恐,おそれ、悪,あくに遠,とおざかった。","tok":[["ウヅ"],["の"],["地","ち"],["に"],["ヨブ"],["と"],["いう"],["名","な"],["の"],["人","ひと"],["が"],["あった"],["。"],["その"],["ひととなり"],["は"],["全く","まったく"],["、"],["かつ"],["正く","ただしく"],["、"],["神","かみ"],["を"],["恐","おそれ"],["、"],["悪","あく"],["に"],["遠ざかった","とおざかった"],["。"]]},{"verse":2,"text":"彼,かれに男,おとこの子,こ七人,にんと女,おんなの子,こ三人,にんがあり、","tok":[["彼","かれ"],["に"],["男の子","おとこのこ"],["七人","にん"],["と"],["女の子","おんなのこ"],["三人","にん"],["が"],["あり"],["、"]]},{"verse":3,"text":"その家畜,かちくは羊,ひつじ七千頭,とう、らくだ三千頭,とう、牛,うし五百くびき、雌,めろば五百頭,とうで、しもべも非常,ひじょうに多,おおく、この人,ひとは東,ひがしの人々,ひとびとのうちで最,もっとも大,おおいなる者,ものであった。","tok":[["その"],["家畜","かちく"],["は"],["羊","ひつじ"],["七千頭","と"],["う"],["、"],["らくだ"],["三千頭","と"],["う"],["、"],["牛","うし"],["五百","ごひゃく"],["く"],["びき"],["、"],["雌","め"],["ろば"],["五百頭","と"],["う"],["で"],["、"],["しもべ"],["も"],["非常","ひじょう"],["に"],["多く","おおく"],["、"],["この"],["人","ひと"],["は"],["東","ひがし"],["の"],["人々","ひとびと"],["の"],["うち"],["で"],["最も","もっとも"],["大いなる","おおいなる"],["者","もの"],["で"],["あった"],["。"]]},{"verse":4,"text":"そのむすこたちは、めいめい自分,じぶんの日,ひに、自分,じぶんの家,いえでふるまいを設,もうけ、その三人,にんの姉妹,しまいをも招,まねいて一緒,いっしょに食,くい飲,のみするのを常,つねとした。","tok":[["その"],["むすこ"],["たち"],["は"],["、"],["めいめい"],["自分","じぶん"],["の"],["日","ひ"],["に"],["、"],["自分","じぶん"],["の"],["家","いえ"],["で"],["ふるまい"],["を"],["設け","もうけ"],["、"],["その"],["三人","にん"],["の"],["姉妹","しまい"],["を"],["も"],["招いて","まねいて"],["一緒","いっしょ"],["に"],["食い","くい"],["飲み","のみ"],["する"],["の"],["を"],["常","つね"],["と"],["した"],["。"]]},{"verse":5,"text":"そのふるまいの日,ひがひとめぐり終,おわるごとに、ヨブは彼,かれらを呼,よび寄,よせて聖別,せいべつし、朝,あさ早,はやく起,おきて、彼,かれらすべての数,かずにしたがって燔祭,はんさいをささげた。これはヨブが「わたしのむすこたちは、ことによったら罪,つみを犯,おかし、その心,こころに神,かみをのろったかもしれない」と思,おもったからである。ヨブはいつも、このように行,いった。","tok":[["その"],["ふるまい"],["の"],["日","ひ"],["が"],["ひとめ"],["ぐり"],["終わる","おわる"],["ごと"],["に"],["、"],["ヨブ"],["は"],["彼","かれ"],["ら"],["を"],["呼び寄せて","よびよせて"],["聖別","せいべつ"],["し"],["、"],["朝","あさ"],["早く","はやく"],["起きて","おきて"],["、"],["彼","かれ"],["ら"],["すべて"],["の"],["数","かず"],["に"],["したがって"],["燔祭","はんさい"],["を"],["ささげた"],["。"],["これ"],["は"],["ヨブ"],["が"],["「"],["わたし"],["の"],["むすこ"],["たち"],["は"],["、"],["こと"],["に"],["よったら"],["罪","つみ"],["を"],["犯し","おかし"],["、"],["その"],["心","こころ"],["に"],["神","かみ"],["を"],["のろった"],["か"],["も"],["しれない"],["」"],["と"],["思った","おもった"],["から"],["で"],["ある"],["。"],["ヨブ"],["は"],["いつも"],["、"],["この"],["よう"],["に"],["行った","いった"],["。"]]},{"verse":6,"text":"ある日,ひ、神,かみの子,こたちが来,きて、主,しゅの前,まえに立,たった。サタンも来,きてその中,なかにいた。","tok":[["ある"],["日","ひ"],["、"],["神","かみ"],["の"],["子","こ"],["たち"],["が"],["来て","きて"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["立った","たった"],["。"],["サタン"],["も"],["来て","きて"],["その"],["中","なか"],["に"],["いた"],["。"]]},{"verse":7,"text":"主,しゅは言,いわれた、「あなたはどこから来,きたか」。サタンは主,しゅに答,こたえて言,いった、「地,ちを行,いきめぐり、あちらこちら歩,あるいてきました」。","tok":[["主","しゅ"],["は"],["言われた","いわれた"],["、"],["「"],["あなた"],["は"],["どこ"],["から"],["来た","きた"],["か"],["」"],["。"],["サタン"],["は"],["主に","しゅに"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["地","ち"],["を"],["行き","いき"],["めぐり"],["、"],["あちらこちら"],["歩いて","あるいて"],["きました"],["」"],["。"]]},{"verse":8,"text":"主,しゅはサタンに言,いわれた、「あなたはわたしのしもべヨブのように全,まったく、かつ正,ただしく、神,かみを恐,おそれ、悪,あくに遠,とおざかる者,ものの世,よにないことを気,きづいたか」。","tok":[["主","しゅ"],["は"],["サタン"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["は"],["わたし"],["の"],["しもべ"],["ヨブ"],["の"],["よう"],["に"],["全く","まったく"],["、"],["かつ"],["正く","ただしく"],["、"],["神","かみ"],["を"],["恐","おそれ"],["、"],["悪","あく"],["に"],["遠ざかる","とおざかる"],["者","もの"],["の"],["世","よ"],["に"],["ない"],["こと"],["を"],["気づいた","きづいた"],["か"],["」"],["。"]]},{"verse":9,"text":"サタンは主,しゅに答,こたえて言,いった、「ヨブはいたずらに神,かみを恐,おそれましょうか。","tok":[["サタン"],["は"],["主に","しゅに"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["ヨブ"],["は"],["いたずら"],["に"],["神","かみ"],["を"],["恐れましょう","おそれましょう"],["か"],["。"]]},{"verse":10,"text":"あなたは彼,かれとその家,いえおよびすべての所有物,しょゆうぶつのまわりにくまなく、まがきを設,もうけられたではありませんか。あなたは彼,かれの勤労,きんろうを祝福,しゅくふくされたので、その家畜,かちくは地,ちにふえたのです。","tok":[["あなた"],["は"],["彼","かれ"],["と"],["その"],["家","いえ"],["および"],["すべて"],["の"],["所有物","しょゆうぶつ"],["の"],["まわり"],["に"],["くまなく"],["、"],["ま"],["がき"],["を"],["設けられたで","もうけられたで"],["は"],["ありません"],["か"],["。"],["あなた"],["は"],["彼","かれ"],["の"],["勤労","きんろう"],["を"],["祝福","しゅくふく"],["された"],["ので"],["、"],["その"],["家畜","かちく"],["は"],["地","ち"],["に"],["ふえた"],["の"],["です"],["。"]]},{"verse":11,"text":"しかし今,いまあなたの手,てを伸,のべて、彼,かれのすべての所有物,しょゆうぶつを撃,うってごらんなさい。彼,かれは必,かならずあなたの顔,かおに向,むかって、あなたをのろうでしょう」。","tok":[["しかし"],["今","いま"],["あなた"],["の"],["手","て"],["を"],["伸べて","のべて"],["、"],["彼","かれ"],["の"],["すべて"],["の"],["所有物","しょゆうぶつ"],["を"],["撃って","うって"],["ごらん"],["なさい"],["。"],["彼","かれ"],["は"],["必","かならず"],["あなた"],["の"],["顔","かお"],["に"],["向かって","むかって"],["、"],["あなた"],["を"],["のろうでしょう"],["」"],["。"]]},{"verse":12,"text":"主,しゅはサタンに言,いわれた、「見,みよ、彼,かれのすべての所有物,しょゆうぶつをあなたの手,てにまかせる。ただ彼,かれの身,みに手,てをつけてはならない」。サタンは主,しゅの前,まえから出,でて行,いった。","tok":[["主","しゅ"],["は"],["サタン"],["に"],["言われた","いわれた"],["、"],["「"],["見よ","みよ"],["、"],["彼","かれ"],["の"],["すべて"],["の"],["所有物","しょゆうぶつ"],["を"],["あなた"],["の"],["手","て"],["に"],["まかせる"],["。"],["ただ"],["彼","かれ"],["の"],["身","み"],["に"],["手","て"],["を"],["つけて"],["は"],["ならない"],["」"],["。"],["サタン"],["は"],["主","しゅ"],["の"],["前","まえ"],["から"],["出て","でて"],["行った","いった"],["。"]]},{"verse":13,"text":"ある日,ひヨブのむすこ、娘,むすめたちが第,だい一の兄,あにの家,いえで食事,しょくじをし、酒,さけを飲,のんでいたとき、","tok":[["ある"],["日","ひ"],["ヨブ"],["の"],["むすこ"],["、"],["娘","むすめ"],["たち"],["が"],["第","だい"],["一","いち"],["の"],["兄","あに"],["の"],["家","いえ"],["で"],["食事","しょくじ"],["を"],["し"],["、"],["酒","さけ"],["を"],["飲んで","のんで"],["いた"],["とき"],["、"]]},{"verse":14,"text":"使者,ししゃがヨブのもとに来,きて言,いった、「牛,うしが耕,たがやし、ろばがそのかたわらで草,くさを食,くっていると、","tok":[["使者","ししゃ"],["が"],["ヨブ"],["の"],["もと"],["に"],["来て","きて"],["言った","いった"],["、"],["「"],["牛","うし"],["が"],["耕やし","たがやし"],["、"],["ろば"],["が"],["その"],["かたわら"],["で"],["草","くさ"],["を"],["食って","くって"],["いる"],["と"],["、"]]},{"verse":15,"text":"シバびとが襲,おそってきて、これを奪,うばい、つるぎをもってしもべたちを打,うち殺,ころしました。わたしはただひとりのがれて、あなたに告,つげるために来,きました」。","tok":[["シバ"],["びと"],["が"],["襲って","おそって"],["きて"],["、"],["これ"],["を"],["奪い","うばい"],["、"],["つるぎ"],["を"],["もって"],["しもべ"],["たち"],["を"],["打ち","うち"],["殺ろ","ころ"],["しました"],["。"],["わたし"],["は"],["ただ"],["ひとり"],["のがれて"],["、"],["あなた"],["に"],["告げる","つげる"],["ため"],["に"],["来ました","きました"],["」"],["。"]]},{"verse":16,"text":"彼,かれがなお語,かたっているうちに、またひとりが来,きて言,いった、「神,かみの火,ひが天,てんから下,くだって、羊,ひつじおよびしもべたちを焼,やき滅,ほろぼしました。わたしはただひとりのがれて、あなたに告,つげるために来,きました」。","tok":[["彼","かれ"],["が"],["なお"],["語って","かたって"],["いる"],["うち"],["に"],["、"],["また"],["ひとり"],["が"],["来て","きて"],["言った","いった"],["、"],["「"],["神","かみ"],["の"],["火","ひ"],["が"],["天","てん"],["から"],["下って","くだって"],["、"],["羊","ひつじ"],["および"],["しもべ"],["たち"],["を"],["焼き滅ぼしました","やきほろぼしました"],["。"],["わたし"],["は"],["ただ"],["ひとり"],["のがれて"],["、"],["あなた"],["に"],["告げる","つげる"],["ため"],["に"],["来ました","きました"],["」"],["。"]]},{"verse":17,"text":"彼,かれがなお語,かたっているうちに、またひとりが来,きて言,いった、「カルデヤびとが三組,くみに分,わかれて来,きて、らくだを襲,おそってこれを奪,うばい、つるぎをもってしもべたちを打,うち殺,ころしました。わたしはただひとりのがれて、あなたに告,つげるために来,きました」。","tok":[["彼","かれ"],["が"],["なお"],["語って","かたって"],["いる"],["うち"],["に"],["、"],["また"],["ひとり"],["が"],["来て","きて"],["言った","いった"],["、"],["「"],["カルデヤ"],["びと"],["が"],["三","さん"],["組","くみ"],["に"],["分かれて","わかれて"],["来て","きて"],["、"],["らくだ"],["を"],["襲って","おそって"],["これ"],["を"],["奪い","うばい"],["、"],["つるぎ"],["を"],["もって"],["しもべ"],["たち"],["を"],["打ち","うち"],["殺ろ","ころ"],["しました"],["。"],["わたし"],["は"],["ただ"],["ひとり"],["のがれて"],["、"],["あなた"],["に"],["告げる","つげる"],["ため"],["に"],["来ました","きました"],["」"],["。"]]},{"verse":18,"text":"彼,かれがなお語,かたっているうちに、またひとりが来,きて言,いった、「あなたのむすこ、娘,むすめたちが第,だい一の兄,あにの家,いえで食事,しょくじをし、酒,さけを飲,のんでいると、","tok":[["彼","かれ"],["が"],["なお"],["語って","かたって"],["いる"],["うち"],["に"],["、"],["また"],["ひとり"],["が"],["来て","きて"],["言った","いった"],["、"],["「"],["あなた"],["の"],["むすこ"],["、"],["娘","むすめ"],["たち"],["が"],["第","だい"],["一","いち"],["の"],["兄","あに"],["の"],["家","いえ"],["で"],["食事","しょくじ"],["を"],["し"],["、"],["酒","さけ"],["を"],["飲んで","のんで"],["いる"],["と"],["、"]]},{"verse":19,"text":"荒野,あらのの方,ほうから大風,おおかぜが吹,ふいてきて、家,いえの四,よすみを撃,うったので、あの若,わかい人,ひとたちの上,うえにつぶれ落,おちて、皆,みな死,しにました。わたしはただひとりのがれて、あなたに告,つげるために来,きました」。","tok":[["荒野","あら"],["の"],["の"],["方","ほう"],["から"],["大風","おおかぜ"],["が"],["吹いて","ふいて"],["きて"],["、"],["家","いえ"],["の"],["四","よすみ"],["を"],["撃った","うった"],["ので"],["、"],["あの"],["若い","わかい"],["人","ひと"],["たち"],["の"],["上","うえ"],["に"],["つぶれ"],["落","おち"],["て"],["、"],["皆","みな"],["死にました","しにました"],["。"],["わたし"],["は"],["ただ"],["ひとり"],["のがれて"],["、"],["あなた"],["に"],["告げる","つげる"],["ため"],["に"],["来ました","きました"],["」"],["。"]]},{"verse":20,"text":"このときヨブは起,おき上,あがり、上着,うわぎを裂,さき、頭,とうをそり、地,ちに伏,ふして拝,はいし、","tok":[["この"],["とき"],["ヨブ"],["は"],["起き上がり","おきあがり"],["、"],["上着","うわぎ"],["を"],["裂き","さき"],["、"],["頭","とう"],["を"],["そり"],["、"],["地","ち"],["に"],["伏して","ふして"],["拝し","はいし"],["、"]]},{"verse":21,"text":"そして言,いった、「わたしは裸,はだかで母,ははの胎,たいを出,でた。また裸,はだかでかしこに帰,かえろう。主,しゅが与,あたえ、主,しゅが取,とられたのだ。主,しゅのみ名,なはほむべきかな」。","tok":[["そして"],["言った","いった"],["、"],["「"],["わたし"],["は"],["裸","はだか"],["で"],["母","はは"],["の"],["胎","たい"],["を"],["出た","でた"],["。"],["また"],["裸","はだか"],["で"],["かしこ"],["に"],["帰えろう","かえろう"],["。"],["主","しゅ"],["が"],["与","あたえ"],["、"],["主","しゅ"],["が"],["取られた","とられた"],["の"],["だ"],["。"],["主","しゅ"],["のみ"],["名","な"],["は"],["ほ"],["むべき"],["か"],["な"],["」"],["。"]]},{"verse":22,"text":"すべてこの事,ことにおいてヨブは罪,つみを犯,おかさず、また神,かみに向,むかって愚,おろかなことを言,いわなかった。","tok":[["すべて"],["この"],["事","こと"],["に"],["おいて"],["ヨブ"],["は"],["罪","つみ"],["を"],["犯さず","おかさず"],["、"],["また"],["神","かみ"],["に"],["向かって","むかって"],["愚か","おろか"],["な"],["こと"],["を"],["言わなかった","いわなかった"],["。"]]}]
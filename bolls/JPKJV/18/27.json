[{"verse":1,"text":"ヨブはまた言葉,ことばをついで言,いった、","tok":[["ヨブ"],["は"],["また"],["言葉","ことば"],["を"],["ついで"],["言った","いった"],["、"]]},{"verse":2,"text":"「神,かみは生,いきておられる。彼,かれはわたしの義,ぎを奪,うばい去,さられた。全能者,ぜんのうしゃはわたしの魂,たましいを悩,なやまされた。","tok":[["「"],["神","かみ"],["は"],["生きて","いきて"],["おられる"],["。"],["彼","かれ"],["は"],["わたし"],["の"],["義","ぎ"],["を"],["奪い去られた","うばいさられた"],["。"],["全能者","ぜんのうしゃ"],["は"],["わたし"],["の"],["魂","たましい"],["を"],["悩された","なやまされた"],["。"]]},{"verse":3,"text":"わたしの息,いきがわたしのうちにあり、神,かみの息,いきがわたしの鼻,はなにある間,あいだ、","tok":[["わたし"],["の"],["息","いき"],["が"],["わたし"],["の"],["うち"],["に"],["あり"],["、"],["神","かみ"],["の"],["息","いき"],["が"],["わたし"],["の"],["鼻","はな"],["に"],["ある"],["間","あ"],["い"],["だ"],["、"]]},{"verse":4,"text":"わたしのくちびるは不義,ふぎを言,いわない、わたしの舌,したは偽,いつわりを語,かたらない。","tok":[["わたし"],["の"],["くちびる"],["は"],["不義","ふぎ"],["を"],["言わない","いわない"],["、"],["わたし"],["の"],["舌","した"],["は"],["偽り","いつわり"],["を"],["語らない","かたらない"],["。"]]},{"verse":5,"text":"わたしは断,だんじて、あなたがたを正,ただしいとは認,みとめない。わたしは死,しぬまで、潔白,けっぱくを主張,しゅちょうしてやめない。","tok":[["わたし"],["は"],["断じて","だんじて"],["、"],["あなた"],["がた"],["を"],["正い","ただしい"],["と"],["は"],["認めない","みとめない"],["。"],["わたし"],["は"],["死ぬ","しぬ"],["まで"],["、"],["潔白","けっぱく"],["を"],["主張","しゅちょう"],["して"],["やめない"],["。"]]},{"verse":6,"text":"わたしは堅,かたくわが義,ぎを保,たもって捨,すてない。わたしは今,いままで一日,にちも心,こころに責,せめられた事,ことがない。","tok":[["わたし"],["は"],["堅く","かたく"],["わが"],["義","ぎ"],["を"],["保って","たもって"],["捨てない","すてない"],["。"],["わたし"],["は"],["今まで","いままで"],["一","いち"],["日","にち"],["も"],["心","こころ"],["に"],["責","せめ"],["られた"],["事","こと"],["が"],["ない"],["。"]]},{"verse":7,"text":"どうか、わたしの敵,てきは悪人,あくにんのようになり、わたしに逆,さからう者,ものは不義,ふぎなる者,もののようになるように。","tok":[["どう"],["か"],["、"],["わたし"],["の"],["敵","てき"],["は"],["悪人","あくにん"],["の"],["よう"],["に"],["なり"],["、"],["わたし"],["に"],["逆らう","さからう"],["者","もの"],["は"],["不義","ふぎ"],["なる"],["者","もの"],["の"],["よう"],["に"],["なる"],["よう"],["に"],["。"]]},{"verse":8,"text":"神,かみが彼,かれを断,たち、その魂,たましいを抜,ぬきとられるとき、神,かみを信,しんじない者,ものになんの望,のぞみがあろう。","tok":[["神","かみ"],["が"],["彼","かれ"],["を"],["断ち","たち"],["、"],["その"],["魂","たましい"],["を"],["抜きとられる","ぬきとられる"],["とき"],["、"],["神","かみ"],["を"],["信じない","しんじない"],["者","もの"],["に"],["なん"],["の"],["望み","のぞみ"],["が"],["あろう"],["。"]]},{"verse":9,"text":"災,わざわいが彼,かれに臨,のぞむとき、神,かみはその叫,さけびを聞,きかれるであろうか。","tok":[["災","わざわい"],["が"],["彼","かれ"],["に"],["臨む","のぞむ"],["とき"],["、"],["神","かみ"],["は"],["その"],["叫","さけび"],["を"],["聞かれるで","きかれるで"],["あろう"],["か"],["。"]]},{"verse":10,"text":"彼,かれは全能者,ぜんのうしゃを喜,よろこぶであろうか、常,つねに神,かみを呼,よぶであろうか。","tok":[["彼","かれ"],["は"],["全能者","ぜんのうしゃ"],["を"],["喜こぶで","よろこぶで"],["あろう"],["か"],["、"],["常","つね"],["に"],["神","かみ"],["を"],["呼ぶで","よぶで"],["あろう"],["か"],["。"]]},{"verse":11,"text":"わたしは神,かみのみ手,てについてあなたがたに教,おしえ、全能者,ぜんのうしゃと共,ともにあるものを隠,かくすことをしない。","tok":[["わたし"],["は"],["神","かみ"],["のみ"],["手","て"],["について"],["あなた"],["がた"],["に"],["教え","おしえ"],["、"],["全能者","ぜんのうしゃ"],["と"],["共","とも"],["に"],["ある"],["もの"],["を"],["隠す","かくす"],["こと"],["を"],["しない"],["。"]]},{"verse":12,"text":"見,みよ、あなたがたは皆,みなみずからこれを見,みた、それなのに、どうしてむなしい者,ものとなったのか。","tok":[["見よ","みよ"],["、"],["あなた"],["がた"],["は"],["皆","みな"],["みずから"],["これ"],["を"],["見た","みた"],["、"],["それ"],["な"],["のに"],["、"],["どう"],["して"],["むなしい"],["者","もの"],["と"],["なった"],["の"],["か"],["。"]]},{"verse":13,"text":"これは悪人,あくにんの神,かみから受,うける分,ぶん、圧制者,あっせいしゃの全能者,ぜんのうしゃから受,うける嗣,し業,ぎょうである。","tok":[["これ"],["は"],["悪人","あくにん"],["の"],["神","かみ"],["から"],["受ける","うける"],["分","ぶん"],["、"],["圧制者","あっせいしゃ"],["の"],["全能者","ぜんのうしゃ"],["から"],["受ける","うける"],["嗣業","しぎょ"],["うで"],["ある"],["。"]]},{"verse":14,"text":"その子,こらがふえればつるぎに渡,わたされ、その子孫,しそんは食物,しょくもつに飽,あきることがない。","tok":[["その"],["子","こ"],["ら"],["が"],["ふえれば"],["つるぎ"],["に"],["渡され","わたされ"],["、"],["その"],["子孫","しそん"],["は"],["食物","しょくもつ"],["に"],["飽きる","あきる"],["こと"],["が"],["ない"],["。"]]},{"verse":15,"text":"その生,いき残,のこった者,ものは疫病,えきびょうで死,しんで埋,うめられ、そのやもめらは泣,なき悲,かなしむことをしない。","tok":[["その"],["生き残った","いきのこった"],["者","もの"],["は"],["疫病","え"],["き"],["びょう"],["で"],["死んで","しんで"],["埋められ","うめられ"],["、"],["その"],["やもめ"],["ら"],["は"],["泣","なき"],["悲しむ","かなしむ"],["こと"],["を"],["しない"],["。"]]},{"verse":16,"text":"たとい彼,かれは銀,ぎんをちりのように積,つみ、衣服,いふくを土,つちのように備,そなえても、","tok":[["たとい"],["彼","かれ"],["は"],["銀","ぎん"],["を"],["ちり"],["の"],["よう"],["に"],["積み","つみ"],["、"],["衣服","いふく"],["を"],["土","つち"],["の"],["よう"],["に"],["備","そなえ"],["て"],["も"],["、"]]},{"verse":17,"text":"その備,そなえるものは正,ただしい人,ひとがこれを着,き、その銀,ぎんは罪,つみなき者,ものが分,わかち取,とるであろう。","tok":[["その"],["備","そなえ"],["る"],["もの"],["は"],["正い","ただしい"],["人","ひと"],["が"],["これ"],["を"],["着","き"],["、"],["その"],["銀","ぎん"],["は"],["罪","つみ"],["なき"],["者","もの"],["が"],["分かち","わかち"],["取るで","とるで"],["あろう"],["。"]]},{"verse":18,"text":"彼,かれの建,たてる家,いえは、くもの巣,すのようであり、番人,ばんにんの造,つくる小屋,こやのようである。","tok":[["彼","かれ"],["の"],["建てる","たてる"],["家","いえ"],["は"],["、"],["くも"],["の"],["巣","す"],["の"],["よう"],["で"],["あり"],["、"],["番人","ばんにん"],["の"],["造る","つくる"],["小屋","こや"],["の"],["よう"],["で"],["ある"],["。"]]},{"verse":19,"text":"彼,かれは富,とめる身,みで寝,ねても、再,ふたたび富,とむことがなく、目,めを開,ひらけばその富,とみはない。","tok":[["彼","かれ"],["は"],["富める","とめる"],["身","み"],["で"],["寝て","ねて"],["も"],["、"],["再び","ふたたび"],["富む","とむ"],["こと"],["が"],["なく"],["、"],["目","め"],["を"],["開ば","ひらけば"],["その"],["富","とみ"],["は"],["ない"],["。"]]},{"verse":20,"text":"恐,おそろしい事,ことが大水,おおみずのように彼,かれを襲,おそい、夜,よるはつむじ風,かぜが彼,かれを奪,うばい去,さる。","tok":[["恐ろしい","おそろしい"],["事","こと"],["が"],["大水","おおみず"],["の"],["よう"],["に"],["彼","かれ"],["を"],["襲い","おそい"],["、"],["夜","よる"],["は"],["つむじ風","つむじかぜ"],["が"],["彼","かれ"],["を"],["奪い去る","うばいさる"],["。"]]},{"verse":21,"text":"東風,ひがしかぜが彼,かれを揚,あげると、彼,かれは去,さり、彼,かれをその所,ところから吹,ふき払,はらう。","tok":[["東風","ひ"],["が"],["し"],["かぜ"],["が"],["彼","かれ"],["を"],["揚げる","あげる"],["と"],["、"],["彼","かれ"],["は"],["去り","さり"],["、"],["彼","かれ"],["を"],["その"],["所","ところ"],["から"],["吹払う","ふきはらう"],["。"]]},{"verse":22,"text":"それは彼,かれを投,なげつけて、あわれむことなく、彼,かれはその力,ちからからのがれようと、もがく。","tok":[["それ"],["は"],["彼","かれ"],["を"],["投","なげ"],["つけて"],["、"],["あわれむ"],["こと"],["なく"],["、"],["彼","かれ"],["は"],["その"],["力","ちから"],["から"],["のがれよう"],["と"],["、"],["もがく"],["。"]]},{"verse":23,"text":"それは彼,かれに向,むかって手,てを鳴,ならし、あざけり笑,わらって、その所,ところから出,でて行,いかせる。","tok":[["それ"],["は"],["彼","かれ"],["に"],["向かって","むかって"],["手","て"],["を"],["鳴らし","ならし"],["、"],["あざけり笑って","あざけりわらって"],["、"],["その"],["所","ところ"],["から"],["出て","でて"],["行かせる","いかせる"],["。"]]}]
[{"verse":1,"text":"その時,とき、テマンびとエリパズが答,こたえて言,いった、","tok":[["その"],["時","とき"],["、"],["テマン"],["び"],["と"],["エリパズ"],["が"],["答","こたえ"],["て"],["言った","いった"],["、"]]},{"verse":2,"text":"「もし人,ひとがあなたにむかって意見,いけんを述,のべるならば、あなたは腹,はらを立,たてるでしょうか。しかしだれが黙,だまっておれましょう。","tok":[["「"],["もし"],["人","ひと"],["が"],["あなた"],["に"],["むかって"],["意見","いけん"],["を"],["述べるならば","のべるならば"],["、"],["あなた"],["は"],["腹","はら"],["を"],["立るでしょう","たてるでしょう"],["か"],["。"],["しかし"],["だれ"],["が"],["黙って","だまって"],["おれましょう"],["。"]]},{"verse":3,"text":"見,みよ、あなたは多,おおくの人,ひとを教,おしえさとし、衰,おとろえた手,てを強,つよくした。","tok":[["見よ","みよ"],["、"],["あなた"],["は"],["多く","おおく"],["の"],["人","ひと"],["を"],["教えさとし","おしえさとし"],["、"],["衰えた","おとろえた"],["手","て"],["を"],["強く","つよく"],["した"],["。"]]},{"verse":4,"text":"あなたの言葉,ことばはつまずく者,ものをたすけ起,おこし、かよわいひざを強,つよくした。","tok":[["あなた"],["の"],["言葉","ことば"],["は"],["つまずく"],["者","もの"],["を"],["たすけ起こし","たすけおこし"],["、"],["かよわい"],["ひざ"],["を"],["強く","つよく"],["した"],["。"]]},{"verse":5,"text":"ところが今,いま、この事,ことがあなたに臨,のぞむと、あなたは耐,たえ得,えない。この事,ことがあなたに触,ふれると、あなたはおじ惑,まどう。","tok":[["ところ"],["が"],["今","いま"],["、"],["この"],["事","こと"],["が"],["あなた"],["に"],["臨む","のぞむ"],["と"],["、"],["あなた"],["は"],["耐え","たえ"],["得ない","えない"],["。"],["この"],["事","こと"],["が"],["あなた"],["に"],["触れる","ふれる"],["と"],["、"],["あなた"],["は"],["おじ"],["惑う","まどう"],["。"]]},{"verse":6,"text":"あなたが神,かみを恐,おそれていることは、あなたのよりどころではないか。あなたの道,みちの全,まったきことは、あなたの望,のぞみではないか。","tok":[["あなた"],["が"],["神","かみ"],["を"],["恐れて","おそれて"],["いる"],["こと"],["は"],["、"],["あなた"],["の"],["よりどころ"],["で"],["は"],["ない"],["か"],["。"],["あなた"],["の"],["道","みち"],["の"],["全","まったきこ"],["と"],["は"],["、"],["あなた"],["の"],["望み","のぞみ"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":7,"text":"考,かんがえてみよ、だれが罪,つみのないのに、滅,ほろぼされた者,ものがあるか。どこに正,ただしい者,もので、断,たち滅,ほろぼされた者,ものがあるか。","tok":[["考","かんがえ"],["て"],["みよ"],["、"],["だれ"],["が"],["罪","つみ"],["の"],["ない"],["のに"],["、"],["滅ぼされた","ほろぼされた"],["者","もの"],["が"],["ある"],["か"],["。"],["どこ"],["に"],["正い","ただしい"],["者","もの"],["で"],["、"],["断ち","たち"],["滅ぼされた","ほろぼされた"],["者","もの"],["が"],["ある"],["か"],["。"]]},{"verse":8,"text":"わたしの見,みた所,ところによれば、不義,ふぎを耕,たがやし、害悪,がいあくをまく者,ものは、それを刈,かり取,とっている。","tok":[["わたし"],["の"],["見た","みた"],["所","ところ"],["に"],["よれば"],["、"],["不義","ふぎ"],["を"],["耕やし","たがやし"],["、"],["害悪","がいあく"],["を"],["まく"],["者","もの"],["は"],["、"],["それ"],["を"],["刈取って","かりとって"],["いる"],["。"]]},{"verse":9,"text":"彼,かれらは神,かみのいぶきによって滅,ほろび、その怒,いかりの息,いきによって消,きえうせる。","tok":[["彼","かれ"],["ら"],["は"],["神","かみ"],["の"],["いぶき"],["によって"],["滅び","ほろび"],["、"],["その"],["怒り","いかり"],["の"],["息","いき"],["によって"],["消えうせる","きえうせる"],["。"]]},{"verse":10,"text":"ししのほえる声,こえ、たけきししの声,こえはともにやみ、若,わかきししのきばは折,おられ、","tok":[["しし"],["の"],["ほえる"],["声","こえ"],["、"],["たけき"],["しし"],["の"],["声","こえ"],["は"],["とも"],["に"],["やみ"],["、"],["若き","わかき"],["しし"],["の"],["きば"],["は"],["折られ","おられ"],["、"]]},{"verse":11,"text":"雄,おじしは獲物,えものを得,えずに滅,ほろび、雌,めじしの子,こは散,ちらされる。","tok":[["雄","おじし"],["は"],["獲物","えもの"],["を"],["得ず","えず"],["に"],["滅び","ほろび"],["、"],["雌","めじし"],["の"],["子","こ"],["は"],["散らされる","ちらされる"],["。"]]},{"verse":12,"text":"さて、わたしに、言葉,ことばがひそかに臨,のぞんだ、わたしの耳,みみはそのささやきを聞,きいた。","tok":[["さて"],["、"],["わたし"],["に"],["、"],["言葉","ことば"],["が"],["ひそか"],["に"],["臨んだ","のぞんだ"],["、"],["わたし"],["の"],["耳","みみ"],["は"],["その"],["ささやき"],["を"],["聞いた","きいた"],["。"]]},{"verse":13,"text":"すなわち人,ひとの熟睡,じゅくすいするころ、夜,よるの幻,まぼろしによって思,おもい乱,みだれている時,とき、","tok":[["すなわち"],["人","ひと"],["の"],["熟睡","じゅくすい"],["する"],["ころ"],["、"],["夜","よる"],["の"],["幻","まぼろし"],["によって"],["思い乱れて","おもいみだれて"],["いる"],["時","とき"],["、"]]},{"verse":14,"text":"恐,おそれがわたしに臨,のぞんだので、おののき、わたしの骨,ほねはことごとく震,ふるえた。","tok":[["恐","おそれ"],["が"],["わたし"],["に"],["臨","のぞんだ"],["ので"],["、"],["おののき"],["、"],["わたし"],["の"],["骨","ほね"],["は"],["ことごとく"],["震えた","ふるえた"],["。"]]},{"verse":15,"text":"時,ときに、霊,れいがあって、わたしの顔,かおの前,まえを過,すぎたので、わたしの身,みの毛,けはよだった。","tok":[["時","とき"],["に"],["、"],["霊","れい"],["が"],["あって"],["、"],["わたし"],["の"],["顔","かお"],["の"],["前","まえ"],["を"],["過た","すぎた"],["ので"],["、"],["わたし"],["の"],["身の毛","みのけ"],["は"],["よだった"],["。"]]},{"verse":16,"text":"そのものは立,たちどまったが、わたしはその姿,すがたを見,みわけることができなかった。一つのかたちが、わたしの目,めの前,まえにあった。わたしは静,しずかな声,こえを聞,きいた、","tok":[["その"],["もの"],["は"],["立ちどまった","たちどまった"],["が"],["、"],["わたし"],["は"],["その"],["姿","すがた"],["を"],["見わける","みわける"],["こと"],["が"],["できなかった"],["。"],["一","ひと"],["つ"],["の"],["かたち"],["が"],["、"],["わたし"],["の"],["目","め"],["の"],["前","まえ"],["に"],["あった"],["。"],["わたし"],["は"],["静","しずか"],["な"],["声","こえ"],["を"],["聞いた","きいた"],["、"]]},{"verse":17,"text":"『人,ひとは神,かみの前,まえに正,ただしくありえようか。人,ひとはその造,つくり主,ぬしの前,まえに清,きよくありえようか。","tok":[["『"],["人","ひと"],["は"],["神","かみ"],["の"],["前","まえ"],["に"],["正く","ただしく"],["あり"],["えよう"],["か"],["。"],["人","ひと"],["は"],["その"],["造主","つくりぬし"],["の"],["前","まえ"],["に"],["清く","きよく"],["あり"],["えよう"],["か"],["。"]]},{"verse":18,"text":"見,みよ、彼,かれはそのしもべをさえ頼,たのみとせず、その天使,てんしをも誤,あやまれる者,ものとみなされる。","tok":[["見よ","みよ"],["、"],["彼","かれ"],["は"],["その"],["しもべ"],["を"],["さえ"],["頼み","たのみ"],["と"],["せず"],["、"],["その"],["天使","てんし"],["を"],["も"],["誤れる","あやまれる"],["者","もの"],["と"],["みなされる"],["。"]]},{"verse":19,"text":"まして、泥,どろの家,いえに住,すむ者,もの、ちりをその基,もといとする者,もの、しみのようにつぶされる者,もの。","tok":[["まして"],["、"],["泥","どろ"],["の"],["家","いえ"],["に"],["住む","すむ"],["者","もの"],["、"],["ちり"],["を"],["その"],["基い","もとい"],["と"],["する"],["者","もの"],["、"],["しみ"],["の"],["よう"],["に"],["つぶされる"],["者","もの"],["。"]]},{"verse":20,"text":"彼,かれらは朝,あさから夕,ゆうまでの間,あいだに打,うち砕,くだかれ、顧,かえりみる者,ものもなく、永遠,えいえんに滅,ほろびる。","tok":[["彼","かれ"],["ら"],["は"],["朝","あさ"],["から"],["夕","ゆう"],["まで"],["の"],["間","あいだ"],["に"],["打ち砕かれ","うちくだかれ"],["、"],["顧りみる","かえりみる"],["者","もの"],["も"],["なく"],["、"],["永遠","えいえん"],["に"],["滅びる","ほろびる"],["。"]]},{"verse":21,"text":"もしその天幕,てんまくの綱,つなが彼,かれらのうちに取,とり去,さられるなら、ついに悟,さとることもなく、死,しにうせるではないか』。","tok":[["もし"],["その"],["天幕","てんまく"],["の"],["綱","つな"],["が"],["彼","かれ"],["ら"],["の"],["うち"],["に"],["取去られるなら","とりさられるなら"],["、"],["ついに"],["悟","さとる"],["こと"],["も"],["なく"],["、"],["死","し"],["に"],["うせるで"],["は"],["ない"],["か"],["』"],["。"]]}]
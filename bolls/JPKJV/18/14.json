[{"verse":1,"text":"女,おんなから生,うまれる人,ひとは日,ひが短,みじかく、悩,なやみに満,みちている。","tok":[["女","おんな"],["から"],["生まれる","うまれる"],["人","ひと"],["は"],["日","ひ"],["が"],["短かく","みじかく"],["、"],["悩み","なやみ"],["に"],["満ちて","みちて"],["いる"],["。"]]},{"verse":2,"text":"彼,かれは花,はなのように咲,さき出,でて枯,かれ、影,かげのように飛,とび去,さって、とどまらない。","tok":[["彼","かれ"],["は"],["花","はな"],["の"],["よう"],["に"],["咲","さき"],["出て","でて"],["枯","かれ"],["、"],["影","かげ"],["の"],["よう"],["に"],["飛び","とび"],["去て","さって"],["、"],["とどまらない"],["。"]]},{"verse":3,"text":"あなたはこのような者,ものにさえ目,めを開,ひらき、あなたの前,まえに引,ひき出,だして、さばかれるであろうか。","tok":[["あなた"],["は"],["この"],["よう"],["な"],["者","もの"],["に"],["さえ"],["目","め"],["を"],["開らき","ひらき"],["、"],["あなた"],["の"],["前","まえ"],["に"],["引出して","ひきだして"],["、"],["さばかれるで"],["あろう"],["か"],["。"]]},{"verse":4,"text":"だれが汚,けがれたもののうちから清,きよいものを出,だすことができようか、ひとりもない。","tok":[["だれ"],["が"],["汚","けがれたも"],["の"],["の"],["うち"],["から"],["清い","きよい"],["もの"],["を"],["出す","だす"],["こと"],["が"],["できよう"],["か"],["、"],["ひとり"],["も"],["ない"],["。"]]},{"verse":5,"text":"その日,ひは定,さだめられ、その月,つきの数,かずもあなたと共,ともにあり、あなたがその限,かぎりを定,さだめて、越,こえることのできないようにされたのだから、","tok":[["その"],["日","ひ"],["は"],["定められ","さだめられ"],["、"],["その"],["月","つき"],["の"],["数","かず"],["も"],["あなた"],["と"],["共","とも"],["に"],["あり"],["、"],["あなた"],["が"],["その"],["限","かぎり"],["を"],["定めて","さだめて"],["、"],["越える","こえる"],["こと"],["の"],["できない"],["よう"],["に"],["された"],["の"],["だ"],["から"],["、"]]},{"verse":6,"text":"彼,かれから目,めをはなし、手,てをひいてください。そうすれば彼,かれは雇人,やといにんのように、その日,ひを楽,たのしむことができるでしょう。","tok":[["彼","かれ"],["から"],["目","め"],["を"],["はなし"],["、"],["手","て"],["を"],["ひいて"],["ください"],["。"],["そう"],["すれば"],["彼","かれ"],["は"],["雇人","やといにん"],["の"],["よう"],["に"],["、"],["その"],["日","ひ"],["を"],["楽しむ","たのしむ"],["こと"],["が"],["できるでしょう"],["。"]]},{"verse":7,"text":"木,きには望,のぞみがある。たとい切,きられてもまた芽,めをだし、その若,わか枝,えだは絶,たえることがない。","tok":[["木","き"],["に"],["は"],["望み","のぞみ"],["が"],["ある"],["。"],["たとい"],["切られて","きられて"],["も"],["また"],["芽","め"],["を"],["だし"],["、"],["その"],["若枝","わかえだ"],["は"],["絶える","たえる"],["こと"],["が"],["ない"],["。"]]},{"verse":8,"text":"たといその根,ねが地,ちの中,なかに老,おい、その幹,みきが土,つちの中,なかに枯,かれても、","tok":[["たとい"],["その"],["根","ね"],["が"],["地","ち"],["の"],["中","なか"],["に"],["老","おい"],["、"],["その"],["幹","みき"],["が"],["土","つち"],["の"],["中","なか"],["に"],["枯て","かれて"],["も"],["、"]]},{"verse":9,"text":"なお水,みずの潤,うるおいにあえば芽,めをふき、若木,わかぎのように枝,えだを出,だす。","tok":[["なお"],["水","みず"],["の"],["潤い","うるおい"],["に"],["あえば"],["芽","め"],["を"],["ふき"],["、"],["若木","わかぎ"],["の"],["よう"],["に"],["枝","えだ"],["を"],["出す","だす"],["。"]]},{"verse":10,"text":"しかし人,ひとは死,しねば消,きえうせる。息,いきが絶,たえれば、どこにおるか。","tok":[["しかし"],["人","ひと"],["は"],["死ねば","しねば"],["消えうせる","きえうせる"],["。"],["息","いき"],["が"],["絶えれば","たえれば"],["、"],["どこ"],["に"],["おる"],["か"],["。"]]},{"verse":11,"text":"水,みずが湖,みずうみから消,きえ、川,かわがかれて、かわくように、","tok":[["水","みず"],["が"],["湖","みずうみ"],["から"],["消え","きえ"],["、"],["川","かわ"],["が"],["かれて"],["、"],["かわく"],["よう"],["に"],["、"]]},{"verse":12,"text":"人,ひとは伏,ふして寝,ね、また起,おきず、天,てんのつきるまで、目,めざめず、その眠,ねむりからさまされない。","tok":[["人","ひと"],["は"],["伏して","ふして"],["寝","ね"],["、"],["また"],["起きず","おきず"],["、"],["天","てん"],["の"],["つきる"],["まで"],["、"],["目ざめず","めざめず"],["、"],["その"],["眠","ねむり"],["から"],["さまされない"],["。"]]},{"verse":13,"text":"どうぞ、わたしを陰府,よみにかくし、あなたの怒,いかりのやむまで、潜,ひそませ、わたしのために時,ときを定,さだめて、わたしを覚,おぼえてください。","tok":[["どうぞ"],["、"],["わたし"],["を"],["陰府","よみ"],["に"],["かくし"],["、"],["あなた"],["の"],["怒り","いかり"],["の"],["やむ"],["まで"],["、"],["潜ませ","ひそませ"],["、"],["わたし"],["の"],["ため"],["に"],["時","とき"],["を"],["定めて","さだめて"],["、"],["わたし"],["を"],["覚えて","おぼえて"],["ください"],["。"]]},{"verse":14,"text":"人,ひとがもし死,しねば、また生,いきるでしょうか。わたしはわが服役,ふくえきの諸,しょ日,にちの間,あいだ、わが解放,かいほうの来,くるまで待,まつでしょう。","tok":[["人","ひと"],["が"],["もし"],["死ねば","しねば"],["、"],["また"],["生きるでしょう","いきるでしょう"],["か"],["。"],["わたし"],["は"],["わが"],["服役","ふくえき"],["の"],["諸","しょ"],["日","にち"],["の"],["間","あいだ"],["、"],["わが"],["解放","かいほう"],["の"],["来る","くる"],["まで"],["待つでしょう","まつでしょう"],["。"]]},{"verse":15,"text":"あなたがお呼,およびになるとき、わたしは答,こたえるでしょう。あなたはみ手,てのわざを顧,かえりみられるでしょう。","tok":[["あなた"],["が"],["お呼","おおよび"],["に"],["なる"],["とき"],["、"],["わたし"],["は"],["答","こたえ"],["るでしょう"],["。"],["あなた"],["は"],["み手","みて"],["の"],["わざ"],["を"],["顧られるでしょう","かえりみられるでしょう"],["。"]]},{"verse":16,"text":"その時,ときあなたはわたしの歩,あゆみを数,かぞえ、わたしの罪,つみを見,みのがされるでしょう。","tok":[["その"],["時","とき"],["あなた"],["は"],["わたし"],["の"],["歩み","あゆみ"],["を"],["数え","かぞえ"],["、"],["わたし"],["の"],["罪","つみ"],["を"],["見のがされるでしょう","みのがされるでしょう"],["。"]]},{"verse":17,"text":"わたしのとがは袋,ふくろの中,なかに封,ふうじられ、あなたはわたしの罪,つみを塗,ぬりかくされるでしょう。","tok":[["わたし"],["の"],["とが"],["は"],["袋","ふくろ"],["の"],["中","なか"],["に"],["封じられ","ふうじられ"],["、"],["あなた"],["は"],["わたし"],["の"],["罪","つみ"],["を"],["塗","ぬり"],["かくされるでしょう"],["。"]]},{"verse":18,"text":"しかし山,やまは倒,たおれてくずれ、岩,いわもその所,ところから移,うつされる。","tok":[["しかし"],["山","やま"],["は"],["倒れて","たおれて"],["くずれ"],["、"],["岩","いわ"],["も"],["その"],["所","ところ"],["から"],["移される","うつされる"],["。"]]},{"verse":19,"text":"水,みずは石,いしをうがち、大水,おおみずは地,ちのちりを洗,あらい去,さる。このようにあなたは人,ひとの望,のぞみを断,たたれる。","tok":[["水","みず"],["は"],["石","いし"],["を"],["うがち"],["、"],["大水","おおみず"],["は"],["地","ち"],["の"],["ちり"],["を"],["洗","あらい"],["去る","さる"],["。"],["この"],["よう"],["に"],["あなた"],["は"],["人","ひと"],["の"],["望み","のぞみ"],["を"],["断たれる","たたれる"],["。"]]},{"verse":20,"text":"あなたはながく彼,かれに勝,かって、彼,かれを去,さり行,いかせ、彼,かれの顔,かおかたちを変,かわらせて追,おいやられる。","tok":[["あなた"],["は"],["ながく"],["彼","かれ"],["に"],["勝って","かって"],["、"],["彼","かれ"],["を"],["去り行かせ","さりいかせ"],["、"],["彼","かれ"],["の"],["顔かたち","かおかたち"],["を"],["変わらせて","かわらせて"],["追いやられる","おいやられる"],["。"]]},{"verse":21,"text":"彼,かれの子,こらは尊,たっとくなっても、彼,かれはそれを知,しらない、卑,いやしくなっても、それを悟,さとらない。","tok":[["彼","かれ"],["の"],["子","こ"],["ら"],["は"],["尊","た"],["っと"],["く"],["なって"],["も"],["、"],["彼","かれ"],["は"],["それ"],["を"],["知らない","しらない"],["、"],["卑しく","いやしく"],["なって"],["も"],["、"],["それ"],["を"],["悟らない","さとらない"],["。"]]},{"verse":22,"text":"ただおのが身,みに痛,いたみを覚,おぼえ、おのれのために嘆,なげくのみである」。","tok":[["ただ"],["お"],["の"],["が"],["身","み"],["に"],["痛み","いたみ"],["を"],["覚え","おぼえ"],["、"],["おのれ"],["の"],["ため"],["に"],["嘆く","なげく"],["のみ"],["で"],["ある"],["」"],["。"]]}]
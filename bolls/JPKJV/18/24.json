[{"verse":1,"text":"なにゆえ、全能者,ぜんのうしゃはさばきの時,ときを定,さだめておかれないのか。なにゆえ、彼,かれを知,しる者,ものがその日,ひを見,みないのか。","tok":[["なにゆえ"],["、"],["全能者","ぜんのうしゃ"],["は"],["さばき"],["の"],["時","とき"],["を"],["定めて","さだめて"],["おかれない"],["の"],["か"],["。"],["なにゆえ"],["、"],["彼","かれ"],["を"],["知る","しる"],["者","もの"],["が"],["その"],["日","ひ"],["を"],["見ない","みない"],["の"],["か"],["。"]]},{"verse":2,"text":"世,よには地境,じざかいを移,うつす者,もの、群,むれを奪,うばってそれを飼,かう者,もの、","tok":[["世","よ"],["に"],["は"],["地境","じざかい"],["を"],["移す","うつす"],["者","もの"],["、"],["群れ","むれ"],["を"],["奪って","うばって"],["それ"],["を"],["飼う","かう"],["者","もの"],["、"]]},{"verse":3,"text":"みなしごのろばを追,おいやる者,もの、やもめの牛,うしを質,しちに取,とる者,もの、","tok":[["みなしご"],["の"],["ろば"],["を"],["追いやる","おいやる"],["者","もの"],["、"],["やもめ"],["の"],["牛","うし"],["を"],["質","しち"],["に"],["取る","とる"],["者","もの"],["、"]]},{"verse":4,"text":"貧,まずしい者,ものを道,みちから押,おしのける者,ものがある。世,よの弱,よわい者,ものは皆,みな彼,かれらをさけて身,みをかくす。","tok":[["貧しい","まずしい"],["者","もの"],["を"],["道","みち"],["から"],["押","おし"],["の"],["ける"],["者","もの"],["が"],["ある"],["。"],["世","よ"],["の"],["弱い","よわい"],["者","もの"],["は"],["皆","みな"],["彼","かれ"],["ら"],["を"],["さけて"],["身","み"],["を"],["かくす"],["。"]]},{"verse":5,"text":"見,みよ、彼,かれらは荒野,あらのにおる野,のろばのように出,でて働,はたらき、野,ので獲物,えものを求,もとめて、その子,こらの食物,しょくもつとする。","tok":[["見よ","みよ"],["、"],["彼","かれ"],["ら"],["は"],["荒野","あら"],["のに"],["おる"],["野","の"],["ろば"],["の"],["よう"],["に"],["出て","でて"],["働らき","はたらき"],["、"],["野","の"],["で"],["獲物","えもの"],["を"],["求めて","もとめて"],["、"],["その"],["子","こ"],["ら"],["の"],["食物","しょくもつ"],["と"],["する"],["。"]]},{"verse":6,"text":"彼,かれらは畑,はたけでそのまぐさを刈,かり、また悪人,あくにんのぶどう畑,はたけで拾,ひろい集,あつめる。","tok":[["彼","かれ"],["ら"],["は"],["畑","はたけ"],["で"],["その"],["まぐさ"],["を"],["刈","かり"],["、"],["また"],["悪人","あくにん"],["の"],["ぶどう"],["畑","はたけ"],["で"],["拾い集める","ひろいあつめる"],["。"]]},{"verse":7,"text":"彼,かれらは着,きる物,ものがなく、裸,はだかで夜,よるを過,すごし、寒,さむさに身,みをおおうべき物,ものもない。","tok":[["彼","かれ"],["ら"],["は"],["着る","きる"],["物","もの"],["が"],["なく"],["、"],["裸","はだか"],["で"],["夜","よる"],["を"],["過ごし","すごし"],["、"],["寒さ","さむさ"],["に"],["身","み"],["を"],["おおうべき"],["物","もの"],["も"],["ない"],["。"]]},{"verse":8,"text":"彼,かれらは山,やまの雨,あめにぬれ、しのぎ場,ばもなく岩,いわにすがる。","tok":[["彼","かれ"],["ら"],["は"],["山","やま"],["の"],["雨","あめ"],["に"],["ぬれ"],["、"],["しのぎ"],["場","ば"],["も"],["なく"],["岩","いわ"],["に"],["すがる"],["。"]]},{"verse":9,"text":"（みなしごをその母,ははのふところから奪,うばい、貧,まずしい者,ものの幼,おさな子,こを質,しちにとる者,ものがある。）","tok":[["（"],["みなしご"],["を"],["その"],["母","はは"],["の"],["ふところ"],["から"],["奪い","うばい"],["、"],["貧しい","まずしい"],["者","もの"],["の"],["幼な子","おさなこ"],["を"],["質","しち"],["に"],["とる"],["者","もの"],["が"],["ある"],["。"],["）"]]},{"verse":10,"text":"彼,かれらは着,きる物,ものがなく、裸,はだかで歩,あるき、飢,うえつつ麦,むぎ束,たばを運,はこび、","tok":[["彼","かれ"],["ら"],["は"],["着る","きる"],["物","もの"],["が"],["なく"],["、"],["裸","はだか"],["で"],["歩き","あるき"],["、"],["飢","うえ"],["つつ"],["麦","むぎ"],["束","たば"],["を"],["運こび","はこび"],["、"]]},{"verse":11,"text":"悪人,あくにんのオリブ並み木,きの中,なかで油,あぶらをしぼり、酒,さかぶねを踏,ふんでも、かわきを覚,おぼえる。","tok":[["悪人","あくにん"],["の"],["オリブ"],["並み","なみ"],["木","き"],["の"],["中","なか"],["で"],["油","あぶら"],["を"],["しぼり"],["、"],["酒","さかぶね"],["を"],["踏","ふん"],["で"],["も"],["、"],["かわき"],["を"],["覚える","おぼえる"],["。"]]},{"verse":12,"text":"町,まちの中,なかから死,しのうめきが起,おこり、傷,きずついた者,ものの魂,たましいが助,たすけを呼,よび求,もとめる。しかし神,かみは彼,かれらの祈,いのりを顧,かえりみられない。","tok":[["町","まち"],["の"],["中","なか"],["から"],["死","し"],["の"],["うめき"],["が"],["起こり","おこり"],["、"],["傷ついた","きずついた"],["者","もの"],["の"],["魂","たましい"],["が"],["助け","たすけ"],["を"],["呼び求める","よびもとめる"],["。"],["しかし"],["神","かみ"],["は"],["彼","かれ"],["ら"],["の"],["祈","いのり"],["を"],["顧られない","かえりみられない"],["。"]]},{"verse":13,"text":"光,ひかりにそむく者,ものたちがある。彼,かれらは光,ひかりの道,みちを知,しらず、光,ひかりの道,みちにとどまらない。","tok":[["光","ひかり"],["に"],["そむく"],["者","もの"],["たち"],["が"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["光","ひかり"],["の"],["道","みち"],["を"],["知らず","しらず"],["、"],["光","ひかり"],["の"],["道","みち"],["に"],["とどまらない"],["。"]]},{"verse":14,"text":"人,ひとを殺,ころす者,ものは暗,くらいうちに起,おき出,でて弱,よわい者,ものと貧,まずしい者,ものを殺,ころし、夜,よるは盗,ぬすびととなる。","tok":[["人","ひと"],["を"],["殺ろす","ころす"],["者","もの"],["は"],["暗い","くらい"],["うち"],["に"],["起き出て","おきでて"],["弱い","よわい"],["者","もの"],["と"],["貧しい","まずしい"],["者","もの"],["を"],["殺ろし","ころし"],["、"],["夜","よる"],["は"],["盗","ぬすび"],["と"],["と"],["なる"],["。"]]},{"verse":15,"text":"姦淫,かんいんする者,ものの目,めはたそがれを待,まって、『だれもわたしを見,みていないだろう』と言,いい、顔,かおにおおう物,ものを当,あてる。","tok":[["姦淫","かんいん"],["する"],["者","もの"],["の"],["目","め"],["は"],["たそがれ"],["を"],["待って","まって"],["、"],["『"],["だれ"],["も"],["わたし"],["を"],["見て","みて"],["いないだろう"],["』"],["と"],["言い","いい"],["、"],["顔","かお"],["に"],["おおう"],["物","もの"],["を"],["当てる","あてる"],["。"]]},{"verse":16,"text":"彼,かれらは暗,くらやみで家,いえをうがち、昼,ひるは閉,とじこもって光,ひかりを知,しらない。","tok":[["彼","かれ"],["ら"],["は"],["暗やみ","くらやみ"],["で"],["家","いえ"],["を"],["うがち"],["、"],["昼","ひる"],["は"],["閉じこもって","とじこもって"],["光","ひかり"],["を"],["知らない","しらない"],["。"]]},{"verse":17,"text":"彼,かれらには暗黒,あんこくは朝,あさである。彼,かれらは暗黒,あんこくの恐,おそれを友,ともとするからだ。","tok":[["彼","かれ"],["ら"],["に"],["は"],["暗黒","あんこく"],["は"],["朝","あさ"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["暗黒","あんこく"],["の"],["恐","おそれ"],["を"],["友","とも"],["と"],["する"],["から"],["だ"],["。"]]},{"verse":18,"text":"あなたがたは言,いう、『彼,かれらは水,みずのおもてにすみやかに流,ながれ去,さり、その受,うける分,ぶんは地,ちでのろわれ、酒,さかぶねを踏,ふむ者,ものはだれも彼,かれらのぶどう畑,はたけの道,みちに行,いかない。","tok":[["あなた"],["がた"],["は"],["言う","いう"],["、"],["『"],["彼","かれ"],["ら"],["は"],["水","みず"],["の"],["おもて"],["に"],["すみやか"],["に"],["流れ去り","ながれさり"],["、"],["その"],["受ける","うける"],["分","ぶん"],["は"],["地","ち"],["で"],["のろわれ"],["、"],["酒","さかぶね"],["を"],["踏む","ふむ"],["者","もの"],["は"],["だれ"],["も"],["彼","かれ"],["ら"],["の"],["ぶどう"],["畑","はたけ"],["の"],["道","みち"],["に"],["行かない","いかない"],["。"]]},{"verse":19,"text":"ひでりと熱,あつさは雪,ゆき水,みずを奪,うばい去,さる、陰府,よみが罪,つみを犯,おかした者,ものに対,たいするも、これと同様,どうようだ。","tok":[["ひでり"],["と"],["熱","あつ"],["さ"],["は"],["雪水","ゆきみず"],["を"],["奪い去る","うばいさる"],["、"],["陰府","よみ"],["が"],["罪","つみ"],["を"],["犯した","おかした"],["者","もの"],["に"],["対する","たいする"],["も"],["、"],["これ"],["と"],["同様","どうよう"],["だ"],["。"]]},{"verse":20,"text":"町,まちの広場,ひろばは彼,かれらを忘,わすれ、彼,かれらの名,なは覚,おぼえられることなく、不義,ふぎは木,きの折,おられるように折,おられる』と。","tok":[["町","まち"],["の"],["広場","ひろば"],["は"],["彼","かれ"],["ら"],["を"],["忘","わすれ"],["、"],["彼","かれ"],["ら"],["の"],["名","な"],["は"],["覚えられる","おぼえられる"],["こと"],["なく"],["、"],["不義","ふぎ"],["は"],["木","き"],["の"],["折られる","おられる"],["よう"],["に"],["折られる","おられる"],["』"],["と"],["。"]]},{"verse":21,"text":"彼,かれらは子,こを産,うまぬうまずめをくらい、やもめをあわれむことをしない。","tok":[["彼","かれ"],["ら"],["は"],["子","こ"],["を"],["産まぬ","うまぬ"],["うまずめ"],["を"],["くらい"],["、"],["やもめ"],["を"],["あわれむ"],["こと"],["を"],["しない"],["。"]]},{"verse":22,"text":"しかし神,かみはその力,ちからをもって、強,つよい人々,ひとびとを生,いきながらえさせられる。彼,かれらは生,いきる望,のぞみのない時,ときにも起,おきあがる。","tok":[["しかし"],["神","かみ"],["は"],["その"],["力","ちから"],["を"],["もって"],["、"],["強い","つよい"],["人々","ひとびと"],["を"],["生きながらえさせられる","いきながらえさせられる"],["。"],["彼","かれ"],["ら"],["は"],["生きる","いきる"],["望み","のぞみ"],["の"],["ない"],["時","とき"],["に"],["も"],["起きあがる","おきあがる"],["。"]]},{"verse":23,"text":"神,かみが彼,かれらに安全,あんぜんを与,あたえられるので、彼,かれらは安,やすらかである。神,かみの目,めは彼,かれらの道,みちの上,うえにある。","tok":[["神","かみ"],["が"],["彼","かれ"],["ら"],["に"],["安全","あんぜん"],["を"],["与えられる","あたえられる"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["安らか","やすらか"],["で"],["ある"],["。"],["神","かみ"],["の"],["目","め"],["は"],["彼","かれ"],["ら"],["の"],["道","みち"],["の"],["上","うえ"],["に"],["ある"],["。"]]},{"verse":24,"text":"彼,かれらはしばし高,たかめられて、いなくなり、ぜにあおいのように枯,かれて消,きえうせ、麦,むぎの穂先,ほさきのように切,きり取,とられる。","tok":[["彼","かれ"],["ら"],["は"],["しばし"],["高められて","たかめられて"],["、"],["いなく"],["なり"],["、"],["ぜに"],["あおい"],["の"],["よう"],["に"],["枯て","かれて"],["消えうせ","きえうせ"],["、"],["麦","むぎ"],["の"],["穂先","ほさき"],["の"],["よう"],["に"],["切り取られる","きりとられる"],["。"]]},{"verse":25,"text":"もし、そうでないなら、だれがわたしにその偽,いつわりを証明,しょうめいし、わが言葉,ことばのむなしいことを示,しめしうるだろうか」。","tok":[["もし"],["、"],["そう"],["で"],["ないなら"],["、"],["だれ"],["が"],["わたし"],["に"],["その"],["偽り","いつわり"],["を"],["証明","しょうめい"],["し"],["、"],["わが"],["言葉","ことば"],["の"],["むなしい"],["こと"],["を"],["示めし","しめし"],["うるだろう"],["か"],["」"],["。"]]}]
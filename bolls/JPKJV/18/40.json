[{"verse":1,"text":"主,しゅはまたヨブに答,こたえて言,いわれた、","tok":[["主","しゅ"],["は"],["また"],["ヨブ"],["に"],["答","こたえ"],["て"],["言われた","いわれた"],["、"]]},{"verse":2,"text":"「非難,ひなんする者,ものが全能者,ぜんのうしゃと争,あらそおうとするのか、神,かみと論,ろんずる者,ものはこれに答,こたえよ」。","tok":[["「"],["非難","ひなん"],["する"],["者","もの"],["が"],["全能者","ぜんのうしゃ"],["と"],["争おう","あらそおう"],["と"],["する"],["の"],["か"],["、"],["神","かみ"],["と"],["論ずる","ろんずる"],["者","もの"],["は"],["これ"],["に"],["答","こたえ"],["よ"],["」"],["。"]]},{"verse":3,"text":"そこで、ヨブは主,しゅに答,こたえて言,いった、","tok":[["そこ"],["で"],["、"],["ヨブ"],["は"],["主に","しゅに"],["答","こたえ"],["て"],["言った","いった"],["、"]]},{"verse":4,"text":"「見,みよ、わたしはまことに卑,いやしい者,ものです、なんとあなたに答,こたえましょうか。ただ手,てを口,くちに当,あてるのみです。","tok":[["「"],["見よ","みよ"],["、"],["わたし"],["は"],["まこと"],["に"],["卑しい","いやしい"],["者","もの"],["です"],["、"],["なん"],["と"],["あなた"],["に"],["答","こたえ"],["ましょう"],["か"],["。"],["ただ"],["手","て"],["を"],["口","くち"],["に"],["当てる","あてる"],["のみ"],["です"],["。"]]},{"verse":5,"text":"わたしはすでに一度,ど言,いいました、また言,いいません、すでに二度,ど言,いいました、重,かさねて申,もうしません」。","tok":[["わたし"],["は"],["すでに"],["一度","ど"],["言いました","いいました"],["、"],["また"],["言いません","いいません"],["、"],["すでに"],["二","に"],["度","ど"],["言いました","いいました"],["、"],["重ねて","かさねて"],["申しません","もうしません"],["」"],["。"]]},{"verse":6,"text":"主,しゅはまたつむじ風,かぜの中,なかからヨブに答,こたえられた、","tok":[["主","しゅ"],["は"],["また"],["つむじ風","つむじかぜ"],["の"],["中","なか"],["から"],["ヨブ"],["に"],["答","こたえ"],["られた"],["、"]]},{"verse":7,"text":"「あなたは腰,こしに帯,おびして、男,おとこらしくせよ。わたしはあなたに尋,たずねる、わたしに答,こたえよ。","tok":[["「"],["あなた"],["は"],["腰","こし"],["に"],["帯び","おび"],["して"],["、"],["男","おとこ"],["らしく"],["せよ"],["。"],["わたし"],["は"],["あなた"],["に"],["尋ねる","たずねる"],["、"],["わたし"],["に"],["答","こたえ"],["よ"],["。"]]},{"verse":8,"text":"あなたはなお、わたしに責任,せきにんを負,おわそうとするのか。あなたはわたしを非,ひとし、自分,じぶんを是,ぜとしようとするのか。","tok":[["あなた"],["は"],["なお"],["、"],["わたし"],["に"],["責任","せきにん"],["を"],["負わそう","おわそう"],["と"],["する"],["の"],["か"],["。"],["あなた"],["は"],["わたし"],["を"],["非","ひ"],["と"],["し"],["、"],["自分","じぶん"],["を"],["是","ぜ"],["と"],["しよう"],["と"],["する"],["の"],["か"],["。"]]},{"verse":9,"text":"あなたは神,かみのような腕,うでを持,もっているのか、神,かみのような声,こえでとどろきわたることができるか。","tok":[["あなた"],["は"],["神","かみ"],["の"],["よう"],["な"],["腕","うで"],["を"],["持って","もって"],["いる"],["の"],["か"],["、"],["神","かみ"],["の"],["よう"],["な"],["声","こえ"],["で"],["とどろき"],["わたる"],["こと"],["が"],["できる"],["か"],["。"]]},{"verse":10,"text":"あなたは威光,いこうと尊厳,そんげんとをもってその身,みを飾,かざり、栄光,えいこうと華麗,かれいとをもってその身,みを装,よそおってみよ。","tok":[["あなた"],["は"],["威光","いこう"],["と"],["尊厳","そんげん"],["と"],["を"],["もって"],["その"],["身","み"],["を"],["飾","かざり"],["、"],["栄光","えいこう"],["と"],["華麗","かれい"],["と"],["を"],["もって"],["その"],["身","み"],["を"],["装って","よそおって"],["み"],["よ"],["。"]]},{"verse":11,"text":"あなたのあふるる怒,いかりを漏,もらし、すべての高,たかぶる者,ものを見,みて、これを低,ひくくせよ。","tok":[["あなた"],["の"],["あふるる"],["怒り","いかり"],["を"],["漏らし","もらし"],["、"],["すべて"],["の"],["高ぶる","たかぶる"],["者","もの"],["を"],["見て","みて"],["、"],["これ"],["を"],["低く","ひくく"],["せよ"],["。"]]},{"verse":12,"text":"すべての高,たかぶる者,ものを見,みて、これをかがませ、また悪人,あくにんをその所,ところで踏,ふみつけ、","tok":[["すべて"],["の"],["高ぶる","たかぶる"],["者","もの"],["を"],["見て","みて"],["、"],["これ"],["を"],["かがませ"],["、"],["また"],["悪人","あくにん"],["を"],["その"],["所","ところ"],["で"],["踏みつけ","ふみつけ"],["、"]]},{"verse":13,"text":"彼,かれらをともにちりの中,なかにうずめ、その顔,かおを隠,かくれた所,ところに閉,とじこめよ。","tok":[["彼","かれ"],["ら"],["を"],["とも"],["に"],["ちり"],["の"],["中","なか"],["に"],["うずめ"],["、"],["その"],["顔","かお"],["を"],["隠れた","かくれた"],["所","ところ"],["に"],["閉じこめよ","とじこめよ"],["。"]]},{"verse":14,"text":"そうすれば、わたしもまた、あなたをほめて、あなたの右,みぎの手,てはあなたを救,すくうことができるとしよう。","tok":[["そう"],["すれば"],["、"],["わたし"],["も"],["また"],["、"],["あなた"],["を"],["ほめて"],["、"],["あなた"],["の"],["右","みぎ"],["の"],["手","て"],["は"],["あなた"],["を"],["救う","すくう"],["こと"],["が"],["できる"],["と"],["しよう"],["。"]]},{"verse":15,"text":"河馬,かばを見,みよ、これはあなたと同様,どうようにわたしが造,つくったもので、牛,うしのように草,くさを食,くう。","tok":[["河馬","かば"],["を"],["見よ","みよ"],["、"],["これ"],["は"],["あなた"],["と"],["同様","どうよう"],["に"],["わたし"],["が"],["造った","つくった"],["もの"],["で"],["、"],["牛","うし"],["の"],["よう"],["に"],["草","くさ"],["を"],["食う","くう"],["。"]]},{"verse":16,"text":"見,みよ、その力,ちからは腰,こしにあり、その勢,いきおいは腹,はらの筋,すじにある。","tok":[["見よ","みよ"],["、"],["その"],["力","ちから"],["は"],["腰","こし"],["に"],["あり"],["、"],["その"],["勢い","いきおい"],["は"],["腹","はら"],["の"],["筋","すじ"],["に"],["ある"],["。"]]},{"verse":17,"text":"これはその尾,おを香柏,こうはくのように動,うごかし、そのももの筋,すじは互,たがいにからみ合,あう。","tok":[["これ"],["は"],["その"],["尾","お"],["を"],["香","こう"],["柏","かしわ"],["の"],["よう"],["に"],["動かし","うごかし"],["、"],["その"],["もも"],["の"],["筋","すじ"],["は"],["互","たがい"],["に"],["からみ合う","からみあう"],["。"]]},{"verse":18,"text":"その骨,ほねは青銅,せいどうの管,くだのようで、その肋骨,ろっこつは鉄,てつの棒,ぼうのようだ。","tok":[["その"],["骨","ほね"],["は"],["青銅","せいどう"],["の"],["管","くだ"],["の"],["よう"],["で"],["、"],["その"],["肋骨","ろっこつ"],["は"],["鉄","てつ"],["の"],["棒","ぼう"],["の"],["よう"],["だ"],["。"]]},{"verse":19,"text":"これは神,かみのわざの第,だい一のものであって、これを造,つくった者,ものがこれにつるぎを授,さづけた。","tok":[["これ"],["は"],["神","かみ"],["の"],["わざ"],["の"],["第","だい"],["一","いち"],["の"],["もの"],["で"],["あって"],["、"],["これ"],["を"],["造った","つくった"],["者","もの"],["が"],["これ"],["に"],["つるぎ"],["を"],["授","さ"],["づけた"],["。"]]},{"verse":20,"text":"山,やまもこれがために食物,しょくもつをいだし、もろもろの野,のの獣,けものもそこに遊,あそぶ。","tok":[["山","やま"],["も"],["これ"],["が"],["ため"],["に"],["食物","しょくもつ"],["を"],["いだし"],["、"],["もろもろ"],["の"],["野","の"],["の"],["獣","けもの"],["も"],["そこ"],["に"],["遊ぶ","あそぶ"],["。"]]},{"verse":21,"text":"これは酸棗,さんそうの木,きの下,したに伏,ふし、葦,あしの茂,しげみ、または沼,ぬまに隠,かくれている。","tok":[["これ"],["は"],["酸棗","さんそう"],["の"],["木","き"],["の"],["下","した"],["に"],["伏し","ふし"],["、"],["葦","あし"],["の"],["茂み","しげみ"],["、"],["また"],["は"],["沼","ぬま"],["に"],["隠れて","かくれて"],["いる"],["。"]]},{"verse":22,"text":"酸棗,さんそうの木,きはその陰,かげでこれをおおい、川,かわの柳,やなぎはこれをめぐり囲,かこむ。","tok":[["酸棗","さんそう"],["の"],["木","き"],["は"],["その"],["陰","かげ"],["で"],["これ"],["を"],["おおい"],["、"],["川","かわ"],["の"],["柳","やなぎ"],["は"],["これ"],["を"],["めぐり"],["囲む","かこむ"],["。"]]},{"verse":23,"text":"見,みよ、たとい川,かわが荒,あれても、これは驚,おどろかない。ヨルダンがその口,くちに注,そそぎかかっても、これはあわてない。","tok":[["見よ","みよ"],["、"],["たとい"],["川","かわ"],["が"],["荒れて","あれて"],["も"],["、"],["これ"],["は"],["驚ろかない","おどろかない"],["。"],["ヨルダン"],["が"],["その"],["口","くち"],["に"],["注ぎ","そそぎ"],["かかって"],["も"],["、"],["これ"],["は"],["あわてない"],["。"]]},{"verse":24,"text":"だれが、かぎでこれを捕,とらえることができるか。だれが、わなでその鼻,はなを貫,つらぬくことができるか。","tok":[["だれ"],["が"],["、"],["かぎ"],["で"],["これ"],["を"],["捕らえる","とらえる"],["こと"],["が"],["できる"],["か"],["。"],["だれ"],["が"],["、"],["わな"],["で"],["その"],["鼻","はな"],["を"],["貫ぬく","つらぬく"],["こと"],["が"],["できる"],["か"],["。"]]},{"verse":25,"text":"[41:1]あなたはつり針,はりでわにをつり出,だすことができるか。糸,いとでその舌,したを押,おさえることができるか。","tok":[["["],["41"],[":"],["1"],["]"],["あなた"],["は"],["つり針","つりはり"],["で"],["わに"],["を"],["つり出す","つりだす"],["こと"],["が"],["できる"],["か"],["。"],["糸","いと"],["で"],["その"],["舌","した"],["を"],["押さえる","おさえる"],["こと"],["が"],["できる"],["か"],["。"]]},{"verse":26,"text":"[41:2]あなたは葦,あしのなわをその鼻,はなに通,とおすことができるか。つり針,はりでそのあごを突,つき通,とおすことができるか。","tok":[["["],["41"],[":"],["2"],["]"],["あなた"],["は"],["葦","あし"],["の"],["なわ"],["を"],["その"],["鼻","はな"],["に"],["通す","とおす"],["こと"],["が"],["できる"],["か"],["。"],["つり針","つりはり"],["で"],["その"],["あご"],["を"],["突き通す","つきとおす"],["こと"],["が"],["できる"],["か"],["。"]]},{"verse":27,"text":"[41:3]これはしきりに、あなたに願,ねがい求,もとめるであろうか。柔,やわらかな言葉,ことばをあなたに語,かたるであろうか。","tok":[["["],["41"],[":"],["3"],["]"],["これ"],["は"],["しきり"],["に"],["、"],["あなた"],["に"],["願い求めるで","ねがいもとめるで"],["あろう"],["か"],["。"],["柔らか","やわらか"],["な"],["言葉","ことば"],["を"],["あなた"],["に"],["語るで","かたるで"],["あろう"],["か"],["。"]]},{"verse":28,"text":"[41:4]これはあなたと契約,けいやくを結,むすぶであろうか。あなたはこれを取,とって、ながくあなたのしもべとすることができるであろうか。","tok":[["["],["41"],[":"],["4"],["]"],["これ"],["は"],["あなた"],["と"],["契約","けいやく"],["を"],["結ぶで","むすぶで"],["あろう"],["か"],["。"],["あなた"],["は"],["これ"],["を"],["取って","とって"],["、"],["ながく"],["あなた"],["の"],["しもべ"],["と"],["する"],["こと"],["が"],["できるで"],["あろう"],["か"],["。"]]},{"verse":29,"text":"[41:5]あなたは鳥,とりと戯,たわむれるようにこれと戯,ざれ、またあなたのおとめたちのために、これをつないでおくことができるであろうか。","tok":[["["],["41"],[":"],["5"],["]"],["あなた"],["は"],["鳥","とり"],["と"],["戯","たわむれ"],["る"],["よう"],["に"],["これ"],["と"],["戯れ","ざれ"],["、"],["また"],["あなた"],["の"],["おとめ"],["たち"],["の"],["ため"],["に"],["、"],["これ"],["を"],["つないで"],["おく"],["こと"],["が"],["できるで"],["あろう"],["か"],["。"]]},{"verse":30,"text":"[41:6]商人,しょうにんの仲間,なかまはこれを商品,しょうひんとして、小売,こうり商人,しょうにんの間,あいだに分,わけるであろうか。","tok":[["["],["41"],[":"],["6"],["]"],["商人","しょうにん"],["の"],["仲間","なかま"],["は"],["これ"],["を"],["商品","しょうひん"],["として"],["、"],["小売","こうり"],["商人","しょうにん"],["の"],["間","あいだ"],["に"],["分けるで","わけるで"],["あろう"],["か"],["。"]]},{"verse":31,"text":"[41:7]あなたは、もりでその皮,かわを満,みたし、やすでその頭,あたまを突,つき通,とおすことができるか。","tok":[["["],["41"],[":"],["7"],["]"],["あなた"],["は"],["、"],["もり"],["で"],["その"],["皮","かわ"],["を"],["満たし","みたし"],["、"],["やす"],["で"],["その"],["頭","あたま"],["を"],["突き通す","つきとおす"],["こと"],["が"],["できる"],["か"],["。"]]},{"verse":32,"text":"[41:8]あなたの手,てをこれの上,うえに置,おけ、あなたは戦,たたかいを思,おもい出,だして、再,ふたたびこれをしないであろう。","tok":[["["],["41"],[":"],["8"],["]"],["あなた"],["の"],["手","て"],["を"],["これ"],["の"],["上","うえ"],["に"],["置","おけ"],["、"],["あなた"],["は"],["戦い","たたかい"],["を"],["思い出して","おもいだして"],["、"],["再び","ふたたび"],["これ"],["を"],["しないで"],["あろう"],["。"]]}]
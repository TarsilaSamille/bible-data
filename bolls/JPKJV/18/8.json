[{"verse":1,"text":"時,ときにシュヒびとビルダデが答,こたえて言,いった、","tok":[["時","とき"],["に"],["シュヒ"],["びと"],["ビルダデ"],["が"],["答","こたえ"],["て"],["言った","いった"],["、"]]},{"verse":2,"text":"「いつまであなたは、そのような事,ことを言,いうのか。あなたの口,くちの言葉,ことばは荒,あらい風,かぜではないか。","tok":[["「"],["いつ"],["まで"],["あなた"],["は"],["、"],["その"],["よう"],["な"],["事","こと"],["を"],["言う","いう"],["の"],["か"],["。"],["あなた"],["の"],["口","くち"],["の"],["言葉","ことば"],["は"],["荒い","あらい"],["風","かぜ"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":3,"text":"神,かみは公義,こうぎを曲,まげられるであろうか。全能者,ぜんのうしゃは正義,せいぎを曲,まげられるであろうか。","tok":[["神","かみ"],["は"],["公義","こうぎ"],["を"],["曲げられるで","まげられるで"],["あろう"],["か"],["。"],["全能者","ぜんのうしゃ"],["は"],["正義","せいぎ"],["を"],["曲げられるで","まげられるで"],["あろう"],["か"],["。"]]},{"verse":4,"text":"あなたの子,こたちが彼,かれに罪,つみを犯,おかしたので、彼,かれらをそのとがの手,てに渡,わたされたのだ。","tok":[["あなた"],["の"],["子","こ"],["たち"],["が"],["彼","かれ"],["に"],["罪","つみ"],["を"],["犯した","おかした"],["ので"],["、"],["彼","かれ"],["ら"],["を"],["その"],["とが"],["の"],["手","て"],["に"],["渡された","わたされた"],["の"],["だ"],["。"]]},{"verse":5,"text":"あなたがもし神,かみに求,もとめ、全能者,ぜんのうしゃに祈,いのるならば、","tok":[["あなた"],["が"],["もし"],["神","かみ"],["に"],["求め","もとめ"],["、"],["全能者","ぜんのうしゃ"],["に"],["祈るならば","いのるならば"],["、"]]},{"verse":6,"text":"あなたがもし清,きよく、正,ただしくあるならば、彼,かれは必,かならずあなたのために立,たって、あなたの正,ただしいすみかを栄,さかえさせられる。","tok":[["あなた"],["が"],["もし"],["清く","きよく"],["、"],["正く","ただしく"],["あるならば"],["、"],["彼","かれ"],["は"],["必","かならず"],["あなた"],["の"],["ため"],["に"],["立って","たって"],["、"],["あなた"],["の"],["正い","ただしい"],["すみか"],["を"],["栄","さかえ"],["させられる"],["。"]]},{"verse":7,"text":"あなたの初,はじめは小,ちいさくあっても、あなたの終,おわりは非常,ひじょうに大,おおきくなるであろう。","tok":[["あなた"],["の"],["初め","はじめ"],["は"],["小さく","ちいさく"],["あって"],["も"],["、"],["あなた"],["の"],["終","おわり"],["は"],["非常","ひじょう"],["に"],["大きく","おおきく"],["なるで"],["あろう"],["。"]]},{"verse":8,"text":"先,さきの代,よの人,ひとに問,とうてみよ、先祖,せんぞたちの尋,たずねきわめた事,ことを学,まなべ。","tok":[["先","さき"],["の"],["代","よ"],["の"],["人","ひと"],["に"],["問うて","とうて"],["みよ"],["、"],["先祖","せんぞ"],["たち"],["の"],["尋ね","たずね"],["きわめた"],["事","こと"],["を"],["学べ","まなべ"],["。"]]},{"verse":9,"text":"われわれはただ、きのうからあった者,もので、何,なにも知,しらない、われわれの世,よにある日,ひは、影,かげのようなものである。","tok":[["われわれ"],["は"],["ただ"],["、"],["きのう"],["から"],["あった"],["者","もの"],["で"],["、"],["何に","なに"],["も"],["知らない","しらない"],["、"],["われわれ"],["の"],["世","よ"],["に"],["ある"],["日","ひ"],["は"],["、"],["影","かげ"],["の"],["よう"],["な"],["もの"],["で"],["ある"],["。"]]},{"verse":10,"text":"彼,かれらはあなたに教,おしえ、あなたに語,かたり、その悟,さとりから言葉,ことばを出,ださないであろうか。","tok":[["彼","かれ"],["ら"],["は"],["あなた"],["に"],["教え","おしえ"],["、"],["あなた"],["に"],["語り","かたり"],["、"],["その"],["悟り","さとり"],["から"],["言葉","ことば"],["を"],["出さないで","ださないで"],["あろう"],["か"],["。"]]},{"verse":11,"text":"紙,かみ草,ぐさは泥,どろのない所,ところに生長,せいちょうすることができようか。葦,あしは水,みずのない所,ところにおい茂,しげることができようか。","tok":[["紙","かみ"],["草","ぐさ"],["は"],["泥","どろ"],["の"],["ない"],["所","ところ"],["に"],["生長","せいちょう"],["する"],["こと"],["が"],["できよう"],["か"],["。"],["葦","あし"],["は"],["水","みず"],["の"],["ない"],["所","ところ"],["に"],["おい"],["茂","しげる"],["こと"],["が"],["できよう"],["か"],["。"]]},{"verse":12,"text":"これはなお青,あおくて、まだ刈,かられないのに、すべての草,くさに先,さきだって枯,かれる。","tok":[["これ"],["は"],["なお"],["青くて","あおくて"],["、"],["まだ"],["刈られない","かられない"],["のに"],["、"],["すべて"],["の"],["草","くさ"],["に"],["先き","さき"],["だ"],["って"],["枯る","かれる"],["。"]]},{"verse":13,"text":"すべて神,かみを忘,わすれる者,ものの道,みちはこのとおりだ。神,かみを信,しんじない者,ものの望,のぞみは滅,ほろびる。","tok":[["すべて"],["神","かみ"],["を"],["忘る","わすれる"],["者","もの"],["の"],["道","みち"],["は"],["この"],["とおり"],["だ"],["。"],["神","かみ"],["を"],["信じない","しんじない"],["者","もの"],["の"],["望み","のぞみ"],["は"],["滅びる","ほろびる"],["。"]]},{"verse":14,"text":"その頼,たのむところは断,たたれ、その寄,よるところは、くもの巣,すのようだ。","tok":[["その"],["頼む","たのむ"],["ところ"],["は"],["断たれ","たたれ"],["、"],["その"],["寄る","よる"],["ところ"],["は"],["、"],["くも"],["の"],["巣","す"],["の"],["よう"],["だ"],["。"]]},{"verse":15,"text":"その家,いえによりかかろうとすれば、家,いえは立,たたず、それにすがろうとしても、それは耐,たえない。","tok":[["その"],["家","いえ"],["に"],["より"],["かかろう"],["と"],["すれば"],["、"],["家","いえ"],["は"],["立たず","たたず"],["、"],["それ"],["に"],["すがろう"],["として"],["も"],["、"],["それ"],["は"],["耐えない","たえない"],["。"]]},{"verse":16,"text":"彼,かれは日,ひの前,まえに青々,あおあおと茂,しげり、その若,わか枝,えだを園,そのにはびこらせ、","tok":[["彼","かれ"],["は"],["日","ひ"],["の"],["前","まえ"],["に"],["青々","あおあお"],["と"],["茂り","しげり"],["、"],["その"],["若枝","わかえだ"],["を"],["園","その"],["に"],["はびこらせ"],["、"]]},{"verse":17,"text":"その根,ねを石塚,いしづかにからませ、岩,いわの間,あいだに生,いきていても、","tok":[["その"],["根","ね"],["を"],["石塚","いしづか"],["に"],["からませ"],["、"],["岩","いわ"],["の"],["間","あいだ"],["に"],["生きて","いきて"],["いて"],["も"],["、"]]},{"verse":18,"text":"もしその所,ところから取,とり除,のぞかれれば、その所,ところは彼,かれを拒,こばんで言,いうであろう、『わたしはあなたを見,みたことがない』と。","tok":[["もし"],["その"],["所","ところ"],["から"],["取除かれれば","とりのぞかれれば"],["、"],["その"],["所","ところ"],["は"],["彼","かれ"],["を"],["拒んで","こばんで"],["言うで","いうで"],["あろう"],["、"],["『"],["わたし"],["は"],["あなた"],["を"],["見た","みた"],["こと"],["が"],["ない"],["』"],["と"],["。"]]},{"verse":19,"text":"見,みよ、これこそ彼,かれの道,みちの喜,よろこびである、そしてほかの者,ものが地,ちから生,しょうじるであろう。","tok":[["見よ","みよ"],["、"],["これ"],["こそ"],["彼","かれ"],["の"],["道","みち"],["の"],["喜こびで","よろこびで"],["ある"],["、"],["そして"],["ほか"],["の"],["者","もの"],["が"],["地","ち"],["から"],["生じるで","しょうじるで"],["あろう"],["。"]]},{"verse":20,"text":"見,みよ、神,かみは全,まったき人,ひとを捨,すてられない。また悪,あくを行,おこなう者,ものの手,てを支持,しじされない。","tok":[["見よ","みよ"],["、"],["神","かみ"],["は"],["全","ま"],["っ"],["たき人","たきひと"],["を"],["捨てられない","すてられない"],["。"],["また"],["悪","あく"],["を"],["行なう","おこなう"],["者","もの"],["の"],["手","て"],["を"],["支持","しじ"],["されない"],["。"]]},{"verse":21,"text":"彼,かれは笑,わらいをもってあなたの口,くちを満,みたし、喜,よろこびの声,こえをもってあなたのくちびるを満,みたされる。","tok":[["彼","かれ"],["は"],["笑","わらい"],["を"],["もって"],["あなた"],["の"],["口","くち"],["を"],["満たし","みたし"],["、"],["喜こび","よろこび"],["の"],["声","こえ"],["を"],["もって"],["あなた"],["の"],["くちびる"],["を"],["満たされる","みたされる"],["。"]]},{"verse":22,"text":"あなたを憎,にくむ者,ものは恥,はじを着,きせられ、悪,あしき者,ものの天幕,てんまくはなくなる」。","tok":[["あなた"],["を"],["憎む","にくむ"],["者","もの"],["は"],["恥","はじ"],["を"],["着せられ","きせられ"],["、"],["悪しき","あしき"],["者","もの"],["の"],["天幕","てんまく"],["は"],["なく"],["なる"],["」"],["。"]]}]
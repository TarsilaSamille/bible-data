[{"verse":1,"text":"エリフは重,かさねて言,いった、","tok":[["エリフ"],["は"],["重ねて","かさねて"],["言った","いった"],["、"]]},{"verse":2,"text":"「しばらく待,まて、わたしはあなたに示,しめすことがある。なお神,かみのために言,いうべき事,ことがある。","tok":[["「"],["しばらく"],["待て","まて"],["、"],["わたし"],["は"],["あなた"],["に"],["示めす","しめす"],["こと"],["が"],["ある"],["。"],["なお"],["神","かみ"],["の"],["ため"],["に"],["言うべき","いうべき"],["事","こと"],["が"],["ある"],["。"]]},{"verse":3,"text":"わたしは遠,とおくからわが知識,ちしきを取,とり、わが造,つくり主,ぬしに正義,せいぎを帰,きする。","tok":[["わたし"],["は"],["遠く","とおく"],["から"],["わが"],["知識","ちしき"],["を"],["取","とり"],["、"],["わが"],["造主","つくりぬし"],["に"],["正義","せいぎ"],["を"],["帰する","きする"],["。"]]},{"verse":4,"text":"まことにわたしの言葉,ことばは偽,いつわらない。知識,ちしきの全,まったき者,ものがあなたと共,ともにいる。","tok":[["まこと"],["に"],["わたし"],["の"],["言葉","ことば"],["は"],["偽わらない","いつわらない"],["。"],["知識","ちしき"],["の"],["全","ま"],["っ"],["たき者","たきもの"],["が"],["あなた"],["と"],["共","とも"],["に"],["いる"],["。"]]},{"verse":5,"text":"見,みよ、神,かみは力,ちからある者,ものであるが、何,なにをも卑,いやしめられない、その悟,さとりの力,ちからは大,おおきい。","tok":[["見よ","みよ"],["、"],["神","かみ"],["は"],["力","ちから"],["ある"],["者","もの"],["で"],["ある"],["が"],["、"],["何に","なに"],["を"],["も"],["卑しめられない","いやしめられない"],["、"],["その"],["悟り","さとり"],["の"],["力","ちから"],["は"],["大きい","おおきい"],["。"]]},{"verse":6,"text":"彼,かれは悪,あしき者,ものを生,いかしておかれない、苦,くるしむ者,もののためにさばきを行,おこなわれる。","tok":[["彼","かれ"],["は"],["悪しき","あしき"],["者","もの"],["を"],["生かして","いかして"],["おかれない"],["、"],["苦しむ","くるしむ"],["者","もの"],["の"],["ため"],["に"],["さばき"],["を"],["行なわれる","おこなわれる"],["。"]]},{"verse":7,"text":"彼,かれは正,ただしい者,ものから目,めを離,はなさず、位,くらいにある王,おうたちと共,ともに、とこしえに、彼,かれらをすわらせて、尊,たっとくされる。","tok":[["彼","かれ"],["は"],["正い","ただしい"],["者","もの"],["から"],["目","め"],["を"],["離さず","はなさず"],["、"],["位","くらい"],["に"],["ある"],["王","おう"],["たち"],["と"],["共","とも"],["に"],["、"],["とこしえ"],["に"],["、"],["彼","かれ"],["ら"],["を"],["すわらせて"],["、"],["尊","たっ"],["と"],["くされる"],["。"]]},{"verse":8,"text":"もし彼,かれらが足,あしかせにつながれ、悩,なやみのなわに捕,とらえられる時,ときは、","tok":[["もし"],["彼","かれ"],["ら"],["が"],["足かせ","あしかせ"],["に"],["つながれ"],["、"],["悩み","なやみ"],["の"],["なわ"],["に"],["捕らえられる","とらえられる"],["時","とき"],["は"],["、"]]},{"verse":9,"text":"彼,かれらの行,おこないと、とがと、その高,たかぶったふるまいを彼,かれらに示,しめし、","tok":[["彼","かれ"],["ら"],["の"],["行ない","おこない"],["と"],["、"],["とが"],["と"],["、"],["その"],["高ぶった","たかぶった"],["ふるまい"],["を"],["彼","かれ"],["ら"],["に"],["示めし","しめし"],["、"]]},{"verse":10,"text":"彼,かれらの耳,みみを開,ひらいて、教,おしえを聞,きかせ、悪,あくを離,はなれて帰,かえることを命,めいじられる。","tok":[["彼","かれ"],["ら"],["の"],["耳","みみ"],["を"],["開らいて","ひらいて"],["、"],["教え","おしえ"],["を"],["聞かせ","きかせ"],["、"],["悪","あく"],["を"],["離れて","はなれて"],["帰える","かえる"],["こと"],["を"],["命じられる","めいじられる"],["。"]]},{"verse":11,"text":"もし彼,かれらが聞,きいて彼,かれに仕,つかえるならば、彼,かれらはその日,ひを幸福,こうふくに過,すごし、その年,としを楽,たのしく送,おくるであろう。","tok":[["もし"],["彼","かれ"],["ら"],["が"],["聞いて","きいて"],["彼","かれ"],["に"],["仕えるならば","つかえるならば"],["、"],["彼","かれ"],["ら"],["は"],["その"],["日","ひ"],["を"],["幸福","こうふく"],["に"],["過ごし","すごし"],["、"],["その"],["年","とし"],["を"],["楽く","たのしく"],["送るで","おくるで"],["あろう"],["。"]]},{"verse":12,"text":"しかし彼,かれらが聞,きかないならば、つるぎによって滅,ほろび、知識,ちしきを得,えないで死,しぬであろう。","tok":[["しかし"],["彼","かれ"],["ら"],["が"],["聞かないならば","きかないならば"],["、"],["つるぎ"],["によって"],["滅び","ほろび"],["、"],["知識","ちしき"],["を"],["得ないで","えないで"],["死ぬで","しぬで"],["あろう"],["。"]]},{"verse":13,"text":"心,こころに神,かみを信,しんじない者,ものどもは怒,いかりをたくわえ、神,かみに縛,しばられる時,ときも、助,たすけを呼,よび求,もとめることをしない。","tok":[["心","こころ"],["に"],["神","かみ"],["を"],["信じない","しんじない"],["者","もの"],["ども"],["は"],["怒り","いかり"],["を"],["たくわえ"],["、"],["神","かみ"],["に"],["縛られる","しばられる"],["時","とき"],["も"],["、"],["助け","たすけ"],["を"],["呼び求める","よびもとめる"],["こと"],["を"],["しない"],["。"]]},{"verse":14,"text":"彼,かれらは年,とし若,わかくして死,しに、その命,いのちは恥,はじのうちに終,おわる。","tok":[["彼","かれ"],["ら"],["は"],["年","と"],["し"],["若く","わかく"],["して"],["死に","しに"],["、"],["その"],["命","いのち"],["は"],["恥","はじ"],["の"],["うち"],["に"],["終わる","おわる"],["。"]]},{"verse":15,"text":"神,かみは苦,くるしむ者,ものをその苦,くるしみによって救,すくい、彼,かれらの耳,みみを逆境,ぎゃっきょうによって開,ひらかれる。","tok":[["神","かみ"],["は"],["苦しむ","くるしむ"],["者","もの"],["を"],["その"],["苦しみ","くるしみ"],["によって"],["救い","すくい"],["、"],["彼","かれ"],["ら"],["の"],["耳","みみ"],["を"],["逆境","ぎゃっきょう"],["によって"],["開らかれる","ひらかれる"],["。"]]},{"verse":16,"text":"神,かみはまたあなたを悩,なやみから、束縛,そくばくのない広,ひろい所,ところに誘,さそい出,だされた。そしてあなたの食卓,しょくたくに置,おかれた物,ものはすべて肥,こえた物,ものであった。","tok":[["神","かみ"],["は"],["また"],["あなた"],["を"],["悩み","なやみ"],["から"],["、"],["束縛","そくばく"],["の"],["ない"],["広い","ひろい"],["所","ところ"],["に"],["誘い出された","さそいだされた"],["。"],["そして"],["あなた"],["の"],["食卓","しょくたく"],["に"],["置かれた","おかれた"],["物","もの"],["は"],["すべて"],["肥","こえ"],["た"],["物","もの"],["で"],["あった"],["。"]]},{"verse":17,"text":"しかしあなたは悪人,あくにんのうくべきさばきをおのれに満,みたし、さばきと公義,こうぎはあなたを捕,とらえている。","tok":[["しかし"],["あなた"],["は"],["悪人","あくにん"],["の"],["うくべき"],["さばき"],["を"],["おのれ"],["に"],["満たし","みたし"],["、"],["さばき"],["と"],["公義","こうぎ"],["は"],["あなた"],["を"],["捕らえて","とらえて"],["いる"],["。"]]},{"verse":18,"text":"あなたは怒,いかりに誘,さそわれて、あざけりに陥,おちいらぬように心,こころせよ。あがないしろの大,おおいなるがために、おのれを誤,あやまるな。","tok":[["あなた"],["は"],["怒り","いかり"],["に"],["誘われて","さそわれて"],["、"],["あざけり"],["に"],["陥ち","おち"],["いらぬ"],["よう"],["に"],["心","こころ"],["せよ"],["。"],["あがない"],["しろ"],["の"],["大いなる","おおいなる"],["が"],["ため"],["に"],["、"],["おのれ"],["を"],["誤る","あやまる"],["な"],["。"]]},{"verse":19,"text":"あなたの叫,さけびはあなたを守,まもって、悩,なやみを免,まぬかれさせるであろうか、いかに力,ちからをつくしても役,やくに立,たたない。","tok":[["あなた"],["の"],["叫","さけび"],["は"],["あなた"],["を"],["守って","まもって"],["、"],["悩み","なやみ"],["を"],["免かれさせるで","まぬかれさせるで"],["あろう"],["か"],["、"],["いかに"],["力","ちから"],["を"],["つくして"],["も"],["役","やく"],["に"],["立たない","たたない"],["。"]]},{"verse":20,"text":"人々,ひとびとがその所,ところから断,たたれるその夜,よるを慕,したってはならない。","tok":[["人々","ひとびと"],["が"],["その"],["所","ところ"],["から"],["断たれる","たたれる"],["その"],["夜","よる"],["を"],["慕って","したって"],["は"],["ならない"],["。"]]},{"verse":21,"text":"慎,つつしんで悪,あくに傾,かたむいてはならない。あなたは悩,なやみよりもむしろこれを選,えらんだからだ。","tok":[["慎しんで","つつしんで"],["悪","あく"],["に"],["傾いて","かたむいて"],["は"],["ならない"],["。"],["あなた"],["は"],["悩み","なやみ"],["より"],["も"],["むしろ"],["これ"],["を"],["選らんだ","えらんだ"],["から"],["だ"],["。"]]},{"verse":22,"text":"見,みよ、神,かみはその力,ちからをもってあがめられる。だれか彼,かれのように教,おしえる者,ものがあるか。","tok":[["見よ","みよ"],["、"],["神","かみ"],["は"],["その"],["力","ちから"],["を"],["もって"],["あがめられる"],["。"],["だれ"],["か"],["彼","かれ"],["の"],["よう"],["に"],["教える","おしえる"],["者","もの"],["が"],["ある"],["か"],["。"]]},{"verse":23,"text":"だれか彼,かれのためにその道,みちを定,さだめた者,ものがあるか。だれか『あなたは悪,わるい事,ことをした』と言,いいうる者,ものがあるか。","tok":[["だれ"],["か"],["彼","かれ"],["の"],["ため"],["に"],["その"],["道","みち"],["を"],["定めた","さだめた"],["者","もの"],["が"],["ある"],["か"],["。"],["だれ"],["か"],["『"],["あなた"],["は"],["悪い","わるい"],["事","こと"],["を"],["した"],["』"],["と"],["言い","いい"],["うる"],["者","もの"],["が"],["ある"],["か"],["。"]]},{"verse":24,"text":"神,かみのみわざをほめたたえる事,ことを忘,わすれてはならない。これは人々,ひとびとの歌,うたいあがめるところである。","tok":[["神","かみ"],["のみ"],["わざ"],["を"],["ほめたたえる"],["事","こと"],["を"],["忘て","わすれて"],["は"],["ならない"],["。"],["これ"],["は"],["人々","ひとびと"],["の"],["歌い","うたい"],["あがめる"],["ところ"],["で"],["ある"],["。"]]},{"verse":25,"text":"すべての人,ひとはこれを仰,あおぎ見,みる。人,ひとは遠,とおくからこれを見,みるにすぎない。","tok":[["すべて"],["の"],["人","ひと"],["は"],["これ"],["を"],["仰ぎ見る","あおぎみる"],["。"],["人","ひと"],["は"],["遠く","とおく"],["から"],["これ"],["を"],["見る","みる"],["に"],["すぎない"],["。"]]},{"verse":26,"text":"見,みよ、神,かみは大,おおいなる者,ものにいまして、われわれは彼,かれを知,しらない。その年,としの数,かずも計,はかり知,しることができない。","tok":[["見よ","みよ"],["、"],["神","かみ"],["は"],["大いなる","おおいなる"],["者","もの"],["に"],["いまして"],["、"],["われわれ"],["は"],["彼","かれ"],["を"],["知らない","しらない"],["。"],["その"],["年","とし"],["の"],["数","かず"],["も"],["計り知る","はかりしる"],["こと"],["が"],["できない"],["。"]]},{"verse":27,"text":"彼,かれは水,みずのしたたりを引,ひきあげ、その霧,きりをしたたらせて雨,あめとされる。","tok":[["彼","かれ"],["は"],["水","みず"],["の"],["した"],["たり"],["を"],["引","ひき"],["あげ"],["、"],["その"],["霧","きり"],["を"],["したたらせて"],["雨","あめ"],["と"],["される"],["。"]]},{"verse":28,"text":"空,そらはこれを降,ふらせて、人,ひとの上,うえに豊,ゆたかに注,そそぐ。","tok":[["空","そら"],["は"],["これ"],["を"],["降らせて","ふらせて"],["、"],["人","ひと"],["の"],["上","うえ"],["に"],["豊","ゆたか"],["に"],["注ぐ","そそぐ"],["。"]]},{"verse":29,"text":"だれか雲,くもの広,ひろがるわけと、その幕屋,まくやのとどろくわけとを悟,さとることができようか。","tok":[["だれ"],["か"],["雲","くも"],["の"],["広がる","ひろがる"],["わけ"],["と"],["、"],["その"],["幕屋","まくや"],["の"],["とどろく"],["わけ"],["と"],["を"],["悟","さとる"],["こと"],["が"],["できよう"],["か"],["。"]]},{"verse":30,"text":"見,みよ、彼,かれはその光,ひかりをおのれのまわりにひろげ、また海,うみの底,そこをおおわれる。","tok":[["見よ","みよ"],["、"],["彼","かれ"],["は"],["その"],["光","ひかり"],["を"],["おのれ"],["の"],["まわり"],["に"],["ひろげ"],["、"],["また"],["海","うみ"],["の"],["底","そこ"],["を"],["おおわれる"],["。"]]},{"verse":31,"text":"彼,かれはこれらをもって民,たみをさばき、食物,しょくもつを豊,ゆたかに賜,たまい、","tok":[["彼","かれ"],["は"],["これ"],["ら"],["を"],["もって"],["民","たみ"],["を"],["さばき"],["、"],["食物","しょくもつ"],["を"],["豊","ゆたか"],["に"],["賜い","たまい"],["、"]]},{"verse":32,"text":"いなずまをもってもろ手,てを包,つつみ、これに命,めいじて敵,てきを打,うたせられる。","tok":[["いなずま"],["を"],["もって"],["もろ手","もろて"],["を"],["包","つつみ"],["、"],["これ"],["に"],["命じて","めいじて"],["敵","てき"],["を"],["打たせられる","うたせられる"],["。"]]},{"verse":33,"text":"そのとどろきは、悪,あくにむかって怒,いかりに燃,もえる彼,かれを現,あらわす。","tok":[["その"],["とどろき"],["は"],["、"],["悪","あく"],["に"],["むかって"],["怒り","いかり"],["に"],["燃える","もえる"],["彼","かれ"],["を"],["現わす","あらわす"],["。"]]}]
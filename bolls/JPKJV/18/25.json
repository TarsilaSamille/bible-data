[{"verse":1,"text":"そこでシュヒびとビルダデは答,こたえて言,いった、","tok":[["そこ"],["で"],["シュヒ"],["びと"],["ビルダデ"],["は"],["答","こたえ"],["て"],["言った","いった"],["、"]]},{"verse":2,"text":"「大権,たいけんと恐,おそれとは神,かみと共,ともにある。彼,かれは高,たかき所,ところで平和,へいわを施,ほどこされる。","tok":[["「"],["大権","たいけん"],["と"],["恐","おそれ"],["と"],["は"],["神","かみ"],["と"],["共","とも"],["に"],["ある"],["。"],["彼","かれ"],["は"],["高き","たかき"],["所","ところ"],["で"],["平和","へいわ"],["を"],["施される","ほどこされる"],["。"]]},{"verse":3,"text":"その軍勢,ぐんぜいは数,かぞえることができるか。何,なに物,ものかその光,ひかりに浴,よくさないものがあるか。","tok":[["その"],["軍勢","ぐんぜい"],["は"],["数える","かぞえる"],["こと"],["が"],["できる"],["か"],["。"],["何","な"],["に"],["物","もの"],["か"],["その"],["光","ひかり"],["に"],["浴さない","よくさない"],["もの"],["が"],["ある"],["か"],["。"]]},{"verse":4,"text":"それで人,ひとはどうして神,かみの前,まえに正,ただしくありえようか。女,おんなから生,うまれた者,ものがどうして清,きよくありえようか。","tok":[["それ"],["で"],["人","ひと"],["は"],["どう"],["して"],["神","かみ"],["の"],["前","まえ"],["に"],["正く","ただしく"],["あり"],["えよう"],["か"],["。"],["女","おんな"],["から"],["生まれた","うまれた"],["者","もの"],["が"],["どう"],["して"],["清く","きよく"],["あり"],["えよう"],["か"],["。"]]},{"verse":5,"text":"見,みよ、月,つきさえも輝,かがやかず、星,ほしも彼,かれの目,めには清,きよくない。","tok":[["見よ","みよ"],["、"],["月","つき"],["さえ"],["も"],["輝やかず","かがやかず"],["、"],["星","ほし"],["も"],["彼","かれ"],["の"],["目","め"],["に"],["は"],["清く","きよく"],["ない"],["。"]]},{"verse":6,"text":"うじのような人,ひと、虫,むしのような人,ひとの子,こはなおさらである」。","tok":[["うじ"],["の"],["よう"],["な"],["人","ひと"],["、"],["虫","むし"],["の"],["よう"],["な"],["人","ひと"],["の"],["子","こ"],["は"],["なおさら"],["で"],["ある"],["」"],["。"]]}]
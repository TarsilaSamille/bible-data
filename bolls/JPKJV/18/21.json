[{"verse":1,"text":"そこでヨブは答,こたえて言,いった、","tok":[["そこ"],["で"],["ヨブ"],["は"],["答","こたえ"],["て"],["言った","いった"],["、"]]},{"verse":2,"text":"「あなたがたはとくと、わたしの言葉,ことばを聞,きき、これをもって、あなたがたの慰,なぐさめとするがよい。","tok":[["「"],["あなた"],["がた"],["は"],["とくと"],["、"],["わたし"],["の"],["言葉","ことば"],["を"],["聞","きき"],["、"],["これ"],["を"],["もって"],["、"],["あなた"],["がた"],["の"],["慰さめ","なぐさめ"],["と"],["する"],["が"],["よい"],["。"]]},{"verse":3,"text":"まずわたしをゆるして語,かたらせなさい。わたしが語,かたったのち、あざけるのもよかろう。","tok":[["まず"],["わたし"],["を"],["ゆるして"],["語らせ","かたらせ"],["なさい"],["。"],["わたし"],["が"],["語った","かたった"],["のち"],["、"],["あざける"],["の"],["も"],["よかろう"],["。"]]},{"verse":4,"text":"わたしのつぶやきは人,ひとに対,たいしてであろうか。わたしはどうして、いらだたないでいられようか。","tok":[["わたし"],["の"],["つぶやき"],["は"],["人","ひと"],["に対して","にたいして"],["で"],["あろう"],["か"],["。"],["わたし"],["は"],["どう"],["して"],["、"],["いらだたないで"],["いられよう"],["か"],["。"]]},{"verse":5,"text":"あなたがたはわたしを見,みて、驚,おどろき、手,てを口,くちにあてるがよい。","tok":[["あなた"],["がた"],["は"],["わたし"],["を"],["見て","みて"],["、"],["驚","おどろき"],["、"],["手","て"],["を"],["口","くち"],["に"],["あてる"],["が"],["よい"],["。"]]},{"verse":6,"text":"わたしはこれを思,おもうと恐,おそろしくなって、からだがしきりに震,ふるえわななく。","tok":[["わたし"],["は"],["これ"],["を"],["思","おもう"],["と"],["恐ろしく","おそろしく"],["なって"],["、"],["からだ"],["が"],["しきり"],["に"],["震えわななく","ふるえわななく"],["。"]]},{"verse":7,"text":"なにゆえ悪,あしき人,ひとが生,いきながらえ、老齢,ろうれいに達,たっし、かつ力強,ちからづよくなるのか。","tok":[["なにゆえ"],["悪しき","あしき"],["人","ひと"],["が"],["生きながらえ","いきながらえ"],["、"],["老齢","ろうれい"],["に"],["達し","たっし"],["、"],["かつ"],["力強く","ちからづよく"],["なる"],["の"],["か"],["。"]]},{"verse":8,"text":"その子,こらは彼,かれらの前,まえに堅,かたく立,たち、その子孫,しそんもその目,めの前,まえに堅,かたく立,たつ。","tok":[["その"],["子","こ"],["ら"],["は"],["彼","かれ"],["ら"],["の"],["前","まえ"],["に"],["堅く","かたく"],["立ち","たち"],["、"],["その"],["子孫","しそん"],["も"],["その"],["目","め"],["の"],["前","まえ"],["に"],["堅く","かたく"],["立つ","たつ"],["。"]]},{"verse":9,"text":"その家,いえは安,やすらかで、恐,おそれがなく、神,かみのつえは彼,かれらの上,うえに臨,のぞむことがない。","tok":[["その"],["家","いえ"],["は"],["安らか","やすらか"],["で"],["、"],["恐","おそれ"],["が"],["なく"],["、"],["神","かみ"],["の"],["つえ"],["は"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["臨む","のぞむ"],["こと"],["が"],["ない"],["。"]]},{"verse":10,"text":"その雄牛,おうしは種,たねを与,あたえて、誤,あやまることなく、その雌牛,めうしは子,こを産,うんで、そこなうことがない。","tok":[["その"],["雄牛","おうし"],["は"],["種","たね"],["を"],["与","あたえ"],["て"],["、"],["誤る","あやまる"],["こと"],["なく"],["、"],["その"],["雌牛","めうし"],["は"],["子","こ"],["を"],["産んで","うんで"],["、"],["そこなう"],["こと"],["が"],["ない"],["。"]]},{"verse":11,"text":"彼,かれらはその小,ちいさい者,ものどもを群,むれのように連,つれ出,だし、その子,こらは舞,まい踊,おどる。","tok":[["彼","かれ"],["ら"],["は"],["その"],["小さい","ちいさい"],["者","もの"],["ども"],["を"],["群れ","むれ"],["の"],["よう"],["に"],["連れ出し","つれだし"],["、"],["その"],["子","こ"],["ら"],["は"],["舞","まい"],["踊る","おどる"],["。"]]},{"verse":12,"text":"彼,かれらは手,て鼓,つづみと琴,ことに合,あわせて歌,うたい、笛,ふえの音,おとによって楽,たのしみ、","tok":[["彼","かれ"],["ら"],["は"],["手","て"],["鼓","つづみ"],["と"],["琴","こと"],["に"],["合","あわせ"],["て"],["歌い","うたい"],["、"],["笛","ふえ"],["の"],["音","おと"],["によって"],["楽み","たのしみ"],["、"]]},{"verse":13,"text":"その日,ひをさいわいに過,すごし、安,やすらかに陰府,よみにくだる。","tok":[["その"],["日","ひ"],["を"],["さいわい"],["に"],["過ごし","すごし"],["、"],["安らか","やすらか"],["に"],["陰府","よみ"],["に"],["くだる"],["。"]]},{"verse":14,"text":"彼,かれらは神,かみに言,いう、『われわれを離,はなれよ、われわれはあなたの道,みちを知,しることを好,このまない。","tok":[["彼","かれ"],["ら"],["は"],["神","かみ"],["に"],["言う","いう"],["、"],["『"],["われわれ"],["を"],["離れよ","はなれよ"],["、"],["われわれ"],["は"],["あなた"],["の"],["道","みち"],["を"],["知る","しる"],["こと"],["を"],["好まない","このまない"],["。"]]},{"verse":15,"text":"全能者,ぜんのうしゃは何者,なにものなので、われわれはこれに仕,つかえねばならないのか。われわれはこれに祈,いのっても、なんの益,えきがあるか』と。","tok":[["全能者","ぜんのうしゃ"],["は"],["何者","なにもの"],["な"],["ので"],["、"],["われわれ"],["は"],["これ"],["に"],["仕えねば","つかえねば"],["ならない"],["の"],["か"],["。"],["われわれ"],["は"],["これ"],["に"],["祈って","いのって"],["も"],["、"],["なん"],["の"],["益","えき"],["が"],["ある"],["か"],["』"],["と"],["。"]]},{"verse":16,"text":"見,みよ、彼,かれらの繁栄,はんえいは彼,かれらの手,てにあるではないか。悪人,あくにんの計,はかりごとは、わたしの遠,とおく及,およぶ所,ところでない。","tok":[["見よ","みよ"],["、"],["彼","かれ"],["ら"],["の"],["繁栄","はんえい"],["は"],["彼","かれ"],["ら"],["の"],["手","て"],["に"],["ある"],["で"],["は"],["ない"],["か"],["。"],["悪人","あくにん"],["の"],["計り","はかり"],["ごと"],["は"],["、"],["わたし"],["の"],["遠く","とおく"],["及ぶ","およぶ"],["所","ところ"],["で"],["ない"],["。"]]},{"verse":17,"text":"悪人,あくにんのともしびの消,けされること、幾,いくたびあるか。その災,わざわいの彼,かれらの上,うえに臨,のぞむこと、神,かみがその怒,いかりをもって苦,くるしみを与,あたえられること、幾,いくたびあるか。","tok":[["悪人","あくにん"],["の"],["ともしび"],["の"],["消される","けされる"],["こと"],["、"],["幾","いく"],["たび"],["ある"],["か"],["。"],["その"],["災","わざわい"],["の"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["臨む","のぞむ"],["こと"],["、"],["神","かみ"],["が"],["その"],["怒り","いかり"],["を"],["もって"],["苦しみ","くるしみ"],["を"],["与えられる","あたえられる"],["こと"],["、"],["幾","いく"],["たび"],["ある"],["か"],["。"]]},{"verse":18,"text":"彼,かれらが風,かぜの前,まえのわらのようになること、あらしに吹,ふき去,さられるもみがらのようになること、幾,いくたびあるか。","tok":[["彼","かれ"],["ら"],["が"],["風","かぜ"],["の"],["前","まえ"],["の"],["わら"],["の"],["よう"],["に"],["なる"],["こと"],["、"],["あらし"],["に"],["吹","ふき"],["去られる","さられる"],["もみがら"],["の"],["よう"],["に"],["なる"],["こと"],["、"],["幾","いく"],["たび"],["ある"],["か"],["。"]]},{"verse":19,"text":"あなたがたは言,いう、『神,かみは彼,かれらの罪,つみを積,つみたくわえて、その子,こらに報,むくいられるのだ』と。どうかそれを彼,かれら自身,じしんに報,むくいて、彼,かれらにその罪,つみを知,しらせられるように。","tok":[["あなた"],["がた"],["は"],["言う","いう"],["、"],["『"],["神","かみ"],["は"],["彼","かれ"],["ら"],["の"],["罪","つみ"],["を"],["積み","つみ"],["たくわえて"],["、"],["その"],["子","こ"],["ら"],["に"],["報いられる","むくいられる"],["の"],["だ"],["』"],["と"],["。"],["どう"],["か"],["それ"],["を"],["彼","かれ"],["ら"],["自身","じしん"],["に"],["報いて","むくいて"],["、"],["彼","かれ"],["ら"],["に"],["その"],["罪","つみ"],["を"],["知らせられる","しらせられる"],["よう"],["に"],["。"]]},{"verse":20,"text":"すなわち彼,かれら自身,じしんの目,めにその滅,ほろびを見,みさせ、全能者,ぜんのうしゃの怒,いかりを彼,かれらに飲,のませられるように。","tok":[["すなわち"],["彼","かれ"],["ら"],["自身","じしん"],["の"],["目","め"],["に"],["その"],["滅び","ほろび"],["を"],["見させ","みさせ"],["、"],["全能者","ぜんのうしゃ"],["の"],["怒り","いかり"],["を"],["彼","かれ"],["ら"],["に"],["飲ませられる","のませられる"],["よう"],["に"],["。"]]},{"verse":21,"text":"その月,つきの数,かずのつきるとき、彼,かれらはその後,のちの家,いえになんのかかわる所,ところがあろうか。","tok":[["その"],["月","つき"],["の"],["数","かず"],["の"],["つきる"],["とき"],["、"],["彼","かれ"],["ら"],["は"],["その後","そののち"],["の"],["家","いえ"],["に"],["なん"],["の"],["かかわる"],["所","ところ"],["が"],["あろう"],["か"],["。"]]},{"verse":22,"text":"神,かみは天,てんにある者,ものたちをさえ、さばかれるのに、だれが神,かみに知識,ちしきを教,おしえることができようか。","tok":[["神","かみ"],["は"],["天","てん"],["に"],["ある"],["者","もの"],["たち"],["を"],["さえ"],["、"],["さばかれる"],["のに"],["、"],["だれ"],["が"],["神","かみ"],["に"],["知識","ちしき"],["を"],["教える","おしえる"],["こと"],["が"],["できよう"],["か"],["。"]]},{"verse":23,"text":"ある者,ものは繁栄,はんえいをきわめ、全,まったく安,やすらかに、かつおだやかに死,しに、","tok":[["ある"],["者","もの"],["は"],["繁栄","はんえい"],["を"],["きわめ"],["、"],["全く","まったく"],["安らか","やすらか"],["に"],["、"],["かつ"],["おだやか"],["に"],["死に","しに"],["、"]]},{"verse":24,"text":"そのからだには脂肪,しぼうが満,みち、その骨,ほねの髄,ずいは潤,うるおっている。","tok":[["その"],["からだ"],["に"],["は"],["脂肪","しぼう"],["が"],["満ち","みち"],["、"],["その"],["骨","ほね"],["の"],["髄","ずい"],["は"],["潤って","うるおって"],["いる"],["。"]]},{"verse":25,"text":"ある者,ものは心,こころを苦,くるしめて死,しに、なんの幸,さいわいをも味,あじわうことがない。","tok":[["ある"],["者","もの"],["は"],["心","こころ"],["を"],["苦しめて","くるしめて"],["死に","しに"],["、"],["なん"],["の"],["幸い","さいわい"],["を"],["も"],["味わう","あじわう"],["こと"],["が"],["ない"],["。"]]},{"verse":26,"text":"彼,かれらはひとしくちりに伏,ふし、うじにおおわれる。","tok":[["彼","かれ"],["ら"],["は"],["ひとしく"],["ちり"],["に"],["伏し","ふし"],["、"],["うじ"],["に"],["おおわれる"],["。"]]},{"verse":27,"text":"見,みよ、わたしはあなたがたの思,おもいを知,しり、わたしを害,がいしようとするたくらみを知,しる。","tok":[["見よ","みよ"],["、"],["わたし"],["は"],["あなた"],["がた"],["の"],["思い","おもい"],["を"],["知り","しり"],["、"],["わたし"],["を"],["害しよう","がいしよう"],["と"],["する"],["たくらみ"],["を"],["知る","しる"],["。"]]},{"verse":28,"text":"あなたがたは言,いう、『王侯,おうこうの家,いえはどこにあるか、悪人,あくにんの住,すむ天幕,てんまくはどこにあるか』と。","tok":[["あなた"],["がた"],["は"],["言う","いう"],["、"],["『"],["王侯","おうこう"],["の"],["家","いえ"],["は"],["どこ"],["に"],["ある"],["か"],["、"],["悪人","あくにん"],["の"],["住む","すむ"],["天幕","てんまく"],["は"],["どこ"],["に"],["ある"],["か"],["』"],["と"],["。"]]},{"verse":29,"text":"あなたがたは道行,みちゆく人々,ひとびとに問,とわなかったか、彼,かれらの証言,しょうげんを受,うけ入,いれないのか。","tok":[["あなた"],["がた"],["は"],["道行","み"],["ち"],["ゆく"],["人々","ひとびと"],["に"],["問わなかった","とわなかった"],["か"],["、"],["彼","かれ"],["ら"],["の"],["証言","しょうげん"],["を"],["受け入れない","うけいれない"],["の"],["か"],["。"]]},{"verse":30,"text":"すなわち、災,わざわいの日,ひに悪人,あくにんは免,まぬかれ、激,はげしい怒,いかりの日,ひに彼,かれは救,すくい出,だされる。","tok":[["すなわち"],["、"],["災","わざわい"],["の"],["日","ひ"],["に"],["悪人","あくにん"],["は"],["免かれ","まぬかれ"],["、"],["激しい","はげしい"],["怒り","いかり"],["の"],["日","ひ"],["に"],["彼","かれ"],["は"],["救い出される","すくいだされる"],["。"]]},{"verse":31,"text":"だれが彼,かれに向,むかって、その道,みちを告,つげ知,しらせる者,ものがあるか、だれが彼,かれのした事,ことを彼,かれに報,むくいる者,ものがあるか。","tok":[["だれ"],["が"],["彼","かれ"],["に"],["向かって","むかって"],["、"],["その"],["道","みち"],["を"],["告","つげ"],["知らせる","しらせる"],["者","もの"],["が"],["ある"],["か"],["、"],["だれ"],["が"],["彼","かれ"],["の"],["した"],["事","こと"],["を"],["彼","かれ"],["に"],["報いる","むくいる"],["者","もの"],["が"],["ある"],["か"],["。"]]},{"verse":32,"text":"彼,かれはかかれて墓,はかに行,いき、塚,つかの上,うえで見張,みはりされ、","tok":[["彼","かれ"],["は"],["かかれて"],["墓","はか"],["に"],["行き","いき"],["、"],["塚","つか"],["の"],["上","うえ"],["で"],["見張","みはり"],["され"],["、"]]},{"verse":33,"text":"谷,たにの土,つちくれも彼,かれには快,こころよく、すべての人,ひとはそのあとに従,したがう。彼,かれの前,まえに行,いった者,ものも数,かぞえきれない。","tok":[["谷","たに"],["の"],["土くれ","つちくれ"],["も"],["彼","かれ"],["に"],["は"],["快よく","こころよく"],["、"],["すべて"],["の"],["人","ひと"],["は"],["その"],["あと"],["に"],["従う","したがう"],["。"],["彼","かれ"],["の"],["前","まえ"],["に"],["行った","いった"],["者","もの"],["も"],["数え","かぞえ"],["きれない"],["。"]]},{"verse":34,"text":"それで、あなたがたはどうしてむなしい事,ことをもって、わたしを慰,なぐさめようとするのか。あなたがたの答,こたえは偽,いつわり以外,いがいの何,なにものでもない」。","tok":[["それ"],["で"],["、"],["あなた"],["がた"],["は"],["どう"],["して"],["むなしい"],["事","こと"],["を"],["もって"],["、"],["わたし"],["を"],["慰さめよう","なぐさめよう"],["と"],["する"],["の"],["か"],["。"],["あなた"],["がた"],["の"],["答","こたえ"],["は"],["偽わり","いつわり"],["以外","いがい"],["の"],["何もの","なにもの"],["で"],["も"],["ない"],["」"],["。"]]}]
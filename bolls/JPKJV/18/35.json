[{"verse":1,"text":"エリフはまた答,こたえて言,いった、","tok":[["エリフ"],["は"],["また"],["答","こたえ"],["て"],["言った","いった"],["、"]]},{"verse":2,"text":"「あなたはこれを正,ただしいと思,おもうのか、あなたは『神,かみの前,まえに自分,じぶんは正,ただしい』と言,いうのか。","tok":[["「"],["あなた"],["は"],["これ"],["を"],["正い","ただしい"],["と"],["思","おもう"],["の"],["か"],["、"],["あなた"],["は"],["『"],["神","かみ"],["の"],["前","まえ"],["に"],["自分","じぶん"],["は"],["正い","ただしい"],["』"],["と"],["言う","いう"],["の"],["か"],["。"]]},{"verse":3,"text":"あなたは言,いう、『これはわたしになんの益,えきがあるか、罪,つみを犯,おかしたのとくらべてなんのまさるところがあるか』と。","tok":[["あなた"],["は"],["言う","いう"],["、"],["『"],["これ"],["は"],["わたし"],["に"],["なん"],["の"],["益","えき"],["が"],["ある"],["か"],["、"],["罪","つみ"],["を"],["犯した","おかした"],["の"],["と"],["くらべて"],["なん"],["の"],["まさる"],["ところ"],["が"],["ある"],["か"],["』"],["と"],["。"]]},{"verse":4,"text":"わたしはあなたおよび、あなたと共,ともにいるあなたの友人,ゆうじんたちに答,こたえよう。","tok":[["わたし"],["は"],["あなた"],["および"],["、"],["あなた"],["と"],["共","とも"],["に"],["いる"],["あなた"],["の"],["友人","ゆうじん"],["たち"],["に"],["答","こたえ"],["よう"],["。"]]},{"verse":5,"text":"天,てんを仰,あおぎ見,みよ、あなたの上,うえなる高,たかき空,そらを望,のぞみ見,みよ。","tok":[["天","てん"],["を"],["仰ぎ見よ","あおぎみよ"],["、"],["あなた"],["の"],["上","うえ"],["なる"],["高き","たかき"],["空","そら"],["を"],["望み見","のぞみみ"],["よ"],["。"]]},{"verse":6,"text":"あなたが罪,つみを犯,おかしても、彼,かれになんのさしさわりがあるか。あなたのとがが多,おおくても、彼,かれに何,なにをなし得,えようか。","tok":[["あなた"],["が"],["罪","つみ"],["を"],["犯して","おかして"],["も"],["、"],["彼","かれ"],["に"],["なん"],["の"],["さし"],["さわり"],["が"],["ある"],["か"],["。"],["あなた"],["の"],["とが"],["が"],["多くて","おおくて"],["も"],["、"],["彼","かれ"],["に"],["何に","なに"],["を"],["なし"],["得よう","えよう"],["か"],["。"]]},{"verse":7,"text":"またあなたは正,ただしくても、彼,かれに何,なにを与,あたえ得,えようか。彼,かれはあなたの手,てから何,なにを受,うけられるであろうか。","tok":[["また"],["あなた"],["は"],["正くて","ただしくて"],["も"],["、"],["彼","かれ"],["に"],["何に","なに"],["を"],["与","あたえ"],["得","え"],["よう"],["か"],["。"],["彼","かれ"],["は"],["あなた"],["の"],["手","て"],["から"],["何に","なに"],["を"],["受られるで","うけられるで"],["あろう"],["か"],["。"]]},{"verse":8,"text":"あなたの悪,あくはただあなたのような人,ひとにかかわり、あなたの義,ぎはただ人,ひとの子,こにかかわるのみだ。","tok":[["あなた"],["の"],["悪","あく"],["は"],["ただ"],["あなた"],["の"],["よう"],["な"],["人","ひと"],["に"],["かかわり"],["、"],["あなた"],["の"],["義","ぎ"],["は"],["ただ"],["人","ひと"],["の"],["子","こ"],["に"],["かかわる"],["のみ"],["だ"],["。"]]},{"verse":9,"text":"しえたげの多,おおいために叫,さけび、力,ちからある者,ものの腕,うでのゆえに呼,よばわる人々,ひとびとがある。","tok":[["し"],["えた"],["げ"],["の"],["多い","おおい"],["ため"],["に"],["叫","さけび"],["、"],["力","ちから"],["ある"],["者","もの"],["の"],["腕","うで"],["の"],["ゆえ"],["に"],["呼ばわる","よばわる"],["人々","ひとびと"],["が"],["ある"],["。"]]},{"verse":10,"text":"しかし、ひとりとして言,いう者,ものはない、『わが造,つくり主,ぬしなる神,かみはどこにおられるか、彼,かれは夜,よの間,まに歌,うたを与,あたえ、","tok":[["しかし"],["、"],["ひとり"],["として"],["言う","いう"],["者","もの"],["は"],["ない"],["、"],["『"],["わが"],["造主","つくりぬし"],["なる"],["神","かみ"],["は"],["どこ"],["に"],["おられる"],["か"],["、"],["彼","かれ"],["は"],["夜","よ"],["の"],["間","ま"],["に"],["歌","うた"],["を"],["与","あたえ"],["、"]]},{"verse":11,"text":"地,ちの獣,けものよりも多,おおく、われわれを教,おしえ、空,そらの鳥,とりよりも、われわれを賢,かしこくされる方,ほうである』と。","tok":[["地","ち"],["の"],["獣","けもの"],["より"],["も"],["多く","おおく"],["、"],["われわれ"],["を"],["教え","おしえ"],["、"],["空","そら"],["の"],["鳥","とり"],["より"],["も"],["、"],["われわれ"],["を"],["賢しこく","かしこく"],["される"],["方","ほう"],["で"],["ある"],["』"],["と"],["。"]]},{"verse":12,"text":"彼,かれらが叫,さけんでも答,こたえられないのは、悪,あしき者,ものの高,たかぶりによる。","tok":[["彼","かれ"],["ら"],["が"],["叫けんで","さけんで"],["も"],["答","こたえ"],["られない"],["の"],["は"],["、"],["悪しき","あしき"],["者","もの"],["の"],["高ぶり","たかぶり"],["に"],["よる"],["。"]]},{"verse":13,"text":"まことに神,かみはむなしい叫,さけびを聞,きかれない。また全能者,ぜんのうしゃはこれを顧,かえりみられない。","tok":[["まこと"],["に"],["神","かみ"],["は"],["むなしい"],["叫","さけび"],["を"],["聞かれない","きかれない"],["。"],["また"],["全能者","ぜんのうしゃ"],["は"],["これ"],["を"],["顧られない","かえりみられない"],["。"]]},{"verse":14,"text":"あなたが彼,かれを見,みないと言,いう時,ときはなおさらだ。さばきは神,かみの前,まえにある。あなたは彼,かれを待,まつべきである。","tok":[["あなた"],["が"],["彼","かれ"],["を"],["見ない","みない"],["と"],["言う","いう"],["時","とき"],["は"],["なおさら"],["だ"],["。"],["さばき"],["は"],["神","かみ"],["の"],["前","まえ"],["に"],["ある"],["。"],["あなた"],["は"],["彼","かれ"],["を"],["待つべきで","まつべきで"],["ある"],["。"]]},{"verse":15,"text":"今,いま彼,かれが怒,いかりをもって罰,ばっせず、罪,つみとがを深,ふかく心,こころにとめられないゆえに","tok":[["今","いま"],["彼","かれ"],["が"],["怒り","いかり"],["を"],["もって"],["罰せず","ばっせず"],["、"],["罪とが","つみとが"],["を"],["深く","ふかく"],["心","こころ"],["に"],["とめられない"],["ゆえ"],["に"]]},{"verse":16,"text":"ヨブは口,くちを開,ひらいてむなしい事,ことを述,のべ、無知,むちの言葉,ことばをしげくする」。","tok":[["ヨブ"],["は"],["口","くち"],["を"],["開らいて","ひらいて"],["むなしい"],["事","こと"],["を"],["述べ","のべ"],["、"],["無知","むち"],["の"],["言葉","ことば"],["を"],["しげく"],["する"],["」"],["。"]]}]
[{"verse":1,"text":"そこでテマンびとエリパズは答,こたえて言,いった、","tok":[["そこ"],["で"],["テマン"],["び"],["と"],["エリパズ"],["は"],["答","こたえ"],["て"],["言った","いった"],["、"]]},{"verse":2,"text":"「知者,ちしゃはむなしき知識,ちしきをもって答,こたえるであろうか。東風,ひがしかぜをもってその腹,はらを満,みたすであろうか。","tok":[["「"],["知者","ちしゃ"],["は"],["むなしき"],["知識","ちしき"],["を"],["もって"],["答","こたえ"],["るで"],["あろう"],["か"],["。"],["東風","ひ"],["が"],["し"],["かぜ"],["を"],["もって"],["その"],["腹","はら"],["を"],["満たすで","みたすで"],["あろう"],["か"],["。"]]},{"verse":3,"text":"役,やくに立,たたない談話,だんわをもって論,ろんじるであろうか。無益,むえきな言葉,ことばをもって争,あらそうであろうか。","tok":[["役","やく"],["に"],["立たない","たたない"],["談話","だんわ"],["を"],["もって"],["論じるで","ろんじるで"],["あろう"],["か"],["。"],["無益","むえき"],["な"],["言葉","ことば"],["を"],["もって"],["争うで","あらそうで"],["あろう"],["か"],["。"]]},{"verse":4,"text":"ところがあなたは神,かみを恐,おそれることを捨,すて、神,かみの前,まえに祈,いのる事,ことをやめている。","tok":[["ところ"],["が"],["あなた"],["は"],["神","かみ"],["を"],["恐れる","おそれる"],["こと"],["を"],["捨て","すて"],["、"],["神","かみ"],["の"],["前","まえ"],["に"],["祈る","いのる"],["事","こと"],["を"],["やめて"],["いる"],["。"]]},{"verse":5,"text":"あなたの罪,つみはあなたの口,くちを教,おしえ、あなたは悪賢,わるがしこい人,ひとの舌,したを選,えらび用,もちいる。","tok":[["あなた"],["の"],["罪","つみ"],["は"],["あなた"],["の"],["口","くち"],["を"],["教え","おしえ"],["、"],["あなた"],["は"],["悪賢い","わるがしこい"],["人","ひと"],["の"],["舌","した"],["を"],["選ら","えら"],["び"],["用いる","もちいる"],["。"]]},{"verse":6,"text":"あなたの口,くちみずからあなたの罪,つみを定,さだめる、わたしではない。あなたのくちびるがあなたに逆,さからって証明,しょうめいする。","tok":[["あなた"],["の"],["口","くち"],["みずから"],["あなた"],["の"],["罪","つみ"],["を"],["定める","さだめる"],["、"],["わたし"],["で"],["は"],["ない"],["。"],["あなた"],["の"],["くちびる"],["が"],["あなた"],["に"],["逆らって","さからって"],["証明","しょうめい"],["する"],["。"]]},{"verse":7,"text":"あなたは最初,さいしょに生,うまれた人,ひとであるのか。山,やまよりも先,さきに生,うまれたのか。","tok":[["あなた"],["は"],["最初","さいしょ"],["に"],["生まれた","うまれた"],["人","ひと"],["で"],["ある"],["の"],["か"],["。"],["山","やま"],["より"],["も"],["先","さき"],["に"],["生まれた","うまれた"],["の"],["か"],["。"]]},{"verse":8,"text":"あなたは神,かみの会議,かいぎにあずかったのか。あなたは知恵,ちえを独占,どくせんしているのか。","tok":[["あなた"],["は"],["神","かみ"],["の"],["会議","かいぎ"],["に"],["あずかった"],["の"],["か"],["。"],["あなた"],["は"],["知恵","ちえ"],["を"],["独占","どくせん"],["して"],["いる"],["の"],["か"],["。"]]},{"verse":9,"text":"あなたが知,しるものはわれわれも知,しるではないか。あなたが悟,さとるものはわれわれも悟,さとるではないか。","tok":[["あなた"],["が"],["知る","しる"],["もの"],["は"],["われわれ"],["も"],["知るで","しるで"],["は"],["ない"],["か"],["。"],["あなた"],["が"],["悟","さとる"],["もの"],["は"],["われわれ"],["も"],["悟","さとる"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":10,"text":"われわれの中,なかにはしらがの人,ひとも、年老,としおいた人,ひともあって、あなたの父,ちちよりも年上,としうえだ。","tok":[["われわれ"],["の"],["中","なか"],["に"],["は"],["しらが"],["の"],["人","ひと"],["も"],["、"],["年老いた","としおいた"],["人","ひと"],["も"],["あって"],["、"],["あなた"],["の"],["父","ちち"],["より"],["も"],["年上","としうえ"],["だ"],["。"]]},{"verse":11,"text":"神,かみの慰,なぐさめおよびあなたに対,たいするやさしい言葉,ことばも、あなたにとって、あまりに小,ちいさいというのか。","tok":[["神","かみ"],["の"],["慰さめ","なぐさめ"],["および"],["あなた"],["に"],["対する","たいする"],["やさしい"],["言葉","ことば"],["も"],["、"],["あなた"],["にとって"],["、"],["あまり"],["に"],["小さい","ちいさい"],["と"],["いう"],["の"],["か"],["。"]]},{"verse":12,"text":"どうしてあなたの心,こころは狂,くるうのか。どうしてあなたの目,めはしばたたくのか。","tok":[["どう"],["して"],["あなた"],["の"],["心","こころ"],["は"],["狂う","くるう"],["の"],["か"],["。"],["どう"],["して"],["あなた"],["の"],["目","め"],["は"],["しばたたく"],["の"],["か"],["。"]]},{"verse":13,"text":"あなたが神,かみにむかって気,きをいらだて、このような言葉,ことばをあなたの口,くちから出,だすのはなぜか。","tok":[["あなた"],["が"],["神","かみ"],["に"],["むかって"],["気","き"],["を"],["いらだて"],["、"],["この"],["よう"],["な"],["言葉","ことば"],["を"],["あなた"],["の"],["口","くち"],["から"],["出す","だす"],["の"],["は"],["なぜ"],["か"],["。"]]},{"verse":14,"text":"人,ひとはいかなる者,ものか、どうしてこれは清,きよくありえよう。女,おんなから生,うまれた者,ものは、どうして正,ただしくありえよう。","tok":[["人","ひと"],["は"],["いかなる"],["者","もの"],["か"],["、"],["どう"],["して"],["これ"],["は"],["清く","きよく"],["あり"],["えよう"],["。"],["女","おんな"],["から"],["生まれた","うまれた"],["者","もの"],["は"],["、"],["どう"],["して"],["正く","ただしく"],["あり"],["えよう"],["。"]]},{"verse":15,"text":"見,みよ、神,かみはその聖,せいなる者,ものにすら信,しんを置,おかれない、もろもろの天,てんも彼,かれの目,めには清,きよくない。","tok":[["見よ","みよ"],["、"],["神","かみ"],["は"],["その"],["聖","せい"],["なる"],["者","もの"],["に"],["すら"],["信","しん"],["を"],["置かれない","おかれない"],["、"],["もろもろ"],["の"],["天","てん"],["も"],["彼","かれ"],["の"],["目","め"],["に"],["は"],["清く","きよく"],["ない"],["。"]]},{"verse":16,"text":"まして憎,にくむべき汚,けがれた者,もの、また不義,ふぎを水,みずのように飲,のむ人,ひとにおいては。","tok":[["まして"],["憎むべき","にくむべき"],["汚","け"],["がれ"],["た"],["者","もの"],["、"],["また"],["不義","ふぎ"],["を"],["水","みず"],["の"],["よう"],["に"],["飲む","のむ"],["人","ひと"],["に"],["おいて"],["は"],["。"]]},{"verse":17,"text":"わたしはあなたに語,かたろう、聞,きくがよい。わたしは自分,じぶんの見,みた事,ことを述,のべよう。","tok":[["わたし"],["は"],["あなた"],["に"],["語ろう","かたろう"],["、"],["聞く","きく"],["が"],["よい"],["。"],["わたし"],["は"],["自分","じぶん"],["の"],["見た","みた"],["事","こと"],["を"],["述べよう","のべよう"],["。"]]},{"verse":18,"text":"これは知者,ちしゃたちがその先祖,せんぞからうけて、隠,かくす所,ところなく語,かたり伝,つたえたものである。","tok":[["これ"],["は"],["知者","ちしゃ"],["たち"],["が"],["その"],["先祖","せんぞ"],["から"],["うけて"],["、"],["隠す","かくす"],["所","ところ"],["なく"],["語り伝えた","かたりつたえた"],["もの"],["で"],["ある"],["。"]]},{"verse":19,"text":"彼,かれらにのみこの地,ちは授,さづけられて、他国,たこく人,じんはその中,なかに行,いき来,きしたことがなかった。","tok":[["彼","かれ"],["ら"],["に"],["のみ"],["この"],["地","ち"],["は"],["授","さ"],["づけられて"],["、"],["他国人","たこくじん"],["は"],["その"],["中","なか"],["に"],["行き来","いきき"],["した"],["こと"],["が"],["なかった"],["。"]]},{"verse":20,"text":"悪,あしき人,ひとは一生,いっしょうの間,あいだ、もだえ苦,くるしむ。残酷,ざんこくな人,ひとには年,としの数,かずが定,さだめられている。","tok":[["悪しき","あしき"],["人","ひと"],["は"],["一生","いっしょう"],["の"],["間","あいだ"],["、"],["もだえ苦しむ","もだえくるしむ"],["。"],["残酷","ざんこく"],["な"],["人","ひと"],["に"],["は"],["年","とし"],["の"],["数","かず"],["が"],["定められて","さだめられて"],["いる"],["。"]]},{"verse":21,"text":"その耳,みみには恐,おそろしい音,おとが聞,きこえ、繁栄,はんえいの時,ときにも滅,ほろぼす者,ものが彼,かれに臨,のぞむ。","tok":[["その"],["耳","みみ"],["に"],["は"],["恐ろしい","おそろしい"],["音","おと"],["が"],["聞こえ","きこえ"],["、"],["繁栄","はんえい"],["の"],["時","とき"],["に"],["も"],["滅ぼす","ほろぼす"],["者","もの"],["が"],["彼","かれ"],["に"],["臨む","のぞむ"],["。"]]},{"verse":22,"text":"彼,かれは、暗,くらやみから帰,かえりうるとは信,しんぜず、つるぎにねらわれる。","tok":[["彼","かれ"],["は"],["、"],["暗やみ","くらやみ"],["から"],["帰えり","かえり"],["うる"],["と"],["は"],["信ぜず","しんぜず"],["、"],["つるぎ"],["に"],["ねらわれる"],["。"]]},{"verse":23,"text":"彼,かれは食物,しょくもつはどこにあるかと言,いいつつさまよい、暗,くらき日,ひが手近,てぢかに備,そなえられてあるのを知,しる。","tok":[["彼","かれ"],["は"],["食物","しょくもつ"],["は"],["どこ"],["に"],["ある"],["か"],["と"],["言い","いい"],["つつ"],["さまよい"],["、"],["暗き","くらき"],["日","ひ"],["が"],["手近","てぢか"],["に"],["備","そなえ"],["られて"],["ある"],["の"],["を"],["知る","しる"],["。"]]},{"verse":24,"text":"悩,なやみと苦,くるしみとが彼,かれを恐,おそれさせ、戦,たたかいの備,そなえをした王,おうのように彼,かれに打,うち勝,かつ。","tok":[["悩み","なやみ"],["と"],["苦しみ","くるしみ"],["と"],["が"],["彼","かれ"],["を"],["恐れさせ","おそれさせ"],["、"],["戦い","たたかい"],["の"],["備","そなえ"],["を"],["した"],["王","おう"],["の"],["よう"],["に"],["彼","かれ"],["に"],["打ち勝つ","うちかつ"],["。"]]},{"verse":25,"text":"これは彼,かれが神,かみに逆,さからってその手,てを伸,のべ、全能者,ぜんのうしゃに逆,さからって高慢,こうまんにふるまい、","tok":[["これ"],["は"],["彼","かれ"],["が"],["神","かみ"],["に"],["逆らって","さからって"],["その"],["手","て"],["を"],["伸べ","のべ"],["、"],["全能者","ぜんのうしゃ"],["に"],["逆らって","さからって"],["高慢","こうまん"],["に"],["ふるまい"],["、"]]},{"verse":26,"text":"盾,たての厚,あつい面,めんをもって強情,ごうじょうに、彼,かれにはせ向,むかうからだ。","tok":[["盾","たて"],["の"],["厚い","あつい"],["面","めん"],["を"],["もって"],["強情","ごうじょう"],["に"],["、"],["彼","かれ"],["に"],["はせ向かう","はせむかう"],["から"],["だ"],["。"]]},{"verse":27,"text":"また彼,かれは脂肪,しぼうをもってその顔,かおをおおい、その腰,こしには脂肪,しぼうの肉,にくを集,あつめ、","tok":[["また"],["彼","かれ"],["は"],["脂肪","しぼう"],["を"],["もって"],["その"],["顔","かお"],["を"],["おおい"],["、"],["その"],["腰","こし"],["に"],["は"],["脂肪","しぼう"],["の"],["肉","にく"],["を"],["集め","あつめ"],["、"]]},{"verse":28,"text":"滅,ほろぼされた町々,まちまちに住,すみ、人,ひとの住,すまない家,いえ、荒塚,あらつかとなる所,ところにおるからだ。","tok":[["滅ぼされた","ほろぼされた"],["町々","まちまち"],["に"],["住み","すみ"],["、"],["人","ひと"],["の"],["住まない","すまない"],["家","いえ"],["、"],["荒塚","あらつか"],["と"],["なる"],["所","ところ"],["に"],["おる"],["から"],["だ"],["。"]]},{"verse":29,"text":"彼,かれは富,とめる者,ものとならず、その富,とみはながく続,つづかない、また地,ちに根,ねを張,はることはない。","tok":[["彼","かれ"],["は"],["富める","とめる"],["者","もの"],["と"],["ならず"],["、"],["その"],["富","とみ"],["は"],["ながく"],["続かない","つづかない"],["、"],["また"],["地","ち"],["に"],["根","ね"],["を"],["張る","はる"],["こと"],["は"],["ない"],["。"]]},{"verse":30,"text":"彼,かれは暗,くらやみからのがれることができない。炎,ほのおはその若,わか枝,えだを枯,からし、その花,はなは風,かぜに吹,ふき去,さられる。","tok":[["彼","かれ"],["は"],["暗やみ","くらやみ"],["から"],["のがれる"],["こと"],["が"],["できない"],["。"],["炎","ほのお"],["は"],["その"],["若枝","わかえだ"],["を"],["枯らし","からし"],["、"],["その"],["花","はな"],["は"],["風","かぜ"],["に"],["吹","ふき"],["去られる","さられる"],["。"]]},{"verse":31,"text":"彼,かれをしてみずから欺,あざむいて、むなしい事,ことにたよらせてはならない。その報,むくいはむなしいからだ。","tok":[["彼","かれ"],["を"],["して"],["みずから"],["欺いて","あざむいて"],["、"],["むなしい"],["事","こと"],["に"],["たよらせて"],["は"],["ならない"],["。"],["その"],["報い","むくい"],["は"],["むなしい"],["から"],["だ"],["。"]]},{"verse":32,"text":"彼,かれの時,ときのこない前,まえにその事,ことがなし遂,とげられ、彼,かれの枝,えだは緑,みどりとならないであろう。","tok":[["彼","かれ"],["の"],["時","とき"],["の"],["こない"],["前","まえ"],["に"],["その"],["事","こと"],["が"],["なし遂げられ","なしとげられ"],["、"],["彼","かれ"],["の"],["枝","えだ"],["は"],["緑","みどり"],["と"],["ならないで"],["あろう"],["。"]]},{"verse":33,"text":"彼,かれはぶどうの木,きのように、その熟,じゅくさない実,みをふり落,おとすであろう。またオリブの木,きのように、その花,はなを落,おとすであろう。","tok":[["彼","かれ"],["は"],["ぶどう"],["の"],["木","き"],["の"],["よう"],["に"],["、"],["その"],["熟さない","じゅくさない"],["実","み"],["を"],["ふり落とすで","ふりおとすで"],["あろう"],["。"],["また"],["オリブ"],["の"],["木","き"],["の"],["よう"],["に"],["、"],["その"],["花","はな"],["を"],["落とすで","おとすで"],["あろう"],["。"]]},{"verse":34,"text":"神,かみを信,しんじない者,もののやからは子,こなく、まいないによる天幕,てんまくは火,ひで焼,やき滅,ほろぼされるからだ。","tok":[["神","かみ"],["を"],["信じない","しんじない"],["者","もの"],["の"],["やから"],["は"],["子","こ"],["なく"],["、"],["まいない"],["に"],["よる"],["天幕","てんまく"],["は"],["火","ひ"],["で"],["焼き滅ぼされる","やきほろぼされる"],["から"],["だ"],["。"]]},{"verse":35,"text":"彼,かれらは害悪,がいあくをはらみ、不義,ふぎを生,うみ、その腹,はらは偽,いつわりをつくる」。","tok":[["彼","かれ"],["ら"],["は"],["害悪","がいあく"],["を"],["はらみ"],["、"],["不義","ふぎ"],["を"],["生み","うみ"],["、"],["その"],["腹","はら"],["は"],["偽り","いつわり"],["を"],["つくる"],["」"],["。"]]}]
[{"verse":1,"text":"エリフはまた答,こたえて言,いった、","tok":[["エリフ"],["は"],["また"],["答","こたえ"],["て"],["言った","いった"],["、"]]},{"verse":2,"text":"「あなたがた知恵,ちえある人々,ひとびとよ、わたしの言葉,ことばを聞,きけ、あなたがた知識,ちしきある人々,ひとびとよ、わたしに耳,みみを傾,かたむけよ。","tok":[["「"],["あなた"],["がた"],["知恵","ちえ"],["ある"],["人々","ひとびと"],["よ"],["、"],["わたし"],["の"],["言葉","ことば"],["を"],["聞け","きけ"],["、"],["あなた"],["がた"],["知識","ちしき"],["ある"],["人々","ひとびと"],["よ"],["、"],["わたし"],["に"],["耳","みみ"],["を"],["傾むけよ","かたむけよ"],["。"]]},{"verse":3,"text":"口,くちが食物,しょくもつを味,あじわうように、耳,みみは言葉,ことばをわきまえるからだ。","tok":[["口","くち"],["が"],["食物","しょくもつ"],["を"],["味わう","あじわう"],["よう"],["に"],["、"],["耳","みみ"],["は"],["言葉","ことば"],["を"],["わきまえる"],["から"],["だ"],["。"]]},{"verse":4,"text":"われわれは正,ただしい事,ことを選,えらび、われわれの間,あいだに良,よい事,ことの何,なにであるかを明,あきらかにしよう。","tok":[["われわれ"],["は"],["正い","ただしい"],["事","こと"],["を"],["選ら","えら"],["び"],["、"],["われわれ"],["の"],["間","あいだ"],["に"],["良い","よい"],["事","こと"],["の"],["何","な"],["に"],["で"],["ある"],["か"],["を"],["明か","あきらか"],["に"],["しよう"],["。"]]},{"verse":5,"text":"ヨブは言,いった、『わたしは正,ただしい、神,かみはわたしの公義,こうぎを奪,うばわれた。","tok":[["ヨブ"],["は"],["言った","いった"],["、"],["『"],["わたし"],["は"],["正い","ただしい"],["、"],["神","かみ"],["は"],["わたし"],["の"],["公義","こうぎ"],["を"],["奪われた","うばわれた"],["。"]]},{"verse":6,"text":"わたしは正,ただしいにもかかわらず、偽,いつわる者,ものとされた。わたしにはとががないけれども、わたしの矢,や傷,きずはいえない』と。","tok":[["わたし"],["は"],["正い","ただしい"],["に"],["も"],["かかわらず"],["、"],["偽わる","いつわる"],["者","もの"],["と"],["された"],["。"],["わたし"],["に"],["は"],["とが"],["が"],["ない"],["けれど"],["も"],["、"],["わたし"],["の"],["矢傷","やきず"],["は"],["いえない"],["』"],["と"],["。"]]},{"verse":7,"text":"だれかヨブのような人,ひとがあろう。彼,かれはあざけりを水,みずのように飲,のみ、","tok":[["だれ"],["か"],["ヨブ"],["の"],["よう"],["な"],["人","ひと"],["が"],["あろう"],["。"],["彼","かれ"],["は"],["あざけり"],["を"],["水","みず"],["の"],["よう"],["に"],["飲み","のみ"],["、"]]},{"verse":8,"text":"悪,あくをなす者,ものどもと交,まじわり、悪人,あくにんと共,ともに歩,あゆむ。","tok":[["悪","あく"],["を"],["なす"],["者","もの"],["ども"],["と"],["交じわり","まじわり"],["、"],["悪人","あくにん"],["と"],["共","とも"],["に"],["歩む","あゆむ"],["。"]]},{"verse":9,"text":"彼,かれは言,いった、『人,ひとは神,かみと親,したしんでも、なんの益,えきもない』と。","tok":[["彼","かれ"],["は"],["言った","いった"],["、"],["『"],["人","ひと"],["は"],["神","かみ"],["と"],["親しんで","したしんで"],["も"],["、"],["なん"],["の"],["益","えき"],["も"],["ない"],["』"],["と"],["。"]]},{"verse":10,"text":"それであなたがた理解,りかいある人々,ひとびとよ、わたしに聞,きけ、神,かみは断,だんじて悪,あくを行,おこなうことなく、全能者,ぜんのうしゃは断,だんじて不義,ふぎを行,おこなうことはない。","tok":[["それ"],["で"],["あなた"],["がた"],["理解","りかい"],["ある"],["人々","ひとびと"],["よ"],["、"],["わたし"],["に"],["聞け","きけ"],["、"],["神","かみ"],["は"],["断じて","だんじて"],["悪","あく"],["を"],["行なう","おこなう"],["こと"],["なく"],["、"],["全能者","ぜんのうしゃ"],["は"],["断じて","だんじて"],["不義","ふぎ"],["を"],["行なう","おこなう"],["こと"],["は"],["ない"],["。"]]},{"verse":11,"text":"神,かみは人,ひとのわざにしたがってその身,みに報,むくい、おのおのの道,みちにしたがって、その身,みに振,ふりかからせられる。","tok":[["神","かみ"],["は"],["人","ひと"],["の"],["わざ"],["に"],["したがって"],["その"],["身","み"],["に"],["報い","むくい"],["、"],["おのおの"],["の"],["道","みち"],["に"],["したがって"],["、"],["その"],["身","み"],["に"],["振り","ふり"],["かからせられる"],["。"]]},{"verse":12,"text":"まことに神,かみは悪,あしき事,ことを行,おこなわれない。全能者,ぜんのうしゃはさばきをまげられない。","tok":[["まこと"],["に"],["神","かみ"],["は"],["悪しき","あしき"],["事","こと"],["を"],["行なわれない","おこなわれない"],["。"],["全能者","ぜんのうしゃ"],["は"],["さばき"],["を"],["まげられない"],["。"]]},{"verse":13,"text":"だれかこの地,ちを彼,かれにゆだねた者,ものがあるか。だれか全,ぜん世界,せかいを彼,かれに負,おわせた者,ものがあるか。","tok":[["だれ"],["か"],["この"],["地","ち"],["を"],["彼","かれ"],["に"],["ゆだねた"],["者","もの"],["が"],["ある"],["か"],["。"],["だれ"],["か"],["全","ぜん"],["世界","せかい"],["を"],["彼","かれ"],["に"],["負わせた","おわせた"],["者","もの"],["が"],["ある"],["か"],["。"]]},{"verse":14,"text":"神,かみがもしその霊,れいをご自分,じぶんに取,とりもどし、その息,いきをご自分,じぶんに取,とりあつめられるならば、","tok":[["神","かみ"],["が"],["もし"],["その"],["霊","れい"],["を"],["ご自分","ごじぶん"],["に"],["取","とり"],["もどし"],["、"],["その"],["息","いき"],["を"],["ご自分","ごじぶん"],["に"],["取","とり"],["あつめられるならば"],["、"]]},{"verse":15,"text":"すべての肉,にくは共,ともに滅,ほろび、人,ひとはちりに帰,かえるであろう。","tok":[["すべて"],["の"],["肉","にく"],["は"],["共","とも"],["に"],["滅び","ほろび"],["、"],["人","ひと"],["は"],["ちり"],["に"],["帰えるで","かえるで"],["あろう"],["。"]]},{"verse":16,"text":"もし、あなたに悟,さとりがあるならば、これを聞,きけ、わたしの言,いうところに耳,みみを傾,かたむけよ。","tok":[["もし"],["、"],["あなた"],["に"],["悟り","さとり"],["が"],["あるならば"],["、"],["これ"],["を"],["聞け","きけ"],["、"],["わたし"],["の"],["言う","いう"],["ところ"],["に"],["耳","みみ"],["を"],["傾むけよ","かたむけよ"],["。"]]},{"verse":17,"text":"公義,こうぎを憎,にくむ者,ものは世,よを治,おさめることができようか。正,ただしく力,ちからある者,ものを、あなたは非難,ひなんするであろうか。","tok":[["公義","こうぎ"],["を"],["憎む","にくむ"],["者","もの"],["は"],["世","よ"],["を"],["治める","おさめる"],["こと"],["が"],["できよう"],["か"],["。"],["正く","ただしく"],["力","ちから"],["ある"],["者","もの"],["を"],["、"],["あなた"],["は"],["非難","ひなん"],["するで"],["あろう"],["か"],["。"]]},{"verse":18,"text":"王,おうたる者,ものに向,むかって『よこしまな者,もの』と言,いい、つかさたる者,ものに向,むかって、『悪,あしき者,もの』と言,いうことができるであろうか。","tok":[["王","おう"],["たる"],["者","もの"],["に"],["向かって","むかって"],["『"],["よこしま"],["な"],["者","もの"],["』"],["と"],["言い","いい"],["、"],["つかさ"],["たる"],["者","もの"],["に"],["向かって","むかって"],["、"],["『"],["悪しき","あしき"],["者","もの"],["』"],["と"],["言う","いう"],["こと"],["が"],["できるで"],["あろう"],["か"],["。"]]},{"verse":19,"text":"神,かみは君,くんたる者,ものをもかたより見,みられることなく、富,とめる者,ものを貧,まずしき者,ものにまさって顧,かえりみられることはない。彼,かれらは皆,みなみ手,てのわざだからである。","tok":[["神","かみ"],["は"],["君","くん"],["たる"],["者","もの"],["を"],["も"],["かた"],["より"],["見られる","みられる"],["こと"],["なく"],["、"],["富める","とめる"],["者","もの"],["を"],["貧しき","まずしき"],["者","もの"],["に"],["まさって"],["顧られる","かえりみられる"],["こと"],["は"],["ない"],["。"],["彼","かれ"],["ら"],["は"],["皆","みな"],["み手","みて"],["の"],["わざ"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":20,"text":"彼,かれらはまたたく間,まに死,しに、民,たみは夜,よるの間,あいだに振,ふわれて、消,きえうせ、力,ちからある者,ものも人手,ひとでによらずに除,のぞかれる。","tok":[["彼","かれ"],["ら"],["は"],["またたく"],["間","ま"],["に"],["死に","しに"],["、"],["民","たみ"],["は"],["夜","よる"],["の"],["間","あいだ"],["に"],["振われて","ふわれて"],["、"],["消えうせ","きえうせ"],["、"],["力","ちから"],["ある"],["者","もの"],["も"],["人手","ひとで"],["に"],["よらず"],["に"],["除かれる","のぞかれる"],["。"]]},{"verse":21,"text":"神,かみの目,めが人,ひとの道,みちの上,うえにあって、そのすべての歩,あゆみを見,みられるからだ。","tok":[["神","かみ"],["の"],["目","め"],["が"],["人","ひと"],["の"],["道","みち"],["の"],["上","うえ"],["に"],["あって"],["、"],["その"],["すべて"],["の"],["歩み","あゆみ"],["を"],["見られる","みられる"],["から"],["だ"],["。"]]},{"verse":22,"text":"悪,あくを行,おこなう者,ものには身,みを隠,かくすべき暗,くらやみもなく、暗黒,あんこくもない。","tok":[["悪","あく"],["を"],["行なう","おこなう"],["者","もの"],["に"],["は"],["身","み"],["を"],["隠すべき","かくすべき"],["暗やみ","くらやみ"],["も"],["なく"],["、"],["暗黒","あんこく"],["も"],["ない"],["。"]]},{"verse":23,"text":"人,ひとがさばきのために神,かみの前,まえに出,でるとき、神,かみは人,ひとのために時,ときを定,さだめておかれない。","tok":[["人","ひと"],["が"],["さばき"],["の"],["ため"],["に"],["神","かみ"],["の"],["前","まえ"],["に"],["出る","でる"],["とき"],["、"],["神","かみ"],["は"],["人","ひと"],["の"],["ため"],["に"],["時","とき"],["を"],["定めて","さだめて"],["おかれない"],["。"]]},{"verse":24,"text":"彼,かれは力,ちからある者,ものをも調,しらべることなく打,うち滅,ほろぼし、他,たの人々,ひとびとを立,たてて、これに替,かえられる。","tok":[["彼","かれ"],["は"],["力","ちから"],["ある"],["者","もの"],["を"],["も"],["調べる","しらべる"],["こと"],["なく"],["打ち滅ぼし","うちほろぼし"],["、"],["他","た"],["の"],["人々","ひとびと"],["を"],["立てて","たてて"],["、"],["これ"],["に"],["替えられる","かえられる"],["。"]]},{"verse":25,"text":"このように、神,かみは彼,かれらのわざを知,しり、夜,よるの間,あいだに彼,かれらをくつがえされるので、彼,かれらはやがて滅,ほろびる。","tok":[["この"],["よう"],["に"],["、"],["神","かみ"],["は"],["彼","かれ"],["ら"],["の"],["わざ"],["を"],["知り","しり"],["、"],["夜","よる"],["の"],["間","あいだ"],["に"],["彼","かれ"],["ら"],["を"],["くつがえされる"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["やがて"],["滅びる","ほろびる"],["。"]]},{"verse":26,"text":"彼,かれは人々,ひとびとの見,みる所,ところで、彼,かれらをその悪,あくのために撃,うたれる。","tok":[["彼","かれ"],["は"],["人々","ひとびと"],["の"],["見る","みる"],["所","ところ"],["で"],["、"],["彼","かれ"],["ら"],["を"],["その"],["悪","あく"],["の"],["ため"],["に"],["撃たれる","うたれる"],["。"]]},{"verse":27,"text":"これは彼,かれらがそむいて彼,かれに従,したがわず、その道,みちを全,まったく顧,かえりみないからだ。","tok":[["これ"],["は"],["彼","かれ"],["ら"],["が"],["そむいて"],["彼","かれ"],["に"],["従わず","したがわず"],["、"],["その"],["道","みち"],["を"],["全く","まったく"],["顧ない","かえりみない"],["から"],["だ"],["。"]]},{"verse":28,"text":"こうして彼,かれらは貧,まずしき者,ものの叫,さけびを彼,かれのもとにいたらせ、悩,なやめる者,ものの叫,さけびを彼,かれに聞,きかせる。","tok":[["こう"],["して"],["彼","かれ"],["ら"],["は"],["貧しき","まずしき"],["者","もの"],["の"],["叫","さけび"],["を"],["彼","かれ"],["の"],["もと"],["に"],["いたらせ"],["、"],["悩める","なやめる"],["者","もの"],["の"],["叫","さけび"],["を"],["彼","かれ"],["に"],["聞かせる","きかせる"],["。"]]},{"verse":29,"text":"彼,かれが黙,だまっておられるとき、だれが非難,ひなんすることができようか。彼,かれが顔,かおを隠,かくされるとき、だれが彼,かれを見,みることができようか。一国,こくの上,うえにも、一人,にんの上,うえにも同様,どうようだ。","tok":[["彼","かれ"],["が"],["黙って","だまって"],["おられる"],["とき"],["、"],["だれ"],["が"],["非難","ひなん"],["する"],["こと"],["が"],["できよう"],["か"],["。"],["彼","かれ"],["が"],["顔","かお"],["を"],["隠される","かくされる"],["とき"],["、"],["だれ"],["が"],["彼","かれ"],["を"],["見る","みる"],["こと"],["が"],["できよう"],["か"],["。"],["一国","こく"],["の"],["上","うえ"],["に"],["も"],["、"],["一人","にん"],["の"],["上","うえ"],["に"],["も"],["同様","どうよう"],["だ"],["。"]]},{"verse":30,"text":"これは神,かみを信,しんじない者,ものが世,よを治,おさめることがなく、民,たみをわなにかける事,ことのないようにするためである。","tok":[["これ"],["は"],["神","かみ"],["を"],["信じない","しんじない"],["者","もの"],["が"],["世","よ"],["を"],["治める","おさめる"],["こと"],["が"],["なく"],["、"],["民","たみ"],["を"],["わな"],["に"],["かける"],["事","こと"],["の"],["ない"],["よう"],["に"],["する"],["ため"],["で"],["ある"],["。"]]},{"verse":31,"text":"だれが神,かみに向,むかって言,いったか、『わたしは罪,つみを犯,おかさないのに、懲,こらしめられた。","tok":[["だれ"],["が"],["神","かみ"],["に"],["向かって","むかって"],["言った","いった"],["か"],["、"],["『"],["わたし"],["は"],["罪","つみ"],["を"],["犯さない","おかさない"],["のに"],["、"],["懲らしめられた","こらしめられた"],["。"]]},{"verse":32,"text":"わたしの見,みないものをわたしに教,おしえられたい。もしわたしが悪,わるい事,ことをしたなら、重,かさねてこれをしない』と。","tok":[["わたし"],["の"],["見ない","みない"],["もの"],["を"],["わたし"],["に"],["教えられたい","おしえられたい"],["。"],["もし"],["わたし"],["が"],["悪い","わるい"],["事","こと"],["を"],["したなら"],["、"],["重ねて","かさねて"],["これ"],["を"],["しない"],["』"],["と"],["。"]]},{"verse":33,"text":"あなたが拒,こばむゆえに、彼,かれはあなたの好,このむように報,むくいをされるであろうか。あなたみずから選,えらぶがよい、わたしはしない。あなたの知,しるところを言,いいなさい。","tok":[["あなた"],["が"],["拒む","こばむ"],["ゆえ"],["に"],["、"],["彼","かれ"],["は"],["あなた"],["の"],["好む","このむ"],["よう"],["に"],["報い","むくい"],["を"],["されるで"],["あろう"],["か"],["。"],["あなた"],["みずから"],["選ぶ","えらぶ"],["がよい"],["、"],["わたし"],["は"],["しない"],["。"],["あなた"],["の"],["知る","しる"],["ところ"],["を"],["言い","いい"],["なさい"],["。"]]},{"verse":34,"text":"悟,さとりある人々,ひとびとはわたしに言,いうだろう、わたしに聞,きくところの知恵,ちえある人,ひとは言,いうだろう、","tok":[["悟り","さとり"],["ある"],["人々","ひとびと"],["は"],["わたし"],["に"],["言うだろう","いうだろう"],["、"],["わたし"],["に"],["聞く","きく"],["ところ"],["の"],["知恵","ちえ"],["ある"],["人","ひと"],["は"],["言うだろう","いうだろう"],["、"]]},{"verse":35,"text":"『ヨブの言,いうところは知識,ちしきがなく、その言葉,ことばは悟,さとりがない』と。","tok":[["『"],["ヨブ"],["の"],["言う","いう"],["ところ"],["は"],["知識","ちしき"],["が"],["なく"],["、"],["その"],["言葉","ことば"],["は"],["悟り","さとり"],["が"],["ない"],["』"],["と"],["。"]]},{"verse":36,"text":"どうかヨブが終,おわりまで試,こころみられるように、彼,かれは悪人,あくにんのように答,こたえるからである。","tok":[["どう"],["か"],["ヨブ"],["が"],["終","おわり"],["まで"],["試みられる","こころみられる"],["よう"],["に"],["、"],["彼","かれ"],["は"],["悪人","あくにん"],["の"],["よう"],["に"],["答","こたえ"],["る"],["から"],["で"],["ある"],["。"]]},{"verse":37,"text":"彼,かれは自分,じぶんの罪,つみに、とがを加,くわえ、われわれの中,なかにあって手,てをうち、神,かみに逆,さからって、その言葉,ことばをしげくする」。","tok":[["彼","かれ"],["は"],["自分","じぶん"],["の"],["罪","つみ"],["に"],["、"],["とが"],["を"],["加え","くわえ"],["、"],["われわれ"],["の"],["中","なか"],["に"],["あって"],["手","て"],["を"],["うち"],["、"],["神","かみ"],["に"],["逆らって","さからって"],["、"],["その"],["言葉","ことば"],["を"],["しげく"],["する"],["」"],["。"]]}]
[{"verse":1,"text":"この時,とき、主,しゅはつむじ風,かぜの中,なかからヨブに答,こたえられた、","tok":[["この"],["時","とき"],["、"],["主","しゅ"],["は"],["つむじ風","つむじかぜ"],["の"],["中","なか"],["から"],["ヨブ"],["に"],["答","こたえ"],["られた"],["、"]]},{"verse":2,"text":"「無知,むちの言葉,ことばをもって、神,かみの計,はかりごとを暗,くらくするこの者,ものはだれか。","tok":[["「"],["無知","むち"],["の"],["言葉","ことば"],["を"],["もって"],["、"],["神","かみ"],["の"],["計り","はかり"],["ごと"],["を"],["暗く","くらく"],["する"],["この"],["者","もの"],["は"],["だれ"],["か"],["。"]]},{"verse":3,"text":"あなたは腰,こしに帯,おびして、男,おとこらしくせよ。わたしはあなたに尋,たずねる、わたしに答,こたえよ。","tok":[["あなた"],["は"],["腰","こし"],["に"],["帯び","おび"],["して"],["、"],["男","おとこ"],["らしく"],["せよ"],["。"],["わたし"],["は"],["あなた"],["に"],["尋ねる","たずねる"],["、"],["わたし"],["に"],["答","こたえ"],["よ"],["。"]]},{"verse":4,"text":"わたしが地,ちの基,もといをすえた時,とき、どこにいたか。もしあなたが知,しっているなら言,いえ。","tok":[["わたし"],["が"],["地","ち"],["の"],["基い","もとい"],["を"],["すえた"],["時","とき"],["、"],["どこ"],["に"],["いた"],["か"],["。"],["もし"],["あなた"],["が"],["知って","しって"],["いるなら"],["言え","いえ"],["。"]]},{"verse":5,"text":"あなたがもし知,しっているなら、だれがその度量,どりょうを定,さだめたか。だれが測,はかりなわを地,ちの上,うえに張,はったか。","tok":[["あなた"],["が"],["もし"],["知って","しって"],["いるなら"],["、"],["だれ"],["が"],["その"],["度量","どりょう"],["を"],["定めた","さだめた"],["か"],["。"],["だれ"],["が"],["測り","はかり"],["なわ"],["を"],["地","ち"],["の"],["上","うえ"],["に"],["張った","はった"],["か"],["。"]]},{"verse":6,"text":"その土台,どだいは何,なにの上,うえに置,おかれたか。その隅,すみの石,いしはだれがすえたか。","tok":[["その"],["土台","どだい"],["は"],["何","なに"],["の"],["上","うえ"],["に"],["置かれた","おかれた"],["か"],["。"],["その"],["隅","すみ"],["の"],["石","いし"],["は"],["だれ"],["が"],["すえた"],["か"],["。"]]},{"verse":7,"text":"かの時,ときには明,あけの星,ほしは相,あい共,ともに歌,うたい、神,かみの子,こたちはみな喜,よろこび呼,よばわった。","tok":[["かの"],["時","とき"],["に"],["は"],["明け","あけ"],["の"],["星","ほし"],["は"],["相","あ"],["い"],["共","とも"],["に"],["歌い","うたい"],["、"],["神","かみ"],["の"],["子","こ"],["たち"],["は"],["みな"],["喜こび","よろこび"],["呼ばわった","よばわった"],["。"]]},{"verse":8,"text":"海,うみの水,みずが流,ながれいで、胎内,たいないからわき出,でたとき、だれが戸,とをもって、これを閉,とじこめたか。","tok":[["海","うみ"],["の"],["水","みず"],["が"],["流","な"],["が"],["れい"],["で"],["、"],["胎内","たいない"],["から"],["わき出た","わきでた"],["とき"],["、"],["だれ"],["が"],["戸","と"],["を"],["もって"],["、"],["これ"],["を"],["閉じこめた","とじこめた"],["か"],["。"]]},{"verse":9,"text":"あの時,とき、わたしは雲,くもをもって衣,ころもとし、黒雲,くろくもをもってむつきとし、","tok":[["あの"],["時","とき"],["、"],["わたし"],["は"],["雲","くも"],["を"],["もって"],["衣","ころも"],["と"],["し"],["、"],["黒雲","くろくも"],["を"],["もって"],["むつき"],["と"],["し"],["、"]]},{"verse":10,"text":"これがために境,さかいを定,さだめ、関,かんおよび戸,とを設,もうけて、","tok":[["これ"],["が"],["ため"],["に"],["境","さかい"],["を"],["定め","さだめ"],["、"],["関","かん"],["および"],["戸","と"],["を"],["設けて","もうけて"],["、"]]},{"verse":11,"text":"言,いった、『ここまで来,きてもよい、越,こえてはならぬ、おまえの高波,たかなみはここにとどまるのだ』と。","tok":[["言った","いった"],["、"],["『"],["ここ"],["まで"],["来て","きて"],["も"],["よい"],["、"],["越えて","こえて"],["は"],["ならぬ"],["、"],["おまえ"],["の"],["高波","たかなみ"],["は"],["ここ"],["に"],["とどまる"],["の"],["だ"],["』"],["と"],["。"]]},{"verse":12,"text":"あなたは生,うまれた日,ひからこのかた朝,あさに命,めいじ、夜明,よあけにその所,ところを知,しらせ、","tok":[["あなた"],["は"],["生まれた","うまれた"],["日","ひ"],["から"],["このかた"],["朝","あさ"],["に"],["命じ","めいじ"],["、"],["夜明","よあけ"],["に"],["その"],["所","ところ"],["を"],["知らせ","しらせ"],["、"]]},{"verse":13,"text":"これに地,ちの縁,ふちをとらえさせ、悪人,あくにんをその上,うえから振,ふり落,おとさせたことがあるか。","tok":[["これ"],["に"],["地","ち"],["の"],["縁","ふち"],["を"],["とらえさせ"],["、"],["悪人","あくにん"],["を"],["その"],["上","うえ"],["から"],["振り落とさせた","ふりおとさせた"],["こと"],["が"],["ある"],["か"],["。"]]},{"verse":14,"text":"地,ちは印,いんせられた土,つちのように変,かわり、衣,ころものようにいろどられる。","tok":[["地","ち"],["は"],["印せられた","いんせられた"],["土","つち"],["の"],["よう"],["に"],["変わり","かわり"],["、"],["衣","ころも"],["の"],["よう"],["に"],["いろどられる"],["。"]]},{"verse":15,"text":"悪人,あくにんはその光,ひかりを奪,うばわれ、その高,たかくあげた腕,うでは折,おられる。","tok":[["悪人","あくにん"],["は"],["その"],["光","ひかり"],["を"],["奪われ","うばわれ"],["、"],["その"],["高く","たかく"],["あげた"],["腕","うで"],["は"],["折られる","おられる"],["。"]]},{"verse":16,"text":"あなたは海,うみの源,みなもとに行,いったことがあるか。淵,ふちの底,そこを歩,あるいたことがあるか。","tok":[["あなた"],["は"],["海","うみ"],["の"],["源","みなもと"],["に"],["行った","いった"],["こと"],["が"],["ある"],["か"],["。"],["淵","ふち"],["の"],["底","そこ"],["を"],["歩いた","あるいた"],["こと"],["が"],["ある"],["か"],["。"]]},{"verse":17,"text":"死,しの門,もんはあなたのために開,ひらかれたか。あなたは暗黒,あんこくの門,もんを見,みたことがあるか。","tok":[["死","し"],["の"],["門","もん"],["は"],["あなた"],["の"],["ため"],["に"],["開らかれた","ひらかれた"],["か"],["。"],["あなた"],["は"],["暗黒","あんこく"],["の"],["門","もん"],["を"],["見た","みた"],["こと"],["が"],["ある"],["か"],["。"]]},{"verse":18,"text":"あなたは地,ちの広,ひろさを見,みきわめたか。もしこれをことごとく知,しっているならば言,いえ。","tok":[["あなた"],["は"],["地","ち"],["の"],["広さ","ひろさ"],["を"],["見きわめた","みきわめた"],["か"],["。"],["もし"],["これ"],["を"],["ことごとく"],["知って","しって"],["いるならば"],["言え","いえ"],["。"]]},{"verse":19,"text":"光,ひかりのある所,ところに至,いたる道,みちはいずれか。暗,くらやみのある所,ところはどこか。","tok":[["光","ひかり"],["の"],["ある"],["所","ところ"],["に"],["至る","いたる"],["道","みち"],["は"],["いずれ"],["か"],["。"],["暗やみ","くらやみ"],["の"],["ある"],["所","ところ"],["は"],["どこ"],["か"],["。"]]},{"verse":20,"text":"あなたはこれをその境,さかいに導,みちびくことができるか。その家路,いえじを知,しっているか。","tok":[["あなた"],["は"],["これ"],["を"],["その"],["境","さかい"],["に"],["導く","みちびく"],["こと"],["が"],["できる"],["か"],["。"],["その"],["家路","いえじ"],["を"],["知って","しって"],["いる"],["か"],["。"]]},{"verse":21,"text":"あなたは知,しっているだろう、あなたはかの時,ときすでに生,うまれており、またあなたの日,ひ数,かずも多,おおいのだから。","tok":[["あなた"],["は"],["知って","しって"],["いるだろう"],["、"],["あなた"],["は"],["かの"],["時","とき"],["すでに"],["生まれて","うまれて"],["おり"],["、"],["また"],["あなた"],["の"],["日数","ひかず"],["も"],["多い","おおい"],["の"],["だ"],["から"],["。"]]},{"verse":22,"text":"あなたは雪,ゆきの倉,くらにはいったことがあるか。ひょうの倉,くらを見,みたことがあるか。","tok":[["あなた"],["は"],["雪","ゆき"],["の"],["倉","くら"],["に"],["はいった"],["こと"],["が"],["ある"],["か"],["。"],["ひょう"],["の"],["倉","くら"],["を"],["見た","みた"],["こと"],["が"],["ある"],["か"],["。"]]},{"verse":23,"text":"これらは悩,なやみの時,ときのため、いくさと戦,たたかいの日,ひのため、わたしがたくわえて置,おいたものだ。","tok":[["これ"],["ら"],["は"],["悩み","なやみ"],["の"],["時","とき"],["の"],["ため"],["、"],["いくさ"],["と"],["戦い","たたかい"],["の"],["日","ひ"],["の"],["ため"],["、"],["わたし"],["が"],["たくわえて"],["置いた","おいた"],["もの"],["だ"],["。"]]},{"verse":24,"text":"光,ひかりの広,ひろがる道,みちはどこか。東風,ひがしかぜの地,ちに吹,ふき渡,わたる道,みちはどこか。","tok":[["光","ひかり"],["の"],["広がる","ひろがる"],["道","みち"],["は"],["どこ"],["か"],["。"],["東風","ひ"],["が"],["し"],["かぜ"],["の"],["地","ち"],["に"],["吹","ふき"],["渡る","わたる"],["道","みち"],["は"],["どこ"],["か"],["。"]]},{"verse":25,"text":"だれが大雨,おおあめのために水路,すいろを切,きり開,ひらき、いかずちの光,ひかりのために道,みちを開,ひらき、","tok":[["だれ"],["が"],["大雨","おおあめ"],["の"],["ため"],["に"],["水路","すいろ"],["を"],["切り","きり"],["開らき","ひらき"],["、"],["いかずち"],["の"],["光","ひかり"],["の"],["ため"],["に"],["道","みち"],["を"],["開らき","ひらき"],["、"]]},{"verse":26,"text":"人,ひとなき地,ちにも、人,ひとなき荒野,あらのにも雨,あめを降,ふらせ、","tok":[["人","ひと"],["なき"],["地","ち"],["に"],["も"],["、"],["人","ひと"],["なき"],["荒野","あらの"],["に"],["も"],["雨","あめ"],["を"],["降らせ","ふらせ"],["、"]]},{"verse":27,"text":"荒,あれすたれた地,ちをあき足,たらせ、これに若草,わかくさをはえさせるか。","tok":[["荒れ","あれ"],["すたれた"],["地","ち"],["を"],["あき足らせ","あきたらせ"],["、"],["これ"],["に"],["若草","わかくさ"],["を"],["は"],["え"],["させる"],["か"],["。"]]},{"verse":28,"text":"雨,あめに父,ちちがあるか。露,つゆの玉,たまはだれが生,うんだか。","tok":[["雨","あめ"],["に"],["父","ちち"],["が"],["ある"],["か"],["。"],["露","つゆ"],["の"],["玉","たま"],["は"],["だれ"],["が"],["生んだ","うんだ"],["か"],["。"]]},{"verse":29,"text":"氷,こおりはだれの胎,たいから出,でたか。空,そらの霜,しもはだれが生,うんだか。","tok":[["氷","こおり"],["は"],["だれ"],["の"],["胎","たいか"],["ら"],["出た","でた"],["か"],["。"],["空","そら"],["の"],["霜","しも"],["は"],["だれ"],["が"],["生んだ","うんだ"],["か"],["。"]]},{"verse":30,"text":"水,みずは固,かたまって石,いしのようになり、淵,ふちのおもては凍,こおる。","tok":[["水","みず"],["は"],["固まって","かたまって"],["石","いし"],["の"],["よう"],["に"],["なり"],["、"],["淵","ふち"],["の"],["おもて"],["は"],["凍る","こおる"],["。"]]},{"verse":31,"text":"あなたはプレアデスの鎖,くさりを結,むすぶことができるか。オリオンの綱,つなを解,とくことができるか。","tok":[["あなた"],["は"],["プレアデス"],["の"],["鎖","くさり"],["を"],["結ぶ","むすぶ"],["こと"],["が"],["できる"],["か"],["。"],["オリオン"],["の"],["綱","つな"],["を"],["解く","とく"],["こと"],["が"],["できる"],["か"],["。"]]},{"verse":32,"text":"あなたは十二宮,きゅうをその時,ときにしたがって引,ひき出,だすことができるか。北斗,ほくととその子,こ星,ぼしを導,みちびくことができるか。","tok":[["あなた"],["は"],["十二宮","きゅう"],["を"],["その"],["時","とき"],["に"],["したがって"],["引出す","ひきだす"],["こと"],["が"],["できる"],["か"],["。"],["北斗","ほくと"],["と"],["その"],["子","こ"],["星","ぼし"],["を"],["導く","みちびく"],["こと"],["が"],["できる"],["か"],["。"]]},{"verse":33,"text":"あなたは天,てんの法則,ほうそくを知,しっているか、そのおきてを地,ちに施,ほどこすことができるか。","tok":[["あなた"],["は"],["天","てん"],["の"],["法則","ほうそく"],["を"],["知って","しって"],["いる"],["か"],["、"],["その"],["おきて"],["を"],["地","ち"],["に"],["施す","ほどこす"],["こと"],["が"],["できる"],["か"],["。"]]},{"verse":34,"text":"あなたは声,こえを雲,くもにあげ、多,おおくの水,みずにあなたをおおわせることができるか。","tok":[["あなた"],["は"],["声","こえ"],["を"],["雲","くも"],["に"],["あげ"],["、"],["多く","おおく"],["の"],["水","みず"],["に"],["あなた"],["を"],["おおわせる"],["こと"],["が"],["できる"],["か"],["。"]]},{"verse":35,"text":"あなたはいなずまをつかわして行,いかせ、『われわれはここにいる』と、あなたに言,いわせることができるか。","tok":[["あなた"],["は"],["いなずま"],["を"],["つかわして"],["行かせ","いかせ"],["、"],["『"],["われわれ"],["は"],["ここ"],["に"],["いる"],["』"],["と"],["、"],["あなた"],["に"],["言わせる","いわせる"],["こと"],["が"],["できる"],["か"],["。"]]},{"verse":36,"text":"雲,くもに知恵,ちえを置,おき、霧,きりに悟,さとりを与,あたえたのはだれか。","tok":[["雲","くも"],["に"],["知恵","ちえ"],["を"],["置き","おき"],["、"],["霧","きり"],["に"],["悟り","さとり"],["を"],["与","あたえ"],["た"],["の"],["は"],["だれ"],["か"],["。"]]},{"verse":37,"text":"だれが知恵,ちえをもって雲,くもを数,かぞえることができるか。だれが天,てんの皮,かわ袋,ぶくろを傾,かたむけて、","tok":[["だれ"],["が"],["知恵","ちえ"],["を"],["もって"],["雲","くも"],["を"],["数える","かぞえる"],["こと"],["が"],["できる"],["か"],["。"],["だれ"],["が"],["天","てん"],["の"],["皮袋","かわぶくろ"],["を"],["傾むけて","かたむけて"],["、"]]},{"verse":38,"text":"ちりを一つに流,ながれ合,あわさせ、土,つちくれを固,かたまらせることができるか。","tok":[["ちり"],["を"],["一","ひと"],["つ"],["に"],["流れ合わさせ","ながれあわさせ"],["、"],["土くれ","つちくれ"],["を"],["固まらせる","かたまらせる"],["こと"],["が"],["できる"],["か"],["。"]]},{"verse":39,"text":"あなたはししのために食物,しょくもつを狩,かり、子,こじしの食欲,しょくよくを満,みたすことができるか。","tok":[["あなた"],["は"],["しし"],["の"],["ため"],["に"],["食物","しょくもつ"],["を"],["狩","かり"],["、"],["子","こ"],["じし"],["の"],["食欲","しょくよく"],["を"],["満たす","みたす"],["こと"],["が"],["できる"],["か"],["。"]]},{"verse":40,"text":"彼,かれらがほら穴,あなに伏,ふし、林,はやしのなかに待,まち伏,ぶせする時,とき、あなたはこの事,ことをなすことができるか。","tok":[["彼","かれ"],["ら"],["が"],["ほら穴","ほらあな"],["に"],["伏し","ふし"],["、"],["林","はやし"],["の"],["なか"],["に"],["待伏せ","まちぶせ"],["する"],["時","とき"],["、"],["あなた"],["は"],["この"],["事","こと"],["を"],["なす"],["こと"],["が"],["できる"],["か"],["。"]]},{"verse":41,"text":"からすの子,こが神,かみに向,むかって呼,よばわり、食物,しょくもつがなくて、さまようとき、からすにえさを与,あたえる者,ものはだれか。","tok":[["からす"],["の"],["子","こ"],["が"],["神","かみ"],["に"],["向かって","むかって"],["呼ばわり","よばわり"],["、"],["食物","しょくもつ"],["が"],["なくて"],["、"],["さまよう"],["とき"],["、"],["からす"],["に"],["えさ"],["を"],["与える","あたえる"],["者","もの"],["は"],["だれ"],["か"],["。"]]}]
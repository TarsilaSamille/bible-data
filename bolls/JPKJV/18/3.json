[{"verse":1,"text":"この後,のち、ヨブは口,くちを開,ひらいて、自分,じぶんの生,うまれた日,ひをのろった。","tok":[["この"],["後","の"],["ち"],["、"],["ヨブ"],["は"],["口","くち"],["を"],["開らいて","ひらいて"],["、"],["自分","じぶん"],["の"],["生まれた","うまれた"],["日","ひ"],["を"],["のろった"],["。"]]},{"verse":2,"text":"すなわちヨブは言,いった、","tok":[["すなわち"],["ヨブ"],["は"],["言った","いった"],["、"]]},{"verse":3,"text":"「わたしの生,うまれた日,ひは滅,ほろびうせよ。『男,おとこの子,こが、胎,たいにやどった』と言,いった夜,よもそのようになれ。","tok":[["「"],["わたし"],["の"],["生まれた","うまれた"],["日","ひ"],["は"],["滅び","ほろび"],["う"],["せよ"],["。"],["『"],["男の子","おとこのこ"],["が"],["、"],["胎","たい"],["に"],["やどった"],["』"],["と"],["言った","いった"],["夜","よ"],["も"],["その"],["よう"],["に"],["なれ"],["。"]]},{"verse":4,"text":"その日,ひは暗,くらくなるように。神,かみが上,うえからこれを顧,かえりみられないように。光,ひかりがこれを照,てらさないように。","tok":[["その"],["日","ひ"],["は"],["暗く","くらく"],["なる"],["よう"],["に"],["。"],["神","かみ"],["が"],["上","うえ"],["から"],["これ"],["を"],["顧られない","かえりみられない"],["よう"],["に"],["。"],["光","ひかり"],["が"],["これ"],["を"],["照らさない","てらさない"],["よう"],["に"],["。"]]},{"verse":5,"text":"やみと暗黒,あんこくがこれを取,とりもどすように。雲,くもが、その上,うえにとどまるように。日,ひを暗,くらくする者,ものが、これを脅,おびやかすように。","tok":[["やみ"],["と"],["暗黒","あんこく"],["が"],["これ"],["を"],["取","とり"],["も"],["どす"],["よう"],["に"],["。"],["雲","くも"],["が"],["、"],["その"],["上","うえ"],["に"],["とどまる"],["よう"],["に"],["。"],["日","ひ"],["を"],["暗く","くらく"],["する"],["者","もの"],["が"],["、"],["これ"],["を"],["脅やかす","おびやかす"],["よう"],["に"],["。"]]},{"verse":6,"text":"その夜,よは、暗,くらやみが、これを捕,とらえるように。年,ねんの日,ひのうちに加,くわわらないように。月,つきの数,かずにもはいらないように。","tok":[["その"],["夜","よ"],["は"],["、"],["暗やみ","くらやみ"],["が"],["、"],["これ"],["を"],["捕らえる","とらえる"],["よう"],["に"],["。"],["年","ねん"],["の"],["日","ひ"],["の"],["うち"],["に"],["加わわらない","くわわらない"],["よう"],["に"],["。"],["月","つき"],["の"],["数","かず"],["に"],["も"],["はいらない"],["よう"],["に"],["。"]]},{"verse":7,"text":"また、その夜,よは、はらむことのないように。喜,よろこびの声,こえがそのうちに聞,きかれないように。","tok":[["また"],["、"],["その"],["夜","よ"],["は"],["、"],["はらむ"],["こと"],["の"],["ない"],["よう"],["に"],["。"],["喜こび","よろこび"],["の"],["声","こえ"],["が"],["その"],["うち"],["に"],["聞かれない","きかれない"],["よう"],["に"],["。"]]},{"verse":8,"text":"日,ひをのろう者,ものが、これをのろうように。レビヤタンを奮,ふるい起,おこすに巧,たくみな者,ものが、これをのろうように。","tok":[["日","ひ"],["を"],["の"],["ろう者","ろうもの"],["が"],["、"],["これ"],["を"],["のろう"],["よう"],["に"],["。"],["レビヤタン"],["を"],["奮い起こす","ふるいおこす"],["に"],["巧み","たくみ"],["な"],["者","もの"],["が"],["、"],["これ"],["を"],["のろう"],["よう"],["に"],["。"]]},{"verse":9,"text":"その明,あけの星,ほしは暗,くらくなるように。光,ひかりを望,のぞんでも、得,えられないように。また、あけぼののまぶたを見,みることのないように。","tok":[["その"],["明け","あけ"],["の"],["星","ほし"],["は"],["暗く","くらく"],["なる"],["よう"],["に"],["。"],["光","ひかり"],["を"],["望","のぞん"],["で"],["も"],["、"],["得られない","えられない"],["よう"],["に"],["。"],["また"],["、"],["あけぼの"],["の"],["まぶた"],["を"],["見る","みる"],["こと"],["の"],["ない"],["よう"],["に"],["。"]]},{"verse":10,"text":"これは、わたしの母,ははの胎,たいの戸,とを閉,とじず、また悩,なやみをわたしの目,めに隠,かくさなかったからである。","tok":[["これ"],["は"],["、"],["わたし"],["の"],["母","はは"],["の"],["胎","たい"],["の"],["戸","と"],["を"],["閉じず","とじず"],["、"],["また"],["悩み","なやみ"],["を"],["わたし"],["の"],["目","め"],["に"],["隠さなかった","かくさなかった"],["から"],["で"],["ある"],["。"]]},{"verse":11,"text":"なにゆえ、わたしは胎,たいから出,でて、死,しななかったのか。腹,はらから出,でたとき息,いきが絶,たえなかったのか。","tok":[["なにゆえ"],["、"],["わたし"],["は"],["胎","たいか"],["ら"],["出て","でて"],["、"],["死ななかった","しななかった"],["の"],["か"],["。"],["腹","はら"],["から"],["出た","でた"],["とき"],["息","いき"],["が"],["絶えなかった","たえなかった"],["の"],["か"],["。"]]},{"verse":12,"text":"なにゆえ、ひざが、わたしを受,うけたのか。なにゆえ、乳,ちぶさがあって、わたしはそれを吸,すったのか。","tok":[["なにゆえ"],["、"],["ひざ"],["が"],["、"],["わたし"],["を"],["受た","うけた"],["の"],["か"],["。"],["なにゆえ"],["、"],["乳ぶさ","ちぶさ"],["が"],["あって"],["、"],["わたし"],["は"],["それ"],["を"],["吸った","すった"],["の"],["か"],["。"]]},{"verse":13,"text":"そうしなかったならば、わたしは伏,ふして休,やすみ、眠,ねむったであろう。そうすればわたしは安,やすんじており、","tok":[["そう"],["しなかったならば"],["、"],["わたし"],["は"],["伏して","ふして"],["休み","やすみ"],["、"],["眠ったで","ねむったで"],["あろう"],["。"],["そう"],["すれば"],["わたし"],["は"],["安んじて","やすんじて"],["おり"],["、"]]},{"verse":14,"text":"自分,じぶんのために荒,あれ跡,あとを築,きずき直,なおした地,ちの王,おうたち、参議,さんぎたち、","tok":[["自分","じぶん"],["の"],["ため"],["に"],["荒れ","あれ"],["跡","あと"],["を"],["築き直した","きずきなおした"],["地","ち"],["の"],["王","おう"],["たち"],["、"],["参議","さんぎ"],["たち"],["、"]]},{"verse":15,"text":"あるいは、こがねを持,もち、しろがねを家,いえに満,みたした君,きみたちと一緒,いっしょにいたであろう。","tok":[["あるいは"],["、"],["こがね"],["を"],["持","もち"],["、"],["しろがね"],["を"],["家","いえ"],["に"],["満たした","みたした"],["君","きみ"],["たち"],["と"],["一緒","いっしょ"],["に"],["いたで"],["あろう"],["。"]]},{"verse":16,"text":"なにゆえ、わたしは人知,ひとしれずおりる胎児,たいじのごとく、光,ひかりを見,みないみどりごのようでなかったのか。","tok":[["なにゆえ"],["、"],["わたし"],["は"],["人","ひと"],["知れず","しれず"],["おりる"],["胎児","たいじ"],["の"],["ごとく"],["、"],["光","ひかり"],["を"],["見ない","みない"],["みどりご"],["の"],["よう"],["で"],["なかった"],["の"],["か"],["。"]]},{"verse":17,"text":"かしこでは悪人,あくにんも、あばれることをやめ、うみ疲,つかれた者,ものも、休,やすみを得,え、","tok":[["かしこ"],["で"],["は"],["悪人","あくにん"],["も"],["、"],["あばれる"],["こと"],["を"],["やめ"],["、"],["うみ疲れた","うみつかれた"],["者","もの"],["も"],["、"],["休み","やすみ"],["を"],["得","え"],["、"]]},{"verse":18,"text":"捕,とらわれ人,びとも共,ともに安,やすらかにおり、追,おい使,つかう者,ものの声,こえを聞,きかない。","tok":[["捕らわれ","とらわれ"],["人","びと"],["も"],["共","とも"],["に"],["安らか","やすらか"],["に"],["おり"],["、"],["追い使う","おいつかう"],["者","もの"],["の"],["声","こえ"],["を"],["聞かない","きかない"],["。"]]},{"verse":19,"text":"小,ちいさい者,ものも大,おおきい者,ものもそこにおり、奴隷,どれいも、その主人,しゅじんから解,とき放,はなされる。","tok":[["小さい","ちいさい"],["者","もの"],["も"],["大きい","おおきい"],["者","もの"],["も"],["そこ"],["に"],["おり"],["、"],["奴隷","どれい"],["も"],["、"],["その"],["主人","しゅじん"],["から"],["解き放される","ときはなされる"],["。"]]},{"verse":20,"text":"なにゆえ、悩,なやむ者,ものに光,ひかりを賜,たまい、心,こころの苦,くるしむ者,ものに命,いのちを賜,たまわったのか。","tok":[["なにゆえ"],["、"],["悩む","なやむ"],["者","もの"],["に"],["光","ひかり"],["を"],["賜い","たまい"],["、"],["心","こころ"],["の"],["苦しむ","くるしむ"],["者","もの"],["に"],["命","いのち"],["を"],["賜わった","たまわった"],["の"],["か"],["。"]]},{"verse":21,"text":"このような人,ひとは死,しを望,のぞんでも来,きない、これを求,もとめることは隠,かくれた宝,たからを掘,ほるよりも、はなはだしい。","tok":[["この"],["よう"],["な"],["人","ひと"],["は"],["死","し"],["を"],["望","のぞん"],["で"],["も"],["来ない","きない"],["、"],["これ"],["を"],["求める","もとめる"],["こと"],["は"],["隠れた","かくれた"],["宝","たから"],["を"],["掘る","ほる"],["より"],["も"],["、"],["はなはだしい"],["。"]]},{"verse":22,"text":"彼,かれらは墓,はかを見,みいだすとき、非常,ひじょうに喜,よろこび楽,たのしむのだ。","tok":[["彼","かれ"],["ら"],["は"],["墓","はか"],["を"],["見いだす","みいだす"],["とき"],["、"],["非常","ひじょう"],["に"],["喜こび","よろこび"],["楽しむ","たのしむ"],["の"],["だ"],["。"]]},{"verse":23,"text":"なにゆえ、その道,みちの隠,かくされた人,ひとに、神,かみが、まがきをめぐらされた人,ひとに、光,ひかりを賜,たまわるのか。","tok":[["なにゆえ"],["、"],["その"],["道","みち"],["の"],["隠された","かくされた"],["人","ひと"],["に"],["、"],["神","かみ"],["が"],["、"],["ま"],["がき"],["を"],["めぐらされた"],["人","ひと"],["に"],["、"],["光","ひかり"],["を"],["賜わる","たまわる"],["の"],["か"],["。"]]},{"verse":24,"text":"わたしの嘆,なげきはわが食物,しょくもつに代,かわって来,きたり、わたしのうめきは水,みずのように流,ながれ出,でる。","tok":[["わたし"],["の"],["嘆き","なげき"],["は"],["わが"],["食物","しょくもつ"],["に"],["代わって","かわって"],["来","き"],["たり"],["、"],["わたし"],["の"],["うめき"],["は"],["水","みず"],["の"],["よう"],["に"],["流れ出る","ながれでる"],["。"]]},{"verse":25,"text":"わたしの恐,おそれるものが、わたしに臨,のぞみ、わたしの恐,おそれおののくものが、わが身,みに及,およぶ。","tok":[["わたし"],["の"],["恐れる","おそれる"],["もの"],["が"],["、"],["わたし"],["に"],["臨み","のぞみ"],["、"],["わたし"],["の"],["恐れおののく","おそれおののく"],["もの"],["が"],["、"],["わが"],["身","み"],["に"],["及ぶ","およぶ"],["。"]]},{"verse":26,"text":"わたしは安,やすらかでなく、またおだやかでない。わたしは休,やすみを得,えない、ただ悩,なやみのみが来,くる」。","tok":[["わたし"],["は"],["安らか","やすらか"],["で"],["なく"],["、"],["また"],["おだやか"],["で"],["ない"],["。"],["わたし"],["は"],["休み","やすみ"],["を"],["得ない","えない"],["、"],["ただ"],["悩み","なやみ"],["のみ"],["が"],["来る","くる"],["」"],["。"]]}]
[{"verse":1,"text":"そこでヨブは答,こたえて言,いった、","tok":[["そこ"],["で"],["ヨブ"],["は"],["答","こたえ"],["て"],["言った","いった"],["、"]]},{"verse":2,"text":"「あなたがたはいつまでわたしを悩,なやまし、言葉,ことばをもってわたしを打,うち砕,くだくのか。","tok":[["「"],["あなた"],["がた"],["は"],["いつ"],["まで"],["わたし"],["を"],["悩し","なやまし"],["、"],["言葉","ことば"],["を"],["もって"],["わたし"],["を"],["打ち砕く","うちくだく"],["の"],["か"],["。"]]},{"verse":3,"text":"あなたがたはすでに十度,とたびもわたしをはずかしめ、わたしを悪,わるくあしらってもなお恥,はじないのか。","tok":[["あなた"],["がた"],["は"],["すでに"],["十","じゅう"],["度","ど"],["も"],["わたし"],["を"],["はずかしめ"],["、"],["わたし"],["を"],["悪く","わるく"],["あしらって"],["も"],["なお"],["恥","はじ"],["ない"],["の"],["か"],["。"]]},{"verse":4,"text":"たといわたしが、まことにあやまったとしても、そのあやまちは、わたし自身,じしんにとどまる。","tok":[["たとい"],["わたし"],["が"],["、"],["まこと"],["に"],["あやまった"],["として"],["も"],["、"],["その"],["あやまち"],["は"],["、"],["わたし"],["自身","じしん"],["に"],["とどまる"],["。"]]},{"verse":5,"text":"もしあなたがたが、まことにわたしに向,むかって高,たかぶり、わたしの恥,はじを論,ろんじるならば、","tok":[["もし"],["あなた"],["が"],["た"],["が"],["、"],["まこと"],["に"],["わたし"],["に"],["向かって","むかって"],["高か","たか"],["ぶり"],["、"],["わたし"],["の"],["恥","はじ"],["を"],["論じるならば","ろんじるならば"],["、"]]},{"verse":6,"text":"『神,かみがわたしをしえたげ、その網,あみでわたしを囲,かこまれたのだ』と知,しるべきだ。","tok":[["『"],["神","かみ"],["が"],["わたし"],["を"],["し"],["えたげ"],["、"],["その"],["網","あみ"],["で"],["わたし"],["を"],["囲まれた","かこまれた"],["の"],["だ"],["』"],["と"],["知るべきだ","しるべきだ"],["。"]]},{"verse":7,"text":"見,みよ、わたしが『暴虐,ぼうぎゃく』と叫,さけんでも答,こたえられず、助,たすけを呼,よび求,もとめても、さばきはない。","tok":[["見よ","みよ"],["、"],["わたし"],["が"],["『"],["暴虐","ぼうぎゃく"],["』"],["と"],["叫けんで","さけんで"],["も"],["答","こたえ"],["られず"],["、"],["助け","たすけ"],["を"],["呼び求めて","よびもとめて"],["も"],["、"],["さばき"],["は"],["ない"],["。"]]},{"verse":8,"text":"彼,かれはわたしの道,みちにかきをめぐらして、越,こえることのできないようにし、わたしの行,いく道,みちに暗,くらやみを置,おかれた。","tok":[["彼","かれ"],["は"],["わたし"],["の"],["道","みち"],["に"],["かき"],["を"],["めぐらして"],["、"],["越える","こえる"],["こと"],["の"],["できない"],["よう"],["に"],["し"],["、"],["わたし"],["の"],["行く","いく"],["道","みち"],["に"],["暗やみ","くらやみ"],["を"],["置かれた","おかれた"],["。"]]},{"verse":9,"text":"彼,かれはわたしの栄,さかえをわたしからはぎ取,とり、わたしのこうべから冠,かんむりを奪,うばい、","tok":[["彼","かれ"],["は"],["わたし"],["の"],["栄","さかえ"],["を"],["わたし"],["から"],["はぎ"],["取","とり"],["、"],["わたし"],["の"],["こうべ"],["から"],["冠","かんむり"],["を"],["奪い","うばい"],["、"]]},{"verse":10,"text":"四方,しほうからわたしを取,とりこわして、うせさせ、わたしの望,のぞみを木,きのように抜,ぬき去,さり、","tok":[["四方","しほう"],["から"],["わたし"],["を"],["取","とり"],["こわして"],["、"],["うせさせ"],["、"],["わたし"],["の"],["望み","のぞみ"],["を"],["木","き"],["の"],["よう"],["に"],["抜き去り","ぬきさり"],["、"]]},{"verse":11,"text":"わたしに向,むかって怒,いかりを燃,もやし、わたしを敵,てきのひとりのように思,おもわれた。","tok":[["わたし"],["に"],["向かって","むかって"],["怒り","いかり"],["を"],["燃やし","もやし"],["、"],["わたし"],["を"],["敵","てき"],["の"],["ひとり"],["の"],["よう"],["に"],["思われた","おもわれた"],["。"]]},{"verse":12,"text":"その軍勢,ぐんぜいがいっせいに来,きて、塁,るいを築,きずいて攻,せめ寄,よせ、わたしの天幕,てんまくのまわりに陣,じんを張,はった。","tok":[["その"],["軍勢","ぐんぜい"],["が"],["いっせい"],["に"],["来て","きて"],["、"],["塁","るい"],["を"],["築いて","きずいて"],["攻め寄せ","せめよせ"],["、"],["わたし"],["の"],["天幕","てんまく"],["の"],["まわり"],["に"],["陣","じん"],["を"],["張った","はった"],["。"]]},{"verse":13,"text":"彼,かれはわたしの兄弟,きょうだいたちをわたしから遠,とおく離,はなれさせられた。わたしを知,しる人々,ひとびとは全,まったくわたしに疎遠,そえんになった。","tok":[["彼","かれ"],["は"],["わたし"],["の"],["兄弟","きょうだい"],["たち"],["を"],["わたし"],["から"],["遠く","とおく"],["離れさせられた","はなれさせられた"],["。"],["わたし"],["を"],["知る","しる"],["人々","ひとびと"],["は"],["全く","まったく"],["わたし"],["に"],["疎遠","そえん"],["に"],["なった"],["。"]]},{"verse":14,"text":"わたしの親類,しんるいおよび親,したしい友,ともはわたしを見捨,みすて、","tok":[["わたし"],["の"],["親類","しんるい"],["および"],["親しい","したしい"],["友","とも"],["は"],["わたし"],["を"],["見捨て","みすて"],["、"]]},{"verse":15,"text":"わたしの家,いえに宿,やどる者,ものはわたしを忘,わすれ、わたしのはしためらはわたしを他人,たにんのように思,おもい、わたしは彼,かれらの目,めに他国,たこく人,じんとなった。","tok":[["わたし"],["の"],["家","いえ"],["に"],["宿る","やどる"],["者","もの"],["は"],["わたし"],["を"],["忘","わすれ"],["、"],["わたし"],["の"],["はし"],["ため"],["ら"],["は"],["わたし"],["を"],["他人","たにん"],["の"],["よう"],["に"],["思い","おもい"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["目","め"],["に"],["他国人","たこくじん"],["と"],["なった"],["。"]]},{"verse":16,"text":"わたしがしもべを呼,よんでも、彼,かれは答,こたえず、わたしは口,くちをもって彼,かれに請,こわなければならない。","tok":[["わたし"],["が"],["しもべ"],["を"],["呼","よん"],["で"],["も"],["、"],["彼","かれ"],["は"],["答","こたえ"],["ず"],["、"],["わたし"],["は"],["口","くち"],["を"],["もって"],["彼","かれ"],["に"],["請わなければ","こわなければ"],["ならない"],["。"]]},{"verse":17,"text":"わたしの息,いきはわが妻,つまにいとわれ、わたしは同,おなじ腹,はらの子,こたちにきらわれる。","tok":[["わたし"],["の"],["息","いき"],["は"],["わが"],["妻","つま"],["に"],["いとわれ"],["、"],["わたし"],["は"],["同じ","おなじ"],["腹","はら"],["の"],["子","こ"],["たち"],["に"],["きらわれる"],["。"]]},{"verse":18,"text":"わらべたちさえもわたしを侮,あなどり、わたしが起,おき上,あがれば、わたしをあざける。","tok":[["わらべ"],["たち"],["さえ"],["も"],["わたし"],["を"],["侮","あなどり"],["、"],["わたし"],["が"],["起き上がれば","おきあがれば"],["、"],["わたし"],["を"],["あざける"],["。"]]},{"verse":19,"text":"親,したしい人々,ひとびとは皆,みなわたしをいみきらい、わたしの愛,あいした人々,ひとびとはわたしにそむいた。","tok":[["親しい","したしい"],["人々","ひとびと"],["は"],["皆","みな"],["わたし"],["を"],["いみきらい"],["、"],["わたし"],["の"],["愛した","あいした"],["人々","ひとびと"],["は"],["わたし"],["に"],["そむいた"],["。"]]},{"verse":20,"text":"わたしの骨,ほねは皮,かわと肉,にくにつき、わたしはわずかに歯,はの皮,かわをもってのがれた。","tok":[["わたし"],["の"],["骨","ほね"],["は"],["皮","かわ"],["と"],["肉","にく"],["に"],["つき"],["、"],["わたし"],["は"],["わずか"],["に"],["歯","は"],["の"],["皮","かわ"],["を"],["もって"],["のがれた"],["。"]]},{"verse":21,"text":"わが友,ともよ、わたしをあわれめ、わたしをあわれめ、神,かみのみ手,てがわたしを打,うったからである。","tok":[["わが"],["友","とも"],["よ"],["、"],["わたし"],["を"],["あわれめ"],["、"],["わたし"],["を"],["あわれめ"],["、"],["神","かみ"],["のみ"],["手","て"],["が"],["わたし"],["を"],["打った","うった"],["から"],["で"],["ある"],["。"]]},{"verse":22,"text":"あなたがたは、なにゆえ神,かみのようにわたしを責,せめ、わたしの肉,にくをもって満足,まんぞくしないのか。","tok":[["あなた"],["がた"],["は"],["、"],["なにゆえ"],["神","かみ"],["の"],["よう"],["に"],["わたし"],["を"],["責","せめ"],["、"],["わたし"],["の"],["肉","にく"],["を"],["もって"],["満足","まんぞく"],["しない"],["の"],["か"],["。"]]},{"verse":23,"text":"どうか、わたしの言葉,ことばが、書,かきとめられるように。どうか、わたしの言葉,ことばが、書物,しょもつにしるされるように。","tok":[["どう"],["か"],["、"],["わたし"],["の"],["言葉","ことば"],["が"],["、"],["書きとめられる","かきとめられる"],["よう"],["に"],["。"],["どう"],["か"],["、"],["わたし"],["の"],["言葉","ことば"],["が"],["、"],["書物","しょもつ"],["に"],["しるされる"],["よう"],["に"],["。"]]},{"verse":24,"text":"鉄,てつの筆,ふでと鉛,なまりとをもって、ながく岩,いわに刻,きざみつけられるように。","tok":[["鉄","てつ"],["の"],["筆","ふで"],["と"],["鉛","なまり"],["と"],["を"],["もって"],["、"],["ながく"],["岩","いわ"],["に"],["刻みつけられる","きざみつけられる"],["よう"],["に"],["。"]]},{"verse":25,"text":"わたしは知,しる、わたしをあがなう者,ものは生,いきておられる、後,のちの日,ひに彼,かれは必,かならず地,ちの上,うえに立,たたれる。","tok":[["わたし"],["は"],["知る","しる"],["、"],["わたし"],["を"],["あがなう"],["者","もの"],["は"],["生きて","いきて"],["おられる"],["、"],["後","のち"],["の"],["日","ひ"],["に"],["彼","かれ"],["は"],["必","かならず"],["地","ち"],["の"],["上","うえ"],["に"],["立たれる","たたれる"],["。"]]},{"verse":26,"text":"わたしの皮,かわがこのように滅,ほろぼされたのち、わたしは肉,にくを離,はなれて神,かみを見,みるであろう。","tok":[["わたし"],["の"],["皮","かわ"],["が"],["この"],["よう"],["に"],["滅ぼされた","ほろぼされた"],["のち"],["、"],["わたし"],["は"],["肉","にく"],["を"],["離れて","はなれて"],["神","かみ"],["を"],["見るで","みるで"],["あろう"],["。"]]},{"verse":27,"text":"しかもわたしの味方,みかたとして見,みるであろう。わたしの見,みる者,ものはこれ以外,いがいのものではない。わたしの心,こころはこれを望,のぞんでこがれる。","tok":[["しかも"],["わたし"],["の"],["味方","みかた"],["として"],["見るで","みるで"],["あろう"],["。"],["わたし"],["の"],["見る","みる"],["者","もの"],["は"],["これ"],["以外","いがい"],["の"],["もの"],["で"],["は"],["ない"],["。"],["わたし"],["の"],["心","こころ"],["は"],["これ"],["を"],["望んで","のぞんで"],["こがれる"],["。"]]},{"verse":28,"text":"あなたがたがもし『われわれはどうして彼,かれを責,せめようか』と言,いい、また『事,ことの根源,こんげんは彼,かれのうちに見,みいだされる』と言,いうならば、","tok":[["あなた"],["がた"],["が"],["もし"],["『"],["われわれ"],["は"],["どう"],["して"],["彼","かれ"],["を"],["責めよう","せめよう"],["か"],["』"],["と"],["言い","いい"],["、"],["また"],["『"],["事","こと"],["の"],["根源","こんげん"],["は"],["彼","かれ"],["の"],["うち"],["に"],["見いだされる","みいだされる"],["』"],["と"],["言うならば","いうならば"],["、"]]},{"verse":29,"text":"つるぎを恐,おそれよ、怒,いかりはつるぎの罰,ばつをきたらすからだ。これによって、あなたがたは、さばきのあることを知,しるであろう」。","tok":[["つるぎ"],["を"],["恐れよ","おそれよ"],["、"],["怒り","いかり"],["は"],["つるぎ"],["の"],["罰","ばつ"],["を"],["きたらす"],["から"],["だ"],["。"],["これ"],["によって"],["、"],["あなた"],["がた"],["は"],["、"],["さばき"],["の"],["ある"],["こと"],["を"],["知るで","しるで"],["あろう"],["」"],["。"]]}]
[{"verse":1,"text":"そこでヨブは答,こたえて言,いった、","tok":[["そこ"],["で"],["ヨブ"],["は"],["答","こたえ"],["て"],["言った","いった"],["、"]]},{"verse":2,"text":"「きょうもまた、わたしのつぶやきは激,はげしく、彼,かれの手,てはわたしの嘆,なげきにかかわらず、重,おもい。","tok":[["「"],["きょう"],["も"],["また"],["、"],["わたし"],["の"],["つぶやき"],["は"],["激しく","はげしく"],["、"],["彼","かれ"],["の"],["手","て"],["は"],["わたし"],["の"],["嘆き","なげき"],["に"],["かかわらず"],["、"],["重い","おもい"],["。"]]},{"verse":3,"text":"どうか、彼,かれを尋,たずねてどこで会,あえるかを知,しり、そのみ座,ざに至,いたることができるように。","tok":[["どう"],["か"],["、"],["彼","かれ"],["を"],["尋ねて","たずねて"],["どこ"],["で"],["会える","あえる"],["か"],["を"],["知り","しり"],["、"],["その"],["み座","みざ"],["に"],["至る","いたる"],["こと"],["が"],["できる"],["よう"],["に"],["。"]]},{"verse":4,"text":"わたしは彼,かれの前,まえにわたしの訴,うったえをならべ、口,くちをきわめて論議,ぎするであろう。","tok":[["わたし"],["は"],["彼","かれ"],["の"],["前","まえ"],["に"],["わたし"],["の"],["訴","うったえ"],["を"],["ならべ"],["、"],["口","くち"],["を"],["きわめて"],["論議","ぎ"],["するで"],["あろう"],["。"]]},{"verse":5,"text":"わたしは、わたしに答,こたえられるみ言葉,ことばを知,しり、わたしに言,いわれる所,ところを悟,さとろう。","tok":[["わたし"],["は"],["、"],["わたし"],["に"],["答","こたえ"],["られる"],["み言葉","みことば"],["を"],["知り","しり"],["、"],["わたし"],["に"],["言われる","いわれる"],["所","ところ"],["を"],["悟ろう","さとろう"],["。"]]},{"verse":6,"text":"彼,かれは大,おおいなる力,ちからをもって、わたしと争,あらそわれるであろうか、いな、かえってわたしを顧,かえりみられるであろう。","tok":[["彼","かれ"],["は"],["大いなる","おおいなる"],["力","ちから"],["を"],["もって"],["、"],["わたし"],["と"],["争われるで","あらそわれるで"],["あろう"],["か"],["、"],["いな"],["、"],["かえって"],["わたし"],["を"],["顧られるで","かえりみられるで"],["あろう"],["。"]]},{"verse":7,"text":"かしこでは正,ただしい人,ひとは彼,かれと言,いい争,あらそうことができる。そうすれば、わたしはわたしをさばく者,ものから永久,えいきゅうに救,すくわれるであろう。","tok":[["かしこ"],["で"],["は"],["正い","ただしい"],["人","ひと"],["は"],["彼","かれ"],["と"],["言い争う","いいあらそう"],["こと"],["が"],["できる"],["。"],["そう"],["すれば"],["、"],["わたし"],["は"],["わたし"],["を"],["さばく"],["者","もの"],["から"],["永久","えいきゅう"],["に"],["救われるで","すくわれるで"],["あろう"],["。"]]},{"verse":8,"text":"見,みよ、わたしが進,すすんでも、彼,かれを見,みない。退,しりぞいても、彼,かれを認,みとめることができない。","tok":[["見よ","みよ"],["、"],["わたし"],["が"],["進","すすん"],["で"],["も"],["、"],["彼","かれ"],["を"],["見ない","みない"],["。"],["退ぞいて","しりぞいて"],["も"],["、"],["彼","かれ"],["を"],["認める","みとめる"],["こと"],["が"],["できない"],["。"]]},{"verse":9,"text":"左,ひだりの方,ほうに尋,たずねても、会,あうことができない。右,みぎの方,ほうに向,むかっても、見,みることができない。","tok":[["左","ひだり"],["の"],["方","ほう"],["に"],["尋ねて","たずねて"],["も"],["、"],["会う","あう"],["こと"],["が"],["できない"],["。"],["右","みぎ"],["の"],["方","ほう"],["に"],["向かって","むかって"],["も"],["、"],["見る","みる"],["こと"],["が"],["できない"],["。"]]},{"verse":10,"text":"しかし彼,かれはわたしの歩,あゆむ道,みちを知,しっておられる。彼,かれがわたしを試,こころみられるとき、わたしは金,きんのように出,でて来,くるであろう。","tok":[["しかし"],["彼","かれ"],["は"],["わたし"],["の"],["歩む","あゆむ"],["道","みち"],["を"],["知って","しって"],["おられる"],["。"],["彼","かれ"],["が"],["わたし"],["を"],["試みられる","こころみられる"],["とき"],["、"],["わたし"],["は"],["金","きん"],["の"],["よう"],["に"],["出て","でて"],["来るで","くるで"],["あろう"],["。"]]},{"verse":11,"text":"わたしの足,あしは彼,かれの歩,あゆみに堅,かたく従,したがった。わたしは彼,かれの道,みちを守,まもって離,はなれなかった。","tok":[["わたし"],["の"],["足","あし"],["は"],["彼","かれ"],["の"],["歩み","あゆみ"],["に"],["堅く","かたく"],["従った","したがった"],["。"],["わたし"],["は"],["彼","かれ"],["の"],["道","みち"],["を"],["守って","まもって"],["離れなかった","はなれなかった"],["。"]]},{"verse":12,"text":"わたしは彼,かれのくちびるの命令,めいれいにそむかず、その口,くちの言葉,ことばをわたしの胸,むねにたくわえた。","tok":[["わたし"],["は"],["彼","かれ"],["の"],["くちびる"],["の"],["命令","めいれい"],["に"],["そむかず"],["、"],["その"],["口","くち"],["の"],["言葉","ことば"],["を"],["わたし"],["の"],["胸","むね"],["に"],["たくわえた"],["。"]]},{"verse":13,"text":"しかし彼,かれは変,かわることはない。だれが彼,かれをひるがえすことができようか。彼,かれはその心,こころの欲,ほっするところを行,おこなわれるのだ。","tok":[["しかし"],["彼","かれ"],["は"],["変わる","かわる"],["こと"],["は"],["ない"],["。"],["だれ"],["が"],["彼","かれ"],["を"],["ひるがえす"],["こと"],["が"],["できよう"],["か"],["。"],["彼","かれ"],["は"],["その"],["心","こころ"],["の"],["欲する","ほっする"],["ところ"],["を"],["行なわれる","おこなわれる"],["の"],["だ"],["。"]]},{"verse":14,"text":"彼,かれはわたしのために定,さだめた事,ことをなし遂,とげられる。そしてこのような事,ことが多,おおく彼,かれの心,こころにある。","tok":[["彼","かれ"],["は"],["わたし"],["の"],["ため"],["に"],["定めた","さだめた"],["事","こと"],["を"],["なし遂げられる","なしとげられる"],["。"],["そして"],["この"],["よう"],["な"],["事","こと"],["が"],["多く","おおく"],["彼","かれ"],["の"],["心","こころ"],["に"],["ある"],["。"]]},{"verse":15,"text":"それゆえ、わたしは彼,かれの前,まえにおののく。わたしは考,かんがえるとき、彼,かれを恐,おそれる。","tok":[["それ"],["ゆえ"],["、"],["わたし"],["は"],["彼","かれ"],["の"],["前","まえ"],["に"],["おののく"],["。"],["わたし"],["は"],["考","かんがえ"],["る"],["とき"],["、"],["彼","かれ"],["を"],["恐れる","おそれる"],["。"]]},{"verse":16,"text":"神,かみはわたしの心,こころを弱,よわくされた。全能者,ぜんのうしゃはわたしを恐,おそれさせられた。","tok":[["神","かみ"],["は"],["わたし"],["の"],["心","こころ"],["を"],["弱く","よわく"],["された"],["。"],["全能者","ぜんのうしゃ"],["は"],["わたし"],["を"],["恐れさせられた","おそれさせられた"],["。"]]},{"verse":17,"text":"わたしは、やみによって閉,とじこめられ、暗黒,あんこくがわたしの顔,かおをおおっている。","tok":[["わたし"],["は"],["、"],["やみ"],["によって"],["閉じこめられ","とじこめられ"],["、"],["暗黒","あんこく"],["が"],["わたし"],["の"],["顔","かお"],["を"],["おおって"],["いる"],["。"]]}]
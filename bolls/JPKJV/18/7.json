[{"verse":1,"text":"地上,ちじょうの人,ひとには、激,はげしい労務,ろうむがあるではないか。またその日,ひは雇人,やといにんの日,ひのようではないか。","tok":[["地上","ちじょう"],["の"],["人","ひと"],["に"],["は"],["、"],["激しい","はげしい"],["労務","ろうむ"],["が"],["ある"],["で"],["は"],["ない"],["か"],["。"],["また"],["その"],["日","ひ"],["は"],["雇人","やといにん"],["の"],["日","ひ"],["の"],["よう"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":2,"text":"奴隷,どれいが夕暮,ゆうぐれを慕,したうように、雇人,やといにんがその賃銀,ちんぎんを望,のぞむように、","tok":[["奴隷","どれい"],["が"],["夕暮","ゆうぐれ"],["を"],["慕う","したう"],["よう"],["に"],["、"],["雇人","やといにん"],["が"],["その"],["賃銀","ちんぎん"],["を"],["望む","のぞむ"],["よう"],["に"],["、"]]},{"verse":3,"text":"わたしは、むなしい月,つきを持,もたせられ、悩,なやみの夜,よるを与,あたえられる。","tok":[["わたし"],["は"],["、"],["むなしい"],["月","つき"],["を"],["持たせられ","もたせられ"],["、"],["悩み","なやみ"],["の"],["夜","よる"],["を"],["与えられる","あたえられる"],["。"]]},{"verse":4,"text":"わたしは寝,ねるときに言,いう、『いつ起,おきるだろうか』と。しかし夜,よるは長,ながく、暁,あかつきまでころびまわる。","tok":[["わたし"],["は"],["寝る","ねる"],["とき"],["に"],["言う","いう"],["、"],["『"],["いつ"],["起きるだろう","おきるだろう"],["か"],["』"],["と"],["。"],["しかし"],["夜","よる"],["は"],["長く","ながく"],["、"],["暁","あかつき"],["まで"],["ころび"],["まわる"],["。"]]},{"verse":5,"text":"わたしの肉,にくはうじと土,つちくれとをまとい、わたしの皮,かわは固,かたまっては、またくずれる。","tok":[["わたし"],["の"],["肉","にく"],["は"],["うじ"],["と"],["土くれ","つちくれ"],["と"],["を"],["まとい"],["、"],["わたし"],["の"],["皮","かわ"],["は"],["固まって","かたまって"],["は"],["、"],["また"],["くずれる"],["。"]]},{"verse":6,"text":"わたしの日,ひは機,はたのひよりも速,はやく、望,のぞみをもたずに消,きえ去,さる。","tok":[["わたし"],["の"],["日","ひ"],["は"],["機","はた"],["の"],["ひより"],["も"],["速く","はやく"],["、"],["望み","のぞみ"],["を"],["もたず"],["に"],["消え去る","きえさる"],["。"]]},{"verse":7,"text":"記憶,きおくせよ、わたしの命,いのちは息,いきにすぎないことを。わたしの目,めは再,ふたたび幸,さいわいを見,みることがない。","tok":[["記憶","きおく"],["せよ"],["、"],["わたし"],["の"],["命","いのち"],["は"],["息","いき"],["に"],["すぎない"],["こと"],["を"],["。"],["わたし"],["の"],["目","め"],["は"],["再び","ふたたび"],["幸い","さいわい"],["を"],["見る","みる"],["こと"],["が"],["ない"],["。"]]},{"verse":8,"text":"わたしを見,みる者,ものの目,めは、かさねてわたしを見,みることがなく、あなたがわたしに目,めを向,むけられても、わたしはいない。","tok":[["わたし"],["を"],["見る","みる"],["者","もの"],["の"],["目","め"],["は"],["、"],["かさねて"],["わたし"],["を"],["見る","みる"],["こと"],["が"],["なく"],["、"],["あなた"],["が"],["わたし"],["に"],["目","め"],["を"],["向けられて","むけられて"],["も"],["、"],["わたし"],["は"],["いない"],["。"]]},{"verse":9,"text":"雲,くもが消,きえて、なくなるように、陰府,よみに下,くだる者,ものは上,あがって来,くることがない。","tok":[["雲","くも"],["が"],["消えて","きえて"],["、"],["なくなる"],["よう"],["に"],["、"],["陰府","よみ"],["に"],["下る","くだる"],["者","もの"],["は"],["上がって","あがって"],["来る","くる"],["こと"],["が"],["ない"],["。"]]},{"verse":10,"text":"彼,かれは再,ふたたびその家,いえに帰,かえらず、彼,かれの所,ところも、もはや彼,かれを認,みとめない。","tok":[["彼","かれ"],["は"],["再び","ふたたび"],["その"],["家","いえ"],["に"],["帰えらず","かえらず"],["、"],["彼","かれ"],["の"],["所","ところ"],["も"],["、"],["もはや"],["彼","かれ"],["を"],["認めない","みとめない"],["。"]]},{"verse":11,"text":"それゆえ、わたしはわが口,くちをおさえず、わたしの霊,れいのもだえによって語,かたり、わたしの魂,たましいの苦,くるしさによって嘆,なげく。","tok":[["それ"],["ゆえ"],["、"],["わたし"],["は"],["わが"],["口","くち"],["を"],["おさえず"],["、"],["わたし"],["の"],["霊","れい"],["の"],["もだえ"],["によって"],["語り","かたり"],["、"],["わたし"],["の"],["魂","たましい"],["の"],["苦し","くるし"],["さ"],["によって"],["嘆く","なげく"],["。"]]},{"verse":12,"text":"わたしは海,うみであるのか、龍,りゅうであるのか、あなたはわたしの上,うえに見張,みはりを置,おかれる。","tok":[["わたし"],["は"],["海","うみ"],["で"],["ある"],["の"],["か"],["、"],["龍","りゅう"],["で"],["ある"],["の"],["か"],["、"],["あなた"],["は"],["わたし"],["の"],["上","うえ"],["に"],["見張","みはり"],["を"],["置かれる","おかれる"],["。"]]},{"verse":13,"text":"『わたしの床,とこはわたしを慰,なぐさめ、わたしの寝床,ねどこはわが嘆,なげきを軽,かるくする』とわたしが言,いうとき、","tok":[["『"],["わたし"],["の"],["床","とこ"],["は"],["わたし"],["を"],["慰さめ","なぐさめ"],["、"],["わたし"],["の"],["寝床","ねどこ"],["は"],["わが"],["嘆き","なげき"],["を"],["軽く","かるく"],["する"],["』"],["と"],["わたし"],["が"],["言う","いう"],["とき"],["、"]]},{"verse":14,"text":"あなたは夢,ゆめをもってわたしを驚,おどろかし、幻,まぼろしをもってわたしを恐,おそれさせられる。","tok":[["あなた"],["は"],["夢","ゆめ"],["を"],["もって"],["わたし"],["を"],["驚ろかし","おどろかし"],["、"],["幻","まぼろし"],["を"],["もって"],["わたし"],["を"],["恐れさせられる","おそれさせられる"],["。"]]},{"verse":15,"text":"それゆえ、わたしは息,いきの止,とまることを願,ねがい、わが骨,ほねよりもむしろ死,しを選,えらぶ。","tok":[["それ"],["ゆえ"],["、"],["わたし"],["は"],["息","いき"],["の"],["止まる","とまる"],["こと"],["を"],["願い","ねがい"],["、"],["わが"],["骨","ほね"],["より"],["も"],["むしろ"],["死","し"],["を"],["選ぶ","えらぶ"],["。"]]},{"verse":16,"text":"わたしは命,いのちをいとう。わたしは長,ながく生,いきることを望,のぞまない。わたしに構,かまわないでください。わたしの日,ひは息,いきにすぎないのだから。","tok":[["わたし"],["は"],["命","いのち"],["を"],["いとう"],["。"],["わたし"],["は"],["長く","ながく"],["生きる","いきる"],["こと"],["を"],["望まない","のぞまない"],["。"],["わたし"],["に"],["構わないで","かまわないで"],["ください"],["。"],["わたし"],["の"],["日","ひ"],["は"],["息","いき"],["に"],["すぎない"],["の"],["だ"],["から"],["。"]]},{"verse":17,"text":"人,ひとは何者,なにものなので、あなたはこれを大,おおきなものとし、これにみ心,こころをとめ、","tok":[["人","ひと"],["は"],["何者","なにもの"],["な"],["ので"],["、"],["あなた"],["は"],["これ"],["を"],["大きな","おおきな"],["もの"],["と"],["し"],["、"],["これ"],["に"],["み心","みこころ"],["を"],["とめ"],["、"]]},{"verse":18,"text":"朝,あさごとに、これを尋,たずね、絶,たえ間,まなく、これを試,こころみられるのか。","tok":[["朝","あさ"],["ごと"],["に"],["、"],["これ"],["を"],["尋ね","たずね"],["、"],["絶え間","たえま"],["なく"],["、"],["これ"],["を"],["試みられる","こころみられる"],["の"],["か"],["。"]]},{"verse":19,"text":"いつまで、あなたはわたしに目,めを離,はなさず、つばをのむまも、わたしを捨,すてておかれないのか。","tok":[["いつ"],["まで"],["、"],["あなた"],["は"],["わたし"],["に"],["目","め"],["を"],["離さず","はなさず"],["、"],["つば"],["を"],["のむ"],["ま"],["も"],["、"],["わたし"],["を"],["捨てて","すてて"],["おかれない"],["の"],["か"],["。"]]},{"verse":20,"text":"人,ひとを監視,かんしされる者,ものよ、わたしが罪,つみを犯,おかしたとて、あなたに何,なにをなしえようか。なにゆえ、わたしをあなたの的,まととし、わたしをあなたの重荷,おもにとされるのか。","tok":[["人","ひと"],["を"],["監視","かんし"],["される"],["者","もの"],["よ"],["、"],["わたし"],["が"],["罪","つみ"],["を"],["犯した","おかした"],["とて"],["、"],["あなた"],["に"],["何に","なに"],["を"],["なし"],["えよう"],["か"],["。"],["なにゆえ"],["、"],["わたし"],["を"],["あなた"],["の"],["的","まと"],["と"],["し"],["、"],["わたし"],["を"],["あなた"],["の"],["重荷","おもに"],["と"],["される"],["の"],["か"],["。"]]},{"verse":21,"text":"なにゆえ、わたしのとがをゆるさず、わたしの不義,ふぎを除,のぞかれないのか。わたしはいま土,つちの中,なかに横,よこたわる。あなたがわたしを尋,たずねられても、わたしはいないでしょう」。","tok":[["なにゆえ"],["、"],["わたし"],["の"],["とが"],["を"],["ゆるさず"],["、"],["わたし"],["の"],["不義","ふぎ"],["を"],["除かれない","のぞかれない"],["の"],["か"],["。"],["わたし"],["は"],["いま"],["土","つち"],["の"],["中","なか"],["に"],["横たわる","よこたわる"],["。"],["あなた"],["が"],["わたし"],["を"],["尋ねられて","たずねられて"],["も"],["、"],["わたし"],["は"],["いないでしょう"],["」"],["。"]]}]
[{"verse":1,"text":"見,みよ、わたしの目,めは、これをことごとく見,みた。わたしの耳,みみはこれを聞,きいて悟,さとった。","tok":[["見よ","みよ"],["、"],["わたし"],["の"],["目","め"],["は"],["、"],["これ"],["を"],["ことごとく"],["見た","みた"],["。"],["わたし"],["の"],["耳","みみ"],["は"],["これ"],["を"],["聞いて","きいて"],["悟った","さとった"],["。"]]},{"verse":2,"text":"あなたがたの知,しっている事,ことは、わたしも知,しっている。わたしはあなたがたに劣,おとらない。","tok":[["あなた"],["がた"],["の"],["知って","しって"],["いる"],["事","こと"],["は"],["、"],["わたし"],["も"],["知って","しって"],["いる"],["。"],["わたし"],["は"],["あなた"],["がた"],["に"],["劣らない","おとらない"],["。"]]},{"verse":3,"text":"しかしわたしは全能者,ぜんのうしゃに物,ものを言,いおう、わたしは神,かみと論,ろんずることを望,のぞむ。","tok":[["しかし"],["わたし"],["は"],["全能者","ぜんのうしゃ"],["に"],["物","もの"],["を"],["言おう","いおう"],["、"],["わたし"],["は"],["神","かみ"],["と"],["論ずる","ろんずる"],["こと"],["を"],["望む","のぞむ"],["。"]]},{"verse":4,"text":"あなたがたは偽,いつわりをもってうわべを繕,つくろう者,もの、皆,みな、無用,むようの医師,いしだ。","tok":[["あなた"],["がた"],["は"],["偽り","いつわり"],["を"],["もって"],["うわべ"],["を"],["繕う","つくろう"],["者","もの"],["、"],["皆","みな"],["、"],["無用","むよう"],["の"],["医師","いし"],["だ"],["。"]]},{"verse":5,"text":"どうか、あなたがたは全,まったく沈黙,ちんもくするように。これがあなたがたの知恵,ちえであろう。","tok":[["どう"],["か"],["、"],["あなた"],["がた"],["は"],["全く","まったく"],["沈黙","ちんもく"],["する"],["よう"],["に"],["。"],["これ"],["が"],["あなた"],["がた"],["の"],["知恵","ちえ"],["で"],["あろう"],["。"]]},{"verse":6,"text":"今,いま、わたしの論,ろんずることを聞,きくがよい。わたしの口,くちで言,いい争,あらそうことに耳,みみを傾,かたむけるがよい。","tok":[["今","いま"],["、"],["わたし"],["の"],["論ずる","ろんずる"],["こと"],["を"],["聞く","きく"],["が"],["よい"],["。"],["わたし"],["の"],["口","くち"],["で"],["言い争う","いいあらそう"],["こと"],["に"],["耳","みみ"],["を"],["傾むける","かたむける"],["が"],["よい"],["。"]]},{"verse":7,"text":"あなたがたは神,かみのために不義,ふぎを言,いおうとするのか。また彼,かれのために偽,いつわりを述,のべるのか。","tok":[["あなた"],["がた"],["は"],["神","かみ"],["の"],["ため"],["に"],["不義","ふぎ"],["を"],["言おう","いおう"],["と"],["する"],["の"],["か"],["。"],["また"],["彼","かれ"],["の"],["ため"],["に"],["偽り","いつわり"],["を"],["述べる","のべる"],["の"],["か"],["。"]]},{"verse":8,"text":"あなたがたは彼,かれにひいきしようとするのか。神,かみのために争,あらそおうとするのか。","tok":[["あなた"],["がた"],["は"],["彼","かれ"],["に"],["ひいき"],["しよう"],["と"],["する"],["の"],["か"],["。"],["神","かみ"],["の"],["ため"],["に"],["争おう","あらそおう"],["と"],["する"],["の"],["か"],["。"]]},{"verse":9,"text":"神,かみがあなたがたを調,しらべられるとき、あなたがたは無事,ぶじだろうか。あなたがたは人,ひとを欺,あざむくように彼,かれを欺,あざむくことができるか。","tok":[["神","かみ"],["が"],["あなた"],["がた"],["を"],["調べられる","しらべられる"],["とき"],["、"],["あなた"],["がた"],["は"],["無事","ぶじ"],["だろう"],["か"],["。"],["あなた"],["がた"],["は"],["人","ひと"],["を"],["欺く","あざむく"],["よう"],["に"],["彼","かれ"],["を"],["欺く","あざむく"],["こと"],["が"],["できる"],["か"],["。"]]},{"verse":10,"text":"あなたがたがもし、ひそかにひいきするならば、彼,かれは必,かならずあなたがたを責,せめられる。","tok":[["あなた"],["がた"],["が"],["もし"],["、"],["ひそか"],["に"],["ひいき"],["するならば"],["、"],["彼","かれ"],["は"],["必","かならず"],["あなた"],["がた"],["を"],["責","せめ"],["られる"],["。"]]},{"verse":11,"text":"その威厳,いげんはあなたがたを恐,おそれさせないであろうか。彼,かれをおそれる恐,おそれがあなたがたに臨,のぞまないであろうか。","tok":[["その"],["威厳","いげん"],["は"],["あなた"],["がた"],["を"],["恐れさせないで","おそれさせないで"],["あろう"],["か"],["。"],["彼","かれ"],["を"],["おそれる"],["恐","おそれ"],["が"],["あなた"],["がた"],["に"],["臨まないで","のぞまないで"],["あろう"],["か"],["。"]]},{"verse":12,"text":"あなたがたの格言,かくげんは灰,はいのことわざだ。あなたがたの盾,たては土,つちの盾,たてだ。","tok":[["あなた"],["がた"],["の"],["格言","かくげん"],["は"],["灰","はい"],["の"],["ことわざ"],["だ"],["。"],["あなた"],["がた"],["の"],["盾","たて"],["は"],["土","つち"],["の"],["盾","たて"],["だ"],["。"]]},{"verse":13,"text":"黙,もくして、わたしにかかわるな、わたしは話,はなそう。何事,なにごとでもわたしに来,くるなら、来,くるがよい。","tok":[["黙して","もくして"],["、"],["わたし"],["に"],["かかわる"],["な"],["、"],["わたし"],["は"],["話そう","はなそう"],["。"],["何事","なにごと"],["で"],["も"],["わたし"],["に"],["来るなら","くるなら"],["、"],["来る","くる"],["が"],["よい"],["。"]]},{"verse":14,"text":"わたしはわが肉,にくをわが歯,はに取,とり、わが命,いのちをわが手,てのうちに置,おく。","tok":[["わたし"],["は"],["わが"],["肉","にく"],["を"],["わが"],["歯","は"],["に"],["取","とり"],["、"],["わが"],["命","いのち"],["を"],["わが"],["手","て"],["の"],["うち"],["に"],["置く","おく"],["。"]]},{"verse":15,"text":"見,みよ、彼,かれはわたしを殺,ころすであろう。わたしは絶望,ぜつぼうだ。しかしなおわたしはわたしの道,みちを彼,かれの前,まえに守,まもり抜,ぬこう。","tok":[["見よ","みよ"],["、"],["彼","かれ"],["は"],["わたし"],["を"],["殺ろすで","ころすで"],["あろう"],["。"],["わたし"],["は"],["絶望","ぜつぼう"],["だ"],["。"],["しかし"],["なお"],["わたし"],["は"],["わたし"],["の"],["道","みち"],["を"],["彼","かれ"],["の"],["前","まえ"],["に"],["守り","まもり"],["抜こう","ぬこう"],["。"]]},{"verse":16,"text":"これこそわたしの救,すくいとなる。神,かみを信,しんじない者,ものは、神,かみの前,まえに出,でることができないからだ。","tok":[["これ"],["こそ"],["わたし"],["の"],["救い","すくい"],["と"],["なる"],["。"],["神","かみ"],["を"],["信じない","しんじない"],["者","もの"],["は"],["、"],["神","かみ"],["の"],["前","まえ"],["に"],["出る","でる"],["こと"],["が"],["できない"],["から"],["だ"],["。"]]},{"verse":17,"text":"あなたがたはよくわたしの言葉,ことばを聞,きき、わたしの述,のべる所,ところを耳,みみに入,いれよ。","tok":[["あなた"],["がた"],["は"],["よく"],["わたし"],["の"],["言葉","ことば"],["を"],["聞","きき"],["、"],["わたし"],["の"],["述べる","のべる"],["所","ところ"],["を"],["耳","みみ"],["に"],["入れよ","いれよ"],["。"]]},{"verse":18,"text":"見,みよ、わたしはすでにわたしの立,たち場,ばを言,いい並,ならべた。わたしは義,ぎとされることをみずから知,しっている。","tok":[["見よ","みよ"],["、"],["わたし"],["は"],["すでに"],["わたし"],["の"],["立ち","たち"],["場","ば"],["を"],["言い並べた","いいならべた"],["。"],["わたし"],["は"],["義","ぎ"],["と"],["される"],["こと"],["を"],["みずから"],["知って","しって"],["いる"],["。"]]},{"verse":19,"text":"だれかわたしと言,いい争,あらそう事,ことのできる者,ものがあろうか。もしあるならば、わたしは黙,もくして死,しぬであろう。","tok":[["だれ"],["か"],["わたし"],["と"],["言い争う","いいあらそう"],["事","こと"],["の"],["できる"],["者","もの"],["が"],["あろう"],["か"],["。"],["もし"],["あるならば"],["、"],["わたし"],["は"],["黙して","もくして"],["死ぬで","しぬで"],["あろう"],["。"]]},{"verse":20,"text":"ただわたしに二つの事,ことを許,ゆるしてください。そうすれば、わたしはあなたの顔,かおをさけて隠,かくれることはないでしょう。","tok":[["ただ"],["わたし"],["に"],["二","ふた"],["つ"],["の"],["事","こと"],["を"],["許して","ゆるして"],["ください"],["。"],["そう"],["すれば"],["、"],["わたし"],["は"],["あなた"],["の"],["顔","かお"],["を"],["さけて"],["隠れる","かくれる"],["こと"],["は"],["ないでしょう"],["。"]]},{"verse":21,"text":"あなたの手,てをわたしから離,はなしてください。あなたの恐,おそるべき事,ことをもってわたしを恐,おそれさせないでください。","tok":[["あなた"],["の"],["手","て"],["を"],["わたし"],["から"],["離して","はなして"],["ください"],["。"],["あなた"],["の"],["恐るべき","おそるべき"],["事","こと"],["を"],["もって"],["わたし"],["を"],["恐れさせないで","おそれさせないで"],["ください"],["。"]]},{"verse":22,"text":"そしてお呼,およびください、わたしは答,こたえます。わたしに物,ものを言,いわせて、あなたご自身,じしん、わたしにお答,こたえください。","tok":[["そして"],["お呼","おお"],["よび"],["ください"],["、"],["わたし"],["は"],["答","こたえ"],["ます"],["。"],["わたし"],["に"],["物","もの"],["を"],["言わせて","いわせて"],["、"],["あなた"],["ご自身","ごじしん"],["、"],["わたし"],["に"],["お答","おこたえ"],["ください"],["。"]]},{"verse":23,"text":"わたしのよこしまと、わたしの罪,つみがどれほどあるか。わたしのとがと罪,つみとをわたしに知,しらせてください。","tok":[["わたし"],["の"],["よこしま"],["と"],["、"],["わたし"],["の"],["罪","つみ"],["が"],["どれ"],["ほど"],["ある"],["か"],["。"],["わたし"],["の"],["とが"],["と"],["罪","つみ"],["と"],["を"],["わたし"],["に"],["知らせて","しらせて"],["ください"],["。"]]},{"verse":24,"text":"なにゆえ、あなたはみ顔,かおをかくし、わたしをあなたの敵,てきとされるのか。","tok":[["なにゆえ"],["、"],["あなた"],["は"],["み顔","みかお"],["を"],["かくし"],["、"],["わたし"],["を"],["あなた"],["の"],["敵","てき"],["と"],["される"],["の"],["か"],["。"]]},{"verse":25,"text":"あなたは吹,ふき回,まわされる木,この葉,はをおどし、干,ひあがったもみがらを追,おわれるのか。","tok":[["あなた"],["は"],["吹","ふき"],["回わされる","まわされる"],["木の葉","このは"],["を"],["おどし"],["、"],["干あがった","ひあがった"],["もみがら"],["を"],["追われる","おわれる"],["の"],["か"],["。"]]},{"verse":26,"text":"あなたはわたしについて苦,にがき事,ことどもを書,かきしるし、わたしに若,わかい時,ときの罪,つみを継,つがせ、","tok":[["あなた"],["は"],["わたし"],["について"],["苦","に"],["がき"],["事","こと"],["ども"],["を"],["書きしるし","かきしるし"],["、"],["わたし"],["に"],["若い","わかい"],["時","とき"],["の"],["罪","つみ"],["を"],["継がせ","つがせ"],["、"]]},{"verse":27,"text":"わたしの足,あしを足,あしかせにはめ、わたしのすべての道,みちをうかがい、わたしの足,あしの周囲,しゅういに限,かぎりをつけられる。","tok":[["わたし"],["の"],["足","あし"],["を"],["足かせ","あしかせ"],["に"],["はめ"],["、"],["わたし"],["の"],["すべて"],["の"],["道","みち"],["を"],["うかがい"],["、"],["わたし"],["の"],["足","あし"],["の"],["周囲","しゅうい"],["に"],["限","かぎり"],["を"],["つけられる"],["。"]]},{"verse":28,"text":"このような人,ひとは腐,くされた物,もののように朽,くち果,はて、虫,むしに食,くわれた衣服,いふくのようにすたれる。","tok":[["この"],["よう"],["な"],["人","ひと"],["は"],["腐れた","くされた"],["物","もの"],["の"],["よう"],["に"],["朽ち","くち"],["果て","はて"],["、"],["虫","むし"],["に"],["食われた","くわれた"],["衣服","いふく"],["の"],["よう"],["に"],["すたれる"],["。"]]}]
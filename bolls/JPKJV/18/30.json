[{"verse":1,"text":"しかし今,いまはわたしよりも年,とし若,わかい者,ものが、かえってわたしをあざ笑,わらう。彼,かれらの父,ちちはわたしが卑,いやしめて、群,むれの犬,いぬと一緒,いっしょにさえしなかった者,ものだ。","tok":[["しかし"],["今","いま"],["は"],["わたし"],["より"],["も"],["年","と"],["し"],["若い","わかい"],["者","もの"],["が"],["、"],["かえって"],["わたし"],["を"],["あざ笑う","あざわらう"],["。"],["彼","かれ"],["ら"],["の"],["父","ちち"],["は"],["わたし"],["が"],["卑しめて","いやしめて"],["、"],["群れ","むれ"],["の"],["犬","いぬ"],["と"],["一緒","いっしょ"],["に"],["さえ"],["しなかった"],["者","もの"],["だ"],["。"]]},{"verse":2,"text":"彼,かれらの手,ての力,ちからからわたしは何,なにを得,えるであろうか、彼,かれらはその気力,きりょくがすでに衰,おとろえた人々,ひとびとだ。","tok":[["彼","かれ"],["ら"],["の"],["手","て"],["の"],["力","ちから"],["から"],["わたし"],["は"],["何に","なに"],["を"],["得るで","えるで"],["あろう"],["か"],["、"],["彼","かれ"],["ら"],["は"],["その"],["気力","きりょく"],["が"],["すでに"],["衰えた","おとろえた"],["人々","ひとびと"],["だ"],["。"]]},{"verse":3,"text":"彼,かれらは乏,とぼしさと激,はげしい飢,うえとによって、かわいた荒,あれ地,ちをかむ。","tok":[["彼","かれ"],["ら"],["は"],["乏","とぼし"],["さ"],["と"],["激しい","はげしい"],["飢","うえ"],["と"],["によって"],["、"],["かわいた"],["荒れ地","あれち"],["を"],["かむ"],["。"]]},{"verse":4,"text":"彼,かれらは、ぜにあおいおよび灌木,かんぼくの葉,はを摘,つみ、れだまの根,ねをもって身,みを暖,あたためる。","tok":[["彼","かれ"],["ら"],["は"],["、"],["ぜに"],["あおい"],["および"],["灌木","かんぼく"],["の"],["葉","は"],["を"],["摘み","つみ"],["、"],["れだま"],["の"],["根","ね"],["を"],["もって"],["身","み"],["を"],["暖める","あたためる"],["。"]]},{"verse":5,"text":"彼,かれらは人々,ひとびとの中,なかから追,おいだされ、盗,ぬすびとを追,おうように、人々,ひとびとは彼,かれらを追,おい呼,よばわる。","tok":[["彼","かれ"],["ら"],["は"],["人々","ひとびと"],["の"],["中","なか"],["から"],["追いだされ","おいだされ"],["、"],["盗","ぬすびと"],["を"],["追う","おう"],["よう"],["に"],["、"],["人々","ひとびと"],["は"],["彼","かれ"],["ら"],["を"],["追い","おい"],["呼ばわる","よばわる"],["。"]]},{"verse":6,"text":"彼,かれらは急流,きゅうりゅうの谷間,たにまに住,すみ、土,つちの穴,あなまたは岩,いわの穴,あなにおり、","tok":[["彼","かれ"],["ら"],["は"],["急流","きゅうりゅう"],["の"],["谷間","たにま"],["に"],["住み","すみ"],["、"],["土","つち"],["の"],["穴","あな"],["また"],["は"],["岩","いわ"],["の"],["穴","あな"],["に"],["おり"],["、"]]},{"verse":7,"text":"灌木,かんぼくの中,なかにいななき、いらくさの下,したに押,おし合,あう。","tok":[["灌木","かんぼく"],["の"],["中","なか"],["に"],["いななき"],["、"],["いらくさ"],["の"],["下","した"],["に"],["押","おし"],["合う","あう"],["。"]]},{"verse":8,"text":"彼,かれらは愚,おろかな者,ものの子,こ、また卑,いやしい者,ものの子,こであって、国,くにから追,おいだされた者,ものだ。","tok":[["彼","かれ"],["ら"],["は"],["愚か","おろか"],["な"],["者","もの"],["の"],["子","こ"],["、"],["また"],["卑しい","いやしい"],["者","もの"],["の"],["子","こ"],["で"],["あって"],["、"],["国","くに"],["から"],["追いだされた","おいだされた"],["者","もの"],["だ"],["。"]]},{"verse":9,"text":"それなのに、わたしは今,いま彼,かれらの歌,うたとなり、彼,かれらの笑,わらい草,ぐさとなった。","tok":[["それ"],["な"],["のに"],["、"],["わたし"],["は"],["今","いま"],["彼","かれ"],["ら"],["の"],["歌","うた"],["と"],["なり"],["、"],["彼","かれ"],["ら"],["の"],["笑草","わらいぐさ"],["と"],["なった"],["。"]]},{"verse":10,"text":"彼,かれらはわたしをいとい、遠,とおくわたしをはなれ、わたしの顔,かおにつばきすることも、ためらわない。","tok":[["彼","かれ"],["ら"],["は"],["わたし"],["を"],["いとい"],["、"],["遠く","とおく"],["わたし"],["を"],["はなれ"],["、"],["わたし"],["の"],["顔","かお"],["に"],["つばき"],["する"],["こと"],["も"],["、"],["ためらわない"],["。"]]},{"verse":11,"text":"神,かみがわたしの綱,つなを解,といて、わたしを卑,いやしめられたので、彼,かれらもわたしの前,まえに慎,つつしみを捨,すてた。","tok":[["神","かみ"],["が"],["わたし"],["の"],["綱","つな"],["を"],["解いて","といて"],["、"],["わたし"],["を"],["卑しめられた","いやしめられた"],["ので"],["、"],["彼","かれ"],["ら"],["も"],["わたし"],["の"],["前","まえ"],["に"],["慎しみ","つつしみ"],["を"],["捨てた","すてた"],["。"]]},{"verse":12,"text":"このともがらはわたしの右,みぎに立,たち上,あがり、わたしを追,おいのけ、わたしにむかって滅,ほろびの道,みちを築,きずく。","tok":[["この"],["とも"],["がら"],["は"],["わたし"],["の"],["右","みぎ"],["に"],["立ち上がり","たちあがり"],["、"],["わたし"],["を"],["追いのけ","おいのけ"],["、"],["わたし"],["に"],["むかって"],["滅び","ほろび"],["の"],["道","みち"],["を"],["築く","きずく"],["。"]]},{"verse":13,"text":"彼,かれらはわたしの道,みちをこわし、わたしの災,わざわいを促,うながす。これをさし止,とめる者,ものはない。","tok":[["彼","かれ"],["ら"],["は"],["わたし"],["の"],["道","みち"],["を"],["こわし"],["、"],["わたし"],["の"],["災","わざわい"],["を"],["促がす","うながす"],["。"],["これ"],["を"],["さし止める","さしとめる"],["者","もの"],["は"],["ない"],["。"]]},{"verse":14,"text":"彼,かれらは広,ひろい破,やぶれ口,くちからはいるように進,すすみきたり、破壊,はかいの中,なかをおし寄,よせる。","tok":[["彼","かれ"],["ら"],["は"],["広い","ひろい"],["破れ","やぶれ"],["口","くち"],["から"],["は"],["いる"],["よう"],["に"],["進み","すすみ"],["き"],["たり"],["、"],["破壊","はかい"],["の"],["中","なか"],["を"],["おし寄せる","おしよせる"],["。"]]},{"verse":15,"text":"恐,おそろしい事,ことはわたしに臨,のぞみ、わたしの誉,ほまれは風,かぜのように吹,ふき払,はらわれ、わたしの繁栄,はんえいは雲,くものように消,きえうせた。","tok":[["恐ろしい","おそろしい"],["事","こと"],["は"],["わたし"],["に"],["臨み","のぞみ"],["、"],["わたし"],["の"],["誉","ほまれ"],["は"],["風","かぜ"],["の"],["よう"],["に"],["吹払われ","ふきはらわれ"],["、"],["わたし"],["の"],["繁栄","はんえい"],["は"],["雲","くも"],["の"],["よう"],["に"],["消えうせた","きえうせた"],["。"]]},{"verse":16,"text":"今,いまは、わたしの魂,たましいはわたしの内,うちにとけて流,ながれ、悩,なやみの日,ひはわたしを捕,とらえた。","tok":[["今","いま"],["は"],["、"],["わたし"],["の"],["魂","たましい"],["は"],["わたし"],["の"],["内","うち"],["に"],["とけて"],["流れ","ながれ"],["、"],["悩み","なやみ"],["の"],["日","ひ"],["は"],["わたし"],["を"],["捕らえた","とらえた"],["。"]]},{"verse":17,"text":"夜,よるはわたしの骨,ほねを激,はげしく悩,なやまし、わたしをかむ苦,くるしみは、やむことがない。","tok":[["夜","よる"],["は"],["わたし"],["の"],["骨","ほね"],["を"],["激しく","はげしく"],["悩し","なやまし"],["、"],["わたし"],["を"],["かむ"],["苦しみ","くるしみ"],["は"],["、"],["やむ"],["こと"],["が"],["ない"],["。"]]},{"verse":18,"text":"それは暴力,ぼうりょくをもって、わたしの着物,きものを捕,とらえ、はだ着,きのえりのように、わたしをしめつける。","tok":[["それ"],["は"],["暴力","ぼうりょく"],["を"],["もって"],["、"],["わたし"],["の"],["着物","きもの"],["を"],["捕らえ","とらえ"],["、"],["はだ着","はだき"],["の"],["えり"],["の"],["よう"],["に"],["、"],["わたし"],["を"],["しめつける"],["。"]]},{"verse":19,"text":"神,かみがわたしを泥,どろの中,なかに投,なげ入,いれられたので、わたしはちり灰,はいのようになった。","tok":[["神","かみ"],["が"],["わたし"],["を"],["泥","どろ"],["の"],["中","なか"],["に"],["投入れられた","なげいれられた"],["ので"],["、"],["わたし"],["は"],["ちり"],["灰","はい"],["の"],["よう"],["に"],["なった"],["。"]]},{"verse":20,"text":"わたしがあなたにむかって呼,よばわっても、あなたは答,こたえられない。わたしが立,たっていても、あなたは顧,かえりみられない。","tok":[["わたし"],["が"],["あなた"],["に"],["むかって"],["呼ばわって","よばわって"],["も"],["、"],["あなた"],["は"],["答","こたえ"],["られない"],["。"],["わたし"],["が"],["立って","たって"],["いて"],["も"],["、"],["あなた"],["は"],["顧りみられない","かえりみられない"],["。"]]},{"verse":21,"text":"あなたは変,かわって、わたしに無情,むじょうな者,ものとなり、み手,ての力,ちからをもってわたしを攻,せめ悩,なやまされる。","tok":[["あなた"],["は"],["変わって","かわって"],["、"],["わたし"],["に"],["無情","むじょう"],["な"],["者","もの"],["と"],["なり"],["、"],["み手","みて"],["の"],["力","ちから"],["を"],["もって"],["わたし"],["を"],["攻め","せめ"],["悩される","なやまされる"],["。"]]},{"verse":22,"text":"あなたはわたしを揚,あげて風,かぜの上,うえに乗,のせ、大風,おおかぜのうなり声,こえの中,なかに、もませられる。","tok":[["あなた"],["は"],["わたし"],["を"],["揚げて","あげて"],["風","かぜ"],["の"],["上","うえ"],["に"],["乗せ","のせ"],["、"],["大風","おおかぜ"],["の"],["うなり声","うなりこえ"],["の"],["中","なか"],["に"],["、"],["もませられる"],["。"]]},{"verse":23,"text":"わたしは知,しっている、あなたはわたしを死,しに帰,かえらせ、すべての生,いき物,ものの集,あつまる家,いえに帰,かえらせられることを。","tok":[["わたし"],["は"],["知って","しって"],["いる"],["、"],["あなた"],["は"],["わたし"],["を"],["死","し"],["に"],["帰えらせ","かえらせ"],["、"],["すべて"],["の"],["生き物","いきもの"],["の"],["集まる","あつまる"],["家","いえ"],["に"],["帰えらせられる","かえらせられる"],["こと"],["を"],["。"]]},{"verse":24,"text":"さりながら荒塚,あらつかの中,なかにある者,ものは、手,てを伸,のべないであろうか、災,わざわいの中,なかにある者,ものは助,たすけを呼,よび求,もとめないであろうか。","tok":[["さり"],["ながら"],["荒塚","あらつか"],["の"],["中","なか"],["に"],["ある"],["者","もの"],["は"],["、"],["手","て"],["を"],["伸べないで","のべないで"],["あろう"],["か"],["、"],["災","わざわい"],["の"],["中","なか"],["に"],["ある"],["者","もの"],["は"],["助け","たすけ"],["を"],["呼び求めないで","よびもとめないで"],["あろう"],["か"],["。"]]},{"verse":25,"text":"わたしは苦,くるしい日,ひを送,おくる者,もののために泣,なかなかったか。わたしの魂,たましいは貧,まずしい人,ひとのために悲,かなしまなかったか。","tok":[["わたし"],["は"],["苦しい","くるしい"],["日","ひ"],["を"],["送る","おくる"],["者","もの"],["の"],["ため"],["に"],["泣かなかった","なかなかった"],["か"],["。"],["わたし"],["の"],["魂","たましい"],["は"],["貧しい","まずしい"],["人","ひと"],["の"],["ため"],["に"],["悲しまなかった","かなしまなかった"],["か"],["。"]]},{"verse":26,"text":"しかしわたしが幸,さいわいを望,のぞんだのに災,わざわいが来,きた。光,ひかりを待,まち望,のぞんだのにやみが来,きた。","tok":[["しかし"],["わたし"],["が"],["幸い","さいわい"],["を"],["望","のぞんだ"],["のに"],["災","わざわい"],["が"],["来た","きた"],["。"],["光","ひかり"],["を"],["待ち","まち"],["望","のぞんだ"],["のに"],["やみ"],["が"],["来た","きた"],["。"]]},{"verse":27,"text":"わたしのはらわたは沸,わきかえって、静,しずまらない。悩,なやみの日,ひがわたしに近,ちかづいた。","tok":[["わたし"],["の"],["はらわた"],["は"],["沸きかえって","わきかえって"],["、"],["静まらない","しずまらない"],["。"],["悩み","なやみ"],["の"],["日","ひ"],["が"],["わたし"],["に"],["近づいた","ちかづいた"],["。"]]},{"verse":28,"text":"わたしは日,ひの光,ひかりによらずに黒,くろくなって歩,あるき、公会,こうかいの中,なかに立,たって助,たすけを呼,よび求,もとめる。","tok":[["わたし"],["は"],["日","ひ"],["の"],["光","ひかり"],["に"],["よらず"],["に"],["黒く","くろく"],["なって"],["歩き","あるき"],["、"],["公会","こうかい"],["の"],["中","なか"],["に"],["立って","たって"],["助け","たすけ"],["を"],["呼び求める","よびもとめる"],["。"]]},{"verse":29,"text":"わたしは山犬,やまいぬの兄弟,きょうだいとなり、だちょうの友,ともとなった。","tok":[["わたし"],["は"],["山犬","やまいぬ"],["の"],["兄弟","きょうだい"],["と"],["なり"],["、"],["だちょう"],["の"],["友","とも"],["と"],["なった"],["。"]]},{"verse":30,"text":"わたしの皮膚,ひふは黒,くろくなって、はげ落,おち、わたしの骨,ほねは熱,あつさによって燃,もえ、","tok":[["わたし"],["の"],["皮膚","ひふ"],["は"],["黒く","くろく"],["なって"],["、"],["はげ"],["落","おち"],["、"],["わたし"],["の"],["骨","ほね"],["は"],["熱","あつ"],["さ"],["によって"],["燃え","もえ"],["、"]]},{"verse":31,"text":"わたしの琴,ことは悲,かなしみの音,おととなり、わたしの笛,ふえは泣,なく者,ものの声,こえとなった。","tok":[["わたし"],["の"],["琴","こと"],["は"],["悲しみ","かなしみ"],["の"],["音","おと"],["と"],["なり"],["、"],["わたし"],["の"],["笛","ふえ"],["は"],["泣く","なく"],["者","もの"],["の"],["声","こえ"],["と"],["なった"],["。"]]}]
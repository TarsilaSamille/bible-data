[{"verse":1,"text":"そこでヨブは答,こたえて言,いった、","tok":[["そこ"],["で"],["ヨブ"],["は"],["答","こたえ"],["て"],["言った","いった"],["、"]]},{"verse":2,"text":"「わたしはこのような事,ことを数多,かずおおく聞,きいた。あなたがたは皆,みな人,ひとを慰,なぐさめようとして、かえって人,ひとを煩,わずらわす者,ものだ。","tok":[["「"],["わたし"],["は"],["この"],["よう"],["な"],["事","こと"],["を"],["数多く","かずおおく"],["聞いた","きいた"],["。"],["あなた"],["がた"],["は"],["皆人","みなひと"],["を"],["慰さめよう","なぐさめよう"],["として"],["、"],["かえって"],["人","ひと"],["を"],["煩わす","わずらわす"],["者","もの"],["だ"],["。"]]},{"verse":3,"text":"むなしき言葉,ことばに、はてしがあろうか。あなたは何,なにに激,げきして答,こたえをするのか。","tok":[["むなしき"],["言葉","ことば"],["に"],["、"],["はてし"],["が"],["あろう"],["か"],["。"],["あなた"],["は"],["何に","なに"],["に"],["激して","げきして"],["答","こたえ"],["を"],["する"],["の"],["か"],["。"]]},{"verse":4,"text":"わたしもあなたがたのように語,かたることができる。もしあなたがたがわたしと代,かわったならば、わたしは言葉,ことばを練,ねって、あなたがたを攻,せめ、あなたがたに向,むかって頭,あたまを振,ふることができる。","tok":[["わたし"],["も"],["あなた"],["がた"],["の"],["よう"],["に"],["語る","かたる"],["こと"],["が"],["できる"],["。"],["もし"],["あなた"],["がた"],["が"],["わたし"],["と"],["代わったならば","かわったならば"],["、"],["わたし"],["は"],["言葉","ことば"],["を"],["練って","ねって"],["、"],["あなた"],["がた"],["を"],["攻め","せめ"],["、"],["あなた"],["がた"],["に"],["向かって","むかって"],["頭","あたま"],["を"],["振る","ふる"],["こと"],["が"],["できる"],["。"]]},{"verse":5,"text":"また口,くちをもって、あなたがたを強,つよくし、くちびるの慰,なぐさめをもって、あなたがたの苦,くるしみを和,やわらげることができる。","tok":[["また"],["口","くち"],["を"],["もって"],["、"],["あなた"],["がた"],["を"],["強く","つよく"],["し"],["、"],["くちびる"],["の"],["慰さめ","なぐさめ"],["を"],["もって"],["、"],["あなた"],["がた"],["の"],["苦しみ","くるしみ"],["を"],["和らげる","やわらげる"],["こと"],["が"],["できる"],["。"]]},{"verse":6,"text":"たといわたしは語,かたっても、わたしの苦,くるしみは和,やわらげられない。たといわたしは忍,しのんでも、どれほどそれがわたしを去,さるであろうか。","tok":[["たとい"],["わたし"],["は"],["語って","かたって"],["も"],["、"],["わたし"],["の"],["苦しみ","くるしみ"],["は"],["和らげられない","やわらげられない"],["。"],["たとい"],["わたし"],["は"],["忍","しのん"],["で"],["も"],["、"],["どれ"],["ほど"],["それ"],["が"],["わたし"],["を"],["去るで","さるで"],["あろう"],["か"],["。"]]},{"verse":7,"text":"まことに神,かみは今,いまわたしを疲,つかれさせた。彼,かれはわたしのやからをことごとく荒,あらした。","tok":[["まこと"],["に"],["神","かみ"],["は"],["今","いま"],["わたし"],["を"],["疲れさせた","つかれさせた"],["。"],["彼","かれ"],["は"],["わたし"],["の"],["やから"],["を"],["ことごとく"],["荒した","あらした"],["。"]]},{"verse":8,"text":"彼,かれはわたしを、しわ寄,よらせた。これがわたしに対,たいする証拠,しょうこである。またわたしのやせ衰,おとろえた姿,すがたが立,たって、わたしを攻,せめ、わたしの顔,かおにむかって証明,しょうめいする。","tok":[["彼","かれ"],["は"],["わたし"],["を"],["、"],["しわ寄らせた","しわよらせた"],["。"],["これ"],["が"],["わたし"],["に"],["対する","たいする"],["証拠","しょうこ"],["で"],["ある"],["。"],["また"],["わたし"],["の"],["やせ衰えた","やせおとろえた"],["姿","すがた"],["が"],["立って","たって"],["、"],["わたし"],["を"],["攻め","せめ"],["、"],["わたし"],["の"],["顔","かお"],["に"],["むかって"],["証明","しょうめい"],["する"],["。"]]},{"verse":9,"text":"彼,かれは怒,いかってわたしをかき裂,さき、わたしを憎,にくみ、わたしに向,むかって歯,はをかみ鳴,ならした。わたしの敵,てきは目,めを鋭,するどくして、わたしを攻,せめる。","tok":[["彼","かれ"],["は"],["怒","い"],["か"],["って"],["わたし"],["を"],["かき裂き","かきさき"],["、"],["わたし"],["を"],["憎み","にくみ"],["、"],["わたし"],["に"],["向かって","むかって"],["歯","は"],["を"],["かみ"],["鳴らした","ならした"],["。"],["わたし"],["の"],["敵","てき"],["は"],["目","め"],["を"],["鋭く","するどく"],["して"],["、"],["わたし"],["を"],["攻める","せめる"],["。"]]},{"verse":10,"text":"人々,ひとびとはわたしに向,むかって口,くちを張,はり、侮,あなどってわたしのほおを打,うち、ともに集,あつまってわたしを攻,せめる。","tok":[["人々","ひとびと"],["は"],["わたし"],["に"],["向かって","むかって"],["口","くち"],["を"],["張り","はり"],["、"],["侮って","あなどって"],["わたし"],["の"],["ほお"],["を"],["打ち","うち"],["、"],["とも"],["に"],["集まって","あつまって"],["わたし"],["を"],["攻める","せめる"],["。"]]},{"verse":11,"text":"神,かみはわたしをよこしまな者,ものに渡,わたし、悪人,あくにんの手,てに投,なげいれられる。","tok":[["神","かみ"],["は"],["わたし"],["を"],["よこしま"],["な"],["者","もの"],["に"],["渡","わたし"],["、"],["悪人","あくにん"],["の"],["手","て"],["に"],["投","なげ"],["いれられる"],["。"]]},{"verse":12,"text":"わたしは安,やすらかであったのに、彼,かれはわたしを切,きり裂,さき、首,くびを捕,とらえて、わたしを打,うち砕,くだき、わたしを立,たてて的,まととされた。","tok":[["わたし"],["は"],["安らか","やすらか"],["で"],["あった"],["のに"],["、"],["彼","かれ"],["は"],["わたし"],["を"],["切り裂き","きりさき"],["、"],["首","くび"],["を"],["捕らえて","とらえて"],["、"],["わたし"],["を"],["打ち砕き","うちくだき"],["、"],["わたし"],["を"],["立てて","たてて"],["的","まと"],["と"],["された"],["。"]]},{"verse":13,"text":"その射手,しゃしゅはわたしを囲,かこむ。彼,かれは無慈悲,むじひにもわたしの腰,こしを射通,いとおし、わたしの肝,きもを地,ちに流,ながれ出,ださせられる。","tok":[["その"],["射手","しゃしゅ"],["は"],["わたし"],["を"],["囲む","かこむ"],["。"],["彼","かれ"],["は"],["無慈悲","むじひ"],["に"],["も"],["わたし"],["の"],["腰","こし"],["を"],["射通し","いとおし"],["、"],["わたし"],["の"],["肝","きも"],["を"],["地","ち"],["に"],["流れ出させられる","ながれださせられる"],["。"]]},{"verse":14,"text":"彼,かれはわたしを打,うち破,やぶって、破,やぶれに破,やぶれを加,くわえ、勇士,ゆうしのようにわたしに、はせかかられる。","tok":[["彼","かれ"],["は"],["わたし"],["を"],["打ち破って","うちやぶって"],["、"],["破れ","やぶれ"],["に"],["破れ","やぶれ"],["を"],["加え","くわえ"],["、"],["勇士","ゆうし"],["の"],["よう"],["に"],["わたし"],["に"],["、"],["はせ"],["かかられる"],["。"]]},{"verse":15,"text":"わたしは荒布,あらぬのを膚,はだに縫,ぬいつけ、わたしの角,つのをちりに伏,ふせた。","tok":[["わたし"],["は"],["荒布","あらぬ"],["の"],["を"],["膚","はだ"],["に"],["縫","ぬい"],["つけ"],["、"],["わたし"],["の"],["角","つ"],["の"],["を"],["ちり"],["に"],["伏せた","ふせた"],["。"]]},{"verse":16,"text":"わたしの顔,かおは泣,ないて赤,あかくなり、わたしのまぶたには深,ふかいやみがある。","tok":[["わたし"],["の"],["顔","かお"],["は"],["泣いて","ないて"],["赤く","あかく"],["なり"],["、"],["わたし"],["の"],["まぶた"],["に"],["は"],["深い","ふかい"],["やみ"],["が"],["ある"],["。"]]},{"verse":17,"text":"しかし、わたしの手,てには暴虐,ぼうぎゃくがなく、わたしの祈,いのりは清,きよい。","tok":[["しかし"],["、"],["わたし"],["の"],["手","て"],["に"],["は"],["暴虐","ぼうぎゃく"],["が"],["なく"],["、"],["わたし"],["の"],["祈","いのり"],["は"],["清い","きよい"],["。"]]},{"verse":18,"text":"地,ちよ、わたしの血,ちをおおってくれるな。わたしの叫,さけびに、休,やすむ所,ところを得,えさせるな。","tok":[["地","ち"],["よ"],["、"],["わたし"],["の"],["血","ち"],["を"],["おおって"],["くれる"],["な"],["。"],["わたし"],["の"],["叫","さけび"],["に"],["、"],["休む","やすむ"],["所","ところ"],["を"],["得させる","えさせる"],["な"],["。"]]},{"verse":19,"text":"見,みよ、今,いまでもわたしの証人,しょうにんは天,てんにある。わたしのために保証,ほしょうしてくれる者,ものは高,たかい所,ところにある。","tok":[["見よ","みよ"],["、"],["今","いま"],["で"],["も"],["わたし"],["の"],["証人","しょうにん"],["は"],["天","てん"],["に"],["ある"],["。"],["わたし"],["の"],["ため"],["に"],["保証","ほしょう"],["して"],["くれる"],["者","もの"],["は"],["高かい","たかい"],["所","ところ"],["に"],["ある"],["。"]]},{"verse":20,"text":"わたしの友,ともはわたしをあざける、しかしわたしの目,めは神,かみに向,むかって涙,なみだを注,そそぐ。","tok":[["わたし"],["の"],["友","とも"],["は"],["わたし"],["を"],["あざける"],["、"],["しかし"],["わたし"],["の"],["目","め"],["は"],["神","かみ"],["に"],["向かって","むかって"],["涙","なみだ"],["を"],["注ぐ","そそぐ"],["。"]]},{"verse":21,"text":"どうか彼,かれが人,ひとのために神,かみと弁論,べんろんし、人,ひととその友,ともとの間,あいだをさばいてくれるように。","tok":[["どう"],["か"],["彼","かれ"],["が"],["人","ひと"],["の"],["ため"],["に"],["神","かみ"],["と"],["弁論","べんろん"],["し"],["、"],["人","ひと"],["と"],["その"],["友","とも"],["と"],["の"],["間","あいだ"],["を"],["さばいて"],["くれる"],["よう"],["に"],["。"]]},{"verse":22,"text":"数年,すうねん過,すぎ去,されば、わたしは帰,かえらぬ旅路,たびじに行,いくであろう。","tok":[["数","すう"],["年","ねん"],["過去れば","すぎされば"],["、"],["わたし"],["は"],["帰えらぬ","かえらぬ"],["旅路","たびじ"],["に"],["行くで","いくで"],["あろう"],["。"]]}]
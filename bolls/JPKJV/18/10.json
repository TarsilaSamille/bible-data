[{"verse":1,"text":"わたしは自分,じぶんの命,いのちをいとう。わたしは自分,じぶんの嘆,なげきを包,つつまず言,いいあらわし、わが魂,たましいの苦,くるしみによって語,かたろう。","tok":[["わたし"],["は"],["自分","じぶん"],["の"],["命","いのち"],["を"],["いとう"],["。"],["わたし"],["は"],["自分","じぶん"],["の"],["嘆き","なげき"],["を"],["包まず","つつまず"],["言いあらわし","いいあらわし"],["、"],["わが"],["魂","たましい"],["の"],["苦しみ","くるしみ"],["によって"],["語ろう","かたろう"],["。"]]},{"verse":2,"text":"わたしは神,かみに申,もうそう、わたしを罪,つみある者,ものとされないように。なぜわたしと争,あらそわれるかを知,しらせてほしい。","tok":[["わたし"],["は"],["神","かみ"],["に"],["申そう","もうそう"],["、"],["わたし"],["を"],["罪","つみ"],["ある"],["者","もの"],["と"],["されない"],["よう"],["に"],["。"],["なぜ"],["わたし"],["と"],["争われる","あらそわれる"],["か"],["を"],["知らせて","しらせて"],["ほしい"],["。"]]},{"verse":3,"text":"あなたはしえたげをなし、み手,てのわざを捨,すて、悪人,あくにんの計画,けいかくを照,てらすことを良,よしとされるのか。","tok":[["あなた"],["は"],["し"],["えたげ"],["を"],["なし"],["、"],["み手","みて"],["の"],["わざ"],["を"],["捨て","すて"],["、"],["悪人","あくにん"],["の"],["計画","けいかく"],["を"],["照らす","てらす"],["こと"],["を"],["良し","よし"],["と"],["される"],["の"],["か"],["。"]]},{"verse":4,"text":"あなたの持,もっておられるのは肉,にくの目,めか、あなたは人,ひとが見,みるように見,みられるのか。","tok":[["あなた"],["の"],["持って","もって"],["おられる"],["の"],["は"],["肉","にく"],["の"],["目","め"],["か"],["、"],["あなた"],["は"],["人","ひと"],["が"],["見る","みる"],["よう"],["に"],["見られる","みられる"],["の"],["か"],["。"]]},{"verse":5,"text":"あなたの日,ひは人,ひとの日,ひのごとく、あなたの年,としは人,ひとの年,ねんのようであるのか。","tok":[["あなた"],["の"],["日","ひ"],["は"],["人","ひと"],["の"],["日","ひ"],["の"],["ごとく"],["、"],["あなた"],["の"],["年","とし"],["は"],["人","ひと"],["の"],["年","ねん"],["の"],["よう"],["で"],["ある"],["の"],["か"],["。"]]},{"verse":6,"text":"あなたはなにゆえわたしのとがを尋,たずね、わたしの罪,つみを調,しらべられるのか。","tok":[["あなた"],["は"],["なにゆえ"],["わたし"],["の"],["とが"],["を"],["尋ね","たずね"],["、"],["わたし"],["の"],["罪","つみ"],["を"],["調べられる","しらべられる"],["の"],["か"],["。"]]},{"verse":7,"text":"あなたはわたしの罪,つみのないことを知,しっておられる。またあなたの手,てから救,すくい出,だしうる者,ものはない。","tok":[["あなた"],["は"],["わたし"],["の"],["罪","つみ"],["の"],["ない"],["こと"],["を"],["知って","しって"],["おられる"],["。"],["また"],["あなた"],["の"],["手","て"],["から"],["救い出し","すくいだし"],["うる"],["者","もの"],["は"],["ない"],["。"]]},{"verse":8,"text":"あなたの手,てはわたしをかたどり、わたしを作,つくった。ところが今,いまあなたはかえって、わたしを滅,ほろぼされる。","tok":[["あなた"],["の"],["手","て"],["は"],["わたし"],["を"],["かたどり"],["、"],["わたし"],["を"],["作った","つくった"],["。"],["ところ"],["が"],["今","いま"],["あなた"],["は"],["かえって"],["、"],["わたし"],["を"],["滅ぼされる","ほろぼされる"],["。"]]},{"verse":9,"text":"どうぞ覚,おぼえてください、あなたは土,つちくれをもってわたしを作,つくられた事,ことを。ところが、わたしをちりに返,かえそうとされるのか。","tok":[["どうぞ"],["覚えて","おぼえて"],["ください"],["、"],["あなた"],["は"],["土くれ","つちくれ"],["を"],["もって"],["わたし"],["を"],["作られた","つくられた"],["事","こと"],["を"],["。"],["ところ"],["が"],["、"],["わたし"],["を"],["ちり"],["に"],["返えそう","かえそう"],["と"],["される"],["の"],["か"],["。"]]},{"verse":10,"text":"あなたはわたしを乳,ちちのように注,そそぎ、乾酪,かんらくのように凝,こり固,かたまらせたではないか。","tok":[["あなた"],["は"],["わたし"],["を"],["乳","ちち"],["の"],["よう"],["に"],["注ぎ","そそぎ"],["、"],["乾酪","かんらく"],["の"],["よう"],["に"],["凝り固まらせたで","こりかたまらせたで"],["は"],["ない"],["か"],["。"]]},{"verse":11,"text":"あなたは肉,にくと皮,かわとをわたしに着,きせ、骨,ほねと筋,すじとをもってわたしを編,あみ、","tok":[["あなた"],["は"],["肉","にく"],["と"],["皮","かわ"],["と"],["を"],["わたし"],["に"],["着せ","きせ"],["、"],["骨","ほね"],["と"],["筋","すじ"],["と"],["を"],["もって"],["わたし"],["を"],["編み","あみ"],["、"]]},{"verse":12,"text":"命,いのちといつくしみとをわたしに授,さづけ、わたしを顧,かえりみてわが霊,れいを守,まもられた。","tok":[["命","いのち"],["と"],["いつくしみ"],["と"],["を"],["わたし"],["に"],["授","さ"],["づけ"],["、"],["わたし"],["を"],["顧て","かえりみて"],["わが"],["霊","れい"],["を"],["守られた","まもられた"],["。"]]},{"verse":13,"text":"しかしあなたはこれらの事,ことをみ心,こころに秘,ひめおかれた。この事,ことがあなたの心,こころのうちにあった事,ことをわたしは知,しっている。","tok":[["しかし"],["あなた"],["は"],["これ"],["ら"],["の"],["事","こと"],["を"],["み心","みこころ"],["に"],["秘めおかれた","ひめおかれた"],["。"],["この"],["事","こと"],["が"],["あなた"],["の"],["心","こころ"],["の"],["うち"],["に"],["あった"],["事","こと"],["を"],["わたし"],["は"],["知って","しって"],["いる"],["。"]]},{"verse":14,"text":"わたしがもし罪,つみを犯,おかせば、あなたはわたしに目,めをつけて、わたしを罪,つみから解,とき放,はなされない。","tok":[["わたし"],["が"],["もし"],["罪","つみ"],["を"],["犯せば","おかせば"],["、"],["あなた"],["は"],["わたし"],["に"],["目","め"],["を"],["つけて"],["、"],["わたし"],["を"],["罪","つみ"],["から"],["解き放されない","ときはなされない"],["。"]]},{"verse":15,"text":"わたしがもし悪,わるければわたしはわざわいだ。たといわたしが正,ただしくても、わたしは頭,あたまを上,あげることができない。わたしは恥,はじに満,みち、悩,なやみを見,みているからだ。","tok":[["わたし"],["が"],["もし"],["悪ければ","わるければ"],["わたし"],["は"],["わざわい"],["だ"],["。"],["たとい"],["わたし"],["が"],["正くて","ただしくて"],["も"],["、"],["わたし"],["は"],["頭","あたま"],["を"],["上げる","あげる"],["こと"],["が"],["できない"],["。"],["わたし"],["は"],["恥","はじ"],["に"],["満ち","みち"],["、"],["悩み","なやみ"],["を"],["見て","みて"],["いる"],["から"],["だ"],["。"]]},{"verse":16,"text":"もし頭,あたまをあげれば、あなたは、ししのようにわたしを追,おい、わたしにむかって再,ふたたびくすしき力,ちからをあらわされる。","tok":[["もし"],["頭","あたま"],["を"],["あげれば"],["、"],["あなた"],["は"],["、"],["しし"],["の"],["よう"],["に"],["わたし"],["を"],["追い","おい"],["、"],["わたし"],["に"],["むかって"],["再び","ふたたび"],["くす"],["しき"],["力","ちから"],["を"],["あらわされる"],["。"]]},{"verse":17,"text":"あなたは証人,しょうにんを入,いれ替,かえてわたしを攻,せめ、わたしにむかってあなたの怒,いかりを増,まし、新,あらたに軍勢,ぐんぜいを出,だしてわたしを攻,せめられる。","tok":[["あなた"],["は"],["証人","しょうにん"],["を"],["入れ","いれ"],["替","かえ"],["て"],["わたし"],["を"],["攻め","せめ"],["、"],["わたし"],["に"],["むかって"],["あなた"],["の"],["怒り","いかり"],["を"],["増し","まし"],["、"],["新らた","あらた"],["に"],["軍勢","ぐんぜい"],["を"],["出して","だして"],["わたし"],["を"],["攻められる","せめられる"],["。"]]},{"verse":18,"text":"なにゆえあなたはわたしを胎,たいから出,だされたか、わたしは息,いき絶,たえて目,めに見,みられることなく、","tok":[["なにゆえ"],["あなた"],["は"],["わたし"],["を"],["胎","たいか"],["ら"],["出された","だされた"],["か"],["、"],["わたし"],["は"],["息","いき"],["絶えて","たえて"],["目","め"],["に"],["見られる","みられる"],["こと"],["なく"],["、"]]},{"verse":19,"text":"胎,たいから墓,はかに運,はこばれて、初,はじめからなかった者,もののようであったなら、よかったのに。","tok":[["胎","たいか"],["ら"],["墓","はか"],["に"],["運こばれて","はこばれて"],["、"],["初め","はじめ"],["から"],["なかった"],["者","もの"],["の"],["よう"],["で"],["あったなら"],["、"],["よかった"],["のに"],["。"]]},{"verse":20,"text":"わたしの命,いのちの日,ひはいくばくもないではないか。どうぞ、しばしわたしを離,はなれて、少,すこしく慰,なぐさめを得,えさせられるように。","tok":[["わたし"],["の"],["命","いのち"],["の"],["日","ひ"],["は"],["いくばく"],["も"],["ないで"],["は"],["ない"],["か"],["。"],["どうぞ"],["、"],["しばし"],["わたし"],["を"],["離れて","はなれて"],["、"],["少しく","すこしく"],["慰さめ","なぐさめ"],["を"],["得させられる","えさせられる"],["よう"],["に"],["。"]]},{"verse":21,"text":"わたしが行,いって、帰,かえることのないその前,まえに、これを得,えさせられるように。わたしは暗,くらき地,ち、暗黒,あんこくの地,ちへ行,いく。","tok":[["わたし"],["が"],["行って","いって"],["、"],["帰える","かえる"],["こと"],["の"],["ない"],["その"],["前","まえ"],["に"],["、"],["これ"],["を"],["得させられる","えさせられる"],["よう"],["に"],["。"],["わたし"],["は"],["暗き","くらき"],["地","ち"],["、"],["暗黒","あんこく"],["の"],["地","ち"],["へ"],["行く","いく"],["。"]]},{"verse":22,"text":"これは暗,くらき地,ちで、やみにひとしく、暗黒,あんこくで秩序,ちつじょなく、光,ひかりもやみのようだ」。","tok":[["これ"],["は"],["暗き","くらき"],["地","ち"],["で"],["、"],["やみ"],["に"],["ひとしく"],["、"],["暗黒","あんこく"],["で"],["秩序","ちつじょ"],["なく"],["、"],["光","ひかり"],["も"],["やみ"],["の"],["よう"],["だ"],["」"],["。"]]}]
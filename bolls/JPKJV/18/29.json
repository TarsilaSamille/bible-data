[{"verse":1,"text":"ヨブはまた言葉,ことばをついで言,いった、","tok":[["ヨブ"],["は"],["また"],["言葉","ことば"],["を"],["ついで"],["言った","いった"],["、"]]},{"verse":2,"text":"「ああ過,すぎた年月,としつきのようであったらよいのだが、神,かみがわたしを守,まもってくださった日,ひのようであったらよいのだが。","tok":[["「"],["ああ"],["過た","すぎた"],["年月","としつき"],["の"],["よう"],["で"],["あったら"],["よい"],["の"],["だ"],["が"],["、"],["神","かみ"],["が"],["わたし"],["を"],["守って","まもって"],["くださった"],["日","ひ"],["の"],["よう"],["で"],["あったら"],["よい"],["の"],["だ"],["が"],["。"]]},{"verse":3,"text":"あの時,ときには、彼,かれのともしびがわたしの頭,あたまの上,うえに輝,かがやき、彼,かれの光,ひかりによってわたしは暗,くらやみを歩,あゆんだ。","tok":[["あの"],["時","とき"],["に"],["は"],["、"],["彼","かれ"],["の"],["ともしび"],["が"],["わたし"],["の"],["頭","あたま"],["の"],["上","うえ"],["に"],["輝やき","かがやき"],["、"],["彼","かれ"],["の"],["光","ひかり"],["によって"],["わたし"],["は"],["暗やみ","くらやみ"],["を"],["歩んだ","あゆんだ"],["。"]]},{"verse":4,"text":"わたしの盛,さかんな時,ときのようであったならよいのだが。あの時,ときには、神,かみの親,したしみがわたしの天幕,てんまくの上,うえにあった。","tok":[["わたし"],["の"],["盛","さかん"],["な"],["時","とき"],["の"],["よう"],["で"],["あったなら"],["よい"],["の"],["だ"],["が"],["。"],["あの"],["時","とき"],["に"],["は"],["、"],["神","かみ"],["の"],["親しみ","したしみ"],["が"],["わたし"],["の"],["天幕","てんまく"],["の"],["上","うえ"],["に"],["あった"],["。"]]},{"verse":5,"text":"あの時,ときには、全能者,ぜんのうしゃがなおわたしと共,ともにいまし、わたしの子供,こどもたちもわたしの周囲,しゅういにいた。","tok":[["あの"],["時","とき"],["に"],["は"],["、"],["全能者","ぜんのうしゃ"],["が"],["なお"],["わたし"],["と"],["共","とも"],["に"],["いまし"],["、"],["わたし"],["の"],["子供","こども"],["たち"],["も"],["わたし"],["の"],["周囲","しゅうい"],["に"],["いた"],["。"]]},{"verse":6,"text":"あの時,とき、わたしの足跡,あしあとは乳,ちちで洗,あらわれ、岩,いわもわたしのために油,あぶらの流,ながれを注,そそぎだした。","tok":[["あの"],["時","とき"],["、"],["わたし"],["の"],["足跡","あしあと"],["は"],["乳","ちち"],["で"],["洗われ","あらわれ"],["、"],["岩","いわ"],["も"],["わたし"],["の"],["ため"],["に"],["油","あぶら"],["の"],["流れ","ながれ"],["を"],["注ぎ","そそぎ"],["だした"],["。"]]},{"verse":7,"text":"あの時,ときには、わたしは町,まちの門,もんに出,でて行,いき、わたしの座,ざを広場,ひろばに設,もうけた。","tok":[["あの"],["時","とき"],["に"],["は"],["、"],["わたし"],["は"],["町","まち"],["の"],["門","もん"],["に"],["出て","でて"],["行き","いき"],["、"],["わたし"],["の"],["座","ざ"],["を"],["広場","ひろば"],["に"],["設けた","もうけた"],["。"]]},{"verse":8,"text":"若,わかい者,ものはわたしを見,みてしりぞき、老,おいた者,ものは身,みをおこして立,たち、","tok":[["若い","わかい"],["者","もの"],["は"],["わたし"],["を"],["見て","みて"],["しりぞき"],["、"],["老","おい"],["た"],["者","もの"],["は"],["身","み"],["を"],["おこして"],["立ち","たち"],["、"]]},{"verse":9,"text":"君,きみたる者,ものも物言,ものいうことをやめて、その口,くちに手,てを当,あて、","tok":[["君","きみ"],["たる"],["者","もの"],["も"],["物","もの"],["言う","いう"],["こと"],["を"],["やめて"],["、"],["その"],["口","くち"],["に"],["手","て"],["を"],["当て","あて"],["、"]]},{"verse":10,"text":"尊,たっとい者,ものも声,こえをおさめて、その舌,したを上,うえあごにつけた。","tok":[["尊","た"],["っと"],["い"],["者","もの"],["も"],["声","こえ"],["を"],["おさめて"],["、"],["その"],["舌","した"],["を"],["上あご","うえあご"],["に"],["つけた"],["。"]]},{"verse":11,"text":"耳,みみに聞,きいた者,ものはわたしを祝福,しゅくふくされた者,ものとなし、目,めに見,みた者,ものはこれをあかしした。","tok":[["耳","みみ"],["に"],["聞いた","きいた"],["者","もの"],["は"],["わたし"],["を"],["祝福","しゅくふく"],["された"],["者","もの"],["と"],["なし"],["、"],["目","め"],["に"],["見た","みた"],["者","もの"],["は"],["これ"],["を"],["あかし"],["した"],["。"]]},{"verse":12,"text":"これは助,たすけを求,もとめる貧,まずしい者,ものを救,すくい、また、みなしごおよび助,たすける人,ひとのない者,ものを救,すくったからである。","tok":[["これ"],["は"],["助け","たすけ"],["を"],["求める","もとめる"],["貧しい","まずしい"],["者","もの"],["を"],["救い","すくい"],["、"],["また"],["、"],["みなしご"],["および"],["助ける","たすける"],["人","ひと"],["の"],["ない"],["者","もの"],["を"],["救った","すくった"],["から"],["で"],["ある"],["。"]]},{"verse":13,"text":"今,いまにも滅,ほろびようとした者,ものの祝福,しゅくふくがわたしに来,きた。わたしはまたやもめの心,こころをして喜,よろこび歌,うたわせた。","tok":[["今","いま"],["に"],["も"],["滅びよう","ほろびよう"],["と"],["した"],["者","もの"],["の"],["祝福","しゅくふく"],["が"],["わたし"],["に"],["来た","きた"],["。"],["わたし"],["は"],["また"],["やもめ"],["の"],["心","こころ"],["を"],["して"],["喜こび","よろこび"],["歌わせた","うたわせた"],["。"]]},{"verse":14,"text":"わたしは正義,せいぎを着,き、正義,せいぎはわたしをおおった。わたしの公義,こうぎは上着,うわぎのごとく、また冠,かんむりのようであった。","tok":[["わたし"],["は"],["正義","せいぎ"],["を"],["着","き"],["、"],["正義","せいぎ"],["は"],["わたし"],["を"],["おおった"],["。"],["わたし"],["の"],["公義","こうぎ"],["は"],["上着","うわぎ"],["の"],["ごとく"],["、"],["また"],["冠","かんむり"],["の"],["よう"],["で"],["あった"],["。"]]},{"verse":15,"text":"わたしは目,めしいの目,めとなり、足,あしなえの足,あしとなり、","tok":[["わたし"],["は"],["目","め"],["しい"],["の"],["目","め"],["と"],["なり"],["、"],["足","あし"],["なえ"],["の"],["足","あし"],["と"],["なり"],["、"]]},{"verse":16,"text":"貧,まずしい者,ものの父,ちちとなり、知,しらない人,ひとの訴,うったえの理由,りゆうを調,しらべてやった。","tok":[["貧しい","まずしい"],["者","もの"],["の"],["父","ちち"],["と"],["なり"],["、"],["知らない","しらない"],["人","ひと"],["の"],["訴","うったえ"],["の"],["理由","りゆう"],["を"],["調べて","しらべて"],["やった"],["。"]]},{"verse":17,"text":"わたしはまた悪,あしき者,もののきばを折,おり、その歯,はの間,あいだから獲物,えものを引,ひき出,だした。","tok":[["わたし"],["は"],["また"],["悪しき","あしき"],["者","もの"],["の"],["きば"],["を"],["折","おり"],["、"],["その"],["歯","は"],["の"],["間","あいだ"],["から"],["獲物","えもの"],["を"],["引出した","ひきだした"],["。"]]},{"verse":18,"text":"その時,とき、わたしは言,いった、『わたしは自分,じぶんの巣,すの中,なかで死,しに、わたしの日,ひは砂,すなのように多,おおくなるであろう。","tok":[["その"],["時","とき"],["、"],["わたし"],["は"],["言った","いった"],["、"],["『"],["わたし"],["は"],["自分","じぶん"],["の"],["巣","す"],["の"],["中","なか"],["で"],["死に","しに"],["、"],["わたし"],["の"],["日","ひ"],["は"],["砂","すな"],["の"],["よう"],["に"],["多く","おおく"],["なるで"],["あろう"],["。"]]},{"verse":19,"text":"わたしの根,ねは水,みずのほとりにはびこり、露,つゆは夜,よもすがらわたしの枝,えだにおくであろう。","tok":[["わたし"],["の"],["根","ね"],["は"],["水","みず"],["の"],["ほとり"],["に"],["はびこり"],["、"],["露","つゆ"],["は"],["夜もすがら","よもすがら"],["わたし"],["の"],["枝","えだ"],["に"],["おく"],["で"],["あろう"],["。"]]},{"verse":20,"text":"わたしの栄,さかえはわたしと共,ともに新,あたらしく、わたしの弓,ゆみはわたしの手,てにいつも強,つよい』と。","tok":[["わたし"],["の"],["栄","さかえ"],["は"],["わたし"],["と"],["共","とも"],["に"],["新らしく","あたらしく"],["、"],["わたし"],["の"],["弓","ゆみ"],["は"],["わたし"],["の"],["手","て"],["に"],["いつも"],["強い","つよい"],["』"],["と"],["。"]]},{"verse":21,"text":"人々,ひとびとはわたしに聞,きいて待,まち、黙,もくして、わたしの教,おしえに従,したがった。","tok":[["人々","ひとびと"],["は"],["わたし"],["に"],["聞いて","きいて"],["待","まち"],["、"],["黙して","もくして"],["、"],["わたし"],["の"],["教え","おしえ"],["に"],["従った","したがった"],["。"]]},{"verse":22,"text":"わたしが言,いった後,のちは彼,かれらは再,ふたたび言,いわなかった。わたしの言葉,ことばは彼,かれらの上,うえに雨,あめのように降,ふりそそいだ。","tok":[["わたし"],["が"],["言った","いった"],["後","のち"],["は"],["彼","かれ"],["ら"],["は"],["再び","ふたたび"],["言わなかった","いわなかった"],["。"],["わたし"],["の"],["言葉","ことば"],["は"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["雨","あめ"],["の"],["よう"],["に"],["降りそそいだ","ふりそそいだ"],["。"]]},{"verse":23,"text":"彼,かれらは雨,あめを待,まつように、わたしを待,まち望,のぞみ、春,はるの雨,あめを仰,あおぐように口,くちを開,ひらいて仰,あおいだ。","tok":[["彼","かれ"],["ら"],["は"],["雨","あめ"],["を"],["待つ","まつ"],["よう"],["に"],["、"],["わたし"],["を"],["待ち望み","まちのぞみ"],["、"],["春","はる"],["の"],["雨","あめ"],["を"],["仰","あおぐ"],["よう"],["に"],["口","くち"],["を"],["開らいて","ひらいて"],["仰いだ","あおいだ"],["。"]]},{"verse":24,"text":"彼,かれらが希望,きぼうを失,うしなった時,ときにも、わたしは彼,かれらにむかってほほえんだ。彼,かれらはわたしの顔,かおの光,ひかりを除,のぞくことができなかった。","tok":[["彼","かれ"],["ら"],["が"],["希望","きぼう"],["を"],["失なった","うしなった"],["時","とき"],["に"],["も"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["に"],["むかって"],["ほほえんだ"],["。"],["彼","かれ"],["ら"],["は"],["わたし"],["の"],["顔","かお"],["の"],["光","ひかり"],["を"],["除く","のぞく"],["こと"],["が"],["できなかった"],["。"]]},{"verse":25,"text":"わたしは彼,かれらのために道,みちを選,えらび、そのかしらとして座,ざし、軍中,ぐんちゅうの王,おうのようにしており、嘆,なげく者,ものを慰,なぐさめる人,ひとのようであった。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["道","みち"],["を"],["選ら","えら"],["び"],["、"],["その"],["かしら"],["として"],["座し","ざし"],["、"],["軍中","ぐんちゅう"],["の"],["王","おう"],["の"],["よう"],["に"],["して"],["おり"],["、"],["嘆く","なげく"],["者","もの"],["を"],["慰さめる","なぐさめる"],["人","ひと"],["の"],["よう"],["で"],["あった"],["。"]]}]
[{"verse":1,"text":"しろがねには掘,ほり出,だす穴,あながあり、精錬,せいれんするこがねには出,でどころがある。","tok":[["しろがね"],["に"],["は"],["掘出す","ほりだす"],["穴","あな"],["が"],["あり"],["、"],["精錬","せいれん"],["する"],["こがね"],["に"],["は"],["出どころ","でどころ"],["が"],["ある"],["。"]]},{"verse":2,"text":"くろがねは土,つちから取,とり、あかがねは石,いしから溶,とかして取,とる。","tok":[["くろがね"],["は"],["土","つち"],["から"],["取","とり"],["、"],["あか"],["が"],["ね"],["は"],["石","いし"],["から"],["溶かして","とかして"],["取る","とる"],["。"]]},{"verse":3,"text":"人,ひとは暗,くらやみを破,やぶり、いやはてまでも尋,たずねきわめて、暗,くらやみおよび暗黒,あんこくの中,なかから鉱石,こうせきを取,とる。","tok":[["人","ひと"],["は"],["暗やみ","くらやみ"],["を"],["破り","やぶり"],["、"],["いや"],["はて"],["まで"],["も"],["尋ね","たずね"],["きわめて"],["、"],["暗やみ","くらやみ"],["および"],["暗黒","あんこく"],["の"],["中","なか"],["から"],["鉱石","こうせき"],["を"],["取る","とる"],["。"]]},{"verse":4,"text":"彼,かれらは人,ひとの住,すむ所,ところを離,はなれて縦穴,たてあなをうがち、道行,みちゆく人,ひとに忘,わすれられ、人,ひとを離,はなれて身,みをつりさげ、揺,ゆれ動,うごく。","tok":[["彼","かれ"],["ら"],["は"],["人","ひと"],["の"],["住む","すむ"],["所","ところ"],["を"],["離れて","はなれて"],["縦穴","たてあな"],["を"],["うがち"],["、"],["道行","み"],["ち"],["ゆく"],["人","ひと"],["に"],["忘られ","わすれられ"],["、"],["人","ひと"],["を"],["離れて","はなれて"],["身","み"],["を"],["つりさげ"],["、"],["揺れ動く","ゆれうごく"],["。"]]},{"verse":5,"text":"地,ちはそこから食物,しょくもつを出,だす。その下,したは火,ひでくつがえされるようにくつがえる。","tok":[["地","ち"],["は"],["そこ"],["から"],["食物","しょくもつ"],["を"],["出す","だす"],["。"],["その"],["下","した"],["は"],["火","ひ"],["で"],["くつがえされる"],["よう"],["に"],["くつがえる"],["。"]]},{"verse":6,"text":"その石,いしはサファイヤのある所,ところ、そこにはまた金塊,きんかいがある。","tok":[["その"],["石","いし"],["は"],["サファイヤ"],["の"],["ある"],["所","ところ"],["、"],["そこ"],["に"],["は"],["また"],["金塊","きんかい"],["が"],["ある"],["。"]]},{"verse":7,"text":"その道,みちは猛禽,もうきんも知,しらず、たかの目,めもこれを見,みず、","tok":[["その"],["道","みち"],["は"],["猛禽","もうきん"],["も"],["知らず","しらず"],["、"],["たか"],["の"],["目","め"],["も"],["これ"],["を"],["見ず","みず"],["、"]]},{"verse":8,"text":"猛獣,もうじゅうもこれを踏,ふまず、ししもこれを通,とおらなかった。","tok":[["猛獣","もうじゅう"],["も"],["これ"],["を"],["踏まず","ふまず"],["、"],["しし"],["も"],["これ"],["を"],["通らなかった","とおらなかった"],["。"]]},{"verse":9,"text":"人,ひとは堅,かたい岩,いわに手,てをくだして、山,やまを根元,ねもとからくつがえす。","tok":[["人","ひと"],["は"],["堅い","かたい"],["岩","いわ"],["に"],["手","て"],["を"],["くだして"],["、"],["山","やま"],["を"],["根元","ねもと"],["から"],["くつがえす"],["。"]]},{"verse":10,"text":"彼,かれは岩,いわに坑道,こうどうを掘,ほり、その目,めはもろもろの尊,たっとい物,ものを見,みる。","tok":[["彼","かれ"],["は"],["岩","いわ"],["に"],["坑道","こうどう"],["を"],["掘","ほり"],["、"],["その"],["目","め"],["は"],["もろもろ"],["の"],["尊","た"],["っと"],["い"],["物","もの"],["を"],["見る","みる"],["。"]]},{"verse":11,"text":"彼,かれは水路,すいろをふさいで、漏,もれないようにし、隠,かくれた物,ものを光,ひかりに取,とり出,だす。","tok":[["彼","かれ"],["は"],["水路","すいろ"],["を"],["ふさいで"],["、"],["漏れない","もれない"],["よう"],["に"],["し"],["、"],["隠れた","かくれた"],["物","もの"],["を"],["光","ひかり"],["に"],["取出す","とりだす"],["。"]]},{"verse":12,"text":"しかし知恵,ちえはどこに見,みいだされるか。悟,さとりのある所,ところはどこか。","tok":[["しかし"],["知恵","ちえ"],["は"],["どこ"],["に"],["見いだされる","みいだされる"],["か"],["。"],["悟り","さとり"],["の"],["ある"],["所","ところ"],["は"],["どこ"],["か"],["。"]]},{"verse":13,"text":"人,ひとはそこに至,いたる道,みちを知,しらない、また生,いける者,ものの地,ちでそれを獲,えることができない。","tok":[["人","ひと"],["は"],["そこ"],["に"],["至る","いたる"],["道","みち"],["を"],["知らない","しらない"],["、"],["また"],["生ける","いける"],["者","もの"],["の"],["地","ち"],["で"],["それ"],["を"],["獲る","える"],["こと"],["が"],["できない"],["。"]]},{"verse":14,"text":"淵,ふちは言,いう、『それはわたしのうちにない』と。また海,うみは言,いう、『わたしのもとにない』と。","tok":[["淵","ふち"],["は"],["言う","いう"],["、"],["『"],["それ"],["は"],["わたし"],["の"],["うち"],["に"],["ない"],["』"],["と"],["。"],["また"],["海","うみ"],["は"],["言う","いう"],["、"],["『"],["わたし"],["の"],["もと"],["に"],["ない"],["』"],["と"],["。"]]},{"verse":15,"text":"精,せい金,きんもこれと換,かえることはできない。銀,ぎんも量,はかってその価,あたいとすることはできない。","tok":[["精金","せいきん"],["も"],["これ"],["と"],["換","かえ"],["る"],["こと"],["は"],["できない"],["。"],["銀","ぎん"],["も"],["量って","はかって"],["その"],["価","あたい"],["と"],["する"],["こと"],["は"],["できない"],["。"]]},{"verse":16,"text":"オフルの金,きんをもってしても、その価,あたいを量,はかることはできない。尊,たっとい縞,しまめのうも、サファイヤも同様,どうようである。","tok":[["オフル"],["の"],["金","きん"],["を"],["もって"],["して"],["も"],["、"],["その"],["価","あたい"],["を"],["量る","はかる"],["こと"],["は"],["できない"],["。"],["尊","た"],["っと"],["い"],["縞","しま"],["めのう"],["も"],["、"],["サファイヤ"],["も"],["同様","どうよう"],["で"],["ある"],["。"]]},{"verse":17,"text":"こがねも、玻璃,はりもこれに並,ならぶことができない。また精,せい金,きんの器物,うつわものもこれと換,かえることができない。","tok":[["こがね"],["も"],["、"],["玻璃","はり"],["も"],["これ"],["に"],["並ぶ","ならぶ"],["こと"],["が"],["できない"],["。"],["また"],["精金","せいきん"],["の"],["器物","うつわも"],["の"],["も"],["これ"],["と"],["換","かえ"],["る"],["こと"],["が"],["できない"],["。"]]},{"verse":18,"text":"さんごも水晶,すいしょうも言,いうに足,たりない。知恵,ちえを得,えるのは真珠,しんじゅを得,えるのにまさる。","tok":[["さんご"],["も"],["水晶","すいしょう"],["も"],["言","いう"],["に"],["足りない","たりない"],["。"],["知恵","ちえ"],["を"],["得る","える"],["の"],["は"],["真珠","しんじゅ"],["を"],["得る","える"],["のに"],["まさる"],["。"]]},{"verse":19,"text":"エチオピヤのトパズもこれに並,ならぶことができない。純金,じゅんきんをもってしても、その価,あたいを量,はかることはできない。","tok":[["エチオピヤ"],["の"],["トパズ"],["も"],["これ"],["に"],["並ぶ","ならぶ"],["こと"],["が"],["できない"],["。"],["純金","じゅんきん"],["を"],["もって"],["して"],["も"],["、"],["その"],["価","あたい"],["を"],["量る","はかる"],["こと"],["は"],["できない"],["。"]]},{"verse":20,"text":"それでは知恵,ちえはどこから来,くるか。悟,さとりのある所,ところはどこか。","tok":[["それ"],["で"],["は"],["知恵","ちえ"],["は"],["どこ"],["から"],["来る","くる"],["か"],["。"],["悟り","さとり"],["の"],["ある"],["所","ところ"],["は"],["どこ"],["か"],["。"]]},{"verse":21,"text":"これはすべての生,いき物,ものの目,めに隠,かくされ、空,そらの鳥,とりにも隠,かくされている。","tok":[["これ"],["は"],["すべて"],["の"],["生き物","いきもの"],["の"],["目","め"],["に"],["隠され","かくされ"],["、"],["空","そら"],["の"],["鳥","とり"],["に"],["も"],["隠されて","かくされて"],["いる"],["。"]]},{"verse":22,"text":"滅,ほろびも死,しも言,いう、『われわれはそのうわさを耳,みみに聞,きいただけだ』。","tok":[["滅び","ほろび"],["も"],["死","し"],["も"],["言う","いう"],["、"],["『"],["われわれ"],["は"],["その"],["うわさ"],["を"],["耳","みみ"],["に"],["聞いた","きいた"],["だけ"],["だ"],["』"],["。"]]},{"verse":23,"text":"神,かみはこれに至,いたる道,みちを悟,さとっておられる、彼,かれはそのある所,ところを知,しっておられる。","tok":[["神","かみ"],["は"],["これ"],["に"],["至る","いたる"],["道","みち"],["を"],["悟って","さとって"],["おられる"],["、"],["彼","かれ"],["は"],["その"],["ある"],["所","ところ"],["を"],["知って","しって"],["おられる"],["。"]]},{"verse":24,"text":"彼,かれは地,ちの果,はてまでもみそなわし、天,あめが下,したを見,みきわめられるからだ。","tok":[["彼","かれ"],["は"],["地","ち"],["の"],["果て","はて"],["まで"],["も"],["みそ"],["な"],["わし"],["、"],["天","あ"],["め"],["が"],["下","した"],["を"],["見きわめられる","みきわめられる"],["から"],["だ"],["。"]]},{"verse":25,"text":"彼,かれが風,かぜに重,おもさを与,あたえ、水,みずをますで量,はかられたとき、","tok":[["彼","かれ"],["が"],["風","かぜ"],["に"],["重さ","おもさ"],["を"],["与","あたえ"],["、"],["水","みず"],["を"],["ます"],["で"],["量られた","はかられた"],["とき"],["、"]]},{"verse":26,"text":"彼,かれが雨,あめのために規定,きていを設,もうけ、雷,かみなりのひらめきのために道,みちを設,もうけられたとき、","tok":[["彼","かれ"],["が"],["雨","あめ"],["の"],["ため"],["に"],["規定","きてい"],["を"],["設け","もうけ"],["、"],["雷","かみなり"],["の"],["ひらめき"],["の"],["ため"],["に"],["道","みち"],["を"],["設けられた","もうけられた"],["とき"],["、"]]},{"verse":27,"text":"彼,かれは知恵,ちえを見,みて、これをあらわし、これを確,たしかめ、これをきわめられた。","tok":[["彼","かれ"],["は"],["知恵","ちえ"],["を"],["見て","みて"],["、"],["これ"],["を"],["あらわし"],["、"],["これ"],["を"],["確かめ","たしかめ"],["、"],["これ"],["を"],["きわめられた"],["。"]]},{"verse":28,"text":"そして人,ひとに言,いわれた、『見,みよ、主,しゅを恐,おそれることは知恵,ちえである、悪,あくを離,はなれることは悟,さとりである』と」。","tok":[["そして"],["人","ひと"],["に"],["言われた","いわれた"],["、"],["『"],["見よ","みよ"],["、"],["主","しゅ"],["を"],["恐れる","おそれる"],["こと"],["は"],["知恵","ちえ"],["で"],["ある"],["、"],["悪","あく"],["を"],["離れる","はなれる"],["こと"],["は"],["悟り","さとり"],["で"],["ある"],["』"],["と"],["」"],["。"]]}]
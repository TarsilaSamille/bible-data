[{"verse":1,"text":"だから、ヨブよ、今,いまわたしの言,いうことを聞,きけ、わたしのすべての言葉,ことばに耳,みみを傾,かたむけよ。","tok":[["だ"],["から"],["、"],["ヨブ"],["よ"],["、"],["今","いま"],["わたし"],["の"],["言う","いう"],["こと"],["を"],["聞け","きけ"],["、"],["わたし"],["の"],["すべて"],["の"],["言葉","ことば"],["に"],["耳","みみ"],["を"],["傾むけよ","かたむけよ"],["。"]]},{"verse":2,"text":"見,みよ、わたしは口,くちを開,ひらき、口,くちの中,なかの舌,したは物言,ものいう。","tok":[["見よ","みよ"],["、"],["わたし"],["は"],["口","くち"],["を"],["開らき","ひらき"],["、"],["口","くち"],["の"],["中","なか"],["の"],["舌","した"],["は"],["物","もの"],["言","げん"],["の"],["いう"],["。"]]},{"verse":3,"text":"わたしの言葉,ことばはわが心,こころの正,ただしきを語,かたり、わたしのくちびるは真実,しんじつをもってその知識,ちしきを語,かたる。","tok":[["わたし"],["の"],["言葉","ことば"],["は"],["わが"],["心","こころ"],["の"],["正き","ただしき"],["を"],["語り","かたり"],["、"],["わたし"],["の"],["くちびる"],["は"],["真実","しんじつ"],["を"],["もって"],["その"],["知識","ちしき"],["を"],["語る","かたる"],["。"]]},{"verse":4,"text":"神,かみの霊,れいはわたしを造,つくり、全能者,ぜんのうしゃの息,いきはわたしを生,いかす。","tok":[["神","かみ"],["の"],["霊","れい"],["は"],["わたし"],["を"],["造","つくり"],["、"],["全能者","ぜんのうしゃ"],["の"],["息","いき"],["は"],["わたし"],["を"],["生かす","いかす"],["。"]]},{"verse":5,"text":"あなたがもしできるなら、わたしに答,こたえよ、わたしの前,まえに言葉,ことばを整,ととのえて、立,たて。","tok":[["あなた"],["が"],["もし"],["できるなら"],["、"],["わたし"],["に"],["答","こたえ"],["よ"],["、"],["わたし"],["の"],["前","まえ"],["に"],["言葉","ことば"],["を"],["整えて","ととのえて"],["、"],["立","たて"],["。"]]},{"verse":6,"text":"見,みよ、神,かみに対,たいしては、わたしもあなたと同様,どうようであり、わたしもまた土,つちから取,とって造,つくられた者,ものだ。","tok":[["見よ","みよ"],["、"],["神","かみ"],["に"],["対し","たいし"],["ては"],["、"],["わたし"],["も"],["あなた"],["と"],["同様","どうよう"],["で"],["あり"],["、"],["わたし"],["も"],["また"],["土","つち"],["から"],["取って","とって"],["造られた","つくられた"],["者","もの"],["だ"],["。"]]},{"verse":7,"text":"見,みよ、わたしの威厳,いげんはあなたを恐,おそれさせない、わたしの勢,いきおいはあなたを圧,あっしない。","tok":[["見よ","みよ"],["、"],["わたし"],["の"],["威厳","いげん"],["は"],["あなた"],["を"],["恐れさせない","おそれさせない"],["、"],["わたし"],["の"],["勢い","いきおい"],["は"],["あなた"],["を"],["圧しない","あっしない"],["。"]]},{"verse":8,"text":"確,たしかに、あなたはわたしの聞,きくところで言,いった、わたしはあなたの言葉,ことばの声,こえを聞,きいた。","tok":[["確か","たしか"],["に"],["、"],["あなた"],["は"],["わたし"],["の"],["聞く","きく"],["ところ"],["で"],["言った","いった"],["、"],["わたし"],["は"],["あなた"],["の"],["言葉","ことば"],["の"],["声","こえ"],["を"],["聞いた","きいた"],["。"]]},{"verse":9,"text":"あなたは言,いう、『わたしはいさぎよく、とがはない。わたしは清,きよく、不義,ふぎはない。","tok":[["あなた"],["は"],["言う","いう"],["、"],["『"],["わたし"],["は"],["いさぎよく"],["、"],["とが"],["は"],["ない"],["。"],["わたし"],["は"],["清く","きよく"],["、"],["不義","ふぎ"],["は"],["ない"],["。"]]},{"verse":10,"text":"見,みよ、彼,かれはわたしを攻,せめる口実,こうじつを見,みつけ、わたしを自分,じぶんの敵,てきとみなし、","tok":[["見よ","みよ"],["、"],["彼","かれ"],["は"],["わたし"],["を"],["攻める","せめる"],["口実","こうじつ"],["を"],["見つけ","みつけ"],["、"],["わたし"],["を"],["自分","じぶん"],["の"],["敵","てき"],["と"],["みなし"],["、"]]},{"verse":11,"text":"わたしの足,あしをかせにはめ、わたしのすべての行,おこないに目,めをとめられる』と。","tok":[["わたし"],["の"],["足","あし"],["を"],["かせ"],["に"],["はめ"],["、"],["わたし"],["の"],["すべて"],["の"],["行ない","おこない"],["に"],["目","め"],["を"],["とめられる"],["』"],["と"],["。"]]},{"verse":12,"text":"見,みよ、わたしはあなたに答,こたえる、あなたはこの事,ことにおいて正,ただしくない。神,かみは人,ひとよりも大,おおいなる者,ものだ。","tok":[["見よ","みよ"],["、"],["わたし"],["は"],["あなた"],["に"],["答","こたえ"],["る"],["、"],["あなた"],["は"],["この"],["事","こと"],["に"],["おいて"],["正く","ただしく"],["ない"],["。"],["神","かみ"],["は"],["人","ひと"],["より"],["も"],["大いなる","おおいなる"],["者","もの"],["だ"],["。"]]},{"verse":13,"text":"あなたが『彼,かれはわたしの言葉,ことばに少,すこしも答,こたえられない』といって、彼,かれに向,むかって言,いい争,あらそうのは、どういうわけであるか。","tok":[["あなた"],["が"],["『"],["彼","かれ"],["は"],["わたし"],["の"],["言葉","ことば"],["に"],["少し","すこし"],["も"],["答","こたえ"],["られない"],["』"],["と"],["いって"],["、"],["彼","かれ"],["に"],["向かって","むかって"],["言い争う","いいあらそう"],["の"],["は"],["、"],["どういう"],["わけ"],["で"],["ある"],["か"],["。"]]},{"verse":14,"text":"神,かみは一つの方法,ほうほうによって語,かたられ、また二つの方法,ほうほうによって語,かたられるのだが、人,ひとはそれを悟,さとらないのだ。","tok":[["神","かみ"],["は"],["一","ひと"],["つ"],["の"],["方法","ほうほう"],["によって"],["語られ","かたられ"],["、"],["また"],["二","ふた"],["つ"],["の"],["方法","ほうほう"],["によって"],["語られる","かたられる"],["の"],["だ"],["が"],["、"],["人","ひと"],["は"],["それ"],["を"],["悟らない","さとらない"],["の"],["だ"],["。"]]},{"verse":15,"text":"人々,ひとびとが熟睡,じゅくすいするとき、または床,とこにまどろむとき、夢,ゆめあるいは夜,よるの幻,まぼろしのうちで、","tok":[["人々","ひとびと"],["が"],["熟睡","じゅくすい"],["する"],["とき"],["、"],["また"],["は"],["床","とこ"],["に"],["まどろむ"],["とき"],["、"],["夢","ゆめ"],["あるいは"],["夜","よる"],["の"],["幻","まぼろし"],["の"],["うち"],["で"],["、"]]},{"verse":16,"text":"彼,かれは人々,ひとびとの耳,みみを開,ひらき、警告,けいこくをもって彼,かれらを恐,おそれさせ、","tok":[["彼","かれ"],["は"],["人々","ひとびと"],["の"],["耳","みみ"],["を"],["開らき","ひらき"],["、"],["警告","けいこく"],["を"],["もって"],["彼","かれ"],["ら"],["を"],["恐れさせ","おそれさせ"],["、"]]},{"verse":17,"text":"こうして人,ひとにその悪,あしきわざを離,はなれさせ、高,たかぶりを人,ひとから除,のぞき、","tok":[["こう"],["して"],["人","ひと"],["に"],["その"],["悪しき","あしき"],["わざ"],["を"],["離れさせ","はなれさせ"],["、"],["高か","たか"],["ぶり"],["を"],["人","ひと"],["から"],["除き","のぞき"],["、"]]},{"verse":18,"text":"その魂,たましいを守,まもって、墓,はかに至,いたらせず、その命,いのちを守,まもって、つるぎに滅,ほろびないようにされる。","tok":[["その"],["魂","たましい"],["を"],["守って","まもって"],["、"],["墓","はか"],["に"],["至らせず","いたらせず"],["、"],["その"],["命","いのち"],["を"],["守って","まもって"],["、"],["つるぎ"],["に"],["滅びない","ほろびない"],["よう"],["に"],["される"],["。"]]},{"verse":19,"text":"人,ひとはまたその床,とこの上,うえで痛,いたみによって懲,こらされ、その骨,ほねに戦,たたかいが絶,たえることなく、","tok":[["人","ひと"],["は"],["また"],["その"],["床","とこ"],["の"],["上","うえ"],["で"],["痛み","いたみ"],["によって"],["懲らされ","こらされ"],["、"],["その"],["骨","ほね"],["に"],["戦い","たたかい"],["が"],["絶える","たえる"],["こと"],["なく"],["、"]]},{"verse":20,"text":"その命,いのちは、食物,しょくもつをいとい、その食欲,しょくよくは、おいしい食物,しょくもつをきらう。","tok":[["その"],["命","いのち"],["は"],["、"],["食物","しょくもつ"],["を"],["いとい"],["、"],["その"],["食欲","しょくよく"],["は"],["、"],["おいしい"],["食物","しょくもつ"],["を"],["きらう"],["。"]]},{"verse":21,"text":"その肉,にくはやせ落,おちて見,みえず、その骨,ほねは見,みえなかったものまでもあらわになり、","tok":[["その"],["肉","にく"],["は"],["やせ"],["落","おち"],["て"],["見えず","みえず"],["、"],["その"],["骨","ほね"],["は"],["見えなかった","みえなかった"],["もの"],["まで"],["も"],["あらわ"],["に"],["なり"],["、"]]},{"verse":22,"text":"その魂,たましいは墓,はかに近,ちかづき、その命,いのちは滅,ほろぼす者,ものに近,ちかづく。","tok":[["その"],["魂","たましい"],["は"],["墓","はか"],["に"],["近づき","ちかづき"],["、"],["その"],["命","いのち"],["は"],["滅ぼす","ほろぼす"],["者","もの"],["に"],["近づく","ちかづく"],["。"]]},{"verse":23,"text":"もしそこに彼,かれのためにひとりの天使,てんしがあり、千のうちのひとりであって、仲保,ちゅうほとなり、人,ひとにその正,ただしい道,みちを示,しめすならば、","tok":[["もし"],["そこ"],["に"],["彼","かれ"],["の"],["ため"],["に"],["ひとり"],["の"],["天使","てんし"],["が"],["あり"],["、"],["千","せん"],["の"],["うち"],["の"],["ひとり"],["で"],["あって"],["、"],["仲保","ちゅ"],["う"],["ほ"],["と"],["なり"],["、"],["人","ひと"],["に"],["その"],["正い","ただしい"],["道","みち"],["を"],["示めすならば","しめすならば"],["、"]]},{"verse":24,"text":"神,かみは彼,かれをあわれんで言,いわれる、『彼,かれを救,すくって、墓,はかに下,くだることを免,まぬかれさせよ、わたしはすでにあがないしろを得,えた。","tok":[["神","かみ"],["は"],["彼","かれ"],["を"],["あわれんで"],["言われる","いわれる"],["、"],["『"],["彼","かれ"],["を"],["救って","すくって"],["、"],["墓","はか"],["に"],["下る","くだる"],["こと"],["を"],["免かれさせよ","まぬかれさせよ"],["、"],["わたし"],["は"],["すでに"],["あがない"],["しろ"],["を"],["得た","えた"],["。"]]},{"verse":25,"text":"彼,かれの肉,にくを幼,おさな子,この肉,にくよりもみずみずしくならせ、彼,かれを若,わかい時,ときの元気,げんきに帰,かえらせよ』と。","tok":[["彼","かれ"],["の"],["肉","にく"],["を"],["幼な子","おさなこ"],["の"],["肉","にく"],["より"],["も"],["みずみずしく"],["ならせ"],["、"],["彼","かれ"],["を"],["若い","わかい"],["時","とき"],["の"],["元気","げんき"],["に"],["帰えらせ","かえらせ"],["よ"],["』"],["と"],["。"]]},{"verse":26,"text":"その時,とき、彼,かれが神,かみに祈,いのるならば、神,かみは彼,かれを顧,かえりみ、喜,よろこびをもって、み前,まえにいたらせ、その救,すくいを人,ひとに告,つげ知,しらせられる。","tok":[["その"],["時","とき"],["、"],["彼","かれ"],["が"],["神","かみ"],["に"],["祈るならば","いのるならば"],["、"],["神","かみ"],["は"],["彼","かれ"],["を"],["顧りみ","かえりみ"],["、"],["喜こび","よろこび"],["を"],["もって"],["、"],["み前","みまえ"],["に"],["いたらせ"],["、"],["その"],["救い","すくい"],["を"],["人","ひと"],["に"],["告","つげ"],["知らせられる","しらせられる"],["。"]]},{"verse":27,"text":"彼,かれは人々,ひとびとの前,まえに歌,うたって言,いう、『わたしは罪,つみを犯,おかし、正,ただしい事,ことを曲,まげた。しかしわたしに報復,ほうふくがなかった。","tok":[["彼","かれ"],["は"],["人々","ひとびと"],["の"],["前","まえ"],["に"],["歌って","うたって"],["言う","いう"],["、"],["『"],["わたし"],["は"],["罪","つみ"],["を"],["犯し","おかし"],["、"],["正い","ただしい"],["事","こと"],["を"],["曲げた","まげた"],["。"],["しかし"],["わたし"],["に"],["報復","ほうふく"],["が"],["なかった"],["。"]]},{"verse":28,"text":"彼,かれはわたしの魂,たましいをあがなって、墓,はかに下,くだらせられなかった。わたしの命,いのちは光,ひかりを見,みることができる』と。","tok":[["彼","かれ"],["は"],["わたし"],["の"],["魂","たましい"],["を"],["あがなって"],["、"],["墓","はか"],["に"],["下らせられなかった","くだらせられなかった"],["。"],["わたし"],["の"],["命","いのち"],["は"],["光","ひかり"],["を"],["見る","みる"],["こと"],["が"],["できる"],["』"],["と"],["。"]]},{"verse":29,"text":"見,みよ、神,かみはこれらすべての事,ことをふたたび、みたび人,ひとに行,おこない、","tok":[["見よ","みよ"],["、"],["神","かみ"],["は"],["これ"],["ら"],["すべて"],["の"],["事","こと"],["を"],["ふたたび"],["、"],["みたび人","みたびひと"],["に"],["行ない","おこない"],["、"]]},{"verse":30,"text":"その魂,たましいを墓,はかから引,ひき返,かえし、彼,かれに命,いのちの光,ひかりを見,みさせられる。","tok":[["その"],["魂","たましい"],["を"],["墓","はか"],["から"],["引","ひき"],["返","かえし"],["、"],["彼","かれ"],["に"],["命","いのち"],["の"],["光","ひかり"],["を"],["見させられる","みさせられる"],["。"]]},{"verse":31,"text":"ヨブよ、耳,みみを傾,かたむけてわたしに聞,きけ、黙,もくせよ、わたしは語,かたろう。","tok":[["ヨブ"],["よ"],["、"],["耳","みみ"],["を"],["傾むけて","かたむけて"],["わたし"],["に"],["聞け","きけ"],["、"],["黙せよ","もくせよ"],["、"],["わたし"],["は"],["語ろう","かたろう"],["。"]]},{"verse":32,"text":"あなたがもし言,いうべきことがあるなら、わたしに答,こたえよ、語,かたれ、わたしはあなたを正,ただしい者,ものにしようと望,のぞむからだ。","tok":[["あなた"],["が"],["もし"],["言","いうべきこ"],["と"],["が"],["あるなら"],["、"],["わたし"],["に"],["答","こたえ"],["よ"],["、"],["語れ","かたれ"],["、"],["わたし"],["は"],["あなた"],["を"],["正い","ただしい"],["者","もの"],["に"],["しよう"],["と"],["望む","のぞむ"],["から"],["だ"],["。"]]},{"verse":33,"text":"もし語,かたることがないなら、わたしに聞,きけ、黙,もくせよ、わたしはあなたに知恵,ちえを教,おしえよう」。","tok":[["もし"],["語る","かたる"],["こと"],["が"],["ないなら"],["、"],["わたし"],["に"],["聞け","きけ"],["、"],["黙せよ","もくせよ"],["、"],["わたし"],["は"],["あなた"],["に"],["知恵","ちえ"],["を"],["教えよう","おしえよう"],["」"],["。"]]}]
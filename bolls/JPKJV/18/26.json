[{"verse":1,"text":"そこでヨブは答,こたえて言,いった、","tok":[["そこ"],["で"],["ヨブ"],["は"],["答","こたえ"],["て"],["言った","いった"],["、"]]},{"verse":2,"text":"「あなたは力,ちからのない者,ものをどれほど助,たすけたかしれない。気力,きりょくのない腕,うでをどれほど救,すくったかしれない。","tok":[["「"],["あなた"],["は"],["力","ちから"],["の"],["ない"],["者","もの"],["を"],["どれ"],["ほど"],["助けた","たすけた"],["か"],["しれない"],["。"],["気力","きりょく"],["の"],["ない"],["腕","うで"],["を"],["どれ"],["ほど"],["救った","すくった"],["か"],["しれない"],["。"]]},{"verse":3,"text":"知恵,ちえのない者,ものをどれほど教,おしえたかしれない。悟,さとりをどれほど多,おおく示,しめしたかしれない。","tok":[["知恵","ちえ"],["の"],["ない"],["者","もの"],["を"],["どれ"],["ほど"],["教えた","おしえた"],["か"],["しれない"],["。"],["悟り","さとり"],["を"],["どれ"],["ほど"],["多く","おおく"],["示めした","しめした"],["か"],["しれない"],["。"]]},{"verse":4,"text":"あなたはだれの助,たすけによって言葉,ことばをだしたのか。あなたから出,でたのはだれの霊,れいなのか。","tok":[["あなた"],["は"],["だれ"],["の"],["助け","たすけ"],["によって"],["言葉","ことば"],["を"],["だした"],["の"],["か"],["。"],["あなた"],["から"],["出た","でた"],["の"],["は"],["だれ"],["の"],["霊","れい"],["な"],["の"],["か"],["。"]]},{"verse":5,"text":"亡霊,ぼうれいは水,みずおよびその中,なかに住,すむものの下,したに震,ふるう。","tok":[["亡霊","ぼうれい"],["は"],["水","みず"],["および"],["その"],["中","なか"],["に"],["住む","すむ"],["もの"],["の"],["下","した"],["に"],["震う","ふるう"],["。"]]},{"verse":6,"text":"神,かみの前,まえでは陰府,よみも裸,はだかである。滅,ほろびの穴,あなもおおい隠,かくすものはない。","tok":[["神","かみ"],["の"],["前","まえ"],["で"],["は"],["陰府","よみ"],["も"],["裸","はだか"],["で"],["ある"],["。"],["滅び","ほろび"],["の"],["穴","あな"],["も"],["おおい隠す","おおいかくす"],["もの"],["は"],["ない"],["。"]]},{"verse":7,"text":"彼,かれは北,きたの天,てんを空間,くうかんに張,はり、地,ちを何,なにもない所,ところに掛,かけられる。","tok":[["彼","かれ"],["は"],["北","きた"],["の"],["天","てん"],["を"],["空間","くうかん"],["に"],["張り","はり"],["、"],["地","ち"],["を"],["何に","なに"],["も"],["ない"],["所","ところ"],["に"],["掛けられる","かけられる"],["。"]]},{"verse":8,"text":"彼,かれは水,みずを濃,こい雲,くもの中,なかに包,つつまれるが、その下,したの雲,くもは裂,さけない。","tok":[["彼","かれ"],["は"],["水","みず"],["を"],["濃い","こい"],["雲","くも"],["の"],["中","なか"],["に"],["包まれる","つつまれる"],["が"],["、"],["その"],["下","した"],["の"],["雲","くも"],["は"],["裂けない","さけない"],["。"]]},{"verse":9,"text":"彼,かれは月,つきのおもてをおおい隠,かくして、雲,くもをその上,うえにのべ、","tok":[["彼","かれ"],["は"],["月","つき"],["の"],["おもて"],["を"],["おおい隠して","おおいかくして"],["、"],["雲","くも"],["を"],["その"],["上","うえ"],["に"],["のべ"],["、"]]},{"verse":10,"text":"水,みずのおもてに円,えんを描,えがいて、光,ひかりとやみとの境,さかいとされた。","tok":[["水","みず"],["の"],["おもて"],["に"],["円","えん"],["を"],["描いて","えがいて"],["、"],["光","ひかり"],["と"],["やみ"],["と"],["の"],["境","さかい"],["と"],["された"],["。"]]},{"verse":11,"text":"彼,かれが戒,いましめると、天,てんの柱,はしらは震,ふるい、かつ驚,おどろく。","tok":[["彼","かれ"],["が"],["戒める","いましめる"],["と"],["、"],["天","てん"],["の"],["柱","はしら"],["は"],["震い","ふるい"],["、"],["かつ"],["驚ろく","おどろく"],["。"]]},{"verse":12,"text":"彼,かれはその力,ちからをもって海,うみを静,しずめ、その知恵,ちえをもってラハブを打,うち砕,くだき、","tok":[["彼","かれ"],["は"],["その"],["力","ちから"],["を"],["もって"],["海","うみ"],["を"],["静め","しずめ"],["、"],["その"],["知恵","ちえ"],["を"],["もって"],["ラハブ"],["を"],["打ち砕き","うちくだき"],["、"]]},{"verse":13,"text":"その息,いきをもって天,てんを晴,はれわたらせ、その手,てをもって逃,にげるへびを突,つき通,とおされる。","tok":[["その"],["息","いき"],["を"],["もって"],["天","てん"],["を"],["晴","はれ"],["わたらせ"],["、"],["その"],["手","て"],["を"],["もって"],["逃る","にげる"],["へび"],["を"],["突き通される","つきとおされる"],["。"]]},{"verse":14,"text":"見,みよ、これらはただ彼,かれの道,みちの端,はしにすぎない。われわれが彼,かれについて聞,きく所,ところはいかにかすかなささやきであろう。しかし、その力,ちからのとどろきに至,いたっては、だれが悟,さとることができるか」。","tok":[["見よ","みよ"],["、"],["これ"],["ら"],["は"],["ただ"],["彼","かれ"],["の"],["道","みち"],["の"],["端","はし"],["に"],["すぎない"],["。"],["われわれ"],["が"],["彼","かれ"],["について"],["聞く","きく"],["所","ところ"],["は"],["いかに"],["かすか"],["な"],["ささやき"],["で"],["あろう"],["。"],["しかし"],["、"],["その"],["力","ちから"],["の"],["とどろき"],["に"],["至って","いたって"],["は"],["、"],["だれ"],["が"],["悟","さとる"],["こと"],["が"],["できる"],["か"],["」"],["。"]]}]
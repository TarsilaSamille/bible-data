[{"verse":1,"text":"そこでナアマびとゾパルは答,こたえて言,いった、","tok":[["そこ"],["で"],["ナアマ"],["びと"],["ゾパル"],["は"],["答","こたえ"],["て"],["言った","いった"],["、"]]},{"verse":2,"text":"「言葉,ことばが多,おおければ、答,こたえなしにすまされるだろうか。口,くちの達者,たっしゃな人,ひとは義,ぎとされるだろうか。","tok":[["「"],["言葉","ことば"],["が"],["多ければ","おおければ"],["、"],["答","こたえ"],["なし"],["に"],["すまされるだろう"],["か"],["。"],["口","くち"],["の"],["達者","たっしゃ"],["な"],["人","ひと"],["は"],["義","ぎ"],["と"],["されるだろう"],["か"],["。"]]},{"verse":3,"text":"あなたのむなしい言葉,ことばは人,ひとを沈黙,ちんもくさせるだろうか。あなたがあざけるとき、人,ひとはあなたを恥,はじさせないだろうか。","tok":[["あなた"],["の"],["むなしい"],["言葉","ことば"],["は"],["人","ひと"],["を"],["沈黙","ちんもく"],["させるだろう"],["か"],["。"],["あなた"],["が"],["あざける"],["とき"],["、"],["人","ひと"],["は"],["あなた"],["を"],["恥","はじ"],["させないだろう"],["か"],["。"]]},{"verse":4,"text":"あなたは言,いう、『わたしの教,おしえは正,ただしい、わたしは神,かみの目,めに潔,いさぎよい』と。","tok":[["あなた"],["は"],["言う","いう"],["、"],["『"],["わたし"],["の"],["教え","おしえ"],["は"],["正い","ただしい"],["、"],["わたし"],["は"],["神","かみ"],["の"],["目","め"],["に"],["潔ぎよい","いさぎよい"],["』"],["と"],["。"]]},{"verse":5,"text":"どうぞ神,かみが言葉,ことばを出,だし、あなたにむかってくちびるを開,ひらき、","tok":[["どうぞ"],["神","かみ"],["が"],["言葉","ことば"],["を"],["出し","だし"],["、"],["あなた"],["に"],["むかって"],["くちびる"],["を"],["開らき","ひらき"],["、"]]},{"verse":6,"text":"知恵,ちえの秘密,ひみつをあなたに示,しめされるように。神,かみはさまざまの知識,ちしきをもたれるからである。それであなたは知,しるがよい、神,かみはあなたの罪,つみよりも軽,かるくあなたを罰,ばっせられることを。","tok":[["知恵","ちえ"],["の"],["秘密","ひみつ"],["を"],["あなた"],["に"],["示めされる","しめされる"],["よう"],["に"],["。"],["神","かみ"],["は"],["さまざま"],["の"],["知識","ちしき"],["を"],["もたれる"],["から"],["で"],["ある"],["。"],["それ"],["で"],["あなた"],["は"],["知る","しる"],["がよい"],["、"],["神","かみ"],["は"],["あなた"],["の"],["罪","つみ"],["より"],["も"],["軽く","かるく"],["あなた"],["を"],["罰せられる","ばっせられる"],["こと"],["を"],["。"]]},{"verse":7,"text":"あなたは神,かみの深,ふかい事,ことを窮,きわめることができるか。全能者,ぜんのうしゃの限界,げんかいを窮,きわめることができるか。","tok":[["あなた"],["は"],["神","かみ"],["の"],["深い","ふかい"],["事","こと"],["を"],["窮める","きわめる"],["こと"],["が"],["できる"],["か"],["。"],["全能者","ぜんのうしゃ"],["の"],["限界","げんかい"],["を"],["窮める","きわめる"],["こと"],["が"],["できる"],["か"],["。"]]},{"verse":8,"text":"それは天,てんよりも高,たかい、あなたは何,なにをなしうるか。それは陰府,よみよりも深,ふかい、あなたは何,なにを知,しりうるか。","tok":[["それ"],["は"],["天","てん"],["より"],["も"],["高かい","たかい"],["、"],["あなた"],["は"],["何に","なに"],["を"],["なし"],["うる"],["か"],["。"],["それ"],["は"],["陰府","よみ"],["より"],["も"],["深","ふ"],["か"],["い"],["、"],["あなた"],["は"],["何に","なに"],["を"],["知り","しり"],["うる"],["か"],["。"]]},{"verse":9,"text":"その量,りょうは地,ちよりも長,ながく、海,うみよりも広,ひろい。","tok":[["その"],["量","りょう"],["は"],["地","ち"],["より"],["も"],["長く","ながく"],["、"],["海","うみ"],["より"],["も"],["広い","ひろい"],["。"]]},{"verse":10,"text":"彼,かれがもし行,ゆきめぐって人,ひとを捕,とらえ、さばきに召,めし集,あつめられるとき、だれが彼,かれをはばむことができよう。","tok":[["彼","かれ"],["が"],["もし"],["行き","ゆき"],["めぐって"],["人","ひと"],["を"],["捕らえ","とらえ"],["、"],["さばき"],["に"],["召","めし"],["集められる","あつめられる"],["とき"],["、"],["だれ"],["が"],["彼","かれ"],["を"],["はばむ"],["こと"],["が"],["できよう"],["。"]]},{"verse":11,"text":"彼,かれは卑,いやしい人間,にんげんを知,しっておられるからだ。彼,かれは不義,ふぎを見,みる時,とき、これに心,こころをとめられぬであろうか。","tok":[["彼","かれ"],["は"],["卑しい","いやしい"],["人間","にんげん"],["を"],["知って","しって"],["おられる"],["から"],["だ"],["。"],["彼","かれ"],["は"],["不義","ふぎ"],["を"],["見る","みる"],["時","とき"],["、"],["これ"],["に"],["心","こころ"],["を"],["とめられぬで"],["あろう"],["か"],["。"]]},{"verse":12,"text":"しかし野,のろばの子,こが人,ひととして生,うまれるとき、愚,おろかな者,ものも悟,さとりを得,えるであろう。","tok":[["しかし"],["野","の"],["ろば"],["の"],["子","こ"],["が"],["人","ひと"],["として"],["生まれる","うまれる"],["とき"],["、"],["愚か","おろか"],["な"],["者","もの"],["も"],["悟り","さとり"],["を"],["得るで","えるで"],["あろう"],["。"]]},{"verse":13,"text":"もしあなたが心,こころを正,ただしくするならば、神,かみに向,むかって手,てを伸,のべるであろう。","tok":[["もし"],["あなた"],["が"],["心","こころ"],["を"],["正く","ただしく"],["するならば"],["、"],["神","かみ"],["に"],["向かって","むかって"],["手","て"],["を"],["伸べるで","のべるで"],["あろう"],["。"]]},{"verse":14,"text":"もしあなたの手,てに不義,ふぎがあるなら、それを遠,とおく去,され、あなたの天幕,てんまくに悪,あくを住,すまわせてはならない。","tok":[["もし"],["あなた"],["の"],["手","て"],["に"],["不義","ふぎ"],["が"],["あるなら"],["、"],["それ"],["を"],["遠く","とおく"],["去れ","され"],["、"],["あなた"],["の"],["天幕","てんまく"],["に"],["悪","あく"],["を"],["住まわせて","すまわせて"],["は"],["ならない"],["。"]]},{"verse":15,"text":"そうすれば、あなたは恥,はじることなく顔,かおをあげることができ、堅,かたく立,たって、恐,おそれることはない。","tok":[["そう"],["すれば"],["、"],["あなた"],["は"],["恥","はじ"],["る"],["こと"],["なく"],["顔","かお"],["を"],["あげる"],["こと"],["が"],["でき"],["、"],["堅く","かたく"],["立って","たって"],["、"],["恐れる","おそれる"],["こと"],["は"],["ない"],["。"]]},{"verse":16,"text":"あなたは苦,くるしみを忘,わすれ、あなたのこれを覚,おぼえることは、流,ながれ去,さった水,みずのようになる。","tok":[["あなた"],["は"],["苦しみ","くるしみ"],["を"],["忘","わすれ"],["、"],["あなた"],["の"],["これ"],["を"],["覚える","おぼえる"],["こと"],["は"],["、"],["流れ","ながれ"],["去た","さった"],["水","みず"],["の"],["よう"],["に"],["なる"],["。"]]},{"verse":17,"text":"そしてあなたの命,いのちは真昼,まひるよりも光,ひかり輝,かがやき、たとい暗,くらくても朝,あさのようになる。","tok":[["そして"],["あなた"],["の"],["命","いのち"],["は"],["真昼","まひる"],["より"],["も"],["光輝き","ひかりかがやき"],["、"],["たとい"],["暗くて","くらくて"],["も"],["朝","あさ"],["の"],["よう"],["に"],["なる"],["。"]]},{"verse":18,"text":"あなたは望,のぞみがあるゆえに安,やすんじ、保護,ほごされて安,やすらかにいこうことができる。","tok":[["あなた"],["は"],["望み","のぞみ"],["が"],["ある"],["ゆえ"],["に"],["安んじ","やすんじ"],["、"],["保護","ほご"],["されて"],["安らか","やすらか"],["に"],["いこう"],["こと"],["が"],["できる"],["。"]]},{"verse":19,"text":"あなたは伏,ふしてやすみ、あなたを恐,おそれさせるものはない。多,おおくの者,ものはあなたの好意,こういを求,もとめるであろう。","tok":[["あなた"],["は"],["伏して","ふして"],["やすみ"],["、"],["あなた"],["を"],["恐れさせる","おそれさせる"],["もの"],["は"],["ない"],["。"],["多く","おおく"],["の"],["者","もの"],["は"],["あなた"],["の"],["好意","こうい"],["を"],["求めるで","もとめるで"],["あろう"],["。"]]},{"verse":20,"text":"しかし悪,あしき者,ものの目,めは衰,おとろえる。彼,かれらは逃,にげ場,ばを失,うしない、その望,のぞみは息,いきの絶,たえるにひとしい」。","tok":[["しかし"],["悪しき","あしき"],["者","もの"],["の"],["目","め"],["は"],["衰える","おとろえる"],["。"],["彼","かれ"],["ら"],["は"],["逃","にげ"],["場","ば"],["を"],["失ない","うしない"],["、"],["その"],["望み","のぞみ"],["は"],["息","いき"],["の"],["絶える","たえる"],["に"],["ひとしい"],["」"],["。"]]}]
[{"verse":1,"text":"そこでナアマびとゾパルは答,こたえて言,いった、","tok":[["そこ"],["で"],["ナアマ"],["びと"],["ゾパル"],["は"],["答","こたえ"],["て"],["言った","いった"],["、"]]},{"verse":2,"text":"「これによって、わたしは答,こたえようとの思,おもいを起,おこし、これがために心中,しんじゅうしきりに騒,さわぎ立,たつ。","tok":[["「"],["これ"],["によって"],["、"],["わたし"],["は"],["答","こたえ"],["よう"],["と"],["の"],["思い","おもい"],["を"],["起こし","おこし"],["、"],["これ"],["が"],["ため"],["に"],["心中","しんじゅう"],["しきり"],["に"],["騒立つ","さわぎたつ"],["。"]]},{"verse":3,"text":"わたしはわたしをはずかしめる非難,ひなんを聞,きく、しかし、わたしの悟,さとりの霊,れいがわたしに答,こたえさせる。","tok":[["わたし"],["は"],["わたし"],["を"],["はずかしめる"],["非難","ひなん"],["を"],["聞く","きく"],["、"],["しかし"],["、"],["わたし"],["の"],["悟り","さとり"],["の"],["霊","れい"],["が"],["わたし"],["に"],["答","こたえ"],["させる"],["。"]]},{"verse":4,"text":"あなたはこの事,ことを知,しらないのか、昔,むかしから地,ちの上,うえに人,ひとの置,おかれてよりこのかた、","tok":[["あなた"],["は"],["この"],["事","こと"],["を"],["知らない","しらない"],["の"],["か"],["、"],["昔","むかし"],["から"],["地","ち"],["の"],["上","うえ"],["に"],["人","ひと"],["の"],["置かれて","おかれて"],["より"],["このかた"],["、"]]},{"verse":5,"text":"悪,あしき人,ひとの勝,かち誇,ほこはしばらくであって、神,かみを信,しんじない者,ものの楽,たのしみはただつかのまであることを。","tok":[["悪しき","あしき"],["人","ひと"],["の"],["勝","かち"],["誇","ほこ"],["は"],["しばらく"],["で"],["あって"],["、"],["神","かみ"],["を"],["信じない","しんじない"],["者","もの"],["の"],["楽み","たのしみ"],["は"],["ただ"],["つかのま"],["で"],["ある"],["こと"],["を"],["。"]]},{"verse":6,"text":"たといその高,たかさが天,てんに達,たっし、その頭,あたまが雲,くもにおよんでも、","tok":[["たとい"],["その"],["高さ","たかさ"],["が"],["天","てん"],["に"],["達し","たっし"],["、"],["その"],["頭","あたま"],["が"],["雲","くも"],["に"],["およんで"],["も"],["、"]]},{"verse":7,"text":"彼,かれはおのれの糞,ふんのように、とこしえに滅,ほろび、彼,かれを見,みた者,ものは言,いうであろう、『彼,かれはどこにおるか』と。","tok":[["彼","かれ"],["は"],["おのれ"],["の"],["糞","ふん"],["の"],["よう"],["に"],["、"],["とこしえ"],["に"],["滅び","ほろび"],["、"],["彼","かれ"],["を"],["見た","みた"],["者","もの"],["は"],["言うで","いうで"],["あろう"],["、"],["『"],["彼","かれ"],["は"],["どこ"],["に"],["おる"],["か"],["』"],["と"],["。"]]},{"verse":8,"text":"彼,かれは夢,ゆめのように飛,とび去,さって、再,ふたたび見,みることはない。彼,かれは夜,よるの幻,まぼろしのように追,おい払,はらわれるであろう。","tok":[["彼","かれ"],["は"],["夢","ゆめ"],["の"],["よう"],["に"],["飛び","とび"],["去て","さって"],["、"],["再び","ふたたび"],["見る","みる"],["こと"],["は"],["ない"],["。"],["彼","かれ"],["は"],["夜","よる"],["の"],["幻","まぼろし"],["の"],["よう"],["に"],["追い払われるで","おいはらわれるで"],["あろう"],["。"]]},{"verse":9,"text":"彼,かれを見,みた目,めはかさねて彼,かれを見,みることがなく、彼,かれのいた所,ところも再,ふたたび彼,かれを見,みることがなかろう。","tok":[["彼","かれ"],["を"],["見た","みた"],["目","め"],["は"],["かさねて"],["彼","かれ"],["を"],["見る","みる"],["こと"],["が"],["なく"],["、"],["彼","かれ"],["の"],["いた"],["所","ところ"],["も"],["再び","ふたたび"],["彼","かれ"],["を"],["見る","みる"],["こと"],["が"],["なかろう"],["。"]]},{"verse":10,"text":"その子,こらは貧,まずしい者,ものに恵,めぐみを求,もとめ、その手,ては彼,かれの貨,か財,ざいを償,つぐなうであろう。","tok":[["その"],["子","こ"],["ら"],["は"],["貧しい","まずしい"],["者","もの"],["に"],["恵","めぐみ"],["を"],["求め","もとめ"],["、"],["その"],["手","て"],["は"],["彼","かれ"],["の"],["貨財","かざい"],["を"],["償なうで","つぐなうで"],["あろう"],["。"]]},{"verse":11,"text":"その骨,ほねには若,わかい力,ちからが満,みちている、しかしそれは彼,かれと共,ともにちりに伏,ふすであろう。","tok":[["その"],["骨","ほね"],["に"],["は"],["若い","わかい"],["力","ちから"],["が"],["満ちて","みちて"],["いる"],["、"],["しかし"],["それ"],["は"],["彼","かれ"],["と"],["共","とも"],["に"],["ちり"],["に"],["伏すで","ふすで"],["あろう"],["。"]]},{"verse":12,"text":"たとい悪,あくは彼,かれの口,くちに甘,あまく、これを舌,したの裏,うらにかくし、","tok":[["たとい"],["悪","あく"],["は"],["彼","かれ"],["の"],["口","くち"],["に"],["甘く","あまく"],["、"],["これ"],["を"],["舌","した"],["の"],["裏","うら"],["に"],["かくし"],["、"]]},{"verse":13,"text":"これを惜,おしんで捨,すてることなく、口,くちの中,なかに含,ふくんでいても、","tok":[["これ"],["を"],["惜しんで","おしんで"],["捨てる","すてる"],["こと"],["なく"],["、"],["口","くち"],["の"],["中","なか"],["に"],["含んで","ふくんで"],["いて"],["も"],["、"]]},{"verse":14,"text":"その食物,しょくもつは彼,かれの腹,はらの中,うちで変,かわり、彼,かれの内,うちで毒蛇,どくへびの毒,どくとなる。","tok":[["その"],["食物","しょくもつ"],["は"],["彼","かれ"],["の"],["腹","はら"],["の"],["中","う"],["ち"],["で"],["変わり","かわり"],["、"],["彼","かれ"],["の"],["内","うち"],["で"],["毒蛇","どくへび"],["の"],["毒","どく"],["と"],["なる"],["。"]]},{"verse":15,"text":"彼,かれは貨,か財,ざいをのんでも、またそれを吐,はき出,だす、神,かみがそれを彼,かれの腹,はらから押,おし出,だされるからだ。","tok":[["彼","かれ"],["は"],["貨財","かざい"],["を"],["のんで"],["も"],["、"],["また"],["それ"],["を"],["吐出す","はきだす"],["、"],["神","かみ"],["が"],["それ"],["を"],["彼","かれ"],["の"],["腹","はら"],["から"],["押出される","おしだされる"],["から"],["だ"],["。"]]},{"verse":16,"text":"彼,かれは毒蛇,どくへびの毒,どくを吸,すい、まむしの舌,したは彼,かれを殺,ころすであろう。","tok":[["彼","かれ"],["は"],["毒蛇","どくへび"],["の"],["毒","どく"],["を"],["吸い","すい"],["、"],["まむし"],["の"],["舌","した"],["は"],["彼","かれ"],["を"],["殺ろすで","ころすで"],["あろう"],["。"]]},{"verse":17,"text":"彼,かれは蜜,みつと凝乳,ぎょうにゅうの流,ながれる川,かわ々を見,みることができない。","tok":[["彼","かれ"],["は"],["蜜","みつ"],["と"],["凝乳","ぎょうにゅう"],["の"],["流れる","ながれる"],["川","かわ"],["々"],["を"],["見る","みる"],["こと"],["が"],["できない"],["。"]]},{"verse":18,"text":"彼,かれはほねおって獲,えたものを返,かえして、それを食,くうことができない。その商,あきないによって得,えた利益,りえきをもって楽,たのしむことができない。","tok":[["彼","かれ"],["は"],["ほねおって"],["獲た","えた"],["もの"],["を"],["返","かえし"],["て"],["、"],["それ"],["を"],["食う","くう"],["こと"],["が"],["できない"],["。"],["その"],["商い","あきない"],["によって"],["得た","えた"],["利益","りえき"],["を"],["もって"],["楽しむ","たのしむ"],["こと"],["が"],["できない"],["。"]]},{"verse":19,"text":"彼,かれが貧,まずしい者,ものをしえたげ、これを捨,すてたからだ。彼,かれは家,いえを奪,うばい取,とっても、それを建,たてることができない。","tok":[["彼","かれ"],["が"],["貧しい","まずしい"],["者","もの"],["を"],["し"],["えたげ"],["、"],["これ"],["を"],["捨てた","すてた"],["から"],["だ"],["。"],["彼","かれ"],["は"],["家","いえ"],["を"],["奪い取って","うばいとって"],["も"],["、"],["それ"],["を"],["建てる","たてる"],["こと"],["が"],["できない"],["。"]]},{"verse":20,"text":"彼,かれの欲張,よくばりは足,たることを知,しらぬゆえ、その楽,たのしむ何,なに物,ものをも救,すくうことができないであろう。","tok":[["彼","かれ"],["の"],["欲張","よくばり"],["は"],["足る","たる"],["こと"],["を"],["知らぬ","しらぬ"],["ゆえ"],["、"],["その"],["楽しむ","たのしむ"],["何","な"],["に"],["物","もの"],["を"],["も"],["救う","すくう"],["こと"],["が"],["できないで"],["あろう"],["。"]]},{"verse":21,"text":"彼,かれが残,のこして食,たべなかった物,ものとては一つもない。それゆえ、その繁栄,はんえいはながく続,つづかないであろう。","tok":[["彼","かれ"],["が"],["残して","のこして"],["食べなかった","たべなかった"],["物","もの"],["と"],["ては"],["一","ひと"],["つ"],["も"],["ない"],["。"],["それ"],["ゆえ"],["、"],["その"],["繁栄","はんえい"],["は"],["ながく"],["続かないで","つづかないで"],["あろう"],["。"]]},{"verse":22,"text":"その力,ちからの満,みちている時,とき、彼,かれは窮境,きゅうきょうに陥,おちいり、悩,なやみの手,てがことごとく彼,かれの上,うえに臨,のぞむであろう。","tok":[["その"],["力","ちから"],["の"],["満ちて","みちて"],["いる"],["時","とき"],["、"],["彼","かれ"],["は"],["窮境","きゅうきょう"],["に"],["陥ち","おち"],["いり"],["、"],["悩み","なやみ"],["の"],["手","て"],["が"],["ことごとく"],["彼","かれ"],["の"],["上","うえ"],["に"],["臨むで","のぞむで"],["あろう"],["。"]]},{"verse":23,"text":"彼,かれがその腹,はらを満,みたそうとすれば、神,かみはその激,はげしい怒,いかりを送,おくって、それを彼,かれの上,うえに降,ふり注ぎ,そそぎ、彼,かれの食物,しょくもつとされる。","tok":[["彼","かれ"],["が"],["その"],["腹","はら"],["を"],["満たそう","みたそう"],["と"],["すれば"],["、"],["神","かみ"],["は"],["その"],["激しい","はげしい"],["怒り","いかり"],["を"],["送って","おくって"],["、"],["それ"],["を"],["彼","かれ"],["の"],["上","うえ"],["に"],["降り注ぎ","ふり注ぎ"],[","],["そそぎ"],["、"],["彼","かれ"],["の"],["食物","しょくもつ"],["と"],["される"],["。"]]},{"verse":24,"text":"彼,かれは鉄,てつの武器,ぶきを免,まぬかれても、青銅,せいどうの矢,やは彼,かれを射通,いとおすであろう。","tok":[["彼","かれ"],["は"],["鉄","てつ"],["の"],["武器","ぶき"],["を"],["免かれて","まぬかれて"],["も"],["、"],["青銅","せいどう"],["の"],["矢","や"],["は"],["彼","かれ"],["を"],["射通すで","いとおすで"],["あろう"],["。"]]},{"verse":25,"text":"彼,かれがこれをその身,みから引,ひき抜,ぬけば、きらめく矢,やじりがその肝,きもから出,でてきて、恐,おそれが彼,かれの上,うえに臨,のぞむ。","tok":[["彼","かれ"],["が"],["これ"],["を"],["その"],["身","み"],["から"],["引","ひき"],["抜ば","ぬけば"],["、"],["きらめく"],["矢じり","やじり"],["が"],["その"],["肝","きも"],["から"],["出て","でて"],["きて"],["、"],["恐","おそれ"],["が"],["彼","かれ"],["の"],["上","うえ"],["に"],["臨む","のぞむ"],["。"]]},{"verse":26,"text":"もろもろの暗黒,あんこくが彼,かれの宝物,ほうもつのためにたくわえられ、人,ひとが吹,ふき起,おこしたものでない火,ひが彼,かれを焼,やきつくし、その天幕,てんまくに残,のこっている者,ものを滅,ほろぼすであろう。","tok":[["もろもろ"],["の"],["暗黒","あんこく"],["が"],["彼","かれ"],["の"],["宝物","ほうもつ"],["の"],["ため"],["に"],["たくわえられ"],["、"],["人","ひと"],["が"],["吹","ふき"],["起こした","おこした"],["もの"],["で"],["ない"],["火","ひ"],["が"],["彼","かれ"],["を"],["焼きつく","やきつく"],["し"],["、"],["その"],["天幕","てんまく"],["に"],["残って","のこって"],["いる"],["者","もの"],["を"],["滅ぼすで","ほろぼすで"],["あろう"],["。"]]},{"verse":27,"text":"天,てんは彼,かれの罪,つみをあらわし、地,ちは起,おこって彼,かれを攻,せめるであろう。","tok":[["天","てん"],["は"],["彼","かれ"],["の"],["罪","つみ"],["を"],["あらわし"],["、"],["地","ち"],["は"],["起こって","おこって"],["彼","かれ"],["を"],["攻めるで","せめるで"],["あろう"],["。"]]},{"verse":28,"text":"その家,いえの財産,ざいさんは奪,うばい去,さられ、神,かみの怒,いかりの日,ひに消,きえうせるであろう。","tok":[["その"],["家","いえ"],["の"],["財産","ざいさん"],["は"],["奪い去られ","うばいさられ"],["、"],["神","かみ"],["の"],["怒り","いかり"],["の"],["日","ひ"],["に"],["消えうせるで","きえうせるで"],["あろう"],["。"]]},{"verse":29,"text":"これが悪,あしき人,ひとの神,かみから受,うける分,ぶん、神,かみによって定,さだめられた嗣,し業,ぎょうである」。","tok":[["これ"],["が"],["悪しき","あしき"],["人","ひと"],["の"],["神","かみ"],["から"],["受ける","うける"],["分","ぶん"],["、"],["神","かみ"],["によって"],["定められた","さだめられた"],["嗣業","しぎょ"],["うで"],["ある"],["」"],["。"]]}]
[{"verse":1,"text":"アルタシャスタ王,おうの治世,ちせいに、バビロンからわたしと一緒,いっしょに上,のぼって来,きた者,ものの氏族,しぞくの長,ちょう、およびその系譜,けいふは次,つぎのとおりである。","tok":[["アルタシャスタ"],["王","おう"],["の"],["治世","ちせい"],["に"],["、"],["バビロン"],["から"],["わたし"],["と"],["一緒","いっしょ"],["に"],["上って","のぼって"],["来た","きた"],["者","もの"],["の"],["氏族","しぞく"],["の"],["長う","ちょう"],["、"],["および"],["その"],["系譜","けいふ"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"]]},{"verse":2,"text":"ピネハスの子孫,しそんのうちではゲルショム。イタマルの子孫,しそんのうちではダニエル。ダビデの子孫,しそんのうちではシカニヤの子,こハットシ。","tok":[["ピネハス"],["の"],["子孫","しそん"],["の"],["うち"],["で"],["は"],["ゲルショム"],["。"],["イタマル"],["の"],["子孫","しそん"],["の"],["うち"],["で"],["は"],["ダニエル"],["。"],["ダビデ"],["の"],["子孫","しそん"],["の"],["うち"],["で"],["は"],["シカニヤ"],["の"],["子","こ"],["ハットシ"],["。"]]},{"verse":3,"text":"パロシの子孫,しそんのうちではゼカリヤおよび彼,かれと共,ともに系譜,けいふに載,のせられた男,おとこ百五十人,にん。","tok":[["パロシ"],["の"],["子孫","しそん"],["の"],["うち"],["で"],["は"],["ゼカリヤ"],["および"],["彼","かれ"],["と"],["共","とも"],["に"],["系譜","けいふ"],["に"],["載せられた","のせられた"],["男","おとこ"],["百五","ひゃくご"],["十人","じゅうにん"],["。"]]},{"verse":4,"text":"パハテ・モアブの子孫,しそんのうちではゼラヒヤの子,こエリヨエナイおよび彼,かれと共,ともにある男,おとこ二百人,にん。","tok":[["パハテ"],["・"],["モアブ"],["の"],["子孫","しそん"],["の"],["うち"],["で"],["は"],["ゼラヒヤ"],["の"],["子","こ"],["エリヨエナイ"],["および"],["彼","かれ"],["と"],["共","とも"],["に"],["ある"],["男","おとこ"],["二百人","にん"],["。"]]},{"verse":5,"text":"ザッツの子孫,しそんのうちではヤハジエルの子,こシカニヤおよび彼,かれと共,ともにある男,おとこ三百人,にん。","tok":[["ザッツ"],["の"],["子孫","しそん"],["の"],["うち"],["で"],["は"],["ヤハジエル"],["の"],["子","こ"],["シカニヤ"],["および"],["彼","かれ"],["と"],["共","とも"],["に"],["ある"],["男","おとこ"],["三百人","にん"],["。"]]},{"verse":6,"text":"アデンの子孫,しそんのうちではヨナタンの子,こエベデおよび彼,かれと共,ともにある男,おとこ五十人,にん。","tok":[["アデン"],["の"],["子孫","しそん"],["の"],["うち"],["で"],["は"],["ヨナタン"],["の"],["子","こ"],["エベデ"],["および"],["彼","かれ"],["と"],["共","とも"],["に"],["ある"],["男","おとこ"],["五","ご"],["十人","じゅうにん"],["。"]]},{"verse":7,"text":"エラムの子孫,しそんのうちではアタリヤの子,こエサヤおよび彼,かれと共,ともにある男,おとこ七十人,にん。","tok":[["エラム"],["の"],["子孫","しそん"],["の"],["うち"],["で"],["は"],["アタリヤ"],["の"],["子","こ"],["エサヤ"],["および"],["彼","かれ"],["と"],["共","とも"],["に"],["ある"],["男","おとこ"],["七","なな"],["十人","じゅうにん"],["。"]]},{"verse":8,"text":"シパテヤの子孫,しそんのうちではミカエルの子,こゼバデヤおよび彼,かれと共,ともにある男,おとこ八十人,にん。","tok":[["シパテヤ"],["の"],["子孫","しそん"],["の"],["うち"],["で"],["は"],["ミカエル"],["の"],["子","こ"],["ゼバデヤ"],["および"],["彼","かれ"],["と"],["共","とも"],["に"],["ある"],["男","おとこ"],["八","はち"],["十人","じゅうにん"],["。"]]},{"verse":9,"text":"ヨアブの子孫,しそんのうちではエヒエルの子,こオバデヤおよび彼,かれと共,ともにある男,おとこ二百十八人,にん。","tok":[["ヨアブ"],["の"],["子孫","しそん"],["の"],["うち"],["で"],["は"],["エヒエル"],["の"],["子","こ"],["オバデヤ"],["および"],["彼","かれ"],["と"],["共","とも"],["に"],["ある"],["男","おとこ"],["二百十八","にひゃくじゅうはち"],["人","にん"],["。"]]},{"verse":10,"text":"バニの子孫,しそんのうちではヨシピアの子,こシロミテおよび彼,かれと共,ともにある男,おとこ百六十人,にん。","tok":[["バニ"],["の"],["子孫","しそん"],["の"],["うち"],["で"],["は"],["ヨシピア"],["の"],["子","こ"],["シロミテ"],["および"],["彼","かれ"],["と"],["共","とも"],["に"],["ある"],["男","おとこ"],["百六","ひゃくろく"],["十人","じゅうにん"],["。"]]},{"verse":11,"text":"ベバイの子孫,しそんのうちではベバイの子,こゼカリヤおよび彼,かれと共,ともにある男,おとこ二十八人,にん。","tok":[["ベバイ"],["の"],["子孫","しそん"],["の"],["うち"],["で"],["は"],["ベバイ"],["の"],["子","こ"],["ゼカリヤ"],["および"],["彼","かれ"],["と"],["共","とも"],["に"],["ある"],["男","おとこ"],["二十八人","にん"],["。"]]},{"verse":12,"text":"アズガデの子孫,しそんのうちではハッカタンの子,こヨハナンおよび彼,かれと共,ともにある男,おとこ百十人,にん。","tok":[["アズガデ"],["の"],["子孫","しそん"],["の"],["うち"],["で"],["は"],["ハッカタン"],["の"],["子","こ"],["ヨハナン"],["および"],["彼","かれ"],["と"],["共","とも"],["に"],["ある"],["男","おとこ"],["百","ひゃく"],["十人","じゅうにん"],["。"]]},{"verse":13,"text":"アドニカムの子孫,しそんのうちでは後,のちに来,きた者,ものどもで、その名,なはエリペレテ、ユエル、シマヤおよび彼,かれらと共,ともにある男,おとこ六十人,にん。","tok":[["アドニカム"],["の"],["子孫","しそん"],["の"],["うち"],["で"],["は"],["後","のち"],["に"],["来た","きた"],["者","もの"],["ども"],["で"],["、"],["その"],["名","な"],["は"],["エリペレテ"],["、"],["ユエル"],["、"],["シマヤ"],["および"],["彼","かれ"],["ら"],["と"],["共","とも"],["に"],["ある"],["男","おとこ"],["六","ろく"],["十人","じゅうにん"],["。"]]},{"verse":14,"text":"ビグワイの子孫,しそんのうちではウタイとザックルおよび彼,かれらと共,ともにある男,おとこ七十人,にんである。","tok":[["ビグワイ"],["の"],["子孫","しそん"],["の"],["うち"],["で"],["は"],["ウタイ"],["と"],["ザックル"],["および"],["彼","かれ"],["ら"],["と"],["共","とも"],["に"],["ある"],["男","おとこ"],["七","なな"],["十人","じゅうにん"],["で"],["ある"],["。"]]},{"verse":15,"text":"わたしは彼,かれらをアハワに流,ながれる川,かわのほとりに集,あつめて、そこに三日,みっかのあいだ露営,ろえいした。わたしは民,たみと祭司,さいしとを調,しらべたが、そこにはレビの子孫,しそんはひとりもいなかったので、","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["を"],["アハワ"],["に"],["流れる","ながれる"],["川","かわ"],["の"],["ほとり"],["に"],["集めて","あつめて"],["、"],["そこ"],["に"],["三日","みっか"],["の"],["あいだ"],["露営","ろえい"],["した"],["。"],["わたし"],["は"],["民","たみ"],["と"],["祭司","さいし"],["と"],["を"],["調べた","しらべた"],["が"],["、"],["そこ"],["に"],["は"],["レビ"],["の"],["子孫","しそん"],["は"],["ひとり"],["も"],["いなかった"],["ので"],["、"]]},{"verse":16,"text":"人,ひとをつかわしてエリエゼル、アリエル、シマヤ、エルナタン、ヤリブ、エルナタン、ナタン、ゼカリヤ、メシュラムという首長,しゅちょうたる人々,ひとびとを招,まねき、またヨヤリブ、およびエルナタンのような見識,けんしきのある人々,ひとびとを招,まねいた。","tok":[["人","ひと"],["を"],["つかわして"],["エリエゼル"],["、"],["アリエル"],["、"],["シマヤ"],["、"],["エルナタン"],["、"],["ヤリブ"],["、"],["エルナタン"],["、"],["ナタン"],["、"],["ゼカリヤ"],["、"],["メシュラム"],["と"],["いう"],["首長","しゅちょう"],["たる"],["人々","ひとびと"],["を"],["招き","まねき"],["、"],["また"],["ヨヤリブ"],["、"],["および"],["エルナタン"],["の"],["よう"],["な"],["見識","けんしき"],["の"],["ある"],["人々","ひとびと"],["を"],["招いた","まねいた"],["。"]]},{"verse":17,"text":"そしてわたしはカシピアという所,ところの首長,しゅちょうイドのもとに彼,かれらをつかわし、カシピアという所,ところにいるイドと、その兄弟,きょうだいである宮,みやに仕,つかえるしもべたちに告,つぐべき言葉,ことばを、彼,かれらに授,さづけ、われわれの神,かみの宮,みやのために、仕,つかえ人,ひとをわれわれに連,つれて来,こいと言,いった。","tok":[["そして"],["わたし"],["は"],["カシピア"],["と"],["いう"],["所","ところ"],["の"],["首長","しゅちょう"],["イド"],["の"],["もと"],["に"],["彼","かれ"],["ら"],["を"],["つかわし"],["、"],["カシピア"],["と"],["いう"],["所","ところ"],["に"],["いる"],["イド"],["と"],["、"],["その"],["兄弟","きょうだい"],["で"],["ある"],["宮","みや"],["に"],["仕える","つかえる"],["しもべ"],["たち"],["に"],["告ぐべき","つぐべき"],["言葉","ことば"],["を"],["、"],["彼","かれ"],["ら"],["に"],["授","さ"],["づけ"],["、"],["われわれ"],["の"],["神","かみ"],["の"],["宮","みや"],["の"],["ため"],["に"],["、"],["仕え","つかえ"],["人","ひと"],["を"],["われわれ"],["に"],["連れて","つれて"],["来い","こい"],["と"],["言った","いった"],["。"]]},{"verse":18,"text":"われわれの神,かみがよくわれわれを助,たすけられたので、彼,かれらはイスラエルの子,こ、レビの子,こ、マヘリの子孫,しそんのうちの思慮,しりょ深,ふかい人,ひと、すなわちセレビヤおよびその子,こらとその兄弟,きょうだいたち十八人,にんを、われわれに連,つれて来,き、","tok":[["われわれ"],["の"],["神","かみ"],["が"],["よく"],["われわれ"],["を"],["助けられた","たすけられた"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["イスラエル"],["の"],["子","こ"],["、"],["レビ"],["の"],["子","こ"],["、"],["マヘリ"],["の"],["子孫","しそん"],["の"],["うち"],["の"],["思慮","しりょ"],["深","ふ"],["かい人","かいひと"],["、"],["すなわち"],["セレビヤ"],["および"],["その"],["子","こ"],["ら"],["と"],["その"],["兄弟","きょうだい"],["たち"],["十八人","にん"],["を"],["、"],["われわれ"],["に"],["連れて","つれて"],["来","き"],["、"]]},{"verse":19,"text":"またハシャビヤおよび彼,かれと共,ともに、メラリの子孫,しそんのエサヤとその兄弟,きょうだいおよびその子,こら二十人,にん、","tok":[["また"],["ハシャビヤ"],["および"],["彼","かれ"],["と"],["共","とも"],["に"],["、"],["メラリ"],["の"],["子孫","しそん"],["の"],["エサヤ"],["と"],["その"],["兄弟","きょうだい"],["および"],["その"],["子","こ"],["ら"],["二","に"],["十人","じゅうにん"],["、"]]},{"verse":20,"text":"および宮,みやに仕,つかえるしもべ、すなわちダビデとそのつかさたちが、レビびとに仕,つかえさせるために選,えらんだ宮,みやに仕,つかえるしもべ二百二十人,にんを連,つれてきた。これらの者,ものは皆,みなその名,なを言,いって記録,きろくされた。","tok":[["および"],["宮","みや"],["に"],["仕える","つかえる"],["しもべ"],["、"],["すなわち"],["ダビデ"],["と"],["その"],["つかさ"],["たち"],["が"],["、"],["レビ"],["びと"],["に"],["仕えさせる","つかえさせる"],["ため"],["に"],["選らんだ","えらんだ"],["宮","みや"],["に"],["仕える","つかえる"],["しもべ"],["二百二","にひゃくに"],["十人","じゅうにん"],["を"],["連れて","つれて"],["きた"],["。"],["これ"],["ら"],["の"],["者","もの"],["は"],["皆","みな"],["その"],["名","な"],["を"],["言って","いって"],["記録","きろく"],["された"],["。"]]},{"verse":21,"text":"そこでわたしは、かしこのアハワ川,かわのほとりで断食,だんじきを布告,ふこくし、われわれの神,かみの前,まえで身,みをひくくし、われわれと、われわれの幼,おさなき者,ものと、われわれのすべての貨,か財,ざいのために、正,ただしい道,みちを示,しめされるように神,かみに求,もとめた。","tok":[["そこ"],["で"],["わたし"],["は"],["、"],["かしこ"],["の"],["アハワ"],["川","かわ"],["の"],["ほとり"],["で"],["断食","だんじき"],["を"],["布告","ふこく"],["し"],["、"],["われわれ"],["の"],["神","かみ"],["の"],["前","まえ"],["で"],["身","み"],["を"],["ひくく"],["し"],["、"],["われわれ"],["と"],["、"],["われわれ"],["の"],["幼き","おさなき"],["者","もの"],["と"],["、"],["われわれ"],["の"],["すべて"],["の"],["貨財","かざい"],["の"],["ため"],["に"],["、"],["正い","ただしい"],["道","みち"],["を"],["示めされる","しめされる"],["よう"],["に"],["神","かみ"],["に"],["求めた","もとめた"],["。"]]},{"verse":22,"text":"これは、われわれがさきに王,おうに告,つげて、「われわれの神,かみの手,ては、神,かみを求,もとめるすべての者,ものの上,うえにやさしく下,くだり、その威力,いりょくと怒,いかりとはすべて神,かみを捨,すてる者,ものの上,うえに下,くだる」と言,いったので、わたしは道中,どうちゅうの敵,てきに対,たいして、われわれを守,まもるべき歩兵,ほへいと騎兵,きへいとを、王,おうに頼,たのむことを恥,はじたからである。","tok":[["これ"],["は"],["、"],["われわれ"],["が"],["さき"],["に"],["王","おう"],["に"],["告","つげ"],["て"],["、"],["「"],["われわれ"],["の"],["神","かみ"],["の"],["手","て"],["は"],["、"],["神","かみ"],["を"],["求める","もとめる"],["すべて"],["の"],["者","もの"],["の"],["上","うえ"],["に"],["やさしく"],["下り","くだり"],["、"],["その"],["威力","いりょく"],["と"],["怒り","いかり"],["と"],["は"],["すべて"],["神","かみ"],["を"],["捨てる","すてる"],["者","もの"],["の"],["上","うえ"],["に"],["下る","くだる"],["」"],["と"],["言った","いった"],["ので"],["、"],["わたし"],["は"],["道中","どうちゅう"],["の"],["敵","てき"],["に対して","にたいして"],["、"],["われわれ"],["を"],["守","まもる"],["べき"],["歩兵","ほへい"],["と"],["騎兵","きへい"],["と"],["を"],["、"],["王","おう"],["に"],["頼む","たのむ"],["こと"],["を"],["恥","はじ"],["た"],["から"],["で"],["ある"],["。"]]},{"verse":23,"text":"そこでわれわれは断食,だんじきして、このことをわれわれの神,かみに求,もとめたところ、神,かみはその願,ねがいを聞,ききいれられた。","tok":[["そこ"],["で"],["われわれ"],["は"],["断食","だんじき"],["して"],["、"],["この"],["こと"],["を"],["われわれ"],["の"],["神","かみ"],["に"],["求めた","もとめた"],["ところ"],["、"],["神","かみ"],["は"],["その"],["願い","ねがい"],["を"],["聞きいれられた","ききいれられた"],["。"]]},{"verse":24,"text":"わたしはおもだった祭司,さいし十二人,にんすなわちセレビヤ、ハシャビヤおよびその兄弟,きょうだい十人,にんを選,えらび、","tok":[["わたし"],["は"],["おも"],["だった"],["祭司","さいし"],["十二人","にん"],["すなわち"],["セレビヤ"],["、"],["ハシャビヤ"],["および"],["その"],["兄弟","きょうだい"],["十人","にん"],["を"],["選ら","えら"],["び"],["、"]]},{"verse":25,"text":"金銀,きんぎんおよび器物,うつわもの、すなわち王,おうと、その議,ぎ官,かんと、その諸侯,しょこうおよびすべて在留,ざいりゅうのイスラエルびとが、われわれの神,かみの宮,みやのためにささげた奉納物,ほうのうぶつを量,はかって彼,かれらに渡,わたした。","tok":[["金銀","きんぎん"],["および"],["器物","うつわも"],["の"],["、"],["すなわち"],["王","おう"],["と"],["、"],["その"],["議官","ぎかん"],["と"],["、"],["その"],["諸侯","しょこう"],["および"],["すべて"],["在留","ざいりゅう"],["の"],["イスラエル"],["びと"],["が"],["、"],["われわれ"],["の"],["神","かみ"],["の"],["宮","みや"],["の"],["ため"],["に"],["ささげた"],["奉納物","ほうのうぶつ"],["を"],["量って","はかって"],["彼","かれ"],["ら"],["に"],["渡","わたし"],["た"],["。"]]},{"verse":26,"text":"わたしが量,はかって彼,かれらの手,てに渡,わたしたものは、銀,ぎん六百五十タラント、銀,ぎんの器,うつわ百タラント、金,きん百タラントであった。","tok":[["わたし"],["が"],["量って","はかって"],["彼","かれ"],["ら"],["の"],["手","て"],["に"],["渡","わたし"],["た"],["もの"],["は"],["、"],["銀","ぎん"],["六百五十","ろくひゃくごじゅう"],["タラント"],["、"],["銀","ぎん"],["の"],["器","うつわ"],["百","ひゃく"],["タラント"],["、"],["金","きん"],["百","ひゃく"],["タラント"],["で"],["あった"],["。"]]},{"verse":27,"text":"また金,きんの大杯,おおさかずきが二十あって、一千ダリクに当,あたる。また光,ひかり輝,かがやく青銅,せいどうの器,うつわ二個,こあって、その尊,たっといこと金,きんのようである。","tok":[["また"],["金","きん"],["の"],["大杯","おおさかずき"],["が"],["二十","にじゅう"],["あって"],["、"],["一千","いちせん"],["ダリク"],["に"],["当たる","あたる"],["。"],["また"],["光","ひかり"],["輝やく","かがやく"],["青銅","せいどう"],["の"],["器","うつわ"],["二個","こ"],["あって"],["、"],["その"],["尊","たっといこ"],["と"],["金","きん"],["の"],["よう"],["で"],["ある"],["。"]]},{"verse":28,"text":"そしてわたしは彼,かれらに言,いった、「あなたがたは主,しゅに聖別,せいべつされた者,ものである。この器物,うつわものも聖,せいである。またこの金銀,きんぎんは、あなたがたの先祖,せんぞの神,かみ、主,しゅにささげた真心,まごころよりの供,そなえ物,ものである。","tok":[["そして"],["わたし"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["主に","しゅに"],["聖別","せいべつ"],["された"],["者","もの"],["で"],["ある"],["。"],["この"],["器物","うつわも"],["の"],["も"],["聖","せい"],["で"],["ある"],["。"],["また"],["この"],["金銀","きんぎん"],["は"],["、"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["の"],["神","かみ"],["、"],["主に","しゅに"],["ささげた"],["真心","まごころ"],["より"],["の"],["供え物","そなえもの"],["で"],["ある"],["。"]]},{"verse":29,"text":"あなたがたはエルサレムで、主,しゅの宮,みやのへやの中,なかで、祭司,さいし長,ちょう、レビびとおよびイスラエルの氏族,しぞくのかしらたちの前,まえで、これを量,はかるまで、見張,みはり、かつ守,まもりなさい」。","tok":[["あなた"],["がた"],["は"],["エルサレム"],["で"],["、"],["主","しゅ"],["の"],["宮","みや"],["の"],["へや"],["の"],["中","なか"],["で"],["、"],["祭司長","さいしちょう"],["、"],["レビ"],["び"],["と"],["および"],["イスラエル"],["の"],["氏族","しぞく"],["の"],["かしら"],["たち"],["の"],["前","まえ"],["で"],["、"],["これ"],["を"],["量る","はかる"],["まで"],["、"],["見張","みはり"],["、"],["かつ"],["守り","まもり"],["なさい"],["」"],["。"]]},{"verse":30,"text":"そこで祭司,さいしおよびレビびとたちは、その金銀,きんぎんおよび器物,うつわものを、エルサレムにあるわれわれの神,かみの宮,みやに携,たずさえて行,いくため、その重,おもさのものを受,うけ取,とった。","tok":[["そこ"],["で"],["祭司","さいし"],["および"],["レビ"],["びと"],["たち"],["は"],["、"],["その"],["金銀","きんぎん"],["および"],["器物","うつわも"],["の"],["を"],["、"],["エルサレム"],["に"],["ある"],["われわれ"],["の"],["神","かみ"],["の"],["宮","みや"],["に"],["携えて","たずさえて"],["行く","いく"],["ため"],["、"],["その"],["重さ","おもさ"],["の"],["もの"],["を"],["受け取った","うけとった"],["。"]]},{"verse":31,"text":"われわれは正月,しょうがつの十二日,にちに、アハワ川,がわを出立,しゅったつしてエルサレムに向,むかったが、われわれの神,かみの手,ては、われわれの上,うえにあって、敵,てきの手,ておよび道,みちに待,まち伏,ぶせする者,ものの手,てから、われわれを救,すくわれた。","tok":[["われわれ"],["は"],["正月","しょうがつ"],["の"],["十二","じゅうに"],["日","にち"],["に"],["、"],["アハワ"],["川","がわ"],["を"],["出立","しゅったつ"],["して"],["エルサレム"],["に"],["向かった","むかった"],["が"],["、"],["われわれ"],["の"],["神","かみ"],["の"],["手","て"],["は"],["、"],["われわれ"],["の"],["上","うえ"],["に"],["あって"],["、"],["敵","てき"],["の"],["手","て"],["および"],["道","みち"],["に"],["待伏せ","まちぶせ"],["する"],["者","もの"],["の"],["手","て"],["から"],["、"],["われわれ"],["を"],["救われた","すくわれた"],["。"]]},{"verse":32,"text":"われわれはエルサレムに着,ついて、三日,かそこにいたが、","tok":[["われわれ"],["は"],["エルサレム"],["に"],["着いて","ついて"],["、"],["三日","かそこ"],["に"],["いた"],["が"],["、"]]},{"verse":33,"text":"四日,か目,めにわれわれの神,かみの宮,みやの内,うちで、その金銀,きんぎんおよび器物,うつわものを、ウリヤの子,こ祭司,さいしメレモテの手,てに量,はかって渡,わたした。ピネハスの子,こエレアザルが彼,かれと共,ともにいた。またエシュアの子,こヨザバデ、およびビンヌイの子,こノアデヤのふたりのレビびとも、彼,かれらと共,ともにいた。","tok":[["四日目","かめ"],["に"],["われわれ"],["の"],["神","かみ"],["の"],["宮","みや"],["の"],["内","うち"],["で"],["、"],["その"],["金銀","きんぎん"],["および"],["器物","うつわも"],["の"],["を"],["、"],["ウリヤ"],["の"],["子","こ"],["祭司","さいし"],["メレモテ"],["の"],["手","て"],["に"],["量って","はかって"],["渡","わたし"],["た"],["。"],["ピネハス"],["の"],["子","こ"],["エレアザル"],["が"],["彼","かれ"],["と"],["共","とも"],["に"],["いた"],["。"],["また"],["エシュア"],["の"],["子","こ"],["ヨザバデ"],["、"],["および"],["ビンヌイ"],["の"],["子","こ"],["ノアデヤ"],["の"],["ふたり"],["の"],["レビ"],["びと"],["も"],["、"],["彼","かれ"],["ら"],["と"],["共","とも"],["に"],["いた"],["。"]]},{"verse":34,"text":"すなわちそのすべての数,かずと重,おもさとを調,しらべ、その重,おもさは皆,みな書,かきとめられた。","tok":[["すなわち"],["その"],["すべて"],["の"],["数","かず"],["と"],["重さ","おもさ"],["と"],["を"],["調べ","しらべ"],["、"],["その"],["重さ","おもさ"],["は"],["皆","みな"],["書きとめられた","かきとめられた"],["。"]]},{"verse":35,"text":"そのとき捕囚,ほしゅうの人々,ひとびとで捕囚,ほしゅうから帰,かえって来,きた者,ものは、イスラエルの神,かみに燔祭,はんさいをささげた。すなわちイスラエル全体,ぜんたいのために雄牛,おうし十二頭,とう、雄羊,おひつじ九十六頭,とう、小羊,こひつじ七十七頭,とうをささげ、また罪祭,ざいさいとして雄,おやぎ十二頭,とうをささげた。これらはみな、主,しゅにささげた燔祭,はんさいである。","tok":[["その"],["とき"],["捕囚","ほしゅう"],["の"],["人々","ひとびと"],["で"],["捕囚","ほしゅう"],["から"],["帰えって","かえって"],["来た","きた"],["者","もの"],["は"],["、"],["イスラエル"],["の"],["神","かみ"],["に"],["燔祭","はんさい"],["を"],["ささげた"],["。"],["すなわち"],["イスラエル"],["全体","ぜんたい"],["の"],["ため"],["に"],["雄牛","おうし"],["十二頭","と"],["う"],["、"],["雄羊","おひつじ"],["九十六頭","と"],["う"],["、"],["小羊","こひつじ"],["七十七頭","とう"],["を"],["ささげ"],["、"],["また"],["罪","つみ"],["祭","まつり"],["として"],["雄","お"],["やぎ"],["十二頭","とう"],["を"],["ささげた"],["。"],["これ"],["ら"],["は"],["みな"],["、"],["主に","しゅに"],["ささげた"],["燔祭","はんさい"],["で"],["ある"],["。"]]},{"verse":36,"text":"彼,かれらはまた王,おうの命令,めいれい書,しょを、王,おうの総督,そうとくたち、および川,かわ向,むこうの州,しゅうの知事,ちじたちに渡,わたしたので、彼,かれらは民,たみと神,かみの宮,みやとを援助,えんじょした。","tok":[["彼","かれ"],["ら"],["は"],["また"],["王","おう"],["の"],["命令書","めいれいしょ"],["を"],["、"],["王","おう"],["の"],["総督","そうとく"],["たち"],["、"],["および"],["川向こう","かわむこう"],["の"],["州","しゅう"],["の"],["知事","ちじ"],["たち"],["に"],["渡","わたし"],["た"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["民","たみ"],["と"],["神","かみ"],["の"],["宮","みや"],["と"],["を"],["援助","えんじょ"],["した"],["。"]]}]
[{"verse":1,"text":"さて預言者,よげんしゃハガイおよびイドの子,こゼカリヤのふたりの預言者,よげんしゃは、ユダとエルサレムにいるユダヤ人,ひとに向,むかって、彼,かれらの上,うえにいますイスラエルの神,かみの名,なによって預言,よげんした。","tok":[["さて"],["預言者","よげんしゃ"],["ハガイ"],["および"],["イド"],["の"],["子","こ"],["ゼカリヤ"],["の"],["ふたり"],["の"],["預言者","よげんしゃ"],["は"],["、"],["ユダ"],["と"],["エルサレム"],["に"],["いる"],["ユダヤ人","ゆだやひと"],["に"],["向かって","むかって"],["、"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["います"],["イスラエル"],["の"],["神","かみ"],["の"],["名","な"],["によって"],["預言","よげん"],["した"],["。"]]},{"verse":2,"text":"そこでシャルテルの子,こゼルバベルおよびヨザダクの子,こエシュアは立,たちあがって、エルサレムにある神,かみの宮,みやを建,たて始,はじめた。神,かみの預言者,よげんしゃたちも、彼,かれらと共,ともにいて彼,かれらを助,たすけた。","tok":[["そこ"],["で"],["シャルテル"],["の"],["子","こ"],["ゼルバベル"],["および"],["ヨザダク"],["の"],["子","こ"],["エシュア"],["は"],["立ちあがって","たちあがって"],["、"],["エルサレム"],["に"],["ある"],["神","かみ"],["の"],["宮","みや"],["を"],["建て","たて"],["始めた","はじめた"],["。"],["神","かみ"],["の"],["預言者","よげんしゃ"],["たち"],["も"],["、"],["彼","かれ"],["ら"],["と"],["共","とも"],["に"],["いて"],["彼","かれ"],["ら"],["を"],["助けた","たすけた"],["。"]]},{"verse":3,"text":"その時,とき、川,かわ向,むこうの州,しゅうの知事,ちじタテナイおよびセタル・ボズナイとその同僚,どうりょうは彼,かれらの所,ところに来,きてこう言,いった、「だれがあなたがたにこの宮,みやを建,たて、この城壁,じょうへきを築,きずきあげることを命,めいじたのか」。","tok":[["その"],["時","とき"],["、"],["川向こう","かわむこう"],["の"],["州","しゅう"],["の"],["知事","ちじ"],["タテナイ"],["および"],["セタル"],["・"],["ボズナイ"],["と"],["その"],["同僚","どうりょう"],["は"],["彼","かれ"],["ら"],["の"],["所","ところ"],["に"],["来て","きて"],["こう"],["言った","いった"],["、"],["「"],["だれ"],["が"],["あなた"],["がた"],["に"],["この"],["宮","みや"],["を"],["建て","たて"],["、"],["この"],["城壁","じょうへき"],["を"],["築きあげる","きずきあげる"],["こと"],["を"],["命じた","めいじた"],["の"],["か"],["」"],["。"]]},{"verse":4,"text":"また「この建物,たてものを建,たてている人々,ひとびとの名,なはなんというのか」と尋,たずねた。","tok":[["また"],["「"],["この"],["建物","たてもの"],["を"],["建てて","たてて"],["いる"],["人々","ひとびと"],["の"],["名","な"],["は"],["なん"],["と"],["いう"],["の"],["か"],["」"],["と"],["尋ねた","たずねた"],["。"]]},{"verse":5,"text":"しかしユダヤ人,ひとの長老,ちょうろうたちの上,うえには、神,かみの目,めが注,そそがれていたので、彼,かれらはこれをやめさせることができず、その事,ことをダリヨスに奏,そうして、その返答,へんとうの来,くるのを待,まった。","tok":[["しかし"],["ユダヤ人","ゆだやひと"],["の"],["長老","ちょうろう"],["たち"],["の"],["上","うえ"],["に"],["は"],["、"],["神","かみ"],["の"],["目","め"],["が"],["注がれて","そそがれて"],["いた"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["これ"],["を"],["やめさせる"],["こと"],["が"],["できず"],["、"],["その"],["事","こと"],["を"],["ダリヨス"],["に"],["奏して","そうして"],["、"],["その"],["返答","へんとう"],["の"],["来る","くる"],["の"],["を"],["待った","まった"],["。"]]},{"verse":6,"text":"川,かわ向,むこうの州,しゅうの知事,ちじタテナイおよびセタル・ボズナイとその同僚,どうりょうである川,かわ向,むこうの州,しゅうの知事,ちじたちが、ダリヨス王,おうに送,おくった手紙,てがみの写,うつしは次,つぎのとおりである。","tok":[["川向こう","かわむこう"],["の"],["州","しゅう"],["の"],["知事","ちじ"],["タテナイ"],["および"],["セタル"],["・"],["ボズナイ"],["と"],["その"],["同僚","どうりょう"],["で"],["ある"],["川向こう","かわむこう"],["の"],["州","しゅう"],["の"],["知事","ちじ"],["たち"],["が"],["、"],["ダリヨス"],["王","おう"],["に"],["送った","おくった"],["手紙","てがみ"],["の"],["写","うつし"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"]]},{"verse":7,"text":"すなわち、彼,かれらが王,おうに送,おくった手紙,てがみには、次,つぎのようにしるされてあった。「願,ねがわくはダリヨス王,おうに全,まったき平安,へいあんがあるように。","tok":[["すなわち"],["、"],["彼","かれ"],["ら"],["が"],["王","おう"],["に"],["送った","おくった"],["手紙","てがみ"],["に"],["は"],["、"],["次","つぎ"],["の"],["よう"],["に"],["しるされて"],["あった"],["。"],["「"],["願わく","ねがわく"],["は"],["ダリヨス"],["王","おう"],["に"],["全","ま"],["っ"],["たき"],["平安","へいあん"],["が"],["ある"],["よう"],["に"],["。"]]},{"verse":8,"text":"王,おうに次,つぎのことをお知,おしらせいたします。すなわち、われわれがユダヤ州,しゅうへ行,いき、かの大,おおいなる神,かみの宮,みやへ行,いって見,みたところ、それは大,おおきな石,いしをもって建,たてられ、材木,ざいもくを組,くんで壁,かべをつくり、その工事,こうじは勤勉,きんべんに行,おこなわれ、彼,かれらの手,てによって大,おおいにはかどっています。","tok":[["王","おう"],["に"],["次","つぎ"],["の"],["こと"],["を"],["お知らせ","おおしらせ"],["いたします"],["。"],["すなわち"],["、"],["われわれ"],["が"],["ユダヤ"],["州","しゅう"],["へ"],["行き","いき"],["、"],["かの"],["大いなる","おおいなる"],["神","かみ"],["の"],["宮","みや"],["へ"],["行って","いって"],["見た","みた"],["ところ"],["、"],["それ"],["は"],["大きな","おおきな"],["石","いし"],["を"],["もって"],["建てられ","たてられ"],["、"],["材木","ざいもく"],["を"],["組んで","くんで"],["壁","かべ"],["を"],["つくり"],["、"],["その"],["工事","こうじ"],["は"],["勤勉","きんべん"],["に"],["行なわれ","おこなわれ"],["、"],["彼","かれ"],["ら"],["の"],["手","て"],["によって"],["大いに","おおいに"],["はかどって"],["います"],["。"]]},{"verse":9,"text":"そこでわれわれはその長老,ちょうろうたちに尋,たずねてこう言,いいました、『だれがあなたがたにこの宮,みやを建,たて、この城壁,じょうへきを築,きずきあげることを命,めいじたのか』と。","tok":[["そこ"],["で"],["われわれ"],["は"],["その"],["長老","ちょうろう"],["たち"],["に"],["尋ねて","たずねて"],["こう"],["言いました","いいました"],["、"],["『"],["だれ"],["が"],["あなた"],["がた"],["に"],["この"],["宮","みや"],["を"],["建て","たて"],["、"],["この"],["城壁","じょうへき"],["を"],["築きあげる","きずきあげる"],["こと"],["を"],["命じた","めいじた"],["の"],["か"],["』"],["と"],["。"]]},{"verse":10,"text":"われわれはまた彼,かれらのかしらたる人々,ひとびとの名,なを書,かきしるして、あなたにお知,おしらせするために、その名,なを尋,たずねました。","tok":[["われわれ"],["は"],["また"],["彼","かれ"],["ら"],["の"],["かしら"],["たる"],["人々","ひとびと"],["の"],["名","な"],["を"],["書きしるして","かきしるして"],["、"],["あなた"],["に"],["お知らせ","おおしらせ"],["する"],["ため"],["に"],["、"],["その"],["名","な"],["を"],["尋ねました","たずねました"],["。"]]},{"verse":11,"text":"すると、彼,かれらはわれわれに答,こたえてこう言,いいました、『われわれは天地,てんちの神,かみのしもべであって、年,とし久,ひさしい昔,むかしに建,たてられた宮,みやを、再,ふたたび建,たてるのです。これはもと、イスラエルの大,おおいなる王,おうの建,たてあげたものですが、","tok":[["する"],["と"],["、"],["彼","かれ"],["ら"],["は"],["われわれ"],["に"],["答","こたえ"],["て"],["こう"],["言いました","いいました"],["、"],["『"],["われわれ"],["は"],["天地","てんち"],["の"],["神","かみ"],["の"],["しもべ"],["で"],["あって"],["、"],["年","と"],["し"],["久い","ひさしい"],["昔","むかし"],["に"],["建てられた","たてられた"],["宮","みや"],["を"],["、"],["再び","ふたたび"],["建てる","たてる"],["の"],["です"],["。"],["これ"],["は"],["もと"],["、"],["イスラエル"],["の"],["大いなる","おおいなる"],["王","おう"],["の"],["建て","たて"],["あげた"],["もの"],["です"],["が"],["、"]]},{"verse":12,"text":"われわれの先祖,せんぞたちが、天,てんの神,かみの怒,いかりを引,ひき起,おこしたため、神,かみは彼,かれらを、カルデヤびとバビロンの王,おうネブカデネザルの手,てに渡,わたされたので、彼,かれはこの宮,みやをこわし、民,たみをバビロンに捕,とらえて行,いきました。","tok":[["われわれ"],["の"],["先祖","せんぞ"],["たち"],["が"],["、"],["天","てん"],["の"],["神","かみ"],["の"],["怒り","いかり"],["を"],["引起こした","ひきおこした"],["ため"],["、"],["神","かみ"],["は"],["彼","かれ"],["ら"],["を"],["、"],["カルデヤ"],["びと"],["バビロン"],["の"],["王","おう"],["ネブカデネザル"],["の"],["手","て"],["に"],["渡された","わたされた"],["ので"],["、"],["彼","かれ"],["は"],["この"],["宮","みや"],["を"],["こわし"],["、"],["民","たみ"],["を"],["バビロン"],["に"],["捕らえて","とらえて"],["行きました","いきました"],["。"]]},{"verse":13,"text":"ところがバビロンの王,おうクロスの元年,がんねんに、クロス王,おうは神,かみのこの宮,みやを再,ふたたび建,たてることの命令,めいれいを下,くだされました。","tok":[["ところ"],["が"],["バビロン"],["の"],["王","おう"],["クロス"],["の"],["元年","がんねん"],["に"],["、"],["クロス"],["王","おう"],["は"],["神","かみ"],["の"],["この"],["宮","みや"],["を"],["再び","ふたたび"],["建てる","たてる"],["こと"],["の"],["命令","めいれい"],["を"],["下されました","くだされました"],["。"]]},{"verse":14,"text":"またクロス王,おうは先,さきにネブカデネザルが、エルサレムの宮,みやからバビロンの神殿,しんでんに移,うつした神,かみの宮,みやの金銀,きんぎんの器,うつわを、バビロンの神殿,しんでんから取,とり出,だして、彼,かれが総督,そうとくに任,にんじたセシバザルという名,なの者,ものに渡,わたして、","tok":[["また"],["クロス"],["王","おう"],["は"],["先","さき"],["に"],["ネブカデネザル"],["が"],["、"],["エルサレム"],["の"],["宮","みや"],["から"],["バビロン"],["の"],["神殿","しんでん"],["に"],["移した","うつした"],["神","かみ"],["の"],["宮","みや"],["の"],["金銀","きんぎん"],["の"],["器","うつわ"],["を"],["、"],["バビロン"],["の"],["神殿","しんでん"],["から"],["取出して","とりだして"],["、"],["彼","かれ"],["が"],["総督","そうとく"],["に"],["任じた","にんじた"],["セシバザル"],["と"],["いう"],["名","な"],["の"],["者","もの"],["に"],["渡","わたし"],["て"],["、"]]},{"verse":15,"text":"彼,かれに言,いわれました、「これらの器,うつわを携,たずさえて行,いって、エルサレムにある宮,みやに納,おさめ、神,かみの宮,みやをもとの所,ところに建,たてよ」と。","tok":[["彼","かれ"],["に"],["言われました","いわれました"],["、"],["「"],["これ"],["ら"],["の"],["器","うつわ"],["を"],["携えて","たずさえて"],["行って","いって"],["、"],["エルサレム"],["に"],["ある"],["宮","みや"],["に"],["納","おさめ"],["、"],["神","かみ"],["の"],["宮","みや"],["を"],["もと"],["の"],["所","ところ"],["に"],["建てよ","たてよ"],["」"],["と"],["。"]]},{"verse":16,"text":"そこでこのセシバザルは来,きてエルサレムにある神,かみの宮,みやの基礎,きそをすえました。その時,ときから今,いまに至,いたるまで、建築,けんちくを続,つづけていますが、まだ完成,かんせいしないのです』と。","tok":[["そこ"],["で"],["この"],["セシバザル"],["は"],["来て","きて"],["エルサレム"],["に"],["ある"],["神","かみ"],["の"],["宮","みや"],["の"],["基礎","きそ"],["を"],["すえました"],["。"],["その"],["時","とき"],["から"],["今","いま"],["に"],["至る","いたる"],["まで"],["、"],["建築","けんちく"],["を"],["続けて","つづけて"],["います"],["が"],["、"],["まだ"],["完成","かんせい"],["しない"],["の"],["です"],["』"],["と"],["。"]]},{"verse":17,"text":"それで今,いま、もし王,おうがよしと見,みられるならば、バビロンにある王,おうの宝庫,ほうこを調,しらべて、エルサレムの神,かみのこの宮,みやを建,たてることの命令,めいれいが、はたしてクロス王,おうから出,でているかどうかを確,たしかめ、この事,ことについての王,おうのお考,かんがえをわれわれに伝,つたえてください」。","tok":[["それ"],["で"],["今","いま"],["、"],["もし"],["王","おう"],["が"],["よし"],["と"],["見られるならば","みられるならば"],["、"],["バビロン"],["に"],["ある"],["王","おう"],["の"],["宝庫","ほうこ"],["を"],["調べて","しらべて"],["、"],["エルサレム"],["の"],["神","かみ"],["の"],["この"],["宮","みや"],["を"],["建てる","たてる"],["こと"],["の"],["命令","めいれい"],["が"],["、"],["はたして"],["クロス"],["王","おう"],["から"],["出て","でて"],["いる"],["か"],["どう"],["か"],["を"],["確かめ","たしかめ"],["、"],["この"],["事","こと"],["について"],["の"],["王","おう"],["の"],["お考","おかんがえ"],["を"],["われわれ"],["に"],["伝えて","つたえて"],["ください"],["」"],["。"]]}]
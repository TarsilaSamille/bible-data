[{"verse":1,"text":"これらの事,ことの後,のちペルシャ王,おうアルタシャスタの治世,ちせいにエズラという者,ものがあった。エズラはセラヤの子,こ、セラヤはアザリヤの子,こ、アザリヤはヒルキヤの子,こ、","tok":[["これ"],["ら"],["の"],["事","こと"],["の"],["後","の"],["ち"],["ペルシャ"],["王","おう"],["アルタシャスタ"],["の"],["治世","ちせい"],["に"],["エズラ"],["と"],["いう"],["者","もの"],["が"],["あった"],["。"],["エズラ"],["は"],["セラヤ"],["の"],["子","こ"],["、"],["セラヤ"],["は"],["アザリヤ"],["の"],["子","こ"],["、"],["アザリヤ"],["は"],["ヒルキヤ"],["の"],["子","こ"],["、"]]},{"verse":2,"text":"ヒルキヤはシャルムの子,こ、シャルムはザドクの子,こ、ザドクはアヒトブの子,こ、","tok":[["ヒルキヤ"],["は"],["シャルム"],["の"],["子","こ"],["、"],["シャルム"],["は"],["ザドク"],["の"],["子","こ"],["、"],["ザドク"],["は"],["アヒトブ"],["の"],["子","こ"],["、"]]},{"verse":3,"text":"アヒトブはアマリヤの子,こ、アマリヤはアザリヤの子,こ、アザリヤはメラヨテの子,こ、","tok":[["アヒトブ"],["は"],["アマリヤ"],["の"],["子","こ"],["、"],["アマリヤ"],["は"],["アザリヤ"],["の"],["子","こ"],["、"],["アザリヤ"],["は"],["メラヨテ"],["の"],["子","こ"],["、"]]},{"verse":4,"text":"メラヨテはゼラヒヤの子,こ、ゼラヒヤはウジの子,こ、ウジはブッキの子,こ、","tok":[["メラヨテ"],["は"],["ゼラヒヤ"],["の"],["子","こ"],["、"],["ゼラヒヤ"],["は"],["ウジ"],["の"],["子","こ"],["、"],["ウジ"],["は"],["ブッキ"],["の"],["子","こ"],["、"]]},{"verse":5,"text":"ブッキはアビシュアの子,こ、アビシュアはピネハスの子,こ、ピネハスはエレアザルの子,こ、エレアザルは祭司,さいし長,ちょうアロンの子,こである。","tok":[["ブッキ"],["は"],["アビシュア"],["の"],["子","こ"],["、"],["アビシュア"],["は"],["ピネハス"],["の"],["子","こ"],["、"],["ピネハス"],["は"],["エレアザル"],["の"],["子","こ"],["、"],["エレアザル"],["は"],["祭司長","さいしちょう"],["アロン"],["の"],["子","こ"],["で"],["ある"],["。"]]},{"verse":6,"text":"このエズラはバビロンから上,のぼって来,きた。彼,かれはイスラエルの神,かみ、主,しゅがお授,さづけになったモーセの律法,りっぽうに精通,せいつうした学者,がくしゃであった。その神,かみ、主,しゅの手,てが彼,かれの上,うえにあったので、その求,もとめることを王,おうはことごとく許,ゆるした。","tok":[["この"],["エズラ"],["は"],["バビロン"],["から"],["上って","のぼって"],["来た","きた"],["。"],["彼","かれ"],["は"],["イスラエル"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["お授","おさづけ"],["に"],["なった"],["モーセ"],["の"],["律法","りっぽう"],["に"],["精通","せいつう"],["した"],["学者","がくしゃ"],["で"],["あった"],["。"],["その"],["神","かみ"],["、"],["主","しゅ"],["の"],["手","て"],["が"],["彼","かれ"],["の"],["上","うえ"],["に"],["あった"],["ので"],["、"],["その"],["求める","もとめる"],["こと"],["を"],["王","おう"],["は"],["ことごとく"],["許した","ゆるした"],["。"]]},{"verse":7,"text":"アルタシャスタ王,おうの七年,ねんにまたイスラエルの人々,ひとびとおよび祭司,さいし、レビびと、歌,うたうたう者,もの、門衛,もんえい、宮,みやに仕,つかえるしもべなどエルサレムに上,のぼった。","tok":[["アルタシャスタ"],["王","おう"],["の"],["七","なな"],["年","ねん"],["に"],["また"],["イスラエル"],["の"],["人々","ひとびと"],["および"],["祭司","さいし"],["、"],["レビ"],["び"],["と"],["、"],["歌","うた"],["うたう"],["者","もの"],["、"],["門衛","もんえい"],["、"],["宮","みや"],["に"],["仕える","つかえる"],["しもべ"],["など"],["エルサレム"],["に"],["上った","のぼった"],["。"]]},{"verse":8,"text":"そして王,おうの七年,ねんの五月,がつにエズラはエルサレムに来,きた。","tok":[["そして"],["王","おう"],["の"],["七","なな"],["年","ねん"],["の"],["五","ご"],["月","がつ"],["に"],["エズラ"],["は"],["エルサレム"],["に"],["来た","きた"],["。"]]},{"verse":9,"text":"すなわち正月,しょうがつの一日,にちにバビロンを出立,しゅったつして、五月,がつ一日,にちにエルサレムに着,ついた。その神,かみの恵,めぐみの手,てが彼,かれの上,うえにあったからである。","tok":[["すなわち"],["正月","しょうがつ"],["の"],["一","いち"],["日","にち"],["に"],["バビロン"],["を"],["出立","しゅったつ"],["して"],["、"],["五","ご"],["月","がつ"],["つ"],["一","いち"],["日","にち"],["に"],["エルサレム"],["に"],["着いた","ついた"],["。"],["その"],["神","かみ"],["の"],["恵","めぐみ"],["の"],["手","て"],["が"],["彼","かれ"],["の"],["上","うえ"],["に"],["あった"],["から"],["で"],["ある"],["。"]]},{"verse":10,"text":"エズラは心,こころをこめて主,しゅの律法,りっぽうを調,しらべ、これを行,おこない、かつイスラエルのうちに定,さだめとおきてとを教,おしえた。","tok":[["エズラ"],["は"],["心","こころ"],["を"],["こめて"],["主","しゅ"],["の"],["律法","りっぽう"],["を"],["調べ","しらべ"],["、"],["これ"],["を"],["行ない","おこない"],["、"],["かつ"],["イスラエル"],["の"],["うち"],["に"],["定め","さだめ"],["と"],["おきて"],["と"],["を"],["教えた","おしえた"],["。"]]},{"verse":11,"text":"主,しゅの戒,いましめの言葉,ことば、およびイスラエルに賜,たまわった定,さだめに通,つうじた学者,がくしゃで、祭司,さいしであるエズラにアルタシャスタ王,おうの与,あたえた手紙,てがみの写,うつしは、次,つぎのとおりである。","tok":[["主","しゅ"],["の"],["戒しめ","いましめ"],["の"],["言葉","ことば"],["、"],["および"],["イスラエル"],["に"],["賜わった","たまわった"],["定め","さだめ"],["に"],["通じた","つうじた"],["学者","がくしゃ"],["で"],["、"],["祭司","さいし"],["で"],["ある"],["エズラ"],["に"],["アルタシャスタ"],["王","おう"],["の"],["与","あたえ"],["た"],["手紙","てがみ"],["の"],["写","うつし"],["は"],["、"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"]]},{"verse":12,"text":"「諸王,しょおうの王,おうアルタシャスタ、天,てんの神,かみの律法,りっぽうの学者,がくしゃである祭司,さいしエズラに送,おくる。今,いま、","tok":[["「"],["諸王","しょおう"],["の"],["王","おう"],["アルタシャスタ"],["、"],["天","てん"],["の"],["神","かみ"],["の"],["律法","りっぽう"],["の"],["学者","がくしゃ"],["で"],["ある"],["祭司","さいし"],["エズラ"],["に"],["送る","おくる"],["。"],["今","いま"],["、"]]},{"verse":13,"text":"わたしは命,めいを下,くだす。わが国,くにのうちにいるイスラエルの民,たみおよびその祭司,さいし、レビびとのうち、すべてエルサレムへ行,いこうと望,のぞむ者,ものは皆,みな、あなたと共,ともに行,いくことができる。","tok":[["わたし"],["は"],["命","めい"],["を"],["下す","くだす"],["。"],["わが"],["国","くに"],["の"],["うち"],["に"],["いる"],["イスラエル"],["の"],["民","たみ"],["および"],["その"],["祭司","さいし"],["、"],["レビ"],["びと"],["の"],["うち"],["、"],["すべて"],["エルサレム"],["へ"],["行こう","いこう"],["と"],["望む","のぞむ"],["者","もの"],["は"],["皆","みな"],["、"],["あなた"],["と"],["共","とも"],["に"],["行く","いく"],["こと"],["が"],["できる"],["。"]]},{"verse":14,"text":"あなたは、自分,じぶんの手,てにあるあなたの神,かみの律法,りっぽうに照,てらして、ユダとエルサレムの事情,じじょうを調,しらべるために、王,おうおよび七人,にんの議,ぎ官,かんによってつかわされるのである。","tok":[["あなた"],["は"],["、"],["自分","じぶん"],["の"],["手","て"],["に"],["ある"],["あなた"],["の"],["神","かみ"],["の"],["律法","りっぽう"],["に"],["照","てらし"],["て"],["、"],["ユダ"],["と"],["エルサレム"],["の"],["事情","じじょう"],["を"],["調べる","しらべる"],["ため"],["に"],["、"],["王","おう"],["および"],["七人","にん"],["の"],["議官","ぎかん"],["によって"],["つかわされる"],["ので"],["ある"],["。"]]},{"verse":15,"text":"かつあなたは王,おうおよびその議,ぎ官,かんらが、エルサレムにいますイスラエルの神,かみに真心,まごころからささげる銀,ぎんと金,きんを携,たずさえ、","tok":[["かつ"],["あなた"],["は"],["王","おう"],["および"],["その"],["議官","ぎかん"],["ら"],["が"],["、"],["エルサレム"],["に"],["います"],["イスラエル"],["の"],["神","かみ"],["に"],["真心","まごころ"],["から"],["ささげる"],["銀","ぎん"],["と"],["金","きん"],["を"],["携え","たずさえ"],["、"]]},{"verse":16,"text":"またバビロン全,ぜん州,しゅうであなたが獲,えるすべての金銀,きんぎん、および民,たみと祭司,さいしとが、エルサレムにあるその神,かみの宮,みやのために、真心,まごころからささげた供,そなえ物,ものを携,たずさえて行,いく。","tok":[["また"],["バビロン"],["全州","ぜんしゅう"],["で"],["あなた"],["が"],["獲る","える"],["すべて"],["の"],["金銀","きんぎん"],["、"],["および"],["民","たみ"],["と"],["祭司","さいし"],["と"],["が"],["、"],["エルサレム"],["に"],["ある"],["その"],["神","かみ"],["の"],["宮","みや"],["の"],["ため"],["に"],["、"],["真心","まごころ"],["から"],["ささげた"],["供え物","そなえもの"],["を"],["携えて","たずさえて"],["行く","いく"],["。"]]},{"verse":17,"text":"それであなたはその金,かねをもって雄牛,おうし、雄羊,おひつじ、小羊,こひつじおよびその素祭,そさいと灌祭,かんさいの品々,しなじなを気,きをつけて買,かい、エルサレムにあるあなたがたの神,かみの宮,みやの祭壇,さいだんの上,うえに、これをささげなければならない。","tok":[["それ"],["で"],["あなた"],["は"],["その"],["金","かね"],["を"],["もって"],["雄牛","おうし"],["、"],["雄羊","おひつじ"],["、"],["小羊","こひつじ"],["および"],["その"],["素","す"],["祭","まつり"],["と"],["灌祭","かんさい"],["の"],["品々","しなじな"],["を"],["気","き"],["を"],["つけて"],["買","かい"],["、"],["エルサレム"],["に"],["ある"],["あなた"],["がた"],["の"],["神","かみ"],["の"],["宮","みや"],["の"],["祭壇","さいだん"],["の"],["上","うえ"],["に"],["、"],["これ"],["を"],["ささげなければ"],["ならない"],["。"]]},{"verse":18,"text":"また、あなたとあなたの兄弟,きょうだいたちが、その余,あまった金銀,きんぎんでしようと思,おもうよい事,ことがあるならば、あなたがたの神,かみのみ旨,むねに従,したがってそれを行,おこなえ。","tok":[["また"],["、"],["あなた"],["と"],["あなた"],["の"],["兄弟","きょうだい"],["たち"],["が"],["、"],["その"],["余った","あまった"],["金銀","きんぎん"],["で"],["しよう"],["と"],["思う","おもう"],["よい"],["事","こと"],["が"],["あるならば"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["のみ"],["旨","むね"],["に"],["従って","したがって"],["それ"],["を"],["行なえ","おこなえ"],["。"]]},{"verse":19,"text":"またあなたの神,かみの宮,みやの勤,つとめ事,ことのためにあなたが与,あたえられた器,うつわは、エルサレムの神,かみの前,まえに納,おさめよ。","tok":[["また"],["あなた"],["の"],["神","かみ"],["の"],["宮","みや"],["の"],["勤め","つとめ"],["事","こと"],["の"],["ため"],["に"],["あなた"],["が"],["与えられた","あたえられた"],["器","うつわ"],["は"],["、"],["エルサレム"],["の"],["神","かみ"],["の"],["前","まえ"],["に"],["納","おさめ"],["よ"],["。"]]},{"verse":20,"text":"そのほかあなたの神,かみの宮,みやのために用,もちうべき必要,ひつようなものがあれば、それを王,おうの倉,くらから出,だして用,もちいよ。","tok":[["その"],["ほか"],["あなた"],["の"],["神","かみ"],["の"],["宮","みや"],["の"],["ため"],["に"],["用","も"],["ちうべき"],["必要","ひつよう"],["な"],["もの"],["が"],["あれば"],["、"],["それ"],["を"],["王","おう"],["の"],["倉","くら"],["から"],["出して","だして"],["用い","もちい"],["よ"],["。"]]},{"verse":21,"text":"われ、アルタシャスタ王,おうは川,かわ向,むこうの州,しゅうのすべての倉,くらづかさに命,めいを下,くだして言,いう、『天,てんの神,かみの律法,りっぽうの学者,がくしゃである祭司,さいしエズラがあなたがたに求,もとめる事,ことは、すべてこれを心,こころして行,おこなえ。","tok":[["われ"],["、"],["アルタシャスタ"],["王","おう"],["は"],["川向こう","かわむこう"],["の"],["州","しゅう"],["の"],["すべて"],["の"],["倉","くら"],["づかさ"],["に"],["命","めい"],["を"],["下して","くだして"],["言う","いう"],["、"],["『"],["天","てん"],["の"],["神","かみ"],["の"],["律法","りっぽう"],["の"],["学者","がくしゃ"],["で"],["ある"],["祭司","さいし"],["エズラ"],["が"],["あなた"],["がた"],["に"],["求める","もとめる"],["事","こと"],["は"],["、"],["すべて"],["これ"],["を"],["心","こころ"],["して"],["行なえ","おこなえ"],["。"]]},{"verse":22,"text":"すなわち銀,ぎんは百タラントまで、小麦,こむぎは百コルまで、ぶどう酒,しゅは百バテまで、油,あぶらは百バテまで、塩,しおは制限,せいげんなく与,あたえよ。","tok":[["すなわち"],["銀","ぎん"],["は"],["百","ひゃく"],["タラント"],["まで"],["、"],["小麦","こむぎ"],["は"],["百","ひゃく"],["コル"],["まで"],["、"],["ぶどう酒","ぶどうしゅ"],["は"],["百","ひゃく"],["バテ"],["まで"],["、"],["油","あぶら"],["は"],["百","ひゃく"],["バテ"],["まで"],["、"],["塩","しお"],["は"],["制限","せいげん"],["なく"],["与","あたえ"],["よ"],["。"]]},{"verse":23,"text":"天,てんの神,かみの宮,みやのために、天,てんの神,かみの命,めいじるところは、すべて正,ただしくこれを行,おこなえ。そうしないと神,かみの怒,いかりが、王,おうと王,おうの子,こらの国,くにに臨,のぞむであろう』。","tok":[["天","てん"],["の"],["神","かみ"],["の"],["宮","みや"],["の"],["ため"],["に"],["、"],["天","てん"],["の"],["神","かみ"],["の"],["命じる","めいじる"],["ところ"],["は"],["、"],["すべて"],["正く","ただしく"],["これ"],["を"],["行なえ","おこなえ"],["。"],["そう"],["しない"],["と"],["神","かみ"],["の"],["怒り","いかり"],["が"],["、"],["王","おう"],["と"],["王","おう"],["の"],["子","こ"],["ら"],["の"],["国","くに"],["に"],["臨むで","のぞむで"],["あろう"],["』"],["。"]]},{"verse":24,"text":"われわれは、またあなたがたに告,つげる、『祭司,さいし、レビびと、歌,うたうたう者,もの、門衛,もんえい、宮,みやに仕,つかえるしもべ、および神,かみのこの宮,みやの仕,つかえびとたちには、みつぎ、租税,そぜい、税金,ぜいきんを課,かしてはならぬ』。","tok":[["われわれ"],["は"],["、"],["また"],["あなた"],["がた"],["に"],["告げる","つげる"],["、"],["『"],["祭司","さいし"],["、"],["レビ"],["び"],["と"],["、"],["歌","うた"],["うたう"],["者","もの"],["、"],["門衛","もんえい"],["、"],["宮","みや"],["に"],["仕える","つかえる"],["しもべ"],["、"],["および"],["神","かみ"],["の"],["この"],["宮","みや"],["の"],["仕え","つかえ"],["びと"],["たち"],["に"],["は"],["、"],["みつぎ"],["、"],["租税","そぜい"],["、"],["税金","ぜいきん"],["を"],["課して","かして"],["は"],["ならぬ"],["』"],["。"]]},{"verse":25,"text":"エズラよ、あなたはあなたの手,てにある神,かみの知恵,ちえによって、つかさおよび裁判人,さいばんにんを立,たて、川,かわ向,むこうの州,しゅうのすべての民,たみ、すなわちあなたの神,かみの律法,りっぽうを知,しっている者,ものたちを、ことごとくさばかせよ。あなたがたはまたこれを知,しらない者,ものを教,おしえよ。","tok":[["エズラ"],["よ"],["、"],["あなた"],["は"],["あなた"],["の"],["手","て"],["に"],["ある"],["神","かみ"],["の"],["知恵","ちえ"],["によって"],["、"],["つかさ"],["および"],["裁判人","さいばんにん"],["を"],["立て","たて"],["、"],["川向こう","かわむこう"],["の"],["州","しゅう"],["の"],["すべて"],["の"],["民","たみ"],["、"],["すなわち"],["あなた"],["の"],["神","かみ"],["の"],["律法","りっぽう"],["を"],["知って","しって"],["いる"],["者","もの"],["たち"],["を"],["、"],["ことごとく"],["さばかせ"],["よ"],["。"],["あなた"],["がた"],["は"],["また"],["これ"],["を"],["知らない","しらない"],["者","もの"],["を"],["教え","おしえ"],["よ"],["。"]]},{"verse":26,"text":"あなたの神,かみの律法,りっぽうおよび王,おうの律法,りっぽうを守,まもらない者,ものを、きびしくその罪,つみに定,さだめて、あるいは死刑,しけいに、あるいは追放,ついほうに、あるいは財産,ざいさん没収,ぼっしゅうに、あるいは投獄,とうごくに処,しょせよ」。","tok":[["あなた"],["の"],["神","かみ"],["の"],["律法","りっぽう"],["および"],["王","おう"],["の"],["律法","りっぽう"],["を"],["守らない","まもらない"],["者","もの"],["を"],["、"],["きびしく"],["その"],["罪","つみ"],["に"],["定めて","さだめて"],["、"],["あるいは"],["死刑","しけい"],["に"],["、"],["あるいは"],["追放","ついほう"],["に"],["、"],["あるいは"],["財産","ざいさん"],["没収","ぼっしゅう"],["に"],["、"],["あるいは"],["投獄","とうごく"],["に"],["処せよ","しょせよ"],["」"],["。"]]},{"verse":27,"text":"われわれの先祖,せんぞの神,かみ、主,しゅはほむべきかな。主,しゅはこのように、王,おうの心,こころに、エルサレムにある主,しゅの宮,みやを飾,かざる心,こころを起,おこさせ、","tok":[["われわれ"],["の"],["先祖","せんぞ"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["ほ"],["むべき"],["か"],["な"],["。"],["主","しゅ"],["は"],["この"],["よう"],["に"],["、"],["王","おう"],["の"],["心","こころ"],["に"],["、"],["エルサレム"],["に"],["ある"],["主","しゅ"],["の"],["宮","みや"],["を"],["飾る","かざる"],["心","こころ"],["を"],["起こさせ","おこさせ"],["、"]]},{"verse":28,"text":"また王,おうの前,まえと、その議,ぎ官,かんの前,まえと王,おうの大臣,だいじんの前,まえで、わたしに恵,めぐみを得,えさせられた。わたしはわが神,かみ、主,しゅの手,てがわたしの上,うえにあるので力,ちからを得,え、イスラエルのうちから首領,しゅりょうたる人々,ひとびとを集,あつめて、わたしと共,ともに上,のぼらせた。","tok":[["また"],["王","おう"],["の"],["前","まえ"],["と"],["、"],["その"],["議官","ぎかん"],["の"],["前","まえ"],["と"],["王","おう"],["の"],["大臣","だいじん"],["の"],["前","まえ"],["で"],["、"],["わたし"],["に"],["恵","めぐみ"],["を"],["得させられた","えさせられた"],["。"],["わたし"],["は"],["わが"],["神","かみ"],["、"],["主","しゅ"],["の"],["手","て"],["が"],["わたし"],["の"],["上","うえ"],["に"],["ある"],["ので"],["力","ちから"],["を"],["得","え"],["、"],["イスラエル"],["の"],["うち"],["から"],["首領","しゅりょう"],["たる"],["人々","ひとびと"],["を"],["集めて","あつめて"],["、"],["わたし"],["と"],["共","とも"],["に"],["上らせた","のぼらせた"],["。"]]}]
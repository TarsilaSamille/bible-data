[{"verse":1,"text":"長老,ちょうろうのわたしから、真実,しんじつに愛,あいしている選,えらばれた婦人,ふじんとその子,こたちへ。あなたがたを愛,あいしているのは、わたしだけではなく、真理,しんりを知,しっている者,ものはみなそうである。","tok":[["長老","ちょうろう"],["の"],["わたし"],["から"],["、"],["真実","しんじつ"],["に"],["愛して","あいして"],["いる"],["選ら","えら"],["ばれた"],["婦人","ふじん"],["と"],["その"],["子","こ"],["たち"],["へ"],["。"],["あなた"],["がた"],["を"],["愛して","あいして"],["いる"],["の"],["は"],["、"],["わたし"],["だけ"],["で"],["は"],["なく"],["、"],["真理","しんり"],["を"],["知って","しって"],["いる"],["者","もの"],["は"],["みなそうで"],["ある"],["。"]]},{"verse":2,"text":"それは、わたしたちのうちにあり、また永遠,えいえんに共,ともにあるべき真理,しんりによるのである。","tok":[["それ"],["は"],["、"],["わたしたち"],["の"],["うち"],["に"],["あり"],["、"],["また"],["永遠","えいえん"],["に"],["共","とも"],["に"],["あるべき"],["真理","しんり"],["に"],["よる"],["ので"],["ある"],["。"]]},{"verse":3,"text":"父,ちちなる神,かみおよび父,ちちの御子,みこイエス・キリストから、恵,めぐみとあわれみと平安,へいあんとが、真理,しんりと愛,あいのうちにあって、わたしたちと共,ともにあるように。","tok":[["父","ちち"],["なる"],["神","かみ"],["および"],["父","ちち"],["の"],["御子","みこ"],["イエス"],["・"],["キリスト"],["から"],["、"],["恵","めぐみ"],["と"],["あわれみ"],["と"],["平安","へいあん"],["と"],["が"],["、"],["真理","しんり"],["と"],["愛","あい"],["の"],["うち"],["に"],["あって"],["、"],["わたしたち"],["と"],["共","とも"],["に"],["ある"],["よう"],["に"],["。"]]},{"verse":4,"text":"あなたの子供,こどもたちのうちで、わたしたちが父,ちちから受,うけた戒,いましめどおりに、真理,しんりのうちを歩,あるいている者,ものがあるのを見,みて、わたしは非常,ひじょうに喜,よろこんでいる。","tok":[["あなた"],["の"],["子供","こども"],["たち"],["の"],["うち"],["で"],["、"],["わたしたち"],["が"],["父","ちち"],["から"],["受けた","うけた"],["戒しめ","いましめ"],["どおり"],["に"],["、"],["真理","しんり"],["の"],["うち"],["を"],["歩いて","あるいて"],["いる"],["者","もの"],["が"],["ある"],["の"],["を"],["見て","みて"],["、"],["わたし"],["は"],["非常","ひじょう"],["に"],["喜こんで","よろこんで"],["いる"],["。"]]},{"verse":5,"text":"婦人,ふじんよ。ここにお願,ねがいしたいことがある。それは、新,あたらしい戒,いましめを書,かくわけではなく、初,はじめから持,もっていた戒,いましめなのであるが、わたしたちは、みんな互,たがいに愛,あいし合おうではないか。","tok":[["婦人","ふじん"],["よ"],["。"],["ここ"],["に"],["お願い","おねがい"],["したい"],["こと"],["が"],["ある"],["。"],["それ"],["は"],["、"],["新らしい","あたらしい"],["戒しめ","いましめ"],["を"],["書く","かく"],["わけ"],["で"],["は"],["なく"],["、"],["初め","はじめ"],["から"],["持って","もって"],["いた"],["戒しめ","いましめ"],["な"],["ので"],["ある"],["が"],["、"],["わたしたち"],["は"],["、"],["みんな"],["互","たがい"],["に"],["愛し合おう","あいし合おう"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":6,"text":"父,ちちの戒,いましめどおりに歩,あるくことが、すなわち、愛,あいであり、あなたがたが初,はじめから聞,きいてきたとおりに愛,あいのうちを歩,あるくことが、すなわち、戒,いましめなのである。","tok":[["父","ちち"],["の"],["戒しめ","いましめ"],["どおり"],["に"],["歩く","あるく"],["こと"],["が"],["、"],["すなわち"],["、"],["愛","あい"],["で"],["あり"],["、"],["あなた"],["がた"],["が"],["初め","はじめ"],["から"],["聞いて","きいて"],["きた"],["とおり"],["に"],["愛","あい"],["の"],["うち"],["を"],["歩く","あるく"],["こと"],["が"],["、"],["すなわち"],["、"],["戒しめ","いましめ"],["な"],["ので"],["ある"],["。"]]},{"verse":7,"text":"なぜなら、イエス・キリストが肉体,にくたいをとってこられたことを告白,こくはくしないで人,ひとを惑,まどわす者,ものが、多,おおく世,よにはいってきたからである。そういう者,ものは、惑,まどわす者,ものであり、反,はんキリストである。","tok":[["なぜ"],["なら"],["、"],["イエス"],["・"],["キリスト"],["が"],["肉体","にくたい"],["を"],["とって"],["こられた"],["こと"],["を"],["告白","こくはく"],["しないで"],["人","ひと"],["を"],["惑わす","まどわす"],["者","もの"],["が"],["、"],["多く","おおく"],["世","よ"],["に"],["はいって"],["きた"],["から"],["で"],["ある"],["。"],["そう"],["いう"],["者","もの"],["は"],["、"],["惑わす","まどわす"],["者","もの"],["で"],["あり"],["、"],["反","はん"],["キリスト"],["で"],["ある"],["。"]]},{"verse":8,"text":"よく注意,ちゅういして、わたしたちの働,はたらいて得,えた成果,せいかを失,うしなうことがなく、豊,ゆたかな報,むくいを受,うけられるようにしなさい。","tok":[["よく"],["注意","ちゅうい"],["して"],["、"],["わたしたち"],["の"],["働いて","はたらいて"],["得た","えた"],["成果","せいか"],["を"],["失なう","うしなう"],["こと"],["が"],["なく"],["、"],["豊","ゆたか"],["な"],["報い","むくい"],["を"],["受られる","うけられる"],["よう"],["に"],["し"],["なさい"],["。"]]},{"verse":9,"text":"すべてキリストの教,おしえをとおり過,すごして、それにとどまらない者,ものは、神,かみを持,もっていないのである。その教,おしえにとどまっている者,ものは、父,ちちを持,もち、また御子,みこをも持,もつ。","tok":[["すべて"],["キリスト"],["の"],["教え","おしえ"],["を"],["とおり"],["過ごして","すごして"],["、"],["それ"],["に"],["とどまらない"],["者","もの"],["は"],["、"],["神","かみ"],["を"],["持って","もって"],["いない"],["ので"],["ある"],["。"],["その"],["教え","おしえ"],["に"],["とどまって"],["いる"],["者","もの"],["は"],["、"],["父","ちち"],["を"],["持","もち"],["、"],["また"],["御子","みこ"],["を"],["も"],["持つ","もつ"],["。"]]},{"verse":10,"text":"この教,おしえを持,もたずにあなたがたのところに来,くる者,ものがあれば、その人,ひとを家,いえに入,いれることも、あいさつすることもしてはいけない。","tok":[["この"],["教え","おしえ"],["を"],["持たず","もたず"],["に"],["あなた"],["がた"],["の"],["ところ"],["に"],["来る","くる"],["者","もの"],["が"],["あれば"],["、"],["その"],["人","ひと"],["を"],["家","いえ"],["に"],["入れる","いれる"],["こと"],["も"],["、"],["あいさつ"],["する"],["こと"],["も"],["して"],["は"],["いけない"],["。"]]},{"verse":11,"text":"そのような人,ひとにあいさつする者,ものは、その悪,わるい行,おこないにあずかることになるからである。","tok":[["その"],["よう"],["な"],["人","ひと"],["に"],["あいさつ"],["する"],["者","もの"],["は"],["、"],["その"],["悪い","わるい"],["行ない","おこない"],["に"],["あずかる"],["こと"],["に"],["なる"],["から"],["で"],["ある"],["。"]]},{"verse":12,"text":"あなたがたに書,かきおくることはたくさんあるが、紙,かみと墨,すみとで書,かくことはすまい。むしろ、あなたがたのところに行,いき、直接,ちょくせつはなし合,あって、共,ともに喜,よろこびに満,みちあふれたいものである。","tok":[["あなた"],["がた"],["に"],["書きおくる","かきおくる"],["こと"],["は"],["たくさん"],["ある"],["が"],["、"],["紙","かみ"],["と"],["墨","すみ"],["と"],["で"],["書く","かく"],["こと"],["は"],["すまい"],["。"],["むしろ"],["、"],["あなた"],["がた"],["の"],["ところ"],["に"],["行き","いき"],["、"],["直接","ちょくせつ"],["はなし"],["合って","あって"],["、"],["共","とも"],["に"],["喜こび","よろこび"],["に"],["満ちあふれたい","みちあふれたい"],["もの"],["で"],["ある"],["。"]]},{"verse":13,"text":"選,えらばれたあなたの姉妹,しまいの子供,こどもたちが、あなたによろしく。","tok":[["選ら","えら"],["ばれた"],["あなた"],["の"],["姉妹","しまい"],["の"],["子供","こども"],["たち"],["が"],["、"],["あなた"],["に"],["よろしく"],["。"]]}]
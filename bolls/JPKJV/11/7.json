[{"verse":1,"text":"またソロモンは自分,じぶんの家,いえを建,たてたが、十三年,ねんかかってその家,いえを全部,ぜんぶ建,たて終,おわった。","tok":[["また"],["ソロモン"],["は"],["自分","じぶん"],["の"],["家","いえ"],["を"],["建てた","たてた"],["が"],["、"],["十三","じゅうさん"],["年","ねん"],["の"],["家","いえ"],["を"],["全部","ぜんぶ"],["建て","たて"],["終わった","おわった"],["。"]]},{"verse":2,"text":"彼,かれはレバノンの森,もりの家,いえを建,たてた。長,ながさ百キュビト、幅,はば五十キュビト、高,たかさ三十キュビトで、三列,れつの香柏,こうはくの柱,はしらがあり、その柱,はしらの上,うえに香柏,こうはくの梁,はりがあった。","tok":[["彼","かれ"],["は"],["レバノン"],["の"],["森","もり"],["の"],["家","いえ"],["を"],["建てた","たてた"],["。"],["長さ","ながさ"],["百","ひゃく"],["キュビト"],["、"],["幅","はば"],["五十","ごじゅう"],["キュビト"],["、"],["高か","たか"],["さ"],["三十","さんじゅう"],["キュビト"],["で"],["、"],["三","さん"],["列","れつ"],["の"],["香","こう"],["柏","かしわ"],["の"],["柱","はしら"],["が"],["あり"],["、"],["その"],["柱","はしら"],["の"],["上","うえ"],["に"],["香","こう"],["柏","かしわ"],["の"],["梁","はり"],["が"],["あった"],["。"]]},{"verse":3,"text":"四十五本,ほんの柱,はしらの上,うえにある室,しつは香柏,こうはくの板,いたでおおった。柱,はしらは各,かく列,れつ十五本,ほんあった。","tok":[["四十五本","ほん"],["の"],["柱","はしら"],["の"],["上","うえ"],["に"],["ある"],["室","しつ"],["は"],["香","こう"],["柏","かしわ"],["の"],["板","いた"],["で"],["おおった"],["。"],["柱","はしら"],["は"],["各","かく"],["列","れつ"],["十五本","ほん"],["あった"],["。"]]},{"verse":4,"text":"また窓,まどわくが三列,れつあって、窓,まどと窓,まどと三段,だんに向,むかい合,あっていた。","tok":[["また"],["窓わく","まどわく"],["が"],["三","さん"],["列","れつ"],["つ"],["あって"],["、"],["窓","まど"],["と"],["窓","まど"],["と"],["三","さん"],["段","だん"],["に"],["向","むかい"],["合って","あって"],["いた"],["。"]]},{"verse":5,"text":"戸口,とぐちと窓,まどはみな四角,しかくの枠,わくをもち、窓,まどと窓,まどと三段,だんに向,むかい合,あった。","tok":[["戸口","とぐち"],["と"],["窓","まど"],["は"],["みな"],["四角","しかく"],["の"],["枠","わく"],["を"],["もち"],["、"],["窓","まど"],["と"],["窓","まど"],["と"],["三","さん"],["段","だん"],["に"],["向","むかい"],["合った","あった"],["。"]]},{"verse":6,"text":"また柱,はしらの広間,ひろまを造,つくった。長,ながさ五十キュビト、幅,はば三十キュビトであった。柱,はしらの前,まえに一つの広間,ひろまがあり、その玄関,げんかんに柱,はしらとひさしがあった。","tok":[["また"],["柱","はしら"],["の"],["広間","ひろま"],["を"],["造った","つくった"],["。"],["長さ","ながさ"],["五十","ごじゅう"],["キュビト"],["、"],["幅","はば"],["三十","さんじゅう"],["キュビト"],["で"],["あった"],["。"],["柱","はしら"],["の"],["前","まえ"],["に"],["一","ひと"],["つ"],["の"],["広間","ひろま"],["が"],["あり"],["、"],["その"],["玄関","げんかん"],["に"],["柱","はしら"],["と"],["ひさし"],["が"],["あった"],["。"]]},{"verse":7,"text":"またソロモンはみずから審判,しんぱんをするために玉座,ぎょくざの広間,ひろま、すなわち審判,しんぱんの広間,ひろまを造,つくった。床,ゆかからたるきまで香柏,こうはくをもっておおった。","tok":[["また"],["ソロモン"],["は"],["みずから"],["審判","しんぱん"],["を"],["する"],["ため"],["に"],["玉座","ぎょくざ"],["の"],["広間","ひろま"],["、"],["すなわち"],["審判","しんぱん"],["の"],["広間","ひろま"],["を"],["造った","つくった"],["。"],["床","ゆか"],["から"],["たるき"],["まで"],["香","こう"],["柏","かしわ"],["を"],["もって"],["おおった"],["。"]]},{"verse":8,"text":"ソロモンが住,すんだ宮殿,きゅうでんはその広間,ひろまのうしろの他,たの庭,にわにあって、その造作,ぞうさは同,おなじであった。ソロモンはまた彼,かれがめとったパロの娘,むすめのために家,いえを建,たてたが、その広間,ひろまと同,おなじであった。","tok":[["ソロモン"],["が"],["住んだ","すんだ"],["宮殿","きゅうでん"],["は"],["その"],["広間","ひろま"],["の"],["うしろ"],["の"],["他","た"],["の"],["庭","にわ"],["に"],["あって"],["、"],["その"],["造作","ぞうさ"],["は"],["同じ","おなじ"],["で"],["あった"],["。"],["ソロモン"],["は"],["また"],["彼","かれ"],["が"],["めとった"],["パロ"],["の"],["娘","むすめ"],["の"],["ため"],["に"],["家","いえ"],["を"],["建てた","たてた"],["が"],["、"],["その"],["広間","ひろま"],["と"],["同じ","おなじ"],["で"],["あった"],["。"]]},{"verse":9,"text":"これらはみな内外,ないがいとも、土台,どだいから軒,のきまで、また主,しゅの宮,みやの庭,にわから大庭,おおにわまで、寸法,すんぽうに合,あわせて切,きった石,いし、すなわち、のこぎりでひいた高価,こうかな石,いしで造,つくられた。","tok":[["これ"],["ら"],["は"],["みな"],["内外","ないがい"],["とも"],["、"],["土台","どだい"],["から"],["軒","のき"],["まで"],["、"],["また"],["主","しゅ"],["の"],["宮","みや"],["の"],["庭","にわ"],["から"],["大庭","お"],["おにわ"],["まで"],["、"],["寸法","すんぽう"],["に"],["合","あわせ"],["て"],["切った","きった"],["石","いし"],["、"],["すなわち"],["、"],["のこぎり"],["で"],["ひいた"],["高価","こうか"],["な"],["石","いし"],["で"],["造られた","つくられた"],["。"]]},{"verse":10,"text":"また土台,どだいは高価,こうかな石,いし、大,おおきな石,いし、すなわち八キュビトの石,いし、十キュビトの石,いしであった。","tok":[["また"],["土台","どだい"],["は"],["高価","こうか"],["な"],["石","いし"],["、"],["大きな","おおきな"],["石","いし"],["、"],["すなわち"],["八","はち"],["キュビト"],["の"],["石","いし"],["、"],["十","じゅう"],["キュビト"],["の"],["石","いし"],["で"],["あった"],["。"]]},{"verse":11,"text":"その上,うえには寸法,すんぽうに合,あわせて切,きった高価,こうかな石,いしと香柏,こうはくとがあった。","tok":[["その"],["上","うえ"],["に"],["は"],["寸法","すんぽう"],["に"],["合","あわせ"],["て"],["切った","きった"],["高価","こうか"],["な"],["石","いし"],["と"],["香","こう"],["柏","かしわ"],["が"],["あった"],["。"]]},{"verse":12,"text":"また大庭,おおにわの周囲,しゅういには三かさねの切,きり石,いしと、一かさねの香柏,こうはくの角材,かくざいがあった。主,しゅの宮,みやの内,うち庭,にわと宮殿,きゅうでんの広間,ひろまの庭,にわの場合,ばあいと同,おなじである。","tok":[["また"],["大庭","おおにわ"],["の"],["周囲","しゅうい"],["に"],["は"],["三","さん"],["かさね"],["の"],["切り石","きりいし"],["と"],["、"],["一","いち"],["かさね"],["の"],["香","こう"],["柏","かしわ"],["の"],["角材","かくざい"],["が"],["あった"],["。"],["主","しゅ"],["の"],["宮","みや"],["の"],["内庭","うちにわ"],["と"],["宮殿","きゅうでん"],["の"],["広間","ひろま"],["の"],["庭","にわ"],["の"],["場合","ばあい"],["と"],["同じ","おなじ"],["で"],["ある"],["。"]]},{"verse":13,"text":"ソロモン王,おうは人,ひとをつかわしてツロからヒラムを呼,よんできた。","tok":[["ソロモン"],["王","おう"],["は"],["人","ひと"],["を"],["つかわして"],["ツロ"],["から"],["ヒラム"],["を"],["呼んで","よんで"],["きた"],["。"]]},{"verse":14,"text":"彼,かれはナフタリの部族,ぶぞくの寡婦,かふの子,こであって、その父,ちちはツロの人,ひとで、青銅,せいどうの細工人,さいくにんであった。ヒラムは青銅,せいどうのいろいろな細工,さいくをする知恵,ちえと悟,さとりと知識,ちしきに満,みちた者,ものであったが、ソロモン王,おうのところにきて、そのすべての細工,さいくをした。","tok":[["彼","かれ"],["は"],["ナフタリ"],["の"],["部族","ぶぞく"],["の"],["寡婦","かふ"],["の"],["子","こ"],["で"],["あって"],["、"],["その"],["父","ちち"],["は"],["ツロ"],["の"],["人","ひと"],["で"],["、"],["青銅","せいどう"],["の"],["細工人","さいくにん"],["で"],["あった"],["。"],["ヒラム"],["は"],["青銅","せいどう"],["の"],["いろいろ"],["な"],["細工","さいく"],["を"],["する"],["知恵","ちえ"],["と"],["悟り","さとり"],["と"],["知識","ちしき"],["に"],["満ちた","みちた"],["者","もの"],["で"],["あった"],["が"],["、"],["ソロモン"],["王","おう"],["の"],["ところ"],["に"],["きて"],["、"],["その"],["すべて"],["の"],["細工","さいく"],["を"],["した"],["。"]]},{"verse":15,"text":"彼,かれは青銅,せいどうの柱,はしら二本,ほんを鋳,いた。一本,ぽんの柱,はしらの高,たかさは十八キュビト、そのまわりは綱,つなをもって測,はかると十二キュビトあり、指,ゆび四本,ほんの厚,あつさで空洞,くうどうであった。他,たの柱,はしらも同,おなじである。","tok":[["彼","かれ"],["は"],["青銅","せいどう"],["の"],["柱","はしら"],["二本","ほん"],["を"],["鋳た","いた"],["。"],["一本","ぽん"],["の"],["柱","はしら"],["の"],["高さ","たかさ"],["は"],["十八","じゅうはち"],["キュビト"],["、"],["その"],["まわり"],["は"],["綱","つな"],["を"],["もって"],["測る","はかる"],["と"],["十二","じゅうに"],["キュビト"],["あり"],["、"],["指","ゆび"],["四本","ほん"],["の"],["厚","あつ"],["さ"],["で"],["空洞","くうどう"],["で"],["あった"],["。"],["他","た"],["の"],["柱","はしら"],["も"],["同じ","おなじ"],["で"],["ある"],["。"]]},{"verse":16,"text":"また青銅,せいどうを溶,とかして柱頭,ちゅうとう二つを造,つくり、柱,はしらの頂,いただきにすえた。その一つの柱頭,ちゅうとうの高,たかさは五キュビト、他,たの柱頭,ちゅうとうの高,たかさも五キュビトであった。","tok":[["また"],["青銅","せいどう"],["を"],["溶かして","とかして"],["柱頭","ちゅうとう"],["二","ふた"],["つ"],["を"],["造","つくり"],["、"],["柱","はしら"],["の"],["頂","いただき"],["に"],["すえた"],["。"],["その"],["一","ひと"],["つ"],["の"],["柱頭","ちゅうとう"],["の"],["高さ","たかさ"],["は"],["五","ご"],["キュビト"],["、"],["他","た"],["の"],["柱頭","ちゅうとう"],["の"],["高さ","たかさ"],["も"],["五","ご"],["キュビト"],["で"],["あった"],["。"]]},{"verse":17,"text":"柱,はしらの頂,いただきにある柱頭,ちゅうとうのために鎖,くさりに編,あんだ飾,かざりひもで市松,いちまつ模様,もようの網,あみ細工,ざいく二つを造,つくった。すなわちこの柱頭,ちゅうとうのために一つ、かの柱頭,ちゅうとうのために一つを造,つくった。","tok":[["柱","はしら"],["の"],["頂","いただき"],["に"],["ある"],["柱頭","ちゅうとう"],["の"],["ため"],["に"],["鎖","くさり"],["に"],["編んだ","あんだ"],["飾","かざり"],["ひも"],["で"],["市松","いちまつ"],["模様","もよう"],["の"],["網","あみ"],["細工","ざ"],["いく"],["二","ふた"],["つ"],["を"],["造った","つくった"],["。"],["すなわち"],["この"],["柱頭","ちゅうとう"],["の"],["ため"],["に"],["一","ひと"],["つ"],["、"],["かの"],["柱頭","ちゅうとう"],["の"],["ため"],["に"],["一","ひと"],["つ"],["を"],["造った","つくった"],["。"]]},{"verse":18,"text":"またざくろを造,つくった。すなわち二並,ならびのざくろを一つの網,あみ細工,ざいくの上,うえのまわりに造,つくって、柱,はしらの頂,いただきにある柱頭,ちゅうとうを巻,まいた。他,たの柱頭,ちゅうとうにも同,おなじようにした。","tok":[["また"],["ざくろ"],["を"],["造った","つくった"],["。"],["すなわち"],["二並","ならび"],["の"],["ざくろ"],["を"],["一","ひと"],["つ"],["の"],["網","あみ"],["細工","ざいく"],["の"],["上","うえ"],["の"],["まわり"],["に"],["造って","つくって"],["、"],["柱","はしら"],["の"],["頂","いただき"],["に"],["ある"],["柱頭","ちゅうとう"],["を"],["巻いた","まいた"],["。"],["他","た"],["の"],["柱頭","ちゅうとう"],["に"],["も"],["同じ","おなじ"],["よう"],["に"],["した"],["。"]]},{"verse":19,"text":"この廊,ろうの柱,はしらの頂,いただきにある柱頭,ちゅうとうの上,うえに四キュビトのゆりの花,はなの細工,さいくがあった。","tok":[["この"],["廊","ろう"],["の"],["柱","はしら"],["の"],["頂","いただき"],["に"],["ある"],["柱頭","ちゅうとう"],["の"],["上","うえ"],["に"],["四","よん"],["キュビト"],["の"],["ゆり"],["の"],["花","はな"],["の"],["細工","さいく"],["が"],["あった"],["。"]]},{"verse":20,"text":"二つの柱,はしらの上端,じょうたんの丸,まるい突出,とっしゅつ部,ぶの上,うえにある網,あみ細工,ざいくの柱頭,ちゅうとうの周囲,しゅういには、おのおの二百のざくろが二並,ならびになっていた。","tok":[["二","ふた"],["つ"],["の"],["柱","はしら"],["の"],["上端","じょうたん"],["の"],["丸い","まるい"],["突出","とっしゅつ"],["部","ぶ"],["の"],["上","うえ"],["に"],["ある"],["網","あみ"],["細工","ざいく"],["の"],["柱頭","ちゅうとう"],["の"],["周囲","しゅうい"],["に"],["は"],["、"],["おのおの"],["二百","にひゃく"],["の"],["ざくろ"],["が"],["二並","ならび"],["に"],["なって"],["いた"],["。"]]},{"verse":21,"text":"この柱,はしらを神殿,しんでんの廊,ろうに立,たてた。すなわち南,みなみに柱,はしらを立,たてて、その名,なをヤキンと名,なづけ、北,きたに柱,はしらを立,たてて、その名,なをボアズと名,なづけた。","tok":[["この"],["柱","はしら"],["を"],["神殿","しんでん"],["の"],["廊","ろう"],["に"],["立てた","たてた"],["。"],["すなわち"],["南","みなみ"],["に"],["柱","はしら"],["を"],["立てて","たてて"],["、"],["その"],["名","な"],["を"],["ヤキン"],["と"],["名づけ","なづけ"],["、"],["北","きた"],["に"],["柱","はしら"],["を"],["立てて","たてて"],["、"],["その"],["名","な"],["を"],["ボアズ"],["と"],["名づけた","なづけた"],["。"]]},{"verse":22,"text":"その柱,はしらの頂,いただきにはゆりの花,はなの細工,さいくがあった。こうしてその柱,はしらの造作,ぞうさができあがった。","tok":[["その"],["柱","はしら"],["の"],["頂","いただき"],["に"],["は"],["ゆり"],["の"],["花","はな"],["の"],["細工","さいく"],["が"],["あった"],["。"],["こう"],["して"],["その"],["柱","はしら"],["の"],["造作","ぞうさ"],["が"],["できあがった"],["。"]]},{"verse":23,"text":"また海,うみを鋳,いて造,つくった。縁,ふちから縁,ふちまで十キュビトであって、周囲,しゅういは円形,えんけいをなし、高,たかさ五キュビトで、その周囲,しゅういは綱,つなをもって測,はかると三十キュビトであった。","tok":[["また"],["海","うみ"],["を"],["鋳て","いて"],["造った","つくった"],["。"],["縁","ふちか"],["ら"],["縁","ふ"],["ち"],["まで"],["十","じゅう"],["キュビト"],["で"],["あって"],["、"],["周囲","しゅうい"],["は"],["円形","えんけい"],["を"],["なし"],["、"],["高か","たか"],["さ"],["五","ご"],["キュビト"],["で"],["、"],["その"],["周囲","しゅうい"],["は"],["綱","つな"],["を"],["もって"],["測る","はかる"],["と"],["三十","さんじゅう"],["キュビト"],["で"],["あった"],["。"]]},{"verse":24,"text":"その縁,ふちの下,したには三十キュビトの周囲,しゅういをめぐるひさごがあって、海,うみの周囲,しゅういを囲,かこんでいた。そのひさごは二並,ならびで、海,うみを鋳,いる時,ときに鋳,いたものである。","tok":[["その"],["縁の下","ふちのした"],["に"],["は"],["三十","さんじゅう"],["キュビト"],["の"],["周囲","しゅうい"],["を"],["めぐる"],["ひさご"],["が"],["あって"],["、"],["海","うみ"],["の"],["周囲","しゅうい"],["を"],["囲んで","かこんで"],["いた"],["。"],["その"],["ひさご"],["は"],["二並","な"],["ら"],["び"],["で"],["、"],["海","うみ"],["を"],["鋳る","いる"],["時","とき"],["に"],["鋳た","いた"],["もの"],["で"],["ある"],["。"]]},{"verse":25,"text":"その海,うみは十二の牛,うしの上,うえに置,おかれ、その三つは北,きたに向,むかい、三つは西,にしに向,むかい、三つは南,みなみに向,むかい、三つは東,ひがしに向,むかっていた。海,うみはその上,うえに置,おかれ、牛,うしのうしろは皆,みな内,うちに向,むかっていた。","tok":[["その"],["海","うみ"],["は"],["十二","じゅうに"],["の"],["牛","うし"],["の"],["上","うえ"],["に"],["置かれ","おかれ"],["、"],["その"],["三","みっ"],["つ"],["は"],["北","きた"],["に"],["向","むかい"],["、"],["三","みっ"],["つ"],["は"],["西","にし"],["に"],["向","むかい"],["、"],["三","みっ"],["つ"],["は"],["南","みなみ"],["に"],["向","むかい"],["、"],["三","みっ"],["つ"],["は"],["東","ひがし"],["に"],["向かって","むかって"],["いた"],["。"],["海","うみ"],["は"],["その"],["上","うえ"],["に"],["置かれ","おかれ"],["、"],["牛","うし"],["の"],["うしろ"],["は"],["皆内","みなうち"],["に"],["向かって","むかって"],["いた"],["。"]]},{"verse":26,"text":"海,うみの厚,あつさは手,ての幅,はばで、その縁,ふちは杯,はいの縁,ふちのように、ゆりの花,はなに似,にせて造,つくられた。海,うみには水,みずが二千バテはいった。","tok":[["海","うみ"],["の"],["厚","あつ"],["さ"],["は"],["手","て"],["の"],["幅","はば"],["で"],["、"],["その"],["縁","ふち"],["は"],["杯","はい"],["の"],["縁","ふち"],["の"],["よう"],["に"],["、"],["ゆり"],["の"],["花","はな"],["に"],["似せて","にせて"],["造られた","つくられた"],["。"],["海","うみ"],["に"],["は"],["水","みず"],["が"],["二千","にせん"],["バテ"],["はいった"],["。"]]},{"verse":27,"text":"また青銅,せいどうの台,だいを十個,こ造,つくった。台,だいは長,ながさ四キュビト、幅,はば四キュビト、高,たかさ三キュビトであった。","tok":[["また"],["青銅","せいどう"],["の"],["台","だい"],["を"],["十個","こ"],["造った","つくった"],["。"],["台","だい"],["は"],["長さ","ながさ"],["四","よん"],["キュビト"],["、"],["幅","はば"],["四","よん"],["キュビト"],["、"],["高か","たか"],["さ"],["三","さん"],["キュビト"],["で"],["あった"],["。"]]},{"verse":28,"text":"その台,だいの構造,こうぞうは次,つぎのとおりである。台,だいには鏡板,かがみいたがあり、鏡板,かがみいたは枠,わくの中,なかにあった。","tok":[["その"],["台","だい"],["の"],["構造","こうぞう"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["台","だい"],["に"],["は"],["鏡板","かがみいた"],["が"],["あり"],["、"],["鏡板","かがみいた"],["は"],["枠","わく"],["の"],["中","なか"],["に"],["あった"],["。"]]},{"verse":29,"text":"枠,わくの中,なかにある鏡板,かがみいたには、ししと牛,うしとケルビムとがあり、また、ししと牛,うしの上,うえと下,したにある枠,わくの斜面,しゃめんには花,はな飾,かざりが細工,さいくしてあった。","tok":[["枠","わく"],["の"],["中","なか"],["に"],["ある"],["鏡板","かがみいた"],["に"],["は"],["、"],["しし"],["と"],["牛","うし"],["と"],["ケルビム"],["と"],["が"],["あり"],["、"],["また"],["、"],["しし"],["と"],["牛","うし"],["の"],["上","うえ"],["と"],["下","した"],["に"],["ある"],["枠","わく"],["の"],["斜面","しゃめん"],["に"],["は"],["花","はな"],["飾","かざり"],["が"],["細工","さいく"],["して"],["あった"],["。"]]},{"verse":30,"text":"また台,だいにはおのおの四つの青銅,せいどうの車輪,しゃりんと、青銅,せいどうの車軸,しゃじくがあり、その四すみには洗盤,せんばんのささえがあった。そのささえは、おのおの花,はな飾,かざりのかたわらに鋳,いて造,つくりつけてあった。","tok":[["また"],["台","だい"],["に"],["は"],["おのおの"],["四","よん"],["つ"],["の"],["青銅","せいどう"],["の"],["車輪","しゃりん"],["と"],["、"],["青銅","せいどう"],["の"],["車軸","しゃじく"],["が"],["あり"],["、"],["その"],["四","よん"],["すみ"],["に"],["は"],["洗","あらい"],["盤","ばん"],["の"],["ささえ"],["が"],["あった"],["。"],["その"],["ささえ"],["は"],["、"],["おのおの"],["花","はな"],["飾","かざり"],["の"],["かたわら"],["に"],["鋳て","いて"],["造","つくり"],["つけて"],["あった"],["。"]]},{"verse":31,"text":"その口,くちは一キュビト上,うえに突,つき出,でて、台,だいの頂,いただきの内,うちにあり、その口,くちは丸,まるく、台座,だいざのように造,つくられ、深,ふかさ一キュビト半,はんであった。またその口,くちには彫,ほり物,ものがあった。その鏡板,かがみいたは四角,しかくで、丸,まるくなかった。","tok":[["その"],["口","くち"],["は"],["一","いち"],["キュビト"],["上","うえ"],["に"],["突き出て","つきでて"],["、"],["台","だい"],["の"],["頂","いただき"],["の"],["内","うち"],["に"],["あり"],["、"],["その"],["口","くち"],["は"],["丸く","まるく"],["、"],["台座","だいざ"],["の"],["よう"],["に"],["造られ","つくられ"],["、"],["深さ","ふかさ"],["一","いち"],["キュビト"],["半","はん"],["で"],["あった"],["。"],["また"],["その"],["口","くち"],["に"],["は"],["彫物","ほりもの"],["が"],["あった"],["。"],["その"],["鏡板","かがみいた"],["は"],["四角","しかく"],["で"],["、"],["丸く","まるく"],["なかった"],["。"]]},{"verse":32,"text":"四つの車輪,しゃりんは鏡板,かがみいたの下,したにあり、車軸,しゃじくは台,だいに取,とり付,つけてあり、車輪,しゃりんの高,たかさはおのおの一キュビト半,はんであった。","tok":[["四","よん"],["つ"],["の"],["車輪","しゃりん"],["は"],["鏡板","かがみいた"],["の"],["下","した"],["に"],["あり"],["、"],["車軸","しゃじく"],["は"],["台","だい"],["に"],["取付","とりつけ"],["て"],["あり"],["、"],["車輪","しゃりん"],["の"],["高さ","たかさ"],["は"],["おのおの"],["一","いち"],["キュビト"],["半","はん"],["で"],["あった"],["。"]]},{"verse":33,"text":"車輪,しゃりんの構造,こうぞうは戦車,せんしゃの車輪,しゃりんの構造,こうぞうと同,おなじで、その車軸,しゃじくと縁,ふちと輻,やと轂,こしきとはみな鋳物,いものであった。","tok":[["車輪","しゃりん"],["の"],["構造","こうぞう"],["は"],["戦車","せんしゃ"],["の"],["車輪","しゃりん"],["の"],["構造","こうぞう"],["と"],["同じ","おなじ"],["で"],["、"],["その"],["車軸","しゃじく"],["と"],["縁","ふち"],["と"],["輻","や"],["と"],["轂","こしき"],["と"],["は"],["みな"],["鋳物","いもの"],["で"],["あった"],["。"]]},{"verse":34,"text":"おのおのの台,だいの四すみに四つのささえがあり、そのささえは台,だいの一部,いちぶをなしていた。","tok":[["おのおの"],["の"],["台","だい"],["の"],["四","よん"],["すみ"],["に"],["四","よん"],["つ"],["の"],["ささえ"],["が"],["あり"],["、"],["その"],["ささえ"],["は"],["台","だい"],["の"],["一部","いちぶ"],["を"],["なして"],["いた"],["。"]]},{"verse":35,"text":"台,だいの上,うえには高,たかさ半,はんキュビトの丸,まるい帯,おび輪,わがあった。そして台,だいの上,うえにあるその支柱,しちゅうと鏡板,かがみいたとはその一部,いちぶをなしていた。","tok":[["台","だい"],["の"],["上","うえ"],["に"],["は"],["高か","たか"],["さ"],["半","はん"],["キュビト"],["の"],["丸い","まるい"],["帯輪","おびわ"],["が"],["あった"],["。"],["そして"],["台","だい"],["の"],["上","うえ"],["に"],["ある"],["その"],["支柱","しちゅう"],["と"],["鏡板","かがみいた"],["と"],["は"],["その"],["一部","いちぶ"],["を"],["なして"],["いた"],["。"]]},{"verse":36,"text":"その支柱,しちゅうの表面,ひょうめんと鏡板,かがみいたにはそれぞれの場所,ばしょに、ケルビムと、ししと、しゅろを刻,きざみ、またその周囲,しゅういに花,はな飾,かざりを施,ほどこした。","tok":[["その"],["支柱","しちゅう"],["の"],["表面","ひょうめん"],["と"],["鏡板","かがみいた"],["に"],["は"],["それぞれ"],["の"],["場所","ばしょ"],["に"],["、"],["ケルビム"],["と"],["、"],["しし"],["と"],["、"],["しゅろ"],["を"],["刻み","きざみ"],["、"],["また"],["その"],["周囲","しゅうい"],["に"],["花","はな"],["飾","かざり"],["を"],["施した","ほどこした"],["。"]]},{"verse":37,"text":"このようにして十個,この台,だいを造,つくった。それはみな同,おなじ鋳方,いかた、同,おなじ寸法,すんぽう、同,おなじ形,かたちであった。","tok":[["この"],["よう"],["に"],["して"],["十個","こ"],["の"],["台","だい"],["を"],["造った","つくった"],["。"],["それ"],["は"],["みな"],["同じ","おなじ"],["鋳方","いかた"],["、"],["同じ","おなじ"],["寸法","すんぽう"],["、"],["同じ","おなじ"],["形","かたち"],["で"],["あった"],["。"]]},{"verse":38,"text":"また青銅,せいどうの洗盤,せんばんを十個,こ造,つくった。洗盤,せんばんはおのおの四十バテの水,みずがはいり、洗盤,せんばんはおのおの四キュビトであった。十個,この台,だいの上,うえにはおのおの一つずつの洗盤,せんばんがあった。","tok":[["また"],["青銅","せいどう"],["の"],["洗","あらい"],["盤","ばん"],["を"],["十個","こ"],["造った","つくった"],["。"],["洗","あらい"],["盤","ばん"],["は"],["おのおの"],["四十","よんじゅう"],["バテ"],["の"],["水","みず"],["が"],["はいり"],["、"],["洗","あらい"],["盤","ばん"],["は"],["おのおの"],["四","よん"],["キュビト"],["で"],["あった"],["。"],["十個","こ"],["の"],["台","だい"],["の"],["上","うえ"],["に"],["は"],["おのおの"],["一","ひと"],["つ"],["ずつ"],["の"],["洗","あらい"],["盤","ばん"],["が"],["あった"],["。"]]},{"verse":39,"text":"その台,だいの五個,こを宮,みやの南,みなみの方,ほうに、五個,こを宮,みやの北,きたの方,ほうに置,おき、宮,みやの東南,とうなんの方,ほうに海,うみをすえた。","tok":[["その"],["台","だい"],["の"],["五個","こ"],["を"],["宮","みや"],["の"],["南","みなみ"],["の"],["方","ほう"],["に"],["、"],["五個","こ"],["を"],["宮","みや"],["の"],["北","きた"],["の"],["方","ほう"],["に"],["置き","おき"],["、"],["宮","みや"],["の"],["東南","とうなん"],["の"],["方","ほう"],["に"],["海","うみ"],["を"],["すえた"],["。"]]},{"verse":40,"text":"ヒラムはまたつぼと十能,じゅうのうと鉢,はちを造,つくった。こうしてヒラムはソロモン王,おうのために主,しゅの宮,みやのすべての細工,さいくをなし終,おえた。","tok":[["ヒラム"],["は"],["また"],["つぼ"],["と"],["十能","じゅうのう"],["と"],["鉢","はち"],["を"],["造った","つくった"],["。"],["こう"],["して"],["ヒラム"],["は"],["ソロモン"],["王","おう"],["の"],["ため"],["に"],["主","しゅ"],["の"],["宮","みや"],["の"],["すべて"],["の"],["細工","さいく"],["を"],["なし"],["終えた","おえた"],["。"]]},{"verse":41,"text":"すなわち二本,ほんの柱,はしらと、その柱,はしらの頂,いただきにある柱頭,ちゅうとうの二つの玉,たまと、柱,はしらの頂,いただきにある柱頭,ちゅうとうの二つの玉,たまをおおう二つの網,あみ細工,ざいくと、","tok":[["すなわち"],["二本","ほん"],["の"],["柱","はしら"],["と"],["、"],["その"],["柱","はしら"],["の"],["頂","いただき"],["に"],["ある"],["柱頭","ちゅうとう"],["の"],["二","ふた"],["つ"],["の"],["玉","たま"],["と"],["、"],["柱","はしら"],["の"],["頂","いただき"],["に"],["ある"],["柱頭","ちゅうとう"],["の"],["二","ふた"],["つ"],["の"],["玉","たま"],["を"],["おおう"],["二","ふた"],["つ"],["の"],["網","あみ"],["細工","ざいく"],["と"],["、"]]},{"verse":42,"text":"その二つの網,あみ細工,ざいくのためのざくろ四百。このざくろは一つの網,あみ細工,ざいくに、二並,ならびにつけて、柱,はしらの頂,いただきにある柱頭,ちゅうとうの二つの玉,たまを巻,まいた。","tok":[["その"],["二","ふた"],["つ"],["の"],["網","あみ"],["細工","ざいく"],["の"],["ため"],["の"],["ざくろ"],["四百","よんひゃく"],["。"],["この"],["ざくろ"],["は"],["一","ひと"],["つ"],["の"],["網","あみ"],["細工","ざいく"],["に"],["、"],["二並","ならび"],["に"],["つけて"],["、"],["柱","はしら"],["の"],["頂","いただき"],["に"],["ある"],["柱頭","ちゅうとう"],["の"],["二","ふた"],["つ"],["の"],["玉","たま"],["を"],["巻いた","まいた"],["。"]]},{"verse":43,"text":"また十個,この台,だいと、その台,だいの上,うえの十個,この洗盤,せんばんと、","tok":[["また"],["十個","こ"],["の"],["台","だい"],["と"],["、"],["その"],["台","だい"],["の"],["上","うえ"],["の"],["十個","こ"],["の"],["洗","あらい"],["盤","ばん"],["と"],["、"]]},{"verse":44,"text":"一つの海,うみと、その海,うみの下,したの十二の牛,うしとであった。","tok":[["一","ひと"],["つ"],["の"],["海","うみ"],["と"],["、"],["その"],["海","うみ"],["の"],["下","した"],["の"],["十二","じゅうに"],["の"],["牛","うし"],["と"],["で"],["あった"],["。"]]},{"verse":45,"text":"さてつぼと十能,じゅうのうと鉢,はち、すなわちヒラムがソロモン王,おうのために造,つくった主,しゅの宮,みやのこれらの器,うつわはみな光,ひかりのある青銅,せいどうであった。","tok":[["さて"],["つぼ"],["と"],["十能","じゅうのう"],["と"],["鉢","は"],["ち"],["、"],["すなわち"],["ヒラム"],["が"],["ソロモン"],["王","おう"],["の"],["ため"],["に"],["造った","つくった"],["主","しゅ"],["の"],["宮","みや"],["の"],["これ"],["ら"],["の"],["器","うつわ"],["は"],["みな"],["光","ひかり"],["の"],["ある"],["青銅","せいどう"],["で"],["あった"],["。"]]},{"verse":46,"text":"王,おうはヨルダンの低地,ていちで、スコテとザレタンの間,あいだの粘土,ねんどの地,ちでこれらを鋳,いた。","tok":[["王","おう"],["は"],["ヨルダン"],["の"],["低地","ていち"],["で"],["、"],["スコテ"],["と"],["ザレタン"],["の"],["間","あいだ"],["の"],["粘土","ねんど"],["の"],["地","ち"],["で"],["これ"],["ら"],["を"],["鋳た","いた"],["。"]]},{"verse":47,"text":"ソロモンはその器,うつわが非常,ひじょうに多,おおかったので、皆,みなそれをはからずにおいた。その青銅,せいどうの重,おもさは、はかり得,えなかった。","tok":[["ソロモン"],["は"],["その"],["器","うつわ"],["が"],["非常","ひじょう"],["に"],["多かった","おおかった"],["ので"],["、"],["皆","みな"],["それ"],["を"],["はからず"],["に"],["おいた"],["。"],["その"],["青銅","せいどう"],["の"],["重さ","おもさ"],["は"],["、"],["はかり"],["得なかった","えなかった"],["。"]]},{"verse":48,"text":"またソロモンは主,しゅの宮,みやにあるもろもろの器,うつわを造,つくった。すなわち金,きんの祭壇,さいだんと、供,そなえのパンを載,のせる金,きんの机,つくえ、","tok":[["また"],["ソロモン"],["は"],["主","しゅ"],["の"],["宮","みや"],["に"],["ある"],["もろもろ"],["の"],["器","うつわ"],["を"],["造った","つくった"],["。"],["すなわち"],["金","きん"],["の"],["祭壇","さいだん"],["と"],["、"],["供え","そなえ"],["の"],["パン"],["を"],["載せる","のせる"],["金","きん"],["の"],["机","つくえ"],["、"]]},{"verse":49,"text":"および純金,じゅんきんの燭台,しょくだい。この燭台,しょくだいは本殿,ほんでんの前,まえに、五つは南,みなみに、五つは北,きたにあった。また金,きんの花,はなと、ともしび皿,さらと、心,こころかきと、","tok":[["および"],["純金","じゅんきん"],["の"],["燭台","しょくだい"],["。"],["この"],["燭台","しょくだい"],["は"],["本殿","ほんでん"],["の"],["前","まえ"],["に"],["、"],["五","いつ"],["つ"],["は"],["南","みなみ"],["に"],["、"],["五","いつ"],["つ"],["は"],["北","きた"],["に"],["あった"],["。"],["また"],["金","きん"],["の"],["花","はな"],["と"],["、"],["ともしび"],["皿","さら"],["と"],["、"],["心","こころ"],["かき"],["と"],["、"]]},{"verse":50,"text":"純金,じゅんきんの皿,さらと、心切,しんきりばさみと、鉢,はちと、香,こうの杯,はいと、心取,しんとり皿,ざらと、至聖所,しせいじょである宮,みやの奥,おくのとびらのためおよび、宮,みやの拝殿,はいでんのとびらのために、金,きんのひじつぼを造,つくった。","tok":[["純金","じゅんきん"],["の"],["皿","さら"],["と"],["、"],["心切り","しんきり"],["ばさみ"],["と"],["、"],["鉢","はち"],["と"],["、"],["香","こう"],["の"],["杯","はい"],["と"],["、"],["心","こころ"],["取","とり"],["とり皿","とりざら"],["と"],["、"],["至聖所","し"],["せい"],["じょ"],["で"],["ある"],["宮","みや"],["の"],["奥","おく"],["の"],["とびら"],["の"],["ため"],["および"],["、"],["宮","みや"],["の"],["拝殿","はいでん"],["の"],["とびら"],["の"],["ため"],["に"],["、"],["金","きん"],["の"],["ひじ"],["つぼ"],["を"],["造った","つくった"],["。"]]},{"verse":51,"text":"こうしてソロモン王,おうが主,しゅの宮,みやのために造,つくるすべての細工,さいくは終,おわった。そしてソロモンは父,ちちダビデがささげた物,もの、すなわち金銀,きんぎんおよび器物,うつわものを携,たずさえ入,はいり、主,しゅの宮,みやの宝蔵,ほうぞうの中,なかにたくわえた。","tok":[["こう"],["して"],["ソロモン"],["王","おう"],["が"],["主","しゅ"],["の"],["宮","みや"],["の"],["ため"],["に"],["造る","つくる"],["すべて"],["の"],["細工","さいく"],["は"],["終わった","おわった"],["。"],["そして"],["ソロモン"],["は"],["父","ちち"],["ダビデ"],["が"],["ささげた"],["物","もの"],["、"],["すなわち"],["金銀","きんぎん"],["および"],["器物","うつわも"],["の"],["を"],["携え","たずさえ"],["入","は"],["いり"],["、"],["主","しゅ"],["の"],["宮","みや"],["の"],["宝蔵","ほうぞう"],["の"],["中","なか"],["に"],["たくわえた"],["。"]]}]
[{"verse":1,"text":"ソロモンが主,しゅの宮,みやと王,おうの宮殿,きゅうでんおよびソロモンが建,たてようと望,のぞんだすべてのものを建,たて終,おわった時,とき、","tok":[["ソロモン"],["が"],["主","しゅ"],["の"],["宮","みや"],["と"],["王","おう"],["の"],["宮殿","きゅうでん"],["および"],["ソロモン"],["が"],["建てよう","たてよう"],["と"],["望んだ","のぞんだ"],["すべて"],["の"],["もの"],["を"],["建て","たて"],["終わった","おわった"],["時","とき"],["、"]]},{"verse":2,"text":"主,しゅはかつてギベオンでソロモンに現,あらわれられたように再,ふたたび現,あらわれて、","tok":[["主","しゅ"],["は"],["かつて"],["ギベオン"],["で"],["ソロモン"],["に"],["現われられた","あらわれられた"],["よう"],["に"],["再び","ふたたび"],["現われて","あらわれて"],["、"]]},{"verse":3,"text":"彼,かれに言,いわれた、「あなたが、わたしの前,まえに願,ねがった祈,いのりと願,ねがいとを聞,きいた。わたしはあなたが建,たてたこの宮,みやを聖別,せいべつして、わたしの名,なを永久,えいきゅうにそこに置,おく。わたしの目,めと、わたしの心,こころは常,つねにそこにあるであろう。","tok":[["彼","かれ"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["が"],["、"],["わたし"],["の"],["前","まえ"],["に"],["願った","ねがった"],["祈","いのり"],["と"],["願い","ねがい"],["と"],["を"],["聞いた","きいた"],["。"],["わたし"],["は"],["あなた"],["が"],["建てた","たてた"],["この"],["宮","みや"],["を"],["聖別","せいべつ"],["して"],["、"],["わたし"],["の"],["名","な"],["を"],["永久","えいきゅう"],["に"],["そこ"],["に"],["置く","おく"],["。"],["わたし"],["の"],["目","め"],["と"],["、"],["わたし"],["の"],["心","こころ"],["は"],["常","つね"],["に"],["そこ"],["に"],["あるで"],["あろう"],["。"]]},{"verse":4,"text":"あなたがもし、あなたの父,ちちダビデが歩,あゆんだように全,まったき心,こころをもって正,ただしくわたしの前,まえに歩,あゆみ、すべてわたしが命,めいじたようにおこなって、わたしの定,さだめと、おきてとを守,まもるならば、","tok":[["あなた"],["が"],["もし"],["、"],["あなた"],["の"],["父","ちち"],["ダビデ"],["が"],["歩んだ","あゆんだ"],["よう"],["に"],["全","ま"],["っ"],["たき"],["心","こころ"],["を"],["もって"],["正く","ただしく"],["わたし"],["の"],["前","まえ"],["に"],["歩み","あゆみ"],["、"],["すべて"],["わたし"],["が"],["命じた","めいじた"],["よう"],["に"],["おこなって"],["、"],["わたし"],["の"],["定め","さだめ"],["と"],["、"],["おきて"],["と"],["を"],["守","まもる"],["ならば"],["、"]]},{"verse":5,"text":"わたしは、あなたの父,ちちダビデに約束,やくそくして『イスラエルの王位,おういにのぼる人,ひとがあなたに欠,かけることはないであろう』と言,いったように、あなたのイスラエルに王,おうたる位,くらいをながく確保,かくほするであろう。","tok":[["わたし"],["は"],["、"],["あなた"],["の"],["父","ちち"],["ダビデ"],["に"],["約束","やくそく"],["して"],["『"],["イスラエル"],["の"],["王位","おうい"],["に"],["のぼる"],["人","ひと"],["が"],["あなた"],["に"],["欠ける","かける"],["こと"],["は"],["ないで"],["あろう"],["』"],["と"],["言った","いった"],["よう"],["に"],["、"],["あなた"],["の"],["イスラエル"],["に"],["王","おう"],["たる"],["位","くらい"],["を"],["ながく"],["確保","かくほ"],["するで"],["あろう"],["。"]]},{"verse":6,"text":"しかし、あなたがた、またはあなたがたの子孫,しそんがそむいてわたしに従,したがわず、わたしがあなたがたの前,まえに置,おいた戒,いましめと定,さだめとを守,まもらず、他,たの神々,かみがみに行,いって、それに仕,つかえ、それを拝,おがむならば、","tok":[["しかし"],["、"],["あなた"],["がた"],["、"],["また"],["は"],["あなた"],["がた"],["の"],["子孫","しそん"],["が"],["そむいて"],["わたし"],["に"],["従わず","したがわず"],["、"],["わたし"],["が"],["あなた"],["がた"],["の"],["前","まえ"],["に"],["置いた","おいた"],["戒しめ","いましめ"],["と"],["定め","さだめ"],["と"],["を"],["守らず","まもらず"],["、"],["他","た"],["の"],["神々","かみがみ"],["に"],["行って","いって"],["、"],["それ"],["に"],["仕え","つかえ"],["、"],["それ"],["を"],["拝むならば","おがむならば"],["、"]]},{"verse":7,"text":"わたしはイスラエルを、わたしが与,あたえた地,ちのおもてから断,たつであろう。またわたしの名,なのために聖別,せいべつした宮,みやをわたしの前,まえから投,なげすてるであろう。そしてイスラエルはもろもろの民,たみのうちにことわざとなり、笑,わらい草,ぐさとなるであろう。","tok":[["わたし"],["は"],["イスラエル"],["を"],["、"],["わたし"],["が"],["与","あたえ"],["た"],["地","ち"],["の"],["おもて"],["から"],["断つで","たつで"],["あろう"],["。"],["また"],["わたし"],["の"],["名","な"],["の"],["ため"],["に"],["聖別","せいべつ"],["した"],["宮","みや"],["を"],["わたし"],["の"],["前","まえ"],["から"],["投","なげ"],["すてるで"],["あろう"],["。"],["そして"],["イスラエル"],["は"],["もろもろ"],["の"],["民","たみ"],["の"],["うち"],["に"],["ことわざ"],["と"],["なり"],["、"],["笑草","わらいぐさ"],["と"],["なるで"],["あろう"],["。"]]},{"verse":8,"text":"かつ、この宮,みやは荒塚,あらつかとなり、そのかたわらを過,すぎる者,ものは皆,みな驚,おどろき、うそぶいて『なにゆえ、主,しゅはこの地,ちと、この宮,みやとにこのようにされたのか』と言,いうであろう。","tok":[["かつ"],["、"],["この"],["宮","みや"],["は"],["荒塚","あらつか"],["と"],["なり"],["、"],["その"],["かたわら"],["を"],["過ぎる","すぎる"],["者","もの"],["は"],["皆","みな"],["驚","おどろき"],["、"],["うそぶいて"],["『"],["なにゆえ"],["、"],["主","しゅ"],["は"],["この"],["地","ち"],["と"],["、"],["この"],["宮","みや"],["と"],["に"],["この"],["よう"],["に"],["された"],["の"],["か"],["』"],["と"],["言うで","いうで"],["あろう"],["。"]]},{"verse":9,"text":"その時,とき人々,ひとびとは答,こたえて『彼,かれらは自分,じぶんの先祖,せんぞをエジプトの地,ちから導,みちびき出,だした彼,かれらの神,かみ、主,しゅを捨,すてて、他,たの神々,かみがみにつき従,したがい、それを拝,おがみ、それに仕,つかえたために、主,しゅはこのすべての災,わざわいを彼,かれらの上,うえに下,くだしたのである』と言,いうであろう」。","tok":[["その"],["時","とき"],["人々","ひとびと"],["は"],["答","こたえ"],["て"],["『"],["彼","かれ"],["ら"],["は"],["自分","じぶん"],["の"],["先祖","せんぞ"],["を"],["エジプト"],["の"],["地","ち"],["から"],["導き出した","みちびきだした"],["彼","かれ"],["ら"],["の"],["神","かみ"],["、"],["主","しゅ"],["を"],["捨てて","すてて"],["、"],["他","た"],["の"],["神々","かみがみ"],["に"],["つき従い","つきしたがい"],["、"],["それ"],["を"],["拝み","おがみ"],["、"],["それ"],["に"],["仕えた","つかえた"],["ため"],["に"],["、"],["主","しゅ"],["は"],["この"],["すべて"],["の"],["災","わざわい"],["を"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["下した","くだした"],["ので"],["ある"],["』"],["と"],["言うで","いうで"],["あろう"],["」"],["。"]]},{"verse":10,"text":"ソロモンは二十年,ねんを経,へて二つの家,いえすなわち主,しゅの宮,みやと王,おうの宮殿,きゅうでんとを建,たて終,おわった時,とき、","tok":[["ソロモン"],["は"],["二十","にじゅう"],["年","ねん"],["を"],["経て","へて"],["二","ふた"],["つ"],["の"],["家","いえ"],["すなわち"],["主","しゅ"],["の"],["宮","みや"],["と"],["王","おう"],["の"],["宮殿","きゅうでん"],["と"],["を"],["建て","たて"],["終わった","おわった"],["時","とき"],["、"]]},{"verse":11,"text":"ツロの王,おうヒラムがソロモンの望,のぞみに任,まかせて香柏,こうはくと、いとすぎと、金,きんとを供給,きょうきゅうしたので、ソロモン王,おうはガリラヤの地,ちの町,まち二十をヒラムに与,あたえた。","tok":[["ツロ"],["の"],["王","おう"],["ヒラム"],["が"],["ソロモン"],["の"],["望み","のぞみ"],["に"],["任せて","まかせて"],["香","こう"],["柏","かしわ"],["と"],["、"],["いと"],["すぎ"],["と"],["、"],["金","きん"],["と"],["を"],["供給","きょうきゅう"],["した"],["ので"],["、"],["ソロモン"],["王","おう"],["は"],["ガリラヤ"],["の"],["地","ち"],["の"],["町","まち"],["二十","にじゅう"],["を"],["ヒラム"],["に"],["与","あたえ"],["た"],["。"]]},{"verse":12,"text":"しかしヒラムがツロから来,きて、ソロモンが彼,かれに与,あたえた町々,まちまちを見,みたとき、それらは彼,かれの気,きにいらなかったので、","tok":[["しかし"],["ヒラム"],["が"],["ツロ"],["から"],["来て","きて"],["、"],["ソロモン"],["が"],["彼","かれ"],["に"],["与","あたえ"],["た"],["町々","まちまち"],["を"],["見た","みた"],["とき"],["、"],["それ"],["ら"],["は"],["彼","かれ"],["の"],["気","き"],["に"],["いらなかった"],["ので"],["、"]]},{"verse":13,"text":"彼,かれは、「兄弟,きょうだいよ、あなたがくださったこれらの町々,まちまちは、いったいなんですか」と言,いった。それで、そこは今日,こんにちまでカブルの地,ちと呼,よばれている。","tok":[["彼","かれ"],["は"],["、"],["「"],["兄弟","きょうだい"],["よ"],["、"],["あなた"],["が"],["くださった"],["これ"],["ら"],["の"],["町々","まちまち"],["は"],["、"],["いったい"],["な"],["ん"],["です"],["か"],["」"],["と"],["言った","いった"],["。"],["それ"],["で"],["、"],["そこ"],["は"],["今日","こん"],["に"],["ち"],["まで"],["カブル"],["の"],["地","ち"],["と"],["呼ばれて","よばれて"],["いる"],["。"]]},{"verse":14,"text":"ヒラムはかつて金,きん百二十タラントを王,おうに贈,おくった。","tok":[["ヒラム"],["は"],["かつて"],["金","きん"],["百二十","ひゃくにじゅう"],["タラント"],["を"],["王","おう"],["に"],["贈った","おくった"],["。"]]},{"verse":15,"text":"ソロモン王,おうが強制的,きょうせいてきに労働者,ろうどうしゃを徴募,ちょうぼしたのはこうである。すなわち主,しゅの宮,みやと自分,じぶんの宮殿,きゅうでんと、ミロとエルサレムの城壁,じょうへきと、ハゾルとメギドとゲゼルを建,たてるためであった。","tok":[["ソロモン"],["王","おう"],["が"],["強制的","きょうせいてき"],["に"],["労働者","ろうどうしゃ"],["を"],["徴募","ちょうぼ"],["した"],["の"],["は"],["こう"],["で"],["ある"],["。"],["すなわち"],["主","しゅ"],["の"],["宮","みや"],["と"],["自分","じぶん"],["の"],["宮殿","きゅうでん"],["と"],["、"],["ミロ"],["と"],["エルサレム"],["の"],["城壁","じょうへき"],["と"],["、"],["ハゾル"],["と"],["メギド"],["と"],["ゲゼル"],["を"],["建てる","たてる"],["ため"],["で"],["あった"],["。"]]},{"verse":16,"text":"（エジプトの王,おうパロはかつて上,のぼってきて、ゲゼルを取,とり、火,ひでこれを焼,やき、その町,まちに住,すんでいたカナンびとを殺,ころし、これをソロモンの妻,つまである自分,じぶんの娘,むすめに与,あたえて婚姻,こんいんの贈,おくり物,ものとしたので、","tok":[["（"],["エジプト"],["の"],["王","おう"],["パロ"],["は"],["かつて"],["上って","のぼって"],["きて"],["、"],["ゲゼル"],["を"],["取","とり"],["、"],["火","ひ"],["で"],["これ"],["を"],["焼き","やき"],["、"],["その"],["町","まち"],["に"],["住んで","すんで"],["いた"],["カナン"],["びと"],["を"],["殺ろし","ころし"],["、"],["これ"],["を"],["ソロモン"],["の"],["妻","つま"],["で"],["ある"],["自分","じぶん"],["の"],["娘","むすめ"],["に"],["与","あたえ"],["て"],["婚姻","こんいん"],["の"],["贈り物","おくりもの"],["と"],["した"],["ので"],["、"]]},{"verse":17,"text":"ソロモンはそのゲゼルを建,たて直,なおした）。また,また下,したベテホロンと、","tok":[["ソロモン"],["は"],["その"],["ゲゼル"],["を"],["建て直した","たてなおした"],["）"],["。"],["また"],[","],["また下","またした"],["ベテホロン"],["と"],["、"]]},{"verse":18,"text":"バアラテとユダの国,くにの荒野,あらのにあるタマル、","tok":[["バアラテ"],["と"],["ユダ"],["の"],["国","くに"],["の"],["荒野","あらの"],["に"],["ある"],["タマル"],["、"]]},{"verse":19,"text":"およびソロモンが持,もっていた倉庫,そうこの町々,まちまち、戦車,せんしゃの町々,まちまち、騎兵,きへいの町々,まちまちならびにソロモンがエルサレム、レバノンおよびそのすべての領地,りょうちにおいて建,たてようと望,のぞんだものをことごとく建,たてるためであった。","tok":[["および"],["ソロモン"],["が"],["持って","もって"],["いた"],["倉庫","そうこ"],["の"],["町々","まちまち"],["、"],["戦車","せんしゃ"],["の"],["町々","まちまち"],["、"],["騎兵","きへい"],["の"],["町々","まちまち"],["ならび"],["に"],["ソロモン"],["が"],["エルサレム"],["、"],["レバノン"],["および"],["その"],["すべて"],["の"],["領地","りょうち"],["に"],["おいて"],["建てよう","たてよう"],["と"],["望","のぞんだも"],["の"],["を"],["ことごとく"],["建てる","たてる"],["ため"],["で"],["あった"],["。"]]},{"verse":20,"text":"すべてイスラエルの子孫,しそんでないアモリびと、ヘテびと、ペリジびと、ヒビびと、エブスびとの残,のこった者,もの、","tok":[["すべて"],["イスラエル"],["の"],["子孫","しそん"],["で"],["ない"],["アモリ"],["び"],["と"],["、"],["ヘテ"],["び"],["と"],["、"],["ペリジ"],["び"],["と"],["、"],["ヒビ"],["び"],["と"],["、"],["エブス"],["びと"],["の"],["残った","のこった"],["者","もの"],["、"]]},{"verse":21,"text":"その地,ちにあって彼,かれらのあとに残,のこった子孫,しそんすなわちイスラエルの人々,ひとびとの滅,ほろぼしつくすことのできなかった者,ものを、ソロモンは強制的,きょうせいてきに奴隷,どれいとして徴募,ちょうぼをおこない、今日,こんにちに至,いたっている。","tok":[["その"],["地","ち"],["に"],["あって"],["彼","かれ"],["ら"],["の"],["あと"],["に"],["残った","のこった"],["子孫","しそん"],["すなわち"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["滅ぼし","ほろぼし"],["つくす"],["こと"],["の"],["できなかった"],["者","もの"],["を"],["、"],["ソロモン"],["は"],["強制的","きょうせいてき"],["に"],["奴隷","どれい"],["として"],["徴募","ちょうぼ"],["を"],["おこない"],["、"],["今日","こんにち"],["に"],["至って","いたって"],["いる"],["。"]]},{"verse":22,"text":"しかしイスラエルの人々,ひとびとをソロモンはひとりも奴隷,どれいとしなかった。彼,かれらは軍人,ぐんじん、また彼,かれの役人,やくにん、司令,しれい官,かん、指揮,しき官,かん、戦車,せんしゃ隊長,たいちょう、騎兵隊,きへいたい長,ちょうであったからである。","tok":[["しかし"],["イスラエル"],["の"],["人々","ひとびと"],["を"],["ソロモン"],["は"],["ひとり"],["も"],["奴隷","どれい"],["と"],["しなかった"],["。"],["彼","かれ"],["ら"],["は"],["軍人","ぐんじん"],["、"],["また"],["彼","かれ"],["の"],["役人","やくにん"],["、"],["司令官","しれいかん"],["、"],["指揮官","しきかん"],["、"],["戦車隊長","せんしゃたいちょう"],["、"],["騎兵隊長","きへいたいちょう"],["で"],["あった"],["から"],["で"],["ある"],["。"]]},{"verse":23,"text":"ソロモンの工事,こうじを監督,かんとくする上役,うわやくの官吏,かんりは五百五十人,にんであって、工事,こうじに働,はたらく民,たみを治,おさめた。","tok":[["ソロモン"],["の"],["工事","こうじ"],["を"],["監督","かんとく"],["する"],["上役","うわやく"],["の"],["官吏","かんり"],["は"],["五百五","ごひゃくご"],["十人","じゅうにん"],["で"],["あって"],["、"],["工事","こうじ"],["に"],["働く","はたらく"],["民","たみ"],["を"],["治めた","おさめた"],["。"]]},{"verse":24,"text":"パロの娘,むすめはダビデの町,まちから上,のぼって、ソロモンが彼女,かのじょのために建,たてた家,いえに住,すんだ。その時,ときソロモンはミロを建,たてた。","tok":[["パロ"],["の"],["娘","むすめ"],["は"],["ダビデ"],["の"],["町","まち"],["から"],["上って","のぼって"],["、"],["ソロモン"],["が"],["彼女","かのじょ"],["の"],["ため"],["に"],["建てた","たてた"],["家","いえ"],["に"],["住んだ","すんだ"],["。"],["その"],["時","とき"],["ソロモン"],["は"],["ミロ"],["を"],["建てた","たてた"],["。"]]},{"verse":25,"text":"ソロモンは主,しゅのために築,きずいた祭壇,さいだんの上,うえに年,ねんに三度,ど燔祭,はんさいと酬恩祭,しゅうおんさいをささげ、また主,しゅの前,まえに香,こうをたいた。こうしてソロモンは宮,みやを完成,かんせいした。","tok":[["ソロモン"],["は"],["主","しゅ"],["の"],["ため"],["に"],["築いた","きずいた"],["祭壇","さいだん"],["の"],["上","うえ"],["に"],["年","ねん"],["に"],["三","さん"],["度","ど"],["燔祭","はんさい"],["と"],["酬恩祭","しゅうおんさい"],["を"],["ささげ"],["、"],["また"],["主","しゅ"],["の"],["前","まえ"],["に"],["香","こう"],["を"],["たいた"],["。"],["こう"],["して"],["ソロモン"],["は"],["宮","みや"],["を"],["完成","かんせい"],["した"],["。"]]},{"verse":26,"text":"ソロモン王,おうはエドムの地,ち、紅海,こうかいの岸,きしのエラテに近,ちかいエジオン・ゲベルで数隻,すうせきの船,ふねを造,つくった。","tok":[["ソロモン"],["王","おう"],["は"],["エドム"],["の"],["地","ち"],["、"],["紅海","こうかい"],["の"],["岸","きし"],["の"],["エラテ"],["に"],["近い","ちかい"],["エジオン"],["・"],["ゲベル"],["で"],["数隻","すうせき"],["の"],["船","ふね"],["を"],["造った","つくった"],["。"]]},{"verse":27,"text":"ヒラムは海,うみの事,ことを知,しっている船員,せんいんであるそのしもべをソロモンのしもべと共,ともにその船,ふねでつかわした。","tok":[["ヒラム"],["は"],["海","うみ"],["の"],["事","こと"],["を"],["知って","しって"],["いる"],["船員","せんいん"],["で"],["ある"],["その"],["しもべ"],["を"],["ソロモン"],["の"],["しもべ"],["と"],["共","とも"],["に"],["その"],["船","ふね"],["で"],["つかわした"],["。"]]},{"verse":28,"text":"彼,かれらはオフルへ行,いって、そこから金,きん四百二十タラントを取,とって、ソロモン王,おうの所,ところにもってきた。","tok":[["彼","かれ"],["ら"],["は"],["オフル"],["へ"],["行って","いって"],["、"],["そこ"],["から"],["金","きん"],["四百二十","よんひゃくにじゅう"],["タラント"],["を"],["取って","とって"],["、"],["ソロモン"],["王","おう"],["の"],["所","ところ"],["に"],["もって"],["きた"],["。"]]}]
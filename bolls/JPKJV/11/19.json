[{"verse":1,"text":"アハブはエリヤのしたすべての事,こと、また彼,かれがすべての預言者,よげんしゃを刀,かたなで殺,ころしたことをイゼベルに告,つげたので、","tok":[["アハブ"],["は"],["エリヤ"],["の"],["した"],["すべて"],["の"],["事","こと"],["、"],["また"],["彼","かれ"],["が"],["すべて"],["の"],["預言者","よげんしゃ"],["を"],["刀","かたな"],["で"],["殺ろした","ころした"],["こと"],["を"],["イゼベル"],["に"],["告","つげ"],["た"],["ので"],["、"]]},{"verse":2,"text":"イゼベルは使者,ししゃをエリヤにつかわして言,いった、「もしわたしが、あすの今,いまごろ、あなたの命,いのちをあの人々,ひとびとのひとりの命,いのちのようにしていないならば、神々,かみがみがどんなにでも、わたしを罰,ばっしてくださるように」。","tok":[["イゼベル"],["は"],["使者","ししゃ"],["を"],["エリヤ"],["に"],["つかわして"],["言った","いった"],["、"],["「"],["もし"],["わたし"],["が"],["、"],["あす"],["の"],["今ごろ","いまごろ"],["、"],["あなた"],["の"],["命","いのち"],["を"],["あの"],["人々","ひとびと"],["の"],["ひとり"],["の"],["命","いのち"],["の"],["よう"],["に"],["して"],["いないならば"],["、"],["神々","かみがみ"],["が"],["どんな"],["にで"],["も"],["、"],["わたし"],["を"],["罰して","ばっして"],["くださる"],["よう"],["に"],["」"],["。"]]},{"verse":3,"text":"そこでエリヤは恐,おそれて、自分,じぶんの命,いのちを救,すくうために立,たって逃,にげ、ユダに属,ぞくするベエルシバへ行,いって、しもべをそこに残,のこし、","tok":[["そこ"],["で"],["エリヤ"],["は"],["恐れて","おそれて"],["、"],["自分","じぶん"],["の"],["命","いのち"],["を"],["救う","すくう"],["ため"],["に"],["立って","たって"],["逃","にげ"],["、"],["ユダ"],["に"],["属する","ぞくする"],["ベエルシバ"],["へ"],["行って","いって"],["、"],["しもべ"],["を"],["そこ"],["に"],["残し","のこし"],["、"]]},{"verse":4,"text":"自分,じぶんは一日,にちの道,みちのりほど荒野,あらのにはいって行,いって、れだまの木,きの下,したに座,ざし、自分,じぶんの死,しを求,もとめて言,いった、「主,しゅよ、もはや、じゅうぶんです。今,いまわたしの命,いのちを取,とってください。わたしは先祖,せんぞにまさる者,ものではありません」。","tok":[["自分","じぶん"],["は"],["一","いち"],["日","にち"],["の"],["道のり","みちのり"],["ほど"],["荒野","あら"],["のに"],["はいって"],["行って","いって"],["、"],["れだま"],["の"],["木","き"],["の"],["下","した"],["に"],["座し","ざし"],["、"],["自分","じぶん"],["の"],["死","し"],["を"],["求めて","もとめて"],["言った","いった"],["、"],["「"],["主","しゅ"],["よ"],["、"],["もはや"],["、"],["じゅうぶん"],["です"],["。"],["今","いま"],["わたし"],["の"],["命","いのち"],["を"],["取って","とって"],["ください"],["。"],["わたし"],["は"],["先祖","せんぞ"],["に"],["まさる"],["者","もの"],["で"],["は"],["ありません"],["」"],["。"]]},{"verse":5,"text":"彼,かれはれだまの木,きの下,したに伏,ふして眠,ねむったが、天,てんの使,つかいが彼,かれにさわり、「起,おきて食,たべなさい」と言,いったので、","tok":[["彼","かれ"],["は"],["れだま"],["の"],["木","き"],["の"],["下","した"],["に"],["伏して","ふして"],["眠った","ねむった"],["が"],["、"],["天","てん"],["の"],["使","つかい"],["が"],["彼","かれ"],["に"],["さわり"],["、"],["「"],["起きて","おきて"],["食べ","たべ"],["なさい"],["」"],["と"],["言った","いった"],["ので"],["、"]]},{"verse":6,"text":"起,おきて見,みると、頭,とうのそばに、焼,やけ石,いしの上,うえで焼,やいたパン一個,こと、一びんの水,みずがあった。彼,かれは食,たべ、かつ飲,のんでまた寝,ねた。","tok":[["起きて","おきて"],["見る","みる"],["と"],["、"],["頭","とう"],["の"],["そば"],["に"],["、"],["焼石","やけいし"],["の"],["上","うえ"],["で"],["焼いた","やいた"],["パン"],["一個","こ"],["と"],["、"],["一","いち"],["びん"],["の"],["水","みず"],["が"],["あった"],["。"],["彼","かれ"],["は"],["食べ","たべ"],["、"],["かつ"],["飲んで","のんで"],["また"],["寝た","ねた"],["。"]]},{"verse":7,"text":"主,しゅの使,つかいは再,ふたたびきて、彼,かれにさわって言,いった、「起,おきて食,たべなさい。道,みちが遠,とおくて耐,たえられないでしょうから」。","tok":[["主","しゅ"],["の"],["使い","つかい"],["は"],["再び","ふたたび"],["きて"],["、"],["彼","かれ"],["に"],["さわって"],["言った","いった"],["、"],["「"],["起きて","おきて"],["食べ","たべ"],["なさい"],["。"],["道","みち"],["が"],["遠くて","とおくて"],["耐えられないでしょう","たえられないでしょう"],["から"],["」"],["。"]]},{"verse":8,"text":"彼,かれは起,おきて食,たべ、かつ飲,のみ、その食物,しょくもつで力,ちからづいて四十日,にち四十夜,や行,いって、神,かみの山,やまホレブに着,ついた。","tok":[["彼","かれ"],["は"],["起きて","おきて"],["食べ","たべ"],["、"],["かつ"],["飲み","のみ"],["、"],["その"],["食物","しょくもつ"],["で"],["力","ちから"],["づいて"],["四十日","に"],["ち"],["四十","よんじゅう"],["夜行","夜い"],["って"],["、"],["神","かみ"],["の"],["山","やま"],["ホレブ"],["に"],["着いた","ついた"],["。"]]},{"verse":9,"text":"その所,ところで彼,かれはほら穴,あなにはいって、そこに宿,やどったが、主,しゅの言葉,ことばが彼,かれに臨,のぞんで、彼,かれに言,いわれた、「エリヤよ、あなたはここで何,なにをしているのか」。","tok":[["その"],["所","ところ"],["で"],["彼","かれ"],["は"],["ほら穴","ほらあな"],["に"],["はいって"],["、"],["そこ"],["に"],["宿った","やどった"],["が"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["が"],["彼","かれ"],["に"],["臨んで","のぞんで"],["、"],["彼","かれ"],["に"],["言われた","いわれた"],["、"],["「"],["エリヤ"],["よ"],["、"],["あなた"],["は"],["ここ"],["で"],["何に","なに"],["を"],["して"],["いる"],["の"],["か"],["」"],["。"]]},{"verse":10,"text":"彼,かれは言,いった、「わたしは万軍,ばんぐんの神,かみ、主,しゅのために非常,ひじょうに熱心,ねっしんでありました。イスラエルの人々,ひとびとはあなたの契約,けいやくを捨,すて、あなたの祭壇,さいだんをこわし、刀,かたなをもってあなたの預言者,よげんしゃたちを殺,ころしたのです。ただわたしだけ残,のこりましたが、彼,かれらはわたしの命,いのちを取,とろうとしています」。","tok":[["彼","かれ"],["は"],["言った","いった"],["、"],["「"],["わたし"],["は"],["万","まん"],["軍","ぐん"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["ため"],["に"],["非常","ひじょう"],["に"],["熱心","ねっしん"],["で"],["ありました"],["。"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["あなた"],["の"],["契約","けいやく"],["を"],["捨て","すて"],["、"],["あなた"],["の"],["祭壇","さいだん"],["を"],["こわし"],["、"],["刀","かたな"],["を"],["もって"],["あなた"],["の"],["預言者","よげんしゃ"],["たち"],["を"],["殺ろした","ころした"],["の"],["です"],["。"],["ただ"],["わたし"],["だけ"],["残りました","のこりました"],["が"],["、"],["彼","かれ"],["ら"],["は"],["わたし"],["の"],["命","いのち"],["を"],["取ろう","とろう"],["として"],["います"],["」"],["。"]]},{"verse":11,"text":"主,しゅは言,いわれた、「出,でて、山,やまの上,うえで主,しゅの前,まえに、立,たちなさい」。その時,とき主,しゅは通,とおり過,すぎられ、主,しゅの前,まえに大,おおきな強,つよい風,かぜが吹,ふき、山,やまを裂,さき、岩,いわを砕,くだいた。しかし主,しゅは風,かぜの中,なかにおられなかった。風,かぜの後,のちに地震,じしんがあったが、地震,じしんの中,なかにも主,しゅはおられなかった。","tok":[["主","しゅ"],["は"],["言われた","いわれた"],["、"],["「"],["出て","でて"],["、"],["山","やま"],["の"],["上","うえ"],["で"],["主","しゅ"],["の"],["前","まえ"],["に"],["、"],["立","たち"],["なさい"],["」"],["。"],["その"],["時","とき"],["主","しゅ"],["は"],["通り過ぎられ","とおりすぎられ"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["大きな","おおきな"],["強い","つよい"],["風","かぜ"],["が"],["吹","ふき"],["、"],["山","やま"],["を"],["裂き","さき"],["、"],["岩","いわ"],["を"],["砕いた","くだいた"],["。"],["しかし"],["主","しゅ"],["は"],["風","かぜ"],["の"],["中","なか"],["に"],["おられなかった"],["。"],["風","かぜ"],["の"],["後","のち"],["に"],["地震","じしん"],["が"],["あった"],["が"],["、"],["地震","じしん"],["の"],["中","なか"],["に"],["も"],["主","しゅ"],["は"],["おられなかった"],["。"]]},{"verse":12,"text":"地震,じしんの後,のちに火,ひがあったが、火,ひの中,なかにも主,しゅはおられなかった。火,ひの後,のちに静,しずかな細,ほそい声,こえが聞,きこえた。","tok":[["地震","じしん"],["の"],["後","のち"],["に"],["火","ひ"],["が"],["あった"],["が"],["、"],["火","ひ"],["の"],["中","なか"],["に"],["も"],["主","しゅ"],["は"],["おられなかった"],["。"],["火","ひ"],["の"],["後","のち"],["に"],["静","しずか"],["な"],["細い","ほそい"],["声","こえ"],["が"],["聞こえた","きこえた"],["。"]]},{"verse":13,"text":"エリヤはそれを聞,きいて顔,かおを外套,がいとうに包,つつみ、出,でてほら穴,あなの口,くちに立,たつと、彼,かれに語,かたる声,こえが聞,きこえた、「エリヤよ、あなたはここで何,なにをしているのか」。","tok":[["エリヤ"],["は"],["それ"],["を"],["聞いて","きいて"],["顔","かお"],["を"],["外套","がいとう"],["に"],["包","つつみ"],["、"],["出て","でて"],["ほら穴","ほらあな"],["の"],["口","くち"],["に"],["立つ","たつ"],["と"],["、"],["彼","かれ"],["に"],["語る","かたる"],["声","こえ"],["が"],["聞こえた","きこえた"],["、"],["「"],["エリヤ"],["よ"],["、"],["あなた"],["は"],["ここ"],["で"],["何に","なに"],["を"],["して"],["いる"],["の"],["か"],["」"],["。"]]},{"verse":14,"text":"彼,かれは言,いった、「わたしは万軍,ばんぐんの神,かみ、主,しゅのために非常,ひじょうに熱心,ねっしんでありました。イスラエルの人々,ひとびとはあなたの契約,けいやくを捨,すて、あなたの祭壇,さいだんをこわし、刀,かたなであなたの預言者,よげんしゃたちを殺,ころしたからです。ただわたしだけ残,のこりましたが、彼,かれらはわたしの命,いのちを取,とろうとしています」。","tok":[["彼","かれ"],["は"],["言った","いった"],["、"],["「"],["わたし"],["は"],["万","まん"],["軍","ぐん"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["ため"],["に"],["非常","ひじょう"],["に"],["熱心","ねっしん"],["で"],["ありました"],["。"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["あなた"],["の"],["契約","けいやく"],["を"],["捨て","すて"],["、"],["あなた"],["の"],["祭壇","さいだん"],["を"],["こわし"],["、"],["刀","かたな"],["で"],["あなた"],["の"],["預言者","よげんしゃ"],["たち"],["を"],["殺ろした","ころした"],["から"],["です"],["。"],["ただ"],["わたし"],["だけ"],["残りました","のこりました"],["が"],["、"],["彼","かれ"],["ら"],["は"],["わたし"],["の"],["命","いのち"],["を"],["取ろう","とろう"],["として"],["います"],["」"],["。"]]},{"verse":15,"text":"主,しゅは彼,かれに言,いわれた、「あなたの道,みちを帰,かえって行,いって、ダマスコの荒野,あらのにおもむき、ダマスコに着,ついて、ハザエルに油,あぶらを注,そそぎ、スリヤの王,おうとしなさい。","tok":[["主","しゅ"],["は"],["彼","かれ"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["の"],["道","みち"],["を"],["帰えって","かえって"],["行って","いって"],["、"],["ダマスコ"],["の"],["荒野","あらの"],["に"],["おもむき"],["、"],["ダマスコ"],["に"],["着いて","ついて"],["、"],["ハザエル"],["に"],["油","あぶら"],["を"],["注ぎ","そそぎ"],["、"],["スリヤ"],["の"],["王","おう"],["と"],["し"],["なさい"],["。"]]},{"verse":16,"text":"またニムシの子,こエヒウに油,あぶらを注,そそいでイスラエルの王,おうとしなさい。またアベルメホラのシャパテの子,こエリシャに油,あぶらを注,そそいで、あなたに代,かわって預言者,よげんしゃとしなさい。","tok":[["また"],["ニムシ"],["の"],["子","こ"],["エヒウ"],["に"],["油","あぶら"],["を"],["注いで","そそいで"],["イスラエル"],["の"],["王","おう"],["と"],["し"],["なさい"],["。"],["また"],["アベルメホラ"],["の"],["シャパテ"],["の"],["子","こ"],["エリシャ"],["に"],["油","あぶら"],["を"],["注いで","そそいで"],["、"],["あなた"],["に"],["代わって","かわって"],["預言者","よげんしゃ"],["と"],["し"],["なさい"],["。"]]},{"verse":17,"text":"ハザエルのつるぎをのがれる者,ものをエヒウが殺,ころし、エヒウのつるぎをのがれる者,ものをエリシャが殺,ころすであろう。","tok":[["ハザエル"],["の"],["つるぎ"],["を"],["のがれる"],["者","もの"],["を"],["エヒウ"],["が"],["殺ろし","ころし"],["、"],["エヒウ"],["の"],["つるぎ"],["を"],["のがれる"],["者","もの"],["を"],["エリシャ"],["が"],["殺ろすで","ころすで"],["あろう"],["。"]]},{"verse":18,"text":"また、わたしはイスラエルのうちに七千人,にんを残,のこすであろう。皆,みなバアルにひざをかがめず、それに口,くちづけしない者,ものである」。","tok":[["また"],["、"],["わたし"],["は"],["イスラエル"],["の"],["うち"],["に"],["七千人","にん"],["を"],["残すで","のこすで"],["あろう"],["。"],["皆","みな"],["バアル"],["に"],["ひざ"],["を"],["かがめず"],["、"],["それ"],["に"],["口づけ","くちづけ"],["しない"],["者","もの"],["で"],["ある"],["」"],["。"]]},{"verse":19,"text":"さてエリヤはそこを去,さって行,いって、シャパテの子,こエリシャに会,あった。彼,かれは十二くびきの牛,うしを前,まえに行,いかせ、自分,じぶんは十二番目,ばんめのくびきと共,ともにいて耕,たがやしていた。エリヤは彼,かれのかたわらを通,とおり過,すぎて外套,がいとうを彼,かれの上,うえにかけた。","tok":[["さて"],["エリヤ"],["は"],["そこ"],["を"],["去て","さって"],["行って","いって"],["、"],["シャパテ"],["の"],["子","こ"],["エリシャ"],["に"],["会った","あった"],["。"],["彼","かれ"],["は"],["十二","じゅうに"],["くびき"],["の"],["牛","うし"],["を"],["前","まえ"],["に"],["行かせ","いかせ"],["、"],["自分","じぶん"],["は"],["十二番目","ばんめ"],["の"],["くびき"],["と"],["共","とも"],["に"],["いて"],["耕やして","たがやして"],["いた"],["。"],["エリヤ"],["は"],["彼","かれ"],["の"],["かたわら"],["を"],["通り","とおり"],["過て","すぎて"],["外套","がいとう"],["を"],["彼","かれ"],["の"],["上","うえ"],["に"],["かけた"],["。"]]},{"verse":20,"text":"エリシャは牛,うしを捨,すて、エリヤのあとに走,はしってきて言,いった、「わたしの父母,ふぼに口,くちづけさせてください。そして後,のちあなたに従,したがいましょう」。エリヤは彼,かれに言,いった、「行,いってきなさい。わたしはあなたに何,なにをしましたか」。","tok":[["エリシャ"],["は"],["牛","うし"],["を"],["捨て","すて"],["、"],["エリヤ"],["の"],["あと"],["に"],["走って","はしって"],["きて"],["言った","いった"],["、"],["「"],["わたし"],["の"],["父母","ふぼ"],["に"],["口づけ","くちづけ"],["させて"],["ください"],["。"],["そして"],["後","のちあなた"],["に"],["従いましょう","したがいましょう"],["」"],["。"],["エリヤ"],["は"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["行って","いって"],["き"],["なさい"],["。"],["わたし"],["は"],["あなた"],["に"],["何に","なに"],["を"],["しました"],["か"],["」"],["。"]]},{"verse":21,"text":"エリシャは彼,かれを離,はなれて帰,かえり、ひとくびきの牛,うしを取,とって殺,ころし、牛,うしのくびきを燃,もやしてその肉,にくを煮,に、それを民,たみに与,あたえて食,たべさせ、立,たって行,いってエリヤに従,したがい、彼,かれに仕,つかえた。","tok":[["エリシャ"],["は"],["彼","かれ"],["を"],["離れて","はなれて"],["帰えり","かえり"],["、"],["ひと"],["くびき"],["の"],["牛","うし"],["を"],["取って","とって"],["殺ろし","ころし"],["、"],["牛","うし"],["の"],["くびき"],["を"],["燃やして","もやして"],["その"],["肉","にく"],["を"],["煮","に"],["、"],["それ"],["を"],["民","たみ"],["に"],["与","あたえ"],["て"],["食べさせ","たべさせ"],["、"],["立って","たって"],["行って","いって"],["エリヤ"],["に"],["従い","したがい"],["、"],["彼","かれ"],["に"],["仕えた","つかえた"],["。"]]}]
[{"verse":1,"text":"多,おおくの日,ひを経,へて、三年,ねん目,めに主,しゅの言葉,ことばがエリヤに臨,のぞんだ、「行,いって、あなたの身,みをアハブに示,しめしなさい。わたしは雨,あめを地,ちに降,ふらせる」。","tok":[["多く","おおく"],["の"],["日","ひ"],["を"],["経て","へて"],["、"],["三","さん"],["年目","年め"],["に"],["主","しゅ"],["の"],["言葉","ことば"],["が"],["エリヤ"],["に"],["臨んだ","のぞんだ"],["、"],["「"],["行って","いって"],["、"],["あなた"],["の"],["身","み"],["を"],["アハブ"],["に"],["示めし","しめし"],["なさい"],["。"],["わたし"],["は"],["雨","あめ"],["を"],["地","ち"],["に"],["降らせる","ふらせる"],["」"],["。"]]},{"verse":2,"text":"エリヤはその身,みをアハブに示,しめそうとして行,いった。その時,とき、サマリヤにききんが激,はげしかった。","tok":[["エリヤ"],["は"],["その"],["身","み"],["を"],["アハブ"],["に"],["示めそう","しめそう"],["として"],["行った","いった"],["。"],["その"],["時","とき"],["、"],["サマリヤ"],["に"],["ききん"],["が"],["激しかった","はげしかった"],["。"]]},{"verse":3,"text":"アハブは家,いえづかさオバデヤを召,めした。（オバデヤは深,ふかく主,しゅを恐,おそれる人,ひとで、","tok":[["アハブ"],["は"],["家","いえ"],["づかさ"],["オバデヤ"],["を"],["召","めし"],["た"],["。"],["（"],["オバデヤ"],["は"],["深く","ふかく"],["主","しゅ"],["を"],["恐れる","おそれる"],["人","ひと"],["で"],["、"]]},{"verse":4,"text":"イゼベルが主,しゅの預言者,よげんしゃを断,たち滅,ほろぼした時,とき、オバデヤは百人,にんの預言者,よげんしゃを救,すくい出,だして五十人,にんずつほら穴,あなに隠,かくし、パンと水,みずをもって彼,かれらを養,やしなった）。","tok":[["イゼベル"],["が"],["主","しゅ"],["の"],["預言者","よげんしゃ"],["を"],["断ち","たち"],["滅ぼした","ほろぼした"],["時","とき"],["、"],["オバデヤ"],["は"],["百人","にん"],["の"],["預言者","よげんしゃ"],["を"],["救い出して","すくいだして"],["五","ご"],["十人","じゅうにん"],["ら"],["穴","あな"],["に"],["隠し","かくし"],["、"],["パン"],["と"],["水","みず"],["を"],["もって"],["彼","かれ"],["ら"],["を"],["養った","やしなった"],["）"],["。"]]},{"verse":5,"text":"アハブはオバデヤに言,いった、「国中,くにぢゅうのすべての水,みずの源,みなもとと、すべての川,かわに行,いってみるがよい。馬,うまと騾馬,らばを生,いかしておくための草,くさがあるかもしれない。そうすれば、われわれは家畜,かちくをいくぶんでも失,うしなわずにすむであろう」。","tok":[["アハブ"],["は"],["オバデヤ"],["に"],["言った","いった"],["、"],["「"],["国中","く"],["に"],["ぢゅう"],["の"],["すべて"],["の"],["水","みず"],["の"],["源","みなもと"],["と"],["、"],["すべて"],["の"],["川","かわ"],["に"],["行って","いって"],["みる"],["が"],["よい"],["。"],["馬","うま"],["と"],["騾馬","らば"],["を"],["生かして","いかして"],["おく"],["ため"],["の"],["草","くさ"],["が"],["ある"],["か"],["も"],["しれない"],["。"],["そう"],["すれば"],["、"],["われわれ"],["は"],["家畜","かちく"],["を"],["いく"],["ぶん"],["で"],["も"],["失なわず","うしなわず"],["に"],["すむで"],["あろう"],["」"],["。"]]},{"verse":6,"text":"彼,かれらは行,いき巡,めぐる地,ちをふたりで分,わけ、アハブはひとりでこの道,みちを行,いき、オバデヤはひとりで他,たの道,みちを行,おこなった。","tok":[["彼","かれ"],["ら"],["は"],["行き","いき"],["巡る","めぐる"],["地","ち"],["を"],["ふたり"],["で"],["分け","わけ"],["、"],["アハブ"],["は"],["ひとり"],["で"],["この"],["道","みち"],["を"],["行き","いき"],["、"],["オバデヤ"],["は"],["ひとり"],["で"],["他","た"],["の"],["道","みち"],["を"],["行なった","おこなった"],["。"]]},{"verse":7,"text":"オバデヤが道,みちを進,すすんでいた時,とき、エリヤが彼,かれに会,あった。彼,かれはエリヤを認,みとめて伏,ふして言,いった、「わが主,しゅエリヤよ、あなたはここにおられるのですか」。","tok":[["オバデヤ"],["が"],["道","みち"],["を"],["進んで","すすんで"],["いた"],["時","とき"],["、"],["エリヤ"],["が"],["彼","かれ"],["に"],["会った","あった"],["。"],["彼","かれ"],["は"],["エリヤ"],["を"],["認めて","みとめて"],["伏して","ふして"],["言った","いった"],["、"],["「"],["わが"],["主","しゅ"],["エリヤ"],["よ"],["、"],["あなた"],["は"],["ここ"],["に"],["おられる"],["の"],["です"],["か"],["」"],["。"]]},{"verse":8,"text":"エリヤは彼,かれに言,いった、「そうです。行,いって、あなたの主人,しゅじんに、エリヤはここにいると告,つげなさい」。","tok":[["エリヤ"],["は"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["そう"],["です"],["。"],["行って","いって"],["、"],["あなた"],["の"],["主人","しゅじん"],["に"],["、"],["エリヤ"],["は"],["ここ"],["に"],["いる"],["と"],["告","つげ"],["なさい"],["」"],["。"]]},{"verse":9,"text":"彼,かれは言,いった、「わたしにどんな罪,つみがあって、あなたはしもべをアハブの手,てにわたして殺,ころそうとされるのですか。","tok":[["彼","かれ"],["は"],["言った","いった"],["、"],["「"],["わたし"],["に"],["どんな"],["罪","つみ"],["が"],["あって"],["、"],["あなた"],["は"],["しもべ"],["を"],["アハブ"],["の"],["手","て"],["に"],["わたして"],["殺そう","ころそう"],["と"],["される"],["の"],["です"],["か"],["。"]]},{"verse":10,"text":"あなたの神,かみ、主,しゅは生,いきておられます。わたしの主人,しゅじんがあなたを尋,たずねるために、人,ひとをつかわさない民,たみはなく、国,くにもありません。そしてエリヤはいないと言,いう時,ときは、その国,くに、その民,たみに、あなたが見,みつからないという誓,ちかいをさせるのです。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["生きて","いきて"],["おられます"],["。"],["わたし"],["の"],["主人","しゅじん"],["が"],["あなた"],["を"],["尋ねる","たずねる"],["ため"],["に"],["、"],["人","ひと"],["を"],["つかわさない"],["民","たみ"],["は"],["なく"],["、"],["国","くに"],["も"],["ありません"],["。"],["そして"],["エリヤ"],["は"],["いない"],["と"],["言う","いう"],["時","とき"],["は"],["、"],["その"],["国","くに"],["、"],["その"],["民","たみ"],["に"],["、"],["あなた"],["が"],["見つからない","みつからない"],["と"],["いう"],["誓い","ちかい"],["を"],["させる"],["の"],["です"],["。"]]},{"verse":11,"text":"あなたは今,いま『行,いって、エリヤはここにいると主人,しゅじんに告,つげよ』と言,いわれます。","tok":[["あなた"],["は"],["今","いま"],["『"],["行って","いって"],["、"],["エリヤ"],["は"],["ここ"],["に"],["いる"],["と"],["主人","しゅじん"],["に"],["告","つげ"],["よ"],["』"],["と"],["言われます","いわれます"],["。"]]},{"verse":12,"text":"しかしわたしがあなたを離,はなれて行,いくと、主,しゅの霊,れいはあなたを、わたしの知,しらない所,ところへ連,つれて行,いくでしょう。わたしが行,いってアハブに告,つげ、彼,かれがあなたを見,みつけることができなければ、彼,かれはわたしを殺,ころすでしょう。しかし、しもべは幼,おさない時,ときから主,しゅを恐,おそれている者,ものです。","tok":[["しかし"],["わたし"],["が"],["あなた"],["を"],["離れて","はなれて"],["行く","いく"],["と"],["、"],["主","しゅ"],["の"],["霊","れい"],["は"],["あなた"],["を"],["、"],["わたし"],["の"],["知らない","しらない"],["所","ところ"],["へ"],["連れて","つれて"],["行くでしょう","いくでしょう"],["。"],["わたし"],["が"],["行って","いって"],["アハブ"],["に"],["告","つげ"],["、"],["彼","かれ"],["が"],["あなた"],["を"],["見つける","みつける"],["こと"],["が"],["できなければ"],["、"],["彼","かれ"],["は"],["わたし"],["を"],["殺ろすでしょう","ころすでしょう"],["。"],["しかし"],["、"],["しもべ"],["は"],["幼ない","おさない"],["時","とき"],["から"],["主","しゅ"],["を"],["恐れて","おそれて"],["いる"],["者","もの"],["です"],["。"]]},{"verse":13,"text":"イゼベルが主,しゅの預言者,よげんしゃを殺,ころした時,ときに、わたしがした事,こと、すなわち、わたしが主,しゅの預言者,よげんしゃのうち百人,にんを五十人,にんずつほら穴,あなに隠,かくして、パンと水,みずをもって養,やしなった事,ことを、わが主,しゅは聞,きかれませんでしたか。","tok":[["イゼベル"],["が"],["主","しゅ"],["の"],["預言者","よげんしゃ"],["を"],["殺ろした","ころした"],["時","とき"],["に"],["、"],["わたし"],["が"],["した"],["事","こと"],["、"],["すなわち"],["、"],["わたし"],["が"],["主","しゅ"],["の"],["預言者","よげんしゃ"],["の"],["うち"],["百人","にん"],["を"],["五","ご"],["十人","じゅうにん"],["ら"],["穴","あな"],["に"],["隠して","かくして"],["、"],["パン"],["と"],["水","みず"],["を"],["もって"],["養った","やしなった"],["事","こと"],["を"],["、"],["わが"],["主","しゅ"],["は"],["聞かれませんでした","きかれませんでした"],["か"],["。"]]},{"verse":14,"text":"ところが今,いまあなたは『行,いって、エリヤはここにいると主人,しゅじんに告,つげよ』と言,いわれます。そのようなことをすれば彼,かれはわたしを殺,ころすでしょう」。","tok":[["ところ"],["が"],["今","いま"],["あなた"],["は"],["『"],["行って","いって"],["、"],["エリヤ"],["は"],["ここ"],["に"],["いる"],["と"],["主人","しゅじん"],["に"],["告","つげ"],["よ"],["』"],["と"],["言われます","いわれます"],["。"],["その"],["よう"],["な"],["こと"],["を"],["すれば"],["彼","かれ"],["は"],["わたし"],["を"],["殺ろすでしょう","ころすでしょう"],["」"],["。"]]},{"verse":15,"text":"エリヤは言,いった、「わたしの仕,つかえる万軍,ばんぐんの主,しゅは生,いきておられる。わたしは必,かならず、きょう、わたしの身,みを彼,かれに示,しめすであろう」。","tok":[["エリヤ"],["は"],["言った","いった"],["、"],["「"],["わたし"],["の"],["仕える","つかえる"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["生きて","いきて"],["おられる"],["。"],["わたし"],["は"],["必","かならず"],["、"],["きょう"],["、"],["わたし"],["の"],["身","み"],["を"],["彼","かれ"],["に"],["示めすで","しめすで"],["あろう"],["」"],["。"]]},{"verse":16,"text":"オバデヤは行,いってアハブに会,あい、彼,かれに告,つげたので、アハブはエリヤに会,あおうとして行,いった。","tok":[["オバデヤ"],["は"],["行って","いって"],["アハブ"],["に"],["会い","あい"],["、"],["彼","かれ"],["に"],["告","つげ"],["た"],["ので"],["、"],["アハブ"],["は"],["エリヤ"],["に"],["会おう","あおう"],["として"],["行った","いった"],["。"]]},{"verse":17,"text":"アハブはエリヤを見,みたとき、彼,かれに言,いった、「イスラエルを悩,なやます者,ものよ、あなたはここにいるのですか」。","tok":[["アハブ"],["は"],["エリヤ"],["を"],["見た","みた"],["とき"],["、"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["イスラエル"],["を"],["悩す","なやます"],["者","もの"],["よ"],["、"],["あなた"],["は"],["ここ"],["に"],["いる"],["の"],["です"],["か"],["」"],["。"]]},{"verse":18,"text":"彼,かれは答,こたえた、「わたしがイスラエルを悩,なやますのではありません。あなたと、あなたの父,ちちの家,いえが悩,なやましたのです。あなたがたが主,しゅの命令,めいれいを捨,すて、バアルに従,したがったためです。","tok":[["彼","かれ"],["は"],["答","こたえ"],["た"],["、"],["「"],["わたし"],["が"],["イスラエル"],["を"],["悩す","なやます"],["ので"],["は"],["ありません"],["。"],["あなた"],["と"],["、"],["あなた"],["の"],["父","ちち"],["の"],["家","いえ"],["が"],["悩した","なやました"],["の"],["です"],["。"],["あなた"],["がた"],["が"],["主","しゅ"],["の"],["命令","めいれい"],["を"],["捨て","すて"],["、"],["バアル"],["に"],["従った","したがった"],["ため"],["です"],["。"]]},{"verse":19,"text":"それで今,いま、人,ひとをつかわしてイスラエルのすべての人,ひとおよびバアルの預言者,よげんしゃ四百五十人,にん、ならびにアシラの預言者,よげんしゃ四百人,にん、イゼベルの食卓,しょくたくで食事,しょくじする者,ものたちをカルメル山,やまに集,あつめて、わたしの所,ところにこさせなさい」。","tok":[["それ"],["で"],["今","いま"],["、"],["人","ひと"],["を"],["つかわして"],["イスラエル"],["の"],["すべて"],["の"],["人","ひと"],["および"],["バアル"],["の"],["預言者","よげんしゃ"],["四百五","よんひゃくご"],["十人","じゅうにん"],["、"],["ならびに"],["アシラ"],["の"],["預言者","よげんしゃ"],["四百人","にん"],["、"],["イゼベル"],["の"],["食卓","しょくたく"],["で"],["食事","しょくじ"],["する"],["者","もの"],["たち"],["を"],["カルメル"],["山","やま"],["に"],["集めて","あつめて"],["、"],["わたし"],["の"],["所","ところ"],["に"],["こさせ"],["なさい"],["」"],["。"]]},{"verse":20,"text":"そこでアハブはイスラエルのすべての人,ひとに人,ひとをつかわして、預言者,よげんしゃたちをカルメル山,やまに集,あつめた。","tok":[["そこ"],["で"],["アハブ"],["は"],["イスラエル"],["の"],["すべて"],["の"],["人","ひと"],["に"],["人","ひと"],["を"],["つかわして"],["、"],["預言者","よげんしゃ"],["たち"],["を"],["カルメル"],["山","やま"],["に"],["集めた","あつめた"],["。"]]},{"verse":21,"text":"そのときエリヤはすべての民,たみに近,ちかづいて言,いった、「あなたがたはいつまで二つのものの間,あいだに迷,まよっているのですか。主,しゅが神,かみならばそれに従,したがいなさい。しかしバアルが神,かみならば、それに従,したがいなさい」。民,たみはひと言,ことも彼,かれに答,こたえなかった。","tok":[["その"],["とき"],["エリヤ"],["は"],["すべて"],["の"],["民","たみ"],["に"],["近づいて","ちかづいて"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["いつ"],["まで"],["二","ふた"],["つ"],["の"],["もの"],["の"],["間","あいだ"],["に"],["迷って","まよって"],["いる"],["の"],["です"],["か"],["。"],["主","しゅ"],["が"],["神","かみ"],["ならば"],["それ"],["に"],["従い","したがい"],["なさい"],["。"],["しかし"],["バアル"],["が"],["神","かみ"],["ならば"],["、"],["それ"],["に"],["従い","したがい"],["なさい"],["」"],["。"],["民","たみ"],["は"],["ひと言","ひとこと"],["も"],["彼","かれ"],["に"],["答","こたえ"],["なかった"],["。"]]},{"verse":22,"text":"エリヤは民,たみに言,いった、「わたしはただひとり残,のこった主,しゅの預言者,よげんしゃです。しかしバアルの預言者,よげんしゃは四百五十人,にんあります。","tok":[["エリヤ"],["は"],["民","たみ"],["に"],["言った","いった"],["、"],["「"],["わたし"],["は"],["ただ"],["ひとり"],["残った","のこった"],["主","しゅ"],["の"],["預言者","よげんしゃ"],["です"],["。"],["しかし"],["バアル"],["の"],["預言者","よげんしゃ"],["は"],["四百五","よんひゃくご"],["十人","じゅうにん"],["あります"],["。"]]},{"verse":23,"text":"われわれに二頭,とうの牛,うしをください。そして一頭,とうの牛,うしを彼,かれらに選,えらばせ、それを切,きり裂,さいて、たきぎの上,うえに載,のせ、それに火,ひをつけずにおかせなさい。わたしも一頭,とうの牛,うしを整,ととのえ、それをたきぎの上,うえに載,のせて火,ひをつけずにおきましょう。","tok":[["われわれ"],["に"],["二頭","とう"],["の"],["牛","うし"],["を"],["ください"],["。"],["そして"],["一頭","とう"],["の"],["牛","うし"],["を"],["彼","かれ"],["ら"],["に"],["選ばせ","えらばせ"],["、"],["それ"],["を"],["切り裂いて","きりさいて"],["、"],["たきぎ"],["の"],["上","うえ"],["に"],["載せ","のせ"],["、"],["それ"],["に"],["火","ひ"],["を"],["つけず"],["に"],["おかせ"],["なさい"],["。"],["わたし"],["も"],["一頭","とう"],["の"],["牛","うし"],["を"],["整え","ととのえ"],["、"],["それ"],["を"],["たきぎ"],["の"],["上","うえ"],["に"],["載せて","のせて"],["火","ひ"],["を"],["つけず"],["に"],["おきましょう"],["。"]]},{"verse":24,"text":"こうしてあなたがたはあなたがたの神,かみの名,なを呼,よびなさい。わたしは主,しゅの名,なを呼,よびましょう。そして火,ひをもって答,こたえる神,かみを神,かみとしましょう」。民,たみは皆,みな答,こたえて「それがよかろう」と言,いった。","tok":[["こう"],["して"],["あなた"],["がた"],["は"],["あなた"],["がた"],["の"],["神","かみ"],["の"],["名","な"],["を"],["呼び","よび"],["なさい"],["。"],["わたし"],["は"],["主","しゅ"],["の"],["名","な"],["を"],["呼びましょう","よびましょう"],["。"],["そして"],["火","ひ"],["を"],["もって"],["答","こたえ"],["る"],["神","かみ"],["を"],["神","かみ"],["と"],["しましょう"],["」"],["。"],["民","たみ"],["は"],["皆","みな"],["答","こたえ"],["て"],["「"],["それ"],["が"],["よかろう"],["」"],["と"],["言った","いった"],["。"]]},{"verse":25,"text":"そこでエリヤはバアルの預言者,よげんしゃたちに言,いった、「あなたがたは大,だいぜいだから初,はじめに一頭,とうの牛,うしを選,えらんで、それを整,ととのえ、あなたがたの神,かみの名,なを呼,よびなさい。ただし火,ひをつけてはなりません」。","tok":[["そこ"],["で"],["エリヤ"],["は"],["バアル"],["の"],["預言者","よげんしゃ"],["たち"],["に"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["大ぜい","だいぜい"],["だ"],["から"],["初め","はじめ"],["に"],["一頭","とう"],["の"],["牛","うし"],["を"],["選らんで","えらんで"],["、"],["それ"],["を"],["整え","ととのえ"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["の"],["名","な"],["を"],["呼び","よび"],["なさい"],["。"],["ただし"],["火","ひ"],["を"],["つけて"],["は"],["なりません"],["」"],["。"]]},{"verse":26,"text":"彼,かれらは与,あたえられた牛,うしを取,とって整,ととのえ、朝,あさから昼,ひるまでバアルの名,なを呼,よんで「バアルよ、答,こたえてください」と言,いった。しかしなんの声,こえもなく、また答,こたえる者,ものもなかったので、彼,かれらは自分,じぶんたちの造,つくった祭壇,さいだんのまわりに踊,おどった。","tok":[["彼","かれ"],["ら"],["は"],["与えられた","あたえられた"],["牛","うし"],["を"],["取って","とって"],["整え","ととのえ"],["、"],["朝","あさ"],["から"],["昼","ひる"],["まで"],["バアル"],["の"],["名","な"],["を"],["呼んで","よんで"],["「"],["バアル"],["よ"],["、"],["答","こたえ"],["て"],["ください"],["」"],["と"],["言った","いった"],["。"],["しかし"],["なん"],["の"],["声","こえ"],["も"],["なく"],["、"],["また"],["答","こたえ"],["る"],["者","もの"],["も"],["なかった"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["自分","じぶん"],["たち"],["の"],["造った","つくった"],["祭壇","さいだん"],["の"],["まわり"],["に"],["踊った","おどった"],["。"]]},{"verse":27,"text":"昼,ひるになってエリヤは彼,かれらをあざけって言,いった、「彼,かれは神,かみだから、大声,おおごえをあげて呼,よびなさい。彼,かれは考,かんがえにふけっているのか、よそへ行,いったのか、旅,たびに出,でたのか、または眠,ねむっていて起,おこされなければならないのか」。","tok":[["昼","ひる"],["に"],["なって"],["エリヤ"],["は"],["彼","かれ"],["ら"],["を"],["あざけって"],["言った","いった"],["、"],["「"],["彼","かれ"],["は"],["神","かみ"],["だ"],["から"],["、"],["大声","おおごえ"],["を"],["あげて"],["呼び","よび"],["なさい"],["。"],["彼","かれ"],["は"],["考","かんがえ"],["に"],["ふけって"],["いる"],["の"],["か"],["、"],["よそ"],["へ"],["行った","いった"],["の"],["か"],["、"],["旅","たび"],["に"],["出た","でた"],["の"],["か"],["、"],["また"],["は"],["眠って","ねむって"],["いて"],["起こされなければ","おこされなければ"],["ならない"],["の"],["か"],["」"],["。"]]},{"verse":28,"text":"そこで彼,かれらは大声,おおごえに呼,よばわり、彼,かれらのならわしに従,したがって、刀,かたなとやりで身,みを傷,きずつけ、血,ちをその身,みに流,ながすに至,いたった。","tok":[["そこ"],["で"],["彼","かれ"],["ら"],["は"],["大声","おおごえ"],["に"],["呼ばわり","よばわり"],["、"],["彼","かれ"],["ら"],["の"],["ならわし"],["に"],["従って","したがって"],["、"],["刀","かたな"],["と"],["やりで"],["身","み"],["を"],["傷つけ","きずつけ"],["、"],["血","ち"],["を"],["その"],["身","み"],["に"],["流す","ながす"],["に"],["至った","いたった"],["。"]]},{"verse":29,"text":"こうして昼,ひるが過,すぎても彼,かれらはなお叫,さけび続,つづけて、夕,ゆうの供,そなえ物,ものをささげる時,ときにまで及,およんだ。しかしなんの声,こえもなく、答,こたえる者,ものもなく、また顧,かえりみる者,ものもなかった。","tok":[["こう"],["して"],["昼","ひる"],["が"],["過て","すぎて"],["も"],["彼","かれ"],["ら"],["は"],["なお"],["叫","さけび"],["続けて","つづけて"],["、"],["夕","ゆう"],["の"],["供え物","そなえもの"],["を"],["ささげる"],["時","とき"],["に"],["まで"],["及んだ","およんだ"],["。"],["しかし"],["なん"],["の"],["声","こえ"],["も"],["なく"],["、"],["答","こたえ"],["る"],["者","もの"],["も"],["なく"],["、"],["また"],["顧りみる","かえりみる"],["者","もの"],["も"],["なかった"],["。"]]},{"verse":30,"text":"その時,ときエリヤはすべての民,たみにむかって「わたしに近寄,ちかよりなさい」と言,いったので、民,たみは皆,みな彼,かれに近寄,ちかよった。彼,かれはこわれている主,しゅの祭壇,さいだんを繕,つくろった。","tok":[["その"],["時","とき"],["エリヤ"],["は"],["すべて"],["の"],["民","たみ"],["に"],["むかって"],["「"],["わたし"],["に"],["近寄り","ちかより"],["なさい"],["」"],["と"],["言った","いった"],["ので"],["、"],["民","たみ"],["は"],["皆","みな"],["彼","かれ"],["に"],["近寄った","ちかよった"],["。"],["彼","かれ"],["は"],["こわれて"],["いる"],["主","しゅ"],["の"],["祭壇","さいだん"],["を"],["繕った","つくろった"],["。"]]},{"verse":31,"text":"そしてエリヤは昔,むかし、主,しゅの言葉,ことばがヤコブに臨,のぞんで、「イスラエルをあなたの名,なとせよ」と言,いわれたヤコブの子,こらの部族,ぶぞくの数,かずにしたがって十二の石,いしを取,とり、","tok":[["そして"],["エリヤ"],["は"],["昔","むかし"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["が"],["ヤコブ"],["に"],["臨んで","のぞんで"],["、"],["「"],["イスラエル"],["を"],["あなた"],["の"],["名","な"],["と"],["せよ"],["」"],["と"],["言われた","いわれた"],["ヤコブ"],["の"],["子","こ"],["ら"],["の"],["部族","ぶぞく"],["の"],["数","かず"],["に"],["したがって"],["十二","じゅうに"],["の"],["石","いし"],["を"],["取","とり"],["、"]]},{"verse":32,"text":"その石,いしで主,しゅの名,なによって祭壇,さいだんを築,きずき、祭壇,さいだんの周囲,しゅういに種,たね二セヤをいれるほどの大,おおきさの、みぞを作,つくった。","tok":[["その"],["石","いし"],["で"],["主","しゅ"],["の"],["名","な"],["によって"],["祭壇","さいだん"],["を"],["築き","きずき"],["、"],["祭壇","さいだん"],["の"],["周囲","しゅうい"],["に"],["種","た"],["ね"],["二","に"],["セヤ"],["を"],["いれる"],["ほど"],["の"],["大きさ","おおきさ"],["の"],["、"],["みぞ"],["を"],["作った","つくった"],["。"]]},{"verse":33,"text":"また、たきぎを並,ならべ、牛,うしを切,きり裂,さいてたきぎの上,うえに載,のせて言,いった、「四つのかめに水,みずを満,みたし、それを燔祭,はんさいとたきぎの上,うえに注,そそげ」。","tok":[["また"],["、"],["たきぎ"],["を"],["並べ","ならべ"],["、"],["牛","うし"],["を"],["切り裂いて","きりさいて"],["たきぎ"],["の"],["上","うえ"],["に"],["載せて","のせて"],["言った","いった"],["、"],["「"],["四","よん"],["つ"],["の"],["かめ"],["に"],["水","みず"],["を"],["満たし","みたし"],["、"],["それ"],["を"],["燔祭","はんさい"],["と"],["たきぎ"],["の"],["上","うえ"],["に"],["注げ","そそげ"],["」"],["。"]]},{"verse":34,"text":"また言,いった、「それを二度,どせよ」。二度,どそれをすると、また言,いった、「三度,どそれをせよ」。三度,どそれをした。","tok":[["また"],["言った","いった"],["、"],["「"],["それ"],["を"],["二","に"],["度","ど"],["せよ"],["」"],["。"],["二","に"],["度","ど"],["を"],["する"],["と"],["、"],["また"],["言った","いった"],["、"],["「"],["三","さん"],["度","ど"],["を"],["せよ"],["」"],["。"],["三","さん"],["度","ど"],["を"],["した"],["。"]]},{"verse":35,"text":"水,みずは祭壇,さいだんの周囲,しゅういに流,ながれた。またみぞにも水,みずを満,みたした。","tok":[["水","みず"],["は"],["祭壇","さいだん"],["の"],["周囲","しゅうい"],["に"],["流れた","ながれた"],["。"],["また"],["みぞ"],["に"],["も"],["水","みず"],["を"],["満たした","みたした"],["。"]]},{"verse":36,"text":"夕,ゆうの供,そなえ物,ものをささげる時,ときになって、預言者,よげんしゃエリヤは近寄,ちかよって言,いった、「アブラハム、イサク、ヤコブの神,かみ、主,しゅよ、イスラエルでは、あなたが神,かみであること、わたしがあなたのしもべであって、あなたの言葉,ことばに従,したがってこのすべての事,ことを行,おこなったことを、今日,こんにち知,しらせてください。","tok":[["夕","ゆう"],["の"],["供え物","そなえもの"],["を"],["ささげる"],["時","とき"],["に"],["なって"],["、"],["預言者","よげんしゃ"],["エリヤ"],["は"],["近寄って","ちかよって"],["言った","いった"],["、"],["「"],["アブラハム"],["、"],["イサク"],["、"],["ヤコブ"],["の"],["神","かみ"],["、"],["主","しゅ"],["よ"],["、"],["イスラエル"],["で"],["は"],["、"],["あなた"],["が"],["神","かみ"],["で"],["ある"],["こと"],["、"],["わたし"],["が"],["あなた"],["の"],["しもべ"],["で"],["あって"],["、"],["あなた"],["の"],["言葉","ことば"],["に"],["従って","したがって"],["この"],["すべて"],["の"],["事","こと"],["を"],["行なった","おこなった"],["こと"],["を"],["、"],["今日","こん"],["に"],["ち"],["知らせて","しらせて"],["ください"],["。"]]},{"verse":37,"text":"主,しゅよ、わたしに答,こたえてください、わたしに答,こたえてください。主,しゅよ、この民,たみにあなたが神,かみであること、またあなたが彼,かれらの心,こころを翻,ひるがえされたのであることを知,しらせてください」。","tok":[["主","しゅ"],["よ"],["、"],["わたし"],["に"],["答","こたえ"],["て"],["ください"],["、"],["わたし"],["に"],["答","こたえ"],["て"],["ください"],["。"],["主","しゅ"],["よ"],["、"],["この"],["民","たみ"],["に"],["あなた"],["が"],["神","かみ"],["で"],["ある"],["こと"],["、"],["また"],["あなた"],["が"],["彼","かれ"],["ら"],["の"],["心","こころ"],["を"],["翻がえされた","ひるがえされた"],["ので"],["ある"],["こと"],["を"],["知らせて","しらせて"],["ください"],["」"],["。"]]},{"verse":38,"text":"そのとき主,しゅの火,ひが下,くだって燔祭,はんさいと、たきぎと、石,いしと、ちりとを焼,やきつくし、またみぞの水,みずをなめつくした。","tok":[["その"],["とき"],["主","しゅ"],["の"],["火","ひ"],["が"],["下って","くだって"],["燔祭","はんさい"],["と"],["、"],["たきぎ"],["と"],["、"],["石","いし"],["と"],["、"],["ちり"],["と"],["を"],["焼きつく","やきつく"],["し"],["、"],["また"],["みぞ"],["の"],["水","みず"],["を"],["なめ"],["つくした"],["。"]]},{"verse":39,"text":"民,たみは皆,みな見,みて、ひれ伏,ふして言,いった、「主,しゅが神,かみである。主,しゅが神,かみである」。","tok":[["民","たみ"],["は"],["皆","みな"],["見て","みて"],["、"],["ひれ伏して","ひれふして"],["言った","いった"],["、"],["「"],["主","しゅ"],["が"],["神","かみ"],["で"],["ある"],["。"],["主","しゅ"],["が"],["神","かみ"],["で"],["ある"],["」"],["。"]]},{"verse":40,"text":"エリヤは彼,かれらに言,いった、「バアルの預言者,よげんしゃを捕,とらえよ。そのひとりも逃,にがしてはならない」。そこで彼,かれらを捕,とらえたので、エリヤは彼,かれらをキション川,かわに連,つれくだって、そこで彼,かれらを殺,ころした。","tok":[["エリヤ"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["バアル"],["の"],["預言者","よげんしゃ"],["を"],["捕らえ","とらえ"],["よ"],["。"],["その"],["ひとり"],["も"],["逃がして","にがして"],["は"],["ならない"],["」"],["。"],["そこ"],["で"],["彼","かれ"],["ら"],["を"],["捕らえた","とらえた"],["ので"],["、"],["エリヤ"],["は"],["彼","かれ"],["ら"],["を"],["キション"],["川","かわ"],["に"],["連れ","つれ"],["くだって"],["、"],["そこ"],["で"],["彼","かれ"],["ら"],["を"],["殺ろした","ころした"],["。"]]},{"verse":41,"text":"エリヤはアハブに言,いった、「大雨,おおあめの音,おとがするから、上,のぼって行,いって、食,くい飲,のみしなさい」。","tok":[["エリヤ"],["は"],["アハブ"],["に"],["言った","いった"],["、"],["「"],["大雨","おおあめ"],["の"],["音","おと"],["が"],["する"],["から"],["、"],["上って","のぼって"],["行って","いって"],["、"],["食い","くい"],["飲み","のみ"],["し"],["なさい"],["」"],["。"]]},{"verse":42,"text":"アハブは食,くい飲,のみするために上,のぼっていった。しかしエリヤはカルメルの頂,いただきに登,のぼり、地,ちに伏,ふして顔,かおをひざの間,あいだに入,いれていたが、","tok":[["アハブ"],["は"],["食い","くい"],["飲み","のみ"],["する"],["ため"],["に"],["上って","のぼって"],["いった"],["。"],["しかし"],["エリヤ"],["は"],["カルメル"],["の"],["頂","いただき"],["に"],["登り","のぼり"],["、"],["地","ち"],["に"],["伏して","ふして"],["顔","かお"],["を"],["ひざ"],["の"],["間","あいだ"],["に"],["入れて","いれて"],["いた"],["が"],["、"]]},{"verse":43,"text":"彼,かれはしもべに言,いった、「上,のぼっていって海,うみの方,ほうを見,みなさい」。彼,かれは上,のぼっていって、見,みて、「何,なにもありません」と言,いったので、エリヤは「もう一度,ど行,いきなさい」と言,いって七度,どに及,およんだ。","tok":[["彼","かれ"],["は"],["しもべ"],["に"],["言った","いった"],["、"],["「"],["上って","のぼって"],["いって"],["海","うみ"],["の"],["方","ほう"],["を"],["見","み"],["なさい"],["」"],["。"],["彼","かれ"],["は"],["上って","のぼって"],["いって"],["、"],["見て","みて"],["、"],["「"],["何に","なに"],["も"],["ありません"],["」"],["と"],["言った","いった"],["ので"],["、"],["エリヤ"],["は"],["「"],["もう"],["一度","ど"],["行き","いき"],["なさい"],["」"],["と"],["言って","いって"],["七","なな"],["度","ど"],["に"],["及んだ","およんだ"],["。"]]},{"verse":44,"text":"七度目,どめにしもべは言,いった、「海,うみから人,ひとの手,てほどの小,ちいさな雲,くもが起,たっています」。エリヤは言,いった、「上,のぼっていって、『雨,あめにとどめられないように車,くるまを整,ととのえて下,くだれ』とアハブに言,いいなさい」。","tok":[["七度目","どめ"],["に"],["しもべ"],["は"],["言った","いった"],["、"],["「"],["海","うみ"],["から"],["人","ひと"],["の"],["手","て"],["ほど"],["の"],["小さな","ちいさな"],["雲","くも"],["が"],["起って","たって"],["います"],["」"],["。"],["エリヤ"],["は"],["言った","いった"],["、"],["「"],["上って","のぼって"],["いって"],["、"],["『"],["雨","あめ"],["に"],["とどめられない"],["よう"],["に"],["車","くるま"],["を"],["整えて","ととのえて"],["下れ","くだれ"],["』"],["と"],["アハブ"],["に"],["言い","いい"],["なさい"],["」"],["。"]]},{"verse":45,"text":"すると間,まもなく、雲,くもと風,かぜが起,おこり、空,そらが黒,くろくなって大雨,おおあめが降,ふってきた。アハブは車,くるまに乗,のってエズレルへ行,いった。","tok":[["する"],["と"],["間","ま"],["も"],["なく"],["、"],["雲","くも"],["と"],["風","かぜ"],["が"],["起こり","おこり"],["、"],["空","そら"],["が"],["黒く","くろく"],["なって"],["大雨","おおあめ"],["が"],["降って","ふって"],["きた"],["。"],["アハブ"],["は"],["車","くるま"],["に"],["乗って","のって"],["エズレル"],["へ"],["行った","いった"],["。"]]},{"verse":46,"text":"また主,しゅの手,てがエリヤに臨,のぞんだので、彼,かれは腰,こしをからげ、エズレルの入口,いりぐちまでアハブの前,まえに走,はしっていった。","tok":[["また"],["主","しゅ"],["の"],["手","て"],["が"],["エリヤ"],["に"],["臨","のぞんだ"],["ので"],["、"],["彼","かれ"],["は"],["腰","こし"],["を"],["からげ"],["、"],["エズレル"],["の"],["入口","いりぐち"],["まで"],["アハブ"],["の"],["前","まえ"],["に"],["走って","はしって"],["いった"],["。"]]}]
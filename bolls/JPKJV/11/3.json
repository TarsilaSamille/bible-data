[{"verse":1,"text":"ソロモン王,おうはエジプトの王,おうパロと縁,ふちを結,むすび、パロの娘,むすめをめとってダビデの町,まちに連,つれてきて、自分,じぶんの家,いえと、主,しゅの宮,みやと、エルサレムの周囲,しゅういの城壁,じょうへきを建,たて終,おわるまでそこにおらせた。","tok":[["ソロモン"],["王","おう"],["は"],["エジプト"],["の"],["王","おう"],["パロ"],["と"],["縁","ふち"],["を"],["結び","むすび"],["、"],["パロ"],["の"],["娘","むすめ"],["を"],["めとって"],["ダビデ"],["の"],["町","まち"],["に"],["連れて","つれて"],["きて"],["、"],["自分","じぶん"],["の"],["家","いえ"],["と"],["、"],["主","しゅ"],["の"],["宮","みや"],["と"],["、"],["エルサレム"],["の"],["周囲","しゅうい"],["の"],["城壁","じょうへき"],["を"],["建て","たて"],["終わる","おわる"],["まで"],["そこ"],["に"],["おらせた"],["。"]]},{"verse":2,"text":"そのころまで主,しゅの名,なのために建,たてた宮,みやがなかったので、民,たみは高,たかき所,ところで犠牲,ぎせいをささげていた。","tok":[["その"],["ころ"],["まで"],["主","しゅ"],["の"],["名","な"],["の"],["ため"],["に"],["建てた","たてた"],["宮","みや"],["が"],["なかった"],["ので"],["、"],["民","たみ"],["は"],["高き","たかき"],["所","ところ"],["で"],["犠牲","ぎせい"],["を"],["ささげて"],["いた"],["。"]]},{"verse":3,"text":"ソロモンは主,しゅを愛,あいし、父,ちちダビデの定,さだめに歩,あゆんだが、ただ彼,かれは高,たかき所,ところで犠牲,ぎせいをささげ、香,こうをたいた。","tok":[["ソロモン"],["は"],["主","しゅ"],["を"],["愛し","あいし"],["、"],["父","ちち"],["ダビデ"],["の"],["定め","さだめ"],["に"],["歩んだ","あゆんだ"],["が"],["、"],["ただ"],["彼","かれ"],["は"],["高き","たかき"],["所","ところ"],["で"],["犠牲","ぎせい"],["を"],["ささげ"],["、"],["香","こう"],["を"],["たいた"],["。"]]},{"verse":4,"text":"ある日,ひ、王,おうはギベオンへ行,いって、そこで犠牲,ぎせいをささげようとした。それが主要,しゅような高,たかき所,ところであったからである。ソロモンは一千の燔祭,はんさいをその祭壇,さいだんにささげた。","tok":[["ある"],["日","ひ"],["、"],["王","おう"],["は"],["ギベオン"],["へ"],["行って","いって"],["、"],["そこ"],["で"],["犠牲","ぎせい"],["を"],["ささげよう"],["と"],["した"],["。"],["それ"],["が"],["主要","しゅよう"],["な"],["高き","たかき"],["所","ところ"],["で"],["あった"],["から"],["で"],["ある"],["。"],["ソロモン"],["は"],["一千","いちせん"],["の"],["燔祭","はんさい"],["を"],["その"],["祭壇","さいだん"],["に"],["ささげた"],["。"]]},{"verse":5,"text":"ギベオンで主,しゅは夜,よの夢,ゆめにソロモンに現,あらわれて言,いわれた、「あなたに何,なにを与,あたえようか、求,もとめなさい」。","tok":[["ギベオン"],["で"],["主","しゅ"],["は"],["夜","よ"],["の"],["夢","ゆめ"],["に"],["ソロモン"],["に"],["現われて","あらわれて"],["言われた","いわれた"],["、"],["「"],["あなた"],["に"],["何に","なに"],["を"],["与","あたえ"],["よう"],["か"],["、"],["求め","もとめ"],["なさい"],["」"],["。"]]},{"verse":6,"text":"ソロモンは言,いった、「あなたのしもべであるわたしの父,ちちダビデがあなたに対,たいして誠実,せいじつと公義,こうぎと真心,まごころとをもって、あなたの前,まえに歩,あゆんだので、あなたは大,おおいなるいつくしみを彼,かれに示,しめされました。またあなたは彼,かれのために、この大,おおいなるいつくしみをたくわえて、今日,こんにち、彼,かれの位,くらいに座,ざする子,こを授,さづけられました。","tok":[["ソロモン"],["は"],["言った","いった"],["、"],["「"],["あなた"],["の"],["しもべ"],["で"],["ある"],["わたし"],["の"],["父","ちち"],["ダビデ"],["が"],["あなた"],["に対して","にたいして"],["誠実","せいじつ"],["と"],["公義","こうぎ"],["と"],["真心","まごころ"],["と"],["を"],["もって"],["、"],["あなた"],["の"],["前","まえ"],["に"],["歩","あゆんだ"],["ので"],["、"],["あなた"],["は"],["大いなる","おおいなる"],["いつくしみ"],["を"],["彼","かれ"],["に"],["示めされました","しめされました"],["。"],["また"],["あなた"],["は"],["彼","かれ"],["の"],["ため"],["に"],["、"],["この"],["大いなる","おおいなる"],["いつくしみ"],["を"],["たくわえて"],["、"],["今日","こん"],["に"],["ち"],["、"],["彼","かれ"],["の"],["位","くらい"],["に"],["座する","ざする"],["子","こ"],["を"],["授","さ"],["づけられました"],["。"]]},{"verse":7,"text":"わが神,かみ、主,しゅよ、あなたはこのしもべを、わたしの父,ちちダビデに代,かわって王,おうとならせられました。しかし、わたしは小,ちいさい子供,こどもであって、出入,でいりすることを知,しりません。","tok":[["わが"],["神","かみ"],["、"],["主","しゅ"],["よ"],["、"],["あなた"],["は"],["この"],["しもべ"],["を"],["、"],["わたし"],["の"],["父","ちち"],["ダビデ"],["に"],["代わって","かわって"],["王","おう"],["と"],["ならせられました"],["。"],["しかし"],["、"],["わたし"],["は"],["小さい","ちいさい"],["子供","こども"],["で"],["あって"],["、"],["出入","でいり"],["する"],["こと"],["を"],["知りません","しりません"],["。"]]},{"verse":8,"text":"かつ、しもべはあなたが選,えらばれた、あなたの民,たみ、すなわちその数,かずが多,おおくて、数,かぞえることも、調,しらべることもできないほどのおびただしい民,たみの中,なかにおります。","tok":[["かつ"],["、"],["しもべ"],["は"],["あなた"],["が"],["選ら","えら"],["ばれた"],["、"],["あなた"],["の"],["民","たみ"],["、"],["すなわち"],["その"],["数","かず"],["が"],["多くて","おおくて"],["、"],["数える","かぞえる"],["こと"],["も"],["、"],["調べる","しらべる"],["こと"],["も"],["できない"],["ほど"],["の"],["おびただしい"],["民","たみ"],["の"],["中","なか"],["に"],["おります"],["。"]]},{"verse":9,"text":"それゆえ、聞,ききわける心,こころをしもべに与,あたえて、あなたの民,たみをさばかせ、わたしに善悪,ぜんあくをわきまえることを得,えさせてください。だれが、あなたのこの大,おおいなる民,たみをさばくことができましょう」。","tok":[["それ"],["ゆえ"],["、"],["聞","きき"],["わける"],["心","こころ"],["を"],["しもべ"],["に"],["与","あたえ"],["て"],["、"],["あなた"],["の"],["民","たみ"],["を"],["さばかせ"],["、"],["わたし"],["に"],["善悪","ぜんあく"],["を"],["わきまえる"],["こと"],["を"],["得させて","えさせて"],["ください"],["。"],["だれ"],["が"],["、"],["あなた"],["の"],["この"],["大いなる","おおいなる"],["民","たみ"],["を"],["さばく"],["こと"],["が"],["できましょう"],["」"],["。"]]},{"verse":10,"text":"ソロモンはこの事,ことを求,もとめたので、そのことが主,しゅのみこころにかなった。","tok":[["ソロモン"],["は"],["この"],["事","こと"],["を"],["求めた","もとめた"],["ので"],["、"],["その"],["こと"],["が"],["主","しゅ"],["のみ"],["こころ"],["に"],["かなった"],["。"]]},{"verse":11,"text":"そこで神,かみは彼,かれに言,いわれた、「あなたはこの事,ことを求,もとめて、自分,じぶんのために長命,ちょうめいを求,もとめず、また自分,じぶんのために富,とみを求,もとめず、また自分,じぶんの敵,てきの命,いのちをも求,もとめず、ただ訴,うったえをききわける知恵,ちえを求,もとめたゆえに、","tok":[["そこ"],["で"],["神","かみ"],["は"],["彼","かれ"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["は"],["この"],["事","こと"],["を"],["求めて","もとめて"],["、"],["自分","じぶん"],["の"],["ため"],["に"],["長命","ちょうめい"],["を"],["求めず","もとめず"],["、"],["また"],["自分","じぶん"],["の"],["ため"],["に"],["富","とみ"],["を"],["求めず","もとめず"],["、"],["また"],["自分","じぶん"],["の"],["敵","てき"],["の"],["命","いのち"],["を"],["も"],["求めず","もとめず"],["、"],["ただ"],["訴","うったえ"],["を"],["ききわける"],["知恵","ちえ"],["を"],["求めた","もとめた"],["ゆえ"],["に"],["、"]]},{"verse":12,"text":"見,みよ、わたしはあなたの言葉,ことばにしたがって、賢,かしこい、英明,えいめいな心,こころを与,あたえる。あなたの先,さきにはあなたに並,ならぶ者,ものがなく、あなたの後,のちにもあなたに並,ならぶ者,ものは起,おこらないであろう。","tok":[["見よ","みよ"],["、"],["わたし"],["は"],["あなた"],["の"],["言葉","ことば"],["に"],["したがって"],["、"],["賢しこい","かしこい"],["、"],["英明","えいめい"],["な"],["心","こころ"],["を"],["与える","あたえる"],["。"],["あなた"],["の"],["先","さき"],["に"],["は"],["あなた"],["に"],["並ぶ","ならぶ"],["者","もの"],["が"],["なく"],["、"],["あなた"],["の"],["後","のち"],["に"],["も"],["あなた"],["に"],["並ぶ","ならぶ"],["者","もの"],["は"],["起こらないで","おこらないで"],["あろう"],["。"]]},{"verse":13,"text":"わたしはまたあなたの求,もとめないもの、すなわち富,とみと誉,ほまれをもあなたに与,あたえる。あなたの生,いきているかぎり、王,おうたちのうちにあなたに並,ならぶ者,ものはないであろう。","tok":[["わたし"],["は"],["また"],["あなた"],["の"],["求めない","もとめない"],["もの"],["、"],["すなわち"],["富","とみ"],["と"],["誉","ほまれ"],["を"],["も"],["あなた"],["に"],["与える","あたえる"],["。"],["あなた"],["の"],["生きて","いきて"],["いる"],["かぎり"],["、"],["王","おう"],["たち"],["の"],["うち"],["に"],["あなた"],["に"],["並ぶ","ならぶ"],["者","もの"],["は"],["ないで"],["あろう"],["。"]]},{"verse":14,"text":"もしあなたが、あなたの父,ちちダビデの歩,あゆんだように、わたしの道,みちに歩,あゆんで、わたしの定,さだめと命令,めいれいとを守,まもるならば、わたしはあなたの日,ひを長,ながくするであろう」。","tok":[["もし"],["あなた"],["が"],["、"],["あなた"],["の"],["父","ちち"],["ダビデ"],["の"],["歩んだ","あゆんだ"],["よう"],["に"],["、"],["わたし"],["の"],["道","みち"],["に"],["歩んで","あゆんで"],["、"],["わたし"],["の"],["定め","さだめ"],["と"],["命令","めいれい"],["と"],["を"],["守","まもる"],["ならば"],["、"],["わたし"],["は"],["あなた"],["の"],["日","ひ"],["を"],["長く","ながく"],["するで"],["あろう"],["」"],["。"]]},{"verse":15,"text":"ソロモンが目,めをさましてみると、それは夢,ゆめであった。そこで彼,かれはエルサレムへ行,いき、主,しゅの契約,けいやくの箱,はこの前,まえに立,たって燔祭,はんさいと酬恩祭,しゅうおんさいをささげ、すべての家来,けらいのために祝宴,しゅくえんを設,もうけた。","tok":[["ソロモン"],["が"],["目","め"],["を"],["さまして"],["みる"],["と"],["、"],["それ"],["は"],["夢","ゆめ"],["で"],["あった"],["。"],["そこ"],["で"],["彼","かれ"],["は"],["エルサレム"],["へ"],["行き","いき"],["、"],["主","しゅ"],["の"],["契約","けいやく"],["の"],["箱","はこ"],["の"],["前","まえ"],["に"],["立って","たって"],["燔祭","はんさい"],["と"],["酬恩祭","しゅうおんさい"],["を"],["ささげ"],["、"],["すべて"],["の"],["家来","けらい"],["の"],["ため"],["に"],["祝宴","しゅくえん"],["を"],["設けた","もうけた"],["。"]]},{"verse":16,"text":"さて、ふたりの遊女,ゆうじょが王,おうのところにきて、王,おうの前,まえに立,たった。","tok":[["さて"],["、"],["ふたり"],["の"],["遊女","ゆうじょ"],["が"],["王","おう"],["の"],["ところ"],["に"],["きて"],["、"],["王","おう"],["の"],["前","まえ"],["に"],["立った","たった"],["。"]]},{"verse":17,"text":"ひとりの女,おんなは言,いった、「ああ、わが主,しゅよ、この女,おんなとわたしとはひとつの家,いえに住,すんでいますが、わたしはこの女,おんなと一緒,いっしょに家,いえにいる時,とき、子,こを産,うみました。","tok":[["ひとり"],["の"],["女","おんな"],["は"],["言った","いった"],["、"],["「"],["ああ"],["、"],["わが"],["主","しゅ"],["よ"],["、"],["この"],["女","おんな"],["と"],["わたし"],["と"],["は"],["ひと"],["つ"],["の"],["家","いえ"],["に"],["住んで","すんで"],["います"],["が"],["、"],["わたし"],["は"],["この"],["女","おんな"],["と"],["一緒","いっしょ"],["に"],["家","いえ"],["に"],["いる"],["時","とき"],["、"],["子","こ"],["を"],["産みました","うみました"],["。"]]},{"verse":18,"text":"ところがわたしの産,うんだ後,のち、三日,か目,めにこの女,おんなもまた子,こを産,うみました。そしてわたしたちは一緒,いっしょにいましたが、家,いえにはほかにだれもわたしたちと共,ともにいた者,ものはなく、ただわたしたちふたりだけでした。","tok":[["ところ"],["が"],["わたし"],["の"],["産んだ","うんだ"],["後","の"],["ち"],["、"],["三日目","かめ"],["に"],["この"],["女","おんな"],["も"],["また子","またこ"],["を"],["産みました","うみました"],["。"],["そして"],["わたしたち"],["は"],["一緒","いっしょ"],["に"],["いました"],["が"],["、"],["家","いえ"],["に"],["は"],["ほか"],["に"],["だれ"],["も"],["わたしたち"],["と"],["共","とも"],["に"],["いた"],["者","もの"],["は"],["なく"],["、"],["ただ"],["わたしたち"],["ふたり"],["だけ"],["でした"],["。"]]},{"verse":19,"text":"ところがこの女,おんなは自分,じぶんの子,この上,うえに伏,ふしたので、夜,よるのうちにその子,こは死,しにました。","tok":[["ところ"],["が"],["この"],["女","おんな"],["は"],["自分","じぶん"],["の"],["子","こ"],["の"],["上","うえ"],["に"],["伏した","ふした"],["ので"],["、"],["夜","よる"],["の"],["うち"],["に"],["その"],["子","こ"],["は"],["死にました","しにました"],["。"]]},{"verse":20,"text":"彼女,かのじょは夜中,よなかに起,おきて、はしための眠,ねむっている間,あいだに、わたしの子,こをわたしのかたわらから取,とって、自分,じぶんのふところに寝,ねかせ、自分,じぶんの死,しんだ子,こをわたしのふところに寝,ねかせました。","tok":[["彼女","かのじょ"],["は"],["夜中","よなか"],["に"],["起きて","おきて"],["、"],["はし"],["ため"],["の"],["眠って","ねむって"],["いる"],["間","あいだ"],["に"],["、"],["わたし"],["の"],["子","こ"],["を"],["わたし"],["の"],["かたわら"],["から"],["取って","とって"],["、"],["自分","じぶん"],["の"],["ふところ"],["に"],["寝かせ","ねかせ"],["、"],["自分","じぶん"],["の"],["死んだ","しんだ"],["子","こ"],["を"],["わたし"],["の"],["ふところ"],["に"],["寝かせました","ねかせました"],["。"]]},{"verse":21,"text":"わたしは朝,あさ、子,こに乳,ちちを飲,のませようとして起,おきて見,みると死,しんでいました。しかし朝,あさになってよく見,みると、それはわたしが産,うんだ子,こではありませんでした」。","tok":[["わたし"],["は"],["朝","あさ"],["、"],["子","こ"],["に"],["乳","ちち"],["を"],["飲ませよう","のませよう"],["として"],["起きて","おきて"],["見る","みる"],["と"],["死んで","しんで"],["いました"],["。"],["しかし"],["朝","あさ"],["に"],["なって"],["よく"],["見る","みる"],["と"],["、"],["それ"],["は"],["わたし"],["が"],["産んだ","うんだ"],["子","こ"],["で"],["は"],["ありませんでした"],["」"],["。"]]},{"verse":22,"text":"ほかの女,おんなは言,いった、「いいえ、生,いきているのがわたしの子,こです。死,しんだのはあなたの子,こです」。初,はじめの女,おんなは言,いった、「いいえ、死,しんだのがあなたの子,こです。生,いきているのはわたしの子,こです」。彼,かれらはこのように王,おうの前,まえに言,いい合,あった。","tok":[["ほか"],["の"],["女","おんな"],["は"],["言った","いった"],["、"],["「"],["いいえ"],["、"],["生きて","いきて"],["いる"],["の"],["が"],["わたし"],["の"],["子","こ"],["です"],["。"],["死","しんだ"],["の"],["は"],["あなた"],["の"],["子","こ"],["です"],["」"],["。"],["初め","はじめ"],["の"],["女","おんな"],["は"],["言った","いった"],["、"],["「"],["いいえ"],["、"],["死","しんだ"],["の"],["が"],["あなた"],["の"],["子","こ"],["です"],["。"],["生きて","いきて"],["いる"],["の"],["は"],["わたし"],["の"],["子","こ"],["です"],["」"],["。"],["彼","かれ"],["ら"],["は"],["この"],["よう"],["に"],["王","おう"],["の"],["前","まえ"],["に"],["言い合った","いいあった"],["。"]]},{"verse":23,"text":"この時,とき、王,おうは言,いった、「ひとりは『この生,いきているのがわたしの子,こで、死,しんだのがあなたの子,こだ』と言,いい、またひとりは『いいえ、死,しんだのがあなたの子,こで、生,いきているのはわたしの子,こだ』と言,いう」。","tok":[["この"],["時","とき"],["、"],["王","おう"],["は"],["言った","いった"],["、"],["「"],["ひとり"],["は"],["『"],["この"],["生きて","いきて"],["いる"],["の"],["が"],["わたし"],["の"],["子","こ"],["で"],["、"],["死","しんだ"],["の"],["が"],["あなた"],["の"],["子","こ"],["だ"],["』"],["と"],["言い","いい"],["、"],["また"],["ひとり"],["は"],["『"],["いいえ"],["、"],["死","しんだ"],["の"],["が"],["あなた"],["の"],["子","こ"],["で"],["、"],["生きて","いきて"],["いる"],["の"],["は"],["わたし"],["の"],["子","こ"],["だ"],["』"],["と"],["言う","いう"],["」"],["。"]]},{"verse":24,"text":"そこで王,おうは「刀,かたなを持,もってきなさい」と言,いったので、刀,かたなを王,おうの前,まえに持,もってきた。","tok":[["そこ"],["で"],["王","おう"],["は"],["「"],["刀","かたな"],["を"],["持って","もって"],["き"],["なさい"],["」"],["と"],["言った","いった"],["ので"],["、"],["刀","かたな"],["を"],["王","おう"],["の"],["前","まえ"],["に"],["持って","もって"],["きた"],["。"]]},{"verse":25,"text":"王,おうは言,いった、「生,いきている子,こを二つに分,わけて、半分,はんぶんをこちらに、半分,はんぶんをあちらに与,あたえよ」。","tok":[["王","おう"],["は"],["言った","いった"],["、"],["「"],["生きて","いきて"],["いる"],["子","こ"],["を"],["二","ふた"],["つ"],["に"],["分けて","わけて"],["、"],["半分","はんぶん"],["を"],["こちら"],["に"],["、"],["半分","はんぶん"],["を"],["あちら"],["に"],["与","あたえ"],["よ"],["」"],["。"]]},{"verse":26,"text":"すると生,いきている子,この母,ははである女,おんなは、その子,このために心,こころがやけるようになって、王,おうに言,いった、「ああ、わが主,しゅよ、生,いきている子,こを彼女,かのじょに与,あたえてください。決,けっしてそれを殺,ころさないでください」。しかしほかのひとりは言,いった、「それをわたしのものにも、あなたのものにもしないで、分,わけてください」。","tok":[["する"],["と"],["生きて","いきて"],["いる"],["子","こ"],["の"],["母","はは"],["で"],["ある"],["女","おんな"],["は"],["、"],["その"],["子","こ"],["の"],["ため"],["に"],["心","こころ"],["が"],["やける"],["よう"],["に"],["なって"],["、"],["王","おう"],["に"],["言った","いった"],["、"],["「"],["ああ"],["、"],["わが"],["主","しゅ"],["よ"],["、"],["生きて","いきて"],["いる"],["子","こ"],["を"],["彼女","かのじょ"],["に"],["与","あたえ"],["て"],["ください"],["。"],["決っして","けっして"],["それ"],["を"],["殺ろさないで","ころさないで"],["ください"],["」"],["。"],["しかし"],["ほか"],["の"],["ひとり"],["は"],["言った","いった"],["、"],["「"],["それ"],["を"],["わたし"],["の"],["もの"],["に"],["も"],["、"],["あなた"],["の"],["もの"],["に"],["も"],["しないで"],["、"],["分て","わけて"],["ください"],["」"],["。"]]},{"verse":27,"text":"すると王,おうは答,こたえて言,いった、「生,いきている子,こを初,はじめの女,おんなに与,あたえよ。決,けっして殺,ころしてはならない。彼女,かのじょはその母,ははなのだ」。","tok":[["する"],["と"],["王","おう"],["は"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["生きて","いきて"],["いる"],["子","こ"],["を"],["初め","はじめ"],["の"],["女","おんな"],["に"],["与","あたえ"],["よ"],["。"],["決っして","けっして"],["殺ろし","ころし"],["ては"],["ならない"],["。"],["彼女","かのじょ"],["は"],["その"],["母","はは"],["な"],["の"],["だ"],["」"],["。"]]},{"verse":28,"text":"イスラエルは皆,みな王,おうが与,あたえた判決,はんけつを聞,きいて王,おうを恐,おそれた。神,かみの知恵,ちえが彼,かれのうちにあって、さばきをするのを見,みたからである。","tok":[["イスラエル"],["は"],["皆","みな"],["王","おう"],["が"],["与","あたえ"],["た"],["判決","はんけつ"],["を"],["聞いて","きいて"],["王","おう"],["を"],["恐れた","おそれた"],["。"],["神","かみ"],["の"],["知恵","ちえ"],["が"],["彼","かれ"],["の"],["うち"],["に"],["あって"],["、"],["さばき"],["を"],["する"],["の"],["を"],["見た","みた"],["から"],["で"],["ある"],["。"]]}]
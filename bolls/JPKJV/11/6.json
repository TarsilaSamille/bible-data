[{"verse":1,"text":"イスラエルの人々,ひとびとがエジプトの地,ちを出,でて後,のち四百八十年,ねん、ソロモンがイスラエルの王,おうとなって第,だい四年,ねんのジフの月,つきすなわち二月,がつに、ソロモンは主,しゅのために宮,みやを建,たてることを始,はじめた。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["が"],["エジプト"],["の"],["地","ち"],["を"],["出て","でて"],["後","の"],["ち"],["四百八十","よんひゃくはちじゅう"],["年","ねん"],["、"],["ソロモン"],["が"],["イスラエル"],["の"],["王","おう"],["と"],["なって"],["第","だい"],["四","よん"],["年","ねん"],["の"],["ジフ"],["の"],["月","つき"],["すなわち"],["二","に"],["月","がつ"],["に"],["、"],["ソロモン"],["は"],["主","しゅ"],["の"],["ため"],["に"],["宮","みや"],["を"],["建てる","たてる"],["こと"],["を"],["始めた","はじめた"],["。"]]},{"verse":2,"text":"ソロモン王,おうが主,しゅのために建,たてた宮,みやは長,ながさ六十キュビト、幅,はば二十キュビト、高,たかさ三十キュビトであった。","tok":[["ソロモン"],["王","おう"],["が"],["主","しゅ"],["の"],["ため"],["に"],["建てた","たてた"],["宮","みや"],["は"],["長さ","ながさ"],["六十","ろくじゅう"],["キュビト"],["、"],["幅","はば"],["二十","にじゅう"],["キュビト"],["、"],["高か","たか"],["さ"],["三十","さんじゅう"],["キュビト"],["で"],["あった"],["。"]]},{"verse":3,"text":"宮,みやの拝殿,はいでんの前,まえの廊,ろうは宮,みやの幅,はばにしたがって長,ながさ二十キュビト、その幅,はばは宮,みやの前,まえで十キュビトであった。","tok":[["宮","みや"],["の"],["拝殿","はいでん"],["の"],["前","まえ"],["の"],["廊","ろう"],["は"],["宮","みや"],["の"],["幅","はば"],["に"],["したがって"],["長さ","ながさ"],["二十","にじゅう"],["キュビト"],["、"],["その"],["幅","はば"],["は"],["宮","みや"],["の"],["前","まえ"],["で"],["十","じゅう"],["キュビト"],["で"],["あった"],["。"]]},{"verse":4,"text":"彼,かれは宮,みやに、内側,うちがわの広,ひろい枠,わくの窓,まどを造,つくった。","tok":[["彼","かれ"],["は"],["宮","みや"],["に"],["、"],["内側","うちがわ"],["の"],["広い","ひろい"],["枠","わく"],["の"],["窓","まど"],["を"],["造った","つくった"],["。"]]},{"verse":5,"text":"また宮,みやの壁,かべにつけて周囲,しゅういに脇屋,わきやを設,もうけ、宮,みやの壁,かべすなわち拝殿,はいでんと本殿,ほんでんの壁,かべの周囲,しゅういに建,たてめぐらし、宮,みやの周囲,しゅういに脇間,わきまがあるようにした。","tok":[["また"],["宮","みや"],["の"],["壁","かべ"],["に"],["つけて"],["周囲","しゅうい"],["に"],["脇屋","わきや"],["を"],["設け","もうけ"],["、"],["宮","みや"],["の"],["壁","かべ"],["すなわち"],["拝殿","はいでん"],["と"],["本殿","ほんでん"],["の"],["壁","かべ"],["の"],["周囲","しゅうい"],["に"],["建て","たて"],["めぐらし"],["、"],["宮","みや"],["の"],["周囲","しゅうい"],["に"],["脇間","わきま"],["が"],["ある"],["よう"],["に"],["した"],["。"]]},{"verse":6,"text":"下,したの脇間,わきまは広,ひろさ五キュビト、中,なかの広,ひろさ六キュビト、第,だい三のは広,ひろさ七キュビトであった。宮,みやの外側,そとがわには壁,かべに段,だんを造,つくって、梁,はりを宮,みやの壁,かべの中,なかに差,さし込,こまないようにした。","tok":[["下","した"],["の"],["脇間","わきま"],["は"],["広さ","ひろさ"],["五","ご"],["キュビト"],["、"],["中","なか"],["の"],["広さ","ひろさ"],["六","ろく"],["キュビト"],["、"],["第","だい"],["三","さん"],["の"],["は"],["広さ","ひろさ"],["七","なな"],["キュビト"],["で"],["あった"],["。"],["宮","みや"],["の"],["外側","そとがわ"],["に"],["は"],["壁","かべ"],["に"],["段","だん"],["を"],["造って","つくって"],["、"],["梁","はり"],["を"],["宮","みや"],["の"],["壁","かべ"],["の"],["中","なか"],["に"],["差し込まない","さしこまない"],["よう"],["に"],["した"],["。"]]},{"verse":7,"text":"宮,みやは建,たてる時,ときに、石,いし切,きり場,ばで切,きり整,ととのえた石,いしをもって造,つくったので、建,たてている間,あいだは宮,みやのうちには、つちも、おのも、その他,たの鉄器,てっきもその音,おとが聞,きこえなかった。","tok":[["宮","みや"],["は"],["建てる","たてる"],["時","とき"],["に"],["、"],["石切り","いしきり"],["場","ば"],["で"],["切り整えた","きりととのえた"],["石","いし"],["を"],["もって"],["造った","つくった"],["ので"],["、"],["建てて","たてて"],["いる"],["間","あいだ"],["は"],["宮","みや"],["の"],["うち"],["に"],["は"],["、"],["つち"],["も"],["、"],["おの"],["も"],["、"],["その"],["他","た"],["の"],["鉄器","てっき"],["も"],["その"],["音","おと"],["が"],["聞こえなかった","きこえなかった"],["。"]]},{"verse":8,"text":"下,したの脇間,わきまの入口,いりぐちは宮,みやの右側,みぎがわにあり、回,まわり階段,かいだんによって中,なかの脇間,わきまに、中,なかの脇間,わきまから第,だい三の脇間,わきまにのぼった。","tok":[["下","した"],["の"],["脇間","わきま"],["の"],["入口","いりぐち"],["は"],["宮","みや"],["の"],["右側","みぎがわ"],["に"],["あり"],["、"],["回わり","まわり"],["階段","かいだん"],["によって"],["中","なか"],["の"],["脇間","わきま"],["に"],["、"],["中","なか"],["の"],["脇間","わきまか"],["ら"],["第","だい"],["三","さん"],["の"],["脇間","わきま"],["に"],["のぼった"],["。"]]},{"verse":9,"text":"こうして彼,かれは宮,みやを建,たて終,おわり、香柏,こうはくのたるきと板,いたをもって宮,みやの天井,てんじょうを造,つくった。","tok":[["こう"],["して"],["彼","かれ"],["は"],["宮","みや"],["を"],["建て","たて"],["終","おわり"],["、"],["香","こう"],["柏","かしわ"],["と"],["板","いた"],["を"],["もって"],["宮","みや"],["の"],["天井","てんじょう"],["を"],["造った","つくった"],["。"]]},{"verse":10,"text":"また宮,みやにつけて、おのおの高,たかさ五キュビトの脇間,わきまのある脇屋,わきやを建,たてめぐらし、香柏,こうはくの材木,ざいもくをもって宮,みやに接続,せつぞくさせた。","tok":[["また"],["宮","みや"],["に"],["つけて"],["、"],["おのおの"],["高か","たか"],["さ"],["五","ご"],["キュビト"],["の"],["脇間","わきま"],["の"],["ある"],["脇屋","わきや"],["を"],["建て","たて"],["めぐらし"],["、"],["香","こう"],["柏","かしわ"],["の"],["材木","ざいもく"],["を"],["もって"],["宮","みや"],["に"],["接続","せつぞく"],["させた"],["。"]]},{"verse":11,"text":"そこで主,しゅの言葉,ことばがソロモンに臨,のぞんだ、","tok":[["そこ"],["で"],["主","しゅ"],["の"],["言葉","ことば"],["が"],["ソロモン"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":12,"text":"「あなたが建,たてるこの宮,みやについては、もしあなたがわたしの定,さだめに歩,あゆみ、おきてを行,おこない、すべての戒,いましめを守,まもり、それに従,したがって歩,あゆむならば、わたしはあなたの父,ちちダビデに約束,やくそくしたことを成就,じょうじゅする。","tok":[["「"],["あなた"],["が"],["建てる","たてる"],["この"],["宮","みや"],["について"],["は"],["、"],["もし"],["あなた"],["が"],["わたし"],["の"],["定め","さだめ"],["に"],["歩み","あゆみ"],["、"],["おきて"],["を"],["行ない","おこない"],["、"],["すべて"],["の"],["戒しめ","いましめ"],["を"],["守り","まもり"],["、"],["それ"],["に"],["従って","したがって"],["歩むならば","あゆむならば"],["、"],["わたし"],["は"],["あなた"],["の"],["父","ちち"],["ダビデ"],["に"],["約束","やくそく"],["した"],["こと"],["を"],["成就","じょうじゅ"],["する"],["。"]]},{"verse":13,"text":"そしてわたしはイスラエルの人々,ひとびとのうちに住,すみ、わたしの民,たみイスラエルを捨,すてることはない」。","tok":[["そして"],["わたし"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["うち"],["に"],["住み","すみ"],["、"],["わたし"],["の"],["民","たみ"],["イスラエル"],["を"],["捨てる","すてる"],["こと"],["は"],["ない"],["」"],["。"]]},{"verse":14,"text":"こうしてソロモンは宮,みやを建,たて終,おわった。","tok":[["こう"],["して"],["ソロモン"],["は"],["宮","みや"],["を"],["建て","たて"],["終わった","おわった"],["。"]]},{"verse":15,"text":"彼,かれは香柏,こうはくの板,いたをもって宮,みやの壁,かべの内側,うちがわを張,はった。すなわち宮,みやの床,ゆかから天井,てんじょうのたるきまで香柏,こうはくの板,いたで張,はった。また、いとすぎの板,いたをもって宮,みやの床,ゆかを張,はった。","tok":[["彼","かれ"],["は"],["香","こう"],["柏","かしわ"],["の"],["板","いた"],["を"],["もって"],["宮","みや"],["の"],["壁","かべ"],["の"],["内側","うちがわ"],["を"],["張った","はった"],["。"],["すなわち"],["宮","みや"],["の"],["床","ゆか"],["から"],["天井","てんじょう"],["の"],["たるき"],["まで"],["香","こう"],["柏","かしわ"],["の"],["板","いた"],["で"],["張った","はった"],["。"],["また"],["、"],["いと"],["すぎ"],["の"],["板","いた"],["を"],["もって"],["宮","みや"],["の"],["床","ゆか"],["を"],["張った","はった"],["。"]]},{"verse":16,"text":"また宮,みやの奥,おくに二十キュビトの室,しつを床,ゆかから天井,てんじょうのたるきまで香柏,こうはくの板,いたをもって造,つくった。すなわち宮,みやの内,うちに至聖所,しせいじょとしての本堂,ほんどうを造,つくった。","tok":[["また"],["宮","みや"],["の"],["奥","おく"],["に"],["二十","にじゅう"],["キュビト"],["の"],["室","しつ"],["を"],["床","ゆか"],["から"],["天井","てんじょう"],["の"],["たるき"],["まで"],["香","こう"],["柏","かしわ"],["の"],["板","いた"],["を"],["もって"],["造った","つくった"],["。"],["すなわち"],["宮","みや"],["の"],["内","うち"],["に"],["至聖所","しせいじょとして"],["の"],["本堂","ほんどう"],["を"],["造った","つくった"],["。"]]},{"verse":17,"text":"宮,みやすなわち本殿,ほんでんの前,まえにある拝殿,はいでんは長,ながさ四十キュビトであった。","tok":[["宮","みや"],["すなわち"],["本殿","ほんでん"],["の"],["前","まえ"],["に"],["ある"],["拝殿","はいでん"],["は"],["長さ","ながさ"],["四十","よんじゅう"],["キュビト"],["で"],["あった"],["。"]]},{"verse":18,"text":"宮,みやの内,うち側,がわの香柏,こうはくの板,いたは、ひさごの形,かたちと、咲,さいた花,はなを浮彫,うきぼりりにしたもので、みな香柏,こうはくの板,いたで、石,いしは見,みえなかった。","tok":[["宮","みや"],["の"],["内側","うちがわ"],["の"],["香","こう"],["柏","かしわ"],["の"],["板","いた"],["は"],["、"],["ひさご"],["の"],["形","かたち"],["と"],["、"],["咲いた","さいた"],["花","はな"],["を"],["浮彫り","うきぼり"],["り"],["に"],["した"],["もの"],["で"],["、"],["みな"],["香","こう"],["柏","かしわ"],["の"],["板","いた"],["で"],["、"],["石","いし"],["は"],["見えなかった","みえなかった"],["。"]]},{"verse":19,"text":"そして主,しゅの契約,けいやくの箱,はこを置,おくために、宮,みやの内,うちの奥,おくに本殿,ほんでんを設,もうけた。","tok":[["そして"],["主","しゅ"],["の"],["契約","けいやく"],["の"],["箱","はこ"],["を"],["置く","おく"],["ため"],["に"],["、"],["宮","みや"],["の"],["内","うち"],["の"],["奥","おく"],["に"],["本殿","ほんでん"],["を"],["設けた","もうけた"],["。"]]},{"verse":20,"text":"本殿,ほんでんは長,ながさ二十キュビト、幅,はば二十キュビト、高,たかさ二十キュビトであって、純金,じゅんきんでこれをおおった。また香柏,こうはくの祭壇,さいだんを造,つくった。","tok":[["本殿","ほんでん"],["は"],["長さ","ながさ"],["二十","にじゅう"],["キュビト"],["、"],["幅","はば"],["二十","にじゅう"],["キュビト"],["、"],["高か","たか"],["さ"],["二十","にじゅう"],["キュビト"],["で"],["あって"],["、"],["純金","じゅんきん"],["で"],["これ"],["を"],["おおった"],["。"],["また"],["香","こう"],["柏","かしわ"],["の"],["祭壇","さいだん"],["を"],["造った","つくった"],["。"]]},{"verse":21,"text":"ソロモンは純金,じゅんきんをもって宮,みやの内,うち側,がわをおおい、本殿,ほんでんの前,まえに金,きんの鎖,くさりをもって隔,へだてを造,つくり、金,きんをもってこれをおおった。","tok":[["ソロモン"],["は"],["純金","じゅんきん"],["を"],["もって"],["宮","みや"],["の"],["内側","うちがわ"],["を"],["おおい"],["、"],["本殿","ほんでん"],["の"],["前","まえ"],["に"],["金","きん"],["の"],["鎖","くさり"],["を"],["もって"],["隔て","へだて"],["を"],["造","つくり"],["、"],["金","きん"],["を"],["もって"],["これ"],["を"],["おおった"],["。"]]},{"verse":22,"text":"また金,きんをもって残,のこらず宮,みやをおおい、ついに宮,みやを飾,かざることをことごとく終,おえた。また本殿,ほんでんに属,ぞくする祭壇,さいだんをことごとく金,きんでおおった。","tok":[["また"],["金","きん"],["を"],["もって"],["残らず","のこらず"],["宮","みや"],["を"],["おおい"],["、"],["ついに"],["宮","みや"],["を"],["飾る","かざる"],["こと"],["を"],["ことごとく"],["終えた","おえた"],["。"],["また"],["本殿","ほんでん"],["に"],["属する","ぞくする"],["祭壇","さいだん"],["を"],["ことごとく"],["金","きん"],["で"],["おおった"],["。"]]},{"verse":23,"text":"本殿,ほんでんのうちにオリブの木,きをもって二つのケルビムを造,つくった。その高,たかさはおのおの十キュビト。","tok":[["本殿","ほんでん"],["の"],["うち"],["に"],["オリブ"],["の"],["木","き"],["を"],["もって"],["二","ふた"],["つ"],["の"],["ケルビム"],["を"],["造った","つくった"],["。"],["その"],["高さ","たかさ"],["は"],["おのおの"],["十","じゅう"],["キュビト"],["。"]]},{"verse":24,"text":"そのケルブの一つの翼,つばさの長,ながさは五キュビト、またそのケルブの他,たの翼,つばさの長,ながさも五キュビトであった。一つの翼,つばさの端,はしから他,たの翼,つばさの端,はしまでは十キュビトあった。","tok":[["その"],["ケルブ"],["の"],["一","ひと"],["つ"],["の"],["翼","つばさ"],["の"],["長さ","ながさ"],["は"],["五","ご"],["キュビト"],["、"],["また"],["その"],["ケルブ"],["の"],["他","た"],["の"],["翼","つばさ"],["の"],["長さ","ながさ"],["も"],["五","ご"],["キュビト"],["で"],["あった"],["。"],["一","ひと"],["つ"],["の"],["翼","つばさ"],["の"],["端","はし"],["から"],["他","た"],["の"],["翼","つばさ"],["の"],["端","はし"],["まで"],["は"],["十","じゅう"],["キュビト"],["あった"],["。"]]},{"verse":25,"text":"他,たのケルブも十キュビトであって、二つのケルビムは同,おなじ寸法,すんぽう、同,おなじ形,かたちであった。","tok":[["他","た"],["の"],["ケルブ"],["も"],["十","じゅう"],["キュビト"],["で"],["あって"],["、"],["二","ふた"],["つ"],["の"],["ケルビム"],["は"],["同じ","おなじ"],["寸法","すんぽう"],["、"],["同じ","おなじ"],["形","かたち"],["で"],["あった"],["。"]]},{"verse":26,"text":"このケルブの高,たかさは十キュビト、かのケルブの高,たかさも同,おなじであった。","tok":[["この"],["ケルブ"],["の"],["高さ","たかさ"],["は"],["十","じゅう"],["キュビト"],["、"],["かの"],["ケルブ"],["の"],["高さ","たかさ"],["も"],["同じ","おなじ"],["で"],["あった"],["。"]]},{"verse":27,"text":"ソロモンは宮,みやのうちの奥,おくにケルビムをすえた。ケルビムの翼,つばさを伸,のばしたところ、このケルブの翼,つばさはこの壁,かべに達,たっし、かのケルブの翼,つばさはかの壁,かべに達,たっし、他,たの二つの翼,つばさは宮,みやの中,なかで互,たがいに触,ふれ合,あった。","tok":[["ソロモン"],["は"],["宮","みや"],["の"],["うち"],["の"],["奥","おく"],["に"],["ケルビム"],["を"],["すえた"],["。"],["ケルビム"],["の"],["翼","つばさ"],["を"],["伸ばした","のばした"],["ところ"],["、"],["この"],["ケルブ"],["の"],["翼","つばさ"],["は"],["この"],["壁","かべ"],["に"],["達し","たっし"],["、"],["かの"],["ケルブ"],["の"],["翼","つばさ"],["は"],["かの"],["壁","かべ"],["に"],["達し","たっし"],["、"],["他","た"],["の"],["二","ふた"],["つ"],["の"],["翼","つばさ"],["は"],["宮","みや"],["の"],["中","なか"],["で"],["互","たがい"],["に"],["触","ふれ"],["合った","あった"],["。"]]},{"verse":28,"text":"彼,かれは金,きんをもってそのケルビムをおおった。","tok":[["彼","かれ"],["は"],["金","きん"],["を"],["もって"],["その"],["ケルビム"],["を"],["おおった"],["。"]]},{"verse":29,"text":"彼,かれは宮,みやの周囲,しゅういの壁,かべに、内外,ないがいの室,しつとも皆,みなケルビムと、しゅろの木,きと、咲,さいた花,はなの形,かたちの彫,ほり物,ものを刻,きざみ、","tok":[["彼","かれ"],["は"],["宮","みや"],["の"],["周囲","しゅうい"],["の"],["壁","かべ"],["に"],["、"],["内外","ないがい"],["の"],["室","しつと"],["も"],["皆","みな"],["ケルビム"],["と"],["、"],["しゅろ"],["の"],["木","き"],["と"],["、"],["咲いた","さいた"],["花","はな"],["の"],["形","かたち"],["の"],["彫物","ほりもの"],["を"],["刻み","きざみ"],["、"]]},{"verse":30,"text":"宮,みやの床,ゆかは、内外,ないがいの室,しつとも金,きんでおおった。","tok":[["宮","みや"],["の"],["床","ゆか"],["は"],["、"],["内外","ないがい"],["の"],["室","しつと"],["も"],["金","きん"],["で"],["おおった"],["。"]]},{"verse":31,"text":"本殿,ほんでんの入口,いりぐちにはオリブの木,きのとびらを造,つくった。そのとびらの上,うえのかまちと脇,わき柱,ばしらとで五辺,へん形,けいをなしていた。","tok":[["本殿","ほんでん"],["の"],["入口","いりぐち"],["に"],["は"],["オリブ"],["の"],["木","き"],["の"],["とびら"],["を"],["造った","つくった"],["。"],["その"],["とびら"],["の"],["上","うえ"],["の"],["かまち"],["と"],["脇柱","わきばしら"],["と"],["で"],["五辺形","へんけい"],["を"],["なして"],["いた"],["。"]]},{"verse":32,"text":"その二つのとびらもオリブの木,きであって、ソロモンはその上,うえにケルビムと、しゅろの木,きと、咲,さいた花,はなの形,かたちを刻,きざみ、金,きんをもっておおった。すなわちケルビムと、しゅろの木,きの上,うえに金,きんを着,きせた。","tok":[["その"],["二","ふた"],["つ"],["の"],["とびら"],["も"],["オリブ"],["の"],["木","き"],["で"],["あって"],["、"],["ソロモン"],["は"],["その"],["上","うえ"],["に"],["ケルビム"],["と"],["、"],["しゅろ"],["の"],["木","き"],["と"],["、"],["咲いた","さいた"],["花","はな"],["の"],["形","かたち"],["を"],["刻み","きざみ"],["、"],["金","きん"],["を"],["もって"],["おおった"],["。"],["すなわち"],["ケルビム"],["と"],["、"],["しゅろ"],["の"],["木","き"],["の"],["上","うえ"],["に"],["金","きん"],["を"],["着せた","きせた"],["。"]]},{"verse":33,"text":"こうしてソロモンはまた拝殿,はいでんの入口,いりぐちのためにオリブの木,きで四角,しかくの形,かたちに脇,わき柱,ばしらを造,つくった。","tok":[["こう"],["して"],["ソロモン"],["は"],["また"],["拝殿","はいでん"],["の"],["入口","いりぐち"],["の"],["ため"],["に"],["オリブ"],["の"],["木","き"],["で"],["四角","しかく"],["の"],["形","かたち"],["に"],["脇柱","わきばしら"],["を"],["造った","つくった"],["。"]]},{"verse":34,"text":"その二つのとびらはいとすぎであって、一つのとびらは二つにたたむ折,おり戸,とであり、他,たのとびらも二つにたたむ折,おり戸,とであった。","tok":[["その"],["二","ふた"],["つ"],["の"],["とびら"],["は"],["いと"],["すぎで"],["あって"],["、"],["一","ひと"],["つ"],["の"],["とびら"],["は"],["二","ふた"],["つ"],["に"],["たたむ"],["折戸","おりと"],["で"],["あり"],["、"],["他","た"],["の"],["とびら"],["も"],["二","ふた"],["つ"],["に"],["たたむ"],["折戸","おりと"],["で"],["あった"],["。"]]},{"verse":35,"text":"ソロモンはその上,うえにケルビムと、しゅろの木,きと、咲,さいた花,はなを刻,きざみ、金,きんをもって彫,ほり物,ものの上,うえを形,かたちどおりにおおった。","tok":[["ソロモン"],["は"],["その"],["上","うえ"],["に"],["ケルビム"],["と"],["、"],["しゅろ"],["の"],["木","き"],["と"],["、"],["咲いた","さいた"],["花","はな"],["を"],["刻み","きざみ"],["、"],["金","きん"],["を"],["もって"],["彫物","ほりもの"],["の"],["上","うえ"],["を"],["形","かたち"],["どおり"],["に"],["おおった"],["。"]]},{"verse":36,"text":"また切,きり石,いし三かさねと、香柏,こうはくの角材,かくざいひとかさねとをもって内庭,うちにわを造,つくった。","tok":[["また"],["切り石","きりいし"],["三","さん"],["かさね"],["と"],["、"],["香","こう"],["柏","かしわ"],["の"],["角材","かくざい"],["ひと"],["かさね"],["と"],["を"],["もって"],["内庭","うちにわ"],["を"],["造った","つくった"],["。"]]},{"verse":37,"text":"第,だい四年,ねんのジフの月,つきに主,しゅの宮,みやの基,もといをすえ、","tok":[["第","だい"],["四","よん"],["年","ねん"],["の"],["ジフ"],["の"],["月","つき"],["に"],["主","しゅ"],["の"],["宮","みや"],["の"],["基い","もとい"],["を"],["すえ"],["、"]]},{"verse":38,"text":"第,だい十一年,ねんのブルの月,つきすなわち八月,がつに、宮,みやのすべての部分,ぶぶんが設計,せっけいどおりに完成,かんせいした。ソロモンはこれを建,たてるのに七年,ねんを要,ようした。","tok":[["第","だい"],["十一","じゅういち"],["年","ねん"],["の"],["ブル"],["の"],["月","つき"],["すなわち"],["八","はち"],["月","がつ"],["に"],["、"],["宮","みや"],["の"],["すべて"],["の"],["部分","ぶぶん"],["が"],["設計","せっけい"],["どおり"],["に"],["完成","かんせい"],["した"],["。"],["ソロモン"],["は"],["これ"],["を"],["建てる","たてる"],["のに"],["七","しち"],["年","ねん"],["を"],["要した","ようした"],["。"]]}]
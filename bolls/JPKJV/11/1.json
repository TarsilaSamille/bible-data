[{"verse":1,"text":"ダビデ王,おうは年,としがすすんで老,おい、夜着,よぎを着,きせても暖,あたたまらなかったので、","tok":[["ダビデ"],["王","おう"],["は"],["年","とし"],["が"],["すすんで"],["老","おい"],["、"],["夜着","よぎ"],["を"],["着せて","きせて"],["も"],["暖まらなかった","あたたまらなかった"],["ので"],["、"]]},{"verse":2,"text":"その家来,けらいたちは彼,かれに言,いった、「王,おうわが主,しゅのために、ひとりの若,わかいおとめを捜,さがし求,もとめて王,おうにはべらせ、王,おうの付添,つきそいとし、あなたのふところに寝,ねて、王,おうわが主,しゅを暖,あたためさせましょう」。","tok":[["その"],["家来","けらい"],["たち"],["は"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["王","おう"],["わが"],["主","しゅ"],["の"],["ため"],["に"],["、"],["ひとり"],["の"],["若い","わかい"],["おとめ"],["を"],["捜し求めて","さがしもとめて"],["王","おう"],["に"],["はべらせ"],["、"],["王","おう"],["の"],["付添","つきそい"],["と"],["し"],["、"],["あなた"],["の"],["ふところ"],["に"],["寝て","ねて"],["、"],["王","おう"],["わが"],["主","しゅ"],["を"],["暖めさせましょう","あたためさせましょう"],["」"],["。"]]},{"verse":3,"text":"そして彼,かれらはあまねくイスラエルの領土,りょうどに美,うつくしいおとめを捜,さがし求,もとめて、シュナミびとアビシャグを得,え、王,おうのもとに連,つれてきた。","tok":[["そして"],["彼","かれ"],["ら"],["は"],["あまねく"],["イスラエル"],["の"],["領土","りょうど"],["に"],["美しい","うつくしい"],["おとめ"],["を"],["捜し求めて","さがしもとめて"],["、"],["シュナミ"],["び"],["と"],["アビシャグ"],["を"],["得","え"],["、"],["王","おう"],["の"],["もと"],["に"],["連れて","つれて"],["きた"],["。"]]},{"verse":4,"text":"おとめは非常,ひじょうに美,うつくしく、王,おうの付添,つきそいとなって王,おうに仕,つかえたが、王,おうは彼女,かのじょを知,しることがなかった。","tok":[["おとめ"],["は"],["非常","ひじょう"],["に"],["美しく","うつくしく"],["、"],["王","おう"],["の"],["付添","つきそい"],["と"],["なって"],["王","おう"],["に"],["仕えた","つかえた"],["が"],["、"],["王","おう"],["は"],["彼女","かのじょ"],["を"],["知る","しる"],["こと"],["が"],["なかった"],["。"]]},{"verse":5,"text":"さてハギテの子,こアドニヤは高,たかぶって、「わたしは王,おうとなろう」と言,いい、自分,じぶんのために戦車,せんしゃと騎兵,きへいおよび自分,じぶんの前,まえに駆,かける者,もの五十人,にんを備,そなえた。","tok":[["さて"],["ハギテ"],["の"],["子","こ"],["アドニヤ"],["は"],["高か","たか"],["ぶっ"],["て"],["、"],["「"],["わたし"],["は"],["王","おう"],["と"],["なろう"],["」"],["と"],["言い","いい"],["、"],["自分","じぶん"],["の"],["ため"],["に"],["戦車","せんしゃ"],["と"],["騎兵","きへい"],["および"],["自分","じぶん"],["の"],["前","まえ"],["に"],["駆者","かけるもの"],["五","ご"],["十人","じゅうにん"],["を"],["備","そなえ"],["た"],["。"]]},{"verse":6,"text":"彼,かれの父,ちちは彼,かれが生,うまれてこのかた一度,ども「なぜ、そのような事,ことをするのか」と言,いって彼,かれをたしなめたことがなかった。アドニヤもまた非常,ひじょうに姿,すがたの良,よい人,ひとであって、アブサロムの次,つぎに生,うまれた者,ものである。","tok":[["彼","かれ"],["の"],["父","ちち"],["は"],["彼","かれ"],["が"],["生まれて","うまれて"],["このかた"],["一度","ど"],["も"],["「"],["なぜ"],["、"],["その"],["よう"],["な"],["事","こと"],["を"],["する"],["の"],["か"],["」"],["と"],["言って","いって"],["彼","かれ"],["を"],["たしなめた"],["こと"],["が"],["なかった"],["。"],["アドニヤ"],["も"],["また"],["非常","ひじょう"],["に"],["姿","すがた"],["の"],["良い","よい"],["人","ひと"],["で"],["あって"],["、"],["アブサロム"],["の"],["次","つぎ"],["に"],["生まれた","うまれた"],["者","もの"],["で"],["ある"],["。"]]},{"verse":7,"text":"彼,かれがゼルヤの子,こヨアブと祭司,さいしアビヤタルとに相談,そうだんしたので、彼,かれらはアドニヤに従,したがって彼,かれを助,たすけた。","tok":[["彼","かれ"],["が"],["ゼルヤ"],["の"],["子","こ"],["ヨアブ"],["と"],["祭司","さいし"],["アビヤタル"],["と"],["に"],["相談","そうだん"],["した"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["アドニヤ"],["に"],["従って","したがって"],["彼","かれ"],["を"],["助けた","たすけた"],["。"]]},{"verse":8,"text":"しかし祭司,さいしザドクと、エホヤダの子,こベナヤと、預言者,よげんしゃナタンおよびシメイとレイ、ならびにダビデの勇士,ゆうしたちはアドニヤに従,したがわなかった。","tok":[["しかし"],["祭司","さいし"],["ザドク"],["と"],["、"],["エホヤダ"],["の"],["子","こ"],["ベナヤ"],["と"],["、"],["預言者","よげんしゃ"],["ナタン"],["および"],["シメイ"],["と"],["レイ"],["、"],["ならびに"],["ダビデ"],["の"],["勇士","ゆうし"],["たち"],["は"],["アドニヤ"],["に"],["従わなかった","したがわなかった"],["。"]]},{"verse":9,"text":"アドニヤはエンロゲルのほとりにある「へびの石,いし」のかたわらで、羊,ひつじと牛,うしと肥,こえた家畜,かちくをほふって、王,おうの子,こである自分,じぶんの兄弟,きょうだいたち、および王,おうの家来,けらいであるユダの人々,ひとびとをことごとく招,まねいた。","tok":[["アドニヤ"],["は"],["エンロゲル"],["の"],["ほとり"],["に"],["ある"],["「"],["へび"],["の"],["石","いし"],["」"],["の"],["かたわら"],["で"],["、"],["羊","ひつじ"],["と"],["牛","うし"],["と"],["肥","こえ"],["た"],["家畜","かちく"],["を"],["ほふって"],["、"],["王","おう"],["の"],["子","こ"],["で"],["ある"],["自分","じぶん"],["の"],["兄弟","きょうだい"],["たち"],["、"],["および"],["王","おう"],["の"],["家来","けらい"],["で"],["ある"],["ユダ"],["の"],["人々","ひとびと"],["を"],["ことごとく"],["招いた","まねいた"],["。"]]},{"verse":10,"text":"しかし預言者,よげんしゃナタンと、ベナヤと、勇士,ゆうしたちと、自分,じぶんの兄弟,きょうだいソロモンとは招,まねかなかった。","tok":[["しかし"],["預言者","よげんしゃ"],["ナタン"],["と"],["、"],["ベナヤ"],["と"],["、"],["勇士","ゆうし"],["たち"],["と"],["、"],["自分","じぶん"],["の"],["兄弟","きょうだい"],["ソロモン"],["と"],["は"],["招かなかった","まねかなかった"],["。"]]},{"verse":11,"text":"時,ときにナタンはソロモンの母,ははバテシバに言,いった、「ハギテの子,こアドニヤが王,おうとなったのをお聞,ききになりませんでしたか。われわれの主,しゅダビデはそれをごぞんじないのです。","tok":[["時","とき"],["に"],["ナタン"],["は"],["ソロモン"],["の"],["母","はは"],["バテシバ"],["に"],["言った","いった"],["、"],["「"],["ハギテ"],["の"],["子","こ"],["アドニヤ"],["が"],["王","おう"],["と"],["なった"],["の"],["を"],["お聞","おきき"],["に"],["なりませんでした"],["か"],["。"],["われわれ"],["の"],["主","しゅ"],["ダビデ"],["は"],["それ"],["を"],["ごぞんじない"],["の"],["です"],["。"]]},{"verse":12,"text":"それでいま、あなたに計,はかりごとを授,さづけて、あなたの命,いのちと、あなたの子,こソロモンの命,いのちを救,すくうようにいたしましょう。","tok":[["それ"],["で"],["いま"],["、"],["あなた"],["に"],["計り","はかり"],["ごと"],["を"],["授","さ"],["づけて"],["、"],["あなた"],["の"],["命","いのち"],["と"],["、"],["あなた"],["の"],["子","こ"],["ソロモン"],["の"],["命","いのち"],["を"],["救う","すくう"],["よう"],["に"],["いたしましょう"],["。"]]},{"verse":13,"text":"あなたはすぐダビデ王,おうのところへ行,いって、『王,おうわが主,しゅよ、あなたは、はしために誓,ちかって、おまえの子,こソロモンが、わたしに次,ついで王,おうとなり、わたしの位,くらいに座,ざするであろうと言,いわれたではありませんか。そうであるのに、どうしてアドニヤが王,おうとなったのですか』と言,いいなさい。","tok":[["あなた"],["は"],["すぐ"],["ダビデ"],["王","おう"],["の"],["ところ"],["へ"],["行って","いって"],["、"],["『"],["王","おう"],["わが"],["主","しゅ"],["よ"],["、"],["あなた"],["は"],["、"],["はし"],["ため"],["に"],["誓って","ちかって"],["、"],["おまえ"],["の"],["子","こ"],["ソロモン"],["が"],["、"],["わたし"],["に"],["次いで","ついで"],["王","おう"],["と"],["なり"],["、"],["わたし"],["の"],["位","くらい"],["に"],["座するで","ざするで"],["あろう"],["と"],["言われたで","いわれたで"],["は"],["ありません"],["か"],["。"],["そう"],["で"],["ある"],["のに"],["、"],["どう"],["して"],["アドニヤ"],["が"],["王","おう"],["と"],["なった"],["の"],["です"],["か"],["』"],["と"],["言い","いい"],["なさい"],["。"]]},{"verse":14,"text":"あなたがなお王,おうと話,はなしておられる間,あいだに、わたしもまた、あなたのあとから、はいって行,いって、あなたの言葉,ことばを確認,かくにんしましょう」。","tok":[["あなた"],["が"],["なお"],["王","おう"],["と"],["話","はなし"],["て"],["おられる"],["間","あいだ"],["に"],["、"],["わたし"],["も"],["また"],["、"],["あなた"],["の"],["あと"],["から"],["、"],["はい"],["って"],["行って","いって"],["、"],["あなた"],["の"],["言葉","ことば"],["を"],["確認","かくにん"],["しましょう"],["」"],["。"]]},{"verse":15,"text":"そこでバテシバは寝室,しんしつにはいって王,おうの所,ところへ行,いった。（王,おうは非常,ひじょうに老,おいて、シュナミびとアビシャグが王,おうに仕,つかえていた）。","tok":[["そこ"],["で"],["バテシバ"],["は"],["寝室","しんしつ"],["に"],["はいって"],["王","おう"],["の"],["所","ところ"],["へ"],["行った","いった"],["。"],["（"],["王","おう"],["は"],["非常","ひじょう"],["に"],["老","おい"],["て"],["、"],["シュナミ"],["び"],["と"],["アビシャグ"],["が"],["王","おう"],["に"],["仕えて","つかえて"],["いた"],["）"],["。"]]},{"verse":16,"text":"バテシバは身,みをかがめて王,おうを拝,はいした。王,おうは言,いった、「何,なにの用,ようか」。","tok":[["バテシバ"],["は"],["身","み"],["を"],["かがめて"],["王","おう"],["を"],["拝した","はいした"],["。"],["王","おう"],["は"],["言った","いった"],["、"],["「"],["何","なに"],["の"],["用","よう"],["か"],["」"],["。"]]},{"verse":17,"text":"彼女,かのじょは王,おうに言,いった、「わが主,しゅよ、あなたは、あなたの神,かみ、主,しゅをさして、はしために誓,ちかい、『おまえの子,こソロモンがわたしに次,ついで王,おうとなり、わたしの位,くらいに座,ざするであろう』と言,いわれました。","tok":[["彼女","かのじょ"],["は"],["王","おう"],["に"],["言った","いった"],["、"],["「"],["わが"],["主","しゅ"],["よ"],["、"],["あなた"],["は"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["を"],["さして"],["、"],["はし"],["ため"],["に"],["誓い","ちかい"],["、"],["『"],["おまえ"],["の"],["子","こ"],["ソロモン"],["が"],["わたし"],["に"],["次いで","ついで"],["王","おう"],["と"],["なり"],["、"],["わたし"],["の"],["位","くらい"],["に"],["座するで","ざするで"],["あろう"],["』"],["と"],["言われました","いわれました"],["。"]]},{"verse":18,"text":"そうであるのに、ごらんなさい、今,いまアドニヤが王,おうとなりました。王,おうわが主,しゅよ、あなたはそれをごぞんじないのです。","tok":[["そう"],["で"],["ある"],["のに"],["、"],["ごらん"],["なさい"],["、"],["今","いま"],["アドニヤ"],["が"],["王","おう"],["と"],["なりました"],["。"],["王","おう"],["わが"],["主","しゅ"],["よ"],["、"],["あなた"],["は"],["それ"],["を"],["ごぞんじない"],["の"],["です"],["。"]]},{"verse":19,"text":"彼,かれは牛,うしと肥,こえた家畜,かちくと羊,ひつじをたくさんほふって、王,おうの子,こたち、および祭司,さいしアビヤタルと、軍,ぐんの長,ちょうヨアブを招,まねきましたが、あなたのしもべソロモンは招,まねきませんでした。","tok":[["彼","かれ"],["は"],["牛","うし"],["と"],["肥","こえ"],["た"],["家畜","かちく"],["と"],["羊","ひつじ"],["を"],["たくさん"],["ほふって"],["、"],["王","おう"],["の"],["子","こ"],["たち"],["、"],["および"],["祭司","さいし"],["アビヤタル"],["と"],["、"],["軍","ぐん"],["の"],["長う","ちょう"],["ヨアブ"],["を"],["招きました","まねきました"],["が"],["、"],["あなた"],["の"],["しもべ"],["ソロモン"],["は"],["招きませんでした","まねきませんでした"],["。"]]},{"verse":20,"text":"王,おうわが主,しゅよ、イスラエルのすべての目,めはあなたに注,そそがれ、だれがあなたに次,ついで、王,おうわが主,しゅの位,くらいに座,ざすべきかを告,つげられるのを望,のぞんでいます。","tok":[["王","おう"],["わが"],["主","しゅ"],["よ"],["、"],["イスラエル"],["の"],["すべて"],["の"],["目","め"],["は"],["あなた"],["に"],["注がれ","そそがれ"],["、"],["だれ"],["が"],["あなた"],["に"],["次いで","ついで"],["、"],["王","おう"],["わが"],["主","しゅ"],["の"],["位","くらい"],["に"],["座すべき","ざすべき"],["か"],["を"],["告げられる","つげられる"],["の"],["を"],["望んで","のぞんで"],["います"],["。"]]},{"verse":21,"text":"王,おうわが主,しゅが先祖,せんぞと共,ともに眠,ねむられるとき、わたしと、わたしの子,こソロモンは謀叛,むほん人,ひととみなされるでしょう」。","tok":[["王","おう"],["わが"],["主","しゅ"],["が"],["先祖","せんぞ"],["と"],["共","とも"],["に"],["眠られる","ねむられる"],["とき"],["、"],["わたし"],["と"],["、"],["わたし"],["の"],["子","こ"],["ソロモン"],["は"],["謀叛人","むほんひと"],["と"],["みなされるでしょう"],["」"],["。"]]},{"verse":22,"text":"バテシバがなお王,おうと話,はなしているうちに、預言者,よげんしゃナタンがはいってきた。","tok":[["バテシバ"],["が"],["なお"],["王","おう"],["と"],["話","はなし"],["て"],["いる"],["うち"],["に"],["、"],["預言者","よげんしゃ"],["ナタン"],["が"],["はいって"],["きた"],["。"]]},{"verse":23,"text":"人々,ひとびとは王,おうに告,つげて、「預言者,よげんしゃナタンがここにおります」と言,いった。彼,かれは王,おうの前,まえにはいり、地,ちに伏,ふして王,おうを拝,はいした。","tok":[["人々","ひとびと"],["は"],["王","おう"],["に"],["告","つげ"],["て"],["、"],["「"],["預言者","よげんしゃ"],["ナタン"],["が"],["ここ"],["に"],["おります"],["」"],["と"],["言った","いった"],["。"],["彼","かれ"],["は"],["王","おう"],["の"],["前","まえ"],["に"],["はいり"],["、"],["地","ち"],["に"],["伏して","ふして"],["王","おう"],["を"],["拝した","はいした"],["。"]]},{"verse":24,"text":"そしてナタンは言,いった、「王,おうわが主,しゅよ、あなたは、『アドニヤがわたしに次,ついで王,おうとなり、わたしの位,くらいに座,ざするであろう』と仰,おおせられましたか。","tok":[["そして"],["ナタン"],["は"],["言った","いった"],["、"],["「"],["王","おう"],["わが"],["主","しゅ"],["よ"],["、"],["あなた"],["は"],["、"],["『"],["アドニヤ"],["が"],["わたし"],["に"],["次いで","ついで"],["王","おう"],["と"],["なり"],["、"],["わたし"],["の"],["位","くらい"],["に"],["座するで","ざするで"],["あろう"],["』"],["と"],["仰せられました","おおせられました"],["か"],["。"]]},{"verse":25,"text":"彼,かれはきょう下,くだっていって、牛,うしと、肥,こえた家畜,かちくと羊,ひつじをたくさんほふって、王,おうの子,こたちと、軍,ぐんの長,ちょうヨアブと、祭司,さいしアビヤタルを招,まねきました。彼,かれらはアドニヤの前,まえで食,くい飲,のみして、『アドニヤ万歳,ばんざい』と言,いいました。","tok":[["彼","かれ"],["は"],["きょう"],["下って","くだって"],["いって"],["、"],["牛","うし"],["と"],["、"],["肥","こえ"],["た"],["家畜","かちく"],["と"],["羊","ひつじ"],["を"],["たくさん"],["ほふって"],["、"],["王","おう"],["の"],["子","こ"],["たち"],["と"],["、"],["軍","ぐん"],["の"],["長う","ちょう"],["ヨアブ"],["と"],["、"],["祭司","さいし"],["アビヤタル"],["を"],["招きました","まねきました"],["。"],["彼","かれ"],["ら"],["は"],["アドニヤ"],["の"],["前","まえ"],["で"],["食い","くい"],["飲み","のみ"],["して"],["、"],["『"],["アドニヤ"],["万歳","ばんざい"],["』"],["と"],["言いました","いいました"],["。"]]},{"verse":26,"text":"しかし、あなたのしもべであるわたしと、祭司,さいしザドクと、エホヤダの子,こベナヤと、あなたのしもべソロモンを招,まねきませんでした。","tok":[["しかし"],["、"],["あなた"],["の"],["しもべ"],["で"],["ある"],["わたし"],["と"],["、"],["祭司","さいし"],["ザドク"],["と"],["、"],["エホヤダ"],["の"],["子","こ"],["ベナヤ"],["と"],["、"],["あなた"],["の"],["しもべ"],["ソロモン"],["を"],["招きませんでした","まねきませんでした"],["。"]]},{"verse":27,"text":"この事,ことは王,おうわが主,しゅがさせられた事,ことですか。あなたはしもべたちに、だれがあなたに次,ついで王,おうわが主,しゅの位,くらいに座,ざすべきかを告,つげられませんでした」。","tok":[["この"],["事","こと"],["は"],["王","おう"],["わが"],["主","しゅ"],["が"],["させられた"],["事","こと"],["です"],["か"],["。"],["あなた"],["は"],["しもべ"],["たち"],["に"],["、"],["だれ"],["が"],["あなた"],["に"],["次いで","ついで"],["王","おう"],["わが"],["主","しゅ"],["の"],["位","くらい"],["に"],["座すべき","ざすべき"],["か"],["を"],["告げられませんでした","つげられませんでした"],["」"],["。"]]},{"verse":28,"text":"ダビデ王,おうは答,こたえて言,いった、「バテシバをわたしのところに呼,よびなさい」。彼女,かのじょは王,おうの前,まえにはいってきて、王,おうの前,まえに立,たった。","tok":[["ダビデ"],["王","おう"],["は"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["バテシバ"],["を"],["わたし"],["の"],["ところ"],["に"],["呼び","よび"],["なさい"],["」"],["。"],["彼女","かのじょ"],["は"],["王","おう"],["の"],["前","まえ"],["に"],["はいって"],["きて"],["、"],["王","おう"],["の"],["前","まえ"],["に"],["立った","たった"],["。"]]},{"verse":29,"text":"すると王,おうは誓,ちかって言,いった、「わたしの命,いのちをすべての苦難,くなんから救,すくわれた主,しゅは生,いきておられる。","tok":[["する"],["と"],["王","おう"],["は"],["誓って","ちかって"],["言った","いった"],["、"],["「"],["わたし"],["の"],["命","いのち"],["を"],["すべて"],["の"],["苦難","くなん"],["から"],["救われた","すくわれた"],["主","しゅ"],["は"],["生きて","いきて"],["おられる"],["。"]]},{"verse":30,"text":"わたしがイスラエルの神,かみ、主,しゅをさしてあなたに誓,ちかい、『あなたの子,こソロモンがわたしに次,ついで王,おうとなり、わたしに代,かわって、わたしの位,くらいに座,ざするであろう』と言,いったように、わたしはきょう、そのようにしよう」。","tok":[["わたし"],["が"],["イスラエル"],["の"],["神","かみ"],["、"],["主","しゅ"],["を"],["さして"],["あなた"],["に"],["誓い","ちかい"],["、"],["『"],["あなた"],["の"],["子","こ"],["ソロモン"],["が"],["わたし"],["に"],["次いで","ついで"],["王","おう"],["と"],["なり"],["、"],["わたし"],["に"],["代わって","かわって"],["、"],["わたし"],["の"],["位","くらい"],["に"],["座するで","ざするで"],["あろう"],["』"],["と"],["言った","いった"],["よう"],["に"],["、"],["わたし"],["は"],["きょう"],["、"],["その"],["よう"],["に"],["しよう"],["」"],["。"]]},{"verse":31,"text":"そこでバテシバは身,みをかがめ、地,ちに伏,ふして王,おうを拝,はいし、「わが主,しゅダビデ王,おうが、とこしえに生,いきながらえられますように」と言,いった。","tok":[["そこ"],["で"],["バテシバ"],["は"],["身","み"],["を"],["かがめ"],["、"],["地","ち"],["に"],["伏して","ふして"],["王","おう"],["を"],["拝し","はいし"],["、"],["「"],["わが"],["主","しゅ"],["ダビデ"],["王","おう"],["が"],["、"],["とこしえ"],["に"],["生きながらえられます","いきながらえられます"],["よう"],["に"],["」"],["と"],["言った","いった"],["。"]]},{"verse":32,"text":"ダビデは言,いった、「祭司,さいしザドクと、預言者,よげんしゃナタンおよびエホヤダの子,こベナヤをわたしの所,ところに呼,よびなさい」。やがて彼,かれらは王,おうの前,まえにきた。","tok":[["ダビデ"],["は"],["言った","いった"],["、"],["「"],["祭司","さいし"],["ザドク"],["と"],["、"],["預言者","よげんしゃ"],["ナタン"],["および"],["エホヤダ"],["の"],["子","こ"],["ベナヤ"],["を"],["わたし"],["の"],["所","ところ"],["に"],["呼び","よび"],["なさい"],["」"],["。"],["やがて"],["彼","かれ"],["ら"],["は"],["王","おう"],["の"],["前","まえ"],["に"],["きた"],["。"]]},{"verse":33,"text":"王,おうは彼,かれらに言,いった、「あなたがたの主君,しゅくんの家来,けらいたちを連,つれ、わが子,こソロモンをわたしの騾馬,らばに乗,のせ、彼,かれを導,みちびいてギホンに下,くだり、","tok":[["王","おう"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["の"],["主君","しゅくん"],["の"],["家来","けらい"],["たち"],["を"],["連れ","つれ"],["、"],["わが"],["子","こ"],["ソロモン"],["を"],["わたし"],["の"],["騾馬","らば"],["に"],["乗せ","のせ"],["、"],["彼","かれ"],["を"],["導いて","みちびいて"],["ギホン"],["に"],["下り","くだり"],["、"]]},{"verse":34,"text":"その所,ところで祭司,さいしザドクと預言者,よげんしゃナタンは彼,かれに油,あぶらを注,そそいでイスラエルの王,おうとしなさい。そしてラッパを吹,ふいて、『ソロモン王,おう万歳,ばんざい』と言,いいなさい。","tok":[["その"],["所","ところ"],["で"],["祭司","さいし"],["ザドク"],["と"],["預言者","よげんしゃ"],["ナタン"],["は"],["彼","かれ"],["に"],["油","あぶら"],["を"],["注いで","そそいで"],["イスラエル"],["の"],["王","おう"],["と"],["し"],["なさい"],["。"],["そして"],["ラッパ"],["を"],["吹いて","ふいて"],["、"],["『"],["ソロモン"],["王","おう"],["万歳","ばんざい"],["』"],["と"],["言い","いい"],["なさい"],["。"]]},{"verse":35,"text":"それから、あなたがたは彼,かれに従,したがって上,のぼってきなさい。彼,かれはきて、わたしの位,くらいに座,ざし、わたしに代,かわって王,おうとなるであろう。わたしは彼,かれを立,たててイスラエルとユダの上,うえに主君,しゅくんとする」。","tok":[["それ"],["から"],["、"],["あなた"],["がた"],["は"],["彼","かれ"],["に"],["従って","したがって"],["上って","のぼって"],["き"],["なさい"],["。"],["彼","かれ"],["は"],["きて"],["、"],["わたし"],["の"],["位","くらい"],["に"],["座し","ざし"],["、"],["わたし"],["に"],["代わって","かわって"],["王","おう"],["と"],["なるで"],["あろう"],["。"],["わたし"],["は"],["彼","かれ"],["を"],["立てて","たてて"],["イスラエル"],["と"],["ユダ"],["の"],["上","うえ"],["に"],["主君","しゅくん"],["と"],["する"],["」"],["。"]]},{"verse":36,"text":"エホヤダの子,こベナヤは王,おうに答,こたえて言,いった、「アァメン、願,ねがわくは、王,おうわが主君,しゅくんの神,かみ、主,しゅもまたそう仰,おおせられますように。","tok":[["エホヤダ"],["の"],["子","こ"],["ベナヤ"],["は"],["王","おう"],["に"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["アァメン"],["、"],["願わく","ねがわく"],["は"],["、"],["王","おう"],["わが"],["主君","しゅくん"],["の"],["神","かみ"],["、"],["主","しゅ"],["も"],["また"],["そう"],["仰せられます","おおせられます"],["よう"],["に"],["。"]]},{"verse":37,"text":"願,ねがわくは、主,しゅが王,おうわが主君,しゅくんと共,ともにおられたように、ソロモンと共,ともにおられて、その位,くらいをわが主君,しゅくんダビデ王,おうの位,くらいよりも大,おおきくせられますように」。","tok":[["願わく","ねがわく"],["は"],["、"],["主","しゅ"],["が"],["王","おう"],["わが"],["主君","しゅくん"],["と"],["共","とも"],["に"],["おられた"],["よう"],["に"],["、"],["ソロモン"],["と"],["共","とも"],["に"],["おられて"],["、"],["その"],["位","くらい"],["を"],["わが"],["主君","しゅくん"],["ダビデ"],["王","おう"],["の"],["位","くらい"],["より"],["も"],["大きく","おおきく"],["せられます"],["よう"],["に"],["」"],["。"]]},{"verse":38,"text":"そこで祭司,さいしザドクと預言者,よげんしゃナタンおよびエホヤダの子,こベナヤ、ならびにケレテびとと、ペレテびとは下,くだって行,いって、ソロモンをダビデ王,おうの騾馬,らばに乗,のせ、彼,かれをギホンに導,みちびいて行,いった。","tok":[["そこ"],["で"],["祭司","さいし"],["ザドク"],["と"],["預言者","よげんしゃ"],["ナタン"],["および"],["エホヤダ"],["の"],["子","こ"],["ベナヤ"],["、"],["ならびに"],["ケレテ"],["びと"],["と"],["、"],["ペレテ"],["びと"],["は"],["下って","くだって"],["行って","いって"],["、"],["ソロモン"],["を"],["ダビデ"],["王","おう"],["の"],["騾馬","らば"],["に"],["乗せ","のせ"],["、"],["彼","かれ"],["を"],["ギホン"],["に"],["導いて","みちびいて"],["行った","いった"],["。"]]},{"verse":39,"text":"祭司,さいしザドクは幕屋,まくやから油,あぶらの角,つのを取,とってきて、ソロモンに油,あぶらを注,そそいだ。そしてラッパを吹,ふき鳴,ならし、民,たみは皆,みな「ソロモン王,おう万歳,ばんざい」と言,いった。","tok":[["祭司","さいし"],["ザドク"],["は"],["幕屋","まくや"],["から"],["油","あぶら"],["の"],["角","つ"],["の"],["を"],["取って","とって"],["きて"],["、"],["ソロモン"],["に"],["油","あぶら"],["を"],["注いだ","そそいだ"],["。"],["そして"],["ラッパ"],["を"],["吹鳴","ふきな"],["らし"],["、"],["民","たみ"],["は"],["皆","みな"],["「"],["ソロモン"],["王","おう"],["万歳","ばんざい"],["」"],["と"],["言った","いった"],["。"]]},{"verse":40,"text":"民,たみはみな彼,かれに従,したがって上,のぼり、笛,ふえを吹,ふいて大,おおいに喜,よろこび祝,いわった。地,ちは彼,かれらの声,こえで裂,さけるばかりであった。","tok":[["民","たみ"],["は"],["みな"],["彼","かれ"],["に"],["従って","したがって"],["上り","のぼり"],["、"],["笛","ふえ"],["を"],["吹いて","ふいて"],["大いに","おおいに"],["喜こび","よろこび"],["祝った","いわった"],["。"],["地","ち"],["は"],["彼","かれ"],["ら"],["の"],["声","こえ"],["で"],["裂ける","さける"],["ばかり"],["で"],["あった"],["。"]]},{"verse":41,"text":"アドニヤおよび彼,かれと共,ともにいた客,きゃくたちは皆,みな食事,しょくじを終,おわったとき、これを聞,きいた。ヨアブはラッパの音,おとを聞,きいて言,いった、「町,まちの中,なかのあの騒,さわぎは何,なにか」。","tok":[["アドニヤ"],["および"],["彼","かれ"],["と"],["共","とも"],["に"],["いた"],["客","きゃく"],["たち"],["は"],["皆","みな"],["食事","しょくじ"],["を"],["終わった","おわった"],["とき"],["、"],["これ"],["を"],["聞いた","きいた"],["。"],["ヨアブ"],["は"],["ラッパ"],["の"],["音","おと"],["を"],["聞いて","きいて"],["言った","いった"],["、"],["「"],["町","まち"],["の"],["中","なか"],["の"],["あの"],["騒","さわぎ"],["は"],["何に","なに"],["か"],["」"],["。"]]},{"verse":42,"text":"彼,かれの言葉,ことばのなお終,おわらないうちに、そこへ祭司,さいしアビヤタルの子,こヨナタンがきたので、アドニヤは彼,かれに言,いった、「はいりなさい。あなたは勇敢,ゆうかんな人,ひとで、よい知,しらせを持,もってきたのでしょう」。","tok":[["彼","かれ"],["の"],["言葉","ことば"],["の"],["なお"],["終わらない","おわらない"],["うち"],["に"],["、"],["そこ"],["へ"],["祭司","さいし"],["アビヤタル"],["の"],["子","こ"],["ヨナタン"],["が"],["きた"],["ので"],["、"],["アドニヤ"],["は"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["はいり"],["なさい"],["。"],["あなた"],["は"],["勇敢","ゆうかん"],["な"],["人","ひと"],["で"],["、"],["よい"],["知らせ","しらせ"],["を"],["持って","もって"],["きた"],["の"],["でしょう"],["」"],["。"]]},{"verse":43,"text":"ヨナタンは答,こたえてアドニヤに言,いった、「いいえ、主君,しゅくんダビデ王,おうはソロモンを王,おうとせられました。","tok":[["ヨナタン"],["は"],["答","こたえ"],["て"],["アドニヤ"],["に"],["言った","いった"],["、"],["「"],["いいえ"],["、"],["主君","しゅくん"],["ダビデ"],["王","おう"],["は"],["ソロモン"],["を"],["王","おう"],["と"],["せられました"],["。"]]},{"verse":44,"text":"王,おうは祭司,さいしザドクと預言者,よげんしゃナタンおよびエホヤダの子,こベナヤ、ならびにケレテびとと、ペレテびとをソロモンと共,ともにつかわされたので、彼,かれらはソロモンを王,おうの騾馬,らばに乗,のせて行,いき、","tok":[["王","おう"],["は"],["祭司","さいし"],["ザドク"],["と"],["預言者","よげんしゃ"],["ナタン"],["および"],["エホヤダ"],["の"],["子","こ"],["ベナヤ"],["、"],["ならびに"],["ケレテ"],["びと"],["と"],["、"],["ペレテ"],["びと"],["を"],["ソロモン"],["と"],["共","とも"],["に"],["つかわされた"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["ソロモン"],["を"],["王","おう"],["の"],["騾馬","らば"],["に"],["乗せて","のせて"],["行き","いき"],["、"]]},{"verse":45,"text":"祭司,さいしザドクと預言者,よげんしゃナタンはギホンで彼,かれに油,あぶらを注,そそいで王,おうとしました。そして彼,かれらがそこから喜,よろこんで上,のぼって来,くるので、町,まちが騒,さわがしいのです。あなたが聞,きいた声,こえはそれなのです。","tok":[["祭司","さいし"],["ザドク"],["と"],["預言者","よげんしゃ"],["ナタン"],["は"],["ギホン"],["で"],["彼","かれ"],["に"],["油","あぶら"],["を"],["注いで","そそいで"],["王","おう"],["と"],["しました"],["。"],["そして"],["彼","かれ"],["ら"],["が"],["そこ"],["から"],["喜こんで","よろこんで"],["上って","のぼって"],["来る","くる"],["ので"],["、"],["町","まち"],["が"],["騒がしい","さわがしい"],["の"],["です"],["。"],["あなた"],["が"],["聞いた","きいた"],["声","こえ"],["は"],["それ"],["な"],["の"],["です"],["。"]]},{"verse":46,"text":"こうしてソロモンは王,おうの位,くらいに座,ざし、","tok":[["こう"],["して"],["ソロモン"],["は"],["王","おう"],["の"],["位","くらい"],["に"],["座し","ざし"],["、"]]},{"verse":47,"text":"かつ王,おうの家来,けらいたちがきて、主君,しゅくんダビデ王,おうに祝,いわいを述,のべて、『願,ねがわくは、あなたの神,かみがソロモンの名,なをあなたの名,なよりも高,たかくし、彼,かれの位,くらいをあなたの位,くらいよりも大,おおきくされますように』と言,いいました。そして王,おうは床,ゆかの上,うえで拝,はいされました。","tok":[["かつ"],["王","おう"],["の"],["家来","けらい"],["たち"],["が"],["きて"],["、"],["主君","しゅくん"],["ダビデ"],["王","おう"],["に"],["祝い","いわい"],["を"],["述べて","のべて"],["、"],["『"],["願わく","ねがわく"],["は"],["、"],["あなた"],["の"],["神","かみ"],["が"],["ソロモン"],["の"],["名","な"],["を"],["あなた"],["の"],["名","な"],["より"],["も"],["高かく","たかく"],["し"],["、"],["彼","かれ"],["の"],["位","くらい"],["を"],["あなた"],["の"],["位","くらい"],["より"],["も"],["大きく","おおきく"],["されます"],["よう"],["に"],["』"],["と"],["言いました","いいました"],["。"],["そして"],["王","おう"],["は"],["床","ゆか"],["の"],["上","うえ"],["で"],["拝されました","はいされました"],["。"]]},{"verse":48,"text":"王,おうはまたこう言,いわれました、『イスラエルの神,かみ、主,しゅはほむべきかな。主,しゅはきょう、わたしの位,くらいに座,ざするひとりの子,こを与,あたえて、これをわたしに見,みせてくださった』と」。","tok":[["王","おう"],["は"],["また"],["こう"],["言われました","いわれました"],["、"],["『"],["イスラエル"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["ほ"],["むべき"],["か"],["な"],["。"],["主","しゅ"],["は"],["きょう"],["、"],["わたし"],["の"],["位","くらい"],["に"],["座する","ざする"],["ひとり"],["の"],["子","こ"],["を"],["与","あたえ"],["て"],["、"],["これ"],["を"],["わたし"],["に"],["見せて","みせて"],["くださった"],["』"],["と"],["」"],["。"]]},{"verse":49,"text":"その時,ときアドニヤと共,ともにいた客,きゃくはみな驚,おどろき、立,たっておのおの自分,じぶんの道,みちに去,さって行,いった。","tok":[["その"],["時","とき"],["アドニヤ"],["と"],["共","とも"],["に"],["いた"],["客","きゃく"],["は"],["みな"],["驚","おどろき"],["、"],["立って","たって"],["おのおの"],["自分","じぶん"],["の"],["道","みち"],["に"],["去て","さって"],["行った","いった"],["。"]]},{"verse":50,"text":"そしてアドニヤはソロモンを恐,おそれ、立,たって行,いって祭壇,さいだんの角,つのをつかんだ。","tok":[["そして"],["アドニヤ"],["は"],["ソロモン"],["を"],["恐","おそれ"],["、"],["立って","たって"],["行って","いって"],["祭壇","さいだん"],["の"],["角","つ"],["の"],["を"],["つかんだ"],["。"]]},{"verse":51,"text":"ある人,ひとがこれをソロモンに告,つげて言,いった、「アドニヤはソロモンを恐,おそれ、今,いま彼,かれは祭壇,さいだんの角,つのをつかんで、『どうぞ、ソロモン王,おうがきょう、つるぎをもってしもべを殺,ころさないとわたしに誓,ちかってくださるように』と言,いっています」。","tok":[["ある"],["人","ひと"],["が"],["これ"],["を"],["ソロモン"],["に"],["告","つげ"],["て"],["言った","いった"],["、"],["「"],["アドニヤ"],["は"],["ソロモン"],["を"],["恐","おそれ"],["、"],["今","いま"],["彼","かれ"],["は"],["祭壇","さいだん"],["の"],["角","つ"],["の"],["を"],["つかんで"],["、"],["『"],["どうぞ"],["、"],["ソロモン"],["王","おう"],["が"],["きょう"],["、"],["つるぎ"],["を"],["もって"],["しもべ"],["を"],["殺ろさない","ころさない"],["と"],["わたし"],["に"],["誓って","ちかって"],["くださる"],["よう"],["に"],["』"],["と"],["言って","いって"],["います"],["」"],["。"]]},{"verse":52,"text":"ソロモンは言,いった、「もし彼,かれがよい人,ひととなるならば、その髪,かみの毛,けひとすじも地,ちに落,おちることはなかろう。しかし彼,かれのうちに悪,あくのあることがわかるならば、彼,かれは死,しななければならない」。","tok":[["ソロモン"],["は"],["言った","いった"],["、"],["「"],["もし"],["彼","かれ"],["が"],["よい"],["人","ひと"],["と"],["なるならば"],["、"],["その"],["髪の毛","かみのけ"],["ひとすじ"],["も"],["地","ち"],["に"],["落","おち"],["る"],["こと"],["は"],["なかろう"],["。"],["しかし"],["彼","かれ"],["の"],["うち"],["に"],["悪","あく"],["の"],["ある"],["こと"],["が"],["わかるならば"],["、"],["彼","かれ"],["は"],["死ななければ","しななければ"],["ならない"],["」"],["。"]]},{"verse":53,"text":"ソロモンは人,ひとをつかわして彼,かれを祭壇,さいだんからつれて下,くだらせた。彼,かれがきてソロモンを拝,はいしたので、ソロモンは彼,かれに「家,いえに帰,かえりなさい」と言,いった。","tok":[["ソロモン"],["は"],["人","ひと"],["を"],["つかわして"],["彼","かれ"],["を"],["祭壇","さいだん"],["から"],["つれて"],["下らせた","くだらせた"],["。"],["彼","かれ"],["が"],["きて"],["ソロモン"],["を"],["拝した","はいした"],["ので"],["、"],["ソロモン"],["は"],["彼","かれ"],["に"],["「"],["家","いえ"],["に"],["帰えり","かえり"],["なさい"],["」"],["と"],["言った","いった"],["。"]]}]
[{"verse":1,"text":"レハベアムはシケムへ行,いった。すべてのイスラエルびとが彼,かれを王,おうにしようとシケムへ行,いったからである。","tok":[["レハベアム"],["は"],["シケム"],["へ"],["行った","いった"],["。"],["すべて"],["の"],["イスラエル"],["びと"],["が"],["彼","かれ"],["を"],["王","おう"],["に"],["しよう"],["と"],["シケム"],["へ"],["行った","いった"],["から"],["で"],["ある"],["。"]]},{"verse":2,"text":"ネバテの子,こヤラベアムはソロモンを避,さけてエジプトにのがれ、なおそこにいたが、これを聞,きいてエジプトから帰,かえったので、","tok":[["ネバテ"],["の"],["子","こ"],["ヤラベアム"],["は"],["ソロモン"],["を"],["避けて","さけて"],["エジプト"],["に"],["のがれ"],["、"],["なお"],["そこ"],["に"],["いた"],["が"],["、"],["これ"],["を"],["聞いて","きいて"],["エジプト"],["から"],["帰えった","かえった"],["ので"],["、"]]},{"verse":3,"text":"人々,ひとびとは人,ひとをつかわして彼,かれを招,まねいた。そしてヤラベアムとイスラエルの会衆,かいしゅうは皆,みなレハベアムの所,ところにきて言,いった、","tok":[["人々","ひとびと"],["は"],["人","ひと"],["を"],["つかわして"],["彼","かれ"],["を"],["招いた","まねいた"],["。"],["そして"],["ヤラベアム"],["と"],["イスラエル"],["の"],["会衆","かいしゅう"],["は"],["皆","みな"],["レハベアム"],["の"],["所","ところ"],["に"],["きて"],["言った","いった"],["、"]]},{"verse":4,"text":"「父上,ちちうえはわれわれのくびきを重,おもくされましたが、今,いま父上,ちちうえのきびしい使役,しえきと、父上,ちちうえがわれわれに負,おわせられた重,おもいくびきとを軽,かるくしてください。そうすればわれわれはあなたに仕,つかえます」。","tok":[["「"],["父上","ちちうえ"],["は"],["われわれ"],["の"],["くびき"],["を"],["重く","おもく"],["されました"],["が"],["、"],["今","いま"],["父上","ちちうえ"],["の"],["きびしい"],["使役","しえき"],["と"],["、"],["父","ちち"],["上","うえ"],["が"],["われわれ"],["に"],["負わせられた","おわせられた"],["重い","おもい"],["くびき"],["と"],["を"],["軽く","かるく"],["して"],["ください"],["。"],["そう"],["すれば"],["われわれ"],["は"],["あなた"],["に"],["仕えます","つかえます"],["」"],["。"]]},{"verse":5,"text":"レハベアムは彼,かれらに言,いった、「去,さって、三日,か過,すぎてから、またわたしのところにきなさい」。それで民,たみは立,たち去,さった。","tok":[["レハベアム"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["去て","さって"],["、"],["三日","か"],["過て","すぎて"],["から"],["、"],["また"],["わたし"],["の"],["ところ"],["に"],["き"],["なさい"],["」"],["。"],["それ"],["で"],["民","たみ"],["は"],["立ち","たち"],["去た","さった"],["。"]]},{"verse":6,"text":"レハベアム王,おうは父,ちちソロモンの存命,ぞんめい中,なかソロモンに仕,つかえた老人,ろうじんたちに相談,そうだんして言,いった、「この民,たみにどう返答,へんとうすればよいと思,おもいますか」。","tok":[["レハベアム"],["王","おう"],["は"],["父","ちち"],["ソロモン"],["の"],["存命中","ぞんめいなか"],["ソロモン"],["に"],["仕えた","つかえた"],["老人","ろうじん"],["たち"],["に"],["相談","そうだん"],["して"],["言った","いった"],["、"],["「"],["この"],["民","たみ"],["に"],["どう"],["返答","へんとう"],["すれば"],["よい"],["と"],["思います","おもいます"],["か"],["」"],["。"]]},{"verse":7,"text":"彼,かれらはレハベアムに言,いった、「もし、あなたが、きょう、この民,たみのしもべとなって彼,かれらに仕,つかえ、彼,かれらに答,こたえるとき、ねんごろに語,かたられるならば、彼,かれらは永久,えいきゅうにあなたのしもべとなるでしょう」。","tok":[["彼","かれ"],["ら"],["は"],["レハベアム"],["に"],["言った","いった"],["、"],["「"],["もし"],["、"],["あなた"],["が"],["、"],["きょう"],["、"],["この"],["民","たみ"],["の"],["しもべ"],["と"],["なって"],["彼","かれ"],["ら"],["に"],["仕え","つかえ"],["、"],["彼","かれ"],["ら"],["に"],["答","こたえ"],["る"],["とき"],["、"],["ねんごろ"],["に"],["語られるならば","かたられるならば"],["、"],["彼","かれ"],["ら"],["は"],["永久","えいきゅう"],["に"],["あなた"],["の"],["しもべ"],["と"],["なるでしょう"],["」"],["。"]]},{"verse":8,"text":"しかし彼,かれは老人,ろうじんたちが与,あたえた勧,すすめを捨,すてて、自分,じぶんと一緒,いっしょに大,おおきくなって自分,じぶんに仕,つかえている若者,わかものたちに相談,そうだんして、","tok":[["しかし"],["彼","かれ"],["は"],["老人","ろうじん"],["たち"],["が"],["与","あたえ"],["た"],["勧め","すすめ"],["を"],["捨てて","すてて"],["、"],["自分","じぶん"],["と"],["一緒","いっしょ"],["に"],["大きく","おおきく"],["なって"],["自分","じぶん"],["に"],["仕えて","つかえて"],["いる"],["若者","わかもの"],["たち"],["に"],["相談","そうだん"],["して"],["、"]]},{"verse":9,"text":"彼,かれらに言,いった、「この民,たみがわたしにむかって『あなたの父,ちちがわれわれに負,おわせたくびきを軽,かるくしてください』というのに、われわれはなんと返答,へんとうすればよいと思,おもいますか」。","tok":[["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["この"],["民","たみ"],["が"],["わたし"],["に"],["むかって"],["『"],["あなた"],["の"],["父","ちち"],["が"],["われわれ"],["に"],["負わせた","おわせた"],["くびき"],["を"],["軽く","かるく"],["して"],["ください"],["』"],["と"],["いう"],["のに"],["、"],["われわれ"],["は"],["なん"],["と"],["返答","へんとう"],["すれば"],["よい"],["と"],["思います","おもいます"],["か"],["」"],["。"]]},{"verse":10,"text":"彼,かれと一緒,いっしょに大,おおきくなった若者,わかものたちは彼,かれに言,いった、「あなたにむかって『父上,ちちうえはわれわれのくびきを重,おもくされましたが、あなたは、それをわれわれのために軽,かるくしてください』と言,いうこの民,たみに、こう言,いいなさい、『わたしの小指,こゆびは父,ちちの腰,こしよりも太,ふとい。","tok":[["彼","かれ"],["と"],["一緒","いっしょ"],["に"],["大きく","おおきく"],["なった"],["若者","わかもの"],["たち"],["は"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["に"],["むかって"],["『"],["父上","ちちうえ"],["は"],["われわれ"],["の"],["くびき"],["を"],["重く","おもく"],["されました"],["が"],["、"],["あなた"],["は"],["、"],["それ"],["を"],["われわれ"],["の"],["ため"],["に"],["軽く","かるく"],["して"],["ください"],["』"],["と"],["言う","いう"],["この"],["民","たみ"],["に"],["、"],["こう"],["言い","いい"],["なさい"],["、"],["『"],["わたし"],["の"],["小指","こゆび"],["は"],["父","ちち"],["の"],["腰","こし"],["より"],["も"],["太い","ふとい"],["。"]]},{"verse":11,"text":"父,ちちはあなたがたに重,おもいくびきを負,おわせたが、わたしはさらに、あなたがたのくびきを重,おもくしよう。父,ちちはむちであなたがたを懲,こらしたが、わたしはさそりをもってあなたがたを懲,こらそう』と」。","tok":[["父","ちち"],["は"],["あなた"],["がた"],["に"],["重い","おもい"],["くびき"],["を"],["負わせた","おわせた"],["が"],["、"],["わたし"],["は"],["さらに"],["、"],["あなた"],["がた"],["の"],["くびき"],["を"],["重く","おもく"],["しよう"],["。"],["父","ちち"],["は"],["むち"],["で"],["あなた"],["がた"],["を"],["懲らした","こらした"],["が"],["、"],["わたし"],["は"],["さそり"],["を"],["もって"],["あなた"],["がた"],["を"],["懲らそう","こらそう"],["』"],["と"],["」"],["。"]]},{"verse":12,"text":"さてヤラベアムと民,たみは皆,みな、王,おうが「三日,か目,めに再,ふたたびわたしのところに来,くるように」と言,いったとおりに、三日,か目,めにレハベアムのところにきた。","tok":[["さて"],["ヤラベアム"],["と"],["民","たみ"],["は"],["皆","みな"],["、"],["王","おう"],["が"],["「"],["三日目","かめ"],["に"],["再び","ふたたび"],["わたし"],["の"],["ところ"],["に"],["来る","くる"],["よう"],["に"],["」"],["と"],["言った","いった"],["とおり"],["に"],["、"],["三日目","かめ"],["に"],["レハベアム"],["の"],["ところ"],["に"],["きた"],["。"]]},{"verse":13,"text":"王,おうは荒々,あらあらしく民,たみに答,こたえ、老人,ろうじんたちが与,あたえた勧,すすめを捨,すてて、","tok":[["王","おう"],["は"],["荒々しく","あらあらしく"],["民","たみ"],["に"],["答","こたえ"],["、"],["老人","ろうじん"],["たち"],["が"],["与","あたえ"],["た"],["勧め","すすめ"],["を"],["捨てて","すてて"],["、"]]},{"verse":14,"text":"若者,わかものたちの勧,すすめに従,したがい、彼,かれらに告,つげて言,いった、「父,ちちはあなたがたのくびきを重,おもくしたが、わたしはあなたがたのくびきを、さらに重,おもくしよう。父,ちちはむちであなたがたを懲,こらしたが、わたしはさそりをもってあなたがたを懲,こらそう」。","tok":[["若者","わかもの"],["たち"],["の"],["勧め","すすめ"],["に"],["従い","したがい"],["、"],["彼","かれ"],["ら"],["に"],["告","つげ"],["て"],["言った","いった"],["、"],["「"],["父","ちち"],["は"],["あなた"],["がた"],["の"],["くびき"],["を"],["重く","おもく"],["した"],["が"],["、"],["わたし"],["は"],["あなた"],["がた"],["の"],["くびき"],["を"],["、"],["さらに"],["重く","おもく"],["しよう"],["。"],["父","ちち"],["は"],["むち"],["で"],["あなた"],["がた"],["を"],["懲らした","こらした"],["が"],["、"],["わたし"],["は"],["さそり"],["を"],["もって"],["あなた"],["がた"],["を"],["懲らそう","こらそう"],["」"],["。"]]},{"verse":15,"text":"このように王,おうは民,たみの言,いうことを聞,ききいれなかった。これはかつて主,しゅがシロびとアヒヤによって、ネバテの子,こヤラベアムに言,いわれた言葉,ことばを成就,じょうじゅするために、主,しゅが仕向,しむけられた事,ことであった。","tok":[["この"],["よう"],["に"],["王","おう"],["は"],["民","たみ"],["の"],["言う","いう"],["こと"],["を"],["聞きいれなかった","ききいれなかった"],["。"],["これ"],["は"],["かつて"],["主","しゅ"],["が"],["シロ"],["び"],["と"],["アヒヤ"],["によって"],["、"],["ネバテ"],["の"],["子","こ"],["ヤラベアム"],["に"],["言われた","いわれた"],["言葉","ことば"],["を"],["成就","じょうじゅ"],["する"],["ため"],["に"],["、"],["主","しゅ"],["が"],["仕向","しむけ"],["られた"],["事","こと"],["で"],["あった"],["。"]]},{"verse":16,"text":"イスラエルの人々,ひとびとは皆,みな、王,おうが自分,じぶんたちの言,いうことを聞,ききいれないのを見,みたので、民,たみは王,おうに答,こたえて言,いった、「われわれはダビデのうちに何,なにの分,ぶんがあろうか、エッサイの子,このうちに嗣,し業,ぎょうがない。イスラエルよ、あなたがたの天幕,てんまくへ帰,かえれ。ダビデよ、今,いま自分,じぶんの家,いえの事,ことを見,みよ」。そしてイスラエルはその天幕,てんまくへ去,さっていった。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["は"],["皆","みな"],["、"],["王","おう"],["が"],["自分","じぶん"],["たち"],["の"],["言う","いう"],["こと"],["を"],["聞きいれない","ききいれない"],["の"],["を"],["見た","みた"],["ので"],["、"],["民","たみ"],["は"],["王","おう"],["に"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["われわれ"],["は"],["ダビデ"],["の"],["うち"],["に"],["何","なに"],["の"],["分","ぶん"],["が"],["あろう"],["か"],["、"],["エッサイ"],["の"],["子","こ"],["の"],["うち"],["に"],["嗣業","しぎょう"],["が"],["ない"],["。"],["イスラエル"],["よ"],["、"],["あなた"],["がた"],["の"],["天幕","てんまく"],["へ"],["帰えれ","かえれ"],["。"],["ダビデ"],["よ"],["、"],["今","いま"],["自分","じぶん"],["の"],["家","いえ"],["の"],["事","こと"],["を"],["見よ","みよ"],["」"],["。"],["そして"],["イスラエル"],["は"],["その"],["天幕","てんまく"],["へ"],["去て","さって"],["いった"],["。"]]},{"verse":17,"text":"しかしレハベアムはユダの町々,まちまちに住,すんでいるイスラエルの人々,ひとびとを治,おさめた。","tok":[["しかし"],["レハベアム"],["は"],["ユダ"],["の"],["町々","まちまち"],["に"],["住んで","すんで"],["いる"],["イスラエル"],["の"],["人々","ひとびと"],["を"],["治めた","おさめた"],["。"]]},{"verse":18,"text":"レハベアム王,おうは徴募,ちょうぼの監督,かんとくであったアドラムをつかわしたが、イスラエルが皆,みな、彼,かれを石,いしで撃,うち殺,ころしたので、レハベアム王,おうは急,いそいで車,くるまに乗,のり、エルサレムへ逃,にげた。","tok":[["レハベアム"],["王","おう"],["は"],["徴募","ちょうぼ"],["の"],["監督","かんとく"],["で"],["あった"],["アドラム"],["を"],["つかわした"],["が"],["、"],["イスラエル"],["が"],["皆","みな"],["、"],["彼","かれ"],["を"],["石","いし"],["で"],["撃ち殺した","うちころした"],["ので"],["、"],["レハベアム"],["王","おう"],["は"],["急いで","いそいで"],["車","くるま"],["に"],["乗","のり"],["、"],["エルサレム"],["へ"],["逃た","にげた"],["。"]]},{"verse":19,"text":"こうしてイスラエルはダビデの家,いえにそむいて今日,こんにちに至,いたった。","tok":[["こう"],["して"],["イスラエル"],["は"],["ダビデ"],["の"],["家","いえ"],["に"],["そむいて"],["今日","こんにち"],["に"],["至った","いたった"],["。"]]},{"verse":20,"text":"イスラエルは皆,みなヤラベアムの帰,かえってきたのを聞,きき、人,ひとをつかわして彼,かれを集会,しゅうかいに招,まねき、イスラエルの全家,ぜんかの上,うえに王,おうとした。ユダの部族,ぶぞくのほかはダビデの家,いえに従,したがう者,ものがなかった。","tok":[["イスラエル"],["は"],["皆","みな"],["ヤラベアム"],["の"],["帰えって","かえって"],["きた"],["の"],["を"],["聞","きき"],["、"],["人","ひと"],["を"],["つかわして"],["彼","かれ"],["を"],["集会","しゅうかい"],["に"],["招き","まねき"],["、"],["イスラエル"],["の"],["全","ぜん"],["家","いえ"],["の"],["上","うえ"],["に"],["王","おう"],["と"],["した"],["。"],["ユダ"],["の"],["部族","ぶぞく"],["の"],["ほか"],["は"],["ダビデ"],["の"],["家","いえ"],["に"],["従う","したがう"],["者","もの"],["が"],["なかった"],["。"]]},{"verse":21,"text":"ソロモンの子,こレハベアムはエルサレムに来,きて、ユダの全家,ぜんかとベニヤミンの部族,ぶぞくの者,もの、すなわちえり抜,ぬきの軍人,ぐんじん十八万を集,あつめ、国,くにを取,とりもどすために、イスラエルの家,いえと戦,たたかおうとしたが、","tok":[["ソロモン"],["の"],["子","こ"],["レハベアム"],["は"],["エルサレム"],["に"],["来て","きて"],["、"],["ユダ"],["の"],["全家","ぜんか"],["と"],["ベニヤミン"],["の"],["部族","ぶぞく"],["の"],["者","もの"],["、"],["すなわち"],["えり抜き","えりぬき"],["の"],["軍人","ぐんじん"],["十八万","じゅうはちまん"],["を"],["集め","あつめ"],["、"],["国","くに"],["を"],["取","とり"],["も"],["どす"],["ため"],["に"],["、"],["イスラエル"],["の"],["家","いえ"],["と"],["戦おう","たたかおう"],["と"],["した"],["が"],["、"]]},{"verse":22,"text":"神,かみの言葉,ことばが神,かみの人,ひとシマヤに臨,のぞんだ、","tok":[["神","かみ"],["の"],["言葉","ことば"],["が"],["神","かみ"],["の"],["人","ひと"],["シマヤ"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":23,"text":"「ソロモンの子,こであるユダの王,おうレハベアム、およびユダとベニヤミンの全家,ぜんか、ならびにそのほかの民,たみに言,いいなさい、","tok":[["「"],["ソロモン"],["の"],["子","こ"],["で"],["ある"],["ユダ"],["の"],["王","おう"],["レハベアム"],["、"],["および"],["ユダ"],["と"],["ベニヤミン"],["の"],["全家","ぜんか"],["、"],["ならびに"],["その"],["ほか"],["の"],["民","たみ"],["に"],["言い","いい"],["なさい"],["、"]]},{"verse":24,"text":"『主,しゅはこう仰,おおせられる。あなたがたは上,のぼっていってはならない。あなたがたの兄弟,きょうだいであるイスラエルの人々,ひとびとと戦,たたかってはならない。おのおの家,いえに帰,かえりなさい。この事,ことはわたしから出,でたのである』」。それで彼,かれらは主,しゅの言葉,ことばをきき、主,しゅの言葉,ことばに従,したがって帰,かえっていった。","tok":[["『"],["主","しゅ"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["あなた"],["がた"],["は"],["上って","のぼって"],["いって"],["は"],["ならない"],["。"],["あなた"],["がた"],["の"],["兄弟","きょうだい"],["で"],["ある"],["イスラエル"],["の"],["人々","ひとびと"],["と"],["戦って","たたかって"],["は"],["ならない"],["。"],["おのおの"],["家","いえ"],["に"],["帰えり","かえり"],["なさい"],["。"],["この"],["事","こと"],["は"],["わたし"],["から"],["出た","でた"],["ので"],["ある"],["』"],["」"],["。"],["それ"],["で"],["彼","かれ"],["ら"],["は"],["主","しゅ"],["の"],["言葉","ことば"],["を"],["きき"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["に"],["従って","したがって"],["帰えって","かえって"],["いった"],["。"]]},{"verse":25,"text":"ヤラベアムはエフライムの山地,さんちにシケムを建,たてて、そこに住,すんだ。彼,かれはまたそこから出,でてペヌエルを建,たてた。","tok":[["ヤラベアム"],["は"],["エフライム"],["の"],["山地","さんち"],["に"],["シケム"],["を"],["建てて","たてて"],["、"],["そこ"],["に"],["住んだ","すんだ"],["。"],["彼","かれ"],["は"],["また"],["そこ"],["から"],["出て","でて"],["ペヌエル"],["を"],["建てた","たてた"],["。"]]},{"verse":26,"text":"しかしヤラベアムはその心,こころのうちに言,いった、「国,くには今,いまダビデの家,いえにもどるであろう。","tok":[["しかし"],["ヤラベアム"],["は"],["その"],["心","こころ"],["の"],["うち"],["に"],["言った","いった"],["、"],["「"],["国","くに"],["は"],["今","いま"],["ダビデ"],["の"],["家","いえ"],["に"],["もどるで"],["あろう"],["。"]]},{"verse":27,"text":"もしこの民,たみがエルサレムにある主,しゅの宮,みやに犠牲,ぎせいをささげるために上,のぼるならば、この民,たみの心,こころはユダの王,おうである彼,かれらの主君,しゅくんレハベアムに帰,かえり、わたしを殺,ころして、ユダの王,おうレハベアムに帰,かえるであろう」。","tok":[["もし"],["この"],["民","たみ"],["が"],["エルサレム"],["に"],["ある"],["主","しゅ"],["の"],["宮","みや"],["に"],["犠牲","ぎせい"],["を"],["ささげる"],["ため"],["に"],["上るならば","のぼるならば"],["、"],["この"],["民","たみ"],["の"],["心","こころ"],["は"],["ユダ"],["の"],["王","おう"],["で"],["ある"],["彼","かれ"],["ら"],["の"],["主君","しゅくん"],["レハベアム"],["に"],["帰えり","かえり"],["、"],["わたし"],["を"],["殺ろして","ころして"],["、"],["ユダ"],["の"],["王","おう"],["レハベアム"],["に"],["帰えるで","かえるで"],["あろう"],["」"],["。"]]},{"verse":28,"text":"そこで王,おうは相談,そうだんして、二つの金,きんの子,こ牛,うしを造,つくり、民,たみに言,いった、「あなたがたはもはやエルサレムに上,のぼるには、およばない。イスラエルよ、あなたがたをエジプトの国,くにから導,みちびき上,のぼったあなたがたの神,かみを見,みよ」。","tok":[["そこ"],["で"],["王","おう"],["は"],["相談","そうだん"],["して"],["、"],["二","ふた"],["つ"],["の"],["金","きん"],["の"],["子牛","こうし"],["を"],["造","つくり"],["、"],["民","たみ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["もはや"],["エルサレム"],["に"],["上る","のぼる"],["に"],["は"],["、"],["およばない"],["。"],["イスラエル"],["よ"],["、"],["あなた"],["がた"],["を"],["エジプト"],["の"],["国","くに"],["から"],["導き","みちびき"],["上った","のぼった"],["あなた"],["がた"],["の"],["神","かみ"],["を"],["見よ","みよ"],["」"],["。"]]},{"verse":29,"text":"そして彼,かれは一つをベテルにすえ、一つをダンに置,おいた。","tok":[["そして"],["彼","かれ"],["は"],["一","ひと"],["つ"],["を"],["ベテル"],["に"],["すえ"],["、"],["一","ひと"],["つ"],["を"],["ダン"],["に"],["置いた","おいた"],["。"]]},{"verse":30,"text":"この事,ことは罪,つみとなった。民,たみがベテルへ行,いって一つを礼拝,れいはいし、ダンへ行,いって一つを礼拝,れいはいしたからである。","tok":[["この"],["事","こと"],["は"],["罪","つみ"],["と"],["なった"],["。"],["民","た"],["み"],["が"],["ベテル"],["へ"],["行って","いって"],["一","ひと"],["つ"],["を"],["礼拝","れいはい"],["し"],["、"],["ダン"],["へ"],["行って","いって"],["一","ひと"],["つ"],["を"],["礼拝","れいはい"],["した"],["から"],["で"],["ある"],["。"]]},{"verse":31,"text":"彼,かれはまた高,たかき所,ところに家,いえを造,つくり、レビの子孫,しそんでない一般,いっぱんの民,たみを祭司,さいしに任命,にんめいした。","tok":[["彼","かれ"],["は"],["また"],["高き","たかき"],["所","ところ"],["に"],["家","いえ"],["を"],["造","つくり"],["、"],["レビ"],["の"],["子孫","しそん"],["で"],["ない"],["一般","いっぱん"],["の"],["民","たみ"],["を"],["祭司","さいし"],["に"],["任命","にんめい"],["した"],["。"]]},{"verse":32,"text":"またヤラベアムはユダで行,おこなう祭,まつりと同,おなじ祭,まつりを八月,がつの十五日,にちに定,さだめ、そして祭壇,さいだんに上,のぼった。彼,かれはベテルでそのように行,おこない、彼,かれが造,つくった子,こ牛,うしに犠牲,ぎせいをささげた。また自分,じぶんの造,つくった高,たかき所,ところの祭司,さいしをベテルに立,たてた。","tok":[["また"],["ヤラベアム"],["は"],["ユダ"],["で"],["行なう","おこなう"],["祭","まつり"],["と"],["同じ","おなじ"],["祭","まつり"],["を"],["八","はち"],["月","がつ"],["の"],["十五","じゅうご"],["日","にち"],["に"],["定め","さだめ"],["、"],["そして"],["祭壇","さいだん"],["に"],["上った","のぼった"],["。"],["彼","かれ"],["は"],["ベテル"],["で"],["その"],["よう"],["に"],["行ない","おこない"],["、"],["彼","かれ"],["が"],["造った","つくった"],["子牛","こうし"],["に"],["犠牲","ぎせい"],["を"],["ささげた"],["。"],["また"],["自分","じぶん"],["の"],["造った","つくった"],["高き","たかき"],["所","ところ"],["の"],["祭司","さいし"],["を"],["ベテル"],["に"],["立てた","たてた"],["。"]]},{"verse":33,"text":"こうして彼,かれはベテルに造,つくった祭壇,さいだんに八月,がつの十五日,にちに上,のぼった。これは彼,かれが自分,じぶんで勝手,かってに考,かんがえついた月,つきであった。そして彼,かれはイスラエルの人々,ひとびとのために祭,まつりを定,さだめ、祭壇,さいだんに上,のぼって香,こうをたいた。","tok":[["こう"],["して"],["彼","かれ"],["は"],["ベテル"],["に"],["造った","つくった"],["祭壇","さいだん"],["に"],["八","はち"],["月","がつ"],["の"],["十五","じゅうご"],["日","にち"],["に"],["上った","のぼった"],["。"],["これ"],["は"],["彼","かれ"],["が"],["自分","じぶん"],["で"],["勝手に","かってに"],["考","かんがえ"],["ついた"],["月","つき"],["で"],["あった"],["。"],["そして"],["彼","かれ"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["ため"],["に"],["祭","まつり"],["を"],["定め","さだめ"],["、"],["祭壇","さいだん"],["に"],["上って","のぼって"],["香","こう"],["を"],["たいた"],["。"]]}]
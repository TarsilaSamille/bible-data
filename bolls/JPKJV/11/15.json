[{"verse":1,"text":"ネバテの子,こヤラベアム王,おうの第,だい十八年,ねんにアビヤムがユダの王,おうとなり、","tok":[["ネバテ"],["の"],["子","こ"],["ヤラベアム"],["王","おう"],["の"],["第","だい"],["十八","じゅうはち"],["年","ねん"],["に"],["アビヤム"],["が"],["ユダ"],["の"],["王","おう"],["と"],["なり"],["、"]]},{"verse":2,"text":"エルサレムで三年,ねん世,よを治,おさめた。その母,ははの名,なはマアカといって、アブサロムの娘,むすめであった。","tok":[["エルサレム"],["で"],["三","さん"],["年世","年よ"],["を"],["治めた","おさめた"],["。"],["その"],["母","はは"],["の"],["名","な"],["は"],["マアカ"],["と"],["いって"],["、"],["アブサロム"],["の"],["娘","むすめ"],["で"],["あった"],["。"]]},{"verse":3,"text":"彼,かれはその父,ちちが先,さきに行,おこなったもろもろの罪,つみをおこない、その心,こころは父,ちちダビデの心,こころのようにその神,かみ、主,しゅに対,たいして全,まったく真実,しんじつではなかった。","tok":[["彼","かれ"],["は"],["その"],["父","ちち"],["が"],["先","さき"],["に"],["行なった","おこなった"],["もろもろ"],["の"],["罪","つみ"],["を"],["おこない"],["、"],["その"],["心","こころ"],["は"],["父","ちち"],["ダビデ"],["の"],["心","こころ"],["の"],["よう"],["に"],["その"],["神","かみ"],["、"],["主に","しゅに"],["対して","たいして"],["全く","まったく"],["真実","しんじつ"],["で"],["は"],["なかった"],["。"]]},{"verse":4,"text":"それにもかかわらず、その神,かみ、主,しゅはダビデのために、エルサレムにおいて彼,かれに一つのともしびを与,あたえ、その子,こを彼,かれのあとに立,たてて、エルサレムを固,かためられた。","tok":[["それ"],["に"],["も"],["かかわらず"],["、"],["その"],["神","かみ"],["、"],["主","しゅ"],["は"],["ダビデ"],["の"],["ため"],["に"],["、"],["エルサレム"],["に"],["おいて"],["彼","かれ"],["に"],["一","ひと"],["つ"],["の"],["ともしび"],["を"],["与","あたえ"],["、"],["その"],["子","こ"],["を"],["彼","かれ"],["の"],["あと"],["に"],["立てて","たてて"],["、"],["エルサレム"],["を"],["固められた","かためられた"],["。"]]},{"verse":5,"text":"それはダビデがヘテびとウリヤの事,ことのほか、一生,いっしょうの間,あいだ、主,しゅの目,めにかなう事,ことを行,おこない、主,しゅが命,めいじられたすべての事,ことに、そむかなかったからである。","tok":[["それ"],["は"],["ダビデ"],["が"],["ヘテ"],["びと"],["ウリヤ"],["の"],["事","こと"],["の"],["ほか"],["、"],["一生","いっしょう"],["の"],["間","あいだ"],["、"],["主","しゅ"],["の"],["目","め"],["に"],["かなう"],["事","こと"],["を"],["行ない","おこない"],["、"],["主","しゅ"],["が"],["命じられた","めいじられた"],["すべて"],["の"],["事","こと"],["に"],["、"],["そむかなかった"],["から"],["で"],["ある"],["。"]]},{"verse":6,"text":"レハベアムとヤラベアムの間,あいだには一生,いっしょうの間,あいだ、戦争,せんそうがあった。","tok":[["レハベアム"],["と"],["ヤラベアム"],["の"],["間","あいだ"],["に"],["は"],["一生","いっしょう"],["の"],["間","あいだ"],["、"],["戦争","せんそう"],["が"],["あった"],["。"]]},{"verse":7,"text":"アビヤムのその他,たの行為,こういと、彼,かれがしたすべての事,ことは、ユダの王,おうの歴代志,れきだいしの書,しょにしるされているではないか。アビヤムとヤラベアムの間,あいだにも戦争,せんそうがあった。","tok":[["アビヤム"],["の"],["その"],["他","た"],["の"],["行為","こうい"],["と"],["、"],["彼","かれ"],["が"],["した"],["すべて"],["の"],["事","こと"],["は"],["、"],["ユダ"],["の"],["王","おう"],["の"],["歴代志","れきだいし"],["の"],["書","しょ"],["に"],["しるされて"],["いるで"],["は"],["ない"],["か"],["。"],["アビヤム"],["と"],["ヤラベアム"],["の"],["間","あいだ"],["に"],["も"],["戦争","せんそう"],["が"],["あった"],["。"]]},{"verse":8,"text":"アビヤムはその先祖,せんぞと共,ともに眠,ねむって、ダビデの町,まちに葬,ほうむられ、その子,こアサが代,かわって王,おうとなった。","tok":[["アビヤム"],["は"],["その"],["先祖","せんぞ"],["と"],["共","とも"],["に"],["眠って","ねむって"],["、"],["ダビデ"],["の"],["町","まち"],["に"],["葬むられ","ほうむられ"],["、"],["その"],["子","こ"],["アサ"],["が"],["代わって","かわって"],["王","おう"],["と"],["なった"],["。"]]},{"verse":9,"text":"イスラエルの王,おうヤラベアムの第,だい二十年,ねんにアサはユダの王,おうとなり、","tok":[["イスラエル"],["の"],["王","おう"],["ヤラベアム"],["の"],["第","だい"],["二十","にじゅう"],["年","ねん"],["に"],["アサ"],["は"],["ユダ"],["の"],["王","おう"],["と"],["なり"],["、"]]},{"verse":10,"text":"エルサレムで四十一年,ねん世,よを治,おさめた。その母,ははの名,なはマアカといってアブサロムの娘,むすめであった。","tok":[["エルサレム"],["で"],["四十一","よんじゅういち"],["年世","年よ"],["を"],["治めた","おさめた"],["。"],["その"],["母","はは"],["の"],["名","な"],["は"],["マアカ"],["と"],["いって"],["アブサロム"],["の"],["娘","むすめ"],["で"],["あった"],["。"]]},{"verse":11,"text":"アサはその父,ちちダビデがしたように主,しゅの目,めにかなう事,ことをし、","tok":[["アサ"],["は"],["その"],["父","ちち"],["ダビデ"],["が"],["した"],["よう"],["に"],["主","しゅ"],["の"],["目","め"],["に"],["かなう"],["事","こと"],["を"],["し"],["、"]]},{"verse":12,"text":"神殿,しんでん男娼,だんしょうを国,くにから追,おい出,だし、先祖,せんぞたちの造,つくったもろもろの偶像,ぐうぞうを除,のぞいた。","tok":[["神殿","しんでん"],["男娼","だんしょう"],["を"],["国","くに"],["から"],["追い出し","おいだし"],["、"],["先祖","せんぞ"],["たち"],["の"],["造った","つくった"],["もろもろ"],["の"],["偶像","ぐうぞう"],["を"],["除いた","のぞいた"],["。"]]},{"verse":13,"text":"彼,かれはまたその母,ははマアカが、アシラのために憎,にくむべき像,ぞうを造,つくらせたので、彼女,かのじょを太后,たいこうの位,くらいから退,しりぞけた。そしてアサはその憎,にくむべき像,ぞうを切,きり倒,たおしてキデロンの谷,たにで焼,やき捨,すてた。","tok":[["彼","かれ"],["は"],["また"],["その"],["母","はは"],["マアカ"],["が"],["、"],["アシラ"],["の"],["ため"],["に"],["憎むべき","にくむべき"],["像","ぞう"],["を"],["造らせた","つくらせた"],["ので"],["、"],["彼女","かのじょ"],["を"],["太后","たいこう"],["の"],["位","くらい"],["から"],["退ぞけた","しりぞけた"],["。"],["そして"],["アサ"],["は"],["その"],["憎むべき","にくむべき"],["像","ぞう"],["を"],["切り倒して","きりたおして"],["キデロン"],["の"],["谷","たに"],["で"],["焼き捨てた","やきすてた"],["。"]]},{"verse":14,"text":"ただし高,たかき所,ところは除,のぞかなかった。けれどもアサの心,こころは一生,いっしょうの間,あいだ、主,しゅに対,たいして全,まったく真実,しんじつであった。","tok":[["ただし"],["高き","たかき"],["所","ところ"],["は"],["除かなかった","のぞかなかった"],["。"],["けれど"],["も"],["アサ"],["の"],["心","こころ"],["は"],["一生","いっしょう"],["の"],["間","あいだ"],["、"],["主に","しゅに"],["対して","たいして"],["全く","まったく"],["真実","しんじつ"],["で"],["あった"],["。"]]},{"verse":15,"text":"彼,かれは父,ちちの献納,けんのうした物,ものと自分,じぶんの献納,けんのうした物,もの、金銀,きんぎんおよび器物,うつわものを主,しゅの宮,みやに携,たずさえ入,いれた。","tok":[["彼","かれ"],["は"],["父","ちち"],["の"],["献納","けんのう"],["した"],["物","もの"],["と"],["自分","じぶん"],["の"],["献納","けんのう"],["した"],["物","もの"],["、"],["金銀","きんぎん"],["および"],["器物","うつわも"],["の"],["を"],["主","しゅ"],["の"],["宮","みや"],["に"],["携え","たずさえ"],["入れた","いれた"],["。"]]},{"verse":16,"text":"アサとイスラエルの王,おうバアシャの間,あいだには一生,いっしょうの間,あいだ、戦争,せんそうがあった。","tok":[["アサ"],["と"],["イスラエル"],["の"],["王","おう"],["バアシャ"],["の"],["間","あいだ"],["に"],["は"],["一生","いっしょう"],["の"],["間","あいだ"],["、"],["戦争","せんそう"],["が"],["あった"],["。"]]},{"verse":17,"text":"イスラエルの王,おうバアシャはユダに攻,せめ上,のぼり、ユダの王,おうアサの所,ところに、だれをも出入,でいりさせないためにラマを築,きずいた。","tok":[["イスラエル"],["の"],["王","おう"],["バアシャ"],["は"],["ユダ"],["に"],["攻め上り","せめのぼり"],["、"],["ユダ"],["の"],["王","おう"],["アサ"],["の"],["所","ところ"],["に"],["、"],["だれ"],["を"],["も"],["出入","でいり"],["させない"],["ため"],["に"],["ラマ"],["を"],["築いた","きずいた"],["。"]]},{"verse":18,"text":"そこでアサは主,しゅの宮,みやの宝蔵,ほうぞうと、王,おうの宮殿,きゅうでんの宝蔵,ほうぞうに残,のこっている金銀,きんぎんをことごとく取,とって、これを家来,けらいたちの手,てにわたし、そしてアサ王,おうは彼,かれらをダマスコに住,すんでいるスリヤの王,おう、ヘジョンの子,こタブリモンの子,こであるベネハダデにつかわして言,いわせた、","tok":[["そこ"],["で"],["アサ"],["は"],["主","しゅ"],["の"],["宮","みや"],["の"],["宝蔵","ほうぞう"],["と"],["、"],["王","おう"],["の"],["宮殿","きゅうでん"],["の"],["宝蔵","ほうぞう"],["に"],["残って","のこって"],["いる"],["金銀","きんぎん"],["を"],["ことごとく"],["取って","とって"],["、"],["これ"],["を"],["家来","けらい"],["たち"],["の"],["手","て"],["に"],["わたし"],["、"],["そして"],["アサ"],["王","おう"],["は"],["彼","かれ"],["ら"],["を"],["ダマスコ"],["に"],["住んで","すんで"],["いる"],["スリヤ"],["の"],["王","おう"],["、"],["ヘジョン"],["の"],["子","こ"],["タブリモン"],["の"],["子","こ"],["で"],["ある"],["ベネハダデ"],["に"],["つかわして"],["言わせた","いわせた"],["、"]]},{"verse":19,"text":"「わたしの父,ちちとあなたの父,ちちとの間,あいだに結,むすばれていたように、わたしとあなたの間,あいだに同盟,どうめいを結,むすびましょう。わたしはあなたに金銀,きんぎんの贈,おくり物,ものをさしあげます。行,いって、あなたとイスラエルの王,おうバアシャとの同盟,どうめいを破棄,はきし、彼,かれをわたしの所,ところから撤退,てったいさせてください」。","tok":[["「"],["わたし"],["の"],["父","ちち"],["と"],["あなた"],["の"],["父","ちち"],["と"],["の"],["間","あいだ"],["に"],["結ばれて","むすばれて"],["いた"],["よう"],["に"],["、"],["わたし"],["と"],["あなた"],["の"],["間","あいだ"],["に"],["同盟","どうめい"],["を"],["結びましょう","むすびましょう"],["。"],["わたし"],["は"],["あなた"],["に"],["金銀","きんぎん"],["の"],["贈り物","おくりもの"],["を"],["さしあげます"],["。"],["行って","いって"],["、"],["あなた"],["と"],["イスラエル"],["の"],["王","おう"],["バアシャ"],["と"],["の"],["同盟","どうめい"],["を"],["破棄","はき"],["し"],["、"],["彼","かれ"],["を"],["わたし"],["の"],["所","ところ"],["から"],["撤退","てったい"],["させて"],["ください"],["」"],["。"]]},{"verse":20,"text":"ベネハダデはアサ王,おうの言,いうことを聞,きき、自分,じぶんの軍勢,ぐんぜいの長,ちょうたちをつかわしてイスラエルの町々,まちまちを攻,せめ、イヨンとダンとアベル・ベテ・マアカおよびキンネレテの全,ぜん地,ちと、ナフタリの全,ぜん地,ちを撃,うった。","tok":[["ベネハダデ"],["は"],["アサ"],["王","おう"],["の"],["言う","いう"],["こと"],["を"],["聞","きき"],["、"],["自分","じぶん"],["の"],["軍勢","ぐんぜい"],["の"],["長","ちょう"],["たち"],["を"],["つかわして"],["イスラエル"],["の"],["町々","まちまち"],["を"],["攻め","せめ"],["、"],["イヨン"],["と"],["ダン"],["と"],["アベル"],["・"],["ベテ"],["・"],["マアカ"],["および"],["キンネレテ"],["の"],["全地","ぜんち"],["と"],["、"],["ナフタリ"],["の"],["全地","ぜんち"],["を"],["撃った","うった"],["。"]]},{"verse":21,"text":"バアシャはこれを聞,きき、ラマを築,きずくことをやめて、テルザにとどまった。","tok":[["バアシャ"],["は"],["これ"],["を"],["聞","きき"],["、"],["ラマ"],["を"],["築く","きずく"],["こと"],["を"],["やめて"],["、"],["テルザ"],["に"],["とどまった"],["。"]]},{"verse":22,"text":"そこでアサ王,おうはユダ全国,ぜんこくに布告,ふこくを発,はっした。ひとりも免,まぬかれる者,ものはなかった。すなわちバアシャがラマを築,きずくために用,もちいた石,いしと材木,ざいもくを運,はこびこさせ、アサ王,おうはそれを用,もちいて、ベニヤミンのゲバとミヅパを築,きずいた。","tok":[["そこ"],["で"],["アサ"],["王","おう"],["は"],["ユダ"],["全国","ぜんこく"],["に"],["布告","ふこく"],["を"],["発した","はっした"],["。"],["ひとり"],["も"],["免かれる","まぬかれる"],["者","もの"],["は"],["なかった"],["。"],["すなわち"],["バアシャ"],["が"],["ラマ"],["を"],["築く","きずく"],["ため"],["に"],["用いた","もちいた"],["石","いし"],["と"],["材木","ざいもく"],["を"],["運こび","はこび"],["こ"],["さ"],["せ"],["、"],["アサ"],["王","おう"],["は"],["それ"],["を"],["用いて","もちいて"],["、"],["ベニヤミン"],["の"],["ゲバ"],["と"],["ミヅパ"],["を"],["築いた","きずいた"],["。"]]},{"verse":23,"text":"アサのその他,たの事績,じせきとそのすべての勲功,くんこうと、彼,かれがしたすべての事,ことおよび彼,かれが建,たてた町々,まちまちは、ユダの王,おうの歴代志,れきだいしの書,しょにしるされているではないか。彼,かれは老年,ろうねんになって足,あしを病,やんだ。","tok":[["アサ"],["の"],["その"],["他","た"],["の"],["事績","じせき"],["と"],["その"],["すべて"],["の"],["勲功","くんこう"],["と"],["、"],["彼","かれ"],["が"],["した"],["すべて"],["の"],["事","こと"],["および"],["彼","かれ"],["が"],["建てた","たてた"],["町々","まちまち"],["は"],["、"],["ユダ"],["の"],["王","おう"],["の"],["歴代志","れきだいし"],["の"],["書","しょ"],["に"],["しるされて"],["いるで"],["は"],["ない"],["か"],["。"],["彼","かれ"],["は"],["老年","ろうねん"],["に"],["なって"],["足","あし"],["を"],["病んだ","やんだ"],["。"]]},{"verse":24,"text":"アサはその先祖,せんぞと共,ともに眠,ねむって、父,ちちダビデの町,まちに先祖,せんぞと共,ともに葬,ほうむられ、その子,こヨシャパテが代,かわって王,おうとなった。","tok":[["アサ"],["は"],["その"],["先祖","せんぞ"],["と"],["共","とも"],["に"],["眠って","ねむって"],["、"],["父","ちち"],["ダビデ"],["の"],["町","まち"],["に"],["先祖","せんぞ"],["と"],["共","とも"],["に"],["葬むられ","ほうむられ"],["、"],["その"],["子","こ"],["ヨシャパテ"],["が"],["代わって","かわって"],["王","おう"],["と"],["なった"],["。"]]},{"verse":25,"text":"ユダの王,おうアサの第,だい二年,ねんにヤラベアムの子,こナダブがイスラエルの王,おうとなって、二年,ねんイスラエルを治,おさめた。","tok":[["ユダ"],["の"],["王","おう"],["アサ"],["の"],["第","だい"],["二","に"],["年","ねん"],["に"],["ヤラベアム"],["の"],["子","こ"],["ナダブ"],["が"],["イスラエル"],["の"],["王","おう"],["と"],["なって"],["、"],["二","に"],["年","ねん"],["イスラエル"],["を"],["治めた","おさめた"],["。"]]},{"verse":26,"text":"彼,かれは主,しゅの目,めの前,まえに悪,あくを行,おこない、その父,ちちの道,みちに歩,あゆみ、父,ちちがイスラエルに犯,おかさせた罪,つみをおこなった。","tok":[["彼","かれ"],["は"],["主","しゅ"],["の"],["目","め"],["の"],["前","まえ"],["に"],["悪","あく"],["を"],["行ない","おこない"],["、"],["その"],["父","ちち"],["の"],["道","みち"],["に"],["歩み","あゆみ"],["、"],["父","ちち"],["が"],["イスラエル"],["に"],["犯させた","おかさせた"],["罪","つみ"],["を"],["おこなった"],["。"]]},{"verse":27,"text":"イッサカルの家,いえのアヒヤの子,こバアシャは彼,かれに対,たいしてむほんを企,くわだて、ペリシテびとに属,ぞくするギベトンで彼,かれを撃,うった。これはナダブとイスラエルが皆,みなギベトンを囲,かこんでいたからである。","tok":[["イッサカル"],["の"],["家","いえ"],["の"],["アヒヤ"],["の"],["子","こ"],["バアシャ"],["は"],["彼","かれ"],["に対して","にたいして"],["むほん"],["を"],["企だて","くわだて"],["、"],["ペリシテ"],["びと"],["に"],["属する","ぞくする"],["ギベトン"],["で"],["彼","かれ"],["を"],["撃った","うった"],["。"],["これ"],["は"],["ナダブ"],["と"],["イスラエル"],["が"],["皆","みな"],["ギベトン"],["を"],["囲んで","かこんで"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":28,"text":"こうしてユダの王,おうアサの第,だい三年,ねんにバアシャは彼,かれを殺,ころし、彼,かれに代,かわって王,おうとなった。","tok":[["こう"],["して"],["ユダ"],["の"],["王","おう"],["アサ"],["の"],["第","だい"],["三","さん"],["年","ねん"],["に"],["バアシャ"],["は"],["彼","かれ"],["を"],["殺ろし","ころし"],["、"],["彼","かれ"],["に"],["代わって","かわって"],["王","おう"],["と"],["なった"],["。"]]},{"verse":29,"text":"彼,かれは王,おうとなるとすぐヤラベアムの全家,ぜんかを撃,うち、息,いきのある者,ものをひとりもヤラベアムの家,いえに残,のこさず、ことごとく滅,ほろぼした。主,しゅがそのしもべシロびとアヒヤによって言,いわれた言葉,ことばのとおりであって、","tok":[["彼","かれ"],["は"],["王","おう"],["と"],["なる"],["と"],["すぐ"],["ヤラベアム"],["の"],["全","ぜん"],["家","いえ"],["を"],["撃ち","うち"],["、"],["息","いき"],["の"],["ある"],["者","もの"],["を"],["ひとり"],["も"],["ヤラベアム"],["の"],["家","いえ"],["に"],["残さず","のこさず"],["、"],["ことごとく"],["滅ぼした","ほろぼした"],["。"],["主","しゅがそ"],["の"],["しもべ"],["シロ"],["び"],["と"],["アヒヤ"],["によって"],["言われた","いわれた"],["言葉","ことば"],["の"],["とおり"],["で"],["あって"],["、"]]},{"verse":30,"text":"これはヤラベアムがみずから犯,おかし、またイスラエルに犯,おかさせた罪,つみのため、また彼,かれがイスラエルの神,かみ、主,しゅを怒,いからせたその怒,いかりによるのであった。","tok":[["これ"],["は"],["ヤラベアム"],["が"],["みずから"],["犯し","おかし"],["、"],["また"],["イスラエル"],["に"],["犯させた","おかさせた"],["罪","つみ"],["の"],["ため"],["、"],["また"],["彼","かれ"],["が"],["イスラエル"],["の"],["神","かみ"],["、"],["主","しゅ"],["を"],["怒らせた","いからせた"],["その"],["怒り","いかり"],["に"],["よる"],["ので"],["あった"],["。"]]},{"verse":31,"text":"ナダブのその他,たの事績,じせきと、彼,かれがしたすべての事,ことは、イスラエルの王,おうの歴代志,れきだいしの書,しょにしるされているではないか。","tok":[["ナダブ"],["の"],["その"],["他","た"],["の"],["事績","じせき"],["と"],["、"],["彼","かれ"],["が"],["した"],["すべて"],["の"],["事","こと"],["は"],["、"],["イスラエル"],["の"],["王","おう"],["の"],["歴代志","れきだいし"],["の"],["書","しょ"],["に"],["しるされて"],["いるで"],["は"],["ない"],["か"],["。"]]},{"verse":32,"text":"アサとイスラエルの王,おうバアシャの間,あいだには一生,いっしょうの間,あいだ戦争,せんそうがあった。","tok":[["アサ"],["と"],["イスラエル"],["の"],["王","おう"],["バアシャ"],["の"],["間","あいだ"],["に"],["は"],["一生","いっしょう"],["の"],["間","あいだ"],["戦争","せんそう"],["が"],["あった"],["。"]]},{"verse":33,"text":"ユダの王,おうアサの第,だい三年,ねんにアヒヤの子,こバアシャはテルザでイスラエルの全,ぜん地,ちの王,おうとなって、二十四年,ねん世,よを治,おさめた。","tok":[["ユダ"],["の"],["王","おう"],["アサ"],["の"],["第","だい"],["三","さん"],["年","ねん"],["に"],["アヒヤ"],["の"],["子","こ"],["バアシャ"],["は"],["テルザ"],["で"],["イスラエル"],["の"],["全地","ぜんち"],["の"],["王","おう"],["と"],["なって"],["、"],["二十四","にじゅうよん"],["年世","年よ"],["を"],["治めた","おさめた"],["。"]]},{"verse":34,"text":"彼,かれは主,しゅの目,めの前,まえに悪,あくを行,おこない、ヤラベアムの道,みちに歩,あゆみ、ヤラベアムがイスラエルに犯,おかさせた罪,つみをおこなった。","tok":[["彼","かれ"],["は"],["主","しゅ"],["の"],["目","め"],["の"],["前","まえ"],["に"],["悪","あく"],["を"],["行ない","おこない"],["、"],["ヤラベアム"],["の"],["道","みち"],["に"],["歩み","あゆみ"],["、"],["ヤラベアム"],["が"],["イスラエル"],["に"],["犯させた","おかさせた"],["罪","つみ"],["を"],["おこなった"],["。"]]}]
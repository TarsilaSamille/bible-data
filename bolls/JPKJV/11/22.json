[{"verse":1,"text":"スリヤとイスラエルの間,あいだに戦争,せんそうがなくて三年,ねんを経,へた。","tok":[["スリヤ"],["と"],["イスラエル"],["の"],["間","あいだ"],["に"],["戦争","せんそう"],["が"],["なくて"],["三","さん"],["年","ねん"],["を"],["経た","へた"],["。"]]},{"verse":2,"text":"しかし三年,ねん目,めにユダの王,おうヨシャパテがイスラエルの王,おうの所,ところへ下,くだっていったので、","tok":[["しかし"],["三","さん"],["年目","年め"],["に"],["ユダ"],["の"],["王","おう"],["ヨシャパテ"],["が"],["イスラエル"],["の"],["王","おう"],["の"],["所","ところ"],["へ"],["下って","くだって"],["いった"],["ので"],["、"]]},{"verse":3,"text":"イスラエルの王,おうはその家来,けらいたちに言,いった、「あなたがたは、ラモテ・ギレアデがわれわれの所有,しょゆうであることを知,しっていますか。しかもなおわれわれはスリヤの王,おうの手,てからそれを取,とらずに黙,だまっているのです」。","tok":[["イスラエル"],["の"],["王","おう"],["は"],["その"],["家来","けらい"],["たち"],["に"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["、"],["ラモテ"],["・"],["ギレアデ"],["が"],["われわれ"],["の"],["所有","しょゆう"],["で"],["ある"],["こと"],["を"],["知って","しって"],["います"],["か"],["。"],["しかも"],["なお"],["われわれ"],["は"],["スリヤ"],["の"],["王","おう"],["の"],["手","て"],["から"],["それ"],["を"],["取らず","とらず"],["に"],["黙って","だまって"],["いる"],["の"],["です"],["」"],["。"]]},{"verse":4,"text":"彼,かれはヨシャパテに言,いった、「ラモテ・ギレアデで戦,たたかうためにわたしと一緒,いっしょに行,いかれませんか」。ヨシャパテはイスラエルの王,おうに言,いった、「わたしはあなたと一つです。わたしの民,たみはあなたの民,たみと一つです。わたしの馬,うまはあなたの馬,うまと一つです」。","tok":[["彼","かれ"],["は"],["ヨシャパテ"],["に"],["言った","いった"],["、"],["「"],["ラモテ"],["・"],["ギレアデ"],["で"],["戦う","たたかう"],["ため"],["に"],["わたし"],["と"],["一緒","いっしょ"],["に"],["行かれません","いかれません"],["か"],["」"],["。"],["ヨシャパテ"],["は"],["イスラエル"],["の"],["王","おう"],["に"],["言った","いった"],["、"],["「"],["わたし"],["は"],["あなた"],["と"],["一","ひと"],["つ"],["です"],["。"],["わたし"],["の"],["民","たみ"],["は"],["あなた"],["の"],["民","たみ"],["と"],["一","ひと"],["つ"],["です"],["。"],["わたし"],["の"],["馬","うま"],["は"],["あなた"],["の"],["馬","うま"],["と"],["一","ひと"],["つ"],["です"],["」"],["。"]]},{"verse":5,"text":"ヨシャパテはまたイスラエルの王,おうに言,いった、「まず、主,しゅの言葉,ことばを伺,うかがいなさい」。","tok":[["ヨシャパテ"],["は"],["また"],["イスラエル"],["の"],["王","おう"],["に"],["言った","いった"],["、"],["「"],["まず"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["を"],["伺","うかがい"],["なさい"],["」"],["。"]]},{"verse":6,"text":"そこでイスラエルの王,おうは預言者,よげんしゃ四百人,にんばかりを集,あつめて、彼,かれらに言,いった、「わたしはラモテ・ギレアデに戦,たたかいに行,いくべきでしょうか、あるいは控,ひかえるべきでしょうか」。彼,かれらは言,いった、「上,のぼっていきなさい。主,しゅはそれを王,おうの手,てにわたされるでしょう」。","tok":[["そこ"],["で"],["イスラエル"],["の"],["王","おう"],["は"],["預言者","よげんしゃ"],["四百人","にんばかり"],["を"],["集めて","あつめて"],["、"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["わたし"],["は"],["ラモテ"],["・"],["ギレアデ"],["に"],["戦い","たたかい"],["に"],["行くべきでしょう","いくべきでしょう"],["か"],["、"],["あるいは"],["控","ひかえ"],["るべきでしょう"],["か"],["」"],["。"],["彼","かれ"],["ら"],["は"],["言った","いった"],["、"],["「"],["上って","のぼって"],["いき"],["なさい"],["。"],["主","しゅ"],["は"],["それ"],["を"],["王","おう"],["の"],["手","て"],["に"],["わたされるでしょう"],["」"],["。"]]},{"verse":7,"text":"ヨシャパテは言,いった、「ここには、われわれの問,とうべき主,しゅの預言者,よげんしゃがほかにいませんか」。","tok":[["ヨシャパテ"],["は"],["言った","いった"],["、"],["「"],["ここ"],["に"],["は"],["、"],["われわれ"],["の"],["問うべき","とうべき"],["主","しゅ"],["の"],["預言者","よげんしゃ"],["が"],["ほか"],["に"],["いません"],["か"],["」"],["。"]]},{"verse":8,"text":"イスラエルの王,おうはヨシャパテに言,いった、「われわれが主,しゅに問,とうことのできる人,ひとが、まだひとりいます。イムラの子,こミカヤです。彼,かれはわたしについて良,よい事,ことを預言,よげんせず、ただ悪,わるい事,ことだけを預言,よげんするので、わたしは彼,かれを憎,にくんでいます」。ヨシャパテは言,いった、「王,おうよ、そう言,いわないでください」。","tok":[["イスラエル"],["の"],["王","おう"],["は"],["ヨシャパテ"],["に"],["言った","いった"],["、"],["「"],["われわれ"],["が"],["主に","しゅに"],["問う","とう"],["こと"],["の"],["できる"],["人","ひと"],["が"],["、"],["まだ"],["ひとり"],["います"],["。"],["イムラ"],["の"],["子","こ"],["ミカヤ"],["です"],["。"],["彼","かれ"],["は"],["わたし"],["について"],["良い","よい"],["事","こと"],["を"],["預言","よげん"],["せず"],["、"],["ただ"],["悪い","わるい"],["事","こと"],["だけ"],["を"],["預言","よげん"],["する"],["ので"],["、"],["わたし"],["は"],["彼","かれ"],["を"],["憎んで","にくんで"],["います"],["」"],["。"],["ヨシャパテ"],["は"],["言った","いった"],["、"],["「"],["王","おう"],["よ"],["、"],["そう"],["言わないで","いわないで"],["ください"],["」"],["。"]]},{"verse":9,"text":"そこでイスラエルの王,おうは役人,やくにんを呼,よんで、「急,いそいでイムラの子,こミカヤを連,つれてきなさい」と言,いった。","tok":[["そこ"],["で"],["イスラエル"],["の"],["王","おう"],["は"],["役人","やくにん"],["を"],["呼んで","よんで"],["、"],["「"],["急いで","いそいで"],["イムラ"],["の"],["子","こ"],["ミカヤ"],["を"],["連れて","つれて"],["き"],["なさい"],["」"],["と"],["言った","いった"],["。"]]},{"verse":10,"text":"さてイスラエルの王,おうおよびユダの王,おうヨシャパテは王,おうの服,ふくを着,きて、サマリヤの門,もんの入口,いりぐちの広場,ひろばに、おのおのその王座,おうざにすわり、預言者,よげんしゃたちは皆,みなその前,まえで預言,よげんしていた。","tok":[["さて"],["イスラエル"],["の"],["王","おう"],["および"],["ユダ"],["の"],["王","おう"],["ヨシャパテ"],["は"],["王","おう"],["の"],["服","ふく"],["を"],["着て","きて"],["、"],["サマリヤ"],["の"],["門","もん"],["の"],["入口","いりぐち"],["の"],["広場","ひろば"],["に"],["、"],["おのおの"],["その"],["王座","おうざ"],["に"],["すわり"],["、"],["預言者","よげんしゃ"],["たち"],["は"],["皆","みな"],["その"],["前","まえ"],["で"],["預言","よげん"],["して"],["いた"],["。"]]},{"verse":11,"text":"ケナアナの子,こゼデキヤは鉄,てつの角,つのを造,つくって言,いった、「主,しゅはこう仰,おおせられます、『あなたはこれらの角,つのをもってスリヤびとを突,ついて彼,かれらを滅,ほろぼしなさい』」。","tok":[["ケナアナ"],["の"],["子","こ"],["ゼデキヤ"],["は"],["鉄","てつ"],["の"],["角","つ"],["の"],["を"],["造って","つくって"],["言った","いった"],["、"],["「"],["主","しゅ"],["は"],["こう"],["仰せられます","おおせられます"],["、"],["『"],["あなた"],["は"],["これ"],["ら"],["の"],["角","つ"],["の"],["を"],["もって"],["スリヤ"],["びと"],["を"],["突いて","ついて"],["彼","かれ"],["ら"],["を"],["滅ぼし","ほろぼし"],["なさい"],["』"],["」"],["。"]]},{"verse":12,"text":"預言者,よげんしゃたちは皆,みなそのように預言,よげんして言,いった、「ラモテ・ギレアデに上,のぼっていって勝利,しょうりを得,えなさい。主,しゅはそれを王,おうの手,てにわたされるでしょう」。","tok":[["預言者","よげんしゃ"],["たち"],["は"],["皆","みな"],["その"],["よう"],["に"],["預言","よげん"],["して"],["言った","いった"],["、"],["「"],["ラモテ"],["・"],["ギレアデ"],["に"],["上って","のぼって"],["いって"],["勝利","しょうり"],["を"],["得","え"],["なさい"],["。"],["主","しゅ"],["は"],["それ"],["を"],["王","おう"],["の"],["手","て"],["に"],["わたされるでしょう"],["」"],["。"]]},{"verse":13,"text":"さてミカヤを呼,よびにいった使者,ししゃは彼,かれに言,いった、「預言者,よげんしゃたちは一致,いっちして王,おうに良,よい事,ことを言,いいました。どうぞ、あなたも、彼,かれらのひとりの言葉,ことばのようにして、良,よい事,ことを言,いってください」。","tok":[["さて"],["ミカヤ"],["を"],["呼び","よび"],["に"],["いった"],["使者","ししゃ"],["は"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["預言者","よげんしゃ"],["たち"],["は"],["一致","いっち"],["して"],["王","おう"],["に"],["良い","よい"],["事","こと"],["を"],["言いました","いいました"],["。"],["どうぞ"],["、"],["あなた"],["も"],["、"],["彼","かれ"],["ら"],["の"],["ひとり"],["の"],["言葉","ことば"],["の"],["よう"],["に"],["して"],["、"],["良い","よい"],["事","こと"],["を"],["言って","いって"],["ください"],["」"],["。"]]},{"verse":14,"text":"ミカヤは言,いった、「主,しゅは生,いきておられます。主,しゅがわたしに言,いわれる事,ことを申,もうしましょう」。","tok":[["ミカヤ"],["は"],["言った","いった"],["、"],["「"],["主","しゅ"],["は"],["生きて","いきて"],["おられます"],["。"],["主","しゅ"],["が"],["わたし"],["に"],["言われる","いわれる"],["事","こと"],["を"],["申しましょう","もうしましょう"],["」"],["。"]]},{"verse":15,"text":"彼,かれが王,おうの所,ところへ行,いくと、王,おうは彼,かれに言,いった、「ミカヤよ、われわれはラモテ・ギレアデに戦,たたかいに行,いくべきでしょうか、あるいは控,ひかえるべきでしょうか」。彼,かれは王,おうに言,いった、「上,のぼっていって勝利,しょうりを得,えなさい。主,しゅはそれを王,おうの手,てにわたされるでしょう」。","tok":[["彼","かれ"],["が"],["王","おう"],["の"],["所","ところ"],["へ"],["行く","いく"],["と"],["、"],["王","おう"],["は"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["ミカヤ"],["よ"],["、"],["われわれ"],["は"],["ラモテ"],["・"],["ギレアデ"],["に"],["戦い","たたかい"],["に"],["行くべきでしょう","いくべきでしょう"],["か"],["、"],["あるいは"],["控","ひかえ"],["るべきでしょう"],["か"],["」"],["。"],["彼","かれ"],["は"],["王","おう"],["に"],["言った","いった"],["、"],["「"],["上って","のぼって"],["いって"],["勝利","しょうり"],["を"],["得","え"],["なさい"],["。"],["主","しゅ"],["は"],["それ"],["を"],["王","おう"],["の"],["手","て"],["に"],["わたされるでしょう"],["」"],["。"]]},{"verse":16,"text":"しかし王,おうは彼,かれに言,いった、「幾,いくたびあなたを誓,ちかわせたら、あなたは主,しゅの名,なをもって、ただ真実,しんじつのみをわたしに告,つげるでしょうか」。","tok":[["しかし"],["王","おう"],["は"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["幾","いく"],["たび"],["あなた"],["を"],["誓わせたら","ちかわせたら"],["、"],["あなた"],["は"],["主","しゅ"],["の"],["名","な"],["を"],["もって"],["、"],["ただ"],["真実","しんじつ"],["のみ"],["を"],["わたし"],["に"],["告げるでしょう","つげるでしょう"],["か"],["」"],["。"]]},{"verse":17,"text":"彼,かれは言,いった、「わたしはイスラエルが皆,みな、牧者,ぼくしゃのない羊,ひつじのように、山,やまに散,ちっているのを見,みました。すると主,しゅは『これらの者,ものは飼主,かいぬしがいない。彼,かれらをそれぞれ安,やすらかに、その家,いえに帰,かえらせよ』と言,いわれました」。","tok":[["彼","かれ"],["は"],["言った","いった"],["、"],["「"],["わたし"],["は"],["イスラエル"],["が"],["皆","みな"],["、"],["牧者","ぼくしゃ"],["の"],["ない"],["羊","ひつじ"],["の"],["よう"],["に"],["、"],["山","やま"],["に"],["散って","ちって"],["いる"],["の"],["を"],["見ました","みました"],["。"],["する"],["と"],["主","しゅ"],["は"],["『"],["これ"],["ら"],["の"],["者","もの"],["は"],["飼主","かいぬし"],["が"],["いない"],["。"],["彼","かれ"],["ら"],["を"],["それぞれ"],["安らか","やすらか"],["に"],["、"],["その"],["家","いえ"],["に"],["帰えらせ","かえらせ"],["よ"],["』"],["と"],["言われました","いわれました"],["」"],["。"]]},{"verse":18,"text":"イスラエルの王,おうはヨシャパテに言,いった、「彼,かれがわたしについて良,よい事,ことを預言,よげんせず、ただ悪,わるい事,ことだけを預言,よげんすると、あなたに告,つげたではありませんか」。","tok":[["イスラエル"],["の"],["王","おう"],["は"],["ヨシャパテ"],["に"],["言った","いった"],["、"],["「"],["彼","かれ"],["が"],["わたし"],["について"],["良い","よい"],["事","こと"],["を"],["預言","よげん"],["せず"],["、"],["ただ"],["悪い","わるい"],["事","こと"],["だけ"],["を"],["預言","よげん"],["する"],["と"],["、"],["あなた"],["に"],["告","つげ"],["たで"],["は"],["ありません"],["か"],["」"],["。"]]},{"verse":19,"text":"ミカヤは言,いった、「それゆえ主,しゅの言葉,ことばを聞,ききなさい。わたしは主,しゅがその玉座,ぎょくざにすわり、天,てんの万軍,ばんぐんがそのかたわらに、右左,みぎひだりに立,たっているのを見,みたが、","tok":[["ミカヤ"],["は"],["言った","いった"],["、"],["「"],["それ"],["ゆえ"],["主","しゅ"],["の"],["言葉","ことば"],["を"],["聞","きき"],["なさい"],["。"],["わたし"],["は"],["主","しゅがそ"],["の"],["玉座","ぎょくざ"],["に"],["すわり"],["、"],["天","てん"],["の"],["万","まん"],["軍","ぐん"],["の"],["かたわら"],["に"],["、"],["右左","みぎひだり"],["に"],["立って","たって"],["いる"],["の"],["を"],["見た","みた"],["が"],["、"]]},{"verse":20,"text":"主,しゅは『だれがアハブをいざなってラモテ・ギレアデに上,のぼらせ、彼,かれを倒,たおれさせるであろうか』と言,いわれました。するとひとりはこの事,ことを言,いい、ひとりはほかの事,ことを言,いいました。","tok":[["主","しゅ"],["は"],["『"],["だれ"],["が"],["アハブ"],["を"],["いざなって"],["ラモテ"],["・"],["ギレアデ"],["に"],["上らせ","のぼらせ"],["、"],["彼","かれ"],["を"],["倒れさせるで","たおれさせるで"],["あろう"],["か"],["』"],["と"],["言われました","いわれました"],["。"],["する"],["と"],["ひとり"],["は"],["この"],["事","こと"],["を"],["言い","いい"],["、"],["ひとり"],["は"],["ほか"],["の"],["事","こと"],["を"],["言いました","いいました"],["。"]]},{"verse":21,"text":"その時,とき一つの霊,れいが進,すすみ出,でて、主,しゅの前,まえに立,たち、『わたしが彼,かれをいざないましょう』と言,いいました。","tok":[["その"],["時","とき"],["一","ひと"],["つ"],["の"],["霊","れい"],["が"],["進み出て","すすみでて"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["立ち","たち"],["、"],["『"],["わたし"],["が"],["彼","かれ"],["を"],["いざないましょう"],["』"],["と"],["言いました","いいました"],["。"]]},{"verse":22,"text":"主,しゅは『どのような方法,ほうほうでするのか』と言,いわれたので、彼,かれは『わたしが出,でて行,いって、偽,いつわりを言,いう霊,れいとなって、すべての預言者,よげんしゃの口,くちに宿,やどりましょう』と言,いいました。そこで主,しゅは『おまえは彼,かれをいざなって、それを成,なし遂,とげるであろう。出,でて行,いって、そうしなさい』と言,いわれました。","tok":[["主","しゅ"],["は"],["『"],["どのような"],["方法","ほうほう"],["で"],["する"],["の"],["か"],["』"],["と"],["言われた","いわれた"],["ので"],["、"],["彼","かれ"],["は"],["『"],["わたし"],["が"],["出て","でて"],["行って","いって"],["、"],["偽り","いつわり"],["を"],["言う","いう"],["霊","れい"],["と"],["なって"],["、"],["すべて"],["の"],["預言者","よげんしゃ"],["の"],["口","くち"],["に"],["宿りましょう","やどりましょう"],["』"],["と"],["言いました","いいました"],["。"],["そこ"],["で"],["主","しゅ"],["は"],["『"],["おまえ"],["は"],["彼","かれ"],["を"],["いざなって"],["、"],["それ"],["を"],["成し遂げるで","なしとげるで"],["あろう"],["。"],["出て","でて"],["行って","いって"],["、"],["そう"],["し"],["なさい"],["』"],["と"],["言われました","いわれました"],["。"]]},{"verse":23,"text":"それで主,しゅは偽,いつわりを言,いう霊,れいをあなたのすべての預言者,よげんしゃの口,くちに入,いれ、また主,しゅはあなたの身,みに起,おこる災,わざわいを告,つげられたのです」。","tok":[["それ"],["で"],["主","しゅ"],["は"],["偽り","いつわり"],["を"],["言う","いう"],["霊","れい"],["を"],["あなた"],["の"],["すべて"],["の"],["預言者","よげんしゃ"],["の"],["口","くち"],["に"],["入れ","いれ"],["、"],["また"],["主","しゅ"],["は"],["あなた"],["の"],["身","み"],["に"],["起こる","おこる"],["災","わざわい"],["を"],["告げられた","つげられた"],["の"],["です"],["」"],["。"]]},{"verse":24,"text":"するとケナアナの子,こゼデキヤは近寄,ちかよって、ミカヤのほおを打,うって言,いった、「どのようにして主,しゅの霊,れいがわたしを離,はなれて、あなたに語,かたりましたか」。","tok":[["する"],["と"],["ケナアナ"],["の"],["子","こ"],["ゼデキヤ"],["は"],["近寄って","ちかよって"],["、"],["ミカヤ"],["の"],["ほお"],["を"],["打って","うって"],["言った","いった"],["、"],["「"],["どの"],["よう"],["に"],["して"],["主","しゅ"],["の"],["霊","れい"],["が"],["わたし"],["を"],["離れて","はなれて"],["、"],["あなた"],["に"],["語りました","かたりました"],["か"],["」"],["。"]]},{"verse":25,"text":"ミカヤは言,いった、「あなたが奥,おくの間,あいだにはいって身,みを隠,かくすその日,ひに、わかるでしょう」。","tok":[["ミカヤ"],["は"],["言った","いった"],["、"],["「"],["あなた"],["が"],["奥","おく"],["の"],["間","あいだ"],["に"],["はいって"],["身","み"],["を"],["隠す","かくす"],["その"],["日","ひ"],["に"],["、"],["わかるでしょう"],["」"],["。"]]},{"verse":26,"text":"イスラエルの王,おうは言,いった、「ミカヤを捕,とらえ、町,まちのつかさアモンと、王,おうの子,こヨアシの所,ところへ引,ひいて帰,かえって、","tok":[["イスラエル"],["の"],["王","おう"],["は"],["言った","いった"],["、"],["「"],["ミカヤ"],["を"],["捕らえ","とらえ"],["、"],["町","まち"],["の"],["つかさ"],["アモン"],["と"],["、"],["王","おう"],["の"],["子","こ"],["ヨアシ"],["の"],["所","ところ"],["へ"],["引いて","ひいて"],["帰えって","かえって"],["、"]]},{"verse":27,"text":"言,いいなさい、『王,おうがこう言,いいます、この者,ものを獄屋,ごくやに入,いれ、わずかのパンと水,みずをもって彼,かれを養,やしない、わたしが勝利,しょうりを得,えて帰,かえってくるのを待,まて』」。","tok":[["言い","いい"],["なさい"],["、"],["『"],["王","おう"],["が"],["こう"],["言います","いいます"],["、"],["この"],["者","もの"],["を"],["獄屋","ごくや"],["に"],["入れ","いれ"],["、"],["わずか"],["の"],["パン"],["と"],["水","みず"],["を"],["もって"],["彼","かれ"],["を"],["養い","やしない"],["、"],["わたし"],["が"],["勝利","しょうり"],["を"],["得て","えて"],["帰えって","かえって"],["くる"],["の"],["を"],["待て","まて"],["』"],["」"],["。"]]},{"verse":28,"text":"ミカヤは言,いった、「もしあなたが勝利,しょうりを得,えて帰,かえってこられるならば、主,しゅがわたしによって語,かたられなかったのです」。また彼,かれは言,いった、「あなたがた、すべての民,たみよ、聞,ききなさい」。","tok":[["ミカヤ"],["は"],["言った","いった"],["、"],["「"],["もし"],["あなた"],["が"],["勝利","しょうり"],["を"],["得て","えて"],["帰えって","かえって"],["こられるならば"],["、"],["主","しゅ"],["が"],["わたし"],["によって"],["語られなかった","かたられなかった"],["の"],["です"],["」"],["。"],["また"],["彼","かれ"],["は"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["、"],["すべて"],["の"],["民","たみ"],["よ"],["、"],["聞","きき"],["なさい"],["」"],["。"]]},{"verse":29,"text":"こうしてイスラエルの王,おうとユダの王,おうヨシャパテはラモテ・ギレアデに上,のぼっていった。","tok":[["こう"],["して"],["イスラエル"],["の"],["王","おう"],["と"],["ユダ"],["の"],["王","おう"],["ヨシャパテ"],["は"],["ラモテ"],["・"],["ギレアデ"],["に"],["上って","のぼって"],["いった"],["。"]]},{"verse":30,"text":"イスラエルの王,おうはヨシャパテに言,いった、「わたしは姿,すがたを変,かえて、戦,たたかいに行,いきます。あなたは王,おうの服,ふくを着,つけなさい」。イスラエルの王,おうは姿,すがたを変,かえて戦,たたかいに行,いった。","tok":[["イスラエル"],["の"],["王","おう"],["は"],["ヨシャパテ"],["に"],["言った","いった"],["、"],["「"],["わたし"],["は"],["姿","すがた"],["を"],["変えて","かえて"],["、"],["戦い","たたかい"],["に"],["行きます","いきます"],["。"],["あなた"],["は"],["王","おう"],["の"],["服","ふく"],["を"],["着け","つけ"],["なさい"],["」"],["。"],["イスラエル"],["の"],["王","おう"],["は"],["姿","すがた"],["を"],["変えて","かえて"],["戦い","たたかい"],["に"],["行った","いった"],["。"]]},{"verse":31,"text":"さて、スリヤの王,おうは、その戦車,せんしゃ長,ちょう三十二人,にんに命,めいじて言,いった、「あなたがたは、小,ちいさい者,ものとも大,おおきい者,ものとも戦,たたかわないで、ただイスラエルの王,おうとだけ戦,たたかいなさい」。","tok":[["さて"],["、"],["スリヤ"],["の"],["王","おう"],["は"],["、"],["その"],["戦車長","せんしゃちょう"],["三十二人","にん"],["に"],["命じて","めいじて"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["、"],["小さい","ちいさい"],["者","もの"],["とも"],["大きい","おおきい"],["者","もの"],["と"],["も"],["戦わないで","たたかわないで"],["、"],["ただ"],["イスラエル"],["の"],["王","おう"],["と"],["だけ"],["戦い","たたかい"],["なさい"],["」"],["。"]]},{"verse":32,"text":"戦車,せんしゃ長,ちょうらはヨシャパテを見,みたとき、これはきっとイスラエルの王,おうだと思,おもったので、身,みをめぐらして、これと戦,たたかおうとすると、ヨシャパテは呼,よばわった。","tok":[["戦車長","せんしゃちょう"],["ら"],["は"],["ヨシャパテ"],["を"],["見た","みた"],["とき"],["、"],["これ"],["は"],["きっと"],["イスラエル"],["の"],["王","おう"],["だ"],["と"],["思った","おもった"],["ので"],["、"],["身","み"],["を"],["めぐらして"],["、"],["これ"],["と"],["戦おう","たたかおう"],["と"],["する"],["と"],["、"],["ヨシャパテ"],["は"],["呼ばわった","よばわった"],["。"]]},{"verse":33,"text":"戦車,せんしゃ長,ちょうらは彼,かれがイスラエルの王,おうでないのを見,みたので、彼,かれを追,おうことをやめて引,ひき返,かえした。","tok":[["戦車長","せんしゃちょう"],["ら"],["は"],["彼","かれ"],["が"],["イスラエル"],["の"],["王","おう"],["で"],["ない"],["の"],["を"],["見た","みた"],["ので"],["、"],["彼","かれ"],["を"],["追う","おう"],["こと"],["を"],["やめて"],["引","ひき"],["返","かえし"],["た"],["。"]]},{"verse":34,"text":"しかし、ひとりの人,ひとが何,なに心,こころなく弓,ゆみをひいて、イスラエルの王,おうの胸当,むねあてと草摺,くさずりの間,あいだを射,いたので、彼,かれはその戦車,せんしゃの御者,ぎょしゃに言,いった、「わたしは傷,きずを受,うけた。戦車,せんしゃをめぐらして、わたしを戦場,せんじょうから運,はこび出,だせ」。","tok":[["しかし"],["、"],["ひとり"],["の"],["人","ひと"],["が"],["何","な"],["に"],["心なく","こころなく"],["弓","ゆみ"],["を"],["ひいて"],["、"],["イスラエル"],["の"],["王","おう"],["の"],["胸当","むねあて"],["と"],["草摺","くさずり"],["の"],["間","あいだ"],["を"],["射た","いた"],["ので"],["、"],["彼","かれ"],["は"],["その"],["戦車","せんしゃ"],["の"],["御者","ぎょしゃ"],["に"],["言った","いった"],["、"],["「"],["わたし"],["は"],["傷","きず"],["を"],["受た","うけた"],["。"],["戦車","せんしゃ"],["を"],["めぐらして"],["、"],["わたし"],["を"],["戦場","せんじょう"],["から"],["運こび","はこび"],["出せ","だせ"],["」"],["。"]]},{"verse":35,"text":"その日,ひ戦,たたかいは激,はげしくなった。王,おうは戦車,せんしゃの中,なかにささえられて立,たち、スリヤびとにむかっていたが、ついに、夕暮,ゆうぐれになって死,しんだ。傷,きずの血,ちは戦車,せんしゃの底,そこに流,ながれた。","tok":[["その"],["日","ひ"],["戦い","たたかい"],["は"],["激しく","はげしく"],["なった"],["。"],["王","おう"],["は"],["戦車","せんしゃ"],["の"],["中","なか"],["に"],["ささえられて"],["立ち","たち"],["、"],["スリヤ"],["びと"],["に"],["むかって"],["いた"],["が"],["、"],["ついに"],["、"],["夕暮","ゆうぐれ"],["に"],["なって"],["死んだ","しんだ"],["。"],["傷","きず"],["の"],["血","ち"],["は"],["戦車","せんしゃ"],["の"],["底","そこ"],["に"],["流れた","ながれた"],["。"]]},{"verse":36,"text":"日,ひの没,ぼっするころ、軍勢,ぐんぜいの中,なかに呼,よばわる声,こえがした、「めいめいその町,まちへ、めいめいその国,くにへ帰,かえれ」。","tok":[["日","ひ"],["の"],["没する","ぼっする"],["ころ"],["、"],["軍勢","ぐんぜい"],["の"],["中","なか"],["に"],["呼ばわる","よばわる"],["声","こえ"],["が"],["した"],["、"],["「"],["めいめい"],["その"],["町","まち"],["へ"],["、"],["めいめい"],["その"],["国","くに"],["へ"],["帰えれ","かえれ"],["」"],["。"]]},{"verse":37,"text":"王,おうは死,しんで、サマリヤへ携,たずさえ行,いかれた。人々,ひとびとは王,おうをサマリヤに葬,ほうむった。","tok":[["王","おう"],["は"],["死んで","しんで"],["、"],["サマリヤ"],["へ"],["携え","たずさえ"],["行かれた","いかれた"],["。"],["人々","ひとびと"],["は"],["王","おう"],["を"],["サマリヤ"],["に"],["葬むった","ほうむった"],["。"]]},{"verse":38,"text":"またその戦車,せんしゃをサマリヤの池,いけで洗,あらったが、犬,いぬがその血,ちをなめた。また遊女,ゆうじょがそこで身,みを洗,あらった。主,しゅが言,いわれた言葉,ことばのとおりである。","tok":[["また"],["その"],["戦車","せんしゃ"],["を"],["サマリヤ"],["の"],["池","いけ"],["で"],["洗った","あらった"],["が"],["、"],["犬","いぬ"],["が"],["その"],["血","ち"],["を"],["なめた"],["。"],["また"],["遊女","ゆうじょ"],["が"],["そこ"],["で"],["身","み"],["を"],["洗った","あらった"],["。"],["主","しゅ"],["が"],["言われた","いわれた"],["言葉","ことば"],["の"],["とおり"],["で"],["ある"],["。"]]},{"verse":39,"text":"アハブのそのほかの事績,じせきと、彼,かれがしたすべての事,ことと、その建,たてた象牙,ぞうげの家,いえと、その建,たてたすべての町,まちは、イスラエルの王,おうの歴代志,れきだいしの書,しょにしるされているではないか。","tok":[["アハブ"],["の"],["その"],["ほか"],["の"],["事績","じせき"],["と"],["、"],["彼","かれ"],["が"],["した"],["すべて"],["の"],["事","こと"],["と"],["、"],["その"],["建てた","たてた"],["象牙","ぞうげ"],["の"],["家","いえ"],["と"],["、"],["その"],["建てた","たてた"],["すべて"],["の"],["町","まち"],["は"],["、"],["イスラエル"],["の"],["王","おう"],["の"],["歴代志","れきだいし"],["の"],["書","しょ"],["に"],["しるされて"],["いるで"],["は"],["ない"],["か"],["。"]]},{"verse":40,"text":"こうしてアハブはその先祖,せんぞと共,ともに眠,ねむって、その子,こアハジヤが代,かわって王,おうとなった。","tok":[["こう"],["して"],["アハブ"],["は"],["その"],["先祖","せんぞ"],["と"],["共","とも"],["に"],["眠って","ねむって"],["、"],["その"],["子","こ"],["アハジヤ"],["が"],["代わって","かわって"],["王","おう"],["と"],["なった"],["。"]]},{"verse":41,"text":"アサの子,こヨシャパテはイスラエルの王,おうアハブの第,だい四年,ねんにユダの王,おうとなった。","tok":[["アサ"],["の"],["子","こ"],["ヨシャパテ"],["は"],["イスラエル"],["の"],["王","おう"],["アハブ"],["の"],["第","だい"],["四","よん"],["年","ねん"],["に"],["ユダ"],["の"],["王","おう"],["と"],["なった"],["。"]]},{"verse":42,"text":"ヨシャパテは王,おうとなった時,とき、三十五歳,さいであったが、エルサレムで二十五年,ねん世,よを治,おさめた。その母,ははの名,なはアズバといい、シルヒの娘,むすめであった。","tok":[["ヨシャパテ"],["は"],["王","おう"],["と"],["なった"],["時","とき"],["、"],["三十五歳","さ"],["いで"],["あった"],["が"],["、"],["エルサレム"],["で"],["二十五","にじゅうご"],["年世","年よ"],["を"],["治めた","おさめた"],["。"],["その"],["母","はは"],["の"],["名","な"],["は"],["アズバ"],["と"],["いい"],["、"],["シルヒ"],["の"],["娘","むすめ"],["で"],["あった"],["。"]]},{"verse":43,"text":"[43a]ヨシャパテは父,ちちアサのすべての道,みちに歩,あゆみ、それを離,はなれることなく、主,しゅの目,めにかなう事,ことをした。","tok":[["["],["43"],["a"],["]"],["ヨシャパテ"],["は"],["父","ちち"],["アサ"],["の"],["すべて"],["の"],["道","みち"],["に"],["歩み","あゆみ"],["、"],["それ"],["を"],["離れる","はなれる"],["こと"],["なく"],["、"],["主","しゅ"],["の"],["目","め"],["に"],["かなう"],["事","こと"],["を"],["した"],["。"]]},{"verse":44,"text":"[43b]ただし高,たかき所,ところは除,のぞかなかったので、民,たみはなお高,たかき所,ところで犠牲,ぎせいをささげ、香,こうをたいた。","tok":[["["],["43"],["b"],["]"],["ただし"],["高き","たかき"],["所","ところ"],["は"],["除かなかった","のぞかなかった"],["ので"],["、"],["民","た"],["み"],["は"],["なお"],["高き","たかき"],["所","ところ"],["で"],["犠牲","ぎせい"],["を"],["ささげ"],["、"],["香","こう"],["を"],["たいた"],["。"]]},{"verse":45,"text":"[44]ヨシャパテはまたイスラエルの王,おうと、よしみを結,むすんだ。","tok":[["["],["44"],["]"],["ヨシャパテ"],["は"],["また"],["イスラエル"],["の"],["王","おう"],["と"],["、"],["よしみ"],["を"],["結んだ","むすんだ"],["。"]]},{"verse":46,"text":"[45]ヨシャパテのその他,たの事績,じせきと、彼,かれがあらわした勲功,くんこうおよびその戦争,せんそうについては、ユダの王,おうの歴代志,れきだいしの書,しょにしるされているではないか。","tok":[["["],["45"],["]"],["ヨシャパテ"],["の"],["その"],["他","た"],["の"],["事績","じせき"],["と"],["、"],["彼","かれ"],["が"],["あらわした"],["勲功","くんこう"],["および"],["その"],["戦争","せんそう"],["について"],["は"],["、"],["ユダ"],["の"],["王","おう"],["の"],["歴代志","れきだいし"],["の"],["書","しょ"],["に"],["しるされて"],["いるで"],["は"],["ない"],["か"],["。"]]},{"verse":47,"text":"[46]彼,かれは父,ちちアサの世,よになお残,のこっていた神殿,しんでん男娼,だんしょうたちを国,くにのうちから追,おい払,はらった。","tok":[["["],["46"],["]"],["彼","かれ"],["は"],["父","ちち"],["アサ"],["の"],["世","よ"],["に"],["なお"],["残って","のこって"],["いた"],["神殿","しんでん"],["男娼","だんしょう"],["たち"],["を"],["国","くに"],["の"],["うち"],["から"],["追い払った","おいはらった"],["。"]]},{"verse":48,"text":"[47]そのころエドムには王,おうがなく、代官,だいかんが王,おうであった。","tok":[["["],["47"],["]"],["その"],["ころ"],["エドム"],["に"],["は"],["王","おう"],["が"],["なく"],["、"],["代官","だいかん"],["が"],["王","おう"],["で"],["あった"],["。"]]},{"verse":49,"text":"[48]ヨシャパテはタルシシの船,ふねを造,つくって、金,きんを獲,えるためにオフルに行,いかせようとしたが、その船,ふねはエジオン・ゲベルで難破,なんぱしたため、ついに行,いかなかった。","tok":[["["],["48"],["]"],["ヨシャパテ"],["は"],["タルシシ"],["の"],["船","ふね"],["を"],["造って","つくって"],["、"],["金","きん"],["を"],["獲る","える"],["ため"],["に"],["オフル"],["に"],["行かせよう","いかせよう"],["と"],["した"],["が"],["、"],["その"],["船","ふね"],["は"],["エジオン"],["・"],["ゲベル"],["で"],["難破","なんぱ"],["した"],["ため"],["、"],["ついに"],["行かなかった","いかなかった"],["。"]]},{"verse":50,"text":"[49]そこでアハブの子,こアハジヤはヨシャパテに「わたしの家来,けらいをあなたの家来,けらいと一緒,いっしょに船,ふねで行,いかせなさい」と言,いったが、ヨシャパテは承知,しょうちしなかった。","tok":[["["],["49"],["]"],["そこ"],["で"],["アハブ"],["の"],["子","こ"],["アハジヤ"],["は"],["ヨシャパテ"],["に"],["「"],["わたし"],["の"],["家来","けらい"],["を"],["あなた"],["の"],["家来","けらい"],["と"],["一緒","いっしょ"],["に"],["船","ふね"],["で"],["行かせ","いかせ"],["なさい"],["」"],["と"],["言った","いった"],["が"],["、"],["ヨシャパテ"],["は"],["承知","しょうち"],["しなかった"],["。"]]},{"verse":51,"text":"[50]ヨシャパテはその先祖,せんぞと共,ともに眠,ねむって、父,ちちダビデの町,まちに先祖,せんぞと共,ともに葬,ほうむられ、その子,こヨラムが代,かわって王,おうとなった。","tok":[["["],["50"],["]"],["ヨシャパテ"],["は"],["その"],["先祖","せんぞ"],["と"],["共","とも"],["に"],["眠って","ねむって"],["、"],["父","ちち"],["ダビデ"],["の"],["町","まち"],["に"],["先祖","せんぞ"],["と"],["共","とも"],["に"],["葬むられ","ほうむられ"],["、"],["その"],["子","こ"],["ヨラム"],["が"],["代わって","かわって"],["王","おう"],["と"],["なった"],["。"]]},{"verse":52,"text":"[51]アハブの子,こアハジヤはユダの王,おうヨシャパテの第,だい十七年,ねんにサマリヤでイスラエルの王,おうとなり、二年,ねんイスラエルを治,おさめた。","tok":[["["],["51"],["]"],["アハブ"],["の"],["子","こ"],["アハジヤ"],["は"],["ユダ"],["の"],["王","おう"],["ヨシャパテ"],["の"],["第","だい"],["十七","じゅうなな"],["年","ねん"],["に"],["サマリヤ"],["で"],["イスラエル"],["の"],["王","おう"],["と"],["なり"],["、"],["二","に"],["年","ねん"],["イスラエル"],["を"],["治めた","おさめた"],["。"]]},{"verse":53,"text":"[52]彼,かれは主,しゅの目,めの前,まえに悪,あくを行,おこない、その父,ちちの道,みちと、その母,ははの道,みち、およびかのイスラエルに罪,つみを犯,おかさせたネバテの子,こヤラベアムの道,みちに歩,あゆみ、","tok":[["["],["52"],["]"],["彼","かれ"],["は"],["主","しゅ"],["の"],["目","め"],["の"],["前","まえ"],["に"],["悪","あく"],["を"],["行ない","おこない"],["、"],["その"],["父","ちち"],["の"],["道","みち"],["と"],["、"],["その"],["母","はは"],["の"],["道","みち"],["、"],["および"],["かの"],["イスラエル"],["に"],["罪","つみ"],["を"],["犯させた","おかさせた"],["ネバテ"],["の"],["子","こ"],["ヤラベアム"],["の"],["道","みち"],["に"],["歩み","あゆみ"],["、"]]},{"verse":54,"text":"[53]バアルに仕,つかえて、それを拝,おがみ、イスラエルの神,かみ、主,しゅを怒,いからせた。すべて彼,かれの父,ちちがしたとおりであった。","tok":[["["],["53"],["]"],["バアル"],["に"],["仕えて","つかえて"],["、"],["それ"],["を"],["拝み","おがみ"],["、"],["イスラエル"],["の"],["神","かみ"],["、"],["主","しゅ"],["を"],["怒らせた","いからせた"],["。"],["すべて"],["彼","かれ"],["の"],["父","ちち"],["が"],["した"],["とおり"],["で"],["あった"],["。"]]}]
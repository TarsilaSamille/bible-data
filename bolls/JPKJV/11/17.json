[{"verse":1,"text":"ギレアデのテシベに住,すむテシベびとエリヤはアハブに言,いった、「わたしの仕,つかえているイスラエルの神,かみ、主,しゅは生,いきておられます。わたしの言葉,ことばのないうちは、数年,すうねん雨,あめも露,つゆもないでしょう」。","tok":[["ギレアデ"],["の"],["テシベ"],["に"],["住む","すむ"],["テシベ"],["びと"],["エリヤ"],["は"],["アハブ"],["に"],["言った","いった"],["、"],["「"],["わたし"],["の"],["仕えて","つかえて"],["いる"],["イスラエル"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["生きて","いきて"],["おられます"],["。"],["わたし"],["の"],["言葉","ことば"],["の"],["ない"],["うち"],["は"],["、"],["数","すう"],["年雨","年あめ"],["も"],["露","つゆ"],["も"],["ないでしょう"],["」"],["。"]]},{"verse":2,"text":"主,しゅの言葉,ことばがエリヤに臨,のぞんだ、","tok":[["主","しゅ"],["の"],["言葉","ことば"],["が"],["エリヤ"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":3,"text":"「ここを去,さって東,ひがしにおもむき、ヨルダンの東,ひがしにあるケリテ川,かわのほとりに身,みを隠,かくしなさい。","tok":[["「"],["ここ"],["を"],["去て","さって"],["東","ひがし"],["に"],["おもむき"],["、"],["ヨルダン"],["の"],["東","ひがし"],["に"],["ある"],["ケリテ"],["川","かわ"],["の"],["ほとり"],["に"],["身","み"],["を"],["隠し","かくし"],["なさい"],["。"]]},{"verse":4,"text":"そしてその川,かわの水,みずを飲,のみなさい。わたしはからすに命,めいじて、そこであなたを養,やしなわせよう」。","tok":[["そして"],["その"],["川","かわ"],["の"],["水","みず"],["を"],["飲み","のみ"],["なさい"],["。"],["わたし"],["は"],["からす"],["に"],["命じて","めいじて"],["、"],["そこ"],["で"],["あなた"],["を"],["養わせよう","やしなわせよう"],["」"],["。"]]},{"verse":5,"text":"エリヤは行,いって、主,しゅの言葉,ことばのとおりにした。すなわち行,いって、ヨルダンの東,ひがしにあるケリテ川,かわのほとりに住,すんだ。","tok":[["エリヤ"],["は"],["行って","いって"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["の"],["とおり"],["に"],["した"],["。"],["すなわち"],["行って","いって"],["、"],["ヨルダン"],["の"],["東","ひがし"],["に"],["ある"],["ケリテ"],["川","かわ"],["の"],["ほとり"],["に"],["住んだ","すんだ"],["。"]]},{"verse":6,"text":"すると、からすが朝,あさごとに彼,かれの所,ところにパンと肉,にくを運,はこび、また夕,ゆうごとにパンと肉,にくを運,はこんできた。そして彼,かれはその川,かわの水,みずを飲,のんだ。","tok":[["する"],["と"],["、"],["からす"],["が"],["朝","あさ"],["ごと"],["に"],["彼","かれ"],["の"],["所","ところ"],["に"],["パン"],["と"],["肉","にく"],["を"],["運こび","はこび"],["、"],["また"],["夕","ゆう"],["ごと"],["に"],["パン"],["と"],["肉","にく"],["を"],["運こんで","はこんで"],["きた"],["。"],["そして"],["彼","かれ"],["は"],["その"],["川","かわ"],["の"],["水","みず"],["を"],["飲んだ","のんだ"],["。"]]},{"verse":7,"text":"しかし国,くにに雨,あめがなかったので、しばらくしてその川,かわはかれた。","tok":[["しかし"],["国","くに"],["に"],["雨","あめ"],["が"],["なかった"],["ので"],["、"],["しばらく"],["して"],["その"],["川","かわ"],["は"],["かれた"],["。"]]},{"verse":8,"text":"その時,とき、主,しゅの言葉,ことばが彼,かれに臨,のぞんで言,いった、","tok":[["その"],["時","とき"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["が"],["彼","かれ"],["に"],["臨んで","のぞんで"],["言った","いった"],["、"]]},{"verse":9,"text":"「立,たってシドンに属,ぞくするザレパテへ行,いって、そこに住,すみなさい。わたしはそのところのやもめ女,おんなに命,めいじてあなたを養,やしなわせよう」。","tok":[["「"],["立って","たって"],["シドン"],["に"],["属する","ぞくする"],["ザレパテ"],["へ"],["行って","いって"],["、"],["そこ"],["に"],["住み","すみ"],["なさい"],["。"],["わたし"],["は"],["その"],["ところ"],["の"],["やもめ"],["女","おんな"],["に"],["命じて","めいじて"],["あなた"],["を"],["養わせよう","やしなわせよう"],["」"],["。"]]},{"verse":10,"text":"そこで彼,かれは立,たってザレパテへ行,いったが、町,まちの門,もんに着,ついたとき、ひとりのやもめ女,おんなが、その所,ところでたきぎを拾,ひろっていた。彼,かれはその女,おんなに声,こえをかけて言,いった、「器,うつわに水,みずを少,すこし持,もってきて、わたしに飲,のませてください」。","tok":[["そこ"],["で"],["彼","かれ"],["は"],["立って","たって"],["ザレパテ"],["へ"],["行った","いった"],["が"],["、"],["町","まち"],["の"],["門","もん"],["に"],["着いた","ついた"],["とき"],["、"],["ひとり"],["の"],["やもめ"],["女","おんな"],["が"],["、"],["その"],["所","ところ"],["で"],["たきぎ"],["を"],["拾って","ひろって"],["いた"],["。"],["彼","かれ"],["は"],["その"],["女","おんな"],["に"],["声","こえ"],["を"],["かけて"],["言った","いった"],["、"],["「"],["器","うつわ"],["に"],["水","みず"],["を"],["少し","すこし"],["持って","もって"],["きて"],["、"],["わたし"],["に"],["飲ませて","のませて"],["ください"],["」"],["。"]]},{"verse":11,"text":"彼女,かのじょが行,いって、それを持,もってこようとした時,とき、彼,かれは彼女,かのじょを呼,よんで言,いった、「手,てに一口,ひとくちのパンを持,もってきてください」。","tok":[["彼女","かのじょ"],["が"],["行って","いって"],["、"],["それ"],["を"],["持って","もって"],["こよう"],["と"],["した"],["時","とき"],["、"],["彼","かれ"],["は"],["彼女","かのじょ"],["を"],["呼んで","よんで"],["言った","いった"],["、"],["「"],["手","て"],["に"],["一口","ひとくち"],["の"],["パン"],["を"],["持って","もって"],["きて"],["ください"],["」"],["。"]]},{"verse":12,"text":"彼女,かのじょは言,いった、「あなたの神,かみ、主,しゅは生,いきておられます。わたしにはパンはありません。ただ、かめに一握,ひとにぎりの粉,こなと、びんに少,すこしの油,あぶらがあるだけです。今,いまわたしはたきぎ二、三本,ぼんを拾,ひろい、うちへ帰,かえって、わたしと子供,こどものためにそれを調理,ちょうりし、それを食,たべて死,しのうとしているのです」。","tok":[["彼女","かのじょ"],["は"],["言った","いった"],["、"],["「"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["生きて","いきて"],["おられます"],["。"],["わたし"],["に"],["は"],["パン"],["は"],["ありません"],["。"],["ただ"],["、"],["かめ"],["に"],["一握り","ひとにぎり"],["の"],["粉","こな"],["と"],["、"],["びん"],["に"],["少し","すこし"],["の"],["油","あぶら"],["が"],["ある"],["だけ"],["です"],["。"],["今","いま"],["わたし"],["は"],["たきぎ"],["二","に"],["、"],["三本","ぼん"],["を"],["拾い","ひろい"],["、"],["うち"],["へ"],["帰えって","かえって"],["、"],["わたし"],["と"],["子供","こども"],["の"],["ため"],["に"],["それ"],["を"],["調理","ちょうり"],["し"],["、"],["それ"],["を"],["食べて","たべて"],["死のう","しのう"],["として"],["いる"],["の"],["です"],["」"],["。"]]},{"verse":13,"text":"エリヤは彼女,かのじょに言,いった、「恐,おそれるにはおよばない。行,いって、あなたが言,いったとおりにしなさい。しかしまず、それでわたしのために小,ちいさいパンを、一つ作,つくって持,もってきなさい。その後,のち、あなたと、あなたの子供,こどものために作,つくりなさい。","tok":[["エリヤ"],["は"],["彼女","かのじょ"],["に"],["言った","いった"],["、"],["「"],["恐れる","おそれる"],["に"],["は"],["およばない"],["。"],["行って","いって"],["、"],["あなた"],["が"],["言った","いった"],["とおり"],["に"],["し"],["なさい"],["。"],["しかし"],["まず"],["、"],["それ"],["で"],["わたし"],["の"],["ため"],["に"],["小さい","ちいさい"],["パン"],["を"],["、"],["一","ひと"],["つ"],["作って","つくって"],["持って","もって"],["き"],["なさい"],["。"],["その後","そのの"],["ち"],["、"],["あなた"],["と"],["、"],["あなた"],["の"],["子供","こども"],["の"],["ため"],["に"],["作り","つくり"],["なさい"],["。"]]},{"verse":14,"text":"『主,しゅが雨,あめを地,ちのおもてに降,ふらす日,ひまで、かめの粉,こなは尽,つきず、びんの油,あぶらは絶,たえない』とイスラエルの神,かみ、主,しゅが言,いわれるからです」。","tok":[["『"],["主","しゅ"],["が"],["雨","あめ"],["を"],["地","ち"],["の"],["おもて"],["に"],["降らす","ふらす"],["日","ひ"],["まで"],["、"],["かめ"],["の"],["粉","こな"],["は"],["尽ず","つきず"],["、"],["びん"],["の"],["油","あぶら"],["は"],["絶えない","たえない"],["』"],["と"],["イスラエル"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["言われる","いわれる"],["から"],["です"],["」"],["。"]]},{"verse":15,"text":"彼女,かのじょは行,いって、エリヤが言,いったとおりにした。彼女,かのじょと彼,かれおよび彼女,かのじょの家族,かぞくは久,ひさしく食,たべた。","tok":[["彼女","かのじょ"],["は"],["行って","いって"],["、"],["エリヤ"],["が"],["言った","いった"],["とおり"],["に"],["した"],["。"],["彼女","かのじょ"],["と"],["彼","かれ"],["および"],["彼女","かのじょ"],["の"],["家族","かぞく"],["は"],["久く","ひさしく"],["食べた","たべた"],["。"]]},{"verse":16,"text":"主,しゅがエリヤによって言,いわれた言葉,ことばのように、かめの粉,こなは尽,つきず、びんの油,あぶらは絶,たえなかった。","tok":[["主","しゅ"],["が"],["エリヤ"],["によって"],["言われた","いわれた"],["言葉","ことば"],["の"],["よう"],["に"],["、"],["かめ"],["の"],["粉","こな"],["は"],["尽ず","つきず"],["、"],["びん"],["の"],["油","あぶら"],["は"],["絶えなかった","たえなかった"],["。"]]},{"verse":17,"text":"これらの事,ことの後,のち、その家,いえの主婦,しゅふであるこの女,おんなの男,おとこの子,こが病気,びょうきになった。その病気,びょうきはたいそう重,おもく、息,いきが絶,たえたので、","tok":[["これ"],["ら"],["の"],["事","こと"],["の"],["後","の"],["ち"],["、"],["その"],["家","いえ"],["の"],["主婦","しゅふ"],["で"],["ある"],["この"],["女","おんな"],["の"],["男の子","おとこのこ"],["が"],["病気","びょうき"],["に"],["なった"],["。"],["その"],["病気","びょうき"],["は"],["たいそう"],["重く","おもく"],["、"],["息","いき"],["が"],["絶えた","たえた"],["ので"],["、"]]},{"verse":18,"text":"彼女,かのじょはエリヤに言,いった、「神,かみの人,ひとよ、あなたはわたしに、何,なにの恨,うらみがあるのですか。あなたはわたしの罪,つみを思,おもい出,ださせるため、またわたしの子,こを死,しなせるためにおいでになったのですか」。","tok":[["彼女","かのじょ"],["は"],["エリヤ"],["に"],["言った","いった"],["、"],["「"],["神","かみ"],["の"],["人","ひと"],["よ"],["、"],["あなた"],["は"],["わたし"],["に"],["、"],["何","なに"],["の"],["恨み","うらみ"],["が"],["ある"],["の"],["です"],["か"],["。"],["あなた"],["は"],["わたし"],["の"],["罪","つみ"],["を"],["思い出させる","おもいださせる"],["ため"],["、"],["また"],["わたし"],["の"],["子","こ"],["を"],["死なせる","しなせる"],["ため"],["に"],["おいで"],["に"],["なった"],["の"],["です"],["か"],["」"],["。"]]},{"verse":19,"text":"エリヤは彼女,かのじょに言,いった、「子,こをわたしによこしなさい」。そして彼女,かのじょのふところから子供,こどもを取,とり、自分,じぶんのいる屋上,おくじょうのへやへかかえて上,のぼり、自分,じぶんの寝台,しんだいに寝,ねかせ、","tok":[["エリヤ"],["は"],["彼女","かのじょ"],["に"],["言った","いった"],["、"],["「"],["子","こ"],["を"],["わたし"],["に"],["よこし"],["なさい"],["」"],["。"],["そして"],["彼女","かのじょ"],["の"],["ふところ"],["から"],["子供","こども"],["を"],["取","とり"],["、"],["自分","じぶん"],["の"],["いる"],["屋上","おくじょう"],["の"],["へや"],["へ"],["かかえて"],["上り","のぼり"],["、"],["自分","じぶん"],["の"],["寝台","しんだい"],["に"],["寝かせ","ねかせ"],["、"]]},{"verse":20,"text":"主,しゅに呼,よばわって言,いった、「わが神,かみ、主,しゅよ、あなたはわたしが宿,やどっている家,いえのやもめにさえ災,わざわいをくだして、子供,こどもを殺,ころされるのですか」。","tok":[["主に","しゅに"],["呼ばわって","よばわって"],["言った","いった"],["、"],["「"],["わが"],["神","かみ"],["、"],["主","しゅ"],["よ"],["、"],["あなた"],["は"],["わたし"],["が"],["宿って","やどって"],["いる"],["家","いえ"],["の"],["やもめ"],["に"],["さえ"],["災","わざわい"],["を"],["くだして"],["、"],["子供","こども"],["を"],["殺ろされる","ころされる"],["の"],["です"],["か"],["」"],["。"]]},{"verse":21,"text":"そして三度,どその子,こ供,ともの上,うえに身,みを伸,のばし、主,しゅに呼,よばわって言,いった、「わが神,かみ、主,しゅよ、この子供,こどもの魂,たましいをもとに帰,かえらせてください」。","tok":[["そして"],["三","さん"],["度","ど"],["の"],["子供","ことも"],["の"],["上","うえ"],["に"],["身","み"],["を"],["伸ばし","のばし"],["、"],["主に","しゅに"],["呼ばわって","よばわって"],["言った","いった"],["、"],["「"],["わが"],["神","かみ"],["、"],["主","しゅ"],["よ"],["、"],["この"],["子供","こども"],["の"],["魂","たましい"],["を"],["もと"],["に"],["帰えらせて","かえらせて"],["ください"],["」"],["。"]]},{"verse":22,"text":"主,しゅはエリヤの声,こえを聞,ききいれられたので、その子,こ供,ともの魂,たましいはもとに帰,かえって、彼,かれは生,いきかえった。","tok":[["主","しゅ"],["は"],["エリヤ"],["の"],["声","こえ"],["を"],["聞きいれられた","ききいれられた"],["ので"],["、"],["その"],["子供","ことも"],["の"],["魂","たましい"],["は"],["もと"],["に"],["帰えって","かえって"],["、"],["彼","かれ"],["は"],["生きかえった","いきかえった"],["。"]]},{"verse":23,"text":"エリヤはその子,こ供,ともを取,とって屋上,おくじょうのへやから家,いえの中,なかにつれて降,ふり、その母,ははにわたして言,いった、「ごらんなさい。あなたの子,こは生,いきかえりました」。","tok":[["エリヤ"],["は"],["その"],["子供","ことも"],["を"],["取って","とって"],["屋上","おくじょう"],["の"],["へや"],["から"],["家","いえ"],["の"],["中","なか"],["に"],["つれて"],["降り","ふり"],["、"],["その"],["母","はは"],["に"],["わたして"],["言った","いった"],["、"],["「"],["ごらん"],["なさい"],["。"],["あなた"],["の"],["子","こ"],["は"],["生きかえりました","いきかえりました"],["」"],["。"]]},{"verse":24,"text":"女,おんなはエリヤに言,いった、「今,いまわたしはあなたが神,かみの人,ひとであることと、あなたの口,くちにある主,しゅの言葉,ことばが真実,しんじつであることを知,しりました」。","tok":[["女","おんな"],["は"],["エリヤ"],["に"],["言った","いった"],["、"],["「"],["今","いま"],["わたし"],["は"],["あなた"],["が"],["神","かみ"],["の"],["人","ひと"],["で"],["ある"],["こと"],["と"],["、"],["あなた"],["の"],["口","くち"],["に"],["ある"],["主","しゅ"],["の"],["言葉","ことば"],["が"],["真実","しんじつ"],["で"],["ある"],["こと"],["を"],["知りました","しりました"],["」"],["。"]]}]
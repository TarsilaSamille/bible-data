[{"verse":1,"text":"ソロモン王,おうはイスラエルの全,ぜん地,ちの王,おうであった。","tok":[["ソロモン"],["王","おう"],["は"],["イスラエル"],["の"],["全地","ぜんち"],["の"],["王","おう"],["で"],["あった"],["。"]]},{"verse":2,"text":"彼,かれの高官,こうかんたちは次,つぎのとおりである。ザドクの子,こアザリヤは祭司,さいし。","tok":[["彼","かれ"],["の"],["高官","こうかん"],["たち"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["ザドク"],["の"],["子","こ"],["アザリヤ"],["は"],["祭司","さいし"],["。"]]},{"verse":3,"text":"シシャの子,こエリホレフとアヒヤは書記官,しょきかん。アヒルデの子,こヨシャバテは史官,しかん。","tok":[["シシャ"],["の"],["子","こ"],["エリホレフ"],["と"],["アヒヤ"],["は"],["書記官","しょきかん"],["。"],["アヒルデ"],["の"],["子","こ"],["ヨシャバテ"],["は"],["史官","しかん"],["。"]]},{"verse":4,"text":"エホヤダの子,こベナヤは軍,ぐんの長,ちょう。ザドクとアビヤタルは祭司,さいし。","tok":[["エホヤダ"],["の"],["子","こ"],["ベナヤ"],["は"],["軍","ぐん"],["の"],["長う","ちょう"],["。"],["ザドク"],["と"],["アビヤタル"],["は"],["祭司","さいし"],["。"]]},{"verse":5,"text":"ナタンの子,こアザリヤは代官,だいかんの長,ちょう。ナタンの子,こザブデは祭司,さいしで、王,おうの友,ともであった。","tok":[["ナタン"],["の"],["子","こ"],["アザリヤ"],["は"],["代官","だいかん"],["の"],["長う","ちょう"],["。"],["ナタン"],["の"],["子","こ"],["ザブデ"],["は"],["祭司","さいし"],["で"],["、"],["王","おう"],["の"],["友","とも"],["で"],["あった"],["。"]]},{"verse":6,"text":"アヒシャルは宮内卿,くないきょう。アブダの子,こアドニラムは徴募,ちょうぼの長,ちょうであった。","tok":[["アヒシャル"],["は"],["宮内卿","くないきょう"],["。"],["アブダ"],["の"],["子","こ"],["アドニラム"],["は"],["徴募","ちょうぼ"],["の"],["長","ちょう"],["で"],["あった"],["。"]]},{"verse":7,"text":"ソロモンはまたイスラエルの全,ぜん地,ちに十二人,にんの代官,だいかんを置,おいた。その人々,ひとびとは王,おうとその家,いえのために食物,しょくもつを備,そなえた。すなわちおのおの一年,ねんに一月,つきずつ食物,しょくもつを備,そなえるのであった。","tok":[["ソロモン"],["は"],["また"],["イスラエル"],["の"],["全地","ぜんち"],["に"],["十二人","にん"],["の"],["代官","だいかん"],["を"],["置いた","おいた"],["。"],["その"],["人々","ひとびと"],["は"],["王","おう"],["と"],["その"],["家","いえ"],["の"],["ため"],["に"],["食物","しょくもつ"],["を"],["備","そなえ"],["た"],["。"],["すなわち"],["おのおの"],["一","いち"],["年","ねん"],["に"],["一","いち"],["月","がつ"],["き"],["ずつ"],["食物","しょくもつ"],["を"],["備","そなえ"],["る"],["ので"],["あった"],["。"]]},{"verse":8,"text":"その名,なは次,つぎのとおりである。エフライムの山地,さんちにはベンホル。","tok":[["その"],["名","な"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["エフライム"],["の"],["山地","さんち"],["に"],["は"],["ベンホル"],["。"]]},{"verse":9,"text":"マカヅと、シャラビムと、ベテシメシと、エロン・ベテハナンにはベンデケル。","tok":[["マカヅ"],["と"],["、"],["シャラビム"],["と"],["、"],["ベテシメシ"],["と"],["、"],["エロン"],["・"],["ベテハナン"],["に"],["は"],["ベンデケル"],["。"]]},{"verse":10,"text":"アルボテにはベンヘセデ、（彼,かれはソコとヘペルの全,ぜん地,ちを担当,たんとうした）。","tok":[["アルボテ"],["に"],["は"],["ベンヘセデ"],["、"],["（"],["彼","かれ"],["は"],["ソコ"],["と"],["ヘペル"],["の"],["全地","ぜんち"],["を"],["担当","たんとう"],["した"],["）"],["。"]]},{"verse":11,"text":"ドルの高地,こうちの全部,ぜんぶにはベン・アビナダブ、（彼,かれはソロモンの娘,むすめタパテを妻,つまとした）。","tok":[["ドル"],["の"],["高地","こうち"],["の"],["全部","ぜんぶ"],["に"],["は"],["ベン"],["・"],["アビナダブ"],["、"],["（"],["彼","かれ"],["は"],["ソロモン"],["の"],["娘","むすめ"],["タパテ"],["を"],["妻","つま"],["と"],["した"],["）"],["。"]]},{"verse":12,"text":"アヒルデの子,こバアナはタアナクとメギドと、エズレルの下,した、ザレタンのかたわらにあるベテシャンの全,ぜん地,ちを担当,たんとうして、ベテシャンからアベル・メホラに至,いたり、ヨクメアムの向,むこうにまで及,およんだ。","tok":[["アヒルデ"],["の"],["子","こ"],["バアナ"],["は"],["タアナク"],["と"],["メギド"],["と"],["、"],["エズレル"],["の"],["下","した"],["、"],["ザレタン"],["の"],["かたわら"],["に"],["ある"],["ベテシャン"],["の"],["全地","ぜんち"],["を"],["担当","たんとう"],["して"],["、"],["ベテシャン"],["から"],["アベル"],["・"],["メホラ"],["に"],["至","いたり"],["、"],["ヨクメアム"],["の"],["向こう","むこう"],["に"],["まで"],["及んだ","およんだ"],["。"]]},{"verse":13,"text":"ラモテ・ギレアデにはベンゲベル、（彼,かれはギレアデにあるマナセの子,こヤイルの村々,むらむらを担当,たんとうし、またバシャンにあるアルゴブの地方,ちほうの城壁,じょうへきと青銅,せいどうの貫,かんの木,きのある大,おおきな町,まち六十を担当,たんとうした）。","tok":[["ラモテ"],["・"],["ギレアデ"],["に"],["は"],["ベンゲベル"],["、"],["（"],["彼","かれ"],["は"],["ギレアデ"],["に"],["ある"],["マナセ"],["の"],["子","こ"],["ヤイル"],["の"],["村々","むらむら"],["を"],["担当","たんとう"],["し"],["、"],["また"],["バシャン"],["に"],["ある"],["アルゴブ"],["の"],["地方","ちほう"],["の"],["城壁","じょうへき"],["と"],["青銅","せいどう"],["の"],["貫の木","かんのき"],["の"],["ある"],["大きな","おおきな"],["町","まち"],["六十","ろくじゅう"],["を"],["担当","たんとう"],["した"],["）"],["。"]]},{"verse":14,"text":"マハナイムにはイドの子,こアヒナダブ。","tok":[["マハナイム"],["に"],["は"],["イド"],["の"],["子","こ"],["アヒナダブ"],["。"]]},{"verse":15,"text":"ナフタリにはアヒマアズ、（彼,かれもソロモンの娘,むすめバスマテを妻,つまにめとった）。","tok":[["ナフタリ"],["に"],["は"],["アヒマアズ"],["、"],["（"],["彼","かれ"],["も"],["ソロモン"],["の"],["娘","むすめ"],["バスマテ"],["を"],["妻","つま"],["に"],["めとった"],["）"],["。"]]},{"verse":16,"text":"アセルとベアロテにはホシャイの子,こバアナ。","tok":[["アセル"],["と"],["ベアロテ"],["に"],["は"],["ホシャイ"],["の"],["子","こ"],["バアナ"],["。"]]},{"verse":17,"text":"イッサカルにはパルアの子,こヨシャパテ。","tok":[["イッサカル"],["に"],["は"],["パルア"],["の"],["子","こ"],["ヨシャパテ"],["。"]]},{"verse":18,"text":"ベニヤミンにはエラの子,こシメイ。","tok":[["ベニヤミン"],["に"],["は"],["エラ"],["の"],["子","こ"],["シメイ"],["。"]]},{"verse":19,"text":"アモリびとの王,おうシホンの地,ちおよびバシャンの王,おうオグの地,ちなるギレアデの地,ちにはウリの子,こゲベル。彼,かれはその地,ちのただひとりの代官,だいかんであった。","tok":[["アモリ"],["びと"],["の"],["王","おう"],["シホン"],["の"],["地","ち"],["および"],["バシャン"],["の"],["王","おう"],["オグ"],["の"],["地","ち"],["なる"],["ギレアデ"],["の"],["地","ち"],["に"],["は"],["ウリ"],["の"],["子","こ"],["ゲベル"],["。"],["彼","かれ"],["は"],["その"],["地","ち"],["の"],["ただ"],["ひとり"],["の"],["代官","だいかん"],["で"],["あった"],["。"]]},{"verse":20,"text":"ユダとイスラエルの人々,ひとびとは多,おおくて、海,うみべの砂,すなのようであったが、彼,かれらは飲,のみ食,くいして楽,たのしんだ。","tok":[["ユダ"],["と"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["多くて","おおくて"],["、"],["海べ","うみべ"],["の"],["砂","すな"],["の"],["よう"],["で"],["あった"],["が"],["、"],["彼","かれ"],["ら"],["は"],["飲み食い","のみくい"],["して"],["楽しんだ","たのしんだ"],["。"]]}]
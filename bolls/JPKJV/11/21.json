[{"verse":1,"text":"さてエズレルびとナボテはエズレルにぶどう畑,はたけをもっていたが、サマリヤの王,おうアハブの宮殿,きゅうでんのかたわらにあったので、","tok":[["さて"],["エズレル"],["びと"],["ナボテ"],["は"],["エズレル"],["に"],["ぶどう"],["畑","はたけ"],["を"],["もって"],["いた"],["が"],["、"],["サマリヤ"],["の"],["王","おう"],["アハブ"],["の"],["宮殿","きゅうでん"],["の"],["かたわら"],["に"],["あった"],["ので"],["、"]]},{"verse":2,"text":"アハブはナボテに言,いった、「あなたのぶどう畑,はたけはわたしの家,いえの近,ちかくにあるので、わたしに譲,ゆずって青物,あおもの畑,はたけにさせてください。その代,かわり、わたしはそれよりも良,よいぶどう畑,はたけをあなたにあげましょう。もしお望,のぞみならば、その価,あたいを金,きんでさしあげましょう」。","tok":[["アハブ"],["は"],["ナボテ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["の"],["ぶどう"],["畑","はたけ"],["は"],["わたし"],["の"],["家","いえ"],["の"],["近く","ちかく"],["に"],["ある"],["ので"],["、"],["わたし"],["に"],["譲って","ゆずって"],["青物","あおもの"],["畑","はたけ"],["に"],["させて"],["ください"],["。"],["その"],["代わり","かわり"],["、"],["わたし"],["は"],["それ"],["より"],["も"],["良い","よい"],["ぶどう"],["畑","はたけ"],["を"],["あなた"],["に"],["あげましょう"],["。"],["もし"],["お望みならば","おのぞみならば"],["、"],["その"],["価","あたい"],["を"],["金","きん"],["で"],["さしあげましょう"],["」"],["。"]]},{"verse":3,"text":"ナボテはアハブに言,いった、「わたしは先祖,せんぞの嗣,し業,ぎょうをあなたに譲,ゆずることを断,だんじていたしません」。","tok":[["ナボテ"],["は"],["アハブ"],["に"],["言った","いった"],["、"],["「"],["わたし"],["は"],["先祖","せんぞ"],["の"],["嗣業","しぎょう"],["を"],["あなた"],["に"],["譲","ゆずる"],["こと"],["を"],["断じて","だんじて"],["いたしません"],["」"],["。"]]},{"verse":4,"text":"アハブはエズレルびとナボテが言,いった言葉,ことばを聞,きいて、悲,かなしみ、かつ怒,いかって家,いえにはいった。ナボテが「わたしは先祖,せんぞの嗣,し業,ぎょうをあなたに譲,ゆずりません」と言,いったからである。アハブは床,とこに伏,ふし、顔,かおをそむけて食事,しょくじをしなかった。","tok":[["アハブ"],["は"],["エズレル"],["びと"],["ナボテ"],["が"],["言った","いった"],["言葉","ことば"],["を"],["聞いて","きいて"],["、"],["悲しみ","かなしみ"],["、"],["かつ"],["怒","い"],["か"],["って"],["家","いえ"],["に"],["はいった"],["。"],["ナボテ"],["が"],["「"],["わたし"],["は"],["先祖","せんぞ"],["の"],["嗣業","しぎょう"],["を"],["あなた"],["に"],["譲りません","ゆずりません"],["」"],["と"],["言った","いった"],["から"],["で"],["ある"],["。"],["アハブ"],["は"],["床","とこ"],["に"],["伏し","ふし"],["、"],["顔","かお"],["を"],["そむけて"],["食事","しょくじ"],["を"],["しなかった"],["。"]]},{"verse":5,"text":"妻,つまイゼベルは彼,かれの所,ところにきて、言,いった、「あなたは何,なにをそんなに悲,かなしんで、食事,しょくじをなさらないのですか」。","tok":[["妻","つま"],["イゼベル"],["は"],["彼","かれ"],["の"],["所","ところ"],["に"],["きて"],["、"],["言った","いった"],["、"],["「"],["あなた"],["は"],["何に","なに"],["を"],["そんな"],["に"],["悲しんで","かなしんで"],["、"],["食事","しょくじ"],["を"],["なさらない"],["の"],["です"],["か"],["」"],["。"]]},{"verse":6,"text":"彼,かれは彼女,かのじょに言,いった、「わたしはエズレルびとナボテに『あなたのぶどう畑,はたけを金,かねで譲,ゆずってください。もし望,のぞむならば、その代,かわりに、ほかのぶどう畑,はたけをあげよう』と言,いったが、彼,かれは答,こたえて『わたしはぶどう畑,はたけを譲,ゆずりません』と言,いったからだ」。","tok":[["彼","かれ"],["は"],["彼女","かのじょ"],["に"],["言った","いった"],["、"],["「"],["わたし"],["は"],["エズレル"],["びと"],["ナボテ"],["に"],["『"],["あなた"],["の"],["ぶどう"],["畑","はたけ"],["を"],["金","かね"],["で"],["譲って","ゆずって"],["ください"],["。"],["もし"],["望むならば","のぞむならば"],["、"],["その"],["代わり","かわり"],["に"],["、"],["ほか"],["の"],["ぶどう"],["畑","はたけ"],["を"],["あげよう"],["』"],["と"],["言った","いった"],["が"],["、"],["彼","かれ"],["は"],["答","こたえ"],["て"],["『"],["わたし"],["は"],["ぶどう"],["畑","はたけ"],["を"],["譲りません","ゆずりません"],["』"],["と"],["言った","いった"],["から"],["だ"],["」"],["。"]]},{"verse":7,"text":"妻,つまイゼベルは彼,かれに言,いった、「あなたが今,いまイスラエルを治,おさめているのですか。起,おきて食事,しょくじをし、元気,げんきを出,だしてください。わたしがエズレルびとナボテのぶどう畑,はたけをあなたにあげます」。","tok":[["妻","つま"],["イゼベル"],["は"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["が"],["今","いま"],["イスラエル"],["を"],["治めて","おさめて"],["いる"],["の"],["です"],["か"],["。"],["起きて","おきて"],["食事","しょくじ"],["を"],["し"],["、"],["元気","げんき"],["を"],["出して","だして"],["ください"],["。"],["わたし"],["が"],["エズレル"],["びと"],["ナボテ"],["の"],["ぶどう"],["畑","はたけ"],["を"],["あなた"],["に"],["あげます"],["」"],["。"]]},{"verse":8,"text":"彼女,かのじょはアハブの名,なで手紙,てがみを書,かき、彼,かれの印,しるしをおして、ナボテと同,おなじように、その町,まちに住,すんでいる長老,ちょうろうたちと身分,みぶんの尊,たっとい人々,ひとびとに、その手紙,てがみを送,おくった。","tok":[["彼女","かのじょ"],["は"],["アハブ"],["の"],["名","な"],["で"],["手紙","てがみ"],["を"],["書き","かき"],["、"],["彼","かれ"],["の"],["印","しるし"],["を"],["おして"],["、"],["ナボテ"],["と"],["同じ","おなじ"],["よう"],["に"],["、"],["その"],["町","まち"],["に"],["住んで","すんで"],["いる"],["長老","ちょうろう"],["たち"],["と"],["身分","みぶん"],["の"],["尊","た"],["っと"],["い"],["人々","ひとびと"],["に"],["、"],["その"],["手紙","てがみ"],["を"],["送った","おくった"],["。"]]},{"verse":9,"text":"彼女,かのじょはその手紙,てがみに書,かきしるした、「断食,だんじきを布告,ふこくして、ナボテを民,たみのうちの高,たかい所,ところにすわらせ、","tok":[["彼女","かのじょ"],["は"],["その"],["手紙","てがみ"],["に"],["書きしるした","かきしるした"],["、"],["「"],["断食","だんじき"],["を"],["布告","ふこく"],["して"],["、"],["ナボテ"],["を"],["民","たみ"],["の"],["うち"],["の"],["高い","たかい"],["所","ところ"],["に"],["すわらせ"],["、"]]},{"verse":10,"text":"またふたりのよこしまな者,ものを彼,かれの前,まえにすわらせ、そして彼,かれを訴,うったえて、『あなたは神,かみと王,おうとをのろった』と言,いわせなさい。こうして彼,かれを引,ひき出,だし、石,いしで撃,うち殺,ころしなさい」。","tok":[["また"],["ふたり"],["の"],["よこしま"],["な"],["者","もの"],["を"],["彼","かれ"],["の"],["前","まえ"],["に"],["すわらせ"],["、"],["そして"],["彼","かれ"],["を"],["訴て","うったえて"],["、"],["『"],["あなた"],["は"],["神","かみ"],["と"],["王","おう"],["と"],["を"],["のろった"],["』"],["と"],["言わせ","いわせ"],["なさい"],["。"],["こう"],["して"],["彼","かれ"],["を"],["引出し","ひきだし"],["、"],["石","いし"],["で"],["撃ち","うち"],["殺ろし","ころし"],["なさい"],["」"],["。"]]},{"verse":11,"text":"その町,まちの人々,ひとびと、すなわち、その町,まちに住,すんでいる長老,ちょうろうたちおよび身分,みぶんの尊,たっとい人々,ひとびとは、イゼベルが言,いいつかわしたようにした。彼女,かのじょが彼,かれらに送,おくった手紙,てがみに書,かきしるされていたように、","tok":[["その"],["町","まち"],["の"],["人々","ひとびと"],["、"],["すなわち"],["、"],["その"],["町","まち"],["に"],["住んで","すんで"],["いる"],["長老","ちょうろう"],["たち"],["および"],["身分","みぶん"],["の"],["尊","た"],["っと"],["い"],["人々","ひとびと"],["は"],["、"],["イゼベル"],["が"],["言い","いい"],["つかわした"],["よう"],["に"],["した"],["。"],["彼女","かのじょ"],["が"],["彼","かれ"],["ら"],["に"],["送った","おくった"],["手紙","てがみ"],["に"],["書きしるされて","かきしるされて"],["いた"],["よう"],["に"],["、"]]},{"verse":12,"text":"彼,かれらは断食,だんじきを布告,ふこくして、ナボテを民,たみのうちの高,たかい所,ところにすわらせた。","tok":[["彼","かれ"],["ら"],["は"],["断食","だんじき"],["を"],["布告","ふこく"],["して"],["、"],["ナボテ"],["を"],["民","たみ"],["の"],["うち"],["の"],["高い","たかい"],["所","ところ"],["に"],["すわらせた"],["。"]]},{"verse":13,"text":"そしてふたりのよこしまな者,ものがはいってきて、その前,まえにすわり、そのよこしまな者,ものたちが民,たみの前,まえでナボテを訴,うったえて、「ナボテは神,かみと王,おうとをのろった」と言,いった。そこで人々,ひとびとは彼,かれを町,まちの外,そとに引,ひき出,だし、石,いしで撃,うち殺,ころした。","tok":[["そして"],["ふたり"],["の"],["よこしま"],["な"],["者","もの"],["が"],["はいって"],["きて"],["、"],["その"],["前","まえ"],["に"],["すわり"],["、"],["その"],["よこしま"],["な"],["者","もの"],["たち"],["が"],["民","たみ"],["の"],["前","まえ"],["で"],["ナボテ"],["を"],["訴て","うったえて"],["、"],["「"],["ナボテ"],["は"],["神","かみ"],["と"],["王","おう"],["と"],["を"],["のろった"],["」"],["と"],["言った","いった"],["。"],["そこ"],["で"],["人々","ひとびと"],["は"],["彼","かれ"],["を"],["町","まち"],["の"],["外","そと"],["に"],["引出し","ひきだし"],["、"],["石","いし"],["で"],["撃ち殺した","うちころした"],["。"]]},{"verse":14,"text":"そして人々,ひとびとはイゼベルに「ナボテは石,いしで撃,うち殺,ころされた」と言,いい送,おくった。","tok":[["そして"],["人々","ひとびと"],["は"],["イゼベル"],["に"],["「"],["ナボテ"],["は"],["石","いし"],["で"],["撃ち","うち"],["殺ろ","ころ"],["された"],["」"],["と"],["言い送った","いいおくった"],["。"]]},{"verse":15,"text":"イゼベルはナボテが石,いしで撃,うち殺,ころされたのを聞,きくとすぐ、アハブに言,いった、「立,たって、あのエズレルびとナボテが、あなたに金,かねで譲,ゆずることを拒,こばんだぶどう畑,はたけを取,とりなさい。ナボテは生,いきていません。死,しんだのです」。","tok":[["イゼベル"],["は"],["ナボテ"],["が"],["石","いし"],["で"],["撃ち","うち"],["殺ろ","ころ"],["された"],["の"],["を"],["聞く","きく"],["と"],["すぐ"],["、"],["アハブ"],["に"],["言った","いった"],["、"],["「"],["立って","たって"],["、"],["あの"],["エズレル"],["びと"],["ナボテ"],["が"],["、"],["あなた"],["に"],["金","かね"],["で"],["譲","ゆずる"],["こと"],["を"],["拒んだ","こばんだ"],["ぶどう"],["畑","はたけ"],["を"],["取","とり"],["なさい"],["。"],["ナボテ"],["は"],["生きて","いきて"],["いません"],["。"],["死","しんだ"],["の"],["です"],["」"],["。"]]},{"verse":16,"text":"アハブはナボテの死,しんだのを聞,きくとすぐ、立,たって、エズレルびとナボテのぶどう畑,はたけを取,とるために、そこへ下,くだっていった。","tok":[["アハブ"],["は"],["ナボテ"],["の"],["死んだ","しんだ"],["の"],["を"],["聞く","きく"],["と"],["すぐ"],["、"],["立って","たって"],["、"],["エズレル"],["びと"],["ナボテ"],["の"],["ぶどう"],["畑","はたけ"],["を"],["取る","とる"],["ため"],["に"],["、"],["そこ"],["へ"],["下って","くだって"],["いった"],["。"]]},{"verse":17,"text":"そのとき、主,しゅの言葉,ことばがテシベびとエリヤに臨,のぞんだ、","tok":[["その"],["とき"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["が"],["テシベ"],["びと"],["エリヤ"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":18,"text":"「立,たって、下,くだって行,いき、サマリヤにいるイスラエルの王,おうアハブに会,あいなさい。彼,かれはナボテのぶどう畑,はたけを取,とろうとしてそこへ下,くだっている。","tok":[["「"],["立って","たって"],["、"],["下って","くだって"],["行き","いき"],["、"],["サマリヤ"],["に"],["いる"],["イスラエル"],["の"],["王","おう"],["アハブ"],["に"],["会い","あい"],["なさい"],["。"],["彼","かれ"],["は"],["ナボテ"],["の"],["ぶどう"],["畑","はたけ"],["を"],["取ろう","とろう"],["として"],["そこ"],["へ"],["下って","くだって"],["いる"],["。"]]},{"verse":19,"text":"あなたは彼,かれに言,いわなければならない、『主,しゅはこう仰,おおせられる、あなたは殺,ころしたのか、また取,とったのか』と。また彼,かれに言,いいなさい、『主,しゅはこう仰,おおせられる、犬,いぬがナボテの血,ちをなめた場所,ばしょで、犬,いぬがあなたの血,ちをなめるであろう』」。","tok":[["あなた"],["は"],["彼","かれ"],["に"],["言わなければ","いわなければ"],["ならない"],["、"],["『"],["主","しゅ"],["は"],["こう"],["仰せられる","おおせられる"],["、"],["あなた"],["は"],["殺ろした","ころした"],["の"],["か"],["、"],["また"],["取った","とった"],["の"],["か"],["』"],["と"],["。"],["また"],["彼","かれ"],["に"],["言い","いい"],["なさい"],["、"],["『"],["主","しゅ"],["は"],["こう"],["仰せられる","おおせられる"],["、"],["犬","いぬ"],["が"],["ナボテ"],["の"],["血","ち"],["を"],["なめた"],["場所","ばしょ"],["で"],["、"],["犬","いぬ"],["が"],["あなた"],["の"],["血","ち"],["を"],["なめるで"],["あろう"],["』"],["」"],["。"]]},{"verse":20,"text":"アハブはエリヤに言,いった、「わが敵,てきよ、ついに、わたしを見,みつけたのか」。彼,かれは言,いった、「見,みつけました。あなたが主,しゅの目,めの前,まえに悪,あくを行,おこなうことに身,みをゆだねたゆえ、","tok":[["アハブ"],["は"],["エリヤ"],["に"],["言った","いった"],["、"],["「"],["わが"],["敵","てき"],["よ"],["、"],["ついに"],["、"],["わたし"],["を"],["見つけた","みつけた"],["の"],["か"],["」"],["。"],["彼","かれ"],["は"],["言った","いった"],["、"],["「"],["見つけました","みつけました"],["。"],["あなた"],["が"],["主","しゅ"],["の"],["目","め"],["の"],["前","まえ"],["に"],["悪","あく"],["を"],["行なう","おこなう"],["こと"],["に"],["身","み"],["を"],["ゆだねた"],["ゆえ"],["、"]]},{"verse":21,"text":"わたしはあなたに災,わざわいを下,くだし、あなたを全,まったく滅,ほろぼし、アハブに属,ぞくする男,おとこは、イスラエルにいてつながれた者,ものも、自由,じゆうな者,ものもことごとく断,たち、","tok":[["わたし"],["は"],["あなた"],["に"],["災","わざわい"],["を"],["下し","くだし"],["、"],["あなた"],["を"],["全く","まったく"],["滅ぼし","ほろぼし"],["、"],["アハブ"],["に"],["属する","ぞくする"],["男","おとこ"],["は"],["、"],["イスラエル"],["に"],["いて"],["つながれた"],["者","もの"],["も"],["、"],["自由","じゆう"],["な"],["者","もの"],["も"],["ことごとく"],["断ち","たち"],["、"]]},{"verse":22,"text":"またあなたの家,いえをネバテの子,こヤラベアムの家,いえのようにし、アヒヤの子,こバアシャの家,いえのようにするでしょう。これはあなたがわたしを怒,いからせた怒,いかりのゆえ、またイスラエルに罪,つみを犯,おかさせたゆえです。","tok":[["また"],["あなた"],["の"],["家","いえ"],["を"],["ネバテ"],["の"],["子","こ"],["ヤラベアム"],["の"],["家","いえ"],["の"],["よう"],["に"],["し"],["、"],["アヒヤ"],["の"],["子","こ"],["バアシャ"],["の"],["家","いえ"],["の"],["よう"],["に"],["するでしょう"],["。"],["これ"],["は"],["あなた"],["が"],["わたし"],["を"],["怒らせた","いからせた"],["怒り","いかり"],["の"],["ゆえ"],["、"],["また"],["イスラエル"],["に"],["罪","つみ"],["を"],["犯させた","おかさせた"],["ゆえ"],["です"],["。"]]},{"verse":23,"text":"イゼベルについて、主,しゅはまた言,いわれました、『犬,いぬがエズレルの地域,ちいきでイゼベルを食,くうであろう』と。","tok":[["イゼベル"],["について"],["、"],["主","しゅ"],["は"],["また"],["言われました","いわれました"],["、"],["『"],["犬","いぬ"],["が"],["エズレル"],["の"],["地域","ちいき"],["で"],["イゼベル"],["を"],["食うで","くうで"],["あろう"],["』"],["と"],["。"]]},{"verse":24,"text":"アハブに属,ぞくする者,ものは、町,まちで死,しぬ者,ものを犬,いぬが食,くい、野,ので死,しぬ者,ものを空,そらの鳥,とりが食,くうでしょう」。","tok":[["アハブ"],["に"],["属する","ぞくする"],["者","もの"],["は"],["、"],["町","まち"],["で"],["死ぬ","しぬ"],["者","もの"],["を"],["犬","いぬ"],["が"],["食い","くい"],["、"],["野","の"],["で"],["死ぬ","しぬ"],["者","もの"],["を"],["空","そら"],["の"],["鳥","とり"],["が"],["食うでしょう","くうでしょう"],["」"],["。"]]},{"verse":25,"text":"アハブのように主,しゅの目,めの前,まえに悪,あくを行,おこなうことに身,みをゆだねた者,ものはなかった。その妻,つまイゼベルが彼,かれをそそのかしたのである。","tok":[["アハブ"],["の"],["よう"],["に"],["主","しゅ"],["の"],["目","め"],["の"],["前","まえ"],["に"],["悪","あく"],["を"],["行なう","おこなう"],["こと"],["に"],["身","み"],["を"],["ゆだねた"],["者","もの"],["は"],["なかった"],["。"],["その"],["妻","つま"],["イゼベル"],["が"],["彼","かれ"],["を"],["そそのかした"],["ので"],["ある"],["。"]]},{"verse":26,"text":"彼,かれは主,しゅがイスラエルの人々,ひとびとの前,まえから追,おい払,はらわれたアモリびとがしたように偶像,ぐうぞうに従,したがって、はなはだ憎,にくむべき事,ことを行,おこなった。","tok":[["彼","かれ"],["は"],["主","しゅ"],["が"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["前","まえ"],["から"],["追い払われた","おいはらわれた"],["アモリ"],["びと"],["が"],["した"],["よう"],["に"],["偶像","ぐうぞう"],["に"],["従って","したがって"],["、"],["はなはだ"],["憎むべき","にくむべき"],["事","こと"],["を"],["行なった","おこなった"],["。"]]},{"verse":27,"text":"アハブはこれらの言葉,ことばを聞,きいた時,とき、衣,ころもを裂,さき、荒布,あらぬのを身,みにまとい、食,しょくを断,たち、荒布,あらぬのに伏,ふし、打,うちしおれて歩,あるいた。","tok":[["アハブ"],["は"],["これ"],["ら"],["の"],["言葉","ことば"],["を"],["聞いた","きいた"],["時","とき"],["、"],["衣","ころも"],["を"],["裂き","さき"],["、"],["荒布","あらぬ"],["の"],["を"],["身","み"],["に"],["まとい"],["、"],["食","しょく"],["を"],["断ち","たち"],["、"],["荒布","あらぬ"],["のに"],["伏し","ふし"],["、"],["打ちしおれて","うちしおれて"],["歩いた","あるいた"],["。"]]},{"verse":28,"text":"この時,とき、主,しゅの言葉,ことばがテシベびとエリヤに臨,のぞんだ、","tok":[["この"],["時","とき"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["が"],["テシベ"],["びと"],["エリヤ"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":29,"text":"「アハブがわたしの前,まえにへりくだっているのを見,みたか。彼,かれがわたしの前,まえにへりくだっているゆえ、わたしは彼,あの世,よには災,わざわいを下,くださない。その子,この世,よに災,わざわいをその家,いえに下,くだすであろう」。","tok":[["「"],["アハブ"],["が"],["わたし"],["の"],["前","まえ"],["に"],["へりくだって"],["いる"],["の"],["を"],["見た","みた"],["か"],["。"],["彼","かれ"],["が"],["わたし"],["の"],["前","まえ"],["に"],["へりくだって"],["いる"],["ゆえ"],["、"],["わたし"],["は"],["彼の世","あのよ"],["に"],["は"],["災","わざわい"],["を"],["下さない","くださない"],["。"],["その"],["子","こ"],["の"],["世","よ"],["に"],["災","わざわい"],["を"],["その"],["家","いえ"],["に"],["下すで","くだすで"],["あろう"],["」"],["。"]]}]
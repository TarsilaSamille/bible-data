[{"verse":1,"text":"兄弟,きょうだいたちよ。その時期,じきと場合,ばあいとについては、書,かきおくる必要,ひつようはない。","tok":[["兄弟","きょうだい"],["たち"],["よ"],["。"],["その"],["時期","じき"],["と"],["場合","ばあい"],["と"],["について"],["は"],["、"],["書きおくる","かきおくる"],["必要","ひつよう"],["は"],["ない"],["。"]]},{"verse":2,"text":"あなたがた自身,じしんがよく知,しっているとおり、主,しゅの日,ひは盗人,ぬすびとが夜,よるくるように来,くる。","tok":[["あなた"],["がた"],["自身","じしん"],["が"],["よく"],["知って","しって"],["いる"],["とおり"],["、"],["主","しゅ"],["の"],["日","ひ"],["は"],["盗人","ぬすびと"],["が"],["夜","よる"],["くる"],["よう"],["に"],["来る","くる"],["。"]]},{"verse":3,"text":"人々,ひとびとが平和,へいわだ無事,ぶじだと言,いっているその矢先,やさきに、ちょうど妊婦,にんぷに産,うみの苦,くるしみが臨,のぞむように、突如,とつじょとして滅,ほろびが彼,かれらをおそって来,くる。そして、それからのがれることは決,けっしてできない。","tok":[["人々","ひとびと"],["が"],["平和","へいわ"],["だ"],["無事","ぶじ"],["だ"],["と"],["言って","いって"],["いる"],["その"],["矢先","やさき"],["に"],["、"],["ちょうど"],["妊婦","にんぷ"],["に"],["産み","うみ"],["の"],["苦しみ","くるしみ"],["が"],["臨む","のぞむ"],["よう"],["に"],["、"],["突如","とつじょ"],["として"],["滅び","ほろび"],["が"],["彼","かれ"],["ら"],["を"],["おそって"],["来る","くる"],["。"],["そして"],["、"],["それ"],["から"],["のがれる"],["こと"],["は"],["決っして","けっして"],["できない"],["。"]]},{"verse":4,"text":"しかし兄弟,きょうだいたちよ。あなたがたは暗,くらやみの中,なかにいないのだから、その日,ひが、盗人,ぬすびとのようにあなたがたを不,ふ意,いに襲,おそうことはないであろう。","tok":[["しかし"],["兄弟","きょうだい"],["たち"],["よ"],["。"],["あなた"],["がた"],["は"],["暗やみ","くらやみ"],["の"],["中","なか"],["に"],["いない"],["の"],["だ"],["から"],["、"],["その"],["日","ひ"],["が"],["、"],["盗人","ぬすびと"],["の"],["よう"],["に"],["あなた"],["がた"],["を"],["不意","ふい"],["に"],["襲う","おそう"],["こと"],["は"],["ないで"],["あろう"],["。"]]},{"verse":5,"text":"あなたがたはみな光,ひかりの子,こであり、昼,ひるの子,こなのである。わたしたちは、夜,よるの者,ものでもやみの者,ものでもない。","tok":[["あなた"],["がた"],["は"],["みな"],["光","ひかり"],["の"],["子","こ"],["で"],["あり"],["、"],["昼","ひる"],["の"],["子","こ"],["な"],["ので"],["ある"],["。"],["わたしたち"],["は"],["、"],["夜","よる"],["の"],["者","もの"],["で"],["も"],["やみ"],["の"],["者","もの"],["で"],["も"],["ない"],["。"]]},{"verse":6,"text":"だから、ほかの人々,ひとびとのように眠,ねむっていないで、目,めをさまして慎,つつしんでいよう。","tok":[["だ"],["から"],["、"],["ほか"],["の"],["人々","ひとびと"],["の"],["よう"],["に"],["眠って","ねむって"],["いないで"],["、"],["目","め"],["を"],["さまして"],["慎しんで","つつしんで"],["いよう"],["。"]]},{"verse":7,"text":"眠,ねむる者,ものは夜,よる眠,ねむり、酔,よう者,ものは夜,よる酔,ようのである。","tok":[["眠る","ねむる"],["者","もの"],["は"],["夜","よる"],["眠","ねむり"],["、"],["酔う","よう"],["者","もの"],["は"],["夜","よる"],["酔う","よう"],["ので"],["ある"],["。"]]},{"verse":8,"text":"しかし、わたしたちは昼,ひるの者,ものなのだから、信仰,しんこうと愛,あいとの胸当,むねあてを身,みにつけ、救,すくいの望,のぞみのかぶとをかぶって、慎,つつしんでいよう。","tok":[["しかし"],["、"],["わたしたち"],["は"],["昼","ひる"],["の"],["者","もの"],["な"],["の"],["だ"],["から"],["、"],["信仰","しんこう"],["と"],["愛","あい"],["と"],["の"],["胸当","むねあて"],["を"],["身","み"],["に"],["つけ"],["、"],["救い","すくい"],["の"],["望み","のぞみ"],["の"],["かぶと"],["を"],["かぶって"],["、"],["慎しんで","つつしんで"],["いよう"],["。"]]},{"verse":9,"text":"神,かみは、わたしたちを怒,いかりにあわせるように定,さだめられたのではなく、わたしたちの主,しゅイエス・キリストによって救,すくいを得,えるように定,さだめられたのである。","tok":[["神","かみ"],["は"],["、"],["わたしたち"],["を"],["怒り","いかり"],["に"],["あわせる"],["よう"],["に"],["定められた","さだめられた"],["ので"],["は"],["なく"],["、"],["わたしたち"],["の"],["主","しゅ"],["イエス"],["・"],["キリスト"],["によって"],["救い","すくい"],["を"],["得る","える"],["よう"],["に"],["定められた","さだめられた"],["ので"],["ある"],["。"]]},{"verse":10,"text":"キリストがわたしたちのために死,しなれたのは、さめていても眠,ねむっていても、わたしたちが主,しゅと共,ともに生,いきるためである。","tok":[["キリスト"],["が"],["わたしたち"],["の"],["ため"],["に"],["死なれた","しなれた"],["の"],["は"],["、"],["さめて"],["いて"],["も"],["眠って","ねむって"],["いて"],["も"],["、"],["わたしたち"],["が"],["主","しゅ"],["と"],["共","とも"],["に"],["生きる","いきる"],["ため"],["で"],["ある"],["。"]]},{"verse":11,"text":"だから、あなたがたは、今,いましているように、互,たがいに慰,なぐさめ合,あい、相互,そうごの徳,とくを高,たかめなさい。","tok":[["だ"],["から"],["、"],["あなた"],["がた"],["は"],["、"],["今","いま"],["して"],["いる"],["よう"],["に"],["、"],["互","たがい"],["に"],["慰さめ","なぐさめ"],["合い","あい"],["、"],["相互","そうご"],["の"],["徳","とく"],["を"],["高め","たかめ"],["なさい"],["。"]]},{"verse":12,"text":"兄弟,きょうだいたちよ。わたしたちはお願,ねがいする。どうか、あなたがたの間,あいだで労,ろうし、主,しゅにあってあなたがたを指導,しどうし、かつ訓戒,くんかいしている人々,ひとびとを重,おもんじ、","tok":[["兄弟","きょうだい"],["たち"],["よ"],["。"],["わたしたち"],["は"],["お願い","おねがい"],["する"],["。"],["どう"],["か"],["、"],["あなた"],["がた"],["の"],["間","あいだ"],["で"],["労し","ろうし"],["、"],["主に","しゅに"],["あって"],["あなた"],["がた"],["を"],["指導","しどう"],["し"],["、"],["かつ"],["訓戒","くんかい"],["して"],["いる"],["人々","ひとびと"],["を"],["重じ","おもんじ"],["、"]]},{"verse":13,"text":"彼,かれらの働,はたらきを思,おもって、特,とくに愛,あいし敬,うやまいなさい。互,たがいに平和,へいわに過,すごしなさい。","tok":[["彼","かれ"],["ら"],["の"],["働らき","はたらき"],["を"],["思って","おもって"],["、"],["特に","とくに"],["愛し","あいし"],["敬い","うやまい"],["なさい"],["。"],["互","たがい"],["に"],["平和","へいわ"],["に"],["過ごし","すごし"],["なさい"],["。"]]},{"verse":14,"text":"兄弟,きょうだいたちよ。あなたがたにお勧,すすめする。怠惰,たいだな者,ものを戒,いましめ、小心,しょうしんな者,ものを励,はげまし、弱,よわい者,ものを助,たすけ、すべての人,ひとに対,たいして寛容,かんようでありなさい。","tok":[["兄弟","きょうだい"],["たち"],["よ"],["。"],["あなた"],["がた"],["に"],["お勧め","おすすめ"],["する"],["。"],["怠惰","たいだ"],["な"],["者","もの"],["を"],["戒しめ","いましめ"],["、"],["小心","しょうしん"],["な"],["者","もの"],["を"],["励まし","はげまし"],["、"],["弱い","よわい"],["者","もの"],["を"],["助け","たすけ"],["、"],["すべて"],["の"],["人","ひと"],["に対して","にたいして"],["寛容","かんよう"],["で"],["あり"],["なさい"],["。"]]},{"verse":15,"text":"だれも悪,あくをもって悪,あくに報,むくいないように心,こころがけ、お互,たがいに、またみんなに対,たいして、いつも善,ぜんを追,おい求,もとめなさい。","tok":[["だれ"],["も"],["悪","あく"],["を"],["もって"],["悪","あく"],["に"],["報いない","むくいない"],["よう"],["に"],["心がけ","こころがけ"],["、"],["お互","おたがい"],["に"],["、"],["また"],["みんな"],["に対して","にたいして"],["、"],["いつも"],["善","ぜん"],["を"],["追い求め","おいもとめ"],["なさい"],["。"]]},{"verse":16,"text":"いつも喜,よろこんでいなさい。","tok":[["いつも"],["喜こんで","よろこんで"],["い"],["なさい"],["。"]]},{"verse":17,"text":"絶,たえず祈,いのりなさい。","tok":[["絶えず","たえず"],["祈","いのり"],["なさい"],["。"]]},{"verse":18,"text":"すべての事,ことについて、感謝,かんしゃしなさい。これが、キリスト・イエスにあって、神,かみがあなたがたに求,もとめておられることである。","tok":[["すべて"],["の"],["事","こと"],["について"],["、"],["感謝","かんしゃ"],["し"],["なさい"],["。"],["これ"],["が"],["、"],["キリスト"],["・"],["イエス"],["に"],["あって"],["、"],["神","かみ"],["が"],["あなた"],["がた"],["に"],["求めて","もとめて"],["おられる"],["こと"],["で"],["ある"],["。"]]},{"verse":19,"text":"御霊,みたまを消,けしてはいけない。","tok":[["御霊","みたま"],["を"],["消して","けして"],["は"],["いけない"],["。"]]},{"verse":20,"text":"預言,よげんを軽,かろんじてはならない。","tok":[["預言","よげん"],["を"],["軽","かろんじて"],["は"],["ならない"],["。"]]},{"verse":21,"text":"すべてのものを識別,しきべつして、良,よいものを守,まもり、","tok":[["すべて"],["の"],["もの"],["を"],["識別","しきべつ"],["して"],["、"],["良い","よい"],["もの"],["を"],["守り","まもり"],["、"]]},{"verse":22,"text":"あらゆる種類,しゅるいの悪,あくから遠,とおざかりなさい。","tok":[["あらゆる"],["種類","しゅるい"],["の"],["悪","あく"],["から"],["遠ざかり","とおざかり"],["なさい"],["。"]]},{"verse":23,"text":"どうか、平和,へいわの神,かみご自身,じしんが、あなたがたを全,まったくきよめて下,くださるように。また、あなたがたの霊,れいと心,こころとからだとを完全,かんぜんに守,まもって、わたしたちの主,しゅイエス・キリストの来臨,らいりんのときに、責,せめられるところのない者,ものにして下,くださるように。","tok":[["どう"],["か"],["、"],["平和","へいわ"],["の"],["神","かみ"],["ご自身","ごじしん"],["が"],["、"],["あなた"],["がた"],["を"],["全く","まったく"],["きよめて"],["下さる","くださる"],["よう"],["に"],["。"],["また"],["、"],["あなた"],["がた"],["の"],["霊","れい"],["と"],["心","こころ"],["と"],["からだ"],["と"],["を"],["完全","かんぜん"],["に"],["守って","まもって"],["、"],["わたしたち"],["の"],["主","しゅ"],["イエス"],["・"],["キリスト"],["の"],["来臨","らいりん"],["の"],["とき"],["に"],["、"],["責","せめ"],["られる"],["ところ"],["の"],["ない"],["者","もの"],["に"],["して"],["下さる","くださる"],["よう"],["に"],["。"]]},{"verse":24,"text":"あなたがたを召,めされたかたは真実,しんじつであられるから、このことをして下,くださるであろう。","tok":[["あなた"],["がた"],["を"],["召された","めされた"],["かた"],["は"],["真実","しんじつ"],["で"],["あられる"],["から"],["、"],["この"],["こと"],["を"],["して"],["下さるで","くださるで"],["あろう"],["。"]]},{"verse":25,"text":"兄弟,きょうだいたちよ。わたしたちのためにも、祈,いのってほしい。","tok":[["兄弟","きょうだい"],["たち"],["よ"],["。"],["わたしたち"],["の"],["ため"],["に"],["も"],["、"],["祈って","いのって"],["ほしい"],["。"]]},{"verse":26,"text":"すべての兄弟,きょうだいたちに、きよい接吻,せっぷんをもって、よろしく伝,つたえてほしい。","tok":[["すべて"],["の"],["兄弟","きょうだい"],["たち"],["に"],["、"],["きよい"],["接吻","せっぷん"],["を"],["もって"],["、"],["よろしく"],["伝えて","つたえて"],["ほしい"],["。"]]},{"verse":27,"text":"わたしは主,しゅによって命,めいじる。この手紙,てがみを、みんなの兄弟,きょうだいに読,よみ聞,きかせなさい。","tok":[["わたし"],["は"],["主に","しゅに"],["よって"],["命じる","めいじる"],["。"],["この"],["手紙","てがみ"],["を"],["、"],["みんな"],["の"],["兄弟","きょうだい"],["に"],["読","よみ"],["聞かせ","きかせ"],["なさい"],["。"]]},{"verse":28,"text":"わたしたちの主,しゅイエス・キリストの恵,めぐみが、あなたがたと共,ともにあるように。","tok":[["わたしたち"],["の"],["主","しゅ"],["イエス"],["・"],["キリスト"],["の"],["恵","めぐみ"],["が"],["、"],["あなた"],["がた"],["と"],["共","とも"],["に"],["ある"],["よう"],["に"],["。"]]}]
[{"verse":1,"text":"そこで、わたしたちはこれ以上,いじょう耐,たえられなくなって、わたしたちだけがアテネに留まることに定,さだめ、","tok":[["そこ"],["で"],["、"],["わたしたち"],["は"],["これ"],["以上","いじょう"],["耐えられなく","たえられなく"],["なって"],["、"],["わたしたち"],["だけ"],["が"],["アテネ"],["に"],["留まる","とまる"],["こと"],["に"],["定め","さだめ"],["、"]]},{"verse":2,"text":"わたしたちの兄弟,きょうだいで、キリストの福音,ふくいんにおける神,かみの同労者,どうろうしゃテモテをつかわした。それは、あなたがたの信仰,しんこうを強,つよめ、","tok":[["わたしたち"],["の"],["兄弟","きょうだい"],["で"],["、"],["キリスト"],["の"],["福音","ふくいん"],["に"],["おける"],["神","かみ"],["の"],["同労者","どうろうしゃ"],["テモテ"],["を"],["つかわした"],["。"],["それ"],["は"],["、"],["あなた"],["がた"],["の"],["信仰","しんこう"],["を"],["強め","つよめ"],["、"]]},{"verse":3,"text":"このような患難,かんなんの中,なかにあって、動揺,どうようする者,ものがひとりもないように励,はげますためであった。あなたがたの知,しっているとおり、わたしたちは患難,かんなんに会,あうように定,さだめられているのである。","tok":[["この"],["よう"],["な"],["患難","かんなん"],["の"],["中","なか"],["に"],["あって"],["、"],["動揺","どうよう"],["する"],["者","もの"],["が"],["ひとり"],["も"],["ない"],["よう"],["に"],["励ます","はげます"],["ため"],["で"],["あった"],["。"],["あなた"],["がた"],["の"],["知って","しって"],["いる"],["とおり"],["、"],["わたしたち"],["は"],["患難","かんなん"],["に"],["会う","あう"],["よう"],["に"],["定められて","さだめられて"],["いる"],["ので"],["ある"],["。"]]},{"verse":4,"text":"そして、あなたがたの所,ところにいたとき、わたしたちがやがて患難,かんなんに会,あうことをあらかじめ言,いっておいたが、あなたがたの知,しっているように、今,いまそのとおりになったのである。","tok":[["そして"],["、"],["あなた"],["がた"],["の"],["所","ところ"],["に"],["いた"],["とき"],["、"],["わたしたち"],["が"],["やがて"],["患難","かんなん"],["に"],["会う","あう"],["こと"],["を"],["あらかじめ"],["言って","いって"],["おいた"],["が"],["、"],["あなた"],["がた"],["の"],["知って","しって"],["いる"],["よう"],["に"],["、"],["今","いま"],["その"],["とおり"],["に"],["なった"],["ので"],["ある"],["。"]]},{"verse":5,"text":"そこで、わたしはこれ以上,いじょう耐,たえられなくなって、もしや「試,こころみる者,もの」があなたがたを試,こころみ、そのためにわたしたちの労苦,ろうくがむだになりはしないかと気,きづかって、あなたがたの信仰,しんこうを知,しるために、彼,かれをつかわしたのである。","tok":[["そこ"],["で"],["、"],["わたし"],["は"],["これ"],["以上","いじょう"],["耐えられなく","たえられなく"],["なって"],["、"],["もし"],["や"],["「"],["試みる","こころみる"],["者","もの"],["」"],["が"],["あなた"],["がた"],["を"],["試み","こころみ"],["、"],["その"],["ため"],["に"],["わたしたち"],["の"],["労苦","ろうく"],["が"],["むだ"],["に"],["なり"],["は"],["しない"],["か"],["と"],["気づかって","きづかって"],["、"],["あなた"],["がた"],["の"],["信仰","しんこう"],["を"],["知る","しる"],["ため"],["に"],["、"],["彼","かれ"],["を"],["つかわした"],["ので"],["ある"],["。"]]},{"verse":6,"text":"ところが今,いまテモテが、あなたがたの所,ところからわたしたちのもとに帰,かえってきて、あなたがたの信仰,しんこうと愛,あいとについて知,しらせ、また、あなたがたがいつもわたしたちのことを覚,おぼえ、わたしたちがあなたがたに会,あいたく思,おもっていると同,おなじように、わたしたちにしきりに会,あいたがっているという吉報,きっぽうをもたらした。","tok":[["ところ"],["が"],["今","いま"],["テモテ"],["が"],["、"],["あなた"],["がた"],["の"],["所","ところ"],["から"],["わたしたち"],["の"],["もと"],["に"],["帰えって","かえって"],["きて"],["、"],["あなた"],["がた"],["の"],["信仰","しんこう"],["と"],["愛","あい"],["と"],["について"],["知らせ","しらせ"],["、"],["また"],["、"],["あなた"],["がた"],["が"],["いつも"],["わたしたち"],["の"],["こと"],["を"],["覚え","おぼえ"],["、"],["わたしたち"],["が"],["あなた"],["がた"],["に"],["会いたく","あいたく"],["思って","おもって"],["いる"],["と"],["同じ","おなじ"],["よう"],["に"],["、"],["わたしたち"],["に"],["しきり"],["に"],["会いたがって","あいたがって"],["いる"],["と"],["いう"],["吉報","きっぽう"],["を"],["もたらした"],["。"]]},{"verse":7,"text":"兄弟,きょうだいたちよ。それによって、わたしたちはあらゆる苦難,くなんと患難,かんなんとの中,なかにありながら、あなたがたの信仰,しんこうによって慰,なぐさめられた。","tok":[["兄弟","きょうだい"],["たち"],["よ"],["。"],["それ"],["によって"],["、"],["わたしたち"],["は"],["あらゆる"],["苦難","くなん"],["と"],["患難","かんなん"],["と"],["の"],["中","なか"],["に"],["あり"],["ながら"],["、"],["あなた"],["がた"],["の"],["信仰","しんこう"],["によって"],["慰さめられた","なぐさめられた"],["。"]]},{"verse":8,"text":"なぜなら、あなたがたが主,しゅにあって堅,かたく立,たってくれるなら、わたしたちはいま生,いきることになるからである。","tok":[["なぜ"],["なら"],["、"],["あなた"],["がた"],["が"],["主に","しゅに"],["あって"],["堅く","かたく"],["立って","たって"],["くれるなら"],["、"],["わたしたち"],["は"],["いま"],["生きる","いきる"],["こと"],["に"],["なる"],["から"],["で"],["ある"],["。"]]},{"verse":9,"text":"ほんとうに、わたしたちの神,かみのみまえで、あなたがたのことで喜,よろこぶ大,おおきな喜,よろこびのために、どんな感謝,かんしゃを神,かみにささげたらよいだろうか。","tok":[["ほんとう"],["に"],["、"],["わたしたち"],["の"],["神","かみ"],["のみ"],["まえ"],["で"],["、"],["あなた"],["がた"],["の"],["こと"],["で"],["喜こぶ","よろこぶ"],["大きな","おおきな"],["喜こび","よろこび"],["の"],["ため"],["に"],["、"],["どんな"],["感謝","かんしゃ"],["を"],["神","かみ"],["に"],["ささげたら"],["よいだろう"],["か"],["。"]]},{"verse":10,"text":"わたしたちは、あなたがたの顔,かおを見,み、あなたがたの信仰,しんこうの足,たりないところを補,おぎないたいと、日夜,にちやしきりに願,ねがっているのである。","tok":[["わたしたち"],["は"],["、"],["あなた"],["がた"],["の"],["顔","かお"],["を"],["見","み"],["、"],["あなた"],["がた"],["の"],["信仰","しんこう"],["の"],["足りない","たりない"],["ところ"],["を"],["補ないたい","おぎないたい"],["と"],["、"],["日夜","にちや"],["しきり"],["に"],["願って","ねがって"],["いる"],["ので"],["ある"],["。"]]},{"verse":11,"text":"どうか、わたしたちの父,ちちなる神,かみご自身,じしんと、わたしたちの主,しゅイエスとが、あなたがたのところへ行,いく道,みちを、わたしたちに開,ひらいて下,くださるように。","tok":[["どう"],["か"],["、"],["わたしたち"],["の"],["父","ちち"],["なる"],["神","かみ"],["ご自身","ごじしん"],["と"],["、"],["わたしたち"],["の"],["主","しゅ"],["イエス"],["と"],["が"],["、"],["あなた"],["がた"],["の"],["ところ"],["へ"],["行く","いく"],["道","みち"],["を"],["、"],["わたしたち"],["に"],["開らいて","ひらいて"],["下さる","くださる"],["よう"],["に"],["。"]]},{"verse":12,"text":"どうか、主,しゅが、あなたがた相互,そうごの愛,あいとすべての人,ひとに対,たいする愛,あいとを、わたしたちがあなたがたを愛,あいする愛,あいと同,おなじように、増,まし加,くわえて豊,ゆたかにして下,くださるように。","tok":[["どう"],["か"],["、"],["主","しゅ"],["が"],["、"],["あなた"],["がた"],["相互","そうご"],["の"],["愛","あい"],["と"],["すべて"],["の"],["人","ひと"],["に"],["対する","たいする"],["愛","あい"],["と"],["を"],["、"],["わたしたち"],["が"],["あなた"],["がた"],["を"],["愛する","あいする"],["愛","あい"],["と"],["同じ","おなじ"],["よう"],["に"],["、"],["増し加えて","ましくわえて"],["豊","ゆたか"],["に"],["して"],["下さる","くださる"],["よう"],["に"],["。"]]},{"verse":13,"text":"そして、どうか、わたしたちの主,しゅイエスが、そのすべての聖,せいなる者,ものと共,ともにこられる時,とき、神,かみのみまえに、あなたがたの心,こころを強,つよめ、清,きよく、責,せめられるところのない者,ものにして下,くださるように。","tok":[["そして"],["、"],["どう"],["か"],["、"],["わたしたち"],["の"],["主","しゅ"],["イエス"],["が"],["、"],["その"],["すべて"],["の"],["聖","せい"],["なる"],["者","もの"],["と"],["共","とも"],["に"],["こられる"],["時","とき"],["、"],["神","かみ"],["のみ"],["まえ"],["に"],["、"],["あなた"],["がた"],["の"],["心","こころ"],["を"],["強め","つよめ"],["、"],["清く","きよく"],["、"],["責","せめ"],["られる"],["ところ"],["の"],["ない"],["者","もの"],["に"],["して"],["下さる","くださる"],["よう"],["に"],["。"]]}]
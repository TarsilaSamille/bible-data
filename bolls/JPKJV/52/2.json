[{"verse":1,"text":"兄弟,きょうだいたちよ。あなたがた自身,じしんが知,しっているとおり、わたしたちがあなたがたの所,ところにはいって行,いったことは、むだではなかった。","tok":[["兄弟","きょうだい"],["たち"],["よ"],["。"],["あなた"],["がた"],["自身","じしん"],["が"],["知って","しって"],["いる"],["とおり"],["、"],["わたしたち"],["が"],["あなた"],["がた"],["の"],["所","ところ"],["に"],["はいって"],["行った","いった"],["こと"],["は"],["、"],["むだ"],["で"],["は"],["なかった"],["。"]]},{"verse":2,"text":"それどころか、あなたがたが知,しっているように、わたしたちは、先,さきにピリピで苦,くるしめられ、はずかしめられたにもかかわらず、わたしたちの神,かみに勇気,ゆうきを与,あたえられて、激,はげしい苦闘,くとうのうちに神,かみの福音,ふくいんをあなたがたに語,かたったのである。","tok":[["それ"],["どころ"],["か"],["、"],["あなた"],["がた"],["が"],["知って","しって"],["いる"],["よう"],["に"],["、"],["わたしたち"],["は"],["、"],["先","さき"],["に"],["ピリピ"],["で"],["苦しめられ","くるしめられ"],["、"],["はずかしめられた"],["に"],["も"],["かかわらず"],["、"],["わたしたち"],["の"],["神","かみ"],["に"],["勇気","ゆうき"],["を"],["与えられて","あたえられて"],["、"],["激しい","はげしい"],["苦闘","くとう"],["の"],["うち"],["に"],["神","かみ"],["の"],["福音","ふくいん"],["を"],["あなた"],["がた"],["に"],["語った","かたった"],["ので"],["ある"],["。"]]},{"verse":3,"text":"いったい、わたしたちの宣教,せんきょうは、迷,まよいや汚,けがれた心,こころから出,でたものでもなく、だましごとでもない。","tok":[["いったい"],["、"],["わたしたち"],["の"],["宣教","せんきょう"],["は"],["、"],["迷い","まよい"],["や"],["汚","け"],["がれ"],["た"],["心","こころ"],["から"],["出た","でた"],["もの"],["で"],["も"],["なく"],["、"],["だまし"],["ごと"],["で"],["も"],["ない"],["。"]]},{"verse":4,"text":"かえって、わたしたちは神,かみの信,しん任,にんを受,うけて福音,ふくいんを託,たくされたので、人間,にんげんに喜,よろこばれるためではなく、わたしたちの心,こころを見分,みわける神,かみに喜,よろこばれるように、福音,ふくいんを語,かたるのである。","tok":[["かえって"],["、"],["わたしたち"],["は"],["神","かみ"],["の"],["信任","しんにん"],["を"],["受て","うけて"],["福音","ふくいん"],["を"],["託された","たくされた"],["ので"],["、"],["人間","にんげん"],["に"],["喜こばれる","よろこばれる"],["ため"],["で"],["は"],["なく"],["、"],["わたしたち"],["の"],["心","こころ"],["を"],["見分ける","みわける"],["神","かみ"],["に"],["喜こばれる","よろこばれる"],["よう"],["に"],["、"],["福音","ふくいん"],["を"],["語る","かたる"],["ので"],["ある"],["。"]]},{"verse":5,"text":"わたしたちは、あなたがたが知,しっているように、決,けっしてへつらいの言葉,ことばを用,もちいたこともなく、口実,こうじつを設,もうけて、むさぼったこともない。それは、神,かみがあかしして下,くださる。","tok":[["わたしたち"],["は"],["、"],["あなた"],["がた"],["が"],["知って","しって"],["いる"],["よう"],["に"],["、"],["決っして","けっして"],["へつらい"],["の"],["言葉","ことば"],["を"],["用いた","もちいた"],["こと"],["も"],["なく"],["、"],["口実","こうじつ"],["を"],["設けて","もうけて"],["、"],["むさぼった"],["こと"],["も"],["ない"],["。"],["それ"],["は"],["、"],["神","かみ"],["が"],["あかし"],["して"],["下さる","くださる"],["。"]]},{"verse":6,"text":"また、わたしたちは、キリストの使徒,しととして重,おもんじられることができたのであるが、あなたがたからにもせよ、ほかの人々,ひとびとからにもせよ、人間,にんげんからの栄誉,えいよを求,もとめることはしなかった。","tok":[["また"],["、"],["わたしたち"],["は"],["、"],["キリスト"],["の"],["使徒","しと"],["として"],["重じられる","おもんじられる"],["こと"],["が"],["できた"],["ので"],["ある"],["が"],["、"],["あなた"],["が"],["たから"],["に"],["も"],["せよ"],["、"],["ほか"],["の"],["人々","ひとびと"],["から"],["に"],["も"],["せよ"],["、"],["人間","にんげん"],["から"],["の"],["栄誉","えいよ"],["を"],["求める","もとめる"],["こと"],["は"],["しなかった"],["。"]]},{"verse":7,"text":"むしろ、あなたがたの間,あいだで、ちょうど母,ははがその子供,こどもを育,そだてるように、やさしくふるまった。","tok":[["むしろ"],["、"],["あなた"],["がた"],["の"],["間","あいだ"],["で"],["、"],["ちょうど"],["母","はは"],["が"],["その"],["子供","こども"],["を"],["育てる","そだてる"],["よう"],["に"],["、"],["やさしく"],["ふるまった"],["。"]]},{"verse":8,"text":"このように、あなたがたを慕,したわしく思,おもっていたので、ただ神,かみの福音,ふくいんばかりではなく、自分,じぶんのいのちまでもあなたがたに与,あたえたいと願,ねがったほどに、あなたがたを愛,あいしたのである。","tok":[["この"],["よう"],["に"],["、"],["あなた"],["がた"],["を"],["慕わしく","したわしく"],["思って","おもって"],["いた"],["ので"],["、"],["ただ"],["神","かみ"],["の"],["福音","ふくいん"],["ばかり"],["で"],["は"],["なく"],["、"],["自分","じぶん"],["の"],["いのち"],["まで"],["も"],["あなた"],["がた"],["に"],["与","あたえ"],["たい"],["と"],["願った","ねがった"],["ほど"],["に"],["、"],["あなた"],["がた"],["を"],["愛した","あいした"],["ので"],["ある"],["。"]]},{"verse":9,"text":"兄弟,きょうだいたちよ。あなたがたはわたしたちの労苦,ろうくと努力,どりょくとを記憶,きおくしていることであろう。すなわち、あなたがたのだれにも負担,ふたんをかけまいと思,おもって、日夜,にちやはたらきながら、あなたがたに神,かみの福音,ふくいんを宣,のべ伝,つたえた。","tok":[["兄弟","きょうだい"],["たち"],["よ"],["。"],["あなた"],["がた"],["は"],["わたしたち"],["の"],["労苦","ろうく"],["と"],["努力","どりょく"],["と"],["を"],["記憶","きおく"],["して"],["いる"],["こと"],["で"],["あろう"],["。"],["すなわち"],["、"],["あなた"],["がた"],["の"],["だれ"],["に"],["も"],["負担","ふたん"],["を"],["かけまい"],["と"],["思って","おもって"],["、"],["日夜","にちや"],["はたらき"],["ながら"],["、"],["あなた"],["がた"],["に"],["神","かみ"],["の"],["福音","ふくいん"],["を"],["宣べ伝えた","のべつたえた"],["。"]]},{"verse":10,"text":"あなたがたもあかしし、神,かみもあかしして下,くださるように、わたしたちはあなたがた信者,しんじゃの前,まえで、信心,しんじん深,ぶかく、正,ただしく、責,せめられるところがないように、生活,せいかつをしたのである。","tok":[["あなた"],["がた"],["も"],["あかし"],["し"],["、"],["神","かみ"],["も"],["あかし"],["して"],["下さる","くださる"],["よう"],["に"],["、"],["わたしたち"],["は"],["あなた"],["がた"],["信者","しんじゃ"],["の"],["前","まえ"],["で"],["、"],["信心","しんじん"],["深","ぶ"],["かく"],["、"],["正く","ただしく"],["、"],["責","せめ"],["られる"],["ところ"],["が"],["ない"],["よう"],["に"],["、"],["生活","せいかつ"],["を"],["した"],["ので"],["ある"],["。"]]},{"verse":11,"text":"そして、あなたがたも知,しっているとおり、父,ちちがその子,こに対,たいしてするように、あなたがたのひとりびとりに対,たいして、","tok":[["そして"],["、"],["あなた"],["がた"],["も"],["知って","しって"],["いる"],["とおり"],["、"],["父","ちち"],["が"],["その"],["子","こ"],["に対して","にたいして"],["する"],["よう"],["に"],["、"],["あなた"],["がた"],["の"],["ひとりびとり"],["に対して","にたいして"],["、"]]},{"verse":12,"text":"御国,みくにとその栄光,えいこうとに召,めして下,くださった神,かみのみこころにかなって歩,あるくようにと、勧,すすめ、励,はげまし、また、さとしたのである。","tok":[["御国","みくに"],["と"],["その"],["栄光","えいこう"],["と"],["に"],["召","めし"],["て"],["下さった","くださった"],["神","かみ"],["のみ"],["こころ"],["に"],["かなって"],["歩く","あるく"],["よう"],["に"],["と"],["、"],["勧め","すすめ"],["、"],["励まし","はげまし"],["、"],["また"],["、"],["さとした"],["ので"],["ある"],["。"]]},{"verse":13,"text":"これらのことを考,かんがえて、わたしたちがまた絶,たえず神,かみに感謝,かんしゃしているのは、あなたがたがわたしたちの説,といた神,かみの言,ことばを聞,きいた時,ときに、それを人間,にんげんの言葉,ことばとしてではなく、神,かみの言,ことばとして――事実,じじつそのとおりであるが――受,うけいれてくれたことである。そして、この神,かみの言,ことばは、信,しんじるあなたがたのうちに働,はたらいているのである。","tok":[["これ"],["ら"],["の"],["こと"],["を"],["考","かんがえ"],["て"],["、"],["わたしたち"],["が"],["また"],["絶えず","たえず"],["神","かみ"],["に"],["感謝","かんしゃ"],["して"],["いる"],["の"],["は"],["、"],["あなた"],["がた"],["が"],["わたしたち"],["の"],["説いた","といた"],["神","かみ"],["の"],["言","ことば"],["を"],["聞いた","きいた"],["時","とき"],["に"],["、"],["それ"],["を"],["人間","にんげん"],["の"],["言葉","ことば"],["として"],["で"],["は"],["なく"],["、"],["神","かみ"],["の"],["言","ことば"],["として"],["―"],["―"],["事実","じじつ"],["その"],["とおり"],["で"],["ある"],["が"],["―"],["―"],["受","うけ"],["いれて"],["くれた"],["こと"],["で"],["ある"],["。"],["そして"],["、"],["この"],["神","かみ"],["の"],["言","ことば"],["は"],["、"],["信じる","しんじる"],["あなた"],["がた"],["の"],["うち"],["に"],["働いて","はたらいて"],["いる"],["ので"],["ある"],["。"]]},{"verse":14,"text":"兄弟,きょうだいたちよ。あなたがたは、ユダヤの、キリスト・イエスにある神,かみの諸,しょ教会,きょうかいにならう者,ものとなった。すなわち、彼,かれらがユダヤ人,じんたちから苦,くるしめられたと同,おなじように、あなたがたもまた同国人,どうこくじんから苦,くるしめられた。","tok":[["兄弟","きょうだい"],["たち"],["よ"],["。"],["あなた"],["がた"],["は"],["、"],["ユダヤ"],["の"],["、"],["キリスト"],["・"],["イエス"],["に"],["ある"],["神","かみ"],["の"],["諸教","しょ教"],["会","かい"],["に"],["ならう"],["者","もの"],["と"],["なった"],["。"],["すなわち"],["、"],["彼","かれ"],["ら"],["が"],["ユダヤ人","ゆだやじん"],["たち"],["から"],["苦しめられた","くるしめられた"],["と"],["同じ","おなじ"],["よう"],["に"],["、"],["あなた"],["がた"],["も"],["また"],["同国人","どうこくじんか"],["ら"],["苦しめられた","くるしめられた"],["。"]]},{"verse":15,"text":"ユダヤ人,じんたちは主,しゅイエスと預言者,よげんしゃたちとを殺,ころし、わたしたちを迫害,はくがいし、神,かみを喜,よろこばせず、すべての人,ひとに逆,さからい、","tok":[["ユダヤ人","ゆだやじん"],["たち"],["は"],["主","しゅ"],["イエス"],["と"],["預言者","よげんしゃ"],["たち"],["と"],["を"],["殺ろし","ころし"],["、"],["わたしたち"],["を"],["迫害","はくがい"],["し"],["、"],["神","かみ"],["を"],["喜こばせず","よろこばせず"],["、"],["すべて"],["の"],["人","ひと"],["に"],["逆らい","さからい"],["、"]]},{"verse":16,"text":"わたしたちが異邦人,いほうじんに救,すくいの言,ことばを語,かたるのを妨,さまたげて、絶,たえず自分,じぶんの罪,つみを満,みたしている。そこで、神,かみの怒,いかりは最,もっとも激,はげしく彼,かれらに臨,のぞむに至,いたったのである。","tok":[["わたしたち"],["が"],["異邦人","いほうじん"],["に"],["救い","すくい"],["の"],["言","ことば"],["を"],["語る","かたる"],["の"],["を"],["妨げて","さまたげて"],["、"],["絶えず","たえず"],["自分","じぶん"],["の"],["罪","つみ"],["を"],["満たして","みたして"],["いる"],["。"],["そこ"],["で"],["、"],["神","かみ"],["の"],["怒り","いかり"],["は"],["最も","もっとも"],["激しく","はげしく"],["彼","かれ"],["ら"],["に"],["臨む","のぞむ"],["に"],["至った","いたった"],["ので"],["ある"],["。"]]},{"verse":17,"text":"兄弟,きょうだいたちよ。わたしたちは、しばらくの間,あいだ、あなたがたから引,ひき離,はなされていたので――心,こころにおいてではなく、からだだけではあるが――なおさら、あなたがたの顔,かおを見,みたいと切,せつにこいねがった。","tok":[["兄弟","きょうだい"],["たち"],["よ"],["。"],["わたしたち"],["は"],["、"],["しばらく"],["の"],["間","あいだ"],["、"],["あなた"],["がた"],["から"],["引離されて","ひきはなされて"],["いた"],["ので"],["―"],["―"],["心","こころ"],["に"],["おいて"],["で"],["は"],["なく"],["、"],["からだ"],["だけ"],["で"],["は"],["ある"],["が"],["―"],["―"],["なおさら"],["、"],["あなた"],["がた"],["の"],["顔","かお"],["を"],["見たい","みたい"],["と"],["切","せつ"],["に"],["こいねがった"],["。"]]},{"verse":18,"text":"だから、わたしたちは、あなたがたの所,ところに行,いこうとした。ことに、このパウロは、一再,いっさいならず行,いこうとしたのである。それだのに、わたしたちはサタンに妨,さまたげられた。","tok":[["だ"],["から"],["、"],["わたしたち"],["は"],["、"],["あなた"],["がた"],["の"],["所","ところ"],["に"],["行こう","いこう"],["と"],["した"],["。"],["こと"],["に"],["、"],["この"],["パウロ"],["は"],["、"],["一再","いっさい"],["ならず"],["行こう","いこう"],["と"],["した"],["ので"],["ある"],["。"],["それ"],["だ"],["のに"],["、"],["わたしたち"],["は"],["サタン"],["に"],["妨げられた","さまたげられた"],["。"]]},{"verse":19,"text":"実際,じっさい、わたしたちの主,しゅイエスの来臨,らいりんにあたって、わたしたちの望,のぞみと喜,よろこびと誇,ほこりの冠,かんむりとなるべき者,ものは、あなたがたを外,ほかにして、だれがあるだろうか。","tok":[["実際","じっさい"],["、"],["わたしたち"],["の"],["主","しゅ"],["イエス"],["の"],["来臨","らいりん"],["に"],["あたって"],["、"],["わたしたち"],["の"],["望み","のぞみ"],["と"],["喜こび","よろこび"],["と"],["誇","ほこり"],["の"],["冠","かんむり"],["と"],["なるべき"],["者","もの"],["は"],["、"],["あなた"],["がた"],["を"],["外","ほか"],["に"],["して"],["、"],["だれ"],["が"],["あるだろう"],["か"],["。"]]},{"verse":20,"text":"あなたがたこそ、実,じつにわたしたちのほまれであり、喜,よろこびである。","tok":[["あなた"],["がた"],["こそ"],["、"],["実","じつ"],["に"],["わたしたち"],["の"],["ほまれ"],["で"],["あり"],["、"],["喜こびで","よろこびで"],["ある"],["。"]]}]
[{"verse":1,"text":"主,しゅはまたモーセに言,いわれた、","tok":[["主","しゅ"],["は"],["また"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":2,"text":"「イスラエルの人々,ひとびとに言,いいなさい、『あなたがたが、ふれ示,しめして聖,せい会,かいとすべき主,しゅの定,さだめの祭,まつりは次,つぎのとおりである。これらはわたしの定,さだめの祭,まつりである。","tok":[["「"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["言い","いい"],["なさい"],["、"],["『"],["あなた"],["が"],["た"],["が"],["、"],["ふれ"],["示めして","しめして"],["聖い","せい"],["会","かい"],["と"],["すべき"],["主","しゅ"],["の"],["定め","さだめ"],["の"],["祭","まつり"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["これ"],["ら"],["は"],["わたし"],["の"],["定め","さだめ"],["の"],["祭","まつり"],["で"],["ある"],["。"]]},{"verse":3,"text":"六日,かの間,あいだは仕事,しごとをしなければならない。第,だい七日,にちは全,まったき休,やすみの安息日,あんそくにちであり、聖,せい会,かいである。どのような仕事,しごともしてはならない。これはあなたがたのすべてのすまいにおいて守,まもるべき主,しゅの安息日,あんそくにちである。","tok":[["六日","か"],["の"],["間","あいだ"],["は"],["仕事","しごと"],["を"],["しなければ"],["ならない"],["。"],["第","だい"],["七","なな"],["日","にち"],["は"],["全","ま"],["っ"],["たき"],["休み","やすみ"],["の"],["安息日","あん"],["そ"],["く"],["にち"],["で"],["あり"],["、"],["聖い","せい"],["会","かい"],["で"],["ある"],["。"],["どのような"],["仕事","しごと"],["も"],["して"],["は"],["ならない"],["。"],["これ"],["は"],["あなた"],["がた"],["の"],["すべて"],["の"],["すまい"],["に"],["おいて"],["守","まもる"],["べき"],["主","しゅ"],["の"],["安息日","あん"],["そ"],["く"],["にち"],["で"],["ある"],["。"]]},{"verse":4,"text":"その時,とき々に、あなたがたが、ふれ示,しめすべき主,しゅの定,さだめの祭,まつりなる聖,せい会,かいは次,つぎのとおりである。","tok":[["その"],["時々","とき々"],["に"],["、"],["あなた"],["が"],["た"],["が"],["、"],["ふれ"],["示めすべき","しめすべき"],["主","しゅ"],["の"],["定め","さだめ"],["の"],["祭","まつり"],["なる"],["聖い","せい"],["会","かい"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"]]},{"verse":5,"text":"正月,しょうがつの十四日,かの夕,ゆうは主,しゅの過越,すぎこしの祭,まつりである。","tok":[["正月","しょうがつ"],["の"],["十四日","か"],["の"],["夕","ゆう"],["は"],["主","しゅ"],["の"],["過越","すぎこし"],["の"],["祭","まつり"],["で"],["ある"],["。"]]},{"verse":6,"text":"またその月,つきの十五日,にちは主,しゅの種,たね入,いれぬパンの祭,まつりである。あなたがたは七日,なぬかの間,あいだは種,たね入,いれぬパンを食,たべなければならない。","tok":[["また"],["その"],["月","つき"],["の"],["十五","じゅうご"],["日","にち"],["は"],["主","しゅ"],["の"],["種","たね"],["入れぬ","いれぬ"],["パン"],["の"],["祭","まつり"],["で"],["ある"],["。"],["あなた"],["がた"],["は"],["七日","なぬか"],["の"],["間","あいだ"],["は"],["種","た"],["ね"],["入れぬ","いれぬ"],["パン"],["を"],["食べなければ","たべなければ"],["ならない"],["。"]]},{"verse":7,"text":"その初,はじめの日,ひに聖,せい会,かいを開,ひらかなければならない。どんな労働,ろうどうもしてはならない。","tok":[["その"],["初め","はじめ"],["の"],["日","ひ"],["に"],["聖会","せいかい"],["を"],["開らかなければ","ひらかなければ"],["ならない"],["。"],["どんな"],["労働","ろうどう"],["も"],["して"],["は"],["ならない"],["。"]]},{"verse":8,"text":"あなたがたは七日,なぬかの間,あいだ、主,しゅに火祭,かさいをささげなければならない。第,だい七日,にちには、また聖,せい会,かいを開,ひらき、どのような労働,ろうどうもしてはならない』」。","tok":[["あなた"],["がた"],["は"],["七日","なぬか"],["の"],["間","あいだ"],["、"],["主に","しゅに"],["火祭","かさい"],["を"],["ささげなければ"],["ならない"],["。"],["第","だい"],["七","なな"],["日","にち"],["に"],["は"],["、"],["また"],["聖会","せいかい"],["を"],["開らき","ひらき"],["、"],["どのような"],["労働","ろうどう"],["も"],["して"],["は"],["ならない"],["』"],["」"],["。"]]},{"verse":9,"text":"主,しゅはまたモーセに言,いわれた、","tok":[["主","しゅ"],["は"],["また"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":10,"text":"「イスラエルの人々,ひとびとに言,いいなさい、『わたしが与,あたえる地,ちにはいって穀物,こくもつを刈,かり入,いれるとき、あなたがたは穀物,こくもつの初穂,はつほの束,たばを、祭司,さいしのところへ携,たずさえてこなければならない。","tok":[["「"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["言い","いい"],["なさい"],["、"],["『"],["わたし"],["が"],["与える","あたえる"],["地","ち"],["に"],["はいって"],["穀物","こくもつ"],["を"],["刈入れる","かりいれる"],["とき"],["、"],["あなた"],["がた"],["は"],["穀物","こくもつ"],["の"],["初穂","はつほ"],["の"],["束","たば"],["を"],["、"],["祭司","さいし"],["の"],["ところ"],["へ"],["携えて","たずさえて"],["こなければ"],["ならない"],["。"]]},{"verse":11,"text":"彼,かれはあなたがたの受,うけ入,いれられるように、その束,たばを主,しゅの前,まえに揺,ゆり動,うごかすであろう。すなわち、祭司,さいしは安息日,あんそくにちの翌日,よくじつに、これを揺,ゆり動,うごかすであろう。","tok":[["彼","かれ"],["は"],["あなた"],["がた"],["の"],["受け入れられる","うけいれられる"],["よう"],["に"],["、"],["その"],["束","たば"],["を"],["主","しゅ"],["の"],["前","まえ"],["に"],["揺り動かすで","ゆりうごかすで"],["あろう"],["。"],["すなわち"],["、"],["祭司","さいし"],["は"],["安息日","あんそくにち"],["の"],["翌日","よくじつ"],["に"],["、"],["これ"],["を"],["揺り動かすで","ゆりうごかすで"],["あろう"],["。"]]},{"verse":12,"text":"またその束,たばを揺,ゆり動,うごかす日,ひに、一歳,さいの雄,おすの小羊,こひつじの全,まったきものを燔祭,はんさいとして主,しゅにささげなければならない。","tok":[["また"],["その"],["束","たば"],["を"],["揺り動かす","ゆりうごかす"],["日","ひ"],["に"],["、"],["一歳","さい"],["の"],["雄","おす"],["の"],["小羊","こひつじ"],["の"],["全","まったきも"],["の"],["を"],["燔祭","はんさい"],["として"],["主に","しゅに"],["ささげなければ"],["ならない"],["。"]]},{"verse":13,"text":"その素祭,そさいには油,あぶらを混,まぜた麦粉,むぎこ十分,ぶんの二エパを用,もちい、これを主,しゅにささげて火祭,かさいとし、香,こうばしいかおりとしなければならない。またその灌祭,かんさいには、ぶどう酒,しゅ一ヒンの四分,ぶんの一を用,もちいなければならない。","tok":[["その"],["素","す"],["祭","まつり"],["に"],["は"],["油","あぶら"],["を"],["混ぜた","まぜた"],["麦粉","むぎこ"],["十分","ぶん"],["の"],["二","に"],["エパ"],["を"],["用い","もちい"],["、"],["これ"],["を"],["主に","しゅに"],["ささげて"],["火祭","か"],["さい"],["と"],["し"],["、"],["香ばしい","こうばしい"],["かおり"],["と"],["しなければ"],["ならない"],["。"],["また"],["その"],["灌祭","かんさい"],["に"],["は"],["、"],["ぶどう酒","ぶどうしゅ"],["一","いち"],["ヒン"],["の"],["四分","ぶん"],["の"],["一","いち"],["を"],["用いなければ","もちいなければ"],["ならない"],["。"]]},{"verse":14,"text":"あなたがたの神,かみにこの供,そなえ物,ものをささげるその日,ひまで、あなたがたはパンも、焼麦,やきむぎも、新穀,しんこくも食,たべてはならない。これはあなたがたのすべてのすまいにおいて、代々,よよながく守,まもるべき定,さだめである。","tok":[["あなた"],["がた"],["の"],["神","かみ"],["に"],["この"],["供え物","そなえもの"],["を"],["ささげる"],["その"],["日","ひ"],["まで"],["、"],["あなた"],["がた"],["は"],["パン"],["も"],["、"],["焼","しょう"],["麦","むぎ"],["も"],["、"],["新穀","しんこく"],["も"],["食べて","たべて"],["は"],["ならない"],["。"],["これ"],["は"],["あなた"],["がた"],["の"],["すべて"],["の"],["すまい"],["に"],["おいて"],["、"],["代々","よ"],["よ"],["ながく"],["守","まもる"],["べき"],["定","さだめ"],["で"],["ある"],["。"]]},{"verse":15,"text":"また安息日,あんそくにちの翌日,よくじつ、すなわち、揺祭,ようさいの束,たばをささげた日,ひから満,まん七週,しゅうを数,かぞえなければならない。","tok":[["また"],["安息日","あんそくにち"],["の"],["翌日","よくじつ"],["、"],["すなわち"],["、"],["揺祭","ようさい"],["の"],["束","たば"],["を"],["ささげた"],["日","ひ"],["から"],["満","まん"],["七","なな"],["週","しゅう"],["を"],["数えなければ","かぞえなければ"],["ならない"],["。"]]},{"verse":16,"text":"すなわち、第,だい七の安息日,あんそくにちの翌日,よくじつまでに、五十日,にちを数,かぞえて、新穀,しんこくの素祭,そさいを主,しゅにささげなければならない。","tok":[["すなわち"],["、"],["第","だい"],["七","なな"],["の"],["安息日","あんそくにち"],["の"],["翌日","よくじつ"],["まで"],["に"],["、"],["五十日","にち"],["を"],["数えて","かぞえて"],["、"],["新穀","しんこく"],["の"],["素","す"],["祭","まつり"],["を"],["主に","しゅに"],["ささげなければ"],["ならない"],["。"]]},{"verse":17,"text":"またあなたがたのすまいから、十分,ぶんの二エパの麦粉,むぎこに種,たねを入,いれて焼,やいたパン二個,こを携,たずさえてきて揺祭,ようさいとしなければならない。これは初穂,はつほとして主,しゅにささげるものである。","tok":[["また"],["あなた"],["がた"],["の"],["すまい"],["から"],["、"],["十分","ぶん"],["の"],["二","に"],["エパ"],["の"],["麦粉","むぎこ"],["に"],["種","たね"],["を"],["入れて","いれて"],["焼いた","やいた"],["パン"],["二個","こ"],["を"],["携えて","たずさえて"],["きて"],["揺祭","ようさい"],["と"],["しなければ"],["ならない"],["。"],["これ"],["は"],["初穂","はつほ"],["として"],["主に","しゅに"],["ささげる"],["もの"],["で"],["ある"],["。"]]},{"verse":18,"text":"あなたがたはまたパンのほかに、一歳,さいの全,まったき小羊,こひつじ七頭,とうと、若,わかき雄牛,おうし一頭,とうと、雄羊,おひつじ二頭,とうをささげなければならない。すなわち、これらをその素祭,そさいおよび灌祭,かんさいとともに主,しゅにささげて燔祭,はんさいとしなければならない。これは火祭,かさいであって、主,しゅに香,こうばしいかおりとなるであろう。","tok":[["あなた"],["がた"],["は"],["また"],["パン"],["の"],["ほか"],["に"],["、"],["一歳","さい"],["の"],["全","ま"],["っ"],["たき"],["小羊","こひつじ"],["七頭","とう"],["と"],["、"],["若き","わかき"],["雄牛","おうし"],["一頭","とう"],["と"],["、"],["雄羊","おひつじ"],["二頭","とう"],["を"],["ささげなければ"],["ならない"],["。"],["すなわち"],["、"],["これ"],["ら"],["を"],["その"],["素","す"],["祭","まつり"],["さい"],["および"],["灌祭","かんさい"],["と"],["とも"],["に"],["主に","しゅに"],["ささげて"],["燔祭","はんさい"],["と"],["しなければ"],["ならない"],["。"],["これ"],["は"],["火祭","か"],["さい"],["で"],["あって"],["、"],["主に","しゅに"],["香ばしい","こうばしい"],["かおり"],["と"],["なるで"],["あろう"],["。"]]},{"verse":19,"text":"また雄,おやぎ一頭,とうを罪祭,ざいさいとしてささげ、一歳,さいの小羊,こひつじ二頭,とうを酬恩祭,しゅうおんさいの犠牲,ぎせいとしてささげなければならない。","tok":[["また"],["雄","お"],["やぎ"],["一頭","とう"],["を"],["罪","つみ"],["祭","まつり"],["として"],["ささげ"],["、"],["一歳","さい"],["の"],["小羊","こひつじ"],["二頭","とう"],["を"],["酬恩祭","しゅうおんさい"],["の"],["犠牲","ぎせい"],["として"],["ささげなければ"],["ならない"],["。"]]},{"verse":20,"text":"そして祭司,さいしはその初穂,はつほのパンと共,ともに、この二頭,とうの小羊,こひつじを主,しゅの前,まえに揺祭,ようさいとして揺,ゆり動,うごかさなければならない。これらは主,しゅにささげる聖,せいなる物,ものであって、祭司,さいしに帰,きするであろう。","tok":[["そして"],["祭司","さいし"],["は"],["その"],["初穂","はつほ"],["の"],["パン"],["と"],["共","とも"],["に"],["、"],["この"],["二頭","とう"],["の"],["小羊","こひつじ"],["を"],["主","しゅ"],["の"],["前","まえ"],["に"],["揺祭","ようさい"],["として"],["揺り動かさなければ","ゆりうごかさなければ"],["ならない"],["。"],["これ"],["ら"],["は"],["主に","しゅに"],["ささげる"],["聖","せい"],["なる"],["物","もの"],["で"],["あって"],["、"],["祭司","さいし"],["に"],["帰するで","きするで"],["あろう"],["。"]]},{"verse":21,"text":"あなたがたは、その日,ひにふれ示,しめして、聖,せい会,かいを開,ひらかなければならない。どのような労働,ろうどうもしてはならない。これはあなたがたのすべてのすまいにおいて、代々,よよながく守,まもるべき定,さだめである。","tok":[["あなた"],["がた"],["は"],["、"],["その"],["日","ひ"],["に"],["ふれ"],["示めして","しめして"],["、"],["聖い","せい"],["会","かい"],["を"],["開らかなければ","ひらかなければ"],["ならない"],["。"],["どのような"],["労働","ろうどう"],["も"],["して"],["は"],["ならない"],["。"],["これ"],["は"],["あなた"],["がた"],["の"],["すべて"],["の"],["すまい"],["に"],["おいて"],["、"],["代々","よ"],["よ"],["ながく"],["守","まもる"],["べき"],["定","さだめ"],["で"],["ある"],["。"]]},{"verse":22,"text":"あなたがたの地,ちの穀物,こくもつを刈,かり入,いれるときは、その刈入,かりいれにあたって、畑,はたけのすみずみまで刈,かりつくしてはならない。またあなたの穀物,こくもつの落,おち穂,ぼを拾,ひろってはならない。貧,まずしい者,ものと寄留者,きりゅうしゃのために、それを残,のこしておかなければならない。わたしはあなたがたの神,かみ、主,しゅである』」。","tok":[["あなた"],["がた"],["の"],["地","ち"],["の"],["穀物","こくもつ"],["を"],["刈入れる","かりいれる"],["とき"],["は"],["、"],["その"],["刈入れ","かりいれ"],["に"],["あたって"],["、"],["畑","はたけ"],["の"],["すみずみ"],["まで"],["刈","かり"],["つくして"],["は"],["ならない"],["。"],["また"],["あなた"],["の"],["穀物","こくもつ"],["の"],["落穂","おちぼ"],["を"],["拾って","ひろって"],["は"],["ならない"],["。"],["貧しい","まずしい"],["者","もの"],["と"],["寄留者","きりゅうしゃ"],["の"],["ため"],["に"],["、"],["それ"],["を"],["残して","のこして"],["おかなければ"],["ならない"],["。"],["わたし"],["は"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["で"],["ある"],["』"],["」"],["。"]]},{"verse":23,"text":"主,しゅはまたモーセに言,いわれた、","tok":[["主","しゅ"],["は"],["また"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":24,"text":"「イスラエルの人々,ひとびとに言,いいなさい、『七月,がつ一日,にちをあなたがたの安息,あんそくの日,ひとし、ラッパを吹,ふき鳴,ならして記念,きねんする聖,せい会,かいとしなければならない。","tok":[["「"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["言い","いい"],["なさい"],["、"],["『"],["七","なな"],["月","がつ"],["つ"],["一","いち"],["日","にち"],["を"],["あなた"],["がた"],["の"],["安息","あんそく"],["の"],["日","ひ"],["と"],["し"],["、"],["ラッパ"],["を"],["吹鳴","ふきな"],["らして"],["記念","きねん"],["する"],["聖い","せい"],["会","かい"],["と"],["しなければ"],["ならない"],["。"]]},{"verse":25,"text":"どのような労働,ろうどうもしてはならない。しかし、主,しゅに火祭,かさいをささげなければならない』」。","tok":[["どのような"],["労働","ろうどう"],["も"],["して"],["は"],["ならない"],["。"],["しかし"],["、"],["主に","しゅに"],["火祭","かさい"],["を"],["ささげなければ"],["ならない"],["』"],["」"],["。"]]},{"verse":26,"text":"主,しゅはまたモーセに言,いわれた、","tok":[["主","しゅ"],["は"],["また"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":27,"text":"「特,とくにその七月,がつの十日,かは贖罪,しょくざいの日,ひである。あなたがたは聖,せい会,かいを開,ひらき、身,みを悩,なやまし、主,しゅに火祭,かさいをささげなければならない。","tok":[["「"],["特に","とくに"],["その"],["七","なな"],["月","がつ"],["の"],["十日","か"],["は"],["贖罪","しょくざい"],["の"],["日","ひ"],["で"],["ある"],["。"],["あなた"],["がた"],["は"],["聖会","せいかい"],["を"],["開らき","ひらき"],["、"],["身","み"],["を"],["悩し","なやまし"],["、"],["主に","しゅに"],["火祭","かさい"],["を"],["ささげなければ"],["ならない"],["。"]]},{"verse":28,"text":"その日,ひには、どのような仕事,しごともしてはならない。これはあなたがたのために、あなたがたの神,かみ、主,しゅの前,まえにあがないをなすべき贖罪,しょくざいの日,ひだからである。","tok":[["その"],["日","ひ"],["に"],["は"],["、"],["どのような"],["仕事","しごと"],["も"],["して"],["は"],["ならない"],["。"],["これ"],["は"],["あなた"],["がた"],["の"],["ため"],["に"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["あがない"],["を"],["なすべき"],["贖罪","しょくざい"],["の"],["日","ひ"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":29,"text":"すべてその日,ひに身,みを悩,なやまさない者,ものは、民,たみのうちから断,たたれるであろう。","tok":[["すべて"],["その"],["日","ひ"],["に"],["身","み"],["を"],["悩さない","なやまさない"],["者","もの"],["は"],["、"],["民","たみ"],["の"],["うち"],["から"],["断たれるで","たたれるで"],["あろう"],["。"]]},{"verse":30,"text":"またすべてその日,ひにどのような仕事,しごとをしても、その人,ひとをわたしは民,たみのうちから滅,ほろぼし去,さるであろう。","tok":[["また"],["すべて"],["その"],["日","ひ"],["に"],["どのような"],["仕事","しごと"],["を"],["して"],["も"],["、"],["その"],["人","ひと"],["を"],["わたし"],["は"],["民","たみ"],["の"],["うち"],["から"],["滅ぼし去るで","ほろぼしさるで"],["あろう"],["。"]]},{"verse":31,"text":"あなたがたはどのような仕事,しごともしてはならない。これはあなたがたのすべてのすまいにおいて、代々,よよながく守,まもるべき定,さだめである。","tok":[["あなた"],["がた"],["は"],["どのような"],["仕事","しごと"],["も"],["して"],["は"],["ならない"],["。"],["これ"],["は"],["あなた"],["がた"],["の"],["すべて"],["の"],["すまい"],["に"],["おいて"],["、"],["代々","よ"],["よ"],["ながく"],["守","まもる"],["べき"],["定","さだめ"],["で"],["ある"],["。"]]},{"verse":32,"text":"これはあなたがたの全,まったき休,やすみの安息日,あんそくにちである。あなたがたは身,みを悩,なやまさなければならない。またその月,つきの九日,かの夕,ゆうには、その夕,ゆうから次,つぎの夕,ゆうまで安息,あんそくを守,まもらなければならない」。","tok":[["これ"],["は"],["あなた"],["がた"],["の"],["全","ま"],["っ"],["たき"],["休み","やすみ"],["の"],["安息日","あん"],["そ"],["く"],["にち"],["で"],["ある"],["。"],["あなた"],["がた"],["は"],["身","み"],["を"],["悩さなければ","なやまさなければ"],["ならない"],["。"],["また"],["その"],["月","つき"],["の"],["九日","か"],["の"],["夕","ゆう"],["に"],["は"],["、"],["その"],["夕","ゆう"],["から"],["次","つぎ"],["の"],["夕","ゆう"],["まで"],["安息","あんそく"],["を"],["守らなければ","まもらなければ"],["ならない"],["」"],["。"]]},{"verse":33,"text":"主,しゅはまたモーセに言,いわれた、","tok":[["主","しゅ"],["は"],["また"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":34,"text":"「イスラエルの人々,ひとびとに言,いいなさい、『その七月,がつの十五日,にちは仮庵,かりいおの祭,まつりである。七日,なぬかの間,あいだ、主,しゅの前,まえにそれを守,まもらなければならない。","tok":[["「"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["言い","いい"],["なさい"],["、"],["『"],["その"],["七","なな"],["月","がつ"],["の"],["十五","じゅうご"],["日","にち"],["は"],["仮庵","かりいお"],["の"],["祭","まつり"],["で"],["ある"],["。"],["七日","なぬか"],["の"],["間","あいだ"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["それ"],["を"],["守らなければ","まもらなければ"],["ならない"],["。"]]},{"verse":35,"text":"初,はじめの日,ひに聖,せい会,かいを開,ひらかなければならない。どのような労働,ろうどうもしてはならない。","tok":[["初め","はじめ"],["の"],["日","ひ"],["に"],["聖会","せいかい"],["を"],["開らかなければ","ひらかなければ"],["ならない"],["。"],["どのような"],["労働","ろうどう"],["も"],["して"],["は"],["ならない"],["。"]]},{"verse":36,"text":"また七日,なぬかの間,あいだ、主,しゅに火祭,かさいをささげなければならない。八日,か目,めには聖,せい会,かいを開,ひらき、主,しゅに火祭,かさいをささげなければならない。これは聖,せい会,かいの日,ひであるから、どのような労働,ろうどうもしてはならない。","tok":[["また"],["七日","なぬか"],["の"],["間","あいだ"],["、"],["主に","しゅに"],["火祭","かさい"],["を"],["ささげなければ"],["ならない"],["。"],["八日目","かめ"],["に"],["は"],["聖会","せいかい"],["を"],["開らき","ひらき"],["、"],["主に","しゅに"],["火祭","かさい"],["を"],["ささげなければ"],["ならない"],["。"],["これ"],["は"],["聖会","せいかい"],["の"],["日","ひ"],["で"],["ある"],["から"],["、"],["どのような"],["労働","ろうどう"],["も"],["して"],["は"],["ならない"],["。"]]},{"verse":37,"text":"これらは主,しゅの定,さだめの祭,まつりであって、あなたがたがふれ示,しめして聖,せい会,かいとし、主,しゅに火祭,かさいすなわち、燔祭,はんさい、素祭,そさい、犠牲,ぎせいおよび灌祭,かんさいを、そのささぐべき日,ひにささげなければならない。","tok":[["これ"],["ら"],["は"],["主","しゅ"],["の"],["定め","さだめ"],["の"],["祭","まつり"],["で"],["あって"],["、"],["あなた"],["がた"],["が"],["ふれ"],["示めして","しめして"],["聖い","せい"],["会","かい"],["と"],["し"],["、"],["主に","しゅに"],["火祭","か"],["さい"],["すなわち"],["、"],["燔祭","はんさい"],["、"],["素","す"],["祭","まつり"],["さい"],["、"],["犠牲","ぎせい"],["および"],["灌祭","かんさい"],["を"],["、"],["その"],["ささぐべき"],["日","ひ"],["に"],["ささげなければ"],["ならない"],["。"]]},{"verse":38,"text":"このほかに主,しゅの安息日,あんそくにちがあり、またほかに、あなたがたのささげ物,ものがあり、またほかに、あなたがたのもろもろの誓願,せいがんの供,そなえ物,ものがあり、またそのほかに、あなたがたのもろもろの自発,じはつの供,そなえ物,ものがある。これらは皆,みなあなたがたが主,しゅにささげるものである。","tok":[["この"],["ほか"],["に"],["主","しゅ"],["の"],["安息日","あんそくにち"],["が"],["あり"],["、"],["また"],["ほか"],["に"],["、"],["あなた"],["がた"],["の"],["ささげ物","ささげもの"],["が"],["あり"],["、"],["また"],["ほか"],["に"],["、"],["あなた"],["がた"],["の"],["もろもろ"],["の"],["誓願","せいがん"],["の"],["供え物","そなえもの"],["が"],["あり"],["、"],["また"],["その"],["ほか"],["に"],["、"],["あなた"],["がた"],["の"],["もろもろ"],["の"],["自発","じはつ"],["の"],["供え物","そなえもの"],["が"],["ある"],["。"],["これ"],["ら"],["は"],["皆","みな"],["あなた"],["がた"],["が"],["主に","しゅに"],["ささげる"],["もの"],["で"],["ある"],["。"]]},{"verse":39,"text":"あなたがたが、地,ちの産物,さんぶつを集,あつめ終,おわったときは、七月,がつの十五日,にちから七日,なぬかのあいだ、主,しゅの祭,まつりを守,まもらなければならない。すなわち、初,はじめの日,ひにも安息,あんそくをし、八日,か目,めにも安息,あんそくをしなければならない。","tok":[["あなた"],["が"],["た"],["が"],["、"],["地","ち"],["の"],["産物","さんぶつ"],["を"],["集め","あつめ"],["終わった","おわった"],["とき"],["は"],["、"],["七","なな"],["月","がつ"],["の"],["十五","じゅうご"],["日","にち"],["ら"],["七日","なぬか"],["の"],["あいだ"],["、"],["主","しゅ"],["の"],["祭","まつり"],["を"],["守らなければ","まもらなければ"],["ならない"],["。"],["すなわち"],["、"],["初め","はじめ"],["の"],["日","ひ"],["に"],["も"],["安息","あんそく"],["を"],["し"],["、"],["八日目","かめ"],["に"],["も"],["安息","あんそく"],["を"],["しなければ"],["ならない"],["。"]]},{"verse":40,"text":"初,はじめの日,ひに、美,うつくしい木,きの実,みと、なつめやしの枝,えだと、茂,しげった木,きの枝,えだと、谷,たにのはこやなぎの枝,えだを取,とって、七日,なぬかの間,あいだあなたがたの神,かみ、主,しゅの前,まえに楽,たのしまなければならない。","tok":[["初め","はじめ"],["の"],["日","ひ"],["に"],["、"],["美しい","うつくしい"],["木の実","きのみ"],["と"],["、"],["なつめやし"],["の"],["枝","えだ"],["と"],["、"],["茂った","しげった"],["木","き"],["の"],["枝","えだ"],["と"],["、"],["谷","たに"],["の"],["はこやなぎ"],["の"],["枝","えだ"],["を"],["取って","とって"],["、"],["七日","なぬか"],["の"],["間","あいだ"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["楽しまなければ","たのしまなければ"],["ならない"],["。"]]},{"verse":41,"text":"あなたがたは年,ねんに七日,なぬかの間,あいだ、主,しゅにこの祭,まつりを守,まもらなければならない。これはあなたがたの代々,よよながく守,まもるべき定,さだめであって、七月,がつにこれを守,まもらなければならない。","tok":[["あなた"],["がた"],["は"],["年","ねん"],["に"],["七","しち"],["日","にち"],["の"],["間","あいだ"],["、"],["主に","しゅに"],["この"],["祭","まつり"],["を"],["守らなければ","まもらなければ"],["ならない"],["。"],["これ"],["は"],["あなた"],["がた"],["の"],["代々","よ"],["よ"],["ながく"],["守","まもる"],["べき"],["定","さだめ"],["で"],["あって"],["、"],["七","なな"],["月","がつ"],["に"],["これ"],["を"],["守らなければ","まもらなければ"],["ならない"],["。"]]},{"verse":42,"text":"あなたがたは七日,なぬかの間,あいだ、仮庵,かりいおに住,すみ、イスラエルで生,うまれた者,ものはみな仮庵,かりいおに住,すまなければならない。","tok":[["あなた"],["がた"],["は"],["七日","なぬか"],["の"],["間","あいだ"],["、"],["仮庵","かりいお"],["に"],["住み","すみ"],["、"],["イスラエル"],["で"],["生まれた","うまれた"],["者","もの"],["は"],["みな"],["仮庵","かりいお"],["に"],["住まなければ","すまなければ"],["ならない"],["。"]]},{"verse":43,"text":"これはわたしがイスラエルの人々,ひとびとをエジプトの国,くにから導,みちびき出,だしたとき、彼,かれらを仮庵,かりいおに住,すまわせた事,ことを、あなたがたの代々,よよの子孫,しそんに知,しらせるためである。わたしはあなたがたの神,かみ、主,しゅである』」。","tok":[["これ"],["は"],["わたし"],["が"],["イスラエル"],["の"],["人々","ひとびと"],["を"],["エジプト"],["の"],["国","くに"],["から"],["導き出した","みちびきだした"],["とき"],["、"],["彼","かれ"],["ら"],["を"],["仮庵","かりいお"],["に"],["住まわせた","すまわせた"],["事","こと"],["を"],["、"],["あなた"],["がた"],["の"],["代々","よよ"],["の"],["子孫","しそん"],["に"],["知らせる","しらせる"],["ため"],["で"],["ある"],["。"],["わたし"],["は"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["で"],["ある"],["』"],["」"],["。"]]},{"verse":44,"text":"モーセは主,しゅの定,さだめの祭,まつりをイスラエルの人々,ひとびとに告,つげた。","tok":[["モーセ"],["は"],["主","しゅ"],["の"],["定め","さだめ"],["の"],["祭","まつり"],["を"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["告","つげ"],["た"],["。"]]}]
[{"verse":1,"text":"主,しゅはまたモーセに言,いわれた、「アロンの子,こなる祭司,さいしたちに告,つげて言,いいなさい、『民,たみのうちの死人,しにんのために、身,みを汚,けがす者,ものがあってはならない。","tok":[["主","しゅ"],["は"],["また"],["モーセ"],["に"],["言われた","いわれた"],["、"],["「"],["アロン"],["の"],["子","こ"],["なる"],["祭司","さいし"],["たち"],["に"],["告","つげ"],["て"],["言い","いい"],["なさい"],["、"],["『"],["民","たみ"],["の"],["うち"],["の"],["死人","しにん"],["の"],["ため"],["に"],["、"],["身","み"],["を"],["汚","け"],["がす"],["者","もの"],["が"],["あって"],["は"],["ならない"],["。"]]},{"verse":2,"text":"ただし、近親,きんしんの者,もの、すなわち、父,ちち、母,はは、むすこ、娘,むすめ、兄弟,きょうだいのため、","tok":[["ただし"],["、"],["近親","きんしん"],["の"],["者","もの"],["、"],["すなわち"],["、"],["父","ちち"],["、"],["母","はは"],["、"],["むすこ"],["、"],["娘","むすめ"],["、"],["兄弟","きょうだい"],["の"],["ため"],["、"]]},{"verse":3,"text":"また彼,かれの近親,きんしんで、まだ夫,おっとのない処女,しょじょなる姉妹,しまいのためには、その身,みを汚,けがしてもよい。","tok":[["また"],["彼","かれ"],["の"],["近親","きんしん"],["で"],["、"],["まだ"],["夫","おっと"],["の"],["ない"],["処女","しょじょ"],["なる"],["姉妹","しまい"],["の"],["ため"],["に"],["は"],["、"],["その"],["身","み"],["を"],["汚","け"],["がして"],["も"],["よい"],["。"]]},{"verse":4,"text":"しかし、夫,おっとにとついだ姉妹,しまいのためには、身,みを汚,けがしてはならない。","tok":[["しかし"],["、"],["夫","おっと"],["に"],["とついだ"],["姉妹","しまい"],["の"],["ため"],["に"],["は"],["、"],["身","み"],["を"],["汚","け"],["がして"],["は"],["ならない"],["。"]]},{"verse":5,"text":"彼,かれらは頭,あたまの頂,いただきをそってはならない。ひげの両端,りょうたんをそり落,おとしてはならない。また身,みに傷,きずをつけてはならない。","tok":[["彼","かれ"],["ら"],["は"],["頭","あたま"],["の"],["頂","いただき"],["を"],["そって"],["は"],["ならない"],["。"],["ひげ"],["の"],["両端","りょうたん"],["を"],["そり落として","そりおとして"],["は"],["ならない"],["。"],["また"],["身","み"],["に"],["傷","きず"],["を"],["つけて"],["は"],["ならない"],["。"]]},{"verse":6,"text":"彼,かれらは神,かみに対,たいして聖,せいでなければならない。また神,かみの名,なを汚,けがしてはならない。彼,かれらは主,しゅの火祭,かさい、すなわち、神,かみの食物,しょくもつをささげる者,ものであるから、聖,せいでなければならない。","tok":[["彼","かれ"],["ら"],["は"],["神","かみ"],["に対して","にたいして"],["聖","せい"],["で"],["なければ"],["ならない"],["。"],["また"],["神","かみ"],["の"],["名","な"],["を"],["汚","け"],["がして"],["は"],["ならない"],["。"],["彼","かれ"],["ら"],["は"],["主","しゅ"],["の"],["火祭","か"],["さい"],["、"],["すなわち"],["、"],["神","かみ"],["の"],["食物","しょくもつ"],["を"],["ささげる"],["者","もの"],["で"],["ある"],["から"],["、"],["聖","せい"],["で"],["なければ"],["ならない"],["。"]]},{"verse":7,"text":"彼,かれらは遊女,ゆうじょや汚,けがれた女,おんなをめとってはならない。また夫,おっとに出,だされた女,おんなをめとってはならない。祭司,さいしは神,かみに対,たいして聖,せいなる者,ものだからである。","tok":[["彼","かれ"],["ら"],["は"],["遊女","ゆうじょ"],["や"],["汚","け"],["がれ"],["た"],["女","おんな"],["を"],["めとって"],["は"],["ならない"],["。"],["また"],["夫","おっと"],["に"],["出された","だされた"],["女","おんな"],["を"],["めとって"],["は"],["ならない"],["。"],["祭司","さいし"],["は"],["神","かみ"],["に対して","にたいして"],["聖","せい"],["なる"],["者","もの"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":8,"text":"あなたは彼,かれを聖,せいとしなければならない。彼,かれはあなたの神,かみの食物,しょくもつをささげる者,ものだからである。彼,かれはあなたにとって聖,せいなる者,ものでなければならない。あなたがたを聖,せいとする主,しゅ、すなわち、わたしは聖,せいなる者,ものだからである。","tok":[["あなた"],["は"],["彼","かれ"],["を"],["聖","せい"],["と"],["しなければ"],["ならない"],["。"],["彼","かれ"],["は"],["あなた"],["の"],["神","かみ"],["の"],["食物","しょくもつ"],["を"],["ささげる"],["者","もの"],["だ"],["から"],["で"],["ある"],["。"],["彼","かれ"],["は"],["あなた"],["にとって"],["聖","せい"],["なる"],["者","もの"],["で"],["なければ"],["ならない"],["。"],["あなた"],["がた"],["を"],["聖","せい"],["と"],["する"],["主","しゅ"],["、"],["すなわち"],["、"],["わたし"],["は"],["聖","せい"],["なる"],["者","もの"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":9,"text":"祭司,さいしの娘,むすめである者,ものが、淫行,いんこうをなして、その身,みを汚,けがすならば、その父,ちちを汚,けがすのであるから、彼女,かのじょを火,ひで焼,やかなければならない。","tok":[["祭司","さいし"],["の"],["娘","むすめ"],["で"],["ある"],["者","もの"],["が"],["、"],["淫行","いんこう"],["を"],["なして"],["、"],["その"],["身","み"],["を"],["汚","け"],["がすならば"],["、"],["その"],["父","ちち"],["を"],["汚す","けがす"],["ので"],["ある"],["から"],["、"],["彼女","かのじょ"],["を"],["火","ひ"],["で"],["焼かなければ","やかなければ"],["ならない"],["。"]]},{"verse":10,"text":"その兄弟,きょうだいのうち、頭,あたまに注,そそぎ油,あぶらを注,そそがれ、職,しょくに任,にんぜられて、その衣服,いふくをつけ、大,だい祭司,さいしとなった者,ものは、その髪,かみの毛,けを乱,みだしてはならない。またその衣服,いふくを裂,さいてはならない。","tok":[["その"],["兄弟","きょうだい"],["の"],["うち"],["、"],["頭","あたま"],["に"],["注ぎ","そそぎ"],["油","あぶら"],["を"],["注がれ","そそがれ"],["、"],["職","しょく"],["に"],["任ぜられて","にんぜられて"],["、"],["その"],["衣服","いふく"],["を"],["つけ"],["、"],["大","だい"],["祭司","さいし"],["と"],["なった"],["者","もの"],["は"],["、"],["その"],["髪の毛","かみのけ"],["を"],["乱して","みだして"],["は"],["ならない"],["。"],["また"],["その"],["衣服","いふく"],["を"],["裂いて","さいて"],["は"],["ならない"],["。"]]},{"verse":11,"text":"死人,しにんのところに、はいってはならない。また父,ちちのためにも母,ははのためにも身,みを汚,けがしてはならない。","tok":[["死人","しにん"],["の"],["ところ"],["に"],["、"],["はいって"],["は"],["ならない"],["。"],["また"],["父","ちち"],["の"],["ため"],["に"],["も"],["母","はは"],["の"],["ため"],["に"],["も"],["身","み"],["を"],["汚","け"],["がして"],["は"],["ならない"],["。"]]},{"verse":12,"text":"また聖所,せいじょから出,でてはならない。神,かみの聖所,せいじょを汚,けがしてはならない。その神,かみの注,そそぎ油,あぶらによる聖別,せいべつが、彼,かれの上,うえにあるからである。わたしは主,しゅである。","tok":[["また"],["聖","せい"],["所","しょ"],["ら"],["出て","でて"],["は"],["ならない"],["。"],["神","かみ"],["の"],["聖","せい"],["所","しょ"],["を"],["汚","け"],["がして"],["は"],["ならない"],["。"],["その"],["神","かみ"],["の"],["注ぎ","そそぎ"],["油","あぶら"],["に"],["よる"],["聖別","せいべつ"],["が"],["、"],["彼","かれ"],["の"],["上","うえ"],["に"],["ある"],["から"],["で"],["ある"],["。"],["わたし"],["は"],["主","しゅ"],["で"],["ある"],["。"]]},{"verse":13,"text":"彼,かれは処女,しょじょを妻,つまにめとらなければならない。","tok":[["彼","かれ"],["は"],["処女","しょじょ"],["を"],["妻","つま"],["に"],["めとらなければ"],["ならない"],["。"]]},{"verse":14,"text":"寡婦,かふ、出,だされた女,おんな、汚,けがれた女,おんな、遊女,ゆうじょなどをめとってはならない。ただ、自分,じぶんの民,たみのうちの処女,しょじょを、妻,つまにめとらなければならない。","tok":[["寡婦","かふ"],["、"],["出された","だされた"],["女","おんな"],["、"],["汚","け"],["がれ"],["た"],["女","おんな"],["、"],["遊女","ゆうじょ"],["など"],["を"],["めとって"],["は"],["ならない"],["。"],["ただ"],["、"],["自分","じぶん"],["の"],["民","たみ"],["の"],["うち"],["の"],["処女","しょじょ"],["を"],["、"],["妻","つま"],["に"],["めとらなければ"],["ならない"],["。"]]},{"verse":15,"text":"そうすれば、彼,かれは民,たみのうちに、自分,じぶんの子孫,しそんを汚,けがすことはない。わたしは彼,かれを聖別,せいべつする主,しゅだからである』」。","tok":[["そう"],["すれば"],["、"],["彼","かれ"],["は"],["民","たみ"],["の"],["うち"],["に"],["、"],["自分","じぶん"],["の"],["子孫","しそん"],["を"],["汚す","けがす"],["こと"],["は"],["ない"],["。"],["わたし"],["は"],["彼","かれ"],["を"],["聖別","せいべつ"],["する"],["主らで","しゅだからで"],["ある"],["』"],["」"],["。"]]},{"verse":16,"text":"主,しゅはまたモーセに言,いわれた、","tok":[["主","しゅ"],["は"],["また"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":17,"text":"「アロンに告,つげて言,いいなさい、『あなたの代々,よよの子孫,しそんで、だれでも身,みにきずのある者,ものは近寄,ちかよって、神,かみの食物,しょくもつをささげてはならない。","tok":[["「"],["アロン"],["に"],["告","つげ"],["て"],["言い","いい"],["なさい"],["、"],["『"],["あなた"],["の"],["代々","よよ"],["の"],["子孫","しそん"],["で"],["、"],["だれ"],["で"],["も"],["身","み"],["に"],["きず"],["の"],["ある"],["者","もの"],["は"],["近寄って","ちかよって"],["、"],["神","かみ"],["の"],["食物","しょくもつ"],["を"],["ささげて"],["は"],["ならない"],["。"]]},{"verse":18,"text":"すべて、その身,みにきずのある者,ものは近寄,ちかよってはならない。すなわち、目,めしい、足,あしなえ、鼻,はなのかけた者,もの、手足,てあしの不,ふつりあいの者,もの、","tok":[["すべて"],["、"],["その"],["身","み"],["に"],["きず"],["の"],["ある"],["者","もの"],["は"],["近寄って","ちかよって"],["は"],["ならない"],["。"],["すなわち"],["、"],["目","め"],["しい"],["、"],["足","あし"],["なえ"],["、"],["鼻","はな"],["の"],["かけた"],["者","もの"],["、"],["手足","てあし"],["の"],["不","ふ"],["つりあい"],["の"],["者","もの"],["、"]]},{"verse":19,"text":"足,あしの折,おれた者,もの、手,ての折,おれた者,もの、","tok":[["足","あし"],["の"],["折れた","おれた"],["者","もの"],["、"],["手","て"],["の"],["折れた","おれた"],["者","もの"],["、"]]},{"verse":20,"text":"せむし、こびと、目,めにきずのある者,もの、かいせんの者,もの、かさぶたのある者,もの、こうがんのつぶれた者,ものなどである。","tok":[["せむし"],["、"],["こび"],["と"],["、"],["目","め"],["に"],["きず"],["の"],["ある"],["者","もの"],["、"],["かい"],["せん"],["の"],["者","もの"],["、"],["かさぶた"],["の"],["ある"],["者","もの"],["、"],["こう"],["がん"],["の"],["つぶれた"],["者","もの"],["など"],["で"],["ある"],["。"]]},{"verse":21,"text":"すべて祭司,さいしアロンの子孫,しそんのうち、身,みにきずのある者,ものは近寄,ちかよって、主,しゅの火祭,かさいをささげてはならない。彼,かれは身,みにきずがあるから、神,かみの食物,しょくもつをささげるために、近寄,ちかよってはならない。","tok":[["すべて"],["祭司","さいし"],["アロン"],["の"],["子孫","しそん"],["の"],["うち"],["、"],["身","み"],["に"],["きず"],["の"],["ある"],["者","もの"],["は"],["近寄って","ちかよって"],["、"],["主","しゅ"],["の"],["火祭","かさい"],["を"],["ささげて"],["は"],["ならない"],["。"],["彼","かれ"],["は"],["身","み"],["に"],["きず"],["が"],["ある"],["から"],["、"],["神","かみ"],["の"],["食物","しょくもつ"],["を"],["ささげる"],["ため"],["に"],["、"],["近寄って","ちかよって"],["は"],["ならない"],["。"]]},{"verse":22,"text":"彼,かれは神,かみの食物,しょくもつの聖,せいなる物,ものも、最,もっとも聖,せいなる物,ものも食,たべることができる。","tok":[["彼","かれ"],["は"],["神","かみ"],["の"],["食物","しょくもつ"],["の"],["聖","せい"],["なる"],["物","もの"],["も"],["、"],["最も","もっとも"],["聖","せい"],["なる"],["物","もの"],["も"],["食べる","たべる"],["こと"],["が"],["できる"],["。"]]},{"verse":23,"text":"ただし、垂幕,たれまくに近,ちかづいてはならない。また祭壇,さいだんに近寄,ちかよってはならない。身,みにきずがあるからである。彼,かれはわたしの聖所,せいじょを汚,けがしてはならない。わたしはそれを聖別,せいべつする主,しゅである』」。","tok":[["ただし"],["、"],["垂幕","たれまく"],["に"],["近づいて","ちかづいて"],["は"],["ならない"],["。"],["また"],["祭壇","さいだん"],["に"],["近寄って","ちかよって"],["は"],["ならない"],["。"],["身","み"],["に"],["きず"],["が"],["ある"],["から"],["で"],["ある"],["。"],["彼","かれ"],["は"],["わたし"],["の"],["聖","せい"],["所","しょ"],["を"],["汚","け"],["がして"],["は"],["ならない"],["。"],["わたし"],["は"],["それ"],["を"],["聖別","せいべつ"],["する"],["主","しゅ"],["で"],["ある"],["』"],["」"],["。"]]},{"verse":24,"text":"モーセはこれをアロンとその子,こら及,およびイスラエルのすべての人々,ひとびとに告,つげた。","tok":[["モーセ"],["は"],["これ"],["を"],["アロン"],["と"],["その"],["子","こ"],["ら"],["及","および"],["イスラエル"],["の"],["すべて"],["の"],["人々","ひとびと"],["に"],["告","つげ"],["た"],["。"]]}]
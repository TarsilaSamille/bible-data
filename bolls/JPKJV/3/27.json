[{"verse":1,"text":"主,しゅはモーセに言,いわれた、","tok":[["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":2,"text":"「イスラエルの人々,ひとびとに言,いいなさい、『人,ひとがあなたの値,ね積,づもりに従,したがって主,しゅに身,みをささげる誓願,せいがんをする時,ときは、","tok":[["「"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["言い","いい"],["なさい"],["、"],["『"],["人","ひと"],["が"],["あなた"],["の"],["値","ね"],["積","づもり"],["に"],["従って","したがって"],["主に","しゅに"],["身","み"],["を"],["ささげる"],["誓願","せいがん"],["を"],["する"],["時","とき"],["は"],["、"]]},{"verse":3,"text":"あなたの値,ね積,づもりは、二十歳,さいから六十歳,さいまでの男,おとこには、その値,ね積,づもりを聖所,せいじょのシケルに従,したがって銀,ぎん五十シケルとし、","tok":[["あなた"],["の"],["値","ね"],["積","づもり"],["は"],["、"],["二十歳","さいか"],["ら"],["六十歳","さい"],["まで"],["の"],["男","おとこ"],["に"],["は"],["、"],["その"],["値","ね"],["積","づもり"],["を"],["聖","せい"],["所","しょ"],["の"],["シケル"],["に"],["従って","したがって"],["銀","ぎん"],["五十","ごじゅう"],["シケル"],["と"],["し"],["、"]]},{"verse":4,"text":"女,おんなには、その値,ね積,づもりは三十シケルとしなければならない。","tok":[["女","おんな"],["に"],["は"],["、"],["その"],["値","ね"],["積","づもり"],["は"],["三十","さんじゅう"],["シケル"],["と"],["しなければ"],["ならない"],["。"]]},{"verse":5,"text":"また五歳,さいから二十歳,さいまでは、男,おとこにはその値,ね積,づもりを二十シケルとし、女,おんなには十シケルとしなければならない。","tok":[["また"],["五歳","さいか"],["ら"],["二十歳","さいま"],["で"],["は"],["、"],["男","おとこ"],["に"],["は"],["その"],["値","ね"],["積","づもり"],["を"],["二十","にじゅう"],["シケル"],["と"],["し"],["、"],["女","おんな"],["に"],["は"],["十","じゅう"],["シケル"],["と"],["しなければ"],["ならない"],["。"]]},{"verse":6,"text":"一か月,げつから五歳,さいまでは、男,おとこにはその値,ね積,づもりを銀,ぎん五シケルとし、女,おんなにはその値,ね積,づもりを銀,ぎん三シケルとしなければならない。","tok":[["一","いち"],["か月","かげつ"],["から"],["五歳","さいま"],["で"],["は"],["、"],["男","おとこ"],["に"],["は"],["その"],["値","ね"],["積","づもり"],["を"],["銀","ぎん"],["五","ご"],["シケル"],["と"],["し"],["、"],["女","おんな"],["に"],["は"],["その"],["値","ね"],["積","づもり"],["を"],["銀","ぎん"],["三","さん"],["シケル"],["と"],["しなければ"],["ならない"],["。"]]},{"verse":7,"text":"また六十歳,さい以上,いじょうは、男,おとこにはその値,ね積,づもりを十五シケルとし、女,おんなには十シケルとしなければならない。","tok":[["また"],["六十歳","さ"],["い"],["以上","いじょう"],["は"],["、"],["男","おとこ"],["に"],["は"],["その"],["値","ね"],["積","づもり"],["を"],["十五","じゅうご"],["シケル"],["と"],["し"],["、"],["女","おんな"],["に"],["は"],["十","じゅう"],["シケル"],["と"],["しなければ"],["ならない"],["。"]]},{"verse":8,"text":"もしその人,ひとが貧,まずしくて、あなたの値,ね積,づもりに応,おうじることができないならば、祭司,さいしの前,まえに立,たち、祭司,さいしの値,ね積,づもりを受,うけなければならない。祭司,さいしはその誓願,せいがん者,しゃの力,ちからに従,したがって値,ね積,づもらなければならない。","tok":[["もし"],["その"],["人","ひと"],["が"],["貧しくて","まずしくて"],["、"],["あなた"],["の"],["値","ね"],["積","づもり"],["に"],["応じる","おうじる"],["こと"],["が"],["できないならば"],["、"],["祭司","さいし"],["の"],["前","まえ"],["に"],["立ち","たち"],["、"],["祭司","さいし"],["の"],["値","ね"],["積","づもり"],["を"],["受なければ","うけなければ"],["ならない"],["。"],["祭司","さいし"],["は"],["その"],["誓願者","せいがんしゃ"],["の"],["力","ちから"],["に"],["従って","したがって"],["値","ね"],["積らなければ","づもらなければ"],["ならない"],["。"]]},{"verse":9,"text":"主,しゅに供,そなえ物,ものとすることができる家畜,かちくで、人,ひとが主,しゅにささげるものはすべて聖,せいなる物,ものとなる。","tok":[["主に","しゅに"],["供え物","そなえもの"],["と"],["する"],["こと"],["が"],["できる"],["家畜","かちく"],["で"],["、"],["人","ひと"],["が"],["主に","しゅに"],["ささげる"],["もの"],["は"],["すべて"],["聖","せい"],["なる"],["物","もの"],["と"],["なる"],["。"]]},{"verse":10,"text":"ほかのものをそれに代用,だいようしてはならない。良,よい物,ものを悪,わるい物,ものに、悪,わるい物,ものを良,よい物,ものに取,とり換,かえてはならない。もし家畜,かちくと家畜,かちくとを取,とり換,かえるならば、その物,ものも、それと取,とり換,かえた物,ものも共,ともに聖,せいなる物,ものとなるであろう。","tok":[["ほか"],["の"],["もの"],["を"],["それ"],["に"],["代用","だいよう"],["して"],["は"],["ならない"],["。"],["良い","よい"],["物","もの"],["を"],["悪い","わるい"],["物","もの"],["に"],["、"],["悪い","わるい"],["物","もの"],["を"],["良い","よい"],["物","もの"],["に"],["取換","とりかえ"],["ては"],["ならない"],["。"],["もし"],["家畜","かちく"],["と"],["家畜","かちく"],["と"],["を"],["取換","とりかえ"],["るならば"],["、"],["その"],["物","もの"],["も"],["、"],["それ"],["と"],["取換","とりかえ"],["た"],["物","もの"],["も"],["共","とも"],["に"],["聖","せい"],["なる"],["物","もの"],["と"],["なるで"],["あろう"],["。"]]},{"verse":11,"text":"もしそれが汚,けがれた家畜,かちくで、主,しゅに供,そなえ物,ものとしてささげられないものであるならば、その人,ひとはその家畜,かちくを祭司,さいしの前,まえに引,ひいてこなければならない。","tok":[["もし"],["それ"],["が"],["汚","け"],["がれ"],["た"],["家畜","かちく"],["で"],["、"],["主に","しゅに"],["供え物","そなえもの"],["として"],["ささげられない"],["もの"],["で"],["あるならば"],["、"],["その"],["人","ひと"],["は"],["その"],["家畜","かちく"],["を"],["祭司","さいし"],["の"],["前","まえ"],["に"],["引いて","ひいて"],["こなければ"],["ならない"],["。"]]},{"verse":12,"text":"祭司,さいしはその良,よい悪,わるいに従,したがって、それを値,ね積,づもらなければならない。それは祭司,さいしが値積,ねづもるとおりになるであろう。","tok":[["祭司","さいし"],["は"],["その"],["良い","よい"],["悪い","わるい"],["に"],["従って","したがって"],["、"],["それ"],["を"],["値","ね"],["積らなければ","づもらなければ"],["ならない"],["。"],["それ"],["は"],["祭司","さいし"],["が"],["値","あたい"],["積","せき"],["に"],["なるで"],["あろう"],["。"]]},{"verse":13,"text":"もしその人,ひとが、それをあがなおうとするならば、その値,ね積,づもりにその五分,ぶんの一を加,くわえなければならない。","tok":[["もし"],["その"],["人","ひと"],["が"],["、"],["それ"],["を"],["あがなおう"],["と"],["するならば"],["、"],["その"],["値","ね"],["積","づもり"],["に"],["その"],["五分","ぶん"],["の"],["一","いち"],["を"],["加えなければ","くわえなければ"],["ならない"],["。"]]},{"verse":14,"text":"もし人,ひとが自分,じぶんの家,いえを主,しゅに聖,せいなる物,ものとしてささげるときは、祭司,さいしはその良,よい悪,わるいに従,したがって、それを値,ね積,づもらなければならない。それは祭司,さいしが値,ね積,づもったとおりになるであろう。","tok":[["もし"],["人","ひと"],["が"],["自分","じぶん"],["の"],["家","いえ"],["を"],["主に","しゅに"],["聖","せい"],["なる"],["物","もの"],["として"],["ささげる"],["とき"],["は"],["、"],["祭司","さいし"],["は"],["その"],["良い","よい"],["悪い","わるい"],["に"],["従って","したがって"],["、"],["それ"],["を"],["値","ね"],["積らなければ","づもらなければ"],["ならない"],["。"],["それ"],["は"],["祭司","さいし"],["が"],["値","ね"],["積もった","づもった"],["とおり"],["に"],["なるで"],["あろう"],["。"]]},{"verse":15,"text":"もしその家,いえをささげる人,ひとが、それをあがなおうとするならば、その値,ね積,づもりの金,かねに、その五分,ぶんの一を加,くわえなければならない。そうすれば、それは彼,かれのものとなるであろう。","tok":[["もし"],["その"],["家","いえ"],["を"],["ささげる"],["人","ひと"],["が"],["、"],["それ"],["を"],["あがなおう"],["と"],["するならば"],["、"],["その"],["値","ね"],["積","づもり"],["の"],["金","かね"],["に"],["、"],["その"],["五分","ぶん"],["の"],["一","いち"],["を"],["加えなければ","くわえなければ"],["ならない"],["。"],["そう"],["すれば"],["、"],["それ"],["は"],["彼","かれ"],["の"],["もの"],["と"],["なるで"],["あろう"],["。"]]},{"verse":16,"text":"もし人,ひとが相続,そうぞくした畑,はたけの一部,いちぶを主,しゅにささげるときは、あなたはそこにまく種,たねの多少,たしょうに応,おうじて、値,ね積,づもらなければならない。すなわち、大麦,おおむぎ一ホメルの種,たねを銀,ぎん五十シケルに値,ね積,づもらなければならない。","tok":[["もし"],["人","ひと"],["が"],["相続","そうぞく"],["した"],["畑","はたけ"],["の"],["一部","いちぶ"],["を"],["主に","しゅに"],["ささげる"],["とき"],["は"],["、"],["あなた"],["は"],["そこ"],["に"],["ま"],["く"],["種","たね"],["の"],["多少","たしょう"],["に"],["応じて","おうじて"],["、"],["値","ね"],["積らなければ","づもらなければ"],["ならない"],["。"],["すなわち"],["、"],["大麦","おおむぎ"],["一","いち"],["ホメル"],["の"],["種","たね"],["を"],["銀","ぎん"],["五十","ごじゅう"],["シケル"],["に"],["値","ね"],["積らなければ","づもらなければ"],["ならない"],["。"]]},{"verse":17,"text":"もしその畑,はたけをヨベルの年,としからささげるのであれば、その価,あたいはあなたの値,ね積,づもりのとおりになるであろう。","tok":[["もし"],["その"],["畑","はたけ"],["を"],["ヨベル"],["の"],["年","とし"],["から"],["ささげる"],["ので"],["あれば"],["、"],["その"],["価","あたい"],["は"],["あなた"],["の"],["値","ね"],["積","づもり"],["の"],["とおり"],["に"],["なるで"],["あろう"],["。"]]},{"verse":18,"text":"もしその畑,はたけをヨベルの年,としの後,のちにささげるのであれば、祭司,さいしはヨベルの年,としまでに残,のこっている年,としの数,かずに従,したがってその金,かねを数,かぞえ、それをあなたの値,ね積,づもりからさし引,ひかなければならない。","tok":[["もし"],["その"],["畑","はたけ"],["を"],["ヨベル"],["の"],["年","とし"],["の"],["後","のち"],["に"],["ささげる"],["ので"],["あれば"],["、"],["祭司","さいし"],["は"],["ヨベル"],["の"],["年","とし"],["まで"],["に"],["残って","のこって"],["いる"],["年","とし"],["の"],["数","かず"],["に"],["従って","したがって"],["その"],["金","かね"],["を"],["数え","かぞえ"],["、"],["それ"],["を"],["あなた"],["の"],["値","ね"],["積らさし","づもりからさし"],["引かなければ","ひかなければ"],["ならない"],["。"]]},{"verse":19,"text":"もしまた、その畑,はたけをささげる人,ひとが、それをあがなおうとするならば、あなたの値,ね積,づもりの金,かねにその五分,ぶんの一を加,くわえなければならない。そうすれば、それは彼,かれのものと決,きまるであろう。","tok":[["もし"],["また"],["、"],["その"],["畑","はたけ"],["を"],["ささげる"],["人","ひと"],["が"],["、"],["それ"],["を"],["あがなおう"],["と"],["するならば"],["、"],["あなた"],["の"],["値","ね"],["積","づもり"],["の"],["金","かね"],["に"],["その"],["五分","ぶん"],["の"],["一","いち"],["を"],["加えなければ","くわえなければ"],["ならない"],["。"],["そう"],["すれば"],["、"],["それ"],["は"],["彼","かれ"],["の"],["もの"],["と"],["決まるで","きまるで"],["あろう"],["。"]]},{"verse":20,"text":"しかし、もしその畑,はたけをあがなわず、またそれを他,たの人,ひとに売,うるならば、それはもはやあがなうことができないであろう。","tok":[["しかし"],["、"],["もし"],["その"],["畑","はたけ"],["を"],["あがなわず"],["、"],["また"],["それ"],["を"],["他","た"],["の"],["人","ひと"],["に"],["売るならば","うるならば"],["、"],["それ"],["は"],["もはや"],["あがなう"],["こと"],["が"],["できないで"],["あろう"],["。"]]},{"verse":21,"text":"その畑,はたけは、ヨベルの年,としになって期限,きげんが切,きれるならば、奉納,ほうのうの畑,はたけと同,おなじく、主,しゅの聖,せいなる物,ものとなり、祭司,さいしの所有,しょゆうとなるであろう。","tok":[["その"],["畑","はたけ"],["は"],["、"],["ヨベル"],["の"],["年","とし"],["に"],["なって"],["期限","きげん"],["が"],["切れるならば","きれるならば"],["、"],["奉納","ほうのう"],["の"],["畑","はたけ"],["と"],["同じく","おなじく"],["、"],["主","しゅ"],["の"],["聖","せい"],["なる"],["物","もの"],["と"],["なり"],["、"],["祭司","さいし"],["の"],["所有","しょゆう"],["と"],["なるで"],["あろう"],["。"]]},{"verse":22,"text":"もしまた相続,そうぞくした畑,はたけの一部,いちぶでなく、買,かった畑,はたけを主,しゅにささげる時,ときは、","tok":[["もし"],["また"],["相続","そうぞく"],["した"],["畑","はたけ"],["の"],["一部","いちぶ"],["で"],["なく"],["、"],["買った","かった"],["畑","はたけ"],["を"],["主に","しゅに"],["ささげる"],["時","とき"],["は"],["、"]]},{"verse":23,"text":"祭司,さいしは値,ね積,づもりしてヨベルの年,としまでの金,かねを数,かぞえなければならない。その人,ひとはその値,ね積,づもりの金,かねをその日,ひに主,しゅにささげて、聖,せいなる物,ものとしなければならない。","tok":[["祭司","さいし"],["は"],["値","ね"],["積もり","づもり"],["して"],["ヨベル"],["の"],["年","とし"],["まで"],["の"],["金","かね"],["を"],["数えなければ","かぞえなければ"],["ならない"],["。"],["その"],["人","ひと"],["は"],["その"],["値","ね"],["積","づもり"],["の"],["金","かね"],["を"],["その"],["日","ひ"],["に"],["主に","しゅに"],["ささげて"],["、"],["聖","せい"],["なる"],["物","もの"],["と"],["しなければ"],["ならない"],["。"]]},{"verse":24,"text":"ヨベルの年,としにその畑,はたけは売,うり主,ぬしであるその地,ちの相続,そうぞく者,しゃに返,かえるであろう。","tok":[["ヨベル"],["の"],["年","とし"],["に"],["その"],["畑","はたけ"],["は"],["売主","うりぬし"],["で"],["ある"],["その"],["地","ち"],["の"],["相続者","そうぞくしゃ"],["に"],["返るで","かえるで"],["あろう"],["。"]]},{"verse":25,"text":"すべてあなたの値,ね積,づもりは聖所,せいじょのシケルによってしなければならない。二十ゲラを一シケルとする。","tok":[["すべて"],["あなた"],["の"],["値","ね"],["積","づもり"],["は"],["聖","せい"],["所","しょ"],["の"],["シケル"],["によって"],["しなければ"],["ならない"],["。"],["二十","にじゅう"],["ゲラ"],["を"],["一","いち"],["シケル"],["と"],["する"],["。"]]},{"verse":26,"text":"しかし、家畜,かちくのういごは、ういごとしてすでに主,しゅのものだから、だれもこれをささげてはならない。牛,うしでも羊,ひつじでも、それは主,しゅのものである。","tok":[["しかし"],["、"],["家畜","かちく"],["の"],["うい"],["ご"],["は"],["、"],["うい"],["ご"],["として"],["すでに"],["主","しゅ"],["の"],["もの"],["だ"],["から"],["、"],["だれ"],["も"],["これ"],["を"],["ささげて"],["は"],["ならない"],["。"],["牛","うし"],["で"],["も"],["羊","ひつじ"],["で"],["も"],["、"],["それ"],["は"],["主","しゅ"],["の"],["もの"],["で"],["ある"],["。"]]},{"verse":27,"text":"もし汚,けがれた家畜,かちくであるならば、あなたの値,ね積,づもりにその五分,ぶんの一を加,くわえて、その人,ひとはこれをあがなわなければならない。もしあがなわないならば、それを値,ね積,づもりに従,したがって売,うらなければならない。","tok":[["もし"],["汚","け"],["がれ"],["た"],["家畜","かちく"],["で"],["あるならば"],["、"],["あなた"],["の"],["値","ね"],["積","づもり"],["に"],["その"],["五分","ぶん"],["の"],["一","いち"],["を"],["加えて","くわえて"],["、"],["その"],["人","ひと"],["は"],["これ"],["を"],["あがなわなければ"],["ならない"],["。"],["もし"],["あがなわないならば"],["、"],["それ"],["を"],["値","ね"],["積","づもり"],["に"],["従って","したがって"],["売らなければ","うらなければ"],["ならない"],["。"]]},{"verse":28,"text":"ただし、人,ひとが自分,じぶんの持,もっているもののうちから奉納物,ほうのうぶつとして主,しゅにささげたものは、人,ひとであっても、家畜,かちくであっても、また相続,そうぞくの畑,はたけであっても、いっさいこれを売,うってはならない。またあがなってはならない。奉納物,ほうのうぶつはすべて主,しゅに属,ぞくするいと聖,せいなる物,ものである。","tok":[["ただし"],["、"],["人","ひと"],["が"],["自分","じぶん"],["の"],["持って","もって"],["いる"],["もの"],["の"],["うち"],["から"],["奉納物","ほうのうぶつ"],["として"],["主に","しゅに"],["ささげた"],["もの"],["は"],["、"],["人","ひと"],["で"],["あって"],["も"],["、"],["家畜","かちく"],["で"],["あって"],["も"],["、"],["また"],["相続","そうぞく"],["の"],["畑","はたけ"],["で"],["あって"],["も"],["、"],["いっさい"],["これ"],["を"],["売って","うって"],["は"],["ならない"],["。"],["また"],["あがなって"],["は"],["ならない"],["。"],["奉納物","ほうのうぶつ"],["は"],["すべて"],["主","しゅ"],["に"],["属する","ぞくする"],["いと"],["聖","せい"],["なる"],["物","もの"],["で"],["ある"],["。"]]},{"verse":29,"text":"またすべて人,ひとのうちから奉納物,ほうのうぶつとしてささげられた人,ひとは、あがなってはならない。彼,かれは必,かならず殺,ころされなければならない。","tok":[["また"],["すべて"],["人","ひと"],["の"],["うち"],["から"],["奉納物","ほうのうぶつ"],["として"],["ささげられた"],["人","ひと"],["は"],["、"],["あがなって"],["は"],["ならない"],["。"],["彼","かれ"],["は"],["必","かならず"],["殺ろされなければ","ころされなければ"],["ならない"],["。"]]},{"verse":30,"text":"地,ちの十分,ぶんの一は地,ちの産物,さんぶつであれ、木,きの実,みであれ、すべて主,しゅのものであって、主,しゅに聖,せいなる物,ものである。","tok":[["地","ち"],["の"],["十分","ぶん"],["の"],["一","いち"],["は"],["地","ち"],["の"],["産物","さんぶつ"],["で"],["あれ"],["、"],["木の実","きのみ"],["で"],["あれ"],["、"],["すべて"],["主","しゅ"],["の"],["もの"],["で"],["あって"],["、"],["主に","しゅに"],["聖","せい"],["なる"],["物","もの"],["で"],["ある"],["。"]]},{"verse":31,"text":"もし人,ひとがその十分,ぶんの一をあがなおうとする時,ときは、それにその五分,ぶんの一を加,くわえなければならない。","tok":[["もし"],["人","ひと"],["が"],["その"],["十分","ぶん"],["の"],["一","いち"],["を"],["あがなおう"],["と"],["する"],["時","とき"],["は"],["、"],["それ"],["に"],["その"],["五分","ぶん"],["の"],["一","いち"],["を"],["加えなければ","くわえなければ"],["ならない"],["。"]]},{"verse":32,"text":"牛,うしまたは羊,ひつじの十分,ぶんの一については、すべて牧者,ぼくしゃのつえの下,したを十番目,ばんめに通,とおるものは、主,しゅに聖,せいなる物,ものである。","tok":[["牛","うし"],["また"],["は"],["羊","ひつじ"],["の"],["十分","ぶん"],["の"],["一","いち"],["について"],["は"],["、"],["すべて"],["牧者","ぼくしゃ"],["の"],["つえ"],["の"],["下","した"],["を"],["十番目","ばんめ"],["に"],["通る","とおる"],["もの"],["は"],["、"],["主に","しゅに"],["聖","せい"],["なる"],["物","もの"],["で"],["ある"],["。"]]},{"verse":33,"text":"その良,よい悪,わるいを問,とうてはならない。またそれを取,とり換,かえてはならない。もし取,とり換,かえたならば、それと、その取,とり換,かえたものとは、共,ともに聖,せいなる物,ものとなるであろう。それをあがなうことはできない』」。","tok":[["その"],["良い","よい"],["悪い","わるい"],["を"],["問うて","とうて"],["は"],["ならない"],["。"],["また"],["それ"],["を"],["取換","とりかえ"],["ては"],["ならない"],["。"],["もし"],["取換","とりかえ"],["たならば"],["、"],["それ"],["と"],["、"],["その"],["取換","とりかえ"],["た"],["もの"],["と"],["は"],["、"],["共","とも"],["に"],["聖","せい"],["なる"],["物","もの"],["と"],["なるで"],["あろう"],["。"],["それ"],["を"],["あがなう"],["こと"],["は"],["できない"],["』"],["」"],["。"]]},{"verse":34,"text":"これらは主,しゅが、シナイ山,さんで、イスラエルの人々,ひとびとのために、モーセに命,めいじられた戒,いましめである。","tok":[["これ"],["ら"],["は"],["主","しゅ"],["が"],["、"],["シナイ"],["山","さん"],["で"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["ため"],["に"],["、"],["モーセ"],["に"],["命じられた","めいじられた"],["戒しめ","いましめ"],["で"],["ある"],["。"]]}]
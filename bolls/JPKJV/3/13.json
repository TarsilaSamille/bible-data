[{"verse":1,"text":"主,しゅはまたモーセとアロンに言,いわれた、","tok":[["主","しゅ"],["は"],["また"],["モーセ"],["と"],["アロン"],["に"],["言われた","いわれた"],["、"]]},{"verse":2,"text":"「人,ひとがその身,みの皮,かわに腫,しゅ、あるいは吹出物,ふきでもの、あるいは光,ひかる所,ところができ、これがその身,みの皮,かわにらい病,びょうの患部,かんぶのようになるならば、その人,ひとを祭司,さいしアロンまたは、祭司,さいしなるアロンの子,こたちのひとりのもとに、連,つれて行,いかなければならない。","tok":[["「"],["人","ひと"],["が"],["その"],["身","み"],["の"],["皮","かわ"],["に"],["腫","しゅ"],["、"],["あるいは"],["吹出物","ふきでもの"],["、"],["あるいは"],["光る","ひかる"],["所","ところ"],["が"],["でき"],["、"],["これ"],["が"],["その"],["身","み"],["の"],["皮","かわ"],["に"],["らい病","らいびょう"],["の"],["患部","かんぶ"],["の"],["よう"],["に"],["なるならば"],["、"],["その"],["人","ひと"],["を"],["祭司","さいし"],["アロン"],["また"],["は"],["、"],["祭司","さいし"],["なる"],["アロン"],["の"],["子","こ"],["たち"],["の"],["ひとり"],["の"],["もと"],["に"],["、"],["連れて","つれて"],["行かなければ","いかなければ"],["ならない"],["。"]]},{"verse":3,"text":"祭司,さいしはその身,みの皮,かわの患部,かんぶを見,み、その患部,かんぶの毛,けがもし白,しろく変,かわり、かつ患部,かんぶが、その身,みの皮,かわよりも深,ふかく見,みえるならば、それはらい病,びょうの患部,かんぶである。祭司,さいしは彼,かれを見,みて、これを汚,けがれた者,ものとしなければならない。","tok":[["祭司","さいし"],["は"],["その"],["身","み"],["の"],["皮","かわ"],["の"],["患部","かんぶ"],["を"],["見","み"],["、"],["その"],["患部","かんぶ"],["の"],["毛","け"],["が"],["もし"],["白く","しろく"],["変わり","かわり"],["、"],["かつ"],["患部","かんぶ"],["が"],["、"],["その"],["身","み"],["の"],["皮","かわ"],["より"],["も"],["深く","ふかく"],["見えるならば","みえるならば"],["、"],["それ"],["は"],["らい病","らいびょう"],["の"],["患部","かんぶ"],["で"],["ある"],["。"],["祭司","さいし"],["は"],["彼","かれ"],["を"],["見て","みて"],["、"],["これ"],["を"],["汚","け"],["がれ"],["た"],["者","もの"],["と"],["しなければ"],["ならない"],["。"]]},{"verse":4,"text":"もしまたその身,みの皮,かわの光,ひかる所,ところが白,しろくて、皮,かわよりも深,ふかく見,みえず、また毛,けも白,しろく変,かわっていないならば、祭司,さいしはその患者,かんじゃを七日,なぬかのあいだ留,とめ置,おかなければならない。","tok":[["もし"],["また"],["その"],["身","み"],["の"],["皮","かわ"],["の"],["光る","ひかる"],["所","ところ"],["が"],["白くて","しろくて"],["、"],["皮","かわ"],["より"],["も"],["深く","ふかく"],["見えず","みえず"],["、"],["また"],["毛","け"],["も"],["白く","しろく"],["変わって","かわって"],["いないならば"],["、"],["祭司","さいし"],["は"],["その"],["患者","かんじゃ"],["を"],["七","しち"],["日","にち"],["の"],["あいだ"],["留置かなければ","とめおかなければ"],["ならない"],["。"]]},{"verse":5,"text":"七日,なぬか目,めに祭司,さいしはこれを見,みて、もし患部,かんぶの様子,ようすに変,かわりがなく、また患部,かんぶが皮,かわに広,ひろがっていないならば、祭司,さいしはその人,ひとをさらに七日,なぬかのあいだ留,とめ置,おかなければならない。","tok":[["七日","な"],["ぬか目","ぬかめ"],["に"],["祭司","さいし"],["は"],["これ"],["を"],["見て","みて"],["、"],["もし"],["患部","かんぶ"],["の"],["様子","ようす"],["に"],["変わり","かわり"],["が"],["なく"],["、"],["また"],["患部","かんぶ"],["が"],["皮","かわ"],["に"],["広がって","ひろがって"],["いないならば"],["、"],["祭司","さいし"],["は"],["その"],["人","ひと"],["を"],["さらに"],["七日","なぬか"],["の"],["あいだ"],["留置かなければ","とめおかなければ"],["ならない"],["。"]]},{"verse":6,"text":"七日,なぬか目,めに祭司,さいしは再,ふたたびその人,ひとを見,みて、患部,かんぶがもし薄,うすらぎ、また患部,かんぶが皮,かわに広,ひろがっていないならば、祭司,さいしはこれを清,きよい者,ものとしなければならない。これは吹出物,ふきでものである。その人,ひとは衣服,いふくを洗,あらわなければならない。そして清,きよくなるであろう。","tok":[["七日","な"],["ぬか目","ぬかめ"],["に"],["祭司","さいし"],["は"],["再び","ふたたび"],["その"],["人","ひと"],["を"],["見て","みて"],["、"],["患部","かんぶ"],["が"],["もし"],["薄らぎ","うすらぎ"],["、"],["また"],["患部","かんぶ"],["が"],["皮","かわ"],["に"],["広がって","ひろがって"],["いないならば"],["、"],["祭司","さいし"],["は"],["これ"],["を"],["清い","きよい"],["者","もの"],["と"],["しなければ"],["ならない"],["。"],["これ"],["は"],["吹出物","ふきでもの"],["で"],["ある"],["。"],["その"],["人","ひと"],["は"],["衣服","いふく"],["を"],["洗わなければ","あらわなければ"],["ならない"],["。"],["そして"],["清く","きよく"],["なるで"],["あろう"],["。"]]},{"verse":7,"text":"しかし、その人,ひとが祭司,さいしに見,みせて清,きよい者,ものとされた後,のちに、その吹出物,ふきでものが皮,かわに広,ひろくひろがるならば、再,ふたたび祭司,さいしにその身,みを見,みせなければならない。","tok":[["しかし"],["、"],["その"],["人","ひと"],["が"],["祭司","さいし"],["に"],["見せて","みせて"],["清い","きよい"],["者","もの"],["と"],["された"],["後","のち"],["に"],["、"],["その"],["吹出","ふきだし"],["物","もの"],["が"],["皮","かわ"],["に"],["広く","ひろく"],["ひろがるならば"],["、"],["再び","ふたたび"],["祭司","さいし"],["に"],["その"],["身","み"],["を"],["見せなければ","みせなければ"],["ならない"],["。"]]},{"verse":8,"text":"祭司,さいしはこれを見,みて、その吹出物,ふきでものが皮,かわに広,ひろがっているならば、祭司,さいしはその人,ひとを汚,けがれた者,ものとしなければならない。これはらい病,びょうである。","tok":[["祭司","さいし"],["は"],["これ"],["を"],["見て","みて"],["、"],["その"],["吹出","ふきだし"],["物","もの"],["が"],["皮","かわ"],["に"],["広がって","ひろがって"],["いるならば"],["、"],["祭司","さいし"],["は"],["その"],["人","ひと"],["を"],["汚","け"],["がれ"],["た"],["者","もの"],["と"],["しなければ"],["ならない"],["。"],["これ"],["は"],["らい病","らいびょう"],["で"],["ある"],["。"]]},{"verse":9,"text":"もし人,ひとにらい病,びょうの患部,かんぶがあるならば、その人,ひとを祭司,さいしのもとに連,つれて行,いかなければならない。","tok":[["もし"],["人","ひと"],["に"],["らい病","らいびょう"],["の"],["患部","かんぶ"],["が"],["あるならば"],["、"],["その"],["人","ひと"],["を"],["祭司","さいし"],["の"],["もと"],["に"],["連れて","つれて"],["行かなければ","いかなければ"],["ならない"],["。"]]},{"verse":10,"text":"祭司,さいしがこれを見,みて、その皮,かわに白,しろい腫,しゅがあり、その毛,けも白,しろく変,かわり、かつその腫,しゅに生,いきた生肉,なまにくが見,みえるならば、","tok":[["祭司","さいし"],["が"],["これ"],["を"],["見て","みて"],["、"],["その"],["皮","かわ"],["に"],["白い","しろい"],["腫","しゅ"],["が"],["あり"],["、"],["その"],["毛","け"],["も"],["白く","しろく"],["変わり","かわり"],["、"],["かつ"],["その"],["腫","しゅ"],["に"],["生きた","いきた"],["生肉","な"],["ま"],["にく"],["が"],["見えるならば","みえるならば"],["、"]]},{"verse":11,"text":"これは古,ふるいらい病,びょうがその身,みの皮,かわにあるのであるから、祭司,さいしはその人,ひとを汚,けがれた者,ものとしなければならない。その人,ひとは汚,けがれた者,ものであるから、これを留,とめ置,おくに及,およばない。","tok":[["これ"],["は"],["古い","ふるい"],["らい病","らいびょう"],["が"],["その"],["身","み"],["の"],["皮","かわ"],["に"],["ある"],["ので"],["ある"],["から"],["、"],["祭司","さいし"],["は"],["その"],["人","ひと"],["を"],["汚","け"],["がれ"],["た"],["者","もの"],["と"],["しなければ"],["ならない"],["。"],["その"],["人","ひと"],["は"],["汚","け"],["がれ"],["た"],["者","もの"],["で"],["ある"],["から"],["、"],["これ"],["を"],["留置く","とめおく"],["に"],["及ばない","およばない"],["。"]]},{"verse":12,"text":"もしらい病,びょうが広,ひろく皮,かわに出,でて、そのらい病,びょうが、その患者,かんじゃの皮,かわを頭,あたまから足,あしまで、ことごとくおおい、祭司,さいしの見,みるところすべてに及,およんでおれば、","tok":[["もし"],["らい病","らいびょう"],["が"],["広く","ひろく"],["皮","かわ"],["に"],["出て","でて"],["、"],["その"],["らい病","らいびょう"],["が"],["、"],["その"],["患者","かんじゃ"],["の"],["皮","かわ"],["を"],["頭","あたま"],["から"],["足","あし"],["まで"],["、"],["ことごとく"],["おおい"],["、"],["祭司","さいし"],["の"],["見る","みる"],["ところ"],["すべて"],["に"],["及んで","およんで"],["おれば"],["、"]]},{"verse":13,"text":"祭司,さいしはこれを見,み、もしらい病,びょうがその身,みをことごとくおおっておれば、その患者,かんじゃを清,きよい者,ものとしなければならない。それはことごとく白,しろく変,かわったから、彼,かれは清,きよい者,ものである。","tok":[["祭司","さいし"],["は"],["これ"],["を"],["見","み"],["、"],["もし"],["らい病","らいびょう"],["が"],["その"],["身","み"],["を"],["ことごとく"],["おおって"],["おれば"],["、"],["その"],["患者","かんじゃ"],["を"],["清い","きよい"],["者","もの"],["と"],["しなければ"],["ならない"],["。"],["それ"],["は"],["ことごとく"],["白く","しろく"],["変わった","かわった"],["から"],["、"],["彼","かれ"],["は"],["清い","きよい"],["者","もの"],["で"],["ある"],["。"]]},{"verse":14,"text":"しかし、もし生肉,なまにくがその人,ひとに現,あらわれておれば、汚,けがれた者,ものである。","tok":[["しかし"],["、"],["もし"],["生肉","なまにくがそ"],["の"],["人","ひと"],["に"],["現われて","あらわれて"],["おれば"],["、"],["汚","け"],["がれ"],["た"],["者","もの"],["で"],["ある"],["。"]]},{"verse":15,"text":"祭司,さいしはその生肉,なまにくを見,みて、その人,ひとを汚,けがれた者,ものとしなければならない。生肉,なまにくは汚,けがれたものであって、それはらい病,びょうである。","tok":[["祭司","さいし"],["は"],["その"],["生肉","なまにく"],["を"],["見て","みて"],["、"],["その"],["人","ひと"],["を"],["汚","け"],["がれ"],["た"],["者","もの"],["と"],["しなければ"],["ならない"],["。"],["生肉","なまにく"],["は"],["汚","けがれたも"],["ので"],["あって"],["、"],["それ"],["は"],["らい病","らいびょう"],["で"],["ある"],["。"]]},{"verse":16,"text":"もしまたその生肉,なまにくが再,ふたたび白,しろく変,かわるならば、その人,ひとは祭司,さいしのもとに行,いかなければならない。","tok":[["もし"],["また"],["その"],["生肉","な"],["ま"],["にく"],["が"],["再び","ふたたび"],["白く","しろく"],["変わるならば","かわるならば"],["、"],["その"],["人","ひと"],["は"],["祭司","さいし"],["の"],["もと"],["に"],["行かなければ","いかなければ"],["ならない"],["。"]]},{"verse":17,"text":"祭司,さいしはその人,ひとを見,みて、もしその患部,かんぶが白,しろく変,かわっておれば、祭司,さいしはその患者,かんじゃを清,きよい者,ものとしなければならない。その人,ひとは清,きよい者,ものである。","tok":[["祭司","さいし"],["は"],["その"],["人","ひと"],["を"],["見て","みて"],["、"],["もし"],["その"],["患部","かんぶ"],["が"],["白く","しろく"],["変わって","かわって"],["おれば"],["、"],["祭司","さいし"],["は"],["その"],["患者","かんじゃ"],["を"],["清い","きよい"],["者","もの"],["と"],["しなければ"],["ならない"],["。"],["その"],["人","ひと"],["は"],["清い","きよい"],["者","もの"],["で"],["ある"],["。"]]},{"verse":18,"text":"また身,みの皮,かわに腫物,はれものがあったが、直,なおって、","tok":[["また"],["身","み"],["の"],["皮","かわ"],["に"],["腫物","はれもの"],["が"],["あった"],["が"],["、"],["直って","なおって"],["、"]]},{"verse":19,"text":"その腫物,はれものの場所,ばしょに白,しろい腫,しゅ、または赤,あかみをおびた白,しろい光,ひかる所,ところがあれば、これを祭司,さいしに見,みせなければならない。","tok":[["その"],["腫物","はれも"],["の"],["の"],["場所","ばしょ"],["に"],["白い","しろい"],["腫","しゅ"],["、"],["また"],["は"],["赤み","あかみ"],["を"],["おびた"],["白い","しろい"],["光る","ひかる"],["所","ところ"],["が"],["あれば"],["、"],["これ"],["を"],["祭司","さいし"],["に"],["見せなければ","みせなければ"],["ならない"],["。"]]},{"verse":20,"text":"祭司,さいしはこれを見,みて、もし皮,かわよりも低,ひくく見,みえ、その毛,けが白,しろく変,かわっていれば、祭司,さいしはその人,ひとを汚,けがれた者,ものとしなければならない。それは腫物,はれものに起,たったらい病,びょうの患部,かんぶだからである。","tok":[["祭司","さいし"],["は"],["これ"],["を"],["見て","みて"],["、"],["もし"],["皮","かわ"],["より"],["も"],["低く","ひくく"],["見え","みえ"],["、"],["その"],["毛","け"],["が"],["白く","しろく"],["変わって","かわって"],["いれば"],["、"],["祭司","さいし"],["は"],["その"],["人","ひと"],["を"],["汚","け"],["がれ"],["た"],["者","もの"],["と"],["しなければ"],["ならない"],["。"],["それ"],["は"],["腫物","はれも"],["のに"],["起った","たった"],["らい病","らいびょう"],["の"],["患部","かんぶ"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":21,"text":"しかし、祭司,さいしがこれを見,みて、もしその所,ところに白,しろい毛,けがなく、また皮,かわよりも低,ひくい所,ところがなく、かえって薄,うすらいでいるならば、祭司,さいしはその人,ひとを七日,なぬかのあいだ留,とめ置,おかなければならない。","tok":[["しかし"],["、"],["祭司","さいし"],["が"],["これ"],["を"],["見て","みて"],["、"],["もし"],["その"],["所","ところ"],["に"],["白い","しろい"],["毛","け"],["が"],["なく"],["、"],["また"],["皮","かわ"],["より"],["も"],["低い","ひくい"],["所","ところ"],["が"],["なく"],["、"],["かえって"],["薄らいで","うすらいで"],["いるならば"],["、"],["祭司","さいし"],["は"],["その"],["人","ひと"],["を"],["七","しち"],["日","にち"],["の"],["あいだ"],["留置かなければ","とめおかなければ"],["ならない"],["。"]]},{"verse":22,"text":"そしてもし皮,かわに広,ひろくひろがっているならば、祭司,さいしはその人,ひとを汚,けがれた者,ものとしなければならない。それは患部,かんぶだからである。","tok":[["そして"],["もし"],["皮","かわ"],["に"],["広く","ひろく"],["ひろがって"],["いるならば"],["、"],["祭司","さいし"],["は"],["その"],["人","ひと"],["を"],["汚","け"],["がれ"],["た"],["者","もの"],["と"],["しなければ"],["ならない"],["。"],["それ"],["は"],["患部","かんぶ"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":23,"text":"しかし、その光,ひかる所,ところがもしその所,ところにとどまって広,ひろがらなければ、それは腫物,はれものの跡,あとである。祭司,さいしはその人,ひとを清,きよい者,ものとしなければならない。","tok":[["しかし"],["、"],["その"],["光る","ひかる"],["所","ところ"],["が"],["もし"],["その"],["所","ところ"],["に"],["とどまって"],["広がらなければ","ひろがらなければ"],["、"],["それ"],["は"],["腫物","はれも"],["の"],["の"],["跡","あと"],["で"],["ある"],["。"],["祭司","さいし"],["は"],["その"],["人","ひと"],["を"],["清い","きよい"],["者","もの"],["と"],["しなければ"],["ならない"],["。"]]},{"verse":24,"text":"また身,みの皮,かわにやけどがあって、そのやけどの生,いきた肉,にくがもし赤,あかみをおびた白,しろ、または、ただ白,しろくて光,ひかる所,ところとなるならば、","tok":[["また"],["身","み"],["の"],["皮","かわ"],["に"],["やけど"],["が"],["あって"],["、"],["その"],["やけど"],["の"],["生きた","いきた"],["肉","にく"],["が"],["もし"],["赤み","あかみ"],["を"],["おびた"],["白","しろ"],["、"],["また"],["は"],["、"],["ただ"],["白くて","しろくて"],["光る","ひかる"],["所","ところ"],["と"],["なるならば"],["、"]]},{"verse":25,"text":"祭司,さいしはこれを見,みなければならない。そしてもし、その光,ひかる所,ところにある毛,けが白,しろく変,かわって、そこが皮,かわよりも深,ふかく見,みえるならば、これはやけどに生,しょうじたらい病,びょうである。祭司,さいしはその人,ひとを汚,けがれた者,ものとしなければならない。これはらい病,びょうの患部,かんぶだからである。","tok":[["祭司","さいし"],["は"],["これ"],["を"],["見なければ","みなければ"],["ならない"],["。"],["そして"],["もし"],["、"],["その"],["光る","ひかる"],["所","ところ"],["に"],["ある"],["毛","け"],["が"],["白く","しろく"],["変わって","かわって"],["、"],["そこ"],["が"],["皮","かわ"],["より"],["も"],["深く","ふかく"],["見えるならば","みえるならば"],["、"],["これ"],["は"],["やけど"],["に"],["生じた","しょうじた"],["らい病","らいびょう"],["で"],["ある"],["。"],["祭司","さいし"],["は"],["その"],["人","ひと"],["を"],["汚","け"],["がれ"],["た"],["者","もの"],["と"],["しなければ"],["ならない"],["。"],["これ"],["は"],["らい病","らいびょう"],["の"],["患部","かんぶ"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":26,"text":"けれども祭司,さいしがこれを見,みて、その光,ひかる所,ところに白,しろい毛,けがなく、また皮,かわよりも低,ひくい所,ところがなく、かえって薄,うすらいでいるならば、祭司,さいしはその人,ひとを七日,なぬかのあいだ留,とめ置,おき、","tok":[["けれど"],["も"],["祭司","さいし"],["が"],["これ"],["を"],["見て","みて"],["、"],["その"],["光る","ひかる"],["所","ところ"],["に"],["白い","しろい"],["毛","け"],["が"],["なく"],["、"],["また"],["皮","かわ"],["より"],["も"],["低い","ひくい"],["所","ところ"],["が"],["なく"],["、"],["かえって"],["薄らいで","うすらいで"],["いるならば"],["、"],["祭司","さいし"],["は"],["その"],["人","ひと"],["を"],["七","しち"],["日","にち"],["の"],["あいだ"],["留置き","とめおき"],["、"]]},{"verse":27,"text":"七日,なぬか目,めに祭司,さいしは彼,かれを見,みなければならない。もし皮,かわに広,ひろくひろがっているならば、祭司,さいしはその人,ひとを汚,けがれた者,ものとしなければならない。これはらい病,びょうの患部,かんぶだからである。","tok":[["七日","な"],["ぬか目","ぬかめ"],["に"],["祭司","さいし"],["は"],["彼","かれ"],["を"],["見なければ","みなければ"],["ならない"],["。"],["もし"],["皮","かわ"],["に"],["広く","ひろく"],["ひろがって"],["いるならば"],["、"],["祭司","さいし"],["は"],["その"],["人","ひと"],["を"],["汚","け"],["がれ"],["た"],["者","もの"],["と"],["しなければ"],["ならない"],["。"],["これ"],["は"],["らい病","らいびょう"],["の"],["患部","かんぶ"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":28,"text":"もしその光,ひかる所,ところが、その所,ところにとどまって、皮,かわに広,ひろがらずに、かえって薄,うすらいでいるな
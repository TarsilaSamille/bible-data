[{"verse":1,"text":"主,しゅはまたモーセに言,いわれた、","tok":[["主","しゅ"],["は"],["また"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":2,"text":"「アロンとその子,こたちに告,つげて、イスラエルの人々,ひとびとの聖,せいなる物,もの、すなわち、彼,かれらがわたしにささげる物,ものをみだりに用,もちいて、わたしの聖,せいなる名,なを汚,けがさないようにさせなさい。わたしは主,しゅである。","tok":[["「"],["アロン"],["と"],["その"],["子","こ"],["たち"],["に"],["告","つげ"],["て"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["聖","せい"],["なる"],["物","もの"],["、"],["すなわち"],["、"],["彼","かれ"],["ら"],["が"],["わたし"],["に"],["ささげる"],["物","もの"],["を"],["みだり"],["に"],["用いて","もちいて"],["、"],["わたし"],["の"],["聖","せい"],["なる"],["名","な"],["を"],["汚","け"],["がさ"],["ない"],["よう"],["に"],["させ"],["なさい"],["。"],["わたし"],["は"],["主","しゅ"],["で"],["ある"],["。"]]},{"verse":3,"text":"彼,かれらに言,いいなさい、『あなたがたの代々,よよの子孫,しそんのうち、だれでも、イスラエルの人々,ひとびとが主,しゅにささげる聖,せいなる物,ものに、汚,けがれた身,みをもって近,ちかづく者,ものがあれば、その人,ひとはわたしの前,まえから断,たたれるであろう。わたしは主,しゅである。","tok":[["彼","かれ"],["ら"],["に"],["言い","いい"],["なさい"],["、"],["『"],["あなた"],["がた"],["の"],["代々","よよ"],["の"],["子孫","しそん"],["の"],["うち"],["、"],["だれ"],["で"],["も"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["が"],["主に","しゅに"],["ささげる"],["聖","せい"],["なる"],["物","もの"],["に"],["、"],["汚","け"],["がれ"],["た"],["身","み"],["を"],["もって"],["近づく","ちかづく"],["者","もの"],["が"],["あれば"],["、"],["その"],["人","ひと"],["は"],["わたし"],["の"],["前","まえ"],["から"],["断たれるで","たたれるで"],["あろう"],["。"],["わたし"],["は"],["主","しゅ"],["で"],["ある"],["。"]]},{"verse":4,"text":"アロンの子孫,しそんのうち、だれでも、らい病,びょうの者,もの、また流出,りゅうしゅつある者,ものは清,きよくなるまで、聖,せいなる物,ものを食,たべてはならない。また、すべて死体,したいによって汚,けがれた物,ものに触,ふれた者,もの、精,せいを漏,もらした者,もの、","tok":[["アロン"],["の"],["子孫","しそん"],["の"],["うち"],["、"],["だれ"],["で"],["も"],["、"],["らい病","らいびょう"],["の"],["者","もの"],["、"],["また"],["流出","りゅうしゅつ"],["ある"],["者","もの"],["は"],["清く","きよく"],["なる"],["まで"],["、"],["聖","せい"],["なる"],["物","もの"],["を"],["食べて","たべて"],["は"],["ならない"],["。"],["また"],["、"],["すべて"],["死体","したい"],["によって"],["汚","け"],["がれ"],["た"],["物","もの"],["に"],["触","ふれ"],["た"],["者","もの"],["、"],["精","せい"],["を"],["漏らした","もらした"],["者","もの"],["、"]]},{"verse":5,"text":"または、すべて人,ひとを汚,けがす這,はうものに触,ふれた者,もの、または、どのような汚,けがれにせよ、人,ひとを汚,けがれさせる人,ひとに触,ふれた者,もの、","tok":[["また"],["は"],["、"],["すべて"],["人","ひと"],["を"],["汚","け"],["が"],["す"],["這う","はう"],["もの"],["に"],["触","ふれ"],["た"],["者","もの"],["、"],["また"],["は"],["、"],["どのような"],["汚に","けがれに"],["せよ"],["、"],["人","ひと"],["を"],["汚","け"],["がれ"],["させる"],["人","ひと"],["に"],["触","ふれ"],["た"],["者","もの"],["、"]]},{"verse":6,"text":"このようなものに触,ふれた人,ひとは夕,ゆうまで汚,けがれるであろう。彼,かれはその身,みを水,みずにすすがないならば、聖,せいなる物,ものを食,たべてはならない。","tok":[["この"],["よう"],["な"],["もの"],["に"],["触","ふれ"],["た"],["人","ひと"],["は"],["夕","ゆう"],["まで"],["汚","け"],["がれる"],["で"],["あろう"],["。"],["彼","かれ"],["は"],["その"],["身","み"],["を"],["水","みず"],["に"],["すすがないならば"],["、"],["聖","せい"],["なる"],["物","もの"],["を"],["食べて","たべて"],["は"],["ならない"],["。"]]},{"verse":7,"text":"日,ひが入,いれば、彼,かれは清,きよくなるであろう。そののち、聖,せいなる物,ものを食,たべることができる。それは彼,かれの食物,しょくもつだからである。","tok":[["日","ひ"],["が"],["入れば","いれば"],["、"],["彼","かれ"],["は"],["清く","きよく"],["なるで"],["あろう"],["。"],["その"],["のち"],["、"],["聖","せい"],["なる"],["物","もの"],["を"],["食べる","たべる"],["こと"],["が"],["できる"],["。"],["それ"],["は"],["彼","かれ"],["の"],["食物","しょくもつ"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":8,"text":"自然,しぜんに死,しんだもの、または裂,さき殺,ころされたものを食,たべ、それによって身,みを汚,けがしてはならない。わたしは主,しゅである。","tok":[["自然","しぜん"],["に"],["死んだ","しんだ"],["もの"],["、"],["また"],["は"],["裂き","さき"],["殺された","ころされた"],["もの"],["を"],["食べ","たべ"],["、"],["それ"],["によって"],["身","み"],["を"],["汚","け"],["がして"],["は"],["ならない"],["。"],["わたし"],["は"],["主","しゅ"],["で"],["ある"],["。"]]},{"verse":9,"text":"それゆえに、彼,かれらはわたしの言,いいつけを守,まもらなければならない。彼,かれらがこれを汚,けがし、これがために、罪,つみを獲,えて死,しぬことのないためである。わたしは彼,かれらを聖別,せいべつする主,しゅである。","tok":[["それ"],["ゆえ"],["に"],["、"],["彼","かれ"],["ら"],["は"],["わたし"],["の"],["言いつけ","いいつけ"],["を"],["守らなければ","まもらなければ"],["ならない"],["。"],["彼","かれ"],["ら"],["が"],["これ"],["を"],["汚","け"],["がし"],["、"],["これ"],["が"],["ため"],["に"],["、"],["罪","つみ"],["を"],["獲て","えて"],["死ぬ","しぬ"],["こと"],["の"],["ない"],["ため"],["で"],["ある"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["聖別","せいべつ"],["する"],["主","しゅ"],["で"],["ある"],["。"]]},{"verse":10,"text":"すべて一般,いっぱんの人,ひとは聖,せいなる物,ものを食,たべてはならない。祭司,さいしの同居,どうきょ人,ひとや雇人,やといにんも聖,せいなる物,ものを食,たべてはならない。","tok":[["すべて"],["一般","いっぱん"],["の"],["人","ひと"],["は"],["聖","せい"],["なる"],["物","もの"],["を"],["食べて","たべて"],["は"],["ならない"],["。"],["祭司","さいし"],["の"],["同居人","どうきょひと"],["や"],["雇人","やといにん"],["も"],["聖","せい"],["なる"],["物","もの"],["を"],["食べて","たべて"],["は"],["ならない"],["。"]]},{"verse":11,"text":"しかし、祭司,さいしが金,かねをもって人,ひとを買,かった時,ときは、その者,ものはこれを食,たべることができる。またその家,いえに生,うまれた者,ものも祭司,さいしの食物,しょくもつを食,たべることができる。","tok":[["しかし"],["、"],["祭司","さいし"],["が"],["金","かね"],["を"],["もって"],["人","ひと"],["を"],["買った","かった"],["時","とき"],["は"],["、"],["その"],["者","もの"],["は"],["これ"],["を"],["食べる","たべる"],["こと"],["が"],["できる"],["。"],["また"],["その"],["家","いえ"],["に"],["生まれた","うまれた"],["者","もの"],["も"],["祭司","さいし"],["の"],["食物","しょくもつ"],["を"],["食べる","たべる"],["こと"],["が"],["できる"],["。"]]},{"verse":12,"text":"もし祭司,さいしの娘,むすめが一般,いっぱんの人,ひとにとついだならば、彼女,かのじょは聖,せいなる供,そなえ物,ものを食,たべてはならない。","tok":[["もし"],["祭司","さいし"],["の"],["娘","むすめ"],["が"],["一般","いっぱん"],["の"],["人","ひと"],["に"],["とついだならば"],["、"],["彼女","かのじょ"],["は"],["聖","せい"],["なる"],["供え物","そなえもの"],["を"],["食べて","たべて"],["は"],["ならない"],["。"]]},{"verse":13,"text":"もし祭司,さいしの娘,むすめが、寡婦,かふとなり、または出,だされて、子供,こどももなく、その父,ちちの家,いえに帰,かえり、娘,むすめの時,ときのようであれば、その父,ちちの食物,しょくもつを食,たべることができる。ただし、一般,いっぱんの人,ひとは、すべてこれを食,たべてはならない。","tok":[["もし"],["祭司","さいし"],["の"],["娘","むすめ"],["が"],["、"],["寡婦","かふ"],["と"],["なり"],["、"],["また"],["は"],["出されて","だされて"],["、"],["子供","こども"],["も"],["なく"],["、"],["その"],["父","ちち"],["の"],["家","いえ"],["に"],["帰えり","かえり"],["、"],["娘","むすめ"],["の"],["時","とき"],["の"],["よう"],["で"],["あれば"],["、"],["その"],["父","ちち"],["の"],["食物","しょくもつ"],["を"],["食べる","たべる"],["こと"],["が"],["できる"],["。"],["ただし"],["、"],["一般","いっぱん"],["の"],["人","ひと"],["は"],["、"],["すべて"],["これ"],["を"],["食べて","たべて"],["は"],["ならない"],["。"]]},{"verse":14,"text":"もし人,ひとがあやまって聖,せいなる物,ものを食,たべるならば、それにその五分,ぶんの一を加,くわえ、聖,せいなる物,ものとしてこれを祭司,さいしに渡,わたさなければならない。","tok":[["もし"],["人","ひと"],["が"],["あやまって"],["聖","せい"],["なる"],["物","もの"],["を"],["食べるならば","たべるならば"],["、"],["それ"],["に"],["その"],["五分","ぶん"],["の"],["一","いち"],["を"],["加え","くわえ"],["、"],["聖","せい"],["なる"],["物","もの"],["として"],["これ"],["を"],["祭司","さいし"],["に"],["渡さなければ","わたさなければ"],["ならない"],["。"]]},{"verse":15,"text":"祭司,さいしはイスラエルの人々,ひとびとが、主,しゅにささげる聖,せいなる物,ものを汚,けがしてはならない。","tok":[["祭司","さいし"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["が"],["、"],["主に","しゅに"],["ささげる"],["聖","せい"],["なる"],["物","もの"],["を"],["汚","け"],["がして"],["は"],["ならない"],["。"]]},{"verse":16,"text":"人々,ひとびとが聖,せいなる物,ものを食,たべて、その罪,つみのとがを負,おわないようにさせなければならない。わたしは彼,かれらを聖別,せいべつする主,しゅである』」。","tok":[["人々","ひとびと"],["が"],["聖","せい"],["なる"],["物","もの"],["を"],["食べて","たべて"],["、"],["その"],["罪","つみ"],["の"],["とが"],["を"],["負わない","おわない"],["よう"],["に"],["させなければ"],["ならない"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["聖別","せいべつ"],["する"],["主","しゅ"],["で"],["ある"],["』"],["」"],["。"]]},{"verse":17,"text":"主,しゅはまたモーセに言,いわれた、","tok":[["主","しゅ"],["は"],["また"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":18,"text":"「アロンとその子,こたち、およびイスラエルのすべての人々,ひとびとに言,いいなさい、『イスラエルの家,いえの者,もの、またはイスラエルにおる他国,たこく人,じんのうちのだれでも、誓願,せいがんの供,そなえ物,もの、または自発,じはつの供,そなえ物,ものを燔祭,はんさいとして主,しゅにささげようとするならば、","tok":[["「"],["アロン"],["と"],["その"],["子","こ"],["たち"],["、"],["および"],["イスラエル"],["の"],["すべて"],["の"],["人々","ひとびと"],["に"],["言い","いい"],["なさい"],["、"],["『"],["イスラエル"],["の"],["家","いえ"],["の"],["者","もの"],["、"],["また"],["は"],["イスラエル"],["に"],["おる"],["他国人","たこくじん"],["の"],["うち"],["の"],["だれ"],["で"],["も"],["、"],["誓願","せいがん"],["の"],["供え物","そなえもの"],["、"],["また"],["は"],["自発","じはつ"],["の"],["供え物","そなえもの"],["を"],["燔祭","はんさい"],["として"],["主に","しゅに"],["ささげよう"],["と"],["するならば"],["、"]]},{"verse":19,"text":"あなたがたの受,うけ入,いれられるように牛,うし、羊,ひつじ、あるいはやぎの雄,おすの全,まったきものをささげなければならない。","tok":[["あなた"],["がた"],["の"],["受け入れられる","うけいれられる"],["よう"],["に"],["牛","うし"],["、"],["羊","ひつじ"],["、"],["あるいは"],["やぎ"],["の"],["雄","おす"],["の"],["全","まったきも"],["の"],["を"],["ささげなければ"],["ならない"],["。"]]},{"verse":20,"text":"すべてきずのあるものはささげてはならない。それはあなたがたのために、受,うけ入,いれられないからである。","tok":[["すべて"],["きず"],["の"],["ある"],["もの"],["は"],["ささげて"],["は"],["ならない"],["。"],["それ"],["は"],["あなた"],["がた"],["の"],["ため"],["に"],["、"],["受け入れられない","うけいれられない"],["から"],["で"],["ある"],["。"]]},{"verse":21,"text":"もし人,ひとが特別,とくべつの誓願,せいがんをなすため、または自発,じはつの供,そなえ物,もののために、牛,うしまたは羊,ひつじを酬恩祭,しゅうおんさいの犠牲,ぎせいとして、主,しゅにささげようとするならば、その受,うけ入,いれられるために、それは全,まったきものでなければならない。それには、どんなきずもあってはならない。","tok":[["もし"],["人","ひと"],["が"],["特別","とくべつ"],["の"],["誓願","せいがん"],["を"],["なす"],["ため"],["、"],["また"],["は"],["自発","じはつ"],["の"],["供え物","そなえもの"],["の"],["ため"],["に"],["、"],["牛","うし"],["また"],["は"],["羊","ひつじ"],["を"],["酬恩祭","しゅうおんさい"],["の"],["犠牲","ぎせい"],["として"],["、"],["主に","しゅに"],["ささげよう"],["と"],["するならば"],["、"],["その"],["受け入れられる","うけいれられる"],["ため"],["に"],["、"],["それ"],["は"],["全","まったきも"],["ので"],["なければ"],["ならない"],["。"],["それ"],["に"],["は"],["、"],["どんな"],["きず"],["も"],["あって"],["は"],["ならない"],["。"]]},{"verse":22,"text":"すなわち獣,けもののうちで、めくらのもの、折,おれた所,ところのあるもの、切,きり取,とった所,ところのあるもの、うみの出,でる者,もの、かいせんの者,もの、かさぶたのある者,ものなど、あなたがたは、このようなものを主,しゅにささげてはならない。また祭壇,さいだんの上,うえに、これらを火祭,かさいとして、主,しゅにささげてはならない。","tok":[["すなわち"],["獣","けもの"],["の"],["うち"],["で"],["、"],["めくら"],["の"],["もの"],["、"],["折れた","おれた"],["所","ところ"],["の"],["ある"],["もの"],["、"],["切り取った","きりとった"],["所","ところ"],["の"],["ある"],["もの"],["、"],["うみ"],["の"],["出る","でる"],["者","もの"],["、"],["かい"],["せん"],["の"],["者","もの"],["、"],["かさぶた"],["の"],["ある"],["者","もの"],["など"],["、"],["あなた"],["がた"],["は"],["、"],["この"],["よう"],["な"],["もの"],["を"],["主に","しゅに"],["ささげて"],["は"],["ならない"],["。"],["また"],["祭壇","さいだん"],["の"],["上","うえ"],["に"],["、"],["これ"],["ら"],["を"],["火祭","かさい"],["として"],["、"],["主に","しゅに"],["ささげて"],["は"],["ならない"],["。"]]},{"verse":23,"text":"牛,うしあるいは羊,ひつじで、足,あしの長,ながすぎる者,もの、または短,みじかすぎる者,ものは、あなたがたが自発,じはつの供,そなえ物,ものとすることはできるが、誓願,せいがんの供,そなえ物,ものとしては受,うけ入,いれられないであろう。","tok":[["牛","うし"],["あるいは"],["羊","ひつじ"],["で"],["、"],["足","あし"],["の"],["長","なが"],["すぎる"],["者","もの"],["、"],["また"],["は"],["短か","みじか"],["すぎる"],["者","もの"],["は"],["、"],["あなた"],["がた"],["が"],["自発","じはつ"],["の"],["供え物","そなえもの"],["と"],["する"],["こと"],["は"],["できる"],["が"],["、"],["誓願","せいがん"],["の"],["供え物","そなえもの"],["として"],["は"],["受け入れられないで","うけいれられないで"],["あろう"],["。"]]},{"verse":24,"text":"あなたがたは、こうがんの破,やぶれたもの、つぶれたもの、裂,さけたもの、または切,きり取,とられたものを、主,しゅにささげてはならない。またあなたがたの国,くにのうちで、このようなことを、行,おこなってはならない。","tok":[["あなた"],["がた"],["は"],["、"],["こう"],["がん"],["の"],["破れた","やぶれた"],["もの"],["、"],["つぶれた"],["もの"],["、"],["裂けた","さけた"],["もの"],["、"],["また"],["は"],["切り取られた","きりとられた"],["もの"],["を"],["、"],["主に","しゅに"],["ささげて"],["は"],["ならない"],["。"],["また"],["あなた"],["がた"],["の"],["国","くに"],["の"],["うち"],["で"],["、"],["この"],["よう"],["な"],["こと"],["を"],["、"],["行なって","おこなって"],["は"],["ならない"],["。"]]},{"verse":25,"text":"また、あなたがたは異邦人,いほうじんの手,てからこれらのものを受,うけて、あなたがたの神,かみの食物,しょくもつとしてささげてはならない。これらのものには欠点,けってんがあり、きずがあって、あなたがたのために受,うけ入,いれられないからである』」。","tok":[["また"],["、"],["あなた"],["がた"],["は"],["異邦人","いほうじん"],["の"],["手","て"],["から"],["これ"],["ら"],["の"],["もの"],["を"],["受て","うけて"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["の"],["食物","しょくもつ"],["として"],["ささげて"],["は"],["ならない"],["。"],["これ"],["ら"],["の"],["もの"],["に"],["は"],["欠点","けってん"],["が"],["あり"],["、"],["きず"],["が"],["あって"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["受け入れられない","うけいれられない"],["から"],["で"],["ある"],["』"],["」"],["。"]]},{"verse":26,"text":"主,しゅはまたモーセに言,いわれた、","tok":[["主","しゅ"],["は"],["また"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":27,"text":"「牛,うし、または羊,ひつじ、またはやぎが生,うまれたならば、これを七日,なぬかの間,あいだその母親,ははおやのもとに置,おかなければならない。八日,か目,めからは主,しゅにささげる火祭,かさいとして受,うけ入,いれられるであろう。","tok":[["「"],["牛","うし"],["、"],["また"],["は"],["羊","ひつじ"],["、"],["また"],["は"],["やぎ"],["が"],["生まれたならば","うまれたならば"],["、"],["これ"],["を"],["七","しち"],["日","にち"],["の"],["間","あいだ"],["その"],["母親","ははおや"],["の"],["もと"],["に"],["置かなければ","おかなければ"],["ならない"],["。"],["八日目","かめ"],["から"],["は"],["主に","しゅに"],["ささげる"],["火祭","かさい"],["として"],["受け入れられるで","うけいれられるで"],["あろう"],["。"]]},{"verse":28,"text":"あなたがたは雌牛,めうしまたは雌,め羊,ひつじをその子,こと同,おなじ日,ひにほふってはならない。","tok":[["あなた"],["がた"],["は"],["雌牛","めうし"],["また"],["は"],["雌羊","めひつじ"],["を"],["その"],["子","こ"],["と"],["同じ","おなじ"],["日","ひ"],["に"],["ほふって"],["は"],["ならない"],["。"]]},{"verse":29,"text":"あなたがたが感謝,かんしゃの犠牲,ぎせいを主,しゅにささげるときは、あなたがたの受,うけ入,いれられるようにささげなければならない。","tok":[["あなた"],["がた"],["が"],["感謝","かんしゃ"],["の"],["犠牲","ぎせい"],["を"],["主に","しゅに"],["ささげる"],["とき"],["は"],["、"],["あなた"],["がた"],["の"],["受け入れられる","うけいれられる"],["よう"],["に"],["ささげなければ"],["ならない"],["。"]]},{"verse":30,"text":"これはその日,ひのうちに食,たべなければならない。明,あくる日,ひまで残,のこしておいてはならない。わたしは主,しゅである。","tok":[["これ"],["は"],["その"],["日","ひ"],["の"],["うち"],["に"],["食べなければ","たべなければ"],["ならない"],["。"],["明くる日","あくるひ"],["まで"],["残して","のこして"],["おいて"],["は"],["ならない"],["。"],["わたし"],["は"],["主","しゅ"],["で"],["ある"],["。"]]},{"verse":31,"text":"あなたがたはわたしの戒,いましめを守,まもり、これを行,おこなわなければならない。わたしは主,しゅである。","tok":[["あなた"],["がた"],["は"],["わたし"],["の"],["戒しめ","いましめ"],["を"],["守り","まもり"],["、"],["これ"],["を"],["行なわなければ","おこなわなければ"],["ならない"],["。"],["わたし"],["は"],["主","しゅ"],["で"],["ある"],["。"]]},{"verse":32,"text":"あなたがたはわたしの聖,せいなる名,なを汚,けがしてはならない。かえって、わたしはイスラエルの人々,ひとびとのうちに聖,せいとされなければならない。わたしはあなたがたを聖別,せいべつする主,しゅである。","tok":[["あなた"],["がた"],["は"],["わたし"],["の"],["聖","せい"],["なる"],["名","な"],["を"],["汚","け"],["がして"],["は"],["ならない"],["。"],["かえって"],["、"],["わたし"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["うち"],["に"],["聖","せい"],["と"],["されなければ"],["ならない"],["。"],["わたし"],["は"],["あなた"],["がた"],["を"],["聖別","せいべつ"],["する"],["主","しゅ"],["で"],["ある"],["。"]]},{"verse":33,"text":"あなたがたの神,かみとなるために、あなたがたをエジプトの国,くにから導,みちびき出,だした者,ものである。わたしは主,しゅである」。","tok":[["あなた"],["がた"],["の"],["神","かみ"],["と"],["なる"],["ため"],["に"],["、"],["あなた"],["がた"],["を"],["エジプト"],["の"],["国","くに"],["から"],["導き出した","みちびきだした"],["者","もの"],["で"],["ある"],["。"],["わたし"],["は"],["主","しゅ"],["で"],["ある"],["」"],["。"]]}]
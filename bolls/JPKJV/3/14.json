[{"verse":1,"text":"主,しゅはまたモーセに言,いわれた、","tok":[["主","しゅ"],["は"],["また"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":2,"text":"「らい病人,びょうにんが清,きよい者,ものとされる時,ときのおきては次,つぎのとおりである。すなわち、その人,ひとを祭司,さいしのもとに連,つれて行,いき、","tok":[["「"],["らい病人","らいびょうにん"],["が"],["清い","きよい"],["者","もの"],["と"],["される"],["時","とき"],["の"],["おきて"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["すなわち"],["、"],["その"],["人","ひと"],["を"],["祭司","さいし"],["の"],["もと"],["に"],["連れて","つれて"],["行き","いき"],["、"]]},{"verse":3,"text":"祭司,さいしは宿営,しゅくえいの外,そとに出,でて行,いって、その人,ひとを見,み、もしらい病,びょうの患部,かんぶがいえているならば、","tok":[["祭司","さいし"],["は"],["宿営","しゅくえい"],["の"],["外","そと"],["に"],["出て","でて"],["行って","いって"],["、"],["その"],["人","ひと"],["を"],["見","み"],["、"],["もし"],["らい病","らいびょう"],["の"],["患部","かんぶ"],["が"],["いえて"],["いるならば"],["、"]]},{"verse":4,"text":"祭司,さいしは命,めいじてその清,きよめられる者,もののために、生,いきている清,きよい小鳥,ことり二羽,わと、香柏,こうはくの木,きと、緋,ひの糸,いとと、ヒソプとを取,とってこさせ、","tok":[["祭司","さいし"],["は"],["命じて","めいじて"],["その"],["清められる","きよめられる"],["者","もの"],["の"],["ため"],["に"],["、"],["生きて","いきて"],["いる"],["清い","きよい"],["小鳥","ことり"],["二羽","わ"],["と"],["、"],["香","こう"],["柏","かしわ"],["の"],["木","き"],["と"],["、"],["緋","ひ"],["の"],["糸","いと"],["と"],["、"],["ヒソプ"],["と"],["を"],["取って","とって"],["こさせ"],["、"]]},{"verse":5,"text":"祭司,さいしはまた命,めいじて、その小鳥,ことりの一羽,わを、流,ながれ水,みずを盛,もった土,つちの器,うつわの上,うえで殺,ころさせ、","tok":[["祭司","さいし"],["は"],["また"],["命じて","めいじて"],["、"],["その"],["小鳥","ことり"],["の"],["一羽","わ"],["を"],["、"],["流れ水","ながれみず"],["を"],["盛った","もった"],["土","つち"],["の"],["器","うつわ"],["の"],["上","うえ"],["で"],["殺させ","ころさせ"],["、"]]},{"verse":6,"text":"そして生,いきている小鳥,ことりを、香柏,こうはくの木,きと、緋,ひの糸,いとと、ヒソプと共,ともに取,とって、これをかの流,ながれ水,みずを盛,もった土,つちの器,うつわの上,うえで殺,ころした小鳥,ことりの血,ちに、その生,いきている小鳥,ことりと共,ともに浸,ひたし、","tok":[["そして"],["生きて","いきて"],["いる"],["小鳥","ことり"],["を"],["、"],["香","こう"],["柏","かしわ"],["の"],["木","き"],["と"],["、"],["緋","ひ"],["の"],["糸","いと"],["と"],["、"],["ヒソプ"],["と"],["共","とも"],["に"],["取って","とって"],["、"],["これ"],["を"],["かの"],["流れ水","ながれみず"],["を"],["盛った","もった"],["土","つち"],["の"],["器","うつわ"],["の"],["上","うえ"],["で"],["殺ろした","ころした"],["小鳥","ことり"],["の"],["血","ち"],["に"],["、"],["その"],["生きて","いきて"],["いる"],["小鳥","ことり"],["と"],["共","とも"],["に"],["浸し","ひたし"],["、"]]},{"verse":7,"text":"これをらい病,びょうから清,きよめられる者,ものに七たび注,そそいで、その人,ひとを清,きよい者,ものとし、その生,いきている小鳥,ことりは野,のに放,はなたなければならない。","tok":[["これ"],["を"],["らい病","らいびょう"],["から"],["清められる","きよめられる"],["者","もの"],["に"],["七","なな"],["たび"],["注いで","そそいで"],["、"],["その"],["人","ひと"],["を"],["清い","きよい"],["者","もの"],["と"],["し"],["、"],["その"],["生きて","いきて"],["いる"],["小鳥","ことり"],["は"],["野","の"],["に"],["放たなければ","はなたなければ"],["ならない"],["。"]]},{"verse":8,"text":"清,きよめられる者,ものはその衣服,いふくを洗,あらい、毛,けをことごとくそり落,おとし、水,みずに身,みをすすいで清,きよくなり、その後,のち、宿営,しゅくえいにはいることができる。ただし七日,なぬかの間,あいだはその天幕,てんまくの外,そとにいなければならない。","tok":[["清められる","きよめられる"],["者","もの"],["は"],["その"],["衣服","いふく"],["を"],["洗","あらい"],["、"],["毛","け"],["を"],["ことごとく"],["そり落とし","そりおとし"],["、"],["水","みず"],["に"],["身","み"],["を"],["すすいで"],["清く","きよく"],["なり"],["、"],["その後","そのの"],["ち"],["、"],["宿営","しゅくえい"],["に"],["はいる"],["こと"],["が"],["できる"],["。"],["ただし"],["七日","なぬか"],["の"],["間","あいだ"],["は"],["その"],["天幕","てんまく"],["の"],["外","そと"],["に"],["いなければ"],["ならない"],["。"]]},{"verse":9,"text":"そして七日,なぬか目,めに毛,けをことごとくそらなければならい。頭,あたまの毛,けも、ひげも、まゆも、ことごとくそらなければならない。彼,かれはその衣服,いふくを洗,あらい、水,みずに身,みをすすいで清,きよくなるであろう。","tok":[["そして"],["七日","な"],["ぬか目","ぬかめ"],["に"],["毛","け"],["を"],["ことごとく"],["そらなければ"],["ならい"],["。"],["頭","あたま"],["の"],["毛","け"],["も"],["、"],["ひげ"],["も"],["、"],["まゆ"],["も"],["、"],["ことごとく"],["そらなければ"],["ならない"],["。"],["彼","かれ"],["は"],["その"],["衣服","いふく"],["を"],["洗","あらい"],["、"],["水","みず"],["に"],["身","み"],["を"],["すすいで"],["清く","きよく"],["なるで"],["あろう"],["。"]]},{"verse":10,"text":"八日,か目,めにその人,ひとは雄,おすの小羊,こひつじの全,まったきもの二頭,とうと、一歳,さいの雌,めすの小羊,こひつじの全,まったきもの一頭,とうとを取,とり、また麦粉,むぎこ十分,ぶんの三エパに油,あぶらを混,まぜた素祭,そさいと、油,あぶら一ログとを取,とらなければならない。","tok":[["八日目","かめ"],["に"],["その"],["人","ひと"],["は"],["雄","おす"],["の"],["小羊","こひつじ"],["の"],["全","まったきも"],["の"],["二頭","とう"],["と"],["、"],["一歳","さい"],["の"],["雌","めす"],["の"],["小羊","こひつじ"],["の"],["全","まったきも"],["の"],["一頭","とうと"],["を"],["取","とり"],["、"],["また"],["麦粉","むぎこ"],["十分","ぶん"],["の"],["三","さん"],["エパ"],["に"],["油","あぶら"],["を"],["混ぜた","まぜた"],["素","す"],["祭","まつり"],["と"],["、"],["油","あぶら"],["一","いち"],["ログ"],["と"],["を"],["取らなければ","とらなければ"],["ならない"],["。"]]},{"verse":11,"text":"清,きよめをなす祭司,さいしは、清,きよめられる人,ひととこれらの物,ものとを、会見,かいけんの幕屋,まくやの入口,いりぐちで主,しゅの前,まえに置,おき、","tok":[["清め","きよめ"],["を"],["なす"],["祭司","さいし"],["は"],["、"],["清められる","きよめられる"],["人","ひと"],["と"],["これ"],["ら"],["の"],["物","もの"],["と"],["を"],["、"],["会見","かいけん"],["の"],["幕屋","まくや"],["の"],["入口","いりぐち"],["で"],["主","しゅ"],["の"],["前","まえ"],["に"],["置き","おき"],["、"]]},{"verse":12,"text":"祭司,さいしは、かの雄,おすの小羊,こひつじ一頭,とうを取,とって、これを一ログの油,あぶらと共,ともに愆祭,けんさいとしてささげ、またこれを主,しゅの前,まえに揺,ゆり動,うごかして揺祭,ようさいとしなければならない。","tok":[["祭司","さいし"],["は"],["、"],["かの"],["雄","おす"],["の"],["小羊","こひつじ"],["一頭","とう"],["を"],["取って","とって"],["、"],["これ"],["を"],["一","いち"],["ログ"],["の"],["油","あぶら"],["と"],["共","とも"],["に"],["愆祭","けんさい"],["として"],["ささげ"],["、"],["また"],["これ"],["を"],["主","しゅ"],["の"],["前","まえ"],["に"],["揺り動かして","ゆりうごかして"],["揺祭","ようさい"],["と"],["しなければ"],["ならない"],["。"]]},{"verse":13,"text":"この雄,おすの小羊,こひつじは罪祭,ざいさいおよび燔祭,はんさいをほふる場所,ばしょ、すなわち聖,せいなる所,ところで、これをほふらなければならない。愆祭,けんさいは罪祭,ざいさいと同,おなじく、祭司,さいしに帰,きするものであって、いと聖,せいなる物,ものである。","tok":[["この"],["雄","おす"],["の"],["小羊","こひつじ"],["は"],["罪","つみ"],["祭","まつり"],["い"],["さ"],["い"],["および"],["燔祭","はんさい"],["を"],["ほふる"],["場所","ばしょ"],["、"],["すなわち"],["聖","せい"],["なる"],["所","ところ"],["で"],["、"],["これ"],["を"],["ほふらなければ"],["ならない"],["。"],["愆祭","けんさい"],["は"],["罪","つみ"],["祭","まつり"],["と"],["同じく","おなじく"],["、"],["祭司","さいし"],["に"],["帰する","きする"],["もの"],["で"],["あって"],["、"],["いと"],["聖","せい"],["なる"],["物","もの"],["で"],["ある"],["。"]]},{"verse":14,"text":"そして祭司,さいしはその愆祭,けんさいの血,ちを取,とり、これを清,きよめられる者,ものの右,みぎの耳,みみたぶと、右,みぎの手,ての親指,おやゆびと、右,みぎの足,あしの親指,おやゆびとにつけなければならない。","tok":[["そして"],["祭司","さいし"],["は"],["その"],["愆祭","けんさい"],["の"],["血","ち"],["を"],["取","とり"],["、"],["これ"],["を"],["清められる","きよめられる"],["者","もの"],["の"],["右","みぎ"],["の"],["耳たぶ","みみたぶ"],["と"],["、"],["右","みぎ"],["の"],["手","て"],["の"],["親指","おやゆび"],["と"],["、"],["右","みぎ"],["の"],["足","あし"],["の"],["親指","おやゆび"],["と"],["に"],["つけなければ"],["ならない"],["。"]]},{"verse":15,"text":"祭司,さいしはまた一ログの油,あぶらを取,とって、これを自分,じぶんの左,ひだりの手,てのひらに注,そそぎ、","tok":[["祭司","さいし"],["は"],["また"],["一","いち"],["ログ"],["の"],["油","あぶら"],["を"],["取って","とって"],["、"],["これ"],["を"],["自分","じぶん"],["の"],["左","ひだり"],["の"],["手のひら","てのひら"],["に"],["注ぎ","そそぎ"],["、"]]},{"verse":16,"text":"そして祭司,さいしは右,みぎの指,ゆびを左,ひだりの手,てのひらにある油,あぶらに浸,ひたし、その指,ゆびをもって、その油,あぶらを七たび主,しゅの前,まえに注,そそがなければならない。","tok":[["そして"],["祭司","さいし"],["は"],["右","みぎ"],["の"],["指","ゆび"],["を"],["左","ひだり"],["の"],["手のひら","てのひら"],["に"],["ある"],["油","あぶら"],["に"],["浸し","ひたし"],["、"],["その"],["指","ゆび"],["を"],["もって"],["、"],["その"],["油","あぶら"],["を"],["七","なな"],["たび"],["主","しゅ"],["の"],["前","まえ"],["に"],["注がなければ","そそがなければ"],["ならない"],["。"]]},{"verse":17,"text":"祭司,さいしは手,てのひらにある油,あぶらの残,のこりを、清,きよめられる者,ものの右,みぎの耳,みみたぶと、右,みぎの手,ての親指,おやゆびと、右,みぎの足,あしの親指,おやゆびとに、さきにつけた愆祭,けんさいの血,ちの上,うえにつけなければならない。","tok":[["祭司","さいし"],["は"],["手のひら","てのひら"],["に"],["ある"],["油","あぶら"],["の"],["残り","のこり"],["を"],["、"],["清められる","きよめられる"],["者","もの"],["の"],["右","みぎ"],["の"],["耳たぶ","みみたぶ"],["と"],["、"],["右","みぎ"],["の"],["手","て"],["の"],["親指","おやゆび"],["と"],["、"],["右","みぎ"],["の"],["足","あし"],["の"],["親指","おやゆび"],["と"],["に"],["、"],["さき"],["に"],["つけた"],["愆祭","けんさい"],["の"],["血","ち"],["の"],["上","うえ"],["に"],["つけなければ"],["ならない"],["。"]]},{"verse":18,"text":"そして祭司,さいしは手,てのひらになお残,のこっている油,あぶらを、清,きよめられる者,ものの頭,あたまにつけ、主,しゅの前,まえで、その人,ひとのためにあがないをしなければならない。","tok":[["そして"],["祭司","さいし"],["は"],["手のひら","てのひら"],["に"],["なお"],["残って","のこって"],["いる"],["油","あぶら"],["を"],["、"],["清められる","きよめられる"],["者","もの"],["の"],["頭","あたま"],["に"],["つけ"],["、"],["主","しゅ"],["の"],["前","まえ"],["で"],["、"],["その"],["人","ひと"],["の"],["ため"],["に"],["あがない"],["を"],["しなければ"],["ならない"],["。"]]},{"verse":19,"text":"また祭司,さいしは罪祭,ざいさいをささげて、汚,けがれのゆえに、清,きよめられねばならぬ者,もののためにあがないをし、その後,のち、燔祭,はんさいのものをほふらなければならない。","tok":[["また"],["祭司","さいし"],["は"],["罪","つみ"],["祭","まつり"],["を"],["ささげて"],["、"],["汚","けがれ"],["の"],["ゆえ"],["に"],["、"],["清められねば","きよめられねば"],["ならぬ"],["者","もの"],["の"],["ため"],["に"],["あがない"],["を"],["し"],["、"],["その後","そのの"],["ち"],["、"],["燔祭","はんさい"],["の"],["もの"],["を"],["ほふらなければ"],["ならない"],["。"]]},{"verse":20,"text":"そして祭司,さいしは燔祭,はんさいと素祭,そさいとを祭壇,さいだんの上,うえにささげ、その人,ひとのために、あがないをしなければならない。こうしてその人,ひとは清,きよくなるであろう。","tok":[["そして"],["祭司","さいし"],["は"],["燔祭","はんさい"],["と"],["素","す"],["祭","まつり"],["を"],["祭壇","さいだん"],["の"],["上","うえ"],["に"],["ささげ"],["、"],["その"],["人","ひと"],["の"],["ため"],["に"],["、"],["あがない"],["を"],["しなければ"],["ならない"],["。"],["こう"],["して"],["その"],["人","ひと"],["は"],["清く","きよく"],["なるで"],["あろう"],["。"]]},{"verse":21,"text":"その人,ひとがもし貧,まずしくて、それに手,ての届,とどかない時,ときは、自分,じぶんのあがないのために揺,ゆり動,うごかす愆祭,けんさいとして、雄,おすの小羊,こひつじ一頭,とうを取,とり、また素祭,そさいとして油,あぶらを混,まぜた麦粉,むぎこ十分,ぶんの一エパと、油,あぶら一ログとを取,とり、","tok":[["その"],["人","ひと"],["が"],["もし"],["貧しくて","まずしくて"],["、"],["それ"],["に"],["手","て"],["の"],["届かない","とどかない"],["時","とき"],["は"],["、"],["自分","じぶん"],["の"],["あがない"],["の"],["ため"],["に"],["揺り動かす","ゆりうごかす"],["愆祭","けんさい"],["として"],["、"],["雄","おす"],["の"],["小羊","こひつじ"],["一頭","とう"],["を"],["取","とり"],["、"],["また"],["素","す"],["祭","まつり"],["として"],["油","あぶら"],["を"],["混ぜた","まぜた"],["麦粉","むぎこ"],["十分","ぶん"],["の"],["一","いち"],["エパ"],["と"],["、"],["油","あぶら"],["一","いち"],["ログ"],["と"],["を"],["取","とり"],["、"]]},{"verse":22,"text":"さらにその手,ての届,とどく山,やまばと二羽,わ、または家,いえばとのひな二羽,わを取,とらなければならない。その一つは罪祭,ざいさいのため、他,たの一つは燔祭,はんさいのためである。","tok":[["さらに"],["その"],["手","て"],["の"],["届く","とどく"],["山ばと","やまばと"],["二羽","わ"],["、"],["また"],["は"],["家ばと","いえばと"],["の"],["ひな"],["二羽","わ"],["を"],["取らなければ","とらなければ"],["ならない"],["。"],["その"],["一","ひと"],["つ"],["は"],["罪","つみ"],["祭","まつり"],["の"],["ため"],["、"],["他","た"],["の"],["一","ひと"],["つ"],["は"],["燔祭","はんさい"],["の"],["ため"],["で"],["ある"],["。"]]},{"verse":23,"text":"そして八日,か目,めに、その清,きよめのために会見,かいけんの幕屋,まくやの入口,いりぐちにおる祭司,さいしのもと、主,しゅの前,まえにこれを携,たずさえて行,いかなければならない。","tok":[["そして"],["八日目","かめ"],["に"],["、"],["その"],["清め","きよめ"],["の"],["ため"],["に"],["会見","かいけん"],["の"],["幕屋","まくや"],["の"],["入口","いりぐち"],["に"],["おる"],["祭司","さいし"],["の"],["もと"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["これ"],["を"],["携えて","たずさえて"],["行かなければ","いかなければ"],["ならない"],["。"]]},{"verse":24,"text":"祭司,さいしはその愆祭,けんさいの雄,おすの小羊,こひつじと、一ログの油,あぶらとを取,とり、これを主,しゅの前,まえに揺,ゆり動,うごかして揺祭,ようさいとしなければならない。","tok":[["祭司","さいし"],["は"],["その"],["愆祭","けんさい"],["の"],["雄","おす"],["の"],["小羊","こひつじ"],["と"],["、"],["一","いち"],["ログ"],["の"],["油","あぶら"],["と"],["を"],["取","とり"],["、"],["これ"],["を"],["主","しゅ"],["の"],["前","まえ"],["に"],["揺り動かして","ゆりうごかして"],["揺祭","ようさい"],["と"],["しなければ"],["ならない"],["。"]]},{"verse":25,"text":"そして祭司,さいしは愆祭,けんさいの雄,おすの小羊,こひつじをほふり、その愆祭,けんさいの血,ちを取,とって、これを清,きよめられる者,ものの右,みぎの耳,みみたぶと、右,みぎの手,ての親指,おやゆびと、右,みぎの足,あしの親指,おやゆびとにつけなければならない。","tok":[["そして"],["祭司","さいし"],["は"],["愆祭","けんさい"],["の"],["雄","おす"],["の"],["小羊","こひつじ"],["を"],["ほふり"],["、"],["その"],["愆祭","けんさい"],["の"],["血","ち"],["を"],["取って","とって"],["、"],["これ"],["を"],["清められる","きよめられる"],["者","もの"],["の"],["右","みぎ"],["の"],["耳たぶ","みみたぶ"],["と"],["、"],["右","みぎ"],["の"],["手","て"],["の"],["親指","おやゆび"],["と"],["、"],["右","みぎ"],["の"],["足","あし"],["の"],["親指","おやゆび"],["と"],["に"],["つけなければ"],["ならない"],["。"]]},{"verse":26,"text":"また祭司,さいしはその油,あぶらを自分,じぶんの左,ひだりの手,てのひらに注,そそぎ、","tok":[["また"],["祭司","さいし"],["は"],["その"],["油","あぶら"],["を"],["自分","じぶん"],["の"],["左","ひだり"],["の"],["手のひら","てのひら"],["に"],["注ぎ","そそぎ"],["、"]]},{"verse":27,"text":"祭司,さいしはその右,みぎの指,ゆびをもって、左,ひだりの手,てのひらにある油,あぶらを、七たび主,しゅの前,まえに注,そそがなければならない。","tok":[["祭司","さいし"],["は"],["その"],["右","みぎ"],["の"],["指","ゆび"],["を"],["もって"],["、"],["左","ひだり"],["の"],["手のひら","てのひら"],["に"],["ある"],["油","あぶら"],["を"],["、"],["七","なな"],["たび"],["主","しゅ"],["の"],["前","まえ"],["に"],["注がなければ","そそがなければ"],["ならない"],["。"]]},{"verse":28,"text":"また祭司,さいしはその手,てのひらにある油,あぶらを、清,きよめられる者,ものの右,みぎの耳,みみたぶと、右,みぎの手,ての親指,おやゆびと、右,みぎの足,あしの親指,おやゆびとに、すなわち、愆祭,けんさいの血,ちをつけたところにつけなければならない。","tok":[["また"],["祭司","さいし"],["は"],["その"],["手のひら","てのひら"],["に"],["ある"],["油","あぶら"],["を"],["、"],["清められる","きよめられる"],["者","もの"],["の"],["右","みぎ"],["の"],["耳たぶ","みみたぶ"],["と"],["、"],["右","みぎ"],["の"],["手","て"],["の"],["親指","おやゆび"],["と"],["、"],["右","みぎ"],["の"],["足","あし"],["の"],["親指","おやゆび"],["と"],["に"],["、"],["すなわち"],["、"],["愆祭","けんさい"],["の"],["血","ち"],["を"],["つけた"],["ところ"],["に"],["つけなければ"],["ならない"],["。"]]},{"verse":29,"text":"また祭司,さいしは手,てのひらに残,のこっている油,あぶらを、清,きよめられる者,ものの頭,あたまにつけ、主,しゅの前,まえで、その人,ひとのために、あがないをしなければならない。","tok":[["また"],["祭司","さいし"],["は"],["手のひら","てのひら"],["に"],["残って","のこって"],["いる"],["油","あぶら"],["を"],["、"],["清められる","きよめられる"],["者","もの"],["の"],["頭","あたま"],["に"],["つけ"],["、"],["主","しゅ"],["の"],["前","まえ"],["で"],["、"],["その"],["人","ひと"],["の"],["ため"],["に"],["、"],["あがない"],["を"],["しなければ"],["ならない"],["。"]]},{"verse":30,"text":"その人,ひとはその手,ての届,とどく山,やまばと一羽,わ、または家,いえばとのひな一羽,わをささげなければならない。","tok":[["その"],["人","ひと"],["は"],["その"],["手","て"],["の"],["届く","とどく"],["山ばと","やまばと"],["一羽","わ"],["、"],["また"],["は"],["家ばと","いえばと"],["の"],["ひな"],["一羽","わ"],["を"],["ささげなければ"],["ならない"],["。"]]},{"verse":31,"text":"すなわち、その手,ての届,とどくものの一つを罪祭,ざいさいとし、他,たの一つを燔祭,はんさいとして素祭,そさいと共,ともにささげなければならない。こうして祭司,さいしは清,きよめられる者,もののために、主,しゅの前,まえにあがないをするであろう。","tok":[["すなわち"],["、"],["その"],["手","て"],["の"],["届く","とどく"],["もの"],["の"],["一","ひと"],["つ"],["を"],["罪","つみ"],["祭","まつり"],["い"],["さい"],["と"],["し"],["、"],["他","た"],["の"],["一","ひと"],["つ"],["を"],["燔祭","はんさい"],["として"],["素","す"],["祭","まつり"],["と"],["共","とも"],["に"],["ささげなければ"],["ならない"],["。"],["こう"],["して"],["祭司","さいし"],["は"],["清められる","きよめられる"],["者","もの"],["の"],["ため"],["に"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["あがない"],["を"],["するで"],["あろう"],["。"]]},{"verse":32,"text":"これはらい病,びょうの患者,かんじゃで、その清,きよめに必要,ひつようなものに、手,ての届,とどかない者,もののためのおきてである」。","tok":[["これ"],["は"],["らい病","らいびょう"],["の"],["患者","かんじゃ"],["で"],["、"],["その"],["清め","きよめ"],["に"],["必要","ひつよう"],["な"],["もの"],["に"],["、"],["手","て"],["の"],["届かない","とどかない"],["者","もの"],["の"],["ため"],["の"],["おきて"],["で"],["ある"],["」"],["。"]]},{"verse":33,"text":"主,しゅはまたモーセとアロンに言,いわれた、","tok":[["主","しゅ"],["は"],["また"],["モーセ"],["と"],["アロン"],["に"],["言われた","いわれた"],["、"]]},{"verse":34,"text":"「あなたがたに所有,しょゆうとして与,あたえるカナンの地,ちに、あなたがたがはいる時,とき、その所有,しょゆうの地,ちにおいて、家,いえにわたしがらい病,びょうの患部,かんぶを生,しょうじさせることがあれば、","tok":[["「"],["あなた"],["がた"],["に"],["所有","しょゆう"],["として"],["与える","あたえる"],["カナン"],["の"],["地","ち"],["に"],["、"],["あなた"],["がた"],["が"],["はいる"],["時","とき"],["、"],["その"],["所有","しょゆう"],["の"],["地","ち"],["に"],["おいて"],["、"],["家","いえ"],["に"],["わたし"],["が"],["らい病","らいびょう"],["の"],["患部","かんぶ"],["を"],["生じさせる","しょうじさせる"],["こと"],["が"],["あれば"],["、"]]},{"verse":35,"text":"その家,いえの持,もち主,ぬしはきて、祭司,さいしに告,つげ、『患部,かんぶのようなものが、わたしの家,いえにあります』と言,いわなければならない。","tok":[["その"],["家","いえ"],["の"],["持主","もちぬし"],["は"],["きて"],["、"],["祭司","さいし"],["に"],["告","つげ"],["、"],["『"],["患部","かんぶ"],["の"],["よう"],["な"],["もの"],["が"],["、"],["わたし"],["の"],["家","いえ"],["に"],["あります"],["』"],["と"],["言わなければ","いわなければ"],["ならない"],["。"]]},{"verse":36,"text":"祭司,さいしは命,めいじて、祭司,さいしがその患部,かんぶを見,みに行,いく前,まえに、その家,いえをあけさせ、その家,いえにあるすべての物,ものが汚,けがされないようにし、その後,のち、祭司,さいしは、はいってその家,いえを見,みなければならない。","tok":[["祭司","さいし"],["は"],["命じて","めいじて"],["、"],["祭司","さいし"],["が"],["その"],["患部","かんぶ"],["を"],["見","み"],["に"],["行く","いく"],["前","まえ"],["に"],["、"],["その"],["家","いえ"],["を"],["あけさせ"],["、"],["その"],["家","いえ"],["に"],["ある"],["すべて"],["の"],["物","もの"],["が"],["汚","け"],["が"],["されない"],["よう"],["に"],["し"],["、"],["その後","そのの"],["ち"],["、"],["祭司","さいし"],["は"],["、"],["はいって"],["その"],["家","いえ"],["を"],["見なければ","みなければ"],["ならない"],["。"]]},{"verse":37,"text":"その患部,かんぶを見,みて、もしその患部,かんぶが家,いえの壁,かべにあって、青,あおまたは赤,あかのくぼみをもち、それが壁,かべよりも低,ひくく見,みえるならば、","tok":[["その"],["患部","かんぶ"],["を"],["見て","みて"],["、"],["もし"],["その"],["患部","かんぶ"],["が"],["家","いえ"],["の"],["壁","かべ"],["に"],["あって"],["、"],["青","あお"],["また"],["は"],["赤","あか"],["の"],["くぼみ"],["を"],["もち"],["、"],["それ"],["が"],["壁","かべ"],["より"],["も"],["低く","ひくく"],["見えるならば","みえるならば"],["、"]]},{"verse":38,"text":"祭司,さいしはその家,いえを出,でて、家,いえの入口,いりぐちにいたり、七日,なぬかの間,あいだその家,いえを閉鎖,へいさしなければならない。","tok":[["祭司","さいし"],["は"],["その"],["家","いえ"],["を"],["出て","でて"],["、"],["家","いえ"],["の"],["入口","いりぐち"],["に"],["い"],["たり"],["、"],["七日","なぬか"],["の"],["間","あいだ"],["その"],["家","いえ"],["を"],["閉鎖","へいさ"],["しなければ"],["ならない"],["。"]]},{"verse":39,"text":"祭司,さいしは七日,なぬか目,めに、またきてそれを見,み、その患部,かんぶがもし家,いえの壁,かべに広,ひろがっているならば、","tok":[["祭司","さいし"],["は"],["七日","な"],["ぬか目","ぬかめ"],["に"],["、"],["また"],["きて"],["それ"],["を"],["見","み"],["、"],["その"],["患部","かんぶ"],["が"],["もし"],["家","いえ"],["の"],["壁","かべ"],["に"],["広がって","ひろがって"],["いるならば"],["、"]]},{"verse":40,"text":"祭司,さいしは命,めいじて、その患部,かんぶのある石,いしを取,とり出,だし、町,まちの外,そとの汚,けがれた物,ものを捨,すてる場所,ばしょに捨,すてさせ、","tok":[["祭司","さいし"],["は"],["命じて","めいじて"],["、"],["その"],["患部","かんぶ"],["の"],["ある"],["石","いし"],["を"],["取出し","とりだし"],["、"],["町","まち"],["の"],["外","そと"],["の"],["汚","け"],["がれ"],["た"],["物","もの"],["を"],["捨てる","すてる"],["場所","ばしょ"],["に"],["捨てさせ","すてさせ"],["、"]]},{"verse":41,"text":"またその家,いえの内側,うちがわのまわりを削,けずらせ、その削,けずったしっくいを町,まちの外,そとの汚,けがれた物,ものを捨,すてる場所,ばしょに捨,すてさせ、","tok":[["また"],["その"],["家","いえ"],["の"],["内側","うちがわ"],["の"],["まわり"],["を"],["削らせ","けずらせ"],["、"],["その"],["削った","けずった"],["しっくい"],["を"],["町","まち"],["の"],["外","そと"],["の"],["汚","け"],["がれ"],["た"],["物","もの"],["を"],["捨てる","すてる"],["場所","ばしょ"],["に"],["捨てさせ","すてさせ"],["、"]]},{"verse":42,"text":"ほかの石,いしを取,とって、元,もとの石,いしのところに入,いれさせ、またほかのしっくいを取,とって、家,いえを塗,ぬらせなければならない。","tok":[["ほか"],["の"],["石","いし"],["を"],["取って","とって"],["、"],["元","もと"],["の"],["石","いし"],["の"],["ところ"],["に"],["入れさせ","いれさせ"],["、"],["また"],["ほか"],["の"],["しっくい"],["を"],["取って","とって"],["、"],["家","いえ"],["を"],["塗らせなければ","ぬらせなければ"],["ならない"],["。"]]},{"verse":43,"text":"このように石,いしを取,とり出,だし、家,いえを削,けずり、塗,ぬりかえた後,のちに、その患部,かんぶがもし再,ふたたび家,いえに出,でるならば、","tok":[["この"],["よう"],["に"],["石","いし"],["を"],["取出し","とりだし"],["、"],["家","いえ"],["を"],["削り","けずり"],["、"],["塗","ぬり"],["かえた"],["後","のち"],["に"],["、"],["その"],["患部","かんぶ"],["が"],["もし"],["再び","ふたたび"],["家","いえ"],["に"],["出るならば","でるならば"],["、"]]},{"verse":44,"text":"祭司,さいしはまたきて見,みなければならない。患部,かんぶがもし家,いえに広,ひろがっているならば、これは家,いえにある悪性,あくせいのらい病,びょうであって、これは汚,けがれた物,ものである。","tok":[["祭司","さいし"],["は"],["また"],["きて"],["見なければ","みなければ"],["ならない"],["。"],["患部","かんぶ"],["が"],["もし"],["家","いえ"],["に"],["広がって","ひろがって"],["いるならば"],["、"],["これ"],["は"],["家","いえ"],["に"],["ある"],["悪性","あくせい"],["の"],["らい病","らいびょう"],["で"],["あって"],["、"],["これ"],["は"],["汚","け"],["がれ"],["た"],["物","もの"],["で"],["ある"],["。"]]},{"verse":45,"text":"その家,いえは、こぼち、その石,いし、その木,き、その家,いえのしっくいは、ことごとく町,まちの外,そとの汚,けがれた物,ものを捨,すてる場所,ばしょに運,はこび出,ださなければならない。","tok":[["その"],["家","いえ"],["は"],["、"],["こ"],["ぼ"],["ち"],["、"],["その"],["石","いし"],["、"],["その"],["木","き"],["、"],["その"],["家","いえ"],["の"],["しっくい"],["は"],["、"],["ことごとく"],["町","まち"],["の"],["外","そと"],["の"],["汚","け"],["がれ"],["た"],["物","もの"],["を"],["捨てる","すてる"],["場所","ばしょ"],["に"],["運こび","はこび"],["出さなければ","ださなければ"],["ならない"],["。"]]},{"verse":46,"text":"その家,いえが閉鎖,へいさされている日,ひの間,あいだに、これにはいる者,ものは夕,ゆうまで汚,けがれるであろう。","tok":[["その"],["家","いえ"],["が"],["閉鎖","へいさ"],["されて"],["いる"],["日","ひ"],["の"],["間","あいだ"],["に"],["、"],["これ"],["に"],["はいる"],["者","もの"],["は"],["夕","ゆう"],["まで"],["汚","け"],["がれる"],["で"],["あろう"],["。"]]},{"verse":47,"text":"その家,いえに寝,ねる者,ものはその衣服,いふくを洗,あらわなければならない。その家,いえで食,しょくする者,ものも、その衣服,いふくを洗,あらわなければならない。","tok":[["その"],["家","いえ"],["に"],["寝る","ねる"],["者","もの"],["は"],["その"],["衣服","いふく"],["を"],["洗わなければ","あらわなければ"],["ならない"],["。"],["その"],["家","いえ"],["で"],["食する","しょくする"],["者","もの"],["も"],["、"],["その"],["衣服","いふく"],["を"],["洗わなければ","あらわなければ"],["ならない"],["。"]]},{"verse":48,"text":"しかし、祭司,さいしがはいって見,みて、もし家,いえを塗,ぬりかえた後,のちに、その患部,かんぶが家,いえに広,ひろがっていなければ、これはその患部,かんぶがいえたのであるから、祭司,さいしはその家,いえを清,きよいものとしなければならない。","tok":[["しかし"],["、"],["祭司","さいし"],["が"],["はいって"],["見て","みて"],["、"],["もし"],["家","いえ"],["を"],["塗","ぬり"],["かえた"],["後","のち"],["に"],["、"],["その"],["患部","かんぶ"],["が"],["家","いえ"],["に"],["広がって","ひろがって"],["いなければ"],["、"],["これ"],["は"],["その"],["患部","かんぶ"],["が"],["いえた"],["ので"],["ある"],["から"],["、"],["祭司","さいし"],["は"],["その"],["家","いえ"],["を"],["清い","きよい"],["もの"],["と"],["しなければ"],["ならない"],["。"]]},{"verse":49,"text":"また彼,かれはその家,いえを清,きよめるために、小鳥,ことり二羽,わと、香柏,こうはくの木,きと、緋,ひの糸,いとと、ヒソプとを取,とり、","tok":[["また"],["彼","かれ"],["は"],["その"],["家","いえ"],["を"],["清める","きよめる"],["ため"],["に"],["、"],["小鳥","ことり"],["二羽","わ"],["と"],["、"],["香","こう"],["柏","かしわ"],["の"],["木","き"],["と"],["、"],["緋","ひ"],["の"],["糸","いと"],["と"],["、"],["ヒソプ"],["と"],["を"],["取","とり"],["、"]]},{"verse":50,"text":"その小鳥,ことりの一羽,わを流,ながれ水,みずを盛,もった土,つちの器,うつわの上,うえで殺,ころし、","tok":[["その"],["小鳥","ことり"],["の"],["一羽","わ"],["を"],["流れ水","ながれみず"],["を"],["盛った","もった"],["土","つち"],["の"],["器","うつわ"],["の"],["上","うえ"],["で"],["殺ろし","ころし"],["、"]]},{"verse":51,"text":"香柏,こうはくの木,きと、ヒソプと、緋,ひの糸,いとと、生,いきている小鳥,ことりとを取,とって、その殺,ころした小鳥,ことりの血,ちと流,ながれ水,みずに浸,ひたし、これを七たび家,いえに注,そそがなければならない。","tok":[["香","こう"],["柏","かしわ"],["の"],["木","き"],["と"],["、"],["ヒソプ"],["と"],["、"],["緋","ひ"],["の"],["糸","いと"],["と"],["、"],["生きて","いきて"],["いる"],["小鳥","ことり"],["と"],["を"],["取って","とって"],["、"],["その"],["殺ろした","ころした"],["小鳥","ことり"],["の"],["血","ち"],["と"],["流れ水","ながれみず"],["に"],["浸し","ひたし"],["、"],["これ"],["を"],["七","なな"],["たび家","たびいえ"],["に"],["注がなければ","そそがなければ"],["ならない"],["。"]]},{"verse":52,"text":"こうして祭司,さいしは小鳥,ことりの血,ちと流,ながれ水,みずと、生,いきている小鳥,ことりと、香柏,こうはくの木,きと、ヒソプと、緋,ひの糸,いととをもって家,いえを清,きよめ、","tok":[["こう"],["して"],["祭司","さいし"],["は"],["小鳥","ことり"],["の"],["血","ち"],["と"],["流れ水","ながれみず"],["と"],["、"],["生きて","いきて"],["いる"],["小鳥","ことり"],["と"],["、"],["香","こう"],["柏","かしわ"],["の"],["木","き"],["と"],["、"],["ヒソプ"],["と"],["、"],["緋","ひ"],["の"],["糸","いと"],["と"],["を"],["もって"],["家","いえ"],["を"],["清め","きよめ"],["、"]]},{"verse":53,"text":"その生,いきている小鳥,ことりは町,まちの外,そとの野,のに放,はなして、その家,いえのために、あがないをしなければならない。こうして、それは清,きよくなるであろう」。","tok":[["その"],["生きて","いきて"],["いる"],["小鳥","ことり"],["は"],["町","まち"],["の"],["外","そと"],["の"],["野","の"],["に"],["放して","はなして"],["、"],["その"],["家","いえ"],["の"],["ため"],["に"],["、"],["あがない"],["を"],["しなければ"],["ならない"],["。"],["こう"],["して"],["、"],["それ"],["は"],["清く","きよく"],["なるで"],["あろう"],["」"],["。"]]},{"verse":54,"text":"これはらい病,びょうのすべての患部,かんぶ、かいせん、","tok":[["これ"],["は"],["らい病","らいびょう"],["の"],["すべて"],["の"],["患部","かんぶ"],["、"],["かい"],["せん"],["、"]]},{"verse":55,"text":"および衣服,いふくと家,いえのらい病,びょう、","tok":[["および"],["衣服","いふく"],["と"],["家","いえ"],["の"],["らい病","らいびょう"],["、"]]},{"verse":56,"text":"ならびに腫,しゅと、吹出物,ふきでものと、光,ひかる所,ところとに関,かんするおきてであって、","tok":[["ならびに"],["腫","しゅ"],["と"],["、"],["吹出物","ふきでもの"],["と"],["、"],["光る","ひかる"],["所","ところ"],["と"],["に"],["関する","かんする"],["おきて"],["で"],["あって"],["、"]]},{"verse":57,"text":"いつそれが汚,けがれているか、いつそれが清,きよいかを教,おしえるものである。これがらい病,びょうに関,かんするおきてである。","tok":[["いつ"],["それ"],["が"],["汚","け"],["がれ"],["て"],["いる"],["か"],["、"],["いつ"],["それ"],["が"],["清い","きよい"],["か"],["を"],["教える","おしえる"],["もの"],["で"],["ある"],["。"],["これ"],["が"],["らい病","らいびょう"],["に"],["関する","かんする"],["おきて"],["で"],["ある"],["。"]]}]
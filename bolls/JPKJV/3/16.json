,["前","まえ"],["に"],["、"],["七","なな"],["たび"],["注がなければ","そそがなければ"],["ならない"],["。"]]},{"verse":15,"text":"また民,たみのための罪祭,ざいさいのやぎをほふり、その血,ちを垂幕,たれまくの内,うちに携,たずさえ入,いり、その血,ちをかの雄牛,おうしの血,ちのように、贖罪所,しょくざいしょの上,うえと、贖罪所,しょくざいしょの前,まえに注,そそぎ、","tok":[["また"],["民","たみ"],["の"],["ため"],["の"],["罪","つみ"],["祭","まつり"],["の"],["やぎ"],["を"],["ほふり"],["、"],["その"],["血","ち"],["を"],["垂幕","たれまく"],["の"],["内","うち"],["に"],["携え","たずさえ"],["入","いり"],["、"],["その"],["血","ち"],["を"],["かの"],["雄牛","おうし"],["の"],["血","ち"],["の"],["よう"],["に"],["、"],["贖罪所","しょくざいしょ"],["の"],["上","うえ"],["と"],["、"],["贖罪所","しょくざいしょ"],["の"],["前","まえ"],["に"],["注ぎ","そそぎ"],["、"]]},{"verse":16,"text":"イスラエルの人々,ひとびとの汚,けがれと、そのとが、すなわち、彼,かれらのもろもろの罪,つみのゆえに、聖所,せいじょのためにあがないをしなければならない。また彼,かれらの汚,けがれのうちに、彼,かれらと共,ともにある会見,かいけんの幕屋,まくやのためにも、そのようにしなければならない。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["の"],["汚","けがれ"],["と"],["、"],["その"],["とが"],["、"],["すなわち"],["、"],["彼","かれ"],["ら"],["の"],["もろもろ"],["の"],["罪","つみ"],["の"],["ゆえ"],["に"],["、"],["聖","せい"],["所","しょ"],["の"],["ため"],["に"],["あがない"],["を"],["しなければ"],["ならない"],["。"],["また"],["彼","かれ"],["ら"],["の"],["汚","けがれ"],["の"],["うち"],["に"],["、"],["彼","かれ"],["ら"],["と"],["共","とも"],["に"],["ある"],["会見","かいけん"],["の"],["幕屋","まくや"],["の"],["ため"],["に"],["も"],["、"],["その"],["よう"],["に"],["しなければ"],["ならない"],["。"]]},{"verse":17,"text":"彼,かれが聖所,せいじょであがないをするために、はいった時,ときは、自分,じぶんと自分,じぶんの家族,かぞくと、イスラエルの全,ぜん会衆,かいしゅうとのために、あがないをなし終,おえて出,でるまで、だれも会見,かいけんの幕屋,まくやの内,うちにいてはならない。","tok":[["彼","かれ"],["が"],["聖","せい"],["所","しょ"],["が"],["ない"],["を"],["する"],["ため"],["に"],["、"],["はいった"],["時","とき"],["は"],["、"],["自分","じぶん"],["と"],["自分","じぶん"],["の"],["家族","かぞく"],["と"],["、"],["イスラエル"],["の"],["全","ぜん"],["会衆","かいしゅう"],["と"],["の"],["ため"],["に"],["、"],["あがない"],["を"],["なし"],["終えて","おえて"],["出る","でる"],["まで"],["、"],["だれ"],["も"],["会見","かいけん"],["の"],["幕屋","まくや"],["の"],["内","うち"],["に"],["いて"],["は"],["ならない"],["。"]]},{"verse":18,"text":"そして彼,かれは主,しゅの前,まえの祭壇,さいだんのもとに出,でてきて、これがために、あがないをしなければならない、すなわち、かの雄牛,おうしの血,ちと、やぎの血,ちとを取,とって祭壇,さいだんの四すみの角,つのにつけ、","tok":[["そして"],["彼","かれ"],["は"],["主","しゅ"],["の"],["前","まえ"],["の"],["祭壇","さいだん"],["の"],["もと"],["に"],["出て","でて"],["きて"],["、"],["これ"],["が"],["ため"],["に"],["、"],["あがない"],["を"],["しなければ"],["ならない"],["、"],["すなわち"],["、"],["かの"],["雄牛","おうし"],["の"],["血","ち"],["と"],["、"],["やぎ"],["の"],["血","ち"],["と"],["を"],["取って","とって"],["祭壇","さいだん"],["の"],["四","よん"],["すみ"],["の"],["角","つ"],["の"],["につけ"],["、"]]},{"verse":19,"text":"また指,ゆびをもって七たびその血,ちをその上,うえに注,そそぎ、イスラエルの人々,ひとびとの汚,けがれを除,のぞいてこれを清,きよくし、聖別,せいべつしなければならない。","tok":[["また"],["指","ゆび"],["を"],["もって"],["七","なな"],["たび"],["その"],["血","ち"],["を"],["その"],["上","うえ"],["に"],["注ぎ","そそぎ"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["汚","けがれ"],["を"],["除いて","のぞいて"],["これ"],["を"],["清く","きよく"],["し"],["、"],["聖別","せいべつ"],["しなければ"],["ならない"],["。"]]},{"verse":20,"text":"こうして聖所,せいじょと会見,かいけんの幕屋,まくやと祭壇,さいだんとのために、あがないをなし終,おえたとき、かの生,いきているやぎを引,ひいてこなければならない。","tok":[["こう"],["して"],["聖","せい"],["所","しょ"],["と"],["会見","かいけん"],["の"],["幕屋","まくや"],["と"],["祭壇","さいだん"],["と"],["の"],["ため"],["に"],["、"],["あがない"],["を"],["なし"],["終えた","おえた"],["とき"],["、"],["かの"],["生きて","いきて"],["いる"],["やぎ"],["を"],["引いて","ひいて"],["こなければ"],["ならない"],["。"]]},{"verse":21,"text":"そしてアロンは、その生,いきているやぎの頭,あたまに両手,りょうてをおき、イスラエルの人々,ひとびとのもろもろの悪,あくと、もろもろのとが、すなわち、彼,かれらのもろもろの罪,つみをその上,うえに告白,こくはくして、これをやぎの頭,あたまにのせ、定,さだめておいた人,ひとの手,てによって、これを荒野,あらのに送,おくらなければならない。","tok":[["そして"],["アロン"],["は"],["、"],["その"],["生きて","いきて"],["いる"],["やぎ"],["の"],["頭","あたま"],["に"],["両手","りょうて"],["を"],["おき"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["もろもろ"],["の"],["悪","あく"],["と"],["、"],["もろもろ"],["の"],["と"],["が"],["、"],["すなわち"],["、"],["彼","かれ"],["ら"],["の"],["もろもろ"],["の"],["罪","つみ"],["を"],["その"],["上","うえ"],["に"],["告白","こくはく"],["して"],["、"],["これ"],["を"],["やぎ"],["の"],["頭","あたま"],["に"],["のせ"],["、"],["定めて","さだめて"],["おいた"],["人","ひと"],["の"],["手","て"],["によって"],["、"],["これ"],["を"],["荒野","あらの"],["に"],["送らなければ","おくらなければ"],["ならない"],["。"]]},{"verse":22,"text":"こうしてやぎは彼,かれらのもろもろの悪,あくをになって、人里,ひとざと離,はなれた地,ちに行,いくであろう。すなわち、そのやぎを荒野,あらのに送,おくらなければならない。","tok":[["こう"],["して"],["やぎ"],["は"],["彼","かれ"],["ら"],["の"],["もろもろ"],["の"],["悪","あく"],["を"],["に"],["なって"],["、"],["人里","ひとざと"],["離れた","はなれた"],["地","ち"],["に"],["行くで","いくで"],["あろう"],["。"],["すなわち"],["、"],["その"],["やぎ"],["を"],["荒野","あらの"],["に"],["送らなければ","おくらなければ"],["ならない"],["。"]]},{"verse":23,"text":"そして、アロンは会見,かいけんの幕屋,まくやに入,いり、聖所,せいじょに入,いる時,ときに着,きた亜麻,あま布,ぬのの衣服,いふくを脱,ぬいで、そこに置,おき、","tok":[["そして"],["、"],["アロン"],["は"],["会見","かいけん"],["の"],["幕屋","まくや"],["に"],["入","いり"],["、"],["聖","せい"],["所","しょ"],["に"],["入る","いる"],["時","とき"],["に"],["着た","きた"],["亜","あ"],["麻布","麻ぬの"],["の"],["衣服","いふく"],["を"],["脱いで","ぬいで"],["、"],["そこ"],["に"],["置き","おき"],["、"]]},{"verse":24,"text":"聖,せいなる所,ところで水,みずに身,みをすすぎ、他,たの衣服,いふくを着,き、出,でてきて、自分,じぶんの燔祭,はんさいと民,たみの燔祭,はんさいとをささげて、自分,じぶんのため、また民,たみのために、あがないをしなければならない。","tok":[["聖","せい"],["なる"],["所","ところ"],["で"],["水","みず"],["に"],["身","み"],["を"],["すすぎ"],["、"],["他","た"],["の"],["衣服","いふく"],["を"],["着","き"],["、"],["出て","でて"],["きて"],["、"],["自分","じぶん"],["の"],["燔祭","はんさい"],["と"],["民","たみ"],["の"],["燔祭","はんさい"],["と"],["を"],["ささげて"],["、"],["自分","じぶん"],["の"],["ため"],["、"],["また"],["民","たみ"],["の"],["ため"],["に"],["、"],["あがない"],["を"],["しなければ"],["ならない"],["。"]]},{"verse":25,"text":"また罪祭,ざいさいの脂肪,しぼうを祭壇,さいだんの上,うえで焼,やかなければならない。","tok":[["また"],["罪","つみ"],["祭","まつり"],["の"],["脂肪","しぼう"],["を"],["祭壇","さいだん"],["の"],["上","うえ"],["で"],["焼かなければ","やかなければ"],["ならない"],["。"]]},{"verse":26,"text":"かのやぎをアザゼルに送,おくった者,ものは衣服,いふくを洗,あらい、水,みずに身,みをすすがなければならない。その後,のち、宿営,しゅくえいに入,いることができる。","tok":[["かの"],["やぎ"],["を"],["アザゼル"],["に"],["送った","おくった"],["者","もの"],["は"],["衣服","いふく"],["を"],["洗","あらい"],["、"],["水","みず"],["に"],["身","み"],["を"],["すすがなければ"],["ならない"],["。"],["その後","そのの"],["ち"],["、"],["宿営","しゅくえい"],["に"],["入","いる"],["こと"],["が"],["できる"],["。"]]},{"verse":27,"text":"聖所,せいじょで、あがないをするために、その血,ちを携,たずさえ入,いれられた罪祭,ざいさいの雄牛,おうしと、罪祭,ざいさいのやぎとは、宿営,しゅくえいの外,そとに携,たずさえ出,だし、その皮,かわと肉,にくと汚物,おぶつとは、火,ひで焼,やき捨,すてなければならない。","tok":[["聖","せい"],["所","しょ"],["い"],["じょ"],["で"],["、"],["あがない"],["を"],["する"],["ため"],["に"],["、"],["その"],["血","ち"],["を"],["携え","たずさえ"],["入れられた","いれられた"],["罪","つみ"],["祭","まつり"],["の"],["雄牛","おうし"],["と"],["、"],["罪","つみ"],["祭","まつり"],["の"],["やぎ"],["と"],["は"],["、"],["宿営","しゅくえい"],["の"],["外","そと"],["に"],["携え","たずさえ"],["出し","だし"],["、"],["その"],["皮","かわ"],["と"],["肉","にく"],["と"],["汚物","おぶつ"],["と"],["は"],["、"],["火","ひ"],["で"],["焼き捨てなければ","やきすてなければ"],["ならない"],["。"]]},{"verse":28,"text":"これを焼,やく者,ものは衣服,いふくを洗,あらい、水,みずに身,みをすすがなければならない。その後,のち、宿営,しゅくえいに入,いることができる。","tok":[["これ"],["を"],["焼く","やく"],["者","もの"],["は"],["衣服","いふく"],["を"],["洗","あらい"],["、"],["水","みず"],["に"],["身","み"],["を"],["すすがなければ"],["ならない"],["。"],["その後","そのの"],["ち"],["、"],["宿営","しゅくえい"],["に"],["入","いる"],["こと"],["が"],["できる"],["。"]]},{"verse":29,"text":"これはあなたがたが永久,えいきゅうに守,まもるべき定,さだめである。すなわち、七月,がつになって、その月,つきの十日,かに、あなたがたは身,みを悩,なやまし、何,なにの仕事,しごともしてはならない。この国,くにに生,うまれた者,ものも、あなたがたのうちに宿,やどっている寄留者,きりゅうしゃも、そうしなければならない。","tok":[["これ"],["は"],["あなた"],["がた"],["が"],["永久","えいきゅう"],["に"],["守","まもる"],["べき"],["定","さだめ"],["で"],["ある"],["。"],["すなわち"],["、"],["七","なな"],["月","がつ"],["に"],["なって"],["、"],["その"],["月","つき"],["の"],["十日","か"],["に"],["、"],["あなた"],["がた"],["は"],["身","み"],["を"],["悩し","なやまし"],["、"],["何","なに"],["の"],["仕事","しごと"],["も"],["して"],["は"],["ならない"],["。"],["この"],["国","くに"],["に"],["生まれた","うまれた"],["者","もの"],["も"],["、"],["あなた"],["がた"],["の"],["うち"],["に"],["宿って","やどって"],["いる"],["寄留者","きりゅうしゃ"],["も"],["、"],["そう"],["しなければ"],["ならない"],["。"]]},{"verse":30,"text":"この日,ひにあなたがたのため、あなたがたを清,きよめるために、あがないがなされ、あなたがたは主,しゅの前,まえに、もろもろの罪,つみが清,きよめられるからである。","tok":[["この"],["日","ひ"],["に"],["あなた"],["がた"],["の"],["ため"],["、"],["あなた"],["がた"],["を"],["清める","きよめる"],["ため"],["に"],["、"],["あ"],["が"],["ない"],["が"],["なされ"],["、"],["あなた"],["がた"],["は"],["主","しゅ"],["の"],["前","まえ"],["に"],["、"],["もろもろ"],["の"],["罪","つみ"],["が"],["清められる","きよめられる"],["から"],["で"],["ある"],["。"]]},{"verse":31,"text":"これはあなたがたの全,まったき休,やすみの安息日,あんそくにちであって、あなたがたは身,みを悩,なやまさなければならない。これは永久,えいきゅうに守,まもるべき定,さだめである。","tok":[["これ"],["は"],["あなた"],["がた"],["の"],["全","ま"],["っ"],["たき"],["休み","やすみ"],["の"],["安息日","あん"],["そ"],["く"],["にち"],["で"],["あって"],["、"],["あなた"],["がた"],["は"],["身","み"],["を"],["悩さなければ","なやまさなければ"],["ならない"],["。"],["これ"],["は"],["永久","えいきゅう"],["に"],["守","まもる"],["べき"],["定","さだめ"],["で"],["ある"],["。"]]},{"verse":32,"text":"油,あぶらを注,そそがれ、父,ちちに代,かわって祭司,さいしの職,しょくに任,にんじられる祭司,さいしは、亜麻,あま布,ぬのの衣服,いふく、すなわち、聖,せいなる衣服,いふくを着,きて、あがないをしなければならない。","tok":[["油","あぶら"],["を"],["注がれ","そそがれ"],["、"],["父","ちち"],["に"],["代わって","かわって"],["祭司","さいし"],["の"],["職","しょく"],["に"],["任じられる","にんじられる"],["祭司","さいし"],["は"],["、"],["亜","あ"],["麻布","麻ぬの"],["の"],["衣服","いふく"],["、"],["すなわち"],["、"],["聖","せい"],["なる"],["衣服","いふく"],["を"],["着て","きて"],["、"],["あがない"],["を"],["しなければ"],["ならない"],["。"]]},{"verse":33,"text":"彼,かれは至聖所,しせいじょのために、あがないをなし、また会見,かいけんの幕屋,まくやのためと、祭壇,さいだんのために、あがないをなし、また祭司,さいしたちのためと、民,たみの全,ぜん会衆,かいしゅうのために、あがないをしなければならない。","tok":[["彼","かれ"],["は"],["至聖所","しせいじょ"],["の"],["ため"],["に"],["、"],["あがない"],["を"],["なし"],["、"],["また"],["会見","かいけん"],["の"],["幕屋","まくや"],["の"],["ため"],["と"],["、"],["祭壇","さいだん"],["の"],["ため"],["に"],["、"],["あがない"],["を"],["なし"],["、"],["また"],["祭司","さいし"],["たち"],["の"],["ため"],["と"],["、"],["民","たみ"],["の"],["全","ぜん"],["会衆","かいしゅう"],["の"],["ため"],["に"],["、"],["あがない"],["を"],["しなければ"],["ならない"],["。"]]},{"verse":34,"text":"これはあなたがたの永久,えいきゅうに守,まもるべき定,さだめであって、イスラエルの人々,ひとびとのもろもろの罪,つみのために、年,ねんに一度,どあがないをするものである」。彼,かれは主,しゅがモーセに命,めいじられたとおりにおこなった。","tok":[["これ"],["は"],["あなた"],["がた"],["の"],["永久","えいきゅう"],["に"],["守","まもる"],["べき"],["定","さだめ"],["で"],["あって"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["もろもろ"],["の"],["罪","つみ"],["の"],["ため"],["に"],["、"],["年","ねん"],["に"],["一度","どあ"],["が"],["ない"],["を"],["する"],["もの"],["で"],["ある"],["」"],["。"],["彼","かれ"],["は"],["主","しゅ"],["が"],["モーセ"],["に"],["命じられた","めいじられた"],["とおり"],["に"],["おこなった"],["。"]]}]
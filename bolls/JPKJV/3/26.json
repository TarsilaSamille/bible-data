[{"verse":1,"text":"あなたがたは自分,じぶんのために、偶像,ぐうぞうを造,つくってはならない。また刻,きざんだ像,ぞうも石,いしの柱,はしらも立,たててはならない。またあなたがたの地,ちに石像,せきぞうを立,たてて、それを拝,おがんではならない。わたしはあなたがたの神,かみ、主,しゅだからである。","tok":[["あなた"],["がた"],["は"],["自分","じぶん"],["の"],["ため"],["に"],["、"],["偶像","ぐうぞう"],["を"],["造って","つくって"],["は"],["ならない"],["。"],["また"],["刻んだ","きざんだ"],["像","ぞう"],["も"],["石","いし"],["の"],["柱","はしら"],["も"],["立てて","たてて"],["は"],["ならない"],["。"],["また"],["あなた"],["がた"],["の"],["地","ち"],["に"],["石像","せきぞう"],["を"],["立てて","たてて"],["、"],["それ"],["を"],["拝","おがん"],["で"],["は"],["ならない"],["。"],["わたし"],["は"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主らで","しゅだからで"],["ある"],["。"]]},{"verse":2,"text":"あなたがたはわたしの安息日,あんそくにちを守,まもり、またわたしの聖所,せいじょを敬,うやまわなければならない。わたしは主,しゅである。","tok":[["あなた"],["がた"],["は"],["わたし"],["の"],["安息日","あんそくにち"],["を"],["守り","まもり"],["、"],["また"],["わたし"],["の"],["聖","せい"],["所","しょ"],["を"],["敬わなければ","うやまわなければ"],["ならない"],["。"],["わたし"],["は"],["主","しゅ"],["で"],["ある"],["。"]]},{"verse":3,"text":"もしあなたがたがわたしの定,さだめに歩,あゆみ、わたしの戒,いましめを守,まもって、これを行,おこなうならば、","tok":[["もし"],["あなた"],["がた"],["が"],["わたし"],["の"],["定め","さだめ"],["に"],["歩み","あゆみ"],["、"],["わたし"],["の"],["戒しめ","いましめ"],["を"],["守って","まもって"],["、"],["これ"],["を"],["行なうならば","おこなうならば"],["、"]]},{"verse":4,"text":"わたしはその季節,きせつ季節,きせつに、雨,あめをあなたがたに与,あたえるであろう。地,ちは産物,さんぶつを出,だし、畑,はたけの木々,きぎは実,みを結,むすぶであろう。","tok":[["わたし"],["は"],["その"],["季節","きせつ"],["季節","きせつ"],["に"],["、"],["雨","あめ"],["を"],["あなた"],["がた"],["に"],["与えるで","あたえるで"],["あろう"],["。"],["地","ち"],["は"],["産物","さんぶつ"],["を"],["出し","だし"],["、"],["畑","はたけ"],["の"],["木々","きぎ"],["は"],["実","み"],["を"],["結ぶで","むすぶで"],["あろう"],["。"]]},{"verse":5,"text":"あなたがたの麦打,むぎうちは、ぶどうの取入,とりいれの時,ときまで続,つづき、ぶどうの取入,とりいれは、種,たねまきの時,ときまで続,つづくであろう。あなたがたは飽,あきるほどパンを食,たべ、またあなたがたの地,ちに安,やすらかに住,すむであろう。","tok":[["あなた"],["がた"],["の"],["麦打ち","むぎうち"],["は"],["、"],["ぶどう"],["の"],["取入","とりいれ"],["の"],["時","とき"],["まで"],["続き","つづき"],["、"],["ぶどう"],["の"],["取入","とりいれ"],["は"],["、"],["種まき","たねまき"],["の"],["時","とき"],["まで"],["続","つづく"],["で"],["あろう"],["。"],["あなた"],["がた"],["は"],["飽きる","あきる"],["ほど"],["パン"],["を"],["食べ","たべ"],["、"],["また"],["あなた"],["がた"],["の"],["地","ち"],["に"],["安らか","やすらか"],["に"],["住むで","すむで"],["あろう"],["。"]]},{"verse":6,"text":"わたしが国,くにに平和,へいわを与,あたえるから、あなたがたは安,やすらかに寝,ねることができ、あなたがたを恐,おそれさすものはないであろう。わたしはまた国,くにのうちから悪,わるい獣,けものを絶,たやすであろう。つるぎがあなたがたの国,くにを行,いき巡,めぐることはないであろう。","tok":[["わたし"],["が"],["国","くに"],["に"],["平和","へいわ"],["を"],["与える","あたえる"],["から"],["、"],["あなた"],["がた"],["は"],["安らか","やすらか"],["に"],["寝る","ねる"],["こと"],["が"],["でき"],["、"],["あなた"],["がた"],["を"],["恐れ","おそれ"],["さす"],["もの"],["は"],["ないで"],["あろう"],["。"],["わたし"],["は"],["また"],["国","くに"],["の"],["うち"],["から"],["悪い","わるい"],["獣","けもの"],["を"],["絶やすで","たやすで"],["あろう"],["。"],["つるぎ"],["が"],["あなた"],["がた"],["の"],["国","くに"],["を"],["行き","いき"],["巡る","めぐる"],["こと"],["は"],["ないで"],["あろう"],["。"]]},{"verse":7,"text":"あなたがたは敵,てきを追,おうであろう。彼,かれらは、あなたがたのつるぎに倒,たおれるであろう。","tok":[["あなた"],["がた"],["は"],["敵","てき"],["を"],["追うで","おうで"],["あろう"],["。"],["彼","かれ"],["ら"],["は"],["、"],["あなた"],["がた"],["の"],["つるぎ"],["に"],["倒れるで","たおれるで"],["あろう"],["。"]]},{"verse":8,"text":"あなたがたの五人,にんは百人,にんを追,おい、百人,にんは万人,にんを追,おい、あなたがたの敵,てきはつるぎに倒,たおれるであろう。","tok":[["あなた"],["がた"],["の"],["五人","にん"],["は"],["百人","にん"],["を"],["追い","おい"],["、"],["百人","にん"],["は"],["万人","にん"],["を"],["追い","おい"],["、"],["あなた"],["がた"],["の"],["敵","てき"],["は"],["つるぎ"],["に"],["倒れるで","たおれるで"],["あろう"],["。"]]},{"verse":9,"text":"わたしはあなたがたを顧,かえりみ、多,おおくの子,こを獲,えさせ、あなたがたを増,まし、あなたがたと結,むすんだ契約,けいやくを固,かためるであろう。","tok":[["わたし"],["は"],["あなた"],["がた"],["を"],["顧りみ","かえりみ"],["、"],["多く","おおく"],["の"],["子","こ"],["を"],["獲させ","えさせ"],["、"],["あなた"],["がた"],["を"],["増し","まし"],["、"],["あなた"],["がた"],["と"],["結んだ","むすんだ"],["契約","けいやく"],["を"],["固めるで","かためるで"],["あろう"],["。"]]},{"verse":10,"text":"あなたがたは古,ふるい穀物,こくもつを食,たべている間,あいだに、また新,あたらしいものを獲,えて、その古,ふるいものを捨,すてるようになるであろう。","tok":[["あなた"],["がた"],["は"],["古い","ふるい"],["穀物","こくもつ"],["を"],["食べて","たべて"],["いる"],["間","あいだ"],["に"],["、"],["また"],["新らしい","あたらしい"],["もの"],["を"],["獲て","えて"],["、"],["その"],["古い","ふるい"],["もの"],["を"],["捨てる","すてる"],["よう"],["に"],["なるで"],["あろう"],["。"]]},{"verse":11,"text":"わたしは幕屋,まくやをあなたがたのうちに建,たて、心,こころにあなたがたを忌,いみきらわないであろう。","tok":[["わたし"],["は"],["幕屋","まくや"],["を"],["あなた"],["がた"],["の"],["うち"],["に"],["建て","たて"],["、"],["心","こころ"],["に"],["あなた"],["がた"],["を"],["忌","いみ"],["きらわないで"],["あろう"],["。"]]},{"verse":12,"text":"わたしはあなたがたのうちに歩,あゆみ、あなたがたの神,かみとなり、あなたがたはわたしの民,たみとなるであろう。","tok":[["わたし"],["は"],["あなた"],["がた"],["の"],["うち"],["に"],["歩み","あゆみ"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["と"],["なり"],["、"],["あなた"],["がた"],["は"],["わたし"],["の"],["民","たみ"],["と"],["なるで"],["あろう"],["。"]]},{"verse":13,"text":"わたしはあなたがたの神,かみ、主,しゅであって、あなたがたをエジプトの国,くにから導,みちびき出,だして、奴隷,どれいの身分,みぶんから解,とき放,はなった者,ものである。わたしはあなたがたのくびきの横木,よこぎを砕,くだいて、まっすぐに立,たって歩,あるけるようにしたのである。","tok":[["わたし"],["は"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["で"],["あって"],["、"],["あなた"],["がた"],["を"],["エジプト"],["の"],["国","くに"],["から"],["導き出して","みちびきだして"],["、"],["奴隷","どれい"],["の"],["身分","みぶん"],["から"],["解き放った","ときはなった"],["者","もの"],["で"],["ある"],["。"],["わたし"],["は"],["あなた"],["がた"],["の"],["くびき"],["の"],["横木","よこぎ"],["を"],["砕いて","くだいて"],["、"],["まっすぐ"],["に"],["立って","たって"],["歩ける","あるける"],["よう"],["に"],["した"],["ので"],["ある"],["。"]]},{"verse":14,"text":"しかし、あなたがたがもしわたしに聞,きき従,したがわず、またこのすべての戒,いましめを守,まもらず、","tok":[["しかし"],["、"],["あなた"],["がた"],["が"],["もし"],["わたし"],["に"],["聞","きき"],["従わず","したがわず"],["、"],["また"],["この"],["すべて"],["の"],["戒しめ","いましめ"],["を"],["守らず","まもらず"],["、"]]},{"verse":15,"text":"わたしの定,さだめを軽,かろんじ、心,こころにわたしのおきてを忌,いみきらって、わたしのすべての戒,いましめを守,まもらず、わたしの契約,けいやくを破,やぶるならば、","tok":[["わたし"],["の"],["定め","さだめ"],["を"],["軽んじ","かろんじ"],["、"],["心","こころ"],["に"],["わたし"],["の"],["おきて"],["を"],["忌","いみ"],["きらって"],["、"],["わたし"],["の"],["すべて"],["の"],["戒しめ","いましめ"],["を"],["守らず","まもらず"],["、"],["わたし"],["の"],["契約","けいやく"],["を"],["破るならば","やぶるならば"],["、"]]},{"verse":16,"text":"わたしはあなたがたにこのようにするであろう。すなわち、あなたがたの上,うえに恐怖,きょうふを臨,のぞませ、肺病,はいびょうと熱病,ねつびょうをもって、あなたがたの目,めを見,みえなくし、命,いのちをやせ衰,おとろえさせるであろう。あなたがたが種,たねをまいてもむだである。敵,てきがそれを食,たべるであろう。","tok":[["わたし"],["は"],["あなた"],["がた"],["に"],["この"],["よう"],["に"],["するで"],["あろう"],["。"],["すなわち"],["、"],["あなた"],["がた"],["の"],["上","うえ"],["に"],["恐怖","きょうふ"],["を"],["臨ませ","のぞませ"],["、"],["肺病","はいびょう"],["と"],["熱病","ねつびょう"],["を"],["もって"],["、"],["あなた"],["がた"],["の"],["目","め"],["を"],["見えなく","みえなく"],["し"],["、"],["命","いのち"],["を"],["やせ衰えさせるで","やせおとろえさせるで"],["あろう"],["。"],["あなた"],["がた"],["が"],["種","たね"],["を"],["まいて"],["も"],["むだ"],["で"],["ある"],["。"],["敵","てき"],["が"],["それ"],["を"],["食べるで","たべるで"],["あろう"],["。"]]},{"verse":17,"text":"わたしは顔,かおをあなたがたにむけて攻,せめ、あなたがたは敵,てきの前,まえに撃,うちひしがれるであろう。またあなたがたの憎,にくむ者,ものがあなたがたを治,おさめるであろう。あなたがたは追,おう者,ものもないのに逃,にげるであろう。","tok":[["わたし"],["は"],["顔","かお"],["を"],["あなた"],["がた"],["に"],["むけて"],["攻め","せめ"],["、"],["あなた"],["がた"],["は"],["敵","てき"],["の"],["前","まえ"],["に"],["撃ち","うち"],["ひし"],["がれる"],["で"],["あろう"],["。"],["また"],["あなた"],["がた"],["の"],["憎む","にくむ"],["者","もの"],["が"],["あなた"],["がた"],["を"],["治めるで","おさめるで"],["あろう"],["。"],["あなた"],["がた"],["は"],["追う","おう"],["者","もの"],["も"],["ない"],["のに"],["逃るで","にげるで"],["あろう"],["。"]]},{"verse":18,"text":"それでもなお、あなたがたがわたしに聞,きき従,したがわないならば、わたしはあなたがたの罪,つみを七倍,ばい重,おもく罰,ばっするであろう。","tok":[["それ"],["で"],["も"],["なお"],["、"],["あなた"],["がた"],["が"],["わたし"],["に"],["聞","きき"],["従わないならば","したがわないならば"],["、"],["わたし"],["は"],["あなた"],["がた"],["の"],["罪","つみ"],["を"],["七","しち"],["倍","ばい"],["い"],["重く","おもく"],["罰するで","ばっするで"],["あろう"],["。"]]},{"verse":19,"text":"わたしはあなたがたの誇,ほこりとする力,ちからを砕,くだき、あなたがたの天,てんを鉄,てつのようにし、あなたがたの地,ちを青銅,せいどうのようにするであろう。","tok":[["わたし"],["は"],["あなた"],["がた"],["の"],["誇","ほこり"],["と"],["する"],["力","ちから"],["を"],["砕き","くだき"],["、"],["あなた"],["がた"],["の"],["天","てん"],["を"],["鉄","てつ"],["の"],["よう"],["に"],["し"],["、"],["あなた"],["がた"],["の"],["地","ち"],["を"],["青銅","せいどう"],["の"],["よう"],["に"],["するで"],["あろう"],["。"]]},{"verse":20,"text":"あなたがたの力,ちからは、むだに費,ついやされるであろう。すなわち、地,ちは産物,さんぶつをいださず、国,くにのうちの木々,きぎは実,みを結,むすばないであろう。","tok":[["あなた"],["がた"],["の"],["力","ちから"],["は"],["、"],["むだ"],["に"],["費やされるで","ついやされるで"],["あろう"],["。"],["すなわち"],["、"],["地","ち"],["は"],["産物","さんぶつ"],["を"],["いださず"],["、"],["国","くに"],["の"],["うち"],["の"],["木々","きぎ"],["は"],["実","み"],["を"],["結ばないで","むすばないで"],["あろう"],["。"]]},{"verse":21,"text":"もしあなたがたがわたしに逆,さからって歩,あゆみ、わたしに聞,きき従,したがわないならば、わたしはあなたがたの罪,つみに従,したがって七倍,ばいの災,わざわいをあなたがたに下,くだすであろう。","tok":[["もし"],["あなた"],["がた"],["が"],["わたし"],["に"],["逆らって","さからって"],["歩","あゆみ"],["、"],["わたし"],["に"],["聞","きき"],["従わないならば","したがわないならば"],["、"],["わたし"],["は"],["あなた"],["がた"],["の"],["罪","つみ"],["に"],["従って","したがって"],["七","なな"],["倍","ばい"],["の"],["災","わざわい"],["を"],["あなた"],["がた"],["に"],["下すで","くだすで"],["あろう"],["。"]]},{"verse":22,"text":"わたしはまた野獣,やじゅうをあなたがたのうちに送,おくるであろう。それはあなたがたの子供,こどもを奪,うばい、また家畜,かちくを滅,ほろぼし、あなたがたの数,かずを少,すくなくするであろう。あなたがたの大路,おおじは荒,あれ果,はてるであろう。","tok":[["わたし"],["は"],["また"],["野獣","やじゅう"],["を"],["あなた"],["がた"],["の"],["うち"],["に"],["送るで","おくるで"],["あろう"],["。"],["それ"],["は"],["あなた"],["がた"],["の"],["子供","こども"],["を"],["奪い","うばい"],["、"],["また"],["家畜","かちく"],["を"],["滅ぼし","ほろぼし"],["、"],["あなた"],["がた"],["の"],["数","かず"],["を"],["少く","すくなく"],["するで"],["あろう"],["。"],["あなた"],["がた"],["の"],["大路","おおじ"],["は"],["荒れ果てるで","あれはてるで"],["あろう"],["。"]]},{"verse":23,"text":"もしあなたがたがこれらの懲,こらしめを受,うけてもなお改,あらためず、わたしに逆,さからって歩,あゆむならば、","tok":[["もし"],["あなた"],["がた"],["が"],["これ"],["ら"],["の"],["懲らしめ","こらしめ"],["を"],["受て","うけて"],["も"],["なお"],["改","あらため"],["ず"],["、"],["わたし"],["に"],["逆らって","さからって"],["歩むならば","あゆむならば"],["、"]]},{"verse":24,"text":"わたしもまたあなたがたに逆,さからって歩,あゆみ、あなたがたの罪,つみを七倍,ばい重,おもく罰,ばっするであろう。","tok":[["わたし"],["も"],["また"],["あなた"],["がた"],["に"],["逆らって","さからって"],["歩","あゆみ"],["、"],["あなた"],["がた"],["の"],["罪","つみ"],["を"],["七","しち"],["倍","ばい"],["い"],["重く","おもく"],["罰するで","ばっするで"],["あろう"],["。"]]},{"verse":25,"text":"わたしはあなたがたの上,うえにつるぎを臨,のぞませ、違約,いやくの恨,うらみを報,むくいるであろう。あなたがたが町々,まちまちに集,あつまる時,ときは、あなたがたのうちに疫病,えきびょうを送,おくり、あなたがたは敵,てきの手,てにわたされるであろう。","tok":[["わたし"],["は"],["あなた"],["がた"],["の"],["上","うえ"],["に"],["つるぎ"],["を"],["臨ませ","のぞませ"],["、"],["違約","いやく"],["の"],["恨み","うらみ"],["を"],["報いるで","むくいるで"],["あろう"],["。"],["あなた"],["がた"],["が"],["町々","まちまち"],["に"],["集まる","あつまる"],["時","とき"],["は"],["、"],["あなた"],["がた"],["の"],["うち"],["に"],["疫病","えきびょう"],["を"],["送り","おくり"],["、"],["あなた"],["がた"],["は"],["敵","てき"],["の"],["手","て"],["に"],["わたされるで"],["あろう"],["。"]]},{"verse":26,"text":"わたしがあなたがたのつえとするパンを砕,くだくとき、十人,にんの女,おんなが一つのかまどでパンを焼,やき、それをはかりにかけてあなたがたに渡,わたすであろう。あなたがたは食,たべても満,みたされないであろう。","tok":[["わたし"],["が"],["あなた"],["がた"],["の"],["つえ"],["と"],["する"],["パン"],["を"],["砕く","くだく"],["とき"],["、"],["十人","にん"],["の"],["女","おんな"],["が"],["一","ひと"],["つ"],["の"],["かまど"],["で"],["パン"],["を"],["焼き","やき"],["、"],["それ"],["を"],["はかり"],["に"],["かけて"],["あなた"],["がた"],["に"],["渡すで","わたすで"],["あろう"],["。"],["あなた"],["がた"],["は"],["食べて","たべて"],["も"],["満たされないで","みたされないで"],["あろう"],["。"]]},{"verse":27,"text":"それでもなお、あなたがたがわたしに聞,きき従,したがわず、わたしに逆,さからって歩,あゆむならば、","tok":[["それ"],["で"],["も"],["なお"],["、"],["あなた"],["がた"],["が"],["わたし"],["に"],["聞","きき"],["従わず","したがわず"],["、"],["わたし"],["に"],["逆らって","さからって"],["歩むならば","あゆむならば"],["、"]]},{"verse":28,"text":"わたしもあなたがたに逆,さからい、怒,いかりをもって歩,あゆみ、あなたがたの罪,つみを七倍,ばい重,おもく罰,ばっするであろう。","tok":[["わたし"],["も"],["あなた"],["がた"],["に"],["逆らい","さからい"],["、"],["怒り","いかり"],["を"],["もって"],["歩","あゆみ"],["、"],["あなた"],["がた"],["の"],["罪","つみ"],["を"],["七","しち"],["倍","ばい"],["い"],["重く","おもく"],["罰するで","ばっするで"],["あろう"],["。"]]},{"verse":29,"text":"あなたがたは自分,じぶんのむすこの肉,にくを食,たべ、また自分,じぶんの娘,むすめの肉,にくを食,たべるであろう。","tok":[["あなた"],["がた"],["は"],["自分","じぶん"],["の"],["むすこ"],["の"],["肉","にく"],["を"],["食べ","たべ"],["、"],["また"],["自分","じぶん"],["の"],["娘","むすめ"],["の"],["肉","にく"],["を"],["食べるで","たべるで"],["あろう"],["。"]]},{"verse":30,"text":"わたしはあなたがたの高,たかき所,ところをこぼち、香,こうの祭壇,さいだんを倒,たおし、偶像,ぐうぞうの死体,したいの上,うえに、あなたがたの死体,したいを投,なげ捨,すてて、わたしは心,こころにあなたがたを忌,いみきらうであろう。","tok":[["わたし"],["は"],["あなた"],["がた"],["の"],["高き","たかき"],["所","ところ"],["を"],["こ"],["ぼ"],["ち"],["、"],["香","こう"],["の"],["祭壇","さいだん"],["を"],["倒し","たおし"],["、"],["偶像","ぐうぞう"],["の"],["死体","したい"],["の"],["上","うえ"],["に"],["、"],["あなた"],["がた"],["の"],["死体","したい"],["を"],["投捨てて","なげすてて"],["、"],["わたし"],["は"],["心","こころ"],["に"],["あなた"],["がた"],["を"],["忌","いみ"],["きらうで"],["あろう"],["。"]]},{"verse":31,"text":"わたしはまたあなたがたの町々,まちまちを荒,あれ地,ちとし、あなたがたの聖所,せいじょを荒,あらすであろう。またわたしはあなたがたのささげる香,こうばしいかおりをかがないであろう。","tok":[["わたし"],["は"],["また"],["あなた"],["がた"],["の"],["町々","まちまち"],["を"],["荒れ地","あれち"],["と"],["し"],["、"],["あなた"],["がた"],["の"],["聖","せい"],["所","しょ"],["を"],["荒すで","あらすで"],["あろう"],["。"],["また"],["わたし"],["は"],["あなた"],["がた"],["の"],["ささげる"],["香ばしい","こうばしい"],["かおり"],["を"],["かがないで"],["あろう"],["。"]]},{"verse":32,"text":"わたしがその地,ちを荒,あらすゆえ、そこに住,すむあなたがたの敵,てきはそれを見,みて驚,おどろくであろう。","tok":[["わたし"],["が"],["その"],["地","ち"],["を"],["荒す","あらす"],["ゆえ"],["、"],["そこ"],["に"],["住む","すむ"],["あなた"],["がた"],["の"],["敵","てき"],["は"],["それ"],["を"],["見て","みて"],["驚ろくで","おどろくで"],["あろう"],["。"]]},{"verse":33,"text":"わたしはあなたがたを国々,くにぐにの間,あいだに散,ちらし、つるぎを抜,ぬいて、あなたがたの後,うしろを追,おうであろう。あなたがたの地,ちは荒,あれ果,はて、あなたがたの町々,まちまちは荒,あれ地,ちとなるであろう。","tok":[["わたし"],["は"],["あなた"],["がた"],["を"],["国々","くにぐに"],["の"],["間","あいだ"],["に"],["散らし","ちらし"],["、"],["つるぎ"],["を"],["抜いて","ぬいて"],["、"],["あなた"],["がた"],["の"],["後ろ","うしろ"],["を"],["追うで","おうで"],["あろう"],["。"],["あなた"],["がた"],["の"],["地","ち"],["は"],["荒れ果て","あれはて"],["、"],["あなた"],["がた"],["の"],["町々","まちまち"],["は"],["荒れ地","あれち"],["と"],["なるで"],["あろう"],["。"]]},{"verse":34,"text":"こうしてその地,ちが荒,あれ果,はてて、あなたがたは敵,てきの国,くににある間,あいだ、地,ちは安息,あんそくを楽,たのしむであろう。すなわち、その時,とき、地,ちは休,やすみを得,えて、安息,あんそくを楽,たのしむであろう。","tok":[["こう"],["して"],["その"],["地","ち"],["が"],["荒れ果てて","あれはてて"],["、"],["あなた"],["がた"],["は"],["敵","てき"],["の"],["国","くに"],["に"],["ある"],["間","あ"],["い"],["だ"],["、"],["地","ち"],["は"],["安息","あんそく"],["を"],["楽しむで","たのしむで"],["あろう"],["。"],["すなわち"],["、"],["その"],["時","とき"],["、"],["地","ち"],["は"],["休み","やすみ"],["を"],["得て","えて"],["、"],["安息","あんそく"],["を"],["楽しむで","たのしむで"],["あろう"],["。"]]},{"verse":35,"text":"それは荒,あれ果,はてている日,ひの間,あいだ、休,やすむであろう。あなたがたがそこに住,すんでいる間,あいだ、あなたがたの安息,あんそくのときに休,やすみを得,えなかったものである。","tok":[["それ"],["は"],["荒れ果てて","あれはてて"],["いる"],["日","ひ"],["の"],["間","あいだ"],["、"],["休むで","やすむで"],["あろう"],["。"],["あなた"],["がた"],["が"],["そこ"],["に"],["住んで","すんで"],["いる"],["間","あいだ"],["、"],["あなた"],["がた"],["の"],["安息","あんそく"],["の"],["とき"],["に"],["休み","やすみ"],["を"],["得なかった","えなかった"],["もの"],["で"],["ある"],["。"]]},{"verse":36,"text":"またあなたがたのうちの残,のこっている者,ものの心,こころに、敵,てきの国,くにでわたしは恐,おそれをいだかせるであろう。彼,かれらは木,この葉,はの動,うごく音,おとにも驚,おどろいて逃,にげ、つるぎを避,さけて逃,にげる者,もののように逃,にげて、追,おう者,ものもないのにころび倒,たおれるであろう。","tok":[["また"],["あなた"],["がた"],["の"],["うち"],["の"],["残って","のこって"],["いる"],["者","もの"],["の"],["心","こころ"],["に"],["、"],["敵","てき"],["の"],["国","くに"],["で"],["わたし"],["は"],["恐","おそれ"],["を"],["いだかせるで"],["あろう"],["。"],["彼","かれ"],["ら"],["は"],["木の葉","このは"],["の"],["動く","うごく"],["音","おと"],["に"],["も"],["驚ろいて","おどろいて"],["逃","にげ"],["、"],["つるぎ"],["を"],["避けて","さけて"],["逃る","にげる"],["者","もの"],["の"],["よう"],["に"],["逃て","にげて"],["、"],["追う","おう"],["者","もの"],["も"],["ない"],["のに"],["ころび"],["倒れるで","たおれるで"],["あろう"],["。"]]},{"verse":37,"text":"彼,かれらは追,おう者,ものもないのに、つるぎをのがれる者,もののように折,おり重,かさなって、つまずき倒,たおれるであろう。あなたがたは敵,てきの前,まえに立,たつことができないであろう。","tok":[["彼","かれ"],["ら"],["は"],["追う","おう"],["者","もの"],["も"],["ない"],["のに"],["、"],["つるぎ"],["を"],["のがれる"],["者","もの"],["の"],["よう"],["に"],["折重なって","おりかさなって"],["、"],["つまずき"],["倒れるで","たおれるで"],["あろう"],["。"],["あなた"],["がた"],["は"],["敵","てき"],["の"],["前","まえ"],["に"],["立つ","たつ"],["こと"],["が"],["できないで"],["あろう"],["。"]]},{"verse":38,"text":"あなたがたは国々,くにぐにのうちにあって滅,ほろびうせ、あなたがたの敵,てきの地,ちはあなたがたをのみつくすであろう。","tok":[["あなた"],["がた"],["は"],["国々","くにぐに"],["の"],["うち"],["に"],["あって"],["滅び","ほろび"],["うせ"],["、"],["あなた"],["がた"],["の"],["敵","てき"],["の"],["地","ち"],["は"],["あなた"],["がた"],["を"],["のみ"],["つくすで"],["あろう"],["。"]]},{"verse":39,"text":"あなたがたのうちの残,のこっている者,ものは、あなたがたの敵,てきの地,ちで自分,じぶんの罪,つみのゆえにやせ衰,おとろえ、また先祖,せんぞたちの罪,つみのゆえに彼,かれらと同,おなじようにやせ衰,おとろえるであろう。","tok":[["あなた"],["がた"],["の"],["うち"],["の"],["残って","のこって"],["いる"],["者","もの"],["は"],["、"],["あなた"],["がた"],["の"],["敵","てき"],["の"],["地","ち"],["で"],["自分","じぶん"],["の"],["罪","つみ"],["の"],["ゆえ"],["に"],["やせ衰え","やせおとろえ"],["、"],["また"],["先祖","せんぞ"],["たち"],["の"],["罪","つみ"],["の"],["ゆえ"],["に"],["彼","かれ"],["ら"],["と"],["同じ","おなじ"],["よう"],["に"],["やせ衰えるで","やせおとろえるで"],["あろう"],["。"]]},{"verse":40,"text":"しかし、彼,かれらがもし、自分,じぶんの罪,つみと、先祖,せんぞたちの罪,つみ、すなわち、わたしに反逆,はんぎゃくし、またわたしに逆,さからって歩,あゆんだことを告白,こくはくするならば、","tok":[["しかし"],["、"],["彼","かれ"],["ら"],["が"],["もし"],["、"],["自分","じぶん"],["の"],["罪","つみ"],["と"],["、"],["先祖","せんぞ"],["たち"],["の"],["罪","つみ"],["、"],["すなわち"],["、"],["わたし"],["に"],["反逆","はんぎゃく"],["し"],["、"],["また"],["わたし"],["に"],["逆らって","さからって"],["歩んだ","あゆんだ"],["こと"],["を"],["告白","こくはく"],["するならば"],["、"]]},{"verse":41,"text":"たといわたしが彼,かれらに逆,さからって歩,あゆみ、彼,かれらを敵,てきの国,くにに引,ひいて行,いっても、もし彼,かれらの無,む割礼,かつれいの心,こころが砕,くだかれ、あまんじて罪,つみの罰,ばつを受,うけるならば、","tok":[["たとい"],["わたし"],["が"],["彼","かれ"],["ら"],["に"],["逆らって","さからって"],["歩","あゆみ"],["、"],["彼","かれ"],["ら"],["を"],["敵","てき"],["の"],["国","くに"],["に"],["引いて","ひいて"],["行って","いって"],["も"],["、"],["もし"],["彼","かれ"],["ら"],["の"],["無","む"],["割礼","かつれい"],["の"],["心","こころ"],["が"],["砕かれ","くだかれ"],["、"],["あまんじて"],["罪","つみ"],["の"],["罰","ばつ"],["を"],["受るならば","うけるならば"],["、"]]},{"verse":42,"text":"そのときわたしはヤコブと結,むすんだ契約,けいやくを思,おもい起,おこし、またイサクと結,むすんだ契約,けいやくおよびアブラハムと結,むすんだ契約,けいやくを思,おもい起,おこし、またその地,ちを思,おもい起,おこすであろう。","tok":[["その"],["とき"],["わたし"],["は"],["ヤコブ"],["と"],["結んだ","むすんだ"],["契約","けいやく"],["を"],["思い起こし","おもいおこし"],["、"],["また"],["イサク"],["と"],["結んだ","むすんだ"],["契約","けいやく"],["および"],["アブラハム"],["と"],["結んだ","むすんだ"],["契約","けいやく"],["を"],["思い起こし","おもいおこし"],["、"],["また"],["その"],["地","ち"],["を"],["思い起こすで","おもいおこすで"],["あろう"],["。"]]},{"verse":43,"text":"しかし、彼,かれらが地,ちを離,はなれて地,ちが荒,あれ果,はてている間,あいだ、地,ちはその安息,あんそくを楽,たのしむであろう。彼,かれらはまた、あまんじて罪,つみの罰,ばつを受,うけるであろう。彼,かれらがわたしのおきてを軽,かろんじ、心,こころにわたしの定,さだめを忌,いみきらったからである。","tok":[["しかし"],["、"],["彼","かれ"],["ら"],["が"],["地","ち"],["を"],["離れて","はなれて"],["地","ち"],["が"],["荒れ果てて","あれはてて"],["いる"],["間","あいだ"],["、"],["地","ち"],["は"],["その"],["安息","あんそく"],["を"],["楽しむで","たのしむで"],["あろう"],["。"],["彼","かれ"],["ら"],["は"],["また"],["、"],["あまんじて"],["罪","つみ"],["の"],["罰","ばつ"],["を"],["受るで","うけるで"],["あろう"],["。"],["彼","かれ"],["ら"],["が"],["わたし"],["の"],["おきて"],["を"],["軽んじ","かろんじ"],["、"],["心","こころ"],["に"],["わたし"],["の"],["定め","さだめ"],["を"],["忌","いみ"],["きらった"],["から"],["で"],["ある"],["。"]]},{"verse":44,"text":"それにもかかわらず、なおわたしは彼,かれらが敵,てきの国,くににおるとき、彼,かれらを捨,すてず、また忌,いみきらわず、彼,かれらを滅,ほろぼし尽,つくさず、彼,かれらと結,むすんだわたしの契約,けいやくを破,やぶることをしないであろう。わたしは彼,かれらの神,かみ、主,しゅだからである。","tok":[["それ"],["に"],["も"],["かかわらず"],["、"],["なお"],["わたし"],["は"],["彼","かれ"],["ら"],["が"],["敵","てき"],["の"],["国","くに"],["に"],["おる"],["とき"],["、"],["彼","かれ"],["ら"],["を"],["捨てず","すてず"],["、"],["また"],["忌","いみ"],["きらわず"],["、"],["彼","かれ"],["ら"],["を"],["滅ぼし","ほろぼし"],["尽くさず","つくさず"],["、"],["彼","かれ"],["ら"],["と"],["結んだ","むすんだ"],["わたし"],["の"],["契約","けいやく"],["を"],["破る","やぶる"],["こと"],["を"],["しないで"],["あろう"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["神","かみ"],["、"],["主らで","しゅだからで"],["ある"],["。"]]},{"verse":45,"text":"わたしは彼,かれらの先祖,せんぞたちと結,むすんだ契約,けいやくを彼,かれらのために思,おもい起,おこすであろう。彼,かれらはわたしがその神,かみとなるために国々,くにぐにの人,ひとの目,めの前,まえで、エジプトの地,ちから導,みちびき出,だした者,ものである。わたしは主,しゅである』」。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["の"],["先祖","せんぞ"],["たち"],["と"],["結んだ","むすんだ"],["契約","けいやく"],["を"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["思い起こすで","おもいおこすで"],["あろう"],["。"],["彼","かれ"],["ら"],["は"],["わたし"],["が"],["その"],["神","かみ"],["と"],["なる"],["ため"],["に"],["国々","くにぐに"],["の"],["人","ひと"],["の"],["目","め"],["の"],["前","まえ"],["で"],["、"],["エジプト"],["の"],["地","ち"],["から"],["導き出した","みちびきだした"],["者","もの"],["で"],["ある"],["。"],["わたし"],["は"],["主","しゅ"],["で"],["ある"],["』"],["」"],["。"]]},{"verse":46,"text":"これらは主,しゅが、シナイ山,さんで、自分,じぶんとイスラエルの人々,ひとびととの間,あいだに、モーセによって立,たてられた定,さだめと、おきてと、律法,りっぽうである。","tok":[["これ"],["ら"],["は"],["主","しゅ"],["が"],["、"],["シナイ"],["山","さん"],["で"],["、"],["自分","じぶん"],["と"],["イスラエル"],["の"],["人々","ひとびと"],["と"],["の"],["間","あいだ"],["に"],["、"],["モーセ"],["によって"],["立られた","たてられた"],["定め","さだめ"],["と"],["、"],["おきて"],["と"],["、"],["律法","りっぽう"],["で"],["ある"],["。"]]}]
[{"verse":1,"text":"主,しゅはまたモーセに言,いわれた、","tok":[["主","しゅ"],["は"],["また"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":2,"text":"「イスラエルの人々,ひとびとに言,いいなさい、『女,おんながもし身,みごもって男,おとこの子,こを産,うめば、七日,なぬかのあいだ汚,けがれる。すなわち、月,つきのさわりの日,ひかずほど汚,けがれるであろう。","tok":[["「"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["言い","いい"],["なさい"],["、"],["『"],["女","おんな"],["が"],["もし"],["身ごもって","みごもって"],["男の子","おとこのこ"],["を"],["産めば","うめば"],["、"],["七日","なぬか"],["の"],["あいだ"],["汚","け"],["がれる"],["。"],["すなわち"],["、"],["月","つき"],["の"],["さわり"],["の"],["日","ひ"],["かず"],["ほど"],["汚","け"],["がれる"],["で"],["あろう"],["。"]]},{"verse":3,"text":"八日,か目,めにはその子,この前,まえの皮,かわに割礼,かつれいを施,ほどこさなければならない。","tok":[["八日目","かめ"],["に"],["は"],["その"],["子","こ"],["の"],["前","まえ"],["の"],["皮","かわ"],["に"],["割礼","かつれい"],["を"],["施さなければ","ほどこさなければ"],["ならない"],["。"]]},{"verse":4,"text":"その女,おんなはなお、血,ちの清,きよめに三十三日,にちを経,へなければならない。その清,きよめの日,ひの満,みちるまでは、聖,せいなる物,ものに触,ふれてはならない。また聖,せいなる所,ところにはいってはならない。","tok":[["その"],["女","おんな"],["は"],["なお"],["、"],["血","ち"],["の"],["清め","きよめ"],["に"],["三十三","さんじゅうさん"],["日","にち"],["を"],["経なければ","へなければ"],["ならない"],["。"],["その"],["清め","きよめ"],["の"],["日","ひ"],["の"],["満ちる","みちる"],["まで"],["は"],["、"],["聖","せい"],["なる"],["物","もの"],["に"],["触","ふれ"],["ては"],["ならない"],["。"],["また"],["聖","せい"],["なる"],["所","ところ"],["に"],["はいって"],["は"],["ならない"],["。"]]},{"verse":5,"text":"もし女,おんなの子,こを産,うめば、二週間,しゅうかん、月,つきのさわりと同,おなじように汚,けがれる。その女,おんなはなお、血,ちの清,きよめに六十六日,にちを経,へなければならない。","tok":[["もし"],["女の子","おんなのこ"],["を"],["産めば","うめば"],["、"],["二","に"],["週間","しゅうかん"],["うかん"],["、"],["月","つき"],["の"],["さわり"],["と"],["同じ","おなじ"],["よう"],["に"],["汚","け"],["がれる"],["。"],["その"],["女","おんな"],["は"],["なお"],["、"],["血","ち"],["の"],["清め","きよめ"],["に"],["六十六","ろくじゅうろく"],["日","にち"],["を"],["経なければ","へなければ"],["ならない"],["。"]]},{"verse":6,"text":"男,おとこの子,こまたは女,おんなの子,こについての清,きよめの日,ひが満,みちるとき、女,おんなは燔祭,はんさいのために一歳,さいの小羊,こひつじ、罪祭,ざいさいのために家,いえばとのひな、あるいは山,やまばとを、会見,かいけんの幕屋,まくやの入口,いりぐちの、祭司,さいしのもとに、携,たずさえてこなければならない。","tok":[["男の子","おとこのこ"],["また"],["は"],["女の子","おんなのこ"],["について"],["の"],["清め","きよめ"],["の"],["日","ひ"],["が"],["満ちる","みちる"],["とき"],["、"],["女","おんな"],["は"],["燔祭","はんさい"],["の"],["ため"],["に"],["一歳","さい"],["の"],["小羊","こひつじ"],["、"],["罪","つみ"],["祭","まつり"],["の"],["ため"],["に"],["家ばと","いえばと"],["の"],["ひな"],["、"],["あるいは"],["山ばと","やまばと"],["を"],["、"],["会見","かいけん"],["の"],["幕屋","まくや"],["の"],["入口","いりぐち"],["の"],["、"],["祭司","さいし"],["の"],["もと"],["に"],["、"],["携えて","たずさえて"],["こなければ"],["ならない"],["。"]]},{"verse":7,"text":"祭司,さいしはこれを主,しゅの前,まえにささげて、その女,おんなのために、あがないをしなければならない。こうして女,おんなはその出血,しゅっけつの汚,けがれが清,きよまるであろう。これは男,おとこの子,こまたは女,おんなの子,こを産,うんだ女,おんなのためのおきてである。","tok":[["祭司","さいし"],["は"],["これ"],["を"],["主","しゅ"],["の"],["前","まえ"],["に"],["ささげて"],["、"],["その"],["女","おんな"],["の"],["ため"],["に"],["、"],["あがない"],["を"],["しなければ"],["ならない"],["。"],["こう"],["して"],["女","おんな"],["は"],["その"],["出血","しゅっけつ"],["の"],["汚","け"],["がれ"],["が"],["清まるで","きよまるで"],["あろう"],["。"],["これ"],["は"],["男の子","おとこのこ"],["また"],["は"],["女の子","おんなのこ"],["を"],["産んだ","うんだ"],["女","おんな"],["の"],["ため"],["の"],["おきて"],["で"],["ある"],["。"]]},{"verse":8,"text":"もしその女,おんなが小羊,こひつじに手,ての届,とどかないときは、山,やまばと二羽,わか、家,いえばとのひな二羽,わかを取,とって、一つを燔祭,はんさい、一つを罪祭,ざいさいとし、祭司,さいしはその女,おんなのために、あがないをしなければならない。こうして女,おんなは清,きよまるであろう』」。","tok":[["もし"],["その"],["女","おんな"],["が"],["小羊","こひつじ"],["に"],["手","て"],["の"],["届かない","とどかない"],["とき"],["は"],["、"],["山ばと","やまばと"],["二羽","わ"],["か"],["、"],["家ばと","いえばと"],["の"],["ひな"],["二羽","わか"],["を"],["取って","とって"],["、"],["一","ひと"],["つ"],["を"],["燔祭","はんさい"],["、"],["一","ひと"],["つ"],["を"],["罪","つみ"],["祭","まつり"],["い"],["さい"],["と"],["し"],["、"],["祭司","さいし"],["は"],["その"],["女","おんな"],["の"],["ため"],["に"],["、"],["あがない"],["を"],["しなければ"],["ならない"],["。"],["こう"],["して"],["女","おんな"],["は"],["清まるで","きよまるで"],["あろう"],["』"],["」"],["。"]]}]
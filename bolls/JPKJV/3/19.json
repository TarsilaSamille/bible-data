[{"verse":1,"text":"主,しゅはモーセに言,いわれた、","tok":[["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":2,"text":"「イスラエルの人々,ひとびとの全,ぜん会衆,かいしゅうに言,いいなさい、『あなたがたの神,かみ、主,しゅなるわたしは、聖,せいであるから、あなたがたも聖,せいでなければならない。","tok":[["「"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["全","ぜん"],["会衆","かいしゅう"],["に"],["言い","いい"],["なさい"],["、"],["『"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["なる"],["わたし"],["は"],["、"],["聖","せい"],["で"],["ある"],["から"],["、"],["あなた"],["がた"],["も"],["聖","せい"],["で"],["なければ"],["ならない"],["。"]]},{"verse":3,"text":"あなたがたは、おのおのその母,ははとその父,ちちとをおそれなければならない。またわたしの安息日,あんそくにちを守,まもらなければならない。わたしはあなたがたの神,かみ、主,しゅである。","tok":[["あなた"],["がた"],["は"],["、"],["おのおの"],["その"],["母","はは"],["と"],["その"],["父","ちち"],["と"],["を"],["おそれなければ"],["ならない"],["。"],["また"],["わたし"],["の"],["安息日","あんそくにち"],["を"],["守らなければ","まもらなければ"],["ならない"],["。"],["わたし"],["は"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["で"],["ある"],["。"]]},{"verse":4,"text":"むなしい神々,かみがみに心,こころを寄,よせてはならない。また自分,じぶんのために神々,かみがみを鋳,いて造,つくってはならない。わたしはあなたがたの神,かみ、主,しゅである。","tok":[["むなしい"],["神々","かみがみ"],["に"],["心","こころ"],["を"],["寄せて","よせて"],["は"],["ならない"],["。"],["また"],["自分","じぶん"],["の"],["ため"],["に"],["神々","かみがみ"],["を"],["鋳て","いて"],["造って","つくって"],["は"],["ならない"],["。"],["わたし"],["は"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["で"],["ある"],["。"]]},{"verse":5,"text":"酬恩祭,しゅうおんさいの犠牲,ぎせいを主,しゅにささげるときは、あなたがたが受,うけ入,いれられるように、それをささげなければならない。","tok":[["酬恩祭","しゅうおんさい"],["の"],["犠牲","ぎせい"],["を"],["主に","しゅに"],["ささげる"],["とき"],["は"],["、"],["あなた"],["がた"],["が"],["受け入れられる","うけいれられる"],["よう"],["に"],["、"],["それ"],["を"],["ささげなければ"],["ならない"],["。"]]},{"verse":6,"text":"それは、ささげた日,ひと、その翌日,よくじつとに食,たべ、三日,か目,めまで残,のこったものは、それを火,ひで焼,やかなければならない。","tok":[["それ"],["は"],["、"],["ささげた"],["日","ひ"],["と"],["、"],["その"],["翌日","よくじつ"],["と"],["に"],["食べ","たべ"],["、"],["三日目","かめ"],["まで"],["残った","のこった"],["もの"],["は"],["、"],["それ"],["を"],["火","ひ"],["で"],["焼かなければ","やかなければ"],["ならない"],["。"]]},{"verse":7,"text":"もし三日,か目,めに、少,すこしでも食,たべるならば、それは忌,いむべきものとなって、あなたは受,うけ入,いれられないであろう。","tok":[["もし"],["三日目","かめ"],["に"],["、"],["少し","すこし"],["で"],["も"],["食べるならば","たべるならば"],["、"],["それ"],["は"],["忌むべき","いむべき"],["もの"],["と"],["なって"],["、"],["あなた"],["は"],["受け入れられないで","うけいれられないで"],["あろう"],["。"]]},{"verse":8,"text":"それを食,たべる者,ものは、主,しゅの聖,せいなる物,ものを汚,けがすので、そのとがを負,おわなければならない。その人,ひとは民,たみのうちから断,たたれるであろう。","tok":[["それ"],["を"],["食べる","たべる"],["者","もの"],["は"],["、"],["主","しゅ"],["の"],["聖","せい"],["なる"],["物","もの"],["を"],["汚す","けがす"],["ので"],["、"],["その"],["とが"],["を"],["負わなければ","おわなければ"],["ならない"],["。"],["その"],["人","ひと"],["は"],["民","たみ"],["の"],["うち"],["から"],["断たれるで","たたれるで"],["あろう"],["。"]]},{"verse":9,"text":"あなたがたの地,ちの実,みのりを刈,かり入,いれるときは、畑,はたけのすみずみまで刈,かりつくしてはならない。またあなたの刈入,かりいれの落,おち穂,ぼを拾,ひろってはならない。","tok":[["あなた"],["がた"],["の"],["地","ち"],["の"],["実り","みのり"],["を"],["刈入れる","かりいれる"],["とき"],["は"],["、"],["畑","はたけ"],["の"],["すみずみ"],["まで"],["刈","かり"],["つくして"],["は"],["ならない"],["。"],["また"],["あなた"],["の"],["刈入れ","かりいれ"],["の"],["落穂","おちぼ"],["を"],["拾って","ひろって"],["は"],["ならない"],["。"]]},{"verse":10,"text":"あなたのぶどう畑,はたけの実,みを取,とりつくしてはならない。またあなたのぶどう畑,はたけに落,おちた実,みを拾,ひろってはならない。貧,まずしい者,ものと寄留者,きりゅうしゃとのために、これを残,のこしておかなければならない。わたしはあなたがたの神,かみ、主,しゅである。","tok":[["あなた"],["の"],["ぶどう"],["畑","はたけ"],["の"],["実","み"],["を"],["取","とり"],["つくして"],["は"],["ならない"],["。"],["また"],["あなた"],["の"],["ぶどう"],["畑","はたけ"],["に"],["落","おち"],["た"],["実","み"],["を"],["拾って","ひろって"],["は"],["ならない"],["。"],["貧しい","まずしい"],["者","もの"],["と"],["寄留者","きりゅうしゃ"],["と"],["の"],["ため"],["に"],["、"],["これ"],["を"],["残して","のこして"],["おかなければ"],["ならない"],["。"],["わたし"],["は"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["で"],["ある"],["。"]]},{"verse":11,"text":"あなたがたは盗,ぬすんではならない。欺,あざむいてはならない。互,たがいに偽,いつわってはならない。","tok":[["あなた"],["がた"],["は"],["盗","ぬすん"],["で"],["は"],["ならない"],["。"],["欺いて","あざむいて"],["は"],["ならない"],["。"],["互","たがい"],["に"],["偽わって","いつわって"],["は"],["ならない"],["。"]]},{"verse":12,"text":"わたしの名,なにより偽,いつわり誓,ちかって、あなたがたの神,かみの名,なを汚,けがしてはならない。わたしは主,しゅである。","tok":[["わたし"],["の"],["名","な"],["に"],["より"],["偽わり","いつわり"],["誓って","ちかって"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["の"],["名","な"],["を"],["汚","け"],["がして"],["は"],["ならない"],["。"],["わたし"],["は"],["主","しゅ"],["で"],["ある"],["。"]]},{"verse":13,"text":"あなたの隣人,りんじんをしえたげてはならない。また、かすめてはならない。日,ひ雇人,やといにんの賃銀,ちんぎんを明,あくる朝,あさまで、あなたのもとにとどめておいてはならない。","tok":[["あなた"],["の"],["隣人","りんじん"],["を"],["し"],["えたげて"],["は"],["ならない"],["。"],["また"],["、"],["かすめて"],["は"],["ならない"],["。"],["日雇人","ひやといにん"],["の"],["賃銀","ちんぎん"],["を"],["明くる","あくる"],["朝","あさ"],["まで"],["、"],["あなた"],["の"],["もと"],["に"],["とどめて"],["おいて"],["は"],["ならない"],["。"]]},{"verse":14,"text":"耳,みみしいを、のろってはならない。目,めしいの前,まえにつまずく物,ものを置,おいてはならない。あなたの神,かみを恐,おそれなければならない。わたしは主,しゅである。","tok":[["耳","みみ"],["しい"],["を"],["、"],["のろって"],["は"],["ならない"],["。"],["目","め"],["しい"],["の"],["前","まえ"],["に"],["つまずく"],["物","もの"],["を"],["置いて","おいて"],["は"],["ならない"],["。"],["あなた"],["の"],["神","かみ"],["を"],["恐れなければ","おそれなければ"],["ならない"],["。"],["わたし"],["は"],["主","しゅ"],["で"],["ある"],["。"]]},{"verse":15,"text":"さばきをするとき、不正,ふせいを行,おこなってはならない。貧,まずしい者,ものを片,かたよってかばい、力,ちからある者,ものを曲,まげて助,たすけてはならない。ただ正義,せいぎをもって隣人,りんじんをさばかなければならない。","tok":[["さばき"],["を"],["する"],["とき"],["、"],["不正","ふせい"],["を"],["行なって","おこなって"],["は"],["ならない"],["。"],["貧しい","まずしい"],["者","もの"],["を"],["片よって","かたよって"],["か"],["ばい"],["、"],["力","ちから"],["ある"],["者","もの"],["を"],["曲げて","まげて"],["助けて","たすけて"],["は"],["ならない"],["。"],["ただ"],["正義","せいぎ"],["を"],["もって"],["隣人","りんじん"],["を"],["さばかなければ"],["ならない"],["。"]]},{"verse":16,"text":"民,たみのうちを行,いき巡,めぐって、人,ひとの悪口,わるぐちを言,いいふらしてはならない。あなたの隣人,りんじんの血,ちにかかわる偽証,ぎしょうをしてはならない。わたしは主,しゅである。","tok":[["民","たみ"],["の"],["うち"],["を"],["行き","いき"],["巡って","めぐって"],["、"],["人","ひと"],["の"],["悪口","わるぐち"],["を"],["言いふらして","いいふらして"],["は"],["ならない"],["。"],["あなた"],["の"],["隣人","りんじん"],["の"],["血","ち"],["に"],["かかわる"],["偽証","ぎしょう"],["を"],["して"],["は"],["ならない"],["。"],["わたし"],["は"],["主","しゅ"],["で"],["ある"],["。"]]},{"verse":17,"text":"あなたは心,こころに兄弟,きょうだいを憎,にくんではならない。あなたの隣人,りんじんをねんごろにいさめて、彼,かれのゆえに罪,つみを身,みに負,おってはならない。","tok":[["あなた"],["は"],["心","こころ"],["に"],["兄弟","きょうだい"],["を"],["憎","にくん"],["で"],["は"],["ならない"],["。"],["あなた"],["の"],["隣人","りんじん"],["を"],["ねんごろ"],["に"],["いさめて"],["、"],["彼","かれ"],["の"],["ゆえ"],["に"],["罪","つみ"],["を"],["身","み"],["に"],["負って","おって"],["は"],["ならない"],["。"]]},{"verse":18,"text":"あなたはあだを返,かえしてはならない。あなたの民,たみの人々,ひとびとに恨,うらみをいだいてはならない。あなた自身,じしんのようにあなたの隣人,りんじんを愛,あいさなければならない。わたしは主,しゅである。","tok":[["あなた"],["は"],["あだ"],["を"],["返","かえし"],["ては"],["ならない"],["。"],["あなた"],["の"],["民","たみ"],["の"],["人々","ひとびと"],["に"],["恨み","うらみ"],["を"],["いだいて"],["は"],["ならない"],["。"],["あなた"],["自身","じしん"],["の"],["よう"],["に"],["あなた"],["の"],["隣人","りんじん"],["を"],["愛さなければ","あいさなければ"],["ならない"],["。"],["わたし"],["は"],["主","しゅ"],["で"],["ある"],["。"]]},{"verse":19,"text":"あなたがたはわたしの定,さだめを守,まもらなければならない。あなたの家畜,かちくに異,ことなった種,たねをかけてはならない。あなたの畑,はたけに二種,しゅの種,たねをまいてはならない。二種,しゅの糸,いとの混,まぜ織,おりの衣服,いふくを身,みにつけてはならない。","tok":[["あなた"],["がた"],["は"],["わたし"],["の"],["定め","さだめ"],["を"],["守らなければ","まもらなければ"],["ならない"],["。"],["あなた"],["の"],["家畜","かちく"],["に"],["異なった","ことなった"],["種","たね"],["を"],["かけて"],["は"],["ならない"],["。"],["あなた"],["の"],["畑","はたけ"],["に"],["二","に"],["種","しゅ"],["の"],["種","たね"],["を"],["まいて"],["は"],["ならない"],["。"],["二","に"],["種","しゅ"],["の"],["糸","いと"],["の"],["混ぜ","まぜ"],["織","おり"],["の"],["衣服","いふく"],["を"],["身","み"],["に"],["つけて"],["は"],["ならない"],["。"]]},{"verse":20,"text":"だれでも、人,ひとと婚約,こんやくのある女,おんな奴隷,どれいで、まだあがなわれず、自由,じゆうを与,あたえられていない者,ものと寝,ねて交,まじわったならば、彼,かれらふたりは罰,ばつを受,うける。しかし、殺,ころされることはない。彼女,かのじょは自由,じゆうの女,おんなではないからである。","tok":[["だれ"],["で"],["も"],["、"],["人","ひと"],["と"],["婚約","こんやく"],["の"],["ある"],["女","おんな"],["奴隷","どれい"],["で"],["、"],["まだ"],["あがなわれず"],["、"],["自由","じゆう"],["を"],["与えられて","あたえられて"],["いない"],["者","もの"],["と"],["寝て","ねて"],["交じわったならば","まじわったならば"],["、"],["彼","かれ"],["ら"],["ふたり"],["は"],["罰","ばつ"],["を"],["受る","うける"],["。"],["しかし"],["、"],["殺ろされる","ころされる"],["こと"],["は"],["ない"],["。"],["彼女","かのじょ"],["は"],["自由","じゆう"],["の"],["女","おんな"],["で"],["は"],["ない"],["から"],["で"],["ある"],["。"]]},{"verse":21,"text":"しかし、その男,おとこは愆祭,けんさいを主,しゅに携,たずさえてこなければならない。すなわち、愆祭,けんさいの雄羊,おひつじを、会見,かいけんの幕屋,まくやの入口,いりぐちに連,つれてこなければならない。","tok":[["しかし"],["、"],["その"],["男","おとこ"],["は"],["愆祭","けんさい"],["を"],["主に","しゅに"],["携えて","たずさえて"],["こなければ"],["ならない"],["。"],["すなわち"],["、"],["愆祭","けんさい"],["の"],["雄羊","おひつじ"],["を"],["、"],["会見","かいけん"],["の"],["幕屋","まくや"],["の"],["入口","いりぐち"],["に"],["連れて","つれて"],["こなければ"],["ならない"],["。"]]},{"verse":22,"text":"そして、祭司,さいしは彼,かれの犯,おかした罪,つみのためにその愆祭,けんさいの雄羊,おひつじをもって、主,しゅの前,まえに彼,かれのために、あがないをするであろう。こうして彼,かれの犯,おかした罪,つみはゆるされるであろう。","tok":[["そして"],["、"],["祭司","さいし"],["は"],["彼","かれ"],["の"],["犯した","おかした"],["罪","つみ"],["の"],["ため"],["に"],["その"],["愆祭","けんさい"],["の"],["雄羊","おひつじ"],["を"],["もって"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["彼","かれ"],["の"],["ため"],["に"],["、"],["あがない"],["を"],["するで"],["あろう"],["。"],["こう"],["して"],["彼","かれ"],["の"],["犯した","おかした"],["罪","つみ"],["は"],["ゆるされるで"],["あろう"],["。"]]},{"verse":23,"text":"あなたがたが、かの地,ちにはいって、もろもろのくだものの木,きを植,うえるときは、その実,みはまだ割礼,かつれいをうけないものと、見,みなさなければならない。すなわち、それは三年,ねんの間,あいだあなたがたには、割礼,かつれいのないものであって、食,たべてはならない。","tok":[["あなた"],["が"],["た"],["が"],["、"],["かの"],["地","ち"],["に"],["はいって"],["、"],["もろもろ"],["の"],["くだもの"],["の"],["木","き"],["を"],["植える","うえる"],["とき"],["は"],["、"],["その"],["実","み"],["は"],["まだ"],["割礼","かつれい"],["を"],["うけない"],["もの"],["と"],["、"],["見なさなければ","みなさなければ"],["ならない"],["。"],["すなわち"],["、"],["それ"],["は"],["三","さん"],["年","ねん"],["の"],["間","あいだ"],["あなた"],["がた"],["に"],["は"],["、"],["割礼","かつれい"],["の"],["ない"],["もの"],["で"],["あって"],["、"],["食べて","たべて"],["は"],["ならない"],["。"]]},{"verse":24,"text":"四年,ねん目,めには、そのすべての実,みを聖,せいなる物,ものとし、それをさんびの供,そなえ物,ものとして主,しゅにささげなければならない。","tok":[["四","よん"],["年目","年め"],["に"],["は"],["、"],["その"],["すべて"],["の"],["実","み"],["を"],["聖","せい"],["なる"],["物","もの"],["と"],["し"],["、"],["それ"],["を"],["さん"],["び"],["の"],["供え物","そなえもの"],["として"],["主に","しゅに"],["ささげなければ"],["ならない"],["。"]]},{"verse":25,"text":"しかし五年,ねん目,めには、あなたがたはその実,みを食,たべることができるであろう。こうするならば、それはあなたがたのために、多,おおくの実,みを結,むすぶであろう。わたしはあなたがたの神,かみ、主,しゅである。","tok":[["しかし"],["五","ご"],["年目","年め"],["に"],["は"],["、"],["あなた"],["がた"],["は"],["その"],["実","み"],["を"],["食べる","たべる"],["こと"],["が"],["できるで"],["あろう"],["。"],["こう"],["するならば"],["、"],["それ"],["は"],["あなた"],["がた"],["の"],["ため"],["に"],["、"],["多く","おおく"],["の"],["実","み"],["を"],["結ぶで","むすぶで"],["あろう"],["。"],["わたし"],["は"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["で"],["ある"],["。"]]},{"verse":26,"text":"あなたがたは何,なにをも血,ちのままで食,たべてはならない。また占,うらないをしてはならない。魔法,まほうを行,おこなってはならない。","tok":[["あなた"],["がた"],["は"],["何に","なに"],["を"],["も"],["血","ち"],["の"],["まま"],["で"],["食べて","たべて"],["は"],["ならない"],["。"],["また"],["占","うらない"],["を"],["して"],["は"],["ならない"],["。"],["魔法","まほう"],["を"],["行なって","おこなって"],["は"],["ならない"],["。"]]},{"verse":27,"text":"あなたがたのびんの毛,けを切,きってはならない。ひげの両端,りょうたんをそこなってはならない。","tok":[["あなた"],["がた"],["の"],["びん"],["の"],["毛","け"],["を"],["切って","きって"],["は"],["ならない"],["。"],["ひげ"],["の"],["両端","りょうたん"],["を"],["そこなって"],["は"],["ならない"],["。"]]},{"verse":28,"text":"死人,しにんのために身,みを傷,きずつけてはならない。また身,みに入墨,いれずみをしてはならない。わたしは主,しゅである。","tok":[["死人","しにん"],["の"],["ため"],["に"],["身","み"],["を"],["傷つけて","きずつけて"],["は"],["ならない"],["。"],["また"],["身","み"],["に"],["入墨","いれずみ"],["を"],["して"],["は"],["ならない"],["。"],["わたし"],["は"],["主","しゅ"],["で"],["ある"],["。"]]},{"verse":29,"text":"あなたの娘,むすめに遊女,ゆうじょのわざをさせて、これを汚,けがしてはならない。これはみだらな事,ことが国,くにに行,おこなわれ、悪事,あくじが地,ちに満,みちないためである。","tok":[["あなた"],["の"],["娘","むすめ"],["に"],["遊女","ゆうじょ"],["の"],["わざ"],["を"],["させて"],["、"],["これ"],["を"],["汚","け"],["がして"],["は"],["ならない"],["。"],["これ"],["は"],["みだら"],["な"],["事","こと"],["が"],["国","くに"],["に"],["行なわれ","おこなわれ"],["、"],["悪事","あくじ"],["が"],["地","ち"],["に"],["満ちない","みちない"],["ため"],["で"],["ある"],["。"]]},{"verse":30,"text":"あなたがたはわたしの安息日,あんそくにちを守,まもり、わたしの聖所,せいじょを敬,うやまわなければならない。わたしは主,しゅである。","tok":[["あなた"],["がた"],["は"],["わたし"],["の"],["安息日","あんそくにち"],["を"],["守り","まもり"],["、"],["わたし"],["の"],["聖","せい"],["所","しょ"],["を"],["敬わなければ","うやまわなければ"],["ならない"],["。"],["わたし"],["は"],["主","しゅ"],["で"],["ある"],["。"]]},{"verse":31,"text":"あなたがたは口寄,くちよせ、または占,うらない師,しのもとにおもむいてはならない。彼,かれらに問,とうて汚,けがされてはならない。わたしはあなたがたの神,かみ、主,しゅである。","tok":[["あなた"],["がた"],["は"],["口寄","くちよせ"],["、"],["また"],["は"],["占師","うらないし"],["の"],["もと"],["に"],["おもむいて"],["は"],["ならない"],["。"],["彼","かれ"],["ら"],["に"],["問うて","とうて"],["汚","け"],["が"],["されて"],["は"],["ならない"],["。"],["わたし"],["は"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["で"],["ある"],["。"]]},{"verse":32,"text":"あなたは白髪,はくはつの人,ひとの前,まえでは、起立,きりつしなければならない。また老人,ろうじんを敬,うやまい、あなたの神,かみを恐,おそれなければならない。わたしは主,しゅである。","tok":[["あなた"],["は"],["白髪","はくはつ"],["の"],["人","ひと"],["の"],["前","まえ"],["で"],["は"],["、"],["起立","きりつ"],["しなければ"],["ならない"],["。"],["また"],["老人","ろうじん"],["を"],["敬い","うやまい"],["、"],["あなた"],["の"],["神","かみ"],["を"],["恐れなければ","おそれなければ"],["ならない"],["。"],["わたし"],["は"],["主","しゅ"],["で"],["ある"],["。"]]},{"verse":33,"text":"もし他国,たこく人,じんがあなたがたの国,くにに寄留,きりゅうして共,ともにいるならば、これをしえたげてはならない。","tok":[["もし"],["他国人","たこくじん"],["が"],["あなた"],["がた"],["の"],["国","くに"],["に"],["寄留","きりゅう"],["して"],["共","とも"],["に"],["いるならば"],["、"],["これ"],["を"],["し"],["えたげて"],["は"],["ならない"],["。"]]},{"verse":34,"text":"あなたがたと共,ともにいる寄留,きりゅうの他国,たこく人,じんを、あなたがたと同,おなじ国,くにに生,うまれた者,もののようにし、あなた自身,じしんのようにこれを愛,あいさなければならない。あなたがたもかつてエジプトの国,くにで他国,たこく人,じんであったからである。わたしはあなたがたの神,かみ、主,しゅである。","tok":[["あなた"],["がた"],["と"],["共","とも"],["に"],["いる"],["寄留","きりゅう"],["の"],["他国人","たこくじん"],["を"],["、"],["あなた"],["がた"],["と"],["同じ","おなじ"],["国","くに"],["に"],["生まれた","うまれた"],["者","もの"],["の"],["よう"],["に"],["し"],["、"],["あなた"],["自身","じしん"],["の"],["よう"],["に"],["これ"],["を"],["愛さなければ","あいさなければ"],["ならない"],["。"],["あなた"],["がた"],["も"],["かつて"],["エジプト"],["の"],["国","くに"],["で"],["他国人","たこくじん"],["で"],["あった"],["から"],["で"],["ある"],["。"],["わたし"],["は"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["で"],["ある"],["。"]]},{"verse":35,"text":"あなたがたは、さばきにおいても、物差,ものさしにおいても、はかりにおいても、ますにおいても、不正,ふせいを行,おこなってはならない。","tok":[["あなた"],["がた"],["は"],["、"],["さばき"],["に"],["おいて"],["も"],["、"],["物差","ものさし"],["に"],["おいて"],["も"],["、"],["はかり"],["に"],["おいて"],["も"],["、"],["ます"],["に"],["おいて"],["も"],["、"],["不正","ふせい"],["を"],["行なって","おこなって"],["は"],["ならない"],["。"]]},{"verse":36,"text":"あなたがたは正,ただしいてんびん、正,ただしいおもり石,いし、正,ただしいエパ、正,ただしいヒンを使,つかわなければならない。わたしは、あなたがたをエジプトの国,くにから導,みちびき出,だしたあなたがたの神,かみ、主,しゅである。","tok":[["あなた"],["がた"],["は"],["正い","ただしい"],["てんびん"],["、"],["正い","ただしい"],["おもり"],["石","いし"],["、"],["正い","ただしい"],["エパ"],["、"],["正い","ただしい"],["ヒン"],["を"],["使わなければ","つかわなければ"],["ならない"],["。"],["わたし"],["は"],["、"],["あなた"],["がた"],["を"],["エジプト"],["の"],["国","くに"],["から"],["導き出した","みちびきだした"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["で"],["ある"],["。"]]},{"verse":37,"text":"あなたがたはわたしのすべての定,さだめと、わたしのすべてのおきてを守,まもって、これを行,おこなわなければならない。わたしは主,しゅである』」。","tok":[["あなた"],["がた"],["は"],["わたし"],["の"],["すべて"],["の"],["定め","さだめ"],["と"],["、"],["わたし"],["の"],["すべて"],["の"],["おきて"],["を"],["守って","まもって"],["、"],["これ"],["を"],["行なわなければ","おこなわなければ"],["ならない"],["。"],["わたし"],["は"],["主","しゅ"],["で"],["ある"],["』"],["」"],["。"]]}]
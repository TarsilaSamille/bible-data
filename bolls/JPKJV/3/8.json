[{"verse":1,"text":"主,しゅはまたモーセに言,いわれた、","tok":[["主","しゅ"],["は"],["また"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":2,"text":"「あなたはアロンとその子,こたち、およびその衣服,いふく、注,そそぎ油,あぶら、罪祭,ざいさいの雄牛,おうし、雄羊,おひつじ二頭,とう、種,たね入,いれぬパン一かごを取,とり、","tok":[["「"],["あなた"],["は"],["アロン"],["と"],["その"],["子","こ"],["たち"],["、"],["および"],["その"],["衣服","いふく"],["、"],["注ぎ","そそぎ"],["油","あぶら"],["、"],["罪","つみ"],["祭","まつり"],["の"],["雄牛","おうし"],["、"],["雄羊","おひつじ"],["二頭","と"],["う"],["、"],["種","た"],["ね"],["入れぬ","いれぬ"],["パン"],["一","ひと"],["かご"],["を"],["取","とり"],["、"]]},{"verse":3,"text":"また全,ぜん会衆,かいしゅうを会見,かいけんの幕屋,まくやの入口,いりぐちに集,あつめなさい」。","tok":[["また"],["全","ぜん"],["会衆","かいしゅう"],["を"],["会見","かいけん"],["の"],["幕屋","まくや"],["の"],["入口","いりぐち"],["に"],["集め","あつめ"],["なさい"],["」"],["。"]]},{"verse":4,"text":"モーセは主,しゅが命,めいじられたようにした。そして会衆,かいしゅうは会見,かいけんの幕屋,まくやの入口,いりぐちに集,あつまった。","tok":[["モーセ"],["は"],["主","しゅ"],["が"],["命じられた","めいじられた"],["よう"],["に"],["した"],["。"],["そして"],["会衆","かいしゅう"],["は"],["会見","かいけん"],["の"],["幕屋","まくや"],["の"],["入口","いりぐち"],["に"],["集まった","あつまった"],["。"]]},{"verse":5,"text":"そこでモーセは会衆,かいしゅうにむかって言,いった、「これは主,しゅがあなたがたにせよと命,めいじられたことである」。","tok":[["そこ"],["で"],["モーセ"],["は"],["会衆","かいしゅう"],["に"],["むかって"],["言った","いった"],["、"],["「"],["これ"],["は"],["主","しゅ"],["が"],["あなた"],["がた"],["に"],["せよ"],["と"],["命じられた","めいじられた"],["こと"],["で"],["ある"],["」"],["。"]]},{"verse":6,"text":"そしてモーセはアロンとその子,こたちを連,つれてきて、水,みずで彼,かれらを洗,あらい清,きよめ、","tok":[["そして"],["モーセ"],["は"],["アロン"],["と"],["その"],["子","こ"],["たち"],["を"],["連れて","つれて"],["きて"],["、"],["水","みず"],["で"],["彼","かれ"],["ら"],["を"],["洗","あらい"],["清め","きよめ"],["、"]]},{"verse":7,"text":"アロンに服,ふくを着,きさせ、帯,おびをしめさせ、衣,ころもをまとわせ、エポデを着,つけさせ、エポデの帯,おびをしめさせ、それをもってエポデを身,みに結,ゆいつけ、","tok":[["アロン"],["に"],["服","ふく"],["を"],["着させ","きさせ"],["、"],["帯","おび"],["を"],["しめさせ"],["、"],["衣","ころも"],["を"],["まとわせ"],["、"],["エポデ"],["を"],["着けさせ","つけさせ"],["、"],["エポデ"],["の"],["帯","おび"],["を"],["しめさせ"],["、"],["それ"],["を"],["もって"],["エポデ"],["を"],["身","み"],["に"],["結い","ゆい"],["つけ"],["、"]]},{"verse":8,"text":"また胸当,むねあてを着,つけさせ、その胸当,むねあてにウリムとトンミムを入,いれ、","tok":[["また"],["胸当","むねあて"],["を"],["着けさせ","つけさせ"],["、"],["その"],["胸当","むねあて"],["に"],["ウリム"],["と"],["トンミム"],["を"],["入れ","いれ"],["、"]]},{"verse":9,"text":"その頭,あたまに帽子,ぼうしをかぶらせ、その帽子,ぼうしの前,まえに金,きんの板,いた、すなわち聖,せいなる冠,かんむりをつけさせた。主,しゅがモーセに命,めいじられたとおりである。","tok":[["その"],["頭","あたま"],["に"],["帽子","ぼうし"],["を"],["かぶらせ"],["、"],["その"],["帽子","ぼうし"],["の"],["前","まえ"],["に"],["金","きん"],["の"],["板","いた"],["、"],["すなわち"],["聖","せい"],["なる"],["冠","かんむり"],["を"],["つけさせた"],["。"],["主","しゅ"],["が"],["モーセ"],["に"],["命じられた","めいじられた"],["とおり"],["で"],["ある"],["。"]]},{"verse":10,"text":"モーセはまた注,そそぎ油,あぶらを取,とり、幕屋,まくやとそのうちのすべての物,ものに油,あぶらを注,そそいでこれを聖別,せいべつし、","tok":[["モーセ"],["は"],["また"],["注ぎ","そそぎ"],["油","あぶら"],["を"],["取","とり"],["、"],["幕屋","まくや"],["と"],["その"],["うち"],["の"],["すべて"],["の"],["物","もの"],["に"],["油","あぶら"],["を"],["注いで","そそいで"],["これ"],["を"],["聖別","せいべつ"],["し"],["、"]]},{"verse":11,"text":"かつ、それを七たび祭壇,さいだんに注,そそぎ、祭壇,さいだんとそのもろもろの器,うつわ、洗盤,せんばんとその台,だいに油,あぶらを注,そそいでこれを聖別,せいべつし、","tok":[["かつ"],["、"],["それ"],["を"],["七","なな"],["たび"],["祭壇","さいだん"],["に"],["注ぎ","そそぎ"],["、"],["祭壇","さいだん"],["と"],["その"],["もろもろ"],["の"],["器","うつわ"],["、"],["洗","あらい"],["盤","ばん"],["の"],["台","だい"],["に"],["油","あぶら"],["を"],["注いで","そそいで"],["これ"],["を"],["聖別","せいべつ"],["し"],["、"]]},{"verse":12,"text":"また注,そそぎ油,あぶらをアロンの頭,あたまに注,そそぎ、彼,かれに油,あぶらを注,そそいでこれを聖別,せいべつした。","tok":[["また"],["注ぎ","そそぎ"],["油","あぶら"],["を"],["アロン"],["の"],["頭","あたま"],["に"],["注ぎ","そそぎ"],["、"],["彼","かれ"],["に"],["油","あぶら"],["を"],["注いで","そそいで"],["これ"],["を"],["聖別","せいべつ"],["した"],["。"]]},{"verse":13,"text":"モーセはまたアロンの子,こたちを連,つれてきて、服,ふくを彼,かれらに着,きさせ、帯,おびを彼,かれらにしめさせ、頭巾,ずきんを頭,あたまに巻,まかせた。主,しゅがモーセに命,めいじられたとおりである。","tok":[["モーセ"],["は"],["また"],["アロン"],["の"],["子","こ"],["たち"],["を"],["連れて","つれて"],["きて"],["、"],["服","ふく"],["を"],["彼","かれ"],["ら"],["に"],["着させ","きさせ"],["、"],["帯","おび"],["を"],["彼","かれ"],["ら"],["に"],["しめさせ"],["、"],["頭巾","ずきん"],["を"],["頭","あたま"],["に"],["巻かせた","まかせた"],["。"],["主","しゅ"],["が"],["モーセ"],["に"],["命じられた","めいじられた"],["とおり"],["で"],["ある"],["。"]]},{"verse":14,"text":"彼,かれはまた罪祭,ざいさいの雄牛,おうしを連,つれてこさせ、アロンとその子,こたちは、その罪祭,ざいさいの雄牛,おうしの頭,あたまに手,てを置,おいた。","tok":[["彼","かれ"],["は"],["また"],["罪","つみ"],["祭","まつり"],["の"],["雄牛","おうし"],["を"],["連れて","つれて"],["こさせ"],["、"],["アロン"],["と"],["その"],["子","こ"],["たち"],["は"],["、"],["その"],["罪","つみ"],["祭","まつり"],["の"],["雄牛","おうし"],["の"],["頭","あたま"],["に"],["手","て"],["を"],["置いた","おいた"],["。"]]},{"verse":15,"text":"モーセはこれをほふり、その血,ちを取,とり、指,ゆびをもってその血,ちを祭壇,さいだんの四すみの角,つのにつけて祭壇,さいだんを清,きよめ、また残,のこりの血,ちを祭壇,さいだんのもとに注,そそいで、これを聖別,せいべつし、これがためにあがないをした。","tok":[["モーセ"],["は"],["これ"],["を"],["ほふり"],["、"],["その"],["血","ち"],["を"],["取","とり"],["、"],["指","ゆび"],["を"],["もって"],["その"],["血","ち"],["を"],["祭壇","さいだん"],["の"],["四","よん"],["すみ"],["の"],["角","つ"],["の"],["につけて"],["祭壇","さいだん"],["を"],["清め","きよめ"],["、"],["また"],["残り","のこり"],["の"],["血","ち"],["を"],["祭壇","さいだん"],["の"],["もと"],["に"],["注いで","そそいで"],["、"],["これ"],["を"],["聖別","せいべつ"],["し"],["、"],["これ"],["が"],["ため"],["に"],["あがない"],["を"],["した"],["。"]]},{"verse":16,"text":"モーセはまたその内臓,ないぞうの上,うえのすべての脂肪,しぼう、肝臓,かんぞうの小葉,しょうよう、二つの腎臓,じんぞうとその脂肪,しぼうとを取,とり、これを祭壇,さいだんの上,うえで焼,やいた。","tok":[["モーセ"],["は"],["また"],["その"],["内臓","ないぞう"],["の"],["上","うえ"],["の"],["すべて"],["の"],["脂肪","しぼう"],["、"],["肝臓","かんぞう"],["の"],["小葉","しょうよう"],["、"],["二","ふた"],["つ"],["の"],["腎臓","じんぞう"],["と"],["その"],["脂肪","しぼう"],["と"],["を"],["取","とり"],["、"],["これ"],["を"],["祭壇","さいだん"],["の"],["上","うえ"],["で"],["焼いた","やいた"],["。"]]},{"verse":17,"text":"ただし、その雄牛,おうしの皮,かわと肉,にくと汚物,おぶつは宿営,しゅくえいの外,そとで、火,ひをもって焼,やき捨,すてた。主,しゅがモーセに命,めいじられたとおりである。","tok":[["ただし"],["、"],["その"],["雄牛","おうし"],["の"],["皮","かわ"],["と"],["肉","にく"],["と"],["汚物","おぶつ"],["は"],["宿営","しゅくえい"],["の"],["外","そと"],["で"],["、"],["火","ひ"],["を"],["もって"],["焼き捨てた","やきすてた"],["。"],["主","しゅ"],["が"],["モーセ"],["に"],["命じられた","めいじられた"],["とおり"],["で"],["ある"],["。"]]},{"verse":18,"text":"彼,かれはまた燔祭,はんさいの雄羊,おひつじを連,つれてこさせ、アロンとその子,こたちは、その雄羊,おひつじの頭,あたまに手,てを置,おいた。","tok":[["彼","かれ"],["は"],["また"],["燔祭","はんさい"],["の"],["雄羊","おひつじ"],["を"],["連れて","つれて"],["こさせ"],["、"],["アロン"],["と"],["その"],["子","こ"],["たち"],["は"],["、"],["その"],["雄羊","おひつじ"],["の"],["頭","あたま"],["に"],["手","て"],["を"],["置いた","おいた"],["。"]]},{"verse":19,"text":"モーセはこれをほふって、その血,ちを祭壇,さいだんの周囲,しゅういに注,そそぎかけた。","tok":[["モーセ"],["は"],["これ"],["を"],["ほふって"],["、"],["その"],["血","ち"],["を"],["祭壇","さいだん"],["の"],["周囲","しゅうい"],["に"],["注ぎ","そそぎ"],["かけた"],["。"]]},{"verse":20,"text":"そして、モーセはその雄羊,おひつじを節々,ふしぶしに切,きり分,わかち、その頭,あたまと切,きり分,わけたものと脂肪,しぼうとを焼,やいた。","tok":[["そして"],["、"],["モーセ"],["は"],["その"],["雄羊","おひつじ"],["を"],["節々","ふしぶし"],["に"],["切り","きり"],["分かち","わかち"],["、"],["その"],["頭","あたま"],["と"],["切り分た","きりわけた"],["もの"],["と"],["脂肪","しぼう"],["と"],["を"],["焼いた","やいた"],["。"]]},{"verse":21,"text":"またモーセは水,みずでその内臓,ないぞうと足,あしとを洗,あらい、その雄羊,おひつじをことごとく祭壇,さいだんの上,うえで焼,やいた。これは香,こうばしいかおりのための燔祭,はんさいであって、主,しゅにささげる火祭,かさいである。主,しゅがモーセに命,めいじられたとおりである。","tok":[["また"],["モーセ"],["は"],["水","みず"],["で"],["その"],["内臓","ないぞう"],["と"],["足","あし"],["と"],["を"],["洗","あらい"],["、"],["その"],["雄羊","おひつじ"],["を"],["ことごとく"],["祭壇","さいだん"],["の"],["上","うえ"],["で"],["焼いた","やいた"],["。"],["これ"],["は"],["香ばしい","こうばしい"],["かおり"],["の"],["ため"],["の"],["燔祭","はんさい"],["で"],["あって"],["、"],["主に","しゅに"],["ささげる"],["火祭","か"],["さい"],["で"],["ある"],["。"],["主","しゅ"],["が"],["モーセ"],["に"],["命じられた","めいじられた"],["とおり"],["で"],["ある"],["。"]]},{"verse":22,"text":"彼,かれはまたほかの雄羊,おひつじ、すなわち任,にん職,しょくの雄羊,おひつじを連,つれてこさせ、アロンとその子,こたちは、その雄羊,おひつじの頭,あたまに手,てを置,おいた。","tok":[["彼","かれ"],["は"],["また"],["ほか"],["の"],["雄羊","おひつじ"],["、"],["すなわち"],["任","にん"],["職","しょく"],["の"],["雄羊","おひつじ"],["を"],["連れて","つれて"],["こさせ"],["、"],["アロン"],["と"],["その"],["子","こ"],["たち"],["は"],["、"],["その"],["雄羊","おひつじ"],["の"],["頭","あたま"],["に"],["手","て"],["を"],["置いた","おいた"],["。"]]},{"verse":23,"text":"モーセはこれをほふり、その血,ちを取,とって、アロンの右,みぎの耳,みみたぶと、右手,みぎての親指,おやゆびと、右足,みぎあしの親指,おやゆびとにつけた。","tok":[["モーセ"],["は"],["これ"],["を"],["ほふり"],["、"],["その"],["血","ち"],["を"],["取って","とって"],["、"],["アロン"],["の"],["右","みぎ"],["の"],["耳たぶ","みみたぶ"],["と"],["、"],["右手","みぎて"],["の"],["親指","おやゆび"],["と"],["、"],["右足","みぎあし"],["の"],["親指","おやゆび"],["と"],["に"],["つけた"],["。"]]},{"verse":24,"text":"またモーセはアロンの子,こたちを連,つれてきて、その血,ちを彼,かれらの右,みぎの耳,みみたぶと、右手,みぎての親指,おやゆびと、右足,みぎあしの親指,おやゆびとにつけた。そしてモーセはその残,のこりの血,ちを、祭壇,さいだんの周囲,しゅういに注,そそぎかけた。","tok":[["また"],["モーセ"],["は"],["アロン"],["の"],["子","こ"],["たち"],["を"],["連れて","つれて"],["きて"],["、"],["その"],["血","ち"],["を"],["彼","かれ"],["ら"],["の"],["右","みぎ"],["の"],["耳たぶ","みみたぶ"],["と"],["、"],["右手","みぎて"],["の"],["親指","おやゆび"],["と"],["、"],["右足","みぎあし"],["の"],["親指","おやゆび"],["と"],["に"],["つけた"],["。"],["そして"],["モーセ"],["は"],["その"],["残り","のこり"],["の"],["血","ち"],["を"],["、"],["祭壇","さいだん"],["の"],["周囲","しゅうい"],["に"],["注ぎ","そそぎ"],["かけた"],["。"]]},{"verse":25,"text":"彼,かれはまたその脂肪,しぼう、すなわち脂,あぶら尾,お、内臓,ないぞうの上,うえのすべての脂肪,しぼう、肝臓,かんぞうの小葉,しょうよう、二つの腎臓,じんぞうとその脂肪,しぼう、ならびにその右,みぎのももを取,とり、","tok":[["彼","かれ"],["は"],["また"],["その"],["脂肪","しぼう"],["、"],["すなわち"],["脂","あぶら"],["尾","お"],["、"],["内臓","ないぞう"],["の"],["上","うえ"],["の"],["すべて"],["の"],["脂肪","しぼう"],["、"],["肝臓","かんぞう"],["の"],["小葉","しょうよう"],["、"],["二","ふた"],["つ"],["の"],["腎臓","じんぞう"],["と"],["その"],["脂肪","しぼう"],["、"],["ならびに"],["その"],["右","みぎ"],["の"],["もも"],["を"],["取","とり"],["、"]]},{"verse":26,"text":"また主,しゅの前,まえにある種,たね入,いれぬパンのかごから種,たね入,いれぬ菓子,かし一つと、油,あぶらを入,いれたパンの菓子,かし一つと、煎餅,せんべい一つとを取,とって、かの脂肪,しぼうと右,みぎのももとの上,うえに載,のせ、","tok":[["また"],["主","しゅ"],["の"],["前","まえ"],["に"],["ある"],["種","たね"],["入れぬ","いれぬ"],["パン"],["の"],["かご"],["から"],["種","た"],["ね"],["入れぬ","いれぬ"],["菓子","かし"],["一","ひと"],["つ"],["と"],["、"],["油","あぶら"],["を"],["入れた","いれた"],["パン"],["の"],["菓子","かし"],["一","ひと"],["つ"],["と"],["、"],["煎餅","せんべい"],["一","ひと"],["つ"],["と"],["を"],["取って","とって"],["、"],["かの"],["脂肪","しぼう"],["と"],["右","みぎ"],["の"],["もも"],["と"],["の"],["上","うえ"],["に"],["載せ","のせ"],["、"]]},{"verse":27,"text":"これをすべてアロンの手,てと、その子,こたちの手,てに渡,わたし、主,しゅの前,まえに揺,ゆり動,うごかさせて揺祭,ようさいとした。","tok":[["これ"],["を"],["すべて"],["アロン"],["の"],["手","て"],["と"],["、"],["その"],["子","こ"],["たち"],["の"],["手","て"],["に"],["渡","わたし"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["揺り動かさせて","ゆりうごかさせて"],["揺祭","ようさい"],["と"],["した"],["。"]]},{"verse":28,"text":"そしてモーセはこれを彼,かれらの手,てから取,とり、祭壇,さいだんの上,うえで燔祭,はんさいと共,ともに焼,やいた。これは香,こうばしいかおりとする任,にん職,しょくの供,そなえ物,ものであって、主,しゅにささげる火祭,かさいである。","tok":[["そして"],["モーセ"],["は"],["これ"],["を"],["彼","かれ"],["ら"],["の"],["手","て"],["から"],["取","とり"],["、"],["祭壇","さいだん"],["の"],["上","うえ"],["で"],["燔祭","はんさい"],["と"],["共","とも"],["に"],["焼いた","やいた"],["。"],["これ"],["は"],["香ばしい","こうばしい"],["かおり"],["と"],["する"],["任","にん"],["職","しょく"],["の"],["供え物","そなえもの"],["で"],["あって"],["、"],["主に","しゅに"],["ささげる"],["火祭","か"],["さい"],["で"],["ある"],["。"]]},{"verse":29,"text":"そしてモーセはその胸,むねを取,とり、主,しゅの前,まえにこれを揺,ゆり動,うごかして揺祭,ようさいとした。これは任,にん職,しょくの雄羊,おひつじのうちモーセに帰,きすべき分,ぶんであった。主,しゅがモーセに命,めいじられたとおりである。","tok":[["そして"],["モーセ"],["は"],["その"],["胸","むね"],["を"],["取","とり"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["これ"],["を"],["揺り動かして","ゆりうごかして"],["揺祭","ようさい"],["と"],["した"],["。"],["これ"],["は"],["任","にん"],["職","しょく"],["の"],["雄羊","おひつじ"],["の"],["うち"],["モーセ"],["に"],["帰すべき","きすべき"],["分","ぶん"],["で"],["あった"],["。"],["主","しゅ"],["が"],["モーセ"],["に"],["命じられた","めいじられた"],["とおり"],["で"],["ある"],["。"]]},{"verse":30,"text":"モーセはまた注,そそぎ油,あぶらと祭壇,さいだんの上,うえの血,ちとを取,とり、これをアロンとその服,ふく、またその子,こたちとその服,ふくとに注,そそいで、アロンとその服,ふく、およびその子,こたちと、その服,ふくとを聖別,せいべつした。","tok":[["モーセ"],["は"],["また"],["注ぎ","そそぎ"],["油","あぶら"],["と"],["祭壇","さいだん"],["の"],["上","うえ"],["の"],["血","ち"],["と"],["を"],["取","とり"],["、"],["これ"],["を"],["アロン"],["と"],["その"],["服","ふく"],["、"],["また"],["その"],["子","こ"],["たち"],["と"],["その"],["服","ふく"],["と"],["に"],["注いで","そそいで"],["、"],["アロン"],["と"],["その"],["服","ふく"],["、"],["および"],["その"],["子","こ"],["たち"],["と"],["、"],["その"],["服","ふく"],["と"],["を"],["聖別","せいべつ"],["した"],["。"]]},{"verse":31,"text":"モーセはまたアロンとその子,こたちに言,いった、「会見,かいけんの幕屋,まくやの入口,いりぐちでその肉,にくを煮,になさい。そして任職祭,にんしょくさいのかごの中,なかのパンと共,ともに、それをその所,ところで食,たべなさい。これは『アロンとその子,こたちが食,たべなければならない、と言,いえ』とわたしが命,めいじられたとおりである。","tok":[["モーセ"],["は"],["また"],["アロン"],["と"],["その"],["子","こ"],["たち"],["に"],["言った","いった"],["、"],["「"],["会見","かいけん"],["の"],["幕屋","まくや"],["の"],["入口","いりぐち"],["で"],["その"],["肉","にく"],["を"],["煮","に"],["なさい"],["。"],["そして"],["任","にん"],["職祭","しょくさい"],["の"],["かご"],["の"],["中","なか"],["の"],["パン"],["と"],["共","とも"],["に"],["、"],["それ"],["を"],["その"],["所","ところ"],["で"],["食べ","たべ"],["なさい"],["。"],["これ"],["は"],["『"],["アロン"],["と"],["その"],["子","こ"],["たち"],["が"],["食べなければ","たべなければ"],["ならない"],["、"],["と"],["言え","いえ"],["』"],["と"],["わたし"],["が"],["命じられた","めいじられた"],["とおり"],["で"],["ある"],["。"]]},{"verse":32,"text":"あなたがたはその肉,にくとパンとの残,のこったものを火,ひで焼,やき捨,すてなければならない。","tok":[["あなた"],["がた"],["は"],["その"],["肉","にく"],["と"],["パン"],["と"],["の"],["残った","のこった"],["もの"],["を"],["火","ひ"],["で"],["焼き捨てなければ","やきすてなければ"],["ならない"],["。"]]},{"verse":33,"text":"あなたがたはその任職祭,にんしょくさいの終,おわる日,ひまで七日,なぬかの間,あいだ、会見,かいけんの幕屋,まくやの入口,いりぐちから出,でてはならない。あなたがたの任,にん職,しょくは七日,なぬかを要,ようするからである。","tok":[["あなた"],["がた"],["は"],["その"],["任","にん"],["職祭","しょくさい"],["の"],["終わる","おわる"],["日","ひ"],["まで"],["七日","なぬか"],["の"],["間","あいだ"],["、"],["会見","かいけん"],["の"],["幕屋","まくや"],["の"],["入口","いりぐち"],["から"],["出て","でて"],["は"],["ならない"],["。"],["あなた"],["がた"],["の"],["任","にん"],["職","しょく"],["は"],["七","なな"],["日","にち"],["を"],["要する","ようする"],["から"],["で"],["ある"],["。"]]},{"verse":34,"text":"きょう行,おこなったように、あなたがたのために、あがないをせよ、と主,しゅはお命,めいじになった。","tok":[["きょう"],["行なった","おこなった"],["よう"],["に"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["、"],["あがない"],["を"],["せよ"],["、"],["と"],["主","しゅ"],["は"],["お命じ","おめいじ"],["に"],["なった"],["。"]]},{"verse":35,"text":"あなたがたは会見,かいけんの幕屋,まくやの入口,いりぐちに七日,なぬかの間,あいだ、日夜,にちやとどまり、主,しゅの仰,おおせを守,まもって、死,しぬことのないようにしなければならない。わたしはそのように命,めいじられたからである」。","tok":[["あなた"],["がた"],["は"],["会見","かいけん"],["の"],["幕屋","まくや"],["の"],["入口","いりぐち"],["に"],["七","しち"],["日","にち"],["の"],["間","あいだ"],["、"],["日夜","にちや"],["とどまり"],["、"],["主","しゅ"],["の"],["仰せ","おおせ"],["を"],["守って","まもって"],["、"],["死ぬ","しぬ"],["こと"],["の"],["ない"],["よう"],["に"],["しなければ"],["ならない"],["。"],["わたし"],["は"],["その"],["よう"],["に"],["命じられた","めいじられた"],["から"],["で"],["ある"],["」"],["。"]]},{"verse":36,"text":"アロンとその子,こたちは主,しゅがモーセによってお命,めいじになったことを、ことごとく行,おこなった。","tok":[["アロン"],["と"],["その"],["子","こ"],["たち"],["は"],["主","しゅ"],["が"],["モーセ"],["によって"],["お命じ","おめいじ"],["に"],["なった"],["こと"],["を"],["、"],["ことごとく"],["行なった","おこなった"],["。"]]}]
[{"verse":1,"text":"もし人,ひとが証人,しょうにんに立,たち、誓,ちかいの声,こえを聞,ききながら、その見,みたこと、知,しっていることを言,いわないで、罪,つみを犯,おかすならば、彼,かれはそのとがを負,おわなければならない。","tok":[["もし"],["人","ひと"],["が"],["証人","しょうにん"],["に"],["立ち","たち"],["、"],["誓い","ちかい"],["の"],["声","こえ"],["を"],["聞","きき"],["ながら"],["、"],["その"],["見た","みた"],["こと"],["、"],["知って","しって"],["いる"],["こと"],["を"],["言わないで","いわないで"],["、"],["罪","つみ"],["を"],["犯すならば","おかすならば"],["、"],["彼","かれ"],["は"],["その"],["とが"],["を"],["負わなければ","おわなければ"],["ならない"],["。"]]},{"verse":2,"text":"また、もし人,ひとが汚,けがれた野獣,やじゅうの死体,したい、汚,けがれた家畜,かちくの死体,したい、汚,けがれた這,はうものの死体,したいなど、すべて汚,けがれたものに触,ふれるならば、そのことに気,きづかなくても、彼,かれは汚,けがれたものとなって、とがを得,える。","tok":[["また"],["、"],["もし"],["人","ひと"],["が"],["汚","け"],["がれ"],["た"],["野獣","やじゅう"],["の"],["死体","したい"],["、"],["汚","け"],["がれ"],["た"],["家畜","かちく"],["の"],["死体","したい"],["、"],["汚","け"],["がれ"],["た"],["這う","はう"],["もの"],["の"],["死体","したい"],["など"],["、"],["すべて"],["汚","けがれたも"],["のに"],["触れるならば","ふれるならば"],["、"],["その"],["こと"],["に"],["気づかなくて","きづかなくて"],["も"],["、"],["彼","かれ"],["は"],["汚","けがれたも"],["の"],["と"],["なって"],["、"],["とが"],["を"],["得る","える"],["。"]]},{"verse":3,"text":"また、もし彼,かれが人,ひとの汚,けがれに触,ふれるならば、その人,ひとの汚,けがれが、どのような汚,けがれであれ、それに気,きづかなくても、彼,かれがこれを知,しるようになった時,ときは、とがを得,える。","tok":[["また"],["、"],["もし"],["彼","かれ"],["が"],["人","ひと"],["の"],["汚に","けがれに"],["触れるならば","ふれるならば"],["、"],["その"],["人","ひと"],["の"],["汚","け"],["がれ"],["が"],["、"],["どのような"],["汚","け"],["がれ"],["で"],["あれ"],["、"],["それ"],["に"],["気づかなくて","きづかなくて"],["も"],["、"],["彼","かれ"],["が"],["これ"],["を"],["知る","しる"],["よう"],["に"],["なった"],["時","とき"],["は"],["、"],["とが"],["を"],["得る","える"],["。"]]},{"verse":4,"text":"また、もし人,ひとがみだりにくちびるで誓,ちかい、悪,あくをなそう、または善,ぜんをなそうと言,いうならば、その人,ひとが誓,ちかってみだりに言,いったことは、それがどんなことであれ、それに気,きづかなくても、彼,かれがこれを知,しるようになった時,ときは、これらの一つについて、とがを得,える。","tok":[["また"],["、"],["もし"],["人","ひと"],["が"],["みだり"],["に"],["くちびる"],["で"],["誓い","ちかい"],["、"],["悪","あく"],["を"],["なそう"],["、"],["また"],["は"],["善","ぜん"],["を"],["なそう"],["と"],["言うならば","いうならば"],["、"],["その"],["人","ひと"],["が"],["誓って","ちかって"],["みだり"],["に"],["言った","いった"],["こと"],["は"],["、"],["それ"],["が"],["どんな"],["こと"],["で"],["あれ"],["、"],["それ"],["に"],["気づかなくて","きづかなくて"],["も"],["、"],["彼","かれ"],["が"],["これ"],["を"],["知る","しる"],["よう"],["に"],["なった"],["時","とき"],["は"],["、"],["これ"],["ら"],["の"],["一","ひと"],["つ"],["について"],["、"],["とが"],["を"],["得る","える"],["。"]]},{"verse":5,"text":"もしこれらの一つについて、とがを得,えたときは、その罪,つみを犯,おかしたことを告白,こくはくし、","tok":[["もし"],["これ"],["ら"],["の"],["一","ひと"],["つ"],["について"],["、"],["とが"],["を"],["得た","えた"],["とき"],["は"],["、"],["その"],["罪","つみ"],["を"],["犯した","おかした"],["こと"],["を"],["告白","こくはく"],["し"],["、"]]},{"verse":6,"text":"その犯,おかした罪,つみのために償,つぐないとして、雌,めすの家畜,かちく、すなわち雌,めすの小羊,こひつじまたは雌,めやぎを主,しゅのもとに連,つれてきて、罪祭,ざいさいとしなければならない。こうして祭司,さいしは彼,かれのために罪,つみのあがないをするであろう。","tok":[["その"],["犯した","おかした"],["罪","つみ"],["の"],["ため"],["に"],["償ない","つぐない"],["として"],["、"],["雌","めす"],["の"],["家畜","かちく"],["、"],["すなわち"],["雌","めす"],["の"],["小羊","こひつじ"],["また"],["は"],["雌","めやぎ"],["を"],["主","しゅ"],["の"],["もと"],["に"],["連れて","つれて"],["きて"],["、"],["罪","つみ"],["祭","まつり"],["と"],["しなければ"],["ならない"],["。"],["こう"],["して"],["祭司","さいし"],["は"],["彼","かれ"],["の"],["ため"],["に"],["罪","つみ"],["の"],["あ"],["が"],["ない"],["を"],["するで"],["あろう"],["。"]]},{"verse":7,"text":"もし小羊,こひつじに手,てのとどかない時,ときは、山,やまばと二羽,わか、家,いえばとのひな二羽,わかを、彼,かれが犯,おかした罪,つみのために償,つぐないとして主,しゅに携,たずさえてきて、一羽,わを罪祭,ざいさいに、一羽,わを燔祭,はんさいにしなければならない。","tok":[["もし"],["小羊","こひつじ"],["に"],["手","て"],["の"],["とどかない"],["時","とき"],["は"],["、"],["山ばと","やまばと"],["二羽","わ"],["か"],["、"],["家ばと","いえばと"],["の"],["ひな"],["二羽","わか"],["を"],["、"],["彼","かれ"],["が"],["犯した","おかした"],["罪","つみ"],["の"],["ため"],["に"],["償ない","つぐない"],["として"],["主に","しゅに"],["携えて","たずさえて"],["きて"],["、"],["一羽","わ"],["を"],["罪","つみ"],["祭","まつり"],["に"],["、"],["一羽","わ"],["を"],["燔祭","はんさい"],["に"],["しなければ"],["ならない"],["。"]]},{"verse":8,"text":"すなわち、これらを祭司,さいしに携,たずさえてきて、祭司,さいしはその罪祭,ざいさいのものを先,さきにささげなければならない。すなわち、その頭,あたまを首,くびの根,ねのところで、摘,つみ破,やぶらなければならない。ただし、切,きり離,はなしてはならない。","tok":[["すなわち"],["、"],["これ"],["ら"],["を"],["祭司","さいし"],["に"],["携えて","たずさえて"],["きて"],["、"],["祭司","さいし"],["は"],["その"],["罪","つみ"],["祭","まつり"],["の"],["もの"],["を"],["先","さき"],["に"],["ささげなければ"],["ならない"],["。"],["すなわち"],["、"],["その"],["頭","あたま"],["を"],["首","くび"],["の"],["根","ね"],["の"],["ところ"],["で"],["、"],["摘み","つみ"],["破らなければ","やぶらなければ"],["ならない"],["。"],["ただし"],["、"],["切り離して","きりはなして"],["は"],["ならない"],["。"]]},{"verse":9,"text":"そしてその罪祭,ざいさいの血,ちを祭壇,さいだんの側面,そくめんに注,そそぎ、残,のこりの血,ちは祭壇,さいだんのもとに絞,しぼり出,ださなければならない。これは罪祭,ざいさいである。","tok":[["そして"],["その"],["罪","つみ"],["祭","まつり"],["の"],["血","ち"],["を"],["祭壇","さいだん"],["の"],["側面","そくめん"],["に"],["注ぎ","そそぎ"],["、"],["残り","のこり"],["の"],["血","ち"],["は"],["祭壇","さいだん"],["の"],["もと"],["に"],["絞","しぼり"],["出さなければ","ださなければ"],["ならない"],["。"],["これ"],["は"],["罪","つみ"],["祭","まつり"],["い"],["さい"],["で"],["ある"],["。"]]},{"verse":10,"text":"また第,だい二のものは、定,さだめにしたがって燔祭,はんさいとしなければならない。こうして、祭司,さいしが彼,かれのためにその犯,おかした罪,つみのあがないをするならば、彼,かれはゆるされるであろう。","tok":[["また"],["第","だい"],["二","に"],["の"],["もの"],["は"],["、"],["定め","さだめ"],["に"],["したがって"],["燔祭","はんさい"],["と"],["しなければ"],["ならない"],["。"],["こう"],["して"],["、"],["祭司","さいし"],["が"],["彼","かれ"],["の"],["ため"],["に"],["その"],["犯した","おかした"],["罪","つみ"],["の"],["あ"],["が"],["ない"],["を"],["するならば"],["、"],["彼","かれ"],["は"],["ゆるされるで"],["あろう"],["。"]]},{"verse":11,"text":"もし二羽,わの山,やまばとにも、二羽,わの家,いえばとのひなにも、手,ての届,とどかないときは、彼,かれの犯,おかした罪,つみのために、供,そなえ物,ものとして麦粉,むぎこ十分,ぶんの一エパを携,たずさえてきて、これを罪祭,ざいさいとしなければならない。ただし、その上,うえに油,あぶらをかけてはならない。またその上,うえに乳香,にゅうこうを添,そえてはならない。これは罪祭,ざいさいだからである。","tok":[["もし"],["二羽","わ"],["の"],["山ばと","やまばと"],["に"],["も"],["、"],["二羽","わ"],["の"],["家ばと","いえばと"],["の"],["ひな"],["に"],["も"],["、"],["手","て"],["の"],["届かない","とどかない"],["とき"],["は"],["、"],["彼","かれ"],["の"],["犯した","おかした"],["罪","つみ"],["の"],["ため"],["に"],["、"],["供え物","そなえもの"],["として"],["麦粉","むぎこ"],["十分","ぶん"],["の"],["一","いち"],["エパ"],["を"],["携えて","たずさえて"],["きて"],["、"],["これ"],["を"],["罪","つみ"],["祭","まつり"],["と"],["しなければ"],["ならない"],["。"],["ただし"],["、"],["その"],["上","うえ"],["に"],["油","あぶら"],["を"],["かけて"],["は"],["ならない"],["。"],["また"],["その"],["上","うえ"],["に"],["乳香","にゅうこう"],["を"],["添えて","そえて"],["は"],["ならない"],["。"],["これ"],["は"],["罪","つみ"],["祭","まつり"],["ら"],["で"],["ある"],["。"]]},{"verse":12,"text":"彼,かれはこれを祭司,さいしのもとに携,たずさえて行,いき、祭司,さいしは一握,ひとにぎりを取,とって、記念,きねんの分,ぶんとし、これを主,しゅにささげる火祭,かさいのように、祭壇,さいだんの上,うえで焼,やかなければならない。これは罪祭,ざいさいである。","tok":[["彼","かれ"],["は"],["これ"],["を"],["祭司","さいし"],["の"],["もと"],["に"],["携えて","たずさえて"],["行き","いき"],["、"],["祭司","さいし"],["は"],["一握り","ひとにぎり"],["を"],["取って","とって"],["、"],["記念","きねん"],["の"],["分","ぶん"],["と"],["し"],["、"],["これ"],["を"],["主に","しゅに"],["ささげる"],["火祭","かさい"],["の"],["よう"],["に"],["、"],["祭壇","さいだん"],["の"],["上","うえ"],["で"],["焼かなければ","やかなければ"],["ならない"],["。"],["これ"],["は"],["罪","つみ"],["祭","まつり"],["い"],["さい"],["で"],["ある"],["。"]]},{"verse":13,"text":"こうして、祭司,さいしが彼,かれのため、すなわち、彼,かれがこれらの一つを犯,おかした罪,つみのために、あがないをするならば、彼,かれはゆるされるであろう。そしてその残,のこりは素祭,そさいと同,おなじく、祭司,さいしに帰,きするであろう』」。","tok":[["こう"],["して"],["、"],["祭司","さいし"],["が"],["彼","かれ"],["の"],["ため"],["、"],["すなわち"],["、"],["彼","かれ"],["が"],["これ"],["ら"],["の"],["一","ひと"],["つ"],["を"],["犯した","おかした"],["罪","つみ"],["の"],["ため"],["に"],["、"],["あがない"],["を"],["するならば"],["、"],["彼","かれ"],["は"],["ゆるされるで"],["あろう"],["。"],["そして"],["その"],["残り","のこり"],["は"],["素","す"],["祭","まつり"],["と"],["同じく","おなじく"],["、"],["祭司","さいし"],["に"],["帰するで","きするで"],["あろう"],["』"],["」"],["。"]]},{"verse":14,"text":"主,しゅはまたモーセに言,いわれた、","tok":[["主","しゅ"],["は"],["また"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":15,"text":"「もし人,ひとが不正,ふせいをなし、あやまって主,しゅの聖,せいなる物,ものについて罪,つみを犯,おかしたときは、その償,つぐないとして、あなたの値,ね積,づもりにしたがい、聖所,せいじょのシケルで、銀,ぎん数,すうシケルに当,あたる雄羊,おひつじの全,まったきものを、群,むれのうちから取,とり、それを主,しゅに携,たずさえてきて、愆祭,けんさいとしなければならない。","tok":[["「"],["もし"],["人","ひと"],["が"],["不正","ふせい"],["を"],["なし"],["、"],["あやまって"],["主","しゅ"],["の"],["聖","せい"],["なる"],["物","もの"],["について"],["罪","つみ"],["を"],["犯した","おかした"],["とき"],["は"],["、"],["その"],["償ない","つぐない"],["として"],["、"],["あなた"],["の"],["値","ね"],["積","づもり"],["に"],["したがい"],["、"],["聖","せい"],["所","しょ"],["の"],["シケル"],["で"],["、"],["銀","ぎん"],["数","すう"],["シケル"],["に"],["当たる","あたる"],["雄羊","おひつじ"],["の"],["全","まったきも"],["の"],["を"],["、"],["群れ","むれ"],["の"],["うち"],["から"],["取","とり"],["、"],["それ"],["を"],["主に","しゅに"],["携えて","たずさえて"],["きて"],["、"],["愆祭","けんさい"],["と"],["しなければ"],["ならない"],["。"]]},{"verse":16,"text":"そしてその聖,せいなる物,ものについて犯,おかした罪,つみのために償,つぐないをし、またその五分,ぶんの一をこれに加,くわえて、祭司,さいしに渡,わたさなければならない。こうして祭司,さいしがその愆祭,けんさいの雄羊,おひつじをもって、彼,かれのためにあがないをするならば、彼,かれはゆるされるであろう。","tok":[["そして"],["その"],["聖","せい"],["なる"],["物","もの"],["について"],["犯した","おかした"],["罪","つみ"],["の"],["ため"],["に"],["償ない","つぐない"],["を"],["し"],["、"],["また"],["その"],["五分","ぶん"],["の"],["一","いち"],["を"],["これ"],["に"],["加えて","くわえて"],["、"],["祭司","さいし"],["に"],["渡さなければ","わたさなければ"],["ならない"],["。"],["こう"],["して"],["祭司","さいし"],["が"],["その"],["愆祭","けんさい"],["の"],["雄羊","おひつじ"],["を"],["もって"],["、"],["彼","かれ"],["の"],["ため"],["に"],["あがない"],["を"],["するならば"],["、"],["彼","かれ"],["は"],["ゆるされるで"],["あろう"],["。"]]},{"verse":17,"text":"また人,ひとがもし罪,つみを犯,おかし、主,しゅのいましめにそむいて、してはならないことの一つをしたときは、たといそれを知,しらなくても、彼,かれは罪,つみを得,え、そのとがを負,おわなければならない。","tok":[["また"],["人","ひと"],["が"],["もし"],["罪","つみ"],["を"],["犯し","おかし"],["、"],["主","しゅ"],["の"],["いましめ"],["に"],["そむいて"],["、"],["して"],["は"],["ならない"],["こと"],["の"],["一","ひと"],["つ"],["を"],["した"],["とき"],["は"],["、"],["たとい"],["それ"],["を"],["知らなくて","しらなくて"],["も"],["、"],["彼","かれ"],["は"],["罪","つみ"],["を"],["得","え"],["、"],["その"],["とが"],["を"],["負わなければ","おわなければ"],["ならない"],["。"]]},{"verse":18,"text":"彼,かれはあなたの値,ね積,づもりにしたがって、雄羊,おひつじの全,まったきものを群,むれのうちから取,とり、愆祭,けんさいとしてこれを祭司,さいしのもとに携,たずさえてこなければならない。こうして、祭司,さいしが彼,かれのために、すなわち彼,かれが知,しらないで、しかもあやまって犯,おかした過失,かしつのために、あがないをするならば、彼,かれはゆるされるであろう。","tok":[["彼","かれ"],["は"],["あなた"],["の"],["値","ね"],["積","づもり"],["に"],["したがって"],["、"],["雄羊","おひつじ"],["の"],["全","まったきも"],["の"],["を"],["群れ","むれ"],["の"],["うち"],["から"],["取","とり"],["、"],["愆祭","けんさい"],["として"],["これ"],["を"],["祭司","さいし"],["の"],["もと"],["に"],["携えて","たずさえて"],["こなければ"],["ならない"],["。"],["こう"],["して"],["、"],["祭司","さいし"],["が"],["彼","かれ"],["の"],["ため"],["に"],["、"],["すなわち"],["彼","かれ"],["が"],["知らないで","しらないで"],["、"],["しかも"],["あやまって"],["犯した","おかした"],["過失","かしつ"],["の"],["ため"],["に"],["、"],["あがない"],["を"],["するならば"],["、"],["彼","かれ"],["は"],["ゆるされるで"],["あろう"],["。"]]},{"verse":19,"text":"これは愆祭,けんさいである。彼,かれは確,たしかに主,しゅの前,まえにとがを得,えたからである」。","tok":[["これ"],["は"],["愆祭","けん"],["さいで"],["ある"],["。"],["彼","かれ"],["は"],["確か","たしか"],["に"],["主","しゅ"],["の"],["前","まえ"],["に"],["とが"],["を"],["得た","えた"],["から"],["で"],["ある"],["」"],["。"]]},{"verse":20,"text":"[6:1]主,しゅはまたモーセに言,いわれた、","tok":[["["],["6"],[":"],["1"],["]"],["主","しゅ"],["は"],["また"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":21,"text":"[6:2]「もし人,ひとが罪,つみを犯,おかし、主,しゅに対,たいして不正,ふせいをなしたとき、すなわち預,あずかり物,もの、手,てにした質草,しちぐさ、またはかすめた物,ものについて、その隣人,りんじんを欺,あざむき、あるいはその隣人,りんじんをしえたげ、","tok":[["["],["6"],[":"],["2"],["]"],["「"],["もし"],["人","ひと"],["が"],["罪","つみ"],["を"],["犯し","おかし"],["、"],["主に","しゅに"],["対して","たいして"],["不正","ふせい"],["を"],["なした"],["とき"],["、"],["すなわち"],["預かり物","あずかりもの"],["、"],["手","て"],["に"],["した"],["質草","しちぐさ"],["、"],["また"],["は"],["かすめた"],["物","もの"],["について"],["、"],["その"],["隣人","りんじん"],["を"],["欺き","あざむき"],["、"],["あるいは"],["その"],["隣人","りんじん"],["を"],["し"],["えたげ"],["、"]]},{"verse":22,"text":"[6:3]あるいは落,おとし物,ものを拾,ひろい、それについて欺,あざむき、偽,いつわって誓,ちかうなど、すべて人,ひとがそれをなして罪,つみとなることの一つについて、","tok":[["["],["6"],[":"],["3"],["]"],["あるいは"],["落とし物","おとしもの"],["を"],["拾い","ひろい"],["、"],["それ"],["について"],["欺き","あざむき"],["、"],["偽わって","いつわって"],["誓う","ちかう"],["など"],["、"],["すべて"],["人","ひと"],["が"],["それ"],["を"],["なして"],["罪","つみ"],["と"],["なる"],["こと"],["の"],["一","ひと"],["つ"],["について"],["、"]]},{"verse":23,"text":"[6:4]罪,つみを犯,おかし、とがを得,えたならば、彼,かれはそのかすめた物,もの、しえたげて取,とった物,もの、預,あずかった物,もの、拾,ひろった落,おとし物,もの、","tok":[["["],["6"],[":"],["4"],["]"],["罪","つみ"],["を"],["犯し","おかし"],["、"],["とが"],["を"],["得たならば","えたならば"],["、"],["彼","かれ"],["は"],["その"],["かすめた"],["物","もの"],["、"],["し"],["えたげて"],["取った","とった"],["物","もの"],["、"],["預かった","あずかった"],["物","もの"],["、"],["拾った","ひろった"],["落とし物","おとしもの"],["、"]]},{"verse":24,"text":"[6:5]または偽,いつわり誓,ちかったすべての物,ものを返,かえさなければならない。すなわち残,のこりなく償,つぐない、更,さらにその五分,ぶんの一をこれに加,くわえ、彼,かれが愆祭,けんさいをささげる日,ひに、これをその元,もとの持,もち主,ぬしに渡,わたさなければならない。","tok":[["["],["6"],[":"],["5"],["]"],["また"],["は"],["偽わり","いつわり"],["誓った","ちかった"],["すべて"],["の"],["物","もの"],["を"],["返えさなければ","かえさなければ"],["ならない"],["。"],["すなわち"],["残り","のこり"],["なく"],["償ない","つぐない"],["、"],["更に","さらに"],["その"],["五分","ぶん"],["の"],["一","いち"],["を"],["これ"],["に"],["加え","くわえ"],["、"],["彼","かれ"],["が"],["愆祭","けんさい"],["を"],["ささげる"],["日","ひ"],["に"],["、"],["これ"],["を"],["その"],["元","もと"],["の"],["持主","もちぬし"],["に"],["渡さなければ","わたさなければ"],["ならない"],["。"]]},{"verse":25,"text":"[6:6]彼,かれはその償,つぐないとして、あなたの値,ね積,づもりにしたがい、雄羊,おひつじの全,まったきものを、群,むれの中,なかから取,とり、これを祭司,さいしのもとに携,たずさえてきて、愆祭,けんさいとして主,しゅにささげなければならない。","tok":[["["],["6"],[":"],["6"],["]"],["彼","かれ"],["は"],["その"],["償ない","つぐない"],["として"],["、"],["あなた"],["の"],["値","ね"],["積","づもり"],["に"],["したがい"],["、"],["雄羊","おひつじ"],["の"],["全","まったきも"],["の"],["を"],["、"],["群れ","むれ"],["の"],["中","なか"],["から"],["取","とり"],["、"],["これ"],["を"],["祭司","さいし"],["の"],["もと"],["に"],["携えて","たずさえて"],["きて"],["、"],["愆祭","けんさい"],["として"],["主に","しゅに"],["ささげなければ"],["ならない"],["。"]]},{"verse":26,"text":"[6:7]こうして、祭司,さいしが主,しゅの前,まえで彼,かれのためにあがないをするならば、彼,かれはそのいずれを行,おこなってとがを得,えてもゆるされるであろう」。","tok":[["["],["6"],[":"],["7"],["]"],["こう"],["して"],["、"],["祭司","さいし"],["が"],["主","しゅ"],["の"],["前","まえ"],["で"],["彼","かれ"],["の"],["ため"],["に"],["あがない"],["を"],["するならば"],["、"],["彼","かれ"],["は"],["その"],["いずれ"],["を"],["行なって","おこなって"],["とが"],["を"],["得て","えて"],["も"],["ゆるされるで"],["あろう"],["」"],["。"]]}]
[{"verse":1,"text":"主,しゅはまたモーセとアロンに言,いわれた、","tok":[["主","しゅ"],["は"],["また"],["モーセ"],["と"],["アロン"],["に"],["言われた","いわれた"],["、"]]},{"verse":2,"text":"「イスラエルの人々,ひとびとに言,いいなさい、『地,ちにあるすべての獣,けもののうち、あなたがたの食,たべることができる動物,どうぶつは次,つぎのとおりである。","tok":[["「"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["言い","いい"],["なさい"],["、"],["『"],["地","ち"],["に"],["ある"],["すべて"],["の"],["獣","けもの"],["の"],["うち"],["、"],["あなた"],["がた"],["の"],["食べる","たべる"],["こと"],["が"],["できる"],["動物","どうぶつ"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"]]},{"verse":3,"text":"獣,けもののうち、すべてひずめの分,わかれたもの、すなわち、ひずめの全,まったく切,きれたもの、反芻,はんすうするものは、これを食,たべることができる。","tok":[["獣","けもの"],["の"],["うち"],["、"],["すべて"],["ひずめ"],["の"],["分かれた","わかれた"],["もの"],["、"],["すなわち"],["、"],["ひずめ"],["の"],["全く","まったく"],["切れた","きれた"],["もの"],["、"],["反芻","はんすう"],["する"],["もの"],["は"],["、"],["これ"],["を"],["食べる","たべる"],["こと"],["が"],["できる"],["。"]]},{"verse":4,"text":"ただし、反芻,はんすうするもの、またはひずめの分,わかれたもののうち、次,つぎのものは食,たべてはならない。すなわち、らくだ、これは、反芻,はんすうするけれども、ひずめが分,わかれていないから、あなたがたには汚,けがれたものである。","tok":[["ただし"],["、"],["反芻","はんすう"],["する"],["もの"],["、"],["また"],["は"],["ひずめ"],["の"],["分かれた","わかれた"],["もの"],["の"],["うち"],["、"],["次","つぎ"],["の"],["もの"],["は"],["食べて","たべて"],["は"],["ならない"],["。"],["すなわち"],["、"],["らく"],["だ"],["、"],["これ"],["は"],["、"],["反芻","はんすう"],["する"],["けれど"],["も"],["、"],["ひずめ"],["が"],["分かれて","わかれて"],["いない"],["から"],["、"],["あなた"],["がた"],["に"],["は"],["汚","けがれたも"],["ので"],["ある"],["。"]]},{"verse":5,"text":"岩,いわたぬき、これは、反芻,はんすうするけれども、ひずめが分,わかれていないから、あなたがたには汚,けがれたものである。","tok":[["岩","いわ"],["たぬき"],["、"],["これ"],["は"],["、"],["反芻","はんすう"],["する"],["けれど"],["も"],["、"],["ひずめ"],["が"],["分かれて","わかれて"],["いない"],["から"],["、"],["あなた"],["がた"],["に"],["は"],["汚","けがれたも"],["ので"],["ある"],["。"]]},{"verse":6,"text":"野,のうさぎ、これは、反芻,はんすうするけれども、ひずめが分,わかれていないから、あなたがたには汚,けがれたものである。","tok":[["野うさぎ","のうさぎ"],["、"],["これ"],["は"],["、"],["反芻","はんすう"],["する"],["けれど"],["も"],["、"],["ひずめ"],["が"],["分かれて","わかれて"],["いない"],["から"],["、"],["あなた"],["がた"],["に"],["は"],["汚","けがれたも"],["ので"],["ある"],["。"]]},{"verse":7,"text":"豚,ぶた、これは、ひずめが分,わかれており、ひずめが全,まったく切,きれているけれども、反芻,はんすうすることをしないから、あなたがたには汚,けがれたものである。","tok":[["豚","ぶた"],["、"],["これ"],["は"],["、"],["ひずめ"],["が"],["分かれて","わかれて"],["おり"],["、"],["ひずめ"],["が"],["全く","まったく"],["切れて","きれて"],["いる"],["けれど"],["も"],["、"],["反芻","はんすう"],["する"],["こと"],["を"],["しない"],["から"],["、"],["あなた"],["がた"],["に"],["は"],["汚","けがれたも"],["ので"],["ある"],["。"]]},{"verse":8,"text":"あなたがたは、これらのものの肉,にくを食,たべてはならない。またその死体,したいに触,ふれてはならない。これらは、あなたがたには汚,けがれたものである。","tok":[["あなた"],["がた"],["は"],["、"],["これ"],["ら"],["の"],["もの"],["の"],["肉","にく"],["を"],["食べて","たべて"],["は"],["ならない"],["。"],["また"],["その"],["死体","したい"],["に"],["触","ふれ"],["ては"],["ならない"],["。"],["これ"],["ら"],["は"],["、"],["あなた"],["がた"],["に"],["は"],["汚","けがれたも"],["ので"],["ある"],["。"]]},{"verse":9,"text":"水,みずの中,なかにいるすべてのもののうち、あなたがたの食,たべることができるものは次,つぎのとおりである。すなわち、海,うみでも、川,かわでも、すべて水,みずの中,なかにいるもので、ひれと、うろこのあるものは、これを食,たべることができる。","tok":[["水","みず"],["の"],["中","なか"],["に"],["いる"],["すべて"],["の"],["もの"],["の"],["うち"],["、"],["あなた"],["がた"],["の"],["食べる","たべる"],["こと"],["が"],["できる"],["もの"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["すなわち"],["、"],["海","うみ"],["で"],["も"],["、"],["川","かわ"],["で"],["も"],["、"],["すべて"],["水","みず"],["の"],["中","なか"],["に"],["いる"],["もの"],["で"],["、"],["ひれ"],["と"],["、"],["うろこ"],["の"],["ある"],["もの"],["は"],["、"],["これ"],["を"],["食べる","たべる"],["こと"],["が"],["できる"],["。"]]},{"verse":10,"text":"すべて水,みずに群,むらがるもの、またすべての水,みずの中,なかにいる生,いき物,もののうち、すなわち、すべて海,うみ、また川,かわにいて、ひれとうろこのないものは、あなたがたに忌,いむべきものである。","tok":[["すべて"],["水","みず"],["に"],["群らがる","むらがる"],["もの"],["、"],["また"],["すべて"],["の"],["水","みず"],["の"],["中","なか"],["に"],["いる"],["生き物","いきもの"],["の"],["うち"],["、"],["すなわち"],["、"],["すべて"],["海","うみ"],["、"],["また"],["川","かわ"],["に"],["いて"],["、"],["ひれ"],["と"],["うろこ"],["の"],["ない"],["もの"],["は"],["、"],["あなた"],["がた"],["に"],["忌むべき","いむべき"],["もの"],["で"],["ある"],["。"]]},{"verse":11,"text":"これらはあなたがたに忌,いむべきものであるから、あなたがたはその肉,にくを食,たべてはならない。またその死体,したいは忌,いむべきものとしなければならない。","tok":[["これ"],["ら"],["は"],["あなた"],["がた"],["に"],["忌むべき","いむべき"],["もの"],["で"],["ある"],["から"],["、"],["あなた"],["がた"],["は"],["その"],["肉","にく"],["を"],["食べて","たべて"],["は"],["ならない"],["。"],["また"],["その"],["死体","したい"],["は"],["忌むべき","いむべき"],["もの"],["と"],["しなければ"],["ならない"],["。"]]},{"verse":12,"text":"すべて水,みずの中,なかにいて、ひれも、うろこもないものは、あなたがたに忌,いむべきものである。","tok":[["すべて"],["水","みず"],["の"],["中","なか"],["に"],["いて"],["、"],["ひれ"],["も"],["、"],["うろこ"],["も"],["ない"],["もの"],["は"],["、"],["あなた"],["がた"],["に"],["忌むべき","いむべき"],["もの"],["で"],["ある"],["。"]]},{"verse":13,"text":"鳥,とりのうち、次,つぎのものは、あなたがたに忌,いむべきものとして、食,たべてはならない。それらは忌,いむべきものである。すなわち、はげわし、ひげはげわし、みさご、","tok":[["鳥","とり"],["の"],["うち"],["、"],["次","つぎ"],["の"],["もの"],["は"],["、"],["あなた"],["がた"],["に"],["忌むべき","いむべき"],["もの"],["として"],["、"],["食べて","たべて"],["は"],["ならない"],["。"],["それ"],["ら"],["は"],["忌むべき","いむべき"],["もの"],["で"],["ある"],["。"],["すなわち"],["、"],["はげわし"],["、"],["ひげ"],["はげわし"],["、"],["みさご"],["、"]]},{"verse":14,"text":"とび、はやぶさの類,るい、","tok":[["とび"],["、"],["はやぶさ"],["の"],["類","るい"],["、"]]},{"verse":15,"text":"もろもろのからすの類,るい、","tok":[["もろもろ"],["の"],["からす"],["の"],["類","るい"],["、"]]},{"verse":16,"text":"だちょう、よたか、かもめ、たかの類,るい、","tok":[["だちょう"],["、"],["よたか"],["、"],["かもめ"],["、"],["たか"],["の"],["類","るい"],["、"]]},{"verse":17,"text":"ふくろう、う、みみずく、","tok":[["ふくろう"],["、"],["う"],["、"],["みみずく"],["、"]]},{"verse":18,"text":"むらさきばん、ペリカン、はげたか、","tok":[["むらさき"],["ばん"],["、"],["ペリカン"],["、"],["はげたか"],["、"]]},{"verse":19,"text":"こうのとり、さぎの類,るい、やつがしら、こうもり。","tok":[["こうのとり"],["、"],["さぎ"],["の"],["類","るい"],["、"],["やつ"],["が"],["しら"],["、"],["こうもり"],["。"]]},{"verse":20,"text":"また羽,はねがあって四つの足,あしで歩,あるくすべての這,はうものは、あなたがたに忌,いむべきものである。","tok":[["また"],["羽","はね"],["が"],["あって"],["四","よん"],["つ"],["の"],["足","あし"],["で"],["歩く","あるく"],["すべて"],["の"],["這う","はう"],["もの"],["は"],["、"],["あなた"],["がた"],["に"],["忌むべき","いむべき"],["もの"],["で"],["ある"],["。"]]},{"verse":21,"text":"ただし、羽,はねがあって四つの足,あしで歩,あるくすべての這,はうもののうち、その足,あしのうえに、跳,はね足,あしがあり、それで地,ちの上,うえをはねるものは食,たべることができる。","tok":[["ただし"],["、"],["羽","はね"],["が"],["あって"],["四","よん"],["つ"],["の"],["足","あし"],["で"],["歩く","あるく"],["すべて"],["の"],["這う","はう"],["もの"],["の"],["うち"],["、"],["その"],["足","あし"],["の"],["うえ"],["に"],["、"],["跳ね","はね"],["足","あし"],["が"],["あり"],["、"],["それ"],["で"],["地","ち"],["の"],["上","うえ"],["を"],["はねる"],["もの"],["は"],["食べる","たべる"],["こと"],["が"],["できる"],["。"]]},{"verse":22,"text":"すなわち、そのうち次,つぎのものは食,たべることができる。移住,いじゅういなごの類,るい、遍歴,へんれきいなごの類,るい、大,おおいなごの類,るい、小,しょういなごの類,るいである。","tok":[["すなわち"],["、"],["その"],["うち"],["次","つぎ"],["の"],["もの"],["は"],["食べる","たべる"],["こと"],["が"],["できる"],["。"],["移住","いじゅう"],["いなご"],["の"],["類","るい"],["、"],["遍歴","へんれき"],["いなご"],["の"],["類","るい"],["、"],["大","おおいなご"],["の"],["類","るい"],["、"],["小","しょう"],["いなご"],["の"],["類","るい"],["で"],["ある"],["。"]]},{"verse":23,"text":"しかし、羽,はねがあって四つの足,あしで歩,あるく、そのほかのすべての這,はうものは、あなたがたに忌,いむべきものである。","tok":[["しかし"],["、"],["羽","はね"],["が"],["あって"],["四","よん"],["つ"],["の"],["足","あし"],["で"],["歩く","あるく"],["、"],["その"],["ほか"],["の"],["すべて"],["の"],["這う","はう"],["もの"],["は"],["、"],["あなた"],["がた"],["に"],["忌むべき","いむべき"],["もの"],["で"],["ある"],["。"]]},{"verse":24,"text":"あなたがたは次,つぎの場合,ばあいに汚,けがれたものとなる。すなわち、すべてこれらのものの死体,したいに触,ふれる者,ものは夕,ゆうまで汚,けがれる。","tok":[["あなた"],["がた"],["は"],["次","つぎ"],["の"],["場合","ばあい"],["に"],["汚","けがれたも"],["の"],["と"],["なる"],["。"],["すなわち"],["、"],["すべて"],["これ"],["ら"],["の"],["もの"],["の"],["死体","したい"],["に"],["触れる","ふれる"],["者","もの"],["は"],["夕","ゆう"],["まで"],["汚","け"],["がれる"],["。"]]},{"verse":25,"text":"すべてこれらのものの死体,したいを運,はこぶ者,ものは、その衣服,いふくを洗,あらわなければならない。彼,かれは夕,ゆうまで汚,けがれる。","tok":[["すべて"],["これ"],["ら"],["の"],["もの"],["の"],["死体","したい"],["を"],["運こぶ","はこぶ"],["者","もの"],["は"],["、"],["その"],["衣服","いふく"],["を"],["洗わなければ","あらわなければ"],["ならない"],["。"],["彼","かれ"],["は"],["夕","ゆう"],["まで"],["汚","け"],["がれる"],["。"]]},{"verse":26,"text":"すべて、ひずめの分,わかれた獣,けもので、その切,きれ目,めの切,きれていないもの、また、反芻,はんすうすることをしないものは、あなたがたに汚,けがれたものである。すべて、これに触,ふれる者,ものは汚,けがれる。","tok":[["すべて"],["、"],["ひずめ"],["の"],["分かれた","わかれた"],["獣","けもの"],["で"],["、"],["その"],["切れ目","きれめ"],["の"],["切れて","きれて"],["いない"],["もの"],["、"],["また"],["、"],["反芻","はんすう"],["する"],["こと"],["を"],["しない"],["もの"],["は"],["、"],["あなた"],["がた"],["に"],["汚","けがれたも"],["ので"],["ある"],["。"],["すべて"],["、"],["これ"],["に"],["触れる","ふれる"],["者","もの"],["は"],["汚","け"],["がれる"],["。"]]},{"verse":27,"text":"すべて四つの足,あしで歩,あるく獣,けもののうち、その足,あしの裏,うらのふくらみで歩,あるくものは皆,みなあなたがたに汚,けがれたものである。すべてその死体,したいに触,ふれる者,ものは夕,ゆうまで汚,けがれる。","tok":[["すべて"],["四","よん"],["つ"],["の"],["足","あし"],["で"],["歩く","あるく"],["獣","けもの"],["の"],["うち"],["、"],["その"],["足","あし"],["の"],["裏","うら"],["の"],["ふくらみ"],["で"],["歩く","あるく"],["もの"],["は"],["皆","みな"],["あなた"],["がた"],["に"],["汚","けがれたも"],["ので"],["ある"],["。"],["すべて"],["その"],["死体","したい"],["に"],["触れる","ふれる"],["者","もの"],["は"],["夕","ゆう"],["まで"],["汚","け"],["がれる"],["。"]]},{"verse":28,"text":"その死体,したいを運,はこぶ者,ものは、その衣服,いふくを洗,あらわなければならない。彼,かれは夕,ゆうまで汚,けがれる。これは、あなたがたに汚,けがれたものである。","tok":[["その"],["死体","したい"],["を"],["運こぶ","はこぶ"],["者","もの"],["は"],["、"],["その"],["衣服","いふく"],["を"],["洗わなければ","あらわなければ"],["ならない"],["。"],["彼","かれ"],["は"],["夕","ゆう"],["まで"],["汚","け"],["がれる"],["。"],["これ"],["は"],["、"],["あなた"],["がた"],["に"],["汚","けがれたも"],["ので"],["ある"],["。"]]},{"verse":29,"text":"地,ちにはう這,はうもののうち、次,つぎのものはあなたがたに汚,けがれたものである。すなわち、もぐらねずみ、とびねずみ、とげ尾,おとかげの類,るい、","tok":[["地","ち"],["に"],["は"],["う"],["這う","はう"],["もの"],["の"],["うち"],["、"],["次","つぎ"],["の"],["もの"],["は"],["あなた"],["がた"],["に"],["汚","けがれたも"],["ので"],["ある"],["。"],["すなわち"],["、"],["もぐら"],["ねずみ"],["、"],["とび"],["ねずみ"],["、"],["とげ"],["尾","お"],["とかげ"],["の"],["類","るい"],["、"]]},{"verse":30,"text":"やもり、大,だいとかげ、とかげ、すなとかげ、カメレオン。","tok":[["やもり"],["、"],["大","だい"],["とかげ"],["、"],["とかげ"],["、"],["すな"],["とかげ"],["、"],["カメレオン"],["。"]]},{"verse":31,"text":"もろもろの這,はうもののうち、これらはあなたがたに汚,けがれたものである。すべてそれらのものが死,しんで、それに触,ふれる者,ものは夕,ゆうまで汚,けがれる。","tok":[["もろもろ"],["の"],["這う","はう"],["もの"],["の"],["うち"],["、"],["これ"],["ら"],["は"],["あなた"],["がた"],["に"],["汚","けがれたも"],["ので"],["ある"],["。"],["すべて"],["それ"],["ら"],["の"],["もの"],["が"],["死んで","しんで"],["、"],["それ"],["に"],["触れる","ふれる"],["者","もの"],["は"],["夕","ゆう"],["まで"],["汚","け"],["がれる"],["。"]]},{"verse":32,"text":"またそれらのものが死,しんで、それが落,おちかかった物,ものはすべて汚,けがれる。木,きの器,うつわであれ、衣服,いふくであれ、皮,かわであれ、袋,ふくろであれ、およそ仕事,しごとに使,つかう器,うつわはそれを水,みずに入,いれなければならない。それは夕,ゆうまで汚,けがれているが、そののち清,きよくなる。","tok":[["また"],["それ"],["ら"],["の"],["もの"],["が"],["死んで","しんで"],["、"],["それ"],["が"],["落","おち"],["かかった"],["物","もの"],["は"],["すべて"],["汚","け"],["がれる"],["。"],["木","き"],["の"],["器","うつわ"],["で"],["あれ"],["、"],["衣服","いふく"],["で"],["あれ"],["、"],["皮","かわ"],["で"],["あれ"],["、"],["袋","ふくろ"],["で"],["あれ"],["、"],["およそ"],["仕事","しごと"],["に"],["使う","つかう"],["器","うつわ"],["は"],["それ"],["を"],["水","みず"],["に"],["入れなければ","いれなければ"],["ならない"],["。"],["それ"],["は"],["夕","ゆう"],["まで"],["汚","け"],["がれ"],["て"],["いる"],["が"],["、"],["その"],["のち"],["清く","きよく"],["なる"],["。"]]},{"verse":33,"text":"またそれらのものが、土,つちの器,うつわの中,なかに落,おちたならば、その中,なかにあるものは皆,みな汚,けがれる。あなたがたはその器,うつわをこわさなければならない。","tok":[["また"],["それ"],["ら"],["の"],["もの"],["が"],["、"],["土","つち"],["の"],["器","うつわ"],["の"],["中","なか"],["に"],["落","おち"],["たならば"],["、"],["その"],["中","なか"],["に"],["ある"],["もの"],["は"],["皆","みな"],["汚","け"],["がれる"],["。"],["あなた"],["がた"],["は"],["その"],["器","うつわ"],["を"],["こわさなければ"],["ならない"],["。"]]},{"verse":34,"text":"またすべてその中,なかにある食物,しょくもつで、水分,すいぶんのあるものは汚,けがれる。またすべてそのような器,うつわの中,なかにある飲,のみ物,ものも皆,みな汚,けがれる。","tok":[["また"],["すべて"],["その"],["中","なか"],["に"],["ある"],["食物","しょくもつ"],["で"],["、"],["水分","すいぶん"],["の"],["ある"],["もの"],["は"],["汚","け"],["がれる"],["。"],["また"],["すべて"],["その"],["よう"],["な"],["器","うつわ"],["の"],["中","なか"],["に"],["ある"],["飲み物","のみもの"],["も"],["皆","みな"],["汚","け"],["がれる"],["。"]]},{"verse":35,"text":"またそれらのものの死体,したいが落,おちかかったならば、その物,ものはすべて汚,けがれる。天火,てんぴであれ、かまどであれ、それをこわさなければならない。これらは汚,けがれたもので、あなたがたに汚,けがれたものとなる。","tok":[["また"],["それ"],["ら"],["の"],["もの"],["の"],["死体","したい"],["が"],["落","おち"],["かかったならば"],["、"],["その"],["物","もの"],["は"],["すべて"],["汚","け"],["がれる"],["。"],["天火","てんぴ"],["で"],["あれ"],["、"],["かまど"],["で"],["あれ"],["、"],["それ"],["を"],["こわさなければ"],["ならない"],["。"],["これ"],["ら"],["は"],["汚","けがれたも"],["ので"],["、"],["あなた"],["がた"],["に"],["汚","けがれたも"],["の"],["と"],["なる"],["。"]]},{"verse":36,"text":"ただし、泉,いずみ、あるいは水,みずの集,あつまった水,みずたまりは汚,けがれない。しかし、その死体,したいに触,ふれる者,ものは汚,けがれる。","tok":[["ただし"],["、"],["泉","いずみ"],["、"],["あるいは"],["水","みず"],["の"],["集まった","あつまった"],["水たまり","みずたまり"],["は"],["汚","け"],["がれ"],["ない"],["。"],["しかし"],["、"],["その"],["死体","したい"],["に"],["触れる","ふれる"],["者","もの"],["は"],["汚","け"],["がれる"],["。"]]},{"verse":37,"text":"それらのものの死体,したいが、まく種,たねの上,うえに落,おちても、それは汚,けがれない。","tok":[["それ"],["ら"],["の"],["もの"],["の"],["死体","したい"],["が"],["、"],["まく"],["種","たね"],["の"],["上","うえ"],["に"],["落","おち"],["て"],["も"],["、"],["それ"],["は"],["汚","け"],["がれ"],["ない"],["。"]]},{"verse":38,"text":"ただし、種,たねの上,うえに水,みずがかかっていて、その上,うえにそれらのものの死体,したいが、落,おちるならば、それはあなたがたに汚,けがれたものとなる。","tok":[["ただし"],["、"],["種","たね"],["の"],["上","うえ"],["に"],["水","みず"],["が"],["かかって"],["いて"],["、"],["その"],["上","うえ"],["に"],["それ"],["ら"],["の"],["もの"],["の"],["死体","したい"],["が"],["、"],["落","おち"],["るならば"],["、"],["それ"],["は"],["あなた"],["がた"],["に"],["汚","けがれたも"],["の"],["と"],["なる"],["。"]]},{"verse":39,"text":"あなたがたの食,たべる獣,けものが死,しんだ時,とき、その死体,したいに触,ふれる者,ものは夕,ゆうまで汚,けがれる。","tok":[["あなた"],["がた"],["の"],["食べる","たべる"],["獣","けもの"],["が"],["死んだ","しんだ"],["時","とき"],["、"],["その"],["死体","したい"],["に"],["触れる","ふれる"],["者","もの"],["は"],["夕","ゆう"],["まで"],["汚","け"],["がれる"],["。"]]},{"verse":40,"text":"その死体,したいを食,たべる者,ものは、その衣服,いふくを洗,あらわなければならない。夕,ゆうまで汚,けがれる。その死体,したいを運,はこぶ者,ものも、その衣服,いふくを洗,あらわなければならない。夕,ゆうまで汚,けがれる。","tok":[["その"],["死体","したい"],["を"],["食べる","たべる"],["者","もの"],["は"],["、"],["その"],["衣服","いふく"],["を"],["洗わなければ","あらわなければ"],["ならない"],["。"],["夕","ゆう"],["まで"],["汚","け"],["がれる"],["。"],["その"],["死体","したい"],["を"],["運こぶ","はこぶ"],["者","もの"],["も"],["、"],["その"],["衣服","いふく"],["を"],["洗わなければ","あらわなければ"],["ならない"],["。"],["夕","ゆう"],["まで"],["汚","け"],["がれる"],["。"]]},{"verse":41,"text":"すべて地,ちにはう這,はうものは忌,いむべきものである。これを食,たべてはならない。","tok":[["すべて"],["地","ち"],["に"],["は"],["う"],["這う","はう"],["もの"],["は"],["忌むべき","いむべき"],["もの"],["で"],["ある"],["。"],["これ"],["を"],["食べて","たべて"],["は"],["ならない"],["。"]]},{"verse":42,"text":"すべて腹,はらばい行,いくもの、四つ足,あしで歩,あるくもの、あるいは多,おおくの足,あしをもつもの、すなわち、すべて地,ちにはう這,はうものは、あなたがたはこれを食,たべてはならない。それらは忌,いむべきものだからである。","tok":[["すべて"],["腹ばい","はらばい"],["行く","いく"],["もの"],["、"],["四つ足","四つあし"],["で"],["歩く","あるく"],["もの"],["、"],["あるいは"],["多く","おおく"],["の"],["足","あし"],["を"],["もつ"],["もの"],["、"],["すなわち"],["、"],["すべて"],["地","ち"],["に"],["は"],["う"],["這う","はう"],["もの"],["は"],["、"],["あなた"],["がた"],["は"],["これ"],["を"],["食べて","たべて"],["は"],["ならない"],["。"],["それ"],["ら"],["は"],["忌むべき","いむべき"],["もの"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":43,"text":"あなたがたはすべて這,はうものによって、あなたがたの身,みを忌,いむべきものとしてはならない。また、これをもって身,みを汚,けがし、あるいはこれによって汚,けがされてはならない。","tok":[["あなた"],["がた"],["は"],["すべて"],["這う","はう"],["もの"],["によって"],["、"],["あなた"],["がた"],["の"],["身","み"],["を"],["忌むべき","いむべき"],["もの"],["として"],["は"],["ならない"],["。"],["また"],["、"],["これ"],["を"],["もって"],["身","み"],["を"],["汚","け"],["がし"],["、"],["あるいは"],["これ"],["によって"],["汚","け"],["が"],["されて"],["は"],["ならない"],["。"]]},{"verse":44,"text":"わたしはあなたがたの神,かみ、主,しゅであるから、あなたがたはおのれを聖別,せいべつし、聖,せいなる者,ものとならなければならない。わたしは聖,せいなる者,ものである。地,ちにはう這,はうものによって、あなたがたの身,みを汚,けがしてはならない。","tok":[["わたし"],["は"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["で"],["ある"],["から"],["、"],["あなた"],["がた"],["は"],["おのれ"],["を"],["聖別","せいべつ"],["し"],["、"],["聖","せい"],["なる"],["者","もの"],["と"],["ならなければ"],["ならない"],["。"],["わたし"],["は"],["聖","せい"],["なる"],["者","もの"],["で"],["ある"],["。"],["地","ち"],["に"],["は"],["う"],["這う","はう"],["もの"],["によって"],["、"],["あなた"],["がた"],["の"],["身","み"],["を"],["汚","け"],["がして"],["は"],["ならない"],["。"]]},{"verse":45,"text":"わたしはあなたがたの神,かみとなるため、あなたがたをエジプトの国,くにから導,みちびき上,のぼった主,しゅである。わたしは聖,せいなる者,ものであるから、あなたがたは聖,せいなる者,ものとならなければならない』」。","tok":[["わたし"],["は"],["あなた"],["がた"],["の"],["神","かみ"],["と"],["なる"],["ため"],["、"],["あなた"],["がた"],["を"],["エジプト"],["の"],["国","くに"],["から"],["導き","みちびき"],["上った","のぼった"],["主","しゅ"],["で"],["ある"],["。"],["わたし"],["は"],["聖","せい"],["なる"],["者","もの"],["で"],["ある"],["から"],["、"],["あなた"],["がた"],["は"],["聖","せい"],["なる"],["者","もの"],["と"],["ならなければ"],["ならない"],["』"],["」"],["。"]]},{"verse":46,"text":"これは獣,けものと鳥,とりと、水,みずの中,なかに動,うごくすべての生,いき物,ものと、地,ちに這,はうすべてのものに関,かんするおきてであって、","tok":[["これ"],["は"],["獣","けもの"],["と"],["鳥","とり"],["と"],["、"],["水","みず"],["の"],["中","なか"],["に"],["動く","うごく"],["すべて"],["の"],["生き物","いきもの"],["と"],["、"],["地","ち"],["に"],["這う","はう"],["すべて"],["の"],["もの"],["に"],["関する","かんする"],["おきて"],["で"],["あって"],["、"]]},{"verse":47,"text":"汚,けがれたものと清,きよいもの、食,たべられる生,いき物,ものと、食,たべられない生,いき物,ものとを区別,くべつするものである。","tok":[["汚","けがれたも"],["の"],["と"],["清い","きよい"],["もの"],["、"],["食べられる","たべられる"],["生き物","いきもの"],["と"],["、"],["食べられない","たべられない"],["生き物","いきもの"],["と"],["を"],["区別","くべつ"],["する"],["もの"],["で"],["ある"],["。"]]}]
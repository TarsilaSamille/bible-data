[{"verse":1,"text":"主,しゅはまたモーセに言,いわれた、","tok":[["主","しゅ"],["は"],["また"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":2,"text":"「イスラエルの人々,ひとびとに言,いいなさい、『わたしはあなたがたの神,かみ、主,しゅである。","tok":[["「"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["言い","いい"],["なさい"],["、"],["『"],["わたし"],["は"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["で"],["ある"],["。"]]},{"verse":3,"text":"あなたがたの住,すんでいたエジプトの国,くにの習慣,しゅうかんを見習,みならってはならない。またわたしがあなたがたを導,みちびき入,いれるカナンの国,くにの習慣,しゅうかんを見習,みならってはならない。また彼,かれらの定,さだめに歩,あゆんではならない。","tok":[["あなた"],["がた"],["の"],["住んで","すんで"],["いた"],["エジプト"],["の"],["国","くに"],["の"],["習慣","しゅうかん"],["を"],["見","み"],["習らって","ならって"],["は"],["ならない"],["。"],["また"],["わたし"],["が"],["あなた"],["がた"],["を"],["導き入れる","みちびきいれる"],["カナン"],["の"],["国","くに"],["の"],["習慣","しゅうかん"],["を"],["見","み"],["習らって","ならって"],["は"],["ならない"],["。"],["また"],["彼","かれ"],["ら"],["の"],["定め","さだめ"],["に"],["歩","あゆん"],["で"],["は"],["ならない"],["。"]]},{"verse":4,"text":"わたしのおきてを行,おこない、わたしの定,さだめを守,まもり、それに歩,あゆまなければならない。わたしはあなたがたの神,かみ、主,しゅである。","tok":[["わたし"],["の"],["おきて"],["を"],["行ない","おこない"],["、"],["わたし"],["の"],["定め","さだめ"],["を"],["守り","まもり"],["、"],["それ"],["に"],["歩まなければ","あゆまなければ"],["ならない"],["。"],["わたし"],["は"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["で"],["ある"],["。"]]},{"verse":5,"text":"あなたがたはわたしの定,さだめとわたしのおきてを守,まもらなければならない。もし人,ひとが、これを行,おこなうならば、これによって生,いきるであろう。わたしは主,しゅである。","tok":[["あなた"],["がた"],["は"],["わたし"],["の"],["定め","さだめ"],["と"],["わたし"],["の"],["おきて"],["を"],["守らなければ","まもらなければ"],["ならない"],["。"],["もし"],["人","ひと"],["が"],["、"],["これ"],["を"],["行なうならば","おこなうならば"],["、"],["これ"],["によって"],["生きるで","いきるで"],["あろう"],["。"],["わたし"],["は"],["主","しゅ"],["で"],["ある"],["。"]]},{"verse":6,"text":"あなたがたは、だれも、その肉親,にくしんの者,ものに近,ちかづいて、これを犯,おかしてはならない。わたしは主,しゅである。","tok":[["あなた"],["がた"],["は"],["、"],["だれ"],["も"],["、"],["その"],["肉親","にくしん"],["の"],["者","もの"],["に"],["近づいて","ちかづいて"],["、"],["これ"],["を"],["犯して","おかして"],["は"],["ならない"],["。"],["わたし"],["は"],["主","しゅ"],["で"],["ある"],["。"]]},{"verse":7,"text":"あなたの母,ははを犯,おかしてはならない。それはあなたの父,ちちをはずかしめることだからである。彼女,かのじょはあなたの母,ははであ
[{"verse":1,"text":"主,しゅはまた、モーセとアロンに言,いわれた、","tok":[["主","しゅ"],["は"],["また"],["、"],["モーセ"],["と"],["アロン"],["に"],["言われた","いわれた"],["、"]]},{"verse":2,"text":"「イスラエルの人々,ひとびとに言,いいなさい、『だれでもその肉,にくに流出,りゅうしゅつがあれば、その流出,りゅうしゅつは汚,けがれである。","tok":[["「"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["言い","いい"],["なさい"],["、"],["『"],["だれ"],["で"],["も"],["その"],["肉","にく"],["に"],["流出","りゅうしゅつ"],["が"],["あれば"],["、"],["その"],["流出","りゅうしゅつ"],["は"],["汚","け"],["がれ"],["で"],["ある"],["。"]]},{"verse":3,"text":"その流出,りゅうしゅつによる汚,けがれは次,つぎのとおりである。すなわち、その肉,にくの流出,りゅうしゅつが続,つづいていても、あるいは、その肉,にくの流出,りゅうしゅつが止,とまっていても、共,ともに汚,けがれである。","tok":[["その"],["流出","りゅうしゅつ"],["に"],["よる"],["汚","けがれ"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["すなわち"],["、"],["その"],["肉","にく"],["の"],["流出","りゅうしゅつ"],["が"],["続いて","つづいて"],["いて"],["も"],["、"],["あるいは"],["、"],["その"],["肉","にく"],["の"],["流出","りゅうしゅつ"],["が"],["止まって","とまって"],["いて"],["も"],["、"],["共","とも"],["に"],["汚","け"],["がれ"],["で"],["ある"],["。"]]},{"verse":4,"text":"流出,りゅうしゅつある者,ものの寝,ねた床,とこはすべて汚,けがれる。またその人,ひとのすわった物,ものはすべて汚,けがれるであろう。","tok":[["流出","りゅうしゅつ"],["ある"],["者","もの"],["の"],["寝た","ねた"],["床","とこ"],["は"],["すべて"],["汚","け"],["がれる"],["。"],["また"],["その"],["人","ひと"],["の"],["すわった"],["物","もの"],["は"],["すべて"],["汚","け"],["がれる"],["で"],["あろう"],["。"]]},{"verse":5,"text":"その床,とこに触,ふれる者,ものは、その衣服,いふくを洗,あらい、水,みずに身,みをすすがなければならない。彼,かれは夕,ゆうまで汚,けがれるであろう。","tok":[["その"],["床","とこ"],["に"],["触れる","ふれる"],["者","もの"],["は"],["、"],["その"],["衣服","いふく"],["を"],["洗","あらい"],["、"],["水","みず"],["に"],["身","み"],["を"],["すすがなければ"],["ならない"],["。"],["彼","かれ"],["は"],["夕","ゆう"],["まで"],["汚","け"],["がれる"],["で"],["あろう"],["。"]]},{"verse":6,"text":"流出,りゅうしゅつある者,もののすわった物,ものの上,うえにすわる者,ものは、その衣服,いふくを洗,あらい、水,みずに身,みをすすがなければならない。彼,かれは夕,ゆうまで汚,けがれるであろう。","tok":[["流出","りゅうしゅつ"],["ある"],["者","もの"],["の"],["すわった"],["物","もの"],["の"],["上","うえ"],["に"],["すわる"],["者","もの"],["は"],["、"],["その"],["衣服","いふく"],["を"],["洗","あらい"],["、"],["水","みず"],["に"],["身","み"],["を"],["すすがなければ"],["ならない"],["。"],["彼","かれ"],["は"],["夕","ゆう"],["まで"],["汚","け"],["がれる"],["で"],["あろう"],["。"]]},{"verse":7,"text":"流出,りゅうしゅつある者,ものの肉,にくに触,ふれる者,ものは衣服,いふくを洗,あらい、水,みずに身,みをすすがなければならない。彼,かれは夕,ゆうまで汚,けがれるであろう。","tok":[["流出","りゅうしゅつ"],["ある"],["者","もの"],["の"],["肉","にく"],["に"],["触れる","ふれる"],["者","もの"],["は"],["衣服","いふく"],["を"],["洗","あらい"],["、"],["水","みず"],["に"],["身","み"],["を"],["すすがなければ"],["ならない"],["。"],["彼","かれ"],["は"],["夕","ゆう"],["まで"],["汚","け"],["がれる"],["で"],["あろう"],["。"]]},{"verse":8,"text":"流出,りゅうしゅつある者,もののつばきが、清,きよい者,ものにかかったならば、その人,ひとは衣服,いふくを洗,あらい、水,みずに身,みをすすがなければならない。彼,かれは夕,ゆうまで汚,けがれるであろう。","tok":[["流出","りゅうしゅつ"],["ある"],["者","もの"],["の"],["つばき"],["が"],["、"],["清い","きよい"],["者","もの"],["に"],["かかったならば"],["、"],["その"],["人","ひと"],["は"],["衣服","いふく"],["を"],["洗","あらい"],["、"],["水","みず"],["に"],["身","み"],["を"],["すすがなければ"],["ならない"],["。"],["彼","かれ"],["は"],["夕","ゆう"],["まで"],["汚","け"],["がれる"],["で"],["あろう"],["。"]]},{"verse":9,"text":"流出,りゅうしゅつある者,ものの乗,のった鞍,くらはすべて汚,けがれる。","tok":[["流出","りゅうしゅつ"],["ある"],["者","もの"],["の"],["乗った","のった"],["鞍","くら"],["は"],["すべて"],["汚","け"],["がれる"],["。"]]},{"verse":10,"text":"また彼,かれの下,したになった物,ものに触,ふれる者,ものは、すべて夕,ゆうまで汚,けがれるであろう。またそれらの物,ものを運,はこぶ者,ものは、その衣服,いふくを洗,あらい、水,みずに身,みをすすがなければならない。彼,かれは夕,ゆうまで汚,けがれるであろう。","tok":[["また"],["彼","かれ"],["の"],["下","した"],["に"],["なった"],["物","もの"],["に"],["触れる","ふれる"],["者","もの"],["は"],["、"],["すべて"],["夕","ゆう"],["まで"],["汚","け"],["がれる"],["で"],["あろう"],["。"],["また"],["それ"],["ら"],["の"],["物","もの"],["を"],["運こぶ","はこぶ"],["者","もの"],["は"],["、"],["その"],["衣服","いふく"],["を"],["洗","あらい"],["、"],["水","みず"],["に"],["身","み"],["を"],["すすがなければ"],["ならない"],["。"],["彼","かれ"],["は"],["夕","ゆう"],["まで"],["汚","け"],["がれる"],["で"],["あろう"],["。"]]},{"verse":11,"text":"流出,りゅうしゅつある者,ものが、水,みずで手,てを洗,あらわずに人,ひとに触,ふれるならば、その人,ひとは衣服,いふくを洗,あらい、水,みずに身,みをすすがなければならない。彼,かれは夕,ゆうまで汚,けがれるであろう。","tok":[["流出","りゅうしゅつ"],["ある"],["者","もの"],["が"],["、"],["水","みず"],["で"],["手","て"],["を"],["洗わず","あらわず"],["に"],["人","ひと"],["に"],["触れるならば","ふれるならば"],["、"],["その"],["人","ひと"],["は"],["衣服","いふく"],["を"],["洗","あらい"],["、"],["水","みず"],["に"],["身","み"],["を"],["すすがなければ"],["ならない"],["。"],["彼","かれ"],["は"],["夕","ゆう"],["まで"],["汚","け"],["がれる"],["で"],["あろう"],["。"]]},{"verse":12,"text":"流出,りゅうしゅつある者,ものが触,ふれた土,つちの器,うつわは砕,くだかなければならない。木,きの器,うつわはすべて水,みずで洗,あらわなければならない。","tok":[["流出","りゅうしゅつ"],["ある"],["者","もの"],["が"],["触","ふれ"],["た"],["土","つち"],["の"],["器","うつわ"],["は"],["砕かなければ","くだかなければ"],["ならない"],["。"],["木","き"],["の"],["器","うつわ"],["は"],["すべて"],["水","みず"],["で"],["洗わなければ","あらわなければ"],["ならない"],["。"]]},{"verse":13,"text":"流出,りゅうしゅつある者,ものの流出,りゅうしゅつがやんで清,きよくなるならば、清,きよめのために七日,なぬかを数,かぞえ、その衣服,いふくを洗,あらい、流,ながれ水,みずに身,みをすすがなければならない。そうして清,きよくなるであろう。","tok":[["流出","りゅうしゅつ"],["ある"],["者","もの"],["の"],["流出","りゅうしゅつ"],["が"],["やんで"],["清く","きよく"],["なるならば"],["、"],["清め","きよめ"],["の"],["ため"],["に"],["七","しち"],["日","にち"],["を"],["数え","かぞえ"],["、"],["その"],["衣服","いふく"],["を"],["洗","あらい"],["、"],["流れ水","ながれみず"],["に"],["身","み"],["を"],["すすがなければ"],["ならない"],["。"],["そう"],["して"],["清く","きよく"],["なるで"],["あろう"],["。"]]},{"verse":14,"text":"八日,か目,めに、山,やまばと二羽,わ、または家,いえばとのひな二羽,わを取,とって、会見,かいけんの幕屋,まくやの入口,いりぐちに行,いき、主,しゅの前,まえに出,でて、それを祭司,さいしに渡,わたさなければならない。","tok":[["八日目","かめ"],["に"],["、"],["山ばと","やまばと"],["二羽","わ"],["、"],["また"],["は"],["家ばと","いえばと"],["の"],["ひな"],["二羽","わ"],["を"],["取って","とって"],["、"],["会見","かいけん"],["の"],["幕屋","まくや"],["の"],["入口","いりぐち"],["に"],["行き","いき"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["出て","でて"],["、"],["それ"],["を"],["祭司","さいし"],["に"],["渡さなければ","わたさなければ"],["ならない"],["。"]]},{"verse":15,"text":"祭司,さいしはその一つを罪祭,ざいさいとし、他,たの一つを燔祭,はんさいとしてささげなければならない。こうして祭司,さいしはその人,ひとのため、その流出,りゅうしゅつのために主,しゅの前,まえに、あがないをするであろう。","tok":[["祭司","さいし"],["は"],["その"],["一","ひと"],["つ"],["を"],["罪","つみ"],["祭","まつり"],["い"],["さい"],["と"],["し"],["、"],["他","た"],["の"],["一","ひと"],["つ"],["を"],["燔祭","はんさい"],["として"],["ささげなければ"],["ならない"],["。"],["こう"],["して"],["祭司","さいし"],["は"],["その"],["人","ひと"],["の"],["ため"],["、"],["その"],["流出","りゅうしゅつ"],["の"],["ため"],["に"],["主","しゅ"],["の"],["前","まえ"],["に"],["、"],["あがない"],["を"],["するで"],["あろう"],["。"]]},{"verse":16,"text":"人,ひとがもし精,せいを漏,もらすことがあれば、その全身,ぜんしんを水,みずにすすがなければならない。彼,かれは夕,ゆうまで汚,けがれるであろう。","tok":[["人","ひと"],["が"],["もし"],["精","せい"],["を"],["漏らす","もらす"],["こと"],["が"],["あれば"],["、"],["その"],["全身","ぜんしん"],["を"],["水","みず"],["に"],["すすがなければ"],["ならない"],["。"],["彼","かれ"],["は"],["夕","ゆう"],["まで"],["汚","け"],["がれる"],["で"],["あろう"],["。"]]},{"verse":17,"text":"すべて精,せいのついた衣服,いふくおよび皮,かわで作,つくった物,ものは水,みずで洗,あらわなければならない。これは夕,ゆうまで汚,けがれるであろう。","tok":[["すべて"],["精","せい"],["の"],["ついた"],["衣服","いふく"],["および"],["皮","かわ"],["で"],["作った","つくった"],["物","もの"],["は"],["水","みず"],["で"],["洗わなければ","あらわなければ"],["ならない"],["。"],["これ"],["は"],["夕","ゆう"],["まで"],["汚","け"],["がれる"],["で"],["あろう"],["。"]]},{"verse":18,"text":"男,おとこがもし女,おんなと寝,ねて精,せいを漏,もらすことがあれば、彼,かれらは共,ともに水,みずに身,みをすすがなければならない。彼,かれらは夕,ゆうまで汚,けがれるであろう。","tok":[["男","おとこ"],["が"],["もし"],["女","おんな"],["と"],["寝て","ねて"],["精","せい"],["を"],["漏らす","もらす"],["こと"],["が"],["あれば"],["、"],["彼","かれ"],["ら"],["は"],["共","とも"],["に"],["水","みず"],["に"],["身","み"],["を"],["すすがなければ"],["ならない"],["。"],["彼","かれ"],["ら"],["は"],["夕","ゆう"],["まで"],["汚","け"],["がれる"],["で"],["あろう"],["。"]]},{"verse":19,"text":"また女,おんなに流出,りゅうしゅつがあって、その身,みの流出,りゅうしゅつがもし血,ちであるならば、その女,おんなは七日,なぬかのあいだ不浄,ふじょうである。すべてその女,おんなに触,ふれる者,ものは夕,ゆうまで汚,けがれるであろう。","tok":[["また"],["女","おんな"],["に"],["流出","りゅうしゅつ"],["が"],["あって"],["、"],["その"],["身","み"],["の"],["流出","りゅうしゅつ"],["が"],["もし"],["血","ち"],["で"],["あるならば"],["、"],["その"],["女","おんな"],["は"],["七日","なぬか"],["の"],["あいだ"],["不浄","ふじょう"],["で"],["ある"],["。"],["すべて"],["その"],["女","おんな"],["に"],["触れる","ふれる"],["者","もの"],["は"],["夕","ゆう"],["まで"],["汚","け"],["がれる"],["で"],["あろう"],["。"]]},{"verse":20,"text":"その不浄,ふじょうの間,あいだに、その女,おんなの寝,ねた物,ものはすべて汚,けがれる。またその女,おんなのすわった物,ものも、すべて汚,けがれるであろう。","tok":[["その"],["不浄","ふじょう"],["の"],["間","あいだ"],["に"],["、"],["その"],["女","おんな"],["の"],["寝た","ねた"],["物","もの"],["は"],["すべて"],["汚","け"],["がれる"],["。"],["また"],["その"],["女","おんな"],["の"],["すわった"],["物","もの"],["も"],["、"],["すべて"],["汚","け"],["がれる"],["で"],["あろう"],["。"]]},{"verse":21,"text":"すべてその女,おんなの床,とこに触,ふれる者,ものは、その衣服,いふくを洗,あらい、水,みずに身,みをすすがなければならない。彼,かれは夕,ゆうまで汚,けがれるであろう。","tok":[["すべて"],["その"],["女","おんな"],["の"],["床","とこ"],["に"],["触れる","ふれる"],["者","もの"],["は"],["、"],["その"],["衣服","いふく"],["を"],["洗","あらい"],["、"],["水","みず"],["に"],["身","み"],["を"],["すすがなければ"],["ならない"],["。"],["彼","かれ"],["は"],["夕","ゆう"],["まで"],["汚","け"],["がれる"],["で"],["あろう"],["。"]]},{"verse":22,"text":"すべてその女,おんなのすわった物,ものに触,ふれる者,ものは皆,みなその衣服,いふくを洗,あらい、水,みずに身,みをすすがなければならない。彼,かれは夕,ゆうまで汚,けがれるであろう。","tok":[["すべて"],["その"],["女","おんな"],["の"],["すわった"],["物","もの"],["に"],["触れる","ふれる"],["者","もの"],["は"],["皆","みな"],["その"],["衣服","いふく"],["を"],["洗","あらい"],["、"],["水","みず"],["に"],["身","み"],["を"],["すすがなければ"],["ならない"],["。"],["彼","かれ"],["は"],["夕","ゆう"],["まで"],["汚","け"],["がれる"],["で"],["あろう"],["。"]]},{"verse":23,"text":"またその女,おんなが床,とこの上,うえ、またはすわる物,ものの上,うえにおる時,とき、それに触,ふれるならば、その人,ひとは夕,ゆうまで汚,けがれるであろう。","tok":[["また"],["その"],["女","おんな"],["が"],["床","とこ"],["の"],["上","うえ"],["、"],["また"],["は"],["すわる"],["物","もの"],["の"],["上","うえ"],["に"],["おる"],["時","とき"],["、"],["それ"],["に"],["触れるならば","ふれるならば"],["、"],["その"],["人","ひと"],["は"],["夕","ゆう"],["まで"],["汚","け"],["がれる"],["で"],["あろう"],["。"]]},{"verse":24,"text":"男,おとこがもし、その女,おんなと寝,ねて、その不浄,ふじょうを身,みにうけるならば、彼,かれは七日,なぬかのあいだ汚,けがれるであろう。また彼,かれの寝,ねた床,とこはすべて汚,けがれるであろう。","tok":[["男","おとこ"],["が"],["もし"],["、"],["その"],["女","おんな"],["と"],["寝て","ねて"],["、"],["その"],["不浄","ふじょう"],["を"],["身","み"],["に"],["うけるならば"],["、"],["彼","かれ"],["は"],["七日","なぬか"],["の"],["あいだ"],["汚","け"],["がれる"],["で"],["あろう"],["。"],["また"],["彼","かれ"],["の"],["寝た","ねた"],["床","とこ"],["は"],["すべて"],["汚","け"],["がれる"],["で"],["あろう"],["。"]]},{"verse":25,"text":"女,おんなにもし、その不浄,ふじょうの時,ときのほかに、多,おおくの日,ひにわたって血,ちの流出,りゅうしゅつがあるか、あるいはその不浄,ふじょうの時,ときを越,こして流出,りゅうしゅつがあれば、その汚,けがれの流出,りゅうしゅつの日,ひの間,あいだは、すべてその不浄,ふじょうの時,ときと同,おなじように、その女,おんなは汚,けがれた者,ものである。","tok":[["女","おんな"],["に"],["もし"],["、"],["その"],["不浄","ふじょう"],["の"],["時","とき"],["の"],["ほか"],["に"],["、"],["多く","おおく"],["の"],["日","ひ"],["に"],["わたって"],["血","ち"],["の"],["流出","りゅうしゅつ"],["が"],["ある"],["か"],["、"],["あるいは"],["その"],["不浄","ふじょう"],["の"],["時","とき"],["を"],["越","こし"],["て"],["流出","りゅうしゅつ"],["が"],["あれば"],["、"],["その"],["汚","けがれ"],["の"],["流出","りゅうしゅつ"],["の"],["日","ひ"],["の"],["間","あいだ"],["は"],["、"],["すべて"],["その"],["不浄","ふじょう"],["の"],["時","とき"],["と"],["同じ","おなじ"],["よう"],["に"],["、"],["その"],["女","おんな"],["は"],["汚","け"],["がれ"],["た"],["者","もの"],["で"],["ある"],["。"]]},{"verse":26,"text":"その流出,りゅうしゅつの日,ひの間,あいだに、その女,おんなの寝,ねた床,とこは、すべてその女,おんなの不浄,ふじょうの時,ときの床,とこと同,おなじようになる。すべてその女,おんなのすわった物,ものは、不浄,ふじょうの汚,けがれのように汚,けがれるであろう。","tok":[["その"],["流出","りゅうしゅつ"],["の"],["日","ひ"],["の"],["間","あいだ"],["に"],["、"],["その"],["女","おんな"],["の"],["寝た","ねた"],["床","とこ"],["は"],["、"],["すべて"],["その"],["女","おんな"],["の"],["不浄","ふじょう"],["の"],["時","とき"],["の"],["床","とこ"],["と"],["同じ","おなじ"],["よう"],["に"],["なる"],["。"],["すべて"],["その"],["女","おんな"],["の"],["すわった"],["物","もの"],["は"],["、"],["不浄","ふじょう"],["の"],["汚","けがれ"],["の"],["よう"],["に"],["汚","け"],["がれる"],["で"],["あろう"],["。"]]},{"verse":27,"text":"すべてこれらの物,ものに触,ふれる人,ひとは汚,けがれる。その衣服,いふくを洗,あらい、水,みずに身,みをすすがなければならない。彼,かれは夕,ゆうまで汚,けがれるであろう。","tok":[["すべて"],["これ"],["ら"],["の"],["物","もの"],["に"],["触れる","ふれる"],["人","ひと"],["は"],["汚","け"],["がれる"],["。"],["その"],["衣服","いふく"],["を"],["洗","あらい"],["、"],["水","みず"],["に"],["身","み"],["を"],["すすがなければ"],["ならない"],["。"],["彼","かれ"],["は"],["夕","ゆう"],["まで"],["汚","け"],["がれる"],["で"],["あろう"],["。"]]},{"verse":28,"text":"しかし、その女,おんなの流出,りゅうしゅつがやんで、清,きよくなるならば、自分,じぶんのために、なお七日,なぬかを数,かぞえなければならない。そして後,のち、清,きよくなるであろう。","tok":[["しかし"],["、"],["その"],["女","おんな"],["の"],["流出","りゅうしゅつ"],["が"],["やんで"],["、"],["清く","きよく"],["なるならば"],["、"],["自分","じぶん"],["の"],["ため"],["に"],["、"],["なお"],["七","なな"],["日","にち"],["を"],["数えなければ","かぞえなければ"],["ならない"],["。"],["そして"],["後","の"],["ち"],["、"],["清く","きよく"],["なるで"],["あろう"],["。"]]},{"verse":29,"text":"その女,おんなは八日,か目,めに山,やまばと二羽,わ、または家,いえばとのひな二羽,わを自分,じぶんのために取,とり、それを会見,かいけんの幕屋,まくやの入口,いりぐちにおる祭司,さいしのもとに携,たずさえて行,いかなければならない。","tok":[["その"],["女","おんな"],["は"],["八日目","かめ"],["に"],["山ばと","やまばと"],["二羽","わ"],["、"],["また"],["は"],["家ばと","いえばと"],["の"],["ひな"],["二羽","わ"],["を"],["自分","じぶん"],["の"],["ため"],["に"],["取","とり"],["、"],["それ"],["を"],["会見","かいけん"],["の"],["幕屋","まくや"],["の"],["入口","いりぐち"],["に"],["おる"],["祭司","さいし"],["の"],["もと"],["に"],["携えて","たずさえて"],["行かなければ","いかなければ"],["ならない"],["。"]]},{"verse":30,"text":"祭司,さいしはその一つを罪祭,ざいさいとし、他,たの一つを燔祭,はんさいとしてささげなければならない。こうして祭司,さいしはその女,おんなのため、その汚,けがれの流出,りゅうしゅつのために主,しゅの前,まえに、あがないをするであろう。","tok":[["祭司","さいし"],["は"],["その"],["一","ひと"],["つ"],["を"],["罪","つみ"],["祭","まつり"],["い"],["さい"],["と"],["し"],["、"],["他","た"],["の"],["一","ひと"],["つ"],["を"],["燔祭","はんさい"],["として"],["ささげなければ"],["ならない"],["。"],["こう"],["して"],["祭司","さいし"],["は"],["その"],["女","おんな"],["の"],["ため"],["、"],["その"],["汚","けがれ"],["の"],["流出","りゅうしゅつ"],["の"],["ため"],["に"],["主","しゅ"],["の"],["前","まえ"],["に"],["、"],["あがない"],["を"],["するで"],["あろう"],["。"]]},{"verse":31,"text":"このようにしてあなたがたは、イスラエルの人々,ひとびとを汚,けがれから離,はなさなければならない。これは彼,かれらのうちにあるわたしの幕屋,まくやを彼,かれらが汚,けがし、その汚,けがれのために死,しぬことのないためである』」。","tok":[["この"],["よう"],["に"],["して"],["あなた"],["がた"],["は"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["を"],["汚","けがれか"],["ら"],["離さなければ","はなさなければ"],["ならない"],["。"],["これ"],["は"],["彼","かれ"],["ら"],["の"],["うち"],["に"],["ある"],["わたし"],["の"],["幕屋","まくや"],["を"],["彼","かれ"],["ら"],["が"],["汚","け"],["がし"],["、"],["その"],["汚","けがれ"],["の"],["ため"],["に"],["死ぬ","しぬ"],["こと"],["の"],["ない"],["ため"],["で"],["ある"],["』"],["」"],["。"]]},{"verse":32,"text":"これは流出,りゅうしゅつある者,もの、精,せいを漏,もらして汚,けがれる者,もの、","tok":[["これ"],["は"],["流出","りゅうしゅつ"],["ある"],["者","もの"],["、"],["精","せい"],["を"],["漏らして","もらして"],["汚","け"],["がれる"],["者","もの"],["、"]]},{"verse":33,"text":"不浄,ふじょうをわずらう女,おんな、ならびに男,おとこあるいは女,おんなの流出,りゅうしゅつある者,もの、および不浄,ふじょうの女,おんなと寝,ねる者,ものに関,かんするおきてである。","tok":[["不浄","ふじょう"],["を"],["わずらう"],["女","おんな"],["、"],["ならびに"],["男","おとこ"],["あるいは"],["女","おんな"],["の"],["流出","りゅうしゅつ"],["ある"],["者","もの"],["、"],["および"],["不浄","ふじょう"],["の"],["女","おんな"],["と"],["寝る","ねる"],["者","もの"],["に"],["関する","かんする"],["おきて"],["で"],["ある"],["。"]]}]
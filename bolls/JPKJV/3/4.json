[{"verse":1,"text":"主,しゅはまたモーセに言,いわれた、","tok":[["主","しゅ"],["は"],["また"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":2,"text":"「イスラエルの人々,ひとびとに言,いいなさい、『もし人,ひとがあやまって罪,つみを犯,おかし、主,しゅのいましめにそむいて、してはならないことの一つをした時,ときは次,つぎのようにしなければならない。","tok":[["「"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["言い","いい"],["なさい"],["、"],["『"],["もし"],["人","ひと"],["が"],["あやまって"],["罪","つみ"],["を"],["犯し","おかし"],["、"],["主","しゅ"],["の"],["いましめ"],["に"],["そむいて"],["、"],["して"],["は"],["ならない"],["こと"],["の"],["一","ひと"],["つ"],["を"],["した"],["時","とき"],["は"],["次","つぎ"],["の"],["よう"],["に"],["しなければ"],["ならない"],["。"]]},{"verse":3,"text":"すなわち、油,あぶら注,そそがれた祭司,さいしが罪,つみを犯,おかして、とがを民,たみに及,およぼすならば、彼,かれはその犯,おかした罪,つみのために雄,おすの全,まったき子,こ牛,うしを罪祭,ざいさいとして主,しゅにささげなければならない。","tok":[["すなわち"],["、"],["油","あぶら"],["注がれた","そそがれた"],["祭司","さいし"],["が"],["罪","つみ"],["を"],["犯して","おかして"],["、"],["とが"],["を"],["民","たみ"],["に"],["及ぼすならば","およぼすならば"],["、"],["彼","かれ"],["は"],["その"],["犯した","おかした"],["罪","つみ"],["の"],["ため"],["に"],["雄","おす"],["の"],["全","ま"],["っ"],["たき"],["子牛","こうし"],["を"],["罪","つみ"],["祭","まつり"],["として"],["主に","しゅに"],["ささげなければ"],["ならない"],["。"]]},{"verse":4,"text":"その子,こ牛,うしを会見,かいけんの幕屋,まくやの入口,いりぐちに連,つれてきて主,しゅの前,まえに至,いたり、その子,こ牛,うしの頭,あたまに手,てを置,おき、その子,こ牛,うしを主,しゅの前,まえで、ほふらなければならない。","tok":[["その"],["子牛","こうし"],["を"],["会見","かいけん"],["の"],["幕屋","まくや"],["の"],["入口","いりぐち"],["に"],["連れて","つれて"],["きて"],["主","しゅ"],["の"],["前","まえ"],["に"],["至","いたり"],["、"],["その"],["子牛","こうし"],["の"],["頭","あたま"],["に"],["手","て"],["を"],["置き","おき"],["、"],["その"],["子牛","こうし"],["を"],["主","しゅ"],["の"],["前","まえ"],["で"],["、"],["ほふらなければ"],["ならない"],["。"]]},{"verse":5,"text":"油,あぶら注,そそがれた祭司,さいしは、その子,こ牛,うしの血,ちを取,とって、それを会見,かいけんの幕屋,まくやに携,たずさえ入,いり、","tok":[["油","あぶら"],["注がれた","そそがれた"],["祭司","さいし"],["は"],["、"],["その"],["子牛","こうし"],["の"],["血","ち"],["を"],["取って","とって"],["、"],["それ"],["を"],["会見","かいけん"],["の"],["幕屋","まくや"],["に"],["携え","たずさえ"],["入","いり"],["、"]]},{"verse":6,"text":"そして祭司,さいしは指,ゆびをその血,ちに浸,ひたして、聖所,せいじょの垂幕,たれまくの前,まえで主,しゅの前,まえにその血,ちを七たび注,そそがなければならない。","tok":[["そして"],["祭司","さいし"],["は"],["指","ゆび"],["を"],["その"],["血","ち"],["に"],["浸して","ひたして"],["、"],["聖","せい"],["所","しょ"],["の"],["垂幕","たれまく"],["の"],["前","まえ"],["で"],["主","しゅ"],["の"],["前","まえ"],["に"],["その"],["血","ち"],["を"],["七","なな"],["たび"],["注がなければ","そそがなければ"],["ならない"],["。"]]},{"verse":7,"text":"祭司,さいしはまたその血,ちを取,とり、主,しゅの前,まえで会見,かいけんの幕屋,まくやの中,なかにある香,こうばしい薫香,くんこうの祭壇,さいだんの角,つのに、それを塗,ぬらなければならない。その子,こ牛,うしの血,ちの残,のこりはことごとく会見,かいけんの幕屋,まくやの入口,いりぐちにある燔祭,はんさいの祭壇,さいだんのもとに注,そそがなければならない。","tok":[["祭司","さいし"],["は"],["また"],["その"],["血","ち"],["を"],["取","とり"],["、"],["主","しゅ"],["の"],["前","まえ"],["で"],["会見","かいけん"],["の"],["幕屋","まくや"],["の"],["中","なか"],["に"],["ある"],["香ばしい","こうばしい"],["薫香","くんこう"],["の"],["祭壇","さいだん"],["の"],["角","つ"],["のに"],["、"],["それ"],["を"],["塗らなければ","ぬらなければ"],["ならない"],["。"],["その"],["子牛","こうし"],["の"],["血","ち"],["の"],["残り","のこり"],["は"],["ことごとく"],["会見","かいけん"],["の"],["幕屋","まくや"],["の"],["入口","いりぐち"],["に"],["ある"],["燔祭","はんさい"],["の"],["祭壇","さいだん"],["の"],["もと"],["に"],["注がなければ","そそがなければ"],["ならない"],["。"]]},{"verse":8,"text":"またその罪祭,ざいさいの子,こ牛,うしから、すべての脂肪,しぼうを取,とらなければならない。すなわち内臓,ないぞうをおおう脂肪,しぼうと内臓,ないぞうの上,うえのすべての脂肪,しぼう、","tok":[["また"],["その"],["罪","つみ"],["祭","まつり"],["の"],["子牛","こうし"],["から"],["、"],["すべて"],["の"],["脂肪","しぼう"],["を"],["取らなければ","とらなければ"],["ならない"],["。"],["すなわち"],["内臓","ないぞう"],["を"],["おおう"],["脂肪","しぼう"],["と"],["内臓","ないぞう"],["の"],["上","うえ"],["の"],["すべて"],["の"],["脂肪","しぼう"],["、"]]},{"verse":9,"text":"二つの腎臓,じんぞうとその上,うえの腰,こしのあたりにある脂肪,しぼう、ならびに腎臓,じんぞうと共,ともに取,とられる肝臓,かんぞうの上,うえの小葉,しょうようである。","tok":[["二","ふた"],["つ"],["の"],["腎臓","じんぞう"],["と"],["その"],["上","うえ"],["の"],["腰","こし"],["の"],["あたり"],["に"],["ある"],["脂肪","しぼう"],["、"],["ならびに"],["腎臓","じんぞう"],["と"],["共","とも"],["に"],["取られる","とられる"],["肝臓","かんぞう"],["の"],["上","うえ"],["の"],["小葉","しょうよう"],["で"],["ある"],["。"]]},{"verse":10,"text":"これを取,とるには酬恩祭,しゅうおんさいの犠牲,ぎせいの雄牛,おうしから取,とるのと同,おなじようにしなければならない。そして祭司,さいしはそれを燔祭,はんさいの祭壇,さいだんの上,うえで焼,やかなければならない。","tok":[["これ"],["を"],["取る","とる"],["に"],["は"],["酬恩祭","しゅうおんさい"],["の"],["犠牲","ぎせい"],["の"],["雄牛","おうし"],["から"],["取る","とる"],["の"],["と"],["同じ","おなじ"],["よう"],["に"],["しなければ"],["ならない"],["。"],["そして"],["祭司","さいし"],["は"],["それ"],["を"],["燔祭","はんさい"],["の"],["祭壇","さいだん"],["の"],["上","うえ"],["で"],["焼かなければ","やかなければ"],["ならない"],["。"]]},{"verse":11,"text":"その子,こ牛,うしの皮,かわとそのすべての肉,にく、およびその頭,あたまと足,あしと内臓,ないぞうと汚物,おぶつなど、","tok":[["その"],["子牛","こうし"],["の"],["皮","かわ"],["と"],["その"],["すべて"],["の"],["肉","にく"],["、"],["および"],["その"],["頭","あたま"],["と"],["足","あし"],["と"],["内臓","ないぞう"],["と"],["汚物","おぶつ"],["など"],["、"]]},{"verse":12,"text":"すべてその子,こ牛,うしの残,のこりは、これを宿営,しゅくえいの外,そとの、清,きよい場所,ばしょなる灰,はい捨,すて場,ばに携,たずさえ出,だし、火,ひをもってこれをたきぎの上,うえで焼,やき捨,すてなければならない。すなわちこれは灰,はい捨,すて場,ばで焼,やき捨,すてらるべきである。","tok":[["すべて"],["その"],["子牛","こうし"],["の"],["残り","のこり"],["は"],["、"],["これ"],["を"],["宿営","しゅくえい"],["の"],["外","そと"],["の"],["、"],["清い","きよい"],["場所","ばしょ"],["なる"],["灰","はい"],["捨て場","すてば"],["に"],["携え","たずさえ"],["出し","だし"],["、"],["火","ひ"],["を"],["もって"],["これ"],["を"],["たきぎ"],["の"],["上","うえ"],["で"],["焼き捨てなければ","やきすてなければ"],["ならない"],["。"],["すなわち"],["これ"],["は"],["灰","はい"],["捨て場","すてば"],["で"],["焼き捨てらるべきで","やきすてらるべきで"],["ある"],["。"]]},{"verse":13,"text":"もしイスラエルの全,ぜん会衆,かいしゅうがあやまちを犯,おかし、そのことが会衆,かいしゅうの目,めに隠,かくれていても、主,しゅのいましめにそむいて、してはならないことの一つをなして、とがを得,えたならば、","tok":[["もし"],["イスラエル"],["の"],["全","ぜん"],["会衆","かいしゅう"],["が"],["あやまち"],["を"],["犯し","おかし"],["、"],["その"],["こと"],["が"],["会衆","かいしゅう"],["の"],["目","め"],["に"],["隠れて","かくれて"],["いて"],["も"],["、"],["主","しゅ"],["の"],["いましめ"],["に"],["そむいて"],["、"],["して"],["は"],["ならない"],["こと"],["の"],["一","ひと"],["つ"],["を"],["なして"],["、"],["とが"],["を"],["得たならば","えたならば"],["、"]]},{"verse":14,"text":"その犯,おかした罪,つみが現,あらわれた時,とき、会衆,かいしゅうは雄,おすの子,こ牛,うしを罪祭,ざいさいとしてささげなければならない。すなわちそれを会見,かいけんの幕屋,まくやの前,まえに連,つれてきて、","tok":[["その"],["犯した","おかした"],["罪","つみ"],["が"],["現われた","あらわれた"],["時","とき"],["、"],["会衆","かいしゅう"],["は"],["雄","おす"],["の"],["子牛","こうし"],["を"],["罪","つみ"],["祭","まつり"],["として"],["ささげなければ"],["ならない"],["。"],["すなわち"],["それ"],["を"],["会見","かいけん"],["の"],["幕屋","まくや"],["の"],["前","まえ"],["に"],["連れて","つれて"],["きて"],["、"]]},{"verse":15,"text":"会衆,かいしゅうの長老,ちょうろうたちは、主,しゅの前,まえでその子,こ牛,うしの頭,あたまに手,てを置,おき、その子,こ牛,うしを主,しゅの前,まえで、ほふらなければならない。","tok":[["会衆","かいしゅう"],["の"],["長老","ちょうろう"],["たち"],["は"],["、"],["主","しゅ"],["の"],["前","まえ"],["で"],["その"],["子牛","こうし"],["の"],["頭","あたま"],["に"],["手","て"],["を"],["置き","おき"],["、"],["その"],["子牛","こうし"],["を"],["主","しゅ"],["の"],["前","まえ"],["で"],["、"],["ほふらなければ"],["ならない"],["。"]]},{"verse":16,"text":"そして、油,あぶら注,そそがれた祭司,さいしは、その子,こ牛,うしの血,ちを会見,かいけんの幕屋,まくやに携,たずさえ入,いり、","tok":[["そして"],["、"],["油","あぶら"],["注がれた","そそがれた"],["祭司","さいし"],["は"],["、"],["その"],["子牛","こうし"],["の"],["血","ち"],["を"],["会見","かいけん"],["の"],["幕屋","まくや"],["に"],["携え","たずさえ"],["入","いり"],["、"]]},{"verse":17,"text":"祭司,さいしは指,ゆびをその血,ちに浸,ひたし、垂幕,たれまくの前,まえで主,しゅの前,まえに七たび注,そそがなければならない。","tok":[["祭司","さいし"],["は"],["指","ゆび"],["を"],["その"],["血","ち"],["に"],["浸し","ひたし"],["、"],["垂幕","たれまく"],["の"],["前","まえ"],["で"],["主","しゅ"],["の"],["前","まえ"],["に"],["七","なな"],["たび"],["注がなければ","そそがなければ"],["ならない"],["。"]]},{"verse":18,"text":"またその血,ちを取,とって、会見,かいけんの幕屋,まくやの中,なかの主,しゅの前,まえにある祭壇,さいだんの角,つのに、それを塗,ぬらなければならない。その血,ちの残,のこりはことごとく会見,かいけんの幕屋,まくやの入口,いりぐちにある燔祭,はんさいの祭壇,さいだんのもとに注,そそがなければならない。","tok":[["また"],["その"],["血","ち"],["を"],["取って","とって"],["、"],["会見","かいけん"],["の"],["幕屋","まくや"],["の"],["中","なか"],["の"],["主","しゅ"],["の"],["前","まえ"],["に"],["ある"],["祭壇","さいだん"],["の"],["角","つ"],["のに"],["、"],["それ"],["を"],["塗らなければ","ぬらなければ"],["ならない"],["。"],["その"],["血","ち"],["の"],["残り","のこり"],["は"],["ことごとく"],["会見","かいけん"],["の"],["幕屋","まくや"],["の"],["入口","いりぐち"],["に"],["ある"],["燔祭","はんさい"],["の"],["祭壇","さいだん"],["の"],["もと"],["に"],["注がなければ","そそがなければ"],["ならない"],["。"]]},{"verse":19,"text":"またそのすべての脂肪,しぼうを取,とって祭壇,さいだんの上,うえで焼,やかなければならない。","tok":[["また"],["その"],["すべて"],["の"],["脂肪","しぼう"],["を"],["取って","とって"],["祭壇","さいだん"],["の"],["上","うえ"],["で"],["焼かなければ","やかなければ"],["ならない"],["。"]]},{"verse":20,"text":"すなわち祭司,さいしは罪祭,ざいさいの雄牛,おうしにしたように、この雄牛,おうしにも、しなければならない。こうして、祭司,さいしが彼,かれらのためにあがないをするならば、彼,かれらはゆるされるであろう。","tok":[["すなわち"],["祭司","さいし"],["は"],["罪","つみ"],["祭","まつり"],["の"],["雄牛","おうし"],["に"],["した"],["よう"],["に"],["、"],["この"],["雄牛","おうし"],["に"],["も"],["、"],["しなければ"],["ならない"],["。"],["こう"],["して"],["、"],["祭司","さいし"],["が"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["あがない"],["を"],["するならば"],["、"],["彼","かれ"],["ら"],["は"],["ゆるされるで"],["あろう"],["。"]]},{"verse":21,"text":"そして、彼,かれはその雄牛,おうしを宿営,しゅくえいの外,そとに携,たずさえ出,だし、はじめの雄牛,おうしを焼,やき捨,すてたように、これを焼,やき捨,すてなければならない。これは会衆,かいしゅうの罪祭,ざいさいである。","tok":[["そして"],["、"],["彼","かれ"],["は"],["その"],["雄牛","おうし"],["を"],["宿営","しゅくえい"],["の"],["外","そと"],["に"],["携え","たずさえ"],["出し","だし"],["、"],["はじめ"],["の"],["雄牛","おうし"],["を"],["焼き捨てた","やきすてた"],["よう"],["に"],["、"],["これ"],["を"],["焼き捨てなければ","やきすてなければ"],["ならない"],["。"],["これ"],["は"],["会衆","かいしゅう"],["の"],["罪","つみ"],["祭","まつり"],["い"],["さい"],["で"],["ある"],["。"]]},{"verse":22,"text":"またつかさたる者,ものが罪,つみを犯,おかし、あやまって、その神,かみ、主,しゅのいましめにそむき、してはならないことの一つをして、とがを得,え、","tok":[["また"],["つかさ"],["たる"],["者","もの"],["が"],["罪","つみ"],["を"],["犯し","おかし"],["、"],["あやまって"],["、"],["その"],["神","かみ"],["、"],["主","しゅ"],["の"],["いましめ"],["に"],["そむき"],["、"],["して"],["は"],["ならない"],["こと"],["の"],["一","ひと"],["つ"],["を"],["して"],["、"],["とが"],["を"],["得","え"],["、"]]},{"verse":23,"text":"もしその犯,おかした罪,つみを知,しるようになったときは、供,そなえ物,ものとして雄,おやぎの全,まったきものを連,つれてきて、","tok":[["もし"],["その"],["犯した","おかした"],["罪","つみ"],["を"],["知る","しる"],["よう"],["に"],["なった"],["とき"],["は"],["、"],["供え物","そなえもの"],["として"],["雄","おやぎ"],["の"],["全","まったきも"],["の"],["を"],["連れて","つれて"],["きて"],["、"]]},{"verse":24,"text":"そのやぎの頭,あたまに手,てを置,おき、燔祭,はんさいをほふる場所,ばしょで、主,しゅの前,まえにこれをほふらなければならない。これは罪祭,ざいさいである。","tok":[["その"],["やぎ"],["の"],["頭","あたま"],["に"],["手","て"],["を"],["置き","おき"],["、"],["燔祭","はんさい"],["を"],["ほふる"],["場所","ばしょ"],["で"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["これ"],["を"],["ほふらなければ"],["ならない"],["。"],["これ"],["は"],["罪","つみ"],["祭","まつり"],["い"],["さい"],["で"],["ある"],["。"]]},{"verse":25,"text":"祭司,さいしは指,ゆびでその罪祭,ざいさいの血,ちを取,とり、燔祭,はんさいの祭壇,さいだんの角,つのにそれを塗,ぬり、残,のこりの血,ちは燔祭,はんさいの祭壇,さいだんのもとに注,そそがなければならない。","tok":[["祭司","さいし"],["は"],["指","ゆび"],["で"],["その"],["罪","つみ"],["祭","まつり"],["の"],["血","ち"],["を"],["取","とり"],["、"],["燔祭","はんさい"],["の"],["祭壇","さいだん"],["の"],["角","つ"],["のに"],["それ"],["を"],["塗","ぬり"],["、"],["残り","のこり"],["の"],["血","ち"],["は"],["燔祭","はんさい"],["の"],["祭壇","さいだん"],["の"],["もと"],["に"],["注がなければ","そそがなければ"],["ならない"],["。"]]},{"verse":26,"text":"また、そのすべての脂肪,しぼうは、酬恩祭,しゅうおんさいの犠牲,ぎせいの脂肪,しぼうと同,おなじように、祭壇,さいだんの上,うえで焼,やかなければならない。こうして、祭司,さいしが彼,かれのためにその罪,つみのあがないをするならば、彼,かれはゆるされるであろう。","tok":[["また"],["、"],["その"],["すべて"],["の"],["脂肪","しぼう"],["は"],["、"],["酬恩祭","しゅうおんさい"],["の"],["犠牲","ぎせい"],["の"],["脂肪","しぼう"],["と"],["同じ","おなじ"],["よう"],["に"],["、"],["祭壇","さいだん"],["の"],["上","うえ"],["で"],["焼かなければ","やかなければ"],["ならない"],["。"],["こう"],["して"],["、"],["祭司","さいし"],["が"],["彼","かれ"],["の"],["ため"],["に"],["その"],["罪","つみ"],["の"],["あ"],["が"],["ない"],["を"],["するならば"],["、"],["彼","かれ"],["は"],["ゆるされるで"],["あろう"],["。"]]},{"verse":27,"text":"また一般,いっぱんの人,ひとがもしあやまって罪,つみを犯,おかし、主,しゅのいましめにそむいて、してはならないことの一つをして、とがを得,え、","tok":[["また"],["一般","いっぱん"],["の"],["人","ひと"],["が"],["もし"],["あやまって"],["罪","つみ"],["を"],["犯し","おかし"],["、"],["主","しゅ"],["の"],["いましめ"],["に"],["そむいて"],["、"],["して"],["は"],["ならない"],["こと"],["の"],["一","ひと"],["つ"],["を"],["して"],["、"],["とが"],["を"],["得","え"],["、"]]},{"verse":28,"text":"その犯,おかした罪,つみを知,しるようになったときは、その犯,おかした罪,つみのために供,そなえ物,ものとして雌,めやぎの全,まったきものを連,つれてきて、","tok":[["その"],["犯した","おかした"],["罪","つみ"],["を"],["知る","しる"],["よう"],["に"],["なった"],["とき"],["は"],["、"],["その"],["犯した","おかした"],["罪","つみ"],["の"],["ため"],["に"],["供え物","そなえもの"],["として"],["雌","めやぎ"],["の"],["全","まったきも"],["の"],["を"],["連れて","つれて"],["きて"],["、"]]},{"verse":29,"text":"その罪祭,ざいさいの頭,あたまに手,てを置,おき、燔祭,はんさいをほふる場所,ばしょで、その罪祭,ざいさいをほふらなければならない。","tok":[["その"],["罪","つみ"],["祭","まつり"],["の"],["頭","あたま"],["に"],["手","て"],["を"],["置き","おき"],["、"],["燔祭","はんさい"],["を"],["ほふる"],["場所","ばしょ"],["で"],["、"],["その"],["罪","つみ"],["祭","まつり"],["を"],["ほふらなければ"],["ならない"],["。"]]},{"verse":30,"text":"そして祭司,さいしは指,ゆびでその血,ちを取,とり、燔祭,はんさいの祭壇,さいだんの角,つのにこれを塗,ぬり、残,のこりの血,ちをことごとく祭壇,さいだんのもとに注,そそがなければならない。","tok":[["そして"],["祭司","さいし"],["は"],["指","ゆび"],["で"],["その"],["血","ち"],["を"],["取","とり"],["、"],["燔祭","はんさい"],["の"],["祭壇","さいだん"],["の"],["角","つ"],["のに"],["これ"],["を"],["塗","ぬり"],["、"],["残り","のこり"],["の"],["血","ち"],["を"],["ことごとく"],["祭壇","さいだん"],["の"],["もと"],["に"],["注がなければ","そそがなければ"],["ならない"],["。"]]},{"verse":31,"text":"またそのすべての脂肪,しぼうは酬恩祭,しゅうおんさいの犠牲,ぎせいから脂肪,しぼうを取,とるのと同,おなじように取,とり、これを祭壇,さいだんの上,うえで焼,やいて主,しゅにささげる香,こうばしいかおりとしなければならない。こうして祭司,さいしが彼,かれのためにあがないをするならば、彼,かれはゆるされるであろう。","tok":[["また"],["その"],["すべて"],["の"],["脂肪","しぼう"],["は"],["酬恩祭","しゅうおんさい"],["の"],["犠牲","ぎせい"],["から"],["脂肪","しぼう"],["を"],["取る","とる"],["の"],["と"],["同じ","おなじ"],["よう"],["に"],["取","とり"],["、"],["これ"],["を"],["祭壇","さいだん"],["の"],["上","うえ"],["で"],["焼いて","やいて"],["主に","しゅに"],["ささげる"],["香ばしい","こうばしい"],["かおり"],["と"],["しなければ"],["ならない"],["。"],["こう"],["して"],["祭司","さいし"],["が"],["彼","かれ"],["の"],["ため"],["に"],["あがない"],["を"],["するならば"],["、"],["彼","かれ"],["は"],["ゆるされるで"],["あろう"],["。"]]},{"verse":32,"text":"もし小羊,こひつじを罪祭,ざいさいのために供,そなえ物,ものとして連,つれてくるならば、雌,めすの全,まったきものを連,つれてこなければならない。","tok":[["もし"],["小羊","こひつじ"],["を"],["罪","つみ"],["祭","まつり"],["の"],["ため"],["に"],["供え物","そなえもの"],["として"],["連れて","つれて"],["くるならば"],["、"],["雌","めす"],["の"],["全","まったきも"],["の"],["を"],["連れて","つれて"],["こなければ"],["ならない"],["。"]]},{"verse":33,"text":"その罪祭,ざいさいの頭,あたまに手,てを置,おき、燔祭,はんさいをほふる場所,ばしょで、これをほふり、罪祭,ざいさいとしなければならない。","tok":[["その"],["罪","つみ"],["祭","まつり"],["の"],["頭","あたま"],["に"],["手","て"],["を"],["置き","おき"],["、"],["燔祭","はんさい"],["を"],["ほふる"],["場所","ばしょ"],["で"],["、"],["これ"],["を"],["ほふり"],["、"],["罪","つみ"],["祭","まつり"],["と"],["しなければ"],["ならない"],["。"]]},{"verse":34,"text":"そして祭司,さいしは指,ゆびでその罪祭,ざいさいの血,ちを取,とり、燔祭,はんさいの祭壇,さいだんの角,つのにそれを塗,ぬり、残,のこりの血,ちはことごとく祭壇,さいだんのもとに注,そそがなければならない。","tok":[["そして"],["祭司","さいし"],["は"],["指","ゆび"],["で"],["その"],["罪","つみ"],["祭","まつり"],["の"],["血","ち"],["を"],["取","とり"],["、"],["燔祭","はんさい"],["の"],["祭壇","さいだん"],["の"],["角","つ"],["のに"],["それ"],["を"],["塗","ぬり"],["、"],["残り","のこり"],["の"],["血","ち"],["は"],["ことごとく"],["祭壇","さいだん"],["の"],["もと"],["に"],["注がなければ","そそがなければ"],["ならない"],["。"]]},{"verse":35,"text":"またそのすべての脂肪,しぼうは酬恩祭,しゅうおんさいの犠牲,ぎせいから小羊,こひつじの脂肪,しぼうを取,とるのと同,おなじように取,とり、祭司,さいしはこれを主,しゅにささげる火祭,かさいのように祭壇,さいだんの上,うえで焼,やかなければならない。こうして祭司,さいしが彼,かれの犯,おかした罪,つみのためにあがないをするならば、彼,かれはゆるされるであろう。","tok":[["また"],["その"],["すべて"],["の"],["脂肪","しぼう"],["は"],["酬恩祭","しゅうおんさい"],["の"],["犠牲","ぎせい"],["から"],["小羊","こひつじ"],["の"],["脂肪","しぼう"],["を"],["取る","とる"],["の"],["と"],["同じ","おなじ"],["よう"],["に"],["取","とり"],["、"],["祭司","さいし"],["は"],["これ"],["を"],["主に","しゅに"],["ささげる"],["火祭","かさい"],["の"],["よう"],["に"],["祭壇","さいだん"],["の"],["上","うえ"],["で"],["焼かなければ","やかなければ"],["ならない"],["。"],["こう"],["して"],["祭司","さいし"],["が"],["彼","かれ"],["の"],["犯した","おかした"],["罪","つみ"],["の"],["ため"],["に"],["あがない"],["を"],["するならば"],["、"],["彼","かれ"],["は"],["ゆるされるで"],["あろう"],["。"]]}]
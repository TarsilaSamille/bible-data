[{"verse":1,"text":"主,しゅはまたモーセに言,いわれた、","tok":[["主","しゅ"],["は"],["また"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":2,"text":"「イスラエルの人々,ひとびとに言,いいなさい、『イスラエルの人々,ひとびとのうち、またイスラエルのうちに寄留,きりゅうする他国,たこく人,じんのうち、だれでもその子,こ供,ともをモレクにささげる者,ものは、必,かならず殺,ころされなければならない。すなわち、国,くにの民,たみは彼,かれを石,いしで撃,うたなければならない。","tok":[["「"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["言い","いい"],["なさい"],["、"],["『"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["うち"],["、"],["また"],["イスラエル"],["の"],["うち"],["に"],["寄留","きりゅう"],["する"],["他国人","たこくじん"],["の"],["うち"],["、"],["だれ"],["で"],["も"],["その"],["子供","ことも"],["を"],["モレク"],["に"],["ささげる"],["者","もの"],["は"],["、"],["必","かならず"],["殺ろされなければ","ころされなければ"],["ならない"],["。"],["すなわち"],["、"],["国","くに"],["の"],["民","たみ"],["は"],["彼","かれ"],["を"],["石","いし"],["で"],["撃たなければ","うたなければ"],["ならない"],["。"]]},{"verse":3,"text":"わたしは顔,かおをその人,ひとに向,むけ、彼,かれを民,たみのうちから断,たつであろう。彼,かれがその子,こ供,ともをモレクにささげてわたしの聖所,せいじょを汚,けがし、またわたしの聖,せいなる名,なを汚,けがしたからである。","tok":[["わたし"],["は"],["顔","かお"],["を"],["その"],["人","ひと"],["に"],["向け","むけ"],["、"],["彼","かれ"],["を"],["民","たみ"],["の"],["うち"],["から"],["断つで","たつで"],["あろう"],["。"],["彼","かれ"],["が"],["その"],["子供","ことも"],["を"],["モレク"],["に"],["ささげて"],["わたし"],["の"],["聖","せい"],["所","しょ"],["を"],["汚","け"],["がし"],["、"],["また"],["わたし"],["の"],["聖","せい"],["なる"],["名","な"],["を"],["汚","け"],["がした"],["から"],["で"],["ある"],["。"]]},{"verse":4,"text":"その人,ひとが子供,こどもをモレクにささげるとき、国,くにの民,たみがもしことさらに、この事,ことに目,めをおおい、これを殺,ころさないならば、","tok":[["その"],["人","ひと"],["が"],["子供","こども"],["を"],["モレク"],["に"],["ささげる"],["とき"],["、"],["国","くに"],["の"],["民","たみ"],["が"],["もし"],["こと"],["さらに"],["、"],["この"],["事","こと"],["に"],["目","め"],["を"],["おおい"],["、"],["これ"],["を"],["殺ろさないならば","ころさないならば"],["、"]]},{"verse":5,"text":"わたし自身,じしん、顔,かおをその人,ひととその家族,かぞくとに向,むけ、彼,かれおよび彼,かれに見,みならってモレクを慕,したい、これと姦淫,かんいんする者,ものを、すべて民,たみのうちから断,たつであろう。","tok":[["わたし"],["自身","じしん"],["、"],["顔","かお"],["を"],["その"],["人","ひと"],["と"],["その"],["家族","かぞく"],["と"],["に"],["向け","むけ"],["、"],["彼","かれ"],["および"],["彼","かれ"],["に"],["見ならって","みならって"],["モレク"],["を"],["慕い","したい"],["、"],["これ"],["と"],["姦淫","かんいん"],["する"],["者","もの"],["を"],["、"],["すべて民","すべてたみ"],["の"],["うち"],["から"],["断つで","たつで"],["あろう"],["。"]]},{"verse":6,"text":"もし口寄,くちよせ、または占,うらない師,しのもとにおもむき、彼,かれらを慕,したって姦淫,かんいんする者,ものがあれば、わたしは顔,かおをその人,ひとに向,むけ、これを民,たみのうちから断,たつであろう。","tok":[["もし"],["口寄","くちよせ"],["、"],["また"],["は"],["占師","うらないし"],["の"],["もと"],["に"],["おもむき"],["、"],["彼","かれ"],["ら"],["を"],["慕って","したって"],["姦淫","かんいん"],["する"],["者","もの"],["が"],["あれば"],["、"],["わたし"],["は"],["顔","かお"],["を"],["その"],["人","ひと"],["に"],["向け","むけ"],["、"],["これ"],["を"],["民","たみ"],["の"],["うち"],["から"],["断つで","たつで"],["あろう"],["。"]]},{"verse":7,"text":"ゆえにあなたがたは、みずからを聖別,せいべつし、聖,せいなる者,ものとならなければならない。わたしはあなたがたの神,かみ、主,しゅである。","tok":[["ゆえ"],["に"],["あなた"],["がた"],["は"],["、"],["みずから"],["を"],["聖別","せいべつ"],["し"],["、"],["聖","せい"],["なる"],["者","もの"],["と"],["ならなければ"],["ならない"],["。"],["わたし"],["は"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["で"],["ある"],["。"]]},{"verse":8,"text":"あなたがたはわたしの定,さだめを守,まもって、これを行,おこなわなければならない。わたしはあなたがたを聖別,せいべつする主,しゅである。","tok":[["あなた"],["がた"],["は"],["わたし"],["の"],["定め","さだめ"],["を"],["守って","まもって"],["、"],["これ"],["を"],["行なわなければ","おこなわなければ"],["ならない"],["。"],["わたし"],["は"],["あなた"],["がた"],["を"],["聖別","せいべつ"],["する"],["主","しゅ"],["で"],["ある"],["。"]]},{"verse":9,"text":"だれでも父,ちちまたは母,ははをのろう者,ものは、必,かならず殺,ころされなければならない。彼,かれが父,ちちまたは母,ははをのろったので、その血,ちは彼,かれに帰,きするであろう。","tok":[["だれ"],["で"],["も"],["父","ちち"],["また"],["は"],["母","はは"],["を"],["の"],["ろう者","ろうもの"],["は"],["、"],["必","かならず"],["殺ろされなければ","ころされなければ"],["ならない"],["。"],["彼","かれ"],["が"],["父","ちち"],["また"],["は"],["母","はは"],["を"],["のろった"],["ので"],["、"],["その"],["血","ち"],["は"],["彼","かれ"],["に"],["帰するで","きするで"],["あろう"],["。"]]},{"verse":10,"text":"人,ひとの妻,つまと姦淫,かんいんする者,もの、すなわち隣人,りんじんの妻,つまと姦淫,かんいんする者,ものがあれば、その姦夫,かんぷ、姦婦,かんぷは共,ともに必,かならず殺,ころされなければならない。","tok":[["人","ひと"],["の"],["妻","つま"],["と"],["姦淫","かんいん"],["する"],["者","もの"],["、"],["すなわち"],["隣人","りんじん"],["の"],["妻","つま"],["と"],["姦淫","かんいん"],["する"],["者","もの"],["が"],["あれば"],["、"],["その"],["姦夫","かんぷ"],["、"],["姦婦","かんぷ"],["は"],["共","とも"],["に"],["必","かならず"],["殺ろされなければ","ころされなければ"],["ならない"],["。"]]},{"verse":11,"text":"その父,ちちの妻,つまと寝,ねる者,ものは、その父,ちちをはずかしめる者,ものである。彼,かれらはふたりとも必,かならず殺,ころされなければならない。その血,ちは彼,かれらに帰,きするであろう。","tok":[["その"],["父","ちち"],["の"],["妻","つま"],["と"],["寝る","ねる"],["者","もの"],["は"],["、"],["その"],["父","ちち"],["を"],["はずかしめる"],["者","もの"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["ふたり"],["とも"],["必","かならず"],["殺ろされなければ","ころされなければ"],["ならない"],["。"],["その"],["血","ち"],["は"],["彼","かれ"],["ら"],["に"],["帰するで","きするで"],["あろう"],["。"]]},{"verse":12,"text":"子,この妻,つまと寝,ねる者,ものは、ふたり共,ともに必,かならず殺,ころされなければならない。彼,かれらは道,みちならぬことをしたので、その血,ちは彼,かれらに帰,きするであろう。","tok":[["子","こ"],["の"],["妻","つま"],["と"],["寝る","ねる"],["者","もの"],["は"],["、"],["ふたり"],["共","とも"],["に"],["必","かならず"],["殺ろされなければ","ころされなければ"],["ならない"],["。"],["彼","かれ"],["ら"],["は"],["道","みち"],["ならぬ"],["こと"],["を"],["した"],["ので"],["、"],["その"],["血","ち"],["は"],["彼","かれ"],["ら"],["に"],["帰するで","きするで"],["あろう"],["。"]]},{"verse":13,"text":"女,おんなと寝,ねるように男,おとこと寝,ねる者,ものは、ふたりとも憎,にくむべき事,ことをしたので、必,かならず殺,ころされなければならない。その血,ちは彼,かれらに帰,きするであろう。","tok":[["女","おんな"],["と"],["寝る","ねる"],["よう"],["に"],["男","おとこ"],["と"],["寝る","ねる"],["者","もの"],["は"],["、"],["ふたり"],["と"],["も"],["憎むべき","にくむべき"],["事","こと"],["を"],["した"],["ので"],["、"],["必","かならず"],["殺ろされなければ","ころされなければ"],["ならない"],["。"],["その"],["血","ち"],["は"],["彼","かれ"],["ら"],["に"],["帰するで","きするで"],["あろう"],["。"]]},{"verse":14,"text":"女,おんなをその母,ははと一緒,いっしょにめとるならば、これは悪事,あくじであって、彼,かれも、女,おんなたちも火,ひに焼,やかれなければならない。このような悪事,あくじをあなたがたのうちになくするためである。","tok":[["女","おんな"],["を"],["その"],["母","はは"],["と"],["一緒","いっしょ"],["に"],["めとるならば"],["、"],["これ"],["は"],["悪事","あくじ"],["で"],["あって"],["、"],["彼","かれ"],["も"],["、"],["女","おんな"],["たち"],["も"],["火","ひ"],["に"],["焼かれなければ","やかれなければ"],["ならない"],["。"],["この"],["よう"],["な"],["悪事","あくじ"],["を"],["あなた"],["がた"],["の"],["うち"],["に"],["なくする"],["ため"],["で"],["ある"],["。"]]},{"verse":15,"text":"男,おとこがもし、獣,けものと寝,ねるならば彼,かれは必,かならず殺,ころされなければならない。あなたがたはまた、その獣,けものを殺,ころさなければならない。","tok":[["男","おとこ"],["が"],["もし"],["、"],["獣","けもの"],["と"],["寝るならば","ねるならば"],["彼","かれ"],["は"],["必","かならず"],["殺ろされなければ","ころされなければ"],["ならない"],["。"],["あなた"],["がた"],["は"],["また"],["、"],["その"],["獣","けもの"],["を"],["殺ろさなければ","ころさなければ"],["ならない"],["。"]]},{"verse":16,"text":"女,おんながもし、獣,けものに近,ちかづいて、これと寝,ねるならば、あなたは、その女,おんなと獣,けものとを殺,ころさなければならない。彼,かれらは必,かならず殺,ころさるべきである。その血,ちは彼,かれらに帰,きするであろう。","tok":[["女","おんな"],["が"],["もし"],["、"],["獣","けもの"],["に"],["近づいて","ちかづいて"],["、"],["これ"],["と"],["寝るならば","ねるならば"],["、"],["あなた"],["は"],["、"],["その"],["女","おんな"],["と"],["獣","けもの"],["と"],["を"],["殺ろさなければ","ころさなければ"],["ならない"],["。"],["彼","かれ"],["ら"],["は"],["必殺","かならずころ"],["さるべきで"],["ある"],["。"],["その"],["血","ち"],["は"],["彼","かれ"],["ら"],["に"],["帰するで","きするで"],["あろう"],["。"]]},{"verse":17,"text":"人,ひとがもし、その姉妹,しまい、すなわち父,ちちの娘,むすめ、あるいは母,ははの娘,むすめに近,ちかづいて、その姉妹,しまいのはだを見,み、女,おんなはその兄弟,きょうだいのはだを見,みるならば、これは恥,はずべき事,ことである。彼,かれらは、その民,たみの人々,ひとびとの目,めの前,まえで、断,たたれなければならない。彼,かれは、その姉妹,しまいを犯,おかしたのであるから、その罪,つみを負,おわなければならない。","tok":[["人","ひと"],["が"],["もし"],["、"],["その"],["姉妹","しまい"],["、"],["すなわち"],["父","ちち"],["の"],["娘","むすめ"],["、"],["あるいは"],["母","はは"],["の"],["娘","むすめ"],["に"],["近づいて","ちかづいて"],["、"],["その"],["姉妹","しまい"],["の"],["はだ"],["を"],["見","み"],["、"],["女","おんな"],["は"],["その"],["兄弟","きょうだい"],["の"],["はだ"],["を"],["見るならば","みるならば"],["、"],["これ"],["は"],["恥ずべき","はずべき"],["事","こと"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["、"],["その"],["民","たみ"],["の"],["人々","ひとびと"],["の"],["目","め"],["の"],["前","まえ"],["で"],["、"],["断たれなければ","たたれなければ"],["ならない"],["。"],["彼","かれ"],["は"],["、"],["その"],["姉妹","しまい"],["を"],["犯した","おかした"],["ので"],["ある"],["から"],["、"],["その"],["罪","つみ"],["を"],["負わなければ","おわなければ"],["ならない"],["。"]]},{"verse":18,"text":"人,ひとがもし、月,つきのさわりのある女,おんなと寝,ねて、そのはだを現,あらわすならば、男,おとこは女,おんなの源,みなもとを現,あらわし、女,おんなは自分,じぶんの血,ちの源,みなもとを現,あらわしたのであるから、ふたり共,ともにその民,たみのうちから断,たたれなければならない。","tok":[["人","ひと"],["が"],["もし"],["、"],["月","つき"],["の"],["さわり"],["の"],["ある"],["女","おんな"],["と"],["寝て","ねて"],["、"],["その"],["はだ"],["を"],["現わすならば","あらわすならば"],["、"],["男","おとこ"],["は"],["女","おんな"],["の"],["源","みなもと"],["を"],["現わし","あらわし"],["、"],["女","おんな"],["は"],["自分","じぶん"],["の"],["血","ち"],["の"],["源","みなもと"],["を"],["現わした","あらわした"],["ので"],["ある"],["から"],["、"],["ふたり"],["共","とも"],["に"],["その"],["民","たみ"],["の"],["うち"],["から"],["断たれなければ","たたれなければ"],["ならない"],["。"]]},{"verse":19,"text":"あなたの母,ははの姉妹,しまい、またはあなたの父,ちちの姉妹,しまいを犯,おかしてはならない。これは、自分,じぶんの肉親,にくしんの者,ものを犯,おかすことであるから、彼,かれらはその罪,つみを負,おわなければならない。","tok":[["あなた"],["の"],["母","はは"],["の"],["姉妹","しまい"],["、"],["また"],["は"],["あなた"],["の"],["父","ちち"],["の"],["姉妹","しまい"],["を"],["犯して","おかして"],["は"],["ならない"],["。"],["これ"],["は"],["、"],["自分","じぶん"],["の"],["肉親","にくしん"],["の"],["者","もの"],["を"],["犯す","おかす"],["こと"],["で"],["ある"],["から"],["、"],["彼","かれ"],["ら"],["は"],["その"],["罪","つみ"],["を"],["負わなければ","おわなければ"],["ならない"],["。"]]},{"verse":20,"text":"人,ひとがもし、そのおばと寝,ねるならば、これはおじをはずかしめることであるから、彼,かれらはその罪,つみを負,おい、子,こなくして死,しぬであろう。","tok":[["人","ひと"],["が"],["もし"],["、"],["その"],["おば"],["と"],["寝るならば","ねるならば"],["、"],["これ"],["は"],["おじ"],["を"],["はずかしめる"],["こと"],["で"],["ある"],["から"],["、"],["彼","かれ"],["ら"],["は"],["その"],["罪","つみ"],["を"],["負い","おい"],["、"],["子","こ"],["なく"],["して"],["死ぬで","しぬで"],["あろう"],["。"]]},{"verse":21,"text":"人,ひとがもし、その兄弟,きょうだいの妻,つまを取,とるならば、これは汚,けがらわしいことである。彼,かれはその兄弟,きょうだいをはずかしめたのであるから、彼,かれらは子,こなき者,ものとなるであろう。","tok":[["人","ひと"],["が"],["もし"],["、"],["その"],["兄弟","きょうだい"],["の"],["妻","つま"],["を"],["取るならば","とるならば"],["、"],["これ"],["は"],["汚わしい","けがらわしい"],["こと"],["で"],["ある"],["。"],["彼","かれ"],["は"],["その"],["兄弟","きょうだい"],["を"],["はずかしめた"],["ので"],["ある"],["から"],["、"],["彼","かれ"],["ら"],["は"],["子","こ"],["なき"],["者","もの"],["と"],["なるで"],["あろう"],["。"]]},{"verse":22,"text":"あなたがたはわたしの定,さだめとおきてとをことごとく守,まもって、これを行,おこなわなければならない。そうすれば、わたしがあなたがたを住,すまわせようと導,みちびいて行,いく地,ちは、あなたがたを吐,はき出,ださぬであろう。","tok":[["あなた"],["がた"],["は"],["わたし"],["の"],["定め","さだめ"],["と"],["おきて"],["と"],["を"],["ことごとく"],["守って","まもって"],["、"],["これ"],["を"],["行なわなければ","おこなわなければ"],["ならない"],["。"],["そう"],["すれば"],["、"],["わたし"],["が"],["あなた"],["がた"],["を"],["住まわせよう","すまわせよう"],["と"],["導いて","みちびいて"],["行く","いく"],["地","ち"],["は"],["、"],["あなた"],["がた"],["を"],["吐出さぬで","はきださぬで"],["あろう"],["。"]]},{"verse":23,"text":"あなたがたの前,まえからわたしが追,おい払,はらう国,くにびとの風習,ふうしゅうに、あなたがたは歩,あゆんではならない。彼,かれらは、このもろもろのことをしたから、わたしは彼,かれらを憎,にくむのである。","tok":[["あなた"],["がた"],["の"],["前","まえ"],["から"],["わたし"],["が"],["追い払う","おいはらう"],["国びと","くにびと"],["の"],["風習","ふうしゅう"],["に"],["、"],["あなた"],["がた"],["は"],["歩","あゆん"],["で"],["は"],["ならない"],["。"],["彼","かれ"],["ら"],["は"],["、"],["この"],["もろもろ"],["の"],["こと"],["を"],["した"],["から"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["憎む","にくむ"],["ので"],["ある"],["。"]]},{"verse":24,"text":"わたしはあなたがたに言,いった、「あなたがたは、彼,かれらの地,ちを獲,えるであろう。わたしはこれをあなたがたに与,あたえて、これを獲,えさせるであろう。これは乳,ちちと蜜,みつとの流,ながれる地,ちである」。わたしはあなたがたを他,たの民,たみから区別,くべつしたあなたがたの神,かみ、主,しゅである。","tok":[["わたし"],["は"],["あなた"],["がた"],["に"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["、"],["彼","かれ"],["ら"],["の"],["地","ち"],["を"],["獲るで","えるで"],["あろう"],["。"],["わたし"],["は"],["これ"],["を"],["あなた"],["がた"],["に"],["与","あたえ"],["て"],["、"],["これ"],["を"],["獲させるで","えさせるで"],["あろう"],["。"],["これ"],["は"],["乳","ちち"],["と"],["蜜","みつ"],["と"],["の"],["流れる","ながれる"],["地","ち"],["で"],["ある"],["」"],["。"],["わたし"],["は"],["あなた"],["がた"],["を"],["他","た"],["の"],["民","たみ"],["から"],["区別","くべつ"],["した"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["で"],["ある"],["。"]]},{"verse":25,"text":"あなたがたは清,きよい獣,けものと汚,けがれた獣,けもの、汚,けがれた鳥,とりと清,きよい鳥,とりを区別,くべつしなければならない。わたしがあなたがたのために汚,けがれたものとして区別,くべつした獣,けもの、または鳥,とりまたはすべて地,ちを這,はうものによって、あなたがたの身,みを忌,いむべきものとしてはならない。","tok":[["あなた"],["がた"],["は"],["清い","きよい"],["獣","けもの"],["と"],["汚","け"],["がれ"],["た"],["獣","けもの"],["、"],["汚","け"],["がれ"],["た"],["鳥","とり"],["と"],["清い","きよい"],["鳥","とり"],["を"],["区別","くべつ"],["しなければ"],["ならない"],["。"],["わたし"],["が"],["あなた"],["がた"],["の"],["ため"],["に"],["汚","けがれたも"],["の"],["として"],["区別","くべつ"],["した"],["獣","けもの"],["、"],["また"],["は"],["鳥","とり"],["また"],["は"],["すべて"],["地","ち"],["を"],["這う","はう"],["もの"],["によって"],["、"],["あなた"],["がた"],["の"],["身","み"],["を"],["忌むべき","いむべき"],["もの"],["として"],["は"],["ならない"],["。"]]},{"verse":26,"text":"あなたがたはわたしに対,たいして聖,せいなる者,ものでなければならない。主,しゅなるわたしは聖,せいなる者,もので、あなたがたをわたしのものにしようと、他,たの民,たみから区別,くべつしたからである。","tok":[["あなた"],["がた"],["は"],["わたし"],["に対して","にたいして"],["聖","せい"],["なる"],["者","もの"],["で"],["なければ"],["ならない"],["。"],["主","しゅ"],["なる"],["わたし"],["は"],["聖","せい"],["なる"],["者","もの"],["で"],["、"],["あなた"],["がた"],["を"],["わたし"],["の"],["もの"],["に"],["しよう"],["と"],["、"],["他","た"],["の"],["民","たみ"],["から"],["区別","くべつ"],["した"],["から"],["で"],["ある"],["。"]]},{"verse":27,"text":"男,おとこまたは女,おんなで、口寄,くちよせ、または占,うらないをする者,ものは、必,かならず殺,ころされなければならない。すなわち、石,いしで撃,うち殺,ころさなければならない。その血,ちは彼,かれらに帰,きするであろう』」。","tok":[["男","おとこ"],["また"],["は"],["女","おんな"],["で"],["、"],["口寄","くちよせ"],["、"],["また"],["は"],["占","うらない"],["を"],["する"],["者","もの"],["は"],["、"],["必","かならず"],["殺ろされなければ","ころされなければ"],["ならない"],["。"],["すなわち"],["、"],["石","いし"],["で"],["撃ち","うち"],["殺ろさなければ","ころさなければ"],["ならない"],["。"],["その"],["血","ち"],["は"],["彼","かれ"],["ら"],["に"],["帰するで","きするで"],["あろう"],["』"],["」"],["。"]]}]
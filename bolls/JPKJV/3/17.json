[{"verse":1,"text":"主,しゅはまたモーセに言,いわれた、","tok":[["主","しゅ"],["は"],["また"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":2,"text":"「アロンとその子,こたち、およびイスラエルのすべての人々,ひとびとに言,いいなさい、『主,しゅが命,めいじられることはこれである。すなわち","tok":[["「"],["アロン"],["と"],["その"],["子","こ"],["たち"],["、"],["および"],["イスラエル"],["の"],["すべて"],["の"],["人々","ひとびと"],["に"],["言い","いい"],["なさい"],["、"],["『"],["主","しゅ"],["が"],["命じられる","めいじられる"],["こと"],["は"],["これ"],["で"],["ある"],["。"],["すなわち"]]},{"verse":3,"text":"イスラエルの家,いえのだれでも、牛,うし、羊,ひつじあるいは、やぎを宿営,しゅくえいの内,うちでほふり、または宿営,しゅくえいの外,そとでほふり、","tok":[["イスラエル"],["の"],["家","いえ"],["の"],["だれ"],["で"],["も"],["、"],["牛","うし"],["、"],["羊","ひつじ"],["あるいは"],["、"],["やぎ"],["を"],["宿営","しゅくえい"],["の"],["内","うち"],["で"],["ほふり"],["、"],["また"],["は"],["宿営","しゅくえい"],["の"],["外","そと"],["で"],["ほふり"],["、"]]},{"verse":4,"text":"それを会見,かいけんの幕屋,まくやの入口,いりぐちに携,たずさえてきて主,しゅの幕屋,まくやの前,まえで、供,そなえ物,ものとして主,しゅにささげないならば、その人,ひとは血,ちを流,ながした者,ものとみなされる。彼,かれは血,ちを流,ながしたゆえ、その民,たみのうちから断,たたれるであろう。","tok":[["それ"],["を"],["会見","かいけん"],["の"],["幕屋","まくや"],["の"],["入口","いりぐち"],["に"],["携えて","たずさえて"],["きて"],["主","しゅ"],["の"],["幕屋","まくや"],["の"],["前","まえ"],["で"],["、"],["供え物","そなえもの"],["として"],["主に","しゅに"],["ささげないならば"],["、"],["その"],["人","ひと"],["は"],["血","ち"],["を"],["流した","ながした"],["者","もの"],["と"],["みなされる"],["。"],["彼","かれ"],["は"],["血","ち"],["を"],["流した","ながした"],["ゆえ"],["、"],["その"],["民","たみ"],["の"],["うち"],["から"],["断たれるで","たたれるで"],["あろう"],["。"]]},{"verse":5,"text":"これはイスラエルの人々,ひとびとに、彼,かれらが野,ののおもてでほふるのを常,つねとしていた犠牲,ぎせいを主,しゅのもとにひいてこさせ、会見,かいけんの幕屋,まくやの入口,いりぐちにおる祭司,さいしのもとにきて、これを主,しゅにささげる酬恩祭,しゅうおんさいの犠牲,ぎせいとしてほふらせるためである。","tok":[["これ"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["、"],["彼","かれ"],["ら"],["が"],["野","の"],["の"],["おもて"],["で"],["ほふる"],["の"],["を"],["常","つね"],["として"],["いた"],["犠牲","ぎせい"],["を"],["主","しゅ"],["の"],["もと"],["に"],["ひいて"],["こさせ"],["、"],["会見","かいけん"],["の"],["幕屋","まくや"],["の"],["入口","いりぐち"],["に"],["おる"],["祭司","さいし"],["の"],["もと"],["に"],["きて"],["、"],["これ"],["を"],["主に","しゅに"],["ささげる"],["酬恩祭","しゅうおんさい"],["の"],["犠牲","ぎせい"],["として"],["ほふらせる"],["ため"],["で"],["ある"],["。"]]},{"verse":6,"text":"祭司,さいしはその血,ちを会見,かいけんの幕屋,まくやの入口,いりぐちにある主,しゅの祭壇,さいだんに注,そそぎかけ、またその脂肪,しぼうを焼,やいて香,こうばしいかおりとし、主,しゅにささげなければならない。","tok":[["祭司","さいし"],["は"],["その"],["血","ち"],["を"],["会見","かいけん"],["の"],["幕屋","まくや"],["の"],["入口","いりぐち"],["に"],["ある"],["主","しゅ"],["の"],["祭壇","さいだん"],["に"],["注ぎ","そそぎ"],["かけ"],["、"],["また"],["その"],["脂肪","しぼう"],["を"],["焼いて","やいて"],["香ばしい","こうばしい"],["かおり"],["と"],["し"],["、"],["主に","しゅに"],["ささげなければ"],["ならない"],["。"]]},{"verse":7,"text":"彼,かれらが慕,したって姦淫,かんいんをおこなったみだらな神,かみに、再,ふたたび犠牲,ぎせいをささげてはならない。これは彼,かれらが代々,よよながく守,まもるべき定,さだめである』。","tok":[["彼","かれ"],["ら"],["が"],["慕って","したって"],["姦淫","かんいん"],["を"],["おこなった"],["みだら"],["な"],["神","かみ"],["に"],["、"],["再び","ふたたび"],["犠牲","ぎせい"],["を"],["ささげて"],["は"],["ならない"],["。"],["これ"],["は"],["彼","かれ"],["ら"],["が"],["代々","よ"],["よ"],["ながく"],["守","まもる"],["べき"],["定","さだめ"],["で"],["ある"],["』"],["。"]]},{"verse":8,"text":"あなたはまた彼,かれらに言,いいなさい、『イスラエルの家,いえの者,もの、またはあなたがたのうちに宿,やどる寄留者,きりゅうしゃのだれでも、燔祭,はんさいあるいは犠牲,ぎせいをささげるのに、","tok":[["あなた"],["は"],["また"],["彼","かれ"],["ら"],["に"],["言い","いい"],["なさい"],["、"],["『"],["イスラエル"],["の"],["家","いえ"],["の"],["者","もの"],["、"],["また"],["は"],["あなた"],["がた"],["の"],["うち"],["に"],["宿る","やどる"],["寄留者","きりゅうしゃ"],["の"],["だれ"],["で"],["も"],["、"],["燔祭","はんさい"],["あるいは"],["犠牲","ぎせい"],["を"],["ささげる"],["のに"],["、"]]},{"verse":9,"text":"これを会見,かいけんの幕屋,まくやの入口,いりぐちに携,たずさえてきて、主,しゅにささげないならば、その人,ひとは、その民,たみのうちから断,たたれるであろう。","tok":[["これ"],["を"],["会見","かいけん"],["の"],["幕屋","まくや"],["の"],["入口","いりぐち"],["に"],["携えて","たずさえて"],["きて"],["、"],["主に","しゅに"],["ささげないならば"],["、"],["その"],["人","ひと"],["は"],["、"],["その"],["民","たみ"],["の"],["うち"],["から"],["断たれるで","たたれるで"],["あろう"],["。"]]},{"verse":10,"text":"イスラエルの家,いえの者,もの、またはあなたがたのうちに宿,やどる寄留者,きりゅうしゃのだれでも、血,ちを食,たべるならば、わたしはその血,ちを食,たべる人,ひとに敵,てきして、わたしの顔,かおを向,むけ、これをその民,たみのうちから断,たつであろう。","tok":[["イスラエル"],["の"],["家","いえ"],["の"],["者","もの"],["、"],["また"],["は"],["あなた"],["がた"],["の"],["うち"],["に"],["宿る","やどる"],["寄留者","きりゅうしゃ"],["の"],["だれ"],["で"],["も"],["、"],["血","ち"],["を"],["食べるならば","たべるならば"],["、"],["わたし"],["は"],["その"],["血","ち"],["を"],["食べる","たべる"],["人","ひと"],["に"],["敵して","てきして"],["、"],["わたし"],["の"],["顔","かお"],["を"],["向け","むけ"],["、"],["これ"],["を"],["その"],["民","たみ"],["の"],["うち"],["から"],["断つで","たつで"],["あろう"],["。"]]},{"verse":11,"text":"肉,にくの命,いのちは血,ちにあるからである。あなたがたの魂,たましいのために祭壇,さいだんの上,うえで、あがないをするため、わたしはこれをあなたがたに与,あたえた。血,ちは命,いのちであるゆえに、あがなうことができるからである。","tok":[["肉","にく"],["の"],["命","いのち"],["は"],["血","ち"],["に"],["ある"],["から"],["で"],["ある"],["。"],["あなた"],["がた"],["の"],["魂","たましい"],["の"],["ため"],["に"],["祭壇","さいだん"],["の"],["上","うえ"],["で"],["、"],["あがない"],["を"],["する"],["ため"],["、"],["わたし"],["は"],["これ"],["を"],["あなた"],["がた"],["に"],["与","あたえ"],["た"],["。"],["血","ち"],["は"],["命","いのち"],["で"],["ある"],["ゆえ"],["に"],["、"],["あがなう"],["こと"],["が"],["できる"],["から"],["で"],["ある"],["。"]]},{"verse":12,"text":"このゆえに、わたしはイスラエルの人々,ひとびとに言,いった。あなたがたのうち、だれも血,ちを食,たべてはならない。またあなたがたのうちに宿,やどる寄留者,きりゅうしゃも血,ちを食,たべてはならない。","tok":[["この"],["ゆえ"],["に"],["、"],["わたし"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["言った","いった"],["。"],["あなた"],["がた"],["の"],["うち"],["、"],["だれ"],["も"],["血","ち"],["を"],["食べて","たべて"],["は"],["ならない"],["。"],["また"],["あなた"],["がた"],["の"],["うち"],["に"],["宿る","やどる"],["寄留者","きりゅうしゃ"],["も"],["血","ち"],["を"],["食べて","たべて"],["は"],["ならない"],["。"]]},{"verse":13,"text":"イスラエルの人々,ひとびとのうち、またあなたがたのうちに宿,やどる寄留者,きりゅうしゃのうち、だれでも、食,たべてもよい獣,けものあるいは鳥,とりを狩,かり獲,えた者,ものは、その血,ちを注,そそぎ出,だし、土,つちでこれをおおわなければならない。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["の"],["うち"],["、"],["また"],["あなた"],["がた"],["の"],["うち"],["に"],["宿る","やどる"],["寄留者","きりゅうしゃ"],["の"],["うち"],["、"],["だれ"],["で"],["も"],["、"],["食べて","たべて"],["も"],["よい"],["獣","けもの"],["あるいは"],["鳥","とり"],["を"],["狩","かり"],["獲た","えた"],["者","もの"],["は"],["、"],["その"],["血","ち"],["を"],["注ぎ","そそぎ"],["出し","だし"],["、"],["土","つち"],["で"],["これ"],["を"],["おおわなければ"],["ならない"],["。"]]},{"verse":14,"text":"すべて肉,にくの命,いのちは、その血,ちと一つだからである。それで、わたしはイスラエルの人々,ひとびとに言,いった。あなたがたは、どんな肉,にくの血,ちも食,たべてはならない。すべて肉,にくの命,いのちはその血,ちだからである。すべて血,ちを食,たべる者,ものは断,たたれるであろう。","tok":[["すべて"],["肉","にく"],["の"],["命","いのち"],["は"],["、"],["その"],["血","ち"],["と"],["一","ひと"],["つ"],["だ"],["から"],["で"],["ある"],["。"],["それ"],["で"],["、"],["わたし"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["言った","いった"],["。"],["あなた"],["がた"],["は"],["、"],["どんな"],["肉","にく"],["の"],["血","ち"],["も"],["食べて","たべて"],["は"],["ならない"],["。"],["すべて"],["肉","にく"],["の"],["命","いのち"],["は"],["その"],["血","ち"],["だ"],["から"],["で"],["ある"],["。"],["すべて"],["血","ち"],["を"],["食べる","たべる"],["者","もの"],["は"],["断たれるで","たたれるで"],["あろう"],["。"]]},{"verse":15,"text":"自然,しぜんに死,しんだもの、または裂,さき殺,ころされたものを食,たべる人,ひとは、国,くにに生,うまれた者,ものであれ、寄留者,きりゅうしゃであれ、その衣服,いふくを洗,あらい、水,みずに身,みをすすがなければならない。彼,かれは夕,ゆうまで汚,けがれているが、その後,のち、清,きよくなるであろう。","tok":[["自然","しぜん"],["に"],["死んだ","しんだ"],["もの"],["、"],["また"],["は"],["裂き","さき"],["殺された","ころされた"],["もの"],["を"],["食べる","たべる"],["人","ひと"],["は"],["、"],["国","くに"],["に"],["生まれた","うまれた"],["者","もの"],["で"],["あれ"],["、"],["寄留者","きりゅうしゃ"],["で"],["あれ"],["、"],["その"],["衣服","いふく"],["を"],["洗","あらい"],["、"],["水","みず"],["に"],["身","み"],["を"],["すすがなければ"],["ならない"],["。"],["彼","かれ"],["は"],["夕","ゆう"],["まで"],["汚","け"],["がれ"],["て"],["いる"],["が"],["、"],["その後","そのの"],["ち"],["、"],["清く","きよく"],["なるで"],["あろう"],["。"]]},{"verse":16,"text":"もし、洗,あらわず、また身,みをすすがないならば、彼,かれはその罪,つみを負,おわなければならない』」。","tok":[["もし"],["、"],["洗わず","あらわず"],["、"],["また"],["身","み"],["を"],["すすがないならば"],["、"],["彼","かれ"],["は"],["その"],["罪","つみ"],["を"],["負わなければ","おわなければ"],["ならない"],["』"],["」"],["。"]]}]
[{"verse":1,"text":"八日,か目,めになって、モーセはアロンとその子,こたち、およびイスラエルの長老,ちょうろうたちを呼,よび寄,よせ、","tok":[["八日目","かめ"],["に"],["なって"],["、"],["モーセ"],["は"],["アロン"],["と"],["その"],["子","こ"],["たち"],["、"],["および"],["イスラエル"],["の"],["長老","ちょうろう"],["たち"],["を"],["呼び寄せ","よびよせ"],["、"]]},{"verse":2,"text":"アロンに言,いった、「あなたは雄,おすの子,こ牛,うしの全,まったきものを罪祭,ざいさいのために取,とり、また雄羊,おひつじの全,まったきものを燔祭,はんさいのために取,とって、主,しゅの前,まえにささげなさい。","tok":[["アロン"],["に"],["言った","いった"],["、"],["「"],["あなた"],["は"],["雄","おす"],["の"],["子牛","こうし"],["の"],["全","まったきも"],["の"],["を"],["罪","つみ"],["祭","まつり"],["の"],["ため"],["に"],["取","とり"],["、"],["また"],["雄羊","おひつじ"],["の"],["全","まったきも"],["の"],["を"],["燔祭","はんさい"],["の"],["ため"],["に"],["取って","とって"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["ささげ"],["なさい"],["。"]]},{"verse":3,"text":"あなたはまたイスラエルの人々,ひとびとに言,いいなさい、『あなたがたは雄,おやぎを罪祭,ざいさいのために取,とり、また一歳,さいの全,まったき子,こ牛,うしと小羊,こひつじとを燔祭,はんさいのために取,とりなさい、","tok":[["あなた"],["は"],["また"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["言い","いい"],["なさい"],["、"],["『"],["あなた"],["がた"],["は"],["雄","おやぎ"],["を"],["罪","つみ"],["祭","まつり"],["の"],["ため"],["に"],["取","とり"],["、"],["また"],["一歳","さい"],["の"],["全","ま"],["っ"],["たき"],["子牛","こうし"],["と"],["小羊","こひつじ"],["と"],["を"],["燔祭","はんさい"],["の"],["ため"],["に"],["取","とり"],["なさい"],["、"]]},{"verse":4,"text":"また主,しゅの前,まえにささげる酬恩祭,しゅうおんさいのために雄牛,おうしと雄羊,おひつじとを取,とり、また油,あぶらを混,まぜた素祭,そさいを取,とりなさい。主,しゅがきょうあなたがたに現,あらわれたもうからである』」。","tok":[["また"],["主","しゅ"],["の"],["前","まえ"],["に"],["ささげる"],["酬恩祭","しゅうおんさい"],["の"],["ため"],["に"],["雄牛","おうし"],["と"],["雄羊","おひつじ"],["と"],["を"],["取","とり"],["、"],["また"],["油","あぶら"],["を"],["混ぜた","まぜた"],["素","す"],["祭","まつり"],["を"],["取","とり"],["なさい"],["。"],["主","しゅ"],["が"],["きょう"],["あなた"],["がた"],["に"],["現われた","あらわれた"],["もう"],["から"],["で"],["ある"],["』"],["」"],["。"]]},{"verse":5,"text":"彼,かれらはモーセが命,めいじたものを会見,かいけんの幕屋,まくやの前,まえに携,たずさえてきた。会衆,かいしゅうがみな近,ちかづいて主,しゅの前,まえに立,たったので、","tok":[["彼","かれ"],["ら"],["は"],["モーセ"],["が"],["命じた","めいじた"],["もの"],["を"],["会見","かいけん"],["の"],["幕屋","まくや"],["の"],["前","まえ"],["に"],["携えて","たずさえて"],["きた"],["。"],["会衆","かいしゅう"],["が"],["みな"],["近づいて","ちかづいて"],["主","しゅ"],["の"],["前","まえ"],["に"],["立った","たった"],["ので"],["、"]]},{"verse":6,"text":"モーセは言,いった、「これは主,しゅがあなたがたに、せよと命,めいじられたことである。こうして主,しゅの栄光,えいこうはあなたがたに現,あらわれるであろう」。","tok":[["モーセ"],["は"],["言った","いった"],["、"],["「"],["これ"],["は"],["主","しゅ"],["が"],["あなた"],["がた"],["に"],["、"],["せよ"],["と"],["命じられた","めいじられた"],["こと"],["で"],["ある"],["。"],["こう"],["して"],["主","しゅ"],["の"],["栄光","えいこう"],["は"],["あなた"],["がた"],["に"],["現われるで","あらわれるで"],["あろう"],["」"],["。"]]},{"verse":7,"text":"モーセはまたアロンに言,いった、「あなたは祭壇,さいだんに近,ちかづき、あなたの罪祭,ざいさいと燔祭,はんさいをささげて、あなたのため、また民,たみのためにあがないをし、また民,たみの供,そなえ物,ものをささげて、彼,かれらのためにあがないをし、すべて主,しゅがお命,めいじになったようにしなさい」。","tok":[["モーセ"],["は"],["また"],["アロン"],["に"],["言った","いった"],["、"],["「"],["あなた"],["は"],["祭壇","さいだん"],["に"],["近づき","ちかづき"],["、"],["あなた"],["の"],["罪","つみ"],["祭","まつり"],["と"],["燔祭","はんさい"],["を"],["ささげて"],["、"],["あなた"],["の"],["ため"],["、"],["また"],["民","たみ"],["の"],["ため"],["に"],["あがない"],["を"],["し"],["、"],["また"],["民","たみ"],["の"],["供え物","そなえもの"],["を"],["ささげて"],["、"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["あがない"],["を"],["し"],["、"],["すべて"],["主","しゅ"],["が"],["お命じ","おめいじ"],["に"],["なった"],["よう"],["に"],["し"],["なさい"],["」"],["。"]]},{"verse":8,"text":"そこでアロンは祭壇,さいだんに近,ちかづき、自分,じぶんのための罪祭,ざいさいの子,こ牛,うしをほふった。","tok":[["そこ"],["で"],["アロン"],["は"],["祭壇","さいだん"],["に"],["近づき","ちかづき"],["、"],["自分","じぶん"],["の"],["ため"],["の"],["罪","つみ"],["祭","まつり"],["の"],["子牛","こうし"],["を"],["ほふった"],["。"]]},{"verse":9,"text":"そしてアロンの子,こたちは、その血,ちを彼,かれのもとに携,たずさえてきたので、彼,かれは指,ゆびをその血,ちに浸,ひたし、それを祭壇,さいだんの角,つのにつけ、残,のこりの血,ちを祭壇,さいだんのもとに注,そそぎ、","tok":[["そして"],["アロン"],["の"],["子","こ"],["たち"],["は"],["、"],["その"],["血","ち"],["を"],["彼","かれ"],["の"],["もと"],["に"],["携えて","たずさえて"],["きた"],["ので"],["、"],["彼","かれ"],["は"],["指","ゆび"],["を"],["その"],["血","ち"],["に"],["浸し","ひたし"],["、"],["それ"],["を"],["祭壇","さいだん"],["の"],["角","つ"],["の"],["につけ"],["、"],["残り","のこり"],["の"],["血","ち"],["を"],["祭壇","さいだん"],["の"],["もと"],["に"],["注ぎ","そそぎ"],["、"]]},{"verse":10,"text":"また罪祭,ざいさいの脂肪,しぼうと腎臓,じんぞうと肝臓,かんぞうの小葉,しょうようとを祭壇,さいだんの上,うえで焼,やいた。主,しゅがモーセに命,めいじられたとおりである。","tok":[["また"],["罪","つみ"],["祭","まつり"],["の"],["脂肪","しぼう"],["と"],["腎臓","じんぞう"],["と"],["肝臓","かんぞう"],["の"],["小葉","しょうよう"],["と"],["を"],["祭壇","さいだん"],["の"],["上","うえ"],["で"],["焼いた","やいた"],["。"],["主","しゅ"],["が"],["モーセ"],["に"],["命じられた","めいじられた"],["とおり"],["で"],["ある"],["。"]]},{"verse":11,"text":"またその肉,にくと皮,かわとは宿営,しゅくえいの外,そとで火,ひをもって焼,やき捨,すてた。","tok":[["また"],["その"],["肉","にく"],["と"],["皮","かわ"],["と"],["は"],["宿営","しゅくえい"],["の"],["外","そと"],["で"],["火","ひ"],["を"],["もって"],["焼き捨てた","やきすてた"],["。"]]},{"verse":12,"text":"彼,かれはまた燔祭,はんさいの獣,けものをほふり、アロンの子,こたちがその血,ちを彼,かれに渡,わたしたので、これを祭壇,さいだんの周囲,しゅういに注,そそぎかけた。","tok":[["彼","かれ"],["は"],["また"],["燔祭","はんさい"],["の"],["獣","けもの"],["を"],["ほふり"],["、"],["アロン"],["の"],["子","こ"],["たち"],["が"],["その"],["血","ち"],["を"],["彼","かれ"],["に"],["渡","わたし"],["た"],["ので"],["、"],["これ"],["を"],["祭壇","さいだん"],["の"],["周囲","しゅうい"],["に"],["注ぎ","そそぎ"],["かけた"],["。"]]},{"verse":13,"text":"彼,かれらがまた燔祭,はんさいのもの、すなわち、その切,きり分,わけたものと頭,あたまとを彼,かれに渡,わたしたので、彼,かれはこれを祭壇,さいだんの上,うえで焼,やいた。","tok":[["彼","かれ"],["ら"],["が"],["また"],["燔祭","はんさい"],["の"],["もの"],["、"],["すなわち"],["、"],["その"],["切り分た","きりわけた"],["もの"],["と"],["頭","あたま"],["と"],["を"],["彼","かれ"],["に"],["渡","わたし"],["た"],["ので"],["、"],["彼","かれ"],["は"],["これ"],["を"],["祭壇","さいだん"],["の"],["上","うえ"],["で"],["焼いた","やいた"],["。"]]},{"verse":14,"text":"またその内臓,ないぞうと足,あしとを洗,あらい、祭壇,さいだんの上,うえで燔祭,はんさいと共,ともにこれを焼,やいた。","tok":[["また"],["その"],["内臓","ないぞう"],["と"],["足","あし"],["と"],["を"],["洗","あらい"],["、"],["祭壇","さいだん"],["の"],["上","うえ"],["で"],["燔祭","はんさい"],["と"],["共","とも"],["に"],["これ"],["を"],["焼いた","やいた"],["。"]]},{"verse":15,"text":"彼,かれはまた民,たみの供,そなえ物,ものをささげた。すなわち、民,たみのための罪祭,ざいさいのやぎを取,とってこれをほふり、前,まえのようにこれを罪,つみのためにささげた。","tok":[["彼","かれ"],["は"],["また"],["民","たみ"],["の"],["供え物","そなえもの"],["を"],["ささげた"],["。"],["すなわち"],["、"],["民","たみ"],["の"],["ため"],["の"],["罪","つみ"],["祭","まつり"],["の"],["やぎ"],["を"],["取って","とって"],["これ"],["を"],["ほふり"],["、"],["前","まえ"],["の"],["よう"],["に"],["これ"],["を"],["罪","つみ"],["の"],["ため"],["に"],["ささげた"],["。"]]},{"verse":16,"text":"また燔祭,はんさいをささげた。すなわち、これを定,さだめのようにささげた。","tok":[["また"],["燔祭","はんさい"],["を"],["ささげた"],["。"],["すなわち"],["、"],["これ"],["を"],["定め","さだめ"],["の"],["よう"],["に"],["ささげた"],["。"]]},{"verse":17,"text":"また素祭,そさいをささげ、そのうちから一握,ひとにぎりを取,とり、朝,あさの燔祭,はんさいに加,くわえて、これを祭壇,さいだんの上,うえで焼,やいた。","tok":[["また"],["素","す"],["祭","まつり"],["を"],["ささげ"],["、"],["その"],["うち"],["から"],["一握り","ひとにぎり"],["を"],["取","とり"],["、"],["朝","あさ"],["の"],["燔祭","はんさい"],["に"],["加えて","くわえて"],["、"],["これ"],["を"],["祭壇","さいだん"],["の"],["上","うえ"],["で"],["焼いた","やいた"],["。"]]},{"verse":18,"text":"彼,かれはまた民,たみのためにささげる酬恩祭,しゅうおんさいの犠牲,ぎせいの雄牛,おうしと雄羊,おひつじとをほふり、アロンの子,こたちが、その血,ちを彼,かれに渡,わたしたので、彼,かれはこれを祭壇,さいだんの周囲,しゅういに注,そそぎかけた。","tok":[["彼","かれ"],["は"],["また"],["民","たみ"],["の"],["ため"],["に"],["ささげる"],["酬恩祭","しゅうおんさい"],["の"],["犠牲","ぎせい"],["の"],["雄牛","おうし"],["と"],["雄羊","おひつじ"],["と"],["を"],["ほふり"],["、"],["アロン"],["の"],["子","こ"],["たち"],["が"],["、"],["その"],["血","ち"],["を"],["彼","かれ"],["に"],["渡","わたし"],["た"],["ので"],["、"],["彼","かれ"],["は"],["これ"],["を"],["祭壇","さいだん"],["の"],["周囲","しゅうい"],["に"],["注ぎ","そそぎ"],["かけた"],["。"]]},{"verse":19,"text":"またその雄牛,おうしと雄羊,おひつじとの脂肪,しぼう、すなわち、脂,あぶら尾,お、内臓,ないぞうをおおうもの、腎臓,じんぞう、肝臓,かんぞうの小葉,しょうよう。","tok":[["また"],["その"],["雄牛","おうし"],["と"],["雄羊","おひつじ"],["と"],["の"],["脂肪","しぼう"],["、"],["すなわち"],["、"],["脂","あぶら"],["尾","お"],["、"],["内臓","ないぞう"],["を"],["おおう"],["もの"],["、"],["腎臓","じんぞう"],["、"],["肝臓","かんぞう"],["の"],["小葉","しょうよう"],["。"]]},{"verse":20,"text":"これらの脂肪,しぼうを彼,かれらはその胸,むねの上,うえに載,のせて携,たずさえてきたので、彼,かれはその脂肪,しぼうを祭壇,さいだんの上,うえで焼,やいた。","tok":[["これ"],["ら"],["の"],["脂肪","しぼう"],["を"],["彼","かれ"],["ら"],["は"],["その"],["胸","むね"],["の"],["上","うえ"],["に"],["載せて","のせて"],["携えて","たずさえて"],["きた"],["ので"],["、"],["彼","かれ"],["は"],["その"],["脂肪","しぼう"],["を"],["祭壇","さいだん"],["の"],["上","うえ"],["で"],["焼いた","やいた"],["。"]]},{"verse":21,"text":"その胸,むねと右,みぎのももとは、アロンが主,しゅの前,まえに揺,ゆり動,うごかして揺祭,ようさいとした。モーセが命,めいじたとおりである。","tok":[["その"],["胸","むね"],["と"],["右","みぎ"],["の"],["もも"],["と"],["は"],["、"],["アロン"],["が"],["主","しゅ"],["の"],["前","まえ"],["に"],["揺り動かして","ゆりうごかして"],["揺祭","ようさい"],["と"],["した"],["。"],["モーセ"],["が"],["命じた","めいじた"],["とおり"],["で"],["ある"],["。"]]},{"verse":22,"text":"アロンは民,たみにむかって手,てをあげて、彼,かれらを祝福,しゅくふくし、罪祭,ざいさい、燔祭,はんさい、酬恩祭,しゅうおんさいをささげ終,おわって降,ふりた。","tok":[["アロン"],["は"],["民","たみ"],["に"],["むかって"],["手","て"],["を"],["あげて"],["、"],["彼","かれ"],["ら"],["を"],["祝福","しゅくふく"],["し"],["、"],["罪","つみ"],["祭","まつり"],["い"],["さい"],["、"],["燔祭","はんさい"],["、"],["酬恩祭","しゅうおんさい"],["を"],["ささげ"],["終わって","おわって"],["降りた","ふりた"],["。"]]},{"verse":23,"text":"モーセとアロンは会見,かいけんの幕屋,まくやに入,いり、また出,でてきて民,たみを祝福,しゅくふくした。そして主,しゅの栄光,えいこうはすべての民,たみに現,あらわれ、","tok":[["モーセ"],["と"],["アロン"],["は"],["会見","かいけん"],["の"],["幕屋","まくや"],["に"],["入","いり"],["、"],["また"],["出て","でて"],["きて"],["民","たみ"],["を"],["祝福","しゅくふく"],["した"],["。"],["そして"],["主","しゅ"],["の"],["栄光","えいこう"],["は"],["すべて"],["の"],["民","たみ"],["に"],["現われ","あらわれ"],["、"]]},{"verse":24,"text":"主,しゅの前,まえから火,ひが出,でて、祭壇,さいだんの上,うえの燔祭,はんさいと脂肪,しぼうとを焼,やきつくした。民,たみはみな、これを見,みて喜,よろこびよばわり、そしてひれ伏,ふした。","tok":[["主","しゅ"],["の"],["前","まえ"],["から"],["火","ひ"],["が"],["出て","でて"],["、"],["祭壇","さいだん"],["の"],["上","うえ"],["の"],["燔祭","はんさい"],["と"],["脂肪","しぼう"],["と"],["を"],["焼き","やき"],["つくした"],["。"],["民","たみ"],["は"],["みな"],["、"],["これ"],["を"],["見て","みて"],["喜こび","よろこび"],["よばわり"],["、"],["そして"],["ひれ伏した","ひれふした"],["。"]]}]
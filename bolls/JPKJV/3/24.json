[{"verse":1,"text":"主,しゅはまたモーセに言,いわれた、","tok":[["主","しゅ"],["は"],["また"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":2,"text":"「イスラエルの人々,ひとびとに命,めいじて、オリブを砕,くだいて採,とった純粋,じゅんすいの油,あぶらを、ともしびのためにあなたの所,ところへ持,もってこさせ、絶,たえずともしびをともさせなさい。","tok":[["「"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["命じて","めいじて"],["、"],["オリブ"],["を"],["砕いて","くだいて"],["採った","とった"],["純粋","じゅんすい"],["の"],["油","あぶら"],["を"],["、"],["ともしび"],["の"],["ため"],["に"],["あなた"],["の"],["所","ところ"],["へ"],["持って","もって"],["こさせ"],["、"],["絶えず","たえず"],["ともしび"],["を"],["ともさせ"],["なさい"],["。"]]},{"verse":3,"text":"すなわち、アロンは会見,かいけんの幕屋,まくやのうちのあかしの垂幕,たれまくの外,そとで、夕,ゆうから朝,あさまで絶,たえず、そのともしびを主,しゅの前,まえに整,ととのえなければならない。これはあなたがたが代々,よよながく守,まもるべき定,さだめである。","tok":[["すなわち"],["、"],["アロン"],["は"],["会見","かいけん"],["の"],["幕屋","まくや"],["の"],["うち"],["の"],["あかし"],["の"],["垂幕","たれまく"],["の"],["外","そと"],["で"],["、"],["夕","ゆう"],["から"],["朝","あさ"],["まで"],["絶えず","たえず"],["、"],["その"],["ともしび"],["を"],["主","しゅ"],["の"],["前","まえ"],["に"],["整えなければ","ととのえなければ"],["ならない"],["。"],["これ"],["は"],["あなた"],["がた"],["が"],["代々","よ"],["よ"],["ながく"],["守","まもる"],["べき"],["定","さだめ"],["で"],["ある"],["。"]]},{"verse":4,"text":"彼,かれは純金,じゅんきんの燭台,しょくだいの上,うえに、そのともしびを絶,たえず主,しゅの前,まえに整,ととのえなければならない。","tok":[["彼","かれ"],["は"],["純金","じゅんきん"],["の"],["燭台","しょくだい"],["の"],["上","うえ"],["に"],["、"],["その"],["ともしび"],["を"],["絶えず","たえず"],["主","しゅ"],["の"],["前","まえ"],["に"],["整えなければ","ととのえなければ"],["ならない"],["。"]]},{"verse":5,"text":"あなたは麦粉,むぎこを取,とり、それで十二個,この菓子,かしを焼,やかなければならない。菓子,かし一個,こに麦粉,むぎこ十分,ぶんの二エパを用,もちいなければならない。","tok":[["あなた"],["は"],["麦粉","むぎこ"],["を"],["取","とり"],["、"],["それ"],["で"],["十二個","こ"],["の"],["菓子","かし"],["を"],["焼かなければ","やかなければ"],["ならない"],["。"],["菓子","かし"],["一個","こ"],["に"],["麦粉","むぎこ"],["十分","ぶん"],["の"],["二","に"],["エパ"],["を"],["用いなければ","もちいなければ"],["ならない"],["。"]]},{"verse":6,"text":"そしてそれを主,しゅの前,まえの純金,じゅんきんの机,つくえの上,うえに、ひと重,かさね六個,こずつ、ふた重,かさねにして置,おかなければならない。","tok":[["そして"],["それ"],["を"],["主","しゅ"],["の"],["前","まえ"],["の"],["純金","じゅんきん"],["の"],["机","つくえ"],["の"],["上","うえ"],["に"],["、"],["ひと"],["重ね","かさね"],["六個","こ"],["ずつ"],["、"],["ふた"],["重ね","かさね"],["に"],["して"],["置かなければ","おかなければ"],["ならない"],["。"]]},{"verse":7,"text":"あなたはまた、おのおのの重,かさねの上,うえに、純粋,じゅんすいの乳香,にゅうこうを置,おいて、そのパンの記念,きねんの分,ぶんとし、主,しゅにささげて火祭,かさいとしなければならない。","tok":[["あなた"],["は"],["また"],["、"],["おのおの"],["の"],["重ね","かさね"],["の"],["上","うえ"],["に"],["、"],["純粋","じゅんすい"],["の"],["乳香","にゅうこう"],["を"],["置いて","おいて"],["、"],["その"],["パン"],["の"],["記念","きねん"],["の"],["分","ぶん"],["と"],["し"],["、"],["主に","しゅに"],["ささげて"],["火祭","かさい"],["と"],["しなければ"],["ならない"],["。"]]},{"verse":8,"text":"安息日,あんそくにちごとに絶,たえず、これを主,しゅの前,まえに整,ととのえなければならない。これはイスラエルの人々,ひとびとのささぐべきものであって、永遠,えいえんの契約,けいやくである。","tok":[["安息日","あんそくにちごと"],["に"],["絶えず","たえず"],["、"],["これ"],["を"],["主","しゅ"],["の"],["前","まえ"],["に"],["整えなければ","ととのえなければ"],["ならない"],["。"],["これ"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["ささぐべき"],["もの"],["で"],["あって"],["、"],["永遠","えいえん"],["の"],["契約","けいやく"],["で"],["ある"],["。"]]},{"verse":9,"text":"これはアロンとその子,こたちに帰,きする。彼,かれらはこれを聖,せいなる所,ところで食,たべなければならない。これはいと聖,せいなる物,ものであって、主,しゅの火祭,かさいのうち彼,かれに帰,きすべき永久,えいきゅうの分,ぶんである」。","tok":[["これ"],["は"],["アロン"],["と"],["その"],["子","こ"],["たち"],["に"],["帰する","きする"],["。"],["彼","かれ"],["ら"],["は"],["これ"],["を"],["聖","せい"],["なる"],["所","ところ"],["で"],["食べなければ","たべなければ"],["ならない"],["。"],["これ"],["はい"],["と"],["聖","せい"],["なる"],["物","もの"],["で"],["あって"],["、"],["主","しゅ"],["の"],["火祭","かさい"],["の"],["うち"],["彼","かれ"],["に"],["帰すべき","きすべき"],["永久","えいきゅう"],["の"],["分","ぶん"],["で"],["ある"],["」"],["。"]]},{"verse":10,"text":"イスラエルの女,おんなを母,ははとし、エジプトびとを父,ちちとするひとりの者,ものが、イスラエルの人々,ひとびとのうちに出,でてきて、そのイスラエルの女,おんなの産,うんだ子,こと、ひとりのイスラエルびとが宿営,しゅくえいの中,なかで争,あらそいをし、","tok":[["イスラエル"],["の"],["女","おんな"],["を"],["母","はは"],["と"],["し"],["、"],["エジプト"],["びと"],["を"],["父","ちち"],["と"],["する"],["ひとり"],["の"],["者","もの"],["が"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["うち"],["に"],["出て","でて"],["きて"],["、"],["その"],["イスラエル"],["の"],["女","おんな"],["の"],["産んだ","うんだ"],["子","こ"],["と"],["、"],["ひとり"],["の"],["イスラエル"],["びと"],["が"],["宿営","しゅくえい"],["の"],["中","なか"],["で"],["争い","あらそい"],["を"],["し"],["、"]]},{"verse":11,"text":"そのイスラエルの女,おんなの産,うんだ子,こが主,しゅの名,なを汚,けがして、のろったので、人々,ひとびとは彼,かれをモーセのもとに連,つれてきた。その母,はははダンの部族,ぶぞくのデブリの娘,むすめで、名,なをシロミテといった。","tok":[["その"],["イスラエル"],["の"],["女","おんな"],["の"],["産んだ","うんだ"],["子","こ"],["が"],["主","しゅ"],["の"],["名","な"],["を"],["汚","け"],["がして"],["、"],["のろった"],["ので"],["、"],["人々","ひとびと"],["は"],["彼","かれ"],["を"],["モーセ"],["の"],["もと"],["に"],["連れて","つれて"],["きた"],["。"],["その"],["母","はは"],["は"],["ダン"],["の"],["部族","ぶぞく"],["の"],["デブリ"],["の"],["娘","むすめ"],["で"],["、"],["名","な"],["を"],["シロミテ"],["と"],["いった"],["。"]]},{"verse":12,"text":"人々,ひとびとは彼,かれを閉,とじ込,こめて置,おいて、主,しゅの示,しめしを受,うけるのを待,まっていた。","tok":[["人々","ひとびと"],["は"],["彼","かれ"],["を"],["閉じ込めて","とじこめて"],["置いて","おいて"],["、"],["主","しゅ"],["の"],["示めし","しめし"],["を"],["受る","うける"],["の"],["を"],["待って","まって"],["いた"],["。"]]},{"verse":13,"text":"時,ときに主,しゅはモーセに言,いわれた、","tok":[["時","とき"],["に"],["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":14,"text":"「あの、のろいごとを言,いった者,ものを宿営,しゅくえいの外,そとに引,ひき出,だし、それを聞,きいた者,ものに、みな手,てを彼,かれの頭,あたまに置,おかせ、全,ぜん会衆,かいしゅうに彼,かれを石,いしで撃,うたせなさい。","tok":[["「"],["あの"],["、"],["のろい"],["ごと"],["を"],["言った","いった"],["者","もの"],["を"],["宿営","しゅくえい"],["の"],["外","そと"],["に"],["引出し","ひきだし"],["、"],["それ"],["を"],["聞いた","きいた"],["者","もの"],["に"],["、"],["みな"],["手","て"],["を"],["彼","かれ"],["の"],["頭","あたま"],["に"],["置かせ","おかせ"],["、"],["全","ぜん"],["会衆","かいしゅう"],["に"],["彼","かれ"],["を"],["石","いし"],["で"],["撃たせ","うたせ"],["なさい"],["。"]]},{"verse":15,"text":"あなたはまたイスラエルの人々,ひとびとに言,いいなさい、『だれでも、その神,かみをのろう者,ものは、その罪,つみを負,おわなければならない。","tok":[["あなた"],["は"],["また"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["言い","いい"],["なさい"],["、"],["『"],["だれ"],["で"],["も"],["、"],["その"],["神","かみ"],["を"],["の"],["ろう者","ろうもの"],["は"],["、"],["その"],["罪","つみ"],["を"],["負わなければ","おわなければ"],["ならない"],["。"]]},{"verse":16,"text":"主,しゅの名,なを汚,けがす者,ものは必,かならず殺,ころされるであろう。全,ぜん会衆,かいしゅうは必,かならず彼,かれを石,いしで撃,うたなければならない。他国,たこくの者,ものでも、この国,くにに生,うまれた者,ものでも、主,しゅの名,なを汚,けがすときは殺,ころされなければならない。","tok":[["主","しゅ"],["の"],["名","な"],["を"],["汚","け"],["がす"],["者","もの"],["は"],["必","かならず"],["殺ろされるで","ころされるで"],["あろう"],["。"],["全","ぜん"],["会衆","かいしゅう"],["は"],["必","かならず"],["彼","かれ"],["を"],["石","いし"],["で"],["撃たなければ","うたなければ"],["ならない"],["。"],["他国","たこく"],["の"],["者","もの"],["で"],["も"],["、"],["この"],["国","くに"],["に"],["生まれた","うまれた"],["者","もの"],["で"],["も"],["、"],["主","しゅ"],["の"],["名","な"],["を"],["汚す","けがす"],["とき"],["は"],["殺ろされなければ","ころされなければ"],["ならない"],["。"]]},{"verse":17,"text":"だれでも、人,ひとを撃,うち殺,ころした者,ものは、必,かならず殺,ころされなければならない。","tok":[["だれ"],["で"],["も"],["、"],["人","ひと"],["を"],["撃ち殺した","うちころした"],["者","もの"],["は"],["、"],["必","かならず"],["殺ろされなければ","ころされなければ"],["ならない"],["。"]]},{"verse":18,"text":"獣,けものを撃,うち殺,ころした者,ものは、獣,けものをもってその獣,けものを償,つぐなわなければならない。","tok":[["獣","けもの"],["を"],["撃ち殺した","うちころした"],["者","もの"],["は"],["、"],["獣","けもの"],["を"],["もって"],["その"],["獣","けもの"],["を"],["償なわなければ","つぐなわなければ"],["ならない"],["。"]]},{"verse":19,"text":"もし人,ひとが隣人,りんじんに傷,きずを負,おわせるなら、その人,ひとは自分,じぶんがしたように自分,じぶんにされなければならない。","tok":[["もし"],["人","ひと"],["が"],["隣人","りんじん"],["に"],["傷","きず"],["を"],["負わせるなら","おわせるなら"],["、"],["その"],["人","ひと"],["は"],["自分","じぶん"],["が"],["した"],["よう"],["に"],["自分","じぶん"],["に"],["されなければ"],["ならない"],["。"]]},{"verse":20,"text":"すなわち、骨折,こっせつには骨折,こっせつ、目,めには目,め、歯,はには歯,はをもって、人,ひとに傷,きずを負,おわせたように、自分,じぶんにもされなければならない。","tok":[["すなわち"],["、"],["骨折","こっせつ"],["に"],["は"],["骨折","こっせつ"],["、"],["目","め"],["に"],["は"],["目","め"],["、"],["歯","は"],["に"],["は"],["歯","は"],["を"],["もって"],["、"],["人","ひと"],["に"],["傷","きず"],["を"],["負わせた","おわせた"],["よう"],["に"],["、"],["自分","じぶん"],["に"],["も"],["されなければ"],["ならない"],["。"]]},{"verse":21,"text":"獣,けものを撃,うち殺,ころした者,ものはそれを償,つぐない、人,ひとを撃,うち殺,ころした者,ものは殺,ころされなければならない。","tok":[["獣","けもの"],["を"],["撃ち殺した","うちころした"],["者","もの"],["は"],["それ"],["を"],["償ない","つぐない"],["、"],["人","ひと"],["を"],["撃ち殺した","うちころした"],["者","もの"],["は"],["殺ろされなければ","ころされなければ"],["ならない"],["。"]]},{"verse":22,"text":"他国,たこくの者,ものにも、この国,くにに生,うまれた者,ものにも、あなたがたは同一,どういつのおきてを用,もちいなければならない。わたしはあなたがたの神,かみ、主,しゅだからである』」。","tok":[["他国","たこく"],["の"],["者","もの"],["に"],["も"],["、"],["この"],["国","くに"],["に"],["生まれた","うまれた"],["者","もの"],["に"],["も"],["、"],["あなた"],["がた"],["は"],["同一","どういつ"],["の"],["おきて"],["を"],["用いなければ","もちいなければ"],["ならない"],["。"],["わたし"],["は"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主らで","しゅだからで"],["ある"],["』"],["」"],["。"]]},{"verse":23,"text":"モーセがイスラエルの人々,ひとびとに向,むかい、「あの、のろいごとを言,いった者,ものを宿営,しゅくえいの外,そとに引,ひき出,だし、石,いしで撃,うて」と命,めいじたので、イスラエルの人々,ひとびとは、主,しゅがモーセに命,めいじられたようにした。","tok":[["モーセ"],["が"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["向","むかい"],["、"],["「"],["あの"],["、"],["のろい"],["ごと"],["を"],["言った","いった"],["者","もの"],["を"],["宿営","しゅくえい"],["の"],["外","そと"],["に"],["引出し","ひきだし"],["、"],["石","いし"],["で"],["撃て","うて"],["」"],["と"],["命じた","めいじた"],["ので"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["、"],["主","しゅ"],["が"],["モーセ"],["に"],["命じられた","めいじられた"],["よう"],["に"],["した"],["。"]]}]
[{"verse":1,"text":"神,かみは、むかしは、預言者,よげんしゃたちにより、いろいろな時,ときに、いろいろな方法,ほうほうで、先祖,せんぞたちに語,かたられたが、","tok":[["神","かみ"],["は"],["、"],["むかし"],["は"],["、"],["預言者","よげんしゃ"],["たち"],["に"],["より"],["、"],["いろいろ"],["な"],["時","とき"],["に"],["、"],["いろいろ"],["な"],["方法","ほうほう"],["で"],["、"],["先祖","せんぞ"],["たち"],["に"],["語られた","かたられた"],["が"],["、"]]},{"verse":2,"text":"この終,おわりの時,ときには、御子,みこによって、わたしたちに語,かたられたのである。神,かみは御子,みこを万物,ばんぶつの相続者,そうぞくしゃと定,さだめ、また、御子,みこによって、もろもろの世界,せかいを造,つくられた。","tok":[["この"],["終","おわり"],["の"],["時","とき"],["に"],["は"],["、"],["御子","みこ"],["によって"],["、"],["わたしたち"],["に"],["語られた","かたられた"],["ので"],["ある"],["。"],["神","かみ"],["は"],["御子","みこ"],["を"],["万物","ばんぶつ"],["の"],["相続者","そうぞくしゃ"],["と"],["定め","さだめ"],["、"],["また"],["、"],["御子","みこ"],["によって"],["、"],["もろもろ"],["の"],["世界","せかい"],["を"],["造られた","つくられた"],["。"]]},{"verse":3,"text":"御子,みこは神,かみの栄光,えいこうの輝,かがやきであり、神,かみの本質,ほんしつの真,しんの姿,すがたであって、その力,ちからある言葉,ことばをもって万物,ばんぶつを保,たもっておられる。そして罪,つみのきよめのわざをなし終,おえてから、いと高,たかき所,ところにいます大能者,たいのうしゃの右,みぎに、座,ざにつかれたのである。","tok":[["御子","みこ"],["は"],["神","かみ"],["の"],["栄光","えいこう"],["の"],["輝やきで","かがやきで"],["あり"],["、"],["神","かみ"],["の"],["本質","ほんしつ"],["の"],["真","しん"],["の"],["姿","すがた"],["で"],["あって"],["、"],["その"],["力","ちから"],["ある"],["言葉","ことば"],["を"],["もって"],["万物","ばんぶつ"],["を"],["保って","たもって"],["おられる"],["。"],["そして"],["罪","つみ"],["の"],["きよめ"],["の"],["わざ"],["を"],["なし"],["終えて","おえて"],["から"],["、"],["いと"],["高き","たかき"],["所","ところ"],["に"],["います"],["大能者","たいのうしゃ"],["の"],["右","みぎ"],["に"],["、"],["座","ざ"],["に"],["つかれた"],["ので"],["ある"],["。"]]},{"verse":4,"text":"御子,みこは、その受,うけ継,つがれた名,なが御使,みつかいたちの名,なにまさっているので、彼,かれらよりもすぐれた者,ものとなられた。","tok":[["御子","みこ"],["は"],["、"],["その"],["受け継がれた","うけつがれた"],["名","な"],["が"],["御使","みつかいたち"],["の"],["名","な"],["に"],["まさって"],["いる"],["ので"],["、"],["彼","かれ"],["ら"],["より"],["も"],["すぐれた"],["者","もの"],["と"],["なられた"],["。"]]},{"verse":5,"text":"いったい、神,かみは御使,みつかいたちのだれに対,たいして、「あなたこそは、わたしの子,こ。きょう、わたしはあなたを生,うんだ」と言,いい、さらにまた、「わたしは彼,かれの父,ちちとなり、彼,かれはわたしの子,ことなるであろう」と言,いわれたことがあるか。","tok":[["いったい"],["、"],["神","かみ"],["は"],["御使","みつかいたち"],["の"],["だれ"],["に対して","にたいして"],["、"],["「"],["あなた"],["こそ"],["は"],["、"],["わたし"],["の"],["子","こ"],["。"],["きょう"],["、"],["わたし"],["は"],["あなた"],["を"],["生んだ","うんだ"],["」"],["と"],["言い","いい"],["、"],["さらに"],["また"],["、"],["「"],["わたし"],["は"],["彼","かれ"],["の"],["父","ちち"],["と"],["なり"],["、"],["彼","かれ"],["は"],["わたし"],["の"],["子","こ"],["と"],["なるで"],["あろう"],["」"],["と"],["言われた","いわれた"],["こと"],["が"],["ある"],["か"],["。"]]},{"verse":6,"text":"さらにまた、神,かみは、その長子,ちょうしを世界,せかいに導,みちびき入,いれるに当,あたって、「神,かみの御使,みつかいたちはことごとく、彼,かれを拝,はいすべきである」と言,いわれた。","tok":[["さらに"],["また"],["、"],["神","かみ"],["は"],["、"],["その"],["長子","ちょうし"],["を"],["世界","せかい"],["に"],["導き入れる","みちびきいれる"],["に"],["当たって","あたって"],["、"],["「"],["神","かみ"],["の"],["御使","みつかいたち"],["は"],["ことごとく"],["、"],["彼","かれ"],["を"],["拝すべきで","はいすべきで"],["ある"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":7,"text":"また、御使,みつかいたちについては、「神,かみは、御使,みつかいたちを風,かぜとし、ご自分,じぶんに仕,つかえる者,ものたちを炎,ほのおとされる」と言,いわれているが、","tok":[["また"],["、"],["御使","みつかいたち"],["について"],["は"],["、"],["「"],["神","かみ"],["は"],["、"],["御使","みつかいたち"],["を"],["風","かぜ"],["と"],["し"],["、"],["ご自分","ごじぶん"],["に"],["仕える","つかえる"],["者","もの"],["たち"],["を"],["炎","ほのお"],["と"],["される"],["」"],["と"],["言われて","いわれて"],["いる"],["が"],["、"]]},{"verse":8,"text":"御子,みこについては、「神,かみよ、あなたの御座,みざは、世々,よよ限,かぎりなく続,つづき、あなたの支配,しはいのつえは、公平,こうへいのつえである。","tok":[["御子","みこ"],["について"],["は"],["、"],["「"],["神","かみ"],["よ"],["、"],["あなた"],["の"],["御座","みざ"],["は"],["、"],["世々","よ"],["よ"],["限","かぎり"],["なく"],["続き","つづき"],["、"],["あなた"],["の"],["支配","しはい"],["の"],["つえ"],["は"],["、"],["公平","こうへい"],["の"],["つえ"],["で"],["ある"],["。"]]},{"verse":9,"text":"あなたは義,ぎを愛,あいし、不法,ふほうを憎,にくまれた。それゆえに、神,かみ、あなたの神,かみは、喜,よろこびのあぶらを、あなたの友,ともに注,そそぐよりも多,おおく、あなたに注,そそがれた」と言,いい、","tok":[["あなた"],["は"],["義","ぎ"],["を"],["愛し","あいし"],["、"],["不法","ふほう"],["を"],["憎まれた","にくまれた"],["。"],["それ"],["ゆえ"],["に"],["、"],["神","かみ"],["、"],["あなた"],["の"],["神","かみ"],["は"],["、"],["喜こび","よろこび"],["の"],["あぶら"],["を"],["、"],["あなた"],["の"],["友","とも"],["に"],["注ぐ","そそぐ"],["より"],["も"],["多く","おおく"],["、"],["あなた"],["に"],["注がれた","そそがれた"],["」"],["と"],["言い","いい"],["、"]]},{"verse":10,"text":"さらに、「主,しゅよ、あなたは初,はじめに、地,ちの基,もといをおすえになった。もろもろの天,てんも、み手,てのわざである。","tok":[["さらに"],["、"],["「"],["主","しゅ"],["よ"],["、"],["あなた"],["は"],["初め","はじめ"],["に"],["、"],["地","ち"],["の"],["基い","もとい"],["を"],["お"],["すえ"],["に"],["なった"],["。"],["もろもろ"],["の"],["天","てん"],["も"],["、"],["み手","みて"],["の"],["わざ"],["で"],["ある"],["。"]]},{"verse":11,"text":"これらのものは滅,ほろびてしまうが、あなたは、いつまでもいますかたである。すべてのものは衣,ころものように古,ふるび、","tok":[["これ"],["ら"],["の"],["もの"],["は"],["滅びて","ほろびて"],["しまう"],["が"],["、"],["あなた"],["は"],["、"],["いつ"],["まで"],["も"],["います"],["かた"],["で"],["ある"],["。"],["すべて"],["の"],["もの"],["は"],["衣","ころも"],["の"],["よう"],["に"],["古び","ふるび"],["、"]]},{"verse":12,"text":"それらをあなたは、外套,がいとうのように巻,まかれる。これらのものは、衣,ころものように変,かわるが、あなたは、いつも変,かわることがなく、あなたのよわいは、尽,つきることがない」とも言,いわれている。","tok":[["それ"],["ら"],["を"],["あなた"],["は"],["、"],["外套","がいとう"],["の"],["よう"],["に"],["巻かれる","まかれる"],["。"],["これ"],["ら"],["の"],["もの"],["は"],["、"],["衣","ころも"],["の"],["よう"],["に"],["変わる","かわる"],["が"],["、"],["あなた"],["は"],["、"],["いつも"],["変わる","かわる"],["こと"],["が"],["なく"],["、"],["あなた"],["の"],["よわい"],["は"],["、"],["尽きる","つきる"],["こと"],["が"],["ない"],["」"],["と"],["も"],["言われて","いわれて"],["いる"],["。"]]},{"verse":13,"text":"神,かみは、御使,みつかいたちのだれに対,たいして、「あなたの敵,てきを、あなたの足,あし台,だいとするときまでは、わたしの右,みぎに座,ざしていなさい」と言,いわれたことがあるか。","tok":[["神","かみ"],["は"],["、"],["御使","みつかいたち"],["の"],["だれ"],["に対して","にたいして"],["、"],["「"],["あなた"],["の"],["敵","てき"],["を"],["、"],["あなた"],["の"],["足台","あしだい"],["と"],["する"],["とき"],["まで"],["は"],["、"],["わたし"],["の"],["右","みぎ"],["に"],["座して","ざして"],["い"],["なさい"],["」"],["と"],["言われた","いわれた"],["こと"],["が"],["ある"],["か"],["。"]]},{"verse":14,"text":"御使,みつかいたちはすべて仕,つかえる霊,れいであって、救,すくいを受,うけ継,つぐべき人々,ひとびとに奉仕,ほうしするため、つかわされたものではないか。","tok":[["御使","みつかいたち"],["は"],["すべて"],["仕える","つかえる"],["霊","れい"],["で"],["あって"],["、"],["救い","すくい"],["を"],["受け継ぐべき","うけつぐべき"],["人々","ひとびと"],["に"],["奉仕","ほうし"],["する"],["ため"],["、"],["つかわされた"],["もの"],["で"],["は"],["ない"],["か"],["。"]]}]
[{"verse":1,"text":"さて、信仰,しんこうとは、望,のぞんでいる事,ことがらを確信,かくしんし、まだ見,みていない事実,じじつを確認,かくにんすることである。","tok":[["さて"],["、"],["信仰","しんこう"],["と"],["は"],["、"],["望","の"],["ぞ"],["ん"],["で"],["いる"],["事がら","ことがら"],["を"],["確信","かくしん"],["し"],["、"],["まだ"],["見て","みて"],["いない"],["事実","じじつ"],["を"],["確認","かくにん"],["する"],["こと"],["で"],["ある"],["。"]]},{"verse":2,"text":"昔,むかしの人,ひとたちは、この信仰,しんこうのゆえに賞賛,しょうさんされた。","tok":[["昔","むかし"],["の"],["人","ひと"],["たち"],["は"],["、"],["この"],["信仰","しんこう"],["の"],["ゆえ"],["に"],["賞賛","しょうさん"],["された"],["。"]]},{"verse":3,"text":"信仰,しんこうによって、わたしたちは、この世,よ界が神,かみの言葉,ことばで造,つくられたのであり、したがって、見,みえるものは現,あらわれているものから出,でてきたのでないことを、悟,さとるのである。","tok":[["信仰","しんこう"],["によって"],["、"],["わたしたち"],["は"],["、"],["この"],["世界","よ界"],["が"],["神","かみ"],["の"],["言葉","ことば"],["で"],["造られた","つくられた"],["ので"],["あり"],["、"],["したがって"],["、"],["見える","みえる"],["もの"],["は"],["現われて","あらわれて"],["いる"],["もの"],["から"],["出て","でて"],["きた"],["ので"],["ない"],["こと"],["を"],["、"],["悟","さとる"],["ので"],["ある"],["。"]]},{"verse":4,"text":"信仰,しんこうによって、アベルはカインよりもまさったいけにえを神,かみにささげ、信仰,しんこうによって義,ぎなる者,ものと認,みとめられた。神,かみが、彼,かれの供,そなえ物,ものをよしとされたからである。彼,かれは死,しんだが、信仰,しんこうによって今,いまもなお語,かたっている。","tok":[["信仰","しんこう"],["によって"],["、"],["アベル"],["は"],["カイン"],["より"],["も"],["まさった"],["いけにえ"],["を"],["神","かみ"],["に"],["ささげ"],["、"],["信仰","しんこう"],["によって"],["義","ぎ"],["なる"],["者","もの"],["と"],["認められた","みとめられた"],["。"],["神","かみ"],["が"],["、"],["彼","かれ"],["の"],["供え物","そなえもの"],["を"],["よし"],["と"],["された"],["から"],["で"],["ある"],["。"],["彼","かれ"],["は"],["死んだ","しんだ"],["が"],["、"],["信仰","しんこう"],["によって"],["今","いま"],["も"],["なお"],["語って","かたって"],["いる"],["。"]]},{"verse":5,"text":"信仰,しんこうによって、エノクは死,しを見,みないように天,てんに移,うつされた。神,かみがお移,うつしになったので、彼,かれは見,みえなくなった。彼,かれが移,うつされる前,まえに、神,かみに喜,よろこばれた者,ものと、あかしされていたからである。","tok":[["信仰","しんこう"],["によって"],["、"],["エノク"],["は"],["死","し"],["を"],["見ない","みない"],["よう"],["に"],["天","てん"],["に"],["移された","うつされた"],["。"],["神","かみ"],["が"],["お移し","おうつし"],["に"],["なった"],["ので"],["、"],["彼","かれ"],["は"],["見えなく","みえなく"],["なった"],["。"],["彼","かれ"],["が"],["移される","うつされる"],["前","まえ"],["に"],["、"],["神","かみ"],["に"],["喜こばれた","よろこばれた"],["者","もの"],["と"],["、"],["あかし"],["されて"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":6,"text":"信仰,しんこうがなくては、神,かみに喜,よろこばれることはできない。なぜなら、神,かみに来,くる者,ものは、神,かみのいますことと、ご自身,じしんを求,もとめる者,ものに報,むくいて下,くださることとを、必,かならず信,しんじるはずだからである。","tok":[["信仰","しんこう"],["が"],["なく"],["ては"],["、"],["神","かみ"],["に"],["喜こばれる","よろこばれる"],["こと"],["は"],["できない"],["。"],["なぜ"],["なら"],["、"],["神","かみ"],["に"],["来る","くる"],["者","もの"],["は"],["、"],["神","かみ"],["の"],["います"],["こと"],["と"],["、"],["ご自身","ごじしん"],["を"],["求める","もとめる"],["者","もの"],["に"],["報いて","むくいて"],["下さる","くださる"],["こと"],["と"],["を"],["、"],["必","かならず"],["信じる","しんじる"],["はず"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":7,"text":"信仰,しんこうによって、ノアはまだ見,みていない事,ことがらについて御,み告,つげを受,うけ、恐,おそれかしこみつつ、その家族,かぞくを救,すくうために箱舟,はこぶねを造,つくり、その信仰,しんこうによって世,よの罪,つみをさばき、そして、信仰,しんこうによる義,ぎを受,うけ継,つぐ者,ものとなった。","tok":[["信仰","しんこう"],["によって"],["、"],["ノア"],["は"],["まだ"],["見て","みて"],["いない"],["事がら","ことがら"],["について"],["御告","みつげ"],["を"],["受け","うけ"],["、"],["恐れ","おそれ"],["かしこみ"],["つつ"],["、"],["その"],["家族","かぞく"],["を"],["救う","すくう"],["ため"],["に"],["箱舟","はこぶね"],["を"],["造","つくり"],["、"],["その"],["信仰","しんこう"],["によって"],["世","よ"],["の"],["罪","つみ"],["を"],["さばき"],["、"],["そして"],["、"],["信仰","しんこう"],["に"],["よる"],["義","ぎ"],["を"],["受け継ぐ","うけつぐ"],["者","もの"],["と"],["なった"],["。"]]},{"verse":8,"text":"信仰,しんこうによって、アブラハムは、受,うけ継,つぐべき地,ちに出,でて行,いけとの召,めしをこうむった時,とき、それに従,したがい、行,ゆく先,さきを知,しらないで出,でて行,いった。","tok":[["信仰","しんこう"],["によって"],["、"],["アブラハム"],["は"],["、"],["受け継ぐべき","うけつぐべき"],["地","ち"],["に"],["出て","でて"],["行け","いけ"],["と"],["の"],["召","めし"],["を"],["こうむった"],["時","とき"],["、"],["それ"],["に"],["従い","したがい"],["、"],["行く先","ゆくさき"],["を"],["知らないで","しらないで"],["出て","でて"],["行った","いった"],["。"]]},{"verse":9,"text":"信仰,しんこうによって、他国,たこくにいるようにして約束,やくそくの地,ちに宿,やどり、同,おなじ約束,やくそくを継,つぐイサク、ヤコブと共,ともに、幕屋,まくやに住,すんだ。","tok":[["信仰","しんこう"],["によって"],["、"],["他国","たこく"],["に"],["いる"],["よう"],["に"],["して"],["約束","やくそく"],["の"],["地","ち"],["に"],["宿り","やどり"],["、"],["同じ","おなじ"],["約束","やくそく"],["を"],["継ぐ","つぐ"],["イサク"],["、"],["ヤコブ"],["と"],["共","とも"],["に"],["、"],["幕屋","まくや"],["に"],["住んだ","すんだ"],["。"]]},{"verse":10,"text":"彼,かれは、ゆるがぬ土台,どだいの上,うえに建,たてられた都,みやこを、待,まち望,のぞんでいたのである。その都,みやこをもくろみ、また建,たてたのは、神,かみである。","tok":[["彼","かれ"],["は"],["、"],["ゆるがぬ"],["土台","どだい"],["の"],["上","うえ"],["に"],["建てられた","たてられた"],["都","みやこ"],["を"],["、"],["待望んで","まちのぞんで"],["いた"],["ので"],["ある"],["。"],["その"],["都","みやこ"],["を"],["もくろみ"],["、"],["また"],["建てた","たてた"],["の"],["は"],["、"],["神","かみ"],["で"],["ある"],["。"]]},{"verse":11,"text":"信仰,しんこうによって、サラもまた、年老,としおいていたが、種,たねを宿,やどす力,ちからを与,あたえられた。約束,やくそくをなさったかたは真実,しんじつであると、信,しんじていたからである。","tok":[["信仰","しんこう"],["によって"],["、"],["サラ"],["も"],["また"],["、"],["年老いて","としおいて"],["いた"],["が"],["、"],["種","たね"],["を"],["宿す","やどす"],["力","ちから"],["を"],["与えられた","あたえられた"],["。"],["約束","やくそく"],["を"],["なさった"],["かた"],["は"],["真実","しんじつ"],["で"],["ある"],["と"],["、"],["信じて","しんじて"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":12,"text":"このようにして、ひとりの死,しんだと同様,どうような人,ひとから、天,てんの星,ほしのように、海,うみべの数,かぞえがたい砂,すなのように、おびただしい人,ひとが生,うまれてきたのである。","tok":[["この"],["よう"],["に"],["して"],["、"],["ひとり"],["の"],["死んだ","しんだ"],["と"],["同様","どうよう"],["な"],["人","ひと"],["から"],["、"],["天","てん"],["の"],["星","ほし"],["の"],["よう"],["に"],["、"],["海べ","うみべ"],["の"],["数え","かぞえ"],["がたい"],["砂","すな"],["の"],["よう"],["に"],["、"],["おびただしい"],["人","ひと"],["が"],["生まれて","うまれて"],["きた"],["ので"],["ある"],["。"]]},{"verse":13,"text":"これらの人,ひとはみな、信仰,しんこうをいだいて死,しんだ。まだ約束,やくそくのものは受,うけていなかったが、はるかにそれを望,のぞみ見,みて喜,よろこび、そして、地上,ちじょうでは旅人,たびびとであり寄留者,きりゅうしゃであることを、自,みずから言,いいあらわした。","tok":[["これ"],["ら"],["の"],["人","ひと"],["は"],["みな"],["、"],["信仰","しんこう"],["を"],["いだいて"],["死んだ","しんだ"],["。"],["まだ"],["約束","やくそく"],["の"],["もの"],["は"],["受けて","うけて"],["いなかった"],["が"],["、"],["はるか"],["に"],["それ"],["を"],["望み見て","のぞみみて"],["喜こび","よろこび"],["、"],["そして"],["、"],["地上","ちじょう"],["で"],["は"],["旅人","たびびと"],["で"],["あり"],["寄留者","きりゅうしゃ"],["で"],["ある"],["こと"],["を"],["、"],["自から","みずから"],["言いあらわした","いいあらわした"],["。"]]},{"verse":14,"text":"そう言,いいあらわすことによって、彼,かれらがふるさとを求,もとめていることを示,しめしている。","tok":[["そう"],["言いあらわす","いいあらわす"],["こと"],["によって"],["、"],["彼","かれ"],["ら"],["が"],["ふるさと"],["を"],["求めて","もとめて"],["いる"],["こと"],["を"],["示めして","しめして"],["いる"],["。"]]},{"verse":15,"text":"もしその出,でてきた所,ところのことを考,かんがえていたなら、帰,かえる機会,きかいはあったであろう。","tok":[["もし"],["その"],["出て","でて"],["きた"],["所","ところ"],["の"],["こと"],["を"],["考","かんがえ"],["て"],["いたなら"],["、"],["帰える","かえる"],["機会","きかい"],["は"],["あったで"],["あろう"],["。"]]},{"verse":16,"text":"しかし実際,じっさい、彼,かれらが望,のぞんでいたのは、もっと良,よい、天,てんにあるふるさとであった。だから神,かみは、彼,かれらの神,かみと呼,よばれても、それを恥,はじとはされなかった。事実,じじつ、神,かみは彼,かれらのために、都,みやこを用意,よういされていたのである。","tok":[["しかし"],["実際","じっさい"],["、"],["彼","かれ"],["ら"],["が"],["望んで","のぞんで"],["いた"],["の"],["は"],["、"],["もっと"],["良い","よい"],["、"],["天","てん"],["に"],["ある"],["ふるさと"],["で"],["あった"],["。"],["だ"],["から"],["神","かみ"],["は"],["、"],["彼","かれ"],["ら"],["の"],["神","かみ"],["と"],["呼ばれて","よばれて"],["も"],["、"],["それ"],["を"],["恥","はじ"],["と"],["は"],["されなかった"],["。"],["事実","じじつ"],["、"],["神","かみ"],["は"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["、"],["都","みやこ"],["を"],["用意","ようい"],["されて"],["いた"],["ので"],["ある"],["。"]]},{"verse":17,"text":"信仰,しんこうによって、アブラハムは、試錬,しれんを受,うけたとき、イサクをささげた。すなわち、約束,やくそくを受,うけていた彼,かれが、そのひとり子,こをささげたのである。","tok":[["信仰","しんこう"],["によって"],["、"],["アブラハム"],["は"],["、"],["試錬","しれん"],["を"],["受た","うけた"],["とき"],["、"],["イサク"],["を"],["ささげた"],["。"],["すなわち"],["、"],["約束","やくそく"],["を"],["受て","うけて"],["いた"],["彼","かれ"],["が"],["、"],["その"],["ひとり"],["子","こ"],["を"],["ささげた"],["ので"],["ある"],["。"]]},{"verse":18,"text":"この子,こについては、「イサクから出,でる者,ものが、あなたの子孫,しそんと呼,よばれるであろう」と言,いわれていたのであった。","tok":[["この"],["子","こ"],["について"],["は"],["、"],["「"],["イサク"],["から"],["出る","でる"],["者","もの"],["が"],["、"],["あなた"],["の"],["子孫","しそん"],["と"],["呼ばれるで","よばれるで"],["あろう"],["」"],["と"],["言われて","いわれて"],["いた"],["ので"],["あった"],["。"]]},{"verse":19,"text":"彼,かれは、神,かみが死人,しにんの中,なかから人,ひとをよみがえらせる力,ちからがある、と信,しんじていたのである。だから彼,かれは、いわば、イサクを生,いきかえして渡,わたされたわけである。","tok":[["彼","かれ"],["は"],["、"],["神","かみ"],["が"],["死人","しにん"],["の"],["中","なか"],["から"],["人","ひと"],["を"],["よみがえらせる"],["力","ちから"],["が"],["ある"],["、"],["と"],["信じて","しんじて"],["いた"],["ので"],["ある"],["。"],["だ"],["から"],["彼","かれ"],["は"],["、"],["いわば"],["、"],["イサク"],["を"],["生き","いき"],["かえして"],["渡された","わたされた"],["わけ"],["で"],["ある"],["。"]]},{"verse":20,"text":"信仰,しんこうによって、イサクは、きたるべきことについて、ヤコブとエサウとを祝福,しゅくふくした。","tok":[["信仰","しんこう"],["によって"],["、"],["イサク"],["は"],["、"],["きたるべき"],["こと"],["について"],["、"],["ヤコブ"],["と"],["エサウ"],["と"],["を"],["祝福","しゅくふく"],["した"],["。"]]},{"verse":21,"text":"信仰,しんこうによって、ヤコブは死,しのまぎわに、ヨセフの子,こらをひとりびとり祝福,しゅくふくし、そしてそのつえのかしらによりかかって礼拝,れいはいした。","tok":[["信仰","しんこう"],["によって"],["、"],["ヤコブ"],["は"],["死","し"],["の"],["まぎわ"],["に"],["、"],["ヨセフ"],["の"],["子","こ"],["ら"],["を"],["ひとりびとり"],["祝福","しゅくふく"],["し"],["、"],["そして"],["その"],["つえ"],["の"],["かしら"],["に"],["より"],["かかって"],["礼拝","れいはい"],["した"],["。"]]},{"verse":22,"text":"信仰,しんこうによって、ヨセフはその臨終,りんじゅうに、イスラエルの子,こらの出,でて行,ゆくことを思,おもい、自分,じぶんの骨,ほねのことについてさしずした。","tok":[["信仰","しんこう"],["によって"],["、"],["ヨセフ"],["は"],["その"],["臨終","りんじゅう"],["に"],["、"],["イスラエル"],["の"],["子","こ"],["ら"],["の"],["出て","でて"],["行","ゆくこと"],["を"],["思い","おもい"],["、"],["自分","じぶん"],["の"],["骨","ほね"],["の"],["こと"],["について"],["さしず"],["した"],["。"]]},{"verse":23,"text":"信仰,しんこうによって、モーセの生,うまれたとき、両親,りょうしんは、三か月,げつのあいだ彼,かれを隠,かくした。それは、彼,かれらが子供,こどものうるわしいのを見,みたからである。彼,かれらはまた、王,おうの命令,めいれいをも恐,おそれなかった。","tok":[["信仰","しんこう"],["によって"],["、"],["モーセ"],["の"],["生まれた","うまれた"],["とき"],["、"],["両親","りょうしん"],["は"],["、"],["三","さん"],["か月","かげつ"],["の"],["あいだ"],["彼","かれ"],["を"],["隠した","かくした"],["。"],["それ"],["は"],["、"],["彼","かれ"],["ら"],["が"],["子供","こども"],["の"],["うるわしい"],["の"],["を"],["見た","みた"],["から"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["また"],["、"],["王","おう"],["の"],["命令","めいれい"],["を"],["も"],["恐れなかった","おそれなかった"],["。"]]},{"verse":24,"text":"信仰,しんこうによって、モーセは、成人,せいじんしたとき、パロの娘,むすめの子,こと言,いわれることを拒,こばみ、","tok":[["信仰","しんこう"],["によって"],["、"],["モーセ"],["は"],["、"],["成人","せいじん"],["した"],["とき"],["、"],["パロ"],["の"],["娘","むすめ"],["の"],["子","こ"],["と"],["言われる","いわれる"],["こと"],["を"],["拒み","こばみ"],["、"]]},{"verse":25,"text":"罪,つみのはかない歓楽,かんらくにふけるよりは、むしろ神,かみの民,たみと共,ともに虐待,ぎゃくたいされることを選,えらび、","tok":[["罪","つみ"],["の"],["はかない"],["歓楽","かんらく"],["に"],["ふける"],["より"],["は"],["、"],["むしろ"],["神","かみ"],["の"],["民","たみ"],["と"],["共","とも"],["に"],["虐待","ぎゃくたい"],["される"],["こと"],["を"],["選ら","えら"],["び"],["、"]]},{"verse":26,"text":"キリストのゆえに受,うけるそしりを、エジプトの宝,たからにまさる富,とみと考,かんがえた。それは、彼,かれが報,むくいを望,のぞみ見,みていたからである。","tok":[["キリスト"],["の"],["ゆえ"],["に"],["受る","うける"],["そ"],["しり"],["を"],["、"],["エジプト"],["の"],["宝","たから"],["に"],["まさる"],["富","とみ"],["と"],["考","かんがえ"],["た"],["。"],["それ"],["は"],["、"],["彼","かれ"],["が"],["報い","むくい"],["を"],["望み見て","のぞみみて"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":27,"text":"信仰,しんこうによって、彼,かれは王,おうの憤,いきどおりをも恐,おそれず、エジプトを立,たち去,さった。彼,かれは、見,みえないかたを見,みているようにして、忍,しのびとおした。","tok":[["信仰","しんこう"],["によって"],["、"],["彼","かれ"],["は"],["王","おう"],["の"],["憤り","いきどおり"],["を"],["も"],["恐れず","おそれず"],["、"],["エジプト"],["を"],["立ち","たち"],["去た","さった"],["。"],["彼","かれ"],["は"],["、"],["見えない","みえない"],["かた"],["を"],["見て","みて"],["いる"],["よう"],["に"],["して"],["、"],["忍び","しのび"],["と"],["おした"],["。"]]},{"verse":28,"text":"信仰,しんこうによって、滅,ほろぼす者,ものが、長子,ちょうしらに手,てを下,くだすことのないように、彼,かれは過越,すぎこしを行,おこない血,ちを塗,ぬった。","tok":[["信仰","しんこう"],["によって"],["、"],["滅ぼす","ほろぼす"],["者","もの"],["が"],["、"],["長子","ちょうし"],["ら"],["に"],["手","て"],["を"],["下す","くだす"],["こと"],["の"],["ない"],["よう"],["に"],["、"],["彼","かれ"],["は"],["過越","すぎこし"],["を"],["行ない","おこない"],["血","ち"],["を"],["塗った","ぬった"],["。"]]},{"verse":29,"text":"信仰,しんこうによって、人々,ひとびとは紅海,こうかいをかわいた土地,とちをとおるように渡,わたったが、同,おなじことを企,くわだてたエジプト人,じんはおぼれ死,しんだ。","tok":[["信仰","しんこう"],["によって"],["、"],["人々","ひとびと"],["は"],["紅海","こうかい"],["を"],["かわいた"],["土地","とち"],["を"],["とおる"],["よう"],["に"],["渡った","わたった"],["が"],["、"],["同じ","おなじ"],["こと"],["を"],["企だてた","くわだてた"],["エジプト"],["人","じん"],["は"],["おぼれ死んだ","おぼれしんだ"],["。"]]},{"verse":30,"text":"信仰,しんこうによって、エリコの城壁,じょうへきは、七日,なぬかにわたってまわったために、くずれおちた。","tok":[["信仰","しんこう"],["によって"],["、"],["エリコ"],["の"],["城壁","じょうへき"],["は"],["、"],["七","なな"],["日","にち"],["に"],["わたって"],["まわった"],["ため"],["に"],["、"],["くずれおちた"],["。"]]},{"verse":31,"text":"信仰,しんこうによって、遊女,ゆうじょラハブは、探,さぐりにきた者,ものたちをおだやかに迎,むかえたので、不,ふ従順,じゅうじゅんな者,ものどもと一緒,いっしょに滅,ほろびることはなかった。","tok":[["信仰","しんこう"],["によって"],["、"],["遊女","ゆうじょ"],["ラハブ"],["は"],["、"],["探ぐり","さぐり"],["に"],["きた"],["者","もの"],["たち"],["を"],["おだやか"],["に"],["迎","むかえ"],["た"],["ので"],["、"],["不","ふ"],["従順","じゅうじゅん"],["な"],["者","もの"],["ども"],["と"],["一緒","いっしょ"],["に"],["滅びる","ほろびる"],["こと"],["は"],["なかった"],["。"]]},{"verse":32,"text":"このほか、何,なにを言,いおうか。もしギデオン、バラク、サムソン、エフタ、ダビデ、サムエル及,および預言者,よげんしゃたちについて語,かたり出,だすなら、時間,じかんが足,たりないであろう。","tok":[["この"],["ほか"],["、"],["何に","なに"],["を"],["言おう","いおう"],["か"],["。"],["もし"],["ギデオン"],["、"],["バラク"],["、"],["サムソン"],["、"],["エフタ"],["、"],["ダビデ"],["、"],["サムエル"],["及","および"],["預言者","よげんしゃ"],["たち"],["について"],["語り","かたり"],["出すなら","だすなら"],["、"],["時間","じかん"],["が"],["足りないで","たりないで"],["あろう"],["。"]]},{"verse":33,"text":"彼,かれらは信仰,しんこうによって、国々,くにぐにを征服,せいふくし、義,ぎを行,おこない、約束,やくそくのものを受,うけ、ししの口,くちをふさぎ、","tok":[["彼","かれ"],["ら"],["は"],["信仰","しんこう"],["によって"],["、"],["国々","くにぐに"],["を"],["征服","せいふく"],["し"],["、"],["義","ぎ"],["を"],["行ない","おこない"],["、"],["約束","やくそく"],["の"],["もの"],["を"],["受け","うけ"],["、"],["しし"],["の"],["口","くち"],["を"],["ふさぎ"],["、"]]},{"verse":34,"text":"火,ひの勢,いきおいを消,けし、つるぎの刃,はをのがれ、弱,よわいものは強,つよくされ、戦,たたかいの勇者,ゆうしゃとなり、他国,たこくの軍,ぐんを退,しりぞかせた。","tok":[["火","ひ"],["の"],["勢い","いきおい"],["を"],["消し","けし"],["、"],["つるぎ"],["の"],["刃","は"],["を"],["のがれ"],["、"],["弱い","よわい"],["もの"],["は"],["強く","つよく"],["され"],["、"],["戦い","たたかい"],["の"],["勇者","ゆうしゃ"],["と"],["なり"],["、"],["他国","たこく"],["の"],["軍","ぐん"],["を"],["退ぞかせた","しりぞかせた"],["。"]]},{"verse":35,"text":"女,おんなたちは、その死者,ししゃたちをよみがえらさせてもらった。ほかの者,ものは、更,さらにまさったいのちによみがえるために、拷問,ごうもんの苦,くるしみに甘,あまんじ、放免,ほうめんされることを願,ねがわなかった。","tok":[["女","おんな"],["たち"],["は"],["、"],["その"],["死者","ししゃ"],["たち"],["を"],["よみがえらさせて"],["もらった"],["。"],["ほか"],["の"],["者","もの"],["は"],["、"],["更に","さらに"],["まさった"],["いのち"],["に"],["よみがえる"],["ため"],["に"],["、"],["拷問","ごうもん"],["の"],["苦しみ","くるしみ"],["に"],["甘んじ","あまんじ"],["、"],["放免","ほうめん"],["される"],["こと"],["を"],["願わなかった","ねがわなかった"],["。"]]},{"verse":36,"text":"なおほかの者,ものたちは、あざけられ、むち打,うたれ、しばり上,あげられ、投獄,とうごくされるほどのめに会,あった。","tok":[["なお"],["ほか"],["の"],["者","もの"],["たち"],["は"],["、"],["あざけられ"],["、"],["むち打たれ","むちうたれ"],["、"],["しばり上げられ","しばりあげられ"],["、"],["投獄","とうごく"],["される"],["ほど"],["の"],["め"],["に"],["会った","あった"],["。"]]},{"verse":37,"text":"あるいは、石,いしで打,うたれ、さいなまれ、のこぎりで引,ひかれ、つるぎで切,きり殺,ころされ、羊,ひつじの皮,かわや、やぎの皮,かわを着,きて歩,あるきまわり、無一物,むいちもつになり、悩,なやまされ、苦,くるしめられ、","tok":[["あるいは"],["、"],["石","いし"],["で"],["打たれ","うたれ"],["、"],["さいなまれ"],["、"],["のこぎり"],["で"],["引かれ","ひかれ"],["、"],["つるぎ"],["で"],["切り殺され","きりころされ"],["、"],["羊","ひつじ"],["の"],["皮","かわ"],["や"],["、"],["やぎ"],["の"],["皮","かわ"],["を"],["着て","きて"],["歩き","あるき"],["まわり"],["、"],["無一物","むいちもつ"],["に"],["なり"],["、"],["悩され","なやまされ"],["、"],["苦しめられ","くるしめられ"],["、"]]},{"verse":38,"text":"（この世,よは彼,かれらの住,すむ所,ところではなかった）、荒野,あらのと山,やまの中,なかと岩,いわの穴,あなと土,つちの穴,あなとを、さまよい続,つづけた。","tok":[["（"],["この世","このよ"],["は"],["彼","かれ"],["ら"],["の"],["住む","すむ"],["所","ところ"],["で"],["は"],["なかった"],["）"],["、"],["荒野","あら"],["の"],["と"],["山","やま"],["の"],["中","なか"],["と"],["岩","いわ"],["の"],["穴","あな"],["と"],["土","つち"],["の"],["穴","あな"],["と"],["を"],["、"],["さまよい"],["続けた","つづけた"],["。"]]},{"verse":39,"text":"さて、これらの人々,ひとびとはみな、信仰,しんこうによってあかしされたが、約束,やくそくのものは受,うけなかった。","tok":[["さて"],["、"],["これ"],["ら"],["の"],["人々","ひとびと"],["は"],["みな"],["、"],["信仰","しんこう"],["によって"],["あかし"],["された"],["が"],["、"],["約束","やくそく"],["の"],["もの"],["は"],["受けなかった","うけなかった"],["。"]]},{"verse":40,"text":"神,かみはわたしたちのために、さらに良,よいものをあらかじめ備,そなえて下,くださっているので、わたしたちをほかにしては彼,かれらが全,まっとうされることはない。","tok":[["神","かみ"],["は"],["わたしたち"],["の"],["ため"],["に"],["、"],["さらに"],["良い","よい"],["もの"],["を"],["あらかじめ"],["備","そなえ"],["て"],["下さって","くださって"],["いる"],["ので"],["、"],["わたしたち"],["を"],["ほか"],["に"],["して"],["は"],["彼","かれ"],["ら"],["が"],["全う","まっとう"],["される"],["こと"],["は"],["ない"],["。"]]}]
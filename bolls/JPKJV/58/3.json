[{"verse":1,"text":"そこで、天,てんの召,めしにあずかっている聖,せいなる兄弟,きょうだいたちよ。あなたがたは、わたしたちが告白,こくはくする信仰,しんこうの使者,ししゃまた大祭司,だいさいしなるイエスを、思,おもいみるべきである。","tok":[["そこ"],["で"],["、"],["天","てん"],["の"],["召","めし"],["に"],["あずかって"],["いる"],["聖","せい"],["なる"],["兄弟","きょうだい"],["たち"],["よ"],["。"],["あなた"],["がた"],["は"],["、"],["わたしたち"],["が"],["告白","こくはく"],["する"],["信仰","しんこう"],["の"],["使者","ししゃ"],["また"],["大","だい"],["祭司","さいし"],["なる"],["イエス"],["を"],["、"],["思いみるべきで","おもいみるべきで"],["ある"],["。"]]},{"verse":2,"text":"彼,かれは、モーセが神,かみの家,いえの全体,ぜんたいに対,たいして忠実,ちゅうじつであったように、自分,じぶんを立,たてたかたに対,たいして忠実,ちゅうじつであられた。","tok":[["彼","かれ"],["は"],["、"],["モーセ"],["が"],["神","かみ"],["の"],["家","いえ"],["の"],["全体","ぜんたい"],["に対して","にたいして"],["忠実","ちゅうじつ"],["で"],["あった"],["よう"],["に"],["、"],["自分","じぶん"],["を"],["立てた","たてた"],["かた"],["に対して","にたいして"],["忠実","ちゅうじつ"],["で"],["あられた"],["。"]]},{"verse":3,"text":"おおよそ、家,いえを造,つくる者,ものが家,いえそのものよりもさらに尊,たっとばれるように、彼,かれは、モーセ以上,いじょうに、大,おおいなる光栄,こうえいを受,うけるにふさわしい者,ものとされたのである。","tok":[["おおよそ"],["、"],["家","いえ"],["を"],["造る","つくる"],["者","もの"],["が"],["家","いえ"],["その"],["もの"],["より"],["も"],["さらに"],["尊","たっ"],["と"],["ばれる"],["よう"],["に"],["、"],["彼","かれ"],["は"],["、"],["モーセ"],["以上","いじょう"],["に"],["、"],["大いなる","おおいなる"],["光栄","こうえい"],["を"],["受る","うける"],["に"],["ふさわしい"],["者","もの"],["と"],["された"],["ので"],["ある"],["。"]]},{"verse":4,"text":"家,いえはすべて、だれかによって造,つくられるものであるが、すべてのものを造,つくられたかたは、神,かみである。","tok":[["家","いえ"],["は"],["すべて"],["、"],["だれ"],["か"],["によって"],["造られる","つくられる"],["もの"],["で"],["ある"],["が"],["、"],["すべて"],["の"],["もの"],["を"],["造られた","つくられた"],["かた"],["は"],["、"],["神","かみ"],["で"],["ある"],["。"]]},{"verse":5,"text":"さて、モーセは、後,のちに語,かたらるべき事,ことがらについてあかしをするために、仕,つかえる者,ものとして、神,かみの家,いえの全体,ぜんたいに対,たいして忠実,ちゅうじつであったが、","tok":[["さて"],["、"],["モーセ"],["は"],["、"],["後","のち"],["に"],["語らるべき","かたらるべき"],["事がら","ことがら"],["について"],["あかし"],["を"],["する"],["ため"],["に"],["、"],["仕える","つかえる"],["者","もの"],["として"],["、"],["神","かみ"],["の"],["家","いえ"],["の"],["全体","ぜんたい"],["に対して","にたいして"],["忠実","ちゅうじつ"],["で"],["あった"],["が"],["、"]]},{"verse":6,"text":"キリストは御子,みことして、神,かみの家,いえを治,おさめるのに忠実,ちゅうじつであられたのである。もしわたしたちが、望,のぞみの確信,かくしんと誇,ほこりとを最後,さいごまでしっかりと持,もち続,つづけるなら、わたしたちは神,かみの家,いえなのである。","tok":[["キリスト"],["は"],["御子","みこ"],["として"],["、"],["神","かみ"],["の"],["家","いえ"],["を"],["治める","おさめる"],["のに"],["忠実","ちゅうじつ"],["で"],["あられた"],["ので"],["ある"],["。"],["もし"],["わたしたち"],["が"],["、"],["望み","のぞみ"],["の"],["確信","かくしん"],["と"],["誇","ほこり"],["と"],["を"],["最後","さいご"],["まで"],["しっかり"],["と"],["持","もち"],["続けるなら","つづけるなら"],["、"],["わたしたち"],["は"],["神","かみ"],["の"],["家","いえ"],["な"],["ので"],["ある"],["。"]]},{"verse":7,"text":"だから、聖霊,せいれいが言,いっているように、「きょう、あなたがたがみ声,こえを聞,きいたなら、","tok":[["だ"],["から"],["、"],["聖霊","せいれい"],["が"],["言って","いって"],["いる"],["よう"],["に"],["、"],["「"],["きょう"],["、"],["あなた"],["がた"],["が"],["み声","みこえ"],["を"],["聞いたなら","きいたなら"],["、"]]},{"verse":8,"text":"荒野,あらのにおける試錬,しれんの日,ひに、神,かみにそむいた時,ときのように、あなたがたの心,こころを、かたくなにしてはいけない。","tok":[["荒野","あら"],["のに"],["おける"],["試錬","しれん"],["の"],["日","ひ"],["に"],["、"],["神","かみ"],["に"],["そむいた"],["時","とき"],["の"],["よう"],["に"],["、"],["あなた"],["がた"],["の"],["心","こころ"],["を"],["、"],["かたくな"],["に"],["して"],["は"],["いけない"],["。"]]},{"verse":9,"text":"あなたがたの先祖,せんぞたちは、そこでわたしを試,こころみためし、","tok":[["あなた"],["がた"],["の"],["先祖","せんぞ"],["たち"],["は"],["、"],["そこ"],["で"],["わたし"],["を"],["試み","こころみ"],["ためし"],["、"]]},{"verse":10,"text":"しかも、四十年,ねんの間,あいだわたしのわざを見,みたのである。だから、わたしはその時代,じだいの人々,ひとびとに対,たいして、いきどおって言,いった、彼,かれらの心,こころは、いつも迷,まよっており、彼,かれらは、わたしの道,みちを認,みとめなかった。","tok":[["しかも"],["、"],["四十","よんじゅう"],["年","ねん"],["の"],["間","あいだ"],["わたし"],["の"],["わざ"],["を"],["見た","みた"],["ので"],["ある"],["。"],["だ"],["から"],["、"],["わたし"],["は"],["その"],["時代","じだい"],["の"],["人々","ひとびと"],["に対して","にたいして"],["、"],["いきどおって"],["言った","いった"],["、"],["彼","かれ"],["ら"],["の"],["心","こころ"],["は"],["、"],["いつも"],["迷って","まよって"],["おり"],["、"],["彼","かれ"],["ら"],["は"],["、"],["わたし"],["の"],["道","みち"],["を"],["認めなかった","みとめなかった"],["。"]]},{"verse":11,"text":"そこで、わたしは怒,いかって、彼,かれらをわたしの安息,あんそくにはいらせることはしない、と誓,ちかった」。","tok":[["そこ"],["で"],["、"],["わたし"],["は"],["怒","い"],["か"],["って"],["、"],["彼","かれ"],["ら"],["を"],["わたし"],["の"],["安息","あんそく"],["に"],["はいらせる"],["こと"],["は"],["しない"],["、"],["と"],["誓った","ちかった"],["」"],["。"]]},{"verse":12,"text":"兄弟,きょうだいたちよ。気,きをつけなさい。あなたがたの中,なかには、あるいは、不,ふ信仰,しんこうな悪,わるい心,こころをいだいて、生,いける神,かみから離,はなれ去,さる者,ものがあるかも知,しれない。","tok":[["兄弟","きょうだい"],["たち"],["よ"],["。"],["気","き"],["を"],["つけ"],["なさい"],["。"],["あなた"],["がた"],["の"],["中","なか"],["に"],["は"],["、"],["あるいは"],["、"],["不","ふ"],["信仰","しんこう"],["な"],["悪い","わるい"],["心","こころ"],["を"],["いだいて"],["、"],["生ける","いける"],["神","かみ"],["から"],["離れ去る","はなれさる"],["者","もの"],["が"],["ある"],["か"],["も"],["知れない","しれない"],["。"]]},{"verse":13,"text":"あなたがたの中,なかに、罪,つみの惑,まどわしに陥,おちいって、心,こころをかたくなにする者,ものがないように、「きょう」といううちに、日々,ひび、互,たがいに励,はげまし合,あいなさい。","tok":[["あなた"],["がた"],["の"],["中","なか"],["に"],["、"],["罪","つみ"],["の"],["惑わし","まどわし"],["に"],["陥て","おちいって"],["、"],["心","こころ"],["を"],["かたくな"],["に"],["する"],["者","もの"],["が"],["ない"],["よう"],["に"],["、"],["「"],["きょう"],["」"],["と"],["いう"],["うち"],["に"],["、"],["日々","ひび"],["、"],["互","たがい"],["に"],["励まし合い","はげましあい"],["なさい"],["。"]]},{"verse":14,"text":"もし最初,さいしょの確信,かくしんを、最後,さいごまでしっかりと持,もち続,つづけるならば、わたしたちはキリストにあずかる者,ものとなるのである。","tok":[["もし"],["最初","さいしょ"],["の"],["確信","かくしん"],["を"],["、"],["最後","さいご"],["まで"],["しっかり"],["と"],["持","もち"],["続けるならば","つづけるならば"],["、"],["わたしたち"],["は"],["キリスト"],["に"],["あずかる"],["者","もの"],["と"],["なる"],["ので"],["ある"],["。"]]},{"verse":15,"text":"それについて、こう言,いわれている、「きょう、み声,こえを聞,きいたなら、神,かみにそむいた時,ときのように、あなたがたの心,こころを、かたくなにしてはいけない」。","tok":[["それ"],["について"],["、"],["こう"],["言われて","いわれて"],["いる"],["、"],["「"],["きょう"],["、"],["み声","みこえ"],["を"],["聞いたなら","きいたなら"],["、"],["神","かみ"],["に"],["そむいた"],["時","とき"],["の"],["よう"],["に"],["、"],["あなた"],["がた"],["の"],["心","こころ"],["を"],["、"],["かたくな"],["に"],["して"],["は"],["いけない"],["」"],["。"]]},{"verse":16,"text":"すると、聞,きいたのにそむいたのは、だれであったのか。モーセに率,ひきいられて、エジプトから出,でて行,いったすべての人々,ひとびとではなかったか。","tok":[["する"],["と"],["、"],["聞いた","きいた"],["のに"],["そむいた"],["の"],["は"],["、"],["だれ"],["で"],["あった"],["の"],["か"],["。"],["モーセ"],["に"],["率いられて","ひきいられて"],["、"],["エジプト"],["から"],["出て","でて"],["行った","いった"],["すべて"],["の"],["人々","ひとびと"],["で"],["は"],["なかった"],["か"],["。"]]},{"verse":17,"text":"また、四十年,ねんの間,あいだ、神,かみがいきどおられたのはだれに対,たいしてであったか。罪,つみを犯,おかして、その死,しかばねを荒野,あらのにさらした者,ものたちに対,たいしてではなかったか。","tok":[["また"],["、"],["四十","よんじゅう"],["年","ねん"],["の"],["間","あいだ"],["、"],["神","かみ"],["が"],["いきどおられた"],["の"],["は"],["だれ"],["に対して","にたいして"],["で"],["あった"],["か"],["。"],["罪","つみ"],["を"],["犯して","おかして"],["、"],["その"],["死","し"],["かばね"],["を"],["荒野","あらの"],["に"],["さらした"],["者","もの"],["たち"],["に対して","にたいして"],["で"],["は"],["なかった"],["か"],["。"]]},{"verse":18,"text":"また、神,かみが、わたしの安息,あんそくに、はいらせることはしない、と誓,ちかわれたのは、だれに向,むかってであったか。不,ふ従順,じゅうじゅんな者,ものに向,むかってではなかったか。","tok":[["また"],["、"],["神","かみ"],["が"],["、"],["わたし"],["の"],["安息","あんそく"],["に"],["、"],["はいらせる"],["こと"],["は"],["しない"],["、"],["と"],["誓われた","ちかわれた"],["の"],["は"],["、"],["だれ"],["に"],["向かって","むかって"],["で"],["あった"],["か"],["。"],["不","ふ"],["従順","じゅうじゅん"],["な"],["者","もの"],["に"],["向かって","むかって"],["で"],["は"],["なかった"],["か"],["。"]]},{"verse":19,"text":"こうして、彼,かれらがはいることのできなかったのは、不,ふ信仰,しんこうのゆえであることがわかる。","tok":[["こう"],["して"],["、"],["彼","かれ"],["ら"],["が"],["はいる"],["こと"],["の"],["できなかった"],["の"],["は"],["、"],["不","ふ"],["信仰","しんこう"],["の"],["ゆえ"],["で"],["ある"],["こと"],["が"],["わかる"],["。"]]}]
[{"verse":1,"text":"自由,じゆうを得,えさせるために、キリストはわたしたちを解放,かいほうして下,くださったのである。だから、堅,かたく立,たって、二度,どと奴隷,どれいのくびきにつながれてはならない。","tok":[["自由","じゆう"],["を"],["得させる","えさせる"],["ため"],["に"],["、"],["キリスト"],["は"],["わたしたち"],["を"],["解放","かいほう"],["して"],["下さった","くださった"],["ので"],["ある"],["。"],["だ"],["から"],["、"],["堅く","かたく"],["立って","たって"],["、"],["二","に"],["度","ど"],["と"],["奴隷","どれい"],["の"],["くびき"],["に"],["つながれて"],["は"],["ならない"],["。"]]},{"verse":2,"text":"見,みよ、このパウロがあなたがたに言,いう。もし割礼,かつれいを受,うけるなら、キリストはあなたがたに用,ようのないものになろう。","tok":[["見よ","みよ"],["、"],["この"],["パウロ"],["が"],["あなた"],["がた"],["に"],["言う","いう"],["。"],["もし"],["割礼","かつれい"],["を"],["受るなら","うけるなら"],["、"],["キリスト"],["は"],["あなた"],["が"],["たに用","たによう"],["の"],["ない"],["もの"],["に"],["なろう"],["。"]]},{"verse":3,"text":"割礼,かつれいを受,うけようとするすべての人,ひとたちに、もう一度,ど言,いっておく。そういう人,ひとたちは、律法,りっぽうの全部,ぜんぶを行,おこなう義務,ぎむがある。","tok":[["割礼","かつれい"],["を"],["受よう","うけよう"],["と"],["する"],["すべて"],["の"],["人","ひと"],["たち"],["に"],["、"],["もう"],["一度","ど"],["言って","いって"],["おく"],["。"],["そう"],["いう"],["人","ひと"],["たち"],["は"],["、"],["律法","りっぽう"],["の"],["全部","ぜんぶ"],["を"],["行なう","おこなう"],["義務","ぎむ"],["が"],["ある"],["。"]]},{"verse":4,"text":"律法,りっぽうによって義,ぎとされようとするあなたがたは、キリストから離,はなれてしまっている。恵,めぐみから落,おちている。","tok":[["律法","りっぽう"],["によって"],["義","ぎ"],["と"],["されよう"],["と"],["する"],["あなた"],["がた"],["は"],["、"],["キリスト"],["から"],["離れて","はなれて"],["しまって"],["いる"],["。"],["恵","めぐみ"],["から"],["落","おち"],["て"],["いる"],["。"]]},{"verse":5,"text":"わたしたちは、御霊,みたまの助,たすけにより、信仰,しんこうによって義,ぎとされる望,のぞみを強,つよくいだいている。","tok":[["わたしたち"],["は"],["、"],["御霊","みたま"],["の"],["助け","たすけ"],["に"],["より"],["、"],["信仰","しんこう"],["によって"],["義","ぎ"],["と"],["される"],["望み","のぞみ"],["を"],["強く","つよく"],["いだいて"],["いる"],["。"]]},{"verse":6,"text":"キリスト・イエスにあっては、割礼,かつれいがあってもなくても、問題,もんだいではない。尊,たっといのは、愛,あいによって働,はたらく信仰,しんこうだけである。","tok":[["キリスト"],["・"],["イエス"],["に"],["あって"],["は"],["、"],["割礼","かつれい"],["が"],["あって"],["も"],["なくて"],["も"],["、"],["問題","もんだい"],["で"],["は"],["ない"],["。"],["尊","たっとい"],["の"],["は"],["、"],["愛","あい"],["によって"],["働く","はたらく"],["信仰","しんこう"],["だけ"],["で"],["ある"],["。"]]},{"verse":7,"text":"あなたがたはよく走,はしり続,つづけてきたのに、だれが邪魔,じゃまをして、真理,しんりにそむかせたのか。","tok":[["あなた"],["がた"],["は"],["よく"],["走り","はしり"],["続けて","つづけて"],["きた"],["のに"],["、"],["だれ"],["が"],["邪魔","じゃま"],["を"],["して"],["、"],["真理","しんり"],["に"],["そむかせた"],["の"],["か"],["。"]]},{"verse":8,"text":"そのような勧誘,かんゆうは、あなたがたを召,めされたかたから出,でたものではない。","tok":[["その"],["よう"],["な"],["勧誘","かんゆう"],["は"],["、"],["あなた"],["がた"],["を"],["召された","めされた"],["かた"],["から"],["出た","でた"],["もの"],["で"],["は"],["ない"],["。"]]},{"verse":9,"text":"少,すこしのパン種,たねでも、粉,こなのかたまり全体,ぜんたいをふくらませる。","tok":[["少し","すこし"],["の"],["パン種","ぱんたね"],["で"],["も"],["、"],["粉","こな"],["の"],["かたまり"],["全体","ぜんたい"],["を"],["ふくらませる"],["。"]]},{"verse":10,"text":"あなたがたはいささかもわたしと違,ちがった思,おもいをいだくことはないと、主,しゅにあって信頼,しんらいしている。しかし、あなたがたを動揺,どうようさせている者,ものは、それがだれであろうと、さばきを受,うけるであろう。","tok":[["あなた"],["がた"],["は"],["いささか"],["も"],["わたし"],["と"],["違った","ちがった"],["思い","おもい"],["を"],["いだく"],["こと"],["は"],["ない"],["と"],["、"],["主に","しゅに"],["あって"],["信頼","しんらい"],["して"],["いる"],["。"],["しかし"],["、"],["あなた"],["がた"],["を"],["動揺","どうよう"],["させて"],["いる"],["者","もの"],["は"],["、"],["それ"],["が"],["だれ"],["で"],["あろう"],["と"],["、"],["さばき"],["を"],["受るで","うけるで"],["あろう"],["。"]]},{"verse":11,"text":"兄弟,きょうだいたちよ。わたしがもし今,いまでも割礼,かつれいを宣,のべ伝,つたえていたら、どうして、いまなお迫害,はくがいされるはずがあろうか。そうしていたら、十字架,じゅうじかのつまずきは、なくなっているであろう。","tok":[["兄弟","きょうだい"],["たち"],["よ"],["。"],["わたし"],["が"],["もし"],["今","いま"],["で"],["も"],["割礼","かつれい"],["を"],["宣べ伝えて","のべつたえて"],["いたら"],["、"],["どう"],["して"],["、"],["いま"],["なお"],["迫害","はくがい"],["される"],["はず"],["が"],["あろう"],["か"],["。"],["そう"],["して"],["いたら"],["、"],["十字架","じゅうじか"],["の"],["つまずき"],["は"],["、"],["なくなって"],["いるで"],["あろう"],["。"]]},{"verse":12,"text":"あなたがたの煽動,せんどう者,しゃどもは、自,みずから不具,ふぐになるがよかろう。","tok":[["あなた"],["がた"],["の"],["煽動者","せんどうしゃ"],["ども"],["は"],["、"],["自から","みずから"],["不具","ふぐ"],["に"],["なる"],["が"],["よかろう"],["。"]]},{"verse":13,"text":"兄弟,きょうだいたちよ。あなたがたが召,めされたのは、実,じつに、自由,じゆうを得,えるためである。ただ、その自由,じゆうを、肉,にくの働,はたらく機会,きかいとしないで、愛,あいをもって互,たがいに仕,つかえなさい。","tok":[["兄弟","きょうだい"],["たち"],["よ"],["。"],["あなた"],["がた"],["が"],["召された","めされた"],["の"],["は"],["、"],["実","じつ"],["に"],["、"],["自由","じゆう"],["を"],["得る","える"],["ため"],["で"],["ある"],["。"],["ただ"],["、"],["その"],["自由","じゆう"],["を"],["、"],["肉","にく"],["の"],["働く","はたらく"],["機会","きかい"],["と"],["しないで"],["、"],["愛","あい"],["を"],["もって"],["互","たがい"],["に"],["仕え","つかえ"],["なさい"],["。"]]},{"verse":14,"text":"律法,りっぽうの全体,ぜんたいは、「自分,じぶんを愛,あいするように、あなたの隣,となり人,ひとを愛,あいせよ」というこの一句,いっくに尽,つきるからである。","tok":[["律法","りっぽう"],["の"],["全体","ぜんたい"],["は"],["、"],["「"],["自分","じぶん"],["を"],["愛する","あいする"],["よう"],["に"],["、"],["あなた"],["の"],["隣人","となりひと"],["を"],["愛せよ","あいせよ"],["」"],["と"],["いう"],["この"],["一句","いっく"],["に"],["尽る","つきる"],["から"],["で"],["ある"],["。"]]},{"verse":15,"text":"気,きをつけるがよい。もし互,たがいにかみ合,あい、食,くい合,あっているなら、あなたがたは互,たがいに滅,ほろぼされてしまうだろう。","tok":[["気","き"],["を"],["つける"],["が"],["よい"],["。"],["もし"],["互","たがい"],["に"],["かみ合い","かみあい"],["、"],["食い合って","くいあって"],["いるなら"],["、"],["あなた"],["がた"],["は"],["互","たがい"],["に"],["滅ぼされて","ほろぼされて"],["しまうだろう"],["。"]]},{"verse":16,"text":"わたしは命,めいじる、御霊,みたまによって歩,あるきなさい。そうすれば、決,けっして肉,にくの欲,よくを満,みたすことはない。","tok":[["わたし"],["は"],["命じる","めいじる"],["、"],["御霊","みたま"],["によって"],["歩き","あるき"],["なさい"],["。"],["そう"],["すれば"],["、"],["決っして","けっして"],["肉","にく"],["の"],["欲","よく"],["を"],["満たす","みたす"],["こと"],["は"],["ない"],["。"]]},{"verse":17,"text":"なぜなら、肉,にくの欲,ほっするところは御霊,みたまに反,はんし、また御霊,みたまの欲,ほっするところは肉,にくに反,はんするからである。こうして、二つのものは互,たがいに相,あいさからい、その結果,けっか、あなたがたは自分,じぶんでしようと思,おもうことを、することができないようになる。","tok":[["なぜ"],["なら"],["、"],["肉","にく"],["の"],["欲する","ほっする"],["ところ"],["は"],["御霊","みたま"],["に"],["反し","はんし"],["、"],["また"],["御霊","みたま"],["の"],["欲する","ほっする"],["ところ"],["は"],["肉","にく"],["に"],["反する","はんする"],["から"],["で"],["ある"],["。"],["こう"],["して"],["、"],["二","ふた"],["つ"],["の"],["もの"],["は"],["互","たがい"],["に"],["相","あい"],["さからい"],["、"],["その"],["結果","けっか"],["、"],["あなた"],["がた"],["は"],["自分","じぶん"],["で"],["しよう"],["と"],["思う","おもう"],["こと"],["を"],["、"],["する"],["こと"],["が"],["できない"],["よう"],["に"],["なる"],["。"]]},{"verse":18,"text":"もしあなたがたが御霊,みたまに導,みちびかれるなら、律法,りっぽうの下,もとにはいない。","tok":[["もし"],["あなた"],["がた"],["が"],["御霊","みたま"],["に"],["導かれるなら","みちびかれるなら"],["、"],["律法","りっぽう"],["の"],["下","もと"],["に"],["は"],["いない"],["。"]]},{"verse":19,"text":"肉,にくの働,はたらきは明白,めいはくである。すなわち、不品行,ふひんこう、汚,けがれ、好色,こうしょく、","tok":[["肉","にく"],["の"],["働らき","はたらき"],["は"],["明白","めいはく"],["で"],["ある"],["。"],["すなわち"],["、"],["不品行","ふひんこう"],["、"],["汚","け"],["がれ"],["、"],["好色","こうしょく"],["、"]]},{"verse":20,"text":"偶像,ぐうぞう礼拝,れいはい、まじない、敵意,てきい、争,あらそい、そねみ、怒,いかり、党派心,とうはしん、分裂,ぶんれつ、分派,ぶんぱ、","tok":[["偶像","ぐうぞう"],["礼拝","れいはい"],["、"],["まじない"],["、"],["敵意","てきい"],["、"],["争い","あらそい"],["、"],["そねみ"],["、"],["怒り","いかり"],["、"],["党派心","とうはしん"],["、"],["分裂","ぶんれつ"],["、"],["分派","ぶんぱ"],["、"]]},{"verse":21,"text":"ねたみ、泥酔,でいすい、宴楽,えんらく、および、そのたぐいである。わたしは以前,いぜんも言,いったように、今,いまも前,まえもって言,いっておく。このようなことを行,おこなう者,ものは、神,かみの国,くにをつぐことがない。","tok":[["ねたみ"],["、"],["泥酔","でいすい"],["、"],["宴楽","えんらく"],["、"],["および"],["、"],["その"],["たぐい"],["で"],["ある"],["。"],["わたし"],["は"],["以前","いぜん"],["も"],["言った","いった"],["よう"],["に"],["、"],["今","いま"],["も"],["前もって","まえもって"],["言って","いって"],["おく"],["。"],["この"],["よう"],["な"],["こと"],["を"],["行なう","おこなう"],["者","もの"],["は"],["、"],["神","かみ"],["の"],["国","くに"],["を"],["つぐ"],["こと"],["が"],["ない"],["。"]]},{"verse":22,"text":"しかし、御霊,みたまの実,みは、愛,あい、喜,よろこび、平和,へいわ、寛容,かんよう、慈愛,じあい、善意,ぜんい、忠実,ちゅうじつ、","tok":[["しかし"],["、"],["御霊","みたま"],["の"],["実","み"],["は"],["、"],["愛","あい"],["、"],["喜こび","よろこび"],["、"],["平和","へいわ"],["、"],["寛容","かんよう"],["、"],["慈愛","じあい"],["、"],["善意","ぜんい"],["、"],["忠実","ちゅうじつ"],["、"]]},{"verse":23,"text":"柔和,にゅうわ、自制,じせいであって、これらを否定,ひていする律法,りっぽうはない。","tok":[["柔和","にゅうわ"],["、"],["自制","じせい"],["で"],["あって"],["、"],["これ"],["ら"],["を"],["否定","ひてい"],["する"],["律法","りっぽう"],["は"],["ない"],["。"]]},{"verse":24,"text":"キリスト・イエスに属,ぞくする者,ものは、自分,じぶんの肉,にくを、その情,じょうと欲,よくと共,ともに十字架,じゅうじかにつけてしまったのである。","tok":[["キリスト"],["・"],["イエス"],["に"],["属する","ぞくする"],["者","もの"],["は"],["、"],["自分","じぶん"],["の"],["肉","にく"],["を"],["、"],["その"],["情","じょう"],["と"],["欲","よく"],["と"],["共","とも"],["に"],["十字架","じゅうじか"],["に"],["つけて"],["しまった"],["ので"],["ある"],["。"]]},{"verse":25,"text":"もしわたしたちが御霊,みたまによって生,いきるのなら、また御霊,みたまによって進,すすむもうではないか。","tok":[["もし"],["わたしたち"],["が"],["御霊","みたま"],["によって"],["生きる","いきる"],["の"],["なら"],["、"],["また"],["御霊","みたま"],["によって"],["進む","すすむ"],["もう"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":26,"text":"互,たがいにいどみ合,あい、互,たがいにねたみ合,あって、虚栄,きょえいに生,いきてはならない。","tok":[["互","たがい"],["に"],["いどみ"],["合い","あい"],["、"],["互","たがい"],["に"],["ねたみ"],["合って","あって"],["、"],["虚栄","きょえい"],["に"],["生きて","いきて"],["は"],["ならない"],["。"]]}]
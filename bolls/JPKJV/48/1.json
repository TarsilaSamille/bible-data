[{"verse":1,"text":"人々,ひとびとからでもなく、人,ひとによってでもなく、イエス・キリストと彼,かれを死人,しにんの中,なかからよみがえらせた父,ちちなる神,かみとによって立,たてられた使徒,しとパウロ、","tok":[["人々","ひとびと"],["から"],["で"],["も"],["なく"],["、"],["人","ひと"],["によって"],["で"],["も"],["なく"],["、"],["イエス"],["・"],["キリスト"],["と"],["彼","かれ"],["を"],["死人","しにん"],["の"],["中","なか"],["から"],["よみがえらせた"],["父","ちち"],["なる"],["神","かみ"],["と"],["によって"],["立られた","たてられた"],["使徒","しと"],["パウロ"],["、"]]},{"verse":2,"text":"ならびにわたしと共,ともにいる兄弟,きょうだいたち一同,いちどうから、ガラテヤの諸,しょ教会,きょうかいへ。","tok":[["ならびに"],["わたし"],["と"],["共","とも"],["に"],["いる"],["兄弟","きょうだい"],["たち"],["一同","いちどう"],["から"],["、"],["ガラテヤ"],["の"],["諸教","しょ教"],["会","かい"],["へ"],["。"]]},{"verse":3,"text":"わたしたちの父,ちちなる神,かみと主,しゅイエス・キリストから、恵,めぐみと平安,へいあんとが、あなたがたにあるように。","tok":[["わたしたち"],["の"],["父","ちち"],["なる"],["神","かみ"],["と"],["主","しゅ"],["イエス"],["・"],["キリスト"],["から"],["、"],["恵","めぐみ"],["と"],["平安","へいあん"],["と"],["が"],["、"],["あなた"],["がた"],["に"],["ある"],["よう"],["に"],["。"]]},{"verse":4,"text":"キリストは、わたしたちの父,ちちなる神,かみの御旨,みむねに従,したがい、わたしたちを今,いまの悪,あくの世,よから救,すくい出,だそうとして、ご自身,じしんをわたしたちの罪,つみのためにささげられたのである。","tok":[["キリスト"],["は"],["、"],["わたしたち"],["の"],["父","ちち"],["なる"],["神","かみ"],["の"],["御旨","みむね"],["に"],["従い","したがい"],["、"],["わたしたち"],["を"],["今","いま"],["の"],["悪","あく"],["の"],["世","よ"],["から"],["救い出そう","すくいだそう"],["として"],["、"],["ご自身","ごじしん"],["を"],["わたしたち"],["の"],["罪","つみ"],["の"],["ため"],["に"],["ささげられた"],["ので"],["ある"],["。"]]},{"verse":5,"text":"栄光,えいこうが世々,よよ限,かぎりなく神,かみにあるように、アァメン。","tok":[["栄光","えいこう"],["が"],["世々","よ"],["よ"],["限","かぎり"],["なく"],["神","かみ"],["に"],["ある"],["よう"],["に"],["、"],["アァメン"],["。"]]},{"verse":6,"text":"あなたがたがこんなにも早,はやく、あなたがたをキリストの恵,めぐみの内,うちへお招,まねきになったかたから離,はなれて、違,ちがった福音,ふくいんに落,おちていくことが、わたしには不思議,ふしぎでならない。","tok":[["あなた"],["がた"],["が"],["こんな"],["に"],["も"],["早く","はやく"],["、"],["あなた"],["がた"],["を"],["キリスト"],["の"],["恵","めぐみ"],["の"],["内","うち"],["へ"],["お招き","おまねき"],["に"],["なった"],["かた"],["から"],["離れて","はなれて"],["、"],["違った","ちがった"],["福音","ふくいん"],["に"],["落","おち"],["て"],["いく"],["こと"],["が"],["、"],["わたし"],["に"],["は"],["不思議","ふしぎ"],["で"],["ならない"],["。"]]},{"verse":7,"text":"それは福音,ふくいんというべきものではなく、ただ、ある種,たねの人々,ひとびとがあなたがたをかき乱,みだし、キリストの福音,ふくいんを曲,まげようとしているだけのことである。","tok":[["それ"],["は"],["福音","ふくいん"],["と"],["いうべき"],["もの"],["で"],["は"],["なく"],["、"],["ただ"],["、"],["ある"],["種","たね"],["の"],["人々","ひとびと"],["が"],["あなた"],["がた"],["を"],["かき乱し","かきみだし"],["、"],["キリスト"],["の"],["福音","ふくいん"],["を"],["曲げよう","まげよう"],["として"],["いる"],["だけ"],["の"],["こと"],["で"],["ある"],["。"]]},{"verse":8,"text":"しかし、たといわたしたちであろうと、天,てんからの御使,みつかいであろうと、わたしたちが宣,のべ伝,つたえた福音,ふくいんに反,はんすることをあなたがたに宣,のべ伝,つたえるなら、その人,ひとはのろわるべきである。","tok":[["しかし"],["、"],["たとい"],["わたしたち"],["で"],["あろう"],["と"],["、"],["天","てん"],["から"],["の"],["御使","みつかいであろう"],["と"],["、"],["わたしたち"],["が"],["宣べ伝えた","のべつたえた"],["福音","ふくいん"],["に"],["反する","はんする"],["こと"],["を"],["あなた"],["がた"],["に"],["宣べ伝えるなら","のべつたえるなら"],["、"],["その"],["人","ひと"],["は"],["のろわるべきで"],["ある"],["。"]]},{"verse":9,"text":"わたしたちが前,まえに言,いっておいたように、今,いまわたしは重,かさねて言,いう。もしある人,ひとが、あなたがたの受,うけいれた福音,ふくいんに反,はんすることを宣,のべ伝,つたえているなら、その人,ひとはのろわるべきである。","tok":[["わたしたち"],["が"],["前","まえ"],["に"],["言って","いって"],["おいた"],["よう"],["に"],["、"],["今","いま"],["わたし"],["は"],["重ねて","かさねて"],["言う","いう"],["。"],["もし"],["ある"],["人","ひと"],["が"],["、"],["あなた"],["がた"],["の"],["受けいれた","うけいれた"],["福音","ふくいん"],["に"],["反する","はんする"],["こと"],["を"],["宣べ伝えて","のべつたえて"],["いるなら"],["、"],["その"],["人","ひと"],["は"],["のろわるべきで"],["ある"],["。"]]},{"verse":10,"text":"今,いまわたしは、人,ひとに喜,よろこばれようとしているのか、それとも、神,かみに喜,よろこばれようとしているのか。あるいは、人,ひとの歓心,かんしんを買,かおうと努,つとめているのか。もし、今,いまもなお人,ひとの歓心,かんしんを買,かおうとしているとすれば、わたしはキリストの僕,しもべではあるまい。","tok":[["今","いま"],["わたし"],["は"],["、"],["人","ひと"],["に"],["喜こばれよう","よろこばれよう"],["として"],["いる"],["の"],["か"],["、"],["それ"],["と"],["も"],["、"],["神","かみ"],["に"],["喜こばれよう","よろこばれよう"],["として"],["いる"],["の"],["か"],["。"],["あるいは"],["、"],["人","ひと"],["の"],["歓心","かんしん"],["を"],["買おう","かおう"],["と"],["努めて","つとめて"],["いる"],["の"],["か"],["。"],["もし"],["、"],["今","いま"],["も"],["なお"],["人","ひと"],["の"],["歓心","かんしん"],["を"],["買おう","かおう"],["として"],["いる"],["と"],["すれば"],["、"],["わたし"],["は"],["キリスト"],["の"],["僕","し"],["も"],["べ"],["で"],["は"],["あるまい"],["。"]]},{"verse":11,"text":"兄弟,きょうだいたちよ。あなたがたに、はっきり言,いっておく。わたしが宣,のべ伝,つたえた福音,ふくいんは人間,にんげんによるものではない。","tok":[["兄弟","きょうだい"],["たち"],["よ"],["。"],["あなた"],["がた"],["に"],["、"],["はっきり"],["言って","いって"],["おく"],["。"],["わたし"],["が"],["宣べ伝えた","のべつたえた"],["福音","ふくいん"],["は"],["人間","にんげん"],["に"],["よる"],["もの"],["で"],["は"],["ない"],["。"]]},{"verse":12,"text":"わたしは、それを人間,にんげんから受,うけたのでも教,おしえられたのでもなく、ただイエス・キリストの啓示,けいじによったのである。","tok":[["わたし"],["は"],["、"],["それ"],["を"],["人間","にんげん"],["から"],["受けた","うけた"],["ので"],["も"],["教えられた","おしえられた"],["ので"],["も"],["なく"],["、"],["ただ"],["イエス"],["・"],["キリスト"],["の"],["啓示","けいじ"],["に"],["よった"],["ので"],["ある"],["。"]]},{"verse":13,"text":"ユダヤ教,きょうを信,しんじていたころのわたしの行動,こうどうについては、あなたがたはすでによく聞,きいている。すなわち、わたしは激,はげしく神,かみの教会,きょうかいを迫害,はくがいし、また荒,あらしまわっていた。","tok":[["ユダヤ教","ゆだやきょう"],["を"],["信じて","しんじて"],["いた"],["ころ"],["の"],["わたし"],["の"],["行動","こうどう"],["について"],["は"],["、"],["あなた"],["がた"],["は"],["すでに"],["よく"],["聞いて","きいて"],["いる"],["。"],["すなわち"],["、"],["わたし"],["は"],["激しく","はげしく"],["神","かみ"],["の"],["教会","きょうかい"],["を"],["迫害","はくがい"],["し"],["、"],["また"],["荒しまわって","あらしまわって"],["いた"],["。"]]},{"verse":14,"text":"そして、同国人,どうこくじんの中,なかでわたしと同年輩,どうねんぱいの多,おおくの者,ものにまさってユダヤ教,きょうに精進,しょうじんし、先祖,せんぞたちの言伝,いいつたえに対,たいして、だれよりもはるかに熱心,ねっしんであった。","tok":[["そして"],["、"],["同国人","どうこくじん"],["の"],["中","なか"],["で"],["わたし"],["と"],["同年輩","どうねんぱい"],["の"],["多く","おおく"],["の"],["者","もの"],["に"],["まさって"],["ユダヤ教","ゆだやきょう"],["に"],["精進","しょうじん"],["し"],["、"],["先祖","せんぞ"],["たち"],["の"],["言伝え","いいつたえ"],["に対して","にたいして"],["、"],["だれ"],["より"],["も"],["はるか"],["に"],["熱心","ねっしん"],["で"],["あった"],["。"]]},{"verse":15,"text":"ところが、母,ははの胎内,たいないにある時,ときからわたしを聖,せい別,べつし、み恵,めぐみをもってわたしをお召,めしになったかたが、","tok":[["ところ"],["が"],["、"],["母","はは"],["の"],["胎内","たいない"],["に"],["ある"],["時","とき"],["から"],["わたし"],["を"],["聖別","せいべつ"],["し"],["、"],["み恵","みめぐみ"],["を"],["もって"],["わたし"],["を"],["お召","おめし"],["に"],["なった"],["かた"],["が"],["、"]]},{"verse":16,"text":"異邦人,いほうじんの間,あいだに宣,のべ伝,つたえさせるために、御子,みこをわたしの内,うちに啓示,けいじして下,くださった時,とき、わたしは直,ただちに、血肉,けつにくに相談,そうだんもせず、","tok":[["異邦人","いほうじん"],["の"],["間","あいだ"],["に"],["宣べ伝えさせる","のべつたえさせる"],["ため"],["に"],["、"],["御子","みこ"],["を"],["わたし"],["の"],["内","うち"],["に"],["啓示","けいじ"],["して"],["下さった","くださった"],["時","とき"],["、"],["わたし"],["は"],["直ちに","ただちに"],["、"],["血肉","けつにく"],["に"],["相談","そうだん"],["も"],["せず"],["、"]]},{"verse":17,"text":"また先輩,せんぱいの使徒,しとたちに会,あうためにエルサレムにも上,のぼらず、アラビヤに出,でて行,いった。それから再,ふたたびダマスコに帰,かえった。","tok":[["また"],["先輩","せんぱい"],["の"],["使徒","しと"],["たち"],["に"],["会う","あう"],["ため"],["に"],["エルサレム"],["に"],["も"],["上らず","のぼらず"],["、"],["アラビヤ"],["に"],["出て","でて"],["行った","いった"],["。"],["それ"],["から"],["再び","ふたたび"],["ダマスコ"],["に"],["帰えった","かえった"],["。"]]},{"verse":18,"text":"その後,のち三年,ねんたってから、わたしはケパをたずねてエルサレムに上,のぼり、彼,かれのもとに十五日間,にちかん、滞在,たいざいした。","tok":[["その後","そのの"],["ち"],["三","さん"],["年","ねん"],["ら"],["、"],["わたし"],["は"],["ケパ"],["を"],["たずねて"],["エルサレム"],["に"],["上り","のぼり"],["、"],["彼","かれ"],["の"],["もと"],["に"],["十五","じゅうご"],["日間","にちかん"],["ちかん"],["、"],["滞在","たいざい"],["した"],["。"]]},{"verse":19,"text":"しかし、主,しゅの兄弟,きょうだいヤコブ以外,いがいには、ほかのどの使徒,しとにも会,あわなかった。","tok":[["しかし"],["、"],["主","しゅ"],["の"],["兄弟","きょうだい"],["ヤコブ"],["以外","いがい"],["に"],["は"],["、"],["ほか"],["の"],["どの"],["使徒","しと"],["に"],["も"],["会わなかった","あわなかった"],["。"]]},{"verse":20,"text":"ここに書,かいていることは、神,かみのみまえで言,いうが、決,けっして偽,いつわりではない。","tok":[["ここ"],["に"],["書いて","かいて"],["いる"],["こと"],["は"],["、"],["神","かみ"],["のみ"],["まえ"],["で"],["言う","いう"],["が"],["、"],["決っして","けっして"],["偽わりで","いつわりで"],["は"],["ない"],["。"]]},{"verse":21,"text":"その後,のち、わたしはシリヤとキリキヤとの地方,ちほうに行,いった。","tok":[["その後","そのの"],["ち"],["、"],["わたし"],["は"],["シリヤ"],["と"],["キリキヤ"],["と"],["の"],["地方","ちほう"],["に"],["行った","いった"],["。"]]},{"verse":22,"text":"しかし、キリストにあるユダヤの諸,しょ教会,きょうかいには、顔,かおを知,しられていなかった。","tok":[["しかし"],["、"],["キリスト"],["に"],["ある"],["ユダヤ"],["の"],["諸教","しょ教"],["会","かい"],["に"],["は"],["、"],["顔","かお"],["を"],["知られて","しられて"],["いなかった"],["。"]]},{"verse":23,"text":"ただ彼,かれらは、「かつて自分,じぶんたちを迫害,はくがいした者,ものが、以前,いぜんには撲滅,ぼくめつしようとしていたその信仰,しんこうを、今,いまは宣,のべ伝,つたえている」と聞,きき、","tok":[["ただ"],["彼","かれ"],["ら"],["は"],["、"],["「"],["かつて"],["自分","じぶん"],["たち"],["を"],["迫害","はくがい"],["した"],["者","もの"],["が"],["、"],["以前","いぜん"],["に"],["は"],["撲滅","ぼくめつ"],["しよう"],["として"],["いた"],["その"],["信仰","しんこう"],["を"],["、"],["今","いま"],["は"],["宣べ伝えて","のべつたえて"],["いる"],["」"],["と"],["聞","きき"],["、"]]},{"verse":24,"text":"わたしのことで、神,かみをほめたたえた。","tok":[["わたし"],["の"],["こと"],["で"],["、"],["神","かみ"],["を"],["ほめたたえた"],["。"]]}]
[{"verse":1,"text":"わたしの言,いう意味,いみは、こうである。相続人,そうぞくにんが子供,こどもである間,あいだは、全,ぜん財産,ざいさんの持,もち主,ぬしでありながら、僕,しもべとなんの差別,さべつもなく、","tok":[["わたし"],["の"],["言う","いう"],["意味","いみ"],["は"],["、"],["こう"],["で"],["ある"],["。"],["相続人","そうぞくにん"],["が"],["子供","こども"],["で"],["ある"],["間","あいだ"],["は"],["、"],["全","ぜん"],["財産","ざいさん"],["の"],["持主","もちぬし"],["で"],["あり"],["ながら"],["、"],["僕","し"],["も"],["べと"],["なん"],["の"],["差別","さべつ"],["も"],["なく"],["、"]]},{"verse":2,"text":"父親,ちちおやの定,さだめた時期,じきまでは、管理人,かんりにんや後見人,こうけんにんの監督,かんとくの下,もとに置,おかれているのである。","tok":[["父親","ちちおや"],["の"],["定めた","さだめた"],["時期","じき"],["まで"],["は"],["、"],["管理人","かんりにん"],["や"],["後見人","こうけんにん"],["の"],["監督","かんとく"],["の"],["下","もと"],["に"],["置かれて","おかれて"],["いる"],["ので"],["ある"],["。"]]},{"verse":3,"text":"それと同,おなじく、わたしたちも子供,こどもであった時,ときには、いわゆるこの世,よのもろもろの霊力,れいりょくの下,もとに、縛,しばられていた者,ものであった。","tok":[["それ"],["と"],["同じく","おなじく"],["、"],["わたしたち"],["も"],["子供","こども"],["で"],["あった"],["時","とき"],["に"],["は"],["、"],["いわゆる"],["この世","このよ"],["の"],["もろもろ"],["の"],["霊力","れいりょく"],["の"],["下","もと"],["に"],["、"],["縛られて","しばられて"],["いた"],["者","もの"],["で"],["あった"],["。"]]},{"verse":4,"text":"しかし、時,ときの満,みちるに及,およんで、神,かみは御子,みこを女,おんなから生,うまれさせ、律法,りっぽうの下,もとに生,うまれさせて、おつかわしになった。","tok":[["しかし"],["、"],["時","とき"],["の"],["満ちる","みちる"],["に"],["及んで","およんで"],["、"],["神","かみ"],["は"],["御子","みこ"],["を"],["女","おんな"],["から"],["生まれさせ","うまれさせ"],["、"],["律法","りっぽう"],["の"],["下","もと"],["に"],["生まれさせて","うまれさせて"],["、"],["おつかわし"],["に"],["なった"],["。"]]},{"verse":5,"text":"それは、律法,りっぽうの下,もとにある者,ものをあがない出,だすため、わたしたちに子,こたる身分,みぶんを授,さづけるためであった。","tok":[["それ"],["は"],["、"],["律法","りっぽう"],["の"],["下","もと"],["に"],["ある"],["者","もの"],["を"],["あがない"],["出す","だす"],["ため"],["、"],["わたしたち"],["に"],["子","こ"],["たる"],["身分","みぶん"],["を"],["授","さ"],["づける"],["ため"],["で"],["あった"],["。"]]},{"verse":6,"text":"このように、あなたがたは子,こであるのだから、神,かみはわたしたちの心,こころの中,なかに、「アバ、父,ちちよ」と呼,よぶ御子,みこの霊,れいを送,おくって下,くださったのである。","tok":[["この"],["よう"],["に"],["、"],["あなた"],["がた"],["は"],["子","こ"],["で"],["ある"],["の"],["だ"],["から"],["、"],["神","かみ"],["は"],["わたしたち"],["の"],["心","こころ"],["の"],["中","なか"],["に"],["、"],["「"],["アバ"],["、"],["父","ちち"],["よ"],["」"],["と"],["呼ぶ","よぶ"],["御子","みこ"],["の"],["霊","れい"],["を"],["送って","おくって"],["下さった","くださった"],["ので"],["ある"],["。"]]},{"verse":7,"text":"したがって、あなたがたはもはや僕,しもべではなく、子,こである。子,こである以上,いじょう、また神,かみによる相続人,そうぞくにんである。","tok":[["したがって"],["、"],["あなた"],["がた"],["は"],["もはや"],["僕","し"],["も"],["べ"],["で"],["は"],["なく"],["、"],["子","こ"],["で"],["ある"],["。"],["子","こ"],["で"],["ある"],["以上","いじょう"],["、"],["また"],["神","かみ"],["に"],["よる"],["相続人","そうぞくにん"],["で"],["ある"],["。"]]},{"verse":8,"text":"神,かみを知,しらなかった当時,とうじ、あなたがたは、本来,ほんらい神,かみならぬ神々,かみがみの奴隷,どれいになっていた。","tok":[["神","かみ"],["を"],["知らなかった","しらなかった"],["当時","とうじ"],["、"],["あなた"],["がた"],["は"],["、"],["本来","ほんらい"],["神","かみ"],["ならぬ"],["神々","かみがみ"],["の"],["奴隷","どれい"],["に"],["なって"],["いた"],["。"]]},{"verse":9,"text":"しかし、今,いまでは神,かみを知,しっているのに、否,いな、むしろ神,かみに知,しられているのに、どうして、あの無力,むりょくで貧弱,ひんじゃくな、もろもろの霊力,れいりょくに逆,ぎゃくもどりして、またもや、新,あらたにその奴隷,どれいになろうとするのか。","tok":[["しかし"],["、"],["今","いま"],["で"],["は"],["神","かみ"],["を"],["知って","しって"],["いる"],["のに"],["、"],["否","いな"],["、"],["むしろ"],["神","かみ"],["に"],["知られて","しられて"],["いる"],["のに"],["、"],["どう"],["して"],["、"],["あの"],["無力","むりょく"],["で"],["貧弱","ひんじゃく"],["な"],["、"],["もろもろ"],["の"],["霊力","れいりょく"],["に"],["逆もどり","ぎゃくもどり"],["して"],["、"],["またもや"],["、"],["新らた","あらた"],["に"],["その"],["奴隷","どれい"],["に"],["なろう"],["と"],["する"],["の"],["か"],["。"]]},{"verse":10,"text":"あなたがたは、日,ひや月,つきや季節,きせつや年,としなどを守,まもっている。","tok":[["あなた"],["がた"],["は"],["、"],["日","ひ"],["や"],["月","つき"],["や"],["季節","きせつ"],["や"],["年","とし"],["など"],["を"],["守って","まもって"],["いる"],["。"]]},{"verse":11,"text":"わたしは、あなたがたのために努力,どりょくしてきたことが、あるいは、むだになったのではないかと、あなたがたのことが心配,しんぱいでならない。","tok":[["わたし"],["は"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["努力","どりょく"],["して"],["きた"],["こと"],["が"],["、"],["あるいは"],["、"],["むだ"],["に"],["なった"],["ので"],["は"],["ない"],["か"],["と"],["、"],["あなた"],["がた"],["の"],["こと"],["が"],["心配","しんぱい"],["で"],["ならない"],["。"]]},{"verse":12,"text":"兄弟,きょうだいたちよ。お願,ねがいする。どうか、わたしのようになってほしい。わたしも、あなたがたのようになったのだから。あなたがたは、一度,どもわたしに対,たいして不都合,ふつごうなことをしたことはない。","tok":[["兄弟","きょうだい"],["たち"],["よ"],["。"],["お願い","おねがい"],["する"],["。"],["どう"],["か"],["、"],["わたし"],["の"],["よう"],["に"],["なって"],["ほしい"],["。"],["わたし"],["も"],["、"],["あなた"],["がた"],["の"],["よう"],["に"],["なった"],["の"],["だ"],["から"],["。"],["あなた"],["がた"],["は"],["、"],["一度","ど"],["も"],["わたし"],["に対して","にたいして"],["不都合","ふつごう"],["な"],["こと"],["を"],["した"],["こと"],["は"],["ない"],["。"]]},{"verse":13,"text":"あなたがたも知,しっているとおり、最初,さいしょわたしがあなたがたに福音,ふくいんを伝,つたえたのは、わたしの肉体,にくたいが弱,よわっていたためであった。","tok":[["あなた"],["がた"],["も"],["知って","しって"],["いる"],["とおり"],["、"],["最初","さいしょ"],["わたし"],["が"],["あなた"],["がた"],["に"],["福音","ふくいん"],["を"],["伝えた","つたえた"],["の"],["は"],["、"],["わたし"],["の"],["肉体","にくたい"],["が"],["弱って","よわって"],["いた"],["ため"],["で"],["あった"],["。"]]},{"verse":14,"text":"そして、わたしの肉体,にくたいにはあなたがたにとって試錬,しれんとなるものがあったのに、それを卑,いやしめもせず、またきらいもせず、かえってわたしを、神,かみの使,つかいかキリスト・イエスかでもあるように、迎,むかえてくれた。","tok":[["そして"],["、"],["わたし"],["の"],["肉体","にくたい"],["に"],["は"],["あなた"],["がた"],["にとって"],["試錬","しれん"],["と"],["なる"],["もの"],["が"],["あった"],["のに"],["、"],["それ"],["を"],["卑しめ","いやしめ"],["も"],["せず"],["、"],["また"],["きらい"],["も"],["せず"],["、"],["かえって"],["わたし"],["を"],["、"],["神","かみ"],["の"],["使","つかい"],["か"],["キリスト"],["・"],["イエス"],["か"],["で"],["も"],["ある"],["よう"],["に"],["、"],["迎","むかえ"],["て"],["くれた"],["。"]]},{"verse":15,"text":"その時,ときのあなたがたの感激,かんげきは、今,いまどこにあるのか。はっきり言,いうが、あなたがたは、できることなら、自分,じぶんの目,めをえぐり出,だしてでも、わたしにくれたかったのだ。","tok":[["その"],["時","とき"],["の"],["あなた"],["がた"],["の"],["感激","かんげき"],["は"],["、"],["今","いま"],["どこ"],["に"],["ある"],["の"],["か"],["。"],["はっきり"],["言う","いう"],["が"],["、"],["あなた"],["がた"],["は"],["、"],["できる"],["こと"],["なら"],["、"],["自分","じぶん"],["の"],["目","め"],["を"],["えぐり出して","えぐりだして"],["で"],["も"],["、"],["わたし"],["に"],["くれたかった"],["の"],["だ"],["。"]]},{"verse":16,"text":"それだのに、真理,しんりを語,かたったために、わたしはあなたがたの敵,てきになったのか。","tok":[["それ"],["だ"],["のに"],["、"],["真理","しんり"],["を"],["語った","かたった"],["ため"],["に"],["、"],["わたし"],["は"],["あなた"],["がた"],["の"],["敵","てき"],["に"],["なった"],["の"],["か"],["。"]]},{"verse":17,"text":"彼,かれらがあなたがたに対,たいして熱心,ねっしんなのは、善意,ぜんいからではない。むしろ、自分,じぶんらに熱心,ねっしんにならせるために、あなたがたをわたしから引,ひき離,はなそうとしているのである。","tok":[["彼","かれ"],["ら"],["が"],["あなた"],["がた"],["に対して","にたいして"],["熱心","ねっしん"],["な"],["の"],["は"],["、"],["善意","ぜんい"],["から"],["で"],["は"],["ない"],["。"],["むしろ"],["、"],["自分","じぶん"],["ら"],["に"],["熱心","ねっしん"],["に"],["ならせる"],["ため"],["に"],["、"],["あなた"],["がた"],["を"],["わたし"],["から"],["引離そう","ひきはなそう"],["として"],["いる"],["ので"],["ある"],["。"]]},{"verse":18,"text":"わたしがあなたがたの所,ところにいる時,ときだけでなく、いつも、良,よいことについて熱心,ねっしんに慕,したわれるのは、良,よいことである。","tok":[["わたし"],["が"],["あなた"],["がた"],["の"],["所","ところ"],["に"],["いる"],["時","とき"],["だけ"],["で"],["なく"],["、"],["いつも"],["、"],["良い","よい"],["こと"],["について"],["熱心","ねっしん"],["に"],["慕われる","したわれる"],["の"],["は"],["、"],["良い","よい"],["こと"],["で"],["ある"],["。"]]},{"verse":19,"text":"ああ、わたしの幼,おさな子,ごたちよ。あなたがたの内,うちにキリストの形,かたちができるまでは、わたしは、またもや、あなたがたのために産,うみの苦,くるしみをする。","tok":[["ああ"],["、"],["わたし"],["の"],["幼な子","おさなご"],["たち"],["よ"],["。"],["あなた"],["がた"],["の"],["内","うち"],["に"],["キリスト"],["の"],["形","かたち"],["が"],["できる"],["まで"],["は"],["、"],["わたし"],["は"],["、"],["またもや"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["産み","うみ"],["の"],["苦しみ","くるしみ"],["を"],["する"],["。"]]},{"verse":20,"text":"できることなら、わたしは今,いまあなたがたの所,ところにいて、語調,ごちょうを変,かえて話,はなしてみたい。わたしは、あなたがたのことで、途方,とほうにくれている。","tok":[["できる"],["こと"],["なら"],["、"],["わたし"],["は"],["今","いま"],["あなた"],["がた"],["の"],["所","ところ"],["に"],["いて"],["、"],["語調","ごちょう"],["を"],["変えて","かえて"],["話","はなし"],["て"],["みたい"],["。"],["わたし"],["は"],["、"],["あなた"],["がた"],["の"],["こと"],["で"],["、"],["途方","とほう"],["に"],["くれて"],["いる"],["。"]]},{"verse":21,"text":"律法,りっぽうの下,もとにとどまっていたいと思,おもう人,ひとたちよ。わたしに答,こたえなさい。あなたがたは律法,りっぽうの言,いうところを聞,きかないのか。","tok":[["律法","りっぽう"],["の"],["下","もと"],["に"],["とどまって"],["いたい"],["と"],["思う","おもう"],["人","ひと"],["たち"],["よ"],["。"],["わたし"],["に"],["答","こたえ"],["なさい"],["。"],["あなた"],["がた"],["は"],["律法","りっぽう"],["の"],["言う","いう"],["ところ"],["を"],["聞かない","きかない"],["の"],["か"],["。"]]},{"verse":22,"text":"そのしるすところによると、アブラハムにふたりの子,こがあったが、ひとりは女,おんな奴隷,どれいから、ひとりは自由,じゆうの女,おんなから生,うまれた。","tok":[["その"],["しるす"],["ところ"],["に"],["よる"],["と"],["、"],["アブラハム"],["に"],["ふたり"],["の"],["子","こ"],["が"],["あった"],["が"],["、"],["ひとり"],["は"],["女","おんな"],["奴隷","どれい"],["から"],["、"],["ひとり"],["は"],["自由","じゆう"],["の"],["女","おんな"],["から"],["生まれた","うまれた"],["。"]]},{"verse":23,"text":"女,おんな奴隷,どれいの子,こは肉,にくによって生,うまれたのであり、自由,じゆうの女,おんなの子,こは約束,やくそくによって生,うまれたのであった。","tok":[["女","おんな"],["奴隷","どれい"],["の"],["子","こ"],["は"],["肉","にく"],["によって"],["生まれた","うまれた"],["ので"],["あり"],["、"],["自由","じゆう"],["の"],["女の子","おんなのこ"],["は"],["約束","やくそく"],["によって"],["生まれた","うまれた"],["ので"],["あった"],["。"]]},{"verse":24,"text":"さて、この物語,ものがたりは比喩,ひゆとしてみられる。すなわち、この女,おんなたちは二つの契約,けいやくをさす。そのひとりはシナイ山,ざんから出,でて、奴隷,どれいとなる者,ものを産,うむ。ハガルがそれである。","tok":[["さて"],["、"],["この"],["物語","ものがたり"],["は"],["比喩","ひゆ"],["として"],["みられる"],["。"],["すなわち"],["、"],["この"],["女","おんな"],["たち"],["は"],["二","ふた"],["つ"],["の"],["契約","けいやく"],["を"],["さす"],["。"],["その"],["ひとり"],["は"],["シナイ"],["山","ざんか"],["ら"],["出て","でて"],["、"],["奴隷","どれい"],["と"],["なる"],["者","もの"],["を"],["産む","うむ"],["。"],["ハガル"],["が"],["それ"],["で"],["ある"],["。"]]},{"verse":25,"text":"ハガルといえば、アラビヤではシナイ山,ざんのことで、今,いまのエルサレムに当,あたる。なぜなら、それは子,こたちと共,ともに、奴隷,どれいとなっているからである。","tok":[["ハガル"],["と"],["いえば"],["、"],["アラビヤ"],["で"],["は"],["シナイ"],["山","ざん"],["の"],["こと"],["で"],["、"],["今","いま"],["の"],["エルサレム"],["に"],["当たる","あたる"],["。"],["なぜ"],["なら"],["、"],["それ"],["は"],["子","こ"],["たち"],["と"],["共","とも"],["に"],["、"],["奴隷","どれい"],["と"],["なって"],["いる"],["から"],["で"],["ある"],["。"]]},{"verse":26,"text":"しかし、上,うえなるエルサレムは、自由,じゆうの女,おんなであって、わたしたちの母,ははをさす。","tok":[["しかし"],["、"],["上","うえ"],["なる"],["エルサレム"],["は"],["、"],["自由","じゆう"],["の"],["女","おんな"],["で"],["あって"],["、"],["わたしたち"],["の"],["母","はは"],["を"],["さす"],["。"]]},{"verse":27,"text":"すなわち、こう書,かいてある、「喜,よろこべ、不妊,ふにんの女,おんなよ。声,こえをあげて喜,よろこべ、産,うみの苦,くるしみを知,しらない女,おんなよ。ひとり者,ものとなっている女,おんなは多,おおくの子,こを産,うみ、その数,かずは、夫,おっとある女,おんなの子,こらよりも多,おおい」。","tok":[["すなわち"],["、"],["こう"],["書いて","かいて"],["ある"],["、"],["「"],["喜こべ","よろこべ"],["、"],["不妊","ふにん"],["の"],["女","おんな"],["よ"],["。"],["声","こえ"],["を"],["あげて"],["喜こべ","よろこべ"],["、"],["産み","うみ"],["の"],["苦しみ","くるしみ"],["を"],["知らない","しらない"],["女","おんな"],["よ"],["。"],["ひとり者","ひとりもの"],["と"],["なって"],["いる"],["女","おんな"],["は"],["多く","おおく"],["の"],["子","こ"],["を"],["産み","うみ"],["、"],["その"],["数","かず"],["は"],["、"],["夫","おっと"],["ある"],["女の子","おんなのこ"],["ら"],["より"],["も"],["多い","おおい"],["」"],["。"]]},{"verse":28,"text":"兄弟,きょうだいたちよ。あなたがたは、イサクのように、約束,やくそくの子,こである。","tok":[["兄弟","きょうだい"],["たち"],["よ"],["。"],["あなた"],["がた"],["は"],["、"],["イサク"],["の"],["よう"],["に"],["、"],["約束","やくそく"],["の"],["子","こ"],["で"],["ある"],["。"]]},{"verse":29,"text":"しかし、その当時,とうじ、肉,にくによって生,うまれた者,ものが、霊,れいによって生,うまれた者,ものを迫害,はくがいしたように、今,いまでも同様,どうようである。","tok":[["しかし"],["、"],["その"],["当時","とうじ"],["、"],["肉","にく"],["によって"],["生まれた","うまれた"],["者","もの"],["が"],["、"],["霊","れい"],["によって"],["生まれた","うまれた"],["者","もの"],["を"],["迫害","はくがい"],["した"],["よう"],["に"],["、"],["今","いま"],["で"],["も"],["同様","どうよう"],["で"],["ある"],["。"]]},{"verse":30,"text":"しかし、聖書,せいしょはなんと言,いっているか。「女,おんな奴隷,どれいとその子,ことを追,おい出,だせ。女,おんな奴隷,どれいの子,こは、自由,じゆうの女,おんなの子,こと共,ともに相続,そうぞくをしてはならない」とある。","tok":[["しかし"],["、"],["聖書","せいしょ"],["は"],["なん"],["と"],["言って","いって"],["いる"],["か"],["。"],["「"],["女","おんな"],["奴隷","どれい"],["と"],["その"],["子","こ"],["と"],["を"],["追い出せ","おいだせ"],["。"],["女","おんな"],["奴隷","どれい"],["の"],["子","こ"],["は"],["、"],["自由","じゆう"],["の"],["女の子","おんなのこ"],["と"],["共","とも"],["に"],["相続","そうぞく"],["を"],["して"],["は"],["ならない"],["」"],["と"],["ある"],["。"]]},{"verse":31,"text":"だから、兄弟,きょうだいたちよ。わたしたちは女,おんな奴隷,どれいの子,こではなく、自由,じゆうの女,おんなの子,こなのである。","tok":[["だ"],["から"],["、"],["兄弟","きょうだい"],["たち"],["よ"],["。"],["わたしたち"],["は"],["女","おんな"],["奴隷","どれい"],["の"],["子","こ"],["で"],["は"],["なく"],["、"],["自由","じゆう"],["の"],["女の子","おんなのこ"],["な"],["ので"],["ある"],["。"]]}]
[{"verse":1,"text":"くびきの下,したにある奴隷,どれいはすべて、自分,じぶんの主人,しゅじんを、真,しんに尊敬,そんけいすべき者,ものとして仰,あおぐべきである。それは、神,かみの御名,みなと教,おしえとが、そしりを受,うけないためである。","tok":[["くびき"],["の"],["下","した"],["に"],["ある"],["奴隷","どれい"],["は"],["すべて"],["、"],["自分","じぶん"],["の"],["主人","しゅじん"],["を"],["、"],["真","しん"],["に"],["尊敬","そんけい"],["すべき"],["者","もの"],["として"],["仰","あおぐ"],["べきで"],["ある"],["。"],["それ"],["は"],["、"],["神","かみ"],["の"],["御名","みな"],["と"],["教え","おしえ"],["と"],["が"],["、"],["そ"],["しり"],["を"],["受ない","うけない"],["ため"],["で"],["ある"],["。"]]},{"verse":2,"text":"信者,しんじゃである主人,しゅじんを持,もっている者,ものたちは、その主人,しゅじんが兄弟,きょうだいであるというので軽視,けいししてはならない。むしろ、ますます励,はげんで仕,つかえるべきである。その益,えきを受,うける主人,しゅじんは、信者,しんじゃであり愛,あいされている人,ひとだからである。あなたは、これらの事,ことを教,おしえかつ勧,すすめなさい。","tok":[["信者","しんじゃ"],["で"],["ある"],["主人","しゅじん"],["を"],["持って","もって"],["いる"],["者","もの"],["たち"],["は"],["、"],["その"],["主人","しゅじん"],["が"],["兄弟","きょうだい"],["で"],["ある"],["と"],["いう"],["ので"],["軽視","けいし"],["して"],["は"],["ならない"],["。"],["むしろ"],["、"],["ますます"],["励んで","はげんで"],["仕えるべきで","つかえるべきで"],["ある"],["。"],["その"],["益","えき"],["を"],["受る","うける"],["主人","しゅじん"],["は"],["、"],["信者","しんじゃ"],["で"],["あり"],["愛されて","あいされて"],["いる"],["人","ひと"],["だ"],["から"],["で"],["ある"],["。"],["あなた"],["は"],["、"],["これ"],["ら"],["の"],["事","こと"],["を"],["教え","おしえ"],["かつ"],["勧め","すすめ"],["なさい"],["。"]]},{"verse":3,"text":"もし違,ちがったことを教,おしえて、わたしたちの主,しゅイエス・キリストの健全,けんぜんな言葉,ことば、ならびに信心,しんじんにかなう教,おしえに同意,どういしないような者,ものがあれば、","tok":[["もし"],["違った","ちがった"],["こと"],["を"],["教えて","おしえて"],["、"],["わたしたち"],["の"],["主","しゅ"],["イエス"],["・"],["キリスト"],["の"],["健全","けんぜん"],["な"],["言葉","ことば"],["、"],["ならび"],["に"],["信心","しんじん"],["に"],["かなう"],["教え","おしえ"],["に"],["同意","どうい"],["しない"],["よう"],["な"],["者","もの"],["が"],["あれば"],["、"]]},{"verse":4,"text":"彼,かれは高慢,こうまんであって、何,なにも知,しらず、ただ論議,ろんぎと言葉,ことばの争,あらそいとに病,やまいみついている者,ものである。そこから、ねたみ、争,あらそい、そしり、さいぎの心,こころが生,しょうじ、","tok":[["彼","かれ"],["は"],["高慢","こうまん"],["で"],["あって"],["、"],["何に","なに"],["も"],["知らず","しらず"],["、"],["ただ"],["論議","ろんぎ"],["と"],["言葉","ことば"],["の"],["争い","あらそい"],["と"],["に"],["病ま","やま"],["いみ"],["ついて"],["いる"],["者","もの"],["で"],["ある"],["。"],["そこ"],["から"],["、"],["ねたみ"],["、"],["争い","あらそい"],["、"],["そしり"],["、"],["さいぎ"],["の"],["心","こころ"],["が"],["生じ","しょうじ"],["、"]]},{"verse":5,"text":"また知性,ちせいが腐,くさって、真理,しんりにそむき、信心,しんじんを利得,りとくと心,こころ得,える者,ものどもの間,あいだに、はてしのないいがみ合,あいが起,おこるのである。","tok":[["また"],["知性","ちせい"],["が"],["腐って","くさって"],["、"],["真理","しんり"],["に"],["そむき"],["、"],["信心","しんじん"],["を"],["利得","りとく"],["と"],["心得る","こころえる"],["者","もの"],["ども"],["の"],["間","あいだ"],["に"],["、"],["はてし"],["の"],["ない"],["いがみ合い","いがみあい"],["が"],["起こる","おこる"],["ので"],["ある"],["。"]]},{"verse":6,"text":"しかし、信心,しんじんがあって足,たることを知,しるのは、大,おおきな利得,りとくである。","tok":[["しかし"],["、"],["信心","しんじん"],["が"],["あって"],["足る","たる"],["こと"],["を"],["知る","しる"],["の"],["は"],["、"],["大きな","おおきな"],["利得","りとく"],["で"],["ある"],["。"]]},{"verse":7,"text":"わたしたちは、何,なにひとつ持,もたないでこの世,よにきた。また、何,なにひとつ持,もたないでこの世,よを去,さって行,いく。","tok":[["わたしたち"],["は"],["、"],["何","な"],["に"],["ひと"],["つ"],["持たないで","もたないで"],["この世","このよ"],["に"],["きた"],["。"],["また"],["、"],["何","な"],["に"],["ひと"],["つ"],["持たないで","もたないで"],["この世","このよ"],["を"],["去て","さって"],["行く","いく"],["。"]]},{"verse":8,"text":"ただ衣食,いしょくがあれば、それで足,たれりとすべきである。","tok":[["ただ"],["衣食","いしょく"],["が"],["あれば"],["、"],["それ"],["で"],["足れり","たれり"],["と"],["すべきで"],["ある"],["。"]]},{"verse":9,"text":"富,とむことを願,ねがい求,もとめる者,ものは、誘惑,ゆうわくと、わなとに陥,おちいり、また、人,ひとを滅,ほろびと破壊,はかいとに沈,しずませる、無分別,むふんべつな恐,おそろしいさまざまの情欲,じょうよくに陥,おちいるのである。","tok":[["富む","とむ"],["こと"],["を"],["願い求める","ねがいもとめる"],["者","もの"],["は"],["、"],["誘惑","ゆうわく"],["と"],["、"],["わな"],["と"],["に"],["陥ち","おち"],["いり"],["、"],["また"],["、"],["人","ひと"],["を"],["滅び","ほろび"],["と"],["破壊","はかい"],["と"],["に"],["沈ませる","しずませる"],["、"],["無分別","むふんべつ"],["な"],["恐ろしい","おそろしい"],["さまざま"],["の"],["情欲","じょうよく"],["に"],["陥ち","おち"],["いる"],["ので"],["ある"],["。"]]},{"verse":10,"text":"金銭,きんせんを愛,あいすることは、すべての悪,あくの根,ねである。ある人々,ひとびとは欲,よくばって金銭,きんせんを求,もとめたため、信仰,しんこうから迷,まよい出,でて、多,おおくの苦痛,くつうをもって自分,じぶん自身,じしんを刺,さしとおした。","tok":[["金銭","きんせん"],["を"],["愛する","あいする"],["こと"],["は"],["、"],["すべて"],["の"],["悪","あく"],["の"],["根","ね"],["で"],["ある"],["。"],["ある"],["人々","ひとびと"],["は"],["欲ばって","よくばって"],["金銭","きんせん"],["を"],["求めた","もとめた"],["ため"],["、"],["信仰","しんこう"],["から"],["迷い出て","まよいでて"],["、"],["多く","おおく"],["の"],["苦痛","くつう"],["を"],["もって"],["自分","じぶん"],["自身","じしん"],["を"],["刺","さし"],["と"],["おした"],["。"]]},{"verse":11,"text":"しかし、神,かみの人,ひとよ。あなたはこれらの事,ことを避,さけなさい。そして、義,ぎと信心,しんじんと信仰,しんこうと愛,あいと忍耐,にんたいと柔和,にゅうわとを追,おい求,もとめなさい。","tok":[["しかし"],["、"],["神","かみ"],["の"],["人","ひと"],["よ"],["。"],["あなた"],["は"],["これ"],["ら"],["の"],["事","こと"],["を"],["避け","さけ"],["なさい"],["。"],["そして"],["、"],["義","ぎ"],["と"],["信心","しんじん"],["と"],["信仰","しんこう"],["と"],["愛","あい"],["と"],["忍耐","にんたい"],["と"],["柔和","にゅうわ"],["と"],["を"],["追い求め","おいもとめ"],["なさい"],["。"]]},{"verse":12,"text":"信仰,しんこうの戦,たたかいをりっぱに戦,たたかいぬいて、永遠,えいえんのいのちを獲得,かくとくしなさい。あなたは、そのために召,めされ、多,おおくの証人,しょうにんの前,まえで、りっぱなあかしをしたのである。","tok":[["信仰","しんこう"],["の"],["戦い","たたかい"],["を"],["りっぱ"],["に"],["戦い","たたかい"],["ぬいて"],["、"],["永遠","えいえん"],["の"],["いのち"],["を"],["獲得","かくとく"],["し"],["なさい"],["。"],["あなた"],["は"],["、"],["その"],["ため"],["に"],["召され","めされ"],["、"],["多く","おおく"],["の"],["証人","しょうにん"],["の"],["前","まえ"],["で"],["、"],["りっぱ"],["な"],["あかし"],["を"],["した"],["ので"],["ある"],["。"]]},{"verse":13,"text":"わたしはすべてのものを生,いかして下,くださる神,かみのみまえと、またポンテオ・ピラトの面前,めんぜんでりっぱなあかしをなさったキリスト・イエスのみまえで、あなたに命,めいじる。","tok":[["わたし"],["は"],["すべて"],["の"],["もの"],["を"],["生かして","いかして"],["下さる","くださる"],["神","かみ"],["のみ"],["まえ"],["と"],["、"],["また"],["ポンテオ"],["・"],["ピラト"],["の"],["面前","めんぜん"],["で"],["りっぱ"],["な"],["あかし"],["を"],["なさった"],["キリスト"],["・"],["イエス"],["のみ"],["まえ"],["で"],["、"],["あなた"],["に"],["命じる","めいじる"],["。"]]},{"verse":14,"text":"わたしたちの主,しゅイエス・キリストの出現,しゅつげんまで、その戒,いましめを汚,けがすことがなく、また、それを非難,ひなんのないように守,まもりなさい。","tok":[["わたしたち"],["の"],["主","しゅ"],["イエス"],["・"],["キリスト"],["の"],["出現","しゅつげん"],["まで"],["、"],["その"],["戒しめ","いましめ"],["を"],["汚す","けがす"],["こと"],["が"],["なく"],["、"],["また"],["、"],["それ"],["を"],["非難","ひなん"],["の"],["ない"],["よう"],["に"],["守り","まもり"],["なさい"],["。"]]},{"verse":15,"text":"時,ときがくれば、祝福,しゅくふくに満,みちた、ただひとりの力,ちからあるかた、もろもろの王,おうの王,おう、もろもろの主,しゅの主,しゅが、キリストを出現,しゅつげんさせて下,くださるであろう。","tok":[["時","とき"],["が"],["くれば"],["、"],["祝福","しゅくふく"],["に"],["満ちた","みちた"],["、"],["ただ"],["ひとり"],["の"],["力","ちから"],["ある"],["かた"],["、"],["もろもろ"],["の"],["王","おう"],["の"],["王","おう"],["、"],["もろもろ"],["の"],["主","しゅ"],["の"],["主","しゅ"],["が"],["、"],["キリスト"],["を"],["出現","しゅつげん"],["させて"],["下さるで","くださるで"],["あろう"],["。"]]},{"verse":16,"text":"神,かみはただひとり不,ふ死,しを保,たもち、近,ちかづきがたい光,ひかりの中,なかに住,すみ、人間,にんげんの中,なかでだれも見,みた者,ものがなく、見,みることもできないかたである。ほまれと永遠,えいえんの支配,しはいとが、神,かみにあるように、アァメン。","tok":[["神","かみ"],["は"],["ただ"],["ひとり"],["不死","ふし"],["を"],["保ち","たもち"],["、"],["近づき","ちかづき"],["がたい"],["光","ひかり"],["の"],["中","なか"],["に"],["住み","すみ"],["、"],["人間","にんげん"],["の"],["中","なか"],["で"],["だれ"],["も"],["見た","みた"],["者","もの"],["が"],["なく"],["、"],["見る","みる"],["こと"],["も"],["できない"],["かた"],["で"],["ある"],["。"],["ほまれ"],["と"],["永遠","えいえん"],["の"],["支配","しはい"],["と"],["が"],["、"],["神","かみ"],["に"],["ある"],["よう"],["に"],["、"],["アァメン"],["。"]]},{"verse":17,"text":"この世,よで富,とんでいる者,ものたちに、命,めいじなさい。高慢,こうまんにならず、たよりにならない富,とみに望,のぞみをおかず、むしろ、わたしたちにすべての物,ものを豊,ゆたかに備,そなえて楽,たのしませて下,くださる神,かみに、のぞみをおくように、","tok":[["この世","このよ"],["で"],["富んで","とんで"],["いる"],["者","もの"],["たち"],["に"],["、"],["命じ","めいじ"],["なさい"],["。"],["高慢","こうまん"],["に"],["ならず"],["、"],["たより"],["に"],["ならない"],["富","とみ"],["に"],["望み","のぞみ"],["を"],["おかず"],["、"],["むしろ"],["、"],["わたしたち"],["に"],["すべて"],["の"],["物","もの"],["を"],["豊","ゆたか"],["に"],["備","そなえ"],["て"],["楽しませて","たのしませて"],["下さる","くださる"],["神","かみ"],["に"],["、"],["のぞみ"],["を"],["おく"],["よう"],["に"],["、"]]},{"verse":18,"text":"また、良,よい行,おこないをし、良,よいわざに富,とみみ、惜,おしみなく施,ほどこし、人,ひとに分,わけ与,あたえることを喜,よろこび、","tok":[["また"],["、"],["良い","よい"],["行ない","おこない"],["を"],["し"],["、"],["良い","よい"],["わざ"],["に"],["富み","とみ"],["み"],["、"],["惜み","おしみ"],["なく"],["施し","ほどこし"],["、"],["人","ひと"],["に"],["分け与える","わけあたえる"],["こと"],["を"],["喜こび","よろこび"],["、"]]},{"verse":19,"text":"こうして、真,しんのいのちを得,えるために、未来,みらいに備,そなえてよい土台,どだいを自分,じぶんのために築,きずき上,あげるように、命,めいじなさい。","tok":[["こう"],["して"],["、"],["真","しん"],["の"],["いのち"],["を"],["得る","える"],["ため"],["に"],["、"],["未来","みらい"],["に"],["備","そなえ"],["て"],["よい"],["土台","どだい"],["を"],["自分","じぶん"],["の"],["ため"],["に"],["築き上げる","きずきあげる"],["よう"],["に"],["、"],["命じ","めいじ"],["なさい"],["。"]]},{"verse":20,"text":"テモテよ。あなたにゆだねられていることを守,まもりなさい。そして、俗悪,ぞくあくなむだ話,はなしと、偽,いつわりの「知識,ちしき」による反対,はんたい論,ろんとを避,さけなさい。","tok":[["テモテ"],["よ"],["。"],["あなた"],["に"],["ゆだねられて"],["いる"],["こと"],["を"],["守り","まもり"],["なさい"],["。"],["そして"],["、"],["俗悪","ぞくあく"],["な"],["むだ話","むだはなし"],["と"],["、"],["偽わり","いつわり"],["の"],["「"],["知識","ちしき"],["」"],["に"],["よる"],["反対論","はんたいろん"],["と"],["を"],["避け","さけ"],["なさい"],["。"]]},{"verse":21,"text":"ある人々,ひとびとはそれに熱中,ねっちゅうして、信仰,しんこうからそれてしまったのである。恵,めぐみが、あなたがたと共,ともにあるように。","tok":[["ある"],["人々","ひとびと"],["は"],["それ"],["に"],["熱中","ねっちゅう"],["して"],["、"],["信仰","しんこう"],["から"],["それて"],["しまった"],["ので"],["ある"],["。"],["恵","めぐみ"],["が"],["、"],["あなた"],["がた"],["と"],["共","とも"],["に"],["ある"],["よう"],["に"],["。"]]}]
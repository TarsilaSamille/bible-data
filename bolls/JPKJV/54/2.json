[{"verse":1,"text":"そこで、まず第,だい一に勧,すすめる。すべての人,ひとのために、王,おうたちと上,うえに立,たっているすべての人々,ひとびとのために、願,ねがいと、祈,いのりと、とりなしと、感謝,かんしゃとをささげなさい。","tok":[["そこ"],["で"],["、"],["まず"],["第","だい"],["一","いち"],["に"],["勧める","すすめる"],["。"],["すべて"],["の"],["人","ひと"],["の"],["ため"],["に"],["、"],["王","おう"],["たち"],["と"],["上","うえ"],["に"],["立って","たって"],["いる"],["すべて"],["の"],["人々","ひとびと"],["の"],["ため"],["に"],["、"],["願い","ねがい"],["と"],["、"],["祈","いのり"],["と"],["、"],["とりなし"],["と"],["、"],["感謝","かんしゃ"],["と"],["を"],["ささげ"],["なさい"],["。"]]},{"verse":2,"text":"それはわたしたちが、安,やすらかで静,しずかな一生,いっしょうを、真,しんに信心,しんじん深,ぶかくまた謹厳,きんげんに過,すごすためである。","tok":[["それ"],["は"],["わたしたち"],["が"],["、"],["安らか","やすらか"],["で"],["静","しずか"],["な"],["一生","いっしょう"],["を"],["、"],["真","しん"],["に"],["信心","しんじん"],["深","ぶ"],["かく"],["また"],["謹厳","きんげん"],["に"],["過ごす","すごす"],["ため"],["で"],["ある"],["。"]]},{"verse":3,"text":"これは、わたしたちの救主,すくいぬしである神,かみのみまえに良,よいことであり、また、みこころにかなうことである。","tok":[["これ"],["は"],["、"],["わたしたち"],["の"],["救主","す"],["くい"],["ぬし"],["で"],["ある"],["神","かみ"],["のみ"],["まえ"],["に"],["良い","よい"],["こと"],["で"],["あり"],["、"],["また"],["、"],["みこころ"],["に"],["かなう"],["こと"],["で"],["ある"],["。"]]},{"verse":4,"text":"神,かみは、すべての人,ひとが救,すくわれて、真理,しんりを悟,さとるに至,いたることを望,のぞんでおられる。","tok":[["神","かみ"],["は"],["、"],["すべて"],["の"],["人","ひと"],["が"],["救われて","すくわれて"],["、"],["真理","しんり"],["を"],["悟","さとる"],["に"],["至る","いたる"],["こと"],["を"],["望んで","のぞんで"],["おられる"],["。"]]},{"verse":5,"text":"神,かみは唯一,ゆいいつであり、神,かみと人,ひととの間,あいだの仲保者,ちゅうほしゃもただひとりであって、それは人,ひとなるキリスト・イエスである。","tok":[["神","かみ"],["は"],["唯一","ゆいいつ"],["で"],["あり"],["、"],["神","かみ"],["と"],["人","ひと"],["と"],["の"],["間","あいだ"],["の"],["仲保者","ちゅうほしゃ"],["も"],["ただ"],["ひとり"],["で"],["あって"],["、"],["それ"],["は"],["人","ひと"],["なる"],["キリスト"],["・"],["イエス"],["で"],["ある"],["。"]]},{"verse":6,"text":"彼,かれは、すべての人,ひとのあがないとしてご自身,じしんをささげられたが、それは、定,さだめられた時,ときになされたあかしにほかならない。","tok":[["彼","かれ"],["は"],["、"],["すべて"],["の"],["人","ひと"],["の"],["あ"],["が"],["ない"],["として"],["ご自身","ごじしん"],["を"],["ささげられた"],["が"],["、"],["それ"],["は"],["、"],["定められた","さだめられた"],["時","とき"],["に"],["なされた"],["あかし"],["に"],["ほか"],["ならない"],["。"]]},{"verse":7,"text":"そのために、わたしは立,たてられて宣教者,せんきょうしゃ、使徒,しととなり（わたしは真実,しんじつを言,いっている、偽,いつわってはいない）、また異邦人,いほうじんに信仰,しんこうと真理,しんりとを教,おしえる教師,きょうしとなったのである。","tok":[["その"],["ため"],["に"],["、"],["わたし"],["は"],["立られて","たてられて"],["宣教者","せんきょうしゃ"],["、"],["使徒","しと"],["と"],["なり"],["（"],["わたし"],["は"],["真実","しんじつ"],["を"],["言って","いって"],["いる"],["、"],["偽わって","いつわって"],["は"],["いない"],["）"],["、"],["また"],["異邦人","いほうじん"],["に"],["信仰","しんこう"],["と"],["真理","しんり"],["と"],["を"],["教える","おしえる"],["教師","きょうし"],["と"],["なった"],["ので"],["ある"],["。"]]},{"verse":8,"text":"男,おとこは、怒,いかったり争,あらそったりしないで、どんな場所,ばしょでも、きよい手,てをあげて祈,いのってほしい。","tok":[["男","おとこ"],["は"],["、"],["怒","い"],["かっ"],["たり"],["争っ","あらそっ"],["たり"],["しないで"],["、"],["どんな"],["場所","ばしょ"],["で"],["も"],["、"],["きよい"],["手","て"],["を"],["あげて"],["祈って","いのって"],["ほしい"],["。"]]},{"verse":9,"text":"また、女,おんなはつつましい身,みなりをし、適度,てきどに慎,つつしみ深,ぶかく身,みを飾,かざるべきであって、髪,かみを編,あんだり、金,きんや真珠,しんじゅをつけたり、高価,こうかな着物,きものを着,きたりしてはいけない。","tok":[["また"],["、"],["女","おんな"],["は"],["つつましい"],["身なり","みなり"],["を"],["し"],["、"],["適度","てきど"],["に"],["慎しみ深く","つつしみぶかく"],["身","み"],["を"],["飾るべきで","かざるべきで"],["あって"],["、"],["髪","かみ"],["を"],["編ん","あん"],["だり"],["、"],["金","きん"],["や"],["真珠","しんじゅ"],["を"],["つけ"],["たり"],["、"],["高価","こうか"],["な"],["着物","きもの"],["を"],["着","き"],["たり"],["して"],["は"],["いけない"],["。"]]},{"verse":10,"text":"むしろ、良,よいわざをもって飾,かざりとすることが、信仰,しんこうを言,いいあらわしている女,おんなに似,につかわしい。","tok":[["むしろ"],["、"],["良い","よい"],["わざ"],["を"],["もって"],["飾","かざり"],["と"],["する"],["こと"],["が"],["、"],["信仰","しんこう"],["を"],["言いあらわして","いいあらわして"],["いる"],["女","おんな"],["に"],["似つかわしい","につかわしい"],["。"]]},{"verse":11,"text":"女,おんなは静,しずかにしていて、万事,ばんじにつけ従順,じゅうじゅんに教,おしえを学,まなぶがよい。","tok":[["女","おんな"],["は"],["静","しずか"],["に"],["して"],["いて"],["、"],["万事","ばんじ"],["に"],["つけ"],["従順","じゅうじゅん"],["に"],["教え","おしえ"],["を"],["学ぶ","まなぶ"],["が"],["よい"],["。"]]},{"verse":12,"text":"女,おんなが教,おしえたり、男,おとこの上,うえに立,たったりすることを、わたしは許,ゆるさない。むしろ、静,しずかにしているべきである。","tok":[["女","おんな"],["が"],["教え","おしえ"],["たり"],["、"],["男","おとこ"],["の"],["上","うえ"],["に"],["立っ","たっ"],["たり"],["する"],["こと"],["を"],["、"],["わたし"],["は"],["許さない","ゆるさない"],["。"],["むしろ"],["、"],["静","しずか"],["に"],["して"],["いるべきで"],["ある"],["。"]]},{"verse":13,"text":"なぜなら、アダムがさきに造,つくられ、それからエバが造,つくられたからである。","tok":[["なぜ"],["なら"],["、"],["アダム"],["が"],["さき"],["に"],["造られ","つくられ"],["、"],["それ"],["から"],["エバ"],["が"],["造られた","つくられた"],["から"],["で"],["ある"],["。"]]},{"verse":14,"text":"またアダムは惑,まどわされなかったが、女,おんなは惑,まどわされて、あやまちを犯,おかした。","tok":[["また"],["アダム"],["は"],["惑わされなかった","まどわされなかった"],["が"],["、"],["女","おんな"],["は"],["惑わされて","まどわされて"],["、"],["あやまち"],["を"],["犯した","おかした"],["。"]]},{"verse":15,"text":"しかし、女,おんなが慎,つつしみ深,ぶかく、信仰,しんこうと愛,あいと清,きよさとを持,もち続,つづけるなら、子,こを産,うむことによって救,すくわれるであろう。","tok":[["しかし"],["、"],["女","おんな"],["が"],["慎しみ深く","つつしみぶかく"],["、"],["信仰","しんこう"],["と"],["愛","あい"],["と"],["清","きよ"],["さ"],["と"],["を"],["持","もち"],["続けるなら","つづけるなら"],["、"],["子","こ"],["を"],["産む","うむ"],["こと"],["によって"],["救われるで","すくわれるで"],["あろう"],["。"]]}]
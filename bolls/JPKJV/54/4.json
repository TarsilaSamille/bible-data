[{"verse":1,"text":"しかし、御霊,みたまは明,あきらかに告,つげて言,いう。後,のちの時,ときになると、ある人々,ひとびとは、惑,まどわす霊,れいと悪霊,あくりょうの教,おしえとに気,きをとられて、信仰,しんこうから離,はなれ去,さるであろう。","tok":[["しかし"],["、"],["御霊","みたま"],["は"],["明か","あきらか"],["に"],["告","つげ"],["て"],["言う","いう"],["。"],["後","のち"],["の"],["時","とき"],["に"],["なる"],["と"],["、"],["ある"],["人々","ひとびと"],["は"],["、"],["惑わす","まどわす"],["霊","れい"],["と"],["悪霊","あくりょう"],["の"],["教え","おしえ"],["と"],["に"],["気","き"],["を"],["とられて"],["、"],["信仰","しんこう"],["から"],["離れ去るで","はなれさるで"],["あろう"],["。"]]},{"verse":2,"text":"それは、良心,りょうしんに焼,やき印,いんをおされている偽,いつわり者,ものの偽善,ぎぜんのしわざである。","tok":[["それ"],["は"],["、"],["良心","りょうしん"],["に"],["焼き印","やきいん"],["を"],["おされて"],["いる"],["偽わり","いつわり"],["者","もの"],["の"],["偽善","ぎぜん"],["の"],["しわざ"],["で"],["ある"],["。"]]},{"verse":3,"text":"これらの偽,いつわり者,ものどもは、結婚,けっこんを禁,きんじたり、食物,しょくもつを断,たつことを命,めいじたりする。しかし食物,しょくもつは、信仰,しんこうがあり真理,しんりを認,みとめる者,ものが、感謝,かんしゃして受,うけるようにと、神,かみの造,つくられたものである。","tok":[["これ"],["ら"],["の"],["偽わり","いつわり"],["者","もの"],["ども"],["は"],["、"],["結婚","けっこん"],["を"],["禁じ","きんじ"],["たり"],["、"],["食物","しょくもつ"],["を"],["断つ","たつ"],["こと"],["を"],["命じ","めいじ"],["たり"],["する"],["。"],["しかし"],["食物","しょくもつ"],["は"],["、"],["信仰","しんこう"],["が"],["あり"],["真理","しんり"],["を"],["認める","みとめる"],["者","もの"],["が"],["、"],["感謝","かんしゃ"],["して"],["受る","うける"],["よう"],["に"],["と"],["、"],["神","かみ"],["の"],["造られた","つくられた"],["もの"],["で"],["ある"],["。"]]},{"verse":4,"text":"神,かみの造,つくられたものは、みな良,よいものであって、感謝,かんしゃして受,うけるなら、何,なにひとつ捨,すてるべきものはない。","tok":[["神","かみ"],["の"],["造られた","つくられた"],["もの"],["は"],["、"],["みな"],["良い","よい"],["もの"],["で"],["あって"],["、"],["感謝","かんしゃ"],["して"],["受るなら","うけるなら"],["、"],["何","な"],["に"],["ひと"],["つ"],["捨てるべき","すてるべき"],["もの"],["は"],["ない"],["。"]]},{"verse":5,"text":"それらは、神,かみの言,ことばと祈,いのりとによって、きよめられるからである。","tok":[["それ"],["ら"],["は"],["、"],["神","かみ"],["の"],["言","こ"],["と"],["ば"],["と"],["祈","いのり"],["と"],["によって"],["、"],["きよめられる"],["から"],["で"],["ある"],["。"]]},{"verse":6,"text":"これらのことを兄弟,きょうだいたちに教,おしえるなら、あなたは、信仰,しんこうの言葉,ことばとあなたの従,したがってきた良,よい教,おしえの言葉,ことばとに養,やしなわれて、キリスト・イエスのよい奉仕者,ほうししゃになるであろう。","tok":[["これ"],["ら"],["の"],["こと"],["を"],["兄弟","きょうだい"],["たち"],["に"],["教えるなら","おしえるなら"],["、"],["あなた"],["は"],["、"],["信仰","しんこう"],["の"],["言葉","ことば"],["と"],["あなた"],["の"],["従って","したがって"],["きた"],["良い","よい"],["教え","おしえ"],["の"],["言葉","ことば"],["と"],["に"],["養われて","やしなわれて"],["、"],["キリスト"],["・"],["イエス"],["の"],["よい"],["奉仕者","ほうししゃ"],["に"],["なるで"],["あろう"],["。"]]},{"verse":7,"text":"しかし、俗悪,ぞくあくで愚,ぐにもつかない作,つくり話,ばなしは避,さけなさい。信心,しんじんのために自分,じぶんを訓練,くんれんしなさい。","tok":[["しかし"],["、"],["俗悪","ぞくあく"],["で"],["愚","ぐ"],["に"],["も"],["つかない"],["作り話","つくりばなし"],["は"],["避け","さけ"],["なさい"],["。"],["信心","しんじん"],["の"],["ため"],["に"],["自分","じぶん"],["を"],["訓練","くんれん"],["し"],["なさい"],["。"]]},{"verse":8,"text":"からだの訓練,くんれんは少,すこしは益,えきするところがあるが、信心,しんじんは、今,いまのいのちと後,のちの世,よのいのちとが約束,やくそくされてあるので、万事,ばんじに益,えきとなる。","tok":[["からだ"],["の"],["訓練","くんれん"],["は"],["少し","すこし"],["は"],["益する","えきする"],["ところ"],["が"],["ある"],["が"],["、"],["信心","しんじん"],["は"],["、"],["今","いま"],["の"],["いのち"],["と"],["後の世","のちのよ"],["の"],["いのち"],["と"],["が"],["約束","やくそく"],["されて"],["ある"],["ので"],["、"],["万事","ばんじ"],["に"],["益","えき"],["と"],["なる"],["。"]]},{"verse":9,"text":"これは確実,かくじつで、そのまま受,うけいれるに足,たる言葉,ことばである。","tok":[["これ"],["は"],["確実","かくじつ"],["で"],["、"],["そのまま"],["受","うけ"],["いれる"],["に"],["足る","たる"],["言葉","ことば"],["で"],["ある"],["。"]]},{"verse":10,"text":"わたしたちは、このために労,ろうし苦,くるしんでいる。それは、すべての人,ひとの救主,すくいぬし、特,とくに信,しんじる者,ものたちの救主,すくいぬしなる生,いける神,かみに、望,のぞみを置,おいてきたからである。","tok":[["わたしたち"],["は"],["、"],["この"],["ため"],["に"],["労し","ろうし"],["苦しんで","くるしんで"],["いる"],["。"],["それ"],["は"],["、"],["すべて"],["の"],["人","ひと"],["の"],["救主","す"],["くいぬ"],["し"],["、"],["特に","とくに"],["信じる","しんじる"],["者","もの"],["たち"],["の"],["救主","す"],["くい"],["ぬし"],["なる"],["生ける","いける"],["神","かみ"],["に"],["、"],["望み","のぞみ"],["を"],["置いて","おいて"],["きた"],["から"],["で"],["ある"],["。"]]},{"verse":11,"text":"これらの事,ことを命,めいじ、また教,おしえなさい。","tok":[["これ"],["ら"],["の"],["事","こと"],["を"],["命じ","めいじ"],["、"],["また"],["教え","おしえ"],["なさい"],["。"]]},{"verse":12,"text":"あなたは、年,としが若,わかいために人,ひとに軽,かろんじられてはならない。むしろ、言葉,ことばにも、行状,ぎょうじょうにも、愛,あいにも、信仰,しんこうにも、純潔,じゅんけつにも、信者,しんじゃの模範,もはんになりなさい。","tok":[["あなた"],["は"],["、"],["年","と"],["し"],["が"],["若い","わかい"],["ため"],["に"],["人","ひと"],["に"],["軽んじられて","かろんじられて"],["は"],["ならない"],["。"],["むしろ"],["、"],["言葉","ことば"],["に"],["も"],["、"],["行状","ぎょうじょう"],["に"],["も"],["、"],["愛","あい"],["に"],["も"],["、"],["信仰","しんこう"],["に"],["も"],["、"],["純潔","じゅんけつ"],["に"],["も"],["、"],["信者","しんじゃ"],["の"],["模範","もはん"],["に"],["なり"],["なさい"],["。"]]},{"verse":13,"text":"わたしがそちらに行,ゆく時,ときまで、聖書,せいしょを朗読,ろうどくすることと、勧,すすめをすることと、教,おしえることとに心,こころを用,もちいなさい。","tok":[["わたし"],["が"],["そちら"],["に"],["行く","ゆく"],["時","とき"],["まで"],["、"],["聖書","せいしょ"],["を"],["朗読","ろうどく"],["する"],["こと"],["と"],["、"],["勧め","すすめ"],["を"],["する"],["こと"],["と"],["、"],["教る","おしえる"],["こと"],["と"],["に"],["心","こころ"],["を"],["用い","もちい"],["なさい"],["。"]]},{"verse":14,"text":"長老,ちょうろうの按手,あんしゅを受,うけた時,とき、預言,よげんによってあなたに与,あたえられて内,うちに持,もっている恵,めぐみの賜物,たまものを、軽視,けいししてはならない。","tok":[["長老","ちょうろう"],["の"],["按手","あんしゅ"],["を"],["受た","うけた"],["時","とき"],["、"],["預言","よげん"],["によって"],["あなた"],["に"],["与えられて","あたえられて"],["内","うち"],["に"],["持って","もって"],["いる"],["恵","めぐみ"],["の"],["賜物","たまもの"],["を"],["、"],["軽視","けいし"],["して"],["は"],["ならない"],["。"]]},{"verse":15,"text":"すべての事,ことにあなたの進歩,しんぽがあらわれるため、これらの事,ことを実行,じっこうし、それを励,はげみなさい。","tok":[["すべて"],["の"],["事","こと"],["に"],["あなた"],["の"],["進歩","しんぽ"],["が"],["あらわれる"],["ため"],["、"],["これ"],["ら"],["の"],["事","こと"],["を"],["実行","じっこう"],["し"],["、"],["それ"],["を"],["励み","はげみ"],["なさい"],["。"]]},{"verse":16,"text":"自分,じぶんのことと教,おしえのこととに気,きをつけ、それらを常,つねに努,つとめなさい。そうすれば、あなたは、自分,じぶん自身,じしんとあなたの教,おしえを聞,きく者,ものたちとを、救,すくうことになる。","tok":[["自分","じぶん"],["の"],["こと"],["と"],["教え","おしえ"],["の"],["こと"],["と"],["に"],["気","き"],["を"],["つけ"],["、"],["それ"],["ら"],["を"],["常","つね"],["に"],["努め","つとめ"],["なさい"],["。"],["そう"],["すれば"],["、"],["あなた"],["は"],["、"],["自分","じぶん"],["自身","じしん"],["と"],["あなた"],["の"],["教え","おしえ"],["を"],["聞く","きく"],["者","もの"],["たち"],["と"],["を"],["、"],["救う","すくう"],["こと"],["に"],["なる"],["。"]]}]
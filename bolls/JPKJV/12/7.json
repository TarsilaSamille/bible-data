[{"verse":1,"text":"エリシャは言,いった、「主,しゅの言葉,ことばを聞,ききなさい。主,しゅはこう仰,おおせられる、『あすの今,いまごろサマリヤの門,もんで、麦粉,むぎこ一セアを一シケルで売,うり、大麦,おおむぎ二セアを一シケルで売,うるようになるであろう』」。","tok":[["エリシャ"],["は"],["言った","いった"],["、"],["「"],["主","しゅ"],["の"],["言葉","ことば"],["を"],["聞","きき"],["なさい"],["。"],["主","しゅ"],["は"],["こう"],["仰せられる","おおせられる"],["、"],["『"],["あす"],["の"],["今ごろ","いまごろ"],["サマリヤ"],["の"],["門","もん"],["で"],["、"],["麦粉","むぎこ"],["一","いち"],["セア"],["を"],["一","いち"],["シケル"],["で"],["売","うり"],["、"],["大麦","おおむぎ"],["二","に"],["セア"],["を"],["一","いち"],["シケル"],["で"],["売る","うる"],["よう"],["に"],["なるで"],["あろう"],["』"],["」"],["。"]]},{"verse":2,"text":"時,ときにひとりの副官,ふくかんすなわち王,おうがその人,ひとの手,てによりかかっていた者,ものが神,かみの人,ひとに答,こたえて言,いった、「たとい主,しゅが天,てんに窓,まどを開,ひらかれても、そんな事,ことがありえましょうか」。エリシャは言,いった、「あなたは自分,じぶんの目,めをもってそれを見,みるであろう。しかしそれを食,たべることはなかろう」。","tok":[["時","とき"],["に"],["ひとり"],["の"],["副官","ふくかん"],["すなわち"],["王","おう"],["が"],["その"],["人","ひと"],["の"],["手","て"],["に"],["より"],["かかって"],["いた"],["者","もの"],["が"],["神","かみ"],["の"],["人","ひと"],["に"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["たとい"],["主","しゅ"],["が"],["天","てん"],["に"],["窓","まど"],["を"],["開らかれて","ひらかれて"],["も"],["、"],["そんな"],["事","こと"],["が"],["あり"],["えましょう"],["か"],["」"],["。"],["エリシャ"],["は"],["言った","いった"],["、"],["「"],["あなた"],["は"],["自分","じぶん"],["の"],["目","め"],["を"],["もって"],["それ"],["を"],["見るで","みるで"],["あろう"],["。"],["しかし"],["それ"],["を"],["食べる","たべる"],["こと"],["は"],["なかろう"],["」"],["。"]]},{"verse":3,"text":"さて町,まちの門,もんの入口,いりぐちに四人,にんのらい病人,びょうにんがいたが、彼,かれらは互,たがいに言,いった、「われわれはどうしてここに座,ざして死,しを待,またねばならないのか。","tok":[["さて"],["町","まち"],["の"],["門","もん"],["の"],["入口","いりぐち"],["に"],["四人","にん"],["の"],["らい病人","らいびょうにん"],["が"],["いた"],["が"],["、"],["彼","かれ"],["ら"],["は"],["互","たがい"],["に"],["言った","いった"],["、"],["「"],["われわれ"],["は"],["どう"],["して"],["ここ"],["に"],["座して","ざして"],["死","し"],["を"],["待たねば","またねば"],["ならない"],["の"],["か"],["。"]]},{"verse":4,"text":"われわれがもし町,まちにはいろうといえば、町,まちには食物,しょくもつが尽,つきているから、われわれはそこで死,しぬであろう。しかしここに座,ざしていても死,しぬのだ。いっその事,こと、われわれはスリヤびとの陣営,じんえいへ逃,にげて行,いこう。もし彼,かれらがわれわれを生,いかしておいてくれるならば、助,たすかるが、たといわれわれを殺,ころしても死,しぬばかりだ」。","tok":[["われわれ"],["が"],["もし"],["町","まち"],["に"],["はいろう"],["と"],["いえば"],["、"],["町","まち"],["に"],["は"],["食物","しょくもつ"],["が"],["尽て","つきて"],["いる"],["から"],["、"],["われわれ"],["は"],["そこ"],["で"],["死ぬで","しぬで"],["あろう"],["。"],["しかし"],["ここ"],["に"],["座して","ざして"],["いて"],["も"],["死ぬ","しぬ"],["の"],["だ"],["。"],["いっそ"],["の"],["事","こと"],["、"],["われわれ"],["は"],["スリヤ"],["びと"],["の"],["陣営","じんえい"],["へ"],["逃て","にげて"],["行こう","いこう"],["。"],["もし"],["彼","かれ"],["ら"],["が"],["われわれ"],["を"],["生かして","いかして"],["おいて"],["くれるならば"],["、"],["助かる","たすかる"],["が"],["、"],["たとい"],["われわれ"],["を"],["殺ろして","ころして"],["も"],["死ぬ","しぬ"],["ばかり"],["だ"],["」"],["。"]]},{"verse":5,"text":"そこで彼,かれらはスリヤびとの陣営,じんえいへ行,いこうと、たそがれに立,たちあがったが、スリヤびとの陣営,じんえいのほとりに行,いって見,みると、そこにはだれもいなかった。","tok":[["そこ"],["で"],["彼","かれ"],["ら"],["は"],["スリヤ"],["びと"],["の"],["陣営","じんえい"],["へ"],["行こう","いこう"],["と"],["、"],["たそがれ"],["に"],["立ちあがった","たちあがった"],["が"],["、"],["スリヤ"],["びと"],["の"],["陣営","じんえい"],["の"],["ほとり"],["に"],["行って","いって"],["見る","みる"],["と"],["、"],["そこ"],["に"],["は"],["だれ"],["も"],["いなかった"],["。"]]},{"verse":6,"text":"これは主,しゅがスリヤびとの軍勢,ぐんぜいに戦車,せんしゃの音,おと、馬,うまの音,おと、大軍,たいぐんの音,おとを聞,きかせられたので、彼,かれらは互,たがいに「見,みよ、イスラエルの王,おうがわれわれを攻,せめるために、ヘテびとの王,おうたちおよびエジプトの王,おうたちを雇,やとってきて、われわれを襲,おそうのだ」と言,いって、","tok":[["これ"],["は"],["主","しゅ"],["が"],["スリヤ"],["びと"],["の"],["軍勢","ぐんぜい"],["に"],["戦車","せんしゃ"],["の"],["音","おと"],["、"],["馬","うま"],["の"],["音","おと"],["、"],["大軍","たいぐん"],["の"],["音","おと"],["を"],["聞かせられた","きかせられた"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["互","たがい"],["に"],["「"],["見よ","みよ"],["、"],["イスラエル"],["の"],["王","おう"],["が"],["われわれ"],["を"],["攻める","せめる"],["ため"],["に"],["、"],["ヘテ"],["びと"],["の"],["王","おう"],["たち"],["および"],["エジプト"],["の"],["王","おう"],["たち"],["を"],["雇って","やとって"],["きて"],["、"],["われわれ"],["を"],["襲う","おそう"],["の"],["だ"],["」"],["と"],["言って","いって"],["、"]]},{"verse":7,"text":"たそがれに立,たって逃,にげ、その天幕,てんまくと、馬,うまと、ろばを捨,すて、陣営,じんえいをそのままにしておいて、命,いのちを全,まっとうしようと逃,にげたからである。","tok":[["たそがれ"],["に"],["立って","たって"],["逃","にげ"],["、"],["その"],["天幕","てんまく"],["と"],["、"],["馬","うま"],["と"],["、"],["ろば"],["を"],["捨て","すて"],["、"],["陣営","じんえい"],["を"],["そのまま"],["に"],["して"],["おいて"],["、"],["命","いのち"],["を"],["全う","まっとう"],["しよう"],["と"],["逃た","にげた"],["から"],["で"],["ある"],["。"]]},{"verse":8,"text":"そこでらい病人,びょうにんたちは陣営,じんえいのほとりに行,いき、一つの天幕,てんまくにはいって食,くい飲,のみし、そこから金銀,きんぎん、衣服,いふくを持,もち出,だしてそれを隠,かくし、また来,きて、他,たの天幕,てんまくに入,はいり、そこからも持,もち出,だしてそれを隠,かくした。","tok":[["そこ"],["で"],["らい病人","らいびょうにん"],["たち"],["は"],["陣営","じんえい"],["の"],["ほとり"],["に"],["行き","いき"],["、"],["一","ひと"],["つ"],["の"],["天幕","てんまく"],["に"],["はいって"],["食い","くい"],["飲み","のみ"],["し"],["、"],["そこ"],["から"],["金銀","きんぎん"],["、"],["衣服","いふく"],["を"],["持出して","もちだして"],["それ"],["を"],["隠し","かくし"],["、"],["また"],["来て","きて"],["、"],["他","た"],["の"],["天幕","てんまく"],["に"],["入り","はいり"],["、"],["そこ"],["から"],["も"],["持出して","もちだして"],["それ"],["を"],["隠した","かくした"],["。"]]},{"verse":9,"text":"そして彼,かれらは互,たがいに言,いった、「われわれのしている事,ことはよくない。きょうは良,よいおとずれのある日,ひであるのに、黙,だまっていて、夜明,よあけまで待,まつならば、われわれは罰,ばつをこうむるであろう。さあ、われわれは行,いって王,おうの家族,かぞくに告,つげよう」。","tok":[["そして"],["彼","かれ"],["ら"],["は"],["互","たがい"],["に"],["言った","いった"],["、"],["「"],["われわれ"],["の"],["して"],["いる"],["事","こと"],["は"],["よく"],["ない"],["。"],["きょう"],["は"],["良い","よい"],["おとずれ"],["の"],["ある"],["日","ひ"],["で"],["ある"],["のに"],["、"],["黙って","だまって"],["いて"],["、"],["夜明","よあけ"],["まで"],["待つならば","まつならば"],["、"],["われわれ"],["は"],["罰","ばつ"],["を"],["こうむるで"],["あろう"],["。"],["さあ"],["、"],["われわれ"],["は"],["行って","いって"],["王","おう"],["の"],["家族","かぞく"],["に"],["告","つげ"],["よう"],["」"],["。"]]},{"verse":10,"text":"そこで彼,かれらは来,きて、町,まちの門,もんを守,まもる者,ものを呼,よんで言,いった、「わたしたちがスリヤびとの陣営,じんえいに行,いって見,みると、そこにはだれの姿,すがたも見,みえず、また人声,ひとごえもなく、ただ、馬,うまとろばがつないであり、天幕,てんまくはそのままでした」。","tok":[["そこ"],["で"],["彼","かれ"],["ら"],["は"],["来て","きて"],["、"],["町","まち"],["の"],["門","もん"],["を"],["守者","まもるもの"],["を"],["呼んで","よんで"],["言った","いった"],["、"],["「"],["わたしたち"],["が"],["スリヤ"],["びと"],["の"],["陣営","じんえい"],["に"],["行って","いって"],["見る","みる"],["と"],["、"],["そこ"],["に"],["は"],["だれ"],["の"],["姿","すがた"],["も"],["見えず","みえず"],["、"],["また"],["人声","ひとごえ"],["も"],["なく"],["、"],["ただ"],["、"],["馬","うま"],["と"],["ろば"],["が"],["つないで"],["あり"],["、"],["天幕","てんまく"],["は"],["そのまま"],["でした"],["」"],["。"]]},{"verse":11,"text":"そこで門,もんを守,まもる者,ものは呼,よばわって、それを王,おうの家族,かぞくのうちに知,しらせた。","tok":[["そこ"],["で"],["門","もん"],["を"],["守者","まもるもの"],["は"],["呼ばわって","よばわって"],["、"],["それ"],["を"],["王","おう"],["の"],["家族","かぞく"],["の"],["うち"],["に"],["知らせた","しらせた"],["。"]]},{"verse":12,"text":"王,おうは夜,よるのうちに起,おきて、家来,けらいたちに言,いった、「スリヤびとがわれわれに対,たいして図,はかっている事,ことをあなたがたに告,つげよう。彼,かれらは、われわれの飢,うえているのを知,しって、陣営,じんえいを出,でて野,のに隠,かくれ、『イスラエルびとが町,まちを出,でたら、いけどりにして、町,まちに押,おし入,いろう』と考,かんがえているのだ」。","tok":[["王","おう"],["は"],["夜","よる"],["の"],["うち"],["に"],["起きて","おきて"],["、"],["家来","けらい"],["たち"],["に"],["言った","いった"],["、"],["「"],["スリヤ"],["びと"],["が"],["われわれ"],["に対して","にたいして"],["図って","はかって"],["いる"],["事","こと"],["を"],["あなた"],["がた"],["に"],["告","つげ"],["よう"],["。"],["彼","かれ"],["ら"],["は"],["、"],["われわれ"],["の"],["飢","うえ"],["て"],["いる"],["の"],["を"],["知って","しって"],["、"],["陣営","じんえい"],["を"],["出て","でて"],["野","の"],["に"],["隠れ","かくれ"],["、"],["『"],["イスラエル"],["びと"],["が"],["町","まち"],["を"],["出たら","でたら"],["、"],["いけどり"],["に"],["して"],["、"],["町","まち"],["に"],["押入ろう","おしいろう"],["』"],["と"],["考","かんがえ"],["て"],["いる"],["の"],["だ"],["」"],["。"]]},{"verse":13,"text":"家来,けらいのひとりが答,こたえて言,いった、「人々,ひとびとに、ここに残,のこっている馬,うまのうち五頭,とうを連,つれてこさせてください。ここに残,のこっているこれらの人々,ひとびとは、すでに滅,ほろびうせたイスラエルの全,ぜん群衆,ぐんしゅうと同,おなじ運命,うんめいにあうのですから。わたしたちは人,ひとをやってうかがわせましょう」。","tok":[["家来","けらい"],["の"],["ひとり"],["が"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["人々","ひとびと"],["に"],["、"],["ここ"],["に"],["残って","のこって"],["いる"],["馬","うま"],["の"],["うち"],["五頭","とう"],["を"],["連れて","つれて"],["こさせて"],["ください"],["。"],["ここ"],["に"],["残って","のこって"],["いる"],["これ"],["ら"],["の"],["人々","ひとびと"],["は"],["、"],["すでに"],["滅び","ほろび"],["うせた"],["イスラエル"],["の"],["全","ぜん"],["群衆","ぐんしゅう"],["と"],["同じ","おなじ"],["運命","うんめい"],["に"],["あう"],["の"],["です"],["から"],["。"],["わたしたち"],["は"],["人","ひと"],["を"],["やって"],["うかがわせましょう"],["」"],["。"]]},{"verse":14,"text":"そこで彼,かれらはふたりの騎兵,きへいを選,えらんだ。王,おうはそれをつかわし、「行,いって見,みよ」と言,いって、スリヤびとの軍勢,ぐんぜいのあとをつけさせたので、","tok":[["そこ"],["で"],["彼","かれ"],["ら"],["は"],["ふたり"],["の"],["騎兵","きへい"],["を"],["選らんだ","えらんだ"],["。"],["王","おう"],["は"],["それ"],["を"],["つかわし"],["、"],["「"],["行って","いって"],["見よ","みよ"],["」"],["と"],["言って","いって"],["、"],["スリヤ"],["びと"],["の"],["軍勢","ぐんぜい"],["の"],["あと"],["を"],["つけさせた"],["ので"],["、"]]},{"verse":15,"text":"彼,かれらはそのあとを追,おってヨルダンまで行,いったが、道,みちにはすべて、スリヤびとがあわてて逃,にげる時,ときに捨,すてていった衣服,いふくと武器,ぶきが散,ちらばっていた。その使者,ししゃは帰,かえってきて、これを王,おうに告,つげた。","tok":[["彼","かれ"],["ら"],["は"],["その"],["あと"],["を"],["追って","おって"],["ヨルダン"],["まで"],["行った","いった"],["が"],["、"],["道","みち"],["に"],["は"],["すべて"],["、"],["スリヤ"],["びと"],["が"],["あわてて"],["逃る","にげる"],["時","とき"],["に"],["捨てて","すてて"],["いった"],["衣服","いふく"],["と"],["武器","ぶき"],["が"],["散らばって","ちらばって"],["いた"],["。"],["その"],["使者","ししゃ"],["は"],["帰えって","かえって"],["きて"],["、"],["これ"],["を"],["王","おう"],["に"],["告","つげ"],["た"],["。"]]},{"verse":16,"text":"そこで民,たみが出,でていって、スリヤびとの陣営,じんえいをかすめたので、麦粉,むぎこ一セアは一シケルで売,うられ、大麦,おおむぎ二セアは一シケルで売,うられ、主,しゅの言葉,ことばのとおりになった。","tok":[["そこ"],["で"],["民","たみ"],["が"],["出て","でて"],["いって"],["、"],["スリヤ"],["びと"],["の"],["陣営","じんえい"],["を"],["かすめた"],["ので"],["、"],["麦粉","むぎこ"],["一","いち"],["セア"],["は"],["一","いち"],["シケル"],["で"],["売られ","うられ"],["、"],["大麦","おおむぎ"],["二","に"],["セア"],["は"],["一","いち"],["シケル"],["で"],["売られ","うられ"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["の"],["とおり"],["に"],["なった"],["。"]]},{"verse":17,"text":"王,おうは自分,じぶんがその人,ひとの手,てによりかかっていた、あの副官,ふくかんを立,たてて門,もんを管理,かんりさせたが、民,たみは門,もんで彼,かれを踏,ふみつけたので、彼,かれは死,しんだ。すなわち、王,おうが神,かみの人,ひとのところに下,くだってきた時,とき、神,かみの人,ひとが言,いったとおりであった。","tok":[["王","おう"],["は"],["自分","じぶん"],["が"],["その"],["人","ひと"],["の"],["手","て"],["に"],["より"],["かかって"],["いた"],["、"],["あの"],["副官","ふくかん"],["を"],["立てて","たてて"],["門","もん"],["を"],["管理","かんり"],["させた"],["が"],["、"],["民","たみ"],["は"],["門","もん"],["で"],["彼","かれ"],["を"],["踏みつけた","ふみつけた"],["ので"],["、"],["彼","かれ"],["は"],["死んだ","しんだ"],["。"],["すなわち"],["、"],["王","おう"],["が"],["神","かみ"],["の"],["人","ひと"],["の"],["ところ"],["に"],["下って","くだって"],["きた"],["時","とき"],["、"],["神","かみ"],["の"],["人","ひと"],["が"],["言った","いった"],["とおり"],["で"],["あった"],["。"]]},{"verse":18,"text":"これは神,かみの人,ひとが王,おうにむかって、「あすの今,いまごろ、サマリヤの門,もんで大麦,おおむぎ二セアを一シケルで売,うり、麦粉,むぎこ一セアを一シケルで売,うるようになるであろう」と言,いったときに、","tok":[["これ"],["は"],["神","かみ"],["の"],["人","ひと"],["が"],["王","おう"],["に"],["むかって"],["、"],["「"],["あす"],["の"],["今ごろ","いまごろ"],["、"],["サマリヤ"],["の"],["門","もん"],["で"],["大麦","おおむぎ"],["二","に"],["セア"],["を"],["一","いち"],["シケル"],["で"],["売","うり"],["、"],["麦粉","むぎこ"],["一","いち"],["セア"],["を"],["一","いち"],["シケル"],["で"],["売る","うる"],["よう"],["に"],["なるで"],["あろう"],["」"],["と"],["言った","いった"],["とき"],["に"],["、"]]},{"verse":19,"text":"その副官,ふくかんが神,かみの人,ひとに答,こたえて、「たとい主,しゅが天,てんに窓,まどを開,ひらかれても、そんな事,ことがありえようか」と言,いったからである。そのとき神,かみの人,ひとは「あなたは自分,じぶんの目,めをもってそれを見,みるであろう。しかしそれを食,たべることはなかろう」と言,いったが、","tok":[["その"],["副官","ふくかん"],["が"],["神","かみ"],["の"],["人","ひと"],["に"],["答","こたえ"],["て"],["、"],["「"],["たとい"],["主","しゅ"],["が"],["天","てん"],["に"],["窓","まど"],["を"],["開らかれて","ひらかれて"],["も"],["、"],["そんな"],["事","こと"],["が"],["あり"],["えよう"],["か"],["」"],["と"],["言った","いった"],["から"],["で"],["ある"],["。"],["その"],["とき"],["神","かみ"],["の"],["人","ひと"],["は"],["「"],["あなた"],["は"],["自分","じぶん"],["の"],["目","め"],["を"],["もって"],["それ"],["を"],["見るで","みるで"],["あろう"],["。"],["しかし"],["それ"],["を"],["食べる","たべる"],["こと"],["は"],["なかろう"],["」"],["と"],["言った","いった"],["が"],["、"]]},{"verse":20,"text":"これはそのとおり彼,かれに臨,のぞんだ。すなわち民,たみが門,もんで彼,かれを踏,ふみつけたので彼,かれは死,しんだ。","tok":[["これ"],["は"],["その"],["とおり"],["彼","かれ"],["に"],["臨んだ","のぞんだ"],["。"],["すなわち"],["民","た"],["み"],["が"],["門","もん"],["で"],["彼","かれ"],["を"],["踏みつけた","ふみつけた"],["ので"],["彼","かれ"],["は"],["死んだ","しんだ"],["。"]]}]
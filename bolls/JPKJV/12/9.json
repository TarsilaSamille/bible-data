[{"verse":1,"text":"時,ときに預言者,よげんしゃエリシャは預言者,よげんしゃのともがらのひとりを呼,よんで言,いった、「腰,こしをひきからげ、この油,あぶらのびんを携,たずさえて、ラモテ・ギレアデへ行,いきなさい。","tok":[["時","とき"],["に"],["預言者","よげんしゃ"],["エリシャ"],["は"],["預言者","よげんしゃ"],["の"],["とも"],["がら"],["の"],["ひとり"],["を"],["呼んで","よんで"],["言った","いった"],["、"],["「"],["腰","こし"],["を"],["ひき"],["からげ"],["、"],["この"],["油","あぶら"],["の"],["びん"],["を"],["携えて","たずさえて"],["、"],["ラモテ"],["・"],["ギレアデ"],["へ"],["行き","いき"],["なさい"],["。"]]},{"verse":2,"text":"そこに着,ついたならば、ニムシの子,こヨシャパテの子,こであるエヒウを尋,たずね出,だし、内,うちにはいって彼,かれをその同僚,どうりょうたちのうちから立,たたせて、奥,おくの間,あいだに連,つれて行,いき、","tok":[["そこ"],["に"],["着いたならば","ついたならば"],["、"],["ニムシ"],["の"],["子","こ"],["ヨシャパテ"],["の"],["子","こ"],["で"],["ある"],["エヒウ"],["を"],["尋ね出し","たずねだし"],["、"],["内","うち"],["に"],["はいって"],["彼","かれ"],["を"],["その"],["同僚","どうりょう"],["たち"],["の"],["うち"],["から"],["立たせて","たたせて"],["、"],["奥","おく"],["の"],["間","あいだ"],["に"],["連れて","つれて"],["行き","いき"],["、"]]},{"verse":3,"text":"油,あぶらのびんを取,とって、その頭,あたまに注,そそぎ、『主,しゅはこう仰,おおせられる、わたしはあなたに油,あぶらを注,そそいでイスラエルの王,おうとする』と言,いい、そして戸,とをあけて逃,にげ去,さりなさい。とどまってはならない」。","tok":[["油","あぶら"],["の"],["びん"],["を"],["取って","とって"],["、"],["その"],["頭","あたま"],["に"],["注ぎ","そそぎ"],["、"],["『"],["主","しゅ"],["は"],["こう"],["仰せられる","おおせられる"],["、"],["わたし"],["は"],["あなた"],["に"],["油","あぶら"],["を"],["注いで","そそいで"],["イスラエル"],["の"],["王","おう"],["と"],["する"],["』"],["と"],["言い","いい"],["、"],["そして"],["戸","と"],["を"],["あけて"],["逃","にげ"],["去り","さり"],["なさい"],["。"],["とどまって"],["は"],["ならない"],["」"],["。"]]},{"verse":4,"text":"そこで預言者,よげんしゃであるその若者,わかものはラモテ・ギレアデへ行,いったが、","tok":[["そこ"],["で"],["預言者","よげんしゃ"],["で"],["ある"],["その"],["若者","わかもの"],["は"],["ラモテ"],["・"],["ギレアデ"],["へ"],["行った","いった"],["が"],["、"]]},{"verse":5,"text":"来,きて見,みると、軍勢,ぐんぜいの長,ちょうたちが会議,かいぎ中,ちゅうであったので、彼,かれは「将軍,しょうぐんよ、わたしはあなたに申,もうしあげる事,ことがあります」と言,いうと、エヒウが答,こたえて、「われわれすべてのうちの、だれにですか」と言,いったので、彼,かれは「将軍,しょうぐんよ、あなたにです」と言,いった。","tok":[["来て","きて"],["見る","みる"],["と"],["、"],["軍勢","ぐんぜい"],["の"],["長","ちょう"],["たち"],["が"],["会議中","かいぎちゅう"],["で"],["あった"],["ので"],["、"],["彼","かれ"],["は"],["「"],["将軍","しょうぐん"],["よ"],["、"],["わたし"],["は"],["あなた"],["に"],["申しあげる","もうしあげる"],["事","こと"],["が"],["あります"],["」"],["と"],["言","いう"],["と"],["、"],["エヒウ"],["が"],["答","こたえ"],["て"],["、"],["「"],["われわれ"],["すべて"],["の"],["うち"],["の"],["、"],["だれ"],["に"],["です"],["か"],["」"],["と"],["言った","いった"],["ので"],["、"],["彼","かれ"],["は"],["「"],["将軍","しょうぐん"],["よ"],["、"],["あなた"],["に"],["です"],["」"],["と"],["言った","いった"],["。"]]},{"verse":6,"text":"するとエヒウが立,たちあがって家,いえにはいったので、若者,わかものはその頭,あたまに油,あぶらを注,そそいで彼,かれに言,いった、「イスラエルの神,かみ、主,しゅはこう仰,おおせられます、『わたしはあなたに油,あぶらを注,そそいで、主,しゅの民,たみイスラエルの王,おうとする。","tok":[["する"],["と"],["エヒウ"],["が"],["立ちあがって","たちあがって"],["家","いえ"],["に"],["はいった"],["ので"],["、"],["若者","わかもの"],["は"],["その"],["頭","あたま"],["に"],["油","あぶら"],["を"],["注いで","そそいで"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["イスラエル"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["こう"],["仰せられます","おおせられます"],["、"],["『"],["わたし"],["は"],["あなた"],["に"],["油","あぶら"],["を"],["注いで","そそいで"],["、"],["主","しゅ"],["の"],["民","たみ"],["イスラエル"],["の"],["王","おう"],["と"],["する"],["。"]]},{"verse":7,"text":"あなたは主君,しゅくんアハブの家,いえを撃,うち滅,ほろぼさなければならない。それによってわたしは、わたしのしもべである預言者,よげんしゃたちの血,ちと、主,しゅのすべてのしもべたちの血,ちをイゼベルに報,むくいる。","tok":[["あなた"],["は"],["主君","しゅくん"],["アハブ"],["の"],["家","いえ"],["を"],["撃ち","うち"],["滅ぼさなければ","ほろぼさなければ"],["ならない"],["。"],["それ"],["によって"],["わたし"],["は"],["、"],["わたし"],["の"],["しもべ"],["で"],["ある"],["預言者","よげんしゃ"],["たち"],["の"],["血","ち"],["と"],["、"],["主","しゅ"],["の"],["すべて"],["の"],["しもべ"],["たち"],["の"],["血","ち"],["を"],["イゼベル"],["に"],["報いる","むくいる"],["。"]]},{"verse":8,"text":"アハブの全家,ぜんかは滅,ほろびるであろう。アハブに属,ぞくする男,おとこは、イスラエルにいて、つながれた者,ものも、自由,じゆうな者,ものも、ことごとくわたしは断,たち、","tok":[["アハブ"],["の"],["全","ぜん"],["家","いえ"],["は"],["滅びるで","ほろびるで"],["あろう"],["。"],["アハブ"],["に"],["属する","ぞくする"],["男","おとこ"],["は"],["、"],["イスラエル"],["に"],["いて"],["、"],["つながれた"],["者","もの"],["も"],["、"],["自由","じゆう"],["な"],["者","もの"],["も"],["、"],["ことごとく"],["わたし"],["は"],["断ち","たち"],["、"]]},{"verse":9,"text":"アハブの家,いえをネバテの子,こヤラベアムのようにし、アヒヤの子,こバアシャの家,いえのようにする。","tok":[["アハブ"],["の"],["家","いえ"],["を"],["ネバテ"],["の"],["子","こ"],["ヤラベアム"],["の"],["よう"],["に"],["し"],["、"],["アヒヤ"],["の"],["子","こ"],["バアシャ"],["の"],["家","いえ"],["の"],["よう"],["に"],["する"],["。"]]},{"verse":10,"text":"犬,いぬがイズレルの地域,ちいきでイゼベルを食,くい、彼女,かのじょを葬,ほうむる者,ものはないであろう』」。そして彼,かれは戸,とをあけて逃,にげ去,さった。","tok":[["犬","いぬ"],["が"],["イズレル"],["の"],["地域","ちいき"],["で"],["イゼベル"],["を"],["食い","くい"],["、"],["彼女","かのじょ"],["を"],["葬むる","ほうむる"],["者","もの"],["は"],["ないで"],["あろう"],["』"],["」"],["。"],["そして"],["彼","かれ"],["は"],["戸","と"],["を"],["あけて"],["逃去","にげさっ"],["た"],["。"]]},{"verse":11,"text":"やがてエヒウが主君,しゅくんの家来,けらいたちの所,ところへ出,でて来,くると、彼,かれらはエヒウに言,いった、「変,かわった事,ことはありませんか。あの気違,きちがいは、なんのためにあなたの所,ところにきたのですか」。エヒウは彼,かれらに言,いった、「あなたがたは、あの人,ひとを知,しっています。またその言,いう事,ことも知,しっています」。","tok":[["やがて"],["エヒウ"],["が"],["主君","しゅくん"],["の"],["家来","けらい"],["たち"],["の"],["所","ところ"],["へ"],["出て","でて"],["来る","くる"],["と"],["、"],["彼","かれ"],["ら"],["は"],["エヒウ"],["に"],["言った","いった"],["、"],["「"],["変わった","かわった"],["事","こと"],["は"],["ありません"],["か"],["。"],["あの"],["気違","きちがい"],["は"],["、"],["なん"],["の"],["ため"],["に"],["あなた"],["の"],["所","ところ"],["に"],["きた"],["の"],["です"],["か"],["」"],["。"],["エヒウ"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["、"],["あの"],["人","ひと"],["を"],["知って","しって"],["います"],["。"],["また"],["その"],["言う","いう"],["事","こと"],["も"],["知って","しって"],["います"],["」"],["。"]]},{"verse":12,"text":"彼,かれらは言,いった、「それは違,ちがいます。どうぞわれわれに話,はなしてください」。そこでエヒウは言,いった、「彼,かれはこうこう、わたしに告,つげて言,いいました、『主,しゅはこう仰,おおせられる、わたしはあなたに油,あぶらを注,そそいで、イスラエルの王,おうとする』」。","tok":[["彼","かれ"],["ら"],["は"],["言った","いった"],["、"],["「"],["それ"],["は"],["違います","ちがいます"],["。"],["どうぞ"],["われわれ"],["に"],["話","はなし"],["て"],["ください"],["」"],["。"],["そこ"],["で"],["エヒウ"],["は"],["言った","いった"],["、"],["「"],["彼","かれ"],["は"],["こう"],["こう"],["、"],["わたし"],["に"],["告","つげ"],["て"],["言いました","いいました"],["、"],["『"],["主","しゅ"],["は"],["こう"],["仰せられる","おおせられる"],["、"],["わたし"],["は"],["あなた"],["に"],["油","あぶら"],["を"],["注いで","そそいで"],["、"],["イスラエル"],["の"],["王","おう"],["と"],["する"],["』"],["」"],["。"]]},{"verse":13,"text":"すると彼,かれらは急,いそいで、おのおの衣服,いふくをとり、それを階段,かいだんの上,うえのエヒウの下,したに敷,しき、ラッパを吹,ふいて「エヒウは王,おうである」と言,いった。","tok":[["する"],["と"],["彼","かれ"],["ら"],["は"],["急いで","いそいで"],["、"],["おのおの"],["衣服","いふく"],["を"],["とり"],["、"],["それ"],["を"],["階段","かいだん"],["の"],["上","うえ"],["の"],["エヒウ"],["の"],["下","した"],["に"],["敷","しき"],["、"],["ラッパ"],["を"],["吹いて","ふいて"],["「"],["エヒウ"],["は"],["王","おう"],["で"],["ある"],["」"],["と"],["言った","いった"],["。"]]},{"verse":14,"text":"こうしてニムシの子,こであるヨシャパテの子,こエヒウはヨラムにそむいた。（ヨラムはイスラエルをことごとく率,ひきいて、ラモテ・ギレアデでスリヤの王,おうハザエルを防,ふせいだが、","tok":[["こう"],["して"],["ニムシ"],["の"],["子","こ"],["で"],["ある"],["ヨシャパテ"],["の"],["子","こ"],["エヒウ"],["は"],["ヨラム"],["に"],["そむいた"],["。"],["（"],["ヨラム"],["は"],["イスラエル"],["を"],["ことごとく"],["率いて","ひきいて"],["、"],["ラモテ"],["・"],["ギレアデ"],["で"],["スリヤ"],["の"],["王","おう"],["ハザエル"],["を"],["防いだ","ふせいだ"],["が"],["、"]]},{"verse":15,"text":"ヨラム王,おうはスリヤの王,おうハザエルと戦,たたかった時,ときに、スリヤびとに負,おわされた傷,きずをいやすため、エズレルに帰,かえっていた。）エヒウは言,いった、「もしこれがあなたがたの本心,ほんしんであるならば、ひとりもこの町,まちから忍,しのび出,でて、これをエズレルに告,つげてはならない」。","tok":[["ヨラム"],["王","おう"],["は"],["スリヤ"],["の"],["王","おう"],["ハザエル"],["と"],["戦った","たたかった"],["時","とき"],["に"],["、"],["スリヤ"],["びと"],["に"],["負わされた","おわされた"],["傷","きず"],["を"],["いやす"],["ため"],["、"],["エズレル"],["に"],["帰えって","かえって"],["いた"],["。"],["）"],["エヒウ"],["は"],["言った","いった"],["、"],["「"],["もし"],["これ"],["が"],["あなた"],["がた"],["の"],["本心","ほんしん"],["で"],["あるならば"],["、"],["ひとり"],["も"],["この"],["町","まち"],["から"],["忍び出て","しのびでて"],["、"],["これ"],["を"],["エズレル"],["に"],["告","つげ"],["ては"],["ならない"],["」"],["。"]]},{"verse":16,"text":"そしてエヒウは車,くるまに乗,のってエズレルへ行,いった。ヨラムがそこに伏,ふしていたからである。またユダの王,おうアハジヤはヨラムを見舞,みまうために下,くだっていた。","tok":[["そして"],["エヒウ"],["は"],["車","くるま"],["に"],["乗って","のって"],["エズレル"],["へ"],["行った","いった"],["。"],["ヨラム"],["が"],["そこ"],["に"],["伏して","ふして"],["いた"],["から"],["で"],["ある"],["。"],["また"],["ユダ"],["の"],["王","おう"],["アハジヤ"],["は"],["ヨラム"],["を"],["見舞う","みまう"],["ため"],["に"],["下って","くだって"],["いた"],["。"]]},{"verse":17,"text":"さてエズレルのやぐらに、ひとりの物見,ものみが立,たっていたが、エヒウの群衆,ぐんしゅうが来,くるのを見,みて、「群衆,ぐんしゅうが見,みえる」と言,いったので、ヨラムは言,いった、「ひとりを馬,うまに乗,のせてつかわし、それに会,あわせて『平安,へいあんですか』と言,いわせなさい」。","tok":[["さて"],["エズレル"],["の"],["やぐら"],["に"],["、"],["ひとり"],["の"],["物見","ものみ"],["が"],["立って","たって"],["いた"],["が"],["、"],["エヒウ"],["の"],["群衆","ぐんしゅう"],["が"],["来る","くる"],["の"],["を"],["見て","みて"],["、"],["「"],["群衆","ぐんしゅう"],["が"],["見える","みえる"],["」"],["と"],["言った","いった"],["ので"],["、"],["ヨラム"],["は"],["言った","いった"],["、"],["「"],["ひとり"],["を"],["馬","うま"],["に"],["乗せて","のせて"],["つかわし"],["、"],["それ"],["に"],["会わせて","あわせて"],["『"],["平安","へいあん"],["です"],["か"],["』"],["と"],["言わせ","いわせ"],["なさい"],["」"],["。"]]},{"verse":18,"text":"そこでひとりが馬,うまに乗,のって行,いき、彼,かれに会,あって言,いった、「王,おうはこう仰,おおせられます、『平安,へいあんですか』」。エヒウ言,いった、「あなたは平安,へいあんとなんの関係,かんけいがありますか。わたしのあとについてきなさい」。物見,ものみはまた告,つげて言,いった、「使者,ししゃは彼,かれらの所,ところへ行,いきましたが、帰,かえってきません」。","tok":[["そこ"],["で"],["ひとり"],["が"],["馬","うま"],["に"],["乗って","のって"],["行き","いき"],["、"],["彼","かれ"],["に"],["会って","あって"],["言った","いった"],["、"],["「"],["王","おう"],["は"],["こう"],["仰せられます","おおせられます"],["、"],["『"],["平安","へいあん"],["です"],["か"],["』"],["」"],["。"],["エヒウ"],["言った","いった"],["、"],["「"],["あなた"],["は"],["平安","へいあん"],["と"],["なん"],["の"],["関係","かんけい"],["が"],["あります"],["か"],["。"],["わたし"],["の"],["あと"],["について"],["き"],["なさい"],["」"],["。"],["物見","ものみ"],["は"],["また"],["告","つげ"],["て"],["言った","いった"],["、"],["「"],["使者","ししゃ"],["は"],["彼","かれ"],["ら"],["の"],["所","ところ"],["へ"],["行きました","いきました"],["が"],["、"],["帰えって","かえって"],["きません"],["」"],["。"]]},{"verse":19,"text":"そこで再,ふたたび人,ひとを馬,うまでつかわしたので、彼,かれらの所,ところへ行,いって言,いった、「王,おうはこう仰,おおせられます、『平安,へいあんですか』」。エヒウは答,こたえて言,いった、「あなたは平安,へいあんとなんの関係,かんけいがありますか。わたしのあとについてきなさい」。","tok":[["そこ"],["で"],["再び","ふたたび"],["人","ひと"],["を"],["馬","うま"],["で"],["つかわした"],["ので"],["、"],["彼","かれ"],["ら"],["の"],["所","ところ"],["へ"],["行って","いって"],["言った","いった"],["、"],["「"],["王","おう"],["は"],["こう"],["仰せられます","おおせられます"],["、"],["『"],["平安","へいあん"],["です"],["か"],["』"],["」"],["。"],["エヒウ"],["は"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["あなた"],["は"],["平安","へいあん"],["と"],["なん"],["の"],["関係","かんけい"],["が"],["あります"],["か"],["。"],["わたし"],["の"],["あと"],["について"],["き"],["なさい"],["」"],["。"]]},{"verse":20,"text":"物見,ものみはまた告,つげて言,いった、「彼,かれも、彼,かれらの所,ところへ行,いきましたが帰,かえってきません。あの車,くるまの操縦,そうじゅうはニムシの子,こエヒウの操縦,そうじゅうするのに似,にて、猛烈,もうれつな勢,いきおいで操縦,そうじゅうして来,きます」。","tok":[["物見","ものみ"],["は"],["また"],["告","つげ"],["て"],["言った","いった"],["、"],["「"],["彼","かれ"],["も"],["、"],["彼","かれ"],["ら"],["の"],["所","ところ"],["へ"],["行きました","いきました"],["が"],["帰えって","かえって"],["きません"],["。"],["あの"],["車","くるま"],["の"],["操縦","そうじゅう"],["は"],["ニムシ"],["の"],["子","こ"],["エヒウ"],["の"],["操縦","そうじゅう"],["する"],["のに"],["似て","にて"],["、"],["猛烈","もうれつ"],["な"],["勢","いきおい"],["で"],["操縦","そうじゅう"],["して"],["来ます","きます"],["」"],["。"]]},{"verse":21,"text":"そこでヨラムが「車,くるまを用意,よういせよ」と言,いったので、車,くるまを用意,よういすると、イスラエルの王,おうヨラムと、ユダの王,おうアハジヤは、おのおのその車,くるまで出,でて行,いった。すなわちエヒウに会,あうために出,でていって、エズレルびとナボテの地所,じしょで彼,かれに会,あった。","tok":[["そこ"],["で"],["ヨラム"],["が"],["「"],["車","くるま"],["を"],["用意","ようい"],["せよ"],["」"],["と"],["言った","いった"],["ので"],["、"],["車","くるま"],["を"],["用意","ようい"],["する"],["と"],["、"],["イスラエル"],["の"],["王","おう"],["ヨラム"],["と"],["、"],["ユダ"],["の"],["王","おう"],["アハジヤ"],["は"],["、"],["おのおの"],["その"],["車","くるま"],["で"],["出て","でて"],["行った","いった"],["。"],["すなわち"],["エヒウ"],["に"],["会う","あう"],["ため"],["に"],["出て","でて"],["いって"],["、"],["エズレル"],["びと"],["ナボテ"],["の"],["地所","じしょ"],["で"],["彼","かれ"],["に"],["会った","あった"],["。"]]},{"verse":22,"text":"ヨラムはエヒウを見,みて言,いった、「エヒウよ、平安,へいあんですか」。エヒウは答,こたえた、「あなたの母,ははイゼベルの姦淫,かんいんと魔術,まじゅつとが、こんなに多,おおいのに、どうして平安,へいあんでありえましょうか」。","tok":[["ヨラム"],["は"],["エヒウ"],["を"],["見て","みて"],["言った","いった"],["、"],["「"],["エヒウ"],["よ"],["、"],["平安","へいあん"],["です"],["か"],["」"],["。"],["エヒウ"],["は"],["答","こたえ"],["た"],["、"],["「"],["あなた"],["の"],["母","はは"],["イゼベル"],["の"],["姦淫","かんいん"],["と"],["魔術","まじゅつ"],["と"],["が"],["、"],["こんな"],["に"],["多い","おおい"],["のに"],["、"],["どう"],["して"],["平安","へいあん"],["で"],["あり"],["えましょう"],["か"],["」"],["。"]]},{"verse":23,"text":"その時,ときヨラムは車,くるまをめぐらして逃,にげ、アハジヤにむかって、「アハジヤよ、反逆,はんぎゃくです」と言,いうと、","tok":[["その"],["時","とき"],["ヨラム"],["は"],["車","くるま"],["を"],["めぐらして"],["逃","にげ"],["、"],["アハジヤ"],["に"],["むかって"],["、"],["「"],["アハジヤ"],["よ"],["、"],["反逆","はんぎゃく"],["です"],["」"],["と"],["言","いう"],["と"],["、"]]},{"verse":24,"text":"エヒウは手,てに弓,ゆみをひきしぼって、ヨラムの両,りょう肩,かたの間,あいだを射,いたので、矢,やは彼,かれの心臓,しんぞうを貫,つらぬき、彼,かれは車,くるまの中,なかに倒,たおれた。","tok":[["エヒウ"],["は"],["手","て"],["に"],["弓","ゆみ"],["を"],["ひきしぼって"],["、"],["ヨラム"],["の"],["両肩","りょうかた"],["の"],["間","あいだ"],["を"],["射た","いた"],["ので"],["、"],["矢","や"],["は"],["彼","かれ"],["の"],["心臓","しんぞう"],["を"],["貫ぬき","つらぬき"],["、"],["彼","かれ"],["は"],["車","くるま"],["の"],["中","なか"],["に"],["倒れた","たおれた"],["。"]]},{"verse":25,"text":"エヒウはその副官,ふくかんビデカルに言,いった、「彼,かれを取,とりあげて、エズレルびとナボテの畑,はたけに投,なげ捨,すてなさい。かつて、わたしとあなたと、ふたり共,ともに乗,のって、彼,かれの父,ちちアハブに従,したがったとき、主,しゅが彼,かれについて、この預言,よげんをされたことを記憶,きおくしなさい。","tok":[["エヒウ"],["は"],["その"],["副官","ふくかん"],["ビデカル"],["に"],["言った","いった"],["、"],["「"],["彼","かれ"],["を"],["取","とり"],["あげて"],["、"],["エズレル"],["びと"],["ナボテ"],["の"],["畑","はたけ"],["に"],["投捨て","なげすて"],["なさい"],["。"],["かつて"],["、"],["わたし"],["と"],["あなた"],["と"],["、"],["ふたり"],["共","とも"],["に"],["乗って","のって"],["、"],["彼","かれ"],["の"],["父","ちち"],["アハブ"],["に"],["従った","したがった"],["とき"],["、"],["主","しゅ"],["が"],["彼","かれ"],["について"],["、"],["この"],["預言","よげん"],["を"],["された"],["こと"],["を"],["記憶","きおく"],["し"],["なさい"],["。"]]},{"verse":26,"text":"すなわち主,しゅは言,いわれた、『まことに、わたしはきのうナボテの血,ちと、その子,こらの血,ちを見,みた』。また主,しゅは言,いわれた、『わたしはこの地所,じしょであなたに報復,ほうふくする』と。それゆえ彼,かれを取,とりあげて、その地所,じしょに投,なげすて、主,しゅの言葉,ことばのようにしなさい」。","tok":[["すなわち"],["主","しゅ"],["は"],["言われた","いわれた"],["、"],["『"],["まこと"],["に"],["、"],["わたし"],["は"],["きのう"],["ナボテ"],["の"],["血","ち"],["と"],["、"],["その"],["子","こ"],["ら"],["の"],["血","ち"],["を"],["見た","みた"],["』"],["。"],["また"],["主","しゅ"],["は"],["言われた","いわれた"],["、"],["『"],["わたし"],["は"],["この"],["地所","じしょ"],["で"],["あなた"],["に"],["報復","ほうふく"],["する"],["』"],["と"],["。"],["それ"],["ゆえ"],["彼","かれ"],["を"],["取","とり"],["あげて"],["、"],["その"],["地所","じしょ"],["に"],["投","なげ"],["すて"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["の"],["よう"],["に"],["し"],["なさい"],["」"],["。"]]},{"verse":27,"text":"ユダの王,おうアハジヤはこれを見,みてベテハガンの方,ほうへ逃,にげたが、エヒウはそのあとを追,おい、「彼,かれをも撃,うて」と言,いったので、イブレアムのほとりのグルの坂,さかで車,くるまの中,なかの彼,かれを撃,うった。彼,かれはメギドまで逃,にげていって、そこで死,しんだ。","tok":[["ユダ"],["の"],["王","おう"],["アハジヤ"],["は"],["これ"],["を"],["見て","みて"],["ベテハガン"],["の"],["方","ほう"],["へ"],["逃た","にげた"],["が"],["、"],["エヒウ"],["は"],["その"],["あと"],["を"],["追い","おい"],["、"],["「"],["彼","かれ"],["を"],["も"],["撃て","うて"],["」"],["と"],["言った","いった"],["ので"],["、"],["イブレアム"],["の"],["ほとり"],["の"],["グル"],["の"],["坂","さか"],["で"],["車","くるま"],["の"],["中","なか"],["の"],["彼","かれ"],["を"],["撃った","うった"],["。"],["彼","かれ"],["は"],["メギド"],["まで"],["逃て","にげて"],["いって"],["、"],["そこ"],["で"],["死んだ","しんだ"],["。"]]},{"verse":28,"text":"その家来,けらいたちは彼,かれを車,くるまに載,のせてエルサレムに運,はこび、ダビデの町,まちで彼,かれの墓,はかにその先祖,せんぞたちと共,ともに葬,ほうむった。","tok":[["その"],["家来","けらい"],["たち"],["は"],["彼","かれ"],["を"],["車","くるま"],["に"],["載せて","のせて"],["エルサレム"],["に"],["運こび","はこび"],["、"],["ダビデ"],["の"],["町","まち"],["で"],["彼","かれ"],["の"],["墓","はか"],["に"],["その"],["先祖","せんぞ"],["たち"],["と"],["共","とも"],["に"],["葬むった","ほうむった"],["。"]]},{"verse":29,"text":"アハブの子,こヨラムの第,だい十一年,ねんにアハジヤはユダの王,おうとなったのである。","tok":[["アハブ"],["の"],["子","こ"],["ヨラム"],["の"],["第","だい"],["十一","じゅういち"],["年","ねん"],["に"],["アハジヤ"],["は"],["ユダ"],["の"],["王","おう"],["と"],["なった"],["ので"],["ある"],["。"]]},{"verse":30,"text":"エヒウがエズレルにきた時,とき、イゼベルはそれを聞,きいて、その目,めを塗,ぬり、髪,かみを飾,かざって窓,まどから望,のぞみ見,みたが、","tok":[["エヒウ"],["が"],["エズレル"],["に"],["きた"],["時","とき"],["、"],["イゼベル"],["は"],["それ"],["を"],["聞いて","きいて"],["、"],["その"],["目","め"],["を"],["塗","ぬり"],["、"],["髪","かみ"],["を"],["飾って","かざって"],["窓","まど"],["から"],["望み見た","のぞみみた"],["が"],["、"]]},{"verse":31,"text":"エヒウが門,もんにはいってきたので、「主君,しゅくんを殺,ころしたジムリよ、無事,ぶじですか」と言,いった。","tok":[["エヒウ"],["が"],["門","もん"],["に"],["はいって"],["きた"],["ので"],["、"],["「"],["主君","しゅくん"],["を"],["殺ろした","ころした"],["ジムリ"],["よ"],["、"],["無事","ぶじ"],["です"],["か"],["」"],["と"],["言った","いった"],["。"]]},{"verse":32,"text":"するとエヒウは顔,かおをあげて窓,まどにむかい、「だれか、わたしに味方,みかたする者,ものがあるか。だれかあるか」と言,いうと、二、三人,にんの宦官,かんがんがエヒウを望,のぞみ見,みたので、","tok":[["する"],["と"],["エヒウ"],["は"],["顔","かお"],["を"],["あげて"],["窓","まど"],["に"],["むかい"],["、"],["「"],["だれ"],["か"],["、"],["わたし"],["に"],["味方","みかた"],["する"],["者","もの"],["が"],["ある"],["か"],["。"],["だれ"],["か"],["ある"],["か"],["」"],["と"],["言","いう"],["と"],["、"],["二","に"],["、"],["三人","にん"],["の"],["宦官","かんがん"],["が"],["エヒウ"],["を"],["望み見た","のぞみみた"],["ので"],["、"]]},{"verse":33,"text":"エヒウは「彼女,かのじょを投,なげ落,おとせ」と言,いった。彼,かれらは彼女,かのじょを投,なげ落,おとしたので、その血,ちが壁,かべと馬,うまとにはねかかった。そして馬,うまは彼女,かのじょを踏,ふみつけた。","tok":[["エヒウ"],["は"],["「"],["彼女","かのじょ"],["を"],["投","なげ"],["落とせ","おとせ"],["」"],["と"],["言った","いった"],["。"],["彼","かれ"],["ら"],["は"],["彼女","かのじょ"],["を"],["投","なげ"],["落とした","おとした"],["ので"],["、"],["その"],["血","ち"],["が"],["壁","かべ"],["と"],["馬","うま"],["と"],["に"],["はね"],["かかった"],["。"],["そして"],["馬","うま"],["は"],["彼女","かのじょ"],["を"],["踏みつけた","ふみつけた"],["。"]]},{"verse":34,"text":"エヒウは内,うちにはいって食,くい飲,のみし、そして言,いった、「あののろわれた女,おんなを見,み、彼女,かのじょを葬,ほうむりなさい。彼女,かのじょは王,おうの娘,むすめなのだ」。","tok":[["エヒウ"],["は"],["内","うち"],["に"],["はいって"],["食い","くい"],["飲み","のみ"],["し"],["、"],["そして"],["言った","いった"],["、"],["「"],["あの"],["のろわれた"],["女","おんな"],["を"],["見","み"],["、"],["彼女","かのじょ"],["を"],["葬むり","ほうむり"],["なさい"],["。"],["彼女","かのじょ"],["は"],["王","おう"],["の"],["娘","むすめ"],["な"],["の"],["だ"],["」"],["。"]]},{"verse":35,"text":"しかし彼,かれらが彼女,かのじょを葬,ほうむろうとして行,いって見,みると、頭蓋骨,ずがいこつと、足,あしと、たなごころのほか何,なにもなかったので、","tok":[["しかし"],["彼","かれ"],["ら"],["が"],["彼女","かのじょ"],["を"],["葬むろう","ほうむろう"],["として"],["行って","いって"],["見る","みる"],["と"],["、"],["頭蓋骨","ずがいこつ"],["と"],["、"],["足","あし"],["と"],["、"],["たなごころ"],["の"],["ほか"],["何に","なに"],["も"],["なかった"],["ので"],["、"]]},{"verse":36,"text":"帰,かえって、彼,かれに告,つげると、彼,かれは言,いった、「これは主,しゅが、そのしもべ、テシベびとエリヤによってお告,つげになった言葉,ことばである。すなわち『エズレルの地,ちで犬,いぬがイゼベルの肉,にくを食,くうであろう。","tok":[["帰えって","かえって"],["、"],["彼","かれ"],["に"],["告げる","つげる"],["と"],["、"],["彼","かれ"],["は"],["言った","いった"],["、"],["「"],["これ"],["は"],["主","しゅ"],["が"],["、"],["その"],["しもべ"],["、"],["テシベ"],["びと"],["エリヤ"],["によって"],["お告","おつげ"],["に"],["なった"],["言葉","ことば"],["で"],["ある"],["。"],["すなわち"],["『"],["エズレル"],["の"],["地","ち"],["で"],["犬","いぬ"],["が"],["イゼベル"],["の"],["肉","にく"],["を"],["食うで","くうで"],["あろう"],["。"]]},{"verse":37,"text":"イゼベルの死体,したいはエズレルの地,ちで、糞土,ふんどのように野,ののおもてに捨,すてられて、だれも、これはイゼベルだ、と言,いうことができないであろう』」。","tok":[["イゼベル"],["の"],["死体","したい"],["は"],["エズレル"],["の"],["地","ち"],["で"],["、"],["糞土","ふんど"],["の"],["よう"],["に"],["野","の"],["の"],["おもて"],["に"],["捨てられて","すてられて"],["、"],["だれ"],["も"],["、"],["これ"],["は"],["イゼベル"],["だ"],["、"],["と"],["言う","いう"],["こと"],["が"],["できないで"],["あろう"],["』"],["」"],["。"]]}]
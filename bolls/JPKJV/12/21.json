[{"verse":1,"text":"マナセは十二歳,さいで王,おうとなり、五十五年,ねんの間,あいだ、エルサレムで世,よを治,おさめた。母,ははの名,なはヘフジバといった。","tok":[["マナセ"],["は"],["十二歳","さ"],["いで"],["王","おう"],["と"],["なり"],["、"],["五十五","ごじゅうご"],["年","ねん"],["の"],["間","あいだ"],["、"],["エルサレム"],["で"],["世","よ"],["を"],["治めた","おさめた"],["。"],["母","はは"],["の"],["名","な"],["は"],["ヘフジバ"],["と"],["いった"],["。"]]},{"verse":2,"text":"マナセは主,しゅがイスラエルの人々,ひとびとの前,まえから追,おい払,はらわれた国々,くにぐにの民,たみの憎,にくむべきおこないにならって、主,しゅの目,めの前,まえに悪,あくをおこなった。","tok":[["マナセ"],["は"],["主","しゅ"],["が"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["前","まえ"],["から"],["追い払われた","おいはらわれた"],["国々","くにぐに"],["の"],["民","たみ"],["の"],["憎むべき","にくむべき"],["おこない"],["に"],["ならって"],["、"],["主","しゅ"],["の"],["目","め"],["の"],["前","まえ"],["に"],["悪","あく"],["を"],["おこなった"],["。"]]},{"verse":3,"text":"彼,かれは父,ちちヒゼキヤがこわした高,たかき所,ところを建,たて直,なおし、またイスラエルの王,おうアハブがしたようにバアルのために祭壇,さいだんを築,きずき、アシラ像,ぞうを造,つくり、かつ天,てんの万象,ばんしょうを拝,おがんで、これに仕,つかえた。","tok":[["彼","かれ"],["は"],["父","ちち"],["ヒゼキヤ"],["が"],["こわした"],["高き","たかき"],["所","ところ"],["を"],["建て直し","たてなおし"],["、"],["また"],["イスラエル"],["の"],["王","おう"],["アハブ"],["が"],["した"],["よう"],["に"],["バアル"],["の"],["ため"],["に"],["祭壇","さいだん"],["を"],["築き","きずき"],["、"],["アシラ"],["像","ぞう"],["を"],["造","つくり"],["、"],["かつ"],["天","てん"],["の"],["万象","ばんしょう"],["を"],["拝んで","おがんで"],["、"],["これ"],["に"],["仕えた","つかえた"],["。"]]},{"verse":4,"text":"また主,しゅの宮,みやのうちに数個,すうこの祭壇,さいだんを築,きずいた。これは主,しゅが「わたしの名,なをエルサレムに置,おこう」と言,いわれたその宮,みやである。","tok":[["また"],["主","しゅ"],["の"],["宮","みや"],["の"],["うち"],["に"],["数個","すうこ"],["の"],["祭壇","さいだん"],["を"],["築いた","きずいた"],["。"],["これ"],["は"],["主","しゅ"],["が"],["「"],["わたし"],["の"],["名","な"],["を"],["エルサレム"],["に"],["置こう","おこう"],["」"],["と"],["言われた","いわれた"],["その"],["宮","みや"],["で"],["ある"],["。"]]},{"verse":5,"text":"彼,かれはまた主,しゅの宮,みやの二つの庭,にわに天,てんの万象,ばんしょうのために祭壇,さいだんを築,きずいた。","tok":[["彼","かれ"],["は"],["また"],["主","しゅ"],["の"],["宮","みや"],["の"],["二","ふた"],["つ"],["の"],["庭","にわ"],["に"],["天","てん"],["の"],["万象","ばんしょう"],["の"],["ため"],["に"],["祭壇","さいだん"],["を"],["築いた","きずいた"],["。"]]},{"verse":6,"text":"またその子,こを火,ひに焼,やいてささげ物,ものとし、占,うらないをし、魔術,まじゅつを行,おこない、口寄,くちよせと魔法使,まほうつかいを用,もちい、主,しゅの目,めの前,まえに多,おおくの悪,あくを行,いって、主,しゅの怒,いかりを引,ひき起,おこした。","tok":[["また"],["その"],["子","こ"],["を"],["火","ひ"],["に"],["焼いて","やいて"],["ささげ物","ささげもの"],["と"],["し"],["、"],["占","うらない"],["を"],["し"],["、"],["魔術","まじゅつ"],["を"],["行ない","おこない"],["、"],["口寄","くちよせ"],["と"],["魔法","まほう"],["使い","つかい"],["を"],["用い","もちい"],["、"],["主","しゅ"],["の"],["目","め"],["の"],["前","まえ"],["に"],["多く","おおく"],["の"],["悪","あく"],["を"],["行って","いって"],["、"],["主","しゅ"],["の"],["怒り","いかり"],["を"],["引起こした","ひきおこした"],["。"]]},{"verse":7,"text":"彼,かれはまたアシラの彫像,ちょうぞうを作,つくって主,しゅの宮,みやに置,おいた。主,しゅはこの宮,みやについてダビデとその子,こソロモンに言,いわれたことがある、「わたしはこの宮,みやと、わたしがイスラエルのすべての部族,ぶぞくのうちから選,えらんだエルサレムとに、わたしの名,なを永遠,えいえんに置,おく。","tok":[["彼","かれ"],["は"],["また"],["アシラ"],["の"],["彫像","ちょうぞう"],["を"],["作って","つくって"],["主","しゅ"],["の"],["宮","みや"],["に"],["置いた","おいた"],["。"],["主","しゅ"],["は"],["この"],["宮","みや"],["について"],["ダビデ"],["と"],["その"],["子","こ"],["ソロモン"],["に"],["言われた","いわれた"],["こと"],["が"],["ある"],["、"],["「"],["わたし"],["は"],["この"],["宮","みや"],["と"],["、"],["わたし"],["が"],["イスラエル"],["の"],["すべて"],["の"],["部族","ぶぞく"],["の"],["うち"],["から"],["選らんだ","えらんだ"],["エルサレム"],["と"],["に"],["、"],["わたし"],["の"],["名","な"],["を"],["永遠","えいえん"],["に"],["置く","おく"],["。"]]},{"verse":8,"text":"もし、彼,かれらがわたしが命,めいじたすべての事,こと、およびわたしのしもべモーセが命,めいじたすべての律法,りっぽうを守,まもり行,おこなうならば、イスラエルの足,あしを、わたしが彼,かれらの先祖,せんぞたちに与,あたえた地,ちから、重,かさねて迷,まよい出,ださせないであろう」。","tok":[["もし"],["、"],["彼","かれ"],["ら"],["が"],["わたし"],["が"],["命じた","めいじた"],["すべて"],["の"],["事","こと"],["、"],["および"],["わたし"],["の"],["しもべ"],["モーセ"],["が"],["命じた","めいじた"],["すべて"],["の"],["律法","りっぽう"],["を"],["守り","まもり"],["行なうならば","おこなうならば"],["、"],["イスラエル"],["の"],["足","あし"],["を"],["、"],["わたし"],["が"],["彼","かれ"],["ら"],["の"],["先祖","せんぞ"],["たち"],["に"],["与","あたえ"],["た"],["地","ち"],["から"],["、"],["重ねて","かさねて"],["迷い出させないで","まよいださせないで"],["あろう"],["」"],["。"]]},{"verse":9,"text":"しかし彼,かれらは聞,ききいれなかった。マナセが人々,ひとびとをいざなって悪,あくを行,おこなったことは、主,しゅがイスラエルの人々,ひとびとの前,まえに滅,ほろぼされた国々,くにぐにの民,たみよりもはなはだしかった。","tok":[["しかし"],["彼","かれ"],["ら"],["は"],["聞きいれなかった","ききいれなかった"],["。"],["マナセ"],["が"],["人々","ひとびと"],["を"],["いざなって"],["悪","あく"],["を"],["行なった","おこなった"],["こと"],["は"],["、"],["主","しゅ"],["が"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["前","まえ"],["に"],["滅ぼされた","ほろぼされた"],["国々","くにぐに"],["の"],["民","たみ"],["より"],["も"],["はなはだしかった"],["。"]]},{"verse":10,"text":"そこで主,しゅはそのしもべである預言者,よげんしゃたちによって言,いわれた、","tok":[["そこ"],["で"],["主","しゅ"],["は"],["その"],["しもべ"],["で"],["ある"],["預言者","よげんしゃ"],["たち"],["によって"],["言われた","いわれた"],["、"]]},{"verse":11,"text":"「ユダの王,おうマナセがこれらの憎,にくむべき事,ことを行,おこない、彼,かれの先,さきにあったアモリびとの行,いったすべての事,ことよりも悪,わるい事,ことを行,おこない、またその偶像,ぐうぞうをもってユダに罪,つみを犯,おかさせたので、","tok":[["「"],["ユダ"],["の"],["王","おう"],["マナセ"],["が"],["これ"],["ら"],["の"],["憎むべき","にくむべき"],["事","こと"],["を"],["行ない","おこない"],["、"],["彼","かれ"],["の"],["先","さき"],["に"],["あった"],["アモリ"],["びと"],["の"],["行った","いった"],["すべて"],["の"],["事","こと"],["より"],["も"],["悪い","わるい"],["事","こと"],["を"],["行ない","おこない"],["、"],["また"],["その"],["偶像","ぐうぞう"],["を"],["もって"],["ユダ"],["に"],["罪","つみ"],["を"],["犯させた","おかさせた"],["ので"],["、"]]},{"verse":12,"text":"イスラエルの神,かみ、主,しゅはこう仰,おおせられる、見,みよ、わたしはエルサレムとユダに災,わざわいをくだそうとしている。これを聞,きく者,ものは、その耳,みみが二つながら鳴,なるであろう。","tok":[["イスラエル"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["こう"],["仰せられる","おおせられる"],["、"],["見よ","みよ"],["、"],["わたし"],["は"],["エルサレム"],["と"],["ユダ"],["に"],["災","わざわい"],["を"],["くだそう"],["として"],["いる"],["。"],["これ"],["を"],["聞く","きく"],["者","もの"],["は"],["、"],["その"],["耳","みみ"],["が"],["二つながら","ふたつながら"],["鳴","なる"],["で"],["あろう"],["。"]]},{"verse":13,"text":"わたしはサマリヤをはかった測,はかりなわと、アハブの家,いえに用,もちいた下,さげ振,ふりをエルサレムにほどこし、人,ひとが皿,さらをぬぐい、これをぬぐって伏,ふせるように、エルサレムをぬぐい去,さる。","tok":[["わたし"],["は"],["サマリヤ"],["を"],["はかった"],["測り","はかり"],["なわ"],["と"],["、"],["アハブ"],["の"],["家","いえ"],["に"],["用いた","もちいた"],["下げ振り","さげふり"],["を"],["エルサレム"],["に"],["ほどこし"],["、"],["人","ひと"],["が"],["皿","さら"],["を"],["ぬぐい"],["、"],["これ"],["を"],["ぬぐって"],["伏せる","ふせる"],["よう"],["に"],["、"],["エルサレム"],["を"],["ぬぐい去る","ぬぐいさる"],["。"]]},{"verse":14,"text":"わたしは、わたしの嗣,し業,ぎょうの民,たみの残,のこりを捨,すて、彼,かれらを敵,てきの手,てに渡,わたす。彼,かれらはもろもろの敵,てきのえじきとなり、略奪,りゃくだつにあうであろう。","tok":[["わたし"],["は"],["、"],["わたし"],["の"],["嗣業","しぎょう"],["の"],["民","たみ"],["の"],["残り","のこり"],["を"],["捨て","すて"],["、"],["彼","かれ"],["ら"],["を"],["敵","てき"],["の"],["手","て"],["に"],["渡す","わたす"],["。"],["彼","かれ"],["ら"],["は"],["もろもろ"],["の"],["敵","てき"],["の"],["えじき"],["と"],["なり"],["、"],["略奪","りゃくだつ"],["に"],["あうで"],["あろう"],["。"]]},{"verse":15,"text":"これは彼,かれらの先祖,せんぞたちがエジプトを出,でた日,ひから今日,こんにちに至,いたるまで、彼,かれらがわたしの目,めの前,まえに悪,あくを行,いって、わたしを怒,いからせたためである」。","tok":[["これ"],["は"],["彼","かれ"],["ら"],["の"],["先祖","せんぞ"],["たち"],["が"],["エジプト"],["を"],["出た","でた"],["日","ひ"],["から"],["今日","こんにち"],["に"],["至る","いたる"],["まで"],["、"],["彼","かれ"],["ら"],["が"],["わたし"],["の"],["目","め"],["の"],["前","まえ"],["に"],["悪","あく"],["を"],["行って","いって"],["、"],["わたし"],["を"],["怒らせた","いからせた"],["ため"],["で"],["ある"],["」"],["。"]]},{"verse":16,"text":"マナセはまた主,しゅの目,めの前,まえに悪,あくを行,いって、ユダに罪,つみを犯,おかさせたその罪,つみのほかに、罪,つみなき者,ものの血,ちを多,おおく流,ながして、エルサレムのこの果,はてから、かの果,はてにまで満,みたした。","tok":[["マナセ"],["は"],["また"],["主","しゅ"],["の"],["目","め"],["の"],["前","まえ"],["に"],["悪","あく"],["を"],["行って","いって"],["、"],["ユダ"],["に"],["罪","つみ"],["を"],["犯させた","おかさせた"],["その"],["罪","つみ"],["の"],["ほか"],["に"],["、"],["罪","つみ"],["なき"],["者","もの"],["の"],["血","ち"],["を"],["多く","おおく"],["流して","ながして"],["、"],["エルサレム"],["の"],["この"],["果て","はて"],["から"],["、"],["かの"],["果て","はて"],["に"],["まで"],["満たした","みたした"],["。"]]},{"verse":17,"text":"マナセのその他,たの事績,じせきと、彼,かれがおこなったすべての事,ことおよびその犯,おかした罪,つみは、ユダの王,おうの歴代志,れきだいしの書,しょにしるされているではないか。","tok":[["マナセ"],["の"],["その"],["他","た"],["の"],["事績","じせき"],["と"],["、"],["彼","かれ"],["が"],["おこなった"],["すべて"],["の"],["事","こと"],["および"],["その"],["犯した","おかした"],["罪","つみ"],["は"],["、"],["ユダ"],["の"],["王","おう"],["の"],["歴代志","れきだいし"],["の"],["書","しょ"],["に"],["しるされて"],["いるで"],["は"],["ない"],["か"],["。"]]},{"verse":18,"text":"マナセは先祖,せんぞたちと共,ともに眠,ねむって、その家,いえの園,そのすなわちウザの園,そのに葬,ほうむられ、その子,こアモンが代,かわって王,おうとなった。","tok":[["マナセ"],["は"],["先祖","せんぞ"],["たち"],["と"],["共","とも"],["に"],["眠って","ねむって"],["、"],["その"],["家","いえ"],["の"],["園","その"],["すなわち"],["ウザ"],["の"],["園","その"],["に"],["葬むられ","ほうむられ"],["、"],["その"],["子","こ"],["アモン"],["が"],["代わって","かわって"],["王","おう"],["と"],["なった"],["。"]]},{"verse":19,"text":"アモンは王,おうとなった時,とき二十二歳,さいであって、エルサレムで二年,ねんの間,あいだ、世,よを治,おさめた。母,はははヨテバのハルツの娘,むすめで、名,なをメシュレメテといった。","tok":[["アモン"],["は"],["王","おう"],["と"],["なった"],["時","とき"],["二十二歳","さ"],["いであ"],["って"],["、"],["エルサレム"],["で"],["二","に"],["年","ねん"],["の"],["間","あいだ"],["、"],["世","よ"],["を"],["治めた","おさめた"],["。"],["母","はは"],["は"],["ヨテバ"],["の"],["ハルツ"],["の"],["娘","むすめ"],["で"],["、"],["名","な"],["を"],["メシュレメテ"],["と"],["いった"],["。"]]},{"verse":20,"text":"アモンはその父,ちちマナセのおこなったように、主,しゅの目,めの前,まえに悪,あくを行,おこなった。","tok":[["アモン"],["は"],["その"],["父","ちち"],["マナセ"],["の"],["おこなった"],["よう"],["に"],["、"],["主","しゅ"],["の"],["目","め"],["の"],["前","まえ"],["に"],["悪","あく"],["を"],["行なった","おこなった"],["。"]]},{"verse":21,"text":"すなわち彼,かれはすべてその父,ちちの歩,あゆんだ道,みちに歩,あゆみ、父,ちちの仕,つかえた偶像,ぐうぞうに仕,つかえて、これを拝,おがみ、","tok":[["すなわち"],["彼","かれ"],["は"],["すべて"],["その"],["父","ちち"],["の"],["歩んだ","あゆんだ"],["道","みち"],["に"],["歩み","あゆみ"],["、"],["父","ちち"],["の"],["仕えた","つかえた"],["偶像","ぐうぞう"],["に"],["仕えて","つかえて"],["、"],["これ"],["を"],["拝み","おがみ"],["、"]]},{"verse":22,"text":"先祖,せんぞたちの神,かみ、主,しゅを捨,すてて、主,しゅの道,みちに歩,あゆまなかった。","tok":[["先祖","せんぞ"],["たち"],["の"],["神","かみ"],["、"],["主","しゅ"],["を"],["捨てて","すてて"],["、"],["主","しゅ"],["の"],["道","みち"],["に"],["歩まなかった","あゆまなかった"],["。"]]},{"verse":23,"text":"アモンの家来,けらいたちはついに彼,かれに敵,てきして徒党,ととうを結,むすび、王,おうをその家,いえで殺,ころしたが、","tok":[["アモン"],["の"],["家来","けらい"],["たち"],["は"],["ついに"],["彼","かれ"],["に"],["敵して","てきして"],["徒党","ととう"],["を"],["結び","むすび"],["、"],["王","おう"],["を"],["その"],["家","いえ"],["で"],["殺ろした","ころした"],["が"],["、"]]},{"verse":24,"text":"国,くにの民,たみは、アモン王,おうに敵,てきして徒党,ととうを結,むすんだ者,ものをことごとく撃,うち殺,ころした。そして国,くにの民,たみはアモンの子,こヨシヤを王,おうとしてアモンに代,かわらせた。","tok":[["国","くに"],["の"],["民","たみ"],["は"],["、"],["アモン"],["王","おう"],["に"],["敵して","てきして"],["徒党","ととう"],["を"],["結んだ","むすんだ"],["者","もの"],["を"],["ことごとく"],["撃ち殺した","うちころした"],["。"],["そして"],["国","くに"],["の"],["民","たみ"],["は"],["アモン"],["の"],["子","こ"],["ヨシヤ"],["を"],["王","おう"],["として"],["アモン"],["に"],["代わらせた","かわらせた"],["。"]]},{"verse":25,"text":"アモンのその他,たの事績,じせきは、ユダの王,おうの歴代志,れきだいしの書,しょにしるされているではないか。","tok":[["アモン"],["の"],["その"],["他","た"],["の"],["事績","じせき"],["は"],["、"],["ユダ"],["の"],["王","おう"],["の"],["歴代志","れきだいし"],["の"],["書","しょ"],["に"],["しるされて"],["いるで"],["は"],["ない"],["か"],["。"]]},{"verse":26,"text":"アモンはウザの園,そのにある墓,はかに葬,ほうむられ、その子,こヨシヤが代,かわって王,おうとなった。","tok":[["アモン"],["は"],["ウザ"],["の"],["園","その"],["に"],["ある"],["墓","はか"],["に"],["葬むられ","ほうむられ"],["、"],["その"],["子","こ"],["ヨシヤ"],["が"],["代わって","かわって"],["王","おう"],["と"],["なった"],["。"]]}]
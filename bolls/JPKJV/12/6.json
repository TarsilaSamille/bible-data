[{"verse":1,"text":"さて預言者,よげんしゃのともがらはエリシャに言,いった、「わたしたちがあなたと共,ともに住,すんでいる所,ところは狭,せまくなりましたので、","tok":[["さて"],["預言者","よげんしゃ"],["の"],["とも"],["がら"],["は"],["エリシャ"],["に"],["言った","いった"],["、"],["「"],["わたしたち"],["が"],["あなた"],["と"],["共","とも"],["に"],["住んで","すんで"],["いる"],["所","ところ"],["は"],["狭く","せまく"],["なりました"],["ので"],["、"]]},{"verse":2,"text":"わたしたちをヨルダンに行,いかせ、そこからめいめい一本,ぽんずつ材木,ざいもくを取,とってきて、わたしたちの住,すむ場所,ばしょを造,つくらせてください」。エリシャは言,いった、「行,いきなさい」。","tok":[["わたしたち"],["を"],["ヨルダン"],["に"],["行かせ","いかせ"],["、"],["そこ"],["から"],["めいめい"],["一本","ぽん"],["ずつ"],["材木","ざいもく"],["を"],["取って","とって"],["きて"],["、"],["わたしたち"],["の"],["住む","すむ"],["場所","ばしょ"],["を"],["造らせて","つくらせて"],["ください"],["」"],["。"],["エリシャ"],["は"],["言った","いった"],["、"],["「"],["行き","いき"],["なさい"],["」"],["。"]]},{"verse":3,"text":"時,ときにそのひとりが、「どうぞあなたも、しもべらと一緒,いっしょに行,いってください」と言,いったので、エリシャは「行,いきましょう」と答,こたえた。","tok":[["時","とき"],["に"],["その"],["ひとり"],["が"],["、"],["「"],["どうぞ"],["あなた"],["も"],["、"],["しもべ"],["ら"],["と"],["一緒","いっしょ"],["に"],["行って","いって"],["ください"],["」"],["と"],["言った","いった"],["ので"],["、"],["エリシャ"],["は"],["「"],["行きましょう","いきましょう"],["」"],["と"],["答","こたえ"],["た"],["。"]]},{"verse":4,"text":"そしてエリシャは彼,かれらと一緒,いっしょに行,いった。彼,かれらはヨルダンへ行,いって木,きを切,きり倒,たおしたが、","tok":[["そして"],["エリシャ"],["は"],["彼","かれ"],["ら"],["と"],["一緒","いっしょ"],["に"],["行った","いった"],["。"],["彼","かれ"],["ら"],["は"],["ヨルダン"],["へ"],["行って","いって"],["木","き"],["を"],["切り倒した","きりたおした"],["が"],["、"]]},{"verse":5,"text":"ひとりが材木,ざいもくを切,きり倒,たおしているとき、おのの頭,あたまが水,みずの中,なかに落,おちたので、彼,かれは叫,さけんで言,いった。「ああ、わが主,しゅよ。これは借,かりたものです」。","tok":[["ひとり"],["が"],["材木","ざいもく"],["を"],["切り倒して","きりたおして"],["いる"],["とき"],["、"],["おの"],["の"],["頭","あたま"],["が"],["水","みず"],["の"],["中","なか"],["に"],["落","おち"],["た"],["ので"],["、"],["彼","かれ"],["は"],["叫けんで","さけんで"],["言った","いった"],["。"],["「"],["ああ"],["、"],["わが"],["主","しゅ"],["よ"],["。"],["これ"],["は"],["借","かり"],["た"],["もの"],["です"],["」"],["。"]]},{"verse":6,"text":"神,かみの人,ひとは言,いった、「それはどこに落,おちたのか」。彼,かれがその場所,ばしょを知,しらせると、エリシャは一本,ぽんの枝,えだを切,きり落,おとし、そこに投,なげ入,いれて、そのおのの頭,あたまを浮,うかばせ、","tok":[["神","かみ"],["の"],["人","ひと"],["は"],["言った","いった"],["、"],["「"],["それ"],["は"],["どこ"],["に"],["落","おち"],["た"],["の"],["か"],["」"],["。"],["彼","かれ"],["が"],["その"],["場所","ばしょ"],["を"],["知らせる","しらせる"],["と"],["、"],["エリシャ"],["は"],["一本","ぽん"],["の"],["枝","えだ"],["を"],["切り落とし","きりおとし"],["、"],["そこ"],["に"],["投入れて","なげいれて"],["、"],["その"],["おの"],["の"],["頭","あたま"],["を"],["浮かばせ","うかばせ"],["、"]]},{"verse":7,"text":"「それを取,とりあげよ」と言,いったので、その人,ひとは手,てを伸,のべてそれを取,とった。","tok":[["「"],["それ"],["を"],["取","とり"],["あげ"],["よ"],["」"],["と"],["言った","いった"],["ので"],["、"],["その"],["人","ひと"],["は"],["手","て"],["を"],["伸べて","のべて"],["それ"],["を"],["取った","とった"],["。"]]},{"verse":8,"text":"かつてスリヤの王,おうがイスラエルと戦,たたかっていたとき、家来,けらいたちと評議,ひょうぎして「しかじかの所,ところにわたしの陣,じんを張,はろう」と言,いうと、","tok":[["かつて"],["スリヤ"],["の"],["王","おう"],["が"],["イスラエル"],["と"],["戦って","たたかって"],["いた"],["とき"],["、"],["家来","けらい"],["たち"],["と"],["評議","ひょうぎ"],["して"],["「"],["しかじか"],["の"],["所","ところ"],["に"],["わたし"],["の"],["陣","じん"],["を"],["張ろう","はろう"],["」"],["と"],["言","いう"],["と"],["、"]]},{"verse":9,"text":"神,かみの人,ひとはイスラエルの王,おうに「あなたは用心,ようじんして、この所,ところをとおってはなりません。スリヤびとがそこに下,くだってきますから」と言,いい送,おくった。","tok":[["神","かみ"],["の"],["人","ひと"],["は"],["イスラエル"],["の"],["王","おう"],["に"],["「"],["あなた"],["は"],["用心","ようじん"],["して"],["、"],["この"],["所","ところ"],["を"],["とおって"],["は"],["なりません"],["。"],["スリヤ"],["びと"],["が"],["そこ"],["に"],["下って","くだって"],["きます"],["から"],["」"],["と"],["言い送った","いいおくった"],["。"]]},{"verse":10,"text":"それでイスラエルの王,おうは神,かみの人,ひとが自分,じぶんに告,つげてくれた所,ところに人,ひとをつかわし、警戒,けいかいしたので、その所,ところでみずからを防,ふせぎえたことは一、二回,かいにとどまらなかった。","tok":[["それ"],["で"],["イスラエル"],["の"],["王","おう"],["は"],["神","かみ"],["の"],["人","ひと"],["が"],["自分","じぶん"],["に"],["告","つげ"],["て"],["くれた"],["所","ところ"],["に"],["人","ひと"],["を"],["つかわし"],["、"],["警戒","けいかい"],["した"],["ので"],["、"],["その"],["所","ところ"],["で"],["みずから"],["を"],["防ぎ","ふせぎ"],["えた"],["こと"],["は"],["一","いち"],["、"],["二","に"],["回","かい"],["に"],["とどまらなかった"],["。"]]},{"verse":11,"text":"スリヤの王,おうはこの事,ことのために心,こころを悩,なやまし、家来,けらいたちを召,めして言,いった、「われわれのうち、だれがイスラエルの王,おうと通,つうじているのか、わたしに告,つげる者,ものはないか」。","tok":[["スリヤ"],["の"],["王","おう"],["は"],["この"],["事","こと"],["の"],["ため"],["に"],["心","こころ"],["を"],["悩し","なやまし"],["、"],["家来","けらい"],["たち"],["を"],["召","めし"],["て"],["言った","いった"],["、"],["「"],["われわれ"],["の"],["うち"],["、"],["だれ"],["が"],["イスラエル"],["の"],["王","おう"],["と"],["通じて","つうじて"],["いる"],["の"],["か"],["、"],["わたし"],["に"],["告げる","つげる"],["者","もの"],["は"],["ない"],["か"],["」"],["。"]]},{"verse":12,"text":"ひとりの家来,けらいが言,いった、「王,おう、わが主,しゅよ、だれも通,つうじている者,ものはいません。ただイスラエルの預言者,よげんしゃエリシャが、あなたが寝室,しんしつで語,かたられる言葉,ことばでもイスラエルの王,おうに告,つげるのです」。","tok":[["ひとり"],["の"],["家来","けらい"],["が"],["言った","いった"],["、"],["「"],["王","おう"],["、"],["わが"],["主","しゅ"],["よ"],["、"],["だれ"],["も"],["通じて","つうじて"],["いる"],["者","もの"],["は"],["いません"],["。"],["ただ"],["イスラエル"],["の"],["預言者","よげんしゃ"],["エリシャ"],["が"],["、"],["あなた"],["が"],["寝室","しんしつ"],["で"],["語られる","かたられる"],["言葉","ことば"],["で"],["も"],["イスラエル"],["の"],["王","おう"],["に"],["告げる","つげる"],["の"],["です"],["」"],["。"]]},{"verse":13,"text":"王,おうは言,いった、「彼,かれがどこにいるか行,いって捜,さがしなさい。わたしは人,ひとをやって彼,かれを捕,とらえよう」。時,ときに「彼,かれはドタンにいる」と王,おうに告,つげる者,ものがあったので、","tok":[["王","おう"],["は"],["言った","いった"],["、"],["「"],["彼","かれ"],["が"],["どこ"],["に"],["いる"],["か"],["行って","いって"],["捜し","さがし"],["なさい"],["。"],["わたし"],["は"],["人","ひと"],["を"],["やって"],["彼","かれ"],["を"],["捕らえよう","とらえよう"],["」"],["。"],["時","とき"],["に"],["「"],["彼","かれ"],["は"],["ドタン"],["に"],["いる"],["」"],["と"],["王","おう"],["に"],["告げる","つげる"],["者","もの"],["が"],["あった"],["ので"],["、"]]},{"verse":14,"text":"王,おうはそこに馬,うまと戦車,せんしゃおよび大軍,たいぐんをつかわした。彼,かれらは夜,よるのうちに来,きて、その町,まちを囲,かこんだ。","tok":[["王","おう"],["は"],["そこ"],["に"],["馬","うま"],["と"],["戦車","せんしゃ"],["および"],["大軍","たいぐん"],["を"],["つかわした"],["。"],["彼","かれ"],["ら"],["は"],["夜","よる"],["の"],["うち"],["に"],["来て","きて"],["、"],["その"],["町","まち"],["を"],["囲んだ","かこんだ"],["。"]]},{"verse":15,"text":"神,かみの人,ひとの召使,めしつかいが朝,あさ早,はやく起,おきて出,でて見,みると、軍勢,ぐんぜいが馬,うまと戦車,せんしゃをもって町,まちを囲,かこんでいたので、その若者,わかものはエリシャに言,いった、「ああ、わが主,しゅよ、わたしたちはどうしましょうか」。","tok":[["神","かみ"],["の"],["人","ひと"],["の"],["召使","めしつかい"],["が"],["朝","あさ"],["早く","はやく"],["起きて","おきて"],["出て","でて"],["見る","みる"],["と"],["、"],["軍勢","ぐんぜい"],["が"],["馬","うま"],["と"],["戦車","せんしゃ"],["を"],["もって"],["町","まち"],["を"],["囲んで","かこんで"],["いた"],["ので"],["、"],["その"],["若者","わかもの"],["は"],["エリシャ"],["に"],["言った","いった"],["、"],["「"],["ああ"],["、"],["わが"],["主","しゅ"],["よ"],["、"],["わたしたち"],["は"],["どう"],["しましょう"],["か"],["」"],["。"]]},{"verse":16,"text":"エリシャは言,いった、「恐,おそれることはない。われわれと共,ともにいる者,ものは彼,かれらと共,ともにいる者,ものよりも多,おおいのだから」。","tok":[["エリシャ"],["は"],["言った","いった"],["、"],["「"],["恐れる","おそれる"],["こと"],["は"],["ない"],["。"],["われわれ"],["と"],["共","とも"],["に"],["いる"],["者","もの"],["は"],["彼","かれ"],["ら"],["と"],["共","とも"],["に"],["いる"],["者","もの"],["より"],["も"],["多い","おおい"],["の"],["だ"],["から"],["」"],["。"]]},{"verse":17,"text":"そしてエリシャが祈,いのって「主,しゅよ、どうぞ、彼,かれの目,めを開,ひらいて見,みさせてください」と言,いうと、主,しゅはその若者,わかものの目,めを開,ひらかれたので、彼,かれが見,みると、火,ひの馬,うまと火,ひの戦車,せんしゃが山,やまに満,みちてエリシャのまわりにあった。","tok":[["そして"],["エリシャ"],["が"],["祈って","いのって"],["「"],["主","しゅ"],["よ"],["、"],["どうぞ"],["、"],["彼","かれ"],["の"],["目","め"],["を"],["開らいて","ひらいて"],["見させて","みさせて"],["ください"],["」"],["と"],["言","いう"],["と"],["、"],["主","しゅ"],["は"],["その"],["若者","わかもの"],["の"],["目","め"],["を"],["開らかれた","ひらかれた"],["ので"],["、"],["彼","かれ"],["が"],["見る","みる"],["と"],["、"],["火","ひ"],["の"],["馬","うま"],["と"],["火","ひ"],["の"],["戦車","せんしゃ"],["が"],["山","やま"],["に"],["満ちて","みちて"],["エリシャ"],["の"],["まわり"],["に"],["あった"],["。"]]},{"verse":18,"text":"スリヤびとがエリシャの所,ところに下,くだってきた時,とき、エリシャは主,しゅに祈,いのって言,いった、「どうぞ、この人々,ひとびとの目,めをくらましてください」。するとエリシャの言葉,ことばのとおりに彼,かれらの目,めをくらまされた。","tok":[["スリヤ"],["びと"],["が"],["エリシャ"],["の"],["所","ところ"],["に"],["下って","くだって"],["きた"],["時","とき"],["、"],["エリシャ"],["は"],["主に","しゅに"],["祈って","いのって"],["言った","いった"],["、"],["「"],["どうぞ"],["、"],["この"],["人々","ひとびと"],["の"],["目","め"],["を"],["くらまして"],["ください"],["」"],["。"],["する"],["と"],["エリシャ"],["の"],["言葉","ことば"],["の"],["とおり"],["に"],["彼","かれ"],["ら"],["の"],["目","め"],["を"],["くらまされた"],["。"]]},{"verse":19,"text":"そこでエリシャは彼,かれらに「これはその道,みちではない。これはその町,まちでもない。わたしについてきなさい。わたしはあなたがたを、あなたがたの尋,たずねる人,ひとの所,ところへ連,つれて行,いきましょう」と言,いって、彼,かれらをサマリヤへ連,つれて行,いった。","tok":[["そこ"],["で"],["エリシャ"],["は"],["彼","かれ"],["ら"],["に"],["「"],["これ"],["は"],["その"],["道","みち"],["で"],["は"],["ない"],["。"],["これ"],["は"],["その"],["町","まち"],["で"],["も"],["ない"],["。"],["わたし"],["について"],["き"],["なさい"],["。"],["わたし"],["は"],["あなた"],["がた"],["を"],["、"],["あなた"],["がた"],["の"],["尋ねる","たずねる"],["人","ひと"],["の"],["所","ところ"],["へ"],["連れて","つれて"],["行きましょう","いきましょう"],["」"],["と"],["言って","いって"],["、"],["彼","かれ"],["ら"],["を"],["サマリヤ"],["へ"],["連れて","つれて"],["行った","いった"],["。"]]},{"verse":20,"text":"彼,かれらがサマリヤにはいったとき、エリシャは言,いった、「主,しゅよ、この人々,ひとびとの目,めを開,ひらいて見,みさせてください」。主,しゅは彼,かれらの目,めを開,ひらかれたので、彼,かれらが見,みると、見,みよ、彼,かれらはサマリヤのうちに来,きていた。","tok":[["彼","かれ"],["ら"],["が"],["サマリヤ"],["に"],["はいった"],["とき"],["、"],["エリシャ"],["は"],["言った","いった"],["、"],["「"],["主","しゅ"],["よ"],["、"],["この"],["人々","ひとびと"],["の"],["目","め"],["を"],["開らいて","ひらいて"],["見させて","みさせて"],["ください"],["」"],["。"],["主","しゅ"],["は"],["彼","かれ"],["ら"],["の"],["目","め"],["を"],["開らかれた","ひらかれた"],["ので"],["、"],["彼","かれ"],["ら"],["が"],["見る","みる"],["と"],["、"],["見よ","みよ"],["、"],["彼","かれ"],["ら"],["は"],["サマリヤ"],["の"],["うち"],["に"],["来て","きて"],["いた"],["。"]]},{"verse":21,"text":"イスラエルの王,おうは彼,かれらを見,みて、エリシャに言,いった、「わが父,ちちよ、彼,かれらを撃,うち殺,ころしましょうか。彼,かれらを撃,うち殺,ころしましょうか」。","tok":[["イスラエル"],["の"],["王","おう"],["は"],["彼","かれ"],["ら"],["を"],["見て","みて"],["、"],["エリシャ"],["に"],["言った","いった"],["、"],["「"],["わが"],["父","ちち"],["よ"],["、"],["彼","かれ"],["ら"],["を"],["撃ち","うち"],["殺ろしましょう","ころしましょう"],["か"],["。"],["彼","かれ"],["ら"],["を"],["撃ち","うち"],["殺ろしましょう","ころしましょう"],["か"],["」"],["。"]]},{"verse":22,"text":"エリシャは答,こたえた、「撃,うち殺,ころしてはならない。あなたはつるぎと弓,ゆみをもって、捕虜,ほりょにした者,ものどもを撃,うち殺,ころすでしょうか。パンと水,みずを彼,かれらの前,まえに供,そなえて食,くい飲,のみさせ、その主君,しゅくんのもとへ行,いかせなさい」。","tok":[["エリシャ"],["は"],["答","こたえ"],["た"],["、"],["「"],["撃ち","うち"],["殺ろし","ころし"],["ては"],["ならない"],["。"],["あなた"],["は"],["つるぎ"],["と"],["弓","ゆみ"],["を"],["もって"],["、"],["捕虜","ほりょ"],["に"],["した"],["者","もの"],["ども"],["を"],["撃ち","うち"],["殺ろすでしょう","ころすでしょう"],["か"],["。"],["パン"],["と"],["水","みず"],["を"],["彼","かれ"],["ら"],["の"],["前","まえ"],["に"],["供えて","そなえて"],["食い","くい"],["飲みさせ","のみさせ"],["、"],["その"],["主君","しゅくん"],["の"],["もと"],["へ"],["行かせ","いかせ"],["なさい"],["」"],["。"]]},{"verse":23,"text":"そこで王,おうは彼,かれらのために盛,さかんなふるまいを設,もうけた。彼,かれらが食,くい飲,のみを終,おわると彼,かれらを去,さらせたので、その主君,しゅくんの所,ところへ帰,かえった。スリヤの略奪,りゃくだつ隊,たいは再,ふたたびイスラエルの地,ちにこなかった。","tok":[["そこ"],["で"],["王","おう"],["は"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["盛","さかん"],["な"],["ふるまい"],["を"],["設けた","もうけた"],["。"],["彼","かれ"],["ら"],["が"],["食い","くい"],["飲み","のみ"],["を"],["終わる","おわる"],["と"],["彼","かれ"],["ら"],["を"],["去らせた","さらせた"],["ので"],["、"],["その"],["主君","しゅくん"],["の"],["所","ところ"],["へ"],["帰えった","かえった"],["。"],["スリヤ"],["の"],["略奪隊","りゃくだつたい"],["は"],["再び","ふたたび"],["イスラエル"],["の"],["地","ち"],["に"],["こなかった"],["。"]]},{"verse":24,"text":"この後,のちスリヤの王,おうベネハダデはその全,ぜん軍,ぐんを集,あつめ、上,のぼってきてサマリヤを攻,せめ囲,かこんだので、","tok":[["この"],["後","の"],["ち"],["スリヤ"],["の"],["王","おう"],["ベネハダデ"],["は"],["その"],["全軍","ぜんぐん"],["を"],["集め","あつめ"],["、"],["上って","のぼって"],["きて"],["サマリヤ"],["を"],["攻め","せめ"],["囲","かこんだ"],["ので"],["、"]]},{"verse":25,"text":"サマリヤに激,はげしいききんが起,たった。すなわち彼,かれらがこれを攻,せめ囲,かこんだので、ついに、ろばの頭,あたま一つが銀,ぎん八十シケルで売,うられ、はとのふん一カブの四分,ぶんの一が銀,ぎん五シケルで売,うられるようになった。","tok":[["サマリヤ"],["に"],["激しい","はげしい"],["ききん"],["が"],["起った","たった"],["。"],["すなわち"],["彼","かれ"],["ら"],["が"],["これ"],["を"],["攻め","せめ"],["囲","かこんだ"],["ので"],["、"],["ついに"],["、"],["ろば"],["の"],["頭","あたま"],["一","ひと"],["つ"],["が"],["銀","ぎん"],["八十","はちじゅう"],["シケル"],["で"],["売られ","うられ"],["、"],["はと"],["の"],["ふん"],["一","いち"],["カブ"],["の"],["四分","ぶん"],["の"],["一","いち"],["が"],["銀","ぎん"],["五","ご"],["シケル"],["で"],["売られる","うられる"],["よう"],["に"],["なった"],["。"]]},{"verse":26,"text":"イスラエルの王,おうが城壁,じょうへきの上,うえをとおっていた時,とき、ひとりの女,おんなが彼,かれに呼,よばわって、「わが主,しゅ、王,おうよ、助,たすけてください」と言,いったので、","tok":[["イスラエル"],["の"],["王","おう"],["が"],["城壁","じょうへき"],["の"],["上","うえ"],["を"],["とおって"],["いた"],["時","とき"],["、"],["ひとり"],["の"],["女","おんな"],["が"],["彼","かれ"],["に"],["呼ばわって","よばわって"],["、"],["「"],["わが"],["主","しゅ"],["、"],["王","おう"],["よ"],["、"],["助けて","たすけて"],["ください"],["」"],["と"],["言った","いった"],["ので"],["、"]]},{"verse":27,"text":"彼,かれは言,いった、「もし主,しゅがあなたを助,たすけられないならば、何,なにをもってわたしがあなたを助,たすけることができよう。打,うち場,ばの物,ものをもってか、酒,さかぶねの物,ものをもってか」。","tok":[["彼","かれ"],["は"],["言った","いった"],["、"],["「"],["もし"],["主","しゅ"],["が"],["あなた"],["を"],["助けられないならば","たすけられないならば"],["、"],["何に","なに"],["を"],["もって"],["わたし"],["が"],["あなた"],["を"],["助ける","たすける"],["こと"],["が"],["できよう"],["。"],["打ち","うち"],["場","ば"],["の"],["物","もの"],["を"],["もって"],["か"],["、"],["酒","さかぶね"],["の"],["物","もの"],["を"],["もって"],["か"],["」"],["。"]]},{"verse":28,"text":"そして王,おうは女,おんなに尋,たずねた、「何事,なにごとなのですか」。彼女,かのじょは答,こたえた、「この女,おんなはわたしにむかって『あなたの子,こをください。わたしたちは、きょうそれを食,たべ、あす、わたしの子,こを食,たべましょう』と言,いいました。","tok":[["そして"],["王","おう"],["は"],["女","おんな"],["に"],["尋ねた","たずねた"],["、"],["「"],["何事","なにごと"],["な"],["の"],["です"],["か"],["」"],["。"],["彼女","かのじょ"],["は"],["答","こたえ"],["た"],["、"],["「"],["この"],["女","おんな"],["は"],["わたし"],["に"],["むかって"],["『"],["あなた"],["の"],["子","こ"],["を"],["ください"],["。"],["わたしたち"],["は"],["、"],["きょう"],["それ"],["を"],["食べ","たべ"],["、"],["あす"],["、"],["わたし"],["の"],["子","こ"],["を"],["食べましょう","たべましょう"],["』"],["と"],["言いました","いいました"],["。"]]},{"verse":29,"text":"それでわたしたちは、まずわたしの子,こを煮,にて食,たべましたが、次,つぎの日,ひわたしが彼女,かのじょにむかって『あなたの子,こをください。わたしたちはそれを食,たべましょう』と言,いいますと、彼女,かのじょはその子,こを隠,かくしました」。","tok":[["それ"],["で"],["わたしたち"],["は"],["、"],["まず"],["わたし"],["の"],["子","こ"],["を"],["煮て","にて"],["食べました","たべました"],["が"],["、"],["次","つぎ"],["の"],["日","ひ"],["わたし"],["が"],["彼女","かのじょ"],["に"],["むかって"],["『"],["あなた"],["の"],["子","こ"],["を"],["ください"],["。"],["わたしたち"],["は"],["それ"],["を"],["食べましょう","たべましょう"],["』"],["と"],["言います","いいます"],["と"],["、"],["彼女","かのじょ"],["は"],["その"],["子","こ"],["を"],["隠しました","かくしました"],["」"],["。"]]},{"verse":30,"text":"王,おうはその女,おんなの言葉,ことばを聞,きいて、衣,ころもを裂,さき、――王,おうは城壁,じょうへきの上,うえをとおっていたが、民,たみが見,みると、その身,みに荒布,あらぬのを着,つけていた――","tok":[["王","おう"],["は"],["その"],["女","おんな"],["の"],["言葉","ことば"],["を"],["聞いて","きいて"],["、"],["衣","ころも"],["を"],["裂き","さき"],["、"],["―"],["―"],["王","おう"],["は"],["城壁","じょうへき"],["の"],["上","うえ"],["を"],["とおって"],["いた"],["が"],["、"],["民","た"],["み"],["が"],["見る","みる"],["と"],["、"],["その"],["身","み"],["に"],["荒布","あらぬ"],["の"],["を"],["着けて","つけて"],["いた"],["―"],["―"]]},{"verse":31,"text":"そして王,おうは言,いった「きょう、シャパテの子,こエリシャの首,くびがその肩,かたの上,うえにすわっているならば、神,かみがどんなにでもわたしを罰,ばっしてくださるように」。","tok":[["そして"],["王","おう"],["は"],["言った","いった"],["「"],["きょう"],["、"],["シャパテ"],["の"],["子","こ"],["エリシャ"],["の"],["首","くび"],["が"],["その"],["肩","かた"],["の"],["上","うえ"],["に"],["すわって"],["いるならば"],["、"],["神","かみ"],["が"],["どんな"],["にで"],["も"],["わたし"],["を"],["罰して","ばっして"],["くださる"],["よう"],["に"],["」"],["。"]]},{"verse":32,"text":"さてエリシャはその家,いえに座,ざしていたが、長老,ちょうろうたちもきて彼,かれと共,ともに座,ざした。王,おうは自分,じぶんの所,ところから人,ひとをつかわしたが、エリシャはその使者,ししゃがまだ着,つかないうちに長老,ちょうろうたちに言,いった、「あなたがたは、この人,ひとを殺,ころす者,ものがわたしの首,くびを取,とるために、人,ひとをつかわすのを見,みますか。その使者,ししゃがきたならば、戸,とを閉,とじて、内,うちに入,いれてはなりません。彼,かれのうしろに、その主君,しゅくんの足音,あしおとがするではありませんか」。","tok":[["さて"],["エリシャ"],["は"],["その"],["家","いえ"],["に"],["座して","ざして"],["いた"],["が"],["、"],["長老","ちょうろう"],["たち"],["も"],["きて"],["彼","かれ"],["と"],["共","とも"],["に"],["座した","ざした"],["。"],["王","おう"],["は"],["自分","じぶん"],["の"],["所","ところ"],["から"],["人","ひと"],["を"],["つかわした"],["が"],["、"],["エリシャ"],["は"],["その"],["使者","ししゃ"],["が"],["まだ"],["着かない","つかない"],["うち"],["に"],["長老","ちょうろう"],["たち"],["に"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["、"],["この"],["人","ひと"],["を"],["殺ろす","ころす"],["者","もの"],["が"],["わたし"],["の"],["首","くび"],["を"],["取る","とる"],["ため"],["に"],["、"],["人","ひと"],["を"],["つかわす"],["の"],["を"],["見ます","みます"],["か"],["。"],["その"],["使者","ししゃ"],["が"],["きたならば"],["、"],["戸","と"],["を"],["閉じて","とじて"],["、"],["内","うち"],["に"],["入れて","いれて"],["は"],["なりません"],["。"],["彼","かれ"],["の"],["うしろ"],["に"],["、"],["その"],["主君","しゅくん"],["の"],["足音","あしおと"],["が"],["するで"],["は"],["ありません"],["か"],["」"],["。"]]},{"verse":33,"text":"彼,かれがなお彼,かれらと語,かたっているうちに、王,おうは彼,かれのもとに下,くだってきて言,いった、「この災,わざわいは主,しゅから出,でたのです。わたしはどうしてこの上,うえ、主,しゅを待,またなければならないでしょうか」。","tok":[["彼","かれ"],["が"],["なお"],["彼","かれ"],["ら"],["と"],["語って","かたって"],["いる"],["うち"],["に"],["、"],["王","おう"],["は"],["彼","かれ"],["の"],["もと"],["に"],["下って","くだって"],["きて"],["言った","いった"],["、"],["「"],["この"],["災","わざわい"],["は"],["主ら","しゅから"],["出た","でた"],["の"],["です"],["。"],["わたし"],["は"],["どう"],["して"],["この"],["上","うえ"],["、"],["主","しゅ"],["を"],["待たなければ","またなければ"],["ならないでしょう"],["か"],["」"],["。"]]}]
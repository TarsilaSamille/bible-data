[{"verse":1,"text":"ユダの王,おうヨシャパテの第,だい十八年,ねんにアハブの子,こヨラムはサマリヤでイスラエルの王,おうとなり、十二年,ねん世,よを治,おさめた。","tok":[["ユダ"],["の"],["王","おう"],["ヨシャパテ"],["の"],["第","だい"],["十八","じゅうはち"],["年","ねん"],["に"],["アハブ"],["の"],["子","こ"],["ヨラム"],["は"],["サマリヤ"],["で"],["イスラエル"],["の"],["王","おう"],["と"],["なり"],["、"],["十二","じゅうに"],["年世","年よ"],["を"],["治めた","おさめた"],["。"]]},{"verse":2,"text":"彼,かれは主,しゅの目,めの前,まえに悪,あくをおこなったが、その父母,ふぼのようではなかった。彼,かれがその父,ちちの造,つくったバアルの石柱,せきちゅうを除,のぞいたからである。","tok":[["彼","かれ"],["は"],["主","しゅ"],["の"],["目","め"],["の"],["前","まえ"],["に"],["悪","あく"],["を"],["おこなった"],["が"],["、"],["その"],["父母","ふぼ"],["の"],["よう"],["で"],["は"],["なかった"],["。"],["彼","かれ"],["が"],["その"],["父","ちち"],["の"],["造った","つくった"],["バアル"],["の"],["石柱","せきちゅう"],["を"],["除いた","のぞいた"],["から"],["で"],["ある"],["。"]]},{"verse":3,"text":"しかし彼,かれはイスラエルに罪,つみを犯,おかさせたネバテの子,こヤラベアムの罪,つみにつき従,したがって、それを離,はなれなかった。","tok":[["しかし"],["彼","かれ"],["は"],["イスラエル"],["に"],["罪","つみ"],["を"],["犯させた","おかさせた"],["ネバテ"],["の"],["子","こ"],["ヤラベアム"],["の"],["罪","つみ"],["に"],["つき従って","つきしたがって"],["、"],["それ"],["を"],["離れなかった","はなれなかった"],["。"]]},{"verse":4,"text":"モアブの王,おうメシャは羊,ひつじの飼育,しいく者,もので、十万の小羊,こひつじと、十万の雄羊,おひつじの毛,けとを年々,ねんねんイスラエルの王,おうに納,おさめていたが、","tok":[["モアブ"],["の"],["王","おう"],["メシャ"],["は"],["羊","ひつじ"],["の"],["飼育者","しいくもの"],["で"],["、"],["十万","じゅうまん"],["の"],["小羊","こひつじ"],["と"],["、"],["十万","じゅうまん"],["の"],["雄羊","おひつじ"],["の"],["毛","け"],["と"],["を"],["年々","ねんねん"],["イスラエル"],["の"],["王","おう"],["に"],["納","おさめ"],["て"],["いた"],["が"],["、"]]},{"verse":5,"text":"アハブが死,しんだ後,のち、モアブの王,おうはイスラエルの王,おうにそむいた。","tok":[["アハブ"],["が"],["死んだ","しんだ"],["後","の"],["ち"],["、"],["モアブ"],["の"],["王","おう"],["は"],["イスラエル"],["の"],["王","おう"],["に"],["そむいた"],["。"]]},{"verse":6,"text":"そこでヨラム王,おうはその時,ときサマリヤを出,でて、イスラエルびとをことごとく集,あつめ、","tok":[["そこ"],["で"],["ヨラム"],["王","おう"],["は"],["その"],["時","とき"],["サマリヤ"],["を"],["出て","でて"],["、"],["イスラエル"],["びと"],["を"],["ことごとく"],["集め","あつめ"],["、"]]},{"verse":7,"text":"また、人,ひとをユダの王,おうヨシャパテにつかわし、「モアブの王,おうはわたしにそむきました。あなたはモアブと戦,たたかうために、わたしと一緒,いっしょに行,いかれませんか」と言,いわせた。彼,かれは言,いった、「行,いきましょう。わたしはあなたと一つです。わたしの民,たみはあなたの民,たみと一つです。わたしの馬,うまはあなたの馬,うまと一つです」。","tok":[["また"],["、"],["人","ひと"],["を"],["ユダ"],["の"],["王","おう"],["ヨシャパテ"],["に"],["つかわし"],["、"],["「"],["モアブ"],["の"],["王","おう"],["は"],["わたし"],["に"],["そむきました"],["。"],["あなた"],["は"],["モアブ"],["と"],["戦う","たたかう"],["ため"],["に"],["、"],["わたし"],["と"],["一緒","いっしょ"],["に"],["行かれません","いかれません"],["か"],["」"],["と"],["言わせた","いわせた"],["。"],["彼","かれ"],["は"],["言った","いった"],["、"],["「"],["行きましょう","いきましょう"],["。"],["わたし"],["は"],["あなた"],["と"],["一","ひと"],["つ"],["です"],["。"],["わたし"],["の"],["民","たみ"],["は"],["あなた"],["の"],["民","たみ"],["と"],["一","ひと"],["つ"],["です"],["。"],["わたし"],["の"],["馬","うま"],["は"],["あなた"],["の"],["馬","うま"],["と"],["一","ひと"],["つ"],["です"],["」"],["。"]]},{"verse":8,"text":"彼,かれはまた言,いった、「われわれはどの道,みちを上,のぼるのですか」。ヨラムは答,こたえた、「エドムの荒野,あらのの道,みちを上,のぼりましょう」。","tok":[["彼","かれ"],["は"],["また"],["言った","いった"],["、"],["「"],["われわれ"],["は"],["どの"],["道","みち"],["を"],["上る","のぼる"],["の"],["です"],["か"],["」"],["。"],["ヨラム"],["は"],["答","こたえ"],["た"],["、"],["「"],["エドム"],["の"],["荒野","あらの"],["の"],["道","みち"],["を"],["上りましょう","のぼりましょう"],["」"],["。"]]},{"verse":9,"text":"こうしてイスラエルの王,おうはユダの王,おうおよびエドムの王,おうと共,ともに出,でて行,いった。しかし彼,かれらは回,まわり道,みちをして、七日,なぬかの間,あいだ進,すすんだが、軍勢,ぐんぜいとそれに従,したがう家畜,かちくの飲,のむ水,みずがなかったので、","tok":[["こう"],["して"],["イスラエル"],["の"],["王","おう"],["は"],["ユダ"],["の"],["王","おう"],["および"],["エドム"],["の"],["王","おう"],["と"],["共","とも"],["に"],["出て","でて"],["行った","いった"],["。"],["しかし"],["彼","かれ"],["ら"],["は"],["回わり","まわり"],["道","みち"],["を"],["して"],["、"],["七日","なぬか"],["の"],["間進","あいだす"],["す"],["ん"],["だ"],["が"],["、"],["軍勢","ぐんぜい"],["と"],["それ"],["に"],["従う","したがう"],["家畜","かちく"],["の"],["飲む","のむ"],["水","みず"],["が"],["なかった"],["ので"],["、"]]},{"verse":10,"text":"イスラエルの王,おうは言,いった、「ああ、主,しゅは、この三人,にんの王,おうをモアブの手,てに渡,わたそうとして召,めし集,あつめられたのだ」。","tok":[["イスラエル"],["の"],["王","おう"],["は"],["言った","いった"],["、"],["「"],["ああ"],["、"],["主","しゅ"],["は"],["、"],["この"],["三人","にん"],["の"],["王","おう"],["を"],["モアブ"],["の"],["手","て"],["に"],["渡そう","わたそう"],["として"],["召","めし"],["集められた","あつめられた"],["の"],["だ"],["」"],["。"]]},{"verse":11,"text":"ヨシャパテは言,いった、「われわれが主,しゅに問,とうことのできる主,しゅの預言者,よげんしゃはここにいませんか」。イスラエルの王,おうのひとりの家来,けらいが答,こたえた、「エリヤの手,てに水,みずを注,そそいだシャパテの子,こエリシャがここにいます」。","tok":[["ヨシャパテ"],["は"],["言った","いった"],["、"],["「"],["われわれ"],["が"],["主に","しゅに"],["問う","とう"],["こと"],["の"],["できる"],["主","しゅ"],["の"],["預言者","よげんしゃ"],["は"],["ここ"],["に"],["いません"],["か"],["」"],["。"],["イスラエル"],["の"],["王","おう"],["の"],["ひとり"],["の"],["家来","けらい"],["が"],["答","こたえ"],["た"],["、"],["「"],["エリヤ"],["の"],["手","て"],["に"],["水","みず"],["を"],["注いだ","そそいだ"],["シャパテ"],["の"],["子","こ"],["エリシャ"],["が"],["ここ"],["に"],["います"],["」"],["。"]]},{"verse":12,"text":"ヨシャパテは言,いった、「主,しゅの言葉,ことばが彼,かれにあります」。そこでイスラエルの王,おうとヨシャパテとエドムの王,おうとは彼,かれのもとへ下,くだっていった。","tok":[["ヨシャパテ"],["は"],["言った","いった"],["、"],["「"],["主","しゅ"],["の"],["言葉","ことば"],["が"],["彼","かれ"],["に"],["あります"],["」"],["。"],["そこ"],["で"],["イスラエル"],["の"],["王","おう"],["と"],["ヨシャパテ"],["と"],["エドム"],["の"],["王","おう"],["と"],["は"],["彼","かれ"],["の"],["もと"],["へ"],["下って","くだって"],["いった"],["。"]]},{"verse":13,"text":"エリシャはイスラエルの王,おうに言,いった、「わたしはあなたとなんのかかわりがありますか。あなたの父上,ちちうえの預言者,よげんしゃたちと母上,ははうえの預言者,よげんしゃたちの所,ところへ行,いきなさい」。イスラエルの王,おうは彼,かれに言,いった、「いいえ、主,しゅがこの三人,にんの王,おうをモアブの手,てに渡,わたそうとして召,めし集,あつめられたのです」。","tok":[["エリシャ"],["は"],["イスラエル"],["の"],["王","おう"],["に"],["言った","いった"],["、"],["「"],["わたし"],["は"],["あなた"],["と"],["なん"],["の"],["かかわり"],["が"],["あります"],["か"],["。"],["あなた"],["の"],["父上","ちちうえ"],["の"],["預言者","よげんしゃ"],["たち"],["と"],["母上","ははうえ"],["の"],["預言者","よげんしゃ"],["たち"],["の"],["所","ところ"],["へ"],["行き","いき"],["なさい"],["」"],["。"],["イスラエル"],["の"],["王","おう"],["は"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["いいえ"],["、"],["主","しゅがこ"],["の"],["三人","にん"],["の"],["王","おう"],["を"],["モアブ"],["の"],["手","て"],["に"],["渡そう","わたそう"],["として"],["召","めし"],["集められた","あつめられた"],["の"],["です"],["」"],["。"]]},{"verse":14,"text":"エリシャは言,いった、「わたしの仕,つかえる万軍,ばんぐんの主,しゅは生,いきておられます。わたしはユダの王,おうヨシャパテのためにするのでなければ、あなたを顧,かえりみ、あなたに会,あうことはしないのだが、","tok":[["エリシャ"],["は"],["言った","いった"],["、"],["「"],["わたし"],["の"],["仕える","つかえる"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["生きて","いきて"],["おられます"],["。"],["わたし"],["は"],["ユダ"],["の"],["王","おう"],["ヨシャパテ"],["の"],["ため"],["に"],["する"],["ので"],["なければ"],["、"],["あなた"],["を"],["顧りみ","かえりみ"],["、"],["あなた"],["に"],["会う","あう"],["こと"],["は"],["しない"],["の"],["だ"],["が"],["、"]]},{"verse":15,"text":"いま楽人,がくじんをわたしの所,ところに連,つれてきなさい」。そこで楽人,がくじんが楽,がくを奏,そうすると、主,しゅの手,てが彼,かれに臨,のぞんで、","tok":[["いま"],["楽人","がくじん"],["を"],["わたし"],["の"],["所","ところ"],["に"],["連れて","つれて"],["き"],["なさい"],["」"],["。"],["そこ"],["で"],["楽人","がくじん"],["が"],["楽","がく"],["を"],["奏する","そうする"],["と"],["、"],["主","しゅ"],["の"],["手","て"],["が"],["彼","かれ"],["に"],["臨んで","のぞんで"],["、"]]},{"verse":16,"text":"彼,かれは言,いった、「主,しゅはこう仰,おおせられる、『わたしはこの谷,たにを水,みずたまりで満,みたそう』。","tok":[["彼","かれ"],["は"],["言った","いった"],["、"],["「"],["主","しゅ"],["は"],["こう"],["仰せられる","おおせられる"],["、"],["『"],["わたし"],["は"],["この"],["谷","たに"],["を"],["水たまり","みずたまり"],["で"],["満たそう","みたそう"],["』"],["。"]]},{"verse":17,"text":"これは主,しゅがこう仰,おおせられるからである、『あなたがたは風,かぜも雨,あめも見,みないのに、この谷,たにに水,みずが満,みちて、あなたがたと、その家畜,かちくおよび獣,けものが飲,のむであろう』。","tok":[["これ"],["は"],["主","しゅ"],["が"],["こう"],["仰せられる","おおせられる"],["から"],["で"],["ある"],["、"],["『"],["あなた"],["がた"],["は"],["風","かぜ"],["も"],["雨","あめ"],["も"],["見ない","みない"],["のに"],["、"],["この"],["谷","たに"],["に"],["水","みず"],["が"],["満ちて","みちて"],["、"],["あなた"],["がた"],["と"],["、"],["その"],["家畜","かちく"],["および"],["獣","けもの"],["が"],["飲むで","のむで"],["あろう"],["』"],["。"]]},{"verse":18,"text":"これは主,しゅの目,めには小,ちいさい事,ことである。主,しゅはモアブびとをも、あなたがたの手,てに渡,わたされる。","tok":[["これ"],["は"],["主","しゅ"],["の"],["目","め"],["に"],["は"],["小さい","ちいさい"],["事","こと"],["で"],["ある"],["。"],["主","しゅ"],["は"],["モアブ"],["びと"],["を"],["も"],["、"],["あなた"],["がた"],["の"],["手","て"],["に"],["渡される","わたされる"],["。"]]},{"verse":19,"text":"そしてあなたがたはすべての堅固,けんごな町,まちと、すべての良,よい町,まちを撃,うち、すべての良,よい木,きを切,きり倒,たおし、すべての水,みずの井戸,いどをふさぎ、石,いしをもって地,ちのすべての良,よい所,ところを荒,あらすであろう」。","tok":[["そして"],["あなた"],["がた"],["は"],["すべて"],["の"],["堅固","けんご"],["な"],["町","まち"],["と"],["、"],["すべて"],["の"],["良い","よい"],["町","まち"],["を"],["撃ち","うち"],["、"],["すべて"],["の"],["良い","よい"],["木","き"],["を"],["切り倒し","きりたおし"],["、"],["すべて"],["の"],["水","みず"],["の"],["井戸","いど"],["を"],["ふさぎ"],["、"],["石","いし"],["を"],["もって"],["地","ち"],["の"],["すべて"],["の"],["良い","よい"],["所","ところ"],["を"],["荒すで","あらすで"],["あろう"],["」"],["。"]]},{"verse":20,"text":"あくる朝,あさになって、供,そなえ物,ものをささげる時,ときに、水,みずがエドムの方,ほうから流,ながれてきて、水,みずは国,くにに満,みちた。","tok":[["あくる"],["朝","あさ"],["に"],["なって"],["、"],["供え物","そなえもの"],["を"],["ささげる"],["時","とき"],["に"],["、"],["水","みず"],["が"],["エドム"],["の"],["方","ほう"],["から"],["流れて","ながれて"],["きて"],["、"],["水","みず"],["は"],["国","くに"],["に"],["満ちた","みちた"],["。"]]},{"verse":21,"text":"さてモアブびとは皆,みな、王,おうたちが自分,じぶんたちを攻,せめるために上,のぼってきたのを聞,きいたので、よろいを着,きることのできる者,ものを、老,おいも若,わかきもことごとく召集,しょうしゅうして、国境,こっきょうに配置,はいちしたが、","tok":[["さて"],["モアブ"],["びと"],["は"],["皆","みな"],["、"],["王","おう"],["たち"],["が"],["自分","じぶん"],["たち"],["を"],["攻める","せめる"],["ため"],["に"],["上って","のぼって"],["きた"],["の"],["を"],["聞いた","きいた"],["ので"],["、"],["よろい"],["を"],["着る","きる"],["こと"],["の"],["できる"],["者","もの"],["を"],["、"],["老","おい"],["も"],["若き","わかき"],["も"],["ことごとく"],["召集","しょうしゅう"],["して"],["、"],["国境","こっきょう"],["に"],["配置","はいち"],["した"],["が"],["、"]]},{"verse":22,"text":"朝,あさはやく起,おきて、太陽,たいようがのぼって水,みずを照,てらしたとき、モアブびとは目,めの前,まえに血,ちのように赤,あかい水,みずを見,みたので、","tok":[["朝","あさ"],["はやく"],["起きて","おきて"],["、"],["太陽","たいよう"],["が"],["のぼって"],["水","みず"],["を"],["照","てらし"],["た"],["とき"],["、"],["モアブ"],["びと"],["は"],["目","め"],["の"],["前","まえ"],["に"],["血","ち"],["の"],["よう"],["に"],["赤い","あかい"],["水","みず"],["を"],["見た","みた"],["ので"],["、"]]},{"verse":23,"text":"彼,かれらは言,いった、「これは血,ちだ、きっと王,おうたちが互,たがいに戦,たたかって殺,ころし合,あったのだ。だから、モアブよ、ぶんどりに行,いきなさい」。","tok":[["彼","かれ"],["ら"],["は"],["言った","いった"],["、"],["「"],["これ"],["は"],["血","ち"],["だ"],["、"],["きっと"],["王","おう"],["たち"],["が"],["互","たがい"],["に"],["戦って","たたかって"],["殺ろし","ころし"],["合った","あった"],["の"],["だ"],["。"],["だ"],["から"],["、"],["モアブ"],["よ"],["、"],["ぶんどり"],["に"],["行き","いき"],["なさい"],["」"],["。"]]},{"verse":24,"text":"しかしモアブびとがイスラエルの陣営,じんえいに行,いくと、イスラエルびとは立,たちあがってモアブびとを撃,うったので、彼,かれらはイスラエルの前,まえから逃,にげ去,さった。イスラエルびとは進,すすんで、モアブびとを撃,うち、その国,くににはいって、","tok":[["しかし"],["モアブ"],["びと"],["が"],["イスラエル"],["の"],["陣営","じんえい"],["に"],["行く","いく"],["と"],["、"],["イスラエル"],["び"],["と"],["は"],["立ちあがって","たちあがって"],["モアブ"],["びと"],["を"],["撃った","うった"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["イスラエル"],["の"],["前","まえ"],["から"],["逃去","にげさっ"],["た"],["。"],["イスラエル"],["び"],["と"],["は"],["進んで","すすんで"],["、"],["モアブ"],["びと"],["を"],["撃ち","うち"],["、"],["その"],["国","くに"],["に"],["はいって"],["、"]]},{"verse":25,"text":"町々,まちまちを滅,ほろぼし、おのおの石,いしを一つずつ、地,ちのすべての良,よい所,ところに投,なげて、これに満,みたし、水,みずの井戸,いどをことごとくふさぎ、良,よい木,きをことごとく切,きり倒,たおして、ただキル・ハラセテはその名,なを残,のこすのみとなったが、石,いしを投,なげる者,ものがこれを囲,かこんで撃,うち滅,ほろぼした。","tok":[["町々","まちまち"],["を"],["滅ぼし","ほろぼし"],["、"],["おのおの"],["石","いし"],["を"],["一","ひと"],["つ"],["ずつ"],["、"],["地","ち"],["の"],["すべて"],["の"],["良い","よい"],["所","ところ"],["に"],["投て","なげて"],["、"],["これ"],["に"],["満たし","みたし"],["、"],["水","みず"],["の"],["井戸","いど"],["を"],["ことごとく"],["ふさぎ"],["、"],["良い","よい"],["木","き"],["を"],["ことごとく"],["切り倒して","きりたおして"],["、"],["ただ"],["キル"],["・"],["ハラセテ"],["は"],["その"],["名","な"],["を"],["残す","のこす"],["のみ"],["と"],["なった"],["が"],["、"],["石","いし"],["を"],["投る","なげる"],["者","もの"],["が"],["これ"],["を"],["囲んで","かこんで"],["撃ち","うち"],["滅ぼした","ほろぼした"],["。"]]},{"verse":26,"text":"モアブの王,おうは戦,たたかいがあまりに激,はげしく、当,あたりがたいのを見,みて、つるぎを抜,ぬく者,もの七百人,にんを率,ひきい、エドムの王,おうの所,ところに突,つき入,はいろうとしたが、果,はたさなかったので、","tok":[["モアブ"],["の"],["王","おう"],["は"],["戦い","たたかい"],["が"],["あまり"],["に"],["激しく","はげしく"],["、"],["当たり","あたり"],["がたい"],["の"],["を"],["見て","みて"],["、"],["つるぎ"],["を"],["抜く","ぬく"],["者","もの"],["七百人","にん"],["を"],["率い","ひきい"],["、"],["エドム"],["の"],["王","おう"],["の"],["所","ところ"],["に"],["突き入ろう","つきはいろう"],["と"],["した"],["が"],["、"],["果たさなかった","はたさなかった"],["ので"],["、"]]},{"verse":27,"text":"自分,じぶんの位,くらいを継,つぐべきその長子,ちょうしをとって城壁,じょうへきの上,うえで燔祭,はんさいとしてささげた。その時,ときイスラエルに大,おおいなる憤,いきどおりが臨,のぞんだので、彼,かれらは彼,かれをすてて自分,じぶんの国,くにに帰,かえった。","tok":[["自分","じぶん"],["の"],["位","くらい"],["を"],["継ぐべき","つぐべき"],["その"],["長子","ちょうし"],["を"],["とって"],["城壁","じょうへき"],["の"],["上","うえ"],["で"],["燔祭","はんさい"],["として"],["ささげた"],["。"],["その"],["時","とき"],["イスラエル"],["に"],["大いなる","おおいなる"],["憤り","いきどおり"],["が"],["臨","のぞんだ"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["彼","かれ"],["を"],["すてて"],["自分","じぶん"],["の"],["国","くに"],["に"],["帰えった","かえった"],["。"]]}]
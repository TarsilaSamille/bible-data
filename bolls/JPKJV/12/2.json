[{"verse":1,"text":"主,しゅがつむじ風,かぜをもってエリヤを天,てんに上,のぼらせようとされた時,とき、エリヤはエリシャと共,ともにギルガルを出,でて行,いった。","tok":[["主","しゅ"],["が"],["つむじ風","つむじかぜ"],["を"],["もって"],["エリヤ"],["を"],["天","てん"],["に"],["上らせよう","のぼらせよう"],["と"],["された"],["時","とき"],["、"],["エリヤ"],["は"],["エリシャ"],["と"],["共","とも"],["に"],["ギルガル"],["を"],["出て","でて"],["行った","いった"],["。"]]},{"verse":2,"text":"エリヤはエリシャに言,いった、「どうぞ、ここにとどまってください。主,しゅはわたしをベテルにつかわされるのですから」。しかしエリシャは言,いった、「主,しゅは生,いきておられます。またあなたも生,いきておられます。わたしはあなたを離,はなれません」。そして彼,かれらはベテルへ下,くだった。","tok":[["エリヤ"],["は"],["エリシャ"],["に"],["言った","いった"],["、"],["「"],["どうぞ"],["、"],["ここ"],["に"],["とどまって"],["ください"],["。"],["主","しゅ"],["は"],["わたし"],["を"],["ベテル"],["に"],["つかわされる"],["の"],["です"],["から"],["」"],["。"],["しかし"],["エリシャ"],["は"],["言った","いった"],["、"],["「"],["主","しゅ"],["は"],["生きて","いきて"],["おられます"],["。"],["また"],["あなた"],["も"],["生きて","いきて"],["おられます"],["。"],["わたし"],["は"],["あなた"],["を"],["離れません","はなれません"],["」"],["。"],["そして"],["彼","かれ"],["ら"],["は"],["ベテル"],["へ"],["下った","くだった"],["。"]]},{"verse":3,"text":"ベテルにいる預言者,よげんしゃのともがらが、エリシャのもとに出,でてきて彼,かれに言,いった、「主,しゅがきょう、あなたの師事,しじする主人,しゅじんをあなたから取,とられるのを知,しっていますか」。彼,かれは言,いった、「はい、知,しっています。あなたがたは黙,だまっていてください」。","tok":[["ベテル"],["に"],["いる"],["預言者","よげんしゃ"],["の"],["とも"],["がら"],["が"],["、"],["エリシャ"],["の"],["もと"],["に"],["出て","でて"],["きて"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["主","しゅ"],["が"],["きょう"],["、"],["あなた"],["の"],["師事","しじ"],["する"],["主人","しゅじん"],["を"],["あなた"],["から"],["取られる","とられる"],["の"],["を"],["知って","しって"],["います"],["か"],["」"],["。"],["彼","かれ"],["は"],["言った","いった"],["、"],["「"],["はい"],["、"],["知って","しって"],["います"],["。"],["あなた"],["がた"],["は"],["黙って","だまって"],["いて"],["ください"],["」"],["。"]]},{"verse":4,"text":"エリヤは彼,かれに言,いった、「エリシャよ、どうぞ、ここにとどまってください。主,しゅはわたしをエリコにつかわされるのですから」。しかしエリシャは言,いった、「主,しゅは生,いきておられます。またあなたも生,いきておられます。わたしはあなたを離,はなれません」。そして彼,かれらはエリコへ行,いった。","tok":[["エリヤ"],["は"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["エリシャ"],["よ"],["、"],["どうぞ"],["、"],["ここ"],["に"],["とどまって"],["ください"],["。"],["主","しゅ"],["は"],["わたし"],["を"],["エリコ"],["に"],["つかわされる"],["の"],["です"],["から"],["」"],["。"],["しかし"],["エリシャ"],["は"],["言った","いった"],["、"],["「"],["主","しゅ"],["は"],["生きて","いきて"],["おられます"],["。"],["また"],["あなた"],["も"],["生きて","いきて"],["おられます"],["。"],["わたし"],["は"],["あなた"],["を"],["離れません","はなれません"],["」"],["。"],["そして"],["彼","かれ"],["ら"],["は"],["エリコ"],["へ"],["行った","いった"],["。"]]},{"verse":5,"text":"エリコにいた預言者,よげんしゃのともがらが、エリシャのもとにきて彼,かれに言,いった、「主,しゅがきょう、あなたの師事,しじする主人,しゅじんをあなたから取,とられるのを知,しっていますか」。彼,かれは言,いった、「はい、知,しっています。あなたがたは黙,だまっていてください」。","tok":[["エリコ"],["に"],["いた"],["預言者","よげんしゃ"],["の"],["とも"],["がら"],["が"],["、"],["エリシャ"],["の"],["もと"],["に"],["きて"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["主","しゅ"],["が"],["きょう"],["、"],["あなた"],["の"],["師事","しじ"],["する"],["主人","しゅじん"],["を"],["あなた"],["から"],["取られる","とられる"],["の"],["を"],["知って","しって"],["います"],["か"],["」"],["。"],["彼","かれ"],["は"],["言った","いった"],["、"],["「"],["はい"],["、"],["知って","しって"],["います"],["。"],["あなた"],["がた"],["は"],["黙って","だまって"],["いて"],["ください"],["」"],["。"]]},{"verse":6,"text":"エリヤはまた彼,かれに言,いった、「どうぞ、ここにとどまってください。主,しゅはわたしをヨルダンにつかわされるのですから」。しかし彼,かれは言,いった、「主,しゅは生,いきておられます。またあなたも生,いきておられます。わたしはあなたを離,はなれません」。そしてふたりは進,すすんで行,いった。","tok":[["エリヤ"],["は"],["また"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["どうぞ"],["、"],["ここ"],["に"],["とどまって"],["ください"],["。"],["主","しゅ"],["は"],["わたし"],["を"],["ヨルダン"],["に"],["つかわされる"],["の"],["です"],["から"],["」"],["。"],["しかし"],["彼","かれ"],["は"],["言った","いった"],["、"],["「"],["主","しゅ"],["は"],["生きて","いきて"],["おられます"],["。"],["また"],["あなた"],["も"],["生きて","いきて"],["おられます"],["。"],["わたし"],["は"],["あなた"],["を"],["離れません","はなれません"],["」"],["。"],["そして"],["ふたり"],["は"],["進んで","すすんで"],["行った","いった"],["。"]]},{"verse":7,"text":"預言者,よげんしゃのともがら五十人,にんも行,いって、彼,かれらにむかって、はるかに離,はなれて立,たっていた。彼,かれらふたりは、ヨルダンのほとりに立,たったが、","tok":[["預言者","よげんしゃ"],["の"],["とも"],["がら"],["五","ご"],["十人","じゅうにん"],["も"],["行って","いって"],["、"],["彼","かれ"],["ら"],["に"],["むかって"],["、"],["はるか"],["に"],["離れて","はなれて"],["立って","たって"],["いた"],["。"],["彼","かれ"],["ら"],["ふたり"],["は"],["、"],["ヨルダン"],["の"],["ほとり"],["に"],["立った","たった"],["が"],["、"]]},{"verse":8,"text":"エリヤは外套,がいとうを取,とり、それを巻,まいて水,みずを打,うつと、水,みずが左右,さゆうに分,わかれたので、ふたりはかわいた土,つちの上,うえを渡,わたることができた。","tok":[["エリヤ"],["は"],["外套","がいとう"],["を"],["取","とり"],["、"],["それ"],["を"],["巻いて","まいて"],["水","みず"],["を"],["打つ","うつ"],["と"],["、"],["水","みず"],["が"],["左右","さゆう"],["に"],["分かれた","わかれた"],["ので"],["、"],["ふたり"],["は"],["かわいた"],["土","つち"],["の"],["上","うえ"],["を"],["渡る","わたる"],["こと"],["が"],["できた"],["。"]]},{"verse":9,"text":"彼,かれらが渡,わたったとき、エリヤはエリシャに言,いった、「わたしが取,とられて、あなたを離,はなれる前,まえに、あなたのしてほしい事,ことを求,もとめなさい」。エリシャは言,いった、「どうぞ、あなたの霊,れいの二つの分,ぶんをわたしに継,つがせてください」。","tok":[["彼","かれ"],["ら"],["が"],["渡った","わたった"],["とき"],["、"],["エリヤ"],["は"],["エリシャ"],["に"],["言った","いった"],["、"],["「"],["わたし"],["が"],["取られて","とられて"],["、"],["あなた"],["を"],["離れる","はなれる"],["前","まえ"],["に"],["、"],["あなた"],["の"],["して"],["ほしい"],["事","こと"],["を"],["求め","もとめ"],["なさい"],["」"],["。"],["エリシャ"],["は"],["言った","いった"],["、"],["「"],["どうぞ"],["、"],["あなた"],["の"],["霊","れい"],["の"],["二","ふた"],["つ"],["の"],["分","ぶん"],["を"],["わたし"],["に"],["継がせて","つがせて"],["ください"],["」"],["。"]]},{"verse":10,"text":"エリヤは言,いった、「あなたはむずかしい事,ことを求,もとめる。あなたがもし、わたしが取,とられて、あなたを離,はなれるのを見,みるならば、そのようになるであろう。しかし見,みないならば、そのようにはならない」。","tok":[["エリヤ"],["は"],["言った","いった"],["、"],["「"],["あなた"],["は"],["むずかしい"],["事","こと"],["を"],["求める","もとめる"],["。"],["あなた"],["が"],["もし"],["、"],["わたし"],["が"],["取られて","とられて"],["、"],["あなた"],["を"],["離れる","はなれる"],["の"],["を"],["見るならば","みるならば"],["、"],["その"],["よう"],["に"],["なるで"],["あろう"],["。"],["しかし"],["見ないならば","みないならば"],["、"],["その"],["よう"],["に"],["は"],["ならない"],["」"],["。"]]},{"verse":11,"text":"彼,かれらが進,すすみながら語,かたっていた時,とき、火,ひの車,くるまと火,ひの馬,うまがあらわれて、ふたりを隔,へだてた。そしてエリヤはつむじ風,かぜに乗,のって天,てんにのぼった。","tok":[["彼","かれ"],["ら"],["が"],["進み","すすみ"],["ながら"],["語って","かたって"],["いた"],["時","とき"],["、"],["火の車","ひのくるま"],["と"],["火","ひ"],["の"],["馬","うま"],["が"],["あらわれて"],["、"],["ふたり"],["を"],["隔てた","へだてた"],["。"],["そして"],["エリヤ"],["は"],["つむじ風","つむじかぜ"],["に"],["乗って","のって"],["天","てん"],["に"],["のぼった"],["。"]]},{"verse":12,"text":"エリシャはこれを見,みて「わが父,ちちよ、わが父,ちちよ、イスラエルの戦車,せんしゃよ、その騎兵,きへいよ」と叫,さけんだが、再,ふたたび彼,かれを見,みなかった。そこでエリシャは自分,じぶんの着物,きものをつかんで、それを二つに裂,さき、","tok":[["エリシャ"],["は"],["これ"],["を"],["見て","みて"],["「"],["わが"],["父","ちち"],["よ"],["、"],["わが"],["父","ちち"],["よ"],["、"],["イスラエル"],["の"],["戦車","せんしゃ"],["よ"],["、"],["その"],["騎兵","きへい"],["よ"],["」"],["と"],["叫けんだ","さけんだ"],["が"],["、"],["再び","ふたたび"],["彼","かれ"],["を"],["見なかった","みなかった"],["。"],["そこ"],["で"],["エリシャ"],["は"],["自分","じぶん"],["の"],["着物","きもの"],["を"],["つかんで"],["、"],["それ"],["を"],["二","ふた"],["つ"],["に"],["裂き","さき"],["、"]]},{"verse":13,"text":"またエリヤの身,みから落,おちた外套,がいとうを取,とり上,あげ、帰,かえってきてヨルダンの岸,きしに立,たった。","tok":[["また"],["エリヤ"],["の"],["身","み"],["から"],["落","おち"],["た"],["外套","がいとう"],["を"],["取上げ","とりあげ"],["、"],["帰えって","かえって"],["きて"],["ヨルダン"],["の"],["岸","きし"],["に"],["立った","たった"],["。"]]},{"verse":14,"text":"そしてエリヤの身,みから落,おちたその外套,がいとうを取,とって水,みずを打,うち、「エリヤの神,かみ、主,しゅはどこにおられますか」と言,いい、彼,かれが水,みずを打,うつと、水,みずは左右,さゆうに分,わかれたので、エリシャは渡,わたった。","tok":[["そして"],["エリヤ"],["の"],["身","み"],["から"],["落","おち"],["た"],["その"],["外套","がいとう"],["を"],["取って","とって"],["水","みず"],["を"],["打ち","うち"],["、"],["「"],["エリヤ"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["どこ"],["に"],["おられます"],["か"],["」"],["と"],["言い","いい"],["、"],["彼","かれ"],["が"],["水","みず"],["を"],["打つ","うつ"],["と"],["、"],["水","みず"],["は"],["左右","さゆう"],["に"],["分かれた","わかれた"],["ので"],["、"],["エリシャ"],["は"],["渡った","わたった"],["。"]]},{"verse":15,"text":"エリコにいる預言者,よげんしゃのともがらは彼,かれの近,ちかづいて来,くるのを見,みて、「エリヤの霊,れいがエリシャの上,うえにとどまっている」と言,いった。そして彼,かれらは来,きて彼,かれを迎,むかえ、その前,まえに地,ちに伏,ふして、","tok":[["エリコ"],["に"],["いる"],["預言者","よげんしゃ"],["の"],["とも"],["がら"],["は"],["彼","かれ"],["の"],["近づいて","ちかづいて"],["来る","くる"],["の"],["を"],["見て","みて"],["、"],["「"],["エリヤ"],["の"],["霊","れい"],["が"],["エリシャ"],["の"],["上","うえ"],["に"],["とどまって"],["いる"],["」"],["と"],["言った","いった"],["。"],["そして"],["彼","かれ"],["ら"],["は"],["来て","きて"],["彼","かれ"],["を"],["迎","むかえ"],["、"],["その"],["前","まえ"],["に"],["地","ち"],["に"],["伏して","ふして"],["、"]]},{"verse":16,"text":"彼,かれに言,いった、「しもべらの所,ところに力,ちからの強,つよい者,ものが五十人,にんいます。どうぞ彼,かれらをつかわして、あなたの主人,しゅじんを尋,たずねさせてください。主,しゅの霊,れいが彼,かれを引,ひきあげて、彼,かれを山,やまか谷,たにに投,なげたのかも知,しれません」。エリシャは「つかわしてはならない」と言,いったが、","tok":[["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["しもべ"],["ら"],["の"],["所","ところ"],["に"],["力","ちから"],["の"],["強い","つよい"],["者","もの"],["が"],["五","ご"],["十人","じゅうにん"],["います"],["。"],["どうぞ"],["彼","かれ"],["ら"],["を"],["つかわして"],["、"],["あなた"],["の"],["主人","しゅじん"],["を"],["尋ねさせて","たずねさせて"],["ください"],["。"],["主","しゅ"],["の"],["霊","れい"],["が"],["彼","かれ"],["を"],["引","ひき"],["あげて"],["、"],["彼","かれ"],["を"],["山","やま"],["か"],["谷","たに"],["に"],["投た","なげた"],["の"],["か"],["も"],["知れません","しれません"],["」"],["。"],["エリシャ"],["は"],["「"],["つかわして"],["は"],["ならない"],["」"],["と"],["言った","いった"],["が"],["、"]]},{"verse":17,"text":"彼,かれの恥,はじるまで、しいたので、彼,かれは「つかわしなさい」と言,いった。それで彼,かれらは五十人,にんの者,ものをつかわし、三日,かの間,あいだ尋,たずねたが、彼,かれを見,みいださなかった。","tok":[["彼","かれ"],["の"],["恥","はじ"],["る"],["まで"],["、"],["し"],["いた"],["ので"],["、"],["彼","かれ"],["は"],["「"],["つかわし"],["なさい"],["」"],["と"],["言った","いった"],["。"],["それ"],["で"],["彼","かれ"],["ら"],["は"],["五","ご"],["十人","じゅうにん"],["の"],["者","もの"],["を"],["つかわし"],["、"],["三日","か"],["の"],["間","あいだ"],["尋ねた","たずねた"],["が"],["、"],["彼","かれ"],["を"],["見いださなかった","みいださなかった"],["。"]]},{"verse":18,"text":"エリシャのなおエリコにとどまっている時,とき、彼,かれらが帰,かえってきたので、エリシャは彼,かれらに言,いった、「わたしは、あなたがたに、行,いってはならないと告,つげたではないか」。","tok":[["エリシャ"],["の"],["なお"],["エリコ"],["に"],["とどまって"],["いる"],["時","とき"],["、"],["彼","かれ"],["ら"],["が"],["帰えって","かえって"],["きた"],["ので"],["、"],["エリシャ"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["わたし"],["は"],["、"],["あなた"],["がた"],["に"],["、"],["行って","いって"],["は"],["ならない"],["と"],["告","つげ"],["たで"],["は"],["ない"],["か"],["」"],["。"]]},{"verse":19,"text":"町,まちの人々,ひとびとはエリシャに言,いった、「見,みられるとおり、この町,まちの場所,ばしょは良,よいが水,みずが悪,わるいので、この地,ちは流産,りゅうざんを起,おこすのです」。","tok":[["町","まち"],["の"],["人々","ひとびと"],["は"],["エリシャ"],["に"],["言った","いった"],["、"],["「"],["見られる","みられる"],["とおり"],["、"],["この"],["町","まち"],["の"],["場所","ばしょ"],["は"],["良い","よい"],["が"],["水","みず"],["が"],["悪い","わるい"],["ので"],["、"],["この"],["地","ち"],["は"],["流産","りゅうざん"],["を"],["起こす","おこす"],["の"],["です"],["」"],["。"]]},{"verse":20,"text":"エリシャは言,いった、「新,あたらしい皿,さらに塩,しおを盛,もって、わたしに持,もってきなさい」。彼,かれらは持,もってきた。","tok":[["エリシャ"],["は"],["言った","いった"],["、"],["「"],["新らしい","あたらしい"],["皿","さら"],["に"],["塩","しお"],["を"],["盛って","もって"],["、"],["わたし"],["に"],["持って","もって"],["き"],["なさい"],["」"],["。"],["彼","かれ"],["ら"],["は"],["持って","もって"],["きた"],["。"]]},{"verse":21,"text":"エリシャは水,みずの源,みなもとへ出,でて行,いって、塩,しおをそこに投,なげ入,いれて言,いった、「主,しゅはこう仰,おおせられる、『わたしはこの水,みずを良,よい水,みずにした。もはやここには死,しも流産,りゅうざんも起,おこらないであろう』」。","tok":[["エリシャ"],["は"],["水","みず"],["の"],["源","みなもと"],["へ"],["出て","でて"],["行って","いって"],["、"],["塩","しお"],["を"],["そこ"],["に"],["投入れて","なげいれて"],["言った","いった"],["、"],["「"],["主","しゅ"],["は"],["こう"],["仰せられる","おおせられる"],["、"],["『"],["わたし"],["は"],["この"],["水","みず"],["を"],["良い","よい"],["水","みず"],["に"],["した"],["。"],["もはや"],["ここ"],["に"],["は"],["死","し"],["も"],["流産","りゅうざん"],["も"],["起こらないで","おこらないで"],["あろう"],["』"],["」"],["。"]]},{"verse":22,"text":"こうしてその水,みずはエリシャの言,いったとおりに良,よい水,みずになって今日,こんにちに至,いたっている。","tok":[["こう"],["して"],["その"],["水","みず"],["は"],["エリシャ"],["の"],["言った","いった"],["とおり"],["に"],["良い","よい"],["水","みず"],["に"],["なって"],["今日","こんにち"],["に"],["至って","いたって"],["いる"],["。"]]},{"verse":23,"text":"彼,かれはそこからベテルへ上,のぼったが、上,のぼって行,いく途中,とちゅう、小,ちいさい子供,こどもらが町,まちから出,でてきて彼,かれをあざけり、彼,かれにむかって「はげ頭,あたまよ、のぼれ。はげ頭,あたまよ、のぼれ」と言,いったので、","tok":[["彼","かれ"],["は"],["そこ"],["から"],["ベテル"],["へ"],["上った","のぼった"],["が"],["、"],["上って","のぼって"],["行く","いく"],["途中","とちゅう"],["、"],["小さい","ちいさい"],["子供","こども"],["ら"],["が"],["町","まち"],["から"],["出て","でて"],["きて"],["彼","かれ"],["を"],["あざけり"],["、"],["彼","かれ"],["に"],["むかって"],["「"],["はげ頭","はげあたま"],["よ"],["、"],["のぼれ"],["。"],["はげ頭","はげあたま"],["よ"],["、"],["のぼれ"],["」"],["と"],["言った","いった"],["ので"],["、"]]},{"verse":24,"text":"彼,かれはふり返,かえって彼,かれらを見,み、主,しゅの名,なをもって彼,かれらをのろった。すると林,はやしの中,なかから二頭,とうの雌,めぐまが出,でてきて、その子,こ供,ともらのうち四十二人,にんを裂,さいた。","tok":[["彼","かれ"],["は"],["ふり返って","ふりかえって"],["彼","かれ"],["ら"],["を"],["見","み"],["、"],["主","しゅ"],["の"],["名","な"],["を"],["もって"],["彼","かれ"],["ら"],["を"],["のろった"],["。"],["する"],["と"],["林","はやし"],["の"],["中","なか"],["から"],["二頭","とう"],["の"],["雌","め"],["ぐま"],["が"],["出て","でて"],["きて"],["、"],["その"],["子供","ことも"],["ら"],["の"],["うち"],["四十二人","にん"],["を"],["裂いた","さいた"],["。"]]},{"verse":25,"text":"彼,かれはそこからカルメル山,やまへ行,いき、そこからサマリヤに帰,かえった。","tok":[["彼","かれ"],["は"],["そこ"],["から"],["カルメル"],["山","やま"],["へ"],["行き","いき"],["、"],["そこ"],["から"],["サマリヤ"],["に"],["帰えった","かえった"],["。"]]}]
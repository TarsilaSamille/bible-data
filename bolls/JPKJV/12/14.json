[{"verse":1,"text":"イスラエルの王,おうエホアハズの子,こヨアシの第,だい二年,ねんに、ユダの王,おうヨアシの子,こアマジヤが王,おうとなった。","tok":[["イスラエル"],["の"],["王","おう"],["エホアハズ"],["の"],["子","こ"],["ヨアシ"],["の"],["第","だい"],["二","に"],["年","ねん"],["に"],["、"],["ユダ"],["の"],["王","おう"],["ヨアシ"],["の"],["子","こ"],["アマジヤ"],["が"],["王","おう"],["と"],["なった"],["。"]]},{"verse":2,"text":"彼,かれは王,おうとなった時,とき二十五歳,さいで、二十九年,ねんの間,あいだエルサレムで世,よを治,おさめた。その母,はははエルサレムの出身,しゅっしんで、名,なをエホアダンといった。","tok":[["彼","かれ"],["は"],["王","おう"],["と"],["なった"],["時","とき"],["二十五歳","さ"],["いで"],["、"],["二十九","にじゅうきゅう"],["年","ねん"],["の"],["間","あいだ"],["エルサレム"],["で"],["世","よ"],["を"],["治めた","おさめた"],["。"],["その"],["母","はは"],["は"],["エルサレム"],["の"],["出身","しゅっしん"],["で"],["、"],["名","な"],["を"],["エホアダン"],["と"],["いった"],["。"]]},{"verse":3,"text":"アマジヤは主,しゅの目,めにかなう事,ことをおこなったが、先祖,せんぞダビデのようではなかった。彼,かれはすべての事,ことを父,ちちヨアシがおこなったようにおこなった。","tok":[["アマジヤ"],["は"],["主","しゅ"],["の"],["目","め"],["に"],["かなう"],["事","こと"],["を"],["おこなった"],["が"],["、"],["先祖","せんぞ"],["ダビデ"],["の"],["よう"],["で"],["は"],["なかった"],["。"],["彼","かれ"],["は"],["すべて"],["の"],["事","こと"],["を"],["父","ちち"],["ヨアシ"],["が"],["おこなった"],["よう"],["に"],["おこなった"],["。"]]},{"verse":4,"text":"ただし高,たかき所,ところは除,のぞかなかったので、民,たみはなおその高,たかき所,ところで犠牲,ぎせいをささげ、香,こうをたいた。","tok":[["ただし"],["高き","たかき"],["所","ところ"],["は"],["除かなかった","のぞかなかった"],["ので"],["、"],["民","たみ"],["は"],["なお"],["その"],["高き","たかき"],["所","ところ"],["で"],["犠牲","ぎせい"],["を"],["ささげ"],["、"],["香","こう"],["を"],["たいた"],["。"]]},{"verse":5,"text":"彼,かれは国,くにが彼,かれの手,てのうちに強,つよくなった時,とき、父,ちちヨアシ王,おうを殺害,さつがいした家来,けらいたちを殺,ころしたが、","tok":[["彼","かれ"],["は"],["国","くに"],["が"],["彼","かれ"],["の"],["手","て"],["の"],["うち"],["に"],["強く","つよく"],["なった"],["時","とき"],["、"],["父","ちち"],["ヨアシ"],["王","おう"],["を"],["殺害","さつがい"],["した"],["家来","けらい"],["たち"],["を"],["殺ろした","ころした"],["が"],["、"]]},{"verse":6,"text":"その殺害者,さつがいしゃの子供,こどもたちは殺,ころさなかった。これはモーセの律法,りっぽうの書,しょにしるされている所,ところに従,したがったのであって、そこに主,しゅは命,めいじて「父,ちちは子,このゆえに殺,ころさるべきではない。子,こは父,ちちのゆえに殺,ころさるべきではない。おのおの自分,じぶんの罪,つみのゆえに殺,ころさるべきである」と言,いわれている。","tok":[["その"],["殺害者","さつがいしゃ"],["の"],["子供","こども"],["たち"],["は"],["殺ろさなかった","ころさなかった"],["。"],["これ"],["は"],["モーセ"],["の"],["律法","りっぽう"],["の"],["書","しょ"],["に"],["しるされて"],["いる"],["所","ところ"],["に"],["従った","したがった"],["ので"],["あって"],["、"],["そこ"],["に"],["主","しゅ"],["は"],["命じて","めいじて"],["「"],["父","ちち"],["は"],["子","こ"],["の"],["ゆえ"],["に"],["殺さるべきで","ころさるべきで"],["は"],["ない"],["。"],["子","こ"],["は"],["父","ちち"],["の"],["ゆえ"],["に"],["殺さるべきで","ころさるべきで"],["は"],["ない"],["。"],["おのおの"],["自分","じぶん"],["の"],["罪","つみ"],["の"],["ゆえ"],["に"],["殺さるべきで","ころさるべきで"],["ある"],["」"],["と"],["言われて","いわれて"],["いる"],["。"]]},{"verse":7,"text":"アマジヤはまた塩,しおの谷,たにでエドムびと一万人,にんを殺,ころした。またセラを攻,せめ取,とって、その名,なをヨクテルと名,なづけたが、今日,こんにちまでそのとおりである。","tok":[["アマジヤ"],["は"],["また"],["塩","しお"],["の"],["谷","たに"],["で"],["エドム"],["びと"],["一万人","にん"],["を"],["殺ろした","ころした"],["。"],["また"],["セラ"],["を"],["攻め取って","せめとって"],["、"],["その"],["名","な"],["を"],["ヨクテル"],["と"],["名づけた","なづけた"],["が"],["、"],["今日","こんにちまでそ"],["の"],["とおり"],["で"],["ある"],["。"]]},{"verse":8,"text":"そこでアマジヤがエヒウの子,こエホアハズの子,こであるイスラエルの王,おうヨアシに使者,ししゃをつかわして、「さあ、われわれは互,たがいに顔,かおを合,あわせよう」と言,いわせたので、","tok":[["そこ"],["で"],["アマジヤ"],["が"],["エヒウ"],["の"],["子","こ"],["エホアハズ"],["の"],["子","こ"],["で"],["ある"],["イスラエル"],["の"],["王","おう"],["ヨアシ"],["に"],["使者","ししゃ"],["を"],["つかわして"],["、"],["「"],["さあ"],["、"],["われわれ"],["は"],["互","たがい"],["に"],["顔","かお"],["を"],["合","あわせ"],["よう"],["」"],["と"],["言わせた","いわせた"],["ので"],["、"]]},{"verse":9,"text":"イスラエルの王,おうヨアシはユダの王,おうアマジヤに言,いい送,おくった、「かつてレバノンのいばらがレバノンの香柏,こうはくに、『あなたの娘,むすめをわたしのむすこの妻,つまにください』と言,いい送,おくったことがあったが、レバノンの野獣,やじゅうがとおって、そのいばらを踏,ふみ倒,たおした。","tok":[["イスラエル"],["の"],["王","おう"],["ヨアシ"],["は"],["ユダ"],["の"],["王","おう"],["アマジヤ"],["に"],["言い送った","いいおくった"],["、"],["「"],["かつて"],["レバノン"],["の"],["いばら"],["が"],["レバノン"],["の"],["香","こう"],["柏","かしわ"],["に"],["、"],["『"],["あなた"],["の"],["娘","むすめ"],["を"],["わたし"],["の"],["むすこ"],["の"],["妻","つま"],["に"],["ください"],["』"],["と"],["言い送った","いいおくった"],["こと"],["が"],["あった"],["が"],["、"],["レバノン"],["の"],["野獣","やじゅう"],["が"],["とおって"],["、"],["その"],["いばら"],["を"],["踏み倒した","ふみたおした"],["。"]]},{"verse":10,"text":"あなたは大,おおいにエドムを撃,うって、心,こころにたかぶっているが、その栄誉,えいよに満足,まんぞくして家,いえにとどまりなさい。何,なにゆえ、あなたは災,わざわいをひき起,おこして、自分,じぶんもユダも共,ともに滅,ほろびるような事,ことをするのですか」。","tok":[["あなた"],["は"],["大いに","おおいに"],["エドム"],["を"],["撃って","うって"],["、"],["心","こころ"],["に"],["たかぶって"],["いる"],["が"],["、"],["その"],["栄誉","えいよ"],["に"],["満足","まんぞく"],["して"],["家","いえ"],["に"],["とどまり"],["なさい"],["。"],["何ゆえ","なにゆえ"],["、"],["あなた"],["は"],["災","わざわい"],["を"],["ひき起こして","ひきおこして"],["、"],["自分","じぶん"],["も"],["ユダ"],["も"],["共","とも"],["に"],["滅びる","ほろびる"],["よう"],["な"],["事","こと"],["を"],["する"],["の"],["です"],["か"],["」"],["。"]]},{"verse":11,"text":"しかしアマジヤが聞,ききいれなかったので、イスラエルの王,おうヨアシは上,のぼってきた。そこで彼,かれとユダの王,おうアマジヤはユダのベテシメシで互,たがいに顔,かおをあわせたが、","tok":[["しかし"],["アマジヤ"],["が"],["聞きいれなかった","ききいれなかった"],["ので"],["、"],["イスラエル"],["の"],["王","おう"],["ヨアシ"],["は"],["上って","のぼって"],["きた"],["。"],["そこ"],["で"],["彼","かれ"],["と"],["ユダ"],["の"],["王","おう"],["アマジヤ"],["は"],["ユダ"],["の"],["ベテシメシ"],["で"],["互","たがい"],["に"],["顔","かお"],["を"],["あわせた"],["が"],["、"]]},{"verse":12,"text":"ユダはイスラエルに敗,やぶられて、おのおのその天幕,てんまくに逃,にげ帰,かえった。","tok":[["ユダ"],["は"],["イスラエル"],["に"],["敗られて","やぶられて"],["、"],["おのおの"],["その"],["天幕","てんまく"],["に"],["逃","にげ"],["帰えった","かえった"],["。"]]},{"verse":13,"text":"イスラエルの王,おうヨアシはアハジヤの子,こヨアシの子,こであるユダの王,おうアマジヤをベテシメシで捕,とらえ、エルサレムにきて、エルサレムの城壁,じょうへきをエフライムの門,もんから隅,すみの門,もんまで、おおよそ四百キュビトにわたってこわし、","tok":[["イスラエル"],["の"],["王","おう"],["ヨアシ"],["は"],["アハジヤ"],["の"],["子","こ"],["ヨアシ"],["の"],["子","こ"],["で"],["ある"],["ユダ"],["の"],["王","おう"],["アマジヤ"],["を"],["ベテシメシ"],["で"],["捕らえ","とらえ"],["、"],["エルサレム"],["に"],["きて"],["、"],["エルサレム"],["の"],["城壁","じょうへき"],["を"],["エフライム"],["の"],["門","もん"],["から"],["隅","すみ"],["の"],["門","もん"],["まで"],["、"],["おおよそ"],["四百","よんひゃく"],["キュビト"],["に"],["わたって"],["こわし"],["、"]]},{"verse":14,"text":"また主,しゅの宮,みやと王,おうの家,いえの倉,くらにある金銀,きんぎんおよびもろもろの器,うつわをことごとく取,とり、かつ人質,ひとじちをとってサマリヤに帰,かえった。","tok":[["また"],["主","しゅ"],["の"],["宮","みや"],["と"],["王","おう"],["の"],["家","いえ"],["の"],["倉","くら"],["に"],["ある"],["金銀","きんぎん"],["および"],["もろもろ"],["の"],["器","うつわ"],["を"],["ことごとく"],["取","とり"],["、"],["かつ"],["人質","ひとじち"],["を"],["とって"],["サマリヤ"],["に"],["帰えった","かえった"],["。"]]},{"verse":15,"text":"ヨアシのその他,たの事績,じせきと、その武勇,ぶゆうおよび彼,かれがユダの王,おうアマジヤと戦,たたかった事,ことは、イスラエルの王,おうの歴代志,れきだいしの書,しょにしるされているではないか。","tok":[["ヨアシ"],["の"],["その"],["他","た"],["の"],["事績","じせき"],["と"],["、"],["その"],["武勇","ぶゆう"],["および"],["彼","かれ"],["が"],["ユダ"],["の"],["王","おう"],["アマジヤ"],["と"],["戦った","たたかった"],["事","こと"],["は"],["、"],["イスラエル"],["の"],["王","おう"],["の"],["歴代志","れきだいし"],["の"],["書","しょ"],["に"],["しるされて"],["いるで"],["は"],["ない"],["か"],["。"]]},{"verse":16,"text":"ヨアシはその先祖,せんぞたちと共,ともに眠,ねむって、イスラエルの王,おうたちと共,ともにサマリヤに葬,ほうむられ、その子,こヤラベアムが代,かわって王,おうとなった。","tok":[["ヨアシ"],["は"],["その"],["先祖","せんぞ"],["たち"],["と"],["共","とも"],["に"],["眠って","ねむって"],["、"],["イスラエル"],["の"],["王","おう"],["たち"],["と"],["共","とも"],["に"],["サマリヤ"],["に"],["葬むられ","ほうむられ"],["、"],["その"],["子","こ"],["ヤラベアム"],["が"],["代わって","かわって"],["王","おう"],["と"],["なった"],["。"]]},{"verse":17,"text":"ヨアシの子,こであるユダの王,おうアマジヤは、エホアハズの子,こであるイスラエルの王,おうヨアシが死,しんで後,のち、なお十五年,ねん生,いきながらえた。","tok":[["ヨアシ"],["の"],["子","こ"],["で"],["ある"],["ユダ"],["の"],["王","おう"],["アマジヤ"],["は"],["、"],["エホアハズ"],["の"],["子","こ"],["で"],["ある"],["イスラエル"],["の"],["王","おう"],["ヨアシ"],["が"],["死んで","しんで"],["後","の"],["ち"],["、"],["なお"],["十五","じゅうご"],["年","ねん"],["生きながらえた","いきながらえた"],["。"]]},{"verse":18,"text":"アマジヤのその他,たの事績,じせきは、ユダの王,おうの歴代志,れきだいしの書,しょにしるされているではないか。","tok":[["アマジヤ"],["の"],["その"],["他","た"],["の"],["事績","じせき"],["は"],["、"],["ユダ"],["の"],["王","おう"],["の"],["歴代志","れきだいし"],["の"],["書","しょ"],["に"],["しるされて"],["いるで"],["は"],["ない"],["か"],["。"]]},{"verse":19,"text":"時,ときに人々,ひとびとがエルサレムで徒党,ととうを結,むすび、彼,かれに敵対,てきたいしたので、彼,かれはラキシに逃,にげていったが、その人々,ひとびとはラキシに人,ひとをつかわして彼,かれをそこで殺,ころさせた。","tok":[["時","とき"],["に"],["人々","ひとびと"],["が"],["エルサレム"],["で"],["徒党","ととう"],["を"],["結び","むすび"],["、"],["彼","かれ"],["に"],["敵対","てきたい"],["した"],["ので"],["、"],["彼","かれ"],["は"],["ラキシ"],["に"],["逃て","にげて"],["いった"],["が"],["、"],["その"],["人々","ひとびと"],["は"],["ラキシ"],["に"],["人","ひと"],["を"],["つかわして"],["彼","かれ"],["を"],["そこ"],["で"],["殺させた","ころさせた"],["。"]]},{"verse":20,"text":"人々,ひとびとは彼,かれを馬,うまに載,のせて運,はこんできて、エルサレムで彼,かれを先祖,せんぞたちと共,ともにダビデの町,まちに葬,ほうむった。","tok":[["人々","ひとびと"],["は"],["彼","かれ"],["を"],["馬","うま"],["に"],["載せて","のせて"],["運こんで","はこんで"],["きて"],["、"],["エルサレム"],["で"],["彼","かれ"],["を"],["先祖","せんぞ"],["たち"],["と"],["共","とも"],["に"],["ダビデ"],["の"],["町","まち"],["に"],["葬むった","ほうむった"],["。"]]},{"verse":21,"text":"そしてユダの民,たみは皆,みなアザリヤを父,ちちアマジヤの代,かわりに王,おうとした。時,ときに年,ねん十六歳,さいであった。","tok":[["そして"],["ユダ"],["の"],["民","たみ"],["は"],["皆","みな"],["アザリヤ"],["を"],["父","ちち"],["アマジヤ"],["の"],["代わり","かわり"],["に"],["王","おう"],["と"],["した"],["。"],["時","とき"],["に"],["年","ねん"],["十六歳","さ"],["いで"],["あった"],["。"]]},{"verse":22,"text":"彼,かれはエラテの町,まちを建,たてて、これをユダに復帰,ふっきさせた。これはかの王,おうがその先祖,せんぞたちと共,ともに眠,ねむった後,のちであった。","tok":[["彼","かれ"],["は"],["エラテ"],["の"],["町","まち"],["を"],["建てて","たてて"],["、"],["これ"],["を"],["ユダ"],["に"],["復帰","ふっき"],["させた"],["。"],["これ"],["は"],["かの"],["王","おう"],["が"],["その"],["先祖","せんぞ"],["たち"],["と"],["共","とも"],["に"],["眠った","ねむった"],["後","の"],["ち"],["で"],["あった"],["。"]]},{"verse":23,"text":"ユダの王,おうヨアシの子,こアマジヤの第,だい十五年,ねんに、イスラエルの王,おうヨアシの子,こヤラべアムがサマリヤで王,おうとなって四十一年,ねんの間,あいだ、世,よを治,おさめた。","tok":[["ユダ"],["の"],["王","おう"],["ヨアシ"],["の"],["子","こ"],["アマジヤ"],["の"],["第","だい"],["十五","じゅうご"],["年","ねん"],["に"],["、"],["イスラエル"],["の"],["王","おう"],["ヨアシ"],["の"],["子","こ"],["ヤラ"],["べ"],["アム"],["が"],["サマリヤ"],["で"],["王","おう"],["と"],["なって"],["四十一","よんじゅういち"],["年","ねん"],["の"],["間","あいだ"],["、"],["世","よ"],["を"],["治めた","おさめた"],["。"]]},{"verse":24,"text":"彼,かれは主,しゅの目,めの前,まえに悪,あくを行,おこない、イスラエルに罪,つみを犯,おかさせたネバテの子,こヤラベアムの罪,つみを離,はなれなかった。","tok":[["彼","かれ"],["は"],["主","しゅ"],["の"],["目","め"],["の"],["前","まえ"],["に"],["悪","あく"],["を"],["行ない","おこない"],["、"],["イスラエル"],["に"],["罪","つみ"],["を"],["犯させた","おかさせた"],["ネバテ"],["の"],["子","こ"],["ヤラベアム"],["の"],["罪","つみ"],["を"],["離れなかった","はなれなかった"],["。"]]},{"verse":25,"text":"彼,かれはハマテの入口,いりぐちからアラバの海,うみまで、イスラエルの領域,りょういきを回復,かいふくした。イスラエルの神,かみ、主,しゅがガテヘペルのアミッタイの子,こである、そのしもべ預言者,よげんしゃヨナによって言,いわれた言葉,ことばのとおりである。","tok":[["彼","かれ"],["は"],["ハマテ"],["の"],["入口","いりぐち"],["から"],["アラバ"],["の"],["海","うみ"],["まで"],["、"],["イスラエル"],["の"],["領域","りょういき"],["を"],["回復","かいふく"],["した"],["。"],["イスラエル"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["ガテヘペル"],["の"],["アミッタイ"],["の"],["子","こ"],["で"],["ある"],["、"],["その"],["しもべ"],["預言者","よげんしゃ"],["ヨナ"],["によって"],["言われた","いわれた"],["言葉","ことば"],["の"],["とおり"],["で"],["ある"],["。"]]},{"verse":26,"text":"主,しゅはイスラエルの悩,なやみの非常,ひじょうに激,はげしいのを見,みられた。そこにはつながれた者,ものも、自由,じゆうな者,ものもいなくなり、またイスラエルを助,たすける者,ものもいなかった。","tok":[["主","しゅ"],["は"],["イスラエル"],["の"],["悩み","なやみ"],["の"],["非常","ひじょう"],["に"],["激しい","はげしい"],["の"],["を"],["見られた","みられた"],["。"],["そこ"],["に"],["は"],["つながれた"],["者","もの"],["も"],["、"],["自由","じゆう"],["な"],["者","もの"],["も"],["いなく"],["なり"],["、"],["また"],["イスラエル"],["を"],["助ける","たすける"],["者","もの"],["も"],["いなかった"],["。"]]},{"verse":27,"text":"しかし主,しゅはイスラエルの名,なを天,あめが下,したから消,けし去,さろうとは言,いわれなかった。そして彼,かれらをヨアシの子,こヤラベアムの手,てによって救,すくわれた。","tok":[["しかし"],["主","しゅ"],["は"],["イスラエル"],["の"],["名","な"],["を"],["天","あ"],["め"],["が"],["下","した"],["から"],["消し去ろう","けしさろう"],["と"],["は"],["言われなかった","いわれなかった"],["。"],["そして"],["彼","かれ"],["ら"],["を"],["ヨアシ"],["の"],["子","こ"],["ヤラベアム"],["の"],["手","て"],["によって"],["救われた","すくわれた"],["。"]]},{"verse":28,"text":"ヤラベアムのその他,たの事績,じせきと、彼,かれがしたすべての事,ことおよびその武勇,ぶゆう、すなわち彼,かれが戦争,せんそうをした事,ことおよび、かつてユダに属,ぞくしていたダマスコとハマテを、イスラエルに復帰,ふっきさせた事,ことは、イスラエルの王,おうの歴代志,れきだいしの書,しょにしるされているではないか。","tok":[["ヤラベアム"],["の"],["その"],["他","た"],["の"],["事績","じせき"],["と"],["、"],["彼","かれ"],["が"],["した"],["すべて"],["の"],["事","こと"],["および"],["その"],["武勇","ぶゆう"],["、"],["すなわち"],["彼","かれ"],["が"],["戦争","せんそう"],["を"],["した"],["事","こと"],["および"],["、"],["かつて"],["ユダ"],["に"],["属して","ぞくして"],["いた"],["ダマスコ"],["と"],["ハマテ"],["を"],["、"],["イスラエル"],["に"],["復帰","ふっき"],["させた"],["事","こと"],["は"],["、"],["イスラエル"],["の"],["王","おう"],["の"],["歴代志","れきだいし"],["の"],["書","しょ"],["に"],["しるされて"],["いるで"],["は"],["ない"],["か"],["。"]]},{"verse":29,"text":"ヤラベアムはその先祖,せんぞであるイスラエルの王,おうたちと共,ともに眠,ねむって、その子,こゼカリヤが代,かわって王,おうとなった。","tok":[["ヤラベアム"],["は"],["その"],["先祖","せんぞ"],["で"],["ある"],["イスラエル"],["の"],["王","おう"],["たち"],["と"],["共","とも"],["に"],["眠って","ねむって"],["、"],["その"],["子","こ"],["ゼカリヤ"],["が"],["代わって","かわって"],["王","おう"],["と"],["なった"],["。"]]}]
[{"verse":1,"text":"さてアハジヤの母,ははアタリヤはその子,この死,しんだのを見,みて、立,たって王,おうの一族,いちぞくをことごとく滅,ほろぼしたが、","tok":[["さて"],["アハジヤ"],["の"],["母","はは"],["アタリヤ"],["は"],["その"],["子","こ"],["の"],["死んだ","しんだ"],["の"],["を"],["見て","みて"],["、"],["立って","たって"],["王","おう"],["の"],["一族","いちぞく"],["を"],["ことごとく"],["滅ぼした","ほろぼした"],["が"],["、"]]},{"verse":2,"text":"ヨラム王,おうの娘,むすめで、アハジヤの姉妹,しまいであるエホシバはアハジヤの子,こヨアシを、殺,ころされようとしている王,おうの子,こたちのうちから盗,ぬすみ取,とり、彼,かれとそのうばとを寝室,しんしつに入,いれて、アタリヤに隠,かくしたので、彼,かれはついに殺,ころされなかった。","tok":[["ヨラム"],["王","おう"],["の"],["娘","むすめ"],["で"],["、"],["アハジヤ"],["の"],["姉妹","しまい"],["で"],["ある"],["エホシバ"],["は"],["アハジヤ"],["の"],["子","こ"],["ヨアシ"],["を"],["、"],["殺ろされよう","ころされよう"],["として"],["いる"],["王","おう"],["の"],["子","こ"],["たち"],["の"],["うち"],["から"],["盗み","ぬすみ"],["取","とり"],["、"],["彼","かれ"],["と"],["そのう"],["ばと"],["を"],["寝室","しんしつ"],["に"],["入れて","いれて"],["、"],["アタリヤ"],["に"],["隠した","かくした"],["ので"],["、"],["彼","かれ"],["は"],["ついに"],["殺ろされなかった","ころされなかった"],["。"]]},{"verse":3,"text":"ヨアシはうばと共,ともに六年,ねんの間,あいだ、主,しゅの宮,みやに隠,かくれていたが、その間,かんアタリヤが国,くにを治,おさめた。","tok":[["ヨアシ"],["は"],["うば"],["と"],["共","とも"],["に"],["六","ろく"],["年","ねん"],["の"],["間","あいだ"],["、"],["主","しゅ"],["の"],["宮","みや"],["に"],["隠れて","かくれて"],["いた"],["が"],["、"],["その"],["間","かん"],["アタリヤ"],["が"],["国","くに"],["を"],["治めた","おさめた"],["。"]]},{"verse":4,"text":"第,だい七年,ねんになってエホヤダは人,ひとをつかわして、カリびとと近衛,このえ兵,へいとの大将,たいしょうたちを招,まねきよせ、主,しゅの宮,みやにいる自分,じぶんのもとにこさせ、彼,かれらと契約,けいやくを結,むすび、主,しゅの宮,みやで彼,かれらに誓,ちかいをさせて王,おうの子,こを見,みせ、","tok":[["第","だい"],["七","なな"],["年","ねん"],["に"],["なって"],["エホヤダ"],["は"],["人","ひと"],["を"],["つかわして"],["、"],["カリ"],["びと"],["と"],["近衛兵","このえへい"],["と"],["の"],["大将","たいしょう"],["たち"],["を"],["招きよせ","まねきよせ"],["、"],["主","しゅ"],["の"],["宮","みや"],["に"],["いる"],["自分","じぶん"],["の"],["もと"],["に"],["こさせ"],["、"],["彼","かれ"],["ら"],["と"],["契約","けいやく"],["を"],["結び","むすび"],["、"],["主","しゅ"],["の"],["宮","みや"],["で"],["彼","かれ"],["ら"],["に"],["誓い","ちかい"],["を"],["させて"],["王","おう"],["の"],["子","こ"],["を"],["見せ","みせ"],["、"]]},{"verse":5,"text":"命,めいじて言,いった、「あなたがたのする事,ことはこれです、すなわち、安息日,あんそくにちに非番,ひばんとなって王,おうの家,いえを守,まもるあなたがたの三分,ぶんの一は、","tok":[["命じて","めいじて"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["の"],["する"],["事","こと"],["は"],["これ"],["です"],["、"],["すなわち"],["、"],["安息日","あんそくにち"],["に"],["非番","ひばん"],["と"],["なって"],["王","おう"],["の"],["家","いえ"],["を"],["守","まもる"],["あなた"],["がた"],["の"],["三分","ぶん"],["の"],["一","いち"],["は"],["、"]]},{"verse":6,"text":"宮殿,きゅうでんを守,まもらなければならない。（他,たの三分,ぶんの一はスルの門,もんにおり、三分,ぶんの一は近衛,このえ兵,へいのうしろの門,もんにおる）。","tok":[["宮殿","きゅうでん"],["を"],["守らなければ","まもらなければ"],["ならない"],["。"],["（"],["他","た"],["の"],["三分","ぶん"],["の"],["一","いち"],["は"],["スル"],["の"],["門","もん"],["に"],["おり"],["、"],["三分","ぶん"],["の"],["一","いち"],["は"],["近衛兵","このえへい"],["の"],["うしろ"],["の"],["門","もん"],["に"],["おる"],["）"],["。"]]},{"verse":7,"text":"すべて安息日,あんそくにちに当番,とうばんで主,しゅの宮,みやを守,まもるあなたがたの二つの部隊,ぶたいは、","tok":[["すべて"],["安息日","あんそくにち"],["に"],["当番","とうばん"],["で"],["主","しゅ"],["の"],["宮","みや"],["を"],["守","まもる"],["あなた"],["がた"],["の"],["二","ふた"],["つ"],["の"],["部隊","ぶたい"],["は"],["、"]]},{"verse":8,"text":"おのおのの武器,ぶきを手,てに取,とって王,おうのまわりに立,たたなければならない。すべて列,れつに近,ちかよる者,ものは殺,ころされなければならない。あなたがたは王,おうが出,でる時,ときにも、はいる時,ときにも王,おうと共,ともにいなければならない」。","tok":[["おのおの"],["の"],["武器","ぶき"],["を"],["手","て"],["に"],["取って","とって"],["王","おう"],["の"],["まわり"],["に"],["立たなければ","たたなければ"],["ならない"],["。"],["すべて"],["列","れつ"],["に"],["近よる","ちかよる"],["者","もの"],["は"],["殺ろされなければ","ころされなければ"],["ならない"],["。"],["あなた"],["がた"],["は"],["王","おう"],["が"],["出る","でる"],["時","とき"],["に"],["も"],["、"],["は"],["いる"],["時","とき"],["に"],["も"],["王","おう"],["と"],["共","とも"],["に"],["いなければ"],["ならない"],["」"],["。"]]},{"verse":9,"text":"そこでその大将,たいしょうたちは祭司,さいしエホヤダがすべて命,めいじたとおりにおこなった。すなわち彼,かれらはおのおの安息日,あんそくにちに非番,ひばんとなる者,ものと、安息日,あんそくにちに当番,とうばんとなる者,ものとを率,ひきいて祭司,さいしエホヤダのもとにきたので、","tok":[["そこ"],["で"],["その"],["大将","たいしょう"],["たち"],["は"],["祭司","さいし"],["エホヤダ"],["が"],["すべて"],["命じた","めいじた"],["とおり"],["に"],["おこなった"],["。"],["すなわち"],["彼","かれ"],["ら"],["は"],["おのおの"],["安息日","あんそくにち"],["に"],["非番","ひばん"],["と"],["なる"],["者","もの"],["と"],["、"],["安息日","あんそくにち"],["に"],["当番","とうばん"],["と"],["なる"],["者","もの"],["と"],["を"],["率いて","ひきいて"],["祭司","さいし"],["エホヤダ"],["の"],["もと"],["に"],["きた"],["ので"],["、"]]},{"verse":10,"text":"祭司,さいしは主,しゅの宮,みやにあるダビデ王,おうのやりと盾,たてを大将,たいしょうたちに渡,わたした。","tok":[["祭司","さいし"],["は"],["主","しゅ"],["の"],["宮","みや"],["に"],["ある"],["ダビデ"],["王","おう"],["の"],["やり"],["と"],["盾","たて"],["を"],["大将","たいしょう"],["たち"],["に"],["渡","わたし"],["た"],["。"]]},{"verse":11,"text":"近衛,このえ兵,へいはおのおの手,てに武器,ぶきをとって主,しゅの宮,みやの南側,みなみがわから北側,きたがわまで、祭壇,さいだんと宮,みやを取,とり巻,まいて立,たった。","tok":[["近衛兵","このえへい"],["は"],["おのおの"],["手","て"],["に"],["武器","ぶき"],["を"],["とって"],["主","しゅ"],["の"],["宮","みや"],["の"],["南側","みなみがわ"],["から"],["北側","きたがわ"],["まで"],["、"],["祭壇","さいだん"],["と"],["宮","みや"],["を"],["取巻いて","とりまいて"],["立った","たった"],["。"]]},{"verse":12,"text":"そこでエホヤダは王,おうの子,こをつれ出,だして冠,かんむりをいただかせ、律法,りっぽうの書,しょを渡,わたし、彼,かれを王,おうと宣言,せんげんして油,あぶらを注,そそいだので、人々,ひとびとは手,てを打,うって「王,おう万歳,ばんざい」と言,いった。","tok":[["そこ"],["で"],["エホヤダ"],["は"],["王","おう"],["の"],["子","こ"],["を"],["つれ出して","つれだして"],["冠","かんむり"],["を"],["いただかせ"],["、"],["律法","りっぽう"],["の"],["書","しょ"],["を"],["渡","わたし"],["、"],["彼","かれ"],["を"],["王","おう"],["と"],["宣言","せんげん"],["して"],["油","あぶら"],["を"],["注いだ","そそいだ"],["ので"],["、"],["人々","ひとびと"],["は"],["手","て"],["を"],["打って","うって"],["「"],["王","おう"],["万歳","ばんざい"],["」"],["と"],["言った","いった"],["。"]]},{"verse":13,"text":"アタリヤは近衛,このえ兵,へいと民,たみの声,こえを聞,きいて、主,しゅの宮,みやに入,はいり、民,たみのところへ行,いって、","tok":[["アタリヤ"],["は"],["近衛兵","このえへい"],["と"],["民","たみ"],["の"],["声","こえ"],["を"],["聞いて","きいて"],["、"],["主","しゅ"],["の"],["宮","みや"],["に"],["入り","はいり"],["、"],["民","たみ"],["の"],["ところ"],["へ"],["行って","いって"],["、"]]},{"verse":14,"text":"見,みると、王,おうは慣例,かんれいにしたがって柱,はしらのかたわらに立,たち、王,おうのかたわらには大将,たいしょうたちとラッパ手,てたちが立,たち、また国,くにの民,たみは皆,みな喜,よろこんでラッパを吹,ふいていたので、アタリヤはその衣,ころもを裂,さいて、「反逆,はんぎゃくです、反逆,はんぎゃくです」と叫,さけんだ。","tok":[["見る","みる"],["と"],["、"],["王","おう"],["は"],["慣例","かんれい"],["に"],["したがって"],["柱","はしら"],["の"],["かたわら"],["に"],["立ち","たち"],["、"],["王","おう"],["の"],["かたわら"],["に"],["は"],["大将","たいしょう"],["たち"],["と"],["ラッパ"],["手","て"],["たち"],["が"],["立ち","たち"],["、"],["また"],["国","くに"],["の"],["民","たみ"],["は"],["皆","みな"],["喜こんで","よろこんで"],["ラッパ"],["を"],["吹いて","ふいて"],["いた"],["ので"],["、"],["アタリヤ"],["は"],["その"],["衣","ころも"],["を"],["裂いて","さいて"],["、"],["「"],["反逆","はんぎゃく"],["です"],["、"],["反逆","はんぎゃく"],["です"],["」"],["と"],["叫けんだ","さけんだ"],["。"]]},{"verse":15,"text":"その時,とき祭司,さいしエホヤダは軍勢,ぐんぜいを指揮,しきしていた大将,たいしょうたちに命,めいじて、「彼女,かのじょを列,れつの間,あいだをとおって出,でて行,いかせ、彼女,かのじょに従,したがう者,ものをつるぎをもって殺,ころしなさい」と言,いった。これは祭司,さいしがさきに「彼女,かのじょを主,しゅの宮,みやで殺,ころしてはならない」と言,いったからである。","tok":[["その"],["時","とき"],["祭司","さいし"],["エホヤダ"],["は"],["軍勢","ぐんぜい"],["を"],["指揮","しき"],["して"],["いた"],["大将","たいしょう"],["たち"],["に"],["命じて","めいじて"],["、"],["「"],["彼女","かのじょ"],["を"],["列","れつ"],["の"],["間","あいだ"],["を"],["とおって"],["出て","でて"],["行かせ","いかせ"],["、"],["彼女","かのじょ"],["に"],["従う","したがう"],["者","もの"],["を"],["つるぎ"],["を"],["もって"],["殺ろし","ころし"],["なさい"],["」"],["と"],["言った","いった"],["。"],["これ"],["は"],["祭司","さいし"],["が"],["さき"],["に"],["「"],["彼女","かのじょ"],["を"],["主","しゅ"],["の"],["宮","みや"],["で"],["殺ろし","ころし"],["ては"],["ならない"],["」"],["と"],["言った","いった"],["から"],["で"],["ある"],["。"]]},{"verse":16,"text":"そこで彼,かれらは彼女,かのじょを捕,とらえ、王,おうの家,いえの馬道,うまみちへ連,つれて行,いったが、彼女,かのじょはついにそこで殺,ころされた。","tok":[["そこ"],["で"],["彼","かれ"],["ら"],["は"],["彼女","かのじょ"],["を"],["捕らえ","とらえ"],["、"],["王","おう"],["の"],["家","いえ"],["の"],["馬道","うまみち"],["へ"],["連れて","つれて"],["行った","いった"],["が"],["、"],["彼女","かのじょ"],["は"],["ついに"],["そこ"],["で"],["殺ろされた","ころされた"],["。"]]},{"verse":17,"text":"かくてエホヤダは主,しゅと王,おうおよび民,たみとの間,あいだに、皆,みな主,しゅの民,たみとなるという契約,けいやくを立,たてさせ、また王,おうと民,たみとの間,あいだにもそれを立,たてさせた。","tok":[["かくて"],["エホヤダ"],["は"],["主","しゅ"],["と"],["王","おう"],["および"],["民","たみと"],["の"],["間","あいだ"],["に"],["、"],["皆","みな"],["主","しゅ"],["の"],["民","たみ"],["と"],["なる"],["と"],["いう"],["契約","けいやく"],["を"],["立させ","たてさせ"],["、"],["また"],["王","おう"],["と"],["民","たみ"],["と"],["の"],["間","あいだ"],["に"],["も"],["それ"],["を"],["立させた","たてさせた"],["。"]]},{"verse":18,"text":"そこで国,くにの民,たみは皆,みなバアルの宮,みやに行,いって、これをこわし、その祭壇,さいだんとその像,ぞうを打,うち砕,くだき、バアルの祭司,さいしマッタンをその祭壇,さいだんの前,まえで殺,ころした。そして祭司,さいしは主,しゅの宮,みやに管理,かんり人,ひとを置,おいた。","tok":[["そこ"],["で"],["国","くに"],["の"],["民","たみ"],["は"],["皆","みな"],["バアル"],["の"],["宮","みや"],["に"],["行って","いって"],["、"],["これ"],["を"],["こわし"],["、"],["その"],["祭壇","さいだん"],["と"],["その"],["像","ぞう"],["を"],["打ち砕き","うちくだき"],["、"],["バアル"],["の"],["祭司","さいし"],["マッタン"],["を"],["その"],["祭壇","さいだん"],["の"],["前","まえ"],["で"],["殺ろした","ころした"],["。"],["そして"],["祭司","さいし"],["は"],["主","しゅ"],["の"],["宮","みや"],["に"],["管理人","かんりひと"],["を"],["置いた","おいた"],["。"]]},{"verse":19,"text":"次,ついでエホヤダは大将,たいしょうたちと、カリびとと、近衛,このえ兵,へいと国,くにのすべての民,たみを率,ひきいて、主,しゅの宮,みやから王,おうを導,みちびき下,くだり、近衛,このえ兵,へいの門,もんの道,みちから王,おうの家,いえに入,はいり、王,おうの位,くらいに座,ざせしめた。","tok":[["次いで","ついで"],["エホヤダ"],["は"],["大将","たいしょう"],["たち"],["と"],["、"],["カリ"],["びと"],["と"],["、"],["近衛兵","このえへい"],["と"],["国","くに"],["の"],["すべて"],["の"],["民","たみ"],["を"],["率いて","ひきいて"],["、"],["主","しゅ"],["の"],["宮","みや"],["から"],["王","おう"],["を"],["導き","みちびき"],["下り","くだり"],["、"],["近衛兵","このえへい"],["の"],["門","もん"],["の"],["道","みち"],["から"],["王","おう"],["の"],["家","いえ"],["に"],["入り","はいり"],["、"],["王","おう"],["の"],["位","くらい"],["に"],["座せしめた","ざせしめた"],["。"]]},{"verse":20,"text":"こうして国,くにの民,たみは皆,みな喜,よろこび、町,まちはアタリヤが王,おうの家,いえでつるぎをもって殺,ころされてのち、おだやかになった。","tok":[["こう"],["して"],["国","くに"],["の"],["民","たみ"],["は"],["皆","みな"],["喜こび","よろこび"],["、"],["町","まち"],["は"],["アタリヤ"],["が"],["王","おう"],["の"],["家","いえ"],["で"],["つるぎ"],["を"],["もって"],["殺ろされて","ころされて"],["のち"],["、"],["おだやか"],["に"],["なった"],["。"]]}]
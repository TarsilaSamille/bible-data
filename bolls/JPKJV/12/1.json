[{"verse":1,"text":"アハブが死,しんだ後,のち、モアブはイスラエルにそむいた。","tok":[["アハブ"],["が"],["死んだ","しんだ"],["後","の"],["ち"],["、"],["モアブ"],["は"],["イスラエル"],["に"],["そむいた"],["。"]]},{"verse":2,"text":"さてアハジヤはサマリヤにある高殿,たかどののらんかんから落,おちて病気,びょうきになったので、使者,ししゃをつかわし、「行,いってエクロンの神,かみバアル・ゼブブに、この病気,びょうきがなおるかどうかを尋,たずねよ」と命,めいじた。","tok":[["さて"],["アハジヤ"],["は"],["サマリヤ"],["に"],["ある"],["高殿","たかどの"],["の"],["らんかん"],["から"],["落","おち"],["て"],["病気","びょうき"],["に"],["なった"],["ので"],["、"],["使者","ししゃ"],["を"],["つかわし"],["、"],["「"],["行って","いって"],["エクロン"],["の"],["神","かみ"],["バアル"],["・"],["ゼブブ"],["に"],["、"],["この"],["病気","びょうき"],["が"],["なおる"],["か"],["どう"],["か"],["を"],["尋ね","たずね"],["よ"],["」"],["と"],["命じた","めいじた"],["。"]]},{"verse":3,"text":"時,ときに、主,しゅの使,つかいはテシベびとエリヤに言,いった、「立,たって、上,のぼって行,いき、サマリヤの王,おうの使者,ししゃに会,あって言,いいなさい、『あなたがたがエクロンの神,かみバアル・ゼブブに尋,たずねようとして行,いくのは、イスラエルに神,かみがないためか』。","tok":[["時","とき"],["に"],["、"],["主","しゅ"],["の"],["使い","つかい"],["は"],["テシベ"],["びと"],["エリヤ"],["に"],["言った","いった"],["、"],["「"],["立って","たって"],["、"],["上って","のぼって"],["行き","いき"],["、"],["サマリヤ"],["の"],["王","おう"],["の"],["使者","ししゃ"],["に"],["会って","あって"],["言い","いい"],["なさい"],["、"],["『"],["あなた"],["がた"],["が"],["エクロン"],["の"],["神","かみ"],["バアル"],["・"],["ゼブブ"],["に"],["尋ねよう","たずねよう"],["として"],["行く","いく"],["の"],["は"],["、"],["イスラエル"],["に"],["神","かみ"],["が"],["ない"],["ため"],["か"],["』"],["。"]]},{"verse":4,"text":"それゆえ主,しゅはこう仰,おおせられる、『あなたは、登,のぼった寝台,しんだいから降,おりることなく、必,かならず死,しぬであろう』」。そこでエリヤは上,のぼって行,いった。","tok":[["それ"],["ゆえ"],["主","しゅ"],["は"],["こう"],["仰せられる","おおせられる"],["、"],["『"],["あなた"],["は"],["、"],["登った","のぼった"],["寝台","しんだい"],["から"],["降りる","おりる"],["こと"],["なく"],["、"],["必死","かならずし"],["ぬで"],["あろう"],["』"],["」"],["。"],["そこ"],["で"],["エリヤ"],["は"],["上って","のぼって"],["行った","いった"],["。"]]},{"verse":5,"text":"使者,ししゃたちがアハジヤのもとに帰,かえってきたので、アハジヤは彼,かれらに言,いった、「なぜ帰,かえってきたのか」。","tok":[["使者","ししゃ"],["たち"],["が"],["アハジヤ"],["の"],["もと"],["に"],["帰えって","かえって"],["きた"],["ので"],["、"],["アハジヤ"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["なぜ"],["帰えって","かえって"],["きた"],["の"],["か"],["」"],["。"]]},{"verse":6,"text":"彼,かれらは言,いった、「ひとりの人,ひとが上,のぼってきて、われわれに会,あって言,いいました、『おまえたちをつかわした王,おうの所,ところへ帰,かえって言,いいなさい。主,しゅはこう仰,おおせられる、あなたがエクロンの神,かみバアル・ゼブブに尋,たずねようとして人,ひとをつかわすのは、イスラエルに神,かみがないためなのか。それゆえあなたは、登,のぼった寝台,しんだいから降,おりることなく、必,かならず死,しぬであろう』」。","tok":[["彼","かれ"],["ら"],["は"],["言った","いった"],["、"],["「"],["ひとり"],["の"],["人","ひと"],["が"],["上って","のぼって"],["きて"],["、"],["われわれ"],["に"],["会って","あって"],["言いました","いいました"],["、"],["『"],["おまえ"],["たち"],["を"],["つかわした"],["王","おう"],["の"],["所","ところ"],["へ"],["帰えって","かえって"],["言い","いい"],["なさい"],["。"],["主","しゅ"],["は"],["こう"],["仰せられる","おおせられる"],["、"],["あなた"],["が"],["エクロン"],["の"],["神","かみ"],["バアル"],["・"],["ゼブブ"],["に"],["尋ねよう","たずねよう"],["として"],["人","ひと"],["を"],["つかわす"],["の"],["は"],["、"],["イスラエル"],["に"],["神","かみ"],["が"],["ない"],["ため"],["な"],["の"],["か"],["。"],["それ"],["ゆえ"],["あなた"],["は"],["、"],["登った","のぼった"],["寝台","しんだい"],["から"],["降りる","おりる"],["こと"],["なく"],["、"],["必死","かならずし"],["ぬで"],["あろう"],["』"],["」"],["。"]]},{"verse":7,"text":"アハジヤは彼,かれらに言,いった、「上,のぼってきて、あなたがたに会,あって、これらの事,ことを告,つげた人,ひとはどんな人,ひとであったか」。","tok":[["アハジヤ"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["上って","のぼって"],["きて"],["、"],["あなた"],["がた"],["に"],["会って","あって"],["、"],["これ"],["ら"],["の"],["事","こと"],["を"],["告","つげ"],["た"],["人","ひと"],["は"],["どんな"],["人","ひと"],["で"],["あった"],["か"],["」"],["。"]]},{"verse":8,"text":"彼,かれらは答,こたえた、「その人,ひとは毛,けごろもを着,きて、腰,こしに皮,かわの帯,おびを締,しめていました」。彼,かれは言,いった、「その人,ひとはテシべびとエリヤだ」。","tok":[["彼","かれ"],["ら"],["は"],["答","こたえ"],["た"],["、"],["「"],["その"],["人","ひと"],["は"],["毛ごろも","けごろも"],["を"],["着て","きて"],["、"],["腰","こし"],["に"],["皮","かわ"],["の"],["帯","おび"],["を"],["締","しめ"],["て"],["いました"],["」"],["。"],["彼","かれ"],["は"],["言った","いった"],["、"],["「"],["その"],["人","ひと"],["は"],["テシ"],["べ"],["びと"],["エリヤ"],["だ"],["」"],["。"]]},{"verse":9,"text":"そこで王,おうは五十人,にんの長,ちょうを、部下,ぶかの五十人,にんと共,ともにエリヤの所,ところへつかわした。彼,かれがエリヤの所,ところへ上,のぼっていくと、エリヤは山,やまの頂,いただきにすわっていたので、エリヤに言,いった、「神,かみの人,ひとよ、王,おうがあなたに、下,くだって来,くるようにと言,いわれます」。","tok":[["そこ"],["で"],["王","おう"],["は"],["五","ご"],["十人","じゅうにん"],["の"],["長","ちょう"],["を"],["、"],["部下","ぶか"],["の"],["五","ご"],["十人","じゅうにん"],["と"],["共","とも"],["に"],["エリヤ"],["の"],["所","ところ"],["へ"],["つかわした"],["。"],["彼","かれ"],["が"],["エリヤ"],["の"],["所","ところ"],["へ"],["上って","のぼって"],["いく"],["と"],["、"],["エリヤ"],["は"],["山","やま"],["の"],["頂","いただき"],["に"],["すわって"],["いた"],["ので"],["、"],["エリヤ"],["に"],["言った","いった"],["、"],["「"],["神","かみ"],["の"],["人","ひと"],["よ"],["、"],["王","おう"],["が"],["あなた"],["に"],["、"],["下って","くだって"],["来る","くる"],["よう"],["に"],["と"],["言われます","いわれます"],["」"],["。"]]},{"verse":10,"text":"しかしエリヤは五十人,にんの長,ちょうに答,こたえた、「わたしがもし神,かみの人,ひとであるならば、火,ひが天,てんから下,くだって、あなたと部下,ぶかの五十人,にんとを焼,やき尽,つくすでしょう」。そのように火,ひが天,てんから下,くだって、彼,かれと部下,ぶかの五十人,にんとを焼,やき尽,つくした。","tok":[["しかし"],["エリヤ"],["は"],["五","ご"],["十人","じゅうにん"],["の"],["長","ちょう"],["に"],["答","こたえ"],["た"],["、"],["「"],["わたし"],["が"],["もし"],["神","かみ"],["の"],["人","ひと"],["で"],["あるならば"],["、"],["火","ひ"],["が"],["天","てん"],["から"],["下って","くだって"],["、"],["あなた"],["と"],["部下","ぶか"],["の"],["五","ご"],["十人","じゅうにん"],["を"],["焼き","やき"],["尽くすでしょう","つくすでしょう"],["」"],["。"],["その"],["よう"],["に"],["火","ひ"],["が"],["天","てん"],["から"],["下って","くだって"],["、"],["彼","かれ"],["と"],["部下","ぶか"],["の"],["五","ご"],["十人","じゅうにん"],["を"],["焼き","やき"],["尽くした","つくした"],["。"]]},{"verse":11,"text":"王,おうはまた他,たの五十人,にんの長,ちょうを、部下,ぶかの五十人,にんと共,ともにエリヤにつかわした。彼,かれは上,のぼっていってエリヤに言,いった、「神,かみの人,ひとよ、王,おうがこう命,めいじられます、『すみやかに下,くだってきなさい』」。","tok":[["王","おう"],["は"],["また"],["他","た"],["の"],["五","ご"],["十人","じゅうにん"],["の"],["長","ちょう"],["を"],["、"],["部下","ぶか"],["の"],["五","ご"],["十人","じゅうにん"],["と"],["共","とも"],["に"],["エリヤ"],["に"],["つかわした"],["。"],["彼","かれ"],["は"],["上って","のぼって"],["いって"],["エリヤ"],["に"],["言った","いった"],["、"],["「"],["神","かみ"],["の"],["人","ひと"],["よ"],["、"],["王","おう"],["が"],["こう"],["命じられます","めいじられます"],["、"],["『"],["すみやか"],["に"],["下って","くだって"],["き"],["なさい"],["』"],["」"],["。"]]},{"verse":12,"text":"しかしエリヤは彼,かれらに答,こたえた、「わたしがもし神,かみの人,ひとであるならば、火,ひが天,てんから下,くだって、あなたと部下,ぶかの五十人,にんとを焼,やき尽,つくすでしょう」。そのように神,かみの火,ひが天,てんから下,くだって、彼,かれと部下,ぶかの五十人,にんとを焼,やき尽,つくした。","tok":[["しかし"],["エリヤ"],["は"],["彼","かれ"],["ら"],["に"],["答","こたえ"],["た"],["、"],["「"],["わたし"],["が"],["もし"],["神","かみ"],["の"],["人","ひと"],["で"],["あるならば"],["、"],["火","ひ"],["が"],["天","てん"],["から"],["下って","くだって"],["、"],["あなた"],["と"],["部下","ぶか"],["の"],["五","ご"],["十人","じゅうにん"],["を"],["焼き","やき"],["尽くすでしょう","つくすでしょう"],["」"],["。"],["その"],["よう"],["に"],["神","かみ"],["の"],["火","ひ"],["が"],["天","てん"],["から"],["下って","くだって"],["、"],["彼","かれ"],["と"],["部下","ぶか"],["の"],["五","ご"],["十人","じゅうにん"],["を"],["焼き","やき"],["尽くした","つくした"],["。"]]},{"verse":13,"text":"王,おうはまた第,だい三の五十人,にんの長,ちょうを部下,ぶかの五十人,にんと共,ともにつかわした。第,だい三の五十人,にんの長,ちょうは上,のぼっていって、エリヤの前,まえにひざまずき、彼,かれに願,ねがって言,いった、「神,かみの人,ひとよ、どうぞ、わたしの命,いのちと、あなたのしもべであるこの五十人,にんの命,いのちをあなたの目,めに尊,たっといものとみなしてください。","tok":[["王","おう"],["は"],["また"],["第","だい"],["三","さん"],["の"],["五","ご"],["十人","じゅうにん"],["の"],["長","ちょう"],["を"],["部下","ぶか"],["の"],["五","ご"],["十人","じゅうにん"],["と"],["共","とも"],["に"],["つかわした"],["。"],["第","だい"],["三","さん"],["の"],["五","ご"],["十人","じゅうにん"],["の"],["長","ちょう"],["は"],["上って","のぼって"],["いって"],["、"],["エリヤ"],["の"],["前","まえ"],["に"],["ひざまずき"],["、"],["彼","かれ"],["に"],["願って","ねがって"],["言った","いった"],["、"],["「"],["神","かみ"],["の"],["人","ひと"],["よ"],["、"],["どうぞ"],["、"],["わたし"],["の"],["命","いのち"],["と"],["、"],["あなた"],["の"],["しもべ"],["で"],["ある"],["この"],["五","ご"],["十人","じゅうにん"],["の"],["命","いのち"],["を"],["あなた"],["の"],["目","め"],["に"],["尊","たっといも"],["の"],["と"],["みなして"],["ください"],["。"]]},{"verse":14,"text":"ごらんなさい、火,ひが天,てんからくだって、さきの五十人,にんの長,ちょうふたりと、その部下,ぶかの五十人,にんずつとを焼,やき尽,つくしました。しかし今,いまわたしの命,いのちをあなたの目,めに尊,たっといものとみなしてください」。","tok":[["ごらん"],["なさい"],["、"],["火","ひ"],["が"],["天","てん"],["から"],["くだって"],["、"],["さき"],["の"],["五","ご"],["十人","じゅうにん"],["の"],["長う","ちょう"],["ふたり"],["と"],["、"],["その"],["部下","ぶか"],["の"],["五","ご"],["十人","じゅうにん"],["を"],["焼き","やき"],["尽くしました","つくしました"],["。"],["しかし"],["今","いま"],["わたし"],["の"],["命","いのち"],["を"],["あなた"],["の"],["目","め"],["に"],["尊","たっといも"],["の"],["と"],["みなして"],["ください"],["」"],["。"]]},{"verse":15,"text":"その時,とき、主,しゅの使,つかいはエリヤに言,いった、「彼,かれと共,ともに下,くだりなさい。彼,かれを恐,おそれてはならない」。そこでエリヤは立,たって、彼,かれと共,ともに下,くだり、王,おうのもとへ行,いって、","tok":[["その"],["時","とき"],["、"],["主","しゅ"],["の"],["使い","つかい"],["は"],["エリヤ"],["に"],["言った","いった"],["、"],["「"],["彼","かれ"],["と"],["共","とも"],["に"],["下","く"],["だり"],["なさい"],["。"],["彼","かれ"],["を"],["恐れて","おそれて"],["は"],["ならない"],["」"],["。"],["そこ"],["で"],["エリヤ"],["は"],["立って","たって"],["、"],["彼","かれ"],["と"],["共","とも"],["に"],["下り","くだり"],["、"],["王","おう"],["の"],["もと"],["へ"],["行って","いって"],["、"]]},{"verse":16,"text":"王,おうに言,いった、「主,しゅはこう仰,おおせられます、『あなたはエクロンの神,かみバアル・ゼブブに尋,たずねようと使者,ししゃをつかわしたが、それはイスラエルに、その言葉,ことばを求,もとむべき神,かみがないためであるか。それゆえあなたは、登,のぼった寝台,しんだいから降,おりることなく、必,かならず死,しぬであろう』」。","tok":[["王","おう"],["に"],["言った","いった"],["、"],["「"],["主","しゅ"],["は"],["こう"],["仰せられます","おおせられます"],["、"],["『"],["あなた"],["は"],["エクロン"],["の"],["神","かみ"],["バアル"],["・"],["ゼブブ"],["に"],["尋ねよう","たずねよう"],["と"],["使者","ししゃ"],["を"],["つかわした"],["が"],["、"],["それ"],["は"],["イスラエル"],["に"],["、"],["その"],["言葉","ことば"],["を"],["求むべき","もとむべき"],["神","かみ"],["が"],["ない"],["ため"],["で"],["ある"],["か"],["。"],["それ"],["ゆえ"],["あなた"],["は"],["、"],["登った","のぼった"],["寝台","しんだい"],["から"],["降りる","おりる"],["こと"],["なく"],["、"],["必死","かならずし"],["ぬで"],["あろう"],["』"],["」"],["。"]]},{"verse":17,"text":"彼,かれはエリヤが言,いった主,しゅの言葉,ことばのとおりに死,しんだが、彼,かれに子,こがなかったので、その兄弟,きょうだいヨラムが彼,かれに代,かわって王,おうとなった。これはユダの王,おうヨシャパテの子,こヨラムの第,だい二年,ねんである。","tok":[["彼","かれ"],["は"],["エリヤ"],["が"],["言った","いった"],["主","しゅ"],["の"],["言葉","ことば"],["の"],["とおり"],["に"],["死んだ","しんだ"],["が"],["、"],["彼","かれ"],["に"],["子","こ"],["が"],["なかった"],["ので"],["、"],["その"],["兄弟","きょうだい"],["ヨラム"],["が"],["彼","かれ"],["に"],["代わって","かわって"],["王","おう"],["と"],["なった"],["。"],["これ"],["は"],["ユダ"],["の"],["王","おう"],["ヨシャパテ"],["の"],["子","こ"],["ヨラム"],["の"],["第","だい"],["二","に"],["年","ねん"],["で"],["ある"],["。"]]},{"verse":18,"text":"アハジヤのその他,たの事績,じせきは、イスラエルの王,おうの歴代志,れきだいしの書,しょにしるされているではないか。","tok":[["アハジヤ"],["の"],["その"],["他","た"],["の"],["事績","じせき"],["は"],["、"],["イスラエル"],["の"],["王","おう"],["の"],["歴代志","れきだいし"],["の"],["書","しょ"],["に"],["しるされて"],["いるで"],["は"],["ない"],["か"],["。"]]}]
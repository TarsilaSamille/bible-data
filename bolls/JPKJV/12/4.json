[{"verse":1,"text":"預言者,よげんしゃのともがらの、ひとりの妻,つまがエリシャに呼,よばわって言,いった、「あなたのしもべであるわたしの夫,おっとが死,しにました。ごぞんじのように、あなたのしもべは主,しゅを恐,おそれる者,ものでありましたが、今,いま、債,さい主,しゅがきて、わたしのふたりの子供,こどもを取,とって奴隷,どれいにしようとしているのです」。","tok":[["預言者","よげんしゃ"],["の"],["とも"],["がら"],["の"],["、"],["ひとり"],["の"],["妻","つま"],["が"],["エリシャ"],["に"],["呼ばわって","よばわって"],["言った","いった"],["、"],["「"],["あなた"],["の"],["しもべ"],["で"],["ある"],["わたし"],["の"],["夫","おっと"],["が"],["死にました","しにました"],["。"],["ごぞんじ"],["の"],["よう"],["に"],["、"],["あなた"],["の"],["しもべ"],["は"],["主","しゅ"],["を"],["恐れる","おそれる"],["者","もの"],["で"],["ありました"],["が"],["、"],["今","いま"],["、"],["債主","さいしゅ"],["が"],["きて"],["、"],["わたし"],["の"],["ふたり"],["の"],["子供","こども"],["を"],["取って","とって"],["奴隷","どれい"],["に"],["しよう"],["として"],["いる"],["の"],["です"],["」"],["。"]]},{"verse":2,"text":"エリシャは彼女,かのじょに言,いった、「あなたのために何,なにをしましょうか。あなたの家,いえにどんな物,ものがあるか、言,いいなさい」。彼女,かのじょは言,いった、「一びんの油,あぶらのほかは、はしための家,いえに何,なにもありません」。","tok":[["エリシャ"],["は"],["彼女","かのじょ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["の"],["ため"],["に"],["何に","なに"],["を"],["しましょう"],["か"],["。"],["あなた"],["の"],["家","いえ"],["に"],["どんな"],["物","もの"],["が"],["ある"],["か"],["、"],["言い","いい"],["なさい"],["」"],["。"],["彼女","かのじょ"],["は"],["言った","いった"],["、"],["「"],["一","いち"],["びん"],["の"],["油","あぶら"],["の"],["ほか"],["は"],["、"],["はし"],["ため"],["の"],["家","いえ"],["に"],["何に","なに"],["も"],["ありません"],["」"],["。"]]},{"verse":3,"text":"彼,かれは言,いった、「ほかへ行,いって、隣,となりの人々,ひとびとから器,うつわを借,かりなさい。あいた器,うつわを借,かりなさい。少,すこしばかりではいけません。","tok":[["彼","かれ"],["は"],["言った","いった"],["、"],["「"],["ほか"],["へ"],["行って","いって"],["、"],["隣","となり"],["の"],["人々","ひとびと"],["から"],["器","うつわ"],["を"],["借","かり"],["なさい"],["。"],["あいた"],["器","うつわ"],["を"],["借","かり"],["なさい"],["。"],["少し","すこし"],["ばかり"],["で"],["は"],["いけません"],["。"]]},{"verse":4,"text":"そして内,うちにはいって、あなたの子供,こどもたちと一緒,いっしょに戸,との内,うちに閉,とじこもり、そのすべての器,うつわに油,あぶらをついで、いっぱいになったとき、一つずつそれを取,とりのけておきなさい」。","tok":[["そして"],["内","うち"],["に"],["はいって"],["、"],["あなた"],["の"],["子供","こども"],["たち"],["と"],["一緒","いっしょ"],["に"],["戸","と"],["の"],["内","うち"],["に"],["閉じこもり","とじこもり"],["、"],["その"],["すべて"],["の"],["器","うつわ"],["に"],["油","あぶら"],["を"],["ついで"],["、"],["いっぱい"],["に"],["なった"],["とき"],["、"],["一","ひと"],["つ"],["ずつ"],["それ"],["を"],["取","とり"],["のけて"],["おき"],["なさい"],["」"],["。"]]},{"verse":5,"text":"彼女,かのじょは彼,かれを離,はなれて去,さり、子供,こどもたちと一緒,いっしょに戸,との内,うちに閉,とじこもり、子供,こどもたちの持,もって来,くる器,うつわに油,あぶらをついだ。","tok":[["彼女","かのじょ"],["は"],["彼","かれ"],["を"],["離れて","はなれて"],["去り","さり"],["、"],["子供","こども"],["たち"],["と"],["一緒","いっしょ"],["に"],["戸","と"],["の"],["内","うち"],["に"],["閉じこもり","とじこもり"],["、"],["子供","こども"],["たち"],["の"],["持って","もって"],["来る","くる"],["器","うつわ"],["に"],["油","あぶら"],["を"],["ついだ"],["。"]]},{"verse":6,"text":"油,あぶらが満,みちたとき、彼女,かのじょは子供,こどもに「もっと器,うつわを持,もってきなさい」と言,いったが、子供,こどもが「器,うつわはもうありません」と言,いったので、油,あぶらはとまった。","tok":[["油","あぶら"],["が"],["満ちた","みちた"],["とき"],["、"],["彼女","かのじょ"],["は"],["子供","こども"],["に"],["「"],["もっと"],["器","うつわ"],["を"],["持って","もって"],["き"],["なさい"],["」"],["と"],["言った","いった"],["が"],["、"],["子供","こども"],["が"],["「"],["器","うつわ"],["は"],["もう"],["ありません"],["」"],["と"],["言った","いった"],["ので"],["、"],["油","あぶら"],["は"],["とまった"],["。"]]},{"verse":7,"text":"そこで彼女,かのじょは神,かみの人,ひとのところにきて告,つげたので、彼,かれは言,いった、「行,いって、その油,あぶらを売,うって負債,ふさいを払,はらいなさい。あなたと、あなたの子供,こどもたちはその残,のこりで暮,くらすことができます」。","tok":[["そこ"],["で"],["彼女","かのじょ"],["は"],["神","かみ"],["の"],["人","ひと"],["の"],["ところ"],["に"],["きて"],["告","つげ"],["た"],["ので"],["、"],["彼","かれ"],["は"],["言った","いった"],["、"],["「"],["行って","いって"],["、"],["その"],["油","あぶら"],["を"],["売って","うって"],["負債","ふさい"],["を"],["払","はらい"],["なさい"],["。"],["あなた"],["と"],["、"],["あなた"],["の"],["子供","こども"],["たち"],["は"],["その"],["残り","のこり"],["で"],["暮らす","くらす"],["こと"],["が"],["できます"],["」"],["。"]]},{"verse":8,"text":"ある日,ひエリシャはシュネムへ行,いったが、そこにひとりの裕福,ゆうふくな婦人,ふじんがいて、しきりに彼,かれに食事,しょくじをすすめたので、彼,かれはそこを通,とおるごとに、そこに寄,よって食事,しょくじをした。","tok":[["ある"],["日","ひ"],["エリシャ"],["は"],["シュネム"],["へ"],["行った","いった"],["が"],["、"],["そこ"],["に"],["ひとり"],["の"],["裕福","ゆうふく"],["な"],["婦人","ふじん"],["が"],["いて"],["、"],["しきり"],["に"],["彼","かれ"],["に"],["食事","しょくじ"],["を"],["すすめた"],["ので"],["、"],["彼","かれ"],["は"],["そこ"],["を"],["通る","とおる"],["ごと"],["に"],["、"],["そこ"],["に"],["寄って","よって"],["食事","しょくじ"],["を"],["した"],["。"]]},{"verse":9,"text":"その女,おんなは夫,おっとに言,いった、「いつもわたしたちの所,ところを通,とおるあの人,ひとは確,たしかに神,かみの聖,せいなる人,ひとです。","tok":[["その"],["女","おんな"],["は"],["夫","おっと"],["に"],["言った","いった"],["、"],["「"],["いつも"],["わたしたち"],["の"],["所","ところ"],["を"],["通る","とおる"],["あの"],["人","ひと"],["は"],["確か","たしか"],["に"],["神","かみ"],["の"],["聖","せい"],["なる"],["人","ひと"],["です"],["。"]]},{"verse":10,"text":"わたしたちは屋上,おくじょうに壁,かべのある一つの小,ちいさいへやを造,つくり、そこに寝台,しんだいと机,つくえといすと燭台,しょくだいとを彼,かれのために備,そなえましょう。そうすれば彼,かれがわたしたちの所,ところに来,くるとき、そこに、はいることができます」。","tok":[["わたしたち"],["は"],["屋上","おくじょう"],["に"],["壁","かべ"],["の"],["ある"],["一","ひと"],["つ"],["の"],["小さい","ちいさい"],["へや"],["を"],["造","つくり"],["、"],["そこ"],["に"],["寝台","しんだい"],["と"],["机","つくえ"],["と"],["いす"],["と"],["燭台","しょくだい"],["と"],["を"],["彼","かれ"],["の"],["ため"],["に"],["備","そなえ"],["ましょう"],["。"],["そう"],["すれば"],["彼","かれ"],["が"],["わたしたち"],["の"],["所","ところ"],["に"],["来る","くる"],["とき"],["、"],["そこ"],["に"],["、"],["はいる"],["こと"],["が"],["できます"],["」"],["。"]]},{"verse":11,"text":"さて、ある日,ひエリシャはそこにきて、そのへやにはいり、そこに休,やすんだが、","tok":[["さて"],["、"],["ある"],["日","ひ"],["エリシャ"],["は"],["そこ"],["に"],["きて"],["、"],["その"],["へや"],["に"],["はいり"],["、"],["そこ"],["に"],["休んだ","やすんだ"],["が"],["、"]]},{"verse":12,"text":"彼,かれはそのしもべゲハジに「このシュネムの女,おんなを呼,よんできなさい」と言,いった。彼,かれがその女,おんなを呼,よぶと、彼女,かのじょはきてエリシャの前,まえに立,たったので、","tok":[["彼","かれ"],["は"],["その"],["しもべ"],["ゲハジ"],["に"],["「"],["この"],["シュネム"],["の"],["女","おんな"],["を"],["呼んで","よんで"],["き"],["なさい"],["」"],["と"],["言った","いった"],["。"],["彼","かれ"],["が"],["その"],["女","おんな"],["を"],["呼ぶ","よぶ"],["と"],["、"],["彼女","かのじょ"],["は"],["きて"],["エリシャ"],["の"],["前","まえ"],["に"],["立った","たった"],["ので"],["、"]]},{"verse":13,"text":"エリシャはゲハジに言,いった、「彼女,かのじょに言,いいなさい、『あなたはこんなにねんごろに、わたしたちのために心,こころを用,もちいられたが、あなたのためには何,なにをしたらよいでしょうか。王,おうまたは軍勢,ぐんぜいの長,ちょうにあなたの事,ことをよろしく頼,たのむことをお望,のぞみですか』」。彼女,かのじょは答,こたえて言,いった、「わたしは自分,じぶんの民,たみのうちに住,すんでいます」。","tok":[["エリシャ"],["は"],["ゲハジ"],["に"],["言った","いった"],["、"],["「"],["彼女","かのじょ"],["に"],["言い","いい"],["なさい"],["、"],["『"],["あなた"],["は"],["こんな"],["に"],["ねんごろ"],["に"],["、"],["わたしたち"],["の"],["ため"],["に"],["心","こころ"],["を"],["用いられた","もちいられた"],["が"],["、"],["あなた"],["の"],["ため"],["に"],["は"],["何に","なに"],["を"],["したら"],["よいでしょう"],["か"],["。"],["王","おう"],["また"],["は"],["軍勢","ぐんぜい"],["の"],["長","ちょう"],["に"],["あなた"],["の"],["事","こと"],["を"],["よろしく"],["頼む","たのむ"],["こと"],["を"],["お望み","おのぞみ"],["です"],["か"],["』"],["」"],["。"],["彼女","かのじょ"],["は"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["わたし"],["は"],["自分","じぶん"],["の"],["民","たみ"],["の"],["うち"],["に"],["住んで","すんで"],["います"],["」"],["。"]]},{"verse":14,"text":"エリシャは言,いった、「それでは彼女,かのじょのために何,なにをしようか」。ゲハジは言,いった、「彼女,かのじょには子供,こどもがなく、その夫,おっとは老,おいています」。","tok":[["エリシャ"],["は"],["言った","いった"],["、"],["「"],["それ"],["で"],["は"],["彼女","かのじょ"],["の"],["ため"],["に"],["何に","なに"],["を"],["しよう"],["か"],["」"],["。"],["ゲハジ"],["は"],["言った","いった"],["、"],["「"],["彼女","かのじょ"],["に"],["は"],["子供","こども"],["が"],["なく"],["、"],["その"],["夫","おっと"],["は"],["老","おい"],["て"],["います"],["」"],["。"]]},{"verse":15,"text":"するとエリシャが「彼女,かのじょを呼,よびなさい」と言,いったので、彼女,かのじょを呼,よぶと、来,きて戸口,とぐちに立,たった。","tok":[["する"],["と"],["エリシャ"],["が"],["「"],["彼女","かのじょ"],["を"],["呼び","よび"],["なさい"],["」"],["と"],["言った","いった"],["ので"],["、"],["彼女","かのじょ"],["を"],["呼ぶ","よぶ"],["と"],["、"],["来て","きて"],["戸口","とぐち"],["に"],["立った","たった"],["。"]]},{"verse":16,"text":"エリシャは言,いった、「来年,らいねんの今,いまごろ、あなたはひとりの子,こを抱,だくでしょう」。彼女,かのじょは言,いった、「いいえ、わが主,しゅよ、神,かみの人,ひとよ、はしためを欺,あざむかないでください」。","tok":[["エリシャ"],["は"],["言った","いった"],["、"],["「"],["来年","らいねん"],["の"],["今ごろ","いまごろ"],["、"],["あなた"],["は"],["ひとり"],["の"],["子","こ"],["を"],["抱くでしょう","だくでしょう"],["」"],["。"],["彼女","かのじょ"],["は"],["言った","いった"],["、"],["「"],["いいえ"],["、"],["わが"],["主","しゅ"],["よ"],["、"],["神","かみ"],["の"],["人","ひと"],["よ"],["、"],["はし"],["ため"],["を"],["欺かないで","あざむかないで"],["ください"],["」"],["。"]]},{"verse":17,"text":"しかし女,おんなはついに身,みごもって、エリシャが彼女,かのじょに言,いったように、次,つぎの年,ねんのそのころに子,こを産,うんだ。","tok":[["しかし"],["女","おんな"],["は"],["ついに"],["身ごもって","みごもって"],["、"],["エリシャ"],["が"],["彼女","かのじょ"],["に"],["言った","いった"],["よう"],["に"],["、"],["次","つぎ"],["の"],["年","ねん"],["の"],["その"],["ころ"],["に"],["子","こ"],["を"],["産んだ","うんだ"],["。"]]},{"verse":18,"text":"その子,こが成長,せいちょうして、ある日,ひ、刈入,かりいれびとの所,ところへ出,でていって、父,ちちのもとへ行,いったが、","tok":[["その"],["子","こ"],["が"],["成長","せいちょう"],["して"],["、"],["ある"],["日","ひ"],["、"],["刈入れ","かりいれ"],["びと"],["の"],["所","ところ"],["へ"],["出て","でて"],["いって"],["、"],["父","ちち"],["の"],["もと"],["へ"],["行った","いった"],["が"],["、"]]},{"verse":19,"text":"父,ちちにむかって「頭,あたまが、頭,あたまが」と言,いったので、父,ちちはしもべに「彼,かれを母,ははのもとへ背負,せおっていきなさい」と言,いった。","tok":[["父","ちち"],["に"],["むかって"],["「"],["頭","あたま"],["が"],["、"],["頭","あたま"],["が"],["」"],["と"],["言った","いった"],["ので"],["、"],["父","ちち"],["は"],["しもべ"],["に"],["「"],["彼","かれ"],["を"],["母","はは"],["の"],["もと"],["へ"],["背負って","せおって"],["いき"],["なさい"],["」"],["と"],["言った","いった"],["。"]]},{"verse":20,"text":"彼,かれを背負,せおって母,ははのもとへ行,いくと、昼,ひるまで母,ははのひざの上,うえにすわっていたが、ついに死,しんだ。","tok":[["彼","かれ"],["を"],["背負って","せおって"],["母","はは"],["の"],["もと"],["へ"],["行く","いく"],["と"],["、"],["昼","ひる"],["まで"],["母","はは"],["の"],["ひざ"],["の"],["上","うえ"],["に"],["すわって"],["いた"],["が"],["、"],["ついに"],["死んだ","しんだ"],["。"]]},{"verse":21,"text":"母,ははは上,あがっていって、これを神,かみの人,ひとの寝台,しんだいの上,うえに置,おき、戸,とを閉,とじて出,でてきた。","tok":[["母","はは"],["は"],["上がって","あがって"],["いって"],["、"],["これ"],["を"],["神","かみ"],["の"],["人","ひと"],["の"],["寝台","しんだい"],["の"],["上","うえ"],["に"],["置き","おき"],["、"],["戸","と"],["を"],["閉じて","とじて"],["出て","でて"],["きた"],["。"]]},{"verse":22,"text":"そして夫,おっとを呼,よんで言,いった、「どうぞ、しもべひとりと、ろば一頭,とうをわたしにかしてください。急,いそいで神,かみの人,ひとの所,ところへ行,いって、また帰,かえってきます」。","tok":[["そして"],["夫","おっと"],["を"],["呼んで","よんで"],["言った","いった"],["、"],["「"],["どうぞ"],["、"],["しもべ"],["ひとり"],["と"],["、"],["ろば"],["一頭","とう"],["を"],["わたし"],["に"],["か"],["して"],["ください"],["。"],["急いで","いそいで"],["神","かみ"],["の"],["人","ひと"],["の"],["所","ところ"],["へ"],["行って","いって"],["、"],["また"],["帰えって","かえって"],["きます"],["」"],["。"]]},{"verse":23,"text":"夫,おっとは言,いった、「どうしてきょう彼,かれの所,ところへ行,いこうとするのか。きょうは、ついたちでもなく、安息日,あんそくにちでもない」。彼女,かのじょは言,いった、「よろしいのです」。","tok":[["夫","おっと"],["は"],["言った","いった"],["、"],["「"],["どう"],["して"],["きょう"],["彼","かれ"],["の"],["所","ところ"],["へ"],["行こう","いこう"],["と"],["する"],["の"],["か"],["。"],["きょう"],["は"],["、"],["つい"],["たち"],["で"],["も"],["なく"],["、"],["安息日","あんそくにち"],["で"],["も"],["ない"],["」"],["。"],["彼女","かのじょ"],["は"],["言った","いった"],["、"],["「"],["よろしい"],["の"],["です"],["」"],["。"]]},{"verse":24,"text":"そして彼女,かのじょはろばにくらを置,おいて、しもべに言,いった、「速,はやく駆,かけさせなさい。わたしが命,めいじる時,ときでなければ、歩調,ほちょうをゆるめてはなりません」。","tok":[["そして"],["彼女","かのじょ"],["は"],["ろば"],["に"],["くら"],["を"],["置いて","おいて"],["、"],["しもべ"],["に"],["言った","いった"],["、"],["「"],["速く","はやく"],["駆けさせ","かけさせ"],["なさい"],["。"],["わたし"],["が"],["命じる","めいじる"],["時","とき"],["で"],["なければ"],["、"],["歩調","ほちょう"],["を"],["ゆるめて"],["は"],["なりません"],["」"],["。"]]},{"verse":25,"text":"こうして彼女,かのじょは出発,しゅっぱつしてカルメル山,やまへ行,いき、神,かみの人,ひとの所,ところへ行,いった。神,かみの人,ひとは彼女,かのじょの近,ちかづいてくるのを見,みて、しもべゲハジに言,いった、「向,むこうから、あのシュネムの女,おんなが来,くる。","tok":[["こう"],["して"],["彼女","かのじょ"],["は"],["出発","しゅっぱつ"],["して"],["カルメル"],["山","やま"],["へ"],["行き","いき"],["、"],["神","かみ"],["の"],["人","ひと"],["の"],["所","ところ"],["へ"],["行った","いった"],["。"],["神","かみ"],["の"],["人","ひと"],["は"],["彼女","かのじょ"],["の"],["近づいて","ちかづいて"],["くる"],["の"],["を"],["見て","みて"],["、"],["しもべ"],["ゲハジ"],["に"],["言った","いった"],["、"],["「"],["向こう","むこう"],["から"],["、"],["あの"],["シュネム"],["の"],["女","おんな"],["が"],["来る","くる"],["。"]]},{"verse":26,"text":"すぐ走,はしって行,いって、彼女,かのじょを迎,むかえて言,いいなさい、『あなたは無事,ぶじですか。あなたの夫,おっとは無事,ぶじですか。あなたの子供,こどもは無事,ぶじですか』」。彼女,かのじょは答,こたえた、「無事,ぶじです」。","tok":[["すぐ"],["走って","はしって"],["行って","いって"],["、"],["彼女","かのじょ"],["を"],["迎","むかえ"],["て"],["言い","いい"],["なさい"],["、"],["『"],["あなた"],["は"],["無事","ぶじ"],["です"],["か"],["。"],["あなた"],["の"],["夫","おっと"],["は"],["無事","ぶじ"],["です"],["か"],["。"],["あなた"],["の"],["子供","こども"],["は"],["無事","ぶじ"],["です"],["か"],["』"],["」"],["。"],["彼女","かのじょ"],["は"],["答","こたえ"],["た"],["、"],["「"],["無事","ぶじ"],["です"],["」"],["。"]]},{"verse":27,"text":"ところが彼女,かのじょは山,やまにきて、神,かみの人,ひとの所,ところへくるとエリシャの足,あしにすがりついた。ゲハジが彼女,かのじょを追,おいのけようと近,ちかよった時,とき、神,かみの人,ひとは言,いった、「かまわずにおきなさい。彼女,かのじょは心,こころに苦,くるしみがあるのだから。主,しゅはそれを隠,かくして、まだわたしにお告,つげにならないのだ」。","tok":[["ところ"],["が"],["彼女","かのじょ"],["は"],["山","やま"],["に"],["きて"],["、"],["神","かみ"],["の"],["人","ひと"],["の"],["所","ところ"],["へ"],["くる"],["と"],["エリシャ"],["の"],["足","あし"],["に"],["すがりついた"],["。"],["ゲハジ"],["が"],["彼女","かのじょ"],["を"],["追いのけよう","おいのけよう"],["と"],["近よった","ちかよった"],["時","とき"],["、"],["神","かみ"],["の"],["人","ひと"],["は"],["言った","いった"],["、"],["「"],["かまわず"],["に"],["おき"],["なさい"],["。"],["彼女","かのじょ"],["は"],["心","こころ"],["に"],["苦しみ","くるしみ"],["が"],["ある"],["の"],["だ"],["から"],["。"],["主","しゅ"],["は"],["それ"],["を"],["隠して","かくして"],["、"],["まだ"],["わたし"],["に"],["お告","おつげ"],["に"],["ならない"],["の"],["だ"],["」"],["。"]]},{"verse":28,"text":"そこで彼女,かのじょは言,いった、「わたしがあなたに子,こを求,もとめましたか。わたしを欺,あざむかないでくださいと言,いったではありませんか」。","tok":[["そこ"],["で"],["彼女","かのじょ"],["は"],["言った","いった"],["、"],["「"],["わたし"],["が"],["あなた"],["に"],["子","こ"],["を"],["求めました","もとめました"],["か"],["。"],["わたし"],["を"],["欺かないで","あざむかないで"],["ください"],["と"],["言ったで","いったで"],["は"],["ありません"],["か"],["」"],["。"]]},{"verse":29,"text":"エリシャはゲハジに言,いった、「腰,こしをひきからげ、わたしのつえを手,てに持,もって行,いきなさい。だれに会,あっても、あいさつしてはならない。またあなたにあいさつする者,ものがあっても、それに答,こたえてはならない。わたしのつえを子供,こどもの顔,かおの上,うえに置,おきなさい」。","tok":[["エリシャ"],["は"],["ゲハジ"],["に"],["言った","いった"],["、"],["「"],["腰","こし"],["を"],["ひき"],["からげ"],["、"],["わたし"],["の"],["つえ"],["を"],["手","て"],["に"],["持って","もって"],["行き","いき"],["なさい"],["。"],["だれ"],["に"],["会って","あって"],["も"],["、"],["あいさつ"],["して"],["は"],["ならない"],["。"],["また"],["あなた"],["に"],["あいさつ"],["する"],["者","もの"],["が"],["あって"],["も"],["、"],["それ"],["に"],["答","こたえ"],["ては"],["ならない"],["。"],["わたし"],["の"],["つえ"],["を"],["子供","こども"],["の"],["顔","かお"],["の"],["上","うえ"],["に"],["置き","おき"],["なさい"],["」"],["。"]]},{"verse":30,"text":"子供,こどもの母,ははは言,いった、「主,しゅは生,いきておられます。あなたも生,いきておられます。わたしはあなたを離,はなれません」。そこでエリシャはついに立,たちあがって彼女,かのじょのあとについて行,いった。","tok":[["子供","こども"],["の"],["母","はは"],["は"],["言った","いった"],["、"],["「"],["主","しゅ"],["は"],["生きて","いきて"],["おられます"],["。"],["あなた"],["も"],["生きて","いきて"],["おられます"],["。"],["わたし"],["は"],["あなた"],["を"],["離れません","はなれません"],["」"],["。"],["そこ"],["で"],["エリシャ"],["は"],["ついに"],["立ちあがって","たちあがって"],["彼女","かのじょ"],["の"],["あと"],["について"],["行った","いった"],["。"]]},{"verse":31,"text":"ゲハジは彼,かれらの先,さきに行,いって、つえを子供,こどもの顔,かおの上,うえに置,おいたが、なんの声,こえもなく、生,いきかえったしるしもなかったので、帰,かえってきてエリシャに会,あい、彼,かれに告,つげて「子供,こどもはまだ目,めをさましません」と言,いった。","tok":[["ゲハジ"],["は"],["彼","かれ"],["ら"],["の"],["先","さき"],["に"],["行って","いって"],["、"],["つえ"],["を"],["子供","こども"],["の"],["顔","かお"],["の"],["上","うえ"],["に"],["置いた","おいた"],["が"],["、"],["なん"],["の"],["声","こえ"],["も"],["なく"],["、"],["生きかえった","いきかえった"],["しるし"],["も"],["なかった"],["ので"],["、"],["帰えって","かえって"],["きて"],["エリシャ"],["に"],["会い","あい"],["、"],["彼","かれ"],["に"],["告","つげ"],["て"],["「"],["子供","こども"],["は"],["まだ"],["目","め"],["を"],["さましません"],["」"],["と"],["言った","いった"],["。"]]},{"verse":32,"text":"エリシャが家,いえにはいって見,みると、子供,こどもは死,しんで、寝台,しんだいの上,うえに横,よこたわっていたので、","tok":[["エリシャ"],["が"],["家","いえ"],["に"],["はいって"],["見る","みる"],["と"],["、"],["子供","こども"],["は"],["死んで","しんで"],["、"],["寝台","しんだい"],["の"],["上","うえ"],["に"],["横たわって","よこたわって"],["いた"],["ので"],["、"]]},{"verse":33,"text":"彼,かれははいって戸,とを閉,とじ、彼,かれらふたりだけ内,うちにいて主,しゅに祈,いのった。","tok":[["彼","かれ"],["は"],["はい"],["って"],["戸","と"],["を"],["閉じ","とじ"],["、"],["彼","かれ"],["ら"],["ふたり"],["だけ"],["内","うち"],["に"],["いて"],["主に","しゅに"],["祈った","いのった"],["。"]]},{"verse":34,"text":"そしてエリシャが上,あがって子供,こどもの上,うえに伏,ふし、自分,じぶんの口,くちを子供,こどもの口,くちの上,うえに、自分,じぶんの目,めを子供,こどもの目,めの上,うえに、自分,じぶんの両手,りょうてを子供,こどもの両手,りょうての上,うえにあて、その身,みを子供,こどもの上,うえに伸,のばしたとき、子供,こどものからだは暖,あたたかになった。","tok":[["そして"],["エリシャ"],["が"],["上がって","あがって"],["子供","こども"],["の"],["上","うえ"],["に"],["伏し","ふし"],["、"],["自分","じぶん"],["の"],["口","くち"],["を"],["子供","こども"],["の"],["口","くち"],["の"],["上","うえ"],["に"],["、"],["自分","じぶん"],["の"],["目","め"],["を"],["子供","こども"],["の"],["目","め"],["の"],["上","うえ"],["に"],["、"],["自分","じぶん"],["の"],["両手","りょうて"],["を"],["子供","こども"],["の"],["両手","りょうて"],["の"],["上","うえ"],["に"],["あて"],["、"],["その"],["身","み"],["を"],["子供","こども"],["の"],["上","うえ"],["に"],["伸ばした","のばした"],["とき"],["、"],["子供","こども"],["の"],["からだ"],["は"],["暖か","あたたか"],["に"],["なった"],["。"]]},{"verse":35,"text":"こうしてエリシャは再,ふたたび起,おきあがって、家,いえの中,なかをあちらこちらと歩,あゆみ、また上,うえがって、その身,みを子供,こどもの上,うえに伸,のばすと、子供,こどもは七たびくしゃみをして目,めを開,ひらいた。","tok":[["こう"],["して"],["エリシャ"],["は"],["再び","ふたたび"],["起きあがって","おきあがって"],["、"],["家","いえ"],["の"],["中","なか"],["を"],["あちらこちら"],["と"],["歩","あゆみ"],["、"],["また"],["上がって","うえがって"],["、"],["その"],["身","み"],["を"],["子供","こども"],["の"],["上","うえ"],["に"],["伸ばす","のばす"],["と"],["、"],["子供","こども"],["は"],["七","なな"],["たび"],["くしゃみ"],["を"],["して"],["目","め"],["を"],["開らいた","ひらいた"],["。"]]},{"verse":36,"text":"エリシャはただちにゲハジを呼,よんで、「あのシュネムの女,おんなを呼,よべ」と言,いったので、彼女,かのじょを呼,よんだ。彼女,かのじょがはいってくるとエリシャは言,いった、「あなたの子供,こどもをつれて行,いきなさい」。","tok":[["エリシャ"],["は"],["ただちに"],["ゲハジ"],["を"],["呼んで","よんで"],["、"],["「"],["あの"],["シュネム"],["の"],["女","おんな"],["を"],["呼べ","よべ"],["」"],["と"],["言った","いった"],["ので"],["、"],["彼女","かのじょ"],["を"],["呼んだ","よんだ"],["。"],["彼女","かのじょ"],["が"],["はいって"],["くる"],["と"],["エリシャ"],["は"],["言った","いった"],["、"],["「"],["あなた"],["の"],["子供","こども"],["を"],["つれて"],["行き","いき"],["なさい"],["」"],["。"]]},{"verse":37,"text":"彼女,かのじょははいってきて、エリシャの足,あしもとに伏,ふし、地,ちに身,みをかがめた。そしてその子,こ供,ともを取,とりあげて出,でていった。","tok":[["彼女","かのじょ"],["は"],["はいって"],["きて"],["、"],["エリシャ"],["の"],["足もと","あしもと"],["に"],["伏し","ふし"],["、"],["地","ち"],["に"],["身","み"],["を"],["かがめた"],["。"],["そして"],["その"],["子供","ことも"],["を"],["取","とり"],["あげて"],["出て","でて"],["いった"],["。"]]},{"verse":38,"text":"エリシャはギルガルに帰,かえったが、その地,ちにききんがあった。預言者,よげんしゃのともがらが彼,かれの前,まえに座,ざしていたので、エリシャはそのしもべに言,いった、「大,おおきなかまをすえて、預言者,よげんしゃのともがらのために野菜,やさいの煮物,にものをつくりなさい」。","tok":[["エリシャ"],["は"],["ギルガル"],["に"],["帰えった","かえった"],["が"],["、"],["その"],["地","ち"],["に"],["ききん"],["が"],["あった"],["。"],["預言者","よげんしゃ"],["の"],["とも"],["がら"],["が"],["彼","かれ"],["の"],["前","まえ"],["に"],["座して","ざして"],["いた"],["ので"],["、"],["エリシャ"],["は"],["その"],["しもべ"],["に"],["言った","いった"],["、"],["「"],["大きな","おおきな"],["かま"],["を"],["すえて"],["、"],["預言者","よげんしゃ"],["の"],["とも"],["がら"],["の"],["ため"],["に"],["野菜","やさい"],["の"],["煮物","にもの"],["を"],["つくり"],["なさい"],["」"],["。"]]},{"verse":39,"text":"彼,かれらのうちのひとりが畑,はたけに出,でていって青物,あおものをつんだが、つる草,くさのあるのを見,みて、その野,のうりを一包,つつみつんできて、煮物,にもののかまの中,なかに切,きり込,こんだ。彼,かれらはそれが何,なにであるかを知,しらなかったからである。","tok":[["彼","かれ"],["ら"],["の"],["うち"],["の"],["ひとり"],["が"],["畑","はたけ"],["に"],["出て","でて"],["いって"],["青物","あおもの"],["を"],["つんだ"],["が"],["、"],["つる草","つるくさ"],["の"],["ある"],["の"],["を"],["見て","みて"],["、"],["その"],["野","の"],["うり"],["を"],["一包","つ"],["つみ"],["つんで"],["きて"],["、"],["煮物","にもの"],["の"],["かま"],["の"],["中","なか"],["に"],["切り込んだ","きりこんだ"],["。"],["彼","かれ"],["ら"],["は"],["それ"],["が"],["何","な"],["に"],["で"],["ある"],["か"],["を"],["知らなかった","しらなかった"],["から"],["で"],["ある"],["。"]]},{"verse":40,"text":"やがてこれを盛,もって人々,ひとびとに食,たべさせようとしたが、彼,かれらがその煮物,にものを食,たべようとした時,とき、叫,さけんで、「ああ神,かみの人,ひとよ、かまの中,なかに、たべると死,しぬものがはいっています」と言,いって、食,たべることができなかったので、","tok":[["やがて"],["これ"],["を"],["盛って","もって"],["人々","ひとびと"],["に"],["食べさせよう","たべさせよう"],["と"],["した"],["が"],["、"],["彼","かれ"],["ら"],["が"],["その"],["煮物","にもの"],["を"],["食べよう","たべよう"],["と"],["した"],["時","とき"],["、"],["叫けんで","さけんで"],["、"],["「"],["ああ"],["神","かみ"],["の"],["人","ひと"],["よ"],["、"],["かま"],["の"],["中","なか"],["に"],["、"],["たべる"],["と"],["死ぬ","しぬ"],["もの"],["が"],["はいって"],["います"],["」"],["と"],["言って","いって"],["、"],["食べる","たべる"],["こと"],["が"],["できなかった"],["ので"],["、"]]},{"verse":41,"text":"エリシャは「それでは粉,こなを持,もって来,きなさい」と言,いって、それをかまに投,なげ入,いれ、「盛,もって人々,ひとびとに食,たべさせなさい」と言,いった。かまの中,なかには、なんの毒物,どくぶつもなくなった。","tok":[["エリシャ"],["は"],["「"],["それ"],["で"],["は"],["粉","こな"],["を"],["持って","もって"],["来","き"],["なさい"],["」"],["と"],["言って","いって"],["、"],["それ"],["を"],["かま"],["に"],["投入れ","なげいれ"],["、"],["「"],["盛って","もって"],["人々","ひとびと"],["に"],["食べさせ","たべさせ"],["なさい"],["」"],["と"],["言った","いった"],["。"],["かま"],["の"],["中","なか"],["に"],["は"],["、"],["なん"],["の"],["毒物","どくぶつ"],["も"],["なくなった"],["。"]]},{"verse":42,"text":"その時,とき、バアル・シャリシャから人,ひとがきて、初穂,はつほのパンと、大麦,おおむぎのパン二十個,こと、新穀,しんこく一袋,ふくろとを神,かみの人,ひとのもとに持,もってきたので、エリシャは「人々,ひとびとに与,あたえて食,たべさせなさい」と言,いったが、","tok":[["その"],["時","とき"],["、"],["バアル"],["・"],["シャリシャ"],["から"],["人","ひと"],["が"],["きて"],["、"],["初穂","はつほ"],["の"],["パン"],["と"],["、"],["大麦","おおむぎ"],["の"],["パン"],["二十個","こ"],["と"],["、"],["新穀","しんこく"],["一","ひと"],["袋","ふくろ"],["を"],["神","かみ"],["の"],["人","ひと"],["の"],["もと"],["に"],["持って","もって"],["きた"],["ので"],["、"],["エリシャ"],["は"],["「"],["人々","ひとびと"],["に"],["与","あたえ"],["て"],["食べさせ","たべさせ"],["なさい"],["」"],["と"],["言った","いった"],["が"],["、"]]},{"verse":43,"text":"その召使,めしつかいは言,いった、「どうしてこれを百人,にんの前,まえに供,そなえるのですか」。しかし彼,かれは言,いった、「人々,ひとびとに与,あたえて食,たべさせなさい。主,しゅはこう言,いわれる、『彼,かれらは食,たべてなお余,あますであろう』」。","tok":[["その"],["召使","めしつかい"],["は"],["言った","いった"],["、"],["「"],["どう"],["して"],["これ"],["を"],["百人","にん"],["の"],["前","まえ"],["に"],["供える","そなえる"],["の"],["です"],["か"],["」"],["。"],["しかし"],["彼","かれ"],["は"],["言った","いった"],["、"],["「"],["人々","ひとびと"],["に"],["与","あたえ"],["て"],["食べさせ","たべさせ"],["なさい"],["。"],["主","しゅ"],["は"],["こう"],["言われる","いわれる"],["、"],["『"],["彼","かれ"],["ら"],["は"],["食べて","たべて"],["なお"],["余すで","あますで"],["あろう"],["』"],["」"],["。"]]},{"verse":44,"text":"そこで彼,かれはそれを彼,かれらの前,まえに供,そなえたので、彼,かれらは食,たべてなお余,あました。主,しゅの言葉,ことばのとおりであった。","tok":[["そこ"],["で"],["彼","かれ"],["は"],["それ"],["を"],["彼","かれ"],["ら"],["の"],["前","まえ"],["に"],["供えた","そなえた"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["食べて","たべて"],["なお"],["余した","あました"],["。"],["主","しゅ"],["の"],["言葉","ことば"],["の"],["とおり"],["で"],["あった"],["。"]]}]
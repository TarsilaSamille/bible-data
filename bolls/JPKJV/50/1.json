[{"verse":1,"text":"キリスト・イエスの僕,しもべたち、パウロとテモテから、ピリピにいる、キリスト・イエスにあるすべての聖徒,せいとたち、ならびに監督,かんとくたちと執事,しつじたちへ。","tok":[["キリスト"],["・"],["イエス"],["の"],["僕","し"],["も"],["べ"],["たち"],["、"],["パウロ"],["と"],["テモテ"],["から"],["、"],["ピリピ"],["に"],["いる"],["、"],["キリスト"],["・"],["イエス"],["に"],["ある"],["すべて"],["の"],["聖徒","せいと"],["たち"],["、"],["ならび"],["に"],["監督","かんとく"],["たち"],["と"],["執事","しつじ"],["たち"],["へ"],["。"]]},{"verse":2,"text":"わたしたちの父,ちちなる神,かみと主,しゅイエス・キリストから、恵,めぐみと平安,へいあんとが、あなたがたにあるように。","tok":[["わたしたち"],["の"],["父","ちち"],["なる"],["神","かみ"],["と"],["主","しゅ"],["イエス"],["・"],["キリスト"],["から"],["、"],["恵","めぐみ"],["と"],["平安","へいあん"],["と"],["が"],["、"],["あなた"],["がた"],["に"],["ある"],["よう"],["に"],["。"]]},{"verse":3,"text":"わたしはあなたがたを思,おもうたびごとに、わたしの神,かみに感謝,かんしゃし、","tok":[["わたし"],["は"],["あなた"],["がた"],["を"],["思う","おもう"],["たび"],["ごと"],["に"],["、"],["わたし"],["の"],["神","かみ"],["に"],["感謝","かんしゃ"],["し"],["、"]]},{"verse":4,"text":"あなたがた一同,いちどうのために祈,いのるとき、いつも喜,よろこびをもって祈,いのり、","tok":[["あなた"],["がた"],["一同","いちどう"],["の"],["ため"],["に"],["祈る","いのる"],["とき"],["、"],["いつも"],["喜こび","よろこび"],["を"],["もって"],["祈","いのり"],["、"]]},{"verse":5,"text":"あなたがたが最初,さいしょの日,ひから今日,こんにちに至,いたるまで、福音,ふくいんにあずかっていることを感謝,かんしゃしている。","tok":[["あなた"],["がた"],["が"],["最初","さいしょ"],["の"],["日","ひ"],["から"],["今日","こんにち"],["に"],["至る","いたる"],["まで"],["、"],["福音","ふくいん"],["に"],["あずかって"],["いる"],["こと"],["を"],["感謝","かんしゃ"],["して"],["いる"],["。"]]},{"verse":6,"text":"そして、あなたがたのうちに良,よいわざを始,はじめられたかたが、キリスト・イエスの日,ひまでにそれを完成,かんせいして下,くださるにちがいないと、確信,かくしんしている。","tok":[["そして"],["、"],["あなた"],["がた"],["の"],["うち"],["に"],["良い","よい"],["わざ"],["を"],["始められた","はじめられた"],["か"],["た"],["が"],["、"],["キリスト"],["・"],["イエス"],["の"],["日","ひ"],["まで"],["に"],["それ"],["を"],["完成","かんせい"],["して"],["下さる","くださる"],["に"],["ちがい"],["ない"],["と"],["、"],["確信","かくしん"],["して"],["いる"],["。"]]},{"verse":7,"text":"わたしが、あなたがた一同,いちどうのために、そう考,かんがえるのは当然,とうぜんである。それは、わたしが獄,ごくに捕,とらわれている時,ときにも、福音,ふくいんを弁明,べんめいし立証,りっしょうする時,ときにも、あなたがたをみな、共,ともに恵,めぐみにあずかる者,ものとして、わたしの心,こころに深,ふかく留,とめているからである。","tok":[["わたし"],["が"],["、"],["あなた"],["がた"],["一同","いちどう"],["の"],["ため"],["に"],["、"],["そう"],["考","かんがえ"],["る"],["の"],["は"],["当然","とうぜん"],["で"],["ある"],["。"],["それ"],["は"],["、"],["わたし"],["が"],["獄","ごく"],["に"],["捕らわれて","とらわれて"],["いる"],["時","とき"],["に"],["も"],["、"],["福音","ふくいん"],["を"],["弁明","べんめい"],["し"],["立証","りっしょう"],["する"],["時","とき"],["に"],["も"],["、"],["あなた"],["がた"],["を"],["みな"],["、"],["共","とも"],["に"],["恵","めぐみ"],["に"],["あずかる"],["者","もの"],["として"],["、"],["わたし"],["の"],["心","こころ"],["に"],["深く","ふかく"],["留","とめ"],["て"],["いる"],["から"],["で"],["ある"],["。"]]},{"verse":8,"text":"わたしがキリスト・イエスの熱愛,ねつあいをもって、どんなに深,ふかくあなたがた一同,いちどうを思,おもっていることか、それを証明,しょうめいして下,くださるかたは神,かみである。","tok":[["わたし"],["が"],["キリスト"],["・"],["イエス"],["の"],["熱愛","ねつあい"],["を"],["もって"],["、"],["どんな"],["に"],["深く","ふかく"],["あなた"],["がた"],["一同","いちどう"],["を"],["思って","おもって"],["いる"],["こと"],["か"],["、"],["それ"],["を"],["証明","しょうめい"],["して"],["下さる","くださる"],["かた"],["は"],["神","かみ"],["で"],["ある"],["。"]]},{"verse":9,"text":"わたしはこう祈,いのる。あなたがたの愛,あいが、深,ふかい知識,ちしきにおいて、するどい感覚,かんかくにおいて、いよいよ増,まし加,くわわり、","tok":[["わたし"],["は"],["こう"],["祈る","いのる"],["。"],["あなた"],["がた"],["の"],["愛","あい"],["が"],["、"],["深","ふ"],["かい"],["知識","ちしき"],["に"],["おいて"],["、"],["するどい"],["感覚","かんかく"],["に"],["おいて"],["、"],["いよいよ"],["増し","まし"],["加わわり","くわわり"],["、"]]},{"verse":10,"text":"それによって、あなたがたが、何,なにが重要,じゅうようであるかを判別,はんべつすることができ、キリストの日,ひに備,そなえて、純真,じゅんしんで責,せめられるところのないものとなり、","tok":[["それ"],["によって"],["、"],["あなた"],["が"],["た"],["が"],["、"],["何に","なに"],["が"],["重要","じゅうよう"],["で"],["ある"],["か"],["を"],["判別","はんべつ"],["する"],["こと"],["が"],["でき"],["、"],["キリスト"],["の"],["日","ひ"],["に"],["備","そなえ"],["て"],["、"],["純真","じゅんしん"],["で"],["責","せめ"],["られる"],["ところ"],["の"],["ない"],["もの"],["と"],["なり"],["、"]]},{"verse":11,"text":"イエス・キリストによる義,ぎの実,みに満,みたされて、神,かみの栄光,えいこうとほまれとをあらわすに至,いたるように。","tok":[["イエス"],["・"],["キリスト"],["に"],["よる"],["義","ぎ"],["の"],["実","み"],["に"],["満たされて","みたされて"],["、"],["神","かみ"],["の"],["栄光","えいこう"],["と"],["ほまれ"],["と"],["を"],["あらわす"],["に"],["至る","いたる"],["よう"],["に"],["。"]]},{"verse":12,"text":"さて、兄弟,きょうだいたちよ。わたしの身,みに起,おこった事,ことが、むしろ福音,ふくいんの前進,ぜんしんに役立,やくだつようになったことを、あなたがたに知,しってもらいたい。","tok":[["さて"],["、"],["兄弟","きょうだい"],["たち"],["よ"],["。"],["わたし"],["の"],["身","み"],["に"],["起こった","おこった"],["事","こと"],["が"],["、"],["むしろ"],["福音","ふくいん"],["の"],["前進","ぜんしん"],["に"],["役立つ","やくだつ"],["よう"],["に"],["なった"],["こと"],["を"],["、"],["あなた"],["がた"],["に"],["知って","しって"],["もらいたい"],["。"]]},{"verse":13,"text":"すなわち、わたしが獄,ごくに捕,とらわれているのはキリストのためであることが、兵営,へいえい全体,ぜんたいにもそのほかのすべての人々,ひとびとにも明,あきらかになり、","tok":[["すなわち"],["、"],["わたし"],["が"],["獄","ごく"],["に"],["捕らわれて","とらわれて"],["いる"],["の"],["は"],["キリスト"],["の"],["ため"],["で"],["ある"],["こと"],["が"],["、"],["兵営","へいえい"],["全体","ぜんたい"],["に"],["も"],["その"],["ほか"],["の"],["すべて"],["の"],["人々","ひとびと"],["に"],["も"],["明か","あきらか"],["に"],["なり"],["、"]]},{"verse":14,"text":"そして兄弟,きょうだいたちのうち多,おおくの者,ものは、わたしの入獄,にゅうごくによって主,しゅにある確信,かくしんを得,え、恐,おそれることなく、ますます勇敢,ゆうかんに、神,かみの言,ことばを語,かたるようになった。","tok":[["そして"],["兄弟","きょうだい"],["たち"],["の"],["うち"],["多く","おおく"],["の"],["者","もの"],["は"],["、"],["わたし"],["の"],["入獄","にゅうごく"],["によって"],["主に","しゅに"],["ある"],["確信","かくしん"],["を"],["得","え"],["、"],["恐れる","おそれる"],["こと"],["なく"],["、"],["ますます"],["勇敢","ゆうかん"],["に"],["、"],["神","かみ"],["の"],["言","ことば"],["を"],["語る","かたる"],["よう"],["に"],["なった"],["。"]]},{"verse":15,"text":"一方,いっぽうでは、ねたみや闘争,とうそう心,しんからキリストを宣,のべ伝,つたえる者,ものがおり、他方,たほうでは善意,ぜんいからそうする者,ものがいる。","tok":[["一方","いっぽう"],["で"],["は"],["、"],["ねたみ"],["や"],["闘争心","とうそうしん"],["から"],["キリスト"],["を"],["宣べ伝える","のべつたえる"],["者","もの"],["が"],["おり"],["、"],["他方","たほう"],["で"],["は"],["善意","ぜんい"],["から"],["そう"],["する"],["者","もの"],["が"],["いる"],["。"]]},{"verse":16,"text":"後者,こうしゃは、わたしが福音,ふくいんを弁明,べんめいするために立,たてられていることを知,しり、愛,あいの心,こころでキリストを伝,つたえ、","tok":[["後者","こうしゃ"],["は"],["、"],["わたし"],["が"],["福音","ふくいん"],["を"],["弁明","べんめい"],["する"],["ため"],["に"],["立られて","たてられて"],["いる"],["こと"],["を"],["知り","しり"],["、"],["愛","あい"],["の"],["心","こころ"],["で"],["キリスト"],["を"],["伝え","つたえ"],["、"]]},{"verse":17,"text":"前者,ぜんしゃは、わたしの入獄,にゅうごくの苦,くるしみに更,さらに患難,かんなんを加,くわえようと思,おもって、純真,じゅんしんな心,こころからではなく、党派心,とうはしんからそうしている。","tok":[["前者","ぜんしゃ"],["は"],["、"],["わたし"],["の"],["入獄","にゅうごく"],["の"],["苦しみ","くるしみ"],["に"],["更に","さらに"],["患難","かんなん"],["を"],["加えよう","くわえよう"],["と"],["思って","おもって"],["、"],["純真","じゅんしん"],["な"],["心","こころ"],["から"],["で"],["は"],["なく"],["、"],["党派心","とうはしん"],["から"],["そう"],["して"],["いる"],["。"]]},{"verse":18,"text":"すると、どうなのか。見,みえからであるにしても、真実,しんじつからであるにしても、要,ようするに、伝,つたえられているのはキリストなのだから、わたしはそれを喜,よろこんでいるし、また喜,よろこぶであろう。","tok":[["する"],["と"],["、"],["どう"],["な"],["の"],["か"],["。"],["見え","みえ"],["から"],["で"],["ある"],["に"],["して"],["も"],["、"],["真実","しんじつ"],["から"],["で"],["ある"],["に"],["して"],["も"],["、"],["要する","ようする"],["に"],["、"],["伝えられて","つたえられて"],["いる"],["の"],["は"],["キリスト"],["な"],["の"],["だ"],["から"],["、"],["わたし"],["は"],["それ"],["を"],["喜こんで","よろこんで"],["いる"],["し"],["、"],["また"],["喜こぶで","よろこぶで"],["あろう"],["。"]]},{"verse":19,"text":"なぜなら、あなたがたの祈,いのりと、イエス・キリストの霊,れいの助,たすけとによって、この事,ことがついには、わたしの救,すくいとなることを知,しっているからである。","tok":[["なぜ"],["なら"],["、"],["あなた"],["がた"],["の"],["祈","いのり"],["と"],["、"],["イエス"],["・"],["キリスト"],["の"],["霊","れい"],["の"],["助け","たすけ"],["と"],["によって"],["、"],["この"],["事","こと"],["が"],["ついに"],["は"],["、"],["わたし"],["の"],["救い","すくい"],["と"],["なる"],["こと"],["を"],["知って","しって"],["いる"],["から"],["で"],["ある"],["。"]]},{"verse":20,"text":"そこで、わたしが切実,せつじつな思,おもいで待,まち望,のぞむことは、わたしが、どんなことがあっても恥,はじることなく、かえって、いつものように今,いまも、大胆,だいたんに語,かたることによって、生,いきるにも死,しぬにも、わたしの身,みによってキリストがあがめられることである。","tok":[["そこ"],["で"],["、"],["わたし"],["が"],["切実","せつじつ"],["な"],["思い","おもい"],["で"],["待望む","まちのぞむ"],["こと"],["は"],["、"],["わたし"],["が"],["、"],["どんな"],["こと"],["が"],["あって"],["も"],["恥","はじ"],["る"],["こと"],["なく"],["、"],["かえって"],["、"],["いつも"],["の"],["よう"],["に"],["今","いま"],["も"],["、"],["大胆","だいたん"],["に"],["語る","かたる"],["こと"],["によって"],["、"],["生きる","いきる"],["に"],["も"],["死ぬ","しぬ"],["に"],["も"],["、"],["わたし"],["の"],["身","み"],["によって"],["キリスト"],["が"],["あがめられる"],["こと"],["で"],["ある"],["。"]]},{"verse":21,"text":"わたしにとっては、生,いきることはキリストであり、死,しぬことは益,えきである。","tok":[["わたし"],["にとって"],["は"],["、"],["生きる","いきる"],["こと"],["は"],["キリスト"],["で"],["あり"],["、"],["死ぬ","しぬ"],["こと"],["は"],["益","えき"],["で"],["ある"],["。"]]},{"verse":22,"text":"しかし、肉体,にくたいにおいて生,いきていることが、わたしにとっては実,みのり多,おおい働,はたらきになるのだとすれば、どちらを選,えらんだらよいか、わたしにはわからない。","tok":[["しかし"],["、"],["肉体","にくたい"],["に"],["おいて"],["生きて","いきて"],["いる"],["こと"],["が"],["、"],["わたし"],["にとって"],["は"],["実り","みのり"],["多い","おおい"],["働らき","はたらき"],["に"],["なる"],["の"],["だ"],["と"],["すれば"],["、"],["どちら"],["を"],["選らんだら","えらんだら"],["よい"],["か"],["、"],["わたし"],["に"],["は"],["わからない"],["。"]]},{"verse":23,"text":"わたしは、これら二つのものの間,あいだに板,いたばさみになっている。わたしの願,ねがいを言,いえば、この世,よを去,さってキリストと共,ともにいることであり、実,じつは、その方,ほうがはるかに望,のぞましい。","tok":[["わたし"],["は"],["、"],["これ"],["ら"],["二","ふた"],["つ"],["の"],["もの"],["の"],["間","あいだ"],["に"],["板ばさみ","いたばさみ"],["に"],["なって"],["いる"],["。"],["わたし"],["の"],["願い","ねがい"],["を"],["言えば","いえば"],["、"],["この世","このよ"],["を"],["去て","さって"],["キリスト"],["と"],["共","とも"],["に"],["いる"],["こと"],["で"],["あり"],["、"],["実","じつ"],["は"],["、"],["その"],["方","ほう"],["が"],["はるか"],["に"],["望ましい","のぞましい"],["。"]]},{"verse":24,"text":"しかし、肉体,にくたいにとどまっていることは、あなたがたのためには、さらに必要,ひつようである。","tok":[["しかし"],["、"],["肉体","にくたい"],["に"],["とどまって"],["いる"],["こと"],["は"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["は"],["、"],["さらに"],["必要","ひつよう"],["で"],["ある"],["。"]]},{"verse":25,"text":"こう確信,かくしんしているので、わたしは生,いきながらえて、あなたがた一同,いちどうのところにとどまり、あなたがたの信仰,しんこうを進,すすませ、その喜,よろこびを得,えさせようと思,おもう。","tok":[["こう"],["確信","かくしん"],["して"],["いる"],["ので"],["、"],["わたし"],["は"],["生きながらえて","いきながらえて"],["、"],["あなた"],["がた"],["一同","いちどう"],["の"],["ところ"],["に"],["とどまり"],["、"],["あなた"],["がた"],["の"],["信仰","しんこう"],["を"],["進ませ","すすませ"],["、"],["その"],["喜こび","よろこび"],["を"],["得させよう","えさせよう"],["と"],["思う","おもう"],["。"]]},{"verse":26,"text":"そうなれば、わたしが再,ふたたびあなたがたのところに行,いくので、あなたがたはわたしによってキリスト・イエスにある誇,ほこりを増,ますことになろう。","tok":[["そう"],["なれば"],["、"],["わたし"],["が"],["再び","ふたたび"],["あなた"],["がた"],["の"],["ところ"],["に"],["行く","いく"],["ので"],["、"],["あなた"],["がた"],["は"],["わたし"],["によって"],["キリスト"],["・"],["イエス"],["に"],["ある"],["誇","ほこり"],["を"],["増す","ます"],["こと"],["に"],["なろう"],["。"]]},{"verse":27,"text":"ただ、あなたがたはキリストの福音,ふくいんにふさわしく生活,せいかつしなさい。そして、わたしが行,いってあなたがたに会,あうにしても、離,はなれているにしても、あなたがたが一つの霊,れいによって堅,かたく立,たち、一つ心,こころになって福音,ふくいんの信仰,しんこうのために力,ちからを合,あわせて戦,たたかい、","tok":[["ただ"],["、"],["あなた"],["がた"],["は"],["キリスト"],["の"],["福音","ふくいん"],["に"],["ふさわしく"],["生活","せいかつ"],["し"],["なさい"],["。"],["そして"],["、"],["わたし"],["が"],["行って","いって"],["あなた"],["がた"],["に"],["会う","あう"],["に"],["して"],["も"],["、"],["離れて","はなれて"],["いる"],["に"],["して"],["も"],["、"],["あなた"],["がた"],["が"],["一","ひと"],["つ"],["の"],["霊","れい"],["によって"],["堅く","かたく"],["立ち","たち"],["、"],["一","ひと"],["つ"],["心","こころ"],["に"],["なって"],["福音","ふくいん"],["の"],["信仰","しんこう"],["の"],["ため"],["に"],["力","ちから"],["を"],["合","あわせ"],["て"],["戦い","たたかい"],["、"]]},{"verse":28,"text":"かつ、何事,なにごとについても、敵対,てきたいする者,ものどもにろうばいさせられないでいる様子,ようすを、聞,きかせてほしい。このことは、彼,かれらには滅,ほろびのしるし、あなたがたには救,すくいのしるしであって、それは神,かみから来,くるのである。","tok":[["かつ"],["、"],["何事","なにごと"],["について"],["も"],["、"],["敵対","てきたい"],["する"],["者","もの"],["ども"],["に"],["ろうばい"],["させられないで"],["いる"],["様子","ようす"],["を"],["、"],["聞かせて","きかせて"],["ほしい"],["。"],["この"],["こと"],["は"],["、"],["彼","かれ"],["ら"],["に"],["は"],["滅び","ほろび"],["の"],["しるし"],["、"],["あなた"],["がた"],["に"],["は"],["救い","すくい"],["の"],["しるし"],["で"],["あって"],["、"],["それ"],["は"],["神","かみ"],["から"],["来る","くる"],["ので"],["ある"],["。"]]},{"verse":29,"text":"あなたがたはキリストのために、ただ彼,かれを信,しんじることだけではなく、彼,かれのために苦,くるしむことをも賜,たまわっている。","tok":[["あなた"],["がた"],["は"],["キリスト"],["の"],["ため"],["に"],["、"],["ただ"],["彼","かれ"],["を"],["信じる","しんじる"],["こと"],["だけ"],["で"],["は"],["なく"],["、"],["彼","かれ"],["の"],["ため"],["に"],["苦しむ","くるしむ"],["こと"],["を"],["も"],["賜わって","たまわって"],["いる"],["。"]]},{"verse":30,"text":"あなたがたは、さきにわたしについて見,み、今,いままたわたしについて聞,きいているのと同,おなじ苦闘,くとうを、続,つづけているのである。","tok":[["あなた"],["がた"],["は"],["、"],["さき"],["に"],["わたし"],["について"],["見","み"],["、"],["今","いま"],["また"],["わたし"],["について"],["聞いて","きいて"],["いる"],["の"],["と"],["同じ","おなじ"],["苦闘","くとう"],["を"],["、"],["続けて","つづけて"],["いる"],["ので"],["ある"],["。"]]}]
[{"verse":1,"text":"最後,さいごに、わたしの兄弟,きょうだいたちよ。主,しゅにあって喜,よろこびなさい。さきに書,かいたのと同,おなじことをここで繰,くり返,かえすが、それは、わたしには煩,わずらわしいことではなく、あなたがたには安全,あんぜんなことになる。","tok":[["最後","さいご"],["に"],["、"],["わたし"],["の"],["兄弟","きょうだい"],["たち"],["よ"],["。"],["主に","しゅに"],["あって"],["喜こび","よろこび"],["なさい"],["。"],["さき"],["に"],["書いた","かいた"],["の"],["と"],["同じ","おなじ"],["こと"],["を"],["ここ"],["で"],["繰り返えす","くりかえす"],["が"],["、"],["それ"],["は"],["、"],["わたし"],["に"],["は"],["煩わしい","わずらわしい"],["こと"],["で"],["は"],["なく"],["、"],["あなた"],["がた"],["に"],["は"],["安全","あんぜん"],["な"],["こと"],["に"],["なる"],["。"]]},{"verse":2,"text":"あの犬,いぬどもを警戒,けいかいしなさい。悪,わるい働,はたらき人,びとたちを警戒,けいかいしなさい。肉,にくに割礼,かつれいの傷,きずをつけている人,ひとたちを警戒,けいかいしなさい。","tok":[["あの"],["犬","いぬ"],["ども"],["を"],["警戒","けいかい"],["し"],["なさい"],["。"],["悪い","わるい"],["働らき人","はたらきびとたち"],["を"],["警戒","けいかい"],["し"],["なさい"],["。"],["肉","にく"],["に"],["割礼","かつれい"],["の"],["傷","きず"],["を"],["つけて"],["いる"],["人","ひと"],["たち"],["を"],["警戒","けいかい"],["し"],["なさい"],["。"]]},{"verse":3,"text":"神,かみの霊,れいによって礼拝,れいはいをし、キリスト・イエスを誇,ほこりとし、肉,にくを頼,たのみとしないわたしたちこそ、割礼,かつれいの者,ものである。","tok":[["神","かみ"],["の"],["霊","れい"],["によって"],["礼拝","れいはい"],["を"],["し"],["、"],["キリスト"],["・"],["イエス"],["を"],["誇","ほこり"],["と"],["し"],["、"],["肉","にく"],["を"],["頼み","たのみ"],["と"],["しない"],["わたしたち"],["こそ"],["、"],["割礼","かつれい"],["の"],["者","もの"],["で"],["ある"],["。"]]},{"verse":4,"text":"もとより、肉,にくの頼,たのみなら、わたしにも無,なくはない。もし、だれかほかの人,ひとが肉,にくを頼,たのみとしていると言,いうなら、わたしはそれをもっと頼,たのみとしている。","tok":[["もとより"],["、"],["肉","にく"],["の"],["頼み","たのみ"],["なら"],["、"],["わたし"],["に"],["も"],["無く","なく"],["は"],["ない"],["。"],["もし"],["、"],["だれ"],["か"],["ほか"],["の"],["人","ひと"],["が"],["肉","にく"],["を"],["頼み","たのみ"],["として"],["いる"],["と"],["言","いうな"],["ら"],["、"],["わたし"],["は"],["それ"],["を"],["もっと"],["頼み","たのみ"],["として"],["いる"],["。"]]},{"verse":5,"text":"わたしは八日目,かめに割礼,かつれいを受,うけた者,もの、イスラエルの民族,みんぞくに属,ぞくする者,もの、ベニヤミン族,ぞくの出身,しゅっしん、ヘブル人,びとの中,なかのヘブル人,びと、律法,りっぽうの上,うえではパリサイ人,びと、","tok":[["わたし"],["は"],["八日目","かめ"],["に"],["割礼","かつれい"],["を"],["受た","うけた"],["者","もの"],["、"],["イスラエル"],["の"],["民族","みんぞく"],["に"],["属する","ぞくする"],["者","もの"],["、"],["ベニヤミン"],["族","ぞく"],["の"],["出身","しゅっしん"],["、"],["ヘブル人","へぶるびと"],["の"],["中","なか"],["の"],["ヘブル人","へぶるび"],["と"],["、"],["律法","りっぽう"],["の"],["上","うえ"],["で"],["は"],["パリサイ"],["人","び"],["と"],["、"]]},{"verse":6,"text":"熱心,ねっしんの点,てんでは教会,きょうかいの迫害者,はくがいしゃ、律法,りっぽうの義,ぎについては落,おち度,どのない者,ものである。","tok":[["熱心","ねっしん"],["の"],["点","てん"],["で"],["は"],["教会","きょうかい"],["の"],["迫害者","はくがいしゃ"],["、"],["律法","りっぽう"],["の"],["義","ぎ"],["について"],["は"],["落度","おちど"],["の"],["ない"],["者","もの"],["で"],["ある"],["。"]]},{"verse":7,"text":"しかし、わたしにとって益,えきであったこれらのものを、キリストのゆえに損,そんと思,おもうようになった。","tok":[["しかし"],["、"],["わたし"],["にとって"],["益","えき"],["で"],["あった"],["これ"],["ら"],["の"],["もの"],["を"],["、"],["キリスト"],["の"],["ゆえ"],["に"],["損","そん"],["と"],["思う","おもう"],["よう"],["に"],["なった"],["。"]]},{"verse":8,"text":"わたしは、更,さらに進,すすんで、わたしの主,しゅキリスト・イエスを知,しる知識,ちしきの絶大,ぜつだいな価値,かちのゆえに、いっさいのものを損,そんと思,おもっている。キリストのゆえに、わたしはすべてを失,うしなったが、それらのものを、ふん土,どのように思,おもっている。それは、わたしがキリストを得,えるためであり、","tok":[["わたし"],["は"],["、"],["更に","さらに"],["進んで","すすんで"],["、"],["わたし"],["の"],["主","しゅ"],["キリスト"],["・"],["イエス"],["を"],["知る","しる"],["知識","ちしき"],["の"],["絶大","ぜつだい"],["な"],["価値","かち"],["の"],["ゆえ"],["に"],["、"],["いっさい"],["の"],["もの"],["を"],["損","そん"],["と"],["思って","おもって"],["いる"],["。"],["キリスト"],["の"],["ゆえ"],["に"],["、"],["わたし"],["は"],["すべて"],["を"],["失なった","うしなった"],["が"],["、"],["それ"],["ら"],["の"],["もの"],["を"],["、"],["ふん"],["土","ど"],["の"],["よう"],["に"],["思って","おもって"],["いる"],["。"],["それ"],["は"],["、"],["わたし"],["が"],["キリスト"],["を"],["得る","える"],["ため"],["で"],["あり"],["、"]]},{"verse":9,"text":"律法,りっぽうによる自分,じぶんの義,ぎではなく、キリストを信,しんじる信仰,しんこうによる義,ぎ、すなわち、信仰,しんこうに基,もとづく神,かみからの義,ぎを受,うけて、キリストのうちに自分,じぶんを見,みいだすようになるためである。","tok":[["律法","りっぽう"],["に"],["よる"],["自分","じぶん"],["の"],["義","ぎ"],["で"],["は"],["なく"],["、"],["キリスト"],["を"],["信じる","しんじる"],["信仰","しんこう"],["に"],["よる"],["義","ぎ"],["、"],["すなわち"],["、"],["信仰","しんこう"],["に"],["基づく","もとづく"],["神","かみ"],["から"],["の"],["義","ぎ"],["を"],["受て","うけて"],["、"],["キリスト"],["の"],["うち"],["に"],["自分","じぶん"],["を"],["見いだす","みいだす"],["よう"],["に"],["なる"],["ため"],["で"],["ある"],["。"]]},{"verse":10,"text":"すなわち、キリストとその復活,ふっかつの力,ちからとを知,しり、その苦難,くなんにあずかって、その死,しのさまとひとしくなり、","tok":[["すなわち"],["、"],["キリスト"],["と"],["その"],["復活","ふっかつ"],["の"],["力","ちから"],["と"],["を"],["知り","しり"],["、"],["その"],["苦難","くなん"],["に"],["あずかって"],["、"],["その"],["死","し"],["の"],["さま"],["と"],["ひとしく"],["なり"],["、"]]},{"verse":11,"text":"なんとかして死人,しにんのうちからの復活,ふっかつに達,たっしたいのである。","tok":[["なん"],["と"],["か"],["して"],["死人","しにん"],["の"],["うち"],["から"],["の"],["復活","ふっかつ"],["に"],["達したい","たっしたい"],["ので"],["ある"],["。"]]},{"verse":12,"text":"わたしがすでにそれを得,えたとか、すでに完全,かんぜんな者,ものになっているとか言,いうのではなく、ただ捕,とらえようとして追,おい求,もとめているのである。そうするのは、キリスト・イエスによって捕,とらえられているからである。","tok":[["わたし"],["が"],["すでに"],["それ"],["を"],["得た","えた"],["と"],["か"],["、"],["すでに"],["完全","かんぜん"],["な"],["者","もの"],["に"],["なって"],["いる"],["と"],["か"],["言う","いう"],["ので"],["は"],["なく"],["、"],["ただ"],["捕らえよう","とらえよう"],["として"],["追い求めて","おいもとめて"],["いる"],["ので"],["ある"],["。"],["そう"],["する"],["の"],["は"],["、"],["キリスト"],["・"],["イエス"],["によって"],["捕らえられて","とらえられて"],["いる"],["から"],["で"],["ある"],["。"]]},{"verse":13,"text":"兄弟,きょうだいたちよ。わたしはすでに捕,とらえたとは思,おもっていない。ただこの一事,いちじを努,つとめている。すなわち、後,うしろのものを忘,わすれ、前,まえのものに向,むかってからだを伸,のばしつつ、","tok":[["兄弟","きょうだい"],["たち"],["よ"],["。"],["わたし"],["は"],["すでに"],["捕らえた","とらえた"],["と"],["は"],["思って","おもって"],["いない"],["。"],["ただ"],["この"],["一事","いちじ"],["を"],["努めて","つとめて"],["いる"],["。"],["すなわち"],["、"],["後ろ","うしろ"],["の"],["もの"],["を"],["忘","わすれ"],["、"],["前","まえ"],["の"],["もの"],["に"],["向かって","むかって"],["からだ"],["を"],["伸ばし","のばし"],["つつ"],["、"]]},{"verse":14,"text":"目標,もくひょうを目,めざして走,はしり、キリスト・イエスにおいて上,うえに召,めして下,くださる神,かみの賞与,しょうよを得,えようと努,つとめているのである。","tok":[["目標","もくひょう"],["を"],["目ざして","めざして"],["走り","はしり"],["、"],["キリスト"],["・"],["イエス"],["に"],["おいて"],["上","うえ"],["に"],["召","めし"],["て"],["下さる","くださる"],["神","かみ"],["の"],["賞与","しょうよ"],["を"],["得よう","えよう"],["と"],["努めて","つとめて"],["いる"],["ので"],["ある"],["。"]]},{"verse":15,"text":"だから、わたしたちの中,なかで全,まったき人,ひとたちは、そのように考,かんがえるべきである。しかし、あなたがたが違,ちがった考,かんがえを持,もっているなら、神,かみはそのことも示,しめして下,くださるであろう。","tok":[["だ"],["から"],["、"],["わたしたち"],["の"],["中","なか"],["で"],["全","ま"],["っ"],["たき人","たきひと"],["たち"],["は"],["、"],["その"],["よう"],["に"],["考","かんがえ"],["るべきで"],["ある"],["。"],["しかし"],["、"],["あなた"],["がた"],["が"],["違った","ちがった"],["考","かんがえ"],["を"],["持って","もって"],["いるなら"],["、"],["神","かみ"],["は"],["その"],["こと"],["も"],["示めして","しめして"],["下さるで","くださるで"],["あろう"],["。"]]},{"verse":16,"text":"ただ、わたしたちは、達,たっし得,えたところに従,したがって進,すすむべきである。","tok":[["ただ"],["、"],["わたしたち"],["は"],["、"],["達し","たっし"],["得た","えた"],["ところ"],["に"],["従って","したがって"],["進","すすむ"],["べきで"],["ある"],["。"]]},{"verse":17,"text":"兄弟,きょうだいたちよ。どうか、わたしにならう者,ものとなってほしい。また、あなたがたの模範,もはんにされているわたしたちにならって歩,あるく人,ひとたちに、目,めをとめなさい。","tok":[["兄弟","きょうだい"],["たち"],["よ"],["。"],["どう"],["か"],["、"],["わたし"],["に"],["ならう"],["者","もの"],["と"],["なって"],["ほしい"],["。"],["また"],["、"],["あなた"],["がた"],["の"],["模範","もはん"],["に"],["されて"],["いる"],["わたしたち"],["に"],["ならって"],["歩く","あるく"],["人","ひと"],["たち"],["に"],["、"],["目","め"],["を"],["とめ"],["なさい"],["。"]]},{"verse":18,"text":"わたしがそう言,いうのは、キリストの十字架,じゅうじかに敵対,てきたいして歩,あるいている者,ものが多,おおいからである。わたしは、彼,かれらのことをしばしばあなたがたに話,はなしたが、今,いままた涙,なみだを流,ながして語,かたる。","tok":[["わたし"],["が"],["そう"],["言う","いう"],["の"],["は"],["、"],["キリスト"],["の"],["十字架","じゅうじか"],["に"],["敵対","てきたい"],["して"],["歩いて","あるいて"],["いる"],["者","もの"],["が"],["多い","おおい"],["から"],["で"],["ある"],["。"],["わたし"],["は"],["、"],["彼","かれ"],["ら"],["の"],["こと"],["を"],["しばしば"],["あなた"],["がた"],["に"],["話","はなし"],["た"],["が"],["、"],["今","いま"],["また"],["涙","なみだ"],["を"],["流して","ながして"],["語る","かたる"],["。"]]},{"verse":19,"text":"彼,かれらの最後,さいごは滅,ほろびである。彼,かれらの神,かみはその腹,はら、彼,かれらの栄光,えいこうはその恥,はじ、彼,かれらの思,おもいは地上,ちじょうのことである。","tok":[["彼","かれ"],["ら"],["の"],["最後","さいご"],["は"],["滅び","ほろび"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["の"],["神","かみ"],["は"],["その"],["腹","はら"],["、"],["彼","かれ"],["ら"],["の"],["栄光","えいこう"],["は"],["その"],["恥","はじ"],["、"],["彼","かれ"],["ら"],["の"],["思い","おもい"],["は"],["地上","ちじょう"],["の"],["こと"],["で"],["ある"],["。"]]},{"verse":20,"text":"しかし、わたしたちの国籍,こくせきは天,てんにある。そこから、救主,すくいぬし、主,しゅイエス・キリストのこられるのを、わたしたちは待,まち望,のぞんでいる。","tok":[["しかし"],["、"],["わたしたち"],["の"],["国籍","こくせき"],["は"],["天","てん"],["に"],["ある"],["。"],["そこ"],["から"],["、"],["救主","す"],["くいぬ"],["し"],["、"],["主","しゅ"],["イエス"],["・"],["キリスト"],["の"],["こられる"],["の"],["を"],["、"],["わたしたち"],["は"],["待望んで","まちのぞんで"],["いる"],["。"]]},{"verse":21,"text":"彼,かれは、万物,ばんぶつをご自身,じしんに従,したがわせうる力,ちからの働,はたらきによって、わたしたちの卑,いやしいからだを、ご自身,じしんの栄光,えいこうのからだと同,おなじかたちに変,かえて下,くださるであろう。","tok":[["彼","かれ"],["は"],["、"],["万物","ばんぶつ"],["を"],["ご自身","ごじしん"],["に"],["従わせ","したがわせ"],["うる"],["力","ちから"],["の"],["働らき","はたらき"],["によって"],["、"],["わたしたち"],["の"],["卑しい","いやしい"],["からだ"],["を"],["、"],["ご自身","ごじしん"],["の"],["栄光","えいこう"],["の"],["からだ"],["と"],["同じ","おなじ"],["かたち"],["に"],["変えて","かえて"],["下さるで","くださるで"],["あろう"],["。"]]}]
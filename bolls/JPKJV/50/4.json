[{"verse":1,"text":"だから、わたしの愛,あいし慕,したっている兄弟,きょうだいたちよ。わたしの喜,よろこびであり冠,かんむりである愛,あいする者,ものたちよ。このように、主,しゅにあって堅,かたく立,たちなさい。","tok":[["だ"],["から"],["、"],["わたし"],["の"],["愛し","あいし"],["慕って","したって"],["いる"],["兄弟","きょうだい"],["たち"],["よ"],["。"],["わたし"],["の"],["喜こびで","よろこびで"],["あり"],["冠","かん"],["むり"],["で"],["ある"],["愛する","あいする"],["者","もの"],["たち"],["よ"],["。"],["この"],["よう"],["に"],["、"],["主に","しゅに"],["あって"],["堅く","かたく"],["立","たち"],["なさい"],["。"]]},{"verse":2,"text":"わたしはユウオデヤに勧,すすめ、またスントケに勧,すすめる。どうか、主,しゅにあって一つ思,おもいになってほしい。","tok":[["わたし"],["は"],["ユウオデヤ"],["に"],["勧め","すすめ"],["、"],["また"],["スントケ"],["に"],["勧める","すすめる"],["。"],["どう"],["か"],["、"],["主に","しゅに"],["あって"],["一","ひと"],["つ"],["思い","おもい"],["に"],["なって"],["ほしい"],["。"]]},{"verse":3,"text":"ついては、真実,しんじつな協力者,きょうりょくしゃよ。あなたにお願,ねがいする。このふたりの女,おんなを助,たすけてあげなさい。彼,かれらは、「いのちの書,しょ」に名,なを書,かきとめられているクレメンスや、その他,たの同労者,どうろうしゃたちと協力,きょうりょくして、福音,ふくいんのためにわたしと共,ともに戦,たたかってくれた女,おんなたちである。","tok":[["ついて"],["は"],["、"],["真実","しんじつ"],["な"],["協力者","きょうりょくしゃ"],["よ"],["。"],["あなた"],["に"],["お願い","おねがい"],["する"],["。"],["この"],["ふたり"],["の"],["女","おんな"],["を"],["助けて","たすけて"],["あげ"],["なさい"],["。"],["彼","かれ"],["ら"],["は"],["、"],["「"],["いのち"],["の"],["書","しょ"],["」"],["に"],["名","な"],["を"],["書きとめられて","かきとめられて"],["いる"],["クレメンス"],["や"],["、"],["その"],["他","た"],["の"],["同労者","どうろうしゃ"],["たち"],["と"],["協力","きょうりょく"],["して"],["、"],["福音","ふくいん"],["の"],["ため"],["に"],["わたし"],["と"],["共","とも"],["に"],["戦って","たたかって"],["くれた"],["女","おんな"],["たち"],["で"],["ある"],["。"]]},{"verse":4,"text":"あなたがたは、主,しゅにあっていつも喜,よろこびなさい。繰,くり返,かえして言,いうが、喜,よろこびなさい。","tok":[["あなた"],["がた"],["は"],["、"],["主に","しゅに"],["あって"],["いつも"],["喜こび","よろこび"],["なさい"],["。"],["繰り","くり"],["返","かえし"],["て"],["言う","いう"],["が"],["、"],["喜こび","よろこび"],["なさい"],["。"]]},{"verse":5,"text":"あなたがたの寛容,かんようを、みんなの人,ひとに示,しめしなさい。主,しゅは近,ちかい。","tok":[["あなた"],["がた"],["の"],["寛容","かんよう"],["を"],["、"],["みんな"],["の"],["人","ひと"],["に"],["示めし","しめし"],["なさい"],["。"],["主","しゅ"],["は"],["近い","ちかい"],["。"]]},{"verse":6,"text":"何事,なにごとも思,おもい煩,わずらってはならない。ただ、事,ことごとに、感謝,かんしゃをもって祈,いのりと願,ねがいとをささげ、あなたがたの求,もとめるところを神,かみに申,もうし上,あげるがよい。","tok":[["何事","なにごと"],["も"],["思い煩って","おもいわずらって"],["は"],["ならない"],["。"],["ただ"],["、"],["事","こと"],["ごと"],["に"],["、"],["感謝","かんしゃ"],["を"],["もって"],["祈","いのり"],["と"],["願い","ねがい"],["と"],["を"],["ささげ"],["、"],["あなた"],["がた"],["の"],["求める","もとめる"],["ところ"],["を"],["神","かみ"],["に"],["申し上げる","もうしあげる"],["が"],["よい"],["。"]]},{"verse":7,"text":"そうすれば、人知,じんちではとうてい測,はかり知,しることのできない神,かみの平安,へいあんが、あなたがたの心,こころと思,おもいとを、キリスト・イエスにあって守,まもるであろう。","tok":[["そう"],["すれば"],["、"],["人知","じんち"],["で"],["は"],["とうてい"],["測り知る","はかりしる"],["こと"],["の"],["できない"],["神","かみ"],["の"],["平安","へいあん"],["が"],["、"],["あなた"],["がた"],["の"],["心","こころ"],["と"],["思い","おもい"],["と"],["を"],["、"],["キリスト"],["・"],["イエス"],["に"],["あって"],["守","まもる"],["で"],["あろう"],["。"]]},{"verse":8,"text":"最後,さいごに、兄弟,きょうだいたちよ。すべて真実,しんじつなこと、すべて尊,たっとぶべきこと、すべて正,ただしいこと、すべて純真,じゅんしんなこと、すべて愛,あいすべきこと、すべてほまれあること、また徳,とくといわれるもの、称賛,しょうさんに値,あたいするものがあれば、それらのものを心,こころにとめなさい。","tok":[["最後","さいご"],["に"],["、"],["兄弟","きょうだい"],["たち"],["よ"],["。"],["すべて"],["真実","しんじつ"],["な"],["こと"],["、"],["すべて"],["尊","た"],["っと"],["ぶ"],["べき"],["こと"],["、"],["すべて"],["正い","ただしい"],["こと"],["、"],["すべて"],["純真","じゅんしん"],["な"],["こと"],["、"],["すべて"],["愛すべき","あいすべき"],["こと"],["、"],["すべて"],["ほまれ"],["ある"],["こと"],["、"],["また"],["徳","とく"],["と"],["いわれる"],["もの"],["、"],["称賛","しょうさん"],["に"],["値","あたい"],["する"],["もの"],["が"],["あれば"],["、"],["それ"],["ら"],["の"],["もの"],["を"],["心","こころ"],["に"],["とめ"],["なさい"],["。"]]},{"verse":9,"text":"あなたがたが、わたしから学,まなんだこと、受,うけたこと、聞,きいたこと、見,みたことは、これを実行,じっこうしなさい。そうすれば、平和,へいわの神,かみが、あなたがたと共,ともにいますであろう。","tok":[["あなた"],["が"],["た"],["が"],["、"],["わたし"],["から"],["学んだ","まなんだ"],["こと"],["、"],["受た","うけた"],["こと"],["、"],["聞いた","きいた"],["こと"],["、"],["見た","みた"],["こと"],["は"],["、"],["これ"],["を"],["実行","じっこう"],["し"],["なさい"],["。"],["そう"],["すれば"],["、"],["平和","へいわ"],["の"],["神","かみ"],["が"],["、"],["あなた"],["がた"],["と"],["共","とも"],["に"],["いますで"],["あろう"],["。"]]},{"verse":10,"text":"さて、わたしが主,しゅにあって大,おおいに喜,よろこんでいるのは、わたしを思,おもう心,こころが、あなたがたに今,いままたついに芽,めばえてきたことである。実,じつは、あなたがたは、わたしのことを心,こころにかけてくれてはいたが、よい機会,きかいがなかったのである。","tok":[["さて"],["、"],["わたし"],["が"],["主に","しゅに"],["あって"],["大いに","おおいに"],["喜こんで","よろこんで"],["いる"],["の"],["は"],["、"],["わたし"],["を"],["思う","おもう"],["心","こころ"],["が"],["、"],["あなた"],["がた"],["に"],["今","いま"],["また"],["ついに"],["芽ばえて","めばえて"],["きた"],["こと"],["で"],["ある"],["。"],["実","じつ"],["は"],["、"],["あなた"],["がた"],["は"],["、"],["わたし"],["の"],["こと"],["を"],["心","こころ"],["に"],["かけて"],["くれて"],["は"],["いた"],["が"],["、"],["よい"],["機会","きかい"],["が"],["なかった"],["ので"],["ある"],["。"]]},{"verse":11,"text":"わたしは乏,とぼしいから、こう言,いうのではない。わたしは、どんな境遇,きょうぐうにあっても、足,たることを学,まなんだ。","tok":[["わたし"],["は"],["乏い","とぼしい"],["から"],["、"],["こう"],["言う","いう"],["ので"],["は"],["ない"],["。"],["わたし"],["は"],["、"],["どんな"],["境遇","きょうぐう"],["に"],["あって"],["も"],["、"],["足る","たる"],["こと"],["を"],["学んだ","まなんだ"],["。"]]},{"verse":12,"text":"わたしは貧,ひんに処,しょする道,みちを知,しっており、富,とみにおる道,みちも知,しっている。わたしは、飽,あくことにも飢,うえることにも、富,とむことにも乏,とぼしいことにも、ありとあらゆる境遇,きょうぐうに処,しょする秘,ひけつを心得,こころえている。","tok":[["わたし"],["は"],["貧","ひん"],["に"],["処する","しょする"],["道","みち"],["を"],["知って","しって"],["おり"],["、"],["富","とみ"],["に"],["おる"],["道","みち"],["も"],["知って","しって"],["いる"],["。"],["わたし"],["は"],["、"],["飽く","あく"],["こと"],["に"],["も"],["飢","うえ"],["る"],["こと"],["に"],["も"],["、"],["富む","とむ"],["こと"],["に"],["も"],["乏い","とぼしい"],["こと"],["に"],["も"],["、"],["あり"],["と"],["あらゆる"],["境遇","きょうぐう"],["に"],["処する","しょする"],["秘けつ","ひけつ"],["を"],["心得て","こころえて"],["いる"],["。"]]},{"verse":13,"text":"わたしを強,つよくして下,くださるかたによって、何事,なにごとでもすることができる。","tok":[["わたし"],["を"],["強く","つよく"],["して"],["下さる","くださる"],["かた"],["によって"],["、"],["何事","なにごと"],["で"],["も"],["する"],["こと"],["が"],["できる"],["。"]]},{"verse":14,"text":"しかし、あなたがたは、よくもわたしと患難,かんなんを共,ともにしてくれた。","tok":[["しかし"],["、"],["あなた"],["がた"],["は"],["、"],["よく"],["も"],["わたし"],["と"],["患難","かんなん"],["を"],["共","とも"],["に"],["して"],["くれた"],["。"]]},{"verse":15,"text":"ピリピの人,ひとたちよ。あなたがたも知,しっているとおり、わたしが福音,ふくいんを宣伝,せんでんし始,はじめたころ、マケドニヤから出,でかけて行,いった時,とき、物,もののやりとりをしてわたしの働,はたらきに参加,さんかした教会,きょうかいは、あなたがたのほかには全,まったく無,なかった。","tok":[["ピリピ"],["の"],["人","ひと"],["たち"],["よ"],["。"],["あなた"],["がた"],["も"],["知って","しって"],["いる"],["とおり"],["、"],["わたし"],["が"],["福音","ふくいん"],["を"],["宣伝","せんでん"],["し"],["始","はじめ"],["た"],["ころ"],["、"],["マケドニヤ"],["から"],["出かけて","でかけて"],["行った","いった"],["時","とき"],["、"],["物","もの"],["の"],["やりとり"],["を"],["して"],["わたし"],["の"],["働らき","はたらき"],["に"],["参加","さんか"],["した"],["教会","きょうかい"],["は"],["、"],["あなた"],["がた"],["の"],["ほか"],["に"],["は"],["全く","まったく"],["無かった","なかった"],["。"]]},{"verse":16,"text":"またテサロニケでも、一再,いっさいならず、物,ものを送,おくってわたしの欠乏,けつぼうを補,おぎなってくれた。","tok":[["また"],["テサロニケ"],["で"],["も"],["、"],["一再","いっさい"],["ならず"],["、"],["物","もの"],["を"],["送って","おくって"],["わたし"],["の"],["欠乏","けつぼう"],["を"],["補なって","おぎなって"],["くれた"],["。"]]},{"verse":17,"text":"わたしは、贈,おくり物,ものを求,もとめているのではない。わたしの求,もとめているのは、あなたがたの勘定,かんじょうをふやしていく果実,かじつなのである。","tok":[["わたし"],["は"],["、"],["贈り物","おくりもの"],["を"],["求めて","もとめて"],["いる"],["ので"],["は"],["ない"],["。"],["わたし"],["の"],["求めて","もとめて"],["いる"],["の"],["は"],["、"],["あなた"],["がた"],["の"],["勘定","かんじょう"],["を"],["ふやして"],["いく"],["果実","かじつ"],["な"],["ので"],["ある"],["。"]]},{"verse":18,"text":"わたしは、すべての物,ものを受,うけてあり余,あまるほどである。エパフロデトから、あなたがたの贈,おくり物,ものをいただいて、飽,あき足,たりている。それは、かんばしいかおりであり、神,かみの喜,よろこんで受,うけて下,くださる供,そなえ物,ものである。","tok":[["わたし"],["は"],["、"],["すべて"],["の"],["物","もの"],["を"],["受て","うけて"],["あり余る","ありあまる"],["ほど"],["で"],["ある"],["。"],["エパフロデト"],["から"],["、"],["あなた"],["がた"],["の"],["贈り物","おくりもの"],["を"],["いただいて"],["、"],["飽き足りて","あきたりて"],["いる"],["。"],["それ"],["は"],["、"],["かんばしい"],["かおり"],["で"],["あり"],["、"],["神","かみ"],["の"],["喜こんで","よろこんで"],["受けて","うけて"],["下さる","くださる"],["供え物","そなえもの"],["で"],["ある"],["。"]]},{"verse":19,"text":"わたしの神,かみは、ご自身,じしんの栄光,えいこうの富,とみの中,なかから、あなたがたのいっさいの必要,ひつようを、キリスト・イエスにあって満,みたして下,くださるであろう。","tok":[["わたし"],["の"],["神","かみ"],["は"],["、"],["ご自身","ごじしん"],["の"],["栄光","えいこう"],["の"],["富","とみ"],["の"],["中","なか"],["から"],["、"],["あなた"],["がた"],["の"],["いっさい"],["の"],["必要","ひつよう"],["を"],["、"],["キリスト"],["・"],["イエス"],["に"],["あって"],["満たして","みたして"],["下さるで","くださるで"],["あろう"],["。"]]},{"verse":20,"text":"わたしたちの父,ちちなる神,かみに、栄光,えいこうが世々,よよ限,かぎりなくあるように、アァメン。","tok":[["わたしたち"],["の"],["父","ちち"],["なる"],["神","かみ"],["に"],["、"],["栄光","えいこう"],["が"],["世々","よ"],["よ"],["限","かぎり"],["なく"],["ある"],["よう"],["に"],["、"],["アァメン"],["。"]]},{"verse":21,"text":"キリスト・イエスにある聖徒,せいとのひとりびとりに、よろしく。わたしと一緒,いっしょにいる兄弟,きょうだいたちから、あなたがたによろしく。","tok":[["キリスト"],["・"],["イエス"],["に"],["ある"],["聖徒","せいと"],["の"],["ひとりびとり"],["に"],["、"],["よろしく"],["。"],["わたし"],["と"],["一緒","いっしょ"],["に"],["いる"],["兄弟","きょうだい"],["たち"],["から"],["、"],["あなた"],["がた"],["に"],["よろしく"],["。"]]},{"verse":22,"text":"すべての聖徒,せいとたちから、特,とくにカイザルの家,いえの者,ものたちから、よろしく。","tok":[["すべて"],["の"],["聖徒","せいと"],["たち"],["から"],["、"],["特に","とくに"],["カイザル"],["の"],["家","いえ"],["の"],["者","もの"],["たち"],["から"],["、"],["よろしく"],["。"]]},{"verse":23,"text":"主,しゅイエス・キリストの恵,めぐみが、あなたがたの霊,れいと共,ともにあるように。","tok":[["主","しゅ"],["イエス"],["・"],["キリスト"],["の"],["恵","めぐみ"],["が"],["、"],["あなた"],["がた"],["の"],["霊","れい"],["と"],["共","とも"],["に"],["ある"],["よう"],["に"],["。"]]}]
[{"verse":1,"text":"そこで、あなたがたに、キリストによる勧,すすめ、愛,あいの励,はげまし、御霊,みたまの交,まじわり、熱愛,ねつあいとあわれみとが、いくらかでもあるなら、","tok":[["そこ"],["で"],["、"],["あなた"],["がた"],["に"],["、"],["キリスト"],["に"],["よる"],["勧め","すすめ"],["、"],["愛","あい"],["の"],["励まし","はげまし"],["、"],["御霊","みたま"],["の"],["交じわり","まじわり"],["、"],["熱愛","ねつあい"],["と"],["あわれみ"],["と"],["が"],["、"],["いくら"],["か"],["で"],["も"],["あるなら"],["、"]]},{"verse":2,"text":"どうか同,おなじ思,おもいとなり、同,おなじ愛,あいの心,こころを持,もち、心,こころを合,あわせ、一つ思,おもいになって、わたしの喜,よろこびを満,みたしてほしい。","tok":[["どう"],["か"],["同じ","おなじ"],["思い","おもい"],["と"],["なり"],["、"],["同じ","おなじ"],["愛","あい"],["の"],["心","こころ"],["を"],["持","もち"],["、"],["心","こころ"],["を"],["合","あわせ"],["、"],["一","ひと"],["つ"],["思い","おもい"],["に"],["なって"],["、"],["わたし"],["の"],["喜こび","よろこび"],["を"],["満たして","みたして"],["ほしい"],["。"]]},{"verse":3,"text":"何事,なにごとも党派心,とうはしんや虚栄,きょえいからするのでなく、へりくだった心,こころをもって互,たがいに人,ひとを自分,じぶんよりすぐれた者,ものとしなさい。","tok":[["何事","なにごと"],["も"],["党派心","とうはしん"],["や"],["虚栄","きょえい"],["から"],["する"],["ので"],["なく"],["、"],["へりくだった"],["心","こころ"],["を"],["もって"],["互","たがい"],["に"],["人","ひと"],["を"],["自分","じぶん"],["より"],["すぐれた"],["者","もの"],["と"],["し"],["なさい"],["。"]]},{"verse":4,"text":"おのおの、自分,じぶんのことばかりでなく、他人,たにんのことも考,かんがえなさい。","tok":[["おのおの"],["、"],["自分","じぶん"],["の"],["こと"],["ばかり"],["で"],["なく"],["、"],["他人","たにん"],["の"],["こと"],["も"],["考","かんがえ"],["なさい"],["。"]]},{"verse":5,"text":"キリスト・イエスにあっていだいているのと同,おなじ思,おもいを、あなたがたの間,あいだでも互,たがいに生,いかしなさい。","tok":[["キリスト"],["・"],["イエス"],["に"],["あって"],["いだいて"],["いる"],["の"],["と"],["同じ","おなじ"],["思い","おもい"],["を"],["、"],["あなた"],["がた"],["の"],["間","あいだ"],["で"],["も"],["互","たがい"],["に"],["生かし","いかし"],["なさい"],["。"]]},{"verse":6,"text":"キリストは、神,かみのかたちであられたが、神,かみと等,ひとしくあることを固守,こしゅすべき事,こととは思,おもわず、","tok":[["キリスト"],["は"],["、"],["神","かみ"],["の"],["かたち"],["で"],["あられた"],["が"],["、"],["神","かみ"],["と"],["等く","ひとしく"],["ある"],["こと"],["を"],["固守","こしゅ"],["すべき"],["事","こと"],["と"],["は"],["思わず","おもわず"],["、"]]},{"verse":7,"text":"かえって、おのれをむなしうして僕,しもべのかたちをとり、人間,にんげんの姿,すがたになられた。その有様,ありさまは人,ひとと異,ことならず、","tok":[["かえって"],["、"],["おのれ"],["を"],["むなし"],["う"],["して"],["僕","し"],["も"],["べ"],["の"],["かたち"],["を"],["とり"],["、"],["人間","にんげん"],["の"],["姿","すがた"],["に"],["なられた"],["。"],["その"],["有様","ありさま"],["は"],["人","ひと"],["と"],["異ならず","ことならず"],["、"]]},{"verse":8,"text":"おのれを低,ひくくして、死,しに至,いたるまで、しかも十字架,じゅうじかの死,しに至,いたるまで従順,じゅうじゅんであられた。","tok":[["おのれ"],["を"],["低く","ひくく"],["して"],["、"],["死","し"],["に"],["至る","いたる"],["まで"],["、"],["しかも"],["十字架","じゅうじか"],["の"],["死","し"],["に"],["至る","いたる"],["まで"],["従順","じゅうじゅん"],["で"],["あられた"],["。"]]},{"verse":9,"text":"それゆえに、神,かみは彼,かれを高,たかく引,ひき上,あげ、すべての名,なにまさる名,なを彼,かれに賜,たまわった。","tok":[["それ"],["ゆえ"],["に"],["、"],["神","かみ"],["は"],["彼","かれ"],["を"],["高かく","たかく"],["引上げ","ひきあげ"],["、"],["すべて"],["の"],["名","な"],["に"],["まさる"],["名","な"],["を"],["彼","かれ"],["に"],["賜わった","たまわった"],["。"]]},{"verse":10,"text":"それは、イエスの御名,みなによって、天上,てんじょうのもの、地上,ちじょうのもの、地下,ちかのものなど、あらゆるものがひざをかがめ、","tok":[["それ"],["は"],["、"],["イエス"],["の"],["御名","みな"],["によって"],["、"],["天上","てんじょう"],["の"],["もの"],["、"],["地上","ちじょう"],["の"],["もの"],["、"],["地下","ちか"],["の"],["もの"],["など"],["、"],["あらゆる"],["もの"],["が"],["ひざ"],["を"],["かがめ"],["、"]]},{"verse":11,"text":"また、あらゆる舌,したが、「イエス・キリストは主,しゅである」と告白,こくはくして、栄光,えいこうを父,ちちなる神,かみに帰,きするためである。","tok":[["また"],["、"],["あらゆる"],["舌","した"],["が"],["、"],["「"],["イエス"],["・"],["キリスト"],["は"],["主","しゅ"],["で"],["ある"],["」"],["と"],["告白","こくはく"],["して"],["、"],["栄光","えいこう"],["を"],["父","ちち"],["なる"],["神","かみ"],["に"],["帰する","きする"],["ため"],["で"],["ある"],["。"]]},{"verse":12,"text":"わたしの愛,あいする者,ものたちよ。そういうわけだから、あなたがたがいつも従順,じゅうじゅんであったように、わたしが一緒,いっしょにいる時,ときだけでなく、いない今,いまは、いっそう従順,じゅうじゅんでいて、恐,おそれおののいて自分,じぶんの救,すくいの達成,たっせいに努,つとめなさい。","tok":[["わたし"],["の"],["愛する","あいする"],["者","もの"],["たち"],["よ"],["。"],["そう"],["いう"],["わけ"],["だ"],["から"],["、"],["あなた"],["がた"],["が"],["いつも"],["従順","じゅうじゅん"],["で"],["あった"],["よう"],["に"],["、"],["わたし"],["が"],["一緒","いっしょ"],["に"],["いる"],["時","とき"],["だけ"],["で"],["なく"],["、"],["いない"],["今","いま"],["は"],["、"],["いっそう"],["従順","じゅうじゅん"],["で"],["いて"],["、"],["恐れおののいて","おそれおののいて"],["自分","じぶん"],["の"],["救い","すくい"],["の"],["達成","たっせい"],["に"],["努め","つとめ"],["なさい"],["。"]]},{"verse":13,"text":"あなたがたのうちに働,はたらきかけて、その願,ねがいを起,おこさせ、かつ実現,じつげんに至,いたらせるのは神,かみであって、それは神,かみのよしとされるところだからである。","tok":[["あなた"],["がた"],["の"],["うち"],["に"],["働らき","はたらき"],["かけて"],["、"],["その"],["願い","ねがい"],["を"],["起こさせ","おこさせ"],["、"],["かつ"],["実現","じつげん"],["に"],["至らせる","いたらせる"],["の"],["は"],["神","かみ"],["で"],["あって"],["、"],["それ"],["は"],["神","かみ"],["の"],["よし"],["と"],["される"],["ところ"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":14,"text":"すべてのことを、つぶやかず疑,うたがわないでしなさい。","tok":[["すべて"],["の"],["こと"],["を"],["、"],["つぶやかず"],["疑がわないで","うたがわないで"],["し"],["なさい"],["。"]]},{"verse":15,"text":"それは、あなたがたが責,せめられるところのない純真,じゅんしんな者,ものとなり、曲,まがった邪悪,じゃあくな時代,じだいのただ中,なかにあって、傷,きずのない神,かみの子,ことなるためである。あなたがたは、いのちの言葉,ことばを堅,かたく持,もって、彼,かれらの間,あいだで星,ほしのようにこの世,よに輝,かがやいている。","tok":[["それ"],["は"],["、"],["あなた"],["がた"],["が"],["責","せめ"],["られる"],["ところ"],["の"],["ない"],["純真","じゅんしん"],["な"],["者","もの"],["と"],["なり"],["、"],["曲がった","まがった"],["邪悪","じゃあく"],["な"],["時代","じだい"],["の"],["ただ中","ただなか"],["に"],["あって"],["、"],["傷","きず"],["の"],["ない"],["神","かみ"],["の"],["子","こ"],["と"],["なる"],["ため"],["で"],["ある"],["。"],["あなた"],["がた"],["は"],["、"],["いのち"],["の"],["言葉","ことば"],["を"],["堅く","かたく"],["持って","もって"],["、"],["彼","かれ"],["ら"],["の"],["間","あいだ"],["で"],["星","ほし"],["の"],["よう"],["に"],["この世","このよ"],["に"],["輝やいて","かがやいて"],["いる"],["。"]]},{"verse":16,"text":"このようにして、キリストの日,ひに、わたしは自分,じぶんの走,はしったことがむだでなく、労,ろうしたこともむだではなかったと誇,ほこることができる。","tok":[["この"],["よう"],["に"],["して"],["、"],["キリスト"],["の"],["日","ひ"],["に"],["、"],["わたし"],["は"],["自分","じぶん"],["の"],["走った","はしった"],["こと"],["が"],["むだ"],["で"],["なく"],["、"],["労","ろう"],["した"],["こと"],["も"],["むだ"],["で"],["は"],["なかった"],["と"],["誇る","ほこる"],["こと"],["が"],["できる"],["。"]]},{"verse":17,"text":"そして、たとい、あなたがたの信仰,しんこうの供,そなえ物,ものをささげる祭壇,さいだんに、わたしの血,ちをそそぐことがあっても、わたしは喜,よろこぼう。あなたがた一同,いちどうと共,ともに喜,よろこぼう。","tok":[["そして"],["、"],["たとい"],["、"],["あなた"],["がた"],["の"],["信仰","しんこう"],["の"],["供え物","そなえもの"],["を"],["ささげる"],["祭壇","さいだん"],["に"],["、"],["わたし"],["の"],["血","ち"],["を"],["そそぐ"],["こと"],["が"],["あって"],["も"],["、"],["わたし"],["は"],["喜こぼう","よろこぼう"],["。"],["あなた"],["がた"],["一同","いちどう"],["と"],["共","とも"],["に"],["喜こぼう","よろこぼう"],["。"]]},{"verse":18,"text":"同,おなじように、あなたがたも喜,よろこびなさい。わたしと共,ともに喜,よろこびなさい。","tok":[["同じ","おなじ"],["よう"],["に"],["、"],["あなた"],["がた"],["も"],["喜こび","よろこび"],["なさい"],["。"],["わたし"],["と"],["共","とも"],["に"],["喜こび","よろこび"],["なさい"],["。"]]},{"verse":19,"text":"さて、わたしは、まもなくテモテをあなたがたのところに送,おくりたいと、主,しゅイエスにあって願,ねがっている。それは、あなたがたの様子,ようすを知,しって、わたしも力,ちからづけられたいからである。","tok":[["さて"],["、"],["わたし"],["は"],["、"],["ま"],["も"],["なく"],["テモテ"],["を"],["あなた"],["がた"],["の"],["ところ"],["に"],["送りたい","おくりたい"],["と"],["、"],["主","しゅ"],["イエス"],["に"],["あって"],["願って","ねがって"],["いる"],["。"],["それ"],["は"],["、"],["あなた"],["がた"],["の"],["様子","ようす"],["を"],["知って","しって"],["、"],["わたし"],["も"],["力づけられたい","ちからづけられたい"],["から"],["で"],["ある"],["。"]]},{"verse":20,"text":"テモテのような心,こころで、親身,しんみになってあなたがたのことを心配,しんぱいしている者,ものは、ほかにひとりもない。","tok":[["テモテ"],["の"],["よう"],["な"],["心","こころ"],["で"],["、"],["親身","しんみ"],["に"],["なって"],["あなた"],["がた"],["の"],["こと"],["を"],["心配","しんぱい"],["して"],["いる"],["者","もの"],["は"],["、"],["ほか"],["に"],["ひとり"],["も"],["ない"],["。"]]},{"verse":21,"text":"人,ひとはみな、自分,じぶんのことを求,もとめるだけで、キリスト・イエスのことは求,もとめていない。","tok":[["人","ひと"],["は"],["みな"],["、"],["自分","じぶん"],["の"],["こと"],["を"],["求める","もとめる"],["だけ"],["で"],["、"],["キリスト"],["・"],["イエス"],["の"],["こと"],["は"],["求めて","もとめて"],["いない"],["。"]]},{"verse":22,"text":"しかし、テモテの錬達,れんたつぶりは、あなたがたの知,しっているとおりである。すなわち、子,こが父,ちちに対,たいするようにして、わたしと一緒,いっしょに福音,ふくいんに仕,つかえてきたのである。","tok":[["しかし"],["、"],["テモテ"],["の"],["錬達","れんたつぶり"],["は"],["、"],["あなた"],["がた"],["の"],["知って","しって"],["いる"],["とおり"],["で"],["ある"],["。"],["すなわち"],["、"],["子","こ"],["が"],["父","ちち"],["に"],["対する","たいする"],["よう"],["に"],["して"],["、"],["わたし"],["と"],["一緒","いっしょ"],["に"],["福音","ふくいん"],["に"],["仕えて","つかえて"],["きた"],["ので"],["ある"],["。"]]},{"verse":23,"text":"そこで、この人,ひとを、わたしの成行,なりゆきがわかりしだい、すぐにでも、そちらへ送,おくりたいと願,ねがっている。","tok":[["そこ"],["で"],["、"],["この"],["人","ひと"],["を"],["、"],["わたし"],["の"],["成行","なりゆき"],["が"],["わかり"],["しだい"],["、"],["すぐ"],["に"],["で"],["も"],["、"],["そちら"],["へ"],["送りたい","おくりたい"],["と"],["願って","ねがって"],["いる"],["。"]]},{"verse":24,"text":"わたし自身,じしんもまもなく行,いけるものと、主,しゅにあって確信,かくしんしている。","tok":[["わたし"],["自身","じしん"],["も"],["ま"],["も"],["なく"],["行ける","いける"],["もの"],["と"],["、"],["主に","しゅに"],["あって"],["確信","かくしん"],["して"],["いる"],["。"]]},{"verse":25,"text":"しかし、さしあたり、わたしの同労者,どうろうしゃで戦友,せんゆうである兄弟,きょうだい、また、あなたがたの使者,ししゃとしてわたしの窮乏,きゅうぼうを補,おぎなってくれたエパフロデトを、あなたがたのもとに送,おくり返,かえすことが必要,ひつようだと思,おもっている。","tok":[["しかし"],["、"],["さしあたり"],["、"],["わたし"],["の"],["同労者","どうろうしゃ"],["で"],["戦友","せんゆう"],["で"],["ある"],["兄弟","きょうだい"],["、"],["また"],["、"],["あなた"],["がた"],["の"],["使者","ししゃ"],["として"],["わたし"],["の"],["窮乏","きゅうぼう"],["を"],["補なって","おぎなって"],["くれた"],["エパフロデト"],["を"],["、"],["あなた"],["がた"],["の"],["もと"],["に"],["送り","おくり"],["返えす","かえす"],["こと"],["が"],["必要","ひつよう"],["だ"],["と"],["思って","おもって"],["いる"],["。"]]},{"verse":26,"text":"彼,かれは、あなたがた一同,いちどうにしきりに会,あいたがっているからである。その上,うえ、自分,じぶんの病気,びょうきのことがあなたがたに聞,きこえたので、彼,かれは心苦,こころぐるしく思,おもっている。","tok":[["彼","かれ"],["は"],["、"],["あなた"],["がた"],["一同","いちどう"],["に"],["しきり"],["に"],["会いたがって","あいたがって"],["いる"],["から"],["で"],["ある"],["。"],["その"],["上","うえ"],["、"],["自分","じぶん"],["の"],["病気","びょうき"],["の"],["こと"],["が"],["あなた"],["がた"],["に"],["聞こえた","きこえた"],["ので"],["、"],["彼","かれ"],["は"],["心苦しく","こころぐるしく"],["思って","おもって"],["いる"],["。"]]},{"verse":27,"text":"彼,かれは実,じつに、ひん死,しの病気,びょうきにかかったが、神,かみは彼,かれをあわれんで下,くださった。彼,かればかりではなく、わたしをもあわれんで下,くださったので、わたしは悲,かなしみに悲,かなしみを重,かさねないですんだのである。","tok":[["彼","かれ"],["は"],["実","じつ"],["に"],["、"],["ひん死","ひんし"],["の"],["病気","びょうき"],["に"],["かかった"],["が"],["、"],["神","かみ"],["は"],["彼","かれ"],["を"],["あわれんで"],["下さった","くださった"],["。"],["彼","かれ"],["ばかり"],["で"],["は"],["なく"],["、"],["わたし"],["を"],["も"],["あわれんで"],["下さった","くださった"],["ので"],["、"],["わたし"],["は"],["悲しみ","かなしみ"],["に"],["悲しみ","かなしみ"],["を"],["重ねないです","かさねないです"],["ん"],["だ"],["ので"],["ある"],["。"]]},{"verse":28,"text":"そこで、大急,おおいそぎで彼,かれを送,おくり返,かえす。これで、あなたがたは彼,かれと再,ふたたび会,あって喜,よろこび、わたしもまた、心配,しんぱいを和,やわらげることができよう。","tok":[["そこ"],["で"],["、"],["大急ぎ","おおいそぎ"],["で"],["彼","かれ"],["を"],["送り","おくり"],["返えす","かえす"],["。"],["これ"],["で"],["、"],["あなた"],["がた"],["は"],["彼","かれ"],["と"],["再び","ふたたび"],["会って","あって"],["喜こび","よろこび"],["、"],["わたし"],["も"],["また"],["、"],["心配","しんぱい"],["を"],["和らげる","やわらげる"],["こと"],["が"],["できよう"],["。"]]},{"verse":29,"text":"こういうわけだから、大,おおいに喜,よろこんで、主,しゅにあって彼,かれを迎,むかえてほしい。また、こうした人々,ひとびとは尊重,そんちょうせねばならない。","tok":[["こう"],["いう"],["わけ"],["だ"],["から"],["、"],["大いに","おおいに"],["喜こんで","よろこんで"],["、"],["主に","しゅに"],["あって"],["彼","かれ"],["を"],["迎","むかえ"],["て"],["ほしい"],["。"],["また"],["、"],["こう"],["した"],["人々","ひとびと"],["は"],["尊重","そんちょう"],["せねば"],["ならない"],["。"]]},{"verse":30,"text":"彼,かれは、わたしに対,たいしてあなたがたが奉仕,ほうしのできなかった分,ぶんを補,おぎなおうとして、キリストのわざのために命,いのちをかけ、死,しぬばかりになったのである。","tok":[["彼","かれ"],["は"],["、"],["わたし"],["に対して","にたいして"],["あなた"],["がた"],["が"],["奉仕","ほうし"],["の"],["できなかった"],["分","ぶん"],["を"],["補なおう","おぎなおう"],["として"],["、"],["キリスト"],["の"],["わざ"],["の"],["ため"],["に"],["命","いのち"],["を"],["かけ"],["、"],["死ぬ","しぬ"],["ばかり"],["に"],["なった"],["ので"],["ある"],["。"]]}]
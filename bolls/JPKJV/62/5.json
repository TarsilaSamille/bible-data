[{"verse":1,"text":"すべてイエスのキリストであることを信,しんじる者,ものは、神,かみから生,うまれた者,ものである。すべて生,うんで下,くださったかたを愛,あいする者,ものは、そのかたから生,うまれた者,ものをも愛,あいするのである。","tok":[["すべて"],["イエス"],["の"],["キリスト"],["で"],["ある"],["こと"],["を"],["信じる","しんじる"],["者","もの"],["は"],["、"],["神","かみ"],["から"],["生まれた","うまれた"],["者","もの"],["で"],["ある"],["。"],["すべて"],["生んで","うんで"],["下さった","くださった"],["かた"],["を"],["愛する","あいする"],["者","もの"],["は"],["、"],["その"],["かた"],["から"],["生まれた","うまれた"],["者","もの"],["を"],["も"],["愛する","あいする"],["ので"],["ある"],["。"]]},{"verse":2,"text":"神,かみを愛,あいしてその戒,いましめを行,おこなえば、それによってわたしたちは、神,かみの子,こたちを愛,あいしていることを知,しるのである。","tok":[["神","かみ"],["を"],["愛して","あいして"],["その"],["戒しめ","いましめ"],["を"],["行なえば","おこなえば"],["、"],["それ"],["によって"],["わたしたち"],["は"],["、"],["神","かみ"],["の"],["子","こ"],["たち"],["を"],["愛して","あいして"],["いる"],["こと"],["を"],["知る","しる"],["ので"],["ある"],["。"]]},{"verse":3,"text":"神,かみを愛,あいするとは、すなわち、その戒,いましめを守,まもることである。そして、その戒,いましめはむずかしいものではない。","tok":[["神","かみ"],["を"],["愛する","あいする"],["と"],["は"],["、"],["すなわち"],["、"],["その"],["戒しめ","いましめ"],["を"],["守","まもる"],["こと"],["で"],["ある"],["。"],["そして"],["、"],["その"],["戒しめ","いましめ"],["は"],["むずかしい"],["もの"],["で"],["は"],["ない"],["。"]]},{"verse":4,"text":"なぜなら、すべて神,かみから生,うまれた者,ものは、世,よに勝,かつからである。そして、わたしたちの信仰,しんこうこそ、世,よに勝,かたしめた勝利,しょうりの力,ちからである。","tok":[["なぜ"],["なら"],["、"],["すべて"],["神","かみ"],["から"],["生まれた","うまれた"],["者","もの"],["は"],["、"],["世","よ"],["に"],["勝つ","かつ"],["から"],["で"],["ある"],["。"],["そして"],["、"],["わたしたち"],["の"],["信仰","しんこう"],["こそ"],["、"],["世","よ"],["に"],["勝たしめた","かたしめた"],["勝利","しょうり"],["の"],["力","ちから"],["で"],["ある"],["。"]]},{"verse":5,"text":"世,よに勝,かつ者,ものはだれか。イエスを神,かみの子,こと信,しんじる者,ものではないか。","tok":[["世","よ"],["に"],["勝つ","かつ"],["者","もの"],["は"],["だれ"],["か"],["。"],["イエス"],["を"],["神","かみ"],["の"],["子","こ"],["と"],["信じる","しんじる"],["者","もの"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":6,"text":"このイエス・キリストは、水,みずと血,ちとをとおってこられたかたである。水,みずによるだけではなく、水,みずと血,ちとによってこられたのである。そのあかしをするものは、御霊,みたまである。御霊,みたまは真理,しんりだからである。","tok":[["この"],["イエス"],["・"],["キリスト"],["は"],["、"],["水","みず"],["と"],["血","ち"],["と"],["を"],["とおって"],["こられた"],["かた"],["で"],["ある"],["。"],["水","みず"],["に"],["よる"],["だけ"],["で"],["は"],["なく"],["、"],["水","みず"],["と"],["血","ち"],["と"],["によって"],["こられた"],["ので"],["ある"],["。"],["その"],["あかし"],["を"],["する"],["もの"],["は"],["、"],["御霊","みた"],["まで"],["ある"],["。"],["御霊","みたま"],["は"],["真理","しんり"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":7,"text":"あかしをするものが、三つある。","tok":[["あかし"],["を"],["する"],["もの"],["が"],["、"],["三","みっ"],["つ"],["ある"],["。"]]},{"verse":8,"text":"御霊,みたまと水,みずと血,ちとである。そして、この三つのものは一致,いっちする。","tok":[["御霊","みたま"],["と"],["水","みず"],["と"],["血","ち"],["と"],["で"],["ある"],["。"],["そして"],["、"],["この"],["三","みっ"],["つ"],["の"],["もの"],["は"],["一致","いっち"],["する"],["。"]]},{"verse":9,"text":"わたしたちは人間,にんげんのあかしを受,うけいれるが、しかし、神,かみのあかしはさらにまさっている。神,かみのあかしというのは、すなわち、御子,みこについて立,たてられたあかしである。","tok":[["わたしたち"],["は"],["人間","にんげん"],["の"],["あかし"],["を"],["受","うけ"],["いれる"],["が"],["、"],["しかし"],["、"],["神","かみ"],["の"],["あかし"],["は"],["さらに"],["まさって"],["いる"],["。"],["神","かみ"],["の"],["あかし"],["と"],["いう"],["の"],["は"],["、"],["すなわち"],["、"],["御子","みこ"],["について"],["立られた","たてられた"],["あかし"],["で"],["ある"],["。"]]},{"verse":10,"text":"神,かみの子,こを信,しんじる者,ものは、自分,じぶんのうちにこのあかしを持,もっている。神,かみを信,しんじない者,ものは、神,かみを偽,いつわり者,ものとする。神,かみが御子,みこについてあかしせられたそのあかしを、信,しんじていないからである。","tok":[["神","かみ"],["の"],["子","こ"],["を"],["信じる","しんじる"],["者","もの"],["は"],["、"],["自分","じぶん"],["の"],["うち"],["に"],["この"],["あかし"],["を"],["持って","もって"],["いる"],["。"],["神","かみ"],["を"],["信じない","しんじない"],["者","もの"],["は"],["、"],["神","かみ"],["を"],["偽わり","いつわり"],["者","もの"],["と"],["する"],["。"],["神","かみ"],["が"],["御子","みこ"],["について"],["あかしせられた"],["その"],["あかし"],["を"],["、"],["信じて","しんじて"],["いない"],["から"],["で"],["ある"],["。"]]},{"verse":11,"text":"そのあかしとは、神,かみが永遠,えいえんのいのちをわたしたちに賜,たまわり、かつ、そのいのちが御子,みこのうちにあるということである。","tok":[["その"],["あかし"],["と"],["は"],["、"],["神","かみ"],["が"],["永遠","えいえん"],["の"],["いのち"],["を"],["わたしたち"],["に"],["賜わり","たまわり"],["、"],["かつ"],["、"],["その"],["いのち"],["が"],["御子","みこ"],["の"],["うち"],["に"],["ある"],["と"],["いう"],["こと"],["で"],["ある"],["。"]]},{"verse":12,"text":"御子,みこを持,もつ者,ものはいのちを持,もち、神,かみの御子,みこを持,もたない者,ものはいのちを持,もっていない。","tok":[["御子","みこ"],["を"],["持つ","もつ"],["者","もの"],["は"],["いのち"],["を"],["持","もち"],["、"],["神","かみ"],["の"],["御子","みこ"],["を"],["持たない","もたない"],["者","もの"],["は"],["いのち"],["を"],["持って","もって"],["いない"],["。"]]},{"verse":13,"text":"これらのことをあなたがたに書,かきおくったのは、神,かみの子,この御名,みなを信,しんじるあなたがたに、永遠,えいえんのいのちを持,もっていることを、悟,さとらせるためである。","tok":[["これ"],["ら"],["の"],["こと"],["を"],["あなた"],["がた"],["に"],["書きおくった","かきおくった"],["の"],["は"],["、"],["神","かみ"],["の"],["子","こ"],["の"],["御名","みな"],["を"],["信じる","しんじる"],["あなた"],["がた"],["に"],["、"],["永遠","えいえん"],["の"],["いのち"],["を"],["持って","もって"],["いる"],["こと"],["を"],["、"],["悟らせる","さとらせる"],["ため"],["で"],["ある"],["。"]]},{"verse":14,"text":"わたしたちが神,かみに対,たいしていだいている確信,かくしんは、こうである。すなわち、わたしたちが何事,なにごとでも神,かみの御旨,みむねに従,したがって願,ねがい求,もとめるなら、神,かみはそれを聞,ききいれて下,くださるということである。","tok":[["わたしたち"],["が"],["神","かみ"],["に対して","にたいして"],["いだいて"],["いる"],["確信","かくしん"],["は"],["、"],["こう"],["で"],["ある"],["。"],["すなわち"],["、"],["わたしたち"],["が"],["何事","なにごと"],["で"],["も"],["神","かみ"],["の"],["御旨","みむね"],["に"],["従って","したがって"],["願い求めるなら","ねがいもとめるなら"],["、"],["神","かみ"],["は"],["それ"],["を"],["聞きいれて","ききいれて"],["下さる","くださる"],["と"],["いう"],["こと"],["で"],["ある"],["。"]]},{"verse":15,"text":"そして、わたしたちが願,ねがい求,もとめることは、なんでも聞,ききいれて下,くださるとわかれば、神,かみに願,ねがい求,もとめたことはすでにかなえられたことを、知,しるのである。","tok":[["そして"],["、"],["わたしたち"],["が"],["願い求める","ねがいもとめる"],["こと"],["は"],["、"],["なん"],["で"],["も"],["聞きいれて","ききいれて"],["下さる","くださる"],["と"],["わかれば"],["、"],["神","かみ"],["に"],["願い求めた","ねがいもとめた"],["こと"],["は"],["すでに"],["かなえられた"],["こと"],["を"],["、"],["知る","しる"],["ので"],["ある"],["。"]]},{"verse":16,"text":"もしだれかが死,しに至,いたることのない罪,つみを犯,おかしている兄弟,きょうだいを見,みたら、神,かみに願,ねがい求,もとめなさい。そうすれば神,かみは、死,しに至,いたることのない罪,つみを犯,おかしている人々,ひとびとには、いのちを賜,たまわるであろう。死,しに至,いたる罪,つみがある。これについては、願,ねがい求,もとめよ、とは言,いわない。","tok":[["もし"],["だれ"],["か"],["が"],["死","し"],["に"],["至る","いたる"],["こと"],["の"],["ない"],["罪","つみ"],["を"],["犯して","おかして"],["いる"],["兄弟","きょうだい"],["を"],["見たら","みたら"],["、"],["神","かみ"],["に"],["願い求め","ねがいもとめ"],["なさい"],["。"],["そう"],["すれば"],["神","かみ"],["は"],["、"],["死","し"],["に"],["至る","いたる"],["こと"],["の"],["ない"],["罪","つみ"],["を"],["犯して","おかして"],["いる"],["人々","ひとびと"],["に"],["は"],["、"],["いのち"],["を"],["賜わるで","たまわるで"],["あろう"],["。"],["死","し"],["に"],["至る","いたる"],["罪","つみ"],["が"],["ある"],["。"],["これ"],["について"],["は"],["、"],["願い求めよ","ねがいもとめよ"],["、"],["と"],["は"],["言わない","いわない"],["。"]]},{"verse":17,"text":"不義,ふぎはすべて、罪,つみである。しかし、死,しに至,いたることのない罪,つみもある。","tok":[["不義","ふぎ"],["は"],["すべて"],["、"],["罪","つみ"],["で"],["ある"],["。"],["しかし"],["、"],["死","し"],["に"],["至る","いたる"],["こと"],["の"],["ない"],["罪","つみ"],["も"],["ある"],["。"]]},{"verse":18,"text":"すべて神,かみから生,うまれた者,ものは罪,つみを犯,おかさないことを、わたしたちは知,しっている。神,かみから生,うまれたかたが彼,かれを守,まもっていて下,くださるので、悪,あしき者,ものが手,てを触,ふれるようなことはない。","tok":[["すべて"],["神","かみ"],["から"],["生まれた","うまれた"],["者","もの"],["は"],["罪","つみ"],["を"],["犯さない","おかさない"],["こと"],["を"],["、"],["わたしたち"],["は"],["知って","しって"],["いる"],["。"],["神","かみ"],["から"],["生まれた","うまれた"],["かた"],["が"],["彼","かれ"],["を"],["守って","まもって"],["いて"],["下さる","くださる"],["ので"],["、"],["悪しき","あしき"],["者","もの"],["が"],["手","て"],["を"],["触れる","ふれる"],["よう"],["な"],["こと"],["は"],["ない"],["。"]]},{"verse":19,"text":"また、わたしたちは神,かみから出,でた者,ものであり、全,ぜん世界,せかいは悪,あしき者,ものの配下,はいかにあることを、知,しっている。","tok":[["また"],["、"],["わたしたち"],["は"],["神","かみ"],["から"],["出た","でた"],["者","もの"],["で"],["あり"],["、"],["全","ぜん"],["世界","せかい"],["は"],["悪しき","あしき"],["者","もの"],["の"],["配下","はいか"],["に"],["ある"],["こと"],["を"],["、"],["知って","しって"],["いる"],["。"]]},{"verse":20,"text":"さらに、神,かみの子,こがきて、真実,しんじつなかたを知,しる知力,ちりょくをわたしたちに授,さづけて下,くださったことも、知,しっている。そして、わたしたちは、真実,しんじつなかたにおり、御子,みこイエス・キリストにおるのである。このかたは真実,しんじつな神,かみであり、永遠,えいえんのいのちである。","tok":[["さらに"],["、"],["神","かみ"],["の"],["子","こ"],["が"],["きて"],["、"],["真実","しんじつ"],["な"],["かた"],["を"],["知る","しる"],["知力","ちりょく"],["を"],["わたしたち"],["に"],["授","さ"],["づけて"],["下さった","くださった"],["こと"],["も"],["、"],["知って","しって"],["いる"],["。"],["そして"],["、"],["わたしたち"],["は"],["、"],["真実","しんじつ"],["な"],["かた"],["に"],["おり"],["、"],["御子","みこ"],["イエス"],["・"],["キリスト"],["に"],["おる"],["ので"],["ある"],["。"],["この"],["かた"],["は"],["真実","しんじつ"],["な"],["神","かみ"],["で"],["あり"],["、"],["永遠","えいえん"],["の"],["いのち"],["で"],["ある"],["。"]]},{"verse":21,"text":"子,こたちよ。気,きをつけて、偶像,ぐうぞうを避,さけなさい。","tok":[["子","こ"],["たち"],["よ"],["。"],["気","き"],["を"],["つけて"],["、"],["偶像","ぐうぞう"],["を"],["避け","さけ"],["なさい"],["。"]]}]
[{"verse":1,"text":"愛,あいする者,ものたちよ。すべての霊,れいを信,しんじることはしないで、それらの霊,れいが神,かみから出,でたものであるかどうか、ためしなさい。多,おおくのにせ預言者,よげんしゃが世,よに出,でてきているからである。","tok":[["愛する","あいする"],["者","もの"],["たち"],["よ"],["。"],["すべて"],["の"],["霊","れい"],["を"],["信じる","しんじる"],["こと"],["は"],["しないで"],["、"],["それ"],["ら"],["の"],["霊","れい"],["が"],["神","かみ"],["から"],["出た","でた"],["もの"],["で"],["ある"],["か"],["どう"],["か"],["、"],["ためし"],["なさい"],["。"],["多く","おおく"],["の"],["にせ"],["預言者","よげんしゃ"],["が"],["世","よ"],["に"],["出て","でて"],["きて"],["いる"],["から"],["で"],["ある"],["。"]]},{"verse":2,"text":"あなたがたは、こうして神,かみの霊,れいを知,しるのである。すなわち、イエス・キリストが肉体,にくたいをとってこられたことを告白,こくはくする霊,れいは、すべて神,かみから出,でているものであり、","tok":[["あなた"],["がた"],["は"],["、"],["こう"],["して"],["神","かみ"],["の"],["霊","れい"],["を"],["知る","しる"],["ので"],["ある"],["。"],["すなわち"],["、"],["イエス"],["・"],["キリスト"],["が"],["肉体","にくたい"],["を"],["とって"],["こられた"],["こと"],["を"],["告白","こくはく"],["する"],["霊","れい"],["は"],["、"],["すべて"],["神","かみ"],["から"],["出て","でて"],["いる"],["もの"],["で"],["あり"],["、"]]},{"verse":3,"text":"イエスを告白,こくはくしない霊,れいは、すべて神,かみから出,でているものではない。これは、反,はんキリストの霊,れいである。あなたがたは、それが来,くるとかねて聞,きいていたが、今,いまやすでに世,よにきている。","tok":[["イエス"],["を"],["告白","こくはく"],["しない"],["霊","れい"],["は"],["、"],["すべて"],["神","かみ"],["から"],["出て","でて"],["いる"],["もの"],["で"],["は"],["ない"],["。"],["これ"],["は"],["、"],["反","はん"],["キリスト"],["の"],["霊","れい"],["で"],["ある"],["。"],["あなた"],["がた"],["は"],["、"],["それ"],["が"],["来る","くる"],["と"],["かねて"],["聞いて","きいて"],["いた"],["が"],["、"],["今","いま"],["やすで"],["に"],["世","よ"],["に"],["きて"],["いる"],["。"]]},{"verse":4,"text":"子,こたちよ。あなたがたは神,かみから出,でた者,ものであって、彼,かれらにうち勝,かったのである。あなたがたのうちにいますのは、世,よにある者,ものよりも大,おおいなる者,ものなのである。","tok":[["子","こ"],["たち"],["よ"],["。"],["あなた"],["がた"],["は"],["神","かみ"],["から"],["出た","でた"],["者","もの"],["で"],["あって"],["、"],["彼","かれ"],["ら"],["に"],["うち勝った","うちかった"],["ので"],["ある"],["。"],["あなた"],["がた"],["の"],["うち"],["に"],["います"],["の"],["は"],["、"],["世","よ"],["に"],["ある"],["者","もの"],["より"],["も"],["大いなる","おおいなる"],["者","もの"],["な"],["ので"],["ある"],["。"]]},{"verse":5,"text":"彼,かれらは世,よから出,でたものである。だから、彼,かれらは世,よのことを語,かたり、世,よも彼,かれらの言,いうことを聞,きくのである。","tok":[["彼","かれ"],["ら"],["は"],["世","よ"],["から"],["出た","でた"],["もの"],["で"],["ある"],["。"],["だ"],["から"],["、"],["彼","かれ"],["ら"],["は"],["世","よ"],["の"],["こと"],["を"],["語り","かたり"],["、"],["世","よ"],["も"],["彼","かれ"],["ら"],["の"],["言う","いう"],["こと"],["を"],["聞く","きく"],["ので"],["ある"],["。"]]},{"verse":6,"text":"しかし、わたしたちは神,かみから出,でたものである。神,かみを知,しっている者,ものは、わたしたちの言,いうことを聞,きき、神,かみから出,でない者,ものは、わたしたちの言,いうことを聞,きかない。これによって、わたしたちは、真理,しんりの霊,れいと迷,まよいの霊,れいとの区別,くべつを知,しるのである。","tok":[["しかし"],["、"],["わたしたち"],["は"],["神","かみ"],["から"],["出た","でた"],["もの"],["で"],["ある"],["。"],["神","かみ"],["を"],["知って","しって"],["いる"],["者","もの"],["は"],["、"],["わたしたち"],["の"],["言う","いう"],["こと"],["を"],["聞","きき"],["、"],["神","かみ"],["から"],["出ない","でない"],["者","もの"],["は"],["、"],["わたしたち"],["の"],["言う","いう"],["こと"],["を"],["聞かない","きかない"],["。"],["これ"],["によって"],["、"],["わたしたち"],["は"],["、"],["真理","しんり"],["の"],["霊","れい"],["と"],["迷い","まよい"],["の"],["霊","れい"],["と"],["の"],["区別","くべつ"],["を"],["知る","しる"],["ので"],["ある"],["。"]]},{"verse":7,"text":"愛,あいする者,ものたちよ。わたしたちは互,たがいに愛,あいし合おうではないか。愛,あいは、神,かみから出,でたものなのである。すべて愛,あいする者,ものは、神,かみから生,うまれた者,ものであって、神,かみを知,しっている。","tok":[["愛する","あいする"],["者","もの"],["たち"],["よ"],["。"],["わたしたち"],["は"],["互","たがい"],["に"],["愛し合おう","あいし合おう"],["で"],["は"],["ない"],["か"],["。"],["愛","あい"],["は"],["、"],["神","かみ"],["から"],["出た","でた"],["もの"],["な"],["ので"],["ある"],["。"],["すべて"],["愛する","あいする"],["者","もの"],["は"],["、"],["神","かみ"],["から"],["生まれた","うまれた"],["者","もの"],["で"],["あって"],["、"],["神","かみ"],["を"],["知って","しって"],["いる"],["。"]]},{"verse":8,"text":"愛,あいさない者,ものは、神,かみを知,しらない。神,かみは愛,あいである。","tok":[["愛さない","あいさない"],["者","もの"],["は"],["、"],["神","かみ"],["を"],["知らない","しらない"],["。"],["神","かみ"],["は"],["愛","あい"],["で"],["ある"],["。"]]},{"verse":9,"text":"神,かみはそのひとり子,こを世,よにつかわし、彼,かれによってわたしたちを生,いきるようにして下,くださった。それによって、わたしたちに対,たいする神,かみの愛,あいが明,あきらかにされたのである。","tok":[["神","かみ"],["は"],["その"],["ひとり"],["子","こ"],["を"],["世","よ"],["に"],["つかわし"],["、"],["彼","かれ"],["によって"],["わたしたち"],["を"],["生きる","いきる"],["よう"],["に"],["して"],["下さった","くださった"],["。"],["それ"],["によって"],["、"],["わたしたち"],["に"],["対する","たいする"],["神","かみ"],["の"],["愛","あい"],["が"],["明か","あきらか"],["に"],["された"],["ので"],["ある"],["。"]]},{"verse":10,"text":"わたしたちが神,かみを愛,あいしたのではなく、神,かみがわたしたちを愛,あいして下,くださって、わたしたちの罪,つみのためにあがないの供,そなえ物,ものとして、御子,みこをおつかわしになった。ここに愛,あいがある。","tok":[["わたしたち"],["が"],["神","かみ"],["を"],["愛した","あいした"],["ので"],["は"],["なく"],["、"],["神","かみ"],["が"],["わたしたち"],["を"],["愛して","あいして"],["下さって","くださって"],["、"],["わたしたち"],["の"],["罪","つみ"],["の"],["ため"],["に"],["あがない"],["の"],["供え物","そなえもの"],["として"],["、"],["御子","みこ"],["を"],["おつかわし"],["に"],["なった"],["。"],["ここ"],["に"],["愛","あい"],["が"],["ある"],["。"]]},{"verse":11,"text":"愛,あいする者,ものたちよ。神,かみがこのようにわたしたちを愛,あいして下,くださったのであるから、わたしたちも互,たがいに愛,あいし合,あうべきである。","tok":[["愛する","あいする"],["者","もの"],["たち"],["よ"],["。"],["神","かみ"],["が"],["この"],["よう"],["に"],["わたしたち"],["を"],["愛して","あいして"],["下さった","くださった"],["ので"],["ある"],["から"],["、"],["わたしたち"],["も"],["互","たがい"],["に"],["愛し合うべきで","あいしあうべきで"],["ある"],["。"]]},{"verse":12,"text":"神,かみを見,みた者,ものは、まだひとりもいない。もしわたしたちが互,たがいに愛,あいし合,あうなら、神,かみはわたしたちのうちにいまし、神,かみの愛,あいがわたしたちのうちに全,まっとうされるのである。","tok":[["神","かみ"],["を"],["見た","みた"],["者","もの"],["は"],["、"],["まだ"],["ひとり"],["も"],["いない"],["。"],["もし"],["わたしたち"],["が"],["互","たがい"],["に"],["愛し合うなら","あいしあうなら"],["、"],["神","かみ"],["は"],["わたしたち"],["の"],["うち"],["に"],["いまし"],["、"],["神","かみ"],["の"],["愛","あい"],["が"],["わたしたち"],["の"],["うち"],["に"],["全う","まっとう"],["される"],["ので"],["ある"],["。"]]},{"verse":13,"text":"神,かみが御霊,みたまをわたしたちに賜,たまわったことによって、わたしたちが神,かみにおり、神,かみがわたしたちにいますことを知,しる。","tok":[["神","かみ"],["が"],["御霊","みたま"],["を"],["わたしたち"],["に"],["賜わった","たまわった"],["こと"],["によって"],["、"],["わたしたち"],["が"],["神","かみ"],["に"],["おり"],["、"],["神","かみ"],["が"],["わたしたち"],["に"],["います"],["こと"],["を"],["知る","しる"],["。"]]},{"verse":14,"text":"わたしたちは、父,ちちが御子,みこを世,よの救主,すくいぬしとしておつかわしになったのを見,みて、そのあかしをするのである。","tok":[["わたしたち"],["は"],["、"],["父","ちち"],["が"],["御子","みこ"],["を"],["世","よ"],["の"],["救主","すくいぬし"],["として"],["おつかわし"],["に"],["なった"],["の"],["を"],["見て","みて"],["、"],["その"],["あかし"],["を"],["する"],["ので"],["ある"],["。"]]},{"verse":15,"text":"もし人,ひとが、イエスを神,かみの子,こと告白,こくはくすれば、神,かみはその人,ひとのうちにいまし、その人,ひとは神,かみのうちにいるのである。","tok":[["もし"],["人","ひと"],["が"],["、"],["イエス"],["を"],["神","かみ"],["の"],["子","こ"],["と"],["告白","こくはく"],["すれば"],["、"],["神","かみ"],["は"],["その"],["人","ひと"],["の"],["うち"],["に"],["いまし"],["、"],["その"],["人","ひと"],["は"],["神","かみ"],["の"],["うち"],["に"],["いる"],["ので"],["ある"],["。"]]},{"verse":16,"text":"わたしたちは、神,かみがわたしたちに対,たいして持,もっておられる愛,あいを知,しり、かつ信,しんじている。神,かみは愛,あいである。愛,あいのうちにいる者,ものは、神,かみにおり、神,かみも彼,かれにいます。","tok":[["わたしたち"],["は"],["、"],["神","かみ"],["が"],["わたしたち"],["に対して","にたいして"],["持って","もって"],["おられる"],["愛","あい"],["を"],["知り","しり"],["、"],["かつ"],["信じて","しんじて"],["いる"],["。"],["神","かみ"],["は"],["愛","あい"],["で"],["ある"],["。"],["愛","あい"],["の"],["うち"],["に"],["いる"],["者","もの"],["は"],["、"],["神","かみ"],["に"],["おり"],["、"],["神","かみ"],["も"],["彼","かれ"],["に"],["います"],["。"]]},{"verse":17,"text":"わたしたちもこの世,よにあって彼,かれのように生,いきているので、さばきの日,ひに確信,かくしんを持,もって立,たつことができる。そのことによって、愛,あいがわたしたちに全,まっとうされているのである。","tok":[["わたしたち"],["も"],["この世","このよ"],["に"],["あって"],["彼","かれ"],["の"],["よう"],["に"],["生きて","いきて"],["いる"],["ので"],["、"],["さばき"],["の"],["日","ひ"],["に"],["確信","かくしん"],["を"],["持って","もって"],["立つ","たつ"],["こと"],["が"],["できる"],["。"],["その"],["こと"],["によって"],["、"],["愛","あい"],["が"],["わたしたち"],["に"],["全う","まっとう"],["されて"],["いる"],["ので"],["ある"],["。"]]},{"verse":18,"text":"愛,あいには恐,おそれがない。完全,かんぜんな愛,あいは恐,おそれをとり除,のぞく。恐,おそれには懲,こらしめが伴い、かつ恐,おそれる者,ものには、愛,あいが全,まっとうされていないからである。","tok":[["愛","あい"],["に"],["は"],["恐","おそれ"],["が"],["ない"],["。"],["完全","かんぜん"],["な"],["愛","あい"],["は"],["恐","おそれ"],["を"],["とり除く","とりのぞく"],["。"],["恐","おそれ"],["に"],["は"],["懲らしめ","こらしめ"],["が"],["伴い","ともない"],["、"],["かつ"],["恐れる","おそれる"],["者","もの"],["に"],["は"],["、"],["愛","あい"],["が"],["全う","まっとう"],["されて"],["いない"],["から"],["で"],["ある"],["。"]]},{"verse":19,"text":"わたしたちが愛,あいし合,あうのは、神,かみがまずわたしたちを愛,あいして下,くださったからである。","tok":[["わたしたち"],["が"],["愛し合う","あいしあう"],["の"],["は"],["、"],["神","かみ"],["が"],["まず"],["わたしたち"],["を"],["愛して","あいして"],["下さった","くださった"],["から"],["で"],["ある"],["。"]]},{"verse":20,"text":"「神,かみを愛,あいしている」と言,いいながら兄弟,きょうだいを憎,にくむ者,ものは、偽,いつわり者,ものである。現,げんに見,みている兄弟,きょうだいを愛,あいさない者,ものは、目,めに見,みえない神,かみを愛,あいすることはできない。","tok":[["「"],["神","かみ"],["を"],["愛して","あいして"],["いる"],["」"],["と"],["言い","いい"],["ながら"],["兄弟","きょうだい"],["を"],["憎む","にくむ"],["者","もの"],["は"],["、"],["偽わり","いつわり"],["者","もの"],["で"],["ある"],["。"],["現に","げんに"],["見て","みて"],["いる"],["兄弟","きょうだい"],["を"],["愛さない","あいさない"],["者","もの"],["は"],["、"],["目","め"],["に"],["見えない","みえない"],["神","かみ"],["を"],["愛する","あいする"],["こと"],["は"],["できない"],["。"]]},{"verse":21,"text":"神,かみを愛,あいする者,ものは、兄弟,きょうだいをも愛,あいすべきである。この戒,いましめを、わたしたちは神,かみから授,さずかっている。","tok":[["神","かみ"],["を"],["愛する","あいする"],["者","もの"],["は"],["、"],["兄弟","きょうだい"],["を"],["も"],["愛すべきで","あいすべきで"],["ある"],["。"],["この"],["戒しめ","いましめ"],["を"],["、"],["わたしたち"],["は"],["神","かみ"],["から"],["授かって","さずかって"],["いる"],["。"]]}]
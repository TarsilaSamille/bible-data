[{"verse":1,"text":"わたしの子,こたちよ。これらのことを書,かきおくるのは、あなたがたが罪,つみを犯,おかさないようになるためである。もし、罪,つみを犯,おかす者,ものがあれば、父,ちちのみもとには、わたしたちのために助,たすけ主,ぬし、すなわち、義,ぎなるイエス・キリストがおられる。","tok":[["わたし"],["の"],["子","こ"],["たち"],["よ"],["。"],["これ"],["ら"],["の"],["こと"],["を"],["書きおくる","かきおくる"],["の"],["は"],["、"],["あなた"],["がた"],["が"],["罪","つみ"],["を"],["犯さない","おかさない"],["よう"],["に"],["なる"],["ため"],["で"],["ある"],["。"],["もし"],["、"],["罪","つみ"],["を"],["犯す","おかす"],["者","もの"],["が"],["あれば"],["、"],["父","ちち"],["のみ"],["もと"],["に"],["は"],["、"],["わたしたち"],["の"],["ため"],["に"],["助け主","たすけぬし"],["、"],["すなわち"],["、"],["義","ぎ"],["なる"],["イエス"],["・"],["キリスト"],["が"],["おられる"],["。"]]},{"verse":2,"text":"彼,かれは、わたしたちの罪,つみのための、あがないの供,そなえ物,ものである。ただ、わたしたちの罪,つみのためばかりではなく、全,ぜん世界,せかいの罪,つみのためである。","tok":[["彼","かれ"],["は"],["、"],["わたしたち"],["の"],["罪","つみ"],["の"],["ため"],["の"],["、"],["あがない"],["の"],["供え物","そなえもの"],["で"],["ある"],["。"],["ただ"],["、"],["わたしたち"],["の"],["罪","つみ"],["の"],["ため"],["ばかり"],["で"],["は"],["なく"],["、"],["全","ぜん"],["世界","せかい"],["の"],["罪","つみ"],["の"],["ため"],["で"],["ある"],["。"]]},{"verse":3,"text":"もし、わたしたちが彼,かれの戒,いましめを守,まもるならば、それによって彼,かれを知,しっていることを悟,さとるのである。","tok":[["もし"],["、"],["わたしたち"],["が"],["彼","かれ"],["の"],["戒しめ","いましめ"],["を"],["守","まもる"],["ならば"],["、"],["それ"],["によって"],["彼","かれ"],["を"],["知って","しって"],["いる"],["こと"],["を"],["悟","さとる"],["ので"],["ある"],["。"]]},{"verse":4,"text":"「彼,かれを知,しっている」と言,いいながら、その戒,いましめを守,まもらない者,ものは、偽,いつわり者,ものであって、真理,しんりはその人,ひとのうちにない。","tok":[["「"],["彼","かれ"],["を"],["知って","しって"],["いる"],["」"],["と"],["言い","いい"],["ながら"],["、"],["その"],["戒しめ","いましめ"],["を"],["守らない","まもらない"],["者","もの"],["は"],["、"],["偽わり","いつわり"],["者","もの"],["で"],["あって"],["、"],["真理","しんり"],["は"],["その"],["人","ひと"],["の"],["うち"],["に"],["ない"],["。"]]},{"verse":5,"text":"しかし、彼,かれの御言,みことばを守,まもる者,ものがあれば、その人,ひとのうちに、神,かみの愛,あいが真,しんに全,まっとうされるのである。それによって、わたしたちが彼,かれにあることを知,しるのである。","tok":[["しかし"],["、"],["彼","かれ"],["の"],["御言","みこと"],["ば"],["を"],["守者","まもるもの"],["が"],["あれば"],["、"],["その"],["人","ひと"],["の"],["うち"],["に"],["、"],["神","かみ"],["の"],["愛","あい"],["が"],["真","しん"],["に"],["全う","まっとう"],["される"],["ので"],["ある"],["。"],["それ"],["によって"],["、"],["わたしたち"],["が"],["彼","かれ"],["に"],["ある"],["こと"],["を"],["知る","しる"],["ので"],["ある"],["。"]]},{"verse":6,"text":"「彼,かれにおる」と言,いう者,ものは、彼,かれが歩,あるかれたように、その人,ひと自身,じしんも歩,あるくべきである。","tok":[["「"],["彼","かれ"],["に"],["おる"],["」"],["と"],["言う","いう"],["者","もの"],["は"],["、"],["彼","かれ"],["が"],["歩かれた","あるかれた"],["よう"],["に"],["、"],["その"],["人","ひと"],["自身","じしん"],["も"],["歩くべきで","あるくべきで"],["ある"],["。"]]},{"verse":7,"text":"愛,あいする者,ものたちよ。わたしがあなたがたに書,かきおくるのは、新,あたらしい戒,いましめではなく、あなたがたが初,はじめから受,うけていた古,ふるい戒,いましめである。その古,ふるい戒,いましめとは、あなたがたがすでに聞,きいた御言,みことばである。","tok":[["愛する","あいする"],["者","もの"],["たち"],["よ"],["。"],["わたし"],["が"],["あなた"],["がた"],["に"],["書きおくる","かきおくる"],["の"],["は"],["、"],["新らしい","あたらしい"],["戒しめ","いましめ"],["で"],["は"],["なく"],["、"],["あなた"],["がた"],["が"],["初め","はじめ"],["から"],["受けて","うけて"],["いた"],["古い","ふるい"],["戒しめ","いましめ"],["で"],["ある"],["。"],["その"],["古い","ふるい"],["戒しめ","いましめ"],["と"],["は"],["、"],["あなた"],["がた"],["が"],["すでに"],["聞いた","きいた"],["御言","みこと"],["ば"],["で"],["ある"],["。"]]},{"verse":8,"text":"しかも、新,あたらしい戒,いましめを、あなたがたに書,かきおくるのである。そして、それは、彼,かれにとってもあなたがたにとっても、真理,しんりなのである。なぜなら、やみは過,すぎ去,さり、まことの光,ひかりがすでに輝,かがやいているからである。","tok":[["しかも"],["、"],["新らしい","あたらしい"],["戒しめ","いましめ"],["を"],["、"],["あなた"],["がた"],["に"],["書きおくる","かきおくる"],["ので"],["ある"],["。"],["そして"],["、"],["それ"],["は"],["、"],["彼","かれ"],["にとって"],["も"],["あなた"],["がた"],["にとって"],["も"],["、"],["真理","しんり"],["な"],["ので"],["ある"],["。"],["なぜ"],["なら"],["、"],["やみ"],["は"],["過去り","すぎさり"],["、"],["まこと"],["の"],["光","ひかり"],["が"],["すでに"],["輝やいて","かがやいて"],["いる"],["から"],["で"],["ある"],["。"]]},{"verse":9,"text":"「光,ひかりの中,なかにいる」と言,いいながら、その兄弟,きょうだいを憎,にくむ者,ものは、今,いまなお、やみの中,なかにいるのである。","tok":[["「"],["光","ひかり"],["の"],["中","なか"],["に"],["いる"],["」"],["と"],["言い","いい"],["ながら"],["、"],["その"],["兄弟","きょうだい"],["を"],["憎む","にくむ"],["者","もの"],["は"],["、"],["今","いま"],["なお"],["、"],["やみ"],["の"],["中","なか"],["に"],["いる"],["ので"],["ある"],["。"]]},{"verse":10,"text":"兄弟,きょうだいを愛,あいする者,ものは、光,ひかりにおるのであって、つまずくことはない。","tok":[["兄弟","きょうだい"],["を"],["愛する","あいする"],["者","もの"],["は"],["、"],["光","ひかり"],["に"],["おる"],["ので"],["あって"],["、"],["つまずく"],["こと"],["は"],["ない"],["。"]]},{"verse":11,"text":"兄弟,きょうだいを憎,にくむ者,ものは、やみの中,なかにおり、やみの中,なかを歩,あるくのであって、自分,じぶんではどこへ行,いくのかわからない。やみが彼,かれの目,めを見,みえなくしたからである。","tok":[["兄弟","きょうだい"],["を"],["憎む","にくむ"],["者","もの"],["は"],["、"],["やみ"],["の"],["中","なか"],["に"],["おり"],["、"],["やみ"],["の"],["中","なか"],["を"],["歩く","あるく"],["ので"],["あって"],["、"],["自分","じぶん"],["で"],["は"],["どこ"],["へ"],["行く","いく"],["の"],["か"],["わからない"],["。"],["やみ"],["が"],["彼","かれ"],["の"],["目","め"],["を"],["見えなく","みえなく"],["した"],["から"],["で"],["ある"],["。"]]},{"verse":12,"text":"子,こたちよ。あなたがたにこれを書,かきおくるのは、御名,みなのゆえに、あなたがたの多,おおくの罪,つみがゆるされたからである。","tok":[["子","こ"],["たち"],["よ"],["。"],["あなた"],["がた"],["に"],["これ"],["を"],["書きおくる","かきおくる"],["の"],["は"],["、"],["御名","みな"],["の"],["ゆえ"],["に"],["、"],["あなた"],["がた"],["の"],["多く","おおく"],["の"],["罪","つみ"],["が"],["ゆるされた"],["から"],["で"],["ある"],["。"]]},{"verse":13,"text":"父,ちちたちよ。あなたがたに書,かきおくるのは、あなたがたが、初,はじめからいますかたを知,しったからである。若者,わかものたちよ。あなたがたに書,かきおくるのは、あなたがたが、悪,あしき者,ものにうち勝,かったからである。","tok":[["父","ちち"],["たち"],["よ"],["。"],["あなた"],["がた"],["に"],["書きおくる","かきおくる"],["の"],["は"],["、"],["あなた"],["が"],["た"],["が"],["、"],["初め","はじめ"],["から"],["います"],["かた"],["を"],["知った","しった"],["から"],["で"],["ある"],["。"],["若者","わかもの"],["たち"],["よ"],["。"],["あなた"],["がた"],["に"],["書きおくる","かきおくる"],["の"],["は"],["、"],["あなた"],["が"],["た"],["が"],["、"],["悪しき","あしき"],["者","もの"],["に"],["うち勝った","うちかった"],["から"],["で"],["ある"],["。"]]},{"verse":14,"text":"子供,こどもたちよ。あなたがたに書,かきおくったのは、あなたがたが父,ちちを知,しったからである。父,ちちたちよ。あなたがたに書,かきおくったのは、あなたがたが、初,はじめからいますかたを知,しったからである。若者,わかものたちよ。あなたがたに書,かきおくったのは、あなたがたが強,つよい者,ものであり、神,かみの言,ことばがあなたがたに宿,やどり、そして、あなたがたが悪,あしき者,ものにうち勝,かったからである。","tok":[["子供","こども"],["たち"],["よ"],["。"],["あなた"],["がた"],["に"],["書きおくった","かきおくった"],["の"],["は"],["、"],["あなた"],["がた"],["が"],["父","ちち"],["を"],["知った","しった"],["から"],["で"],["ある"],["。"],["父","ちち"],["たち"],["よ"],["。"],["あなた"],["がた"],["に"],["書きおくった","かきおくった"],["の"],["は"],["、"],["あなた"],["が"],["た"],["が"],["、"],["初め","はじめ"],["から"],["います"],["かた"],["を"],["知った","しった"],["から"],["で"],["ある"],["。"],["若者","わかもの"],["たち"],["よ"],["。"],["あなた"],["がた"],["に"],["書きおくった","かきおくった"],["の"],["は"],["、"],["あなた"],["がた"],["が"],["強い","つよい"],["者","もの"],["で"],["あり"],["、"],["神","かみ"],["の"],["言","こ"],["と"],["ば"],["が"],["あなた"],["がた"],["に"],["宿り","やどり"],["、"],["そして"],["、"],["あなた"],["がた"],["が"],["悪しき","あしき"],["者","もの"],["に"],["うち勝った","うちかった"],["から"],["で"],["ある"],["。"]]},{"verse":15,"text":"世,よと世,よにあるものとを、愛,あいしてはいけない。もし、世,よを愛,あいする者,ものがあれば、父,ちちの愛,あいは彼,かれのうちにない。","tok":[["世","よ"],["と"],["世","よ"],["に"],["ある"],["もの"],["と"],["を"],["、"],["愛して","あいして"],["は"],["いけない"],["。"],["もし"],["、"],["世","よ"],["を"],["愛する","あいする"],["者","もの"],["が"],["あれば"],["、"],["父","ちち"],["の"],["愛","あい"],["は"],["彼","かれ"],["の"],["うち"],["に"],["ない"],["。"]]},{"verse":16,"text":"すべて世,よにあるもの、すなわち、肉,にくの欲,よく、目,めの欲,よく、持,もち物,ものの誇,ほこりは、父,ちちから出,でたものではなく、世,よから出,でたものである。","tok":[["すべて"],["世","よ"],["に"],["ある"],["もの"],["、"],["すなわち"],["、"],["肉","にく"],["の"],["欲","よく"],["、"],["目","め"],["の"],["欲","よく"],["、"],["持物","もちもの"],["の"],["誇","ほこり"],["は"],["、"],["父","ちち"],["から"],["出た","でた"],["もの"],["で"],["は"],["なく"],["、"],["世","よ"],["から"],["出た","でた"],["もの"],["で"],["ある"],["。"]]},{"verse":17,"text":"世,よと世,よの欲,よくとは過,すぎ去,さる。しかし、神,かみの御旨,みむねを行,おこなう者,ものは、永遠,えいえんにながらえる。","tok":[["世","よ"],["と"],["世","よ"],["の"],["欲","よく"],["と"],["は"],["過去る","すぎさる"],["。"],["しかし"],["、"],["神","かみ"],["の"],["御旨","みむね"],["を"],["行なう","おこなう"],["者","もの"],["は"],["、"],["永遠","えいえん"],["に"],["ながらえる"],["。"]]},{"verse":18,"text":"子供,こどもたちよ。今,いまは終,おわりの時,ときである。あなたがたがかねて反,はんキリストが来,くると聞,きいていたように、今,いまや多,おおくの反,はんキリストが現,あらわれてきた。それによって今,いまが終,おわりの時,ときであることを知,しる。","tok":[["子供","こども"],["たち"],["よ"],["。"],["今","いま"],["は"],["終","おわり"],["の"],["時","とき"],["で"],["ある"],["。"],["あなた"],["がた"],["が"],["かねて"],["反","はん"],["キリスト"],["が"],["来る","くる"],["と"],["聞いて","きいて"],["いた"],["よう"],["に"],["、"],["今","いま"],["や"],["多く","おおく"],["の"],["反","はん"],["キリスト"],["が"],["現われて","あらわれて"],["きた"],["。"],["それ"],["によって"],["今","いま"],["が"],["終","おわり"],["の"],["時","とき"],["で"],["ある"],["こと"],["を"],["知る","しる"],["。"]]},{"verse":19,"text":"彼,かれらはわたしたちから出,でて行,いった。しかし、彼,かれらはわたしたちに属,ぞくする者,ものではなかったのである。もし属,ぞくする者,ものであったなら、わたしたちと一緒,いっしょにとどまっていたであろう。しかし、出,でて行,いったのは、元来,がんらい、彼,かれらがみなわたしたちに属,ぞくさない者,ものであることが、明,あきらかにされるためである。","tok":[["彼","かれ"],["ら"],["は"],["わたしたち"],["から"],["出て","でて"],["行った","いった"],["。"],["しかし"],["、"],["彼","かれ"],["ら"],["は"],["わたしたち"],["に"],["属する","ぞくする"],["者","もの"],["で"],["は"],["なかった"],["ので"],["ある"],["。"],["もし"],["属する","ぞくする"],["者","もの"],["で"],["あったなら"],["、"],["わたしたち"],["と"],["一緒","いっしょ"],["に"],["とどまって"],["いたで"],["あろう"],["。"],["しかし"],["、"],["出て","でて"],["行った","いった"],["の"],["は"],["、"],["元来","がんらい"],["、"],["彼","かれ"],["ら"],["が"],["みな"],["わたしたち"],["に"],["属さない","ぞくさない"],["者","もの"],["で"],["ある"],["こと"],["が"],["、"],["明か","あきらか"],["に"],["される"],["ため"],["で"],["ある"],["。"]]},{"verse":20,"text":"しかし、あなたがたは聖,せいなる者,ものに油,あぶらを注,そそがれているので、あなたがたすべてが、そのことを知,しっている。","tok":[["しかし"],["、"],["あなた"],["がた"],["は"],["聖","せい"],["なる"],["者","もの"],["に"],["油","あぶら"],["を"],["注がれて","そそがれて"],["いる"],["ので"],["、"],["あなた"],["がた"],["すべて"],["が"],["、"],["その"],["こと"],["を"],["知って","しって"],["いる"],["。"]]},{"verse":21,"text":"わたしが書,かきおくったのは、あなたがたが真理,しんりを知,しらないからではなく、それを知,しっているからであり、また、すべての偽,いつわりは真理,しんりから出,でるものでないことを、知,しっているからである。","tok":[["わたし"],["が"],["書きおくった","かきおくった"],["の"],["は"],["、"],["あなた"],["がた"],["が"],["真理","しんり"],["を"],["知らない","しらない"],["から"],["で"],["は"],["なく"],["、"],["それ"],["を"],["知って","しって"],["いる"],["から"],["で"],["あり"],["、"],["また"],["、"],["すべて"],["の"],["偽わり","いつわり"],["は"],["真理","しんり"],["から"],["出る","でる"],["もの"],["で"],["ない"],["こと"],["を"],["、"],["知って","しって"],["いる"],["から"],["で"],["ある"],["。"]]},{"verse":22,"text":"偽,いつわり者,ものとは、だれであるか。イエスのキリストであることを否定,ひていする者,ものではないか。父,ちちと御子,みことを否定,ひていする者,ものは、反,はんキリストである。","tok":[["偽わり","いつわり"],["者","もの"],["と"],["は"],["、"],["だれ"],["で"],["ある"],["か"],["。"],["イエス"],["の"],["キリスト"],["で"],["ある"],["こと"],["を"],["否定","ひてい"],["する"],["者","もの"],["で"],["は"],["ない"],["か"],["。"],["父","ちち"],["と"],["御子","みこ"],["と"],["を"],["否定","ひてい"],["する"],["者","もの"],["は"],["、"],["反","はん"],["キリスト"],["で"],["ある"],["。"]]},{"verse":23,"text":"御子,みこを否定,ひていする者,ものは父,ちちを持,もたず、御子,みこを告白,こくはくする者,ものは、また父,ちちをも持,もつのである。","tok":[["御子","みこ"],["を"],["否定","ひてい"],["する"],["者","もの"],["は"],["父","ちち"],["を"],["持たず","もたず"],["、"],["御子","みこ"],["を"],["告白","こくはく"],["する"],["者","もの"],["は"],["、"],["また"],["父","ちち"],["を"],["も"],["持つ","もつ"],["ので"],["ある"],["。"]]},{"verse":24,"text":"初,はじめから聞,きいたことが、あなたがたのうちに、とどまるようにしなさい。初,はじめから聞,きいたことが、あなたがたのうちにとどまっておれば、あなたがたも御子,みこと父,ちちとのうちに、とどまることになる。","tok":[["初め","はじめ"],["から"],["聞いた","きいた"],["こと"],["が"],["、"],["あなた"],["がた"],["の"],["うち"],["に"],["、"],["とどまる"],["よう"],["に"],["し"],["なさい"],["。"],["初め","はじめ"],["から"],["聞いた","きいた"],["こと"],["が"],["、"],["あなた"],["がた"],["の"],["うち"],["に"],["とどまって"],["おれば"],["、"],["あなた"],["がた"],["も"],["御子","みこ"],["と"],["父","ちち"],["と"],["の"],["うち"],["に"],["、"],["とどまる"],["こと"],["に"],["なる"],["。"]]},{"verse":25,"text":"これが、彼,かれ自,みずからわたしたちに約束,やくそくされた約束,やくそくであって、すなわち、永遠,えいえんのいのちである。","tok":[["これ"],["が"],["、"],["彼","かれ"],["自から","みずから"],["わたしたち"],["に"],["約束","やくそく"],["された"],["約束","やくそく"],["で"],["あって"],["、"],["すなわち"],["、"],["永遠","えいえん"],["の"],["いのち"],["で"],["ある"],["。"]]},{"verse":26,"text":"わたしは、あなたがたを惑,まどわす者,ものたちについて、これらのことを書,かきおくった。","tok":[["わたし"],["は"],["、"],["あなた"],["がた"],["を"],["惑わす","まどわす"],["者","もの"],["たち"],["について"],["、"],["これ"],["ら"],["の"],["こと"],["を"],["書きおくった","かきおくった"],["。"]]},{"verse":27,"text":"あなたがたのうちには、キリストからいただいた油,あぶらがとどまっているので、だれにも教,おしえてもらう必要,ひつようはない。この油,あぶらが、すべてのことをあなたがたに教,おしえる。それはまことであって、偽,いつわりではないから、その油,あぶらが教,おしえたように、あなたがたは彼,かれのうちにとどまっていなさい。","tok":[["あなた"],["がた"],["の"],["うち"],["に"],["は"],["、"],["キリスト"],["から"],["いただいた"],["油","あぶら"],["が"],["とどまって"],["いる"],["ので"],["、"],["だれ"],["に"],["も"],["教えて","おしえて"],["もらう"],["必要","ひつよう"],["は"],["ない"],["。"],["この"],["油","あぶら"],["が"],["、"],["すべて"],["の"],["こと"],["を"],["あなた"],["がた"],["に"],["教える","おしえる"],["。"],["それ"],["は"],["まこと"],["で"],["あって"],["、"],["偽わりで","いつわりで"],["は"],["ない"],["から"],["、"],["その"],["油","あぶら"],["が"],["教えた","おしえた"],["よう"],["に"],["、"],["あなた"],["がた"],["は"],["彼","かれ"],["の"],["うち"],["に"],["とどまって"],["い"],["なさい"],["。"]]},{"verse":28,"text":"そこで、子,こたちよ。キリストのうちにとどまっていなさい。それは、彼,かれが現,あらわれる時,ときに、確信,かくしんを持,もち、その来臨,らいりんに際,さいして、みまえに恥,はじいることがないためである。","tok":[["そこ"],["で"],["、"],["子","こ"],["たち"],["よ"],["。"],["キリスト"],["の"],["うち"],["に"],["とどまって"],["い"],["なさい"],["。"],["それ"],["は"],["、"],["彼","かれ"],["が"],["現われる","あらわれる"],["時","とき"],["に"],["、"],["確信","かくしん"],["を"],["持","もち"],["、"],["その"],["来臨","らいりん"],["に"],["際して","さいして"],["、"],["みまえ"],["に"],["恥","はじ"],["いる"],["こと"],["が"],["ない"],["ため"],["で"],["ある"],["。"]]},{"verse":29,"text":"彼,かれの義,ぎなるかたであることがわかれば、義,ぎを行,おこなう者,ものはみな彼,かれから生,うまれたものであることを、知,しるであろう。","tok":[["彼","かれ"],["の"],["義","ぎ"],["なる"],["かた"],["で"],["ある"],["こと"],["が"],["わかれば"],["、"],["義","ぎ"],["を"],["行なう","おこなう"],["者","もの"],["は"],["みな"],["彼","かれ"],["から"],["生まれた","うまれた"],["もの"],["で"],["ある"],["こと"],["を"],["、"],["知るで","しるで"],["あろう"],["。"]]}]
[{"verse":1,"text":"初,はじめからあったもの、わたしたちが聞,きいたもの、目,めで見,みたもの、よく見,みて手,てでさわったもの、すなわち、いのちの言,ことばについて――","tok":[["初め","はじめ"],["から"],["あった"],["もの"],["、"],["わたしたち"],["が"],["聞いた","きいた"],["もの"],["、"],["目","め"],["で"],["見た","みた"],["もの"],["、"],["よく"],["見て","みて"],["手","て"],["で"],["さわった"],["もの"],["、"],["すなわち"],["、"],["いのち"],["の"],["言","ことば"],["について"],["―"],["―"]]},{"verse":2,"text":"このいのちが現,あらわれたので、この永遠,えいえんのいのちをわたしたちは見,みて、そのあかしをし、かつ、あなたがたに告,つげ知,しらせるのである。この永遠,えいえんのいのちは、父,ちちと共,ともにいましたが、今,いまやわたしたちに現,あらわれたものである――","tok":[["この"],["いのち"],["が"],["現われた","あらわれた"],["ので"],["、"],["この"],["永遠","えいえん"],["の"],["いのち"],["を"],["わたしたち"],["は"],["見て","みて"],["、"],["その"],["あかし"],["を"],["し"],["、"],["かつ"],["、"],["あなた"],["がた"],["に"],["告","つげ"],["知らせる","しらせる"],["ので"],["ある"],["。"],["この"],["永遠","えいえん"],["の"],["いのち"],["は"],["、"],["父","ちち"],["と"],["共","とも"],["に"],["いました"],["が"],["、"],["今","いま"],["や"],["わたしたち"],["に"],["現われた","あらわれた"],["もの"],["で"],["ある"],["―"],["―"]]},{"verse":3,"text":"すなわち、わたしたちが見,みたもの、聞,きいたものを、あなたがたにも告,つげ知,しらせる。それは、あなたがたも、わたしたちの交,まじわりにあずかるようになるためである。わたしたちの交,まじわりとは、父,ちちならびに御子,みこイエス・キリストとの交,まじわりのことである。","tok":[["すなわち"],["、"],["わたしたち"],["が"],["見た","みた"],["もの"],["、"],["聞いた","きいた"],["もの"],["を"],["、"],["あなた"],["がた"],["に"],["も"],["告","つげ"],["知らせる","しらせる"],["。"],["それ"],["は"],["、"],["あなた"],["がた"],["も"],["、"],["わたしたち"],["の"],["交じわり","まじわり"],["に"],["あずかる"],["よう"],["に"],["なる"],["ため"],["で"],["ある"],["。"],["わたしたち"],["の"],["交じわり","まじわり"],["と"],["は"],["、"],["父","ちち"],["ならび"],["に"],["御子","みこ"],["イエス"],["・"],["キリスト"],["と"],["の"],["交じわり","まじわり"],["の"],["こと"],["で"],["ある"],["。"]]},{"verse":4,"text":"これを書,かきおくるのは、わたしたちの喜,よろこびが満,みちあふれるためである。","tok":[["これ"],["を"],["書きおくる","かきおくる"],["の"],["は"],["、"],["わたしたち"],["の"],["喜こび","よろこび"],["が"],["満ちあふれる","みちあふれる"],["ため"],["で"],["ある"],["。"]]},{"verse":5,"text":"わたしたちがイエスから聞,きいて、あなたがたに伝,つたえるおとずれは、こうである。神,かみは光,ひかりであって、神,かみには少,すこしの暗,くらいところもない。","tok":[["わたしたち"],["が"],["イエス"],["から"],["聞いて","きいて"],["、"],["あなた"],["がた"],["に"],["伝える","つたえる"],["おとずれ"],["は"],["、"],["こう"],["で"],["ある"],["。"],["神","かみ"],["は"],["光","ひかり"],["で"],["あって"],["、"],["神","かみ"],["に"],["は"],["少し","すこし"],["の"],["暗い","くらい"],["ところ"],["も"],["ない"],["。"]]},{"verse":6,"text":"神,かみと交,まじわりをしていると言,いいながら、もし、やみの中,なかを歩,あるいているなら、わたしたちは偽,いつわっているのであって、真理,しんりを行,おこなっているのではない。","tok":[["神","かみ"],["と"],["交じわり","まじわり"],["を"],["して"],["いる"],["と"],["言い","いい"],["ながら"],["、"],["もし"],["、"],["やみ"],["の"],["中","なか"],["を"],["歩いて","あるいて"],["いるなら"],["、"],["わたしたち"],["は"],["偽わって","いつわって"],["いる"],["ので"],["あって"],["、"],["真理","しんり"],["を"],["行なって","おこなって"],["いる"],["ので"],["は"],["ない"],["。"]]},{"verse":7,"text":"しかし、神,かみが光,ひかりの中,なかにいますように、わたしたちも光,ひかりの中,なかを歩,あるくならば、わたしたちは互,たがいに交,まじわりをもち、そして、御子,みこイエスの血,ちが、すべての罪,つみからわたしたちをきよめるのである。","tok":[["しかし"],["、"],["神","かみ"],["が"],["光","ひかり"],["の"],["中","なか"],["に"],["います"],["よう"],["に"],["、"],["わたしたち"],["も"],["光","ひかり"],["の"],["中","なか"],["を"],["歩くならば","あるくならば"],["、"],["わたしたち"],["は"],["互","たがい"],["に"],["交じわり","まじわり"],["を"],["もち"],["、"],["そして"],["、"],["御子","みこ"],["イエス"],["の"],["血","ち"],["が"],["、"],["すべて"],["の"],["罪","つみ"],["から"],["わたしたち"],["を"],["きよめる"],["ので"],["ある"],["。"]]},{"verse":8,"text":"もし、罪,つみがないと言,いうなら、それは自分,じぶんを欺,あざむくことであって、真理,しんりはわたしたちのうちにない。","tok":[["もし"],["、"],["罪","つみ"],["が"],["ない"],["と"],["言","いうな"],["ら"],["、"],["それ"],["は"],["自分","じぶん"],["を"],["欺く","あざむく"],["こと"],["で"],["あって"],["、"],["真理","しんり"],["は"],["わたしたち"],["の"],["うち"],["に"],["ない"],["。"]]},{"verse":9,"text":"もし、わたしたちが自分,じぶんの罪,つみを告白,こくはくするならば、神,かみは真実,しんじつで正,ただしいかたであるから、その罪,つみをゆるし、すべての不義,ふぎからわたしたちをきよめて下,くださる。","tok":[["もし"],["、"],["わたしたち"],["が"],["自分","じぶん"],["の"],["罪","つみ"],["を"],["告白","こくはく"],["するならば"],["、"],["神","かみ"],["は"],["真実","しんじつ"],["で"],["正い","ただしい"],["かた"],["で"],["ある"],["から"],["、"],["その"],["罪","つみ"],["を"],["ゆるし"],["、"],["すべて"],["の"],["不義","ふぎ"],["から"],["わたしたち"],["を"],["きよめて"],["下さる","くださる"],["。"]]},{"verse":10,"text":"もし、罪,つみを犯,おかしたことがないと言,いうなら、それは神,かみを偽,いつわり者,ものとするのであって、神,かみの言,ことばはわたしたちのうちにない。","tok":[["もし"],["、"],["罪","つみ"],["を"],["犯した","おかした"],["こと"],["が"],["ない"],["と"],["言","いうな"],["ら"],["、"],["それ"],["は"],["神","かみ"],["を"],["偽わり","いつわり"],["者","もの"],["と"],["する"],["ので"],["あって"],["、"],["神","かみ"],["の"],["言","ことば"],["は"],["わたしたち"],["の"],["うち"],["に"],["ない"],["。"]]}]
[{"verse":1,"text":"わたしは彼,かれの怒,いかりのむちによって、悩,なやみにあった人,ひとである。","tok":[["わたし"],["は"],["彼","かれ"],["の"],["怒り","いかり"],["の"],["むち"],["によって"],["、"],["悩み","なやみ"],["に"],["あった"],["人","ひと"],["で"],["ある"],["。"]]},{"verse":2,"text":"彼,かれはわたしをかり立,たてて、光,ひかりのない暗,くらい中,なかを歩,あるかせ、","tok":[["彼","かれ"],["は"],["わたし"],["を"],["かり立てて","かりたてて"],["、"],["光","ひかり"],["の"],["ない"],["暗い","くらい"],["中","なか"],["を"],["歩かせ","あるかせ"],["、"]]},{"verse":3,"text":"まことにその手,てをしばしばかえて、ひねもすわたしを攻,せめられた。","tok":[["まこと"],["に"],["その"],["手","て"],["を"],["しばしば"],["かえて"],["、"],["ひねもす"],["わたし"],["を"],["攻められた","せめられた"],["。"]]},{"verse":4,"text":"彼,かれはわが肉,にくと皮,かわを衰,おとろえさせ、わが骨,ほねを砕,くだき、","tok":[["彼","かれ"],["は"],["わが"],["肉","にく"],["と"],["皮","かわ"],["を"],["衰えさせ","おとろえさせ"],["、"],["わが"],["骨","ほね"],["を"],["砕き","くだき"],["、"]]},{"verse":5,"text":"苦,くるしみと悩,なやみをもって、わたしを囲,かこみ、わたしを閉,とじこめ、","tok":[["苦しみ","くるしみ"],["と"],["悩み","なやみ"],["を"],["もって"],["、"],["わたし"],["を"],["囲み","かこみ"],["、"],["わたし"],["を"],["閉じこめ","とじこめ"],["、"]]},{"verse":6,"text":"遠,とおい昔,むかしに死,しんだ者,もののように、暗,くらい所,ところに住,すまわせられた。","tok":[["遠い","とおい"],["昔","むかし"],["に"],["死んだ","しんだ"],["者","もの"],["の"],["よう"],["に"],["、"],["暗い","くらい"],["所","ところ"],["に"],["住まわせられた","すまわせられた"],["。"]]},{"verse":7,"text":"彼,かれはわたしのまわりに、かきをめぐらして、出,でることのできないようにし、重,おもい鎖,くさりでわたしをつながれた。","tok":[["彼","かれ"],["は"],["わたし"],["の"],["まわり"],["に"],["、"],["かき"],["を"],["めぐらして"],["、"],["出る","でる"],["こと"],["の"],["できない"],["よう"],["に"],["し"],["、"],["重い","おもい"],["鎖","くさり"],["で"],["わたし"],["を"],["つながれた"],["。"]]},{"verse":8,"text":"わたしは叫,さけんで助,たすけを求,もとめたが、彼,かれはわたしの祈,いのりをしりぞけ、","tok":[["わたし"],["は"],["叫けんで","さけんで"],["助け","たすけ"],["を"],["求めた","もとめた"],["が"],["、"],["彼","かれ"],["は"],["わたし"],["の"],["祈","いのり"],["を"],["しりぞけ"],["、"]]},{"verse":9,"text":"切,きり石,いしをもって、わたしの行,いく道,みちをふさぎ、わたしの道筋,みちすじを曲,まげられた。","tok":[["切り石","きりいし"],["を"],["もって"],["、"],["わたし"],["の"],["行く","いく"],["道","みち"],["を"],["ふさぎ"],["、"],["わたし"],["の"],["道筋","みちすじ"],["を"],["曲げられた","まげられた"],["。"]]},{"verse":10,"text":"彼,かれはわたしに対,たいして待,まち伏,ぶせするくまのように、潜,ひそみ隠,かくれるししのように、","tok":[["彼","かれ"],["は"],["わたし"],["に対して","にたいして"],["待伏せ","まちぶせ"],["する"],["くま"],["の"],["よう"],["に"],["、"],["潜み隠れる","ひそみかくれる"],["しし"],["の"],["よう"],["に"],["、"]]},{"verse":11,"text":"わが道,みちを離,はなれさせ、わたしを引,ひき裂,さいて、見,みるかげもないみじめな者,ものとし、","tok":[["わが"],["道","みち"],["を"],["離れさせ","はなれさせ"],["、"],["わたし"],["を"],["引裂いて","ひきさいて"],["、"],["見る","みる"],["かげ"],["も"],["ない"],["みじめ"],["な"],["者","もの"],["と"],["し"],["、"]]},{"verse":12,"text":"その弓,ゆみを張,はって、わたしを矢,やの的,まとのようにされた。","tok":[["その"],["弓","ゆみ"],["を"],["張って","はって"],["、"],["わたし"],["を"],["矢","や"],["の"],["的","まと"],["の"],["よう"],["に"],["された"],["。"]]},{"verse":13,"text":"彼,かれはその箙,えびらの矢,やをわたしの心臓,しんぞうに打,うち込,こまれた。","tok":[["彼","かれ"],["は"],["その"],["箙","えびら"],["の"],["矢","や"],["を"],["わたし"],["の"],["心臓","しんぞう"],["に"],["打ち込まれた","うちこまれた"],["。"]]},{"verse":14,"text":"わたしはすべての民,たみの物笑,ものわらいとなり、ひねもす彼,かれらの歌,うたとなった。","tok":[["わたし"],["は"],["すべて"],["の"],["民","たみ"],["の"],["物","もの"],["笑","わらい"],["と"],["なり"],["、"],["ひねもす"],["彼","かれ"],["ら"],["の"],["歌","うた"],["と"],["なった"],["。"]]},{"verse":15,"text":"彼,かれはわたしを苦,にがい物,もので飽,あかせ、にがよもぎをわたしに飲,のませられた。","tok":[["彼","かれ"],["は"],["わたし"],["を"],["苦い","にがい"],["物","もの"],["で"],["飽かせ","あかせ"],["、"],["にがよもぎ"],["を"],["わたし"],["に"],["飲ませられた","のませられた"],["。"]]},{"verse":16,"text":"彼,かれは小石,こいしをもって、わたしの歯,はを砕,くだき、灰,はいの中,なかにわたしをころがされた。","tok":[["彼","かれ"],["は"],["小石","こいし"],["を"],["もって"],["、"],["わたし"],["の"],["歯","は"],["を"],["砕き","くだき"],["、"],["灰","はい"],["の"],["中","なか"],["に"],["わたし"],["を"],["ころがされた"],["。"]]},{"verse":17,"text":"わが魂,たましいは平和,へいわを失,うしない、わたしは幸福,こうふくを忘,わすれた。","tok":[["わが"],["魂","たましい"],["は"],["平和","へいわ"],["を"],["失ない","うしない"],["、"],["わたし"],["は"],["幸福","こうふく"],["を"],["忘た","わすれた"],["。"]]},{"verse":18,"text":"そこでわたしは言,いった、「わが栄,さかえはうせ去,さり、わたしが主,しゅに望,のぞむところのものもうせ去,さった」と。","tok":[["そこ"],["で"],["わたし"],["は"],["言った","いった"],["、"],["「"],["わが"],["栄","さかえ"],["は"],["うせ"],["去り","さり"],["、"],["わたし"],["が"],["主に","しゅに"],["望む","のぞむ"],["ところ"],["の"],["もの"],["も"],["うせ"],["去た","さった"],["」"],["と"],["。"]]},{"verse":19,"text":"どうか、わが悩,なやみと苦,くるしみ、にがよもぎと胆汁,たんじゅうとを心,こころに留,とめてください。","tok":[["どう"],["か"],["、"],["わが"],["悩み","なやみ"],["と"],["苦しみ","くるしみ"],["、"],["にがよもぎ"],["と"],["胆汁","たんじゅう"],["と"],["を"],["心","こころ"],["に"],["留","とめ"],["て"],["ください"],["。"]]},{"verse":20,"text":"わが魂,たましいは絶,たえずこれを思,おもって、わがうちにうなだれる。","tok":[["わが"],["魂","たましい"],["は"],["絶えず","たえず"],["これ"],["を"],["思って","おもって"],["、"],["わが"],["うち"],["に"],["うなだれる"],["。"]]},{"verse":21,"text":"しかし、わたしはこの事,ことを心,こころに思,おもい起,おこす。それゆえ、わたしは望,のぞみをいだく。","tok":[["しかし"],["、"],["わたし"],["は"],["この"],["事","こと"],["を"],["心","こころ"],["に"],["思い起こす","おもいおこす"],["。"],["それ"],["ゆえ"],["、"],["わたし"],["は"],["望み","のぞみ"],["を"],["いだく"],["。"]]},{"verse":22,"text":"主,しゅのいつくしみは絶,たえることがなく、そのあわれみは尽,つきることがない。","tok":[["主","しゅ"],["の"],["いつくしみ"],["は"],["絶える","たえる"],["こと"],["が"],["なく"],["、"],["その"],["あわれみ"],["は"],["尽る","つきる"],["こと"],["が"],["ない"],["。"]]},{"verse":23,"text":"これは朝,あさごとに新,あたらしく、あなたの真実,しんじつは大,おおきい。","tok":[["これ"],["は"],["朝","あさ"],["ごと"],["に"],["新らしく","あたらしく"],["、"],["あなた"],["の"],["真実","しんじつ"],["は"],["大きい","おおきい"],["。"]]},{"verse":24,"text":"わが魂,たましいは言,いう、「主,しゅはわたしの受,うくべき分,ぶんである、それゆえ、わたしは彼,かれを待,まち望,のぞむ」と。","tok":[["わが"],["魂","たましい"],["は"],["言う","いう"],["、"],["「"],["主","しゅ"],["は"],["わたし"],["の"],["受","う"],["くべき"],["分","ぶん"],["で"],["ある"],["、"],["それ"],["ゆえ"],["、"],["わたし"],["は"],["彼","かれ"],["を"],["待ち望む","まちのぞむ"],["」"],["と"],["。"]]},{"verse":25,"text":"主,しゅはおのれを待,まち望,のぞむ者,ものと、おのれを尋,たずね求,もとめる者,ものにむかって恵,めぐみふかい。","tok":[["主","しゅ"],["は"],["おのれ"],["を"],["待ち望む","まちのぞむ"],["者","もの"],["と"],["、"],["おのれ"],["を"],["尋ね求める","たずねもとめる"],["者","もの"],["に"],["むかって"],["恵","めぐみ"],["ふかい"],["。"]]},{"verse":26,"text":"主,しゅの救,すくいを静,しずかに待,まち望,のぞむことは、良,よいことである。","tok":[["主","しゅ"],["の"],["救い","すくい"],["を"],["静","しずか"],["に"],["待望む","まちのぞむ"],["こと"],["は"],["、"],["良い","よい"],["こと"],["で"],["ある"],["。"]]},{"verse":27,"text":"人,ひとが若,わかい時,ときにくびきを負,おうことは、良,よいことである。","tok":[["人","ひと"],["が"],["若い","わかい"],["時","とき"],["に"],["くびき"],["を"],["負う","おう"],["こと"],["は"],["、"],["良い","よい"],["こと"],["で"],["ある"],["。"]]},{"verse":28,"text":"主,しゅがこれを負,おわせられるとき、ひとりすわって黙,もくしているがよい。","tok":[["主","しゅがこれ"],["を"],["負わせられる","おわせられる"],["とき"],["、"],["ひとり"],["すわって"],["黙して","もくして"],["いる"],["が"],["よい"],["。"]]},{"verse":29,"text":"口,くちをちりにつけよ、あるいはなお望,のぞみがあるであろう。","tok":[["口","くち"],["を"],["ちり"],["に"],["つけよ"],["、"],["あるいは"],["なお"],["望み","のぞみ"],["が"],["あるで"],["あろう"],["。"]]},{"verse":30,"text":"おのれを撃,うつ者,ものにほおを向,むけ、満,みち足,たりるまでに、はずかしめを受,うけよ。","tok":[["おのれ"],["を"],["撃つ","うつ"],["者","もの"],["に"],["ほお"],["を"],["向け","むけ"],["、"],["満ち足りる","みちたりる"],["まで"],["に"],["、"],["はずかしめ"],["を"],["受よ","うけよ"],["。"]]},{"verse":31,"text":"主,しゅはとこしえにこのような人,ひとを捨,すてられないからである。","tok":[["主","しゅ"],["は"],["とこしえ"],["に"],["この"],["よう"],["な"],["人","ひと"],["を"],["捨てられない","すてられない"],["から"],["で"],["ある"],["。"]]},{"verse":32,"text":"彼,かれは悩,なやみを与,あたえられるが、そのいつくしみが豊,ゆたかなので、またあわれみをたれられる。","tok":[["彼","かれ"],["は"],["悩み","なやみ"],["を"],["与えられる","あたえられる"],["が"],["、"],["その"],["いつくしみ"],["が"],["豊","ゆたか"],["な"],["ので"],["、"],["また"],["あわれみ"],["を"],["たれられる"],["。"]]},{"verse":33,"text":"彼,かれは心,こころから人,ひとの子,こを苦,くるしめ悩,なやますことをされないからである。","tok":[["彼","かれ"],["は"],["心","こころ"],["から"],["人","ひと"],["の"],["子","こ"],["を"],["苦しめ","くるしめ"],["悩す","なやます"],["こと"],["を"],["されない"],["から"],["で"],["ある"],["。"]]},{"verse":34,"text":"地,ちのすべての捕,とらわれ人,びとを足,あしの下,したに踏,ふみにじり、","tok":[["地","ち"],["の"],["すべて"],["の"],["捕らわれ","とらわれ"],["人","びと"],["を"],["足","あし"],["の"],["下","した"],["に"],["踏みにじり","ふみにじり"],["、"]]},{"verse":35,"text":"いと高,たかき者,ものの前,まえに人,ひとの公義,こうぎをまげ、","tok":[["いと"],["高き","たかき"],["者","もの"],["の"],["前","まえ"],["に"],["人","ひと"],["の"],["公義","こうぎ"],["を"],["まげ"],["、"]]},{"verse":36,"text":"人,ひとの訴,うったえをくつがえすことは、主,しゅのよみせられないことである。","tok":[["人","ひと"],["の"],["訴","うったえ"],["を"],["くつがえす"],["こと"],["は"],["、"],["主","しゅ"],["の"],["よみせられない"],["こと"],["で"],["ある"],["。"]]},{"verse":37,"text":"主,しゅが命,めいじられたのでなければ、だれが命,めいじて、その事,ことの成,なったことがあるか。","tok":[["主","しゅ"],["が"],["命じられた","めいじられた"],["ので"],["なければ"],["、"],["だれ"],["が"],["命じて","めいじて"],["、"],["その"],["事","こと"],["の"],["成った","なった"],["こと"],["が"],["ある"],["か"],["。"]]},{"verse":38,"text":"災,わざわいもさいわいも、いと高,たかき者,ものの口,くちから出,でるではないか。","tok":[["災","わざわい"],["も"],["さいわい"],["も"],["、"],["いと"],["高き","たかき"],["者","もの"],["の"],["口","くち"],["から"],["出るで","でるで"],["は"],["ない"],["か"],["。"]]},{"verse":39,"text":"生,いける人,ひとはどうしてつぶやかねばならないのか、人,ひとは自分,じぶんの罪,つみの罰,ばっせられるのを、つぶやくことができようか。","tok":[["生ける","いける"],["人","ひと"],["は"],["どう"],["して"],["つぶやかねば"],["ならない"],["の"],["か"],["、"],["人","ひと"],["は"],["自分","じぶん"],["の"],["罪","つみ"],["の"],["罰せられる","ばっせられる"],["の"],["を"],["、"],["つぶやく"],["こと"],["が"],["できよう"],["か"],["。"]]},{"verse":40,"text":"われわれは、自分,じぶんの行,おこないを調,しらべ、かつ省,かえりみて、主,しゅに帰,かえろう。","tok":[["われわれ"],["は"],["、"],["自分","じぶん"],["の"],["行ない","おこない"],["を"],["調べ","しらべ"],["、"],["かつ"],["省りみて","かえりみて"],["、"],["主に","しゅに"],["帰えろう","かえろう"],["。"]]},{"verse":41,"text":"われわれは天,てんにいます神,かみにむかって、手,てと共,ともに心,こころをもあげよう。","tok":[["われわれ"],["は"],["天","てん"],["に"],["います"],["神","かみ"],["に"],["むかって"],["、"],["手","て"],["と"],["共","とも"],["に"],["心","こころ"],["を"],["も"],["あげよう"],["。"]]},{"verse":42,"text":"「わたしたちは罪,つみを犯,おかし、そむきました、あなたはおゆるしになりませんでした。","tok":[["「"],["わたしたち"],["は"],["罪","つみ"],["を"],["犯し","おかし"],["、"],["そむきました"],["、"],["あなた"],["は"],["おゆるし"],["に"],["なりませんでした"],["。"]]},{"verse":43,"text":"あなたは怒,いかりをもってご自分,じぶんをおおい、わたしたちを追,おい攻,せめ、殺,ころして、あわれまず、","tok":[["あなた"],["は"],["怒り","いかり"],["を"],["もって"],["ご自分","ごじぶん"],["を"],["おおい"],["、"],["わたしたち"],["を"],["追い","おい"],["攻め","せめ"],["、"],["殺ろして","ころして"],["、"],["あわれまず"],["、"]]},{"verse":44,"text":"また雲,くもをもってご自分,じぶんをおおい、祈,いのりを通,つうじないようにし、","tok":[["また"],["雲","くも"],["を"],["もって"],["ご自分","ごじぶん"],["を"],["おおい"],["、"],["祈","いのり"],["を"],["通じない","つうじない"],["よう"],["に"],["し"],["、"]]},{"verse":45,"text":"もろもろの民,たみの中,なかに、わたしたちをちりあくたとなさいました。","tok":[["もろもろ"],["の"],["民","たみ"],["の"],["中","なか"],["に"],["、"],["わたしたち"],["を"],["ちりあくた"],["と"],["なさいました"],["。"]]},{"verse":46,"text":"敵,てきはみなわたしたちをののしり、","tok":[["敵","てき"],["は"],["みな"],["わたしたち"],["を"],["ののしり"],["、"]]},{"verse":47,"text":"恐,おそれと落,おとし穴,あなと、荒廃,こうはいと滅亡,めつぼうとが、わたしたちに臨,のぞみました。","tok":[["恐","おそれ"],["と"],["落とし穴","おとしあな"],["と"],["、"],["荒廃","こうはい"],["と"],["滅亡","めつぼう"],["と"],["が"],["、"],["わたしたち"],["に"],["臨みました","のぞみました"],["。"]]},{"verse":48,"text":"わが民,たみの娘,むすめの滅,ほろびによって、わたしの目,めには涙,なみだの川,かわが流,ながれています。","tok":[["わが"],["民","たみ"],["の"],["娘","むすめ"],["の"],["滅び","ほろび"],["によって"],["、"],["わたし"],["の"],["目","め"],["に"],["は"],["涙","なみだ"],["の"],["川","かわ"],["が"],["流れて","ながれて"],["います"],["。"]]},{"verse":49,"text":"わが目,めは絶,たえず涙,なみだを注,そそぎ出,だして、やむことなく、","tok":[["わが"],["目","め"],["は"],["絶えず","たえず"],["涙","なみだ"],["を"],["注ぎ","そそぎ"],["出して","だして"],["、"],["やむ"],["こと"],["なく"],["、"]]},{"verse":50,"text":"主,しゅが天,てんから見,みおろして、顧,かえりみられる時,ときにまで及,およぶでしょう。","tok":[["主","しゅ"],["が"],["天","てん"],["から"],["見おろして","みおろして"],["、"],["顧られる","かえりみられる"],["時","とき"],["に"],["まで"],["及ぶでしょう","およぶでしょう"],["。"]]},{"verse":51,"text":"わが目,めはわが町,まちのすべての娘,むすめの最期,さいごのゆえに、わたしを痛,いたませます。","tok":[["わが"],["目","め"],["は"],["わが"],["町","まち"],["の"],["すべて"],["の"],["娘","むすめ"],["の"],["最期","さいご"],["の"],["ゆえ"],["に"],["、"],["わたし"],["を"],["痛ませます","いたませます"],["。"]]},{"verse":52,"text":"ゆえなくわたしに敵,てきする者,ものどもによって、わたしは鳥,とりのように追,おわれました。","tok":[["ゆえ"],["なく"],["わたし"],["に"],["敵する","てきする"],["者","もの"],["ども"],["によって"],["、"],["わたし"],["は"],["鳥","とり"],["の"],["よう"],["に"],["追われました","おわれました"],["。"]]},{"verse":53,"text":"彼,かれらは生,いきているわたしを穴,あなの中,なかに投,なげ入,いれ、わたしの上,うえに石,いしを投,なげつけました。","tok":[["彼","かれ"],["ら"],["は"],["生きて","いきて"],["いる"],["わたし"],["を"],["穴","あな"],["の"],["中","なか"],["に"],["投入れ","なげいれ"],["、"],["わたし"],["の"],["上","うえ"],["に"],["石","いし"],["を"],["投","なげ"],["つけました"],["。"]]},{"verse":54,"text":"水,みずはわたしの頭,あたまの上,うえにあふれ、わたしは『断,たち滅,ほろぼされた』と言,いいました。","tok":[["水","みず"],["は"],["わたし"],["の"],["頭","あたま"],["の"],["上","うえ"],["に"],["あふれ"],["、"],["わたし"],["は"],["『"],["断ち","たち"],["滅ぼされた","ほろぼされた"],["』"],["と"],["言いました","いいました"],["。"]]},{"verse":55,"text":"主,しゅよ、わたしは深,ふかい穴,あなからみ名,なを呼,よびました。","tok":[["主","しゅ"],["よ"],["、"],["わたし"],["は"],["深","ふ"],["かい"],["穴","あな"],["から"],["み名","みな"],["を"],["呼びました","よびました"],["。"]]},{"verse":56,"text":"あなたはわが声,こえを聞,きかれました、『わが嘆,なげきと叫,さけびに耳,みみをふさがないでください』。","tok":[["あなた"],["は"],["わが"],["声","こえ"],["を"],["聞かれました","きかれました"],["、"],["『"],["わが"],["嘆き","なげき"],["と"],["叫","さけび"],["に"],["耳","みみ"],["を"],["ふさがないで"],["ください"],["』"],["。"]]},{"verse":57,"text":"わたしがあなたに呼,よばわったとき、あなたは近寄,ちかよって、『恐,おそれるな』と言,いわれました。","tok":[["わたし"],["が"],["あなた"],["に"],["呼ばわった","よばわった"],["とき"],["、"],["あなた"],["は"],["近寄って","ちかよって"],["、"],["『"],["恐れる","おそれる"],["な"],["』"],["と"],["言われました","いわれました"],["。"]]},{"verse":58,"text":"主,しゅよ、あなたはわが訴,うったえを取,とりあげて、わたしの命,いのちをあがなわれました。","tok":[["主","しゅ"],["よ"],["、"],["あなた"],["は"],["わが"],["訴","うったえ"],["を"],["取","とり"],["あげて"],["、"],["わたし"],["の"],["命","いのち"],["を"],["あがなわれました"],["。"]]},{"verse":59,"text":"主,しゅよ、あなたはわたしがこうむった不義,ふぎをごらんになりました。わたしの訴,うったえをおさばきください。","tok":[["主","しゅ"],["よ"],["、"],["あなた"],["は"],["わたし"],["が"],["こうむった"],["不義","ふぎ"],["を"],["ごらん"],["に"],["なりました"],["。"],["わたし"],["の"],["訴","うったえ"],["を"],["おさばき"],["ください"],["。"]]},{"verse":60,"text":"あなたはわたしに対,たいする彼,かれらの報復,ほうふくと、陰謀,いんぼうとを、ことごとくごらんになりました。","tok":[["あなた"],["は"],["わたし"],["に"],["対する","たいする"],["彼","かれ"],["ら"],["の"],["報復","ほうふく"],["と"],["、"],["陰謀","いんぼう"],["と"],["を"],["、"],["ことごとく"],["ごらん"],["に"],["なりました"],["。"]]},{"verse":61,"text":"主,しゅよ、あなたはわたしに対,たいする彼,かれらのそしりと、陰謀,いんぼうとを、ことごとく聞,きかれました。","tok":[["主","しゅ"],["よ"],["、"],["あなた"],["は"],["わたし"],["に"],["対する","たいする"],["彼","かれ"],["ら"],["の"],["そしり"],["と"],["、"],["陰謀","いんぼう"],["と"],["を"],["、"],["ことごとく"],["聞かれました","きかれました"],["。"]]},{"verse":62,"text":"立,たってわたしに逆,さからう者,ものどものくちびると、その思,おもいは、ひねもすわたしを攻,せめています。","tok":[["立って","たって"],["わたし"],["に"],["逆らう","さからう"],["者","もの"],["ども"],["の"],["くちびる"],["と"],["、"],["その"],["思い","おもい"],["は"],["、"],["ひねもす"],["わたし"],["を"],["攻めて","せめて"],["います"],["。"]]},{"verse":63,"text":"どうか、彼,かれらのすわるをも、立,たつをも、みそなわしてください。わたしは彼,かれらの歌,うたとなっています。","tok":[["どう"],["か"],["、"],["彼","かれ"],["ら"],["の"],["すわる"],["を"],["も"],["、"],["立つ","たつ"],["を"],["も"],["、"],["みそ"],["なわ"],["して"],["ください"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["歌","うた"],["と"],["なって"],["います"],["。"]]},{"verse":64,"text":"主,しゅよ、彼,かれらの手,てのわざにしたがって、彼,かれらに報,むくい、","tok":[["主","しゅ"],["よ"],["、"],["彼","かれ"],["ら"],["の"],["手","て"],["の"],["わざ"],["に"],["したがって"],["、"],["彼","かれ"],["ら"],["に"],["報い","むくい"],["、"]]},{"verse":65,"text":"彼,かれらの心,こころをかたくなにし、あなたののろいを彼,かれらに注,そそいでください。","tok":[["彼","かれ"],["ら"],["の"],["心","こころ"],["を"],["かたくな"],["に"],["し"],["、"],["あなた"],["の"],["のろい"],["を"],["彼","かれ"],["ら"],["に"],["注いで","そそいで"],["ください"],["。"]]},{"verse":66,"text":"主,しゅよ、怒,いかりをもって彼,かれらを追,おい、天,あめが下,したから彼,かれらを滅,ほろぼしてください」。","tok":[["主","しゅ"],["よ"],["、"],["怒り","いかり"],["を"],["もって"],["彼","かれ"],["ら"],["を"],["追い","おい"],["、"],["天","あ"],["め"],["が"],["下","した"],["から"],["彼","かれ"],["ら"],["を"],["滅ぼして","ほろぼして"],["ください"],["」"],["。"]]}]
[{"verse":1,"text":"パリサイ人,びとのひとりで、その名,なをニコデモというユダヤ人,じんの指導者,しどうしゃがあった。","tok":[["パリサイ"],["人","びと"],["の"],["ひとり"],["で"],["、"],["その"],["名","な"],["を"],["ニコデモ"],["と"],["いう"],["ユダヤ人","ゆだやじん"],["の"],["指導者","しどうしゃ"],["が"],["あった"],["。"]]},{"verse":2,"text":"この人,ひとが夜,よるイエスのもとにきて言,いった、「先生,せんせい、わたしたちはあなたが神,かみからこられた教師,きょうしであることを知,しっています。神,かみがご一緒,いっしょでないなら、あなたがなさっておられるようなしるしは、だれにもできはしません」。","tok":[["この"],["人","ひと"],["が"],["夜","よる"],["イエス"],["の"],["もと"],["に"],["きて"],["言った","いった"],["、"],["「"],["先生","せんせい"],["、"],["わたしたち"],["は"],["あなた"],["が"],["神","かみ"],["から"],["こられた"],["教師","きょうし"],["で"],["ある"],["こと"],["を"],["知って","しって"],["います"],["。"],["神","かみ"],["が"],["ご一緒","ごいっしょ"],["で"],["ないなら"],["、"],["あなた"],["が"],["なさって"],["おられる"],["よう"],["な"],["しるし"],["は"],["、"],["だれ"],["に"],["も"],["でき"],["は"],["しません"],["」"],["。"]]},{"verse":3,"text":"イエスは答,こたえて言,いわれた、「よくよくあなたに言,いっておく。だれでも新,あたらしく生,うまれなければ、神,かみの国,くにを見,みることはできない」。","tok":[["イエス"],["は"],["答","こたえ"],["て"],["言われた","いわれた"],["、"],["「"],["よくよく"],["あなた"],["に"],["言って","いって"],["おく"],["。"],["だれ"],["で"],["も"],["新らしく","あたらしく"],["生まれなければ","うまれなければ"],["、"],["神","かみ"],["の"],["国","くに"],["を"],["見る","みる"],["こと"],["は"],["できない"],["」"],["。"]]},{"verse":4,"text":"ニコデモは言,いった、「人,ひとは年,としをとってから生,うまれることが、どうしてできますか。もう一度,いちど、母,ははの胎,たいにはいって生,うまれることができましょうか」。","tok":[["ニコデモ"],["は"],["言った","いった"],["、"],["「"],["人","ひと"],["は"],["年","とし"],["を"],["とって"],["から"],["生まれる","うまれる"],["こと"],["が"],["、"],["どう"],["して"],["できます"],["か"],["。"],["もう"],["一度","いちど"],["、"],["母","はは"],["の"],["胎","たい"],["に"],["はいって"],["生まれる","うまれる"],["こと"],["が"],["できましょう"],["か"],["」"],["。"]]},{"verse":5,"text":"イエスは答,こたえられた、「よくよくあなたに言,いっておく。だれでも、水,みずと霊,れいとから生,うまれなければ、神,かみの国,くににはいることはできない。","tok":[["イエス"],["は"],["答","こたえ"],["られた"],["、"],["「"],["よくよく"],["あなた"],["に"],["言って","いって"],["おく"],["。"],["だれ"],["で"],["も"],["、"],["水","みず"],["と"],["霊","れい"],["と"],["から"],["生まれなければ","うまれなければ"],["、"],["神","かみ"],["の"],["国","くに"],["に"],["はいる"],["こと"],["は"],["できない"],["。"]]},{"verse":6,"text":"肉,にくから生,うまれる者,ものは肉,にくであり、霊,れいから生,うまれる者,ものは霊,れいである。","tok":[["肉","にく"],["から"],["生まれる","うまれる"],["者","もの"],["は"],["肉","にく"],["で"],["あり"],["、"],["霊","れい"],["から"],["生まれる","うまれる"],["者","もの"],["は"],["霊","れい"],["で"],["ある"],["。"]]},{"verse":7,"text":"あなたがたは新,あたらしく生,うまれなければならないと、わたしが言,いったからとて、不思議,ふしぎに思,おもうには及,およばない。","tok":[["あなた"],["がた"],["は"],["新らしく","あたらしく"],["生まれなければ","うまれなければ"],["ならない"],["と"],["、"],["わたし"],["が"],["言った","いった"],["から"],["とて"],["、"],["不思議","ふしぎ"],["に"],["思","おもう"],["に"],["は"],["及ばない","およばない"],["。"]]},{"verse":8,"text":"風,かぜは思,おもいのままに吹,ふく。あなたはその音,おとを聞,きくが、それがどこからきて、どこへ行,いくかは知,しらない。霊,れいから生,うまれる者,ものもみな、それと同,おなじである」。","tok":[["風","かぜ"],["は"],["思い","おもい"],["の"],["まま"],["に"],["吹く","ふく"],["。"],["あなた"],["は"],["その"],["音","おと"],["を"],["聞く","きく"],["が"],["、"],["それ"],["が"],["どこ"],["から"],["きて"],["、"],["どこ"],["へ"],["行く","いく"],["か"],["は"],["知らない","しらない"],["。"],["霊","れい"],["から"],["生まれる","うまれる"],["者","もの"],["も"],["みな"],["、"],["それ"],["と"],["同じ","おなじ"],["で"],["ある"],["」"],["。"]]},{"verse":9,"text":"ニコデモはイエスに答,こたえて言,いった、「どうして、そんなことがあり得,えましょうか」。","tok":[["ニコデモ"],["は"],["イエス"],["に"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["どう"],["して"],["、"],["そんな"],["こと"],["が"],["あり"],["得ましょう","えましょう"],["か"],["」"],["。"]]},{"verse":10,"text":"イエスは彼,かれに答,こたえて言,いわれた、「あなたはイスラエルの教師,きょうしでありながら、これぐらいのことがわからないのか。","tok":[["イエス"],["は"],["彼","かれ"],["に"],["答","こたえ"],["て"],["言われた","いわれた"],["、"],["「"],["あなた"],["は"],["イスラエル"],["の"],["教師","きょうし"],["で"],["あり"],["ながら"],["、"],["これ"],["ぐらい"],["の"],["こと"],["が"],["わからない"],["の"],["か"],["。"]]},{"verse":11,"text":"よくよく言,いっておく。わたしたちは自分,じぶんの知,しっていることを語,かたり、また自分,じぶんの見,みたことをあかししているのに、あなたがたはわたしたちのあかしを受,うけいれない。","tok":[["よくよく"],["言って","いって"],["おく"],["。"],["わたしたち"],["は"],["自分","じぶん"],["の"],["知って","しって"],["いる"],["こと"],["を"],["語り","かたり"],["、"],["また"],["自分","じぶん"],["の"],["見た","みた"],["こと"],["を"],["あかし"],["して"],["いる"],["のに"],["、"],["あなた"],["がた"],["は"],["わたしたち"],["の"],["あかし"],["を"],["受","うけ"],["いれない"],["。"]]},{"verse":12,"text":"わたしが地上,ちじょうのことを語,かたっているのに、あなたがたが信,しんじないならば、天上,てんじょうのことを語,かたった場合,ばあい、どうしてそれを信,しんじるだろうか。","tok":[["わたし"],["が"],["地上","ちじょう"],["の"],["こと"],["を"],["語って","かたって"],["いる"],["のに"],["、"],["あなた"],["がた"],["が"],["信じないならば","しんじないならば"],["、"],["天上","てんじょう"],["の"],["こと"],["を"],["語った","かたった"],["場合","ばあい"],["、"],["どう"],["して"],["それ"],["を"],["信じるだろう","しんじるだろう"],["か"],["。"]]},{"verse":13,"text":"天,てんから下,くだってきた者,もの、すなわち人,ひとの子,このほかには、だれも天,てんに上,のぼった者,ものはない。","tok":[["天","てん"],["から"],["下って","くだって"],["きた"],["者","もの"],["、"],["すなわち"],["人","ひと"],["の"],["子","こ"],["の"],["ほか"],["に"],["は"],["、"],["だれ"],["も"],["天","てん"],["に"],["上った","のぼった"],["者","もの"],["は"],["ない"],["。"]]},{"verse":14,"text":"そして、ちょうどモーセが荒野,あらのでへびを上,あげたように、人,ひとの子,こもまた上,あげられなければならない。","tok":[["そして"],["、"],["ちょうど"],["モーセ"],["が"],["荒野","あらの"],["で"],["へび"],["を"],["上げた","あげた"],["よう"],["に"],["、"],["人","ひと"],["の"],["子","こ"],["も"],["また"],["上げられなければ","あげられなければ"],["ならない"],["。"]]},{"verse":15,"text":"それは彼,かれを信,しんじる者,ものが、すべて永遠,えいえんの命,いのちを得,えるためである」。","tok":[["それ"],["は"],["彼","かれ"],["を"],["信じる","しんじる"],["者","もの"],["が"],["、"],["すべて"],["永遠","えいえん"],["の"],["命","いのち"],["を"],["得る","える"],["ため"],["で"],["ある"],["」"],["。"]]},{"verse":16,"text":"神,かみはそのひとり子,こを賜,たまわったほどに、この世,よを愛,あいして下,くださった。それは御子,みこを信,しんじる者,ものがひとりも滅,ほろびないで、永遠,えいえんの命,いのちを得,えるためである。","tok":[["神","かみ"],["は"],["その"],["ひとり"],["子","こ"],["を"],["賜わった","たまわった"],["ほど"],["に"],["、"],["この世","このよ"],["を"],["愛して","あいして"],["下さった","くださった"],["。"],["それ"],["は"],["御子","みこ"],["を"],["信じる","しんじる"],["者","もの"],["が"],["ひとり"],["も"],["滅びないで","ほろびないで"],["、"],["永遠","えいえん"],["の"],["命","いのち"],["を"],["得る","える"],["ため"],["で"],["ある"],["。"]]},{"verse":17,"text":"神,かみが御子,みこを世,よにつかわされたのは、世,よをさばくためではなく、御子,みこによって、この世,よが救,すくわれるためである。","tok":[["神","かみ"],["が"],["御子","みこ"],["を"],["世","よ"],["に"],["つかわされた"],["の"],["は"],["、"],["世","よ"],["を"],["さばく"],["ため"],["で"],["は"],["なく"],["、"],["御子","みこ"],["によって"],["、"],["この世","このよ"],["が"],["救われる","すくわれる"],["ため"],["で"],["ある"],["。"]]},{"verse":18,"text":"彼,かれを信,しんじる者,ものは、さばかれない。信,しんじない者,ものは、すでにさばかれている。神,かみのひとり子,この名,なを信,しんじることをしないからである。","tok":[["彼","かれ"],["を"],["信じる","しんじる"],["者","もの"],["は"],["、"],["さばかれない"],["。"],["信じない","しんじない"],["者","もの"],["は"],["、"],["すでに"],["さばかれて"],["いる"],["。"],["神","かみ"],["の"],["ひとり"],["子","こ"],["の"],["名","な"],["を"],["信じる","しんじる"],["こと"],["を"],["しない"],["から"],["で"],["ある"],["。"]]},{"verse":19,"text":"そのさばきというのは、光,ひかりがこの世,よにきたのに、人々,ひとびとはそのおこないが悪,わるいために、光,ひかりよりもやみの方,ほうを愛,あいしたことである。","tok":[["その"],["さばき"],["と"],["いう"],["の"],["は"],["、"],["光","ひかり"],["が"],["この世","このよ"],["に"],["きた"],["のに"],["、"],["人々","ひとびと"],["は"],["その"],["おこない"],["が"],["悪い","わるい"],["ため"],["に"],["、"],["光","ひかり"],["より"],["も"],["やみ"],["の"],["方","ほう"],["を"],["愛した","あいした"],["こと"],["で"],["ある"],["。"]]},{"verse":20,"text":"悪,あくを行,おこなっている者,ものはみな光,ひかりを憎,にくむ。そして、そのおこないが明,あかるみに出,だされるのを恐,おそれて、光,ひかりにこようとはしない。","tok":[["悪","あく"],["を"],["行なって","おこなって"],["いる"],["者","もの"],["は"],["みな"],["光","ひかり"],["を"],["憎む","にくむ"],["。"],["そして"],["、"],["その"],["おこない"],["が"],["明かるみ","あかるみ"],["に"],["出される","だされる"],["の"],["を"],["恐れて","おそれて"],["、"],["光","ひかり"],["に"],["こよう"],["と"],["は"],["しない"],["。"]]},{"verse":21,"text":"しかし、真理,しんりを行,おこなっている者,ものは光,ひかりに来,くる。その人,ひとのおこないの、神,かみにあってなされたということが、明,あきらかにされるためである。","tok":[["しかし"],["、"],["真理","しんり"],["を"],["行なって","おこなって"],["いる"],["者","もの"],["は"],["光","ひかり"],["に"],["来る","くる"],["。"],["その"],["人","ひと"],["の"],["おこない"],["の"],["、"],["神","かみ"],["に"],["あって"],["なされた"],["と"],["いう"],["こと"],["が"],["、"],["明か","あきらか"],["に"],["される"],["ため"],["で"],["ある"],["。"]]},{"verse":22,"text":"こののち、イエスは弟子,でしたちとユダヤの地,ちに行,いき、彼,かれらと一緒,いっしょにそこに滞在,たいざいして、バプテスマを授,さづけておられた。","tok":[["この"],["のち"],["、"],["イエス"],["は"],["弟子","でし"],["たち"],["と"],["ユダヤ"],["の"],["地","ち"],["に"],["行き","いき"],["、"],["彼","かれ"],["ら"],["と"],["一緒","いっしょ"],["に"],["そこ"],["に"],["滞在","たいざい"],["して"],["、"],["バプテスマ"],["を"],["授","さ"],["づけて"],["おられた"],["。"]]},{"verse":23,"text":"ヨハネもサリムに近,ちかいアイノンで、バプテスマを授,さづけていた。そこには水,みずがたくさんあったからである。人々,ひとびとがぞくぞくとやってきてバプテスマを受,うけていた。","tok":[["ヨハネ"],["も"],["サリム"],["に"],["近い","ちかい"],["アイノン"],["で"],["、"],["バプテスマ"],["を"],["授","さ"],["づけて"],["いた"],["。"],["そこ"],["に"],["は"],["水","みず"],["が"],["たくさん"],["あった"],["から"],["で"],["ある"],["。"],["人々","ひとびと"],["が"],["ぞくぞく"],["と"],["やって"],["きて"],["バプテスマ"],["を"],["受て","うけて"],["いた"],["。"]]},{"verse":24,"text":"そのとき、ヨハネはまだ獄,ごくに入,いれられてはいなかった。","tok":[["その"],["とき"],["、"],["ヨハネ"],["は"],["まだ"],["獄","ごく"],["に"],["入れられて","いれられて"],["は"],["いなかった"],["。"]]},{"verse":25,"text":"ところが、ヨハネの弟子,でしたちとひとりのユダヤ人,じんとの間,あいだに、きよめのことで争論,そうろんが起,おこった。","tok":[["ところ"],["が"],["、"],["ヨハネ"],["の"],["弟子","でし"],["たち"],["と"],["ひとり"],["の"],["ユダヤ人","ゆだやじん"],["と"],["の"],["間","あいだ"],["に"],["、"],["きよめ"],["の"],["こと"],["で"],["争論","そうろん"],["が"],["起こった","おこった"],["。"]]},{"verse":26,"text":"そこで彼,かれらはヨハネのところにきて言,いった、「先生,せんせい、ごらん下,ください。ヨルダンの向,むこうであなたと一緒,いっしょにいたことがあり、そして、あなたがあかしをしておられたあのかたが、バプテスマを授,さづけており、皆,みなの者,ものが、そのかたのところへ出,でかけています」。","tok":[["そこ"],["で"],["彼","かれ"],["ら"],["は"],["ヨハネ"],["の"],["ところ"],["に"],["きて"],["言った","いった"],["、"],["「"],["先生","せんせい"],["、"],["ごらん"],["下さい","ください"],["。"],["ヨルダン"],["の"],["向こう","むこう"],["で"],["あなた"],["と"],["一緒","いっしょ"],["に"],["いた"],["こと"],["が"],["あり"],["、"],["そして"],["、"],["あなた"],["が"],["あかし"],["を"],["して"],["おられた"],["あの"],["かた"],["が"],["、"],["バプテスマ"],["を"],["授","さ"],["づけて"],["おり"],["、"],["皆","みな"],["の"],["者","もの"],["が"],["、"],["その"],["かた"],["の"],["ところ"],["へ"],["出かけて","でかけて"],["います"],["」"],["。"]]},{"verse":27,"text":"ヨハネは答,こたえて言,いった、「人,ひとは天,てんから与,あたえられなければ、何,なにものも受,うけることはできない。","tok":[["ヨハネ"],["は"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["人","ひと"],["は"],["天","てん"],["から"],["与えられなければ","あたえられなければ"],["、"],["何もの","なにもの"],["も"],["受る","うける"],["こと"],["は"],["できない"],["。"]]},{"verse":28,"text":"『わたしはキリストではなく、そのかたよりも先,さきにつかわされた者,ものである』と言,いったことをあかししてくれるのは、あなたがた自身,じしんである。","tok":[["『"],["わたし"],["は"],["キリスト"],["で"],["は"],["なく"],["、"],["その"],["かた"],["より"],["も"],["先","さき"],["に"],["つかわされた"],["者","もの"],["で"],["ある"],["』"],["と"],["言った","いった"],["こと"],["を"],["あかし"],["して"],["くれる"],["の"],["は"],["、"],["あなた"],["がた"],["自身","じしん"],["で"],["ある"],["。"]]},{"verse":29,"text":"花嫁,はなよめをもつ者,ものは花婿,はなむこである。花婿,はなむこの友人,ゆうじんは立,たって彼,かれの声,こえを聞,きき、その声,こえを聞,きいて大,おおいに喜,よろこぶ。こうして、この喜,よろこびはわたしに満,みち足,たりている。","tok":[["花嫁","はなよめ"],["を"],["もつ"],["者","もの"],["は"],["花婿","はなむこ"],["で"],["ある"],["。"],["花婿","はなむこ"],["の"],["友人","ゆうじん"],["は"],["立って","たって"],["彼","かれ"],["の"],["声","こえ"],["を"],["聞","きき"],["、"],["その"],["声","こえ"],["を"],["聞いて","きいて"],["大いに","おおいに"],["喜こぶ","よろこぶ"],["。"],["こう"],["して"],["、"],["この"],["喜こび","よろこび"],["は"],["わたし"],["に"],["満ち足りて","みちたりて"],["いる"],["。"]]},{"verse":30,"text":"彼,かれは必,かならず栄,さかえ、わたしは衰,おとろえる。","tok":[["彼","かれ"],["は"],["必","かならず"],["栄","さかえ"],["、"],["わたし"],["は"],["衰える","おとろえる"],["。"]]},{"verse":31,"text":"上,うえから来,くる者,ものは、すべてのものの上,うえにある。地,ちから出,でる者,ものは、地,ちに属,ぞくする者,ものであって、地,ちのことを語,かたる。天,てんから来,くる者,ものは、すべてのものの上,うえにある。","tok":[["上","うえ"],["から"],["来る","くる"],["者","もの"],["は"],["、"],["すべて"],["の"],["もの"],["の"],["上","うえ"],["に"],["ある"],["。"],["地","ち"],["から"],["出る","でる"],["者","もの"],["は"],["、"],["地","ち"],["に"],["属する","ぞくする"],["者","もの"],["で"],["あって"],["、"],["地","ち"],["の"],["こと"],["を"],["語る","かたる"],["。"],["天","てん"],["から"],["来る","くる"],["者","もの"],["は"],["、"],["すべて"],["の"],["もの"],["の"],["上","うえ"],["に"],["ある"],["。"]]},{"verse":32,"text":"彼,かれはその見,みたところ、聞,きいたところをあかししているが、だれもそのあかしを受,うけいれない。","tok":[["彼","かれ"],["は"],["その"],["見た","みた"],["ところ"],["、"],["聞いた","きいた"],["ところ"],["を"],["あかし"],["して"],["いる"],["が"],["、"],["だれ"],["も"],["その"],["あかし"],["を"],["受","うけ"],["いれない"],["。"]]},{"verse":33,"text":"しかし、そのあかしを受,うけいれる者,ものは、神,かみがまことであることを、たしかに認,みとめたのである。","tok":[["しかし"],["、"],["その"],["あかし"],["を"],["受","うけ"],["いれる"],["者","もの"],["は"],["、"],["神","かみ"],["が"],["まこと"],["で"],["ある"],["こと"],["を"],["、"],["たしか"],["に"],["認めた","みとめた"],["ので"],["ある"],["。"]]},{"verse":34,"text":"神,かみがおつかわしになったかたは、神,かみの言葉,ことばを語,かたる。神,かみは聖霊,せいれいを限,かぎりなく賜,たまうからである。","tok":[["神","かみ"],["が"],["おつかわし"],["に"],["なった"],["かた"],["は"],["、"],["神","かみ"],["の"],["言葉","ことば"],["を"],["語る","かたる"],["。"],["神","かみ"],["は"],["聖霊","せいれい"],["を"],["限","かぎり"],["なく"],["賜う","たまう"],["から"],["で"],["ある"],["。"]]},{"verse":35,"text":"父,ちちは御子,みこを愛,あいして、万物,ばんぶつをその手,てにお与,あたえになった。","tok":[["父","ちち"],["は"],["御子","みこ"],["を"],["愛して","あいして"],["、"],["万物","ばんぶつ"],["を"],["その"],["手","て"],["に"],["お"],["与","あたえ"],["に"],["なった"],["。"]]},{"verse":36,"text":"御子,みこを信,しんじる者,ものは永遠,えいえんの命,いのちをもつ。御子,みこに従,したがわない者,ものは、命,いのちにあずかることがないばかりか、神,かみの怒,いかりがその上,うえにとどまるのである」。","tok":[["御子","みこ"],["を"],["信じる","しんじる"],["者","もの"],["は"],["永遠","えいえん"],["の"],["命","いのち"],["を"],["もつ"],["。"],["御子","みこ"],["に"],["従わない","したがわない"],["者","もの"],["は"],["、"],["命","いのち"],["に"],["あずかる"],["こと"],["が"],["ない"],["ばかり"],["か"],["、"],["神","かみ"],["の"],["怒り","いかり"],["が"],["その"],["上","うえ"],["に"],["とどまる"],["ので"],["ある"],["」"],["。"]]}]
[{"verse":1,"text":"「あなたがたは、心,こころを騒,さわがせないがよい。神,かみを信,しんじ、またわたしを信,しんじなさい。","tok":[["「"],["あなた"],["がた"],["は"],["、"],["心","こころ"],["を"],["騒がせない","さわがせない"],["が"],["よい"],["。"],["神","かみ"],["を"],["信じ","しんじ"],["、"],["また"],["わたし"],["を"],["信じ","しんじ"],["なさい"],["。"]]},{"verse":2,"text":"わたしの父,ちちの家,いえには、すまいがたくさんある。もしなかったならば、わたしはそう言,いっておいたであろう。あなたがたのために、場所,ばしょを用意,よういしに行,いくのだから。","tok":[["わたし"],["の"],["父","ちち"],["の"],["家","いえ"],["に"],["は"],["、"],["すまい"],["が"],["たくさん"],["ある"],["。"],["も"],["しなかったならば"],["、"],["わたし"],["は"],["そう"],["言って","いって"],["おいたで"],["あろう"],["。"],["あなた"],["がた"],["の"],["ため"],["に"],["、"],["場所","ばしょ"],["を"],["用意","ようい"],["し"],["に"],["行く","いく"],["の"],["だ"],["から"],["。"]]},{"verse":3,"text":"そして、行,いって、場所,ばしょの用意,よういができたならば、またきて、あなたがたをわたしのところに迎,むかえよう。わたしのおる所,ところにあなたがたもおらせるためである。","tok":[["そして"],["、"],["行って","いって"],["、"],["場所","ばしょ"],["の"],["用意","ようい"],["が"],["できたならば"],["、"],["また"],["きて"],["、"],["あなた"],["がた"],["を"],["わたし"],["の"],["ところ"],["に"],["迎","むかえ"],["よう"],["。"],["わたし"],["の"],["おる"],["所","ところ"],["に"],["あなた"],["がた"],["も"],["おらせる"],["ため"],["で"],["ある"],["。"]]},{"verse":4,"text":"わたしがどこへ行,いくのか、その道,みちはあなたがたにわかっている」。","tok":[["わたし"],["が"],["どこ"],["へ"],["行く","いく"],["の"],["か"],["、"],["その"],["道","みち"],["は"],["あなた"],["がた"],["に"],["わかって"],["いる"],["」"],["。"]]},{"verse":5,"text":"トマスはイエスに言,いった、「主,しゅよ、どこへおいでになるのか、わたしたちにはわかりません。どうしてその道,みちがわかるでしょう」。","tok":[["トマス"],["は"],["イエス"],["に"],["言った","いった"],["、"],["「"],["主","しゅ"],["よ"],["、"],["どこ"],["へ"],["おいで"],["に"],["なる"],["の"],["か"],["、"],["わたしたち"],["に"],["は"],["わかりません"],["。"],["どう"],["して"],["その"],["道","みち"],["が"],["わかるでしょう"],["」"],["。"]]},{"verse":6,"text":"イエスは彼,かれに言,いわれた、「わたしは道,みちであり、真理,しんりであり、命,いのちである。だれでもわたしによらないでは、父,ちちのみもとに行,いくことはできない。","tok":[["イエス"],["は"],["彼","かれ"],["に"],["言われた","いわれた"],["、"],["「"],["わたし"],["は"],["道","みち"],["で"],["あり"],["、"],["真理","しんり"],["で"],["あり"],["、"],["命","いのち"],["で"],["ある"],["。"],["だれ"],["で"],["も"],["わたし"],["に"],["よらないで"],["は"],["、"],["父","ちち"],["のみ"],["もと"],["に"],["行く","いく"],["こと"],["は"],["できない"],["。"]]},{"verse":7,"text":"もしあなたがたがわたしを知,しっていたならば、わたしの父,ちちをも知,しったであろう。しかし、今,いまは父,ちちを知,しっており、またすでに父,ちちを見,みたのである」。","tok":[["もし"],["あなた"],["がた"],["が"],["わたし"],["を"],["知って","しって"],["いたならば"],["、"],["わたし"],["の"],["父","ちち"],["を"],["も"],["知ったで","しったで"],["あろう"],["。"],["しかし"],["、"],["今","いま"],["は"],["父","ちち"],["を"],["知って","しって"],["おり"],["、"],["また"],["すでに"],["父","ちち"],["を"],["見た","みた"],["ので"],["ある"],["」"],["。"]]},{"verse":8,"text":"ピリポはイエスに言,いった、「主,しゅよ、わたしたちに父,ちちを示,しめして下,ください。そうして下,くだされば、わたしたちは満足,まんぞくします」。","tok":[["ピリポ"],["は"],["イエス"],["に"],["言った","いった"],["、"],["「"],["主","しゅ"],["よ"],["、"],["わたしたち"],["に"],["父","ちち"],["を"],["示めして","しめして"],["下さい","ください"],["。"],["そう"],["して"],["下されば","くだされば"],["、"],["わたしたち"],["は"],["満足","まんぞく"],["します"],["」"],["。"]]},{"verse":9,"text":"イエスは彼,かれに言,いわれた、「ピリポよ、こんなに長,ながくあなたがたと一緒,いっしょにいるのに、わたしがわかっていないのか。わたしを見,みた者,ものは、父,ちちを見,みたのである。どうして、わたしたちに父,ちちを示,しめしてほしいと、言,いうのか。","tok":[["イエス"],["は"],["彼","かれ"],["に"],["言われた","いわれた"],["、"],["「"],["ピリポ"],["よ"],["、"],["こんな"],["に"],["長く","ながく"],["あなた"],["がた"],["と"],["一緒","いっしょ"],["に"],["いる"],["のに"],["、"],["わたし"],["が"],["わかって"],["いない"],["の"],["か"],["。"],["わたし"],["を"],["見た","みた"],["者","もの"],["は"],["、"],["父","ちち"],["を"],["見た","みた"],["ので"],["ある"],["。"],["どう"],["して"],["、"],["わたしたち"],["に"],["父","ちち"],["を"],["示めして","しめして"],["ほしい"],["と"],["、"],["言う","いう"],["の"],["か"],["。"]]},{"verse":10,"text":"わたしが父,ちちにおり、父,ちちがわたしにおられることをあなたは信,しんじないのか。わたしがあなたがたに話,はなしている言葉,ことばは、自分,じぶんから話,はなしているのではない。父,ちちがわたしのうちにおられて、みわざをなさっているのである。","tok":[["わたし"],["が"],["父","ちち"],["に"],["おり"],["、"],["父","ちち"],["が"],["わたし"],["に"],["おられる"],["こと"],["を"],["あなた"],["は"],["信じない","しんじない"],["の"],["か"],["。"],["わたし"],["が"],["あなた"],["がた"],["に"],["話","はなし"],["て"],["いる"],["言葉","ことば"],["は"],["、"],["自分","じぶん"],["から"],["話","はなし"],["て"],["いる"],["ので"],["は"],["ない"],["。"],["父","ちち"],["が"],["わたし"],["の"],["うち"],["に"],["おられて"],["、"],["みわざ"],["を"],["なさって"],["いる"],["ので"],["ある"],["。"]]},{"verse":11,"text":"わたしが父,ちちにおり、父,ちちがわたしにおられることを信,しんじなさい。もしそれが信,しんじられないならば、わざそのものによって信,しんじなさい。","tok":[["わたし"],["が"],["父","ちち"],["に"],["おり"],["、"],["父","ちち"],["が"],["わたし"],["に"],["おられる"],["こと"],["を"],["信じ","しんじ"],["なさい"],["。"],["もし"],["それ"],["が"],["信じられないならば","しんじられないならば"],["、"],["わざ"],["その"],["もの"],["によって"],["信じ","しんじ"],["なさい"],["。"]]},{"verse":12,"text":"よくよくあなたがたに言,いっておく。わたしを信,しんじる者,ものは、またわたしのしているわざをするであろう。そればかりか、もっと大,おおきいわざをするであろう。わたしが父,ちちのみもとに行,いくからである。","tok":[["よくよく"],["あなた"],["がた"],["に"],["言って","いって"],["おく"],["。"],["わたし"],["を"],["信じる","しんじる"],["者","もの"],["は"],["、"],["また"],["わたし"],["の"],["して"],["いる"],["わざ"],["を"],["するで"],["あろう"],["。"],["それ"],["ばかり"],["か"],["、"],["もっと"],["大きい","おおきい"],["わざ"],["を"],["するで"],["あろう"],["。"],["わたし"],["が"],["父","ちち"],["のみ"],["もと"],["に"],["行く","いく"],["から"],["で"],["ある"],["。"]]},{"verse":13,"text":"わたしの名,なによって願,ねがうことは、なんでもかなえてあげよう。父,ちちが子,こによって栄光,えいこうをお受,うけになるためである。","tok":[["わたし"],["の"],["名","な"],["によって"],["願う","ねがう"],["こと"],["は"],["、"],["なん"],["で"],["も"],["かなえて"],["あげよう"],["。"],["父","ちち"],["が"],["子","こ"],["によって"],["栄光","えいこう"],["を"],["お受け","おうけ"],["に"],["なる"],["ため"],["で"],["ある"],["。"]]},{"verse":14,"text":"何事,なにごとでもわたしの名,なによって願,ねがうならば、わたしはそれをかなえてあげよう。","tok":[["何事","なにごと"],["で"],["も"],["わたし"],["の"],["名","な"],["によって"],["願うならば","ねがうならば"],["、"],["わたし"],["は"],["それ"],["を"],["かなえて"],["あげよう"],["。"]]},{"verse":15,"text":"もしあなたがたがわたしを愛,あいするならば、わたしのいましめを守,まもるべきである。","tok":[["もし"],["あなた"],["がた"],["が"],["わたし"],["を"],["愛するならば","あいするならば"],["、"],["わたし"],["の"],["いましめ"],["を"],["守","まもる"],["べきで"],["ある"],["。"]]},{"verse":16,"text":"わたしは父,ちちにお願,ねがいしよう。そうすれば、父,ちちは別,べつに助,たすけ主,ぬしを送,おくって、いつまでもあなたがたと共,ともにおらせて下,くださるであろう。","tok":[["わたし"],["は"],["父","ちち"],["に"],["お願い","おねがい"],["しよう"],["。"],["そう"],["すれば"],["、"],["父","ちち"],["は"],["別","べつ"],["に"],["助け主","たすけぬし"],["を"],["送って","おくって"],["、"],["いつ"],["まで"],["も"],["あなた"],["がた"],["と"],["共","とも"],["に"],["おらせて"],["下さるで","くださるで"],["あろう"],["。"]]},{"verse":17,"text":"それは真理,しんりの御霊,みたまである。この世,よはそれを見,みようともせず、知,しろうともしないので、それを受,うけることができない。あなたがたはそれを知,しっている。なぜなら、それはあなたがたと共,ともにおり、またあなたがたのうちにいるからである。","tok":[["それ"],["は"],["真理","しんり"],["の"],["御霊","みた"],["まで"],["ある"],["。"],["この世","このよ"],["は"],["それ"],["を"],["見よう","みよう"],["と"],["も"],["せず"],["、"],["知ろう","しろう"],["と"],["も"],["しない"],["ので"],["、"],["それ"],["を"],["受る","うける"],["こと"],["が"],["できない"],["。"],["あなた"],["がた"],["は"],["それ"],["を"],["知って","しって"],["いる"],["。"],["なぜ"],["なら"],["、"],["それ"],["は"],["あなた"],["がた"],["と"],["共","とも"],["に"],["おり"],["、"],["また"],["あなた"],["がた"],["の"],["うち"],["に"],["いる"],["から"],["で"],["ある"],["。"]]},{"verse":18,"text":"わたしはあなたがたを捨,すてて孤児,こじとはしない。あなたがたのところに帰,かえって来,くる。","tok":[["わたし"],["は"],["あなた"],["がた"],["を"],["捨てて","すてて"],["孤児","こじ"],["と"],["は"],["しない"],["。"],["あなた"],["がた"],["の"],["ところ"],["に"],["帰えって","かえって"],["来る","くる"],["。"]]},{"verse":19,"text":"もうしばらくしたら、世,よはもはやわたしを見,みなくなるだろう。しかし、あなたがたはわたしを見,みる。わたしが生,いきるので、あなたがたも生,いきるからである。","tok":[["もう"],["しばらく"],["したら"],["、"],["世","よ"],["は"],["もはや"],["わたし"],["を"],["見なく","みなく"],["なるだろう"],["。"],["しかし"],["、"],["あなた"],["がた"],["は"],["わたし"],["を"],["見る","みる"],["。"],["わたし"],["が"],["生きる","いきる"],["ので"],["、"],["あなた"],["がた"],["も"],["生きる","いきる"],["から"],["で"],["ある"],["。"]]},{"verse":20,"text":"その日,ひには、わたしはわたしの父,ちちにおり、あなたがたはわたしにおり、また、わたしがあなたがたにおることが、わかるであろう。","tok":[["その"],["日","ひ"],["に"],["は"],["、"],["わたし"],["は"],["わたし"],["の"],["父","ちち"],["に"],["おり"],["、"],["あなた"],["がた"],["は"],["わたし"],["に"],["おり"],["、"],["また"],["、"],["わたし"],["が"],["あなた"],["がた"],["に"],["おる"],["こと"],["が"],["、"],["わかるで"],["あろう"],["。"]]},{"verse":21,"text":"わたしのいましめを心,こころにいだいてこれを守,まもる者,ものは、わたしを愛,あいする者,ものである。わたしを愛,あいする者,ものは、わたしの父,ちちに愛,あいされるであろう。わたしもその人,ひとを愛,あいし、その人,ひとにわたし自身,じしんをあらわすであろう」。","tok":[["わたし"],["の"],["いましめ"],["を"],["心","こころ"],["に"],["いだいて"],["これ"],["を"],["守者","まもるもの"],["は"],["、"],["わたし"],["を"],["愛する","あいする"],["者","もの"],["で"],["ある"],["。"],["わたし"],["を"],["愛する","あいする"],["者","もの"],["は"],["、"],["わたし"],["の"],["父","ちち"],["に"],["愛されるで","あいされるで"],["あろう"],["。"],["わたし"],["も"],["その"],["人","ひと"],["を"],["愛し","あいし"],["、"],["その"],["人","ひと"],["に"],["わたし"],["自身","じしん"],["を"],["あらわすで"],["あろう"],["」"],["。"]]},{"verse":22,"text":"イスカリオテでない方,ほうのユダがイエスに言,いった、「主,しゅよ、あなたご自身,じしんをわたしたちにあらわそうとして、世,よにはあらわそうとされないのはなぜですか」。","tok":[["イスカリオテ"],["で"],["ない"],["方","ほう"],["の"],["ユダ"],["が"],["イエス"],["に"],["言った","いった"],["、"],["「"],["主","しゅ"],["よ"],["、"],["あなた"],["ご自身","ごじしん"],["を"],["わたしたち"],["に"],["あらわそう"],["として"],["、"],["世","よ"],["に"],["は"],["あらわそう"],["と"],["されない"],["の"],["は"],["なぜ"],["です"],["か"],["」"],["。"]]},{"verse":23,"text":"イエスは彼,かれに答,こたえて言,いわれた、「もしだれでもわたしを愛,あいするならば、わたしの言葉,ことばを守,まもるであろう。そして、わたしの父,ちちはその人,ひとを愛,あいし、また、わたしたちはその人,ひとのところに行,いって、その人,ひとと一緒,いっしょに住,すむであろう。","tok":[["イエス"],["は"],["彼","かれ"],["に"],["答","こたえ"],["て"],["言われた","いわれた"],["、"],["「"],["もし"],["だれ"],["で"],["も"],["わたし"],["を"],["愛するならば","あいするならば"],["、"],["わたし"],["の"],["言葉","ことば"],["を"],["守","まもる"],["で"],["あろう"],["。"],["そして"],["、"],["わたし"],["の"],["父","ちち"],["は"],["その"],["人","ひと"],["を"],["愛し","あいし"],["、"],["また"],["、"],["わたしたち"],["は"],["その"],["人","ひと"],["の"],["ところ"],["に"],["行って","いって"],["、"],["その"],["人","ひと"],["と"],["一緒","いっしょ"],["に"],["住むで","すむで"],["あろう"],["。"]]},{"verse":24,"text":"わたしを愛,あいさない者,ものはわたしの言葉,ことばを守,まもらない。あなたがたが聞,きいている言葉,ことばは、わたしの言葉,ことばではなく、わたしをつかわされた父,ちちの言葉,ことばである。","tok":[["わたし"],["を"],["愛さない","あいさない"],["者","もの"],["は"],["わたし"],["の"],["言葉","ことば"],["を"],["守らない","まもらない"],["。"],["あなた"],["がた"],["が"],["聞いて","きいて"],["いる"],["言葉","ことば"],["は"],["、"],["わたし"],["の"],["言葉","ことば"],["で"],["は"],["なく"],["、"],["わたし"],["を"],["つかわされた"],["父","ちち"],["の"],["言葉","ことば"],["で"],["ある"],["。"]]},{"verse":25,"text":"これらのことは、あなたがたと一緒,いっしょにいた時,とき、すでに語,かたったことである。","tok":[["これ"],["ら"],["の"],["こと"],["は"],["、"],["あなた"],["がた"],["と"],["一緒","いっしょ"],["に"],["いた"],["時","とき"],["、"],["すでに"],["語った","かたった"],["こと"],["で"],["ある"],["。"]]},{"verse":26,"text":"しかし、助,たすけ主,ぬし、すなわち、父,ちちがわたしの名,なによってつかわされる聖霊,せいれいは、あなたがたにすべてのことを教,おしえ、またわたしが話,はなしておいたことを、ことごとく思,おもい起,おこさせるであろう。","tok":[["しかし"],["、"],["助け主","たすけぬし"],["、"],["すなわち"],["、"],["父","ちち"],["が"],["わたし"],["の"],["名","な"],["によって"],["つかわされる"],["聖霊","せいれい"],["は"],["、"],["あなた"],["がた"],["に"],["すべて"],["の"],["こと"],["を"],["教え","おしえ"],["、"],["また"],["わたし"],["が"],["話","はなし"],["て"],["おいた"],["こと"],["を"],["、"],["ことごとく"],["思い起こさせるで","おもいおこさせるで"],["あろう"],["。"]]},{"verse":27,"text":"わたしは平安,へいあんをあなたがたに残,のこして行,いく。わたしの平安,へいあんをあなたがたに与,あたえる。わたしが与,あたえるのは、世,よが与,あたえるようなものとは異,ことなる。あなたがたは心,こころを騒,さわがせるな、またおじけるな。","tok":[["わたし"],["は"],["平安","へいあん"],["を"],["あなた"],["がた"],["に"],["残して","のこして"],["行く","いく"],["。"],["わたし"],["の"],["平安","へいあん"],["を"],["あなた"],["がた"],["に"],["与える","あたえる"],["。"],["わたし"],["が"],["与える","あたえる"],["の"],["は"],["、"],["世","よ"],["が"],["与える","あたえる"],["よう"],["な"],["もの"],["と"],["は"],["異なる","ことなる"],["。"],["あなた"],["がた"],["は"],["心","こころ"],["を"],["騒がせる","さわがせる"],["な"],["、"],["また"],["おじける"],["な"],["。"]]},{"verse":28,"text":"『わたしは去,さって行,いくが、またあなたがたのところに帰,かえって来,くる』と、わたしが言,いったのを、あなたがたは聞,きいている。もしわたしを愛,あいしているなら、わたしが父,ちちのもとに行,いくのを喜,よろこんでくれるであろう。父,ちちがわたしより大,おおきいかたであるからである。","tok":[["『"],["わたし"],["は"],["去て","さって"],["行く","いく"],["が"],["、"],["また"],["あなた"],["がた"],["の"],["ところ"],["に"],["帰えって","かえって"],["来る","くる"],["』"],["と"],["、"],["わたし"],["が"],["言った","いった"],["の"],["を"],["、"],["あなた"],["がた"],["は"],["聞いて","きいて"],["いる"],["。"],["もし"],["わたし"],["を"],["愛して","あいして"],["いるなら"],["、"],["わたし"],["が"],["父","ちち"],["の"],["もと"],["に"],["行く","いく"],["の"],["を"],["喜こんで","よろこんで"],["くれるで"],["あろう"],["。"],["父","ちち"],["が"],["わたし"],["より"],["大きい","おおきい"],["かた"],["で"],["ある"],["から"],["で"],["ある"],["。"]]},{"verse":29,"text":"今,いまわたしは、そのことが起,おこらない先,さきにあなたがたに語,かたった。それは、事,ことが起,おこった時,ときにあなたがたが信,しんじるためである。","tok":[["今","いま"],["わたし"],["は"],["、"],["その"],["こと"],["が"],["起こらない","おこらない"],["先","さき"],["に"],["あなた"],["がた"],["に"],["語った","かたった"],["。"],["それ"],["は"],["、"],["事","こと"],["が"],["起こった","おこった"],["時","とき"],["に"],["あなた"],["がた"],["が"],["信じる","しんじる"],["ため"],["で"],["ある"],["。"]]},{"verse":30,"text":"わたしはもはや、あなたがたに、多,おおくを語,かたるまい。この世,よの君,きみが来,くるからである。だが、彼,かれはわたしに対,たいして、なんの力,ちからもない。","tok":[["わたし"],["は"],["もはや"],["、"],["あなた"],["がた"],["に"],["、"],["多く","おおく"],["を"],["語るまい","かたるまい"],["。"],["この世","このよ"],["の"],["君","きみ"],["が"],["来る","くる"],["から"],["で"],["ある"],["。"],["だ"],["が"],["、"],["彼","かれ"],["は"],["わたし"],["に対して","にたいして"],["、"],["なん"],["の"],["力","ちから"],["も"],["ない"],["。"]]},{"verse":31,"text":"しかし、わたしが父,ちちを愛,あいしていることを世,よが知,しるように、わたしは父,ちちがお命,めいじになったとおりのことを行,おこなうのである。立,たて。さあ、ここから出,でかけて行,いこう。","tok":[["しかし"],["、"],["わたし"],["が"],["父","ちち"],["を"],["愛して","あいして"],["いる"],["こと"],["を"],["世","よ"],["が"],["知る","しる"],["よう"],["に"],["、"],["わたし"],["は"],["父","ちち"],["が"],["お命じ","おめいじ"],["に"],["なった"],["とおり"],["の"],["こと"],["を"],["行なう","おこなう"],["ので"],["ある"],["。"],["立","たて"],["。"],["さあ"],["、"],["ここ"],["から"],["出かけて","でかけて"],["行こう","いこう"],["。"]]}]
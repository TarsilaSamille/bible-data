[{"verse":1,"text":"イエスが、ヨハネよりも多,おおく弟子,でしをつくり、またバプテスマを授,さづけておられるということを、パリサイ人,びとたちが聞,きき、それを主,しゅが知,しられたとき、","tok":[["イエス"],["が"],["、"],["ヨハネ"],["より"],["も"],["多く","おおく"],["弟子","でし"],["を"],["つくり"],["、"],["また"],["バプテスマ"],["を"],["授","さ"],["づけて"],["おられる"],["と"],["いう"],["こと"],["を"],["、"],["パリサイ"],["人","びと"],["たち"],["が"],["聞","きき"],["、"],["それ"],["を"],["主","しゅ"],["が"],["知られた","しられた"],["とき"],["、"]]},{"verse":2,"text":"（しかし、イエスみずからが、バプテスマをお授,さづけになったのではなく、その弟子,でしたちであった）","tok":[["（"],["しかし"],["、"],["イエス"],["みずから"],["が"],["、"],["バプテスマ"],["を"],["お"],["授","さづけ"],["に"],["なった"],["ので"],["は"],["なく"],["、"],["その"],["弟子","でし"],["たち"],["で"],["あった"],["）"]]},{"verse":3,"text":"ユダヤを去,さって、またガリラヤへ行,いかれた。","tok":[["ユダヤ"],["を"],["去て","さって"],["、"],["また"],["ガリラヤ"],["へ"],["行かれた","いかれた"],["。"]]},{"verse":4,"text":"しかし、イエスはサマリヤを通過,つうかしなければならなかった。","tok":[["しかし"],["、"],["イエス"],["は"],["サマリヤ"],["を"],["通過","つうか"],["しなければ"],["ならなかった"],["。"]]},{"verse":5,"text":"そこで、イエスはサマリヤのスカルという町,まちにおいでになった。この町,まちは、ヤコブがその子,こヨセフに与,あたえた土地,とちの近,ちかくにあったが、","tok":[["そこ"],["で"],["、"],["イエス"],["は"],["サマリヤ"],["の"],["スカル"],["と"],["いう"],["町","まち"],["に"],["おいで"],["に"],["なった"],["。"],["この"],["町","まち"],["は"],["、"],["ヤコブ"],["が"],["その"],["子","こ"],["ヨセフ"],["に"],["与","あたえ"],["た"],["土地","とち"],["の"],["近く","ちかく"],["に"],["あった"],["が"],["、"]]},{"verse":6,"text":"そこにヤコブの井戸,いどがあった。イエスは旅,たびの疲,つかれを覚,おぼえて、そのまま、この井戸,いどのそばにすわっておられた。時,ときは昼,ひるの十二時,じごろであった。","tok":[["そこ"],["に"],["ヤコブ"],["の"],["井戸","いど"],["が"],["あった"],["。"],["イエス"],["は"],["旅","たび"],["の"],["疲れ","つかれ"],["を"],["覚えて","おぼえて"],["、"],["そのまま"],["、"],["この"],["井戸","いど"],["の"],["そば"],["に"],["すわって"],["おられた"],["。"],["時","とき"],["は"],["昼","ひる"],["の"],["十二","じゅうに"],["時","じ"],["ごろ"],["で"],["あった"],["。"]]},{"verse":7,"text":"ひとりのサマリヤの女,おんなが水,みずをくみにきたので、イエスはこの女,おんなに、「水,みずを飲,のませて下,ください」と言,いわれた。","tok":[["ひとり"],["の"],["サマリヤ"],["の"],["女","おんな"],["が"],["水","みず"],["を"],["くみ"],["に"],["きた"],["ので"],["、"],["イエス"],["は"],["この"],["女","おんな"],["に"],["、"],["「"],["水","みず"],["を"],["飲ませて","のませて"],["下さい","ください"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":8,"text":"弟子,でしたちは食物,しょくもつを買,かいに町,まちに行,いっていたのである。","tok":[["弟子","でし"],["たち"],["は"],["食物","しょくもつ"],["を"],["買","かい"],["に"],["町","まち"],["に"],["行って","いって"],["いた"],["ので"],["ある"],["。"]]},{"verse":9,"text":"すると、サマリヤの女,おんなはイエスに言,いった、「あなたはユダヤ人,じんでありながら、どうしてサマリヤの女,おんなのわたしに、飲,のませてくれとおっしゃるのですか」。これは、ユダヤ人,じんはサマリヤ人,びとと交際,こうさいしていなかったからである。","tok":[["する"],["と"],["、"],["サマリヤ"],["の"],["女","おんな"],["は"],["イエス"],["に"],["言った","いった"],["、"],["「"],["あなた"],["は"],["ユダヤ人","ゆだやじん"],["で"],["あり"],["ながら"],["、"],["どう"],["して"],["サマリヤ"],["の"],["女","おんな"],["の"],["わたし"],["に"],["、"],["飲ませて","のませて"],["くれ"],["と"],["おっしゃる"],["の"],["です"],["か"],["」"],["。"],["これ"],["は"],["、"],["ユダヤ人","ゆだやじん"],["は"],["サマリヤ"],["人","び"],["と"],["と"],["交際","こうさい"],["して"],["いなかった"],["から"],["で"],["ある"],["。"]]},{"verse":10,"text":"イエスは答,こたえて言,いわれた、「もしあなたが神,かみの賜物,たまもののことを知,しり、また、『水,みずを飲,のませてくれ』と言,いった者,ものが、だれであるか知,しっていたならば、あなたの方,ほうから願,ねがい出,でて、その人,ひとから生,いける水,みずをもらったことであろう」。","tok":[["イエス"],["は"],["答","こたえ"],["て"],["言われた","いわれた"],["、"],["「"],["もし"],["あなた"],["が"],["神","かみ"],["の"],["賜物","たまもの"],["の"],["こと"],["を"],["知り","しり"],["、"],["また"],["、"],["『"],["水","みず"],["を"],["飲ませて","のませて"],["くれ"],["』"],["と"],["言った","いった"],["者","もの"],["が"],["、"],["だれ"],["で"],["ある"],["か"],["知って","しって"],["いたならば"],["、"],["あなた"],["の"],["方","ほう"],["から"],["願い出て","ねがいでて"],["、"],["その"],["人","ひと"],["から"],["生ける","いける"],["水","みず"],["を"],["もらった"],["こと"],["で"],["あろう"],["」"],["。"]]},{"verse":11,"text":"女,おんなはイエスに言,いった、「主,しゅよ、あなたは、くむ物,ものをお持,もちにならず、その上,うえ、井戸,いどは深,ふかいのです。その生,いける水,みずを、どこから手,てに入,いれるのですか。","tok":[["女","おんな"],["は"],["イエス"],["に"],["言った","いった"],["、"],["「"],["主","しゅ"],["よ"],["、"],["あなた"],["は"],["、"],["くむ"],["物","もの"],["を"],["お持","おもち"],["に"],["ならず"],["、"],["その"],["上","うえ"],["、"],["井戸","いど"],["は"],["深い","ふかい"],["の"],["です"],["。"],["その"],["生ける","いける"],["水","みず"],["を"],["、"],["どこ"],["から"],["手","て"],["に"],["入れる","いれる"],["の"],["です"],["か"],["。"]]},{"verse":12,"text":"あなたは、この井戸,いどを下,くださったわたしたちの父,ちちヤコブよりも、偉,えらいかたなのですか。ヤコブ自身,じしんも飲,のみ、その子,こらも、その家畜,かちくも、この井戸,いどから飲,のんだのですが」。","tok":[["あなた"],["は"],["、"],["この"],["井戸","いど"],["を"],["下さった","くださった"],["わたしたち"],["の"],["父","ちち"],["ヤコブ"],["より"],["も"],["、"],["偉い","えらい"],["かた"],["な"],["の"],["です"],["か"],["。"],["ヤコブ"],["自身","じしん"],["も"],["飲み","のみ"],["、"],["その"],["子","こ"],["ら"],["も"],["、"],["その"],["家畜","かちく"],["も"],["、"],["この"],["井戸","いど"],["から"],["飲","のんだ"],["の"],["です"],["が"],["」"],["。"]]},{"verse":13,"text":"イエスは女,おんなに答,こたえて言,いわれた、「この水,みずを飲,のむ者,ものはだれでも、またかわくであろう。","tok":[["イエス"],["は"],["女","おんな"],["に"],["答","こたえ"],["て"],["言われた","いわれた"],["、"],["「"],["この"],["水","みず"],["を"],["飲む","のむ"],["者","もの"],["は"],["だれ"],["で"],["も"],["、"],["また"],["かわくで"],["あろう"],["。"]]},{"verse":14,"text":"しかし、わたしが与,あたえる水,みずを飲,のむ者,ものは、いつまでも、かわくことがないばかりか、わたしが与,あたえる水,みずは、その人,ひとのうちで泉,いずみとなり、永遠,えいえんの命,いのちに至,いたる水,みずが、わきあがるであろう」。","tok":[["しかし"],["、"],["わたし"],["が"],["与える","あたえる"],["水","みず"],["を"],["飲む","のむ"],["者","もの"],["は"],["、"],["いつ"],["まで"],["も"],["、"],["かわく"],["こと"],["が"],["ない"],["ばかり"],["か"],["、"],["わたし"],["が"],["与える","あたえる"],["水","みず"],["は"],["、"],["その"],["人","ひと"],["の"],["うち"],["で"],["泉","いずみ"],["と"],["なり"],["、"],["永遠","えいえん"],["の"],["命","いのち"],["に"],["至る","いたる"],["水","みず"],["が"],["、"],["わきあがるで"],["あろう"],["」"],["。"]]},{"verse":15,"text":"女,おんなはイエスに言,いった、「主,しゅよ、わたしがかわくことがなく、また、ここにくみにこなくてもよいように、その水,みずをわたしに下,ください」。","tok":[["女","おんな"],["は"],["イエス"],["に"],["言った","いった"],["、"],["「"],["主","しゅ"],["よ"],["、"],["わたし"],["が"],["かわく"],["こと"],["が"],["なく"],["、"],["また"],["、"],["ここ"],["に"],["くみ"],["に"],["こなくて"],["も"],["よい"],["よう"],["に"],["、"],["その"],["水","みず"],["を"],["わたし"],["に"],["下さい","ください"],["」"],["。"]]},{"verse":16,"text":"イエスは女,おんなに言,いわれた、「あなたの夫,おっとを呼,よびに行,いって、ここに連,つれてきなさい」。","tok":[["イエス"],["は"],["女","おんな"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["の"],["夫","おっと"],["を"],["呼び","よび"],["に"],["行って","いって"],["、"],["ここ"],["に"],["連れて","つれて"],["き"],["なさい"],["」"],["。"]]},{"verse":17,"text":"女,おんなは答,こたえて言,いった、「わたしには夫,おっとはありません」。イエスは女,おんなに言,いわれた、「夫,おっとがないと言,いったのは、もっともだ。","tok":[["女","おんな"],["は"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["わたし"],["に"],["は"],["夫","おっと"],["は"],["ありません"],["」"],["。"],["イエス"],["は"],["女","おんな"],["に"],["言われた","いわれた"],["、"],["「"],["夫","おっと"],["が"],["ない"],["と"],["言った","いった"],["の"],["は"],["、"],["もっとも"],["だ"],["。"]]},{"verse":18,"text":"あなたには五人,にんの夫,おっとがあったが、今,いまのはあなたの夫,おっとではない。あなたの言葉,ことばのとおりである」。","tok":[["あなた"],["に"],["は"],["五人","にん"],["の"],["夫","おっと"],["が"],["あった"],["が"],["、"],["今","いま"],["の"],["は"],["あなた"],["の"],["夫","おっと"],["で"],["は"],["ない"],["。"],["あなた"],["の"],["言葉","ことば"],["の"],["とおり"],["で"],["ある"],["」"],["。"]]},{"verse":19,"text":"女,おんなはイエスに言,いった、「主,しゅよ、わたしはあなたを預言者,よげんしゃと見,みます。","tok":[["女","おんな"],["は"],["イエス"],["に"],["言った","いった"],["、"],["「"],["主","しゅ"],["よ"],["、"],["わたし"],["は"],["あなた"],["を"],["預言者","よげんしゃ"],["と"],["見ます","みます"],["。"]]},{"verse":20,"text":"わたしたちの先祖,せんぞは、この山,やまで礼拝,れいはいをしたのですが、あなたがたは礼拝,れいはいすべき場所,ばしょは、エルサレムにあると言,いっています」。","tok":[["わたしたち"],["の"],["先祖","せんぞ"],["は"],["、"],["この"],["山","やま"],["で"],["礼拝","れいはい"],["を"],["した"],["の"],["です"],["が"],["、"],["あなた"],["がた"],["は"],["礼拝","れいはい"],["すべき"],["場所","ばしょ"],["は"],["、"],["エルサレム"],["に"],["ある"],["と"],["言って","いって"],["います"],["」"],["。"]]},{"verse":21,"text":"イエスは女,おんなに言,いわれた、「女,おんなよ、わたしの言,いうことを信,しんじなさい。あなたがたが、この山,やまでも、またエルサレムでもない所,ところで、父,ちちを礼拝,れいはいする時,ときが来,くる。","tok":[["イエス"],["は"],["女","おんな"],["に"],["言われた","いわれた"],["、"],["「"],["女","おんな"],["よ"],["、"],["わたし"],["の"],["言う","いう"],["こと"],["を"],["信じ","しんじ"],["なさい"],["。"],["あなた"],["が"],["た"],["が"],["、"],["この"],["山","やま"],["で"],["も"],["、"],["また"],["エルサレム"],["で"],["も"],["ない"],["所","ところ"],["で"],["、"],["父","ちち"],["を"],["礼拝","れいはい"],["する"],["時","とき"],["が"],["来る","くる"],["。"]]},{"verse":22,"text":"あなたがたは自分,じぶんの知,しらないものを拝,おがんでいるが、わたしたちは知,しっているかたを礼拝,れいはいしている。救,すくいはユダヤ人,じんから来,くるからである。","tok":[["あなた"],["がた"],["は"],["自分","じぶん"],["の"],["知らない","しらない"],["もの"],["を"],["拝んで","おがんで"],["いる"],["が"],["、"],["わたしたち"],["は"],["知って","しって"],["いる"],["かた"],["を"],["礼拝","れいはい"],["して"],["いる"],["。"],["救い","すくい"],["は"],["ユダヤ人","ゆだやじん"],["から"],["来る","くる"],["から"],["で"],["ある"],["。"]]},{"verse":23,"text":"しかし、まことの礼拝,れいはいをする者,ものたちが、霊,れいとまこととをもって父,ちちを礼拝,れいはいする時,ときが来,くる。そうだ、今,いまきている。父,ちちは、このような礼拝,れいはいをする者,ものたちを求,もとめておられるからである。","tok":[["しかし"],["、"],["まこと"],["の"],["礼拝","れいはい"],["を"],["する"],["者","もの"],["たち"],["が"],["、"],["霊","れい"],["と"],["まこと"],["と"],["を"],["もって"],["父","ちち"],["を"],["礼拝","れいはい"],["する"],["時","とき"],["が"],["来る","くる"],["。"],["そう"],["だ"],["、"],["今","いま"],["きて"],["いる"],["。"],["父","ちち"],["は"],["、"],["この"],["よう"],["な"],["礼拝","れいはい"],["を"],["する"],["者","もの"],["たち"],["を"],["求めて","もとめて"],["おられる"],["から"],["で"],["ある"],["。"]]},{"verse":24,"text":"神,かみは霊,れいであるから、礼拝,れいはいをする者,ものも、霊,れいとまこととをもって礼拝,れいはいすべきである」。","tok":[["神","かみ"],["は"],["霊","れい"],["で"],["ある"],["から"],["、"],["礼拝","れいはい"],["を"],["する"],["者","もの"],["も"],["、"],["霊","れい"],["と"],["まこと"],["と"],["を"],["もって"],["礼拝","れいはい"],["すべきで"],["ある"],["」"],["。"]]},{"verse":25,"text":"女,おんなはイエスに言,いった、「わたしは、キリストと呼,よばれるメシヤがこられることを知,しっています。そのかたがこられたならば、わたしたちに、いっさいのことを知,しらせて下,くださるでしょう」。","tok":[["女","おんな"],["は"],["イエス"],["に"],["言った","いった"],["、"],["「"],["わたし"],["は"],["、"],["キリスト"],["と"],["呼ばれる","よばれる"],["メシヤ"],["が"],["こられる"],["こと"],["を"],["知って","しって"],["います"],["。"],["その"],["かた"],["が"],["こられたならば"],["、"],["わたしたち"],["に"],["、"],["いっさい"],["の"],["こと"],["を"],["知らせて","しらせて"],["下さるでしょう","くださるでしょう"],["」"],["。"]]},{"verse":26,"text":"イエスは女,おんなに言,いわれた、「あなたと話,はなしをしているこのわたしが、それである」。","tok":[["イエス"],["は"],["女","おんな"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["と"],["話","はなし"],["を"],["して"],["いる"],["この"],["わたし"],["が"],["、"],["それ"],["で"],["ある"],["」"],["。"]]},{"verse":27,"text":"そのとき、弟子,でしたちが帰,かえって来,きて、イエスがひとりの女,おんなと話,はなしておられるのを見,みて不思議,ふしぎに思,おもったが、しかし、「何,なにを求,もとめておられますか」とも、「何,なにを彼女,かのじょと話,はなしておられるのですか」とも、尋,たずねる者,ものはひとりもなかった。","tok":[["その"],["とき"],["、"],["弟子","でし"],["たち"],["が"],["帰えって","かえって"],["来て","きて"],["、"],["イエス"],["が"],["ひとり"],["の"],["女","おんな"],["と"],["話","はなし"],["て"],["おられる"],["の"],["を"],["見て","みて"],["不思議","ふしぎ"],["に"],["思った","おもった"],["が"],["、"],["しかし"],["、"],["「"],["何に","なに"],["を"],["求めて","もとめて"],["おられます"],["か"],["」"],["と"],["も"],["、"],["「"],["何に","なに"],["を"],["彼女","かのじょ"],["と"],["話","はなし"],["て"],["おられる"],["の"],["です"],["か"],["」"],["と"],["も"],["、"],["尋ねる","たずねる"],["者","もの"],["は"],["ひとり"],["も"],["なかった"],["。"]]},{"verse":28,"text":"この女,おんなは水,みずがめをそのままそこに置,おいて町,まちに行,いき、人々,ひとびとに言,いった、","tok":[["この"],["女","おんな"],["は"],["水がめ","みずがめ"],["を"],["そのまま"],["そこ"],["に"],["置いて","おいて"],["町","まち"],["に"],["行き","いき"],["、"],["人々","ひとびと"],["に"],["言った","いった"],["、"]]},{"verse":29,"text":"「わたしのしたことを何,なにもかも、言,いいあてた人,ひとがいます。さあ、見,みにきてごらんなさい。もしかしたら、この人,ひとがキリストかも知,しれません」。","tok":[["「"],["わたし"],["の"],["した"],["こと"],["を"],["何に","なに"],["も"],["か"],["も"],["、"],["言いあてた","いいあてた"],["人","ひと"],["が"],["います"],["。"],["さあ"],["、"],["見","み"],["に"],["きて"],["ごらん"],["なさい"],["。"],["もし"],["か"],["したら"],["、"],["この"],["人","ひと"],["が"],["キリスト"],["か"],["も"],["知れません","しれません"],["」"],["。"]]},{"verse":30,"text":"人々,ひとびとは町,まちを出,でて、ぞくぞくとイエスのところへ行,いった。","tok":[["人々","ひとびと"],["は"],["町","まち"],["を"],["出て","でて"],["、"],["ぞくぞく"],["と"],["イエス"],["の"],["ところ"],["へ"],["行った","いった"],["。"]]},{"verse":31,"text":"その間,あいだに弟子,でしたちはイエスに、「先生,せんせい、召,めしあがってください」とすすめた。","tok":[["その"],["間","あいだ"],["に"],["弟子","でし"],["たち"],["は"],["イエス"],["に"],["、"],["「"],["先生","せんせい"],["、"],["召","めし"],["あがって"],["ください"],["」"],["と"],["すすめた"],["。"]]},{"verse":32,"text":"ところが、イエスは言,いわれた、「わたしには、あなたがたの知,しらない食物,しょくもつがある」。","tok":[["ところ"],["が"],["、"],["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["わたし"],["に"],["は"],["、"],["あなた"],["がた"],["の"],["知らない","しらない"],["食物","しょくもつ"],["が"],["ある"],["」"],["。"]]},{"verse":33,"text":"そこで、弟子,でしたちが互,たがいに言,いった、「だれかが、何,なにか食,たべるものを持,もってきてさしあげたのであろうか」。","tok":[["そこ"],["で"],["、"],["弟子","でし"],["たち"],["が"],["互","たがい"],["に"],["言った","いった"],["、"],["「"],["だれ"],["か"],["が"],["、"],["何に","なに"],["か"],["食べる","たべる"],["もの"],["を"],["持って","もって"],["きて"],["さしあげた"],["ので"],["あろう"],["か"],["」"],["。"]]},{"verse":34,"text":"イエスは彼,かれらに言,いわれた、「わたしの食物,しょくもつというのは、わたしをつかわされたかたのみこころを行,おこない、そのみわざをなし遂,とげることである。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["わたし"],["の"],["食物","しょくもつ"],["と"],["いう"],["の"],["は"],["、"],["わたし"],["を"],["つかわされた"],["かた"],["のみ"],["こころ"],["を"],["行ない","おこない"],["、"],["その"],["みわざ"],["を"],["なし遂げる","なしとげる"],["こと"],["で"],["ある"],["。"]]},{"verse":35,"text":"あなたがたは、刈入,かりいれ時,ときが来,くるまでには、まだ四か月,げつあると、言,いっているではないか。しかし、わたしはあなたがたに言,いう。目,めをあげて畑,はたけを見,みなさい。はや色,いろづいて刈入,かりいれを待,まっている。","tok":[["あなた"],["がた"],["は"],["、"],["刈入れ","かりいれ"],["時","とき"],["が"],["来る","くる"],["まで"],["に"],["は"],["、"],["まだ"],["四","よん"],["か月","かげつ"],["ある"],["と"],["、"],["言って","いって"],["いるで"],["は"],["ない"],["か"],["。"],["しかし"],["、"],["わたし"],["は"],["あなた"],["がた"],["に"],["言う","いう"],["。"],["目","め"],["を"],["あげて"],["畑","はたけ"],["を"],["見","み"],["なさい"],["。"],["はや"],["色づいて","いろづいて"],["刈入れ","かりいれ"],["を"],["待って","まって"],["いる"],["。"]]},{"verse":36,"text":"刈,かる者,ものは報酬,ほうしゅうを受,うけて、永遠,えいえんの命,いのちに至,いたる実,みを集,あつめている。まく者,ものも刈,かる者,ものも、共々,ともどもに喜,よろこぶためである。","tok":[["刈る","かる"],["者","もの"],["は"],["報酬","ほうしゅう"],["を"],["受て","うけて"],["、"],["永遠","えいえん"],["の"],["命","いのち"],["に"],["至る","いたる"],["実","み"],["を"],["集めて","あつめて"],["いる"],["。"],["まく者","まくもの"],["も"],["刈る","かる"],["者","もの"],["も"],["、"],["共々","ともども"],["に"],["喜こぶ","よろこぶ"],["ため"],["で"],["ある"],["。"]]},{"verse":37,"text":"そこで、『ひとりがまき、ひとりが刈,かる』ということわざが、ほんとうのこととなる。","tok":[["そこ"],["で"],["、"],["『"],["ひとり"],["が"],["まき"],["、"],["ひとり"],["が"],["刈る","かる"],["』"],["と"],["いう"],["ことわざ"],["が"],["、"],["ほんとう"],["の"],["こと"],["と"],["なる"],["。"]]},{"verse":38,"text":"わたしは、あなたがたをつかわして、あなたがたがそのために労苦,ろうくしなかったものを刈,かりとらせた。ほかの人々,ひとびとが労苦,ろうくし、あなたがたは、彼,かれらの労苦,ろうくの実,みにあずかっているのである」。","tok":[["わたし"],["は"],["、"],["あなた"],["がた"],["を"],["つかわして"],["、"],["あなた"],["がた"],["が"],["その"],["ため"],["に"],["労苦","ろうく"],["しなかった"],["もの"],["を"],["刈","かり"],["とらせた"],["。"],["ほか"],["の"],["人々","ひとびと"],["が"],["労苦","ろうく"],["し"],["、"],["あなた"],["がた"],["は"],["、"],["彼","かれ"],["ら"],["の"],["労苦","ろうく"],["の"],["実","み"],["に"],["あずかって"],["いる"],["ので"],["ある"],["」"],["。"]]},{"verse":39,"text":"さて、この町,まちからきた多,おおくのサマリヤ人,ひとは、「この人,ひとは、わたしのしたことを何,なにもかも言,いいあてた」とあかしした女,おんなの言葉,ことばによって、イエスを信,しんじた。","tok":[["さて"],["、"],["この"],["町","まち"],["から"],["きた"],["多く","おおく"],["の"],["サマリヤ"],["人","ひと"],["は"],["、"],["「"],["この"],["人","ひと"],["は"],["、"],["わたし"],["の"],["した"],["こと"],["を"],["何に","なに"],["も"],["か"],["も"],["言いあてた","いいあてた"],["」"],["と"],["あかし"],["した"],["女","おんな"],["の"],["言葉","ことば"],["によって"],["、"],["イエス"],["を"],["信じた","しんじた"],["。"]]},{"verse":40,"text":"そこで、サマリヤ人,ひとたちはイエスのもとにきて、自分,じぶんたちのところに滞在,たいざいしていただきたいと願,ねがったので、イエスはそこにふつか滞在,たいざいされた。","tok":[["そこ"],["で"],["、"],["サマリヤ"],["人","ひと"],["たち"],["は"],["イエス"],["の"],["もと"],["に"],["きて"],["、"],["自分","じぶん"],["たち"],["の"],["ところ"],["に"],["滞在","たいざい"],["して"],["いただきたい"],["と"],["願った","ねがった"],["ので"],["、"],["イエス"],["は"],["そこ"],["に"],["ふ"],["つ"],["か"],["滞在","たいざい"],["された"],["。"]]},{"verse":41,"text":"そしてなお多,おおくの人々,ひとびとが、イエスの言葉,ことばを聞,きいて信,しんじた。","tok":[["そして"],["なお"],["多く","おおく"],["の"],["人々","ひとびと"],["が"],["、"],["イエス"],["の"],["言葉","ことば"],["を"],["聞いて","きいて"],["信じた","しんじた"],["。"]]},{"verse":42,"text":"彼,かれらは女,おんなに言,いった、「わたしたちが信,しんじるのは、もうあなたが話,はなしてくれたからではない。自分,じぶん自身,じしんで親,したしく聞,きいて、この人,ひとこそまことに世,よの救主,すくいぬしであることが、わかったからである」。","tok":[["彼","かれ"],["ら"],["は"],["女","おんな"],["に"],["言った","いった"],["、"],["「"],["わたしたち"],["が"],["信じる","しんじる"],["の"],["は"],["、"],["もう"],["あなた"],["が"],["話","はなし"],["て"],["くれた"],["から"],["で"],["は"],["ない"],["。"],["自分","じぶん"],["自身","じしん"],["で"],["親しく","したしく"],["聞いて","きいて"],["、"],["この"],["人","ひと"],["こそ"],["まこと"],["に"],["世","よ"],["の"],["救主","す"],["くい"],["ぬし"],["で"],["ある"],["こと"],["が"],["、"],["わかった"],["から"],["で"],["ある"],["」"],["。"]]},{"verse":43,"text":"ふつかの後,のちに、イエスはここを去,さってガリラヤへ行,いかれた。","tok":[["ふ"],["つ"],["か"],["の"],["後","のち"],["に"],["、"],["イエス"],["は"],["ここ"],["を"],["去て","さって"],["ガリラヤ"],["へ"],["行かれた","いかれた"],["。"]]},{"verse":44,"text":"イエスはみずからはっきり、「預言者,よげんしゃは自分,じぶんの故郷,こきょうでは敬,うやまわれないものだ」と言,いわれたのである。","tok":[["イエス"],["は"],["みずから"],["はっきり"],["、"],["「"],["預言者","よげんしゃ"],["は"],["自分","じぶん"],["の"],["故郷","こきょう"],["で"],["は"],["敬われない","うやまわれない"],["もの"],["だ"],["」"],["と"],["言われた","いわれた"],["ので"],["ある"],["。"]]},{"verse":45,"text":"ガリラヤに着,つかれると、ガリラヤの人,ひとたちはイエスを歓迎,かんげいした。それは、彼,かれらも祭,まつりに行,いっていたので、その祭,まつりの時,とき、イエスがエルサレムでなされたことをことごとく見,みていたからである。","tok":[["ガリラヤ"],["に"],["着かれる","つかれる"],["と"],["、"],["ガリラヤ"],["の"],["人","ひと"],["たち"],["は"],["イエス"],["を"],["歓迎","かんげい"],["した"],["。"],["それ"],["は"],["、"],["彼","かれ"],["ら"],["も"],["祭","まつり"],["に"],["行って","いって"],["いた"],["ので"],["、"],["その"],["祭","まつり"],["の"],["時","とき"],["、"],["イエス"],["が"],["エルサレム"],["で"],["なされた"],["こと"],["を"],["ことごとく"],["見て","みて"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":46,"text":"イエスは、またガリラヤのカナに行,いかれた。そこは、かつて水,みずをぶどう酒,しゅにかえられた所,ところである。ところが、病気,びょうきをしているむすこを持,もつある役人,やくにんがカペナウムにいた。","tok":[["イエス"],["は"],["、"],["また"],["ガリラヤ"],["の"],["カナ"],["に"],["行かれた","いかれた"],["。"],["そこ"],["は"],["、"],["かつて"],["水","みず"],["を"],["ぶどう酒","ぶどうしゅ"],["に"],["かえられた"],["所","ところ"],["で"],["ある"],["。"],["ところ"],["が"],["、"],["病気","びょうき"],["を"],["して"],["いる"],["むすこ"],["を"],["持つ","もつ"],["ある"],["役人","やくにん"],["が"],["カペナウム"],["に"],["いた"],["。"]]},{"verse":47,"text":"この人,ひとが、ユダヤからガリラヤにイエスのきておられることを聞,きき、みもとにきて、カペナウムに下,くだって、彼,かれの子,こをなおしていただきたいと、願,ねがった。その子,こが死,しにかかっていたからである。","tok":[["この"],["人","ひと"],["が"],["、"],["ユダヤ"],["から"],["ガリラヤ"],["に"],["イエス"],["の"],["きて"],["おられる"],["こと"],["を"],["聞","きき"],["、"],["みもと"],["に"],["きて"],["、"],["カペナウム"],["に"],["下って","くだって"],["、"],["彼","かれ"],["の"],["子","こ"],["を"],["なおして"],["いただきたい"],["と"],["、"],["願った","ねがった"],["。"],["その"],["子","こ"],["が"],["死にかかって","しにかかって"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":48,"text":"そこで、イエスは彼,かれに言,いわれた、「あなたがたは、しるしと奇跡,きせきとを見,みない限,かぎり、決,けっして信,しんじないだろう」。","tok":[["そこ"],["で"],["、"],["イエス"],["は"],["彼","かれ"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["がた"],["は"],["、"],["しるし"],["と"],["奇跡","きせき"],["と"],["を"],["見ない","みない"],["限","かぎり"],["、"],["決っして","けっして"],["信じないだろう","しんじないだろう"],["」"],["。"]]},{"verse":49,"text":"この役人,やくにんはイエスに言,いった、「主,しゅよ、どうぞ、子供,こどもが死,しなないうちにきて下,ください」。","tok":[["この"],["役人","やくにん"],["は"],["イエス"],["に"],["言った","いった"],["、"],["「"],["主","しゅ"],["よ"],["、"],["どうぞ"],["、"],["子供","こども"],["が"],["死なない","しなない"],["うち"],["に"],["きて"],["下さい","ください"],["」"],["。"]]},{"verse":50,"text":"イエスは彼,かれに言,いわれた、「お帰,かえりなさい。あなたのむすこは助,たすかるのだ」。彼,かれは自分,じぶんに言,いわれたイエスの言葉,ことばを信,しんじて帰,かえって行,いった。","tok":[["イエス"],["は"],["彼","かれ"],["に"],["言われた","いわれた"],["、"],["「"],["お帰えり","おかえり"],["なさい"],["。"],["あなた"],["の"],["むすこ"],["は"],["助かる","たすかる"],["の"],["だ"],["」"],["。"],["彼","かれ"],["は"],["自分","じぶん"],["に"],["言われた","いわれた"],["イエス"],["の"],["言葉","ことば"],["を"],["信じて","しんじて"],["帰えって","かえって"],["行った","いった"],["。"]]},{"verse":51,"text":"その下,くだって行,いく途中,とちゅう、僕,しもべたちが彼,かれに出会,であい、その子,こが助,たすかったことを告,つげた。","tok":[["その"],["下って","くだって"],["行く","いく"],["途中","とちゅう"],["、"],["僕","し"],["も"],["べ"],["たち"],["が"],["彼","かれ"],["に"],["出会","であい"],["、"],["その"],["子","こ"],["が"],["助かった","たすかった"],["こと"],["を"],["告","つげ"],["た"],["。"]]},{"verse":52,"text":"そこで、彼,かれは僕,しもべたちに、そのなおりはじめた時刻,じこくを尋,たずねてみたら、「きのうの午後,ごご一時,じに熱,ねつが引,ひきました」と答,こたえた。","tok":[["そこ"],["で"],["、"],["彼","かれ"],["は"],["僕","し"],["も"],["べ"],["たち"],["に"],["、"],["その"],["なおり"],["はじめた"],["時刻","じこく"],["を"],["尋ねて","たずねて"],["みたら"],["、"],["「"],["きのう"],["の"],["午後","ごご"],["一","いち"],["時","じ"],["に"],["熱","ねつ"],["が"],["引","ひき"],["ました"],["」"],["と"],["答","こたえ"],["た"],["。"]]},{"verse":53,"text":"それは、イエスが「あなたのむすこは助,たすかるのだ」と言,いわれたのと同,おなじ時刻,じこくであったことを、この父,ちちは知,しって、彼,かれ自身,じしんもその家族,かぞく一同,いちどうも信,しんじた。","tok":[["それ"],["は"],["、"],["イエス"],["が"],["「"],["あなた"],["の"],["むすこ"],["は"],["助かる","たすかる"],["の"],["だ"],["」"],["と"],["言われた","いわれた"],["の"],["と"],["同じ","おなじ"],["時刻","じこく"],["で"],["あった"],["こと"],["を"],["、"],["この"],["父","ちち"],["は"],["知って","しって"],["、"],["彼","かれ"],["自身","じしん"],["も"],["その"],["家族","かぞく"],["一同","いちどう"],["も"],["信じた","しんじた"],["。"]]},{"verse":54,"text":"これは、イエスがユダヤからガリラヤにきてなされた第,だい二のしるしである。","tok":[["これ"],["は"],["、"],["イエス"],["が"],["ユダヤ"],["から"],["ガリラヤ"],["に"],["きて"],["なされた"],["第","だい"],["二","に"],["の"],["しるし"],["で"],["ある"],["。"]]}]
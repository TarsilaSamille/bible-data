[{"verse":1,"text":"過越,すぎこしの祭,まつりの前,まえに、イエスは、この世,よを去,さって父,ちちのみもとに行,いくべき自分,じぶんの時,ときがきたことを知,しり、世,よにいる自分,じぶんの者,ものたちを愛,あいして、彼,かれらを最後,さいごまで愛,あいし通,とおされた。","tok":[["過越","すぎこし"],["の"],["祭","まつり"],["の"],["前","まえ"],["に"],["、"],["イエス"],["は"],["、"],["この世","このよ"],["を"],["去て","さって"],["父","ちち"],["のみ"],["もと"],["に"],["行くべき","いくべき"],["自分","じぶん"],["の"],["時","とき"],["が"],["きた"],["こと"],["を"],["知り","しり"],["、"],["世","よ"],["に"],["いる"],["自分","じぶん"],["の"],["者","もの"],["たち"],["を"],["愛して","あいして"],["、"],["彼","かれ"],["ら"],["を"],["最後","さいご"],["まで"],["愛し","あいし"],["通された","とおされた"],["。"]]},{"verse":2,"text":"夕食,ゆうしょくのとき、悪魔,あくまはすでにシモンの子,こイスカリオテのユダの心,こころに、イエスを裏切,うらぎろうとする思,おもいを入,いれていたが、","tok":[["夕食","ゆうしょく"],["の"],["とき"],["、"],["悪魔","あくま"],["は"],["すでに"],["シモン"],["の"],["子","こ"],["イスカリオテ"],["の"],["ユダ"],["の"],["心","こころ"],["に"],["、"],["イエス"],["を"],["裏切ろう","うらぎろう"],["と"],["する"],["思い","おもい"],["を"],["入れて","いれて"],["いた"],["が"],["、"]]},{"verse":3,"text":"イエスは、父,ちちがすべてのものを自分,じぶんの手,てにお与,あたえになったこと、また、自分,じぶんは神,かみから出,でてきて、神,かみにかえろうとしていることを思,おもい、","tok":[["イエス"],["は"],["、"],["父","ちち"],["が"],["すべて"],["の"],["もの"],["を"],["自分","じぶん"],["の"],["手","て"],["に"],["お"],["与","あたえ"],["に"],["なった"],["こと"],["、"],["また"],["、"],["自分","じぶん"],["は"],["神","かみ"],["から"],["出て","でて"],["きて"],["、"],["神","かみ"],["に"],["かえろう"],["として"],["いる"],["こと"],["を"],["思い","おもい"],["、"]]},{"verse":4,"text":"夕食,ゆうしょくの席,せきから立,たち上,あがって、上着,うわぎを脱,ぬぎ、手,てぬぐいをとって腰,こしに巻,まき、","tok":[["夕食","ゆうしょく"],["の"],["席","せき"],["から"],["立ち上がって","たちあがって"],["、"],["上着","うわぎ"],["を"],["脱ぎ","ぬぎ"],["、"],["手ぬぐい","てぬぐい"],["を"],["とって"],["腰","こし"],["に"],["巻","まき"],["、"]]},{"verse":5,"text":"それから水,みずをたらいに入,いれて、弟子,でしたちの足,あしを洗,あらい、腰,こしに巻,まいた手,てぬぐいでふき始,はじめられた。","tok":[["それ"],["から"],["水","みず"],["を"],["たらい"],["に"],["入れて","いれて"],["、"],["弟子","でし"],["たち"],["の"],["足","あし"],["を"],["洗","あらい"],["、"],["腰","こし"],["に"],["巻いた","まいた"],["手ぬぐい","てぬぐい"],["で"],["ふき"],["始められた","はじめられた"],["。"]]},{"verse":6,"text":"こうして、シモン・ペテロの番,ばんになった。すると彼,かれはイエスに、「主,しゅよ、あなたがわたしの足,あしをお洗,あらいになるのですか」と言,いった。","tok":[["こう"],["して"],["、"],["シモン"],["・"],["ペテロ"],["の"],["番","ばん"],["に"],["なった"],["。"],["する"],["と"],["彼","かれ"],["は"],["イエス"],["に"],["、"],["「"],["主","しゅ"],["よ"],["、"],["あなた"],["が"],["わたし"],["の"],["足","あし"],["を"],["お洗","おあらい"],["に"],["なる"],["の"],["です"],["か"],["」"],["と"],["言った","いった"],["。"]]},{"verse":7,"text":"イエスは彼,かれに答,こたえて言,いわれた、「わたしのしていることは今,いまあなたにはわからないが、あとでわかるようになるだろう」。","tok":[["イエス"],["は"],["彼","かれ"],["に"],["答","こたえ"],["て"],["言われた","いわれた"],["、"],["「"],["わたし"],["の"],["して"],["いる"],["こと"],["は"],["今","いま"],["あなた"],["に"],["は"],["わからない"],["が"],["、"],["あと"],["で"],["わかる"],["よう"],["に"],["なるだろう"],["」"],["。"]]},{"verse":8,"text":"ペテロはイエスに言,いった、「わたしの足,あしを決,けっして洗,あらわないで下,ください」。イエスは彼,かれに答,こたえられた、「もしわたしがあなたの足,あしを洗,あらわないなら、あなたはわたしとなんの係,かかわりもなくなる」。","tok":[["ペテロ"],["は"],["イエス"],["に"],["言った","いった"],["、"],["「"],["わたし"],["の"],["足","あし"],["を"],["決っして","けっして"],["洗わないで","あらわないで"],["下さい","ください"],["」"],["。"],["イエス"],["は"],["彼","かれ"],["に"],["答","こたえ"],["られた"],["、"],["「"],["もし"],["わたし"],["が"],["あなた"],["の"],["足","あし"],["を"],["洗わないなら","あらわないなら"],["、"],["あなた"],["は"],["わたし"],["と"],["なん"],["の"],["係わり","かかわり"],["も"],["なくなる"],["」"],["。"]]},{"verse":9,"text":"シモン・ペテロはイエスに言,いった、「主,しゅよ、では、足,あしだけではなく、どうぞ、手,ても頭,あたまも」。","tok":[["シモン"],["・"],["ペテロ"],["は"],["イエス"],["に"],["言った","いった"],["、"],["「"],["主","しゅ"],["よ"],["、"],["で"],["は"],["、"],["足","あし"],["だけ"],["で"],["は"],["なく"],["、"],["どうぞ"],["、"],["手","て"],["も"],["頭","あたま"],["も"],["」"],["。"]]},{"verse":10,"text":"イエスは彼,かれに言,いわれた、「すでにからだを洗,あらった者,ものは、足,あしのほかは洗,あらう必要,ひつようがない。全身,ぜんしんがきれいなのだから。あなたがたはきれいなのだ。しかし、みんながそうなのではない」。","tok":[["イエス"],["は"],["彼","かれ"],["に"],["言われた","いわれた"],["、"],["「"],["すでに"],["からだ"],["を"],["洗った","あらった"],["者","もの"],["は"],["、"],["足","あし"],["の"],["ほか"],["は"],["洗う","あらう"],["必要","ひつよう"],["が"],["ない"],["。"],["全身","ぜんしん"],["が"],["きれい"],["な"],["の"],["だ"],["から"],["。"],["あなた"],["がた"],["は"],["きれい"],["な"],["の"],["だ"],["。"],["しかし"],["、"],["みんな"],["が"],["そう"],["な"],["ので"],["は"],["ない"],["」"],["。"]]},{"verse":11,"text":"イエスは自分,じぶんを裏切,うらぎる者,ものを知,しっておられた。それで、「みんながきれいなのではない」と言,いわれたのである。","tok":[["イエス"],["は"],["自分","じぶん"],["を"],["裏切る","うらぎる"],["者","もの"],["を"],["知って","しって"],["おられた"],["。"],["それ"],["で"],["、"],["「"],["みんな"],["が"],["きれい"],["な"],["ので"],["は"],["ない"],["」"],["と"],["言われた","いわれた"],["ので"],["ある"],["。"]]},{"verse":12,"text":"こうして彼,かれらの足,あしを洗,あらってから、上着,うわぎをつけ、ふたたび席,せきにもどって、彼,かれらに言,いわれた、「わたしがあなたがたにしたことがわかるか。","tok":[["こう"],["して"],["彼","かれ"],["ら"],["の"],["足","あし"],["を"],["洗って","あらって"],["から"],["、"],["上着","うわぎ"],["を"],["つけ"],["、"],["ふたたび"],["席","せき"],["に"],["もどって"],["、"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["わたし"],["が"],["あなた"],["がた"],["に"],["した"],["こと"],["が"],["わかる"],["か"],["。"]]},{"verse":13,"text":"あなたがたはわたしを教師,きょうし、また主,しゅと呼,よんでいる。そう言,いうのは正,ただしい。わたしはそのとおりである。","tok":[["あなた"],["がた"],["は"],["わたし"],["を"],["教師","きょうし"],["、"],["また"],["主","しゅ"],["と"],["呼んで","よんで"],["いる"],["。"],["そう"],["言う","いう"],["の"],["は"],["正い","ただしい"],["。"],["わたし"],["は"],["その"],["とおり"],["で"],["ある"],["。"]]},{"verse":14,"text":"しかし、主,しゅであり、また教師,きょうしであるわたしが、あなたがたの足,あしを洗,あらったからには、あなたがたもまた、互,たがいに足,あしを洗,あらい合,あうべきである。","tok":[["しかし"],["、"],["主","しゅ"],["で"],["あり"],["、"],["また"],["教師","きょうし"],["で"],["ある"],["わたし"],["が"],["、"],["あなた"],["がた"],["の"],["足","あし"],["を"],["洗った","あらった"],["から"],["に"],["は"],["、"],["あなた"],["がた"],["も"],["また"],["、"],["互","たがい"],["に"],["足","あし"],["を"],["洗","あらい"],["合うべきで","あうべきで"],["ある"],["。"]]},{"verse":15,"text":"わたしがあなたがたにしたとおりに、あなたがたもするように、わたしは手本,てほんを示,しめしたのだ。","tok":[["わたし"],["が"],["あなた"],["がた"],["に"],["した"],["とおり"],["に"],["、"],["あなた"],["がた"],["も"],["する"],["よう"],["に"],["、"],["わたし"],["は"],["手本","てほん"],["を"],["示めした","しめした"],["の"],["だ"],["。"]]},{"verse":16,"text":"よくよくあなたがたに言,いっておく。僕,しもべはその主人,しゅじんにまさるものではなく、つかわされた者,ものはつかわした者,ものにまさるものではない。","tok":[["よくよく"],["あなた"],["がた"],["に"],["言って","いって"],["おく"],["。"],["僕","し"],["も"],["べ"],["は"],["その"],["主人","しゅじん"],["に"],["まさる"],["もの"],["で"],["は"],["なく"],["、"],["つかわされた"],["者","もの"],["は"],["つかわした"],["者","もの"],["に"],["まさる"],["もの"],["で"],["は"],["ない"],["。"]]},{"verse":17,"text":"もしこれらのことがわかっていて、それを行,おこなうなら、あなたがたはさいわいである。","tok":[["もし"],["これ"],["ら"],["の"],["こと"],["が"],["わかって"],["いて"],["、"],["それ"],["を"],["行なうなら","おこなうなら"],["、"],["あなた"],["がた"],["は"],["さいわい"],["で"],["ある"],["。"]]},{"verse":18,"text":"あなたがた全部,ぜんぶの者,ものについて、こう言,いっているのではない。わたしは自分,じぶんが選,えらんだ人,ひとたちを知,しっている。しかし、『わたしのパンを食,たべている者,ものが、わたしにむかってそのかかとをあげた』とある聖書,せいしょは成就,じょうじゅされなければならない。","tok":[["あなた"],["がた"],["全部","ぜんぶ"],["の"],["者","もの"],["について"],["、"],["こう"],["言って","いって"],["いる"],["ので"],["は"],["ない"],["。"],["わたし"],["は"],["自分","じぶん"],["が"],["選らんだ","えらんだ"],["人","ひと"],["たち"],["を"],["知って","しって"],["いる"],["。"],["しかし"],["、"],["『"],["わたし"],["の"],["パン"],["を"],["食べて","たべて"],["いる"],["者","もの"],["が"],["、"],["わたし"],["に"],["むかって"],["その"],["かかと"],["を"],["あげた"],["』"],["と"],["ある"],["聖書","せいしょ"],["は"],["成就","じょうじゅ"],["されなければ"],["ならない"],["。"]]},{"verse":19,"text":"そのことがまだ起,おこらない今,いまのうちに、あなたがたに言,いっておく。いよいよ事,ことが起,おこったとき、わたしがそれであることを、あなたがたが信,しんじるためである。","tok":[["その"],["こと"],["が"],["まだ"],["起こらない","おこらない"],["今","いま"],["の"],["うち"],["に"],["、"],["あなた"],["がた"],["に"],["言って","いって"],["おく"],["。"],["いよいよ"],["事","こと"],["が"],["起こった","おこった"],["とき"],["、"],["わたし"],["が"],["それ"],["で"],["ある"],["こと"],["を"],["、"],["あなた"],["がた"],["が"],["信じる","しんじる"],["ため"],["で"],["ある"],["。"]]},{"verse":20,"text":"よくよくあなたがたに言,いっておく。わたしがつかわす者,ものを受,うけいれる者,ものは、わたしを受,うけいれるのである。わたしを受,うけいれる者,ものは、わたしをつかわされたかたを、受,うけいれるのである」。","tok":[["よくよく"],["あなた"],["がた"],["に"],["言って","いって"],["おく"],["。"],["わたし"],["が"],["つかわす"],["者","もの"],["を"],["受","うけ"],["いれる"],["者","もの"],["は"],["、"],["わたし"],["を"],["受","うけ"],["いれる"],["ので"],["ある"],["。"],["わたし"],["を"],["受","うけ"],["いれる"],["者","もの"],["は"],["、"],["わたし"],["を"],["つかわされた"],["かた"],["を"],["、"],["受","うけ"],["いれる"],["ので"],["ある"],["」"],["。"]]},{"verse":21,"text":"イエスがこれらのことを言,いわれた後,のち、その心,こころが騒,さわぎ、おごそかに言,いわれた、「よくよくあなたがたに言,いっておく。あなたがたのうちのひとりが、わたしを裏切,うらぎろうとしている」。","tok":[["イエス"],["が"],["これ"],["ら"],["の"],["こと"],["を"],["言われた","いわれた"],["後","の"],["ち"],["、"],["その"],["心","こころ"],["が"],["騒","さわぎ"],["、"],["おごそか"],["に"],["言われた","いわれた"],["、"],["「"],["よくよく"],["あなた"],["がた"],["に"],["言って","いって"],["おく"],["。"],["あなた"],["がた"],["の"],["うち"],["の"],["ひとり"],["が"],["、"],["わたし"],["を"],["裏切ろう","うらぎろう"],["として"],["いる"],["」"],["。"]]},{"verse":22,"text":"弟子,でしたちはだれのことを言,いわれたのか察,さっしかねて、互,たがいに顔,かおを見合,みあわせた。","tok":[["弟子","でし"],["たち"],["は"],["だれ"],["の"],["こと"],["を"],["言われた","いわれた"],["の"],["か"],["察し","さっし"],["かね"],["て"],["、"],["互","たがい"],["に"],["顔","かお"],["を"],["見合わせた","みあわせた"],["。"]]},{"verse":23,"text":"弟子,でしたちのひとりで、イエスの愛,あいしておられた者,ものが、み胸,むねに近,ちかく席,せきについていた。","tok":[["弟子","でし"],["たち"],["の"],["ひとり"],["で"],["、"],["イエス"],["の"],["愛して","あいして"],["おられた"],["者","もの"],["が"],["、"],["み胸","みむね"],["に"],["近く","ちかく"],["席","せき"],["について"],["いた"],["。"]]},{"verse":24,"text":"そこで、シモン・ペテロは彼,かれに合図,あいずをして言,いった、「だれのことをおっしゃったのか、知,しらせてくれ」。","tok":[["そこ"],["で"],["、"],["シモン"],["・"],["ペテロ"],["は"],["彼","かれ"],["に"],["合図","あいず"],["を"],["して"],["言った","いった"],["、"],["「"],["だれ"],["の"],["こと"],["を"],["おっしゃった"],["の"],["か"],["、"],["知らせて","しらせて"],["くれ"],["」"],["。"]]},{"verse":25,"text":"その弟子,でしはそのままイエスの胸,むねによりかかって、「主,しゅよ、だれのことですか」と尋,たずねると、","tok":[["その"],["弟子","でし"],["は"],["そのまま"],["イエス"],["の"],["胸","むね"],["に"],["より"],["かかって"],["、"],["「"],["主","しゅ"],["よ"],["、"],["だれ"],["の"],["こと"],["です"],["か"],["」"],["と"],["尋ねる","たずねる"],["と"],["、"]]},{"verse":26,"text":"イエスは答,こたえられた、「わたしが一きれの食物,しょくもつをひたして与,あたえる者,ものが、それである」。そして、一きれの食物,しょくもつをひたしてとり上,あげ、シモンの子,こイスカリオテのユダにお与,あたえになった。","tok":[["イエス"],["は"],["答","こたえ"],["られた"],["、"],["「"],["わたし"],["が"],["一","いち"],["きれ"],["の"],["食物","しょくもつ"],["を"],["ひたして"],["与える","あたえる"],["者","もの"],["が"],["、"],["それ"],["で"],["ある"],["」"],["。"],["そして"],["、"],["一","いち"],["きれ"],["の"],["食物","しょくもつ"],["を"],["ひたして"],["とり上げ","とりあげ"],["、"],["シモン"],["の"],["子","こ"],["イスカリオテ"],["の"],["ユダ"],["に"],["お"],["与","あたえ"],["に"],["なった"],["。"]]},{"verse":27,"text":"この一きれの食物,しょくもつを受,うけるやいなや、サタンがユダにはいった。そこでイエスは彼,かれに言,いわれた、「しようとしていることを、今,いますぐするがよい」。","tok":[["この"],["一","いち"],["きれ"],["の"],["食物","しょくもつ"],["を"],["受る","うける"],["や"],["いな"],["や"],["、"],["サタン"],["が"],["ユダ"],["に"],["はいった"],["。"],["そこ"],["で"],["イエス"],["は"],["彼","かれ"],["に"],["言われた","いわれた"],["、"],["「"],["しよう"],["として"],["いる"],["こと"],["を"],["、"],["今","いま"],["すぐ"],["する"],["が"],["よい"],["」"],["。"]]},{"verse":28,"text":"席,せきを共,ともにしていた者,もののうち、なぜユダにこう言,いわれたのか、わかっていた者,ものはひとりもなかった。","tok":[["席","せき"],["を"],["共","とも"],["に"],["して"],["いた"],["者","もの"],["の"],["うち"],["、"],["なぜ"],["ユダ"],["に"],["こう"],["言われた","いわれた"],["の"],["か"],["、"],["わかって"],["いた"],["者","もの"],["は"],["ひとり"],["も"],["なかった"],["。"]]},{"verse":29,"text":"ある人々,ひとびとは、ユダが金入,かねいれをあずかっていたので、イエスが彼,かれに、「祭,まつりのために必要,ひつようなものを買,かえ」と言,いわれたか、あるいは、貧,まずしい者,ものに何,なにか施,ほどこさせようとされたのだと思,おもっていた。","tok":[["ある"],["人々","ひとびと"],["は"],["、"],["ユダ"],["が"],["金入れ","かねいれ"],["を"],["あずかって"],["いた"],["ので"],["、"],["イエス"],["が"],["彼","かれ"],["に"],["、"],["「"],["祭","まつり"],["の"],["ため"],["に"],["必要","ひつよう"],["な"],["もの"],["を"],["買え","かえ"],["」"],["と"],["言われた","いわれた"],["か"],["、"],["あるいは"],["、"],["貧しい","まずしい"],["者","もの"],["に"],["何に","なに"],["か"],["施させよう","ほどこさせよう"],["と"],["された"],["の"],["だ"],["と"],["思って","おもって"],["いた"],["。"]]},{"verse":30,"text":"ユダは一きれの食物,しょくもつを受,うけると、すぐに出,でて行,いった。時,ときは夜,よるであった。","tok":[["ユダ"],["は"],["一","いち"],["きれ"],["の"],["食物","しょくもつ"],["を"],["受る","うける"],["と"],["、"],["すぐ"],["に"],["出て","でて"],["行った","いった"],["。"],["時","とき"],["は"],["夜","よる"],["で"],["あった"],["。"]]},{"verse":31,"text":"さて、彼,かれが出,でて行,いくと、イエスは言,いわれた、「今,いまや人,ひとの子,こは栄光,えいこうを受,うけた。神,かみもまた彼,かれによって栄光,えいこうをお受,うけになった。","tok":[["さて"],["、"],["彼","かれ"],["が"],["出て","でて"],["行く","いく"],["と"],["、"],["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["今","いま"],["や"],["人","ひと"],["の"],["子","こ"],["は"],["栄光","えいこう"],["を"],["受た","うけた"],["。"],["神","かみ"],["も"],["また"],["彼","かれ"],["によって"],["栄光","えいこう"],["を"],["お受け","おうけ"],["に"],["なった"],["。"]]},{"verse":32,"text":"彼,かれによって栄光,えいこうをお受,うけになったのなら、神,かみご自身,じしんも彼,かれに栄光,えいこうをお授,さづけになるであろう。すぐにもお授,さづけになるであろう。","tok":[["彼","かれ"],["によって"],["栄光","えいこう"],["を"],["お受け","おうけ"],["に"],["なった"],["の"],["なら"],["、"],["神","かみ"],["ご自身","ごじしん"],["も"],["彼","かれ"],["に"],["栄光","えいこう"],["を"],["お"],["授","さづけ"],["に"],["なるで"],["あろう"],["。"],["すぐ"],["に"],["も"],["お授","おさづけ"],["に"],["なるで"],["あろう"],["。"]]},{"verse":33,"text":"子,こたちよ、わたしはまだしばらく、あなたがたと一緒,いっしょにいる。あなたがたはわたしを捜,さがすだろうが、すでにユダヤ人,じんたちに言,いったとおり、今,いまあなたがたにも言,いう、『あなたがたはわたしの行,いく所,ところに来,くることはできない』。","tok":[["子","こ"],["たち"],["よ"],["、"],["わたし"],["は"],["まだ"],["しばらく"],["、"],["あなた"],["がた"],["と"],["一緒","いっしょ"],["に"],["いる"],["。"],["あなた"],["がた"],["は"],["わたし"],["を"],["捜すだろう","さがすだろう"],["が"],["、"],["すでに"],["ユダヤ人","ゆだやじん"],["たち"],["に"],["言った","いった"],["とおり"],["、"],["今","いま"],["あなた"],["がた"],["に"],["も"],["言う","いう"],["、"],["『"],["あなた"],["がた"],["は"],["わたし"],["の"],["行く","いく"],["所","ところ"],["に"],["来る","くる"],["こと"],["は"],["できない"],["』"],["。"]]},{"verse":34,"text":"わたしは、新,あたらしいいましめをあなたがたに与,あたえる、互,たがいに愛,あいし合,あいなさい。わたしがあなたがたを愛,あいしたように、あなたがたも互,たがいに愛,あいし合,あいなさい。","tok":[["わたし"],["は"],["、"],["新らしい","あたらしい"],["いましめ"],["を"],["あなた"],["がた"],["に"],["与える","あたえる"],["、"],["互","たがい"],["に"],["愛し合い","あいしあい"],["なさい"],["。"],["わたし"],["が"],["あなた"],["がた"],["を"],["愛した","あいした"],["よう"],["に"],["、"],["あなた"],["がた"],["も"],["互","たがい"],["に"],["愛し合い","あいしあい"],["なさい"],["。"]]},{"verse":35,"text":"互,たがいに愛,あいし合,あうならば、それによって、あなたがたがわたしの弟子,でしであることを、すべての者,ものが認,みとめるであろう」。","tok":[["互","たがい"],["に"],["愛し合うならば","あいしあうならば"],["、"],["それ"],["によって"],["、"],["あなた"],["がた"],["が"],["わたし"],["の"],["弟子","でし"],["で"],["ある"],["こと"],["を"],["、"],["すべて"],["の"],["者","もの"],["が"],["認めるで","みとめるで"],["あろう"],["」"],["。"]]},{"verse":36,"text":"シモン・ペテロがイエスに言,いった、「主,しゅよ、どこへおいでになるのですか」。イエスは答,こたえられた、「あなたはわたしの行,いくところに、今,いまはついて来,くることはできない。しかし、あとになってから、ついて来,くることになろう」。","tok":[["シモン"],["・"],["ペテロ"],["が"],["イエス"],["に"],["言った","いった"],["、"],["「"],["主","しゅ"],["よ"],["、"],["どこ"],["へ"],["おいで"],["に"],["なる"],["の"],["です"],["か"],["」"],["。"],["イエス"],["は"],["答","こたえ"],["られた"],["、"],["「"],["あなた"],["は"],["わたし"],["の"],["行く","いく"],["ところ"],["に"],["、"],["今","いま"],["は"],["ついて"],["来る","くる"],["こと"],["は"],["できない"],["。"],["しかし"],["、"],["あと"],["に"],["なって"],["から"],["、"],["ついて"],["来る","くる"],["こと"],["に"],["なろう"],["」"],["。"]]},{"verse":37,"text":"ペテロはイエスに言,いった、「主,しゅよ、なぜ、今,いまあなたについて行,いくことができないのですか。あなたのためには、命,いのちも捨,すてます」。","tok":[["ペテロ"],["は"],["イエス"],["に"],["言った","いった"],["、"],["「"],["主","しゅ"],["よ"],["、"],["なぜ"],["、"],["今","いま"],["あなた"],["について"],["行く","いく"],["こと"],["が"],["できない"],["の"],["です"],["か"],["。"],["あなた"],["の"],["ため"],["に"],["は"],["、"],["命","いのち"],["も"],["捨てます","すてます"],["」"],["。"]]},{"verse":38,"text":"イエスは答,こたえられた、「わたしのために命,いのちを捨,すてると言,いうのか。よくよくあなたに言,いっておく。鶏,にわとりが鳴,なく前,まえに、あなたはわたしを三度,ど知,しらないと言,いうであろう」。","tok":[["イエス"],["は"],["答","こたえ"],["られた"],["、"],["「"],["わたし"],["の"],["ため"],["に"],["命","いのち"],["を"],["捨てる","すてる"],["と"],["言う","いう"],["の"],["か"],["。"],["よくよく"],["あなた"],["に"],["言って","いって"],["おく"],["。"],["鶏","にわとり"],["が"],["鳴く","なく"],["前","まえ"],["に"],["、"],["あなた"],["は"],["わたし"],["を"],["三","さん"],["度","ど"],["知らない","しらない"],["と"],["言うで","いうで"],["あろう"],["」"],["。"]]}]
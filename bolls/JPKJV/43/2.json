[{"verse":1,"text":"三日,か目,めにガリラヤのカナに婚礼,こんれいがあって、イエスの母,ははがそこにいた。","tok":[["三日目","かめ"],["に"],["ガリラヤ"],["の"],["カナ"],["に"],["婚礼","こんれい"],["が"],["あって"],["、"],["イエス"],["の"],["母","はは"],["が"],["そこ"],["に"],["いた"],["。"]]},{"verse":2,"text":"イエスも弟子,でしたちも、その婚礼,こんれいに招,まねかれた。","tok":[["イエス"],["も"],["弟子","でし"],["たち"],["も"],["、"],["その"],["婚礼","こんれい"],["に"],["招かれた","まねかれた"],["。"]]},{"verse":3,"text":"ぶどう酒,しゅがなくなったので、母,はははイエスに言,いった、「ぶどう酒,しゅがなくなってしまいました」。","tok":[["ぶどう酒","ぶどうしゅ"],["が"],["なくなった"],["ので"],["、"],["母","はは"],["は"],["イエス"],["に"],["言った","いった"],["、"],["「"],["ぶどう酒","ぶどうしゅ"],["が"],["なくなって"],["しまいました"],["」"],["。"]]},{"verse":4,"text":"イエスは母,ははに言,いわれた、「婦人,ふじんよ、あなたは、わたしと、なんの係,かかわりがありますか。わたしの時,ときは、まだきていません」。","tok":[["イエス"],["は"],["母","はは"],["に"],["言われた","いわれた"],["、"],["「"],["婦人","ふじん"],["よ"],["、"],["あなた"],["は"],["、"],["わたし"],["と"],["、"],["なん"],["の"],["係わり","かかわり"],["が"],["あります"],["か"],["。"],["わたし"],["の"],["時","とき"],["は"],["、"],["まだ"],["きて"],["いません"],["」"],["。"]]},{"verse":5,"text":"母,ははは僕,しもべたちに言,いった、「このかたが、あなたがたに言,いいつけることは、なんでもして下,ください」。","tok":[["母","はは"],["は"],["僕","し"],["も"],["べ"],["たち"],["に"],["言った","いった"],["、"],["「"],["このかた"],["が"],["、"],["あなた"],["がた"],["に"],["言いつける","いいつける"],["こと"],["は"],["、"],["なん"],["で"],["も"],["して"],["下さい","ください"],["」"],["。"]]},{"verse":6,"text":"そこには、ユダヤ人,じんのきよめのならわしに従,したがって、それぞれ四、五斗,ともはいる石,いしの水,みずがめが、六つ置,おいてあった。","tok":[["そこ"],["に"],["は"],["、"],["ユダヤ人","ゆだやじん"],["の"],["きよめ"],["の"],["ならわし"],["に"],["従って","したがって"],["、"],["それぞれ"],["四","よん"],["、"],["五斗","と"],["も"],["はいる"],["石","いし"],["の"],["水がめ","みずがめ"],["が"],["、"],["六","むい"],["つ"],["置いて","おいて"],["あった"],["。"]]},{"verse":7,"text":"イエスは彼,かれらに「かめに水,みずをいっぱい入,いれなさい」と言,いわれたので、彼,かれらは口,くちのところまでいっぱいに入,いれた。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["に"],["「"],["かめ"],["に"],["水","みず"],["を"],["いっぱい"],["入れ","いれ"],["なさい"],["」"],["と"],["言われた","いわれた"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["口","くち"],["の"],["ところ"],["まで"],["いっぱい"],["に"],["入れた","いれた"],["。"]]},{"verse":8,"text":"そこで彼,かれらに言,いわれた、「さあ、くんで、料理,りょうりがしらのところに持,もって行,いきなさい」。すると、彼,かれらは持,もって行,いった。","tok":[["そこ"],["で"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["さあ"],["、"],["くんで"],["、"],["料理","りょうり"],["が"],["しら"],["の"],["ところ"],["に"],["持って","もって"],["行き","いき"],["なさい"],["」"],["。"],["する"],["と"],["、"],["彼","かれ"],["ら"],["は"],["持って","もって"],["行った","いった"],["。"]]},{"verse":9,"text":"料理,りょうりがしらは、ぶどう酒,しゅになった水,みずをなめてみたが、それがどこからきたのか知,しらなかったので、（水,みずをくんだ僕,しもべたちは知,しっていた）花婿,はなむこを呼,よんで","tok":[["料理","りょうり"],["が"],["しら"],["は"],["、"],["ぶどう酒","ぶどうしゅ"],["に"],["なった"],["水","みず"],["を"],["なめて"],["みた"],["が"],["、"],["それ"],["が"],["どこ"],["から"],["きた"],["の"],["か"],["知らなかった","しらなかった"],["ので"],["、"],["（"],["水","みず"],["を"],["くんだ"],["僕","し"],["も"],["べ"],["たち"],["は"],["知って","しって"],["いた"],["）"],["花婿","はなむこ"],["を"],["呼んで","よんで"]]},{"verse":10,"text":"言,いった、「どんな人,ひとでも、初,はじめによいぶどう酒,しゅを出,だして、酔,よいがまわったころにわるいのを出,だすものだ。それだのに、あなたはよいぶどう酒,しゅを今,いままでとっておかれました」。","tok":[["言った","いった"],["、"],["「"],["どんな"],["人","ひと"],["で"],["も"],["、"],["初め","はじめ"],["に"],["よい"],["ぶどう酒","ぶどうしゅ"],["を"],["出して","だして"],["、"],["酔","よい"],["が"],["まわった"],["ころ"],["に"],["わるい"],["の"],["を"],["出す","だす"],["もの"],["だ"],["。"],["それ"],["だ"],["のに"],["、"],["あなた"],["は"],["よい"],["ぶどう酒","ぶどうしゅ"],["を"],["今まで","いままで"],["とって"],["おかれました"],["」"],["。"]]},{"verse":11,"text":"イエスは、この最初,さいしょのしるしをガリラヤのカナで行,おこない、その栄光,えいこうを現,あらわされた。そして弟子,でしたちはイエスを信,しんじた。","tok":[["イエス"],["は"],["、"],["この"],["最初","さいしょ"],["の"],["しるし"],["を"],["ガリラヤ"],["の"],["カナ"],["で"],["行ない","おこない"],["、"],["その"],["栄光","えいこう"],["を"],["現わされた","あらわされた"],["。"],["そして"],["弟子","でし"],["たち"],["は"],["イエス"],["を"],["信じた","しんじた"],["。"]]},{"verse":12,"text":"そののち、イエスは、その母,はは、兄弟,きょうだいたち、弟子,でしたちと一緒,いっしょに、カペナウムに下,くだって、幾日,いくにちかそこにとどまられた。","tok":[["その"],["のち"],["、"],["イエス"],["は"],["、"],["その"],["母","はは"],["、"],["兄弟","きょうだい"],["たち"],["、"],["弟子","でし"],["たち"],["と"],["一緒","いっしょ"],["に"],["、"],["カペナウム"],["に"],["下って","くだって"],["、"],["幾日","いくにちかそこ"],["に"],["とどまられた"],["。"]]},{"verse":13,"text":"さて、ユダヤ人,じんの過越,すぎこしの祭,まつりが近,ちかづいたので、イエスはエルサレムに上,のぼられた。","tok":[["さて"],["、"],["ユダヤ人","ゆだやじん"],["の"],["過越","すぎこし"],["の"],["祭","まつり"],["が"],["近づいた","ちかづいた"],["ので"],["、"],["イエス"],["は"],["エルサレム"],["に"],["上られた","のぼられた"],["。"]]},{"verse":14,"text":"そして牛,うし、羊,ひつじ、はとを売,うる者,ものや両替,りょうがえする者,ものなどが宮,みやの庭,にわにすわり込,こんでいるのをごらんになって、","tok":[["そして"],["牛","うし"],["、"],["羊","ひつじ"],["、"],["はと"],["を"],["売る","うる"],["者","もの"],["や"],["両替","りょうがえ"],["する"],["者","もの"],["など"],["が"],["宮","みや"],["の"],["庭","にわ"],["に"],["すわり"],["込","こんでいる"],["の"],["を"],["ごらん"],["に"],["なって"],["、"]]},{"verse":15,"text":"なわでむちを造,つくり、羊,ひつじも牛,うしもみな宮,みやから追,おいだし、両替人,りょうがえにんの金,かねを散,ちらし、その台,だいをひっくりかえし、","tok":[["なわ"],["で"],["むち"],["を"],["造","つくり"],["、"],["羊","ひつじ"],["も"],["牛","うし"],["も"],["みな"],["宮","みや"],["から"],["追いだし","おいだし"],["、"],["両替人","りょうがえにん"],["の"],["金","かね"],["を"],["散らし","ちらし"],["、"],["その"],["台","だい"],["を"],["ひっくりかえし"],["、"]]},{"verse":16,"text":"はとを売,うる人々,ひとびとには「これらのものを持,もって、ここから出,でて行,いけ。わたしの父,ちちの家,いえを商売,しょうばいの家,いえとするな」と言,いわれた。","tok":[["はと"],["を"],["売る","うる"],["人々","ひとびと"],["に"],["は"],["「"],["これ"],["ら"],["の"],["もの"],["を"],["持って","もって"],["、"],["ここ"],["から"],["出て","でて"],["行け","いけ"],["。"],["わたし"],["の"],["父","ちち"],["の"],["家","いえ"],["を"],["商売","しょうばい"],["の"],["家","いえ"],["と"],["する"],["な"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":17,"text":"弟子,でしたちは、「あなたの家,いえを思,おもう熱心,ねっしんが、わたしを食,くいつくすであろう」と書,かいてあることを思,おもい出,だした。","tok":[["弟子","でし"],["たち"],["は"],["、"],["「"],["あなた"],["の"],["家","いえ"],["を"],["思う","おもう"],["熱心","ねっしん"],["が"],["、"],["わたし"],["を"],["食い","くい"],["つくすで"],["あろう"],["」"],["と"],["書いて","かいて"],["ある"],["こと"],["を"],["思い出した","おもいだした"],["。"]]},{"verse":18,"text":"そこで、ユダヤ人,じんはイエスに言,いった、「こんなことをするからには、どんなしるしをわたしたちに見,みせてくれますか」。","tok":[["そこ"],["で"],["、"],["ユダヤ人","ゆだやじん"],["は"],["イエス"],["に"],["言った","いった"],["、"],["「"],["こんな"],["こと"],["を"],["する"],["から"],["に"],["は"],["、"],["どんな"],["しるし"],["を"],["わたしたち"],["に"],["見せて","みせて"],["くれます"],["か"],["」"],["。"]]},{"verse":19,"text":"イエスは彼,かれらに答,こたえて言,いわれた、「この神殿,しんでんをこわしたら、わたしは三日,かのうちに、それを起,おこすであろう」。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["に"],["答","こたえ"],["て"],["言われた","いわれた"],["、"],["「"],["この"],["神殿","しんでん"],["を"],["こわしたら"],["、"],["わたし"],["は"],["三日","か"],["の"],["うち"],["に"],["、"],["それ"],["を"],["起こすで","おこすで"],["あろう"],["」"],["。"]]},{"verse":20,"text":"そこで、ユダヤ人,じんたちは言,いった、「この神殿,しんでんを建,たてるのには、四十六年,ねんもかかっています。それだのに、あなたは三日,かのうちに、それを建,たてるのですか」。","tok":[["そこ"],["で"],["、"],["ユダヤ人","ゆだやじん"],["たち"],["は"],["言った","いった"],["、"],["「"],["この"],["神殿","しんでん"],["を"],["建てる","たてる"],["のに"],["は"],["、"],["四十六","よんじゅうろく"],["年","ねん"],["も"],["かかって"],["います"],["。"],["それ"],["だ"],["のに"],["、"],["あなた"],["は"],["三日","か"],["の"],["うち"],["に"],["、"],["それ"],["を"],["建てる","たてる"],["の"],["です"],["か"],["」"],["。"]]},{"verse":21,"text":"イエスは自分,じぶんのからだである神殿,しんでんのことを言,いわれたのである。","tok":[["イエス"],["は"],["自分","じぶん"],["の"],["からだ"],["で"],["ある"],["神殿","しんでん"],["の"],["こと"],["を"],["言われた","いわれた"],["ので"],["ある"],["。"]]},{"verse":22,"text":"それで、イエスが死人,しにんの中,なかからよみがえったとき、弟子,でしたちはイエスがこう言,いわれたことを思,おもい出,だして、聖書,せいしょとイエスのこの言葉,ことばとを信,しんじた。","tok":[["それ"],["で"],["、"],["イエス"],["が"],["死人","しにん"],["の"],["中","なか"],["から"],["よみがえった"],["とき"],["、"],["弟子","でし"],["たち"],["は"],["イエス"],["が"],["こう"],["言われた","いわれた"],["こと"],["を"],["思い出して","おもいだして"],["、"],["聖書","せいしょ"],["と"],["イエス"],["の"],["この"],["言葉","ことば"],["と"],["を"],["信じた","しんじた"],["。"]]},{"verse":23,"text":"過越,すぎこしの祭,まつりの間,あいだ、イエスがエルサレムに滞在,たいざいしておられたとき、多,おおくの人々,ひとびとは、その行,おこなわれたしるしを見,みて、イエスの名,なを信,しんじた。","tok":[["過越","すぎこし"],["の"],["祭","まつり"],["の"],["間","あいだ"],["、"],["イエス"],["が"],["エルサレム"],["に"],["滞在","たいざい"],["して"],["おられた"],["とき"],["、"],["多く","おおく"],["の"],["人々","ひとびと"],["は"],["、"],["その"],["行なわれた","おこなわれた"],["しるし"],["を"],["見て","みて"],["、"],["イエス"],["の"],["名","な"],["を"],["信じた","しんじた"],["。"]]},{"verse":24,"text":"しかしイエスご自身,じしんは、彼,かれらに自分,じぶんをお任,まかせにならなかった。それは、すべての人,ひとを知,しっておられ、","tok":[["しかし"],["イエス"],["ご自身","ごじしん"],["は"],["、"],["彼","かれ"],["ら"],["に"],["自分","じぶん"],["を"],["お任せ","おまかせ"],["に"],["ならなかった"],["。"],["それ"],["は"],["、"],["すべて"],["の"],["人","ひと"],["を"],["知って","しって"],["おられ"],["、"]]},{"verse":25,"text":"また人,ひとについてあかしする者,ものを、必要,ひつようとされなかったからである。それは、ご自身,じしん人,ひとの心,こころの中,なかにあることを知,しっておられたからである。","tok":[["また"],["人","ひと"],["について"],["あかし"],["する"],["者","もの"],["を"],["、"],["必要","ひつよう"],["と"],["されなかった"],["から"],["で"],["ある"],["。"],["それ"],["は"],["、"],["ご自身人","ごじしんひと"],["の"],["心","こころ"],["の"],["中","なか"],["に"],["ある"],["こと"],["を"],["知って","しって"],["おられた"],["から"],["で"],["ある"],["。"]]}]
[{"verse":1,"text":"よくよくあなたがたに言,いっておく。羊,ひつじの囲,かこいにはいるのに、門,もんからでなく、ほかの所,ところからのりこえて来,くる者,ものは、盗人,ぬすびとであり、強盗,ごうとうである。","tok":[["よくよく"],["あなた"],["がた"],["に"],["言って","いって"],["おく"],["。"],["羊","ひつじ"],["の"],["囲","かこい"],["に"],["は"],["いる"],["のに"],["、"],["門","もん"],["から"],["で"],["なく"],["、"],["ほか"],["の"],["所","ところ"],["から"],["のりこえて"],["来る","くる"],["者","もの"],["は"],["、"],["盗人","ぬすびと"],["で"],["あり"],["、"],["強盗","ごうとう"],["で"],["ある"],["。"]]},{"verse":2,"text":"門,もんからはいる者,ものは、羊,ひつじの羊飼,ひつじかいである。","tok":[["門","もん"],["から"],["は"],["いる"],["者","もの"],["は"],["、"],["羊","ひつじ"],["の"],["羊飼","ひつじかい"],["で"],["ある"],["。"]]},{"verse":3,"text":"門番,もんばんは彼,かれのために門,もんを開,ひらき、羊,ひつじは彼,かれの声,こえを聞,きく。そして彼,かれは自分,じぶんの羊,ひつじの名,なをよんで連,つれ出,だす。","tok":[["門番","もんばん"],["は"],["彼","かれ"],["の"],["ため"],["に"],["門","もん"],["を"],["開らき","ひらき"],["、"],["羊","ひつじ"],["は"],["彼","かれ"],["の"],["声","こえ"],["を"],["聞く","きく"],["。"],["そして"],["彼","かれ"],["は"],["自分","じぶん"],["の"],["羊","ひつじ"],["の"],["名","な"],["を"],["よんで"],["連れ出す","つれだす"],["。"]]},{"verse":4,"text":"自分,じぶんの羊,ひつじをみな出,だしてしまうと、彼,かれは羊,ひつじの先頭,せんとうに立,たって行,いく。羊,ひつじはその声,こえを知,しっているので、彼,かれについて行,いくのである。","tok":[["自分","じぶん"],["の"],["羊","ひつじ"],["を"],["みな"],["出して","だして"],["しまう"],["と"],["、"],["彼","かれ"],["は"],["羊","ひつじ"],["の"],["先頭","せんとう"],["に"],["立って","たって"],["行く","いく"],["。"],["羊","ひつじ"],["は"],["その"],["声","こえ"],["を"],["知って","しって"],["いる"],["ので"],["、"],["彼","かれ"],["について"],["行く","いく"],["ので"],["ある"],["。"]]},{"verse":5,"text":"ほかの人,ひとには、ついて行,いかないで逃,にげ去,さる。その人,ひとの声,こえを知,しらないからである」。","tok":[["ほか"],["の"],["人","ひと"],["に"],["は"],["、"],["ついて"],["行かないで","いかないで"],["逃","にげ"],["去る","さる"],["。"],["その"],["人","ひと"],["の"],["声","こえ"],["を"],["知らない","しらない"],["から"],["で"],["ある"],["」"],["。"]]},{"verse":6,"text":"イエスは彼,かれらにこの比喩,ひゆを話,はなされたが、彼,かれらは自分,じぶんたちにお話,はなしになっているのが何,なにのことだか、わからなかった。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["に"],["この"],["比喩","ひゆ"],["を"],["話された","はなされた"],["が"],["、"],["彼","かれ"],["ら"],["は"],["自分","じぶん"],["たち"],["に"],["お話","おはなし"],["に"],["なって"],["いる"],["の"],["が"],["何に","なに"],["の"],["こと"],["だ"],["か"],["、"],["わからなかった"],["。"]]},{"verse":7,"text":"そこで、イエスはまた言,いわれた、「よくよくあなたがたに言,いっておく。わたしは羊,ひつじの門,もんである。","tok":[["そこ"],["で"],["、"],["イエス"],["は"],["また"],["言われた","いわれた"],["、"],["「"],["よくよく"],["あなた"],["がた"],["に"],["言って","いって"],["おく"],["。"],["わたし"],["は"],["羊","ひつじ"],["の"],["門","もん"],["で"],["ある"],["。"]]},{"verse":8,"text":"わたしよりも前,まえにきた人,ひとは、みな盗人,ぬすびとであり、強盗,ごうとうである。羊,ひつじは彼,かれらに聞,きき従,したがわなかった。","tok":[["わたし"],["より"],["も"],["前","まえ"],["に"],["きた"],["人","ひと"],["は"],["、"],["みな"],["盗人","ぬすびと"],["で"],["あり"],["、"],["強盗","ごうとう"],["で"],["ある"],["。"],["羊","ひつじ"],["は"],["彼","かれ"],["ら"],["に"],["聞","きき"],["従わなかった","したがわなかった"],["。"]]},{"verse":9,"text":"わたしは門,もんである。わたしをとおってはいる者,ものは救,すくわれ、また出入,でいりし、牧草,ぼくそうにありつくであろう。","tok":[["わたし"],["は"],["門","もん"],["で"],["ある"],["。"],["わたし"],["を"],["とおっ"],["ては"],["いる"],["者","もの"],["は"],["救われ","すくわれ"],["、"],["また"],["出入","でいり"],["し"],["、"],["牧草","ぼくそう"],["に"],["ありつくで"],["あろう"],["。"]]},{"verse":10,"text":"盗人,ぬすびとが来,くるのは、盗,ぬすんだり、殺,ころしたり、滅,ほろぼしたりするためにほかならない。わたしがきたのは、羊,ひつじに命,いのちを得,えさせ、豊,ゆたかに得,えさせるためである。","tok":[["盗人","ぬすびと"],["が"],["来る","くる"],["の"],["は"],["、"],["盗","ぬ"],["すん"],["だり"],["、"],["殺ろし","ころし"],["たり"],["、"],["滅ぼし","ほろぼし"],["たり"],["する"],["ため"],["に"],["ほか"],["ならない"],["。"],["わたし"],["が"],["きた"],["の"],["は"],["、"],["羊","ひつじ"],["に"],["命","いのち"],["を"],["得させ","えさせ"],["、"],["豊","ゆたか"],["に"],["得させる","えさせる"],["ため"],["で"],["ある"],["。"]]},{"verse":11,"text":"わたしはよい羊飼,ひつじかいである。よい羊飼,ひつじかいは、羊,ひつじのために命,いのちを捨,すてる。","tok":[["わたし"],["は"],["よい"],["羊飼","ひつじかい"],["で"],["ある"],["。"],["よい"],["羊飼","ひつじかい"],["は"],["、"],["羊","ひつじ"],["の"],["ため"],["に"],["命","いのち"],["を"],["捨てる","すてる"],["。"]]},{"verse":12,"text":"羊飼,ひつじかいではなく、羊,ひつじが自分,じぶんのものでもない雇人,やといにんは、おおかみが来,くるのを見,みると、羊,ひつじをすてて逃,にげ去,さる。そして、おおかみは羊,ひつじを奪,うばい、また追,おい散,ちらす。","tok":[["羊飼","ひつじかい"],["で"],["は"],["なく"],["、"],["羊","ひつじ"],["が"],["自分","じぶん"],["の"],["もの"],["で"],["も"],["ない"],["雇人","やといにん"],["は"],["、"],["おおかみ"],["が"],["来る","くる"],["の"],["を"],["見る","みる"],["と"],["、"],["羊","ひつじ"],["を"],["すてて"],["逃","にげ"],["去る","さる"],["。"],["そして"],["、"],["おおかみ"],["は"],["羊","ひつじ"],["を"],["奪い","うばい"],["、"],["また"],["追い散らす","おいちらす"],["。"]]},{"verse":13,"text":"彼,かれは雇人,やといにんであって、羊,ひつじのことを心,こころにかけていないからである。","tok":[["彼","かれ"],["は"],["雇人","やといにん"],["で"],["あって"],["、"],["羊","ひつじ"],["の"],["こと"],["を"],["心","こころ"],["に"],["かけて"],["いない"],["から"],["で"],["ある"],["。"]]},{"verse":14,"text":"わたしはよい羊飼,ひつじかいであって、わたしの羊,ひつじを知,しり、わたしの羊,ひつじはまた、わたしを知,しっている。","tok":[["わたし"],["は"],["よい"],["羊飼","ひつじかい"],["で"],["あって"],["、"],["わたし"],["の"],["羊","ひつじ"],["を"],["知り","しり"],["、"],["わたし"],["の"],["羊","ひつじ"],["は"],["また"],["、"],["わたし"],["を"],["知って","しって"],["いる"],["。"]]},{"verse":15,"text":"それはちょうど、父,ちちがわたしを知,しっておられ、わたしが父,ちちを知,しっているのと同,おなじである。そして、わたしは羊,ひつじのために命,いのちを捨,すてるのである。","tok":[["それ"],["は"],["ちょうど"],["、"],["父","ちち"],["が"],["わたし"],["を"],["知って","しって"],["おられ"],["、"],["わたし"],["が"],["父","ちち"],["を"],["知って","しって"],["いる"],["の"],["と"],["同じ","おなじ"],["で"],["ある"],["。"],["そして"],["、"],["わたし"],["は"],["羊","ひつじ"],["の"],["ため"],["に"],["命","いのち"],["を"],["捨てる","すてる"],["ので"],["ある"],["。"]]},{"verse":16,"text":"わたしにはまた、この囲,かこいにいない他,たの羊,ひつじがある。わたしは彼,かれらをも導,みちびかねばならない。彼,かれらも、わたしの声,こえに聞,きき従,したがうであろう。そして、ついに一つの群,むれ、ひとりの羊飼,ひつじかいとなるであろう。","tok":[["わたし"],["に"],["は"],["また"],["、"],["この"],["囲","かこい"],["に"],["いない"],["他","た"],["の"],["羊","ひつじ"],["が"],["ある"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["も"],["導かねば","みちびかねば"],["ならない"],["。"],["彼","かれ"],["ら"],["も"],["、"],["わたし"],["の"],["声","こえ"],["に"],["聞","きき"],["従うで","したがうで"],["あろう"],["。"],["そして"],["、"],["ついに"],["一","ひと"],["つ"],["の"],["群れ","むれ"],["、"],["ひとり"],["の"],["羊飼","ひつじかい"],["と"],["なるで"],["あろう"],["。"]]},{"verse":17,"text":"父,ちちは、わたしが自分,じぶんの命,いのちを捨,すてるから、わたしを愛,あいして下,くださるのである。命,いのちを捨,すてるのは、それを再,ふたたび得,えるためである。","tok":[["父","ちち"],["は"],["、"],["わたし"],["が"],["自分","じぶん"],["の"],["命","いのち"],["を"],["捨てる","すてる"],["から"],["、"],["わたし"],["を"],["愛して","あいして"],["下さる","くださる"],["ので"],["ある"],["。"],["命","いのち"],["を"],["捨てる","すてる"],["の"],["は"],["、"],["それ"],["を"],["再び","ふたたび"],["得る","える"],["ため"],["で"],["ある"],["。"]]},{"verse":18,"text":"だれかが、わたしからそれを取,とり去,さるのではない。わたしが、自分,じぶんからそれを捨,すてるのである。わたしには、それを捨,すてる力,ちからがあり、またそれを受,うける力,ちからもある。これはわたしの父,ちちから授,さずかった定,さだめである」。","tok":[["だれ"],["か"],["が"],["、"],["わたし"],["から"],["それ"],["を"],["取去る","とりさる"],["ので"],["は"],["ない"],["。"],["わたし"],["が"],["、"],["自分","じぶん"],["から"],["それ"],["を"],["捨てる","すてる"],["ので"],["ある"],["。"],["わたし"],["に"],["は"],["、"],["それ"],["を"],["捨てる","すてる"],["力","ちから"],["が"],["あり"],["、"],["また"],["それ"],["を"],["受る","うける"],["力","ちから"],["も"],["ある"],["。"],["これ"],["は"],["わたし"],["の"],["父","ちち"],["から"],["授かった","さずかった"],["定め","さだめ"],["で"],["ある"],["」"],["。"]]},{"verse":19,"text":"これらの言葉,ことばを語,かたられたため、ユダヤ人,じんの間,あいだにまたも分争,ぶんそうが生,しょうじた。","tok":[["これ"],["ら"],["の"],["言葉","ことば"],["を"],["語られた","かたられた"],["ため"],["、"],["ユダヤ人","ゆだやじん"],["の"],["間","あいだ"],["に"],["また"],["も"],["分争","ぶんそう"],["が"],["生じた","しょうじた"],["。"]]},{"verse":20,"text":"そのうちの多,おおくの者,ものが言,いった、「彼,かれは悪霊,あくれいに取,とりつかれて、気,きが狂,くるっている。どうして、あなたがたはその言,いうことを聞,きくのか」。","tok":[["その"],["うち"],["の"],["多く","おおく"],["の"],["者","もの"],["が"],["言った","いった"],["、"],["「"],["彼","かれ"],["は"],["悪霊","あくれい"],["に"],["取","とり"],["つかれて"],["、"],["気","き"],["が"],["狂って","くるって"],["いる"],["。"],["どう"],["して"],["、"],["あなた"],["がた"],["は"],["その"],["言う","いう"],["こと"],["を"],["聞く","きく"],["の"],["か"],["」"],["。"]]},{"verse":21,"text":"他,たの人々,ひとびとは言,いった、「それは悪霊,あくれいに取,とりつかれた者,ものの言葉,ことばではない。悪霊,あくれいは盲人,もうじんの目,めをあけることができようか」。","tok":[["他","た"],["の"],["人々","ひとびと"],["は"],["言った","いった"],["、"],["「"],["それ"],["は"],["悪霊","あくれい"],["に"],["取","とり"],["つかれた"],["者","もの"],["の"],["言葉","ことば"],["で"],["は"],["ない"],["。"],["悪霊","あくれい"],["は"],["盲人","もうじん"],["の"],["目","め"],["を"],["あける"],["こと"],["が"],["できよう"],["か"],["」"],["。"]]},{"verse":22,"text":"そのころ、エルサレムで宮,みやきよめの祭,まつりが行,おこなわれた。時,ときは冬,ふゆであった。","tok":[["その"],["ころ"],["、"],["エルサレム"],["で"],["宮","みや"],["きよめ"],["の"],["祭","まつり"],["が"],["行なわれた","おこなわれた"],["。"],["時","とき"],["は"],["冬","ふゆ"],["で"],["あった"],["。"]]},{"verse":23,"text":"イエスは、宮,みやの中,なかにあるソロモンの廊,ろうを歩,あるいておられた。","tok":[["イエス"],["は"],["、"],["宮","みや"],["の"],["中","なか"],["に"],["ある"],["ソロモン"],["の"],["廊","ろう"],["を"],["歩いて","あるいて"],["おられた"],["。"]]},{"verse":24,"text":"するとユダヤ人,じんたちが、イエスを取,とり囲,かこんで言,いった、「いつまでわたしたちを不安,ふあんのままにしておくのか。あなたがキリストであるなら、そうとはっきり言,いっていただきたい」。","tok":[["する"],["と"],["ユダヤ人","ゆだやじん"],["たち"],["が"],["、"],["イエス"],["を"],["取囲んで","とりかこんで"],["言った","いった"],["、"],["「"],["いつ"],["まで"],["わたしたち"],["を"],["不安","ふあん"],["の"],["まま"],["に"],["して"],["おく"],["の"],["か"],["。"],["あなた"],["が"],["キリスト"],["で"],["あるなら"],["、"],["そう"],["と"],["はっきり"],["言って","いって"],["いただきたい"],["」"],["。"]]},{"verse":25,"text":"イエスは彼,かれらに答,こたえられた、「わたしは話,はなしたのだが、あなたがたは信,しんじようとしない。わたしの父,ちちの名,なによってしているすべてのわざが、わたしのことをあかししている。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["に"],["答","こたえ"],["られた"],["、"],["「"],["わたし"],["は"],["話","はなし"],["た"],["の"],["だ"],["が"],["、"],["あなた"],["がた"],["は"],["信じよう","しんじよう"],["と"],["しない"],["。"],["わたし"],["の"],["父","ちち"],["の"],["名","な"],["によって"],["して"],["いる"],["すべて"],["の"],["わざ"],["が"],["、"],["わたし"],["の"],["こと"],["を"],["あかし"],["して"],["いる"],["。"]]},{"verse":26,"text":"あなたがたが信,しんじないのは、わたしの羊,ひつじでないからである。","tok":[["あなた"],["がた"],["が"],["信じない","しんじない"],["の"],["は"],["、"],["わたし"],["の"],["羊","ひつじ"],["で"],["ない"],["から"],["で"],["ある"],["。"]]},{"verse":27,"text":"わたしの羊,ひつじはわたしの声,こえに聞,きき従,したがう。わたしは彼,かれらを知,しっており、彼,かれらはわたしについて来,くる。","tok":[["わたし"],["の"],["羊","ひつじ"],["は"],["わたし"],["の"],["声","こえ"],["に"],["聞","きき"],["従う","したがう"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["知って","しって"],["おり"],["、"],["彼","かれ"],["ら"],["は"],["わたし"],["について"],["来る","くる"],["。"]]},{"verse":28,"text":"わたしは、彼,かれらに永遠,えいえんの命,いのちを与,あたえる。だから、彼,かれらはいつまでも滅,ほろびることがなく、また、彼,かれらをわたしの手,てから奪,うばい去,さる者,ものはない。","tok":[["わたし"],["は"],["、"],["彼","かれ"],["ら"],["に"],["永遠","えいえん"],["の"],["命","いのち"],["を"],["与える","あたえる"],["。"],["だ"],["から"],["、"],["彼","かれ"],["ら"],["は"],["いつ"],["まで"],["も"],["滅びる","ほろびる"],["こと"],["が"],["なく"],["、"],["また"],["、"],["彼","かれ"],["ら"],["を"],["わたし"],["の"],["手","て"],["から"],["奪い去る","うばいさる"],["者","もの"],["は"],["ない"],["。"]]},{"verse":29,"text":"わたしの父,ちちがわたしに下,くださったものは、すべてにまさるものである。そしてだれも父,ちちのみ手,てから、それを奪,うばい取,とることはできない。","tok":[["わたし"],["の"],["父","ちち"],["が"],["わたし"],["に"],["下さった","くださった"],["もの"],["は"],["、"],["すべて"],["に"],["まさる"],["もの"],["で"],["ある"],["。"],["そして"],["だれ"],["も"],["父","ちち"],["のみ"],["手","て"],["から"],["、"],["それ"],["を"],["奪い取る","うばいとる"],["こと"],["は"],["できない"],["。"]]},{"verse":30,"text":"わたしと父,ちちとは一つである」。","tok":[["わたし"],["と"],["父","ちち"],["と"],["は"],["一","ひと"],["つ"],["で"],["ある"],["」"],["。"]]},{"verse":31,"text":"そこでユダヤ人,じんたちは、イエスを打,うち殺,ころそうとして、また石,いしを取,とりあげた。","tok":[["そこ"],["で"],["ユダヤ人","ゆだやじん"],["たち"],["は"],["、"],["イエス"],["を"],["打ち殺そう","うちころそう"],["として"],["、"],["また"],["石","いし"],["を"],["取","とり"],["あげた"],["。"]]},{"verse":32,"text":"するとイエスは彼,かれらに答,こたえられた、「わたしは、父,ちちによる多,おおくのよいわざを、あなたがたに示,しめした。その中,なかのどのわざのために、わたしを石,いしで打,うち殺,ころそうとするのか」。","tok":[["する"],["と"],["イエス"],["は"],["彼","かれ"],["ら"],["に"],["答","こたえ"],["られた"],["、"],["「"],["わたし"],["は"],["、"],["父","ちち"],["に"],["よる"],["多く","おおく"],["の"],["よい"],["わざ"],["を"],["、"],["あなた"],["がた"],["に"],["示めした","しめした"],["。"],["その"],["中","なか"],["の"],["どの"],["わざ"],["の"],["ため"],["に"],["、"],["わたし"],["を"],["石","いし"],["で"],["打ち殺そう","うちころそう"],["と"],["する"],["の"],["か"],["」"],["。"]]},{"verse":33,"text":"ユダヤ人,じんたちは答,こたえた、「あなたを石,いしで殺,ころそうとするのは、よいわざをしたからではなく、神,かみを汚,けがしたからである。また、あなたは人間,にんげんであるのに、自分,じぶんを神,かみとしているからである」。","tok":[["ユダヤ人","ゆだやじん"],["たち"],["は"],["答","こたえ"],["た"],["、"],["「"],["あなた"],["を"],["石","いし"],["で"],["殺そう","ころそう"],["と"],["する"],["の"],["は"],["、"],["よい"],["わざ"],["を"],["した"],["から"],["で"],["は"],["なく"],["、"],["神","かみ"],["を"],["汚","け"],["がした"],["から"],["で"],["ある"],["。"],["また"],["、"],["あなた"],["は"],["人間","にんげん"],["で"],["ある"],["のに"],["、"],["自分","じぶん"],["を"],["神","かみ"],["として"],["いる"],["から"],["で"],["ある"],["」"],["。"]]},{"verse":34,"text":"イエスは彼,かれらに答,こたえられた、「あなたがたの律法,りっぽうに、『わたしは言,いう、あなたがたは神々,かみがみである』と書,かいてあるではないか。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["に"],["答","こたえ"],["られた"],["、"],["「"],["あなた"],["がた"],["の"],["律法","りっぽう"],["に"],["、"],["『"],["わたし"],["は"],["言う","いう"],["、"],["あなた"],["がた"],["は"],["神々","かみがみ"],["で"],["ある"],["』"],["と"],["書いて","かいて"],["ある"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":35,"text":"神,かみの言,ことばを託,たくされた人々,ひとびとが、神々,かみがみといわれておるとすれば、（そして聖書,せいしょの言,ことばは、すたることがあり得,えない）","tok":[["神","かみ"],["の"],["言","ことば"],["を"],["託された","たくされた"],["人々","ひとびと"],["が"],["、"],["神々","かみがみ"],["と"],["いわれて"],["おる"],["と"],["すれば"],["、"],["（"],["そして"],["聖書","せいしょ"],["の"],["言","ことば"],["は"],["、"],["すたる"],["こと"],["が"],["あり"],["得ない","えない"],["）"]]},{"verse":36,"text":"父,ちちが聖,せい別,べつして、世,よにつかわされた者,ものが、『わたしは神,かみの子,こである』と言,いったからとて、どうして『あなたは神,かみを汚,けがす者,ものだ』と言,いうのか。","tok":[["父","ちち"],["が"],["聖別","せいべつ"],["して"],["、"],["世","よ"],["に"],["つかわされた"],["者","もの"],["が"],["、"],["『"],["わたし"],["は"],["神","かみ"],["の"],["子","こ"],["で"],["ある"],["』"],["と"],["言った","いった"],["から"],["とて"],["、"],["どう"],["して"],["『"],["あなた"],["は"],["神","かみ"],["を"],["汚","け"],["がす"],["者","もの"],["だ"],["』"],["と"],["言う","いう"],["の"],["か"],["。"]]},{"verse":37,"text":"もしわたしが父,ちちのわざを行,おこなわないとすれば、わたしを信,しんじなくてもよい。","tok":[["もし"],["わたし"],["が"],["父","ちち"],["の"],["わざ"],["を"],["行なわない","おこなわない"],["と"],["すれば"],["、"],["わたし"],["を"],["信じなくて","しんじなくて"],["も"],["よい"],["。"]]},{"verse":38,"text":"しかし、もし行,おこなっているなら、たといわたしを信,しんじなくても、わたしのわざを信,しんじるがよい。そうすれば、父,ちちがわたしにおり、また、わたしが父,ちちにおることを知,しって悟,さとるであろう」。","tok":[["しかし"],["、"],["もし"],["行なって","おこなって"],["いるなら"],["、"],["たとい"],["わたし"],["を"],["信じなくて","しんじなくて"],["も"],["、"],["わたし"],["の"],["わざ"],["を"],["信じる","しんじる"],["が"],["よい"],["。"],["そう"],["すれば"],["、"],["父","ちち"],["が"],["わたし"],["に"],["おり"],["、"],["また"],["、"],["わたし"],["が"],["父","ちち"],["に"],["おる"],["こと"],["を"],["知って","しって"],["悟","さとる"],["で"],["あろう"],["」"],["。"]]},{"verse":39,"text":"そこで、彼,かれらはまたイエスを捕,とらえようとしたが、イエスは彼,かれらの手,てをのがれて、去,さって行,いかれた。","tok":[["そこ"],["で"],["、"],["彼","かれ"],["ら"],["は"],["また"],["イエス"],["を"],["捕らえよう","とらえよう"],["と"],["した"],["が"],["、"],["イエス"],["は"],["彼","かれ"],["ら"],["の"],["手","て"],["を"],["のがれて"],["、"],["去て","さって"],["行かれた","いかれた"],["。"]]},{"verse":40,"text":"さて、イエスはまたヨルダンの向,むこう岸,ぎし、すなわち、ヨハネが初,はじめにバプテスマを授,さづけていた所,ところに行,いき、そこに滞在,たいざいしておられた。","tok":[["さて"],["、"],["イエス"],["は"],["また"],["ヨルダン"],["の"],["向こう岸","むこうぎし"],["、"],["すなわち"],["、"],["ヨハネ"],["が"],["初め","はじめ"],["に"],["バプテスマ"],["を"],["授","さ"],["づけて"],["いた"],["所","ところ"],["に"],["行き","いき"],["、"],["そこ"],["に"],["滞在","たいざい"],["して"],["おられた"],["。"]]},{"verse":41,"text":"多,おおくの人々,ひとびとがイエスのところにきて、互,たがいに言,いった、「ヨハネはなんのしるしも行,おこなわなかったが、ヨハネがこのかたについて言,いったことは、皆,みなほんとうであった」。","tok":[["多く","おおく"],["の"],["人々","ひとびと"],["が"],["イエス"],["の"],["ところ"],["に"],["きて"],["、"],["互","たがい"],["に"],["言った","いった"],["、"],["「"],["ヨハネ"],["は"],["なん"],["の"],["しるし"],["も"],["行なわなかった","おこなわなかった"],["が"],["、"],["ヨハネ"],["が"],["このかた"],["について"],["言った","いった"],["こと"],["は"],["、"],["皆","みな"],["ほんとう"],["で"],["あった"],["」"],["。"]]},{"verse":42,"text":"そして、そこで多,おおくの者,ものがイエスを信,しんじた。","tok":[["そして"],["、"],["そこ"],["で"],["多く","おおく"],["の"],["者","もの"],["が"],["イエス"],["を"],["信じた","しんじた"],["。"]]}]
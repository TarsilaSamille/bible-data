[{"verse":1,"text":"そこでピラトは、イエスを捕,とらえ、むちで打,うたせた。","tok":[["そこ"],["で"],["ピラト"],["は"],["、"],["イエス"],["を"],["捕らえ","とらえ"],["、"],["むち"],["で"],["打たせた","うたせた"],["。"]]},{"verse":2,"text":"兵卒,へいそつたちは、いばらで冠,かんむりをあんで、イエスの頭,あたまにかぶらせ、紫,むらさきの上着,うわぎを着,きせ、","tok":[["兵卒","へいそつ"],["たち"],["は"],["、"],["いばら"],["で"],["冠","かんむり"],["を"],["あ"],["んで"],["、"],["イエス"],["の"],["頭","あたま"],["に"],["かぶらせ"],["、"],["紫","むらさき"],["の"],["上着","うわぎ"],["を"],["着せ","きせ"],["、"]]},{"verse":3,"text":"それから、その前,まえに進,すすみ出,でて、「ユダヤ人,じんの王,おう、ばんざい」と言,いった。そして平手,ひらてでイエスを打,うちつづけた。","tok":[["それ"],["から"],["、"],["その"],["前","まえ"],["に"],["進み出て","すすみでて"],["、"],["「"],["ユダヤ人","ゆだやじん"],["の"],["王","おう"],["、"],["ばんざい"],["」"],["と"],["言った","いった"],["。"],["そして"],["平手","ひらて"],["で"],["イエス"],["を"],["打ち","うち"],["つづけた"],["。"]]},{"verse":4,"text":"するとピラトは、また出,でて行,いってユダヤ人,じんたちに言,いった、「見,みよ、わたしはこの人,ひとをあなたがたの前,まえに引,ひき出,だすが、それはこの人,ひとになんの罪,つみも見,みいだせないことを、あなたがたに知,しってもらうためである」。","tok":[["する"],["と"],["ピラト"],["は"],["、"],["また"],["出て","でて"],["行って","いって"],["ユダヤ人","ゆだやじん"],["たち"],["に"],["言った","いった"],["、"],["「"],["見よ","みよ"],["、"],["わたし"],["は"],["この"],["人","ひと"],["を"],["あなた"],["がた"],["の"],["前","まえ"],["に"],["引出す","ひきだす"],["が"],["、"],["それ"],["は"],["この"],["人","ひと"],["に"],["なん"],["の"],["罪","つみ"],["も"],["見いだせない","みいだせない"],["こと"],["を"],["、"],["あなた"],["がた"],["に"],["知って","しって"],["もらう"],["ため"],["で"],["ある"],["」"],["。"]]},{"verse":5,"text":"イエスはいばらの冠,かんむりをかぶり、紫,むらさきの上着,うわぎを着,きたままで外,そとへ出,でられると、ピラトは彼,かれらに言,いった、「見,みよ、この人,ひとだ」。","tok":[["イエス"],["は"],["いばら"],["の"],["冠","かんむり"],["を"],["かぶり"],["、"],["紫","むらさき"],["の"],["上着","うわぎ"],["を"],["着た","きた"],["まま"],["で"],["外","そと"],["へ"],["出られる","でられる"],["と"],["、"],["ピラト"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["見よ","みよ"],["、"],["この"],["人","ひと"],["だ"],["」"],["。"]]},{"verse":6,"text":"祭司長,さいしちょうたちや下役,したやくどもはイエスを見,みると、叫,さけんで「十字架,じゅうじかにつけよ、十字架,じゅうじかにつけよ」と言,いった。ピラトは彼,かれらに言,いった、「あなたがたが、この人,ひとを引,ひき取,とって十字架,じゅうじかにつけるがよい。わたしは、彼,かれにはなんの罪,つみも見,みいだせない」。","tok":[["祭司長","さいしちょう"],["たち"],["や"],["下役","したやく"],["ども"],["は"],["イエス"],["を"],["見る","みる"],["と"],["、"],["叫けんで","さけんで"],["「"],["十字架","じゅうじか"],["に"],["つけよ"],["、"],["十字架","じゅうじか"],["に"],["つけよ"],["」"],["と"],["言った","いった"],["。"],["ピラト"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["あなた"],["が"],["た"],["が"],["、"],["この"],["人","ひと"],["を"],["引取って","ひきとって"],["十字架","じゅうじか"],["に"],["つける"],["が"],["よい"],["。"],["わたし"],["は"],["、"],["彼","かれ"],["に"],["は"],["なん"],["の"],["罪","つみ"],["も"],["見いだせない","みいだせない"],["」"],["。"]]},{"verse":7,"text":"ユダヤ人,じんたちは彼,かれに答,こたえた、「わたしたちには律法,りっぽうがあります。その律法,りっぽうによれば、彼,かれは自分,じぶんを神,かみの子,ことしたのだから、死罪,しざいに当,あたる者,ものです」。","tok":[["ユダヤ人","ゆだやじん"],["たち"],["は"],["彼","かれ"],["に"],["答","こたえ"],["た"],["、"],["「"],["わたしたち"],["に"],["は"],["律法","りっぽう"],["が"],["あります"],["。"],["その"],["律法","りっぽう"],["に"],["よれば"],["、"],["彼","かれ"],["は"],["自分","じぶん"],["を"],["神","かみ"],["の"],["子","こ"],["と"],["した"],["の"],["だ"],["から"],["、"],["死罪","しざい"],["に"],["当たる","あたる"],["者","もの"],["です"],["」"],["。"]]},{"verse":8,"text":"ピラトがこの言葉,ことばを聞,きいたとき、ますますおそれ、","tok":[["ピラト"],["が"],["この"],["言葉","ことば"],["を"],["聞いた","きいた"],["とき"],["、"],["ますます"],["おそれ"],["、"]]},{"verse":9,"text":"もう一度,ど官邸,かんていにはいってイエスに言,いった、「あなたは、もともと、どこからきたのか」。しかし、イエスはなんの答,こたえもなさらなかった。","tok":[["もう"],["一","いち"],["度","ど"],["官邸","かんてい"],["に"],["はいって"],["イエス"],["に"],["言った","いった"],["、"],["「"],["あなた"],["は"],["、"],["もともと"],["、"],["どこ"],["から"],["きた"],["の"],["か"],["」"],["。"],["しかし"],["、"],["イエス"],["は"],["なん"],["の"],["答","こたえ"],["も"],["なさらなかった"],["。"]]},{"verse":10,"text":"そこでピラトは言,いった、「何,なにも答,こたえないのか。わたしには、あなたを許,ゆるす権威,けんいがあり、また十字架,じゅうじかにつける権威,けんいがあることを、知,しらないのか」。","tok":[["そこ"],["で"],["ピラト"],["は"],["言った","いった"],["、"],["「"],["何に","なに"],["も"],["答","こたえ"],["ない"],["の"],["か"],["。"],["わたし"],["に"],["は"],["、"],["あなた"],["を"],["許す","ゆるす"],["権威","けんい"],["が"],["あり"],["、"],["また"],["十字架","じゅうじか"],["に"],["つける"],["権威","けんい"],["が"],["ある"],["こと"],["を"],["、"],["知らない","しらない"],["の"],["か"],["」"],["。"]]},{"verse":11,"text":"イエスは答,こたえられた、「あなたは、上,うえから賜,たまわるのでなければ、わたしに対,たいしてなんの権威,けんいもない。だから、わたしをあなたに引,ひき渡,わたした者,ものの罪,つみは、もっと大,おおきい」。","tok":[["イエス"],["は"],["答","こたえ"],["られた"],["、"],["「"],["あなた"],["は"],["、"],["上","うえ"],["から"],["賜わる","たまわる"],["ので"],["なければ"],["、"],["わたし"],["に対して","にたいして"],["なん"],["の"],["権威","けんい"],["も"],["ない"],["。"],["だ"],["から"],["、"],["わたし"],["を"],["あなた"],["に"],["引渡","ひきわたし"],["た"],["者","もの"],["の"],["罪","つみ"],["は"],["、"],["もっと"],["大きい","おおきい"],["」"],["。"]]},{"verse":12,"text":"これを聞,きいて、ピラトはイエスを許,ゆるそうと努,つとめた。しかしユダヤ人,じんたちが叫,さけんで言,いった、「もしこの人,ひとを許,ゆるしたなら、あなたはカイザルの味方,みかたではありません。自分,じぶんを王,おうとするものはすべて、カイザルにそむく者,ものです」。","tok":[["これ"],["を"],["聞いて","きいて"],["、"],["ピラト"],["は"],["イエス"],["を"],["許そう","ゆるそう"],["と"],["努めた","つとめた"],["。"],["しかし"],["ユダヤ人","ゆだやじん"],["たち"],["が"],["叫けんで","さけんで"],["言った","いった"],["、"],["「"],["もし"],["この"],["人","ひと"],["を"],["許したなら","ゆるしたなら"],["、"],["あなた"],["は"],["カイザル"],["の"],["味方","みかた"],["で"],["は"],["ありません"],["。"],["自分","じぶん"],["を"],["王","おう"],["と"],["する"],["もの"],["は"],["すべて"],["、"],["カイザル"],["に"],["そむく"],["者","もの"],["です"],["」"],["。"]]},{"verse":13,"text":"ピラトはこれらの言葉,ことばを聞,きいて、イエスを外,そとへ引,ひき出,だして行,いき、敷石,しきいし（ヘブル語,ごではガバタ）という場所,ばしょで裁判,さいばんの席,せきについた。","tok":[["ピラト"],["は"],["これ"],["ら"],["の"],["言葉","ことば"],["を"],["聞いて","きいて"],["、"],["イエス"],["を"],["外","そと"],["へ"],["引出して","ひきだして"],["行き","いき"],["、"],["敷石","しきいし"],["（"],["ヘブル"],["語","ご"],["で"],["は"],["ガバタ"],["）"],["と"],["いう"],["場所","ばしょ"],["で"],["裁判","さいばん"],["の"],["席","せき"],["に"],["ついた"],["。"]]},{"verse":14,"text":"その日,ひは過越,すぎこしの準備,じゅんびの日,ひであって、時,ときは昼,ひるの十二時,じころであった。ピラトはユダヤ人,じんらに言,いった、「見,みよ、これがあなたがたの王,おうだ」。","tok":[["その"],["日","ひ"],["は"],["過越","すぎこし"],["の"],["準備","じゅんび"],["の"],["日","ひ"],["で"],["あって"],["、"],["時","とき"],["は"],["昼","ひる"],["の"],["十二","じゅうに"],["時","じ"],["ころ"],["で"],["あった"],["。"],["ピラト"],["は"],["ユダヤ人","ゆだやじん"],["ら"],["に"],["言った","いった"],["、"],["「"],["見よ","みよ"],["、"],["これ"],["が"],["あなた"],["がた"],["の"],["王","おう"],["だ"],["」"],["。"]]},{"verse":15,"text":"すると彼,かれらは叫,さけんだ、「殺,ころせ、殺,ころせ、彼,かれを十字架,じゅうじかにつけよ」。ピラトは彼,かれらに言,いった、「あなたがたの王,おうを、わたしが十字架,じゅうじかにつけるのか」。祭司長,さいしちょうたちは答,こたえた、「わたしたちには、カイザル以外,いがいに王,おうはありません」。","tok":[["する"],["と"],["彼","かれ"],["ら"],["は"],["叫けんだ","さけんだ"],["、"],["「"],["殺ろせ","ころせ"],["、"],["殺ろせ","ころせ"],["、"],["彼","かれ"],["を"],["十字架","じゅうじか"],["に"],["つけよ"],["」"],["。"],["ピラト"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["の"],["王","おう"],["を"],["、"],["わたし"],["が"],["十字架","じゅうじか"],["に"],["つける"],["の"],["か"],["」"],["。"],["祭司長","さいしちょう"],["たち"],["は"],["答","こたえ"],["た"],["、"],["「"],["わたしたち"],["に"],["は"],["、"],["カイザル"],["以外","いがい"],["に"],["王","おう"],["は"],["ありません"],["」"],["。"]]},{"verse":16,"text":"そこでピラトは、十字架,じゅうじかにつけさせるために、イエスを彼,かれらに引,ひき渡,わたした。彼,かれらはイエスを引,ひき取,とった。","tok":[["そこ"],["で"],["ピラト"],["は"],["、"],["十字架","じゅうじか"],["に"],["つけ"],["させる"],["ため"],["に"],["、"],["イエス"],["を"],["彼","かれ"],["ら"],["に"],["引渡","ひきわたし"],["た"],["。"],["彼","かれ"],["ら"],["は"],["イエス"],["を"],["引取った","ひきとった"],["。"]]},{"verse":17,"text":"イエスはみずから十字架,じゅうじかを背負,せおって、されこうべ（ヘブル語,ごではゴルゴダ）という場所,ばしょに出,でて行,いかれた。","tok":[["イエス"],["は"],["みずから"],["十字架","じゅうじか"],["を"],["背負って","せおって"],["、"],["されこうべ"],["（"],["ヘブル"],["語","ご"],["で"],["は"],["ゴルゴダ"],["）"],["と"],["いう"],["場所","ばしょ"],["に"],["出て","でて"],["行かれた","いかれた"],["。"]]},{"verse":18,"text":"彼,かれらはそこで、イエスを十字架,じゅうじかにつけた。イエスをまん中,なかにして、ほかのふたりの者,ものを両側,りょうがわに、イエスと一緒,いっしょに十字架,じゅうじかにつけた。","tok":[["彼","かれ"],["ら"],["は"],["そこ"],["で"],["、"],["イエス"],["を"],["十字架","じゅうじか"],["に"],["つけた"],["。"],["イエス"],["を"],["まん中","まんなか"],["に"],["して"],["、"],["ほか"],["の"],["ふたり"],["の"],["者","もの"],["を"],["両側","りょうがわ"],["に"],["、"],["イエス"],["と"],["一緒","いっしょ"],["に"],["十字架","じゅうじか"],["に"],["つけた"],["。"]]},{"verse":19,"text":"ピラトは罪状,ざいじょう書,がきを書,かいて、十字架,じゅうじかの上,うえにかけさせた。それには「ユダヤ人,じんの王,おう、ナザレのイエス」と書,かいてあった。","tok":[["ピラト"],["は"],["罪状書","ざいじょうがき"],["を"],["書いて","かいて"],["、"],["十字架","じゅうじか"],["の"],["上","うえ"],["に"],["かけさせた"],["。"],["それ"],["に"],["は"],["「"],["ユダヤ人","ゆだやじん"],["の"],["王","おう"],["、"],["ナザレ"],["の"],["イエス"],["」"],["と"],["書いて","かいて"],["あった"],["。"]]},{"verse":20,"text":"イエスが十字架,じゅうじかにつけられた場所,ばしょは都,みやこに近,ちかかったので、多,おおくのユダヤ人,じんがこの罪状,ざいじょう書,がきを読,よんだ。それはヘブル、ローマ、ギリシヤの国語,こくごで書,かいてあった。","tok":[["イエス"],["が"],["十字架","じゅうじか"],["に"],["つけられた"],["場所","ばしょ"],["は"],["都","みやこ"],["に"],["近かった","ちかかった"],["ので"],["、"],["多く","おおく"],["の"],["ユダヤ人","ゆだやじん"],["が"],["この"],["罪状書","ざいじょうがき"],["を"],["読んだ","よんだ"],["。"],["それ"],["は"],["ヘブル"],["、"],["ローマ"],["、"],["ギリシヤ"],["の"],["国語","こくご"],["で"],["書いて","かいて"],["あった"],["。"]]},{"verse":21,"text":"ユダヤ人,じんの祭司長,さいしちょうたちがピラトに言,いった、「『ユダヤ人,じんの王,おう』と書,かかずに、『この人,ひとはユダヤ人,じんの王,おうと自,じ称,しょうしていた』と書,かいてほしい」。","tok":[["ユダヤ人","ゆだやじん"],["の"],["祭司長","さいしちょう"],["たち"],["が"],["ピラト"],["に"],["言った","いった"],["、"],["「"],["『"],["ユダヤ人","ゆだやじん"],["の"],["王","おう"],["』"],["と"],["書かず","かかず"],["に"],["、"],["『"],["この"],["人","ひと"],["は"],["ユダヤ人","ゆだやじん"],["の"],["王","おう"],["と"],["自称","じしょう"],["して"],["いた"],["』"],["と"],["書いて","かいて"],["ほしい"],["」"],["。"]]},{"verse":22,"text":"ピラトは答,こたえた、「わたしが書,かいたことは、書,かいたままにしておけ」。","tok":[["ピラト"],["は"],["答","こたえ"],["た"],["、"],["「"],["わたし"],["が"],["書いた","かいた"],["こと"],["は"],["、"],["書いた","かいた"],["まま"],["に"],["して"],["おけ"],["」"],["。"]]},{"verse":23,"text":"さて、兵卒,へいそつたちはイエスを十字架,じゅうじかにつけてから、その上着,うわぎをとって四つに分,わけ、おのおの、その一つを取,とった。また下着,したぎを手,てに取,とってみたが、それには縫,ぬい目,めがなく、上,うえの方,ほうから全部,ぜんぶ一つに織,おったものであった。","tok":[["さて"],["、"],["兵卒","へいそつ"],["たち"],["は"],["イエス"],["を"],["十字架","じゅうじか"],["に"],["つけて"],["から"],["、"],["その"],["上着","うわぎ"],["を"],["とって"],["四","よん"],["つ"],["に"],["分け","わけ"],["、"],["おのおの"],["、"],["その"],["一","ひと"],["つ"],["を"],["取った","とった"],["。"],["また"],["下着","したぎ"],["を"],["手","て"],["に"],["取って","とって"],["みた"],["が"],["、"],["それ"],["に"],["は"],["縫目","ぬいめ"],["が"],["なく"],["、"],["上","うえ"],["の"],["方","ほう"],["から"],["全部","ぜんぶ"],["一","ひと"],["つ"],["に"],["織った","おった"],["もの"],["で"],["あった"],["。"]]},{"verse":24,"text":"そこで彼,かれらは互,たがいに言,いった、「それを裂,さかないで、だれのものになるか、くじを引,ひこう」。これは、「彼,かれらは互,たがいにわたしの上着,うわぎを分,わけ合,あい、わたしの衣,ころもをくじ引にした」という聖書,せいしょが成就,じょうじゅするためで、兵卒,へいそつたちはそのようにしたのである。","tok":[["そこ"],["で"],["彼","かれ"],["ら"],["は"],["互","たがい"],["に"],["言った","いった"],["、"],["「"],["それ"],["を"],["裂かないで","さかないで"],["、"],["だれ"],["の"],["もの"],["に"],["なる"],["か"],["、"],["くじ"],["を"],["引こう","ひこう"],["」"],["。"],["これ"],["は"],["、"],["「"],["彼","かれ"],["ら"],["は"],["互","たがい"],["に"],["わたし"],["の"],["上着","うわぎ"],["を"],["分け合い","わけあい"],["、"],["わたし"],["の"],["衣","ころも"],["を"],["くじ引","くじびき"],["に"],["した"],["」"],["と"],["いう"],["聖書","せいしょ"],["が"],["成就","じょうじゅ"],["する"],["ため"],["で"],["、"],["兵卒","へいそつ"],["たち"],["は"],["その"],["よう"],["に"],["した"],["ので"],["ある"],["。"]]},{"verse":25,"text":"さて、イエスの十字架,じゅうじかのそばには、イエスの母,ははと、母,ははの姉妹,しまいと、クロパの妻,つまマリヤと、マグダラのマリヤとが、たたずんでいた。","tok":[["さて"],["、"],["イエス"],["の"],["十字架","じゅうじか"],["の"],["そば"],["に"],["は"],["、"],["イエス"],["の"],["母","はは"],["と"],["、"],["母","はは"],["の"],["姉妹","しまい"],["と"],["、"],["クロパ"],["の"],["妻","つま"],["マリヤ"],["と"],["、"],["マグダラ"],["の"],["マリヤ"],["と"],["が"],["、"],["たたずんで"],["いた"],["。"]]},{"verse":26,"text":"イエスは、その母,ははと愛弟子,あいでしとがそばに立,たっているのをごらんになって、母,ははにいわれた、「婦人,ふじんよ、ごらんなさい。これはあなたの子,こです」。","tok":[["イエス"],["は"],["、"],["その"],["母","はは"],["と"],["愛弟子","あいでしとがそば"],["に"],["立って","たって"],["いる"],["の"],["を"],["ごらん"],["に"],["なって"],["、"],["母","はは"],["に"],["いわれた"],["、"],["「"],["婦人","ふじん"],["よ"],["、"],["ごらん"],["なさい"],["。"],["これ"],["は"],["あなた"],["の"],["子","こ"],["です"],["」"],["。"]]},{"verse":27,"text":"それからこの弟子,でしに言,いわれた、「ごらんなさい。これはあなたの母,ははです」。そのとき以来,いらい、この弟子,でしはイエスの母,ははを自分,じぶんの家,いえに引,ひきとった。","tok":[["それ"],["から"],["この"],["弟子","でし"],["に"],["言われた","いわれた"],["、"],["「"],["ごらん"],["なさい"],["。"],["これ"],["は"],["あなた"],["の"],["母","はは"],["です"],["」"],["。"],["その"],["とき"],["以来","いらい"],["、"],["この"],["弟子","でし"],["は"],["イエス"],["の"],["母","はは"],["を"],["自分","じぶん"],["の"],["家","いえ"],["に"],["引","ひき"],["とった"],["。"]]},{"verse":28,"text":"そののち、イエスは今,いまや万事,ばんじが終,おわったことを知,しって、「わたしは、かわく」と言,いわれた。それは、聖書,せいしょが全,まっとうされるためであった。","tok":[["その"],["のち"],["、"],["イエス"],["は"],["今","いま"],["や"],["万事","ばんじ"],["が"],["終わった","おわった"],["こと"],["を"],["知って","しって"],["、"],["「"],["わたし"],["は"],["、"],["かわく"],["」"],["と"],["言われた","いわれた"],["。"],["それ"],["は"],["、"],["聖書","せいしょ"],["が"],["全う","まっとう"],["される"],["ため"],["で"],["あった"],["。"]]},{"verse":29,"text":"そこに、酢,すいぶどう酒,しゅがいっぱい入,いれてある器,うつわがおいてあったので、人々,ひとびとは、このぶどう酒,しゅを含,ふくませた海綿,かいめんをヒソプの茎,くきに結,むすびつけて、イエスの口,くちもとにさし出,だした。","tok":[["そこ"],["に"],["、"],["酢","す"],["い"],["ぶどう酒","ぶどうしゅ"],["が"],["いっぱい"],["入れて","いれて"],["ある"],["器","うつわ"],["が"],["おいて"],["あった"],["ので"],["、"],["人々","ひとびと"],["は"],["、"],["この"],["ぶどう酒","ぶどうしゅ"],["を"],["含ませた","ふくませた"],["海綿","かいめん"],["を"],["ヒソプ"],["の"],["茎","くき"],["に"],["結びつけて","むすびつけて"],["、"],["イエス"],["の"],["口もと","くちもと"],["に"],["さし出した","さしだした"],["。"]]},{"verse":30,"text":"すると、イエスはそのぶどう酒,しゅを受,うけて、「すべてが終,おわった」と言,いわれ、首,くびをたれて息,いきをひきとられた。","tok":[["する"],["と"],["、"],["イエス"],["は"],["その"],["ぶどう酒","ぶどうしゅ"],["を"],["受て","うけて"],["、"],["「"],["すべて"],["が"],["終わった","おわった"],["」"],["と"],["言われ","いわれ"],["、"],["首","くび"],["を"],["たれて"],["息","いき"],["を"],["ひきとられた"],["。"]]},{"verse":31,"text":"さてユダヤ人,じんたちは、その日,ひが準備,じゅんびの日,ひであったので、安息日,あんそくにちに死体,したいを十字架,じゅうじかの上,うえに残,のこしておくまいと、（特,とくにその安息日,あんそくにちは大事,だいじな日,ひであったから）、ピラトに願,ねがって、足,あしを折,おった上,うえで、死体,したいを取,とりおろすことにした。","tok":[["さて"],["ユダヤ人","ゆだやじん"],["たち"],["は"],["、"],["その"],["日","ひ"],["が"],["準備","じゅんび"],["の"],["日","ひ"],["で"],["あった"],["ので"],["、"],["安息日","あんそくにち"],["に"],["死体","したい"],["を"],["十字架","じゅうじか"],["の"],["上","うえ"],["に"],["残して","のこして"],["おくまい"],["と"],["、"],["（"],["特に","とくに"],["その"],["安息日","あんそくにち"],["は"],["大事","だいじ"],["な"],["日","ひ"],["で"],["あった"],["から"],["）"],["、"],["ピラト"],["に"],["願って","ねがって"],["、"],["足","あし"],["を"],["折った","おった"],["上","うえ"],["で"],["、"],["死体","したい"],["を"],["取","とり"],["おろす"],["こと"],["に"],["した"],["。"]]},{"verse":32,"text":"そこで兵卒,へいそつらがきて、イエスと一緒,いっしょに十字架,じゅうじかにつけられた初,はじめの者,ものと、もうひとりの者,ものとの足,あしを折,おった。","tok":[["そこ"],["で"],["兵卒","へいそつ"],["ら"],["が"],["きて"],["、"],["イエス"],["と"],["一緒","いっしょ"],["に"],["十字架","じゅうじか"],["に"],["つけられた"],["初め","はじめ"],["の"],["者","もの"],["と"],["、"],["もう"],["ひとり"],["の"],["者","もの"],["と"],["の"],["足","あし"],["を"],["折った","おった"],["。"]]},{"verse":33,"text":"しかし、彼,かれらがイエスのところにきた時,とき、イエスはもう死,しんでおられたのを見,みて、その足,あしを折,おることはしなかった。","tok":[["しかし"],["、"],["彼","かれ"],["ら"],["が"],["イエス"],["の"],["ところ"],["に"],["きた"],["時","とき"],["、"],["イエス"],["は"],["もう"],["死んで","しんで"],["おられた"],["の"],["を"],["見て","みて"],["、"],["その"],["足","あし"],["を"],["折る","おる"],["こと"],["は"],["しなかった"],["。"]]},{"verse":34,"text":"しかし、ひとりの兵卒,へいそつがやりでそのわきを突,つきさすと、すぐ血,ちと水,みずとが流,ながれ出,でた。","tok":[["しかし"],["、"],["ひとり"],["の"],["兵卒","へいそつ"],["が"],["やりで"],["その"],["わき"],["を"],["突きさす","つきさす"],["と"],["、"],["すぐ"],["血","ち"],["と"],["水","みず"],["と"],["が"],["流れ出た","ながれでた"],["。"]]},{"verse":35,"text":"それを見,みた者,ものがあかしをした。そして、そのあかしは真実,しんじつである。その人,ひとは、自分,じぶんが真実,しんじつを語,かたっていることを知,しっている。それは、あなたがたも信,しんずるようになるためである。","tok":[["それ"],["を"],["見た","みた"],["者","もの"],["が"],["あかし"],["を"],["した"],["。"],["そして"],["、"],["その"],["あかし"],["は"],["真実","しんじつ"],["で"],["ある"],["。"],["その"],["人","ひと"],["は"],["、"],["自分","じぶん"],["が"],["真実","しんじつ"],["を"],["語って","かたって"],["いる"],["こと"],["を"],["知って","しって"],["いる"],["。"],["それ"],["は"],["、"],["あなた"],["がた"],["も"],["信ずる","しんずる"],["よう"],["に"],["なる"],["ため"],["で"],["ある"],["。"]]},{"verse":36,"text":"これらのことが起,おこったのは、「その骨,ほねはくだかれないであろう」との聖書,せいしょの言葉,ことばが、成就,じょうじゅするためである。","tok":[["これ"],["ら"],["の"],["こと"],["が"],["起こった","おこった"],["の"],["は"],["、"],["「"],["その"],["骨","ほね"],["は"],["くだかれないで"],["あろう"],["」"],["と"],["の"],["聖書","せいしょ"],["の"],["言葉","ことば"],["が"],["、"],["成就","じょうじゅ"],["する"],["ため"],["で"],["ある"],["。"]]},{"verse":37,"text":"また聖書,せいしょのほかのところに、「彼,かれらは自分,じぶんが刺,さし通,とおした者,ものを見,みるであろう」とある。","tok":[["また"],["聖書","せいしょ"],["の"],["ほか"],["の"],["ところ"],["に"],["、"],["「"],["彼","かれ"],["ら"],["は"],["自分","じぶん"],["が"],["刺通した","さしとおした"],["者","もの"],["を"],["見るで","みるで"],["あろう"],["」"],["と"],["ある"],["。"]]},{"verse":38,"text":"そののち、ユダヤ人,じんをはばかって、ひそかにイエスの弟子,でしとなったアリマタヤのヨセフという人,ひとが、イエスの死体,したいを取,とりおろしたいと、ピラトに願,ねがい出,でた。ピラトはそれを許,ゆるしたので、彼,かれはイエスの死体,したいを取,とりおろしに行,いった。","tok":[["その"],["のち"],["、"],["ユダヤ人","ゆだやじん"],["を"],["はばかって"],["、"],["ひそか"],["に"],["イエス"],["の"],["弟子","でし"],["と"],["なった"],["アリマタヤ"],["の"],["ヨセフ"],["と"],["いう"],["人","ひと"],["が"],["、"],["イエス"],["の"],["死体","したい"],["を"],["取","とり"],["おろしたい"],["と"],["、"],["ピラト"],["に"],["願い出た","ねがいでた"],["。"],["ピラト"],["は"],["それ"],["を"],["許した","ゆるした"],["ので"],["、"],["彼","かれ"],["は"],["イエス"],["の"],["死体","したい"],["を"],["取","とり"],["おろし"],["に"],["行った","いった"],["。"]]},{"verse":39,"text":"また、前,まえに、夜,よる、イエスのみもとに行,いったニコデモも、没薬,もつやくと沈香,ぢんこうとをまぜたものを百斤,きんほど持,もってきた。","tok":[["また"],["、"],["前","まえ"],["に"],["、"],["夜","よる"],["、"],["イエス"],["のみ"],["もと"],["に"],["行った","いった"],["ニコデモ"],["も"],["、"],["没薬","もつやく"],["と"],["沈香","ぢんこうと"],["を"],["まぜた"],["もの"],["を"],["百","ひゃく"],["斤","きん"],["ほど"],["持って","もって"],["きた"],["。"]]},{"verse":40,"text":"彼,かれらは、イエスの死体,したいを取,とりおろし、ユダヤ人,じんの埋葬,まいそうの習慣,しゅうかんにしたがって、香料,こうりょうを入,いれて亜麻布,あまぬので巻,まいた。","tok":[["彼","かれ"],["ら"],["は"],["、"],["イエス"],["の"],["死体","したい"],["を"],["取","とり"],["おろし"],["、"],["ユダヤ人","ゆだやじん"],["の"],["埋葬","まいそう"],["の"],["習慣","しゅうかん"],["に"],["したがって"],["、"],["香料","こうりょう"],["を"],["入れて","いれて"],["亜","あ"],["麻布","あざぶ"],["ので"],["巻いた","まいた"],["。"]]},{"verse":41,"text":"イエスが十字架,じゅうじかにかけられた所,ところには、一つの園,そのがあり、そこにはまだだれも葬,ほうむられたことのない新,あたらしい墓,はかがあった。","tok":[["イエス"],["が"],["十字架","じゅうじか"],["に"],["かけられた"],["所","ところ"],["に"],["は"],["、"],["一","ひと"],["つ"],["の"],["園","その"],["が"],["あり"],["、"],["そこ"],["に"],["は"],["まだ"],["だれ"],["も"],["葬むられた","ほうむられた"],["こと"],["の"],["ない"],["新らしい","あたらしい"],["墓","はか"],["が"],["あった"],["。"]]},{"verse":42,"text":"その日,ひはユダヤ人,じんの準備,じゅんびの日,ひであったので、その墓,はかが近,ちかくにあったため、イエスをそこに納,おさめた。","tok":[["その"],["日","ひ"],["は"],["ユダヤ人","ゆだやじん"],["の"],["準備","じゅんび"],["の"],["日","ひ"],["で"],["あった"],["ので"],["、"],["その"],["墓","はか"],["が"],["近く","ちかく"],["に"],["あった"],["ため"],["、"],["イエス"],["を"],["そこ"],["に"],["納","おさめ"],["た"],["。"]]}]
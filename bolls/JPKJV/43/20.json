[{"verse":1,"text":"さて、一週,しゅうの初,はじめの日,ひに、朝,あさ早,はやくまだ暗,くらいうちに、マグダラのマリヤが墓,はかに行,いくと、墓,はかから石,いしがとりのけてあるのを見,みた。","tok":[["さて"],["、"],["一","いち"],["週","しゅう"],["の"],["初め","はじめ"],["の"],["日","ひ"],["に"],["、"],["朝","あさ"],["早く","はやく"],["まだ"],["暗い","くらい"],["うち"],["に"],["、"],["マグダラ"],["の"],["マリヤ"],["が"],["墓","はか"],["に"],["行く","いく"],["と"],["、"],["墓","はか"],["から"],["石","いし"],["が"],["とりのけて"],["ある"],["の"],["を"],["見た","みた"],["。"]]},{"verse":2,"text":"そこで走,はしって、シモン・ペテロとイエスが愛,あいしておられた、もうひとりの弟子,でしのところへ行,いって、彼,かれらに言,いった、「だれかが、主,しゅを墓,はかから取,とり去,さりました。どこへ置,おいたのか、わかりません」。","tok":[["そこ"],["で"],["走って","はしって"],["、"],["シモン"],["・"],["ペテロ"],["と"],["イエス"],["が"],["愛して","あいして"],["おられた"],["、"],["もう"],["ひとり"],["の"],["弟子","でし"],["の"],["ところ"],["へ"],["行って","いって"],["、"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["だれ"],["か"],["が"],["、"],["主","しゅ"],["を"],["墓","はか"],["から"],["取去りました","とりさりました"],["。"],["どこ"],["へ"],["置いた","おいた"],["の"],["か"],["、"],["わかりません"],["」"],["。"]]},{"verse":3,"text":"そこでペテロともうひとりの弟子,でしは出,でかけて、墓,はかへむかって行,いった。","tok":[["そこ"],["で"],["ペテロ"],["と"],["もう"],["ひとり"],["の"],["弟子","でし"],["は"],["出かけて","でかけて"],["、"],["墓","はか"],["へ"],["むかって"],["行った","いった"],["。"]]},{"verse":4,"text":"ふたりは一緒,いっしょに走,はしり出,だしたが、そのもうひとりの弟子,でしの方,ほうが、ペテロよりも早,はやく走,はしって先,さきに墓,はかに着,つき、","tok":[["ふたり"],["は"],["一緒","いっしょ"],["に"],["走り","はしり"],["出した","だした"],["が"],["、"],["その"],["もう"],["ひとり"],["の"],["弟子","でし"],["の"],["方","ほう"],["が"],["、"],["ペテロ"],["より"],["も"],["早く","はやく"],["走って","はしって"],["先","さき"],["に"],["墓","はか"],["に"],["着き","つき"],["、"]]},{"verse":5,"text":"そして身,みをかがめてみると、亜麻布,あまぬのがそこに置,おいてあるのを見,みたが、中,なかへははいらなかった。","tok":[["そして"],["身","み"],["を"],["かがめて"],["みる"],["と"],["、"],["亜","あ"],["麻布","あざぶ"],["の"],["が"],["そこ"],["に"],["置いて","おいて"],["ある"],["の"],["を"],["見た","みた"],["が"],["、"],["中","なか"],["へ"],["は"],["はいらなかった"],["。"]]},{"verse":6,"text":"シモン・ペテロも続,つづいてきて、墓,はかの中,なかにはいった。彼,かれは亜麻布,あまぬのがそこに置,おいてあるのを見,みたが、","tok":[["シモン"],["・"],["ペテロ"],["も"],["続いて","つづいて"],["きて"],["、"],["墓","はか"],["の"],["中","なか"],["に"],["はいった"],["。"],["彼","かれ"],["は"],["亜","あ"],["麻布","あざぶ"],["の"],["が"],["そこ"],["に"],["置いて","おいて"],["ある"],["の"],["を"],["見た","みた"],["が"],["、"]]},{"verse":7,"text":"イエスの頭,あたまに巻,まいてあった布,ぬのは亜麻布,あまぬののそばにはなくて、はなれた別,べつの場所,ばしょにくるめてあった。","tok":[["イエス"],["の"],["頭","あたま"],["に"],["巻いて","まいて"],["あった"],["布","ぬの"],["は"],["亜","あ"],["麻布","あざぶ"],["の"],["の"],["そば"],["に"],["は"],["なくて"],["、"],["はなれた"],["別","べつ"],["の"],["場所","ばしょ"],["に"],["くるめて"],["あった"],["。"]]},{"verse":8,"text":"すると、先,さきに墓,はかに着,ついたもうひとりの弟子,でしもはいってきて、これを見,みて信,しんじた。","tok":[["する"],["と"],["、"],["先","さき"],["に"],["墓","はか"],["に"],["着いた","ついた"],["もう"],["ひとり"],["の"],["弟子","でし"],["も"],["はいって"],["きて"],["、"],["これ"],["を"],["見て","みて"],["信じた","しんじた"],["。"]]},{"verse":9,"text":"しかし、彼,かれらは死人,しにんのうちからイエスがよみがえるべきことをしるした聖,せい句,くを、まだ悟,さとっていなかった。","tok":[["しかし"],["、"],["彼","かれ"],["ら"],["は"],["死人","しにん"],["の"],["うち"],["から"],["イエス"],["が"],["よみがえるべき"],["こと"],["を"],["しるした"],["聖い","せい"],["句","く"],["を"],["、"],["まだ"],["悟って","さとって"],["いなかった"],["。"]]},{"verse":10,"text":"それから、ふたりの弟子,でしたちは自分,じぶんの家,いえに帰,かえって行,いった。","tok":[["それ"],["から"],["、"],["ふたり"],["の"],["弟子","でし"],["たち"],["は"],["自分","じぶん"],["の"],["家","いえ"],["に"],["帰えって","かえって"],["行った","いった"],["。"]]},{"verse":11,"text":"しかし、マリヤは墓,はかの外,そとに立,たって泣,ないていた。そして泣,なきながら、身,みをかがめて墓,はかの中,なかをのぞくと、","tok":[["しかし"],["、"],["マリヤ"],["は"],["墓","はか"],["の"],["外","そと"],["に"],["立って","たって"],["泣いて","ないて"],["いた"],["。"],["そして"],["泣","なき"],["ながら"],["、"],["身","み"],["を"],["かがめて"],["墓","はか"],["の"],["中","なか"],["を"],["のぞく"],["と"],["、"]]},{"verse":12,"text":"白,しろい衣,ころもを着,きたふたりの御使,みつかいが、イエスの死体,したいのおかれていた場所,ばしょに、ひとりは頭,あたまの方,ほうに、ひとりは足,あしの方,ほうに、すわっているのを見,みた。","tok":[["白い","しろい"],["衣","ころも"],["を"],["着た","きた"],["ふたり"],["の"],["御使","み"],["つかい"],["が"],["、"],["イエス"],["の"],["死体","したい"],["の"],["おかれて"],["いた"],["場所","ばしょ"],["に"],["、"],["ひとり"],["は"],["頭","あたま"],["の"],["方","ほう"],["に"],["、"],["ひとり"],["は"],["足","あし"],["の"],["方","ほう"],["に"],["、"],["すわって"],["いる"],["の"],["を"],["見た","みた"],["。"]]},{"verse":13,"text":"すると、彼,かれらはマリヤに、「女,おんなよ、なぜ泣,ないているのか」と言,いった。マリヤは彼,かれらに言,いった、「だれかが、わたしの主,しゅを取,とり去,さりました。そして、どこに置,おいたのか、わからないのです」。","tok":[["する"],["と"],["、"],["彼","かれ"],["ら"],["は"],["マリヤ"],["に"],["、"],["「"],["女","おんな"],["よ"],["、"],["なぜ"],["泣いて","ないて"],["いる"],["の"],["か"],["」"],["と"],["言った","いった"],["。"],["マリヤ"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["だれ"],["か"],["が"],["、"],["わたし"],["の"],["主","しゅ"],["を"],["取去りました","とりさりました"],["。"],["そして"],["、"],["どこ"],["に"],["置いた","おいた"],["の"],["か"],["、"],["わからない"],["の"],["です"],["」"],["。"]]},{"verse":14,"text":"そう言,いって、うしろをふり向,むくと、そこにイエスが立,たっておられるのを見,みた。しかし、それがイエスであることに気,きがつかなかった。","tok":[["そう"],["言って","いって"],["、"],["うしろ"],["を"],["ふり向く","ふりむく"],["と"],["、"],["そこ"],["に"],["イエス"],["が"],["立って","たって"],["おられる"],["の"],["を"],["見た","みた"],["。"],["しかし"],["、"],["それ"],["が"],["イエス"],["で"],["ある"],["こと"],["に"],["気","き"],["が"],["つかなかった"],["。"]]},{"verse":15,"text":"イエスは女,おんなに言,いわれた、「女,おんなよ、なぜ泣,ないているのか。だれを捜,さがしているのか」。マリヤは、その人,ひとが園,そのの番人,ばんにんだと思,おもって言,いった、「もしあなたが、あのかたを移,うつしたのでしたら、どこへ置,おいたのか、どうぞ、おっしゃって下,ください。わたしがそのかたを引,ひき取,とります」。","tok":[["イエス"],["は"],["女","おんな"],["に"],["言われた","いわれた"],["、"],["「"],["女","おんな"],["よ"],["、"],["なぜ"],["泣いて","ないて"],["いる"],["の"],["か"],["。"],["だれ"],["を"],["捜して","さがして"],["いる"],["の"],["か"],["」"],["。"],["マリヤ"],["は"],["、"],["その"],["人","ひと"],["が"],["園","その"],["の"],["番人","ばんにん"],["だ"],["と"],["思って","おもって"],["言った","いった"],["、"],["「"],["もし"],["あなた"],["が"],["、"],["あの"],["かた"],["を"],["移した","うつした"],["の"],["でしたら"],["、"],["どこ"],["へ"],["置いた","おいた"],["の"],["か"],["、"],["どうぞ"],["、"],["おっしゃって"],["下さい","ください"],["。"],["わたし"],["が"],["その"],["かた"],["を"],["引取","ひきとり"],["ます"],["」"],["。"]]},{"verse":16,"text":"イエスは彼女,かのじょに「マリヤよ」と言,いわれた。マリヤはふり返,かえって、イエスにむかってヘブル語,ごで「ラボニ」と言,いった。それは、先生,せんせいという意味,いみである。","tok":[["イエス"],["は"],["彼女","かのじょ"],["に"],["「"],["マリヤ"],["よ"],["」"],["と"],["言われた","いわれた"],["。"],["マリヤ"],["は"],["ふり返って","ふりかえって"],["、"],["イエス"],["に"],["むかって"],["ヘブル"],["語","ご"],["で"],["「"],["ラボニ"],["」"],["と"],["言った","いった"],["。"],["それ"],["は"],["、"],["先生","せんせい"],["と"],["いう"],["意味","いみ"],["で"],["ある"],["。"]]},{"verse":17,"text":"イエスは彼女,かのじょに言,いわれた、「わたしにさわってはいけない。わたしは、まだ父,ちちのみもとに上,のぼっていないのだから。ただ、わたしの兄弟,きょうだいたちの所,ところに行,いって、『わたしは、わたしの父,ちちまたあなたがたの父,ちちであって、わたしの神,かみまたあなたがたの神,かみであられるかたのみもとへ上,のぼって行,いく』と、彼,かれらに伝,つたえなさい」。","tok":[["イエス"],["は"],["彼女","かのじょ"],["に"],["言われた","いわれた"],["、"],["「"],["わたし"],["に"],["さわって"],["は"],["いけない"],["。"],["わたし"],["は"],["、"],["まだ"],["父","ちち"],["のみ"],["もと"],["に"],["上って","のぼって"],["いない"],["の"],["だ"],["から"],["。"],["ただ"],["、"],["わたし"],["の"],["兄弟","きょうだい"],["たち"],["の"],["所","ところ"],["に"],["行って","いって"],["、"],["『"],["わたし"],["は"],["、"],["わたし"],["の"],["父","ちち"],["また"],["あなた"],["がた"],["の"],["父","ちち"],["で"],["あって"],["、"],["わたし"],["の"],["神","かみ"],["また"],["あなた"],["がた"],["の"],["神","かみ"],["で"],["あられる"],["かた"],["のみ"],["もと"],["へ"],["上って","のぼって"],["行く","いく"],["』"],["と"],["、"],["彼","かれ"],["ら"],["に"],["伝え","つたえ"],["なさい"],["」"],["。"]]},{"verse":18,"text":"マグダラのマリヤは弟子,でしたちのところに行,いって、自分,じぶんが主,しゅに会,あったこと、またイエスがこれこれのことを自分,じぶんに仰,おおせになったことを、報告,ほうこくした。","tok":[["マグダラ"],["の"],["マリヤ"],["は"],["弟子","でし"],["たち"],["の"],["ところ"],["に"],["行って","いって"],["、"],["自分","じぶん"],["が"],["主に","しゅに"],["会った","あった"],["こと"],["、"],["また"],["イエス"],["が"],["これ"],["これ"],["の"],["こと"],["を"],["自分","じぶん"],["に"],["仰せ","おおせ"],["に"],["なった"],["こと"],["を"],["、"],["報告","ほうこく"],["した"],["。"]]},{"verse":19,"text":"その日,ひ、すなわち、一週,しゅうの初,はじめの日,ひの夕方,ゆうがた、弟子,でしたちはユダヤ人,じんをおそれて、自分,じぶんたちのおる所,ところの戸,とをみなしめていると、イエスがはいってきて、彼,かれらの中,なかに立,たち、「安,やすかれ」と言,いわれた。","tok":[["その"],["日","ひ"],["、"],["すなわち"],["、"],["一","いち"],["週","しゅう"],["の"],["初め","はじめ"],["の"],["日","ひ"],["の"],["夕方","ゆうがた"],["、"],["弟子","でし"],["たち"],["は"],["ユダヤ人","ゆだやじん"],["を"],["おそれて"],["、"],["自分","じぶん"],["たち"],["の"],["おる"],["所","ところ"],["の"],["戸","と"],["を"],["みなしめて"],["いる"],["と"],["、"],["イエス"],["が"],["はいって"],["きて"],["、"],["彼","かれ"],["ら"],["の"],["中","なか"],["に"],["立ち","たち"],["、"],["「"],["安かれ","やすかれ"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":20,"text":"そう言,いって、手,てとわきとを、彼,かれらにお見,みせになった。弟子,でしたちは主,しゅを見,みて喜,よろこんだ。","tok":[["そう"],["言って","いって"],["、"],["手","て"],["と"],["わき"],["と"],["を"],["、"],["彼","かれ"],["ら"],["に"],["お見せ","おみせ"],["に"],["なった"],["。"],["弟子","でし"],["たち"],["は"],["主","しゅ"],["を"],["見て","みて"],["喜こんだ","よろこんだ"],["。"]]},{"verse":21,"text":"イエスはまた彼,かれらに言,いわれた、「安,やすかれ。父,ちちがわたしをおつかわしになったように、わたしもまたあなたがたをつかわす」。","tok":[["イエス"],["は"],["また"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["安かれ","やすかれ"],["。"],["父","ちち"],["が"],["わたし"],["を"],["おつかわし"],["に"],["なった"],["よう"],["に"],["、"],["わたし"],["も"],["また"],["あなた"],["がた"],["を"],["つかわす"],["」"],["。"]]},{"verse":22,"text":"そう言,いって、彼,かれらに息,いきを吹,ふきかけて仰,おおせになった、「聖霊,せいれいを受,うけよ。","tok":[["そう"],["言って","いって"],["、"],["彼","かれ"],["ら"],["に"],["息","いき"],["を"],["吹","ふき"],["かけて"],["仰せ","おおせ"],["に"],["なった"],["、"],["「"],["聖霊","せいれい"],["を"],["受よ","うけよ"],["。"]]},{"verse":23,"text":"あなたがたがゆるす罪,つみは、だれの罪,つみでもゆるされ、あなたがたがゆるさずにおく罪,つみは、そのまま残,のこるであろう」。","tok":[["あなた"],["がた"],["が"],["ゆるす"],["罪","つみ"],["は"],["、"],["だれ"],["の"],["罪","つみ"],["で"],["も"],["ゆるされ"],["、"],["あなた"],["がた"],["が"],["ゆるさず"],["に"],["おく"],["罪","つみ"],["は"],["、"],["そのまま"],["残るで","のこるで"],["あろう"],["」"],["。"]]},{"verse":24,"text":"十二弟子,でしのひとりで、デドモと呼,よばれているトマスは、イエスがこられたとき、彼,かれらと一緒,いっしょにいなかった。","tok":[["十二","じゅうに"],["弟子","でし"],["の"],["ひとり"],["で"],["、"],["デドモ"],["と"],["呼ばれて","よばれて"],["いる"],["トマス"],["は"],["、"],["イエス"],["が"],["こられた"],["とき"],["、"],["彼","かれ"],["ら"],["と"],["一緒","いっしょ"],["に"],["いなかった"],["。"]]},{"verse":25,"text":"ほかの弟子,でしたちが、彼,かれに「わたしたちは主,しゅにお目,めにかかった」と言,いうと、トマスは彼,かれらに言,いった、「わたしは、その手,てに釘,くぎあとを見,み、わたしの指,ゆびをその釘,くぎあとにさし入,いれ、また、わたしの手,てをそのわきにさし入,いれてみなければ、決,けっして信,しんじない」。","tok":[["ほか"],["の"],["弟子","でし"],["たち"],["が"],["、"],["彼","かれ"],["に"],["「"],["わたしたち"],["は"],["主に","しゅに"],["お目","おめ"],["に"],["かかった"],["」"],["と"],["言","いう"],["と"],["、"],["トマス"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["わたし"],["は"],["、"],["その"],["手","て"],["に"],["釘","くぎ"],["あと"],["を"],["見","み"],["、"],["わたし"],["の"],["指","ゆび"],["を"],["その"],["釘","くぎ"],["あと"],["に"],["さし入れ","さしいれ"],["、"],["また"],["、"],["わたし"],["の"],["手","て"],["を"],["その"],["わき"],["に"],["さし入れて","さしいれて"],["みなければ"],["、"],["決っして","けっして"],["信じない","しんじない"],["」"],["。"]]},{"verse":26,"text":"八日,かののち、イエスの弟子,でしたちはまた家,いえの内,うちにおり、トマスも一緒,いっしょにいた。戸,とはみな閉,とざされていたが、イエスがはいってこられ、中,なかに立,たって「安,やすかれ」と言,いわれた。","tok":[["八日","か"],["の"],["のち"],["、"],["イエス"],["の"],["弟子","でし"],["たち"],["は"],["また"],["家","いえ"],["の"],["内","うち"],["に"],["おり"],["、"],["トマス"],["も"],["一緒","いっしょ"],["に"],["いた"],["。"],["戸","と"],["は"],["みな"],["閉ざされて","とざされて"],["いた"],["が"],["、"],["イエス"],["が"],["はいって"],["こられ"],["、"],["中","なか"],["に"],["立って","たって"],["「"],["安かれ","やすかれ"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":27,"text":"それからトマスに言,いわれた、「あなたの指,ゆびをここにつけて、わたしの手,てを見,みなさい。手,てをのばしてわたしのわきにさし入,いれてみなさい。信,しんじない者,ものにならないで、信,しんじる者,ものになりなさい」。","tok":[["それ"],["から"],["トマス"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["の"],["指","ゆび"],["を"],["ここ"],["に"],["つけて"],["、"],["わたし"],["の"],["手","て"],["を"],["見","み"],["なさい"],["。"],["手","て"],["を"],["のばして"],["わたし"],["の"],["わき"],["に"],["さし入れて","さしいれて"],["み"],["なさい"],["。"],["信じない","しんじない"],["者","もの"],["に"],["ならないで"],["、"],["信じる","しんじる"],["者","もの"],["に"],["なり"],["なさい"],["」"],["。"]]},{"verse":28,"text":"トマスはイエスに答,こたえて言,いった、「わが主,しゅよ、わが神,かみよ」。","tok":[["トマス"],["は"],["イエス"],["に"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["わが"],["主","しゅ"],["よ"],["、"],["わが"],["神","かみ"],["よ"],["」"],["。"]]},{"verse":29,"text":"イエスは彼,かれに言,いわれた、「あなたはわたしを見,みたので信,しんじたのか。見,みないで信,しんずる者,ものは、さいわいである」。","tok":[["イエス"],["は"],["彼","かれ"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["は"],["わたし"],["を"],["見た","みた"],["ので"],["信じた","しんじた"],["の"],["か"],["。"],["見ないで","みないで"],["信ずる","しんずる"],["者","もの"],["は"],["、"],["さいわい"],["で"],["ある"],["」"],["。"]]},{"verse":30,"text":"イエスは、この書,しょに書,かかれていないしるしを、ほかにも多,おおく、弟子,でしたちの前,まえで行,おこなわれた。","tok":[["イエス"],["は"],["、"],["この"],["書","しょ"],["に"],["書かれて","かかれて"],["いない"],["しるし"],["を"],["、"],["ほか"],["に"],["も"],["多く","おおく"],["、"],["弟子","でし"],["たち"],["の"],["前","まえ"],["で"],["行なわれた","おこなわれた"],["。"]]},{"verse":31,"text":"しかし、これらのことを書,かいたのは、あなたがたがイエスは神,かみの子,こキリストであると信,しんじるためであり、また、そう信,しんじて、イエスの名,なによって命,いのちを得,えるためである。","tok":[["しかし"],["、"],["これ"],["ら"],["の"],["こと"],["を"],["書いた","かいた"],["の"],["は"],["、"],["あなた"],["がた"],["が"],["イエス"],["は"],["神","かみ"],["の"],["子","こ"],["キリスト"],["で"],["ある"],["と"],["信じる","しんじる"],["ため"],["で"],["あり"],["、"],["また"],["、"],["そう"],["信じて","しんじて"],["、"],["イエス"],["の"],["名","な"],["によって"],["命","いのち"],["を"],["得る","える"],["ため"],["で"],["ある"],["。"]]}]
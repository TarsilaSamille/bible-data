[{"verse":1,"text":"そののち、イエスはガリラヤの海,うみ、すなわち、テベリヤ湖,みずうみの向,むこう岸,ぎしへ渡,わたられた。","tok":[["その"],["のち"],["、"],["イエス"],["は"],["ガリラヤ"],["の"],["海","うみ"],["、"],["すなわち"],["、"],["テベリヤ"],["湖","みずうみ"],["の"],["向こう岸","むこうぎし"],["へ"],["渡られた","わたられた"],["。"]]},{"verse":2,"text":"すると、大,おおぜいの群衆,ぐんしゅうがイエスについてきた。病人,びょうにんたちになさっていたしるしを見,みたからである。","tok":[["する"],["と"],["、"],["大ぜい","おおぜい"],["の"],["群衆","ぐんしゅう"],["が"],["イエス"],["について"],["きた"],["。"],["病人","びょうにん"],["たち"],["に"],["なさって"],["いた"],["しるし"],["を"],["見た","みた"],["から"],["で"],["ある"],["。"]]},{"verse":3,"text":"イエスは山,やまに登,のぼって、弟子,でしたちと一緒,いっしょにそこで座,ざにつかれた。","tok":[["イエス"],["は"],["山","やま"],["に"],["登って","のぼって"],["、"],["弟子","でし"],["たち"],["と"],["一緒","いっしょ"],["に"],["そこ"],["で"],["座","ざ"],["に"],["つかれた"],["。"]]},{"verse":4,"text":"時,ときに、ユダヤ人,じんの祭,まつりである過越,すぎこしが間近,まぢかになっていた。","tok":[["時","とき"],["に"],["、"],["ユダヤ人","ゆだやじん"],["の"],["祭","まつり"],["で"],["ある"],["過越","すぎこし"],["が"],["間近","まぢか"],["に"],["なって"],["いた"],["。"]]},{"verse":5,"text":"イエスは目,めをあげ、大,おおぜいの群衆,ぐんしゅうが自分,じぶんの方,ほうに集,あつまって来,くるのを見,みて、ピリポに言,いわれた、「どこからパンを買,かってきて、この人々,ひとびとに食,たべさせようか」。","tok":[["イエス"],["は"],["目","め"],["を"],["あげ"],["、"],["大ぜい","おおぜい"],["の"],["群衆","ぐんしゅう"],["が"],["自分","じぶん"],["の"],["方","ほう"],["に"],["集まって","あつまって"],["来る","くる"],["の"],["を"],["見て","みて"],["、"],["ピリポ"],["に"],["言われた","いわれた"],["、"],["「"],["どこ"],["から"],["パン"],["を"],["買って","かって"],["きて"],["、"],["この"],["人々","ひとびと"],["に"],["食べさせよう","たべさせよう"],["か"],["」"],["。"]]},{"verse":6,"text":"これはピリポをためそうとして言,いわれたのであって、ご自分,じぶんではしようとすることを、よくご承知,しょうちであった。","tok":[["これ"],["は"],["ピリポ"],["を"],["ためそう"],["として"],["言われた","いわれた"],["ので"],["あって"],["、"],["ご自分","ごじぶん"],["で"],["は"],["しよう"],["と"],["する"],["こと"],["を"],["、"],["よく"],["ご承知","ごしょうち"],["で"],["あった"],["。"]]},{"verse":7,"text":"すると、ピリポはイエスに答,こたえた、「二百デナリのパンがあっても、めいめいが少,すこしずついただくにも足,たりますまい」。","tok":[["する"],["と"],["、"],["ピリポ"],["は"],["イエス"],["に"],["答","こたえ"],["た"],["、"],["「"],["二百","にひゃく"],["デナリ"],["の"],["パン"],["が"],["あって"],["も"],["、"],["めいめい"],["が"],["少し","すこし"],["ずつ"],["いただく"],["に"],["も"],["足りますまい","たりますまい"],["」"],["。"]]},{"verse":8,"text":"弟子,でしのひとり、シモン・ペテロの兄弟,きょうだいアンデレがイエスに言,いった、","tok":[["弟子","でし"],["の"],["ひとり"],["、"],["シモン"],["・"],["ペテロ"],["の"],["兄弟","きょうだい"],["アンデレ"],["が"],["イエス"],["に"],["言った","いった"],["、"]]},{"verse":9,"text":"「ここに、大麦,おおむぎのパン五つと、さかな二ひきとを持,もっている子供,こどもがいます。しかし、こんなに大,おおぜいの人,ひとでは、それが何,なにになりましょう」。","tok":[["「"],["ここ"],["に"],["、"],["大麦","おおむぎ"],["の"],["パン"],["五","いつ"],["つ"],["と"],["、"],["さかな"],["二","に"],["ひき"],["と"],["を"],["持って","もって"],["いる"],["子供","こども"],["が"],["います"],["。"],["しかし"],["、"],["こんな"],["に"],["大ぜい","おおぜい"],["の"],["人","ひと"],["で"],["は"],["、"],["それ"],["が"],["何に","なに"],["に"],["なりましょう"],["」"],["。"]]},{"verse":10,"text":"イエスは「人々,ひとびとをすわらせなさい」と言,いわれた。その場所,ばしょには草,くさが多,おおかった。そこにすわった男,おとこの数,かずは五千人,にんほどであった。","tok":[["イエス"],["は"],["「"],["人々","ひとびと"],["を"],["すわらせ"],["なさい"],["」"],["と"],["言われた","いわれた"],["。"],["その"],["場所","ばしょ"],["に"],["は"],["草","くさ"],["が"],["多かった","おおかった"],["。"],["そこ"],["に"],["すわった"],["男","おとこ"],["の"],["数","かず"],["は"],["五千人","にん"],["ほど"],["で"],["あった"],["。"]]},{"verse":11,"text":"そこで、イエスはパンを取,とり、感謝,かんしゃしてから、すわっている人々,ひとびとに分,わけ与,あたえ、また、さかなをも同様,どうようにして、彼,かれらの望,のぞむだけ分,わけ与,あたえられた。","tok":[["そこ"],["で"],["、"],["イエス"],["は"],["パン"],["を"],["取","とり"],["、"],["感謝","かんしゃ"],["して"],["から"],["、"],["すわって"],["いる"],["人々","ひとびと"],["に"],["分け","わけ"],["与","あたえ"],["、"],["また"],["、"],["さかな"],["を"],["も"],["同様","どうよう"],["に"],["して"],["、"],["彼","かれ"],["ら"],["の"],["望む","のぞむ"],["だけ"],["分け与えられた","わけあたえられた"],["。"]]},{"verse":12,"text":"人々,ひとびとがじゅうぶんに食,たべたのち、イエスは弟子,でしたちに言,いわれた、「少,すこしでもむだにならないように、パンくずのあまりを集,あつめなさい」。","tok":[["人々","ひとびと"],["が"],["じゅうぶん"],["に"],["食べた","たべた"],["のち"],["、"],["イエス"],["は"],["弟子","でし"],["たち"],["に"],["言われた","いわれた"],["、"],["「"],["少し","すこし"],["で"],["も"],["むだ"],["に"],["ならない"],["よう"],["に"],["、"],["パン"],["くず"],["の"],["あまり"],["を"],["集め","あつめ"],["なさい"],["」"],["。"]]},{"verse":13,"text":"そこで彼,かれらが集,あつめると、五つの大麦,おおむぎのパンを食,たべて残,のこったパンくずは、十二のかごにいっぱいになった。","tok":[["そこ"],["で"],["彼","かれ"],["ら"],["が"],["集める","あつめる"],["と"],["、"],["五","いつ"],["つ"],["の"],["大麦","おおむぎ"],["の"],["パン"],["を"],["食べて","たべて"],["残った","のこった"],["パン"],["くず"],["は"],["、"],["十二","じゅうに"],["の"],["かご"],["に"],["いっぱい"],["に"],["なった"],["。"]]},{"verse":14,"text":"人々,ひとびとはイエスのなさったこのしるしを見,みて、「ほんとうに、この人,ひとこそ世,よにきたるべき預言者,よげんしゃである」と言,いった。","tok":[["人々","ひとびと"],["は"],["イエス"],["の"],["なさった"],["この"],["しるし"],["を"],["見て","みて"],["、"],["「"],["ほんとう"],["に"],["、"],["この"],["人","ひと"],["こそ"],["世","よ"],["に"],["きたるべき"],["預言者","よげんしゃ"],["で"],["ある"],["」"],["と"],["言った","いった"],["。"]]},{"verse":15,"text":"イエスは人々,ひとびとがきて、自分,じぶんをとらえて王,おうにしようとしていると知,しって、ただひとり、また山,やまに退,しりぞかれた。","tok":[["イエス"],["は"],["人々","ひとびと"],["が"],["きて"],["、"],["自分","じぶん"],["を"],["とらえて"],["王","おう"],["に"],["しよう"],["として"],["いる"],["と"],["知って","しって"],["、"],["ただ"],["ひとり"],["、"],["また"],["山","やま"],["に"],["退ぞかれた","しりぞかれた"],["。"]]},{"verse":16,"text":"夕方,ゆうがたになったとき、弟子,でしたちは海,うみべに下,くだり、","tok":[["夕方","ゆうがた"],["に"],["なった"],["とき"],["、"],["弟子","でし"],["たち"],["は"],["海べ","うみべ"],["に"],["下り","くだり"],["、"]]},{"verse":17,"text":"舟,ふねに乗,のって海,うみを渡,わたり、向,むこう岸,ぎしのカペナウムに行,いきかけた。すでに暗,くらくなっていたのに、イエスはまだ彼,かれらのところにおいでにならなかった。","tok":[["舟","ふね"],["に"],["乗って","のって"],["海","うみ"],["を"],["渡り","わたり"],["、"],["向こう岸","むこうぎし"],["の"],["カペナウム"],["に"],["行きかけた","いきかけた"],["。"],["すでに"],["暗く","くらく"],["なって"],["いた"],["のに"],["、"],["イエス"],["は"],["まだ"],["彼","かれ"],["ら"],["の"],["ところ"],["に"],["おいで"],["に"],["ならなかった"],["。"]]},{"verse":18,"text":"その上,うえ、強,つよい風,かぜが吹,ふいてきて、海,うみは荒,あれ出,だした。","tok":[["その"],["上","うえ"],["、"],["強い","つよい"],["風","かぜ"],["が"],["吹いて","ふいて"],["きて"],["、"],["海","うみ"],["は"],["荒れ","あれ"],["出した","だした"],["。"]]},{"verse":19,"text":"四、五十丁,ちょうこぎ出,だしたとき、イエスが海,うみの上,うえを歩,あるいて舟,ふねに近,ちかづいてこられるのを見,みて、彼,かれらは恐,おそれた。","tok":[["四","よん"],["、"],["五十","ごじゅう"],["丁","ちょう"],["う"],["こぎ出した","こぎだした"],["とき"],["、"],["イエス"],["が"],["海","うみ"],["の"],["上","うえ"],["を"],["歩いて","あるいて"],["舟","ふね"],["に"],["近づいて","ちかづいて"],["こられる"],["の"],["を"],["見て","みて"],["、"],["彼","かれ"],["ら"],["は"],["恐れた","おそれた"],["。"]]},{"verse":20,"text":"すると、イエスは彼,かれらに言,いわれた、「わたしだ、恐,おそれることはない」。","tok":[["する"],["と"],["、"],["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["わたし"],["だ"],["、"],["恐れる","おそれる"],["こと"],["は"],["ない"],["」"],["。"]]},{"verse":21,"text":"そこで、彼,かれらは喜,よろこんでイエスを舟,ふねに迎,むかえようとした。すると舟,ふねは、すぐ、彼,かれらが行,いこうとしていた地,ちに着,ついた。","tok":[["そこ"],["で"],["、"],["彼","かれ"],["ら"],["は"],["喜こんで","よろこんで"],["イエス"],["を"],["舟","ふね"],["に"],["迎","むかえ"],["よう"],["と"],["した"],["。"],["する"],["と"],["舟","ふね"],["は"],["、"],["すぐ"],["、"],["彼","かれ"],["ら"],["が"],["行こう","いこう"],["として"],["いた"],["地","ち"],["に"],["着いた","ついた"],["。"]]},{"verse":22,"text":"その翌日,よくじつ、海,うみの向,むこう岸,ぎしに立,たっていた群衆,ぐんしゅうは、そこに小舟,こぶねが一そうしかなく、またイエスは弟子,でしたちと一緒,いっしょに小舟,こぶねにお乗,のりにならず、ただ弟子,でしたちだけが船出,ふなでしたのを見,みた。","tok":[["その"],["翌日","よくじつ"],["、"],["海","うみ"],["の"],["向こう岸","むこうぎし"],["に"],["立って","たって"],["いた"],["群衆","ぐんしゅう"],["は"],["、"],["そこ"],["に"],["小舟","こぶね"],["が"],["一そう","いっそう"],["しか"],["なく"],["、"],["また"],["イエス"],["は"],["弟子","でし"],["たち"],["と"],["一緒","いっしょ"],["に"],["小舟","こぶね"],["に"],["お乗","おのり"],["に"],["ならず"],["、"],["ただ"],["弟子","でし"],["たち"],["だけ"],["が"],["船出","ふなで"],["した"],["の"],["を"],["見た","みた"],["。"]]},{"verse":23,"text":"しかし、数,すうそうの小舟,こぶねがテベリヤからきて、主,しゅが感謝,かんしゃされたのちパンを人々,ひとびとに食,たべさせた場所,ばしょに近,ちかづいた。","tok":[["しかし"],["、"],["数","すう"],["そう"],["の"],["小舟","こぶね"],["が"],["テベリヤ"],["から"],["きて"],["、"],["主","しゅ"],["が"],["感謝","かんしゃ"],["された"],["のち"],["パン"],["を"],["人々","ひとびと"],["に"],["食べさせた","たべさせた"],["場所","ばしょ"],["に"],["近づいた","ちかづいた"],["。"]]},{"verse":24,"text":"群衆,ぐんしゅうは、イエスも弟子,でしたちもそこにいないと知,しって、それらの小舟,こぶねに乗,のり、イエスをたずねてカペナウムに行,いった。","tok":[["群衆","ぐんしゅう"],["は"],["、"],["イエス"],["も"],["弟子","でし"],["たち"],["も"],["そこ"],["に"],["いない"],["と"],["知って","しって"],["、"],["それ"],["ら"],["の"],["小舟","こぶね"],["に"],["乗","のり"],["、"],["イエス"],["を"],["たずねて"],["カペナウム"],["に"],["行った","いった"],["。"]]},{"verse":25,"text":"そして、海,うみの向,むこう岸,ぎしでイエスに出会,であったので言,いった、「先生,せんせい、いつ、ここにおいでになったのですか」。","tok":[["そして"],["、"],["海","うみ"],["の"],["向こう岸","むこうぎし"],["で"],["イエス"],["に"],["出会った","であった"],["ので"],["言った","いった"],["、"],["「"],["先生","せんせい"],["、"],["いつ"],["、"],["ここ"],["に"],["おいで"],["に"],["なった"],["の"],["です"],["か"],["」"],["。"]]},{"verse":26,"text":"イエスは答,こたえて言,いわれた、「よくよくあなたがたに言,いっておく。あなたがたがわたしを尋,たずねてきているのは、しるしを見,みたためではなく、パンを食,たべて満腹,まんぷくしたからである。","tok":[["イエス"],["は"],["答","こたえ"],["て"],["言われた","いわれた"],["、"],["「"],["よくよく"],["あなた"],["がた"],["に"],["言って","いって"],["おく"],["。"],["あなた"],["がた"],["が"],["わたし"],["を"],["尋ねて","たずねて"],["きて"],["いる"],["の"],["は"],["、"],["しるし"],["を"],["見た","みた"],["ため"],["で"],["は"],["なく"],["、"],["パン"],["を"],["食べて","たべて"],["満腹","まんぷく"],["した"],["から"],["で"],["ある"],["。"]]},{"verse":27,"text":"朽,くちる食物,しょくもつのためではなく、永遠,えいえんの命,いのちに至,いたる朽,くちない食物,しょくもつのために働,はたらくがよい。これは人,ひとの子,こがあなたがたに与,あたえるものである。父,ちちなる神,かみは、人,ひとの子,こにそれをゆだねられたのである」。","tok":[["朽ちる","くちる"],["食物","しょくもつ"],["の"],["ため"],["で"],["は"],["なく"],["、"],["永遠","えいえん"],["の"],["命","いのち"],["に"],["至る","いたる"],["朽ちない","くちない"],["食物","しょくもつ"],["の"],["ため"],["に"],["働く","はたらく"],["が"],["よい"],["。"],["これ"],["は"],["人","ひと"],["の"],["子","こ"],["が"],["あなた"],["がた"],["に"],["与える","あたえる"],["もの"],["で"],["ある"],["。"],["父","ちち"],["なる"],["神","かみ"],["は"],["、"],["人","ひと"],["の"],["子","こ"],["に"],["それ"],["を"],["ゆだねられた"],["ので"],["ある"],["」"],["。"]]},{"verse":28,"text":"そこで、彼,かれらはイエスに言,いった、「神,かみのわざを行,おこなうために、わたしたちは何,なにをしたらよいでしょうか」。","tok":[["そこ"],["で"],["、"],["彼","かれ"],["ら"],["は"],["イエス"],["に"],["言った","いった"],["、"],["「"],["神","かみ"],["の"],["わざ"],["を"],["行なう","おこなう"],["ため"],["に"],["、"],["わたしたち"],["は"],["何に","なに"],["を"],["したら"],["よいでしょう"],["か"],["」"],["。"]]},{"verse":29,"text":"イエスは彼,かれらに答,こたえて言,いわれた、「神,かみがつかわされた者,ものを信,しんじることが、神,かみのわざである」。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["に"],["答","こたえ"],["て"],["言われた","いわれた"],["、"],["「"],["神","かみ"],["が"],["つかわされた"],["者","もの"],["を"],["信じる","しんじる"],["こと"],["が"],["、"],["神","かみ"],["の"],["わざ"],["で"],["ある"],["」"],["。"]]},{"verse":30,"text":"彼,かれらはイエスに言,いった、「わたしたちが見,みてあなたを信,しんじるために、どんなしるしを行,おこなって下,くださいますか。どんなことをして下,くださいますか。","tok":[["彼","かれ"],["ら"],["は"],["イエス"],["に"],["言った","いった"],["、"],["「"],["わたしたち"],["が"],["見て","みて"],["あなた"],["を"],["信じる","しんじる"],["ため"],["に"],["、"],["どんな"],["しるし"],["を"],["行なって","おこなって"],["下さいます","くださいます"],["か"],["。"],["どんな"],["こと"],["を"],["して"],["下さいます","くださいます"],["か"],["。"]]},{"verse":31,"text":"わたしたちの先祖,せんぞは荒野,あらのでマナを食,たべました。それは『天,てんよりのパンを彼,かれらに与,あたえて食,たべさせた』と書,かいてあるとおりです」。","tok":[["わたしたち"],["の"],["先祖","せんぞ"],["は"],["荒野","あらの"],["で"],["マナ"],["を"],["食べました","たべました"],["。"],["それ"],["は"],["『"],["天","てん"],["より"],["の"],["パン"],["を"],["彼","かれ"],["ら"],["に"],["与","あたえ"],["て"],["食べさせた","たべさせた"],["』"],["と"],["書いて","かいて"],["ある"],["とおり"],["です"],["」"],["。"]]},{"verse":32,"text":"そこでイエスは彼,かれらに言,いわれた、「よくよく言,いっておく。天,てんからのパンをあなたがたに与,あたえたのは、モーセではない。天,てんからのまことのパンをあなたがたに与,あたえるのは、わたしの父,ちちなのである。","tok":[["そこ"],["で"],["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["よくよく"],["言って","いって"],["おく"],["。"],["天","てん"],["から"],["の"],["パン"],["を"],["あなた"],["がた"],["に"],["与","あたえ"],["た"],["の"],["は"],["、"],["モーセ"],["で"],["は"],["ない"],["。"],["天","てん"],["から"],["の"],["まこと"],["の"],["パン"],["を"],["あなた"],["がた"],["に"],["与える","あたえる"],["の"],["は"],["、"],["わたし"],["の"],["父","ちち"],["な"],["ので"],["ある"],["。"]]},{"verse":33,"text":"神,かみのパンは、天,てんから下,くだってきて、この世,よに命,いのちを与,あたえるものである」。","tok":[["神","かみ"],["の"],["パン"],["は"],["、"],["天","てん"],["から"],["下って","くだって"],["きて"],["、"],["この世","このよ"],["に"],["命","いのち"],["を"],["与える","あたえる"],["もの"],["で"],["ある"],["」"],["。"]]},{"verse":34,"text":"彼,かれらはイエスに言,いった、「主,しゅよ、そのパンをいつもわたしたちに下,ください」。","tok":[["彼","かれ"],["ら"],["は"],["イエス"],["に"],["言った","いった"],["、"],["「"],["主","しゅ"],["よ"],["、"],["その"],["パン"],["を"],["いつも"],["わたしたち"],["に"],["下さい","ください"],["」"],["。"]]},{"verse":35,"text":"イエスは彼,かれらに言,いわれた、「わたしが命,いのちのパンである。わたしに来,くる者,ものは決,けっして飢,うえることがなく、わたしを信,しんじる者,ものは決,けっしてかわくことがない。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["わたし"],["が"],["命","いのち"],["の"],["パン"],["で"],["ある"],["。"],["わたし"],["に"],["来る","くる"],["者","もの"],["は"],["決っして","けっして"],["飢","うえ"],["る"],["こと"],["が"],["なく"],["、"],["わたし"],["を"],["信じる","しんじる"],["者","もの"],["は"],["決っして","けっして"],["かわく"],["こと"],["が"],["ない"],["。"]]},{"verse":36,"text":"しかし、あなたがたに言,いったが、あなたがたはわたしを見,みたのに信,しんじようとはしない。","tok":[["しかし"],["、"],["あなた"],["がた"],["に"],["言った","いった"],["が"],["、"],["あなた"],["がた"],["は"],["わたし"],["を"],["見た","みた"],["のに"],["信じよう","しんじよう"],["と"],["は"],["しない"],["。"]]},{"verse":37,"text":"父,ちちがわたしに与,あたえて下,くださる者,ものは皆,みな、わたしに来,くるであろう。そして、わたしに来,くる者,ものを決,けっして拒,こばみはしない。","tok":[["父","ちち"],["が"],["わたし"],["に"],["与","あたえ"],["て"],["下さる","くださる"],["者","もの"],["は"],["皆","みな"],["、"],["わたし"],["に"],["来るで","くるで"],["あろう"],["。"],["そして"],["、"],["わたし"],["に"],["来る","くる"],["者","もの"],["を"],["決っして","けっして"],["拒み","こばみ"],["は"],["しない"],["。"]]},{"verse":38,"text":"わたしが天,てんから下,くだってきたのは、自分,じぶんのこころのままを行,おこなうためではなく、わたしをつかわされたかたのみこころを行,おこなうためである。","tok":[["わたし"],["が"],["天","てん"],["から"],["下って","くだって"],["きた"],["の"],["は"],["、"],["自分","じぶん"],["の"],["こころ"],["の"],["まま"],["を"],["行なう","おこなう"],["ため"],["で"],["は"],["なく"],["、"],["わたし"],["を"],["つかわされた"],["かた"],["のみ"],["こころ"],["を"],["行なう","おこなう"],["ため"],["で"],["ある"],["。"]]},{"verse":39,"text":"わたしをつかわされたかたのみこころは、わたしに与,あたえて下,くださった者,ものを、わたしがひとりも失,うしなわずに、終,おわりの日,ひによみがえらせることである。","tok":[["わたし"],["を"],["つかわされた"],["かた"],["のみ"],["こころ"],["は"],["、"],["わたし"],["に"],["与","あたえ"],["て"],["下さった","くださった"],["者","もの"],["を"],["、"],["わたし"],["が"],["ひとり"],["も"],["失なわず","うしなわず"],["に"],["、"],["終","おわり"],["の"],["日","ひ"],["に"],["よみがえらせる"],["こと"],["で"],["ある"],["。"]]},{"verse":40,"text":"わたしの父,ちちのみこころは、子,こを見,みて信,しんじる者,ものが、ことごとく永遠,えいえんの命,いのちを得,えることなのである。そして、わたしはその人々,ひとびとを終,おわりの日,ひによみがえらせるであろう」。","tok":[["わたし"],["の"],["父","ちち"],["のみ"],["こころ"],["は"],["、"],["子","こ"],["を"],["見て","みて"],["信じる","しんじる"],["者","もの"],["が"],["、"],["ことごとく"],["永遠","えいえん"],["の"],["命","いのち"],["を"],["得る","える"],["こと"],["な"],["ので"],["ある"],["。"],["そして"],["、"],["わたし"],["は"],["その"],["人々","ひとびと"],["を"],["終","おわり"],["の"],["日","ひ"],["に"],["よみがえらせるで"],["あろう"],["」"],["。"]]},{"verse":41,"text":"ユダヤ人,じんらは、イエスが「わたしは天,てんから下,くだってきたパンである」と言,いわれたので、イエスについてつぶやき始,はじめた。","tok":[["ユダヤ人","ゆだやじん"],["ら"],["は"],["、"],["イエス"],["が"],["「"],["わたし"],["は"],["天","てん"],["から"],["下って","くだって"],["きた"],["パン"],["で"],["ある"],["」"],["と"],["言われた","いわれた"],["ので"],["、"],["イエス"],["について"],["つぶやき"],["始めた","はじめた"],["。"]]},{"verse":42,"text":"そして言,いった、「これはヨセフの子,こイエスではないか。わたしたちはその父母,ふぼを知,しっているではないか。わたしは天,てんから下,くだってきたと、どうして今,いまいうのか」。","tok":[["そして"],["言った","いった"],["、"],["「"],["これ"],["は"],["ヨセフ"],["の"],["子","こ"],["イエス"],["で"],["は"],["ない"],["か"],["。"],["わたしたち"],["は"],["その"],["父母","ふぼ"],["を"],["知って","しって"],["いるで"],["は"],["ない"],["か"],["。"],["わたし"],["は"],["天","てん"],["から"],["下って","くだって"],["きた"],["と"],["、"],["どう"],["して"],["今","いま"],["いう"],["の"],["か"],["」"],["。"]]},{"verse":43,"text":"イエスは彼,かれらに答,こたえて言,いわれた、「互,たがいにつぶやいてはいけない。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["に"],["答","こたえ"],["て"],["言われた","いわれた"],["、"],["「"],["互","たがい"],["に"],["つぶやいて"],["は"],["いけない"],["。"]]},{"verse":44,"text":"わたしをつかわされた父,ちちが引,ひきよせて下,くださらなければ、だれもわたしに来,くることはできない。わたしは、その人々,ひとびとを終,おわりの日,ひによみがえらせるであろう。","tok":[["わたし"],["を"],["つかわされた"],["父","ちち"],["が"],["引","ひき"],["よせて"],["下さらなければ","くださらなければ"],["、"],["だれ"],["も"],["わたし"],["に"],["来る","くる"],["こと"],["は"],["できない"],["。"],["わたし"],["は"],["、"],["その"],["人々","ひとびと"],["を"],["終","おわり"],["の"],["日","ひ"],["に"],["よみがえらせるで"],["あろう"],["。"]]},{"verse":45,"text":"預言者,よげんしゃの書,しょに、『彼,かれらはみな神,かみに教,おしえられるであろう』と書,かいてある。父,ちちから聞,きいて学,まなんだ者,ものは、みなわたしに来,くるのである。","tok":[["預言者","よげんしゃ"],["の"],["書","しょ"],["に"],["、"],["『"],["彼","かれ"],["ら"],["は"],["みな"],["神","かみ"],["に"],["教えられるで","おしえられるで"],["あろう"],["』"],["と"],["書いて","かいて"],["ある"],["。"],["父","ちち"],["から"],["聞いて","きいて"],["学んだ","まなんだ"],["者","もの"],["は"],["、"],["みな"],["わたし"],["に"],["来る","くる"],["ので"],["ある"],["。"]]},{"verse":46,"text":"神,かみから出,でた者,もののほかに、だれかが父,ちちを見,みたのではない。その者,ものだけが父,ちちを見,みたのである。","tok":[["神","かみ"],["から"],["出た","でた"],["者","もの"],["の"],["ほか"],["に"],["、"],["だれ"],["か"],["が"],["父","ちち"],["を"],["見た","みた"],["ので"],["は"],["ない"],["。"],["その"],["者","もの"],["だけ"],["が"],["父","ちち"],["を"],["見た","みた"],["ので"],["ある"],["。"]]},{"verse":47,"text":"よくよくあなたがたに言,いっておく。信,しんじる者,ものには永遠,えいえんの命,いのちがある。","tok":[["よくよく"],["あなた"],["がた"],["に"],["言って","いって"],["おく"],["。"],["信じる","しんじる"],["者","もの"],["に"],["は"],["永遠","えいえん"],["の"],["命","いのち"],["が"],["ある"],["。"]]},{"verse":48,"text":"わたしは命,いのちのパンである。","tok":[["わたし"],["は"],["命","いのち"],["の"],["パン"],["で"],["ある"],["。"]]},{"verse":49,"text":"あなたがたの先祖,せんぞは荒野,あらのでマナを食,たべたが、死,しんでしまった。","tok":[["あなた"],["がた"],["の"],["先祖","せんぞ"],["は"],["荒野","あらの"],["で"],["マナ"],["を"],["食べた","たべた"],["が"],["、"],["死んで","しんで"],["しまった"],["。"]]},{"verse":50,"text":"しかし、天,てんから下,くだってきたパンを食,たべる人,ひとは、決,けっして死,しぬことはない。","tok":[["しかし"],["、"],["天","てん"],["から"],["下って","くだって"],["きた"],["パン"],["を"],["食べる","たべる"],["人","ひと"],["は"],["、"],["決っして","けっして"],["死ぬ","しぬ"],["こと"],["は"],["ない"],["。"]]},{"verse":51,"text":"わたしは天,てんから下,くだってきた生,いきたパンである。それを食,たべる者,ものは、いつまでも生,いきるであろう。わたしが与,あたえるパンは、世,よの命,いのちのために与,あたえるわたしの肉,にくである」。","tok":[["わたし"],["は"],["天","てん"],["から"],["下って","くだって"],["きた"],["生きた","いきた"],["パン"],["で"],["ある"],["。"],["それ"],["を"],["食べる","たべる"],["者","もの"],["は"],["、"],["いつ"],["まで"],["も"],["生きるで","いきるで"],["あろう"],["。"],["わたし"],["が"],["与える","あたえる"],["パン"],["は"],["、"],["世","よ"],["の"],["命","いのち"],["の"],["ため"],["に"],["与える","あたえる"],["わたし"],["の"],["肉","にく"],["で"],["ある"],["」"],["。"]]},{"verse":52,"text":"そこで、ユダヤ人,じんらが互,たがいに論,ろんじて言,いった、「この人,ひとはどうして、自分,じぶんの肉,にくをわたしたちに与,あたえて食,たべさせることができようか」。","tok":[["そこ"],["で"],["、"],["ユダヤ人","ゆだやじん"],["ら"],["が"],["互","たがい"],["に"],["論じて","ろんじて"],["言った","いった"],["、"],["「"],["この"],["人","ひと"],["は"],["どう"],["して"],["、"],["自分","じぶん"],["の"],["肉","にく"],["を"],["わたしたち"],["に"],["与","あたえ"],["て"],["食べさせる","たべさせる"],["こと"],["が"],["できよう"],["か"],["」"],["。"]]},{"verse":53,"text":"イエスは彼,かれらに言,いわれた、「よくよく言,いっておく。人,ひとの子,この肉,にくを食,たべず、また、その血,ちを飲,のまなければ、あなたがたの内,うちに命,いのちはない。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["よくよく"],["言って","いって"],["おく"],["。"],["人","ひと"],["の"],["子","こ"],["の"],["肉","にく"],["を"],["食べず","たべず"],["、"],["また"],["、"],["その"],["血","ち"],["を"],["飲まなければ","のまなければ"],["、"],["あなた"],["がた"],["の"],["内","うち"],["に"],["命","いのち"],["は"],["ない"],["。"]]},{"verse":54,"text":"わたしの肉,にくを食,たべ、わたしの血,ちを飲,のむ者,ものには、永遠,えいえんの命,いのちがあり、わたしはその人,ひとを終,おわりの日,ひによみがえらせるであろう。","tok":[["わたし"],["の"],["肉","にく"],["を"],["食べ","たべ"],["、"],["わたし"],["の"],["血","ち"],["を"],["飲む","のむ"],["者","もの"],["に"],["は"],["、"],["永遠","えいえん"],["の"],["命","いのち"],["が"],["あり"],["、"],["わたし"],["は"],["その"],["人","ひと"],["を"],["終","おわり"],["の"],["日","ひ"],["に"],["よみがえらせるで"],["あろう"],["。"]]},{"verse":55,"text":"わたしの肉,にくはまことの食物,しょくもつ、わたしの血,ちはまことの飲,のみ物,ものである。","tok":[["わたし"],["の"],["肉","にく"],["は"],["まこと"],["の"],["食物","しょくもつ"],["、"],["わたし"],["の"],["血","ち"],["は"],["まこと"],["の"],["飲み物","のみもの"],["で"],["ある"],["。"]]},{"verse":56,"text":"わたしの肉,にくを食,たべ、わたしの血,ちを飲,のむ者,ものはわたしにおり、わたしもまたその人,ひとにおる。","tok":[["わたし"],["の"],["肉","にく"],["を"],["食べ","たべ"],["、"],["わたし"],["の"],["血","ち"],["を"],["飲む","のむ"],["者","もの"],["は"],["わたし"],["に"],["おり"],["、"],["わたし"],["も"],["また"],["その"],["人","ひと"],["に"],["おる"],["。"]]},{"verse":57,"text":"生,いける父,ちちがわたしをつかわされ、また、わたしが父,ちちによって生,いきているように、わたしを食,たべる者,ものもわたしによって生,いきるであろう。","tok":[["生ける","いける"],["父","ちち"],["が"],["わたし"],["を"],["つかわされ"],["、"],["また"],["、"],["わたし"],["が"],["父","ちち"],["によって"],["生きて","いきて"],["いる"],["よう"],["に"],["、"],["わたし"],["を"],["食べる","たべる"],["者","もの"],["も"],["わたし"],["によって"],["生きるで","いきるで"],["あろう"],["。"]]},{"verse":58,"text":"天,てんから下,くだってきたパンは、先祖,せんぞたちが食,たべたが死,しんでしまったようなものではない。このパンを食,たべる者,ものは、いつまでも生,いきるであろう」。","tok":[["天","てん"],["から"],["下って","くだって"],["きた"],["パン"],["は"],["、"],["先祖","せんぞ"],["たち"],["が"],["食べた","たべた"],["が"],["死んで","しんで"],["しまった"],["よう"],["な"],["もの"],["で"],["は"],["ない"],["。"],["この"],["パン"],["を"],["食べる","たべる"],["者","もの"],["は"],["、"],["いつ"],["まで"],["も"],["生きるで","いきるで"],["あろう"],["」"],["。"]]},{"verse":59,"text":"これらのことは、イエスがカペナウムの会堂,かいどうで教,おしえておられたときに言,いわれたものである。","tok":[["これ"],["ら"],["の"],["こと"],["は"],["、"],["イエス"],["が"],["カペナウム"],["の"],["会堂","かいどう"],["で"],["教えて","おしえて"],["おられた"],["とき"],["に"],["言われた","いわれた"],["もの"],["で"],["ある"],["。"]]},{"verse":60,"text":"弟子,でしたちのうちの多,おおくの者,ものは、これを聞,きいて言,いった、「これは、ひどい言葉,ことばだ。だれがそんなことを聞,きいておられようか」。","tok":[["弟子","でし"],["たち"],["の"],["うち"],["の"],["多く","おおく"],["の"],["者","もの"],["は"],["、"],["これ"],["を"],["聞いて","きいて"],["言った","いった"],["、"],["「"],["これ"],["は"],["、"],["ひどい"],["言葉","ことば"],["だ"],["。"],["だれ"],["が"],["そんな"],["こと"],["を"],["聞いて","きいて"],["おられよう"],["か"],["」"],["。"]]},{"verse":61,"text":"しかしイエスは、弟子,でしたちがそのことでつぶやいているのを見破,みやぶって、彼,かれらに言,いわれた、「このことがあなたがたのつまずきになるのか。","tok":[["しかし"],["イエス"],["は"],["、"],["弟子","でし"],["たち"],["が"],["その"],["こと"],["で"],["つぶやいて"],["いる"],["の"],["を"],["見破って","みやぶって"],["、"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["この"],["こと"],["が"],["あなた"],["がた"],["の"],["つまずき"],["に"],["なる"],["の"],["か"],["。"]]},{"verse":62,"text":"それでは、もし人,ひとの子,こが前,まえにいた所,ところに上,のぼるのを見,みたら、どうなるのか。","tok":[["それ"],["で"],["は"],["、"],["もし"],["人","ひと"],["の"],["子","こ"],["が"],["前","まえ"],["に"],["いた"],["所","ところ"],["に"],["上る","のぼる"],["の"],["を"],["見たら","みたら"],["、"],["どう"],["なる"],["の"],["か"],["。"]]},{"verse":63,"text":"人,ひとを生,いかすものは霊,れいであって、肉,にくはなんの役,やくにも立,たたない。わたしがあなたがたに話,はなした言葉,ことばは霊,れいであり、また命,いのちである。","tok":[["人","ひと"],["を"],["生かす","いかす"],["もの"],["は"],["霊","れい"],["で"],["あって"],["、"],["肉","にく"],["は"],["なん"],["の"],["役","やく"],["に"],["も"],["立たない","たたない"],["。"],["わたし"],["が"],["あなた"],["がた"],["に"],["話","はなし"],["た"],["言葉","ことば"],["は"],["霊","れい"],["で"],["あり"],["、"],["また"],["命","いのち"],["で"],["ある"],["。"]]},{"verse":64,"text":"しかし、あなたがたの中,なかには信,しんじない者,ものがいる」。イエスは、初,はじめから、だれが信,しんじないか、また、だれが彼,かれを裏切,うらぎるかを知,しっておられたのである。","tok":[["しかし"],["、"],["あなた"],["がた"],["の"],["中","なか"],["に"],["は"],["信じない","しんじない"],["者","もの"],["が"],["いる"],["」"],["。"],["イエス"],["は"],["、"],["初め","はじめ"],["から"],["、"],["だれ"],["が"],["信じない","しんじない"],["か"],["、"],["また"],["、"],["だれ"],["が"],["彼","かれ"],["を"],["裏切る","うらぎる"],["か"],["を"],["知って","しって"],["おられた"],["ので"],["ある"],["。"]]},{"verse":65,"text":"そしてイエスは言,いわれた、「それだから、父,ちちが与,あたえて下,くださった者,ものでなければ、わたしに来,くることはできないと、言,いったのである」。","tok":[["そして"],["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["それ"],["だ"],["から"],["、"],["父","ちち"],["が"],["与","あたえ"],["て"],["下さった","くださった"],["者","もの"],["で"],["なければ"],["、"],["わたし"],["に"],["来る","くる"],["こと"],["は"],["できない"],["と"],["、"],["言った","いった"],["ので"],["ある"],["」"],["。"]]},{"verse":66,"text":"それ以来,いらい、多,おおくの弟子,でしたちは去,さっていって、もはやイエスと行動,こうどうを共,ともにしなかった。","tok":[["それ"],["以来","いらい"],["、"],["多く","おおく"],["の"],["弟子","でし"],["たち"],["は"],["去て","さって"],["いって"],["、"],["もはや"],["イエス"],["と"],["行動","こうどう"],["を"],["共","とも"],["に"],["しなかった"],["。"]]},{"verse":67,"text":"そこでイエスは十二弟子,でしに言,いわれた、「あなたがたも去,さろうとするのか」。","tok":[["そこ"],["で"],["イエス"],["は"],["十二","じゅうに"],["弟子","でし"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["がた"],["も"],["去ろう","さろう"],["と"],["する"],["の"],["か"],["」"],["。"]]},{"verse":68,"text":"シモン・ペテロが答,こたえた、「主,しゅよ、わたしたちは、だれのところに行,いきましょう。永遠,えいえんの命,いのちの言,ことばをもっているのはあなたです。","tok":[["シモン"],["・"],["ペテロ"],["が"],["答","こたえ"],["た"],["、"],["「"],["主","しゅ"],["よ"],["、"],["わたしたち"],["は"],["、"],["だれ"],["の"],["ところ"],["に"],["行きましょう","いきましょう"],["。"],["永遠","えいえん"],["の"],["命","いのち"],["の"],["言","ことば"],["を"],["もって"],["いる"],["の"],["は"],["あなた"],["です"],["。"]]},{"verse":69,"text":"わたしたちは、あなたが神,かみの聖者,せいじゃであることを信,しんじ、また知,しっています」。","tok":[["わたしたち"],["は"],["、"],["あなた"],["が"],["神","かみ"],["の"],["聖者","せいじゃ"],["で"],["ある"],["こと"],["を"],["信じ","しんじ"],["、"],["また"],["知って","しって"],["います"],["」"],["。"]]},{"verse":70,"text":"イエスは彼,かれらに答,こたえられた、「あなたがた十二人,にんを選,えらんだのは、わたしではなかったか。それだのに、あなたがたのうちのひとりは悪魔,あくまである」。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["に"],["答","こたえ"],["られた"],["、"],["「"],["あなた"],["がた"],["十二人","にん"],["を"],["選らんだ","えらんだ"],["の"],["は"],["、"],["わたし"],["で"],["は"],["なかった"],["か"],["。"],["それ"],["だ"],["のに"],["、"],["あなた"],["がた"],["の"],["うち"],["の"],["ひとり"],["は"],["悪魔","あくま"],["で"],["ある"],["」"],["。"]]},{"verse":71,"text":"これは、イスカリオテのシモンの子,こユダをさして言,いわれたのである。このユダは、十二弟子,でしのひとりでありながら、イエスを裏切,うらぎろうとしていた。","tok":[["これ"],["は"],["、"],["イスカリオテ"],["の"],["シモン"],["の"],["子","こ"],["ユダ"],["を"],["さして"],["言われた","いわれた"],["ので"],["ある"],["。"],["この"],["ユダ"],["は"],["、"],["十二","じゅうに"],["弟子","でし"],["の"],["ひとり"],["で"],["あり"],["ながら"],["、"],["イエス"],["を"],["裏切ろう","うらぎろう"],["として"],["いた"],["。"]]}]
[{"verse":1,"text":"初,はじめに言,ことばがあった。言,ことばは神,かみと共,ともにあった。言,ことばは神,かみであった。","tok":[["初め","はじめ"],["に"],["言","ことば"],["が"],["あった"],["。"],["言","ことば"],["は"],["神","かみ"],["と"],["共","とも"],["に"],["あった"],["。"],["言","ことば"],["は"],["神","かみ"],["で"],["あった"],["。"]]},{"verse":2,"text":"この言,ことばは初,はじめに神,かみと共,ともにあった。","tok":[["この"],["言","ことば"],["は"],["初め","はじめ"],["に"],["神","かみ"],["と"],["共","とも"],["に"],["あった"],["。"]]},{"verse":3,"text":"すべてのものは、これによってできた。できたもののうち、一つとしてこれによらないものはなかった。","tok":[["すべて"],["の"],["もの"],["は"],["、"],["これ"],["によって"],["できた"],["。"],["できた"],["もの"],["の"],["うち"],["、"],["一","ひと"],["つ"],["として"],["これ"],["に"],["よらない"],["もの"],["は"],["なかった"],["。"]]},{"verse":4,"text":"この言,ことばに命,いのちがあった。そしてこの命,いのちは人,ひとの光,ひかりであった。","tok":[["この"],["言","ことば"],["に"],["命","いのち"],["が"],["あった"],["。"],["そして"],["この"],["命","いのち"],["は"],["人","ひと"],["の"],["光","ひかり"],["で"],["あった"],["。"]]},{"verse":5,"text":"光,ひかりはやみの中,なかに輝,かがやいている。そして、やみはこれに勝,かたなかった。","tok":[["光","ひかり"],["は"],["やみ"],["の"],["中","なか"],["に"],["輝やいて","かがやいて"],["いる"],["。"],["そして"],["、"],["やみ"],["は"],["これ"],["に"],["勝たなかった","かたなかった"],["。"]]},{"verse":6,"text":"ここにひとりの人,ひとがあって、神,かみからつかわされていた。その名,なをヨハネと言,いった。","tok":[["ここ"],["に"],["ひとり"],["の"],["人","ひと"],["が"],["あって"],["、"],["神","かみ"],["から"],["つかわされて"],["いた"],["。"],["その"],["名","な"],["を"],["ヨハネ"],["と"],["言った","いった"],["。"]]},{"verse":7,"text":"この人,ひとはあかしのためにきた。光,ひかりについてあかしをし、彼,かれによってすべての人,ひとが信,しんじるためである。","tok":[["この"],["人","ひと"],["は"],["あかし"],["の"],["ため"],["に"],["きた"],["。"],["光","ひかり"],["について"],["あかし"],["を"],["し"],["、"],["彼","かれ"],["によって"],["すべて"],["の"],["人","ひと"],["が"],["信じる","しんじる"],["ため"],["で"],["ある"],["。"]]},{"verse":8,"text":"彼,かれは光,ひかりではなく、ただ、光,ひかりについてあかしをするためにきたのである。","tok":[["彼","かれ"],["は"],["光","ひかり"],["で"],["は"],["なく"],["、"],["ただ"],["、"],["光","ひかり"],["について"],["あかし"],["を"],["する"],["ため"],["に"],["きた"],["ので"],["ある"],["。"]]},{"verse":9,"text":"すべての人,ひとを照,てらすまことの光,ひかりがあって、世,よにきた。","tok":[["すべて"],["の"],["人","ひと"],["を"],["照らす","てらす"],["まこと"],["の"],["光","ひかり"],["が"],["あって"],["、"],["世","よ"],["に"],["きた"],["。"]]},{"verse":10,"text":"彼,かれは世,よにいた。そして、世,よは彼,かれによってできたのであるが、世,よは彼,かれを知,しらずにいた。","tok":[["彼","かれ"],["は"],["世","よ"],["に"],["いた"],["。"],["そして"],["、"],["世","よ"],["は"],["彼","かれ"],["によって"],["できた"],["ので"],["ある"],["が"],["、"],["世","よ"],["は"],["彼","かれ"],["を"],["知らず","しらず"],["に"],["いた"],["。"]]},{"verse":11,"text":"彼,かれは自分,じぶんのところにきたのに、自分,じぶんの民,たみは彼,かれを受,うけいれなかった。","tok":[["彼","かれ"],["は"],["自分","じぶん"],["の"],["ところ"],["に"],["きた"],["のに"],["、"],["自分","じぶん"],["の"],["民","たみ"],["は"],["彼","かれ"],["を"],["受","うけ"],["いれなかった"],["。"]]},{"verse":12,"text":"しかし、彼,かれを受,うけいれた者,もの、すなわち、その名,なを信,しんじた人々,ひとびとには、彼,かれは神,かみの子,ことなる力,ちからを与,あたえたのである。","tok":[["しかし"],["、"],["彼","かれ"],["を"],["受","うけ"],["いれた"],["者","もの"],["、"],["すなわち"],["、"],["その"],["名","な"],["を"],["信じた","しんじた"],["人々","ひとびと"],["に"],["は"],["、"],["彼","かれ"],["は"],["神","かみ"],["の"],["子","こ"],["と"],["なる"],["力","ちから"],["を"],["与","あたえ"],["た"],["ので"],["ある"],["。"]]},{"verse":13,"text":"それらの人,ひとは、血,ちすじによらず、肉,にくの欲,よくによらず、また、人,ひとの欲,よくにもよらず、ただ神,かみによって生,うまれたのである。","tok":[["それ"],["ら"],["の"],["人","ひと"],["は"],["、"],["血すじ","ちすじ"],["に"],["よらず"],["、"],["肉","にく"],["の"],["欲","よく"],["に"],["よらず"],["、"],["また"],["、"],["人","ひと"],["の"],["欲","よく"],["に"],["も"],["よらず"],["、"],["ただ"],["神","かみ"],["によって"],["生まれた","うまれた"],["ので"],["ある"],["。"]]},{"verse":14,"text":"そして言,ことばは肉体,にくたいとなり、わたしたちのうちに宿,やどった。わたしたちはその栄光,えいこうを見,みた。それは父,ちちのひとり子,ことしての栄光,えいこうであって、めぐみとまこととに満,みちていた。","tok":[["そして"],["言","ことば"],["は"],["肉体","にくたい"],["と"],["なり"],["、"],["わたしたち"],["の"],["うち"],["に"],["宿った","やどった"],["。"],["わたしたち"],["は"],["その"],["栄光","えいこう"],["を"],["見た","みた"],["。"],["それ"],["は"],["父","ちち"],["の"],["ひとり"],["子","こ"],["として"],["の"],["栄光","えいこう"],["で"],["あって"],["、"],["めぐみ"],["と"],["まこと"],["と"],["に"],["満ちて","みちて"],["いた"],["。"]]},{"verse":15,"text":"ヨハネは彼,かれについてあかしをし、叫,さけんで言,いった、「『わたしのあとに来,くるかたは、わたしよりもすぐれたかたである。わたしよりも先,さきにおられたからである』とわたしが言,いったのは、この人,ひとのことである」。","tok":[["ヨハネ"],["は"],["彼","かれ"],["について"],["あかし"],["を"],["し"],["、"],["叫けんで","さけんで"],["言った","いった"],["、"],["「"],["『"],["わたし"],["の"],["あと"],["に"],["来る","くる"],["かた"],["は"],["、"],["わたし"],["より"],["も"],["すぐれた"],["かた"],["で"],["ある"],["。"],["わたし"],["より"],["も"],["先","さき"],["に"],["おられた"],["から"],["で"],["ある"],["』"],["と"],["わたし"],["が"],["言った","いった"],["の"],["は"],["、"],["この"],["人","ひと"],["の"],["こと"],["で"],["ある"],["」"],["。"]]},{"verse":16,"text":"わたしたちすべての者,ものは、その満,みち満,みちているものの中,なかから受,うけて、めぐみにめぐみを加,くわえられた。","tok":[["わたしたち"],["すべて"],["の"],["者","もの"],["は"],["、"],["その"],["満ち満ちて","みちみちて"],["いる"],["もの"],["の"],["中","なか"],["から"],["受けて","うけて"],["、"],["めぐみ"],["に"],["めぐみ"],["を"],["加えられた","くわえられた"],["。"]]},{"verse":17,"text":"律法,りっぽうはモーセをとおして与,あたえられ、めぐみとまこととは、イエス・キリストをとおしてきたのである。","tok":[["律法","りっぽう"],["は"],["モーセ"],["を"],["とおして"],["与えられ","あたえられ"],["、"],["めぐみ"],["と"],["まこと"],["と"],["は"],["、"],["イエス"],["・"],["キリスト"],["を"],["とおして"],["きた"],["ので"],["ある"],["。"]]},{"verse":18,"text":"神,かみを見,みた者,ものはまだひとりもいない。ただ父,ちちのふところにいるひとり子,こなる神,かみだけが、神,かみをあらわしたのである。","tok":[["神","かみ"],["を"],["見た","みた"],["者","もの"],["は"],["まだ"],["ひとり"],["も"],["いない"],["。"],["ただ"],["父","ちち"],["の"],["ふところ"],["に"],["いる"],["ひとり"],["子","こ"],["なる"],["神","かみ"],["だけ"],["が"],["、"],["神","かみ"],["を"],["あらわした"],["ので"],["ある"],["。"]]},{"verse":19,"text":"さて、ユダヤ人,じんたちが、エルサレムから祭司,さいしたちやレビ人,ひとたちをヨハネのもとにつかわして、「あなたはどなたですか」と問,とわせたが、その時,ときヨハネが立,たてたあかしは、こうであった。","tok":[["さて"],["、"],["ユダヤ人","ゆだやじん"],["たち"],["が"],["、"],["エルサレム"],["から"],["祭司","さいし"],["たち"],["や"],["レビ人","れびひと"],["たち"],["を"],["ヨハネ"],["の"],["もと"],["に"],["つかわして"],["、"],["「"],["あなた"],["は"],["どなた"],["です"],["か"],["」"],["と"],["問わせた","とわせた"],["が"],["、"],["その"],["時","とき"],["ヨハネ"],["が"],["立てた","たてた"],["あかし"],["は"],["、"],["こう"],["で"],["あった"],["。"]]},{"verse":20,"text":"すなわち、彼,かれは告白,こくはくして否,いなまず、「わたしはキリストではない」と告白,こくはくした。","tok":[["すなわち"],["、"],["彼","かれ"],["は"],["告白","こくはく"],["して"],["否まず","いなまず"],["、"],["「"],["わたし"],["は"],["キリスト"],["で"],["は"],["ない"],["」"],["と"],["告白","こくはく"],["した"],["。"]]},{"verse":21,"text":"そこで、彼,かれらは問,とうた、「それでは、どなたなのですか、あなたはエリヤですか」。彼,かれは「いや、そうではない」と言,いった。「では、あの預言者,よげんしゃですか」。彼,かれは「いいえ」と答,こたえた。","tok":[["そこ"],["で"],["、"],["彼","かれ"],["ら"],["は"],["問うた","とうた"],["、"],["「"],["それ"],["で"],["は"],["、"],["どなた"],["な"],["の"],["です"],["か"],["、"],["あなた"],["は"],["エリヤ"],["です"],["か"],["」"],["。"],["彼","かれ"],["は"],["「"],["いや"],["、"],["そう"],["で"],["は"],["ない"],["」"],["と"],["言った","いった"],["。"],["「"],["で"],["は"],["、"],["あの"],["預言者","よげんしゃ"],["です"],["か"],["」"],["。"],["彼","かれ"],["は"],["「"],["いいえ"],["」"],["と"],["答","こたえ"],["た"],["。"]]},{"verse":22,"text":"そこで、彼,かれらは言,いった、「あなたはどなたですか。わたしたちをつかわした人々,ひとびとに、答,こたえを持,もって行,いけるようにしていただきたい。あなた自身,じしんをだれだと考,かんがえるのですか」。","tok":[["そこ"],["で"],["、"],["彼","かれ"],["ら"],["は"],["言った","いった"],["、"],["「"],["あなた"],["は"],["どなた"],["です"],["か"],["。"],["わたしたち"],["を"],["つかわした"],["人々","ひとびと"],["に"],["、"],["答","こたえ"],["を"],["持って","もって"],["行ける","いける"],["よう"],["に"],["して"],["いただきたい"],["。"],["あなた"],["自身","じしん"],["を"],["だれ"],["だ"],["と"],["考","かんがえ"],["る"],["の"],["です"],["か"],["」"],["。"]]},{"verse":23,"text":"彼,かれは言,いった、「わたしは、預言者,よげんしゃイザヤが言,いったように、『主,しゅの道,みちをまっすぐにせよと荒野,あらので呼,よばわる者,ものの声,こえ』である」。","tok":[["彼","かれ"],["は"],["言った","いった"],["、"],["「"],["わたし"],["は"],["、"],["預言者","よげんしゃ"],["イザヤ"],["が"],["言った","いった"],["よう"],["に"],["、"],["『"],["主","しゅ"],["の"],["道","みち"],["を"],["まっすぐ"],["に"],["せよ"],["と"],["荒野","あらの"],["で"],["呼ばわる","よばわる"],["者","もの"],["の"],["声","こえ"],["』"],["で"],["ある"],["」"],["。"]]},{"verse":24,"text":"つかわされた人,ひとたちは、パリサイ人,びとであった。","tok":[["つかわされた"],["人","ひと"],["たち"],["は"],["、"],["パリサイ"],["人","び"],["と"],["で"],["あった"],["。"]]},{"verse":25,"text":"彼,かれらはヨハネに問,とうて言,いった、「では、あなたがキリストでもエリヤでもまたあの預言者,よげんしゃでもないのなら、なぜバプテスマを授,さづけるのですか」。","tok":[["彼","かれ"],["ら"],["は"],["ヨハネ"],["に"],["問うて","とうて"],["言った","いった"],["、"],["「"],["で"],["は"],["、"],["あなた"],["が"],["キリスト"],["で"],["も"],["エリヤ"],["で"],["も"],["また"],["あの"],["預言者","よげんしゃ"],["で"],["も"],["ない"],["の"],["なら"],["、"],["なぜ"],["バプテスマ"],["を"],["授","さづける"],["の"],["です"],["か"],["」"],["。"]]},{"verse":26,"text":"ヨハネは彼,かれらに答,こたえて言,いった、「わたしは水,みずでバプテスマを授,さづけるが、あなたがたの知,しらないかたが、あなたがたの中,なかに立,たっておられる。","tok":[["ヨハネ"],["は"],["彼","かれ"],["ら"],["に"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["わたし"],["は"],["水","みず"],["で"],["バプテスマ"],["を"],["授","さ"],["づける"],["が"],["、"],["あなた"],["がた"],["の"],["知らない","しらない"],["か"],["た"],["が"],["、"],["あなた"],["がた"],["の"],["中","なか"],["に"],["立って","たって"],["おられる"],["。"]]},{"verse":27,"text":"それがわたしのあとにあとにおいでになる方,かたであって、わたしはその人,ひとのくつのひもを解,とく値,ねうちもない」。","tok":[["それ"],["が"],["わたし"],["の"],["あと"],["に"],["あと"],["に"],["おいで"],["に"],["なる"],["方","かた"],["で"],["あって"],["、"],["わたし"],["は"],["その"],["人","ひと"],["の"],["くつ"],["の"],["ひも"],["を"],["解く","とく"],["値うち","ねうち"],["も"],["ない"],["」"],["。"]]},{"verse":28,"text":"これらのことは、ヨハネがバプテスマを授,さづけていたヨルダンの向,むこうのベタニヤであったのである。","tok":[["これ"],["ら"],["の"],["こと"],["は"],["、"],["ヨハネ"],["が"],["バプテスマ"],["を"],["授","さ"],["づけて"],["いた"],["ヨルダン"],["の"],["向こう","むこう"],["の"],["ベタニヤ"],["で"],["あった"],["ので"],["ある"],["。"]]},{"verse":29,"text":"その翌日,よくじつ、ヨハネはイエスが自分,じぶんの方,ほうにこられるのを見,みて言,いった、「見,みよ、世,よの罪,つみを取,とり除,のぞく神,かみの小羊,こひつじ。","tok":[["その"],["翌日","よくじつ"],["、"],["ヨハネ"],["は"],["イエス"],["が"],["自分","じぶん"],["の"],["方","ほう"],["に"],["こられる"],["の"],["を"],["見て","みて"],["言った","いった"],["、"],["「"],["見よ","みよ"],["、"],["世","よ"],["の"],["罪","つみ"],["を"],["取除く","とりのぞく"],["神","かみ"],["の"],["小羊","こひつじ"],["。"]]},{"verse":30,"text":"『わたしのあとに来,くるかたは、わたしよりもすぐれたかたである。わたしよりも先,さきにおられたからである』とわたしが言,いったのは、この人,ひとのことである。","tok":[["『"],["わたし"],["の"],["あと"],["に"],["来る","くる"],["かた"],["は"],["、"],["わたし"],["より"],["も"],["すぐれた"],["かた"],["で"],["ある"],["。"],["わたし"],["より"],["も"],["先","さき"],["に"],["おられた"],["から"],["で"],["ある"],["』"],["と"],["わたし"],["が"],["言った","いった"],["の"],["は"],["、"],["この"],["人","ひと"],["の"],["こと"],["で"],["ある"],["。"]]},{"verse":31,"text":"わたしはこのかたを知,しらなかった。しかし、このかたがイスラエルに現,あらわれてくださるそのことのために、わたしはきて、水,みずでバプテスマを授,さづけているのである」。","tok":[["わたし"],["は"],["このかた"],["を"],["知らなかった","しらなかった"],["。"],["しかし"],["、"],["このかた"],["が"],["イスラエル"],["に"],["現われて","あらわれて"],["くださる"],["その"],["こと"],["の"],["ため"],["に"],["、"],["わたし"],["は"],["きて"],["、"],["水","みず"],["で"],["バプテスマ"],["を"],["授","さ"],["づけて"],["いる"],["ので"],["ある"],["」"],["。"]]},{"verse":32,"text":"ヨハネはまたあかしをして言,いった、「わたしは、御霊,みたまがはとのように天,てんから下,くだって、彼,かれの上,うえにとどまるのを見,みた。","tok":[["ヨハネ"],["は"],["また"],["あかし"],["を"],["して"],["言った","いった"],["、"],["「"],["わたし"],["は"],["、"],["御霊","みたま"],["が"],["はと"],["の"],["よう"],["に"],["天","てん"],["から"],["下って","くだって"],["、"],["彼","かれ"],["の"],["上","うえ"],["に"],["とどまる"],["の"],["を"],["見た","みた"],["。"]]},{"verse":33,"text":"わたしはこの人,ひとを知,しらなかった。しかし、水,みずでバプテスマを授,さづけるようにと、わたしをおつかわしになったそのかたが、わたしに言,いわれた、『ある人,ひとの上,うえに、御霊,みたまが下,くだってとどまるのを見,みたら、その人,ひとこそは、御霊,みたまによってバプテスマを授,さづけるかたである』。","tok":[["わたし"],["は"],["この"],["人","ひと"],["を"],["知らなかった","しらなかった"],["。"],["しかし"],["、"],["水","みず"],["で"],["バプテスマ"],["を"],["授","さ"],["づける"],["よう"],["に"],["と"],["、"],["わたし"],["を"],["おつかわし"],["に"],["なった"],["その"],["かた"],["が"],["、"],["わたし"],["に"],["言われた","いわれた"],["、"],["『"],["ある"],["人","ひと"],["の"],["上","うえ"],["に"],["、"],["御霊","み"],["たま"],["が"],["下って","くだって"],["とどまる"],["の"],["を"],["見たら","みたら"],["、"],["その"],["人","ひと"],["こそ"],["は"],["、"],["御霊","みたま"],["によって"],["バプテスマ"],["を"],["授","さ"],["づける"],["かた"],["で"],["ある"],["』"],["。"]]},{"verse":34,"text":"わたしはそれを見,みたので、このかたこそ神,かみの子,こであると、あかしをしたのである」。","tok":[["わたし"],["は"],["それ"],["を"],["見た","みた"],["ので"],["、"],["この"],["かた"],["こそ"],["神","かみ"],["の"],["子","こ"],["で"],["ある"],["と"],["、"],["あかし"],["を"],["した"],["ので"],["ある"],["」"],["。"]]},{"verse":35,"text":"その翌日,よくじつ、ヨハネはまたふたりの弟子,でしたちと一緒,いっしょに立,たっていたが、","tok":[["その"],["翌日","よくじつ"],["、"],["ヨハネ"],["は"],["また"],["ふたり"],["の"],["弟子","でし"],["たち"],["と"],["一緒","いっしょ"],["に"],["立って","たって"],["いた"],["が"],["、"]]},{"verse":36,"text":"イエスが歩,あるいておられるのに目,めをとめて言,いった、「見,みよ、神,かみの小羊,こひつじ」。","tok":[["イエス"],["が"],["歩いて","あるいて"],["おられる"],["のに"],["目","め"],["を"],["とめて"],["言った","いった"],["、"],["「"],["見よ","みよ"],["、"],["神","かみ"],["の"],["小羊","こひつじ"],["」"],["。"]]},{"verse":37,"text":"そのふたりの弟子,でしは、ヨハネがそう言,いうのを聞,きいて、イエスについて行,いった。","tok":[["その"],["ふたり"],["の"],["弟子","でし"],["は"],["、"],["ヨハネ"],["が"],["そう"],["言う","いう"],["の"],["を"],["聞いて","きいて"],["、"],["イエス"],["について"],["行った","いった"],["。"]]},{"verse":38,"text":"イエスはふり向,むき、彼,かれらがついてくるのを見,みて言,いわれた、「何,なにか願,ねがいがあるのか」。彼,かれらは言,いった、「ラビ（訳,やくして言,いえば、先生,せんせい）どこにおとまりなのですか」。","tok":[["イエス"],["は"],["ふり向き","ふりむき"],["、"],["彼","かれ"],["ら"],["が"],["ついて"],["くる"],["の"],["を"],["見て","みて"],["言われた","いわれた"],["、"],["「"],["何に","なに"],["か"],["願い","ねがい"],["が"],["ある"],["の"],["か"],["」"],["。"],["彼","かれ"],["ら"],["は"],["言った","いった"],["、"],["「"],["ラビ"],["（"],["訳して","やくして"],["言えば","いえば"],["、"],["先生","せんせい"],["）"],["どこ"],["に"],["おとまり"],["な"],["の"],["です"],["か"],["」"],["。"]]},{"verse":39,"text":"イエスは彼,かれらに言,いわれた、「きてごらんなさい。そうしたらわかるだろう」。そこで彼,かれらはついて行,いって、イエスの泊,とまっておられる所,ところを見,みた。そして、その日,ひはイエスのところに泊,とまった。時,ときは午後,ごご四時,じごろであった。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["きて"],["ごらん"],["なさい"],["。"],["そう"],["したら"],["わかるだろう"],["」"],["。"],["そこ"],["で"],["彼","かれ"],["ら"],["は"],["ついて"],["行って","いって"],["、"],["イエス"],["の"],["泊まって","とまって"],["おられる"],["所","ところ"],["を"],["見た","みた"],["。"],["そして"],["、"],["その"],["日","ひ"],["は"],["イエス"],["の"],["ところ"],["に"],["泊まった","とまった"],["。"],["時","とき"],["は"],["午後","ごご"],["四","し"],["時","じ"],["ごろ"],["で"],["あった"],["。"]]},{"verse":40,"text":"ヨハネから聞,きいて、イエスについて行,いったふたりのうちのひとりは、シモン・ペテロの兄弟,きょうだいアンデレであった。","tok":[["ヨハネ"],["から"],["聞いて","きいて"],["、"],["イエス"],["について"],["行った","いった"],["ふたり"],["の"],["うち"],["の"],["ひとり"],["は"],["、"],["シモン"],["・"],["ペテロ"],["の"],["兄弟","きょうだい"],["アンデレ"],["で"],["あった"],["。"]]},{"verse":41,"text":"彼,かれはまず自分,じぶんの兄弟,きょうだいシモンに出会,であって言,いった、「わたしたちはメシヤ（訳,やくせば、キリスト）にいま出会,であった」。","tok":[["彼","かれ"],["は"],["まず"],["自分","じぶん"],["の"],["兄弟","きょうだい"],["シモン"],["に"],["出会って","であって"],["言った","いった"],["、"],["「"],["わたしたち"],["は"],["メシヤ"],["（"],["訳せば","やくせば"],["、"],["キリスト"],["）"],["に"],["いま"],["出会った","であった"],["」"],["。"]]},{"verse":42,"text":"そしてシモンをイエスのもとにつれてきた。イエスは彼,かれに目,めをとめて言,いわれた、「あなたはヨハネの子,こシモンである。あなたをケパ（訳,やくせば、ペテロ）と呼,よぶことにする」。","tok":[["そして"],["シモン"],["を"],["イエス"],["の"],["もと"],["に"],["つれて"],["きた"],["。"],["イエス"],["は"],["彼","かれ"],["に"],["目","め"],["を"],["とめて"],["言われた","いわれた"],["、"],["「"],["あなた"],["は"],["ヨハネ"],["の"],["子","こ"],["シモン"],["で"],["ある"],["。"],["あなた"],["を"],["ケパ"],["（"],["訳せば","やくせば"],["、"],["ペテロ"],["）"],["と"],["呼ぶ","よぶ"],["こと"],["に"],["する"],["」"],["。"]]},{"verse":43,"text":"その翌日,よくじつ、イエスはガリラヤに行,いこうとされたが、ピリポに出会,であって言,いわれた、「わたしに従,したがってきなさい」。","tok":[["その"],["翌日","よくじつ"],["、"],["イエス"],["は"],["ガリラヤ"],["に"],["行こう","いこう"],["と"],["された"],["が"],["、"],["ピリポ"],["に"],["出会って","であって"],["言われた","いわれた"],["、"],["「"],["わたし"],["に"],["従って","したがって"],["き"],["なさい"],["」"],["。"]]},{"verse":44,"text":"ピリポは、アンデレとペテロとの町,まちベツサイダの人,ひとであった。","tok":[["ピリポ"],["は"],["、"],["アンデレ"],["と"],["ペテロ"],["と"],["の"],["町","まち"],["ベツサイダ"],["の"],["人","ひと"],["で"],["あった"],["。"]]},{"verse":45,"text":"このピリポがナタナエルに出会,であって言,いった、「わたしたちは、モーセが律法,りっぽうの中,なかにしるしており、預言者,よげんしゃたちがしるしていた人,ひと、ヨセフの子,こ、ナザレのイエスにいま出会,であった」。","tok":[["この"],["ピリポ"],["が"],["ナタナエル"],["に"],["出会って","であって"],["言った","いった"],["、"],["「"],["わたしたち"],["は"],["、"],["モーセ"],["が"],["律法","りっぽう"],["の"],["中","なか"],["に"],["しるして"],["おり"],["、"],["預言者","よげんしゃ"],["たち"],["が"],["しるして"],["いた"],["人","ひと"],["、"],["ヨセフ"],["の"],["子","こ"],["、"],["ナザレ"],["の"],["イエス"],["に"],["いま"],["出会った","であった"],["」"],["。"]]},{"verse":46,"text":"ナタナエルは彼,かれに言,いった、「ナザレから、なんのよいものが出,でようか」。ピリポは彼,かれに言,いった、「きて見,みなさい」。","tok":[["ナタナエル"],["は"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["ナザレ"],["から"],["、"],["なん"],["の"],["よい"],["もの"],["が"],["出よう","でよう"],["か"],["」"],["。"],["ピリポ"],["は"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["きて"],["見","み"],["なさい"],["」"],["。"]]},{"verse":47,"text":"イエスはナタナエルが自分,じぶんの方,ほうに来,くるのを見,みて、彼,かれについて言,いわれた、「見,みよ、あの人,ひとこそ、ほんとうのイスラエル人,びとである。その心,こころには偽,いつわりがない」。","tok":[["イエス"],["は"],["ナタナエル"],["が"],["自分","じぶん"],["の"],["方","ほう"],["に"],["来る","くる"],["の"],["を"],["見て","みて"],["、"],["彼","かれ"],["について"],["言われた","いわれた"],["、"],["「"],["見よ","みよ"],["、"],["あの"],["人","ひと"],["こそ"],["、"],["ほんとう"],["の"],["イスラエル"],["人","び"],["と"],["で"],["ある"],["。"],["その"],["心","こころ"],["に"],["は"],["偽り","いつわり"],["が"],["ない"],["」"],["。"]]},{"verse":48,"text":"ナタナエルは言,いった、「どうしてわたしをご存,ぞんじなのですか」。イエスは答,こたえて言,いわれた、「ピリポがあなたを呼,よぶ前,まえに、わたしはあなたが、いちじくの木,きの下,したにいるのを見,みた」。","tok":[["ナタナエル"],["は"],["言った","いった"],["、"],["「"],["どう"],["して"],["わたし"],["を"],["ご存じ","ごぞんじ"],["な"],["の"],["です"],["か"],["」"],["。"],["イエス"],["は"],["答","こたえ"],["て"],["言われた","いわれた"],["、"],["「"],["ピリポ"],["が"],["あなた"],["を"],["呼ぶ","よぶ"],["前","まえ"],["に"],["、"],["わたし"],["は"],["あなた"],["が"],["、"],["いちじく"],["の"],["木","き"],["の"],["下","した"],["に"],["いる"],["の"],["を"],["見た","みた"],["」"],["。"]]},{"verse":49,"text":"ナタナエルは答,こたえた、「先生,せんせい、あなたは神,かみの子,こです。あなたはイスラエルの王,おうです」。","tok":[["ナタナエル"],["は"],["答","こたえ"],["た"],["、"],["「"],["先生","せんせい"],["、"],["あなた"],["は"],["神","かみ"],["の"],["子","こ"],["です"],["。"],["あなた"],["は"],["イスラエル"],["の"],["王","おう"],["です"],["」"],["。"]]},{"verse":50,"text":"イエスは答,こたえて言,いわれた、「あなたが、いちじくの木,きの下,したにいるのを見,みたと、わたしが言,いったので信,しんじるのか。これよりも、もっと大,おおきなことを、あなたは見,みるであろう」。","tok":[["イエス"],["は"],["答","こたえ"],["て"],["言われた","いわれた"],["、"],["「"],["あなた"],["が"],["、"],["いちじく"],["の"],["木","き"],["の"],["下","した"],["に"],["いる"],["の"],["を"],["見た","みた"],["と"],["、"],["わたし"],["が"],["言った","いった"],["ので"],["信じる","しんじる"],["の"],["か"],["。"],["これ"],["より"],["も"],["、"],["もっと"],["大きな","おおきな"],["こと"],["を"],["、"],["あなた"],["は"],["見るで","みるで"],["あろう"],["」"],["。"]]},{"verse":51,"text":"また言,いわれた、「よくよくあなたがたに言,いっておく。天,てんが開,あけて、神,かみの御使,みつかいたちが人,ひとの子,この上,うえに上,のぼり下,くだりするのを、あなたがたは見,みるであろう」。","tok":[["また"],["言われた","いわれた"],["、"],["「"],["よくよく"],["あなた"],["がた"],["に"],["言って","いって"],["おく"],["。"],["天","てん"],["が"],["開けて","あけて"],["、"],["神","かみ"],["の"],["御使","みつかい"],["たち"],["が"],["人","ひと"],["の"],["子","こ"],["の"],["上","うえ"],["に"],["上り下り","のぼりくだり"],["する"],["の"],["を"],["、"],["あなた"],["がた"],["は"],["見るで","みるで"],["あろう"],["」"],["。"]]}]
[{"verse":1,"text":"こののち、ユダヤ人,じんの祭,まつりがあったので、イエスはエルサレムに上,のぼられた。","tok":[["この"],["のち"],["、"],["ユダヤ人","ゆだやじん"],["の"],["祭","まつり"],["が"],["あった"],["ので"],["、"],["イエス"],["は"],["エルサレム"],["に"],["上られた","のぼられた"],["。"]]},{"verse":2,"text":"エルサレムにある羊,ひつじの門,もんのそばに、ヘブル語,ごでベテスダと呼,よばれる池,いけがあった。そこには五つの廊,ろうがあった。","tok":[["エルサレム"],["に"],["ある"],["羊","ひつじ"],["の"],["門","もん"],["の"],["そば"],["に"],["、"],["ヘブル"],["語","ご"],["で"],["ベテスダ"],["と"],["呼ばれる","よばれる"],["池","いけ"],["が"],["あった"],["。"],["そこ"],["に"],["は"],["五","いつ"],["つ"],["の"],["廊","ろう"],["が"],["あった"],["。"]]},{"verse":3,"text":"その廊,ろうの中,なかには、病人,びょうにん、盲人,もうじん、足,あしなえ、やせ衰,おとろえた者,ものなどが、大,おおぜいからだを横,よこたえていた。〔彼,かれらは水,みずの動,うごくのを待,まっていたのである。","tok":[["その"],["廊","ろう"],["の"],["中","なか"],["に"],["は"],["、"],["病人","びょうにん"],["、"],["盲人","もうじん"],["、"],["足","あし"],["なえ"],["、"],["やせ衰えた","やせおとろえた"],["者","もの"],["など"],["が"],["、"],["大ぜい","おおぜい"],["からだ"],["を"],["横たえて","よこたえて"],["いた"],["。"],["〔"],["彼","かれ"],["ら"],["は"],["水","みず"],["の"],["動く","うごく"],["の"],["を"],["待って","まって"],["いた"],["ので"],["ある"],["。"]]},{"verse":4,"text":"それは、時々,ときどき、主,しゅの御使,みつかいがこの池,いけに降,おりてきて水,みずを動,うごかすことがあるが、水,みずが動,うごいた時,ときまっ先,さきにはいる者,ものは、どんな病気,びょうきにかかっていても、いやされたからである。〕","tok":[["それ"],["は"],["、"],["時々","ときどき"],["、"],["主","しゅ"],["の"],["御使","みつかいがこ"],["の"],["池","いけ"],["に"],["降りて","おりて"],["きて"],["水","みず"],["を"],["動かす","うごかす"],["こと"],["が"],["ある"],["が"],["、"],["水","みず"],["が"],["動いた","うごいた"],["時","とき"],["まっ先","まっさき"],["に"],["はいる"],["者","もの"],["は"],["、"],["どんな"],["病気","びょうき"],["に"],["かかって"],["いて"],["も"],["、"],["いやされた"],["から"],["で"],["ある"],["。"],["〕"]]},{"verse":5,"text":"さて、そこに三十八年,ねんのあいだ、病気,びょうきに悩,なやんでいる人,ひとがあった。","tok":[["さて"],["、"],["そこ"],["に"],["三十八","さんじゅうはち"],["年","ねん"],["の"],["あいだ"],["、"],["病気","びょうき"],["に"],["悩んで","なやんで"],["いる"],["人","ひと"],["が"],["あった"],["。"]]},{"verse":6,"text":"イエスはその人,ひとが横,よこになっているのを見,み、また長,ながい間,あいだわずらっていたのを知,しって、その人,ひとに「なおりたいのか」と言,いわれた。","tok":[["イエス"],["は"],["その"],["人","ひと"],["が"],["横","よこ"],["に"],["なって"],["いる"],["の"],["を"],["見","み"],["、"],["また"],["長い","ながい"],["間","あいだ"],["わずらって"],["いた"],["の"],["を"],["知って","しって"],["、"],["その"],["人","ひと"],["に"],["「"],["なおりたい"],["の"],["か"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":7,"text":"この病人,びょうにんはイエスに答,こたえた、「主,しゅよ、水,みずが動,うごく時,ときに、わたしを池,いけの中,なかに入,いれてくれる人,ひとがいません。わたしがはいりかけると、ほかの人,ひとが先,さきに降,おりて行,いくのです」。","tok":[["この"],["病人","びょうにん"],["は"],["イエス"],["に"],["答","こたえ"],["た"],["、"],["「"],["主","しゅ"],["よ"],["、"],["水","みず"],["が"],["動く","うごく"],["時","とき"],["に"],["、"],["わたし"],["を"],["池","いけ"],["の"],["中","なか"],["に"],["入れて","いれて"],["くれる"],["人","ひと"],["が"],["いません"],["。"],["わたし"],["が"],["はいり"],["かける"],["と"],["、"],["ほか"],["の"],["人","ひと"],["が"],["先","さき"],["に"],["降りて","おりて"],["行く","いく"],["の"],["です"],["」"],["。"]]},{"verse":8,"text":"イエスは彼,かれに言,いわれた、「起,おきて、あなたの床,とこを取,とりあげ、そして歩,あるきなさい」。","tok":[["イエス"],["は"],["彼","かれ"],["に"],["言われた","いわれた"],["、"],["「"],["起きて","おきて"],["、"],["あなた"],["の"],["床","とこ"],["を"],["取","とり"],["あげ"],["、"],["そして"],["歩き","あるき"],["なさい"],["」"],["。"]]},{"verse":9,"text":"すると、この人,ひとはすぐにいやされ、床,とこをとりあげて歩,あるいて行,いった。その日,ひは安息日,あんそくにちであった。","tok":[["する"],["と"],["、"],["この"],["人","ひと"],["は"],["すぐ"],["に"],["いやされ"],["、"],["床","とこ"],["を"],["とりあげて"],["歩いて","あるいて"],["行った","いった"],["。"],["その"],["日","ひ"],["は"],["安息日","あん"],["そ"],["く"],["にち"],["で"],["あった"],["。"]]},{"verse":10,"text":"そこでユダヤ人,じんたちは、そのいやされた人,ひとに言,いった、「きょうは安息日,あんそくにちだ。床,とこを取,とりあげるのは、よろしくない」。","tok":[["そこ"],["で"],["ユダヤ人","ゆだやじん"],["たち"],["は"],["、"],["その"],["いやされた"],["人","ひと"],["に"],["言った","いった"],["、"],["「"],["きょう"],["は"],["安息","あんそく"],["日にち","ひにち"],["だ"],["。"],["床","とこ"],["を"],["取","とり"],["あげる"],["の"],["は"],["、"],["よろしく"],["ない"],["」"],["。"]]},{"verse":11,"text":"彼,かれは答,こたえた、「わたしをなおして下,くださったかたが、床,とこを取,とりあげて歩,あるけと、わたしに言,いわれました」。","tok":[["彼","かれ"],["は"],["答","こたえ"],["た"],["、"],["「"],["わたし"],["を"],["なおして"],["下さった","くださった"],["かた"],["が"],["、"],["床","とこ"],["を"],["取","とり"],["あげて"],["歩け","あるけ"],["と"],["、"],["わたし"],["に"],["言われました","いわれました"],["」"],["。"]]},{"verse":12,"text":"彼,かれらは尋,たずねた、「取,とりあげて歩,あるけと言,いった人,ひとは、だれか」。","tok":[["彼","かれ"],["ら"],["は"],["尋ねた","たずねた"],["、"],["「"],["取","とり"],["あげて"],["歩け","あるけ"],["と"],["言った","いった"],["人","ひと"],["は"],["、"],["だれ"],["か"],["」"],["。"]]},{"verse":13,"text":"しかし、このいやされた人,ひとは、それがだれであるか知,しらなかった。群衆,ぐんしゅうがその場,ばにいたので、イエスはそっと出,でて行,いかれたからである。","tok":[["しかし"],["、"],["この"],["いやされた"],["人","ひと"],["は"],["、"],["それ"],["が"],["だれ"],["で"],["ある"],["か"],["知らなかった","しらなかった"],["。"],["群衆","ぐんしゅう"],["が"],["その"],["場","ば"],["に"],["いた"],["ので"],["、"],["イエス"],["は"],["そっと"],["出て","でて"],["行かれた","いかれた"],["から"],["で"],["ある"],["。"]]},{"verse":14,"text":"そののち、イエスは宮,みやでその人,ひとに出会,であったので、彼,かれに言,いわれた、「ごらん、あなたはよくなった。もう罪,つみを犯,おかしてはいけない。何,なにかもっと悪,わるいことが、あなたの身,みに起,おこるかも知,しれないから」。","tok":[["その"],["のち"],["、"],["イエス"],["は"],["宮","みや"],["で"],["その"],["人","ひと"],["に"],["出会った","であった"],["ので"],["、"],["彼","かれ"],["に"],["言われた","いわれた"],["、"],["「"],["ごらん"],["、"],["あなた"],["は"],["よく"],["なった"],["。"],["もう"],["罪","つみ"],["を"],["犯して","おかして"],["は"],["いけない"],["。"],["何に","なに"],["か"],["もっと"],["悪い","わるい"],["こと"],["が"],["、"],["あなた"],["の"],["身","み"],["に"],["起こる","おこる"],["か"],["も"],["知れない","しれない"],["から"],["」"],["。"]]},{"verse":15,"text":"彼,かれは出,でて行,いって、自分,じぶんをいやしたのはイエスであったと、ユダヤ人,じんたちに告,つげた。","tok":[["彼","かれ"],["は"],["出て","でて"],["行って","いって"],["、"],["自分","じぶん"],["を"],["いやした"],["の"],["は"],["イエス"],["で"],["あった"],["と"],["、"],["ユダヤ人","ゆだやじん"],["たち"],["に"],["告","つげ"],["た"],["。"]]},{"verse":16,"text":"そのためユダヤ人,じんたちは、安息日,あんそくにちにこのようなことをしたと言,いって、イエスを責,せめた。","tok":[["その"],["ため"],["ユダヤ人","ゆだやじん"],["たち"],["は"],["、"],["安息日","あんそくにち"],["に"],["この"],["よう"],["な"],["こと"],["を"],["した"],["と"],["言って","いって"],["、"],["イエス"],["を"],["責","せめ"],["た"],["。"]]},{"verse":17,"text":"そこで、イエスは彼,かれらに答,こたえられた、「わたしの父,ちちは今,いまに至,いたるまで働,はたらいておられる。わたしも働,はたらくのである」。","tok":[["そこ"],["で"],["、"],["イエス"],["は"],["彼","かれ"],["ら"],["に"],["答","こたえ"],["られた"],["、"],["「"],["わたし"],["の"],["父","ちち"],["は"],["今","いま"],["に"],["至る","いたる"],["まで"],["働いて","はたらいて"],["おられる"],["。"],["わたし"],["も"],["働く","はたらく"],["ので"],["ある"],["」"],["。"]]},{"verse":18,"text":"このためにユダヤ人,じんたちは、ますますイエスを殺,ころそうと計,はかるようになった。それは、イエスが安息日,あんそくにちを破,やぶられたばかりではなく、神,かみを自分,じぶんの父,ちちと呼,よんで、自分,じぶんを神,かみと等,ひとしいものとされたからである。","tok":[["この"],["ため"],["に"],["ユダヤ人","ゆだやじん"],["たち"],["は"],["、"],["ますます"],["イエス"],["を"],["殺そう","ころそう"],["と"],["計る","はかる"],["よう"],["に"],["なった"],["。"],["それ"],["は"],["、"],["イエス"],["が"],["安息日","あんそくにち"],["を"],["破られた","やぶられた"],["ばかり"],["で"],["は"],["なく"],["、"],["神","かみ"],["を"],["自分","じぶん"],["の"],["父","ちち"],["と"],["呼んで","よんで"],["、"],["自分","じぶん"],["を"],["神","かみ"],["と"],["等い","ひとしい"],["もの"],["と"],["された"],["から"],["で"],["ある"],["。"]]},{"verse":19,"text":"さて、イエスは彼,かれらに答,こたえて言,いわれた、「よくよくあなたがたに言,いっておく。子,こは父,ちちのなさることを見,みてする以外,いがいに、自分,じぶんからは何事,なにごともすることができない。父,ちちのなさることであればすべて、子,こもそのとおりにするのである。","tok":[["さて"],["、"],["イエス"],["は"],["彼","かれ"],["ら"],["に"],["答","こたえ"],["て"],["言われた","いわれた"],["、"],["「"],["よくよく"],["あなた"],["がた"],["に"],["言って","いって"],["おく"],["。"],["子","こ"],["は"],["父","ちち"],["の"],["なさる"],["こと"],["を"],["見て","みて"],["する"],["以外","いがい"],["に"],["、"],["自分","じぶん"],["から"],["は"],["何事","なにごと"],["も"],["する"],["こと"],["が"],["できない"],["。"],["父","ちち"],["の"],["なさる"],["こと"],["で"],["あれば"],["すべて"],["、"],["子","こ"],["も"],["その"],["とおり"],["に"],["する"],["ので"],["ある"],["。"]]},{"verse":20,"text":"なぜなら、父,ちちは子,こを愛,あいして、みずからなさることは、すべて子,こにお示,しめしになるからである。そして、それよりもなお大,おおきなわざを、お示,しめしになるであろう。あなたがたが、それによって不思議,ふしぎに思,おもうためである。","tok":[["なぜ"],["なら"],["、"],["父","ちち"],["は"],["子","こ"],["を"],["愛して","あいして"],["、"],["みずから"],["なさる"],["こと"],["は"],["、"],["すべて"],["子","こ"],["に"],["お示めし","おしめし"],["に"],["なる"],["から"],["で"],["ある"],["。"],["そして"],["、"],["それ"],["より"],["も"],["なお"],["大きな","おおきな"],["わざ"],["を"],["、"],["お示めし","おしめし"],["に"],["なるで"],["あろう"],["。"],["あなた"],["が"],["た"],["が"],["、"],["それ"],["によって"],["不思議","ふしぎ"],["に"],["思う","おもう"],["ため"],["で"],["ある"],["。"]]},{"verse":21,"text":"すなわち、父,ちちが死人,しにんを起,おこして命,いのちをお与,あたえになるように、子,こもまた、そのこころにかなう人々,ひとびとに命,いのちを与,あたえるであろう。","tok":[["すなわち"],["、"],["父","ちち"],["が"],["死人","しにん"],["を"],["起こして","おこして"],["命","いのち"],["を"],["お"],["与","あたえ"],["に"],["なる"],["よう"],["に"],["、"],["子","こ"],["も"],["また"],["、"],["その"],["こころ"],["に"],["かなう"],["人々","ひとびと"],["に"],["命","いのち"],["を"],["与えるで","あたえるで"],["あろう"],["。"]]},{"verse":22,"text":"父,ちちはだれをもさばかない。さばきのことはすべて、子,こにゆだねられたからである。","tok":[["父","ちち"],["は"],["だれ"],["を"],["も"],["さばかない"],["。"],["さばき"],["の"],["こと"],["は"],["すべて"],["、"],["子","こ"],["に"],["ゆだねられた"],["から"],["で"],["ある"],["。"]]},{"verse":23,"text":"それは、すべての人,ひとが父,ちちを敬,うやまうと同様,どうように、子,こを敬,うやまうためである。子,こを敬,うやまわない者,ものは、子,こをつかわされた父,ちちをも敬,うやまわない。","tok":[["それ"],["は"],["、"],["すべて"],["の"],["人","ひと"],["が"],["父","ちち"],["を"],["敬う","うやまう"],["と"],["同様","どうよう"],["に"],["、"],["子","こ"],["を"],["敬う","うやまう"],["ため"],["で"],["ある"],["。"],["子","こ"],["を"],["敬わない","うやまわない"],["者","もの"],["は"],["、"],["子","こ"],["を"],["つかわされた"],["父","ちち"],["を"],["も"],["敬わない","うやまわない"],["。"]]},{"verse":24,"text":"よくよくあなたがたに言,いっておく。わたしの言葉,ことばを聞,きいて、わたしをつかわされたかたを信,しんじる者,ものは、永遠,えいえんの命,いのちを受,うけ、またさばかれることがなく、死,しから命,いのちに移,うつっているのである。","tok":[["よくよく"],["あなた"],["がた"],["に"],["言って","いって"],["おく"],["。"],["わたし"],["の"],["言葉","ことば"],["を"],["聞いて","きいて"],["、"],["わたし"],["を"],["つかわされた"],["かた"],["を"],["信じる","しんじる"],["者","もの"],["は"],["、"],["永遠","えいえん"],["の"],["命","いのち"],["を"],["受け","うけ"],["、"],["また"],["さばかれる"],["こと"],["が"],["なく"],["、"],["死","し"],["から"],["命","いのち"],["に"],["移って","うつって"],["いる"],["ので"],["ある"],["。"]]},{"verse":25,"text":"よくよくあなたがたに言,いっておく。死,しんだ人,ひとたちが、神,かみの子,この声,こえを聞,きく時,ときが来,くる。今,いますでにきている。そして聞,きく人,ひとは生,いきるであろう。","tok":[["よくよく"],["あなた"],["がた"],["に"],["言って","いって"],["おく"],["。"],["死んだ","しんだ"],["人","ひと"],["たち"],["が"],["、"],["神","かみ"],["の"],["子","こ"],["の"],["声","こえ"],["を"],["聞く","きく"],["時","とき"],["が"],["来る","くる"],["。"],["今","いま"],["すでに"],["きて"],["いる"],["。"],["そして"],["聞く","きく"],["人","ひと"],["は"],["生きるで","いきるで"],["あろう"],["。"]]},{"verse":26,"text":"それは、父,ちちがご自分,じぶんのうちに生命,せいめいをお持,もちになっていると同様,どうように、子,こにもまた、自分,じぶんのうちに生命,せいめいを持,もつことをお許,ゆるしになったからである。","tok":[["それ"],["は"],["、"],["父","ちち"],["が"],["ご自分","ごじぶん"],["の"],["うち"],["に"],["生命","せいめい"],["を"],["お持","おもち"],["に"],["なって"],["いる"],["と"],["同様","どうよう"],["に"],["、"],["子","こ"],["に"],["も"],["また"],["、"],["自分","じぶん"],["の"],["うち"],["に"],["生命","せいめい"],["を"],["持つ","もつ"],["こと"],["を"],["お許し","おゆるし"],["に"],["なった"],["から"],["で"],["ある"],["。"]]},{"verse":27,"text":"そして子,こは人,ひとの子,こであるから、子,こにさばきを行,おこなう権威,けんいをお与,あたえになった。","tok":[["そして"],["子","こ"],["は"],["人","ひと"],["の"],["子","こ"],["で"],["ある"],["から"],["、"],["子","こ"],["に"],["さばき"],["を"],["行なう","おこなう"],["権威","けんい"],["を"],["お"],["与","あたえ"],["に"],["なった"],["。"]]},{"verse":28,"text":"このことを驚,おどろくには及,およばない。墓,はかの中,なかにいる者,ものたちがみな神,かみの子,この声,こえを聞,きき、","tok":[["この"],["こと"],["を"],["驚ろく","おどろく"],["に"],["は"],["及ばない","およばない"],["。"],["墓","はか"],["の"],["中","なか"],["に"],["いる"],["者","もの"],["たち"],["が"],["みな"],["神","かみ"],["の"],["子","こ"],["の"],["声","こえ"],["を"],["聞","きき"],["、"]]},{"verse":29,"text":"善,ぜんをおこなった人々,ひとびとは、生命,せいめいを受,うけるためによみがえり、悪,あくをおこなった人々,ひとびとは、さばきを受,うけるためによみがえって、それぞれ出,でてくる時,ときが来,くるであろう。","tok":[["善","ぜん"],["を"],["おこなった"],["人々","ひとびと"],["は"],["、"],["生命","せいめい"],["を"],["受る","うける"],["ため"],["に"],["よみがえり"],["、"],["悪","あく"],["を"],["おこなった"],["人々","ひとびと"],["は"],["、"],["さばき"],["を"],["受る","うける"],["ため"],["に"],["よみがえって"],["、"],["それぞれ"],["出て","でて"],["くる"],["時","とき"],["が"],["来るで","くるで"],["あろう"],["。"]]},{"verse":30,"text":"わたしは、自分,じぶんからは何事,なにごともすることができない。ただ聞,きくままにさばくのである。そして、わたしのこのさばきは正,ただしい。それは、わたし自身,じしんの考,かんがえでするのではなく、わたしをつかわされたかたの、み旨,むねを求,もとめているからである。","tok":[["わたし"],["は"],["、"],["自分","じぶん"],["から"],["は"],["何事","なにごと"],["も"],["する"],["こと"],["が"],["できない"],["。"],["ただ"],["聞く","きく"],["まま"],["に"],["さばく"],["ので"],["ある"],["。"],["そして"],["、"],["わたし"],["の"],["この"],["さばき"],["は"],["正い","ただしい"],["。"],["それ"],["は"],["、"],["わたし"],["自身","じしん"],["の"],["考","かんがえ"],["で"],["する"],["ので"],["は"],["なく"],["、"],["わたし"],["を"],["つかわされた"],["かた"],["の"],["、"],["み旨","みむね"],["を"],["求めて","もとめて"],["いる"],["から"],["で"],["ある"],["。"]]},{"verse":31,"text":"もし、わたしが自分,じぶん自身,じしんについてあかしをするならば、わたしのあかしはほんとうではない。","tok":[["もし"],["、"],["わたし"],["が"],["自分","じぶん"],["自身","じしん"],["について"],["あかし"],["を"],["するならば"],["、"],["わたし"],["の"],["あかし"],["は"],["ほんとう"],["で"],["は"],["ない"],["。"]]},{"verse":32,"text":"わたしについてあかしをするかたはほかにあり、そして、その人,ひとがするあかしがほんとうであることを、わたしは知,しっている。","tok":[["わたし"],["について"],["あかし"],["を"],["する"],["かたは"],["ほか"],["に"],["あり"],["、"],["そして"],["、"],["その"],["人","ひと"],["が"],["する"],["あかし"],["が"],["ほんとう"],["で"],["ある"],["こと"],["を"],["、"],["わたし"],["は"],["知って","しって"],["いる"],["。"]]},{"verse":33,"text":"あなたがたはヨハネのもとへ人,ひとをつかわしたが、そのとき彼,かれは真理,しんりについてあかしをした。","tok":[["あなた"],["がた"],["は"],["ヨハネ"],["の"],["もと"],["へ"],["人","ひと"],["を"],["つかわした"],["が"],["、"],["その"],["とき"],["彼","かれ"],["は"],["真理","しんり"],["について"],["あかし"],["を"],["した"],["。"]]},{"verse":34,"text":"わたしは人,ひとからあかしを受,うけないが、このことを言,いうのは、あなたがたが救,すくわれるためである。","tok":[["わたし"],["は"],["人","ひと"],["から"],["あかし"],["を"],["受ない","うけない"],["が"],["、"],["この"],["こと"],["を"],["言う","いう"],["の"],["は"],["、"],["あなた"],["がた"],["が"],["救われる","すくわれる"],["ため"],["で"],["ある"],["。"]]},{"verse":35,"text":"ヨハネは燃,もえて輝,かがやくあかりであった。あなたがたは、しばらくの間,あいだその光,ひかりを喜,よろこび楽,たのしもうとした。","tok":[["ヨハネ"],["は"],["燃えて","もえて"],["輝やく","かがやく"],["あかり"],["で"],["あった"],["。"],["あなた"],["がた"],["は"],["、"],["しばらく"],["の"],["間","あいだ"],["その"],["光","ひかり"],["を"],["喜こび","よろこび"],["楽しもう","たのしもう"],["と"],["した"],["。"]]},{"verse":36,"text":"しかし、わたしには、ヨハネのあかしよりも、もっと力,ちからあるあかしがある。父,ちちがわたしに成就,じょうじゅさせようとしてお与,あたえになったわざ、すなわち、今,いまわたしがしているこのわざが、父,ちちのわたしをつかわされたことをあかししている。","tok":[["しかし"],["、"],["わたし"],["に"],["は"],["、"],["ヨハネ"],["の"],["あかし"],["より"],["も"],["、"],["もっと"],["力","ちから"],["ある"],["あかし"],["が"],["ある"],["。"],["父","ちち"],["が"],["わたし"],["に"],["成就","じょうじゅ"],["させよう"],["として"],["お"],["与","あたえ"],["に"],["なった"],["わざ"],["、"],["すなわち"],["、"],["今","いま"],["わたし"],["が"],["して"],["いる"],["この"],["わざ"],["が"],["、"],["父","ちち"],["の"],["わたし"],["を"],["つかわされた"],["こと"],["を"],["あかし"],["して"],["いる"],["。"]]},{"verse":37,"text":"また、わたしをつかわされた父,ちちも、ご自分,じぶんでわたしについてあかしをされた。あなたがたは、まだそのみ声,こえを聞,きいたこともなく、そのみ姿,すがたを見,みたこともない。","tok":[["また"],["、"],["わたし"],["を"],["つかわされた"],["父","ちち"],["も"],["、"],["ご自分","ごじぶん"],["で"],["わたし"],["について"],["あかし"],["を"],["された"],["。"],["あなた"],["がた"],["は"],["、"],["まだ"],["その"],["み声","みこえ"],["を"],["聞いた","きいた"],["こと"],["も"],["なく"],["、"],["その"],["み姿","みすがた"],["を"],["見た","みた"],["こと"],["も"],["ない"],["。"]]},{"verse":38,"text":"また、神,かみがつかわされた者,ものを信,しんじないから、神,かみの御言,みことばはあなたがたのうちにとどまっていない。","tok":[["また"],["、"],["神","かみ"],["が"],["つかわされた"],["者","もの"],["を"],["信じない","しんじない"],["から"],["、"],["神","かみ"],["の"],["御言","みこと"],["ば"],["は"],["あなた"],["がた"],["の"],["うち"],["に"],["とどまって"],["いない"],["。"]]},{"verse":39,"text":"あなたがたは、聖書,せいしょの中,なかに永遠,えいえんの命,いのちがあると思,おもって調,しらべているが、この聖書,せいしょは、わたしについてあかしをするものである。","tok":[["あなた"],["がた"],["は"],["、"],["聖書","せいしょ"],["の"],["中","なか"],["に"],["永遠","えいえん"],["の"],["命","いのち"],["が"],["ある"],["と"],["思って","おもって"],["調べて","しらべて"],["いる"],["が"],["、"],["この"],["聖書","せいしょ"],["は"],["、"],["わたし"],["について"],["あかし"],["を"],["する"],["もの"],["で"],["ある"],["。"]]},{"verse":40,"text":"しかも、あなたがたは、命,いのちを得,えるためにわたしのもとにこようともしない。","tok":[["しかも"],["、"],["あなた"],["がた"],["は"],["、"],["命","いのち"],["を"],["得る","える"],["ため"],["に"],["わたし"],["の"],["もと"],["に"],["こよう"],["と"],["も"],["しない"],["。"]]},{"verse":41,"text":"わたしは人,ひとからの誉,ほまれを受,うけることはしない。","tok":[["わたし"],["は"],["人","ひと"],["から"],["の"],["誉","ほまれ"],["を"],["受る","うける"],["こと"],["は"],["しない"],["。"]]},{"verse":42,"text":"しかし、あなたがたのうちには神,かみを愛,あいする愛,あいがないことを知,しっている。","tok":[["しかし"],["、"],["あなた"],["がた"],["の"],["うち"],["に"],["は"],["神","かみ"],["を"],["愛する","あいする"],["愛","あい"],["が"],["ない"],["こと"],["を"],["知って","しって"],["いる"],["。"]]},{"verse":43,"text":"わたしは父,ちちの名,なによってきたのに、あなたがたはわたしを受,うけいれない。もし、ほかの人,ひとが彼,かれ自身,じしんの名,なによって来,くるならば、その人,ひとを受,うけいれるのであろう。","tok":[["わたし"],["は"],["父","ちち"],["の"],["名","な"],["によって"],["きた"],["のに"],["、"],["あなた"],["がた"],["は"],["わたし"],["を"],["受","うけ"],["いれない"],["。"],["もし"],["、"],["ほか"],["の"],["人","ひと"],["が"],["彼","かれ"],["自身","じしん"],["の"],["名","な"],["によって"],["来るならば","くるならば"],["、"],["その"],["人","ひと"],["を"],["受","うけ"],["いれる"],["ので"],["あろう"],["。"]]},{"verse":44,"text":"互,たがいに誉,ほまれを受,うけながら、ただひとりの神,かみからの誉,ほまれを求,もとめようとしないあなたがたは、どうして信,しんじることができようか。","tok":[["互","たがい"],["に"],["誉","ほまれ"],["を"],["受","うけ"],["ながら"],["、"],["ただ"],["ひとり"],["の"],["神","かみ"],["から"],["の"],["誉","ほまれ"],["を"],["求めよう","もとめよう"],["と"],["しない"],["あなた"],["がた"],["は"],["、"],["どう"],["して"],["信じる","しんじる"],["こと"],["が"],["できよう"],["か"],["。"]]},{"verse":45,"text":"わたしがあなたがたのことを父,ちちに訴,うったえると、考,かんがえてはいけない。あなたがたを訴,うったえる者,ものは、あなたがたが頼,たのみとしているモーセその人,ひとである。","tok":[["わたし"],["が"],["あなた"],["がた"],["の"],["こと"],["を"],["父","ちち"],["に"],["訴る","うったえる"],["と"],["、"],["考","かんがえ"],["ては"],["いけない"],["。"],["あなた"],["がた"],["を"],["訴る","うったえる"],["者","もの"],["は"],["、"],["あなた"],["がた"],["が"],["頼み","たのみ"],["として"],["いる"],["モーセ"],["その"],["人","ひと"],["で"],["ある"],["。"]]},{"verse":46,"text":"もし、あなたがたがモーセを信,しんじたならば、わたしをも信,しんじたであろう。モーセは、わたしについて書,かいたのである。","tok":[["もし"],["、"],["あなた"],["がた"],["が"],["モーセ"],["を"],["信じたならば","しんじたならば"],["、"],["わたし"],["を"],["も"],["信じたで","しんじたで"],["あろう"],["。"],["モーセ"],["は"],["、"],["わたし"],["について"],["書いた","かいた"],["ので"],["ある"],["。"]]},{"verse":47,"text":"しかし、モーセの書,かいたものを信,しんじないならば、どうしてわたしの言葉,ことばを信,しんじるだろうか」。","tok":[["しかし"],["、"],["モーセ"],["の"],["書いた","かいた"],["もの"],["を"],["信じないならば","しんじないならば"],["、"],["どう"],["して"],["わたし"],["の"],["言葉","ことば"],["を"],["信じるだろう","しんじるだろう"],["か"],["」"],["。"]]}]
[{"verse":1,"text":"そののち、イエスはテベリヤの海,うみべで、ご自身,じしんをまた弟子,でしたちにあらわされた。そのあらわされた次第,しだいは、こうである。","tok":[["その"],["のち"],["、"],["イエス"],["は"],["テベリヤ"],["の"],["海べ","うみべ"],["で"],["、"],["ご自身","ごじしん"],["を"],["また"],["弟子","でし"],["たち"],["に"],["あらわされた"],["。"],["その"],["あらわされた"],["次第","しだい"],["は"],["、"],["こう"],["で"],["ある"],["。"]]},{"verse":2,"text":"シモン・ペテロが、デドモと呼,よばれているトマス、ガリラヤのカナのナタナエル、ゼベダイの子,こらや、ほかのふたりの弟子,でしたちと一緒,いっしょにいた時,ときのことである。","tok":[["シモン"],["・"],["ペテロ"],["が"],["、"],["デドモ"],["と"],["呼ばれて","よばれて"],["いる"],["トマス"],["、"],["ガリラヤ"],["の"],["カナ"],["の"],["ナタナエル"],["、"],["ゼベダイ"],["の"],["子","こ"],["ら"],["や"],["、"],["ほか"],["の"],["ふたり"],["の"],["弟子","でし"],["たち"],["と"],["一緒","いっしょ"],["に"],["いた"],["時","とき"],["の"],["こと"],["で"],["ある"],["。"]]},{"verse":3,"text":"シモン・ペテロは彼,かれらに「わたしは漁,りょうに行,いくのだ」と言,いうと、彼,かれらは「わたしたちも一緒,いっしょに行,いこう」と言,いった。彼,かれらは出,でて行,いって舟,ふねに乗,のった。しかし、その夜,よはなんの獲物,えものもなかった。","tok":[["シモン"],["・"],["ペテロ"],["は"],["彼","かれ"],["ら"],["に"],["「"],["わたし"],["は"],["漁","りょう"],["に"],["行く","いく"],["の"],["だ"],["」"],["と"],["言","いう"],["と"],["、"],["彼","かれ"],["ら"],["は"],["「"],["わたしたち"],["も"],["一緒","いっしょ"],["に"],["行こう","いこう"],["」"],["と"],["言った","いった"],["。"],["彼","かれ"],["ら"],["は"],["出て","でて"],["行って","いって"],["舟","ふね"],["に"],["乗った","のった"],["。"],["しかし"],["、"],["その"],["夜","よ"],["は"],["なん"],["の"],["獲物","えもの"],["も"],["なかった"],["。"]]},{"verse":4,"text":"夜,よが明,あけたころ、イエスが岸,きしに立,たっておられた。しかし弟子,でしたちはそれがイエスだとは知,しらなかった。","tok":[["夜","よ"],["が"],["明けた","あけた"],["ころ"],["、"],["イエス"],["が"],["岸","きし"],["に"],["立って","たって"],["おられた"],["。"],["しかし"],["弟子","でし"],["たち"],["は"],["それ"],["が"],["イエス"],["だ"],["と"],["は"],["知らなかった","しらなかった"],["。"]]},{"verse":5,"text":"イエスは彼,かれらに言,いわれた、「子,こたちよ、何,なにか食,たべるものがあるか」。彼,かれらは「ありません」と答,こたえた。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["子","こ"],["たち"],["よ"],["、"],["何に","なに"],["か"],["食べる","たべる"],["もの"],["が"],["ある"],["か"],["」"],["。"],["彼","かれ"],["ら"],["は"],["「"],["ありません"],["」"],["と"],["答","こたえ"],["た"],["。"]]},{"verse":6,"text":"すると、イエスは彼,かれらに言,いわれた、「舟,ふねの右,みぎの方,ほうに網,あみをおろして見,みなさい。そうすれば、何,なにかとれるだろう」。彼,かれらは網,あみをおろすと、魚,うおが多,おおくとれたので、それを引,ひき上,あげることができなかった。","tok":[["する"],["と"],["、"],["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["舟","ふね"],["の"],["右","みぎ"],["の"],["方","ほう"],["に"],["網","あみ"],["を"],["おろして"],["見","み"],["なさい"],["。"],["そう"],["すれば"],["、"],["何に","なに"],["か"],["とれるだろう"],["」"],["。"],["彼","かれ"],["ら"],["は"],["網","あみ"],["を"],["おろす"],["と"],["、"],["魚","う"],["お"],["が"],["多く","おおく"],["とれた"],["ので"],["、"],["それ"],["を"],["引上げる","ひきあげる"],["こと"],["が"],["できなかった"],["。"]]},{"verse":7,"text":"イエスの愛,あいしておられた弟子,でしが、ペテロに「あれは主,しゅだ」と言,いった。シモン・ペテロは主,しゅであると聞,きいて、裸,はだかになっていたため、上着,うわぎをまとって海,うみにとびこんだ。","tok":[["イエス"],["の"],["愛して","あいして"],["おられた"],["弟子","でし"],["が"],["、"],["ペテロ"],["に"],["「"],["あれ"],["は"],["主","しゅ"],["だ"],["」"],["と"],["言った","いった"],["。"],["シモン"],["・"],["ペテロ"],["は"],["主","しゅである"],["と"],["聞いて","きいて"],["、"],["裸","はだか"],["に"],["なって"],["いた"],["ため"],["、"],["上着","うわぎ"],["を"],["まとって"],["海","うみ"],["に"],["とびこんだ"],["。"]]},{"verse":8,"text":"しかし、ほかの弟子,でしたちは舟,ふねに乗,のったまま、魚,うおのはいっている網,あみを引,ひきながら帰,かえって行,いった。陸,りくからはあまり遠,とおくない五十間,けんほどの所,ところにいたからである。","tok":[["しかし"],["、"],["ほか"],["の"],["弟子","でし"],["たち"],["は"],["舟","ふね"],["に"],["乗った","のった"],["まま"],["、"],["魚","うお"],["の"],["はいって"],["いる"],["網","あみ"],["を"],["引","ひき"],["ながら"],["帰えって","かえって"],["行った","いった"],["。"],["陸","りく"],["から"],["は"],["あまり"],["遠く","とおく"],["ない"],["五十間","けんほど"],["の"],["所","ところ"],["に"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":9,"text":"彼,かれらが陸,りくに上,のぼって見,みると、炭火,すみびがおこしてあって、その上,うえに魚,うおがのせてあり、またそこにパンがあった。","tok":[["彼","かれ"],["ら"],["が"],["陸","りく"],["に"],["上って","のぼって"],["見る","みる"],["と"],["、"],["炭火","すみび"],["が"],["おこして"],["あって"],["、"],["その"],["上","うえ"],["に"],["魚","うお"],["が"],["のせて"],["あり"],["、"],["また"],["そこ"],["に"],["パン"],["が"],["あった"],["。"]]},{"verse":10,"text":"イエスは彼,かれらに言,いわれた、「今,いまとった魚,うおを少,すこし持,もってきなさい」。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["今","いま"],["とった"],["魚","うお"],["を"],["少し","すこし"],["持って","もって"],["き"],["なさい"],["」"],["。"]]},{"verse":11,"text":"シモン・ペテロが行,いって、網,あみを陸,りくへ引,ひき上,あげると、百五十三びきの大,おおきな魚,うおでいっぱいになっていた。そんなに多,おおかったが、網,あみはさけないでいた。","tok":[["シモン"],["・"],["ペテロ"],["が"],["行って","いって"],["、"],["網","あみ"],["を"],["陸","りく"],["へ"],["引上げる","ひきあげる"],["と"],["、"],["百五十三","ひゃくごじゅうさん"],["びき"],["の"],["大きな","おおきな"],["魚","う"],["お"],["で"],["いっぱい"],["に"],["なって"],["いた"],["。"],["そんな"],["に"],["多かった","おおかった"],["が"],["、"],["網","あみ"],["は"],["さけないで"],["いた"],["。"]]},{"verse":12,"text":"イエスは彼,かれらに言,いわれた、「さあ、朝,あさの食事,しょくじをしなさい」。弟子,でしたちは、主,しゅであることがわかっていたので、だれも「あなたはどなたですか」と進,すすんで尋,たずねる者,ものがなかった。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["さあ"],["、"],["朝","あさ"],["の"],["食事","しょくじ"],["を"],["し"],["なさい"],["」"],["。"],["弟子","でし"],["たち"],["は"],["、"],["主","しゅ"],["で"],["ある"],["こと"],["が"],["わかって"],["いた"],["ので"],["、"],["だれ"],["も"],["「"],["あなた"],["は"],["どなた"],["です"],["か"],["」"],["と"],["進んで","すすんで"],["尋ねる","たずねる"],["者","もの"],["が"],["なかった"],["。"]]},{"verse":13,"text":"イエスはそこにきて、パンをとり彼,かれらに与,あたえ、また魚,うおも同,おなじようにされた。","tok":[["イエス"],["は"],["そこ"],["に"],["きて"],["、"],["パン"],["を"],["とり"],["彼","かれ"],["ら"],["に"],["与","あたえ"],["、"],["また"],["魚","うお"],["も"],["同じ","おなじ"],["よう"],["に"],["された"],["。"]]},{"verse":14,"text":"イエスが死人,しにんの中,なかからよみがえったのち、弟子,でしたちにあらわれたのは、これで既,すでに三度目,どめである。","tok":[["イエス"],["が"],["死人","しにん"],["の"],["中","なか"],["から"],["よみがえった"],["のち"],["、"],["弟子","でし"],["たち"],["に"],["あらわれた"],["の"],["は"],["、"],["これ"],["で"],["既に","すでに"],["三度目","ど"],["め"],["で"],["ある"],["。"]]},{"verse":15,"text":"彼,かれらが食事,しょくじをすませると、イエスはシモン・ペテロに言,いわれた、「ヨハネの子,こシモンよ、あなたはこの人,ひとたちが愛,あいする以上,いじょうに、わたしを愛,あいするか」。ペテロは言,いった、「主,しゅよ、そうです。わたしがあなたを愛,あいすることは、あなたがご存,ぞんじです」。イエスは彼,かれに「わたしの小羊,こひつじを養,やしないなさい」と言,いわれた。","tok":[["彼","かれ"],["ら"],["が"],["食事","しょくじ"],["を"],["すませる"],["と"],["、"],["イエス"],["は"],["シモン"],["・"],["ペテロ"],["に"],["言われた","いわれた"],["、"],["「"],["ヨハネ"],["の"],["子","こ"],["シモン"],["よ"],["、"],["あなた"],["は"],["この"],["人","ひと"],["たち"],["が"],["愛する","あいする"],["以上","いじょう"],["に"],["、"],["わたし"],["を"],["愛する","あいする"],["か"],["」"],["。"],["ペテロ"],["は"],["言った","いった"],["、"],["「"],["主","しゅ"],["よ"],["、"],["そう"],["です"],["。"],["わたし"],["が"],["あなた"],["を"],["愛する","あいする"],["こと"],["は"],["、"],["あなた"],["が"],["ご存じ","ごぞんじ"],["です"],["」"],["。"],["イエス"],["は"],["彼","かれ"],["に"],["「"],["わたし"],["の"],["小羊","こひつじ"],["を"],["養い","やしない"],["なさい"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":16,"text":"またもう一度,いちど彼,かれに言,いわれた、「ヨハネの子,こシモンよ、わたしを愛,あいするか」。彼,かれはイエスに言,いった、「主,しゅよ、そうです。わたしがあなたを愛,あいすることは、あなたがご存,ぞんじです」。イエスは彼,かれに言,いわれた、「わたしの羊,ひつじを飼,かいなさい」。","tok":[["また"],["もう"],["一度","いちど"],["彼","かれ"],["に"],["言われた","いわれた"],["、"],["「"],["ヨハネ"],["の"],["子","こ"],["シモン"],["よ"],["、"],["わたし"],["を"],["愛する","あいする"],["か"],["」"],["。"],["彼","かれ"],["は"],["イエス"],["に"],["言った","いった"],["、"],["「"],["主","しゅ"],["よ"],["、"],["そう"],["です"],["。"],["わたし"],["が"],["あなた"],["を"],["愛する","あいする"],["こと"],["は"],["、"],["あなた"],["が"],["ご存じ","ごぞんじ"],["です"],["」"],["。"],["イエス"],["は"],["彼","かれ"],["に"],["言われた","いわれた"],["、"],["「"],["わたし"],["の"],["羊","ひつじ"],["を"],["飼","かい"],["なさい"],["」"],["。"]]},{"verse":17,"text":"イエスは三度目,どめに言,いわれた、「ヨハネの子,こシモンよ、わたしを愛,あいするか」。ペテロは「わたしを愛,あいするか」とイエスが三度,ども言,いわれたので、心,こころをいためてイエスに言,いった、「主,しゅよ、あなたはすべてをご存,ぞんじです。わたしがあなたを愛,あいしていることは、おわかりになっています」。イエスは彼,かれに言,いわれた、「わたしの羊,ひつじを養,やしないなさい。","tok":[["イエス"],["は"],["三度目","どめ"],["に"],["言われた","いわれた"],["、"],["「"],["ヨハネ"],["の"],["子","こ"],["シモン"],["よ"],["、"],["わたし"],["を"],["愛する","あいする"],["か"],["」"],["。"],["ペテロ"],["は"],["「"],["わたし"],["を"],["愛する","あいする"],["か"],["」"],["と"],["イエス"],["が"],["三","さん"],["度","ど"],["も"],["言われた","いわれた"],["ので"],["、"],["心","こころ"],["を"],["いためて"],["イエス"],["に"],["言った","いった"],["、"],["「"],["主","しゅ"],["よ"],["、"],["あなた"],["は"],["すべて"],["を"],["ご存じ","ごぞんじ"],["です"],["。"],["わたし"],["が"],["あなた"],["を"],["愛して","あいして"],["いる"],["こと"],["は"],["、"],["おわかり"],["に"],["なって"],["います"],["」"],["。"],["イエス"],["は"],["彼","かれ"],["に"],["言われた","いわれた"],["、"],["「"],["わたし"],["の"],["羊","ひつじ"],["を"],["養い","やしない"],["なさい"],["。"]]},{"verse":18,"text":"よくよくあなたに言,いっておく。あなたが若,わかかった時,ときには、自分,じぶんで帯,おびをしめて、思,おもいのままに歩,あるきまわっていた。しかし年,としをとってからは、自分,じぶんの手,てをのばすことになろう。そして、ほかの人,ひとがあなたに帯,おびを結,むすびつけ、行,いきたくない所,ところへ連,つれて行,いくであろう」。","tok":[["よくよく"],["あなた"],["に"],["言って","いって"],["おく"],["。"],["あなた"],["が"],["若かった","わかかった"],["時","とき"],["に"],["は"],["、"],["自分","じぶん"],["で"],["帯","おび"],["を"],["しめて"],["、"],["思い","おもい"],["の"],["まま"],["に"],["歩き","あるき"],["まわって"],["いた"],["。"],["しかし"],["年","とし"],["を"],["とって"],["から"],["は"],["、"],["自分","じぶん"],["の"],["手","て"],["を"],["のばす"],["こと"],["に"],["なろう"],["。"],["そして"],["、"],["ほか"],["の"],["人","ひと"],["が"],["あなた"],["に"],["帯","おび"],["を"],["結びつけ","むすびつけ"],["、"],["行きたく","いきたく"],["ない"],["所","ところ"],["へ"],["連れて","つれて"],["行くで","いくで"],["あろう"],["」"],["。"]]},{"verse":19,"text":"これは、ペテロがどんな死,しに方,かたで、神,かみの栄光,えいこうをあらわすかを示,しめすために、お話,はなしになったのである。こう話,はなしてから、「わたしに従,したがってきなさい」と言,いわれた。","tok":[["これ"],["は"],["、"],["ペテロ"],["が"],["どんな"],["死に","しに"],["方","かた"],["で"],["、"],["神","かみ"],["の"],["栄光","えいこう"],["を"],["あらわす"],["か"],["を"],["示めす","しめす"],["ため"],["に"],["、"],["お話","おはなし"],["に"],["なった"],["ので"],["ある"],["。"],["こう"],["話","はなし"],["て"],["から"],["、"],["「"],["わたし"],["に"],["従って","したがって"],["き"],["なさい"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":20,"text":"ペテロはふり返,かえると、イエスの愛,あいしておられた弟子,でしがついて来,くるのを見,みた。この弟子,でしは、あの夕食,ゆうしょくのときイエスの胸,むね近,ちかくに寄,よりかかって、「主,しゅよ、あなたを裏切,うらぎる者,ものは、だれなのですか」と尋,たずねた人,ひとである。","tok":[["ペテロ"],["は"],["ふり返る","ふりかえる"],["と"],["、"],["イエス"],["の"],["愛して","あいして"],["おられた"],["弟子","でし"],["が"],["ついて"],["来る","くる"],["の"],["を"],["見た","みた"],["。"],["この"],["弟子","でし"],["は"],["、"],["あの"],["夕食","ゆうしょく"],["の"],["とき"],["イエス"],["の"],["胸","むね"],["近く","ちかく"],["に"],["寄りかかって","よりかかって"],["、"],["「"],["主","しゅ"],["よ"],["、"],["あなた"],["を"],["裏切る","うらぎる"],["者","もの"],["は"],["、"],["だれ"],["な"],["の"],["です"],["か"],["」"],["と"],["尋ねた","たずねた"],["人","ひと"],["で"],["ある"],["。"]]},{"verse":21,"text":"ペテロはこの弟子,でしを見,みて、イエスに言,いった、「主,しゅよ、この人,ひとはどうなのですか」。","tok":[["ペテロ"],["は"],["この"],["弟子","でし"],["を"],["見て","みて"],["、"],["イエス"],["に"],["言った","いった"],["、"],["「"],["主","しゅ"],["よ"],["、"],["この"],["人","ひと"],["は"],["どう"],["な"],["の"],["です"],["か"],["」"],["。"]]},{"verse":22,"text":"イエスは彼,かれに言,いわれた、「たとい、わたしの来,くる時,ときまで彼,かれが生,いき残,のこっていることを、わたしが望,のぞんだとしても、あなたにはなんの係,かかわりがあるか。あなたは、わたしに従,したがってきなさい」。","tok":[["イエス"],["は"],["彼","かれ"],["に"],["言われた","いわれた"],["、"],["「"],["たとい"],["、"],["わたし"],["の"],["来る","くる"],["時","とき"],["まで"],["彼","かれ"],["が"],["生き残って","いきのこって"],["いる"],["こと"],["を"],["、"],["わたし"],["が"],["望","のぞんだ"],["として"],["も"],["、"],["あなた"],["に"],["は"],["なん"],["の"],["係わり","かかわり"],["が"],["ある"],["か"],["。"],["あなた"],["は"],["、"],["わたし"],["に"],["従って","したがって"],["き"],["なさい"],["」"],["。"]]},{"verse":23,"text":"こういうわけで、この弟子,でしは死,しぬことがないといううわさが、兄弟,きょうだいたちの間,あいだにひろまった。しかし、イエスは彼,かれが死,しぬことはないと言,いわれたのではなく、ただ「たとい、わたしの来,くる時,ときまで彼,かれが生,いき残,のこっていることを、わたしが望,のぞんだとしても、あなたにはなんの係,かかわりがあるか」と言,いわれただけである。","tok":[["こう"],["いう"],["わけ"],["で"],["、"],["この"],["弟子","でし"],["は"],["死ぬ","しぬ"],["こと"],["が"],["ない"],["と"],["いう"],["うわさ"],["が"],["、"],["兄弟","きょうだい"],["たち"],["の"],["間","あいだ"],["に"],["ひろまった"],["。"],["しかし"],["、"],["イエス"],["は"],["彼","かれ"],["が"],["死ぬ","しぬ"],["こと"],["は"],["ない"],["と"],["言われた","いわれた"],["ので"],["は"],["なく"],["、"],["ただ"],["「"],["たとい"],["、"],["わたし"],["の"],["来る","くる"],["時","とき"],["まで"],["彼","かれ"],["が"],["生き残って","いきのこって"],["いる"],["こと"],["を"],["、"],["わたし"],["が"],["望","のぞんだ"],["として"],["も"],["、"],["あなた"],["に"],["は"],["なん"],["の"],["係わり","かかわり"],["が"],["ある"],["か"],["」"],["と"],["言われた","いわれた"],["だけ"],["で"],["ある"],["。"]]},{"verse":24,"text":"これらの事,ことについてあかしをし、またこれらの事,ことを書,かいたのは、この弟子,でしである。そして彼,かれのあかしが真実,しんじつであることを、わたしたちは知,しっている。","tok":[["これ"],["ら"],["の"],["事","こと"],["について"],["あかし"],["を"],["し"],["、"],["また"],["これ"],["ら"],["の"],["事","こと"],["を"],["書いた","かいた"],["の"],["は"],["、"],["この"],["弟子","でし"],["で"],["ある"],["。"],["そして"],["彼","かれ"],["の"],["あかし"],["が"],["真実","しんじつ"],["で"],["ある"],["こと"],["を"],["、"],["わたしたち"],["は"],["知って","しって"],["いる"],["。"]]},{"verse":25,"text":"イエスのなさったことは、このほかにまだ数多,かずおおくある。もしいちいち書,かきつけるならば、世界,せかいもその書,かかれた文書,ぶんしょを収,おさめきれないであろうと思,おもう。","tok":[["イエス"],["の"],["なさった"],["こと"],["は"],["、"],["この"],["ほか"],["に"],["まだ"],["数多く","かずおおく"],["ある"],["。"],["もし"],["いちいち"],["書きつけるならば","かきつけるならば"],["、"],["世界","せかい"],["も"],["その"],["書かれた","かかれた"],["文書","ぶんしょ"],["を"],["収め","おさめ"],["きれないで"],["あろう"],["と"],["思う","おもう"],["。"]]}]
[{"verse":1,"text":"これらのことを語,かたり終,おえると、イエスは天,てんを見,みあげて言,いわれた、「父,ちちよ、時,ときがきました。あなたの子,こがあなたの栄光,えいこうをあらわすように、子,この栄光,えいこうをあらわして下,ください。","tok":[["これ"],["ら"],["の"],["こと"],["を"],["語り","かたり"],["終える","おえる"],["と"],["、"],["イエス"],["は"],["天","てん"],["を"],["見あげて","みあげて"],["言われた","いわれた"],["、"],["「"],["父","ちち"],["よ"],["、"],["時","とき"],["が"],["きました"],["。"],["あなた"],["の"],["子","こ"],["が"],["あなた"],["の"],["栄光","えいこう"],["を"],["あらわす"],["よう"],["に"],["、"],["子","こ"],["の"],["栄光","えいこう"],["を"],["あらわして"],["下さい","ください"],["。"]]},{"verse":2,"text":"あなたは、子,こに賜,たまわったすべての者,ものに、永遠,えいえんの命,いのちを授,さづけさせるため、万民,ばんみんを支配,しはいする権威,けんいを子,こにお与,あたえになったのですから。","tok":[["あなた"],["は"],["、"],["子","こ"],["に"],["賜わった","たまわった"],["すべて"],["の"],["者","もの"],["に"],["、"],["永遠","えいえん"],["の"],["命","いのち"],["を"],["授","さ"],["づけ"],["させる"],["ため"],["、"],["万民","ばんみん"],["を"],["支配","しはい"],["する"],["権威","けんい"],["を"],["子","こ"],["に"],["お"],["与","あたえ"],["に"],["なった"],["の"],["です"],["から"],["。"]]},{"verse":3,"text":"永遠,えいえんの命,いのちとは、唯一,ゆいいつの、まことの神,かみでいますあなたと、また、あなたがつかわされたイエス・キリストとを知,しることであります。","tok":[["永遠","えいえん"],["の"],["命","いのち"],["と"],["は"],["、"],["唯一","ゆいいつ"],["の"],["、"],["まこと"],["の"],["神","かみ"],["で"],["います"],["あなた"],["と"],["、"],["また"],["、"],["あなた"],["が"],["つかわされた"],["イエス"],["・"],["キリスト"],["と"],["を"],["知る","しる"],["こと"],["で"],["あります"],["。"]]},{"verse":4,"text":"わたしは、わたしにさせるためにお授,さづけになったわざをなし遂,とげて、地上,ちじょうであなたの栄光,えいこうをあらわしました。","tok":[["わたし"],["は"],["、"],["わたし"],["に"],["させる"],["ため"],["に"],["お授","おさづけ"],["に"],["なった"],["わざ"],["を"],["なし遂げて","なしとげて"],["、"],["地上","ちじょう"],["で"],["あなた"],["の"],["栄光","えいこう"],["を"],["あらわしました"],["。"]]},{"verse":5,"text":"父,ちちよ、世,よが造,つくられる前,まえに、わたしがみそばで持,もっていた栄光,えいこうで、今,いまみ前,まえにわたしを輝,かがやかせて下,ください。","tok":[["父","ちち"],["よ"],["、"],["世","よ"],["が"],["造られる","つくられる"],["前","まえ"],["に"],["、"],["わたし"],["が"],["みそば"],["で"],["持って","もって"],["いた"],["栄光","えいこう"],["で"],["、"],["今","いま"],["み前","みまえ"],["に"],["わたし"],["を"],["輝やかせて","かがやかせて"],["下さい","ください"],["。"]]},{"verse":6,"text":"わたしは、あなたが世,よから選,えらんでわたしに賜,たまわった人々,ひとびとに、み名,なをあらわしました。彼,かれらはあなたのものでありましたが、わたしに下,くださいました。そして、彼,かれらはあなたの言葉,ことばを守,まもりました。","tok":[["わたし"],["は"],["、"],["あなた"],["が"],["世","よ"],["から"],["選らんで","えらんで"],["わたし"],["に"],["賜わった","たまわった"],["人々","ひとびと"],["に"],["、"],["み名","みな"],["を"],["あらわしました"],["。"],["彼","かれ"],["ら"],["は"],["あなた"],["の"],["もの"],["で"],["ありました"],["が"],["、"],["わたし"],["に"],["下さいました","くださいました"],["。"],["そして"],["、"],["彼","かれ"],["ら"],["は"],["あなた"],["の"],["言葉","ことば"],["を"],["守りました","まもりました"],["。"]]},{"verse":7,"text":"いま彼,かれらは、わたしに賜,たまわったものはすべて、あなたから出,でたものであることを知,しりました。","tok":[["いま"],["彼","かれ"],["ら"],["は"],["、"],["わたし"],["に"],["賜わった","たまわった"],["もの"],["は"],["すべて"],["、"],["あなた"],["から"],["出た","でた"],["もの"],["で"],["ある"],["こと"],["を"],["知りました","しりました"],["。"]]},{"verse":8,"text":"なぜなら、わたしはあなたからいただいた言葉,ことばを彼,かれらに与,あたえ、そして彼,かれらはそれを受,うけ、わたしがあなたから出,でたものであることをほんとうに知,しり、また、あなたがわたしをつかわされたことを信,しんじるに至,いたったからです。","tok":[["なぜ"],["なら"],["、"],["わたし"],["は"],["あなた"],["から"],["いただいた"],["言葉","ことば"],["を"],["彼","かれ"],["ら"],["に"],["与","あたえ"],["、"],["そして"],["彼","かれ"],["ら"],["は"],["それ"],["を"],["受け","うけ"],["、"],["わたし"],["が"],["あなた"],["から"],["出た","でた"],["もの"],["で"],["ある"],["こと"],["を"],["ほんとう"],["に"],["知り","しり"],["、"],["また"],["、"],["あなた"],["が"],["わたし"],["を"],["つかわされた"],["こと"],["を"],["信じる","しんじる"],["に"],["至った","いたった"],["から"],["です"],["。"]]},{"verse":9,"text":"わたしは彼,かれらのためにお願,ねがいします。わたしがお願,ねがいするのは、この世,よのためにではなく、あなたがわたしに賜,たまわった者,ものたちのためです。彼,かれらはあなたのものなのです。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["お願い","おねがい"],["します"],["。"],["わたし"],["が"],["お願い","おねがい"],["する"],["の"],["は"],["、"],["この世","このよ"],["の"],["ため"],["に"],["で"],["は"],["なく"],["、"],["あなた"],["が"],["わたし"],["に"],["賜わった","たまわった"],["者","もの"],["たち"],["の"],["ため"],["です"],["。"],["彼","かれ"],["ら"],["は"],["あなた"],["の"],["もの"],["な"],["の"],["です"],["。"]]},{"verse":10,"text":"わたしのものは皆,みなあなたのもの、あなたのものはわたしのものです。そして、わたしは彼,かれらによって栄光,えいこうを受,うけました。","tok":[["わたし"],["の"],["もの"],["は"],["皆","みな"],["あなた"],["の"],["もの"],["、"],["あなた"],["の"],["もの"],["は"],["わたし"],["の"],["もの"],["です"],["。"],["そして"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["によって"],["栄光","えいこう"],["を"],["受ました","うけました"],["。"]]},{"verse":11,"text":"わたしはもうこの世,よにはいなくなりますが、彼,かれらはこの世,よに残,のこっており、わたしはみもとに参,まいります。聖,せいなる父,ちちよ、わたしに賜,たまわった御名,みなによって彼,かれらを守,まもって下,ください。それはわたしたちが一つであるように、彼,かれらも一つになるためであります。","tok":[["わたし"],["は"],["もう"],["この世","このよ"],["に"],["は"],["いなく"],["なります"],["が"],["、"],["彼","かれ"],["ら"],["は"],["この世","このよ"],["に"],["残って","のこって"],["おり"],["、"],["わたし"],["は"],["みもと"],["に"],["参ります","まいります"],["。"],["聖","せい"],["なる"],["父","ちち"],["よ"],["、"],["わたし"],["に"],["賜わった","たまわった"],["御名","みな"],["によって"],["彼","かれ"],["ら"],["を"],["守って","まもって"],["下さい","ください"],["。"],["それ"],["は"],["わたしたち"],["が"],["一","ひと"],["つ"],["で"],["ある"],["よう"],["に"],["、"],["彼","かれ"],["ら"],["も"],["一","ひと"],["つ"],["に"],["なる"],["ため"],["で"],["あります"],["。"]]},{"verse":12,"text":"わたしが彼,かれらと一緒,いっしょにいた間,あいだは、あなたからいただいた御名,みなによって彼,かれらを守,まもり、また保護,ほごしてまいりました。彼,かれらのうち、だれも滅,ほろびず、ただ滅,ほろびの子,こだけが滅,ほろびました。それは聖書,せいしょが成就,じょうじゅするためでした。","tok":[["わたし"],["が"],["彼","かれ"],["ら"],["と"],["一緒","いっしょ"],["に"],["いた"],["間","あいだ"],["は"],["、"],["あなた"],["から"],["いただいた"],["御名","みな"],["によって"],["彼","かれ"],["ら"],["を"],["守り","まもり"],["、"],["また"],["保護","ほご"],["して"],["まいりました"],["。"],["彼","かれ"],["ら"],["の"],["うち"],["、"],["だれ"],["も"],["滅びず","ほろびず"],["、"],["ただ"],["滅び","ほろび"],["の"],["子","こ"],["だけ"],["が"],["滅びました","ほろびました"],["。"],["それ"],["は"],["聖書","せいしょ"],["が"],["成就","じょうじゅ"],["する"],["ため"],["でした"],["。"]]},{"verse":13,"text":"今,いまわたしはみもとに参,まいります。そして世,よにいる間,あいだにこれらのことを語,かたるのは、わたしの喜,よろこびが彼,かれらのうちに満,みちあふれるためであります。","tok":[["今","いま"],["わたし"],["は"],["みもと"],["に"],["参ります","まいります"],["。"],["そして"],["世","よ"],["に"],["いる"],["間","あいだ"],["に"],["これ"],["ら"],["の"],["こと"],["を"],["語る","かたる"],["の"],["は"],["、"],["わたし"],["の"],["喜こび","よろこび"],["が"],["彼","かれ"],["ら"],["の"],["うち"],["に"],["満ちあふれる","みちあふれる"],["ため"],["で"],["あります"],["。"]]},{"verse":14,"text":"わたしは彼,かれらに御言,みことばを与,あたえましたが、世,よは彼,かれらを憎,にくみました。わたしが世,よのものでないように、彼,かれらも世,よのものではないからです。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["に"],["御言","みこと"],["ば"],["を"],["与","あたえ"],["ました"],["が"],["、"],["世","よ"],["は"],["彼","かれ"],["ら"],["を"],["憎みました","にくみました"],["。"],["わたし"],["が"],["世","よ"],["の"],["もの"],["で"],["ない"],["よう"],["に"],["、"],["彼","かれ"],["ら"],["も"],["世","よ"],["の"],["もの"],["で"],["は"],["ない"],["から"],["です"],["。"]]},{"verse":15,"text":"わたしがお願,ねがいするのは、彼,かれらを世,よから取,とり去,さることではなく、彼,かれらを悪,あしき者,ものから守,まもって下,くださることであります。","tok":[["わたし"],["が"],["お願い","おねがい"],["する"],["の"],["は"],["、"],["彼","かれ"],["ら"],["を"],["世","よ"],["から"],["取去る","とりさる"],["こと"],["で"],["は"],["なく"],["、"],["彼","かれ"],["ら"],["を"],["悪しき","あしき"],["者","もの"],["から"],["守って","まもって"],["下さる","くださる"],["こと"],["で"],["あります"],["。"]]},{"verse":16,"text":"わたしが世,よのものでないように、彼,かれらも世,よのものではありません。","tok":[["わたし"],["が"],["世","よ"],["の"],["もの"],["で"],["ない"],["よう"],["に"],["、"],["彼","かれ"],["ら"],["も"],["世","よ"],["の"],["もの"],["で"],["は"],["ありません"],["。"]]},{"verse":17,"text":"真理,しんりによって彼,かれらを聖,せい別,べつして下,ください。あなたの御言,みことばは真理,しんりであります。","tok":[["真理","しんり"],["によって"],["彼","かれ"],["ら"],["を"],["聖別","せいべつ"],["して"],["下さい","ください"],["。"],["あなた"],["の"],["御言","みこと"],["ば"],["は"],["真理","しんり"],["で"],["あります"],["。"]]},{"verse":18,"text":"あなたがわたしを世,よにつかわされたように、わたしも彼,かれらを世,よにつかわしました。","tok":[["あなた"],["が"],["わたし"],["を"],["世","よ"],["に"],["つかわされた"],["よう"],["に"],["、"],["わたし"],["も"],["彼","かれ"],["ら"],["を"],["世","よ"],["に"],["つかわしました"],["。"]]},{"verse":19,"text":"また彼,かれらが真理,しんりによって聖,せい別,べつされるように、彼,かれらのためわたし自身,じしんを聖,せい別,べついたします。","tok":[["また"],["彼","かれ"],["ら"],["が"],["真理","しんり"],["によって"],["聖い","せい"],["別","べつ"],["される"],["よう"],["に"],["、"],["彼","かれ"],["ら"],["の"],["ため"],["わたし"],["自身","じしん"],["を"],["聖別","せいべつ"],["いたします"],["。"]]},{"verse":20,"text":"わたしは彼,かれらのためばかりではなく、彼,かれらの言葉,ことばを聞,きいてわたしを信,しんじている人々,ひとびとのためにも、お願,ねがいいたします。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["の"],["ため"],["ばかり"],["で"],["は"],["なく"],["、"],["彼","かれ"],["ら"],["の"],["言葉","ことば"],["を"],["聞いて","きいて"],["わたし"],["を"],["信じて","しんじて"],["いる"],["人々","ひとびと"],["の"],["ため"],["に"],["も"],["、"],["お願い","おねがい"],["いたします"],["。"]]},{"verse":21,"text":"父,ちちよ、それは、あなたがわたしのうちにおられ、わたしがあなたのうちにいるように、みんなの者,ものが一つとなるためであります。すなわち、彼,かれらをもわたしたちのうちにおらせるためであり、それによって、あなたがわたしをおつかわしになったことを、世,よが信,しんじるようになるためであります。","tok":[["父","ちち"],["よ"],["、"],["それ"],["は"],["、"],["あなた"],["が"],["わたし"],["の"],["うち"],["に"],["おられ"],["、"],["わたし"],["が"],["あなた"],["の"],["うち"],["に"],["いる"],["よう"],["に"],["、"],["みんな"],["の"],["者","もの"],["が"],["一","ひと"],["つ"],["と"],["なる"],["ため"],["で"],["あります"],["。"],["すなわち"],["、"],["彼","かれ"],["ら"],["を"],["も"],["わたしたち"],["の"],["うち"],["に"],["おらせる"],["ため"],["で"],["あり"],["、"],["それ"],["によって"],["、"],["あなた"],["が"],["わたし"],["を"],["おつかわし"],["に"],["なった"],["こと"],["を"],["、"],["世","よ"],["が"],["信じる","しんじる"],["よう"],["に"],["なる"],["ため"],["で"],["あります"],["。"]]},{"verse":22,"text":"わたしは、あなたからいただいた栄光,えいこうを彼,かれらにも与,あたえました。それは、わたしたちが一つであるように、彼,かれらも一つになるためであります。","tok":[["わたし"],["は"],["、"],["あなた"],["から"],["いただいた"],["栄光","えいこう"],["を"],["彼","かれ"],["ら"],["に"],["も"],["与","あたえ"],["ました"],["。"],["それ"],["は"],["、"],["わたしたち"],["が"],["一","ひと"],["つ"],["で"],["ある"],["よう"],["に"],["、"],["彼","かれ"],["ら"],["も"],["一","ひと"],["つ"],["に"],["なる"],["ため"],["で"],["あります"],["。"]]},{"verse":23,"text":"わたしが彼,かれらにおり、あなたがわたしにいますのは、彼,かれらが完全,かんぜんに一つとなるためであり、また、あなたがわたしをつかわし、わたしを愛,あいされたように、彼,かれらをお愛,あいしになったことを、世,よが知,しるためであります。","tok":[["わたし"],["が"],["彼","かれ"],["ら"],["に"],["おり"],["、"],["あなた"],["が"],["わたし"],["に"],["います"],["の"],["は"],["、"],["彼","かれ"],["ら"],["が"],["完全","かんぜん"],["に"],["一","ひと"],["つ"],["と"],["なる"],["ため"],["で"],["あり"],["、"],["また"],["、"],["あなた"],["が"],["わたし"],["を"],["つかわし"],["、"],["わたし"],["を"],["愛された","あいされた"],["よう"],["に"],["、"],["彼","かれ"],["ら"],["を"],["お愛し","おあいし"],["に"],["なった"],["こと"],["を"],["、"],["世","よ"],["が"],["知る","しる"],["ため"],["で"],["あります"],["。"]]},{"verse":24,"text":"父,ちちよ、あなたがわたしに賜,たまわった人々,ひとびとが、わたしのいる所,ところに一緒,いっしょにいるようにして下,ください。天地,てんちが造,つくられる前,まえからわたしを愛,あいして下,くださって、わたしに賜,たまわった栄光,えいこうを、彼,かれらに見,みさせて下,ください。","tok":[["父","ちち"],["よ"],["、"],["あなた"],["が"],["わたし"],["に"],["賜わった","たまわった"],["人々","ひとびと"],["が"],["、"],["わたし"],["の"],["いる"],["所","ところ"],["に"],["一緒","いっしょ"],["に"],["いる"],["よう"],["に"],["して"],["下さい","ください"],["。"],["天地","てんち"],["が"],["造られる","つくられる"],["前","まえ"],["から"],["わたし"],["を"],["愛して","あいして"],["下さって","くださって"],["、"],["わたし"],["に"],["賜わった","たまわった"],["栄光","えいこう"],["を"],["、"],["彼","かれ"],["ら"],["に"],["見させて","みさせて"],["下さい","ください"],["。"]]},{"verse":25,"text":"正,ただしい父,ちちよ、この世,よはあなたを知,しっていません。しかし、わたしはあなたを知,しり、また彼,かれらも、あなたがわたしをおつかわしになったことを知,しっています。","tok":[["正い","ただしい"],["父","ちち"],["よ"],["、"],["この世","このよ"],["は"],["あなた"],["を"],["知って","しって"],["いません"],["。"],["しかし"],["、"],["わたし"],["は"],["あなた"],["を"],["知り","しり"],["、"],["また"],["彼","かれ"],["ら"],["も"],["、"],["あなた"],["が"],["わたし"],["を"],["おつかわし"],["に"],["なった"],["こと"],["を"],["知って","しって"],["います"],["。"]]},{"verse":26,"text":"そしてわたしは彼,かれらに御名,みなを知,しらせました。またこれからも知,しらせましょう。それは、あなたがわたしを愛,あいして下,くださったその愛,あいが彼,かれらのうちにあり、またわたしも彼,かれらのうちにおるためであります」。","tok":[["そして"],["わたし"],["は"],["彼","かれ"],["ら"],["に"],["御名","みな"],["を"],["知らせました","しらせました"],["。"],["また"],["これ"],["から"],["も"],["知らせましょう","しらせましょう"],["。"],["それ"],["は"],["、"],["あなた"],["が"],["わたし"],["を"],["愛して","あいして"],["下さった","くださった"],["その"],["愛","あい"],["が"],["彼","かれ"],["ら"],["の"],["うち"],["に"],["あり"],["、"],["また"],["わたし"],["も"],["彼","かれ"],["ら"],["の"],["うち"],["に"],["おる"],["ため"],["で"],["あります"],["」"],["。"]]}]
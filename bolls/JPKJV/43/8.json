[{"verse":1,"text":"イエスはオリブ山,やまに行,いかれた。","tok":[["イエス"],["は"],["オリブ山","おりぶやま"],["に"],["行かれた","いかれた"],["。"]]},{"verse":2,"text":"朝,あさ早,はやくまた宮,みやにはいられると、人々,ひとびとが皆,みなみもとに集,あつまってきたので、イエスはすわって彼,かれらを教,おしえておられた。","tok":[["朝","あさ"],["早く","はやく"],["また"],["宮","みや"],["に"],["は"],["いられる"],["と"],["、"],["人々","ひとびと"],["が"],["皆","みな"],["みもと"],["に"],["集まって","あつまって"],["きた"],["ので"],["、"],["イエス"],["は"],["すわって"],["彼","かれ"],["ら"],["を"],["教えて","おしえて"],["おられた"],["。"]]},{"verse":3,"text":"すると、律法,りっぽう学者,がくしゃたちやパリサイ人,びとたちが、姦淫,かんいんをしている時,ときにつかまえられた女,おんなをひっぱってきて、中,なかに立,たたせた上,うえ、イエスに言,いった、","tok":[["する"],["と"],["、"],["律法学者","りっぽうがくしゃ"],["たち"],["や"],["パリサイ"],["人","びと"],["たち"],["が"],["、"],["姦淫","かんいん"],["を"],["して"],["いる"],["時","とき"],["に"],["つかまえられた"],["女","おんな"],["を"],["ひっぱって"],["きて"],["、"],["中","なか"],["に"],["立たせた","たたせた"],["上","うえ"],["、"],["イエス"],["に"],["言った","いった"],["、"]]},{"verse":4,"text":"「先生,せんせい、この女,おんなは姦淫,かんいんの場,ばでつかまえられました。","tok":[["「"],["先生","せんせい"],["、"],["この"],["女","おんな"],["は"],["姦淫","かんいん"],["の"],["場","ば"],["で"],["つかまえられました"],["。"]]},{"verse":5,"text":"モーセは律法,りっぽうの中,なかで、こういう女,おんなを石,いしで打,うち殺,ころせと命,めいじましたが、あなたはどう思,おもいますか」。","tok":[["モーセ"],["は"],["律法","りっぽう"],["の"],["中","なか"],["で"],["、"],["こう"],["いう"],["女","おんな"],["を"],["石","いし"],["で"],["打ち","うち"],["殺ろせ","ころせ"],["と"],["命じました","めいじました"],["が"],["、"],["あなた"],["は"],["どう"],["思います","おもいます"],["か"],["」"],["。"]]},{"verse":6,"text":"彼,かれらがそう言,いったのは、イエスをためして、訴,うったえる口実,こうじつを得,えるためであった。しかし、イエスは身,みをかがめて、指,ゆびで地面,じめんに何,なにか書,かいておられた。","tok":[["彼","かれ"],["ら"],["が"],["そう"],["言った","いった"],["の"],["は"],["、"],["イエス"],["を"],["ためして"],["、"],["訴る","うったえる"],["口実","こうじつ"],["を"],["得る","える"],["ため"],["で"],["あった"],["。"],["しかし"],["、"],["イエス"],["は"],["身","み"],["を"],["かがめて"],["、"],["指","ゆび"],["で"],["地面","じめん"],["に"],["何に","なに"],["か"],["書いて","かいて"],["おられた"],["。"]]},{"verse":7,"text":"彼,かれらが問,とい続,つづけるので、イエスは身,みを起,おこして彼,かれらに言,いわれた、「あなたがたの中,なかで罪,つみのない者,ものが、まずこの女,おんなに石,いしを投,なげつけるがよい」。","tok":[["彼","かれ"],["ら"],["が"],["問","とい"],["続ける","つづける"],["ので"],["、"],["イエス"],["は"],["身","み"],["を"],["起こして","おこして"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["がた"],["の"],["中","なか"],["で"],["罪","つみ"],["の"],["ない"],["者","もの"],["が"],["、"],["まず"],["この"],["女","おんな"],["に"],["石","いし"],["を"],["投","なげ"],["つける"],["が"],["よい"],["」"],["。"]]},{"verse":8,"text":"そしてまた身,みをかがめて、地面,じめんに物,ものを書,かきつづけられた。","tok":[["そして"],["また"],["身","み"],["を"],["かがめて"],["、"],["地面","じめん"],["に"],["物","もの"],["を"],["書き","かき"],["つづけられた"],["。"]]},{"verse":9,"text":"これを聞,きくと、彼,かれらは年寄,としよりから始,はじめて、ひとりびとり出,でて行,いき、ついに、イエスだけになり、女,おんなは中,なかにいたまま残,のこされた。","tok":[["これ"],["を"],["聞く","きく"],["と"],["、"],["彼","かれ"],["ら"],["は"],["年寄","としより"],["から"],["始","はじめ"],["て"],["、"],["ひとりびとり"],["出て","でて"],["行き","いき"],["、"],["ついに"],["、"],["イエス"],["だけ"],["に"],["なり"],["、"],["女","おんな"],["は"],["中","なか"],["に"],["いた"],["まま"],["残された","のこされた"],["。"]]},{"verse":10,"text":"そこでイエスは身,みを起,おこして女,おんなに言,いわれた、「女,おんなよ、みんなはどこにいるか。あなたを罰,ばっする者,ものはなかったのか」。","tok":[["そこ"],["で"],["イエス"],["は"],["身","み"],["を"],["起こして","おこして"],["女","おんな"],["に"],["言われた","いわれた"],["、"],["「"],["女","おんな"],["よ"],["、"],["みんな"],["は"],["どこ"],["に"],["いる"],["か"],["。"],["あなた"],["を"],["罰する","ばっする"],["者","もの"],["は"],["なかった"],["の"],["か"],["」"],["。"]]},{"verse":11,"text":"女,おんなは言,いった、「主,しゅよ、だれもございません」。イエスは言,いわれた、「わたしもあなたを罰,ばっしない。お帰,かえりなさい。今後,こんごはもう罪,つみを犯,おかさないように」。〕","tok":[["女","おんな"],["は"],["言った","いった"],["、"],["「"],["主","しゅ"],["よ"],["、"],["だれ"],["も"],["ございません"],["」"],["。"],["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["わたし"],["も"],["あなた"],["を"],["罰しない","ばっしない"],["。"],["お帰えり","おかえり"],["なさい"],["。"],["今後","こんご"],["は"],["もう"],["罪","つみ"],["を"],["犯さない","おかさない"],["よう"],["に"],["」"],["。"],["〕"]]},{"verse":12,"text":"イエスは、また人々,ひとびとに語,かたってこう言,いわれた、「わたしは世,よの光,ひかりである。わたしに従,したがって来,くる者,ものは、やみのうちを歩,あるくことがなく、命,いのちの光,ひかりをもつであろう」。","tok":[["イエス"],["は"],["、"],["また"],["人々","ひとびと"],["に"],["語って","かたって"],["こう"],["言われた","いわれた"],["、"],["「"],["わたし"],["は"],["世","よ"],["の"],["光","ひかり"],["で"],["ある"],["。"],["わたし"],["に"],["従って","したがって"],["来る","くる"],["者","もの"],["は"],["、"],["やみ"],["の"],["うち"],["を"],["歩く","あるく"],["こと"],["が"],["なく"],["、"],["命","いのち"],["の"],["光","ひかり"],["を"],["もつで"],["あろう"],["」"],["。"]]},{"verse":13,"text":"するとパリサイ人,びとたちがイエスに言,いった、「あなたは、自分,じぶんのことをあかししている。あなたのあかしは真実,しんじつではない」。","tok":[["する"],["と"],["パリサイ"],["人","びと"],["たち"],["が"],["イエス"],["に"],["言った","いった"],["、"],["「"],["あなた"],["は"],["、"],["自分","じぶん"],["の"],["こと"],["を"],["あかし"],["して"],["いる"],["。"],["あなた"],["の"],["あかし"],["は"],["真実","しんじつ"],["で"],["は"],["ない"],["」"],["。"]]},{"verse":14,"text":"イエスは彼,かれらに答,こたえて言,いわれた、「たとい、わたしが自分,じぶんのことをあかししても、わたしのあかしは真実,しんじつである。それは、わたしがどこからきたのか、また、どこへ行,いくのかを知,しっているからである。しかし、あなたがたは、わたしがどこからきて、どこへ行,いくのかを知,しらない。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["に"],["答","こたえ"],["て"],["言われた","いわれた"],["、"],["「"],["たとい"],["、"],["わたし"],["が"],["自分","じぶん"],["の"],["こと"],["を"],["あかし"],["して"],["も"],["、"],["わたし"],["の"],["あかし"],["は"],["真実","しんじつ"],["で"],["ある"],["。"],["それ"],["は"],["、"],["わたし"],["が"],["どこ"],["から"],["きた"],["の"],["か"],["、"],["また"],["、"],["どこ"],["へ"],["行く","いく"],["の"],["か"],["を"],["知って","しって"],["いる"],["から"],["で"],["ある"],["。"],["しかし"],["、"],["あなた"],["がた"],["は"],["、"],["わたし"],["が"],["どこ"],["から"],["きて"],["、"],["どこ"],["へ"],["行く","いく"],["の"],["か"],["を"],["知らない","しらない"],["。"]]},{"verse":15,"text":"あなたがたは肉,にくによって人,ひとをさばくが、わたしはだれもさばかない。","tok":[["あなた"],["がた"],["は"],["肉","にく"],["によって"],["人","ひと"],["を"],["さばく"],["が"],["、"],["わたし"],["は"],["だれ"],["も"],["さばかない"],["。"]]},{"verse":16,"text":"しかし、もしわたしがさばくとすれば、わたしのさばきは正,ただしい。なぜなら、わたしはひとりではなく、わたしをつかわされたかたが、わたしと一緒,いっしょだからである。","tok":[["しかし"],["、"],["もし"],["わたし"],["が"],["さばく"],["と"],["すれば"],["、"],["わたし"],["の"],["さばき"],["は"],["正い","ただしい"],["。"],["なぜ"],["なら"],["、"],["わたし"],["は"],["ひとり"],["で"],["は"],["なく"],["、"],["わたし"],["を"],["つかわされた"],["かた"],["が"],["、"],["わたし"],["と"],["一緒","いっしょ"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":17,"text":"あなたがたの律法,りっぽうには、ふたりによる証言,しょうげんは真実,しんじつだと、書,かいてある。","tok":[["あなた"],["がた"],["の"],["律法","りっぽう"],["に"],["は"],["、"],["ふたり"],["に"],["よる"],["証言","しょうげん"],["は"],["真実","しんじつ"],["だ"],["と"],["、"],["書いて","かいて"],["ある"],["。"]]},{"verse":18,"text":"わたし自身,じしんのことをあかしするのは、わたしであるし、わたしをつかわされた父,ちちも、わたしのことをあかしして下,くださるのである」。","tok":[["わたし"],["自身","じしん"],["の"],["こと"],["を"],["あかし"],["する"],["の"],["は"],["、"],["わたし"],["で"],["ある"],["し"],["、"],["わたし"],["を"],["つかわされた"],["父","ちち"],["も"],["、"],["わたし"],["の"],["こと"],["を"],["あかし"],["して"],["下さる","くださる"],["ので"],["ある"],["」"],["。"]]},{"verse":19,"text":"すると、彼,かれらはイエスに言,いった、「あなたの父,ちちはどこにいるのか」。イエスは答,こたえられた、「あなたがたは、わたしをもわたしの父,ちちをも知,しっていない。もし、あなたがたがわたしを知,しっていたなら、わたしの父,ちちをも知,しっていたであろう」。","tok":[["する"],["と"],["、"],["彼","かれ"],["ら"],["は"],["イエス"],["に"],["言った","いった"],["、"],["「"],["あなた"],["の"],["父","ちち"],["は"],["どこ"],["に"],["いる"],["の"],["か"],["」"],["。"],["イエス"],["は"],["答","こたえ"],["られた"],["、"],["「"],["あなた"],["がた"],["は"],["、"],["わたし"],["を"],["も"],["わたし"],["の"],["父","ちち"],["を"],["も"],["知って","しって"],["いない"],["。"],["もし"],["、"],["あなた"],["がた"],["が"],["わたし"],["を"],["知って","しって"],["いたなら"],["、"],["わたし"],["の"],["父","ちち"],["を"],["も"],["知って","しって"],["いたで"],["あろう"],["」"],["。"]]},{"verse":20,"text":"イエスが宮,みやの内,うちで教,おしえていた時,とき、これらの言葉,ことばをさいせん箱,はこのそばで語,かたられたのであるが、イエスの時,ときがまだきていなかったので、だれも捕,とらえる者,ものがなかった。","tok":[["イエス"],["が"],["宮","みや"],["の"],["内","うち"],["で"],["教えて","おしえて"],["いた"],["時","とき"],["、"],["これ"],["ら"],["の"],["言葉","ことば"],["を"],["さいせん"],["箱","はこ"],["の"],["そば"],["で"],["語られた","かたられた"],["ので"],["ある"],["が"],["、"],["イエス"],["の"],["時","とき"],["が"],["まだ"],["きて"],["いなかった"],["ので"],["、"],["だれ"],["も"],["捕らえる","とらえる"],["者","もの"],["が"],["なかった"],["。"]]},{"verse":21,"text":"さて、また彼,かれらに言,いわれた、「わたしは去,さって行,いく。あなたがたはわたしを捜,さがし求,もとめるであろう。そして自分,じぶんの罪,つみのうちに死,しぬであろう。わたしの行,いく所,ところには、あなたがたは来,くることができない」。","tok":[["さて"],["、"],["また"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["わたし"],["は"],["去て","さって"],["行く","いく"],["。"],["あなた"],["がた"],["は"],["わたし"],["を"],["捜し求めるで","さがしもとめるで"],["あろう"],["。"],["そして"],["自分","じぶん"],["の"],["罪","つみ"],["の"],["うち"],["に"],["死ぬで","しぬで"],["あろう"],["。"],["わたし"],["の"],["行く","いく"],["所","ところ"],["に"],["は"],["、"],["あなた"],["がた"],["は"],["来る","くる"],["こと"],["が"],["できない"],["」"],["。"]]},{"verse":22,"text":"そこでユダヤ人,じんたちは言,いった、「わたしの行,いく所,ところに、あなたがたは来,くることができないと、言,いったのは、あるいは自殺,じさつでもしようとするつもりか」。","tok":[["そこ"],["で"],["ユダヤ人","ゆだやじん"],["たち"],["は"],["言った","いった"],["、"],["「"],["わたし"],["の"],["行く","いく"],["所","ところ"],["に"],["、"],["あなた"],["がた"],["は"],["来る","くる"],["こと"],["が"],["できない"],["と"],["、"],["言った","いった"],["の"],["は"],["、"],["あるいは"],["自殺","じさつ"],["で"],["も"],["しよう"],["と"],["する"],["つもり"],["か"],["」"],["。"]]},{"verse":23,"text":"イエスは彼,かれらに言,いわれた、「あなたがたは下,したから出,でた者,ものだが、わたしは上,うえからきた者,ものである。あなたがたはこの世,よの者,ものであるが、わたしはこの世,よの者,ものではない。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["がた"],["は"],["下","した"],["から"],["出た","でた"],["者","もの"],["だ"],["が"],["、"],["わたし"],["は"],["上","うえ"],["から"],["きた"],["者","もの"],["で"],["ある"],["。"],["あなた"],["がた"],["は"],["この世","このよ"],["の"],["者","もの"],["で"],["ある"],["が"],["、"],["わたし"],["は"],["この世","このよ"],["の"],["者","もの"],["で"],["は"],["ない"],["。"]]},{"verse":24,"text":"だからわたしは、あなたがたは自分,じぶんの罪,つみのうちに死,しぬであろうと、言,いったのである。もしわたしがそういう者,ものであることをあなたがたが信,しんじなければ、罪,つみのうちに死,しぬことになるからである」。","tok":[["だ"],["から"],["わたし"],["は"],["、"],["あなた"],["がた"],["は"],["自分","じぶん"],["の"],["罪","つみ"],["の"],["うち"],["に"],["死ぬで","しぬで"],["あろう"],["と"],["、"],["言った","いった"],["ので"],["ある"],["。"],["もし"],["わたし"],["が"],["そう"],["いう"],["者","もの"],["で"],["ある"],["こと"],["を"],["あなた"],["がた"],["が"],["信じなければ","しんじなければ"],["、"],["罪","つみ"],["の"],["うち"],["に"],["死ぬ","しぬ"],["こと"],["に"],["なる"],["から"],["で"],["ある"],["」"],["。"]]},{"verse":25,"text":"そこで彼,かれらはイエスに言,いった、「あなたは、いったい、どういうかたですか」。イエスは彼,かれらに言,いわれた、「わたしがどういう者,ものであるかは、初,はじめからあなたがたに言,いっているではないか。","tok":[["そこ"],["で"],["彼","かれ"],["ら"],["は"],["イエス"],["に"],["言った","いった"],["、"],["「"],["あなた"],["は"],["、"],["いったい"],["、"],["どういう"],["かた"],["です"],["か"],["」"],["。"],["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["わたし"],["が"],["どういう"],["者","もの"],["で"],["ある"],["か"],["は"],["、"],["初め","はじめ"],["から"],["あなた"],["がた"],["に"],["言って","いって"],["いるで"],["は"],["ない"],["か"],["。"]]},{"verse":26,"text":"あなたがたについて、わたしの言,いうべきこと、さばくべきことが、たくさんある。しかし、わたしをつかわされたかたは真実,しんじつなかたである。わたしは、そのかたから聞,きいたままを世,よにむかって語,かたるのである」。","tok":[["あなた"],["がた"],["について"],["、"],["わたし"],["の"],["言","いうべきこ"],["と"],["、"],["さばくべき"],["こと"],["が"],["、"],["たくさん"],["ある"],["。"],["しかし"],["、"],["わたし"],["を"],["つかわされた"],["かた"],["は"],["真実","しんじつ"],["な"],["かた"],["で"],["ある"],["。"],["わたし"],["は"],["、"],["その"],["かた"],["から"],["聞いた","きいた"],["まま"],["を"],["世","よ"],["に"],["むかって"],["語る","かたる"],["ので"],["ある"],["」"],["。"]]},{"verse":27,"text":"彼,かれらは、イエスが父,ちちについて話,はなしておられたことを悟,さとらなかった。","tok":[["彼","かれ"],["ら"],["は"],["、"],["イエス"],["が"],["父","ちち"],["について"],["話","はなし"],["て"],["おられた"],["こと"],["を"],["悟らなかった","さとらなかった"],["。"]]},{"verse":28,"text":"そこでイエスは言,いわれた、「あなたがたが人,ひとの子,こを上,あげてしまった後,のちはじめて、わたしがそういう者,ものであること、また、わたしは自分,じぶんからは何,なにもせず、ただ父,ちちが教,おしえて下,くださったままを話,はなしていたことが、わかってくるであろう。","tok":[["そこ"],["で"],["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["あなた"],["がた"],["が"],["人","ひと"],["の"],["子","こ"],["を"],["上げて","あげて"],["しまった"],["後","の"],["ち"],["はじめて"],["、"],["わたし"],["が"],["そう"],["いう"],["者","もの"],["で"],["ある"],["こと"],["、"],["また"],["、"],["わたし"],["は"],["自分","じぶん"],["から"],["は"],["何に","なに"],["も"],["せず"],["、"],["ただ"],["父","ちち"],["が"],["教えて","おしえて"],["下さった","くださった"],["まま"],["を"],["話","はなし"],["て"],["いた"],["こと"],["が"],["、"],["わかって"],["くるで"],["あろう"],["。"]]},{"verse":29,"text":"わたしをつかわされたかたは、わたしと一緒,いっしょにおられる。わたしは、いつも神,かみのみこころにかなうことをしているから、わたしをひとり置,おきざりになさることはない」。","tok":[["わたし"],["を"],["つかわされた"],["かた"],["は"],["、"],["わたし"],["と"],["一緒","いっしょ"],["に"],["おられる"],["。"],["わたし"],["は"],["、"],["いつも"],["神","かみ"],["のみ"],["こころ"],["に"],["かなう"],["こと"],["を"],["して"],["いる"],["から"],["、"],["わたし"],["を"],["ひとり"],["置きざり","おきざり"],["に"],["なさる"],["こと"],["は"],["ない"],["」"],["。"]]},{"verse":30,"text":"これらのことを語,かたられたところ、多,おおくの人々,ひとびとがイエスを信,しんじた。","tok":[["これ"],["ら"],["の"],["こと"],["を"],["語られた","かたられた"],["ところ"],["、"],["多く","おおく"],["の"],["人々","ひとびと"],["が"],["イエス"],["を"],["信じた","しんじた"],["。"]]},{"verse":31,"text":"イエスは自分,じぶんを信,しんじたユダヤ人,じんたちに言,いわれた、「もしわたしの言葉,ことばのうちにとどまっておるなら、あなたがたは、ほんとうにわたしの弟子,でしなのである。","tok":[["イエス"],["は"],["自分","じぶん"],["を"],["信じた","しんじた"],["ユダヤ人","ゆだやじん"],["たち"],["に"],["言われた","いわれた"],["、"],["「"],["もし"],["わたし"],["の"],["言葉","ことば"],["の"],["うち"],["に"],["とどまって"],["おるなら"],["、"],["あなた"],["がた"],["は"],["、"],["ほんとう"],["に"],["わたし"],["の"],["弟子","でし"],["な"],["ので"],["ある"],["。"]]},{"verse":32,"text":"また真理,しんりを知,しるであろう。そして真理,しんりは、あなたがたに自由,じゆうを得,えさせるであろう」。","tok":[["また"],["真理","しんり"],["を"],["知るで","しるで"],["あろう"],["。"],["そして"],["真理","しんり"],["は"],["、"],["あなた"],["がた"],["に"],["自由","じゆう"],["を"],["得させるで","えさせるで"],["あろう"],["」"],["。"]]},{"verse":33,"text":"そこで、彼,かれらはイエスに言,いった、「わたしたちはアブラハムの子孫,しそんであって、人,ひとの奴隷,どれいになったことなどは、一度,いちどもない。どうして、あなたがたに自由,じゆうを得,えさせるであろうと、言,いわれるのか」。","tok":[["そこ"],["で"],["、"],["彼","かれ"],["ら"],["は"],["イエス"],["に"],["言った","いった"],["、"],["「"],["わたしたち"],["は"],["アブラハム"],["の"],["子孫","しそん"],["で"],["あって"],["、"],["人","ひと"],["の"],["奴隷","どれい"],["に"],["なった"],["こと"],["など"],["は"],["、"],["一度","いちど"],["も"],["ない"],["。"],["どう"],["して"],["、"],["あなた"],["がた"],["に"],["自由","じゆう"],["を"],["得させるで","えさせるで"],["あろう"],["と"],["、"],["言われる","いわれる"],["の"],["か"],["」"],["。"]]},{"verse":34,"text":"イエスは彼,かれらに答,こたえられた、「よくよくあなたがたに言,いっておく。すべて罪,つみを犯,おかす者,ものは罪,つみの奴隷,どれいである。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["に"],["答","こたえ"],["られた"],["、"],["「"],["よくよく"],["あなた"],["がた"],["に"],["言って","いって"],["おく"],["。"],["すべて"],["罪","つみ"],["を"],["犯す","おかす"],["者","もの"],["は"],["罪","つみ"],["の"],["奴隷","どれい"],["で"],["ある"],["。"]]},{"verse":35,"text":"そして、奴隷,どれいはいつまでも家,いえにいる者,ものではない。しかし、子,こはいつまでもいる。","tok":[["そして"],["、"],["奴隷","どれい"],["は"],["いつ"],["まで"],["も"],["家","いえ"],["に"],["いる"],["者","もの"],["で"],["は"],["ない"],["。"],["しかし"],["、"],["子","こ"],["は"],["いつ"],["まで"],["も"],["いる"],["。"]]},{"verse":36,"text":"だから、もし子,こがあなたがたに自由,じゆうを得,えさせるならば、あなたがたは、ほんとうに自由,じゆうな者,ものとなるのである。","tok":[["だ"],["から"],["、"],["もし"],["子","こ"],["が"],["あなた"],["がた"],["に"],["自由","じゆう"],["を"],["得させるならば","えさせるならば"],["、"],["あなた"],["がた"],["は"],["、"],["ほんとう"],["に"],["自由","じゆう"],["な"],["者","もの"],["と"],["なる"],["ので"],["ある"],["。"]]},{"verse":37,"text":"わたしは、あなたがたがアブラハムの子孫,しそんであることを知,しっている。それだのに、あなたがたはわたしを殺,ころそうとしている。わたしの言葉,ことばが、あなたがたのうちに根,ねをおろしていないからである。","tok":[["わたし"],["は"],["、"],["あなた"],["がた"],["が"],["アブラハム"],["の"],["子孫","しそん"],["で"],["ある"],["こと"],["を"],["知って","しって"],["いる"],["。"],["それ"],["だ"],["のに"],["、"],["あなた"],["がた"],["は"],["わたし"],["を"],["殺そう","ころそう"],["として"],["いる"],["。"],["わたし"],["の"],["言葉","ことば"],["が"],["、"],["あなた"],["がた"],["の"],["うち"],["に"],["根","ね"],["を"],["おろして"],["いない"],["から"],["で"],["ある"],["。"]]},{"verse":38,"text":"わたしはわたしの父,ちちのもとで見,みたことを語,かたっているが、あなたがたは自分,じぶんの父,ちちから聞,きいたことを行,おこなっている」。","tok":[["わたし"],["は"],["わたし"],["の"],["父","ちち"],["の"],["もと"],["で"],["見た","みた"],["こと"],["を"],["語って","かたって"],["いる"],["が"],["、"],["あなた"],["がた"],["は"],["自分","じぶん"],["の"],["父","ちち"],["から"],["聞いた","きいた"],["こと"],["を"],["行なって","おこなって"],["いる"],["」"],["。"]]},{"verse":39,"text":"彼,かれらはイエスに答,こたえて言,いった、「わたしたちの父,ちちはアブラハムである」。イエスは彼,かれらに言,いわれた、「もしアブラハムの子,こであるなら、アブラハムのわざをするがよい。","tok":[["彼","かれ"],["ら"],["は"],["イエス"],["に"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["わたしたち"],["の"],["父","ちち"],["は"],["アブラハム"],["で"],["ある"],["」"],["。"],["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["もし"],["アブラハム"],["の"],["子","こ"],["で"],["あるなら"],["、"],["アブラハム"],["の"],["わざ"],["を"],["する"],["が"],["よい"],["。"]]},{"verse":40,"text":"ところが今,いま、神,かみから聞,きいた真理,しんりをあなたがたに語,かたってきたこのわたしを、殺,ころそうとしている。そんなことをアブラハムはしなかった。","tok":[["ところ"],["が"],["今","いま"],["、"],["神","かみ"],["から"],["聞いた","きいた"],["真理","しんり"],["を"],["あなた"],["がた"],["に"],["語って","かたって"],["きた"],["この"],["わたし"],["を"],["、"],["殺そう","ころそう"],["として"],["いる"],["。"],["そんな"],["こと"],["を"],["アブラハム"],["は"],["しなかった"],["。"]]},{"verse":41,"text":"あなたがたは、あなたがたの父,ちちのわざを行,おこなっているのである」。彼,かれらは言,いった、「わたしたちは、不品行,ふひんこうの結果,けっかうまれた者,ものではない。わたしたちにはひとりの父,ちちがある。それは神,かみである」。","tok":[["あなた"],["がた"],["は"],["、"],["あなた"],["がた"],["の"],["父","ちち"],["の"],["わざ"],["を"],["行なって","おこなって"],["いる"],["ので"],["ある"],["」"],["。"],["彼","かれ"],["ら"],["は"],["言った","いった"],["、"],["「"],["わたしたち"],["は"],["、"],["不品行","ふひんこう"],["の"],["結果","けっか"],["うまれた"],["者","もの"],["で"],["は"],["ない"],["。"],["わたしたち"],["に"],["は"],["ひとり"],["の"],["父","ちち"],["が"],["ある"],["。"],["それ"],["は"],["神","かみ"],["で"],["ある"],["」"],["。"]]},{"verse":42,"text":"イエスは彼,かれらに言,いわれた、「神,かみがあなたがたの父,ちちであるならば、あなたがたはわたしを愛,あいするはずである。わたしは神,かみから出,でた者,もの、また神,かみからきている者,ものであるからだ。わたしは自分,じぶんからきたのではなく、神,かみからつかわされたのである。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["神","かみ"],["が"],["あなた"],["がた"],["の"],["父","ちち"],["で"],["あるならば"],["、"],["あなた"],["がた"],["は"],["わたし"],["を"],["愛する","あいする"],["はず"],["で"],["ある"],["。"],["わたし"],["は"],["神","かみ"],["から"],["出た","でた"],["者","もの"],["、"],["また"],["神","かみ"],["から"],["きて"],["いる"],["者","もの"],["で"],["ある"],["から"],["だ"],["。"],["わたし"],["は"],["自分","じぶん"],["から"],["きた"],["ので"],["は"],["なく"],["、"],["神","かみ"],["から"],["つかわされた"],["ので"],["ある"],["。"]]},{"verse":43,"text":"どうしてあなたがたは、わたしの話,はなすことがわからないのか。あなたがたが、わたしの言葉,ことばを悟,さとることができないからである。","tok":[["どう"],["して"],["あなた"],["がた"],["は"],["、"],["わたし"],["の"],["話す","はなす"],["こと"],["が"],["わからない"],["の"],["か"],["。"],["あなた"],["が"],["た"],["が"],["、"],["わたし"],["の"],["言葉","ことば"],["を"],["悟","さとる"],["こと"],["が"],["できない"],["から"],["で"],["ある"],["。"]]},{"verse":44,"text":"あなたがたは自分,じぶんの父,ちち、すなわち、悪魔,あくまから出,でてきた者,ものであって、その父,ちちの欲望,よくぼうどおりを行,おこなおうと思,おもっている。彼,かれは初,はじめから、人殺,ひとごろしであって、真理,しんりに立,たつ者,ものではない。彼,かれのうちには真理,しんりがないからである。彼,かれが偽,いつわりを言,いうとき、いつも自分,じぶんの本音,ほんねをはいているのである。彼,かれは偽,いつわり者,ものであり、偽,いつわりの父,ちちであるからだ。","tok":[["あなた"],["がた"],["は"],["自分","じぶん"],["の"],["父","ちち"],["、"],["すなわち"],["、"],["悪魔","あくま"],["から"],["出て","でて"],["きた"],["者","もの"],["で"],["あって"],["、"],["その"],["父","ちち"],["の"],["欲望","よくぼう"],["どおり"],["を"],["行なおう","おこなおう"],["と"],["思って","おもって"],["いる"],["。"],["彼","かれ"],["は"],["初め","はじめ"],["から"],["、"],["人殺し","ひとごろし"],["で"],["あって"],["、"],["真理","しんり"],["に"],["立つ","たつ"],["者","もの"],["で"],["は"],["ない"],["。"],["彼","かれ"],["の"],["うち"],["に"],["は"],["真理","しんり"],["が"],["ない"],["から"],["で"],["ある"],["。"],["彼","かれ"],["が"],["偽り","いつわり"],["を"],["言う","いう"],["とき"],["、"],["いつも"],["自分","じぶん"],["の"],["本音","ほんね"],["を"],["はいて"],["いる"],["ので"],["ある"],["。"],["彼","かれ"],["は"],["偽わり","いつわり"],["者","もの"],["で"],["あり"],["、"],["偽わり","いつわり"],["の"],["父","ちち"],["で"],["ある"],["から"],["だ"],["。"]]},{"verse":45,"text":"しかし、わたしが真理,しんりを語,かたっているので、あなたがたはわたしを信,しんじようとしない。","tok":[["しかし"],["、"],["わたし"],["が"],["真理","しんり"],["を"],["語って","かたって"],["いる"],["ので"],["、"],["あなた"],["がた"],["は"],["わたし"],["を"],["信じよう","しんじよう"],["と"],["しない"],["。"]]},{"verse":46,"text":"あなたがたのうち、だれがわたしに罪,つみがあると責,せめうるのか。わたしは真理,しんりを語,かたっているのに、なぜあなたがたは、わたしを信,しんじないのか。","tok":[["あなた"],["がた"],["の"],["うち"],["、"],["だれ"],["が"],["わたし"],["に"],["罪","つみ"],["が"],["ある"],["と"],["責","せめ"],["うる"],["の"],["か"],["。"],["わたし"],["は"],["真理","しんり"],["を"],["語って","かたって"],["いる"],["のに"],["、"],["なぜ"],["あなた"],["がた"],["は"],["、"],["わたし"],["を"],["信じない","しんじない"],["の"],["か"],["。"]]},{"verse":47,"text":"神,かみからきた者,ものは神,かみの言葉,ことばに聞,きき従,したがうが、あなたがたが聞,きき従,したがわないのは、神,かみからきた者,ものでないからである」。","tok":[["神","かみ"],["から"],["きた"],["者","もの"],["は"],["神","かみ"],["の"],["言葉","ことば"],["に"],["聞","きき"],["従う","したがう"],["が"],["、"],["あなた"],["がた"],["が"],["聞","きき"],["従わない","したがわない"],["の"],["は"],["、"],["神","かみ"],["から"],["きた"],["者","もの"],["で"],["ない"],["から"],["で"],["ある"],["」"],["。"]]},{"verse":48,"text":"ユダヤ人,じんたちはイエスに答,こたえて言,いった、「あなたはサマリヤ人,びとで、悪霊,あくれいに取,とりつかれていると、わたしたちが言,いうのは、当然,とうぜんではないか」。","tok":[["ユダヤ人","ゆだやじん"],["たち"],["は"],["イエス"],["に"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["あなた"],["は"],["サマリヤ"],["人","び"],["と"],["で"],["、"],["悪霊","あくれい"],["に"],["取","とり"],["つかれて"],["いる"],["と"],["、"],["わたしたち"],["が"],["言う","いう"],["の"],["は"],["、"],["当然","とうぜん"],["で"],["は"],["ない"],["か"],["」"],["。"]]},{"verse":49,"text":"イエスは答,こたえられた、「わたしは、悪霊,あくれいに取,とりつかれているのではなくて、わたしの父,ちちを重,おもんじているのだが、あなたがたはわたしを軽,かろんじている。","tok":[["イエス"],["は"],["答","こたえ"],["られた"],["、"],["「"],["わたし"],["は"],["、"],["悪霊","あくれい"],["に"],["取","とり"],["つかれて"],["いる"],["ので"],["は"],["なくて"],["、"],["わたし"],["の"],["父","ちち"],["を"],["重じて","おもんじて"],["いる"],["の"],["だ"],["が"],["、"],["あなた"],["がた"],["は"],["わたし"],["を"],["軽んじて","かろんじて"],["いる"],["。"]]},{"verse":50,"text":"わたしは自分,じぶんの栄光,えいこうを求,もとめてはいない。それを求,もとめるかたが別,べつにある。そのかたは、またさばくかたである。","tok":[["わたし"],["は"],["自分","じぶん"],["の"],["栄光","えいこう"],["を"],["求めて","もとめて"],["は"],["いない"],["。"],["それ"],["を"],["求める","もとめる"],["かた"],["が"],["別","べつ"],["に"],["ある"],["。"],["その"],["かた"],["は"],["、"],["また"],["さばく"],["かた"],["で"],["ある"],["。"]]},{"verse":51,"text":"よくよく言,いっておく。もし人,ひとがわたしの言葉,ことばを守,まもるならば、その人,ひとはいつまでも死,しを見,みることがないであろう」。","tok":[["よくよく"],["言って","いって"],["おく"],["。"],["もし"],["人","ひと"],["が"],["わたし"],["の"],["言葉","ことば"],["を"],["守","まもる"],["ならば"],["、"],["その"],["人","ひと"],["は"],["いつ"],["まで"],["も"],["死","し"],["を"],["見る","みる"],["こと"],["が"],["ないで"],["あろう"],["」"],["。"]]},{"verse":52,"text":"ユダヤ人,じんたちが言,いった、「あなたが悪霊,あくれいに取,とりつかれていることが、今,いまわかった。アブラハムは死,しに、預言者,よげんしゃたちも死,しんでいる。それだのに、あなたは、わたしの言葉,ことばを守,まもる者,ものはいつまでも死,しを味,あじわうことがないであろうと、言,いわれる。","tok":[["ユダヤ人","ゆだやじん"],["たち"],["が"],["言った","いった"],["、"],["「"],["あなた"],["が"],["悪霊","あくれい"],["に"],["取","とり"],["つかれて"],["いる"],["こと"],["が"],["、"],["今","いま"],["わかった"],["。"],["アブラハム"],["は"],["死に","しに"],["、"],["預言者","よげんしゃ"],["たち"],["も"],["死んで","しんで"],["いる"],["。"],["それ"],["だ"],["のに"],["、"],["あなた"],["は"],["、"],["わたし"],["の"],["言葉","ことば"],["を"],["守者","まもるもの"],["は"],["いつ"],["まで"],["も"],["死","し"],["を"],["味わう","あじわう"],["こと"],["が"],["ないで"],["あろう"],["と"],["、"],["言われる","いわれる"],["。"]]},{"verse":53,"text":"あなたは、わたしたちの父,ちちアブラハムより偉,えらいのだろうか。彼,かれも死,しに、預言者,よげんしゃたちも死,しんだではないか。あなたは、いったい、自分,じぶんをだれと思,おもっているのか」。","tok":[["あなた"],["は"],["、"],["わたしたち"],["の"],["父","ちち"],["アブラハム"],["より"],["偉い","えらい"],["の"],["だろう"],["か"],["。"],["彼","かれ"],["も"],["死に","しに"],["、"],["預言者","よげんしゃ"],["たち"],["も"],["死んだで","しんだで"],["は"],["ない"],["か"],["。"],["あなた"],["は"],["、"],["いったい"],["、"],["自分","じぶん"],["を"],["だれ"],["と"],["思って","おもって"],["いる"],["の"],["か"],["」"],["。"]]},{"verse":54,"text":"イエスは答,こたえられた、「わたしがもし自分,じぶんに栄光,えいこうを帰,きするなら、わたしの栄光,えいこうは、むなしいものである。わたしに栄光,えいこうを与,あたえるかたは、わたしの父,ちちであって、あなたがたが自分,じぶんの神,かみだと言,いっているのは、そのかたのことである。","tok":[["イエス"],["は"],["答","こたえ"],["られた"],["、"],["「"],["わたし"],["が"],["もし"],["自分","じぶん"],["に"],["栄光","えいこう"],["を"],["帰するなら","きするなら"],["、"],["わたし"],["の"],["栄光","えいこう"],["は"],["、"],["むなしい"],["もの"],["で"],["ある"],["。"],["わたし"],["に"],["栄光","えいこう"],["を"],["与える","あたえる"],["かた"],["は"],["、"],["わたし"],["の"],["父","ちち"],["で"],["あって"],["、"],["あなた"],["がた"],["が"],["自分","じぶん"],["の"],["神","かみ"],["だ"],["と"],["言って","いって"],["いる"],["の"],["は"],["、"],["その"],["かた"],["の"],["こと"],["で"],["ある"],["。"]]},{"verse":55,"text":"あなたがたはその神,かみを知,しっていないが、わたしは知,しっている。もしわたしが神,かみを知,しらないと言,いうならば、あなたがたと同,おなじような偽,いつわり者,ものであろう。しかし、わたしはそのかたを知,しり、その御言,みことばを守,まもっている。","tok":[["あなた"],["がた"],["は"],["その"],["神","かみ"],["を"],["知って","しって"],["いない"],["が"],["、"],["わたし"],["は"],["知って","しって"],["いる"],["。"],["もし"],["わたし"],["が"],["神","かみ"],["を"],["知らない","しらない"],["と"],["言うならば","いうならば"],["、"],["あなた"],["がた"],["と"],["同じ","おなじ"],["よう"],["な"],["偽わり","いつわり"],["者","もの"],["で"],["あろう"],["。"],["しかし"],["、"],["わたし"],["は"],["その"],["かた"],["を"],["知り","しり"],["、"],["その"],["御言","みこと"],["ば"],["を"],["守って","まもって"],["いる"],["。"]]},{"verse":56,"text":"あなたがたの父,ちちアブラハムは、わたしのこの日,ひを見,みようとして楽,たのしんでいた。そしてそれを見,みて喜,よろこんだ」。","tok":[["あなた"],["がた"],["の"],["父","ちち"],["アブラハム"],["は"],["、"],["わたし"],["の"],["この"],["日","ひ"],["を"],["見よう","みよう"],["として"],["楽しんで","たのしんで"],["いた"],["。"],["そして"],["それ"],["を"],["見て","みて"],["喜こんだ","よろこんだ"],["」"],["。"]]},{"verse":57,"text":"そこでユダヤ人,じんたちはイエスに言,いった、「あなたはまだ五十にもならないのに、アブラハムを見,みたのか」。","tok":[["そこ"],["で"],["ユダヤ人","ゆだやじん"],["たち"],["は"],["イエス"],["に"],["言った","いった"],["、"],["「"],["あなた"],["は"],["まだ"],["五十","ごじゅう"],["に"],["も"],["ならない"],["のに"],["、"],["アブラハム"],["を"],["見た","みた"],["の"],["か"],["」"],["。"]]},{"verse":58,"text":"イエスは彼,かれらに言,いわれた、「よくよくあなたがたに言,いっておく。アブラハムの生,うまれる前,まえからわたしは、いるのである」。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["よくよく"],["あなた"],["がた"],["に"],["言って","いって"],["おく"],["。"],["アブラハム"],["の"],["生まれる","うまれる"],["前","まえ"],["から"],["わたし"],["は"],["、"],["いる"],["ので"],["ある"],["」"],["。"]]},{"verse":59,"text":"そこで彼,かれらは石,いしをとって、イエスに投,なげつけようとした。しかし、イエスは身,みを隠,かくして、宮,みやから出,でて行,いかれた。","tok":[["そこ"],["で"],["彼","かれ"],["ら"],["は"],["石","いし"],["を"],["とって"],["、"],["イエス"],["に"],["投","なげ"],["つけよう"],["と"],["した"],["。"],["しかし"],["、"],["イエス"],["は"],["身","み"],["を"],["隠して","かくして"],["、"],["宮","みや"],["から"],["出て","でて"],["行かれた","いかれた"],["。"]]}]
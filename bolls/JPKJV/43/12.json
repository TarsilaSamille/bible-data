[{"verse":1,"text":"過越,すぎこしの祭,まつりの六日,かまえに、イエスはベタニヤに行,いかれた。そこは、イエスが死人,しにんの中,なかからよみがえらせたラザロのいた所,ところである。","tok":[["過越","すぎこし"],["の"],["祭","まつり"],["の"],["六日","かまえ"],["に"],["、"],["イエス"],["は"],["ベタニヤ"],["に"],["行かれた","いかれた"],["。"],["そこ"],["は"],["、"],["イエス"],["が"],["死人","しにん"],["の"],["中","なか"],["から"],["よみがえらせた"],["ラザロ"],["の"],["いた"],["所","ところ"],["で"],["ある"],["。"]]},{"verse":2,"text":"イエスのためにそこで夕食,ゆうしょくの用意,よういがされ、マルタは給仕,きゅうじをしていた。イエスと一緒,いっしょに食卓,しょくたくについていた者,もののうちに、ラザロも加,くわわっていた。","tok":[["イエス"],["の"],["ため"],["に"],["そこ"],["で"],["夕食","ゆうしょく"],["の"],["用意","ようい"],["が"],["され"],["、"],["マルタ"],["は"],["給仕","きゅうじ"],["を"],["して"],["いた"],["。"],["イエス"],["と"],["一緒","いっしょ"],["に"],["食卓","しょくたく"],["について"],["いた"],["者","もの"],["の"],["うち"],["に"],["、"],["ラザロ"],["も"],["加わわって","くわわって"],["いた"],["。"]]},{"verse":3,"text":"その時,とき、マリヤは高価,こうかで純粋,じゅんすいなナルドの香油,こうゆ一斤,きんを持,もってきて、イエスの足,あしにぬり、自分,じぶんの髪,かみの毛,けでそれをふいた。すると、香油,こうゆのかおりが家,いえにいっぱいになった。","tok":[["その"],["時","とき"],["、"],["マリヤ"],["は"],["高価","こうか"],["で"],["純粋","じゅんすい"],["な"],["ナルド"],["の"],["香油","こうゆ"],["一","いち"],["斤","きん"],["を"],["持って","もって"],["きて"],["、"],["イエス"],["の"],["足","あし"],["に"],["ぬり"],["、"],["自分","じぶん"],["の"],["髪の毛","かみのけ"],["で"],["それ"],["を"],["ふいた"],["。"],["する"],["と"],["、"],["香油","こうゆ"],["の"],["かおり"],["が"],["家","いえ"],["に"],["いっぱい"],["に"],["なった"],["。"]]},{"verse":4,"text":"弟子,でしのひとりで、イエスを裏切,うらぎろうとしていたイスカリオテのユダが言,いった、","tok":[["弟子","でし"],["の"],["ひとり"],["で"],["、"],["イエス"],["を"],["裏切ろう","うらぎろう"],["として"],["いた"],["イスカリオテ"],["の"],["ユダ"],["が"],["言った","いった"],["、"]]},{"verse":5,"text":"「なぜこの香油,こうゆを三百デナリに売,うって、貧,まずしい人,ひとたちに、施,ほどこさなかったのか」。","tok":[["「"],["なぜ"],["この"],["香油","こうゆ"],["を"],["三百","さんひゃく"],["デナリ"],["に"],["売って","うって"],["、"],["貧しい","まずしい"],["人","ひと"],["たち"],["に"],["、"],["施さなかった","ほどこさなかった"],["の"],["か"],["」"],["。"]]},{"verse":6,"text":"彼,かれがこう言,いったのは、貧,まずしい人,ひとたちに対,たいする思,おもいやりがあったからではなく、自分,じぶんが盗人,ぬすびとであり、財布,さいふを預,あずかっていて、その中身,なかみをごまかしていたからであった。","tok":[["彼","かれ"],["が"],["こう"],["言った","いった"],["の"],["は"],["、"],["貧しい","まずしい"],["人","ひと"],["たち"],["に"],["対する","たいする"],["思いやり","おもいやり"],["が"],["あった"],["から"],["で"],["は"],["なく"],["、"],["自分","じぶん"],["が"],["盗人","ぬすびと"],["で"],["あり"],["、"],["財布","さいふ"],["を"],["預かって","あずかって"],["いて"],["、"],["その"],["中身","なかみ"],["を"],["ごまかして"],["いた"],["から"],["で"],["あった"],["。"]]},{"verse":7,"text":"イエスは言,いわれた、「この女,おんなのするままにさせておきなさい。わたしの葬,ほうむりの日,ひのために、それをとっておいたのだから。","tok":[["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["この"],["女","おんな"],["の"],["する"],["まま"],["に"],["させて"],["おき"],["なさい"],["。"],["わたし"],["の"],["葬むり","ほうむり"],["の"],["日","ひ"],["の"],["ため"],["に"],["、"],["それ"],["を"],["とって"],["おいた"],["の"],["だ"],["から"],["。"]]},{"verse":8,"text":"貧,まずしい人,ひとたちはいつもあなたがたと共,ともにいるが、わたしはいつも共,ともにいるわけではない」。","tok":[["貧しい","まずしい"],["人","ひと"],["たち"],["は"],["いつも"],["あなた"],["がた"],["と"],["共","とも"],["に"],["いる"],["が"],["、"],["わたし"],["は"],["いつも"],["共","とも"],["に"],["いる"],["わけ"],["で"],["は"],["ない"],["」"],["。"]]},{"verse":9,"text":"大,おおぜいのユダヤ人,じんたちが、そこにイエスのおられるのを知,しって、押,おしよせてきた。それはイエスに会,あうためだけではなく、イエスが死人,しにんのなかから、よみがえらせたラザロを見,みるためでもあった。","tok":[["大ぜい","おおぜい"],["の"],["ユダヤ人","ゆだやじん"],["たち"],["が"],["、"],["そこ"],["に"],["イエス"],["の"],["おられる"],["の"],["を"],["知って","しって"],["、"],["押","おし"],["よせて"],["きた"],["。"],["それ"],["は"],["イエス"],["に"],["会う","あう"],["ため"],["だけ"],["で"],["は"],["なく"],["、"],["イエス"],["が"],["死人","しにん"],["の"],["なか"],["から"],["、"],["よみがえらせた"],["ラザロ"],["を"],["見る","みる"],["ため"],["で"],["も"],["あった"],["。"]]},{"verse":10,"text":"そこで祭司長,さいしちょうたちは、ラザロも殺,ころそうと相談,そうだんした。","tok":[["そこ"],["で"],["祭司長","さいしちょう"],["たち"],["は"],["、"],["ラザロ"],["も"],["殺そう","ころそう"],["と"],["相談","そうだん"],["した"],["。"]]},{"verse":11,"text":"それは、ラザロのことで、多,おおくのユダヤ人,じんが彼,かれらを離,はなれ去,さって、イエスを信,しんじるに至,いたったからである。","tok":[["それ"],["は"],["、"],["ラザロ"],["の"],["こと"],["で"],["、"],["多く","おおく"],["の"],["ユダヤ人","ゆだやじん"],["が"],["彼","かれ"],["ら"],["を"],["離れ","はなれ"],["去て","さって"],["、"],["イエス"],["を"],["信じる","しんじる"],["に"],["至った","いたった"],["から"],["で"],["ある"],["。"]]},{"verse":12,"text":"その翌日,よくじつ、祭,まつりにきていた大,おおぜいの群衆,ぐんしゅうは、イエスがエルサレムにこられると聞,きいて、","tok":[["その"],["翌日","よくじつ"],["、"],["祭","まつり"],["に"],["きて"],["いた"],["大ぜい","おおぜい"],["の"],["群衆","ぐんしゅう"],["は"],["、"],["イエス"],["が"],["エルサレム"],["に"],["こられる"],["と"],["聞いて","きいて"],["、"]]},{"verse":13,"text":"しゅろの枝,えだを手,てにとり、迎,むかえに出,でて行,いった。そして叫,さけんだ、「ホサナ、主,しゅの御名,みなによってきたる者,ものに祝福,しゅくふくあれ、イスラエルの王,おうに」。","tok":[["しゅろ"],["の"],["枝","えだ"],["を"],["手","て"],["に"],["とり"],["、"],["迎","むかえ"],["に"],["出て","でて"],["行った","いった"],["。"],["そして"],["叫けんだ","さけんだ"],["、"],["「"],["ホサナ"],["、"],["主","しゅ"],["の"],["御名","みな"],["によって"],["きたる"],["者","もの"],["に"],["祝福","しゅくふく"],["あれ"],["、"],["イスラエル"],["の"],["王","おう"],["に"],["」"],["。"]]},{"verse":14,"text":"イエスは、ろばの子,こを見,みつけて、その上,うえに乗,のられた。それは","tok":[["イエス"],["は"],["、"],["ろば"],["の"],["子","こ"],["を"],["見つけて","みつけて"],["、"],["その"],["上","うえ"],["に"],["乗られた","のられた"],["。"],["それ"],["は"]]},{"verse":15,"text":"「シオンの娘,むすめよ、恐,おそれるな。見,みよ、あなたの王,おうがろばの子,こに乗,のっておいでになる」と書,かいてあるとおりであった。","tok":[["「"],["シオン"],["の"],["娘","むすめ"],["よ"],["、"],["恐れる","おそれる"],["な"],["。"],["見よ","みよ"],["、"],["あなた"],["の"],["王","おう"],["が"],["ろば"],["の"],["子","こ"],["に"],["乗って","のって"],["おいで"],["に"],["なる"],["」"],["と"],["書いて","かいて"],["ある"],["とおり"],["で"],["あった"],["。"]]},{"verse":16,"text":"弟子,でしたちは初,はじめにはこのことを悟,さとらなかったが、イエスが栄光,えいこうを受,うけられた時,ときに、このことがイエスについて書,かかれてあり、またそのとおりに、人々,ひとびとがイエスに対,たいしてしたのだということを、思,おもい起,おこした。","tok":[["弟子","でし"],["たち"],["は"],["初め","はじめ"],["に"],["は"],["この"],["こと"],["を"],["悟らなかった","さとらなかった"],["が"],["、"],["イエス"],["が"],["栄光","えいこう"],["を"],["受られた","うけられた"],["時","とき"],["に"],["、"],["この"],["こと"],["が"],["イエス"],["について"],["書かれて","かかれて"],["あり"],["、"],["また"],["その"],["とおり"],["に"],["、"],["人々","ひとびと"],["が"],["イエス"],["に対して","にたいして"],["した"],["の"],["だ"],["と"],["いう"],["こと"],["を"],["、"],["思い起こした","おもいおこした"],["。"]]},{"verse":17,"text":"また、イエスがラザロを墓,はかから呼,よび出,だして、死人,しにんの中,なかからよみがえらせたとき、イエスと一緒,いっしょにいた群衆,ぐんしゅうが、そのあかしをした。","tok":[["また"],["、"],["イエス"],["が"],["ラザロ"],["を"],["墓","はか"],["から"],["呼び出して","よびだして"],["、"],["死人","しにん"],["の"],["中","なか"],["から"],["よみがえらせた"],["とき"],["、"],["イエス"],["と"],["一緒","いっしょ"],["に"],["いた"],["群衆","ぐんしゅう"],["が"],["、"],["その"],["あかし"],["を"],["した"],["。"]]},{"verse":18,"text":"群衆,ぐんしゅうがイエスを迎,むかえに出,でたのは、イエスがこのようなしるしを行,おこなわれたことを、聞,きいていたからである。","tok":[["群衆","ぐんしゅう"],["が"],["イエス"],["を"],["迎","むかえ"],["に"],["出た","でた"],["の"],["は"],["、"],["イエス"],["が"],["この"],["よう"],["な"],["しるし"],["を"],["行なわれた","おこなわれた"],["こと"],["を"],["、"],["聞いて","きいて"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":19,"text":"そこで、パリサイ人,びとたちは互,たがいに言,いった、「何,なにをしてもむだだった。世,よをあげて彼,かれのあとを追,おって行,いったではないか」。","tok":[["そこ"],["で"],["、"],["パリサイ"],["人","びとたち"],["は"],["互","たがい"],["に"],["言った","いった"],["、"],["「"],["何に","なに"],["を"],["して"],["も"],["むだ"],["だった"],["。"],["世","よ"],["を"],["あげて"],["彼","かれ"],["の"],["あと"],["を"],["追って","おって"],["行ったで","いったで"],["は"],["ない"],["か"],["」"],["。"]]},{"verse":20,"text":"祭,まつりで礼拝,れいはいするために上,のぼってきた人々,ひとびとのうちに、数人,すうにんのギリシヤ人,じんがいた。","tok":[["祭","まつり"],["で"],["礼拝","れいはい"],["する"],["ため"],["に"],["上って","のぼって"],["きた"],["人々","ひとびと"],["の"],["うち"],["に"],["、"],["数人","すうにん"],["の"],["ギリシヤ"],["人","じん"],["が"],["いた"],["。"]]},{"verse":21,"text":"彼,かれらはガリラヤのベツサイダ出,でであるピリポのところにきて、「君,きみよ、イエスにお目,めにかかりたいのですが」と言,いって頼,たのんだ。","tok":[["彼","かれ"],["ら"],["は"],["ガリラヤ"],["の"],["ベツサイダ"],["出","で"],["で"],["ある"],["ピリポ"],["の"],["ところ"],["に"],["きて"],["、"],["「"],["君","きみ"],["よ"],["、"],["イエス"],["に"],["お目","おめ"],["に"],["かかりたい"],["の"],["です"],["が"],["」"],["と"],["言って","いって"],["頼んだ","たのんだ"],["。"]]},{"verse":22,"text":"ピリポはアンデレのところに行,いってそのことを話,はなし、アンデレとピリポは、イエスのもとに行,いって伝,つたえた。","tok":[["ピリポ"],["は"],["アンデレ"],["の"],["ところ"],["に"],["行って","いって"],["その"],["こと"],["を"],["話","はなし"],["、"],["アンデレ"],["と"],["ピリポ"],["は"],["、"],["イエス"],["の"],["もと"],["に"],["行って","いって"],["伝えた","つたえた"],["。"]]},{"verse":23,"text":"すると、イエスは答,こたえて言,いわれた、「人,ひとの子,こが栄光,えいこうを受,うける時,ときがきた。","tok":[["する"],["と"],["、"],["イエス"],["は"],["答","こたえ"],["て"],["言われた","いわれた"],["、"],["「"],["人","ひと"],["の"],["子","こ"],["が"],["栄光","えいこう"],["を"],["受る","うける"],["時","とき"],["が"],["きた"],["。"]]},{"verse":24,"text":"よくよくあなたがたに言,いっておく。一粒,つぶの麦,むぎが地,ちに落,おちて死,しななければ、それはただ一粒,つぶのままである。しかし、もし死,しんだなら、豊,ゆたかに実,みを結,むすぶようになる。","tok":[["よくよく"],["あなた"],["がた"],["に"],["言って","いって"],["おく"],["。"],["一","いち"],["粒","つぶ"],["の"],["麦","むぎ"],["が"],["地","ち"],["に"],["落","おち"],["て"],["死ななければ","しななければ"],["、"],["それ"],["は"],["ただ"],["一","いち"],["粒","つぶ"],["の"],["まま"],["で"],["ある"],["。"],["しかし"],["、"],["もし"],["死んだなら","しんだなら"],["、"],["豊","ゆたか"],["に"],["実","み"],["を"],["結ぶ","むすぶ"],["よう"],["に"],["なる"],["。"]]},{"verse":25,"text":"自分,じぶんの命,いのちを愛,あいする者,ものはそれを失,うしない、この世,よで自分,じぶんの命,いのちを憎,にくむ者,ものは、それを保,たもって永遠,えいえんの命,いのちに至,いたるであろう。","tok":[["自分","じぶん"],["の"],["命","いのち"],["を"],["愛する","あいする"],["者","もの"],["は"],["それ"],["を"],["失ない","うしない"],["、"],["この世","このよ"],["で"],["自分","じぶん"],["の"],["命","いのち"],["を"],["憎む","にくむ"],["者","もの"],["は"],["、"],["それ"],["を"],["保って","たもって"],["永遠","えいえん"],["の"],["命","いのち"],["に"],["至るで","いたるで"],["あろう"],["。"]]},{"verse":26,"text":"もしわたしに仕,つかえようとする人,ひとがあれば、その人,ひとはわたしに従,したがって来,くるがよい。そうすれば、わたしのおる所,ところに、わたしに仕,つかえる者,ものもまた、おるであろう。もしわたしに仕,つかえようとする人,ひとがあれば、その人,ひとを父,ちちは重,おもんじて下,くださるであろう。","tok":[["もし"],["わたし"],["に"],["仕えよう","つかえよう"],["と"],["する"],["人","ひと"],["が"],["あれば"],["、"],["その"],["人","ひと"],["は"],["わたし"],["に"],["従って","したがって"],["来る","くる"],["が"],["よい"],["。"],["そう"],["すれば"],["、"],["わたし"],["の"],["おる"],["所","ところ"],["に"],["、"],["わたし"],["に"],["仕える","つかえる"],["者","もの"],["も"],["また"],["、"],["おるで"],["あろう"],["。"],["もし"],["わたし"],["に"],["仕えよう","つかえよう"],["と"],["する"],["人","ひと"],["が"],["あれば"],["、"],["その"],["人","ひと"],["を"],["父","ちち"],["は"],["重じて","おもんじて"],["下さるで","くださるで"],["あろう"],["。"]]},{"verse":27,"text":"今,いまわたしは心,こころが騒,さわいでいる。わたしはなんと言,いおうか。父,ちちよ、この時,ときからわたしをお救,すくい下,ください。しかし、わたしはこのために、この時,ときに至,いたったのです。","tok":[["今","いま"],["わたし"],["は"],["心","こころ"],["が"],["騒いで","さわいで"],["いる"],["。"],["わたし"],["は"],["なん"],["と"],["言おう","いおう"],["か"],["。"],["父","ちち"],["よ"],["、"],["この"],["時","とき"],["から"],["わたし"],["を"],["お救い","おすくい"],["下さい","ください"],["。"],["しかし"],["、"],["わたし"],["は"],["この"],["ため"],["に"],["、"],["この"],["時","とき"],["に"],["至った","いたった"],["の"],["です"],["。"]]},{"verse":28,"text":"父,ちちよ、み名,ながあがめられますように」。すると天,てんから声,こえがあった、「わたしはすでに栄光,えいこうをあらわした。そして、更,さらにそれをあらわすであろう」。","tok":[["父","ちち"],["よ"],["、"],["み名","みな"],["が"],["あがめられます"],["よう"],["に"],["」"],["。"],["する"],["と"],["天","てん"],["から"],["声","こえ"],["が"],["あった"],["、"],["「"],["わたし"],["は"],["すでに"],["栄光","えいこう"],["を"],["あらわした"],["。"],["そして"],["、"],["更に","さらに"],["それ"],["を"],["あらわすで"],["あろう"],["」"],["。"]]},{"verse":29,"text":"すると、そこに立,たっていた群衆,ぐんしゅうがこれを聞,きいて、「雷,かみなりがなったのだ」と言,いい、ほかの人,ひとたちは、「御使,みつかいが彼,かれに話,はなしかけたのだ」と言,いった。","tok":[["する"],["と"],["、"],["そこ"],["に"],["立って","たって"],["いた"],["群衆","ぐんしゅう"],["が"],["これ"],["を"],["聞いて","きいて"],["、"],["「"],["雷","かみなり"],["が"],["なった"],["の"],["だ"],["」"],["と"],["言い","いい"],["、"],["ほか"],["の"],["人","ひと"],["たち"],["は"],["、"],["「"],["御使","み"],["つかい"],["が"],["彼","かれ"],["に"],["話かけた","はなしかけた"],["の"],["だ"],["」"],["と"],["言った","いった"],["。"]]},{"verse":30,"text":"イエスは答,こたえて言,いわれた、「この声,こえがあったのは、わたしのためではなく、あなたがたのためである。","tok":[["イエス"],["は"],["答","こたえ"],["て"],["言われた","いわれた"],["、"],["「"],["この"],["声","こえ"],["が"],["あった"],["の"],["は"],["、"],["わたし"],["の"],["ため"],["で"],["は"],["なく"],["、"],["あなた"],["がた"],["の"],["ため"],["で"],["ある"],["。"]]},{"verse":31,"text":"今,いまはこの世,よがさばかれる時,ときである。今,いまこそこの世,よの君,きみは追,おい出,だされるであろう。","tok":[["今","いま"],["は"],["この世","このよ"],["が"],["さばかれる"],["時","とき"],["で"],["ある"],["。"],["今","いま"],["こそ"],["この世","このよ"],["の"],["君","きみ"],["は"],["追い出されるで","おいだされるで"],["あろう"],["。"]]},{"verse":32,"text":"そして、わたしがこの地,ちから上,あげられる時,ときには、すべての人,ひとをわたしのところに引,ひきよせるであろう」。","tok":[["そして"],["、"],["わたし"],["が"],["この"],["地","ち"],["から"],["上げられる","あげられる"],["時","とき"],["に"],["は"],["、"],["すべて"],["の"],["人","ひと"],["を"],["わたし"],["の"],["ところ"],["に"],["引","ひき"],["よせるで"],["あろう"],["」"],["。"]]},{"verse":33,"text":"イエスはこう言,いって、自分,じぶんがどんな死,しに方,ほうで死,しのうとしていたかを、お示,しめしになったのである。","tok":[["イエス"],["は"],["こう"],["言って","いって"],["、"],["自分","じぶん"],["が"],["どんな"],["死に","しに"],["方","ほう"],["で"],["死のう","しのう"],["として"],["いた"],["か"],["を"],["、"],["お示めし","おしめし"],["に"],["なった"],["ので"],["ある"],["。"]]},{"verse":34,"text":"すると群衆,ぐんしゅうはイエスにむかって言,いった、「わたしたちは律法,りっぽうによって、キリストはいつまでも生,いきておいでになるのだ、と聞,きいていました。それだのに、どうして人,ひとの子,こは上,あげられねばならないと、言,いわれるのですか。その人,ひとの子,ことは、だれのことですか」。","tok":[["する"],["と"],["群衆","ぐんしゅう"],["は"],["イエス"],["に"],["むかって"],["言った","いった"],["、"],["「"],["わたしたち"],["は"],["律法","りっぽう"],["によって"],["、"],["キリスト"],["は"],["いつ"],["まで"],["も"],["生きて","いきて"],["おいで"],["に"],["なる"],["の"],["だ"],["、"],["と"],["聞いて","きいて"],["いました"],["。"],["それ"],["だ"],["のに"],["、"],["どう"],["して"],["人","ひと"],["の"],["子","こ"],["は"],["上げられねば","あげられねば"],["ならない"],["と"],["、"],["言われる","いわれる"],["の"],["です"],["か"],["。"],["その"],["人","ひと"],["の"],["子","こ"],["と"],["は"],["、"],["だれ"],["の"],["こと"],["です"],["か"],["」"],["。"]]},{"verse":35,"text":"そこでイエスは彼,かれらに言,いわれた、「もうしばらくの間,あいだ、光,ひかりはあなたがたと一緒,いっしょにここにある。光,ひかりがある間,あいだに歩,あるいて、やみに追,おいつかれないようにしなさい。やみの中,なかを歩,あるく者,ものは、自分,じぶんがどこへ行,いくのかわかっていない。","tok":[["そこ"],["で"],["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["もう"],["しばらく"],["の"],["間","あいだ"],["、"],["光","ひかり"],["は"],["あなた"],["がた"],["と"],["一緒","いっしょ"],["に"],["ここ"],["に"],["ある"],["。"],["光","ひかり"],["が"],["ある"],["間","あいだ"],["に"],["歩いて","あるいて"],["、"],["やみ"],["に"],["追いつかれない","おいつかれない"],["よう"],["に"],["し"],["なさい"],["。"],["やみ"],["の"],["中","なか"],["を"],["歩く","あるく"],["者","もの"],["は"],["、"],["自分","じぶん"],["が"],["どこ"],["へ"],["行く","いく"],["の"],["か"],["わかって"],["いない"],["。"]]},{"verse":36,"text":"光,ひかりのある間,あいだに、光,ひかりの子,ことなるために、光,ひかりを信,しんじなさい」。イエスはこれらのことを話,はなしてから、そこを立,たち去,さって、彼,かれらから身,みをお隠,かくしになった。","tok":[["光","ひかり"],["の"],["ある"],["間","あいだ"],["に"],["、"],["光","ひかり"],["の"],["子","こ"],["と"],["なる"],["ため"],["に"],["、"],["光","ひかり"],["を"],["信じ","しんじ"],["なさい"],["」"],["。"],["イエス"],["は"],["これ"],["ら"],["の"],["こと"],["を"],["話","はなし"],["て"],["から"],["、"],["そこ"],["を"],["立ち","たち"],["去て","さって"],["、"],["彼","かれ"],["ら"],["から"],["身","み"],["を"],["お隠し","おかくし"],["に"],["なった"],["。"]]},{"verse":37,"text":"このように多,おおくのしるしを彼,かれらの前,まえでなさったが、彼,かれらはイエスを信,しんじなかった。","tok":[["この"],["よう"],["に"],["多く","おおく"],["の"],["しるし"],["を"],["彼","かれ"],["ら"],["の"],["前","まえ"],["で"],["なさった"],["が"],["、"],["彼","かれ"],["ら"],["は"],["イエス"],["を"],["信じなかった","しんじなかった"],["。"]]},{"verse":38,"text":"それは、預言者,よげんしゃイザヤの次,つぎの言葉,ことばが成就,じょうじゅするためである、「主,しゅよ、わたしたちの説,とくところを、だれが信,しんじたでしょうか。また、主,しゅのみ腕,うではだれに示,しめされたでしょうか」。","tok":[["それ"],["は"],["、"],["預言者","よげんしゃ"],["イザヤ"],["の"],["次","つぎ"],["の"],["言葉","ことば"],["が"],["成就","じょうじゅ"],["する"],["ため"],["で"],["ある"],["、"],["「"],["主","しゅ"],["よ"],["、"],["わたしたち"],["の"],["説く","とく"],["ところ"],["を"],["、"],["だれ"],["が"],["信じたでしょう","しんじたでしょう"],["か"],["。"],["また"],["、"],["主","しゅ"],["のみ"],["腕","うで"],["は"],["だれ"],["に"],["示めされたでしょう","しめされたでしょう"],["か"],["」"],["。"]]},{"verse":39,"text":"こういうわけで、彼,かれらは信,しんじることができなかった。イザヤはまた、こうも言,いった、","tok":[["こう"],["いう"],["わけ"],["で"],["、"],["彼","かれ"],["ら"],["は"],["信じる","しんじる"],["こと"],["が"],["できなかった"],["。"],["イザヤ"],["は"],["また"],["、"],["こう"],["も"],["言った","いった"],["、"]]},{"verse":40,"text":"「神,かみは彼,かれらの目,めをくらまし、心,こころをかたくなになさった。それは、彼,かれらが目,めで見,みず、心,こころで悟,さとらず、悔,くい改,あらためていやされることがないためである」。","tok":[["「"],["神","かみ"],["は"],["彼","かれ"],["ら"],["の"],["目","め"],["を"],["くらまし"],["、"],["心","こころ"],["を"],["かたくな"],["に"],["なさった"],["。"],["それ"],["は"],["、"],["彼","かれ"],["ら"],["が"],["目","め"],["で"],["見ず","みず"],["、"],["心","こころ"],["で"],["悟らず","さとらず"],["、"],["悔い","くい"],["改","あらため"],["て"],["いやされる"],["こと"],["が"],["ない"],["ため"],["で"],["ある"],["」"],["。"]]},{"verse":41,"text":"イザヤがこう言,いったのは、イエスの栄光,えいこうを見,みたからであって、イエスのことを語,かたったのである。","tok":[["イザヤ"],["が"],["こう"],["言った","いった"],["の"],["は"],["、"],["イエス"],["の"],["栄光","えいこう"],["を"],["見た","みた"],["から"],["で"],["あって"],["、"],["イエス"],["の"],["こと"],["を"],["語った","かたった"],["ので"],["ある"],["。"]]},{"verse":42,"text":"しかし、役人,やくにんたちの中,なかにも、イエスを信,しんじた者,ものが多,おおかったが、パリサイ人,びとをはばかって、告白,こくはくはしなかった。会堂,かいどうから追,おい出,だされるのを恐,おそれていたのである。","tok":[["しかし"],["、"],["役人","やくにん"],["たち"],["の"],["中","なか"],["に"],["も"],["、"],["イエス"],["を"],["信じた","しんじた"],["者","もの"],["が"],["多かった","おおかった"],["が"],["、"],["パリサイ"],["人","びと"],["を"],["はばかって"],["、"],["告白","こくはく"],["は"],["しなかった"],["。"],["会堂","かいどう"],["から"],["追い出される","おいだされる"],["の"],["を"],["恐れて","おそれて"],["いた"],["ので"],["ある"],["。"]]},{"verse":43,"text":"彼,かれらは神,かみのほまれよりも、人,ひとのほまれを好,このんだからである。","tok":[["彼","かれ"],["ら"],["は"],["神","かみ"],["の"],["ほまれ"],["より"],["も"],["、"],["人","ひと"],["の"],["ほまれ"],["を"],["好んだ","このんだ"],["から"],["で"],["ある"],["。"]]},{"verse":44,"text":"イエスは大声,おおごえで言,いわれた、「わたしを信,しんじる者,ものは、わたしを信,しんじるのではなく、わたしをつかわされたかたを信,しんじるのであり、","tok":[["イエス"],["は"],["大声","おおごえ"],["で"],["言われた","いわれた"],["、"],["「"],["わたし"],["を"],["信じる","しんじる"],["者","もの"],["は"],["、"],["わたし"],["を"],["信じる","しんじる"],["ので"],["は"],["なく"],["、"],["わたし"],["を"],["つかわされた"],["かた"],["を"],["信じる","しんじる"],["ので"],["あり"],["、"]]},{"verse":45,"text":"また、わたしを見,みる者,ものは、わたしをつかわされたかたを見,みるのである。","tok":[["また"],["、"],["わたし"],["を"],["見る","みる"],["者","もの"],["は"],["、"],["わたし"],["を"],["つかわされた"],["かた"],["を"],["見る","みる"],["ので"],["ある"],["。"]]},{"verse":46,"text":"わたしは光,ひかりとしてこの世,よにきた。それは、わたしを信,しんじる者,ものが、やみのうちにとどまらないようになるためである。","tok":[["わたし"],["は"],["光","ひかり"],["として"],["この世","このよ"],["に"],["きた"],["。"],["それ"],["は"],["、"],["わたし"],["を"],["信じる","しんじる"],["者","もの"],["が"],["、"],["やみ"],["の"],["うち"],["に"],["とどまらない"],["よう"],["に"],["なる"],["ため"],["で"],["ある"],["。"]]},{"verse":47,"text":"たとい、わたしの言,いうことを聞,きいてそれを守,まもらない人,ひとがあっても、わたしはその人,ひとをさばかない。わたしがきたのは、この世,よをさばくためではなく、この世,よを救,すくうためである。","tok":[["たとい"],["、"],["わたし"],["の"],["言う","いう"],["こと"],["を"],["聞いて","きいて"],["それ"],["を"],["守らない","まもらない"],["人","ひと"],["が"],["あって"],["も"],["、"],["わたし"],["は"],["その"],["人","ひと"],["を"],["さばかない"],["。"],["わたし"],["が"],["きた"],["の"],["は"],["、"],["この世","このよ"],["を"],["さばく"],["ため"],["で"],["は"],["なく"],["、"],["この世","このよ"],["を"],["救う","すくう"],["ため"],["で"],["ある"],["。"]]},{"verse":48,"text":"わたしを捨,すてて、わたしの言葉,ことばを受,うけいれない人,ひとには、その人,ひとをさばくものがある。わたしの語,かたったその言葉,ことばが、終,おわりの日,ひにその人,ひとをさばくであろう。","tok":[["わたし"],["を"],["捨てて","すてて"],["、"],["わたし"],["の"],["言葉","ことば"],["を"],["受","うけ"],["いれない"],["人","ひと"],["に"],["は"],["、"],["その"],["人","ひと"],["を"],["さばく"],["もの"],["が"],["ある"],["。"],["わたし"],["の"],["語った","かたった"],["その"],["言葉","ことば"],["が"],["、"],["終","おわり"],["の"],["日","ひ"],["に"],["その"],["人","ひと"],["を"],["さばくで"],["あろう"],["。"]]},{"verse":49,"text":"わたしは自分,じぶんから語,かたったのではなく、わたしをつかわされた父,ちちご自身,じしんが、わたしの言,いうべきこと、語,かたるべきことをお命,めいじになったのである。","tok":[["わたし"],["は"],["自分","じぶん"],["から"],["語った","かたった"],["ので"],["は"],["なく"],["、"],["わたし"],["を"],["つかわされた"],["父","ちち"],["ご自身","ごじしん"],["が"],["、"],["わたし"],["の"],["言","いうべきこ"],["と"],["、"],["語るべき","かたるべき"],["こと"],["を"],["お命じ","おめいじ"],["に"],["なった"],["ので"],["ある"],["。"]]},{"verse":50,"text":"わたしは、この命令,めいれいが永遠,えいえんの命,いのちであることを知,しっている。それゆえに、わたしが語,かたっていることは、わたしの父,ちちがわたしに仰,おおせになったことを、そのまま語,かたっているのである」。","tok":[["わたし"],["は"],["、"],["この"],["命令","めいれい"],["が"],["永遠","えいえん"],["の"],["命","いのち"],["で"],["ある"],["こと"],["を"],["知って","しって"],["いる"],["。"],["それ"],["ゆえ"],["に"],["、"],["わたし"],["が"],["語って","かたって"],["いる"],["こと"],["は"],["、"],["わたし"],["の"],["父","ちち"],["が"],["わたし"],["に"],["仰せ","おおせ"],["に"],["なった"],["こと"],["を"],["、"],["そのまま"],["語って","かたって"],["いる"],["ので"],["ある"],["」"],["。"]]}]
[{"verse":1,"text":"わたしはまことのぶどうの木,き、わたしの父,ちちは農夫,のうふである。","tok":[["わたし"],["は"],["まこと"],["の"],["ぶどう"],["の"],["木","き"],["、"],["わたし"],["の"],["父","ちち"],["は"],["農夫","のうふ"],["で"],["ある"],["。"]]},{"verse":2,"text":"わたしにつながっている枝,えだで実,みを結,むすばないものは、父,ちちがすべてこれをとりのぞき、実,みを結,むすぶものは、もっと豊,ゆたかに実,みのらせるために、手入,ていれしてこれをきれいになさるのである。","tok":[["わたし"],["に"],["つながって"],["いる"],["枝","えだ"],["で"],["実","み"],["を"],["結ばない","むすばない"],["もの"],["は"],["、"],["父","ちち"],["が"],["すべて"],["これ"],["を"],["とりのぞき"],["、"],["実","み"],["を"],["結ぶ","むすぶ"],["もの"],["は"],["、"],["もっと"],["豊","ゆたか"],["に"],["実らせる","みのらせる"],["ため"],["に"],["、"],["手入","ていれ"],["して"],["これ"],["を"],["きれい"],["に"],["なさる"],["ので"],["ある"],["。"]]},{"verse":3,"text":"あなたがたは、わたしが語,かたった言葉,ことばによって既,すでにきよくされている。","tok":[["あなた"],["がた"],["は"],["、"],["わたし"],["が"],["語った","かたった"],["言葉","ことば"],["によって"],["既に","すでに"],["きよく"],["されて"],["いる"],["。"]]},{"verse":4,"text":"わたしにつながっていなさい。そうすれば、わたしはあなたがたとつながっていよう。枝,えだがぶどうの木,きにつながっていなければ、自分,じぶんだけでは実,みを結,むすぶことができないように、あなたがたもわたしにつながっていなければ実,みを結,むすぶことができない。","tok":[["わたし"],["に"],["つながって"],["い"],["なさい"],["。"],["そう"],["すれば"],["、"],["わたし"],["は"],["あなた"],["がた"],["と"],["つながって"],["いよう"],["。"],["枝","えだ"],["が"],["ぶどう"],["の"],["木","き"],["に"],["つながって"],["いなければ"],["、"],["自分","じぶん"],["だけ"],["で"],["は"],["実","み"],["を"],["結ぶ","むすぶ"],["こと"],["が"],["できない"],["よう"],["に"],["、"],["あなた"],["がた"],["も"],["わたし"],["に"],["つながって"],["いなければ"],["実","み"],["を"],["結ぶ","むすぶ"],["こと"],["が"],["できない"],["。"]]},{"verse":5,"text":"わたしはぶどうの木,き、あなたがたはその枝,えだである。もし人,ひとがわたしにつながっており、またわたしがその人,ひととつながっておれば、その人,ひとは実,みを豊,ゆたかに結,むすぶようになる。わたしから離,はなれては、あなたがたは何一,なにひとつできないからである。","tok":[["わたし"],["は"],["ぶどう"],["の"],["木","き"],["、"],["あなた"],["がた"],["は"],["その"],["枝","えだ"],["で"],["ある"],["。"],["もし"],["人","ひと"],["が"],["わたし"],["に"],["つながって"],["おり"],["、"],["また"],["わたし"],["が"],["その"],["人","ひと"],["と"],["つながって"],["おれば"],["、"],["その"],["人","ひと"],["は"],["実","み"],["を"],["豊","ゆたか"],["に"],["結ぶ","むすぶ"],["よう"],["に"],["なる"],["。"],["わたし"],["から"],["離れて","はなれて"],["は"],["、"],["あなた"],["がた"],["は"],["何","なん"],["一","いち"],["に"],["ひと"],["つ"],["できない"],["から"],["で"],["ある"],["。"]]},{"verse":6,"text":"人,ひとがわたしにつながっていないならば、枝,えだのように外,そとに投,なげすてられて枯,かれる。人々,ひとびとはそれをかき集,あつめ、火,ひに投,なげ入,いれて、焼,やいてしまうのである。","tok":[["人","ひと"],["が"],["わたし"],["に"],["つながって"],["いないならば"],["、"],["枝","えだ"],["の"],["よう"],["に"],["外","そと"],["に"],["投","なげ"],["すてられて"],["枯る","かれる"],["。"],["人々","ひとびと"],["は"],["それ"],["を"],["かき集め","かきあつめ"],["、"],["火","ひ"],["に"],["投入れて","なげいれて"],["、"],["焼いて","やいて"],["しまう"],["ので"],["ある"],["。"]]},{"verse":7,"text":"あなたがたがわたしにつながっており、わたしの言葉,ことばがあなたがたにとどまっているならば、なんでも望,のぞむものを求,もとめるがよい。そうすれば、与,あたえられるであろう。","tok":[["あなた"],["がた"],["が"],["わたし"],["に"],["つながって"],["おり"],["、"],["わたし"],["の"],["言葉","ことば"],["が"],["あなた"],["がた"],["に"],["とどまって"],["いるならば"],["、"],["なん"],["で"],["も"],["望む","のぞむ"],["もの"],["を"],["求める","もとめる"],["が"],["よい"],["。"],["そう"],["すれば"],["、"],["与えられるで","あたえられるで"],["あろう"],["。"]]},{"verse":8,"text":"あなたがたが実,みを豊,ゆたかに結,むすび、そしてわたしの弟子,でしとなるならば、それによって、わたしの父,ちちは栄光,えいこうをお受,うけになるであろう。","tok":[["あなた"],["がた"],["が"],["実","み"],["を"],["豊","ゆたか"],["に"],["結び","むすび"],["、"],["そして"],["わたし"],["の"],["弟子","でし"],["と"],["なるならば"],["、"],["それ"],["によって"],["、"],["わたし"],["の"],["父","ちち"],["は"],["栄光","えいこう"],["を"],["お受け","おうけ"],["に"],["なるで"],["あろう"],["。"]]},{"verse":9,"text":"父,ちちがわたしを愛,あいされたように、わたしもあなたがたを愛,あいしたのである。わたしの愛,あいのうちにいなさい。","tok":[["父","ちち"],["が"],["わたし"],["を"],["愛された","あいされた"],["よう"],["に"],["、"],["わたし"],["も"],["あなた"],["がた"],["を"],["愛した","あいした"],["ので"],["ある"],["。"],["わたし"],["の"],["愛","あい"],["の"],["うち"],["に"],["い"],["なさい"],["。"]]},{"verse":10,"text":"もしわたしのいましめを守,まもるならば、あなたがたはわたしの愛,あいのうちにおるのである。それはわたしがわたしの父,ちちのいましめを守,まもったので、その愛,あいのうちにおるのと同,おなじである。","tok":[["もし"],["わたし"],["の"],["いましめ"],["を"],["守","まもる"],["ならば"],["、"],["あなた"],["がた"],["は"],["わたし"],["の"],["愛","あい"],["の"],["うち"],["に"],["おる"],["ので"],["ある"],["。"],["それ"],["は"],["わたし"],["が"],["わたし"],["の"],["父","ちち"],["の"],["いましめ"],["を"],["守った","まもった"],["ので"],["、"],["その"],["愛","あい"],["の"],["うち"],["に"],["おる"],["の"],["と"],["同じ","おなじ"],["で"],["ある"],["。"]]},{"verse":11,"text":"わたしがこれらのことを話,はなしたのは、わたしの喜,よろこびがあなたがたのうちにも宿,やどるため、また、あなたがたの喜,よろこびが満,みちあふれるためである。","tok":[["わたし"],["が"],["これ"],["ら"],["の"],["こと"],["を"],["話","はなし"],["た"],["の"],["は"],["、"],["わたし"],["の"],["喜こび","よろこび"],["が"],["あなた"],["がた"],["の"],["うち"],["に"],["も"],["宿る","やどる"],["ため"],["、"],["また"],["、"],["あなた"],["がた"],["の"],["喜こび","よろこび"],["が"],["満ちあふれる","みちあふれる"],["ため"],["で"],["ある"],["。"]]},{"verse":12,"text":"わたしのいましめは、これである。わたしがあなたがたを愛,あいしたように、あなたがたも互,たがいに愛,あいし合,あいなさい。","tok":[["わたし"],["の"],["いましめ"],["は"],["、"],["これ"],["で"],["ある"],["。"],["わたし"],["が"],["あなた"],["がた"],["を"],["愛した","あいした"],["よう"],["に"],["、"],["あなた"],["がた"],["も"],["互","たがい"],["に"],["愛し合い","あいしあい"],["なさい"],["。"]]},{"verse":13,"text":"人,ひとがその友,とものために自分,じぶんの命,いのちを捨,すてること、これよりも大,おおきな愛,あいはない。","tok":[["人","ひと"],["が"],["その"],["友","とも"],["の"],["ため"],["に"],["自分","じぶん"],["の"],["命","いのち"],["を"],["捨てる","すてる"],["こと"],["、"],["これ"],["より"],["も"],["大きな","おおきな"],["愛","あい"],["は"],["ない"],["。"]]},{"verse":14,"text":"あなたがたにわたしが命,めいじることを行,おこなうならば、あなたがたはわたしの友,ともである。","tok":[["あなた"],["がた"],["に"],["わたし"],["が"],["命じる","めいじる"],["こと"],["を"],["行なうならば","おこなうならば"],["、"],["あなた"],["がた"],["は"],["わたし"],["の"],["友","とも"],["で"],["ある"],["。"]]},{"verse":15,"text":"わたしはもう、あなたがたを僕,しもべとは呼,よばない。僕,しもべは主人,しゅじんのしていることを知,しらないからである。わたしはあなたがたを友,ともと呼,よんだ。わたしの父,ちちから聞,きいたことを皆,みな、あなたがたに知,しらせたからである。","tok":[["わたし"],["は"],["もう"],["、"],["あなた"],["がた"],["を"],["僕","し"],["も"],["べ"],["と"],["は"],["呼ばない","よばない"],["。"],["僕","し"],["も"],["べ"],["は"],["主人","しゅじん"],["の"],["して"],["いる"],["こと"],["を"],["知らない","しらない"],["から"],["で"],["ある"],["。"],["わたし"],["は"],["あなた"],["がた"],["を"],["友","とも"],["と"],["呼んだ","よんだ"],["。"],["わたし"],["の"],["父","ちち"],["から"],["聞いた","きいた"],["こと"],["を"],["皆","みな"],["、"],["あなた"],["がた"],["に"],["知らせた","しらせた"],["から"],["で"],["ある"],["。"]]},{"verse":16,"text":"あなたがたがわたしを選,えらんだのではない。わたしがあなたがたを選,えらんだのである。そして、あなたがたを立,たてた。それは、あなたがたが行,いって実,みをむすび、その実,みがいつまでも残,のこるためであり、また、あなたがたがわたしの名,なによって父,ちちに求,もとめるものはなんでも、父,ちちが与,あたえて下,くださるためである。","tok":[["あなた"],["がた"],["が"],["わたし"],["を"],["選らんだ","えらんだ"],["ので"],["は"],["ない"],["。"],["わたし"],["が"],["あなた"],["がた"],["を"],["選らんだ","えらんだ"],["ので"],["ある"],["。"],["そして"],["、"],["あなた"],["がた"],["を"],["立てた","たてた"],["。"],["それ"],["は"],["、"],["あなた"],["がた"],["が"],["行って","いって"],["実","み"],["を"],["むすび"],["、"],["その"],["実","みがいつま"],["で"],["も"],["残る","のこる"],["ため"],["で"],["あり"],["、"],["また"],["、"],["あなた"],["がた"],["が"],["わたし"],["の"],["名","な"],["によって"],["父","ちち"],["に"],["求める","もとめる"],["もの"],["は"],["なん"],["で"],["も"],["、"],["父","ちち"],["が"],["与","あたえ"],["て"],["下さる","くださる"],["ため"],["で"],["ある"],["。"]]},{"verse":17,"text":"これらのことを命,めいじるのは、あなたがたが互,たがいに愛,あいし合,あうためである。","tok":[["これ"],["ら"],["の"],["こと"],["を"],["命じる","めいじる"],["の"],["は"],["、"],["あなた"],["がた"],["が"],["互","たがい"],["に"],["愛し合う","あいしあう"],["ため"],["で"],["ある"],["。"]]},{"verse":18,"text":"もしこの世,よがあなたがたを憎,にくむならば、あなたがたよりも先,さきにわたしを憎,にくんだことを、知,しっておくがよい。","tok":[["もし"],["この世","このよ"],["が"],["あなた"],["がた"],["を"],["憎むならば","にくむならば"],["、"],["あなた"],["が"],["たより"],["も"],["先","さき"],["に"],["わたし"],["を"],["憎んだ","にくんだ"],["こと"],["を"],["、"],["知って","しって"],["おく"],["が"],["よい"],["。"]]},{"verse":19,"text":"もしあなたがたがこの世,よから出,でたものであったなら、この世,よは、あなたがたを自分,じぶんのものとして愛,あいしたであろう。しかし、あなたがたはこの世,よのものではない。かえって、わたしがあなたがたをこの世,よから選,えらび出,だしたのである。だから、この世,よはあなたがたを憎,にくむのである。","tok":[["もし"],["あなた"],["がた"],["が"],["この世","このよ"],["から"],["出た","でた"],["もの"],["で"],["あったなら"],["、"],["この世","このよ"],["は"],["、"],["あなた"],["がた"],["を"],["自分","じぶん"],["の"],["もの"],["として"],["愛したで","あいしたで"],["あろう"],["。"],["しかし"],["、"],["あなた"],["がた"],["は"],["この世","このよ"],["の"],["もの"],["で"],["は"],["ない"],["。"],["かえって"],["、"],["わたし"],["が"],["あなた"],["がた"],["を"],["この世","このよ"],["から"],["選ら","えら"],["び"],["出した","だした"],["ので"],["ある"],["。"],["だ"],["から"],["、"],["この世","このよ"],["は"],["あなた"],["がた"],["を"],["憎む","にくむ"],["ので"],["ある"],["。"]]},{"verse":20,"text":"わたしがあなたがたに『僕,しもべはその主人,しゅじんにまさるものではない』と言,いったことを、おぼえていなさい。もし人々,ひとびとがわたしを迫害,はくがいしたなら、あなたがたをも迫害,はくがいするであろう。また、もし彼,かれらがわたしの言葉,ことばを守,まもっていたなら、あなたがたの言葉,ことばをも守,まもるであろう。","tok":[["わたし"],["が"],["あなた"],["がた"],["に"],["『"],["僕","し"],["も"],["べ"],["は"],["その"],["主人","しゅじん"],["に"],["まさる"],["もの"],["で"],["は"],["ない"],["』"],["と"],["言った","いった"],["こと"],["を"],["、"],["おぼえて"],["い"],["なさい"],["。"],["もし"],["人々","ひとびと"],["が"],["わたし"],["を"],["迫害","はくがい"],["したなら"],["、"],["あなた"],["がた"],["を"],["も"],["迫害","はくがい"],["するで"],["あろう"],["。"],["また"],["、"],["もし"],["彼","かれ"],["ら"],["が"],["わたし"],["の"],["言葉","ことば"],["を"],["守って","まもって"],["いたなら"],["、"],["あなた"],["がた"],["の"],["言葉","ことば"],["を"],["も"],["守","まもる"],["で"],["あろう"],["。"]]},{"verse":21,"text":"彼,かれらはわたしの名,なのゆえに、あなたがたに対,たいしてすべてそれらのことをするであろう。それは、わたしをつかわされたかたを彼,かれらが知,しらないからである。","tok":[["彼","かれ"],["ら"],["は"],["わたし"],["の"],["名","な"],["の"],["ゆえ"],["に"],["、"],["あなた"],["がた"],["に対して","にたいして"],["すべて"],["それ"],["ら"],["の"],["こと"],["を"],["するで"],["あろう"],["。"],["それ"],["は"],["、"],["わたし"],["を"],["つかわされた"],["かた"],["を"],["彼","かれ"],["ら"],["が"],["知らない","しらない"],["から"],["で"],["ある"],["。"]]},{"verse":22,"text":"もしわたしがきて彼,かれらに語,かたらなかったならば、彼,かれらは罪,つみを犯,おかさないですんだであろう。しかし今,いまとなっては、彼,かれらには、その罪,つみについて言,いいのがれる道,みちがない。","tok":[["もし"],["わたし"],["が"],["きて"],["彼","かれ"],["ら"],["に"],["語らなかったならば","かたらなかったならば"],["、"],["彼","かれ"],["ら"],["は"],["罪","つみ"],["を"],["犯さないです","おかさないです"],["ん"],["だで"],["あろう"],["。"],["しかし"],["今","いま"],["と"],["なって"],["は"],["、"],["彼","かれ"],["ら"],["に"],["は"],["、"],["その"],["罪","つみ"],["について"],["言いのがれる","いいのがれる"],["道","みち"],["が"],["ない"],["。"]]},{"verse":23,"text":"わたしを憎,にくむ者,ものは、わたしの父,ちちをも憎,にくむ。","tok":[["わたし"],["を"],["憎む","にくむ"],["者","もの"],["は"],["、"],["わたし"],["の"],["父","ちち"],["を"],["も"],["憎む","にくむ"],["。"]]},{"verse":24,"text":"もし、ほかのだれもがしなかったようなわざを、わたしが彼,かれらの間,あいだでしなかったならば、彼,かれらは罪,つみを犯,おかさないですんだであろう。しかし事実,じじつ、彼,かれらはわたしとわたしの父,ちちとを見,みて、憎,にくんだのである。","tok":[["もし"],["、"],["ほか"],["の"],["だれ"],["も"],["が"],["しなかった"],["よう"],["な"],["わざ"],["を"],["、"],["わたし"],["が"],["彼","かれ"],["ら"],["の"],["間","あいだ"],["で"],["しなかったならば"],["、"],["彼","かれ"],["ら"],["は"],["罪","つみ"],["を"],["犯さないです","おかさないです"],["ん"],["だで"],["あろう"],["。"],["しかし"],["事実","じじつ"],["、"],["彼","かれ"],["ら"],["は"],["わたし"],["と"],["わたし"],["の"],["父","ちち"],["と"],["を"],["見て","みて"],["、"],["憎","にくんだ"],["ので"],["ある"],["。"]]},{"verse":25,"text":"それは、『彼,かれらは理由,りゆうなしにわたしを憎,にくんだ』と書,かいてある彼,かれらの律法,りっぽうの言葉,ことばが成就,じょうじゅするためである。","tok":[["それ"],["は"],["、"],["『"],["彼","かれ"],["ら"],["は"],["理由","りゆう"],["なし"],["に"],["わたし"],["を"],["憎んだ","にくんだ"],["』"],["と"],["書いて","かいて"],["ある"],["彼","かれ"],["ら"],["の"],["律法","りっぽう"],["の"],["言葉","ことば"],["が"],["成就","じょうじゅ"],["する"],["ため"],["で"],["ある"],["。"]]},{"verse":26,"text":"わたしが父,ちちのみもとからあなたがたにつかわそうとしている助,たすけ主,ぬし、すなわち、父,ちちのみもとから来,くる真理,しんりの御霊,みたまが下,くだる時,とき、それはわたしについてあかしをするであろう。","tok":[["わたし"],["が"],["父","ちち"],["のみ"],["もと"],["から"],["あなた"],["がた"],["に"],["つかわそう"],["として"],["いる"],["助け主","たすけぬし"],["、"],["すなわち"],["、"],["父","ちち"],["のみ"],["もと"],["から"],["来る","くる"],["真理","しんり"],["の"],["御霊","み"],["たま"],["が"],["下る","くだる"],["時","とき"],["、"],["それ"],["は"],["わたし"],["について"],["あかし"],["を"],["するで"],["あろう"],["。"]]},{"verse":27,"text":"あなたがたも、初,はじめからわたしと一緒,いっしょにいたのであるから、あかしをするのである。","tok":[["あなた"],["がた"],["も"],["、"],["初め","はじめ"],["から"],["わたし"],["と"],["一緒","いっしょ"],["に"],["いた"],["ので"],["ある"],["から"],["、"],["あかし"],["を"],["する"],["ので"],["ある"],["。"]]}]
[{"verse":1,"text":"さて、ひとりの病人,びょうにんがいた。ラザロといい、マリヤとその姉妹,しまいマルタの村,むらベタニヤの人,ひとであった。","tok":[["さて"],["、"],["ひとり"],["の"],["病人","びょうにん"],["が"],["いた"],["。"],["ラザロ"],["と"],["いい"],["、"],["マリヤ"],["と"],["その"],["姉妹","しまい"],["マルタ"],["の"],["村","むら"],["ベタニヤ"],["の"],["人","ひと"],["で"],["あった"],["。"]]},{"verse":2,"text":"このマリヤは主,しゅに香油,こうゆをぬり、自分,じぶんの髪,かみの毛,けで、主,しゅの足,あしをふいた女,おんなであって、病気,びょうきであったのは、彼女,かのじょの兄弟,きょうだいラザロであった。","tok":[["この"],["マリヤ"],["は"],["主に","しゅに"],["香油","こうゆ"],["を"],["ぬり"],["、"],["自分","じぶん"],["の"],["髪の毛","かみのけ"],["で"],["、"],["主","しゅ"],["の"],["足","あし"],["を"],["ふいた"],["女","おんな"],["で"],["あって"],["、"],["病気","びょうき"],["で"],["あった"],["の"],["は"],["、"],["彼女","かのじょ"],["の"],["兄弟","きょうだい"],["ラザロ"],["で"],["あった"],["。"]]},{"verse":3,"text":"姉妹,しまいたちは人,ひとをイエスのもとにつかわして、「主,しゅよ、ただ今,いま、あなたが愛,あいしておられる者,ものが病気,びょうきをしています」と言,いわせた。","tok":[["姉妹","しまい"],["たち"],["は"],["人","ひと"],["を"],["イエス"],["の"],["もと"],["に"],["つかわして"],["、"],["「"],["主","しゅ"],["よ"],["、"],["ただ"],["今","いま"],["、"],["あなた"],["が"],["愛して","あいして"],["おられる"],["者","もの"],["が"],["病気","びょうき"],["を"],["して"],["います"],["」"],["と"],["言わせた","いわせた"],["。"]]},{"verse":4,"text":"イエスはそれを聞,きいて言,いわれた、「この病気,びょうきは死,しぬほどのものではない。それは神,かみの栄光,えいこうのため、また、神,かみの子,こがそれによって栄光,えいこうを受,うけるためのものである」。","tok":[["イエス"],["は"],["それ"],["を"],["聞いて","きいて"],["言われた","いわれた"],["、"],["「"],["この"],["病気","びょうき"],["は"],["死ぬ","しぬ"],["ほど"],["の"],["もの"],["で"],["は"],["ない"],["。"],["それ"],["は"],["神","かみ"],["の"],["栄光","えいこう"],["の"],["ため"],["、"],["また"],["、"],["神","かみ"],["の"],["子","こ"],["が"],["それ"],["によって"],["栄光","えいこう"],["を"],["受る","うける"],["ため"],["の"],["もの"],["で"],["ある"],["」"],["。"]]},{"verse":5,"text":"イエスは、マルタとその姉妹,しまいとラザロとを愛,あいしておられた。","tok":[["イエス"],["は"],["、"],["マルタ"],["と"],["その"],["姉妹","しまい"],["と"],["ラザロ"],["と"],["を"],["愛して","あいして"],["おられた"],["。"]]},{"verse":6,"text":"ラザロが病気,びょうきであることを聞,きいてから、なおふつか、そのおられた所,ところに滞在,たいざいされた。","tok":[["ラザロ"],["が"],["病気","びょうき"],["で"],["ある"],["こと"],["を"],["聞いて","きいて"],["から"],["、"],["なお"],["ふ"],["つ"],["か"],["、"],["その"],["おられた"],["所","ところ"],["に"],["滞在","たいざい"],["された"],["。"]]},{"verse":7,"text":"それから弟子,でしたちに、「もう一度,どユダヤに行,いこう」と言,いわれた。","tok":[["それ"],["から"],["弟子","でし"],["たち"],["に"],["、"],["「"],["もう"],["一度","ど"],["ユダヤ"],["に"],["行こう","いこう"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":8,"text":"弟子,でしたちは言,いった、「先生,せんせい、ユダヤ人,じんらが、さきほどもあなたを石,いしで殺,ころそうとしていましたのに、またそこに行,いかれるのですか」。","tok":[["弟子","でし"],["たち"],["は"],["言った","いった"],["、"],["「"],["先生","せんせい"],["、"],["ユダヤ人","ゆだやじん"],["ら"],["が"],["、"],["さきほど"],["も"],["あなた"],["を"],["石","いし"],["で"],["殺そう","ころそう"],["として"],["いました"],["のに"],["、"],["また"],["そこ"],["に"],["行かれる","いかれる"],["の"],["です"],["か"],["」"],["。"]]},{"verse":9,"text":"イエスは答,こたえられた、「一日,にちには十二時間,じかんあるではないか。昼間,ひるまあるけば、人,ひとはつまずくことはない。この世,よの光,ひかりを見,みているからである。","tok":[["イエス"],["は"],["答","こたえ"],["られた"],["、"],["「"],["一","いち"],["日","にち"],["に"],["は"],["十二","じゅうに"],["時間","じかん"],["で"],["は"],["ない"],["か"],["。"],["昼間","ひるま"],["あるけば"],["、"],["人","ひと"],["は"],["つまずく"],["こと"],["は"],["ない"],["。"],["この世","このよ"],["の"],["光","ひかり"],["を"],["見て","みて"],["いる"],["から"],["で"],["ある"],["。"]]},{"verse":10,"text":"しかし、夜,よるあるけば、つまずく。その人,ひとのうちに、光,ひかりがないからである」。","tok":[["しかし"],["、"],["夜","よる"],["あるけば"],["、"],["つまずく"],["。"],["その"],["人","ひと"],["の"],["うち"],["に"],["、"],["光","ひかり"],["が"],["ない"],["から"],["で"],["ある"],["」"],["。"]]},{"verse":11,"text":"そう言,いわれたが、それからまた、彼,かれらに言,いわれた、「わたしたちの友,ともラザロが眠,ねむっている。わたしは彼,かれを起,おこしに行,いく」。","tok":[["そう"],["言われた","いわれた"],["が"],["、"],["それ"],["から"],["また"],["、"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["わたしたち"],["の"],["友","とも"],["ラザロ"],["が"],["眠って","ねむって"],["いる"],["。"],["わたし"],["は"],["彼","かれ"],["を"],["起こし","おこし"],["に"],["行く","いく"],["」"],["。"]]},{"verse":12,"text":"すると弟子,でしたちは言,いった、「主,しゅよ、眠,ねむっているのでしたら、助,たすかるでしょう」。","tok":[["する"],["と"],["弟子","でし"],["たち"],["は"],["言った","いった"],["、"],["「"],["主","しゅ"],["よ"],["、"],["眠って","ねむって"],["いる"],["の"],["でしたら"],["、"],["助かるでしょう","たすかるでしょう"],["」"],["。"]]},{"verse":13,"text":"イエスはラザロが死,しんだことを言,いわれたのであるが、弟子,でしたちは、眠,ねむって休,やすんでいることをさして言,いわれたのだと思,おもった。","tok":[["イエス"],["は"],["ラザロ"],["が"],["死んだ","しんだ"],["こと"],["を"],["言われた","いわれた"],["ので"],["ある"],["が"],["、"],["弟子","でし"],["たち"],["は"],["、"],["眠って","ねむって"],["休んで","やすんで"],["いる"],["こと"],["を"],["さして"],["言われた","いわれた"],["の"],["だ"],["と"],["思った","おもった"],["。"]]},{"verse":14,"text":"するとイエスは、あからさまに彼,かれらに言,いわれた、「ラザロは死,しんだのだ。","tok":[["する"],["と"],["イエス"],["は"],["、"],["あからさま"],["に"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["ラザロ"],["は"],["死んだ","しんだ"],["の"],["だ"],["。"]]},{"verse":15,"text":"そして、わたしがそこにいあわせなかったことを、あなたがたのために喜,よろこぶ。それは、あなたがたが信,しんじるようになるためである。では、彼,かれのところに行,いこう」。","tok":[["そして"],["、"],["わたし"],["が"],["そこ"],["に"],["いあわせなかった"],["こと"],["を"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["喜こぶ","よろこぶ"],["。"],["それ"],["は"],["、"],["あなた"],["がた"],["が"],["信じる","しんじる"],["よう"],["に"],["なる"],["ため"],["で"],["ある"],["。"],["で"],["は"],["、"],["彼","かれ"],["の"],["ところ"],["に"],["行こう","いこう"],["」"],["。"]]},{"verse":16,"text":"するとデドモと呼,よばれているトマスが、仲間,なかまの弟子,でしたちに言,いった、「わたしたちも行,いって、先生,せんせいと一緒,いっしょに死,しのうではないか」。","tok":[["する"],["と"],["デドモ"],["と"],["呼ばれて","よばれて"],["いる"],["トマス"],["が"],["、"],["仲間","なかま"],["の"],["弟子","でし"],["たち"],["に"],["言った","いった"],["、"],["「"],["わたしたち"],["も"],["行って","いって"],["、"],["先生","せんせい"],["と"],["一緒","いっしょ"],["に"],["死のうで","しのうで"],["は"],["ない"],["か"],["」"],["。"]]},{"verse":17,"text":"さて、イエスが行,いってごらんになると、ラザロはすでに四日間,かかんも墓,はかの中,なかに置,おかれていた。","tok":[["さて"],["、"],["イエス"],["が"],["行って","いって"],["ごらん"],["に"],["なる"],["と"],["、"],["ラザロ"],["は"],["すでに"],["四","よん"],["日間","かかん"],["も"],["墓","はか"],["の"],["中","なか"],["に"],["置かれて","おかれて"],["いた"],["。"]]},{"verse":18,"text":"ベタニヤはエルサレムに近,ちかく、二十五丁,ちょうばかり離,はなれたところにあった。","tok":[["ベタニヤ"],["は"],["エルサレム"],["に"],["近く","ちかく"],["、"],["二","に"],["十五丁","じゅうごちょう"],["う"],["ばかり"],["離れた","はなれた"],["ところ"],["に"],["あった"],["。"]]},{"verse":19,"text":"大,おおぜいのユダヤ人,じんが、その兄弟,きょうだいのことで、マルタとマリヤとを慰,なぐさめようとしてきていた。","tok":[["大ぜい","おおぜい"],["の"],["ユダヤ人","ゆだやじん"],["が"],["、"],["その"],["兄弟","きょうだい"],["の"],["こと"],["で"],["、"],["マルタ"],["と"],["マリヤ"],["と"],["を"],["慰さめよう","なぐさめよう"],["として"],["きて"],["いた"],["。"]]},{"verse":20,"text":"マルタはイエスがこられたと聞,きいて、出迎,でむかえに行,いったが、マリヤは家,いえですわっていた。","tok":[["マルタ"],["は"],["イエス"],["が"],["こられた"],["と"],["聞いて","きいて"],["、"],["出迎","でむかえ"],["に"],["行った","いった"],["が"],["、"],["マリヤ"],["は"],["家","いえ"],["で"],["すわって"],["いた"],["。"]]},{"verse":21,"text":"マルタはイエスに言,いった、「主,しゅよ、もしあなたがここにいて下,くださったなら、わたしの兄弟,きょうだいは死,しななかったでしょう。","tok":[["マルタ"],["は"],["イエス"],["に"],["言った","いった"],["、"],["「"],["主","しゅ"],["よ"],["、"],["もし"],["あなた"],["が"],["ここ"],["に"],["いて"],["下さったなら","くださったなら"],["、"],["わたし"],["の"],["兄弟","きょうだい"],["は"],["死ななかったでしょう","しななかったでしょう"],["。"]]},{"verse":22,"text":"しかし、あなたがどんなことをお願,ねがいになっても、神,かみはかなえて下,くださることを、わたしは今,いまでも存,ぞんじています」。","tok":[["しかし"],["、"],["あなた"],["が"],["どんな"],["こと"],["を"],["お願い","おねがい"],["に"],["なって"],["も"],["、"],["神","かみ"],["は"],["かなえて"],["下さる","くださる"],["こと"],["を"],["、"],["わたし"],["は"],["今","いま"],["で"],["も"],["存じて","ぞんじて"],["います"],["」"],["。"]]},{"verse":23,"text":"イエスはマルタに言,いわれた、「あなたの兄弟,きょうだいはよみがえるであろう」。","tok":[["イエス"],["は"],["マルタ"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["の"],["兄弟","きょうだい"],["は"],["よみがえるで"],["あろう"],["」"],["。"]]},{"verse":24,"text":"マルタは言,いった、「終,おわりの日,ひのよみがえりの時,ときよみがえることは、存,ぞんじています」。","tok":[["マルタ"],["は"],["言った","いった"],["、"],["「"],["終","おわり"],["の"],["日","ひ"],["の"],["よみがえり"],["の"],["時","とき"],["よみがえる"],["こと"],["は"],["、"],["存じて","ぞんじて"],["います"],["」"],["。"]]},{"verse":25,"text":"イエスは彼女,かのじょに言,いわれた、「わたしはよみがえりであり、命,いのちである。わたしを信,しんじる者,ものは、たとい死,しんでも生,いきる。","tok":[["イエス"],["は"],["彼女","かのじょ"],["に"],["言われた","いわれた"],["、"],["「"],["わたし"],["は"],["よみがえりで"],["あり"],["、"],["命","いのち"],["で"],["ある"],["。"],["わたし"],["を"],["信じる","しんじる"],["者","もの"],["は"],["、"],["たとい"],["死んで","しんで"],["も"],["生きる","いきる"],["。"]]},{"verse":26,"text":"また、生,いきていて、わたしを信,しんじる者,ものは、いつまでも死,しなない。あなたはこれを信,しんじるか」。","tok":[["また"],["、"],["生きて","いきて"],["いて"],["、"],["わたし"],["を"],["信じる","しんじる"],["者","もの"],["は"],["、"],["いつ"],["まで"],["も"],["死なない","しなない"],["。"],["あなた"],["は"],["これ"],["を"],["信じる","しんじる"],["か"],["」"],["。"]]},{"verse":27,"text":"マルタはイエスに言,いった、「主,しゅよ、信,しんじます。あなたがこの世,よにきたるべきキリスト、神,かみの御子,みこであると信,しんじております」。","tok":[["マルタ"],["は"],["イエス"],["に"],["言った","いった"],["、"],["「"],["主","しゅ"],["よ"],["、"],["信じます","しんじます"],["。"],["あなた"],["が"],["この世","このよ"],["に"],["きたるべき"],["キリスト"],["、"],["神","かみ"],["の"],["御子","みこ"],["で"],["ある"],["と"],["信じて","しんじて"],["おります"],["」"],["。"]]},{"verse":28,"text":"マルタはこう言,いってから、帰,かえって姉妹,しまいのマリヤを呼,よび、「先生,せんせいがおいでになって、あなたを呼,よんでおられます」と小声,こごえで言,いった。","tok":[["マルタ"],["は"],["こう"],["言って","いって"],["から"],["、"],["帰えって","かえって"],["姉妹","しまい"],["の"],["マリヤ"],["を"],["呼び","よび"],["、"],["「"],["先生","せんせい"],["が"],["おいで"],["に"],["なって"],["、"],["あなた"],["を"],["呼んで","よんで"],["おられます"],["」"],["と"],["小声","こごえ"],["で"],["言った","いった"],["。"]]},{"verse":29,"text":"これを聞,きいたマリヤはすぐ立,たち上,あがって、イエスのもとに行,いった。","tok":[["これ"],["を"],["聞いた","きいた"],["マリヤ"],["は"],["すぐ"],["立ち上がって","たちあがって"],["、"],["イエス"],["の"],["もと"],["に"],["行った","いった"],["。"]]},{"verse":30,"text":"イエスはまだ村,むらに、はいってこられず、マルタがお迎,むかえしたその場所,ばしょにおられた。","tok":[["イエス"],["は"],["まだ"],["村","むら"],["に"],["、"],["はいって"],["こられず"],["、"],["マルタ"],["が"],["お"],["迎","むかえ"],["した"],["その"],["場所","ばしょ"],["に"],["おられた"],["。"]]},{"verse":31,"text":"マリヤと一緒,いっしょに家,いえにいて彼女,かのじょを慰,なぐさめていたユダヤ人,じんたちは、マリヤが急,いそいで立,たち上,あがって出,でて行,いくのを見,みて、彼女,かのじょは墓,はかに泣,なきに行,いくのであろうと思,おもい、そのあとからついて行,いった。","tok":[["マリヤ"],["と"],["一緒","いっしょ"],["に"],["家","いえ"],["に"],["いて"],["彼女","かのじょ"],["を"],["慰さめて","なぐさめて"],["いた"],["ユダヤ人","ゆだやじん"],["たち"],["は"],["、"],["マリヤ"],["が"],["急いで","いそいで"],["立ち上がって","たちあがって"],["出て","でて"],["行く","いく"],["の"],["を"],["見て","みて"],["、"],["彼女","かのじょ"],["は"],["墓","はか"],["に"],["泣","なき"],["に"],["行く","いく"],["ので"],["あろう"],["と"],["思い","おもい"],["、"],["その"],["あと"],["から"],["ついて"],["行った","いった"],["。"]]},{"verse":32,"text":"マリヤは、イエスのおられる所,ところに行,いってお目,めにかかり、その足,あしもとにひれ伏,ふして言,いった、「主,しゅよ、もしあなたがここにいて下,くださったなら、わたしの兄弟,きょうだいは死,しななかったでしょう」。","tok":[["マリヤ"],["は"],["、"],["イエス"],["の"],["おられる"],["所","ところ"],["に"],["行って","いって"],["お目","おめ"],["に"],["かかり"],["、"],["その"],["足もと","あしもと"],["に"],["ひれ伏して","ひれふして"],["言った","いった"],["、"],["「"],["主","しゅ"],["よ"],["、"],["もし"],["あなた"],["が"],["ここ"],["に"],["いて"],["下さったなら","くださったなら"],["、"],["わたし"],["の"],["兄弟","きょうだい"],["は"],["死ななかったでしょう","しななかったでしょう"],["」"],["。"]]},{"verse":33,"text":"イエスは、彼女,かのじょが泣,なき、また、彼女,かのじょと一緒,いっしょにきたユダヤ人,じんたちも泣,ないているのをごらんになり、激,はげしく感動,かんどうし、また心,こころを騒,さわがせ、そして言,いわれた、","tok":[["イエス"],["は"],["、"],["彼女","かのじょ"],["が"],["泣","なき"],["、"],["また"],["、"],["彼女","かのじょ"],["と"],["一緒","いっしょ"],["に"],["きた"],["ユダヤ人","ゆだやじん"],["たち"],["も"],["泣いて","ないて"],["いる"],["の"],["を"],["ごらん"],["に"],["なり"],["、"],["激しく","はげしく"],["感動","かんどう"],["し"],["、"],["また"],["心","こころ"],["を"],["騒がせ","さわがせ"],["、"],["そして"],["言われた","いわれた"],["、"]]},{"verse":34,"text":"「彼,かれをどこに置,おいたのか」。彼,かれらはイエスに言,いった、「主,しゅよ、きて、ごらん下,ください」。","tok":[["「"],["彼","かれ"],["を"],["どこ"],["に"],["置いた","おいた"],["の"],["か"],["」"],["。"],["彼","かれ"],["ら"],["は"],["イエス"],["に"],["言った","いった"],["、"],["「"],["主","しゅ"],["よ"],["、"],["きて"],["、"],["ごらん"],["下さい","ください"],["」"],["。"]]},{"verse":35,"text":"イエスは涙,なみだを流,ながされた。","tok":[["イエス"],["は"],["涙","なみだ"],["を"],["流された","ながされた"],["。"]]},{"verse":36,"text":"するとユダヤ人,じんたちは言,いった、「ああ、なんと彼,かれを愛,あいしておられたことか」。","tok":[["する"],["と"],["ユダヤ人","ゆだやじん"],["たち"],["は"],["言った","いった"],["、"],["「"],["ああ"],["、"],["なん"],["と"],["彼","かれ"],["を"],["愛して","あいして"],["おられた"],["こと"],["か"],["」"],["。"]]},{"verse":37,"text":"しかし、彼,かれらのある人,ひとたちは言,いった、「あの盲人,もうじんの目,めをあけたこの人,ひとでも、ラザロを死,しなせないようには、できなかったのか」。","tok":[["しかし"],["、"],["彼","かれ"],["ら"],["の"],["ある"],["人","ひと"],["たち"],["は"],["言った","いった"],["、"],["「"],["あの"],["盲人","もうじん"],["の"],["目","め"],["を"],["あけた"],["この"],["人","ひと"],["で"],["も"],["、"],["ラザロ"],["を"],["死なせない","しなせない"],["よう"],["に"],["は"],["、"],["できなかった"],["の"],["か"],["」"],["。"]]},{"verse":38,"text":"イエスはまた激,はげしく感動,かんどうして、墓,はかにはいられた。それは洞穴,ほらあなであって、そこに石,いしがはめてあった。","tok":[["イエス"],["は"],["また"],["激しく","はげしく"],["感動","かんどう"],["して"],["、"],["墓","はか"],["に"],["は"],["いられた"],["。"],["それ"],["は"],["洞穴","ほらあな"],["で"],["あって"],["、"],["そこ"],["に"],["石","いし"],["が"],["はめて"],["あった"],["。"]]},{"verse":39,"text":"イエスは言,いわれた、「石,いしを取,とりのけなさい」。死,しんだラザロの姉妹,しまいマルタが言,いった、「主,しゅよ、もう臭,くさくなっております。四日,かもたっていますから」。","tok":[["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["石","いし"],["を"],["取","とり"],["のけ"],["なさい"],["」"],["。"],["死んだ","しんだ"],["ラザロ"],["の"],["姉妹","しまい"],["マルタ"],["が"],["言った","いった"],["、"],["「"],["主","しゅ"],["よ"],["、"],["もう"],["臭く","くさく"],["なって"],["おります"],["。"],["四日","か"],["も"],["たって"],["います"],["から"],["」"],["。"]]},{"verse":40,"text":"イエスは彼女,かのじょに言,いわれた、「もし信,しんじるなら神,かみの栄光,えいこうを見,みるであろうと、あなたに言,いったではないか」。","tok":[["イエス"],["は"],["彼女","かのじょ"],["に"],["言われた","いわれた"],["、"],["「"],["もし"],["信じるなら","しんじるなら"],["神","かみ"],["の"],["栄光","えいこう"],["を"],["見るで","みるで"],["あろう"],["と"],["、"],["あなた"],["に"],["言ったで","いったで"],["は"],["ない"],["か"],["」"],["。"]]},{"verse":41,"text":"人々,ひとびとは石,いしを取,とりのけた。すると、イエスは目,めを天,てんにむけて言,いわれた、「父,ちちよ、わたしの願,ねがいをお聞,きき下,くださったことを感謝,かんしゃします。","tok":[["人々","ひとびと"],["は"],["石","いし"],["を"],["取","とり"],["のけた"],["。"],["する"],["と"],["、"],["イエス"],["は"],["目","め"],["を"],["天","てん"],["に"],["むけて"],["言われた","いわれた"],["、"],["「"],["父","ちち"],["よ"],["、"],["わたし"],["の"],["願い","ねがい"],["を"],["お聞","おきき"],["下さった","くださった"],["こと"],["を"],["感謝","かんしゃ"],["します"],["。"]]},{"verse":42,"text":"あなたがいつでもわたしの願,ねがいを聞,ききいれて下,くださることを、よく知,しっています。しかし、こう申,もうしますのは、そばに立,たっている人々,ひとびとに、あなたがわたしをつかわされたことを、信,しんじさせるためであります」。","tok":[["あなた"],["が"],["いつ"],["で"],["も"],["わたし"],["の"],["願い","ねがい"],["を"],["聞きいれて","ききいれて"],["下さる","くださる"],["こと"],["を"],["、"],["よく"],["知って","しって"],["います"],["。"],["しかし"],["、"],["こう"],["申します","もうします"],["の"],["は"],["、"],["そば"],["に"],["立って","たって"],["いる"],["人々","ひとびと"],["に"],["、"],["あなた"],["が"],["わたし"],["を"],["つかわされた"],["こと"],["を"],["、"],["信じさせる","しんじさせる"],["ため"],["で"],["あります"],["」"],["。"]]},{"verse":43,"text":"こう言,いいながら、大声,おおごえで「ラザロよ、出,でてきなさい」と呼,よばわれた。","tok":[["こう"],["言い","いい"],["ながら"],["、"],["大声","おおごえ"],["で"],["「"],["ラザロ"],["よ"],["、"],["出て","でて"],["き"],["なさい"],["」"],["と"],["呼ばわれた","よばわれた"],["。"]]},{"verse":44,"text":"すると、死人,しにんは手足,てあしを布,ぬのでまかれ、顔,かおも顔,かおおおいで包,つつまれたまま、出,でてきた。イエスは人々,ひとびとに言,いわれた、「彼,かれをほどいてやって、帰,かえらせなさい」。","tok":[["する"],["と"],["、"],["死人","しにん"],["は"],["手足","てあし"],["を"],["布","ぬの"],["で"],["まかれ"],["、"],["顔","かお"],["も"],["顔","かお"],["おおい"],["で"],["包まれた","つつまれた"],["まま"],["、"],["出て","でて"],["きた"],["。"],["イエス"],["は"],["人々","ひとびと"],["に"],["言われた","いわれた"],["、"],["「"],["彼","かれ"],["を"],["ほどいて"],["やって"],["、"],["帰えらせ","かえらせ"],["なさい"],["」"],["。"]]},{"verse":45,"text":"マリヤのところにきて、イエスのなさったことを見,みた多,おおくのユダヤ人,じんたちは、イエスを信,しんじた。","tok":[["マリヤ"],["の"],["ところ"],["に"],["きて"],["、"],["イエス"],["の"],["なさった"],["こと"],["を"],["見た","みた"],["多く","おおく"],["の"],["ユダヤ人","ゆだやじん"],["たち"],["は"],["、"],["イエス"],["を"],["信じた","しんじた"],["。"]]},{"verse":46,"text":"しかし、そのうちの数人,すうにんがパリサイ人,びとたちのところに行,いって、イエスのされたことを告,つげた。","tok":[["しかし"],["、"],["その"],["うち"],["の"],["数人","すうにん"],["が"],["パリサイ"],["人","びとたち"],["の"],["ところ"],["に"],["行って","いって"],["、"],["イエス"],["の"],["された"],["こと"],["を"],["告","つげ"],["た"],["。"]]},{"verse":47,"text":"そこで、祭司長,さいしちょうたちとパリサイ人,びとたちとは、議会,ぎかいを召集,しょうしゅうして言,いった、「この人,ひとが多,おおくのしるしを行,おこなっているのに、お互,たがいは何,なにをしているのだ。","tok":[["そこ"],["で"],["、"],["祭司長","さいしちょう"],["たち"],["と"],["パリサイ"],["人","びと"],["たち"],["と"],["は"],["、"],["議会","ぎかい"],["を"],["召集","しょうしゅう"],["して"],["言った","いった"],["、"],["「"],["この"],["人","ひと"],["が"],["多く","おおく"],["の"],["しるし"],["を"],["行なって","おこなって"],["いる"],["のに"],["、"],["お互","おたがい"],["は"],["何に","なに"],["を"],["して"],["いる"],["の"],["だ"],["。"]]},{"verse":48,"text":"もしこのままにしておけば、みんなが彼,かれを信,しんじるようになるだろう。そのうえ、ローマ人,じんがやってきて、わたしたちの土地,とちも人民,じんみんも奪,うばってしまうであろう」。","tok":[["もし"],["この"],["まま"],["に"],["して"],["おけば"],["、"],["みんな"],["が"],["彼","かれ"],["を"],["信じる","しんじる"],["よう"],["に"],["なるだろう"],["。"],["その"],["うえ"],["、"],["ローマ人","ろーまじん"],["が"],["やって"],["きて"],["、"],["わたしたち"],["の"],["土地","とち"],["も"],["人民","じんみん"],["も"],["奪って","うばって"],["しまうで"],["あろう"],["」"],["。"]]},{"verse":49,"text":"彼,かれらのうちのひとりで、その年,としの大祭司,だいさいしであったカヤパが、彼,かれらに言,いった、「あなたがたは、何,なにもわかっていないし、","tok":[["彼","かれ"],["ら"],["の"],["うち"],["の"],["ひとり"],["で"],["、"],["その"],["年","とし"],["の"],["大","だい"],["祭司","さいし"],["で"],["あった"],["カヤパ"],["が"],["、"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["、"],["何に","なに"],["も"],["わかって"],["いない"],["し"],["、"]]},{"verse":50,"text":"ひとりの人,ひとが人民,じんみんに代,かわって死,しんで、全国民,ぜんこくみんが滅,ほろびないようになるのがわたしたちにとって得,えだということを、考,かんがえてもいない」。","tok":[["ひとり"],["の"],["人","ひと"],["が"],["人民","じんみん"],["に"],["代わって","かわって"],["死んで","しんで"],["、"],["全","ぜん"],["国民","こくみん"],["が"],["滅びない","ほろびない"],["よう"],["に"],["なる"],["の"],["が"],["わたしたち"],["にとって"],["得","えだ"],["と"],["いう"],["こと"],["を"],["、"],["考","かんがえ"],["て"],["も"],["いない"],["」"],["。"]]},{"verse":51,"text":"このことは彼,かれが自分,じぶんから言,いったのではない。彼,かれはこの年,としの大祭司,だいさいしであったので、預言,よげんをして、イエスが国民,こくみんのために、","tok":[["この"],["こと"],["は"],["彼","かれ"],["が"],["自分","じぶん"],["から"],["言った","いった"],["ので"],["は"],["ない"],["。"],["彼","かれ"],["は"],["この"],["年","とし"],["の"],["大","だい"],["祭司","さいし"],["で"],["あった"],["ので"],["、"],["預言","よげん"],["を"],["して"],["、"],["イエス"],["が"],["国民","こくみん"],["の"],["ため"],["に"],["、"]]},{"verse":52,"text":"ただ国民,こくみんのためだけではなく、また散在,さんざいしている神,かみの子,こらを一つに集,あつめるために、死,しぬことになっていると、言,いったのである。","tok":[["ただ"],["国民","こくみん"],["の"],["ため"],["だけ"],["で"],["は"],["なく"],["、"],["また"],["散在","さんざい"],["して"],["いる"],["神","かみ"],["の"],["子","こ"],["ら"],["を"],["一","ひと"],["つ"],["に"],["集める","あつめる"],["ため"],["に"],["、"],["死ぬ","しぬ"],["こと"],["に"],["なって"],["いる"],["と"],["、"],["言った","いった"],["ので"],["ある"],["。"]]},{"verse":53,"text":"彼,かれらはこの日,ひからイエスを殺,ころそうと相談,そうだんした。","tok":[["彼","かれ"],["ら"],["は"],["この"],["日","ひ"],["から"],["イエス"],["を"],["殺そう","ころそう"],["と"],["相談","そうだん"],["した"],["。"]]},{"verse":54,"text":"そのためイエスは、もはや公然,こうぜんとユダヤ人,じんの間,あいだを歩,あるかないで、そこを出,でて、荒野,あらのに近,ちかい地方,ちほうのエフライムという町,まちに行,いかれ、そこに弟子,でしたちと一緒,いっしょに滞在,たいざいしておられた。","tok":[["その"],["ため"],["イエス"],["は"],["、"],["もはや"],["公然","こうぜん"],["と"],["ユダヤ人","ゆだやじん"],["の"],["間","あいだ"],["を"],["歩かないで","あるかないで"],["、"],["そこ"],["を"],["出て","でて"],["、"],["荒野","あら"],["のに"],["近い","ちかい"],["地方","ちほう"],["の"],["エフライム"],["と"],["いう"],["町","まち"],["に"],["行かれ","いかれ"],["、"],["そこ"],["に"],["弟子","でし"],["たち"],["と"],["一緒","いっしょ"],["に"],["滞在","たいざい"],["して"],["おられた"],["。"]]},{"verse":55,"text":"さて、ユダヤ人,じんの過越,すぎこしの祭,まつりが近,ちかづいたので、多,おおくの人々,ひとびとは身,みをきよめるために、祭,まつりの前,まえに、地方,ちほうからエルサレムへ上,のぼった。","tok":[["さて"],["、"],["ユダヤ人","ゆだやじん"],["の"],["過越","すぎこし"],["の"],["祭","まつり"],["が"],["近づいた","ちかづいた"],["ので"],["、"],["多く","おおく"],["の"],["人々","ひとびと"],["は"],["身","み"],["を"],["きよめる"],["ため"],["に"],["、"],["祭","まつり"],["の"],["前","まえ"],["に"],["、"],["地方","ちほう"],["から"],["エルサレム"],["へ"],["上った","のぼった"],["。"]]},{"verse":56,"text":"人々,ひとびとはイエスを捜,さがし求,もとめ、宮,みやの庭,にわに立,たって互,たがいに言,いった、「あなたがたはどう思,おもうか。イエスはこの祭,まつりにこないのだろうか」。","tok":[["人々","ひとびと"],["は"],["イエス"],["を"],["捜し求め","さがしもとめ"],["、"],["宮","みや"],["の"],["庭","にわ"],["に"],["立って","たって"],["互","たがい"],["に"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["どう"],["思","おもう"],["か"],["。"],["イエス"],["は"],["この"],["祭","まつり"],["に"],["こない"],["の"],["だろう"],["か"],["」"],["。"]]},{"verse":57,"text":"祭司長,さいしちょうたちとパリサイ人,びとたちとは、イエスを捕,とらえようとして、そのいどころを知,しっている者,ものがあれば申,もうし出,でよ、という指令,しれいを出,だしていた。","tok":[["祭司長","さいしちょう"],["たち"],["と"],["パリサイ"],["人","びと"],["たち"],["と"],["は"],["、"],["イエス"],["を"],["捕らえよう","とらえよう"],["として"],["、"],["その"],["いどころ"],["を"],["知って","しって"],["いる"],["者","もの"],["が"],["あれば"],["申し出よ","もうしでよ"],["、"],["と"],["いう"],["指令","しれい"],["を"],["出して","だして"],["いた"],["。"]]}]
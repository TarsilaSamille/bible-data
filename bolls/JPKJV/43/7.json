[{"verse":1,"text":"そののち、イエスはガリラヤを巡回,じゅんかいしておられた。ユダヤ人,じんたちが自分,じぶんを殺,ころそうとしていたので、ユダヤを巡回,じゅんかいしようとはされなかった。","tok":[["その"],["のち"],["、"],["イエス"],["は"],["ガリラヤ"],["を"],["巡回","じゅんかい"],["して"],["おられた"],["。"],["ユダヤ人","ゆだやじん"],["たち"],["が"],["自分","じぶん"],["を"],["殺そう","ころそう"],["として"],["いた"],["ので"],["、"],["ユダヤ"],["を"],["巡回","じゅんかい"],["しよう"],["と"],["は"],["されなかった"],["。"]]},{"verse":2,"text":"時,ときに、ユダヤ人,じんの仮庵,かりいおの祭,まつりが近,ちかづいていた。","tok":[["時","とき"],["に"],["、"],["ユダヤ人","ゆだやじん"],["の"],["仮庵","かりいお"],["の"],["祭","まつり"],["が"],["近づいて","ちかづいて"],["いた"],["。"]]},{"verse":3,"text":"そこで、イエスの兄弟,きょうだいたちがイエスに言,いった、「あなたがしておられるわざを弟子,でしたちにも見,みせるために、ここを去,さりユダヤに行,いってはいかがです。","tok":[["そこ"],["で"],["、"],["イエス"],["の"],["兄弟","きょうだい"],["たち"],["が"],["イエス"],["に"],["言った","いった"],["、"],["「"],["あなた"],["が"],["して"],["おられる"],["わざ"],["を"],["弟子","でし"],["たち"],["に"],["も"],["見せる","みせる"],["ため"],["に"],["、"],["ここ"],["を"],["去り","さり"],["ユダヤ"],["に"],["行って","いって"],["は"],["いかが"],["です"],["。"]]},{"verse":4,"text":"自分,じぶんを公,おおやけけにあらわそうと思,おもっている人,ひとで、隠,かくれて仕事,しごとをするものはありません。あなたがこれらのことをするからには、自分,じぶんをはっきりと世,よにあらわしなさい」。","tok":[["自分","じぶん"],["を"],["公け","おおやけけ"],["に"],["あらわそう"],["と"],["思って","おもって"],["いる"],["人","ひと"],["で"],["、"],["隠れて","かくれて"],["仕事","しごと"],["を"],["する"],["もの"],["は"],["ありません"],["。"],["あなた"],["が"],["これ"],["ら"],["の"],["こと"],["を"],["する"],["から"],["に"],["は"],["、"],["自分","じぶん"],["を"],["はっきり"],["と"],["世","よ"],["に"],["あらわし"],["なさい"],["」"],["。"]]},{"verse":5,"text":"こう言,いったのは、兄弟,きょうだいたちもイエスを信,しんじていなかったからである。","tok":[["こう"],["言った","いった"],["の"],["は"],["、"],["兄弟","きょうだい"],["たち"],["も"],["イエス"],["を"],["信じて","しんじて"],["いなかった"],["から"],["で"],["ある"],["。"]]},{"verse":6,"text":"そこでイエスは彼,かれらに言,いわれた、「わたしの時,ときはまだきていない。しかし、あなたがたの時,ときはいつも備,そなわっている。","tok":[["そこ"],["で"],["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["わたし"],["の"],["時","とき"],["は"],["まだ"],["きて"],["いない"],["。"],["しかし"],["、"],["あなた"],["がた"],["の"],["時","とき"],["は"],["いつも"],["備わって","そなわって"],["いる"],["。"]]},{"verse":7,"text":"世,よはあなたがたを憎,にくみ得,えないが、わたしを憎,にくんでいる。わたしが世,よのおこないの悪,わるいことを、あかししているからである。","tok":[["世","よ"],["は"],["あなた"],["がた"],["を"],["憎み","にくみ"],["得ない","えない"],["が"],["、"],["わたし"],["を"],["憎んで","にくんで"],["いる"],["。"],["わたし"],["が"],["世","よ"],["の"],["おこない"],["の"],["悪い","わるい"],["こと"],["を"],["、"],["あかし"],["して"],["いる"],["から"],["で"],["ある"],["。"]]},{"verse":8,"text":"あなたがたこそ祭,まつりに行,いきなさい。わたしはこの祭,まつりには行,いかない。わたしの時,ときはまだ満,みちていないから」。","tok":[["あなた"],["がた"],["こそ"],["祭","まつり"],["に"],["行き","いき"],["なさい"],["。"],["わたし"],["は"],["この"],["祭","まつり"],["に"],["は"],["行かない","いかない"],["。"],["わたし"],["の"],["時","とき"],["は"],["まだ"],["満ちて","みちて"],["いない"],["から"],["」"],["。"]]},{"verse":9,"text":"彼,かれらにこう言,いって、イエスはガリラヤにとどまっておられた。","tok":[["彼","かれ"],["ら"],["に"],["こう"],["言って","いって"],["、"],["イエス"],["は"],["ガリラヤ"],["に"],["とどまって"],["おられた"],["。"]]},{"verse":10,"text":"しかし、兄弟,きょうだいたちが祭,まつりに行,いったあとで、イエスも人目,ひとめにたたぬように、ひそかに行,いかれた。","tok":[["しかし"],["、"],["兄弟","きょうだい"],["たち"],["が"],["祭","まつり"],["に"],["行った","いった"],["あと"],["で"],["、"],["イエス"],["も"],["人目","ひとめ"],["に"],["たたぬ"],["よう"],["に"],["、"],["ひそか"],["に"],["行かれた","いかれた"],["。"]]},{"verse":11,"text":"ユダヤ人,じんらは祭,まつりの時,ときに、「あの人,ひとはどこにいるのか」と言,いって、イエスを捜,さがしていた。","tok":[["ユダヤ人","ゆだやじん"],["ら"],["は"],["祭","まつり"],["の"],["時","とき"],["に"],["、"],["「"],["あの"],["人","ひと"],["は"],["どこ"],["に"],["いる"],["の"],["か"],["」"],["と"],["言って","いって"],["、"],["イエス"],["を"],["捜して","さがして"],["いた"],["。"]]},{"verse":12,"text":"群衆,ぐんしゅうの中,なかに、イエスについていろいろとうわさが立,たった。ある人々,ひとびとは、「あれはよい人,ひとだ」と言,いい、他,たの人々,ひとびとは、「いや、あれは群衆,ぐんしゅうを惑,まどわしている」と言,いった。","tok":[["群衆","ぐんしゅう"],["の"],["中","なか"],["に"],["、"],["イエス"],["について"],["いろいろ"],["と"],["うわさ"],["が"],["立った","たった"],["。"],["ある"],["人々","ひとびと"],["は"],["、"],["「"],["あれ"],["は"],["よい"],["人","ひと"],["だ"],["」"],["と"],["言い","いい"],["、"],["他","た"],["の"],["人々","ひとびと"],["は"],["、"],["「"],["いや"],["、"],["あれ"],["は"],["群衆","ぐんしゅう"],["を"],["惑わして","まどわして"],["いる"],["」"],["と"],["言った","いった"],["。"]]},{"verse":13,"text":"しかし、ユダヤ人,じんらを恐,おそれて、イエスのことを公然,こうぜんと口,くちにする者,ものはいなかった。","tok":[["しかし"],["、"],["ユダヤ人","ゆだやじん"],["ら"],["を"],["恐れて","おそれて"],["、"],["イエス"],["の"],["こと"],["を"],["公然","こうぜん"],["と"],["口","くち"],["に"],["する"],["者","もの"],["は"],["いなかった"],["。"]]},{"verse":14,"text":"祭,まつりも半,なかばになってから、イエスは宮,みやに上,のぼって教,おしえ始,はじめられた。","tok":[["祭","まつり"],["も"],["半ば","なかば"],["に"],["なって"],["から"],["、"],["イエス"],["は"],["宮","みや"],["に"],["上って","のぼって"],["教え","おしえ"],["始められた","はじめられた"],["。"]]},{"verse":15,"text":"すると、ユダヤ人,じんたちは驚,おどろいて言,いった、「この人,ひとは学問,がくもんをしたこともないのに、どうして律法,りっぽうの知識,ちしきをもっているのだろう」。","tok":[["する"],["と"],["、"],["ユダヤ人","ゆだやじん"],["たち"],["は"],["驚ろいて","おどろいて"],["言った","いった"],["、"],["「"],["この"],["人","ひと"],["は"],["学問","がくもん"],["を"],["した"],["こと"],["も"],["ない"],["のに"],["、"],["どう"],["して"],["律法","りっぽう"],["の"],["知識","ちしき"],["を"],["もって"],["いる"],["の"],["だろう"],["」"],["。"]]},{"verse":16,"text":"そこでイエスは彼,かれらに答,こたえて言,いわれた、「わたしの教,おしえはわたし自身,じしんの教,おしえではなく、わたしをつかわされたかたの教,おしえである。","tok":[["そこ"],["で"],["イエス"],["は"],["彼","かれ"],["ら"],["に"],["答","こたえ"],["て"],["言われた","いわれた"],["、"],["「"],["わたし"],["の"],["教え","おしえ"],["は"],["わたし"],["自身","じしん"],["の"],["教え","おしえ"],["で"],["は"],["なく"],["、"],["わたし"],["を"],["つかわされた"],["かた"],["の"],["教え","おしえ"],["で"],["ある"],["。"]]},{"verse":17,"text":"神,かみのみこころを行,おこなおうと思,おもう者,ものであれば、だれでも、わたしの語,かたっているこの教,おしえが神,かみからのものか、それとも、わたし自身,じしんから出,でたものか、わかるであろう。","tok":[["神","かみ"],["のみ"],["こころ"],["を"],["行なおう","おこなおう"],["と"],["思う","おもう"],["者","もの"],["で"],["あれば"],["、"],["だれ"],["で"],["も"],["、"],["わたし"],["の"],["語って","かたって"],["いる"],["この"],["教え","おしえ"],["が"],["神","かみ"],["から"],["の"],["もの"],["か"],["、"],["それ"],["と"],["も"],["、"],["わたし"],["自身","じしん"],["から"],["出た","でた"],["もの"],["か"],["、"],["わかるで"],["あろう"],["。"]]},{"verse":18,"text":"自分,じぶんから出,でたことを語,かたる者,ものは、自分,じぶんの栄光,えいこうを求,もとめるが、自分,じぶんをつかわされたかたの栄光,えいこうを求,もとめる者,ものは真実,しんじつであって、その人,ひとの内,うちには偽,いつわりがない。","tok":[["自分","じぶん"],["から"],["出た","でた"],["こと"],["を"],["語る","かたる"],["者","もの"],["は"],["、"],["自分","じぶん"],["の"],["栄光","えいこう"],["を"],["求める","もとめる"],["が"],["、"],["自分","じぶん"],["を"],["つかわされた"],["かた"],["の"],["栄光","えいこう"],["を"],["求める","もとめる"],["者","もの"],["は"],["真実","しんじつ"],["で"],["あって"],["、"],["その"],["人","ひと"],["の"],["内","うち"],["に"],["は"],["偽り","いつわり"],["が"],["ない"],["。"]]},{"verse":19,"text":"モーセはあなたがたに律法,りっぽうを与,あたえたではないか。それだのに、あなたがたのうちには、その律法,りっぽうを行,おこなう者,ものがひとりもない。あなたがたは、なぜわたしを殺,ころそうと思,おもっているのか」。","tok":[["モーセ"],["は"],["あなた"],["がた"],["に"],["律法","りっぽう"],["を"],["与","あたえ"],["たで"],["は"],["ない"],["か"],["。"],["それ"],["だ"],["のに"],["、"],["あなた"],["がた"],["の"],["うち"],["に"],["は"],["、"],["その"],["律法","りっぽう"],["を"],["行なう","おこなう"],["者","もの"],["が"],["ひとり"],["も"],["ない"],["。"],["あなた"],["がた"],["は"],["、"],["なぜ"],["わたし"],["を"],["殺そう","ころそう"],["と"],["思って","おもって"],["いる"],["の"],["か"],["」"],["。"]]},{"verse":20,"text":"群衆,ぐんしゅうは答,こたえた、「あなたは悪霊,あくれいに取,とりつかれている。だれがあなたを殺,ころそうと思,おもっているものか」。","tok":[["群衆","ぐんしゅう"],["は"],["答","こたえ"],["た"],["、"],["「"],["あなた"],["は"],["悪霊","あくれい"],["に"],["取","とり"],["つかれて"],["いる"],["。"],["だれ"],["が"],["あなた"],["を"],["殺そう","ころそう"],["と"],["思って","おもって"],["いる"],["もの"],["か"],["」"],["。"]]},{"verse":21,"text":"イエスは彼,かれらに答,こたえて言,いわれた、「わたしが一つのわざをしたところ、あなたがたは皆,みなそれを見,みて驚,おどろいている。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["に"],["答","こたえ"],["て"],["言われた","いわれた"],["、"],["「"],["わたし"],["が"],["一","ひと"],["つ"],["の"],["わざ"],["を"],["した"],["ところ"],["、"],["あなた"],["がた"],["は"],["皆","みな"],["それ"],["を"],["見て","みて"],["驚ろいて","おどろいて"],["いる"],["。"]]},{"verse":22,"text":"モーセはあなたがたに割礼,かつれいを命,めいじたので、（これは、実,じつは、モーセから始,はじまったのではなく、先祖,せんぞたちから始,はじまったものである）あなたがたは安息日,あんそくにちにも人,ひとに割礼,かつれいを施,ほどこしている。","tok":[["モーセ"],["は"],["あなた"],["がた"],["に"],["割礼","かつれい"],["を"],["命じた","めいじた"],["ので"],["、"],["（"],["これ"],["は"],["、"],["実","じつ"],["は"],["、"],["モーセ"],["から"],["始まった","はじまった"],["ので"],["は"],["なく"],["、"],["先祖","せんぞ"],["たち"],["から"],["始まった","はじまった"],["もの"],["で"],["ある"],["）"],["あなた"],["がた"],["は"],["安息日","あんそくにち"],["に"],["も"],["人","ひと"],["に"],["割礼","かつれい"],["を"],["施して","ほどこして"],["いる"],["。"]]},{"verse":23,"text":"もし、モーセの律法,りっぽうが破,やぶられないように、安息日,あんそくにちであっても割礼,かつれいを受,うけるのなら、安息日,あんそくにちに人,ひとの全身,ぜんしんを丈夫,じょうぶにしてやったからといって、どうして、そんなにおこるのか。","tok":[["もし"],["、"],["モーセ"],["の"],["律法","りっぽう"],["が"],["破られない","やぶられない"],["よう"],["に"],["、"],["安息日","あんそくにちであって"],["も"],["割礼","かつれい"],["を"],["受る","うける"],["の"],["なら"],["、"],["安息日","あんそくにち"],["に"],["人","ひと"],["の"],["全身","ぜんしん"],["を"],["丈夫","じょうぶ"],["に"],["して"],["やった"],["から"],["と"],["いって"],["、"],["どう"],["して"],["、"],["そんな"],["に"],["おこる"],["の"],["か"],["。"]]},{"verse":24,"text":"うわべで人,ひとをさばかないで、正,ただしいさばきをするがよい」。","tok":[["うわべ"],["で"],["人","ひと"],["を"],["さばかないで"],["、"],["正い","ただしい"],["さばき"],["を"],["する"],["が"],["よい"],["」"],["。"]]},{"verse":25,"text":"さて、エルサレムのある人,ひとたちが言,いった、「この人,ひとは人々,ひとびとが殺,ころそうと思,おもっている者,ものではないか。","tok":[["さて"],["、"],["エルサレム"],["の"],["ある"],["人","ひと"],["たち"],["が"],["言った","いった"],["、"],["「"],["この"],["人","ひと"],["は"],["人々","ひとびと"],["が"],["殺そう","ころそう"],["と"],["思って","おもって"],["いる"],["者","もの"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":26,"text":"見,みよ、彼,かれは公然,こうぜんと語,かたっているのに、人々,ひとびとはこれに対,たいして何,なにも言,いわない。役人,やくにんたちは、この人,ひとがキリストであることを、ほんとうに知,しっているのではなかろうか。","tok":[["見よ","みよ"],["、"],["彼","かれ"],["は"],["公然","こうぜん"],["と"],["語って","かたって"],["いる"],["のに"],["、"],["人々","ひとびと"],["は"],["これ"],["に対して","にたいして"],["何に","なに"],["も"],["言わない","いわない"],["。"],["役人","やくにん"],["たち"],["は"],["、"],["この"],["人","ひと"],["が"],["キリスト"],["で"],["ある"],["こと"],["を"],["、"],["ほんとう"],["に"],["知って","しって"],["いる"],["ので"],["は"],["なかろう"],["か"],["。"]]},{"verse":27,"text":"わたしたちはこの人,ひとがどこからきたのか知,しっている。しかし、キリストが現,あらわれる時,ときには、どこから来,くるのか知,しっている者,ものは、ひとりもいない」。","tok":[["わたしたち"],["は"],["この"],["人","ひと"],["が"],["どこ"],["から"],["きた"],["の"],["か"],["知って","しって"],["いる"],["。"],["しかし"],["、"],["キリスト"],["が"],["現われる","あらわれる"],["時","とき"],["に"],["は"],["、"],["どこ"],["から"],["来る","くる"],["の"],["か"],["知って","しって"],["いる"],["者","もの"],["は"],["、"],["ひとり"],["も"],["いない"],["」"],["。"]]},{"verse":28,"text":"イエスは宮,みやの内,うちで教,おしえながら、叫,さけんで言,いわれた、「あなたがたは、わたしを知,しっており、また、わたしがどこからきたかも知,しっている。しかし、わたしは自分,じぶんからきたのではない。わたしをつかわされたかたは真実,しんじつであるが、あなたがたは、そのかたを知,しらない。","tok":[["イエス"],["は"],["宮","みや"],["の"],["内","うち"],["で"],["教え","おしえ"],["ながら"],["、"],["叫けんで","さけんで"],["言われた","いわれた"],["、"],["「"],["あなた"],["がた"],["は"],["、"],["わたし"],["を"],["知って","しって"],["おり"],["、"],["また"],["、"],["わたし"],["が"],["どこ"],["から"],["きた"],["か"],["も"],["知って","しって"],["いる"],["。"],["しかし"],["、"],["わたし"],["は"],["自分","じぶん"],["から"],["きた"],["ので"],["は"],["ない"],["。"],["わたし"],["を"],["つかわされた"],["かた"],["は"],["真実","しんじつ"],["で"],["ある"],["が"],["、"],["あなた"],["がた"],["は"],["、"],["その"],["かた"],["を"],["知らない","しらない"],["。"]]},{"verse":29,"text":"わたしは、そのかたを知,しっている。わたしはそのかたのもとからきた者,もので、そのかたがわたしをつかわされたのである」。","tok":[["わたし"],["は"],["、"],["その"],["かた"],["を"],["知って","しって"],["いる"],["。"],["わたし"],["は"],["その"],["かた"],["の"],["もと"],["から"],["きた"],["者","もの"],["で"],["、"],["その"],["かた"],["が"],["わたし"],["を"],["つかわされた"],["ので"],["ある"],["」"],["。"]]},{"verse":30,"text":"そこで人々,ひとびとはイエスを捕,とらえようと計,はかったが、だれひとり手,てをかける者,ものはなかった。イエスの時,ときが、まだきていなかったからである。","tok":[["そこ"],["で"],["人々","ひとびと"],["は"],["イエス"],["を"],["捕らえよう","とらえよう"],["と"],["計った","はかった"],["が"],["、"],["だれ"],["ひとり"],["手","て"],["を"],["かける"],["者","もの"],["は"],["なかった"],["。"],["イエス"],["の"],["時","とき"],["が"],["、"],["まだ"],["きて"],["いなかった"],["から"],["で"],["ある"],["。"]]},{"verse":31,"text":"しかし、群衆,ぐんしゅうの中,なかの多,おおくの者,ものが、イエスを信,しんじて言,いった、「キリストがきても、この人,ひとが行,おこなったよりも多,おおくのしるしを行,おこなうだろうか」。","tok":[["しかし"],["、"],["群衆","ぐんしゅう"],["の"],["中","なか"],["の"],["多く","おおく"],["の"],["者","もの"],["が"],["、"],["イエス"],["を"],["信じて","しんじて"],["言った","いった"],["、"],["「"],["キリスト"],["が"],["きて"],["も"],["、"],["この"],["人","ひと"],["が"],["行なった","おこなった"],["より"],["も"],["多く","おおく"],["の"],["しるし"],["を"],["行なうだろう","おこなうだろう"],["か"],["」"],["。"]]},{"verse":32,"text":"群衆,ぐんしゅうがイエスについてこのようなうわさをしているのを、パリサイ人,びとたちは耳,みみにした。そこで、祭司長,さいしちょうたちやパリサイ人,びとたちは、イエスを捕,とらえようとして、下役,したやくどもをつかわした。","tok":[["群衆","ぐんしゅう"],["が"],["イエス"],["について"],["この"],["よう"],["な"],["うわさ"],["を"],["して"],["いる"],["の"],["を"],["、"],["パリサイ"],["人","びとたち"],["は"],["耳","みみ"],["に"],["した"],["。"],["そこ"],["で"],["、"],["祭司長","さいしちょう"],["たち"],["や"],["パリサイ"],["人","びとたち"],["は"],["、"],["イエス"],["を"],["捕らえよう","とらえよう"],["として"],["、"],["下役","したやく"],["ども"],["を"],["つかわした"],["。"]]},{"verse":33,"text":"イエスは言,いわれた、「今,いましばらくの間,あいだ、わたしはあなたがたと一緒,いっしょにいて、それから、わたしをおつかわしになったかたのみもとに行,いく。","tok":[["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["今","いま"],["しばらく"],["の"],["間","あいだ"],["、"],["わたし"],["は"],["あなた"],["がた"],["と"],["一緒","いっしょ"],["に"],["いて"],["、"],["それ"],["から"],["、"],["わたし"],["を"],["おつかわし"],["に"],["なった"],["かた"],["のみ"],["もと"],["に"],["行く","いく"],["。"]]},{"verse":34,"text":"あなたがたはわたしを捜,さがすであろうが、見,みつけることはできない。そしてわたしのいる所,ところに、あなたがたは来,くることができない」。","tok":[["あなた"],["がた"],["は"],["わたし"],["を"],["捜すで","さがすで"],["あろう"],["が"],["、"],["見つける","みつける"],["こと"],["は"],["できない"],["。"],["そして"],["わたし"],["の"],["いる"],["所","ところ"],["に"],["、"],["あなた"],["がた"],["は"],["来る","くる"],["こと"],["が"],["できない"],["」"],["。"]]},{"verse":35,"text":"そこでユダヤ人,じんたちは互,たがいに言,いった、「わたしたちが見,みつけることができないというのは、どこへ行,いこうとしているのだろう。ギリシヤ人,じんの中,なかに離散,りさんしている人,ひとたちのところにでも行,いって、ギリシヤ人,じんを教,おしえようというのだろうか。","tok":[["そこ"],["で"],["ユダヤ人","ゆだやじん"],["たち"],["は"],["互","たがい"],["に"],["言った","いった"],["、"],["「"],["わたしたち"],["が"],["見つける","みつける"],["こと"],["が"],["できない"],["と"],["いう"],["の"],["は"],["、"],["どこ"],["へ"],["行こう","いこう"],["として"],["いる"],["の"],["だろう"],["。"],["ギリシヤ"],["人","じん"],["の"],["中","なか"],["に"],["離散","りさん"],["して"],["いる"],["人","ひと"],["たち"],["の"],["ところ"],["に"],["で"],["も"],["行って","いって"],["、"],["ギリシヤ"],["人","じん"],["を"],["教えよう","おしえよう"],["と"],["いう"],["の"],["だろう"],["か"],["。"]]},{"verse":36,"text":"また、『わたしを捜,さがすが、見,みつけることはできない。そしてわたしのいる所,ところには来,くることができないだろう』と言,いったその言葉,ことばは、どういう意味,いみだろう」。","tok":[["また"],["、"],["『"],["わたし"],["を"],["捜す","さがす"],["が"],["、"],["見つける","みつける"],["こと"],["は"],["できない"],["。"],["そして"],["わたし"],["の"],["いる"],["所","ところ"],["に"],["は"],["来る","くる"],["こと"],["が"],["できないだろう"],["』"],["と"],["言った","いった"],["その"],["言葉","ことば"],["は"],["、"],["どういう"],["意味","いみ"],["だろう"],["」"],["。"]]},{"verse":37,"text":"祭,まつりの終,おわりの大事,だいじな日,ひに、イエスは立,たって、叫,さけんで言,いわれた、「だれでもかわく者,ものは、わたしのところにきて飲,のむがよい。","tok":[["祭","まつり"],["の"],["終","おわり"],["の"],["大事","だいじ"],["な"],["日","ひ"],["に"],["、"],["イエス"],["は"],["立って","たって"],["、"],["叫けんで","さけんで"],["言われた","いわれた"],["、"],["「"],["だれ"],["で"],["も"],["かわく"],["者","もの"],["は"],["、"],["わたし"],["の"],["ところ"],["に"],["きて"],["飲む","のむ"],["が"],["よい"],["。"]]},{"verse":38,"text":"わたしを信,しんじる者,ものは、聖書,せいしょに書,かいてあるとおり、その腹,はらから生,いける水,みずが川,かわとなって流,なれ出,でるであろう」。","tok":[["わたし"],["を"],["信じる","しんじる"],["者","もの"],["は"],["、"],["聖書","せいしょ"],["に"],["書いて","かいて"],["ある"],["と"],["おり"],["、"],["その"],["腹","はら"],["から"],["生ける","いける"],["水","みず"],["が"],["川","かわ"],["と"],["なって"],["流れ出るで","なれでるで"],["あろう"],["」"],["。"]]},{"verse":39,"text":"これは、イエスを信,しんじる人々,ひとびとが受,うけようとしている御霊,みたまをさして言,いわれたのである。すなわち、イエスはまだ栄光,えいこうを受,うけておられなかったので、御霊,みたまがまだ下,くだっていなかったのである。","tok":[["これ"],["は"],["、"],["イエス"],["を"],["信じる","しんじる"],["人々","ひとびと"],["が"],["受よう","うけよう"],["として"],["いる"],["御霊","みたま"],["を"],["さして"],["言われた","いわれた"],["ので"],["ある"],["。"],["すなわち"],["、"],["イエス"],["は"],["まだ"],["栄光","えいこう"],["を"],["受て","うけて"],["おられなかった"],["ので"],["、"],["御霊","みたま"],["が"],["まだ"],["下って","くだって"],["いなかった"],["ので"],["ある"],["。"]]},{"verse":40,"text":"群衆,ぐんしゅうのある者,ものがこれらの言葉,ことばを聞,きいて、「このかたは、ほんとうに、あの預言者,よげんしゃである」と言,いい、","tok":[["群衆","ぐんしゅう"],["の"],["ある"],["者","もの"],["が"],["これ"],["ら"],["の"],["言葉","ことば"],["を"],["聞いて","きいて"],["、"],["「"],["このかた"],["は"],["、"],["ほんとう"],["に"],["、"],["あの"],["預言者","よげんしゃ"],["で"],["ある"],["」"],["と"],["言い","いい"],["、"]]},{"verse":41,"text":"ほかの人,ひとたちは「このかたはキリストである」と言,いい、また、ある人々,ひとびとは、「キリストはまさか、ガリラヤからは出,でてこないだろう。","tok":[["ほか"],["の"],["人","ひと"],["たち"],["は"],["「"],["このかた"],["は"],["キリスト"],["で"],["ある"],["」"],["と"],["言い","いい"],["、"],["また"],["、"],["ある"],["人々","ひとびと"],["は"],["、"],["「"],["キリスト"],["は"],["まさか"],["、"],["ガリラヤ"],["から"],["は"],["出て","でて"],["こないだろう"],["。"]]},{"verse":42,"text":"キリストは、ダビデの子孫,しそんから、またダビデのいたベツレヘムの村,むらから出,でると、聖書,せいしょに書,かいてあるではないか」と言,いった。","tok":[["キリスト"],["は"],["、"],["ダビデ"],["の"],["子孫","しそん"],["から"],["、"],["また"],["ダビデ"],["の"],["いた"],["ベツレヘム"],["の"],["村","むら"],["から"],["出る","でる"],["と"],["、"],["聖書","せいしょ"],["に"],["書いて","かいて"],["ある"],["で"],["は"],["ない"],["か"],["」"],["と"],["言った","いった"],["。"]]},{"verse":43,"text":"こうして、群衆,ぐんしゅうの間,あいだにイエスのことで分争,ぶんそうが生,しょうじた。","tok":[["こう"],["して"],["、"],["群衆","ぐんしゅう"],["の"],["間","あいだ"],["に"],["イエス"],["の"],["こと"],["で"],["分争","ぶんそう"],["が"],["生じた","しょうじた"],["。"]]},{"verse":44,"text":"彼,かれらのうちのある人々,ひとびとは、イエスを捕,とらえようと思,おもったが、だれひとり手,てをかける者,ものはなかった。","tok":[["彼","かれ"],["ら"],["の"],["うち"],["の"],["ある"],["人々","ひとびと"],["は"],["、"],["イエス"],["を"],["捕らえよう","とらえよう"],["と"],["思った","おもった"],["が"],["、"],["だれ"],["ひとり"],["手","て"],["を"],["かける"],["者","もの"],["は"],["なかった"],["。"]]},{"verse":45,"text":"さて、下役,したやくどもが祭司長,さいしちょうたちやパリサイ人,びとたちのところに帰,かえってきたので、彼,かれらはその下役,したやくどもに言,いった、「なぜ、あの人,ひとを連,つれてこなかったのか」。","tok":[["さて"],["、"],["下役","したやく"],["ども"],["が"],["祭司長","さいしちょう"],["たち"],["や"],["パリサイ"],["人","びとたち"],["の"],["ところ"],["に"],["帰えって","かえって"],["きた"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["その"],["下役","したやく"],["ども"],["に"],["言った","いった"],["、"],["「"],["なぜ"],["、"],["あの"],["人","ひと"],["を"],["連れて","つれて"],["こなかった"],["の"],["か"],["」"],["。"]]},{"verse":46,"text":"下役,したやくどもは答,こたえた、「この人,ひとの語,かたるように語,かたった者,ものは、これまでにありませんでした」。","tok":[["下役","したやく"],["ども"],["は"],["答","こたえ"],["た"],["、"],["「"],["この"],["人","ひと"],["の"],["語る","かたる"],["よう"],["に"],["語った","かたった"],["者","もの"],["は"],["、"],["これ"],["まで"],["に"],["ありませんでした"],["」"],["。"]]},{"verse":47,"text":"パリサイ人,びとたちが彼,かれらに答,こたえた、「あなたがたまでが、だまされているのではないか。","tok":[["パリサイ"],["人","びと"],["たち"],["が"],["彼","かれ"],["ら"],["に"],["答","こたえ"],["た"],["、"],["「"],["あなた"],["がた"],["まで"],["が"],["、"],["だまされて"],["いる"],["ので"],["は"],["ない"],["か"],["。"]]},{"verse":48,"text":"役人,やくにんたちやパリサイ人,びとたちの中,なかで、ひとりでも彼,かれを信,しんじた者,ものがあっただろうか。","tok":[["役人","やくにん"],["たち"],["や"],["パリサイ"],["人","びとたち"],["の"],["中","なか"],["で"],["、"],["ひとり"],["で"],["も"],["彼","かれ"],["を"],["信じた","しんじた"],["者","もの"],["が"],["あっただろう"],["か"],["。"]]},{"verse":49,"text":"律法,りっぽうをわきまえないこの群衆,ぐんしゅうは、のろわれている」。","tok":[["律法","りっぽう"],["を"],["わきまえない"],["この"],["群衆","ぐんしゅう"],["は"],["、"],["のろわれて"],["いる"],["」"],["。"]]},{"verse":50,"text":"彼,かれらの中,なかのひとりで、以前,いぜんにイエスに会,あいにきたことのあるニコデモが、彼,かれらに言,いった、","tok":[["彼","かれ"],["ら"],["の"],["中","なか"],["の"],["ひとり"],["で"],["、"],["以前","いぜん"],["に"],["イエス"],["に"],["会い","あい"],["に"],["きた"],["こと"],["の"],["ある"],["ニコデモ"],["が"],["、"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"]]},{"verse":51,"text":"「わたしたちの律法,りっぽうによれば、まずその人,ひとの言,いい分,ぶんを聞,きき、その人,ひとのしたことを知,しった上,うえでなければ、さばくことをしないのではないか」。","tok":[["「"],["わたしたち"],["の"],["律法","りっぽう"],["に"],["よれば"],["、"],["まず"],["その"],["人","ひと"],["の"],["言い分","いいぶん"],["を"],["聞","きき"],["、"],["その"],["人","ひと"],["の"],["した"],["こと"],["を"],["知った","しった"],["上","うえ"],["で"],["なければ"],["、"],["さばく"],["こと"],["を"],["しない"],["ので"],["は"],["ない"],["か"],["」"],["。"]]},{"verse":52,"text":"彼,かれらは答,こたえて言,いった、「あなたもガリラヤ出,でなのか。よく調,しらべてみなさい、ガリラヤからは預言者,よげんしゃが出,でるものではないことが、わかるだろう」。〔","tok":[["彼","かれ"],["ら"],["は"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["あなた"],["も"],["ガリラヤ"],["出","で"],["な"],["の"],["か"],["。"],["よく"],["調べて","しらべて"],["み"],["なさい"],["、"],["ガリラヤ"],["から"],["は"],["預言者","よげんしゃ"],["が"],["出る","でる"],["もの"],["で"],["は"],["ない"],["こと"],["が"],["、"],["わかるだろう"],["」"],["。"],["〔"]]},{"verse":53,"text":"そして、人々,ひとびとはおのおの家,いえに帰,かえって行,いった。","tok":[["そして"],["、"],["人々","ひとびと"],["は"],["おのおの"],["家","いえ"],["に"],["帰えって","かえって"],["行った","いった"],["。"]]}]
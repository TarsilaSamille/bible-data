[{"verse":1,"text":"わたしがこれらのことを語,かたったのは、あなたがたがつまずくことのないためである。","tok":[["わたし"],["が"],["これ"],["ら"],["の"],["こと"],["を"],["語った","かたった"],["の"],["は"],["、"],["あなた"],["がた"],["が"],["つまずく"],["こと"],["の"],["ない"],["ため"],["で"],["ある"],["。"]]},{"verse":2,"text":"人々,ひとびとはあなたがたを会堂,かいどうから追,おい出,だすであろう。更,さらにあなたがたを殺,ころす者,ものがみな、それによって自分,じぶんたちは神,かみに仕,つかえているのだと思,おもう時,ときが来,くるであろう。","tok":[["人々","ひとびと"],["は"],["あなた"],["がた"],["を"],["会堂","かいどう"],["から"],["追い出すで","おいだすで"],["あろう"],["。"],["更に","さらに"],["あなた"],["がた"],["を"],["殺ろす","ころす"],["者","もの"],["が"],["みな"],["、"],["それ"],["によって"],["自分","じぶん"],["たち"],["は"],["神","かみ"],["に"],["仕えて","つかえて"],["いる"],["の"],["だ"],["と"],["思う","おもう"],["時","とき"],["が"],["来るで","くるで"],["あろう"],["。"]]},{"verse":3,"text":"彼,かれらがそのようなことをするのは、父,ちちをもわたしをも知,しらないからである。","tok":[["彼","かれ"],["ら"],["が"],["その"],["よう"],["な"],["こと"],["を"],["する"],["の"],["は"],["、"],["父","ちち"],["を"],["も"],["わたし"],["を"],["も"],["知らない","しらない"],["から"],["で"],["ある"],["。"]]},{"verse":4,"text":"わたしがあなたがたにこれらのことを言,いったのは、彼,かれらの時,ときがきた場合,ばあい、わたしが彼,かれらについて言,いったことを、思,おもい起,おこさせるためである。これらのことを初,はじめから言,いわなかったのは、わたしがあなたがたと一緒,いっしょにいたからである。","tok":[["わたし"],["が"],["あなた"],["がた"],["に"],["これ"],["ら"],["の"],["こと"],["を"],["言った","いった"],["の"],["は"],["、"],["彼","かれ"],["ら"],["の"],["時","とき"],["が"],["きた"],["場合","ばあい"],["、"],["わたし"],["が"],["彼","かれ"],["ら"],["について"],["言った","いった"],["こと"],["を"],["、"],["思い起こさせる","おもいおこさせる"],["ため"],["で"],["ある"],["。"],["これ"],["ら"],["の"],["こと"],["を"],["初め","はじめ"],["から"],["言わなかった","いわなかった"],["の"],["は"],["、"],["わたし"],["が"],["あなた"],["がた"],["と"],["一緒","いっしょ"],["に"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":5,"text":"けれども今,いまわたしは、わたしをつかわされたかたのところに行,いこうとしている。しかし、あなたがたのうち、だれも『どこへ行,いくのか』と尋,たずねる者,ものはない。","tok":[["けれど"],["も"],["今","いま"],["わたし"],["は"],["、"],["わたし"],["を"],["つかわされた"],["かた"],["の"],["ところ"],["に"],["行こう","いこう"],["として"],["いる"],["。"],["しかし"],["、"],["あなた"],["がた"],["の"],["うち"],["、"],["だれ"],["も"],["『"],["どこ"],["へ"],["行く","いく"],["の"],["か"],["』"],["と"],["尋ねる","たずねる"],["者","もの"],["は"],["ない"],["。"]]},{"verse":6,"text":"かえって、わたしがこれらのことを言,いったために、あなたがたの心,こころは憂,うれいで満,みたされている。","tok":[["かえって"],["、"],["わたし"],["が"],["これ"],["ら"],["の"],["こと"],["を"],["言った","いった"],["ため"],["に"],["、"],["あなた"],["がた"],["の"],["心","こころ"],["は"],["憂","うれい"],["で"],["満たされて","みたされて"],["いる"],["。"]]},{"verse":7,"text":"しかし、わたしはほんとうのことをあなたがたに言,いうが、わたしが去,さって行,いくことは、あなたがたの益,えきになるのだ。わたしが去,さって行,いかなければ、あなたがたのところに助,たすけ主,ぬしはこないであろう。もし行,いけば、それをあなたがたにつかわそう。","tok":[["しかし"],["、"],["わたし"],["は"],["ほんとう"],["の"],["こと"],["を"],["あなた"],["がた"],["に"],["言う","いう"],["が"],["、"],["わたし"],["が"],["去て","さって"],["行く","いく"],["こと"],["は"],["、"],["あなた"],["がた"],["の"],["益","えき"],["に"],["なる"],["の"],["だ"],["。"],["わたし"],["が"],["去て","さって"],["行かなければ","いかなければ"],["、"],["あなた"],["がた"],["の"],["ところ"],["に"],["助け主","たすけぬし"],["は"],["こないで"],["あろう"],["。"],["もし"],["行けば","いけば"],["、"],["それ"],["を"],["あなた"],["がた"],["に"],["つかわそう"],["。"]]},{"verse":8,"text":"それがきたら、罪,つみと義,ぎとさばきとについて、世,よの人,ひとの目,めを開,ひらくであろう。","tok":[["それ"],["が"],["きたら"],["、"],["罪","つみ"],["と"],["義","ぎ"],["と"],["さばき"],["と"],["について"],["、"],["世","よ"],["の"],["人","ひと"],["の"],["目","め"],["を"],["開らくで","ひらくで"],["あろう"],["。"]]},{"verse":9,"text":"罪,つみについてと言,いったのは、彼,かれらがわたしを信,しんじないからである。","tok":[["罪","つみ"],["について"],["と"],["言った","いった"],["の"],["は"],["、"],["彼","かれ"],["ら"],["が"],["わたし"],["を"],["信じない","しんじない"],["から"],["で"],["ある"],["。"]]},{"verse":10,"text":"義,ぎについてと言,いったのは、わたしが父,ちちのみもとに行,いき、あなたがたは、もはやわたしを見,みなくなるからである。","tok":[["義","ぎ"],["について"],["と"],["言った","いった"],["の"],["は"],["、"],["わたし"],["が"],["父","ちち"],["のみ"],["もと"],["に"],["行き","いき"],["、"],["あなた"],["がた"],["は"],["、"],["もはや"],["わたし"],["を"],["見なく","みなく"],["なる"],["から"],["で"],["ある"],["。"]]},{"verse":11,"text":"さばきについてと言,いったのは、この世,よの君,きみがさばかれるからである。","tok":[["さばき"],["について"],["と"],["言った","いった"],["の"],["は"],["、"],["この世","このよ"],["の"],["君","きみ"],["が"],["さばかれる"],["から"],["で"],["ある"],["。"]]},{"verse":12,"text":"わたしには、あなたがたに言,いうべきことがまだ多,おおくあるが、あなたがたは今,いまはそれに堪,たえられない。","tok":[["わたし"],["に"],["は"],["、"],["あなた"],["がた"],["に"],["言うべき","いうべき"],["こと"],["が"],["まだ"],["多く","おおく"],["ある"],["が"],["、"],["あなた"],["がた"],["は"],["今","いま"],["は"],["それ"],["に"],["堪えられない","たえられない"],["。"]]},{"verse":13,"text":"けれども真理,しんりの御霊,みたまが来,くる時,ときには、あなたがたをあらゆる真理,しんりに導,みちびいてくれるであろう。それは自分,じぶんから語,かたるのではなく、その聞,きくところを語,かたり、きたるべき事,ことをあなたがたに知,しらせるであろう。","tok":[["けれど"],["も"],["真理","しんり"],["の"],["御霊","み"],["たま"],["が"],["来る","くる"],["時","とき"],["に"],["は"],["、"],["あなた"],["がた"],["を"],["あらゆる"],["真理","しんり"],["に"],["導いて","みちびいて"],["くれるで"],["あろう"],["。"],["それ"],["は"],["自分","じぶん"],["から"],["語る","かたる"],["ので"],["は"],["なく"],["、"],["その"],["聞く","きく"],["ところ"],["を"],["語り","かたり"],["、"],["きたるべき"],["事","こと"],["を"],["あなた"],["がた"],["に"],["知らせるで","しらせるで"],["あろう"],["。"]]},{"verse":14,"text":"御霊,みたまはわたしに栄光,えいこうを得,えさせるであろう。わたしのものを受,うけて、それをあなたがたに知,しらせるからである。","tok":[["御霊","みたま"],["は"],["わたし"],["に"],["栄光","えいこう"],["を"],["得させるで","えさせるで"],["あろう"],["。"],["わたし"],["の"],["もの"],["を"],["受て","うけて"],["、"],["それ"],["を"],["あなた"],["がた"],["に"],["知らせる","しらせる"],["から"],["で"],["ある"],["。"]]},{"verse":15,"text":"父,ちちがお持,もちになっているものはみな、わたしのものである。御霊,みたまはわたしのものを受,うけて、それをあなたがたに知,しらせるのだと、わたしが言,いったのは、そのためである。","tok":[["父","ちち"],["が"],["お持","おもち"],["に"],["なって"],["いる"],["もの"],["は"],["みな"],["、"],["わたし"],["の"],["もの"],["で"],["ある"],["。"],["御霊","みたま"],["は"],["わたし"],["の"],["もの"],["を"],["受て","うけて"],["、"],["それ"],["を"],["あなた"],["がた"],["に"],["知らせる","しらせる"],["の"],["だ"],["と"],["、"],["わたし"],["が"],["言った","いった"],["の"],["は"],["、"],["その"],["ため"],["で"],["ある"],["。"]]},{"verse":16,"text":"しばらくすれば、あなたがたはもうわたしを見,みなくなる。しかし、またしばらくすれば、わたしに会,あえるであろう」。","tok":[["しばらく"],["すれば"],["、"],["あなた"],["がた"],["は"],["もう"],["わたし"],["を"],["見なく","みなく"],["なる"],["。"],["しかし"],["、"],["また"],["しばらく"],["すれば"],["、"],["わたし"],["に"],["会えるで","あえるで"],["あろう"],["」"],["。"]]},{"verse":17,"text":"そこで、弟子,でしたちのうちのある者,ものは互,たがいに言,いい合,あった、「『しばらくすれば、わたしを見,みなくなる。またしばらくすれば、わたしに会,あえるであろう』と言,いわれ、『わたしの父,ちちのところに行,いく』と言,いわれたのは、いったい、どういうことなのであろう」。","tok":[["そこ"],["で"],["、"],["弟子","でし"],["たち"],["の"],["うち"],["の"],["ある"],["者","もの"],["は"],["互","たがい"],["に"],["言い合った","いいあった"],["、"],["「"],["『"],["しばらく"],["すれば"],["、"],["わたし"],["を"],["見なく","みなく"],["なる"],["。"],["また"],["しばらく"],["すれば"],["、"],["わたし"],["に"],["会えるで","あえるで"],["あろう"],["』"],["と"],["言われ","いわれ"],["、"],["『"],["わたし"],["の"],["父","ちち"],["の"],["ところ"],["に"],["行く","いく"],["』"],["と"],["言われた","いわれた"],["の"],["は"],["、"],["いったい"],["、"],["どういう"],["こと"],["な"],["ので"],["あろう"],["」"],["。"]]},{"verse":18,"text":"彼,かれらはまた言,いった、「『しばらくすれば』と言,いわれるのは、どういうことか。わたしたちには、その言葉,ことばの意味,いみがわからない」。","tok":[["彼","かれ"],["ら"],["は"],["また"],["言った","いった"],["、"],["「"],["『"],["しばらく"],["すれば"],["』"],["と"],["言われる","いわれる"],["の"],["は"],["、"],["どういう"],["こと"],["か"],["。"],["わたしたち"],["に"],["は"],["、"],["その"],["言葉","ことば"],["の"],["意味","いみ"],["が"],["わからない"],["」"],["。"]]},{"verse":19,"text":"イエスは、彼,かれらが尋,たずねたがっていることに気,きがついて、彼,かれらに言,いわれた、「しばらくすればわたしを見,みなくなる、またしばらくすればわたしに会,あえるであろうと、わたしが言,いったことで、互,たがいに論,ろんじ合,あっているのか。","tok":[["イエス"],["は"],["、"],["彼","かれ"],["ら"],["が"],["尋ねたがって","たずねたがって"],["いる"],["こと"],["に"],["気","き"],["が"],["ついて"],["、"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["しばらく"],["すれば"],["わたし"],["を"],["見なく","みなく"],["なる"],["、"],["また"],["しばらく"],["すれば"],["わたし"],["に"],["会えるで","あえるで"],["あろう"],["と"],["、"],["わたし"],["が"],["言った","いった"],["こと"],["で"],["、"],["互","たがい"],["に"],["論じ合って","ろんじあって"],["いる"],["の"],["か"],["。"]]},{"verse":20,"text":"よくよくあなたがたに言,いっておく。あなたがたは泣,なき悲,かなしむが、この世,よは喜,よろこぶであろう。あなたがたは憂,うれえているが、その憂,うれいは喜,よろこびに変,かわるであろう。","tok":[["よくよく"],["あなた"],["がた"],["に"],["言って","いって"],["おく"],["。"],["あなた"],["がた"],["は"],["泣","なき"],["悲しむ","かなしむ"],["が"],["、"],["この世","このよ"],["は"],["喜こぶで","よろこぶで"],["あろう"],["。"],["あなた"],["がた"],["は"],["憂えて","うれえて"],["いる"],["が"],["、"],["その"],["憂","うれい"],["は"],["喜こび","よろこび"],["に"],["変わるで","かわるで"],["あろう"],["。"]]},{"verse":21,"text":"女,おんなが子,こを産,うむ場合,ばあいには、その時,ときがきたというので、不安,ふあんを感,かんじる。しかし、子,こを産,うんでしまえば、もはやその苦,くるしみをおぼえてはいない。ひとりの人,ひとがこの世,よに生,うまれた、という喜,よろこびがあるためである。","tok":[["女","おんな"],["が"],["子","こ"],["を"],["産む","うむ"],["場合","ばあい"],["に"],["は"],["、"],["その"],["時","とき"],["が"],["きた"],["と"],["いう"],["ので"],["、"],["不安","ふあん"],["を"],["感じる","かんじる"],["。"],["しかし"],["、"],["子","こ"],["を"],["産んで","うんで"],["しまえば"],["、"],["もはや"],["その"],["苦しみ","くるしみ"],["を"],["おぼえて"],["は"],["いない"],["。"],["ひとり"],["の"],["人","ひと"],["が"],["この世","このよ"],["に"],["生まれた","うまれた"],["、"],["と"],["いう"],["喜こび","よろこび"],["が"],["ある"],["ため"],["で"],["ある"],["。"]]},{"verse":22,"text":"このように、あなたがたにも今,いまは不安,ふあんがある。しかし、わたしは再,ふたたびあなたがたと会,あうであろう。そして、あなたがたの心,こころは喜,よろこびに満,みたされるであろう。その喜,よろこびをあなたがたから取,とり去,さる者,ものはいない。","tok":[["この"],["よう"],["に"],["、"],["あなた"],["がた"],["に"],["も"],["今","いま"],["は"],["不安","ふあん"],["が"],["ある"],["。"],["しかし"],["、"],["わたし"],["は"],["再び","ふたたび"],["あなた"],["がた"],["と"],["会うで","あうで"],["あろう"],["。"],["そして"],["、"],["あなた"],["がた"],["の"],["心","こころ"],["は"],["喜こび","よろこび"],["に"],["満たされるで","みたされるで"],["あろう"],["。"],["その"],["喜こび","よろこび"],["を"],["あなた"],["がた"],["から"],["取去る","とりさる"],["者","もの"],["は"],["いない"],["。"]]},{"verse":23,"text":"その日,ひには、あなたがたがわたしに問,とうことは、何,なにもないであろう。よくよくあなたがたに言,いっておく。あなたがたが父,ちちに求,もとめるものはなんでも、わたしの名,なによって下,くださるであろう。","tok":[["その"],["日","ひ"],["に"],["は"],["、"],["あなた"],["がた"],["が"],["わたし"],["に"],["問う","とう"],["こと"],["は"],["、"],["何に","なに"],["も"],["ないで"],["あろう"],["。"],["よくよく"],["あなた"],["がた"],["に"],["言って","いって"],["おく"],["。"],["あなた"],["がた"],["が"],["父","ちち"],["に"],["求める","もとめる"],["もの"],["は"],["なん"],["で"],["も"],["、"],["わたし"],["の"],["名","な"],["によって"],["下さるで","くださるで"],["あろう"],["。"]]},{"verse":24,"text":"今,いままでは、あなたがたはわたしの名,なによって求,もとめたことはなかった。求,もとめなさい、そうすれば、与,あたえられるであろう。そして、あなたがたの喜,よろこびが満,みちあふれるであろう。","tok":[["今まで","いままで"],["は"],["、"],["あなた"],["がた"],["は"],["わたし"],["の"],["名","な"],["によって"],["求めた","もとめた"],["こと"],["は"],["なかった"],["。"],["求め","もとめ"],["なさい"],["、"],["そう"],["すれば"],["、"],["与えられるで","あたえられるで"],["あろう"],["。"],["そして"],["、"],["あなた"],["がた"],["の"],["喜こび","よろこび"],["が"],["満ちあふれるで","みちあふれるで"],["あろう"],["。"]]},{"verse":25,"text":"わたしはこれらのことを比喩,ひゆで話,はなしたが、もはや比喩,ひゆでは話,はなさないで、あからさまに、父,ちちのことをあなたがたに話,はなしてきかせる時,ときが来,くるであろう。","tok":[["わたし"],["は"],["これ"],["ら"],["の"],["こと"],["を"],["比喩","ひゆ"],["で"],["話","はなし"],["た"],["が"],["、"],["もはや"],["比喩","ひゆ"],["で"],["は"],["話さないで","はなさないで"],["、"],["あからさま"],["に"],["、"],["父","ちち"],["の"],["こと"],["を"],["あなた"],["がた"],["に"],["話","はなし"],["て"],["きかせる"],["時","とき"],["が"],["来るで","くるで"],["あろう"],["。"]]},{"verse":26,"text":"その日,ひには、あなたがたは、わたしの名,なによって求,もとめるであろう。わたしは、あなたがたのために父,ちちに願,ねがってあげようとは言,いうまい。","tok":[["その"],["日","ひ"],["に"],["は"],["、"],["あなた"],["がた"],["は"],["、"],["わたし"],["の"],["名","な"],["によって"],["求めるで","もとめるで"],["あろう"],["。"],["わたし"],["は"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["父","ちち"],["に"],["願って","ねがって"],["あげよう"],["と"],["は"],["言うまい","いうまい"],["。"]]},{"verse":27,"text":"父,ちちご自身,じしんがあなたがたを愛,あいしておいでになるからである。それは、あなたがたがわたしを愛,あいしたため、また、わたしが神,かみのみもとからきたことを信,しんじたためである。","tok":[["父","ちち"],["ご自身","ごじしん"],["が"],["あなた"],["がた"],["を"],["愛して","あいして"],["おいで"],["に"],["なる"],["から"],["で"],["ある"],["。"],["それ"],["は"],["、"],["あなた"],["がた"],["が"],["わたし"],["を"],["愛した","あいした"],["ため"],["、"],["また"],["、"],["わたし"],["が"],["神","かみ"],["のみ"],["もと"],["から"],["きた"],["こと"],["を"],["信じた","しんじた"],["ため"],["で"],["ある"],["。"]]},{"verse":28,"text":"わたしは父,ちちから出,でてこの世,よにきたが、またこの世,よを去,さって、父,ちちのみもとに行,いくのである」。","tok":[["わたし"],["は"],["父","ちち"],["から"],["出て","でて"],["この世","このよ"],["に"],["きた"],["が"],["、"],["また"],["この世","このよ"],["を"],["去て","さって"],["、"],["父","ちち"],["のみ"],["もと"],["に"],["行く","いく"],["ので"],["ある"],["」"],["。"]]},{"verse":29,"text":"弟子,でしたちは言,いった、「今,いまはあからさまにお話,はなしになって、少,すこしも比喩,ひゆではお話,はなしになりません。","tok":[["弟子","でし"],["たち"],["は"],["言った","いった"],["、"],["「"],["今","いま"],["は"],["あからさま"],["に"],["お話","おはなし"],["に"],["なって"],["、"],["少し","すこし"],["も"],["比喩","ひゆ"],["で"],["は"],["お話","おはなし"],["に"],["なりません"],["。"]]},{"verse":30,"text":"あなたはすべてのことをご存,ぞんじであり、だれもあなたにお尋,たずねする必要,ひつようのないことが、今,いまわかりました。このことによって、わたしたちはあなたが神,かみからこられたかたであると信,しんじます」。","tok":[["あなた"],["は"],["すべて"],["の"],["こと"],["を"],["ご存じ","ごぞんじ"],["で"],["あり"],["、"],["だれ"],["も"],["あなた"],["に"],["お尋ね","おたずね"],["する"],["必要","ひつよう"],["の"],["ない"],["こと"],["が"],["、"],["今","いま"],["わかりました"],["。"],["この"],["こと"],["によって"],["、"],["わたしたち"],["は"],["あなた"],["が"],["神","かみ"],["から"],["こられた"],["かた"],["で"],["ある"],["と"],["信じます","しんじます"],["」"],["。"]]},{"verse":31,"text":"イエスは答,こたえられた、「あなたがたは今,いま信,しんじているのか。","tok":[["イエス"],["は"],["答","こたえ"],["られた"],["、"],["「"],["あなた"],["がた"],["は"],["今","いま"],["信じて","しんじて"],["いる"],["の"],["か"],["。"]]},{"verse":32,"text":"見,みよ、あなたがたは散,ちらされて、それぞれ自分,じぶんの家,いえに帰,かえり、わたしをひとりだけ残,のこす時,ときが来,くるであろう。いや、すでにきている。しかし、わたしはひとりでいるのではない。父,ちちがわたしと一緒,いっしょにおられるのである。","tok":[["見よ","みよ"],["、"],["あなた"],["がた"],["は"],["散らされて","ちらされて"],["、"],["それぞれ"],["自分","じぶん"],["の"],["家","いえ"],["に"],["帰えり","かえり"],["、"],["わたし"],["を"],["ひとり"],["だけ"],["残す","のこす"],["時","とき"],["が"],["来るで","くるで"],["あろう"],["。"],["いや"],["、"],["すでに"],["きて"],["いる"],["。"],["しかし"],["、"],["わたし"],["は"],["ひとり"],["で"],["いる"],["ので"],["は"],["ない"],["。"],["父","ちち"],["が"],["わたし"],["と"],["一緒","いっしょ"],["に"],["おられる"],["ので"],["ある"],["。"]]},{"verse":33,"text":"これらのことをあなたがたに話,はなしたのは、わたしにあって平安,へいあんを得,えるためである。あなたがたは、この世,よではなやみがある。しかし、勇気,ゆうきを出,だしなさい。わたしはすでに世,よに勝,かっている」。","tok":[["これ"],["ら"],["の"],["こと"],["を"],["あなた"],["がた"],["に"],["話","はなし"],["た"],["の"],["は"],["、"],["わたし"],["に"],["あって"],["平安","へいあん"],["を"],["得る","える"],["ため"],["で"],["ある"],["。"],["あなた"],["がた"],["は"],["、"],["この世","このよ"],["で"],["は"],["なやみ"],["が"],["ある"],["。"],["しかし"],["、"],["勇気","ゆうき"],["を"],["出し","だし"],["なさい"],["。"],["わたし"],["は"],["すでに"],["世","よ"],["に"],["勝って","かって"],["いる"],["」"],["。"]]}]
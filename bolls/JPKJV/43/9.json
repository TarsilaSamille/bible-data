[{"verse":1,"text":"イエスが道,みちをとおっておられるとき、生,うまれつきの盲人,もうじんを見,みられた。","tok":[["イエス"],["が"],["道","みち"],["を"],["とおって"],["おられる"],["とき"],["、"],["生まれつき","うまれつき"],["の"],["盲人","もうじん"],["を"],["見られた","みられた"],["。"]]},{"verse":2,"text":"弟子,でしたちはイエスに尋,たずねて言,いった、「先生,せんせい、この人,ひとが生,うまれつき盲人,もうじんなのは、だれが罪,つみを犯,おかしたためですか。本人,ほんにんですか、それともその両親,りょうしんですか」。","tok":[["弟子","でし"],["たち"],["は"],["イエス"],["に"],["尋ねて","たずねて"],["言った","いった"],["、"],["「"],["先生","せんせい"],["、"],["この"],["人","ひと"],["が"],["生まれつき","うまれつき"],["盲人","もうじん"],["な"],["の"],["は"],["、"],["だれ"],["が"],["罪","つみ"],["を"],["犯した","おかした"],["ため"],["です"],["か"],["。"],["本人","ほんにん"],["です"],["か"],["、"],["それ"],["と"],["も"],["その"],["両親","りょうしん"],["です"],["か"],["」"],["。"]]},{"verse":3,"text":"イエスは答,こたえられた、「本人,ほんにんが罪,つみを犯,おかしたのでもなく、また、その両親,りょうしんが犯,おかしたのでもない。ただ神,かみのみわざが、彼,かれの上,うえに現,あらわれるためである。","tok":[["イエス"],["は"],["答","こたえ"],["られた"],["、"],["「"],["本人","ほんにん"],["が"],["罪","つみ"],["を"],["犯した","おかした"],["ので"],["も"],["なく"],["、"],["また"],["、"],["その"],["両親","りょうしん"],["が"],["犯した","おかした"],["ので"],["も"],["ない"],["。"],["ただ"],["神","かみ"],["のみ"],["わざ"],["が"],["、"],["彼","かれ"],["の"],["上","うえ"],["に"],["現われる","あらわれる"],["ため"],["で"],["ある"],["。"]]},{"verse":4,"text":"わたしたちは、わたしをつかわされたかたのわざを、昼,ひるの間,あいだにしなければならない。夜,よるが来,くる。すると、だれも働,はたらけなくなる。","tok":[["わたしたち"],["は"],["、"],["わたし"],["を"],["つかわされた"],["かた"],["の"],["わざ"],["を"],["、"],["昼","ひる"],["の"],["間","あいだ"],["に"],["しなければ"],["ならない"],["。"],["夜","よる"],["が"],["来る","くる"],["。"],["する"],["と"],["、"],["だれ"],["も"],["働なく","はたらけなく"],["なる"],["。"]]},{"verse":5,"text":"わたしは、この世,よにいる間,あいだは、世,よの光,ひかりである」。","tok":[["わたし"],["は"],["、"],["この世","このよ"],["に"],["いる"],["間","あいだ"],["は"],["、"],["世","よ"],["の"],["光","ひかり"],["で"],["ある"],["」"],["。"]]},{"verse":6,"text":"イエスはそう言,いって、地,ちにつばきをし、そのつばきで、どろをつくり、そのどろを盲人,もうじんの目,めに塗,ぬって言,いわれた、","tok":[["イエス"],["は"],["そう"],["言って","いって"],["、"],["地","ち"],["に"],["つばき"],["を"],["し"],["、"],["その"],["つばき"],["で"],["、"],["どろ"],["を"],["つくり"],["、"],["その"],["どろ"],["を"],["盲人","もうじん"],["の"],["目","め"],["に"],["塗って","ぬって"],["言われた","いわれた"],["、"]]},{"verse":7,"text":"「シロアム（つかわされた者,もの、の意,い）の池,いけに行,いって洗,あらいなさい」。そこで彼,かれは行,いって洗,あらった。そして見,みえるようになって、帰,かえって行,いった。","tok":[["「"],["シロアム"],["（"],["つかわされた"],["者","もの"],["、"],["の"],["意","い"],["）"],["の"],["池","いけ"],["に"],["行って","いって"],["洗","あらい"],["なさい"],["」"],["。"],["そこ"],["で"],["彼","かれ"],["は"],["行って","いって"],["洗った","あらった"],["。"],["そして"],["見える","みえる"],["よう"],["に"],["なって"],["、"],["帰えって","かえって"],["行った","いった"],["。"]]},{"verse":8,"text":"近所,きんじょの人々,ひとびとや、彼,かれがもと、こじきであったのを見知,みしっていた人々,ひとびとが言,いった、「この人,ひとは、すわってこじきをしていた者,ものではないか」。","tok":[["近所","きんじょ"],["の"],["人々","ひとびと"],["や"],["、"],["彼","かれ"],["が"],["もと"],["、"],["こじきで"],["あった"],["の"],["を"],["見知って","みしって"],["いた"],["人々","ひとびと"],["が"],["言った","いった"],["、"],["「"],["この"],["人","ひと"],["は"],["、"],["すわっ"],["てこ"],["じき"],["を"],["して"],["いた"],["者","もの"],["で"],["は"],["ない"],["か"],["」"],["。"]]},{"verse":9,"text":"ある人々,ひとびとは「その人,ひとだ」と言,いい、他,たの人々,ひとびとは「いや、ただあの人,ひとに似,にているだけだ」と言,いった。しかし、本人,ほんにんは「わたしがそれだ」と言,いった。","tok":[["ある"],["人々","ひとびと"],["は"],["「"],["その"],["人","ひと"],["だ"],["」"],["と"],["言い","いい"],["、"],["他","た"],["の"],["人々","ひとびと"],["は"],["「"],["いや"],["、"],["ただ"],["あの"],["人","ひと"],["に"],["似て","にて"],["いる"],["だけ"],["だ"],["」"],["と"],["言った","いった"],["。"],["しかし"],["、"],["本人","ほんにん"],["は"],["「"],["わたし"],["が"],["それ"],["だ"],["」"],["と"],["言った","いった"],["。"]]},{"verse":10,"text":"そこで人々,ひとびとは彼,かれに言,いった、「では、おまえの目,めはどうしてあいたのか」。","tok":[["そこ"],["で"],["人々","ひとびと"],["は"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["で"],["は"],["、"],["おまえ"],["の"],["目","め"],["は"],["どう"],["して"],["あ"],["いた"],["の"],["か"],["」"],["。"]]},{"verse":11,"text":"彼,かれは答,こたえた、「イエスというかたが、どろをつくって、わたしの目,めに塗,ぬり、『シロアムに行,いって洗,あらえ』と言,いわれました。それで、行,いって洗,あらうと、見,みえるようになりました」。","tok":[["彼","かれ"],["は"],["答","こたえ"],["た"],["、"],["「"],["イエス"],["と"],["いう"],["かた"],["が"],["、"],["どろ"],["を"],["つくって"],["、"],["わたし"],["の"],["目","め"],["に"],["塗","ぬり"],["、"],["『"],["シロアム"],["に"],["行って","いって"],["洗え","あらえ"],["』"],["と"],["言われました","いわれました"],["。"],["それ"],["で"],["、"],["行って","いって"],["洗う","あらう"],["と"],["、"],["見える","みえる"],["よう"],["に"],["なりました"],["」"],["。"]]},{"verse":12,"text":"人々,ひとびとは彼,かれに言,いった、「その人,ひとはどこにいるのか」。彼,かれは「知,しりません」と答,こたえた。","tok":[["人々","ひとびと"],["は"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["その"],["人","ひと"],["は"],["どこ"],["に"],["いる"],["の"],["か"],["」"],["。"],["彼","かれ"],["は"],["「"],["知りません","しりません"],["」"],["と"],["答","こたえ"],["た"],["。"]]},{"verse":13,"text":"人々,ひとびとは、もと盲人,もうじんであったこの人,ひとを、パリサイ人,びとたちのところにつれて行,いった。","tok":[["人々","ひとびと"],["は"],["、"],["もと"],["盲人","もうじん"],["で"],["あった"],["この"],["人","ひと"],["を"],["、"],["パリサイ"],["人","びとたち"],["の"],["ところ"],["に"],["つれて"],["行った","いった"],["。"]]},{"verse":14,"text":"イエスがどろをつくって彼,かれの目,めをあけたのは、安息日,あんそくにちであった。","tok":[["イエス"],["が"],["どろ"],["を"],["つくって"],["彼","かれ"],["の"],["目","め"],["を"],["あけた"],["の"],["は"],["、"],["安息日","あん"],["そ"],["く"],["にち"],["で"],["あった"],["。"]]},{"verse":15,"text":"パリサイ人,びとたちもまた、「どうして見,みえるようになったのか」、と彼,かれに尋,たずねた。彼,かれは答,こたえた、「あのかたがわたしの目,めにどろを塗,ぬり、わたしがそれを洗,あらい、そして見,みえるようになりました」。","tok":[["パリサイ"],["人","びとたち"],["も"],["また"],["、"],["「"],["どう"],["して"],["見える","みえる"],["よう"],["に"],["なった"],["の"],["か"],["」"],["、"],["と"],["彼","かれ"],["に"],["尋ねた","たずねた"],["。"],["彼","かれ"],["は"],["答","こたえ"],["た"],["、"],["「"],["あの"],["かた"],["が"],["わたし"],["の"],["目","め"],["に"],["どろ"],["を"],["塗","ぬり"],["、"],["わたし"],["が"],["それ"],["を"],["洗","あらい"],["、"],["そして"],["見える","みえる"],["よう"],["に"],["なりました"],["」"],["。"]]},{"verse":16,"text":"そこで、あるパリサイ人,びとたちが言,いった、「その人,ひとは神,かみからきた人,ひとではない。安息日,あんそくにちを守,まもっていないのだから」。しかし、ほかの人々,ひとびとは言,いった、「罪,つみのある人,ひとが、どうしてそのようなしるしを行,おこなうことができようか」。そして彼,かれらの間,あいだに分争,ぶんそうが生,しょうじた。","tok":[["そこ"],["で"],["、"],["ある"],["パリサイ"],["人","びと"],["たち"],["が"],["言った","いった"],["、"],["「"],["その"],["人","ひと"],["は"],["神","かみ"],["から"],["きた"],["人","ひと"],["で"],["は"],["ない"],["。"],["安息日","あんそくにち"],["を"],["守って","まもって"],["いない"],["の"],["だ"],["から"],["」"],["。"],["しかし"],["、"],["ほか"],["の"],["人々","ひとびと"],["は"],["言った","いった"],["、"],["「"],["罪","つみ"],["の"],["ある"],["人","ひと"],["が"],["、"],["どう"],["して"],["その"],["よう"],["な"],["しるし"],["を"],["行なう","おこなう"],["こと"],["が"],["できよう"],["か"],["」"],["。"],["そして"],["彼","かれ"],["ら"],["の"],["間","あいだ"],["に"],["分争","ぶんそう"],["が"],["生じた","しょうじた"],["。"]]},{"verse":17,"text":"そこで彼,かれらは、もう一度,どこの盲人,もうじんに聞,きいた、「おまえの目,めをあけてくれたその人,ひとを、どう思,おもうか」。「預言者,よげんしゃだと思,おもいます」と彼,かれは言,いった。","tok":[["そこ"],["で"],["彼","かれ"],["ら"],["は"],["、"],["もう"],["一度","どこ"],["の"],["盲人","もうじん"],["に"],["聞いた","きいた"],["、"],["「"],["おまえ"],["の"],["目","め"],["を"],["あけて"],["くれた"],["その"],["人","ひと"],["を"],["、"],["どう"],["思","おもう"],["か"],["」"],["。"],["「"],["預言者","よげんしゃ"],["だ"],["と"],["思います","おもいます"],["」"],["と"],["彼","かれ"],["は"],["言った","いった"],["。"]]},{"verse":18,"text":"ユダヤ人,じんたちは、彼,かれがもと盲人,もうじんであったが見,みえるようになったことを、まだ信,しんじなかった。ついに彼,かれらは、目,めが見,みえるようになったこの人,ひとの両親,りょうしんを呼,よんで、","tok":[["ユダヤ人","ゆだやじん"],["たち"],["は"],["、"],["彼","かれ"],["が"],["もと"],["盲人","もうじん"],["で"],["あった"],["が"],["見える","みえる"],["よう"],["に"],["なった"],["こと"],["を"],["、"],["まだ"],["信じなかった","しんじなかった"],["。"],["ついに"],["彼","かれ"],["ら"],["は"],["、"],["目","め"],["が"],["見える","みえる"],["よう"],["に"],["なった"],["この"],["人","ひと"],["の"],["両親","りょうしん"],["を"],["呼んで","よんで"],["、"]]},{"verse":19,"text":"尋,たずねて言,いった、「これが、生,うまれつき盲人,もうじんであったと、おまえたちの言,いっているむすこか。それではどうして、いま目,めが見,みえるのか」。","tok":[["尋ねて","たずねて"],["言った","いった"],["、"],["「"],["これ"],["が"],["、"],["生まれつき","うまれつき"],["盲人","もうじん"],["で"],["あった"],["と"],["、"],["おまえ"],["たち"],["の"],["言って","いって"],["いる"],["むすこ"],["か"],["。"],["それ"],["で"],["は"],["どう"],["して"],["、"],["いま目","いまめ"],["が"],["見える","みえる"],["の"],["か"],["」"],["。"]]},{"verse":20,"text":"両親,りょうしんは答,こたえて言,いった、「これがわたしどものむすこであること、また生,うまれつき盲人,もうじんであったことは存,ぞんじています。","tok":[["両親","りょうしん"],["は"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["これ"],["が"],["わたし"],["ども"],["の"],["むすこ"],["で"],["ある"],["こと"],["、"],["また"],["生まれつき","うまれつき"],["盲人","もうじん"],["で"],["あった"],["こと"],["は"],["存じて","ぞんじて"],["います"],["。"]]},{"verse":21,"text":"しかし、どうしていま見,みえるようになったのか、それは知,しりません。また、だれがその目,めをあけて下,くださったのかも知,しりません。あれに聞,きいて下,ください。あれはもうおとなですから、自分,じぶんのことは自分,じぶんで話,はなせるでしょう」。","tok":[["しかし"],["、"],["どう"],["して"],["いま"],["見える","みえる"],["よう"],["に"],["なった"],["の"],["か"],["、"],["それ"],["は"],["知りません","しりません"],["。"],["また"],["、"],["だれ"],["が"],["その"],["目","め"],["を"],["あけて"],["下さった","くださった"],["の"],["か"],["も"],["知りません","しりません"],["。"],["あれ"],["に"],["聞いて","きいて"],["下さい","ください"],["。"],["あれ"],["は"],["もう"],["おとな"],["です"],["から"],["、"],["自分","じぶん"],["の"],["こと"],["は"],["自分","じぶん"],["で"],["話せるでしょう","はなせるでしょう"],["」"],["。"]]},{"verse":22,"text":"両親,りょうしんはユダヤ人,じんたちを恐,おそれていたので、こう答,こたえたのである。それは、もしイエスをキリストと告白,こくはくする者,ものがあれば、会堂,かいどうから追,おい出,だすことに、ユダヤ人,じんたちが既,すでに決,きめていたからである。","tok":[["両親","りょうしん"],["は"],["ユダヤ人","ゆだやじん"],["たち"],["を"],["恐れて","おそれて"],["いた"],["ので"],["、"],["こう"],["答","こたえ"],["た"],["ので"],["ある"],["。"],["それ"],["は"],["、"],["もし"],["イエス"],["を"],["キリスト"],["と"],["告白","こくはく"],["する"],["者","もの"],["が"],["あれば"],["、"],["会堂","かいどう"],["から"],["追い出す","おいだす"],["こと"],["に"],["、"],["ユダヤ人","ゆだやじん"],["たち"],["が"],["既に","すでに"],["決めて","きめて"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":23,"text":"彼,かれの両親,りょうしんが「おとなですから、あれに聞,きいて下,ください」と言,いったのは、そのためであった。","tok":[["彼","かれ"],["の"],["両親","りょうしん"],["が"],["「"],["おとな"],["です"],["から"],["、"],["あれ"],["に"],["聞いて","きいて"],["下さい","ください"],["」"],["と"],["言った","いった"],["の"],["は"],["、"],["その"],["ため"],["で"],["あった"],["。"]]},{"verse":24,"text":"そこで彼,かれらは、盲人,もうじんであった人,ひとをもう一度,いちど呼,よんで言,いった、「神,かみに栄光,えいこうを帰,きするがよい。あの人,ひとが罪人,つみびとであることは、わたしたちにはわかっている」。","tok":[["そこ"],["で"],["彼","かれ"],["ら"],["は"],["、"],["盲人","もうじん"],["で"],["あった"],["人","ひと"],["を"],["もう"],["一度","いちど"],["呼んで","よんで"],["言った","いった"],["、"],["「"],["神","かみ"],["に"],["栄光","えいこう"],["を"],["帰する","きする"],["が"],["よい"],["。"],["あの"],["人","ひと"],["が"],["罪人","つみび"],["と"],["で"],["ある"],["こと"],["は"],["、"],["わたしたち"],["に"],["は"],["わかって"],["いる"],["」"],["。"]]},{"verse":25,"text":"すると彼,かれは言,いった、「あのかたが罪人,つみびとであるかどうか、わたしは知,しりません。ただ一つのことだけ知,しっています。わたしは盲,めくらであったが、今,いまは見,みえるということです」。","tok":[["する"],["と"],["彼","かれ"],["は"],["言った","いった"],["、"],["「"],["あの"],["かた"],["が"],["罪人","つみび"],["と"],["で"],["ある"],["か"],["どう"],["か"],["、"],["わたし"],["は"],["知りません","しりません"],["。"],["ただ"],["一","ひと"],["つ"],["の"],["こと"],["だけ"],["知って","しって"],["います"],["。"],["わたし"],["は"],["盲","めく"],["ら"],["で"],["あった"],["が"],["、"],["今","いま"],["は"],["見える","みえる"],["と"],["いう"],["こと"],["です"],["」"],["。"]]},{"verse":26,"text":"そこで彼,かれらは言,いった、「その人,ひとはおまえに何,なにをしたのか。どんなにしておまえの目,めをあけたのか」。","tok":[["そこ"],["で"],["彼","かれ"],["ら"],["は"],["言った","いった"],["、"],["「"],["その"],["人","ひと"],["は"],["おまえ"],["に"],["何に","なに"],["を"],["した"],["の"],["か"],["。"],["どんな"],["に"],["して"],["おまえ"],["の"],["目","め"],["を"],["あけた"],["の"],["か"],["」"],["。"]]},{"verse":27,"text":"彼,かれは答,こたえた、「そのことはもう話,はなしてあげたのに、聞,きいてくれませんでした。なぜまた聞,きこうとするのですか。あなたがたも、あの人,ひとの弟子,でしになりたいのですか」。","tok":[["彼","かれ"],["は"],["答","こたえ"],["た"],["、"],["「"],["その"],["こと"],["は"],["もう"],["話","はなし"],["て"],["あげた"],["のに"],["、"],["聞いて","きいて"],["くれませんでした"],["。"],["なぜ"],["また"],["聞こう","きこう"],["と"],["する"],["の"],["です"],["か"],["。"],["あなた"],["がた"],["も"],["、"],["あの"],["人","ひと"],["の"],["弟子","でし"],["に"],["なりたい"],["の"],["です"],["か"],["」"],["。"]]},{"verse":28,"text":"そこで彼,かれらは彼,かれをののしって言,いった、「おまえはあれの弟子,でしだが、わたしたちはモーセの弟子,でしだ。","tok":[["そこ"],["で"],["彼","かれ"],["ら"],["は"],["彼","かれ"],["を"],["ののしって"],["言った","いった"],["、"],["「"],["おまえ"],["は"],["あれ"],["の"],["弟子","でし"],["だ"],["が"],["、"],["わたしたち"],["は"],["モーセ"],["の"],["弟子","でし"],["だ"],["。"]]},{"verse":29,"text":"モーセに神,かみが語,かたられたということは知,しっている。だが、あの人,ひとがどこからきた者,ものか、わたしたちは知,しらぬ」。","tok":[["モーセ"],["に"],["神","かみ"],["が"],["語られた","かたられた"],["と"],["いう"],["こと"],["は"],["知って","しって"],["いる"],["。"],["だ"],["が"],["、"],["あの"],["人","ひと"],["が"],["どこ"],["から"],["きた"],["者","もの"],["か"],["、"],["わたしたち"],["は"],["知らぬ","しらぬ"],["」"],["。"]]},{"verse":30,"text":"そこで彼,かれが答,こたえて言,いった、「わたしの目,めをあけて下,くださったのに、そのかたがどこからきたか、ご存,ぞんじないとは、不思議,ふしぎ千万,せんばんです。","tok":[["そこ"],["で"],["彼","かれ"],["が"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["わたし"],["の"],["目","め"],["を"],["あけて"],["下さった","くださった"],["のに"],["、"],["その"],["かた"],["が"],["どこ"],["から"],["きた"],["か"],["、"],["ご存じ","ごぞんじ"],["ない"],["と"],["は"],["、"],["不思議","ふしぎ"],["千万","せんばん"],["です"],["。"]]},{"verse":31,"text":"わたしたちはこのことを知,しっています。神,かみは罪人,つみびとの言,いうことはお聞,ききいれになりませんが、神,かみを敬,うやまい、そのみこころを行,おこなう人,ひとの言,いうことは、聞,ききいれて下,くださいます。","tok":[["わたしたち"],["は"],["この"],["こと"],["を"],["知って","しって"],["います"],["。"],["神","かみ"],["は"],["罪人","つみびと"],["の"],["言う","いう"],["こと"],["は"],["お聞きいれ","おききいれ"],["に"],["なりません"],["が"],["、"],["神","かみ"],["を"],["敬い","うやまい"],["、"],["その"],["みこころ"],["を"],["行なう","おこなう"],["人","ひと"],["の"],["言う","いう"],["こと"],["は"],["、"],["聞きいれて","ききいれて"],["下さいます","くださいます"],["。"]]},{"verse":32,"text":"生,うまれつき盲,めくらであった者,ものの目,めをあけた人,ひとがあるということは、世界,せかいが始,はじまって以来,いらい、聞,きいたことがありません。","tok":[["生まれつき","うまれつき"],["盲","めく"],["ら"],["で"],["あった"],["者","もの"],["の"],["目","め"],["を"],["あけた"],["人","ひと"],["が"],["ある"],["と"],["いう"],["こと"],["は"],["、"],["世界","せかい"],["が"],["始まって","はじまって"],["以来","いらい"],["、"],["聞いた","きいた"],["こと"],["が"],["ありません"],["。"]]},{"verse":33,"text":"もしあのかたが神,かみからきた人,ひとでなかったら、何一,なにひとつできなかったはずです」。","tok":[["もし"],["あの"],["かた"],["が"],["神","かみ"],["から"],["きた"],["人","ひと"],["で"],["なかったら"],["、"],["何","なん"],["一","いち"],["に"],["ひと"],["つ"],["できなかった"],["はず"],["です"],["」"],["。"]]},{"verse":34,"text":"これを聞,きいて彼,かれらは言,いった、「おまえは全,まったく罪,つみの中,なかに生,うまれていながら、わたしたちを教,おしえようとするのか」。そして彼,かれを外,そとへ追,おい出,だした。","tok":[["これ"],["を"],["聞いて","きいて"],["彼","かれ"],["ら"],["は"],["言った","いった"],["、"],["「"],["おまえ"],["は"],["全く","まったく"],["罪","つみ"],["の"],["中","なか"],["に"],["生まれて","うまれて"],["い"],["ながら"],["、"],["わたしたち"],["を"],["教えよう","おしえよう"],["と"],["する"],["の"],["か"],["」"],["。"],["そして"],["彼","かれ"],["を"],["外","そと"],["へ"],["追い出した","おいだした"],["。"]]},{"verse":35,"text":"イエスは、その人,ひとが外,そとへ追,おい出,だされたことを聞,きかれた。そして彼,かれに会,あって言,いわれた、「あなたは人,ひとの子,こを信,しんじるか」。","tok":[["イエス"],["は"],["、"],["その"],["人","ひと"],["が"],["外","そと"],["へ"],["追い出された","おいだされた"],["こと"],["を"],["聞かれた","きかれた"],["。"],["そして"],["彼","かれ"],["に"],["会って","あって"],["言われた","いわれた"],["、"],["「"],["あなた"],["は"],["人","ひと"],["の"],["子","こ"],["を"],["信じる","しんじる"],["か"],["」"],["。"]]},{"verse":36,"text":"彼,かれは答,こたえて言,いった、「主,しゅよ、それはどなたですか。そのかたを信,しんじたいのですが」。","tok":[["彼","かれ"],["は"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["主","しゅ"],["よ"],["、"],["それ"],["は"],["どなた"],["です"],["か"],["。"],["その"],["かた"],["を"],["信じたい","しんじたい"],["の"],["です"],["が"],["」"],["。"]]},{"verse":37,"text":"イエスは彼,かれに言,いわれた、「あなたは、もうその人,ひとに会,あっている。今,いまあなたと話,はなしているのが、その人,ひとである」。","tok":[["イエス"],["は"],["彼","かれ"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["は"],["、"],["もう"],["その"],["人","ひと"],["に"],["会って","あって"],["いる"],["。"],["今","いま"],["あなた"],["と"],["話","はなし"],["て"],["いる"],["の"],["が"],["、"],["その"],["人","ひと"],["で"],["ある"],["」"],["。"]]},{"verse":38,"text":"すると彼,かれは、「主,しゅよ、信,しんじます」と言,いって、イエスを拝,はいした。","tok":[["する"],["と"],["彼","かれ"],["は"],["、"],["「"],["主","しゅ"],["よ"],["、"],["信じます","しんじます"],["」"],["と"],["言って","いって"],["、"],["イエス"],["を"],["拝した","はいした"],["。"]]},{"verse":39,"text":"そこでイエスは言,いわれた、「わたしがこの世,よにきたのは、さばくためである。すなわち、見,みえない人,ひとたちが見,みえるようになり、見,みえる人,ひとたちが見,みえないようになるためである」。","tok":[["そこ"],["で"],["イエス"],["は"],["言われた","いわれた"],["、"],["「"],["わたし"],["が"],["この世","このよ"],["に"],["きた"],["の"],["は"],["、"],["さばく"],["ため"],["で"],["ある"],["。"],["すなわち"],["、"],["見えない","みえない"],["人","ひと"],["たち"],["が"],["見える","みえる"],["よう"],["に"],["なり"],["、"],["見える","みえる"],["人","ひと"],["たち"],["が"],["見えない","みえない"],["よう"],["に"],["なる"],["ため"],["で"],["ある"],["」"],["。"]]},{"verse":40,"text":"そこにイエスと一緒,いっしょにいたあるパリサイ人,びとたちが、それを聞,きいてイエスに言,いった、「それでは、わたしたちも盲,めくらなのでしょうか」。","tok":[["そこ"],["に"],["イエス"],["と"],["一緒","いっしょ"],["に"],["いた"],["ある"],["パリサイ"],["人","びと"],["たち"],["が"],["、"],["それ"],["を"],["聞いて","きいて"],["イエス"],["に"],["言った","いった"],["、"],["「"],["それ"],["で"],["は"],["、"],["わたしたち"],["も"],["盲","めくらな"],["の"],["でしょう"],["か"],["」"],["。"]]},{"verse":41,"text":"イエスは彼,かれらに言,いわれた、「もしあなたがたが盲人,もうじんであったなら、罪,つみはなかったであろう。しかし、今,いまあなたがたが『見,みえる』と言,いい張,はるところに、あなたがたの罪,つみがある。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["もし"],["あなた"],["がた"],["が"],["盲人","もうじん"],["で"],["あったなら"],["、"],["罪","つみ"],["は"],["なかったで"],["あろう"],["。"],["しかし"],["、"],["今","いま"],["あなた"],["がた"],["が"],["『"],["見える","みえる"],["』"],["と"],["言い張る","いいはる"],["ところ"],["に"],["、"],["あなた"],["がた"],["の"],["罪","つみ"],["が"],["ある"],["。"]]}]
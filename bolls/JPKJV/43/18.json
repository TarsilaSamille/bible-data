[{"verse":1,"text":"イエスはこれらのことを語,かたり終,おえて、弟子,でしたちと一緒,いっしょにケデロンの谷,たにの向,むこうへ行,いかれた。そこには園,そのがあって、イエスは弟子,でしたちと一緒,いっしょにその中,なかにはいられた。","tok":[["イエス"],["は"],["これ"],["ら"],["の"],["こと"],["を"],["語り","かたり"],["終えて","おえて"],["、"],["弟子","でし"],["たち"],["と"],["一緒","いっしょ"],["に"],["ケデロン"],["の"],["谷","たに"],["の"],["向こう","むこう"],["へ"],["行かれた","いかれた"],["。"],["そこ"],["に"],["は"],["園","その"],["が"],["あって"],["、"],["イエス"],["は"],["弟子","でし"],["たち"],["と"],["一緒","いっしょ"],["に"],["その"],["中","なか"],["に"],["は"],["いられた"],["。"]]},{"verse":2,"text":"イエスを裏切,うらぎったユダは、その所,ところをよく知,しっていた。イエスと弟子,でしたちとがたびたびそこで集,あつまったことがあるからである。","tok":[["イエス"],["を"],["裏切った","うらぎった"],["ユダ"],["は"],["、"],["その"],["所","ところ"],["を"],["よく"],["知って","しって"],["いた"],["。"],["イエス"],["と"],["弟子","でし"],["たち"],["と"],["が"],["たびたび"],["そこ"],["で"],["集まった","あつまった"],["こと"],["が"],["ある"],["から"],["で"],["ある"],["。"]]},{"verse":3,"text":"さてユダは、一隊,いったいの兵卒,へいそつと祭司長,さいしちょうやパリサイ人,びとたちの送,おくった下役,したやくどもを引,ひき連,つれ、たいまつやあかりや武器,ぶきを持,もって、そこへやってきた。","tok":[["さて"],["ユダ"],["は"],["、"],["一隊","いったい"],["の"],["兵卒","へいそつ"],["と"],["祭司長","さいしちょう"],["や"],["パリサイ"],["人","びとたち"],["の"],["送った","おくった"],["下役","したやく"],["ども"],["を"],["引連れ","ひきつれ"],["、"],["たいまつ"],["や"],["あかり"],["や"],["武器","ぶき"],["を"],["持って","もって"],["、"],["そこ"],["へ"],["やって"],["きた"],["。"]]},{"verse":4,"text":"しかしイエスは、自分,じぶんの身,みに起,おころうとすることをことごとく承知,しょうちしておられ、進,すすみ出,でて彼,かれらに言,いわれた、「だれを捜,さがしているのか」。","tok":[["しかし"],["イエス"],["は"],["、"],["自分","じぶん"],["の"],["身","み"],["に"],["起ころう","おころう"],["と"],["する"],["こと"],["を"],["ことごとく"],["承知","しょうち"],["して"],["おられ"],["、"],["進み出て","すすみでて"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["だれ"],["を"],["捜して","さがして"],["いる"],["の"],["か"],["」"],["。"]]},{"verse":5,"text":"彼,かれらは「ナザレのイエスを」と答,こたえた。イエスは彼,かれらに言,いわれた、「わたしが、それである」。イエスを裏切,うらぎったユダも、彼,かれらと一緒,いっしょに立,たっていた。","tok":[["彼","かれ"],["ら"],["は"],["「"],["ナザレ"],["の"],["イエス"],["を"],["」"],["と"],["答","こたえ"],["た"],["。"],["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["、"],["「"],["わたし"],["が"],["、"],["それ"],["で"],["ある"],["」"],["。"],["イエス"],["を"],["裏切った","うらぎった"],["ユダ"],["も"],["、"],["彼","かれ"],["ら"],["と"],["一緒","いっしょ"],["に"],["立って","たって"],["いた"],["。"]]},{"verse":6,"text":"イエスが彼,かれらに「わたしが、それである」と言,いわれたとき、彼,かれらはうしろに引,ひきさがって地,ちに倒,たおれた。","tok":[["イエス"],["が"],["彼","かれ"],["ら"],["に"],["「"],["わたし"],["が"],["、"],["それ"],["で"],["ある"],["」"],["と"],["言われた","いわれた"],["とき"],["、"],["彼","かれ"],["ら"],["は"],["うしろ"],["に"],["引","ひき"],["さがって"],["地","ち"],["に"],["倒れた","たおれた"],["。"]]},{"verse":7,"text":"そこでまた彼,かれらに、「だれを捜,さがしているのか」とお尋,たずねになると、彼,かれらは「ナザレのイエスを」と言,いった。","tok":[["そこ"],["で"],["また"],["彼","かれ"],["ら"],["に"],["、"],["「"],["だれ"],["を"],["捜して","さがして"],["いる"],["の"],["か"],["」"],["と"],["お尋ね","おたずね"],["に"],["なる"],["と"],["、"],["彼","かれ"],["ら"],["は"],["「"],["ナザレ"],["の"],["イエス"],["を"],["」"],["と"],["言った","いった"],["。"]]},{"verse":8,"text":"イエスは答,こたえられた、「わたしがそれであると、言,いったではないか。わたしを捜,さがしているのなら、この人,ひとたちを去,さらせてもらいたい」。","tok":[["イエス"],["は"],["答","こたえ"],["られた"],["、"],["「"],["わたし"],["が"],["それ"],["で"],["ある"],["と"],["、"],["言ったで","いったで"],["は"],["ない"],["か"],["。"],["わたし"],["を"],["捜して","さがして"],["いる"],["の"],["なら"],["、"],["この"],["人","ひと"],["たち"],["を"],["去らせて","さらせて"],["もらいたい"],["」"],["。"]]},{"verse":9,"text":"それは、「あなたが与,あたえて下,くださった人,ひとたちの中,なかのひとりも、わたしは失,うしなわなかった」とイエスの言,いわれた言葉,ことばが、成就,じょうじゅするためである。","tok":[["それ"],["は"],["、"],["「"],["あなた"],["が"],["与","あたえ"],["て"],["下さった","くださった"],["人","ひと"],["たち"],["の"],["中","なか"],["の"],["ひとり"],["も"],["、"],["わたし"],["は"],["失なわなかった","うしなわなかった"],["」"],["と"],["イエス"],["の"],["言われた","いわれた"],["言葉","ことば"],["が"],["、"],["成就","じょうじゅ"],["する"],["ため"],["で"],["ある"],["。"]]},{"verse":10,"text":"シモン・ペテロは剣,けんを持,もっていたが、それを抜,ぬいて、大祭司,だいさいしの僕,しもべに切,きりかかり、その右,みぎの耳,みみを切,きり落,おとした。その僕,しもべの名,なはマルコスであった。","tok":[["シモン"],["・"],["ペテロ"],["は"],["剣","けん"],["を"],["持って","もって"],["いた"],["が"],["、"],["それ"],["を"],["抜いて","ぬいて"],["、"],["大","だい"],["祭司","さいし"],["の"],["僕","し"],["も"],["べ"],["に"],["切り","きり"],["かかり"],["、"],["その"],["右","みぎ"],["の"],["耳","みみ"],["を"],["切り落とした","きりおとした"],["。"],["その"],["僕","し"],["も"],["べ"],["の"],["名","な"],["は"],["マルコス"],["で"],["あった"],["。"]]},{"verse":11,"text":"すると、イエスはペテロに言,いわれた、「剣,けんをさやに納,おさめなさい。父,ちちがわたしに下,くださった杯,さかずきは、飲,のむべきではないか」。","tok":[["する"],["と"],["、"],["イエス"],["は"],["ペテロ"],["に"],["言われた","いわれた"],["、"],["「"],["剣","けん"],["を"],["さや"],["に"],["納","おさめ"],["なさい"],["。"],["父","ちち"],["が"],["わたし"],["に"],["下さった","くださった"],["杯","さかずき"],["は"],["、"],["飲むべきで","のむべきで"],["は"],["ない"],["か"],["」"],["。"]]},{"verse":12,"text":"それから一隊,いったいの兵卒,へいそつやその千卒長,せんそつちょうやユダヤ人,じんの下役,したやくどもが、イエスを捕,とらえ、縛,しばりあげて、","tok":[["それ"],["から"],["一隊","いったい"],["の"],["兵卒","へいそつ"],["や"],["その"],["千卒長","せんそつちょう"],["や"],["ユダヤ人","ゆだやじん"],["の"],["下役","したやく"],["ども"],["が"],["、"],["イエス"],["を"],["捕らえ","とらえ"],["、"],["縛りあげて","しばりあげて"],["、"]]},{"verse":13,"text":"まずアンナスのところに引,ひき連,つれて行,いった。彼,かれはその年,としの大祭司,だいさいしカヤパのしゅうとであった。","tok":[["まず"],["アンナス"],["の"],["ところ"],["に"],["引連れて","ひきつれて"],["行った","いった"],["。"],["彼","かれ"],["は"],["その"],["年","とし"],["の"],["大","だい"],["祭司","さいし"],["カヤパ"],["の"],["しゅうと"],["で"],["あった"],["。"]]},{"verse":14,"text":"カヤパは前,まえに、ひとりの人,ひとが民,たみのために死,しぬのはよいことだと、ユダヤ人,じんに助言,じょげんした者,ものであった。","tok":[["カヤパ"],["は"],["前","まえ"],["に"],["、"],["ひとり"],["の"],["人","ひと"],["が"],["民","たみ"],["の"],["ため"],["に"],["死ぬ","しぬ"],["の"],["は"],["よい"],["こと"],["だ"],["と"],["、"],["ユダヤ人","ゆだやじん"],["に"],["助言","じょげん"],["した"],["者","もの"],["で"],["あった"],["。"]]},{"verse":15,"text":"シモン・ペテロともうひとりの弟子,でしとが、イエスについて行,いった。この弟子,でしは大祭司,だいさいしの知,しり合,あいであったので、イエスと一緒,いっしょに大祭司,だいさいしの中庭,なかにわにはいった。","tok":[["シモン"],["・"],["ペテロ"],["と"],["もう"],["ひとり"],["の"],["弟子","でし"],["と"],["が"],["、"],["イエス"],["について"],["行った","いった"],["。"],["この"],["弟子","でし"],["は"],["大","だい"],["祭司","さいし"],["の"],["知り合い","しりあい"],["で"],["あった"],["ので"],["、"],["イエス"],["と"],["一緒","いっしょ"],["に"],["大","だい"],["祭司","さいし"],["の"],["中庭","なかにわ"],["に"],["はいった"],["。"]]},{"verse":16,"text":"しかし、ペテロは外,そとで戸口,とぐちに立,たっていた。すると大祭司,だいさいしの知,しり合,あいであるその弟子,でしが、外,そとに出,でて行,いって門番,もんばんの女,おんなに話,はなし、ペテロを内,うちに入,いれてやった。","tok":[["しかし"],["、"],["ペテロ"],["は"],["外","そと"],["で"],["戸口","とぐち"],["に"],["立って","たって"],["いた"],["。"],["する"],["と"],["大","だい"],["祭司","さいし"],["の"],["知り合い","しりあい"],["で"],["ある"],["その"],["弟子","でし"],["が"],["、"],["外","そと"],["に"],["出て","でて"],["行って","いって"],["門番","もんばん"],["の"],["女","おんな"],["に"],["話","はなし"],["、"],["ペテロ"],["を"],["内","うち"],["に"],["入れて","いれて"],["やった"],["。"]]},{"verse":17,"text":"すると、この門番,もんばんの女,おんながペテロに言,いった、「あなたも、あの人,ひとの弟子,でしのひとりではありませんか」。ペテロは「いや、そうではない」と答,こたえた。","tok":[["する"],["と"],["、"],["この"],["門番","もんばん"],["の"],["女","おんな"],["が"],["ペテロ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["も"],["、"],["あの"],["人","ひと"],["の"],["弟子","でし"],["の"],["ひとり"],["で"],["は"],["ありません"],["か"],["」"],["。"],["ペテロ"],["は"],["「"],["いや"],["、"],["そう"],["で"],["は"],["ない"],["」"],["と"],["答","こたえ"],["た"],["。"]]},{"verse":18,"text":"僕,しもべや下役,したやくどもは、寒,さむい時,ときであったので、炭火,すみびをおこし、そこに立,たってあたっていた。ペテロもまた彼,かれらに交,まじり、立,たってあたっていた。","tok":[["僕","し"],["も"],["べや"],["下役","したやく"],["ども"],["は"],["、"],["寒い","さむい"],["時","とき"],["で"],["あった"],["ので"],["、"],["炭火","すみび"],["を"],["おこし"],["、"],["そこ"],["に"],["立って","たって"],["あたって"],["いた"],["。"],["ペテロ"],["も"],["また"],["彼","かれ"],["ら"],["に"],["交じり","まじり"],["、"],["立って","たって"],["あたって"],["いた"],["。"]]},{"verse":19,"text":"大祭司,だいさいしはイエスに、弟子,でしたちのことやイエスの教,おしえのことを尋,たずねた。","tok":[["大","だい"],["祭司","さいし"],["は"],["イエス"],["に"],["、"],["弟子","でし"],["たち"],["の"],["こと"],["や"],["イエス"],["の"],["教え","おしえ"],["の"],["こと"],["を"],["尋ねた","たずねた"],["。"]]},{"verse":20,"text":"イエスは答,こたえられた、「わたしはこの世,よに対,たいして公然,こうぜんと語,かたってきた。すべてのユダヤ人,じんが集,あつまる会堂,かいどうや宮,みやで、いつも教,おしえていた。何事,なにごとも隠,かくれて語,かたったことはない。","tok":[["イエス"],["は"],["答","こたえ"],["られた"],["、"],["「"],["わたし"],["は"],["この世","このよ"],["に対して","にたいして"],["公然","こうぜん"],["と"],["語って","かたって"],["きた"],["。"],["すべて"],["の"],["ユダヤ人","ゆだやじん"],["が"],["集まる","あつまる"],["会堂","かいどう"],["や"],["宮","みや"],["で"],["、"],["いつ"],["も"],["教えて","おしえて"],["いた"],["。"],["何事","なにごと"],["も"],["隠れて","かくれて"],["語った","かたった"],["こと"],["は"],["ない"],["。"]]},{"verse":21,"text":"なぜ、わたしに尋,たずねるのか。わたしが彼,かれらに語,かたったことは、それを聞,きいた人々,ひとびとに尋,たずねるがよい。わたしの言,いったことは、彼,かれらが知,しっているのだから」。","tok":[["なぜ"],["、"],["わたし"],["に"],["尋ねる","たずねる"],["の"],["か"],["。"],["わたし"],["が"],["彼","かれ"],["ら"],["に"],["語った","かたった"],["こと"],["は"],["、"],["それ"],["を"],["聞いた","きいた"],["人々","ひとびと"],["に"],["尋ねる","たずねる"],["が"],["よい"],["。"],["わたし"],["の"],["言った","いった"],["こと"],["は"],["、"],["彼","かれ"],["ら"],["が"],["知って","しって"],["いる"],["の"],["だ"],["から"],["」"],["。"]]},{"verse":22,"text":"イエスがこう言,いわれると、そこに立,たっていた下役,したやくのひとりが、「大祭司,だいさいしにむかって、そのような答,こたえをするのか」と言,いって、平手,ひらてでイエスを打,うった。","tok":[["イエス"],["が"],["こう"],["言われる","いわれる"],["と"],["、"],["そこ"],["に"],["立って","たって"],["いた"],["下役","したやく"],["の"],["ひとり"],["が"],["、"],["「"],["大","だい"],["祭司","さいし"],["に"],["むかって"],["、"],["その"],["よう"],["な"],["答","こたえ"],["を"],["する"],["の"],["か"],["」"],["と"],["言って","いって"],["、"],["平手","ひらて"],["で"],["イエス"],["を"],["打った","うった"],["。"]]},{"verse":23,"text":"イエスは答,こたえられた、「もしわたしが何,なにか悪,わるいことを言,いったのなら、その悪,わるい理由,りゆうを言,いいなさい。しかし、正,ただしいことを言,いったのなら、なぜわたしを打,うつのか」。","tok":[["イエス"],["は"],["答","こたえ"],["られた"],["、"],["「"],["もし"],["わたし"],["が"],["何に","なに"],["か"],["悪い","わるい"],["こと"],["を"],["言った","いった"],["の"],["なら"],["、"],["その"],["悪い","わるい"],["理由","りゆう"],["を"],["言い","いい"],["なさい"],["。"],["しかし"],["、"],["正い","ただしい"],["こと"],["を"],["言った","いった"],["の"],["なら"],["、"],["なぜ"],["わたし"],["を"],["打つ","うつ"],["の"],["か"],["」"],["。"]]},{"verse":24,"text":"それからアンナスは、イエスを縛,しばったまま大祭司,だいさいしカヤパのところへ送,おくった。","tok":[["それ"],["から"],["アンナス"],["は"],["、"],["イエス"],["を"],["縛った","しばった"],["まま"],["大","だい"],["祭司","さいし"],["カヤパ"],["の"],["ところ"],["へ"],["送った","おくった"],["。"]]},{"verse":25,"text":"シモン・ペテロは、立,たって火,ひにあたっていた。すると人々,ひとびとが彼,かれに言,いった、「あなたも、あの人,ひとの弟子,でしのひとりではないか」。彼,かれはそれをうち消,けして、「いや、そうではない」と言,いった。","tok":[["シモン"],["・"],["ペテロ"],["は"],["、"],["立って","たって"],["火","ひ"],["に"],["あたって"],["いた"],["。"],["する"],["と"],["人々","ひとびと"],["が"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["も"],["、"],["あの"],["人","ひと"],["の"],["弟子","でし"],["の"],["ひとり"],["で"],["は"],["ない"],["か"],["」"],["。"],["彼","かれ"],["は"],["それ"],["を"],["うち消して","うちけして"],["、"],["「"],["いや"],["、"],["そう"],["で"],["は"],["ない"],["」"],["と"],["言った","いった"],["。"]]},{"verse":26,"text":"大祭司,だいさいしの僕,しもべのひとりで、ペテロに耳,みみを切,きりおとされた人,ひとの親族,しんぞくの者,ものが言,いった、「あなたが園,そのであの人,ひとと一緒,いっしょにいるのを、わたしは見,みたではないか」。","tok":[["大","だい"],["祭司","さいし"],["の"],["僕","し"],["も"],["べ"],["の"],["ひとり"],["で"],["、"],["ペテロ"],["に"],["耳","みみ"],["を"],["切りおとされた","きりおとされた"],["人","ひと"],["の"],["親族","しんぞく"],["の"],["者","もの"],["が"],["言った","いった"],["、"],["「"],["あなた"],["が"],["園","その"],["で"],["あの"],["人","ひと"],["と"],["一緒","いっしょ"],["に"],["いる"],["の"],["を"],["、"],["わたし"],["は"],["見たで","みたで"],["は"],["ない"],["か"],["」"],["。"]]},{"verse":27,"text":"ペテロはまたそれを打,うち消,けした。するとすぐに、鶏,にわとりが鳴,ないた。","tok":[["ペテロ"],["は"],["また"],["それ"],["を"],["打ち消した","うちけした"],["。"],["する"],["と"],["すぐ"],["に"],["、"],["鶏","にわとり"],["が"],["鳴いた","ないた"],["。"]]},{"verse":28,"text":"それから人々,ひとびとは、イエスをカヤパのところから官邸,かんていにつれて行,いった。時,ときは夜明,よあけであった。彼,かれらは、けがれを受,うけないで過越,すぎこしの食事,しょくじができるように、官邸,かんていにはいらなかった。","tok":[["それ"],["から"],["人々","ひとびと"],["は"],["、"],["イエス"],["を"],["カヤパ"],["の"],["ところ"],["から"],["官邸","かんてい"],["に"],["つれて"],["行った","いった"],["。"],["時","とき"],["は"],["夜明","よあけ"],["で"],["あった"],["。"],["彼","かれ"],["ら"],["は"],["、"],["けがれ"],["を"],["受ないで","うけないで"],["過越","すぎこし"],["の"],["食事","しょくじ"],["が"],["できる"],["よう"],["に"],["、"],["官邸","かんてい"],["に"],["はいらなかった"],["。"]]},{"verse":29,"text":"そこで、ピラトは彼,かれらのところに出,でてきて言,いった、「あなたがたは、この人,ひとに対,たいしてどんな訴,うったえを起,おこすのか」。","tok":[["そこ"],["で"],["、"],["ピラト"],["は"],["彼","かれ"],["ら"],["の"],["ところ"],["に"],["出て","でて"],["きて"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["、"],["この"],["人","ひと"],["に対して","にたいして"],["どんな"],["訴","うったえ"],["を"],["起こす","おこす"],["の"],["か"],["」"],["。"]]},{"verse":30,"text":"彼,かれらはピラトに答,こたえて言,いった、「もしこの人,ひとが悪事,あくじをはたらかなかったなら、あなたに引,ひき渡,わたすようなことはしなかったでしょう」。","tok":[["彼","かれ"],["ら"],["は"],["ピラト"],["に"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["もし"],["この"],["人","ひと"],["が"],["悪事","あくじ"],["を"],["はたらかなかったなら"],["、"],["あなた"],["に"],["引渡す","ひきわたす"],["よう"],["な"],["こと"],["は"],["しなかったでしょう"],["」"],["。"]]},{"verse":31,"text":"そこでピラトは彼,かれらに言,いった、「あなたがたは彼,かれを引,ひき取,とって、自分,じぶんたちの律法,りっぽうでさばくがよい」。ユダヤ人,じんらは彼,かれに言,いった、「わたしたちには、人,ひとを死刑,しけいにする権限,けんげんがありません」。","tok":[["そこ"],["で"],["ピラト"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["彼","かれ"],["を"],["引取って","ひきとって"],["、"],["自分","じぶん"],["たち"],["の"],["律法","りっぽう"],["で"],["さばく"],["が"],["よい"],["」"],["。"],["ユダヤ人","ゆだやじん"],["ら"],["は"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["わたしたち"],["に"],["は"],["、"],["人","ひと"],["を"],["死刑","しけい"],["に"],["する"],["権限","けんげん"],["が"],["ありません"],["」"],["。"]]},{"verse":32,"text":"これは、ご自身,じしんがどんな死,しにかたをしようとしているかを示,しめすために言,いわれたイエスの言葉,ことばが、成就,じょうじゅするためである。","tok":[["これ"],["は"],["、"],["ご自身","ごじしん"],["が"],["どんな"],["死に","しに"],["かた"],["を"],["しよう"],["として"],["いる"],["か"],["を"],["示めす","しめす"],["ため"],["に"],["言われた","いわれた"],["イエス"],["の"],["言葉","ことば"],["が"],["、"],["成就","じょうじゅ"],["する"],["ため"],["で"],["ある"],["。"]]},{"verse":33,"text":"さて、ピラトはまた官邸,かんていにはいり、イエスを呼,よび出,だして言,いった、「あなたは、ユダヤ人,じんの王,おうであるか」。","tok":[["さて"],["、"],["ピラト"],["は"],["また"],["官邸","かんてい"],["に"],["はいり"],["、"],["イエス"],["を"],["呼び出して","よびだして"],["言った","いった"],["、"],["「"],["あなた"],["は"],["、"],["ユダヤ人","ゆだやじん"],["の"],["王","おう"],["で"],["ある"],["か"],["」"],["。"]]},{"verse":34,"text":"イエスは答,こたえられた、「あなたがそう言,いうのは、自分,じぶんの考,かんがえからか。それともほかの人々,ひとびとが、わたしのことをあなたにそう言,いったのか」。","tok":[["イエス"],["は"],["答","こたえ"],["られた"],["、"],["「"],["あなた"],["が"],["そう"],["言う","いう"],["の"],["は"],["、"],["自分","じぶん"],["の"],["考","かんがえ"],["から"],["か"],["。"],["それ"],["と"],["も"],["ほか"],["の"],["人々","ひとびと"],["が"],["、"],["わたし"],["の"],["こと"],["を"],["あなた"],["に"],["そう"],["言った","いった"],["の"],["か"],["」"],["。"]]},{"verse":35,"text":"ピラトは答,こたえた、「わたしはユダヤ人,じんなのか。あなたの同族,どうぞくや祭司長,さいしちょうたちが、あなたをわたしに引,ひき渡,わたしたのだ。あなたは、いったい、何,なにをしたのか」。","tok":[["ピラト"],["は"],["答","こたえ"],["た"],["、"],["「"],["わたし"],["は"],["ユダヤ人","ゆだやじん"],["な"],["の"],["か"],["。"],["あなた"],["の"],["同族","どうぞく"],["や"],["祭司長","さいしちょう"],["たち"],["が"],["、"],["あなた"],["を"],["わたし"],["に"],["引渡","ひきわたし"],["た"],["の"],["だ"],["。"],["あなた"],["は"],["、"],["いったい"],["、"],["何に","なに"],["を"],["した"],["の"],["か"],["」"],["。"]]},{"verse":36,"text":"イエスは答,こたえられた、「わたしの国,くにはこの世,よのものではない。もしわたしの国,くにがこの世,よのものであれば、わたしに従,したがっている者,ものたちは、わたしをユダヤ人,じんに渡,わたさないように戦,たたかったであろう。しかし事実,じじつ、わたしの国,くにはこの世,よのものではない」。","tok":[["イエス"],["は"],["答","こたえ"],["られた"],["、"],["「"],["わたし"],["の"],["国","くに"],["は"],["この世","このよ"],["の"],["もの"],["で"],["は"],["ない"],["。"],["もし"],["わたし"],["の"],["国","くに"],["が"],["この世","このよ"],["の"],["もの"],["で"],["あれば"],["、"],["わたし"],["に"],["従って","したがって"],["いる"],["者","もの"],["たち"],["は"],["、"],["わたし"],["を"],["ユダヤ人","ゆだやじん"],["に"],["渡さない","わたさない"],["よう"],["に"],["戦ったで","たたかったで"],["あろう"],["。"],["しかし"],["事実","じじつ"],["、"],["わたし"],["の"],["国","くに"],["は"],["この世","このよ"],["の"],["もの"],["で"],["は"],["ない"],["」"],["。"]]},{"verse":37,"text":"そこでピラトはイエスに言,いった、「それでは、あなたは王,おうなのだな」。イエスは答,こたえられた、「あなたの言,いうとおり、わたしは王,おうである。わたしは真理,しんりについてあかしをするために生,うまれ、また、そのためにこの世,よにきたのである。だれでも真理,しんりにつく者,ものは、わたしの声,こえに耳,みみを傾,かたむける」。","tok":[["そこ"],["で"],["ピラト"],["は"],["イエス"],["に"],["言った","いった"],["、"],["「"],["それ"],["で"],["は"],["、"],["あなた"],["は"],["王","おう"],["な"],["の"],["だ"],["な"],["」"],["。"],["イエス"],["は"],["答","こたえ"],["られた"],["、"],["「"],["あなた"],["の"],["言う","いう"],["とおり"],["、"],["わたし"],["は"],["王","おう"],["で"],["ある"],["。"],["わたし"],["は"],["真理","しんり"],["について"],["あかし"],["を"],["する"],["ため"],["に"],["生まれ","うまれ"],["、"],["また"],["、"],["その"],["ため"],["に"],["この世","このよ"],["に"],["きた"],["ので"],["ある"],["。"],["だれ"],["で"],["も"],["真理","しんり"],["に"],["つく"],["者","もの"],["は"],["、"],["わたし"],["の"],["声","こえ"],["に"],["耳","みみ"],["を"],["傾むける","かたむける"],["」"],["。"]]},{"verse":38,"text":"ピラトはイエスに言,いった、「真理,しんりとは何,なにか」。こう言,いって、彼,かれはまたユダヤ人,じんの所,ところに出,でて行,いき、彼,かれらに言,いった、「わたしには、この人,ひとになんの罪,つみも見,みいだせない。","tok":[["ピラト"],["は"],["イエス"],["に"],["言った","いった"],["、"],["「"],["真理","しんり"],["と"],["は"],["何に","なに"],["か"],["」"],["。"],["こう"],["言って","いって"],["、"],["彼","かれ"],["は"],["また"],["ユダヤ人","ゆだやじん"],["の"],["所","ところ"],["に"],["出て","でて"],["行き","いき"],["、"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["わたし"],["に"],["は"],["、"],["この"],["人","ひと"],["に"],["なん"],["の"],["罪","つみ"],["も"],["見いだせない","みいだせない"],["。"]]},{"verse":39,"text":"過越,すぎこしの時,ときには、わたしがあなたがたのために、ひとりの人,ひとを許,ゆるしてやるのが、あなたがたのしきたりになっている。ついては、あなたがたは、このユダヤ人,じんの王,おうを許,ゆるしてもらいたいのか」。","tok":[["過越","すぎこし"],["の"],["時","とき"],["に"],["は"],["、"],["わたし"],["が"],["あなた"],["がた"],["の"],["ため"],["に"],["、"],["ひとり"],["の"],["人","ひと"],["を"],["許して","ゆるして"],["やる"],["の"],["が"],["、"],["あなた"],["がた"],["の"],["しきたり"],["に"],["なって"],["いる"],["。"],["ついて"],["は"],["、"],["あなた"],["がた"],["は"],["、"],["この"],["ユダヤ人","ゆだやじん"],["の"],["王","おう"],["を"],["許して","ゆるして"],["もらいたい"],["の"],["か"],["」"],["。"]]},{"verse":40,"text":"すると彼,かれらは、また叫,さけんで「その人,ひとではなく、バラバを」と言,いった。このバラバは強盗,ごうとうであった。","tok":[["する"],["と"],["彼","かれ"],["ら"],["は"],["、"],["また"],["叫けんで","さけんで"],["「"],["その"],["人","ひと"],["で"],["は"],["なく"],["、"],["バラバ"],["を"],["」"],["と"],["言った","いった"],["。"],["この"],["バラバ"],["は"],["強盗","ごうとう"],["で"],["あった"],["。"]]}]
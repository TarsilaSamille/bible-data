[{"verse":1,"text":"「見,みよ、わたしはわが使者,ししゃをつかわす。彼,かれはわたしの前,まえに道,みちを備,そなえる。またあなたがたが求,もとめる所,ところの主,しゅは、たちまちその宮,みやに来,くる。見,みよ、あなたがたの喜,よろこぶ契約,けいやくの使者,ししゃが来,くると、万軍,ばんぐんの主,しゅが言,いわれる。","tok":[["「"],["見よ","みよ"],["、"],["わたし"],["は"],["わが"],["使者","ししゃ"],["を"],["つかわす"],["。"],["彼","かれ"],["は"],["わたし"],["の"],["前","まえ"],["に"],["道","みち"],["を"],["備","そなえ"],["る"],["。"],["また"],["あなた"],["がた"],["が"],["求める","もとめる"],["所","ところ"],["の"],["主","しゅ"],["は"],["、"],["たちまち"],["その"],["宮","みや"],["に"],["来る","くる"],["。"],["見よ","みよ"],["、"],["あなた"],["がた"],["の"],["喜こぶ","よろこぶ"],["契約","けいやく"],["の"],["使者","ししゃ"],["が"],["来る","くる"],["と"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["が"],["言われる","いわれる"],["。"]]},{"verse":2,"text":"その来,くる日,ひには、だれが耐,たえ得,えよう。そのあらわれる時,ときには、だれが立,たち得,えよう。彼,かれは金,きんをふきわける者,ものの火,ひのようであり、布,ぬのさらしの灰汁,あくのようである。","tok":[["その"],["来る","くる"],["日","ひ"],["に"],["は"],["、"],["だれ"],["が"],["耐え","たえ"],["得よう","えよう"],["。"],["その"],["あらわれる"],["時","とき"],["に"],["は"],["、"],["だれ"],["が"],["立ち","たち"],["得よう","えよう"],["。"],["彼","かれ"],["は"],["金","きん"],["を"],["ふきわける"],["者","もの"],["の"],["火","ひ"],["の"],["よう"],["で"],["あり"],["、"],["布","ぬの"],["さらし"],["の"],["灰汁","あく"],["の"],["よう"],["で"],["ある"],["。"]]},{"verse":3,"text":"彼,かれは銀,ぎんをふきわけて清,きよめる者,もののように座,ざして、レビの子孫,しそんを清,きよめ、金銀,きんぎんのように彼,かれらを清,きよめる。そして彼,かれらは義,ぎをもって、ささげ物,ものを主,しゅにささげる。","tok":[["彼","かれ"],["は"],["銀","ぎん"],["を"],["ふきわけて"],["清める","きよめる"],["者","もの"],["の"],["よう"],["に"],["座して","ざして"],["、"],["レビ"],["の"],["子孫","しそん"],["を"],["清め","きよめ"],["、"],["金銀","きんぎん"],["の"],["よう"],["に"],["彼","かれ"],["ら"],["を"],["清める","きよめる"],["。"],["そして"],["彼","かれ"],["ら"],["は"],["義","ぎ"],["を"],["もって"],["、"],["ささげ物","ささげもの"],["を"],["主に","しゅに"],["ささげる"],["。"]]},{"verse":4,"text":"その時,ときユダとエルサレムとのささげ物,ものは、昔,むかしの日,ひのように、また先,さきの年,としのように主,しゅに喜,よろこばれる。","tok":[["その"],["時","とき"],["ユダ"],["と"],["エルサレム"],["と"],["の"],["ささげ物","ささげもの"],["は"],["、"],["昔","むかし"],["の"],["日","ひ"],["の"],["よう"],["に"],["、"],["また"],["先","さき"],["の"],["年","とし"],["の"],["よう"],["に"],["主に","しゅに"],["喜こばれる","よろこばれる"],["。"]]},{"verse":5,"text":"そしてわたしはあなたがたに近,ちかづいて、さばきをなし、占,うらない者,もの、姦淫,かんいんを行,おこなう者,もの、偽,いつわりの誓,ちかいをなす者,ものにむかい、雇人,やといにんの賃銀,ちんぎんをかすめ、やもめと、みなしごとをしえたげ、寄留,きりゅうの他国,たこく人,じんを押,おしのけ、わたしを恐,おそれない者,ものどもにむかって、すみやかにあかしを立,たてると、万軍,ばんぐんの主,しゅは言,いわれる。","tok":[["そして"],["わたし"],["は"],["あなた"],["がた"],["に"],["近づいて","ちかづいて"],["、"],["さばき"],["を"],["なし"],["、"],["占者","うらないもの"],["、"],["姦淫","かんいん"],["を"],["行なう","おこなう"],["者","もの"],["、"],["偽わり","いつわり"],["の"],["誓い","ちかい"],["を"],["なす"],["者","もの"],["に"],["むかい"],["、"],["雇人","やといにん"],["の"],["賃銀","ちんぎん"],["を"],["かすめ"],["、"],["やもめ"],["と"],["、"],["みなし"],["ごと"],["を"],["し"],["えたげ"],["、"],["寄留","きりゅう"],["の"],["他国人","たこくじん"],["を"],["押","おし"],["のけ"],["、"],["わたし"],["を"],["恐れない","おそれない"],["者","もの"],["ども"],["に"],["むかって"],["、"],["すみやか"],["に"],["あかし"],["を"],["立る","たてる"],["と"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":6,"text":"主,しゅなるわたしは変,かわることがない。それゆえ、ヤコブの子,こらよ、あなたがたは滅,ほろぼされない。","tok":[["主","しゅ"],["なる"],["わたし"],["は"],["変わる","かわる"],["こと"],["が"],["ない"],["。"],["それ"],["ゆえ"],["、"],["ヤコブ"],["の"],["子","こ"],["ら"],["よ"],["、"],["あなた"],["がた"],["は"],["滅ぼされない","ほろぼされない"],["。"]]},{"verse":7,"text":"あなたがたは、その先祖,せんぞの日,ひから、わが定,さだめを離,はなれて、これを守,まもらなかった。わたしに帰,かえれ、わたしはあなたがたに帰,かえろうと、万軍,ばんぐんの主,しゅは言,いわれる。ところが、あなたがたは『われわれはどうして帰,かえろうか』と尋,たずねる。","tok":[["あなた"],["がた"],["は"],["、"],["その"],["先祖","せんぞ"],["の"],["日","ひ"],["から"],["、"],["わが"],["定め","さだめ"],["を"],["離れて","はなれて"],["、"],["これ"],["を"],["守らなかった","まもらなかった"],["。"],["わたし"],["に"],["帰えれ","かえれ"],["、"],["わたし"],["は"],["あなた"],["がた"],["に"],["帰えろう","かえろう"],["と"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["言われる","いわれる"],["。"],["ところ"],["が"],["、"],["あなた"],["がた"],["は"],["『"],["われわれ"],["は"],["どう"],["して"],["帰えろう","かえろう"],["か"],["』"],["と"],["尋ねる","たずねる"],["。"]]},{"verse":8,"text":"人,ひとは神,かみの物,ものを盗,ぬすむことをするだろうか。しかしあなたがたは、わたしの物,ものを盗,ぬすんでいる。あなたがたはまた『どうしてわれわれは、あなたの物,ものを盗,ぬすんでいるのか』と言,いう。十分,ぶんの一と、ささげ物,ものをもってである。","tok":[["人","ひと"],["は"],["神","かみ"],["の"],["物","もの"],["を"],["盗む","ぬすむ"],["こと"],["を"],["するだろう"],["か"],["。"],["しかし"],["あなた"],["がた"],["は"],["、"],["わたし"],["の"],["物","もの"],["を"],["盗んで","ぬすんで"],["いる"],["。"],["あなた"],["がた"],["は"],["また"],["『"],["どう"],["して"],["われわれ"],["は"],["、"],["あなた"],["の"],["物","もの"],["を"],["盗んで","ぬすんで"],["いる"],["の"],["か"],["』"],["と"],["言う","いう"],["。"],["十分","ぶん"],["の"],["一","いち"],["と"],["、"],["ささげ物","ささげもの"],["を"],["もって"],["で"],["ある"],["。"]]},{"verse":9,"text":"あなたがたは、のろいをもって、のろわれる。あなたがたすべての国民,こくみんは、わたしの物,ものを盗,ぬすんでいるからである。","tok":[["あなた"],["がた"],["は"],["、"],["のろい"],["を"],["もって"],["、"],["のろわれる"],["。"],["あなた"],["がた"],["すべて"],["の"],["国民","こくみん"],["は"],["、"],["わたし"],["の"],["物","もの"],["を"],["盗んで","ぬすんで"],["いる"],["から"],["で"],["ある"],["。"]]},{"verse":10,"text":"わたしの宮,みやに食物,しょくもつのあるように、十分,ぶんの一全部,ぜんぶをわたしの倉,くらに携,たずさえてきなさい。これをもってわたしを試,こころみ、わたしが天,てんの窓,まどを開,ひらいて、あふるる恵,めぐみを、あなたがたに注,そそぐか否,いなかを見,みなさいと、万軍,ばんぐんの主,しゅは言,いわれる。","tok":[["わたし"],["の"],["宮","みや"],["に"],["食物","しょくもつ"],["の"],["ある"],["よう"],["に"],["、"],["十分","ぶん"],["の"],["一","いち"],["全部","ぜんぶ"],["を"],["わたし"],["の"],["倉","くら"],["に"],["携えて","たずさえて"],["き"],["なさい"],["。"],["これ"],["を"],["もって"],["わたし"],["を"],["試み","こころみ"],["、"],["わたし"],["が"],["天","てん"],["の"],["窓","まど"],["を"],["開らいて","ひらいて"],["、"],["あふるる"],["恵","めぐみ"],["を"],["、"],["あなた"],["がた"],["に"],["注ぐ","そそぐ"],["か"],["否","いな"],["か"],["を"],["見","み"],["なさい"],["と"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":11,"text":"わたしは食,くい滅,ほろぼす者,ものを、あなたがたのためにおさえて、あなたがたの地,ちの産物,さんぶつを、滅,ほろぼさないようにしよう。また、あなたがたのぶどうの木,きが、その熟,じゅくする前,まえに、その実,みを畑,はたけに落,おとすことのないようにしようと、万軍,ばんぐんの主,しゅは言,いわれる。","tok":[["わたし"],["は"],["食い滅ぼす","くいほろぼす"],["者","もの"],["を"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["おさえて"],["、"],["あなた"],["がた"],["の"],["地","ち"],["の"],["産物","さんぶつ"],["を"],["、"],["滅ぼさない","ほろぼさない"],["よう"],["に"],["しよう"],["。"],["また"],["、"],["あなた"],["がた"],["の"],["ぶどう"],["の"],["木","き"],["が"],["、"],["その"],["熟する","じゅくする"],["前","まえ"],["に"],["、"],["その"],["実","み"],["を"],["畑","はたけ"],["に"],["落とす","おとす"],["こと"],["の"],["ない"],["よう"],["に"],["しよう"],["と"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":12,"text":"こうして万国,ばんこくの人,ひとは、あなたがたを祝福,しゅくふくされた者,ものととなえるであろう。あなたがたは楽,たのしい地,ちとなるからであると、万軍,ばんぐんの主,しゅは言,いわれる。","tok":[["こう"],["して"],["万国","ばんこく"],["の"],["人","ひと"],["は"],["、"],["あなた"],["がた"],["を"],["祝福","しゅくふく"],["された"],["者","もの"],["と"],["となえるで"],["あろう"],["。"],["あなた"],["がた"],["は"],["楽い","たのしい"],["地","ち"],["と"],["なる"],["から"],["で"],["ある"],["と"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":13,"text":"主,しゅは言,いわれる、あなたがたは言葉,ことばを激,はげしくして、わたしに逆,さからった。しかもあなたがたは『われわれはあなたに逆,さからって、どんな事,ことを言,いったか』と言,いう。","tok":[["主","しゅ"],["は"],["言われる","いわれる"],["、"],["あなた"],["がた"],["は"],["言葉","ことば"],["を"],["激しく","はげしく"],["して"],["、"],["わたし"],["に"],["逆らった","さからった"],["。"],["しかも"],["あなた"],["がた"],["は"],["『"],["われわれ"],["は"],["あなた"],["に"],["逆らって","さからって"],["、"],["どんな"],["事","こと"],["を"],["言った","いった"],["か"],["』"],["と"],["言う","いう"],["。"]]},{"verse":14,"text":"あなたがたは言,いった、『神,かみに仕,つかえる事,ことはつまらない。われわれがその命令,めいれいを守,まもり、かつ万軍,ばんぐんの主,しゅの前,まえに、悲,かなしんで歩,あるいたからといって、なんの益,えきがあるか。","tok":[["あなた"],["がた"],["は"],["言った","いった"],["、"],["『"],["神","かみ"],["に"],["仕える","つかえる"],["事","こと"],["は"],["つまらない"],["。"],["われわれ"],["が"],["その"],["命令","めいれい"],["を"],["守り","まもり"],["、"],["かつ"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["の"],["前","まえ"],["に"],["、"],["悲しんで","かなしんで"],["歩いた","あるいた"],["から"],["と"],["いって"],["、"],["なん"],["の"],["益","えき"],["が"],["ある"],["か"],["。"]]},{"verse":15,"text":"今,いまわれわれは高,たかぶる者,ものを、祝福,しゅくふくされた者,ものと思,おもう。悪,あくを行,おこなう者,ものは栄,さかえるばかりでなく、神,かみを試,こころみても罰,ばっせられない』」。","tok":[["今","いま"],["われわれ"],["は"],["高か","たか"],["ぶる"],["者","もの"],["を"],["、"],["祝福","しゅくふく"],["された"],["者","もの"],["と"],["思う","おもう"],["。"],["悪","あく"],["を"],["行なう","おこなう"],["者","もの"],["は"],["栄","さかえ"],["る"],["ばかり"],["で"],["なく"],["、"],["神","かみ"],["を"],["試みて","こころみて"],["も"],["罰せられない","ばっせられない"],["』"],["」"],["。"]]},{"verse":16,"text":"そのとき、主,しゅを恐,おそれる者,ものは互,たがいに語,かたった。主,しゅは耳,みみを傾,かたむけてこれを聞,きかれた。そして主,しゅを恐,おそれる者,もの、およびその名,なを心,こころに留,とめている者,もののために、主,しゅの前,まえに一つの覚,おぼえ書,がきがしるされた。","tok":[["その"],["とき"],["、"],["主","しゅ"],["を"],["恐れる","おそれる"],["者","もの"],["は"],["互","たがい"],["に"],["語った","かたった"],["。"],["主","しゅ"],["は"],["耳","みみ"],["を"],["傾むけて","かたむけて"],["これ"],["を"],["聞かれた","きかれた"],["。"],["そして"],["主","しゅ"],["を"],["恐れる","おそれる"],["者","もの"],["、"],["および"],["その"],["名","な"],["を"],["心","こころ"],["に"],["留","とめ"],["て"],["いる"],["者","もの"],["の"],["ため"],["に"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["一","ひと"],["つ"],["の"],["覚え書","おぼえがき"],["が"],["しるされた"],["。"]]},{"verse":17,"text":"「万軍,ばんぐんの主,しゅは言,いわれる、彼,かれらはわたしが手,てを下,くだして事,ことを行,おこなう日,ひに、わたしの者,ものとなり、わたしの宝,たからとなる。また人,ひとが自分,じぶんに仕,つかえる子,こをあわれむように、わたしは彼,かれらをあわれむ。","tok":[["「"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["言われる","いわれる"],["、"],["彼","かれ"],["ら"],["は"],["わたし"],["が"],["手","て"],["を"],["下して","くだして"],["事","こと"],["を"],["行なう","おこなう"],["日","ひ"],["に"],["、"],["わたし"],["の"],["者","もの"],["と"],["なり"],["、"],["わたし"],["の"],["宝","たから"],["と"],["なる"],["。"],["また"],["人","ひと"],["が"],["自分","じぶん"],["に"],["仕える","つかえる"],["子","こ"],["を"],["あわれむ"],["よう"],["に"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["あわれむ"],["。"]]},{"verse":18,"text":"その時,ときあなたがたは、再,ふたたび義人,ぎじんと悪人,あくにん、神,かみに仕,つかえる者,ものと、仕,つかえない者,ものとの区別,くべつを知,しるようになる。","tok":[["その"],["時","とき"],["あなた"],["がた"],["は"],["、"],["再び","ふたたび"],["義人","ぎじん"],["と"],["悪人","あくにん"],["、"],["神","かみ"],["に"],["仕える","つかえる"],["者","もの"],["と"],["、"],["仕えない","つかえない"],["者","もの"],["と"],["の"],["区別","くべつ"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"]]},{"verse":19,"text":"[4:1]万軍,ばんぐんの主,しゅは言,いわれる、見,みよ、炉,ろのように燃,もえる日,ひが来,くる。その時,ときすべて高,たかぶる者,ものと、悪,あくを行,おこなう者,ものとは、わらのようになる。その来,くる日,ひは、彼,かれらを焼,やき尽,つくして、根,ねも枝,えだも残,のこさない。","tok":[["["],["4"],[":"],["1"],["]"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["言われる","いわれる"],["、"],["見よ","みよ"],["、"],["炉","ろ"],["の"],["よう"],["に"],["燃える","もえる"],["日","ひ"],["が"],["来る","くる"],["。"],["その"],["時","とき"],["すべて"],["高ぶる","たかぶる"],["者","もの"],["と"],["、"],["悪","あく"],["を"],["行なう","おこなう"],["者","もの"],["と"],["は"],["、"],["わら"],["の"],["よう"],["に"],["なる"],["。"],["その"],["来る","くる"],["日","ひ"],["は"],["、"],["彼","かれ"],["ら"],["を"],["焼き","やき"],["尽くして","つくして"],["、"],["根","ね"],["も"],["枝","えだ"],["も"],["残さない","のこさない"],["。"]]},{"verse":20,"text":"[4:2]しかしわが名,なを恐,おそれるあなたがたには、義,ぎの太陽,たいようがのぼり、その翼,つばさには、いやす力,ちからを備,そなえている。あなたがたは牛舎,ぎゅうしゃから出,でる子,こ牛,うしのように外,そとに出,でて、とびはねる。","tok":[["["],["4"],[":"],["2"],["]"],["しかし"],["わが"],["名","な"],["を"],["恐れる","おそれる"],["あなた"],["がた"],["に"],["は"],["、"],["義","ぎ"],["の"],["太陽","たいよう"],["が"],["のぼり"],["、"],["その"],["翼","つばさ"],["に"],["は"],["、"],["いやす"],["力","ちから"],["を"],["備","そなえ"],["て"],["いる"],["。"],["あなた"],["がた"],["は"],["牛舎","ぎゅうしゃ"],["から"],["出る","でる"],["子牛","こうし"],["の"],["よう"],["に"],["外","そと"],["に"],["出て","でて"],["、"],["とびはねる"],["。"]]},{"verse":21,"text":"[4:3]また、あなたがたは悪人,あくにんを踏,ふみつけ、わたしが事,ことを行,おこなう日,ひに、彼,かれらはあなたがたの足,あしの裏,うらの下,したにあって、灰,はいのようになると、万軍,ばんぐんの主,しゅは言,いわれる。","tok":[["["],["4"],[":"],["3"],["]"],["また"],["、"],["あなた"],["がた"],["は"],["悪人","あくにん"],["を"],["踏みつけ","ふみつけ"],["、"],["わたし"],["が"],["事","こと"],["を"],["行なう","おこなう"],["日","ひ"],["に"],["、"],["彼","かれ"],["ら"],["は"],["あなた"],["がた"],["の"],["足","あし"],["の"],["裏","うら"],["の"],["下","した"],["に"],["あって"],["、"],["灰","はい"],["の"],["よう"],["に"],["なる"],["と"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":22,"text":"[4:4]あなたがたは、わがしもべモーセの律法,りっぽう、すなわちわたしがホレブで、イスラエル全体,ぜんたいのために、彼,かれに命,めいじた定,さだめとおきてとを覚,おぼえよ。","tok":[["["],["4"],[":"],["4"],["]"],["あなた"],["がた"],["は"],["、"],["わが"],["しもべ"],["モーセ"],["の"],["律法","りっぽう"],["、"],["すなわち"],["わたし"],["が"],["ホレブ"],["で"],["、"],["イスラエル"],["全体","ぜんたい"],["の"],["ため"],["に"],["、"],["彼","かれ"],["に"],["命じた","めいじた"],["定め","さだめ"],["と"],["おきて"],["と"],["を"],["覚え","おぼえ"],["よ"],["。"]]},{"verse":23,"text":"[4:5]見,みよ、主,しゅの大,おおいなる恐,おそるべき日,ひが来,くる前,まえに、わたしは預言者,よげんしゃエリヤをあなたがたにつかわす。","tok":[["["],["4"],[":"],["5"],["]"],["見よ","みよ"],["、"],["主","しゅ"],["の"],["大いなる","おおいなる"],["恐るべき","おそるべき"],["日","ひ"],["が"],["来る","くる"],["前","まえ"],["に"],["、"],["わたし"],["は"],["預言者","よげんしゃ"],["エリヤ"],["を"],["あなた"],["がた"],["に"],["つかわす"],["。"]]},{"verse":24,"text":"[4:6]彼,かれは父,ちちの心,こころをその子,こ供,ともたちに向,むけさせ、子供,こどもたちの心,こころをその父,ちちに向,むけさせる。これはわたしが来,きて、のろいをもってこの国,くにを撃,うつことのないようにするためである」。","tok":[["["],["4"],[":"],["6"],["]"],["彼","かれ"],["は"],["父","ちち"],["の"],["心","こころ"],["を"],["その"],["子供","ことも"],["たち"],["に"],["向けさせ","むけさせ"],["、"],["子供","こども"],["たち"],["の"],["心","こころ"],["を"],["その"],["父","ちち"],["に"],["向けさせる","むけさせる"],["。"],["これ"],["は"],["わたし"],["が"],["来て","きて"],["、"],["のろい"],["を"],["もって"],["この"],["国","くに"],["を"],["撃つ","うつ"],["こと"],["の"],["ない"],["よう"],["に"],["する"],["ため"],["で"],["ある"],["」"],["。"]]}]
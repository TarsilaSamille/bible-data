[{"verse":1,"text":"マラキによってイスラエルに臨,のぞんだ主,しゅの言葉,ことばの託宣,たくせん。","tok":[["マラキ"],["によって"],["イスラエル"],["に"],["臨んだ","のぞんだ"],["主","しゅ"],["の"],["言葉","ことば"],["の"],["託宣","たくせん"],["。"]]},{"verse":2,"text":"主,しゅは言,いわれる、「わたしはあなたがたを愛,あいした」と。ところがあなたがたは言,いう、「あなたはどんなふうに、われわれを愛,あいされたか」。主,しゅは言,いわれる、「エサウはヤコブの兄,あにではないか。しかしわたしはヤコブを愛,あいし、","tok":[["主","しゅ"],["は"],["言われる","いわれる"],["、"],["「"],["わたし"],["は"],["あなた"],["がた"],["を"],["愛した","あいした"],["」"],["と"],["。"],["ところ"],["が"],["あなた"],["がた"],["は"],["言う","いう"],["、"],["「"],["あなた"],["は"],["どんな"],["ふう"],["に"],["、"],["われわれ"],["を"],["愛された","あいされた"],["か"],["」"],["。"],["主","しゅ"],["は"],["言われる","いわれる"],["、"],["「"],["エサウ"],["は"],["ヤコブ"],["の"],["兄","あに"],["で"],["は"],["ない"],["か"],["。"],["しかし"],["わたし"],["は"],["ヤコブ"],["を"],["愛し","あいし"],["、"]]},{"verse":3,"text":"エサウを憎,にくんだ。かつ、わたしは彼,かれの山地,やまちを荒,あらし、その嗣,し業,ぎょうを荒野,あらのの山犬,やまいぬに与,あたえた」。","tok":[["エサウ"],["を"],["憎んだ","にくんだ"],["。"],["かつ"],["、"],["わたし"],["は"],["彼","かれ"],["の"],["山地","やまち"],["を"],["荒し","あらし"],["、"],["その"],["嗣業","しぎょう"],["を"],["荒野","あらの"],["の"],["山犬","やまいぬ"],["に"],["与","あたえ"],["た"],["」"],["。"]]},{"verse":4,"text":"もしエドムが「われわれは滅,ほろぼされたけれども、荒,あれた所,ところを再,ふたたび建,たてる」と言,いうならば、万軍,ばんぐんの主,しゅは「彼,かれらは建,たてるかもしれない。しかしわたしはそれを倒,たおす。人々,ひとびとは、彼,かれらを悪,あしき国,くにととなえ、とこしえに主,しゅの怒,いかりをうける民,たみととなえる」と言,いわれる。","tok":[["もし"],["エドム"],["が"],["「"],["われわれ"],["は"],["滅ぼされた","ほろぼされた"],["けれど"],["も"],["、"],["荒た","あれた"],["所","ところ"],["を"],["再び","ふたたび"],["建てる","たてる"],["」"],["と"],["言うならば","いうならば"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["「"],["彼","かれ"],["ら"],["は"],["建てる","たてる"],["か"],["も"],["しれない"],["。"],["しかし"],["わたし"],["は"],["それ"],["を"],["倒す","たおす"],["。"],["人々","ひとびと"],["は"],["、"],["彼","かれ"],["ら"],["を"],["悪しき","あしき"],["国","くに"],["と"],["となえ"],["、"],["とこしえ"],["に"],["主","しゅ"],["の"],["怒り","いかり"],["を"],["うける"],["民","たみ"],["と"],["となえる"],["」"],["と"],["言われる","いわれる"],["。"]]},{"verse":5,"text":"あなたがたの目,めはこれを見,みて、「主,しゅはイスラエルの境,さかいを越,こえて大,おおいなる神,かみである」と言,いうであろう。","tok":[["あなた"],["がた"],["の"],["目","め"],["は"],["これ"],["を"],["見て","みて"],["、"],["「"],["主","しゅ"],["は"],["イスラエル"],["の"],["境","さかい"],["を"],["越えて","こえて"],["大いなる","おおいなる"],["神","かみ"],["で"],["ある"],["」"],["と"],["言うで","いうで"],["あろう"],["。"]]},{"verse":6,"text":"「子,こはその父,ちちを敬,うやまい、しもべはその主人,しゅじんを敬,うやまう。それでわたしがもし父,ちちであるならば、あなたがたのわたしを敬,うやまう事実,じじつが、どこにあるか。わたしがもし主人,しゅじんであるならば、わたしを恐,おそれる事実,じじつが、どこにあるか。わたしの名,なを侮,あなどる祭司,さいしたちよ、と万軍,ばんぐんの主,しゅはあなたがたに言,いわれる。ところがあなたがたは『われわれはどんなふうにあなたの名,なを侮,あなどったか』と言,いい、","tok":[["「"],["子","こ"],["は"],["その"],["父","ちち"],["を"],["敬い","うやまい"],["、"],["しもべ"],["は"],["その"],["主人","しゅじん"],["を"],["敬う","うやまう"],["。"],["それ"],["で"],["わたし"],["が"],["もし"],["父","ちち"],["で"],["あるならば"],["、"],["あなた"],["がた"],["の"],["わたし"],["を"],["敬う","うやまう"],["事実","じじつ"],["が"],["、"],["どこ"],["に"],["ある"],["か"],["。"],["わたし"],["が"],["もし"],["主人","しゅじん"],["で"],["あるならば"],["、"],["わたし"],["を"],["恐れる","おそれる"],["事実","じじつ"],["が"],["、"],["どこ"],["に"],["ある"],["か"],["。"],["わたし"],["の"],["名","な"],["を"],["侮る","あなどる"],["祭司","さいし"],["たち"],["よ"],["、"],["と"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["あなた"],["がた"],["に"],["言われる","いわれる"],["。"],["ところ"],["が"],["あなた"],["がた"],["は"],["『"],["われわれ"],["は"],["どんな"],["ふう"],["に"],["あなた"],["の"],["名","な"],["を"],["侮った","あなどった"],["か"],["』"],["と"],["言い","いい"],["、"]]},{"verse":7,"text":"汚,けがれた食物,しょくもつをわたしの祭壇,さいだんの上,うえにささげる。またあなたがたは、主,しゅの台,だいは卑,いやしむべき物,ものであると考,かんがえて、『われわれはどんなふうに、それを汚,けがしたか』と言,いう。","tok":[["汚","け"],["がれ"],["た"],["食物","しょくもつ"],["を"],["わたし"],["の"],["祭壇","さいだん"],["の"],["上","うえ"],["に"],["ささげる"],["。"],["また"],["あなた"],["がた"],["は"],["、"],["主","しゅ"],["の"],["台","だい"],["は"],["卑しむべき","いやしむべき"],["物","もの"],["で"],["ある"],["と"],["考","かんがえ"],["て"],["、"],["『"],["われわれ"],["は"],["どんな"],["ふう"],["に"],["、"],["それ"],["を"],["汚","け"],["がした"],["か"],["』"],["と"],["言う","いう"],["。"]]},{"verse":8,"text":"あなたがたが盲目,もうもくの獣,けものを、犠牲,ぎせいにささげるのは悪,わるい事,ことではないか。また足,あしのなえたもの、病,やめるものをささげるのは悪,わるい事,ことではないか。今,いまこれをあなたのつかさにささげてみよ。彼,かれはあなたを喜,よろこび、あなたを受,うけいれるであろうかと、万軍,ばんぐんの主,しゅは言,いわれる。","tok":[["あなた"],["がた"],["が"],["盲目","もうもく"],["の"],["獣","けもの"],["を"],["、"],["犠牲","ぎせい"],["に"],["ささげる"],["の"],["は"],["悪い","わるい"],["事","こと"],["で"],["は"],["ない"],["か"],["。"],["また"],["足","あし"],["の"],["なえた"],["もの"],["、"],["病める","やめる"],["もの"],["を"],["ささげる"],["の"],["は"],["悪い","わるい"],["事","こと"],["で"],["は"],["ない"],["か"],["。"],["今","いま"],["これ"],["を"],["あなた"],["の"],["つかさ"],["に"],["ささげて"],["み"],["よ"],["。"],["彼","かれ"],["は"],["あなた"],["を"],["喜こび","よろこび"],["、"],["あなた"],["を"],["受","うけ"],["いれるで"],["あろう"],["か"],["と"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":9,"text":"あなたがたは、神,かみがわれわれをあわれまれるように、神,かみの恵,めぐみを求,もとめてみよ。このようなあなたがたの手,てのささげ物,ものをもって、彼,かれはあなたがたを受,うけいれられるであろうかと、万軍,ばんぐんの主,しゅは言,いわれる。","tok":[["あなた"],["がた"],["は"],["、"],["神","かみ"],["が"],["われわれ"],["を"],["あわれまれる"],["よう"],["に"],["、"],["神","かみ"],["の"],["恵","めぐみ"],["を"],["求めて","もとめて"],["み"],["よ"],["。"],["この"],["よう"],["な"],["あなた"],["がた"],["の"],["手","て"],["の"],["ささげ物","ささげもの"],["を"],["もって"],["、"],["彼","かれ"],["は"],["あなた"],["がた"],["を"],["受","うけ"],["いれられるで"],["あろう"],["か"],["と"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":10,"text":"あなたがたがわが祭壇,さいだんの上,うえにいたずらに、火,ひをたくことのないように戸,とを閉,とじる者,ものがあなたがたのうちに、ひとりあったらいいのだが。わたしはあなたがたを喜,よろこばない、またあなたがたの手,てからささげ物,ものを受,うけないと、万軍,ばんぐんの主,しゅは言,いわれる。","tok":[["あなた"],["が"],["たがわ"],["が"],["祭壇","さいだん"],["の"],["上","うえ"],["に"],["いたずら"],["に"],["、"],["火","ひ"],["を"],["たく"],["こと"],["の"],["ない"],["よう"],["に"],["戸","と"],["を"],["閉じる","とじる"],["者","もの"],["が"],["あなた"],["がた"],["の"],["うち"],["に"],["、"],["ひとり"],["あったら"],["いい"],["の"],["だ"],["が"],["。"],["わたし"],["は"],["あなた"],["がた"],["を"],["喜こばない","よろこばない"],["、"],["また"],["あなた"],["がた"],["の"],["手","て"],["から"],["ささげ物","ささげもの"],["を"],["受ない","うけない"],["と"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":11,"text":"日,ひの出,でる所,ところから没,ぼっする所,ところまで、国々,くにぐにのうちにわが名,なはあがめられている。また、どこでも香,こうと清,きよいささげ物,ものが、わが名,なのためにささげられる。これはわが名,なが国々,くにぐにのうちにあがめられているからであると、万軍,ばんぐんの主,しゅは言,いわれる。","tok":[["日","ひ"],["の"],["出る","でる"],["所","ところ"],["から"],["没する","ぼっする"],["所","ところ"],["まで"],["、"],["国々","くにぐに"],["の"],["うち"],["に"],["わが"],["名","な"],["は"],["あがめられて"],["いる"],["。"],["また"],["、"],["どこ"],["で"],["も"],["香","こう"],["と"],["清い","きよい"],["ささげ物","ささげもの"],["が"],["、"],["わが"],["名","な"],["の"],["ため"],["に"],["ささげられる"],["。"],["これ"],["は"],["わが"],["名","な"],["が"],["国々","くにぐに"],["の"],["うち"],["に"],["あがめられて"],["いる"],["から"],["で"],["ある"],["と"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":12,"text":"ところがあなたがたは、主,しゅの台,だいは汚,けがれている、またこの食物,しょくもつは卑,いやしむべき物,ものであると言,いって、これを汚,けがした。","tok":[["ところ"],["が"],["あなた"],["がた"],["は"],["、"],["主","しゅ"],["の"],["台","だい"],["は"],["汚","け"],["がれ"],["て"],["いる"],["、"],["また"],["この"],["食物","しょくもつ"],["は"],["卑しむべき","いやしむべき"],["物","もの"],["で"],["ある"],["と"],["言って","いって"],["、"],["これ"],["を"],["汚","け"],["がした"],["。"]]},{"verse":13,"text":"あなたがたはまた『これはなんと煩,わずらわしい事,ことか』と言,いって、わたしを鼻,はなであしらうと、万軍,ばんぐんの主,しゅは言,いわれる。あなたがたはまた奪,うばった物,もの、足,あしなえのもの、病,やめるものを、ささげ物,ものとして携,たずさえて来,くる。わたしはそれを、あなたがたの手,てから、受,うけるであろうかと主,しゅは言,いわれる。","tok":[["あなた"],["がた"],["は"],["また"],["『"],["これ"],["は"],["なん"],["と"],["煩わしい","わずらわしい"],["事","こと"],["か"],["』"],["と"],["言って","いって"],["、"],["わたし"],["を"],["鼻","はな"],["で"],["あしらう"],["と"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["言われる","いわれる"],["。"],["あなた"],["がた"],["は"],["また"],["奪った","うばった"],["物","もの"],["、"],["足","あし"],["なえ"],["の"],["もの"],["、"],["病める","やめる"],["もの"],["を"],["、"],["ささげ物","ささげもの"],["として"],["携えて","たずさえて"],["来る","くる"],["。"],["わたし"],["は"],["それ"],["を"],["、"],["あなた"],["がた"],["の"],["手","て"],["から"],["、"],["受けるで","うけるで"],["あろう"],["か"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]},{"verse":14,"text":"群,むれのうちに雄,おすの獣,けものがあり、それをささげると誓,ちかいを立,たてているのに、傷,きずのあるものを、主,しゅにささげる偽,いつわり者,ものはのろわれる。わたしは大,おおいなる王,おうで、わが名,なは国々,くにぐにのうちに恐,おそれられるべきであると、万軍,ばんぐんの主,しゅは言,いわれる。","tok":[["群れ","むれ"],["の"],["うち"],["に"],["雄","おす"],["の"],["獣","けもの"],["が"],["あり"],["、"],["それ"],["を"],["ささげる"],["と"],["誓い","ちかい"],["を"],["立て","たてて"],["いる"],["のに"],["、"],["傷","きず"],["の"],["ある"],["もの"],["を"],["、"],["主に","しゅに"],["ささげる"],["偽わり","いつわり"],["者","もの"],["は"],["のろわれる"],["。"],["わたし"],["は"],["大いなる","おおいなる"],["王","おう"],["で"],["、"],["わが"],["名","な"],["は"],["国々","くにぐに"],["の"],["うち"],["に"],["恐れられるべきで","おそれられるべきで"],["ある"],["と"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["は"],["言われる","いわれる"],["。"]]}]
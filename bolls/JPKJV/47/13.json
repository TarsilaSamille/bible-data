[{"verse":1,"text":"わたしは今,いま、三度目,どめにあなたがたの所,ところに行,いこうとしている。すべての事,ことがらは、ふたりか三人,にんの証人,しょうにんの証言,しょうげんによって確定,かくていする。","tok":[["わたし"],["は"],["今","いま"],["、"],["三度目","どめ"],["に"],["あなた"],["がた"],["の"],["所","ところ"],["に"],["行こう","いこう"],["として"],["いる"],["。"],["すべて"],["の"],["事がら","ことがら"],["は"],["、"],["ふたり"],["か"],["三人","にん"],["の"],["証人","しょうにん"],["の"],["証言","しょうげん"],["によって"],["確定","かくてい"],["する"],["。"]]},{"verse":2,"text":"わたしは、前,まえに罪,つみを犯,おかした者,ものたちやその他,たのすべての人々,ひとびとに、二度目,どめに滞在,たいざいしていたとき警告,けいこくしておいたが、離,はなれている今,いままたあらかじめ言,いっておく。今度,こんど行,いった時,ときには、決,けっして容赦,ようしゃはしない。","tok":[["わたし"],["は"],["、"],["前","まえ"],["に"],["罪","つみ"],["を"],["犯した","おかした"],["者","もの"],["たち"],["や"],["その"],["他","た"],["の"],["すべて"],["の"],["人々","ひとびと"],["に"],["、"],["二度目","どめ"],["に"],["滞在","たいざい"],["して"],["いた"],["とき"],["警告","けいこく"],["して"],["おいた"],["が"],["、"],["離れて","はなれて"],["いる"],["今","いま"],["また"],["あらかじめ"],["言って","いって"],["おく"],["。"],["今度","こんど"],["行った","いった"],["時","とき"],["に"],["は"],["、"],["決っして","けっして"],["容赦","ようしゃ"],["は"],["しない"],["。"]]},{"verse":3,"text":"なぜなら、あなたがたが、キリストのわたしにあって語,かたっておられるという証拠,しょうこを求,もとめているからである。キリストは、あなたがたに対,たいして弱,よわくはなく、あなたがたのうちにあって強,つよい。","tok":[["なぜ"],["なら"],["、"],["あなた"],["が"],["た"],["が"],["、"],["キリスト"],["の"],["わたし"],["に"],["あって"],["語って","かたって"],["おられる"],["と"],["いう"],["証拠","しょうこ"],["を"],["求めて","もとめて"],["いる"],["から"],["で"],["ある"],["。"],["キリスト"],["は"],["、"],["あなた"],["がた"],["に対して","にたいして"],["弱く","よわく"],["は"],["なく"],["、"],["あなた"],["がた"],["の"],["うち"],["に"],["あって"],["強い","つよい"],["。"]]},{"verse":4,"text":"すなわち、キリストは弱,よわさのゆえに十字架,じゅうじかにつけられたが、神,かみの力,ちからによって生,いきておられるのである。このように、わたしたちもキリストにあって弱,よわい者,ものであるが、あなたがたに対,たいしては、神,かみの力,ちからによって、キリストと共,ともに生,いきるのである。","tok":[["すなわち"],["、"],["キリスト"],["は"],["弱","よわ"],["さ"],["の"],["ゆえ"],["に"],["十字架","じゅうじか"],["に"],["つけられた"],["が"],["、"],["神","かみ"],["の"],["力","ちから"],["によって"],["生きて","いきて"],["おられる"],["ので"],["ある"],["。"],["この"],["よう"],["に"],["、"],["わたしたち"],["も"],["キリスト"],["に"],["あって"],["弱い","よわい"],["者","もの"],["で"],["ある"],["が"],["、"],["あなた"],["がた"],["に"],["対し","たいし"],["ては"],["、"],["神","かみ"],["の"],["力","ちから"],["によって"],["、"],["キリスト"],["と"],["共","とも"],["に"],["生きる","いきる"],["ので"],["ある"],["。"]]},{"verse":5,"text":"あなたがたは、はたして信仰,しんこうがあるかどうか、自分,じぶんを反省,はんせいし、自分,じぶんを吟味,ぎんみするがよい。それとも、イエス・キリストがあなたがたのうちにおられることを、悟,さとらないのか。もし悟,さとらなければ、あなたがたは、にせものとして見捨,みすてられる。","tok":[["あなた"],["がた"],["は"],["、"],["はたして"],["信仰","しんこう"],["が"],["ある"],["か"],["どう"],["か"],["、"],["自分","じぶん"],["を"],["反省","はんせい"],["し"],["、"],["自分","じぶん"],["を"],["吟味","ぎんみ"],["する"],["が"],["よい"],["。"],["それ"],["と"],["も"],["、"],["イエス"],["・"],["キリスト"],["が"],["あなた"],["がた"],["の"],["うち"],["に"],["おられる"],["こと"],["を"],["、"],["悟らない","さとらない"],["の"],["か"],["。"],["もし"],["悟らなければ","さとらなければ"],["、"],["あなた"],["がた"],["は"],["、"],["にせもの"],["として"],["見捨てられる","みすてられる"],["。"]]},{"verse":6,"text":"しかしわたしは、自分,じぶんたちが見捨,みすてられた者,ものではないことを、知,しっていてもらいたい。","tok":[["しかし"],["わたし"],["は"],["、"],["自分","じぶん"],["たち"],["が"],["見捨てられた","みすてられた"],["者","もの"],["で"],["は"],["ない"],["こと"],["を"],["、"],["知って","しって"],["いて"],["もらいたい"],["。"]]},{"verse":7,"text":"わたしたちは、あなたがたがどんな悪,あくをも行,おこなわないようにと、神,かみに祈,いのる。それは、自分,じぶんたちがほんとうの者,ものであることを見,みせるためではなく、たといわたしたちが見捨,みすてられた者,もののようになっても、あなたがたに良,よい行,おこないをしてもらいたいためである。","tok":[["わたしたち"],["は"],["、"],["あなた"],["がた"],["が"],["どんな"],["悪","あく"],["を"],["も"],["行なわない","おこなわない"],["よう"],["に"],["と"],["、"],["神","かみ"],["に"],["祈る","いのる"],["。"],["それ"],["は"],["、"],["自分","じぶん"],["たち"],["が"],["ほんとう"],["の"],["者","もの"],["で"],["ある"],["こと"],["を"],["見せる","みせる"],["ため"],["で"],["は"],["なく"],["、"],["たとい"],["わたしたち"],["が"],["見捨てられた","みすてられた"],["者","もの"],["の"],["よう"],["に"],["なって"],["も"],["、"],["あなた"],["がた"],["に"],["良い","よい"],["行ない","おこない"],["を"],["して"],["もらいたい"],["ため"],["で"],["ある"],["。"]]},{"verse":8,"text":"わたしたちは、真理,しんりに逆,さからっては何,なにをする力,ちからもなく、真理,しんりにしたがえば力,ちからがある。","tok":[["わたしたち"],["は"],["、"],["真理","しんり"],["に"],["逆らって","さからって"],["は"],["何に","なに"],["を"],["する"],["力","ちから"],["も"],["なく"],["、"],["真理","しんり"],["に"],["したがえば"],["力","ちから"],["が"],["ある"],["。"]]},{"verse":9,"text":"わたしたちは、自分,じぶんは弱,よわくても、あなたがたが強,つよければ、それを喜,よろこぶ。わたしたちが特,とくに祈,いのるのは、あなたがたが完全,かんぜんに良,よくなってくれることである。","tok":[["わたしたち"],["は"],["、"],["自分","じぶん"],["は"],["弱くて","よわくて"],["も"],["、"],["あなた"],["がた"],["が"],["強ければ","つよければ"],["、"],["それ"],["を"],["喜こぶ","よろこぶ"],["。"],["わたしたち"],["が"],["特に","とくに"],["祈る","いのる"],["の"],["は"],["、"],["あなた"],["がた"],["が"],["完全","かんぜん"],["に"],["良く","よく"],["なって"],["くれる"],["こと"],["で"],["ある"],["。"]]},{"verse":10,"text":"こういうわけで、離,はなれていて以上,いじょうのようなことを書,かいたのは、わたしがあなたがたの所,ところに行,いったとき、倒,たおすためではなく高,たかめるために主,しゅが授,さづけて下,くださった権威,けんいを用,もちいて、きびしい処置,しょちをする必要,ひつようがないようにしたいためである。","tok":[["こう"],["いう"],["わけ"],["で"],["、"],["離れて","はなれて"],["いて"],["以上","いじょう"],["の"],["よう"],["な"],["こと"],["を"],["書いた","かいた"],["の"],["は"],["、"],["わたし"],["が"],["あなた"],["がた"],["の"],["所","ところ"],["に"],["行った","いった"],["とき"],["、"],["倒す","たおす"],["ため"],["で"],["は"],["なく"],["高める","たかめる"],["ため"],["に"],["主","しゅ"],["が"],["授","さ"],["づけて"],["下さった","くださった"],["権威","けんい"],["を"],["用いて","もちいて"],["、"],["きびしい"],["処置","しょち"],["を"],["する"],["必要","ひつよう"],["が"],["ない"],["よう"],["に"],["したい"],["ため"],["で"],["ある"],["。"]]},{"verse":11,"text":"最後,さいごに、兄弟,きょうだいたちよ。いつも喜,よろこびなさい。全,まったき者,ものとなりなさい。互,たがいに励,はげまし合,あいなさい。思,おもいを一つにしなさい。平和,へいわに過,すごしなさい。そうすれば、愛,あいと平和,へいわの神,かみがあなたがたと共,ともにいて下,くださるであろう。","tok":[["最後","さいご"],["に"],["、"],["兄弟","きょうだい"],["たち"],["よ"],["。"],["いつも"],["喜こび","よろこび"],["なさい"],["。"],["全","ま"],["っ"],["たき者","たきもの"],["と"],["なり"],["なさい"],["。"],["互","たがい"],["に"],["励まし合い","はげましあい"],["なさい"],["。"],["思い","おもい"],["を"],["一","ひと"],["つ"],["に"],["し"],["なさい"],["。"],["平和","へいわ"],["に"],["過ごし","すごし"],["なさい"],["。"],["そう"],["すれば"],["、"],["愛","あい"],["と"],["平和","へいわ"],["の"],["神","かみ"],["が"],["あなた"],["がた"],["と"],["共","とも"],["に"],["いて"],["下さるで","くださるで"],["あろう"],["。"]]},{"verse":12,"text":"きよい接吻,せっぷんをもって互,たがいにあいさつをかわしなさい。聖徒,せいとたち一同,いちどうが、あなたがたによろしく。","tok":[["きよい"],["接吻","せっぷん"],["を"],["もって"],["互","たがい"],["に"],["あいさつ"],["を"],["かわし"],["なさい"],["。"],["聖徒","せいと"],["たち"],["一同","いちどう"],["が"],["、"],["あなた"],["がた"],["に"],["よろしく"],["。"]]},{"verse":13,"text":"主,しゅイエス・キリストの恵,めぐみと、神,かみの愛,あいと、聖霊,せいれいの交,まじわりとが、あなたがた一同,いちどうと共,ともにあるように。","tok":[["主","しゅ"],["イエス"],["・"],["キリスト"],["の"],["恵","めぐみ"],["と"],["、"],["神","かみ"],["の"],["愛","あい"],["と"],["、"],["聖霊","せいれい"],["の"],["交じわり","まじわり"],["と"],["が"],["、"],["あなた"],["がた"],["一同","いちどう"],["と"],["共","とも"],["に"],["ある"],["よう"],["に"],["。"]]}]
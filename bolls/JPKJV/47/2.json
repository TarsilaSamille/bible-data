[{"verse":1,"text":"そこでわたしは、あなたがたの所,ところに再,ふたたび悲,かなしみをもって行,ゆくことはすまいと、決心,けっしんしたのである。","tok":[["そこ"],["で"],["わたし"],["は"],["、"],["あなた"],["がた"],["の"],["所","ところ"],["に"],["再び","ふたたび"],["悲しみ","かなしみ"],["を"],["もって"],["行","ゆくこと"],["は"],["すまい"],["と"],["、"],["決心","けっしん"],["した"],["ので"],["ある"],["。"]]},{"verse":2,"text":"もしあなたがたを悲,かなしませるとすれば、わたしが悲,かなしませているその人,ひと以外,いがいに、だれがわたしを喜,よろこばせてくれるのか。","tok":[["もし"],["あなた"],["がた"],["を"],["悲しませる","かなしませる"],["と"],["すれば"],["、"],["わたし"],["が"],["悲しませて","かなしませて"],["いる"],["その"],["人","ひと"],["以外","いがい"],["に"],["、"],["だれ"],["が"],["わたし"],["を"],["喜こばせて","よろこばせて"],["くれる"],["の"],["か"],["。"]]},{"verse":3,"text":"このような事,ことを書,かいたのは、わたしが行,ゆく時,とき、わたしを喜,よろこばせてくれるはずの人々,ひとびとから、悲,かなしい思,おもいをさせられたくないためである。わたし自身,じしんの喜,よろこびはあなたがた全体,ぜんたいの喜,よろこびであることを、あなたがたすべてについて確信,かくしんしているからである。","tok":[["この"],["よう"],["な"],["事","こと"],["を"],["書いた","かいた"],["の"],["は"],["、"],["わたし"],["が"],["行く","ゆく"],["時","とき"],["、"],["わたし"],["を"],["喜こばせて","よろこばせて"],["くれる"],["はず"],["の"],["人々","ひとびと"],["から"],["、"],["悲しい","かなしい"],["思い","おもい"],["を"],["させられたく"],["ない"],["ため"],["で"],["ある"],["。"],["わたし"],["自身","じしん"],["の"],["喜こび","よろこび"],["は"],["あなた"],["がた"],["全体","ぜんたい"],["の"],["喜こびで","よろこびで"],["ある"],["こと"],["を"],["、"],["あなた"],["がた"],["すべて"],["について"],["確信","かくしん"],["して"],["いる"],["から"],["で"],["ある"],["。"]]},{"verse":4,"text":"わたしは大,おおきな患難,かんなんと心,こころの憂,うれいの中,なかから、多,おおくの涙,なみだをもってあなたがたに書,かきおくった。それは、あなたがたを悲,かなしませるためではなく、あなたがたに対,たいしてあふれるばかりにいだいているわたしの愛,あいを、知,しってもらうためであった。","tok":[["わたし"],["は"],["大きな","おおきな"],["患難","かんなん"],["と"],["心","こころ"],["の"],["憂","うれい"],["の"],["中","なか"],["から"],["、"],["多く","おおく"],["の"],["涙","なみだ"],["を"],["もって"],["あなた"],["がた"],["に"],["書きおくった","かきおくった"],["。"],["それ"],["は"],["、"],["あなた"],["がた"],["を"],["悲しませる","かなしませる"],["ため"],["で"],["は"],["なく"],["、"],["あなた"],["がた"],["に対して","にたいして"],["あふれる"],["ばかり"],["に"],["いだいて"],["いる"],["わたし"],["の"],["愛","あい"],["を"],["、"],["知って","しって"],["もらう"],["ため"],["で"],["あった"],["。"]]},{"verse":5,"text":"しかし、もしだれかが人,ひとを悲,かなしませたとすれば、それはわたしを悲,かなしませたのではなく、控,ひかえ目,めに言,いうが、ある程度,ていど、あなたがた一同,いちどうを悲,かなしませたのである。","tok":[["しかし"],["、"],["もし"],["だれ"],["か"],["が"],["人","ひと"],["を"],["悲しませた","かなしませた"],["と"],["すれば"],["、"],["それ"],["は"],["わたし"],["を"],["悲しませた","かなしませた"],["ので"],["は"],["なく"],["、"],["控目","ひかえめ"],["に"],["言う","いう"],["が"],["、"],["ある"],["程度","ていど"],["、"],["あなた"],["がた"],["一同","いちどう"],["を"],["悲しませた","かなしませた"],["ので"],["ある"],["。"]]},{"verse":6,"text":"その人,ひとにとっては、多数,たすうの者,ものから受,うけたあの処罰,しょばつでもう十分,じゅうぶんなのだから、","tok":[["その"],["人","ひと"],["にとって"],["は"],["、"],["多数","たすう"],["の"],["者","もの"],["から"],["受けた","うけた"],["あの"],["処罰","しょばつ"],["で"],["もう"],["十分","じゅうぶん"],["な"],["の"],["だ"],["から"],["、"]]},{"verse":7,"text":"あなたがたはむしろ彼,かれをゆるし、また慰,なぐさめてやるべきである。そうしないと、その人,ひとはますます深,ぶかい悲,かなしみに沈,しずむかも知,しれない。","tok":[["あなた"],["がた"],["は"],["むしろ"],["彼","かれ"],["を"],["ゆるし"],["、"],["また"],["慰さめて","なぐさめて"],["やるべきで"],["ある"],["。"],["そう"],["しない"],["と"],["、"],["その"],["人","ひと"],["は"],["ますます"],["深い","ぶかい"],["悲しみ","かなしみ"],["に"],["沈む","しずむ"],["か"],["も"],["知れない","しれない"],["。"]]},{"verse":8,"text":"そこでわたしは、彼,かれに対,たいして愛,あいを示,しめすように、あなたがたに勧,すすめる。","tok":[["そこ"],["で"],["わたし"],["は"],["、"],["彼","かれ"],["に対して","にたいして"],["愛","あい"],["を"],["示めす","しめす"],["よう"],["に"],["、"],["あなた"],["がた"],["に"],["勧める","すすめる"],["。"]]},{"verse":9,"text":"わたしが書,かきおくったのも、あなたがたがすべての事,ことについて従順,じゅうじゅんであるかどうかを、ためすためにほかならなかった。","tok":[["わたし"],["が"],["書きおくった","かきおくった"],["の"],["も"],["、"],["あなた"],["がた"],["が"],["すべて"],["の"],["事","こと"],["について"],["従順","じゅうじゅん"],["で"],["ある"],["か"],["どう"],["か"],["を"],["、"],["ためす"],["ため"],["に"],["ほか"],["ならなかった"],["。"]]},{"verse":10,"text":"もしあなたがたが、何,なにかのことについて人,ひとをゆるすなら、わたしもまたゆるそう。そして、もしわたしが何,なにかのことでゆるしたとすれば、それは、あなたがたのためにキリストのみまえでゆるしたのである。","tok":[["もし"],["あなた"],["が"],["た"],["が"],["、"],["何に","なに"],["か"],["の"],["こと"],["について"],["人","ひと"],["を"],["ゆるすなら"],["、"],["わたし"],["も"],["また"],["ゆる"],["そう"],["。"],["そして"],["、"],["もし"],["わたし"],["が"],["何に","なに"],["か"],["の"],["こと"],["で"],["ゆるした"],["と"],["すれば"],["、"],["それ"],["は"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["キリスト"],["のみ"],["まえ"],["で"],["ゆるした"],["ので"],["ある"],["。"]]},{"verse":11,"text":"そうするのは、サタンに欺,あざむかれることのないためである。わたしたちは、彼,かれの策略,さくりゃくを知,しらないわけではない。","tok":[["そう"],["する"],["の"],["は"],["、"],["サタン"],["に"],["欺かれる","あざむかれる"],["こと"],["の"],["ない"],["ため"],["で"],["ある"],["。"],["わたしたち"],["は"],["、"],["彼","かれ"],["の"],["策略","さくりゃく"],["を"],["知らない","しらない"],["わけ"],["で"],["は"],["ない"],["。"]]},{"verse":12,"text":"さて、キリストの福音,ふくいんのためにトロアスに行,いったとき、わたしのために主,しゅの門,もんが開,ひらかれたにもかかわらず、","tok":[["さて"],["、"],["キリスト"],["の"],["福音","ふくいん"],["の"],["ため"],["に"],["トロアス"],["に"],["行った","いった"],["とき"],["、"],["わたし"],["の"],["ため"],["に"],["主","しゅ"],["の"],["門","もん"],["が"],["開らかれた","ひらかれた"],["に"],["も"],["かかわらず"],["、"]]},{"verse":13,"text":"兄弟,きょうだいテトスに会,あえなかったので、わたしは気,きが気,きでなく、人々,ひとびとに別,わかれて、マケドニヤに出,でかけて行,いった。","tok":[["兄弟","きょうだい"],["テトス"],["に"],["会えなかった","あえなかった"],["ので"],["、"],["わたし"],["は"],["気","き"],["が"],["気","き"],["で"],["なく"],["、"],["人々","ひとびと"],["に"],["別かれて","わかれて"],["、"],["マケドニヤ"],["に"],["出かけて","でかけて"],["行った","いった"],["。"]]},{"verse":14,"text":"しかるに、神,かみは感謝,かんしゃすべきかな。神,かみはいつもわたしたちをキリストの凱旋,がいせんに伴,ともない行,ゆき、わたしたちをとおしてキリストを知,しる知識,ちしきのかおりを、至,いたる所,ところに放,はなって下,くださるのである。","tok":[["しかる"],["に"],["、"],["神","かみ"],["は"],["感謝","かんしゃ"],["すべき"],["か"],["な"],["。"],["神","かみ"],["は"],["いつも"],["わたしたち"],["を"],["キリスト"],["の"],["凱旋","がいせん"],["に"],["伴い","ともない"],["行き","ゆき"],["、"],["わたしたち"],["を"],["とおして"],["キリスト"],["を"],["知る","しる"],["知識","ちしき"],["の"],["かおり"],["を"],["、"],["至る所","いたるところ"],["に"],["放","は"],["なって"],["下さる","くださる"],["ので"],["ある"],["。"]]},{"verse":15,"text":"わたしたちは、救,すくわれる者,ものにとっても滅,ほろびる者,ものにとっても、神,かみに対,たいするキリストのかおりである。","tok":[["わたしたち"],["は"],["、"],["救われる","すくわれる"],["者","もの"],["にとって"],["も"],["滅びる","ほろびる"],["者","もの"],["にとって"],["も"],["、"],["神","かみ"],["に"],["対する","たいする"],["キリスト"],["の"],["かおり"],["で"],["ある"],["。"]]},{"verse":16,"text":"後者,こうしゃにとっては、死,しから死,しに至,いたらせるかおりであり、前者,ぜんしゃにとっては、いのちからいのちに至,いたらせるかおりである。いったい、このような任務,にんむに、だれが耐,たえ得,えようか。","tok":[["後者","こうしゃ"],["にとって"],["は"],["、"],["死","し"],["から"],["死","し"],["に"],["至らせる","いたらせる"],["かおり"],["で"],["あり"],["、"],["前者","ぜんしゃ"],["にとって"],["は"],["、"],["いのち"],["から"],["いのち"],["に"],["至らせる","いたらせる"],["かおり"],["で"],["ある"],["。"],["いったい"],["、"],["この"],["よう"],["な"],["任務","にんむ"],["に"],["、"],["だれ"],["が"],["耐え","たえ"],["得よう","えよう"],["か"],["。"]]},{"verse":17,"text":"しかし、わたしたちは、多,おおくの人,ひとのように神,かみの言,ことばを売物,うりものにせず、真心,まごころをこめて、神,かみにつかわされた者,ものとして神,かみのみまえで、キリストにあって語,かたるのである。","tok":[["しかし"],["、"],["わたしたち"],["は"],["、"],["多く","おおく"],["の"],["人","ひと"],["の"],["よう"],["に"],["神","かみ"],["の"],["言","ことば"],["を"],["売物","うりもの"],["に"],["せず"],["、"],["真心","まごころ"],["を"],["こめて"],["、"],["神","かみ"],["に"],["つかわされた"],["者","もの"],["として"],["神","かみ"],["のみ"],["まえ"],["で"],["、"],["キリスト"],["に"],["あって"],["語る","かたる"],["ので"],["ある"],["。"]]}]
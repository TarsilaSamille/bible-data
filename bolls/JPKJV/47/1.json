[{"verse":1,"text":"神,かみの御旨,みむねによりキリスト・イエスの使徒,しととなったパウロと、兄弟,きょうだいテモテとから、コリントにある神,かみの教会,きょうかい、ならびにアカヤ全土,ぜんどにいるすべての聖徒,せいとたちへ。","tok":[["神","かみ"],["の"],["御旨","みむね"],["に"],["より"],["キリスト"],["・"],["イエス"],["の"],["使徒","しと"],["と"],["なった"],["パウロ"],["と"],["、"],["兄弟","きょうだい"],["テモテ"],["と"],["から"],["、"],["コリント"],["に"],["ある"],["神","かみ"],["の"],["教会","きょうかい"],["、"],["ならびに"],["アカヤ"],["全土","ぜんど"],["に"],["いる"],["すべて"],["の"],["聖徒","せいと"],["たち"],["へ"],["。"]]},{"verse":2,"text":"わたしたちの父,ちちなる神,かみと主,しゅイエス・キリストから、恵,めぐみと平安,へいあんとが、あなたがたにあるように。","tok":[["わたしたち"],["の"],["父","ちち"],["なる"],["神","かみ"],["と"],["主","しゅ"],["イエス"],["・"],["キリスト"],["から"],["、"],["恵","めぐみ"],["と"],["平安","へいあん"],["と"],["が"],["、"],["あなた"],["がた"],["に"],["ある"],["よう"],["に"],["。"]]},{"verse":3,"text":"ほむべきかな、わたしたちの主,しゅイエス・キリストの父,ちちなる神,かみ、あわれみ深,ぶかき父,ちち、慰,なぐさめに満,みちたる神,かみ。","tok":[["ほ"],["むべき"],["か"],["な"],["、"],["わたしたち"],["の"],["主","しゅ"],["イエス"],["・"],["キリスト"],["の"],["父","ちち"],["なる"],["神","かみ"],["、"],["あわれみ"],["深","ぶ"],["かき"],["父","ちち"],["、"],["慰さめ","なぐさめ"],["に"],["満ちたる","みちたる"],["神","かみ"],["。"]]},{"verse":4,"text":"神,かみは、いかなる患難,かんなんの中,なかにいる時,ときでもわたしたちを慰,なぐさめて下,くださり、また、わたしたち自身,じしんも、神,かみに慰,なぐさめていただくその慰,なぐさめをもって、あらゆる患難,かんなんの中,なかにある人々,ひとびとを慰,なぐさめることができるようにして下,くださるのである。","tok":[["神","かみ"],["は"],["、"],["いかなる"],["患難","かんなん"],["の"],["中","なか"],["に"],["いる"],["時","とき"],["で"],["も"],["わたしたち"],["を"],["慰さめて","なぐさめて"],["下さり","くださり"],["、"],["また"],["、"],["わたしたち"],["自身","じしん"],["も"],["、"],["神","かみ"],["に"],["慰さめて","なぐさめて"],["いただく"],["その"],["慰さめ","なぐさめ"],["を"],["もって"],["、"],["あらゆる"],["患難","かんなん"],["の"],["中","なか"],["に"],["ある"],["人々","ひとびと"],["を"],["慰さめる","なぐさめる"],["こと"],["が"],["できる"],["よう"],["に"],["して"],["下さる","くださる"],["ので"],["ある"],["。"]]},{"verse":5,"text":"それは、キリストの苦難,くなんがわたしたちに満,みちあふれているように、わたしたちの受,うける慰,なぐさめもまた、キリストによって満,みちあふれているからである。","tok":[["それ"],["は"],["、"],["キリスト"],["の"],["苦難","くなん"],["が"],["わたしたち"],["に"],["満ちあふれて","みちあふれて"],["いる"],["よう"],["に"],["、"],["わたしたち"],["の"],["受ける","うける"],["慰さめ","なぐさめ"],["も"],["また"],["、"],["キリスト"],["によって"],["満ちあふれて","みちあふれて"],["いる"],["から"],["で"],["ある"],["。"]]},{"verse":6,"text":"わたしたちが患難,かんなんに会,あうなら、それはあなたがたの慰,なぐさめと救,すくいとのためであり、慰,なぐさめを受,うけるなら、それはあなたがたの慰,なぐさめのためであって、その慰,なぐさめは、わたしたちが受,うけているのと同,おなじ苦難,くなんに耐,たえさせる力,ちからとなるのである。","tok":[["わたしたち"],["が"],["患難","かんなん"],["に"],["会うなら","あうなら"],["、"],["それ"],["は"],["あなた"],["がた"],["の"],["慰さめ","なぐさめ"],["と"],["救い","すくい"],["と"],["の"],["ため"],["で"],["あり"],["、"],["慰さめ","なぐさめ"],["を"],["受るなら","うけるなら"],["、"],["それ"],["は"],["あなた"],["がた"],["の"],["慰さめ","なぐさめ"],["の"],["ため"],["で"],["あって"],["、"],["その"],["慰さめ","なぐさめ"],["は"],["、"],["わたしたち"],["が"],["受て","うけて"],["いる"],["の"],["と"],["同じ","おなじ"],["苦難","くなん"],["に"],["耐えさせる","たえさせる"],["力","ちから"],["と"],["なる"],["ので"],["ある"],["。"]]},{"verse":7,"text":"だから、あなたがたに対,たいしていだいているわたしたちの望,のぞみは、動,うごくことがない。あなたがたが、わたしたちと共,ともに苦難,くなんにあずかっているように、慰,なぐさめにも共,ともにあずかっていることを知,しっているからである。","tok":[["だ"],["から"],["、"],["あなた"],["がた"],["に対して","にたいして"],["いだいて"],["いる"],["わたしたち"],["の"],["望み","のぞみ"],["は"],["、"],["動く","うごく"],["こと"],["が"],["ない"],["。"],["あなた"],["が"],["た"],["が"],["、"],["わたしたち"],["と"],["共","とも"],["に"],["苦難","くなん"],["に"],["あずかって"],["いる"],["よう"],["に"],["、"],["慰さめ","なぐさめ"],["に"],["も"],["共","とも"],["に"],["あずかって"],["いる"],["こと"],["を"],["知って","しって"],["いる"],["から"],["で"],["ある"],["。"]]},{"verse":8,"text":"兄弟,きょうだいたちよ。わたしたちがアジヤで会,あった患難,かんなんを、知,しらずにいてもらいたくない。わたしたちは極度,きょくどに、耐,たえられないほど圧迫,あっぱくされて、生,いきる望,のぞみをさえ失,うしなってしまい、","tok":[["兄弟","きょうだい"],["たち"],["よ"],["。"],["わたしたち"],["が"],["アジヤ"],["で"],["会った","あった"],["患難","かんなん"],["を"],["、"],["知らず","しらず"],["に"],["いて"],["もらいたく"],["ない"],["。"],["わたしたち"],["は"],["極度","きょくど"],["に"],["、"],["耐えられない","たえられない"],["ほど"],["圧迫","あっぱく"],["されて"],["、"],["生きる","いきる"],["望み","のぞみ"],["を"],["さえ"],["失なって","うしなって"],["しまい"],["、"]]},{"verse":9,"text":"心,こころのうちで死,しを覚悟,かくごし、自分,じぶん自身,じしんを頼,たのみとしないで、死人,しにんをよみがえらせて下,くださる神,かみを頼,たのみとするに至,いたった。","tok":[["心","こころ"],["の"],["うち"],["で"],["死","し"],["を"],["覚悟","かくご"],["し"],["、"],["自分","じぶん"],["自身","じしん"],["を"],["頼み","たのみ"],["と"],["しないで"],["、"],["死人","しにん"],["を"],["よみがえらせて"],["下さる","くださる"],["神","かみ"],["を"],["頼み","たのみ"],["と"],["する"],["に"],["至った","いたった"],["。"]]},{"verse":10,"text":"神,かみはこのような死,しの危険,きけんから、わたしたちを救,すくい出,だして下,くださった、また救,すくい出,だして下,くださるであろう。わたしたちは、神,かみが今後,こんごも救,すくい出,だして下,くださることを望,のぞんでいる。","tok":[["神","かみ"],["は"],["この"],["よう"],["な"],["死","し"],["の"],["危険","きけん"],["から"],["、"],["わたしたち"],["を"],["救い出して","すくいだして"],["下さった","くださった"],["、"],["また"],["救い出して","すくいだして"],["下さるで","くださるで"],["あろう"],["。"],["わたしたち"],["は"],["、"],["神","かみ"],["が"],["今後","こんご"],["も"],["救い出して","すくいだして"],["下さる","くださる"],["こと"],["を"],["望んで","のぞんで"],["いる"],["。"]]},{"verse":11,"text":"そして、あなたがたもまた祈,いのりをもって、ともどもに、わたしたちを助,たすけてくれるであろう。これは多,おおくの人々,ひとびとの願,ねがいによりわたしたちに賜,たまわった恵,めぐみについて、多,おおくの人,ひとが感謝,かんしゃをささげるようになるためである。","tok":[["そして"],["、"],["あなた"],["がた"],["も"],["また"],["祈","いのり"],["を"],["もって"],["、"],["ともども"],["に"],["、"],["わたしたち"],["を"],["助けて","たすけて"],["くれるで"],["あろう"],["。"],["これ"],["は"],["多く","おおく"],["の"],["人々","ひとびと"],["の"],["願い","ねがい"],["に"],["より"],["わたしたち"],["に"],["賜わった","たまわった"],["恵","めぐみ"],["について"],["、"],["多く","おおく"],["の"],["人","ひと"],["が"],["感謝","かんしゃ"],["を"],["ささげる"],["よう"],["に"],["なる"],["ため"],["で"],["ある"],["。"]]},{"verse":12,"text":"さて、わたしたちがこの世,よで、ことにあなたがたに対,たいし、人間,にんげんの知恵,ちえによってではなく神,かみの恵,めぐみによって、神,かみの神聖,しんせいと真実,しんじつとによって行動,こうどうしてきたことは、実,じつにわたしたちの誇,ほこりであって、良心,りょうしんのあかしするところである。","tok":[["さて"],["、"],["わたしたち"],["が"],["この世","このよ"],["で"],["、"],["こと"],["に"],["あなた"],["がた"],["に"],["対し","たいし"],["、"],["人間","にんげん"],["の"],["知恵","ちえ"],["によって"],["で"],["は"],["なく"],["神","かみ"],["の"],["恵","めぐみ"],["によって"],["、"],["神","かみ"],["の"],["神聖","しんせい"],["と"],["真実","しんじつ"],["と"],["によって"],["行動","こうどう"],["して"],["きた"],["こと"],["は"],["、"],["実","じつ"],["に"],["わたしたち"],["の"],["誇","ほこり"],["で"],["あって"],["、"],["良心","りょうしん"],["の"],["あかし"],["する"],["ところ"],["で"],["ある"],["。"]]},{"verse":13,"text":"わたしたちが書,かいていることは、あなたがたが読,よんで理解,りかいできないことではない。それを完全,かんぜんに理解,りかいしてくれるように、わたしは希望,きぼうする。","tok":[["わたしたち"],["が"],["書いて","かいて"],["いる"],["こと"],["は"],["、"],["あなた"],["がた"],["が"],["読んで","よんで"],["理解","りかい"],["できない"],["こと"],["で"],["は"],["ない"],["。"],["それ"],["を"],["完全","かんぜん"],["に"],["理解","りかい"],["して"],["くれる"],["よう"],["に"],["、"],["わたし"],["は"],["希望","きぼう"],["する"],["。"]]},{"verse":14,"text":"すでにある程度,ていどわたしたちを理解,りかいしてくれているとおり、わたしたちの主,しゅイエスの日,ひには、あなたがたがわたしたちの誇,ほこりであるように、わたしたちもあなたがたの誇,ほこりなのである。","tok":[["すでに"],["ある"],["程度","ていど"],["わたしたち"],["を"],["理解","りかい"],["して"],["くれて"],["いる"],["とおり"],["、"],["わたしたち"],["の"],["主","しゅ"],["イエス"],["の"],["日","ひ"],["に"],["は"],["、"],["あなた"],["がた"],["が"],["わたしたち"],["の"],["誇","ほこり"],["で"],["ある"],["よう"],["に"],["、"],["わたしたち"],["も"],["あなた"],["がた"],["の"],["誇","ほこり"],["な"],["ので"],["ある"],["。"]]},{"verse":15,"text":"この確信,かくしんをもって、わたしたちはもう一度,いちど恵,めぐみを得,えさせたいので、まずあなたがたの所,ところに行,いき、","tok":[["この"],["確信","かくしん"],["を"],["もって"],["、"],["わたしたち"],["は"],["もう"],["一度","いちど"],["恵","めぐみ"],["を"],["得させたい","えさせたい"],["ので"],["、"],["まず"],["あなた"],["がた"],["の"],["所","ところ"],["に"],["行き","いき"],["、"]]},{"verse":16,"text":"それからそちらを通,とおってマケドニヤにおもむき、そして再,ふたたびマケドニヤからあなたがたの所,ところに帰,かえり、あなたがたの見送,みおくりを受,うけてユダヤに行,ゆく計画,けいかくを立,たてたのである。","tok":[["それ"],["から"],["そちら"],["を"],["通って","とおって"],["マケドニヤ"],["に"],["おもむき"],["、"],["そして"],["再び","ふたたび"],["マケドニヤ"],["から"],["あなた"],["がた"],["の"],["所","ところ"],["に"],["帰えり","かえり"],["、"],["あなた"],["がた"],["の"],["見送り","みおくり"],["を"],["受て","うけて"],["ユダヤ"],["に"],["行く","ゆく"],["計画","けいかく"],["を"],["立てた","たてた"],["ので"],["ある"],["。"]]},{"verse":17,"text":"この計画,けいかくを立,たてたのは、軽率,けいそつなことであったであろうか。それとも、自分,じぶんの計画,けいかくを肉,にくの思,おもいによって計画,けいかくしたため、わたしの「しかり、しかり」が同時,どうじに「否,いな、否,いな」であったのだろうか。","tok":[["この"],["計画","けいかく"],["を"],["立てた","たてた"],["の"],["は"],["、"],["軽率","けいそつ"],["な"],["こと"],["で"],["あったで"],["あろう"],["か"],["。"],["それ"],["と"],["も"],["、"],["自分","じぶん"],["の"],["計画","けいかく"],["を"],["肉","にく"],["の"],["思い","おもい"],["によって"],["計画","けいかく"],["した"],["ため"],["、"],["わたし"],["の"],["「"],["しかり"],["、"],["しかり"],["」"],["が"],["同時","どうじ"],["に"],["「"],["否","いな"],["、"],["否","いな"],["」"],["で"],["あった"],["の"],["だろう"],["か"],["。"]]},{"verse":18,"text":"神,かみの真実,しんじつにかけて言,いうが、あなたがたに対,たいするわたしの言葉,ことばは、「しかり」と同時,どうじに「否,いな」というようなものではない。","tok":[["神","かみ"],["の"],["真実","しんじつ"],["に"],["かけて"],["言う","いう"],["が"],["、"],["あなた"],["がた"],["に"],["対する","たいする"],["わたし"],["の"],["言葉","ことば"],["は"],["、"],["「"],["しかり"],["」"],["と"],["同時","どうじ"],["に"],["「"],["否","いな"],["」"],["と"],["いう"],["よう"],["な"],["もの"],["で"],["は"],["ない"],["。"]]},{"verse":19,"text":"なぜなら、わたしたち、すなわち、わたしとシルワノとテモテとが、あなたがたに宣,のべ伝,つたえた神,かみの子,こキリスト・イエスは、「しかり」となると同時,どうじに「否,いな」となったのではない。そうではなく、「しかり」がイエスにおいて実現,じつげんされたのである。","tok":[["なぜ"],["なら"],["、"],["わたしたち"],["、"],["すなわち"],["、"],["わたし"],["と"],["シルワノ"],["と"],["テモテ"],["と"],["が"],["、"],["あなた"],["がた"],["に"],["宣べ伝えた","のべつたえた"],["神","かみ"],["の"],["子","こ"],["キリスト"],["・"],["イエス"],["は"],["、"],["「"],["しかり"],["」"],["と"],["なる"],["と"],["同時","どうじ"],["に"],["「"],["否","いな"],["」"],["と"],["なった"],["ので"],["は"],["ない"],["。"],["そう"],["で"],["は"],["なく"],["、"],["「"],["しかり"],["」"],["が"],["イエス"],["に"],["おいて"],["実現","じつげん"],["された"],["ので"],["ある"],["。"]]},{"verse":20,"text":"なぜなら、神,かみの約束,やくそくはことごとく、彼,かれにおいて「しかり」となったからである。だから、わたしたちは、彼,かれによって「アァメン」と唱,となえて、神,かみに栄光,えいこうを帰,きするのである。","tok":[["なぜ"],["なら"],["、"],["神","かみ"],["の"],["約束","やくそく"],["は"],["ことごとく"],["、"],["彼","かれ"],["に"],["おいて"],["「"],["しかり"],["」"],["と"],["なった"],["から"],["で"],["ある"],["。"],["だ"],["から"],["、"],["わたしたち"],["は"],["、"],["彼","かれ"],["によって"],["「"],["アァメン"],["」"],["と"],["唱えて","となえて"],["、"],["神","かみ"],["に"],["栄光","えいこう"],["を"],["帰する","きする"],["ので"],["ある"],["。"]]},{"verse":21,"text":"あなたがたと共,ともにわたしたちを、キリストのうちに堅,かたくささえ、油,あぶらをそそいで下,くださったのは、神,かみである。","tok":[["あなた"],["がた"],["と"],["共","とも"],["に"],["わたしたち"],["を"],["、"],["キリスト"],["の"],["うち"],["に"],["堅く","かたく"],["ささえ"],["、"],["油","あぶら"],["を"],["そそいで"],["下さった","くださった"],["の"],["は"],["、"],["神","かみ"],["で"],["ある"],["。"]]},{"verse":22,"text":"神,かみはまた、わたしたちに証印,しょういんをおし、その保証,ほしょうとして、わたしたちの心,こころに御霊,みたまを賜,たまわったのである。","tok":[["神","かみ"],["は"],["また"],["、"],["わたしたち"],["に"],["証印","しょういん"],["を"],["おし"],["、"],["その"],["保証","ほしょう"],["として"],["、"],["わたしたち"],["の"],["心","こころ"],["に"],["御霊","みたま"],["を"],["賜わった","たまわった"],["ので"],["ある"],["。"]]},{"verse":23,"text":"わたしは自分,じぶんの魂,たましいをかけ、神,かみを証人,しょうにんに呼,よび求,もとめて言,いうが、わたしがコリントに行,いかないでいるのは、あなたがたに対,たいして寛大,かんだいでありたいためである。","tok":[["わたし"],["は"],["自分","じぶん"],["の"],["魂","たましい"],["を"],["かけ"],["、"],["神","かみ"],["を"],["証人","しょうにん"],["に"],["呼び求めて","よびもとめて"],["言う","いう"],["が"],["、"],["わたし"],["が"],["コリント"],["に"],["行かないで","いかないで"],["いる"],["の"],["は"],["、"],["あなた"],["がた"],["に対して","にたいして"],["寛大","かんだい"],["で"],["ありたい"],["ため"],["で"],["ある"],["。"]]},{"verse":24,"text":"わたしたちは、あなたがたの信仰,しんこうを支配,しはいする者,ものではなく、あなたがたの喜,よろこびのために共,ともに働,はたらいている者,ものにすぎない。あなたがたは、信仰,しんこうに堅,かたく立,たっているからである。","tok":[["わたしたち"],["は"],["、"],["あなた"],["がた"],["の"],["信仰","しんこう"],["を"],["支配","しはい"],["する"],["者","もの"],["で"],["は"],["なく"],["、"],["あなた"],["がた"],["の"],["喜こび","よろこび"],["の"],["ため"],["に"],["共","とも"],["に"],["働いて","はたらいて"],["いる"],["者","もの"],["に"],["すぎない"],["。"],["あなた"],["がた"],["は"],["、"],["信仰","しんこう"],["に"],["堅く","かたく"],["立って","たって"],["いる"],["から"],["で"],["ある"],["。"]]}]
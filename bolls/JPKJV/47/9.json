[{"verse":1,"text":"聖徒,せいとたちに対,たいする援助,えんじょについては、いまさら、あなたがたに書,かきおくる必要,ひつようはない。","tok":[["聖徒","せいと"],["たち"],["に"],["対する","たいする"],["援助","えんじょ"],["について"],["は"],["、"],["いまさら"],["、"],["あなた"],["がた"],["に"],["書きおくる","かきおくる"],["必要","ひつよう"],["は"],["ない"],["。"]]},{"verse":2,"text":"わたしは、あなたがたの好意,こういを知,しっており、そのために、あなたがたのことをマケドニヤの人々,ひとびとに誇,ほこって、アカヤでは昨年,さくねん以来,いらい、すでに準備,じゅんびをしているのだと言,いった。そして、あなたがたの熱心,ねっしんは、多,おおくの人,ひとを奮起,ふんきさせたのである。","tok":[["わたし"],["は"],["、"],["あなた"],["がた"],["の"],["好意","こうい"],["を"],["知って","しって"],["おり"],["、"],["その"],["ため"],["に"],["、"],["あなた"],["がた"],["の"],["こと"],["を"],["マケドニヤ"],["の"],["人々","ひとびと"],["に"],["誇って","ほこって"],["、"],["アカヤ"],["で"],["は"],["昨年","さくねん"],["以来","いらい"],["、"],["すでに"],["準備","じゅんび"],["を"],["して"],["いる"],["の"],["だ"],["と"],["言った","いった"],["。"],["そして"],["、"],["あなた"],["がた"],["の"],["熱心","ねっしん"],["は"],["、"],["多く","おおく"],["の"],["人","ひと"],["を"],["奮起","ふんき"],["させた"],["ので"],["ある"],["。"]]},{"verse":3,"text":"わたしが兄弟,きょうだいたちを送,おくることにしたのは、あなたがたについてわたしたちの誇,ほこったことが、この場合,ばあいむなしくならないで、わたしが言,いったとおり準備,じゅんびしていてもらいたいからである。","tok":[["わたし"],["が"],["兄弟","きょうだい"],["たち"],["を"],["送る","おくる"],["こと"],["に"],["した"],["の"],["は"],["、"],["あなた"],["がた"],["について"],["わたしたち"],["の"],["誇った","ほこった"],["こと"],["が"],["、"],["この"],["場合","ばあい"],["むなしく"],["ならないで"],["、"],["わたし"],["が"],["言った","いった"],["とおり"],["準備","じゅんび"],["して"],["いて"],["もらいたい"],["から"],["で"],["ある"],["。"]]},{"verse":4,"text":"そうでないと、万一,まんいちマケドニヤ人,びとがわたしと一緒,いっしょに行,いって、準備,じゅんびができていないのを見,みたら、あなたがたはもちろん、わたしたちも、かように信,しんじきっていただけに、恥,はじをかくことになろう。","tok":[["そう"],["で"],["ない"],["と"],["、"],["万一","まんいち"],["マケドニヤ"],["人","び"],["と"],["が"],["わたし"],["と"],["一緒","いっしょ"],["に"],["行って","いって"],["、"],["準備","じゅんび"],["が"],["できて"],["いない"],["の"],["を"],["見たら","みたら"],["、"],["あなた"],["がた"],["は"],["もちろん"],["、"],["わたしたち"],["も"],["、"],["かよう"],["に"],["信じ","しんじ"],["きって"],["いた"],["だけ"],["に"],["、"],["恥","はじ"],["を"],["かく"],["こと"],["に"],["なろう"],["。"]]},{"verse":5,"text":"だから、わたしは兄弟,きょうだいたちを促,うながして、あなたがたの所,ところへ先,さきに行,いかせ、以前,いぜんあなたがたが約束,やくそくしていた贈,おくり物,ものの準備,じゅんびをさせておくことが必要,ひつようだと思,おもった。それをしぶりながらではなく、心,こころをこめて用意,よういしていてほしい。","tok":[["だ"],["から"],["、"],["わたし"],["は"],["兄弟","きょうだい"],["たち"],["を"],["促がして","うながして"],["、"],["あなた"],["がた"],["の"],["所","ところ"],["へ"],["先","さき"],["に"],["行かせ","いかせ"],["、"],["以前","いぜん"],["あなた"],["がた"],["が"],["約束","やくそく"],["して"],["いた"],["贈り物","おくりもの"],["の"],["準備","じゅんび"],["を"],["させて"],["おく"],["こと"],["が"],["必要","ひつよう"],["だ"],["と"],["思った","おもった"],["。"],["それ"],["を"],["しぶり"],["ながら"],["で"],["は"],["なく"],["、"],["心","こころ"],["を"],["こめて"],["用意","ようい"],["して"],["いて"],["ほしい"],["。"]]},{"verse":6,"text":"わたしの考,かんがえはこうである。少,すこししかまかない者,ものは、少,すこししか刈,かり取,とらず、豊,ゆたかにまく者,ものは、豊,ゆたかに刈,かり取,とることになる。","tok":[["わたし"],["の"],["考","かんがえ"],["は"],["こう"],["で"],["ある"],["。"],["少し","すこし"],["しか"],["まかない"],["者","もの"],["は"],["、"],["少し","すこし"],["しか"],["刈取らず","かりとらず"],["、"],["豊","ゆたか"],["に"],["まく者","まくもの"],["は"],["、"],["豊","ゆたか"],["に"],["刈取る","かりとる"],["こと"],["に"],["なる"],["。"]]},{"verse":7,"text":"各自,かくじは惜,おしむ心,こころからでなく、また、しいられてでもなく、自,みずから心,こころで決,きめたとおりにすべきである。神,かみは喜,よろこんで施,ほどこす人,ひとを愛,あいして下,くださるのである。","tok":[["各自","かくじ"],["は"],["惜む","おしむ"],["心","こころ"],["から"],["で"],["なく"],["、"],["また"],["、"],["し"],["いられて"],["で"],["も"],["なく"],["、"],["自から","みずから"],["心","こころ"],["で"],["決めた","きめた"],["とおり"],["に"],["すべきで"],["ある"],["。"],["神","かみ"],["は"],["喜こんで","よろこんで"],["施す","ほどこす"],["人","ひと"],["を"],["愛して","あいして"],["下さる","くださる"],["ので"],["ある"],["。"]]},{"verse":8,"text":"神,かみはあなたがたにあらゆる恵,めぐみを豊,ゆたかに与,あたえ、あなたがたを常,つねにすべてのことに満,みち足,たらせ、すべての良,よいわざに富,とませる力,ちからのあるかたなのである。","tok":[["神","かみ"],["は"],["あなた"],["がた"],["に"],["あらゆる"],["恵","めぐみ"],["を"],["豊","ゆたか"],["に"],["与","あたえ"],["、"],["あなた"],["がた"],["を"],["常","つね"],["に"],["すべて"],["の"],["こと"],["に"],["満ち","みち"],["足らせ","たらせ"],["、"],["すべて"],["の"],["良い","よい"],["わざ"],["に"],["富ませる","とませる"],["力","ちから"],["の"],["ある"],["かた"],["な"],["ので"],["ある"],["。"]]},{"verse":9,"text":"「彼,かれは貧,まずしい人,ひとたちに散,ちらして与,あたえた。その義,ぎは永遠,えいえんに続,つづくであろう」と書,かいてあるとおりである。","tok":[["「"],["彼","かれ"],["は"],["貧しい","まずしい"],["人","ひと"],["たち"],["に"],["散らして","ちらして"],["与","あたえ"],["た"],["。"],["その"],["義","ぎ"],["は"],["永遠","えいえん"],["に"],["続","つづく"],["で"],["あろう"],["」"],["と"],["書いて","かいて"],["ある"],["とおり"],["で"],["ある"],["。"]]},{"verse":10,"text":"種,たねまく人,ひとに種,たねと食,たべるためのパンとを備,そなえて下,くださるかたは、あなたがたにも種,たねを備,そなえ、それをふやし、そしてあなたがたの義,ぎの実,みを増,まして下,くださるのである。","tok":[["種","た"],["ね"],["まく人","まくひと"],["に"],["種","たね"],["と"],["食べる","たべる"],["ため"],["の"],["パン"],["と"],["を"],["備","そなえ"],["て"],["下さる","くださる"],["かた"],["は"],["、"],["あなた"],["がた"],["に"],["も"],["種","たね"],["を"],["備","そなえ"],["、"],["それ"],["を"],["ふやし"],["、"],["そして"],["あなた"],["がた"],["の"],["義","ぎ"],["の"],["実","み"],["を"],["増して","まして"],["下さる","くださる"],["ので"],["ある"],["。"]]},{"verse":11,"text":"こうして、あなたがたはすべてのことに豊,ゆたかになって、惜,おしみなく施,ほどこし、その施,ほどこしはわたしたちの手,てによって行,おこなわれ、神,かみに感謝,かんしゃするに至,いたるのである。","tok":[["こう"],["して"],["、"],["あなた"],["がた"],["は"],["すべて"],["の"],["こと"],["に"],["豊","ゆたか"],["に"],["なって"],["、"],["惜み","おしみ"],["なく"],["施し","ほどこし"],["、"],["その"],["施し","ほどこし"],["は"],["わたしたち"],["の"],["手","て"],["によって"],["行なわれ","おこなわれ"],["、"],["神","かみ"],["に"],["感謝","かんしゃ"],["する"],["に"],["至る","いたる"],["ので"],["ある"],["。"]]},{"verse":12,"text":"なぜなら、この援助,えんじょの働,はたらきは、聖徒,せいとたちの欠乏,けつぼうを補,おぎなえだけではなく、神,かみに対,たいする多,おおくの感謝,かんしゃによってますます豊,ゆたかになるからである。","tok":[["なぜ"],["なら"],["、"],["この"],["援助","えんじょ"],["の"],["働らき","はたらき"],["は"],["、"],["聖徒","せいと"],["たち"],["の"],["欠乏","けつぼう"],["を"],["補なえ","おぎなえ"],["だけ"],["で"],["は"],["なく"],["、"],["神","かみ"],["に"],["対する","たいする"],["多く","おおく"],["の"],["感謝","かんしゃ"],["によって"],["ますます"],["豊","ゆたか"],["に"],["なる"],["から"],["で"],["ある"],["。"]]},{"verse":13,"text":"すなわち、この援助,えんじょを行,おこなった結果,けっかとして、あなたがたがキリストの福音,ふくいんの告白,こくはくに対,たいして従順,じゅうじゅんであることや、彼,かれらにも、すべての人,ひとにも、惜,おしみなく施,ほどこしをしていることがわかってきて、彼,かれらは神,かみに栄光,えいこうを帰,きし、","tok":[["すなわち"],["、"],["この"],["援助","えんじょ"],["を"],["行なった","おこなった"],["結果","けっか"],["として"],["、"],["あなた"],["がた"],["が"],["キリスト"],["の"],["福音","ふくいん"],["の"],["告白","こくはく"],["に対して","にたいして"],["従順","じゅうじゅん"],["で"],["ある"],["こと"],["や"],["、"],["彼","かれ"],["ら"],["に"],["も"],["、"],["すべて"],["の"],["人","ひと"],["に"],["も"],["、"],["惜みなく","おしみなく"],["施し","ほどこし"],["を"],["して"],["いる"],["こと"],["が"],["わかって"],["きて"],["、"],["彼","かれ"],["ら"],["は"],["神","かみ"],["に"],["栄光","えいこう"],["を"],["帰し","きし"],["、"]]},{"verse":14,"text":"そして、あなたがたに賜,たまわったきわめて豊,ゆたかな神,かみの恵,めぐみのゆえに、あなたがたを慕,したい、あなたがたのために祈,いのるのである。","tok":[["そして"],["、"],["あなた"],["がた"],["に"],["賜わった","たまわった"],["きわめて"],["豊","ゆたか"],["な"],["神","かみ"],["の"],["恵","めぐみ"],["の"],["ゆえ"],["に"],["、"],["あなた"],["がた"],["を"],["慕い","したい"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["祈る","いのる"],["ので"],["ある"],["。"]]},{"verse":15,"text":"言,いいつくせない賜物,たまもののゆえに、神,かみに感謝,かんしゃする。","tok":[["言い","いい"],["つくせない"],["賜物","たまもの"],["の"],["ゆえ"],["に"],["、"],["神","かみ"],["に"],["感謝","かんしゃ"],["する"],["。"]]}]
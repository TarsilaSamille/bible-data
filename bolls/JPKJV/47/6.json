[{"verse":1,"text":"わたしたちはまた、神,かみと共,ともに働,はたらく者,ものとして、あなたがたに勧,すすめる。神,かみの恵,めぐみをいたずらに受,うけてはならない。","tok":[["わたしたち"],["は"],["また"],["、"],["神","かみ"],["と"],["共","とも"],["に"],["働く","はたらく"],["者","もの"],["として"],["、"],["あなた"],["がた"],["に"],["勧める","すすめる"],["。"],["神","かみ"],["の"],["恵","めぐみ"],["を"],["いたずら"],["に"],["受て","うけて"],["は"],["ならない"],["。"]]},{"verse":2,"text":"神,かみはこう言,いわれる、「わたしは、恵,めぐみの時,ときにあなたの願,ねがいを聞,ききいれ、救,すくいの日,ひにあなたを助,たすけた」。見,みよ、今,いまは恵,めぐみの時,とき、見,みよ、今,いまは救,すくいの日,ひである。","tok":[["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["「"],["わたし"],["は"],["、"],["恵","めぐみ"],["の"],["時","とき"],["に"],["あなた"],["の"],["願い","ねがい"],["を"],["聞きいれ","ききいれ"],["、"],["救い","すくい"],["の"],["日","ひ"],["に"],["あなた"],["を"],["助けた","たすけた"],["」"],["。"],["見よ","みよ"],["、"],["今","いま"],["は"],["恵","めぐみ"],["の"],["時","とき"],["、"],["見よ","みよ"],["、"],["今","いま"],["は"],["救い","すくい"],["の"],["日","ひ"],["で"],["ある"],["。"]]},{"verse":3,"text":"この務,つとめがそしりを招,まねかないために、わたしたちはどんな事,ことにも、人,ひとにつまずきを与,あたえないようにし、","tok":[["この"],["務め","つとめ"],["が"],["そ"],["しり"],["を"],["招かない","まねかない"],["ため"],["に"],["、"],["わたしたち"],["は"],["どんな"],["事","こと"],["に"],["も"],["、"],["人","ひと"],["に"],["つまずき"],["を"],["与えない","あたえない"],["よう"],["に"],["し"],["、"]]},{"verse":4,"text":"かえって、あらゆる場合,ばあいに、神,かみの僕,しもべとして、自分,じぶんを人々,ひとびとにあらわしている。すなわち、極度,きょくどの忍苦,にんくにも、患難,かんなんにも、危機,ききにも、行,ゆき詰,づまりにも、","tok":[["かえって"],["、"],["あらゆる"],["場合","ばあい"],["に"],["、"],["神","かみ"],["の"],["僕","し"],["も"],["べと"],["して"],["、"],["自分","じぶん"],["を"],["人々","ひとびと"],["に"],["あらわして"],["いる"],["。"],["すなわち"],["、"],["極度","きょくど"],["の"],["忍苦","にんく"],["に"],["も"],["、"],["患難","かんなん"],["に"],["も"],["、"],["危機","きき"],["に"],["も"],["、"],["行き詰まり","ゆきづまり"],["に"],["も"],["、"]]},{"verse":5,"text":"むち打,うたれることにも、入獄,にゅうごくにも、騒乱,そうらんにも、労苦,ろうくにも、徹夜,てつやにも、飢餓,きがにも、","tok":[["むち打たれる","むちうたれる"],["こと"],["に"],["も"],["、"],["入獄","にゅうごく"],["に"],["も"],["、"],["騒乱","そうらん"],["に"],["も"],["、"],["労苦","ろうく"],["に"],["も"],["、"],["徹夜","てつや"],["に"],["も"],["、"],["飢餓","きが"],["に"],["も"],["、"]]},{"verse":6,"text":"真実,しんじつと知識,ちしきと寛容,かんようと、慈愛,じあいと聖霊,せいれいと偽,いつわりのない愛,あいと、","tok":[["真実","しんじつ"],["と"],["知識","ちしき"],["と"],["寛容","かんよう"],["と"],["、"],["慈愛","じあい"],["と"],["聖霊","せいれい"],["と"],["偽わり","いつわり"],["の"],["ない"],["愛","あい"],["と"],["、"]]},{"verse":7,"text":"真理,しんりの言葉,ことばと神,かみの力,ちからとにより、左右,さゆうに持,もっている義,ぎの武器,ぶきにより、","tok":[["真理","しんり"],["の"],["言葉","ことば"],["と"],["神","かみ"],["の"],["力","ちから"],["と"],["に"],["より"],["、"],["左右","さゆう"],["に"],["持って","もって"],["いる"],["義","ぎ"],["の"],["武器","ぶき"],["に"],["より"],["、"]]},{"verse":8,"text":"ほめられても、そしられても、悪評,あくひょうを受,うけても、好評,こうひょうを博,はくしても、神,かみの僕,しもべとして自分,じぶんをあらわしている。わたしたちは、人,ひとを惑,まどわしているようであるが、しかも真実,しんじつであり、","tok":[["ほめられて"],["も"],["、"],["そしられて"],["も"],["、"],["悪評","あくひょう"],["を"],["受て","うけて"],["も"],["、"],["好評","こうひょう"],["を"],["博して","はくして"],["も"],["、"],["神","かみ"],["の"],["僕","し"],["も"],["べと"],["して"],["自分","じぶん"],["を"],["あらわして"],["いる"],["。"],["わたしたち"],["は"],["、"],["人","ひと"],["を"],["惑わして","まどわして"],["いる"],["よう"],["で"],["ある"],["が"],["、"],["しかも"],["真実","しんじつ"],["で"],["あり"],["、"]]},{"verse":9,"text":"人,ひとに知,しられていないようであるが、認,みとめられ、死,しにかかっているようであるが、見,みよ、生,いきており、懲,こらしめられているようであるが、殺,ころされず、","tok":[["人","ひと"],["に"],["知られて","しられて"],["いない"],["よう"],["で"],["ある"],["が"],["、"],["認められ","みとめられ"],["、"],["死にかかって","しにかかって"],["いる"],["よう"],["で"],["ある"],["が"],["、"],["見よ","みよ"],["、"],["生きて","いきて"],["おり"],["、"],["懲らしめられて","こらしめられて"],["いる"],["よう"],["で"],["ある"],["が"],["、"],["殺ろされず","ころされず"],["、"]]},{"verse":10,"text":"悲,かなしんでいるようであるが、常,つねに喜,よろこんでおり、貧,まずしいようであるが、多,おおくの人,ひとを富,とませ、何,なにも持,もたないようであるが、すべての物,ものを持,もっている。","tok":[["悲しんで","かなしんで"],["いる"],["よう"],["で"],["ある"],["が"],["、"],["常","つね"],["に"],["喜こんで","よろこんで"],["おり"],["、"],["貧しい","まずしい"],["よう"],["で"],["ある"],["が"],["、"],["多く","おおく"],["の"],["人","ひと"],["を"],["富ませ","とませ"],["、"],["何に","なに"],["も"],["持たない","もたない"],["よう"],["で"],["ある"],["が"],["、"],["すべて"],["の"],["物","もの"],["を"],["持って","もって"],["いる"],["。"]]},{"verse":11,"text":"コリントの人々,ひとびとよ。あなたがたに向,むかってわたしたちの口,くちは開,ひらかれており、わたしたちの心,こころは広,ひろくなっている。","tok":[["コリント"],["の"],["人々","ひとびと"],["よ"],["。"],["あなた"],["がた"],["に"],["向かって","むかって"],["わたしたち"],["の"],["口","くち"],["は"],["開らかれて","ひらかれて"],["おり"],["、"],["わたしたち"],["の"],["心","こころ"],["は"],["広く","ひろく"],["なって"],["いる"],["。"]]},{"verse":12,"text":"あなたがたは、わたしたちに心,こころをせばめられていたのではなく、自分,じぶんで心,こころをせばめていたのだ。","tok":[["あなた"],["がた"],["は"],["、"],["わたしたち"],["に"],["心","こころ"],["を"],["せばめられて"],["いた"],["ので"],["は"],["なく"],["、"],["自分","じぶん"],["で"],["心","こころ"],["を"],["せばめて"],["いた"],["の"],["だ"],["。"]]},{"verse":13,"text":"わたしは子供,こどもたちに対,たいするように言,いうが、どうかあなたがたの方,ほうでも心,こころを広,ひろくして、わたしに応,おうじてほしい。","tok":[["わたし"],["は"],["子供","こども"],["たち"],["に"],["対する","たいする"],["よう"],["に"],["言う","いう"],["が"],["、"],["どう"],["か"],["あなた"],["がた"],["の"],["方","ほう"],["で"],["も"],["心","こころ"],["を"],["広く","ひろく"],["して"],["、"],["わたし"],["に"],["応じて","おうじて"],["ほしい"],["。"]]},{"verse":14,"text":"不信者,ふしんじゃと、つり合,あわないくびきを共,ともにするな。義,ぎと不義,ふぎとなんの係,かかわりがあるか。光,ひかりとやみとなんの交,まじわりがあるか。","tok":[["不","ふ"],["信者","しんじゃ"],["と"],["、"],["つり合わない","つりあわない"],["くびき"],["を"],["共","とも"],["に"],["する"],["な"],["。"],["義","ぎ"],["と"],["不義","ふぎ"],["と"],["なん"],["の"],["係わり","かかわり"],["が"],["ある"],["か"],["。"],["光","ひかり"],["と"],["やみ"],["と"],["なん"],["の"],["交じわり","まじわり"],["が"],["ある"],["か"],["。"]]},{"verse":15,"text":"キリストとベリアルとなんの調和,ちょうわがあるか。信仰,しんこうと不,ふ信仰,しんこうとなんの関係,かんけいがあるか。","tok":[["キリスト"],["と"],["ベリアル"],["と"],["なん"],["の"],["調和","ちょうわ"],["が"],["ある"],["か"],["。"],["信仰","しんこう"],["と"],["不","ふ"],["信仰","しんこう"],["と"],["なん"],["の"],["関係","かんけい"],["が"],["ある"],["か"],["。"]]},{"verse":16,"text":"神,かみの宮,みやと偶像,ぐうぞうとなんの一致,いっちがあるか。わたしたちは、生,いける神,かみの宮,みやである。神,かみがこう仰,おおせになっている、「わたしは彼,かれらの間,あいだに住,すみ、かつ出入,でいりをするであろう。そして、わたしは彼,かれらの神,かみとなり、彼,かれらはわたしの民,たみとなるであろう」。","tok":[["神","かみ"],["の"],["宮","みや"],["と"],["偶像","ぐうぞう"],["と"],["なん"],["の"],["一致","いっち"],["が"],["ある"],["か"],["。"],["わたしたち"],["は"],["、"],["生ける","いける"],["神","かみ"],["の"],["宮","みや"],["で"],["ある"],["。"],["神","かみ"],["が"],["こう"],["仰せ","おおせ"],["に"],["なって"],["いる"],["、"],["「"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["間","あいだ"],["に"],["住み","すみ"],["、"],["かつ"],["出入","でいり"],["を"],["するで"],["あろう"],["。"],["そして"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["神","かみ"],["と"],["なり"],["、"],["彼","かれ"],["ら"],["は"],["わたし"],["の"],["民","たみ"],["と"],["なるで"],["あろう"],["」"],["。"]]},{"verse":17,"text":"だから、「彼,かれらの間,あいだから出,でて行,いき、彼,かれらと分離,ぶんりせよ、と主,しゅは言,いわれる。そして、汚,けがれたものに触,ふれてはならない。触,ふれなければ、わたしはあなたがたを受,うけいれよう。","tok":[["だ"],["から"],["、"],["「"],["彼","かれ"],["ら"],["の"],["間","あいだ"],["から"],["出て","でて"],["行き","いき"],["、"],["彼","かれ"],["ら"],["と"],["分離","ぶんり"],["せよ"],["、"],["と"],["主","しゅ"],["は"],["言われる","いわれる"],["。"],["そして"],["、"],["汚","けがれたも"],["のに"],["触","ふれ"],["ては"],["ならない"],["。"],["触","ふれ"],["なければ"],["、"],["わたし"],["は"],["あなた"],["がた"],["を"],["受","うけ"],["いれよう"],["。"]]},{"verse":18,"text":"そしてわたしは、あなたがたの父,ちちとなり、あなたがたは、わたしのむすこ、むすめとなるであろう。全能,ぜんのうの主,しゅが、こう言,いわれる」。","tok":[["そして"],["わたし"],["は"],["、"],["あなた"],["がた"],["の"],["父","ちち"],["と"],["なり"],["、"],["あなた"],["がた"],["は"],["、"],["わたし"],["の"],["むすこ"],["、"],["むすめ"],["と"],["なるで"],["あろう"],["。"],["全能","ぜんのう"],["の"],["主","しゅ"],["が"],["、"],["こう"],["言われる","いわれる"],["」"],["。"]]}]
[{"verse":1,"text":"愛,あいする者,ものたちよ。わたしたちは、このような約束,やくそくを与,あたえられているのだから、肉,にくと霊,れいとのいっさいの汚,けがれから自分,じぶんをきよめ、神,かみをおそれて全,まったく清,きよくなろうではないか。","tok":[["愛する","あいする"],["者","もの"],["たち"],["よ"],["。"],["わたしたち"],["は"],["、"],["この"],["よう"],["な"],["約束","やくそく"],["を"],["与えられて","あたえられて"],["いる"],["の"],["だ"],["から"],["、"],["肉","にく"],["と"],["霊","れい"],["と"],["の"],["いっさい"],["の"],["汚","けがれか"],["ら"],["自分","じぶん"],["を"],["きよめ"],["、"],["神","かみ"],["を"],["おそれて"],["全く","まったく"],["清く","きよく"],["なろうで"],["は"],["ない"],["か"],["。"]]},{"verse":2,"text":"どうか、わたしたちに心,こころを開,ひらいてほしい。わたしたちは、だれにも不義,ふぎをしたことがなく、だれをも破滅,はめつにおとしいれたことがなく、だれからもだまし取,とったことがない。","tok":[["どう"],["か"],["、"],["わたしたち"],["に"],["心","こころ"],["を"],["開らいて","ひらいて"],["ほしい"],["。"],["わたしたち"],["は"],["、"],["だれ"],["に"],["も"],["不義","ふぎ"],["を"],["した"],["こと"],["が"],["なく"],["、"],["だれ"],["を"],["も"],["破滅","はめつ"],["に"],["おとしいれた"],["こと"],["が"],["なく"],["、"],["だれ"],["から"],["も"],["だまし取った","だましとった"],["こと"],["が"],["ない"],["。"]]},{"verse":3,"text":"わたしは、責,せめるつもりでこう言,いうのではない。前,まえにも言,いったように、あなたがたはわたしの心,こころのうちにいて、わたしたちと生,せい死,しを共,ともにしているのである。","tok":[["わたし"],["は"],["、"],["責","せめ"],["る"],["つもり"],["で"],["こう"],["言う","いう"],["ので"],["は"],["ない"],["。"],["前","まえ"],["に"],["も"],["言った","いった"],["よう"],["に"],["、"],["あなた"],["がた"],["は"],["わたし"],["の"],["心","こころ"],["の"],["うち"],["に"],["いて"],["、"],["わたしたち"],["と"],["生い","せい"],["死","し"],["を"],["共","とも"],["に"],["して"],["いる"],["ので"],["ある"],["。"]]},{"verse":4,"text":"わたしはあなたがたを大,おおいに信頼,しんらいし、大,おおいに誇,ほこっている。また、あふれるばかり慰,なぐさめを受,うけ、あらゆる患難,かんなんの中,なかにあって喜,よろこびに満,みちあふれている。","tok":[["わたし"],["は"],["あなた"],["がた"],["を"],["大いに","おおいに"],["信頼","しんらい"],["し"],["、"],["大いに","おおいに"],["誇って","ほこって"],["いる"],["。"],["また"],["、"],["あふれる"],["ばかり"],["慰さめ","なぐさめ"],["を"],["受け","うけ"],["、"],["あらゆる"],["患難","かんなん"],["の"],["中","なか"],["に"],["あって"],["喜こび","よろこび"],["に"],["満ちあふれて","みちあふれて"],["いる"],["。"]]},{"verse":5,"text":"さて、マケドニヤに着,ついたとき、わたしたちの身,みに少,すこしの休,やすみもなく、さまざまの患難,かんなんに会,あい、外,そとには戦,たたかい、内,うちには恐,おそれがあった。","tok":[["さて"],["、"],["マケドニヤ"],["に"],["着いた","ついた"],["とき"],["、"],["わたしたち"],["の"],["身","み"],["に"],["少し","すこし"],["の"],["休み","やすみ"],["も"],["なく"],["、"],["さまざま"],["の"],["患難","かんなん"],["に"],["会い","あい"],["、"],["外","そと"],["に"],["は"],["戦い","たたかい"],["、"],["内","うち"],["に"],["は"],["恐","おそれ"],["が"],["あった"],["。"]]},{"verse":6,"text":"しかるに、うちしおれている者,ものを慰,なぐさめる神,かみは、テトスの到来,とうらいによって、わたしたちを慰,なぐさめて下,くださった。","tok":[["しかる"],["に"],["、"],["うちしおれて"],["いる"],["者","もの"],["を"],["慰さめる","なぐさめる"],["神","かみ"],["は"],["、"],["テトス"],["の"],["到来","とうらい"],["によって"],["、"],["わたしたち"],["を"],["慰さめて","なぐさめて"],["下さった","くださった"],["。"]]},{"verse":7,"text":"ただ彼,かれの到来,とうらいによるばかりではなく、彼,かれがあなたがたから受,うけたその慰,なぐさめをもって、慰,なぐさめて下,くださった。すなわち、あなたがたがわたしを慕,したっていること、嘆,なげいていること、またわたしに対,たいして熱心,ねっしんであることを知,しらせてくれたので、わたしの喜,よろこびはいよいよ増,まし加,くわわったのである。","tok":[["ただ"],["彼","かれ"],["の"],["到来","とうらい"],["に"],["よる"],["ばかり"],["で"],["は"],["なく"],["、"],["彼","かれ"],["が"],["あなた"],["がた"],["から"],["受けた","うけた"],["その"],["慰さめ","なぐさめ"],["を"],["もって"],["、"],["慰さめて","なぐさめて"],["下さった","くださった"],["。"],["すなわち"],["、"],["あなた"],["がた"],["が"],["わたし"],["を"],["慕って","したって"],["いる"],["こと"],["、"],["嘆いて","なげいて"],["いる"],["こと"],["、"],["また"],["わたし"],["に対して","にたいして"],["熱心","ねっしん"],["で"],["ある"],["こと"],["を"],["知らせて","しらせて"],["くれた"],["ので"],["、"],["わたし"],["の"],["喜こび","よろこび"],["は"],["いよいよ"],["増し","まし"],["加わわった","くわわった"],["ので"],["ある"],["。"]]},{"verse":8,"text":"そこで、たとい、あの手紙,てがみであなたがたを悲,かなしませたとしても、わたしはそれを悔,くいていない。あの手紙,てがみがしばらくの間,あいだではあるが、あなたがたを悲,かなしませたのを見,みて悔,くいたとしても、","tok":[["そこ"],["で"],["、"],["たとい"],["、"],["あの"],["手紙","てがみ"],["で"],["あなた"],["がた"],["を"],["悲しませた","かなしませた"],["として"],["も"],["、"],["わたし"],["は"],["それ"],["を"],["悔いて","くいて"],["いない"],["。"],["あの"],["手紙","てがみ"],["が"],["しばらく"],["の"],["間","あいだ"],["で"],["は"],["ある"],["が"],["、"],["あなた"],["がた"],["を"],["悲しませた","かなしませた"],["の"],["を"],["見て","みて"],["悔いた","くいた"],["として"],["も"],["、"]]},{"verse":9,"text":"今,いまは喜,よろこんでいる。それは、あなたがたが悲,かなしんだからではなく、悲,かなしんで悔,くい改,あらためるに至,いたったからである。あなたがたがそのように悲,かなしんだのは、神,かみのみこころに添,そうたことであって、わたしたちからはなんの損,そん害,がいも受,うけなかったのである。","tok":[["今","いま"],["は"],["喜こんで","よろこんで"],["いる"],["。"],["それ"],["は"],["、"],["あなた"],["がた"],["が"],["悲しんだ","かなしんだ"],["から"],["で"],["は"],["なく"],["、"],["悲しんで","かなしんで"],["悔い改める","くいあらためる"],["に"],["至った","いたった"],["から"],["で"],["ある"],["。"],["あなた"],["がた"],["が"],["その"],["よう"],["に"],["悲しんだ","かなしんだ"],["の"],["は"],["、"],["神","かみ"],["のみ"],["こころ"],["に"],["添うた","そうた"],["こと"],["で"],["あって"],["、"],["わたしたち"],["から"],["は"],["なん"],["の"],["損害","そんがい"],["も"],["受なかった","うけなかった"],["ので"],["ある"],["。"]]},{"verse":10,"text":"神,かみのみこころに添,そうた悲,かなしみは、悔,くいのない救,すくいを得,えさせる悔改,くいあらために導,みちびき、この世,よの悲,かなしみは死,しをきたらせる。","tok":[["神","かみ"],["のみ"],["こころ"],["に"],["添うた","そうた"],["悲しみ","かなしみ"],["は"],["、"],["悔い","くい"],["の"],["ない"],["救い","すくい"],["を"],["得させる","えさせる"],["悔改め","くいあらため"],["に"],["導き","みちびき"],["、"],["この世","このよ"],["の"],["悲しみ","かなしみ"],["は"],["死","し"],["を"],["きたらせる"],["。"]]},{"verse":11,"text":"見,みよ、神,かみのみこころに添,そうたその悲,かなしみが、どんなにか熱,ねつ情,じょうをあなたがたに起,おこさせたことか。また、弁明,べんめい、義憤,ぎふん、恐,おそれ、愛慕,あいぼ、熱意,ねつい、それから処罰,しょばつに至,いたらせたことか。あなたがたはあの問題,もんだいについては、すべての点,てんにおいて潔白,けっぱくであることを証明,しょうめいしたのである。","tok":[["見よ","みよ"],["、"],["神","かみ"],["のみ"],["こころ"],["に"],["添うた","そうた"],["その"],["悲しみ","かなしみ"],["が"],["、"],["どんな"],["に"],["か"],["熱情","ねつじょう"],["を"],["あなた"],["がた"],["に"],["起こさせた","おこさせた"],["こと"],["か"],["。"],["また"],["、"],["弁明","べんめい"],["、"],["義憤","ぎふん"],["、"],["恐","おそれ"],["、"],["愛慕","あいぼ"],["、"],["熱意","ねつい"],["、"],["それ"],["から"],["処罰","しょばつ"],["に"],["至らせた","いたらせた"],["こと"],["か"],["。"],["あなた"],["がた"],["は"],["あの"],["問題","もんだい"],["について"],["は"],["、"],["すべて"],["の"],["点","てん"],["に"],["おいて"],["潔白","けっぱく"],["で"],["ある"],["こと"],["を"],["証明","しょうめい"],["した"],["ので"],["ある"],["。"]]},{"verse":12,"text":"だから、わたしがあなたがたに書,かきおくったのは、不義,ふぎをした人,ひとのためでも、不義,ふぎを受,うけた人,ひとのためでもなく、わたしたちに対,たいするあなたがたの熱,ねつ情,じょうが、神,かみの前,まえにあなたがたの間,あいだで明,あきらかになるためである。","tok":[["だ"],["から"],["、"],["わたし"],["が"],["あなた"],["がた"],["に"],["書きおくった","かきおくった"],["の"],["は"],["、"],["不義","ふぎ"],["を"],["した"],["人","ひと"],["の"],["ため"],["で"],["も"],["、"],["不義","ふぎ"],["を"],["受た","うけた"],["人","ひと"],["の"],["ため"],["で"],["も"],["なく"],["、"],["わたしたち"],["に"],["対する","たいする"],["あなた"],["がた"],["の"],["熱情","ねつじょう"],["が"],["、"],["神","かみ"],["の"],["前","まえ"],["に"],["あなた"],["がた"],["の"],["間","あいだ"],["で"],["明か","あきらか"],["に"],["なる"],["ため"],["で"],["ある"],["。"]]},{"verse":13,"text":"こういうわけで、わたしたちは慰,なぐさめられたのである。これらの慰,なぐさめの上,うえにテトスの喜,よろこびが加,くわわって、わたしたちはなおいっそう喜,よろこんだ。彼,かれがあなたがた一同,いちどうによって安心,あんしんさせられたからである。","tok":[["こう"],["いう"],["わけ"],["で"],["、"],["わたしたち"],["は"],["慰さめられた","なぐさめられた"],["ので"],["ある"],["。"],["これ"],["ら"],["の"],["慰さめ","なぐさめ"],["の"],["上","うえ"],["に"],["テトス"],["の"],["喜こび","よろこび"],["が"],["加わわって","くわわって"],["、"],["わたしたち"],["は"],["なお"],["いっそう"],["喜こんだ","よろこんだ"],["。"],["彼","かれ"],["が"],["あなた"],["がた"],["一同","いちどう"],["によって"],["安心","あんしん"],["させられた"],["から"],["で"],["ある"],["。"]]},{"verse":14,"text":"そして、わたしは彼,かれに対,たいしてあなたがたのことを少,すこしく誇,ほこったが、それはわたしの恥,はじにならないですんだ。あなたがたにいっさいのことを真実,しんじつに語,かたったように、テトスに対,たいして誇,ほこったことも真実,しんじつとなってきたのである。","tok":[["そして"],["、"],["わたし"],["は"],["彼","かれ"],["に対して","にたいして"],["あなた"],["がた"],["の"],["こと"],["を"],["少しく","すこしく"],["誇った","ほこった"],["が"],["、"],["それ"],["は"],["わたし"],["の"],["恥","はじ"],["に"],["ならないです"],["ん"],["だ"],["。"],["あなた"],["がた"],["に"],["いっさい"],["の"],["こと"],["を"],["真実","しんじつ"],["に"],["語った","かたった"],["よう"],["に"],["、"],["テトス"],["に対して","にたいして"],["誇った","ほこった"],["こと"],["も"],["真実","しんじつ"],["と"],["なって"],["きた"],["ので"],["ある"],["。"]]},{"verse":15,"text":"また彼,かれは、あなたがた一同,いちどうが従順,じゅうじゅんであって、おそれおののきつつ自分,じぶんを迎,むかえてくれたことを思,おもい出,だして、ますます心,こころをあなたがたの方,ほうに寄,よせている。","tok":[["また"],["彼","かれ"],["は"],["、"],["あなた"],["がた"],["一同","いちどう"],["が"],["従順","じゅうじゅん"],["で"],["あって"],["、"],["おそれおののき"],["つつ"],["自分","じぶん"],["を"],["迎","むかえ"],["て"],["くれた"],["こと"],["を"],["思い出して","おもいだして"],["、"],["ますます"],["心","こころ"],["を"],["あなた"],["がた"],["の"],["方","ほう"],["に"],["寄せて","よせて"],["いる"],["。"]]},{"verse":16,"text":"わたしは、あなたがたに全,まったく信頼,しんらいすることができて、喜,よろこんでいる。","tok":[["わたし"],["は"],["、"],["あなた"],["がた"],["に"],["全く","まったく"],["信頼","しんらい"],["する"],["こと"],["が"],["できて"],["、"],["喜こんで","よろこんで"],["いる"],["。"]]}]
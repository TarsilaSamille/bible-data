[{"verse":1,"text":"わたしが少,すこしばかり愚,おろかなことを言,いうのを、どうか、忍,しのんでほしい。もちろん忍,しのんでくれるのだ。","tok":[["わたし"],["が"],["少し","すこし"],["ばかり"],["愚か","おろか"],["な"],["こと"],["を"],["言う","いう"],["の"],["を"],["、"],["どう"],["か"],["、"],["忍","し"],["の"],["んで"],["ほしい"],["。"],["もちろん"],["忍んで","しのんで"],["くれる"],["の"],["だ"],["。"]]},{"verse":2,"text":"わたしは神,かみの熱,ねつ情,じょうをもって、あなたがたを熱愛,ねつあいしている。あなたがたを、きよいおとめとして、ただひとりの男子,だんしキリストにささげるために、婚約,こんやくさせたのである。","tok":[["わたし"],["は"],["神","かみ"],["の"],["熱情","ねつじょう"],["を"],["もって"],["、"],["あなた"],["がた"],["を"],["熱愛","ねつあい"],["して"],["いる"],["。"],["あなた"],["がた"],["を"],["、"],["きよい"],["おとめ"],["として"],["、"],["ただ"],["ひとり"],["の"],["男子","だんし"],["キリスト"],["に"],["ささげる"],["ため"],["に"],["、"],["婚約","こんやく"],["させた"],["ので"],["ある"],["。"]]},{"verse":3,"text":"ただ恐,おそれるのは、エバがへびの悪巧,わるだくみで誘惑,ゆうわくされたように、あなたがたの思,おもいが汚,けがされて、キリストに対,たいする純情,じゅんじょうと貞操,ていそうとを失,うしないはしないかということである。","tok":[["ただ"],["恐れる","おそれる"],["の"],["は"],["、"],["エバ"],["が"],["へび"],["の"],["悪巧み","わるだくみ"],["で"],["誘惑","ゆうわく"],["された"],["よう"],["に"],["、"],["あなた"],["がた"],["の"],["思い","おもい"],["が"],["汚","け"],["が"],["されて"],["、"],["キリスト"],["に"],["対する","たいする"],["純情","じゅんじょう"],["と"],["貞操","ていそう"],["と"],["を"],["失ない","うしない"],["は"],["しない"],["か"],["と"],["いう"],["こと"],["で"],["ある"],["。"]]},{"verse":4,"text":"というのは、もしある人,ひとがきて、わたしたちが宣,のべ伝,つたえもしなかったような異,ことなるイエスを宣,のべ伝,つたえ、あるいは、あなたがたが受,うけたことのない違,ちがった霊,れいを受,うけ、あるいは、受,うけいれたことのない違,ちがった福音,ふくいんを聞,きく場合,ばあいに、あなたがたはよくもそれを忍,しのんでいる。","tok":[["と"],["いう"],["の"],["は"],["、"],["もし"],["ある"],["人","ひと"],["が"],["きて"],["、"],["わたしたち"],["が"],["宣べ伝え","のべつたえ"],["も"],["しなかった"],["よう"],["な"],["異なる","ことなる"],["イエス"],["を"],["宣べ伝え","のべつたえ"],["、"],["あるいは"],["、"],["あなた"],["がた"],["が"],["受た","うけた"],["こと"],["の"],["ない"],["違った","ちがった"],["霊","れい"],["を"],["受け","うけ"],["、"],["あるいは"],["、"],["受","うけ"],["いれた"],["こと"],["の"],["ない"],["違った","ちがった"],["福音","ふくいん"],["を"],["聞く","きく"],["場合","ばあい"],["に"],["、"],["あなた"],["がた"],["は"],["よく"],["も"],["それ"],["を"],["忍んで","しのんで"],["いる"],["。"]]},{"verse":5,"text":"事実,じじつ、わたしは、あの大使徒,だいしとたちにいささかも劣,おとってはいないと思,おもう。","tok":[["事実","じじつ"],["、"],["わたし"],["は"],["、"],["あの"],["大使","たいし"],["徒","と"],["に"],["いささか"],["も"],["劣って","おとって"],["は"],["いない"],["と"],["思う","おもう"],["。"]]},{"verse":6,"text":"たとい弁舌,べんぜつはつたなくても、知識,ちしきはそうでない。わたしは、事,ことごとに、いろいろの場合,ばあいに、あなたがたに対,たいしてそれを明,あきらかにした。","tok":[["たとい"],["弁舌","べんぜつ"],["は"],["つたなくて"],["も"],["、"],["知識","ちしき"],["は"],["そう"],["で"],["ない"],["。"],["わたし"],["は"],["、"],["事","こと"],["ごと"],["に"],["、"],["いろいろ"],["の"],["場合","ばあい"],["に"],["、"],["あなた"],["がた"],["に対して","にたいして"],["それ"],["を"],["明か","あきらか"],["に"],["した"],["。"]]},{"verse":7,"text":"それとも、あなたがたを高,たかめるために自分,じぶんを低,ひくくして、神,かみの福音,ふくいんを価,あたいなしにあなたがたに宣,のべ伝,つたえたことが、罪,つみになるのだろうか。","tok":[["それ"],["と"],["も"],["、"],["あなた"],["がた"],["を"],["高める","たかめる"],["ため"],["に"],["自分","じぶん"],["を"],["低く","ひくく"],["して"],["、"],["神","かみ"],["の"],["福音","ふくいん"],["を"],["価","あたい"],["なし"],["に"],["あなた"],["がた"],["に"],["宣べ伝えた","のべつたえた"],["こと"],["が"],["、"],["罪","つみ"],["に"],["なる"],["の"],["だろう"],["か"],["。"]]},{"verse":8,"text":"わたしは他,たの諸,しょ教会,きょうかいをかすめたと言,いわれながら得,えた金,かねで、あなたがたに奉仕,ほうしし、","tok":[["わたし"],["は"],["他","た"],["の"],["諸教","しょ教"],["会","かい"],["を"],["かすめた"],["と"],["言われ","いわれ"],["ながら"],["得た","えた"],["金","かね"],["で"],["、"],["あなた"],["がた"],["に"],["奉仕","ほうし"],["し"],["、"]]},{"verse":9,"text":"あなたがたの所,ところにいて貧乏,びんぼうをした時,ときにも、だれにも負担,ふたんをかけたことはなかった。わたしの欠乏,けつぼうは、マケドニヤからきた兄弟,きょうだいたちが、補,おぎなってくれた。こうして、わたしはすべての事,ことにつき、あなたがたに重荷,おもにを負,おわせまいと努,つとめてきたし、今後,こんごも努,つとめよう。","tok":[["あなた"],["がた"],["の"],["所","ところ"],["に"],["いて"],["貧乏","びんぼう"],["を"],["した"],["時","とき"],["に"],["も"],["、"],["だれ"],["に"],["も"],["負担","ふたん"],["を"],["かけた"],["こと"],["は"],["なかった"],["。"],["わたし"],["の"],["欠乏","けつぼう"],["は"],["、"],["マケドニヤ"],["から"],["きた"],["兄弟","きょうだい"],["たち"],["が"],["、"],["補なって","おぎなって"],["くれた"],["。"],["こう"],["して"],["、"],["わたし"],["は"],["すべて"],["の"],["事","こと"],["に"],["つき"],["、"],["あなた"],["がた"],["に"],["重荷","おもに"],["を"],["負わせまい","おわせまい"],["と"],["努めて","つとめて"],["きた"],["し"],["、"],["今後","こんご"],["も"],["努めよう","つとめよう"],["。"]]},{"verse":10,"text":"わたしの内,うちにあるキリストの真実,しんじつにかけて言,いう、この誇,ほこりがアカヤ地方,ちほうで封,ふうじられるようなことは、決,けっしてない。","tok":[["わたし"],["の"],["内","うち"],["に"],["ある"],["キリスト"],["の"],["真実","しんじつ"],["に"],["かけて"],["言う","いう"],["、"],["この"],["誇","ほこり"],["が"],["アカヤ"],["地方","ちほう"],["で"],["封じられる","ふうじられる"],["よう"],["な"],["こと"],["は"],["、"],["決っして","けっして"],["ない"],["。"]]},{"verse":11,"text":"なぜであるか。わたしがあなたがたを愛,あいしていないからか。それは、神,かみがご存,ぞんじである。","tok":[["なぜ"],["で"],["ある"],["か"],["。"],["わたし"],["が"],["あなた"],["がた"],["を"],["愛して","あいして"],["いない"],["から"],["か"],["。"],["それ"],["は"],["、"],["神","かみ"],["が"],["ご存じ","ごぞんじ"],["で"],["ある"],["。"]]},{"verse":12,"text":"しかし、わたしは、現在,げんざいしていることを今後,こんごもしていこう。それは、わたしたちと同,おなじように誇,ほこりうる立,たち場,ばを得,えようと機会,きかいをねらっている者,ものどもから、その機会,きかいを断,たち切,きってしまうためである。","tok":[["しかし"],["、"],["わたし"],["は"],["、"],["現在","げんざい"],["して"],["いる"],["こと"],["を"],["今後","こんご"],["も"],["して"],["いこう"],["。"],["それ"],["は"],["、"],["わたしたち"],["と"],["同じ","おなじ"],["よう"],["に"],["誇","ほこり"],["うる"],["立ち","たち"],["場","ば"],["を"],["得よう","えよう"],["と"],["機会","きかい"],["を"],["ねらって"],["いる"],["者","もの"],["ども"],["から"],["、"],["その"],["機会","きかい"],["を"],["断ち切って","たちきって"],["しまう"],["ため"],["で"],["ある"],["。"]]},{"verse":13,"text":"こういう人々,ひとびとはにせ使徒,しと、人,ひとをだます働,はたらき人,びとであって、キリストの使徒,しとに擬装,ぎそうしているにすぎないからである。","tok":[["こう"],["いう"],["人々","ひとびと"],["は"],["にせ"],["使徒","しと"],["、"],["人","ひと"],["を"],["だます"],["働らき人","はたらきび"],["と"],["であって"],["、"],["キリスト"],["の"],["使徒","しと"],["に"],["擬装","ぎそう"],["して"],["いる"],["に"],["すぎない"],["から"],["で"],["ある"],["。"]]},{"verse":14,"text":"しかし、驚,おどろくには及,およばない。サタンも光,ひかりの天使,てんしに擬装,ぎそうするのだから。","tok":[["しかし"],["、"],["驚ろく","おどろく"],["に"],["は"],["及ばない","およばない"],["。"],["サタン"],["も"],["光","ひかり"],["の"],["天使","てんし"],["に"],["擬装","ぎそう"],["する"],["の"],["だ"],["から"],["。"]]},{"verse":15,"text":"だから、たといサタンの手,て下,したどもが、義,ぎの奉仕者,ほうししゃのように擬装,ぎそうしたとしても、不思議,ふしぎではない。彼,かれらの最期,さいごは、そのしわざに合,あったものとなろう。","tok":[["だ"],["から"],["、"],["たとい"],["サタン"],["の"],["手下","てした"],["ども"],["が"],["、"],["義","ぎ"],["の"],["奉仕者","ほうししゃ"],["の"],["よう"],["に"],["擬装","ぎそう"],["した"],["として"],["も"],["、"],["不思議","ふしぎ"],["で"],["は"],["ない"],["。"],["彼","かれ"],["ら"],["の"],["最期","さいご"],["は"],["、"],["その"],["しわざ"],["に"],["合った","あった"],["もの"],["と"],["なろう"],["。"]]},{"verse":16,"text":"繰,くり返,かえして言,いうが、だれも、わたしを愚,おろか者,ものと思,おもわないでほしい。もしそう思,おもうなら、愚,おろか者,ものあつかいにされてもよいから、わたしにも、少,すこし誇,ほこらせてほしい。","tok":[["繰り","くり"],["返","かえし"],["て"],["言う","いう"],["が"],["、"],["だれ"],["も"],["、"],["わたし"],["を"],["愚か者","おろかもの"],["と"],["思わないで","おもわないで"],["ほしい"],["。"],["もし"],["そう"],["思うなら","おもうなら"],["、"],["愚か者","おろかもの"],["あつかい"],["に"],["されて"],["も"],["よい"],["から"],["、"],["わたし"],["に"],["も"],["、"],["少し","すこし"],["誇らせて","ほこらせて"],["ほしい"],["。"]]},{"verse":17,"text":"いま言,いうことは、主,しゅによって言,いうのではなく、愚,おろか者,もののように、自分,じぶんの誇,ほこりとするところを信,しんじきって言,いうのである。","tok":[["いま"],["言う","いう"],["こと"],["は"],["、"],["主に","しゅに"],["よ"],["って"],["言う","いう"],["ので"],["は"],["なく"],["、"],["愚か者","おろかもの"],["の"],["よう"],["に"],["、"],["自分","じぶん"],["の"],["誇","ほこり"],["と"],["する"],["ところ"],["を"],["信じ","しんじ"],["きって"],["言う","いう"],["ので"],["ある"],["。"]]},{"verse":18,"text":"多,おおくの人,ひとが肉,にくによって誇,ほこっているから、わたしも誇,ほころう。","tok":[["多く","おおく"],["の"],["人","ひと"],["が"],["肉","にく"],["によって"],["誇って","ほこって"],["いる"],["から"],["、"],["わたし"],["も"],["誇ろう","ほころう"],["。"]]},{"verse":19,"text":"あなたがたは賢,かしこい人,ひとたちなのだから、喜,よろこんで愚,おろか者,ものを忍,しのんでくれるだろう。","tok":[["あなた"],["がた"],["は"],["賢しこい","かしこい"],["人","ひと"],["たち"],["な"],["の"],["だ"],["から"],["、"],["喜こんで","よろこんで"],["愚か者","おろかもの"],["を"],["忍んで","しのんで"],["くれるだろう"],["。"]]},{"verse":20,"text":"実際,じっさい、あなたがたは奴隷,どれいにされても、食,くい倒,たおされても、略奪,りゃくだつされても、いばられても、顔,かおをたたかれても、それを忍,しのんでいる。","tok":[["実際","じっさい"],["、"],["あなた"],["がた"],["は"],["奴隷","どれい"],["に"],["されて"],["も"],["、"],["食い倒されて","くいたおされて"],["も"],["、"],["略奪","りゃくだつ"],["されて"],["も"],["、"],["いばられて"],["も"],["、"],["顔","かお"],["を"],["たたかれて"],["も"],["、"],["それ"],["を"],["忍んで","しのんで"],["いる"],["。"]]},{"verse":21,"text":"言,いうのも恥,はずかしいことだが、わたしたちは弱,よわすぎたのだ。もしある人,ひとがあえて誇,ほこるなら、わたしは愚,おろか者,ものになって言,いうが、わたしもあえて誇,ほころう。","tok":[["言う","いう"],["の"],["も"],["恥ずかしい","はずかしい"],["こと"],["だ"],["が"],["、"],["わたしたち"],["は"],["弱","よわ"],["すぎた"],["の"],["だ"],["。"],["もし"],["ある"],["人","ひと"],["が"],["あえて"],["誇るなら","ほこるなら"],["、"],["わたし"],["は"],["愚か者","おろかもの"],["に"],["なって"],["言う","いう"],["が"],["、"],["わたし"],["も"],["あえて"],["誇ろう","ほころう"],["。"]]},{"verse":22,"text":"彼,かれらはヘブル人,びとなのか。わたしもそうである。彼,かれらはイスラエル人,びとなのか。わたしもそうである。彼,かれらはアブラハムの子孫,しそんなのか。わたしもそうである。","tok":[["彼","かれ"],["ら"],["は"],["ヘブル人","へぶるびとな"],["の"],["か"],["。"],["わたし"],["も"],["そう"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["イスラエル"],["人","びとな"],["の"],["か"],["。"],["わたし"],["も"],["そう"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["アブラハム"],["の"],["子孫","しそん"],["な"],["の"],["か"],["。"],["わたし"],["も"],["そう"],["で"],["ある"],["。"]]},{"verse":23,"text":"彼,かれらはキリストの僕,しもべなのか。わたしは気,きが狂,くるったようになって言,いう、わたしは彼,かれら以上,いじょうにそうである。苦労,くろうしたことはもっと多,おおく、投獄,とうごくされたことももっと多,おおく、むち打,うたれたことは、はるかにおびただしく、死,しに面,めんしたこともしばしばあった。","tok":[["彼","かれ"],["ら"],["は"],["キリスト"],["の"],["僕","し"],["も"],["べ"],["な"],["の"],["か"],["。"],["わたし"],["は"],["気","き"],["が"],["狂った","くるった"],["よう"],["に"],["なって"],["言う","いう"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["以上","いじょう"],["に"],["そう"],["で"],["ある"],["。"],["苦労","くろう"],["した"],["こと"],["は"],["もっと"],["多く","おおく"],["、"],["投獄","とうごく"],["された"],["こと"],["も"],["もっと"],["多く","おおく"],["、"],["むち打たれた","むちうたれた"],["こと"],["は"],["、"],["はるか"],["に"],["おびただしく"],["、"],["死","し"],["に"],["面した","めんした"],["こと"],["も"],["しばしば"],["あった"],["。"]]},{"verse":24,"text":"ユダヤ人,じんから四十に一つ足,たりないむちを受,うけたことが五度,ど、","tok":[["ユダヤ人","ゆだやじん"],["から"],["四十","よんじゅう"],["に"],["一","ひと"],["つ"],["足りない","たりない"],["むち"],["を"],["受た","うけた"],["こと"],["が"],["五","ご"],["度","ど"],["、"]]},{"verse":25,"text":"ローマ人,じんにむちで打,うたれたことが三度,ど、石,いしで打,うたれたことが一度,いちど、難船,なんせんしたことが三度,ど、そして、一昼夜,いっちゅうや、海,うみの上,うえを漂,ただよったこともある。","tok":[["ローマ人","ろーまじん"],["に"],["むち"],["で"],["打たれた","うたれた"],["こと"],["が"],["三","さん"],["度","ど"],["、"],["石","いし"],["で"],["打たれた","うたれた"],["こと"],["が"],["一度","いちど"],["、"],["難船","なんせん"],["した"],["こと"],["が"],["三","さん"],["度","ど"],["、"],["そして"],["、"],["一昼夜","いっちゅうや"],["、"],["海","うみ"],["の"],["上","うえ"],["を"],["漂よった","ただよった"],["こと"],["も"],["ある"],["。"]]},{"verse":26,"text":"幾,いくたびも旅,たびをし、川,かわの難,なん、盗賊,とうぞくの難,なん、同国民,どうこくみんの難,なん、異邦人,いほうじんの難,なん、都会,とかいの難,なん、荒野,あらのの難,なん、海上,かいじょうの難,なん、にせ兄弟,きょうだいの難,なんに会,あい、","tok":[["幾","いく"],["たび"],["も"],["旅","たび"],["を"],["し"],["、"],["川","かわ"],["の"],["難","なん"],["、"],["盗賊","とうぞく"],["の"],["難","なん"],["、"],["同","どう"],["国民","こくみん"],["の"],["難","なん"],["、"],["異邦人","いほうじん"],["の"],["難","なん"],["、"],["都会","とかい"],["の"],["難","なん"],["、"],["荒野","あら"],["の"],["の"],["難","なん"],["、"],["海上","かいじょう"],["の"],["難","なん"],["、"],["にせ"],["兄弟","きょうだい"],["の"],["難","なん"],["に"],["会い","あい"],["、"]]},{"verse":27,"text":"労,ろうし苦,くるしみ、たびたび眠,ねむられぬ夜,よるを過,すごし、飢,うえかわき、しばしば食物,しょくもつがなく、寒,さむさに凍,こごえ、裸,はだかでいたこともあった。","tok":[["労し","ろうし"],["苦しみ","くるしみ"],["、"],["たびたび"],["眠られぬ","ねむられぬ"],["夜","よる"],["を"],["過ごし","すごし"],["、"],["飢","うえ"],["かわき"],["、"],["しばしば"],["食物","しょくもつ"],["が"],["なく"],["、"],["寒さ","さむさ"],["に"],["凍え","こごえ"],["、"],["裸","はだか"],["で"],["いた"],["こと"],["も"],["あった"],["。"]]},{"verse":28,"text":"なおいろいろの事,ことがあった外,ほかに、日々,ひびわたしに迫,せまって来,くる諸,しょ教会,きょうかいの心配,しんぱいごとがある。","tok":[["なお"],["いろいろ"],["の"],["事","こと"],["が"],["あった"],["外","ほか"],["に"],["、"],["日々","ひび"],["わたし"],["に"],["迫まって","せまって"],["来る","くる"],["諸教","しょ教"],["会","かい"],["の"],["心配","しんぱい"],["ごと"],["が"],["ある"],["。"]]},{"verse":29,"text":"だれかが弱,よわっているのに、わたしも弱,よわらないでおれようか。だれかが罪,つみを犯,おかしているのに、わたしの心,こころが燃,もえないでおれようか。","tok":[["だれ"],["か"],["が"],["弱って","よわって"],["いる"],["のに"],["、"],["わたし"],["も"],["弱らないで","よわらないで"],["おれよう"],["か"],["。"],["だれ"],["か"],["が"],["罪","つみ"],["を"],["犯して","おかして"],["いる"],["のに"],["、"],["わたし"],["の"],["心","こころ"],["が"],["燃えないで","もえないで"],["おれよう"],["か"],["。"]]},{"verse":30,"text":"もし誇,ほこらねばならないのなら、わたしは自分,じぶんの弱,よわさを誇,ほころう。","tok":[["もし"],["誇らねば","ほこらねば"],["ならない"],["の"],["なら"],["、"],["わたし"],["は"],["自分","じぶん"],["の"],["弱","よわ"],["さ"],["を"],["誇ろう","ほころう"],["。"]]},{"verse":31,"text":"永遠,えいえんにほむべき、主,しゅイエス・キリストの父,ちちなる神,かみは、わたしが偽,いつわりを言,いっていないことを、ご存,ぞんじである。","tok":[["永遠","えいえん"],["に"],["ほ"],["むべき"],["、"],["主","しゅ"],["イエス"],["・"],["キリスト"],["の"],["父","ちち"],["なる"],["神","かみ"],["は"],["、"],["わたし"],["が"],["偽り","いつわり"],["を"],["言って","いって"],["いない"],["こと"],["を"],["、"],["ご存じ","ごぞんじ"],["で"],["ある"],["。"]]},{"verse":32,"text":"ダマスコでアレタ王,おうの代,だい官,かんが、わたしを捕,とらえるためにダマスコ人,びとの町,まちを監視,かんししたことがあったが、","tok":[["ダマスコ"],["で"],["アレタ"],["王","おう"],["の"],["代官","だいかん"],["が"],["、"],["わたし"],["を"],["捕らえる","とらえる"],["ため"],["に"],["ダマスコ"],["人","びと"],["の"],["町","まち"],["を"],["監視","かんし"],["した"],["こと"],["が"],["あった"],["が"],["、"]]},{"verse":33,"text":"その時,ときわたしは窓,まどから町,まちの城壁,じょうへきづたいに、かごでつり降,おろされて、彼,かれの手,てからのがれた。","tok":[["その"],["時","とき"],["わたし"],["は"],["窓","まど"],["から"],["町","まち"],["の"],["城壁","じょうへき"],["づたい"],["に"],["、"],["かご"],["で"],["つり"],["降ろされて","おろされて"],["、"],["彼","かれ"],["の"],["手","て"],["から"],["のがれた"],["。"]]}]
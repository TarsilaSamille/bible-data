[{"verse":1,"text":"バビロンの王,おうベルシャザルの元年,がんねんに、ダニエルは床,とこにあって夢,ゆめを見,み、また脳,のう中,ちゅうに幻,まぼろしを得,えたので、彼,かれはその夢,ゆめをしるして、その事,ことの大意,たいいを述,のべた。","tok":[["バビロン"],["の"],["王","おう"],["ベルシャザル"],["の"],["元年","がんねん"],["に"],["、"],["ダニエル"],["は"],["床","とこ"],["に"],["あって"],["夢","ゆめ"],["を"],["見","み"],["、"],["また"],["脳中","のうちゅう"],["に"],["幻","まぼろし"],["を"],["得た","えた"],["ので"],["、"],["彼","かれ"],["は"],["その"],["夢","ゆめ"],["を"],["しるして"],["、"],["その"],["事","こと"],["の"],["大意","たいい"],["を"],["述べた","のべた"],["。"]]},{"verse":2,"text":"ダニエルは述,のべて言,いった、「わたしは夜,よるの幻,まぼろしのうちに見,みた。見,みよ、天,てんの四方,しほうからの風,かぜが大海,おおうみをかきたてると、","tok":[["ダニエル"],["は"],["述べて","のべて"],["言った","いった"],["、"],["「"],["わたし"],["は"],["夜","よる"],["の"],["幻","まぼろし"],["の"],["うち"],["に"],["見た","みた"],["。"],["見よ","みよ"],["、"],["天","てん"],["の"],["四方","しほう"],["から"],["の"],["風","かぜ"],["が"],["大海","おおうみ"],["を"],["かきたてる"],["と"],["、"]]},{"verse":3,"text":"四つの大,おおきな獣,けものが海,うみからあがってきた。その形,かたちは、おのおの異,ことなり、","tok":[["四","よん"],["つ"],["の"],["大きな","おおきな"],["獣","けもの"],["が"],["海","うみ"],["から"],["あがって"],["きた"],["。"],["その"],["形","かたち"],["は"],["、"],["おのおの"],["異なり","ことなり"],["、"]]},{"verse":4,"text":"第,だい一のものは、ししのようで、わしの翼,つばさをもっていたが、わたしが見,みていると、その翼,つばさは抜,ぬきとられ、また地,ちから起,おこされて、人,ひとのように二本,ほんの足,あしで立,たたせられ、かつ人,ひとの心,こころが与,あたえられた。","tok":[["第","だい"],["一","いち"],["の"],["もの"],["は"],["、"],["しし"],["の"],["よう"],["で"],["、"],["わし"],["の"],["翼","つばさ"],["を"],["もって"],["いた"],["が"],["、"],["わたし"],["が"],["見て","みて"],["いる"],["と"],["、"],["その"],["翼","つばさ"],["は"],["抜きとられ","ぬきとられ"],["、"],["また"],["地","ち"],["から"],["起こされて","おこされて"],["、"],["人","ひと"],["の"],["よう"],["に"],["二本","ほん"],["の"],["足","あし"],["で"],["立たせられ","たたせられ"],["、"],["かつ"],["人","ひと"],["の"],["心","こころ"],["が"],["与えられた","あたえられた"],["。"]]},{"verse":5,"text":"見,みよ、第,だい二の獣,けものは熊,くまのようであった。これはそのからだの一方,いっぽうをあげ、その口,くちの歯,はの間,あいだに、三本,ぼんの肋骨,ろっこつをくわえていたが、これに向,むかって『起,おきあがって、多,おおくの肉,にくを食,くらえ』と言,いう声,こえがあった。","tok":[["見よ","みよ"],["、"],["第","だい"],["二","に"],["の"],["獣","けもの"],["は"],["熊","くま"],["の"],["よう"],["で"],["あった"],["。"],["これ"],["は"],["その"],["からだ"],["の"],["一方","いっぽう"],["を"],["あげ"],["、"],["その"],["口","くち"],["の"],["歯","は"],["の"],["間","あいだ"],["に"],["、"],["三本","ぼん"],["の"],["肋骨","ろっこつ"],["を"],["くわえて"],["いた"],["が"],["、"],["これ"],["に"],["向かって","むかって"],["『"],["起きあがって","おきあがって"],["、"],["多く","おおく"],["の"],["肉","にく"],["を"],["食らえ","くらえ"],["』"],["と"],["言う","いう"],["声","こえ"],["が"],["あった"],["。"]]},{"verse":6,"text":"その後,のちわたしが見,みたのは、ひょうのような獣,けもので、その背,せには鳥,とりの翼,つばさが四つあった。またこの獣,けものには四つの頭,あたまがあり、主権,しゅけんが与,あたえられた。","tok":[["その後","そのの"],["ちわた"],["し"],["が"],["見た","みた"],["の"],["は"],["、"],["ひょう"],["の"],["よう"],["な"],["獣","けもの"],["で"],["、"],["その"],["背","せ"],["に"],["は"],["鳥","とり"],["の"],["翼","つばさ"],["が"],["四","よん"],["つ"],["あった"],["。"],["また"],["この"],["獣","けもの"],["に"],["は"],["四","よん"],["つ"],["の"],["頭","あたま"],["が"],["あり"],["、"],["主権","しゅけん"],["が"],["与えられた","あたえられた"],["。"]]},{"verse":7,"text":"その後,のちわたしが夜,よるの幻,まぼろしのうちに見,みた第,だい四の獣,けものは、恐,おそろしい、ものすごい、非常,ひじょうに強,つよいもので、大,おおきな鉄,てつの歯,はがあり、食,くらい、かつ、かみ砕,くだいて、その残,のこりを足,あしで踏,ふみつけた。これは、その前,まえに出,でたすべての獣,けものと違,ちがって、十の角,つのを持,もっていた。","tok":[["その後","そのの"],["ちわた"],["し"],["が"],["夜","よる"],["の"],["幻","まぼろし"],["の"],["うち"],["に"],["見た","みた"],["第","だい"],["四","よん"],["の"],["獣","けもの"],["は"],["、"],["恐ろしい","おそろしい"],["、"],["ものすごい"],["、"],["非常","ひじょう"],["に"],["強い","つよい"],["もの"],["で"],["、"],["大きな","おおきな"],["鉄","てつ"],["の"],["歯","は"],["が"],["あり"],["、"],["食らい","くらい"],["、"],["かつ"],["、"],["かみ砕いて","かみくだいて"],["、"],["その"],["残り","のこり"],["を"],["足","あし"],["で"],["踏みつけた","ふみつけた"],["。"],["これ"],["は"],["、"],["その"],["前","まえ"],["に"],["出た","でた"],["すべて"],["の"],["獣","けもの"],["と"],["違って","ちがって"],["、"],["十","じゅう"],["の"],["角","つ"],["の"],["を"],["持って","もって"],["いた"],["。"]]},{"verse":8,"text":"わたしが、その角,つのを注意,ちゅういして見,みていると、その中,なかに、また一つの小,ちいさい角,つのが出,でてきたが、この小,ちいさい角,つののために、さきの角,つののうち三つがその根,ねから抜,ぬけ落,おちた。見,みよ、この小,ちいさい角,つのには、人,ひとの目,めのような目,めがあり、また大,おおきな事,ことを語,かたる口,くちがあった。","tok":[["わたし"],["が"],["、"],["その"],["角","つ"],["の"],["を"],["注意","ちゅうい"],["して"],["見て","みて"],["いる"],["と"],["、"],["その"],["中","なか"],["に"],["、"],["また"],["一","ひと"],["つ"],["の"],["小さい","ちいさい"],["角","つ"],["の"],["が"],["出て","でて"],["きた"],["が"],["、"],["この"],["小さい","ちいさい"],["角","つ"],["の"],["の"],["ため"],["に"],["、"],["さき"],["の"],["角","つ"],["の"],["の"],["うち"],["三","みっ"],["つ"],["が"],["その"],["根","ね"],["から"],["抜","ぬけ"],["落","おち"],["た"],["。"],["見よ","みよ"],["、"],["この"],["小さい","ちいさい"],["角","つ"],["のに"],["は"],["、"],["人","ひと"],["の"],["目","め"],["の"],["よう"],["な"],["目","め"],["が"],["あり"],["、"],["また"],["大きな","おおきな"],["事","こと"],["を"],["語る","かたる"],["口","くち"],["が"],["あった"],["。"]]},{"verse":9,"text":"わたしが見,みていると、もろもろのみ座,ざが設,もうけられて、日,ひの老,おいたる者,ものが座,ざしておられた。その衣,ころもは雪,ゆきのように白,しろく、頭,とうの毛,けは混,まじりもののない羊,ひつじの毛,けのようであった。そのみ座,ざは火,ひの炎,ほのおであり、その車輪,しゃりんは燃,もえる火,ひであった。","tok":[["わたし"],["が"],["見て","みて"],["いる"],["と"],["、"],["もろもろ"],["のみ"],["座","ざ"],["が"],["設けられて","もうけられて"],["、"],["日","ひ"],["の"],["老","おい"],["たる"],["者","もの"],["が"],["座して","ざして"],["おられた"],["。"],["その"],["衣","ころも"],["は"],["雪","ゆき"],["の"],["よう"],["に"],["白く","しろく"],["、"],["頭","とう"],["の"],["毛","け"],["は"],["混じり","まじり"],["もの"],["の"],["ない"],["羊","ひつじ"],["の"],["毛","け"],["の"],["よう"],["で"],["あった"],["。"],["その"],["み座","みざ"],["は"],["火","ひ"],["の"],["炎","ほのお"],["で"],["あり"],["、"],["その"],["車輪","しゃりん"],["は"],["燃える","もえる"],["火","ひ"],["で"],["あった"],["。"]]},{"verse":10,"text":"彼,かれの前,まえから、ひと筋,すじの火,ひの流,ながれが出,でてきた。彼,かれに仕,つかえる者,ものは千々,せんせん、彼,かれの前,まえにはべる者,ものは万々,まんまん、審判,しんぱんを行,おこなう者,ものはその席,せきに着,つき、かずかずの書,かき物,ものが開,ひらかれた。","tok":[["彼","かれ"],["の"],["前","まえ"],["から"],["、"],["ひと筋","ひとすじ"],["の"],["火","ひ"],["の"],["流れ","ながれ"],["が"],["出て","でて"],["きた"],["。"],["彼","かれ"],["に"],["仕える","つかえる"],["者","もの"],["は"],["千々","せん"],["せん"],["、"],["彼","かれ"],["の"],["前","まえ"],["に"],["はべる"],["者","もの"],["は"],["万々","まん"],["ま"],["ん"],["、"],["審判","しんぱん"],["を"],["行なう","おこなう"],["者","もの"],["は"],["その"],["席","せき"],["に"],["着き","つき"],["、"],["かずかず"],["の"],["書き物","かきもの"],["が"],["開らかれた","ひらかれた"],["。"]]},{"verse":11,"text":"わたしは、その角,つのの語,かたる大,おおいなる言葉,ことばの声,こえがするので見,みていたが、わたしが見,みている間,あいだにその獣,けものは殺,ころされ、そのからだはそこなわれて、燃,もえる火,ひに投,なげ入,いれられた。","tok":[["わたし"],["は"],["、"],["その"],["角","つ"],["の"],["の"],["語る","かたる"],["大いなる","おおいなる"],["言葉","ことば"],["の"],["声","こえ"],["が"],["する"],["ので"],["見て","みて"],["いた"],["が"],["、"],["わたし"],["が"],["見て","みて"],["いる"],["間","あいだ"],["に"],["その"],["獣","けもの"],["は"],["殺ろされ","ころされ"],["、"],["その"],["からだ"],["は"],["そこなわれて"],["、"],["燃える","もえる"],["火","ひ"],["に"],["投入れられた","なげいれられた"],["。"]]},{"verse":12,"text":"その他,たの獣,けものはその主権,しゅけんを奪,うばわれたが、その命,いのちは、時,ときと季節,きせつの来,くるまで延,のばされた。","tok":[["その"],["他","た"],["の"],["獣","けもの"],["は"],["その"],["主権","しゅけん"],["を"],["奪われた","うばわれた"],["が"],["、"],["その"],["命","いのち"],["は"],["、"],["時","とき"],["と"],["季節","きせつ"],["の"],["来る","くる"],["まで"],["延ばされた","のばされた"],["。"]]},{"verse":13,"text":"わたしはまた夜,よるの幻,まぼろしのうちに見,みていると、見,みよ、人,ひとの子,このような者,ものが、天,てんの雲,くもに乗,のってきて、日,ひの老,おいたる者,もののもとに来,くると、その前,まえに導,みちびかれた。","tok":[["わたし"],["は"],["また"],["夜","よる"],["の"],["幻","まぼろし"],["の"],["うち"],["に"],["見て","みて"],["いる"],["と"],["、"],["見よ","みよ"],["、"],["人","ひと"],["の"],["子","こ"],["の"],["よう"],["な"],["者","もの"],["が"],["、"],["天","てん"],["の"],["雲","くも"],["に"],["乗って","のって"],["きて"],["、"],["日","ひ"],["の"],["老","おい"],["たる"],["者","もの"],["の"],["もと"],["に"],["来る","くる"],["と"],["、"],["その"],["前","まえ"],["に"],["導かれた","みちびかれた"],["。"]]},{"verse":14,"text":"彼,かれに主権,しゅけんと光栄,こうえいと国,くにとを賜,たまい、諸民,しょみん、諸,しょ族,ぞく、諸国,しょこく語,ごの者,ものを彼,かれに仕,つかえさせた。その主権,しゅけんは永遠,えいえんの主権,しゅけんであって、なくなることがなく、その国,くには滅,ほろびることがない。","tok":[["彼","かれ"],["に"],["主権","しゅけん"],["と"],["光栄","こうえい"],["と"],["国","くに"],["と"],["を"],["賜い","たまい"],["、"],["諸民","しょみん"],["、"],["諸族","しょぞく"],["、"],["諸国","しょこく"],["語","ご"],["の"],["者","もの"],["を"],["彼","かれ"],["に"],["仕えさせた","つかえさせた"],["。"],["その"],["主権","しゅけん"],["は"],["永遠","えいえん"],["の"],["主権","しゅけん"],["で"],["あって"],["、"],["なくなる"],["こと"],["が"],["なく"],["、"],["その"],["国","くに"],["は"],["滅びる","ほろびる"],["こと"],["が"],["ない"],["。"]]},{"verse":15,"text":"そこで、われダニエル、わがうちなる霊,れいは憂,うれえ、わが脳中,のうちゅうの幻,まぼろしは、わたしを悩,なやましたので、","tok":[["そこ"],["で"],["、"],["われ"],["ダニエル"],["、"],["わが"],["うち"],["なる"],["霊","れい"],["は"],["憂え","うれえ"],["、"],["わが"],["脳中","のうちゅう"],["の"],["幻","まぼろし"],["は"],["、"],["わたし"],["を"],["悩した","なやました"],["ので"],["、"]]},{"verse":16,"text":"わたしは、そこに立,たっている者,もののひとりに近寄,ちかよって、このすべての事,ことの真意,しんいを尋,たずねた。するとその者,ものは、わたしにこの事,ことの解,とき明,あかしを告,つげ知,しらせた。","tok":[["わたし"],["は"],["、"],["そこ"],["に"],["立って","たって"],["いる"],["者","もの"],["の"],["ひとり"],["に"],["近寄って","ちかよって"],["、"],["この"],["すべて"],["の"],["事","こと"],["の"],["真意","しんい"],["を"],["尋ねた","たずねた"],["。"],["する"],["と"],["その"],["者","もの"],["は"],["、"],["わたし"],["に"],["この"],["事","こと"],["の"],["解き明かし","ときあかし"],["を"],["告","つげ"],["知らせた","しらせた"],["。"]]},{"verse":17,"text":"『この四つの大,おおきな獣,けものは、地,ちに起,おこらんとする四人,にんの王,おうである。","tok":[["『"],["この"],["四","よん"],["つ"],["の"],["大きな","おおきな"],["獣","けもの"],["は"],["、"],["地","ち"],["に"],["起こらん","おこらん"],["と"],["する"],["四人","にん"],["の"],["王","おう"],["で"],["ある"],["。"]]},{"verse":18,"text":"しかしついには、いと高,たかき者,ものの聖徒,せいとが国,くにを受,うけ、永遠,えいえんにその国,くにを保,たもって、世々,よよかぎりなく続,つづく』。","tok":[["しかし"],["ついに"],["は"],["、"],["いと"],["高き","たかき"],["者","もの"],["の"],["聖徒","せいと"],["が"],["国","くに"],["を"],["受け","うけ"],["、"],["永遠","えいえん"],["に"],["その"],["国","くに"],["を"],["保って","たもって"],["、"],["世々","よ"],["よ"],["かぎりなく"],["続く","つづく"],["』"],["。"]]},{"verse":19,"text":"そこでわたしは、さらに第,だい四の獣,けものの真意,しんいを知,しろうとした。その獣,けものは他,たの獣,けものと異,ことなって、はなはだ恐,おそろしく、その歯,はは鉄,てつ、そのつめは青銅,せいどうであって、食,くらい、かつ、かみ砕,くだいて、その残,のこりを足,あしで踏,ふみつけた。","tok":[["そこ"],["で"],["わたし"],["は"],["、"],["さらに"],["第","だい"],["四","よん"],["の"],["獣","けもの"],["の"],["真意","しんい"],["を"],["知ろう","しろう"],["と"],["した"],["。"],["その"],["獣","けもの"],["は"],["他","た"],["の"],["獣","けもの"],["と"],["異なって","ことなって"],["、"],["はなはだ"],["恐ろしく","おそろしく"],["、"],["その"],["歯","は"],["は"],["鉄","てつ"],["、"],["その"],["つめ"],["は"],["青銅","せいどう"],["で"],["あって"],["、"],["食らい","くらい"],["、"],["かつ"],["、"],["かみ砕いて","かみくだいて"],["、"],["その"],["残り","のこり"],["を"],["足","あし"],["で"],["踏みつけた","ふみつけた"],["。"]]},{"verse":20,"text":"この獣,けものの頭,あたまには、十の角,つのがあったが、そのほかに一つの角,つのが出,でてきたので、この角,つののために、三つの角,つのが抜,ぬけ落,おちた。この角,つのには目,めがあり、また大,おおきな事,ことを語,かたる口,くちがあって、その形,かたちは、その同類,どうるいのものよりも大,おおきく見,みえた。","tok":[["この"],["獣","けもの"],["の"],["頭","あたま"],["に"],["は"],["、"],["十","じゅう"],["の"],["角","つ"],["の"],["が"],["あった"],["が"],["、"],["その"],["ほか"],["に"],["一","ひと"],["つ"],["の"],["角","つ"],["の"],["が"],["出て","でて"],["きた"],["ので"],["、"],["この"],["角","つ"],["の"],["の"],["ため"],["に"],["、"],["三","みっ"],["つ"],["の"],["角","つ"],["の"],["が"],["抜","ぬけ"],["落","おち"],["た"],["。"],["この"],["角","つ"],["のに"],["は"],["目","め"],["が"],["あり"],["、"],["また"],["大きな","おおきな"],["事","こと"],["を"],["語る","かたる"],["口","くち"],["が"],["あって"],["、"],["その"],["形","かたち"],["は"],["、"],["その"],["同類","どうるい"],["の"],["もの"],["より"],["も"],["大きく","おおきく"],["見えた","みえた"],["。"]]},{"verse":21,"text":"わたしが見,みていると、この角,つのは聖徒,せいとと戦,たたかって、彼,かれらに勝,かったが、","tok":[["わたし"],["が"],["見て","みて"],["いる"],["と"],["、"],["この"],["角","つ"],["の"],["は"],["聖徒","せいと"],["と"],["戦って","たたかって"],["、"],["彼","かれ"],["ら"],["に"],["勝った","かった"],["が"],["、"]]},{"verse":22,"text":"ついに日,ひの老,おいたる者,ものがきて、いと高,たかき者,ものの聖徒,せいとのために審判,しんぱんをおこなった。そしてその時,ときがきて、この聖徒,せいとたちは国,くにを受,うけた。","tok":[["ついに"],["日","ひ"],["の"],["老","おい"],["たる"],["者","もの"],["が"],["きて"],["、"],["いと"],["高き","たかき"],["者","もの"],["の"],["聖徒","せいと"],["の"],["ため"],["に"],["審判","しんぱん"],["を"],["おこなった"],["。"],["そして"],["その"],["時","とき"],["が"],["きて"],["、"],["この"],["聖徒","せいと"],["たち"],["は"],["国","くに"],["を"],["受た","うけた"],["。"]]},{"verse":23,"text":"彼,かれはこう言,いった、『第,だい四の獣,けものは地上,ちじょうの第,だい四の国,くにである。これはすべての国,くにと異,ことなって、全,ぜん世界,せかいを併合,へいごうし、これを踏,ふみつけ、かつ打,うち砕,くだく。","tok":[["彼","かれ"],["は"],["こう"],["言った","いった"],["、"],["『"],["第","だい"],["四","よん"],["の"],["獣","けもの"],["は"],["地上","ちじょう"],["の"],["第","だい"],["四","よん"],["の"],["国","くに"],["で"],["ある"],["。"],["これ"],["は"],["すべて"],["の"],["国","くに"],["と"],["異なって","ことなって"],["、"],["全","ぜん"],["世界","せかい"],["を"],["併合","へいごう"],["し"],["、"],["これ"],["を"],["踏みつけ","ふみつけ"],["、"],["かつ"],["打ち砕く","うちくだく"],["。"]]},{"verse":24,"text":"十の角,つのはこの国,くにから起,おこる十人,にんの王,おうである。その後,のちにまたひとりの王,おうが起,おこる。彼,かれは先,さきの者,ものと異,ことなり、かつ、その三人,にんの王,おうを倒,たおす。","tok":[["十","じゅう"],["の"],["角","つ"],["の"],["は"],["この"],["国","くに"],["から"],["起こる","おこる"],["十人","にん"],["の"],["王","おう"],["で"],["ある"],["。"],["その後","そののち"],["に"],["また"],["ひとり"],["の"],["王","おう"],["が"],["起こる","おこる"],["。"],["彼","かれ"],["は"],["先","さき"],["の"],["者","もの"],["と"],["異なり","ことなり"],["、"],["かつ"],["、"],["その"],["三人","にん"],["の"],["王","おう"],["を"],["倒す","たおす"],["。"]]},{"verse":25,"text":"彼,かれは、いと高,たかき者,ものに敵,てきして言葉,ことばを出,だし、かつ、いと高,たかき者,ものの聖徒,せいとを悩,なやます。彼,かれはまた時,ときと律法,りっぽうとを変,かえようと望,のぞむ。聖徒,せいとはひと時,ときと、ふた時,ときと、半時,はんときの間,あいだ、彼,かれの手,てにわたされる。","tok":[["彼","かれ"],["は"],["、"],["いと"],["高き","たかき"],["者","もの"],["に"],["敵して","てきして"],["言葉","ことば"],["を"],["出し","だし"],["、"],["かつ"],["、"],["いと"],["高き","たかき"],["者","もの"],["の"],["聖徒","せいと"],["を"],["悩す","なやます"],["。"],["彼","かれ"],["は"],["また"],["時","とき"],["と"],["律法","りっぽう"],["と"],["を"],["変えよう","かえよう"],["と"],["望む","のぞむ"],["。"],["聖徒","せいと"],["は"],["ひと時","ひととき"],["と"],["、"],["ふた"],["時","とき"],["と"],["、"],["半時","はんとき"],["の"],["間","あいだ"],["、"],["彼","かれ"],["の"],["手","て"],["に"],["わたされる"],["。"]]},{"verse":26,"text":"しかし審判,しんぱんが行,おこなわれ、彼,かれの主権,しゅけんは奪,うばわれて、永遠,えいえんに滅,ほろび絶,たやされ、","tok":[["しかし"],["審判","しんぱん"],["が"],["行なわれ","おこなわれ"],["、"],["彼","かれ"],["の"],["主権","しゅけん"],["は"],["奪われて","うばわれて"],["、"],["永遠","えいえん"],["に"],["滅び","ほろび"],["絶やされ","たやされ"],["、"]]},{"verse":27,"text":"国,くにと主権,しゅけんと全,ぜん天下,てんかの国々,くにぐにの権威,けんいとは、いと高,たかき者,ものの聖徒,せいとたる民,たみに与,あたえられる。彼,かれらの国,くには永遠,えいえんの国,くにであって、諸国,しょこくの者,ものはみな彼,かれらに仕,つかえ、かつ従,したがう』。","tok":[["国","くに"],["と"],["主権","しゅけん"],["と"],["全","ぜん"],["天下","てんか"],["の"],["国々","くにぐに"],["の"],["権威","けんい"],["と"],["は"],["、"],["いと"],["高き","たかき"],["者","もの"],["の"],["聖徒","せいと"],["たる"],["民","たみ"],["に"],["与えられる","あたえられる"],["。"],["彼","かれ"],["ら"],["の"],["国","くに"],["は"],["永遠","えいえん"],["の"],["国","くに"],["で"],["あって"],["、"],["諸国","しょこく"],["の"],["者","もの"],["は"],["みな"],["彼","かれ"],["ら"],["に"],["仕え","つかえ"],["、"],["かつ"],["従う","したがう"],["』"],["。"]]},{"verse":28,"text":"その事,ことはここで終,おわった。われダニエルは、これを思,おもいまわして、非常,ひじょうに悩,なやみ、顔色,かおいろも変,かわった。しかし、わたしはこの事,ことを心,こころに留,とめた」。","tok":[["その"],["事","こと"],["は"],["ここ"],["で"],["終わった","おわった"],["。"],["われ"],["ダニエル"],["は"],["、"],["これ"],["を"],["思い","おもい"],["まわして"],["、"],["非常","ひじょう"],["に"],["悩み","なやみ"],["、"],["顔色","かおいろ"],["も"],["変わった","かわった"],["。"],["しかし"],["、"],["わたし"],["は"],["この"],["事","こと"],["を"],["心","こころ"],["に"],["留","とめ"],["た"],["」"],["。"]]}]
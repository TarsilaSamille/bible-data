[{"verse":1,"text":"メデアびとアハシュエロスの子,こダリヨスが、カルデヤびとの王,おうとなったその元年,がんねん、","tok":[["メデア"],["び"],["と"],["アハシュエロス"],["の"],["子","こ"],["ダリヨス"],["が"],["、"],["カルデヤ"],["びと"],["の"],["王","おう"],["と"],["なった"],["その"],["元年","がんねん"],["、"]]},{"verse":2,"text":"すなわちその治世,ちせいの第,だい一年,ねんに、われダニエルは主,しゅが預言者,よげんしゃエレミヤに臨,のぞんで告,つげられたその言葉,ことばにより、エルサレムの荒廃,こうはいの終,おわるまでに経,へねばならぬ年,ねんの数,かずは七十年,ねんであることを、文書,ぶんしょによって悟,さとった。","tok":[["すなわち"],["その"],["治世","ちせい"],["の"],["第","だい"],["一","いち"],["年","ねん"],["に"],["、"],["われ"],["ダニエル"],["は"],["主","しゅ"],["が"],["預言者","よげんしゃ"],["エレミヤ"],["に"],["臨んで","のぞんで"],["告げられた","つげられた"],["その"],["言葉","ことば"],["に"],["より"],["、"],["エルサレム"],["の"],["荒廃","こうはい"],["の"],["終わる","おわる"],["まで"],["に"],["経ねば","へねば"],["ならぬ"],["年","ねん"],["の"],["数","かず"],["は"],["七十","ななじゅう"],["年","ねん"],["を"],["、"],["文書","ぶんしょ"],["によって"],["悟った","さとった"],["。"]]},{"verse":3,"text":"それでわたしは、わが顔,かおを主,しゅなる神,かみに向,むけ、断食,だんじきをなし、荒布,あらぬのを着,き、灰,はいをかぶって祈,いのり、かつ願,ねがい求,もとめた。","tok":[["それ"],["で"],["わたし"],["は"],["、"],["わが"],["顔","かお"],["を"],["主","しゅ"],["なる"],["神","かみ"],["に"],["向け","むけ"],["、"],["断食","だんじき"],["を"],["なし"],["、"],["荒布","あらぬ"],["の"],["を"],["着","き"],["、"],["灰","はい"],["を"],["かぶって"],["祈","いのり"],["、"],["かつ"],["願い求めた","ねがいもとめた"],["。"]]},{"verse":4,"text":"すなわちわたしは、わが神,かみ、主,しゅに祈,いのり、ざんげして言,いった、「ああ、大,おおいなる恐,おそるべき神,かみ、主,しゅ、おのれを愛,あいし、おのれの戒,いましめを守,まもる者,もののために契約,けいやくを保,たもち、いつくしみを施,ほどこされる者,ものよ、","tok":[["すなわち"],["わたし"],["は"],["、"],["わが"],["神","かみ"],["、"],["主に","しゅに"],["祈","いのり"],["、"],["ざんげ"],["して"],["言った","いった"],["、"],["「"],["ああ"],["、"],["大いなる","おおいなる"],["恐るべき","おそるべき"],["神","かみ"],["、"],["主","しゅ"],["、"],["おのれ"],["を"],["愛し","あいし"],["、"],["おのれ"],["の"],["戒しめ","いましめ"],["を"],["守者","まもるもの"],["の"],["ため"],["に"],["契約","けいやく"],["を"],["保ち","たもち"],["、"],["いつくしみ"],["を"],["施される","ほどこされる"],["者","もの"],["よ"],["、"]]},{"verse":5,"text":"われわれは罪,つみを犯,おかし、悪,あくをおこない、よこしまなふるまいをなし、そむいて、あなたの戒,いましめと、おきてを離,はなれました。","tok":[["われわれ"],["は"],["罪","つみ"],["を"],["犯し","おかし"],["、"],["悪","あく"],["を"],["おこない"],["、"],["よこしま"],["な"],["ふるまい"],["を"],["なし"],["、"],["そむいて"],["、"],["あなた"],["の"],["戒しめ","いましめ"],["と"],["、"],["おきて"],["を"],["離れました","はなれました"],["。"]]},{"verse":6,"text":"われわれはまた、あなたのしもべなる預言者,よげんしゃたちが、あなたの名,なをもって、われわれの王,おうたち、君,きみたち、先祖,せんぞたち、および国,くにのすべての民,たみに告,つげた言葉,ことばに聞,きき従,したがいませんでした。","tok":[["われわれ"],["は"],["また"],["、"],["あなた"],["の"],["しもべ"],["なる"],["預言者","よげんしゃ"],["たち"],["が"],["、"],["あなた"],["の"],["名","な"],["を"],["もって"],["、"],["われわれ"],["の"],["王","おう"],["たち"],["、"],["君","きみ"],["たち"],["、"],["先祖","せんぞ"],["たち"],["、"],["および"],["国","くに"],["の"],["すべて"],["の"],["民","たみ"],["に"],["告","つげ"],["た"],["言葉","ことば"],["に"],["聞","きき"],["従いませんでした","したがいませんでした"],["。"]]},{"verse":7,"text":"主,しゅよ、正義,せいぎはあなたのものですが、恥,はじはわれわれに加,くわえられて、今日,こんにちのような有様,ありさまです。すなわちユダの人々,ひとびと、エルサレムの住民,じゅうみんおよび全,ぜんイスラエルの者,ものは、近,ちかき者,ものも、遠,とおき者,ものもみな、あなたが追,おいやられたすべての国々,くにぐにで恥,はじをこうむりました。これは彼,かれらがあなたにそむいて犯,おかした罪,つみによるのです。","tok":[["主","しゅ"],["よ"],["、"],["正義","せいぎ"],["は"],["あなた"],["の"],["もの"],["です"],["が"],["、"],["恥","はじ"],["は"],["われわれ"],["に"],["加えられて","くわえられて"],["、"],["今日","こんにち"],["の"],["よう"],["な"],["有様","ありさま"],["です"],["。"],["すなわち"],["ユダ"],["の"],["人々","ひとびと"],["、"],["エルサレム"],["の"],["住民","じゅうみん"],["および"],["全","ぜん"],["イスラエル"],["の"],["者","もの"],["は"],["、"],["近き","ちかき"],["者","もの"],["も"],["、"],["遠き","とおき"],["者","もの"],["も"],["みな"],["、"],["あなた"],["が"],["追いやられた","おいやられた"],["すべて"],["の"],["国々","くにぐに"],["で"],["恥","はじ"],["を"],["こうむりました"],["。"],["これ"],["は"],["彼","かれ"],["ら"],["が"],["あなた"],["に"],["そむいて"],["犯した","おかした"],["罪","つみ"],["に"],["よる"],["の"],["です"],["。"]]},{"verse":8,"text":"主,しゅよ、恥,はじはわれわれのもの、われわれの王,おうたち、君,きみたちおよび先祖,せんぞたちのものです。これはわれわれがあなたにむかって罪,つみを犯,おかしたからです。","tok":[["主","しゅ"],["よ"],["、"],["恥","はじ"],["は"],["われわれ"],["の"],["もの"],["、"],["われわれ"],["の"],["王","おう"],["たち"],["、"],["君","きみ"],["たち"],["および"],["先祖","せんぞ"],["たち"],["の"],["もの"],["です"],["。"],["これ"],["は"],["われわれ"],["が"],["あなた"],["に"],["むかって"],["罪","つみ"],["を"],["犯した","おかした"],["から"],["です"],["。"]]},{"verse":9,"text":"あわれみと、ゆるしはわれわれの神,かみ、主,しゅのものです。これはわれわれが彼,かれにそむいたからです。","tok":[["あわれみ"],["と"],["、"],["ゆるし"],["は"],["われわれ"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["もの"],["です"],["。"],["これ"],["は"],["われわれ"],["が"],["彼","かれ"],["に"],["そむいた"],["から"],["です"],["。"]]},{"verse":10,"text":"またわれわれの神,かみ、主,しゅのみ声,こえに聞,きき従,したがわず、主,しゅがそのしもべ預言者,よげんしゃたちによって、われわれの前,まえに賜,たまわった律法,りっぽうを行,おこなわなかったからです。","tok":[["また"],["われわれ"],["の"],["神","かみ"],["、"],["主","しゅ"],["のみ"],["声","こえ"],["に"],["聞","きき"],["従わず","したがわず"],["、"],["主","しゅがそ"],["の"],["しもべ"],["預言者","よげんしゃ"],["たち"],["によって"],["、"],["われわれ"],["の"],["前","まえ"],["に"],["賜わった","たまわった"],["律法","りっぽう"],["を"],["行なわなかった","おこなわなかった"],["から"],["です"],["。"]]},{"verse":11,"text":"まことにイスラエルの人々,ひとびとは皆,みなあなたの律法,りっぽうを犯,おかし、離,はなれ去,さって、あなたのみ声,こえに聞,きき従,したがわなかったので、神,かみのしもべモーセの律法,りっぽうにしるされたのろいと誓,ちかいが、われわれの上,うえに注,そそぎかかりました。これはわれわれが神,かみにむかって罪,つみを犯,おかしたからです。","tok":[["まこと"],["に"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["皆","みな"],["あなた"],["の"],["律法","りっぽう"],["を"],["犯し","おかし"],["、"],["離れ","はなれ"],["去て","さって"],["、"],["あなた"],["のみ"],["声","こえ"],["に"],["聞","きき"],["従わなかった","したがわなかった"],["ので"],["、"],["神","かみ"],["の"],["しもべ"],["モーセ"],["の"],["律法","りっぽう"],["に"],["しるされた"],["のろい"],["と"],["誓い","ちかい"],["が"],["、"],["われわれ"],["の"],["上","うえ"],["に"],["注ぎ","そそぎ"],["かかりました"],["。"],["これ"],["は"],["われわれ"],["が"],["神","かみ"],["に"],["むかって"],["罪","つみ"],["を"],["犯した","おかした"],["から"],["です"],["。"]]},{"verse":12,"text":"すなわち神,かみは大,おおいなる災,わざわいをわれわれの上,うえにくだして、さきにわれわれと、われわれを治,おさめたつかさたちにむかって告,つげられた言葉,ことばを実行,じっこうされたのです。あのエルサレムに臨,のぞんだような事,ことは、全,ぜん天下,てんかにいまだかつてなかった事,ことです。","tok":[["すなわち"],["神","かみ"],["は"],["大いなる","おおいなる"],["災","わざわい"],["を"],["われわれ"],["の"],["上","うえ"],["に"],["くだして"],["、"],["さき"],["に"],["われわれ"],["と"],["、"],["われわれ"],["を"],["治めた","おさめた"],["つかさ"],["たち"],["に"],["むかって"],["告げられた","つげられた"],["言葉","ことば"],["を"],["実行","じっこう"],["された"],["の"],["です"],["。"],["あの"],["エルサレム"],["に"],["臨んだ","のぞんだ"],["よう"],["な"],["事","こと"],["は"],["、"],["全","ぜん"],["天下","てんか"],["に"],["いまだ"],["かつて"],["なかった"],["事","こと"],["です"],["。"]]},{"verse":13,"text":"モーセの律法,りっぽうにしるされたように、この災,わざわいはすべてわれわれに臨,のぞみましたが、なおわれわれの神,かみ、主,しゅの恵,めぐみを請,こい求,もとめることをせず、その不義,ふぎを離,はなれて、あなたの真理,しんりを悟,さとることをもしませんでした。","tok":[["モーセ"],["の"],["律法","りっぽう"],["に"],["しるされた"],["よう"],["に"],["、"],["この"],["災","わざわい"],["は"],["すべて"],["われわれ"],["に"],["臨みました","のぞみました"],["が"],["、"],["なお"],["われわれ"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["恵","めぐみ"],["を"],["請い求める","こいもとめる"],["こと"],["を"],["せず"],["、"],["その"],["不義","ふぎ"],["を"],["離れて","はなれて"],["、"],["あなた"],["の"],["真理","しんり"],["を"],["悟","さとる"],["こと"],["を"],["も"],["しませんでした"],["。"]]},{"verse":14,"text":"それゆえ、主,しゅはこれを心,こころに留,とめて、災,わざわいをわれわれに下,くだされたのです。われわれの神,かみ、主,しゅは、何事,なにごとをされるにも、正,ただしくあらせられます。ところが、われわれはそのみ声,こえに聞,きき従,したがわなかったのです。","tok":[["それ"],["ゆえ"],["、"],["主","しゅ"],["は"],["これ"],["を"],["心","こころ"],["に"],["留","とめ"],["て"],["、"],["災","わざわい"],["を"],["われわれ"],["に"],["下された","くだされた"],["の"],["です"],["。"],["われわれ"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["、"],["何事","なにごと"],["を"],["される"],["に"],["も"],["、"],["正く","ただしく"],["あらせられます"],["。"],["ところ"],["が"],["、"],["われわれ"],["は"],["その"],["み声","みこえ"],["に"],["聞","きき"],["従わなかった","したがわなかった"],["の"],["です"],["。"]]},{"verse":15,"text":"われわれの神,かみ、主,しゅよ、あなたは強,つよきみ手,てをもって、あなたの民,たみをエジプトの地,ちから導,みちびき出,だして、今日,こんにちのように、み名,なをあげられました。われわれは罪,つみを犯,おかし、よこしまなふるまいをしました。","tok":[["われわれ"],["の"],["神","かみ"],["、"],["主","しゅ"],["よ"],["、"],["あなた"],["は"],["強き","つよき"],["み手","みて"],["を"],["もって"],["、"],["あなた"],["の"],["民","たみ"],["を"],["エジプト"],["の"],["地","ち"],["から"],["導き出して","みちびきだして"],["、"],["今日","こんにち"],["の"],["よう"],["に"],["、"],["み名","みな"],["を"],["あげられました"],["。"],["われわれ"],["は"],["罪","つみ"],["を"],["犯し","おかし"],["、"],["よこしま"],["な"],["ふるまい"],["を"],["しました"],["。"]]},{"verse":16,"text":"主,しゅよ、どうぞあなたが、これまで正,ただしいみわざをなされたように、あなたの町,まちエルサレム、あなたの聖,せいなる山,やまから、あなたの怒,いかりと憤,いきどおりとを取,とり去,さってください。これはわれわれの罪,つみと、われわれの先祖,せんぞの不義,ふぎのために、エルサレムと、あなたの民,たみが、われわれの周囲,しゅういの者,ものの物笑,ものわらいとなったからです。","tok":[["主","しゅ"],["よ"],["、"],["どうぞ"],["あなた"],["が"],["、"],["これ"],["まで"],["正い","ただしい"],["みわざ"],["を"],["なされた"],["よう"],["に"],["、"],["あなた"],["の"],["町","まち"],["エルサレム"],["、"],["あなた"],["の"],["聖","せい"],["なる"],["山","やま"],["から"],["、"],["あなた"],["の"],["怒り","いかり"],["と"],["憤り","いきどおり"],["と"],["を"],["取","とり"],["去て","さって"],["ください"],["。"],["これ"],["は"],["われわれ"],["の"],["罪","つみ"],["と"],["、"],["われわれ"],["の"],["先祖","せんぞ"],["の"],["不義","ふぎ"],["の"],["ため"],["に"],["、"],["エルサレム"],["と"],["、"],["あなた"],["の"],["民","たみ"],["が"],["、"],["われわれ"],["の"],["周囲","しゅうい"],["の"],["者","もの"],["の"],["物","もの"],["笑","わらい"],["と"],["なった"],["から"],["です"],["。"]]},{"verse":17,"text":"それゆえ、われわれの神,かみよ、しもべの祈,いのりと願,ねがいを聞,きいてください。主,しゅよ、あなたご自身,じしんのために、あの荒,あれたあなたの聖所,せいじょに、あなたのみ顔,かおを輝,かがやかせてください。","tok":[["それ"],["ゆえ"],["、"],["われわれ"],["の"],["神","かみ"],["よ"],["、"],["しもべ"],["の"],["祈","いのり"],["と"],["願い","ねがい"],["を"],["聞いて","きいて"],["ください"],["。"],["主","しゅ"],["よ"],["、"],["あなた"],["ご自身","ごじしん"],["の"],["ため"],["に"],["、"],["あの"],["荒れた","あれた"],["あなた"],["の"],["聖","せい"],["所","しょ"],["に"],["、"],["あなた"],["のみ"],["顔","かお"],["を"],["輝やかせて","かがやかせて"],["ください"],["。"]]},{"verse":18,"text":"わが神,かみよ、耳,みみを傾,かたむけて聞,きいてください。目,めを開,ひらいて、われわれの荒,あれたさまを見,み、み名,なをもってとなえられる町,まちをごらんください。われわれがあなたの前,まえに祈,いのりをささげるのは、われわれの義,ぎによるのではなく、ただあなたの大,おおいなるあわれみによるのです。","tok":[["わが"],["神","かみ"],["よ"],["、"],["耳","みみ"],["を"],["傾むけて","かたむけて"],["聞いて","きいて"],["ください"],["。"],["目","め"],["を"],["開らいて","ひらいて"],["、"],["われわれ"],["の"],["荒れた","あれた"],["さま"],["を"],["見","み"],["、"],["み名","みな"],["を"],["もって"],["となえられる"],["町","まち"],["を"],["ごらん"],["ください"],["。"],["われわれ"],["が"],["あなた"],["の"],["前","まえ"],["に"],["祈","いのり"],["を"],["ささげる"],["の"],["は"],["、"],["われわれ"],["の"],["義","ぎ"],["に"],["よる"],["ので"],["は"],["なく"],["、"],["ただ"],["あなた"],["の"],["大いなる","おおいなる"],["あわれみ"],["に"],["よる"],["の"],["です"],["。"]]},{"verse":19,"text":"主,しゅよ、聞,きいてください。主,しゅよ、ゆるしてください。主,しゅよ、み心,こころに留,とめて、おこなってください。わが神,かみよ、あなたご自身,じしんのために、これを延,のばさないでください。あなたの町,まちと、あなたの民,たみは、み名,なをもってとなえられているからです」。","tok":[["主","しゅ"],["よ"],["、"],["聞いて","きいて"],["ください"],["。"],["主","しゅ"],["よ"],["、"],["ゆるして"],["ください"],["。"],["主","しゅ"],["よ"],["、"],["み心","みこころ"],["に"],["留","とめ"],["て"],["、"],["おこなって"],["ください"],["。"],["わが"],["神","かみ"],["よ"],["、"],["あなた"],["ご自身","ごじしん"],["の"],["ため"],["に"],["、"],["これ"],["を"],["延ばさないで","のばさないで"],["ください"],["。"],["あなた"],["の"],["町","まち"],["と"],["、"],["あなた"],["の"],["民","たみ"],["は"],["、"],["み名","みな"],["を"],["もって"],["となえられて"],["いる"],["から"],["です"],["」"],["。"]]},{"verse":20,"text":"わたしがこう言,いって祈,いのり、かつわが罪,つみとわが民,たみイスラエルの罪,つみをざんげし、わが神,かみの聖,せいなる山,やまのために、わが神,かみ、主,しゅの前,まえに願,ねがいをしていたとき、","tok":[["わたし"],["が"],["こう"],["言って","いって"],["祈","いのり"],["、"],["かつ"],["わが"],["罪","つみ"],["と"],["わが"],["民","た"],["みイスラエル"],["の"],["罪","つみ"],["を"],["ざんげ"],["し"],["、"],["わが"],["神","かみ"],["の"],["聖","せい"],["なる"],["山","やま"],["の"],["ため"],["に"],["、"],["わが"],["神","かみ"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["願い","ねがい"],["を"],["して"],["いた"],["とき"],["、"]]},{"verse":21,"text":"すなわちわたしが祈,いのりの言葉,ことばを述,のべていたとき、わたしが初,はじめに幻,まぼろしのうちに見,みた、かの人,ひとガブリエルは、すみやかに飛,とんできて、夕,ゆうの供,そなえ物,ものをささげるころ、わたしに近,ちかづき、","tok":[["すなわち"],["わたし"],["が"],["祈","いのり"],["の"],["言葉","ことば"],["を"],["述べて","のべて"],["いた"],["とき"],["、"],["わたし"],["が"],["初め","はじめ"],["に"],["幻","まぼろし"],["の"],["うち"],["に"],["見た","みた"],["、"],["かの"],["人","ひと"],["ガブリエル"],["は"],["、"],["すみやか"],["に"],["飛んで","とんで"],["きて"],["、"],["夕","ゆう"],["の"],["供え物","そなえもの"],["を"],["ささげる"],["ころ"],["、"],["わたし"],["に"],["近づき","ちかづき"],["、"]]},{"verse":22,"text":"わたしに告,つげて言,いった、「ダニエルよ、わたしは今,いまあなたに、知恵,ちえと悟,さとりを与,あたえるためにきました。","tok":[["わたし"],["に"],["告","つげ"],["て"],["言った","いった"],["、"],["「"],["ダニエル"],["よ"],["、"],["わたし"],["は"],["今","いま"],["あなた"],["に"],["、"],["知恵","ちえ"],["と"],["悟り","さとり"],["を"],["与える","あたえる"],["ため"],["に"],["きました"],["。"]]},{"verse":23,"text":"あなたが祈,いのりを始,はじめたとき、み言葉,ことばが出,でたので、それをあなたに告,つげるためにきたのです。あなたは大,おおいに愛,あいせられている者,ものです。ゆえに、このみ言葉,ことばを考,かんがえて、この幻,まぼろしを悟,さとりなさい。","tok":[["あなた"],["が"],["祈","いのり"],["を"],["始","はじめ"],["た"],["とき"],["、"],["み言葉","みことば"],["が"],["出た","でた"],["ので"],["、"],["それ"],["を"],["あなた"],["に"],["告げる","つげる"],["ため"],["に"],["きた"],["の"],["です"],["。"],["あなた"],["は"],["大いに","おおいに"],["愛せられて","あいせられて"],["いる"],["者","もの"],["です"],["。"],["ゆえ"],["に"],["、"],["この"],["み言葉","みことば"],["を"],["考","かんがえ"],["て"],["、"],["この"],["幻","まぼろし"],["を"],["悟り","さとり"],["なさい"],["。"]]},{"verse":24,"text":"あなたの民,たみと、あなたの聖,せいなる町,まちについては、七十週,しゅうが定,さだめられています。これはとがを終,おわらせ、罪,つみに終,おわりを告,つげ、不義,ふぎをあがない、永遠,えいえんの義,ぎをもたらし、幻,まぼろしと預言者,よげんしゃを封,ふうじ、いと聖,せいなる者,ものに油,あぶらを注,そそぐためです。","tok":[["あなた"],["の"],["民","たみ"],["と"],["、"],["あなた"],["の"],["聖","せい"],["なる"],["町","まち"],["について"],["は"],["、"],["七十","ななじゅう"],["週","しゅう"],["う"],["が"],["定められて","さだめられて"],["います"],["。"],["これ"],["は"],["とが"],["を"],["終わらせ","おわらせ"],["、"],["罪","つみ"],["に"],["終","おわり"],["を"],["告","つげ"],["、"],["不義","ふぎ"],["を"],["あがない"],["、"],["永遠","えいえん"],["の"],["義","ぎ"],["を"],["もたらし"],["、"],["幻","まぼろし"],["と"],["預言者","よげんしゃ"],["を"],["封じ","ふうじ"],["、"],["いと"],["聖","せい"],["なる"],["者","もの"],["に"],["油","あぶら"],["を"],["注ぐ","そそぐ"],["ため"],["です"],["。"]]},{"verse":25,"text":"それゆえ、エルサレムを建,たて直,なおせという命令,めいれいが出,でてから、メシヤなるひとりの君,きみが来,くるまで、七週,しゅうと六十二週,しゅうあることを知,しり、かつ悟,さとりなさい。その間,あいだに、しかも不安,ふあんな時代,じだいに、エルサレムは広場,ひろばと街路,がいろとをもって、建,たて直,なおされるでしょう。","tok":[["それ"],["ゆえ"],["、"],["エルサレム"],["を"],["建て直せ","たてなおせ"],["と"],["いう"],["命令","めいれい"],["が"],["出て","でて"],["から"],["、"],["メシヤ"],["なる"],["ひとり"],["の"],["君","きみ"],["が"],["来る","くる"],["まで"],["、"],["七","なな"],["週","しゅう"],["と"],["六十二","ろくじゅうに"],["週","しゅう"],["を"],["知り","しり"],["、"],["かつ"],["悟り","さとり"],["なさい"],["。"],["その"],["間","あいだ"],["に"],["、"],["しかも"],["不安","ふあん"],["な"],["時代","じだい"],["に"],["、"],["エルサレム"],["は"],["広場","ひろば"],["と"],["街路","がいろ"],["と"],["を"],["もって"],["、"],["建て直されるでしょう","たてなおされるでしょう"],["。"]]},{"verse":26,"text":"その六十二週,しゅうの後,のちにメシヤは断,たたれるでしょう。ただし自分,じぶんのためにではありません。またきたるべき君,きみの民,たみは、町,まちと聖所,せいじょとを滅,ほろぼすでしょう。その終,おわりは洪水,こうずいのように臨,のぞむでしょう。そしてその終,おわりまで戦争,せんそうが続,つづき、荒廃,こうはいは定,さだめられています。","tok":[["その"],["六十二","ろくじゅうに"],["週","しゅう"],["の"],["後","のち"],["に"],["メシヤ"],["は"],["断たれるでしょう","たたれるでしょう"],["。"],["ただし"],["自分","じぶん"],["の"],["ため"],["に"],["で"],["は"],["ありません"],["。"],["また"],["きたるべき"],["君","きみ"],["の"],["民","たみ"],["は"],["、"],["町","まち"],["と"],["聖","せい"],["所","しょ"],["を"],["滅ぼすでしょう","ほろぼすでしょう"],["。"],["その"],["終","おわり"],["は"],["洪水","こうずい"],["の"],["よう"],["に"],["臨むでしょう","のぞむでしょう"],["。"],["そして"],["その"],["終","おわり"],["まで"],["戦争","せんそう"],["が"],["続き","つづき"],["、"],["荒廃","こうはい"],["は"],["定められて","さだめられて"],["います"],["。"]]},{"verse":27,"text":"彼,かれは一週,いっしゅうの間,あいだ多,おおくの者,ものと、堅,かたく契約,けいやくを結,むすぶでしょう。そして彼,かれはその週,しゅうの半,なかばに、犠牲,ぎせいと供,そなえ物,ものとを廃,はいするでしょう。また荒,あらす者,ものが憎,にくむべき者,ものの翼,つばさに乗,のって来,くるでしょう。こうしてついにその定,さだまった終,おわりが、その荒,あらす者,ものの上,うえに注,そそがれるのです」。","tok":[["彼","かれ"],["は"],["一","いち"],["週","しゅう"],["の"],["間","あいだ"],["多く","おおく"],["の"],["者","もの"],["と"],["、"],["堅く","かたく"],["契約","けいやく"],["を"],["結ぶでしょう","むすぶでしょう"],["。"],["そして"],["彼","かれ"],["は"],["その"],["週","しゅう"],["の"],["半ば","なかば"],["に"],["、"],["犠牲","ぎせい"],["と"],["供え物","そなえもの"],["と"],["を"],["廃するでしょう","はいするでしょう"],["。"],["また"],["荒す","あらす"],["者","もの"],["が"],["憎むべき","にくむべき"],["者","もの"],["の"],["翼","つばさ"],["に"],["乗って","のって"],["来るでしょう","くるでしょう"],["。"],["こう"],["して"],["ついに"],["その"],["定まった","さだまった"],["終","おわり"],["が"],["、"],["その"],["荒す","あらす"],["者","もの"],["の"],["上","うえ"],["に"],["注がれる","そそがれる"],["の"],["です"],["」"],["。"]]}]
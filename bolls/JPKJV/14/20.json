[{"verse":1,"text":"この後,のちモアブびと、アンモンびとおよびメウニびとらがヨシャパテと戦,たたかおうと攻,せめてきた。","tok":[["この"],["後","の"],["ち"],["モアブ"],["び"],["と"],["、"],["アンモン"],["びと"],["および"],["メウニ"],["びと"],["ら"],["が"],["ヨシャパテ"],["と"],["戦おう","たたかおう"],["と"],["攻めて","せめて"],["きた"],["。"]]},{"verse":2,"text":"その時,ときある人,ひとがきて、ヨシャパテに告,つげて言,いった、「海,うみのかなたのエドムから大軍,たいぐんがあなたに攻,せめて来,きます。見,みよ、彼,かれらはハザゾン・タマル（すなわちエンゲデ）にいます」。","tok":[["その"],["時","とき"],["ある"],["人","ひと"],["が"],["きて"],["、"],["ヨシャパテ"],["に"],["告","つげ"],["て"],["言った","いった"],["、"],["「"],["海","うみ"],["の"],["かなた"],["の"],["エドム"],["から"],["大軍","たいぐん"],["が"],["あなた"],["に"],["攻めて","せめて"],["来ます","きます"],["。"],["見よ","みよ"],["、"],["彼","かれ"],["ら"],["は"],["ハザゾン"],["・"],["タマル"],["（"],["すなわち"],["エンゲデ"],["）"],["に"],["います"],["」"],["。"]]},{"verse":3,"text":"そこでヨシャパテは恐,おそれ、主,しゅに顔,かおを向,むけて助,たすけを求,もとめ、ユダ全国,ぜんこくに断食,だんじきをふれさせた。","tok":[["そこ"],["で"],["ヨシャパテ"],["は"],["恐","おそれ"],["、"],["主に","しゅに"],["顔","かお"],["を"],["向けて","むけて"],["助け","たすけ"],["を"],["求め","もとめ"],["、"],["ユダ"],["全国","ぜんこく"],["に"],["断食","だんじき"],["を"],["ふれさせた"],["。"]]},{"verse":4,"text":"それでユダはこぞって集,あつまり、主,しゅの助,たすけを求,もとめた。すなわちユダのすべての町,まちから人々,ひとびとが来,きて主,しゅを求,もとめた。","tok":[["それ"],["で"],["ユダ"],["は"],["こぞって"],["集まり","あつまり"],["、"],["主","しゅ"],["の"],["助け","たすけ"],["を"],["求めた","もとめた"],["。"],["すなわち"],["ユダ"],["の"],["すべて"],["の"],["町","まち"],["から"],["人々","ひとびと"],["が"],["来て","きて"],["主","しゅ"],["を"],["求めた","もとめた"],["。"]]},{"verse":5,"text":"そこでヨシャパテは主,しゅの宮,みやの新,あたらしい庭,にわの前,まえで、ユダとエルサレムの会衆,かいしゅうの中,なかに立,たって、","tok":[["そこ"],["で"],["ヨシャパテ"],["は"],["主","しゅ"],["の"],["宮","みや"],["の"],["新らしい","あたらしい"],["庭","にわ"],["の"],["前","まえ"],["で"],["、"],["ユダ"],["と"],["エルサレム"],["の"],["会衆","かいしゅう"],["の"],["中","なか"],["に"],["立って","たって"],["、"]]},{"verse":6,"text":"言,いった、「われわれの先祖,せんぞの神,かみ、主,しゅよ、あなたは天,てんにいます神,かみではありませんか。異邦人,いほうじんのすべての国,くにを治,おさめられるではありませんか。あなたの手,てには力,ちからがあり、勢,いきおいがあって、あなたに逆,さからいうる者,ものはありません。","tok":[["言った","いった"],["、"],["「"],["われわれ"],["の"],["先祖","せんぞ"],["の"],["神","かみ"],["、"],["主","しゅ"],["よ"],["、"],["あなた"],["は"],["天","てん"],["に"],["います"],["神","かみ"],["で"],["は"],["ありません"],["か"],["。"],["異邦人","いほうじん"],["の"],["すべて"],["の"],["国","くに"],["を"],["治められるで","おさめられるで"],["は"],["ありません"],["か"],["。"],["あなた"],["の"],["手","て"],["に"],["は"],["力","ちから"],["が"],["あり"],["、"],["勢い","いきおい"],["が"],["あって"],["、"],["あなた"],["に"],["逆らい","さからい"],["うる"],["者","もの"],["は"],["ありません"],["。"]]},{"verse":7,"text":"われわれの神,かみよ、あなたはこの国,くにの民,たみをあなたの民,たみイスラエルの前,まえから追,おい払,はらって、あなたの友,ともアブラハムの子孫,しそんに、これを永遠,えいえんに与,あたえられたではありませんか。","tok":[["われわれ"],["の"],["神","かみ"],["よ"],["、"],["あなた"],["は"],["この"],["国","くに"],["の"],["民","たみ"],["を"],["あなた"],["の"],["民","たみ"],["イスラエル"],["の"],["前","まえ"],["から"],["追い払って","おいはらって"],["、"],["あなた"],["の"],["友","とも"],["アブラハム"],["の"],["子孫","しそん"],["に"],["、"],["これ"],["を"],["永遠","えいえん"],["に"],["与えられたで","あたえられたで"],["は"],["ありません"],["か"],["。"]]},{"verse":8,"text":"彼,かれらはここに住,すみ、あなたの名,なのためにここに聖所,せいじょを建,たてて言,いいました、","tok":[["彼","かれ"],["ら"],["は"],["ここ"],["に"],["住み","すみ"],["、"],["あなた"],["の"],["名","な"],["の"],["ため"],["に"],["ここ"],["に"],["聖","せい"],["所","しょ"],["を"],["建てて","たてて"],["言いました","いいました"],["、"]]},{"verse":9,"text":"『つるぎ、審判,しんぱん、疫病,えきびょう、ききんなどの災,わざわいがわれわれに臨,のぞむ時,とき、われわれはこの宮,みやの前,まえに立,たって、あなたの前,まえにおり、その悩,なやみの中,なかであなたに呼,よばわります。すると、あなたは聞,きいて助,たすけられます。あなたの名,なはこの宮,みやにあるからです』と。","tok":[["『"],["つるぎ"],["、"],["審判","しんぱん"],["、"],["疫病","え"],["き"],["びょう"],["、"],["ききん"],["など"],["の"],["災","わざわい"],["が"],["われわれ"],["に"],["臨む","のぞむ"],["時","とき"],["、"],["われわれ"],["は"],["この"],["宮","みや"],["の"],["前","まえ"],["に"],["立って","たって"],["、"],["あなた"],["の"],["前","まえ"],["に"],["おり"],["、"],["その"],["悩み","なやみ"],["の"],["中","なか"],["で"],["あなた"],["に"],["呼ばわります","よばわります"],["。"],["する"],["と"],["、"],["あなた"],["は"],["聞いて","きいて"],["助けられます","たすけられます"],["。"],["あなた"],["の"],["名","な"],["は"],["この"],["宮","みや"],["に"],["ある"],["から"],["です"],["』"],["と"],["。"]]},{"verse":10,"text":"今,いまアンモン、モアブ、およびセイル山,やまの人々,ひとびとをごらんなさい。昔,むかしイスラエルがエジプトの国,くにから出,でてきた時,とき、あなたはイスラエルに彼,かれらを侵,おかすことをゆるされなかったので、イスラエルは彼,かれらを離,はなれて、滅,ほろぼしませんでした。","tok":[["今","いま"],["アンモン"],["、"],["モアブ"],["、"],["および"],["セイル山","せいるやま"],["の"],["人々","ひとびと"],["を"],["ごらん"],["なさい"],["。"],["昔","むかし"],["イスラエル"],["が"],["エジプト"],["の"],["国","くに"],["から"],["出て","でて"],["きた"],["時","とき"],["、"],["あなた"],["は"],["イスラエル"],["に"],["彼","かれ"],["ら"],["を"],["侵す","おかす"],["こと"],["を"],["ゆるされなかった"],["ので"],["、"],["イスラエル"],["は"],["彼","かれ"],["ら"],["を"],["離れて","はなれて"],["、"],["滅ぼしませんでした","ほろぼしませんでした"],["。"]]},{"verse":11,"text":"彼,かれらがわれわれに報,むくいるところをごらんください。彼,かれらは来,きて、あなたがわれわれに賜,たまわったあなたの領地,りょうちからわれわれを追,おい払,はらおうとしています。","tok":[["彼","かれ"],["ら"],["が"],["われわれ"],["に"],["報いる","むくいる"],["ところ"],["を"],["ごらん"],["ください"],["。"],["彼","かれ"],["ら"],["は"],["来て","きて"],["、"],["あなた"],["が"],["われわれ"],["に"],["賜わった","たまわった"],["あなた"],["の"],["領地","りょうち"],["から"],["われわれ"],["を"],["追い払おう","おいはらおう"],["として"],["います"],["。"]]},{"verse":12,"text":"われわれの神,かみよ、あなたは彼,かれらをさばかれないのですか。われわれはこのように攻,せめて来,くる大軍,たいぐんに当,あたる力,ちからがなく、またいかになすべきかを知,しりません。ただ、あなたを仰,あおぎ望,のぞむのみです」。","tok":[["われわれ"],["の"],["神","かみ"],["よ"],["、"],["あなた"],["は"],["彼","かれ"],["ら"],["を"],["さばかれない"],["の"],["です"],["か"],["。"],["われわれ"],["は"],["この"],["よう"],["に"],["攻めて","せめて"],["来る","くる"],["大軍","たいぐん"],["に"],["当たる","あたる"],["力","ちから"],["が"],["なく"],["、"],["また"],["いかに"],["なすべき"],["か"],["を"],["知りません","しりません"],["。"],["ただ"],["、"],["あなた"],["を"],["仰ぎ","あおぎ"],["望む","のぞむ"],["のみ"],["です"],["」"],["。"]]},{"verse":13,"text":"ユダの人々,ひとびとはその幼,おさな子,こ、その妻,つま、および子供,こどもたちと共,ともに皆,みな主,しゅの前,まえに立,たっていた。","tok":[["ユダ"],["の"],["人々","ひとびと"],["は"],["その"],["幼な子","おさなこ"],["、"],["その"],["妻","つま"],["、"],["および"],["子供","こども"],["たち"],["と"],["共","とも"],["に"],["皆","みな"],["主","しゅ"],["の"],["前","まえ"],["に"],["立って","たって"],["いた"],["。"]]},{"verse":14,"text":"その時,とき主,しゅの霊,れいが会衆,かいしゅうの中,なかでアサフの子孫,しそんであるレビびとヤハジエルに臨,のぞんだ。ヤハジエルはゼカリヤの子,こ、ゼカリヤはベナヤの子,こ、ベナヤはエイエルの子,こ、エイエルはマッタニヤの子,こである。","tok":[["その"],["時","とき"],["主","しゅ"],["の"],["霊","れい"],["が"],["会衆","かいしゅう"],["の"],["中","なか"],["で"],["アサフ"],["の"],["子孫","しそん"],["で"],["ある"],["レビ"],["びと"],["ヤハジエル"],["に"],["臨んだ","のぞんだ"],["。"],["ヤハジエル"],["は"],["ゼカリヤ"],["の"],["子","こ"],["、"],["ゼカリヤ"],["は"],["ベナヤ"],["の"],["子","こ"],["、"],["ベナヤ"],["は"],["エイエル"],["の"],["子","こ"],["、"],["エイエル"],["は"],["マッタニヤ"],["の"],["子","こ"],["で"],["ある"],["。"]]},{"verse":15,"text":"ヤハジエルは言,いった、「ユダの人々,ひとびと、エルサレムの住民,じゅうみん、およびヨシャパテ王,おうよ、聞,ききなさい。主,しゅはあなたがたにこう仰,おおせられる、『この大軍,たいぐんのために恐,おそれてはならない。おののいてはならない。これはあなたがたの戦,たたかいではなく、主,しゅの戦,たたかいだからである。","tok":[["ヤハジエル"],["は"],["言った","いった"],["、"],["「"],["ユダ"],["の"],["人々","ひとびと"],["、"],["エルサレム"],["の"],["住民","じゅうみん"],["、"],["および"],["ヨシャパテ"],["王","おう"],["よ"],["、"],["聞","きき"],["なさい"],["。"],["主","しゅ"],["は"],["あなた"],["がた"],["に"],["こう"],["仰せられる","おおせられる"],["、"],["『"],["この"],["大軍","たいぐん"],["の"],["ため"],["に"],["恐れて","おそれて"],["は"],["ならない"],["。"],["おののいて"],["は"],["ならない"],["。"],["これ"],["は"],["あなた"],["がた"],["の"],["戦い","たたかい"],["で"],["は"],["なく"],["、"],["主","しゅ"],["の"],["戦い","たたかい"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":16,"text":"あす、彼,かれらの所,ところへ攻,せめ下,くだりなさい。見,みよ、彼,かれらはヂヅの坂,さかから上,のぼって来,くる。あなたがたはエルエルの野,のの東,ひがし、谷,たにの端,たんでこれに会,あうであろう。","tok":[["あす"],["、"],["彼","かれ"],["ら"],["の"],["所","ところ"],["へ"],["攻め下り","せめくだり"],["なさい"],["。"],["見よ","みよ"],["、"],["彼","かれ"],["ら"],["は"],["ヂヅ"],["の"],["坂","さか"],["から"],["上って","のぼって"],["来る","くる"],["。"],["あなた"],["がた"],["は"],["エルエル"],["の"],["野","の"],["の"],["東","ひがし"],["、"],["谷","たに"],["の"],["端","たんでこれ"],["に"],["会うで","あうで"],["あろう"],["。"]]},{"verse":17,"text":"この戦,たたかいには、あなたがたは戦,たたかうに及,およばない。ユダおよびエルサレムよ、あなたがたは進,すすみ出,でて立,たち、あなたがたと共,ともにおられる主,しゅの勝利,しょうりを見,みなさい。恐,おそれてはならない。おののいてはならない。あす、彼,かれらの所,ところに攻,せめて行,いきなさい。主,しゅはあなたがたと共,ともにおられるからである』」。","tok":[["この"],["戦い","たたかい"],["に"],["は"],["、"],["あなた"],["がた"],["は"],["戦う","たたかう"],["に"],["及ばない","およばない"],["。"],["ユダ"],["および"],["エルサレム"],["よ"],["、"],["あなた"],["がた"],["は"],["進み出て","すすみでて"],["立ち","たち"],["、"],["あなた"],["がた"],["と"],["共","とも"],["に"],["おられる"],["主","しゅ"],["の"],["勝利","しょうり"],["を"],["見","み"],["なさい"],["。"],["恐れて","おそれて"],["は"],["ならない"],["。"],["おののいて"],["は"],["ならない"],["。"],["あす"],["、"],["彼","かれ"],["ら"],["の"],["所","ところ"],["に"],["攻めて","せめて"],["行き","いき"],["なさい"],["。"],["主","しゅ"],["は"],["あなた"],["がた"],["と"],["共","とも"],["に"],["おられる"],["から"],["で"],["ある"],["』"],["」"],["。"]]},{"verse":18,"text":"ヨシャパテは地,ちにひれ伏,ふした。ユダの人々,ひとびとおよびエルサレムの民,たみも主,しゅの前,まえに伏,ふして、主,しゅを拝,はいした。","tok":[["ヨシャパテ"],["は"],["地","ち"],["に"],["ひれ伏した","ひれふした"],["。"],["ユダ"],["の"],["人々","ひとびと"],["および"],["エルサレム"],["の"],["民","たみ"],["も"],["主","しゅ"],["の"],["前","まえ"],["に"],["伏して","ふして"],["、"],["主","しゅ"],["を"],["拝した","はいした"],["。"]]},{"verse":19,"text":"その時,ときコハテびとの子孫,しそん、およびコラびとの子孫,しそんであるレビびとが立,たち上,あがり、大声,おおごえをあげてイスラエルの神,かみ、主,しゅをさんびした。","tok":[["その"],["時","とき"],["コハテ"],["びと"],["の"],["子孫","しそん"],["、"],["および"],["コラ"],["びと"],["の"],["子孫","しそん"],["で"],["ある"],["レビ"],["びと"],["が"],["立ち上がり","たちあがり"],["、"],["大声","おおごえ"],["を"],["あげて"],["イスラエル"],["の"],["神","かみ"],["、"],["主","しゅ"],["を"],["さん"],["び"],["した"],["。"]]},{"verse":20,"text":"彼,かれらは朝,あさ早,はやく起,おきてテコアの野,のに出,でて行,いった。その出,でて行,いくとき、ヨシャパテは立,たって言,いった、「ユダの人々,ひとびとおよびエルサレムの民,たみよ、わたしに聞,ききなさい。あなたがたの神,かみ、主,しゅを信,しんじなさい。そうすればあなたがたは堅,かたく立,たつことができる。主,しゅの預言者,よげんしゃを信,しんじなさい。そうすればあなたがたは成功,せいこうするでしょう」。","tok":[["彼","かれ"],["ら"],["は"],["朝","あさ"],["早く","はやく"],["起きて","おきて"],["テコア"],["の"],["野","の"],["に"],["出て","でて"],["行った","いった"],["。"],["その"],["出て","でて"],["行く","いく"],["とき"],["、"],["ヨシャパテ"],["は"],["立って","たって"],["言った","いった"],["、"],["「"],["ユダ"],["の"],["人々","ひとびと"],["および"],["エルサレム"],["の"],["民","たみ"],["よ"],["、"],["わたし"],["に"],["聞","きき"],["なさい"],["。"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["を"],["信じ","しんじ"],["なさい"],["。"],["そう"],["すれば"],["あなた"],["がた"],["は"],["堅く","かたく"],["立つ","たつ"],["こと"],["が"],["できる"],["。"],["主","しゅ"],["の"],["預言者","よげんしゃ"],["を"],["信じ","しんじ"],["なさい"],["。"],["そう"],["すれば"],["あなた"],["がた"],["は"],["成功","せいこう"],["するでしょう"],["」"],["。"]]},{"verse":21,"text":"彼,かれはまた民,たみと相談,そうだんして人々,ひとびとを任命,にんめいし、聖,せいなる飾,かざりを着,つけて軍勢,ぐんぜいの前,まえに進,すすませ、主,しゅに向,むかって歌,うたをうたい、かつさんびさせ、「主,しゅに感謝,かんしゃせよ、そのいつくしみはとこしえに絶,たえることがない」と言,いわせた。","tok":[["彼","かれ"],["は"],["また"],["民","たみ"],["と"],["相談","そうだん"],["して"],["人々","ひとびと"],["を"],["任命","にんめい"],["し"],["、"],["聖","せい"],["なる"],["飾","かざり"],["を"],["着けて","つけて"],["軍勢","ぐんぜい"],["の"],["前","まえ"],["に"],["進ませ","すすませ"],["、"],["主に","しゅに"],["向かって","むかって"],["歌","うた"],["を"],["うたい"],["、"],["かつ"],["さん"],["び"],["させ"],["、"],["「"],["主に","しゅに"],["感謝","かんしゃ"],["せよ"],["、"],["その"],["いつくしみ"],["は"],["とこしえ"],["に"],["絶える","たえる"],["こと"],["が"],["ない"],["」"],["と"],["言わせた","いわせた"],["。"]]},{"verse":22,"text":"そして彼,かれらが歌,うたをうたい、さんびし始,はじめた時,とき、主,しゅは伏兵,ふくへいを設,もうけ、かのユダに攻,せめてきたアンモン、モアブ、セイル山,やまの人々,ひとびとに向,むかわせられたので、彼,かれらは打,うち敗,やぶられた。","tok":[["そして"],["彼","かれ"],["ら"],["が"],["歌","うた"],["を"],["うたい"],["、"],["さん"],["び"],["し"],["始めた","はじめた"],["時","とき"],["、"],["主","しゅ"],["は"],["伏兵","ふくへい"],["を"],["設け","もうけ"],["、"],["かの"],["ユダ"],["に"],["攻めて","せめて"],["きた"],["アンモン"],["、"],["モアブ"],["、"],["セイル山","せいるやま"],["の"],["人々","ひとびと"],["に"],["向かわせられた","むかわせられた"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["打ち","うち"],["敗られた","やぶられた"],["。"]]},{"verse":23,"text":"すなわちアンモンとモアブの人々,ひとびとは立,たち上,あがって、セイル山,やまの民,たみに敵,てきし、彼,かれらを殺,ころして全,まったく滅,ほろぼしたが、セイルの民,たみを殺,ころし尽,つくすに及,およんで、彼,かれらもおのおの互,たがいに助,たすけて滅,ほろぼしあった。","tok":[["すなわち"],["アンモン"],["と"],["モアブ"],["の"],["人々","ひとびと"],["は"],["立ち上がって","たちあがって"],["、"],["セイル山","せいるやま"],["の"],["民","たみ"],["に"],["敵し","てきし"],["、"],["彼","かれ"],["ら"],["を"],["殺ろして","ころして"],["全く","まったく"],["滅ぼした","ほろぼした"],["が"],["、"],["セイル"],["の"],["民","たみ"],["を"],["殺ろし","ころし"],["尽くす","つくす"],["に"],["及んで","およんで"],["、"],["彼","かれ"],["ら"],["も"],["おのおの"],["互","たがい"],["に"],["助けて","たすけて"],["滅ぼし","ほろぼし"],["あった"],["。"]]},{"verse":24,"text":"ユダの人々,ひとびとは野,のの物見,ものみやぐらへ行,いって、かの群衆,ぐんしゅうを見,みたが、地,ちに倒,たおれた死体,したいだけであって、ひとりものがれた者,ものはなかった。","tok":[["ユダ"],["の"],["人々","ひとびと"],["は"],["野","の"],["の"],["物見","ものみ"],["やぐら"],["へ"],["行って","いって"],["、"],["かの"],["群衆","ぐんしゅう"],["を"],["見た","みた"],["が"],["、"],["地","ち"],["に"],["倒れた","たおれた"],["死体","したい"],["だけ"],["で"],["あって"],["、"],["ひとり"],["も"],["のがれた"],["者","もの"],["は"],["なかった"],["。"]]},{"verse":25,"text":"それでヨシャパテとその民,たみは彼,かれらの物,ものを奪,うばうために来,きて見,みると、多数,たすうの家畜,かちく、財宝,ざいほう、衣服,いふくおよび宝石,ほうせきなどおびただしくあったので、おのおのそれをはぎ取,とったが、運,はこびきれないほどたくさんで、かすめ取,とるに三日,かもかかった。それほど物,ものが多,おおかったのである。","tok":[["それ"],["で"],["ヨシャパテ"],["と"],["その"],["民","たみ"],["は"],["彼","かれ"],["ら"],["の"],["物","もの"],["を"],["奪う","うばう"],["ため"],["に"],["来て","きて"],["見る","みる"],["と"],["、"],["多数","たすう"],["の"],["家畜","かちく"],["、"],["財宝","ざいほう"],["、"],["衣服","いふく"],["および"],["宝石","ほうせき"],["など"],["おびただしく"],["あった"],["ので"],["、"],["おのおの"],["それ"],["を"],["はぎ取った","はぎとった"],["が"],["、"],["運こび","はこび"],["きれない"],["ほど"],["たくさん"],["で"],["、"],["かすめ取る","かすめとる"],["に"],["三日","か"],["も"],["かかった"],["。"],["それ"],["ほど"],["物","もの"],["が"],["多かった","おおかった"],["ので"],["ある"],["。"]]},{"verse":26,"text":"四日,か目,めに彼,かれらはベラカの谷,たにに集,あつまり、その所,ところで主,しゅを祝福,しゅくふくした。それでその所,ところの名,なを今日,こんにちまでベラカの谷,たにと呼,よんでいる。","tok":[["四日目","かめ"],["に"],["彼","かれ"],["ら"],["は"],["ベラカ"],["の"],["谷","たに"],["に"],["集まり","あつまり"],["、"],["その"],["所","ところ"],["で"],["主","しゅ"],["を"],["祝福","しゅくふく"],["した"],["。"],["それ"],["で"],["その"],["所","ところ"],["の"],["名","な"],["を"],["今日","こん"],["に"],["ち"],["まで"],["ベラカ"],["の"],["谷","たに"],["と"],["呼んで","よんで"],["いる"],["。"]]},{"verse":27,"text":"そしてユダとエルサレムの人々,ひとびとは皆,みなヨシャパテを先,さきに立,たて、喜,よろこんでエルサレムに帰,かえってきた。主,しゅが彼,かれらにその敵,てきのことによって喜,よろこびを与,あたえられたからである。","tok":[["そして"],["ユダ"],["と"],["エルサレム"],["の"],["人々","ひとびと"],["は"],["皆","みな"],["ヨシャパテ"],["を"],["先","さき"],["に"],["立て","たて"],["、"],["喜こんで","よろこんで"],["エルサレム"],["に"],["帰えって","かえって"],["きた"],["。"],["主","しゅ"],["が"],["彼","かれ"],["ら"],["に"],["その"],["敵","てき"],["の"],["こと"],["によって"],["喜こび","よろこび"],["を"],["与えられた","あたえられた"],["から"],["で"],["ある"],["。"]]},{"verse":28,"text":"すなわち彼,かれらは立琴,たてごと、琴,ことおよびラッパをもってエルサレムの主,しゅの宮,みやに来,きた。","tok":[["すなわち"],["彼","かれ"],["ら"],["は"],["立琴","たてごと"],["、"],["琴","こと"],["および"],["ラッパ"],["を"],["もって"],["エルサレム"],["の"],["主","しゅ"],["の"],["宮","みや"],["に"],["来た","きた"],["。"]]},{"verse":29,"text":"そしてもろもろの国,くにの民,たみは主,しゅがイスラエルの敵,てきと戦,たたかわれたことを聞,きいて神,かみを恐,おそれた。","tok":[["そして"],["もろもろ"],["の"],["国","くに"],["の"],["民","たみ"],["は"],["主","しゅ"],["が"],["イスラエル"],["の"],["敵","てき"],["と"],["戦われた","たたかわれた"],["こと"],["を"],["聞いて","きいて"],["神","かみ"],["を"],["恐れた","おそれた"],["。"]]},{"verse":30,"text":"こうして神,かみが四方,しほうに安息,あんそくを賜,たまわったので、ヨシャパテの国,くには穏,おだやかであった。","tok":[["こう"],["して"],["神","かみ"],["が"],["四方","しほう"],["に"],["安息","あんそく"],["を"],["賜わった","たまわった"],["ので"],["、"],["ヨシャパテ"],["の"],["国","くに"],["は"],["穏","おだやか"],["で"],["あった"],["。"]]},{"verse":31,"text":"このようにヨシャパテはユダを治,おさめた。彼,かれは三十五歳,さいの時,とき、王,おうとなり、二十五年,ねんの間,あいだエルサレムで世,よを治,おさめた。彼,かれの母,ははの名,なはアズバといってシルヒの娘,むすめである。","tok":[["この"],["よう"],["に"],["ヨシャパテ"],["は"],["ユダ"],["を"],["治めた","おさめた"],["。"],["彼","かれ"],["は"],["三十五歳","さい"],["の"],["時","とき"],["、"],["王","おう"],["と"],["なり"],["、"],["二十五","にじゅうご"],["年","ねん"],["の"],["間","あいだ"],["エルサレム"],["で"],["世","よ"],["を"],["治めた","おさめた"],["。"],["彼","かれ"],["の"],["母","はは"],["の"],["名","な"],["は"],["アズバ"],["と"],["いって"],["シルヒ"],["の"],["娘","むすめ"],["で"],["ある"],["。"]]},{"verse":32,"text":"ヨシャパテは父,ちちアサの道,みちを歩,あゆんでそれを離,はなれず、主,しゅの目,めに正,ただしいと見,みられることを行,おこなった。","tok":[["ヨシャパテ"],["は"],["父","ちち"],["アサ"],["の"],["道","みち"],["を"],["歩んで","あゆんで"],["それ"],["を"],["離れず","はなれず"],["、"],["主","しゅ"],["の"],["目","め"],["に"],["正い","ただしい"],["と"],["見られる","みられる"],["こと"],["を"],["行なった","おこなった"],["。"]]},{"verse":33,"text":"しかし高,たかき所,ところは除,のぞかず、また民,たみはその先祖,せんぞの神,かみに心,こころを傾,かたむけなかった。","tok":[["しかし"],["高き","たかき"],["所","ところ"],["は"],["除かず","のぞかず"],["、"],["また"],["民","たみ"],["は"],["その"],["先祖","せんぞ"],["の"],["神","かみ"],["に"],["心","こころ"],["を"],["傾むけなかった","かたむけなかった"],["。"]]},{"verse":34,"text":"ヨシャパテのその他,たの始終,しじゅうの行為,こういは、ハナニの子,こエヒウの書,しょにしるされ、イスラエルの列,れつ王,おうの書,しょに載,のせられてある。","tok":[["ヨシャパテ"],["の"],["その"],["他","た"],["の"],["始終","しじゅう"],["の"],["行為","こうい"],["は"],["、"],["ハナニ"],["の"],["子","こ"],["エヒウ"],["の"],["書","しょ"],["に"],["しるされ"],["、"],["イスラエル"],["の"],["列王","れつおう"],["の"],["書","しょ"],["に"],["載せられて","のせられて"],["ある"],["。"]]},{"verse":35,"text":"この後,のちユダの王,おうヨシャパテはイスラエルの王,おうアハジヤと相,あい結,むすんだ。アハジヤは悪,あくを行,おこなった。","tok":[["この"],["後","の"],["ち"],["ユダ"],["の"],["王","おう"],["ヨシャパテ"],["は"],["イスラエル"],["の"],["王","おう"],["アハジヤ"],["と"],["相","あ"],["い"],["結んだ","むすんだ"],["。"],["アハジヤ"],["は"],["悪","あく"],["を"],["行なった","おこなった"],["。"]]},{"verse":36,"text":"ヨシャパテはタルシシへ行,いく船,ふねを造,つくるためにアハジヤと相,あい結,むすび、エジオン・ゲベルで一緒,いっしょに船,ふね数隻,すうせきを造,つくった。","tok":[["ヨシャパテ"],["は"],["タルシシ"],["へ"],["行く","いく"],["船","ふね"],["を"],["造る","つくる"],["ため"],["に"],["アハジヤ"],["と"],["相","あ"],["い"],["結び","むすび"],["、"],["エジオン"],["・"],["ゲベル"],["で"],["一緒","いっしょ"],["に"],["船数隻","ふねすうせき"],["を"],["造った","つくった"],["。"]]},{"verse":37,"text":"その時,ときマレシャのドダワの子,こエリエゼルはヨシャパテに向,むかって預言,よげんし、「あなたはアハジヤと相,あい結,むすんだので、主,しゅはあなたの造,つくった物,ものをこわされます」と言,いったが、その船,ふねは難破,なんぱして、タルシシへ行,いくことができなかった。","tok":[["その"],["時","とき"],["マレシャ"],["の"],["ドダワ"],["の"],["子","こ"],["エリエゼル"],["は"],["ヨシャパテ"],["に"],["向かって","むかって"],["預言","よげん"],["し"],["、"],["「"],["あなた"],["は"],["アハジヤ"],["と"],["相","あ"],["い"],["結","むすんだ"],["ので"],["、"],["主","しゅ"],["は"],["あなた"],["の"],["造った","つくった"],["物","もの"],["を"],["こわされます"],["」"],["と"],["言った","いった"],["が"],["、"],["その"],["船","ふね"],["は"],["難破","なんぱ"],["して"],["、"],["タルシシ"],["へ"],["行く","いく"],["こと"],["が"],["できなかった"],["。"]]}]
[{"verse":1,"text":"ヒゼキヤはイスラエルとユダにあまねく人,ひとをつかわし、また手紙,てがみをエフライムとマナセに書,かき送,おくり、エルサレムにある主,しゅの宮,みやに来,きて、イスラエルの神,かみ、主,しゅに過越,すぎこしの祭,まつりを行,おこなうように勧,すすめた。","tok":[["ヒゼキヤ"],["は"],["イスラエル"],["と"],["ユダ"],["に"],["あまねく"],["人","ひと"],["を"],["つかわし"],["、"],["また"],["手紙","てがみ"],["を"],["エフライム"],["と"],["マナセ"],["に"],["書き送り","かきおくり"],["、"],["エルサレム"],["に"],["ある"],["主","しゅ"],["の"],["宮","みや"],["に"],["来て","きて"],["、"],["イスラエル"],["の"],["神","かみ"],["、"],["主に","しゅに"],["過越","すぎこし"],["の"],["祭","まつり"],["を"],["行なう","おこなう"],["よう"],["に"],["勧めた","すすめた"],["。"]]},{"verse":2,"text":"王,おうはすでにつかさたちおよびエルサレムにおる全,ぜん会衆,かいしゅうに計,はかって、二月,がつに過越,すぎこしの祭,まつりを行,おこなうことを定,さだめた。","tok":[["王","おう"],["は"],["すでに"],["つかさ"],["たち"],["および"],["エルサレム"],["に"],["おる"],["全","ぜん"],["会衆","かいしゅう"],["に"],["計って","はかって"],["、"],["二","に"],["月","がつ"],["に"],["過越","すぎこし"],["の"],["祭","まつり"],["を"],["行なう","おこなう"],["こと"],["を"],["定めた","さだめた"],["。"]]},{"verse":3,"text":"――これは身,みを清,きよめた祭司,さいしの数,かずが足,たらず、民,たみもまた、エルサレムに集,あつまらなかったので、正月,しょうがつにこれを行,おこなうことができなかったからである――","tok":[["―"],["―"],["これ"],["は"],["身","み"],["を"],["清めた","きよめた"],["祭司","さいし"],["の"],["数","かず"],["が"],["足らず","たらず"],["、"],["民","たみ"],["も"],["また"],["、"],["エルサレム"],["に"],["集まらなかった","あつまらなかった"],["ので"],["、"],["正月","しょうがつ"],["に"],["これ"],["を"],["行なう","おこなう"],["こと"],["が"],["できなかった"],["から"],["で"],["ある"],["―"],["―"]]},{"verse":4,"text":"この事,ことが、王,おうにも全,ぜん会衆,かいしゅうにも良,よかったので、","tok":[["この"],["事","こと"],["が"],["、"],["王","おう"],["に"],["も"],["全","ぜん"],["会衆","かいしゅう"],["に"],["も"],["良かった","よかった"],["ので"],["、"]]},{"verse":5,"text":"この事,ことを定,さだめて、ベエルシバからダンまでイスラエルにあまねくふれ示,しめし、エルサレムに来,きて、イスラエルの神,かみ、主,しゅに過越,すぎこしの祭,まつりを行,おこなうことを勧,すすめた。これはしるされているように、これを行,おこなう者,ものが多,おおくなかったゆえである。","tok":[["この"],["事","こと"],["を"],["定めて","さだめて"],["、"],["ベエルシバ"],["から"],["ダン"],["まで"],["イスラエル"],["に"],["あまねく"],["ふれ"],["示めし","しめし"],["、"],["エルサレム"],["に"],["来て","きて"],["、"],["イスラエル"],["の"],["神","かみ"],["、"],["主に","しゅに"],["過越","すぎこし"],["の"],["祭","まつり"],["を"],["行なう","おこなう"],["こと"],["を"],["勧めた","すすめた"],["。"],["これ"],["は"],["しるされて"],["いる"],["よう"],["に"],["、"],["これ"],["を"],["行なう","おこなう"],["者","もの"],["が"],["多く","おおく"],["なかった"],["ゆえ"],["で"],["ある"],["。"]]},{"verse":6,"text":"そこで飛脚,ひきゃくたちは、王,おうとそのつかさたちから受,うけた手紙,てがみをもって、イスラエルとユダをあまねく行,いき巡,めぐり、王,おうの命,いのちを伝,つたえて言,いった、「イスラエルの人々,ひとびとよ、あなたがたはアブラハム、イサク、イスラエルの神,かみ、主,しゅに立,たち返,かえりなさい。そうすれば主,しゅは、アッスリヤの王,おうたちの手,てからのがれた残,のこりのあなたがたに、帰,かえられるでしょう。","tok":[["そこ"],["で"],["飛脚","ひきゃく"],["たち"],["は"],["、"],["王","おう"],["と"],["その"],["つかさ"],["たち"],["から"],["受けた","うけた"],["手紙","てがみ"],["を"],["もって"],["、"],["イスラエル"],["と"],["ユダ"],["を"],["あまねく"],["行き","いき"],["巡り","めぐり"],["、"],["王","おう"],["の"],["命","いのち"],["を"],["伝えて","つたえて"],["言った","いった"],["、"],["「"],["イスラエル"],["の"],["人々","ひとびと"],["よ"],["、"],["あなた"],["がた"],["は"],["アブラハム"],["、"],["イサク"],["、"],["イスラエル"],["の"],["神","かみ"],["、"],["主に","しゅに"],["立ち返り","たちかえり"],["なさい"],["。"],["そう"],["すれば"],["主","しゅ"],["は"],["、"],["アッスリヤ"],["の"],["王","おう"],["たち"],["の"],["手","て"],["から"],["のがれた"],["残り","のこり"],["の"],["あなた"],["がた"],["に"],["、"],["帰えられるでしょう","かえられるでしょう"],["。"]]},{"verse":7,"text":"あなたがたの父,ちちたちおよび兄弟,きょうだいたちのようになってはならない。彼,かれらはその先祖,せんぞたちの神,かみ、主,しゅにむかって罪,つみを犯,おかしたので、あなたがたの見,みるように主,しゅは彼,かれらを滅,ほろびに渡,わたされたのです。","tok":[["あなた"],["がた"],["の"],["父","ちち"],["たち"],["および"],["兄弟","きょうだい"],["たち"],["の"],["よう"],["に"],["なって"],["は"],["ならない"],["。"],["彼","かれ"],["ら"],["は"],["その"],["先祖","せんぞ"],["たち"],["の"],["神","かみ"],["、"],["主に","しゅに"],["むかって"],["罪","つみ"],["を"],["犯した","おかした"],["ので"],["、"],["あなた"],["がた"],["の"],["見る","みる"],["よう"],["に"],["主","しゅ"],["は"],["彼","かれ"],["ら"],["を"],["滅び","ほろび"],["に"],["渡された","わたされた"],["の"],["です"],["。"]]},{"verse":8,"text":"あなたがたの父,ちちたちのように強情,ごうじょうにならないで、主,しゅに帰服,きふくし、主,しゅがとこしえに聖別,せいべつされた聖所,せいじょに入,いり、あなたがたの神,かみ、主,しゅに仕,つかえなさい。そうすれば、その激,はげしい怒,いかりがあなたがたを離,はなれるでしょう。","tok":[["あなた"],["がた"],["の"],["父","ちち"],["たち"],["の"],["よう"],["に"],["強情","ごうじょう"],["に"],["ならないで"],["、"],["主に","しゅに"],["帰服","きふく"],["し"],["、"],["主","しゅ"],["が"],["とこしえ"],["に"],["聖別","せいべつ"],["された"],["聖所","せいじょ"],["に"],["入","いり"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主に","しゅに"],["仕え","つかえ"],["なさい"],["。"],["そう"],["すれば"],["、"],["その"],["激しい","はげしい"],["怒り","いかり"],["が"],["あなた"],["がた"],["を"],["離れるでしょう","はなれるでしょう"],["。"]]},{"verse":9,"text":"もしあなたがたが主,しゅに立,たち返,かえるならば、あなたがたの兄弟,きょうだいおよび子供,こどもは、これを捕,とらえていった者,ものの前,まえにあわれみを得,えて、この国,くにに帰,かえることができるでしょう。あなたがたの神,かみ、主,しゅは恵,めぐみあり、あわれみある方,かたであられるゆえ、あなたがたが彼,かれに立,たち返,かえるならば、顔,かおをあなたがたにそむけられることはありません」。","tok":[["もし"],["あなた"],["がた"],["が"],["主に","しゅに"],["立ち返るならば","たちかえるならば"],["、"],["あなた"],["がた"],["の"],["兄弟","きょうだい"],["および"],["子供","こども"],["は"],["、"],["これ"],["を"],["捕らえて","とらえて"],["いった"],["者","もの"],["の"],["前","まえ"],["に"],["あわれみ"],["を"],["得て","えて"],["、"],["この"],["国","くに"],["に"],["帰える","かえる"],["こと"],["が"],["できるでしょう"],["。"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["恵","めぐみ"],["あり"],["、"],["あわれみ"],["ある"],["方","かた"],["で"],["あられる"],["ゆえ"],["、"],["あなた"],["がた"],["が"],["彼","かれ"],["に"],["立ち返るならば","たちかえるならば"],["、"],["顔","かお"],["を"],["あなた"],["がた"],["に"],["そむけられる"],["こと"],["は"],["ありません"],["」"],["。"]]},{"verse":10,"text":"このように飛脚,ひきゃくたちは、エフライムとマナセの国,くににはいって、町,まちから町,まちに行,いき巡,めぐり、ついに、ゼブルンまで行,いったが、人々,ひとびとはこれをあざけり笑,わらった。","tok":[["この"],["よう"],["に"],["飛脚","ひきゃく"],["たち"],["は"],["、"],["エフライム"],["と"],["マナセ"],["の"],["国","くに"],["に"],["はいって"],["、"],["町","まち"],["から"],["町","まち"],["に"],["行き","いき"],["巡り","めぐり"],["、"],["ついに"],["、"],["ゼブルン"],["まで"],["行った","いった"],["が"],["、"],["人々","ひとびと"],["は"],["これ"],["を"],["あざけり笑った","あざけりわらった"],["。"]]},{"verse":11,"text":"ただしアセル、マナセ、ゼブルンのうちには身,みを低,ひくくして、エルサレムにきた人々,ひとびともあった。","tok":[["ただし"],["アセル"],["、"],["マナセ"],["、"],["ゼブルン"],["の"],["うち"],["に"],["は"],["身","み"],["を"],["低く","ひくく"],["して"],["、"],["エルサレム"],["に"],["きた"],["人々","ひとびと"],["も"],["あった"],["。"]]},{"verse":12,"text":"またユダにおいては神,かみの手,てが人々,ひとびとに一つ心,こころを与,あたえて、王,おうとつかさたちが主,しゅの言葉,ことばによって命,めいじたことを行,おこなわせた。","tok":[["また"],["ユダ"],["に"],["おいて"],["は"],["神","かみ"],["の"],["手","て"],["が"],["人々","ひとびと"],["に"],["一","ひと"],["つ"],["心","こころ"],["を"],["与","あたえ"],["て"],["、"],["王","おう"],["と"],["つかさ"],["たち"],["が"],["主","しゅ"],["の"],["言葉","ことば"],["によって"],["命じた","めいじた"],["こと"],["を"],["行なわせた","おこなわせた"],["。"]]},{"verse":13,"text":"こうして二月,がつになって、多,おおくの民,たみは、種,たね入,いれぬパンの祭,まつりを行,おこなうためエルサレムに集,あつまったが、非常,ひじょうに大,おおきな会衆,かいしゅうであった。","tok":[["こう"],["して"],["二","に"],["月","がつ"],["に"],["なって"],["、"],["多く","おおく"],["の"],["民","たみ"],["は"],["、"],["種","た"],["ね"],["入れぬ","いれぬ"],["パン"],["の"],["祭","まつり"],["を"],["行なう","おこなう"],["ため"],["エルサレム"],["に"],["集まった","あつまった"],["が"],["、"],["非常","ひじょう"],["に"],["大きな","おおきな"],["会衆","かいしゅう"],["で"],["あった"],["。"]]},{"verse":14,"text":"彼,かれらは立,たってエルサレムにあるもろもろの祭壇,さいだんを取,とり除,のぞき、またすべての香,こうをたく祭壇,さいだんを取,とり除,のぞいてキデロン川,かわに投,なげすて、","tok":[["彼","かれ"],["ら"],["は"],["立って","たって"],["エルサレム"],["に"],["ある"],["もろもろ"],["の"],["祭壇","さいだん"],["を"],["取除き","とりのぞき"],["、"],["また"],["すべて"],["の"],["香","こう"],["を"],["たく"],["祭壇","さいだん"],["を"],["取除いて","とりのぞいて"],["キデロン"],["川","かわ"],["に"],["投","なげ"],["すて"],["、"]]},{"verse":15,"text":"二月,がつの十四日,かに過越,すぎこしの小羊,こひつじをほふった。そこで祭司,さいしたちおよびレビびとはみずから恥,はじ、身,みを清,きよめて主,しゅの宮,みやに燔祭,はんさいを携,たずさえて来,きた。","tok":[["二","に"],["月","がつ"],["の"],["十四日","か"],["に"],["過越","すぎこし"],["の"],["小羊","こひつじ"],["を"],["ほふった"],["。"],["そこ"],["で"],["祭司","さいし"],["たち"],["および"],["レビ"],["び"],["と"],["は"],["みずから"],["恥","はじ"],["、"],["身","み"],["を"],["清めて","きよめて"],["主","しゅ"],["の"],["宮","みや"],["に"],["燔祭","はんさい"],["を"],["携えて","たずさえて"],["来た","きた"],["。"]]},{"verse":16,"text":"彼,かれらは神,かみの人,ひとモーセの律法,りっぽうに従,したがい、いつものようにその所,ところに立,たち、祭司,さいしたちは、レビびとの手,てから血,ちを受,うけて注,そそいだ。","tok":[["彼","かれ"],["ら"],["は"],["神","かみ"],["の"],["人","ひと"],["モーセ"],["の"],["律法","りっぽう"],["に"],["従い","したがい"],["、"],["いつも"],["の"],["よう"],["に"],["その"],["所","ところ"],["に"],["立ち","たち"],["、"],["祭司","さいし"],["たち"],["は"],["、"],["レビ"],["びと"],["の"],["手","て"],["から"],["血","ち"],["を"],["受て","うけて"],["注いだ","そそいだ"],["。"]]},{"verse":17,"text":"時,ときに、会衆,かいしゅうのうちにまだ身,みを清,きよめていない者,ものが多,おおかったので、レビびとはその清,きよくないすべての人々,ひとびとに代,かわって過越,すぎこしの小羊,こひつじをほふり、主,しゅに清,きよめてささげた。","tok":[["時","とき"],["に"],["、"],["会衆","かいしゅう"],["の"],["うち"],["に"],["まだ"],["身","み"],["を"],["清めて","きよめて"],["いない"],["者","もの"],["が"],["多かった","おおかった"],["ので"],["、"],["レビ"],["び"],["と"],["は"],["その"],["清く","きよく"],["ない"],["すべて"],["の"],["人々","ひとびと"],["に"],["代わって","かわって"],["過越","すぎこし"],["の"],["小羊","こひつじ"],["を"],["ほふり"],["、"],["主に","しゅに"],["清めて","きよめて"],["ささげた"],["。"]]},{"verse":18,"text":"多,おおくの民,たみすなわちエフライム、マナセ、イッサカル、ゼブルンからきた多,おおくの者,ものはまだ身,みを清,きよめていないのに、書,かきしるされたとおりにしないで過越,すぎこしの物,ものを食,たべた。それでヒゼキヤは、彼,かれらのために祈,いのって言,いった、「恵,めぐみふかき主,しゅよ、彼,かれらをゆるしてください。","tok":[["多く","おおく"],["の"],["民","たみ"],["すなわち"],["エフライム"],["、"],["マナセ"],["、"],["イッサカル"],["、"],["ゼブルン"],["から"],["きた"],["多く","おおく"],["の"],["者","もの"],["は"],["まだ"],["身","み"],["を"],["清めて","きよめて"],["いない"],["のに"],["、"],["書きしるされた","かきしるされた"],["とおり"],["に"],["しないで"],["過越","すぎこし"],["の"],["物","もの"],["を"],["食べた","たべた"],["。"],["それ"],["で"],["ヒゼキヤ"],["は"],["、"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["祈って","いのって"],["言った","いった"],["、"],["「"],["恵","めぐみ"],["ふ"],["かき"],["主","しゅ"],["よ"],["、"],["彼","かれ"],["ら"],["を"],["ゆるして"],["ください"],["。"]]},{"verse":19,"text":"彼,かれらは聖所,せいじょの清,きよめの規定,きていどおりにしなかったけれども、その心,こころを傾,かたむけて神,かみを求,もとめ、その先祖,せんぞの神,かみ、主,しゅを求,もとめたのです」。","tok":[["彼","かれ"],["ら"],["は"],["聖","せい"],["所","しょ"],["の"],["清め","きよめ"],["の"],["規定","きてい"],["どおり"],["に"],["しなかった"],["けれど"],["も"],["、"],["その"],["心","こころ"],["を"],["傾むけて","かたむけて"],["神","かみ"],["を"],["求め","もとめ"],["、"],["その"],["先祖","せんぞ"],["の"],["神","かみ"],["、"],["主","しゅ"],["を"],["求めた","もとめた"],["の"],["です"],["」"],["。"]]},{"verse":20,"text":"主,しゅはヒゼキヤに聞,きいて、民,たみをいやされた。","tok":[["主","しゅ"],["は"],["ヒゼキヤ"],["に"],["聞いて","きいて"],["、"],["民","たみ"],["を"],["いやされた"],["。"]]},{"verse":21,"text":"そこでエルサレムに来,きていたイスラエルの人々,ひとびとは大,おおいなる喜,よろこびをいだいて、七日,なぬかのあいだ種,たね入,いれぬパンの祭,まつりを行,おこなった。またレビびとと祭司,さいしたちは日々,ひびに主,しゅをさんびし、力,ちからをつくして主,しゅをたたえた。","tok":[["そこ"],["で"],["エルサレム"],["に"],["来て","きて"],["いた"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["大いなる","おおいなる"],["喜こび","よろこび"],["を"],["いだいて"],["、"],["七日","なぬか"],["の"],["あいだ"],["種","た"],["ね"],["入れぬ","いれぬ"],["パン"],["の"],["祭","まつり"],["を"],["行なった","おこなった"],["。"],["また"],["レビ"],["びと"],["と"],["祭司","さいし"],["たち"],["は"],["日々","ひび"],["に"],["主","しゅ"],["を"],["さん"],["びし"],["、"],["力","ちから"],["を"],["つくして"],["主","しゅ"],["を"],["たたえた"],["。"]]},{"verse":22,"text":"そしてヒゼキヤは主,しゅの勤,つとめによく通,つうじているすべてのレビびとを深,ふかくねぎらった。こうして人々,ひとびとは酬恩祭,しゅうおんさいの犠牲,ぎせいをささげ、その先祖,せんぞの神,かみ、主,しゅに感謝,かんしゃして、七日,なぬかのあいだ祭,まつりの供,そなえ物,ものを食,たべた。","tok":[["そして"],["ヒゼキヤ"],["は"],["主","しゅ"],["の"],["勤め","つとめ"],["に"],["よく"],["通じて","つうじて"],["いる"],["すべて"],["の"],["レビ"],["びと"],["を"],["深く","ふかく"],["ねぎらった"],["。"],["こう"],["して"],["人々","ひとびと"],["は"],["酬恩祭","しゅうおんさい"],["の"],["犠牲","ぎせい"],["を"],["ささげ"],["、"],["その"],["先祖","せんぞ"],["の"],["神","かみ"],["、"],["主に","しゅに"],["感謝","かんしゃ"],["して"],["、"],["七日","なぬか"],["の"],["あいだ"],["祭","まつり"],["の"],["供え物","そなえもの"],["を"],["食べた","たべた"],["。"]]},{"verse":23,"text":"なお全,ぜん会衆,かいしゅうは相,あいはかって、さらに七日,なぬかのあいだ祭,まつりを守,まもることを定,さだめ、喜,よろこびをもってまた七日,なぬかのあいだ守,まもった。","tok":[["なお"],["全","ぜん"],["会衆","かいしゅう"],["は"],["相","あい"],["はかって"],["、"],["さらに"],["七日","なぬか"],["の"],["あいだ"],["祭","まつり"],["を"],["守","まもる"],["こと"],["を"],["定め","さだめ"],["、"],["喜こび","よろこび"],["を"],["もって"],["また"],["七日","なぬか"],["の"],["あいだ"],["守った","まもった"],["。"]]},{"verse":24,"text":"時,ときにユダの王,おうヒゼキヤは雄牛,おうし一千頭,とう、羊,ひつじ七千頭,とうを会衆,かいしゅうに贈,おくり、また、つかさたちは雄牛,おうし一千頭,とう、羊,ひつじ一,いち万,まん頭,とうを会衆,かいしゅうに贈,おくった。祭司,さいしもまた多,おおく身,みを清,きよめた。","tok":[["時","とき"],["に"],["ユダ"],["の"],["王","おう"],["ヒゼキヤ"],["は"],["雄牛","おうし"],["一千頭","と"],["う"],["、"],["羊","ひつじ"],["七千頭","とう"],["を"],["会衆","かいしゅう"],["に"],["贈り","おくり"],["、"],["また"],["、"],["つかさ"],["たち"],["は"],["雄牛","おうし"],["一千頭","と"],["う"],["、"],["羊","ひつじ"],["一万頭","いちまんとう"],["を"],["会衆","かいしゅう"],["に"],["贈った","おくった"],["。"],["祭司","さいし"],["も"],["また"],["多く","おおく"],["身","み"],["を"],["清めた","きよめた"],["。"]]},{"verse":25,"text":"ユダの全,ぜん会衆,かいしゅうおよび祭司,さいし、レビびと、ならびにイスラエルからきた全,ぜん会衆,かいしゅう、およびイスラエルの地,ちからきた他国,たこく人,じんと、ユダに住,すむ他国,たこく人,じんは皆,みな喜,よろこんだ。","tok":[["ユダ"],["の"],["全","ぜん"],["会衆","かいしゅう"],["および"],["祭司","さいし"],["、"],["レビ"],["び"],["と"],["、"],["ならびに"],["イスラエル"],["から"],["きた"],["全","ぜん"],["会衆","かいしゅう"],["、"],["および"],["イスラエル"],["の"],["地","ち"],["から"],["きた"],["他国人","たこくじん"],["と"],["、"],["ユダ"],["に"],["住む","すむ"],["他国人","たこくじん"],["は"],["皆","みな"],["喜こんだ","よろこんだ"],["。"]]},{"verse":26,"text":"このようにエルサレムに大,おおいなる喜,よろこびがあった。イスラエルの王,おうダビデの子,こソロモンの時,ときからこのかた、このような事,ことはエルサレムになかった。","tok":[["この"],["よう"],["に"],["エルサレム"],["に"],["大いなる","おおいなる"],["喜こび","よろこび"],["が"],["あった"],["。"],["イスラエル"],["の"],["王","おう"],["ダビデ"],["の"],["子","こ"],["ソロモン"],["の"],["時","とき"],["から"],["このかた"],["、"],["この"],["よう"],["な"],["事","こと"],["は"],["エルサレム"],["に"],["なかった"],["。"]]},{"verse":27,"text":"このとき祭司,さいしたちとレビびとは立,たって、民,たみを祝福,しゅくふくしたが、その声,こえは聞,きかれ、その祈,いのりは主,しゅの聖,せいなるすみかである天,てんに達,たっした。","tok":[["この"],["とき"],["祭司","さいし"],["たち"],["と"],["レビ"],["び"],["と"],["は"],["立って","たって"],["、"],["民","たみ"],["を"],["祝福","しゅくふく"],["した"],["が"],["、"],["その"],["声","こえ"],["は"],["聞かれ","きかれ"],["、"],["その"],["祈","いのり"],["は"],["主","しゅ"],["の"],["聖","せい"],["なる"],["すみか"],["で"],["ある"],["天","てん"],["に"],["達した","たっした"],["。"]]}]
[{"verse":1,"text":"そこでソロモンは言,いった、「主,しゅはみずから濃,こき雲,くもの中,なかに住,すまおうと言,いわれた。","tok":[["そこ"],["で"],["ソロモン"],["は"],["言った","いった"],["、"],["「"],["主","しゅ"],["は"],["みずから"],["濃き","こき"],["雲","くも"],["の"],["中","なか"],["に"],["住まおう","すまおう"],["と"],["言われた","いわれた"],["。"]]},{"verse":2,"text":"しかしわたしはあなたのために高,たかき家,いえ、とこしえのみすまいを建,たてた」。","tok":[["しかし"],["わたし"],["は"],["あなた"],["の"],["ため"],["に"],["高き","たかき"],["家","いえ"],["、"],["とこしえ"],["のみ"],["すまい"],["を"],["建てた","たてた"],["」"],["。"]]},{"verse":3,"text":"そして王,おうは顔,かおをふり向,むけてイスラエルの全,ぜん会衆,かいしゅうを祝福,しゅくふくした。その時,ときイスラエルの全,ぜん会衆,かいしゅうは立,たっていた。","tok":[["そして"],["王","おう"],["は"],["顔","かお"],["を"],["ふり向けて","ふりむけて"],["イスラエル"],["の"],["全","ぜん"],["会衆","かいしゅう"],["を"],["祝福","しゅくふく"],["した"],["。"],["その"],["時","とき"],["イスラエル"],["の"],["全","ぜん"],["会衆","かいしゅう"],["は"],["立って","たって"],["いた"],["。"]]},{"verse":4,"text":"彼,かれは言,いった、「イスラエルの神,かみ、主,しゅはほむべきかな。主,しゅは口,くちをもってわが父,ちちダビデに約束,やくそくされたことを、その手,てをもってなし遂,とげられた。すなわち主,しゅは言,いわれた、","tok":[["彼","かれ"],["は"],["言った","いった"],["、"],["「"],["イスラエル"],["の"],["神","かみ"],["、"],["主","しゅ"],["は"],["ほ"],["むべき"],["か"],["な"],["。"],["主","しゅ"],["は"],["口","くち"],["を"],["もって"],["わが"],["父","ちち"],["ダビデ"],["に"],["約束","やくそく"],["された"],["こと"],["を"],["、"],["その"],["手","て"],["を"],["もって"],["なし遂げられた","なしとげられた"],["。"],["すなわち"],["主","しゅ"],["は"],["言われた","いわれた"],["、"]]},{"verse":5,"text":"『わが民,たみをエジプトの地,ちから導,みちびき出,だした日,ひから、わたしはわが名,なを置,おくべき家,いえを建,たてるために、イスラエルのもろもろの部族,ぶぞくのうちから、どの町,まちをも選,えらんだことがなく、また他,たのだれをもわが民,たみイスラエルの君,きみとして選,えらんだことがない。","tok":[["『"],["わが"],["民","たみ"],["を"],["エジプト"],["の"],["地","ち"],["から"],["導き出した","みちびきだした"],["日","ひ"],["から"],["、"],["わたし"],["は"],["わが"],["名","な"],["を"],["置くべき","おくべき"],["家","いえ"],["を"],["建てる","たてる"],["ため"],["に"],["、"],["イスラエル"],["の"],["もろもろ"],["の"],["部族","ぶぞく"],["の"],["うち"],["から"],["、"],["どの"],["町","まち"],["を"],["も"],["選らんだ","えらんだ"],["こと"],["が"],["なく"],["、"],["また"],["他","た"],["の"],["だれ"],["を"],["も"],["わが"],["民","た"],["みイスラエル"],["の"],["君","きみ"],["として"],["選らんだ","えらんだ"],["こと"],["が"],["ない"],["。"]]},{"verse":6,"text":"わが名,なを置,おくために、ただエルサレムだけを選,えらび、またわが民,たみイスラエルを治,おさめさせるために、ただダビデだけを選,えらんだ』。","tok":[["わが"],["名","な"],["を"],["置く","おく"],["ため"],["に"],["、"],["ただ"],["エルサレム"],["だけ"],["を"],["選ら","えら"],["び"],["、"],["また"],["わが"],["民","た"],["みイスラエル"],["を"],["治めさせる","おさめさせる"],["ため"],["に"],["、"],["ただ"],["ダビデ"],["だけ"],["を"],["選らんだ","えらんだ"],["』"],["。"]]},{"verse":7,"text":"イスラエルの神,かみ、主,しゅの名,なのために家,いえを建,たてることは、父,ちちダビデの心,こころにあった。","tok":[["イスラエル"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["名","な"],["の"],["ため"],["に"],["家","いえ"],["を"],["建てる","たてる"],["こと"],["は"],["、"],["父","ちち"],["ダビデ"],["の"],["心","こころ"],["に"],["あった"],["。"]]},{"verse":8,"text":"しかし主,しゅは父,ちちダビデに言,いわれた、『わたしの名,なのために家,いえを建,たてることはあなたの心,こころにあった。あなたの心,こころにこの事,ことのあったのは結構,けっこうである。","tok":[["しかし"],["主","しゅ"],["は"],["父","ちち"],["ダビデ"],["に"],["言われた","いわれた"],["、"],["『"],["わたし"],["の"],["名","な"],["の"],["ため"],["に"],["家","いえ"],["を"],["建てる","たてる"],["こと"],["は"],["あなた"],["の"],["心","こころ"],["に"],["あった"],["。"],["あなた"],["の"],["心","こころ"],["に"],["この"],["事","こと"],["の"],["あった"],["の"],["は"],["結構","けっこう"],["で"],["ある"],["。"]]},{"verse":9,"text":"しかしあなたはその家,いえを建,たててはならない。あなたの腰,こしから出,でるあなたの子,こがわたしの名,なのために家,いえを建,たてるであろう』。","tok":[["しかし"],["あなた"],["は"],["その"],["家","いえ"],["を"],["建てて","たてて"],["は"],["ならない"],["。"],["あなた"],["の"],["腰","こし"],["から"],["出る","でる"],["あなた"],["の"],["子","こ"],["が"],["わたし"],["の"],["名","な"],["の"],["ため"],["に"],["家","いえ"],["を"],["建てるで","たてるで"],["あろう"],["』"],["。"]]},{"verse":10,"text":"そして主,しゅはそう言,いわれた言葉,ことばを行,おこなわれた。すなわちわたしは父,ちちダビデに代,かわって立,たち、主,しゅが言,いわれたように、イスラエルの位,くらいに座,ざし、イスラエルの神,かみ、主,しゅの名,なのために家,いえを建,たてた。","tok":[["そして"],["主","しゅ"],["は"],["そう"],["言われた","いわれた"],["言葉","ことば"],["を"],["行なわれた","おこなわれた"],["。"],["すなわち"],["わたし"],["は"],["父","ちち"],["ダビデ"],["に"],["代わって","かわって"],["立ち","たち"],["、"],["主","しゅ"],["が"],["言われた","いわれた"],["よう"],["に"],["、"],["イスラエル"],["の"],["位","くらい"],["に"],["座し","ざし"],["、"],["イスラエル"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["名","な"],["の"],["ため"],["に"],["家","いえ"],["を"],["建てた","たてた"],["。"]]},{"verse":11,"text":"わたしはまた、主,しゅがイスラエルの人々,ひとびとと結,むすばれた主,しゅの契約,けいやくを入,いれた箱,はこをそこに納,おさめた」。","tok":[["わたし"],["は"],["また"],["、"],["主","しゅ"],["が"],["イスラエル"],["の"],["人々","ひとびと"],["と"],["結ばれた","むすばれた"],["主","しゅ"],["の"],["契約","けいやく"],["を"],["入れた","いれた"],["箱","はこ"],["を"],["そこ"],["に"],["納","おさめ"],["た"],["」"],["。"]]},{"verse":12,"text":"ソロモンはイスラエルの全,ぜん会衆,かいしゅうの前,まえ、主,しゅの祭壇,さいだんの前,まえに立,たって、手,てを伸,のべた。","tok":[["ソロモン"],["は"],["イスラエル"],["の"],["全","ぜん"],["会衆","かいしゅう"],["の"],["前","まえ"],["、"],["主","しゅ"],["の"],["祭壇","さいだん"],["の"],["前","まえ"],["に"],["立って","たって"],["、"],["手","て"],["を"],["伸べた","のべた"],["。"]]},{"verse":13,"text":"ソロモンはさきに長,ながさ五キュビト、幅,はば五キュビト、高,たかさ三キュビトの青銅,せいどうの台,だいを造,つくって、庭,にわのまん中,なかにすえて置,おいたので、彼,かれはその上,うえに立,たち、イスラエルの全,ぜん会衆,かいしゅうの前,まえでひざをかがめ、その手,てを天,てんに伸,のべて、","tok":[["ソロモン"],["は"],["さき"],["に"],["長さ","ながさ"],["五","ご"],["キュビト"],["、"],["幅","はば"],["五","ご"],["キュビト"],["、"],["高か","たか"],["さ"],["三","さん"],["キュビト"],["の"],["青銅","せいどう"],["の"],["台","だい"],["を"],["造って","つくって"],["、"],["庭","にわ"],["の"],["まん中","まんなか"],["に"],["すえて"],["置いた","おいた"],["ので"],["、"],["彼","かれ"],["は"],["その"],["上","うえ"],["に"],["立ち","たち"],["、"],["イスラエル"],["の"],["全","ぜん"],["会衆","かいしゅう"],["の"],["前","まえ"],["で"],["ひざ"],["を"],["かがめ"],["、"],["その"],["手","て"],["を"],["天","てん"],["に"],["伸べて","のべて"],["、"]]},{"verse":14,"text":"言,いった、「イスラエルの神,かみ、主,しゅよ、天,てんにも地,ちにも、あなたのような神,かみはありません。あなたは契約,けいやくを守,まもられ、心,こころをつくしてあなたの前,まえに歩,あゆむあなたのしもべらに、いつくしみを施,ほどこし、","tok":[["言った","いった"],["、"],["「"],["イスラエル"],["の"],["神","かみ"],["、"],["主","しゅ"],["よ"],["、"],["天","てん"],["に"],["も"],["地","ち"],["に"],["も"],["、"],["あなた"],["の"],["よう"],["な"],["神","かみ"],["は"],["ありません"],["。"],["あなた"],["は"],["契約","けいやく"],["を"],["守られ","まもられ"],["、"],["心","こころ"],["を"],["つくして"],["あなた"],["の"],["前","まえ"],["に"],["歩む","あゆむ"],["あなた"],["の"],["しもべ"],["ら"],["に"],["、"],["いつくしみ"],["を"],["施し","ほどこし"],["、"]]},{"verse":15,"text":"あなたのしもべ、わたしの父,ちちダビデに約束,やくそくされたことを守,まもられました。あなたが口,くちをもって約束,やくそくされたことを、手,てをもってなし遂,とげられたことは、今日,こんにち見,みるとおりであります。","tok":[["あなた"],["の"],["しもべ"],["、"],["わたし"],["の"],["父","ちち"],["ダビデ"],["に"],["約束","やくそく"],["された"],["こと"],["を"],["守られました","まもられました"],["。"],["あなた"],["が"],["口","くち"],["を"],["もって"],["約束","やくそく"],["された"],["こと"],["を"],["、"],["手","て"],["を"],["もって"],["なし遂げられた","なしとげられた"],["こと"],["は"],["、"],["今日","こん"],["に"],["ち"],["見る","みる"],["とおり"],["で"],["あります"],["。"]]},{"verse":16,"text":"それゆえ、イスラエルの神,かみ、主,しゅよ、あなたのしもべ、わたしの父,ちちダビデに、あなたが約束,やくそくして、『おまえがわたしの前,まえに歩,あゆんだように、おまえの子孫,しそんがその道,みちを慎,つつしんで、わたしのおきてに歩,あゆむならば、おまえにはイスラエルの位,くらいに座,ざする人,ひとがわたしの前,まえに欠,かけることはない』と言,いわれたことを、ダビデのためにお守,まもりください。","tok":[["それ"],["ゆえ"],["、"],["イスラエル"],["の"],["神","かみ"],["、"],["主","しゅ"],["よ"],["、"],["あなた"],["の"],["しもべ"],["、"],["わたし"],["の"],["父","ちち"],["ダビデ"],["に"],["、"],["あなた"],["が"],["約束","やくそく"],["して"],["、"],["『"],["おまえ"],["が"],["わたし"],["の"],["前","まえ"],["に"],["歩んだ","あゆんだ"],["よう"],["に"],["、"],["おまえ"],["の"],["子孫","しそん"],["が"],["その"],["道","みち"],["を"],["慎しんで","つつしんで"],["、"],["わたし"],["の"],["おきて"],["に"],["歩むならば","あゆむならば"],["、"],["おまえ"],["に"],["は"],["イスラエル"],["の"],["位","くらい"],["に"],["座する","ざする"],["人","ひと"],["が"],["わたし"],["の"],["前","まえ"],["に"],["欠ける","かける"],["こと"],["は"],["ない"],["』"],["と"],["言われた","いわれた"],["こと"],["を"],["、"],["ダビデ"],["の"],["ため"],["に"],["お守り","おまもり"],["ください"],["。"]]},{"verse":17,"text":"それゆえ、イスラエルの神,かみ、主,しゅよ、どうぞ、あなたのしもべダビデに言,いわれた言葉,ことばを確認,かくにんしてください。","tok":[["それ"],["ゆえ"],["、"],["イスラエル"],["の"],["神","かみ"],["、"],["主","しゅ"],["よ"],["、"],["どうぞ"],["、"],["あなた"],["の"],["しもべ"],["ダビデ"],["に"],["言われた","いわれた"],["言葉","ことば"],["を"],["確認","かくにん"],["して"],["ください"],["。"]]},{"verse":18,"text":"しかし神,かみは、はたして人,ひとと共,ともに地上,ちじょうに住,すまわれるでしょうか。見,みよ、天,てんも、いと高,たかき天,てんもあなたをいれることはできません。わたしの建,たてたこの家,いえなどなおさらです。","tok":[["しかし"],["神","かみ"],["は"],["、"],["はたして"],["人","ひと"],["と"],["共","とも"],["に"],["地上","ちじょう"],["に"],["住まわれるでしょう","すまわれるでしょう"],["か"],["。"],["見よ","みよ"],["、"],["天","てん"],["も"],["、"],["いと"],["高き","たかき"],["天","てん"],["も"],["あなた"],["を"],["いれる"],["こと"],["は"],["できません"],["。"],["わたし"],["の"],["建てた","たてた"],["この"],["家","いえ"],["など"],["なおさら"],["です"],["。"]]},{"verse":19,"text":"しかしわが神,かみ、主,しゅよ、しもべの祈,いのりと願,ねがいを顧,かえりみて、しもべがあなたの前,まえにささげる叫,さけびと祈,いのりをお聞,ききください。","tok":[["しかし"],["わが"],["神","かみ"],["、"],["主","しゅ"],["よ"],["、"],["しもべ"],["の"],["祈","いのり"],["と"],["願い","ねがい"],["を"],["顧て","かえりみて"],["、"],["しもべ"],["が"],["あなた"],["の"],["前","まえ"],["に"],["ささげる"],["叫","さけび"],["と"],["祈","いのり"],["を"],["お聞く","おききく"],["ださい"],["。"]]},{"verse":20,"text":"どうぞ、あなたの目,めを昼,ひるも夜,よるもこの家,いえに、すなわち、あなたの名,なをそこに置,おくと言,いわれた所,ところに向,むかってお開,ひらきください。どうぞ、しもべがこの所,ところに向,むかってささげる祈,いのりをお聞,ききください。","tok":[["どうぞ"],["、"],["あなた"],["の"],["目","め"],["を"],["昼","ひる"],["も"],["夜","よる"],["も"],["この"],["家","いえ"],["に"],["、"],["すなわち"],["、"],["あなた"],["の"],["名","な"],["を"],["そこ"],["に"],["置く","おく"],["と"],["言われた","いわれた"],["所","ところ"],["に"],["向かって","むかって"],["お開らき","おひらき"],["ください"],["。"],["どうぞ"],["、"],["しもべ"],["が"],["この"],["所","ところ"],["に"],["向かって","むかって"],["ささげる"],["祈","いのり"],["を"],["お聞く","おききく"],["ださい"],["。"]]},{"verse":21,"text":"どうぞ、しもべと、あなたの民,たみイスラエルがこの所,ところに向,むかって祈,いのる時,ときに、その願,ねがいをお聞,ききください。あなたのすみかである天,てんから聞,きき、聞,きいておゆるしください。","tok":[["どうぞ"],["、"],["しもべ"],["と"],["、"],["あなた"],["の"],["民","たみ"],["イスラエル"],["が"],["この"],["所","ところ"],["に"],["向かって","むかって"],["祈る","いのる"],["時","とき"],["に"],["、"],["その"],["願い","ねがい"],["を"],["お聞く","おききく"],["ださい"],["。"],["あなた"],["の"],["すみか"],["で"],["ある"],["天","てん"],["から"],["聞","きき"],["、"],["聞いて","きいて"],["おゆるし"],["ください"],["。"]]},{"verse":22,"text":"もし人,ひとがその隣,となり人,びとに対,たいして罪,つみを犯,おかし、誓,ちかいをすることを求,もとめられるとき、来,きてこの宮,みやで、あなたの祭壇,さいだんの前,まえに誓,ちかうならば、","tok":[["もし"],["人","ひと"],["が"],["その"],["隣人","となりびと"],["に対して","にたいして"],["罪","つみ"],["を"],["犯し","おかし"],["、"],["誓い","ちかい"],["を"],["する"],["こと"],["を"],["求められる","もとめられる"],["とき"],["、"],["来て","きて"],["この"],["宮","みや"],["で"],["、"],["あなた"],["の"],["祭壇","さいだん"],["の"],["前","まえ"],["に"],["誓うならば","ちかうならば"],["、"]]},{"verse":23,"text":"あなたは天,てんから聞,きいて、行,おこない、あなたのしもべらをさばき、悪人,あくにんに報,むくいをなして、その行,おこないの報,むくいをそのこうべに帰,きし、義人,ぎじんを義,ぎとして、その義,ぎにしたがってその人,ひとに報,むくいてください。","tok":[["あなた"],["は"],["天","てん"],["から"],["聞いて","きいて"],["、"],["行ない","おこない"],["、"],["あなた"],["の"],["しもべ"],["ら"],["を"],["さばき"],["、"],["悪人","あくにん"],["に"],["報い","むくい"],["を"],["なして"],["、"],["その"],["行ない","おこない"],["の"],["報い","むくい"],["を"],["その"],["こうべ"],["に"],["帰し","きし"],["、"],["義人","ぎじん"],["を"],["義","ぎ"],["として"],["、"],["その"],["義","ぎ"],["に"],["したがって"],["その"],["人","ひと"],["に"],["報いて","むくいて"],["ください"],["。"]]},{"verse":24,"text":"もしあなたの民,たみイスラエルが、あなたに対,たいして罪,つみを犯,おかしたために、敵,てきの前,まえに敗,やぶれた時,とき、あなたに立,たち返,かえって、あなたの名,なをあがめ、この宮,みやであなたの前,まえに祈,いのり願,ねがうならば、","tok":[["もし"],["あなた"],["の"],["民","たみ"],["イスラエル"],["が"],["、"],["あなた"],["に対して","にたいして"],["罪","つみ"],["を"],["犯した","おかした"],["ため"],["に"],["、"],["敵","てき"],["の"],["前","まえ"],["に"],["敗れた","やぶれた"],["時","とき"],["、"],["あなた"],["に"],["立ち返って","たちかえって"],["、"],["あなた"],["の"],["名","な"],["を"],["あがめ"],["、"],["この"],["宮","みや"],["で"],["あなた"],["の"],["前","まえ"],["に"],["祈願","いのりねが"],["う"],["ならば"],["、"]]},{"verse":25,"text":"あなたは天,てんから聞,きき、あなたの民,たみイスラエルの罪,つみをゆるして、あなたが彼,かれらとその先祖,せんぞに与,あたえられた地,ちに彼,かれらを帰,かえらせてください。","tok":[["あなた"],["は"],["天","てん"],["から"],["聞","きき"],["、"],["あなた"],["の"],["民","たみ"],["イスラエル"],["の"],["罪","つみ"],["を"],["ゆるして"],["、"],["あなた"],["が"],["彼","かれ"],["ら"],["と"],["その"],["先祖","せんぞ"],["に"],["与えられた","あたえられた"],["地","ち"],["に"],["彼","かれ"],["ら"],["を"],["帰えらせて","かえらせて"],["ください"],["。"]]},{"verse":26,"text":"もし彼,かれらがあなたに罪,つみを犯,おかしたために、天,てんが閉,とざされて、雨,あめがなく、あなたが彼,かれらを苦,くるしめられるとき、彼,かれらがこの所,ところに向,むかって祈,いのり、あなたの名,なをあがめ、その罪,つみを離,はなれるならば、","tok":[["もし"],["彼","かれ"],["ら"],["が"],["あなた"],["に"],["罪","つみ"],["を"],["犯した","おかした"],["ため"],["に"],["、"],["天","てん"],["が"],["閉ざされて","とざされて"],["、"],["雨","あめ"],["が"],["なく"],["、"],["あなた"],["が"],["彼","かれ"],["ら"],["を"],["苦しめられる","くるしめられる"],["とき"],["、"],["彼","かれ"],["ら"],["が"],["この"],["所","ところ"],["に"],["向かって","むかって"],["祈","いのり"],["、"],["あなた"],["の"],["名","な"],["を"],["あがめ"],["、"],["その"],["罪","つみ"],["を"],["離れるならば","はなれるならば"],["、"]]},{"verse":27,"text":"あなたは天,てんにあって聞,きき、あなたのしもべ、あなたの民,たみイスラエルの罪,つみをゆるして、彼,かれらに歩,あゆむべき良,よい道,みちを教,おしえ、あなたの民,たみに嗣,し業,ぎょうとして賜,たまわった地,ちに雨,あめを降,ふらせてください。","tok":[["あなた"],["は"],["天","てん"],["に"],["あって"],["聞","きき"],["、"],["あなた"],["の"],["しもべ"],["、"],["あなた"],["の"],["民","たみ"],["イスラエル"],["の"],["罪","つみ"],["を"],["ゆるして"],["、"],["彼","かれ"],["ら"],["に"],["歩むべき","あゆむべき"],["良い","よい"],["道","みち"],["を"],["教え","おしえ"],["、"],["あなた"],["の"],["民","たみ"],["に"],["嗣業","しぎょう"],["として"],["賜わった","たまわった"],["地","ち"],["に"],["雨","あめ"],["を"],["降らせて","ふらせて"],["ください"],["。"]]},{"verse":28,"text":"もし国,くににききんがあるか、もしくは疫病,えきびょう、立,たち枯,がれ、腐,くさり穂,ほ、いなご、青虫,あおむしがあるか、または敵,てきのために町,まちの門,もんの中,なかに攻,せめ囲,かこまれることがあるか、どんな災害,さいがい、どんな病気,びょうきがあっても、","tok":[["もし"],["国","くに"],["に"],["ききん"],["が"],["ある"],["か"],["、"],["もしくは"],["疫病","え"],["き"],["びょう"],["、"],["立ち枯れ","たちがれ"],["、"],["腐り","くさり"],["穂","ほ"],["、"],["いなご"],["、"],["青虫","あおむし"],["が"],["ある"],["か"],["、"],["また"],["は"],["敵","てき"],["の"],["ため"],["に"],["町","まち"],["の"],["門","もん"],["の"],["中","なか"],["に"],["攻め囲まれる","せめかこまれる"],["こと"],["が"],["ある"],["か"],["、"],["どんな"],["災害","さいがい"],["、"],["どんな"],["病気","びょうき"],["が"],["あって"],["も"],["、"]]},{"verse":29,"text":"もし、ひとりか、あるいはあなたの民,たみイスラエルが皆,みなおのおのその心,こころの悩,なやみを知,しって、この宮,みやに向,むかい、手,てを伸,のべるならば、どんな祈,いのり、どんな願,ねがいでも、","tok":[["もし"],["、"],["ひとり"],["か"],["、"],["あるいは"],["あなた"],["の"],["民","たみ"],["イスラエル"],["が"],["皆","みな"],["おのおの"],["その"],["心","こころ"],["の"],["悩み","なやみ"],["を"],["知って","しって"],["、"],["この"],["宮","みや"],["に"],["向","むかい"],["、"],["手","て"],["を"],["伸べるならば","のべるならば"],["、"],["どんな"],["祈","いのり"],["、"],["どんな"],["願い","ねがい"],["で"],["も"],["、"]]},{"verse":30,"text":"あなたはそのすみかである天,てんから聞,きいてゆるし、おのおのの人,ひとに、その心,こころを知,しっておられるゆえ、そのすべての道,みちにしたがって報,むくいてください。ただあなただけがすべての人,ひとの心,こころを知,しっておられるからです。","tok":[["あなた"],["は"],["その"],["すみか"],["で"],["ある"],["天","てん"],["から"],["聞いて","きいて"],["ゆるし"],["、"],["おのおの"],["の"],["人","ひと"],["に"],["、"],["その"],["心","こころ"],["を"],["知って","しって"],["おられる"],["ゆえ"],["、"],["その"],["すべて"],["の"],["道","みち"],["に"],["したがって"],["報いて","むくいて"],["ください"],["。"],["ただ"],["あなた"],["だけ"],["が"],["すべて"],["の"],["人","ひと"],["の"],["心","こころ"],["を"],["知って","しって"],["おられる"],["から"],["です"],["。"]]},{"verse":31,"text":"あなたがわれわれの先祖,せんぞたちに賜,たまわった地,ちに、彼,かれらの生,いきながらえる日,ひの間,あいだ、常,つねにあなたを恐,おそれさせ、あなたの道,みちに歩,あゆませてください。","tok":[["あなた"],["が"],["われわれ"],["の"],["先祖","せんぞ"],["たち"],["に"],["賜わった","たまわった"],["地","ち"],["に"],["、"],["彼","かれ"],["ら"],["の"],["生きながらえる","いきながらえる"],["日","ひ"],["の"],["間","あいだ"],["、"],["常","つね"],["に"],["あなた"],["を"],["恐れさせ","おそれさせ"],["、"],["あなた"],["の"],["道","みち"],["に"],["歩ませて","あゆませて"],["ください"],["。"]]},{"verse":32,"text":"またあなたの民,たみイスラエルの者,ものでなく、他国,たこく人,じんで、あなたの大,おおいなる名,なと、強,つよい手,てと、伸,のべた腕,うでのために遠,とおい国,くにから来,きて、この宮,みやに向,むかって祈,いのるならば、","tok":[["また"],["あなた"],["の"],["民","たみ"],["イスラエル"],["の"],["者","もの"],["で"],["なく"],["、"],["他国人","たこくじん"],["で"],["、"],["あなた"],["の"],["大いなる","おおいなる"],["名","な"],["と"],["、"],["強い","つよい"],["手","て"],["と"],["、"],["伸べた","のべた"],["腕","うで"],["の"],["ため"],["に"],["遠い","とおい"],["国","くに"],["から"],["来て","きて"],["、"],["この"],["宮","みや"],["に"],["向かって","むかって"],["祈るならば","いのるならば"],["、"]]},{"verse":33,"text":"あなたは、あなたのすみかである天,てんから聞,きき、すべて他国,たこく人,じんがあなたに呼,よび求,もとめるようにしてください。そうすれば地,ちのすべての民,たみはあなたの民,たみイスラエルのように、あなたの名,なを知,しり、あなたを恐,おそれ、またわたしが建,たてたこの宮,みやが、あなたの名,なによって呼,よばれることを知,しるにいたるでしょう。","tok":[["あなた"],["は"],["、"],["あなた"],["の"],["すみか"],["で"],["ある"],["天","てん"],["から"],["聞","きき"],["、"],["すべて"],["他国人","たこくじん"],["が"],["あなた"],["に"],["呼び求める","よびもとめる"],["よう"],["に"],["して"],["ください"],["。"],["そう"],["すれば"],["地","ち"],["の"],["すべて"],["の"],["民","たみ"],["は"],["あなた"],["の"],["民","たみ"],["イスラエル"],["の"],["よう"],["に"],["、"],["あなた"],["の"],["名","な"],["を"],["知り","しり"],["、"],["あなた"],["を"],["恐","おそれ"],["、"],["また"],["わたし"],["が"],["建てた","たてた"],["この"],["宮","みや"],["が"],["、"],["あなた"],["の"],["名","な"],["によって"],["呼ばれる","よばれる"],["こと"],["を"],["知る","しる"],["に"],["いたるでしょう"],["。"]]},{"verse":34,"text":"あなたの民,たみが敵,てきと戦,たたかうために、あなたがつかわされる道,みちによって出,でるとき、もし彼,かれらがあなたの選,えらばれたこの町,まちと、わたしがあなたの名,なのために建,たてたこの宮,みやに向,むかってあなたに祈,いのるならば、","tok":[["あなた"],["の"],["民","たみ"],["が"],["敵","てき"],["と"],["戦う","たたかう"],["ため"],["に"],["、"],["あなた"],["が"],["つかわされる"],["道","みち"],["によって"],["出る","でる"],["とき"],["、"],["もし"],["彼","かれ"],["ら"],["が"],["あなた"],["の"],["選ら","えら"],["ばれた"],["この"],["町","まち"],["と"],["、"],["わたし"],["が"],["あなた"],["の"],["名","な"],["の"],["ため"],["に"],["建てた","たてた"],["この"],["宮","みや"],["に"],["向かって","むかって"],["あなた"],["に"],["祈るならば","いのるならば"],["、"]]},{"verse":35,"text":"あなたは天,てんから彼,かれらの祈,いのりと願,ねがいとを聞,きいて彼,かれらをお助,たすけください。","tok":[["あなた"],["は"],["天","てん"],["から"],["彼","かれ"],["ら"],["の"],["祈","いのり"],["と"],["願い","ねがい"],["と"],["を"],["聞いて","きいて"],["彼","かれ"],["ら"],["を"],["お助け","おたすけ"],["ください"],["。"]]},{"verse":36,"text":"彼,かれらがあなたに対,たいして罪,つみを犯,おかすことがあって、――罪,つみを犯,おかさない人,ひとはないゆえ、――あなたが彼,かれらを怒,いかって、敵,てきにわたし、敵,てきが彼,かれらを捕虜,ほりょとして遠,とおい地,ちあるいは近,ちかい地,ちに引,ひいて行,いくとき、","tok":[["彼","かれ"],["ら"],["が"],["あなた"],["に対して","にたいして"],["罪","つみ"],["を"],["犯す","おかす"],["こと"],["が"],["あって"],["、"],["―"],["―"],["罪","つみ"],["を"],["犯さない","おかさない"],["人","ひと"],["は"],["ない"],["ゆえ"],["、"],["―"],["―"],["あなた"],["が"],["彼","かれ"],["ら"],["を"],["怒","い"],["か"],["って"],["、"],["敵","てき"],["に"],["わたし"],["、"],["敵","てき"],["が"],["彼","かれ"],["ら"],["を"],["捕虜","ほりょ"],["として"],["遠い","とおい"],["地","ち"],["あるいは"],["近い","ちかい"],["地","ち"],["に"],["引いて","ひいて"],["行く","いく"],["とき"],["、"]]},{"verse":37,"text":"もし、彼,かれらが捕,とらわれて行,いった地,ちで、みずから省,かえりみて悔,くい、その捕,とらわれの地,ちであなたに願,ねがい、『われわれは罪,つみを犯,おかし、よこしまな事,ことをし、悪,あくを行,おこないました』と言,いい、","tok":[["もし"],["、"],["彼","かれ"],["ら"],["が"],["捕らわれて","とらわれて"],["行った","いった"],["地","ち"],["で"],["、"],["みずから"],["省りみて","かえりみて"],["悔い","くい"],["、"],["その"],["捕らわれ","とらわれ"],["の"],["地","ち"],["で"],["あなた"],["に"],["願い","ねがい"],["、"],["『"],["われわれ"],["は"],["罪","つみ"],["を"],["犯し","おかし"],["、"],["よこしま"],["な"],["事","こと"],["を"],["し"],["、"],["悪","あく"],["を"],["行ないました","おこないました"],["』"],["と"],["言い","いい"],["、"]]},{"verse":38,"text":"その捕,とらわれの地,ちで心,こころをつくし、精神,せいしんをつくしてあなたに立,たち返,かえり、あなたが彼,かれらの先祖,せんぞに与,あたえられた地,ち、あなたが選,えらばれた町,まち、わたしがあなたの名,なのために建,たてたこの宮,みやに向,むかって祈,いのるならば、","tok":[["その"],["捕らわれ","とらわれ"],["の"],["地","ち"],["で"],["心","こころ"],["を"],["つくし"],["、"],["精神","せいしん"],["を"],["つくして"],["あなた"],["に"],["立ち返り","たちかえり"],["、"],["あなた"],["が"],["彼","かれ"],["ら"],["の"],["先祖","せんぞ"],["に"],["与えられた","あたえられた"],["地","ち"],["、"],["あなた"],["が"],["選ら","えら"],["ばれた"],["町","まち"],["、"],["わたし"],["が"],["あなた"],["の"],["名","な"],["の"],["ため"],["に"],["建てた","たてた"],["この"],["宮","みや"],["に"],["向かって","むかって"],["祈るならば","いのるならば"],["、"]]},{"verse":39,"text":"あなたのすみかである天,てんから、彼,かれらの祈,いのりと願,ねがいとを聞,きいて彼,かれらを助,たすけ、あなたに向,むかって罪,つみを犯,おかしたあなたの民,たみをおゆるしください。","tok":[["あなた"],["の"],["すみか"],["で"],["ある"],["天","てん"],["から"],["、"],["彼","かれ"],["ら"],["の"],["祈","いのり"],["と"],["願い","ねがい"],["と"],["を"],["聞いて","きいて"],["彼","かれ"],["ら"],["を"],["助け","たすけ"],["、"],["あなた"],["に"],["向かって","むかって"],["罪","つみ"],["を"],["犯した","おかした"],["あなた"],["の"],["民","たみ"],["を"],["おゆるし"],["ください"],["。"]]},{"verse":40,"text":"わが神,かみよ、どうぞ、この所,ところでささげる祈,いのりにあなたの目,めを開,ひらき、あなたの耳,みみを傾,かたむけてください。","tok":[["わが"],["神","かみ"],["よ"],["、"],["どうぞ"],["、"],["この"],["所","ところ"],["で"],["ささげる"],["祈","いのり"],["に"],["あなた"],["の"],["目","め"],["を"],["開らき","ひらき"],["、"],["あなた"],["の"],["耳","みみ"],["を"],["傾むけて","かたむけて"],["ください"],["。"]]},{"verse":41,"text":"主,しゅなる神,かみよ、今,いまあなたと、あなたの力,ちからの箱,はこが立,たって、あなたの安息所,あんそくじょにおはいりください。主,しゅなる神,かみよ、どうぞあなたの祭司,さいしたちに救,すくいの衣,ころもを着,きせ、あなたの聖徒,せいとたちに恵,めぐみを喜,よろこばせてください。","tok":[["主","しゅ"],["なる"],["神","かみ"],["よ"],["、"],["今","いま"],["あなた"],["と"],["、"],["あなた"],["の"],["力","ちから"],["の"],["箱","は"],["こ"],["が"],["立って","たって"],["、"],["あなた"],["の"],["安息所","あんそくじょ"],["に"],["おはいり"],["ください"],["。"],["主","しゅ"],["なる"],["神","かみ"],["よ"],["、"],["どうぞ"],["あなた"],["の"],["祭司","さいし"],["たち"],["に"],["救い","すくい"],["の"],["衣","ころも"],["を"],["着せ","きせ"],["、"],["あなた"],["の"],["聖徒","せいと"],["たち"],["に"],["恵","めぐみ"],["を"],["喜こばせて","よろこばせて"],["ください"],["。"]]},{"verse":42,"text":"主,しゅなる神,かみよ、どうぞあなたの油,あぶらそそがれた者,ものの顔,かおを退,しりぞけないでください。あなたのしもべダビデに示,しめされたいつくしみを覚,おぼえて下,ください」。","tok":[["主","しゅ"],["なる"],["神","かみ"],["よ"],["、"],["どうぞ"],["あなた"],["の"],["油","あぶら"],["そそがれた"],["者","もの"],["の"],["顔","かお"],["を"],["退ぞけないで","しりぞけないで"],["ください"],["。"],["あなた"],["の"],["しもべ"],["ダビデ"],["に"],["示めされた","しめされた"],["いつくしみ"],["を"],["覚えて","おぼえて"],["下さい","ください"],["」"],["。"]]}]
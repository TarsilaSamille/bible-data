[{"verse":1,"text":"レハベアムはエルサレムに来,きて、ユダとベニヤミンの家,いえの者,もの、すなわち、えり抜,ぬきの軍人,ぐんじん十八万人,にんを集,あつめ、国,くにを取,とりもどすためにイスラエルと戦,たたかおうとしたが、","tok":[["レハベアム"],["は"],["エルサレム"],["に"],["来て","きて"],["、"],["ユダ"],["と"],["ベニヤミン"],["の"],["家","いえ"],["の"],["者","もの"],["、"],["すなわち"],["、"],["えり抜き","えりぬき"],["の"],["軍人","ぐんじん"],["十八万人","にん"],["を"],["集め","あつめ"],["、"],["国","くに"],["を"],["取","とり"],["も"],["どす"],["ため"],["に"],["イスラエル"],["と"],["戦おう","たたかおう"],["と"],["した"],["が"],["、"]]},{"verse":2,"text":"主,しゅの言葉,ことばが神,かみの人,ひとシマヤに臨,のぞんで言,いった、","tok":[["主","しゅ"],["の"],["言葉","ことば"],["が"],["神","かみ"],["の"],["人","ひと"],["シマヤ"],["に"],["臨んで","のぞんで"],["言った","いった"],["、"]]},{"verse":3,"text":"「ソロモンの子,こ、ユダの王,おうレハベアムおよびユダとベニヤミンにいるすべてのイスラエルの人々,ひとびとに言,いいなさい、","tok":[["「"],["ソロモン"],["の"],["子","こ"],["、"],["ユダ"],["の"],["王","おう"],["レハベアム"],["および"],["ユダ"],["と"],["ベニヤミン"],["に"],["いる"],["すべて"],["の"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["言い","いい"],["なさい"],["、"]]},{"verse":4,"text":"『主,しゅはこう仰,おおせられる、あなたがたは上,のぼってはならない。あなたがたの兄弟,きょうだいと戦,たたかってはならない。おのおの自分,じぶんの家,いえに帰,かえりなさい。この事,ことはわたしから出,でたのである』」。それで人々,ひとびとは主,しゅの言葉,ことばを聞,きき、ヤラベアムを攻,せめに行,いくのをやめて帰,かえった。","tok":[["『"],["主","しゅ"],["は"],["こう"],["仰せられる","おおせられる"],["、"],["あなた"],["がた"],["は"],["上って","のぼって"],["は"],["ならない"],["。"],["あなた"],["がた"],["の"],["兄弟","きょうだい"],["と"],["戦って","たたかって"],["は"],["ならない"],["。"],["おのおの"],["自分","じぶん"],["の"],["家","いえ"],["に"],["帰えり","かえり"],["なさい"],["。"],["この"],["事","こと"],["は"],["わたし"],["から"],["出た","でた"],["ので"],["ある"],["』"],["」"],["。"],["それ"],["で"],["人々","ひとびと"],["は"],["主","しゅ"],["の"],["言葉","ことば"],["を"],["聞","きき"],["、"],["ヤラベアム"],["を"],["攻め","せめ"],["に"],["行く","いく"],["の"],["を"],["やめて"],["帰えった","かえった"],["。"]]},{"verse":5,"text":"レハベアムはエルサレムに住,すんで、ユダに防衛,ぼうえいの町々,まちまちを建,たてた。","tok":[["レハベアム"],["は"],["エルサレム"],["に"],["住んで","すんで"],["、"],["ユダ"],["に"],["防衛","ぼうえい"],["の"],["町々","まちまち"],["を"],["建てた","たてた"],["。"]]},{"verse":6,"text":"すなわちベツレヘム、エタム、テコア、","tok":[["すなわち"],["ベツレヘム"],["、"],["エタム"],["、"],["テコア"],["、"]]},{"verse":7,"text":"ベテズル、ソコ、アドラム、","tok":[["ベテズル"],["、"],["ソコ"],["、"],["アドラム"],["、"]]},{"verse":8,"text":"ガテ、マレシャ、ジフ、","tok":[["ガテ"],["、"],["マレシャ"],["、"],["ジフ"],["、"]]},{"verse":9,"text":"アドライム、ラキシ、アゼカ、","tok":[["アドライム"],["、"],["ラキシ"],["、"],["アゼカ"],["、"]]},{"verse":10,"text":"ゾラ、アヤロン、およびヘブロン。これらはユダとベニヤミンにあって要害,ようがいの町々,まちまちである。","tok":[["ゾラ"],["、"],["アヤロン"],["、"],["および"],["ヘブロン"],["。"],["これ"],["ら"],["は"],["ユダ"],["と"],["ベニヤミン"],["に"],["あって"],["要害","ようがい"],["の"],["町々","まちまち"],["で"],["ある"],["。"]]},{"verse":11,"text":"彼,かれはその要害,ようがいを堅固,けんごにし、これに軍,ぐん長,ちょうを置,おき、糧食,りょうしょくと油,あぶらとぶどう酒,しゅをたくわえ、","tok":[["彼","かれ"],["は"],["その"],["要害","ようがい"],["を"],["堅固","けんご"],["に"],["し"],["、"],["これ"],["に"],["軍長","ぐんちょう"],["を"],["置き","おき"],["、"],["糧食","りょうしょく"],["と"],["油","あぶら"],["と"],["ぶどう酒","ぶどうしゅ"],["を"],["たくわえ"],["、"]]},{"verse":12,"text":"またそのすべての町,まちに盾,たてとやりを備,そなえて、これを非常,ひじょうに強化,きょうかし、そしてユダとベニヤミンを確保,かくほした。","tok":[["また"],["その"],["すべて"],["の"],["町","まち"],["に"],["盾","たて"],["と"],["やり"],["を"],["備","そなえ"],["て"],["、"],["これ"],["を"],["非常","ひじょう"],["に"],["強化","きょうか"],["し"],["、"],["そして"],["ユダ"],["と"],["ベニヤミン"],["を"],["確保","かくほ"],["した"],["。"]]},{"verse":13,"text":"イスラエルの全,ぜん地,ちの祭司,さいしとレビびとは四方,しほうの境,さかいから来,きてレハベアムに身,みを寄,よせた。","tok":[["イスラエル"],["の"],["全地","ぜんち"],["の"],["祭司","さいし"],["と"],["レビ"],["び"],["と"],["は"],["四方","しほう"],["の"],["境","さかい"],["から"],["来て","きて"],["レハベアム"],["に"],["身","み"],["を"],["寄せた","よせた"],["。"]]},{"verse":14,"text":"すなわちレビびとは自分,じぶんの放牧,ほうぼく地,ちと領地,りょうちを離,はなれてユダとエルサレムに来,きた。これはヤラベアムとその子,こらが彼,かれらを排斥,はいせきして、主,しゅの前,まえに祭司,さいしの務,つとめをさせなかったためである。","tok":[["すなわち"],["レビ"],["び"],["と"],["は"],["自分","じぶん"],["の"],["放牧","ほうぼく"],["地","ち"],["と"],["領地","りょうち"],["を"],["離れて","はなれて"],["ユダ"],["と"],["エルサレム"],["に"],["来た","きた"],["。"],["これ"],["は"],["ヤラベアム"],["と"],["その"],["子","こ"],["ら"],["が"],["彼","かれ"],["ら"],["を"],["排斥","はいせき"],["して"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["祭司","さいし"],["の"],["務め","つとめ"],["を"],["させなかった"],["ため"],["で"],["ある"],["。"]]},{"verse":15,"text":"ヤラベアムは高,たかき所,ところと、みだらな神,かみと、自分,じぶんで造,つくった子,こ牛,うしのために自分,じぶんの祭司,さいしを立,たてた。","tok":[["ヤラベアム"],["は"],["高き","たかき"],["所","ところ"],["と"],["、"],["みだら"],["な"],["神","かみ"],["と"],["、"],["自分","じぶん"],["で"],["造った","つくった"],["子牛","こうし"],["の"],["ため"],["に"],["自分","じぶん"],["の"],["祭司","さいし"],["を"],["立てた","たてた"],["。"]]},{"verse":16,"text":"またイスラエルのすべての部族,ぶぞくのうちで、すべてその心,こころを傾,かたむけて、イスラエルの神,かみ、主,しゅを求,もとめる者,ものは先祖,せんぞの神,かみ、主,しゅに犠牲,ぎせいをささげるために、レビびとに従,したがってエルサレムに来,きた。","tok":[["また"],["イスラエル"],["の"],["すべて"],["の"],["部族","ぶぞく"],["の"],["うち"],["で"],["、"],["すべて"],["その"],["心","こころ"],["を"],["傾むけて","かたむけて"],["、"],["イスラエル"],["の"],["神","かみ"],["、"],["主","しゅ"],["を"],["求める","もとめる"],["者","もの"],["は"],["先祖","せんぞ"],["の"],["神","かみ"],["、"],["主に","しゅに"],["犠牲","ぎせい"],["を"],["ささげる"],["ため"],["に"],["、"],["レビ"],["びと"],["に"],["従って","したがって"],["エルサレム"],["に"],["来た","きた"],["。"]]},{"verse":17,"text":"このように彼,かれらはユダの国,くにを堅,かたくし、ソロモンの子,こレハベアムを三年,ねんの間,あいだ強,つよくした。彼,かれらは三年,ねんの間,あいだダビデとソロモンの道,みちに歩,あゆんだからである。","tok":[["この"],["よう"],["に"],["彼","かれ"],["ら"],["は"],["ユダ"],["の"],["国","くに"],["を"],["堅く","かたく"],["し"],["、"],["ソロモン"],["の"],["子","こ"],["レハベアム"],["を"],["三","さん"],["年","ねん"],["の"],["間","あいだ"],["強く","つよく"],["した"],["。"],["彼","かれ"],["ら"],["は"],["三","さん"],["年","ねん"],["の"],["間","あいだ"],["ダビデ"],["と"],["ソロモン"],["の"],["道","みち"],["に"],["歩んだ","あゆんだ"],["から"],["で"],["ある"],["。"]]},{"verse":18,"text":"レハベアムはダビデの子,こエレモテの娘,むすめマハラテを妻,つまにめとった。マハラテはエッサイの子,こエリアブの娘,むすめアビハイルが産,うんだ者,ものである。","tok":[["レハベアム"],["は"],["ダビデ"],["の"],["子","こ"],["エレモテ"],["の"],["娘","むすめ"],["マハラテ"],["を"],["妻","つま"],["に"],["めとった"],["。"],["マハラテ"],["は"],["エッサイ"],["の"],["子","こ"],["エリアブ"],["の"],["娘","むすめ"],["アビハイル"],["が"],["産んだ","うんだ"],["者","もの"],["で"],["ある"],["。"]]},{"verse":19,"text":"彼女,かのじょはエウシ、シマリヤおよびザハムの三子,しを産,うんだ。","tok":[["彼女","かのじょ"],["は"],["エウシ"],["、"],["シマリヤ"],["および"],["ザハム"],["の"],["三子","し"],["を"],["産んだ","うんだ"],["。"]]},{"verse":20,"text":"彼,かれはまた彼女,かのじょの後,のちにアブサロムの娘,むすめマアカをめとった。マアカはアビヤ、アッタイ、ジザおよびシロミテを産,うんだ。","tok":[["彼","かれ"],["は"],["また"],["彼女","かのじょ"],["の"],["後","のち"],["に"],["アブサロム"],["の"],["娘","むすめ"],["マアカ"],["を"],["めとった"],["。"],["マアカ"],["は"],["アビヤ"],["、"],["アッタイ"],["、"],["ジザ"],["および"],["シロミテ"],["を"],["産んだ","うんだ"],["。"]]},{"verse":21,"text":"レハベアムはアブサロムの娘,むすめマアカをすべての妻,つまとそばめにまさって愛,あいした。彼,かれは妻,つま十八人,にん、そばめ六十人,にんをめとって、男,おとこの子,こ二十八人,にんと女,おんなの子,こ六十人,にんをもうけた。","tok":[["レハベアム"],["は"],["アブサロム"],["の"],["娘","むすめ"],["マアカ"],["を"],["すべて"],["の"],["妻","つま"],["と"],["そばめ"],["に"],["まさって"],["愛した","あいした"],["。"],["彼","かれ"],["は"],["妻","つま"],["十八人","にん"],["、"],["そばめ"],["六","ろく"],["十人","じゅうにん"],["を"],["めとって"],["、"],["男の子","おとこのこ"],["二十八人","にん"],["と"],["女の子","おんなのこ"],["六","ろく"],["十人","じゅうにん"],["を"],["もうけた"],["。"]]},{"verse":22,"text":"レハベアムはマアカの子,こアビヤを立,たててかしらとし、その兄弟,きょうだいの長,ちょうとした。彼,かれはアビヤを王,おうにしようと思,おもったからである。","tok":[["レハベアム"],["は"],["マアカ"],["の"],["子","こ"],["アビヤ"],["を"],["立てて","たてて"],["かしら"],["と"],["し"],["、"],["その"],["兄弟","きょうだい"],["の"],["長","ちょう"],["と"],["した"],["。"],["彼","かれ"],["は"],["アビヤ"],["を"],["王","おう"],["に"],["しよう"],["と"],["思った","おもった"],["から"],["で"],["ある"],["。"]]},{"verse":23,"text":"それで王,おうは賢,かしこくとり行,おこない、そのむすこたちをことごとく、ユダとベニヤミンの全,ぜん地方,ちほうにあるすべての要害,ようがいの町,まちに散在,さんざいさせ、彼,かれらに糧食,りょうしょくを多,おおく与,あたえ、また多,おおくの妻,つまを得,えさせた。","tok":[["それ"],["で"],["王","おう"],["は"],["賢しこく","かしこく"],["とり行ない","とりおこない"],["、"],["その"],["むすこ"],["たち"],["を"],["ことごとく"],["、"],["ユダ"],["と"],["ベニヤミン"],["の"],["全","ぜん"],["地方","ちほう"],["に"],["ある"],["すべて"],["の"],["要害","ようがい"],["の"],["町","まち"],["に"],["散在","さんざい"],["させ"],["、"],["彼","かれ"],["ら"],["に"],["糧食","りょうしょく"],["を"],["多く","おおく"],["与","あたえ"],["、"],["また"],["多く","おおく"],["の"],["妻","つま"],["を"],["得させた","えさせた"],["。"]]}]
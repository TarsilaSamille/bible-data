[{"verse":1,"text":"第,だい七年,ねんになって、エホヤダは勇気,ゆうきをだしてエロハムの子,こアザリヤ、ヨハナンの子,こイシマエル、オベデの子,こアザリヤ、アダヤの子,こマアセヤ、ジクリの子,こエリシャパテなどの百人,にんの長,ちょうたちを招,まねいて契約,けいやくを結,むすばせた。","tok":[["第","だい"],["七","なな"],["年","ねん"],["に"],["なって"],["、"],["エホヤダ"],["は"],["勇気","ゆうき"],["を"],["だして"],["エロハム"],["の"],["子","こ"],["アザリヤ"],["、"],["ヨハナン"],["の"],["子","こ"],["イシマエル"],["、"],["オベデ"],["の"],["子","こ"],["アザリヤ"],["、"],["アダヤ"],["の"],["子","こ"],["マアセヤ"],["、"],["ジクリ"],["の"],["子","こ"],["エリシャパテ"],["など"],["の"],["百人","にん"],["の"],["長","ちょう"],["たち"],["を"],["招いて","まねいて"],["契約","けいやく"],["を"],["結ばせた","むすばせた"],["。"]]},{"verse":2,"text":"そこで彼,かれらはユダを行,いきめぐって、ユダのすべての町,まちからレビびとを集,あつめ、またイスラエルの氏族,しぞくの長,ちょうたちを集,あつめて、エルサレムに来,きた。","tok":[["そこ"],["で"],["彼","かれ"],["ら"],["は"],["ユダ"],["を"],["行き","いき"],["めぐって"],["、"],["ユダ"],["の"],["すべて"],["の"],["町","まち"],["から"],["レビ"],["びと"],["を"],["集め","あつめ"],["、"],["また"],["イスラエル"],["の"],["氏族","しぞく"],["の"],["長","ちょう"],["たち"],["を"],["集めて","あつめて"],["、"],["エルサレム"],["に"],["来た","きた"],["。"]]},{"verse":3,"text":"そしてその会衆,かいしゅうは皆,みな神,かみの宮,みやで王,おうと契約,けいやくを結,むすんだ。その時,ときエホヤダは彼,かれらに言,いった、「主,しゅがダビデの子孫,しそんのことについて言,いわれたように、王,おうの子,こが位,くらいにつくべきです。","tok":[["そして"],["その"],["会衆","かいしゅう"],["は"],["皆神","みなかみ"],["の"],["宮","みや"],["で"],["王","おう"],["と"],["契約","けいやく"],["を"],["結んだ","むすんだ"],["。"],["その"],["時","とき"],["エホヤダ"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["主","しゅ"],["が"],["ダビデ"],["の"],["子孫","しそん"],["の"],["こと"],["について"],["言われた","いわれた"],["よう"],["に"],["、"],["王","おう"],["の"],["子","こ"],["が"],["位","くらい"],["に"],["つくべきです"],["。"]]},{"verse":4,"text":"あなたがたのなすべき事,ことはこれです。すなわちあなたがた祭司,さいしおよびレビびとの安息日,あんそくにちにはいって来,くる者,ものの、三分,ぶんの一は門,もんを守,まもる者,ものとなり、","tok":[["あなた"],["がた"],["の"],["なすべき"],["事","こと"],["は"],["これ"],["です"],["。"],["すなわち"],["あなた"],["がた"],["祭司","さいし"],["および"],["レビ"],["びと"],["の"],["安息日","あんそくにち"],["に"],["はいって"],["来る","くる"],["者","もの"],["の"],["、"],["三分","ぶん"],["の"],["一","いち"],["は"],["門","もん"],["を"],["守者","まもるもの"],["と"],["なり"],["、"]]},{"verse":5,"text":"三分,ぶんの一は王,おうの家,いえにおり、三分,ぶんの一は礎,いしずえの門,もんにおり、民,たみは皆,みな、主,しゅの宮,みやの庭,にわにいなさい。","tok":[["三分","ぶん"],["の"],["一","いち"],["は"],["王","おう"],["の"],["家","いえ"],["に"],["おり"],["、"],["三分","ぶん"],["の"],["一","いち"],["は"],["礎","いしずえ"],["の"],["門","もん"],["に"],["おり"],["、"],["民","たみ"],["は"],["皆","みな"],["、"],["主","しゅ"],["の"],["宮","みや"],["の"],["庭","にわ"],["に"],["い"],["なさい"],["。"]]},{"verse":6,"text":"祭司,さいしと、勤,つとめをするレビびとのほかは、だれも主,しゅの宮,みやに、はいってはならない。彼,かれらは聖,せいなる者,ものであるから、はいることができる。民,たみは皆,みな、主,しゅの命令,めいれいを守,まもらなければならない。","tok":[["祭司","さいし"],["と"],["、"],["勤め","つとめ"],["を"],["する"],["レビ"],["びと"],["の"],["ほか"],["は"],["、"],["だれ"],["も"],["主","しゅ"],["の"],["宮","みや"],["に"],["、"],["はいって"],["は"],["ならない"],["。"],["彼","かれ"],["ら"],["は"],["聖","せい"],["なる"],["者","もの"],["で"],["ある"],["から"],["、"],["はいる"],["こと"],["が"],["できる"],["。"],["民","たみ"],["は"],["皆","みな"],["、"],["主","しゅ"],["の"],["命令","めいれい"],["を"],["守らなければ","まもらなければ"],["ならない"],["。"]]},{"verse":7,"text":"レビびとはめいめい手,てに武器,ぶきをとって王,おうのまわりに立,たたなければならない。宮,みやにはいる者,ものをすべて殺,ころしなさい。あなたがたは王,おうがはいる時,ときにも出,でる時,ときにも、王,おうと共,ともにいなさい」。","tok":[["レビ"],["び"],["と"],["は"],["めいめい"],["手","て"],["に"],["武器","ぶき"],["を"],["とって"],["王","おう"],["の"],["まわり"],["に"],["立たなければ","たたなければ"],["ならない"],["。"],["宮","みや"],["に"],["はいる"],["者","もの"],["を"],["すべて"],["殺ろし","ころし"],["なさい"],["。"],["あなた"],["がた"],["は"],["王","おう"],["が"],["はいる"],["時","とき"],["に"],["も"],["出る","でる"],["時","とき"],["に"],["も"],["、"],["王","おう"],["と"],["共","とも"],["に"],["い"],["なさい"],["」"],["。"]]},{"verse":8,"text":"そこでレビびとおよびユダの人々,ひとびとは、祭司,さいしエホヤダがすべて命,めいじたように行,おこない、めいめいその組,くみの者,もので、安息日,あんそくにちにはいって来,くるべき者,ものと、安息日,あんそくにちに出,でて行,いくべき者,ものを率,ひきいていた。祭司,さいしエホヤダが組,くみの者,ものを去,さらせなかったからである。","tok":[["そこ"],["で"],["レビ"],["び"],["と"],["および"],["ユダ"],["の"],["人々","ひとびと"],["は"],["、"],["祭司","さいし"],["エホヤダ"],["が"],["すべて"],["命じた","めいじた"],["よう"],["に"],["行ない","おこない"],["、"],["めいめい"],["その"],["組","くみ"],["の"],["者","もの"],["で"],["、"],["安息日","あんそくにち"],["に"],["はいって"],["来るべき","くるべき"],["者","もの"],["と"],["、"],["安息日","あんそくにち"],["に"],["出て","でて"],["行くべき","いくべき"],["者","もの"],["を"],["率いて","ひきいて"],["いた"],["。"],["祭司","さいし"],["エホヤダ"],["が"],["組","くみ"],["の"],["者","もの"],["を"],["去らせなかった","さらせなかった"],["から"],["で"],["ある"],["。"]]},{"verse":9,"text":"また祭司,さいしエホヤダは、神,かみの宮,みやにあるダビデ王,おうのやりおよび大盾,おおだて、小盾,こだてを百人,にんの長,ちょうたちに渡,わたし、","tok":[["また"],["祭司","さいし"],["エホヤダ"],["は"],["、"],["神","かみ"],["の"],["宮","みや"],["に"],["ある"],["ダビデ"],["王","おう"],["の"],["やり"],["および"],["大","だい"],["盾","たて"],["おだて"],["、"],["小","こ"],["盾","たて"],["を"],["百人","にん"],["の"],["長","ちょう"],["たち"],["に"],["渡","わたし"],["、"]]},{"verse":10,"text":"また王,おうを守,まもるために、すべての民,たみにめいめい手,てに武器,ぶきをとらせ、宮,みやの南側,みなみがわから北側,きたがわにわたって、祭壇,さいだんと宮,みやに沿,そって立,たたせた。","tok":[["また"],["王","おう"],["を"],["守","まもる"],["ため"],["に"],["、"],["すべて"],["の"],["民","たみ"],["に"],["めいめい"],["手","て"],["に"],["武器","ぶき"],["を"],["とらせ"],["、"],["宮","みや"],["の"],["南側","みなみがわ"],["から"],["北側","きたがわ"],["に"],["わたって"],["、"],["祭壇","さいだん"],["と"],["宮","みや"],["に"],["沿って","そって"],["立たせた","たたせた"],["。"]]},{"verse":11,"text":"こうして王,おうの子,こを連,つれ出,だして、これに冠,かんむりをいただかせ、あかしの書,しょを渡,わたして王,おうとなし、エホヤダおよびその子,こたちが彼,かれに油,あぶらを注,そそいだ。そして「王,おう万歳,ばんざい」と言,いった。","tok":[["こう"],["して"],["王","おう"],["の"],["子","こ"],["を"],["連れ出して","つれだして"],["、"],["これ"],["に"],["冠","かんむり"],["を"],["いただかせ"],["、"],["あかし"],["の"],["書","しょ"],["を"],["渡","わたし"],["て"],["王","おう"],["と"],["なし"],["、"],["エホヤダ"],["および"],["その"],["子","こ"],["たち"],["が"],["彼","かれ"],["に"],["油","あぶら"],["を"],["注いだ","そそいだ"],["。"],["そして"],["「"],["王","おう"],["万歳","ばんざい"],["」"],["と"],["言った","いった"],["。"]]},{"verse":12,"text":"アタリヤは民,たみの走,はしりながら王,おうをほめる声,こえを聞,きいたので、主,しゅの宮,みやに入,いり、民,たみの所,ところへ行,いって、","tok":[["アタリヤ"],["は"],["民","たみ"],["の"],["走り","はしり"],["ながら"],["王","おう"],["を"],["ほめる"],["声","こえ"],["を"],["聞いた","きいた"],["ので"],["、"],["主","しゅ"],["の"],["宮","みや"],["に"],["入","いり"],["、"],["民","たみ"],["の"],["所","ところ"],["へ"],["行って","いって"],["、"]]},{"verse":13,"text":"見,みると、王,おうは入口,いりぐちで柱,はしらのかたわらに立,たち、王,おうのかたわらには将軍,しょうぐんたちとラッパ手,てが立,たっており、また国,くにの民,たみは皆,みな喜,よろこんでラッパを吹,ふき、歌,うたをうたう者,ものは楽器,がっきをもってさんびしていたので、アタリヤは衣,ころもを裂,さいて「反逆,はんぎゃくだ、反逆,はんぎゃくだ」と叫,さけんだ。","tok":[["見る","みる"],["と"],["、"],["王","おう"],["は"],["入口","いりぐち"],["で"],["柱","はしら"],["の"],["かたわら"],["に"],["立ち","たち"],["、"],["王","おう"],["の"],["かたわら"],["に"],["は"],["将軍","しょうぐん"],["たち"],["と"],["ラッパ手","らっぱて"],["が"],["立って","たって"],["おり"],["、"],["また"],["国","くに"],["の"],["民","たみ"],["は"],["皆","みな"],["喜こんで","よろこんで"],["ラッパ"],["を"],["吹","ふき"],["、"],["歌","うた"],["を"],["うたう"],["者","もの"],["は"],["楽器","がっき"],["を"],["もって"],["さん"],["び"],["して"],["いた"],["ので"],["、"],["アタリヤ"],["は"],["衣","ころも"],["を"],["裂いて","さいて"],["「"],["反逆","はんぎゃく"],["だ"],["、"],["反逆","はんぎゃく"],["だ"],["」"],["と"],["叫けんだ","さけんだ"],["。"]]},{"verse":14,"text":"その時,ときエホヤダは軍勢,ぐんぜいを統率,とうそつする百人,にんの長,ちょうたちを呼,よび出,だし、「列,れつの間,あいだから彼女,かのじょを連,つれ出,だせ、彼女,かのじょに従,したがう者,ものをつるぎで殺,ころせ」と言,いった。祭司,さいしが彼女,かのじょを主,しゅの宮,みやで殺,ころしてはならないと言,いったからである。","tok":[["その"],["時","とき"],["エホヤダ"],["は"],["軍勢","ぐんぜい"],["を"],["統率","とうそつ"],["する"],["百人","にん"],["の"],["長","ちょう"],["たち"],["を"],["呼び出し","よびだし"],["、"],["「"],["列","れつ"],["の"],["間","あいだ"],["から"],["彼女","かのじょ"],["を"],["連れ出せ","つれだせ"],["、"],["彼女","かのじょ"],["に"],["従う","したがう"],["者","もの"],["を"],["つるぎ"],["で"],["殺ろせ","ころせ"],["」"],["と"],["言った","いった"],["。"],["祭司","さいし"],["が"],["彼女","かのじょ"],["を"],["主","しゅ"],["の"],["宮","みや"],["で"],["殺ろし","ころし"],["ては"],["ならない"],["と"],["言った","いった"],["から"],["で"],["ある"],["。"]]},{"verse":15,"text":"そこで人々,ひとびとは彼女,かのじょに手,てをかけ、王,おうの家,いえの馬,うまの門,もんの入口,いりぐちまで連,つれて行,いき、その所,ところで彼女,かのじょを殺,ころした。","tok":[["そこ"],["で"],["人々","ひとびと"],["は"],["彼女","かのじょ"],["に"],["手","て"],["を"],["かけ"],["、"],["王","おう"],["の"],["家","いえ"],["の"],["馬","うま"],["の"],["門","もん"],["の"],["入口","いりぐち"],["まで"],["連れて","つれて"],["行き","いき"],["、"],["その"],["所","ところ"],["で"],["彼女","かのじょ"],["を"],["殺ろした","ころした"],["。"]]},{"verse":16,"text":"エホヤダは自分,じぶんとすべての民,たみと王,おうとの間,あいだに、彼,かれらは皆,みな、主,しゅの民,たみとなるとの契約,けいやくを結,むすんだ。","tok":[["エホヤダ"],["は"],["自分","じぶん"],["と"],["すべて"],["の"],["民","たみ"],["と"],["王","おう"],["と"],["の"],["間","あいだ"],["に"],["、"],["彼","かれ"],["ら"],["は"],["皆","みな"],["、"],["主","しゅ"],["の"],["民","たみ"],["と"],["なる"],["と"],["の"],["契約","けいやく"],["を"],["結んだ","むすんだ"],["。"]]},{"verse":17,"text":"そこですべての民,たみはバアルの家,いえに行,いって、それをこわし、その祭壇,さいだんとその像,ぞうとを打,うち砕,くだき、バアルの祭司,さいしマッタンを祭壇,さいだんの前,まえで殺,ころした。","tok":[["そこ"],["で"],["すべて"],["の"],["民","たみ"],["は"],["バアル"],["の"],["家","いえ"],["に"],["行って","いって"],["、"],["それ"],["を"],["こわし"],["、"],["その"],["祭壇","さいだん"],["と"],["その"],["像","ぞう"],["と"],["を"],["打ち砕き","うちくだき"],["、"],["バアル"],["の"],["祭司","さいし"],["マッタン"],["を"],["祭壇","さいだん"],["の"],["前","まえ"],["で"],["殺ろした","ころした"],["。"]]},{"verse":18,"text":"エホヤダはまた主,しゅの宮,みやの守衛,しゅえいを、祭司,さいしとレビびとの指揮,しきのもとに置,おいた。このレビびとは昔,むかしダビデがモーセの律法,りっぽうにしるされているように、喜,よろこびと歌,うたとをもって主,しゅに燔祭,はんさいをささげるために、主,しゅの宮,みやに配置,はいちしたものであって、今,いまそのダビデの例,れいにならったものである。","tok":[["エホヤダ"],["は"],["また"],["主","しゅ"],["の"],["宮","みや"],["の"],["守衛","しゅえい"],["を"],["、"],["祭司","さいし"],["と"],["レビ"],["びと"],["の"],["指揮","しき"],["の"],["もと"],["に"],["置いた","おいた"],["。"],["この"],["レビ"],["び"],["と"],["は"],["昔","むかし"],["ダビデ"],["が"],["モーセ"],["の"],["律法","りっぽう"],["に"],["しるされて"],["いる"],["よう"],["に"],["、"],["喜こび","よろこび"],["と"],["歌","うた"],["と"],["を"],["もって"],["主に","しゅに"],["燔祭","はんさい"],["を"],["ささげる"],["ため"],["に"],["、"],["主","しゅ"],["の"],["宮","みや"],["に"],["配置","はいち"],["した"],["もの"],["で"],["あって"],["、"],["今","いま"],["その"],["ダビデ"],["の"],["例","れい"],["に"],["ならった"],["もの"],["で"],["ある"],["。"]]},{"verse":19,"text":"彼,かれはまた主,しゅの宮,みやのもろもろの門,もんに門衛,もんえいを置,おき、汚,けがれた者,ものは何,なにによって汚,けがれた者,ものでも、はいらせないようにした。","tok":[["彼","かれ"],["は"],["また"],["主","しゅ"],["の"],["宮","みや"],["の"],["もろもろ"],["の"],["門","もん"],["に"],["門衛","もんえい"],["を"],["置き","おき"],["、"],["汚","け"],["がれ"],["た"],["者","もの"],["は"],["何に","なに"],["によって"],["汚","け"],["がれ"],["た"],["者","もの"],["で"],["も"],["、"],["はいらせない"],["よう"],["に"],["した"],["。"]]},{"verse":20,"text":"こうしてエホヤダは百人,にんの長,ちょうたち、貴族,きぞくたち、民,たみのつかさたちおよび国,くにのすべての民,たみを率,ひきいて、主,しゅの宮,みやから王,おうを連,つれ下,くだり、上,うえの門,もんから王,おうの家,いえに進,すすみ、王,おうを国,くにの位,くらいにつかせた。","tok":[["こう"],["して"],["エホヤダ"],["は"],["百人","にん"],["の"],["長","ちょう"],["たち"],["、"],["貴族","きぞく"],["たち"],["、"],["民","たみ"],["の"],["つかさ"],["たち"],["および"],["国","くに"],["の"],["すべて"],["の"],["民","たみ"],["を"],["率いて","ひきいて"],["、"],["主","しゅ"],["の"],["宮","みや"],["から"],["王","おう"],["を"],["連れ","つれ"],["下り","くだり"],["、"],["上","うえ"],["の"],["門","もん"],["から"],["王","おう"],["の"],["家","いえ"],["に"],["進み","すすみ"],["、"],["王","おう"],["を"],["国","くに"],["の"],["位","くらい"],["に"],["つかせた"],["。"]]},{"verse":21,"text":"国,くにの民,たみは皆,みな喜,よろこんだ。町,まちはアタリヤがつるぎで殺,ころされた後,のち、穏,おだやかであった。","tok":[["国","くに"],["の"],["民","たみ"],["は"],["皆","みな"],["喜こんだ","よろこんだ"],["。"],["町","まち"],["は"],["アタリヤ"],["が"],["つるぎ"],["で"],["殺ろされた","ころされた"],["後","の"],["ち"],["、"],["穏","おだやか"],["で"],["あった"],["。"]]}]
[{"verse":1,"text":"レハベアムはシケムへ行,いった。すべてのイスラエルびとが彼,かれを王,おうにしようとシケムへ行,いったからである。","tok":[["レハベアム"],["は"],["シケム"],["へ"],["行った","いった"],["。"],["すべて"],["の"],["イスラエル"],["びと"],["が"],["彼","かれ"],["を"],["王","おう"],["に"],["しよう"],["と"],["シケム"],["へ"],["行った","いった"],["から"],["で"],["ある"],["。"]]},{"verse":2,"text":"ネバテの子,こヤラベアムは、ソロモンを避,さけてエジプトにのがれていたが、これを聞,きいてエジプトから帰,かえったので、","tok":[["ネバテ"],["の"],["子","こ"],["ヤラベアム"],["は"],["、"],["ソロモン"],["を"],["避けて","さけて"],["エジプト"],["に"],["のがれて"],["いた"],["が"],["、"],["これ"],["を"],["聞いて","きいて"],["エジプト"],["から"],["帰えった","かえった"],["ので"],["、"]]},{"verse":3,"text":"人々,ひとびとは人,ひとをつかわして彼,かれを招,まねいた。そこでヤラベアムとすべてのイスラエルは来,きて、レハベアムに言,いった、","tok":[["人々","ひとびと"],["は"],["人","ひと"],["を"],["つかわして"],["彼","かれ"],["を"],["招いた","まねいた"],["。"],["そこ"],["で"],["ヤラベアム"],["と"],["すべて"],["の"],["イスラエル"],["は"],["来て","きて"],["、"],["レハベアム"],["に"],["言った","いった"],["、"]]},{"verse":4,"text":"「あなたの父,ちちは、われわれのくびきを重,おもくしましたが、今,いまあなたの父,ちちのきびしい使役,しえきと、あなたの父,ちちが、われわれに負,おわせた重,おもいくびきを軽,かるくしてください。そうすればわたしたちはあなたに仕,つかえましょう」。","tok":[["「"],["あなた"],["の"],["父","ちち"],["は"],["、"],["われわれ"],["の"],["くびき"],["を"],["重く","おもく"],["しました"],["が"],["、"],["今","いま"],["あなた"],["の"],["父","ちち"],["の"],["きびしい"],["使役","しえき"],["と"],["、"],["あなた"],["の"],["父","ちち"],["が"],["、"],["われわれ"],["に"],["負わせた","おわせた"],["重い","おもい"],["くびき"],["を"],["軽く","かるく"],["して"],["ください"],["。"],["そう"],["すれば"],["わたしたち"],["は"],["あなた"],["に"],["仕えましょう","つかえましょう"],["」"],["。"]]},{"verse":5,"text":"レハベアムは彼,かれらに答,こたえた、「三日,かの後,のち、またわたしの所,ところに来,きなさい」。それで民,たみは去,さった。","tok":[["レハベアム"],["は"],["彼","かれ"],["ら"],["に"],["答","こたえ"],["た"],["、"],["「"],["三日","か"],["の"],["後","の"],["ち"],["、"],["また"],["わたし"],["の"],["所","ところ"],["に"],["来","き"],["なさい"],["」"],["。"],["それ"],["で"],["民","たみ"],["は"],["去た","さった"],["。"]]},{"verse":6,"text":"レハベアム王,おうは父,ちちソロモンの存命,ぞんめい中,ちゅうソロモンに仕,つかえた長老,ちょうろうたちに相談,そうだんして言,いった、「あなたがたはこの民,たみにどう返答,へんとうすればよいと思,おもいますか」。","tok":[["レハベアム"],["王","おう"],["は"],["父","ちち"],["ソロモン"],["の"],["存命中","ぞんめいちゅう"],["ソロモン"],["に"],["仕えた","つかえた"],["長老","ちょうろう"],["たち"],["に"],["相談","そうだん"],["して"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["この"],["民","たみ"],["に"],["どう"],["返答","へんとう"],["すれば"],["よい"],["と"],["思います","おもいます"],["か"],["」"],["。"]]},{"verse":7,"text":"彼,かれらはレハベアムに言,いった、「あなたがもしこの民,たみを親切,しんせつにあつかい、彼,かれらを喜,よろこばせ、ねんごろに語,かたられるならば彼,かれらは長,ながくあなたのしもべとなるでしょう」。","tok":[["彼","かれ"],["ら"],["は"],["レハベアム"],["に"],["言った","いった"],["、"],["「"],["あなた"],["が"],["もし"],["この"],["民","たみ"],["を"],["親切","しんせつ"],["に"],["あつかい"],["、"],["彼","かれ"],["ら"],["を"],["喜こばせ","よろこばせ"],["、"],["ねんごろ"],["に"],["語られるならば","かたられるならば"],["彼","かれ"],["ら"],["は"],["長く","ながく"],["あなた"],["の"],["しもべ"],["と"],["なるでしょう"],["」"],["。"]]},{"verse":8,"text":"しかし彼,かれは長老,ちょうろうたちが与,あたえた勧,すすめをすてて、自分,じぶんと一緒,いっしょに大,おおきくなって自分,じぶんに仕,つかえている若者,わかものたちに相談,そうだんして、","tok":[["しかし"],["彼","かれ"],["は"],["長老","ちょうろう"],["たち"],["が"],["与","あたえ"],["た"],["勧め","すすめ"],["を"],["すてて"],["、"],["自分","じぶん"],["と"],["一緒","いっしょ"],["に"],["大きく","おおきく"],["なって"],["自分","じぶん"],["に"],["仕えて","つかえて"],["いる"],["若者","わかもの"],["たち"],["に"],["相談","そうだん"],["して"],["、"]]},{"verse":9,"text":"彼,かれらに言,いった、「あなたがたは、この民,たみがわたしに向,むかって、『あなたの父上,ちちうえが、われわれに負,おわせたくびきを軽,かるくしてください』と言,いうのに、われわれはなんと返答,へんとうすればよいと思,おもいますか」。","tok":[["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["、"],["この"],["民","たみ"],["が"],["わたし"],["に"],["向かって","むかって"],["、"],["『"],["あなた"],["の"],["父","ちち"],["上","うえ"],["が"],["、"],["われわれ"],["に"],["負わせた","おわせた"],["くびき"],["を"],["軽く","かるく"],["して"],["ください"],["』"],["と"],["言う","いう"],["のに"],["、"],["われわれ"],["は"],["なん"],["と"],["返答","へんとう"],["すれば"],["よい"],["と"],["思います","おもいます"],["か"],["」"],["。"]]},{"verse":10,"text":"彼,かれと一緒,いっしょに大,おおきくなった若者,わかものたちは彼,かれに言,いった、「あなたに向,むかって、『あなたの父,ちちは、われわれのくびきを重,おもくしたが、あなたは、それをわれわれのために軽,かるくしてください』と言,いったこの民,たみに、こう言,いいなさい、『わたしの小指,こゆびは父,ちちの腰,こしよりも太,ふとい、","tok":[["彼","かれ"],["と"],["一緒","いっしょ"],["に"],["大きく","おおきく"],["なった"],["若者","わかもの"],["たち"],["は"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["に"],["向かって","むかって"],["、"],["『"],["あなた"],["の"],["父","ちち"],["は"],["、"],["われわれ"],["の"],["くびき"],["を"],["重く","おもく"],["した"],["が"],["、"],["あなた"],["は"],["、"],["それ"],["を"],["われわれ"],["の"],["ため"],["に"],["軽く","かるく"],["して"],["ください"],["』"],["と"],["言った","いった"],["この"],["民","たみ"],["に"],["、"],["こう"],["言い","いい"],["なさい"],["、"],["『"],["わたし"],["の"],["小指","こゆび"],["は"],["父","ちち"],["の"],["腰","こし"],["より"],["も"],["太い","ふとい"],["、"]]},{"verse":11,"text":"父,ちちはあなたがたに重,おもいくびきを負,おわせたが、わたしはさらに、あなたがたのくびきを重,おもくしよう。父,ちちはむちであなたがたを懲,こらしたが、わたしはさそりであなたがたを懲,こらそう』」。","tok":[["父","ちち"],["は"],["あなた"],["がた"],["に"],["重い","おもい"],["くびき"],["を"],["負わせた","おわせた"],["が"],["、"],["わたし"],["は"],["さらに"],["、"],["あなた"],["がた"],["の"],["くびき"],["を"],["重く","おもく"],["しよう"],["。"],["父","ちち"],["は"],["むち"],["で"],["あなた"],["がた"],["を"],["懲らした","こらした"],["が"],["、"],["わたし"],["は"],["さそり"],["で"],["あなた"],["がた"],["を"],["懲らそう","こらそう"],["』"],["」"],["。"]]},{"verse":12,"text":"さてヤラベアムと民,たみは皆,みな、王,おうが「三日,か目,めにわたしのところに来,きなさい」と言,いったとおりに、三日,か目,めにレハベアムのところへ行,いった。","tok":[["さて"],["ヤラベアム"],["と"],["民","たみ"],["は"],["皆","みな"],["、"],["王","おう"],["が"],["「"],["三日目","かめ"],["に"],["わたし"],["の"],["ところ"],["に"],["来","き"],["なさい"],["」"],["と"],["言った","いった"],["とおり"],["に"],["、"],["三日目","かめ"],["に"],["レハベアム"],["の"],["ところ"],["へ"],["行った","いった"],["。"]]},{"verse":13,"text":"王,おうは荒々,あらあらしく彼,かれらに答,こたえた。すなわちレハベアム王,おうは長老,ちょうろうたちの勧,すすめをすて、","tok":[["王","おう"],["は"],["荒々しく","あらあらしく"],["彼","かれ"],["ら"],["に"],["答","こたえ"],["た"],["。"],["すなわち"],["レハベアム"],["王","おう"],["は"],["長老","ちょうろう"],["たち"],["の"],["勧め","すすめ"],["を"],["すて"],["、"]]},{"verse":14,"text":"若者,わかものたちの勧,すすめに従,したがい、彼,かれらに告,つげて言,いった、「父,ちちはあなたがたのくびきを重,おもくしたが、わたしは更,さらにこれを重,おもくしよう。父,ちちはむちであなたがたを懲,こらしたが、わたしはさそりであなたがたを懲,こらそう」。","tok":[["若者","わかもの"],["たち"],["の"],["勧め","すすめ"],["に"],["従い","したがい"],["、"],["彼","かれ"],["ら"],["に"],["告","つげ"],["て"],["言った","いった"],["、"],["「"],["父","ちち"],["は"],["あなた"],["がた"],["の"],["くびき"],["を"],["重く","おもく"],["した"],["が"],["、"],["わたし"],["は"],["更に","さらに"],["これ"],["を"],["重く","おもく"],["しよう"],["。"],["父","ちち"],["は"],["むち"],["で"],["あなた"],["がた"],["を"],["懲らした","こらした"],["が"],["、"],["わたし"],["は"],["さそり"],["で"],["あなた"],["がた"],["を"],["懲らそう","こらそう"],["」"],["。"]]},{"verse":15,"text":"このように王,おうは民,たみの言,いうことを聞,ききいれなかった。これは主,しゅが、かつてシロびとアヒヤによって、ネバテの子,こヤラベアムに言,いわれた言葉,ことばを成就,じょうじゅするために、神,かみがなされたのであった。","tok":[["この"],["よう"],["に"],["王","おう"],["は"],["民","たみ"],["の"],["言う","いう"],["こと"],["を"],["聞きいれなかった","ききいれなかった"],["。"],["これ"],["は"],["主","しゅ"],["が"],["、"],["かつて"],["シロ"],["び"],["と"],["アヒヤ"],["によって"],["、"],["ネバテ"],["の"],["子","こ"],["ヤラベアム"],["に"],["言われた","いわれた"],["言葉","ことば"],["を"],["成就","じょうじゅ"],["する"],["ため"],["に"],["、"],["神","かみ"],["が"],["なされた"],["ので"],["あった"],["。"]]},{"verse":16,"text":"イスラエルの人々,ひとびとは皆,みな、王,おうが自分,じぶんたちの言,いうことを聞,ききいれないのを見,みたので、民,たみは王,おうに答,こたえて言,いった、「われわれはダビデのうちに何,なにの分,ぶんがあろうか。われわれはエッサイの子,このうちに嗣,し業,ぎょうがない。イスラエルよ、めいめいの天幕,てんまくに帰,かえれ。ダビデよ、今,いまあなたの家,いえを見,みよ」。そしてイスラエルは皆,みな彼,かれらの天幕,てんまくへ去,さって行,いった。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["は"],["皆","みな"],["、"],["王","おう"],["が"],["自分","じぶん"],["たち"],["の"],["言う","いう"],["こと"],["を"],["聞きいれない","ききいれない"],["の"],["を"],["見た","みた"],["ので"],["、"],["民","たみ"],["は"],["王","おう"],["に"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["われわれ"],["は"],["ダビデ"],["の"],["うち"],["に"],["何","なに"],["の"],["分","ぶん"],["が"],["あろう"],["か"],["。"],["われわれ"],["は"],["エッサイ"],["の"],["子","こ"],["の"],["うち"],["に"],["嗣業","しぎょう"],["が"],["ない"],["。"],["イスラエル"],["よ"],["、"],["めいめい"],["の"],["天幕","てんまく"],["に"],["帰えれ","かえれ"],["。"],["ダビデ"],["よ"],["、"],["今","いま"],["あなた"],["の"],["家","いえ"],["を"],["見よ","みよ"],["」"],["。"],["そして"],["イスラエル"],["は"],["皆","みな"],["彼","かれ"],["ら"],["の"],["天幕","てんまく"],["へ"],["去て","さって"],["行った","いった"],["。"]]},{"verse":17,"text":"しかしレハベアムはユダの町々,まちまちに住,すんでいるイスラエルの人々,ひとびとを治,おさめた。","tok":[["しかし"],["レハベアム"],["は"],["ユダ"],["の"],["町々","まちまち"],["に"],["住んで","すんで"],["いる"],["イスラエル"],["の"],["人々","ひとびと"],["を"],["治めた","おさめた"],["。"]]},{"verse":18,"text":"レハベアム王,おうは徴募,ちょうぼ人,にんの監督,かんとくであったアドラムをつかわしたが、イスラエルの人々,ひとびとが石,いしで彼,かれを撃,うち殺,ころしたので、レハベアム王,おうは急,いそいで車,くるまに乗,のり、エルサレムに逃,にげた。","tok":[["レハベアム"],["王","おう"],["は"],["徴募人","ちょうぼにん"],["の"],["監督","かんとく"],["で"],["あった"],["アドラム"],["を"],["つかわした"],["が"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["が"],["石","いし"],["で"],["彼","かれ"],["を"],["撃ち殺した","うちころした"],["ので"],["、"],["レハベアム"],["王","おう"],["は"],["急いで","いそいで"],["車","くるま"],["に"],["乗","のり"],["、"],["エルサレム"],["に"],["逃た","にげた"],["。"]]},{"verse":19,"text":"こうしてイスラエルはダビデの家,いえにそむいて今日,こんにちに至,いたった。","tok":[["こう"],["して"],["イスラエル"],["は"],["ダビデ"],["の"],["家","いえ"],["に"],["そむいて"],["今日","こんにち"],["に"],["至った","いたった"],["。"]]}]
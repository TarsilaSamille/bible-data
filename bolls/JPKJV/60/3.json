[{"verse":1,"text":"同,おなじように、妻,つまたる者,ものよ。夫,おっとに仕,つかえなさい。そうすれば、たとい御言,みことばに従,したがわない夫,おっとであっても、","tok":[["同じ","おなじ"],["よう"],["に"],["、"],["妻","つま"],["たる"],["者","もの"],["よ"],["。"],["夫","おっと"],["に"],["仕え","つかえ"],["なさい"],["。"],["そう"],["すれば"],["、"],["たとい"],["御言","みこと"],["ば"],["に"],["従わない","したがわない"],["夫","おっと"],["で"],["あって"],["も"],["、"]]},{"verse":2,"text":"あなたがたのうやうやしく清,きよい行,おこないを見,みて、その妻,つまの無言,むごんの行,おこないによって、救,すくいに入,いれられるようになるであろう。","tok":[["あなた"],["がた"],["の"],["うやうやしく"],["清い","きよい"],["行ない","おこない"],["を"],["見て","みて"],["、"],["その"],["妻","つま"],["の"],["無言","むごん"],["の"],["行ない","おこない"],["によって"],["、"],["救い","すくい"],["に"],["入れられる","いれられる"],["よう"],["に"],["なるで"],["あろう"],["。"]]},{"verse":3,"text":"あなたがたは、髪,かみを編,あみ、金,きんの飾,かざりをつけ、服装,ふくそうをととのえるような外,がい面,めんの飾,かざりではなく、","tok":[["あなた"],["がた"],["は"],["、"],["髪","かみ"],["を"],["編み","あみ"],["、"],["金","きん"],["の"],["飾","かざり"],["を"],["つけ"],["、"],["服装","ふくそう"],["を"],["ととのえる"],["よう"],["な"],["外","が"],["い"],["面","めん"],["の"],["飾","かざり"],["で"],["は"],["なく"],["、"]]},{"verse":4,"text":"かくれた内,うちなる人,ひと、柔和,にゅうわで、しとやかな霊,れいという朽,くちることのない飾,かざりを、身,みにつけるべきである。これこそ、神,かみのみまえに、きわめて尊,たっといものである。","tok":[["かくれた"],["内","うち"],["なる"],["人","ひと"],["、"],["柔和","にゅうわ"],["で"],["、"],["しとやか"],["な"],["霊","れい"],["と"],["いう"],["朽ちる","くちる"],["こと"],["の"],["ない"],["飾","かざり"],["を"],["、"],["身","み"],["に"],["つけるべきで"],["ある"],["。"],["これ"],["こそ"],["、"],["神","かみ"],["のみ"],["まえ"],["に"],["、"],["きわめて"],["尊","たっといも"],["ので"],["ある"],["。"]]},{"verse":5,"text":"むかし、神,かみを仰,あおぎ望,のぞんでいた聖,せいなる女,おんなたちも、このように身,みを飾,かざって、その夫,おっとに仕,つかえたのである。","tok":[["むかし"],["、"],["神","かみ"],["を"],["仰ぎ","あおぎ"],["望んで","のぞんで"],["いた"],["聖","せい"],["なる"],["女","おんな"],["たち"],["も"],["、"],["この"],["よう"],["に"],["身","み"],["を"],["飾って","かざって"],["、"],["その"],["夫","おっと"],["に"],["仕えた","つかえた"],["ので"],["ある"],["。"]]},{"verse":6,"text":"たとえば、サラはアブラハムに仕,つかえて、彼,かれを主,しゅと呼,よんだ。あなたがたも、何事,なにごとにもおびえ臆,おくすることなく善,ぜんを行,おこなえば、サラの娘,むすめたちとなるのである。","tok":[["たとえば"],["、"],["サラ"],["は"],["アブラハム"],["に"],["仕えて","つかえて"],["、"],["彼","かれ"],["を"],["主","しゅ"],["と"],["呼んだ","よんだ"],["。"],["あなた"],["がた"],["も"],["、"],["何事","なにごと"],["に"],["も"],["おびえ"],["臆する","おくする"],["こと"],["なく"],["善","ぜん"],["を"],["行なえば","おこなえば"],["、"],["サラ"],["の"],["娘","むすめ"],["たち"],["と"],["なる"],["ので"],["ある"],["。"]]},{"verse":7,"text":"夫,おっとたる者,ものよ。あなたがたも同,おなじように、女,おんなは自分,じぶんよりも弱,よわい器,うつわであることを認,みとめて、知識,ちしきに従,したがって妻,つまと共,ともに住,すみ、いのちの恵,めぐみを共,ともどもに受,うけ継,つぐ者,ものとして、尊,たっとびなさい。それは、あなたがたの祈,いのりが妨,さまたげられないためである。","tok":[["夫","おっと"],["たる"],["者","もの"],["よ"],["。"],["あなた"],["がた"],["も"],["同じ","おなじ"],["よう"],["に"],["、"],["女","おんな"],["は"],["自分","じぶん"],["より"],["も"],["弱い","よわい"],["器","うつわ"],["で"],["ある"],["こと"],["を"],["認めて","みとめて"],["、"],["知識","ちしき"],["に"],["従って","したがって"],["妻","つま"],["と"],["共","とも"],["に"],["住み","すみ"],["、"],["いのち"],["の"],["恵","めぐみ"],["を"],["共ども","ともども"],["に"],["受け継ぐ","うけつぐ"],["者","もの"],["として"],["、"],["尊","た"],["っと"],["び"],["なさい"],["。"],["それ"],["は"],["、"],["あなた"],["がた"],["の"],["祈","いのり"],["が"],["妨げられない","さまたげられない"],["ため"],["で"],["ある"],["。"]]},{"verse":8,"text":"最後,さいごに言,いう。あなたがたは皆,みな、心,こころをひとつにし、同情,どうじょうし合,あい、兄弟,きょうだい愛,あいをもち、あわれみ深,ぶかくあり、謙虚,けんきょでありなさい。","tok":[["最後","さいご"],["に"],["言う","いう"],["。"],["あなた"],["がた"],["は"],["皆","みな"],["、"],["心","こころ"],["を"],["ひと"],["つ"],["に"],["し"],["、"],["同情","どうじょう"],["し"],["合い","あい"],["、"],["兄弟","きょうだい"],["愛","あい"],["を"],["もち"],["、"],["あわれみ"],["深","ぶ"],["かく"],["あり"],["、"],["謙虚","けんきょ"],["で"],["あり"],["なさい"],["。"]]},{"verse":9,"text":"悪,あくをもって悪,あくに報,むくいず、悪口,あっこうをもって悪口,あっこうに報,むくいず、かえって、祝福,しゅくふくをもって報,むくいなさい。あなたがたが召,めされたのは、祝福,しゅくふくを受,うけ継,つぐためなのである。","tok":[["悪","あく"],["を"],["もって"],["悪","あく"],["に"],["報いず","むくいず"],["、"],["悪口","あっこう"],["を"],["もって"],["悪口","あっこう"],["に"],["報いず","むくいず"],["、"],["かえって"],["、"],["祝福","しゅくふく"],["を"],["もって"],["報い","むくい"],["なさい"],["。"],["あなた"],["がた"],["が"],["召された","めされた"],["の"],["は"],["、"],["祝福","しゅくふく"],["を"],["受け継ぐ","うけつぐ"],["ため"],["な"],["ので"],["ある"],["。"]]},{"verse":10,"text":"「いのちを愛,あいし、さいわいな日々,ひびを過,すごそうと願,ねがう人,ひとは、舌,したを制,せいして悪,あくを言,いわず、くちびるを閉,とじて偽,いつわりを語,かたらず、","tok":[["「"],["いのち"],["を"],["愛し","あいし"],["、"],["さいわい"],["な"],["日々","ひび"],["を"],["過ごそう","すごそう"],["と"],["願う","ねがう"],["人","ひと"],["は"],["、"],["舌","した"],["を"],["制して","せいして"],["悪","あく"],["を"],["言わず","いわず"],["、"],["くちびる"],["を"],["閉じて","とじて"],["偽り","いつわり"],["を"],["語らず","かたらず"],["、"]]},{"verse":11,"text":"悪,あくを避,さけて善,ぜんを行,おこない、平和,へいわを求,もとめて、これを追,おえ。","tok":[["悪","あく"],["を"],["避けて","さけて"],["善","ぜん"],["を"],["行ない","おこない"],["、"],["平和","へいわ"],["を"],["求めて","もとめて"],["、"],["これ"],["を"],["追え","おえ"],["。"]]},{"verse":12,"text":"主,しゅの目,めは義人,ぎじんたちに注,そそがれ、主,しゅの耳,みみは彼,かれらの祈,いのりにかたむく。しかし主,しゅの御顔,みかおは、悪,あくを行,おこなう者,ものに対,たいして向,むかう」。","tok":[["主","しゅ"],["の"],["目","め"],["は"],["義人","ぎじん"],["たち"],["に"],["注がれ","そそがれ"],["、"],["主","しゅ"],["の"],["耳","みみ"],["は"],["彼","かれ"],["ら"],["の"],["祈","いのり"],["に"],["かたむく"],["。"],["しかし"],["主","しゅ"],["の"],["御顔","みかお"],["は"],["、"],["悪","あく"],["を"],["行なう","おこなう"],["者","もの"],["に対して","にたいして"],["向かう","むかう"],["」"],["。"]]},{"verse":13,"text":"そこで、もしあなたがたが善,ぜんに熱心,ねっしんであれば、だれが、あなたがたに危害,きがいを加,くわえようか。","tok":[["そこ"],["で"],["、"],["もし"],["あなた"],["がた"],["が"],["善","ぜん"],["に"],["熱心","ねっしん"],["で"],["あれば"],["、"],["だれ"],["が"],["、"],["あなた"],["がた"],["に"],["危害","きがい"],["を"],["加えよう","くわえよう"],["か"],["。"]]},{"verse":14,"text":"しかし、万一,まんいち義,ぎのために苦,くるしむようなことがあっても、あなたがたはさいわいである。彼,かれらを恐,おそれたり、心,こころを乱,みだしたりしてはならない。","tok":[["しかし"],["、"],["万一","まんいち"],["義","ぎ"],["の"],["ため"],["に"],["苦しむ","くるしむ"],["よう"],["な"],["こと"],["が"],["あって"],["も"],["、"],["あなた"],["がた"],["は"],["さいわい"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["を"],["恐","おそれ"],["たり"],["、"],["心","こころ"],["を"],["乱し","みだし"],["たり"],["して"],["は"],["ならない"],["。"]]},{"verse":15,"text":"ただ、心,こころの中,なかでキリストを主,しゅとあがめなさい。また、あなたがたのうちにある望,のぞみについて説明,せつめいを求,もとめる人,ひとには、いつでも弁明,べんめいのできる用意,よういをしていなさい。","tok":[["ただ"],["、"],["心","こころ"],["の"],["中","なか"],["で"],["キリスト"],["を"],["主","しゅ"],["と"],["あがめ"],["なさい"],["。"],["また"],["、"],["あなた"],["がた"],["の"],["うち"],["に"],["ある"],["望み","のぞみ"],["について"],["説明","せつめい"],["を"],["求める","もとめる"],["人","ひと"],["に"],["は"],["、"],["いつ"],["で"],["も"],["弁明","べんめい"],["の"],["できる"],["用意","ようい"],["を"],["して"],["い"],["なさい"],["。"]]},{"verse":16,"text":"しかし、やさしく、慎,つつしみ深,ぶかく、明,あきらかな良心,りょうしんをもって、弁明,べんめいしなさい。そうすれば、あなたがたがキリストにあって営,いとなんでいる良,よい生活,せいかつをそしる人々,ひとびとも、そのようにののしったことを恥,はじいるであろう。","tok":[["しかし"],["、"],["やさしく"],["、"],["慎しみ深く","つつしみぶかく"],["、"],["明か","あきらか"],["な"],["良心","りょうしん"],["を"],["もって"],["、"],["弁明","べんめい"],["し"],["なさい"],["。"],["そう"],["すれば"],["、"],["あなた"],["がた"],["が"],["キリスト"],["に"],["あって"],["営なんで","いとなんで"],["いる"],["良い","よい"],["生活","せいかつ"],["を"],["そしる"],["人々","ひとびと"],["も"],["、"],["その"],["よう"],["に"],["ののしった"],["こと"],["を"],["恥","はじ"],["いるで"],["あろう"],["。"]]},{"verse":17,"text":"善,ぜんをおこなって苦,くるしむことは――それが神,かみの御旨,みむねであれば――悪,あくをおこなって苦,くるしむよりも、まさっている。","tok":[["善","ぜん"],["を"],["おこなって"],["苦しむ","くるしむ"],["こと"],["は"],["―"],["―"],["それ"],["が"],["神","かみ"],["の"],["御旨","み"],["むね"],["で"],["あれば"],["―"],["―"],["悪","あく"],["を"],["おこなって"],["苦しむ","くるしむ"],["より"],["も"],["、"],["まさって"],["いる"],["。"]]},{"verse":18,"text":"キリストも、あなたがたを神,かみに近づけようとして、自,みずからは義,ぎなるかたであるのに、不義,ふぎなる人々,ひとびとのために、ひとたび罪,つみのゆえに死,しなれた。ただし、肉,にくにおいては殺,ころされたが、霊,れいにおいては生,いかされたのである。","tok":[["キリスト"],["も"],["、"],["あなた"],["がた"],["を"],["神","かみ"],["に"],["近づけよう","ちかづけよう"],["として"],["、"],["自から","みずから"],["は"],["義","ぎ"],["なる"],["かた"],["で"],["ある"],["のに"],["、"],["不義","ふぎ"],["なる"],["人々","ひとびと"],["の"],["ため"],["に"],["、"],["ひとたび"],["罪","つみ"],["の"],["ゆえ"],["に"],["死なれた","しなれた"],["。"],["ただし"],["、"],["肉","にく"],["に"],["おいて"],["は"],["殺ろされた","ころされた"],["が"],["、"],["霊","れい"],["に"],["おいて"],["は"],["生かされた","いかされた"],["ので"],["ある"],["。"]]},{"verse":19,"text":"こうして、彼,かれは獄,ごくに捕,とらわれている霊,れいどものところに下,くだって行,いき、宣,のべ伝,つたえることをされた。","tok":[["こう"],["して"],["、"],["彼","かれ"],["は"],["獄","ごく"],["に"],["捕らわれて","とらわれて"],["いる"],["霊","れい"],["ども"],["の"],["ところ"],["に"],["下って","くだって"],["行き","いき"],["、"],["宣べ伝える","のべつたえる"],["こと"],["を"],["された"],["。"]]},{"verse":20,"text":"これらの霊,れいというのは、むかしノアの箱舟,はこぶねが造,つくられていた間,あいだ、神,かみが寛容,かんようをもって待,まっておられたのに従,したがわなかった者,ものどものことである。その箱舟,はこぶねに乗,のり込,こみ、水,みずを経,へて救,すくわれたのは、わずかに八名,めいだけであった。","tok":[["これ"],["ら"],["の"],["霊","れい"],["と"],["いう"],["の"],["は"],["、"],["むかし"],["ノア"],["の"],["箱舟","はこぶね"],["が"],["造られて","つくられて"],["いた"],["間","あいだ"],["、"],["神","かみ"],["が"],["寛容","かんよう"],["を"],["もって"],["待って","まって"],["おられた"],["のに"],["従わなかった","したがわなかった"],["者","もの"],["ども"],["の"],["こと"],["で"],["ある"],["。"],["その"],["箱舟","はこぶね"],["に"],["乗込","のりこみ"],["、"],["水","みず"],["を"],["経て","へて"],["救われた","すくわれた"],["の"],["は"],["、"],["わずか"],["に"],["八","はち"],["名","めい"],["い"],["だけ"],["で"],["あった"],["。"]]},{"verse":21,"text":"この水,みずはバプテスマを象徴,しょうちょうするものであって、今,いまやあなたがたをも救,すくうのである。それは、イエス・キリストの復活,ふっかつによるのであって、からだの汚,けがれを除,のぞくことではなく、明,あきらかな良心,りょうしんを神,かみに願,ねがい求,もとめることである。","tok":[["この"],["水","みず"],["は"],["バプテスマ"],["を"],["象徴","しょうちょう"],["する"],["もの"],["で"],["あって"],["、"],["今","いま"],["や"],["あなた"],["がた"],["を"],["も"],["救う","すくう"],["ので"],["ある"],["。"],["それ"],["は"],["、"],["イエス"],["・"],["キリスト"],["の"],["復活","ふっかつ"],["に"],["よる"],["ので"],["あって"],["、"],["からだ"],["の"],["汚","けがれ"],["を"],["除く","のぞく"],["こと"],["で"],["は"],["なく"],["、"],["明か","あきらか"],["な"],["良心","りょうしん"],["を"],["神","かみ"],["に"],["願い求める","ねがいもとめる"],["こと"],["で"],["ある"],["。"]]},{"verse":22,"text":"キリストは天,てんに上,のぼって神,かみの右,みぎに座,ざし、天使,てんしたちともろもろの権威,けんい、権力,けんりょくを従,したがえておられるのである。","tok":[["キリスト"],["は"],["天","てん"],["に"],["上って","のぼって"],["神","かみ"],["の"],["右","みぎ"],["に"],["座し","ざし"],["、"],["天使","てんし"],["たち"],["と"],["もろもろ"],["の"],["権威","けんい"],["、"],["権力","けんりょく"],["を"],["従えて","したがえて"],["おられる"],["ので"],["ある"],["。"]]}]
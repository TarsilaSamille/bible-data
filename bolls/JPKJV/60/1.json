[{"verse":1,"text":"イエス・キリストの使徒,しとペテロから、ポント、ガラテヤ、カパドキヤ、アジヤおよびビテニヤに離散,りさんし寄留,きりゅうしている人,ひとたち、","tok":[["イエス"],["・"],["キリスト"],["の"],["使徒","しと"],["ペテロ"],["から"],["、"],["ポント"],["、"],["ガラテヤ"],["、"],["カパドキヤ"],["、"],["アジヤ"],["および"],["ビテニヤ"],["に"],["離散","りさん"],["し"],["寄留","きりゅう"],["して"],["いる"],["人","ひと"],["たち"],["、"]]},{"verse":2,"text":"すなわち、イエス・キリストに従,したがい、かつ、その血,ちのそそぎを受,うけるために、父,ちちなる神,かみの予知,よちされたところによって選,えらばれ、御霊,みたまのきよめにあずかっている人,ひとたちへ。恵,めぐみと平安,へいあんとが、あなたがたに豊,ゆたかに加,くわわるように。","tok":[["すなわち"],["、"],["イエス"],["・"],["キリスト"],["に"],["従い","したがい"],["、"],["かつ"],["、"],["その"],["血","ち"],["の"],["そそぎ"],["を"],["受る","うける"],["ため"],["に"],["、"],["父","ちち"],["なる"],["神","かみ"],["の"],["予知","よち"],["された"],["ところ"],["によって"],["選ら","えら"],["ばれ"],["、"],["御霊","みたま"],["の"],["きよめ"],["に"],["あずかって"],["いる"],["人","ひと"],["たち"],["へ"],["。"],["恵","めぐみ"],["と"],["平安","へいあん"],["と"],["が"],["、"],["あなた"],["がた"],["に"],["豊","ゆたか"],["に"],["加わわる","くわわる"],["よう"],["に"],["。"]]},{"verse":3,"text":"ほむべきかな、わたしたちの主,しゅイエス・キリストの父,ちちなる神,かみ。神,かみは、その豊,ゆたかなあわれみにより、イエス・キリストを死人,しにんの中,なかからよみがえらせ、それにより、わたしたちを新,あらたに生,うまれさせて生,いける望,のぞみをいだかせ、","tok":[["ほ"],["むべき"],["か"],["な"],["、"],["わたしたち"],["の"],["主","しゅ"],["イエス"],["・"],["キリスト"],["の"],["父","ちち"],["なる"],["神","かみ"],["。"],["神","かみ"],["は"],["、"],["その"],["豊","ゆたか"],["な"],["あわれみ"],["に"],["より"],["、"],["イエス"],["・"],["キリスト"],["を"],["死人","しにん"],["の"],["中","なか"],["から"],["よみがえらせ"],["、"],["それ"],["に"],["より"],["、"],["わたしたち"],["を"],["新らた","あらた"],["に"],["生まれさせて","うまれさせて"],["生ける","いける"],["望み","のぞみ"],["を"],["いだかせ"],["、"]]},{"verse":4,"text":"あなたがたのために天,てんにたくわえてある、朽,くちず汚,けがれず、しぼむことのない資産,しさんを受,うけ継,つぐ者,ものとして下,くださったのである。","tok":[["あなた"],["がた"],["の"],["ため"],["に"],["天","てん"],["に"],["たくわえて"],["ある"],["、"],["朽ちず","くちず"],["汚","け"],["がれ"],["ず"],["、"],["しぼむ"],["こと"],["の"],["ない"],["資産","しさん"],["を"],["受け継ぐ","うけつぐ"],["者","もの"],["として"],["下さった","くださった"],["ので"],["ある"],["。"]]},{"verse":5,"text":"あなたがたは、終,おわりの時,ときに啓示,けいじさるべき救,すくいにあずかるために、信仰,しんこうにより神,かみの御,み力,ちからに守,まもられているのである。","tok":[["あなた"],["がた"],["は"],["、"],["終","おわり"],["の"],["時","とき"],["に"],["啓示","けいじ"],["さるべき"],["救い","すくい"],["に"],["あずかる"],["ため"],["に"],["、"],["信仰","しんこう"],["に"],["より"],["神","かみ"],["の"],["御力","みちから"],["に"],["守られて","まもられて"],["いる"],["ので"],["ある"],["。"]]},{"verse":6,"text":"そのことを思,おもって、今,いましばらくのあいだは、さまざまな試錬,しれんで悩,なやまねばならないかも知,しれないが、あなたがたは大,おおいに喜,よろこんでいる。","tok":[["その"],["こと"],["を"],["思って","おもって"],["、"],["今","いま"],["しばらく"],["の"],["あいだ"],["は"],["、"],["さまざま"],["な"],["試錬","しれん"],["で"],["悩まねば","なやまねば"],["ならない"],["か"],["も"],["知れない","しれない"],["が"],["、"],["あなた"],["がた"],["は"],["大いに","おおいに"],["喜こんで","よろこんで"],["いる"],["。"]]},{"verse":7,"text":"こうして、あなたがたの信仰,しんこうはためされて、火,ひで精錬,せいれんされても朽,くちる外,ほかはない金,きんよりもはるかに尊,たっといことが明,あきらかにされ、イエス・キリストの現,あらわれるとき、さんびと栄光,えいこうとほまれとに変,かわるであろう。","tok":[["こう"],["して"],["、"],["あなた"],["がた"],["の"],["信仰","しんこう"],["は"],["ためされて"],["、"],["火","ひ"],["で"],["精錬","せいれん"],["されて"],["も"],["朽ちる","くちる"],["外","ほか"],["は"],["ない"],["金","きん"],["より"],["も"],["はるか"],["に"],["尊","たっといこ"],["と"],["が"],["明か","あきらか"],["に"],["され"],["、"],["イエス"],["・"],["キリスト"],["の"],["現われる","あらわれる"],["とき"],["、"],["さん"],["びと"],["栄光","えいこう"],["と"],["ほまれ"],["と"],["に"],["変わるで","かわるで"],["あろう"],["。"]]},{"verse":8,"text":"あなたがたは、イエス・キリストを見,みたことはないが、彼,かれを愛,あいしている。現在,げんざい、見,みてはいないけれども、信,しんじて、言葉,ことばにつくせない、輝,かがやきにみちた喜,よろこびにあふれている。","tok":[["あなた"],["がた"],["は"],["、"],["イエス"],["・"],["キリスト"],["を"],["見た","みた"],["こと"],["は"],["ない"],["が"],["、"],["彼","かれ"],["を"],["愛して","あいして"],["いる"],["。"],["現在","げんざい"],["、"],["見て","みて"],["は"],["いない"],["けれど"],["も"],["、"],["信じて","しんじて"],["、"],["言葉","ことば"],["に"],["つくせない"],["、"],["輝やき","かがやき"],["に"],["みちた"],["喜こび","よろこび"],["に"],["あふれて"],["いる"],["。"]]},{"verse":9,"text":"それは、信仰,しんこうの結果,けっかなるたましいの救,すくいを得,えているからである。","tok":[["それ"],["は"],["、"],["信仰","しんこう"],["の"],["結果","けっか"],["なる"],["たましい"],["の"],["救い","すくい"],["を"],["得て","えて"],["いる"],["から"],["で"],["ある"],["。"]]},{"verse":10,"text":"この救,すくいについては、あなたがたに対,たいする恵,めぐみのことを預言,よげんした預言者,よげんしゃたちも、たずね求,もとめ、かつ、つぶさに調,しらべた。","tok":[["この"],["救い","すくい"],["について"],["は"],["、"],["あなた"],["がた"],["に"],["対する","たいする"],["恵","めぐみ"],["の"],["こと"],["を"],["預言","よげん"],["した"],["預言者","よげんしゃ"],["たち"],["も"],["、"],["たずね求め","たずねもとめ"],["、"],["かつ"],["、"],["つぶさに"],["調べた","しらべた"],["。"]]},{"verse":11,"text":"彼,かれらは、自分,じぶんたちのうちにいますキリストの霊,れいが、キリストの苦難,くなんとそれに続,つづく栄光,えいこうとを、あらかじめあかしした時,とき、それは、いつの時,とき、どんな場合,ばあいをさしたのかを、調,しらべたのである。","tok":[["彼","かれ"],["ら"],["は"],["、"],["自分","じぶん"],["たち"],["の"],["うち"],["に"],["います"],["キリスト"],["の"],["霊","れい"],["が"],["、"],["キリスト"],["の"],["苦難","くなん"],["と"],["それ"],["に"],["続く","つづく"],["栄光","えいこう"],["と"],["を"],["、"],["あらかじめ"],["あかし"],["した"],["時","とき"],["、"],["それ"],["は"],["、"],["いつ"],["の"],["時","とき"],["、"],["どんな"],["場合","ばあい"],["を"],["さした"],["の"],["か"],["を"],["、"],["調べた","しらべた"],["ので"],["ある"],["。"]]},{"verse":12,"text":"そして、それらについて調,しらべたのは、自分,じぶんたちのためではなくて、あなたがたのための奉仕,ほうしであることを示,しめされた。それらの事,ことは、天,てんからつかわされた聖霊,せいれいに感,かんじて福音,ふくいんをあなたがたに宣,のべ伝,つたえた人々,ひとびとによって、今,いまや、あなたがたに告,つげ知,しらされたのであるが、これは、御使,みつかいたちも、うかがい見,みたいと願,ねがっている事,ことである。","tok":[["そして"],["、"],["それ"],["ら"],["について"],["調べた","しらべた"],["の"],["は"],["、"],["自分","じぶん"],["たち"],["の"],["ため"],["で"],["は"],["なくて"],["、"],["あなた"],["がた"],["の"],["ため"],["の"],["奉仕","ほうし"],["で"],["ある"],["こと"],["を"],["示めされた","しめされた"],["。"],["それ"],["ら"],["の"],["事","こと"],["は"],["、"],["天","てん"],["から"],["つかわされた"],["聖霊","せいれい"],["に"],["感じて","かんじて"],["福音","ふくいん"],["を"],["あなた"],["がた"],["に"],["宣べ伝えた","のべつたえた"],["人々","ひとびと"],["によって"],["、"],["今","いま"],["や"],["、"],["あなた"],["がた"],["に"],["告","つげ"],["知らされた","しらされた"],["ので"],["ある"],["が"],["、"],["これ"],["は"],["、"],["御使","みつかいたち"],["も"],["、"],["うかがい見たい","うかがいみたい"],["と"],["願って","ねがって"],["いる"],["事","こと"],["で"],["ある"],["。"]]},{"verse":13,"text":"それだから、心,こころの腰,こしに帯,おびを締,しめ、身,みを慎,つつしみ、イエス・キリストの現,あらわれる時,ときに与,あたえられる恵,めぐみを、いささかも疑,うたがわずに待,まち望,のぞんでいなさい。","tok":[["それ"],["だ"],["から"],["、"],["心","こころ"],["の"],["腰","こし"],["に"],["帯","おび"],["を"],["締","しめ"],["、"],["身","み"],["を"],["慎しみ","つつしみ"],["、"],["イエス"],["・"],["キリスト"],["の"],["現われる","あらわれる"],["時","とき"],["に"],["与えられる","あたえられる"],["恵","めぐみ"],["を"],["、"],["いささか"],["も"],["疑がわず","うたがわず"],["に"],["待望んで","まちのぞんで"],["い"],["なさい"],["。"]]},{"verse":14,"text":"従順,じゅうじゅんな子供,こどもとして、無知,むちであった時代,じだいの欲情,よくじょうに従,したがわず、","tok":[["従順","じゅうじゅん"],["な"],["子供","こども"],["として"],["、"],["無知","むち"],["で"],["あった"],["時代","じだい"],["の"],["欲情","よくじょう"],["に"],["従わず","したがわず"],["、"]]},{"verse":15,"text":"むしろ、あなたがたを召,めして下,くださった聖,せいなるかたにならって、あなたがた自身,じしんも、あらゆる行,おこないにおいて聖,せいなる者,ものとなりなさい。","tok":[["むしろ"],["、"],["あなた"],["がた"],["を"],["召","めし"],["て"],["下さった","くださった"],["聖","せい"],["なる"],["かた"],["に"],["ならって"],["、"],["あなた"],["がた"],["自身","じしん"],["も"],["、"],["あらゆる"],["行ない","おこない"],["に"],["おいて"],["聖","せい"],["なる"],["者","もの"],["と"],["なり"],["なさい"],["。"]]},{"verse":16,"text":"聖書,せいしょに、「わたしが聖,せいなる者,ものであるから、あなたがたも聖,せいなる者,ものになるべきである」と書,かいてあるからである。","tok":[["聖書","せいしょ"],["に"],["、"],["「"],["わたし"],["が"],["聖","せい"],["なる"],["者","もの"],["で"],["ある"],["から"],["、"],["あなた"],["がた"],["も"],["聖","せい"],["なる"],["者","もの"],["に"],["なるべきで"],["ある"],["」"],["と"],["書いて","かいて"],["ある"],["から"],["で"],["ある"],["。"]]},{"verse":17,"text":"あなたがたは、人,ひとをそれぞれのしわざに応,おうじて、公平,こうへいにさばくかたを、父,ちちと呼,よんでいるからには、地上,ちじょうに宿,やどっている間,あいだを、おそれの心,こころをもって過,すごすべきである。","tok":[["あなた"],["がた"],["は"],["、"],["人","ひと"],["を"],["それぞれ"],["の"],["しわざ"],["に"],["応じて","おうじて"],["、"],["公平","こうへい"],["に"],["さばく"],["かた"],["を"],["、"],["父","ちち"],["と"],["呼んで","よんで"],["いる"],["から"],["に"],["は"],["、"],["地上","ちじょう"],["に"],["宿って","やどって"],["いる"],["間","あいだ"],["を"],["、"],["おそれ"],["の"],["心","こころ"],["を"],["もって"],["過ごすべきで","すごすべきで"],["ある"],["。"]]},{"verse":18,"text":"あなたがたのよく知,しっているとおり、あなたがたが先祖,せんぞ伝来,でんらいの空疎,くうそな生活,せいかつからあがない出,だされたのは、銀,ぎんや金,きんのような朽,くちる物,ものによったのではなく、","tok":[["あなた"],["がた"],["の"],["よく"],["知って","しって"],["いる"],["とおり"],["、"],["あなた"],["がた"],["が"],["先祖","せんぞ"],["伝来","でんらい"],["の"],["空疎","くうそ"],["な"],["生活","せいかつ"],["から"],["あがない"],["出された","だされた"],["の"],["は"],["、"],["銀","ぎん"],["や"],["金","きん"],["の"],["よう"],["な"],["朽ちる","くちる"],["物","もの"],["に"],["よった"],["ので"],["は"],["なく"],["、"]]},{"verse":19,"text":"きずも、しみもない小羊,こひつじのようなキリストの尊,たっとい血,ちによったのである。","tok":[["きず"],["も"],["、"],["しみ"],["も"],["ない"],["小羊","こひつじ"],["の"],["よう"],["な"],["キリスト"],["の"],["尊","た"],["っと"],["い"],["血","ち"],["に"],["よった"],["ので"],["ある"],["。"]]},{"verse":20,"text":"キリストは、天地,てんちが造,つくられる前,まえから、あらかじめ知,しられていたのであるが、この終,おわりの時,ときに至,いたって、あなたがたのために現,あらわれたのである。","tok":[["キリスト"],["は"],["、"],["天地","てんち"],["が"],["造られる","つくられる"],["前","まえ"],["から"],["、"],["あらかじめ"],["知られて","しられて"],["いた"],["ので"],["ある"],["が"],["、"],["この"],["終","おわり"],["の"],["時","とき"],["に"],["至って","いたって"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["現われた","あらわれた"],["ので"],["ある"],["。"]]},{"verse":21,"text":"あなたがたは、このキリストによって、彼,かれを死人,しにんの中,なかからよみがえらせて、栄光,えいこうをお与,あたえになった神,かみを信,しんじる者,ものとなったのであり、したがって、あなたがたの信仰,しんこうと望,のぞみとは、神,かみにかかっているのである。","tok":[["あなた"],["がた"],["は"],["、"],["この"],["キリスト"],["によって"],["、"],["彼","かれ"],["を"],["死人","しにん"],["の"],["中","なか"],["から"],["よみがえらせて"],["、"],["栄光","えいこう"],["を"],["お"],["与","あたえ"],["に"],["なった"],["神","かみ"],["を"],["信じる","しんじる"],["者","もの"],["と"],["なった"],["ので"],["あり"],["、"],["したがって"],["、"],["あなた"],["がた"],["の"],["信仰","しんこう"],["と"],["望み","のぞみ"],["と"],["は"],["、"],["神","かみ"],["に"],["かかって"],["いる"],["ので"],["ある"],["。"]]},{"verse":22,"text":"あなたがたは、真理,しんりに従,したがうことによって、たましいをきよめ、偽,いつわりのない兄弟,きょうだい愛,あいをいだくに至,いたったのであるから、互,たがいに心,こころから熱,あつく愛,あいし合,あいなさい。","tok":[["あなた"],["がた"],["は"],["、"],["真理","しんり"],["に"],["従う","したがう"],["こと"],["によって"],["、"],["たましい"],["を"],["きよめ"],["、"],["偽わり","いつわり"],["の"],["ない"],["兄弟","きょうだい"],["愛","あい"],["を"],["いだく"],["に"],["至った","いたった"],["ので"],["ある"],["から"],["、"],["互","たがい"],["に"],["心","こころ"],["から"],["熱く","あつく"],["愛し合い","あいしあい"],["なさい"],["。"]]},{"verse":23,"text":"あなたがたが新,あらたに生,うまれたのは、朽,くちる種,たねからではなく、朽,くちない種,たねから、すなわち、神,かみの変,かわることのない生,いける御言,みことばによったのである。","tok":[["あなた"],["がた"],["が"],["新らた","あらた"],["に"],["生まれた","うまれた"],["の"],["は"],["、"],["朽ちる","くちる"],["種","たね"],["から"],["で"],["は"],["なく"],["、"],["朽ちない","くちない"],["種","たね"],["から"],["、"],["すなわち"],["、"],["神","かみ"],["の"],["変わる","かわる"],["こと"],["の"],["ない"],["生ける","いける"],["御言","みこと"],["ば"],["に"],["よった"],["ので"],["ある"],["。"]]},{"verse":24,"text":"「人,ひとはみな草,くさのごとく、その栄華,えいがはみな草,くさの花,はなに似,にている。草,くさは枯,かれ、花,はなは散る。","tok":[["「"],["人","ひと"],["は"],["みな"],["草","くさ"],["の"],["ごとく"],["、"],["その"],["栄華","えいが"],["は"],["みな"],["草","くさ"],["の"],["花","はな"],["に"],["似て","にて"],["いる"],["。"],["草","くさ"],["は"],["枯","かれ"],["、"],["花","はな"],["は"],["散る","ちる"],["。"]]},{"verse":25,"text":"しかし、主,しゅの言葉,ことばは、とこしえに残,のこる」。これが、あなたがたに宣,のべ伝,つたえられた御言葉,みことばである。","tok":[["しかし"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["は"],["、"],["とこしえ"],["に"],["残る","のこる"],["」"],["。"],["これ"],["が"],["、"],["あなた"],["がた"],["に"],["宣べ伝えられた","のべつたえられた"],["御言葉","み"],["ことば"],["で"],["ある"],["。"]]}]
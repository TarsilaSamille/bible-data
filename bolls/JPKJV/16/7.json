ム"],["と"],["トンミム"],["を"],["帯","おび"],["る"],["祭司","さいし"],["の"],["起こる","おこる"],["まで"],["は"],["、"],["いと"],["聖","せい"],["なる"],["物","もの"],["を"],["食べて","たべて"],["は"],["ならぬ"],["と"],["言った","いった"],["。"]]},{"verse":66,"text":"会衆,かいしゅうは合,あわせて四万二千三百六十人,にんであった。","tok":[["会衆","かいしゅう"],["は"],["合","あわせ"],["て"],["四万二千三百六","よんまんにせんさんひゃくろく"],["十人","じゅうにん"],["で"],["あった"],["。"]]},{"verse":67,"text":"このほかに男女,だんじょの奴隷,どれいが七千三百三十七人,にん、歌,うたうたう者,ものが男女,だんじょ合,あわせて二百四十五人,にんあった。","tok":[["この"],["ほか"],["に"],["男女","だんじょ"],["の"],["奴隷","どれい"],["が"],["七千三百三十七","ななせんみつひゃくさんじゅうしち"],["人","にん"],["、"],["歌","うた"],["うたう"],["者","もの"],["が"],["男女","だんじょ"],["合","あわせ"],["て"],["二百四十五","にひゃくよんじゅうご"],["人","にん"],["あった"],["。"]]},{"verse":68,"text":"その馬,うまは七百三十六頭,とう、その騾馬,らばは二百四十五頭,とう、[69]そのらくだは四百三十五頭,とう、そのろばは六千七百二十頭,とうであった。","tok":[["その"],["馬","うま"],["は"],["七百三十六","ななひゃくさんじゅうろく"],["頭","とう"],["う"],["、"],["その"],["騾馬","らば"],["は"],["二百四十五","にひゃくよんじゅうご"],["頭","とう"],["う"],["、"],["["],["69"],["]"],["その"],["らくだ"],["は"],["四百三十五","よんひゃくさんじゅうご"],["頭","とう"],["う"],["、"],["その"],["ろば"],["は"],["六千七百二十","ろくせんななひゃくにじゅう"],["頭","とう"],["うで"],["あった"],["。"]]},{"verse":69,"text":"[70]氏族,しぞくの長,ちょうのうち工事,こうじのためにささげ物,ものをした人々,ひとびとがあった。総督,そうとくは金,きん一千ダリク、鉢,はち五十、祭司,さいしの衣服,いふく五百三十かさねを倉,くらに納,おさめた。","tok":[["["],["70"],["]"],["氏族","しぞく"],["の"],["長","ちょう"],["の"],["うち"],["工事","こうじ"],["の"],["ため"],["に"],["ささげ物","ささげもの"],["を"],["した"],["人々","ひとびと"],["が"],["あった"],["。"],["総督","そうとく"],["は"],["金一","きん一"],["千","せん"],["ダリク"],["、"],["鉢","は"],["ち"],["五十","ごじゅう"],["、"],["祭司","さいし"],["の"],["衣服","いふく"],["五百三十","ごひゃくさんじゅう"],["かさね"],["を"],["倉","くら"],["に"],["納","おさめ"],["た"],["。"]]},{"verse":70,"text":"[71]また氏族,しぞくの長,ちょうのうちのある人々,ひとびとは金,きん二万ダリク、銀,ぎん二千二百ミナを工事,こうじのために倉,くらに納,おさめた。","tok":[["["],["71"],["]"],["また"],["氏族","しぞく"],["の"],["長","ちょう"],["の"],["うち"],["の"],["ある"],["人々","ひとびと"],["は"],["金","きん"],["二万","にまん"],["ダリク"],["、"],["銀二","ぎん二"],["千二百","せんにひゃく"],["ミナ"],["を"],["工事","こうじ"],["の"],["ため"],["に"],["倉","くら"],["に"],["納","おさめ"],["た"],["。"]]},{"verse":71,"text":"[72]その他,たの民,たみの納,おさめたものは金,きん二万ダリク、銀,ぎん二千ミナ、祭司,さいしの衣服,いふく六十七かさねであった。","tok":[["["],["72"],["]"],["その"],["他","た"],["の"],["民","たみ"],["の"],["納","おさめ"],["た"],["もの"],["は"],["金","きん"],["二万","にまん"],["ダリク"],["、"],["銀二","ぎん二"],["千","せん"],["ミナ"],["、"],["祭司","さいし"],["の"],["衣服","いふく"],["六十七","ろくじゅうなな"],["かさね"],["で"],["あった"],["。"]]},{"verse":72,"text":"[73]こうして祭司,さいし、レビびと、門衛,もんえい、歌,うたうたう者,もの、民,たみのうちのある人々,ひとびと、宮,みやに仕,つかえるしもべたち、およびイスラエルびとは皆,みなその町々,まちまちに住,すんだ。イスラエルの人々,ひとびとはその町々,まちまちに住,すんで七月,がつになった。","tok":[["["],["73"],["]"],["こう"],["して"],["祭司","さいし"],["、"],["レビ"],["び"],["と"],["、"],["門衛","もんえい"],["、"],["歌","うた"],["うたう"],["者","もの"],["、"],["民","たみ"],["の"],["うち"],["の"],["ある"],["人々","ひとびと"],["、"],["宮","みや"],["に"],["仕える","つかえる"],["しもべ"],["たち"],["、"],["および"],["イスラエル"],["び"],["と"],["は"],["皆","みな"],["その"],["町々","まちまち"],["に"],["住んだ","すんだ"],["。"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["その"],["町々","まちまち"],["に"],["住んで","すんで"],["七","なな"],["月","がつ"],["に"],["なった"],["。"]]}]
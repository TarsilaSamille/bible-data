[{"verse":1,"text":"城壁,じょうへきが築,きずかれて、とびらを設,もうけ、さらに門衛,もんえい、歌,うたうたう者,ものおよびレビびとを任命,にんめいしたので、","tok":[["城壁","じょうへき"],["が"],["築かれて","きずかれて"],["、"],["とびら"],["を"],["設け","もうけ"],["、"],["さらに"],["門衛","もんえい"],["、"],["歌","うた"],["うたう"],["者","もの"],["および"],["レビ"],["びと"],["を"],["任命","にんめい"],["した"],["ので"],["、"]]},{"verse":2,"text":"わたしは、わたしの兄弟,きょうだいハナニと、城,しろのつかさハナニヤに命,めいじて、エルサレムを治,おさめさせた。彼,かれは多,おおくの者,ものにまさって忠信,ちゅうしんな、神,かみを恐,おそれる者,ものであったからである。","tok":[["わたし"],["は"],["、"],["わたし"],["の"],["兄弟","きょうだい"],["ハナニ"],["と"],["、"],["城","しろ"],["の"],["つかさ"],["ハナニヤ"],["に"],["命じて","めいじて"],["、"],["エルサレム"],["を"],["治めさせた","おさめさせた"],["。"],["彼","かれ"],["は"],["多く","おおく"],["の"],["者","もの"],["に"],["まさって"],["忠信","ちゅうしん"],["な"],["、"],["神","かみ"],["を"],["恐れる","おそれる"],["者","もの"],["で"],["あった"],["から"],["で"],["ある"],["。"]]},{"verse":3,"text":"わたしは彼,かれらに言,いった、「日,ひの暑,あつくなるまではエルサレムのもろもろの門,もんを開,ひらいてはならない。人々,ひとびとが立,たって守,まもっている間,あいだに門,もんを閉,とじさせ、貫,かんの木,きを差,させ。またエルサレムの住民,じゅうみんの中,なかから番兵,ばんぺいを立,たてて、おのおのにその所,ところを守,まもらせ、またおのおのの家,いえと向,むかい合,あう所,ところを守,まもらせよ」。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["日","ひ"],["の"],["暑く","あつく"],["なる"],["まで"],["は"],["エルサレム"],["の"],["もろもろ"],["の"],["門","もん"],["を"],["開らいて","ひらいて"],["は"],["ならない"],["。"],["人々","ひとびと"],["が"],["立って","たって"],["守って","まもって"],["いる"],["間","あいだ"],["に"],["門","もん"],["を"],["閉じさせ","とじさせ"],["、"],["貫の木","かんのき"],["を"],["差せ","させ"],["。"],["また"],["エルサレム"],["の"],["住民","じゅうみん"],["の"],["中","なか"],["から"],["番兵","ばんぺい"],["を"],["立てて","たてて"],["、"],["おのおの"],["に"],["その"],["所","ところ"],["を"],["守らせ","まもらせ"],["、"],["また"],["おのおの"],["の"],["家","いえ"],["と"],["向","むかい"],["合う","あう"],["所","ところ"],["を"],["守らせ","まもらせ"],["よ"],["」"],["。"]]},{"verse":4,"text":"町,まちは広,ひろくて大,おおきかったが、その内,うちの民,たみは少,すくなく、家々,いえいえはまだ建,たてられていなかった。","tok":[["町","まち"],["は"],["広くて","ひろくて"],["大きかった","おおきかった"],["が"],["、"],["その"],["内","うち"],["の"],["民","たみ"],["は"],["少く","すくなく"],["、"],["家々","いえいえ"],["は"],["まだ"],["建てられて","たてられて"],["いなかった"],["。"]]},{"verse":5,"text":"時,ときに神,かみはわたしの心,こころに、尊,たっとい人々,ひとびと、つかさおよび民,たみを集,あつめて、家系,かけいによってその名簿,めいぼをしらべようとの思,おもいを起,おこされた。わたしは最初,さいしょに上,のぼって来,きた人々,ひとびとの系図,けいずを発見,はっけんし、その中,なかにこのようにしるしてあるのを見,みいだした。","tok":[["時","とき"],["に"],["神","かみ"],["は"],["わたし"],["の"],["心","こころ"],["に"],["、"],["尊","た"],["っと"],["い"],["人々","ひとびと"],["、"],["つかさ"],["および"],["民","たみ"],["を"],["集めて","あつめて"],["、"],["家系","かけい"],["によって"],["その"],["名簿","めいぼ"],["を"],["しらべよう"],["と"],["の"],["思い","おもい"],["を"],["起こされた","おこされた"],["。"],["わたし"],["は"],["最初","さいしょ"],["に"],["上って","のぼって"],["来た","きた"],["人々","ひとびと"],["の"],["系図","けいず"],["を"],["発見","はっけん"],["し"],["、"],["その"],["中","なか"],["に"],["この"],["よう"],["に"],["しるして"],["ある"],["の"],["を"],["見いだした","みいだした"],["。"]]},{"verse":6,"text":"バビロンの王,おうネブカデネザルが捕,とらえ移,うつした捕囚,ほしゅうのうち、ゆるされてエルサレムおよびユダに上,のぼり、おのおの自分,じぶんの町,まちに帰,かえったこの州,しゅうの人々,ひとびとは次,つぎのとおりである。","tok":[["バビロン"],["の"],["王","おう"],["ネブカデネザル"],["が"],["捕らえ","とらえ"],["移した","うつした"],["捕囚","ほしゅう"],["の"],["うち"],["、"],["ゆるされて"],["エルサレム"],["および"],["ユダ"],["に"],["上り","のぼり"],["、"],["おのおの"],["自分","じぶん"],["の"],["町","まち"],["に"],["帰えった","かえった"],["この"],["州","しゅう"],["の"],["人々","ひとびと"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"]]},{"verse":7,"text":"彼,かれらはゼルバベル、エシュア、ネヘミヤ、アザリヤ、ラアミヤ、ナハマニ、モルデカイ、ビルシャン、ミスペレテ、ビグワイ、ネホム、バアナと一緒,いっしょに帰,かえってきた者,ものたちである。そのイスラエルの民,たみの人数,にんずうは次,つぎのとおりである。","tok":[["彼","かれ"],["ら"],["は"],["ゼルバベル"],["、"],["エシュア"],["、"],["ネヘミヤ"],["、"],["アザリヤ"],["、"],["ラアミヤ"],["、"],["ナハマニ"],["、"],["モルデカイ"],["、"],["ビルシャン"],["、"],["ミスペレテ"],["、"],["ビグワイ"],["、"],["ネホム"],["、"],["バアナ"],["と"],["一緒","いっしょ"],["に"],["帰えって","かえって"],["きた"],["者","もの"],["たち"],["で"],["ある"],["。"],["その"],["イスラエル"],["の"],["民","たみ"],["の"],["人数","にんずう"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"]]},{"verse":8,"text":"パロシの子孫,しそんは二千百七十二人,にん。","tok":[["パロシ"],["の"],["子孫","しそん"],["は"],["二千百七十二","にせんひゃくななじゅうに"],["人","にん"],["。"]]},{"verse":9,"text":"シパテヤの子孫,しそんは三百七十二人,にん。","tok":[["シパテヤ"],["の"],["子孫","しそん"],["は"],["三百七十二","さんひゃくななじゅうに"],["人","にん"],["。"]]},{"verse":10,"text":"アラの子孫,しそんは六百五十二人,にん。","tok":[["アラ"],["の"],["子孫","しそん"],["は"],["六百五十二","ろくひゃくごじゅうに"],["人","にん"],["。"]]},{"verse":11,"text":"パハテ・モアブの子孫,しそんすなわちエシュアとヨアブの子孫,しそんは二千八百十八人,にん。","tok":[["パハテ"],["・"],["モアブ"],["の"],["子孫","しそん"],["すなわち"],["エシュア"],["と"],["ヨアブ"],["の"],["子孫","しそん"],["は"],["二千八百十八","にせんはちひゃくじゅうはち"],["人","にん"],["。"]]},{"verse":12,"text":"エラムの子孫,しそんは一千二百五十四人,にん。","tok":[["エラム"],["の"],["子孫","しそん"],["は"],["一千二百五十四","いちせんにひゃくごじゅうよん"],["人","にん"],["。"]]},{"verse":13,"text":"ザットの子孫,しそんは八百四十五人,にん。","tok":[["ザット"],["の"],["子孫","しそん"],["は"],["八百四十五","はちひゃくよんじゅうご"],["人","にん"],["。"]]},{"verse":14,"text":"ザッカイの子孫,しそんは七百六十人,にん。","tok":[["ザッカイ"],["の"],["子孫","しそん"],["は"],["七百六","ななひゃくろく"],["十人","じゅうにん"],["。"]]},{"verse":15,"text":"ビンヌイの子孫,しそんは六百四十八人,にん。","tok":[["ビンヌイ"],["の"],["子孫","しそん"],["は"],["六百四十八","ろくひゃくよんじゅうはち"],["人","にん"],["。"]]},{"verse":16,"text":"ベバイの子孫,しそんは六百二十八人,にん。","tok":[["ベバイ"],["の"],["子孫","しそん"],["は"],["六百二十八","ろくひゃくにじゅうはち"],["人","にん"],["。"]]},{"verse":17,"text":"アズガデの子孫,しそんは二千三百二十二人,にん。","tok":[["アズガデ"],["の"],["子孫","しそん"],["は"],["二千三百二十二","にせんさんひゃくにじゅうに"],["人","にん"],["。"]]},{"verse":18,"text":"アドニカムの子孫,しそんは六百六十七人,にん。","tok":[["アドニカム"],["の"],["子孫","しそん"],["は"],["六百六十七","ろくひゃくろくじゅうしち"],["人","にん"],["。"]]},{"verse":19,"text":"ビグワイの子孫,しそんは二千六十七人,にん。","tok":[["ビグワイ"],["の"],["子孫","しそん"],["は"],["二千六","ふちむ"],["十","じゅう"],["七人","しちにん"],["。"]]},{"verse":20,"text":"アデンの子孫,しそんは六百五十五人,にん。","tok":[["アデン"],["の"],["子孫","しそん"],["は"],["六百五十五","ろくひゃくごじゅうご"],["人","にん"],["。"]]},{"verse":21,"text":"ヒゼキヤの家,いえのアテルの子孫,しそんは九十八人,にん。","tok":[["ヒゼキヤ"],["の"],["家","いえ"],["の"],["アテル"],["の"],["子孫","しそん"],["は"],["九十八人","にん"],["。"]]},{"verse":22,"text":"ハシュムの子孫,しそんは三百二十八人,にん。","tok":[["ハシュム"],["の"],["子孫","しそん"],["は"],["三百二十八","さんひゃくにじゅうはち"],["人","にん"],["。"]]},{"verse":23,"text":"ベザイの子孫,しそんは三百二十四人,にん。","tok":[["ベザイ"],["の"],["子孫","しそん"],["は"],["三百二十四","さんひゃくにじゅうよん"],["人","にん"],["。"]]},{"verse":24,"text":"ハリフの子孫,しそんは百十二人,にん。","tok":[["ハリフ"],["の"],["子孫","しそん"],["は"],["百十二人","にん"],["。"]]},{"verse":25,"text":"ギベオンの子孫,しそんは九十五人,にん。","tok":[["ギベオン"],["の"],["子孫","しそん"],["は"],["九十五人","にん"],["。"]]},{"verse":26,"text":"ベツレヘムおよびネトパの人々,ひとびとは百八十八人,にん。","tok":[["ベツレヘム"],["および"],["ネトパ"],["の"],["人々","ひとびと"],["は"],["百八十八","ひゃくはちじゅうはち"],["人","にん"],["。"]]},{"verse":27,"text":"アナトテの人々,ひとびとは百二十八人,にん。","tok":[["アナトテ"],["の"],["人々","ひとびと"],["は"],["百二十八","ひゃくにじゅうはち"],["人","にん"],["。"]]},{"verse":28,"text":"ベテ・アズマウテの人々,ひとびとは四十二人,にん。","tok":[["ベテ"],["・"],["アズマウテ"],["の"],["人々","ひとびと"],["は"],["四十二人","にん"],["。"]]},{"verse":29,"text":"キリアテ・ヤリム、ケピラおよびベエロテの人々,ひとびとは七百四十三人,にん。","tok":[["キリアテ"],["・"],["ヤリム"],["、"],["ケピラ"],["および"],["ベエロテ"],["の"],["人々","ひとびと"],["は"],["七百四十三","ななひゃくよんじゅうさん"],["人","にん"],["。"]]},{"verse":30,"text":"ラマおよびゲバの人々,ひとびとは六百二十一人,にん。","tok":[["ラマ"],["および"],["ゲバ"],["の"],["人々","ひとびと"],["は"],["六百二十一","ろくひゃくにじゅういち"],["人","にん"],["。"]]},{"verse":31,"text":"ミクマシの人々,ひとびとは百二十二人,にん。","tok":[["ミクマシ"],["の"],["人々","ひとびと"],["は"],["百二十二","ひゃくにじゅうに"],["人","にん"],["。"]]},{"verse":32,"text":"ベテルおよびアイの人々,ひとびとは百二十三人,にん。","tok":[["ベテル"],["および"],["アイ"],["の"],["人々","ひとびと"],["は"],["百二十三","ひゃくにじゅうさん"],["人","にん"],["。"]]},{"verse":33,"text":"ほかのネボの人々,ひとびとは五十二人,にん。","tok":[["ほか"],["の"],["ネボ"],["の"],["人々","ひとびと"],["は"],["五十二人","にん"],["。"]]},{"verse":34,"text":"ほかのエラムの子孫,しそんは一千二百五十四人,にん。","tok":[["ほか"],["の"],["エラム"],["の"],["子孫","しそん"],["は"],["一千二百五十四","いちせんにひゃくごじゅうよん"],["人","にん"],["。"]]},{"verse":35,"text":"ハリムの子孫,しそんは三百二十人,にん。","tok":[["ハリム"],["の"],["子孫","しそん"],["は"],["三百二","さんひゃくに"],["十人","じゅうにん"],["。"]]},{"verse":36,"text":"エリコの人々,ひとびとは三百四十五人,にん。","tok":[["エリコ"],["の"],["人々","ひとびと"],["は"],["三百四十五","さんひゃくよんじゅうご"],["人","にん"],["。"]]},{"verse":37,"text":"ロド、ハデデおよびオノの人々,ひとびとは七百二十一人,にん。","tok":[["ロド"],["、"],["ハデデ"],["および"],["オノ"],["の"],["人々","ひとびと"],["は"],["七百二十一","ななひゃくにじゅういち"],["人","にん"],["。"]]},{"verse":38,"text":"セナアの子孫,しそんは三千九百三十人,にん。","tok":[["セナア"],["の"],["子孫","しそん"],["は"],["三千九百三","さんせんきゅうひゃくさん"],["十人","じゅうにん"],["。"]]},{"verse":39,"text":"祭司,さいしでは、エシュアの家,いえのエダヤの子孫,しそんが九百七十三人,にん。","tok":[["祭司","さいし"],["で"],["は"],["、"],["エシュア"],["の"],["家","いえ"],["の"],["エダヤ"],["の"],["子孫","しそん"],["が"],["九百七十三","きゅうひゃくななじゅうさん"],["人","にん"],["。"]]},{"verse":40,"text":"インメルの子孫,しそんが一千五十二人,にん。","tok":[["インメル"],["の"],["子孫","しそん"],["が"],["一千五十二","いちせんごじゅうに"],["人","にん"],["。"]]},{"verse":41,"text":"パシュルの子孫,しそんが一千二百四十七人,にん。","tok":[["パシュル"],["の"],["子孫","しそん"],["が"],["一千二百四十七","いちせんにひゃくよんじゅうしち"],["人","にん"],["。"]]},{"verse":42,"text":"ハリムの子孫,しそんが一千十七人,にん。","tok":[["ハリム"],["の"],["子孫","しそん"],["が"],["一千十七","いちせんじゅうしち"],["人","にん"],["。"]]},{"verse":43,"text":"レビびとでは、エシュアの子孫,しそんすなわちホデワの子孫,しそんのうちのカデミエルの子孫,しそんが七十四人,にん。","tok":[["レビ"],["びと"],["で"],["は"],["、"],["エシュア"],["の"],["子孫","しそん"],["すなわち"],["ホデワ"],["の"],["子孫","しそん"],["の"],["うち"],["の"],["カデミエル"],["の"],["子孫","しそん"],["が"],["七十四人","にん"],["。"]]},{"verse":44,"text":"歌,うたうたう者,ものでは、アサフの子孫,しそんが百四十八人,にん。","tok":[["歌","うた"],["うたう"],["者","もの"],["で"],["は"],["、"],["アサフ"],["の"],["子孫","しそん"],["が"],["百四十八","ひゃくよんじゅうはち"],["人","にん"],["。"]]},{"verse":45,"text":"門衛,もんえいでは、シャルムの子孫,しそん、アテルの子孫,しそん、タルモンの子孫,しそん、アックブの子孫,しそん、ハテタの子孫,しそんおよびショバイの子孫,しそん合,あわせて百三十八人,にん。","tok":[["門衛","もんえい"],["で"],["は"],["、"],["シャルム"],["の"],["子孫","しそん"],["、"],["アテル"],["の"],["子孫","しそん"],["、"],["タルモン"],["の"],["子孫","しそん"],["、"],["アックブ"],["の"],["子孫","しそん"],["、"],["ハテタ"],["の"],["子孫","しそん"],["および"],["ショバイ"],["の"],["子孫","しそん"],["合","あわせ"],["て"],["百三十八","ひゃくさんじゅうはち"],["人","にん"],["。"]]},{"verse":46,"text":"宮,みやに仕,つかえるしもべでは、ジハの子孫,しそん、ハスパの子孫,しそん、タバオテの子孫,しそん、","tok":[["宮","みや"],["に"],["仕える","つかえる"],["しもべ"],["で"],["は"],["、"],["ジハ"],["の"],["子孫","しそん"],["、"],["ハスパ"],["の"],["子孫","しそん"],["、"],["タバオテ"],["の"],["子孫","しそん"],["、"]]},{"verse":47,"text":"ケロスの子孫,しそん、シアの子孫,しそん、パドンの子孫,しそん、","tok":[["ケロス"],["の"],["子孫","しそん"],["、"],["シア"],["の"],["子孫","しそん"],["、"],["パドン"],["の"],["子孫","しそん"],["、"]]},{"verse":48,"text":"レバナの子孫,しそん、ハガバの子孫,しそん、サルマイの子孫,しそん、","tok":[["レバナ"],["の"],["子孫","しそん"],["、"],["ハガバ"],["の"],["子孫","しそん"],["、"],["サルマイ"],["の"],["子孫","しそん"],["、"]]},{"verse":49,"text":"ハナンの子孫,しそん、ギデルの子孫,しそん、ガハルの子孫,しそん、","tok":[["ハナン"],["の"],["子孫","しそん"],["、"],["ギデル"],["の"],["子孫","しそん"],["、"],["ガハル"],["の"],["子孫","しそん"],["、"]]},{"verse":5
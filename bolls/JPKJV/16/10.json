[{"verse":1,"text":"[9:38]このもろもろの事,ことのためにわれわれは堅,かたい契約,けいやくを結,むすんで、これを記録,きろくし、われわれのつかさたち、レビびとたち祭司,さいしたちはこれに印,いんを押,おした。","tok":[["["],["9"],[":"],["38"],["]"],["この"],["もろもろ"],["の"],["事","こと"],["の"],["ため"],["に"],["われわれ"],["は"],["堅い","かたい"],["契約","けいやく"],["を"],["結んで","むすんで"],["、"],["これ"],["を"],["記録","きろく"],["し"],["、"],["われわれ"],["の"],["つかさ"],["たち"],["、"],["レビ"],["びと"],["たち"],["祭司","さいし"],["たち"],["は"],["これ"],["に"],["印","いん"],["を"],["押","おし"],["た"],["。"]]},{"verse":2,"text":"[1]印,いんを押,おした者,ものはハカリヤの子,こである総督,そうとくネヘミヤ、およびゼデキヤ、","tok":[["["],["1"],["]"],["印","いん"],["を"],["押","おし"],["た"],["者","もの"],["は"],["ハカリヤ"],["の"],["子","こ"],["で"],["ある"],["総督","そうとく"],["ネヘミヤ"],["、"],["および"],["ゼデキヤ"],["、"]]},{"verse":3,"text":"[2]セラヤ、アザリヤ、エレミヤ、","tok":[["["],["2"],["]"],["セラヤ"],["、"],["アザリヤ"],["、"],["エレミヤ"],["、"]]},{"verse":4,"text":"[3]パシュル、アマリヤ、マルキヤ、","tok":[["["],["3"],["]"],["パシュル"],["、"],["アマリヤ"],["、"],["マルキヤ"],["、"]]},{"verse":5,"text":"[4]ハットシ、シバニヤ、マルク、","tok":[["["],["4"],["]"],["ハットシ"],["、"],["シバニヤ"],["、"],["マルク"],["、"]]},{"verse":6,"text":"[5]ハリム、メレモテ、オバデヤ、","tok":[["["],["5"],["]"],["ハリム"],["、"],["メレモテ"],["、"],["オバデヤ"],["、"]]},{"verse":7,"text":"[6]ダニエル、ギンネトン、バルク、","tok":[["["],["6"],["]"],["ダニエル"],["、"],["ギンネトン"],["、"],["バルク"],["、"]]},{"verse":8,"text":"[7]メシュラム、アビヤ、ミヤミン、","tok":[["["],["7"],["]"],["メシュラム"],["、"],["アビヤ"],["、"],["ミヤミン"],["、"]]},{"verse":9,"text":"[8]マアジヤ、ビルガイ、シマヤで、これらは祭司,さいしである。","tok":[["["],["8"],["]"],["マアジヤ"],["、"],["ビルガイ"],["、"],["シマヤ"],["で"],["、"],["これ"],["ら"],["は"],["祭司","さいし"],["で"],["ある"],["。"]]},{"verse":10,"text":"[9]レビびとではアザニヤの子,こエシュア、ヘナダデの子,こらのうちのビンヌイ、カデミエル、","tok":[["["],["9"],["]"],["レビ"],["びと"],["で"],["は"],["アザニヤ"],["の"],["子","こ"],["エシュア"],["、"],["ヘナダデ"],["の"],["子","こ"],["ら"],["の"],["うち"],["の"],["ビンヌイ"],["、"],["カデミエル"],["、"]]},{"verse":11,"text":"[10]およびその兄弟,きょうだいシバニヤ、ホデヤ、ケリタ、ペラヤ、ハナン、","tok":[["["],["10"],["]"],["および"],["その"],["兄弟","きょうだい"],["シバニヤ"],["、"],["ホデヤ"],["、"],["ケリタ"],["、"],["ペラヤ"],["、"],["ハナン"],["、"]]},{"verse":12,"text":"[11]ミカ、レホブ、ハシャビヤ、","tok":[["["],["11"],["]"],["ミカ"],["、"],["レホブ"],["、"],["ハシャビヤ"],["、"]]},{"verse":13,"text":"[12]ザックル、セレビヤ、シバニヤ、","tok":[["["],["12"],["]"],["ザックル"],["、"],["セレビヤ"],["、"],["シバニヤ"],["、"]]},{"verse":14,"text":"[13]ホデヤ、バニ、ベニヌである。","tok":[["["],["13"],["]"],["ホデヤ"],["、"],["バニ"],["、"],["ベニヌ"],["で"],["ある"],["。"]]},{"verse":15,"text":"[14]民,たみのかしらではパロシ、パハテ・モアブ、エラム、ザット、バニ、","tok":[["["],["14"],["]"],["民","たみ"],["の"],["かしら"],["で"],["は"],["パロシ"],["、"],["パハテ"],["・"],["モアブ"],["、"],["エラム"],["、"],["ザット"],["、"],["バニ"],["、"]]},{"verse":16,"text":"[15]ブンニ、アズガデ、ベバイ、","tok":[["["],["15"],["]"],["ブンニ"],["、"],["アズガデ"],["、"],["ベバイ"],["、"]]},{"verse":17,"text":"[16]アドニヤ、ビグワイ、アデン、","tok":[["["],["16"],["]"],["アドニヤ"],["、"],["ビグワイ"],["、"],["アデン"],["、"]]},{"verse":18,"text":"[17]アテル、ヒゼキヤ、アズル、","tok":[["["],["17"],["]"],["アテル"],["、"],["ヒゼキヤ"],["、"],["アズル"],["、"]]},{"verse":19,"text":"[18]ホデヤ、ハシュム、ベザイ、","tok":[["["],["18"],["]"],["ホデヤ"],["、"],["ハシュム"],["、"],["ベザイ"],["、"]]},{"verse":20,"text":"[19]ハリフ、アナトテ、ノバイ、","tok":[["["],["19"],["]"],["ハリフ"],["、"],["アナトテ"],["、"],["ノバイ"],["、"]]},{"verse":21,"text":"[20]マグピアシ、メシュラム、ヘジル、","tok":[["["],["20"],["]"],["マグピアシ"],["、"],["メシュラム"],["、"],["ヘジル"],["、"]]},{"verse":22,"text":"[21]メシザベル、ザドク、ヤドア、","tok":[["["],["21"],["]"],["メシザベル"],["、"],["ザドク"],["、"],["ヤドア"],["、"]]},{"verse":23,"text":"[22]ペラテヤ、ハナン、アナニヤ、","tok":[["["],["22"],["]"],["ペラテヤ"],["、"],["ハナン"],["、"],["アナニヤ"],["、"]]},{"verse":24,"text":"[23]ホセア、ハナニヤ、ハシュブ、","tok":[["["],["23"],["]"],["ホセア"],["、"],["ハナニヤ"],["、"],["ハシュブ"],["、"]]},{"verse":25,"text":"[24]ハロヘシ、ピルハ、ショベク、","tok":[["["],["24"],["]"],["ハロヘシ"],["、"],["ピルハ"],["、"],["ショベク"],["、"]]},{"verse":26,"text":"[25]レホム、ハシャブナ、マアセヤ、","tok":[["["],["25"],["]"],["レホム"],["、"],["ハシャブナ"],["、"],["マアセヤ"],["、"]]},{"verse":27,"text":"[26]アヒヤ、ハナン、アナン、","tok":[["["],["26"],["]"],["アヒヤ"],["、"],["ハナン"],["、"],["アナン"],["、"]]},{"verse":28,"text":"[27]マルク、ハリム、バアナである。","tok":[["["],["27"],["]"],["マルク"],["、"],["ハリム"],["、"],["バアナ"],["で"],["ある"],["。"]]},{"verse":29,"text":"[28]その他,たの民,たみ、祭司,さいし、レビびと、門,もんを守,まもる者,もの、歌,うたうたう者,もの、宮,みやに仕,つかえるしもべ、ならびにすべて国々,くにぐにの民,たみと離,はなれて神,かみの律法,りっぽうに従,したがった者,ものおよびその妻,つま、むすこ、娘,むすめなどすべて知識,ちしきと悟,さとりのある者,ものは、","tok":[["["],["28"],["]"],["その"],["他","た"],["の"],["民","たみ"],["、"],["祭司","さいし"],["、"],["レビ"],["び"],["と"],["、"],["門","もん"],["を"],["守者","まもるもの"],["、"],["歌","うた"],["うたう"],["者","もの"],["、"],["宮","みや"],["に"],["仕える","つかえる"],["しもべ"],["、"],["ならびに"],["すべて"],["国々","くにぐに"],["の"],["民","たみ"],["と"],["離れて","はなれて"],["神","かみ"],["の"],["律法","りっぽう"],["に"],["従った","したがった"],["者","もの"],["および"],["その"],["妻","つま"],["、"],["むすこ"],["、"],["娘","むすめ"],["など"],["すべて"],["知識","ちしき"],["と"],["悟り","さとり"],["の"],["ある"],["者","もの"],["は"],["、"]]},{"verse":30,"text":"[29]その兄弟,きょうだいである尊,たっとい人々,ひとびとにつき従,したがい、神,かみのしもべモーセによって授,さづけられた神,かみの律法,りっぽうに歩,あゆみ、われわれの主,しゅ、主,しゅのすべての戒,いましめと、おきてと、定,さだめとを守,まもり行,おこなうために、のろいと誓,ちかいとに加,くわわった。","tok":[["["],["29"],["]"],["その"],["兄弟","きょうだい"],["で"],["ある"],["尊","た"],["っと"],["い"],["人々","ひとびと"],["に"],["つき従い","つきしたがい"],["、"],["神","かみ"],["の"],["しもべ"],["モーセ"],["によって"],["授","さ"],["づけられた"],["神","かみ"],["の"],["律法","りっぽう"],["に"],["歩み","あゆみ"],["、"],["われわれ"],["の"],["主","しゅ"],["、"],["主","しゅ"],["の"],["すべて"],["の"],["戒しめ","いましめ"],["と"],["、"],["おきて"],["と"],["、"],["定め","さだめ"],["と"],["を"],["守り","まもり"],["行なう","おこなう"],["ため"],["に"],["、"],["のろい"],["と"],["誓い","ちかい"],["と"],["に"],["加わわった","くわわった"],["。"]]},{"verse":31,"text":"[30]われわれはこの地,ちの民,たみらにわれわれの娘,むすめを与,あたえず、われわれのむすこに彼,かれらの娘,むすめをめとらない。","tok":[["["],["30"],["]"],["われわれ"],["は"],["この"],["地","ち"],["の"],["民","たみ"],["ら"],["に"],["われわれ"],["の"],["娘","むすめ"],["を"],["与えず","あたえず"],["、"],["われわれ"],["の"],["むすこ"],["に"],["彼","かれ"],["ら"],["の"],["娘","むすめ"],["を"],["めとらない"],["。"]]},{"verse":32,"text":"[31]またこの地,ちの民,たみらがたとい品物,しなものまたは穀物,こくもつを安息日,あんそくにちに携,たずさえて来,きて売,うろうとしても、われわれは安息日,あんそくにちまたは聖日,せいじつにはそれを買,かわない。また七年,ねんごとに耕作,こうさくをやめ、すべての負債,ふさいをゆるす。","tok":[["["],["31"],["]"],["また"],["この"],["地","ち"],["の"],["民","たみ"],["ら"],["が"],["たとい"],["品物","しなもの"],["また"],["は"],["穀物","こくもつ"],["を"],["安息日","あんそくにち"],["に"],["携えて","たずさえて"],["来て","きて"],["売ろう","うろう"],["として"],["も"],["、"],["われわれ"],["は"],["安息日","あんそく"],["に"],["ちまた"],["は"],["聖日","せいじつ"],["に"],["は"],["それ"],["を"],["買わない","かわない"],["。"],["また"],["七","なな"],["年","ねん"],["に"],["耕作","こうさく"],["を"],["やめ"],["、"],["すべて"],["の"],["負債","ふさい"],["を"],["ゆるす"],["。"]]},{"verse":33,"text":"[32]われわれはまたみずから規定,きていを設,もうけて、われわれの神,かみの宮,みやの用,ようのために年々,ねんねんシケルの三分,ぶんの一を出,だし、","tok":[["["],["32"],["]"],["われわれ"],["は"],["また"],["みずから"],["規定","きてい"],["を"],["設けて","もうけて"],["、"],["われわれ"],["の"],["神","かみ"],["の"],["宮","みや"],["の"],["用","よう"],["の"],["ため"],["に"],["年々","ねんねん"],["シケル"],["の"],["三分","ぶん"],["の"],["一","いち"],["を"],["出し","だし"],["、"]]},{"verse":34,"text":"[33]供,そなえのパン、常素祭,じょうそさい、常燔祭,じょうはんさいのため、安息日,あんそくにち、新月,しんげつおよび定,さだめの祭,まつりの供,そなえ物,もののため、聖,せいなる物,もののため、イスラエルのあがないをなす罪祭,ざいさい、およびわれわれの神,かみの宮,みやのもろもろのわざのために用,もちいることにした。","tok":[["["],["33"],["]"],["供え","そなえ"],["の"],["パン"],["、"],["常素祭","じょ"],["う"],["そさい"],["、"],["常","つね"],["燔祭","はんさい"],["の"],["ため"],["、"],["安息日","あん"],["そ"],["く"],["にち"],["、"],["新月","しんげつ"],["および"],["定め","さだめ"],["の"],["祭","まつり"],["の"],["供え物","そなえもの"],["の"],["ため"],["、"],["聖","せい"],["なる"],["物","もの"],["の"],["ため"],["、"],["イスラエル"],["の"],["あ"],["が"],["ない"],["を"],["なす"],["罪","つみ"],["祭","まつり"],["い"],["さい"],["、"],["および"],["われわれ"],["の"],["神","かみ"],["の"],["宮","みや"],["の"],["もろもろ"],["の"],["わざ"],["の"],["ため"],["に"],["用いる","もちいる"],["こと"],["に"],["した"],["。"]]},{"verse":35,"text":"[34]またわれわれ祭司,さいし、レビびとおよび民,たみはくじを引,ひいて、律法,りっぽうにしるされてあるようにわれわれの神,かみ、主,しゅの祭壇,さいだんの上,うえにたくべきたきぎの供,そなえ物,ものを、年々,ねんねん定,さだめられた時,ときに氏族,しぞくにしたがって、われわれの神,かみの宮,みやに納,おさめる者,ものを定,さだめた。","tok":[["["],["34"],["]"],["また"],["われわれ"],["祭司","さいし"],["、"],["レビ"],["び"],["と"],["および"],["民","たみ"],["は"],["くじ"],["を"],["引いて","ひいて"],["、"],["律法","りっぽう"],["に"],["しるされて"],["ある"],["よう"],["に"],["われわれ"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["祭壇","さいだん"],["の"],["上","うえ"],["に"],["たくべき"],["たきぎ"],["の"],["供え物","そなえもの"],["を"],["、"],["年々","ねんねん"],["定められた","さだめられた"],["時","とき"],["に"],["氏族","しぞく"],["に"],["したがって"],["、"],["われわれ"],["の"],["神","かみ"],["の"],["宮","みや"],["に"],["納める","おさめる"],["者","もの"],["を"],["定めた","さだめた"],["。"]]},{"verse":36,"text":"[35]またわれわれの土地,とちの初,はつなり、および各種,かくしゅの木,きの実,みの初,はつなりを、年々,ねんねん主,しゅの宮,みやに携,たずさえてくることを誓,ちかい、","tok":[["["],["35"],["]"],["また"],["われわれ"],["の"],["土地","とち"],["の"],["初なり","はつなり"],["、"],["および"],["各種","かくしゅ"],["の"],["木の実","きのみ"],["の"],["初なり","はつなり"],["を"],["、"],["年々","ねんねん"],["主","しゅ"],["の"],["宮","みや"],["に"],["携えて","たずさえて"],["くる"],["こと"],["を"],["誓い","ちかい"],["、"]]},{"verse":37,"text":"[36]また律法,りっぽうにしるしてあるように、われわれの子,こどもおよび家畜,かちくのういご、およびわれわれの牛,うしや羊,ひつじのういごを、われわれの神,かみの宮,みやに携,たずさえてきて、われわれの神,かみの宮,みやに仕,つかえる祭司,さいしに渡,わたし、","tok":[["["],["36"],["]"],["また"],["律法","りっぽう"],["に"],["しるして"],["ある"],["よう"],["に"],["、"],["われわれ"],["の"],["子ども","こども"],["および"],["家畜","かちく"],["の"],["うい"],["ご"],["、"],["および"],["われわれ"],["の"],["牛","うし"],["や"],["羊","ひつじ"],["の"],["うい"],["ご"],["を"],["、"],["われわれ"],["の"],["神","かみ"],["の"],["宮","みや"],["に"],["携えて","たずさえて"],["きて"],["、"],["われわれ"],["の"],["神","かみ"],["の"],["宮","みや"],["に"],["仕える","つかえる"],["祭司","さいし"],["に"],["渡","わたし"],["、"]]},{"verse":38,"text":"[37]われわれの麦粉,むぎこの初物,はつもの、われわれの供,そなえ物,もの、各種,かくしゅの木,きの実,み、ぶどう酒,しゅおよび油,あぶらを祭司,さいしのもとに携,たずさえて行,いって、われわれの神,かみの宮,みやのへやに納,おさめ、またわれわれの土地,とちの産物,さんぶつの十分,ぶんの一をレビびとに与,あたえることにした。レビびとはわれわれのすべての農作,のうさくをなす町,まちにおいて、その十分,ぶんの一を受,うくべき者,ものだからである。","tok":[["["],["37"],["]"],["われわれ"],["の"],["麦粉","むぎこ"],["の"],["初物","はつもの"],["、"],["われわれ"],["の"],["供え物","そなえもの"],["、"],["各種","かくしゅ"],["の"],["木の実","きのみ"],["、"],["ぶどう酒","ぶどうしゅ"],["および"],["油","あぶら"],["を"],["祭司","さいし"],["の"],["もと"],["に"],["携えて","たずさえて"],["行って","いって"],["、"],["われわれ"],["の"],["神","かみ"],["の"],["宮","みや"],["の"],["へや"],["に"],["納","おさめ"],["、"],["また"],["われわれ"],["の"],["土地","とち"],["の"],["産物","さんぶつ"],["の"],["十分","ぶん"],["の"],["一","いち"],["を"],["レビ"],["びと"],["に"],["与える","あたえる"],["こと"],["に"],["した"],["。"],["レビ"],["び"],["と"],["は"],["われわれ"],["の"],["すべて"],["の"],["農作","のうさく"],["を"],["なす"],["町","まち"],["に"],["おいて"],["、"],["その"],["十分","ぶん"],["の"],["一","いち"],["を"],["受","う"],["くべき"],["者","もの"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":39,"text":"[38]レビびとが十分,ぶんの一を受,うける時,ときには、アロンの子孫,しそんである祭司,さいしが、そのレビびとと共,ともにいなければならない。そしてまたレビびとはその十分,ぶんの一の十分,ぶんの一を、われわれの神,かみの宮,みやに携,たずさえ上,のぼって、へやまたは倉,くらに納,おさめなければならない。","tok":[["["],["38"],["]"],["レビ"],["びと"],["が"],["十分","ぶん"],["の"],["一","いち"],["を"],["受る","うける"],["時","とき"],["に"],["は"],["、"],["アロン"],["の"],["子孫","しそん"],["で"],["ある"],["祭司","さいし"],["が"],["、"],["その"],["レビ"],["びと"],["と"],["共","とも"],["に"],["いなければ"],["ならない"],["。"],["そして"],["また"],["レビ"],["び"],["と"],["は"],["その"],["十分","ぶん"],["の"],["一","いち"],["の"],["十分","ぶん"],["の"],["一","いち"],["を"],["、"],["われわれ"],["の"],["神","かみ"],["の"],["宮","みや"],["に"],["携え","たずさえ"],["上","のぼ"],["って"],["、"],["へや"],["また"],["は"],["倉","くら"],["に"],["納","おさめ"],["なければ"],["ならない"],["。"]]},{"verse":40,"text":"[39]すなわちイスラエルの人々,ひとびとおよびレビの子孫,しそんは穀物,こくもつ、ぶどう酒,しゅ、および油,あぶらの供,そなえ物,ものを携,たずさえて行,いって、聖所,せいじょの器物,うつわものおよび勤,つとめをする祭司,さいし、門衛,もんえい、歌,うたうたう者,ものたちのいるへやにこれを納,おさめなければならない。こうしてわれわれは、われわれの神,かみの宮,みやをなおざりにしない。","tok":[["["],["39"],["]"],["すなわち"],["イスラエル"],["の"],["人々","ひとびと"],["および"],["レビ"],["の"],["子孫","しそん"],["は"],["穀物","こくもつ"],["、"],["ぶどう酒","ぶどうしゅ"],["、"],["および"],["油","あぶら"],["の"],["供え物","そなえもの"],["を"],["携えて","たずさえて"],["行って","いって"],["、"],["聖","せい"],["所","しょ"],["の"],["器物","うつわも"],["の"],["および"],["勤め","つとめ"],["を"],["する"],["祭司","さいし"],["、"],["門衛","もんえい"],["、"],["歌","うた"],["うたう"],["者","もの"],["たち"],["の"],["いる"],["へや"],["に"],["これ"],["を"],["納","おさめ"],["なければ"],["ならない"],["。"],["こう"],["して"],["われわれ"],["は"],["、"],["われわれ"],["の"],["神","かみ"],["の"],["宮","みや"],["を"],["なおざり"],["に"],["しない"],["。"]]}]
[{"verse":1,"text":"アルタシャスタ王,おうの第,だい二十年,ねん、ニサンの月,つきに、王,おうの前,まえに酒,さけが出,でた時,とき、わたしは酒,さけをついで王,おうにささげた。これまでわたしは王,おうの前,まえで悲,かなしげな顔,かおをしていたことはなかった。","tok":[["アルタシャスタ"],["王","おう"],["の"],["第","だい"],["二十","にじゅう"],["年","ねん"],["、"],["ニサン"],["の"],["月","つき"],["に"],["、"],["王","おう"],["の"],["前","まえ"],["に"],["酒","さけ"],["が"],["出た","でた"],["時","とき"],["、"],["わたし"],["は"],["酒","さけ"],["を"],["ついで"],["王","おう"],["に"],["ささげた"],["。"],["これ"],["まで"],["わたし"],["は"],["王","おう"],["の"],["前","まえ"],["で"],["悲し","かなし"],["げ"],["な"],["顔","かお"],["を"],["して"],["いた"],["こと"],["は"],["なかった"],["。"]]},{"verse":2,"text":"王,おうはわたしに言,いわれた、「あなたは病気,びょうきでもないのにどうして悲,かなしげな顔,かおをしているのか。何,なにか心,こころに悲,かなしみをもっているにちがいない」。そこでわたしは大,おおいに恐,おそれて、","tok":[["王","おう"],["は"],["わたし"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["は"],["病気","びょうき"],["で"],["も"],["ない"],["のに"],["どう"],["して"],["悲し","かなし"],["げ"],["な"],["顔","かお"],["を"],["して"],["いる"],["の"],["か"],["。"],["何に","なに"],["か"],["心","こころ"],["に"],["悲しみ","かなしみ"],["を"],["もって"],["いる"],["に"],["ちがい"],["ない"],["」"],["。"],["そこ"],["で"],["わたし"],["は"],["大いに","おおいに"],["恐れて","おそれて"],["、"]]},{"verse":3,"text":"王,おうに申,もうしあげた、「どうぞ王,おうよ、長生,ながいきされますように。わたしの先祖,せんぞの墳墓,ふんぼの地,ちであるあの町,まちは荒廃,こうはいし、その門,もんが火,ひで焼,やかれたままであるのに、どうしてわたしは悲,かなしげな顔,かおをしないでいられましょうか」。","tok":[["王","おう"],["に"],["申しあげた","もうしあげた"],["、"],["「"],["どうぞ"],["王","おう"],["よ"],["、"],["長生き","ながいき"],["されます"],["よう"],["に"],["。"],["わたし"],["の"],["先祖","せんぞ"],["の"],["墳墓","ふんぼ"],["の"],["地","ち"],["で"],["ある"],["あの"],["町","まち"],["は"],["荒廃","こうはい"],["し"],["、"],["その"],["門","もん"],["が"],["火","ひ"],["で"],["焼かれた","やかれた"],["まま"],["で"],["ある"],["のに"],["、"],["どう"],["して"],["わたし"],["は"],["悲し","かなし"],["げ"],["な"],["顔","かお"],["を"],["しないで"],["いられましょう"],["か"],["」"],["。"]]},{"verse":4,"text":"王,おうはわたしにむかって、「それでは、あなたは何,なにを願,ねがうのか」と言,いわれたので、わたしは天,てんの神,かみに祈,いのって、","tok":[["王","おう"],["は"],["わたし"],["に"],["むかって"],["、"],["「"],["それ"],["で"],["は"],["、"],["あなた"],["は"],["何に","なに"],["を"],["願う","ねがう"],["の"],["か"],["」"],["と"],["言われた","いわれた"],["ので"],["、"],["わたし"],["は"],["天","てん"],["の"],["神","かみ"],["に"],["祈って","いのって"],["、"]]},{"verse":5,"text":"王,おうに申,もうしあげた、「もし王,おうがよしとされ、しもべがあなたの前,まえに恵,めぐみを得,えますならば、どうかわたしを、ユダにあるわたしの先祖,せんぞの墳墓,ふんぼの町,まちにつかわして、それを再建,さいけんさせてください」。","tok":[["王","おう"],["に"],["申しあげた","もうしあげた"],["、"],["「"],["もし"],["王","おう"],["が"],["よし"],["と"],["され"],["、"],["しもべ"],["が"],["あなた"],["の"],["前","まえ"],["に"],["恵","めぐみ"],["を"],["得ますならば","えますならば"],["、"],["どう"],["か"],["わたし"],["を"],["、"],["ユダ"],["に"],["ある"],["わたし"],["の"],["先祖","せんぞ"],["の"],["墳墓","ふんぼ"],["の"],["町","まち"],["に"],["つかわして"],["、"],["それ"],["を"],["再建","さいけん"],["させて"],["ください"],["」"],["。"]]},{"verse":6,"text":"時,ときに王妃,おうひもかたわらに座,ざしていたが、王,おうはわたしに言,いわれた、「あなたの旅,たびの期間,きかんはどれほどですか。いつごろ帰,かえってきますか」。こうして王,おうがわたしをつかわすことをよしとされたので、わたしは期間,きかんを定,さだめて王,おうに申,もうしあげた。","tok":[["時","とき"],["に"],["王妃","おうひ"],["も"],["かたわら"],["に"],["座して","ざして"],["いた"],["が"],["、"],["王","おう"],["は"],["わたし"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["の"],["旅","たび"],["の"],["期間","きかん"],["は"],["どれ"],["ほど"],["です"],["か"],["。"],["いつごろ"],["帰えって","かえって"],["きます"],["か"],["」"],["。"],["こう"],["して"],["王","おう"],["が"],["わたし"],["を"],["つかわす"],["こと"],["を"],["よし"],["と"],["された"],["ので"],["、"],["わたし"],["は"],["期間","きかん"],["を"],["定めて","さだめて"],["王","おう"],["に"],["申しあげた","もうしあげた"],["。"]]},{"verse":7,"text":"わたしはまた王,おうに申,もうしあげた、「もし王,おうがよしとされるならば、川,かわ向,むこうの州,しゅうの知事,ちじたちに与,あたえる手紙,てがみをわたしに賜,たまわり、わたしがユダに行,いきつくまで、彼,かれらがわたしを通過,つうかさせるようにしてください。","tok":[["わたし"],["は"],["また"],["王","おう"],["に"],["申しあげた","もうしあげた"],["、"],["「"],["もし"],["王","おう"],["が"],["よし"],["と"],["されるならば"],["、"],["川向こう","かわむこう"],["の"],["州","しゅう"],["の"],["知事","ちじ"],["たち"],["に"],["与える","あたえる"],["手紙","てがみ"],["を"],["わたし"],["に"],["賜わり","たまわり"],["、"],["わたし"],["が"],["ユダ"],["に"],["行きつく","いきつく"],["まで"],["、"],["彼","かれ"],["ら"],["が"],["わたし"],["を"],["通過","つうか"],["させる"],["よう"],["に"],["して"],["ください"],["。"]]},{"verse":8,"text":"また王,おうの山林,さんりんを管理,かんりするアサフに与,あたえる手紙,てがみをも賜,たまわり、神殿,しんでんに属,ぞくする城,しろの門,もんを建,たてるため、また町,まちの石,いしがき、およびわたしの住,すむべき家,いえを建,たてるために用,もちいる材木,ざいもくをわたしに与,あたえるようにしてください」。わたしの神,かみがよくわたしを助,たすけられたので、王,おうはわたしの願,ねがいを許,ゆるされた。","tok":[["また"],["王","おう"],["の"],["山林","さんりん"],["を"],["管理","かんり"],["する"],["アサフ"],["に"],["与える","あたえる"],["手紙","てがみ"],["を"],["も"],["賜わり","たまわり"],["、"],["神殿","しんでん"],["に"],["属する","ぞくする"],["城","しろ"],["の"],["門","もん"],["を"],["建てる","たてる"],["ため"],["、"],["また"],["町","まち"],["の"],["石がき","いしがき"],["、"],["および"],["わたし"],["の"],["住むべき","すむべき"],["家","いえ"],["を"],["建てる","たてる"],["ため"],["に"],["用いる","もちいる"],["材木","ざいもく"],["を"],["わたし"],["に"],["与える","あたえる"],["よう"],["に"],["して"],["ください"],["」"],["。"],["わたし"],["の"],["神","かみ"],["が"],["よく"],["わたし"],["を"],["助けられた","たすけられた"],["ので"],["、"],["王","おう"],["は"],["わたし"],["の"],["願い","ねがい"],["を"],["許された","ゆるされた"],["。"]]},{"verse":9,"text":"そこでわたしは川,かわ向,むこうの州,しゅうの知事,ちじたちの所,ところへ行,いって、王,おうの手紙,てがみを渡,わたした。なお王,おうは軍,ぐんの長,ちょうおよび騎兵,きへいをわたしと共,ともにつかわした。","tok":[["そこ"],["で"],["わたし"],["は"],["川向こう","かわむこう"],["の"],["州","しゅう"],["の"],["知事","ちじ"],["たち"],["の"],["所","ところ"],["へ"],["行って","いって"],["、"],["王","おう"],["の"],["手紙","てがみ"],["を"],["渡","わたし"],["た"],["。"],["なお"],["王","おう"],["は"],["軍","ぐん"],["の"],["長う","ちょう"],["および"],["騎兵","きへい"],["を"],["わたし"],["と"],["共","とも"],["に"],["つかわした"],["。"]]},{"verse":10,"text":"ところがホロニびとサンバラテおよびアンモンびと奴隷,どれいトビヤはこれを聞,きき、イスラエルの子孫,しそんの福祉,ふくしを求,もとめる人,ひとが来,きたというので、大,おおいに感情,かんじょうを害,がいした。","tok":[["ところ"],["が"],["ホロニ"],["びと"],["サンバラテ"],["および"],["アンモン"],["びと"],["奴隷","どれい"],["トビヤ"],["は"],["これ"],["を"],["聞","きき"],["、"],["イスラエル"],["の"],["子孫","しそん"],["の"],["福祉","ふくし"],["を"],["求める","もとめる"],["人","ひと"],["が"],["来た","きた"],["と"],["いう"],["ので"],["、"],["大いに","おおいに"],["感情","かんじょう"],["を"],["害した","がいした"],["。"]]},{"verse":11,"text":"わたしはエルサレムに着,ついて、そこに三日,か滞在,たいざいした後,のち、","tok":[["わたし"],["は"],["エルサレム"],["に"],["着いて","ついて"],["、"],["そこ"],["に"],["三日","か"],["滞在","たいざい"],["した"],["後","の"],["ち"],["、"]]},{"verse":12,"text":"夜中,よなかに起,おき出,でた。数人,すうにんの者,ものがわたしに伴,ともなったが、わたしは、神,かみがエルサレムのためになそうとして、わたしの心,こころに入,いれられたことを、だれにも告,つげ知,しらせず、またわたしが乗,のった獣,けもののほかには、獣,けものをつれて行,いかなかった。","tok":[["夜中","よなか"],["に"],["起き出た","おきでた"],["。"],["数人","すうにん"],["の"],["者","もの"],["が"],["わたし"],["に"],["伴なった","ともなった"],["が"],["、"],["わたし"],["は"],["、"],["神","かみ"],["が"],["エルサレム"],["の"],["ため"],["に"],["なそう"],["として"],["、"],["わたし"],["の"],["心","こころ"],["に"],["入れられた","いれられた"],["こと"],["を"],["、"],["だれ"],["に"],["も"],["告","つげ"],["知らせず","しらせず"],["、"],["また"],["わたし"],["が"],["乗った","のった"],["獣","けもの"],["の"],["ほか"],["に"],["は"],["、"],["獣","けもの"],["を"],["つれて"],["行かなかった","いかなかった"],["。"]]},{"verse":13,"text":"わたしは夜中,よなかに出,でて谷,たにの門,もんを通,とおり、龍,りゅうの井戸,いどおよび糞,ふんの門,もんに行,いって、エルサレムのくずれた城壁,じょうへきや、火,ひに焼,やかれた門,もんを調査,ちょうさし、","tok":[["わたし"],["は"],["夜中","よなか"],["に"],["出て","でて"],["谷","たに"],["の"],["門","もん"],["を"],["通り","とおり"],["、"],["龍","りゅう"],["の"],["井戸","いど"],["および"],["糞","ふん"],["の"],["門","もん"],["に"],["行って","いって"],["、"],["エルサレム"],["の"],["くずれた"],["城壁","じょうへき"],["や"],["、"],["火","ひ"],["に"],["焼かれた","やかれた"],["門","もん"],["を"],["調査","ちょうさ"],["し"],["、"]]},{"verse":14,"text":"また泉,いずみの門,もんおよび王,おうの池,いけに行,いったが、わたしの乗,のっている獣,けものの通,とおるべき所,ところもなかった。","tok":[["また"],["泉","いずみ"],["の"],["門","もん"],["および"],["王","おう"],["の"],["池","いけ"],["に"],["行った","いった"],["が"],["、"],["わたし"],["の"],["乗って","のって"],["いる"],["獣","けもの"],["の"],["通るべき","とおるべき"],["所","ところ"],["も"],["なかった"],["。"]]},{"verse":15,"text":"わたしはまたその夜,よるのうちに谷,たにに沿,そって上,のぼり、城壁,じょうへきを調査,ちょうさしたうえ、身,みをめぐらして、谷,たにの門,もんを通,とおって帰,かえった。","tok":[["わたし"],["は"],["また"],["その"],["夜","よる"],["の"],["うち"],["に"],["谷","たに"],["に"],["沿って","そって"],["上り","のぼり"],["、"],["城壁","じょうへき"],["を"],["調査","ちょうさ"],["した"],["うえ"],["、"],["身","み"],["を"],["めぐらして"],["、"],["谷","たに"],["の"],["門","もん"],["を"],["通って","とおって"],["帰えった","かえった"],["。"]]},{"verse":16,"text":"つかさたちは、わたしがどこへ行,いったか、何,なにをしたかを知,しらなかった。わたしはまたユダヤ人,ひとにも、祭司,さいしたちにも、尊,たっとい人,ひとたちにも、つかさたちにも、その他,た工事,こうじをする人々,ひとびとにもまだ知,しらせなかった。","tok":[["つかさ"],["たち"],["は"],["、"],["わたし"],["が"],["どこ"],["へ"],["行った","いった"],["か"],["、"],["何に","なに"],["を"],["した"],["か"],["を"],["知らなかった","しらなかった"],["。"],["わたし"],["は"],["また"],["ユダヤ人","ゆだやひと"],["に"],["も"],["、"],["祭司","さいし"],["たち"],["に"],["も"],["、"],["尊","た"],["っと"],["い"],["人","ひと"],["たち"],["に"],["も"],["、"],["つかさ"],["たち"],["に"],["も"],["、"],["その"],["他","た"],["工事","こうじ"],["を"],["する"],["人々","ひとびと"],["に"],["も"],["まだ"],["知らせなかった","しらせなかった"],["。"]]},{"verse":17,"text":"しかしわたしはついに彼,かれらに言,いった、「あなたがたの見,みるとおり、われわれは難局,なんきょくにある。エルサレムは荒廃,こうはいし、その門,もんは火,ひに焼,やかれた。さあ、われわれは再,ふたたび世,よのはずかしめをうけることのないように、エルサレムの城壁,じょうへきを築,きずこう」。","tok":[["しかし"],["わたし"],["は"],["ついに"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["の"],["見る","みる"],["と"],["おり"],["、"],["われわれ"],["は"],["難局","なんきょく"],["に"],["ある"],["。"],["エルサレム"],["は"],["荒廃","こうはい"],["し"],["、"],["その"],["門","もん"],["は"],["火","ひ"],["に"],["焼かれた","やかれた"],["。"],["さあ"],["、"],["われわれ"],["は"],["再び","ふたたび"],["世","よ"],["の"],["はずかし"],["め"],["を"],["うける"],["こと"],["の"],["ない"],["よう"],["に"],["、"],["エルサレム"],["の"],["城壁","じょうへき"],["を"],["築こう","きずこう"],["」"],["。"]]},{"verse":18,"text":"そして、わたしの神,かみがよくわたしを助,たすけられたことを彼,かれらに告,つげ、また王,おうがわたしに語,かたられた言葉,ことばをも告,つげたので、彼,かれらは「さあ、立,たち上,あがって築,きずこう」と言,いい、奮,ふるい立,たって、この良,よきわざに着手,ちゃくしゅしようとした。","tok":[["そして"],["、"],["わたし"],["の"],["神","かみ"],["が"],["よく"],["わたし"],["を"],["助けられた","たすけられた"],["こと"],["を"],["彼","かれ"],["ら"],["に"],["告","つげ"],["、"],["また"],["王","おう"],["が"],["わたし"],["に"],["語られた","かたられた"],["言葉","ことば"],["を"],["も"],["告","つげ"],["た"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["「"],["さあ"],["、"],["立ち上がって","たちあがって"],["築こう","きずこう"],["」"],["と"],["言い","いい"],["、"],["奮い立って","ふるいたって"],["、"],["この"],["良き","よき"],["わざ"],["に"],["着手","ちゃくしゅ"],["しよう"],["と"],["した"],["。"]]},{"verse":19,"text":"ところがホロニびとサンバラテ、アンモンびと奴隷,どれいトビヤおよびアラビヤびとガシムがこれを聞,きいて、われわれをあざけり、われわれを侮,あなどって言,いった、「あなたがたは何,なにをするのか、王,おうに反逆,はんぎゃくしようとするのか」。","tok":[["ところ"],["が"],["ホロニ"],["びと"],["サンバラテ"],["、"],["アンモン"],["びと"],["奴隷","どれい"],["トビヤ"],["および"],["アラビヤ"],["びと"],["ガシム"],["が"],["これ"],["を"],["聞いて","きいて"],["、"],["われわれ"],["を"],["あざけり"],["、"],["われわれ"],["を"],["侮って","あなどって"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["何に","なに"],["を"],["する"],["の"],["か"],["、"],["王","おう"],["に"],["反逆","はんぎゃく"],["しよう"],["と"],["する"],["の"],["か"],["」"],["。"]]},{"verse":20,"text":"わたしは彼,かれらに答,こたえて言,いった、「天,てんの神,かみがわれわれを恵,めぐまれるので、そのしもべであるわれわれは奮,ふるい立,たって築,きずくのである。しかしあなたがたはエルサレムに何,なにの分,ぶんもなく、権利,けんりもなく、記念,きねんもない」。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["に"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["天","てん"],["の"],["神","かみ"],["が"],["われわれ"],["を"],["恵れる","めぐまれる"],["ので"],["、"],["その"],["しもべ"],["で"],["ある"],["われわれ"],["は"],["奮い立って","ふるいたって"],["築く","きずく"],["ので"],["ある"],["。"],["しかし"],["あなた"],["がた"],["は"],["エルサレム"],["に"],["何","なに"],["の"],["分","ぶん"],["も"],["なく"],["、"],["権利","けんり"],["も"],["なく"],["、"],["記念","きねん"],["も"],["ない"],["」"],["。"]]}]
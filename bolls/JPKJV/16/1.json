[{"verse":1,"text":"ハカリヤの子,こネヘミヤの言葉,ことば。第,だい二十年,ねんのキスレウの月,つきに、わたしが首都,しゅとスサにいた時,とき、","tok":[["ハカリヤ"],["の"],["子","こ"],["ネヘミヤ"],["の"],["言葉","ことば"],["。"],["第","だい"],["二十","にじゅう"],["年","ねん"],["の"],["キスレウ"],["の"],["月","つき"],["に"],["、"],["わたし"],["が"],["首都","しゅと"],["スサ"],["に"],["いた"],["時","とき"],["、"]]},{"verse":2,"text":"わたしの兄弟,きょうだいのひとりハナニが数人,すうにんの者,ものと共,ともにユダから来,きたので、わたしは捕囚,ほしゅうを免,まぬかれて生,いき残,のこったユダヤ人,ひとの事,ことおよびエルサレムの事,ことを尋,たずねた。","tok":[["わたし"],["の"],["兄弟","きょうだい"],["の"],["ひとり"],["ハナニ"],["が"],["数人","すうにん"],["の"],["者","もの"],["と"],["共","とも"],["に"],["ユダ"],["から"],["来た","きた"],["ので"],["、"],["わたし"],["は"],["捕囚","ほしゅう"],["を"],["免かれて","まぬかれて"],["生き残った","いきのこった"],["ユダヤ人","ゆだやひと"],["の"],["事","こと"],["および"],["エルサレム"],["の"],["事","こと"],["を"],["尋ねた","たずねた"],["。"]]},{"verse":3,"text":"彼,かれらはわたしに言,いった、「かの州,しゅうで捕囚,ほしゅうを免,まぬかれて生,いき残,のこった者,ものは大,おおいなる悩,なやみと、はずかしめのうちにあり、エルサレムの城壁,じょうへきはくずされ、その門,もんは火,ひで焼,やかれたままであります」と。","tok":[["彼","かれ"],["ら"],["は"],["わたし"],["に"],["言った","いった"],["、"],["「"],["かの"],["州","しゅう"],["で"],["捕囚","ほしゅう"],["を"],["免かれて","まぬかれて"],["生き残った","いきのこった"],["者","もの"],["は"],["大いなる","おおいなる"],["悩み","なやみ"],["と"],["、"],["はずかしめ"],["の"],["うち"],["に"],["あり"],["、"],["エルサレム"],["の"],["城壁","じょうへき"],["は"],["くずされ"],["、"],["その"],["門","もん"],["は"],["火","ひ"],["で"],["焼かれた","やかれた"],["まま"],["で"],["あります"],["」"],["と"],["。"]]},{"verse":4,"text":"わたしはこれらの言葉,ことばを聞,きいた時,とき、すわって泣,なき、数日,すうじつのあいだ嘆,なげき悲,かなしみ、断食,だんじきして天,てんの神,かみの前,まえに祈,いのって、","tok":[["わたし"],["は"],["これ"],["ら"],["の"],["言葉","ことば"],["を"],["聞いた","きいた"],["時","とき"],["、"],["すわって"],["泣","なき"],["、"],["数日","すうじつ"],["の"],["あいだ"],["嘆き悲しみ","なげきかなしみ"],["、"],["断食","だんじき"],["して"],["天","てん"],["の"],["神","かみ"],["の"],["前","まえ"],["に"],["祈って","いのって"],["、"]]},{"verse":5,"text":"言,いった、「天,てんの神,かみ、主,しゅ、おのれを愛,あいし、その戒,いましめを守,まもる者,ものには契約,けいやくを守,まもり、いつくしみを施,ほどこされる大,おおいなる恐,おそるべき神,かみよ、","tok":[["言った","いった"],["、"],["「"],["天","てん"],["の"],["神","かみ"],["、"],["主","しゅ"],["、"],["おのれ"],["を"],["愛し","あいし"],["、"],["その"],["戒しめ","いましめ"],["を"],["守者","まもるもの"],["に"],["は"],["契約","けいやく"],["を"],["守り","まもり"],["、"],["いつくしみ"],["を"],["施される","ほどこされる"],["大いなる","おおいなる"],["恐るべき","おそるべき"],["神","かみ"],["よ"],["、"]]},{"verse":6,"text":"どうぞ耳,みみを傾,かたむけ、目,めを開,ひらいてしもべの祈,いのりを聞,きいてください。わたしは今,いま、あなたのしもべであるイスラエルの子孫,しそんのために、昼,ひるも夜,よるもみ前,まえに祈,いのり、われわれイスラエルの子孫,しそんが、あなたに対,たいして犯,おかした罪,つみをざんげいたします。まことにわたしも、わたしの父,ちちの家,いえも罪,つみを犯,おかしました。","tok":[["どうぞ"],["耳","みみ"],["を"],["傾むけ","かたむけ"],["、"],["目","め"],["を"],["開らいて","ひらいて"],["しもべ"],["の"],["祈","いのり"],["を"],["聞いて","きいて"],["ください"],["。"],["わたし"],["は"],["今","いま"],["、"],["あなた"],["の"],["しもべ"],["で"],["ある"],["イスラエル"],["の"],["子孫","しそん"],["の"],["ため"],["に"],["、"],["昼","ひる"],["も"],["夜","よる"],["も"],["み前","みまえ"],["に"],["祈","いのり"],["、"],["われわれ"],["イスラエル"],["の"],["子孫","しそん"],["が"],["、"],["あなた"],["に対して","にたいして"],["犯した","おかした"],["罪","つみ"],["を"],["ざんげ"],["いたします"],["。"],["まこと"],["に"],["わたし"],["も"],["、"],["わたし"],["の"],["父","ちち"],["の"],["家","いえ"],["も"],["罪","つみ"],["を"],["犯しました","おかしました"],["。"]]},{"verse":7,"text":"われわれはあなたに対,たいして大,おおいに悪,わるい事,ことを行,おこない、あなたのしもべモーセに命,めいじられた戒,いましめをも、定,さだめをも、おきてをも守,まもりませんでした。","tok":[["われわれ"],["は"],["あなた"],["に対して","にたいして"],["大いに","おおいに"],["悪い","わるい"],["事","こと"],["を"],["行ない","おこない"],["、"],["あなた"],["の"],["しもべ"],["モーセ"],["に"],["命じられた","めいじられた"],["戒しめ","いましめ"],["を"],["も"],["、"],["定め","さだめ"],["を"],["も"],["、"],["おきて"],["を"],["も"],["守りませんでした","まもりませんでした"],["。"]]},{"verse":8,"text":"どうぞ、あなたのしもべモーセに命,めいじられた言葉,ことばを、思,おもい起,おこしてください。すなわちあなたは言,いわれました、『もしあなたがたが罪,つみを犯,おかすならば、わたしはあなたがたを、もろもろの民,たみの間,あいだに散,ちらす。","tok":[["どうぞ"],["、"],["あなた"],["の"],["しもべ"],["モーセ"],["に"],["命じられた","めいじられた"],["言葉","ことば"],["を"],["、"],["思い起こして","おもいおこして"],["ください"],["。"],["すなわち"],["あなた"],["は"],["言われました","いわれました"],["、"],["『"],["もし"],["あなた"],["がた"],["が"],["罪","つみ"],["を"],["犯すならば","おかすならば"],["、"],["わたし"],["は"],["あなた"],["がた"],["を"],["、"],["もろもろ"],["の"],["民","たみ"],["の"],["間","あいだ"],["に"],["散らす","ちらす"],["。"]]},{"verse":9,"text":"しかし、あなたがたがわたしに立,たち返,かえり、わたしの戒,いましめを守,まもって、これを行,おこなうならば、たといあなたがたのうちの散,ちらされた者,ものが、天,てんの果,はてにいても、わたしはそこから彼,かれらを集,あつめ、わたしの名,なを住,すまわせるために選,えらんだ所,ところに連,つれて来,くる』と。","tok":[["しかし"],["、"],["あなた"],["がた"],["が"],["わたし"],["に"],["立ち返り","たちかえり"],["、"],["わたし"],["の"],["戒しめ","いましめ"],["を"],["守って","まもって"],["、"],["これ"],["を"],["行なうならば","おこなうならば"],["、"],["たとい"],["あなた"],["がた"],["の"],["うち"],["の"],["散らされた","ちらされた"],["者","もの"],["が"],["、"],["天","てん"],["の"],["果て","はて"],["に"],["いて"],["も"],["、"],["わたし"],["は"],["そこ"],["から"],["彼","かれ"],["ら"],["を"],["集め","あつめ"],["、"],["わたし"],["の"],["名","な"],["を"],["住まわせる","すまわせる"],["ため"],["に"],["選らんだ","えらんだ"],["所","ところ"],["に"],["連れて","つれて"],["来る","くる"],["』"],["と"],["。"]]},{"verse":10,"text":"彼,かれらは、あなたが大,おおいなる力,ちからと強,つよい手,てをもって、あがなわれたあなたのしもべ、あなたの民,たみです。","tok":[["彼","かれ"],["ら"],["は"],["、"],["あなた"],["が"],["大いなる","おおいなる"],["力","ちから"],["と"],["強い","つよい"],["手","て"],["を"],["もって"],["、"],["あがなわれた"],["あなた"],["の"],["しもべ"],["、"],["あなた"],["の"],["民","たみ"],["です"],["。"]]},{"verse":11,"text":"主,しゅよ、どうぞしもべの祈,いのりと、あなたの名,なを恐,おそれることを喜,よろこぶあなたのしもべらの祈,いのりに耳,みみを傾,かたむけてください。どうぞ、きょう、しもべを恵,めぐみ、この人,ひとの目,めの前,まえであわれみを得,えさせてください」。この時,とき、わたしは王,おうの給仕,きゅうじ役,やくであった。","tok":[["主","しゅ"],["よ"],["、"],["どうぞ"],["しもべ"],["の"],["祈","いのり"],["と"],["、"],["あなた"],["の"],["名","な"],["を"],["恐れる","おそれる"],["こと"],["を"],["喜こぶ","よろこぶ"],["あなた"],["の"],["しもべ"],["ら"],["の"],["祈","いのり"],["に"],["耳","みみ"],["を"],["傾むけて","かたむけて"],["ください"],["。"],["どうぞ"],["、"],["きょう"],["、"],["しもべ"],["を"],["恵み","めぐみ"],["、"],["この"],["人","ひと"],["の"],["目","め"],["の"],["前","まえ"],["で"],["あわれみ"],["を"],["得させて","えさせて"],["ください"],["」"],["。"],["この"],["時","とき"],["、"],["わたし"],["は"],["王","おう"],["の"],["給仕","きゅうじ"],["役","やく"],["で"],["あった"],["。"]]}]
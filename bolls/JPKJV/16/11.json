[{"verse":1,"text":"民,たみのつかさたちはエルサレムに住,すみ、その他,たの民,たみはくじを引,ひいて、十人,にんのうちからひとりずつを、聖都,せいとエルサレムに来,きて住,すませ、九人,にんを他,たの町々,まちまちに住,すませた。","tok":[["民","たみ"],["の"],["つかさ"],["たち"],["は"],["エルサレム"],["に"],["住み","すみ"],["、"],["その"],["他","た"],["の"],["民","たみ"],["は"],["くじ"],["を"],["引いて","ひいて"],["、"],["十人","にん"],["の"],["うち"],["から"],["ひとり"],["ずつ"],["を"],["、"],["聖都","せいと"],["エルサレム"],["に"],["来て","きて"],["住ませ","すませ"],["、"],["九人","にん"],["を"],["他","た"],["の"],["町々","まちまち"],["に"],["住ませた","すませた"],["。"]]},{"verse":2,"text":"またすべてみずから進,すすみでてエルサレムに住,すむことを申,もうし出,でた人々,ひとびとは、民,たみはこれを祝福,しゅくふくした。","tok":[["また"],["すべて"],["みずから"],["進みでて","すすみでて"],["エルサレム"],["に"],["住む","すむ"],["こと"],["を"],["申し出た","もうしでた"],["人々","ひとびと"],["は"],["、"],["民","たみ"],["は"],["これ"],["を"],["祝福","しゅくふく"],["した"],["。"]]},{"verse":3,"text":"さてエルサレムに住,すんだこの州,しゅうの長,ちょうたちは次,つぎのとおりである。ただしユダの町々,まちまちではおのおのその町々,まちまちにある自分,じぶんの所有,しょゆう地,ちに住,すんだ。すなわちイスラエルびと、祭司,さいし、レビびと、宮,みやに仕,つかえるしもべ、およびソロモンのしもべであった者,ものたちの子孫,しそんである。","tok":[["さて"],["エルサレム"],["に"],["住","すんだこ"],["の"],["州","しゅう"],["の"],["長","ちょう"],["たち"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["ただし"],["ユダ"],["の"],["町々","まちまち"],["で"],["は"],["おのおの"],["その"],["町々","まちまち"],["に"],["ある"],["自分","じぶん"],["の"],["所有地","しょゆうち"],["に"],["住んだ","すんだ"],["。"],["すなわち"],["イスラエル"],["び"],["と"],["、"],["祭司","さいし"],["、"],["レビ"],["び"],["と"],["、"],["宮","みや"],["に"],["仕える","つかえる"],["しもべ"],["、"],["および"],["ソロモン"],["の"],["しもべ"],["で"],["あった"],["者","もの"],["たち"],["の"],["子孫","しそん"],["で"],["ある"],["。"]]},{"verse":4,"text":"そしてエルサレムにはユダの子孫,しそんおよびベニヤミンの子孫,しそんのうちのある者,ものたちが住,すんだ。すなわちユダの子孫,しそんではウジヤの子,こアタヤで、ウジヤはゼカリヤの子,こ、ゼカリヤはアマリヤの子,こ、アマリヤはシパテヤの子,こ、シパテヤはマハラレルの子,こ、マハラレルはペレヅの子孫,しそんである。","tok":[["そして"],["エルサレム"],["に"],["は"],["ユダ"],["の"],["子孫","しそん"],["および"],["ベニヤミン"],["の"],["子孫","しそん"],["の"],["うち"],["の"],["ある"],["者","もの"],["たち"],["が"],["住んだ","すんだ"],["。"],["すなわち"],["ユダ"],["の"],["子孫","しそん"],["で"],["は"],["ウジヤ"],["の"],["子","こ"],["アタヤ"],["で"],["、"],["ウジヤ"],["は"],["ゼカリヤ"],["の"],["子","こ"],["、"],["ゼカリヤ"],["は"],["アマリヤ"],["の"],["子","こ"],["、"],["アマリヤ"],["は"],["シパテヤ"],["の"],["子","こ"],["、"],["シパテヤ"],["は"],["マハラレル"],["の"],["子","こ"],["、"],["マハラレル"],["は"],["ペレヅ"],["の"],["子孫","しそん"],["で"],["ある"],["。"]]},{"verse":5,"text":"またバルクの子,こマアセヤで、バルクはコロホゼの子,こ、コロホゼはハザヤの子,こ、ハザヤはアダヤの子,こ、アダヤはヨヤリブの子,こ、ヨヤリブはゼカリヤの子,こ、ゼカリヤはシロニびとの子,こである。","tok":[["また"],["バルク"],["の"],["子","こ"],["マアセヤ"],["で"],["、"],["バルク"],["は"],["コロホゼ"],["の"],["子","こ"],["、"],["コロホゼ"],["は"],["ハザヤ"],["の"],["子","こ"],["、"],["ハザヤ"],["は"],["アダヤ"],["の"],["子","こ"],["、"],["アダヤ"],["は"],["ヨヤリブ"],["の"],["子","こ"],["、"],["ヨヤリブ"],["は"],["ゼカリヤ"],["の"],["子","こ"],["、"],["ゼカリヤ"],["は"],["シロニ"],["びと"],["の"],["子","こ"],["で"],["ある"],["。"]]},{"verse":6,"text":"ペレヅの子孫,しそんでエルサレムに住,すんだ者,ものは合,あわせて四百六十八人,にんで、みな勇敢,ゆうかんな人々,ひとびとである。","tok":[["ペレヅ"],["の"],["子孫","しそん"],["で"],["エルサレム"],["に"],["住んだ","すんだ"],["者","もの"],["は"],["合","あわせ"],["て"],["四百六十八","よんひゃくろくじゅうはち"],["人","にん"],["で"],["、"],["みな"],["勇敢","ゆうかん"],["な"],["人々","ひとびと"],["で"],["ある"],["。"]]},{"verse":7,"text":"ベニヤミンの子孫,しそんでは次,つぎのとおりである。すなわちメシュラムの子,こサルで、メシュラムはヨエデの子,こ、ヨエデはペダヤの子,こ、ペダヤはコラヤの子,こ、コラヤはマアセヤの子,こ、マアセヤはイテエルの子,こ、イテエルはエサヤの子,こである。","tok":[["ベニヤミン"],["の"],["子孫","しそん"],["で"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["すなわち"],["メシュラム"],["の"],["子","こ"],["サル"],["で"],["、"],["メシュラム"],["は"],["ヨエデ"],["の"],["子","こ"],["、"],["ヨエデ"],["は"],["ペダヤ"],["の"],["子","こ"],["、"],["ペダヤ"],["は"],["コラヤ"],["の"],["子","こ"],["、"],["コラヤ"],["は"],["マアセヤ"],["の"],["子","こ"],["、"],["マアセヤ"],["は"],["イテエル"],["の"],["子","こ"],["、"],["イテエル"],["は"],["エサヤ"],["の"],["子","こ"],["で"],["ある"],["。"]]},{"verse":8,"text":"その次,つぎはガバイおよびサライなどで合,あわせて九百二十八人,にん。","tok":[["その"],["次","つぎ"],["は"],["ガバイ"],["および"],["サライ"],["など"],["で"],["合","あわせ"],["て"],["九百二十八","きゅうひゃくにじゅうはち"],["人","にん"],["。"]]},{"verse":9,"text":"ジクリの子,こヨエルが彼,かれらの監督,かんとくである。ハッセヌアの子,こユダがその副官,ふくかんとして町,まちを治,おさめた。","tok":[["ジクリ"],["の"],["子","こ"],["ヨエル"],["が"],["彼","かれ"],["ら"],["の"],["監督","かんとく"],["で"],["ある"],["。"],["ハッセヌア"],["の"],["子","こ"],["ユダ"],["が"],["その"],["副官","ふくかん"],["として"],["町","まち"],["を"],["治めた","おさめた"],["。"]]},{"verse":10,"text":"祭司,さいしではヨヤリブの子,こエダヤ、ヤキン、","tok":[["祭司","さいし"],["で"],["は"],["ヨヤリブ"],["の"],["子","こ"],["エダヤ"],["、"],["ヤキン"],["、"]]},{"verse":11,"text":"および神,かみの宮,みやのつかさセラヤで、セラヤはヒルキヤの子,こ、ヒルキヤはメシュラムの子,こ、メシュラムはザドクの子,こ、ザドクはメラヨテの子,こ、メラヨテはアヒトブの子,こである。","tok":[["および"],["神","かみ"],["の"],["宮","みや"],["の"],["つかさ"],["セラヤ"],["で"],["、"],["セラヤ"],["は"],["ヒルキヤ"],["の"],["子","こ"],["、"],["ヒルキヤ"],["は"],["メシュラム"],["の"],["子","こ"],["、"],["メシュラム"],["は"],["ザドク"],["の"],["子","こ"],["、"],["ザドク"],["は"],["メラヨテ"],["の"],["子","こ"],["、"],["メラヨテ"],["は"],["アヒトブ"],["の"],["子","こ"],["で"],["ある"],["。"]]},{"verse":12,"text":"宮,みやの務,つとめをするその兄弟,きょうだいは八百二十二人,にんあり、また、エロハムの子,こアダヤがある。エロハムはペラリヤの子,こ、ペラリヤはアムジの子,こ、アムジはゼカリヤの子,こ、ゼカリヤはパシホルの子,こ、パシホルはマルキヤの子,こである。","tok":[["宮","みや"],["の"],["務め","つとめ"],["を"],["する"],["その"],["兄弟","きょうだい"],["は"],["八百二十二","はちひゃくにじゅうに"],["人","にん"],["あり"],["、"],["また"],["、"],["エロハム"],["の"],["子","こ"],["アダヤ"],["が"],["ある"],["。"],["エロハム"],["は"],["ペラリヤ"],["の"],["子","こ"],["、"],["ペラリヤ"],["は"],["アムジ"],["の"],["子","こ"],["、"],["アムジ"],["は"],["ゼカリヤ"],["の"],["子","こ"],["、"],["ゼカリヤ"],["は"],["パシホル"],["の"],["子","こ"],["、"],["パシホル"],["は"],["マルキヤ"],["の"],["子","こ"],["で"],["ある"],["。"]]},{"verse":13,"text":"アダヤの兄弟,きょうだいで、氏族,しぞくの長,ちょうたる者,ものは二百四十二人,にんあり、またアザリエルの子,こアマシサイがある。アザリエルはアハザイの子,こ、アハザイはメシレモテの子,こ、メシレモテはインメルの子,こである。","tok":[["アダヤ"],["の"],["兄弟","きょうだい"],["で"],["、"],["氏族","しぞく"],["の"],["長うたる","ちょうたる"],["者","もの"],["は"],["二百四十二","にひゃくよんじゅうに"],["人","にん"],["あり"],["、"],["また"],["アザリエル"],["の"],["子","こ"],["アマシサイ"],["が"],["ある"],["。"],["アザリエル"],["は"],["アハザイ"],["の"],["子","こ"],["、"],["アハザイ"],["は"],["メシレモテ"],["の"],["子","こ"],["、"],["メシレモテ"],["は"],["インメル"],["の"],["子","こ"],["で"],["ある"],["。"]]},{"verse":14,"text":"その兄弟,きょうだいである勇士,ゆうしは百二十八人,にんあり、その監督,かんとくはハッゲドリムの子,こザブデエルである。","tok":[["その"],["兄弟","きょうだい"],["で"],["ある"],["勇士","ゆうし"],["は"],["百二十八","ひゃくにじゅうはち"],["人","にん"],["あり"],["、"],["その"],["監督","かんとく"],["は"],["ハッゲドリム"],["の"],["子","こ"],["ザブデエル"],["で"],["ある"],["。"]]},{"verse":15,"text":"レビびとではハシュブの子,こシマヤで、ハシュブはアズリカムの子,こ、アズリカムはハシャビヤの子,こ、ハシャビヤはブンニの子,こである。","tok":[["レビ"],["びと"],["で"],["は"],["ハシュブ"],["の"],["子","こ"],["シマヤ"],["で"],["、"],["ハシュブ"],["は"],["アズリカム"],["の"],["子","こ"],["、"],["アズリカム"],["は"],["ハシャビヤ"],["の"],["子","こ"],["、"],["ハシャビヤ"],["は"],["ブンニ"],["の"],["子","こ"],["で"],["ある"],["。"]]},{"verse":16,"text":"またシャベタイおよびヨザバデがある。これらはレビびとのかしらであって、神,かみの宮,みやの外,そとのわざをつかさどった。","tok":[["また"],["シャベタイ"],["および"],["ヨザバデ"],["が"],["ある"],["。"],["これ"],["ら"],["は"],["レビ"],["びと"],["の"],["かしら"],["で"],["あって"],["、"],["神","かみ"],["の"],["宮","みや"],["の"],["外","そと"],["の"],["わざ"],["を"],["つかさどった"],["。"]]},{"verse":17,"text":"またミカの子,こマッタニヤがある。ミカはザブデの子,こ、ザブデはアサフの子,こである。マッタニヤは祈,いのりの時,ときに感謝,かんしゃの言葉,ことばを唱,となえ始,はじめる者,ものである。その兄弟,きょうだいのうちのバクブキヤは彼,かれに次,つぐ者,ものであった。またシャンマの子,こアブダがある。シャンマはガラルの子,こ、ガラルはエドトンの子,こである。","tok":[["また"],["ミカ"],["の"],["子","こ"],["マッタニヤ"],["が"],["ある"],["。"],["ミカ"],["は"],["ザブデ"],["の"],["子","こ"],["、"],["ザブデ"],["は"],["アサフ"],["の"],["子","こ"],["で"],["ある"],["。"],["マッタニヤ"],["は"],["祈","いのり"],["の"],["時","とき"],["に"],["感謝","かんしゃ"],["の"],["言葉","ことば"],["を"],["唱え","となえ"],["始める","はじめる"],["者","もの"],["で"],["ある"],["。"],["その"],["兄弟","きょうだい"],["の"],["うち"],["の"],["バクブキヤ"],["は"],["彼","かれ"],["に"],["次ぐ","つぐ"],["者","もの"],["で"],["あった"],["。"],["また"],["シャンマ"],["の"],["子","こ"],["アブダ"],["が"],["ある"],["。"],["シャンマ"],["は"],["ガラル"],["の"],["子","こ"],["、"],["ガラル"],["は"],["エドトン"],["の"],["子","こ"],["で"],["ある"],["。"]]},{"verse":18,"text":"聖都,せいとにおるレビびとは合,あわせて二百八十四人,にんであった。","tok":[["聖都","せいと"],["に"],["おる"],["レビ"],["び"],["と"],["は"],["合","あわせ"],["て"],["二百八十四","にひゃくはちじゅうよん"],["人","にん"],["で"],["あった"],["。"]]},{"verse":19,"text":"門衛,もんえいでは門,もんを守,まもるアックブ、タルモンおよびその兄弟,きょうだいたち合,あわせて百七十二人,にんである。","tok":[["門衛","もんえい"],["で"],["は"],["門","もん"],["を"],["守","まもる"],["アックブ"],["、"],["タルモン"],["および"],["その"],["兄弟","きょうだい"],["たち"],["合","あわせ"],["て"],["百七十二","ひゃくななじゅうに"],["人","にん"],["で"],["ある"],["。"]]},{"verse":20,"text":"その他,たのイスラエルびと、祭司,さいし、レビびとたちは皆,みなユダのすべての町々,まちまちにあって、おのおの自分,じぶんの嗣,し業,ぎょうにとどまった。","tok":[["その"],["他","た"],["の"],["イスラエル"],["び"],["と"],["、"],["祭司","さいし"],["、"],["レビ"],["びと"],["たち"],["は"],["皆","みな"],["ユダ"],["の"],["すべて"],["の"],["町々","まちまち"],["に"],["あって"],["、"],["おのおの"],["自分","じぶん"],["の"],["嗣業","しぎょう"],["に"],["とどまった"],["。"]]},{"verse":21,"text":"ただし宮,みやに仕,つかえるしもべたちはオペルに住,すみ、ヂハおよびギシパが宮,みやに仕,つかえるしもべたちを監督,かんとくしていた。","tok":[["ただし"],["宮","みや"],["に"],["仕える","つかえる"],["しもべ"],["たち"],["は"],["オペル"],["に"],["住み","すみ"],["、"],["ヂハ"],["および"],["ギシパ"],["が"],["宮","みや"],["に"],["仕える","つかえる"],["しもべ"],["たち"],["を"],["監督","かんとく"],["して"],["いた"],["。"]]},{"verse":22,"text":"エルサレムにおるレビびとの監督,かんとくはウジである。ウジはバニの子,こ、バニはハシャビヤの子,こ、ハシャビヤはマッタニヤの子,こ、マッタニヤはミカの子,こである。ミカは歌,うたうたう者,ものなるアサフの子孫,しそんである。ウジは神,かみの宮,みやのわざを監督,かんとくした。","tok":[["エルサレム"],["に"],["おる"],["レビ"],["びと"],["の"],["監督","かんとく"],["は"],["ウジ"],["で"],["ある"],["。"],["ウジ"],["は"],["バニ"],["の"],["子","こ"],["、"],["バニ"],["は"],["ハシャビヤ"],["の"],["子","こ"],["、"],["ハシャビヤ"],["は"],["マッタニヤ"],["の"],["子","こ"],["、"],["マッタニヤ"],["は"],["ミカ"],["の"],["子","こ"],["で"],["ある"],["。"],["ミカ"],["は"],["歌","うた"],["うたう"],["者","もの"],["なる"],["アサフ"],["の"],["子孫","しそん"],["で"],["ある"],["。"],["ウジ"],["は"],["神","かみ"],["の"],["宮","みや"],["の"],["わざ"],["を"],["監督","かんとく"],["した"],["。"]]},{"verse":23,"text":"彼,かれらについては王,おうからの命令,めいれいがあって、歌,うたうたう者,ものに日々,ひびの定,さだまった分,ぶんを与,あたえさせた。","tok":[["彼","かれ"],["ら"],["について"],["は"],["王","おう"],["から"],["の"],["命令","めいれい"],["が"],["あって"],["、"],["歌","うた"],["うたう"],["者","もの"],["に"],["日々","ひび"],["の"],["定まった","さだまった"],["分","ぶん"],["を"],["与えさせた","あたえさせた"],["。"]]},{"verse":24,"text":"またユダの子,こゼラの子孫,しそんであるメシザベルの子,こペタヒヤは王,おうの手,てに属,ぞくして民,たみに関,かんするすべての事,ことを取,とり扱,あつかった。","tok":[["また"],["ユダ"],["の"],["子","こ"],["ゼラ"],["の"],["子孫","しそん"],["で"],["ある"],["メシザベル"],["の"],["子","こ"],["ペタヒヤ"],["は"],["王","おう"],["の"],["手","て"],["に"],["属して","ぞくして"],["民","たみ"],["に"],["関する","かんする"],["すべて"],["の"],["事","こと"],["を"],["取扱った","とりあつかった"],["。"]]},{"verse":25,"text":"また村々,むらむらとその田畑,たはたについては、ユダの子孫,しそんの者,ものはキリアテ・アルバとその村々,むらむら、デボンとその村々,むらむら、エカブジエルとその村々,むらむらに住,すみ、","tok":[["また"],["村々","むらむら"],["と"],["その"],["田畑","たはた"],["について"],["は"],["、"],["ユダ"],["の"],["子孫","しそん"],["の"],["者","もの"],["は"],["キリアテ"],["・"],["アルバ"],["と"],["その"],["村々","むらむら"],["、"],["デボン"],["と"],["その"],["村々","むらむら"],["、"],["エカブジエル"],["と"],["その"],["村々","むらむら"],["に"],["住み","すみ"],["、"]]},{"verse":26,"text":"エシュア、モラダおよびベテペレテに住,すみ、","tok":[["エシュア"],["、"],["モラダ"],["および"],["ベテペレテ"],["に"],["住み","すみ"],["、"]]},{"verse":27,"text":"ハザル・シュアルおよびベエルシバとその村々,むらむらに住,すみ、","tok":[["ハザル"],["・"],["シュアル"],["および"],["ベエルシバ"],["と"],["その"],["村々","むらむら"],["に"],["住み","すみ"],["、"]]},{"verse":28,"text":"チクラグおよびメコナとその村々,むらむらに住,すみ、","tok":[["チクラグ"],["および"],["メコナ"],["と"],["その"],["村々","むらむら"],["に"],["住み","すみ"],["、"]]},{"verse":29,"text":"エンリンモン、ザレア、ヤルムテに住,すみ、","tok":[["エンリンモン"],["、"],["ザレア"],["、"],["ヤルムテ"],["に"],["住み","すみ"],["、"]]},{"verse":30,"text":"ザノア、アドラムおよびそれらの村々,むらむら、ラキシとその田野,でんや、アゼカとその村々,むらむらに住,すんだ。こうして彼,かれらはベエルシバからヒンノムの谷,たににまで宿営,しゅくえいした。","tok":[["ザノア"],["、"],["アドラム"],["および"],["それ"],["ら"],["の"],["村々","むらむら"],["、"],["ラキシ"],["と"],["その"],["田野","でんや"],["、"],["アゼカ"],["と"],["その"],["村々","むらむら"],["に"],["住んだ","すんだ"],["。"],["こう"],["して"],["彼","かれ"],["ら"],["は"],["ベエルシバ"],["から"],["ヒンノム"],["の"],["谷","たに"],["に"],["まで"],["宿営","しゅくえい"],["した"],["。"]]},{"verse":31,"text":"ベニヤミンの子孫,しそんはまたゲバからミクマシ、アヤおよびベテルとその村々,むらむらに住,すみ、","tok":[["ベニヤミン"],["の"],["子孫","しそん"],["は"],["また"],["ゲバ"],["から"],["ミクマシ"],["、"],["アヤ"],["および"],["ベテル"],["と"],["その"],["村々","むらむら"],["に"],["住み","すみ"],["、"]]},{"verse":32,"text":"アナトテ、ノブ、アナニヤ、","tok":[["アナトテ"],["、"],["ノブ"],["、"],["アナニヤ"],["、"]]},{"verse":33,"text":"ハゾル、ラマ、ギッタイム、","tok":[["ハゾル"],["、"],["ラマ"],["、"],["ギッタイム"],["、"]]},{"verse":34,"text":"ハデデ、ゼボイム、ネバラテ、","tok":[["ハデデ"],["、"],["ゼボイム"],["、"],["ネバラテ"],["、"]]},{"verse":35,"text":"ロド、オノ、工人,こうじんの谷,たにに住,すんだ。","tok":[["ロド"],["、"],["オノ"],["、"],["工人","こうじん"],["の"],["谷","たに"],["に"],["住んだ","すんだ"],["。"]]},{"verse":36,"text":"レビびとの組,くみのユダにあるもののうちベニヤミンに合,あわしたものもあった。","tok":[["レビ"],["びと"],["の"],["組","くみ"],["の"],["ユダ"],["に"],["ある"],["もの"],["の"],["うち"],["ベニヤミン"],["に"],["合わした","あわした"],["もの"],["も"],["あった"],["。"]]}]
[{"verse":1,"text":"シャルテルの子,こゼルバベルおよびエシュアと一緒,いっしょに上,のぼってきた祭司,さいしとレビびとは次,つぎのとおりである。すなわちセラヤ、エレミヤ、エズラ、","tok":[["シャルテル"],["の"],["子","こ"],["ゼルバベル"],["および"],["エシュア"],["と"],["一緒","いっしょ"],["に"],["上って","のぼって"],["きた"],["祭司","さいし"],["と"],["レビ"],["び"],["と"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["すなわち"],["セラヤ"],["、"],["エレミヤ"],["、"],["エズラ"],["、"]]},{"verse":2,"text":"アマリヤ、マルク、ハットシ、","tok":[["アマリヤ"],["、"],["マルク"],["、"],["ハットシ"],["、"]]},{"verse":3,"text":"シカニヤ、レホム、メレモテ、","tok":[["シカニヤ"],["、"],["レホム"],["、"],["メレモテ"],["、"]]},{"verse":4,"text":"イド、ギンネトイ、アビヤ、","tok":[["イド"],["、"],["ギンネトイ"],["、"],["アビヤ"],["、"]]},{"verse":5,"text":"ミヤミン、マアデヤ、ビルガ、","tok":[["ミヤミン"],["、"],["マアデヤ"],["、"],["ビルガ"],["、"]]},{"verse":6,"text":"シマヤ、ヨヤリブ、エダヤ、","tok":[["シマヤ"],["、"],["ヨヤリブ"],["、"],["エダヤ"],["、"]]},{"verse":7,"text":"サライ、アモク、ヒルキヤ、エダヤで、これらの者,ものはエシュアの時代,じだいに祭司,さいしおよびその兄弟,きょうだいらのかしらであった。","tok":[["サライ"],["、"],["アモク"],["、"],["ヒルキヤ"],["、"],["エダヤ"],["で"],["、"],["これ"],["ら"],["の"],["者","もの"],["は"],["エシュア"],["の"],["時代","じだい"],["に"],["祭司","さいし"],["および"],["その"],["兄弟","きょうだい"],["ら"],["の"],["かしら"],["で"],["あった"],["。"]]},{"verse":8,"text":"レビびとではエシュア、ビンヌイ、カデミエル、セレビヤ、ユダ、マッタニヤで、マッタニヤはその兄弟,きょうだいらと共,ともに感謝,かんしゃのことをつかさどった。","tok":[["レビ"],["びと"],["で"],["は"],["エシュア"],["、"],["ビンヌイ"],["、"],["カデミエル"],["、"],["セレビヤ"],["、"],["ユダ"],["、"],["マッタニヤ"],["で"],["、"],["マッタニヤ"],["は"],["その"],["兄弟","きょうだい"],["ら"],["と"],["共","とも"],["に"],["感謝","かんしゃ"],["の"],["こと"],["を"],["つかさどった"],["。"]]},{"verse":9,"text":"また彼,かれらの兄弟,きょうだいであるバグブキヤおよびウンノは彼,かれらの向,むかいに立,たって勤,つとめをした。","tok":[["また"],["彼","かれ"],["ら"],["の"],["兄弟","きょうだい"],["で"],["ある"],["バグブキヤ"],["および"],["ウンノ"],["は"],["彼","かれ"],["ら"],["の"],["向","むかい"],["に"],["立って","たって"],["勤め","つとめ"],["を"],["した"],["。"]]},{"verse":10,"text":"エシュアの子,こはヨアキム、ヨアキムの子,こはエリアシブ、エリアシブの子,こはヨイアダ、","tok":[["エシュア"],["の"],["子","こ"],["は"],["ヨアキム"],["、"],["ヨアキム"],["の"],["子","こ"],["は"],["エリアシブ"],["、"],["エリアシブ"],["の"],["子","こ"],["は"],["ヨイアダ"],["、"]]},{"verse":11,"text":"ヨイアダの子,こはヨナタン、ヨナタンの子,こはヤドアである。","tok":[["ヨイアダ"],["の"],["子","こ"],["は"],["ヨナタン"],["、"],["ヨナタン"],["の"],["子","こ"],["は"],["ヤドア"],["で"],["ある"],["。"]]},{"verse":12,"text":"ヨアキムの時代,じだいに祭司,さいしで氏族,しぞくの長,ちょうであった者,ものはセラヤの氏族,しぞくではメラヤ、エレミヤの氏族,しぞくではハナニヤ、","tok":[["ヨアキム"],["の"],["時代","じだい"],["に"],["祭司","さいし"],["で"],["氏族","しぞく"],["の"],["長","ちょう"],["で"],["あった"],["者","もの"],["は"],["セラヤ"],["の"],["氏族","しぞく"],["で"],["は"],["メラヤ"],["、"],["エレミヤ"],["の"],["氏族","しぞく"],["で"],["は"],["ハナニヤ"],["、"]]},{"verse":13,"text":"エズラの氏族,しぞくではメシュラム、アマリヤの氏族,しぞくではヨハナン、","tok":[["エズラ"],["の"],["氏族","しぞく"],["で"],["は"],["メシュラム"],["、"],["アマリヤ"],["の"],["氏族","しぞく"],["で"],["は"],["ヨハナン"],["、"]]},{"verse":14,"text":"マルキの氏族,しぞくではヨナタン、シバニヤの氏族,しぞくではヨセフ、","tok":[["マルキ"],["の"],["氏族","しぞく"],["で"],["は"],["ヨナタン"],["、"],["シバニヤ"],["の"],["氏族","しぞく"],["で"],["は"],["ヨセフ"],["、"]]},{"verse":15,"text":"ハリムの氏族,しぞくではアデナ、メラヨテの氏族,しぞくではヘルカイ、","tok":[["ハリム"],["の"],["氏族","しぞく"],["で"],["は"],["アデナ"],["、"],["メラヨテ"],["の"],["氏族","しぞく"],["で"],["は"],["ヘルカイ"],["、"]]},{"verse":16,"text":"イドの氏族,しぞくではゼカリヤ、ギンネトンの氏族,しぞくではメシュラム、","tok":[["イド"],["の"],["氏族","しぞく"],["で"],["は"],["ゼカリヤ"],["、"],["ギンネトン"],["の"],["氏族","しぞく"],["で"],["は"],["メシュラム"],["、"]]},{"verse":17,"text":"アビヤの氏族,しぞくではジクリ、ミニヤミンの氏族,しぞく、モアデヤの氏族,しぞくではピルタイ、","tok":[["アビヤ"],["の"],["氏族","しぞく"],["で"],["は"],["ジクリ"],["、"],["ミニヤミン"],["の"],["氏族","しぞく"],["、"],["モアデヤ"],["の"],["氏族","しぞく"],["で"],["は"],["ピルタイ"],["、"]]},{"verse":18,"text":"ビルガの氏族,しぞくではシャンマ、シマヤの氏族,しぞくではヨナタン、","tok":[["ビルガ"],["の"],["氏族","しぞく"],["で"],["は"],["シャンマ"],["、"],["シマヤ"],["の"],["氏族","しぞく"],["で"],["は"],["ヨナタン"],["、"]]},{"verse":19,"text":"ヨヤリブの氏族,しぞくではマッテナイ、エダヤの氏族,しぞくではウジ、","tok":[["ヨヤリブ"],["の"],["氏族","しぞく"],["で"],["は"],["マッテナイ"],["、"],["エダヤ"],["の"],["氏族","しぞく"],["で"],["は"],["ウジ"],["、"]]},{"verse":20,"text":"サライの氏族,しぞくではカライ、アモクの氏族,しぞくではエベル、","tok":[["サライ"],["の"],["氏族","しぞく"],["で"],["は"],["カライ"],["、"],["アモク"],["の"],["氏族","しぞく"],["で"],["は"],["エベル"],["、"]]},{"verse":21,"text":"ヒルキヤの氏族,しぞくではハシャビヤ、エダヤの氏族,しぞくではネタンエルである。","tok":[["ヒルキヤ"],["の"],["氏族","しぞく"],["で"],["は"],["ハシャビヤ"],["、"],["エダヤ"],["の"],["氏族","しぞく"],["で"],["は"],["ネタンエル"],["で"],["ある"],["。"]]},{"verse":22,"text":"レビびとについては、エリアシブ、ヨイアダ、ヨハナンおよびヤドアの時代,じだいに、その氏族,しぞくの長,ちょうたちが登録,とうろくされた。また祭司,さいしたちもペルシャ王,おうダリヨスの治世,ちせいまで登録,とうろくされた。","tok":[["レビ"],["びと"],["について"],["は"],["、"],["エリアシブ"],["、"],["ヨイアダ"],["、"],["ヨハナン"],["および"],["ヤドア"],["の"],["時代","じだい"],["に"],["、"],["その"],["氏族","しぞく"],["の"],["長","ちょう"],["たち"],["が"],["登録","とうろく"],["された"],["。"],["また"],["祭司","さいし"],["たち"],["も"],["ペルシャ"],["王","おう"],["ダリヨス"],["の"],["治世","ちせい"],["まで"],["登録","とうろく"],["された"],["。"]]},{"verse":23,"text":"レビの子孫,しそんで氏族,しぞくの長,ちょうたる者,ものは、エリアシブの子,こヨハナンの世,よまで歴代志,れきだいしの書,しょにしるされている。","tok":[["レビ"],["の"],["子孫","しそん"],["で"],["氏族","しぞく"],["の"],["長うたる","ちょうたる"],["者","もの"],["は"],["、"],["エリアシブ"],["の"],["子","こ"],["ヨハナン"],["の"],["世","よ"],["まで"],["歴代志","れきだいし"],["の"],["書","しょ"],["に"],["しるされて"],["いる"],["。"]]},{"verse":24,"text":"レビびとのかしらはハシャビヤ、セレビヤおよびカデミエルの子,こエシュアであって、その兄弟,きょうだいたち相,あい向,むかい合,あい、組,くみと組,くみと対応,たいおうして神,かみの人,ひとダビデの命令,めいれいに従,したがい、さんびと感謝,かんしゃをささげた。","tok":[["レビ"],["びと"],["の"],["かしら"],["は"],["ハシャビヤ"],["、"],["セレビヤ"],["および"],["カデミエル"],["の"],["子","こ"],["エシュア"],["で"],["あって"],["、"],["その"],["兄弟","きょうだい"],["たち"],["相","あ"],["い"],["向かい合い","むかいあい"],["、"],["組","くみ"],["と"],["組","くみ"],["と"],["対応","たいおう"],["して"],["神","かみ"],["の"],["人","ひと"],["ダビデ"],["の"],["命令","めいれい"],["に"],["従い","したがい"],["、"],["さん"],["びと"],["感謝","かんしゃ"],["を"],["ささげた"],["。"]]},{"verse":25,"text":"マツタニヤ、バクブキヤ、オバデヤ、メシュラム、タルモンおよびアックブは門,もんを守,まもる者,もので門,もんの内,うちの倉,くらを監督,かんとくした。","tok":[["マツタニヤ"],["、"],["バクブキヤ"],["、"],["オバデヤ"],["、"],["メシュラム"],["、"],["タルモン"],["および"],["アックブ"],["は"],["門","もん"],["を"],["守者","まもるもの"],["で"],["門","もん"],["の"],["内","うち"],["の"],["倉","くら"],["を"],["監督","かんとく"],["した"],["。"]]},{"verse":26,"text":"これらはヨザダクの子,こエシュアの子,こヨアキムの時代,じだい、また総督,そうとくネヘミヤおよび学者,がくしゃである祭司,さいしエズラの時代,じだいにいた人々,ひとびとである。","tok":[["これ"],["ら"],["は"],["ヨザダク"],["の"],["子","こ"],["エシュア"],["の"],["子","こ"],["ヨアキム"],["の"],["時代","じだい"],["、"],["また"],["総督","そうとく"],["ネヘミヤ"],["および"],["学者","がくしゃ"],["で"],["ある"],["祭司","さいし"],["エズラ"],["の"],["時代","じだい"],["に"],["いた"],["人々","ひとびと"],["で"],["ある"],["。"]]},{"verse":27,"text":"さてエルサレムの城壁,じょうへきの落成,らくせい式,しきに当,あたって、レビびとを、そのすべての所,ところから招,まねいてエルサレムにこさせ、感謝,かんしゃと、歌,うたと、シンバルと、立琴,たてごとと、琴,こととをもって喜,よろこんで落成,らくせい式,しきを行,おこなおうとした。","tok":[["さて"],["エルサレム"],["の"],["城壁","じょうへき"],["の"],["落成","らくせい"],["式","しき"],["に"],["当たって","あたって"],["、"],["レビ"],["びと"],["を"],["、"],["その"],["すべて"],["の"],["所","ところ"],["から"],["招いて","まねいて"],["エルサレム"],["に"],["こさせ"],["、"],["感謝","かんしゃ"],["と"],["、"],["歌","うた"],["と"],["、"],["シンバル"],["と"],["、"],["立琴","たてごと"],["と"],["、"],["琴","こと"],["と"],["を"],["もって"],["喜こんで","よろこんで"],["落成","らくせい"],["式","しき"],["を"],["行なおう","おこなおう"],["と"],["した"],["。"]]},{"verse":28,"text":"そこで、歌,うたうたう人々,ひとびとはエルサレムの周囲,しゅういの地方,ちほう、ネトパびとの村々,むらむらから集,あつまってきた。","tok":[["そこ"],["で"],["、"],["歌","うた"],["うたう"],["人々","ひとびと"],["は"],["エルサレム"],["の"],["周囲","しゅうい"],["の"],["地方","ちほう"],["、"],["ネトパ"],["びと"],["の"],["村々","むらむら"],["から"],["集まって","あつまって"],["きた"],["。"]]},{"verse":29,"text":"またベテギルガルおよびゲバとアズマウテの地方,ちほうからも集,あつまってきた。この歌,うたうたう者,ものたちはエルサレムの周囲,しゅういに自分,じぶんの村々,むらむらを建,たてていたからである。","tok":[["また"],["ベテギルガル"],["および"],["ゲバ"],["と"],["アズマウテ"],["の"],["地方","ちほう"],["から"],["も"],["集まって","あつまって"],["きた"],["。"],["この"],["歌","うた"],["うたう"],["者","もの"],["たち"],["は"],["エルサレム"],["の"],["周囲","しゅうい"],["に"],["自分","じぶん"],["の"],["村々","むらむら"],["を"],["建てて","たてて"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":30,"text":"そして祭司,さいしとレビびとたちは身,みを清,きよめ、また民,たみおよびもろもろの門,もんと城壁,じょうへきとを清,きよめた。","tok":[["そして"],["祭司","さいし"],["と"],["レビ"],["びと"],["たち"],["は"],["身","み"],["を"],["清め","きよめ"],["、"],["また"],["民","た"],["み"],["および"],["もろもろ"],["の"],["門","もん"],["と"],["城壁","じょうへき"],["と"],["を"],["清めた","きよめた"],["。"]]},{"verse":31,"text":"そこでわたしはユダのつかさたちを城壁,じょうへきの上,うえにのぼらせ、また感謝,かんしゃする者,ものの二つの大,おおきな組,くみを作,つくって、行進,こうしんさせた。その一つは城壁,じょうへきの上,うえを右,みぎに糞,ふんの門,もんをさして進,すすんだ。","tok":[["そこ"],["で"],["わたし"],["は"],["ユダ"],["の"],["つかさ"],["たち"],["を"],["城壁","じょうへき"],["の"],["上","うえ"],["に"],["のぼらせ"],["、"],["また"],["感謝","かんしゃ"],["する"],["者","もの"],["の"],["二","ふた"],["つ"],["の"],["大きな","おおきな"],["組","くみ"],["を"],["作って","つくって"],["、"],["行進","こうしん"],["させた"],["。"],["その"],["一","ひと"],["つ"],["は"],["城壁","じょうへき"],["の"],["上","うえ"],["を"],["右","みぎ"],["に"],["糞","ふん"],["の"],["門","もん"],["を"],["さして"],["進んだ","すすんだ"],["。"]]},{"verse":32,"text":"そのあとに従,したがって進,すすんだ者,ものはホシャヤ、およびユダのつかさたちの半,なかば、","tok":[["その"],["あと"],["に"],["従って","したがって"],["進んだ","すすんだ"],["者","もの"],["は"],["ホシャヤ"],["、"],["および"],["ユダ"],["の"],["つかさ"],["たち"],["の"],["半ば","なかば"],["、"]]},{"verse":33,"text":"ならびにアザリヤ、エズラ、メシュラム、","tok":[["ならびに"],["アザリヤ"],["、"],["エズラ"],["、"],["メシュラム"],["、"]]},{"verse":34,"text":"ユダ、ベニヤミン、シマヤ、エレミヤであった。","tok":[["ユダ"],["、"],["ベニヤミン"],["、"],["シマヤ"],["、"],["エレミヤ"],["で"],["あった"],["。"]]},{"verse":35,"text":"また数人,すうにんの祭司,さいしがラッパをもって従,したがった。すなわちヨナタンの子,こゼカリヤ。ヨナタンはシマヤの子,こ、シマヤはマッタニヤの子,こ、マッタニヤはミカヤの子,こ、ミカヤはザックルの子,こ、ザックルはアサフの子,こである。","tok":[["また"],["数人","すうにん"],["の"],["祭司","さいし"],["が"],["ラッパ"],["を"],["もって"],["従った","したがった"],["。"],["すなわち"],["ヨナタン"],["の"],["子","こ"],["ゼカリヤ"],["。"],["ヨナタン"],["は"],["シマヤ"],["の"],["子","こ"],["、"],["シマヤ"],["は"],["マッタニヤ"],["の"],["子","こ"],["、"],["マッタニヤ"],["は"],["ミカヤ"],["の"],["子","こ"],["、"],["ミカヤ"],["は"],["ザックル"],["の"],["子","こ"],["、"],["ザックル"],["は"],["アサフ"],["の"],["子","こ"],["で"],["ある"],["。"]]},{"verse":36,"text":"またゼカリヤの兄弟,きょうだいたちシマヤ、アザリエル、ミラライ、ギラライ、マアイ、ネタンエル、ユダ、ハナニなどであって、神,かみの人,ひとダビデの楽器,がっきを持,もって従,したがった。そして学者,がくしゃエズラは彼,かれらの先,さきに進,すすんだ。","tok":[["また"],["ゼカリヤ"],["の"],["兄弟","きょうだい"],["たち"],["シマヤ"],["、"],["アザリエル"],["、"],["ミラライ"],["、"],["ギラライ"],["、"],["マアイ"],["、"],["ネタンエル"],["、"],["ユダ"],["、"],["ハナニ"],["など"],["で"],["あって"],["、"],["神","かみ"],["の"],["人","ひと"],["ダビデ"],["の"],["楽器","がっき"],["を"],["持って","もって"],["従った","したがった"],["。"],["そして"],["学者","がくしゃ"],["エズラ"],["は"],["彼","かれ"],["ら"],["の"],["先","さき"],["に"],["進んだ","すすんだ"],["。"]]},{"verse":37,"text":"彼,かれらは泉,いずみの門,もんを経,へて、まっすぐに進,すすみ、城壁,じょうへきの上,のぼり口,くちで、ダビデの町,まちの階段,かいだんから上,のぼり、ダビデの家,いえの上,うえを過,すぎて東,ひがしの方,ほう、水,みずの門,もんに至,いたった。","tok":[["彼","かれ"],["ら"],["は"],["泉","いずみ"],["の"],["門","もん"],["を"],["経て","へて"],["、"],["まっすぐ"],["に"],["進み","すすみ"],["、"],["城壁","じょうへき"],["の"],["上り口","のぼりくち"],["で"],["、"],["ダビデ"],["の"],["町","まち"],["の"],["階段","かいだん"],["から"],["上り","のぼり"],["、"],["ダビデ"],["の"],["家","いえ"],["の"],["上","うえ"],["を"],["過て","すぎて"],["東","ひがし"],["の"],["方","ほう"],["、"],["水","みず"],["の"],["門","もん"],["に"],["至った","いたった"],["。"]]},{"verse":38,"text":"他,たの一組,くみの感謝,かんしゃする者,ものは左,ひだりに進,すすんだ。わたしは民,たみの半,なかばと共,ともに彼,かれらのあとに従,したがった。そして城壁,じょうへきの上,うえを行,いき、炉,ろの望楼,ぼうろうの上,うえを過,すぎて、城壁,じょうへきの広,ひろい所,ところに至,いたり、","tok":[["他","た"],["の"],["一","いち"],["組","くみ"],["の"],["感謝","かんしゃ"],["する"],["者","もの"],["は"],["左","ひだり"],["に"],["進んだ","すすんだ"],["。"],["わたし"],["は"],["民","たみ"],["の"],["半ば","なかば"],["と"],["共","とも"],["に"],["彼","かれ"],["ら"],["の"],["あと"],["に"],["従った","したがった"],["。"],["そして"],["城壁","じょうへき"],["の"],["上","うえ"],["を"],["行き","いき"],["、"],["炉","ろ"],["の"],["望楼","ぼうろう"],["の"],["上","うえ"],["を"],["過て","すぎて"],["、"],["城壁","じょうへき"],["の"],["広い","ひろい"],["所","ところ"],["に"],["至","いたり"],["、"]]},{"verse":39,"text":"エフライムの門,もんの上,うえを通,とおり、古,ふるい門,もんを過,すぎ、魚,うおの門,もんおよびハナネルの望楼,ぼうろうとハンメアの望楼,ぼうろうを過,すぎて、羊,ひつじの門,もんに至,いたり、近衛,このえの門,もんに立,たち止,どまった。","tok":[["エフライム"],["の"],["門","もん"],["の"],["上","うえ"],["を"],["通り","とおり"],["、"],["古い","ふるい"],["門","もん"],["を"],["過","すぎ"],["、"],["魚","うお"],["の"],["門","もん"],["および"],["ハナネル"],["の"],["望楼","ぼうろう"],["と"],["ハンメア"],["の"],["望楼","ぼうろう"],["を"],["過て","すぎて"],["、"],["羊","ひつじ"],["の"],["門","もん"],["に"],["至","いたり"],["、"],["近衛","このえ"],["の"],["門","もん"],["に"],["立ち止まった","たちどまった"],["。"]]},{"verse":40,"text":"こうして二組,くみの感謝,かんしゃする者,ものは神,かみの宮,みやにはいって立,たった。わたしもそこに立,たち、つかさたちの半,なかばもわたしと共,ともに立,たった。","tok":[["こう"],["して"],["二","に"],["組","くみ"],["の"],["感謝","かんしゃ"],["する"],["者","もの"],["は"],["神","かみ"],["の"],["宮","みや"],["に"],["はいって"],["立った","たった"],["。"],["わたし"],["も"],["そこ"],["に"],["立ち","たち"],["、"],["つかさ"],["たち"],["の"],["半ば","なかば"],["も"],["わたし"],["と"],["共","とも"],["に"],["立った","たった"],["。"]]},{"verse":41,"text":"また祭司,さいしエリアキム、マアセヤ、ミニヤミン、ミカヤ、エリオエナイ、ゼカリヤ、ハナニヤらはラッパを持,もち、","tok":[["また"],["祭司","さいし"],["エリアキム"],["、"],["マアセヤ"],["、"],["ミニヤミン"],["、"],["ミカヤ"],["、"],["エリオエナイ"],["、"],["ゼカリヤ"],["、"],["ハナニヤ"],["ら"],["は"],["ラッパ"],["を"],["持","もち"],["、"]]},{"verse":42,"text":"マアセヤ、シマヤ、エレアザル、ウジ、ヨハナン、マルキヤ、エラムおよびエゼルも共,ともにいた。そして歌,うたうたう者,ものたちは声,こえ高,たかく歌,うたった。エズラヒヤはその監督,かんとくであった。","tok":[["マアセヤ"],["、"],["シマヤ"],["、"],["エレアザル"],["、"],["ウジ"],["、"],["ヨハナン"],["、"],["マルキヤ"],["、"],["エラム"],["および"],["エゼル"],["も"],["共","とも"],["に"],["いた"],["。"],["そして"],["歌","うた"],["うたう"],["者","もの"],["たち"],["は"],["声","こえ"],["高かく","たかく"],["歌った","うたった"],["。"],["エズラヒヤ"],["は"],["その"],["監督","かんとく"],["で"],["あった"],["。"]]},{"verse":43,"text":"こうして彼,かれらはその日,ひ、大,おおいなる犠牲,ぎせいをささげて喜,よろこんだ。神,かみが彼,かれらを大,おおいに喜,よろこび楽,たのしませられたからである。女子供,おんなこどもまでも喜,よろこんだ。それでエルサレムの喜,よろこびの声,こえは遠,とおくまで聞,きこえた。","tok":[["こう"],["して"],["彼","かれ"],["ら"],["は"],["その"],["日","ひ"],["、"],["大いなる","おおいなる"],["犠牲","ぎせい"],["を"],["ささげて"],["喜こんだ","よろこんだ"],["。"],["神","かみ"],["が"],["彼","かれ"],["ら"],["を"],["大いに","おおいに"],["喜こび","よろこび"],["楽しませられた","たのしませられた"],["から"],["で"],["ある"],["。"],["女子供","おんなこども"],["まで"],["も"],["喜こんだ","よろこんだ"],["。"],["それ"],["で"],["エルサレム"],["の"],["喜こび","よろこび"],["の"],["声","こえ"],["は"],["遠く","とおく"],["まで"],["聞こえた","きこえた"],["。"]]},{"verse":44,"text":"その日,ひ、倉,くらのもろもろのへやをつかさどる人々,ひとびとを選,えらび、ささげ物,もの、初物,はつもの、十分,ぶんの一など律法,りっぽうの定,さだめるところの祭司,さいしおよびレビびとの分,ぶんを町々,まちまちの田畑,たはたにしたがって取,とり集,あつめて、へやに入,いれることをつかさどらせた。これは祭司,さいしおよびレビびとの仕,つかえるのを、ユダびとが喜,よろこんだからである。","tok":[["その"],["日","ひ"],["、"],["倉","くら"],["の"],["もろもろ"],["の"],["へや"],["を"],["つかさどる"],["人々","ひとびと"],["を"],["選ら","えら"],["び"],["、"],["ささげ物","ささげもの"],["、"],["初物","はつもの"],["、"],["十分","ぶん"],["の"],["一","いち"],["など"],["律法","りっぽう"],["の"],["定める","さだめる"],["ところ"],["の"],["祭司","さいし"],["および"],["レビ"],["びと"],["の"],["分","ぶん"],["を"],["町々","まちまち"],["の"],["田畑","たはた"],["に"],["したがって"],["取集めて","とりあつめて"],["、"],["へや"],["に"],["入れる","いれる"],["こと"],["を"],["つかさどらせた"],["。"],["これ"],["は"],["祭司","さいし"],["および"],["レビ"],["びと"],["の"],["仕える","つかえる"],["の"],["を"],["、"],["ユダ"],["びと"],["が"],["喜こんだ","よろこんだ"],["から"],["で"],["ある"],["。"]]},{"verse":45,"text":"彼,かれらはダビデおよびその子,こソロモンの命令,めいれいに従,したがって、神,かみの勤,つとめおよび清,きよめ事,ごとの勤,つとめをした。歌,うたうたう者,ものおよび門,もんを守,まもる者,ものもそのように行,いった。","tok":[["彼","かれ"],["ら"],["は"],["ダビデ"],["および"],["その"],["子","こ"],["ソロモン"],["の"],["命令","めいれい"],["に"],["従って","したがって"],["、"],["神","かみ"],["の"],["勤め","つとめ"],["および"],["清め","きよめ"],["事","ごと"],["の"],["勤め","つとめ"],["を"],["した"],["。"],["歌","うた"],["うたう"],["者","もの"],["および"],["門","もん"],["を"],["守者","まもるもの"],["も"],["その"],["よう"],["に"],["行った","いった"],["。"]]},{"verse":46,"text":"昔,むかしダビデおよびアサフの日,ひには、歌,うたうたう者,もののかしらがひとりいて、神,かみにさんびと感謝,かんしゃをささげる事,ことがあった。","tok":[["昔","むかし"],["ダビデ"],["および"],["アサフ"],["の"],["日","ひ"],["に"],["は"],["、"],["歌","うた"],["うたう"],["者","もの"],["の"],["かしら"],["が"],["ひとり"],["いて"],["、"],["神","かみ"],["に"],["さん"],["びと"],["感謝","かんしゃ"],["を"],["ささげる"],["事","こと"],["が"],["あった"],["。"]]},{"verse":47,"text":"またゼルバベルの日,ひおよびネヘミヤの日,ひには、イスラエルびとはみな歌,うたうたう者,ものと門,もんを守,まもる者,ものに日々,ひびの分,ぶんを与,あたえ、またレビびとに物,ものを聖別,せいべつして与,あたえ、レビびとはまたこれを聖別,せいべつしてアロンの子孫,しそんに与,あたえた。","tok":[["また"],["ゼルバベル"],["の"],["日","ひ"],["および"],["ネヘミヤ"],["の"],["日","ひ"],["に"],["は"],["、"],["イスラエル"],["び"],["と"],["は"],["みな"],["歌","うた"],["うたう"],["者","もの"],["と"],["門","もん"],["を"],["守者","まもるもの"],["に"],["日々","ひび"],["の"],["分","ぶん"],["を"],["与","あたえ"],["、"],["また"],["レビ"],["びと"],["に"],["物","もの"],["を"],["聖別","せいべつ"],["して"],["与","あたえ"],["、"],["レビ"],["び"],["と"],["は"],["また"],["これ"],["を"],["聖別","せいべつ"],["して"],["アロン"],["の"],["子孫","しそん"],["に"],["与","あたえ"],["た"],["。"]]}]
[{"verse":1,"text":"正,ただしく歩,あゆむ貧,まずしい者,ものは、曲,まがったことを言,いう愚,おろかな者,ものにまさる。","tok":[["正く","ただしく"],["歩む","あゆむ"],["貧しい","まずしい"],["者","もの"],["は"],["、"],["曲がった","まがった"],["こと"],["を"],["言う","いう"],["愚か","おろか"],["な"],["者","もの"],["に"],["まさる"],["。"]]},{"verse":2,"text":"人,ひとが知識,ちしきのないのは良,よくない、足,あしで急,いそぐ者,ものは道,みちに迷,まよう。","tok":[["人","ひと"],["が"],["知識","ちしき"],["の"],["ない"],["の"],["は"],["良く","よく"],["ない"],["、"],["足","あし"],["で"],["急ぐ","いそぐ"],["者","もの"],["は"],["道","みち"],["に"],["迷う","まよう"],["。"]]},{"verse":3,"text":"人,ひとは自分,じぶんの愚,おろかさによって道,みちにつまずき、かえって心,こころのうちに主,しゅをうらむ。","tok":[["人","ひと"],["は"],["自分","じぶん"],["の"],["愚か","おろか"],["さ"],["によって"],["道","みち"],["に"],["つまずき"],["、"],["かえって"],["心","こころ"],["の"],["うち"],["に"],["主","しゅ"],["を"],["うらむ"],["。"]]},{"verse":4,"text":"富,とみは多,おおくの新,あたらしい友,ともを作,つくる、しかし貧,まずしい人,ひとはその友,ともに捨,すてられる。","tok":[["富","とみ"],["は"],["多く","おおく"],["の"],["新らしい","あたらしい"],["友","とも"],["を"],["作る","つくる"],["、"],["しかし"],["貧しい","まずしい"],["人","ひと"],["は"],["その"],["友","とも"],["に"],["捨てられる","すてられる"],["。"]]},{"verse":5,"text":"偽,いつわりの証人,しょうにんは罰,ばつを免,まぬかれない、偽,いつわりをいう者,ものはのがれることができない。","tok":[["偽わり","いつわり"],["の"],["証人","しょうにん"],["は"],["罰","ばつ"],["を"],["免かれない","まぬかれない"],["、"],["偽り","いつわり"],["を"],["いう"],["者","もの"],["は"],["のがれる"],["こと"],["が"],["できない"],["。"]]},{"verse":6,"text":"気前,きまえのよい人,ひとにこびる者,ものは多,おおい、人,ひとはみな贈,おくり物,ものをする人,ひとの友,ともとなる。","tok":[["気前","きまえ"],["の"],["よい"],["人","ひと"],["に"],["こびる"],["者","もの"],["は"],["多い","おおい"],["、"],["人","ひと"],["は"],["みな"],["贈り物","おくりもの"],["を"],["する"],["人","ひと"],["の"],["友","とも"],["と"],["なる"],["。"]]},{"verse":7,"text":"貧,まずしい者,ものはその兄弟,きょうだいすらもみなこれを憎,にくむ、ましてその友,ともはこれに遠,とおざからないであろうか。言葉,ことばをかけてこれを呼,よんでも、去,さって帰,かえらないのである。","tok":[["貧しい","まずしい"],["者","もの"],["は"],["その"],["兄弟","きょうだい"],["すら"],["も"],["みな"],["これ"],["を"],["憎む","にくむ"],["、"],["まして"],["その"],["友","とも"],["は"],["これ"],["に"],["遠ざからないで","とおざからないで"],["あろう"],["か"],["。"],["言葉","ことば"],["を"],["かけて"],["これ"],["を"],["呼","よん"],["で"],["も"],["、"],["去て","さって"],["帰えらない","かえらない"],["ので"],["ある"],["。"]]},{"verse":8,"text":"知恵,ちえを得,える者,ものは自分,じぶんの魂,たましいを愛,あいし、悟,さとりを保,たもつ者,ものは幸,さいわいを得,える。","tok":[["知恵","ちえ"],["を"],["得る","える"],["者","もの"],["は"],["自分","じぶん"],["の"],["魂","たましい"],["を"],["愛し","あいし"],["、"],["悟り","さとり"],["を"],["保つ","たもつ"],["者","もの"],["は"],["幸い","さいわい"],["を"],["得る","える"],["。"]]},{"verse":9,"text":"偽,いつわりの証人,しょうにんは罰,ばつを免,まぬかれない、偽,いつわりをいう者,ものは滅,ほろびる。","tok":[["偽わり","いつわり"],["の"],["証人","しょうにん"],["は"],["罰","ばつ"],["を"],["免かれない","まぬかれない"],["、"],["偽り","いつわり"],["を"],["いう"],["者","もの"],["は"],["滅びる","ほろびる"],["。"]]},{"verse":10,"text":"愚,おろかな者,ものが、ぜいたくな暮,くらしをするのは、ふさわしいことではない、しもべたる者,ものが、君,きみたる者,ものを治,おさめるなどは、なおさらである。","tok":[["愚か","おろか"],["な"],["者","もの"],["が"],["、"],["ぜいたく"],["な"],["暮らし","くらし"],["を"],["する"],["の"],["は"],["、"],["ふさわしい"],["こと"],["で"],["は"],["ない"],["、"],["しもべ"],["たる"],["者","もの"],["が"],["、"],["君","きみ"],["たる"],["者","もの"],["を"],["治める","おさめる"],["など"],["は"],["、"],["なおさら"],["で"],["ある"],["。"]]},{"verse":11,"text":"悟,さとりは人,ひとに怒,いかりを忍,しのばせる、あやまちをゆるすのは人,ひとの誉,ほまれである。","tok":[["悟り","さとり"],["は"],["人","ひと"],["に"],["怒り","いかり"],["を"],["忍ばせる","しのばせる"],["、"],["あやまち"],["を"],["ゆるす"],["の"],["は"],["人","ひと"],["の"],["誉","ほまれ"],["で"],["ある"],["。"]]},{"verse":12,"text":"王,おうの怒,いかりは、ししのほえるようであり、その恵,めぐみは草,くさの上,うえにおく露,つゆのようである。","tok":[["王","おう"],["の"],["怒り","いかり"],["は"],["、"],["しし"],["の"],["ほえる"],["よう"],["で"],["あり"],["、"],["その"],["恵","めぐみ"],["は"],["草","くさ"],["の"],["上","うえ"],["に"],["おく"],["露","つゆ"],["の"],["よう"],["で"],["ある"],["。"]]},{"verse":13,"text":"愚,おろかな子,こはその父,ちちの災,わざわいである、妻,つまの争,あらそうのは、雨漏,あまもりの絶,たえないのとひとしい。","tok":[["愚か","おろか"],["な"],["子","こ"],["は"],["その"],["父","ちち"],["の"],["災","わざわい"],["で"],["ある"],["、"],["妻","つま"],["の"],["争う","あらそう"],["の"],["は"],["、"],["雨漏り","あまもり"],["の"],["絶えない","たえない"],["の"],["と"],["ひとしい"],["。"]]},{"verse":14,"text":"家,いえと富,とみとは先祖,せんぞからうけつぐもの、賢,かしこい妻,つまは主,しゅから賜,たまわるものである。","tok":[["家","いえ"],["と"],["富","とみ"],["と"],["は"],["先祖","せんぞ"],["から"],["うけつぐ"],["もの"],["、"],["賢しこい","かしこい"],["妻","つま"],["は"],["主ら","しゅから"],["賜わる","たまわる"],["もの"],["で"],["ある"],["。"]]},{"verse":15,"text":"怠,おこたりは人,ひとを熟睡,じゅくすいさせる、なまけ者,ものは飢,うえる。","tok":[["怠たり","おこたり"],["は"],["人","ひと"],["を"],["熟睡","じゅくすい"],["させる"],["、"],["なまけ者","なまけもの"],["は"],["飢","うえ"],["る"],["。"]]},{"verse":16,"text":"戒,いましめを守,まもる者,ものは自分,じぶんの魂,たましいを守,まもる、み言葉,ことばを軽,かろんじる者,ものは死,しぬ。","tok":[["戒しめ","いましめ"],["を"],["守者","まもるもの"],["は"],["自分","じぶん"],["の"],["魂","たましい"],["を"],["守","まもる"],["、"],["み言葉","みことば"],["を"],["軽んじる","かろんじる"],["者","もの"],["は"],["死ぬ","しぬ"],["。"]]},{"verse":17,"text":"貧,まずしい者,ものをあわれむ者,ものは主,しゅに貸,かすのだ、その施,ほどこしは主,しゅが償,つぐなわれる。","tok":[["貧しい","まずしい"],["者","もの"],["を"],["あわれむ"],["者","もの"],["は"],["主に","しゅに"],["貸す","かす"],["の"],["だ"],["、"],["その"],["施し","ほどこし"],["は"],["主","しゅ"],["が"],["償なわれる","つぐなわれる"],["。"]]},{"verse":18,"text":"望,のぞみのあるうちに、自分,じぶんの子,こを懲,こらせ、これを滅,ほろぼす心,こころを起,おこしてはならない。","tok":[["望み","のぞみ"],["の"],["ある"],["うち"],["に"],["、"],["自分","じぶん"],["の"],["子","こ"],["を"],["懲らせ","こらせ"],["、"],["これ"],["を"],["滅ぼす","ほろぼす"],["心","こころ"],["を"],["起こして","おこして"],["は"],["ならない"],["。"]]},{"verse":19,"text":"怒,いかることの激,はげしい者,ものは罰,ばつをうける、たとい彼,かれを救,すくってやっても、さらにくり返,かえさねばならない。","tok":[["怒","いかるこ"],["と"],["の"],["激しい","はげしい"],["者","もの"],["は"],["罰","ばつ"],["を"],["うける"],["、"],["たとい"],["彼","かれ"],["を"],["救って","すくって"],["やって"],["も"],["、"],["さらに"],["くり"],["返えさねば","かえさねば"],["ならない"],["。"]]},{"verse":20,"text":"勧,すすめを聞,きき、教訓,きょうくんをうけよ、そうすれば、ついには知恵,ちえある者,ものとなる。","tok":[["勧め","すすめ"],["を"],["聞","きき"],["、"],["教訓","きょうくん"],["を"],["うけよ"],["、"],["そう"],["すれば"],["、"],["ついに"],["は"],["知恵","ちえ"],["ある"],["者","もの"],["と"],["なる"],["。"]]},{"verse":21,"text":"人,ひとの心,こころには多,おおくの計画,けいかくがある、しかしただ主,しゅの、み旨,むねだけが堅,かたく立,たつ。","tok":[["人","ひと"],["の"],["心","こころ"],["に"],["は"],["多く","おおく"],["の"],["計画","けいかく"],["が"],["ある"],["、"],["しかし"],["ただ"],["主","しゅ"],["の"],["、"],["み旨","みむね"],["だけ"],["が"],["堅く","かたく"],["立つ","たつ"],["。"]]},{"verse":22,"text":"人,ひとに望,のぞましいのは、いつくしみ深,ふかいことである、貧,まずしい人,ひとは偽,いつわりをいう人,ひとにまさる。","tok":[["人","ひと"],["に"],["望ましい","のぞましい"],["の"],["は"],["、"],["いつくしみ"],["深い","ふかい"],["こと"],["で"],["ある"],["、"],["貧しい","まずしい"],["人","ひと"],["は"],["偽り","いつわり"],["を"],["いう"],["人","ひと"],["に"],["まさる"],["。"]]},{"verse":23,"text":"主,しゅを恐,おそれることは人,ひとを命,いのちに至,いたらせ、常,つねに飽,あき足,たりて、災,わざわいにあうことはない。","tok":[["主","しゅ"],["を"],["恐れる","おそれる"],["こと"],["は"],["人","ひと"],["を"],["命","いのち"],["に"],["至らせ","いたらせ"],["、"],["常","つね"],["に"],["飽き足りて","あきたりて"],["、"],["災","わざわい"],["に"],["あう"],["こと"],["は"],["ない"],["。"]]},{"verse":24,"text":"なまけ者,ものは、手,てを皿,さらに入,いれても、それを口,くちに持,もってゆくことをしない。","tok":[["なまけ者","なまけもの"],["は"],["、"],["手","て"],["を"],["皿","さら"],["に"],["入れて","いれて"],["も"],["、"],["それ"],["を"],["口","くち"],["に"],["持って","もって"],["ゆく"],["こと"],["を"],["しない"],["。"]]},{"verse":25,"text":"あざける者,ものを打,うて、そうすれば思慮,しりょのない者,ものも慎,つつしむ。さとき者,ものを戒,いましめよ、そうすれば彼,かれは知識,ちしきを得,える。","tok":[["あざける"],["者","もの"],["を"],["打て","うて"],["、"],["そう"],["すれば"],["思慮","しりょ"],["の"],["ない"],["者","もの"],["も"],["慎しむ","つつしむ"],["。"],["さ"],["とき"],["者","もの"],["を"],["戒しめ","いましめ"],["よ"],["、"],["そう"],["すれば"],["彼","かれ"],["は"],["知識","ちしき"],["を"],["得る","える"],["。"]]},{"verse":26,"text":"父,ちちに乱暴,らんぼうをはたらき、母,ははを追,おい出,だす者,ものは、恥,はじをきたらし、はずかしめをまねく子,こである。","tok":[["父","ちち"],["に"],["乱暴","らんぼう"],["を"],["はたらき"],["、"],["母","はは"],["を"],["追い出す","おいだす"],["者","もの"],["は"],["、"],["恥","はじ"],["を"],["きたら"],["し"],["、"],["はずかしめ"],["を"],["まねく"],["子","こ"],["で"],["ある"],["。"]]},{"verse":27,"text":"わが子,こよ、知識,ちしきの言葉,ことばをはなれて人,ひとを迷,まよわせる教訓,きょうくんを聞,きくことをやめよ。","tok":[["わが"],["子","こ"],["よ"],["、"],["知識","ちしき"],["の"],["言葉","ことば"],["を"],["はなれて"],["人","ひと"],["を"],["迷わせる","まよわせる"],["教訓","きょうくん"],["を"],["聞く","きく"],["こと"],["を"],["やめよ"],["。"]]},{"verse":28,"text":"悪,わるい証人,しょうにんはさばきをあざけり、悪,あしき者,ものの口,くちは悪,あくをむさぼり食,くう。","tok":[["悪い","わるい"],["証人","しょうにん"],["は"],["さばき"],["を"],["あざけり"],["、"],["悪しき","あしき"],["者","もの"],["の"],["口","くち"],["は"],["悪","あく"],["を"],["むさぼり食う","むさぼりくう"],["。"]]},{"verse":29,"text":"さばきはあざける者,もののために備,そなえられ、むちは愚,おろかな者,ものの背,せのために備,そなえられる。","tok":[["さばき"],["は"],["あざける"],["者","もの"],["の"],["ため"],["に"],["備","そなえ"],["られ"],["、"],["むち"],["は"],["愚か","おろか"],["な"],["者","もの"],["の"],["背","せ"],["の"],["ため"],["に"],["備","そなえ"],["られる"],["。"]]}]
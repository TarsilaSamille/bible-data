[{"verse":1,"text":"平穏,へいおんであって、ひとかたまりのかわいたパンのあるのは、争,あらそいがあって、食物,しょくもつの豊,ゆたかな家,いえにまさる。","tok":[["平穏","へいおん"],["で"],["あって"],["、"],["ひとかたまり"],["の"],["かわいた"],["パン"],["の"],["ある"],["の"],["は"],["、"],["争い","あらそい"],["が"],["あって"],["、"],["食物","しょくもつ"],["の"],["豊","ゆたか"],["な"],["家","いえ"],["に"],["まさる"],["。"]]},{"verse":2,"text":"賢,かしこいしもべは身持,みもちの悪,わるいむすこを治,おさめ、かつ、その兄弟,きょうだいたちの中,なかにあって、資産,しさんの分,わけ前,まえを獲,える。","tok":[["賢しこい","かしこい"],["しもべ"],["は"],["身持","みもち"],["の"],["悪い","わるい"],["むすこ"],["を"],["治め","おさめ"],["、"],["かつ"],["、"],["その"],["兄弟","きょうだい"],["たち"],["の"],["中","なか"],["に"],["あって"],["、"],["資産","しさん"],["の"],["分け前","わけまえ"],["を"],["獲る","える"],["。"]]},{"verse":3,"text":"銀,ぎんを試,こころみるものはるつぼ、金,きんを試,こころみるものは炉,ろ、人,ひとの心,こころを試,こころみるものは主,しゅである。","tok":[["銀","ぎん"],["を"],["試みる","こころみる"],["もの"],["は"],["るつぼ"],["、"],["金","きん"],["を"],["試みる","こころみる"],["もの"],["は"],["炉","ろ"],["、"],["人","ひと"],["の"],["心","こころ"],["を"],["試みる","こころみる"],["もの"],["は"],["主","しゅ"],["で"],["ある"],["。"]]},{"verse":4,"text":"悪,あくを行,おこなう者,ものは偽,いつわりのくちびるに聞,きき、偽,いつわりをいう者,ものは悪,あしき舌,したに耳,みみを傾,かたむける。","tok":[["悪","あく"],["を"],["行なう","おこなう"],["者","もの"],["は"],["偽わり","いつわり"],["の"],["くちびる"],["に"],["聞","きき"],["、"],["偽り","いつわり"],["を"],["いう"],["者","もの"],["は"],["悪しき","あしき"],["舌","した"],["に"],["耳","みみ"],["を"],["傾むける","かたむける"],["。"]]},{"verse":5,"text":"貧,まずしい者,ものをあざける者,ものはその造,つくり主,ぬしを侮,あなどる、人,ひとの災,わざわいを喜,よろこぶ者,ものは罰,ばつを免,まぬかれない。","tok":[["貧しい","まずしい"],["者","もの"],["を"],["あざける"],["者","もの"],["は"],["その"],["造主","つくりぬし"],["を"],["侮る","あなどる"],["、"],["人","ひと"],["の"],["災","わざわい"],["を"],["喜こぶ","よろこぶ"],["者","もの"],["は"],["罰","ばつ"],["を"],["免かれない","まぬかれない"],["。"]]},{"verse":6,"text":"孫,まごは老人,ろうじんの冠,かんむりである、父,ちちは子,この栄,さかえである。","tok":[["孫","まご"],["は"],["老人","ろうじん"],["の"],["冠","かんむり"],["で"],["ある"],["、"],["父","ちち"],["は"],["子","こ"],["の"],["栄","さかえ"],["で"],["ある"],["。"]]},{"verse":7,"text":"すぐれた言葉,ことばは愚,おろかな者,ものには似合,にあわない、まして偽,いつわりを言,いうくちびるは君,きみたる者,ものには似合,にあわない。","tok":[["すぐれた"],["言葉","ことば"],["は"],["愚か","おろか"],["な"],["者","もの"],["に"],["は"],["似合わない","にあわない"],["、"],["まして"],["偽り","いつわり"],["を"],["言う","いう"],["くちびる"],["は"],["君","きみ"],["たる"],["者","もの"],["に"],["は"],["似合わない","にあわない"],["。"]]},{"verse":8,"text":"まいないはこれを贈,おくる人,ひとの目,めには幸運,こううんの玉,たまのようだ、その向,むかう所,ところ、どこでも彼,かれは栄,さかえる。","tok":[["まいない"],["は"],["これ"],["を"],["贈る","おくる"],["人","ひと"],["の"],["目","め"],["に"],["は"],["幸運","こううん"],["の"],["玉","たま"],["の"],["よう"],["だ"],["、"],["その"],["向かう","むかう"],["所","ところ"],["、"],["どこ"],["で"],["も"],["彼","かれ"],["は"],["栄","さかえ"],["る"],["。"]]},{"verse":9,"text":"愛,あいを追,おい求,もとめる人,ひとは人,ひとのあやまちをゆるす、人,ひとのことを言,いいふらす者,ものは友,ともを離,はなれさせる。","tok":[["愛","あい"],["を"],["追い求める","おいもとめる"],["人","ひと"],["は"],["人","ひと"],["の"],["あやまち"],["を"],["ゆるす"],["、"],["人","ひと"],["の"],["こと"],["を"],["言いふらす","いいふらす"],["者","もの"],["は"],["友","とも"],["を"],["離れさせる","はなれさせる"],["。"]]},{"verse":10,"text":"一度,どの戒,いましめがさとき人,ひとに徹,てっするのは、百度,どの懲,こらしめが愚,おろかな人,ひとに徹,てっするよりも深,ふかい。","tok":[["一度","ど"],["の"],["戒しめ","いましめ"],["が"],["さ"],["とき"],["人","ひと"],["に"],["徹する","てっする"],["の"],["は"],["、"],["百","ひゃく"],["度","ど"],["の"],["懲らしめ","こらしめ"],["が"],["愚か","おろか"],["な"],["人","ひと"],["に"],["徹する","てっする"],["より"],["も"],["深","ふ"],["か"],["い"],["。"]]},{"verse":11,"text":"悪,あしき者,ものはただ、そむく事,ことのみを求,もとめる、それゆえ、彼,かれに向,むかっては残忍,ざんにんな使者,ししゃがつかわされる。","tok":[["悪しき","あしき"],["者","もの"],["は"],["ただ"],["、"],["そむく"],["事","こと"],["のみ"],["を"],["求める","もとめる"],["、"],["それ"],["ゆえ"],["、"],["彼","かれ"],["に"],["向かって","むかって"],["は"],["残忍","ざんにん"],["な"],["使者","ししゃ"],["が"],["つかわされる"],["。"]]},{"verse":12,"text":"愚,おろかな者,ものが愚,おろかな事,ことをするのに会,あうよりは、子,こをとられた雌,めぐまに会,あうほうがよい。","tok":[["愚か","おろか"],["な"],["者","もの"],["が"],["愚か","おろか"],["な"],["事","こと"],["を"],["する"],["のに"],["会う","あう"],["より"],["は"],["、"],["子","こ"],["を"],["とられた"],["雌","めぐま"],["に"],["会う","あう"],["ほう"],["が"],["よい"],["。"]]},{"verse":13,"text":"悪,あくをもて善,ぜんに報,むくいる者,ものは、悪,あくがその家,いえを離,はなれることがない。","tok":[["悪","あく"],["を"],["もて"],["善","ぜん"],["に"],["報いる","むくいる"],["者","もの"],["は"],["、"],["悪","あく"],["が"],["その"],["家","いえ"],["を"],["離れる","はなれる"],["こと"],["が"],["ない"],["。"]]},{"verse":14,"text":"争,あらそいの初,はじめは水,みずがもれるのに似,にている、それゆえ、けんかの起,おこらないうちにそれをやめよ。","tok":[["争い","あらそい"],["の"],["初め","はじめ"],["は"],["水","みず"],["が"],["もれる"],["のに"],["似て","にて"],["いる"],["、"],["それ"],["ゆえ"],["、"],["けんか"],["の"],["起こらない","おこらない"],["うち"],["に"],["それ"],["を"],["やめよ"],["。"]]},{"verse":15,"text":"悪,あしき者,ものを正,ただしいとする者,もの、正,ただしい者,ものを悪,わるいとする者,もの、この二つの者,ものはともに主,しゅに憎,にくまれる。","tok":[["悪しき","あしき"],["者","もの"],["を"],["正い","ただしい"],["と"],["する"],["者","もの"],["、"],["正い","ただしい"],["者","もの"],["を"],["悪い","わるい"],["と"],["する"],["者","もの"],["、"],["この"],["二","ふた"],["つ"],["の"],["者","もの"],["は"],["とも"],["に"],["主に","しゅに"],["憎まれる","にくまれる"],["。"]]},{"verse":16,"text":"愚,おろかな者,ものはすでに心,こころがないのに、どうして知恵,ちえを買,かおうとして手,てにその代金,だいきんを持,もっているのか。","tok":[["愚か","おろか"],["な"],["者","もの"],["は"],["すでに"],["心","こころ"],["が"],["ない"],["のに"],["、"],["どう"],["して"],["知恵","ちえ"],["を"],["買おう","かおう"],["として"],["手","て"],["に"],["その"],["代金","だいきん"],["を"],["持って","もって"],["いる"],["の"],["か"],["。"]]},{"verse":17,"text":"友,ともはいずれの時,ときにも愛,あいする、兄弟,きょうだいはなやみの時,ときのために生,うまれる。","tok":[["友","とも"],["は"],["いずれ"],["の"],["時","とき"],["に"],["も"],["愛する","あいする"],["、"],["兄弟","きょうだい"],["は"],["なやみ"],["の"],["時","とき"],["の"],["ため"],["に"],["生まれる","うまれる"],["。"]]},{"verse":18,"text":"知恵,ちえのない人,ひとは手,てをうって、その隣,となり人,びとの前,まえで保証,ほしょうをする。","tok":[["知恵","ちえ"],["の"],["ない"],["人","ひと"],["は"],["手","て"],["を"],["うって"],["、"],["その"],["隣人","となりびと"],["の"],["前","まえ"],["で"],["保証","ほしょう"],["を"],["する"],["。"]]},{"verse":19,"text":"争,あらそいを好,このむ者,ものは罪,つみを好,このむ、その門,もんを高,たかくする者,ものは滅,ほろびを求,もとめる。","tok":[["争い","あらそい"],["を"],["好む","このむ"],["者","もの"],["は"],["罪","つみ"],["を"],["好む","このむ"],["、"],["その"],["門","もん"],["を"],["高かく","たかく"],["する"],["者","もの"],["は"],["滅び","ほろび"],["を"],["求める","もとめる"],["。"]]},{"verse":20,"text":"曲,まがった心,こころの者,ものはさいわいを得,えない、みだりに舌,したをもって語,かたる者,ものは災,わざわいに陥,おちいる。","tok":[["曲がった","まがった"],["心","こころ"],["の"],["者","もの"],["は"],["さいわい"],["を"],["得ない","えない"],["、"],["みだり"],["に"],["舌","した"],["を"],["もって"],["語る","かたる"],["者","もの"],["は"],["災","わざわい"],["に"],["陥ち","おち"],["いる"],["。"]]},{"verse":21,"text":"愚,おろかな子,こを生,うむ者,ものは嘆,なげきを得,える、愚,おろか者,ものの父,ちちは喜,よろこびを得,えない。","tok":[["愚か","おろか"],["な"],["子","こ"],["を"],["生む","うむ"],["者","もの"],["は"],["嘆き","なげき"],["を"],["得る","える"],["、"],["愚か者","おろかもの"],["の"],["父","ちち"],["は"],["喜こび","よろこび"],["を"],["得ない","えない"],["。"]]},{"verse":22,"text":"心,こころの楽,たのしみは良,よい薬,くすりである、たましいの憂,うれいは骨,ほねを枯,からす。","tok":[["心","こころ"],["の"],["楽み","たのしみ"],["は"],["良い","よい"],["薬","くすり"],["で"],["ある"],["、"],["たましい"],["の"],["憂","うれい"],["は"],["骨","ほね"],["を"],["枯らす","からす"],["。"]]},{"verse":23,"text":"悪,あしき者,ものは人,ひとのふところからまいないを受,うけて、さばきの道,みちをまげる。","tok":[["悪しき","あしき"],["者","もの"],["は"],["人","ひと"],["の"],["ふところ"],["から"],["まいない"],["を"],["受て","うけて"],["、"],["さばき"],["の"],["道","みち"],["を"],["まげる"],["。"]]},{"verse":24,"text":"さとき者,ものはその顔,かおを知恵,ちえにむける、しかし、愚,おろかな者,ものは目,めを地,ちの果,はてにそそぐ。","tok":[["さ"],["とき"],["者","もの"],["は"],["その"],["顔","かお"],["を"],["知恵","ちえ"],["に"],["むける"],["、"],["しかし"],["、"],["愚か","おろか"],["な"],["者","もの"],["は"],["目","め"],["を"],["地","ち"],["の"],["果て","はて"],["に"],["そそぐ"],["。"]]},{"verse":25,"text":"愚,おろかな子,こはその父,ちちの憂,うれいである、またこれを産,うんだ母,ははの痛,いたみである。","tok":[["愚か","おろか"],["な"],["子","こ"],["は"],["その"],["父","ちち"],["の"],["憂","うれい"],["で"],["ある"],["、"],["また"],["これ"],["を"],["産んだ","うんだ"],["母","はは"],["の"],["痛み","いたみ"],["で"],["ある"],["。"]]},{"verse":26,"text":"正,ただしい人,ひとを罰,ばっするのはよくない、尊,たっとい人,ひとを打,うつのは悪,わるい。","tok":[["正い","ただしい"],["人","ひと"],["を"],["罰する","ばっする"],["の"],["は"],["よく"],["ない"],["、"],["尊","た"],["っと"],["い"],["人","ひと"],["を"],["打つ","うつ"],["の"],["は"],["悪い","わるい"],["。"]]},{"verse":27,"text":"言葉,ことばを少,すくなくする者,ものは知識,ちしきのある者,もの、心,こころの冷静,れいせいな人,ひとはさとき人,ひとである。","tok":[["言葉","ことば"],["を"],["少く","すくなく"],["する"],["者","もの"],["は"],["知識","ちしき"],["の"],["ある"],["者","もの"],["、"],["心","こころ"],["の"],["冷静","れいせい"],["な"],["人","ひと"],["は"],["さ"],["とき"],["人","ひと"],["で"],["ある"],["。"]]},{"verse":28,"text":"愚,おろかな者,ものも黙,だまっているときは、知恵,ちえある者,ものと思,おもわれ、そのくちびるを閉,とじている時,ときは、さとき者,ものと思,おもわれる。","tok":[["愚か","おろか"],["な"],["者","もの"],["も"],["黙って","だまって"],["いる"],["とき"],["は"],["、"],["知恵","ちえ"],["ある"],["者","もの"],["と"],["思われ","おもわれ"],["、"],["その"],["くちびる"],["を"],["閉じて","とじて"],["いる"],["時","とき"],["は"],["、"],["さ"],["とき"],["者","もの"],["と"],["思われる","おもわれる"],["。"]]}]
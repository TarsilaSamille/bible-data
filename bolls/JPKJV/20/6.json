[{"verse":1,"text":"わが子,こよ、あなたがもし隣,となり人,びとのために保証人,ほしょうにんとなり、他人,たにんのために手,てをうって誓,ちかったならば、","tok":[["わが"],["子","こ"],["よ"],["、"],["あなた"],["が"],["もし"],["隣人","となりびと"],["の"],["ため"],["に"],["保証人","ほしょうにん"],["と"],["なり"],["、"],["他人","たにん"],["の"],["ため"],["に"],["手","て"],["を"],["うって"],["誓ったならば","ちかったならば"],["、"]]},{"verse":2,"text":"もしあなたのくちびるの言葉,ことばによって、わなにかかり、あなたの口,くちの言葉,ことばによって捕,とらえられたならば、","tok":[["もし"],["あなた"],["の"],["くちびる"],["の"],["言葉","ことば"],["によって"],["、"],["わな"],["に"],["かかり"],["、"],["あなた"],["の"],["口","くち"],["の"],["言葉","ことば"],["によって"],["捕らえられたならば","とらえられたならば"],["、"]]},{"verse":3,"text":"わが子,こよ、その時,ときはこうして、おのれを救,すくえ、あなたは隣,となり人,びとの手,てに陥,おちいったのだから。急,いそいで行,いって、隣,となり人,びとにひたすら求,もとめよ。","tok":[["わが"],["子","こ"],["よ"],["、"],["その"],["時","とき"],["は"],["こう"],["して"],["、"],["おのれ"],["を"],["救え","すくえ"],["、"],["あなた"],["は"],["隣人","となりびと"],["の"],["手","て"],["に"],["陥た","おちいった"],["の"],["だ"],["から"],["。"],["急いで","いそいで"],["行って","いって"],["、"],["隣人","となりびと"],["に"],["ひたすら"],["求めよ","もとめよ"],["。"]]},{"verse":4,"text":"あなたの目,めを眠,ねむらせず、あなたのまぶたを、まどろませず、","tok":[["あなた"],["の"],["目","め"],["を"],["眠らせず","ねむらせず"],["、"],["あなた"],["の"],["まぶた"],["を"],["、"],["まどろませず"],["、"]]},{"verse":5,"text":"かもしかが、かりゅうどの手,てからのがれるように、鳥,とりが鳥,とりを取,とる者,ものの手,てからのがれるように、おのれを救,すくえ。","tok":[["かもしか"],["が"],["、"],["かりゅうど"],["の"],["手","て"],["から"],["のがれる"],["よう"],["に"],["、"],["鳥","とり"],["が"],["鳥","とり"],["を"],["取る","とる"],["者","もの"],["の"],["手","て"],["から"],["のがれる"],["よう"],["に"],["、"],["おのれ"],["を"],["救え","すくえ"],["。"]]},{"verse":6,"text":"なまけ者,ものよ、ありのところへ行,いき、そのすることを見,みて、知恵,ちえを得,えよ。","tok":[["なまけ者","なまけもの"],["よ"],["、"],["あり"],["の"],["ところ"],["へ"],["行き","いき"],["、"],["その"],["する"],["こと"],["を"],["見て","みて"],["、"],["知恵","ちえ"],["を"],["得","え"],["よ"],["。"]]},{"verse":7,"text":"ありは、かしらなく、つかさなく、王,おうもないが、","tok":[["あり"],["は"],["、"],["かしら"],["なく"],["、"],["つかさ"],["なく"],["、"],["王","おう"],["も"],["ない"],["が"],["、"]]},{"verse":8,"text":"夏,なつのうちに食物,しょくもつをそなえ、刈入,かりいれの時,ときに、かてを集,あつめる。","tok":[["夏","なつ"],["の"],["うち"],["に"],["食物","しょくもつ"],["を"],["そなえ"],["、"],["刈入れ","かりいれ"],["の"],["時","とき"],["に"],["、"],["か"],["て"],["を"],["集める","あつめる"],["。"]]},{"verse":9,"text":"なまけ者,ものよ、いつまで寝,ねているのか、いつ目,めをさまして起,おきるのか。","tok":[["なまけ者","なまけもの"],["よ"],["、"],["いつ"],["まで"],["寝て","ねて"],["いる"],["の"],["か"],["、"],["いつ"],["目","め"],["を"],["さまして"],["起きる","おきる"],["の"],["か"],["。"]]},{"verse":10,"text":"しばらく眠,ねむり、しばらくまどろみ、手,てをこまぬいて、またしばらく休,やすむ。","tok":[["しばらく"],["眠","ねむり"],["、"],["しばらく"],["まどろみ"],["、"],["手","て"],["を"],["こまぬいて"],["、"],["また"],["しばらく"],["休む","やすむ"],["。"]]},{"verse":11,"text":"それゆえ、貧,まずしさは盗,ぬすびとのようにあなたに来,きたり、乏,とぼしさは、つわもののようにあなたに来,くる。","tok":[["それ"],["ゆえ"],["、"],["貧","まずし"],["さ"],["は"],["盗","ぬすびと"],["の"],["よう"],["に"],["あなた"],["に"],["来","き"],["たり"],["、"],["乏","とぼし"],["さ"],["は"],["、"],["つわもの"],["の"],["よう"],["に"],["あなた"],["に"],["来る","くる"],["。"]]},{"verse":12,"text":"よこしまな人,ひと、悪,あしき人,ひとは偽,いつわりの言葉,ことばをもって行,いきめぐり、","tok":[["よこしま"],["な"],["人","ひと"],["、"],["悪しき","あしき"],["人","ひと"],["は"],["偽わり","いつわり"],["の"],["言葉","ことば"],["を"],["もって"],["行き","いき"],["めぐり"],["、"]]},{"verse":13,"text":"目,めでめくばせし、足,あしで踏,ふみ鳴,ならし、指,ゆびで示,しめし、","tok":[["目","め"],["で"],["めくばせ"],["し"],["、"],["足","あし"],["で"],["踏み鳴らし","ふみならし"],["、"],["指","ゆび"],["で"],["示めし","しめし"],["、"]]},{"verse":14,"text":"よこしまな心,こころをもって悪,あくを計,はかり、絶,たえず争,あらそいをおこす。","tok":[["よこしま"],["な"],["心","こころ"],["を"],["もって"],["悪","あく"],["を"],["計り","はかり"],["、"],["絶えず","たえず"],["争い","あらそい"],["を"],["おこす"],["。"]]},{"verse":15,"text":"それゆえ、災,わざわいは、にわかに彼,かれに臨,のぞみ、たちまちにして打,うち敗,やぶられ、助,たすかることはない。","tok":[["それ"],["ゆえ"],["、"],["災","わざわい"],["は"],["、"],["にわか"],["に"],["彼","かれ"],["に"],["臨み","のぞみ"],["、"],["たちまち"],["に"],["して"],["打ち","うち"],["敗られ","やぶられ"],["、"],["助かる","たすかる"],["こと"],["は"],["ない"],["。"]]},{"verse":16,"text":"主,しゅの憎,にくまれるものが六つある、否,いな、その心,こころに、忌,いみきらわれるものが七つある。","tok":[["主","しゅ"],["の"],["憎まれる","にくまれる"],["もの"],["が"],["六","むい"],["つ"],["ある"],["、"],["否","いな"],["、"],["その"],["心","こころ"],["に"],["、"],["忌","いみ"],["きらわれる"],["もの"],["が"],["七","なな"],["つ"],["ある"],["。"]]},{"verse":17,"text":"すなわち、高,たかぶる目,め、偽,いつわりを言,いう舌,した、罪,つみなき人,ひとの血,ちを流,ながす手,て、","tok":[["すなわち"],["、"],["高か","たか"],["ぶる"],["目","め"],["、"],["偽り","いつわり"],["を"],["言う","いう"],["舌","した"],["、"],["罪","つみ"],["なき"],["人","ひと"],["の"],["血","ち"],["を"],["流す","ながす"],["手","て"],["、"]]},{"verse":18,"text":"悪,あしき計,はかりごとをめぐらす心,こころ、すみやかに悪,あくに走,はしる足,あし、","tok":[["悪しき","あしき"],["計り","はかり"],["ごと"],["を"],["めぐらす"],["心","こころ"],["、"],["すみやか"],["に"],["悪","あく"],["に"],["走る","はしる"],["足","あし"],["、"]]},{"verse":19,"text":"偽,いつわりをのべる証人,しょうにん、また兄弟,きょうだいのうちに争,あらそいをおこす人,ひとがこれである。","tok":[["偽り","いつわり"],["を"],["のべる"],["証人","しょうにん"],["、"],["また"],["兄弟","きょうだい"],["の"],["うち"],["に"],["争い","あらそい"],["を"],["おこす"],["人","ひと"],["が"],["これ"],["で"],["ある"],["。"]]},{"verse":20,"text":"わが子,こよ、あなたの父,ちちの戒,いましめを守,まもり、あなたの母,ははの教,おしえを捨,すてるな。","tok":[["わが"],["子","こ"],["よ"],["、"],["あなた"],["の"],["父","ちち"],["の"],["戒しめ","いましめ"],["を"],["守り","まもり"],["、"],["あなた"],["の"],["母","はは"],["の"],["教え","おしえ"],["を"],["捨てる","すてる"],["な"],["。"]]},{"verse":21,"text":"つねに、これをあなたの心,こころに結,むすび、あなたの首,くびのまわりにつけよ。","tok":[["つね"],["に"],["、"],["これ"],["を"],["あなた"],["の"],["心","こころ"],["に"],["結び","むすび"],["、"],["あなた"],["の"],["首","くび"],["の"],["まわり"],["に"],["つけよ"],["。"]]},{"verse":22,"text":"これは、あなたが歩,あるくとき、あなたを導,みちびき、あなたが寝,ねるとき、あなたを守,まもり、あなたが目,めざめるとき、あなたと語,かたる。","tok":[["これ"],["は"],["、"],["あなた"],["が"],["歩く","あるく"],["とき"],["、"],["あなた"],["を"],["導き","みちびき"],["、"],["あなた"],["が"],["寝る","ねる"],["とき"],["、"],["あなた"],["を"],["守り","まもり"],["、"],["あなた"],["が"],["目ざめる","めざめる"],["とき"],["、"],["あなた"],["と"],["語る","かたる"],["。"]]},{"verse":23,"text":"戒,いましめはともしびである、教,おしえは光,ひかりである、教訓,きょうくんの懲,こらしめは命,いのちの道,みちである。","tok":[["戒しめ","いましめ"],["は"],["ともしび"],["で"],["ある"],["、"],["教え","おしえ"],["は"],["光","ひかり"],["で"],["ある"],["、"],["教訓","きょうくん"],["の"],["懲らしめ","こらしめ"],["は"],["命","いのち"],["の"],["道","みち"],["で"],["ある"],["。"]]},{"verse":24,"text":"これは、あなたを守,まもって、悪,わるい女,おんなに近,ちかづかせず、みだらな女,おんなの、巧,たくみな舌,したに惑,まどわされぬようにする。","tok":[["これ"],["は"],["、"],["あなた"],["を"],["守って","まもって"],["、"],["悪い","わるい"],["女","おんな"],["に"],["近づかせず","ちかづかせず"],["、"],["みだら"],["な"],["女","おんな"],["の"],["、"],["巧み","たくみ"],["な"],["舌","した"],["に"],["惑わされぬ","まどわされぬ"],["よう"],["に"],["する"],["。"]]},{"verse":25,"text":"彼女,かのじょの麗,うるわしさを心,こころに慕,したってはならない、そのまぶたに捕,とらえられてはならない。","tok":[["彼女","かのじょ"],["の"],["麗わし","うるわし"],["さ"],["を"],["心","こころ"],["に"],["慕って","したって"],["は"],["ならない"],["、"],["その"],["まぶた"],["に"],["捕らえられて","とらえられて"],["は"],["ならない"],["。"]]},{"verse":26,"text":"遊女,ゆうじょは一,いっ塊,かいのパンのために雇,やとわれる、しかし、みだらな女,おんなは人,ひとの尊,たっとい命,いのちを求,もとめる。","tok":[["遊女","ゆうじょ"],["は"],["一","い"],["っ"],["塊","かい"],["の"],["パン"],["の"],["ため"],["に"],["雇われる","やとわれる"],["、"],["しかし"],["、"],["みだら"],["な"],["女","おんな"],["は"],["人","ひと"],["の"],["尊","た"],["っと"],["い"],["命","いのち"],["を"],["求める","もとめる"],["。"]]},{"verse":27,"text":"人,ひとは火,ひを、そのふところにいだいてその着物,きものが焼,やかれないであろうか。","tok":[["人","ひと"],["は"],["火","ひ"],["を"],["、"],["その"],["ふところ"],["に"],["いだいて"],["その"],["着物","きもの"],["が"],["焼かれないで","やかれないで"],["あろう"],["か"],["。"]]},{"verse":28,"text":"また人,ひとは、熱,あつい火,ひを踏,ふんで、その足,あしが、焼,やかれないであろうか。","tok":[["また"],["人","ひと"],["は"],["、"],["熱い","あつい"],["火","ひ"],["を"],["踏んで","ふんで"],["、"],["その"],["足","あし"],["が"],["、"],["焼かれないで","やかれないで"],["あろう"],["か"],["。"]]},{"verse":29,"text":"その隣,となりの妻,つまと不義,ふぎを行,おこなう者,ものも、それと同,おなじだ。すべて彼女,かのじょに触,ふれる者,ものは罰,ばつを免,まぬかれることはできない。","tok":[["その"],["隣","となり"],["の"],["妻","つま"],["と"],["不義","ふぎ"],["を"],["行なう","おこなう"],["者","もの"],["も"],["、"],["それ"],["と"],["同じ","おなじ"],["だ"],["。"],["すべて"],["彼女","かのじょ"],["に"],["触れる","ふれる"],["者","もの"],["は"],["罰","ばつ"],["を"],["免かれる","まぬかれる"],["こと"],["は"],["できない"],["。"]]},{"verse":30,"text":"盗,ぬすびとが飢,うえたとき、その飢,うえを満,みたすために盗,ぬすむならば、人,ひとは彼,かれを軽,かろんじないであろうか。","tok":[["盗","ぬすび"],["と"],["が"],["飢","うえ"],["た"],["とき"],["、"],["その"],["飢","うえ"],["を"],["満たす","みたす"],["ため"],["に"],["盗むならば","ぬすむならば"],["、"],["人","ひと"],["は"],["彼","かれ"],["を"],["軽んじないで","かろんじないで"],["あろう"],["か"],["。"]]},{"verse":31,"text":"もし捕,とらえられたなら、その七倍,ばいを償,つぐない、その家,いえの貨,か財,ざいを、ことごとく出,ださなければならない。","tok":[["もし"],["捕らえられたなら","とらえられたなら"],["、"],["その"],["七","なな"],["倍","ばい"],["を"],["償ない","つぐない"],["、"],["その"],["家","いえ"],["の"],["貨財","かざい"],["を"],["、"],["ことごとく"],["出さなければ","ださなければ"],["ならない"],["。"]]},{"verse":32,"text":"女,おんなと姦淫,かんいんを行,おこなう者,ものは思慮,しりょがない。これを行,おこなう者,ものはおのれを滅,ほろぼし、","tok":[["女","おんな"],["と"],["姦淫","かんいん"],["を"],["行なう","おこなう"],["者","もの"],["は"],["思慮","しりょ"],["が"],["ない"],["。"],["これ"],["を"],["行なう","おこなう"],["者","もの"],["は"],["おのれ"],["を"],["滅ぼし","ほろぼし"],["、"]]},{"verse":33,"text":"傷,きずと、はずかしめとを受,うけて、その恥,はじをすすぐことができない。","tok":[["傷","きず"],["と"],["、"],["はずかしめ"],["と"],["を"],["受て","うけて"],["、"],["その"],["恥","はじ"],["を"],["すすぐ"],["こと"],["が"],["できない"],["。"]]},{"verse":34,"text":"ねたみは、その夫,おっとを激,はげしく怒,いからせるゆえ、恨,うらみを報,むくいるとき、容赦,ようしゃすることはない。","tok":[["ねたみ"],["は"],["、"],["その"],["夫","おっと"],["を"],["激しく","はげしく"],["怒らせる","いからせる"],["ゆえ"],["、"],["恨み","うらみ"],["を"],["報いる","むくいる"],["とき"],["、"],["容赦","ようしゃ"],["する"],["こと"],["は"],["ない"],["。"]]},{"verse":35,"text":"どのようなあがない物,ものをも顧,かえりみず、多,おおくの贈,おくり物,ものをしても、和,やわらがない。","tok":[["どのような"],["あがない"],["物","もの"],["を"],["も"],["顧ず","かえりみず"],["、"],["多く","おおく"],["の"],["贈り物","おくりもの"],["を"],["して"],["も"],["、"],["和らがない","やわらがない"],["。"]]}]
[{"verse":1,"text":"知恵,ちえある子,こは父,ちちの教訓,きょうくんをきく、あざける者,ものは、懲,こらしめをきかない。","tok":[["知恵","ちえ"],["ある"],["子","こ"],["は"],["父","ちち"],["の"],["教訓","きょうくん"],["を"],["きく"],["、"],["あざける"],["者","もの"],["は"],["、"],["懲らしめ","こらしめ"],["を"],["きかない"],["。"]]},{"verse":2,"text":"善良,ぜんりょうな人,ひとはその口,くちの実,じつによって、幸福,こうふくを得,える、不信実,ふしんじつな者,ものの願,ねがいは、暴虐,ぼうぎゃくである。","tok":[["善良","ぜんりょう"],["な"],["人","ひと"],["は"],["その"],["口","くち"],["の"],["実","じつ"],["によって"],["、"],["幸福","こうふく"],["を"],["得る","える"],["、"],["不","ふ"],["信実","しんじつ"],["な"],["者","もの"],["の"],["願い","ねがい"],["は"],["、"],["暴虐","ぼうぎゃく"],["で"],["ある"],["。"]]},{"verse":3,"text":"口,くちを守,まもる者,ものはその命,いのちを守,まもる、くちびるを大,おおきく開,ひらく者,ものには滅,ほろびが来,くる。","tok":[["口","くち"],["を"],["守者","まもるもの"],["は"],["その"],["命","いのち"],["を"],["守","まもる"],["、"],["くちびる"],["を"],["大きく","おおきく"],["開らく","ひらく"],["者","もの"],["に"],["は"],["滅び","ほろび"],["が"],["来る","くる"],["。"]]},{"verse":4,"text":"なまけ者,ものの心,こころは、願,ねがい求,もとめても、何,なにも得,えない、しかし勤,つとめ働,はたらく者,ものの心,こころは豊,ゆたかに満,みたされる。","tok":[["なまけ者","なまけもの"],["の"],["心","こころ"],["は"],["、"],["願い求めて","ねがいもとめて"],["も"],["、"],["何に","なに"],["も"],["得ない","えない"],["、"],["しかし"],["勤め","つとめ"],["働く","はたらく"],["者","もの"],["の"],["心","こころ"],["は"],["豊","ゆたか"],["に"],["満たされる","みたされる"],["。"]]},{"verse":5,"text":"正,ただしい人,ひとは偽,いつわりを憎,にくむ、しかし悪,あしき人,ひとは恥,はずべく、忌,いまわしくふるまう。","tok":[["正い","ただしい"],["人","ひと"],["は"],["偽り","いつわり"],["を"],["憎む","にくむ"],["、"],["しかし"],["悪しき","あしき"],["人","ひと"],["は"],["恥ずべく","はずべく"],["、"],["忌まわしく","いまわしく"],["ふるまう"],["。"]]},{"verse":6,"text":"正義,せいぎは道,みちをまっすぐ歩,あゆむ者,ものを守,まもり、罪,つみは悪,あしき者,ものを倒,たおす。","tok":[["正義","せいぎ"],["は"],["道","みち"],["を"],["まっすぐ"],["歩む","あゆむ"],["者","もの"],["を"],["守り","まもり"],["、"],["罪","つみ"],["は"],["悪しき","あしき"],["者","もの"],["を"],["倒す","たおす"],["。"]]},{"verse":7,"text":"富,とんでいると偽,いつわって、何,なにも持,もたない者,ものがいる、貧,まずしいと偽,いつわって、多,おおくの富,とみを持,もつ者,ものがいる。","tok":[["富","とんでいる"],["と"],["偽わって","いつわって"],["、"],["何に","なに"],["も"],["持たない","もたない"],["者","もの"],["が"],["いる"],["、"],["貧しい","まずしい"],["と"],["偽わって","いつわって"],["、"],["多く","おおく"],["の"],["富","とみ"],["を"],["持つ","もつ"],["者","もの"],["が"],["いる"],["。"]]},{"verse":8,"text":"人,ひとの富,とみはその命,いのちをあがなう、しかし貧,まずしい者,ものにはあがなうべき富,とみがない。","tok":[["人","ひと"],["の"],["富","とみ"],["は"],["その"],["命","いのち"],["を"],["あがなう"],["、"],["しかし"],["貧しい","まずしい"],["者","もの"],["に"],["は"],["あがなうべき"],["富","とみ"],["が"],["ない"],["。"]]},{"verse":9,"text":"正,ただしい者,ものの光,ひかりは輝,かがやき、悪,あしき者,もののともしびは消,けされる。","tok":[["正い","ただしい"],["者","もの"],["の"],["光","ひかり"],["は"],["輝やき","かがやき"],["、"],["悪しき","あしき"],["者","もの"],["の"],["ともしび"],["は"],["消される","けされる"],["。"]]},{"verse":10,"text":"高,たかぶりはただ争,あらそいを生,しょうじる、勧告,かんこくをきく者,ものは知恵,ちえがある。","tok":[["高か","たか"],["ぶり"],["は"],["ただ"],["争い","あらそい"],["を"],["生じる","しょうじる"],["、"],["勧告","かんこく"],["を"],["きく"],["者","もの"],["は"],["知恵","ちえ"],["が"],["ある"],["。"]]},{"verse":11,"text":"急,いそいで得,えた富,とみは減,へる、少,すこしずつたくわえる者,ものはそれを増,ますことができる。","tok":[["急いで","いそいで"],["得た","えた"],["富","とみ"],["は"],["減る","へる"],["、"],["少し","すこし"],["ずつ"],["たくわえる"],["者","もの"],["は"],["それ"],["を"],["増す","ます"],["こと"],["が"],["できる"],["。"]]},{"verse":12,"text":"望,のぞみを得,えることが長,ながびくときは、心,こころを悩,なやます、願,ねがいがかなうときは、命,いのちの木,きを得,えたようだ。","tok":[["望み","のぞみ"],["を"],["得る","える"],["こと"],["が"],["長びく","ながびく"],["とき"],["は"],["、"],["心","こころ"],["を"],["悩す","なやます"],["、"],["願い","ねがい"],["が"],["かなう"],["とき"],["は"],["、"],["命","いのち"],["の"],["木","き"],["を"],["得た","えた"],["よう"],["だ"],["。"]]},{"verse":13,"text":"み言葉,ことばを軽,かろんじる者,ものは滅,ほろぼされ、戒,いましめを重,おもんじる者,ものは報,むくいを得,える。","tok":[["み言葉","みことば"],["を"],["軽んじる","かろんじる"],["者","もの"],["は"],["滅ぼされ","ほろぼされ"],["、"],["戒しめ","いましめ"],["を"],["重じる","おもんじる"],["者","もの"],["は"],["報い","むくい"],["を"],["得る","える"],["。"]]},{"verse":14,"text":"知恵,ちえある人,ひとの教,おしえは命,いのちの泉,いずみである、これによって死,しのわなをのがれることができる。","tok":[["知恵","ちえ"],["ある"],["人","ひと"],["の"],["教え","おしえ"],["は"],["命","いのち"],["の"],["泉","いずみ"],["で"],["ある"],["、"],["これ"],["によって"],["死","し"],["の"],["わな"],["を"],["のがれる"],["こと"],["が"],["できる"],["。"]]},{"verse":15,"text":"善良,ぜんりょうな賢,かしこい者,ものは恵,めぐみを得,える、しかし、不信実,ふしんじつな者,ものの道,みちは滅,ほろびである。","tok":[["善良","ぜんりょう"],["な"],["賢しこい","かしこい"],["者","もの"],["は"],["恵","めぐみ"],["を"],["得る","える"],["、"],["しかし"],["、"],["不","ふ"],["信実","しんじつ"],["な"],["者","もの"],["の"],["道","みち"],["は"],["滅び","ほろび"],["で"],["ある"],["。"]]},{"verse":16,"text":"おおよそ、さとき者,ものは知識,ちしきによって事,ことをおこない、愚,おろかな者,ものは自分,じぶんの愚,ぐを見,みせびらかす。","tok":[["おおよそ"],["、"],["さ"],["とき"],["者","もの"],["は"],["知識","ちしき"],["によって"],["事","こと"],["を"],["おこない"],["、"],["愚か","おろか"],["な"],["者","もの"],["は"],["自分","じぶん"],["の"],["愚","ぐ"],["を"],["見せびらかす","みせびらかす"],["。"]]},{"verse":17,"text":"悪,あしき使者,ししゃは人,ひとを災,わざわいにおとしいれる、しかし忠実,ちゅうじつな使者,ししゃは人,ひとを救,すくう。","tok":[["悪しき","あしき"],["使者","ししゃ"],["は"],["人","ひと"],["を"],["災","わざわい"],["に"],["おとしいれる"],["、"],["しかし"],["忠実","ちゅうじつ"],["な"],["使者","ししゃ"],["は"],["人","ひと"],["を"],["救う","すくう"],["。"]]},{"verse":18,"text":"貧乏,びんぼうと、はずかしめとは教訓,きょうくんを捨,すてる者,ものに来,くる、しかし戒,いましめを守,まもる者,ものは尊,たっとばれる。","tok":[["貧乏","びんぼう"],["と"],["、"],["はずかしめ"],["と"],["は"],["教訓","きょうくん"],["を"],["捨てる","すてる"],["者","もの"],["に"],["来る","くる"],["、"],["しかし"],["戒しめ","いましめ"],["を"],["守者","まもるもの"],["は"],["尊","た"],["っと"],["ばれる"],["。"]]},{"verse":19,"text":"願,ねがいがかなえば、心,こころは楽,たのしい、愚,おろかな者,ものは悪,あくを捨,すてることをきらう。","tok":[["願い","ねがい"],["が"],["かなえば"],["、"],["心","こころ"],["は"],["楽い","たのしい"],["、"],["愚か","おろか"],["な"],["者","もの"],["は"],["悪","あく"],["を"],["捨てる","すてる"],["こと"],["を"],["きらう"],["。"]]},{"verse":20,"text":"知恵,ちえある者,ものとともに歩,あゆむ者,ものは知恵,ちえを得,える。愚,おろかな者,ものの友,ともとなる者,ものは害,がいをうける。","tok":[["知恵","ちえ"],["ある"],["者","もの"],["と"],["とも"],["に"],["歩む","あゆむ"],["者","もの"],["は"],["知恵","ちえ"],["を"],["得る","える"],["。"],["愚か","おろか"],["な"],["者","もの"],["の"],["友","とも"],["と"],["なる"],["者","もの"],["は"],["害","がい"],["を"],["うける"],["。"]]},{"verse":21,"text":"災,わざわいは罪,つみびとを追,おい、正,ただしい者,ものは良,よい報,むくいを受,うける。","tok":[["災","わざわい"],["は"],["罪びと","つみびと"],["を"],["追い","おい"],["、"],["正い","ただしい"],["者","もの"],["は"],["良い","よい"],["報い","むくい"],["を"],["受る","うける"],["。"]]},{"verse":22,"text":"善良,ぜんりょうな人,ひとはその嗣,し業,ぎょうを子孫,しそんにのこす、しかし罪,つみびとの富,とみは正,ただしい人,ひとのためにたくわえられる。","tok":[["善良","ぜんりょう"],["な"],["人","ひと"],["は"],["その"],["嗣業","しぎょう"],["を"],["子孫","しそん"],["に"],["のこす"],["、"],["しかし"],["罪びと","つみびと"],["の"],["富","とみ"],["は"],["正い","ただしい"],["人","ひと"],["の"],["ため"],["に"],["たくわえられる"],["。"]]},{"verse":23,"text":"貧,まずしい人,ひとの新田,しんでんは多,おおくの食糧,しょくりょうを産,さんする、しかし不正,ふせいによれば押,おし流,ながされる。","tok":[["貧しい","まずしい"],["人","ひと"],["の"],["新田","しんでん"],["は"],["多く","おおく"],["の"],["食糧","しょくりょう"],["を"],["産する","さんする"],["、"],["しかし"],["不正","ふせい"],["に"],["よれば"],["押","おし"],["流される","ながされる"],["。"]]},{"verse":24,"text":"むちを加,くわえない者,ものはその子,こを憎,にくむのである、子,こを愛,あいする者,ものは、つとめてこれを懲,こらしめる。","tok":[["むち"],["を"],["加えない","くわえない"],["者","もの"],["は"],["その"],["子","こ"],["を"],["憎む","にくむ"],["ので"],["ある"],["、"],["子","こ"],["を"],["愛する","あいする"],["者","もの"],["は"],["、"],["つとめて"],["これ"],["を"],["懲らしめる","こらしめる"],["。"]]},{"verse":25,"text":"正,ただしい者,ものは食,たべてその食欲,しょくよくを満,みたす、しかし悪,あしき者,ものの腹,はらは満,みたされない。","tok":[["正い","ただしい"],["者","もの"],["は"],["食べて","たべて"],["その"],["食欲","しょくよく"],["を"],["満たす","みたす"],["、"],["しかし"],["悪しき","あしき"],["者","もの"],["の"],["腹","はら"],["は"],["満たされない","みたされない"],["。"]]}]
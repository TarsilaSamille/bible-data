[{"verse":1,"text":"知恵,ちえはその家,いえを建,たて、愚,おろかさは自分,じぶんの手,てでそれをこわす。","tok":[["知恵","ちえ"],["は"],["その"],["家","いえ"],["を"],["建て","たて"],["、"],["愚か","おろか"],["さ"],["は"],["自分","じぶん"],["の"],["手","て"],["で"],["それ"],["を"],["こわす"],["。"]]},{"verse":2,"text":"まっすぐに歩,あゆむ者,ものは主,しゅを恐,おそれる、曲,まがって歩,あゆむ者,ものは主,しゅを侮,あなどる。","tok":[["まっすぐ"],["に"],["歩む","あゆむ"],["者","もの"],["は"],["主","しゅ"],["を"],["恐れる","おそれる"],["、"],["曲がって","まがって"],["歩む","あゆむ"],["者","もの"],["は"],["主","しゅ"],["を"],["侮る","あなどる"],["。"]]},{"verse":3,"text":"愚,おろかな者,ものの言葉,ことばは自分,じぶんの背,せにむちを当,あてる、知恵,ちえある者,もののくちびるはその身,みを守,まもる。","tok":[["愚か","おろか"],["な"],["者","もの"],["の"],["言葉","ことば"],["は"],["自分","じぶん"],["の"],["背","せ"],["に"],["むち"],["を"],["当てる","あてる"],["、"],["知恵","ちえ"],["ある"],["者","もの"],["の"],["くちびる"],["は"],["その"],["身","み"],["を"],["守","まもる"],["。"]]},{"verse":4,"text":"牛,うしがなければ穀物,こくもつはない、牛,うしの力,ちからによって農作物,のうさくもつは多,おおくなる。","tok":[["牛","うし"],["が"],["なければ"],["穀物","こくもつ"],["は"],["ない"],["、"],["牛","うし"],["の"],["力","ちから"],["によって"],["農作物","のうさくもつ"],["は"],["多く","おおく"],["なる"],["。"]]},{"verse":5,"text":"真実,しんじつな証人,しょうにんはうそをいわない、偽,いつわりの証人,しょうにんはうそをつく。","tok":[["真実","しんじつ"],["な"],["証人","しょうにん"],["は"],["うそ"],["を"],["いわない"],["、"],["偽わり","いつわり"],["の"],["証人","しょうにん"],["は"],["うそ"],["を"],["つく"],["。"]]},{"verse":6,"text":"あざける者,ものは知恵,ちえを求,もとめても得,えられない、さとき者,ものは知識,ちしきを得,えることがたやすい。","tok":[["あざける"],["者","もの"],["は"],["知恵","ちえ"],["を"],["求めて","もとめて"],["も"],["得られない","えられない"],["、"],["さ"],["とき"],["者","もの"],["は"],["知識","ちしき"],["を"],["得る","える"],["こと"],["が"],["たやすい"],["。"]]},{"verse":7,"text":"愚,おろかな者,ものの前,まえを離,はなれ去,され、そこには知識,ちしきの言葉,ことばがないからである。","tok":[["愚か","おろか"],["な"],["者","もの"],["の"],["前","まえ"],["を"],["離れ去れ","はなれされ"],["、"],["そこ"],["に"],["は"],["知識","ちしき"],["の"],["言葉","ことば"],["が"],["ない"],["から"],["で"],["ある"],["。"]]},{"verse":8,"text":"さとき者,ものの知恵,ちえは自分,じぶんの道,みちをわきまえることにあり、愚,おろかな者,ものの愚,おろかは、欺,あざむくことにある。","tok":[["さ"],["とき"],["者","もの"],["の"],["知恵","ちえ"],["は"],["自分","じぶん"],["の"],["道","みち"],["を"],["わきまえる"],["こと"],["に"],["あり"],["、"],["愚か","おろか"],["な"],["者","もの"],["の"],["愚か","おろか"],["は"],["、"],["欺く","あざむく"],["こと"],["に"],["ある"],["。"]]},{"verse":9,"text":"神,かみは悪,あしき者,ものをあざけられる、正,ただしい者,ものは、その恵,めぐみを受,うける。","tok":[["神","かみ"],["は"],["悪しき","あしき"],["者","もの"],["を"],["あざけられる"],["、"],["正い","ただしい"],["者","もの"],["は"],["、"],["その"],["恵","めぐみ"],["を"],["受る","うける"],["。"]]},{"verse":10,"text":"心,こころの苦,くるしみは心,こころみずからが知,しる、その喜,よろこびには他人,たにんはあずからない。","tok":[["心","こころ"],["の"],["苦しみ","くるしみ"],["は"],["心","こころ"],["みずから"],["が"],["知る","しる"],["、"],["その"],["喜こび","よろこび"],["に"],["は"],["他人","たにん"],["は"],["あずからない"],["。"]]},{"verse":11,"text":"悪,あしき者,ものの家,いえは滅,ほろぼされ、正,ただしい者,ものの幕屋,まくやは栄,さかえる。","tok":[["悪しき","あしき"],["者","もの"],["の"],["家","いえ"],["は"],["滅ぼされ","ほろぼされ"],["、"],["正い","ただしい"],["者","もの"],["の"],["幕屋","まくや"],["は"],["栄","さかえ"],["る"],["。"]]},{"verse":12,"text":"人,ひとが見,みて自,みずから正,ただしいとする道,みちでも、その終,おわりはついに死,しに至,いたる道,みちとなるものがある。","tok":[["人","ひと"],["が"],["見て","みて"],["自から","みずから"],["正い","ただしい"],["と"],["する"],["道","みち"],["で"],["も"],["、"],["その"],["終","おわり"],["は"],["ついに"],["死","し"],["に"],["至る","いたる"],["道","みち"],["と"],["なる"],["もの"],["が"],["ある"],["。"]]},{"verse":13,"text":"笑,わらう時,ときにも心,こころに悲,かなしみがあり、喜,よろこびのはてに憂,うれいがある。","tok":[["笑う","わらう"],["時","とき"],["に"],["も"],["心","こころ"],["に"],["悲しみ","かなしみ"],["が"],["あり"],["、"],["喜こび","よろこび"],["の"],["はて"],["に"],["憂","うれい"],["が"],["ある"],["。"]]},{"verse":14,"text":"心,こころのもとれる者,ものはそのしわざの実,みを刈,かり取,とり、善良,ぜんりょうな人,ひともまたその行,おこないの実,みを刈,かり取,とる。","tok":[["心","こころ"],["の"],["もと"],["れる"],["者","もの"],["は"],["その"],["しわざ"],["の"],["実","み"],["を"],["刈取","かりとり"],["、"],["善良","ぜんりょう"],["な"],["人","ひと"],["も"],["また"],["その"],["行ない","おこない"],["の"],["実","み"],["を"],["刈取る","かりとる"],["。"]]},{"verse":15,"text":"思慮,しりょのない者,ものはすべてのことを信,しんじる、さとき者,ものは自分,じぶんの歩,あゆみを慎,つつしむ。","tok":[["思慮","しりょ"],["の"],["ない"],["者","もの"],["は"],["すべて"],["の"],["こと"],["を"],["信じる","しんじる"],["、"],["さ"],["とき"],["者","もの"],["は"],["自分","じぶん"],["の"],["歩み","あゆみ"],["を"],["慎しむ","つつしむ"],["。"]]},{"verse":16,"text":"知恵,ちえある者,ものは用心,ようじんぶかく、悪,あくを離,はなれる、愚,おろかな者,ものは高,たかぶって用心,ようじんしない。","tok":[["知恵","ちえ"],["ある"],["者","もの"],["は"],["用心","ようじん"],["ぶかく"],["、"],["悪","あく"],["を"],["離れる","はなれる"],["、"],["愚か","おろか"],["な"],["者","もの"],["は"],["高か","たか"],["ぶっ"],["て"],["用心","ようじん"],["しない"],["。"]]},{"verse":17,"text":"怒,いかりやすい者,ものは愚,おろかなことを行,おこない、賢,かしこい者,ものは忍耐,にんたい強,つよい。","tok":[["怒","い"],["かり"],["やすい"],["者","もの"],["は"],["愚か","おろか"],["な"],["こと"],["を"],["行ない","おこない"],["、"],["賢しこい","かしこい"],["者","もの"],["は"],["忍耐","にんたい"],["強い","つよい"],["。"]]},{"verse":18,"text":"思慮,しりょのない者,ものは愚,おろかなことを自分,じぶんのものとする、さとき者,ものは知識,ちしきをもって冠,かんむりとする。","tok":[["思慮","しりょ"],["の"],["ない"],["者","もの"],["は"],["愚か","おろか"],["な"],["こと"],["を"],["自分","じぶん"],["の"],["もの"],["と"],["する"],["、"],["さ"],["とき"],["者","もの"],["は"],["知識","ちしき"],["を"],["もって"],["冠","かんむり"],["と"],["する"],["。"]]},{"verse":19,"text":"悪人,あくにんは善人,ぜんにんの前,まえにひれ伏,ふし、悪,あしき者,ものは正,ただしい者,ものの門,もんにひれ伏,ふす。","tok":[["悪人","あくにん"],["は"],["善人","ぜんにん"],["の"],["前","まえ"],["に"],["ひれ伏し","ひれふし"],["、"],["悪しき","あしき"],["者","もの"],["は"],["正い","ただしい"],["者","もの"],["の"],["門","もん"],["に"],["ひれ伏す","ひれふす"],["。"]]},{"verse":20,"text":"貧,まずしい者,ものはその隣,となりにさえも憎,にくまれる、しかし富,とめる者,ものは多,おおくの友,ともをもつ。","tok":[["貧しい","まずしい"],["者","もの"],["は"],["その"],["隣","となり"],["に"],["さえ"],["も"],["憎まれる","にくまれる"],["、"],["しかし"],["富める","とめる"],["者","もの"],["は"],["多く","おおく"],["の"],["友","とも"],["を"],["もつ"],["。"]]},{"verse":21,"text":"隣,となり人,びとを卑,いやしめる者,ものは罪,つみびとである、貧,まずしい人,ひとをあわれむ者,ものはさいわいである。","tok":[["隣人","となりびと"],["を"],["卑しめる","いやしめる"],["者","もの"],["は"],["罪びと","つみびと"],["で"],["ある"],["、"],["貧しい","まずしい"],["人","ひと"],["を"],["あわれむ"],["者","もの"],["は"],["さいわい"],["で"],["ある"],["。"]]},{"verse":22,"text":"悪,あくを計,はかる者,ものはおのれを誤,あやまるではないか、善,ぜんを計,はかる者,ものにはいつくしみと、まこととがある。","tok":[["悪","あく"],["を"],["計る","はかる"],["者","もの"],["は"],["おのれ"],["を"],["誤るで","あやまるで"],["は"],["ない"],["か"],["、"],["善","ぜん"],["を"],["計る","はかる"],["者","もの"],["に"],["は"],["いつくしみ"],["と"],["、"],["まこと"],["と"],["が"],["ある"],["。"]]},{"verse":23,"text":"すべての勤労,きんろうには利益,りえきがある、しかし口先,くちさきだけの言葉,ことばは貧乏,びんぼうをきたらせるだけだ。","tok":[["すべて"],["の"],["勤労","きんろう"],["に"],["は"],["利益","りえき"],["が"],["ある"],["、"],["しかし"],["口先","くちさき"],["だけ"],["の"],["言葉","ことば"],["は"],["貧乏","びんぼう"],["を"],["きたらせる"],["だけ"],["だ"],["。"]]},{"verse":24,"text":"知恵,ちえある者,ものの冠,かんむりはその知恵,ちえである、愚,おろかな者,ものの花,はなの冠,かんむりはただ愚,おろかさである。","tok":[["知恵","ちえ"],["ある"],["者","もの"],["の"],["冠","かんむり"],["は"],["その"],["知恵","ちえ"],["で"],["ある"],["、"],["愚か","おろか"],["な"],["者","もの"],["の"],["花","はな"],["の"],["冠","かんむり"],["は"],["ただ"],["愚か","おろか"],["さ"],["で"],["ある"],["。"]]},{"verse":25,"text":"まことの証人,しょうにんは人,ひとの命,いのちを救,すくう、偽,いつわりを吐,はく者,ものは裏,うら切,ぎり者,ものである。","tok":[["まこと"],["の"],["証人","しょうにん"],["は"],["人","ひと"],["の"],["命","いのち"],["を"],["救う","すくう"],["、"],["偽り","いつわり"],["を"],["吐く","はく"],["者","もの"],["は"],["裏切者","うらぎりもの"],["で"],["ある"],["。"]]},{"verse":26,"text":"主,しゅを恐,おそれることによって人,ひとは安心,あんしんを得,え、その子,こらはのがれ場,ばを得,える。","tok":[["主","しゅ"],["を"],["恐れる","おそれる"],["こと"],["によって"],["人","ひと"],["は"],["安心","あんしん"],["を"],["得","え"],["、"],["その"],["子","こ"],["ら"],["は"],["の"],["がれ場","がれば"],["を"],["得る","える"],["。"]]},{"verse":27,"text":"主,しゅを恐,おそれることは命,いのちの泉,いずみである、人,ひとを死,しのわなからのがれさせる。","tok":[["主","しゅ"],["を"],["恐れる","おそれる"],["こと"],["は"],["命","いのち"],["の"],["泉","いずみ"],["で"],["ある"],["、"],["人","ひと"],["を"],["死","し"],["の"],["わな"],["から"],["のがれさせる"],["。"]]},{"verse":28,"text":"王,おうの栄,さかえは民,たみの多,おおいことにあり、君,きみの滅,ほろびは民,たみを失,うしなうことにある。","tok":[["王","おう"],["の"],["栄","さかえ"],["は"],["民","たみ"],["の"],["多い","おおい"],["こと"],["に"],["あり"],["、"],["君","きみ"],["の"],["滅び","ほろび"],["は"],["民","たみ"],["を"],["失なう","うしなう"],["こと"],["に"],["ある"],["。"]]},{"verse":29,"text":"怒,いかりをおそくする者,ものは大,おおいなる悟,さとりがあり、気,きの短,みじかい者,ものは愚,おろかさをあらわす。","tok":[["怒り","いかり"],["を"],["おそく"],["する"],["者","もの"],["は"],["大いなる","おおいなる"],["悟り","さとり"],["が"],["あり"],["、"],["気","き"],["の"],["短かい","みじかい"],["者","もの"],["は"],["愚か","おろか"],["さ"],["を"],["あらわす"],["。"]]},{"verse":30,"text":"穏,おだやかな心,こころは身,みの命,いのちである、しかし興奮,こうふんは骨,ほねを腐,くさらせる。","tok":[["穏","おだやか"],["な"],["心","こころ"],["は"],["身","み"],["の"],["命","いのち"],["で"],["ある"],["、"],["しかし"],["興奮","こうふん"],["は"],["骨","ほね"],["を"],["腐らせる","くさらせる"],["。"]]},{"verse":31,"text":"貧,まずしい者,ものをしえたげる者,ものはその造,つくり主,ぬしを侮,あなどる、乏,とぼしい者,ものをあわれむ者,ものは、主,しゅをうやまう。","tok":[["貧しい","まずしい"],["者","もの"],["を"],["し"],["えたげる"],["者","もの"],["は"],["その"],["造主","つくりぬし"],["を"],["侮る","あなどる"],["、"],["乏い","とぼしい"],["者","もの"],["を"],["あわれむ"],["者","もの"],["は"],["、"],["主","しゅ"],["を"],["うやまう"],["。"]]},{"verse":32,"text":"悪,あしき者,ものはその悪,あしき行,おこないによって滅,ほろぼされ、正,ただしい者,ものはその正,ただしきによって、のがれ場,ばを得,える。","tok":[["悪しき","あしき"],["者","もの"],["は"],["その"],["悪しき","あしき"],["行ない","おこない"],["によって"],["滅ぼされ","ほろぼされ"],["、"],["正い","ただしい"],["者","もの"],["は"],["その"],["正き","ただしき"],["によって"],["、"],["の"],["がれ場","がれば"],["を"],["得る","える"],["。"]]},{"verse":33,"text":"知恵,ちえはさとき者,ものの心,こころにとどまり、愚,おろかな者,ものの心,こころに知,しられない。","tok":[["知恵","ちえ"],["は"],["さ"],["とき"],["者","もの"],["の"],["心","こころ"],["に"],["とどまり"],["、"],["愚か","おろか"],["な"],["者","もの"],["の"],["心","こころ"],["に"],["知られない","しられない"],["。"]]},{"verse":34,"text":"正義,せいぎは国,くにを高,たかくし、罪,つみは民,たみをはずかしめる。","tok":[["正義","せいぎ"],["は"],["国","くに"],["を"],["高かく","たかく"],["し"],["、"],["罪","つみ"],["は"],["民","たみ"],["を"],["はずかしめる"],["。"]]},{"verse":35,"text":"賢,かしこいしもべは王,おうの恵,めぐみをうけ、恥,はじをきたらす者,ものはその怒,いかりにあう。","tok":[["賢しこい","かしこい"],["しもべ"],["は"],["王","おう"],["の"],["恵","めぐみ"],["を"],["うけ"],["、"],["恥","はじ"],["を"],["きたら"],["す"],["者","もの"],["は"],["その"],["怒り","いかり"],["に"],["あう"],["。"]]}]
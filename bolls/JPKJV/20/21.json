[{"verse":1,"text":"王,おうの心,こころは、主,しゅの手,てのうちにあって、水,みずの流,ながれのようだ、主,しゅはみこころのままにこれを導,みちびかれる。","tok":[["王","おう"],["の"],["心","こころ"],["は"],["、"],["主","しゅ"],["の"],["手","て"],["の"],["うち"],["に"],["あって"],["、"],["水","みず"],["の"],["流れ","ながれ"],["の"],["よう"],["だ"],["、"],["主","しゅ"],["は"],["みこころ"],["の"],["まま"],["に"],["これ"],["を"],["導かれる","みちびかれる"],["。"]]},{"verse":2,"text":"人,ひとの道,みちは自分,じぶんの目,めには正,ただしく見,みえる、しかし主,しゅは人,ひとの心,こころをはかられる。","tok":[["人","ひと"],["の"],["道","みち"],["は"],["自分","じぶん"],["の"],["目","め"],["に"],["は"],["正く","ただしく"],["見える","みえる"],["、"],["しかし"],["主","しゅ"],["は"],["人","ひと"],["の"],["心","こころ"],["を"],["はかられる"],["。"]]},{"verse":3,"text":"正義,せいぎと公平,こうへいを行,おこなうことは、犠牲,ぎせいにもまさって主,しゅに喜,よろこばれる。","tok":[["正義","せいぎ"],["と"],["公平","こうへい"],["を"],["行なう","おこなう"],["こと"],["は"],["、"],["犠牲","ぎせい"],["に"],["も"],["まさって"],["主に","しゅに"],["喜こばれる","よろこばれる"],["。"]]},{"verse":4,"text":"高,たかぶる目,めとおごる心,こころとは、悪,あしき人,ひとのともしびであって、罪,つみである。","tok":[["高か","たか"],["ぶる"],["目","め"],["と"],["おごる"],["心","こころ"],["と"],["は"],["、"],["悪しき","あしき"],["人","ひと"],["の"],["ともしび"],["で"],["あって"],["、"],["罪","つみ"],["で"],["ある"],["。"]]},{"verse":5,"text":"勤勉,きんべんな人,ひとの計画,けいかくは、ついにその人,ひとを豊,ゆたかにする、すべて怠,おこたるものは貧,まずしくなる。","tok":[["勤勉","きんべん"],["な"],["人","ひと"],["の"],["計画","けいかく"],["は"],["、"],["ついに"],["その"],["人","ひと"],["を"],["豊","ゆたか"],["に"],["する"],["、"],["すべて"],["怠たる","おこたる"],["もの"],["は"],["貧しく","まずしく"],["なる"],["。"]]},{"verse":6,"text":"偽,いつわりの舌,したをもって宝,たからを得,えるのは、吹,ふきはらわれる煙,けむり、死,しのわなである。","tok":[["偽わり","いつわり"],["の"],["舌","した"],["を"],["もって"],["宝","たから"],["を"],["得る","える"],["の"],["は"],["、"],["吹","ふき"],["はらわれる"],["煙","けむり"],["、"],["死","し"],["の"],["わな"],["で"],["ある"],["。"]]},{"verse":7,"text":"悪,あしき者,ものの暴虐,ぼうぎゃくはその身,みを滅,ほろぼす、彼,かれらは公平,こうへいを行,おこなうことを好,このまないからである。","tok":[["悪しき","あしき"],["者","もの"],["の"],["暴虐","ぼうぎゃく"],["は"],["その"],["身","み"],["を"],["滅ぼす","ほろぼす"],["、"],["彼","かれ"],["ら"],["は"],["公平","こうへい"],["を"],["行なう","おこなう"],["こと"],["を"],["好まない","このまない"],["から"],["で"],["ある"],["。"]]},{"verse":8,"text":"罪,つみびとの道,みちは曲,まがっている、潔白,けっぱくな人,ひとの行,おこないはまっすぐである。","tok":[["罪びと","つみびと"],["の"],["道","みち"],["は"],["曲がって","まがって"],["いる"],["、"],["潔白","けっぱく"],["な"],["人","ひと"],["の"],["行ない","おこない"],["は"],["まっすぐ"],["で"],["ある"],["。"]]},{"verse":9,"text":"争,あらそいを好,このむ女,おんなと一緒,いっしょに家,いえにおるよりは屋根,やねのすみにおるほうがよい。","tok":[["争い","あらそい"],["を"],["好む","このむ"],["女","おんな"],["と"],["一緒","いっしょ"],["に"],["家","いえ"],["に"],["おる"],["より"],["は"],["屋根","やね"],["の"],["すみ"],["に"],["おる"],["ほう"],["が"],["よい"],["。"]]},{"verse":10,"text":"悪,あしき者,ものの魂,たましいは悪,あくを行,おこなうことを願,ねがう、その隣,となり人,びとにも好意,こういをもって見,みられない。","tok":[["悪しき","あしき"],["者","もの"],["の"],["魂","たましい"],["は"],["悪","あく"],["を"],["行なう","おこなう"],["こと"],["を"],["願う","ねがう"],["、"],["その"],["隣人","となりびと"],["に"],["も"],["好意","こうい"],["を"],["もって"],["見られない","みられない"],["。"]]},{"verse":11,"text":"あざけるものが罰,ばつをうけるならば、思慮,しりょのない者,ものは知恵,ちえを得,える。知恵,ちえある者,ものが教,おしえをうけるならば知識,ちしきを得,える。","tok":[["あざける"],["もの"],["が"],["罰","ばつ"],["を"],["うけるならば"],["、"],["思慮","しりょ"],["の"],["ない"],["者","もの"],["は"],["知恵","ちえ"],["を"],["得る","える"],["。"],["知恵","ちえ"],["ある"],["者","もの"],["が"],["教え","おしえ"],["を"],["うけるならば"],["知識","ちしき"],["を"],["得る","える"],["。"]]},{"verse":12,"text":"正,ただしい神,かみは、悪,あしき者,ものの家,いえをみとめて、悪,あしき者,ものを滅,ほろびに投,なげいれられる。","tok":[["正い","ただしい"],["神","かみ"],["は"],["、"],["悪しき","あしき"],["者","もの"],["の"],["家","いえ"],["を"],["みとめて"],["、"],["悪しき","あしき"],["者","もの"],["を"],["滅び","ほろび"],["に"],["投","なげ"],["いれられる"],["。"]]},{"verse":13,"text":"耳,みみを閉,とじて貧,まずしい者,ものの呼,よぶ声,こえを聞,きかない者,ものは、自分,じぶんが呼,よぶときに、聞,きかれない。","tok":[["耳","みみ"],["を"],["閉じて","とじて"],["貧しい","まずしい"],["者","もの"],["の"],["呼ぶ","よぶ"],["声","こえ"],["を"],["聞かない","きかない"],["者","もの"],["は"],["、"],["自分","じぶん"],["が"],["呼ぶ","よぶ"],["とき"],["に"],["、"],["聞かれない","きかれない"],["。"]]},{"verse":14,"text":"ひそかな贈,おくり物,ものは憤,いきどおりをなだめる、ふところのまいないは激,はげしい怒,いかりを和,やわらげる。","tok":[["ひそか"],["な"],["贈り物","おくりもの"],["は"],["憤り","いきどおり"],["を"],["なだめる"],["、"],["ふところ"],["の"],["まいない"],["は"],["激しい","はげしい"],["怒り","いかり"],["を"],["和らげる","やわらげる"],["。"]]},{"verse":15,"text":"公義,こうぎを行,おこなうことは、正,ただしい者,ものには喜,よろこびであるが、悪,あくを行,おこなう者,ものには滅,ほろびである。","tok":[["公義","こうぎ"],["を"],["行なう","おこなう"],["こと"],["は"],["、"],["正い","ただしい"],["者","もの"],["に"],["は"],["喜こびで","よろこびで"],["ある"],["が"],["、"],["悪","あく"],["を"],["行なう","おこなう"],["者","もの"],["に"],["は"],["滅び","ほろび"],["で"],["ある"],["。"]]},{"verse":16,"text":"悟,さとりの道,みちを離,はなれる人,ひとは、死人,しにんの集会,しゅうかいの中,なかにおる。","tok":[["悟り","さとり"],["の"],["道","みち"],["を"],["離れる","はなれる"],["人","ひと"],["は"],["、"],["死人","しにん"],["の"],["集会","しゅうかい"],["の"],["中","なか"],["に"],["おる"],["。"]]},{"verse":17,"text":"快楽,かいらくを好,このむ者,ものは貧,まずしい人,ひととなり、酒,さけと油,あぶらとを好,このむ者,ものは富,とむことがない。","tok":[["快楽","かいらく"],["を"],["好む","このむ"],["者","もの"],["は"],["貧しい","まずしい"],["人となり","ひととなり"],["、"],["酒","さけ"],["と"],["油","あぶら"],["と"],["を"],["好む","このむ"],["者","もの"],["は"],["富む","とむ"],["こと"],["が"],["ない"],["。"]]},{"verse":18,"text":"悪,あしき者,ものは正,ただしい者,もののあがないとなり、不信実,ふしんじつな者,ものは正,ただしい人,ひとに代,かわる。","tok":[["悪しき","あしき"],["者","もの"],["は"],["正い","ただしい"],["者","もの"],["の"],["あ"],["が"],["ない"],["と"],["なり"],["、"],["不","ふ"],["信実","しんじつ"],["な"],["者","もの"],["は"],["正い","ただしい"],["人","ひと"],["に"],["代わる","かわる"],["。"]]},{"verse":19,"text":"争,あらそい怒,いかる女,おんなと共,ともにおるよりは、荒野,あらのに住,すむほうがましだ。","tok":[["争い","あらそい"],["怒","い"],["かる"],["女","おんな"],["と"],["共","とも"],["に"],["おる"],["より"],["は"],["、"],["荒野","あら"],["のに"],["住む","すむ"],["ほう"],["が"],["まし"],["だ"],["。"]]},{"verse":20,"text":"知恵,ちえある者,ものの家,いえには尊,たっとい宝,たからがあり、愚,おろかな人,ひとはこれを、のみ尽,つくす。","tok":[["知恵","ちえ"],["ある"],["者","もの"],["の"],["家","いえ"],["に"],["は"],["尊","た"],["っと"],["い"],["宝","たから"],["が"],["あり"],["、"],["愚か","おろか"],["な"],["人","ひと"],["は"],["これ"],["を"],["、"],["のみ"],["尽くす","つくす"],["。"]]},{"verse":21,"text":"正義,せいぎといつくしみとを追,おい求,もとめる者,ものは、命,いのちと誉,ほまれとを得,える。","tok":[["正義","せいぎ"],["と"],["いつくしみ"],["と"],["を"],["追い求める","おいもとめる"],["者","もの"],["は"],["、"],["命","いのち"],["と"],["誉","ほまれ"],["と"],["を"],["得る","える"],["。"]]},{"verse":22,"text":"知恵,ちえある者,ものは強,つよい者,ものの城,しろにのぼって、その頼,たのみとするとりでをくずす。","tok":[["知恵","ちえ"],["ある"],["者","もの"],["は"],["強い","つよい"],["者","もの"],["の"],["城","しろ"],["に"],["のぼって"],["、"],["その"],["頼み","たのみ"],["と"],["する"],["とりで"],["を"],["くずす"],["。"]]},{"verse":23,"text":"口,くちと舌,したとを守,まもる者,ものはその魂,たましいを守,まもって、悩,なやみにあわせない。","tok":[["口","くち"],["と"],["舌","した"],["と"],["を"],["守者","まもるもの"],["は"],["その"],["魂","たましい"],["を"],["守って","まもって"],["、"],["悩み","なやみ"],["に"],["あわせない"],["。"]]},{"verse":24,"text":"高,たかぶりおごる者,ものを「あざける者,もの」となづける、彼,かれは高慢,こうまん無礼,ぶれいな行,おこないをするものである。","tok":[["高か","たか"],["ぶり"],["おごる"],["者","もの"],["を"],["「"],["あざける"],["者","もの"],["」"],["と"],["なづける"],["、"],["彼","かれ"],["は"],["高慢","こうまん"],["無礼","ぶれい"],["な"],["行ない","おこない"],["を"],["する"],["もの"],["で"],["ある"],["。"]]},{"verse":25,"text":"なまけ者,ものの欲望,よくぼうは自分,じぶんの身,みを殺,ころす、これはその手,てを働,はたらかせないからである。","tok":[["なまけ者","なまけもの"],["の"],["欲望","よくぼう"],["は"],["自分","じぶん"],["の"],["身","み"],["を"],["殺ろす","ころす"],["、"],["これ"],["は"],["その"],["手","て"],["を"],["働かせない","はたらかせない"],["から"],["で"],["ある"],["。"]]},{"verse":26,"text":"悪,あしき者,ものはひねもす人,ひとの物,ものをむさぼる、正,ただしい者,ものは与,あたえて惜,おしまない。","tok":[["悪しき","あしき"],["者","もの"],["は"],["ひねもす"],["人","ひと"],["の"],["物","もの"],["を"],["むさぼる"],["、"],["正い","ただしい"],["者","もの"],["は"],["与","あたえ"],["て"],["惜まない","おしまない"],["。"]]},{"verse":27,"text":"悪,あしき者,ものの供,そなえ物,ものは憎,にくまれる、悪意,あくいをもってささげる時,ときはなおさらである。","tok":[["悪しき","あしき"],["者","もの"],["の"],["供え物","そなえもの"],["は"],["憎まれる","にくまれる"],["、"],["悪意","あくい"],["を"],["もって"],["ささげる"],["時","とき"],["は"],["なおさら"],["で"],["ある"],["。"]]},{"verse":28,"text":"偽,いつわりの証人,しょうにんは滅,ほろぼされる、よく聞,きく人,ひとの言葉,ことばはすたることがない。","tok":[["偽わり","いつわり"],["の"],["証人","しょうにん"],["は"],["滅ぼされる","ほろぼされる"],["、"],["よく"],["聞く","きく"],["人","ひと"],["の"],["言葉","ことば"],["は"],["すたる"],["こと"],["が"],["ない"],["。"]]},{"verse":29,"text":"悪,あしき者,ものはあつかましくし、正,ただしい人,ひとはその道,みちをつつしむ。","tok":[["悪しき","あしき"],["者","もの"],["は"],["あつかましく"],["し"],["、"],["正い","ただしい"],["人","ひと"],["は"],["その"],["道","みち"],["を"],["つつしむ"],["。"]]},{"verse":30,"text":"主,しゅに向,むかっては知恵,ちえも悟,さとりも、計,はかりごとも、なんの役,やくにも立,たたない。","tok":[["主に","しゅに"],["向かって","むかって"],["は"],["知恵","ちえ"],["も"],["悟り","さとり"],["も"],["、"],["計り","はかり"],["ごと"],["も"],["、"],["なん"],["の"],["役","やく"],["に"],["も"],["立たない","たたない"],["。"]]},{"verse":31,"text":"戦,たたかいの日,ひのために馬,うまを備,そなえる、しかし勝利,しょうりは主,しゅによる。","tok":[["戦い","たたかい"],["の"],["日","ひ"],["の"],["ため"],["に"],["馬","うま"],["を"],["備","そなえ"],["る"],["、"],["しかし"],["勝利","しょうり"],["は"],["主に","しゅに"],["よる"],["。"]]}]
[{"verse":1,"text":"わが子,こよ、わたしの教,おしえを忘,わすれず、わたしの戒,いましめを心,こころにとめよ。","tok":[["わが"],["子","こ"],["よ"],["、"],["わたし"],["の"],["教え","おしえ"],["を"],["忘ず","わすれず"],["、"],["わたし"],["の"],["戒しめ","いましめ"],["を"],["心","こころ"],["に"],["とめよ"],["。"]]},{"verse":2,"text":"そうすれば、これはあなたの日,ひを長,ながくし、命,いのちの年,としを延,のべ、あなたに平安,へいあんを増,まし加,くわえる。","tok":[["そう"],["すれば"],["、"],["これ"],["は"],["あなた"],["の"],["日","ひ"],["を"],["長く","ながく"],["し"],["、"],["命","いのち"],["の"],["年","とし"],["を"],["延","のべ"],["、"],["あなた"],["に"],["平安","へいあん"],["を"],["増し加える","ましくわえる"],["。"]]},{"verse":3,"text":"いつくしみと、まこととを捨,すててはならない、それをあなたの首,くびに結,むすび、心,こころの碑,ひにしるせ。","tok":[["いつくしみ"],["と"],["、"],["まこと"],["と"],["を"],["捨てて","すてて"],["は"],["ならない"],["、"],["それ"],["を"],["あなた"],["の"],["首","くび"],["に"],["結び","むすび"],["、"],["心","こころ"],["の"],["碑","ひ"],["に"],["しるせ"],["。"]]},{"verse":4,"text":"そうすれば、あなたは神,かみと人,ひととの前,まえに恵,めぐみと、誉,ほまれとを得,える。","tok":[["そう"],["すれば"],["、"],["あなた"],["は"],["神","かみ"],["と"],["人","ひと"],["と"],["の"],["前","まえ"],["に"],["恵","めぐみ"],["と"],["、"],["誉","ほまれ"],["と"],["を"],["得る","える"],["。"]]},{"verse":5,"text":"心,こころをつくして主,しゅに信頼,しんらいせよ、自分,じぶんの知識,ちしきにたよってはならない。","tok":[["心","こころ"],["を"],["つくして"],["主に","しゅに"],["信頼","しんらい"],["せよ"],["、"],["自分","じぶん"],["の"],["知識","ちしき"],["に"],["たよって"],["は"],["ならない"],["。"]]},{"verse":6,"text":"すべての道,みちで主,しゅを認,みとめよ、そうすれば、主,しゅはあなたの道,みちをまっすぐにされる。","tok":[["すべて"],["の"],["道","みち"],["で"],["主","しゅ"],["を"],["認めよ","みとめよ"],["、"],["そう"],["すれば"],["、"],["主","しゅ"],["は"],["あなた"],["の"],["道","みち"],["を"],["まっすぐ"],["に"],["される"],["。"]]},{"verse":7,"text":"自分,じぶんを見,みて賢,かしこいと思,おもってはならない、主,しゅを恐,おそれて、悪,あくを離,はなれよ。","tok":[["自分","じぶん"],["を"],["見て","みて"],["賢しこい","かしこい"],["と"],["思って","おもって"],["は"],["ならない"],["、"],["主","しゅ"],["を"],["恐れて","おそれて"],["、"],["悪","あく"],["を"],["離れよ","はなれよ"],["。"]]},{"verse":8,"text":"そうすれば、あなたの身,みを健,すこやかにし、あなたの骨,ほねに元気,げんきを与,あたえる。","tok":[["そう"],["すれば"],["、"],["あなた"],["の"],["身","み"],["を"],["健やか","すこやか"],["に"],["し"],["、"],["あなた"],["の"],["骨","ほね"],["に"],["元気","げんき"],["を"],["与える","あたえる"],["。"]]},{"verse":9,"text":"あなたの財産,ざいさんと、すべての産物,さんぶつの初,はつなりをもって主,しゅをあがめよ。","tok":[["あなた"],["の"],["財産","ざいさん"],["と"],["、"],["すべて"],["の"],["産物","さんぶつ"],["の"],["初なり","はつなり"],["を"],["もって"],["主","しゅ"],["を"],["あがめよ"],["。"]]},{"verse":10,"text":"そうすれば、あなたの倉,くらは満,みちて余,あまり、あなたの酒,さかぶねは新,あたらしい酒,さけであふれる。","tok":[["そう"],["すれば"],["、"],["あなた"],["の"],["倉","くら"],["は"],["満ちて","みちて"],["余り","あまり"],["、"],["あなた"],["の"],["酒","さかぶね"],["は"],["新らしい","あたらしい"],["酒","さけ"],["で"],["あふれる"],["。"]]},{"verse":11,"text":"わが子,こよ、主,しゅの懲,こらしめを軽,かろんじてはならない、その戒,いましめをきらってはならない。","tok":[["わが"],["子","こ"],["よ"],["、"],["主","しゅ"],["の"],["懲らしめ","こらしめ"],["を"],["軽","かろんじて"],["は"],["ならない"],["、"],["その"],["戒しめ","いましめ"],["を"],["きらって"],["は"],["ならない"],["。"]]},{"verse":12,"text":"主,しゅは、愛,あいする者,ものを、戒,いましめられるからである、あたかも父,ちちがその愛,あいする子,こを戒,いましめるように。","tok":[["主","しゅ"],["は"],["、"],["愛する","あいする"],["者","もの"],["を"],["、"],["戒しめ","いましめ"],["られる"],["から"],["で"],["ある"],["、"],["あたかも"],["父","ちち"],["が"],["その"],["愛する","あいする"],["子","こ"],["を"],["戒める","いましめる"],["よう"],["に"],["。"]]},{"verse":13,"text":"知恵,ちえを求,もとめて得,える人,ひと、悟,さとりを得,える人,ひとはさいわいである。","tok":[["知恵","ちえ"],["を"],["求めて","もとめて"],["得る","える"],["人","ひと"],["、"],["悟り","さとり"],["を"],["得る","える"],["人","ひと"],["は"],["さいわい"],["で"],["ある"],["。"]]},{"verse":14,"text":"知恵,ちえによって得,えるものは、銀,ぎんによって得,えるものにまさり、その利益,りえきは精,せい金,きんよりも良,よいからである。","tok":[["知恵","ちえ"],["によって"],["得る","える"],["もの"],["は"],["、"],["銀","ぎん"],["によって"],["得る","える"],["もの"],["に"],["まさり"],["、"],["その"],["利益","りえき"],["は"],["精金","せいきん"],["より"],["も"],["良い","よい"],["から"],["で"],["ある"],["。"]]},{"verse":15,"text":"知恵,ちえは宝石,ほうせきよりも尊,たっとく、あなたの望,のぞむ何,なに物,ものも、これと比,くらべるに足,たりない。","tok":[["知恵","ちえ"],["は"],["宝石","ほうせき"],["より"],["も"],["尊","た"],["っと"],["く"],["、"],["あなた"],["の"],["望む","のぞむ"],["何","な"],["に"],["物","もの"],["も"],["、"],["これ"],["と"],["比べる","くらべる"],["に"],["足りない","たりない"],["。"]]},{"verse":16,"text":"その右,みぎの手,てには長寿,ちょうじゅがあり、左,ひだりの手,てには富,とみと、誉,ほまれがある。","tok":[["その"],["右","みぎ"],["の"],["手","て"],["に"],["は"],["長寿","ちょうじゅ"],["が"],["あり"],["、"],["左","ひだり"],["の"],["手","て"],["に"],["は"],["富","とみ"],["と"],["、"],["誉","ほまれ"],["が"],["ある"],["。"]]},{"verse":17,"text":"その道,みちは楽,たのしい道,みちであり、その道,みち筋,すじはみな平安,へいあんである。","tok":[["その"],["道","みち"],["は"],["楽い","たのしい"],["道","みち"],["で"],["あり"],["、"],["その"],["道筋","みちすじ"],["は"],["みな"],["平安","へいあん"],["で"],["ある"],["。"]]},{"verse":18,"text":"知恵,ちえは、これを捕,とらえる者,ものには命,いのちの木,きである、これをしっかり捕,とらえる人,ひとはさいわいである。","tok":[["知恵","ちえ"],["は"],["、"],["これ"],["を"],["捕らえる","とらえる"],["者","もの"],["に"],["は"],["命","いのち"],["の"],["木","き"],["で"],["ある"],["、"],["これ"],["を"],["しっかり"],["捕らえる","とらえる"],["人","ひと"],["は"],["さいわい"],["で"],["ある"],["。"]]},{"verse":19,"text":"主,しゅは知恵,ちえをもって地,ちの基,もといをすえ、悟,さとりをもって天,てんを定,さだめられた。","tok":[["主","しゅ"],["は"],["知恵","ちえ"],["を"],["もって"],["地","ち"],["の"],["基い","もとい"],["を"],["すえ"],["、"],["悟り","さとり"],["を"],["もって"],["天","てん"],["を"],["定められた","さだめられた"],["。"]]},{"verse":20,"text":"その知識,ちしきによって海,うみはわきいで、雲,くもは露,つゆをそそぐ。","tok":[["その"],["知識","ちしき"],["によって"],["海","うみ"],["は"],["わき"],["いで"],["、"],["雲","くも"],["は"],["露","つゆ"],["を"],["そそぐ"],["。"]]},{"verse":21,"text":"わが子,こよ、確,たしかな知恵,ちえと、慎,つつしみとを守,まもって、それをあなたの目,めから離,はなしてはならない。","tok":[["わが"],["子","こ"],["よ"],["、"],["確か","たしか"],["な"],["知恵","ちえ"],["と"],["、"],["慎しみ","つつしみ"],["と"],["を"],["守って","まもって"],["、"],["それ"],["を"],["あなた"],["の"],["目","め"],["から"],["離して","はなして"],["は"],["ならない"],["。"]]},{"verse":22,"text":"それはあなたの魂,たましいの命,いのちとなりあなたの首,くびの飾,かざりとなる。","tok":[["それ"],["は"],["あなた"],["の"],["魂","たましい"],["の"],["命","いのち"],["と"],["なり"],["あなた"],["の"],["首","くび"],["の"],["飾","かざり"],["と"],["なる"],["。"]]},{"verse":23,"text":"こうして、あなたは安,やすらかに自分,じぶんの道,みちを行,いき、あなたの足,あしはつまずくことがない。","tok":[["こう"],["して"],["、"],["あなた"],["は"],["安らか","やすらか"],["に"],["自分","じぶん"],["の"],["道","みち"],["を"],["行き","いき"],["、"],["あなた"],["の"],["足","あし"],["は"],["つまずく"],["こと"],["が"],["ない"],["。"]]},{"verse":24,"text":"あなたは座,ざしているとき、恐,おそれることはなく、伏,ふすとき、あなたの眠,ねむりはここちよい。","tok":[["あなた"],["は"],["座して","ざして"],["いる"],["とき"],["、"],["恐れる","おそれる"],["こと"],["は"],["なく"],["、"],["伏す","ふす"],["とき"],["、"],["あなた"],["の"],["眠","ねむり"],["は"],["ここちよい"],["。"]]},{"verse":25,"text":"あなたはにわかに起,おこる恐怖,きょうふを恐,おそれることなく、悪,あしき者,ものの滅,ほろびが来,きても、それを恐,おそれることはない。","tok":[["あなた"],["は"],["にわか"],["に"],["起こる","おこる"],["恐怖","きょうふ"],["を"],["恐れる","おそれる"],["こと"],["なく"],["、"],["悪しき","あしき"],["者","もの"],["の"],["滅び","ほろび"],["が"],["来て","きて"],["も"],["、"],["それ"],["を"],["恐れる","おそれる"],["こと"],["は"],["ない"],["。"]]},{"verse":26,"text":"これは、主,しゅがあなたの信頼,しんらいする者,ものであり、あなたの足,あしを守,まもって、わなに捕,とらわれさせられないからである。","tok":[["これ"],["は"],["、"],["主","しゅ"],["が"],["あなた"],["の"],["信頼","しんらい"],["する"],["者","もの"],["で"],["あり"],["、"],["あなた"],["の"],["足","あし"],["を"],["守って","まもって"],["、"],["わな"],["に"],["捕らわれさせられない","とらわれさせられない"],["から"],["で"],["ある"],["。"]]},{"verse":27,"text":"あなたの手,てに善,ぜんをなす力,ちからがあるならば、これをなすべき人,ひとになすことをさし控,ひかえてはならない。","tok":[["あなた"],["の"],["手","て"],["に"],["善","ぜん"],["を"],["なす"],["力","ちから"],["が"],["あるならば"],["、"],["これ"],["を"],["なすべき"],["人","ひと"],["に"],["なす"],["こと"],["を"],["さし"],["控","ひかえ"],["ては"],["ならない"],["。"]]},{"verse":28,"text":"あなたが物,ものを持,もっている時,とき、その隣,となり人,びとに向,むかい、「去,さって、また来,きなさい。あす、それをあげよう」と言,いってはならない。","tok":[["あなた"],["が"],["物","もの"],["を"],["持って","もって"],["いる"],["時","とき"],["、"],["その"],["隣人","となりびと"],["に"],["向","むかい"],["、"],["「"],["去て","さって"],["、"],["また"],["来","き"],["なさい"],["。"],["あす"],["、"],["それ"],["を"],["あげよう"],["」"],["と"],["言って","いって"],["は"],["ならない"],["。"]]},{"verse":29,"text":"あなたの隣,となり人,びとがかたわらに安,やすらかに住,すんでいる時,とき、これに向,むかって、悪,あくを計,はかってはならない。","tok":[["あなた"],["の"],["隣人","となりび"],["と"],["が"],["かたわら"],["に"],["安らか","やすらか"],["に"],["住んで","すんで"],["いる"],["時","とき"],["、"],["これ"],["に"],["向かって","むかって"],["、"],["悪","あく"],["を"],["計って","はかって"],["は"],["ならない"],["。"]]},{"verse":30,"text":"もし人,ひとがあなたに悪,あくを行,おこなったのでなければ、ゆえなく、これと争,あらそってはならない。","tok":[["もし"],["人","ひと"],["が"],["あなた"],["に"],["悪","あく"],["を"],["行なった","おこなった"],["ので"],["なければ"],["、"],["ゆえ"],["なく"],["、"],["これ"],["と"],["争って","あらそって"],["は"],["ならない"],["。"]]},{"verse":31,"text":"暴虐,ぼうぎゃくな人,ひとを、うらやんではならない、そのすべての道,みちを選,えらんではならない。","tok":[["暴虐","ぼうぎゃく"],["な"],["人","ひと"],["を"],["、"],["うらやんで"],["は"],["ならない"],["、"],["その"],["すべて"],["の"],["道","みち"],["を"],["選らんで","えらんで"],["は"],["ならない"],["。"]]},{"verse":32,"text":"よこしまな者,ものは主,しゅに憎,にくまれるからである、しかし、正,ただしい者,ものは主,しゅに信任,しんにんされる。","tok":[["よこしま"],["な"],["者","もの"],["は"],["主に","しゅに"],["憎まれる","にくまれる"],["から"],["で"],["ある"],["、"],["しかし"],["、"],["正い","ただしい"],["者","もの"],["は"],["主に","しゅに"],["信任","しんにん"],["される"],["。"]]},{"verse":33,"text":"主,しゅの、のろいは悪,あしき者,ものの家,いえにある、しかし、正,ただしい人,ひとのすまいは主,しゅに恵,めぐまれる。","tok":[["主","しゅ"],["の"],["、"],["のろい"],["は"],["悪しき","あしき"],["者","もの"],["の"],["家","いえ"],["に"],["ある"],["、"],["しかし"],["、"],["正い","ただしい"],["人","ひと"],["の"],["すまい"],["は"],["主に","しゅに"],["恵まれる","めぐまれる"],["。"]]},{"verse":34,"text":"彼,かれはあざける者,ものをあざけり、へりくだる者,ものに恵,めぐみを与,あたえられる。","tok":[["彼","かれ"],["は"],["あざける"],["者","もの"],["を"],["あざけり"],["、"],["へりくだる"],["者","もの"],["に"],["恵","めぐみ"],["を"],["与えられる","あたえられる"],["。"]]},{"verse":35,"text":"知恵,ちえある者,ものは、誉,ほまれを得,える、しかし、愚,おろかな者,ものははずかしめを得,える。","tok":[["知恵","ちえ"],["ある"],["者","もの"],["は"],["、"],["誉","ほまれ"],["を"],["得る","える"],["、"],["しかし"],["、"],["愚か","おろか"],["な"],["者","もの"],["は"],["はずかしめ"],["を"],["得る","える"],["。"]]}]
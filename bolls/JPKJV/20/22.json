[{"verse":1,"text":"令名,れいめいは大,おおいなる富,とみにまさり、恩恵,おんけいは銀,ぎんや金,きんよりも良,よい。","tok":[["令名","れいめい"],["は"],["大いなる","おおいなる"],["富","とみ"],["に"],["まさり"],["、"],["恩恵","おんけい"],["は"],["銀","ぎん"],["や"],["金","きん"],["より"],["も"],["良い","よい"],["。"]]},{"verse":2,"text":"富,とめる者,ものと貧,まずしい者,ものとは共,ともに世,よにおる、すべてこれを造,つくられたのは主,しゅである。","tok":[["富める","とめる"],["者","もの"],["と"],["貧しい","まずしい"],["者","もの"],["と"],["は"],["共","とも"],["に"],["世","よ"],["に"],["おる"],["、"],["すべて"],["これ"],["を"],["造られた","つくられた"],["の"],["は"],["主","しゅ"],["で"],["ある"],["。"]]},{"verse":3,"text":"賢,かしこい者,ものは災,わざわいを見,みて自,みずから避,さけ、思慮,しりょのない者,ものは進,すすんでいって、罰,ばつをうける。","tok":[["賢しこい","かしこい"],["者","もの"],["は"],["災","わざわい"],["を"],["見て","みて"],["自から","みずから"],["避け","さけ"],["、"],["思慮","しりょ"],["の"],["ない"],["者","もの"],["は"],["進んで","すすんで"],["いって"],["、"],["罰","ばつ"],["を"],["うける"],["。"]]},{"verse":4,"text":"謙遜,けんそんと主,しゅを恐,おそれることとの報,むくいは、富,とみと誉,ほまれと命,いのちとである。","tok":[["謙遜","けんそん"],["と"],["主","しゅ"],["を"],["恐れる","おそれる"],["こと"],["と"],["の"],["報い","むくい"],["は"],["、"],["富","とみ"],["と"],["誉","ほまれ"],["と"],["命","いのち"],["と"],["で"],["ある"],["。"]]},{"verse":5,"text":"よこしまな者,ものの道,みちにはいばらとわながあり、たましいを守,まもる者,ものは遠,とおくこれを離,はなれる。","tok":[["よこしま"],["な"],["者","もの"],["の"],["道","みち"],["に"],["は"],["いばら"],["と"],["わな"],["が"],["あり"],["、"],["たましい"],["を"],["守者","まもるもの"],["は"],["遠く","とおく"],["これ"],["を"],["離れる","はなれる"],["。"]]},{"verse":6,"text":"子,こをその行,いくべき道,みちに従,したがって教,おしえよ、そうすれば年老,としおいても、それを離,はなれることがない。","tok":[["子","こ"],["を"],["その"],["行くべき","いくべき"],["道","みち"],["に"],["従って","したがって"],["教えよ","おしえよ"],["、"],["そう"],["すれば"],["年老いて","としおいて"],["も"],["、"],["それ"],["を"],["離れる","はなれる"],["こと"],["が"],["ない"],["。"]]},{"verse":7,"text":"富,とめる者,ものは貧,まずしき者,ものを治,おさめ、借,かりる者,ものは貸,かす人,ひとの奴隷,どれいとなる。","tok":[["富める","とめる"],["者","もの"],["は"],["貧しき","まずしき"],["者","もの"],["を"],["治め","おさめ"],["、"],["借りる","かりる"],["者","もの"],["は"],["貸す","かす"],["人","ひと"],["の"],["奴隷","どれい"],["と"],["なる"],["。"]]},{"verse":8,"text":"悪,あくをまく者,ものは災,わざわいを刈,かり、その怒,いかりのつえはすたれる。","tok":[["悪","あく"],["を"],["まく"],["者","もの"],["は"],["災","わざわい"],["を"],["刈","かり"],["、"],["その"],["怒り","いかり"],["の"],["つえ"],["は"],["すたれる"],["。"]]},{"verse":9,"text":"人,ひとを見,みて恵,めぐむ者,ものはめぐまれる、自分,じぶんのパンを貧,まずしい人,ひとに与,あたえるからである。","tok":[["人","ひと"],["を"],["見て","みて"],["恵む","めぐむ"],["者","もの"],["は"],["めぐまれる"],["、"],["自分","じぶん"],["の"],["パン"],["を"],["貧しい","まずしい"],["人","ひと"],["に"],["与える","あたえる"],["から"],["で"],["ある"],["。"]]},{"verse":10,"text":"あざける者,ものを追放,ついほうすれば争,あらそいもまた去,さり、かつ、いさかいも、はずかしめもなくなる。","tok":[["あざける"],["者","もの"],["を"],["追放","ついほう"],["すれば"],["争い","あらそい"],["も"],["また"],["去り","さり"],["、"],["かつ"],["、"],["いさかい"],["も"],["、"],["はずかしめ"],["も"],["なくなる"],["。"]]},{"verse":11,"text":"心,こころの潔白,けっぱくを愛,あいする者,もの、その言葉,ことばの上品,じょうひんな者,ものは、王,おうがその友,ともとなる。","tok":[["心","こころ"],["の"],["潔白","けっぱく"],["を"],["愛する","あいする"],["者","もの"],["、"],["その"],["言葉","ことば"],["の"],["上品","じょうひん"],["な"],["者","もの"],["は"],["、"],["王","おう"],["が"],["その"],["友","とも"],["と"],["なる"],["。"]]},{"verse":12,"text":"主,しゅの目,めは知識,ちしきある者,ものを守,まもる、しかし主,しゅは不信実,ふしんじつな者,ものの言葉,ことばを敗,やぶられる。","tok":[["主","しゅ"],["の"],["目","め"],["は"],["知識","ちしき"],["ある"],["者","もの"],["を"],["守","まもる"],["、"],["しかし"],["主","しゅ"],["は"],["不","ふ"],["信実","しんじつ"],["な"],["者","もの"],["の"],["言葉","ことば"],["を"],["敗られる","やぶられる"],["。"]]},{"verse":13,"text":"なまけ者,ものは言,いう、「ししがそとにいる、わたしは、ちまたで殺,ころされる」と。","tok":[["なまけ者","なまけもの"],["は"],["言う","いう"],["、"],["「"],["しし"],["が"],["そと"],["に"],["いる"],["、"],["わたし"],["は"],["、"],["ちまた"],["で"],["殺ろされる","ころされる"],["」"],["と"],["。"]]},{"verse":14,"text":"遊女,ゆうじょの口,くちは深,ふかい落,おとし穴,あなである、主,しゅに憎,にくまれる者,ものはその中,なかに陥,おちいる。","tok":[["遊女","ゆうじょ"],["の"],["口","くち"],["は"],["深","ふ"],["かい"],["落とし穴","おとしあな"],["で"],["ある"],["、"],["主に","しゅに"],["憎まれる","にくまれる"],["者","もの"],["は"],["その"],["中","なか"],["に"],["陥ち","おち"],["いる"],["。"]]},{"verse":15,"text":"愚,おろかなことが子供,こどもの心,こころの中,なかにつながれている、懲,こらしめのむちは、これを遠,とおく追,おいだす。","tok":[["愚か","おろか"],["な"],["こと"],["が"],["子供","こども"],["の"],["心","こころ"],["の"],["中","なか"],["に"],["つながれて"],["いる"],["、"],["懲らしめ","こらしめ"],["の"],["むち"],["は"],["、"],["これ"],["を"],["遠く","とおく"],["追いだす","おいだす"],["。"]]},{"verse":16,"text":"貧,まずしい者,ものをしえたげて自分,じぶんの富,とみを増,まそうとする者,ものと、富,とめる者,ものに与,あたえる者,ものとは、ついに必,かならず貧,まずしくなる。","tok":[["貧しい","まずしい"],["者","もの"],["を"],["し"],["えたげて"],["自分","じぶん"],["の"],["富","とみ"],["を"],["増そう","まそう"],["と"],["する"],["者","もの"],["と"],["、"],["富める","とめる"],["者","もの"],["に"],["与える","あたえる"],["者","もの"],["と"],["は"],["、"],["ついに"],["必","かならず"],["貧しく","まずしく"],["なる"],["。"]]},{"verse":17,"text":"あなたの耳,みみを傾,かたむけて知恵,ちえある者,ものの言葉,ことばを聞,きき、かつ、わたしの知識,ちしきにあなたの心,こころを用,もちいよ。","tok":[["あなた"],["の"],["耳","みみ"],["を"],["傾むけて","かたむけて"],["知恵","ちえ"],["ある"],["者","もの"],["の"],["言葉","ことば"],["を"],["聞","きき"],["、"],["かつ"],["、"],["わたし"],["の"],["知識","ちしき"],["に"],["あなた"],["の"],["心","こころ"],["を"],["用い","もちい"],["よ"],["。"]]},{"verse":18,"text":"これをあなたのうちに保,たもち、ことごとく、あなたのくちびるに備,そなえておくなら、楽,たのしいことである。","tok":[["これ"],["を"],["あなた"],["の"],["うち"],["に"],["保ち","たもち"],["、"],["ことごとく"],["、"],["あなた"],["の"],["くちびる"],["に"],["備","そなえ"],["て"],["おくなら"],["、"],["楽い","たのしい"],["こと"],["で"],["ある"],["。"]]},{"verse":19,"text":"あなたが主,しゅに、寄,より頼,たのむことのできるように、わたしはきょう、これをあなたにも教,おしえる。","tok":[["あなた"],["が"],["主に","しゅに"],["、"],["寄り","より"],["頼む","たのむ"],["こと"],["の"],["できる"],["よう"],["に"],["、"],["わたし"],["は"],["きょう"],["、"],["これ"],["を"],["あなた"],["に"],["も"],["教える","おしえる"],["。"]]},{"verse":20,"text":"わたしは、勧,すすめと知識,ちしきとの三十の言葉,ことばをあなたのためにしるしたではないか。","tok":[["わたし"],["は"],["、"],["勧め","すすめ"],["と"],["知識","ちしき"],["と"],["の"],["三十","さんじゅう"],["の"],["言葉","ことば"],["を"],["あなた"],["の"],["ため"],["に"],["しるしたで"],["は"],["ない"],["か"],["。"]]},{"verse":21,"text":"それは正,ただしいこと、真実,しんじつなことをあなたに示,しめし、あなたをつかわした者,ものに真実,しんじつの答,こたえをさせるためであった。","tok":[["それ"],["は"],["正い","ただしい"],["こと"],["、"],["真実","しんじつ"],["な"],["こと"],["を"],["あなた"],["に"],["示めし","しめし"],["、"],["あなた"],["を"],["つかわした"],["者","もの"],["に"],["真実","しんじつ"],["の"],["答","こたえ"],["を"],["させる"],["ため"],["で"],["あった"],["。"]]},{"verse":22,"text":"貧,まずしい者,ものを、貧,まずしいゆえに、かすめてはならない、悩,なやむ者,ものを、町,まちの門,もんでおさえつけてはならない。","tok":[["貧しい","まずしい"],["者","もの"],["を"],["、"],["貧しい","まずしい"],["ゆえ"],["に"],["、"],["かすめて"],["は"],["ならない"],["、"],["悩む","なやむ"],["者","もの"],["を"],["、"],["町","まち"],["の"],["門","もん"],["で"],["おさえつけて"],["は"],["ならない"],["。"]]},{"verse":23,"text":"それは主,しゅが彼,かれらの訴,うったえをただし、かつ彼,かれらをそこなう者,ものの命,いのちを、そこなわれるからである。","tok":[["それ"],["は"],["主","しゅ"],["が"],["彼","かれ"],["ら"],["の"],["訴","うったえ"],["を"],["ただし"],["、"],["かつ"],["彼","かれ"],["ら"],["を"],["そこなう"],["者","もの"],["の"],["命","いのち"],["を"],["、"],["そこなわれる"],["から"],["で"],["ある"],["。"]]},{"verse":24,"text":"怒,いかる者,ものと交,まじわるな、憤,いきどおる人,ひとと共,ともに行,いくな。","tok":[["怒","い"],["かる"],["者","もの"],["と"],["交じわる","まじわる"],["な"],["、"],["憤る","いきどおる"],["人","ひと"],["と"],["共","とも"],["に"],["行く","いく"],["な"],["。"]]},{"verse":25,"text":"それはあなたがその道,みちにならって、みずから、わなに陥,おちいることのないためである。","tok":[["それ"],["は"],["あなた"],["が"],["その"],["道","みち"],["に"],["ならって"],["、"],["みずから"],["、"],["わな"],["に"],["陥ち","おち"],["いる"],["こと"],["の"],["ない"],["ため"],["で"],["ある"],["。"]]},{"verse":26,"text":"あなたは人,ひとと手,てを打,うつ者,ものとなってはならない、人,ひとの負債,ふさいの保証,ほしょうをしてはならない。","tok":[["あなた"],["は"],["人","ひと"],["と"],["手","て"],["を"],["打つ","うつ"],["者","もの"],["と"],["なって"],["は"],["ならない"],["、"],["人","ひと"],["の"],["負債","ふさい"],["の"],["保証","ほしょう"],["を"],["して"],["は"],["ならない"],["。"]]},{"verse":27,"text":"あなたが償,つぐなうものがないとき、あなたの寝,ねている寝床,ねどこまでも、人,ひとが奪,うばい取,とってよかろうか。","tok":[["あなた"],["が"],["償なう","つぐなう"],["もの"],["が"],["ない"],["とき"],["、"],["あなた"],["の"],["寝て","ねて"],["いる"],["寝床","ねどこ"],["まで"],["も"],["、"],["人","ひと"],["が"],["奪い取って","うばいとって"],["よかろう"],["か"],["。"]]},{"verse":28,"text":"あなたの先祖,せんぞが立,たてた古,ふるい地境,じざかいを移,うつしてはならない。","tok":[["あなた"],["の"],["先祖","せんぞ"],["が"],["立てた","たてた"],["古い","ふるい"],["地境","じざかい"],["を"],["移して","うつして"],["は"],["ならない"],["。"]]},{"verse":29,"text":"あなたはそのわざに巧,たくみな人,ひとを見,みるか、そのような人,ひとは王,おうの前,まえに立,たつが、卑,いやしい人々,ひとびとの前,まえには立,たたない。","tok":[["あなた"],["は"],["その"],["わざ"],["に"],["巧み","たくみ"],["な"],["人","ひと"],["を"],["見る","みる"],["か"],["、"],["その"],["よう"],["な"],["人","ひと"],["は"],["王","おう"],["の"],["前","まえ"],["に"],["立つ","たつ"],["が"],["、"],["卑しい","いやしい"],["人々","ひとびと"],["の"],["前","まえ"],["に"],["は"],["立たない","たたない"],["。"]]}]
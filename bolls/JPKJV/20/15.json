[{"verse":1,"text":"柔,やわらかい答,こたえは憤,いきどおりをとどめ、激,はげしい言葉,ことばは怒,いかりをひきおこす。","tok":[["柔らかい","やわらかい"],["答","こたえ"],["は"],["憤り","いきどおり"],["を"],["とどめ"],["、"],["激しい","はげしい"],["言葉","ことば"],["は"],["怒り","いかり"],["を"],["ひきおこす"],["。"]]},{"verse":2,"text":"知恵,ちえある者,ものの舌,したは知識,ちしきをわかち与,あたえ、愚,おろかな者,ものの口,くちは愚,おろかを吐,はき出,だす。","tok":[["知恵","ちえ"],["ある"],["者","もの"],["の"],["舌","した"],["は"],["知識","ちしき"],["を"],["わかち"],["与","あたえ"],["、"],["愚か","おろか"],["な"],["者","もの"],["の"],["口","くち"],["は"],["愚か","おろか"],["を"],["吐出す","はきだす"],["。"]]},{"verse":3,"text":"主,しゅの目,めはどこにでもあって、悪人,あくにんと善人,ぜんにんとを見張,みはっている。","tok":[["主","しゅ"],["の"],["目","め"],["は"],["どこ"],["に"],["で"],["も"],["あって"],["、"],["悪人","あくにん"],["と"],["善人","ぜんにん"],["と"],["を"],["見張って","みはって"],["いる"],["。"]]},{"verse":4,"text":"優,やさしい舌,したは命,いのちの木,きである、乱暴,らんぼうな言葉,ことばは魂,たましいを傷,きずつける。","tok":[["優しい","やさしい"],["舌","した"],["は"],["命","いのち"],["の"],["木","き"],["で"],["ある"],["、"],["乱暴","らんぼう"],["な"],["言葉","ことば"],["は"],["魂","たましい"],["を"],["傷つける","きずつける"],["。"]]},{"verse":5,"text":"愚,おろかな者,ものは父,ちちの教訓,きょうくんを軽,かろんじる、戒,いましめを守,まもる者,ものは賢,かしこい者,ものである。","tok":[["愚か","おろか"],["な"],["者","もの"],["は"],["父","ちち"],["の"],["教訓","きょうくん"],["を"],["軽んじる","かろんじる"],["、"],["戒しめ","いましめ"],["を"],["守者","まもるもの"],["は"],["賢しこい","かしこい"],["者","もの"],["で"],["ある"],["。"]]},{"verse":6,"text":"正,ただしい者,ものの家,いえには多,おおくの宝,たからがある、悪,あしき者,ものの所得,しょとくには煩,わずらいがある。","tok":[["正い","ただしい"],["者","もの"],["の"],["家","いえ"],["に"],["は"],["多く","おおく"],["の"],["宝","たから"],["が"],["ある"],["、"],["悪しき","あしき"],["者","もの"],["の"],["所得","しょとく"],["に"],["は"],["煩い","わずらい"],["が"],["ある"],["。"]]},{"verse":7,"text":"知恵,ちえある者,もののくちびるは知識,ちしきをひろめる、愚,おろかな者,ものの心,こころはそうでない。","tok":[["知恵","ちえ"],["ある"],["者","もの"],["の"],["くちびる"],["は"],["知識","ちしき"],["を"],["ひろめる"],["、"],["愚か","おろか"],["な"],["者","もの"],["の"],["心","こころ"],["は"],["そう"],["で"],["ない"],["。"]]},{"verse":8,"text":"悪,あしき者,ものの供,そなえ物,ものは主,しゅに憎,にくまれ、正,ただしい者,ものの祈,いのりは彼,かれに喜,よろこばれる。","tok":[["悪しき","あしき"],["者","もの"],["の"],["供え物","そなえもの"],["は"],["主に","しゅに"],["憎まれ","にくまれ"],["、"],["正い","ただしい"],["者","もの"],["の"],["祈","いのり"],["は"],["彼","かれ"],["に"],["喜こばれる","よろこばれる"],["。"]]},{"verse":9,"text":"悪,あしき者,ものの道,みちは主,しゅに憎,にくまれ、正義,せいぎを求,もとめる者,ものは彼,かれに愛,あいせられる。","tok":[["悪しき","あしき"],["者","もの"],["の"],["道","みち"],["は"],["主に","しゅに"],["憎まれ","にくまれ"],["、"],["正義","せいぎ"],["を"],["求める","もとめる"],["者","もの"],["は"],["彼","かれ"],["に"],["愛せられる","あいせられる"],["。"]]},{"verse":10,"text":"道,みちを捨,すてる者,ものには、きびしい懲,こらしめがあり、戒,いましめを憎,にくむ者,ものは死,しに至,いたる。","tok":[["道","みち"],["を"],["捨てる","すてる"],["者","もの"],["に"],["は"],["、"],["きびしい"],["懲らしめ","こらしめ"],["が"],["あり"],["、"],["戒しめ","いましめ"],["を"],["憎む","にくむ"],["者","もの"],["は"],["死","し"],["に"],["至る","いたる"],["。"]]},{"verse":11,"text":"陰府,よみと滅,ほろびとは主,しゅの目,めの前,まえにあり、人,ひとの心,こころはなおさらである。","tok":[["陰府","よみ"],["と"],["滅び","ほろび"],["と"],["は"],["主","しゅ"],["の"],["目","め"],["の"],["前","まえ"],["に"],["あり"],["、"],["人","ひと"],["の"],["心","こころ"],["は"],["なおさら"],["で"],["ある"],["。"]]},{"verse":12,"text":"あざける者,ものは戒,いましめられることを好,このまない、また知恵,ちえある者,ものに近,ちかづかない。","tok":[["あざける"],["者","もの"],["は"],["戒しめ","いましめ"],["られる"],["こと"],["を"],["好まない","このまない"],["、"],["また"],["知恵","ちえ"],["ある"],["者","もの"],["に"],["近づかない","ちかづかない"],["。"]]},{"verse":13,"text":"心,こころに楽,たのしみがあれば顔色,かおいろも喜,よろこばしい、心,こころに憂,うれいがあれば気,きはふさぐ。","tok":[["心","こころ"],["に"],["楽み","たのしみ"],["が"],["あれば"],["顔色","かおいろ"],["も"],["喜こば","よろこば"],["しい"],["、"],["心","こころ"],["に"],["憂","うれい"],["が"],["あれば"],["気","き"],["は"],["ふさぐ"],["。"]]},{"verse":14,"text":"さとき者,ものの心,こころは知識,ちしきをたずね、愚,おろかな者,ものの口,くちは愚,おろかさを食物,しょくもつとする。","tok":[["さ"],["とき"],["者","もの"],["の"],["心","こころ"],["は"],["知識","ちしき"],["を"],["たずね"],["、"],["愚か","おろか"],["な"],["者","もの"],["の"],["口","くち"],["は"],["愚か","おろか"],["さ"],["を"],["食物","しょくもつ"],["と"],["する"],["。"]]},{"verse":15,"text":"悩,なやんでいる者,ものの日,ひ々はことごとくつらく、心,こころの楽,たのしい人,ひとは常,つねに宴会,えんかいをもつ。","tok":[["悩","な"],["やんで"],["いる"],["者","もの"],["の"],["日々","ひ々"],["は"],["ことごとく"],["つらく"],["、"],["心","こころ"],["の"],["楽い","たのしい"],["人","ひと"],["は"],["常","つね"],["に"],["宴会","えんかい"],["を"],["もつ"],["。"]]},{"verse":16,"text":"少,すこしの物,ものを所有,しょゆうして主,しゅを恐,おそれるのは、多,おおくの宝,たからをもって苦,く労,ろうするのにまさる。","tok":[["少し","すこし"],["の"],["物","もの"],["を"],["所有","しょゆう"],["して"],["主","しゅ"],["を"],["恐れる","おそれる"],["の"],["は"],["、"],["多く","おおく"],["の"],["宝","たから"],["を"],["もって"],["苦労","くろう"],["する"],["のに"],["まさる"],["。"]]},{"verse":17,"text":"野菜,やさいを食,たべて互,たがいに愛,あいするのは、肥,こえた牛,うしを食,たべて互,たがいに憎,にくむのにまさる。","tok":[["野菜","やさい"],["を"],["食べて","たべて"],["互","たがい"],["に"],["愛する","あいする"],["の"],["は"],["、"],["肥","こえ"],["た"],["牛","うし"],["を"],["食べて","たべて"],["互","たがい"],["に"],["憎む","にくむ"],["のに"],["まさる"],["。"]]},{"verse":18,"text":"憤,いきどおりやすい者,ものは争,あらそいをおこし、怒,いかりをおそくする者,ものは争,あらそいをとどめる。","tok":[["憤り","いきどおり"],["やすい"],["者","もの"],["は"],["争い","あらそい"],["を"],["おこし"],["、"],["怒り","いかり"],["を"],["おそく"],["する"],["者","もの"],["は"],["争い","あらそい"],["を"],["とどめる"],["。"]]},{"verse":19,"text":"なまけ者,ものの道,みちには、いばらがはえしげり、正,ただしい者,ものの道,みちは平,たいらかである。","tok":[["なまけ者","なまけもの"],["の"],["道","みち"],["に"],["は"],["、"],["いばら"],["が"],["は"],["え"],["しげり"],["、"],["正い","ただしい"],["者","もの"],["の"],["道","みち"],["は"],["平か","たいらか"],["で"],["ある"],["。"]]},{"verse":20,"text":"知恵,ちえある子,こは父,ちちを喜,よろこばせる、愚,おろかな人,ひとはその母,ははを軽,かろんじる。","tok":[["知恵","ちえ"],["ある"],["子","こ"],["は"],["父","ちち"],["を"],["喜こばせる","よろこばせる"],["、"],["愚か","おろか"],["な"],["人","ひと"],["は"],["その"],["母","はは"],["を"],["軽んじる","かろんじる"],["。"]]},{"verse":21,"text":"無知,むちな者,ものは愚,おろかなことを喜,よろこび、さとき者,ものはまっすぐに歩,あゆむ。","tok":[["無知","むち"],["な"],["者","もの"],["は"],["愚か","おろか"],["な"],["こと"],["を"],["喜こび","よろこび"],["、"],["さ"],["とき"],["者","もの"],["は"],["まっすぐ"],["に"],["歩む","あゆむ"],["。"]]},{"verse":22,"text":"相,あいはかることがなければ、計画,けいかくは破,やぶれる、はかる者,ものが多,おおければ、それは必,かならず成,なる。","tok":[["相","あい"],["はかる"],["こと"],["が"],["なければ"],["、"],["計画","けいかく"],["は"],["破れる","やぶれる"],["、"],["はかる"],["者","もの"],["が"],["多ければ","おおければ"],["、"],["それ"],["は"],["必","かならず"],["成る","なる"],["。"]]},{"verse":23,"text":"人,ひとは口,くちから出,でる好,このましい答,こたえによって喜,よろこびを得,える、時,ときにかなった言葉,ことばは、いかにも良,よいものだ。","tok":[["人","ひと"],["は"],["口","くち"],["から"],["出る","でる"],["好しい","このましい"],["答","こたえ"],["によって"],["喜こび","よろこび"],["を"],["得る","える"],["、"],["時","とき"],["に"],["かなった"],["言葉","ことば"],["は"],["、"],["いかに"],["も"],["良い","よい"],["もの"],["だ"],["。"]]},{"verse":24,"text":"知恵,ちえある人,ひとの道,みちは上,のぼって命,いのちに至,いたる、こうしてその人,ひとは下,したにある陰府,よみを離,はなれる。","tok":[["知恵","ちえ"],["ある"],["人","ひと"],["の"],["道","みち"],["は"],["上って","のぼって"],["命","いのち"],["に"],["至る","いたる"],["、"],["こう"],["して"],["その"],["人","ひと"],["は"],["下","した"],["に"],["ある"],["陰府","よみ"],["を"],["離れる","はなれる"],["。"]]},{"verse":25,"text":"主,しゅは高,たかぶる者,ものの家,いえを滅,ほろぼし、やもめの地境,じざかいを定,さだめられる。","tok":[["主","しゅ"],["は"],["高か","たか"],["ぶる"],["者","もの"],["の"],["家","いえ"],["を"],["滅ぼし","ほろぼし"],["、"],["やもめ"],["の"],["地境","じざかい"],["を"],["定められる","さだめられる"],["。"]]},{"verse":26,"text":"悪人,あくにんの計,はかりごとは主,しゅに憎,にくまれ、潔白,けっぱくな人,ひとの言葉,ことばは彼,かれに喜,よろこばれる。","tok":[["悪人","あくにん"],["の"],["計り","はかり"],["ごと"],["は"],["主に","しゅに"],["憎まれ","にくまれ"],["、"],["潔白","けっぱく"],["な"],["人","ひと"],["の"],["言葉","ことば"],["は"],["彼","かれ"],["に"],["喜こばれる","よろこばれる"],["。"]]},{"verse":27,"text":"不正,ふせいな利,りをむさぼる者,ものはその家,いえを煩,わずらわせる、まいないを憎,にくむ者,ものは生,いきながらえる。","tok":[["不正","ふせい"],["な"],["利","り"],["を"],["むさぼる"],["者","もの"],["は"],["その"],["家","いえ"],["を"],["煩わせる","わずらわせる"],["、"],["まいない"],["を"],["憎む","にくむ"],["者","もの"],["は"],["生きながらえる","いきながらえる"],["。"]]},{"verse":28,"text":"正,ただしい者,ものの心,こころは答,こたえるべきことを考,かんがえる、悪,あしき者,ものの口,くちは悪,あくを吐,はき出,だす。","tok":[["正い","ただしい"],["者","もの"],["の"],["心","こころ"],["は"],["答","こたえ"],["るべき"],["こと"],["を"],["考","かんがえ"],["る"],["、"],["悪しき","あしき"],["者","もの"],["の"],["口","くち"],["は"],["悪","あく"],["を"],["吐出す","はきだす"],["。"]]},{"verse":29,"text":"主,しゅは悪,あしき者,ものに遠,とおざかり、正,ただしい者,ものの祈,いのりを聞,きかれる。","tok":[["主","しゅ"],["は"],["悪しき","あしき"],["者","もの"],["に"],["遠ざかり","とおざかり"],["、"],["正い","ただしい"],["者","もの"],["の"],["祈","いのり"],["を"],["聞かれる","きかれる"],["。"]]},{"verse":30,"text":"目,めの光,ひかりは心,こころを喜,よろこばせ、よい知,しらせは骨,ほねを潤,うるおす。","tok":[["目","め"],["の"],["光","ひかり"],["は"],["心","こころ"],["を"],["喜こばせ","よろこばせ"],["、"],["よい"],["知らせ","しらせ"],["は"],["骨","ほね"],["を"],["潤おす","うるおす"],["。"]]},{"verse":31,"text":"ためになる戒,いましめを聞,きく耳,みみをもつ者,ものは、知恵,ちえある者,ものの中,なかにとどまる。","tok":[["ため"],["に"],["なる"],["戒しめ","いましめ"],["を"],["聞く","きく"],["耳","みみ"],["を"],["もつ"],["者","もの"],["は"],["、"],["知恵","ちえ"],["ある"],["者","もの"],["の"],["中","なか"],["に"],["とどまる"],["。"]]},{"verse":32,"text":"教訓,きょうくんを捨,すてる者,ものはおのれの命,いのちを軽,かろんじ、戒,いましめを重,おもんじる者,ものは悟,さとりを得,える。","tok":[["教訓","きょうくん"],["を"],["捨てる","すてる"],["者","もの"],["は"],["おのれ"],["の"],["命","いのち"],["を"],["軽んじ","かろんじ"],["、"],["戒しめ","いましめ"],["を"],["重じる","おもんじる"],["者","もの"],["は"],["悟り","さとり"],["を"],["得る","える"],["。"]]},{"verse":33,"text":"主,しゅを恐,おそれることは知恵,ちえの教訓,きょうくんである、謙遜,けんそんは、栄誉,えいよに先,さきだつ。","tok":[["主","しゅ"],["を"],["恐れる","おそれる"],["こと"],["は"],["知恵","ちえ"],["の"],["教訓","きょうくん"],["で"],["ある"],["、"],["謙遜","けんそん"],["は"],["、"],["栄誉","えいよ"],["に"],["先だつ","さきだつ"],["。"]]}]
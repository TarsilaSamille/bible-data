[{"verse":1,"text":"悪,あくを行,おこなう人,ひとをうらやんではならない、また彼,かれらと共,ともにおることを願,ねがってはならない。","tok":[["悪","あく"],["を"],["行なう","おこなう"],["人","ひと"],["を"],["うらやんで"],["は"],["ならない"],["、"],["また"],["彼","かれ"],["ら"],["と"],["共","とも"],["に"],["おる"],["こと"],["を"],["願って","ねがって"],["は"],["ならない"],["。"]]},{"verse":2,"text":"彼,かれらはその心,こころに強奪,ごうだつを計,はかり、そのくちびるに人,ひとをそこなうことを語,かたるからである。","tok":[["彼","かれ"],["ら"],["は"],["その"],["心","こころ"],["に"],["強奪","ごうだつ"],["を"],["計り","はかり"],["、"],["その"],["くちびる"],["に"],["人","ひと"],["を"],["そこなう"],["こと"],["を"],["語る","かたる"],["から"],["で"],["ある"],["。"]]},{"verse":3,"text":"家,いえは知恵,ちえによって建,たてられ、悟,さとりによって堅,かたくせられ、","tok":[["家","いえ"],["は"],["知恵","ちえ"],["によって"],["建てられ","たてられ"],["、"],["悟り","さとり"],["によって"],["堅く","かたく"],["せられ"],["、"]]},{"verse":4,"text":"また、へやは知識,ちしきによってさまざまの尊,たっとく、麗,うるわしい宝,たからで満,みたされる。","tok":[["また"],["、"],["へや"],["は"],["知識","ちしき"],["によって"],["さまざま"],["の"],["尊","た"],["っと"],["く"],["、"],["麗わしい","うるわしい"],["宝","たから"],["で"],["満たされる","みたされる"],["。"]]},{"verse":5,"text":"知恵,ちえある者,ものは強,つよい人,ひとよりも強,つよく、知識,ちしきある人,ひとは力,ちからある人,ひとよりも強,つよい。","tok":[["知恵","ちえ"],["ある"],["者","もの"],["は"],["強い","つよい"],["人","ひと"],["より"],["も"],["強く","つよく"],["、"],["知識","ちしき"],["ある"],["人","ひと"],["は"],["力","ちから"],["ある"],["人","ひと"],["より"],["も"],["強い","つよい"],["。"]]},{"verse":6,"text":"良,よい指揮,しきによって戦,たたかいをすることができ、勝利,しょうりは多,おおくの議,ぎする者,ものがいるからである。","tok":[["良い","よい"],["指揮","しき"],["によって"],["戦い","たたかい"],["を"],["する"],["こと"],["が"],["でき"],["、"],["勝利","しょうり"],["は"],["多く","おおく"],["の"],["議する","ぎする"],["者","もの"],["が"],["いる"],["から"],["で"],["ある"],["。"]]},{"verse":7,"text":"知恵,ちえは高,たかくて愚,おろかな者,ものの及,およぶところではない、愚,おろかな者,ものは門,もんで口,くちを開,ひらくことができない。","tok":[["知恵","ちえ"],["は"],["高かくて","たかくて"],["愚か","おろか"],["な"],["者","もの"],["の"],["及ぶ","およぶ"],["ところ"],["で"],["は"],["ない"],["、"],["愚か","おろか"],["な"],["者","もの"],["は"],["門","もん"],["で"],["口","くち"],["を"],["開らく","ひらく"],["こと"],["が"],["できない"],["。"]]},{"verse":8,"text":"悪,あくを行,おこなうことを計,はかる者,ものを人,ひとはいたずら者,ものととなえる。","tok":[["悪","あく"],["を"],["行なう","おこなう"],["こと"],["を"],["計る","はかる"],["者","もの"],["を"],["人","ひと"],["は"],["いたずら"],["者","もの"],["と"],["となえる"],["。"]]},{"verse":9,"text":"愚,おろかな者,ものの計,はかるところは罪,つみであり、あざける者,ものは人,ひとに憎,にくまれる。","tok":[["愚か","おろか"],["な"],["者","もの"],["の"],["計る","はかる"],["ところ"],["は"],["罪","つみ"],["で"],["あり"],["、"],["あざける"],["者","もの"],["は"],["人","ひと"],["に"],["憎まれる","にくまれる"],["。"]]},{"verse":10,"text":"もしあなたが悩,なやみの日,ひに気,きをくじくならば、あなたの力,ちからは弱,よわい。","tok":[["もし"],["あなた"],["が"],["悩み","なやみ"],["の"],["日","ひ"],["に"],["気","き"],["を"],["くじくならば"],["、"],["あなた"],["の"],["力","ちから"],["は"],["弱い","よわい"],["。"]]},{"verse":11,"text":"死地,しちにひかれゆく者,ものを助,たすけ出,だせ、滅,ほろびによろめきゆく者,ものを救,すくえ。","tok":[["死地","しち"],["に"],["ひかれ"],["ゆく"],["者","もの"],["を"],["助け出せ","たすけだせ"],["、"],["滅び","ほろび"],["に"],["よろめき"],["ゆく"],["者","もの"],["を"],["救え","すくえ"],["。"]]},{"verse":12,"text":"あなたが、われわれはこれを知,しらなかったといっても、心,こころをはかる者,ものはそれを悟,さとらないであろうか。あなたの魂,たましいを守,まもる者,ものはそれを知,しらないであろうか。彼,かれはおのおのの行,おこないにより、人,ひとに報,むくいないであろうか。","tok":[["あなた"],["が"],["、"],["われわれ"],["は"],["これ"],["を"],["知らなかった","しらなかった"],["と"],["いって"],["も"],["、"],["心","こころ"],["を"],["はかる"],["者","もの"],["は"],["それ"],["を"],["悟らないで","さとらないで"],["あろう"],["か"],["。"],["あなた"],["の"],["魂","たましい"],["を"],["守者","まもるもの"],["は"],["それ"],["を"],["知らないで","しらないで"],["あろう"],["か"],["。"],["彼","かれ"],["は"],["おのおの"],["の"],["行ない","おこない"],["に"],["より"],["、"],["人","ひと"],["に"],["報いないで","むくいないで"],["あろう"],["か"],["。"]]},{"verse":13,"text":"わが子,こよ、蜜,みつを食,たべよ、これは良,よいものである、また、蜂,はちの巣,すのしたたりはあなたの口,くちに甘,あまい。","tok":[["わが"],["子","こ"],["よ"],["、"],["蜜","みつ"],["を"],["食べよ","たべよ"],["、"],["これ"],["は"],["良い","よい"],["もの"],["で"],["ある"],["、"],["また"],["、"],["蜂の巣","はちのす"],["の"],["した"],["たり"],["は"],["あなた"],["の"],["口","くち"],["に"],["甘い","あまい"],["。"]]},{"verse":14,"text":"知恵,ちえもあなたの魂,たましいにはそのようであることを知,しれ。それを得,えるならば、かならず報,むくいがあって、あなたの望,のぞみは、すたらない。","tok":[["知恵","ちえ"],["も"],["あなた"],["の"],["魂","たましい"],["に"],["は"],["その"],["よう"],["で"],["ある"],["こと"],["を"],["知れ","しれ"],["。"],["それ"],["を"],["得るならば","えるならば"],["、"],["かならず"],["報い","むくい"],["が"],["あって"],["、"],["あなた"],["の"],["望み","のぞみ"],["は"],["、"],["すたらない"],["。"]]},{"verse":15,"text":"悪,あしき者,ものがするように、正,ただしい者,ものの家,いえをうかがってはならない、その住,すむ所,ところに乱暴,らんぼうをしてはならない。","tok":[["悪しき","あしき"],["者","もの"],["が"],["する"],["よう"],["に"],["、"],["正い","ただしい"],["者","もの"],["の"],["家","いえ"],["を"],["うかがって"],["は"],["ならない"],["、"],["その"],["住む","すむ"],["所","ところ"],["に"],["乱暴","らんぼう"],["を"],["して"],["は"],["ならない"],["。"]]},{"verse":16,"text":"正,ただしい者,ものは七たび倒,たおれても、また起,おきあがる、しかし、悪,あしき者,ものは災,わざわいによって滅,ほろびる。","tok":[["正い","ただしい"],["者","もの"],["は"],["七","なな"],["たび"],["倒れて","たおれて"],["も"],["、"],["また"],["起きあがる","おきあがる"],["、"],["しかし"],["、"],["悪しき","あしき"],["者","もの"],["は"],["災","わざわい"],["によって"],["滅びる","ほろびる"],["。"]]},{"verse":17,"text":"あなたのあだが倒,たおれるとき楽,たのしんではならない、彼,かれのつまずくとき心,こころに喜,よろこんではならない。","tok":[["あなた"],["の"],["あだ"],["が"],["倒れる","たおれる"],["とき"],["楽しんで","たのしんで"],["は"],["ならない"],["、"],["彼","かれ"],["の"],["つまずく"],["とき"],["心","こころ"],["に"],["喜こんで","よろこんで"],["は"],["ならない"],["。"]]},{"verse":18,"text":"主,しゅはそれを見,みて悪,わるいこととし、その怒,いかりを彼,かれから転,てんじられる。","tok":[["主","しゅ"],["は"],["それ"],["を"],["見て","みて"],["悪い","わるい"],["こと"],["と"],["し"],["、"],["その"],["怒り","いかり"],["を"],["彼","かれ"],["から"],["転じられる","てんじられる"],["。"]]},{"verse":19,"text":"悪,あくを行,おこなう者,もののゆえに心,こころを悩,なやましてはならない、よこしまな者,ものをうらやんではならない。","tok":[["悪","あく"],["を"],["行なう","おこなう"],["者","もの"],["の"],["ゆえ"],["に"],["心","こころ"],["を"],["悩して","なやまして"],["は"],["ならない"],["、"],["よこしま"],["な"],["者","もの"],["を"],["うらやんで"],["は"],["ならない"],["。"]]},{"verse":20,"text":"悪,あしき者,ものには後,のちの良,よい報,むくいはない、よこしまな者,もののともしびは消,けされる。","tok":[["悪しき","あしき"],["者","もの"],["に"],["は"],["後","のち"],["の"],["良い","よい"],["報い","むくい"],["は"],["ない"],["、"],["よこしま"],["な"],["者","もの"],["の"],["ともしび"],["は"],["消される","けされる"],["。"]]},{"verse":21,"text":"わが子,こよ、主,しゅと王,おうとを恐,おそれよ、そのいずれにも不,ふ従順,じゅうじゅんであってはならない。","tok":[["わが"],["子","こ"],["よ"],["、"],["主","しゅ"],["と"],["王","おう"],["と"],["を"],["恐れよ","おそれよ"],["、"],["その"],["いずれ"],["に"],["も"],["不","ふ"],["従順","じゅうじゅん"],["で"],["あって"],["は"],["ならない"],["。"]]},{"verse":22,"text":"その災,わざわいはたちまち起,おこるからである。この二つの者,ものからくる滅,ほろびをだれが知,しり得,えようか。","tok":[["その"],["災","わざわい"],["は"],["たちまち"],["起こる","おこる"],["から"],["で"],["ある"],["。"],["この"],["二","ふた"],["つ"],["の"],["者","もの"],["から"],["くる"],["滅び","ほろび"],["を"],["だれ"],["が"],["知り","しり"],["得よう","えよう"],["か"],["。"]]},{"verse":23,"text":"これらもまた知恵,ちえある者,ものの箴言,しんげんである。片寄,かたよったさばきをするのは、よくない。","tok":[["これ"],["ら"],["も"],["また"],["知恵","ちえ"],["ある"],["者","もの"],["の"],["箴言","しんげん"],["で"],["ある"],["。"],["片寄った","かたよった"],["さばき"],["を"],["する"],["の"],["は"],["、"],["よく"],["ない"],["。"]]},{"verse":24,"text":"悪,あしき者,ものに向,むかって、「あなたは正,ただしい」という者,ものを、人々,ひとびとはのろい、諸民,しょみんは憎,にくむ。","tok":[["悪しき","あしき"],["者","もの"],["に"],["向かって","むかって"],["、"],["「"],["あなた"],["は"],["正い","ただしい"],["」"],["と"],["いう"],["者","もの"],["を"],["、"],["人々","ひとびと"],["は"],["のろい"],["、"],["諸民","しょみん"],["は"],["憎む","にくむ"],["。"]]},{"verse":25,"text":"悪,あしき者,ものをせめる者,ものは恵,めぐみを得,える、また幸福,こうふくが与,あたえられる。","tok":[["悪しき","あしき"],["者","もの"],["を"],["せめる"],["者","もの"],["は"],["恵","めぐみ"],["を"],["得る","える"],["、"],["また"],["幸福","こうふく"],["が"],["与えられる","あたえられる"],["。"]]},{"verse":26,"text":"正,ただしい答,こたえをする者,ものは、くちびるに、口,くちづけするのである。","tok":[["正い","ただしい"],["答","こたえ"],["を"],["する"],["者","もの"],["は"],["、"],["くちびる"],["に"],["、"],["口づけ","くちづけ"],["する"],["ので"],["ある"],["。"]]},{"verse":27,"text":"外,そとで、あなたの仕事,しごとを整,ととのえ、畑,はたけで、すべての物,ものをおのれのために備,そなえ、その後,のちあなたの家,いえを建,たてるがよい。","tok":[["外","そと"],["で"],["、"],["あなた"],["の"],["仕事","しごと"],["を"],["整え","ととのえ"],["、"],["畑","はたけ"],["で"],["、"],["すべて"],["の"],["物","もの"],["を"],["おのれ"],["の"],["ため"],["に"],["備","そなえ"],["、"],["その後","そののちあなた"],["の"],["家","いえ"],["を"],["建てる","たてる"],["が"],["よい"],["。"]]},{"verse":28,"text":"ゆえなく隣,となり人,びとに敵,てきして、証言,しょうげんをしてはならない、くちびるをもって欺,あざむいてはならない。","tok":[["ゆえ"],["なく"],["隣人","となりびと"],["に"],["敵して","てきして"],["、"],["証言","しょうげん"],["を"],["して"],["は"],["ならない"],["、"],["くちびる"],["を"],["もって"],["欺いて","あざむいて"],["は"],["ならない"],["。"]]},{"verse":29,"text":"「彼,かれがわたしにしたように、わたしも彼,かれにしよう、わたしは人,ひとがしたところにしたがって、その人,ひとに報,むくいよう」と言,いってはならない。","tok":[["「"],["彼","かれ"],["が"],["わたし"],["に"],["した"],["よう"],["に"],["、"],["わたし"],["も"],["彼","かれ"],["に"],["しよう"],["、"],["わたし"],["は"],["人","ひと"],["が"],["した"],["ところ"],["に"],["したがって"],["、"],["その"],["人","ひと"],["に"],["報いよう","むくいよう"],["」"],["と"],["言って","いって"],["は"],["ならない"],["。"]]},{"verse":30,"text":"わたしはなまけ者,ものの畑,はたけのそばと、知恵,ちえのない人,ひとのぶどう畑,はたけのそばを通,とおってみたが、","tok":[["わたし"],["は"],["なまけ者","なまけもの"],["の"],["畑","はたけ"],["の"],["そば"],["と"],["、"],["知恵","ちえ"],["の"],["ない"],["人","ひと"],["の"],["ぶどう"],["畑","はたけ"],["の"],["そば"],["を"],["通って","とおって"],["みた"],["が"],["、"]]},{"verse":31,"text":"いばらが一面,いちめんに生,はえ、あざみがその地面,じめんをおおい、その石,いしがきはくずれていた。","tok":[["いばら"],["が"],["一面","いちめん"],["に"],["生え","はえ"],["、"],["あざみ"],["が"],["その"],["地面","じめん"],["を"],["おおい"],["、"],["その"],["石がき","いしがき"],["は"],["くずれて"],["いた"],["。"]]},{"verse":32,"text":"わたしはこれをみて心,こころをとどめ、これを見,みて教訓,きょうくんを得,えた。","tok":[["わたし"],["は"],["これ"],["を"],["みて"],["心","こころ"],["を"],["とどめ"],["、"],["これ"],["を"],["見て","みて"],["教訓","きょうくん"],["を"],["得た","えた"],["。"]]},{"verse":33,"text":"「しばらく眠,ねむり、しばらくまどろみ、手,てをこまぬいて、またしばらく休,やすむ」。","tok":[["「"],["しばらく"],["眠","ねむり"],["、"],["しばらく"],["まどろみ"],["、"],["手","て"],["を"],["こまぬいて"],["、"],["また"],["しばらく"],["休む","やすむ"],["」"],["。"]]},{"verse":34,"text":"それゆえ、貧,まずしさは盗,ぬすびとのように、あなたに来,き、乏,とぼしさは、つわもののように、あなたに来,くる。","tok":[["それ"],["ゆえ"],["、"],["貧","まずし"],["さ"],["は"],["盗","ぬすびと"],["の"],["よう"],["に"],["、"],["あなた"],["に"],["来","き"],["、"],["乏","とぼし"],["さ"],["は"],["、"],["つわもの"],["の"],["よう"],["に"],["、"],["あなた"],["に"],["来る","くる"],["。"]]}]
[{"verse":1,"text":"ダビデの子,こ、イスラエルの王,おうソロモンの箴言,しんげん。","tok":[["ダビデ"],["の"],["子","こ"],["、"],["イスラエル"],["の"],["王","おう"],["ソロモン"],["の"],["箴言","しんげん"],["。"]]},{"verse":2,"text":"これは人,ひとに知恵,ちえと教訓,きょうくんとを知,しらせ、悟,さとりの言葉,ことばをさとらせ、","tok":[["これ"],["は"],["人","ひと"],["に"],["知恵","ちえ"],["と"],["教訓","きょうくん"],["と"],["を"],["知らせ","しらせ"],["、"],["悟り","さとり"],["の"],["言葉","ことば"],["を"],["さとらせ"],["、"]]},{"verse":3,"text":"賢,かしこい行,おこないと、正義,せいぎと公正,こうせいと公平,こうへいの教訓,きょうくんをうけさせ、","tok":[["賢しこい","かしこい"],["行ない","おこない"],["と"],["、"],["正義","せいぎ"],["と"],["公正","こうせい"],["と"],["公平","こうへい"],["の"],["教訓","きょうくん"],["を"],["うけさせ"],["、"]]},{"verse":4,"text":"思慮,しりょのない者,ものに悟,さとりを与,あたえ、若,わかい者,ものに知識,ちしきと慎,つつしみを得,えさせるためである。","tok":[["思慮","しりょ"],["の"],["ない"],["者","もの"],["に"],["悟り","さとり"],["を"],["与","あたえ"],["、"],["若い","わかい"],["者","もの"],["に"],["知識","ちしき"],["と"],["慎しみ","つつしみ"],["を"],["得させる","えさせる"],["ため"],["で"],["ある"],["。"]]},{"verse":5,"text":"賢,かしこい者,ものはこれを聞,きいて学,がくに進,すすみ、さとい者,ものは指導,しどうを得,える。","tok":[["賢しこい","かしこい"],["者","もの"],["は"],["これ"],["を"],["聞いて","きいて"],["学","がく"],["に"],["進み","すすみ"],["、"],["さとい"],["者","もの"],["は"],["指導","しどう"],["を"],["得る","える"],["。"]]},{"verse":6,"text":"人,ひとはこれによって箴言,しんげんと、たとえと、賢,かしこい者,ものの言葉,ことばと、そのなぞとを悟,さとる。","tok":[["人","ひと"],["は"],["これ"],["によって"],["箴言","しんげん"],["と"],["、"],["たとえ"],["と"],["、"],["賢しこい","かしこい"],["者","もの"],["の"],["言葉","ことば"],["と"],["、"],["その"],["なぞ"],["と"],["を"],["悟","さとる"],["。"]]},{"verse":7,"text":"主,しゅを恐,おそれることは知識,ちしきのはじめである、愚,おろかな者,ものは知恵,ちえと教訓,きょうくんを軽,かろんじる。","tok":[["主","しゅ"],["を"],["恐れる","おそれる"],["こと"],["は"],["知識","ちしき"],["の"],["はじめ"],["で"],["ある"],["、"],["愚か","おろか"],["な"],["者","もの"],["は"],["知恵","ちえ"],["と"],["教訓","きょうくん"],["を"],["軽んじる","かろんじる"],["。"]]},{"verse":8,"text":"わが子,こよ、あなたは父,ちちの教訓,きょうくんを聞,きき、母,ははの教,おしえを捨,すててはならない。","tok":[["わが"],["子","こ"],["よ"],["、"],["あなた"],["は"],["父","ちち"],["の"],["教訓","きょうくん"],["を"],["聞","きき"],["、"],["母","はは"],["の"],["教え","おしえ"],["を"],["捨てて","すてて"],["は"],["ならない"],["。"]]},{"verse":9,"text":"それらは、あなたの頭,あたまの麗,うるわしい冠,かんむりとなり、あなたの首,くびの飾,かざりとなるからである。","tok":[["それ"],["ら"],["は"],["、"],["あなた"],["の"],["頭","あたま"],["の"],["麗わしい","うるわしい"],["冠","かんむり"],["と"],["なり"],["、"],["あなた"],["の"],["首","くび"],["の"],["飾","かざり"],["と"],["なる"],["から"],["で"],["ある"],["。"]]},{"verse":10,"text":"わが子,こよ、悪者,わるものがあなたを誘,さそっても、それに従,したがってはならない。","tok":[["わが"],["子","こ"],["よ"],["、"],["悪者","わるもの"],["が"],["あなた"],["を"],["誘って","さそって"],["も"],["、"],["それ"],["に"],["従って","したがって"],["は"],["ならない"],["。"]]},{"verse":11,"text":"彼,かれらがあなたに向,むかって、「一緒,いっしょに来,きなさい。われわれは待,まち伏,ぶせして、人,ひとの血,ちを流,ながし、罪,つみのない者,ものを、ゆえなく伏,ふしてねらい、","tok":[["彼","かれ"],["ら"],["が"],["あなた"],["に"],["向かって","むかって"],["、"],["「"],["一緒","いっしょ"],["に"],["来","き"],["なさい"],["。"],["われわれ"],["は"],["待伏せ","まちぶせ"],["して"],["、"],["人","ひと"],["の"],["血","ち"],["を"],["流し","ながし"],["、"],["罪","つみ"],["の"],["ない"],["者","もの"],["を"],["、"],["ゆえ"],["なく"],["伏して","ふして"],["ねらい"],["、"]]},{"verse":12,"text":"陰府,よみのように、彼,かれらを生,いきたままで、のみ尽,つくし、健,すこやかな者,ものを、墓,はかに下,くだる者,もののようにしよう。","tok":[["陰府","よみ"],["の"],["よう"],["に"],["、"],["彼","かれ"],["ら"],["を"],["生きた","いきた"],["まま"],["で"],["、"],["のみ"],["尽くし","つくし"],["、"],["健やか","すこやか"],["な"],["者","もの"],["を"],["、"],["墓","はか"],["に"],["下る","くだる"],["者","もの"],["の"],["よう"],["に"],["しよう"],["。"]]},{"verse":13,"text":"われわれは、さまざまの尊,たっとい貨,か財,ざいを得,え、奪,うばい取,とった物,もので、われわれの家,いえを満,みたそう。","tok":[["われわれ"],["は"],["、"],["さまざま"],["の"],["尊","た"],["っと"],["い"],["貨財","かざい"],["を"],["得","え"],["、"],["奪い取った","うばいとった"],["物","もの"],["で"],["、"],["われわれ"],["の"],["家","いえ"],["を"],["満たそう","みたそう"],["。"]]},{"verse":14,"text":"あなたもわれわれの仲間,なかまに加,くわわりなさい、われわれは共,ともに一つの金,かね袋,ぶくろを持,もとう」と言,いっても、","tok":[["あなた"],["も"],["われわれ"],["の"],["仲間","なかま"],["に"],["加わわり","くわわり"],["なさい"],["、"],["われわれ"],["は"],["共","とも"],["に"],["一","ひと"],["つ"],["の"],["金","か"],["ね"],["袋","ぶくろ"],["を"],["持とう","もとう"],["」"],["と"],["言って","いって"],["も"],["、"]]},{"verse":15,"text":"わが子,こよ、彼,かれらの仲間,なかまになってはならない、あなたの足,あしをとどめて、彼,かれらの道,みちに行,いってはならない。","tok":[["わが"],["子","こ"],["よ"],["、"],["彼","かれ"],["ら"],["の"],["仲間","なかま"],["に"],["なって"],["は"],["ならない"],["、"],["あなた"],["の"],["足","あし"],["を"],["とどめて"],["、"],["彼","かれ"],["ら"],["の"],["道","みち"],["に"],["行って","いって"],["は"],["ならない"],["。"]]},{"verse":16,"text":"彼,かれらの足,あしは悪,あくに走,はしり、血,ちを流,ながすことに速,はやいからだ。","tok":[["彼","かれ"],["ら"],["の"],["足","あし"],["は"],["悪","あく"],["に"],["走り","はしり"],["、"],["血","ち"],["を"],["流す","ながす"],["こと"],["に"],["速い","はやい"],["から"],["だ"],["。"]]},{"verse":17,"text":"すべて鳥,とりの目,めの前,まえで網,あみを張,はるのは、むだである。","tok":[["すべて"],["鳥","とり"],["の"],["目","め"],["の"],["前","まえ"],["で"],["網","あみ"],["を"],["張る","はる"],["の"],["は"],["、"],["むだ"],["で"],["ある"],["。"]]},{"verse":18,"text":"彼,かれらは自分,じぶんの血,ちを待,まち伏,ぶせし、自分,じぶんの命,いのちを伏,ふしてねらうのだ。","tok":[["彼","かれ"],["ら"],["は"],["自分","じぶん"],["の"],["血","ち"],["を"],["待ち伏せ","まちぶせ"],["し"],["、"],["自分","じぶん"],["の"],["命","いのち"],["を"],["伏して","ふして"],["ねらう"],["の"],["だ"],["。"]]},{"verse":19,"text":"すべて利,りをむさぼる者,ものの道,みちはこのようなものである。これはその持,もち主,ぬしの命,いのちを取,とり去,さるのだ。","tok":[["すべて"],["利","り"],["を"],["むさぼる"],["者","もの"],["の"],["道","みち"],["は"],["この"],["よう"],["な"],["もの"],["で"],["ある"],["。"],["これ"],["は"],["その"],["持主","もちぬし"],["の"],["命","いのち"],["を"],["取去る","とりさる"],["の"],["だ"],["。"]]},{"verse":20,"text":"知恵,ちえは、ちまたに呼,よばわり、市場,しじょうにその声,こえをあげ、","tok":[["知恵","ちえ"],["は"],["、"],["ちまた"],["に"],["呼ばわり","よばわり"],["、"],["市場","しじょう"],["に"],["その"],["声","こえ"],["を"],["あげ"],["、"]]},{"verse":21,"text":"城壁,じょうへきの頂,いただきで叫,さけび、町,まちの門,もんの入口,いりぐちで語,かたる。","tok":[["城壁","じょうへき"],["の"],["頂","いただき"],["で"],["叫","さけび"],["、"],["町","まち"],["の"],["門","もん"],["の"],["入口","いりぐち"],["で"],["語る","かたる"],["。"]]},{"verse":22,"text":"「思慮,しりょのない者,ものたちよ、あなたがたは、いつまで思慮,しりょのないことを好,このむのか。あざける者,ものは、いつまで、あざけり楽,たのしみ、愚,おろかな者,ものは、いつまで、知識,ちしきを憎,にくむのか。","tok":[["「"],["思慮","しりょ"],["の"],["ない"],["者","もの"],["たち"],["よ"],["、"],["あなた"],["がた"],["は"],["、"],["いつ"],["まで"],["思慮","しりょ"],["の"],["ない"],["こと"],["を"],["好む","このむ"],["の"],["か"],["。"],["あざける"],["者","もの"],["は"],["、"],["いつ"],["まで"],["、"],["あざけり"],["楽み","たのしみ"],["、"],["愚か","おろか"],["な"],["者","もの"],["は"],["、"],["いつ"],["まで"],["、"],["知識","ちしき"],["を"],["憎む","にくむ"],["の"],["か"],["。"]]},{"verse":23,"text":"わたしの戒,いましめに心,こころをとめよ、見,みよ、わたしは自分,じぶんの思,おもいを、あなたがたに告,つげ、わたしの言葉,ことばを、あなたがたに知,しらせる。","tok":[["わたし"],["の"],["戒しめ","いましめ"],["に"],["心","こころ"],["を"],["とめよ"],["、"],["見よ","みよ"],["、"],["わたし"],["は"],["自分","じぶん"],["の"],["思い","おもい"],["を"],["、"],["あなた"],["がた"],["に"],["告","つげ"],["、"],["わたし"],["の"],["言葉","ことば"],["を"],["、"],["あなた"],["がた"],["に"],["知らせる","しらせる"],["。"]]},{"verse":24,"text":"わたしは呼,よんだが、あなたがたは聞,きくことを拒,こばみ、手,てを伸,のべたが、顧,かえりみる者,ものはなく、","tok":[["わたし"],["は"],["呼んだ","よんだ"],["が"],["、"],["あなた"],["がた"],["は"],["聞く","きく"],["こと"],["を"],["拒み","こばみ"],["、"],["手","て"],["を"],["伸べた","のべた"],["が"],["、"],["顧りみる","かえりみる"],["者","もの"],["は"],["なく"],["、"]]},{"verse":25,"text":"かえって、あなたがたはわたしのすべての勧,すすめを捨,すて、わたしの戒,いましめを受,うけなかったので、","tok":[["かえって"],["、"],["あなた"],["がた"],["は"],["わたし"],["の"],["すべて"],["の"],["勧め","すすめ"],["を"],["捨て","すて"],["、"],["わたし"],["の"],["戒しめ","いましめ"],["を"],["受なかった","うけなかった"],["ので"],["、"]]},{"verse":26,"text":"わたしもまた、あなたがたが災,わざわいにあう時,ときに、笑,わらい、あなたがたが恐慌,きょうこうにあう時,とき、あざけるであろう。","tok":[["わたし"],["も"],["また"],["、"],["あなた"],["がた"],["が"],["災","わざわい"],["に"],["あう"],["時","とき"],["に"],["、"],["笑","わらい"],["、"],["あなた"],["がた"],["が"],["恐慌","きょうこう"],["に"],["あう"],["時","とき"],["、"],["あざけるで"],["あろう"],["。"]]},{"verse":27,"text":"これは恐慌,きょうこうが、あらしのようにあなたがたに臨,のぞみ、災,わざわいが、つむじ風,かぜのように臨,のぞみ、悩,なやみと悲,かなしみとが、あなたがたに臨,のぞむ時,ときである。","tok":[["これ"],["は"],["恐慌","きょうこう"],["が"],["、"],["あらし"],["の"],["よう"],["に"],["あなた"],["がた"],["に"],["臨み","のぞみ"],["、"],["災","わざわい"],["が"],["、"],["つむじ風","つむじかぜ"],["の"],["よう"],["に"],["臨み","のぞみ"],["、"],["悩み","なやみ"],["と"],["悲しみ","かなしみ"],["と"],["が"],["、"],["あなた"],["がた"],["に"],["臨む","のぞむ"],["時","とき"],["で"],["ある"],["。"]]},{"verse":28,"text":"その時,とき、彼,かれらはわたしを呼,よぶであろう、しかし、わたしは答,こたえない。ひたすら、わたしを求,もとめるであろう、しかし、わたしに会,あえない。","tok":[["その"],["時","とき"],["、"],["彼","かれ"],["ら"],["は"],["わたし"],["を"],["呼ぶで","よぶで"],["あろう"],["、"],["しかし"],["、"],["わたし"],["は"],["答","こたえ"],["ない"],["。"],["ひたすら"],["、"],["わたし"],["を"],["求めるで","もとめるで"],["あろう"],["、"],["しかし"],["、"],["わたし"],["に"],["会えない","あえない"],["。"]]},{"verse":29,"text":"彼,かれらは知識,ちしきを憎,にくみ、主,しゅを恐,おそれることを選,えらばず、","tok":[["彼","かれ"],["ら"],["は"],["知識","ちしき"],["を"],["憎み","にくみ"],["、"],["主","しゅ"],["を"],["恐れる","おそれる"],["こと"],["を"],["選らば","えらば"],["ず"],["、"]]},{"verse":30,"text":"わたしの勧,すすめに従,したがわず、すべての戒,いましめを軽,かろんじたゆえ、","tok":[["わたし"],["の"],["勧め","すすめ"],["に"],["従わず","したがわず"],["、"],["すべて"],["の"],["戒しめ","いましめ"],["を"],["軽んじた","かろんじた"],["ゆえ"],["、"]]},{"verse":31,"text":"自分,じぶんの行,おこないの実,みを食,くらい、自分,じぶんの計,はかりごとに飽,あきる。","tok":[["自分","じぶん"],["の"],["行ない","おこない"],["の"],["実","み"],["を"],["食らい","くらい"],["、"],["自分","じぶん"],["の"],["計り","はかり"],["ごと"],["に"],["飽きる","あきる"],["。"]]},{"verse":32,"text":"思慮,しりょのない者,ものの不,ふ従順,じゅうじゅんはおのれを殺,ころし、愚,おろかな者,ものの安楽,あんらくはおのれを滅,ほろぼす。","tok":[["思慮","しりょ"],["の"],["ない"],["者","もの"],["の"],["不","ふ"],["従順","じゅうじゅん"],["は"],["おのれ"],["を"],["殺ろし","ころし"],["、"],["愚か","おろか"],["な"],["者","もの"],["の"],["安楽","あんらく"],["は"],["おのれ"],["を"],["滅ぼす","ほろぼす"],["。"]]},{"verse":33,"text":"しかし、わたしに聞,きき従,したがう者,ものは安,やすらかに住,すまい、災,わざわいに会,あう恐,おそれもなく、安全,あんぜんである」。","tok":[["しかし"],["、"],["わたし"],["に"],["聞","きき"],["従う","したがう"],["者","もの"],["は"],["安らか","やすらか"],["に"],["住まい","すまい"],["、"],["災","わざわい"],["に"],["会う","あう"],["恐","おそれ"],["も"],["なく"],["、"],["安全","あんぜん"],["で"],["ある"],["」"],["。"]]}]
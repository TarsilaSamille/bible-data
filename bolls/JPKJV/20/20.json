[{"verse":1,"text":"酒,さけは人,ひとをあざける者,ものとし、濃,こい酒,さけは人,ひとをあばれ者,ものとする、これに迷,まよわされる者,ものは無知,むちである。","tok":[["酒","さけ"],["は"],["人","ひと"],["を"],["あざける"],["者","もの"],["と"],["し"],["、"],["濃い","こい"],["酒","さけ"],["は"],["人","ひと"],["を"],["あばれ者","あばれもの"],["と"],["する"],["、"],["これ"],["に"],["迷わされる","まよわされる"],["者","もの"],["は"],["無知","むち"],["で"],["ある"],["。"]]},{"verse":2,"text":"王,おうの怒,いかりは、ししがほえるようだ、彼,かれを怒,いからせる者,ものは自分,じぶんの命,いのちをそこなう。","tok":[["王","おう"],["の"],["怒り","いかり"],["は"],["、"],["しし"],["が"],["ほえる"],["よう"],["だ"],["、"],["彼","かれ"],["を"],["怒らせる","いからせる"],["者","もの"],["は"],["自分","じぶん"],["の"],["命","いのち"],["を"],["そこなう"],["。"]]},{"verse":3,"text":"争,あらそいに関係,かんけいしないことは人,ひとの誉,ほまれである、すべて愚,おろかな者,ものは怒,いかり争,あらそう。","tok":[["争い","あらそい"],["に"],["関係","かんけい"],["しない"],["こと"],["は"],["人","ひと"],["の"],["誉","ほまれ"],["で"],["ある"],["、"],["すべて"],["愚か","おろか"],["な"],["者","もの"],["は"],["怒り","いかり"],["争う","あらそう"],["。"]]},{"verse":4,"text":"なまけ者,ものは寒,さむいときに耕,たがやさない、それゆえ刈入,かりいれのときになって、求,もとめても何,なにもない。","tok":[["なまけ者","なまけもの"],["は"],["寒い","さむい"],["とき"],["に"],["耕やさない","たがやさない"],["、"],["それ"],["ゆえ"],["刈入れ","かりいれ"],["の"],["とき"],["に"],["なって"],["、"],["求めて","もとめて"],["も"],["何に","なに"],["も"],["ない"],["。"]]},{"verse":5,"text":"人,ひとの心,こころにある計,はかりごとは深,ふかい井戸,いどの水,みずのようだ、しかし、さとき人,ひとはこれをくみ出,だす。","tok":[["人","ひと"],["の"],["心","こころ"],["に"],["ある"],["計り","はかり"],["ごと"],["は"],["深","ふ"],["かい"],["井戸","いど"],["の"],["水","みず"],["の"],["よう"],["だ"],["、"],["しかし"],["、"],["さ"],["とき"],["人","ひと"],["は"],["これ"],["を"],["くみ出す","くみだす"],["。"]]},{"verse":6,"text":"自分,じぶんは真実,しんじつだという人,ひとが多,おおい、しかし、だれが忠信,ちゅうしんな人,ひとに会,あうであろうか。","tok":[["自分","じぶん"],["は"],["真実","しんじつ"],["だ"],["と"],["いう"],["人","ひと"],["が"],["多い","おおい"],["、"],["しかし"],["、"],["だれ"],["が"],["忠信","ちゅうしん"],["な"],["人","ひと"],["に"],["会うで","あうで"],["あろう"],["か"],["。"]]},{"verse":7,"text":"欠,かけた所,ところなく、正,ただしく歩,あゆむ人,ひと――その後,のちの子孫,しそんはさいわいである。","tok":[["欠けた","かけた"],["所","ところ"],["なく"],["、"],["正く","ただしく"],["歩む","あゆむ"],["人","ひと"],["―"],["―"],["その後","そののち"],["の"],["子孫","しそん"],["は"],["さいわい"],["で"],["ある"],["。"]]},{"verse":8,"text":"さばきの座,ざにすわる王,おうはその目,めをもって、すべての悪,あくをふるいわける。","tok":[["さばき"],["の"],["座","ざ"],["に"],["すわる"],["王","おう"],["は"],["その"],["目","め"],["を"],["もって"],["、"],["すべて"],["の"],["悪","あく"],["を"],["ふるいわける"],["。"]]},{"verse":9,"text":"だれが「わたしは自分,じぶんの心,こころを清,きよめた、わたしの罪,つみは清,きよめられた」ということができようか。","tok":[["だれ"],["が"],["「"],["わたし"],["は"],["自分","じぶん"],["の"],["心","こころ"],["を"],["清めた","きよめた"],["、"],["わたし"],["の"],["罪","つみ"],["は"],["清められた","きよめられた"],["」"],["と"],["いう"],["こと"],["が"],["できよう"],["か"],["。"]]},{"verse":10,"text":"互,たがいに違,ちがった二種,しゅのはかり、二種,しゅのますは、ひとしく主,しゅに憎,にくまれる。","tok":[["互","たがい"],["に"],["違った","ちがった"],["二","に"],["種","しゅ"],["の"],["はかり"],["、"],["二","に"],["種","しゅ"],["の"],["ます"],["は"],["、"],["ひとしく"],["主に","しゅに"],["憎まれる","にくまれる"],["。"]]},{"verse":11,"text":"幼,おさな子,こでさえも、その行,おこないによって自,みずからを示,しめし、そのすることの清,きよいか正,ただしいかを現,あらわす。","tok":[["幼な子","おさなこ"],["で"],["さえ"],["も"],["、"],["その"],["行ない","おこない"],["によって"],["自から","みずから"],["を"],["示めし","しめし"],["、"],["その"],["する"],["こと"],["の"],["清い","きよい"],["か"],["正い","ただしい"],["か"],["を"],["現わす","あらわす"],["。"]]},{"verse":12,"text":"聞,きく耳,みみと、見,みる目,めとは、ともに主,しゅが造,つくられたものである。","tok":[["聞く","きく"],["耳","みみ"],["と"],["、"],["見る","みる"],["目","め"],["と"],["は"],["、"],["とも"],["に"],["主","しゅ"],["が"],["造られた","つくられた"],["もの"],["で"],["ある"],["。"]]},{"verse":13,"text":"眠,ねむりを愛,あいしてはならない、そうすれば貧,まずしくなる、目,めを開,ひらけ、そうすればパンに飽,あくことができる。","tok":[["眠","ねむり"],["を"],["愛して","あいして"],["は"],["ならない"],["、"],["そう"],["すれば"],["貧しく","まずしく"],["なる"],["、"],["目","め"],["を"],["開らけ","ひらけ"],["、"],["そう"],["すれば"],["パン"],["に"],["飽く","あく"],["こと"],["が"],["できる"],["。"]]},{"verse":14,"text":"買,かう者,ものは、「悪,わるい、悪,わるい」という、しかし去,さって後,のち、彼,かれは自,みずから誇,ほこる。","tok":[["買う","かう"],["者","もの"],["は"],["、"],["「"],["悪い","わるい"],["、"],["悪い","わるい"],["」"],["と"],["いう"],["、"],["しかし"],["去て","さって"],["後","の"],["ち"],["、"],["彼","かれ"],["は"],["自から","みずから"],["誇る","ほこる"],["。"]]},{"verse":15,"text":"金,きんもあり、価,あたいの高,たかい宝石,ほうせきも多,おおくあるが、尊,たっとい器,うつわは知識,ちしきのくちびるである。","tok":[["金","きん"],["も"],["あり"],["、"],["価","あたい"],["の"],["高い","たかい"],["宝石","ほうせき"],["も"],["多く","おおく"],["ある"],["が"],["、"],["尊","た"],["っと"],["い"],["器","うつわ"],["は"],["知識","ちしき"],["の"],["くちびる"],["で"],["ある"],["。"]]},{"verse":16,"text":"人,ひとのために保証,ほしょうする者,ものからは、まずその着物,きものを取,とれ、他人,たにんのために保証,ほしょうする者,ものをば抵当,ていとうに取,とれ。","tok":[["人","ひと"],["の"],["ため"],["に"],["保証","ほしょう"],["する"],["者","もの"],["から"],["は"],["、"],["まず"],["その"],["着物","きもの"],["を"],["取れ","とれ"],["、"],["他人","たにん"],["の"],["ため"],["に"],["保証","ほしょう"],["する"],["者","もの"],["をば"],["抵当","ていとう"],["に"],["取れ","とれ"],["。"]]},{"verse":17,"text":"欺,あざむき取,とったパンはおいしい、しかし後,のちにはその口,くちは砂利,じゃりで満,みたされる。","tok":[["欺き","あざむき"],["取った","とった"],["パン"],["は"],["おいしい"],["、"],["しかし"],["後","のち"],["に"],["は"],["その"],["口","くち"],["は"],["砂利","じゃり"],["で"],["満たされる","みたされる"],["。"]]},{"verse":18,"text":"計,はかりごとは共,ともに議,ぎすることによって成,なる、戦,たたかおうとするならば、まずよく議,ぎしなければならない。","tok":[["計り","はかり"],["ごと"],["は"],["共","とも"],["に"],["議する","ぎする"],["こと"],["によって"],["成る","なる"],["、"],["戦おう","たたかおう"],["と"],["するならば"],["、"],["まず"],["よく"],["議しなければ","ぎしなければ"],["ならない"],["。"]]},{"verse":19,"text":"歩,あるきまわって人,ひとのよしあしをいう者,ものは秘密,ひみつをもらす、くちびるを開,ひらいて歩,あるく者,ものと交,まじわってはならない。","tok":[["歩き","あるき"],["まわって"],["人","ひと"],["の"],["よしあし"],["を"],["いう"],["者","もの"],["は"],["秘密","ひみつ"],["を"],["もらす"],["、"],["くちびる"],["を"],["開らいて","ひらいて"],["歩く","あるく"],["者","もの"],["と"],["交じわって","まじわって"],["は"],["ならない"],["。"]]},{"verse":20,"text":"自分,じぶんの父母,ふぼをののしる者,ものは、そのともしびは暗,くらやみの中,なかに消,きえる。","tok":[["自分","じぶん"],["の"],["父母","ふぼ"],["を"],["ののしる"],["者","もの"],["は"],["、"],["その"],["ともしび"],["は"],["暗やみ","くらやみ"],["の"],["中","なか"],["に"],["消える","きえる"],["。"]]},{"verse":21,"text":"初,はじめに急,いそいで得,えた資産,しさんは、その終,おわりがさいわいでない。","tok":[["初め","はじめ"],["に"],["急いで","いそいで"],["得た","えた"],["資産","しさん"],["は"],["、"],["その"],["終","おわり"],["が"],["さいわい"],["で"],["ない"],["。"]]},{"verse":22,"text":"「わたしが悪,あくに報,むくいる」と言,いってはならない、主,しゅを待,まち望,のぞめ、主,しゅはあなたを助,たすけられる。","tok":[["「"],["わたし"],["が"],["悪","あく"],["に"],["報いる","むくいる"],["」"],["と"],["言って","いって"],["は"],["ならない"],["、"],["主","しゅ"],["を"],["待ち望め","まちのぞめ"],["、"],["主","しゅ"],["は"],["あなた"],["を"],["助けられる","たすけられる"],["。"]]},{"verse":23,"text":"互,たがいに違,ちがった二種,しゅのふんどうは主,しゅに憎,にくまれる、偽,いつわりのはかりは良,よくない。","tok":[["互","たがい"],["に"],["違った","ちがった"],["二","に"],["種","しゅ"],["の"],["ふん"],["どう"],["は"],["主に","しゅに"],["憎まれる","にくまれる"],["、"],["偽わり","いつわり"],["の"],["はかり"],["は"],["良く","よく"],["ない"],["。"]]},{"verse":24,"text":"人,ひとの歩,あゆみは主,しゅによって定,さだめられる、人,ひとはどうして自,みずからその道,みちを、明,あきらかにすることができようか。","tok":[["人","ひと"],["の"],["歩み","あゆみ"],["は"],["主に","しゅに"],["よって"],["定められる","さだめられる"],["、"],["人","ひと"],["は"],["どう"],["して"],["自から","みずから"],["その"],["道","みち"],["を"],["、"],["明か","あきらか"],["に"],["する"],["こと"],["が"],["できよう"],["か"],["。"]]},{"verse":25,"text":"軽々,かるがるしく「これは聖,せいなるささげ物,ものだ」と言,いい、また誓,ちかいを立,たてて後,のちに考,かんがえることは、その人,ひとのわなとなる。","tok":[["軽々しく","かるがるしく"],["「"],["これ"],["は"],["聖","せい"],["なる"],["ささげ物","ささげもの"],["だ"],["」"],["と"],["言い","いい"],["、"],["また"],["誓い","ちかい"],["を"],["立てて","たてて"],["後","のち"],["に"],["考","かんがえ"],["る"],["こと"],["は"],["、"],["その"],["人","ひと"],["の"],["わな"],["と"],["なる"],["。"]]},{"verse":26,"text":"知恵,ちえある王,おうは、箕,みのをもってあおぎ分,わけるように悪人,あくにんを散,ちらし、車,くるまをもって脱穀,だっこくするように、これを罰,ばっする。","tok":[["知恵","ちえ"],["ある"],["王","おう"],["は"],["、"],["箕","み"],["の"],["を"],["もって"],["あおぎ"],["分ける","わける"],["よう"],["に"],["悪人","あくにん"],["を"],["散らし","ちらし"],["、"],["車","くるま"],["を"],["もって"],["脱穀","だっこく"],["する"],["よう"],["に"],["、"],["これ"],["を"],["罰する","ばっする"],["。"]]},{"verse":27,"text":"人,ひとの魂,たましいは主,しゅのともしびであり、人,ひとの心,こころの奥,おくを探,さぐる。","tok":[["人","ひと"],["の"],["魂","たましい"],["は"],["主","しゅ"],["の"],["ともしび"],["で"],["あり"],["、"],["人","ひと"],["の"],["心","こころ"],["の"],["奥","おく"],["を"],["探ぐる","さぐる"],["。"]]},{"verse":28,"text":"いつくしみと、まこととは王,おうを守,まもる、その位,くらいもまた正義,せいぎによって保,たもたれる。","tok":[["いつくしみ"],["と"],["、"],["まこと"],["と"],["は"],["王","おう"],["を"],["守","まもる"],["、"],["その"],["位","くらい"],["も"],["また"],["正義","せいぎ"],["によって"],["保たれる","たもたれる"],["。"]]},{"verse":29,"text":"若,わかい人,ひとの栄,さかえはその力,ちから、老人,ろうじんの美,うつくしさはそのしらがである。","tok":[["若い","わかい"],["人","ひと"],["の"],["栄","さかえ"],["は"],["その"],["力","ちから"],["、"],["老人","ろうじん"],["の"],["美し","うつくし"],["さ"],["は"],["その"],["しらが"],["で"],["ある"],["。"]]},{"verse":30,"text":"傷,きずつくまでに打,うてば悪,わるい所,ところは清,きよくなり、むちで打,うてば心,こころの底,そこまでも清,きよまる。","tok":[["傷つく","きずつく"],["まで"],["に"],["打てば","うてば"],["悪い","わるい"],["所","ところ"],["は"],["清く","きよく"],["なり"],["、"],["むち"],["で"],["打てば","うてば"],["心","こころ"],["の"],["底","そこ"],["まで"],["も"],["清まる","きよまる"],["。"]]}]
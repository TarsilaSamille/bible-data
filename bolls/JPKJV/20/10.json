[{"verse":1,"text":"ソロモンの箴言,しんげん。知恵,ちえある子,こは父,ちちを喜,よろこばせ、愚,おろかな子,こは母,ははの悲,かなしみとなる。","tok":[["ソロモン"],["の"],["箴言","しんげん"],["。"],["知恵","ちえ"],["ある"],["子","こ"],["は"],["父","ちち"],["を"],["喜こばせ","よろこばせ"],["、"],["愚か","おろか"],["な"],["子","こ"],["は"],["母","はは"],["の"],["悲しみ","かなしみ"],["と"],["なる"],["。"]]},{"verse":2,"text":"不義,ふぎの宝,たからは益,えきなく、正義,せいぎは人,ひとを救,すくい出,だして、死,しを免,まぬかれさせる。","tok":[["不義","ふぎ"],["の"],["宝","たから"],["は"],["益","えき"],["なく"],["、"],["正義","せいぎ"],["は"],["人","ひと"],["を"],["救い出して","すくいだして"],["、"],["死","し"],["を"],["免かれさせる","まぬかれさせる"],["。"]]},{"verse":3,"text":"主,しゅは正,ただしい人,ひとを飢,うえさせず、悪,あしき者,ものの欲望,よくぼうをくじかれる。","tok":[["主","しゅ"],["は"],["正い","ただしい"],["人","ひと"],["を"],["飢","うえ"],["させず"],["、"],["悪しき","あしき"],["者","もの"],["の"],["欲望","よくぼう"],["を"],["くじかれる"],["。"]]},{"verse":4,"text":"手,てを動,うごかすことを怠,おこたる者,ものは貧,まずしくなり、勤,つとめ働,はたらく者,ものの手,ては富,とみを得,える。","tok":[["手","て"],["を"],["動かす","うごかす"],["こと"],["を"],["怠たる","おこたる"],["者","もの"],["は"],["貧しく","まずしく"],["なり"],["、"],["勤め","つとめ"],["働く","はたらく"],["者","もの"],["の"],["手","て"],["は"],["富","とみ"],["を"],["得る","える"],["。"]]},{"verse":5,"text":"夏,なつのうちに集,あつめる者,ものは賢,かしこい子,こであり、刈入,かりいれの時,ときに眠,ねむる者,ものは恥,はじをきたらせる子,こである。","tok":[["夏","なつ"],["の"],["うち"],["に"],["集める","あつめる"],["者","もの"],["は"],["賢しこい","かしこい"],["子","こ"],["で"],["あり"],["、"],["刈入れ","かりいれ"],["の"],["時","とき"],["に"],["眠る","ねむる"],["者","もの"],["は"],["恥","はじ"],["を"],["きたらせる"],["子","こ"],["で"],["ある"],["。"]]},{"verse":6,"text":"正,ただしい者,もののこうべには祝福,しゅくふくがあり、悪,あしき者,ものの口,くちは暴虐,ぼうぎゃくを隠,かくす。","tok":[["正い","ただしい"],["者","もの"],["の"],["こうべ"],["に"],["は"],["祝福","しゅくふく"],["が"],["あり"],["、"],["悪しき","あしき"],["者","もの"],["の"],["口","くち"],["は"],["暴虐","ぼうぎゃく"],["を"],["隠す","かくす"],["。"]]},{"verse":7,"text":"正,ただしい者,ものの名,なはほめられ、悪,あしき者,ものの名,なは朽,くちる。","tok":[["正い","ただしい"],["者","もの"],["の"],["名","な"],["は"],["ほめられ"],["、"],["悪しき","あしき"],["者","もの"],["の"],["名","な"],["は"],["朽ちる","くちる"],["。"]]},{"verse":8,"text":"心,こころのさとき者,ものは戒,いましめを受,うける、むだ口,くちをたたく愚,おろかな者,ものは滅,ほろぼされる。","tok":[["心","こころ"],["の"],["さ"],["とき"],["者","もの"],["は"],["戒しめ","いましめ"],["を"],["受る","うける"],["、"],["むだ口","むだくち"],["を"],["たたく"],["愚か","おろか"],["な"],["者","もの"],["は"],["滅ぼされる","ほろぼされる"],["。"]]},{"verse":9,"text":"まっすぐに歩,あゆむ者,ものの歩,あゆみは安全,あんぜんである、しかし、その道,みちを曲,まげる者,ものは災,わざわいにあう。","tok":[["まっすぐ"],["に"],["歩む","あゆむ"],["者","もの"],["の"],["歩み","あゆみ"],["は"],["安全","あんぜん"],["で"],["ある"],["、"],["しかし"],["、"],["その"],["道","みち"],["を"],["曲げる","まげる"],["者","もの"],["は"],["災","わざわい"],["に"],["あう"],["。"]]},{"verse":10,"text":"目,めで、めくばせする者,ものは憂,うれいをおこし、あからさまに、戒,いましめる者,ものは平和,へいわをきたらせる。","tok":[["目","め"],["で"],["、"],["めくばせ"],["する"],["者","もの"],["は"],["憂","うれい"],["を"],["おこし"],["、"],["あからさま"],["に"],["、"],["戒める","いましめる"],["者","もの"],["は"],["平和","へいわ"],["を"],["きたらせる"],["。"]]},{"verse":11,"text":"正,ただしい者,ものの口,くちは命,いのちの泉,いずみである、悪,あしき者,ものの口,くちは暴虐,ぼうぎゃくを隠,かくす。","tok":[["正い","ただしい"],["者","もの"],["の"],["口","くち"],["は"],["命","いのち"],["の"],["泉","いずみ"],["で"],["ある"],["、"],["悪しき","あしき"],["者","もの"],["の"],["口","くち"],["は"],["暴虐","ぼうぎゃく"],["を"],["隠す","かくす"],["。"]]},{"verse":12,"text":"憎,にくしみは、争,あらそいを起,おこし、愛,あいはすべてのとがをおおう。","tok":[["憎しみ","にくしみ"],["は"],["、"],["争い","あらそい"],["を"],["起こし","おこし"],["、"],["愛","あい"],["は"],["すべて"],["の"],["とが"],["を"],["おおう"],["。"]]},{"verse":13,"text":"さとき者,もののくちびるには知恵,ちえがあり、知恵,ちえのない者,ものの背,せにはむちがある。","tok":[["さ"],["とき"],["者","もの"],["の"],["くちびる"],["に"],["は"],["知恵","ちえ"],["が"],["あり"],["、"],["知恵","ちえ"],["の"],["ない"],["者","もの"],["の"],["背","せ"],["に"],["は"],["むち"],["が"],["ある"],["。"]]},{"verse":14,"text":"知恵,ちえある者,ものは知識,ちしきをたくわえる、愚,おろかな者,もののむだ口,くちは、今,いまにも滅,ほろびをきたらせる。","tok":[["知恵","ちえ"],["ある"],["者","もの"],["は"],["知識","ちしき"],["を"],["たくわえる"],["、"],["愚か","おろか"],["な"],["者","もの"],["の"],["むだ口","むだくち"],["は"],["、"],["今","いま"],["に"],["も"],["滅び","ほろび"],["を"],["きたらせる"],["。"]]},{"verse":15,"text":"富,とめる者,ものの宝,たからは、その堅,かたき城,しろであり、貧,まずしい者,ものの乏,とぼしきは、その滅,ほろびである。","tok":[["富める","とめる"],["者","もの"],["の"],["宝","たから"],["は"],["、"],["その"],["堅","か"],["たき城","たきしろ"],["で"],["あり"],["、"],["貧しい","まずしい"],["者","もの"],["の"],["乏","とぼし"],["き"],["は"],["、"],["その"],["滅び","ほろび"],["で"],["ある"],["。"]]},{"verse":16,"text":"正,ただしい者,ものの受,うける賃銀,ちんぎんは命,いのちに導,みちびき、悪,あしき者,ものの利得,りとくは罪,つみに至,いたる。","tok":[["正い","ただしい"],["者","もの"],["の"],["受ける","うける"],["賃銀","ちんぎん"],["は"],["命","いのち"],["に"],["導き","みちびき"],["、"],["悪しき","あしき"],["者","もの"],["の"],["利得","りとく"],["は"],["罪","つみ"],["に"],["至る","いたる"],["。"]]},{"verse":17,"text":"教訓,きょうくんを守,まもる者,ものは命,いのちの道,みちにあり、懲,こらしめを捨,すてる者,ものは道,みちをふみ迷,まよう。","tok":[["教訓","きょうくん"],["を"],["守者","まもるもの"],["は"],["命","いのち"],["の"],["道","みち"],["に"],["あり"],["、"],["懲らしめ","こらしめ"],["を"],["捨てる","すてる"],["者","もの"],["は"],["道","みち"],["を"],["ふみ"],["迷う","まよう"],["。"]]},{"verse":18,"text":"憎,にくしみを隠,かくす者,ものには偽,いつわりのくちびるがあり、そしりを口,くちに出,だす者,ものは愚,おろかな者,ものである。","tok":[["憎しみ","にくしみ"],["を"],["隠す","かくす"],["者","もの"],["に"],["は"],["偽わり","いつわり"],["の"],["くちびる"],["が"],["あり"],["、"],["そ"],["しり"],["を"],["口","くち"],["に"],["出す","だす"],["者","もの"],["は"],["愚か","おろか"],["な"],["者","もの"],["で"],["ある"],["。"]]},{"verse":19,"text":"言葉,ことばが多,おおければ、とがを免,まぬかれない、自分,じぶんのくちびるを制,せいする者,ものは知恵,ちえがある。","tok":[["言葉","ことば"],["が"],["多ければ","おおければ"],["、"],["とが"],["を"],["免かれない","まぬかれない"],["、"],["自分","じぶん"],["の"],["くちびる"],["を"],["制する","せいする"],["者","もの"],["は"],["知恵","ちえ"],["が"],["ある"],["。"]]},{"verse":20,"text":"正,ただしい者,ものの舌,したは精,せい銀,ぎんである、悪,あしき者,ものの心,こころは価値,かちが少,すくない。","tok":[["正い","ただしい"],["者","もの"],["の"],["舌","した"],["は"],["精銀","せいぎん"],["で"],["ある"],["、"],["悪しき","あしき"],["者","もの"],["の"],["心","こころ"],["は"],["価値","かち"],["が"],["少い","すくない"],["。"]]},{"verse":21,"text":"正,ただしい者,もののくちびるは多,おおくの人,ひとを養,やしない、愚,おろかな者,ものは知恵,ちえがなくて死,しぬ。","tok":[["正い","ただしい"],["者","もの"],["の"],["くちびる"],["は"],["多く","おおく"],["の"],["人","ひと"],["を"],["養い","やしない"],["、"],["愚か","おろか"],["な"],["者","もの"],["は"],["知恵","ちえ"],["が"],["なくて"],["死ぬ","しぬ"],["。"]]},{"verse":22,"text":"主,しゅの祝福,しゅくふくは人,ひとを富,とませる、主,しゅはこれになんの悲,かなしみをも加,くわえない。","tok":[["主","しゅ"],["の"],["祝福","しゅくふく"],["は"],["人","ひと"],["を"],["富ませる","とませる"],["、"],["主","しゅ"],["は"],["これ"],["に"],["なん"],["の"],["悲しみ","かなしみ"],["を"],["も"],["加えない","くわえない"],["。"]]},{"verse":23,"text":"愚,おろかな者,ものは、戯,ざれ事,ごとのように悪,あくを行,おこなう、さとき人,ひとには賢,かしこい行,おこないが楽,たのしみである。","tok":[["愚か","おろか"],["な"],["者","もの"],["は"],["、"],["戯れ事","ざれごと"],["の"],["よう"],["に"],["悪","あく"],["を"],["行なう","おこなう"],["、"],["さ"],["とき"],["人","ひと"],["に"],["は"],["賢しこい","かしこい"],["行ない","おこない"],["が"],["楽み","たのしみ"],["で"],["ある"],["。"]]},{"verse":24,"text":"悪,あしき者,ものの恐,おそれることは自分,じぶんに来,きたり、正,ただしい者,ものの願,ねがうことは与,あたえられる。","tok":[["悪しき","あしき"],["者","もの"],["の"],["恐れる","おそれる"],["こと"],["は"],["自分","じぶん"],["に"],["来","き"],["たり"],["、"],["正い","ただしい"],["者","もの"],["の"],["願う","ねがう"],["こと"],["は"],["与えられる","あたえられる"],["。"]]},{"verse":25,"text":"あらしが通,とおりすぎる時,とき、悪,あしき者,ものは、もはや、いなくなり、正,ただしい者,ものは永久,えいきゅうに堅,かたく立,たてられる。","tok":[["あらし"],["が"],["通り","とおり"],["すぎる"],["時","とき"],["、"],["悪しき","あしき"],["者","もの"],["は"],["、"],["もはや"],["、"],["いなく"],["なり"],["、"],["正い","ただしい"],["者","もの"],["は"],["永久","えいきゅう"],["に"],["堅く","かたく"],["立られる","たてられる"],["。"]]},{"verse":26,"text":"なまけ者,ものは、これをつかわす者,ものにとっては、酢,すが歯,はをいため、煙,けむりが目,めを悩,なやますようなものだ。","tok":[["なまけ者","なまけもの"],["は"],["、"],["これ"],["を"],["つかわす"],["者","もの"],["にとって"],["は"],["、"],["酢","す"],["が"],["歯","は"],["を"],["いため"],["、"],["煙","けむり"],["が"],["目","め"],["を"],["悩す","なやます"],["よう"],["な"],["もの"],["だ"],["。"]]},{"verse":27,"text":"主,しゅを恐,おそれることは人,ひとの命,いのちの日,ひを多,おおくする、悪,あしき者,ものの年,としは縮,ちぢめられる。","tok":[["主","しゅ"],["を"],["恐れる","おそれる"],["こと"],["は"],["人","ひと"],["の"],["命","いのち"],["の"],["日","ひ"],["を"],["多く","おおく"],["する"],["、"],["悪しき","あしき"],["者","もの"],["の"],["年","とし"],["は"],["縮められる","ちぢめられる"],["。"]]},{"verse":28,"text":"正,ただしい者,ものの望,のぞみは喜,よろこびに終,おわり、悪,あしき者,ものの望,のぞみは絶,たえる。","tok":[["正い","ただしい"],["者","もの"],["の"],["望み","のぞみ"],["は"],["喜こび","よろこび"],["に"],["終","おわり"],["、"],["悪しき","あしき"],["者","もの"],["の"],["望み","のぞみ"],["は"],["絶える","たえる"],["。"]]},{"verse":29,"text":"主,しゅは、まっすぐに歩,あゆむ者,ものには城,しろであり、悪,あくを行,おこなう者,ものには滅,ほろびである。","tok":[["主","しゅ"],["は"],["、"],["まっすぐ"],["に"],["歩む","あゆむ"],["者","もの"],["に"],["は"],["城","しろ"],["で"],["あり"],["、"],["悪","あく"],["を"],["行なう","おこなう"],["者","もの"],["に"],["は"],["滅び","ほろび"],["で"],["ある"],["。"]]},{"verse":30,"text":"正,ただしい者,ものはいつまでも動,うごかされることはない、悪,あしき者,ものは、地,ちに住,すむことができない。","tok":[["正い","ただしい"],["者","もの"],["は"],["いつ"],["まで"],["も"],["動かされる","うごかされる"],["こと"],["は"],["ない"],["、"],["悪しき","あしき"],["者","もの"],["は"],["、"],["地","ち"],["に"],["住む","すむ"],["こと"],["が"],["できない"],["。"]]},{"verse":31,"text":"正,ただしい者,ものの口,くちは知恵,ちえをいだし、偽,いつわりの舌,したは抜,ぬかれる。","tok":[["正い","ただしい"],["者","もの"],["の"],["口","くち"],["は"],["知恵","ちえ"],["を"],["いだし"],["、"],["偽わり","いつわり"],["の"],["舌","した"],["は"],["抜かれる","ぬかれる"],["。"]]},{"verse":32,"text":"正,ただしい者,もののくちびるは喜,よろこばるべきことをわきまえ、悪,あしき者,ものの口,くちは偽,いつわりを語,かたる。","tok":[["正い","ただしい"],["者","もの"],["の"],["くちびる"],["は"],["喜こばるべき","よろこばるべき"],["こと"],["を"],["わきまえ"],["、"],["悪しき","あしき"],["者","もの"],["の"],["口","くち"],["は"],["偽り","いつわり"],["を"],["語る","かたる"],["。"]]}]
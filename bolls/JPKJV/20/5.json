[{"verse":1,"text":"わが子,こよ、わたしの知恵,ちえに心,こころをとめ、わたしの悟,さとりに耳,みみをかたむけよ。","tok":[["わが"],["子","こ"],["よ"],["、"],["わたし"],["の"],["知恵","ちえ"],["に"],["心","こころ"],["を"],["とめ"],["、"],["わたし"],["の"],["悟り","さとり"],["に"],["耳","みみ"],["を"],["かたむけよ"],["。"]]},{"verse":2,"text":"これは、あなたが慎,つつしみを守,まもり、あなたのくちびるに知識,ちしきを保,たもつためである。","tok":[["これ"],["は"],["、"],["あなた"],["が"],["慎しみ","つつしみ"],["を"],["守り","まもり"],["、"],["あなた"],["の"],["くちびる"],["に"],["知識","ちしき"],["を"],["保つ","たもつ"],["ため"],["で"],["ある"],["。"]]},{"verse":3,"text":"遊女,ゆうじょのくちびるは蜜,みつをしたたらせ、その言葉,ことばは油,あぶらよりもなめらかである。","tok":[["遊女","ゆうじょ"],["の"],["くちびる"],["は"],["蜜","みつ"],["を"],["したたらせ"],["、"],["その"],["言葉","ことば"],["は"],["油","あぶら"],["より"],["も"],["なめらか"],["で"],["ある"],["。"]]},{"verse":4,"text":"しかしついには、彼女,かのじょはにがよもぎのように苦,にがく、もろ刃,はのつるぎのように鋭,するどくなる。","tok":[["しかし"],["ついに"],["は"],["、"],["彼女","かのじょ"],["は"],["にがよもぎ"],["の"],["よう"],["に"],["苦く","にがく"],["、"],["もろ刃","もろは"],["の"],["つるぎ"],["の"],["よう"],["に"],["鋭く","するどく"],["なる"],["。"]]},{"verse":5,"text":"その足,あしは死,しに下,くだり、その歩,あゆみは陰府,よみの道,みちにおもむく。","tok":[["その"],["足","あし"],["は"],["死","し"],["に"],["下り","くだり"],["、"],["その"],["歩み","あゆみ"],["は"],["陰府","よみ"],["の"],["道","みち"],["に"],["おもむく"],["。"]]},{"verse":6,"text":"彼女,かのじょはいのちの道,みちに心,こころをとめず、その道,みちは人,ひとを迷,まよわすが、彼女,かのじょはそれを知,しらない。","tok":[["彼女","かのじょ"],["は"],["いのち"],["の"],["道","みち"],["に"],["心","こころ"],["を"],["とめず"],["、"],["その"],["道","みち"],["は"],["人","ひと"],["を"],["迷わす","まよわす"],["が"],["、"],["彼女","かのじょ"],["は"],["それ"],["を"],["知らない","しらない"],["。"]]},{"verse":7,"text":"子供,こどもらよ、今,いまわたしの言,いうことを聞,きけ、わたしの口,くちの言葉,ことばから、離,はなれ去,さってはならない。","tok":[["子供","こども"],["ら"],["よ"],["、"],["今","いま"],["わたし"],["の"],["言う","いう"],["こと"],["を"],["聞け","きけ"],["、"],["わたし"],["の"],["口","くち"],["の"],["言葉","ことば"],["から"],["、"],["離れ","はなれ"],["去て","さって"],["は"],["ならない"],["。"]]},{"verse":8,"text":"あなたの道,みちを彼女,かのじょから遠,とおく離,はなし、その家,いえの門,もんに近,ちかづいてはならない。","tok":[["あなた"],["の"],["道","みち"],["を"],["彼女","かのじょ"],["から"],["遠く","とおく"],["離し","はなし"],["、"],["その"],["家","いえ"],["の"],["門","もん"],["に"],["近づいて","ちかづいて"],["は"],["ならない"],["。"]]},{"verse":9,"text":"おそらくはあなたの誉,ほまれを他人,たにんにわたし、あなたの年,としを無慈悲,むじひな者,ものにわたすに至,いたる。","tok":[["おそらく"],["は"],["あなた"],["の"],["誉","ほまれ"],["を"],["他人","たにん"],["に"],["わたし"],["、"],["あなた"],["の"],["年","とし"],["を"],["無慈悲","むじひ"],["な"],["者","もの"],["に"],["わたす"],["に"],["至る","いたる"],["。"]]},{"verse":10,"text":"おそらくは他人,たにんがあなたの資産,しさんによって満,みたされ、あなたの労苦,ろうくは他人,たにんの家,いえに行,いく。","tok":[["おそらく"],["は"],["他人","たにん"],["が"],["あなた"],["の"],["資産","しさん"],["によって"],["満たされ","みたされ"],["、"],["あなた"],["の"],["労苦","ろうく"],["は"],["他人","たにん"],["の"],["家","いえ"],["に"],["行く","いく"],["。"]]},{"verse":11,"text":"そしてあなたの終,おわりが来,きて、あなたの身,みと、からだが滅,ほろびるとき、泣,なき悲,かなしんで、","tok":[["そして"],["あなた"],["の"],["終","おわり"],["が"],["来て","きて"],["、"],["あなた"],["の"],["身","み"],["と"],["、"],["からだ"],["が"],["滅びる","ほろびる"],["とき"],["、"],["泣","なき"],["悲しんで","かなしんで"],["、"]]},{"verse":12,"text":"言,いうであろう、「わたしは教訓,きょうくんをいとい、心,こころに戒,いましめを軽,かろんじ、","tok":[["言うで","いうで"],["あろう"],["、"],["「"],["わたし"],["は"],["教訓","きょうくん"],["を"],["いとい"],["、"],["心","こころ"],["に"],["戒しめ","いましめ"],["を"],["軽んじ","かろんじ"],["、"]]},{"verse":13,"text":"教師,きょうしの声,こえに聞,きき従,したがわず、わたしを教,おしえる者,ものに耳,みみを傾,かたむけず、","tok":[["教師","きょうし"],["の"],["声","こえ"],["に"],["聞","きき"],["従わず","したがわず"],["、"],["わたし"],["を"],["教える","おしえる"],["者","もの"],["に"],["耳","みみ"],["を"],["傾むけず","かたむけず"],["、"]]},{"verse":14,"text":"集,あつまりの中,なか、会衆,かいしゅうのうちにあって、わたしは、破滅,はめつに陥,おちいりかけた」と。","tok":[["集まり","あつまり"],["の"],["中","なか"],["、"],["会衆","かいしゅう"],["の"],["うち"],["に"],["あって"],["、"],["わたし"],["は"],["、"],["破滅","はめつ"],["に"],["陥ち","おち"],["いり"],["かけた"],["」"],["と"],["。"]]},{"verse":15,"text":"あなたは自分,じぶんの水,みずためから水,みずを飲,のみ、自分,じぶんの井戸,いどから、わき出,です水,みずを飲,のむがよい。","tok":[["あなた"],["は"],["自分","じぶん"],["の"],["水","みず"],["ため"],["から"],["水","みず"],["を"],["飲み","のみ"],["、"],["自分","じぶん"],["の"],["井戸","いど"],["から"],["、"],["わき出す","わきです"],["水","みず"],["を"],["飲む","のむ"],["が"],["よい"],["。"]]},{"verse":16,"text":"あなたの泉,いずみを、外,そとにまきちらし、水,みずの流,ながれを、ちまたに流,ながしてよかろうか。","tok":[["あなた"],["の"],["泉","いずみ"],["を"],["、"],["外","そと"],["に"],["まきちらし"],["、"],["水","みず"],["の"],["流れ","ながれ"],["を"],["、"],["ちまた"],["に"],["流して","ながして"],["よかろう"],["か"],["。"]]},{"verse":17,"text":"それを自分,じぶんだけのものとし、他人,たにんを共,ともにあずからせてはならない。","tok":[["それ"],["を"],["自分","じぶん"],["だけ"],["の"],["もの"],["と"],["し"],["、"],["他人","たにん"],["を"],["共","とも"],["に"],["あずからせて"],["は"],["ならない"],["。"]]},{"verse":18,"text":"あなたの泉,いずみに祝福,しゅくふくを受,うけさせ、あなたの若,わかい時,ときの妻,つまを楽,たのしめ。","tok":[["あなた"],["の"],["泉","いずみ"],["に"],["祝福","しゅくふく"],["を"],["受させ","うけさせ"],["、"],["あなた"],["の"],["若い","わかい"],["時","とき"],["の"],["妻","つま"],["を"],["楽め","たのしめ"],["。"]]},{"verse":19,"text":"彼女,かのじょは愛,あいらしい雌,めじか、美,うつくしいしかのようだ。いつも、その乳,ちぶさをもって満足,まんぞくし、その愛,あいをもって常,つねに喜,よろこべ。","tok":[["彼女","かのじょ"],["は"],["愛らしい","あいらしい"],["雌","め"],["じ"],["か"],["、"],["美しい","うつくしい"],["し"],["か"],["の"],["よう"],["だ"],["。"],["いつも"],["、"],["その"],["乳ぶさ","ちぶさ"],["を"],["もって"],["満足","まんぞく"],["し"],["、"],["その"],["愛","あい"],["を"],["もって"],["常","つね"],["に"],["喜こべ","よろこべ"],["。"]]},{"verse":20,"text":"わが子,こよ、どうして遊女,ゆうじょに迷,まよい、みだらな女,おんなの胸,むねをいだくのか。","tok":[["わが"],["子","こ"],["よ"],["、"],["どう"],["して"],["遊女","ゆうじょ"],["に"],["迷い","まよい"],["、"],["みだら"],["な"],["女","おんな"],["の"],["胸","むね"],["を"],["いだく"],["の"],["か"],["。"]]},{"verse":21,"text":"人,ひとの道,みちは主,しゅの目,めの前,まえにあり、主,しゅはすべて、その行,おこないを見守,みまもられる。","tok":[["人","ひと"],["の"],["道","みち"],["は"],["主","しゅ"],["の"],["目","め"],["の"],["前","まえ"],["に"],["あり"],["、"],["主","しゅ"],["は"],["すべて"],["、"],["その"],["行ない","おこない"],["を"],["見守られる","みまもられる"],["。"]]},{"verse":22,"text":"悪,あしき者,ものは自分,じぶんのとがに捕,とらえられ、自分,じぶんの罪,つみのなわにつながれる。","tok":[["悪しき","あしき"],["者","もの"],["は"],["自分","じぶん"],["の"],["とが"],["に"],["捕らえられ","とらえられ"],["、"],["自分","じぶん"],["の"],["罪","つみ"],["の"],["なわ"],["に"],["つながれる"],["。"]]},{"verse":23,"text":"彼,かれは、教訓,きょうくんがないために死,しに、その愚,おろかさの大,おおきいことによって滅,ほろびる。","tok":[["彼","かれ"],["は"],["、"],["教訓","きょうくん"],["が"],["ない"],["ため"],["に"],["死に","しに"],["、"],["その"],["愚か","おろか"],["さ"],["の"],["大きい","おおきい"],["こと"],["によって"],["滅びる","ほろびる"],["。"]]}]
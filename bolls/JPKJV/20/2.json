[{"verse":1,"text":"わが子,こよ、もしあなたがわたしの言葉,ことばを受,うけ、わたしの戒,いましめを、あなたの心,こころにおさめ、","tok":[["わが"],["子","こ"],["よ"],["、"],["もし"],["あなた"],["が"],["わたし"],["の"],["言葉","ことば"],["を"],["受け","うけ"],["、"],["わたし"],["の"],["戒しめ","いましめ"],["を"],["、"],["あなた"],["の"],["心","こころ"],["に"],["おさめ"],["、"]]},{"verse":2,"text":"あなたの耳,みみを知恵,ちえに傾,かたむけ、あなたの心,こころを悟,さとりに向,むけ、","tok":[["あなた"],["の"],["耳","みみ"],["を"],["知恵","ちえ"],["に"],["傾むけ","かたむけ"],["、"],["あなた"],["の"],["心","こころ"],["を"],["悟り","さとり"],["に"],["向け","むけ"],["、"]]},{"verse":3,"text":"しかも、もし知識,ちしきを呼,よび求,もとめ、悟,さとりを得,えようと、あなたの声,こえをあげ、","tok":[["しかも"],["、"],["もし"],["知識","ちしき"],["を"],["呼び求め","よびもとめ"],["、"],["悟り","さとり"],["を"],["得よう","えよう"],["と"],["、"],["あなた"],["の"],["声","こえ"],["を"],["あげ"],["、"]]},{"verse":4,"text":"銀,ぎんを求,もとめるように、これを求,もとめ、かくれた宝,たからを尋,たずねるように、これを尋,たずねるならば、","tok":[["銀","ぎん"],["を"],["求める","もとめる"],["よう"],["に"],["、"],["これ"],["を"],["求め","もとめ"],["、"],["かくれた"],["宝","たから"],["を"],["尋ねる","たずねる"],["よう"],["に"],["、"],["これ"],["を"],["尋ねるならば","たずねるならば"],["、"]]},{"verse":5,"text":"あなたは、主,しゅを恐,おそれることを悟,さとり、神,かみを知,しることができるようになる。","tok":[["あなた"],["は"],["、"],["主","しゅ"],["を"],["恐れる","おそれる"],["こと"],["を"],["悟り","さとり"],["、"],["神","かみ"],["を"],["知る","しる"],["こと"],["が"],["できる"],["よう"],["に"],["なる"],["。"]]},{"verse":6,"text":"これは、主,しゅが知恵,ちえを与,あたえ、知識,ちしきと悟,さとりとは、み口,くちから出,でるからである。","tok":[["これ"],["は"],["、"],["主","しゅ"],["が"],["知恵","ちえ"],["を"],["与","あたえ"],["、"],["知識","ちしき"],["と"],["悟り","さとり"],["と"],["は"],["、"],["み口","みくち"],["から"],["出る","でる"],["から"],["で"],["ある"],["。"]]},{"verse":7,"text":"彼,かれは正,ただしい人,ひとのために、確,たしかな知恵,ちえをたくわえ、誠実,せいじつに歩,あゆむ者,ものの盾,たてとなって、","tok":[["彼","かれ"],["は"],["正い","ただしい"],["人","ひと"],["の"],["ため"],["に"],["、"],["確か","たしか"],["な"],["知恵","ちえ"],["を"],["たくわえ"],["、"],["誠実","せいじつ"],["に"],["歩む","あゆむ"],["者","もの"],["の"],["盾","たて"],["と"],["なって"],["、"]]},{"verse":8,"text":"公正,こうせいの道,みちを保,たもち、その聖徒,せいとたちの道筋,みちすじを守,まもられる。","tok":[["公正","こうせい"],["の"],["道","みち"],["を"],["保ち","たもち"],["、"],["その"],["聖徒","せいと"],["たち"],["の"],["道筋","みちすじ"],["を"],["守られる","まもられる"],["。"]]},{"verse":9,"text":"そのとき、あなたは、ついに正義,せいぎと公正,こうせい、公平,こうへいとすべての良,よい道,みちを悟,さとる。","tok":[["その"],["とき"],["、"],["あなた"],["は"],["、"],["ついに"],["正義","せいぎ"],["と"],["公正","こうせい"],["、"],["公平","こうへい"],["と"],["すべて"],["の"],["良い","よい"],["道","みち"],["を"],["悟","さとる"],["。"]]},{"verse":10,"text":"これは知恵,ちえが、あなたの心,こころにはいり、知識,ちしきがあなたの魂,たましいに楽,たのしみとなるからである。","tok":[["これ"],["は"],["知恵","ちえ"],["が"],["、"],["あなた"],["の"],["心","こころ"],["に"],["はいり"],["、"],["知識","ちしき"],["が"],["あなた"],["の"],["魂","たましい"],["に"],["楽み","たのしみ"],["と"],["なる"],["から"],["で"],["ある"],["。"]]},{"verse":11,"text":"慎,つつしみはあなたを守,まもり、悟,さとりはあなたを保,たもって、","tok":[["慎しみ","つつしみ"],["は"],["あなた"],["を"],["守り","まもり"],["、"],["悟り","さとり"],["は"],["あなた"],["を"],["保って","たもって"],["、"]]},{"verse":12,"text":"悪,あくの道,みちからあなたを救,すくい、偽,いつわりをいう者,ものから救,すくう。","tok":[["悪","あく"],["の"],["道","みち"],["から"],["あなた"],["を"],["救い","すくい"],["、"],["偽り","いつわり"],["を"],["いう"],["者","もの"],["から"],["救う","すくう"],["。"]]},{"verse":13,"text":"彼,かれらは正,ただしい道,みちを離,はなれて、暗,くらい道,みちに歩,あゆみ、","tok":[["彼","かれ"],["ら"],["は"],["正い","ただしい"],["道","みち"],["を"],["離れて","はなれて"],["、"],["暗い","くらい"],["道","みち"],["に"],["歩み","あゆみ"],["、"]]},{"verse":14,"text":"悪,あくを行,おこなうことを楽,たのしみ、悪人,あくにんの偽,いつわりを喜,よろこび、","tok":[["悪","あく"],["を"],["行なう","おこなう"],["こと"],["を"],["楽み","たのしみ"],["、"],["悪人","あくにん"],["の"],["偽り","いつわり"],["を"],["喜こび","よろこび"],["、"]]},{"verse":15,"text":"その道,みちは曲,まがり、その行,おこないは、よこしまである。","tok":[["その"],["道","みち"],["は"],["曲がり","まがり"],["、"],["その"],["行ない","おこない"],["は"],["、"],["よこしま"],["で"],["ある"],["。"]]},{"verse":16,"text":"慎,つつしみと悟,さとりはまたあなたを遊女,ゆうじょから救,すくい、言葉,ことばの巧,たくみな、みだらな女,おんなから救,すくう。","tok":[["慎しみ","つつしみ"],["と"],["悟り","さとり"],["は"],["また"],["あなた"],["を"],["遊女","ゆうじょ"],["から"],["救い","すくい"],["、"],["言葉","ことば"],["の"],["巧み","たくみ"],["な"],["、"],["みだら"],["な"],["女","おんな"],["から"],["救う","すくう"],["。"]]},{"verse":17,"text":"彼女,かのじょは若,わかい時,ときの友,ともを捨,すて、その神,かみに契約,けいやくしたことを忘,わすれている。","tok":[["彼女","かのじょ"],["は"],["若い","わかい"],["時","とき"],["の"],["友","とも"],["を"],["捨て","すて"],["、"],["その"],["神","かみ"],["に"],["契約","けいやく"],["した"],["こと"],["を"],["忘て","わすれて"],["いる"],["。"]]},{"verse":18,"text":"その家,いえは死,しに下,くだり、その道,みちは陰府,よみにおもむく。","tok":[["その"],["家","いえ"],["は"],["死","し"],["に"],["下り","くだり"],["、"],["その"],["道","みち"],["は"],["陰府","よみ"],["に"],["おもむく"],["。"]]},{"verse":19,"text":"すべて彼女,かのじょのもとへ行,いく者,ものは、帰,かえらない、また命,いのちの道,みちにいたらない。","tok":[["すべて"],["彼女","かのじょ"],["の"],["もと"],["へ"],["行く","いく"],["者","もの"],["は"],["、"],["帰えらない","かえらない"],["、"],["また"],["命","いのち"],["の"],["道","みち"],["に"],["いたらない"],["。"]]},{"verse":20,"text":"こうして、あなたは善良,ぜんりょうな人々,ひとびとの道,みちに歩,あゆみ、正,ただしい人々,ひとびとの道,みちを守,まもることができる。","tok":[["こう"],["して"],["、"],["あなた"],["は"],["善良","ぜんりょう"],["な"],["人々","ひとびと"],["の"],["道","みち"],["に"],["歩み","あゆみ"],["、"],["正い","ただしい"],["人々","ひとびと"],["の"],["道","みち"],["を"],["守","まもる"],["こと"],["が"],["できる"],["。"]]},{"verse":21,"text":"正,ただしい人,ひとは地,ちにながらえ、誠実,せいじつな人,ひとは地,ちにとどまる。","tok":[["正い","ただしい"],["人","ひと"],["は"],["地","ち"],["に"],["ながらえ"],["、"],["誠実","せいじつ"],["な"],["人","ひと"],["は"],["地","ち"],["に"],["とどまる"],["。"]]},{"verse":22,"text":"しかし悪,あしき者,ものは地,ちから断,たち滅,ほろぼされ、不信実,ふしんじつな者,ものは地,ちから抜,ぬき捨,すてられる。","tok":[["しかし"],["悪しき","あしき"],["者","もの"],["は"],["地","ち"],["から"],["断ち","たち"],["滅ぼされ","ほろぼされ"],["、"],["不","ふ"],["信実","しんじつ"],["な"],["者","もの"],["は"],["地","ち"],["から"],["抜き捨てられる","ぬきすてられる"],["。"]]}]
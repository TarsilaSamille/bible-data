[{"verse":1,"text":"治,おさめる人,ひとと共,ともに座,ざして食事,しょくじするとき、あなたの前,まえにあるものを、よくわきまえ、","tok":[["治める","おさめる"],["人","ひと"],["と"],["共","とも"],["に"],["座して","ざして"],["食事","しょくじ"],["する"],["とき"],["、"],["あなた"],["の"],["前","まえ"],["に"],["ある"],["もの"],["を"],["、"],["よく"],["わきまえ"],["、"]]},{"verse":2,"text":"あなたがもし食,しょくをたしなむ者,ものであるならば、あなたののどに刀,かたなをあてよ。","tok":[["あなた"],["が"],["もし"],["食","しょく"],["を"],["たしなむ"],["者","もの"],["で"],["あるならば"],["、"],["あなた"],["の"],["のど"],["に"],["刀","かたな"],["を"],["あて"],["よ"],["。"]]},{"verse":3,"text":"そのごちそうをむさぼり食,たべてはならない、これは人,ひとを欺,あざむく食物,しょくもつだからである。","tok":[["その"],["ごちそう"],["を"],["むさぼり食べて","むさぼりたべて"],["は"],["ならない"],["、"],["これ"],["は"],["人","ひと"],["を"],["欺く","あざむく"],["食物","しょくもつ"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":4,"text":"富,とみを得,えようと苦労,くろうしてはならない、かしこく思,おもいとどまるがよい。","tok":[["富","とみ"],["を"],["得よう","えよう"],["と"],["苦労","くろう"],["して"],["は"],["ならない"],["、"],["かしこく"],["思いとどまる","おもいとどまる"],["が"],["よい"],["。"]]},{"verse":5,"text":"あなたの目,めをそれにとめると、それはない、富,とみはたちまち自,みずから翼,つばさを生,しょうじて、わしのように天,てんに飛,とび去,さるからだ。","tok":[["あなた"],["の"],["目","め"],["を"],["それ"],["に"],["とめる"],["と"],["、"],["それ"],["は"],["ない"],["、"],["富","とみ"],["は"],["たちまち"],["自から","みずから"],["翼","つばさ"],["を"],["生じて","しょうじて"],["、"],["わし"],["の"],["よう"],["に"],["天","てん"],["に"],["飛び去る","とびさる"],["から"],["だ"],["。"]]},{"verse":6,"text":"物惜,ものおしみする人,ひとのパンを食,たべてはならない、そのごちそうをむさぼり願,ねがってはならない。","tok":[["物","もの"],["惜み","おしみ"],["する"],["人","ひと"],["の"],["パン"],["を"],["食べて","たべて"],["は"],["ならない"],["、"],["その"],["ごちそう"],["を"],["むさぼり"],["願って","ねがって"],["は"],["ならない"],["。"]]},{"verse":7,"text":"彼,かれは心,こころのうちで勘定,かんじょうする人,ひとのように、「食,くえ、飲,のめ」とあなたに言,いうけれども、その心,こころはあなたに真実,しんじつではない。","tok":[["彼","かれ"],["は"],["心","こころ"],["の"],["うち"],["で"],["勘定","かんじょう"],["する"],["人","ひと"],["の"],["よう"],["に"],["、"],["「"],["食え","くえ"],["、"],["飲め","のめ"],["」"],["と"],["あなた"],["に"],["言","いうけれど"],["も"],["、"],["その"],["心","こころ"],["は"],["あなた"],["に"],["真実","しんじつ"],["で"],["は"],["ない"],["。"]]},{"verse":8,"text":"あなたはついにその食,たべた物,ものを吐,はき出,だすようになり、あなたのねんごろな言葉,ことばもむだになる。","tok":[["あなた"],["は"],["ついに"],["その"],["食べた","たべた"],["物","もの"],["を"],["吐出す","はきだす"],["よう"],["に"],["なり"],["、"],["あなた"],["の"],["ねんごろ"],["な"],["言葉","ことば"],["も"],["むだ"],["に"],["なる"],["。"]]},{"verse":9,"text":"愚,おろかな者,ものの耳,みみに語,かたってはならない、彼,かれはあなたの言葉,ことばが示,しめす知恵,ちえをいやしめるからだ。","tok":[["愚か","おろか"],["な"],["者","もの"],["の"],["耳","みみ"],["に"],["語って","かたって"],["は"],["ならない"],["、"],["彼","かれ"],["は"],["あなた"],["の"],["言葉","ことば"],["が"],["示めす","しめす"],["知恵","ちえ"],["を"],["いやしめる"],["から"],["だ"],["。"]]},{"verse":10,"text":"古,ふるい地境,じざかいを移,うつしてはならない、みなしごの畑,はたけを侵,おかしてはならない。","tok":[["古い","ふるい"],["地境","じざかい"],["を"],["移して","うつして"],["は"],["ならない"],["、"],["みなしご"],["の"],["畑","はたけ"],["を"],["侵して","おかして"],["は"],["ならない"],["。"]]},{"verse":11,"text":"彼,かれらのあがない主,しゅは強,つよくいらせられ、あなたに逆,さからって彼,かれらの訴,うったえを弁護,べんごされるからだ。","tok":[["彼","かれ"],["ら"],["の"],["あがない"],["主","しゅ"],["は"],["強く","つよく"],["いらせられ"],["、"],["あなた"],["に"],["逆らって","さからって"],["彼","かれ"],["ら"],["の"],["訴","うったえ"],["を"],["弁護","べんご"],["される"],["から"],["だ"],["。"]]},{"verse":12,"text":"あなたの心,こころを教訓,きょうくんに用,もちい、あなたの耳,みみを知識,ちしきの言葉,ことばに傾,かたむけよ。","tok":[["あなた"],["の"],["心","こころ"],["を"],["教訓","きょうくん"],["に"],["用い","もちい"],["、"],["あなた"],["の"],["耳","みみ"],["を"],["知識","ちしき"],["の"],["言葉","ことば"],["に"],["傾むけよ","かたむけよ"],["。"]]},{"verse":13,"text":"子,こを懲,こらすことを、さし控,ひかえてはならない、むちで彼,かれを打,うっても死,しぬことはない。","tok":[["子","こ"],["を"],["懲らす","こらす"],["こと"],["を"],["、"],["さし"],["控","ひかえ"],["ては"],["ならない"],["、"],["むち"],["で"],["彼","かれ"],["を"],["打って","うって"],["も"],["死ぬ","しぬ"],["こと"],["は"],["ない"],["。"]]},{"verse":14,"text":"もし、むちで彼,かれを打,うつならば、その命,いのちを陰府,よみから救,すくうことができる。","tok":[["もし"],["、"],["むち"],["で"],["彼","かれ"],["を"],["打つならば","うつならば"],["、"],["その"],["命","いのち"],["を"],["陰府","よみ"],["から"],["救う","すくう"],["こと"],["が"],["できる"],["。"]]},{"verse":15,"text":"わが子,こよ、もしあなたの心,こころが賢,かしこくあれば、わたしの心,こころもまた喜,よろこび、","tok":[["わが"],["子","こ"],["よ"],["、"],["もし"],["あなた"],["の"],["心","こころ"],["が"],["賢しこく","かしこく"],["あれば"],["、"],["わたし"],["の"],["心","こころ"],["も"],["また"],["喜こび","よろこび"],["、"]]},{"verse":16,"text":"もしあなたのくちびるが正,ただしい事,ことを言,いうならば、わたしの心,こころも喜,よろこぶ。","tok":[["もし"],["あなた"],["の"],["くちびる"],["が"],["正い","ただしい"],["事","こと"],["を"],["言うならば","いうならば"],["、"],["わたし"],["の"],["心","こころ"],["も"],["喜こぶ","よろこぶ"],["。"]]},{"verse":17,"text":"心,こころに罪,つみびとをうらやんではならない、ただ、ひねもす主,しゅを恐,おそれよ。","tok":[["心","こころ"],["に"],["罪びと","つみびと"],["を"],["うらやんで"],["は"],["ならない"],["、"],["ただ"],["、"],["ひねもす"],["主","しゅ"],["を"],["恐れよ","おそれよ"],["。"]]},{"verse":18,"text":"かならず後,のちのよい報,むくいがあって、あなたの望,のぞみは、すたらない。","tok":[["かならず"],["後","のち"],["の"],["よい"],["報い","むくい"],["が"],["あって"],["、"],["あなた"],["の"],["望み","のぞみ"],["は"],["、"],["すたらない"],["。"]]},{"verse":19,"text":"わが子,こよ、よく聞,きいて、知恵,ちえを得,えよ、かつ、あなたの心,こころを道,みちに向,むけよ。","tok":[["わが"],["子","こ"],["よ"],["、"],["よく"],["聞いて","きいて"],["、"],["知恵","ちえ"],["を"],["得よ","えよ"],["、"],["かつ"],["、"],["あなた"],["の"],["心","こころ"],["を"],["道","みち"],["に"],["向けよ","むけよ"],["。"]]},{"verse":20,"text":"酒,さけにふけり、肉,にくをたしなむ者,ものと交,まじわってはならない。","tok":[["酒","さけ"],["に"],["ふけり"],["、"],["肉","にく"],["を"],["たしなむ"],["者","もの"],["と"],["交じわって","まじわって"],["は"],["ならない"],["。"]]},{"verse":21,"text":"酒,さけにふける者,ものと、肉,にくをたしなむ者,ものとは貧,まずしくなり、眠,ねむりをむさぼる者,ものは、ぼろを身,みにまとうようになる。","tok":[["酒","さけ"],["に"],["ふける"],["者","もの"],["と"],["、"],["肉","にく"],["を"],["たしなむ"],["者","もの"],["と"],["は"],["貧しく","まずしく"],["なり"],["、"],["眠","ねむり"],["を"],["むさぼる"],["者","もの"],["は"],["、"],["ぼろ"],["を"],["身","み"],["に"],["まとう"],["よう"],["に"],["なる"],["。"]]},{"verse":22,"text":"あなたを生,うんだ父,ちちのいうことを聞,きき、年老,としおいた母,ははを軽,かろんじてはならない。","tok":[["あなた"],["を"],["生んだ","うんだ"],["父","ちち"],["の"],["いう"],["こと"],["を"],["聞","きき"],["、"],["年老いた","としおいた"],["母","はは"],["を"],["軽","かろんじて"],["は"],["ならない"],["。"]]},{"verse":23,"text":"真理,しんりを買,かえ、これを売,うってはならない、知恵,ちえと教訓,きょうくんと悟,さとりをも買,かえ。","tok":[["真理","しんり"],["を"],["買え","かえ"],["、"],["これ"],["を"],["売って","うって"],["は"],["ならない"],["、"],["知恵","ちえ"],["と"],["教訓","きょうくん"],["と"],["悟り","さとり"],["を"],["も"],["買え","かえ"],["。"]]},{"verse":24,"text":"正,ただしい人,ひとの父,ちちは大,おおいによろこび、知恵,ちえある子,こを生,うむ者,ものは子,このために楽,たのしむ。","tok":[["正い","ただしい"],["人","ひと"],["の"],["父","ちち"],["は"],["大いに","おおいに"],["よろこび"],["、"],["知恵","ちえ"],["ある"],["子","こ"],["を"],["生む","うむ"],["者","もの"],["は"],["子","こ"],["の"],["ため"],["に"],["楽しむ","たのしむ"],["。"]]},{"verse":25,"text":"あなたの父母,ふぼを楽,たのしませ、あなたを産,うんだ母,ははを喜,よろこばせよ。","tok":[["あなた"],["の"],["父母","ふぼ"],["を"],["楽しませ","たのしませ"],["、"],["あなた"],["を"],["産んだ","うんだ"],["母","はは"],["を"],["喜こばせ","よろこばせ"],["よ"],["。"]]},{"verse":26,"text":"わが子,こよ、あなたの心,こころをわたしに与,あたえ、あなたの目,めをわたしの道,みちに注,そそげ。","tok":[["わが"],["子","こ"],["よ"],["、"],["あなた"],["の"],["心","こころ"],["を"],["わたし"],["に"],["与","あたえ"],["、"],["あなた"],["の"],["目","め"],["を"],["わたし"],["の"],["道","みち"],["に"],["注げ","そそげ"],["。"]]},{"verse":27,"text":"遊女,ゆうじょは深,ふかい穴,あなのごとく、みだらな女,おんなは狭,せまい井戸,いどのようだ。","tok":[["遊女","ゆうじょ"],["は"],["深","ふ"],["かい"],["穴","あな"],["の"],["ごとく"],["、"],["みだら"],["な"],["女","おんな"],["は"],["狭い","せまい"],["井戸","いど"],["の"],["よう"],["だ"],["。"]]},{"verse":28,"text":"彼女,かのじょは盗,ぬすびとのように人,ひとをうかがい、かつ世,よの人,ひとのうちに、不信実,ふしんじつな者,ものを多,おおくする。","tok":[["彼女","かのじょ"],["は"],["盗","ぬすびと"],["の"],["よう"],["に"],["人","ひと"],["を"],["うかがい"],["、"],["かつ"],["世","よ"],["の"],["人","ひと"],["の"],["うち"],["に"],["、"],["不","ふ"],["信実","しんじつ"],["な"],["者","もの"],["を"],["多く","おおく"],["する"],["。"]]},{"verse":29,"text":"災,わざわいある者,ものはだれか、憂,うれいある者,ものはだれか、争,あらそいをする者,ものはだれか、煩,わずらいある者,ものはだれか、ゆえなく傷,きずをうける者,ものはだれか、赤,あかい目,めをしている者,ものはだれか。","tok":[["災","わざわい"],["ある"],["者","もの"],["は"],["だれ"],["か"],["、"],["憂","うれい"],["ある"],["者","もの"],["は"],["だれ"],["か"],["、"],["争い","あらそい"],["を"],["する"],["者","もの"],["は"],["だれ"],["か"],["、"],["煩い","わずらい"],["ある"],["者","もの"],["は"],["だれ"],["か"],["、"],["ゆえ"],["なく"],["傷","きず"],["を"],["うける"],["者","もの"],["は"],["だれ"],["か"],["、"],["赤い","あかい"],["目","め"],["を"],["して"],["いる"],["者","もの"],["は"],["だれ"],["か"],["。"]]},{"verse":30,"text":"酒,さけに夜,よるをふかす者,もの、行,いって、混,まぜ合,あわせた酒,さけを味,あじわう者,ものである。","tok":[["酒","さけ"],["に"],["夜","よる"],["を"],["ふかす"],["者","もの"],["、"],["行って","いって"],["、"],["混ぜ","まぜ"],["合","あわせ"],["た"],["酒","さけ"],["を"],["味わう","あじわう"],["者","もの"],["で"],["ある"],["。"]]},{"verse":31,"text":"酒,さけはあかく、杯,はいの中,なかにあわだち、なめらかにくだる、あなたはこれを見,みてはならない。","tok":[["酒","さけ"],["は"],["あかく"],["、"],["杯","はい"],["の"],["中","なか"],["に"],["あわだち"],["、"],["なめらか"],["に"],["くだる"],["、"],["あなた"],["は"],["これ"],["を"],["見て","みて"],["は"],["ならない"],["。"]]},{"verse":32,"text":"これはついに、へびのようにかみ、まむしのように刺,さす。","tok":[["これ"],["は"],["ついに"],["、"],["へび"],["の"],["よう"],["に"],["かみ"],["、"],["まむし"],["の"],["よう"],["に"],["刺す","さす"],["。"]]},{"verse":33,"text":"あなたの目,めは怪,あやしいものを見,み、あなたの心,こころは偽,いつわりを言,いう。","tok":[["あなた"],["の"],["目","め"],["は"],["怪しい","あやしい"],["もの"],["を"],["見","み"],["、"],["あなた"],["の"],["心","こころ"],["は"],["偽り","いつわり"],["を"],["言う","いう"],["。"]]},{"verse":34,"text":"あなたは海,うみの中,なかに寝,ねている人,ひとのように、帆柱,ほばしらの上,うえに寝,ねている人,ひとのようになる。","tok":[["あなた"],["は"],["海","うみ"],["の"],["中","なか"],["に"],["寝て","ねて"],["いる"],["人","ひと"],["の"],["よう"],["に"],["、"],["帆柱","ほばしら"],["の"],["上","うえ"],["に"],["寝て","ねて"],["いる"],["人","ひと"],["の"],["よう"],["に"],["なる"],["。"]]},{"verse":35,"text":"あなたは言,いう、「人,ひとがわたしを撃,うったが、わたしは痛,いたくはなかった。わたしを、たたいたが、わたしは何,なにも覚,おぼえはない。いつわたしはさめるのか、また酒,さけを求,もとめよう」と。","tok":[["あなた"],["は"],["言う","いう"],["、"],["「"],["人","ひと"],["が"],["わたし"],["を"],["撃った","うった"],["が"],["、"],["わたし"],["は"],["痛く","いたく"],["は"],["なかった"],["。"],["わたし"],["を"],["、"],["たたいた"],["が"],["、"],["わたし"],["は"],["何に","なに"],["も"],["覚え","おぼえ"],["は"],["ない"],["。"],["いつ"],["わたし"],["は"],["さめる"],["の"],["か"],["、"],["また"],["酒","さけ"],["を"],["求めよう","もとめよう"],["」"],["と"],["。"]]}]
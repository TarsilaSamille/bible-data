[{"verse":1,"text":"知恵,ちえは呼,よばわらないのか、悟,さとりは声,こえをあげないのか。","tok":[["知恵","ちえ"],["は"],["呼ばわらない","よばわらない"],["の"],["か"],["、"],["悟り","さとり"],["は"],["声","こえ"],["を"],["あげない"],["の"],["か"],["。"]]},{"verse":2,"text":"これは道,みちのほとりの高,たかい所,ところの頂,いただき、また、ちまたの中,なかに立,たち、","tok":[["これ"],["は"],["道","みち"],["の"],["ほとり"],["の"],["高い","たかい"],["所","ところ"],["の"],["頂","いただき"],["、"],["また"],["、"],["ちまた"],["の"],["中","なか"],["に"],["立ち","たち"],["、"]]},{"verse":3,"text":"町,まちの入口,いりぐちにあるもろもろの門,もんのかたわら、正門,せいもんの入口,いりぐちで呼,よばわって言,いう、","tok":[["町","まち"],["の"],["入口","いりぐち"],["に"],["ある"],["もろもろ"],["の"],["門","もん"],["の"],["かたわら"],["、"],["正門","せいもん"],["の"],["入口","いりぐち"],["で"],["呼ばわって","よばわって"],["言う","いう"],["、"]]},{"verse":4,"text":"「人々,ひとびとよ、わたしはあなたがたに呼,よばわり、声,こえをあげて人,ひとの子,こらを呼,よぶ。","tok":[["「"],["人々","ひとびと"],["よ"],["、"],["わたし"],["は"],["あなた"],["がた"],["に"],["呼ばわり","よばわり"],["、"],["声","こえ"],["を"],["あげて"],["人","ひと"],["の"],["子","こ"],["ら"],["を"],["呼ぶ","よぶ"],["。"]]},{"verse":5,"text":"思慮,しりょのない者,ものよ、悟,さとりを得,えよ、愚,おろかな者,ものよ、知恵,ちえを得,えよ。","tok":[["思慮","しりょ"],["の"],["ない"],["者","もの"],["よ"],["、"],["悟り","さとり"],["を"],["得よ","えよ"],["、"],["愚か","おろか"],["な"],["者","もの"],["よ"],["、"],["知恵","ちえ"],["を"],["得","え"],["よ"],["。"]]},{"verse":6,"text":"聞,きけ、わたしは高貴,こうきな事,ことを語,かたり、わがくちびるは正,ただしい事,ことを語,かたり出,だす。","tok":[["聞け","きけ"],["、"],["わたし"],["は"],["高貴","こうき"],["な"],["事","こと"],["を"],["語り","かたり"],["、"],["わが"],["くちびる"],["は"],["正い","ただしい"],["事","こと"],["を"],["語り","かたり"],["出す","だす"],["。"]]},{"verse":7,"text":"わが口,くちは真実,しんじつを述,のべ、わがくちびるは悪,あしき事,ことを憎,にくむ。","tok":[["わが"],["口","くち"],["は"],["真実","しんじつ"],["を"],["述べ","のべ"],["、"],["わが"],["くちびる"],["は"],["悪しき","あしき"],["事","こと"],["を"],["憎む","にくむ"],["。"]]},{"verse":8,"text":"わが口,くちの言葉,ことばはみな正,ただしい、そのうちに偽,いつわりと、よこしまはない。","tok":[["わが"],["口","くち"],["の"],["言葉","ことば"],["は"],["みな"],["正い","ただしい"],["、"],["その"],["うち"],["に"],["偽り","いつわり"],["と"],["、"],["よこしま"],["は"],["ない"],["。"]]},{"verse":9,"text":"これはみな、さとき者,ものの明,あきらかにするところ、知識,ちしきを得,える者,ものの正,ただしとするところである。","tok":[["これ"],["は"],["みな"],["、"],["さ"],["とき"],["者","もの"],["の"],["明か","あきらか"],["に"],["する"],["ところ"],["、"],["知識","ちしき"],["を"],["得る","える"],["者","もの"],["の"],["正し","ただし"],["と"],["する"],["ところ"],["で"],["ある"],["。"]]},{"verse":10,"text":"あなたがたは銀,ぎんを受,うけるよりも、わたしの教,おしえを受,うけよ、精,せい金,きんよりも、むしろ知識,ちしきを得,えよ。","tok":[["あなた"],["がた"],["は"],["銀","ぎん"],["を"],["受る","うける"],["より"],["も"],["、"],["わたし"],["の"],["教え","おしえ"],["を"],["受よ","うけよ"],["、"],["精金","せいきん"],["より"],["も"],["、"],["むしろ"],["知識","ちしき"],["を"],["得","え"],["よ"],["。"]]},{"verse":11,"text":"知恵,ちえは宝石,ほうせきにまさり、あなたがたの望,のぞむすべての物,ものは、これと比,くらべるにたりない。","tok":[["知恵","ちえ"],["は"],["宝石","ほうせき"],["に"],["まさり"],["、"],["あなた"],["がた"],["の"],["望む","のぞむ"],["すべて"],["の"],["物","もの"],["は"],["、"],["これ"],["と"],["比べる","くらべる"],["に"],["たりない"],["。"]]},{"verse":12,"text":"知恵,ちえであるわたしは悟,さとりをすみかとし、知識,ちしきと慎,つつしみとをもつ。","tok":[["知恵","ちえ"],["で"],["ある"],["わたし"],["は"],["悟り","さとり"],["を"],["すみか"],["と"],["し"],["、"],["知識","ちしき"],["と"],["慎しみ","つつしみ"],["と"],["を"],["もつ"],["。"]]},{"verse":13,"text":"主,しゅを恐,おそれるとは悪,あくを憎,にくむことである。わたしは高,たかぶりと、おごりと、悪,あしき道,みちと、偽,いつわりの言葉,ことばとを憎,にくむ。","tok":[["主","しゅ"],["を"],["恐れる","おそれる"],["と"],["は"],["悪","あく"],["を"],["憎む","にくむ"],["こと"],["で"],["ある"],["。"],["わたし"],["は"],["高か","たか"],["ぶり"],["と"],["、"],["おごり"],["と"],["、"],["悪しき","あしき"],["道","みち"],["と"],["、"],["偽わり","いつわり"],["の"],["言葉","ことば"],["と"],["を"],["憎む","にくむ"],["。"]]},{"verse":14,"text":"計,はかりごとと、確,たしかな知恵,ちえとは、わたしにある、わたしには悟,さとりがあり、わたしには力,ちからがある。","tok":[["計り","はかり"],["ごと"],["と"],["、"],["確か","たしか"],["な"],["知恵","ちえ"],["と"],["は"],["、"],["わたし"],["に"],["ある"],["、"],["わたし"],["に"],["は"],["悟り","さとり"],["が"],["あり"],["、"],["わたし"],["に"],["は"],["力","ちから"],["が"],["ある"],["。"]]},{"verse":15,"text":"わたしによって、王,おうたる者,ものは世,よを治,おさめ、君,きみたる者,ものは正,ただしい定,さだめを立,たてる。","tok":[["わたし"],["によって"],["、"],["王","おう"],["たる"],["者","もの"],["は"],["世","よ"],["を"],["治め","おさめ"],["、"],["君","きみ"],["たる"],["者","もの"],["は"],["正い","ただしい"],["定め","さだめ"],["を"],["立る","たてる"],["。"]]},{"verse":16,"text":"わたしによって、主,しゅたる者,ものは支配,しはいし、つかさたる者,ものは地,ちを治,おさめる。","tok":[["わたし"],["によって"],["、"],["主たる","しゅたる"],["者","もの"],["は"],["支配","しはい"],["し"],["、"],["つかさ"],["たる"],["者","もの"],["は"],["地","ち"],["を"],["治める","おさめる"],["。"]]},{"verse":17,"text":"わたしは、わたしを愛,あいする者,ものを愛,あいする、わたしをせつに求,もとめる者,ものは、わたしに出会,であう。","tok":[["わたし"],["は"],["、"],["わたし"],["を"],["愛する","あいする"],["者","もの"],["を"],["愛する","あいする"],["、"],["わたし"],["を"],["せつ"],["に"],["求める","もとめる"],["者","もの"],["は"],["、"],["わたし"],["に"],["出会う","であう"],["。"]]},{"verse":18,"text":"富,とみと誉,ほまれとはわたしにあり、すぐれた宝,たからと繁栄,はんえいもまたそうである。","tok":[["富","とみ"],["と"],["誉","ほまれ"],["と"],["は"],["わたし"],["に"],["あり"],["、"],["すぐれた"],["宝","たから"],["と"],["繁栄","はんえい"],["も"],["また"],["そう"],["で"],["ある"],["。"]]},{"verse":19,"text":"わたしの実,みは金,きんよりも精,せい金,きんよりも良,よく、わたしの産物,さんぶつは精,せい銀,ぎんにまさる。","tok":[["わたし"],["の"],["実","み"],["は"],["金","きん"],["より"],["も"],["精金","せいきん"],["より"],["も"],["良く","よく"],["、"],["わたし"],["の"],["産物","さんぶつ"],["は"],["精銀","せいぎん"],["に"],["まさる"],["。"]]},{"verse":20,"text":"わたしは正義,せいぎの道,みち、公正,こうせいな道筋,みちすじの中,なかを歩,あゆみ、","tok":[["わたし"],["は"],["正義","せいぎ"],["の"],["道","みち"],["、"],["公正","こうせい"],["な"],["道筋","みちすじ"],["の"],["中","なか"],["を"],["歩み","あゆみ"],["、"]]},{"verse":21,"text":"わたしを愛,あいする者,ものに宝,たからを得,えさせ、またその倉,くらを満,みちさせる。","tok":[["わたし"],["を"],["愛する","あいする"],["者","もの"],["に"],["宝","たから"],["を"],["得させ","えさせ"],["、"],["また"],["その"],["倉","くら"],["を"],["満ちさせる","みちさせる"],["。"]]},{"verse":22,"text":"主,しゅが昔,むかしそのわざをなし始,はじめられるとき、そのわざの初,はじめとして、わたしを造,つくられた。","tok":[["主","しゅ"],["が"],["昔","むかし"],["その"],["わざ"],["を"],["なし"],["始められる","はじめられる"],["とき"],["、"],["その"],["わざ"],["の"],["初め","はじめ"],["として"],["、"],["わたし"],["を"],["造られた","つくられた"],["。"]]},{"verse":23,"text":"いにしえ、地,ちのなかった時,とき、初,はじめに、わたしは立,たてられた。","tok":[["いにしえ"],["、"],["地","ち"],["の"],["なかった"],["時","とき"],["、"],["初め","はじめ"],["に"],["、"],["わたし"],["は"],["立られた","たてられた"],["。"]]},{"verse":24,"text":"まだ海,うみもなく、また大,おおいなる水,みずの泉,いずみもなかった時,とき、わたしはすでに生,うまれ、","tok":[["まだ"],["海","うみ"],["も"],["なく"],["、"],["また"],["大いなる","おおいなる"],["水","みず"],["の"],["泉","いずみ"],["も"],["なかった"],["時","とき"],["、"],["わたし"],["は"],["すでに"],["生まれ","うまれ"],["、"]]},{"verse":25,"text":"山,やまもまだ定,さだめられず、丘,おかもまだなかった時,とき、わたしはすでに生,うまれた。","tok":[["山","やま"],["も"],["まだ"],["定められず","さだめられず"],["、"],["丘","おか"],["も"],["まだ"],["なかった"],["時","とき"],["、"],["わたし"],["は"],["すでに"],["生まれた","うまれた"],["。"]]},{"verse":26,"text":"すなわち神,かみがまだ地,ちをも野,のをも、地,ちのちりのもとをも造,つくられなかった時,ときである。","tok":[["すなわち"],["神","かみ"],["が"],["まだ"],["地","ち"],["を"],["も"],["野","の"],["を"],["も"],["、"],["地","ち"],["の"],["ちり"],["の"],["もと"],["を"],["も"],["造られなかった","つくられなかった"],["時","とき"],["で"],["ある"],["。"]]},{"verse":27,"text":"彼,かれが天,てんを造,つくり、海,うみのおもてに、大空,おおぞらを張,はられたとき、わたしはそこにあった。","tok":[["彼","かれ"],["が"],["天","てん"],["を"],["造","つくり"],["、"],["海","うみ"],["の"],["おもて"],["に"],["、"],["大空","おおぞら"],["を"],["張られた","はられた"],["とき"],["、"],["わたし"],["は"],["そこ"],["に"],["あった"],["。"]]},{"verse":28,"text":"彼,かれが上,うえに空,そらを堅,かたく立,たたせ、淵,ふちの泉,いずみをつよく定,さだめ、","tok":[["彼","かれ"],["が"],["上","うえ"],["に"],["空","そら"],["を"],["堅く","かたく"],["立たせ","たたせ"],["、"],["淵","ふち"],["の"],["泉","いずみ"],["を"],["つよく"],["定め","さだめ"],["、"]]},{"verse":29,"text":"海,うみにその限界,げんかいをたて、水,みずにその岸,きしを越,こえないようにし、また地,ちの基,もといを定,さだめられたとき、","tok":[["海","うみ"],["に"],["その"],["限界","げんかい"],["を"],["たて"],["、"],["水","みず"],["に"],["その"],["岸","きし"],["を"],["越えない","こえない"],["よう"],["に"],["し"],["、"],["また"],["地","ち"],["の"],["基い","もとい"],["を"],["定められた","さだめられた"],["とき"],["、"]]},{"verse":30,"text":"わたしは、そのかたわらにあって、名匠,めいしょうとなり、日々,ひびに喜,よろこび、常,つねにその前,まえに楽,たのしみ、","tok":[["わたし"],["は"],["、"],["その"],["かたわら"],["に"],["あって"],["、"],["名匠","めいしょう"],["と"],["なり"],["、"],["日々","ひび"],["に"],["喜こび","よろこび"],["、"],["常","つね"],["に"],["その"],["前","まえ"],["に"],["楽み","たのしみ"],["、"]]},{"verse":31,"text":"その地,ちで楽,たのしみ、また世,よの人,ひとを喜,よろこんだ。","tok":[["その"],["地","ち"],["で"],["楽み","たのしみ"],["、"],["また"],["世","よ"],["の"],["人","ひと"],["を"],["喜こんだ","よろこんだ"],["。"]]},{"verse":32,"text":"それゆえ、子供,こどもらよ、今,いまわたしの言,いうことを聞,きけ、わたしの道,みちを守,まもる者,ものはさいわいである。","tok":[["それ"],["ゆえ"],["、"],["子供","こども"],["ら"],["よ"],["、"],["今","いま"],["わたし"],["の"],["言う","いう"],["こと"],["を"],["聞け","きけ"],["、"],["わたし"],["の"],["道","みち"],["を"],["守者","まもるもの"],["は"],["さいわい"],["で"],["ある"],["。"]]},{"verse":33,"text":"教訓,きょうくんを聞,きいて、知恵,ちえを得,えよ、これを捨,すててはならない。","tok":[["教訓","きょうくん"],["を"],["聞いて","きいて"],["、"],["知恵","ちえ"],["を"],["得よ","えよ"],["、"],["これ"],["を"],["捨てて","すてて"],["は"],["ならない"],["。"]]},{"verse":34,"text":"わたしの言,いうことを聞,きき、日々,ひびわたしの門,もんのかたわらでうかがい、わたしの戸口,とぐちの柱,はしらのわきで待,まつ人,ひとはさいわいである。","tok":[["わたし"],["の"],["言う","いう"],["こと"],["を"],["聞","きき"],["、"],["日々","ひび"],["わたし"],["の"],["門","もん"],["の"],["かたわら"],["で"],["うかがい"],["、"],["わたし"],["の"],["戸口","とぐち"],["の"],["柱","はしら"],["の"],["わき"],["で"],["待つ","まつ"],["人","ひと"],["は"],["さいわい"],["で"],["ある"],["。"]]},{"verse":35,"text":"それは、わたしを得,える者,ものは命,いのちを得,え、主,しゅから恵,めぐみを得,えるからである。","tok":[["それ"],["は"],["、"],["わたし"],["を"],["得る","える"],["者","もの"],["は"],["命","いのち"],["を"],["得","え"],["、"],["主ら","しゅから"],["恵","めぐみ"],["を"],["得る","える"],["から"],["で"],["ある"],["。"]]},{"verse":36,"text":"わたしを失,うしなう者,ものは自分,じぶんの命,いのちをそこなう、すべてわたしを憎,にくむ者,ものは死,しを愛,あいする者,ものである」。","tok":[["わたし"],["を"],["失なう","うしなう"],["者","もの"],["は"],["自分","じぶん"],["の"],["命","いのち"],["を"],["そこなう"],["、"],["すべて"],["わたし"],["を"],["憎む","にくむ"],["者","もの"],["は"],["死","し"],["を"],["愛する","あいする"],["者","もの"],["で"],["ある"],["」"],["。"]]}]
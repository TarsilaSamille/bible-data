[{"verse":1,"text":"わが子,こよ、わたしの言葉,ことばを守,まもり、わたしの戒,いましめをあなたの心,こころにたくわえよ。","tok":[["わが"],["子","こ"],["よ"],["、"],["わたし"],["の"],["言葉","ことば"],["を"],["守り","まもり"],["、"],["わたし"],["の"],["戒しめ","いましめ"],["を"],["あなた"],["の"],["心","こころ"],["に"],["たくわえ"],["よ"],["。"]]},{"verse":2,"text":"わたしの戒,いましめを守,まもって命,いのちを得,えよ、わたしの教,おしえを守,まもること、ひとみを守,まもるようにせよ。","tok":[["わたし"],["の"],["戒しめ","いましめ"],["を"],["守って","まもって"],["命","いのち"],["を"],["得よ","えよ"],["、"],["わたし"],["の"],["教え","おしえ"],["を"],["守","まもる"],["こと"],["、"],["ひとみ"],["を"],["守","まもる"],["よう"],["に"],["せよ"],["。"]]},{"verse":3,"text":"これをあなたの指,ゆびにむすび、これをあなたの心,こころの碑,いしぶみにしるせ。","tok":[["これ"],["を"],["あなた"],["の"],["指","ゆび"],["に"],["むすび"],["、"],["これ"],["を"],["あなた"],["の"],["心","こころ"],["の"],["碑","いしぶみ"],["に"],["しるせ"],["。"]]},{"verse":4,"text":"知恵,ちえに向,むかって、「あなたはわが姉妹,しまいだ」と言,いい、悟,さとりに向,むかっては、あなたの友,ともと呼,よべ。","tok":[["知恵","ちえ"],["に"],["向かって","むかって"],["、"],["「"],["あなた"],["は"],["わが"],["姉妹","しまい"],["だ"],["」"],["と"],["言い","いい"],["、"],["悟り","さとり"],["に"],["向かって","むかって"],["は"],["、"],["あなた"],["の"],["友","とも"],["と"],["呼べ","よべ"],["。"]]},{"verse":5,"text":"そうすれば、これはあなたを守,まもって遊女,ゆうじょに迷,まよわせず、言葉,ことば巧,たくみな、みだらな女,おんなに近,ちかづかせない。","tok":[["そう"],["すれば"],["、"],["これ"],["は"],["あなた"],["を"],["守って","まもって"],["遊女","ゆうじょ"],["に"],["迷わせず","まよわせず"],["、"],["言葉","ことば"],["巧み","たくみ"],["な"],["、"],["みだら"],["な"],["女","おんな"],["に"],["近づかせない","ちかづかせない"],["。"]]},{"verse":6,"text":"わたしはわが家,いえの窓,まどにより、格子,こうし窓,まどから外,そとをのぞいて、","tok":[["わたし"],["は"],["わが家","わがいえ"],["の"],["窓","まど"],["に"],["より"],["、"],["格子窓","こうしまど"],["から"],["外","そと"],["を"],["のぞいて"],["、"]]},{"verse":7,"text":"思慮,しりょのない者,もののうちに、若,わかい者,もののうちに、ひとりの知恵,ちえのない若者,わかもののいるのを見,みた。","tok":[["思慮","しりょ"],["の"],["ない"],["者","もの"],["の"],["うち"],["に"],["、"],["若い","わかい"],["者","もの"],["の"],["うち"],["に"],["、"],["ひとり"],["の"],["知恵","ちえ"],["の"],["ない"],["若者","わかもの"],["の"],["いる"],["の"],["を"],["見た","みた"],["。"]]},{"verse":8,"text":"彼,かれはちまたを過,すぎ、女,おんなの家,いえに行,いく曲,まがりかどに近,ちかづき、その家,いえに行,いく道,みちを、","tok":[["彼","かれ"],["は"],["ちまた"],["を"],["過","すぎ"],["、"],["女","おんな"],["の"],["家","いえ"],["に"],["行く","いく"],["曲がり","まがり"],["かど"],["に"],["近づき","ちかづき"],["、"],["その"],["家","いえ"],["に"],["行く","いく"],["道","みち"],["を"],["、"]]},{"verse":9,"text":"たそがれに、よいに、また夜中,よなかに、また暗,くらやみに歩,あるいていった。","tok":[["たそがれ"],["に"],["、"],["よい"],["に"],["、"],["また"],["夜中","よなか"],["に"],["、"],["また"],["暗やみ","くらやみ"],["に"],["歩いて","あるいて"],["いった"],["。"]]},{"verse":10,"text":"見,みよ、遊女,ゆうじょの装,よそおいをした陰険,いんけんな女,おんなが彼,かれに会,あう。","tok":[["見よ","みよ"],["、"],["遊女","ゆうじょ"],["の"],["装い","よそおい"],["を"],["した"],["陰険","いんけん"],["な"],["女","おんな"],["が"],["彼","かれ"],["に"],["会う","あう"],["。"]]},{"verse":11,"text":"この女,おんなは、騒,さわがしくて、慎,つつしみなく、その足,あしは自分,じぶんの家,いえにとどまらず、","tok":[["この"],["女","おんな"],["は"],["、"],["騒がしくて","さわがしくて"],["、"],["慎しみ","つつしみ"],["なく"],["、"],["その"],["足","あし"],["は"],["自分","じぶん"],["の"],["家","いえ"],["に"],["とどまらず"],["、"]]},{"verse":12,"text":"ある時,ときはちまたにあり、ある時,ときは市場,しじょうにあり、すみずみに立,たって人,ひとをうかがう。","tok":[["ある"],["時","とき"],["は"],["ちまた"],["に"],["あり"],["、"],["ある"],["時","とき"],["は"],["市場","しじょう"],["に"],["あり"],["、"],["すみずみ"],["に"],["立って","たって"],["人","ひと"],["を"],["うかがう"],["。"]]},{"verse":13,"text":"この女,おんなは彼,かれを捕,とらえて口,くちづけし、恥,はじしらぬ顔,かおで彼,かれに言,いう、","tok":[["この"],["女","おんな"],["は"],["彼","かれ"],["を"],["捕らえて","とらえて"],["口づけ","くちづけ"],["し"],["、"],["恥","はじ"],["しらぬ"],["顔","かお"],["で"],["彼","かれ"],["に"],["言う","いう"],["、"]]},{"verse":14,"text":"「わたしは酬恩祭,しゅうおんさいをささげなければならなかったが、きょう、その誓,ちかいを果,はたしました。","tok":[["「"],["わたし"],["は"],["酬恩祭","しゅうおんさい"],["を"],["ささげなければ"],["ならなかった"],["が"],["、"],["きょう"],["、"],["その"],["誓い","ちかい"],["を"],["果たしました","はたしました"],["。"]]},{"verse":15,"text":"それでわたしはあなたを迎,むかえようと出,でて、あなたを尋,たずね、あなたに会,あいました。","tok":[["それ"],["で"],["わたし"],["は"],["あなた"],["を"],["迎","むかえ"],["よう"],["と"],["出て","でて"],["、"],["あなた"],["を"],["尋ね","たずね"],["、"],["あなた"],["に"],["会いました","あいました"],["。"]]},{"verse":16,"text":"わたしは床,とこに美,うつくしい、しとねと、エジプトのあや布,ぬのを敷,しき、","tok":[["わたし"],["は"],["床","とこ"],["に"],["美しい","うつくしい"],["、"],["しとね"],["と"],["、"],["エジプト"],["の"],["あや"],["布","ぬの"],["を"],["敷","しき"],["、"]]},{"verse":17,"text":"没薬,もつやく、ろかい、桂皮,けいひをもってわたしの床,とこをにおわせました。","tok":[["没薬","もつやく"],["、"],["ろか"],["い"],["、"],["桂皮","けいひ"],["を"],["もって"],["わたし"],["の"],["床","とこ"],["を"],["におわせました"],["。"]]},{"verse":18,"text":"さあ、わたしたちは夜,よるが明,あけるまで、情,じょうをつくし、愛,あいをかわして楽,たのしみましょう。","tok":[["さあ"],["、"],["わたしたち"],["は"],["夜","よる"],["が"],["明ける","あける"],["まで"],["、"],["情","じょう"],["を"],["つくし"],["、"],["愛","あい"],["を"],["かわして"],["楽み","たのしみ"],["ましょう"],["。"]]},{"verse":19,"text":"夫,おっとは家,いえにいません、遠,とおくへ旅立,たびだち、","tok":[["夫","おっと"],["は"],["家","いえ"],["に"],["いません"],["、"],["遠く","とおく"],["へ"],["旅立ち","たびだち"],["、"]]},{"verse":20,"text":"手,てに金,かね袋,ぶくろを持,もって出,でました。満月,まんげつになるまでは帰,かえりません」と。","tok":[["手","て"],["に"],["金","か"],["ね"],["袋","ぶくろ"],["を"],["持って","もって"],["出ました","でました"],["。"],["満月","まんげつ"],["に"],["なる"],["まで"],["は"],["帰えりません","かえりません"],["」"],["と"],["。"]]},{"verse":21,"text":"女,おんなが多,おおくの、なまめかしい言葉,ことばをもって彼,かれを惑,まどわし、巧,たくみなくちびるをもって、いざなうと、","tok":[["女","おんな"],["が"],["多く","おおく"],["の"],["、"],["なまめかしい"],["言葉","ことば"],["を"],["もって"],["彼","かれ"],["を"],["惑わし","まどわし"],["、"],["巧","たくみ"],["な"],["くちびる"],["を"],["もって"],["、"],["いざなう"],["と"],["、"]]},{"verse":22,"text":"若,わかい人,ひとは直,ただちに女,おんなに従,したがった、あたかも牛,うしが、ほふり場,ばに行,いくように、雄,おじかが、すみやかに捕,とらえられ、","tok":[["若い","わかい"],["人","ひと"],["は"],["直ちに","ただちに"],["女","おんな"],["に"],["従った","したがった"],["、"],["あたかも"],["牛","うし"],["が"],["、"],["ほふり場","ほふりば"],["に"],["行く","いく"],["よう"],["に"],["、"],["雄","お"],["じか"],["が"],["、"],["すみやか"],["に"],["捕らえられ","とらえられ"],["、"]]},{"verse":23,"text":"ついに、矢,やがその内臓,ないぞうを突,つき刺,さすように、鳥,とりがすみやかに網,あみにかかるように、彼,かれは自分,じぶんが命,いのちを失,うしなうようになることを知,しらない。","tok":[["ついに"],["、"],["矢","や"],["が"],["その"],["内臓","ないぞう"],["を"],["突き刺す","つきさす"],["よう"],["に"],["、"],["鳥","とり"],["が"],["すみやか"],["に"],["網","あみ"],["に"],["かかる"],["よう"],["に"],["、"],["彼","かれ"],["は"],["自分","じぶん"],["が"],["命","いのち"],["を"],["失なう","うしなう"],["よう"],["に"],["なる"],["こと"],["を"],["知らない","しらない"],["。"]]},{"verse":24,"text":"子供,こどもらよ、今,いまわたしの言,いうことを聞,きき、わが口,くちの言葉,ことばに耳,みみを傾,かたむけよ。","tok":[["子供","こども"],["ら"],["よ"],["、"],["今","いま"],["わたし"],["の"],["言う","いう"],["こと"],["を"],["聞","きき"],["、"],["わが"],["口","くち"],["の"],["言葉","ことば"],["に"],["耳","みみ"],["を"],["傾むけよ","かたむけよ"],["。"]]},{"verse":25,"text":"あなたの心,こころを彼女,かのじょの道,みちに傾,かたむけてはならない、またその道,みちに迷,まよってはならない。","tok":[["あなた"],["の"],["心","こころ"],["を"],["彼女","かのじょ"],["の"],["道","みち"],["に"],["傾むけて","かたむけて"],["は"],["ならない"],["、"],["また"],["その"],["道","みち"],["に"],["迷って","まよって"],["は"],["ならない"],["。"]]},{"verse":26,"text":"彼女,かのじょは多,おおくの人,ひとを傷,きずつけて倒,たおした、まことに、彼女,かのじょに殺,ころされた者,ものは多,おおい。","tok":[["彼女","かのじょ"],["は"],["多く","おおく"],["の"],["人","ひと"],["を"],["傷つけて","きずつけて"],["倒した","たおした"],["、"],["まこと"],["に"],["、"],["彼女","かのじょ"],["に"],["殺ろされた","ころされた"],["者","もの"],["は"],["多い","おおい"],["。"]]},{"verse":27,"text":"その家,いえは陰府,よみへ行,いく道,みちであって、死,しのへやへ下,くだって行,いく。","tok":[["その"],["家","いえ"],["は"],["陰府","よみ"],["へ"],["行く","いく"],["道","みち"],["で"],["あって"],["、"],["死","し"],["の"],["へや"],["へ"],["下って","くだって"],["行く","いく"],["。"]]}]
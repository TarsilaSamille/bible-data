[{"verse":1,"text":"しばしばしかられても、なおかたくなな者,ものは、たちまち打,うち敗,やぶられて助,たすかることはない。","tok":[["しばしば"],["しかられて"],["も"],["、"],["なお"],["かたくな"],["な"],["者","もの"],["は"],["、"],["たちまち"],["打ち","うち"],["敗られて","やぶられて"],["助かる","たすかる"],["こと"],["は"],["ない"],["。"]]},{"verse":2,"text":"正,ただしい者,ものが権力,けんりょくを得,えれば民,たみは喜,よろこび、悪,あしき者,ものが治,おさめるとき、民,たみはうめき苦,くるしむ。","tok":[["正い","ただしい"],["者","もの"],["が"],["権力","けんりょく"],["を"],["得れば","えれば"],["民","たみ"],["は"],["喜こび","よろこび"],["、"],["悪しき","あしき"],["者","もの"],["が"],["治める","おさめる"],["とき"],["、"],["民","たみ"],["は"],["うめき苦しむ","うめきくるしむ"],["。"]]},{"verse":3,"text":"知恵,ちえを愛,あいする人,ひとはその父,ちちを喜,よろこばせ、遊女,ゆうじょに交,まじわる者,ものはその資産,しさんを浪費,ろうひする。","tok":[["知恵","ちえ"],["を"],["愛する","あいする"],["人","ひと"],["は"],["その"],["父","ちち"],["を"],["喜こばせ","よろこばせ"],["、"],["遊女","ゆうじょ"],["に"],["交じわる","まじわる"],["者","もの"],["は"],["その"],["資産","しさん"],["を"],["浪費","ろうひ"],["する"],["。"]]},{"verse":4,"text":"王,おうは公儀,こうぎをもって国,くにを堅,かたくする、しかし、重税,じゅうぜいを取,とり立,たてる者,ものはこれを滅,ほろぼす。","tok":[["王","おう"],["は"],["公儀","こうぎ"],["を"],["もって"],["国","くに"],["を"],["堅く","かたく"],["する"],["、"],["しかし"],["、"],["重税","じゅうぜい"],["を"],["取立","とりたて"],["る"],["者","もの"],["は"],["これ"],["を"],["滅ぼす","ほろぼす"],["。"]]},{"verse":5,"text":"その隣,となり人,びとにへつらう者,ものは、彼,かれの足,あしの前,まえに網,あみを張,はる。","tok":[["その"],["隣人","となりびと"],["に"],["へつらう"],["者","もの"],["は"],["、"],["彼","かれ"],["の"],["足","あし"],["の"],["前","まえ"],["に"],["網","あみ"],["を"],["張る","はる"],["。"]]},{"verse":6,"text":"悪人,あくにんは自分,じぶんの罪,つみのわなに陥,おちいる、しかし正,ただしい人,ひとは喜,よろこび楽,たのしむ。","tok":[["悪人","あくにん"],["は"],["自分","じぶん"],["の"],["罪","つみ"],["の"],["わな"],["に"],["陥ち","おち"],["いる"],["、"],["しかし"],["正い","ただしい"],["人","ひと"],["は"],["喜こび","よろこび"],["楽しむ","たのしむ"],["。"]]},{"verse":7,"text":"正,ただしい人,ひとは貧,まずしい者,ものの訴,うったえをかえりみる、悪,あしき人,ひとはそれを知,しろうとはしない。","tok":[["正い","ただしい"],["人","ひと"],["は"],["貧しい","まずしい"],["者","もの"],["の"],["訴","うったえ"],["を"],["かえりみる"],["、"],["悪しき","あしき"],["人","ひと"],["は"],["それ"],["を"],["知ろう","しろう"],["と"],["は"],["しない"],["。"]]},{"verse":8,"text":"あざける人,ひとは町,まちを乱,みだし、知恵,ちえある者,ものは怒,いかりを静,しずめる。","tok":[["あざける"],["人","ひと"],["は"],["町","まち"],["を"],["乱し","みだし"],["、"],["知恵","ちえ"],["ある"],["者","もの"],["は"],["怒り","いかり"],["を"],["静める","しずめる"],["。"]]},{"verse":9,"text":"知恵,ちえある人,ひとが愚,おろかな人,ひとと争,あらそうと、愚,おろかな者,ものはただ怒,いかり、あるいは笑,わらって、休,やすむことがない。","tok":[["知恵","ちえ"],["ある"],["人","ひと"],["が"],["愚か","おろか"],["な"],["人","ひと"],["と"],["争う","あらそう"],["と"],["、"],["愚か","おろか"],["な"],["者","もの"],["は"],["ただ"],["怒り","いかり"],["、"],["あるいは"],["笑って","わらって"],["、"],["休む","やすむ"],["こと"],["が"],["ない"],["。"]]},{"verse":10,"text":"血,ちに飢,うえている人,ひとは罪,つみのない者,ものを憎,にくむ、悪,あしき者,ものは彼,かれの命,いのちを求,もとめる。","tok":[["血","ち"],["に"],["飢","うえ"],["て"],["いる"],["人","ひと"],["は"],["罪","つみ"],["の"],["ない"],["者","もの"],["を"],["憎む","にくむ"],["、"],["悪しき","あしき"],["者","もの"],["は"],["彼","かれ"],["の"],["命","いのち"],["を"],["求める","もとめる"],["。"]]},{"verse":11,"text":"愚,おろかな者,ものは怒,いかりをことごとく表,あらわし、知恵,ちえある者,ものは静,しずかにこれをおさえる。","tok":[["愚か","おろか"],["な"],["者","もの"],["は"],["怒り","いかり"],["を"],["ことごとく"],["表わし","あらわし"],["、"],["知恵","ちえ"],["ある"],["者","もの"],["は"],["静","しずか"],["に"],["これ"],["を"],["おさえる"],["。"]]},{"verse":12,"text":"もし治,おさめる者,ものが偽,いつわりの言葉,ことばに聞,きくならば、その役人,やくにんらはみな悪,わるくなる。","tok":[["もし"],["治める","おさめる"],["者","もの"],["が"],["偽わり","いつわり"],["の"],["言葉","ことば"],["に"],["聞くならば","きくならば"],["、"],["その"],["役人","やくにん"],["ら"],["は"],["みな"],["悪く","わるく"],["なる"],["。"]]},{"verse":13,"text":"貧,まずしい者,ものと、しえたげる者,ものとは共,ともに世,よにおる、主,しゅは彼,かれら両者,りょうしゃの目,めに光,ひかりを与,あたえられる。","tok":[["貧しい","まずしい"],["者","もの"],["と"],["、"],["し"],["えたげる"],["者","もの"],["と"],["は"],["共","とも"],["に"],["世","よ"],["に"],["おる"],["、"],["主","しゅ"],["は"],["彼","かれ"],["ら"],["両者","りょうしゃ"],["の"],["目","め"],["に"],["光","ひかり"],["を"],["与えられる","あたえられる"],["。"]]},{"verse":14,"text":"もし王,おうが貧,まずしい者,ものを公平,こうへいにさばくならば、その位,くらいはいつまでも堅,かたく立,たつ。","tok":[["もし"],["王","おう"],["が"],["貧しい","まずしい"],["者","もの"],["を"],["公平","こうへい"],["に"],["さばくならば"],["、"],["その"],["位","くらい"],["は"],["いつ"],["まで"],["も"],["堅く","かたく"],["立つ","たつ"],["。"]]},{"verse":15,"text":"むちと戒,いましめとは知恵,ちえを与,あたえる、わがままにさせた子,こはその母,ははに恥,はじをもたらす。","tok":[["むち"],["と"],["戒しめ","いましめ"],["と"],["は"],["知恵","ちえ"],["を"],["与える","あたえる"],["、"],["わがまま"],["に"],["させた"],["子","こ"],["は"],["その"],["母","はは"],["に"],["恥","はじ"],["を"],["もたらす"],["。"]]},{"verse":16,"text":"悪,あしき者,ものが権力,けんりょくを得,えると罪,つみも増,ます、正,ただしい者,ものは彼,かれらの倒,たおれるのを見,みる。","tok":[["悪しき","あしき"],["者","もの"],["が"],["権力","けんりょく"],["を"],["得る","える"],["と"],["罪","つみ"],["も"],["増す","ます"],["、"],["正い","ただしい"],["者","もの"],["は"],["彼","かれ"],["ら"],["の"],["倒れる","たおれる"],["の"],["を"],["見る","みる"],["。"]]},{"verse":17,"text":"あなたの子,こを懲,こらしめよ、そうすれば彼,かれはあなたを安,やすらかにし、またあなたの心,こころに喜,よろこびを与,あたえる。","tok":[["あなた"],["の"],["子","こ"],["を"],["懲らしめよ","こらしめよ"],["、"],["そう"],["すれば"],["彼","かれ"],["は"],["あなた"],["を"],["安らか","やすらか"],["に"],["し"],["、"],["また"],["あなた"],["の"],["心","こころ"],["に"],["喜こび","よろこび"],["を"],["与える","あたえる"],["。"]]},{"verse":18,"text":"預言,よげんがなければ民,たみはわがままにふるまう、しかし律法,りっぽうを守,まもる者,ものはさいわいである。","tok":[["預言","よげん"],["が"],["なければ"],["民","たみ"],["は"],["わがまま"],["に"],["ふるまう"],["、"],["しかし"],["律法","りっぽう"],["を"],["守者","まもるもの"],["は"],["さいわい"],["で"],["ある"],["。"]]},{"verse":19,"text":"しもべは言葉,ことばだけで訓練,くんれんすることはできない、彼,かれは聞,きいて知,しっても、心,こころにとめないからである。","tok":[["しもべ"],["は"],["言葉","ことば"],["だけ"],["で"],["訓練","くんれん"],["する"],["こと"],["は"],["できない"],["、"],["彼","かれ"],["は"],["聞いて","きいて"],["知って","しって"],["も"],["、"],["心","こころ"],["に"],["とめない"],["から"],["で"],["ある"],["。"]]},{"verse":20,"text":"言葉,ことばの軽率,けいそつな人,ひとを見,みるか、彼,かれよりもかえって愚,おろかな者,もののほうに望,のぞみがある。","tok":[["言葉","ことば"],["の"],["軽率","けいそつ"],["な"],["人","ひと"],["を"],["見る","みる"],["か"],["、"],["彼","かれ"],["より"],["も"],["かえって"],["愚か","おろか"],["な"],["者","もの"],["の"],["ほう"],["に"],["望み","のぞみ"],["が"],["ある"],["。"]]},{"verse":21,"text":"しもべをその幼,おさない時,ときからわがままに育,そだてる人,ひとは、ついにはそれを自分,じぶんのあとつぎにする。","tok":[["しもべ"],["を"],["その"],["幼ない","おさない"],["時","とき"],["から"],["わがまま"],["に"],["育てる","そだてる"],["人","ひと"],["は"],["、"],["ついに"],["は"],["それ"],["を"],["自分","じぶん"],["の"],["あとつぎ"],["に"],["する"],["。"]]},{"verse":22,"text":"怒,いかる人,ひとは争,あらそいを起,おこし、憤,いきどおる人,ひとは多,おおくの罪,つみを犯,おかす。","tok":[["怒","い"],["かる"],["人","ひと"],["は"],["争い","あらそい"],["を"],["起こし","おこし"],["、"],["憤る","いきどおる"],["人","ひと"],["は"],["多く","おおく"],["の"],["罪","つみ"],["を"],["犯す","おかす"],["。"]]},{"verse":23,"text":"人,ひとの高,たかぶりはその人,ひとを低,ひくくし、心,こころにへりくだる者,ものは誉,ほまれを得,える。","tok":[["人","ひと"],["の"],["高ぶり","たかぶり"],["は"],["その"],["人","ひと"],["を"],["低く","ひくく"],["し"],["、"],["心","こころ"],["に"],["へりくだる"],["者","もの"],["は"],["誉","ほまれ"],["を"],["得る","える"],["。"]]},{"verse":24,"text":"盗,ぬすびとにくみする者,ものは自分,じぶんの魂,たましいを憎,にくむ、彼,かれはのろいを聞,きいても何事,なにごとをも口外,こうがいしない。","tok":[["盗","ぬすびと"],["に"],["くみする"],["者","もの"],["は"],["自分","じぶん"],["の"],["魂","たましい"],["を"],["憎む","にくむ"],["、"],["彼","かれ"],["は"],["のろい"],["を"],["聞いて","きいて"],["も"],["何事","なにごと"],["を"],["も"],["口外","こうがい"],["しない"],["。"]]},{"verse":25,"text":"人,ひとを恐,おそれると、わなに陥,おちいる、主,しゅに信頼,しんらいする者,ものは安,やすらかである。","tok":[["人","ひと"],["を"],["恐れる","おそれる"],["と"],["、"],["わな"],["に"],["陥ち","おち"],["いる"],["、"],["主に","しゅに"],["信頼","しんらい"],["する"],["者","もの"],["は"],["安らか","やすらか"],["で"],["ある"],["。"]]},{"verse":26,"text":"治,おさめる者,ものの歓心,かんしんを得,えようとする人,ひとは多,おおい、しかし人,ひとの事,ことを定,さだめるのは主,しゅによる。","tok":[["治める","おさめる"],["者","もの"],["の"],["歓心","かんしん"],["を"],["得よう","えよう"],["と"],["する"],["人","ひと"],["は"],["多い","おおい"],["、"],["しかし"],["人","ひと"],["の"],["事","こと"],["を"],["定める","さだめる"],["の"],["は"],["主に","しゅに"],["よる"],["。"]]},{"verse":27,"text":"正,ただしい人,ひとは不正,ふせいを行,おこなう人,ひとを憎,にくみ、悪,あしき者,ものは正,ただしく歩,あゆむ人,ひとを憎,にくむ。","tok":[["正い","ただしい"],["人","ひと"],["は"],["不正","ふせい"],["を"],["行なう","おこなう"],["人","ひと"],["を"],["憎み","にくみ"],["、"],["悪しき","あしき"],["者","もの"],["は"],["正く","ただしく"],["歩む","あゆむ"],["人","ひと"],["を"],["憎む","にくむ"],["。"]]}]
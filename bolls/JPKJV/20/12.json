[{"verse":1,"text":"戒,いましめを愛,あいする人,ひとは知識,ちしきを愛,あいする、懲,こらしめを憎,にくむ者,ものは愚,おろかである。","tok":[["戒しめ","いましめ"],["を"],["愛する","あいする"],["人","ひと"],["は"],["知識","ちしき"],["を"],["愛する","あいする"],["、"],["懲らしめ","こらしめ"],["を"],["憎む","にくむ"],["者","もの"],["は"],["愚か","おろか"],["で"],["ある"],["。"]]},{"verse":2,"text":"善人,ぜんにんは主,しゅの恵,めぐみをうけ、悪,わるい計,はかりごとを設,もうける人,ひとは主,しゅに罰,ばっせられる。","tok":[["善人","ぜんにん"],["は"],["主","しゅ"],["の"],["恵","めぐみ"],["を"],["うけ"],["、"],["悪い","わるい"],["計り","はかり"],["ごと"],["を"],["設ける","もうける"],["人","ひと"],["は"],["主に","しゅに"],["罰せられる","ばっせられる"],["。"]]},{"verse":3,"text":"人,ひとは悪,あくをもって堅,かたく立,たつことはできない、正,ただしい人,ひとの根,ねは動,うごくことはない。","tok":[["人","ひと"],["は"],["悪","あく"],["を"],["もって"],["堅く","かたく"],["立つ","たつ"],["こと"],["は"],["できない"],["、"],["正い","ただしい"],["人","ひと"],["の"],["根","ね"],["は"],["動く","うごく"],["こと"],["は"],["ない"],["。"]]},{"verse":4,"text":"賢,かしこい妻,つまはその夫,おっとの冠,かんむりである、恥,はじをこうむらせる妻,つまは夫,おっとの骨,ほねに生,しょうじた腐,くされのようなものである。","tok":[["賢しこい","かしこい"],["妻","つま"],["は"],["その"],["夫","おっと"],["の"],["冠","かんむり"],["で"],["ある"],["、"],["恥","はじ"],["を"],["こうむらせる"],["妻","つま"],["は"],["夫","おっと"],["の"],["骨","ほね"],["に"],["生じた","しょうじた"],["腐れ","くされ"],["の"],["よう"],["な"],["もの"],["で"],["ある"],["。"]]},{"verse":5,"text":"正,ただしい人,ひとの考,かんがえは公正,こうせいである、悪,あしき者,ものの計,はかることは偽,いつわりである。","tok":[["正い","ただしい"],["人","ひと"],["の"],["考","かんがえ"],["は"],["公正","こうせい"],["で"],["ある"],["、"],["悪しき","あしき"],["者","もの"],["の"],["計る","はかる"],["こと"],["は"],["偽わりで","いつわりで"],["ある"],["。"]]},{"verse":6,"text":"悪,あしき者,ものの言葉,ことばは、人,ひとの血,ちを流,ながそうとうかがう、正,ただしい人,ひとの口,くちは人,ひとを救,すくう。","tok":[["悪しき","あしき"],["者","もの"],["の"],["言葉","ことば"],["は"],["、"],["人","ひと"],["の"],["血","ち"],["を"],["流そう","ながそう"],["と"],["うかがう"],["、"],["正い","ただしい"],["人","ひと"],["の"],["口","くち"],["は"],["人","ひと"],["を"],["救う","すくう"],["。"]]},{"verse":7,"text":"悪,あしき者,ものは倒,たおされて、うせ去,さる、正,ただしい人,ひとの家,いえは堅,かたく立,たつ。","tok":[["悪しき","あしき"],["者","もの"],["は"],["倒されて","たおされて"],["、"],["うせ"],["去る","さる"],["、"],["正い","ただしい"],["人","ひと"],["の"],["家","いえ"],["は"],["堅く","かたく"],["立つ","たつ"],["。"]]},{"verse":8,"text":"人,ひとはその悟,さとりにしたがって、ほめられ、心,こころのねじけた者,ものは、卑,いやしめられる。","tok":[["人","ひと"],["は"],["その"],["悟り","さとり"],["に"],["したがって"],["、"],["ほめられ"],["、"],["心","こころ"],["の"],["ねじけた"],["者","もの"],["は"],["、"],["卑しめられる","いやしめられる"],["。"]]},{"verse":9,"text":"身分,みぶんの低,ひくい人,ひとでも自分,じぶんで働,はたらく者,ものは、みずから高,たかぶって食,しょくに乏,とぼしい者,ものにまさる。","tok":[["身分","みぶん"],["の"],["低い","ひくい"],["人","ひと"],["で"],["も"],["自分","じぶん"],["で"],["働く","はたらく"],["者","もの"],["は"],["、"],["みずから"],["高か","たか"],["ぶっ"],["て"],["食","しょく"],["に"],["乏い","とぼしい"],["者","もの"],["に"],["まさる"],["。"]]},{"verse":10,"text":"正,ただしい人,ひとはその家畜,かちくの命,いのちを顧,かえりみる、悪,あしき者,ものは残忍,ざんにんをもって、あわれみとする。","tok":[["正い","ただしい"],["人","ひと"],["は"],["その"],["家畜","かちく"],["の"],["命","いのち"],["を"],["顧る","かえりみる"],["、"],["悪しき","あしき"],["者","もの"],["は"],["残忍","ざんにん"],["を"],["もって"],["、"],["あわれみ"],["と"],["する"],["。"]]},{"verse":11,"text":"自分,じぶんの田地,でんちを耕,たがやす者,ものは食糧,しょくりょうに飽,あきる、無益,むえきな事,ことに従,したがう者,ものは知恵,ちえがない。","tok":[["自分","じぶん"],["の"],["田地","でんち"],["を"],["耕やす","たがやす"],["者","もの"],["は"],["食糧","しょくりょう"],["に"],["飽きる","あきる"],["、"],["無益","むえき"],["な"],["事","こと"],["に"],["従う","したがう"],["者","もの"],["は"],["知恵","ちえ"],["が"],["ない"],["。"]]},{"verse":12,"text":"悪,あしき者,ものの堅固,けんごなやぐらは崩壊,ほうかいする、正,ただしい人,ひとの根,ねは堅,かたく立,たつ。","tok":[["悪しき","あしき"],["者","もの"],["の"],["堅固","けんご"],["な"],["やぐら"],["は"],["崩壊","ほうかい"],["する"],["、"],["正い","ただしい"],["人","ひと"],["の"],["根","ね"],["は"],["堅く","かたく"],["立つ","たつ"],["。"]]},{"verse":13,"text":"悪人,あくにんはくちびるのとがによって、わなに陥,おちいる、しかし正,ただしい人,ひとは悩,なやみをのがれる。","tok":[["悪人","あくにん"],["は"],["くちびる"],["の"],["とが"],["によって"],["、"],["わな"],["に"],["陥ち","おち"],["いる"],["、"],["しかし"],["正い","ただしい"],["人","ひと"],["は"],["悩み","なやみ"],["を"],["のがれる"],["。"]]},{"verse":14,"text":"人,ひとはその口,くちの実,じつによって、幸福,こうふくに満,みち足,たり、人,ひとの手,てのわざは、その人,ひとの身,みに帰,かえる。","tok":[["人","ひと"],["は"],["その"],["口","くち"],["の"],["実","じつ"],["によって"],["、"],["幸福","こうふく"],["に"],["満ち足り","みちたり"],["、"],["人","ひと"],["の"],["手","て"],["の"],["わざ"],["は"],["、"],["その"],["人","ひと"],["の"],["身","み"],["に"],["帰える","かえる"],["。"]]},{"verse":15,"text":"愚,おろかな人,ひとの道,みちは、自分,じぶんの目,めに正,ただしく見,みえる、しかし知恵,ちえある者,ものは勧,すすめをいれる。","tok":[["愚か","おろか"],["な"],["人","ひと"],["の"],["道","みち"],["は"],["、"],["自分","じぶん"],["の"],["目","め"],["に"],["正く","ただしく"],["見える","みえる"],["、"],["しかし"],["知恵","ちえ"],["ある"],["者","もの"],["は"],["勧め","すすめ"],["を"],["いれる"],["。"]]},{"verse":16,"text":"愚,おろかな人,ひとは、すぐに怒,いかりをあらわす、しかし賢,かしこい人,ひとは、はずかしめをも気,きにとめない。","tok":[["愚か","おろか"],["な"],["人","ひと"],["は"],["、"],["すぐ"],["に"],["怒り","いかり"],["を"],["あらわす"],["、"],["しかし"],["賢しこい","かしこい"],["人","ひと"],["は"],["、"],["はずかしめ"],["を"],["も"],["気","き"],["に"],["とめない"],["。"]]},{"verse":17,"text":"真実,しんじつを語,かたる人,ひとは正,ただしい証言,しょうげんをなし、偽,いつわりの証人,しょうにんは偽,いつわりを言,いう。","tok":[["真実","しんじつ"],["を"],["語る","かたる"],["人","ひと"],["は"],["正い","ただしい"],["証言","しょうげん"],["を"],["なし"],["、"],["偽わり","いつわり"],["の"],["証人","しょうにん"],["は"],["偽り","いつわり"],["を"],["言う","いう"],["。"]]},{"verse":18,"text":"つるぎをもって刺,さすように、みだりに言葉,ことばを出,だす者,ものがある、しかし知恵,ちえある人,ひとの舌,したは人,ひとをいやす。","tok":[["つるぎ"],["を"],["もって"],["刺す","さす"],["よう"],["に"],["、"],["みだり"],["に"],["言葉","ことば"],["を"],["出す","だす"],["者","もの"],["が"],["ある"],["、"],["しかし"],["知恵","ちえ"],["ある"],["人","ひと"],["の"],["舌","した"],["は"],["人","ひと"],["を"],["いやす"],["。"]]},{"verse":19,"text":"真実,しんじつを言,いうくちびるは、いつまでも保,たもつ、偽,いつわりを言,いう舌,したは、ただ、まばたきの間,あいだだけである。","tok":[["真実","しんじつ"],["を"],["言う","いう"],["くちびる"],["は"],["、"],["いつ"],["まで"],["も"],["保つ","たもつ"],["、"],["偽り","いつわり"],["を"],["言う","いう"],["舌","した"],["は"],["、"],["ただ"],["、"],["まばたき"],["の"],["間","あいだ"],["だけ"],["で"],["ある"],["。"]]},{"verse":20,"text":"悪,あくをたくらむ者,ものの心,こころには欺,あざむきがあり、善,ぜんをはかる人,ひとには喜,よろこびがある。","tok":[["悪","あく"],["を"],["たくらむ"],["者","もの"],["の"],["心","こころ"],["に"],["は"],["欺き","あざむき"],["が"],["あり"],["、"],["善","ぜん"],["を"],["はかる"],["人","ひと"],["に"],["は"],["喜こび","よろこび"],["が"],["ある"],["。"]]},{"verse":21,"text":"正,ただしい人,ひとにはなんの害悪,がいあくも生,しょうじない、しかし悪,あしき者,ものは災,わざわいをもって満,みたされる。","tok":[["正い","ただしい"],["人","ひと"],["に"],["は"],["なん"],["の"],["害悪","がいあく"],["も"],["生じない","しょうじない"],["、"],["しかし"],["悪しき","あしき"],["者","もの"],["は"],["災","わざわい"],["を"],["もって"],["満たされる","みたされる"],["。"]]},{"verse":22,"text":"偽,いつわりを言,いうくちびるは主,しゅに憎,にくまれ、真実,しんじつを行,おこなう者,ものは彼,かれに喜,よろこばれる。","tok":[["偽り","いつわり"],["を"],["言う","いう"],["くちびる"],["は"],["主に","しゅに"],["憎まれ","にくまれ"],["、"],["真実","しんじつ"],["を"],["行なう","おこなう"],["者","もの"],["は"],["彼","かれ"],["に"],["喜こばれる","よろこばれる"],["。"]]},{"verse":23,"text":"さとき人,ひとは知識,ちしきをかくす、しかし愚,おろかな者,ものは自分,じぶんの愚,おろかなことをあらわす。","tok":[["さ"],["とき"],["人","ひと"],["は"],["知識","ちしき"],["を"],["かくす"],["、"],["しかし"],["愚か","おろか"],["な"],["者","もの"],["は"],["自分","じぶん"],["の"],["愚か","おろか"],["な"],["こと"],["を"],["あらわす"],["。"]]},{"verse":24,"text":"勤,つとめ働,はたらく者,ものの手,てはついに人,ひとを治,おさめる、怠,おこたる者,ものは人,ひとに仕,つかえるようになる。","tok":[["勤め","つとめ"],["働く","はたらく"],["者","もの"],["の"],["手","て"],["は"],["ついに"],["人","ひと"],["を"],["治める","おさめる"],["、"],["怠たる","おこたる"],["者","もの"],["は"],["人","ひと"],["に"],["仕える","つかえる"],["よう"],["に"],["なる"],["。"]]},{"verse":25,"text":"心,こころに憂,うれいがあればその人,ひとをかがませる、しかし親切,しんせつな言葉,ことばはその人,ひとを喜,よろこばせる。","tok":[["心","こころ"],["に"],["憂","うれい"],["が"],["あれば"],["その"],["人","ひと"],["を"],["かがませる"],["、"],["しかし"],["親切","しんせつ"],["な"],["言葉","ことば"],["は"],["その"],["人","ひと"],["を"],["喜こばせる","よろこばせる"],["。"]]},{"verse":26,"text":"正,ただしい人,ひとは悪,あくを離,はなれ去,さる、しかし悪,あしき者,ものは自,みずから道,みちに迷,まよう。","tok":[["正い","ただしい"],["人","ひと"],["は"],["悪","あく"],["を"],["離れ去る","はなれさる"],["、"],["しかし"],["悪しき","あしき"],["者","もの"],["は"],["自から","みずから"],["道","みち"],["に"],["迷う","まよう"],["。"]]},{"verse":27,"text":"怠,おこたる者,ものは自分,じぶんの獲物,えものを捕,とらえない、しかし勤,つとめ働,はたらく人,ひとは尊,たっとい宝,たからを獲,える。","tok":[["怠たる","おこたる"],["者","もの"],["は"],["自分","じぶん"],["の"],["獲物","えもの"],["を"],["捕らえない","とらえない"],["、"],["しかし"],["勤め","つとめ"],["働く","はたらく"],["人","ひと"],["は"],["尊","た"],["っと"],["い"],["宝","たから"],["を"],["獲る","える"],["。"]]},{"verse":28,"text":"正義,せいぎの道,みちには命,いのちがある、しかし誤,あやまりの道,みちは死,しに至,いたる。","tok":[["正義","せいぎ"],["の"],["道","みち"],["に"],["は"],["命","いのち"],["が"],["ある"],["、"],["しかし"],["誤り","あやまり"],["の"],["道","みち"],["は"],["死","し"],["に"],["至る","いたる"],["。"]]}]
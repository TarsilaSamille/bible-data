[{"verse":1,"text":"悪,あしき者,ものは追,おう人,ひともないのに逃,にげる、正,ただしい人,ひとはししのように勇,いさましい。","tok":[["悪しき","あしき"],["者","もの"],["は"],["追う","おう"],["人","ひと"],["も"],["ない"],["のに"],["逃る","にげる"],["、"],["正い","ただしい"],["人","ひと"],["は"],["しし"],["の"],["よう"],["に"],["勇ましい","いさましい"],["。"]]},{"verse":2,"text":"国,くにの罪,つみによって、治,おさめる者,ものは多,おおくなり、さとく、また知識,ちしきある人,ひとによって、国,くにはながく保,たもつ。","tok":[["国","くに"],["の"],["罪","つみ"],["によって"],["、"],["治める","おさめる"],["者","もの"],["は"],["多く","おおく"],["なり"],["、"],["さとく"],["、"],["また"],["知識","ちしき"],["ある"],["人","ひと"],["によって"],["、"],["国","くに"],["は"],["ながく"],["保つ","たもつ"],["。"]]},{"verse":3,"text":"貧,まずしい者,ものをしえたげる貧,まずしい人,ひとは、糧食,りょうしょくを残,のこさない激,はげしい雨,あめのようだ。","tok":[["貧しい","まずしい"],["者","もの"],["を"],["し"],["えたげる"],["貧しい","まずしい"],["人","ひと"],["は"],["、"],["糧食","りょうしょく"],["を"],["残さない","のこさない"],["激しい","はげしい"],["雨","あめ"],["の"],["よう"],["だ"],["。"]]},{"verse":4,"text":"律法,りっぽうを捨,すてる者,ものは悪,あしき者,ものをほめる、律法,りっぽうを守,まもる者,ものはこれに敵対,てきたいする。","tok":[["律法","りっぽう"],["を"],["捨てる","すてる"],["者","もの"],["は"],["悪しき","あしき"],["者","もの"],["を"],["ほめる"],["、"],["律法","りっぽう"],["を"],["守者","まもるもの"],["は"],["これ"],["に"],["敵対","てきたい"],["する"],["。"]]},{"verse":5,"text":"悪人,あくにんは正,ただしいことを悟,さとらない、主,しゅを求,もとめる者,ものはこれをことごとく悟,さとる。","tok":[["悪人","あくにん"],["は"],["正い","ただしい"],["こと"],["を"],["悟らない","さとらない"],["、"],["主","しゅ"],["を"],["求める","もとめる"],["者","もの"],["は"],["これ"],["を"],["ことごとく"],["悟","さとる"],["。"]]},{"verse":6,"text":"正,ただしく歩,あゆむ貧,まずしい者,ものは、曲,まがった道,みちを歩,あゆむ富,とめる者,ものにまさる。","tok":[["正く","ただしく"],["歩む","あゆむ"],["貧しい","まずしい"],["者","もの"],["は"],["、"],["曲がった","まがった"],["道","みち"],["を"],["歩む","あゆむ"],["富める","とめる"],["者","もの"],["に"],["まさる"],["。"]]},{"verse":7,"text":"律法,りっぽうを守,まもる者,ものは賢,かしこい子,こである、不品行,ふひんこうな者,ものと交,まじわるものは、父,ちちをはずかしめる。","tok":[["律法","りっぽう"],["を"],["守者","まもるもの"],["は"],["賢しこい","かしこい"],["子","こ"],["で"],["ある"],["、"],["不品行","ふひんこう"],["な"],["者","もの"],["と"],["交じわる","まじわる"],["もの"],["は"],["、"],["父","ちち"],["を"],["はずかしめる"],["。"]]},{"verse":8,"text":"利息,りそくと高利,こうりとによってその富,とみをます者,ものは、貧,まずしい者,ものを恵,めぐむ者,もののために、それをたくわえる。","tok":[["利息","りそく"],["と"],["高利","こうり"],["と"],["によって"],["その"],["富","とみ"],["を"],["ます"],["者","もの"],["は"],["、"],["貧しい","まずしい"],["者","もの"],["を"],["恵む","めぐむ"],["者","もの"],["の"],["ため"],["に"],["、"],["それ"],["を"],["たくわえる"],["。"]]},{"verse":9,"text":"耳,みみをそむけて律法,りっぽうを聞,きかない者,ものは、その祈,いのりでさえも憎,にくまれる。","tok":[["耳","みみ"],["を"],["そむけて"],["律法","りっぽう"],["を"],["聞かない","きかない"],["者","もの"],["は"],["、"],["その"],["祈","いのり"],["で"],["さえ"],["も"],["憎まれる","にくまれる"],["。"]]},{"verse":10,"text":"正,ただしい者,ものを悪,わるい道,みちに惑,まどわす者,ものは、みずから自分,じぶんの穴,あなに陥,おちいる、しかし誠実,せいじつな人,ひとは幸福,こうふくを継,つぐ。","tok":[["正い","ただしい"],["者","もの"],["を"],["悪い","わるい"],["道","みち"],["に"],["惑わす","まどわす"],["者","もの"],["は"],["、"],["みずから"],["自分","じぶん"],["の"],["穴","あな"],["に"],["陥ち","おち"],["いる"],["、"],["しかし"],["誠実","せいじつ"],["な"],["人","ひと"],["は"],["幸福","こうふく"],["を"],["継ぐ","つぐ"],["。"]]},{"verse":11,"text":"富,とめる人,ひとは自分,じぶんの目,めに自,みずからを知恵,ちえある者,ものと見,みる、しかし悟,さとりのある貧,まずしい者,ものは彼,かれを見,みやぶる。","tok":[["富める","とめる"],["人","ひと"],["は"],["自分","じぶん"],["の"],["目","め"],["に"],["自から","みずから"],["を"],["知恵","ちえ"],["ある"],["者","もの"],["と"],["見る","みる"],["、"],["しかし"],["悟り","さとり"],["の"],["ある"],["貧しい","まずしい"],["者","もの"],["は"],["彼","かれ"],["を"],["見やぶる","みやぶる"],["。"]]},{"verse":12,"text":"正,ただしい者,ものが勝,かつときは、大,おおいなる栄,さかえがある、悪,あしき者,ものが起,おこるときは、民,たみは身,みをかくす。","tok":[["正い","ただしい"],["者","もの"],["が"],["勝つ","かつ"],["とき"],["は"],["、"],["大いなる","おおいなる"],["栄","さかえ"],["が"],["ある"],["、"],["悪しき","あしき"],["者","もの"],["が"],["起こる","おこる"],["とき"],["は"],["、"],["民","たみ"],["は"],["身","み"],["を"],["かくす"],["。"]]},{"verse":13,"text":"その罪,つみを隠,かくす者,ものは栄,さかえることがない、言,いい表,あらわしてこれを離,はなれる者,ものは、あわれみをうける。","tok":[["その"],["罪","つみ"],["を"],["隠す","かくす"],["者","もの"],["は"],["栄","さかえ"],["る"],["こと"],["が"],["ない"],["、"],["言い表わして","いいあらわして"],["これ"],["を"],["離れる","はなれる"],["者","もの"],["は"],["、"],["あわれみ"],["を"],["うける"],["。"]]},{"verse":14,"text":"常,つねに主,しゅを恐,おそれる人,ひとはさいわいである、心,こころをかたくなにする者,ものは災,わざわいに陥,おちいる。","tok":[["常","つね"],["に"],["主","しゅ"],["を"],["恐れる","おそれる"],["人","ひと"],["は"],["さいわい"],["で"],["ある"],["、"],["心","こころ"],["を"],["かたくな"],["に"],["する"],["者","もの"],["は"],["災","わざわい"],["に"],["陥ち","おち"],["いる"],["。"]]},{"verse":15,"text":"貧,まずしい民,たみを治,おさめる悪,わるいつかさは、ほえるしし、または飢,うえたくまのようだ。","tok":[["貧しい","まずしい"],["民","たみ"],["を"],["治める","おさめる"],["悪い","わるい"],["つかさ"],["は"],["、"],["ほえる"],["し"],["し"],["、"],["また"],["は"],["飢","うえ"],["た"],["くま"],["の"],["よう"],["だ"],["。"]]},{"verse":16,"text":"悟,さとりのないつかさは残忍,ざんにんな圧制者,あっせいしゃである、不正,ふせいの利,りを憎,にくむ者,ものは長命,ちょうめいを得,える。","tok":[["悟り","さとり"],["の"],["ない"],["つかさ"],["は"],["残忍","ざんにん"],["な"],["圧制者","あっせいしゃ"],["で"],["ある"],["、"],["不正","ふせい"],["の"],["利","り"],["を"],["憎む","にくむ"],["者","もの"],["は"],["長命","ちょうめい"],["を"],["得る","える"],["。"]]},{"verse":17,"text":"人,ひとを殺,ころしてその血,ちを身,みに負,おう者,ものは死,しぬまで、のがれびとである、だれもこれを助,たすけてはならない。","tok":[["人","ひと"],["を"],["殺ろして","ころして"],["その"],["血","ち"],["を"],["身","み"],["に"],["負う","おう"],["者","もの"],["は"],["死ぬ","しぬ"],["まで"],["、"],["のがれ"],["びと"],["で"],["ある"],["、"],["だれ"],["も"],["これ"],["を"],["助けて","たすけて"],["は"],["ならない"],["。"]]},{"verse":18,"text":"正,ただしく歩,あゆむ者,ものは救,すくいを得,え、曲,まがった道,みちに歩,あゆむ者,ものは穴,あなに陥,おちいる。","tok":[["正く","ただしく"],["歩む","あゆむ"],["者","もの"],["は"],["救い","すくい"],["を"],["得","え"],["、"],["曲がった","まがった"],["道","みち"],["に"],["歩む","あゆむ"],["者","もの"],["は"],["穴","あな"],["に"],["陥ち","おち"],["いる"],["。"]]},{"verse":19,"text":"自分,じぶんの田地,でんちを耕,たがやす者,ものは食糧,しょくりょうに飽,あき、無益,むえきな事,ことに従,したがう者,ものは貧乏,びんぼうに飽,あきる。","tok":[["自分","じぶん"],["の"],["田地","でんち"],["を"],["耕やす","たがやす"],["者","もの"],["は"],["食糧","しょくりょう"],["に"],["飽き","あき"],["、"],["無益","むえき"],["な"],["事","こと"],["に"],["従う","したがう"],["者","もの"],["は"],["貧乏","びんぼう"],["に"],["飽きる","あきる"],["。"]]},{"verse":20,"text":"忠実,ちゅうじつな人,ひとは多,おおくの祝福,しゅくふくを得,える、急,いそいで富,とみを得,えようとする者,ものは罰,ばつを免,まぬかれない。","tok":[["忠実","ちゅうじつ"],["な"],["人","ひと"],["は"],["多く","おおく"],["の"],["祝福","しゅくふく"],["を"],["得る","える"],["、"],["急いで","いそいで"],["富","とみ"],["を"],["得よう","えよう"],["と"],["する"],["者","もの"],["は"],["罰","ばつ"],["を"],["免かれない","まぬかれない"],["。"]]},{"verse":21,"text":"人,ひとを片寄,かたより見,みることは良,よくない、人,ひとは一,いち切,きれのパンのために、とがを犯,おかすことがある。","tok":[["人","ひと"],["を"],["片寄り","かたより"],["見る","みる"],["こと"],["は"],["良く","よく"],["ない"],["、"],["人","ひと"],["は"],["一切れ","いちきれ"],["の"],["パン"],["の"],["ため"],["に"],["、"],["とが"],["を"],["犯す","おかす"],["こと"],["が"],["ある"],["。"]]},{"verse":22,"text":"欲,よくの深,ふかい人,ひとは急,いそいで富,とみを得,えようとする、かえって欠乏,けつぼうが自分,じぶんの所,ところに来,くることを知,しらない。","tok":[["欲","よく"],["の"],["深い","ふかい"],["人","ひと"],["は"],["急いで","いそいで"],["富","とみ"],["を"],["得よう","えよう"],["と"],["する"],["、"],["かえって"],["欠乏","けつぼう"],["が"],["自分","じぶん"],["の"],["所","ところ"],["に"],["来る","くる"],["こと"],["を"],["知らない","しらない"],["。"]]},{"verse":23,"text":"人,ひとを戒,いましめる者,ものは舌,したをもってへつらう者,ものよりも、大,おおいなる感謝,かんしゃをうける。","tok":[["人","ひと"],["を"],["戒める","いましめる"],["者","もの"],["は"],["舌","した"],["を"],["もって"],["へつらう"],["者","もの"],["より"],["も"],["、"],["大いなる","おおいなる"],["感謝","かんしゃ"],["を"],["うける"],["。"]]},{"verse":24,"text":"父,ちちや母,ははの物,ものを盗,ぬすんで「これは罪,つみではない」と言,いう者,ものは、滅,ほろぼす者,ものの友,ともである。","tok":[["父","ちち"],["や"],["母","はは"],["の"],["物","もの"],["を"],["盗んで","ぬすんで"],["「"],["これ"],["は"],["罪","つみ"],["で"],["は"],["ない"],["」"],["と"],["言う","いう"],["者","もの"],["は"],["、"],["滅ぼす","ほろぼす"],["者","もの"],["の"],["友","とも"],["で"],["ある"],["。"]]},{"verse":25,"text":"むさぼる者,ものは争,あらそいを起,おこし、主,しゅに信頼,しんらいする者,ものは豊,ゆたかになる。","tok":[["むさぼる"],["者","もの"],["は"],["争い","あらそい"],["を"],["起こし","おこし"],["、"],["主に","しゅに"],["信頼","しんらい"],["する"],["者","もの"],["は"],["豊","ゆたか"],["に"],["なる"],["。"]]},{"verse":26,"text":"自分,じぶんの心,こころを頼,たのむ者,ものは愚,おろかである、知恵,ちえをもって歩,あゆむ者,ものは救,すくいを得,える。","tok":[["自分","じぶん"],["の"],["心","こころ"],["を"],["頼む","たのむ"],["者","もの"],["は"],["愚か","おろか"],["で"],["ある"],["、"],["知恵","ちえ"],["を"],["もって"],["歩む","あゆむ"],["者","もの"],["は"],["救い","すくい"],["を"],["得る","える"],["。"]]},{"verse":27,"text":"貧,まずしい者,ものに施,ほどこす者,ものは物,ものに不足,ふそくしない、目,めをおおって見,みない人,ひとは多,おおくののろいをうける。","tok":[["貧しい","まずしい"],["者","もの"],["に"],["施す","ほどこす"],["者","もの"],["は"],["物","もの"],["に"],["不足","ふそく"],["しない"],["、"],["目","め"],["を"],["おおって"],["見ない","みない"],["人","ひと"],["は"],["多く","おおく"],["の"],["のろい"],["を"],["うける"],["。"]]},{"verse":28,"text":"悪,あしき者,ものが起,おこるときは、民,たみは身,みをかくす、その滅,ほろびるときは、正,ただしい人,ひとが増,ます。","tok":[["悪しき","あしき"],["者","もの"],["が"],["起こる","おこる"],["とき"],["は"],["、"],["民","たみ"],["は"],["身","み"],["を"],["かくす"],["、"],["その"],["滅びる","ほろびる"],["とき"],["は"],["、"],["正い","ただしい"],["人","ひと"],["が"],["増す","ます"],["。"]]}]
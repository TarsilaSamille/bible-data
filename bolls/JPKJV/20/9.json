[{"verse":1,"text":"知恵,ちえは自分,じぶんの家,いえを建,たて、その七つの柱,はしらを立,たて、","tok":[["知恵","ちえ"],["は"],["自分","じぶん"],["の"],["家","いえ"],["を"],["建て","たて"],["、"],["その"],["七","なな"],["つ"],["の"],["柱","はしら"],["を"],["立て","たて"],["、"]]},{"verse":2,"text":"獣,けものをほふり、酒,さけを混,まぜ合,あわせて、ふるまいを備,そなえ、","tok":[["獣","けもの"],["を"],["ほふり"],["、"],["酒","さけ"],["を"],["混ぜ","まぜ"],["合","あわせ"],["て"],["、"],["ふるまい"],["を"],["備","そなえ"],["、"]]},{"verse":3,"text":"はしためをつかわして、町,まちの高,たかい所,ところで呼,よばわり言,いわせた、","tok":[["はし"],["ため"],["を"],["つかわして"],["、"],["町","まち"],["の"],["高い","たかい"],["所","ところ"],["で"],["呼ばわり","よばわり"],["言わせた","いわせた"],["、"]]},{"verse":4,"text":"「思慮,しりょのない者,ものよ、ここに来,きたれ」と。また、知恵,ちえのない者,ものに言,いう、","tok":[["「"],["思慮","しりょ"],["の"],["ない"],["者","もの"],["よ"],["、"],["ここ"],["に"],["来たれ","きたれ"],["」"],["と"],["。"],["また"],["、"],["知恵","ちえ"],["の"],["ない"],["者","もの"],["に"],["言う","いう"],["、"]]},{"verse":5,"text":"「来,きて、わたしのパンを食,たべ、わたしの混,まぜ合,あわせた酒,さけをのみ、","tok":[["「"],["来て","きて"],["、"],["わたし"],["の"],["パン"],["を"],["食べ","たべ"],["、"],["わたし"],["の"],["混ぜ","まぜ"],["合","あわせ"],["た"],["酒","さけ"],["を"],["のみ"],["、"]]},{"verse":6,"text":"思慮,しりょのないわざを捨,すてて命,いのちを得,え、悟,さとりの道,みちを歩,あゆめ」と。","tok":[["思慮","しりょ"],["の"],["ない"],["わざ"],["を"],["捨てて","すてて"],["命","いのち"],["を"],["得","え"],["、"],["悟り","さとり"],["の"],["道","みち"],["を"],["歩め","あゆめ"],["」"],["と"],["。"]]},{"verse":7,"text":"あざける者,ものを戒,いましめる者,ものは、自,みずから恥,はじを得,え、悪,あしき者,ものを責,せめる者,ものは自,みずから傷,きずを受,うける。","tok":[["あざける"],["者","もの"],["を"],["戒める","いましめる"],["者","もの"],["は"],["、"],["自から","みずから"],["恥","はじ"],["を"],["得","え"],["、"],["悪しき","あしき"],["者","もの"],["を"],["責","せめ"],["る"],["者","もの"],["は"],["自から","みずから"],["傷","きず"],["を"],["受る","うける"],["。"]]},{"verse":8,"text":"あざける者,ものを責,せめるな、おそらく彼,かれはあなたを憎,にくむであろう。知恵,ちえある者,ものを責,せめよ、彼,かれはあなたを愛,あいする。","tok":[["あざける"],["者","もの"],["を"],["責","せめ"],["る"],["な"],["、"],["おそらく"],["彼","かれ"],["は"],["あなた"],["を"],["憎むで","にくむで"],["あろう"],["。"],["知恵","ちえ"],["ある"],["者","もの"],["を"],["責","せめ"],["よ"],["、"],["彼","かれ"],["は"],["あなた"],["を"],["愛する","あいする"],["。"]]},{"verse":9,"text":"知恵,ちえある者,ものに教訓,きょうくんを授,さづけよ、彼,かれはますます知恵,ちえを得,える。正,ただしい者,ものを教,おしえよ、彼,かれは学,がくに進,すすむ。","tok":[["知恵","ちえ"],["ある"],["者","もの"],["に"],["教訓","きょうくん"],["を"],["授","さ"],["づけよ"],["、"],["彼","かれ"],["は"],["ますます"],["知恵","ちえ"],["を"],["得る","える"],["。"],["正い","ただしい"],["者","もの"],["を"],["教えよ","おしえよ"],["、"],["彼","かれ"],["は"],["学","がく"],["に"],["進","すすむ"],["。"]]},{"verse":10,"text":"主,しゅを恐,おそれることは知恵,ちえのもとである、聖,せいなる者,ものを知,しることは、悟,さとりである。","tok":[["主","しゅ"],["を"],["恐れる","おそれる"],["こと"],["は"],["知恵","ちえ"],["の"],["もと"],["で"],["ある"],["、"],["聖","せい"],["なる"],["者","もの"],["を"],["知る","しる"],["こと"],["は"],["、"],["悟り","さとり"],["で"],["ある"],["。"]]},{"verse":11,"text":"わたしによって、あなたの日,ひは多,おおくなり、あなたの命,いのちの年,としは増,ます。","tok":[["わたし"],["によって"],["、"],["あなた"],["の"],["日","ひ"],["は"],["多く","おおく"],["なり"],["、"],["あなた"],["の"],["命","いのち"],["の"],["年","とし"],["は"],["増す","ます"],["。"]]},{"verse":12,"text":"もしあなたに知恵,ちえがあるならば、あなた自身,じしんのために知恵,ちえがあるのである。もしあなたがあざけるならば、あなたひとりがその責,せめを負,おうことになる。","tok":[["もし"],["あなた"],["に"],["知恵","ちえ"],["が"],["あるならば"],["、"],["あなた"],["自身","じしん"],["の"],["ため"],["に"],["知恵","ちえ"],["が"],["ある"],["ので"],["ある"],["。"],["もし"],["あなた"],["が"],["あざけるならば"],["、"],["あなた"],["ひとり"],["が"],["その"],["責","せめ"],["を"],["負う","おう"],["こと"],["に"],["なる"],["。"]]},{"verse":13,"text":"愚,おろかな女,おんなは、騒,さわがしく、みだらで、恥,はじを知,しらない。","tok":[["愚か","おろか"],["な"],["女","おんな"],["は"],["、"],["騒がしく","さわがしく"],["、"],["みだら"],["で"],["、"],["恥","はじ"],["を"],["知らない","しらない"],["。"]]},{"verse":14,"text":"彼女,かのじょはその家,いえの戸口,とぐちに座,ざし、町,まちの高,たかい所,ところにある座,ざにすわり、","tok":[["彼女","かのじょ"],["は"],["その"],["家","いえ"],["の"],["戸口","とぐち"],["に"],["座し","ざし"],["、"],["町","まち"],["の"],["高い","たかい"],["所","ところ"],["に"],["ある"],["座","ざ"],["に"],["すわり"],["、"]]},{"verse":15,"text":"道,みちを急,いそぐ行,いき来,きの人,ひとを招,まねいて言,いう、","tok":[["道","みち"],["を"],["急ぐ","いそぐ"],["行き来","いきき"],["の"],["人","ひと"],["を"],["招いて","まねいて"],["言う","いう"],["、"]]},{"verse":16,"text":"「思慮,しりょのない者,ものよ、ここに来,きたれ」と。また知恵,ちえのない人,ひとに向,むかってこれに言,いう、","tok":[["「"],["思慮","しりょ"],["の"],["ない"],["者","もの"],["よ"],["、"],["ここ"],["に"],["来たれ","きたれ"],["」"],["と"],["。"],["また"],["知恵","ちえ"],["の"],["ない"],["人","ひと"],["に"],["向かって","むかって"],["これ"],["に"],["言う","いう"],["、"]]},{"verse":17,"text":"「盗,ぬすんだ水,みずは甘,あまく、ひそかに食,たべるパンはうまい」と。","tok":[["「"],["盗","ぬ"],["すんだ"],["水","みず"],["は"],["甘く","あまく"],["、"],["ひそか"],["に"],["食べる","たべる"],["パン"],["は"],["うまい"],["」"],["と"],["。"]]},{"verse":18,"text":"しかしその人,ひとは、死,しの影,かげがそこにあることを知,しらず、彼女,かのじょの客,きゃくは陰府,よみの深,ふかみにおることを知,しらない。","tok":[["しかし"],["その"],["人","ひと"],["は"],["、"],["死","し"],["の"],["影","かげ"],["が"],["そこ"],["に"],["ある"],["こと"],["を"],["知らず","しらず"],["、"],["彼女","かのじょ"],["の"],["客","きゃく"],["は"],["陰府","よみ"],["の"],["深み","ふかみ"],["に"],["おる"],["こと"],["を"],["知らない","しらない"],["。"]]}]
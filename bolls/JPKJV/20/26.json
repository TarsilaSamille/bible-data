[{"verse":1,"text":"誉,ほまれが愚,おろかな者,ものにふさわしくないのは、夏,なつに雪,ゆきが降,ふり、刈入,かりいれの時,ときに雨,あめが降,ふるようなものだ。","tok":[["誉","ほまれ"],["が"],["愚か","おろか"],["な"],["者","もの"],["に"],["ふさわしく"],["ない"],["の"],["は"],["、"],["夏","なつ"],["に"],["雪","ゆき"],["が"],["降り","ふり"],["、"],["刈入れ","かりいれ"],["の"],["時","とき"],["に"],["雨","あめ"],["が"],["降る","ふる"],["よう"],["な"],["もの"],["だ"],["。"]]},{"verse":2,"text":"いわれのないのろいは、飛,とびまわるすずめや、飛,とびかけるつばめのようなもので、止,とまらない。","tok":[["いわれ"],["の"],["ない"],["のろい"],["は"],["、"],["飛びまわる","とびまわる"],["すずめ"],["や"],["、"],["飛び","とび"],["かける"],["つばめ"],["の"],["よう"],["な"],["もの"],["で"],["、"],["止まらない","とまらない"],["。"]]},{"verse":3,"text":"馬,うまのためにはむちがあり、ろばのためにはくつわがあり、愚,おろかな者,ものの背,せのためにはつえがある。","tok":[["馬","うま"],["の"],["ため"],["に"],["は"],["むち"],["が"],["あり"],["、"],["ろば"],["の"],["ため"],["に"],["は"],["くつわ"],["が"],["あり"],["、"],["愚か","おろか"],["な"],["者","もの"],["の"],["背","せ"],["の"],["ため"],["に"],["は"],["つえ"],["が"],["ある"],["。"]]},{"verse":4,"text":"愚,おろかな者,ものにその愚,おろかさにしたがって答,こたえをするな、自分,じぶんも彼,かれと同,おなじようにならないためだ。","tok":[["愚か","おろか"],["な"],["者","もの"],["に"],["その"],["愚か","おろか"],["さ"],["に"],["したがって"],["答","こたえ"],["を"],["する"],["な"],["、"],["自分","じぶん"],["も"],["彼","かれ"],["と"],["同じ","おなじ"],["よう"],["に"],["ならない"],["ため"],["だ"],["。"]]},{"verse":5,"text":"愚,おろかな者,ものにその愚,おろかさにしたがって答,こたえをせよ、彼,かれが自分,じぶんの目,めに自,みずからを知恵,ちえある者,ものと見,みないためだ。","tok":[["愚か","おろか"],["な"],["者","もの"],["に"],["その"],["愚か","おろか"],["さ"],["に"],["したがって"],["答","こたえ"],["を"],["せよ"],["、"],["彼","かれ"],["が"],["自分","じぶん"],["の"],["目","め"],["に"],["自から","みずから"],["を"],["知恵","ちえ"],["ある"],["者","もの"],["と"],["見ない","みない"],["ため"],["だ"],["。"]]},{"verse":6,"text":"愚,おろかな者,ものに託,たくして事,ことを言,いい送,おくる者,ものは、自分,じぶんの足,あしを切,きり去,さり、身,みに害,がいをうける。","tok":[["愚か","おろか"],["な"],["者","もの"],["に"],["託して","たくして"],["事","こと"],["を"],["言い送る","いいおくる"],["者","もの"],["は"],["、"],["自分","じぶん"],["の"],["足","あし"],["を"],["切り去り","きりさり"],["、"],["身","み"],["に"],["害","がい"],["を"],["うける"],["。"]]},{"verse":7,"text":"あしなえの足,あしは用,ようがない、愚,おろかな者,ものの口,くちには箴言,しんげんもそれにひとしい。","tok":[["あし"],["なえ"],["の"],["足","あし"],["は"],["用","よう"],["が"],["ない"],["、"],["愚か","おろか"],["な"],["者","もの"],["の"],["口","くち"],["に"],["は"],["箴言","しんげん"],["も"],["それ"],["に"],["ひとしい"],["。"]]},{"verse":8,"text":"誉,ほまれを愚,おろかな者,ものに与,あたえるのは、石,いしを石,いし投,なげにつなぐようだ。","tok":[["誉","ほまれ"],["を"],["愚か","おろか"],["な"],["者","もの"],["に"],["与える","あたえる"],["の"],["は"],["、"],["石","いし"],["を"],["石投","いしなげ"],["に"],["つなぐ"],["よう"],["だ"],["。"]]},{"verse":9,"text":"愚,おろかな者,ものの口,くちに箴言,しんげんがあるのは、酔,よった者,ものが、とげのあるつえを手,てで振,ふり上,あげるようだ。","tok":[["愚か","おろか"],["な"],["者","もの"],["の"],["口","くち"],["に"],["箴言","しんげん"],["が"],["ある"],["の"],["は"],["、"],["酔った","よった"],["者","もの"],["が"],["、"],["とげ"],["の"],["ある"],["つえ"],["を"],["手","て"],["で"],["振り上げる","ふりあげる"],["よう"],["だ"],["。"]]},{"verse":10,"text":"通,とおりがかりの愚,おろか者,ものや、酔,よった者,ものを雇,やとう者,ものは、すべての人,ひとを傷,きずつける射手,いてのようだ。","tok":[["通りがかり","とおりがかり"],["の"],["愚か者","おろかもの"],["や"],["、"],["酔った","よった"],["者","もの"],["を"],["雇う","やとう"],["者","もの"],["は"],["、"],["すべて"],["の"],["人","ひと"],["を"],["傷つける","きずつける"],["射手","いて"],["の"],["よう"],["だ"],["。"]]},{"verse":11,"text":"犬,いぬが帰,かえって来,きてその吐,はいた物,ものを食,たべるように、愚,おろかな者,ものはその愚,おろかさをくり返,かえす。","tok":[["犬","いぬ"],["が"],["帰えって","かえって"],["来て","きて"],["その"],["吐いた","はいた"],["物","もの"],["を"],["食べる","たべる"],["よう"],["に"],["、"],["愚か","おろか"],["な"],["者","もの"],["は"],["その"],["愚か","おろか"],["さ"],["を"],["くり"],["返えす","かえす"],["。"]]},{"verse":12,"text":"自分,じぶんの目,めに自,みずからを知恵,ちえある者,ものとする人,ひとを、あなたは見,みるか、彼,かれよりもかえって愚,おろかな人,ひとに望,のぞみがある。","tok":[["自分","じぶん"],["の"],["目","め"],["に"],["自から","みずから"],["を"],["知恵","ちえ"],["ある"],["者","もの"],["と"],["する"],["人","ひと"],["を"],["、"],["あなた"],["は"],["見る","みる"],["か"],["、"],["彼","かれ"],["より"],["も"],["かえって"],["愚か","おろか"],["な"],["人","ひと"],["に"],["望み","のぞみ"],["が"],["ある"],["。"]]},{"verse":13,"text":"なまけ者,ものは、「道,みちにししがいる、ちまたにししがいる」という。","tok":[["なまけ者","なまけもの"],["は"],["、"],["「"],["道","みち"],["に"],["しし"],["が"],["いる"],["、"],["ちまた"],["に"],["しし"],["が"],["いる"],["」"],["と"],["いう"],["。"]]},{"verse":14,"text":"戸,とがちょうつがいによって回,まわるように、なまけ者,ものはその寝床,ねどこで寝返,ねがえりをする。","tok":[["戸","と"],["が"],["ちょうつがい"],["によって"],["回わる","まわる"],["よう"],["に"],["、"],["なまけ者","なまけもの"],["は"],["その"],["寝床","ねどこ"],["で"],["寝返り","ねがえり"],["を"],["する"],["。"]]},{"verse":15,"text":"なまけ者,ものは手,てを皿,さらに入,いれても、それを口,くちに持,もってゆくことをいとう。","tok":[["なまけ者","なまけもの"],["は"],["手","て"],["を"],["皿","さら"],["に"],["入れて","いれて"],["も"],["、"],["それ"],["を"],["口","くち"],["に"],["持って","もって"],["ゆく"],["こと"],["を"],["いとう"],["。"]]},{"verse":16,"text":"なまけ者,ものは自分,じぶんの目,めに、良,よく答,こたえることのできる七人,にんの者,ものよりも、自,みずからを知恵,ちえありとする。","tok":[["なまけ者","なまけもの"],["は"],["自分","じぶん"],["の"],["目","め"],["に"],["、"],["良く","よく"],["答","こたえ"],["る"],["こと"],["の"],["できる"],["七人","にん"],["の"],["者","もの"],["より"],["も"],["、"],["自から","みずから"],["を"],["知恵","ちえ"],["あり"],["と"],["する"],["。"]]},{"verse":17,"text":"自分,じぶんに関係,かんけいのない争,あらそいにたずさわる者,ものは、通,とおりすぎる犬,いぬの耳,みみをとらえる者,もののようだ。","tok":[["自分","じぶん"],["に"],["関係","かんけい"],["の"],["ない"],["争い","あらそい"],["に"],["たずさわる"],["者","もの"],["は"],["、"],["通","とおり"],["すぎる"],["犬","いぬ"],["の"],["耳","みみ"],["を"],["とらえる"],["者","もの"],["の"],["よう"],["だ"],["。"]]},{"verse":18,"text":"[18-19]隣,となり人,びとを欺,あざむいて、「わたしはただ戯,ざれにした」という者,ものは、燃,もえ木,きまたは矢,や、または死,しを、投,なげつける気違,きちがいのようだ。","tok":[["["],["18"],["-"],["19"],["]"],["隣人","となりびと"],["を"],["欺いて","あざむいて"],["、"],["「"],["わたし"],["は"],["ただ"],["戯","ざれ"],["に"],["した"],["」"],["と"],["いう"],["者","もの"],["は"],["、"],["燃え木","もえき"],["また"],["は"],["矢","や"],["、"],["また"],["は"],["死","し"],["を"],["、"],["投","なげ"],["つける"],["気違","きちがい"],["の"],["よう"],["だ"],["。"]]},{"verse":19,"text":"*[18-19]隣,となり人,びとを欺,あざむいて、「わたしはただ戯,ざれにした」という者,ものは、燃,もえ木,きまたは矢,や、または死,しを、投,なげつける気違,きちがいのようだ。","tok":[["*"],["["],["18"],["-"],["19"],["]"],["隣人","となりびと"],["を"],["欺いて","あざむいて"],["、"],["「"],["わたし"],["は"],["ただ"],["戯","ざれ"],["に"],["した"],["」"],["と"],["いう"],["者","もの"],["は"],["、"],["燃え木","もえき"],["また"],["は"],["矢","や"],["、"],["また"],["は"],["死","し"],["を"],["、"],["投","なげ"],["つける"],["気違","きちがい"],["の"],["よう"],["だ"],["。"]]},{"verse":20,"text":"たきぎがなければ火,ひは消,きえ、人,ひとのよしあしを言,いう者,ものがなければ争,あらそいはやむ。","tok":[["たきぎ"],["が"],["なければ"],["火","ひ"],["は"],["消え","きえ"],["、"],["人","ひと"],["の"],["よしあし"],["を"],["言う","いう"],["者","もの"],["が"],["なければ"],["争い","あらそい"],["は"],["やむ"],["。"]]},{"verse":21,"text":"おき火,ひに炭,すみをつぎ、火,ひにたきぎをくべるように、争,あらそいを好,このむ人,ひとは争,あらそいの火,ひをおこす。","tok":[["おき"],["火","ひ"],["に"],["炭","すみ"],["を"],["つぎ"],["、"],["火","ひ"],["に"],["たきぎ"],["を"],["くべる"],["よう"],["に"],["、"],["争い","あらそい"],["を"],["好む","このむ"],["人","ひと"],["は"],["争い","あらそい"],["の"],["火","ひ"],["を"],["おこす"],["。"]]},{"verse":22,"text":"人,ひとのよしあしをいう者,ものの言葉,ことばはおいしい食物,しょくもつのようで、腹,はらの奥,おくにしみこむ。","tok":[["人","ひと"],["の"],["よしあし"],["を"],["いう"],["者","もの"],["の"],["言葉","ことば"],["は"],["おいしい"],["食物","しょくもつ"],["の"],["よう"],["で"],["、"],["腹","はら"],["の"],["奥","おく"],["に"],["しみこむ"],["。"]]},{"verse":23,"text":"くちびるはなめらかであっても、心,こころの悪,わるいのは上,うえぐすりをかけた土,つちの器,うつわのようだ。","tok":[["くちびる"],["は"],["なめらか"],["で"],["あって"],["も"],["、"],["心","こころ"],["の"],["悪い","わるい"],["の"],["は"],["上","うえ"],["ぐすり"],["を"],["かけた"],["土","つち"],["の"],["器","うつわ"],["の"],["よう"],["だ"],["。"]]},{"verse":24,"text":"憎,にくむ者,ものはくちびるをもって自,みずから飾,かざるけれども、心,こころのうちには偽,いつわりをいだく。","tok":[["憎む","にくむ"],["者","もの"],["は"],["くちびる"],["を"],["もって"],["自から","みずから"],["飾る","かざる"],["けれど"],["も"],["、"],["心","こころ"],["の"],["うち"],["に"],["は"],["偽り","いつわり"],["を"],["いだく"],["。"]]},{"verse":25,"text":"彼,かれが声,こえをやわらげて語,かたっても、信,しんじてはならない。その心,こころに七つの憎,にくむべきものがあるからだ。","tok":[["彼","かれ"],["が"],["声","こえ"],["を"],["やわらげて"],["語って","かたって"],["も"],["、"],["信じて","しんじて"],["は"],["ならない"],["。"],["その"],["心","こころ"],["に"],["七","なな"],["つ"],["の"],["憎むべき","にくむべき"],["もの"],["が"],["ある"],["から"],["だ"],["。"]]},{"verse":26,"text":"たとい偽,いつわりをもってその憎,にくしみをかくしても、彼,かれの悪,あくは会衆,かいしゅうの中,なかに現,あらわれる。","tok":[["たとい"],["偽り","いつわり"],["を"],["もって"],["その"],["憎しみ","にくしみ"],["を"],["かくして"],["も"],["、"],["彼","かれ"],["の"],["悪","あく"],["は"],["会衆","かいしゅう"],["の"],["中","なか"],["に"],["現われる","あらわれる"],["。"]]},{"verse":27,"text":"穴,あなを掘,ほる者,ものは自,みずからその中,なかに陥,おちいる、石,いしをまろばしあげる者,ものの上,うえに、その石,いしはまろびかえる。","tok":[["穴","あな"],["を"],["掘る","ほる"],["者","もの"],["は"],["自から","みずから"],["その"],["中","なか"],["に"],["陥ち","おち"],["いる"],["、"],["石","いし"],["を"],["まろば"],["しあげる"],["者","もの"],["の"],["上","うえ"],["に"],["、"],["その"],["石","いし"],["は"],["まろび"],["かえる"],["。"]]},{"verse":28,"text":"偽,いつわりの舌,したは自分,じぶんが傷,きずつけた者,ものを憎,にくみ、へつらう口,くちは滅,ほろびをきたらせる。","tok":[["偽わり","いつわり"],["の"],["舌","した"],["は"],["自分","じぶん"],["が"],["傷つけた","きずつけた"],["者","もの"],["を"],["憎み","にくみ"],["、"],["へつらう"],["口","くち"],["は"],["滅び","ほろび"],["を"],["きたらせる"],["。"]]}]
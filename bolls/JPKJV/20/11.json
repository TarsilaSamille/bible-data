[{"verse":1,"text":"偽,いつわりのはかりは主,しゅに憎,にくまれ、正,ただしいふんどうは彼,かれに喜,よろこばれる。","tok":[["偽わり","いつわり"],["の"],["はかり"],["は"],["主に","しゅに"],["憎まれ","にくまれ"],["、"],["正い","ただしい"],["ふん"],["どう"],["は"],["彼","かれ"],["に"],["喜こばれる","よろこばれる"],["。"]]},{"verse":2,"text":"高,たかぶりが来,くれば、恥,はじもまた来,くる、へりくだる者,ものには知恵,ちえがある。","tok":[["高か","たか"],["ぶり"],["が"],["来れば","くれば"],["、"],["恥","はじ"],["も"],["また"],["来る","くる"],["、"],["へりくだる"],["者","もの"],["に"],["は"],["知恵","ちえ"],["が"],["ある"],["。"]]},{"verse":3,"text":"正,ただしい者,ものの誠実,せいじつはその人,ひとを導,みちびき、不信実,ふしんじつな者,もののよこしまはその人,ひとを滅,ほろぼす。","tok":[["正い","ただしい"],["者","もの"],["の"],["誠実","せいじつ"],["は"],["その"],["人","ひと"],["を"],["導き","みちびき"],["、"],["不","ふ"],["信実","しんじつ"],["な"],["者","もの"],["の"],["よこしま"],["は"],["その"],["人","ひと"],["を"],["滅ぼす","ほろぼす"],["。"]]},{"verse":4,"text":"宝,たからは怒,いかりの日,ひに益,えきなく、正義,せいぎは人,ひとを救,すくい出,だして、死,しを免,まぬかれさせる。","tok":[["宝","たから"],["は"],["怒り","いかり"],["の"],["日","ひ"],["に"],["益","えき"],["なく"],["、"],["正義","せいぎ"],["は"],["人","ひと"],["を"],["救い出して","すくいだして"],["、"],["死","し"],["を"],["免かれさせる","まぬかれさせる"],["。"]]},{"verse":5,"text":"誠実,せいじつな者,ものは、その正義,せいぎによって、その道,みちをまっすぐにせられ、悪,あしき者,ものは、その悪,あくによって倒,たおれる。","tok":[["誠実","せいじつ"],["な"],["者","もの"],["は"],["、"],["その"],["正義","せいぎ"],["によって"],["、"],["その"],["道","みち"],["を"],["まっすぐ"],["に"],["せられ"],["、"],["悪しき","あしき"],["者","もの"],["は"],["、"],["その"],["悪","あく"],["によって"],["倒れる","たおれる"],["。"]]},{"verse":6,"text":"正,ただしい者,ものはその正義,せいぎによって救,すくわれ、不信実,ふしんじつな者,ものは自分,じぶんの欲,よくによって捕,とらえられる。","tok":[["正い","ただしい"],["者","もの"],["は"],["その"],["正義","せいぎ"],["によって"],["救われ","すくわれ"],["、"],["不","ふ"],["信実","しんじつ"],["な"],["者","もの"],["は"],["自分","じぶん"],["の"],["欲","よく"],["によって"],["捕らえられる","とらえられる"],["。"]]},{"verse":7,"text":"悪,あしき者,ものは死,しぬとき、その望,のぞみは絶,たえ、不信心,ふしんじんな者,ものの望,のぞみもまた絶,たえる。","tok":[["悪しき","あしき"],["者","もの"],["は"],["死ぬ","しぬ"],["とき"],["、"],["その"],["望み","のぞみ"],["は"],["絶え","たえ"],["、"],["不信心","ふしんじん"],["な"],["者","もの"],["の"],["望み","のぞみ"],["も"],["また"],["絶える","たえる"],["。"]]},{"verse":8,"text":"正,ただしい者,ものは、悩,なやみから救,すくわれ、悪,あしき者,ものは代,かわってそれに陥,おちいる。","tok":[["正い","ただしい"],["者","もの"],["は"],["、"],["悩み","なやみ"],["から"],["救われ","すくわれ"],["、"],["悪しき","あしき"],["者","もの"],["は"],["代わって","かわって"],["それ"],["に"],["陥ち","おち"],["いる"],["。"]]},{"verse":9,"text":"不信心,ふしんじんな者,ものはその口,くちをもって隣,となり人,びとを滅,ほろぼす、正,ただしい者,ものは知識,ちしきによって救,すくわれる。","tok":[["不信心","ふしんじん"],["な"],["者","もの"],["は"],["その"],["口","くち"],["を"],["もって"],["隣人","となりびと"],["を"],["滅ぼす","ほろぼす"],["、"],["正い","ただしい"],["者","もの"],["は"],["知識","ちしき"],["によって"],["救われる","すくわれる"],["。"]]},{"verse":10,"text":"正,ただしい者,ものが、しあわせになれば、その町,まちは喜,よろこび、悪,あしき者,ものが滅,ほろびると、喜,よろこびの声,こえがおこる。","tok":[["正い","ただしい"],["者","もの"],["が"],["、"],["しあわせ"],["に"],["なれば"],["、"],["その"],["町","まち"],["は"],["喜こび","よろこび"],["、"],["悪しき","あしき"],["者","もの"],["が"],["滅びる","ほろびる"],["と"],["、"],["喜こび","よろこび"],["の"],["声","こえ"],["が"],["おこる"],["。"]]},{"verse":11,"text":"町,まちは正,ただしい者,ものの祝福,しゅくふくによって、高,たかくあげられ、悪,あしき者,ものの口,くちによって、滅,ほろぼされる。","tok":[["町","まち"],["は"],["正い","ただしい"],["者","もの"],["の"],["祝福","しゅくふく"],["によって"],["、"],["高かく","たかく"],["あげられ"],["、"],["悪しき","あしき"],["者","もの"],["の"],["口","くち"],["によって"],["、"],["滅ぼされる","ほろぼされる"],["。"]]},{"verse":12,"text":"隣,となり人,びとを侮,あなどる者,ものは知恵,ちえがない、さとき人,ひとは口,くちをつぐむ。","tok":[["隣人","となりびと"],["を"],["侮る","あなどる"],["者","もの"],["は"],["知恵","ちえ"],["が"],["ない"],["、"],["さ"],["とき"],["人","ひと"],["は"],["口","くち"],["を"],["つぐむ"],["。"]]},{"verse":13,"text":"人,ひとのよしあしを言,いいあるく者,ものは秘密,ひみつをもらす、心,こころの忠信,ちゅうしんなる者,ものは事,ことを隠,かくす。","tok":[["人","ひと"],["の"],["よしあし"],["を"],["言いあるく","いいあるく"],["者","もの"],["は"],["秘密","ひみつ"],["を"],["もらす"],["、"],["心","こころ"],["の"],["忠信","ちゅうしん"],["なる"],["者","もの"],["は"],["事","こと"],["を"],["隠す","かくす"],["。"]]},{"verse":14,"text":"指導者,しどうしゃがなければ民,たみは倒,たおれ、助言者,じょげんしゃが多,おおければ安全,あんぜんである。","tok":[["指導者","しどうしゃ"],["が"],["なければ"],["民","たみ"],["は"],["倒れ","たおれ"],["、"],["助言者","じょげんしゃ"],["が"],["多ければ","おおければ"],["安全","あんぜん"],["で"],["ある"],["。"]]},{"verse":15,"text":"他人,たにんのために保証,ほしょうをする者,ものは苦,くるしみをうけ、保証,ほしょうをきらう者,ものは安全,あんぜんである。","tok":[["他人","たにん"],["の"],["ため"],["に"],["保証","ほしょう"],["を"],["する"],["者","もの"],["は"],["苦しみ","くるしみ"],["を"],["うけ"],["、"],["保証","ほしょう"],["を"],["きらう"],["者","もの"],["は"],["安全","あんぜん"],["で"],["ある"],["。"]]},{"verse":16,"text":"しとやかな女,おんなは、誉,ほまれを得,え、強暴,きょうぼうな男,おとこは富,とみを得,える。","tok":[["しとやか"],["な"],["女","おんな"],["は"],["、"],["誉","ほまれ"],["を"],["得","え"],["、"],["強暴","きょうぼう"],["な"],["男","おとこ"],["は"],["富","とみ"],["を"],["得る","える"],["。"]]},{"verse":17,"text":"いつくしみある者,ものはおのれ自身,じしんに益,えきを得,え、残忍,ざんにんな者,ものはおのれの身,みをそこなう。","tok":[["いつくしみ"],["ある"],["者","もの"],["は"],["おのれ"],["自身","じしん"],["に"],["益","えき"],["を"],["得","え"],["、"],["残忍","ざんにん"],["な"],["者","もの"],["は"],["おのれ"],["の"],["身","み"],["を"],["そこなう"],["。"]]},{"verse":18,"text":"悪,あしき者,ものの得,える報,むくいはむなしく、正義,せいぎを播,まく者,ものは確,たしかな報,むくいを得,える。","tok":[["悪しき","あしき"],["者","もの"],["の"],["得る","える"],["報い","むくい"],["は"],["むなしく"],["、"],["正義","せいぎ"],["を"],["播く","まく"],["者","もの"],["は"],["確か","たしか"],["な"],["報い","むくい"],["を"],["得る","える"],["。"]]},{"verse":19,"text":"正義,せいぎを堅,かたく保,たもつ者,ものは命,いのちに至,いたり、悪,あくを追,おい求,もとめる者,ものは死,しを招,まねく。","tok":[["正義","せいぎ"],["を"],["堅く","かたく"],["保つ","たもつ"],["者","もの"],["は"],["命","いのち"],["に"],["至","いたり"],["、"],["悪","あく"],["を"],["追い求める","おいもとめる"],["者","もの"],["は"],["死","し"],["を"],["招く","まねく"],["。"]]},{"verse":20,"text":"心,こころのねじけた者,ものは主,しゅに憎,にくまれ、まっすぐに道,みちを歩,あゆむ者,ものは彼,かれに喜,よろこばれる。","tok":[["心","こころ"],["の"],["ねじけた"],["者","もの"],["は"],["主に","しゅに"],["憎まれ","にくまれ"],["、"],["まっすぐ"],["に"],["道","みち"],["を"],["歩む","あゆむ"],["者","もの"],["は"],["彼","かれ"],["に"],["喜こばれる","よろこばれる"],["。"]]},{"verse":21,"text":"確,たしかに、悪人,あくにんは罰,ばつを免,まぬかれない、しかし正,ただしい人,ひとは救,すくいを得,える。","tok":[["確か","たしか"],["に"],["、"],["悪人","あくにん"],["は"],["罰","ばつ"],["を"],["免かれない","まぬかれない"],["、"],["しかし"],["正い","ただしい"],["人","ひと"],["は"],["救い","すくい"],["を"],["得る","える"],["。"]]},{"verse":22,"text":"美,うつくしい女,おんなの慎,つつしみがないのは、金,きんの輪,わの、ぶたの鼻,はなにあるようだ。","tok":[["美しい","うつくしい"],["女","おんな"],["の"],["慎しみ","つつしみ"],["が"],["ない"],["の"],["は"],["、"],["金","きん"],["の"],["輪","わ"],["の"],["、"],["ぶた"],["の"],["鼻","はな"],["に"],["ある"],["よう"],["だ"],["。"]]},{"verse":23,"text":"正,ただしい者,ものの願,ねがいは、すべて良,よい結果,けっかを得,え、悪,あしき者,ものの望,のぞみは怒,いかりに至,いたる。","tok":[["正い","ただしい"],["者","もの"],["の"],["願い","ねがい"],["は"],["、"],["すべて"],["良い","よい"],["結果","けっか"],["を"],["得","え"],["、"],["悪しき","あしき"],["者","もの"],["の"],["望み","のぞみ"],["は"],["怒り","いかり"],["に"],["至る","いたる"],["。"]]},{"verse":24,"text":"施,ほどこし散,ちらして、なお富,とみを増,ます人,ひとがあり、与,あたえるべきものを惜,おしんで、かえって貧,まずしくなる者,ものがある。","tok":[["施し","ほどこし"],["散らして","ちらして"],["、"],["なお"],["富","とみ"],["を"],["増す","ます"],["人","ひと"],["が"],["あり"],["、"],["与えるべき","あたえるべき"],["もの"],["を"],["惜しんで","おしんで"],["、"],["かえって"],["貧しく","まずしく"],["なる"],["者","もの"],["が"],["ある"],["。"]]},{"verse":25,"text":"物惜,ものおしみしない者,ものは富,とみ、人,ひとを潤,うるおす者,ものは自分,じぶんも潤,うるおされる。","tok":[["物","もの"],["惜み","おしみ"],["しない"],["者","もの"],["は"],["富","とみ"],["、"],["人","ひと"],["を"],["潤おす","うるおす"],["者","もの"],["は"],["自分","じぶん"],["も"],["潤おされる","うるおされる"],["。"]]},{"verse":26,"text":"穀物,こくもつを、しまい込,こんで売,うらない者,ものは民,たみにのろわれる、それを売,うる者,もののこうべには祝福,しゅくふくがある。","tok":[["穀物","こくもつ"],["を"],["、"],["しまい込んで","しまいこんで"],["売らない","うらない"],["者","もの"],["は"],["民","たみ"],["に"],["のろわれる"],["、"],["それ"],["を"],["売る","うる"],["者","もの"],["の"],["こうべ"],["に"],["は"],["祝福","しゅくふく"],["が"],["ある"],["。"]]},{"verse":27,"text":"善,ぜんを求,もとめる者,ものは恵,めぐみを得,える、悪,あくを求,もとめる者,ものには悪,あくが来,くる。","tok":[["善","ぜん"],["を"],["求める","もとめる"],["者","もの"],["は"],["恵","めぐみ"],["を"],["得る","える"],["、"],["悪","あく"],["を"],["求める","もとめる"],["者","もの"],["に"],["は"],["悪","あく"],["が"],["来る","くる"],["。"]]},{"verse":28,"text":"自分,じぶんの富,とみを頼,たのむ者,ものは衰,おとろえる、正,ただしい者,ものは木,きの青葉,あおばのように栄,さかえる。","tok":[["自分","じぶん"],["の"],["富","とみ"],["を"],["頼む","たのむ"],["者","もの"],["は"],["衰える","おとろえる"],["、"],["正い","ただしい"],["者","もの"],["は"],["木","き"],["の"],["青葉","あおば"],["の"],["よう"],["に"],["栄","さかえ"],["る"],["。"]]},{"verse":29,"text":"自分,じぶんの家族,かぞくを苦,くるしめる者,ものは風,かぜを所有,しょゆうとする、愚,おろかな者,ものは心,こころのさとき者,もののしもべとなる。","tok":[["自分","じぶん"],["の"],["家族","かぞく"],["を"],["苦しめる","くるしめる"],["者","もの"],["は"],["風","かぜ"],["を"],["所有","しょゆう"],["と"],["する"],["、"],["愚か","おろか"],["な"],["者","もの"],["は"],["心","こころ"],["の"],["さ"],["とき"],["者","もの"],["の"],["しもべ"],["と"],["なる"],["。"]]},{"verse":30,"text":"正,ただしい者,ものの結,むすぶ実,みは命,いのちの木,きである、不法,ふほうな者,ものは人,ひとの命,いのちをとる。","tok":[["正い","ただしい"],["者","もの"],["の"],["結ぶ","むすぶ"],["実","み"],["は"],["命","いのち"],["の"],["木","き"],["で"],["ある"],["、"],["不法","ふほう"],["な"],["者","もの"],["は"],["人","ひと"],["の"],["命","いのち"],["を"],["とる"],["。"]]},{"verse":31,"text":"もし正,ただしい者,ものがこの世,よで罰,ばっせられるならば、悪,あしき者,ものと罪,つみびととは、なおさらである。","tok":[["もし"],["正い","ただしい"],["者","もの"],["が"],["この世","このよ"],["で"],["罰せられるならば","ばっせられるならば"],["、"],["悪しき","あしき"],["者","もの"],["と"],["罪びと","つみびと"],["と"],["は"],["、"],["なおさら"],["で"],["ある"],["。"]]}]
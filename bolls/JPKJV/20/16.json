[{"verse":1,"text":"心,こころにはかることは人,ひとに属,ぞくし、舌,したの答,こたえは主,しゅから出,でる。","tok":[["心","こころ"],["に"],["はかる"],["こと"],["は"],["人","ひと"],["に"],["属し","ぞくし"],["、"],["舌","した"],["の"],["答","こたえ"],["は"],["主ら","しゅから"],["出る","でる"],["。"]]},{"verse":2,"text":"人,ひとの道,みちは自分,じぶんの目,めにことごとく潔,いさぎよしと見,みえる、しかし主,しゅは人,ひとの魂,たましいをはかられる。","tok":[["人","ひと"],["の"],["道","みち"],["は"],["自分","じぶん"],["の"],["目","め"],["に"],["ことごとく"],["潔ぎよ","いさぎよ"],["し"],["と"],["見える","みえる"],["、"],["しかし"],["主","しゅ"],["は"],["人","ひと"],["の"],["魂","たましい"],["を"],["はかられる"],["。"]]},{"verse":3,"text":"あなたのなすべき事,ことを主,しゅにゆだねよ、そうすれば、あなたの計,はかるところは必,かならず成,なる。","tok":[["あなた"],["の"],["なすべき"],["事","こと"],["を"],["主に","しゅに"],["ゆだねよ"],["、"],["そう"],["すれば"],["、"],["あなた"],["の"],["計る","はかる"],["ところ"],["は"],["必","かならず"],["成る","なる"],["。"]]},{"verse":4,"text":"主,しゅはすべての物,ものをおのおのその用,ようのために造,つくり、悪,あしき人,ひとをも災,わざわいの日,ひのために造,つくられた。","tok":[["主","しゅ"],["は"],["すべて"],["の"],["物","もの"],["を"],["おのおの"],["その"],["用","よう"],["の"],["ため"],["に"],["造","つくり"],["、"],["悪しき","あしき"],["人","ひと"],["を"],["も"],["災","わざわい"],["の"],["日","ひ"],["の"],["ため"],["に"],["造られた","つくられた"],["。"]]},{"verse":5,"text":"すべて心,こころに高,たかぶる者,ものは主,しゅに憎,にくまれる、確,たしかに、彼,かれは罰,ばつを免,まぬかれない。","tok":[["すべて"],["心","こころ"],["に"],["高か","たか"],["ぶる"],["者","もの"],["は"],["主に","しゅに"],["憎まれる","にくまれる"],["、"],["確か","たしか"],["に"],["、"],["彼","かれ"],["は"],["罰","ばつ"],["を"],["免かれない","まぬかれない"],["。"]]},{"verse":6,"text":"いつくしみとまことによって、とがはあがなわれる、主,しゅを恐,おそれることによって、人,ひとは悪,あくを免,まぬかれる。","tok":[["いつくしみ"],["と"],["まこと"],["によって"],["、"],["とが"],["は"],["あがなわれる"],["、"],["主","しゅ"],["を"],["恐れる","おそれる"],["こと"],["によって"],["、"],["人","ひと"],["は"],["悪","あく"],["を"],["免かれる","まぬかれる"],["。"]]},{"verse":7,"text":"人,ひとの道,みちが主,しゅを喜,よろこばせる時,とき、主,しゅはその人,ひとの敵,てきをもその人,ひとと和,やわらがせられる。","tok":[["人","ひと"],["の"],["道","みち"],["が"],["主","しゅ"],["を"],["喜こばせる","よろこばせる"],["時","とき"],["、"],["主","しゅ"],["は"],["その"],["人","ひと"],["の"],["敵","てき"],["を"],["も"],["その"],["人","ひと"],["と"],["和らがせられる","やわらがせられる"],["。"]]},{"verse":8,"text":"正義,せいぎによって得,えたわずかなものは、不義,ふぎによって得,えた多,おおくの宝,たからにまさる。","tok":[["正義","せいぎ"],["によって"],["得た","えた"],["わずか"],["な"],["もの"],["は"],["、"],["不義","ふぎ"],["によって"],["得た","えた"],["多く","おおく"],["の"],["宝","たから"],["に"],["まさる"],["。"]]},{"verse":9,"text":"人,ひとは心,こころに自分,じぶんの道,みちを考,かんがえ計,はかる、しかし、その歩,あゆみを導,みちびく者,ものは主,しゅである。","tok":[["人","ひと"],["は"],["心","こころ"],["に"],["自分","じぶん"],["の"],["道","みち"],["を"],["考","かんがえ"],["計る","はかる"],["、"],["しかし"],["、"],["その"],["歩み","あゆみ"],["を"],["導く","みちびく"],["者","もの"],["は"],["主","しゅ"],["で"],["ある"],["。"]]},{"verse":10,"text":"王,おうのくちびるには神,かみの決定,けっていがある、さばきをするとき、その口,くちに誤,あやまりがない。","tok":[["王","おう"],["の"],["くちびる"],["に"],["は"],["神","かみ"],["の"],["決定","けってい"],["が"],["ある"],["、"],["さばき"],["を"],["する"],["とき"],["、"],["その"],["口","くち"],["に"],["誤り","あやまり"],["が"],["ない"],["。"]]},{"verse":11,"text":"正,ただしいはかりと天,てんびんとは主,しゅのものである、袋,ふくろにあるふんどうもすべて彼,かれの造,つくられたものである。","tok":[["正い","ただしい"],["はかり"],["と"],["天びん","てんびん"],["と"],["は"],["主","しゅ"],["の"],["もの"],["で"],["ある"],["、"],["袋","ふくろ"],["に"],["ある"],["ふん"],["どう"],["も"],["すべて"],["彼","かれ"],["の"],["造られた","つくられた"],["もの"],["で"],["ある"],["。"]]},{"verse":12,"text":"悪,あくを行,おこなうことは王,おうの憎,にくむところである、その位,くらいが正義,せいぎによって堅,かたく立,たっているからである。","tok":[["悪","あく"],["を"],["行なう","おこなう"],["こと"],["は"],["王","おう"],["の"],["憎む","にくむ"],["ところ"],["で"],["ある"],["、"],["その"],["位","くらい"],["が"],["正義","せいぎ"],["によって"],["堅く","かたく"],["立って","たって"],["いる"],["から"],["で"],["ある"],["。"]]},{"verse":13,"text":"正,ただしいくちびるは王,おうに喜,よろこばれる、彼,かれは正,ただしい事,ことを言,いう者,ものを愛,あいする。","tok":[["正い","ただしい"],["くちびる"],["は"],["王","おう"],["に"],["喜こばれる","よろこばれる"],["、"],["彼","かれ"],["は"],["正い","ただしい"],["事","こと"],["を"],["言う","いう"],["者","もの"],["を"],["愛する","あいする"],["。"]]},{"verse":14,"text":"王,おうの怒,いかりは死,しの使者,ししゃである、知恵,ちえある人,ひとはこれをなだめる。","tok":[["王","おう"],["の"],["怒り","いかり"],["は"],["死","し"],["の"],["使者","ししゃ"],["で"],["ある"],["、"],["知恵","ちえ"],["ある"],["人","ひと"],["は"],["これ"],["を"],["なだめる"],["。"]]},{"verse":15,"text":"王,おうの顔,かおの光,ひかりには命,いのちがある、彼,かれの恵,めぐみは春雨,はるさめをもたらす雲,くものようだ。","tok":[["王","おう"],["の"],["顔","かお"],["の"],["光","ひかり"],["に"],["は"],["命","いのち"],["が"],["ある"],["、"],["彼","かれ"],["の"],["恵","めぐみ"],["は"],["春雨","はるさめ"],["を"],["もたらす"],["雲","くも"],["の"],["よう"],["だ"],["。"]]},{"verse":16,"text":"知恵,ちえを得,えるのは金,きんを得,えるのにまさる、悟,さとりを得,えるのは銀,ぎんを得,えるよりも望,のぞましい。","tok":[["知恵","ちえ"],["を"],["得る","える"],["の"],["は"],["金","きん"],["を"],["得る","える"],["のに"],["まさる"],["、"],["悟り","さとり"],["を"],["得る","える"],["の"],["は"],["銀","ぎん"],["を"],["得る","える"],["より"],["も"],["望ましい","のぞましい"],["。"]]},{"verse":17,"text":"悪,あくを離,はなれることは正,ただしい人,ひとの道,みちである、自分,じぶんの道,みちを守,まもる者,ものはその魂,たましいを守,まもる。","tok":[["悪","あく"],["を"],["離れる","はなれる"],["こと"],["は"],["正い","ただしい"],["人","ひと"],["の"],["道","みち"],["で"],["ある"],["、"],["自分","じぶん"],["の"],["道","みち"],["を"],["守者","まもるもの"],["は"],["その"],["魂","たましい"],["を"],["守","まもる"],["。"]]},{"verse":18,"text":"高,たかぶりは滅,ほろびにさきだち、誇,ほこる心,こころは倒,たおれにさきだつ。","tok":[["高か","たか"],["ぶり"],["は"],["滅び","ほろび"],["に"],["さきだち"],["、"],["誇る","ほこる"],["心","こころ"],["は"],["倒れ","たおれ"],["に"],["さきだつ"],["。"]]},{"verse":19,"text":"へりくだって貧,まずしい人々,ひとびとと共,ともにおるのは、高,たかぶる者,ものと共,ともにいて、獲物,えものを分,わけるにまさる。","tok":[["へりくだって"],["貧しい","まずしい"],["人々","ひとびと"],["と"],["共","とも"],["に"],["おる"],["の"],["は"],["、"],["高か","たか"],["ぶる"],["者","もの"],["と"],["共","とも"],["に"],["いて"],["、"],["獲物","えもの"],["を"],["分ける","わける"],["に"],["まさる"],["。"]]},{"verse":20,"text":"慎,つつしんで、み言葉,ことばをおこなう者,ものは栄,さかえる、主,しゅに寄,より頼,たのむ者,ものはさいわいである。","tok":[["慎しんで","つつしんで"],["、"],["み言葉","みことば"],["を"],["おこなう"],["者","もの"],["は"],["栄","さかえ"],["る"],["、"],["主に","しゅに"],["寄り","より"],["頼む","たのむ"],["者","もの"],["は"],["さいわい"],["で"],["ある"],["。"]]},{"verse":21,"text":"心,こころに知恵,ちえある者,ものはさとき者,ものととなえられる、くちびるが甘,あまければ、その教,おしえに人,ひとを説,ときつける力,ちからを増,ます。","tok":[["心","こころ"],["に"],["知恵","ちえ"],["ある"],["者","もの"],["は"],["さ"],["とき"],["者","もの"],["と"],["となえられる"],["、"],["くちびる"],["が"],["甘ければ","あまければ"],["、"],["その"],["教え","おしえ"],["に"],["人","ひと"],["を"],["説きつける","ときつける"],["力","ちから"],["を"],["増す","ます"],["。"]]},{"verse":22,"text":"知恵,ちえはこれを持,もつ者,ものに命,いのちの泉,いずみとなる、しかし、愚,おろかさは愚,おろかな者,ものの受,うける懲,こらしめである。","tok":[["知恵","ちえ"],["は"],["これ"],["を"],["持つ","もつ"],["者","もの"],["に"],["命","いのち"],["の"],["泉","いずみ"],["と"],["なる"],["、"],["しかし"],["、"],["愚か","おろか"],["さ"],["は"],["愚か","おろか"],["な"],["者","もの"],["の"],["受ける","うける"],["懲らしめ","こらしめ"],["で"],["ある"],["。"]]},{"verse":23,"text":"知恵,ちえある者,ものの心,こころはその言,いうところを賢,かしこくし、またそのくちびるに人,ひとを説,ときつける力,ちからを増,ます。","tok":[["知恵","ちえ"],["ある"],["者","もの"],["の"],["心","こころ"],["は"],["その"],["言う","いう"],["ところ"],["を"],["賢しこく","かしこく"],["し"],["、"],["また"],["その"],["くちびる"],["に"],["人","ひと"],["を"],["説きつける","ときつける"],["力","ちから"],["を"],["増す","ます"],["。"]]},{"verse":24,"text":"ここちよい言葉,ことばは蜂蜜,はちみつのように、魂,たましいに甘,あまく、からだを健,すこやかにする。","tok":[["ここちよい"],["言葉","ことば"],["は"],["蜂蜜","はちみつ"],["の"],["よう"],["に"],["、"],["魂","たましい"],["に"],["甘く","あまく"],["、"],["からだ"],["を"],["健やか","すこやか"],["に"],["する"],["。"]]},{"verse":25,"text":"人,ひとが見,みて自分,じぶんで正,ただしいとする道,みちがあり、その終,おわりはついに死,しにいたる道,みちとなるものがある。","tok":[["人","ひと"],["が"],["見て","みて"],["自分","じぶん"],["で"],["正い","ただしい"],["と"],["する"],["道","みち"],["が"],["あり"],["、"],["その"],["終","おわり"],["は"],["ついに"],["死","し"],["に"],["いたる"],["道","みち"],["と"],["なる"],["もの"],["が"],["ある"],["。"]]},{"verse":26,"text":"ほねおる者,ものは飲食,いんしょくのためにほねおる、その口,くちが自分,じぶんに迫,せまるからである。","tok":[["ほねおる"],["者","もの"],["は"],["飲食","いんしょく"],["の"],["ため"],["に"],["ほねおる"],["、"],["その"],["口","くち"],["が"],["自分","じぶん"],["に"],["迫まる","せまる"],["から"],["で"],["ある"],["。"]]},{"verse":27,"text":"よこしまな人,ひとは悪,あくを企,くわだてる、そのくちびるには激,はげしい火,ひのようなものがある。","tok":[["よこしま"],["な"],["人","ひと"],["は"],["悪","あく"],["を"],["企だてる","くわだてる"],["、"],["その"],["くちびる"],["に"],["は"],["激しい","はげしい"],["火","ひ"],["の"],["よう"],["な"],["もの"],["が"],["ある"],["。"]]},{"verse":28,"text":"偽,いつわる者,ものは争,あらそいを起,おこし、つげ口,ぐちする者,ものは親,したしい友,ともを離,はなれさせる。","tok":[["偽わる","いつわる"],["者","もの"],["は"],["争い","あらそい"],["を"],["起こし","おこし"],["、"],["つげ口","つげぐち"],["する"],["者","もの"],["は"],["親しい","したしい"],["友","とも"],["を"],["離れさせる","はなれさせる"],["。"]]},{"verse":29,"text":"しえたげる者,ものはその隣,となり人,びとをいざない、これを良,よくない道,みちに導,みちびく。","tok":[["し"],["えたげる"],["者","もの"],["は"],["その"],["隣人","となりびと"],["を"],["いざない"],["、"],["これ"],["を"],["良く","よく"],["ない"],["道","みち"],["に"],["導く","みちびく"],["。"]]},{"verse":30,"text":"めくばせする者,ものは悪,あくを計,はかり、くちびるを縮,ちぢめる者,ものは悪事,あくじをなし遂,とげる。","tok":[["めくばせ"],["する"],["者","もの"],["は"],["悪","あく"],["を"],["計り","はかり"],["、"],["くちびる"],["を"],["縮める","ちぢめる"],["者","もの"],["は"],["悪事","あくじ"],["を"],["なし遂げる","なしとげる"],["。"]]},{"verse":31,"text":"しらがは栄,さかえの冠,かんむりである、正,ただしく生,いきることによってそれが得,えられる。","tok":[["しらが"],["は"],["栄","さかえ"],["の"],["冠","かんむり"],["で"],["ある"],["、"],["正く","ただしく"],["生きる","いきる"],["こと"],["によって"],["それ"],["が"],["得られる","えられる"],["。"]]},{"verse":32,"text":"怒,いかりをおそくする者,ものは勇士,ゆうしにまさり、自分,じぶんの心,こころを治,おさめる者,ものは城,しろを攻,せめ取,とる者,ものにまさる。","tok":[["怒り","いかり"],["を"],["おそく"],["する"],["者","もの"],["は"],["勇士","ゆうし"],["に"],["まさり"],["、"],["自分","じぶん"],["の"],["心","こころ"],["を"],["治める","おさめる"],["者","もの"],["は"],["城","しろ"],["を"],["攻め取る","せめとる"],["者","もの"],["に"],["まさる"],["。"]]},{"verse":33,"text":"人,ひとはくじをひく、しかし事,ことを定,さだめるのは全,まったく主,しゅのことである。","tok":[["人","ひと"],["は"],["くじ"],["を"],["ひく"],["、"],["しかし"],["事","こと"],["を"],["定める","さだめる"],["の"],["は"],["全く","まったく"],["主","しゅ"],["の"],["こと"],["で"],["ある"],["。"]]}]
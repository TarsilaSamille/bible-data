[{"verse":1,"text":"マッサの人,ひとヤケの子,こアグルの言葉,ことば。その人,ひとはイテエルに向,むかって言,いった、すなわちイテエルと、ウカルとに向,むかって言,いった、","tok":[["マッサ"],["の"],["人","ひと"],["ヤケ"],["の"],["子","こ"],["アグル"],["の"],["言葉","ことば"],["。"],["その"],["人","ひと"],["は"],["イテエル"],["に"],["向かって","むかって"],["言った","いった"],["、"],["すなわち"],["イテエル"],["と"],["、"],["ウカル"],["と"],["に"],["向かって","むかって"],["言った","いった"],["、"]]},{"verse":2,"text":"わたしは確,たしかに人,ひとよりも愚,おろかであり、わたしには人,ひとの悟,さとりがない。","tok":[["わたし"],["は"],["確か","たしか"],["に"],["人","ひと"],["より"],["も"],["愚か","おろか"],["で"],["あり"],["、"],["わたし"],["に"],["は"],["人","ひと"],["の"],["悟り","さとり"],["が"],["ない"],["。"]]},{"verse":3,"text":"わたしはまだ知恵,ちえをならうことができず、また、聖,せいなる者,ものを悟,さとることもできない。","tok":[["わたし"],["は"],["まだ"],["知恵","ちえ"],["を"],["ならう"],["こと"],["が"],["できず"],["、"],["また"],["、"],["聖","せい"],["なる"],["者","もの"],["を"],["悟","さとる"],["こと"],["も"],["できない"],["。"]]},{"verse":4,"text":"天,てんにのぼったり、下,くだったりしたのはだれか、風,かぜをこぶしの中,なかに集,あつめたのはだれか、水,みずを着物,きものに包,つつんだのはだれか、地,ちのすべての限界,げんかいを定,さだめた者,ものはだれか、その名,なは何,なにか、その子,この名,なは何,なにか、あなたは確,たしかにそれを知,しっている。","tok":[["天","てん"],["に"],["のぼっ"],["たり"],["、"],["下っ","くだっ"],["たり"],["した"],["の"],["は"],["だれ"],["か"],["、"],["風","かぜ"],["を"],["こぶし"],["の"],["中","なか"],["に"],["集めた","あつめた"],["の"],["は"],["だれ"],["か"],["、"],["水","みず"],["を"],["着物","きもの"],["に"],["包","つつんだ"],["の"],["は"],["だれ"],["か"],["、"],["地","ち"],["の"],["すべて"],["の"],["限界","げんかい"],["を"],["定めた","さだめた"],["者","もの"],["は"],["だれ"],["か"],["、"],["その"],["名","な"],["は"],["何に","なに"],["か"],["、"],["その"],["子","こ"],["の"],["名","な"],["は"],["何に","なに"],["か"],["、"],["あなた"],["は"],["確か","たしか"],["に"],["それ"],["を"],["知って","しって"],["いる"],["。"]]},{"verse":5,"text":"神,かみの言葉,ことばはみな真実,しんじつである、神,かみは彼,かれに寄,より頼,たのむ者,ものの盾,たてである。","tok":[["神","かみ"],["の"],["言葉","ことば"],["は"],["みな"],["真実","しんじつ"],["で"],["ある"],["、"],["神","かみ"],["は"],["彼","かれ"],["に"],["寄り","より"],["頼む","たのむ"],["者","もの"],["の"],["盾","たて"],["で"],["ある"],["。"]]},{"verse":6,"text":"その言葉,ことばに付,つけ加,くわえてはならない、彼,かれがあなたを責,せめ、あなたを偽,いつわり者,ものとされないためだ。","tok":[["その"],["言葉","ことば"],["に"],["付け加えて","つけくわえて"],["は"],["ならない"],["、"],["彼","かれ"],["が"],["あなた"],["を"],["責","せめ"],["、"],["あなた"],["を"],["偽わり","いつわり"],["者","もの"],["と"],["されない"],["ため"],["だ"],["。"]]},{"verse":7,"text":"わたしは二つのことをあなたに求,もとめます、わたしの死,しなないうちに、これをかなえてください。","tok":[["わたし"],["は"],["二","ふた"],["つ"],["の"],["こと"],["を"],["あなた"],["に"],["求めます","もとめます"],["、"],["わたし"],["の"],["死なない","しなない"],["うち"],["に"],["、"],["これ"],["を"],["かなえて"],["ください"],["。"]]},{"verse":8,"text":"うそ、偽,いつわりをわたしから遠,とおざけ、貧,まずしくもなく、また富,とみもせず、ただなくてならぬ食物,しょくもつでわたしを養,やしなってください。","tok":[["うそ"],["、"],["偽り","いつわり"],["を"],["わたし"],["から"],["遠ざけ","とおざけ"],["、"],["貧しく","まずしく"],["も"],["なく"],["、"],["また"],["富","とみ"],["も"],["せず"],["、"],["ただ"],["なくて"],["ならぬ"],["食物","しょくもつ"],["で"],["わたし"],["を"],["養って","やしなって"],["ください"],["。"]]},{"verse":9,"text":"飽,あき足,たりて、あなたを知,しらないといい、「主,しゅとはだれか」と言,いうことのないため、また貧,まずしくて盗,ぬすみをし、わたしの神,かみの名,なを汚,よごすことのないためです。","tok":[["飽き足りて","あきたりて"],["、"],["あなた"],["を"],["知らない","しらない"],["と"],["いい"],["、"],["「"],["主","しゅと"],["は"],["だれ"],["か"],["」"],["と"],["言う","いう"],["こと"],["の"],["ない"],["ため"],["、"],["また"],["貧しくて","まずしくて"],["盗み","ぬすみ"],["を"],["し"],["、"],["わたし"],["の"],["神","かみ"],["の"],["名","な"],["を"],["汚","よごすこ"],["と"],["の"],["ない"],["ため"],["です"],["。"]]},{"verse":10,"text":"あなたは、しもべのことをその主人,しゅじんに、あしざまにいってはならない、そうでないと彼,かれはあなたをのろい、あなたは罪,つみをきせられる。","tok":[["あなた"],["は"],["、"],["しもべ"],["の"],["こと"],["を"],["その"],["主人","しゅじん"],["に"],["、"],["あしざま"],["に"],["いって"],["は"],["ならない"],["、"],["そう"],["で"],["ない"],["と"],["彼","かれ"],["は"],["あなた"],["を"],["のろい"],["、"],["あなた"],["は"],["罪","つみ"],["を"],["きせられる"],["。"]]},{"verse":11,"text":"世,よには父,ちちをのろったり、母,ははを祝福,しゅくふくしない者,ものがある。","tok":[["世","よ"],["に"],["は"],["父","ちち"],["を"],["のろっ"],["たり"],["、"],["母","はは"],["を"],["祝福","しゅくふく"],["しない"],["者","もの"],["が"],["ある"],["。"]]},{"verse":12,"text":"世,よには自分,じぶんの目,めにみずからを清,きよい者,ものとして、なおその汚,けがれを洗,あらわれないものがある。","tok":[["世","よ"],["に"],["は"],["自分","じぶん"],["の"],["目","め"],["に"],["みずから"],["を"],["清い","きよい"],["者","もの"],["として"],["、"],["なお"],["その"],["汚","けがれ"],["を"],["洗われない","あらわれない"],["もの"],["が"],["ある"],["。"]]},{"verse":13,"text":"世,よにはまた、このような人,ひとがある――ああ、その目,めのいかに高,たかきことよ、またそのまぶたのいかにつりあがっていることよ。","tok":[["世","よ"],["に"],["は"],["また"],["、"],["この"],["よう"],["な"],["人","ひと"],["が"],["ある"],["―"],["―"],["ああ"],["、"],["その"],["目","め"],["の"],["いかに"],["高き","たかき"],["こと"],["よ"],["、"],["また"],["その"],["まぶた"],["の"],["いかに"],["つりあがって"],["いる"],["こと"],["よ"],["。"]]},{"verse":14,"text":"世,よにはまたつるぎのような歯,はをもち、刀,かたなのようなきばをもって、貧,まずしい者,ものを地,ちの上,うえから、乏,とぼしい者,ものを人,ひとの中,なかから食,くい滅,ほろぼすものがある。","tok":[["世","よ"],["に"],["は"],["また"],["つるぎ"],["の"],["よう"],["な"],["歯","は"],["を"],["もち"],["、"],["刀","かたな"],["の"],["よう"],["な"],["きば"],["を"],["もって"],["、"],["貧しい","まずしい"],["者","もの"],["を"],["地","ち"],["の"],["上","うえ"],["から"],["、"],["乏い","とぼしい"],["者","もの"],["を"],["人","ひと"],["の"],["中","なか"],["から"],["食い滅ぼす","くいほろぼす"],["もの"],["が"],["ある"],["。"]]},{"verse":15,"text":"蛭,ひるにふたりの娘,むすめがあって、「与,あたえよ、与,あたえよ」という。飽,あくことを知,しらないものが三つある、いや、四つあって、皆,みな「もう、たくさんです」と言,いわない。","tok":[["蛭","ひる"],["に"],["ふたり"],["の"],["娘","むすめ"],["が"],["あって"],["、"],["「"],["与","あたえ"],["よ"],["、"],["与","あたえ"],["よ"],["」"],["と"],["いう"],["。"],["飽く","あく"],["こと"],["を"],["知らない","しらない"],["もの"],["が"],["三","みっ"],["つ"],["ある"],["、"],["いや"],["、"],["四","よん"],["つ"],["あって"],["、"],["皆","みな"],["「"],["もう"],["、"],["たくさん"],["です"],["」"],["と"],["言わない","いわない"],["。"]]},{"verse":16,"text":"すなわち陰府,よみ、不妊,ふにんの胎,たい、水,みずにかわく地,ち、「もう、たくさんだ」といわない火,ひがそれである。","tok":[["すなわち"],["陰府","よみ"],["、"],["不妊","ふにん"],["の"],["胎","た"],["い"],["、"],["水","みず"],["に"],["かわく"],["地","ち"],["、"],["「"],["もう"],["、"],["たくさん"],["だ"],["」"],["と"],["いわない"],["火","ひ"],["が"],["それ"],["で"],["ある"],["。"]]},{"verse":17,"text":"自分,じぶんの父,ちちをあざけり、母,ははに従,したがうのを卑,いやしいこととする目,めは、谷,たにのからすがこれをつつき出,だし、はげたかがこれを食,たべる。","tok":[["自分","じぶん"],["の"],["父","ちち"],["を"],["あざけり"],["、"],["母","はは"],["に"],["従う","したがう"],["の"],["を"],["卑しい","いやしい"],["こと"],["と"],["する"],["目","め"],["は"],["、"],["谷","たに"],["の"],["からす"],["が"],["これ"],["を"],["つつき出し","つつきだし"],["、"],["はげたか"],["が"],["これ"],["を"],["食べる","たべる"],["。"]]},{"verse":18,"text":"わたしにとって不思議,ふしぎにたえないことが三つある、いや、四つあって、わたしには悟,さとることができない。","tok":[["わたし"],["にとって"],["不思議","ふしぎ"],["に"],["たえない"],["こと"],["が"],["三","みっ"],["つ"],["ある"],["、"],["いや"],["、"],["四","よん"],["つ"],["あって"],["、"],["わたし"],["に"],["は"],["悟","さとる"],["こと"],["が"],["できない"],["。"]]},{"verse":19,"text":"すなわち空,そらを飛,とぶはげたかの道,みち、岩,いわの上,うえを這,はうへびの道,みち、海,うみをはしる舟,ふねの道,みち、男,おとこの女,おんなにあう道,みちがそれである。","tok":[["すなわち"],["空","そら"],["を"],["飛ぶ","とぶ"],["はげたか"],["の"],["道","みち"],["、"],["岩","いわ"],["の"],["上","うえ"],["を"],["這う","はう"],["へび"],["の"],["道","みち"],["、"],["海","うみ"],["を"],["はしる"],["舟","ふね"],["の"],["道","みち"],["、"],["男","おとこ"],["の"],["女","おんな"],["に"],["あう"],["道","みち"],["が"],["それ"],["で"],["ある"],["。"]]},{"verse":20,"text":"遊女,ゆうじょの道,みちもまたそうだ、彼女,かのじょは食,たべて、その口,くちをぬぐって、「わたしは何,なにもわるいことはしない」と言,いう。","tok":[["遊女","ゆうじょ"],["の"],["道","みち"],["も"],["また"],["そう"],["だ"],["、"],["彼女","かのじょ"],["は"],["食べて","たべて"],["、"],["その"],["口","くち"],["を"],["ぬぐって"],["、"],["「"],["わたし"],["は"],["何に","なに"],["も"],["わるい"],["こと"],["は"],["しない"],["」"],["と"],["言う","いう"],["。"]]},{"verse":21,"text":"地,ちは三つのことによって震,ふるう、いや、四つのことによって、耐,たえることができない。","tok":[["地","ち"],["は"],["三","みっ"],["つ"],["の"],["こと"],["によって"],["震う","ふるう"],["、"],["いや"],["、"],["四","よん"],["つ"],["の"],["こと"],["によって"],["、"],["耐える","たえる"],["こと"],["が"],["できない"],["。"]]},{"verse":22,"text":"すなわち奴隷,どれいたる者,ものが王,おうとなり、愚,おろかな者,ものが食物,しょくもつに飽,あき、","tok":[["すなわち"],["奴隷","どれい"],["たる"],["者","もの"],["が"],["王","おう"],["と"],["なり"],["、"],["愚か","おろか"],["な"],["者","もの"],["が"],["食物","しょくもつ"],["に"],["飽き","あき"],["、"]]},{"verse":23,"text":"忌,いみきらわれた女,おんなが嫁,よめに行,いき、はしためが女,おんな主人,しゅじんのあとにすわることである。","tok":[["忌","いみ"],["きらわれた"],["女","おんな"],["が"],["嫁","よめ"],["に"],["行き","いき"],["、"],["はし"],["ため"],["が"],["女","おんな"],["主人","しゅじん"],["の"],["あと"],["に"],["すわる"],["こと"],["で"],["ある"],["。"]]},{"verse":24,"text":"この地上,ちじょうに、小,ちいさいけれども、非常,ひじょうに賢,かしこいものが四つある。","tok":[["この"],["地上","ちじょう"],["に"],["、"],["小さい","ちいさい"],["けれど"],["も"],["、"],["非常","ひじょう"],["に"],["賢しこい","かしこい"],["もの"],["が"],["四","よん"],["つ"],["ある"],["。"]]},{"verse":25,"text":"ありは力,ちからのない種類,しゅるいだが、その食糧,しょくりょうを夏,なつのうちに備,そなえる。","tok":[["あり"],["は"],["力","ちから"],["の"],["ない"],["種類","しゅるい"],["だ"],["が"],["、"],["その"],["食糧","しょくりょう"],["を"],["夏","なつ"],["の"],["うち"],["に"],["備","そなえ"],["る"],["。"]]},{"verse":26,"text":"岩,いわだぬきは強,つよくない種類,しゅるいだが、その家,いえを岩,いわにつくる。","tok":[["岩","いわ"],["だ"],["ぬき"],["は"],["強く","つよく"],["ない"],["種類","しゅるい"],["だ"],["が"],["、"],["その"],["家","いえ"],["を"],["岩","いわ"],["に"],["つくる"],["。"]]},{"verse":27,"text":"いなごは王,おうがないけれども、みな隊,たいを組,くんでいで立,たつ。","tok":[["いなご"],["は"],["王","おう"],["が"],["ない"],["けれど"],["も"],["、"],["みな隊","みなたい"],["を"],["組んで","くんで"],["いで立つ","いでたつ"],["。"]]},{"verse":28,"text":"やもりは手,てでつかまえられるが、王,おうの宮殿,きゅうでんにおる。","tok":[["やもり"],["は"],["手","て"],["で"],["つかまえられる"],["が"],["、"],["王","おう"],["の"],["宮殿","きゅうでん"],["に"],["おる"],["。"]]},{"verse":29,"text":"歩,あるきぶりの堂々,どうどうたる者,ものが三つある、いや、四つあって、みな堂々,どうどうと歩,あるく。","tok":[["歩き","あるき"],["ぶり"],["の"],["堂々","どうどう"],["たる"],["者","もの"],["が"],["三","みっ"],["つ"],["ある"],["、"],["いや"],["、"],["四","よん"],["つ"],["あって"],["、"],["みな"],["堂々","どうどう"],["と"],["歩く","あるく"],["。"]]},{"verse":30,"text":"すなわち獣,けもののうちでもっとも強,つよく、何,なにものの前,まえにも退,しりぞかない、しし、","tok":[["すなわち"],["獣","けもの"],["の"],["うち"],["で"],["もっとも"],["強く","つよく"],["、"],["何もの","なにもの"],["の"],["前","まえ"],["に"],["も"],["退ぞかない","しりぞかない"],["、"],["し"],["し"],["、"]]},{"verse":31,"text":"尾,おを立,たてて歩,あるくおんどり、雄,おやぎ、その民,たみの前,まえをいばって歩,あるく王,おうがそれである。","tok":[["尾","お"],["を"],["立てて","たてて"],["歩く","あるく"],["おんどり"],["、"],["雄","お"],["やぎ"],["、"],["その"],["民","たみ"],["の"],["前","まえ"],["を"],["いばって"],["歩く","あるく"],["王","おう"],["が"],["それ"],["で"],["ある"],["。"]]},{"verse":32,"text":"あなたがもし愚,おろかであって自,みずから高,たかぶり、あるいは悪事,あくじを計,はかったならば、あなたの手,てを口,くちに当,あてるがよい。","tok":[["あなた"],["が"],["もし"],["愚か","おろか"],["で"],["あって"],["自から","みずから"],["高か","たか"],["ぶり"],["、"],["あるいは"],["悪事","あくじ"],["を"],["計ったならば","はかったならば"],["、"],["あなた"],["の"],["手","て"],["を"],["口","くち"],["に"],["当てる","あてる"],["が"],["よい"],["。"]]},{"verse":33,"text":"乳,ちちをしめれば凝乳,ぎょうにゅうが出,でる、鼻,はなをしめれば血,ちがでる、怒,いかりをしめれば争,あらそいが起,おこる。","tok":[["乳","ちち"],["を"],["しめれば"],["凝乳","ぎょうにゅう"],["が"],["出る","でる"],["、"],["鼻","はな"],["を"],["しめれば"],["血","ち"],["が"],["でる"],["、"],["怒り","いかり"],["を"],["しめれば"],["争い","あらそい"],["が"],["起こる","おこる"],["。"]]}]
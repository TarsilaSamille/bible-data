[{"verse":1,"text":"だから、ああ、すべて人,ひとをさばく者,ものよ。あなたには弁解,べんかいの余地,よちがない。あなたは、他人,たにんをさばくことによって、自分,じぶん自身,じしんを罪,つみに定,さだめている。さばくあなたも、同,おなじことを行,おこなっているからである。","tok":[["だ"],["から"],["、"],["ああ"],["、"],["すべて"],["人","ひと"],["を"],["さばく"],["者","もの"],["よ"],["。"],["あなた"],["に"],["は"],["弁解","べんかい"],["の"],["余地","よち"],["が"],["ない"],["。"],["あなた"],["は"],["、"],["他人","たにん"],["を"],["さばく"],["こと"],["によって"],["、"],["自分","じぶん"],["自身","じしん"],["を"],["罪","つみ"],["に"],["定めて","さだめて"],["いる"],["。"],["さばく"],["あなた"],["も"],["、"],["同じ","おなじ"],["こと"],["を"],["行なって","おこなって"],["いる"],["から"],["で"],["ある"],["。"]]},{"verse":2,"text":"わたしたちは、神,かみのさばきが、このような事,ことを行,おこなう者,ものどもの上,うえに正,ただしく下,くだることを、知,しっている。","tok":[["わたしたち"],["は"],["、"],["神","かみ"],["の"],["さばき"],["が"],["、"],["この"],["よう"],["な"],["事","こと"],["を"],["行なう","おこなう"],["者","もの"],["ども"],["の"],["上","うえ"],["に"],["正く","ただしく"],["下る","くだる"],["こと"],["を"],["、"],["知って","しって"],["いる"],["。"]]},{"verse":3,"text":"ああ、このような事,ことを行,おこなう者,ものどもをさばきながら、しかも自,みずから同,おなじことを行,おこなう人,ひとよ。あなたは、神,かみのさばきをのがれうると思,おもうのか。","tok":[["ああ"],["、"],["この"],["よう"],["な"],["事","こと"],["を"],["行なう","おこなう"],["者","もの"],["ども"],["を"],["さばき"],["ながら"],["、"],["しかも"],["自から","みずから"],["同じ","おなじ"],["こと"],["を"],["行なう","おこなう"],["人","ひと"],["よ"],["。"],["あなた"],["は"],["、"],["神","かみ"],["の"],["さばき"],["を"],["のがれ"],["うる"],["と"],["思","おもう"],["の"],["か"],["。"]]},{"verse":4,"text":"それとも、神,かみの慈愛,じあいがあなたを悔改,くいあらために導,みちびくことも知,しらないで、その慈愛,じあいと忍耐,にんたいと寛容,かんようとの富,とみを軽,かろんじるのか。","tok":[["それ"],["と"],["も"],["、"],["神","かみ"],["の"],["慈愛","じあい"],["が"],["あなた"],["を"],["悔改め","くいあらため"],["に"],["導く","みちびく"],["こと"],["も"],["知らないで","しらないで"],["、"],["その"],["慈愛","じあい"],["と"],["忍耐","にんたい"],["と"],["寛容","かんよう"],["と"],["の"],["富","とみ"],["を"],["軽","かろんじる"],["の"],["か"],["。"]]},{"verse":5,"text":"あなたのかたくなな、悔改,くいあらためのない心,こころのゆえに、あなたは、神,かみの正,ただしいさばきの現,あらわれる怒,いかりの日,ひのために神,かみの怒,いかりを、自分,じぶんの身,みに積,つんでいるのである。","tok":[["あなた"],["の"],["かたくな"],["な"],["、"],["悔改め","くいあらため"],["の"],["ない"],["心","こころ"],["の"],["ゆえ"],["に"],["、"],["あなた"],["は"],["、"],["神","かみ"],["の"],["正い","ただしい"],["さばき"],["の"],["現われる","あらわれる"],["怒り","いかり"],["の"],["日","ひ"],["の"],["ため"],["に"],["神","かみ"],["の"],["怒り","いかり"],["を"],["、"],["自分","じぶん"],["の"],["身","み"],["に"],["積","つんでいる"],["ので"],["ある"],["。"]]},{"verse":6,"text":"神,かみは、おのおのに、そのわざにしたがって報,むくいられる。","tok":[["神","かみ"],["は"],["、"],["おのおの"],["に"],["、"],["その"],["わざ"],["に"],["したがって"],["報いられる","むくいられる"],["。"]]},{"verse":7,"text":"すなわち、一方,いっぽうでは、耐,たえ忍,しのんで善,ぜんを行,おこなって、光栄,こうえいとほまれと朽,くちぬものとを求,もとめる人,ひとに、永遠,えいえんのいのちが与,あたえられ、","tok":[["すなわち"],["、"],["一方","いっぽう"],["で"],["は"],["、"],["耐え忍んで","たえしのんで"],["善","ぜん"],["を"],["行なって","おこなって"],["、"],["光栄","こうえい"],["と"],["ほまれ"],["と"],["朽ちぬ","くちぬ"],["もの"],["と"],["を"],["求める","もとめる"],["人","ひと"],["に"],["、"],["永遠","えいえん"],["の"],["いのち"],["が"],["与えられ","あたえられ"],["、"]]},{"verse":8,"text":"他方,たほうでは、党派心,とうはしんをいだき、真理,しんりに従,したがわないで不義,ふぎに従,したがう人,ひとに、怒,いかりと激,はげしい憤,いきどおりとが加,くわえられる。","tok":[["他方","たほう"],["で"],["は"],["、"],["党派心","とうはしん"],["を"],["いだき"],["、"],["真理","しんり"],["に"],["従わないで","したがわないで"],["不義","ふぎ"],["に"],["従う","したがう"],["人","ひと"],["に"],["、"],["怒り","いかり"],["と"],["激しい","はげしい"],["憤り","いきどおり"],["と"],["が"],["加えられる","くわえられる"],["。"]]},{"verse":9,"text":"悪,あくを行,おこなうすべての人,ひとには、ユダヤ人,じんをはじめギリシヤ人,じんにも、患難,かんなんと苦悩,くのうとが与,あたえられ、","tok":[["悪","あく"],["を"],["行なう","おこなう"],["すべて"],["の"],["人","ひと"],["に"],["は"],["、"],["ユダヤ人","ゆだやじん"],["を"],["はじめ"],["ギリシヤ"],["人","じん"],["に"],["も"],["、"],["患難","かんなん"],["と"],["苦悩","くのう"],["と"],["が"],["与えられ","あたえられ"],["、"]]},{"verse":10,"text":"善,ぜんを行,おこなうすべての人,ひとには、ユダヤ人,じんをはじめギリシヤ人,じんにも、光栄,こうえいとほまれと平安,へいあんとが与,あたえられる。","tok":[["善","ぜん"],["を"],["行なう","おこなう"],["すべて"],["の"],["人","ひと"],["に"],["は"],["、"],["ユダヤ人","ゆだやじん"],["を"],["はじめ"],["ギリシヤ"],["人","じん"],["に"],["も"],["、"],["光栄","こうえい"],["と"],["ほまれ"],["と"],["平安","へいあん"],["と"],["が"],["与えられる","あたえられる"],["。"]]},{"verse":11,"text":"なぜなら、神,かみには、かたより見,みることがないからである。","tok":[["なぜ"],["なら"],["、"],["神","かみ"],["に"],["は"],["、"],["かた"],["より"],["見る","みる"],["こと"],["が"],["ない"],["から"],["で"],["ある"],["。"]]},{"verse":12,"text":"そのわけは、律法,りっぽうなしに罪,つみを犯,おかした者,ものは、また律法,りっぽうなしに滅,ほろび、律法,りっぽうのもとで罪,つみを犯,おかした者,ものは、律法,りっぽうによってさばかれる。","tok":[["その"],["わけ"],["は"],["、"],["律法","りっぽう"],["なし"],["に"],["罪","つみ"],["を"],["犯した","おかした"],["者","もの"],["は"],["、"],["また"],["律法","りっぽう"],["なし"],["に"],["滅び","ほろび"],["、"],["律法","りっぽう"],["の"],["もと"],["で"],["罪","つみ"],["を"],["犯した","おかした"],["者","もの"],["は"],["、"],["律法","りっぽう"],["によって"],["さばかれる"],["。"]]},{"verse":13,"text":"なぜなら、律法,りっぽうを聞,きく者,ものが、神,かみの前,まえに義,ぎなるものではなく、律法,りっぽうを行,おこなう者,ものが、義,ぎとされるからである。","tok":[["なぜ"],["なら"],["、"],["律法","りっぽう"],["を"],["聞く","きく"],["者","もの"],["が"],["、"],["神","かみ"],["の"],["前","まえ"],["に"],["義","ぎ"],["なる"],["もの"],["で"],["は"],["なく"],["、"],["律法","りっぽう"],["を"],["行なう","おこなう"],["者","もの"],["が"],["、"],["義","ぎ"],["と"],["される"],["から"],["で"],["ある"],["。"]]},{"verse":14,"text":"すなわち、律法,りっぽうを持,もたない異邦人,いほうじんが、自然,しぜんのままで、律法,りっぽうの命,めいじる事,ことを行,おこなうなら、たとい律法,りっぽうを持,もたなくても、彼,かれらにとっては自分,じぶん自身,じしんが律法,りっぽうなのである。","tok":[["すなわち"],["、"],["律法","りっぽう"],["を"],["持たない","もたない"],["異邦人","いほうじん"],["が"],["、"],["自然","しぜん"],["の"],["まま"],["で"],["、"],["律法","りっぽう"],["の"],["命じる","めいじる"],["事","こと"],["を"],["行なうなら","おこなうなら"],["、"],["たとい"],["律法","りっぽう"],["を"],["持たなくて","もたなくて"],["も"],["、"],["彼","かれ"],["ら"],["にとって"],["は"],["自分","じぶん"],["自身","じしん"],["が"],["律法","りっぽう"],["な"],["ので"],["ある"],["。"]]},{"verse":15,"text":"彼,かれらは律法,りっぽうの要求,ようきゅうがその心,こころにしるされていることを現,あらわし、そのことを彼,かれらの良心,りょうしんも共,ともにあかしをして、その判断,はんだんが互,たがいにあるいは訴,うったえ、あるいは弁明,べんめいし合,あうのである。","tok":[["彼","かれ"],["ら"],["は"],["律法","りっぽう"],["の"],["要求","ようきゅう"],["が"],["その"],["心","こころ"],["に"],["しるされて"],["いる"],["こと"],["を"],["現わし","あらわし"],["、"],["その"],["こと"],["を"],["彼","かれ"],["ら"],["の"],["良心","りょうしん"],["も"],["共","とも"],["に"],["あかし"],["を"],["して"],["、"],["その"],["判断","はんだん"],["が"],["互","たがい"],["に"],["あるいは"],["訴","うったえ"],["、"],["あるいは"],["弁明","べんめい"],["し"],["合う","あう"],["ので"],["ある"],["。"]]},{"verse":16,"text":"そして、これらのことは、わたしの福音,ふくいんによれば、神,かみがキリスト・イエスによって人々,ひとびとの隠,かくれた事,ことがらをさばかれるその日,ひに、明,あきらかにされるであろう。","tok":[["そして"],["、"],["これ"],["ら"],["の"],["こと"],["は"],["、"],["わたし"],["の"],["福音","ふくいん"],["に"],["よれば"],["、"],["神","かみ"],["が"],["キリスト"],["・"],["イエス"],["によって"],["人々","ひとびと"],["の"],["隠れた","かくれた"],["事がら","ことがら"],["を"],["さばかれる"],["その"],["日","ひ"],["に"],["、"],["明か","あきらか"],["に"],["されるで"],["あろう"],["。"]]},{"verse":17,"text":"もしあなたが、自,みずからユダヤ人,じんと称,しょうし、律法,りっぽうに安,やすんじ、神,かみを誇,ほこりとし、","tok":[["もし"],["あなた"],["が"],["、"],["自から","みずから"],["ユダヤ人","ゆだやじん"],["と"],["称し","しょうし"],["、"],["律法","りっぽう"],["に"],["安んじ","やすんじ"],["、"],["神","かみ"],["を"],["誇","ほこり"],["と"],["し"],["、"]]},{"verse":18,"text":"御旨,みむねを知,しり、律法,りっぽうに教,おしえられて、なすべきことをわきまえており、","tok":[["御旨","みむね"],["を"],["知り","しり"],["、"],["律法","りっぽう"],["に"],["教えられて","おしえられて"],["、"],["なすべき"],["こと"],["を"],["わきまえて"],["おり"],["、"]]},{"verse":19,"text":"[19-20]さらに、知識,ちしきと真理,しんりとが律法,りっぽうの中,なかに形,かたちをとっているとして、自,みずから盲人,もうじんの手引,てびき、やみにおる者,ものの光,ひかり、愚,おろかな者,ものの導,みちびき手,て、幼,おさな子,ごの教師,きょうしをもって任,にんじているのなら、","tok":[["["],["19"],["-"],["20"],["]"],["さらに"],["、"],["知識","ちしき"],["と"],["真理","しんり"],["と"],["が"],["律法","りっぽう"],["の"],["中","なか"],["に"],["形","かたち"],["を"],["とって"],["いる"],["として"],["、"],["自から","みずから"],["盲人","もうじん"],["の"],["手引","てびき"],["、"],["やみ"],["に"],["おる"],["者","もの"],["の"],["光","ひかり"],["、"],["愚か","おろか"],["な"],["者","もの"],["の"],["導き手","みちびきて"],["、"],["幼な子","おさなご"],["の"],["教師","きょうし"],["を"],["もって"],["任じて","にんじて"],["いる"],["の"],["なら"],["、"]]},{"verse":20,"text":"*[19-20]さらに、知識,ちしきと真理,しんりとが律法,りっぽうの中,なかに形,かたちをとっているとして、自,みずから盲人,もうじんの手引,てびき、やみにおる者,ものの光,ひかり、愚,おろかな者,ものの導,みちびき手,て、幼,おさな子,ごの教師,きょうしをもって任,にんじているのなら、","tok":[["*"],["["],["19"],["-"],["20"],["]"],["さらに"],["、"],["知識","ちしき"],["と"],["真理","しんり"],["と"],["が"],["律法","りっぽう"],["の"],["中","なか"],["に"],["形","かたち"],["を"],["とって"],["いる"],["として"],["、"],["自から","みずから"],["盲人","もうじん"],["の"],["手引","てびき"],["、"],["やみ"],["に"],["おる"],["者","もの"],["の"],["光","ひかり"],["、"],["愚か","おろか"],["な"],["者","もの"],["の"],["導き手","みちびきて"],["、"],["幼な子","おさなご"],["の"],["教師","きょうし"],["を"],["もって"],["任じて","にんじて"],["いる"],["の"],["なら"],["、"]]},{"verse":21,"text":"なぜ、人,ひとを教,おしえて自分,じぶんを教,おしえないのか。盗,ぬすむなと人,ひとに説,といて、自,みずからは盗,ぬすむのか。","tok":[["なぜ"],["、"],["人","ひと"],["を"],["教えて","おしえて"],["自分","じぶん"],["を"],["教えない","おしえない"],["の"],["か"],["。"],["盗む","ぬすむ"],["な"],["と"],["人","ひと"],["に"],["説いて","といて"],["、"],["自から","みずから"],["は"],["盗む","ぬすむ"],["の"],["か"],["。"]]},{"verse":22,"text":"姦淫,かんいんするなと言,いって、自,みずからは姦淫,かんいんするのか。偶像,ぐうぞうを忌,いみきらいながら、自,みずからは宮,みやの物,ものをかすめるのか。","tok":[["姦淫","かんいん"],["する"],["な"],["と"],["言って","いって"],["、"],["自から","みずから"],["は"],["姦淫","かんいん"],["する"],["の"],["か"],["。"],["偶像","ぐうぞう"],["を"],["忌","いみ"],["きらい"],["ながら"],["、"],["自から","みずから"],["は"],["宮","みや"],["の"],["物","もの"],["を"],["かすめる"],["の"],["か"],["。"]]},{"verse":23,"text":"律法,りっぽうを誇,ほこりとしながら、自,みずからは律法,りっぽうに違反,いはんして、神,かみを侮,あなどっているのか。","tok":[["律法","りっぽう"],["を"],["誇","ほこり"],["と"],["し"],["ながら"],["、"],["自から","みずから"],["は"],["律法","りっぽう"],["に"],["違反","いはん"],["して"],["、"],["神","かみ"],["を"],["侮って","あなどって"],["いる"],["の"],["か"],["。"]]},{"verse":24,"text":"聖書,せいしょに書,かいてあるとおり、「神,かみの御名,みなは、あなたがたのゆえに、異邦人,いほうじんの間,あいだで汚,けがされている」。","tok":[["聖書","せいしょ"],["に"],["書いて","かいて"],["ある"],["と"],["おり"],["、"],["「"],["神","かみ"],["の"],["御名","みな"],["は"],["、"],["あなた"],["がた"],["の"],["ゆえ"],["に"],["、"],["異邦人","いほうじん"],["の"],["間","あいだ"],["で"],["汚","け"],["が"],["されて"],["いる"],["」"],["。"]]},{"verse":25,"text":"もし、あなたが律法,りっぽうを行,おこなうなら、なるほど、割礼,かつれいは役,やくに立,たとう。しかし、もし律法,りっぽうを犯,おかすなら、あなたの割礼,かつれいは無,む割礼,かつれいとなってしまう。","tok":[["もし"],["、"],["あなた"],["が"],["律法","りっぽう"],["を"],["行なうなら","おこなうなら"],["、"],["なるほど"],["、"],["割礼","かつれい"],["は"],["役","やく"],["に"],["立とう","たとう"],["。"],["しかし"],["、"],["もし"],["律法","りっぽう"],["を"],["犯すなら","おかすなら"],["、"],["あなた"],["の"],["割礼","かつれい"],["は"],["無","む"],["割礼","かつれい"],["と"],["なって"],["しまう"],["。"]]},{"verse":26,"text":"だから、もし無,む割礼,かつれいの者,ものが律法,りっぽうの規定,きていを守,まもるなら、その無,む割礼,かつれいは割礼,かつれいと見,みなされるではないか。","tok":[["だ"],["から"],["、"],["もし"],["無","む"],["割礼","かつれい"],["の"],["者","もの"],["が"],["律法","りっぽう"],["の"],["規定","きてい"],["を"],["守","まもる"],["なら"],["、"],["その"],["無","む"],["割礼","かつれい"],["は"],["割礼","かつれい"],["と"],["見なされるで","みなされるで"],["は"],["ない"],["か"],["。"]]},{"verse":27,"text":"かつ、生,うまれながら無,む割礼,かつれいの者,ものであって律法,りっぽうを全,まっとうする者,ものは、律法,りっぽうの文字,もんじと割礼,かつれいとを持,もちながら律法,りっぽうを犯,おかしているあなたを、さばくのである。","tok":[["かつ"],["、"],["生まれ","うまれ"],["ながら"],["無","む"],["割礼","かつれい"],["の"],["者","もの"],["で"],["あって"],["律法","りっぽう"],["を"],["全う","まっとう"],["する"],["者","もの"],["は"],["、"],["律法","りっぽう"],["の"],["文字","もんじ"],["と"],["割礼","かつれい"],["と"],["を"],["持ち","もち"],["ながら"],["律法","りっぽう"],["を"],["犯して","おかして"],["いる"],["あなた"],["を"],["、"],["さばく"],["ので"],["ある"],["。"]]},{"verse":28,"text":"というのは、外見,がいけん上,うえのユダヤ人,じんがユダヤ人,じんではなく、また、外見,がいけん上,うえの肉,にくにおける割礼,かつれいが割礼,かつれいでもない。","tok":[["と"],["いう"],["の"],["は"],["、"],["外見上","がいけんうえ"],["の"],["ユダヤ人","ゆだやじん"],["が"],["ユダヤ人","ゆだやじん"],["で"],["は"],["なく"],["、"],["また"],["、"],["外見上","がいけんうえ"],["の"],["肉","にく"],["に"],["おける"],["割礼","かつれい"],["が"],["割礼","かつれい"],["で"],["も"],["ない"],["。"]]},{"verse":29,"text":"かえって、隠,かくれたユダヤ人,じんがユダヤ人,じんであり、また、文字,もんじによらず霊,れいによる心,こころの割礼,かつれいこそ割礼,かつれいであって、そのほまれは人,ひとからではなく、神,かみから来,くるのである。","tok":[["かえって"],["、"],["隠れた","かくれた"],["ユダヤ人","ゆだやじん"],["が"],["ユダヤ人","ゆだやじん"],["で"],["あり"],["、"],["また"],["、"],["文字","もんじ"],["に"],["よらず"],["霊","れい"],["に"],["よる"],["心","こころ"],["の"],["割礼","かつれい"],["こそ"],["割礼","かつれい"],["で"],["あって"],["、"],["その"],["ほまれ"],["は"],["人","ひと"],["から"],["で"],["は"],["なく"],["、"],["神","かみ"],["から"],["来る","くる"],["ので"],["ある"],["。"]]}]
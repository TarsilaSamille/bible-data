[{"verse":1,"text":"キリスト・イエスの僕,しもべ、神,かみの福音,ふくいんのために選,えらび別,わかたれ、召,めされて使徒,しととなったパウロから――","tok":[["キリスト"],["・"],["イエス"],["の"],["僕","し"],["も"],["べ"],["、"],["神","かみ"],["の"],["福音","ふくいん"],["の"],["ため"],["に"],["選ら","えら"],["び"],["別たれ","わかたれ"],["、"],["召されて","めされて"],["使徒","しと"],["と"],["なった"],["パウロ"],["から"],["―"],["―"]]},{"verse":2,"text":"この福音,ふくいんは、神,かみが、預言者,よげんしゃたちにより、聖書,せいしょの中,なかで、あらかじめ約束,やくそくされたものであって、","tok":[["この"],["福音","ふくいん"],["は"],["、"],["神","かみ"],["が"],["、"],["預言者","よげんしゃ"],["たち"],["に"],["より"],["、"],["聖書","せいしょ"],["の"],["中","なか"],["で"],["、"],["あらかじめ"],["約束","やくそく"],["された"],["もの"],["で"],["あって"],["、"]]},{"verse":3,"text":"御子,みこに関,かんするものである。御子,みこは、肉,にくによればダビデの子孫,しそんから生,うまれ、","tok":[["御子","みこ"],["に"],["関する","かんする"],["もの"],["で"],["ある"],["。"],["御子","みこ"],["は"],["、"],["肉","にく"],["に"],["よれば"],["ダビデ"],["の"],["子孫","しそん"],["から"],["生まれ","うまれ"],["、"]]},{"verse":4,"text":"聖,せいなる霊,れいによれば、死人,しにんからの復活,ふっかつにより、御,み力,ちからをもって神,かみの御子,みこと定,さだめられた。これがわたしたちの主,しゅイエス・キリストである。","tok":[["聖","せい"],["なる"],["霊","れい"],["に"],["よれば"],["、"],["死人","しにん"],["から"],["の"],["復活","ふっかつ"],["に"],["より"],["、"],["御力","みちから"],["を"],["もって"],["神","かみ"],["の"],["御子","みこ"],["と"],["定められた","さだめられた"],["。"],["これ"],["が"],["わたしたち"],["の"],["主","しゅ"],["イエス"],["・"],["キリスト"],["で"],["ある"],["。"]]},{"verse":5,"text":"わたしたちは、その御名,みなのために、すべての異邦人,いほうじんを信仰,しんこうの従順,じゅうじゅんに至,いたらせるようにと、彼,かれによって恵,めぐみと使徒,しとの務,つとめとを受,うけたのであり、","tok":[["わたしたち"],["は"],["、"],["その"],["御名","みな"],["の"],["ため"],["に"],["、"],["すべて"],["の"],["異邦人","いほうじん"],["を"],["信仰","しんこう"],["の"],["従順","じゅうじゅん"],["に"],["至らせる","いたらせる"],["よう"],["に"],["と"],["、"],["彼","かれ"],["によって"],["恵","めぐみ"],["と"],["使徒","しと"],["の"],["務め","つとめ"],["と"],["を"],["受た","うけた"],["ので"],["あり"],["、"]]},{"verse":6,"text":"あなたがたもまた、彼,かれらの中,なかにあって、召,めされてイエス・キリストに属,ぞくする者,ものとなったのである――","tok":[["あなた"],["がた"],["も"],["また"],["、"],["彼","かれ"],["ら"],["の"],["中","なか"],["に"],["あって"],["、"],["召されて","めされて"],["イエス"],["・"],["キリスト"],["に"],["属する","ぞくする"],["者","もの"],["と"],["なった"],["ので"],["ある"],["―"],["―"]]},{"verse":7,"text":"ローマにいる、神,かみに愛,あいされ、召,めされた聖徒,せいと一同,いちどうへ。わたしたちの父,ちちなる神,かみおよび主,しゅイエス・キリストから、恵,めぐみと平安,へいあんとが、あなたがたにあるように。","tok":[["ローマ"],["に"],["いる"],["、"],["神","かみ"],["に"],["愛され","あいされ"],["、"],["召された","めされた"],["聖徒","せいと"],["一同","いちどう"],["へ"],["。"],["わたしたち"],["の"],["父","ちち"],["なる"],["神","かみ"],["および"],["主","しゅ"],["イエス"],["・"],["キリスト"],["から"],["、"],["恵","めぐみ"],["と"],["平安","へいあん"],["と"],["が"],["、"],["あなた"],["がた"],["に"],["ある"],["よう"],["に"],["。"]]},{"verse":8,"text":"まず第,だい一に、わたしは、あなたがたの信仰,しんこうが全,ぜん世界,せかいに言,いい伝,つたえられていることを、イエス・キリストによって、あなたがた一同,いちどうのために、わたしの神,かみに感謝,かんしゃする。","tok":[["まず"],["第","だい"],["一","いち"],["に"],["、"],["わたし"],["は"],["、"],["あなた"],["がた"],["の"],["信仰","しんこう"],["が"],["全","ぜん"],["世界","せかい"],["に"],["言い伝えられて","いいつたえられて"],["いる"],["こと"],["を"],["、"],["イエス"],["・"],["キリスト"],["によって"],["、"],["あなた"],["がた"],["一同","いちどう"],["の"],["ため"],["に"],["、"],["わたし"],["の"],["神","かみ"],["に"],["感謝","かんしゃ"],["する"],["。"]]},{"verse":9,"text":"[9-10]わたしは、祈,いのりのたびごとに、絶,たえずあなたがたを覚,おぼえ、いつかは御旨,みむねにかなって道,みちが開,ひらかれ、どうにかして、あなたがたの所,ところに行,いけるようにと願,ねがっている。このことについて、わたしのためにあかしをして下,くださるのは、わたしが霊,れいにより、御子,みこの福音,ふくいんを宣,のべ伝,つたえて仕,つかえている神,かみである。","tok":[["["],["9"],["-"],["10"],["]"],["わたし"],["は"],["、"],["祈","いのり"],["の"],["たび"],["ごと"],["に"],["、"],["絶えず","たえず"],["あなた"],["がた"],["を"],["覚え","おぼえ"],["、"],["いつ"],["か"],["は"],["御旨","みむね"],["に"],["かなって"],["道","みち"],["が"],["開らかれ","ひらかれ"],["、"],["どう"],["に"],["か"],["して"],["、"],["あなた"],["がた"],["の"],["所","ところ"],["に"],["行ける","いける"],["よう"],["に"],["と"],["願って","ねがって"],["いる"],["。"],["この"],["こと"],["について"],["、"],["わたし"],["の"],["ため"],["に"],["あかし"],["を"],["して"],["下さる","くださる"],["の"],["は"],["、"],["わたし"],["が"],["霊","れい"],["に"],["より"],["、"],["御子","みこ"],["の"],["福音","ふくいん"],["を"],["宣べ伝えて","のべつたえて"],["仕えて","つかえて"],["いる"],["神","かみ"],["で"],["ある"],["。"]]},{"verse":10,"text":"[9-10]わたしは、祈,いのりのたびごとに、絶,たえずあなたがたを覚,おぼえ、いつかは御旨,みむねにかなって道,みちが開,ひらかれ、どうにかして、あなたがたの所,ところに行,いけるようにと願,ねがっている。このことについて、わたしのためにあかしをして下,くださるのは、わたしが霊,れいにより、御子,みこの福音,ふくいんを宣,のべ伝,つたえて仕,つかえている神,かみである。","tok":[["["],["9"],["-"],["10"],["]"],["わたし"],["は"],["、"],["祈","いのり"],["の"],["たび"],["ごと"],["に"],["、"],["絶えず","たえず"],["あなた"],["がた"],["を"],["覚え","おぼえ"],["、"],["いつ"],["か"],["は"],["御旨","みむね"],["に"],["かなって"],["道","みち"],["が"],["開らかれ","ひらかれ"],["、"],["どう"],["に"],["か"],["して"],["、"],["あなた"],["がた"],["の"],["所","ところ"],["に"],["行ける","いける"],["よう"],["に"],["と"],["願って","ねがって"],["いる"],["。"],["この"],["こと"],["について"],["、"],["わたし"],["の"],["ため"],["に"],["あかし"],["を"],["して"],["下さる","くださる"],["の"],["は"],["、"],["わたし"],["が"],["霊","れい"],["に"],["より"],["、"],["御子","みこ"],["の"],["福音","ふくいん"],["を"],["宣べ伝えて","のべつたえて"],["仕えて","つかえて"],["いる"],["神","かみ"],["で"],["ある"],["。"]]},{"verse":11,"text":"わたしは、あなたがたに会,あうことを熱望,ねつぼうしている。あなたがたに霊,れいの賜物,たまものを幾分,いくぶんでも分,わけ与,あたえて、力,ちからづけたいからである。","tok":[["わたし"],["は"],["、"],["あなた"],["がた"],["に"],["会う","あう"],["こと"],["を"],["熱望","ねつぼう"],["して"],["いる"],["。"],["あなた"],["がた"],["に"],["霊","れい"],["の"],["賜物","たまもの"],["を"],["幾分","いくぶん"],["で"],["も"],["分け","わけ"],["与","あたえ"],["て"],["、"],["力づけたい","ちからづけたい"],["から"],["で"],["ある"],["。"]]},{"verse":12,"text":"それは、あなたがたの中,なかにいて、あなたがたとわたしとのお互,たがいの信仰,しんこうによって、共,ともに励,はげまし合,あうためにほかならない。","tok":[["それ"],["は"],["、"],["あなた"],["がた"],["の"],["中","なか"],["に"],["いて"],["、"],["あなた"],["がた"],["と"],["わたし"],["と"],["の"],["お互","おたがい"],["の"],["信仰","しんこう"],["によって"],["、"],["共","とも"],["に"],["励まし合う","はげましあう"],["ため"],["に"],["ほか"],["ならない"],["。"]]},{"verse":13,"text":"兄弟,きょうだいたちよ。このことを知,しらずにいてもらいたくない。わたしはほかの異邦人,いほうじんの間,あいだで得,えたように、あなたがたの間,あいだでも幾分,いくぶんかの実,みを得,えるために、あなたがたの所,ところに行,いこうとしばしば企,くわだてたが、今,いままで妨,さまたげられてきた。","tok":[["兄弟","きょうだい"],["たち"],["よ"],["。"],["この"],["こと"],["を"],["知らず","しらず"],["に"],["いて"],["もらいたく"],["ない"],["。"],["わたし"],["は"],["ほか"],["の"],["異邦人","いほうじん"],["の"],["間","あいだ"],["で"],["得た","えた"],["よう"],["に"],["、"],["あなた"],["がた"],["の"],["間","あいだ"],["で"],["も"],["幾分","いくぶん"],["か"],["の"],["実","み"],["を"],["得る","える"],["ため"],["に"],["、"],["あなた"],["がた"],["の"],["所","ところ"],["に"],["行こう","いこう"],["と"],["しばしば"],["企だてた","くわだてた"],["が"],["、"],["今まで","いままで"],["妨げられて","さまたげられて"],["きた"],["。"]]},{"verse":14,"text":"わたしには、ギリシヤ人,じんにも未開,みかいの人,ひとにも、賢,かしこい者,ものにも無知,むちな者,ものにも、果,はたすべき責任,せきにんがある。","tok":[["わたし"],["に"],["は"],["、"],["ギリシヤ"],["人","じん"],["に"],["も"],["未開","みかい"],["の"],["人","ひと"],["に"],["も"],["、"],["賢しこい","かしこい"],["者","もの"],["に"],["も"],["無知","むち"],["な"],["者","もの"],["に"],["も"],["、"],["果たすべき","はたすべき"],["責任","せきにん"],["が"],["ある"],["。"]]},{"verse":15,"text":"そこで、わたしとしての切,せつなる願,ねがいは、ローマにいるあなたがたにも、福音,ふくいんを宣,のべ伝,つたえることなのである。","tok":[["そこ"],["で"],["、"],["わたし"],["として"],["の"],["切","せつ"],["なる"],["願い","ねがい"],["は"],["、"],["ローマ"],["に"],["いる"],["あなた"],["がた"],["に"],["も"],["、"],["福音","ふくいん"],["を"],["宣べ伝える","のべつたえる"],["こと"],["な"],["ので"],["ある"],["。"]]},{"verse":16,"text":"わたしは福音,ふくいんを恥,はじとしない。それは、ユダヤ人,じんをはじめ、ギリシヤ人,じんにも、すべて信,しんじる者,ものに、救,すくいを得,えさせる神,かみの力,ちからである。","tok":[["わたし"],["は"],["福音","ふくいん"],["を"],["恥","はじ"],["と"],["しない"],["。"],["それ"],["は"],["、"],["ユダヤ人","ゆだやじん"],["を"],["はじめ"],["、"],["ギリシヤ"],["人","じん"],["に"],["も"],["、"],["すべて"],["信じる","しんじる"],["者","もの"],["に"],["、"],["救い","すくい"],["を"],["得させる","えさせる"],["神","かみ"],["の"],["力","ちから"],["で"],["ある"],["。"]]},{"verse":17,"text":"神,かみの義,ぎは、その福音,ふくいんの中,なかに啓示,けいじされ、信仰,しんこうに始,はじまり信仰,しんこうに至,いたらせる。これは、「信仰,しんこうによる義人,ぎじんは生,いきる」と書,かいてあるとおりである。","tok":[["神","かみ"],["の"],["義","ぎ"],["は"],["、"],["その"],["福音","ふくいん"],["の"],["中","なか"],["に"],["啓示","けいじ"],["され"],["、"],["信仰","しんこう"],["に"],["始まり","はじまり"],["信仰","しんこう"],["に"],["至らせる","いたらせる"],["。"],["これ"],["は"],["、"],["「"],["信仰","しんこう"],["に"],["よる"],["義人","ぎじん"],["は"],["生きる","いきる"],["」"],["と"],["書いて","かいて"],["ある"],["とおり"],["で"],["ある"],["。"]]},{"verse":18,"text":"神,かみの怒,いかりは、不義,ふぎをもって真理,しんりをはばもうとする人間,にんげんのあらゆる不信心,ふしんじんと不義,ふぎとに対,たいして、天,てんから啓示,けいじされる。","tok":[["神","かみ"],["の"],["怒り","いかり"],["は"],["、"],["不義","ふぎ"],["を"],["もって"],["真理","しんり"],["を"],["はばもう"],["と"],["する"],["人間","にんげん"],["の"],["あらゆる"],["不信心","ふしんじん"],["と"],["不義","ふぎ"],["と"],["に対して","にたいして"],["、"],["天","てん"],["から"],["啓示","けいじ"],["される"],["。"]]},{"verse":19,"text":"なぜなら、神,かみについて知,しりうる事,ことがらは、彼,かれらには明,あきらかであり、神,かみがそれを彼,かれらに明,あきらかにされたのである。","tok":[["なぜ"],["なら"],["、"],["神","かみ"],["について"],["知り","しり"],["うる"],["事がら","ことがら"],["は"],["、"],["彼","かれ"],["ら"],["に"],["は"],["明か","あきらか"],["で"],["あり"],["、"],["神","かみ"],["が"],["それ"],["を"],["彼","かれ"],["ら"],["に"],["明か","あきらか"],["に"],["された"],["ので"],["ある"],["。"]]},{"verse":20,"text":"神,かみの見,みえない性質,せいしつ、すなわち、神,かみの永遠,えいえんの力,ちからと神性,しんせいとは、天地,てんち創造,そうぞうこのかた、被,ひ造物,ぞうぶつにおいて知,しられていて、明,あきらかに認,みとめられるからである。したがって、彼,かれらには弁解,べんかいの余地,よちがない。","tok":[["神","かみ"],["の"],["見えない","みえない"],["性質","せいしつ"],["、"],["すなわち"],["、"],["神","かみ"],["の"],["永遠","えいえん"],["の"],["力","ちから"],["と"],["神性","しんせい"],["と"],["は"],["、"],["天地","てんち"],["創造","そうぞう"],["このかた"],["、"],["被","ひ"],["造物","ぞうぶつ"],["に"],["おいて"],["知られて","しられて"],["いて"],["、"],["明か","あきらか"],["に"],["認められる","みとめられる"],["から"],["で"],["ある"],["。"],["したがって"],["、"],["彼","かれ"],["ら"],["に"],["は"],["弁解","べんかい"],["の"],["余地","よち"],["が"],["ない"],["。"]]},{"verse":21,"text":"なぜなら、彼,かれらは神,かみを知,しっていながら、神,かみとしてあがめず、感謝,かんしゃもせず、かえってその思,おもいはむなしくなり、その無知,むちな心,こころは暗,くらくなったからである。","tok":[["なぜ"],["なら"],["、"],["彼","かれ"],["ら"],["は"],["神","かみ"],["を"],["知って","しって"],["い"],["ながら"],["、"],["神","かみ"],["として"],["あがめず"],["、"],["感謝","かんしゃ"],["も"],["せず"],["、"],["かえって"],["その"],["思い","おもい"],["は"],["むなしく"],["なり"],["、"],["その"],["無知","むち"],["な"],["心","こころ"],["は"],["暗く","くらく"],["なった"],["から"],["で"],["ある"],["。"]]},{"verse":22,"text":"彼,かれらは自,みずから知者,ちしゃと称,しょうしながら、愚,おろかになり、","tok":[["彼","かれ"],["ら"],["は"],["自から","みずから"],["知者","ちしゃ"],["と"],["称し","しょうし"],["ながら"],["、"],["愚か","おろか"],["に"],["なり"],["、"]]},{"verse":23,"text":"不朽,ふきゅうの神,かみの栄光,えいこうを変,かえて、朽,くちる人間,にんげんや鳥,とりや獣,けものや這,はうものの像,ぞうに似,にせたのである。","tok":[["不朽","ふきゅう"],["の"],["神","かみ"],["の"],["栄光","えいこう"],["を"],["変えて","かえて"],["、"],["朽ちる","くちる"],["人間","にんげん"],["や"],["鳥","とり"],["や"],["獣","けもの"],["や"],["這う","はう"],["もの"],["の"],["像","ぞう"],["に"],["似せた","にせた"],["ので"],["ある"],["。"]]},{"verse":24,"text":"ゆえに、神,かみは、彼,かれらが心,こころの欲情,よくじょうにかられ、自分,じぶんのからだを互,たがいにはずかしめて、汚,けがすままに任,まかせられた。","tok":[["ゆえ"],["に"],["、"],["神","かみ"],["は"],["、"],["彼","かれ"],["ら"],["が"],["心","こころ"],["の"],["欲情","よくじょう"],["に"],["かられ"],["、"],["自分","じぶん"],["の"],["からだ"],["を"],["互","たがい"],["に"],["はずかしめて"],["、"],["汚す","けがす"],["まま"],["に"],["任せられた","まかせられた"],["。"]]},{"verse":25,"text":"彼,かれらは神,かみの真理,しんりを変,かえて虚偽,きょぎとし、創造者,そうぞうしゃの代,かわりに被,ひ造物,ぞうぶつを拝,おがみ、これに仕,つかえたのである。創造者,そうぞうしゃこそ永遠,えいえんにほむべきものである、アァメン。","tok":[["彼","かれ"],["ら"],["は"],["神","かみ"],["の"],["真理","しんり"],["を"],["変えて","かえて"],["虚偽","きょぎ"],["と"],["し"],["、"],["創造者","そうぞうしゃ"],["の"],["代わり","かわり"],["に"],["被","ひ"],["造物","ぞうぶつ"],["を"],["拝み","おがみ"],["、"],["これ"],["に"],["仕えた","つかえた"],["ので"],["ある"],["。"],["創造者","そうぞうしゃ"],["こそ"],["永遠","えいえん"],["に"],["ほ"],["むべき"],["もの"],["で"],["ある"],["、"],["アァメン"],["。"]]},{"verse":26,"text":"それゆえ、神,かみは彼,かれらを恥,はずべき情欲,じょうよくに任,まかせられた。すなわち、彼,かれらの中,なかの女,おんなは、その自然,しぜんの関係,かんけいを不自然,ふしぜんなものに代,かえ、","tok":[["それ"],["ゆえ"],["、"],["神","かみ"],["は"],["彼","かれ"],["ら"],["を"],["恥ずべき","はずべき"],["情欲","じょうよく"],["に"],["任せられた","まかせられた"],["。"],["すなわち"],["、"],["彼","かれ"],["ら"],["の"],["中","なか"],["の"],["女","おんな"],["は"],["、"],["その"],["自然","しぜん"],["の"],["関係","かんけい"],["を"],["不自然","ふしぜん"],["な"],["もの"],["に"],["代え","かえ"],["、"]]},{"verse":27,"text":"男,おとこもまた同,おなじように女,おんなとの自然,しぜんの関係,かんけいを捨,すてて、互,たがいにその情欲,じょうよくの炎,ほのおを燃,もやし、男,おとこは男,おとこに対,たいして恥,はずべきことをなし、そしてその乱行,らんぎょうの当然,とうぜんの報,むくいを、身,みに受,うけたのである。","tok":[["男","おとこ"],["も"],["また"],["同じ","おなじ"],["よう"],["に"],["女","おんな"],["と"],["の"],["自然","しぜん"],["の"],["関係","かんけい"],["を"],["捨てて","すてて"],["、"],["互","たがい"],["に"],["その"],["情欲","じょうよく"],["の"],["炎","ほのお"],["を"],["燃やし","もやし"],["、"],["男","おとこ"],["は"],["男","おとこ"],["に対して","にたいして"],["恥ずべき","はずべき"],["こと"],["を"],["なし"],["、"],["そして"],["その"],["乱行","らんぎょう"],["の"],["当然","とうぜん"],["の"],["報い","むくい"],["を"],["、"],["身","み"],["に"],["受た","うけた"],["ので"],["ある"],["。"]]},{"verse":28,"text":"そして、彼,かれらは神,かみを認,みとめることを正,ただしいとしなかったので、神,かみは彼,かれらを正,ただしからぬ思,おもいにわたし、なすべからざる事,ことをなすに任,まかせられた。","tok":[["そして"],["、"],["彼","かれ"],["ら"],["は"],["神","かみ"],["を"],["認める","みとめる"],["こと"],["を"],["正い","ただしい"],["と"],["しなかった"],["ので"],["、"],["神","かみ"],["は"],["彼","かれ"],["ら"],["を"],["正","ただし"],["から"],["ぬ"],["思い","おもい"],["に"],["わたし"],["、"],["なすべからざる"],["事","こと"],["を"],["なす"],["に"],["任せられた","まかせられた"],["。"]]},{"verse":29,"text":"すなわち、彼,かれらは、あらゆる不義,ふぎと悪,あくと貪欲,どんよくと悪意,あくいとにあふれ、ねたみと殺意,さついと争,あらそいと詐欺,さぎと悪念,あくねんとに満,みち、また、ざん言,げんする者,もの、","tok":[["すなわち"],["、"],["彼","かれ"],["ら"],["は"],["、"],["あらゆる"],["不義","ふぎ"],["と"],["悪","あく"],["と"],["貪欲","どんよく"],["と"],["悪意","あくい"],["と"],["に"],["あふれ"],["、"],["ねたみ"],["と"],["殺意","さつい"],["と"],["争い","あらそい"],["と"],["詐欺","さぎ"],["と"],["悪念","あくねん"],["と"],["に"],["満ち","みち"],["、"],["また"],["、"],["ざん言","ざんげん"],["する"],["者","もの"],["、"]]},{"verse":30,"text":"そしる者,もの、神,かみを憎,にくむ者,もの、不遜,ふそんな者,もの、高慢,こうまんな者,もの、大言壮語,たいげんそうごする者,もの、悪事,あくじをたくらむ者,もの、親,おやに逆,さからう者,ものとなり、","tok":[["そしる"],["者","もの"],["、"],["神","かみ"],["を"],["憎む","にくむ"],["者","もの"],["、"],["不遜","ふそん"],["な"],["者","もの"],["、"],["高慢","こうまん"],["な"],["者","もの"],["、"],["大言","たいげん"],["壮語","そうご"],["する"],["者","もの"],["、"],["悪事","あくじ"],["を"],["たくらむ"],["者","もの"],["、"],["親","おや"],["に"],["逆らう","さからう"],["者","もの"],["と"],["なり"],["、"]]},{"verse":31,"text":"無知,むち、不誠実,ふせいじつ、無情,むじょう、無慈悲,むじひな者,ものとなっている。","tok":[["無知","むち"],["、"],["不誠実","ふせいじつ"],["、"],["無情","むじょう"],["、"],["無慈悲","むじひ"],["な"],["者","もの"],["と"],["なって"],["いる"],["。"]]},{"verse":32,"text":"彼,かれらは、こうした事,ことを行,おこなう者,ものどもが死,しに価,あたいするという神,かみの定,さだめをよく知,しりながら、自,みずからそれを行,おこなうばかりではなく、それを行,おこなう者,ものどもを是認,ぜにんさえしている。","tok":[["彼","かれ"],["ら"],["は"],["、"],["こう"],["した"],["事","こと"],["を"],["行なう","おこなう"],["者","もの"],["ども"],["が"],["死に","しに"],["価","あたい"],["する"],["と"],["いう"],["神","かみ"],["の"],["定め","さだめ"],["を"],["よく"],["知り","しり"],["ながら"],["、"],["自から","みずから"],["それ"],["を"],["行なう","おこなう"],["ばかり"],["で"],["は"],["なく"],["、"],["それ"],["を"],["行なう","おこなう"],["者","もの"],["ども"],["を"],["是認","ぜにん"],["さえ"],["して"],["いる"],["。"]]}]
[{"verse":1,"text":"わたしはキリストにあって真実,しんじつを語,かたる。偽,いつわりは言,いわない。わたしの良心,りょうしんも聖霊,せいれいによって、わたしにこうあかしをしている。","tok":[["わたし"],["は"],["キリスト"],["に"],["あって"],["真実","しんじつ"],["を"],["語る","かたる"],["。"],["偽わり","いつわり"],["は"],["言わない","いわない"],["。"],["わたし"],["の"],["良心","りょうしん"],["も"],["聖霊","せいれい"],["によって"],["、"],["わたし"],["に"],["こう"],["あかし"],["を"],["して"],["いる"],["。"]]},{"verse":2,"text":"すなわち、わたしに大,おおきな悲,かなしみがあり、わたしの心,こころに絶,たえざる痛,いたみがある。","tok":[["すなわち"],["、"],["わたし"],["に"],["大きな","おおきな"],["悲しみ","かなしみ"],["が"],["あり"],["、"],["わたし"],["の"],["心","こころ"],["に"],["絶えざる","たえざる"],["痛み","いたみ"],["が"],["ある"],["。"]]},{"verse":3,"text":"実際,じっさい、わたしの兄弟,きょうだい、肉,にくによる同族,どうぞくのためなら、わたしのこの身,みがのろわれて、キリストから離,はなされてもいとわない。","tok":[["実際","じっさい"],["、"],["わたし"],["の"],["兄弟","きょうだい"],["、"],["肉","にく"],["に"],["よる"],["同族","どうぞく"],["の"],["ため"],["なら"],["、"],["わたし"],["の"],["この"],["身","み"],["が"],["のろわれて"],["、"],["キリスト"],["から"],["離されて","はなされて"],["も"],["いとわない"],["。"]]},{"verse":4,"text":"彼,かれらはイスラエル人,びとであって、子,こたる身分,みぶんを授,さづけられることも、栄光,えいこうも、もろもろの契約,けいやくも、律法,りっぽうを授,さづけられることも、礼拝,れいはいも、数々,かずかずの約束,やくそくも彼,かれらのもの、","tok":[["彼","かれ"],["ら"],["は"],["イスラエル"],["人","び"],["と"],["であって"],["、"],["子","こ"],["たる"],["身分","みぶん"],["を"],["授","さ"],["づけられる"],["こと"],["も"],["、"],["栄光","えいこう"],["も"],["、"],["もろもろ"],["の"],["契約","けいやく"],["も"],["、"],["律法","りっぽう"],["を"],["授","さ"],["づけられる"],["こと"],["も"],["、"],["礼拝","れいはい"],["も"],["、"],["数々","かずかず"],["の"],["約束","やくそく"],["も"],["彼","かれ"],["ら"],["の"],["もの"],["、"]]},{"verse":5,"text":"また父祖,ふそたちも彼,かれらのものであり、肉,にくによればキリストもまた彼,かれらから出,でられたのである。万物,ばんぶつの上,うえにいます神,かみは、永遠,えいえんにほむべきかな、アァメン。","tok":[["また"],["父祖","ふそ"],["たち"],["も"],["彼","かれ"],["ら"],["の"],["もの"],["で"],["あり"],["、"],["肉","にく"],["に"],["よれば"],["キリスト"],["も"],["また"],["彼","かれ"],["ら"],["から"],["出られた","でられた"],["ので"],["ある"],["。"],["万物","ばんぶつ"],["の"],["上","うえ"],["に"],["います"],["神","かみ"],["は"],["、"],["永遠","えいえん"],["に"],["ほ"],["むべき"],["か"],["な"],["、"],["アァメン"],["。"]]},{"verse":6,"text":"しかし、神,かみの言,ことばが無効,むこうになったというわけではない。なぜなら、イスラエルから出,でた者,ものが全部,ぜんぶイスラエルなのではなく、","tok":[["しかし"],["、"],["神","かみ"],["の"],["言","こ"],["と"],["ば"],["が"],["無効","むこう"],["に"],["なった"],["と"],["いう"],["わけ"],["で"],["は"],["ない"],["。"],["なぜ"],["なら"],["、"],["イスラエル"],["から"],["出た","でた"],["者","もの"],["が"],["全部","ぜんぶ"],["イスラエル"],["な"],["ので"],["は"],["なく"],["、"]]},{"verse":7,"text":"また、アブラハムの子孫,しそんだからといって、その全部,ぜんぶが子,こであるのではないからである。かえって「イサクから出,でる者,ものが、あなたの子孫,しそんと呼,よばれるであろう」。","tok":[["また"],["、"],["アブラハム"],["の"],["子孫","しそん"],["だ"],["から"],["と"],["いって"],["、"],["その"],["全部","ぜんぶ"],["が"],["子","こ"],["で"],["ある"],["ので"],["は"],["ない"],["から"],["で"],["ある"],["。"],["かえって"],["「"],["イサク"],["から"],["出る","でる"],["者","もの"],["が"],["、"],["あなた"],["の"],["子孫","しそん"],["と"],["呼ばれるで","よばれるで"],["あろう"],["」"],["。"]]},{"verse":8,"text":"すなわち、肉,にくの子,こがそのまま神,かみの子,こなのではなく、むしろ約束,やくそくの子,こが子孫,しそんとして認,みとめられるのである。","tok":[["すなわち"],["、"],["肉","にく"],["の"],["子","こ"],["が"],["そのまま"],["神","かみ"],["の"],["子","こ"],["な"],["ので"],["は"],["なく"],["、"],["むしろ"],["約束","やくそく"],["の"],["子","こ"],["が"],["子孫","しそん"],["として"],["認められる","みとめられる"],["ので"],["ある"],["。"]]},{"verse":9,"text":"約束,やくそくの言葉,ことばはこうである。「来年,らいねんの今,いまごろ、わたしはまた来,くる。そして、サラに男子,だんしが与,あたえられるであろう」。","tok":[["約束","やくそく"],["の"],["言葉","ことば"],["は"],["こう"],["で"],["ある"],["。"],["「"],["来年","らいねん"],["の"],["今ごろ","いまごろ"],["、"],["わたし"],["は"],["また"],["来る","くる"],["。"],["そして"],["、"],["サラ"],["に"],["男子","だんし"],["が"],["与えられるで","あたえられるで"],["あろう"],["」"],["。"]]},{"verse":10,"text":"そればかりではなく、ひとりの人,ひと、すなわち、わたしたちの父祖,ふそイサクによって受胎,じゅたいしたリベカの場合,ばあいも、また同様,どうようである。","tok":[["それ"],["ばかり"],["で"],["は"],["なく"],["、"],["ひとり"],["の"],["人","ひと"],["、"],["すなわち"],["、"],["わたしたち"],["の"],["父祖","ふそ"],["イサク"],["によって"],["受胎","じゅたい"],["した"],["リベカ"],["の"],["場合","ばあい"],["も"],["、"],["また"],["同様","どうよう"],["で"],["ある"],["。"]]},{"verse":11,"text":"まだ子供,こどもらが生,うまれもせず、善,ぜんも悪,あくもしない先,さきに、神,かみの選,えらびの計画,けいかくが、","tok":[["まだ"],["子供","こども"],["ら"],["が"],["生まれ","うまれ"],["も"],["せず"],["、"],["善","ぜん"],["も"],["悪","あく"],["も"],["しない"],["先","さき"],["に"],["、"],["神","かみ"],["の"],["選ら","えら"],["び"],["の"],["計画","けいかく"],["が"],["、"]]},{"verse":12,"text":"わざによらず、召,めしたかたによって行,おこなわれるために、「兄,あには弟,おとうとに仕,つかえるであろう」と、彼女,かのじょに仰,おおせられたのである。","tok":[["わざ"],["に"],["よらず"],["、"],["召","めし"],["たかた"],["によって"],["行なわれる","おこなわれる"],["ため"],["に"],["、"],["「"],["兄","あに"],["は"],["弟","おとうと"],["に"],["仕えるで","つかえるで"],["あろう"],["」"],["と"],["、"],["彼女","かのじょ"],["に"],["仰せられた","おおせられた"],["ので"],["ある"],["。"]]},{"verse":13,"text":"「わたしはヤコブを愛,あいしエサウを憎,にくんだ」と書,かいてあるとおりである。","tok":[["「"],["わたし"],["は"],["ヤコブ"],["を"],["愛し","あいし"],["エサウ"],["を"],["憎んだ","にくんだ"],["」"],["と"],["書いて","かいて"],["ある"],["とおり"],["で"],["ある"],["。"]]},{"verse":14,"text":"では、わたしたちはなんと言,いおうか。神,かみの側,がわに不正,ふせいがあるのか。断,だんじてそうではない。","tok":[["で"],["は"],["、"],["わたしたち"],["は"],["なん"],["と"],["言おう","いおう"],["か"],["。"],["神","かみ"],["の"],["側","がわ"],["に"],["不正","ふせい"],["が"],["ある"],["の"],["か"],["。"],["断じて","だんじて"],["そう"],["で"],["は"],["ない"],["。"]]},{"verse":15,"text":"神,かみはモーセに言,いわれた、「わたしは自分,じぶんのあわれもうとする者,ものをあわれみ、いつくしもうとする者,ものを、いつくしむ」。","tok":[["神","かみ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"],["「"],["わたし"],["は"],["自分","じぶん"],["の"],["あわれもう"],["と"],["する"],["者","もの"],["を"],["あわれみ"],["、"],["いつくしもう"],["と"],["する"],["者","もの"],["を"],["、"],["いつくしむ"],["」"],["。"]]},{"verse":16,"text":"ゆえに、それは人間,にんげんの意志,いしや努力,どりょくによるのではなく、ただ神,かみのあわれみによるのである。","tok":[["ゆえ"],["に"],["、"],["それ"],["は"],["人間","にんげん"],["の"],["意志","いし"],["や"],["努力","どりょく"],["に"],["よる"],["ので"],["は"],["なく"],["、"],["ただ"],["神","かみ"],["の"],["あわれみ"],["に"],["よる"],["ので"],["ある"],["。"]]},{"verse":17,"text":"聖書,せいしょはパロにこう言,いっている、「わたしがあなたを立,たてたのは、この事,ことのためである。すなわち、あなたによってわたしの力,ちからをあらわし、また、わたしの名,なが全,ぜん世界,せかいに言,いいひろめられるためである」。","tok":[["聖書","せいしょ"],["は"],["パロ"],["に"],["こう"],["言って","いって"],["いる"],["、"],["「"],["わたし"],["が"],["あなた"],["を"],["立てた","たてた"],["の"],["は"],["、"],["この"],["事","こと"],["の"],["ため"],["で"],["ある"],["。"],["すなわち"],["、"],["あなた"],["によって"],["わたし"],["の"],["力","ちから"],["を"],["あらわし"],["、"],["また"],["、"],["わたし"],["の"],["名","な"],["が"],["全","ぜん"],["世界","せかい"],["に"],["言い","いい"],["ひろめられる"],["ため"],["で"],["ある"],["」"],["。"]]},{"verse":18,"text":"だから、神,かみはそのあわれもうと思,おもう者,ものをあわれみ、かたくなにしようと思,おもう者,ものを、かたくなになさるのである。","tok":[["だ"],["から"],["、"],["神","かみ"],["は"],["その"],["あわれもう"],["と"],["思う","おもう"],["者","もの"],["を"],["あわれみ"],["、"],["かたくな"],["に"],["しよう"],["と"],["思う","おもう"],["者","もの"],["を"],["、"],["かたくな"],["に"],["なさる"],["ので"],["ある"],["。"]]},{"verse":19,"text":"そこで、あなたは言,いうであろう、「なぜ神,かみは、なおも人,ひとを責,せめられるのか。だれが、神,かみの意図,いとに逆,さからい得,えようか」。","tok":[["そこ"],["で"],["、"],["あなた"],["は"],["言うで","いうで"],["あろう"],["、"],["「"],["なぜ"],["神","かみ"],["は"],["、"],["なお"],["も"],["人","ひと"],["を"],["責","せめ"],["られる"],["の"],["か"],["。"],["だれ"],["が"],["、"],["神","かみ"],["の"],["意図","いと"],["に"],["逆らい","さからい"],["得よう","えよう"],["か"],["」"],["。"]]},{"verse":20,"text":"ああ人,ひとよ。あなたは、神,かみに言,いい逆,さからうとは、いったい、何者,なにものなのか。造,つくられたものが造,つくった者,ものに向,むかって、「なぜ、わたしをこのように造,つくったのか」と言,いうことがあろうか。","tok":[["ああ"],["人","ひと"],["よ"],["。"],["あなた"],["は"],["、"],["神","かみ"],["に"],["言い","いい"],["逆らう","さからう"],["と"],["は"],["、"],["いったい"],["、"],["何者","なにもの"],["な"],["の"],["か"],["。"],["造られた","つくられた"],["もの"],["が"],["造った","つくった"],["者","もの"],["に"],["向かって","むかって"],["、"],["「"],["なぜ"],["、"],["わたし"],["を"],["この"],["よう"],["に"],["造った","つくった"],["の"],["か"],["」"],["と"],["言う","いう"],["こと"],["が"],["あろう"],["か"],["。"]]},{"verse":21,"text":"陶器,とうきを造,つくる者,ものは、同,おなじ土,つちくれから、一つを尊,たっとい器,うつわに、他,ほかを卑,いやしい器,うつわに造,つくりあげる権能,けんのうがないのであろうか。","tok":[["陶器","とうき"],["を"],["造る","つくる"],["者","もの"],["は"],["、"],["同じ","おなじ"],["土くれ","つちくれ"],["から"],["、"],["一","ひと"],["つ"],["を"],["尊","た"],["っと"],["い"],["器","うつわ"],["に"],["、"],["他","ほか"],["を"],["卑しい","いやしい"],["器","うつわ"],["に"],["造","つくり"],["あげる"],["権能","けんのう"],["が"],["ない"],["ので"],["あろう"],["か"],["。"]]},{"verse":22,"text":"もし、神,かみが怒,いかりをあらわし、かつ、ご自身,じしんの力,ちからを知,しらせようと思,おもわれつつも、滅,ほろびることになっている怒,いかりの器,うつわを、大,おおいなる寛容,かんようをもって忍,しのばれたとすれば、","tok":[["もし"],["、"],["神","かみ"],["が"],["怒り","いかり"],["を"],["あらわし"],["、"],["かつ"],["、"],["ご自身","ごじしん"],["の"],["力","ちから"],["を"],["知らせよう","しらせよう"],["と"],["思われ","おもわれ"],["つつ"],["も"],["、"],["滅びる","ほろびる"],["こと"],["に"],["なって"],["いる"],["怒り","いかり"],["の"],["器","うつわ"],["を"],["、"],["大いなる","おおいなる"],["寛容","かんよう"],["を"],["もって"],["忍ばれた","しのばれた"],["と"],["すれば"],["、"]]},{"verse":23,"text":"かつ、栄光,えいこうにあずからせるために、あらかじめ用意,よういされたあわれみの器,うつわにご自身,じしんの栄光,えいこうの富,とみを知,しらせようとされたとすれば、どうであろうか。","tok":[["かつ"],["、"],["栄光","えいこう"],["に"],["あずからせる"],["ため"],["に"],["、"],["あらかじめ"],["用意","ようい"],["された"],["あわれみ"],["の"],["器","うつわ"],["に"],["ご自身","ごじしん"],["の"],["栄光","えいこう"],["の"],["富","とみ"],["を"],["知らせよう","しらせよう"],["と"],["された"],["と"],["すれば"],["、"],["どう"],["で"],["あろう"],["か"],["。"]]},{"verse":24,"text":"神,かみは、このあわれみの器,うつわとして、またわたしたちをも、ユダヤ人,じんの中,なかからだけではなく、異邦人,いほうじんの中,なかからも召,めされたのである。","tok":[["神","かみ"],["は"],["、"],["この"],["あわれみ"],["の"],["器","うつわ"],["として"],["、"],["また"],["わたしたち"],["を"],["も"],["、"],["ユダヤ人","ゆだやじん"],["の"],["中","なか"],["から"],["だけ"],["で"],["は"],["なく"],["、"],["異邦人","いほうじん"],["の"],["中","なか"],["から"],["も"],["召された","めされた"],["ので"],["ある"],["。"]]},{"verse":25,"text":"それは、ホセアの書,しょでも言,いわれているとおりである、「わたしは、わたしの民,たみでない者,ものを、わたしの民,たみと呼,よび、愛,あいされなかった者,ものを、愛,あいされる者,ものと呼,よぶであろう。","tok":[["それ"],["は"],["、"],["ホセア"],["の"],["書","しょ"],["で"],["も"],["言われて","いわれて"],["いる"],["とおり"],["で"],["ある"],["、"],["「"],["わたし"],["は"],["、"],["わたし"],["の"],["民","たみ"],["で"],["ない"],["者","もの"],["を"],["、"],["わたし"],["の"],["民","たみ"],["と"],["呼び","よび"],["、"],["愛されなかった","あいされなかった"],["者","もの"],["を"],["、"],["愛される","あいされる"],["者","もの"],["と"],["呼ぶで","よぶで"],["あろう"],["。"]]},{"verse":26,"text":"あなたがたはわたしの民,たみではないと、彼,かれらに言,いったその場所,ばしょで、彼,かれらは生,いける神,かみの子,こらであると、呼,よばれるであろう」。","tok":[["あなた"],["がた"],["は"],["わたし"],["の"],["民","たみ"],["で"],["は"],["ない"],["と"],["、"],["彼","かれ"],["ら"],["に"],["言った","いった"],["その"],["場所","ばしょ"],["で"],["、"],["彼","かれ"],["ら"],["は"],["生ける","いける"],["神","かみ"],["の"],["子","こ"],["ら"],["で"],["ある"],["と"],["、"],["呼ばれるで","よばれるで"],["あろう"],["」"],["。"]]},{"verse":27,"text":"また、イザヤはイスラエルについて叫,さけんでいる、「たとい、イスラエルの子,こらの数,かずは、浜,はまの砂,すなのようであっても、救,すくわれるのは、残,のこされた者,ものだけであろう。","tok":[["また"],["、"],["イザヤ"],["は"],["イスラエル"],["について"],["叫けんで","さけんで"],["いる"],["、"],["「"],["たとい"],["、"],["イスラエル"],["の"],["子","こ"],["ら"],["の"],["数","かず"],["は"],["、"],["浜","はま"],["の"],["砂","すな"],["の"],["よう"],["で"],["あって"],["も"],["、"],["救われる","すくわれる"],["の"],["は"],["、"],["残された","のこされた"],["者","もの"],["だけ"],["で"],["あろう"],["。"]]},{"verse":28,"text":"主,しゅは、御言,みことばをきびしくまたすみやかに、地上,ちじょうになしとげられるであろう」。","tok":[["主","しゅ"],["は"],["、"],["御言","みこと"],["ば"],["を"],["きびしく"],["また"],["すみやか"],["に"],["、"],["地上","ちじょう"],["に"],["なしとげられるで"],["あろう"],["」"],["。"]]},{"verse":29,"text":"さらに、イザヤは預言,よげんした、「もし、万軍,ばんぐんの主,しゅがわたしたちに子孫,しそんを残,のこされなかったなら、わたしたちはソドムのようになり、ゴモラと同,おなじようになったであろう」。","tok":[["さらに"],["、"],["イザヤ"],["は"],["預言","よげん"],["した"],["、"],["「"],["もし"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["が"],["わたしたち"],["に"],["子孫","しそん"],["を"],["残されなかったなら","のこされなかったなら"],["、"],["わたしたち"],["は"],["ソドム"],["の"],["よう"],["に"],["なり"],["、"],["ゴモラ"],["と"],["同じ","おなじ"],["よう"],["に"],["なったで"],["あろう"],["」"],["。"]]},{"verse":30,"text":"では、わたしたちはなんと言,いおうか。義,ぎを追,おい求,もとめなかった異邦人,いほうじんは、義,ぎ、すなわち、信仰,しんこうによる義,ぎを得,えた。","tok":[["で"],["は"],["、"],["わたしたち"],["は"],["なん"],["と"],["言おう","いおう"],["か"],["。"],["義","ぎ"],["を"],["追い求めなかった","おいもとめなかった"],["異邦人","いほうじん"],["は"],["、"],["義","ぎ"],["、"],["すなわち"],["、"],["信仰","しんこう"],["に"],["よる"],["義","ぎ"],["を"],["得た","えた"],["。"]]},{"verse":31,"text":"しかし、義,ぎの律法,りっぽうを追,おい求,もとめていたイスラエルは、その律法,りっぽうに達,たっしなかった。","tok":[["しかし"],["、"],["義","ぎ"],["の"],["律法","りっぽう"],["を"],["追い求めて","おいもとめて"],["いた"],["イスラエル"],["は"],["、"],["その"],["律法","りっぽう"],["に"],["達しなかった","たっしなかった"],["。"]]},{"verse":32,"text":"なぜであるか。信仰,しんこうによらないで、行,おこないによって得,えられるかのように、追,おい求,もとめたからである。彼,かれらは、つまずきの石,いしにつまずいたのである。","tok":[["なぜ"],["で"],["ある"],["か"],["。"],["信仰","しんこう"],["に"],["よらないで"],["、"],["行ない","おこない"],["によって"],["得られる","えられる"],["か"],["の"],["よう"],["に"],["、"],["追い求めた","おいもとめた"],["から"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["、"],["つまずき"],["の"],["石","いし"],["に"],["つまずいた"],["ので"],["ある"],["。"]]},{"verse":33,"text":"「見,みよ、わたしはシオンに、つまずきの石,いし、さまたげの岩,いわを置,おく。それにより頼,たのむ者,ものは、失望,しつぼうに終,おわることがない」と書,かいてあるとおりである。","tok":[["「"],["見よ","みよ"],["、"],["わたし"],["は"],["シオン"],["に"],["、"],["つまずき"],["の"],["石","いし"],["、"],["さまたげ"],["の"],["岩","いわ"],["を"],["置く","おく"],["。"],["それ"],["に"],["より"],["頼む","たのむ"],["者","もの"],["は"],["、"],["失望","しつぼう"],["に"],["終わる","おわる"],["こと"],["が"],["ない"],["」"],["と"],["書いて","かいて"],["ある"],["とおり"],["で"],["ある"],["。"]]}]
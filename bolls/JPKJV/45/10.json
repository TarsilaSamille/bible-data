[{"verse":1,"text":"兄弟,きょうだいたちよ。わたしの心,こころの願,ねがい、彼,かれらのために神,かみにささげる祈,いのりは、彼,かれらが救,すくわれることである。","tok":[["兄弟","きょうだい"],["たち"],["よ"],["。"],["わたし"],["の"],["心","こころ"],["の"],["願い","ねがい"],["、"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["神","かみ"],["に"],["ささげる"],["祈","いのり"],["は"],["、"],["彼","かれ"],["ら"],["が"],["救われる","すくわれる"],["こと"],["で"],["ある"],["。"]]},{"verse":2,"text":"わたしは、彼,かれらが神,かみに対,たいして熱心,ねっしんであることはあかしするが、その熱心,ねっしんは深,ふかい知識,ちしきによるものではない。","tok":[["わたし"],["は"],["、"],["彼","かれ"],["ら"],["が"],["神","かみ"],["に対して","にたいして"],["熱心","ねっしん"],["で"],["ある"],["こと"],["は"],["あかし"],["する"],["が"],["、"],["その"],["熱心","ねっしん"],["は"],["深","ふ"],["かい"],["知識","ちしき"],["に"],["よる"],["もの"],["で"],["は"],["ない"],["。"]]},{"verse":3,"text":"なぜなら、彼,かれらは神,かみの義,ぎを知,しらないで、自分,じぶんの義,ぎを立,たてようと努,つとめ、神,かみの義,ぎに従,したがわなかったからである。","tok":[["なぜ"],["なら"],["、"],["彼","かれ"],["ら"],["は"],["神","かみ"],["の"],["義","ぎ"],["を"],["知らないで","しらないで"],["、"],["自分","じぶん"],["の"],["義","ぎ"],["を"],["立よう","たてよう"],["と"],["努め","つとめ"],["、"],["神","かみ"],["の"],["義","ぎ"],["に"],["従わなかった","したがわなかった"],["から"],["で"],["ある"],["。"]]},{"verse":4,"text":"キリストは、すべて信,しんじる者,ものに義,ぎを得,えさせるために、律法,りっぽうの終,おわりとなられたのである。","tok":[["キリスト"],["は"],["、"],["すべて"],["信じる","しんじる"],["者","もの"],["に"],["義","ぎ"],["を"],["得させる","えさせる"],["ため"],["に"],["、"],["律法","りっぽう"],["の"],["終","おわり"],["と"],["なられた"],["ので"],["ある"],["。"]]},{"verse":5,"text":"モーセは、律法,りっぽうによる義,ぎを行,おこなう人,ひとは、その義,ぎによって生,いきる、と書,かいている。","tok":[["モーセ"],["は"],["、"],["律法","りっぽう"],["に"],["よる"],["義","ぎ"],["を"],["行なう","おこなう"],["人","ひと"],["は"],["、"],["その"],["義","ぎ"],["によって"],["生きる","いきる"],["、"],["と"],["書いて","かいて"],["いる"],["。"]]},{"verse":6,"text":"しかし、信仰,しんこうによる義,ぎは、こう言,いっている、「あなたは心,こころのうちで、だれが天,てんに上,のぼるであろうかと言,いうな」。それは、キリストを引,ひき降,おろすことである。","tok":[["しかし"],["、"],["信仰","しんこう"],["に"],["よる"],["義","ぎ"],["は"],["、"],["こう"],["言って","いって"],["いる"],["、"],["「"],["あなた"],["は"],["心","こころ"],["の"],["うち"],["で"],["、"],["だれ"],["が"],["天","てん"],["に"],["上るで","のぼるで"],["あろう"],["か"],["と"],["言う","いう"],["な"],["」"],["。"],["それ"],["は"],["、"],["キリスト"],["を"],["引","ひき"],["降ろす","おろす"],["こと"],["で"],["ある"],["。"]]},{"verse":7,"text":"また、「だれが底,そこ知,しれぬ所,ところに下,くだるであろうかと言,いうな」。それは、キリストを死人,しにんの中,なかから引,ひき上,あげることである。","tok":[["また"],["、"],["「"],["だれ"],["が"],["底","そこ"],["知れぬ","しれぬ"],["所","ところ"],["に"],["下るで","くだるで"],["あろう"],["か"],["と"],["言う","いう"],["な"],["」"],["。"],["それ"],["は"],["、"],["キリスト"],["を"],["死人","しにん"],["の"],["中","なか"],["から"],["引上げる","ひきあげる"],["こと"],["で"],["ある"],["。"]]},{"verse":8,"text":"では、なんと言,いっているか。「言葉,ことばはあなたの近,ちかくにある。あなたの口,くちにあり、心,こころにある」。この言葉,ことばとは、わたしたちが宣,のべ伝,つたえている信仰,しんこうの言葉,ことばである。","tok":[["で"],["は"],["、"],["なん"],["と"],["言って","いって"],["いる"],["か"],["。"],["「"],["言葉","ことば"],["は"],["あなた"],["の"],["近く","ちかく"],["に"],["ある"],["。"],["あなた"],["の"],["口","くち"],["に"],["あり"],["、"],["心","こころ"],["に"],["ある"],["」"],["。"],["この"],["言葉","ことば"],["と"],["は"],["、"],["わたしたち"],["が"],["宣べ伝えて","のべつたえて"],["いる"],["信仰","しんこう"],["の"],["言葉","ことば"],["で"],["ある"],["。"]]},{"verse":9,"text":"すなわち、自分,じぶんの口,くちで、イエスは主,しゅであると告白,こくはくし、自分,じぶんの心,こころで、神,かみが死人,しにんの中,なかからイエスをよみがえらせたと信,しんじるなら、あなたは救,すくわれる。","tok":[["すなわち"],["、"],["自分","じぶん"],["の"],["口","くち"],["で"],["、"],["イエス"],["は"],["主","しゅである"],["と"],["告白","こくはく"],["し"],["、"],["自分","じぶん"],["の"],["心","こころ"],["で"],["、"],["神","かみ"],["が"],["死人","しにん"],["の"],["中","なか"],["から"],["イエス"],["を"],["よみがえらせた"],["と"],["信じるなら","しんじるなら"],["、"],["あなた"],["は"],["救われる","すくわれる"],["。"]]},{"verse":10,"text":"なぜなら、人,ひとは心,こころに信,しんじて義,ぎとされ、口,くちで告白,こくはくして救,すくわれるからである。","tok":[["なぜ"],["なら"],["、"],["人","ひと"],["は"],["心","こころ"],["に"],["信じて","しんじて"],["義","ぎ"],["と"],["され"],["、"],["口","くち"],["で"],["告白","こくはく"],["して"],["救われる","すくわれる"],["から"],["で"],["ある"],["。"]]},{"verse":11,"text":"聖書,せいしょは、「すべて彼,かれを信,しんじる者,ものは、失望,しつぼうに終,おわることがない」と言,いっている。","tok":[["聖書","せいしょ"],["は"],["、"],["「"],["すべて"],["彼","かれ"],["を"],["信じる","しんじる"],["者","もの"],["は"],["、"],["失望","しつぼう"],["に"],["終わる","おわる"],["こと"],["が"],["ない"],["」"],["と"],["言って","いって"],["いる"],["。"]]},{"verse":12,"text":"ユダヤ人,じんとギリシヤ人,じんとの差別,さべつはない。同一,どういつの主,しゅが万民,ばんみんの主,しゅであって、彼,かれを呼,よび求,もとめるすべての人,ひとを豊,ゆたかに恵,めぐんで下,くださるからである。","tok":[["ユダヤ人","ゆだやじん"],["と"],["ギリシヤ"],["人","じんと"],["の"],["差別","さべつ"],["は"],["ない"],["。"],["同一","どういつ"],["の"],["主","しゅ"],["が"],["万民","ばんみん"],["の"],["主","しゅ"],["で"],["あって"],["、"],["彼","かれ"],["を"],["呼び求める","よびもとめる"],["すべて"],["の"],["人","ひと"],["を"],["豊","ゆたか"],["に"],["恵んで","めぐんで"],["下さる","くださる"],["から"],["で"],["ある"],["。"]]},{"verse":13,"text":"なぜなら、「主,しゅの御名,みなを呼,よび求,もとめる者,ものは、すべて救,すくわれる」とあるからである。","tok":[["なぜ"],["なら"],["、"],["「"],["主","しゅ"],["の"],["御名","みな"],["を"],["呼び求める","よびもとめる"],["者","もの"],["は"],["、"],["すべて"],["救われる","すくわれる"],["」"],["と"],["ある"],["から"],["で"],["ある"],["。"]]},{"verse":14,"text":"しかし、信,しんじたことのない者,ものを、どうして呼,よび求,もとめることがあろうか。聞,きいたことのない者,ものを、どうして信,しんじることがあろうか。宣,のべ伝,つたえる者,ものがいなくては、どうして聞,きくことがあろうか。","tok":[["しかし"],["、"],["信じた","しんじた"],["こと"],["の"],["ない"],["者","もの"],["を"],["、"],["どう"],["して"],["呼び求める","よびもとめる"],["こと"],["が"],["あろう"],["か"],["。"],["聞いた","きいた"],["こと"],["の"],["ない"],["者","もの"],["を"],["、"],["どう"],["して"],["信じる","しんじる"],["こと"],["が"],["あろう"],["か"],["。"],["宣べ伝える","のべつたえる"],["者","もの"],["が"],["いなくて"],["は"],["、"],["どう"],["して"],["聞く","きく"],["こと"],["が"],["あろう"],["か"],["。"]]},{"verse":15,"text":"つかわされなくては、どうして宣,のべ伝,つたえることがあろうか。「ああ、麗,うるわしいかな、良,よきおとずれを告,つげる者,ものの足,あしは」と書,かいてあるとおりである。","tok":[["つかわされなくて"],["は"],["、"],["どう"],["して"],["宣べ伝える","のべつたえる"],["こと"],["が"],["あろう"],["か"],["。"],["「"],["ああ"],["、"],["麗わしい","うるわしい"],["か"],["な"],["、"],["良き","よき"],["おとずれ"],["を"],["告げる","つげる"],["者","もの"],["の"],["足","あし"],["は"],["」"],["と"],["書いて","かいて"],["ある"],["とおり"],["で"],["ある"],["。"]]},{"verse":16,"text":"しかし、すべての人,ひとが福音,ふくいんに聞,きき従,したがったのではない。イザヤは、「主,しゅよ、だれがわたしたちから聞,きいたことを信,しんじましたか」と言,いっている。","tok":[["しかし"],["、"],["すべて"],["の"],["人","ひと"],["が"],["福音","ふくいん"],["に"],["聞","きき"],["従った","したがった"],["ので"],["は"],["ない"],["。"],["イザヤ"],["は"],["、"],["「"],["主","しゅ"],["よ"],["、"],["だれ"],["が"],["わたしたち"],["から"],["聞いた","きいた"],["こと"],["を"],["信じました","しんじました"],["か"],["」"],["と"],["言って","いって"],["いる"],["。"]]},{"verse":17,"text":"したがって、信仰,しんこうは聞,きくことによるのであり、聞,きくことはキリストの言葉,ことばから来,くるのである。","tok":[["したがって"],["、"],["信仰","しんこう"],["は"],["聞く","きく"],["こと"],["に"],["よる"],["ので"],["あり"],["、"],["聞く","きく"],["こと"],["は"],["キリスト"],["の"],["言葉","ことば"],["から"],["来る","くる"],["ので"],["ある"],["。"]]},{"verse":18,"text":"しかしわたしは言,いう、彼,かれらには聞,きこえなかったのであろうか。否,いな、むしろ「その声,こえは全,ぜん地,ちにひびきわたり、その言葉,ことばは世界,せかいのはてにまで及,およんだ」。","tok":[["しかし"],["わたし"],["は"],["言う","いう"],["、"],["彼","かれ"],["ら"],["に"],["は"],["聞こえなかった","きこえなかった"],["ので"],["あろう"],["か"],["。"],["否","いな"],["、"],["むしろ"],["「"],["その"],["声","こえ"],["は"],["全地","ぜんち"],["に"],["ひびき"],["わたり"],["、"],["その"],["言葉","ことば"],["は"],["世界","せかい"],["の"],["はて"],["に"],["まで"],["及んだ","およんだ"],["」"],["。"]]},{"verse":19,"text":"なお、わたしは言,いう、イスラエルは知,しらなかったのであろうか。まずモーセは言,いっている、「わたしはあなたがたに、国民,こくみんでない者,ものに対,たいしてねたみを起,おこさせ、無知,むちな国民,こくみんに対,たいして、怒,いかりをいだかせるであろう」。","tok":[["なお"],["、"],["わたし"],["は"],["言う","いう"],["、"],["イスラエル"],["は"],["知らなかった","しらなかった"],["ので"],["あろう"],["か"],["。"],["まず"],["モーセ"],["は"],["言って","いって"],["いる"],["、"],["「"],["わたし"],["は"],["あなた"],["がた"],["に"],["、"],["国民","こくみん"],["で"],["ない"],["者","もの"],["に対して","にたいして"],["ねたみ"],["を"],["起こさせ","おこさせ"],["、"],["無知","むち"],["な"],["国民","こくみん"],["に対して","にたいして"],["、"],["怒り","いかり"],["を"],["いだかせるで"],["あろう"],["」"],["。"]]},{"verse":20,"text":"イザヤも大胆,だいたんに言,いっている、「わたしは、わたしを求,もとめない者,ものたちに見,みいだされ、わたしを尋,たずねない者,ものに、自分,じぶんを現,あらわした」。","tok":[["イザヤ"],["も"],["大胆","だいたん"],["に"],["言って","いって"],["いる"],["、"],["「"],["わたし"],["は"],["、"],["わたし"],["を"],["求めない","もとめない"],["者","もの"],["たち"],["に"],["見いだされ","みいだされ"],["、"],["わたし"],["を"],["尋ねない","たずねない"],["者","もの"],["に"],["、"],["自分","じぶん"],["を"],["現わした","あらわした"],["」"],["。"]]},{"verse":21,"text":"そして、イスラエルについては、「わたしは服従,ふくじゅうせずに反抗,はんこうする民,たみに、終日,しゅうじつわたしの手,てをさし伸,のべていた」と言,いっている。","tok":[["そして"],["、"],["イスラエル"],["について"],["は"],["、"],["「"],["わたし"],["は"],["服従","ふくじゅう"],["せず"],["に"],["反抗","はんこう"],["する"],["民","たみ"],["に"],["、"],["終日","しゅうじつ"],["わたし"],["の"],["手","て"],["を"],["さし伸べて","さしのべて"],["いた"],["」"],["と"],["言って","いって"],["いる"],["。"]]}]
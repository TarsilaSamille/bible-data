[{"verse":1,"text":"そこで、わたしは問,とう、「神,かみはその民,たみを捨,すてたのであろうか」。断,だんじてそうではない。わたしもイスラエル人,ひとであり、アブラハムの子孫,しそん、ベニヤミン族,ぞくの者,ものである。","tok":[["そこ"],["で"],["、"],["わたし"],["は"],["問う","とう"],["、"],["「"],["神","かみ"],["は"],["その"],["民","たみ"],["を"],["捨てた","すてた"],["ので"],["あろう"],["か"],["」"],["。"],["断じて","だんじて"],["そう"],["で"],["は"],["ない"],["。"],["わたし"],["も"],["イスラエル"],["人","ひと"],["で"],["あり"],["、"],["アブラハム"],["の"],["子孫","しそん"],["、"],["ベニヤミン"],["族","ぞく"],["の"],["者","もの"],["で"],["ある"],["。"]]},{"verse":2,"text":"神,かみは、あらかじめ知,しっておられたその民,たみを、捨,すてることはされなかった。聖書,せいしょがエリヤについてなんと言,いっているか、あなたがたは知,しらないのか。すなわち、彼,かれはイスラエルを神,かみに訴,うったえてこう言,いった。","tok":[["神","かみ"],["は"],["、"],["あらかじめ"],["知って","しって"],["おられた"],["その"],["民","たみ"],["を"],["、"],["捨てる","すてる"],["こと"],["は"],["されなかった"],["。"],["聖書","せいしょ"],["が"],["エリヤ"],["について"],["なん"],["と"],["言って","いって"],["いる"],["か"],["、"],["あなた"],["がた"],["は"],["知らない","しらない"],["の"],["か"],["。"],["すなわち"],["、"],["彼","かれ"],["は"],["イスラエル"],["を"],["神","かみ"],["に"],["訴て","うったえて"],["こう"],["言った","いった"],["。"]]},{"verse":3,"text":"「主,しゅよ、彼,かれらはあなたの預言者,よげんしゃたちを殺,ころし、あなたの祭壇,さいだんをこぼち、そして、わたしひとりが取,とり残,のこされたのに、彼,かれらはわたしのいのちをも求,もとめています」。","tok":[["「"],["主","しゅ"],["よ"],["、"],["彼","かれ"],["ら"],["は"],["あなた"],["の"],["預言者","よげんしゃ"],["たち"],["を"],["殺ろし","ころし"],["、"],["あなた"],["の"],["祭壇","さいだん"],["を"],["こ"],["ぼ"],["ち"],["、"],["そして"],["、"],["わたし"],["ひとり"],["が"],["取残された","とりのこされた"],["のに"],["、"],["彼","かれ"],["ら"],["は"],["わたし"],["の"],["いのち"],["を"],["も"],["求めて","もとめて"],["います"],["」"],["。"]]},{"verse":4,"text":"しかし、彼,かれに対,たいする御,み告,つげはなんであったか、「バアルにひざをかがめなかった七千人,にんを、わたしのために残,のこしておいた」。","tok":[["しかし"],["、"],["彼","かれ"],["に"],["対する","たいする"],["御告","みつげ"],["は"],["なん"],["で"],["あった"],["か"],["、"],["「"],["バアル"],["に"],["ひざ"],["を"],["かがめなかった"],["七千人","にん"],["を"],["、"],["わたし"],["の"],["ため"],["に"],["残して","のこして"],["おいた"],["」"],["。"]]},{"verse":5,"text":"それと同,おなじように、今,いまの時,ときにも、恵,めぐみの選,えらびによって残,のこされた者,ものがいる。","tok":[["それ"],["と"],["同じ","おなじ"],["よう"],["に"],["、"],["今","いま"],["の"],["時","とき"],["に"],["も"],["、"],["恵","めぐみ"],["の"],["選ら","えら"],["び"],["によって"],["残された","のこされた"],["者","もの"],["が"],["いる"],["。"]]},{"verse":6,"text":"しかし、恵,めぐみによるのであれば、もはや行,おこないによるのではない。そうでないと、恵,めぐみはもはや恵,めぐみでなくなるからである。","tok":[["しかし"],["、"],["恵","めぐみ"],["に"],["よる"],["ので"],["あれば"],["、"],["もはや"],["行ない","おこない"],["に"],["よる"],["ので"],["は"],["ない"],["。"],["そう"],["で"],["ない"],["と"],["、"],["恵","めぐみ"],["は"],["もはや"],["恵で","めぐみで"],["なく"],["なる"],["から"],["で"],["ある"],["。"]]},{"verse":7,"text":"では、どうなるのか。イスラエルはその追,おい求,もとめているものを得,えないで、ただ選,えらばれた者,ものが、それを得,えた。そして、他,たの者,ものたちはかたくなになった。","tok":[["で"],["は"],["、"],["どう"],["なる"],["の"],["か"],["。"],["イスラエル"],["は"],["その"],["追い求めて","おいもとめて"],["いる"],["もの"],["を"],["得ないで","えないで"],["、"],["ただ"],["選ら","えら"],["ばれた"],["者","もの"],["が"],["、"],["それ"],["を"],["得た","えた"],["。"],["そして"],["、"],["他","た"],["の"],["者","もの"],["たち"],["は"],["かたくな"],["に"],["なった"],["。"]]},{"verse":8,"text":"「神,かみは、彼,かれらに鈍,にぶい心,こころと、見,みえない目,めと、聞,きこえない耳,みみとを与,あたえて、きょう、この日,ひに及,およんでいる」と書,かいてあるとおりである。","tok":[["「"],["神","かみ"],["は"],["、"],["彼","かれ"],["ら"],["に"],["鈍い","にぶい"],["心","こころ"],["と"],["、"],["見えない","みえない"],["目","め"],["と"],["、"],["聞こえない","きこえない"],["耳","みみ"],["と"],["を"],["与","あたえ"],["て"],["、"],["きょう"],["、"],["この"],["日","ひ"],["に"],["及んで","およんで"],["いる"],["」"],["と"],["書いて","かいて"],["ある"],["とおり"],["で"],["ある"],["。"]]},{"verse":9,"text":"ダビデもまた言,いっている、「彼,かれらの食卓,しょくたくは、彼,かれらのわなとなれ、網,あみとなれ、つまずきとなれ、報復,ほうふくとなれ。","tok":[["ダビデ"],["も"],["また"],["言って","いって"],["いる"],["、"],["「"],["彼","かれ"],["ら"],["の"],["食卓","しょくたく"],["は"],["、"],["彼","かれ"],["ら"],["の"],["わな"],["と"],["なれ"],["、"],["網","あみ"],["と"],["なれ"],["、"],["つまずき"],["と"],["なれ"],["、"],["報復","ほうふく"],["と"],["なれ"],["。"]]},{"verse":10,"text":"彼,かれらの目,めは、くらんで見,みえなくなれ、彼,かれらの背,せは、いつまでも曲,まがっておれ」。","tok":[["彼","かれ"],["ら"],["の"],["目","め"],["は"],["、"],["くらんで"],["見えなく","みえなく"],["なれ"],["、"],["彼","かれ"],["ら"],["の"],["背","せ"],["は"],["、"],["いつ"],["まで"],["も"],["曲がって","まがって"],["おれ"],["」"],["。"]]},{"verse":11,"text":"そこで、わたしは問,とう、「彼,かれらがつまずいたのは、倒,たおれるためであったのか」。断,だんじてそうではない。かえって、彼,かれらの罪過,ざいかによって、救,すくいが異邦人,いほうじんに及,および、それによってイスラエルを奮起,ふんきさせるためである。","tok":[["そこ"],["で"],["、"],["わたし"],["は"],["問う","とう"],["、"],["「"],["彼","かれ"],["ら"],["が"],["つまずいた"],["の"],["は"],["、"],["倒れる","たおれる"],["ため"],["で"],["あった"],["の"],["か"],["」"],["。"],["断じて","だんじて"],["そう"],["で"],["は"],["ない"],["。"],["かえって"],["、"],["彼","かれ"],["ら"],["の"],["罪過","ざいか"],["によって"],["、"],["救い","すくい"],["が"],["異邦人","いほうじん"],["に"],["及","および"],["、"],["それ"],["によって"],["イスラエル"],["を"],["奮起","ふんき"],["させる"],["ため"],["で"],["ある"],["。"]]},{"verse":12,"text":"しかし、もし、彼,かれらの罪過,ざいかが世,よの富,とみとなり、彼,かれらの失敗,しっぱいが異邦人,いほうじんの富,とみとなったとすれば、まして彼,かれらが全部,ぜんぶ救,すくわれたなら、どんなにかすばらしいことであろう。","tok":[["しかし"],["、"],["もし"],["、"],["彼","かれ"],["ら"],["の"],["罪過","ざいか"],["が"],["世","よ"],["の"],["富","とみ"],["と"],["なり"],["、"],["彼","かれ"],["ら"],["の"],["失敗","しっぱい"],["が"],["異邦人","いほうじん"],["の"],["富","とみ"],["と"],["なった"],["と"],["すれば"],["、"],["まして"],["彼","かれ"],["ら"],["が"],["全部","ぜんぶ"],["救われたなら","すくわれたなら"],["、"],["どんな"],["に"],["か"],["すばらしい"],["こと"],["で"],["あろう"],["。"]]},{"verse":13,"text":"そこでわたしは、あなたがた異邦人,いほうじんに言,いう。わたし自身,じしんは異邦人,いほうじんの使徒,しとなのであるから、わたしの務,つとめを光栄,こうえいとし、","tok":[["そこ"],["で"],["わたし"],["は"],["、"],["あなた"],["がた"],["異邦人","いほうじん"],["に"],["言う","いう"],["。"],["わたし"],["自身","じしん"],["は"],["異邦人","いほうじん"],["の"],["使徒","しと"],["な"],["ので"],["ある"],["から"],["、"],["わたし"],["の"],["務め","つとめ"],["を"],["光栄","こうえい"],["と"],["し"],["、"]]},{"verse":14,"text":"どうにかしてわたしの骨肉,こつにくを奮起,ふんきさせ、彼,かれらの幾人,いくにんかを救,すくおうと願,ねがっている。","tok":[["どう"],["に"],["か"],["して"],["わたし"],["の"],["骨肉","こつにく"],["を"],["奮起","ふんき"],["させ"],["、"],["彼","かれ"],["ら"],["の"],["幾人","いくにん"],["か"],["を"],["救おう","すくおう"],["と"],["願って","ねがって"],["いる"],["。"]]},{"verse":15,"text":"もし彼,かれらの捨,すてられたことが世,よの和解,わかいとなったとすれば、彼,かれらの受,うけいれられることは、死人,しにんの中,なかから生,いき返,かえることではないか。","tok":[["もし"],["彼","かれ"],["ら"],["の"],["捨てられた","すてられた"],["こと"],["が"],["世","よ"],["の"],["和解","わかい"],["と"],["なった"],["と"],["すれば"],["、"],["彼","かれ"],["ら"],["の"],["受けいれられる","うけいれられる"],["こと"],["は"],["、"],["死人","しにん"],["の"],["中","なか"],["から"],["生き返る","いきかえる"],["こと"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":16,"text":"もし、麦粉,むぎこの初穂,はつほがきよければ、そのかたまりもきよい。もし根,ねがきよければ、その枝,えだもきよい。","tok":[["もし"],["、"],["麦粉","むぎこ"],["の"],["初穂","はつほ"],["が"],["きよければ"],["、"],["その"],["かたまり"],["も"],["きよい"],["。"],["もし"],["根","ね"],["が"],["きよければ"],["、"],["その"],["枝","えだ"],["も"],["きよい"],["。"]]},{"verse":17,"text":"しかし、もしある枝,えだが切,きり去,さられて、野生,やせいのオリブであるあなたがそれにつがれ、オリブの根,ねの豊,ゆたかな養分,ようぶんにあずかっているとすれば、","tok":[["しかし"],["、"],["もし"],["ある"],["枝","えだ"],["が"],["切り去られて","きりさられて"],["、"],["野生","やせい"],["の"],["オリブ"],["で"],["ある"],["あなた"],["が"],["それ"],["に"],["つがれ"],["、"],["オリブ"],["の"],["根","ね"],["の"],["豊","ゆたか"],["な"],["養分","ようぶん"],["に"],["あずかって"],["いる"],["と"],["すれば"],["、"]]},{"verse":18,"text":"あなたはその枝,えだに対,たいして誇,ほこってはならない。たとえ誇,ほこるとしても、あなたが根,ねをささえているのではなく、根,ねがあなたをささえているのである。","tok":[["あなた"],["は"],["その"],["枝","えだ"],["に対して","にたいして"],["誇って","ほこって"],["は"],["ならない"],["。"],["たとえ"],["誇る","ほこる"],["として"],["も"],["、"],["あなた"],["が"],["根","ね"],["を"],["ささえて"],["いる"],["ので"],["は"],["なく"],["、"],["根","ね"],["が"],["あなた"],["を"],["ささえて"],["いる"],["ので"],["ある"],["。"]]},{"verse":19,"text":"すると、あなたは、「枝,えだが切,きり去,さられたのは、わたしがつがれるためであった」と言,いうであろう。","tok":[["する"],["と"],["、"],["あなた"],["は"],["、"],["「"],["枝","えだ"],["が"],["切り去られた","きりさられた"],["の"],["は"],["、"],["わたし"],["が"],["つがれる"],["ため"],["で"],["あった"],["」"],["と"],["言うで","いうで"],["あろう"],["。"]]},{"verse":20,"text":"まさに、そのとおりである。彼,かれらは不,ふ信仰,しんこうのゆえに切,きり去,さられ、あなたは信仰,しんこうのゆえに立,たっているのである。高,たかぶった思,おもいをいだかないで、むしろ恐,おそれなさい。","tok":[["まさに"],["、"],["その"],["とおり"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["不","ふ"],["信仰","しんこう"],["の"],["ゆえ"],["に"],["切り去られ","きりさられ"],["、"],["あなた"],["は"],["信仰","しんこう"],["の"],["ゆえ"],["に"],["立って","たって"],["いる"],["ので"],["ある"],["。"],["高か","たか"],["ぶっ"],["た"],["思い","おもい"],["を"],["いだかないで"],["、"],["むしろ"],["恐れ","おそれ"],["なさい"],["。"]]},{"verse":21,"text":"もし神,かみが元木,もときの枝,えだを惜,おしまなかったとすれば、あなたを惜,おしむようなことはないであろう。","tok":[["もし"],["神","かみ"],["が"],["元木","もとき"],["の"],["枝","えだ"],["を"],["惜まなかった","おしまなかった"],["と"],["すれば"],["、"],["あなた"],["を"],["惜む","おしむ"],["よう"],["な"],["こと"],["は"],["ないで"],["あろう"],["。"]]},{"verse":22,"text":"神,かみの慈愛,じあいと峻厳,しゅんげんとを見,みよ。神,かみの峻厳,しゅんげんは倒,たおれた者,ものたちに向,むけられ、神,かみの慈愛,じあいは、もしあなたがその慈愛,じあいにとどまっているなら、あなたに向,むけられる。そうでないと、あなたも切,きり取,とられるであろう。","tok":[["神","かみ"],["の"],["慈愛","じあい"],["と"],["峻厳","しゅんげん"],["と"],["を"],["見よ","みよ"],["。"],["神","かみ"],["の"],["峻厳","しゅんげん"],["は"],["倒れた","たおれた"],["者","もの"],["たち"],["に"],["向けられ","むけられ"],["、"],["神","かみ"],["の"],["慈愛","じあい"],["は"],["、"],["もし"],["あなた"],["が"],["その"],["慈愛","じあい"],["に"],["とどまって"],["いるなら"],["、"],["あなた"],["に"],["向けられる","むけられる"],["。"],["そう"],["で"],["ない"],["と"],["、"],["あなた"],["も"],["切り取られるで","きりとられるで"],["あろう"],["。"]]},{"verse":23,"text":"しかし彼,かれらも、不,ふ信仰,しんこうを続,つづけなければ、つがれるであろう。神,かみには彼,かれらを再,ふたたびつぐ力,ちからがある。","tok":[["しかし"],["彼","かれ"],["ら"],["も"],["、"],["不","ふ"],["信仰","しんこう"],["を"],["続けなければ","つづけなければ"],["、"],["つがれるで"],["あろう"],["。"],["神","かみ"],["に"],["は"],["彼","かれ"],["ら"],["を"],["再び","ふたたび"],["つぐ"],["力","ちから"],["が"],["ある"],["。"]]},{"verse":24,"text":"なぜなら、もしあなたが自然,しぜんのままの野生,やせいのオリブから切,きり取,とられ、自然,しぜんの性質,せいしつに反,はんして良,よいオリブにつがれたとすれば、まして、これら自然,しぜんのままの良,よい枝,えだは、もっとたやすく、元,もとのオリブにつがれないであろうか。","tok":[["なぜ"],["なら"],["、"],["もし"],["あなた"],["が"],["自然","しぜん"],["の"],["まま"],["の"],["野生","やせい"],["の"],["オリブ"],["から"],["切り取られ","きりとられ"],["、"],["自然","しぜん"],["の"],["性質","せいしつ"],["に"],["反して","はんして"],["良い","よい"],["オリブ"],["に"],["つがれた"],["と"],["すれば"],["、"],["まして"],["、"],["これ"],["ら"],["自然","しぜん"],["の"],["まま"],["の"],["良い","よい"],["枝","えだ"],["は"],["、"],["もっと"],["たやすく"],["、"],["元","もと"],["の"],["オリブ"],["に"],["つがれないで"],["あろう"],["か"],["。"]]},{"verse":25,"text":"兄弟,きょうだいたちよ。あなたがたが知者,ちしゃだと自負,じふすることのないために、この奥義,おくぎを知,しらないでいてもらいたくない。一部,いちぶのイスラエル人,びとがかたくなになったのは、異邦人,いほうじんが全部,ぜんぶ救,すくわれるに至,いたる時,ときまでのことであって、","tok":[["兄弟","きょうだい"],["たち"],["よ"],["。"],["あなた"],["がた"],["が"],["知者","ちしゃ"],["だ"],["と"],["自負","じふ"],["する"],["こと"],["の"],["ない"],["ため"],["に"],["、"],["この"],["奥義","おくぎ"],["を"],["知らないで","しらないで"],["いて"],["もらいたく"],["ない"],["。"],["一部","いちぶ"],["の"],["イスラエル"],["人","びと"],["が"],["かたくな"],["に"],["なった"],["の"],["は"],["、"],["異邦人","いほうじん"],["が"],["全部","ぜんぶ"],["救われる","すくわれる"],["に"],["至る","いたる"],["時","とき"],["まで"],["の"],["こと"],["で"],["あって"],["、"]]},{"verse":26,"text":"こうして、イスラエル人,びとは、すべて救,すくわれるであろう。すなわち、次,つぎのように書,かいてある、「救,すくう者,ものがシオンからきて、ヤコブから不信心,ふしんじんを追,おい払,はらうであろう。","tok":[["こう"],["して"],["、"],["イスラエル"],["人","びと"],["は"],["、"],["すべて"],["救われるで","すくわれるで"],["あろう"],["。"],["すなわち"],["、"],["次","つぎ"],["の"],["よう"],["に"],["書いて","かいて"],["ある"],["、"],["「"],["救う","すくう"],["者","もの"],["が"],["シオン"],["から"],["きて"],["、"],["ヤコブ"],["から"],["不信心","ふしんじん"],["を"],["追い払うで","おいはらうで"],["あろう"],["。"]]},{"verse":27,"text":"そして、これが、彼,かれらの罪,つみを除,のぞき去,さる時,ときに、彼,かれらに対,たいして立,たてるわたしの契約,けいやくである」。","tok":[["そして"],["、"],["これ"],["が"],["、"],["彼","かれ"],["ら"],["の"],["罪","つみ"],["を"],["除き去る","のぞきさる"],["時","とき"],["に"],["、"],["彼","かれ"],["ら"],["に対して","にたいして"],["立る","たてる"],["わたし"],["の"],["契約","けいやく"],["で"],["ある"],["」"],["。"]]},{"verse":28,"text":"福音,ふくいんについて言,いえば、彼,かれらは、あなたがたのゆえに、神,かみの敵,てきとされているが、選,えらびについて言,いえば、父祖,ふそたちのゆえに、神,かみに愛,あいせられる者,ものである。","tok":[["福音","ふくいん"],["について"],["言えば","いえば"],["、"],["彼","かれ"],["ら"],["は"],["、"],["あなた"],["がた"],["の"],["ゆえ"],["に"],["、"],["神","かみ"],["の"],["敵","てき"],["と"],["されて"],["いる"],["が"],["、"],["選ら","えら"],["び"],["について"],["言えば","いえば"],["、"],["父祖","ふそ"],["たち"],["の"],["ゆえ"],["に"],["、"],["神","かみ"],["に"],["愛せられる","あいせられる"],["者","もの"],["で"],["ある"],["。"]]},{"verse":29,"text":"神,かみの賜物,たまものと召,めしとは、変,かえられることがない。","tok":[["神","かみ"],["の"],["賜物","たまもの"],["と"],["召","めし"],["と"],["は"],["、"],["変えられる","かえられる"],["こと"],["が"],["ない"],["。"]]},{"verse":30,"text":"あなたがたが、かつては神,かみに不,ふ従順,じゅうじゅんであったが、今,いまは彼,かれらの不,ふ従順,じゅうじゅんによってあわれみを受,うけたように、","tok":[["あなた"],["が"],["た"],["が"],["、"],["かつて"],["は"],["神","かみ"],["に"],["不","ふ"],["従順","じゅうじゅん"],["で"],["あった"],["が"],["、"],["今","いま"],["は"],["彼","かれ"],["ら"],["の"],["不","ふ"],["従順","じゅうじゅん"],["によって"],["あわれみ"],["を"],["受た","うけた"],["よう"],["に"],["、"]]},{"verse":31,"text":"彼,かれらも今,いまは不,ふ従順,じゅうじゅんになっているが、それは、あなたがたの受,うけたあわれみによって、彼,かれら自身,じしんも今,いまあわれみを受,うけるためなのである。","tok":[["彼","かれ"],["ら"],["も"],["今","いま"],["は"],["不","ふ"],["従順","じゅうじゅん"],["に"],["なって"],["いる"],["が"],["、"],["それ"],["は"],["、"],["あなた"],["がた"],["の"],["受けた","うけた"],["あわれみ"],["によって"],["、"],["彼","かれ"],["ら"],["自身","じしん"],["も"],["今","いま"],["あわれみ"],["を"],["受る","うける"],["ため"],["な"],["ので"],["ある"],["。"]]},{"verse":32,"text":"すなわち、神,かみはすべての人,ひとをあわれむために、すべての人,ひとを不,ふ従順,じゅうじゅんのなかに閉,とじ込,こめたのである。","tok":[["すなわち"],["、"],["神","かみ"],["は"],["すべて"],["の"],["人","ひと"],["を"],["あわれむ"],["ため"],["に"],["、"],["すべて"],["の"],["人","ひと"],["を"],["不","ふ"],["従順","じゅうじゅん"],["の"],["なか"],["に"],["閉じ込めた","とじこめた"],["ので"],["ある"],["。"]]},{"verse":33,"text":"ああ深,ふかいかな、神,かみの知恵,ちえと知識,ちしきとの富,とみは。そのさばきは窮,きわめがたく、その道,みちは測,はかりがたい。","tok":[["ああ"],["深い","ふかい"],["か"],["な"],["、"],["神","かみ"],["の"],["知恵","ちえ"],["と"],["知識","ちしき"],["と"],["の"],["富","とみ"],["は"],["。"],["その"],["さばき"],["は"],["窮め","きわめ"],["がたく"],["、"],["その"],["道","みち"],["は"],["測り","はかり"],["がたい"],["。"]]},{"verse":34,"text":"「だれが、主,しゅの心,こころを知,しっていたか。だれが、主,しゅの計画,けいかくにあずかったか。","tok":[["「"],["だれ"],["が"],["、"],["主","しゅ"],["の"],["心","こころ"],["を"],["知って","しって"],["いた"],["か"],["。"],["だれ"],["が"],["、"],["主","しゅ"],["の"],["計画","けいかく"],["に"],["あずかった"],["か"],["。"]]},{"verse":35,"text":"また、だれが、まず主,しゅに与,あたえて、その報,むくいを受,うけるであろうか」。","tok":[["また"],["、"],["だれ"],["が"],["、"],["まず"],["主に","しゅに"],["与","あたえ"],["て"],["、"],["その"],["報い","むくい"],["を"],["受るで","うけるで"],["あろう"],["か"],["」"],["。"]]},{"verse":36,"text":"万物,ばんぶつは、神,かみからいで、神,かみによって成,なり、神,かみに帰,きするのである。栄光,えいこうがとこしえに神,かみにあるように、アァメン。","tok":[["万物","ばんぶつ"],["は"],["、"],["神","かみ"],["から"],["いで"],["、"],["神","かみ"],["によって"],["成り","なり"],["、"],["神","かみ"],["に"],["帰する","きする"],["ので"],["ある"],["。"],["栄光","えいこう"],["が"],["とこしえ"],["に"],["神","かみ"],["に"],["ある"],["よう"],["に"],["、"],["アァメン"],["。"]]}]
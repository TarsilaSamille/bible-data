[{"verse":1,"text":"すべての人,ひとは、上,うえに立,たつ権威,けんいに従,したがうべきである。なぜなら、神,かみによらない権威,けんいはなく、おおよそ存在,そんざいしている権威,けんいは、すべて神,かみによって立,たてられたものだからである。","tok":[["すべて"],["の"],["人","ひと"],["は"],["、"],["上","うえ"],["に"],["立つ","たつ"],["権威","けんい"],["に"],["従うべきで","したがうべきで"],["ある"],["。"],["なぜ"],["なら"],["、"],["神","かみ"],["に"],["よらない"],["権威","けんい"],["は"],["なく"],["、"],["おおよそ"],["存在","そんざい"],["して"],["いる"],["権威","けんい"],["は"],["、"],["すべて"],["神","かみ"],["によって"],["立られた","たてられた"],["もの"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":2,"text":"したがって、権威,けんいに逆,さからう者,ものは、神,かみの定,さだめにそむく者,ものである。そむく者,ものは、自分,じぶんの身,みにさばきを招,まねくことになる。","tok":[["したがって"],["、"],["権威","けんい"],["に"],["逆らう","さからう"],["者","もの"],["は"],["、"],["神","かみ"],["の"],["定め","さだめ"],["に"],["そむく"],["者","もの"],["で"],["ある"],["。"],["そむく"],["者","もの"],["は"],["、"],["自分","じぶん"],["の"],["身","み"],["に"],["さばき"],["を"],["招く","まねく"],["こと"],["に"],["なる"],["。"]]},{"verse":3,"text":"いったい、支配者,しはいしゃたちは、善事,ぜんじをする者,ものには恐怖,きょうふでなく、悪事,あくじをする者,ものにこそ恐怖,きょうふである。あなたは権威,けんいを恐,おそれないことを願,ねがうのか。それでは、善事,ぜんじをするがよい。そうすれば、彼,かれからほめられるであろう。","tok":[["いったい"],["、"],["支配者","しはいしゃ"],["たち"],["は"],["、"],["善事","ぜんじ"],["を"],["する"],["者","もの"],["に"],["は"],["恐怖","きょうふ"],["で"],["なく"],["、"],["悪事","あくじ"],["を"],["する"],["者","もの"],["に"],["こそ"],["恐怖","きょうふ"],["で"],["ある"],["。"],["あなた"],["は"],["権威","けんい"],["を"],["恐れない","おそれない"],["こと"],["を"],["願う","ねがう"],["の"],["か"],["。"],["それ"],["で"],["は"],["、"],["善事","ぜんじ"],["を"],["する"],["が"],["よい"],["。"],["そう"],["すれば"],["、"],["彼","かれ"],["から"],["ほめられるで"],["あろう"],["。"]]},{"verse":4,"text":"彼,かれは、あなたに益,えきを与,あたえるための神,かみの僕,しもべなのである。しかし、もしあなたが悪事,あくじをすれば、恐,おそれなければならない。彼,かれはいたずらに剣,けんを帯,おびているのではない。彼,かれは神,かみの僕,しもべであって、悪事,あくじを行,おこなう者,ものに対,たいしては、怒,いかりをもって報,むくいるからである。","tok":[["彼","かれ"],["は"],["、"],["あなた"],["に"],["益","えき"],["を"],["与える","あたえる"],["ため"],["の"],["神","かみ"],["の"],["僕","し"],["も"],["べ"],["な"],["ので"],["ある"],["。"],["しかし"],["、"],["もし"],["あなた"],["が"],["悪事","あくじ"],["を"],["すれば"],["、"],["恐れなければ","おそれなければ"],["ならない"],["。"],["彼","かれ"],["は"],["いたずら"],["に"],["剣","けん"],["を"],["帯","おび"],["て"],["いる"],["ので"],["は"],["ない"],["。"],["彼","かれ"],["は"],["神","かみ"],["の"],["僕","し"],["も"],["べ"],["で"],["あって"],["、"],["悪事","あくじ"],["を"],["行なう","おこなう"],["者","もの"],["に"],["対し","たいし"],["ては"],["、"],["怒り","いかり"],["を"],["もって"],["報いる","むくいる"],["から"],["で"],["ある"],["。"]]},{"verse":5,"text":"だから、ただ怒,いかりをのがれるためだけではなく、良心,りょうしんのためにも従,したがうべきである。","tok":[["だ"],["から"],["、"],["ただ"],["怒り","いかり"],["を"],["のがれる"],["ため"],["だけ"],["で"],["は"],["なく"],["、"],["良心","りょうしん"],["の"],["ため"],["に"],["も"],["従うべきで","したがうべきで"],["ある"],["。"]]},{"verse":6,"text":"あなたがたが貢,みつぎを納,おさめるのも、また同,おなじ理由,りゆうからである。彼,かれらは神,かみに仕,つかえる者,ものとして、もっぱらこの務,つとめに携,たずさわっているのである。","tok":[["あなた"],["がた"],["が"],["貢","みつぎ"],["を"],["納める","おさめる"],["の"],["も"],["、"],["また"],["同じ","おなじ"],["理由","りゆう"],["から"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["神","かみ"],["に"],["仕える","つかえる"],["者","もの"],["として"],["、"],["もっぱら"],["この"],["務め","つとめ"],["に"],["携わって","たずさわって"],["いる"],["ので"],["ある"],["。"]]},{"verse":7,"text":"あなたがたは、彼,かれらすべてに対,たいして、義務,ぎむを果,はたしなさい。すなわち、貢,みつぎを納,おさめむべき者,ものには貢,みつぎを納,おさめ、税,ぜいを納,おさめむべき者,ものには税,ぜいを納,おさめ、恐,おそるべき者,ものは恐,おそれ、敬,うやまうべき者,ものは敬,うやまいなさい。","tok":[["あなた"],["がた"],["は"],["、"],["彼","かれ"],["ら"],["すべて"],["に対して","にたいして"],["、"],["義務","ぎむ"],["を"],["果たし","はたし"],["なさい"],["。"],["すなわち"],["、"],["貢","みつぎ"],["を"],["納","おさめ"],["むべき"],["者","もの"],["に"],["は"],["貢","みつぎ"],["を"],["納","おさめ"],["、"],["税","ぜい"],["を"],["納","おさめ"],["むべき"],["者","もの"],["に"],["は"],["税","ぜい"],["を"],["納","おさめ"],["、"],["恐るべき","おそるべき"],["者","もの"],["は"],["恐","おそれ"],["、"],["敬うべき","うやまうべき"],["者","もの"],["は"],["敬い","うやまい"],["なさい"],["。"]]},{"verse":8,"text":"互,たがいに愛,あいし合,あうことの外,そとは、何人,なにびとにも借,かりがあってはならない。人,ひとを愛,あいする者,ものは、律法,りっぽうを全,まっとうするのである。","tok":[["互","たがい"],["に"],["愛し合う","あいしあう"],["こと"],["の"],["外","そと"],["は"],["、"],["何人","な"],["に"],["びと"],["に"],["も"],["借","かり"],["が"],["あって"],["は"],["ならない"],["。"],["人","ひと"],["を"],["愛する","あいする"],["者","もの"],["は"],["、"],["律法","りっぽう"],["を"],["全う","まっとう"],["する"],["ので"],["ある"],["。"]]},{"verse":9,"text":"「姦淫,かんいんするな、殺,ころすな、盗,ぬすむな、むさぼるな」など、そのほかに、どんな戒,いましめがあっても、結局,けっきょく「自分,じぶんを愛,あいするようにあなたの隣,となり人,ひとを愛,あいせよ」というこの言葉,ことばに帰,きする。","tok":[["「"],["姦淫","かんいん"],["する"],["な"],["、"],["殺ろす","ころす"],["な"],["、"],["盗む","ぬすむ"],["な"],["、"],["むさぼる"],["な"],["」"],["など"],["、"],["その"],["ほか"],["に"],["、"],["どんな"],["戒しめ","いましめ"],["が"],["あって"],["も"],["、"],["結局","けっきょく"],["「"],["自分","じぶん"],["を"],["愛する","あいする"],["よう"],["に"],["あなた"],["の"],["隣人","となりひと"],["を"],["愛せよ","あいせよ"],["」"],["と"],["いう"],["この"],["言葉","ことば"],["に"],["帰する","きする"],["。"]]},{"verse":10,"text":"愛,あいは隣,となり人,ひとに害,がいを加,くわえることはない。だから、愛,あいは律法,りっぽうを完成,かんせいするものである。","tok":[["愛","あい"],["は"],["隣人","となりひと"],["に"],["害","がい"],["を"],["加える","くわえる"],["こと"],["は"],["ない"],["。"],["だ"],["から"],["、"],["愛","あい"],["は"],["律法","りっぽう"],["を"],["完成","かんせい"],["する"],["もの"],["で"],["ある"],["。"]]},{"verse":11,"text":"なお、あなたがたは時,ときを知,しっているのだから、特,とくに、この事,ことを励,はげまねばならない。すなわち、あなたがたの眠,ねむりからさめるべき時,ときが、すでにきている。なぜなら今,いまは、わたしたちの救,すくいが、初,はじめ信,しんじた時,ときよりも、もっと近,ちかづいているからである。","tok":[["なお"],["、"],["あなた"],["がた"],["は"],["時","とき"],["を"],["知って","しって"],["いる"],["の"],["だ"],["から"],["、"],["特に","とくに"],["、"],["この"],["事","こと"],["を"],["励まねば","はげまねば"],["ならない"],["。"],["すなわち"],["、"],["あなた"],["がた"],["の"],["眠","ねむり"],["から"],["さめるべき"],["時","とき"],["が"],["、"],["すでに"],["きて"],["いる"],["。"],["なぜ"],["なら"],["今","いま"],["は"],["、"],["わたしたち"],["の"],["救い","すくい"],["が"],["、"],["初め","はじめ"],["信じた","しんじた"],["時","とき"],["より"],["も"],["、"],["もっと"],["近づいて","ちかづいて"],["いる"],["から"],["で"],["ある"],["。"]]},{"verse":12,"text":"夜,よはふけ、日,ひが近,ちかづいている。それだから、わたしたちは、やみのわざを捨,すてて、光,ひかりの武具,ぶぐを着,つけようではないか。","tok":[["夜","よ"],["は"],["ふけ"],["、"],["日","ひ"],["が"],["近づいて","ちかづいて"],["いる"],["。"],["それ"],["だ"],["から"],["、"],["わたしたち"],["は"],["、"],["やみ"],["の"],["わざ"],["を"],["捨てて","すてて"],["、"],["光","ひかり"],["の"],["武具","ぶぐ"],["を"],["着けようで","つけようで"],["は"],["ない"],["か"],["。"]]},{"verse":13,"text":"そして、宴楽,えんらくと泥酔,でいすい、淫乱,いんらんと好色,こうしょく、争,あらそいとねたみを捨,すてて、昼,ひる歩,あるくように、つつましく歩,あるこうではないか。","tok":[["そして"],["、"],["宴楽","えんらく"],["と"],["泥酔","でいすい"],["、"],["淫乱","いんらん"],["と"],["好色","こうしょく"],["、"],["争い","あらそい"],["と"],["ねたみ"],["を"],["捨てて","すてて"],["、"],["昼","ひる"],["歩く","あるく"],["よう"],["に"],["、"],["つつましく"],["歩こうで","あるこうで"],["は"],["ない"],["か"],["。"]]},{"verse":14,"text":"あなたがたは、主,しゅイエス・キリストを着,きなさい。肉,にくの欲,よくを満,みたすことに心,こころを向,むけてはならない。","tok":[["あなた"],["がた"],["は"],["、"],["主","しゅ"],["イエス"],["・"],["キリスト"],["を"],["着","き"],["なさい"],["。"],["肉","にく"],["の"],["欲","よく"],["を"],["満たす","みたす"],["こと"],["に"],["心","こころ"],["を"],["向けて","むけて"],["は"],["ならない"],["。"]]}]
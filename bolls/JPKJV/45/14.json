[{"verse":1,"text":"信仰,しんこうの弱,よわい者,ものを受,うけいれなさい。ただ、意見,いけんを批評,ひひょうするためであってはならない。","tok":[["信仰","しんこう"],["の"],["弱い","よわい"],["者","もの"],["を"],["受","うけ"],["いれ"],["なさい"],["。"],["ただ"],["、"],["意見","いけん"],["を"],["批評","ひひょう"],["する"],["ため"],["で"],["あって"],["は"],["ならない"],["。"]]},{"verse":2,"text":"ある人,ひとは、何,なにを食,たべてもさしつかえないと信,しんじているが、弱,よわい人,ひとは野菜,やさいだけを食,たべる。","tok":[["ある"],["人","ひと"],["は"],["、"],["何に","なに"],["を"],["食べて","たべて"],["も"],["さしつかえない"],["と"],["信じて","しんじて"],["いる"],["が"],["、"],["弱い","よわい"],["人","ひと"],["は"],["野菜","やさい"],["だけ"],["を"],["食べる","たべる"],["。"]]},{"verse":3,"text":"食,たべる者,ものは食,たべない者,ものを軽,かろんじてはならず、食,たべない者,ものも食,たべる者,ものをさばいてはならない。神,かみは彼,かれを受,うけいれて下,くださったのであるから。","tok":[["食べる","たべる"],["者","もの"],["は"],["食べない","たべない"],["者","もの"],["を"],["軽","かろんじて"],["は"],["ならず"],["、"],["食べない","たべない"],["者","もの"],["も"],["食べる","たべる"],["者","もの"],["を"],["さばいて"],["は"],["ならない"],["。"],["神","かみ"],["は"],["彼","かれ"],["を"],["受","うけ"],["いれて"],["下さった","くださった"],["ので"],["ある"],["から"],["。"]]},{"verse":4,"text":"他人,たにんの僕,しもべをさばくあなたは、いったい、何者,なにものであるか。彼,かれが立,たつのも倒,たおれるのも、その主人,しゅじんによるのである。しかし、彼,かれは立,たつようになる。主,しゅは彼,かれを立,たたせることができるからである。","tok":[["他人","たにん"],["の"],["僕","し"],["も"],["べ"],["を"],["さばく"],["あなた"],["は"],["、"],["いったい"],["、"],["何者","なにもの"],["で"],["ある"],["か"],["。"],["彼","かれ"],["が"],["立つ","たつ"],["の"],["も"],["倒れる","たおれる"],["の"],["も"],["、"],["その"],["主人","しゅじん"],["に"],["よる"],["ので"],["ある"],["。"],["しかし"],["、"],["彼","かれ"],["は"],["立つ","たつ"],["よう"],["に"],["なる"],["。"],["主","しゅ"],["は"],["彼","かれ"],["を"],["立たせる","たたせる"],["こと"],["が"],["できる"],["から"],["で"],["ある"],["。"]]},{"verse":5,"text":"また、ある人,ひとは、この日,ひがかの日,ひよりも大事,だいじであると考,かんがえ、ほかの人,ひとはどの日,ひも同,おなじだと考,かんがえる。各自,かくじはそれぞれ心,こころの中,なかで、確信,かくしんを持,もっておるべきである。","tok":[["また"],["、"],["ある"],["人","ひと"],["は"],["、"],["この"],["日","ひ"],["が"],["かの"],["日","ひ"],["より"],["も"],["大事","だいじ"],["で"],["ある"],["と"],["考","かんがえ"],["、"],["ほか"],["の"],["人","ひと"],["は"],["どの"],["日","ひ"],["も"],["同じ","おなじ"],["だ"],["と"],["考","かんがえ"],["る"],["。"],["各自","かくじ"],["は"],["それぞれ"],["心","こころ"],["の"],["中","なか"],["で"],["、"],["確信","かくしん"],["を"],["持って","もって"],["おるべきで"],["ある"],["。"]]},{"verse":6,"text":"日,ひを重,おもんじる者,ものは、主,しゅのために重,おもんじる。また食,たべる者,ものも主,しゅのために食,たべる。神,かみに感謝,かんしゃして食,たべるからである。食,たべない者,ものも主,しゅのために食,たべない。そして、神,かみに感謝,かんしゃする。","tok":[["日","ひ"],["を"],["重じる","おもんじる"],["者","もの"],["は"],["、"],["主","しゅ"],["の"],["ため"],["に"],["重じる","おもんじる"],["。"],["また"],["食べる","たべる"],["者","もの"],["も"],["主","しゅ"],["の"],["ため"],["に"],["食べる","たべる"],["。"],["神","かみ"],["に"],["感謝","かんしゃ"],["して"],["食べる","たべる"],["から"],["で"],["ある"],["。"],["食べない","たべない"],["者","もの"],["も"],["主","しゅ"],["の"],["ため"],["に"],["食べない","たべない"],["。"],["そして"],["、"],["神","かみ"],["に"],["感謝","かんしゃ"],["する"],["。"]]},{"verse":7,"text":"すなわち、わたしたちのうち、だれひとり自分,じぶんのために生,いきる者,ものはなく、だれひとり自分,じぶんのために死,しぬ者,ものはない。","tok":[["すなわち"],["、"],["わたしたち"],["の"],["うち"],["、"],["だれ"],["ひとり"],["自分","じぶん"],["の"],["ため"],["に"],["生きる","いきる"],["者","もの"],["は"],["なく"],["、"],["だれ"],["ひとり"],["自分","じぶん"],["の"],["ため"],["に"],["死ぬ","しぬ"],["者","もの"],["は"],["ない"],["。"]]},{"verse":8,"text":"わたしたちは、生,いきるのも主,しゅのために生,いき、死,しぬのも主,しゅのために死,しぬ。だから、生,いきるにしても死,しぬにしても、わたしたちは主,しゅのものなのである。","tok":[["わたしたち"],["は"],["、"],["生きる","いきる"],["の"],["も"],["主","しゅ"],["の"],["ため"],["に"],["生き","いき"],["、"],["死ぬ","しぬ"],["の"],["も"],["主","しゅ"],["の"],["ため"],["に"],["死ぬ","しぬ"],["。"],["だ"],["から"],["、"],["生きる","いきる"],["に"],["して"],["も"],["死ぬ","しぬ"],["に"],["して"],["も"],["、"],["わたしたち"],["は"],["主","しゅ"],["の"],["もの"],["な"],["ので"],["ある"],["。"]]},{"verse":9,"text":"なぜなら、キリストは、死者,ししゃと生者,せいしゃとの主,しゅとなるために、死,しんで生,いき返,かえられたからである。","tok":[["なぜ"],["なら"],["、"],["キリスト"],["は"],["、"],["死者","ししゃ"],["と"],["生者","せいしゃと"],["の"],["主","しゅ"],["と"],["なる"],["ため"],["に"],["、"],["死んで","しんで"],["生き返られた","いきかえられた"],["から"],["で"],["ある"],["。"]]},{"verse":10,"text":"それだのに、あなたは、なぜ兄弟,きょうだいをさばくのか。あなたは、なぜ兄弟,きょうだいを軽,かろんじるのか。わたしたちはみな、神,かみのさばきの座,ざの前,まえに立,たつのである。","tok":[["それ"],["だ"],["のに"],["、"],["あなた"],["は"],["、"],["なぜ"],["兄弟","きょうだい"],["を"],["さばく"],["の"],["か"],["。"],["あなた"],["は"],["、"],["なぜ"],["兄弟","きょうだい"],["を"],["軽","かろんじる"],["の"],["か"],["。"],["わたしたち"],["は"],["みな"],["、"],["神","かみ"],["の"],["さばき"],["の"],["座","ざ"],["の"],["前","まえ"],["に"],["立つ","たつ"],["ので"],["ある"],["。"]]},{"verse":11,"text":"すなわち、「主,しゅが言,いわれる。わたしは生,いきている。すべてのひざは、わたしに対,たいしてかがみ、すべての舌,したは、神,かみにさんびをささげるであろう」と書,かいてある。","tok":[["すなわち"],["、"],["「"],["主","しゅ"],["が"],["言われる","いわれる"],["。"],["わたし"],["は"],["生きて","いきて"],["いる"],["。"],["すべて"],["の"],["ひざ"],["は"],["、"],["わたし"],["に対して","にたいして"],["かがみ"],["、"],["すべて"],["の"],["舌","した"],["は"],["、"],["神","かみ"],["に"],["さん"],["び"],["を"],["ささげるで"],["あろう"],["」"],["と"],["書いて","かいて"],["ある"],["。"]]},{"verse":12,"text":"だから、わたしたちひとりびとりは、神,かみに対,たいして自分,じぶんの言,いいひらきをすべきである。","tok":[["だ"],["から"],["、"],["わたしたち"],["ひとりびとり"],["は"],["、"],["神","かみ"],["に対して","にたいして"],["自分","じぶん"],["の"],["言い","いい"],["ひらき"],["を"],["すべきで"],["ある"],["。"]]},{"verse":13,"text":"それゆえ、今後,こんごわたしたちは、互,たがいにさばき合,あうことをやめよう。むしろ、あなたがたは、妨,さまたげとなる物,ものや、つまずきとなる物,ものを兄弟,きょうだいの前,まえに置,おかないことに、決,きめるがよい。","tok":[["それ"],["ゆえ"],["、"],["今後","こんご"],["わたしたち"],["は"],["、"],["互","たがい"],["に"],["さばき"],["合う","あう"],["こと"],["を"],["やめよう"],["。"],["むしろ"],["、"],["あなた"],["がた"],["は"],["、"],["妨げ","さまたげ"],["と"],["なる"],["物","もの"],["や"],["、"],["つまずき"],["と"],["なる"],["物","もの"],["を"],["兄弟","きょうだい"],["の"],["前","まえ"],["に"],["置かない","おかない"],["こと"],["に"],["、"],["決める","きめる"],["が"],["よい"],["。"]]},{"verse":14,"text":"わたしは、主,しゅイエスにあって知,しりかつ確信,かくしんしている。それ自体,じたい、汚,けがれているものは一つもない。ただ、それが汚,けがれていると考,かんがえる人,ひとにだけ、汚,けがれているのである。","tok":[["わたし"],["は"],["、"],["主","しゅ"],["イエス"],["に"],["あって"],["知り","しり"],["かつ"],["確信","かくしん"],["して"],["いる"],["。"],["それ"],["自体","じたい"],["、"],["汚","け"],["がれ"],["て"],["いる"],["もの"],["は"],["一","ひと"],["つ"],["も"],["ない"],["。"],["ただ"],["、"],["それ"],["が"],["汚","け"],["がれ"],["て"],["いる"],["と"],["考","かんがえ"],["る"],["人","ひと"],["に"],["だけ"],["、"],["汚","け"],["がれ"],["て"],["いる"],["ので"],["ある"],["。"]]},{"verse":15,"text":"もし食物,しょくもつのゆえに兄弟,きょうだいを苦,くるしめるなら、あなたは、もはや愛,あいによって歩,あるいているのではない。あなたの食物,しょくもつによって、兄弟,きょうだいを滅,ほろぼしてはならない。キリストは彼,かれのためにも、死,しなれたのである。","tok":[["もし"],["食物","しょくもつ"],["の"],["ゆえ"],["に"],["兄弟","きょうだい"],["を"],["苦しめるなら","くるしめるなら"],["、"],["あなた"],["は"],["、"],["もはや"],["愛","あい"],["によって"],["歩いて","あるいて"],["いる"],["ので"],["は"],["ない"],["。"],["あなた"],["の"],["食物","しょくもつ"],["によって"],["、"],["兄弟","きょうだい"],["を"],["滅ぼして","ほろぼして"],["は"],["ならない"],["。"],["キリスト"],["は"],["彼","かれ"],["の"],["ため"],["に"],["も"],["、"],["死なれた","しなれた"],["ので"],["ある"],["。"]]},{"verse":16,"text":"それだから、あなたがたにとって良,よい事,ことが、そしりの種,たねにならぬようにしなさい。","tok":[["それ"],["だ"],["から"],["、"],["あなた"],["がた"],["にとって"],["良い","よい"],["事","こと"],["が"],["、"],["そしり"],["の"],["種","たね"],["に"],["ならぬ"],["よう"],["に"],["し"],["なさい"],["。"]]},{"verse":17,"text":"神,かみの国,くには飲食,いんしょくではなく、義,ぎと、平和,へいわと、聖霊,せいれいにおける喜,よろこびとである。","tok":[["神","かみ"],["の"],["国","くに"],["は"],["飲食","いんしょく"],["で"],["は"],["なく"],["、"],["義","ぎ"],["と"],["、"],["平和","へいわ"],["と"],["、"],["聖霊","せいれい"],["に"],["おける"],["喜こび","よろこび"],["と"],["で"],["ある"],["。"]]},{"verse":18,"text":"こうしてキリストに仕,つかえる者,ものは、神,かみに喜,よろこばれ、かつ、人,ひとにも受,うけいれられるのである。","tok":[["こう"],["して"],["キリスト"],["に"],["仕える","つかえる"],["者","もの"],["は"],["、"],["神","かみ"],["に"],["喜こばれ","よろこばれ"],["、"],["かつ"],["、"],["人","ひと"],["に"],["も"],["受","うけ"],["いれられる"],["ので"],["ある"],["。"]]},{"verse":19,"text":"こういうわけで、平和,へいわに役立,やくだつことや、互,たがいの徳,とくを高,たかめることを、追,おい求,もとめようではないか。","tok":[["こう"],["いう"],["わけ"],["で"],["、"],["平和","へいわ"],["に"],["役立つ","やくだつ"],["こと"],["や"],["、"],["互","たがい"],["の"],["徳","とく"],["を"],["高める","たかめる"],["こと"],["を"],["、"],["追い求めようで","おいもとめようで"],["は"],["ない"],["か"],["。"]]},{"verse":20,"text":"食物,しょくもつのことで、神,かみのみわざを破壊,はかいしてはならない。すべての物,ものはきよい。ただ、それを食,たべて人,ひとをつまずかせる者,ものには、悪,あくとなる。","tok":[["食物","しょくもつ"],["の"],["こと"],["で"],["、"],["神","かみ"],["のみ"],["わざ"],["を"],["破壊","はかい"],["して"],["は"],["ならない"],["。"],["すべて"],["の"],["物","もの"],["は"],["きよい"],["。"],["ただ"],["、"],["それ"],["を"],["食べて","たべて"],["人","ひと"],["を"],["つまずかせる"],["者","もの"],["に"],["は"],["、"],["悪","あく"],["と"],["なる"],["。"]]},{"verse":21,"text":"肉,にくを食,くわず、酒,さけを飲,のまず、そのほか兄弟,きょうだいをつまずかせないのは、良,よいことである。","tok":[["肉","にく"],["を"],["食わず","くわず"],["、"],["酒","さけ"],["を"],["飲まず","のまず"],["、"],["その"],["ほか"],["兄弟","きょうだい"],["を"],["つまずかせない"],["の"],["は"],["、"],["良い","よい"],["こと"],["で"],["ある"],["。"]]},{"verse":22,"text":"あなたの持,もっている信仰,しんこうを、神,かみのみまえに、自分,じぶん自身,じしんに持,もっていなさい。自,みずから良,よいと定,さだめたことについて、やましいと思,おもわない人,ひとは、さいわいである。","tok":[["あなた"],["の"],["持って","もって"],["いる"],["信仰","しんこう"],["を"],["、"],["神","かみ"],["のみ"],["まえ"],["に"],["、"],["自分","じぶん"],["自身","じしん"],["に"],["持って","もって"],["い"],["なさい"],["。"],["自から","みずから"],["良い","よい"],["と"],["定めた","さだめた"],["こと"],["について"],["、"],["やましい"],["と"],["思わない","おもわない"],["人","ひと"],["は"],["、"],["さいわい"],["で"],["ある"],["。"]]},{"verse":23,"text":"しかし、疑,うたがいながら食,たべる者,ものは、信仰,しんこうによらないから、罪,つみに定,さだめられる。すべて信仰,しんこうによらないことは、罪,つみである。","tok":[["しかし"],["、"],["疑がい","うたがい"],["ながら"],["食べる","たべる"],["者","もの"],["は"],["、"],["信仰","しんこう"],["に"],["よらない"],["から"],["、"],["罪","つみ"],["に"],["定められる","さだめられる"],["。"],["すべて"],["信仰","しんこう"],["に"],["よらない"],["こと"],["は"],["、"],["罪","つみ"],["で"],["ある"],["。"]]}]
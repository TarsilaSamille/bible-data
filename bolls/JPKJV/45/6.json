[{"verse":1,"text":"では、わたしたちは、なんと言,いおうか。恵,めぐみが増,まし加,くわわるために、罪,つみにとどまるべきであろうか。","tok":[["で"],["は"],["、"],["わたしたち"],["は"],["、"],["なん"],["と"],["言おう","いおう"],["か"],["。"],["恵","めぐみ"],["が"],["増し","まし"],["加わわる","くわわる"],["ため"],["に"],["、"],["罪","つみ"],["に"],["とどまるべきで"],["あろう"],["か"],["。"]]},{"verse":2,"text":"断,だんじてそうではない。罪,つみに対,たいして死,しんだわたしたちが、どうして、なお、その中,なかに生,いきておれるだろうか。","tok":[["断じて","だんじて"],["そう"],["で"],["は"],["ない"],["。"],["罪","つみ"],["に対して","にたいして"],["死んだ","しんだ"],["わたしたち"],["が"],["、"],["どう"],["して"],["、"],["なお"],["、"],["その"],["中","なか"],["に"],["生きて","いきて"],["おれるだろう"],["か"],["。"]]},{"verse":3,"text":"それとも、あなたがたは知,しらないのか。キリスト・イエスにあずかるバプテスマを受,うけたわたしたちは、彼,かれの死,しにあずかるバプテスマを受,うけたのである。","tok":[["それ"],["と"],["も"],["、"],["あなた"],["がた"],["は"],["知らない","しらない"],["の"],["か"],["。"],["キリスト"],["・"],["イエス"],["に"],["あずかる"],["バプテスマ"],["を"],["受た","うけた"],["わたしたち"],["は"],["、"],["彼","かれ"],["の"],["死","し"],["に"],["あずかる"],["バプテスマ"],["を"],["受た","うけた"],["ので"],["ある"],["。"]]},{"verse":4,"text":"すなわち、わたしたちは、その死,しにあずかるバプテスマによって、彼,かれと共,ともに葬,ほうむられたのである。それは、キリストが父,ちちの栄光,えいこうによって、死人,しにんの中,なかからよみがえらされたように、わたしたちもまた、新,あたらしいいのちに生,いきるためである。","tok":[["すなわち"],["、"],["わたしたち"],["は"],["、"],["その"],["死","し"],["に"],["あずかる"],["バプテスマ"],["によって"],["、"],["彼","かれ"],["と"],["共","とも"],["に"],["葬むられた","ほうむられた"],["ので"],["ある"],["。"],["それ"],["は"],["、"],["キリスト"],["が"],["父","ちち"],["の"],["栄光","えいこう"],["によって"],["、"],["死人","しにん"],["の"],["中","なか"],["から"],["よみがえらされた"],["よう"],["に"],["、"],["わたしたち"],["も"],["また"],["、"],["新らしい","あたらしい"],["いのち"],["に"],["生きる","いきる"],["ため"],["で"],["ある"],["。"]]},{"verse":5,"text":"もしわたしたちが、彼,かれに結,むすびついてその死,しの様,さまにひとしくなるなら、さらに、彼,かれの復活,ふっかつの様,さまにもひとしくなるであろう。","tok":[["もし"],["わたしたち"],["が"],["、"],["彼","かれ"],["に"],["結びついて","むすびついて"],["その"],["死","し"],["の"],["様","さま"],["に"],["ひとしく"],["なるなら"],["、"],["さらに"],["、"],["彼","かれ"],["の"],["復活","ふっかつ"],["の"],["様","さま"],["に"],["も"],["ひとしく"],["なるで"],["あろう"],["。"]]},{"verse":6,"text":"わたしたちは、この事,ことを知,しっている。わたしたちの内,うちの古,ふるき人,ひとはキリストと共,ともに十字架,じゅうじかにつけられた。それは、この罪,つみのからだが滅,ほろび、わたしたちがもはや、罪,つみの奴隷,どれいとなることがないためである。","tok":[["わたしたち"],["は"],["、"],["この"],["事","こと"],["を"],["知って","しって"],["いる"],["。"],["わたしたち"],["の"],["内","うち"],["の"],["古き","ふるき"],["人","ひと"],["は"],["キリスト"],["と"],["共","とも"],["に"],["十字架","じゅうじか"],["に"],["つけられた"],["。"],["それ"],["は"],["、"],["この"],["罪","つみ"],["の"],["からだ"],["が"],["滅び","ほろび"],["、"],["わたしたち"],["が"],["もはや"],["、"],["罪","つみ"],["の"],["奴隷","どれい"],["と"],["なる"],["こと"],["が"],["ない"],["ため"],["で"],["ある"],["。"]]},{"verse":7,"text":"それは、すでに死,しんだ者,ものは、罪,つみから解放,かいほうされているからである。","tok":[["それ"],["は"],["、"],["すでに"],["死んだ","しんだ"],["者","もの"],["は"],["、"],["罪","つみ"],["から"],["解放","かいほう"],["されて"],["いる"],["から"],["で"],["ある"],["。"]]},{"verse":8,"text":"もしわたしたちが、キリストと共,ともに死,しんだなら、また彼,かれと共,ともに生,いきることを信,しんじる。","tok":[["もし"],["わたしたち"],["が"],["、"],["キリスト"],["と"],["共","とも"],["に"],["死んだなら","しんだなら"],["、"],["また"],["彼","かれ"],["と"],["共","とも"],["に"],["生きる","いきる"],["こと"],["を"],["信じる","しんじる"],["。"]]},{"verse":9,"text":"キリストは死人,しにんの中,なかからよみがえらされて、もはや死,しぬことがなく、死,しはもはや彼,かれを支配,しはいしないことを、知,しっているからである。","tok":[["キリスト"],["は"],["死人","しにん"],["の"],["中","なか"],["から"],["よみがえらされて"],["、"],["もはや"],["死ぬ","しぬ"],["こと"],["が"],["なく"],["、"],["死","し"],["は"],["もはや"],["彼","かれ"],["を"],["支配","しはい"],["しない"],["こと"],["を"],["、"],["知って","しって"],["いる"],["から"],["で"],["ある"],["。"]]},{"verse":10,"text":"なぜなら、キリストが死,しんだのは、ただ一度,ど罪,つみに対,たいして死,しんだのであり、キリストが生,いきるのは、神,かみに生,いきるのだからである。","tok":[["なぜ"],["なら"],["、"],["キリスト"],["が"],["死んだ","しんだ"],["の"],["は"],["、"],["ただ"],["一度","ど"],["罪","つみ"],["に対して","にたいして"],["死んだ","しんだ"],["ので"],["あり"],["、"],["キリスト"],["が"],["生きる","いきる"],["の"],["は"],["、"],["神","かみ"],["に"],["生きる","いきる"],["の"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":11,"text":"このように、あなたがた自身,じしんも、罪,つみに対,たいして死,しんだ者,ものであり、キリスト・イエスにあって神,かみに生,いきている者,ものであることを、認,みとむべきである。","tok":[["この"],["よう"],["に"],["、"],["あなた"],["がた"],["自身","じしん"],["も"],["、"],["罪","つみ"],["に対して","にたいして"],["死んだ","しんだ"],["者","もの"],["で"],["あり"],["、"],["キリスト"],["・"],["イエス"],["に"],["あって"],["神","かみ"],["に"],["生きて","いきて"],["いる"],["者","もの"],["で"],["ある"],["こと"],["を"],["、"],["認","み"],["とむべきで"],["ある"],["。"]]},{"verse":12,"text":"だから、あなたがたの死,しぬべきからだを罪,つみの支配,しはいにゆだねて、その情欲,じょうよくに従,したがわせることをせず、","tok":[["だ"],["から"],["、"],["あなた"],["がた"],["の"],["死ぬべき","しぬべき"],["からだ"],["を"],["罪","つみ"],["の"],["支配","しはい"],["に"],["ゆだねて"],["、"],["その"],["情欲","じょうよく"],["に"],["従わせる","したがわせる"],["こと"],["を"],["せず"],["、"]]},{"verse":13,"text":"また、あなたがたの肢体,したいを不義,ふぎの武器,ぶきとして罪,つみにささげてはならない。むしろ、死人,しにんの中,なかから生,いかされた者,ものとして、自分,じぶん自身,じしんを神,かみにささげ、自分,じぶんの肢体,したいを義,ぎの武器,ぶきとして神,かみにささげるがよい。","tok":[["また"],["、"],["あなた"],["がた"],["の"],["肢体","したい"],["を"],["不義","ふぎ"],["の"],["武器","ぶき"],["として"],["罪","つみ"],["に"],["ささげて"],["は"],["ならない"],["。"],["むしろ"],["、"],["死人","しにん"],["の"],["中","なか"],["から"],["生かされた","いかされた"],["者","もの"],["として"],["、"],["自分","じぶん"],["自身","じしん"],["を"],["神","かみ"],["に"],["ささげ"],["、"],["自分","じぶん"],["の"],["肢体","したい"],["を"],["義","ぎ"],["の"],["武器","ぶき"],["として"],["神","かみ"],["に"],["ささげる"],["が"],["よい"],["。"]]},{"verse":14,"text":"なぜなら、あなたがたは律法,りっぽうの下,もとにあるのではなく、恵,めぐみの下,もとにあるので、罪,つみに支配,しはいされることはないからである。","tok":[["なぜ"],["なら"],["、"],["あなた"],["がた"],["は"],["律法","りっぽう"],["の"],["下","もと"],["に"],["ある"],["ので"],["は"],["なく"],["、"],["恵","めぐみ"],["の"],["下","もと"],["に"],["ある"],["ので"],["、"],["罪","つみ"],["に"],["支配","しはい"],["される"],["こと"],["は"],["ない"],["から"],["で"],["ある"],["。"]]},{"verse":15,"text":"それでは、どうなのか。律法,りっぽうの下,もとにではなく、恵,めぐみの下,もとにあるからといって、わたしたちは罪,つみを犯,おかすべきであろうか。断,だんじてそうではない。","tok":[["それ"],["で"],["は"],["、"],["どう"],["な"],["の"],["か"],["。"],["律法","りっぽう"],["の"],["下","もと"],["に"],["で"],["は"],["なく"],["、"],["恵","めぐみ"],["の"],["下","もと"],["に"],["ある"],["から"],["と"],["いって"],["、"],["わたしたち"],["は"],["罪","つみ"],["を"],["犯すべきで","おかすべきで"],["あろう"],["か"],["。"],["断じて","だんじて"],["そう"],["で"],["は"],["ない"],["。"]]},{"verse":16,"text":"あなたがたは知,しらないのか。あなたがた自身,じしんが、だれかの僕,しもべになって服従,ふくじゅうするなら、あなたがたは自分,じぶんの服従,ふくじゅうするその者,ものの僕,しもべであって、死,しに至,いたる罪,つみの僕,しもべともなり、あるいは、義,ぎにいたる従順,じゅうじゅんの僕,しもべともなるのである。","tok":[["あなた"],["がた"],["は"],["知らない","しらない"],["の"],["か"],["。"],["あなた"],["がた"],["自身","じしん"],["が"],["、"],["だれ"],["か"],["の"],["僕","し"],["も"],["べ"],["に"],["なって"],["服従","ふくじゅう"],["するなら"],["、"],["あなた"],["がた"],["は"],["自分","じぶん"],["の"],["服従","ふくじゅう"],["する"],["その"],["者","もの"],["の"],["僕","し"],["も"],["べ"],["で"],["あって"],["、"],["死","し"],["に"],["至る","いたる"],["罪","つみ"],["の"],["僕","し"],["も"],["べと"],["も"],["なり"],["、"],["あるいは"],["、"],["義","ぎ"],["に"],["いたる"],["従順","じゅうじゅん"],["の"],["僕","し"],["も"],["べと"],["も"],["なる"],["ので"],["ある"],["。"]]},{"verse":17,"text":"しかし、神,かみは感謝,かんしゃすべきかな。あなたがたは罪,つみの僕,しもべであったが、伝,つたえられた教,おしえの基準,きじゅんに心,こころから服従,ふくじゅうして、","tok":[["しかし"],["、"],["神","かみ"],["は"],["感謝","かんしゃ"],["すべき"],["か"],["な"],["。"],["あなた"],["がた"],["は"],["罪","つみ"],["の"],["僕","し"],["も"],["べ"],["で"],["あった"],["が"],["、"],["伝えられた","つたえられた"],["教え","おしえ"],["の"],["基準","きじゅん"],["に"],["心","こころ"],["から"],["服従","ふくじゅう"],["して"],["、"]]},{"verse":18,"text":"罪,つみから解放,かいほうされ、義,ぎの僕,しもべとなった。","tok":[["罪","つみ"],["から"],["解放","かいほう"],["され"],["、"],["義","ぎ"],["の"],["僕","し"],["も"],["べ"],["と"],["なった"],["。"]]},{"verse":19,"text":"わたしは人間,にんげん的,てきな言,いい方,かたをするが、それは、あなたがたの肉,にくの弱,よわさのゆえである。あなたがたは、かつて自分,じぶんの肢体,したいを汚,けがれと不法,ふほうとの僕,しもべとしてささげて不法,ふほうに陥,おちいったように、今,いまや自分,じぶんの肢体,したいを義,ぎの僕,しもべとしてささげて、きよくならねばならない。","tok":[["わたし"],["は"],["人間的","にんげんてき"],["な"],["言い方","いいかた"],["を"],["する"],["が"],["、"],["それ"],["は"],["、"],["あなた"],["がた"],["の"],["肉","にく"],["の"],["弱","よわ"],["さ"],["の"],["ゆえ"],["で"],["ある"],["。"],["あなた"],["がた"],["は"],["、"],["かつて"],["自分","じぶん"],["の"],["肢体","したい"],["を"],["汚","けがれ"],["と"],["不法","ふほう"],["と"],["の"],["僕","し"],["も"],["べと"],["して"],["ささげて"],["不法","ふほう"],["に"],["陥た","おちいった"],["よう"],["に"],["、"],["今","いま"],["や"],["自分","じぶん"],["の"],["肢体","したい"],["を"],["義","ぎ"],["の"],["僕","し"],["も"],["べと"],["して"],["ささげて"],["、"],["きよく"],["ならねば"],["ならない"],["。"]]},{"verse":20,"text":"あなたがたが罪,つみの僕,しもべであった時,ときは、義,ぎとは縁,えんのない者,ものであった。","tok":[["あなた"],["がた"],["が"],["罪","つみ"],["の"],["僕","し"],["も"],["べ"],["で"],["あった"],["時","とき"],["は"],["、"],["義","ぎ"],["と"],["は"],["縁","えん"],["の"],["ない"],["者","もの"],["で"],["あった"],["。"]]},{"verse":21,"text":"その時,ときあなたがたは、どんな実,みを結,むすんだのか。それは、今,いまでは恥,はじとするようなものであった。それらのものの終極,しゅうきょくは、死,しである。","tok":[["その"],["時","とき"],["あなた"],["がた"],["は"],["、"],["どんな"],["実","み"],["を"],["結","むすんだ"],["の"],["か"],["。"],["それ"],["は"],["、"],["今","いま"],["で"],["は"],["恥","はじ"],["と"],["する"],["よう"],["な"],["もの"],["で"],["あった"],["。"],["それ"],["ら"],["の"],["もの"],["の"],["終極","しゅうきょく"],["は"],["、"],["死","し"],["で"],["ある"],["。"]]},{"verse":22,"text":"しかし今,いまや、あなたがたは罪,つみから解放,かいほうされて神,かみに仕,つかえ、きよきに至,いたる実,みを結,むすんでいる。その終極,しゅうきょくは永遠,えいえんのいのちである。","tok":[["しかし"],["今","いま"],["や"],["、"],["あなた"],["がた"],["は"],["罪","つみ"],["から"],["解放","かいほう"],["されて"],["神","かみ"],["に"],["仕え","つかえ"],["、"],["きよ"],["きに"],["至る","いたる"],["実","み"],["を"],["結んで","むすんで"],["いる"],["。"],["その"],["終極","しゅうきょく"],["は"],["永遠","えいえん"],["の"],["いのち"],["で"],["ある"],["。"]]},{"verse":23,"text":"罪,つみの支払,しはらう報酬,ほうしゅうは死,しである。しかし神,かみの賜物,たまものは、わたしたちの主,しゅキリスト・イエスにおける永遠,えいえんのいのちである。","tok":[["罪","つみ"],["の"],["支払う","しはらう"],["報酬","ほうしゅう"],["は"],["死","し"],["で"],["ある"],["。"],["しかし"],["神","かみ"],["の"],["賜物","たまもの"],["は"],["、"],["わたしたち"],["の"],["主","しゅ"],["キリスト"],["・"],["イエス"],["に"],["おける"],["永遠","えいえん"],["の"],["いのち"],["で"],["ある"],["。"]]}]
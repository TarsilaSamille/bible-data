[{"verse":1,"text":"それとも、兄弟,きょうだいたちよ。あなたがたは知,しらないのか。わたしは律法,りっぽうを知,しっている人々,ひとびとに語,かたるのであるが、律法,りっぽうは人,ひとをその生,いきている期間,きかんだけ支配,しはいするものである。","tok":[["それ"],["と"],["も"],["、"],["兄弟","きょうだい"],["たち"],["よ"],["。"],["あなた"],["がた"],["は"],["知らない","しらない"],["の"],["か"],["。"],["わたし"],["は"],["律法","りっぽう"],["を"],["知って","しって"],["いる"],["人々","ひとびと"],["に"],["語る","かたる"],["ので"],["ある"],["が"],["、"],["律法","りっぽう"],["は"],["人","ひと"],["を"],["その"],["生きて","いきて"],["いる"],["期間","きかん"],["だけ"],["支配","しはい"],["する"],["もの"],["で"],["ある"],["。"]]},{"verse":2,"text":"すなわち、夫,おっとのある女,おんなは、夫,おっとが生,いきている間,あいだは、律法,りっぽうによって彼,かれにつながれている。しかし、夫,おっとが死,しねば、夫,おっとの律法,りっぽうから解放,かいほうされる。","tok":[["すなわち"],["、"],["夫","おっと"],["の"],["ある"],["女","おんな"],["は"],["、"],["夫","おっと"],["が"],["生きて","いきて"],["いる"],["間","あいだ"],["は"],["、"],["律法","りっぽう"],["によって"],["彼","かれ"],["に"],["つながれて"],["いる"],["。"],["しかし"],["、"],["夫","おっと"],["が"],["死ねば","しねば"],["、"],["夫","おっと"],["の"],["律法","りっぽう"],["から"],["解放","かいほう"],["される"],["。"]]},{"verse":3,"text":"であるから、夫,おっとの生存,せいぞん中,ちゅうに他,たの男,おとこに行,いけば、その女,おんなは淫婦,いんぷと呼,よばれるが、もし夫,おっとが死,しねば、その律法,りっぽうから解,とかれるので、他,たの男,おとこに行,いっても、淫婦,いんぷとはならない。","tok":[["で"],["ある"],["から"],["、"],["夫","おっと"],["の"],["生存中","せいぞんちゅう"],["に"],["他","た"],["の"],["男","おとこ"],["に"],["行けば","いけば"],["、"],["その"],["女","おんな"],["は"],["淫婦","いんぷ"],["と"],["呼ばれる","よばれる"],["が"],["、"],["もし"],["夫","おっと"],["が"],["死ねば","しねば"],["、"],["その"],["律法","りっぽう"],["から"],["解かれる","とかれる"],["ので"],["、"],["他","た"],["の"],["男","おとこ"],["に"],["行って","いって"],["も"],["、"],["淫婦","いんぷ"],["と"],["は"],["ならない"],["。"]]},{"verse":4,"text":"わたしの兄弟,きょうだいたちよ。このように、あなたがたも、キリストのからだをとおして、律法,りっぽうに対,たいして死,しんだのである。それは、あなたがたが他,たの人,ひと、すなわち、死人,しにんの中,なかからよみがえられたかたのものとなり、こうして、わたしたちが神,かみのために実,みを結,むすぶに至,いたるためなのである。","tok":[["わたし"],["の"],["兄弟","きょうだい"],["たち"],["よ"],["。"],["この"],["よう"],["に"],["、"],["あなた"],["がた"],["も"],["、"],["キリスト"],["の"],["からだ"],["を"],["とおして"],["、"],["律法","りっぽう"],["に対して","にたいして"],["死んだ","しんだ"],["ので"],["ある"],["。"],["それ"],["は"],["、"],["あなた"],["がた"],["が"],["他","た"],["の"],["人","ひと"],["、"],["すなわち"],["、"],["死人","しにん"],["の"],["中","なか"],["から"],["よみがえられた"],["かた"],["の"],["もの"],["と"],["なり"],["、"],["こう"],["して"],["、"],["わたしたち"],["が"],["神","かみ"],["の"],["ため"],["に"],["実","み"],["を"],["結ぶ","むすぶ"],["に"],["至る","いたる"],["ため"],["な"],["ので"],["ある"],["。"]]},{"verse":5,"text":"というのは、わたしたちが肉,にくにあった時,ときには、律法,りっぽうによる罪,つみの欲情,よくじょうが、死,しのために実,みを結,むすばせようとして、わたしたちの肢体,したいのうちに働,はたらいていた。","tok":[["と"],["いう"],["の"],["は"],["、"],["わたしたち"],["が"],["肉","にく"],["に"],["あった"],["時","とき"],["に"],["は"],["、"],["律法","りっぽう"],["に"],["よる"],["罪","つみ"],["の"],["欲情","よくじょう"],["が"],["、"],["死","し"],["の"],["ため"],["に"],["実","み"],["を"],["結ばせよう","むすばせよう"],["として"],["、"],["わたしたち"],["の"],["肢体","したい"],["の"],["うち"],["に"],["働いて","はたらいて"],["いた"],["。"]]},{"verse":6,"text":"しかし今,いまは、わたしたちをつないでいたものに対,たいして死,しんだので、わたしたちは律法,りっぽうから解放,かいほうされ、その結果,けっか、古,ふるい文字,もんじによってではなく、新,あたらしい霊,れいによって仕,つかえているのである。","tok":[["しかし"],["今","いま"],["は"],["、"],["わたしたち"],["を"],["つないで"],["いた"],["もの"],["に対して","にたいして"],["死んだ","しんだ"],["ので"],["、"],["わたしたち"],["は"],["律法","りっぽう"],["から"],["解放","かいほう"],["され"],["、"],["その"],["結果","けっか"],["、"],["古い","ふるい"],["文字","もんじ"],["によって"],["で"],["は"],["なく"],["、"],["新らしい","あたらしい"],["霊","れい"],["によって"],["仕えて","つかえて"],["いる"],["ので"],["ある"],["。"]]},{"verse":7,"text":"それでは、わたしたちは、なんと言,いおうか。律法,りっぽうは罪,つみなのか。断,だんじてそうではない。しかし、律法,りっぽうによらなければ、わたしは罪,つみを知,しらなかったであろう。すなわち、もし律法,りっぽうが「むさぼるな」と言,いわなかったら、わたしはむさぼりなるものを知,しらなかったであろう。","tok":[["それ"],["で"],["は"],["、"],["わたしたち"],["は"],["、"],["なん"],["と"],["言おう","いおう"],["か"],["。"],["律法","りっぽう"],["は"],["罪","つみ"],["な"],["の"],["か"],["。"],["断じて","だんじて"],["そう"],["で"],["は"],["ない"],["。"],["しかし"],["、"],["律法","りっぽう"],["に"],["よらなければ"],["、"],["わたし"],["は"],["罪","つみ"],["を"],["知らなかったで","しらなかったで"],["あろう"],["。"],["すなわち"],["、"],["もし"],["律法","りっぽう"],["が"],["「"],["むさぼる"],["な"],["」"],["と"],["言わなかったら","いわなかったら"],["、"],["わたし"],["は"],["むさぼりなる"],["もの"],["を"],["知らなかったで","しらなかったで"],["あろう"],["。"]]},{"verse":8,"text":"しかるに、罪,つみは戒,いましめによって機会,きかいを捕,とらえ、わたしの内,うちに働,はたらいて、あらゆるむさぼりを起,おこさせた。すなわち、律法,りっぽうがなかったら、罪,つみは死,しんでいるのである。","tok":[["しかる"],["に"],["、"],["罪","つみ"],["は"],["戒しめ","いましめ"],["によって"],["機会","きかい"],["を"],["捕らえ","とらえ"],["、"],["わたし"],["の"],["内","うち"],["に"],["働いて","はたらいて"],["、"],["あらゆる"],["むさぼり"],["を"],["起こさせた","おこさせた"],["。"],["すなわち"],["、"],["律法","りっぽう"],["が"],["なかったら"],["、"],["罪","つみ"],["は"],["死んで","しんで"],["いる"],["ので"],["ある"],["。"]]},{"verse":9,"text":"わたしはかつては、律法,りっぽうなしに生,いきていたが、戒,いましめが来,くるに及,およんで、罪,つみは生,いき返,かえり、","tok":[["わたし"],["は"],["かつて"],["は"],["、"],["律法","りっぽう"],["なし"],["に"],["生きて","いきて"],["いた"],["が"],["、"],["戒しめ","いましめ"],["が"],["来る","くる"],["に"],["及んで","およんで"],["、"],["罪","つみ"],["は"],["生き返り","いきかえり"],["、"]]},{"verse":10,"text":"わたしは死,しんだ。そして、いのちに導,みちびくべき戒,いましめそのものが、かえってわたしを死,しに導,みちびいて行,いくことがわかった。","tok":[["わたし"],["は"],["死んだ","しんだ"],["。"],["そして"],["、"],["いのち"],["に"],["導くべき","みちびくべき"],["戒しめ","いましめ"],["その"],["もの"],["が"],["、"],["かえって"],["わたし"],["を"],["死","し"],["に"],["導いて","みちびいて"],["行く","いく"],["こと"],["が"],["わかった"],["。"]]},{"verse":11,"text":"なぜなら、罪,つみは戒,いましめによって機会,きかいを捕,とらえ、わたしを欺,あざむき、戒,いましめによってわたしを殺,ころしたからである。","tok":[["なぜ"],["なら"],["、"],["罪","つみ"],["は"],["戒しめ","いましめ"],["によって"],["機会","きかい"],["を"],["捕らえ","とらえ"],["、"],["わたし"],["を"],["欺き","あざむき"],["、"],["戒しめ","いましめ"],["によって"],["わたし"],["を"],["殺ろした","ころした"],["から"],["で"],["ある"],["。"]]},{"verse":12,"text":"このようなわけで、律法,りっぽうそのものは聖,せいなるものであり、戒,いましめも聖,せいであって、正,ただしく、かつ善,ぜんなるものである。","tok":[["この"],["よう"],["な"],["わけ"],["で"],["、"],["律法","りっぽう"],["その"],["もの"],["は"],["聖","せい"],["なる"],["もの"],["で"],["あり"],["、"],["戒しめ","いましめ"],["も"],["聖","せい"],["で"],["あって"],["、"],["正く","ただしく"],["、"],["かつ"],["善","ぜん"],["なる"],["もの"],["で"],["ある"],["。"]]},{"verse":13,"text":"では、善,ぜんなるものが、わたしにとって死,しとなったのか。断,だんじてそうではない。それはむしろ、罪,つみの罪,つみたることが現,あらわれるための、罪,つみのしわざである。すなわち、罪,つみは、戒,いましめによって、はなはだしく悪性,あくせいなものとなるために、善,ぜんなるものによってわたしを死,しに至,いたらせたのである。","tok":[["で"],["は"],["、"],["善","ぜん"],["なる"],["もの"],["が"],["、"],["わたし"],["にとって"],["死","し"],["と"],["なった"],["の"],["か"],["。"],["断じて","だんじて"],["そう"],["で"],["は"],["ない"],["。"],["それ"],["は"],["むしろ"],["、"],["罪","つみ"],["の"],["罪","つみ"],["たる"],["こと"],["が"],["現われる","あらわれる"],["ため"],["の"],["、"],["罪","つみ"],["の"],["しわざ"],["で"],["ある"],["。"],["すなわち"],["、"],["罪","つみ"],["は"],["、"],["戒しめ","いましめ"],["によって"],["、"],["はなはだしく"],["悪性","あくせい"],["な"],["もの"],["と"],["なる"],["ため"],["に"],["、"],["善","ぜん"],["なる"],["もの"],["によって"],["わたし"],["を"],["死","し"],["に"],["至らせた","いたらせた"],["ので"],["ある"],["。"]]},{"verse":14,"text":"わたしたちは、律法,りっぽうは霊的,れいてきなものであると知,しっている。しかし、わたしは肉,にくにつける者,ものであって、罪,つみの下,もとに売,うられているのである。","tok":[["わたしたち"],["は"],["、"],["律法","りっぽう"],["は"],["霊的","れいてき"],["な"],["もの"],["で"],["ある"],["と"],["知って","しって"],["いる"],["。"],["しかし"],["、"],["わたし"],["は"],["肉","にく"],["に"],["つける"],["者","もの"],["で"],["あって"],["、"],["罪","つみ"],["の"],["下","もと"],["に"],["売られて","うられて"],["いる"],["ので"],["ある"],["。"]]},{"verse":15,"text":"わたしは自分,じぶんのしていることが、わからない。なぜなら、わたしは自分,じぶんの欲,ほっする事,ことは行,おこなわず、かえって自分,じぶんの憎,にくむ事,ことをしているからである。","tok":[["わたし"],["は"],["自分","じぶん"],["の"],["して"],["いる"],["こと"],["が"],["、"],["わからない"],["。"],["なぜ"],["なら"],["、"],["わたし"],["は"],["自分","じぶん"],["の"],["欲する","ほっする"],["事","こと"],["は"],["行なわず","おこなわず"],["、"],["かえって"],["自分","じぶん"],["の"],["憎む","にくむ"],["事","こと"],["を"],["して"],["いる"],["から"],["で"],["ある"],["。"]]},{"verse":16,"text":"もし、自分,じぶんの欲,ほっしない事,ことをしているとすれば、わたしは律法,りっぽうが良,よいものであることを承認,しょうにんしていることになる。","tok":[["もし"],["、"],["自分","じぶん"],["の"],["欲しない","ほっしない"],["事","こと"],["を"],["して"],["いる"],["と"],["すれば"],["、"],["わたし"],["は"],["律法","りっぽう"],["が"],["良い","よい"],["もの"],["で"],["ある"],["こと"],["を"],["承認","しょうにん"],["して"],["いる"],["こと"],["に"],["なる"],["。"]]},{"verse":17,"text":"そこで、この事,ことをしているのは、もはやわたしではなく、わたしの内,うちに宿,やどっている罪,つみである。","tok":[["そこ"],["で"],["、"],["この"],["事","こと"],["を"],["して"],["いる"],["の"],["は"],["、"],["もはや"],["わたし"],["で"],["は"],["なく"],["、"],["わたし"],["の"],["内","うち"],["に"],["宿って","やどって"],["いる"],["罪","つみ"],["で"],["ある"],["。"]]},{"verse":18,"text":"わたしの内,うちに、すなわち、わたしの肉,にくの内,うちには、善,ぜんなるものが宿,やどっていないことを、わたしは知,しっている。なぜなら、善,ぜんをしようとする意志,いしは、自分,じぶんにあるが、それをする力,ちからがないからである。","tok":[["わたし"],["の"],["内","うち"],["に"],["、"],["すなわち"],["、"],["わたし"],["の"],["肉","にく"],["の"],["内","うち"],["に"],["は"],["、"],["善","ぜん"],["なる"],["もの"],["が"],["宿って","やどって"],["いない"],["こと"],["を"],["、"],["わたし"],["は"],["知って","しって"],["いる"],["。"],["なぜ"],["なら"],["、"],["善","ぜん"],["を"],["しよう"],["と"],["する"],["意志","いし"],["は"],["、"],["自分","じぶん"],["に"],["ある"],["が"],["、"],["それ"],["を"],["する"],["力","ちから"],["が"],["ない"],["から"],["で"],["ある"],["。"]]},{"verse":19,"text":"すなわち、わたしの欲,ほっしている善,ぜんはしないで、欲,ほっしていない悪,あくは、これを行,おこなっている。","tok":[["すなわち"],["、"],["わたし"],["の"],["欲して","ほっして"],["いる"],["善","ぜん"],["は"],["しないで"],["、"],["欲して","ほっして"],["いない"],["悪","あく"],["は"],["、"],["これ"],["を"],["行なって","おこなって"],["いる"],["。"]]},{"verse":20,"text":"もし、欲,ほっしないことをしているとすれば、それをしているのは、もはやわたしではなく、わたしの内,うちに宿,やどっている罪,つみである。","tok":[["もし"],["、"],["欲しない","ほっしない"],["こと"],["を"],["して"],["いる"],["と"],["すれば"],["、"],["それ"],["を"],["して"],["いる"],["の"],["は"],["、"],["もはや"],["わたし"],["で"],["は"],["なく"],["、"],["わたし"],["の"],["内","うち"],["に"],["宿って","やどって"],["いる"],["罪","つみ"],["で"],["ある"],["。"]]},{"verse":21,"text":"そこで、善,ぜんをしようと欲,ほっしているわたしに、悪,あくがはいり込,こんでいるという法則,ほうそくがあるのを見,みる。","tok":[["そこ"],["で"],["、"],["善","ぜん"],["を"],["しよう"],["と"],["欲して","ほっして"],["いる"],["わたし"],["に"],["、"],["悪","あく"],["が"],["はいり込んで","はいりこんで"],["いる"],["と"],["いう"],["法則","ほうそく"],["が"],["ある"],["の"],["を"],["見る","みる"],["。"]]},{"verse":22,"text":"すなわち、わたしは、内,うちなる人,ひととしては神,かみの律法,りっぽうを喜,よろこんでいるが、","tok":[["すなわち"],["、"],["わたし"],["は"],["、"],["内","うち"],["なる"],["人","ひと"],["として"],["は"],["神","かみ"],["の"],["律法","りっぽう"],["を"],["喜こんで","よろこんで"],["いる"],["が"],["、"]]},{"verse":23,"text":"わたしの肢体,したいには別,べつの律法,りっぽうがあって、わたしの心,こころの法則,ほうそくに対,たいして戦,たたかいをいどみ、そして、肢体,したいに存在,そんざいする罪,つみの法則,ほうそくの中,なかに、わたしをとりこにしているのを見,みる。","tok":[["わたし"],["の"],["肢体","したい"],["に"],["は"],["別","べつ"],["の"],["律法","りっぽう"],["が"],["あって"],["、"],["わたし"],["の"],["心","こころ"],["の"],["法則","ほうそく"],["に対して","にたいして"],["戦い","たたかい"],["を"],["いどみ"],["、"],["そして"],["、"],["肢体","したい"],["に"],["存在","そんざい"],["する"],["罪","つみ"],["の"],["法則","ほうそく"],["の"],["中","なか"],["に"],["、"],["わたし"],["を"],["とりこ"],["に"],["して"],["いる"],["の"],["を"],["見る","みる"],["。"]]},{"verse":24,"text":"わたしは、なんというみじめな人間,にんげんなのだろう。だれが、この死,しのからだから、わたしを救,すくってくれるだろうか。","tok":[["わたし"],["は"],["、"],["なん"],["と"],["いう"],["みじめ"],["な"],["人間","にんげん"],["な"],["の"],["だろう"],["。"],["だれ"],["が"],["、"],["この"],["死","し"],["の"],["からだ"],["から"],["、"],["わたし"],["を"],["救って","すくって"],["くれるだろう"],["か"],["。"]]},{"verse":25,"text":"わたしたちの主,しゅイエス・キリストによって、神,かみは感謝,かんしゃすべきかな。このようにして、わたし自身,じしんは、心,こころでは神,かみの律法,りっぽうに仕,つかえているが、肉,にくでは罪,つみの律法,りっぽうに仕,つかえているのである。","tok":[["わたしたち"],["の"],["主","しゅ"],["イエス"],["・"],["キリスト"],["によって"],["、"],["神","かみ"],["は"],["感謝","かんしゃ"],["すべき"],["か"],["な"],["。"],["この"],["よう"],["に"],["して"],["、"],["わたし"],["自身","じしん"],["は"],["、"],["心","こころ"],["で"],["は"],["神","かみ"],["の"],["律法","りっぽう"],["に"],["仕えて","つかえて"],["いる"],["が"],["、"],["肉","にく"],["で"],["は"],["罪","つみ"],["の"],["律法","りっぽう"],["に"],["仕えて","つかえて"],["いる"],["ので"],["ある"],["。"]]}]
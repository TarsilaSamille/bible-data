[{"verse":1,"text":"わたしたち強,つよい者,ものは、強,つよくない者,ものたちの弱,よわさをになうべきであって、自分,じぶんだけを喜,よろこばせることをしてはならない。","tok":[["わたしたち"],["強い","つよい"],["者","もの"],["は"],["、"],["強く","つよく"],["ない"],["者","もの"],["たち"],["の"],["弱","よわ"],["さ"],["を"],["になうべきで"],["あって"],["、"],["自分","じぶん"],["だけ"],["を"],["喜こばせる","よろこばせる"],["こと"],["を"],["して"],["は"],["ならない"],["。"]]},{"verse":2,"text":"わたしたちひとりびとりは、隣,となり人,ひとの徳,とくを高,たかめるために、その益,えきを図,はかって彼,かれらを喜,よろこばすべきである。","tok":[["わたしたち"],["ひとりびとり"],["は"],["、"],["隣人","となりひと"],["の"],["徳","とく"],["を"],["高める","たかめる"],["ため"],["に"],["、"],["その"],["益","えき"],["を"],["図って","はかって"],["彼","かれ"],["ら"],["を"],["喜こば","よろこば"],["すべきで"],["ある"],["。"]]},{"verse":3,"text":"キリストさえ、ご自身,じしんを喜,よろこばせることはなさらなかった。むしろ「あなたをそしる者,もののそしりが、わたしに降,ふりかかった」と書,かいてあるとおりであった。","tok":[["キリスト"],["さえ"],["、"],["ご自身","ごじしん"],["を"],["喜こばせる","よろこばせる"],["こと"],["は"],["なさらなかった"],["。"],["むしろ"],["「"],["あなた"],["を"],["そしる"],["者","もの"],["の"],["そしり"],["が"],["、"],["わたし"],["に"],["降りかかった","ふりかかった"],["」"],["と"],["書いて","かいて"],["ある"],["とおり"],["で"],["あった"],["。"]]},{"verse":4,"text":"これまでに書,かかれた事,ことがらは、すべてわたしたちの教,おしえのために書,かかれたのであって、それは聖書,せいしょの与,あたえる忍耐,にんたいと慰,なぐさめとによって、望,のぞみをいだかせるためである。","tok":[["これ"],["まで"],["に"],["書かれた","かかれた"],["事がら","ことがら"],["は"],["、"],["すべて"],["わたしたち"],["の"],["教え","おしえ"],["の"],["ため"],["に"],["書かれた","かかれた"],["ので"],["あって"],["、"],["それ"],["は"],["聖書","せいしょ"],["の"],["与える","あたえる"],["忍耐","にんたい"],["と"],["慰さめ","なぐさめ"],["と"],["によって"],["、"],["望み","のぞみ"],["を"],["いだかせる"],["ため"],["で"],["ある"],["。"]]},{"verse":5,"text":"どうか、忍耐,にんたいと慰,なぐさめとの神,かみが、あなたがたに、キリスト・イエスにならって互,たがいに同,おなじ思,おもいをいだかせ、","tok":[["どう"],["か"],["、"],["忍耐","にんたい"],["と"],["慰さめ","なぐさめ"],["と"],["の"],["神","かみ"],["が"],["、"],["あなた"],["がた"],["に"],["、"],["キリスト"],["・"],["イエス"],["に"],["ならって"],["互","たがい"],["に"],["同じ","おなじ"],["思い","おもい"],["を"],["いだかせ"],["、"]]},{"verse":6,"text":"こうして、心,こころを一,ひとつにし、声,こえを合,あわせて、わたしたちの主,しゅイエス・キリストの父,ちちなる神,かみをあがめさせて下,くださるように。","tok":[["こう"],["して"],["、"],["心","こころ"],["を"],["一","ひと"],["つ"],["に"],["し"],["、"],["声","こえ"],["を"],["合","あわせ"],["て"],["、"],["わたしたち"],["の"],["主","しゅ"],["イエス"],["・"],["キリスト"],["の"],["父","ちち"],["なる"],["神","かみ"],["を"],["あがめさせて"],["下さる","くださる"],["よう"],["に"],["。"]]},{"verse":7,"text":"こういうわけで、キリストもわたしたちを受,うけいれて下,くださったように、あなたがたも互,たがいに受,うけいれて、神,かみの栄光,えいこうをあらわすべきである。","tok":[["こう"],["いう"],["わけ"],["で"],["、"],["キリスト"],["も"],["わたしたち"],["を"],["受","うけ"],["いれて"],["下さった","くださった"],["よう"],["に"],["、"],["あなた"],["がた"],["も"],["互","たがい"],["に"],["受","うけ"],["いれて"],["、"],["神","かみ"],["の"],["栄光","えいこう"],["を"],["あらわすべきで"],["ある"],["。"]]},{"verse":8,"text":"わたしは言,いう、キリストは神,かみの真実,しんじつを明,あきらかにするために、割礼,かつれいのある者,ものの僕,しもべとなられた。それは父祖,ふそたちの受,うけた約束,やくそくを保証,ほしょうすると共,ともに、","tok":[["わたし"],["は"],["言う","いう"],["、"],["キリスト"],["は"],["神","かみ"],["の"],["真実","しんじつ"],["を"],["明か","あきらか"],["に"],["する"],["ため"],["に"],["、"],["割礼","かつれい"],["の"],["ある"],["者","もの"],["の"],["僕","し"],["も"],["べ"],["と"],["なられた"],["。"],["それ"],["は"],["父祖","ふそ"],["たち"],["の"],["受けた","うけた"],["約束","やくそく"],["を"],["保証","ほしょう"],["する"],["と"],["共","とも"],["に"],["、"]]},{"verse":9,"text":"異邦人,いほうじんもあわれみを受,うけて神,かみをあがめるようになるためである、「それゆえ、わたしは、異邦人,いほうじんの中,なかであなたにさんびをささげ、また、御名,みなをほめ歌,うたう」と書,かいてあるとおりである。","tok":[["異邦人","いほうじん"],["も"],["あわれみ"],["を"],["受て","うけて"],["神","かみ"],["を"],["あがめる"],["よう"],["に"],["なる"],["ため"],["で"],["ある"],["、"],["「"],["それ"],["ゆえ"],["、"],["わたし"],["は"],["、"],["異邦人","いほうじん"],["の"],["中","なか"],["で"],["あなた"],["に"],["さん"],["び"],["を"],["ささげ"],["、"],["また"],["、"],["御名","みな"],["を"],["ほめ"],["歌う","うたう"],["」"],["と"],["書いて","かいて"],["ある"],["とおり"],["で"],["ある"],["。"]]},{"verse":10,"text":"また、こう言,いっている、「異邦人,いほうじんよ、主,しゅの民,たみと共,ともに喜,よろこべ」。","tok":[["また"],["、"],["こう"],["言って","いって"],["いる"],["、"],["「"],["異邦人","いほうじん"],["よ"],["、"],["主","しゅ"],["の"],["民","たみ"],["と"],["共","とも"],["に"],["喜こべ","よろこべ"],["」"],["。"]]},{"verse":11,"text":"また、「すべての異邦人,いほうじんよ、主,しゅをほめまつれ。もろもろの民,たみよ、主,しゅをほめたたえよ」。","tok":[["また"],["、"],["「"],["すべて"],["の"],["異邦人","いほうじん"],["よ"],["、"],["主","しゅ"],["を"],["ほめ"],["まつれ"],["。"],["もろもろ"],["の"],["民","たみ"],["よ"],["、"],["主","しゅ"],["を"],["ほめたたえよ"],["」"],["。"]]},{"verse":12,"text":"またイザヤは言,いっている、「エッサイの根,ねから芽,めが出,でて、異邦人,いほうじんを治,おさめるために立,たち上,あがる者,ものが来,くる。異邦人,いほうじんは彼,かれに望,のぞみをおくであろう」。","tok":[["また"],["イザヤ"],["は"],["言って","いって"],["いる"],["、"],["「"],["エッサイ"],["の"],["根","ね"],["から"],["芽","め"],["が"],["出て","でて"],["、"],["異邦人","いほうじん"],["を"],["治める","おさめる"],["ため"],["に"],["立ち上がる","たちあがる"],["者","もの"],["が"],["来る","くる"],["。"],["異邦人","いほうじん"],["は"],["彼","かれ"],["に"],["望み","のぞみ"],["を"],["おくで"],["あろう"],["」"],["。"]]},{"verse":13,"text":"どうか、望,のぞみの神,かみが、信仰,しんこうから来,くるあらゆる喜,よろこびと平安,へいあんとを、あなたがたに満,みたし、聖霊,せいれいの力,ちからによって、あなたがたを、望,のぞみにあふれさせて下,くださるように。","tok":[["どう"],["か"],["、"],["望み","のぞみ"],["の"],["神","かみ"],["が"],["、"],["信仰","しんこう"],["から"],["来る","くる"],["あらゆる"],["喜こび","よろこび"],["と"],["平安","へいあん"],["と"],["を"],["、"],["あなた"],["がた"],["に"],["満たし","みたし"],["、"],["聖霊","せいれい"],["の"],["力","ちから"],["によって"],["、"],["あなた"],["がた"],["を"],["、"],["望み","のぞみ"],["に"],["あふれさせて"],["下さる","くださる"],["よう"],["に"],["。"]]},{"verse":14,"text":"さて、わたしの兄弟,きょうだいたちよ。あなたがた自身,じしんが、善意,ぜんいにあふれ、あらゆる知恵,ちえに満,みたされ、そして互,たがいに訓戒,くんかいし合,あう力,ちからのあることを、わたしは堅,かたく信,しんじている。","tok":[["さて"],["、"],["わたし"],["の"],["兄弟","きょうだい"],["たち"],["よ"],["。"],["あなた"],["がた"],["自身","じしん"],["が"],["、"],["善意","ぜんい"],["に"],["あふれ"],["、"],["あらゆる"],["知恵","ちえ"],["に"],["満たされ","みたされ"],["、"],["そして"],["互","たがい"],["に"],["訓戒","くんかい"],["し"],["合う","あう"],["力","ちから"],["の"],["ある"],["こと"],["を"],["、"],["わたし"],["は"],["堅く","かたく"],["信じて","しんじて"],["いる"],["。"]]},{"verse":15,"text":"しかし、わたしはあなたがたの記憶,きおくを新,あらたにするために、ところどころ、かなり思,おもいきって書,かいた。それは、神,かみからわたしに賜,たまわった恵,めぐみによって、書,かいたのである。","tok":[["しかし"],["、"],["わたし"],["は"],["あなた"],["がた"],["の"],["記憶","きおく"],["を"],["新らた","あらた"],["に"],["する"],["ため"],["に"],["、"],["ところどころ"],["、"],["かなり"],["思いきって","おもいきって"],["書いた","かいた"],["。"],["それ"],["は"],["、"],["神","かみ"],["から"],["わたし"],["に"],["賜わった","たまわった"],["恵","めぐみ"],["によって"],["、"],["書いた","かいた"],["ので"],["ある"],["。"]]},{"verse":16,"text":"このように恵,めぐみを受,うけたのは、わたしが異邦人,いほうじんのためにキリスト・イエスに仕,つかえる者,ものとなり、神,かみの福音,ふくいんのために祭司,さいしの役,やくを勤,つとめ、こうして異邦人,いほうじんを、聖霊,せいれいによってきよめられた、御旨,みむねにかなうささげ物,ものとするためである。","tok":[["この"],["よう"],["に"],["恵","めぐみ"],["を"],["受た","うけた"],["の"],["は"],["、"],["わたし"],["が"],["異邦人","いほうじん"],["の"],["ため"],["に"],["キリスト"],["・"],["イエス"],["に"],["仕える","つかえる"],["者","もの"],["と"],["なり"],["、"],["神","かみ"],["の"],["福音","ふくいん"],["の"],["ため"],["に"],["祭司","さいし"],["の"],["役","やく"],["を"],["勤め","つとめ"],["、"],["こう"],["して"],["異邦人","いほうじん"],["を"],["、"],["聖霊","せいれい"],["によって"],["きよめられた"],["、"],["御旨","みむね"],["に"],["かなう"],["ささげ物","ささげもの"],["と"],["する"],["ため"],["で"],["ある"],["。"]]},{"verse":17,"text":"だから、わたしは神,かみへの奉仕,ほうしについては、キリスト・イエスにあって誇,ほこりうるのである。","tok":[["だ"],["から"],["、"],["わたし"],["は"],["神","かみ"],["へ"],["の"],["奉仕","ほうし"],["について"],["は"],["、"],["キリスト"],["・"],["イエス"],["に"],["あって"],["誇","ほこり"],["うる"],["ので"],["ある"],["。"]]},{"verse":18,"text":"わたしは、異邦人,いほうじんを従順,じゅうじゅんにするために、キリストがわたしを用,もちいて、言葉,ことばとわざ、","tok":[["わたし"],["は"],["、"],["異邦人","いほうじん"],["を"],["従順","じゅうじゅん"],["に"],["する"],["ため"],["に"],["、"],["キリスト"],["が"],["わたし"],["を"],["用いて","もちいて"],["、"],["言葉","ことば"],["と"],["わざ"],["、"]]},{"verse":19,"text":"しるしと不思議,ふしぎとの力,ちから、聖霊,せいれいの力,ちからによって、働,はたらかせて下,くださったことの外,ほかには、あえて何,なにも語,かたろうとは思,おもわない。こうして、わたしはエルサレムから始,はじまり、巡,めぐりめぐってイルリコに至,いたるまで、キリストの福音,ふくいんを満,みたしてきた。","tok":[["しるし"],["と"],["不思議","ふしぎ"],["と"],["の"],["力","ちから"],["、"],["聖霊","せいれい"],["の"],["力","ちから"],["によって"],["、"],["働かせて","はたらかせて"],["下さった","くださった"],["こと"],["の"],["外","ほか"],["に"],["は"],["、"],["あえて"],["何に","なに"],["も"],["語ろう","かたろう"],["と"],["は"],["思わない","おもわない"],["。"],["こう"],["して"],["、"],["わたし"],["は"],["エルサレム"],["から"],["始まり","はじまり"],["、"],["巡りめぐって","めぐりめぐって"],["イルリコ"],["に"],["至る","いたる"],["まで"],["、"],["キリスト"],["の"],["福音","ふくいん"],["を"],["満たして","みたして"],["きた"],["。"]]},{"verse":20,"text":"その際,さい、わたしの切,せつに望,のぞんだところは、他人,たにんの土台,どだいの上,うえに建,たてることをしないで、キリストの御名,みながまだ唱,となえられていない所,ところに福音,ふくいんを宣,のべ伝,つたえることであった。","tok":[["その"],["際","さい"],["、"],["わたし"],["の"],["切に","せつに"],["望んだ","のぞんだ"],["ところ"],["は"],["、"],["他人","たにん"],["の"],["土台","どだい"],["の"],["上","うえ"],["に"],["建てる","たてる"],["こと"],["を"],["しないで"],["、"],["キリスト"],["の"],["御名","みな"],["が"],["まだ"],["唱えられて","となえられて"],["いない"],["所","ところ"],["に"],["福音","ふくいん"],["を"],["宣べ伝える","のべつたえる"],["こと"],["で"],["あった"],["。"]]},{"verse":21,"text":"すなわち、「彼,かれのことを宣,のべ伝,つたえられていなかった人々,ひとびとが見,み、聞,きいていなかった人々,ひとびとが悟,さとるであろう」と書,かいてあるとおりである。","tok":[["すなわち"],["、"],["「"],["彼","かれ"],["の"],["こと"],["を"],["宣べ伝えられて","のべつたえられて"],["いなかった"],["人々","ひとびと"],["が"],["見","み"],["、"],["聞いて","きいて"],["いなかった"],["人々","ひとびと"],["が"],["悟","さとる"],["で"],["あろう"],["」"],["と"],["書いて","かいて"],["ある"],["とおり"],["で"],["ある"],["。"]]},{"verse":22,"text":"こういうわけで、わたしはあなたがたの所,ところに行,いくことを、たびたび妨,さまたげられてきた。","tok":[["こう"],["いう"],["わけ"],["で"],["、"],["わたし"],["は"],["あなた"],["がた"],["の"],["所","ところ"],["に"],["行く","いく"],["こと"],["を"],["、"],["たびたび"],["妨げられて","さまたげられて"],["きた"],["。"]]},{"verse":23,"text":"しかし今,いまでは、この地方,ちほうにはもはや働,はたらく余地,よちがなく、かつイスパニヤに赴,おもむく場合,ばあい、あなたがたの所,ところに行,いくことを、多年,たねん、熱望,ねつぼうしていたので、――","tok":[["しかし"],["今","いま"],["で"],["は"],["、"],["この"],["地方","ちほう"],["に"],["は"],["もはや"],["働く","はたらく"],["余地","よち"],["が"],["なく"],["、"],["かつ"],["イスパニヤ"],["に"],["赴く","おもむく"],["場合","ばあい"],["、"],["あなた"],["がた"],["の"],["所","ところ"],["に"],["行く","いく"],["こと"],["を"],["、"],["多年","たねん"],["、"],["熱望","ねつぼう"],["して"],["いた"],["ので"],["、"],["―"],["―"]]},{"verse":24,"text":"その途中,とちゅうあなたがたに会,あい、まず幾分,いくぶんでもわたしの願,ねがいがあなたがたによって満,みたされたら、あなたがたに送,おくられてそこへ行,いくことを、望,のぞんでいるのである。","tok":[["その"],["途中","とちゅう"],["あなた"],["がた"],["に"],["会い","あい"],["、"],["まず"],["幾分","いくぶん"],["で"],["も"],["わたし"],["の"],["願い","ねがい"],["が"],["あなた"],["がた"],["によって"],["満たされたら","みたされたら"],["、"],["あなた"],["がた"],["に"],["送られて","おくられて"],["そこ"],["へ"],["行く","いく"],["こと"],["を"],["、"],["望","の"],["ぞ"],["ん"],["で"],["いる"],["ので"],["ある"],["。"]]},{"verse":25,"text":"しかし今,いまの場合,ばあい、聖徒,せいとたちに仕,つかえるために、わたしはエルサレムに行,いこうとしている。","tok":[["しかし"],["今","いま"],["の"],["場合","ばあい"],["、"],["聖徒","せいと"],["たち"],["に"],["仕える","つかえる"],["ため"],["に"],["、"],["わたし"],["は"],["エルサレム"],["に"],["行こう","いこう"],["として"],["いる"],["。"]]},{"verse":26,"text":"なぜなら、マケドニヤとアカヤとの人々,ひとびとは、エルサレムにおる聖徒,せいとの中,なかの貧,まずしい人々,ひとびとを援助,えんじょすることに賛成,さんせいしたからである。","tok":[["なぜ"],["なら"],["、"],["マケドニヤ"],["と"],["アカヤ"],["と"],["の"],["人々","ひとびと"],["は"],["、"],["エルサレム"],["に"],["おる"],["聖徒","せいと"],["の"],["中","なか"],["の"],["貧しい","まずしい"],["人々","ひとびと"],["を"],["援助","えんじょ"],["する"],["こと"],["に"],["賛成","さんせい"],["した"],["から"],["で"],["ある"],["。"]]},{"verse":27,"text":"たしかに、彼,かれらは賛成,さんせいした。しかし同時,どうじに、彼,かれらはかの人々,ひとびとに負債,ふさいがある。というのは、もし異邦人,いほうじんが彼,かれらの霊,れいの物,ものにあずかったとすれば、肉,にくの物,ものをもって彼,かれらに仕,つかえるのは、当然,とうぜんだからである。","tok":[["たしか"],["に"],["、"],["彼","かれ"],["ら"],["は"],["賛成","さんせい"],["した"],["。"],["しかし"],["同時","どうじ"],["に"],["、"],["彼","かれ"],["ら"],["は"],["かの"],["人々","ひとびと"],["に"],["負債","ふさい"],["が"],["ある"],["。"],["と"],["いう"],["の"],["は"],["、"],["もし"],["異邦人","いほうじん"],["が"],["彼","かれ"],["ら"],["の"],["霊","れい"],["の"],["物","もの"],["に"],["あずかった"],["と"],["すれば"],["、"],["肉","にく"],["の"],["物","もの"],["を"],["もって"],["彼","かれ"],["ら"],["に"],["仕える","つかえる"],["の"],["は"],["、"],["当然","とうぜん"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":28,"text":"そこでわたしは、この仕事,しごとを済,すませて彼,かれらにこの実,みを手渡,てわたした後,のち、あなたがたの所,ところをとおって、イスパニヤに行,いこうと思,おもう。","tok":[["そこ"],["で"],["わたし"],["は"],["、"],["この"],["仕事","しごと"],["を"],["済ませて","すませて"],["彼","かれ"],["ら"],["に"],["この"],["実","み"],["を"],["手渡","てわたし"],["た"],["後","の"],["ち"],["、"],["あなた"],["がた"],["の"],["所","ところ"],["を"],["とおって"],["、"],["イスパニヤ"],["に"],["行こう","いこう"],["と"],["思う","おもう"],["。"]]},{"verse":29,"text":"そしてあなたがたの所,ところに行,ゆく時,ときには、キリストの満,みちあふれる祝福,しゅくふくをもって行,ゆくことと、信,しんじている。","tok":[["そして"],["あなた"],["がた"],["の"],["所","ところ"],["に"],["行く","ゆく"],["時","とき"],["に"],["は"],["、"],["キリスト"],["の"],["満ちあふれる","みちあふれる"],["祝福","しゅくふく"],["を"],["もって"],["行","ゆくこ"],["と"],["と"],["、"],["信じて","しんじて"],["いる"],["。"]]},{"verse":30,"text":"兄弟,きょうだいたちよ。わたしたちの主,しゅイエス・キリストにより、かつ御霊,みたまの愛,あいによって、あなたがたにお願,ねがいする。どうか、共,ともに力,ちからをつくして、わたしのために神,かみに祈,いのってほしい。","tok":[["兄弟","きょうだい"],["たち"],["よ"],["。"],["わたしたち"],["の"],["主","しゅ"],["イエス"],["・"],["キリスト"],["に"],["より"],["、"],["かつ"],["御霊","みたま"],["の"],["愛","あい"],["によって"],["、"],["あなた"],["がた"],["に"],["お願い","おねがい"],["する"],["。"],["どう"],["か"],["、"],["共","とも"],["に"],["力","ちから"],["を"],["つくして"],["、"],["わたし"],["の"],["ため"],["に"],["神","かみ"],["に"],["祈って","いのって"],["ほしい"],["。"]]},{"verse":31,"text":"すなわち、わたしがユダヤにおる不信,ふしんの徒,とから救,すくわれ、そしてエルサレムに対,たいするわたしの奉仕,ほうしが聖徒,せいとたちに受,うけいれられるものとなるように、","tok":[["すなわち"],["、"],["わたし"],["が"],["ユダヤ"],["に"],["おる"],["不信","ふしん"],["の"],["徒","と"],["から"],["救われ","すくわれ"],["、"],["そして"],["エルサレム"],["に"],["対する","たいする"],["わたし"],["の"],["奉仕","ほうし"],["が"],["聖徒","せいと"],["たち"],["に"],["受","うけ"],["いれられる"],["もの"],["と"],["なる"],["よう"],["に"],["、"]]},{"verse":32,"text":"また、神,かみの御旨,みむねにより、喜,よろこびをもってあなたがたの所,ところに行,いき、共,ともになぐさめ合,あうことができるように祈,いのってもらいたい。","tok":[["また"],["、"],["神","かみ"],["の"],["御旨","みむね"],["に"],["より"],["、"],["喜こび","よろこび"],["を"],["もって"],["あなた"],["がた"],["の"],["所","ところ"],["に"],["行き","いき"],["、"],["共","とも"],["に"],["なぐさめ"],["合う","あう"],["こと"],["が"],["できる"],["よう"],["に"],["祈って","いのって"],["もらいたい"],["。"]]},{"verse":33,"text":"どうか、平和,へいわの神,かみがあなたがた一同,いちどうと共,ともにいますように、アァメン。","tok":[["どう"],["か"],["、"],["平和","へいわ"],["の"],["神","かみ"],["が"],["あなた"],["がた"],["一同","いちどう"],["と"],["共","とも"],["に"],["います"],["よう"],["に"],["、"],["アァメン"],["。"]]}]
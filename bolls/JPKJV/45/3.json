[{"verse":1,"text":"では、ユダヤ人,じんのすぐれている点,てんは何,なにか。また割礼,かつれいの益,えきは何,なにか。","tok":[["で"],["は"],["、"],["ユダヤ人","ゆだやじん"],["の"],["すぐれて"],["いる"],["点","てん"],["は"],["何に","なに"],["か"],["。"],["また"],["割礼","かつれい"],["の"],["益","えき"],["は"],["何に","なに"],["か"],["。"]]},{"verse":2,"text":"それは、いろいろの点,てんで数多,かずおおくある。まず第,だい一に、神,かみの言,ことばが彼,かれらにゆだねられたことである。","tok":[["それ"],["は"],["、"],["いろいろ"],["の"],["点","てん"],["で"],["数多く","かずおおく"],["ある"],["。"],["まず"],["第","だい"],["一","いち"],["に"],["、"],["神","かみ"],["の"],["言","こ"],["と"],["ば"],["が"],["彼","かれ"],["ら"],["に"],["ゆだねられた"],["こと"],["で"],["ある"],["。"]]},{"verse":3,"text":"すると、どうなるのか。もし、彼,かれらのうちに不,ふ真実,しんじつの者,ものがあったとしたら、その不,ふ真実,しんじつによって、神,かみの真実,しんじつは無,むになるであろうか。","tok":[["する"],["と"],["、"],["どう"],["なる"],["の"],["か"],["。"],["もし"],["、"],["彼","かれ"],["ら"],["の"],["うち"],["に"],["不","ふ"],["真実","しんじつ"],["の"],["者","もの"],["が"],["あった"],["と"],["したら"],["、"],["その"],["不","ふ"],["真実","しんじつ"],["によって"],["、"],["神","かみ"],["の"],["真実","しんじつ"],["は"],["無","む"],["に"],["なるで"],["あろう"],["か"],["。"]]},{"verse":4,"text":"断,だんじてそうではない。あらゆる人,ひとを偽,いつわり者,ものとしても、神,かみを真実,しんじつなものとすべきである。それは、「あなたが言葉,ことばを述,のべるときは、義,ぎとせられ、あなたがさばきを受,うけるとき、勝利,しょうりを得,えるため」と書,かいてあるとおりである。","tok":[["断じて","だんじて"],["そう"],["で"],["は"],["ない"],["。"],["あらゆる"],["人","ひと"],["を"],["偽わり","いつわり"],["者","もの"],["として"],["も"],["、"],["神","かみ"],["を"],["真実","しんじつ"],["な"],["もの"],["と"],["すべきで"],["ある"],["。"],["それ"],["は"],["、"],["「"],["あなた"],["が"],["言葉","ことば"],["を"],["述べる","のべる"],["とき"],["は"],["、"],["義","ぎ"],["と"],["せられ"],["、"],["あなた"],["が"],["さばき"],["を"],["受る","うける"],["とき"],["、"],["勝利","しょうり"],["を"],["得る","える"],["ため"],["」"],["と"],["書いて","かいて"],["ある"],["とおり"],["で"],["ある"],["。"]]},{"verse":5,"text":"しかし、もしわたしたちの不義,ふぎが、神,かみの義,ぎを明,あきらかにするとしたら、なんと言,いうべきか。怒,いかりを下,くだす神,かみは、不義,ふぎであると言,いうのか（これは人間,にんげん的,てきな言,いい方,かたではある）。","tok":[["しかし"],["、"],["もし"],["わたしたち"],["の"],["不義","ふぎ"],["が"],["、"],["神","かみ"],["の"],["義","ぎ"],["を"],["明か","あきらか"],["に"],["する"],["と"],["したら"],["、"],["なん"],["と"],["言うべき","いうべき"],["か"],["。"],["怒り","いかり"],["を"],["下す","くだす"],["神","かみ"],["は"],["、"],["不義","ふぎ"],["で"],["ある"],["と"],["言う","いう"],["の"],["か"],["（"],["これ"],["は"],["人間的","にんげんてき"],["な"],["言い方","いいかた"],["で"],["は"],["ある"],["）"],["。"]]},{"verse":6,"text":"断,だんじてそうではない。もしそうであったら、神,かみはこの世,よを、どうさばかれるだろうか。","tok":[["断じて","だんじて"],["そう"],["で"],["は"],["ない"],["。"],["もし"],["そう"],["で"],["あったら"],["、"],["神","かみ"],["は"],["この世","このよ"],["を"],["、"],["どう"],["さばかれるだろう"],["か"],["。"]]},{"verse":7,"text":"しかし、もし神,かみの真実,しんじつが、わたしの偽,いつわりによりいっそう明,あきらかにされて、神,かみの栄光,えいこうとなるなら、どうして、わたしはなおも罪人,つみびととしてさばかれるのだろうか。","tok":[["しかし"],["、"],["もし"],["神","かみ"],["の"],["真実","しんじつ"],["が"],["、"],["わたし"],["の"],["偽わり","いつわり"],["に"],["より"],["いっそう"],["明か","あきらか"],["に"],["されて"],["、"],["神","かみ"],["の"],["栄光","えいこう"],["と"],["なるなら"],["、"],["どう"],["して"],["、"],["わたし"],["は"],["なお"],["も"],["罪人","つみび"],["と"],["として"],["さばかれる"],["の"],["だろう"],["か"],["。"]]},{"verse":8,"text":"むしろ、「善,ぜんをきたらせるために、わたしたちは悪,あくをしようではないか」（わたしたちがそう言,いっていると、ある人々,ひとびとはそしっている）。彼,かれらが罰,ばっせられるのは当然,とうぜんである。","tok":[["むしろ"],["、"],["「"],["善","ぜん"],["を"],["きたらせる"],["ため"],["に"],["、"],["わたしたち"],["は"],["悪","あく"],["を"],["しようで"],["は"],["ない"],["か"],["」"],["（"],["わたしたち"],["が"],["そう"],["言って","いって"],["いる"],["と"],["、"],["ある"],["人々","ひとびと"],["は"],["そしって"],["いる"],["）"],["。"],["彼","かれ"],["ら"],["が"],["罰せられる","ばっせられる"],["の"],["は"],["当然","とうぜん"],["で"],["ある"],["。"]]},{"verse":9,"text":"すると、どうなるのか。わたしたちには何,なにかまさったところがあるのか。絶対,ぜったいにない。ユダヤ人,じんもギリシヤ人,じんも、ことごとく罪,つみの下,もとにあることを、わたしたちはすでに指摘,してきした。","tok":[["する"],["と"],["、"],["どう"],["なる"],["の"],["か"],["。"],["わたしたち"],["に"],["は"],["何に","なに"],["か"],["まさった"],["ところ"],["が"],["ある"],["の"],["か"],["。"],["絶対","ぜったい"],["に"],["ない"],["。"],["ユダヤ人","ゆだやじん"],["も"],["ギリシヤ"],["人","じん"],["も"],["、"],["ことごとく"],["罪","つみ"],["の"],["下","もと"],["に"],["ある"],["こと"],["を"],["、"],["わたしたち"],["は"],["すでに"],["指摘","してき"],["した"],["。"]]},{"verse":10,"text":"次,つぎのように書,かいてある、「義人,ぎじんはいない、ひとりもいない。","tok":[["次","つぎ"],["の"],["よう"],["に"],["書いて","かいて"],["ある"],["、"],["「"],["義人","ぎじん"],["は"],["いない"],["、"],["ひとり"],["も"],["いない"],["。"]]},{"verse":11,"text":"悟,さとりのある人,ひとはいない、神,かみを求,もとめる人,ひとはいない。","tok":[["悟り","さとり"],["の"],["ある"],["人","ひと"],["は"],["いない"],["、"],["神","かみ"],["を"],["求める","もとめる"],["人","ひと"],["は"],["いない"],["。"]]},{"verse":12,"text":"すべての人,ひとは迷,まよい出,でて、ことごとく無益,むえきなものになっている。善,ぜんを行,おこなう者,ものはいない、ひとりもいない。","tok":[["すべて"],["の"],["人","ひと"],["は"],["迷い出て","まよいでて"],["、"],["ことごとく"],["無益","むえき"],["な"],["もの"],["に"],["なって"],["いる"],["。"],["善","ぜん"],["を"],["行なう","おこなう"],["者","もの"],["は"],["いない"],["、"],["ひとり"],["も"],["いない"],["。"]]},{"verse":13,"text":"彼,かれらののどは、開,ひらいた墓,はかであり、彼,かれらは、その舌,したで人,ひとを欺,あざむき、彼,かれらのくちびるには、まむしの毒,どくがあり、","tok":[["彼","かれ"],["ら"],["の"],["のど"],["は"],["、"],["開らいた","ひらいた"],["墓","はか"],["で"],["あり"],["、"],["彼","かれ"],["ら"],["は"],["、"],["その"],["舌","した"],["で"],["人","ひと"],["を"],["欺き","あざむき"],["、"],["彼","かれ"],["ら"],["の"],["くちびる"],["に"],["は"],["、"],["まむし"],["の"],["毒","どく"],["が"],["あり"],["、"]]},{"verse":14,"text":"彼,かれらの口,くちは、のろいと苦,にがい言葉,ことばとで満,みちている。","tok":[["彼","かれ"],["ら"],["の"],["口","くち"],["は"],["、"],["のろい"],["と"],["苦い","にがい"],["言葉","ことば"],["と"],["で"],["満ちて","みちて"],["いる"],["。"]]},{"verse":15,"text":"彼,かれらの足,あしは、血,ちを流,ながすのに速,はやく、","tok":[["彼","かれ"],["ら"],["の"],["足","あし"],["は"],["、"],["血","ち"],["を"],["流す","ながす"],["のに"],["速く","はやく"],["、"]]},{"verse":16,"text":"彼,かれらの道,みちには、破壊,はかいと悲惨,ひさんとがある。","tok":[["彼","かれ"],["ら"],["の"],["道","みち"],["に"],["は"],["、"],["破壊","はかい"],["と"],["悲惨","ひさん"],["と"],["が"],["ある"],["。"]]},{"verse":17,"text":"そして、彼,かれらは平和,へいわの道,みちを知,しらない。","tok":[["そして"],["、"],["彼","かれ"],["ら"],["は"],["平和","へいわ"],["の"],["道","みち"],["を"],["知らない","しらない"],["。"]]},{"verse":18,"text":"彼,かれらの目,めの前,まえには、神,かみに対,たいする恐,おそれがない」。","tok":[["彼","かれ"],["ら"],["の"],["目","め"],["の"],["前","まえ"],["に"],["は"],["、"],["神","かみ"],["に"],["対する","たいする"],["恐","おそれ"],["が"],["ない"],["」"],["。"]]},{"verse":19,"text":"さて、わたしたちが知,しっているように、すべて律法,りっぽうの言,いうところは、律法,りっぽうのもとにある者,ものたちに対,たいして語,かたられている。それは、すべての口,くちがふさがれ、全,ぜん世界,せかいが神,かみのさばきに服,ふくするためである。","tok":[["さて"],["、"],["わたしたち"],["が"],["知って","しって"],["いる"],["よう"],["に"],["、"],["すべて"],["律法","りっぽう"],["の"],["言う","いう"],["ところ"],["は"],["、"],["律法","りっぽう"],["の"],["もと"],["に"],["ある"],["者","もの"],["たち"],["に対して","にたいして"],["語られて","かたられて"],["いる"],["。"],["それ"],["は"],["、"],["すべて"],["の"],["口","くち"],["が"],["ふさがれ"],["、"],["全","ぜん"],["世界","せかい"],["が"],["神","かみ"],["の"],["さばき"],["に"],["服する","ふくする"],["ため"],["で"],["ある"],["。"]]},{"verse":20,"text":"なぜなら、律法,りっぽうを行,おこなうことによっては、すべての人間,にんげんは神,かみの前,まえに義,ぎとせられないからである。律法,りっぽうによっては、罪,つみの自覚,じかくが生,しょうじるのみである。","tok":[["なぜ"],["なら"],["、"],["律法","りっぽう"],["を"],["行なう","おこなう"],["こと"],["によって"],["は"],["、"],["すべて"],["の"],["人間","にんげん"],["は"],["神","かみ"],["の"],["前","まえ"],["に"],["義","ぎ"],["と"],["せられない"],["から"],["で"],["ある"],["。"],["律法","りっぽう"],["によって"],["は"],["、"],["罪","つみ"],["の"],["自覚","じかく"],["が"],["生じる","しょうじる"],["のみ"],["で"],["ある"],["。"]]},{"verse":21,"text":"しかし今,いまや、神,かみの義,ぎが、律法,りっぽうとは別,べつに、しかも律法,りっぽうと預言者,よげんしゃとによってあかしされて、現,あらわされた。","tok":[["しかし"],["今","いま"],["や"],["、"],["神","かみ"],["の"],["義","ぎ"],["が"],["、"],["律法","りっぽう"],["と"],["は"],["別","べつ"],["に"],["、"],["しかも"],["律法","りっぽう"],["と"],["預言者","よげんしゃ"],["と"],["によって"],["あかし"],["されて"],["、"],["現わされた","あらわされた"],["。"]]},{"verse":22,"text":"それは、イエス・キリストを信,しんじる信仰,しんこうによる神,かみの義,ぎであって、すべて信,しんじる人,ひとに与,あたえられるものである。そこにはなんらの差別,さべつもない。","tok":[["それ"],["は"],["、"],["イエス"],["・"],["キリスト"],["を"],["信じる","しんじる"],["信仰","しんこう"],["に"],["よる"],["神","かみ"],["の"],["義","ぎ"],["で"],["あって"],["、"],["すべて"],["信じる","しんじる"],["人","ひと"],["に"],["与えられる","あたえられる"],["もの"],["で"],["ある"],["。"],["そこ"],["に"],["は"],["なん"],["ら"],["の"],["差別","さべつ"],["も"],["ない"],["。"]]},{"verse":23,"text":"すなわち、すべての人,ひとは罪,つみを犯,おかしたため、神,かみの栄光,えいこうを受,うけられなくなっており、","tok":[["すなわち"],["、"],["すべて"],["の"],["人","ひと"],["は"],["罪","つみ"],["を"],["犯した","おかした"],["ため"],["、"],["神","かみ"],["の"],["栄光","えいこう"],["を"],["受られなく","うけられなく"],["なって"],["おり"],["、"]]},{"verse":24,"text":"彼,かれらは、価,あたいなしに、神,かみの恵,めぐみにより、キリスト・イエスによるあがないによって義,ぎとされるのである。","tok":[["彼","かれ"],["ら"],["は"],["、"],["価","あたい"],["なし"],["に"],["、"],["神","かみ"],["の"],["恵","めぐみ"],["に"],["より"],["、"],["キリスト"],["・"],["イエス"],["に"],["よる"],["あがない"],["によって"],["義","ぎ"],["と"],["される"],["ので"],["ある"],["。"]]},{"verse":25,"text":"神,かみはこのキリストを立,たてて、その血,ちによる、信仰,しんこうをもって受,うくべきあがないの供,そなえ物,ものとされた。それは神,かみの義,ぎを示,しめすためであった。すなわち、今,いままでに犯,おかされた罪,つみを、神,かみは忍耐,にんたいをもって見,みのがしておられたが、","tok":[["神","かみ"],["は"],["この"],["キリスト"],["を"],["立てて","たてて"],["、"],["その"],["血","ち"],["に"],["よる"],["、"],["信仰","しんこう"],["を"],["もって"],["受","うくべきあ"],["が"],["ない"],["の"],["供え物","そなえもの"],["と"],["された"],["。"],["それ"],["は"],["神","かみ"],["の"],["義","ぎ"],["を"],["示めす","しめす"],["ため"],["で"],["あった"],["。"],["すなわち"],["、"],["今まで","いままで"],["に"],["犯された","おかされた"],["罪","つみ"],["を"],["、"],["神","かみ"],["は"],["忍耐","にんたい"],["を"],["もって"],["見のがして","みのがして"],["おられた"],["が"],["、"]]},{"verse":26,"text":"それは、今,いまの時,ときに、神,かみの義,ぎを示,しめすためであった。こうして、神,かみみずからが義,ぎとなり、さらに、イエスを信,しんじる者,ものを義,ぎとされるのである。","tok":[["それ"],["は"],["、"],["今","いま"],["の"],["時","とき"],["に"],["、"],["神","かみ"],["の"],["義","ぎ"],["を"],["示めす","しめす"],["ため"],["で"],["あった"],["。"],["こう"],["して"],["、"],["神","かみ"],["みずから"],["が"],["義","ぎ"],["と"],["なり"],["、"],["さらに"],["、"],["イエス"],["を"],["信じる","しんじる"],["者","もの"],["を"],["義","ぎ"],["と"],["される"],["ので"],["ある"],["。"]]},{"verse":27,"text":"すると、どこにわたしたちの誇,ほこりがあるのか。全,まったくない。なんの法則,ほうそくによってか。行,おこないの法則,ほうそくによってか。そうではなく、信仰,しんこうの法則,ほうそくによってである。","tok":[["する"],["と"],["、"],["どこ"],["に"],["わたしたち"],["の"],["誇","ほこり"],["が"],["ある"],["の"],["か"],["。"],["全く","まったく"],["ない"],["。"],["なん"],["の"],["法則","ほうそく"],["によって"],["か"],["。"],["行ない","おこない"],["の"],["法則","ほうそく"],["によって"],["か"],["。"],["そう"],["で"],["は"],["なく"],["、"],["信仰","しんこう"],["の"],["法則","ほうそく"],["によって"],["で"],["ある"],["。"]]},{"verse":28,"text":"わたしたちは、こう思,おもう。人,ひとが義,ぎとされるのは、律法,りっぽうの行,おこないによるのではなく、信仰,しんこうによるのである。","tok":[["わたしたち"],["は"],["、"],["こう"],["思う","おもう"],["。"],["人","ひと"],["が"],["義","ぎ"],["と"],["される"],["の"],["は"],["、"],["律法","りっぽう"],["の"],["行ない","おこない"],["に"],["よる"],["ので"],["は"],["なく"],["、"],["信仰","しんこう"],["に"],["よる"],["ので"],["ある"],["。"]]},{"verse":29,"text":"それとも、神,かみはユダヤ人,じんだけの神,かみであろうか。また、異邦人,いほうじんの神,かみであるのではないか。確,たしかに、異邦人,いほうじんの神,かみでもある。","tok":[["それ"],["と"],["も"],["、"],["神","かみ"],["は"],["ユダヤ人","ゆだやじん"],["だけ"],["の"],["神","かみ"],["で"],["あろう"],["か"],["。"],["また"],["、"],["異邦人","いほうじん"],["の"],["神","かみ"],["で"],["ある"],["ので"],["は"],["ない"],["か"],["。"],["確か","たしか"],["に"],["、"],["異邦人","いほうじん"],["の"],["神","かみ"],["で"],["も"],["ある"],["。"]]},{"verse":30,"text":"まことに、神,かみは唯一,ゆいいつであって、割礼,かつれいのある者,ものを信仰,しんこうによって義,ぎとし、また、無,む割礼,かつれいの者,ものをも信仰,しんこうのゆえに義,ぎとされるのである。","tok":[["まこと"],["に"],["、"],["神","かみ"],["は"],["唯一","ゆいいつ"],["で"],["あって"],["、"],["割礼","かつれい"],["の"],["ある"],["者","もの"],["を"],["信仰","しんこう"],["によって"],["義","ぎ"],["と"],["し"],["、"],["また"],["、"],["無","む"],["割礼","かつれい"],["の"],["者","もの"],["を"],["も"],["信仰","しんこう"],["の"],["ゆえ"],["に"],["義","ぎ"],["と"],["される"],["ので"],["ある"],["。"]]},{"verse":31,"text":"すると、信仰,しんこうのゆえに、わたしたちは律法,りっぽうを無効,むこうにするのであるか。断,だんじてそうではない。かえって、それによって律法,りっぽうを確立,かくりつするのである。","tok":[["する"],["と"],["、"],["信仰","しんこう"],["の"],["ゆえ"],["に"],["、"],["わたしたち"],["は"],["律法","りっぽう"],["を"],["無効","むこう"],["に"],["する"],["ので"],["ある"],["か"],["。"],["断じて","だんじて"],["そう"],["で"],["は"],["ない"],["。"],["かえって"],["、"],["それ"],["によって"],["律法","りっぽう"],["を"],["確立","かくりつ"],["する"],["ので"],["ある"],["。"]]}]
[{"verse":1,"text":"このように、わたしたちは、信仰,しんこうによって義,ぎとされたのだから、わたしたちの主,しゅイエス・キリストにより、神,かみに対,たいして平和,へいわを得,えている。","tok":[["この"],["よう"],["に"],["、"],["わたしたち"],["は"],["、"],["信仰","しんこう"],["によって"],["義","ぎ"],["と"],["された"],["の"],["だ"],["から"],["、"],["わたしたち"],["の"],["主","しゅ"],["イエス"],["・"],["キリスト"],["に"],["より"],["、"],["神","かみ"],["に対して","にたいして"],["平和","へいわ"],["を"],["得て","えて"],["いる"],["。"]]},{"verse":2,"text":"わたしたちは、さらに彼,かれにより、いま立,たっているこの恵,めぐみに信仰,しんこうによって導,みちびき入,いれられ、そして、神,かみの栄光,えいこうにあずかる希望,きぼうをもって喜,よろこんでいる。","tok":[["わたしたち"],["は"],["、"],["さらに"],["彼","かれ"],["に"],["より"],["、"],["いま"],["立って","たって"],["いる"],["この"],["恵","めぐみ"],["に"],["信仰","しんこう"],["によって"],["導き入れられ","みちびきいれられ"],["、"],["そして"],["、"],["神","かみ"],["の"],["栄光","えいこう"],["に"],["あずかる"],["希望","きぼう"],["を"],["もって"],["喜こんで","よろこんで"],["いる"],["。"]]},{"verse":3,"text":"それだけではなく、患難,かんなんをも喜,よろこんでいる。なぜなら、患難,かんなんは忍耐,にんたいを生,うみ出,だし、","tok":[["それ"],["だけ"],["で"],["は"],["なく"],["、"],["患難","かんなん"],["を"],["も"],["喜こんで","よろこんで"],["いる"],["。"],["なぜ"],["なら"],["、"],["患難","かんなん"],["は"],["忍耐","にんたい"],["を"],["生み出し","うみだし"],["、"]]},{"verse":4,"text":"忍耐,にんたいは錬達,れんたつを生,うみ出,だし、錬達,れんたつは希望,きぼうを生,うみ出,だすことを、知,しっているからである。","tok":[["忍耐","にんたい"],["は"],["錬達","れんたつ"],["を"],["生み出し","うみだし"],["、"],["錬達","れんたつ"],["は"],["希望","きぼう"],["を"],["生み出す","うみだす"],["こと"],["を"],["、"],["知って","しって"],["いる"],["から"],["で"],["ある"],["。"]]},{"verse":5,"text":"そして、希望,きぼうは失望,しつぼうに終,おわることはない。なぜなら、わたしたちに賜,たまわっている聖霊,せいれいによって、神,かみの愛,あいがわたしたちの心,こころに注,そそがれているからである。","tok":[["そして"],["、"],["希望","きぼう"],["は"],["失望","しつぼう"],["に"],["終わる","おわる"],["こと"],["は"],["ない"],["。"],["なぜ"],["なら"],["、"],["わたしたち"],["に"],["賜わって","たまわって"],["いる"],["聖霊","せいれい"],["によって"],["、"],["神","かみ"],["の"],["愛","あい"],["が"],["わたしたち"],["の"],["心","こころ"],["に"],["注がれて","そそがれて"],["いる"],["から"],["で"],["ある"],["。"]]},{"verse":6,"text":"わたしたちがまだ弱,よわかったころ、キリストは、時,ときいたって、不信心,ふしんじんな者,ものたちのために死,しんで下,くださったのである。","tok":[["わたしたち"],["が"],["まだ"],["弱かった","よわかった"],["ころ"],["、"],["キリスト"],["は"],["、"],["時","とき"],["いたって"],["、"],["不信心","ふしんじん"],["な"],["者","もの"],["たち"],["の"],["ため"],["に"],["死んで","しんで"],["下さった","くださった"],["ので"],["ある"],["。"]]},{"verse":7,"text":"正,ただしい人,ひとのために死,しぬ者,ものは、ほとんどいないであろう。善人,ぜんにんのためには、進,すすんで死,しぬ者,ものもあるいはいるであろう。","tok":[["正い","ただしい"],["人","ひと"],["の"],["ため"],["に"],["死ぬ","しぬ"],["者","もの"],["は"],["、"],["ほとんど"],["いないで"],["あろう"],["。"],["善人","ぜんにん"],["の"],["ため"],["に"],["は"],["、"],["進","す"],["すんで"],["死ぬ","しぬ"],["者","もの"],["も"],["あるいは"],["いるで"],["あろう"],["。"]]},{"verse":8,"text":"しかし、まだ罪人,つみびとであった時,とき、わたしたちのためにキリストが死,しんで下,くださったことによって、神,かみはわたしたちに対,たいする愛,あいを示,しめされたのである。","tok":[["しかし"],["、"],["まだ"],["罪人","つみび"],["と"],["であった"],["時","とき"],["、"],["わたしたち"],["の"],["ため"],["に"],["キリスト"],["が"],["死んで","しんで"],["下さった","くださった"],["こと"],["によって"],["、"],["神","かみ"],["は"],["わたしたち"],["に"],["対する","たいする"],["愛","あい"],["を"],["示めされた","しめされた"],["ので"],["ある"],["。"]]},{"verse":9,"text":"わたしたちは、キリストの血,ちによって今,いまは義,ぎとされているのだから、なおさら、彼,かれによって神,かみの怒,いかりから救,すくわれるであろう。","tok":[["わたしたち"],["は"],["、"],["キリスト"],["の"],["血","ち"],["によって"],["今","いま"],["は"],["義","ぎ"],["と"],["されて"],["いる"],["の"],["だ"],["から"],["、"],["なおさら"],["、"],["彼","かれ"],["によって"],["神","かみ"],["の"],["怒り","いかり"],["から"],["救われるで","すくわれるで"],["あろう"],["。"]]},{"verse":10,"text":"もし、わたしたちが敵,てきであった時,ときでさえ、御子,みこの死,しによって神,かみとの和解,わかいを受,うけたとすれば、和解,わかいを受,うけている今,いまは、なおさら、彼,かれのいのちによって救,すくわれるであろう。","tok":[["もし"],["、"],["わたしたち"],["が"],["敵","てき"],["で"],["あった"],["時","とき"],["で"],["さえ"],["、"],["御子","みこ"],["の"],["死","し"],["によって"],["神","かみ"],["と"],["の"],["和解","わかい"],["を"],["受た","うけた"],["と"],["すれば"],["、"],["和解","わかい"],["を"],["受て","うけて"],["いる"],["今","いま"],["は"],["、"],["なおさら"],["、"],["彼","かれ"],["の"],["いのち"],["によって"],["救われるで","すくわれるで"],["あろう"],["。"]]},{"verse":11,"text":"そればかりではなく、わたしたちは、今,いまや和解,わかいを得,えさせて下,くださったわたしたちの主,しゅイエス・キリストによって、神,かみを喜,よろこぶのである。","tok":[["それ"],["ばかり"],["で"],["は"],["なく"],["、"],["わたしたち"],["は"],["、"],["今","いま"],["や"],["和解","わかい"],["を"],["得させて","えさせて"],["下さった","くださった"],["わたしたち"],["の"],["主","しゅ"],["イエス"],["・"],["キリスト"],["によって"],["、"],["神","かみ"],["を"],["喜こぶ","よろこぶ"],["ので"],["ある"],["。"]]},{"verse":12,"text":"このようなわけで、ひとりの人,ひとによって、罪,つみがこの世,よにはいり、また罪,つみによって死,しがはいってきたように、こうして、すべての人,ひとが罪,つみを犯,おかしたので、死,しが全,ぜん人類,じんるいにはいり込,こんだのである。","tok":[["この"],["よう"],["な"],["わけ"],["で"],["、"],["ひとり"],["の"],["人","ひと"],["によって"],["、"],["罪","つみ"],["が"],["この世","このよ"],["に"],["はいり"],["、"],["また"],["罪","つみ"],["によって"],["死","し"],["が"],["はいって"],["きた"],["よう"],["に"],["、"],["こう"],["して"],["、"],["すべて"],["の"],["人","ひと"],["が"],["罪","つみ"],["を"],["犯した","おかした"],["ので"],["、"],["死","し"],["が"],["全","ぜん"],["人類","じんるい"],["に"],["はいり"],["込","こんだ"],["ので"],["ある"],["。"]]},{"verse":13,"text":"というのは、律法,りっぽう以前,いぜんにも罪,つみは世,よにあったが、律法,りっぽうがなければ、罪,つみは罪,つみとして認,みとめられないのである。","tok":[["と"],["いう"],["の"],["は"],["、"],["律法","りっぽう"],["以前","いぜん"],["に"],["も"],["罪","つみ"],["は"],["世","よ"],["に"],["あった"],["が"],["、"],["律法","りっぽう"],["が"],["なければ"],["、"],["罪","つみ"],["は"],["罪","つみ"],["として"],["認められない","みとめられない"],["ので"],["ある"],["。"]]},{"verse":14,"text":"しかし、アダムからモーセまでの間,あいだにおいても、アダムの違反,いはんと同,おなじような罪,つみを犯,おかさなかった者,ものも、死,しの支配,しはいを免,まぬがれなかった。このアダムは、きたるべき者,ものの型,かたである。","tok":[["しかし"],["、"],["アダム"],["から"],["モーセ"],["まで"],["の"],["間","あいだ"],["に"],["おいて"],["も"],["、"],["アダム"],["の"],["違反","いはん"],["と"],["同じ","おなじ"],["よう"],["な"],["罪","つみ"],["を"],["犯さなかった","おかさなかった"],["者","もの"],["も"],["、"],["死","し"],["の"],["支配","しはい"],["を"],["免がれなかった","まぬがれなかった"],["。"],["この"],["アダム"],["は"],["、"],["きたるべき"],["者","もの"],["の"],["型","かた"],["で"],["ある"],["。"]]},{"verse":15,"text":"しかし、恵,めぐみの賜物,たまものは罪過,ざいかの場合,ばあいとは異,ことなっている。すなわち、もしひとりの罪過,ざいかのために多,おおくの人,ひとが死,しんだとすれば、まして、神,かみの恵,めぐみと、ひとりの人,ひとイエス・キリストの恵,めぐみによる賜物,たまものとは、さらに豊,ゆたかに多,おおくの人々,ひとびとに満,みちあふれたはずではないか。","tok":[["しかし"],["、"],["恵","めぐみ"],["の"],["賜物","たまもの"],["は"],["罪過","ざいか"],["の"],["場合","ばあい"],["と"],["は"],["異なって","ことなって"],["いる"],["。"],["すなわち"],["、"],["もし"],["ひとり"],["の"],["罪過","ざいか"],["の"],["ため"],["に"],["多く","おおく"],["の"],["人","ひと"],["が"],["死んだ","しんだ"],["と"],["すれば"],["、"],["まして"],["、"],["神","かみ"],["の"],["恵","めぐみ"],["と"],["、"],["ひとり"],["の"],["人","ひと"],["イエス"],["・"],["キリスト"],["の"],["恵","めぐみ"],["に"],["よる"],["賜物","たまもの"],["と"],["は"],["、"],["さらに"],["豊","ゆたか"],["に"],["多く","おおく"],["の"],["人々","ひとびと"],["に"],["満ちあふれた","みちあふれた"],["はず"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":16,"text":"かつ、この賜物,たまものは、ひとりの犯,おかした罪,つみの結果,けっかとは異,ことなっている。なぜなら、さばきの場合,ばあいは、ひとりの罪過,ざいかから、罪,つみに定,さだめることになったが、恵,めぐみの場合,ばあいには、多,おおくの人,ひとの罪過,ざいかから、義,ぎとする結果,けっかになるからである。","tok":[["かつ"],["、"],["この"],["賜物","たまもの"],["は"],["、"],["ひとり"],["の"],["犯した","おかした"],["罪","つみ"],["の"],["結果","けっか"],["と"],["は"],["異なって","ことなって"],["いる"],["。"],["なぜ"],["なら"],["、"],["さばき"],["の"],["場合","ばあい"],["は"],["、"],["ひとり"],["の"],["罪過","ざいか"],["から"],["、"],["罪","つみ"],["に"],["定める","さだめる"],["こと"],["に"],["なった"],["が"],["、"],["恵","めぐみ"],["の"],["場合","ばあい"],["に"],["は"],["、"],["多く","おおく"],["の"],["人","ひと"],["の"],["罪過","ざいか"],["から"],["、"],["義","ぎ"],["と"],["する"],["結果","けっか"],["に"],["なる"],["から"],["で"],["ある"],["。"]]},{"verse":17,"text":"もし、ひとりの罪過,ざいかによって、そのひとりをとおして死,しが支配,しはいするに至,いたったとすれば、まして、あふれるばかりの恵,めぐみと義,ぎの賜物,たまものとを受,うけている者,ものたちは、ひとりのイエス・キリストをとおし、いのちにあって、さらに力強,ちからづよく支配,しはいするはずではないか。","tok":[["もし"],["、"],["ひとり"],["の"],["罪過","ざいか"],["によって"],["、"],["その"],["ひとり"],["を"],["とおして"],["死","し"],["が"],["支配","しはい"],["する"],["に"],["至った","いたった"],["と"],["すれば"],["、"],["まして"],["、"],["あふれる"],["ばかり"],["の"],["恵","めぐみ"],["と"],["義","ぎ"],["の"],["賜物","たまもの"],["と"],["を"],["受て","うけて"],["いる"],["者","もの"],["たち"],["は"],["、"],["ひとり"],["の"],["イエス"],["・"],["キリスト"],["を"],["とおし"],["、"],["いのち"],["に"],["あって"],["、"],["さらに"],["力強く","ちからづよく"],["支配","しはい"],["する"],["はず"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":18,"text":"このようなわけで、ひとりの罪過,ざいかによってすべての人,ひとが罪,つみに定,さだめられたように、ひとりの義,ぎなる行為,こういによって、いのちを得,えさせる義,ぎがすべての人,ひとに及,およぶのである。","tok":[["この"],["よう"],["な"],["わけ"],["で"],["、"],["ひとり"],["の"],["罪過","ざいか"],["によって"],["すべて"],["の"],["人","ひと"],["が"],["罪","つみ"],["に"],["定められた","さだめられた"],["よう"],["に"],["、"],["ひとり"],["の"],["義","ぎ"],["なる"],["行為","こうい"],["によって"],["、"],["いのち"],["を"],["得させる","えさせる"],["義","ぎ"],["が"],["すべて"],["の"],["人","ひと"],["に"],["及ぶ","およぶ"],["ので"],["ある"],["。"]]},{"verse":19,"text":"すなわち、ひとりの人,ひとの不,ふ従順,じゅうじゅんによって、多,おおくの人,ひとが罪人,つみびととされたと同,おなじように、ひとりの従順,じゅうじゅんによって、多,おおくの人,ひとが義人,ぎじんとされるのである。","tok":[["すなわち"],["、"],["ひとり"],["の"],["人","ひと"],["の"],["不","ふ"],["従順","じゅうじゅん"],["によって"],["、"],["多く","おおく"],["の"],["人","ひと"],["が"],["罪人","つみび"],["と"],["と"],["された"],["と"],["同じ","おなじ"],["よう"],["に"],["、"],["ひとり"],["の"],["従順","じゅうじゅん"],["によって"],["、"],["多く","おおく"],["の"],["人","ひと"],["が"],["義人","ぎじん"],["と"],["される"],["ので"],["ある"],["。"]]},{"verse":20,"text":"律法,りっぽうがはいり込,こんできたのは、罪過,ざいかの増,まし加,くわわるためである。しかし、罪,つみの増,まし加,くわわったところには、恵,めぐみもますます満,みちあふれた。","tok":[["律法","りっぽう"],["が"],["はいり"],["込","こんできた"],["の"],["は"],["、"],["罪過","ざいか"],["の"],["増し","まし"],["加わわる","くわわる"],["ため"],["で"],["ある"],["。"],["しかし"],["、"],["罪","つみ"],["の"],["増し","まし"],["加わわった","くわわった"],["ところ"],["に"],["は"],["、"],["恵み","めぐみ"],["も"],["ますます"],["満ちあふれた","みちあふれた"],["。"]]},{"verse":21,"text":"それは、罪,つみが死,しによって支配,しはいするに至,いたったように、恵,めぐみもまた義,ぎによって支配,しはいし、わたしたちの主,しゅイエス・キリストにより、永遠,えいえんのいのちを得,えさせるためである。","tok":[["それ"],["は"],["、"],["罪","つみ"],["が"],["死","し"],["によって"],["支配","しはい"],["する"],["に"],["至った","いたった"],["よう"],["に"],["、"],["恵","めぐみ"],["も"],["また"],["義","ぎ"],["によって"],["支配","しはい"],["し"],["、"],["わたしたち"],["の"],["主","しゅ"],["イエス"],["・"],["キリスト"],["に"],["より"],["、"],["永遠","えいえん"],["の"],["いのち"],["を"],["得させる","えさせる"],["ため"],["で"],["ある"],["。"]]}]
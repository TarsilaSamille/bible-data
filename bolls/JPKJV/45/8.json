[{"verse":1,"text":"こういうわけで、今,いまやキリスト・イエスにある者,ものは罪,つみに定,さだめられることがない。","tok":[["こう"],["いう"],["わけ"],["で"],["、"],["今","いま"],["や"],["キリスト"],["・"],["イエス"],["に"],["ある"],["者","もの"],["は"],["罪","つみ"],["に"],["定められる","さだめられる"],["こと"],["が"],["ない"],["。"]]},{"verse":2,"text":"なぜなら、キリスト・イエスにあるいのちの御霊,みたまの法則,ほうそくは、罪,つみと死,しとの法則,ほうそくからあなたを解放,かいほうしたからである。","tok":[["なぜ"],["なら"],["、"],["キリスト"],["・"],["イエス"],["に"],["ある"],["いのち"],["の"],["御霊","みたま"],["の"],["法則","ほうそく"],["は"],["、"],["罪","つみ"],["と"],["死","し"],["と"],["の"],["法則","ほうそく"],["から"],["あなた"],["を"],["解放","かいほう"],["した"],["から"],["で"],["ある"],["。"]]},{"verse":3,"text":"律法,りっぽうが肉,にくにより無力,むりょくになっているためになし得,えなかった事,ことを、神,かみはなし遂,とげて下,くださった。すなわち、御子,みこを、罪,つみの肉,にくの様,さまで罪,つみのためにつかわし、肉,にくにおいて罪,つみを罰,ばっせられたのである。","tok":[["律法","りっぽう"],["が"],["肉","にく"],["に"],["より"],["無力","むりょく"],["に"],["なって"],["いる"],["ため"],["に"],["なし"],["得なかった","えなかった"],["事","こと"],["を"],["、"],["神","かみ"],["は"],["なし遂げて","なしとげて"],["下さった","くださった"],["。"],["すなわち"],["、"],["御子","みこ"],["を"],["、"],["罪","つみ"],["の"],["肉","にく"],["の"],["様","さ"],["まで"],["罪","つみ"],["の"],["ため"],["に"],["つかわし"],["、"],["肉","にく"],["に"],["おいて"],["罪","つみ"],["を"],["罰せられた","ばっせられた"],["ので"],["ある"],["。"]]},{"verse":4,"text":"これは律法,りっぽうの要求,ようきゅうが、肉,にくによらず霊,れいによって歩,あるくわたしたちにおいて、満,みたされるためである。","tok":[["これ"],["は"],["律法","りっぽう"],["の"],["要求","ようきゅう"],["が"],["、"],["肉","にく"],["に"],["よらず"],["霊","れい"],["によって"],["歩く","あるく"],["わたしたち"],["に"],["おいて"],["、"],["満たされる","みたされる"],["ため"],["で"],["ある"],["。"]]},{"verse":5,"text":"なぜなら、肉,にくに従,したがう者,ものは肉,にくのことを思,おもい、霊,れいに従,したがう者,ものは霊,れいのことを思,おもうからである。","tok":[["なぜ"],["なら"],["、"],["肉","にく"],["に"],["従う","したがう"],["者","もの"],["は"],["肉","にく"],["の"],["こと"],["を"],["思い","おもい"],["、"],["霊","れい"],["に"],["従う","したがう"],["者","もの"],["は"],["霊","れい"],["の"],["こと"],["を"],["思","おもう"],["から"],["で"],["ある"],["。"]]},{"verse":6,"text":"肉,にくの思,おもいは死,しであるが、霊,れいの思,おもいは、いのちと平安,へいあんとである。","tok":[["肉","にく"],["の"],["思い","おもい"],["は"],["死","し"],["で"],["ある"],["が"],["、"],["霊","れい"],["の"],["思い","おもい"],["は"],["、"],["いのち"],["と"],["平安","へいあん"],["と"],["で"],["ある"],["。"]]},{"verse":7,"text":"なぜなら、肉,にくの思,おもいは神,かみに敵,てきするからである。すなわち、それは神,かみの律法,りっぽうに従,したがわず、否,いな、従,したがい得,えないのである。","tok":[["なぜ"],["なら"],["、"],["肉","にく"],["の"],["思い","おもい"],["は"],["神","かみ"],["に"],["敵する","てきする"],["から"],["で"],["ある"],["。"],["すなわち"],["、"],["それ"],["は"],["神","かみ"],["の"],["律法","りっぽう"],["に"],["従わず","したがわず"],["、"],["否","いな"],["、"],["従い","したがい"],["得ない","えない"],["ので"],["ある"],["。"]]},{"verse":8,"text":"また、肉,にくにある者,ものは、神,かみを喜,よろこばせることができない。","tok":[["また"],["、"],["肉","にく"],["に"],["ある"],["者","もの"],["は"],["、"],["神","かみ"],["を"],["喜こばせる","よろこばせる"],["こと"],["が"],["できない"],["。"]]},{"verse":9,"text":"しかし、神,かみの御霊,みたまがあなたがたの内,うちに宿,やどっているなら、あなたがたは肉,にくにおるのではなく、霊,れいにおるのである。もし、キリストの霊,れいを持,もたない人,ひとがいるなら、その人,ひとはキリストのものではない。","tok":[["しかし"],["、"],["神","かみ"],["の"],["御霊","みたまがあなた"],["がた"],["の"],["内","うち"],["に"],["宿って","やどって"],["いるなら"],["、"],["あなた"],["がた"],["は"],["肉","にく"],["に"],["おる"],["ので"],["は"],["なく"],["、"],["霊","れい"],["に"],["おる"],["ので"],["ある"],["。"],["もし"],["、"],["キリスト"],["の"],["霊","れい"],["を"],["持たない","もたない"],["人","ひと"],["が"],["いるなら"],["、"],["その"],["人","ひと"],["は"],["キリスト"],["の"],["もの"],["で"],["は"],["ない"],["。"]]},{"verse":10,"text":"もし、キリストがあなたがたの内,うちにおられるなら、からだは罪,つみのゆえに死,しんでいても、霊,れいは義,ぎのゆえに生,いきているのである。","tok":[["もし"],["、"],["キリスト"],["が"],["あなた"],["がた"],["の"],["内","うち"],["に"],["おられるなら"],["、"],["からだ"],["は"],["罪","つみ"],["の"],["ゆえ"],["に"],["死んで","しんで"],["いて"],["も"],["、"],["霊","れい"],["は"],["義","ぎ"],["の"],["ゆえ"],["に"],["生きて","いきて"],["いる"],["ので"],["ある"],["。"]]},{"verse":11,"text":"もし、イエスを死人,しにんの中,なかからよみがえらせたかたの御霊,みたまが、あなたがたの内,うちに宿,やどっているなら、キリスト・イエスを死人,しにんの中,なかからよみがえらせたかたは、あなたがたの内,うちに宿,やどっている御霊,みたまによって、あなたがたの死,しぬべきからだをも、生,いかしてくださるであろう。","tok":[["もし"],["、"],["イエス"],["を"],["死人","しにん"],["の"],["中","なか"],["から"],["よみがえらせた"],["かた"],["の"],["御霊","み"],["たま"],["が"],["、"],["あなた"],["がた"],["の"],["内","うち"],["に"],["宿って","やどって"],["いるなら"],["、"],["キリスト"],["・"],["イエス"],["を"],["死人","しにん"],["の"],["中","なか"],["から"],["よみがえらせた"],["かた"],["は"],["、"],["あなた"],["がた"],["の"],["内","うち"],["に"],["宿って","やどって"],["いる"],["御霊","みたま"],["によって"],["、"],["あなた"],["がた"],["の"],["死ぬべき","しぬべき"],["からだ"],["を"],["も"],["、"],["生かして","いかして"],["くださるで"],["あろう"],["。"]]},{"verse":12,"text":"それゆえに、兄弟,きょうだいたちよ。わたしたちは、果,はたすべき責任,せきにんを負,おっている者,ものであるが、肉,にくに従,したがって生,いきる責任,せきにんを肉,にくに対,たいして負,おっているのではない。","tok":[["それ"],["ゆえ"],["に"],["、"],["兄弟","きょうだい"],["たち"],["よ"],["。"],["わたしたち"],["は"],["、"],["果たすべき","はたすべき"],["責任","せきにん"],["を"],["負って","おって"],["いる"],["者","もの"],["で"],["ある"],["が"],["、"],["肉","にく"],["に"],["従って","したがって"],["生きる","いきる"],["責任","せきにん"],["を"],["肉","にく"],["に対して","にたいして"],["負って","おって"],["いる"],["ので"],["は"],["ない"],["。"]]},{"verse":13,"text":"なぜなら、もし、肉,にくに従,したがって生,いきるなら、あなたがたは死,しぬ外,ほかはないからである。しかし、霊,れいによってからだの働,はたらきを殺,ころすなら、あなたがたは生,いきるであろう。","tok":[["なぜ"],["なら"],["、"],["もし"],["、"],["肉","にく"],["に"],["従って","したがって"],["生きるなら","いきるなら"],["、"],["あなた"],["がた"],["は"],["死ぬ","しぬ"],["外","ほか"],["は"],["ない"],["から"],["で"],["ある"],["。"],["しかし"],["、"],["霊","れい"],["によって"],["から"],["だ"],["の"],["働らき","はたらき"],["を"],["殺ろすなら","ころすなら"],["、"],["あなた"],["がた"],["は"],["生きるで","いきるで"],["あろう"],["。"]]},{"verse":14,"text":"すべて神,かみの御霊,みたまに導,みちびかれている者,ものは、すなわち、神,かみの子,こである。","tok":[["すべて"],["神","かみ"],["の"],["御霊","みたま"],["に"],["導かれて","みちびかれて"],["いる"],["者","もの"],["は"],["、"],["すなわち"],["、"],["神","かみ"],["の"],["子","こ"],["で"],["ある"],["。"]]},{"verse":15,"text":"あなたがたは再,ふたたび恐,おそれをいだかせる奴隷,どれいの霊,れいを受,うけたのではなく、子,こたる身分,みぶんを授,さづける霊,れいを受,うけたのである。その霊,れいによって、わたしたちは「アバ、父,ちちよ」と呼,よぶのである。","tok":[["あなた"],["がた"],["は"],["再び","ふたたび"],["恐","おそれ"],["を"],["いだかせる"],["奴隷","どれい"],["の"],["霊","れい"],["を"],["受た","うけた"],["ので"],["は"],["なく"],["、"],["子","こ"],["たる"],["身分","みぶん"],["を"],["授","さ"],["づける"],["霊","れい"],["を"],["受た","うけた"],["ので"],["ある"],["。"],["その"],["霊","れい"],["によって"],["、"],["わたしたち"],["は"],["「"],["アバ"],["、"],["父","ちち"],["よ"],["」"],["と"],["呼ぶ","よぶ"],["ので"],["ある"],["。"]]},{"verse":16,"text":"御霊,みたまみずから、わたしたちの霊,れいと共,ともに、わたしたちが神,かみの子,こであることをあかしして下,くださる。","tok":[["御霊","みたまみずか"],["ら"],["、"],["わたしたち"],["の"],["霊","れい"],["と"],["共","とも"],["に"],["、"],["わたしたち"],["が"],["神","かみ"],["の"],["子","こ"],["で"],["ある"],["こと"],["を"],["あかし"],["して"],["下さる","くださる"],["。"]]},{"verse":17,"text":"もし子,こであれば、相続人,そうぞくにんでもある。神,かみの相続人,そうぞくにんであって、キリストと栄光,えいこうを共,ともにするために苦難,くなんをも共,ともにしている以上,いじょう、キリストと共同,きょうどうの相続人,そうぞくにんなのである。","tok":[["もし"],["子","こ"],["で"],["あれば"],["、"],["相続人","そうぞくにん"],["で"],["も"],["ある"],["。"],["神","かみ"],["の"],["相続人","そうぞくにん"],["で"],["あって"],["、"],["キリスト"],["と"],["栄光","えいこう"],["を"],["共","とも"],["に"],["する"],["ため"],["に"],["苦難","くなん"],["を"],["も"],["共","とも"],["に"],["して"],["いる"],["以上","いじょう"],["、"],["キリスト"],["と"],["共同","きょうどう"],["の"],["相続人","そうぞくにん"],["な"],["ので"],["ある"],["。"]]},{"verse":18,"text":"わたしは思,おもう。今,いまのこの時,ときの苦,くるしみは、やがてわたしたちに現,あらわされようとする栄光,えいこうに比,くらべると、言,いうに足,たりない。","tok":[["わたし"],["は"],["思う","おもう"],["。"],["今","いま"],["の"],["この"],["時","とき"],["の"],["苦しみ","くるしみ"],["は"],["、"],["やがて"],["わたしたち"],["に"],["現わされよう","あらわされよう"],["と"],["する"],["栄光","えいこう"],["に"],["比べる","くらべる"],["と"],["、"],["言","いう"],["に"],["足りない","たりない"],["。"]]},{"verse":19,"text":"被,ひ造物,ぞうぶつは、実,じつに、切,せつなる思,おもいで神,かみの子,こたちの出現,しゅつげんを待,まち望,のぞんでいる。","tok":[["被","ひ"],["造物","ぞうぶつ"],["は"],["、"],["実","じつ"],["に"],["、"],["切","せつ"],["なる"],["思い","おもい"],["で"],["神","かみ"],["の"],["子","こ"],["たち"],["の"],["出現","しゅつげん"],["を"],["待ち望んで","まちのぞんで"],["いる"],["。"]]},{"verse":20,"text":"なぜなら、被,ひ造物,ぞうぶつが虚無,きょむに服,ふくしたのは、自分,じぶんの意志,いしによるのではなく、服従,ふくじゅうさせたかたによるのであり、","tok":[["なぜ"],["なら"],["、"],["被","ひ"],["造物","ぞうぶつ"],["が"],["虚無","きょむ"],["に"],["服した","ふくした"],["の"],["は"],["、"],["自分","じぶん"],["の"],["意志","いし"],["に"],["よる"],["ので"],["は"],["なく"],["、"],["服従","ふくじゅう"],["させた"],["かた"],["に"],["よる"],["ので"],["あり"],["、"]]},{"verse":21,"text":"かつ、被,ひ造物,ぞうぶつ自身,じしんにも、滅,ほろびのなわめから解放,かいほうされて、神,かみの子,こたちの栄光,えいこうの自由,じゆうに入,はいる望,のぞみが残,のこされているからである。","tok":[["かつ"],["、"],["被","ひ"],["造物","ぞうぶつ"],["自身","じしん"],["に"],["も"],["、"],["滅び","ほろび"],["の"],["なわ"],["め"],["から"],["解放","かいほう"],["されて"],["、"],["神","かみ"],["の"],["子","こ"],["たち"],["の"],["栄光","えいこう"],["の"],["自由","じゆう"],["に"],["入る","はいる"],["望み","のぞみ"],["が"],["残されて","のこされて"],["いる"],["から"],["で"],["ある"],["。"]]},{"verse":22,"text":"実,じつに、被,ひ造物,ぞうぶつ全体,ぜんたいが、今,いまに至,いたるまで、共,ともにうめき共,ともに産,うみの苦,くるしみを続,つづけていることを、わたしたちは知,しっている。","tok":[["実","じつ"],["に"],["、"],["被","ひ"],["造物","ぞうぶつ"],["全体","ぜんたい"],["が"],["、"],["今","いま"],["に"],["至る","いたる"],["まで"],["、"],["共","とも"],["に"],["うめき"],["共","とも"],["に"],["産み","うみ"],["の"],["苦しみ","くるしみ"],["を"],["続けて","つづけて"],["いる"],["こと"],["を"],["、"],["わたしたち"],["は"],["知って","しって"],["いる"],["。"]]},{"verse":23,"text":"それだけではなく、御霊,みたまの最初,さいしょの実,みを持,もっているわたしたち自身,じしんも、心,こころの内,うちでうめきながら、子,こたる身分,みぶんを授,さづけられること、すなわち、からだのあがなわれることを待,まち望,のぞんでいる。","tok":[["それ"],["だけ"],["で"],["は"],["なく"],["、"],["御霊","みたま"],["の"],["最初","さいしょ"],["の"],["実","み"],["を"],["持って","もって"],["いる"],["わたしたち"],["自身","じしん"],["も"],["、"],["心","こころ"],["の"],["内","うち"],["で"],["うめき"],["ながら"],["、"],["子","こ"],["たる"],["身分","みぶん"],["を"],["授","さ"],["づけられる"],["こと"],["、"],["すなわち"],["、"],["からだ"],["の"],["あがなわれる"],["こと"],["を"],["待ち望んで","まちのぞんで"],["いる"],["。"]]},{"verse":24,"text":"わたしたちは、この望,のぞみによって救,すくわれているのである。しかし、目,めに見,みえる望,のぞみは望,のぞみではない。なぜなら、現,げんに見,みている事,ことを、どうして、なお望,のぞむ人,ひとがあろうか。","tok":[["わたしたち"],["は"],["、"],["この"],["望み","のぞみ"],["によって"],["救われて","すくわれて"],["いる"],["ので"],["ある"],["。"],["しかし"],["、"],["目","め"],["に"],["見える","みえる"],["望み","のぞみ"],["は"],["望み","のぞみ"],["で"],["は"],["ない"],["。"],["なぜ"],["なら"],["、"],["現に","げんに"],["見て","みて"],["いる"],["事","こと"],["を"],["、"],["どう"],["して"],["、"],["なお"],["望む","のぞむ"],["人","ひと"],["が"],["あろう"],["か"],["。"]]},{"verse":25,"text":"もし、わたしたちが見,みないことを望,のぞむなら、わたしたちは忍耐,にんたいして、それを待,まち望,のぞむのである。","tok":[["もし"],["、"],["わたしたち"],["が"],["見ない","みない"],["こと"],["を"],["望むなら","のぞむなら"],["、"],["わたしたち"],["は"],["忍耐","にんたい"],["して"],["、"],["それ"],["を"],["待ち望む","まちのぞむ"],["ので"],["ある"],["。"]]},{"verse":26,"text":"御霊,みたまもまた同,おなじように、弱,よわいわたしたちを助,たすけて下,くださる。なぜなら、わたしたちはどう祈,いのったらよいかわからないが、御霊,みたまみずから、言葉,ことばにあらわせない切,せつなるうめきをもって、わたしたちのためにとりなして下,くださるからである。","tok":[["御霊","みたま"],["も"],["また"],["同じ","おなじ"],["よう"],["に"],["、"],["弱い","よわい"],["わたしたち"],["を"],["助けて","たすけて"],["下さる","くださる"],["。"],["なぜ"],["なら"],["、"],["わたしたち"],["は"],["どう"],["祈ったら","いのったら"],["よい"],["か"],["わからない"],["が"],["、"],["御霊","みたまみずか"],["ら"],["、"],["言葉","ことば"],["に"],["あらわせない"],["切","せつ"],["なる"],["うめき"],["を"],["もって"],["、"],["わたしたち"],["の"],["ため"],["に"],["とりなして"],["下さる","くださる"],["から"],["で"],["ある"],["。"]]},{"verse":27,"text":"そして、人,ひとの心,こころを探,さぐり知,しるかたは、御霊,みたまの思,おもうところがなんであるかを知,しっておられる。なぜなら、御霊,みたまは、聖徒,せいとのために、神,かみの御旨,みむねにかなうとりなしをして下,くださるからである。","tok":[["そして"],["、"],["人","ひと"],["の"],["心","こころ"],["を"],["探ぐり","さぐり"],["知る","しる"],["かた"],["は"],["、"],["御霊","みたま"],["の"],["思う","おもう"],["ところ"],["が"],["なん"],["で"],["ある"],["か"],["を"],["知って","しって"],["おられる"],["。"],["なぜ"],["なら"],["、"],["御霊","みたま"],["は"],["、"],["聖徒","せいと"],["の"],["ため"],["に"],["、"],["神","かみ"],["の"],["御旨","みむね"],["に"],["かなう"],["とりなし"],["を"],["して"],["下さる","くださる"],["から"],["で"],["ある"],["。"]]},{"verse":28,"text":"神,かみは、神,かみを愛,あいする者,ものたち、すなわち、ご計画,けいかくに従,したがって召,めされた者,ものたちと共,ともに働,はたらいて、万事,ばんじを益,えきとなるようにして下,くださることを、わたしたちは知,しっている。","tok":[["神","かみ"],["は"],["、"],["神","かみ"],["を"],["愛する","あいする"],["者","もの"],["たち"],["、"],["すなわち"],["、"],["ご計画","ごけいかく"],["に"],["従って","したがって"],["召された","めされた"],["者","もの"],["たち"],["と"],["共","とも"],["に"],["働いて","はたらいて"],["、"],["万事","ばんじ"],["を"],["益","えき"],["と"],["なる"],["よう"],["に"],["して"],["下さる","くださる"],["こと"],["を"],["、"],["わたしたち"],["は"],["知って","しって"],["いる"],["。"]]},{"verse":29,"text":"神,かみはあらかじめ知,しっておられる者,ものたちを、更,さらに御子,みこのかたちに似,にたものとしようとして、あらかじめ定,さだめて下,くださった。それは、御子,みこを多,おおくの兄弟,きょうだいの中,なかで長子,ちょうしとならせるためであった。","tok":[["神","かみ"],["は"],["あらかじめ"],["知って","しって"],["おられる"],["者","もの"],["たち"],["を"],["、"],["更に","さらに"],["御子","みこ"],["の"],["かたち"],["に"],["似た","にた"],["もの"],["と"],["しよう"],["として"],["、"],["あらかじめ"],["定めて","さだめて"],["下さった","くださった"],["。"],["それ"],["は"],["、"],["御子","みこ"],["を"],["多く","おおく"],["の"],["兄弟","きょうだい"],["の"],["中","なか"],["で"],["長子","ちょうし"],["と"],["ならせる"],["ため"],["で"],["あった"],["。"]]},{"verse":30,"text":"そして、あらかじめ定,さだめた者,ものたちを更,さらに召,めし、召,めした者,ものたちを更,さらに義,ぎとし、義,ぎとした者,ものたちには、更,さらに栄光,えいこうを与,あたえて下,くださったのである。","tok":[["そして"],["、"],["あらかじめ"],["定めた","さだめた"],["者","もの"],["たち"],["を"],["更に","さらに"],["召","めし"],["、"],["召","めし"],["た"],["者","もの"],["たち"],["を"],["更に","さらに"],["義","ぎ"],["と"],["し"],["、"],["義","ぎ"],["と"],["した"],["者","もの"],["たち"],["に"],["は"],["、"],["更に","さらに"],["栄光","えいこう"],["を"],["与","あたえ"],["て"],["下さった","くださった"],["ので"],["ある"],["。"]]},{"verse":31,"text":"それでは、これらの事,ことについて、なんと言,いおうか。もし、神,かみがわたしたちの味方,みかたであるなら、だれがわたしたちに敵,てきし得,えようか。","tok":[["それ"],["で"],["は"],["、"],["これ"],["ら"],["の"],["事","こと"],["について"],["、"],["なん"],["と"],["言おう","いおう"],["か"],["。"],["もし"],["、"],["神","かみ"],["が"],["わたしたち"],["の"],["味方","みかた"],["で"],["あるなら"],["、"],["だれ"],["が"],["わたしたち"],["に"],["敵し","てきし"],["得よう","えよう"],["か"],["。"]]},{"verse":32,"text":"ご自身,じしんの御子,みこをさえ惜,おしまないで、わたしたちすべての者,もののために死,しに渡,わたされたかたが、どうして、御子,みこのみならず万物,ばんぶつをも賜,たまわらないことがあろうか。","tok":[["ご自身","ごじしん"],["の"],["御子","みこ"],["を"],["さえ"],["惜まないで","おしまないで"],["、"],["わたしたち"],["すべて"],["の"],["者","もの"],["の"],["ため"],["に"],["死","し"],["に"],["渡された","わたされた"],["かた"],["が"],["、"],["どう"],["して"],["、"],["御子","みこ"],["のみ"],["ならず"],["万物","ばんぶつ"],["を"],["も"],["賜わらない","たまわらない"],["こと"],["が"],["あろう"],["か"],["。"]]},{"verse":33,"text":"だれが、神,かみの選,えらばれた者,ものたちを訴,うったえるのか。神,かみは彼,かれらを義,ぎとされるのである。","tok":[["だれ"],["が"],["、"],["神","かみ"],["の"],["選ら","えら"],["ばれた"],["者","もの"],["たち"],["を"],["訴る","うったえる"],["の"],["か"],["。"],["神","かみ"],["は"],["彼","かれ"],["ら"],["を"],["義","ぎ"],["と"],["される"],["ので"],["ある"],["。"]]},{"verse":34,"text":"だれが、わたしたちを罪,つみに定,さだめるのか。キリスト・イエスは、死,しんで、否,いな、よみがえって、神,かみの右,みぎに座,ざし、また、わたしたちのためにとりなして下,くださるのである。","tok":[["だれ"],["が"],["、"],["わたしたち"],["を"],["罪","つみ"],["に"],["定める","さだめる"],["の"],["か"],["。"],["キリスト"],["・"],["イエス"],["は"],["、"],["死んで","しんで"],["、"],["否","いな"],["、"],["よみがえって"],["、"],["神","かみ"],["の"],["右","みぎ"],["に"],["座し","ざし"],["、"],["また"],["、"],["わたしたち"],["の"],["ため"],["に"],["とりなして"],["下さる","くださる"],["ので"],["ある"],["。"]]},{"verse":35,"text":"だれが、キリストの愛,あいからわたしたちを離,はなれさせるのか。患難,かんなんか、苦悩,くのうか、迫害,はくがいか、飢,うえか、裸,はだかか、危難,きなんか、剣,つるぎか。","tok":[["だれ"],["が"],["、"],["キリスト"],["の"],["愛","あい"],["から"],["わたしたち"],["を"],["離れさせる","はなれさせる"],["の"],["か"],["。"],["患難","かんなん"],["か"],["、"],["苦悩","くのう"],["か"],["、"],["迫害","はくがい"],["か"],["、"],["飢","うえ"],["か"],["、"],["裸","はだか"],["か"],["、"],["危難","きなん"],["か"],["、"],["剣","つ"],["る"],["ぎ"],["か"],["。"]]},{"verse":36,"text":"「わたしたちはあなたのために終日,しゅうじつ、死,しに定,さだめられており、ほふられる羊,ひつじのように見,みられている」と書,かいてあるとおりである。","tok":[["「"],["わたしたち"],["は"],["あなた"],["の"],["ため"],["に"],["終日","しゅうじつ"],["、"],["死","し"],["に"],["定められて","さだめられて"],["おり"],["、"],["ほふられる"],["羊","ひつじ"],["の"],["よう"],["に"],["見られて","みられて"],["いる"],["」"],["と"],["書いて","かいて"],["ある"],["とおり"],["で"],["ある"],["。"]]},{"verse":37,"text":"しかし、わたしたちを愛,あいして下,くださったかたによって、わたしたちは、これらすべての事,ことにおいて勝,かち得,えて余,あまりがある。","tok":[["しかし"],["、"],["わたしたち"],["を"],["愛して","あいして"],["下さった","くださった"],["かた"],["によって"],["、"],["わたしたち"],["は"],["、"],["これ"],["ら"],["すべて"],["の"],["事","こと"],["に"],["おいて"],["勝","かち"],["得て","えて"],["余り","あまり"],["が"],["ある"],["。"]]},{"verse":38,"text":"わたしは確信,かくしんする。死,しも生,せいも、天使,てんしも支配者,しはいしゃも、現在,げんざいのものも将来,しょうらいのものも、力,ちからあるものも、","tok":[["わたし"],["は"],["確信","かくしん"],["する"],["。"],["死","し"],["も"],["生も","せいも"],["、"],["天使","てんし"],["も"],["支配者","しはいしゃ"],["も"],["、"],["現在","げんざい"],["の"],["もの"],["も"],["将来","しょうらい"],["の"],["もの"],["も"],["、"],["力","ちから"],["ある"],["もの"],["も"],["、"]]},{"verse":39,"text":"高,たかいものも深,ふかいものも、その他,たどんな被,ひ造物,ぞうぶつも、わたしたちの主,しゅキリスト・イエスにおける神,かみの愛,あいから、わたしたちを引,ひき離,はなすことはできないのである。","tok":[["高かい","たかい"],["もの"],["も"],["深い","ふかい"],["もの"],["も"],["、"],["その"],["他","た"],["どんな"],["被","ひ"],["造物","ぞうぶつ"],["も"],["、"],["わたしたち"],["の"],["主","しゅ"],["キリスト"],["・"],["イエス"],["に"],["おける"],["神","かみ"],["の"],["愛","あい"],["から"],["、"],["わたしたち"],["を"],["引離す","ひきはなす"],["こと"],["は"],["できない"],["ので"],["ある"],["。"]]}]
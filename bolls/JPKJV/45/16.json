[{"verse":1,"text":"ケンクレヤにある教会,きょうかいの執事,しつじ、わたしたちの姉妹,しまいフィベを、あなたがたに紹介,しょうかいする。","tok":[["ケンクレヤ"],["に"],["ある"],["教会","きょうかい"],["の"],["執事","しつじ"],["、"],["わたしたち"],["の"],["姉妹","しまい"],["フィベ"],["を"],["、"],["あなた"],["がた"],["に"],["紹介","しょうかい"],["する"],["。"]]},{"verse":2,"text":"どうか、聖徒,せいとたるにふさわしく、主,しゅにあって彼女,かのじょを迎,むかえ、そして、彼女,かのじょがあなたがたにしてもらいたいことがあれば、何事,なにごとでも、助,たすけてあげてほしい。彼女,かのじょは多,おおくの人,ひとの援助者,えんじょしゃであり、またわたし自身,じしんの援助者,えんじょしゃでもあった。","tok":[["どう"],["か"],["、"],["聖徒","せいと"],["たる"],["に"],["ふさわしく"],["、"],["主に","しゅに"],["あって"],["彼女","かのじょ"],["を"],["迎","むかえ"],["、"],["そして"],["、"],["彼女","かのじょ"],["が"],["あなた"],["がた"],["に"],["して"],["もらいたい"],["こと"],["が"],["あれば"],["、"],["何事","なにごと"],["で"],["も"],["、"],["助けて","たすけて"],["あげて"],["ほしい"],["。"],["彼女","かのじょ"],["は"],["多く","おおく"],["の"],["人","ひと"],["の"],["援助者","えんじょしゃ"],["で"],["あり"],["、"],["また"],["わたし"],["自身","じしん"],["の"],["援助者","えんじょしゃ"],["で"],["も"],["あった"],["。"]]},{"verse":3,"text":"キリスト・イエスにあるわたしの同労者,どうろうしゃプリスカとアクラとに、よろしく言,いってほしい。","tok":[["キリスト"],["・"],["イエス"],["に"],["ある"],["わたし"],["の"],["同労者","どうろうしゃ"],["プリスカ"],["と"],["アクラ"],["と"],["に"],["、"],["よろしく"],["言って","いって"],["ほしい"],["。"]]},{"verse":4,"text":"彼,かれらは、わたしのいのちを救,すくうために、自分,じぶんの首,くびをさえ差,さし出,だしてくれたのである。彼,かれらに対,たいしては、わたしだけではなく、異邦人,いほうじんのすべての教会,きょうかいも、感謝,かんしゃしている。","tok":[["彼","かれ"],["ら"],["は"],["、"],["わたし"],["の"],["いのち"],["を"],["救う","すくう"],["ため"],["に"],["、"],["自分","じぶん"],["の"],["首","くび"],["を"],["さえ"],["差し出して","さしだして"],["くれた"],["ので"],["ある"],["。"],["彼","かれ"],["ら"],["に"],["対し","たいし"],["ては"],["、"],["わたし"],["だけ"],["で"],["は"],["なく"],["、"],["異邦人","いほうじん"],["の"],["すべて"],["の"],["教会","きょうかい"],["も"],["、"],["感謝","かんしゃ"],["して"],["いる"],["。"]]},{"verse":5,"text":"また、彼,かれらの家,いえの教会,きょうかいにも、よろしく。わたしの愛,あいするエパネトに、よろしく言,いってほしい。彼,かれは、キリストにささげられたアジヤの初穂,はつほである。","tok":[["また"],["、"],["彼","かれ"],["ら"],["の"],["家","いえ"],["の"],["教会","きょうかい"],["に"],["も"],["、"],["よろしく"],["。"],["わたし"],["の"],["愛する","あいする"],["エパネト"],["に"],["、"],["よろしく"],["言って","いって"],["ほしい"],["。"],["彼","かれ"],["は"],["、"],["キリスト"],["に"],["ささげられた"],["アジヤ"],["の"],["初穂","はつほ"],["で"],["ある"],["。"]]},{"verse":6,"text":"あなたがたのために一方,ひとかたならず労苦,ろうくしたマリヤに、よろしく言,いってほしい。","tok":[["あなた"],["がた"],["の"],["ため"],["に"],["一方","ひとかたな"],["ら"],["ず"],["労苦","ろうく"],["した"],["マリヤ"],["に"],["、"],["よろしく"],["言って","いって"],["ほしい"],["。"]]},{"verse":7,"text":"わたしの同族,どうぞくであって、わたしと一緒,いっしょに投獄,とうごくされたことのあるアンデロニコとユニアスとに、よろしく。彼,かれらは使徒,しとたちの間,あいだで評判,ひょうばんがよく、かつ、わたしよりも先,さきにキリストを信,しんじた人々,ひとびとである。","tok":[["わたし"],["の"],["同族","どうぞく"],["で"],["あって"],["、"],["わたし"],["と"],["一緒","いっしょ"],["に"],["投獄","とうごく"],["された"],["こと"],["の"],["ある"],["アンデロニコ"],["と"],["ユニアス"],["と"],["に"],["、"],["よろしく"],["。"],["彼","かれ"],["ら"],["は"],["使徒","しと"],["たち"],["の"],["間","あいだ"],["で"],["評判","ひょうばん"],["が"],["よく"],["、"],["かつ"],["、"],["わたし"],["より"],["も"],["先","さき"],["に"],["キリスト"],["を"],["信じた","しんじた"],["人々","ひとびと"],["で"],["ある"],["。"]]},{"verse":8,"text":"主,しゅにあって愛,あいするアムプリアトに、よろしく。","tok":[["主に","しゅに"],["あって"],["愛する","あいする"],["アムプリアト"],["に"],["、"],["よろしく"],["。"]]},{"verse":9,"text":"キリストにあるわたしたちの同労者,どうろうしゃウルバノと、愛,あいするスタキスとに、よろしく。","tok":[["キリスト"],["に"],["ある"],["わたしたち"],["の"],["同労者","どうろうしゃ"],["ウルバノ"],["と"],["、"],["愛する","あいする"],["スタキス"],["と"],["に"],["、"],["よろしく"],["。"]]},{"verse":10,"text":"キリストにあって錬達,れんたつなアペレに、よろしく。アリストブロの家,いえの人,ひとたちに、よろしく。","tok":[["キリスト"],["に"],["あって"],["錬達","れん"],["たつ"],["なア"],["ペレ"],["に"],["、"],["よろしく"],["。"],["アリストブロ"],["の"],["家","いえ"],["の"],["人","ひと"],["たち"],["に"],["、"],["よろしく"],["。"]]},{"verse":11,"text":"同族,どうぞくのヘロデオンに、よろしく。ナルキソの家,いえの、主,しゅにある人,ひとたちに、よろしく。","tok":[["同族","どうぞく"],["の"],["ヘロデオン"],["に"],["、"],["よろしく"],["。"],["ナルキソ"],["の"],["家","いえ"],["の"],["、"],["主に","しゅに"],["ある"],["人","ひと"],["たち"],["に"],["、"],["よろしく"],["。"]]},{"verse":12,"text":"主,しゅにあって労苦,ろうくしているツルパナとツルポサとに、よろしく。主,しゅにあって一方,ひとかたならず労苦,ろうくした愛,あいするペルシスに、よろしく。","tok":[["主に","しゅに"],["あって"],["労苦","ろうく"],["して"],["いる"],["ツルパナ"],["と"],["ツルポサ"],["と"],["に"],["、"],["よろしく"],["。"],["主に","しゅに"],["あって"],["一方","ひとかたな"],["ら"],["ず"],["労苦","ろうく"],["した"],["愛する","あいする"],["ペルシス"],["に"],["、"],["よろしく"],["。"]]},{"verse":13,"text":"主,しゅにあって選,えらばれたルポスと、彼,かれの母,ははとに、よろしく。彼,かれの母,ははは、わたしの母,ははでもある。","tok":[["主に","しゅに"],["あって"],["選ら","えら"],["ばれた"],["ルポス"],["と"],["、"],["彼","かれ"],["の"],["母","はは"],["と"],["に"],["、"],["よろしく"],["。"],["彼","かれ"],["の"],["母","はは"],["は"],["、"],["わたし"],["の"],["母","はは"],["で"],["も"],["ある"],["。"]]},{"verse":14,"text":"アスンクリト、フレゴン、ヘルメス、パトロバ、ヘルマスおよび彼,かれらと一緒,いっしょにいる兄弟,きょうだいたちに、よろしく。","tok":[["アスンクリト"],["、"],["フレゴン"],["、"],["ヘルメス"],["、"],["パトロバ"],["、"],["ヘルマス"],["および"],["彼","かれ"],["ら"],["と"],["一緒","いっしょ"],["に"],["いる"],["兄弟","きょうだい"],["たち"],["に"],["、"],["よろしく"],["。"]]},{"verse":15,"text":"ピロロゴとユリヤとに、またネレオとその姉妹,しまいとに、オルンパに、また彼,かれらと一緒,いっしょにいるすべての聖徒,せいとたちに、よろしく言,いってほしい。","tok":[["ピロロゴ"],["と"],["ユリヤ"],["と"],["に"],["、"],["また"],["ネレオ"],["と"],["その"],["姉妹","しまい"],["と"],["に"],["、"],["オルンパ"],["に"],["、"],["また"],["彼","かれ"],["ら"],["と"],["一緒","いっしょ"],["に"],["いる"],["すべて"],["の"],["聖徒","せいと"],["たち"],["に"],["、"],["よろしく"],["言って","いって"],["ほしい"],["。"]]},{"verse":16,"text":"きよい接吻,せっぷんをもって、互,たがいにあいさつをかわしなさい。キリストのすべての教会,きょうかいから、あなたがたによろしく。","tok":[["きよい"],["接吻","せっぷん"],["を"],["もって"],["、"],["互","たがい"],["に"],["あいさつ"],["を"],["かわし"],["なさい"],["。"],["キリスト"],["の"],["すべて"],["の"],["教会","きょうかい"],["から"],["、"],["あなた"],["がた"],["に"],["よろしく"],["。"]]},{"verse":17,"text":"さて兄弟,きょうだいたちよ。あなたがたに勧告,かんこくする。あなたがたが学,まなんだ教,おしえにそむいて分裂,ぶんれつを引,ひき起,おこし、つまずきを与,あたえる人々,ひとびとを警戒,けいかいし、かつ彼,かれらから遠,とおざかるがよい。","tok":[["さて"],["兄弟","きょうだい"],["たち"],["よ"],["。"],["あなた"],["がた"],["に"],["勧告","かんこく"],["する"],["。"],["あなた"],["がた"],["が"],["学んだ","まなんだ"],["教え","おしえ"],["に"],["そむいて"],["分裂","ぶんれつ"],["を"],["引起こし","ひきおこし"],["、"],["つまずき"],["を"],["与える","あたえる"],["人々","ひとびと"],["を"],["警戒","けいかい"],["し"],["、"],["かつ"],["彼","かれ"],["ら"],["から"],["遠ざかる","とおざかる"],["が"],["よい"],["。"]]},{"verse":18,"text":"なぜなら、こうした人々,ひとびとは、わたしたちの主,しゅキリストに仕,つかえないで、自分,じぶんの腹,はらに仕,つかえ、そして甘言,かんげんと美辞,びじとをもって、純朴,じゅんぼくな人々,ひとびとの心,こころを欺,あざむく者,ものどもだからである。","tok":[["なぜ"],["なら"],["、"],["こう"],["した"],["人々","ひとびと"],["は"],["、"],["わたしたち"],["の"],["主","しゅ"],["キリスト"],["に"],["仕えないで","つかえないで"],["、"],["自分","じぶん"],["の"],["腹","はら"],["に"],["仕え","つかえ"],["、"],["そして"],["甘言","かんげん"],["と"],["美辞","びじ"],["と"],["を"],["もって"],["、"],["純朴","じゅんぼく"],["な"],["人々","ひとびと"],["の"],["心","こころ"],["を"],["欺く","あざむく"],["者","もの"],["ども"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":19,"text":"あなたがたの従順,じゅうじゅんは、すべての人々,ひとびとの耳,みみに達,たっしており、それをあなたがたのために喜,よろこんでいる。しかし、わたしの願,ねがうところは、あなたがたが善,ぜんにさとく、悪,あくには、うとくあってほしいことである。","tok":[["あなた"],["がた"],["の"],["従順","じゅうじゅん"],["は"],["、"],["すべて"],["の"],["人々","ひとびと"],["の"],["耳","みみ"],["に"],["達して","たっして"],["おり"],["、"],["それ"],["を"],["あなた"],["がた"],["の"],["ため"],["に"],["喜こんで","よろこんで"],["いる"],["。"],["しかし"],["、"],["わたし"],["の"],["願う","ねがう"],["ところ"],["は"],["、"],["あなた"],["がた"],["が"],["善","ぜん"],["に"],["さとく"],["、"],["悪","あく"],["に"],["は"],["、"],["うとく"],["あって"],["ほしい"],["こと"],["で"],["ある"],["。"]]},{"verse":20,"text":"平和,へいわの神,かみは、サタンをすみやかにあなたがたの足,あしの下,したに踏,ふみ砕,くだくであろう。どうか、わたしたちの主,しゅイエスの恵,めぐみが、あなたがたと共,ともにあるように。","tok":[["平和","へいわ"],["の"],["神","かみ"],["は"],["、"],["サタン"],["を"],["すみやか"],["に"],["あなた"],["がた"],["の"],["足","あし"],["の"],["下","した"],["に"],["踏み砕くで","ふみくだくで"],["あろう"],["。"],["どう"],["か"],["、"],["わたしたち"],["の"],["主","しゅ"],["イエス"],["の"],["恵","めぐみ"],["が"],["、"],["あなた"],["がた"],["と"],["共","とも"],["に"],["ある"],["よう"],["に"],["。"]]},{"verse":21,"text":"わたしの同労者,どうろうしゃテモテおよび同族,どうぞくのルキオ、ヤソン、ソシパテロから、あなたがたによろしく。","tok":[["わたし"],["の"],["同労者","どうろうしゃ"],["テモテ"],["および"],["同族","どうぞく"],["の"],["ルキオ"],["、"],["ヤソン"],["、"],["ソシパテロ"],["から"],["、"],["あなた"],["がた"],["に"],["よろしく"],["。"]]},{"verse":22,"text":"（この手紙,てがみを筆記,ひっきしたわたしテルテオも、主,しゅにあってあなたがたにあいさつの言葉,ことばをおくる。）","tok":[["（"],["この"],["手紙","てがみ"],["を"],["筆記","ひっき"],["した"],["わたし"],["テルテオ"],["も"],["、"],["主に","しゅに"],["あって"],["あなた"],["がた"],["に"],["あいさつ"],["の"],["言葉","ことば"],["を"],["おくる"],["。"],["）"]]},{"verse":23,"text":"わたしと全,ぜん教会,きょうかいとの家主,やぬしガイオから、あなたがたによろしく。市,しの会計,かいけい係,がかりエラストと兄弟,きょうだいクワルトから、あなたがたによろしく。〔","tok":[["わたし"],["と"],["全教","ぜん教"],["会","かい"],["と"],["の"],["家主","やぬし"],["ガイオ"],["から"],["、"],["あなた"],["がた"],["に"],["よろしく"],["。"],["市","し"],["の"],["会計","かいけい"],["係","が"],["かり"],["エラスト"],["と"],["兄弟","きょうだい"],["クワルト"],["から"],["、"],["あなた"],["がた"],["に"],["よろしく"],["。"],["〔"]]},{"verse":24,"text":"わたしたちの主,しゅイエス・キリストの恵,めぐみが、あなたがた一同,いちどうと共,ともにあるように、アァメン。〕","tok":[["わたしたち"],["の"],["主","しゅ"],["イエス"],["・"],["キリスト"],["の"],["恵","めぐみ"],["が"],["、"],["あなた"],["がた"],["一同","いちどう"],["と"],["共","とも"],["に"],["ある"],["よう"],["に"],["、"],["アァメン"],["。"],["〕"]]},{"verse":25,"text":"[25-26]願,ねがわくは、わたしの福音,ふくいんとイエス・キリストの宣教,せんきょうとにより、かつ、長,ながき世々,よよにわたって、隠,かくされていたが、今,いまやあらわされ、預言,よげんの書,しょをとおして、永遠,えいえんの神,かみの命令,めいれいに従,したがい、信仰,しんこうの従順,じゅうじゅんに至,いたらせるために、もろもろの国,くに人,ひとに告,つげ知,しらされた奥義,おくぎの啓示,けいじによって、あなたがたを力,ちからづけることのできるかた、","tok":[["["],["25"],["-"],["26"],["]"],["願わく","ねがわく"],["は"],["、"],["わたし"],["の"],["福音","ふくいん"],["と"],["イエス"],["・"],["キリスト"],["の"],["宣教","せんきょう"],["と"],["に"],["より"],["、"],["かつ"],["、"],["長き","ながき"],["世々","よよ"],["に"],["わたって"],["、"],["隠されて","かくされて"],["いた"],["が"],["、"],["今","いま"],["や"],["あらわされ"],["、"],["預言","よげん"],["の"],["書","しょ"],["を"],["とおして"],["、"],["永遠","えいえん"],["の"],["神","かみ"],["の"],["命令","めいれい"],["に"],["従い","したがい"],["、"],["信仰","しんこう"],["の"],["従順","じゅうじゅん"],["に"],["至らせる","いたらせる"],["ため"],["に"],["、"],["もろもろ"],["の"],["国人","くにひと"],["に"],["告","つげ"],["知らされた","しらされた"],["奥義","おくぎ"],["の"],["啓示","けいじ"],["によって"],["、"],["あなた"],["がた"],["を"],["力づける","ちからづける"],["こと"],["の"],["できる"],["かた"],["、"]]},{"verse":26,"text":"*[25-26]願,ねがわくは、わたしの福音,ふくいんとイエス・キリストの宣教,せんきょうとにより、かつ、長,ながき世々,よよにわたって、隠,かくされていたが、今,いまやあらわされ、預言,よげんの書,しょをとおして、永遠,えいえんの神,かみの命令,めいれいに従,したがい、信仰,しんこうの従順,じゅうじゅんに至,いたらせるために、もろもろの国,くに人,ひとに告,つげ知,しらされた奥義,おくぎの啓示,けいじによって、あなたがたを力,ちからづけることのできるかた、","tok":[["*"],["["],["25"],["-"],["26"],["]"],["願わく","ねがわく"],["は"],["、"],["わたし"],["の"],["福音","ふくいん"],["と"],["イエス"],["・"],["キリスト"],["の"],["宣教","せんきょう"],["と"],["に"],["より"],["、"],["かつ"],["、"],["長き","ながき"],["世々","よよ"],["に"],["わたって"],["、"],["隠されて","かくされて"],["いた"],["が"],["、"],["今","いま"],["や"],["あらわされ"],["、"],["預言","よげん"],["の"],["書","しょ"],["を"],["とおして"],["、"],["永遠","えいえん"],["の"],["神","かみ"],["の"],["命令","めいれい"],["に"],["従い","したがい"],["、"],["信仰","しんこう"],["の"],["従順","じゅうじゅん"],["に"],["至らせる","いたらせる"],["ため"],["に"],["、"],["もろもろ"],["の"],["国人","くにひと"],["に"],["告","つげ"],["知らされた","しらされた"],["奥義","おくぎ"],["の"],["啓示","けいじ"],["によって"],["、"],["あなた"],["がた"],["を"],["力づける","ちからづける"],["こと"],["の"],["できる"],["かた"],["、"]]},{"verse":27,"text":"すなわち、唯一,ゆいいつの知恵,ちえ深,ふかき神,かみに、イエス・キリストにより、栄光,えいこうが永遠,えいえんより永遠,えいえんにあるように、アァメン。","tok":[["すなわち"],["、"],["唯一","ゆいいつ"],["の"],["知恵","ちえ"],["深き","ふかき"],["神","かみ"],["に"],["、"],["イエス"],["・"],["キリスト"],["に"],["より"],["、"],["栄光","えいこう"],["が"],["永遠","えいえん"],["より"],["永遠","えいえん"],["に"],["ある"],["よう"],["に"],["、"],["アァメン"],["。"]]}]
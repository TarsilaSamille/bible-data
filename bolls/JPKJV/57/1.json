[{"verse":1,"text":"キリスト・イエスの囚人,しゅうじんパウロと兄弟,きょうだいテモテから、わたしたちの愛,あいする同労者,どうろうしゃピレモン、","tok":[["キリスト"],["・"],["イエス"],["の"],["囚人","しゅうじん"],["パウロ"],["と"],["兄弟","きょうだい"],["テモテ"],["から"],["、"],["わたしたち"],["の"],["愛する","あいする"],["同労者","どうろうしゃ"],["ピレモン"],["、"]]},{"verse":2,"text":"姉妹,しまいアピヤ、わたしたちの戦友,せんゆうアルキポ、ならびに、あなたの家,いえにある教会,きょうかいへ。","tok":[["姉妹","しまい"],["アピヤ"],["、"],["わたしたち"],["の"],["戦友","せんゆう"],["アルキポ"],["、"],["ならびに"],["、"],["あなた"],["の"],["家","いえ"],["に"],["ある"],["教会","きょうかい"],["へ"],["。"]]},{"verse":3,"text":"わたしたちの父,ちちなる神,かみと主,しゅイエス・キリストから、恵,めぐみと平安,へいあんとが、あなたがたにあるように。","tok":[["わたしたち"],["の"],["父","ちち"],["なる"],["神","かみ"],["と"],["主","しゅ"],["イエス"],["・"],["キリスト"],["から"],["、"],["恵","めぐみ"],["と"],["平安","へいあん"],["と"],["が"],["、"],["あなた"],["がた"],["に"],["ある"],["よう"],["に"],["。"]]},{"verse":4,"text":"わたしは、祈,いのりの時,ときにあなたをおぼえて、いつもわたしの神,かみに感謝,かんしゃしている。","tok":[["わたし"],["は"],["、"],["祈","いのり"],["の"],["時","とき"],["に"],["あなた"],["を"],["おぼえて"],["、"],["いつも"],["わたし"],["の"],["神","かみ"],["に"],["感謝","かんしゃ"],["して"],["いる"],["。"]]},{"verse":5,"text":"それは、主,しゅイエスに対,たいし、また、すべての聖徒,せいとに対,たいするあなたの愛,あいと信仰,しんこうとについて、聞,きいているからである。","tok":[["それ"],["は"],["、"],["主","しゅ"],["イエス"],["に"],["対し","たいし"],["、"],["また"],["、"],["すべて"],["の"],["聖徒","せいと"],["に"],["対する","たいする"],["あなた"],["の"],["愛","あい"],["と"],["信仰","しんこう"],["と"],["について"],["、"],["聞いて","きいて"],["いる"],["から"],["で"],["ある"],["。"]]},{"verse":6,"text":"どうか、あなたの信仰,しんこうの交,まじわりが強,つよめられて、わたしたちの間,あいだでキリストのためになされているすべての良,よいことが、知,しられて来,くるようになってほしい。","tok":[["どう"],["か"],["、"],["あなた"],["の"],["信仰","しんこう"],["の"],["交じわり","まじわり"],["が"],["強められて","つよめられて"],["、"],["わたしたち"],["の"],["間","あいだ"],["で"],["キリスト"],["の"],["ため"],["に"],["なされて"],["いる"],["すべて"],["の"],["良い","よい"],["こと"],["が"],["、"],["知られて","しられて"],["来る","くる"],["よう"],["に"],["なって"],["ほしい"],["。"]]},{"verse":7,"text":"兄弟,きょうだいよ。わたしは、あなたの愛,あいによって多,おおくの喜,よろこびと慰,なぐさめとを与,あたえられた。聖徒,せいとたちの心,こころが、あなたによって力,ちからづけられたからである。","tok":[["兄弟","きょうだい"],["よ"],["。"],["わたし"],["は"],["、"],["あなた"],["の"],["愛","あい"],["によって"],["多く","おおく"],["の"],["喜こび","よろこび"],["と"],["慰さめ","なぐさめ"],["と"],["を"],["与えられた","あたえられた"],["。"],["聖徒","せいと"],["たち"],["の"],["心","こころ"],["が"],["、"],["あなた"],["によって"],["力づけられた","ちからづけられた"],["から"],["で"],["ある"],["。"]]},{"verse":8,"text":"こういうわけで、わたしは、キリストにあってあなたのなすべき事,ことを、きわめて率直,そっちょくに指示,しじしてもよいと思,おもうが、","tok":[["こう"],["いう"],["わけ"],["で"],["、"],["わたし"],["は"],["、"],["キリスト"],["に"],["あって"],["あなた"],["の"],["なすべき"],["事","こと"],["を"],["、"],["きわめて"],["率直","そっちょく"],["に"],["指示","しじ"],["して"],["も"],["よい"],["と"],["思","おもう"],["が"],["、"]]},{"verse":9,"text":"むしろ、愛,あいのゆえにお願,ねがいする。すでに老年,ろうねんになり、今,いままたキリスト・イエスの囚人,しゅうじんとなっているこのパウロが、","tok":[["むしろ"],["、"],["愛","あい"],["の"],["ゆえ"],["に"],["お願い","おねがい"],["する"],["。"],["すでに"],["老年","ろうねん"],["に"],["なり"],["、"],["今","いま"],["また"],["キリスト"],["・"],["イエス"],["の"],["囚人","しゅうじん"],["と"],["なって"],["いる"],["この"],["パウロ"],["が"],["、"]]},{"verse":10,"text":"捕,とらわれの身,みで産,うんだわたしの子供,こどもオネシモについて、あなたにお願,ねがいする。","tok":[["捕らわれ","とらわれ"],["の"],["身","み"],["で"],["産んだ","うんだ"],["わたし"],["の"],["子供","こども"],["オネシモ"],["について"],["、"],["あなた"],["に"],["お願い","おねがい"],["する"],["。"]]},{"verse":11,"text":"彼,かれは以前,いぜんは、あなたにとって無益,むえきな者,ものであったが、今,いまは、あなたにも、わたしにも、有益,ゆうえきな者,ものになった。","tok":[["彼","かれ"],["は"],["以前","いぜん"],["は"],["、"],["あなた"],["にとって"],["無益","むえき"],["な"],["者","もの"],["で"],["あった"],["が"],["、"],["今","いま"],["は"],["、"],["あなた"],["に"],["も"],["、"],["わたし"],["に"],["も"],["、"],["有益","ゆうえき"],["な"],["者","もの"],["に"],["なった"],["。"]]},{"verse":12,"text":"彼,かれをあなたのもとに送,おくりかえす。彼,かれはわたしの心,こころである。","tok":[["彼","かれ"],["を"],["あなた"],["の"],["もと"],["に"],["送りかえす","おくりかえす"],["。"],["彼","かれ"],["は"],["わたし"],["の"],["心","こころ"],["で"],["ある"],["。"]]},{"verse":13,"text":"わたしは彼,かれを身近,みぢかに引,ひきとめておいて、わたしが福音,ふくいんのために捕,とらわれている間,あいだ、あなたに代,かわって仕,つかえてもらいたかったのである。","tok":[["わたし"],["は"],["彼","かれ"],["を"],["身近","みぢか"],["に"],["引","ひき"],["とめて"],["おいて"],["、"],["わたし"],["が"],["福音","ふくいん"],["の"],["ため"],["に"],["捕らわれて","とらわれて"],["いる"],["間","あいだ"],["、"],["あなた"],["に"],["代わって","かわって"],["仕えて","つかえて"],["もらいたかった"],["ので"],["ある"],["。"]]},{"verse":14,"text":"しかし、わたしは、あなたの承諾,しょうだくなしには何,なにもしたくない。あなたが強制,きょうせいされて良,よい行,おこないをするのではなく、自発,じはつ的,てきにすることを願,ねがっている。","tok":[["しかし"],["、"],["わたし"],["は"],["、"],["あなた"],["の"],["承諾","しょうだく"],["なし"],["に"],["は"],["何に","なに"],["も"],["したく"],["ない"],["。"],["あなた"],["が"],["強制","きょうせい"],["されて"],["良い","よい"],["行ない","おこない"],["を"],["する"],["ので"],["は"],["なく"],["、"],["自発的","じはつてき"],["に"],["する"],["こと"],["を"],["願って","ねがって"],["いる"],["。"]]},{"verse":15,"text":"彼,かれがしばらくの間,あいだあなたから離,はなれていたのは、あなたが彼,かれをいつまでも留,とめておくためであったかも知,しれない。","tok":[["彼","かれ"],["が"],["しばらく"],["の"],["間","あいだ"],["あなた"],["から"],["離れて","はなれて"],["いた"],["の"],["は"],["、"],["あなた"],["が"],["彼","かれ"],["を"],["いつ"],["まで"],["も"],["留","とめ"],["て"],["おく"],["ため"],["で"],["あった"],["か"],["も"],["知れない","しれない"],["。"]]},{"verse":16,"text":"しかも、もはや奴隷,どれいとしてではなく、奴隷,どれい以上,いじょうのもの、愛,あいする兄弟,きょうだいとしてである。とりわけ、わたしにとってそうであるが、ましてあなたにとっては、肉,にくにおいても、主,しゅにあっても、それ以上,いじょうであろう。","tok":[["しかも"],["、"],["もはや"],["奴隷","どれい"],["として"],["で"],["は"],["なく"],["、"],["奴隷","どれい"],["以上","いじょう"],["の"],["もの"],["、"],["愛する","あいする"],["兄弟","きょうだい"],["として"],["で"],["ある"],["。"],["とりわけ"],["、"],["わたし"],["にとって"],["そう"],["で"],["ある"],["が"],["、"],["まして"],["あなた"],["にとって"],["は"],["、"],["肉","にく"],["に"],["おいて"],["も"],["、"],["主に","しゅに"],["あって"],["も"],["、"],["それ"],["以上","いじょう"],["で"],["あろう"],["。"]]},{"verse":17,"text":"そこで、もしわたしをあなたの信仰,しんこうの友,ともと思,おもってくれるなら、わたし同様,どうように彼,かれを受,うけいれてほしい。","tok":[["そこ"],["で"],["、"],["もし"],["わたし"],["を"],["あなた"],["の"],["信仰","しんこう"],["の"],["友","とも"],["と"],["思って","おもって"],["くれるなら"],["、"],["わたし"],["同様","どうよう"],["に"],["彼","かれ"],["を"],["受","うけ"],["いれて"],["ほしい"],["。"]]},{"verse":18,"text":"もし、彼,かれがあなたに何,なにか不都合,ふつごうなことをしたか、あるいは、何,なにか負債,ふさいがあれば、それをわたしの借,かりにしておいてほしい。","tok":[["もし"],["、"],["彼","かれ"],["が"],["あなた"],["に"],["何に","なに"],["か"],["不都合","ふつごう"],["な"],["こと"],["を"],["した"],["か"],["、"],["あるいは"],["、"],["何に","なに"],["か"],["負債","ふさい"],["が"],["あれば"],["、"],["それ"],["を"],["わたし"],["の"],["借","かり"],["に"],["して"],["おいて"],["ほしい"],["。"]]},{"verse":19,"text":"このパウロが手,てずからしるす、わたしがそれを返済,へんさいする。この際,さい、あなたが、あなた自身,じしんをわたしに負,おうていることについては、何,なにも言,いうまい。","tok":[["この"],["パウロ"],["が"],["手ずから","てずから"],["しるす"],["、"],["わたし"],["が"],["それ"],["を"],["返済","へんさい"],["する"],["。"],["この"],["際","さい"],["、"],["あなた"],["が"],["、"],["あなた"],["自身","じしん"],["を"],["わたし"],["に"],["負うて","おうて"],["いる"],["こと"],["について"],["は"],["、"],["何に","なに"],["も"],["言うまい","いうまい"],["。"]]},{"verse":20,"text":"兄弟,きょうだいよ。わたしはあなたから、主,しゅにあって何,なにか益,えきを得,えたいものである。わたしの心,こころを、主,しゅにあって力,ちからづけてもらいたい。","tok":[["兄弟","きょうだい"],["よ"],["。"],["わたし"],["は"],["あなた"],["から"],["、"],["主に","しゅに"],["あって"],["何に","なに"],["か"],["益","えき"],["を"],["得たい","えたい"],["もの"],["で"],["ある"],["。"],["わたし"],["の"],["心","こころ"],["を"],["、"],["主に","しゅに"],["あって"],["力づけて","ちからづけて"],["もらいたい"],["。"]]},{"verse":21,"text":"わたしはあなたの従順,じゅうじゅんを堅,かたく信,しんじて、この手紙,てがみを書,かく。あなたは、確,たしかにわたしが言,いう以上,いじょうのことをしてくれるだろう。","tok":[["わたし"],["は"],["あなた"],["の"],["従順","じゅうじゅん"],["を"],["堅く","かたく"],["信じて","しんじて"],["、"],["この"],["手紙","てがみ"],["を"],["書く","かく"],["。"],["あなた"],["は"],["、"],["確か","たしか"],["に"],["わたし"],["が"],["言う","いう"],["以上","いじょう"],["の"],["こと"],["を"],["して"],["くれるだろう"],["。"]]},{"verse":22,"text":"ついでにお願,ねがいするが、わたしのために宿,やどを用意,よういしておいてほしい。あなたがたの祈,いのりによって、あなたがたの所,ところに行,いかせてもらえるように望,のぞんでいるのだから。","tok":[["ついで"],["に"],["お願い","おねがい"],["する"],["が"],["、"],["わたし"],["の"],["ため"],["に"],["宿","やど"],["を"],["用意","ようい"],["して"],["おいて"],["ほしい"],["。"],["あなた"],["がた"],["の"],["祈","いのり"],["によって"],["、"],["あなた"],["がた"],["の"],["所","ところ"],["に"],["行かせて","いかせて"],["もらえる"],["よう"],["に"],["望んで","のぞんで"],["いる"],["の"],["だ"],["から"],["。"]]},{"verse":23,"text":"キリスト・イエスにあって、わたしと共,ともに捕,とらわれの身,みになっているエパフラスから、あなたによろしく。","tok":[["キリスト"],["・"],["イエス"],["に"],["あって"],["、"],["わたし"],["と"],["共","とも"],["に"],["捕らわれ","とらわれ"],["の"],["身","み"],["に"],["なって"],["いる"],["エパフラス"],["から"],["、"],["あなた"],["に"],["よろしく"],["。"]]},{"verse":24,"text":"わたしの同労者,どうろうしゃたち、マルコ、アリスタルコ、デマス、ルカからも、よろしく。","tok":[["わたし"],["の"],["同労者","どうろうしゃ"],["たち"],["、"],["マルコ"],["、"],["アリスタルコ"],["、"],["デマス"],["、"],["ルカ"],["から"],["も"],["、"],["よろしく"],["。"]]},{"verse":25,"text":"主,しゅイエス・キリストの恵,めぐみが、あなたがたの霊,れいと共,ともにあるように。","tok":[["主","しゅ"],["イエス"],["・"],["キリスト"],["の"],["恵","めぐみ"],["が"],["、"],["あなた"],["がた"],["の"],["霊","れい"],["と"],["共","とも"],["に"],["ある"],["よう"],["に"],["。"]]}]